theorem wc_et_slice_module_restrict_injective : ∀ {X : Scheme.{u}} (T : X.Etale) [hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] [(wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (ℓ : ℕ) (ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj (wcEtZModRing X ℓ)) (I : SheafOfModules.{u+1} (wcEtZModRing X ℓ)), Injective I → Injective ((SheafOfModules.pushforward.{u+1} ψ).obj I) :=
by
  intro X T hc _ ℓ ψ I hI



  have pkg : ∀ (Y : Scheme.{u}), (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).Full ∧
      (∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, ℓ • 𝟙 G = 0 →
        (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).essImage G) ∧
      ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ),
        ℓ • 𝟙 ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).obj M) = 0 := by
    intro Y
    obtain ⟨α, hinj, hsurj, hR⟩ := wc_et_zmod_ring_locbij Y ℓ
    obtain ⟨hF, hE⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y)
      (wcEtZModRing Y ℓ) ℓ α hinj hsurj
    refine ⟨hF, hE, ?_⟩
    have hev : ∀ {M M' : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (f : M ⟶ M')
        (V : (Y.Etale)ᵒᵖ), f.val.app V = (SheafOfModules.forget (wcEtZModRing Y ℓ) ⋙
          PresheafOfModules.evaluation (wcEtZModRing Y ℓ).obj V).map f :=
      fun _ _ => rfl
    have hnsmulApp : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (V : (Y.Etale)ᵒᵖ),
        (ℓ • 𝟙 M).val.app V = ℓ • 𝟙 (M.val.obj V) := by
      intro M V
      rw [hev, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rfl
    have hzeroApp : ∀ (M M' : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (V : (Y.Etale)ᵒᵖ),
        (0 : M ⟶ M').val.app V = 0 := by
      intro M M' V
      rw [hev, CategoryTheory.Functor.map_zero]
      rfl
    have hkillM : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ), ℓ • 𝟙 M = 0 := by
      intro M
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      rw [hnsmulApp, hzeroApp]
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      rw [ModuleCat.hom_nsmul, ModuleCat.hom_id, ModuleCat.hom_zero, LinearMap.smul_apply,
        LinearMap.id_apply, LinearMap.zero_apply,
        ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Y ℓ).obj.obj V), hR V, zero_smul]
    intro M
    rw [← (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map_id, ← Functor.map_nsmul,
      hkillM M, Functor.map_zero]
  obtain ⟨hFullV, -, htorV⟩ := pkg T.left
  obtain ⟨hFullX, hessX, -⟩ := pkg X



  let FV := SheafOfModules.toSheaf.{u+1} (wcEtZModRing T.left ℓ)
  let FX := SheafOfModules.toSheaf.{u+1} (wcEtZModRing X ℓ)
  haveI iFullV : FV.Full := hFullV
  haveI iFullX : FX.Full := hFullX
  haveI iFaithV : FV.Faithful :=
    inferInstanceAs (SheafOfModules.toSheaf.{u+1} (wcEtZModRing T.left ℓ)).Faithful
  haveI iFaithX : FX.Faithful :=
    inferInstanceAs (SheafOfModules.toSheaf.{u+1} (wcEtZModRing X ℓ)).Faithful
  haveI iReflX : FX.ReflectsMonomorphisms := inferInstance
  haveI iPLV : Limits.PreservesLimitsOfShape Limits.WalkingCospan FV :=
    inferInstanceAs (Limits.PreservesLimitsOfShape Limits.WalkingCospan
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing T.left ℓ)))
  haveI iMonoV : FV.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape FV
  have htorV' : ∀ M : SheafOfModules.{u+1} (wcEtZModRing T.left ℓ), ℓ • 𝟙 (FV.obj M) = 0 :=
    htorV
  have hessX' : ∀ G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1},
      ℓ • 𝟙 G = 0 → FX.essImage G := hessX



  haveI := wc_et_slice_lan_finite_limits T
  let r := (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
  let L := Functor.sheafPullbackConstruction.sheafPullback (wcEtSlice T) AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
  let adj : L ⊣ r := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtSlice T)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
  haveI iLfl : Limits.PreservesFiniteLimits L :=
    inferInstanceAs (Limits.PreservesFiniteLimits
      (Functor.sheafPullbackConstruction.sheafPullback (wcEtSlice T) AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)))
  haveI iLmono : L.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape L
  haveI : r.IsRightAdjoint := adj.isRightAdjoint
  haveI : Limits.PreservesLimitsOfSize.{0, 0} r := adj.rightAdjoint_preservesLimits
  haveI : r.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint r
  haveI : r.Additive := Functor.additive_of_preserves_binary_products r
  haveI iLadd : L.Additive := adj.left_adjoint_additive



  let e : FV.obj ((SheafOfModules.pushforward.{u+1} ψ).obj I) ≅ r.obj (FX.obj I) := Iso.refl _
  have htL : ∀ M : SheafOfModules.{u+1} (wcEtZModRing T.left ℓ),
      ℓ • 𝟙 (L.obj (FV.obj M)) = 0 := by
    intro M
    rw [← L.map_id, ← Functor.map_nsmul, htorV' M, Functor.map_zero]
  constructor
  intro A B g m hm
  have hA := hessX' _ (htL A)
  have hB := hessX' _ (htL B)
  let iA := hA.getIso
  let iB := hB.getIso
  haveI : Mono (FV.map m) := Functor.map_mono FV m
  haveI : Mono (L.map (FV.map m)) := Functor.map_mono L _
  let m'' : FX.obj hA.witness ⟶ FX.obj hB.witness := iA.hom ≫ L.map (FV.map m) ≫ iB.inv
  haveI hm'' : Mono m'' := mono_comp _ _
  let m' : hA.witness ⟶ hB.witness := FX.preimage m''
  have h1 : FX.map m' = m'' := FX.map_preimage m''
  haveI : Mono (FX.map m') := by rw [h1]; exact hm''
  haveI : Mono m' := FX.mono_of_mono_map this
  let hflat : L.obj (FV.obj A) ⟶ FX.obj I := (adj.homEquiv _ _).symm (FV.map g ≫ e.hom)
  let h' : hA.witness ⟶ I := FX.preimage (iA.hom ≫ hflat)
  have h2 : FX.map h' = iA.hom ≫ hflat := FX.map_preimage _
  let k' : hB.witness ⟶ I := Injective.factorThru h' m'
  have hk' : m' ≫ k' = h' := Injective.comp_factorThru h' m'
  let kflat : L.obj (FV.obj B) ⟶ FX.obj I := iB.inv ≫ FX.map k'
  have hclaim : L.map (FV.map m) ≫ kflat = hflat := by
    calc L.map (FV.map m) ≫ kflat = iA.inv ≫ m'' ≫ FX.map k' := by
          simp only [m'', kflat, Category.assoc, Iso.inv_hom_id_assoc]
      _ = iA.inv ≫ FX.map h' := by rw [← h1, ← Functor.map_comp, hk']
      _ = hflat := by rw [h2, Iso.inv_hom_id_assoc]
  refine ⟨FV.preimage (adj.homEquiv _ _ kflat ≫ e.inv), ?_⟩
  apply FV.map_injective
  rw [Functor.map_comp, Functor.map_preimage, ← Category.assoc,
    ← adj.homEquiv_naturality_left, hclaim, Equiv.apply_symm_apply, Category.assoc,
    Iso.hom_inv_id, Category.comp_id]

theorem wc_et_point_two_piece_cover : ∀ {K : Type u} [Field K] {X : Scheme.{u}} (T : X.Etale) (x₀ : Spec (.of K) ⟶ X) (v₀ : Spec (.of K) ⟶ T.left) [IsClosedImmersion x₀], v₀ ≫ T.hom = x₀ → ∀ W : X.Etale, ∃ S ∈ Scheme.smallEtaleTopology X W, ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g → (∃ lam : W'.left ⟶ T.left, lam ≫ T.hom = W'.hom) ∨ ∀ w : W'.left, W'.hom w ∉ Set.range x₀ :=
by
  intro K _ X T x₀ v₀ _ hv W

  have hjs : ∀ (S : Sieve W), (∀ v : W.left, ∃ (V₁ : X.Etale)
      (c : V₁ ⟶ W), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X W := by
    intro S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X W
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ W.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale W.hom := W.prop
      have h2 : Etale (c.left ≫ W.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left W.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  let P : X.Etale → Prop := fun W' => (∃ lam : W'.left ⟶ T.left, lam ≫ T.hom = W'.hom) ∨
    ∀ w : W'.left, W'.hom w ∉ Set.range x₀
  let S : Sieve W :=
    { arrows := fun W' _ => P W'
      downward_closed := by
        intro W' W'' g hg h
        have hw : h.left ≫ W'.hom = W''.hom := MorphismProperty.Over.w h
        rcases hg with ⟨lam, hlam⟩ | hmiss
        · left
          exact ⟨h.left ≫ lam, by rw [Category.assoc, hlam, hw]⟩
        · right
          intro w hw'
          apply hmiss (h.left w)
          have e : W'.hom (h.left w) = W''.hom w := by
            rw [← hw, Scheme.Hom.comp_apply]
          rw [e]
          exact hw' }
  refine ⟨S, hjs S ?_, fun _ g hg => hg⟩
  intro w
  haveI : Etale W.hom := W.prop
  haveI : Etale T.hom := T.prop
  by_cases hw : W.hom w ∈ Set.range x₀
  · obtain ⟨p, hp⟩ := hw
    have he : W.hom w = T.hom (v₀ p) := by
      rw [← hp, ← hv, Scheme.Hom.comp_apply]
    obtain ⟨z, hz, _⟩ := Scheme.Pullback.exists_preimage_pullback w (v₀ p) he
    refine ⟨Scheme.Etale.mk (Limits.pullback.fst W.hom T.hom ≫ W.hom),
      MorphismProperty.Over.homMk (Limits.pullback.fst W.hom T.hom) rfl trivial, ?_, z, hz⟩
    left
    exact ⟨Limits.pullback.snd W.hom T.hom, Limits.pullback.condition.symm⟩
  · have hZ : IsClosed (Set.range x₀) := x₀.isClosedEmbedding.isClosed_range
    let U₀ : W.left.Opens :=
      ⟨W.hom ⁻¹' (Set.range x₀)ᶜ, hZ.isOpen_compl.preimage W.hom.continuous⟩
    have hwU : w ∈ U₀ := hw
    have gen2 : ∀ (Y : Scheme.{u}) (U : Y.Opens) (y : Y) (hy : y ∈ U), U.ι ⟨y, hy⟩ = y := by
      intro Y U y hy
      exact Scheme.Opens.ι_apply U ⟨y, hy⟩
    have gen : ∀ (Y : Scheme.{u}) (f : Y ⟶ X) (U : Y.Opens), (∀ y ∈ U, f y ∉ Set.range x₀) →
        ∀ u : (U : Scheme.{u}), f (U.ι u) ∉ Set.range x₀ := by
      intro Y f U h u
      have e : U.ι u = u.1 := gen2 Y U u.1 u.2
      rw [e]
      exact h _ u.2
    refine ⟨Scheme.Etale.mk (U₀.ι ≫ W.hom), MorphismProperty.Over.homMk U₀.ι rfl trivial, ?_,
      ⟨w, hwU⟩, ?_⟩
    · right
      intro u
      exact gen W.left W.hom U₀ (fun y hy => hy) u
    · exact gen2 W.left U₀ w hwU

theorem wc_et_point_supp_obj_vanish : ∀ {K : Type u} [Field K] {X : Scheme.{u}} (x₀ : Spec (.of K) ⟶ X) (ℓ : ℕ) (Dx : wcEtPullData x₀ ℓ) (W : X.Etale), (∀ w : W.left, W.hom w ∉ Set.range x₀) → Subsingleton ↑((wcEtSuppObj Dx).val.obj (Opposite.op W)) :=
by
  intro K _ X x₀ ℓ Dx W hW
  have hEmpty : IsEmpty ↥(Limits.pullback W.hom x₀) :=
    Scheme.isEmpty_pullback W.hom x₀ (Set.disjoint_left.2 (by rintro _ ⟨w, rfl⟩; exact hW w))
  have hE : IsEmpty ((wcEtBaseChange x₀).obj W).left := hEmpty
  have hBot : (⊥ : Sieve ((wcEtBaseChange x₀).obj W)) ∈
      Scheme.smallEtaleTopology (Spec (.of K)) ((wcEtBaseChange x₀).obj W) :=
    (congrArg (fun J : GrothendieckTopology (Spec (.of K)).Etale =>
        (⊥ : Sieve ((wcEtBaseChange x₀).obj W)) ∈ J ((wcEtBaseChange x₀).obj W))
      (@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
        (Spec (.of K)) MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        _ _ _ _ le_rfl)).mpr
      ((@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale (Spec (.of K))
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _
        ((wcEtBaseChange x₀).obj W) (⊥ : Sieve ((wcEtBaseChange x₀).obj W))).2
          (fun x => isEmptyElim x))
  have hSub : Subsingleton ↑(((SheafOfModules.toSheaf (wcEtZModRing (Spec (.of K)) ℓ)).obj
      (SheafOfModules.unit (wcEtZModRing (Spec (.of K)) ℓ))).obj.obj
        (Opposite.op ((wcEtBaseChange x₀).obj W))) :=
    AddCommGrpCat.subsingleton_of_isZero
      (Sheaf.isTerminalOfBotCover ((SheafOfModules.toSheaf (wcEtZModRing (Spec (.of K)) ℓ)).obj
        (SheafOfModules.unit (wcEtZModRing (Spec (.of K)) ℓ))) _ hBot).isZero
  exact hSub

theorem wc_et_point_lifts_agree_locally : ∀ {K : Type u} [Field K] {X : Scheme.{u}} (T : X.Etale) (x₀ : Spec (.of K) ⟶ X) (v₀ : Spec (.of K) ⟶ T.left) [IsClosedImmersion x₀], IsPullback (𝟙 (Spec (.of K))) v₀ x₀ T.hom → ∀ (W : X.Etale) (lam lam' : W.left ⟶ T.left), lam ≫ T.hom = W.hom → lam' ≫ T.hom = W.hom → ∃ S ∈ Scheme.smallEtaleTopology X W, ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g → g.left ≫ lam = g.left ≫ lam' ∨ ∀ w : W'.left, W'.hom w ∉ Set.range x₀ :=
by
  intro K _ X T x₀ v₀ _ hP W lam lam' hl hl'
  haveI : Etale W.hom := W.prop
  haveI : Etale T.hom := T.prop

  have hjs : ∀ (S : Sieve W), (∀ v : W.left, ∃ (V₁ : X.Etale)
      (c : V₁ ⟶ W), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X W := by
    intro S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X W
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ W.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale W.hom := W.prop
      have h2 : Etale (c.left ≫ W.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left W.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hw0 : v₀ ≫ T.hom = x₀ := (hP.toCommSq.w).symm.trans (Category.id_comp x₀)
  have hsub : ∀ a b : ↥(Spec (.of K)), a = b := fun a b => Subsingleton.elim a b
  have capp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (x : A), (f ≫ g) x = g (f x) :=
    fun f g x => Scheme.Hom.comp_apply f g x

  have s1 : ∀ t : T.left, T.hom t ∈ Set.range x₀ → t = v₀ (IsLocalRing.closedPoint K) := by
    rintro t ⟨p, hp⟩
    obtain ⟨z, _, hz⟩ := Scheme.Pullback.exists_preimage_pullback (f := x₀) (g := T.hom) p t hp
    have h3 : (hP.isoPullback.inv ≫ v₀) z = Limits.pullback.snd x₀ T.hom z := by
      rw [hP.isoPullback_inv_snd]
    rw [Scheme.Hom.comp_apply] at h3
    rw [← hz, ← h3]
    exact congrArg v₀ (hsub _ _)

  have s2 : ∀ p : ↥(Limits.pullback T.hom T.hom),
      (Limits.pullback.fst T.hom T.hom) p = v₀ (IsLocalRing.closedPoint K) →
      p = (Limits.pullback.diagonal T.hom) (v₀ (IsLocalRing.closedPoint K)) := by
    intro p hp
    let e : Limits.pullback v₀ (Limits.pullback.fst T.hom T.hom) ≅ Spec (.of K) :=
      Limits.pullbackRightPullbackFstIso T.hom T.hom v₀ ≪≫ Limits.pullback.congrHom hw0 rfl ≪≫
        hP.isoPullback.symm
    have hP2 : ∀ z₁ z₂ : ↥(Limits.pullback v₀ (Limits.pullback.fst T.hom T.hom)), z₁ = z₂ := by
      intro z₁ z₂
      calc z₁ = e.inv (e.hom z₁) := (Scheme.hom_inv_apply e z₁).symm
        _ = e.inv (e.hom z₂) := by rw [hsub (e.hom z₁) (e.hom z₂)]
        _ = z₂ := Scheme.hom_inv_apply e z₂
    obtain ⟨z, _, hz⟩ := Scheme.Pullback.exists_preimage_pullback (f := v₀)
      (g := Limits.pullback.fst T.hom T.hom) (IsLocalRing.closedPoint K) p hp.symm
    have H : 𝟙 _ ≫ v₀ = (v₀ ≫ Limits.pullback.diagonal T.hom) ≫ Limits.pullback.fst T.hom T.hom := by
      rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id, Category.id_comp]
    have h3 : (Limits.pullback.lift (𝟙 _) (v₀ ≫ Limits.pullback.diagonal T.hom) H ≫
        Limits.pullback.snd v₀ (Limits.pullback.fst T.hom T.hom)) (IsLocalRing.closedPoint K) =
        (v₀ ≫ Limits.pullback.diagonal T.hom) (IsLocalRing.closedPoint K) := by
      rw [Limits.pullback.lift_snd]
    have h4 : Limits.pullback.snd v₀ (Limits.pullback.fst T.hom T.hom)
        (Limits.pullback.lift (𝟙 _) (v₀ ≫ Limits.pullback.diagonal T.hom) H
          (IsLocalRing.closedPoint K)) =
        Limits.pullback.diagonal T.hom (v₀ (IsLocalRing.closedPoint K)) :=
      (capp _ _ _).symm.trans (h3.trans (capp _ _ _))
    rw [← hz, hP2 z (Limits.pullback.lift (𝟙 _) (v₀ ≫ Limits.pullback.diagonal T.hom) H
      (IsLocalRing.closedPoint K))]
    exact h4

  obtain ⟨π, hπ1, hπ2⟩ : ∃ π : W.left ⟶ Limits.pullback T.hom T.hom,
      π ≫ Limits.pullback.fst T.hom T.hom = lam ∧ π ≫ Limits.pullback.snd T.hom T.hom = lam' :=
    ⟨Limits.pullback.lift lam lam' (hl.trans hl'.symm), Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  let E : W.left.Opens := ⟨π ⁻¹' Set.range (Limits.pullback.diagonal T.hom),
    ((Limits.pullback.diagonal T.hom).isOpenEmbedding.isOpen_range).preimage π.continuous⟩

  have hEagr : E.ι ≫ lam = E.ι ≫ lam' := by
    have hsubr : Set.range (E.ι ≫ π) ⊆ Set.range (Limits.pullback.diagonal T.hom) := by
      rintro _ ⟨u, rfl⟩
      have e : E.ι u = u.1 := Scheme.Opens.ι_apply E u
      obtain ⟨y, hy⟩ := u.2
      exact ⟨y, hy.trans ((congrArg π e).symm.trans (capp _ _ _).symm)⟩
    obtain ⟨m, hm⟩ : ∃ m, m ≫ Limits.pullback.diagonal T.hom = E.ι ≫ π :=
      ⟨_, IsOpenImmersion.lift_fac _ _ hsubr⟩
    have ha : E.ι ≫ lam = m := by
      rw [← hπ1, ← Category.assoc, ← hm, Category.assoc, Limits.pullback.diagonal_fst,
        Category.comp_id]
    have hb : E.ι ≫ lam' = m := by
      rw [← hπ2, ← Category.assoc, ← hm, Category.assoc, Limits.pullback.diagonal_snd,
        Category.comp_id]
    rw [ha, hb]

  let S : Sieve W :=
    { arrows := fun W' g => g.left ≫ lam = g.left ≫ lam' ∨ ∀ w : W'.left, W'.hom w ∉ Set.range x₀
      downward_closed := by
        intro W' W'' g hg h
        have hw : h.left ≫ W'.hom = W''.hom := MorphismProperty.Over.w h
        rcases hg with hg | hmiss
        · left
          show (h.left ≫ g.left) ≫ lam = (h.left ≫ g.left) ≫ lam'
          rw [Category.assoc, Category.assoc, hg]
        · right
          intro w hw'
          apply hmiss (h.left w)
          have e : W'.hom (h.left w) = W''.hom w := by
            rw [← hw, Scheme.Hom.comp_apply]
          rw [e]
          exact hw' }
  refine ⟨S, hjs S ?_, fun _ g hg => hg⟩
  intro w
  by_cases hw : W.hom w ∈ Set.range x₀
  · have h1 : lam w = v₀ (IsLocalRing.closedPoint K) := by
      apply s1
      have e : T.hom (lam w) = W.hom w := by rw [← hl, Scheme.Hom.comp_apply]
      rw [e]
      exact hw
    have h2 : Limits.pullback.fst T.hom T.hom (π w) = v₀ (IsLocalRing.closedPoint K) := by
      have e : (π ≫ Limits.pullback.fst T.hom T.hom) w = lam w := by rw [hπ1]
      rw [Scheme.Hom.comp_apply] at e
      rw [e, h1]
    have hwE : w ∈ E := by
      show π w ∈ Set.range (Limits.pullback.diagonal T.hom)
      exact ⟨_, (s2 (π w) h2).symm⟩
    refine ⟨Scheme.Etale.mk (E.ι ≫ W.hom), MorphismProperty.Over.homMk E.ι rfl trivial, ?_,
      ⟨w, hwE⟩, ?_⟩
    · left
      exact hEagr
    · exact Scheme.Opens.ι_apply E ⟨w, hwE⟩
  · have hZ : IsClosed (Set.range x₀) := x₀.isClosedEmbedding.isClosed_range
    let U₀ : W.left.Opens :=
      ⟨W.hom ⁻¹' (Set.range x₀)ᶜ, hZ.isOpen_compl.preimage W.hom.continuous⟩
    have hwU : w ∈ U₀ := hw
    refine ⟨Scheme.Etale.mk (U₀.ι ≫ W.hom), MorphismProperty.Over.homMk U₀.ι rfl trivial, ?_,
      ⟨w, hwU⟩, ?_⟩
    · right
      intro u h
      have e : U₀.ι u = u.1 := Scheme.Opens.ι_apply U₀ u
      have heq : (U₀.ι ≫ W.hom) u = W.hom u.1 := (capp U₀.ι W.hom u).trans (congrArg W.hom e)
      have h' : W.hom u.1 ∈ Set.range x₀ := by rw [← heq]; exact h
      exact u.2 h'
    · exact Scheme.Opens.ι_apply U₀ ⟨w, hwU⟩

theorem wc_et_point_supp_obj_restrict_iso : ∀ {K : Type u} [Field K] {X : Scheme.{u}} (T : X.Etale) [hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (x₀ : Spec (.of K) ⟶ X) (v₀ : Spec (.of K) ⟶ T.left), IsPullback (𝟙 (Spec (.of K))) v₀ x₀ T.hom → ∀ (ℓ : ℕ), (∀ (S : Sheaf (Scheme.smallEtaleTopology T.left) RingCat.{u+1}) (a b : wcEtZModRing T.left ℓ ⟶ S), a = b) → ∀ (Dx : wcEtPullData x₀ ℓ) (Dv : wcEtPullData v₀ ℓ) (ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj (wcEtZModRing X ℓ)), Nonempty ((SheafOfModules.pushforward.{u+1} ψ).obj (wcEtSuppObj Dx) ≅ wcEtSuppObj Dv) :=
by
  intro K _ X T hc x₀ v₀ hP ℓ huniq Dx Dv ψ
  have hα : Nonempty (wcEtSlice T ⋙ wcEtBaseChange x₀ ≅ wcEtBaseChange v₀) := by
    have PB : ∀ U : T.left.Etale, IsPullback (Limits.pullback.fst U.hom v₀)
        (Limits.pullback.snd U.hom v₀) (U.hom ≫ T.hom) x₀ := fun U => by
      simpa using (IsPullback.of_hasPullback U.hom v₀).paste_vert hP.flip
    refine ⟨NatIso.ofComponents
      (fun U => MorphismProperty.Over.isoMk (PB U).isoPullback.symm ?_) ?_⟩
    · exact (PB U).isoPullback_inv_snd
    · intro U U' g
      apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.lift (Limits.pullback.fst (U.hom ≫ T.hom) x₀ ≫ g.left)
          (Limits.pullback.snd (U.hom ≫ T.hom) x₀)
          (by rw [Category.assoc, ← Category.assoc g.left, MorphismProperty.Over.w g,
            Limits.pullback.condition]) ≫ (PB U').isoPullback.inv =
        (PB U).isoPullback.inv ≫ Limits.pullback.lift (Limits.pullback.fst U.hom v₀ ≫ g.left)
          (Limits.pullback.snd U.hom v₀)
          (by rw [Category.assoc, MorphismProperty.Over.w g, Limits.pullback.condition])
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, IsPullback.isoPullback_inv_fst]
        erw [Limits.pullback.lift_fst, Limits.pullback.lift_fst]
        rw [IsPullback.isoPullback_inv_fst_assoc]
      · simp only [Category.assoc, IsPullback.isoPullback_inv_snd]
        erw [Limits.pullback.lift_snd, Limits.pullback.lift_snd]
        rw [IsPullback.isoPullback_inv_snd]
  obtain ⟨α⟩ := hα
  haveI := Dx.cont
  haveI := Dv.cont
  haveI := Functor.isContinuous_comp (wcEtSlice T) (wcEtBaseChange x₀)
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
    (Scheme.smallEtaleTopology (Spec (.of K)))
  exact ⟨((SheafOfModules.pushforwardComp ψ Dx.φ).app
      (SheafOfModules.unit (wcEtZModRing (Spec (.of K)) ℓ))) ≪≫
    (@SheafOfModules.pushforwardNatIso _ _ _ _ _ _ (wcEtBaseChange v₀)
      (wcEtSlice T ⋙ wcEtBaseChange x₀) _ _ _ _
      (ψ ≫ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1} _ _).map Dx.φ) α.symm).app
        (SheafOfModules.unit (wcEtZModRing (Spec (.of K)) ℓ)) ≪≫
    (SheafOfModules.pushforwardCongr (huniq _ _ Dv.φ)).app
      (SheafOfModules.unit (wcEtZModRing (Spec (.of K)) ℓ))⟩

theorem wc_et_supp_restrict_hom_injective : ∀ {X : Scheme.{u}} (T : X.Etale) [hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (ℓ : ℕ) (ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj (wcEtZModRing X ℓ)) (Z : Set X) (N Y : SheafOfModules.{u+1} (wcEtZModRing X ℓ)), (∀ W : X.Etale, (∀ w : W.left, W.hom w ∉ Z) → Subsingleton ↑(N.val.obj (Opposite.op W))) → (∀ W : X.Etale, ∃ S ∈ Scheme.smallEtaleTopology X W, ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g → (∃ lam : W'.left ⟶ T.left, lam ≫ T.hom = W'.hom) ∨ ∀ w : W'.left, W'.hom w ∉ Z) → Function.Injective (fun f : N ⟶ Y => (SheafOfModules.pushforward.{u+1} ψ).map f) :=
by
  intro X T hc ℓ ψ Z N Y hVan hCov f f' hff

  have s1 : ∀ (U : T.left.Etale) (m : N.val.obj (Opposite.op ((wcEtSlice T).obj U))),
      f.val.app (Opposite.op ((wcEtSlice T).obj U)) m =
        f'.val.app (Opposite.op ((wcEtSlice T).obj U)) m := by
    intro U m
    have hff' : (SheafOfModules.pushforward ψ).map f = (SheafOfModules.pushforward ψ).map f' := hff
    have h1 := PresheafOfModules.pushforward_map_app_apply ψ.hom f.val (Opposite.op U) m
    have h2 := PresheafOfModules.pushforward_map_app_apply ψ.hom f'.val (Opposite.op U) m
    rw [← SheafOfModules.pushforward_map_val] at h1 h2
    rw [hff'] at h1
    exact h1.symm.trans h2

  have key : ∀ (W : X.Etale) (s : N.val.obj (Opposite.op W)),
      f.val.app (Opposite.op W) s = f'.val.app (Opposite.op W) s := by
    intro W s
    obtain ⟨S, hS, hSc⟩ := hCov W
    refine Presheaf.IsSheaf.isSeparated Y.isSheaf W S hS
      (f.val.app (Opposite.op W) s) (f'.val.app (Opposite.op W) s) ?_
    intro W' g hg
    have e1 := PresheafOfModules.presheaf_map_apply_coe Y.val g.op (f.val.app (Opposite.op W) s)
    have e2 := PresheafOfModules.presheaf_map_apply_coe Y.val g.op (f'.val.app (Opposite.op W) s)
    refine (e1.trans ?_).trans e2.symm
    rcases hSc g hg with ⟨lam, hlam⟩ | hfree
    ·
      have hEt : Etale lam :=
        MorphismProperty.of_postcomp @Etale lam T.hom T.prop (by rw [hlam]; exact W'.prop)
      let U : T.left.Etale := MorphismProperty.Over.mk ⊤ lam hEt
      let e : (wcEtSlice T).obj U ≅ W' :=
        MorphismProperty.Over.isoMk (Iso.refl W'.left) ((Category.id_comp _).trans hlam.symm)
      have hg' : g = e.inv ≫ (e.hom ≫ g) := (Iso.inv_hom_id_assoc e g).symm
      have h := s1 U (N.val.map (e.hom ≫ g).op s)
      rw [PresheafOfModules.naturality_apply, PresheafOfModules.naturality_apply] at h
      rw [hg', op_comp, PresheafOfModules.map_comp_apply, PresheafOfModules.map_comp_apply, h]
    ·
      haveI := hVan W' hfree
      have hz : ∀ x : N.val.obj (Opposite.op W'),
          f.val.app (Opposite.op W') x = f'.val.app (Opposite.op W') x := by
        intro x
        rw [Subsingleton.elim x 0, map_zero, map_zero]
      rw [← PresheafOfModules.naturality_apply, ← PresheafOfModules.naturality_apply]
      exact hz _

  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro W
  ext s
  exact key W.unop s

theorem wc_et_supp_restrict_hom_surjective : ∀ {X : Scheme.{u}} (T : X.Etale) [hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (ℓ : ℕ) (ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj (wcEtZModRing X ℓ)) (Z : Set X) (N Y : SheafOfModules.{u+1} (wcEtZModRing X ℓ)), (∀ W : X.Etale, (∀ w : W.left, W.hom w ∉ Z) → Subsingleton ↑(N.val.obj (Opposite.op W))) → (∀ W : X.Etale, ∃ S ∈ Scheme.smallEtaleTopology X W, ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g → (∃ lam : W'.left ⟶ T.left, lam ≫ T.hom = W'.hom) ∨ ∀ w : W'.left, W'.hom w ∉ Z) → (∀ (W : X.Etale) (lam lam' : W.left ⟶ T.left), lam ≫ T.hom = W.hom → lam' ≫ T.hom = W.hom → ∃ S ∈ Scheme.smallEtaleTopology X W, ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g → g.left ≫ lam = g.left ≫ lam' ∨ ∀ w : W'.left, W'.hom w ∉ Z) → Function.Surjective (fun f : N ⟶ Y => (SheafOfModules.pushforward.{u+1} ψ).map f) :=
by
  classical
  intro X T hc ℓ ψ Z N Y hVan hCov hLoc g

  have hfac : ∀ (V : X.Etale) (lam : V.left ⟶ T.left), lam ≫ T.hom = V.hom →
      ∃ (U : T.left.Etale) (e : (wcEtSlice T).obj U ≅ V), ∀ (U' : T.left.Etale)
        (j : V ⟶ (wcEtSlice T).obj U'), j.left ≫ U'.hom = lam →
        ∃ b : U ⟶ U', j = e.inv ≫ (wcEtSlice T).map b := by
    intro V lam hlam
    have hEt : Etale lam :=
      MorphismProperty.of_postcomp @Etale lam T.hom T.prop (by rw [hlam]; exact V.prop)
    refine ⟨MorphismProperty.Over.mk ⊤ lam hEt,
      MorphismProperty.Over.isoMk (Iso.refl V.left) ((Category.id_comp _).trans hlam.symm), ?_⟩
    intro U' j hj
    refine ⟨MorphismProperty.Over.homMk j.left hj trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact (Category.id_comp _).symm

  have mc : ∀ (F : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {A B C : X.Etale} (f : A ⟶ B) (h : B ⟶ C)
      (x : ↑(F.obj (Opposite.op C))), F.map (f ≫ h).op x = F.map f.op (F.map h.op x) := by
    intro F A B C f h x
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl
  have mi : ∀ (F : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {A : X.Etale}
      (x : ↑(F.obj (Opposite.op A))), F.map (𝟙 A).op x = x := by
    intro F A x
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  have key : ∀ (P Q : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Presheaf.IsSheaf (Scheme.smallEtaleTopology X) Q →
      ∀ (θ : ∀ U : T.left.Etale, ↑(P.obj (Opposite.op ((wcEtSlice T).obj U))) →+
          ↑(Q.obj (Opposite.op ((wcEtSlice T).obj U)))),
      (∀ W : X.Etale, (∀ w : W.left, W.hom w ∉ Z) → Subsingleton ↑(P.obj (Opposite.op W))) →
      (∀ (U U' : T.left.Etale) (b : U' ⟶ U) (x : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U)))),
        Q.map ((wcEtSlice T).map b).op (θ U x) = θ U' (P.map ((wcEtSlice T).map b).op x)) →
      ∃ φ : P ⟶ Q, ∀ (U : T.left.Etale) (x : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U)))),
        φ.app (Opposite.op ((wcEtSlice T).obj U)) x = θ U x := by
    intro P Q hQ θ hVanP hnat

    have hzero : ∀ (U : T.left.Etale) (V : X.Etale) (j : V ⟶ (wcEtSlice T).obj U)
        (x : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U)))), (∀ v : V.left, V.hom v ∉ Z) →
        Q.map j.op (θ U x) = 0 := by
      intro U V j x hV
      have hlam : (j.left ≫ U.hom) ≫ T.hom = V.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w j)
      obtain ⟨U₀, e, he⟩ := hfac V _ hlam
      obtain ⟨b, hb⟩ := he U j rfl
      have hfree : ∀ w : ((wcEtSlice T).obj U₀).left, ((wcEtSlice T).obj U₀).hom w ∉ Z := by
        intro w
        rw [← MorphismProperty.Over.w e.hom]
        exact hV _
      haveI := hVanP _ hfree
      rw [hb, mc Q e.inv ((wcEtSlice T).map b), hnat U U₀ b x,
        Subsingleton.elim (P.map ((wcEtSlice T).map b).op x) 0, map_zero, map_zero]

    have hcompat : ∀ (V : X.Etale) (U₁ U₂ : T.left.Etale) (j₁ : V ⟶ (wcEtSlice T).obj U₁)
        (j₂ : V ⟶ (wcEtSlice T).obj U₂) (x₁ : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U₁))))
        (x₂ : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U₂)))),
        P.map j₁.op x₁ = P.map j₂.op x₂ → Q.map j₁.op (θ U₁ x₁) = Q.map j₂.op (θ U₂ x₂) := by
      intro V U₁ U₂ j₁ j₂ x₁ x₂ hx
      have h₁ : (j₁.left ≫ U₁.hom) ≫ T.hom = V.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w j₁)
      have h₂ : (j₂.left ≫ U₂.hom) ≫ T.hom = V.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w j₂)
      obtain ⟨S, hS, hSc⟩ := hLoc V _ _ h₁ h₂
      refine hQ.isSeparated V S hS _ _ ?_
      intro V' g hg
      rw [← mc Q g j₁, ← mc Q g j₂]
      rcases hSc g hg with hag | hfree
      · have hlam : (g.left ≫ j₁.left ≫ U₁.hom) ≫ T.hom = V'.hom :=
          (Category.assoc _ _ _).trans ((congrArg (fun t => g.left ≫ t) h₁).trans
            (MorphismProperty.Over.w g))
        obtain ⟨U, e, he⟩ := hfac V' _ hlam
        obtain ⟨b₁, hb₁⟩ := he U₁ (g ≫ j₁) (Category.assoc _ _ _)
        obtain ⟨b₂, hb₂⟩ := he U₂ (g ≫ j₂) ((Category.assoc _ _ _).trans hag.symm)
        have hP : ∀ (U' : T.left.Etale) (j : V ⟶ (wcEtSlice T).obj U') (b : U ⟶ U')
            (x : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U')))),
            g ≫ j = e.inv ≫ (wcEtSlice T).map b →
            P.map ((wcEtSlice T).map b).op x = P.map e.hom.op (P.map g.op (P.map j.op x)) := by
          intro U' j b x hb
          have hb' : (wcEtSlice T).map b = e.hom ≫ g ≫ j := by rw [hb, Iso.hom_inv_id_assoc]
          rw [hb', mc P e.hom (g ≫ j), mc P g j]
        rw [hb₁, hb₂, mc Q e.inv ((wcEtSlice T).map b₁), mc Q e.inv ((wcEtSlice T).map b₂),
          hnat U₁ U b₁ x₁, hnat U₂ U b₂ x₂, hP U₁ j₁ b₁ x₁ hb₁, hP U₂ j₂ b₂ x₂ hb₂, hx]
      · rw [hzero U₁ V' (g ≫ j₁) x₁ hfree, hzero U₂ V' (g ≫ j₂) x₂ hfree]

    have hdet : ∀ (W : X.Etale) (y y' : ↑(Q.obj (Opposite.op W))),
        (∀ (U : T.left.Etale) (k : (wcEtSlice T).obj U ⟶ W), Q.map k.op y = Q.map k.op y') →
        (∀ (V : X.Etale) (k : V ⟶ W), (∀ v : V.left, V.hom v ∉ Z) →
          Q.map k.op y = Q.map k.op y') → y = y' := by
      intro W y y' h1 h2
      obtain ⟨S, hS, hSc⟩ := hCov W
      refine hQ.isSeparated W S hS y y' ?_
      intro W' g hg
      rcases hSc g hg with ⟨lam, hlam⟩ | hfree
      · obtain ⟨U, e, -⟩ := hfac W' lam hlam
        rw [← Iso.inv_hom_id_assoc e g, mc Q e.inv (e.hom ≫ g) y, mc Q e.inv (e.hom ≫ g) y',
          h1 U (e.hom ≫ g)]
      · exact h2 W' g hfree

    obtain ⟨Good, hGood⟩ : ∃ Good : ∀ W : X.Etale, ↑(P.obj (Opposite.op W)) →
        ↑(Q.obj (Opposite.op W)) → Prop, ∀ W s u, Good W s u ↔
          ((∀ (U : T.left.Etale) (k : (wcEtSlice T).obj U ⟶ W), Q.map k.op u = θ U (P.map k.op s)) ∧
            ∀ (V : X.Etale) (k : V ⟶ W), (∀ v : V.left, V.hom v ∉ Z) → Q.map k.op u = 0) :=
      ⟨_, fun _ _ _ => Iff.rfl⟩
    have huniq : ∀ W s u u', Good W s u → Good W s u' → u = u' := by
      intro W s u u' hu hu'
      rw [hGood] at hu hu'
      exact hdet W u u' (fun U k => (hu.1 U k).trans (hu'.1 U k).symm)
        (fun V k hV => (hu.2 V k hV).trans (hu'.2 V k hV).symm)
    have hres : ∀ (W W' : X.Etale) (f : W' ⟶ W) s u, Good W s u →
        Good W' (P.map f.op s) (Q.map f.op u) := by
      intro W W' f s u hu
      rw [hGood] at hu ⊢
      refine ⟨fun U k => ?_, fun V k hV => ?_⟩
      · rw [← mc Q k f, ← mc P k f]; exact hu.1 U (k ≫ f)
      · rw [← mc Q k f]; exact hu.2 V (k ≫ f) hV

    have hrg : ∀ (U : T.left.Etale) (x : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U))))
        (V : X.Etale) (h : V ⟶ (wcEtSlice T).obj U),
        Good V (P.map h.op x) (Q.map h.op (θ U x)) := by
      intro U x V h
      rw [hGood]
      refine ⟨fun Ua k => ?_, fun Va k hk => ?_⟩
      · rw [← mc Q k h, ← mc P k h]
        have hc := hcompat _ U Ua (k ≫ h) (𝟙 _) x (P.map (k ≫ h).op x) (mi P _).symm
        rw [hc, mi Q]
      · rw [← mc Q k h]; exact hzero U Va (k ≫ h) x hk

    have hloc : ∀ (W' : X.Etale) (t : ↑(P.obj (Opposite.op W'))),
        ((∃ lam : W'.left ⟶ T.left, lam ≫ T.hom = W'.hom) ∨ ∀ w : W'.left, W'.hom w ∉ Z) →
        ∃ u, Good W' t u := by
      intro W' t ht
      rcases ht with ⟨lam, hlam⟩ | hfree
      · obtain ⟨U, e, -⟩ := hfac W' lam hlam
        refine ⟨Q.map e.inv.op (θ U (P.map e.hom.op t)), ?_⟩
        have h := hrg U (P.map e.hom.op t) W' e.inv
        rwa [← mc P e.inv e.hom, Iso.inv_hom_id, mi P] at h
      · haveI := hVanP W' hfree
        refine ⟨0, ?_⟩
        rw [hGood, Subsingleton.elim t 0]
        refine ⟨fun U k => ?_, fun V k _ => ?_⟩
        · simp only [map_zero]
        · simp only [map_zero]

    have hglue : ∀ (W : X.Etale) (s : ↑(P.obj (Opposite.op W))), ∃ u, Good W s u := by
      intro W s
      obtain ⟨S, hS, hSc⟩ := hCov W
      have hfam : ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g → ∃ u, Good W' (P.map g.op s) u :=
        fun W' g hg => hloc W' _ (hSc g hg)
      choose u hu using hfam
      have hQt : Presieve.IsSheafFor (Q ⋙ forget AddCommGrpCat.{u+1}) S.arrows :=
        (isSheaf_iff_isSheaf_of_type _ _).mp
          (GrothendieckTopology.HasSheafCompose.isSheaf _ hQ) S hS
      let xf : Presieve.FamilyOfElements (Q ⋙ forget AddCommGrpCat.{u+1}) S.arrows :=
        fun W' g hg => u g hg
      have hx : xf.Compatible := by
        intro W₁ W₂ W₀ g₁ g₂ f₁ f₂ h₁ h₂ hcomm
        have e1 := hres _ _ g₁ _ _ (hu f₁ h₁)
        have e2 := hres _ _ g₂ _ _ (hu f₂ h₂)
        rw [← mc P g₁ f₁, hcomm, mc P g₂ f₂] at e1
        exact huniq _ _ _ _ e1 e2
      obtain ⟨y, hy⟩ : ∃ y : ↑(Q.obj (Opposite.op W)), ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W)
          (hg : S.arrows g), Q.map g.op y = u g hg :=
        ⟨hQt.amalgamate xf hx, fun W' g hg => hQt.valid_glue hx g hg⟩
      refine ⟨y, ?_⟩
      rw [hGood]
      refine ⟨fun Ua k => ?_, fun Va k hVa => ?_⟩
      · refine hQ.isSeparated _ (S.pullback k)
          ((Scheme.smallEtaleTopology X).pullback_stable k hS) _ _ ?_
        intro V' m hm
        have g1 := hu (m ≫ k) hm
        have g2 := hrg Ua (P.map k.op s) V' m
        rw [← mc P m k] at g2
        rw [← mc Q m k y, hy (m ≫ k) hm]
        exact huniq _ _ _ _ g1 g2
      · refine hQ.isSeparated _ (S.pullback k)
          ((Scheme.smallEtaleTopology X).pullback_stable k hS) _ _ ?_
        intro V' m hm
        have g1 := hu (m ≫ k) hm
        rw [hGood] at g1
        have hV' : ∀ v : V'.left, V'.hom v ∉ Z := by
          intro v
          rw [← MorphismProperty.Over.w m]
          exact hVa _
        have h0 := g1.2 V' (𝟙 V') hV'
        rw [mi Q] at h0
        rw [← mc Q m k y, hy (m ≫ k) hm, h0, map_zero]

    choose φf hφf using hglue
    have hadd : ∀ W (s s' : ↑(P.obj (Opposite.op W))), φf W (s + s') = φf W s + φf W s' := by
      intro W s s'
      apply huniq W (s + s') _ _ (hφf W (s + s'))
      have h1 := hφf W s
      have h2 := hφf W s'
      rw [hGood] at h1 h2 ⊢
      refine ⟨fun U k => ?_, fun V k hV => ?_⟩
      · simp only [map_add]
        rw [h1.1 U k, h2.1 U k]
      · rw [map_add, h1.2 V k hV, h2.2 V k hV, add_zero]
    have hnatφ : ∀ (W W' : X.Etale) (f : W' ⟶ W) (s : ↑(P.obj (Opposite.op W))),
        φf W' (P.map f.op s) = Q.map f.op (φf W s) :=
      fun W W' f s => huniq _ _ _ _ (hφf W' (P.map f.op s)) (hres W W' f s _ (hφf W s))
    refine ⟨{ app := fun A => AddCommGrpCat.ofHom (AddMonoidHom.mk' (φf A.unop) (hadd A.unop))
              naturality := ?_ }, ?_⟩
    · intro A B f
      ext s
      exact hnatφ A.unop B.unop f.unop s
    · intro U x
      have h := (hGood _ _ _).mp (hφf ((wcEtSlice T).obj U) x)
      have h1 := h.1 U (𝟙 _)
      rw [mi Q, mi P] at h1
      exact h1

  have hQY : Presheaf.IsSheaf (Scheme.smallEtaleTopology X) Y.val.presheaf := Y.isSheaf
  obtain ⟨φ, hφ⟩ := key N.val.presheaf Y.val.presheaf hQY
    (fun U => (g.val.app (Opposite.op U)).hom.toAddMonoidHom)
    (fun W hW => hVan W hW)
    (fun U U' b x => (PresheafOfModules.naturality_apply g.val b.op x).symm)

  let α : (Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod ℓ))) ⟶
      (wcEtZModRing X ℓ).obj :=
    toSheafify (Scheme.smallEtaleTopology X)
      ((Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod ℓ))))
  haveI hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) α :=
    Presheaf.isLocallySurjective_toSheafify' _ _
  have hint : ∀ (V : (X.Etale)ᵒᵖ) (t : ULift.{u+1} (ZMod ℓ)), ∃ k : ℤ,
      ConcreteCategory.hom (α.app V) t = (k : (wcEtZModRing X ℓ).obj.obj V) := by
    intro V t
    refine ⟨(t.down.cast : ℤ), ?_⟩
    have ht : t = (((t.down.cast : ℤ)) : ULift.{u+1} (ZMod ℓ)) := by
      apply ULift.ext
      rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
    conv_lhs => rw [ht]
    exact map_intCast (ConcreteCategory.hom (α.app V)) _
  obtain ⟨f, hfx⟩ : ∃ f : N ⟶ Y, ∀ (V : (X.Etale)ᵒᵖ) (x : ↑(N.val.obj V)),
      f.val.app V x = φ.app V x := by
    refine ⟨⟨PresheafOfModules.homMk φ ?_⟩, fun V x => rfl⟩
    intro V r m
    let φX : ∀ V, N.val.obj V → Y.val.obj V := fun V x => (φ.app V).hom x
    have nat : ∀ (V W : (X.Etale)ᵒᵖ) (h : V ⟶ W) (x : N.val.obj V),
        Y.val.map h (φX V x) = φX W (N.val.map h x) := by
      intro V W h x
      exact (ConcreteCategory.congr_hom (φ.naturality h) x).symm
    have hadd : ∀ V (k : ℤ) (x : N.val.obj V), φX V (k • x) = k • φX V x :=
      fun V k x => map_zsmul (φ.app V).hom k x
    show φX V (r • m) = r • φX V m
    refine Presheaf.IsSheaf.isSeparated Y.isSheaf V.unop _
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X) α r) _ _ ?_
    intro W h hh
    obtain ⟨t, ht⟩ := hh
    obtain ⟨k, hk⟩ := hint (Opposite.op W) t
    have hr : ConcreteCategory.hom ((wcEtZModRing X ℓ).obj.map h.op) r =
        (k : (wcEtZModRing X ℓ).obj.obj (Opposite.op W)) :=
      ht.symm.trans hk
    show Y.val.map h.op (φX V (r • m)) = Y.val.map h.op (r • φX V m)
    rw [nat, N.val.map_smul, Y.val.map_smul, nat, hr]
    have h1 : ∀ x : N.val.obj (Opposite.op W),
        ((k : (wcEtZModRing X ℓ).obj.obj (Opposite.op W)) • x) = k • x :=
      fun x => Int.cast_smul_eq_zsmul _ _ _
    have h2 : ∀ x : Y.val.obj (Opposite.op W),
        ((k : (wcEtZModRing X ℓ).obj.obj (Opposite.op W)) • x) = k • x :=
      fun x => Int.cast_smul_eq_zsmul _ _ _
    exact (congrArg (φX _) (h1 _)).trans ((hadd _ k _).trans (h2 _).symm)
  refine ⟨f, ?_⟩
  show (SheafOfModules.pushforward.{u+1} ψ).map f = g
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro U
  ext m
  have h1 := PresheafOfModules.pushforward_map_app_apply ψ.hom f.val U m
  rw [← SheafOfModules.pushforward_map_val] at h1
  refine h1.trans ?_
  exact (hfx _ m).trans (hφ U.unop m)

theorem wc_et_point_supp_ext_etale_excision : ∀ (K : Type u) [Field K] (X V : Scheme.{u}) (φ : V ⟶ X) [Etale φ] (x₀ : Spec (.of K) ⟶ X) (v₀ : Spec (.of K) ⟶ V) [IsClosedImmersion x₀] [IsClosedImmersion v₀], v₀ ≫ φ = x₀ → (∀ v : V, φ v = x₀ (IsLocalRing.closedPoint K) → v = v₀ (IsLocalRing.closedPoint K)) → ∀ (ℓ : ℕ) (Dx : wcEtPullData x₀ ℓ) (Dv : wcEtPullData v₀ ℓ) (q : ℕ), Nonempty (wcEtSuppExt Dx q ≃ wcEtSuppExt Dv q) :=
by
  classical
  intro K _ X V φ hφ x₀ v₀ _ _ h hfib ℓ Dx Dv q

  have s1 : ∀ (Y : Scheme.{u}) (n : ℕ) (S : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1})
      (a b : wcEtZModRing Y n ⟶ S), a = b := by
    intro Y n S a b
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}).homEquiv
      ((Functor.const _).obj (RingCat.of (ULift.{u+1} (ZMod n)))) S).injective
    apply NatTrans.ext
    funext W
    apply RingCat.hom_ext
    have key : ∀ f g : ULift.{u+1} (ZMod n) →+* (S.obj.obj W), f = g := by
      intro f g
      have h0 := RingHom.ext_zmod (f.comp (ULift.ringEquiv.{0, u+1} (R := ZMod n)).symm.toRingHom)
        (g.comp (ULift.ringEquiv.{0, u+1} (R := ZMod n)).symm.toRingHom)
      ext x
      exact congrArg (fun k => k x.down) h0
    exact key _ _

  have main : ∀ (T : X.Etale) (w₀ : Spec (.of K) ⟶ T.left),
      IsPullback (𝟙 (Spec (.of K))) w₀ x₀ T.hom → w₀ ≫ T.hom = x₀ →
      ∀ (Dw : wcEtPullData w₀ ℓ), Nonempty (wcEtSuppExt Dx q ≃ wcEtSuppExt Dw q) := by
    intro T w₀ hP hT Dw
    haveI hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology X) := (wc_et_slice_continuous T).1
    haveI hcc : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology X) := (wc_et_slice_continuous T).2

    obtain ⟨ψ, ⟨eU⟩⟩ := wc_et_slice_zmod_restrict_unit T ℓ
    obtain ⟨hA, hL, hC⟩ := wc_et_slice_module_restrict_exact T ℓ ψ
    haveI := hA
    haveI := hL
    haveI := hC

    obtain ⟨eN⟩ := wc_et_point_supp_obj_restrict_iso T x₀ w₀ hP ℓ (s1 T.left ℓ) Dx Dw ψ
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T.left ℓ)) := HasExt.standard _
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) :=
      sheafOfModules_enoughInjectives _ _

    have hvan0 := wc_et_point_supp_obj_vanish x₀ ℓ Dx
    have hcov := wc_et_point_two_piece_cover T x₀ w₀ hT
    have hloc := wc_et_point_lifts_agree_locally T x₀ w₀ hP
    have hbij : ∀ Y : SheafOfModules.{u+1} (wcEtZModRing X ℓ), Function.Bijective
        (fun f : wcEtSuppObj Dx ⟶ Y => (SheafOfModules.pushforward.{u+1} ψ).map f) := fun Y =>
      ⟨wc_et_supp_restrict_hom_injective T ℓ ψ (Set.range x₀) (wcEtSuppObj Dx) Y hvan0 hcov,
        wc_et_supp_restrict_hom_surjective T ℓ ψ (Set.range x₀) (wcEtSuppObj Dx) Y hvan0 hcov
          hloc⟩
    have hhom : ∀ Y : SheafOfModules.{u+1} (wcEtZModRing X ℓ), Function.Bijective
        (fun f : wcEtSuppObj Dx ⟶ Y => eN.inv ≫ (SheafOfModules.pushforward.{u+1} ψ).map f) := by
      intro Y
      have hiso : Function.Bijective (fun g : (SheafOfModules.pushforward.{u+1} ψ).obj
          (wcEtSuppObj Dx) ⟶ (SheafOfModules.pushforward.{u+1} ψ).obj Y => eN.inv ≫ g) :=
        ⟨fun g₁ g₂ hg => (cancel_epi eN.inv).mp hg,
          fun g => ⟨eN.hom ≫ g, Iso.inv_hom_id_assoc eN g⟩⟩
      exact hiso.comp (hbij Y)

    have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing X ℓ)) [Injective I] (k : ℕ)
        (e : Abelian.Ext (wcEtSuppObj Dw) ((SheafOfModules.pushforward.{u+1} ψ).obj I) (k + 1)),
        e = 0 := by
      intro I hI k e
      haveI := wc_et_slice_module_restrict_injective T ℓ ψ I hI
      exact Abelian.Ext.eq_zero_of_injective e

    have hΦ := ext_transfer_of_corep (SheafOfModules.pushforward.{u+1} ψ) (wcEtSuppObj Dx)
      (wcEtSuppObj Dw) eN.inv hhom hvan (SheafOfModules.unit (wcEtZModRing X ℓ)) q
    have hΨ : Function.Bijective (fun y : Abelian.Ext (wcEtSuppObj Dw)
        ((SheafOfModules.pushforward.{u+1} ψ).obj (SheafOfModules.unit (wcEtZModRing X ℓ))) q =>
        y.comp (Abelian.Ext.mk₀ eU.hom) (add_zero q)) := by
      refine ⟨fun y₁ y₂ hy => ?_, fun z => ⟨z.comp (Abelian.Ext.mk₀ eU.inv) (add_zero q), ?_⟩⟩
      · have hy' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ eU.inv) (add_zero q)) hy
        simp only at hy'
        rwa [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id,
          Abelian.Ext.comp_mk₀_id] at hy'
      · simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    exact ⟨Equiv.ofBijective _ (hΨ.comp hΦ)⟩

  have hP : IsPullback (𝟙 (Spec (.of K))) v₀ x₀ φ :=
    wc_et_point_fibre_isPullback K X V φ x₀ v₀ h hfib
  exact main (MorphismProperty.Over.mk ⊤ φ hφ) v₀ hP h Dv

theorem wc_curve_open_gysin_h1_card : ∀ (k : Type u) [Field k] [IsAlgClosed k] (ℓ : ℕ), ℓ.Prime → (ℓ : k) ≠ 0 → ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of k)) [IsProper fY] [SmoothOfRelativeDimension 1 fY] (U : Scheme.{u}) (j : U ⟶ Y) [IsOpenImmersion j] [IsAffine U], (Set.range j)ᶜ.Finite → Finite (wcEtCoh U ℓ 1) ∧ Nat.card (wcEtCoh U ℓ 1) * Nat.card (wcEtCoh Y ℓ 2) = Nat.card (wcEtCoh Y ℓ 1) * ℓ ^ Nat.card ↥((Set.range j)ᶜ) :=
by
  classical
  intro k _ _ ℓ hℓ hℓk Y fY _ _ U j _ _ hfin
  haveI hfact : Fact (Nat.Prime ℓ) := ⟨hℓ⟩

  have hopK : Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k)) ≫
      Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k)) = 𝟙 _ := by
    rw [← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext x
    simp
  haveI : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k))) := by
    haveI : IsClosedImmersion
        (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k)) ≫
          Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k))) := by
      rw [hopK]; infer_instance
    exact IsClosedImmersion.of_comp _
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin 1) k)))
  have hclosed : IsClosed (Set.range
      (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k)))) :=
    (Scheme.Hom.isClosedEmbedding _).isClosed_range
  let U₀ : (Spec (.of (MvPolynomial (Fin 1) k))).Opens :=
    ⟨(Set.range (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k))))ᶜ, hclosed.isOpen_compl⟩
  obtain ⟨h0, h1eq, h2⟩ := wc_et_punctured_line_coh_card k ℓ hℓ hℓk U₀ rfl
  obtain ⟨-, hK⟩ := wc_affine_kummer_h1_card_of_pic k ℓ hℓ hℓk
    (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k))
    (Spec.map (CommRingCat.ofHom ((algebraMap (MvPolynomial (Fin 1) k)
      (Localization.Away (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) k))).comp
        (algebraMap k (MvPolynomial (Fin 1) k)))))
    (wc_et_gm_h1_affine_pic _)
  obtain ⟨hP, hUn⟩ := wc_laurent_away_pic_units_card k ℓ hℓ
  have h1 : Nat.card (wcEtCoh U₀ ℓ 1) = ℓ := by rw [h1eq, hK, hP, hUn, one_mul]
  have HL := wc_et_line_origin_supp_ext_card k ℓ hℓ hℓk U₀ rfl h0 h1 h2

  have hstep : ∀ (W : Y.Opens) (x₀ : Spec (.of k) ⟶ (W : Scheme.{u})) (W' : (W : Scheme.{u}).Opens),
      x₀ ≫ W.ι ≫ fY = 𝟙 _ → (W' : Set ↥(W : Scheme.{u})) = (Set.range x₀)ᶜ →
      Finite (wcEtCoh W ℓ 1) → Finite (wcEtCoh W ℓ 2) →
      Finite (wcEtCoh W' ℓ 1) ∧ Finite (wcEtCoh W' ℓ 2) ∧
        Nat.card (wcEtCoh W' ℓ 1) * Nat.card (wcEtCoh W ℓ 2) =
          Nat.card (wcEtCoh W ℓ 1) * Nat.card (wcEtCoh W' ℓ 2) * ℓ := by
    intro W x₀ W' hx₀ hW' hf1 hf2
    haveI hsm : SmoothOfRelativeDimension 1 (W.ι ≫ fY) :=
      (inferInstance : SmoothOfRelativeDimension (0 + 1) (W.ι ≫ fY))
    obtain ⟨Dx⟩ := wc_et_zmod_pull_data_exists x₀ ℓ
    have P : Subsingleton (wcEtSuppExt Dx 1) ∧ Subsingleton (wcEtSuppExt Dx 3) ∧
        Finite (wcEtSuppExt Dx 2) ∧ Nat.card (wcEtSuppExt Dx 2) = ℓ := by
      obtain ⟨V, ι, hι, v₀, φ, hv₀ι, hφet, hv₀φ, hfib⟩ :=
        wc_smooth_rational_point_etale_chart k (W : Scheme.{u}) (W.ι ≫ fY) 1 x₀ hx₀
      haveI := hι
      haveI := hφet
      haveI : IsClosedImmersion x₀ := by
        haveI : IsClosedImmersion (x₀ ≫ W.ι ≫ fY) := by rw [hx₀]; infer_instance
        exact IsClosedImmersion.of_comp x₀ (W.ι ≫ fY)
      haveI : IsClosedImmersion v₀ := by
        haveI : IsClosedImmersion (v₀ ≫ ι ≫ W.ι ≫ fY) := by
          rw [← Category.assoc, hv₀ι, hx₀]; infer_instance
        exact IsClosedImmersion.of_comp v₀ (ι ≫ W.ι ≫ fY)
      have hfibι : ∀ v : V, ι v = x₀ (IsLocalRing.closedPoint k) →
          v = v₀ (IsLocalRing.closedPoint k) := by
        intro v hv
        apply ι.isOpenEmbedding.injective
        rw [hv, ← hv₀ι]
        rfl
      obtain ⟨Dv⟩ := wc_et_zmod_pull_data_exists v₀ ℓ
      obtain ⟨Do⟩ := wc_et_zmod_pull_data_exists
        (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) k →+* k))) ℓ
      have eqv : ∀ q, Nonempty (wcEtSuppExt Dx q ≃ wcEtSuppExt Do q) := by
        intro q
        obtain ⟨e1⟩ := wc_et_point_supp_ext_etale_excision k (W : Scheme.{u}) V ι x₀ v₀ hv₀ι hfibι
          ℓ Dx Dv q
        obtain ⟨e2⟩ := wc_et_point_supp_ext_etale_excision k (Spec (.of (MvPolynomial (Fin 1) k)))
          V φ _ v₀ hv₀φ hfib ℓ Do Dv q
        exact ⟨e1.trans e2.symm⟩
      obtain ⟨p1, p3, pf, pc⟩ := HL Do
      obtain ⟨e1⟩ := eqv 1
      obtain ⟨e2⟩ := eqv 2
      obtain ⟨e3⟩ := eqv 3
      exact ⟨e1.subsingleton_congr.mpr p1, e3.subsingleton_congr.mpr p3,
        Finite.of_equiv _ e2.symm, (Nat.card_congr e2).trans pc⟩
    obtain ⟨p1, p3, pf, pc⟩ := P
    exact wc_et_remove_point_coh_step k (W : Scheme.{u}) (W.ι ≫ fY) ℓ x₀ hx₀ Dx p1 p3 pf pc W' hW'
      hf1 hf2

  haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace fY
  have hDclosed : IsClosed (Set.range j)ᶜ := (j.isOpenEmbedding.isOpen_range).isClosed_compl
  have hcl : ∀ y ∈ (Set.range j)ᶜ, IsClosed ({y} : Set Y) := by
    intro y hy
    have hZ : closure ({y} : Set Y) ⊆ (Set.range j)ᶜ :=
      closure_minimal (Set.singleton_subset_iff.mpr hy) hDclosed
    have hZfin : (closure ({y} : Set Y)).Finite := hfin.subset hZ
    have hcc : IsClosed (closure ({y} : Set Y) ∩ closedPoints Y) := by
      have h := (hZfin.subset Set.inter_subset_left).isClosed_biUnion
        (f := fun z => ({z} : Set Y)) (fun z hz => mem_closedPoints_iff.mp hz.2)
      rwa [Set.biUnion_of_singleton] at h
    have heq := JacobsonSpace.closure_inter_closedPoints
      (isClosed_closure : IsClosed (closure ({y} : Set Y)))
    rw [hcc.closure_eq] at heq
    have hy' : y ∈ closure ({y} : Set Y) ∩ closedPoints Y := by
      rw [heq]; exact subset_closure rfl
    exact mem_closedPoints_iff.mp hy'.2

  let V : Y.Opens := ⟨Set.range j, j.isOpenEmbedding.isOpen_range⟩
  have hV : (V : Set Y) = ((Set.range j)ᶜ)ᶜ := (compl_compl (Set.range j)).symm
  obtain ⟨hV1, -, hc⟩ := wc_curve_remove_finite_points_card k ℓ Y fY hstep
    (wc_etale_proper_finite k Y fY ℓ hℓk 1) (wc_etale_proper_finite k Y fY ℓ hℓk 2)
    (Set.range j)ᶜ hfin hcl V hV

  let eUV : U ≅ (V : Scheme.{u}) :=
    IsOpenImmersion.isoOfRangeEq j V.ι (Scheme.Opens.range_ι V).symm
  obtain ⟨E1⟩ := wc_et_coh_iso_invariance eUV.hom ℓ 1
  obtain ⟨E2⟩ := wc_et_coh_iso_invariance eUV.hom ℓ 2
  have hA : (ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨z⟩
    apply ULift.ext
    simp
  have htor : ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 := by
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hA,
      CategoryTheory.Functor.map_zero]
  have hU2 := wc_et_affine_curve_torsion_vanishing k Y fY U j ℓ hℓk _ htor 2 le_rfl
  have hV2 : Nat.card (wcEtCoh (V : Scheme.{u}) ℓ 2) = 1 := by
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}) := HasExt.standard _
    haveI hsub : Subsingleton (wcEtCoh U ℓ 2) := ⟨fun a b => (hU2 a).trans (hU2 b).symm⟩
    haveI : Nonempty (wcEtCoh U ℓ 2) :=
      ⟨(0 : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology U) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) 2)⟩
    rw [Nat.card_congr E2]
    exact Nat.card_unique
  haveI : Finite (wcEtCoh (V : Scheme.{u}) ℓ 1) := hV1
  refine ⟨Finite.of_equiv _ E1, ?_⟩
  rw [← Nat.card_congr E1, hc, hV2, mul_one]

theorem wcpa_ssd_affine_model : ∀ (K : Type u) [Field K] (W : Scheme.{u}) (s : W ⟶ Spec (.of K)) (n : ℕ) [SmoothOfRelativeDimension n s] (w : W), ∃ (A : Type u) (_ : CommRing A) (_ : Algebra K A) (_ : Algebra.Smooth K A) (p : Ideal A) (_ : p.IsPrime), Nonempty (W.presheaf.stalk w ≃+* Localization.AtPrime p) :=
by
  intro K _ W s n _ w
  have hs : Smooth s := SmoothOfRelativeDimension.smooth n s
  obtain ⟨V, hV, hw, -⟩ := exists_isAffineOpen_mem_and_subset (x := w) (U := ⊤) trivial
  have e : V ≤ s ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  have h₁ : (s.appLE ⊤ V e).hom.Smooth :=
    HasRingHomProperty.appLE @Smooth s hs ⟨⊤, isAffineOpen_top (Spec (.of K))⟩ ⟨V, hV⟩ e
  set g : K →+* Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (.of K)).inv.hom with hg
  have hgb : Function.Bijective g := by
    refine Function.bijective_iff_has_inverse.mpr ⟨(Scheme.ΓSpecIso (.of K)).hom.hom, ?_, ?_⟩
    · intro x
      exact CommRingCat.hom_inv_apply (Scheme.ΓSpecIso (.of K)) x
    · intro x
      exact CommRingCat.inv_hom_apply (Scheme.ΓSpecIso (.of K)) x
  have h₂ : g.Smooth := RingHom.Smooth.of_bijective hgb
  set φ : K →+* Γ(W, V) := (s.appLE ⊤ V e).hom.comp g with hφdef
  have hφ : φ.Smooth := RingHom.Smooth.comp h₂ h₁
  obtain ⟨x, hx⟩ : ∃ x : V, (x : W) = w := ⟨⟨w, hw⟩, rfl⟩
  subst hx
  let p : Ideal Γ(W, V) := (hV.primeIdealOf x).asIdeal
  have hloc : IsLocalization.AtPrime (W.presheaf.stalk (x : W)) p := hV.isLocalization_stalk x
  have iso : W.presheaf.stalk (x : W) ≃+* Localization.AtPrime p :=
    (IsLocalization.algEquiv p.primeCompl (W.presheaf.stalk (x : W))
      (Localization.AtPrime p)).toRingEquiv
  exact ⟨Γ(W, V), inferInstance, φ.toAlgebra, hφ, p, inferInstance, ⟨iso⟩⟩

theorem wcpa_ssd_geom_point : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [Algebra K A] (m : Ideal A) [m.IsMaximal], ∃ (M : Ideal (TensorProduct K (AlgebraicClosure K) A)) (_ : M.IsMaximal) (φ : Localization.AtPrime m →+* Localization.AtPrime M), Function.Injective φ :=
by
  intro K _ A _ _ m hm
  classical
  let f : A →+* TensorProduct K (AlgebraicClosure K) A :=
    (Algebra.TensorProduct.includeRight : A →ₐ[K] TensorProduct K (AlgebraicClosure K) A).toRingHom
  have hf : ∀ a, f a = TensorProduct.tmul K (1 : AlgebraicClosure K) a := fun a => rfl
  let ψ : TensorProduct K (AlgebraicClosure K) A →ₐ[K] TensorProduct K (AlgebraicClosure K) (A ⧸ m) :=
    Algebra.TensorProduct.map (AlgHom.id K (AlgebraicClosure K)) (Ideal.Quotient.mkₐ K m)
  letI : Field (A ⧸ m) := Ideal.Quotient.field m
  haveI : Nontrivial (TensorProduct K (AlgebraicClosure K) (A ⧸ m)) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain K (AlgebraicClosure K) (A ⧸ m)
      (algebraMap K (AlgebraicClosure K)).injective (algebraMap K (A ⧸ m)).injective
  have hker : RingHom.ker ψ.toRingHom ≠ ⊤ := RingHom.ker_ne_top _
  obtain ⟨M, hM, hkM⟩ := Ideal.exists_le_maximal _ hker
  have hle : m ≤ Ideal.comap f M := by
    intro a ha
    rw [Ideal.mem_comap]
    apply hkM
    rw [RingHom.mem_ker]
    show ψ (TensorProduct.tmul K (1 : AlgebraicClosure K) a) = 0
    have h0 : Ideal.Quotient.mkₐ K m a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
    simp only [ψ, Algebra.TensorProduct.map_tmul, h0, TensorProduct.tmul_zero]
  have hIJ : m = Ideal.comap f M := hm.eq_of_le (Ideal.comap_ne_top _ hM.ne_top) hle
  refine ⟨M, hM, Localization.localRingHom m M f hIJ, ?_⟩
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective m.primeCompl z
  rw [Localization.localRingHom_mk', IsLocalization.mk'_eq_zero_iff] at hz
  obtain ⟨⟨u, hu⟩, hux⟩ := hz
  rw [IsLocalization.mk'_eq_zero_iff]
  by_contra hne
  push_neg at hne
  have hann : ∀ a : A, x * a = 0 → a ∈ m := by
    intro a ha
    by_contra hna
    exact hne ⟨a, hna⟩ (by rw [mul_comm]; exact ha)
  haveI : Module.Free K (AlgebraicClosure K) := Module.Free.of_divisionRing K (AlgebraicClosure K)
  haveI : Module.Flat K (AlgebraicClosure K) := Module.Flat.of_free
  let μ : A →ₗ[K] A := LinearMap.mulLeft K x
  have hex := Module.Flat.lTensor_exact (AlgebraicClosure K) (LinearMap.exact_subtype_ker_map μ)
  have hID : ∀ t : TensorProduct K (AlgebraicClosure K) A,
      μ.lTensor (AlgebraicClosure K) t = t * TensorProduct.tmul K (1 : AlgebraicClosure K) x := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul l a =>
      rw [LinearMap.lTensor_tmul, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      simp [μ, mul_comm]
    | add p q hp hq => rw [map_add, hp, hq, add_mul]
  have hu0 : μ.lTensor (AlgebraicClosure K) u = 0 := by rw [hID]; exact hux
  obtain ⟨w, rfl⟩ := (hex u).mp hu0
  apply hu
  clear hu hux hu0
  induction w using TensorProduct.induction_on with
  | zero => simp
  | tmul l a =>
    obtain ⟨a, ha⟩ := a
    have ha' : x * a = 0 := by simpa [μ] using ha
    have hmem : TensorProduct.tmul K (1 : AlgebraicClosure K) a ∈ M := by
      have h1 := hann a ha'
      rw [hIJ, Ideal.mem_comap, hf] at h1
      exact h1
    rw [LinearMap.lTensor_tmul, Submodule.subtype_apply]
    have e : TensorProduct.tmul K l a =
        TensorProduct.tmul K l (1 : A) * TensorProduct.tmul K (1 : AlgebraicClosure K) a := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [e]
    exact M.mul_mem_left _ hmem
  | add p q hp hq => rw [map_add]; exact M.add_mem hp hq

theorem wcpa_ssd_residue_rational : ∀ (k : Type u) [Field k] [IsAlgClosed k] (B : Type u) [CommRing B] [Algebra k B] [Algebra.FiniteType k B] (M : Ideal B) [M.IsMaximal] (y : Localization.AtPrime M), ∃ c : k, y - algebraMap k (Localization.AtPrime M) c ∈ IsLocalRing.maximalIdeal (Localization.AtPrime M) :=
by
  intro k _ _ B _ _ _ M _ y
  letI : Field (B ⧸ M) := Ideal.Quotient.field M
  haveI : Algebra.FiniteType k (B ⧸ M) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k M) (Ideal.Quotient.mkₐ_surjective k M)
  haveI : Module.Finite k (B ⧸ M) := finite_of_finite_type_of_isJacobsonRing k (B ⧸ M)
  haveI : Algebra.IsIntegral k (B ⧸ M) := Algebra.IsIntegral.of_finite k (B ⧸ M)
  have hsurj : Function.Surjective (algebraMap k (B ⧸ M)) :=
    (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := B ⧸ M)).2
  have htow : ∀ c : k, algebraMap k (B ⧸ M) c = Ideal.Quotient.mk M (algebraMap k B c) :=
    fun c => by rw [IsScalarTower.algebraMap_apply k B (B ⧸ M), Ideal.Quotient.algebraMap_eq]
  obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective M.primeCompl y
  obtain ⟨c₁, hc₁⟩ := hsurj (Ideal.Quotient.mk M b)
  obtain ⟨c₂, hc₂⟩ := hsurj (Ideal.Quotient.mk M (s : B))
  have hc₂0 : c₂ ≠ 0 := by
    rintro rfl
    rw [map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem] at hc₂
    exact s.2 hc₂
  refine ⟨c₁ / c₂, ?_⟩
  have hmem : b - algebraMap k B (c₁ / c₂) * (s : B) ∈ M := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, ← htow, ← hc₁, ← hc₂, ← map_mul,
      ← map_sub, div_mul_cancel₀ c₁ hc₂0, sub_self, map_zero]
  have hfrac : IsLocalization.mk' (Localization.AtPrime M) b s
      - algebraMap k (Localization.AtPrime M) (c₁ / c₂)
      = IsLocalization.mk' (Localization.AtPrime M) (b - algebraMap k B (c₁ / c₂) * (s : B)) s := by
    rw [eq_comm, IsLocalization.mk'_eq_iff_eq_mul, sub_mul, IsLocalization.mk'_spec, map_sub,
      map_mul, IsScalarTower.algebraMap_apply k B (Localization.AtPrime M)]
  rw [hfrac]
  exact (IsLocalization.AtPrime.mk'_mem_maximal_iff (Localization.AtPrime M) M _ _).mpr hmem

theorem wcpa_ssd_cotangent_basis : ∀ (k : Type u) [Field k] (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [Algebra k R], (∀ y : R, ∃ c : k, y - algebraMap k R c ∈ IsLocalRing.maximalIdeal R) → ∃ (r : ℕ) (x : Fin r → R), (∀ i, x i ∈ IsLocalRing.maximalIdeal R) ∧ (∀ y ∈ IsLocalRing.maximalIdeal R, ∃ c : Fin r → k, y - ∑ i, c i • x i ∈ IsLocalRing.maximalIdeal R ^ 2) ∧ (∀ c : Fin r → k, ∑ i, c i • x i ∈ IsLocalRing.maximalIdeal R ^ 2 → ∀ i, c i = 0) :=
by
  intro k _ R _ _ _ _ hres
  classical
  have hqk : ∀ (c : k) (z : IsLocalRing.maximalIdeal R),
      (IsLocalRing.maximalIdeal R).toCotangent (c • z) =
        c • (IsLocalRing.maximalIdeal R).toCotangent z :=
    fun c z => LinearMap.map_smul_of_tower _ c z
  have hq0 : ∀ z : IsLocalRing.maximalIdeal R,
      (IsLocalRing.maximalIdeal R).toCotangent z = 0 ↔ (z : R) ∈ IsLocalRing.maximalIdeal R ^ 2 :=
    fun z => (IsLocalRing.maximalIdeal R).toCotangent_eq_zero z
  have hqs : Function.Surjective (IsLocalRing.maximalIdeal R).toCotangent :=
    (IsLocalRing.maximalIdeal R).toCotangent_surjective
  have hfin : Module.Finite k (IsLocalRing.maximalIdeal R).Cotangent := by
    obtain ⟨s, g, hg⟩ :=
      (Submodule.fg_iff_exists_fin_generating_family).mp
        (IsNoetherian.noetherian (IsLocalRing.maximalIdeal R))
    have hgm : ∀ j, g j ∈ IsLocalRing.maximalIdeal R := fun j =>
      hg ▸ Submodule.subset_span (Set.mem_range_self j)
    let v : Fin s → (IsLocalRing.maximalIdeal R).Cotangent := fun j =>
      (IsLocalRing.maximalIdeal R).toCotangent ⟨g j, hgm j⟩
    have htop : Submodule.span k (Set.range v) = ⊤ := by
      rw [eq_top_iff]
      rintro w -
      obtain ⟨z, rfl⟩ := hqs w
      have hz : (z : R) ∈ Submodule.span R (Set.range g) := by rw [hg]; exact z.2
      obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hz
      choose c hc using fun j => hres (a j)
      have key : (IsLocalRing.maximalIdeal R).toCotangent z = ∑ j, c j • v j := by
        have e1 : (IsLocalRing.maximalIdeal R).toCotangent z - ∑ j, c j • v j =
            (IsLocalRing.maximalIdeal R).toCotangent
              (z - ∑ j, c j • (⟨g j, hgm j⟩ : IsLocalRing.maximalIdeal R)) := by
          rw [map_sub, map_sum]
          simp only [hqk, v]
        rw [← sub_eq_zero, e1, hq0]
        have e2 : ((z - ∑ j, c j • (⟨g j, hgm j⟩ : IsLocalRing.maximalIdeal R) :
            IsLocalRing.maximalIdeal R) : R) = ∑ j, (a j - algebraMap k R (c j)) * g j := by
          rw [Submodule.coe_sub, Submodule.coe_sum, ← ha]
          simp only [Submodule.coe_smul_of_tower, Algebra.smul_def, Algebra.algebraMap_self,
            RingHom.id_apply, sub_mul, Finset.sum_sub_distrib]
        rw [e2, pow_two]
        exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_mul (hc j) (hgm j)
      rw [key]
      exact Submodule.sum_mem _ fun j _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self j))
    exact Module.finite_def.mpr (htop ▸ Submodule.fg_span (Set.finite_range v))
  choose xt hxt using fun i => hqs (Module.finBasis k (IsLocalRing.maximalIdeal R).Cotangent i)
  refine ⟨Module.finrank k (IsLocalRing.maximalIdeal R).Cotangent, fun i => (xt i : R),
    fun i => (xt i).2, ?_, ?_⟩
  · intro y hy
    refine ⟨fun i => (Module.finBasis k (IsLocalRing.maximalIdeal R).Cotangent).repr
      ((IsLocalRing.maximalIdeal R).toCotangent ⟨y, hy⟩) i, ?_⟩
    have h1 : (y - ∑ i, (Module.finBasis k (IsLocalRing.maximalIdeal R).Cotangent).repr
        ((IsLocalRing.maximalIdeal R).toCotangent ⟨y, hy⟩) i • (xt i : R)) =
        ((⟨y, hy⟩ - ∑ i, (Module.finBasis k (IsLocalRing.maximalIdeal R).Cotangent).repr
          ((IsLocalRing.maximalIdeal R).toCotangent ⟨y, hy⟩) i • xt i :
            IsLocalRing.maximalIdeal R) : R) := by
      rw [Submodule.coe_sub, Submodule.coe_sum]
      simp only [Submodule.coe_smul_of_tower]
    rw [h1, ← hq0, map_sub, map_sum]
    simp only [hqk, hxt]
    rw [Module.Basis.sum_repr, sub_self]
  · intro c hc
    have h1 : (∑ i, c i • (xt i : R)) = ((∑ i, c i • xt i : IsLocalRing.maximalIdeal R) : R) := by
      rw [Submodule.coe_sum]
      simp only [Submodule.coe_smul_of_tower]
    rw [h1, ← hq0, map_sum] at hc
    simp only [hqk, hxt] at hc
    exact Fintype.linearIndependent_iff.mp
      (Module.finBasis k (IsLocalRing.maximalIdeal R).Cotangent).linearIndependent c hc

theorem wcpa_ssd_poly_approx : ∀ (k : Type u) [Field k] (R : Type u) [CommRing R] [IsLocalRing R] [Algebra k R] (r : ℕ) (x : Fin r → R), (∀ y : R, ∃ c : k, y - algebraMap k R c ∈ IsLocalRing.maximalIdeal R) → (∀ i, x i ∈ IsLocalRing.maximalIdeal R) → (∀ y ∈ IsLocalRing.maximalIdeal R, ∃ c : Fin r → k, y - ∑ i, c i • x i ∈ IsLocalRing.maximalIdeal R ^ 2) → ∀ (N a : ℕ) (y : R), y ∈ IsLocalRing.maximalIdeal R ^ a → ∃ F ∈ MvPolynomial.idealOfVars (Fin r) k ^ a, y - MvPolynomial.aeval x F ∈ IsLocalRing.maximalIdeal R ^ N :=
by
  intro k _ R _ _ _ r x hRES hx hspan
  classical
  set m := IsLocalRing.maximalIdeal R with hm
  set I := MvPolynomial.idealOfVars (Fin r) k with hI

  have hmapI : Ideal.map (MvPolynomial.aeval x) I ≤ m := by
    rw [hI]
    show Ideal.map (MvPolynomial.aeval x) (Ideal.span (Set.range MvPolynomial.X)) ≤ m
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    simpa using hx i
  have hev : ∀ (a : ℕ) (F : MvPolynomial (Fin r) k), F ∈ I ^ a →
      MvPolynomial.aeval x F ∈ m ^ a := by
    intro a F hF
    have h1 : MvPolynomial.aeval x F ∈ Ideal.map (MvPolynomial.aeval x) (I ^ a) :=
      Ideal.mem_map_of_mem _ hF
    rw [Ideal.map_pow] at h1
    exact Ideal.pow_right_mono hmapI a h1
  have hXI : ∀ i, (MvPolynomial.X i : MvPolynomial (Fin r) k) ∈ I :=
    fun i => Ideal.subset_span ⟨i, rfl⟩

  have step : ∀ (a : ℕ) (y : R), y ∈ m ^ a →
      ∃ F ∈ I ^ a, y - MvPolynomial.aeval x F ∈ m ^ (a + 1) := by
    intro a
    induction a with
    | zero =>
      intro y _
      obtain ⟨c, hc⟩ := hRES y
      refine ⟨MvPolynomial.C c, ?_, ?_⟩
      · rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      · rw [MvPolynomial.aeval_C, zero_add, pow_one]; exact hc
    | succ a ih =>
      intro y hy
      rw [pow_succ] at hy
      apply Submodule.mul_induction_on
        (C := fun z => ∃ F ∈ I ^ (a + 1), z - MvPolynomial.aeval x F ∈ m ^ (a + 1 + 1)) hy
      · intro u hu v hv
        obtain ⟨Fu, hFu, hu'⟩ := ih u hu
        obtain ⟨c, hc⟩ := hspan v hv
        set L : MvPolynomial (Fin r) k := ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i with hL
        have hLI : L ∈ I := Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hXI i))
        have hevL : MvPolynomial.aeval x L = ∑ i, c i • x i := by
          rw [hL, map_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X, Algebra.smul_def]
        refine ⟨Fu * L, ?_, ?_⟩
        · rw [pow_succ]; exact Ideal.mul_mem_mul hFu hLI
        · have hid : u * v - MvPolynomial.aeval x (Fu * L) =
              (u - MvPolynomial.aeval x Fu) * v +
                MvPolynomial.aeval x Fu * (v - ∑ i, c i • x i) := by
            rw [map_mul, hevL]; ring
          rw [hid]
          refine Ideal.add_mem _ ?_ ?_
          · rw [pow_succ m (a + 1)]
            exact Ideal.mul_mem_mul hu' hv
          · rw [show a + 1 + 1 = a + 2 from rfl, pow_add]
            exact Ideal.mul_mem_mul (hev a Fu hFu) hc
      · intro y₁ y₂ h₁ h₂
        obtain ⟨F₁, hF₁, e₁⟩ := h₁
        obtain ⟨F₂, hF₂, e₂⟩ := h₂
        refine ⟨F₁ + F₂, Ideal.add_mem _ hF₁ hF₂, ?_⟩
        have : y₁ + y₂ - MvPolynomial.aeval x (F₁ + F₂) =
            (y₁ - MvPolynomial.aeval x F₁) + (y₂ - MvPolynomial.aeval x F₂) := by
          rw [map_add]; ring
        rw [this]; exact Ideal.add_mem _ e₁ e₂

  have claim : ∀ (N d a : ℕ) (y : R), N ≤ a + d → y ∈ m ^ a →
      ∃ F ∈ I ^ a, y - MvPolynomial.aeval x F ∈ m ^ N := by
    intro N d
    induction d with
    | zero =>
      intro a y hN hy
      refine ⟨0, zero_mem _, ?_⟩
      rw [map_zero, sub_zero]
      exact Ideal.pow_le_pow_right (by omega) hy
    | succ d ih =>
      intro a y hN hy
      obtain ⟨F₁, hF₁, e₁⟩ := step a y hy
      obtain ⟨F₂, hF₂, e₂⟩ := ih (a + 1) _ (by omega) e₁
      refine ⟨F₁ + F₂, Ideal.add_mem _ hF₁ (Ideal.pow_le_pow_right (Nat.le_succ a) hF₂), ?_⟩
      have : y - MvPolynomial.aeval x (F₁ + F₂) =
          y - MvPolynomial.aeval x F₁ - MvPolynomial.aeval x F₂ := by
        rw [map_add]; ring
      rw [this]; exact e₂
  intro N a y hy
  exact claim N N a y (by omega) hy

theorem wcpa_ssd_jet_two : ∀ (k : Type u) [Field k] (R : Type u) [CommRing R] [IsLocalRing R] [Algebra k R] (r : ℕ) (x : Fin r → R), (∀ y : R, ∃ c : k, y - algebraMap k R c ∈ IsLocalRing.maximalIdeal R) → (∀ i, x i ∈ IsLocalRing.maximalIdeal R) → (∀ y ∈ IsLocalRing.maximalIdeal R, ∃ c : Fin r → k, y - ∑ i, c i • x i ∈ IsLocalRing.maximalIdeal R ^ 2) → (∀ c : Fin r → k, ∑ i, c i • x i ∈ IsLocalRing.maximalIdeal R ^ 2 → ∀ i, c i = 0) → ∃ γ : R →ₐ[k] MvPolynomial (Fin r) k ⧸ MvPolynomial.idealOfVars (Fin r) k ^ 2, (∀ i, γ (x i) = Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ 2) (MvPolynomial.X i)) ∧ ∀ y ∈ IsLocalRing.maximalIdeal R, γ y ∈ Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ 2)) (MvPolynomial.idealOfVars (Fin r) k) :=
by
  intro k _ R _ _ _ r x hRES hx hspan hindep
  classical
  set 𝔪 := IsLocalRing.maximalIdeal R with h𝔪
  set I := MvPolynomial.idealOfVars (Fin r) k with hI

  have hmapI : Ideal.map (MvPolynomial.aeval x : MvPolynomial (Fin r) k →ₐ[k] R) I ≤ 𝔪 := by
    rw [hI, MvPolynomial.idealOfVars.eq_1, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    simpa using hx i
  have hpow : ∀ (n : ℕ) (F : MvPolynomial (Fin r) k), F ∈ I ^ n →
      MvPolynomial.aeval x F ∈ 𝔪 ^ n := by
    intro n F hF
    have h1 : MvPolynomial.aeval x F ∈
        Ideal.map (MvPolynomial.aeval x : MvPolynomial (Fin r) k →ₐ[k] R) (I ^ n) :=
      Ideal.mem_map_of_mem _ hF
    rw [Ideal.map_pow] at h1
    exact Ideal.pow_right_mono hmapI n h1

  have hI1 : ∀ F : MvPolynomial (Fin r) k, F.coeff 0 = 0 → F ∈ I := by
    intro F hF
    have h := (MvPolynomial.mem_pow_idealOfVars_iff 1 F).mpr ?_
    · simpa using h
    intro m hm
    by_contra hlt
    have h0 : m.degree = 0 := by omega
    rw [Finsupp.degree_eq_zero_iff] at h0
    subst h0
    exact (MvPolynomial.mem_support_iff.mp hm) hF
  have hI1' : ∀ F ∈ I, F.coeff 0 = 0 := by
    intro F hF
    have h := (MvPolynomial.mem_pow_idealOfVars_iff 1 F).mp (by simpa using hF)
    by_contra hc
    have := h 0 (MvPolynomial.mem_support_iff.mpr hc)
    simp at this
  have hvar : ∀ F : MvPolynomial (Fin r) k, MvPolynomial.aeval x F ∈ 𝔪 → F ∈ I := by
    intro F hF
    apply hI1
    by_contra hc
    have hG : F - MvPolynomial.C (F.coeff 0) ∈ I := hI1 _ (by simp)
    have h1 : MvPolynomial.aeval x (F - MvPolynomial.C (F.coeff 0)) ∈ 𝔪 := by
      have h := hpow 1 _ (by rw [pow_one]; exact hG)
      rwa [pow_one] at h
    have h2 : algebraMap k R (F.coeff 0) ∈ 𝔪 := by
      have e : algebraMap k R (F.coeff 0) = MvPolynomial.aeval x F -
          MvPolynomial.aeval x (F - MvPolynomial.C (F.coeff 0)) := by
        rw [map_sub, MvPolynomial.aeval_C, sub_sub_cancel]
      rw [e]
      exact Ideal.sub_mem _ hF h1
    have hu : IsUnit (algebraMap k R (F.coeff 0)) := (IsUnit.mk0 _ hc).map _
    exact (IsLocalRing.mem_maximalIdeal _).mp h2 hu

  have hdeg1 : ∀ m : Fin r →₀ ℕ, m.degree = 1 → ∃ j, m = Finsupp.single j 1 := by
    intro m hm
    rw [Finsupp.degree_eq_sum] at hm
    obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero (by rw [hm]; exact one_ne_zero)
    refine ⟨j, ?_⟩
    ext i
    by_cases hij : i = j
    · subst hij
      have hle : m i ≤ 1 :=
        hm ▸ Finset.single_le_sum (f := fun i => m i) (fun _ _ => Nat.zero_le _)
          (Finset.mem_univ i)
      simp only [Finsupp.single_eq_same]
      omega
    · rw [Finsupp.single_apply, if_neg (Ne.symm hij)]
      have := Finset.add_le_sum (f := fun i => m i) (fun _ _ => Nat.zero_le _)
        (Finset.mem_univ i) (Finset.mem_univ j) hij
      omega

  have hsplit : ∀ F : MvPolynomial (Fin r) k, F - MvPolynomial.C (F.coeff 0) -
      ∑ i, MvPolynomial.C (F.coeff (Finsupp.single i 1)) * MvPolynomial.X i ∈ I ^ 2 := by
    intro F
    rw [MvPolynomial.mem_pow_idealOfVars_iff]
    intro m hm
    rw [MvPolynomial.mem_support_iff] at hm
    by_contra hlt
    apply hm
    rcases (by omega : m.degree = 0 ∨ m.degree = 1) with h0 | h1
    · rw [Finsupp.degree_eq_zero_iff] at h0
      subst h0
      simp [MvPolynomial.coeff_X']
    · obtain ⟨j, rfl⟩ := hdeg1 m h1
      simp only [MvPolynomial.coeff_sub, MvPolynomial.coeff_sum, MvPolynomial.coeff_C_mul,
        MvPolynomial.coeff_X', MvPolynomial.coeff_C]
      have e1 : ¬ ((0 : Fin r →₀ ℕ) = Finsupp.single j 1) := fun h =>
        (Finsupp.single_ne_zero.mpr (one_ne_zero (α := ℕ))) h.symm
      have e2 : ∀ i, (Finsupp.single i 1 = Finsupp.single j 1) ↔ i = j := fun i =>
        Finsupp.single_left_inj one_ne_zero
      simp only [e1, e2, if_false, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq',
        Finset.mem_univ, if_true]
      ring

  have hker2 : ∀ F : MvPolynomial (Fin r) k, MvPolynomial.aeval x F ∈ 𝔪 ^ 2 → F ∈ I ^ 2 := by
    intro F hF
    have hF1 : MvPolynomial.aeval x F ∈ 𝔪 := Ideal.pow_le_self two_ne_zero hF
    have h0 : F.coeff 0 = 0 := hI1' F (hvar F hF1)
    have hF2 := hsplit F
    have hsum : ∑ i, F.coeff (Finsupp.single i 1) • x i ∈ 𝔪 ^ 2 := by
      have e : ∑ i, F.coeff (Finsupp.single i 1) • x i = MvPolynomial.aeval x F -
          MvPolynomial.aeval x (F - MvPolynomial.C (F.coeff 0) -
            ∑ i, MvPolynomial.C (F.coeff (Finsupp.single i 1)) * MvPolynomial.X i) := by
        simp only [h0, map_sub, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X,
          Algebra.smul_def, map_zero]
        ring
      rw [e]
      exact Ideal.sub_mem _ hF (hpow 2 _ hF2)
    have hc := hindep _ hsum
    have e : F = F - MvPolynomial.C (F.coeff 0) -
        ∑ i, MvPolynomial.C (F.coeff (Finsupp.single i 1)) * MvPolynomial.X i := by
      simp only [h0, hc, map_zero, zero_mul, Finset.sum_const_zero, sub_zero]
    rw [e]
    exact hF2

  let ψ : MvPolynomial (Fin r) k →ₐ[k] R ⧸ 𝔪 ^ 2 :=
    (Ideal.Quotient.mkₐ k (𝔪 ^ 2)).comp (MvPolynomial.aeval x)
  have hψ : ∀ F, ψ F = Ideal.Quotient.mk (𝔪 ^ 2) (MvPolynomial.aeval x F) := fun F => rfl
  have hsurj : Function.Surjective ψ := by
    intro z
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
    obtain ⟨c₀, hc₀⟩ := hRES y
    obtain ⟨c, hc⟩ := hspan _ hc₀
    refine ⟨MvPolynomial.C c₀ + ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_⟩
    rw [hψ, Ideal.Quotient.eq]
    have e : MvPolynomial.aeval x (MvPolynomial.C c₀ + ∑ i, MvPolynomial.C (c i) *
        MvPolynomial.X i) - y = -(y - algebraMap k R c₀ - ∑ i, c i • x i) := by
      simp only [map_add, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X,
        Algebra.smul_def]
      ring
    rw [e]
    exact (Ideal.neg_mem_iff _).mpr hc
  have hker : RingHom.ker ψ = I ^ 2 := by
    ext F
    rw [RingHom.mem_ker, hψ, Ideal.Quotient.eq_zero_iff_mem]
    exact ⟨hker2 F, hpow 2 F⟩
  let Φ : (MvPolynomial (Fin r) k ⧸ I ^ 2) ≃ₐ[k] R ⧸ 𝔪 ^ 2 :=
    (Ideal.quotientEquivAlgOfEq k hker.symm).trans (Ideal.quotientKerAlgEquivOfSurjective hsurj)
  have hΦ : ∀ F, Φ (Ideal.Quotient.mk (I ^ 2) F) =
      Ideal.Quotient.mk (𝔪 ^ 2) (MvPolynomial.aeval x F) := fun F => rfl
  refine ⟨Φ.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k (𝔪 ^ 2)), ?_, ?_⟩
  · intro i
    show Φ.symm (Ideal.Quotient.mk (𝔪 ^ 2) (x i)) = _
    rw [AlgEquiv.symm_apply_eq, hΦ, MvPolynomial.aeval_X]
  · intro y hy
    show Φ.symm (Ideal.Quotient.mk (𝔪 ^ 2) y) ∈ _
    obtain ⟨F, hF⟩ := Ideal.Quotient.mk_surjective (Φ.symm (Ideal.Quotient.mk (𝔪 ^ 2) y))
    rw [← hF]
    have h1 := congrArg Φ hF
    rw [hΦ, AlgEquiv.apply_symm_apply, Ideal.Quotient.eq] at h1
    have h2 : MvPolynomial.aeval x F ∈ 𝔪 := by
      have := Ideal.add_mem _ (Ideal.pow_le_self two_ne_zero h1) hy
      simpa using this
    exact Ideal.mem_map_of_mem _ (hvar F h2)

theorem wcpa_ssd_jet_lift : ∀ (k : Type u) [Field k] (R : Type u) [CommRing R] [IsLocalRing R] [Algebra k R] [Algebra.FormallySmooth k R] (r : ℕ) (x : Fin r → R) (γ : R →ₐ[k] MvPolynomial (Fin r) k ⧸ MvPolynomial.idealOfVars (Fin r) k ^ 2), (∀ i, γ (x i) = Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ 2) (MvPolynomial.X i)) → (∀ y ∈ IsLocalRing.maximalIdeal R, γ y ∈ Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ 2)) (MvPolynomial.idealOfVars (Fin r) k)) → ∀ N : ℕ, 2 ≤ N → ∃ β : R →ₐ[k] MvPolynomial (Fin r) k ⧸ MvPolynomial.idealOfVars (Fin r) k ^ N, (∀ i, β (x i) - Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ N) (MvPolynomial.X i) ∈ Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ N)) (MvPolynomial.idealOfVars (Fin r) k ^ 2)) ∧ ∀ y ∈ IsLocalRing.maximalIdeal R, β y ∈ Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ N)) (MvPolynomial.idealOfVars (Fin r) k) :=
by
  intro k _ R _ _ _ _ r x
  generalize MvPolynomial.idealOfVars (Fin r) k = I
  intro γ hγ1 hγ2

  have L1 : ∀ (N : ℕ) (h : I ^ (N + 1) ≤ I ^ N), 1 ≤ N →
      IsNilpotent (RingHom.ker (Ideal.Quotient.factorₐ k h)) := by
    intro N h hN
    have hker : RingHom.ker (Ideal.Quotient.factorₐ k h) =
        Ideal.map (Ideal.Quotient.mk (I ^ (N + 1))) (I ^ N) := by
      rw [← Ideal.Quotient.factor_ker h]
      ext u
      simp only [RingHom.mem_ker, Ideal.Quotient.factorₐ_apply]
    rw [hker]
    refine ⟨2, ?_⟩
    rw [← Ideal.map_pow, ← pow_mul, Ideal.zero_eq_bot, eq_bot_iff]
    calc Ideal.map (Ideal.Quotient.mk (I ^ (N + 1))) (I ^ (N * 2))
        ≤ Ideal.map (Ideal.Quotient.mk (I ^ (N + 1))) (I ^ (N + 1)) :=
          Ideal.map_mono (Ideal.pow_le_pow_right (by omega))
      _ = ⊥ := Ideal.map_quotient_self _

  have L2 : ∀ (J : Ideal (MvPolynomial (Fin r) k)) (N : ℕ) (h : I ^ (N + 1) ≤ I ^ N), I ^ N ≤ J →
      ∀ u : MvPolynomial (Fin r) k ⧸ I ^ (N + 1),
        Ideal.Quotient.factor h u ∈ Ideal.map (Ideal.Quotient.mk (I ^ N)) J →
        u ∈ Ideal.map (Ideal.Quotient.mk (I ^ (N + 1))) J := by
    intro J N h hJ u hu
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective u
    rw [Ideal.Quotient.factor_mk] at hu
    obtain ⟨q, hq, hqp⟩ := (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hu
    have hd : q - p ∈ I ^ N := Ideal.Quotient.eq.mp hqp
    have hp : p ∈ J := by
      have := J.sub_mem hq (hJ hd)
      simpa using this
    exact Ideal.mem_map_of_mem _ hp
  intro N hN
  induction N, hN using Nat.le_induction with
  | base =>
    refine ⟨γ, fun i => ?_, hγ2⟩
    rw [hγ1 i, sub_self]
    exact Ideal.zero_mem _
  | succ N hN ih =>
    obtain ⟨β, hP1, hP2⟩ := ih
    have h : I ^ (N + 1) ≤ I ^ N := Ideal.pow_le_pow_right (Nat.le_succ N)
    have hsurj : Function.Surjective (Ideal.Quotient.factorₐ k h) := by
      intro v
      obtain ⟨u, hu⟩ := Ideal.Quotient.factor_surjective h v
      exact ⟨u, by rw [Ideal.Quotient.factorₐ_apply]; exact hu⟩
    let β' := Algebra.FormallySmooth.liftOfSurjective β (Ideal.Quotient.factorₐ k h) hsurj
      (L1 N h (by omega))
    have hK : ∀ y, Ideal.Quotient.factor h (β' y) = β y := by
      intro y
      have := Algebra.FormallySmooth.liftOfSurjective_apply β (Ideal.Quotient.factorₐ k h) hsurj
        (L1 N h (by omega)) y
      rw [Ideal.Quotient.factorₐ_apply] at this
      exact this
    refine ⟨β', fun i => ?_, fun y hy => ?_⟩
    · apply L2 (I ^ 2) N h (Ideal.pow_le_pow_right hN)
      rw [map_sub, hK, Ideal.Quotient.factor_mk]
      exact hP1 i
    · apply L2 I N h (Ideal.pow_le_self (by omega))
      rw [hK]
      exact hP2 y hy

theorem wcpa_ssd_poly_order_mul : ∀ (k : Type u) [Field k] (r : ℕ) (F G : MvPolynomial (Fin r) k) (i j : ℕ), F ∈ MvPolynomial.idealOfVars (Fin r) k ^ i → F ∉ MvPolynomial.idealOfVars (Fin r) k ^ (i + 1) → G ∈ MvPolynomial.idealOfVars (Fin r) k ^ j → G ∉ MvPolynomial.idealOfVars (Fin r) k ^ (j + 1) → F * G ∉ MvPolynomial.idealOfVars (Fin r) k ^ (i + j + 1) :=
by
  classical
  intro k _ r F G i j hFi hFi1 hGj hGj1
  have key : ∀ (P : MvPolynomial (Fin r) k) (n : ℕ), P ∈ MvPolynomial.idealOfVars (Fin r) k ^ n →
      P ∉ MvPolynomial.idealOfVars (Fin r) k ^ (n + 1) →
      MvPolynomial.homogeneousComponent n P ≠ 0 ∧
        P - MvPolynomial.homogeneousComponent n P ∈ MvPolynomial.idealOfVars (Fin r) k ^ (n + 1) := by
    intro P n h1 h2
    rw [MvPolynomial.mem_pow_idealOfVars_iff'] at h1 h2
    push_neg at h2
    obtain ⟨x₀, hx₀, hc⟩ := h2
    have hdeg : Finsupp.degree x₀ = n := by
      by_contra hne
      exact hc (h1 x₀ (by omega))
    refine ⟨?_, ?_⟩
    · intro h0
      apply hc
      have hcc : (MvPolynomial.homogeneousComponent n P).coeff x₀ = P.coeff x₀ := by
        rw [MvPolynomial.coeff_homogeneousComponent, if_pos hdeg]
      rw [h0, MvPolynomial.coeff_zero] at hcc
      exact hcc.symm
    · rw [MvPolynomial.mem_pow_idealOfVars_iff']
      intro x hx
      rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_homogeneousComponent]
      by_cases hd : Finsupp.degree x = n
      · rw [if_pos hd, sub_self]
      · rw [if_neg hd, h1 x (by omega), sub_zero]
  have homog : ∀ (p : MvPolynomial (Fin r) k) (n : ℕ), p.IsHomogeneous n →
      p ∈ MvPolynomial.idealOfVars (Fin r) k ^ n ∧
        (p ∈ MvPolynomial.idealOfVars (Fin r) k ^ (n + 1) → p = 0) := by
    intro p n hp
    refine ⟨?_, ?_⟩
    · rw [MvPolynomial.mem_pow_idealOfVars_iff']
      intro x hx
      exact hp.coeff_eq_zero (by omega)
    · intro h
      rw [MvPolynomial.mem_pow_idealOfVars_iff'] at h
      ext x
      rw [MvPolynomial.coeff_zero]
      by_cases hd : Finsupp.degree x = n
      · exact h x (by omega)
      · exact hp.coeff_eq_zero hd
  obtain ⟨hf0, hF'⟩ := key F i hFi hFi1
  obtain ⟨hg0, hG'⟩ := key G j hGj hGj1
  have hfh : (MvPolynomial.homogeneousComponent i F).IsHomogeneous i :=
    MvPolynomial.homogeneousComponent_isHomogeneous i F
  have hgh : (MvPolynomial.homogeneousComponent j G).IsHomogeneous j :=
    MvPolynomial.homogeneousComponent_isHomogeneous j G
  have hfm := (homog _ i hfh).1
  have hgm := (homog _ j hgh).1
  set m := MvPolynomial.idealOfVars (Fin r) k with hm
  set f := MvPolynomial.homogeneousComponent i F with hf
  set g := MvPolynomial.homogeneousComponent j G with hg
  have e1 : f * (G - g) ∈ m ^ (i + j + 1) := by
    have := Ideal.mul_mem_mul hfm hG'
    rwa [← pow_add, show i + (j + 1) = i + j + 1 by omega] at this
  have e2 : (F - f) * g ∈ m ^ (i + j + 1) := by
    have := Ideal.mul_mem_mul hF' hgm
    rwa [← pow_add, show i + 1 + j = i + j + 1 by omega] at this
  have e3 : (F - f) * (G - g) ∈ m ^ (i + j + 1) := by
    have := Ideal.mul_mem_mul hF' hG'
    rw [← pow_add] at this
    exact Ideal.pow_le_pow_right (by omega) this
  intro hFG
  have hfg : f * g ∈ m ^ (i + j + 1) := by
    have eq : f * g = F * G - f * (G - g) - (F - f) * g - (F - f) * (G - g) := by ring
    rw [eq]
    exact Ideal.sub_mem _ (Ideal.sub_mem _ (Ideal.sub_mem _ hFG e1) e2) e3
  have h0 := (homog (f * g) (i + j) (hfh.mul hgh)).2 hfg
  exact mul_ne_zero hf0 hg0 h0

theorem wcpa_ssd_subst_shift : ∀ (k : Type u) [Field k] (r : ℕ) (E : Fin r → MvPolynomial (Fin r) k), (∀ i, E i ∈ MvPolynomial.idealOfVars (Fin r) k ^ 2) → ∀ (a : ℕ) (H : MvPolynomial (Fin r) k), H ∈ MvPolynomial.idealOfVars (Fin r) k ^ a → MvPolynomial.aeval (fun i => MvPolynomial.X i + E i) H - H ∈ MvPolynomial.idealOfVars (Fin r) k ^ (a + 1) :=
by
  intro k _ r E hE
  set m := MvPolynomial.idealOfVars (Fin r) k with hm
  set φ : MvPolynomial (Fin r) k →ₐ[k] MvPolynomial (Fin r) k :=
    MvPolynomial.aeval (fun i => MvPolynomial.X i + E i) with hφ
  have hF : m ^ 2 ≤ m := Ideal.pow_le_self two_ne_zero
  have hP : ∀ x y, φ (x * y) - x * y = (φ x - x) * φ y + x * (φ y - y) := by
    intro x y; rw [map_mul]; ring
  have hφX : ∀ i, φ (MvPolynomial.X i) = MvPolynomial.X i + E i := by
    intro i; rw [hφ, MvPolynomial.aeval_X]
  have hφC : ∀ c, φ (MvPolynomial.C c) = MvPolynomial.C c := by
    intro c; rw [hφ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
  have s1 : ∀ H, φ H - H ∈ m := by
    intro H
    induction H using MvPolynomial.induction_on with
    | C c => rw [hφC, sub_self]; exact m.zero_mem
    | add p q hp hq =>
      rw [map_add, add_sub_add_comm]; exact m.add_mem hp hq
    | mul_X p n hp =>
      have e : φ (p * MvPolynomial.X n) - p * MvPolynomial.X n
          = (φ p - p) * MvPolynomial.X n + φ p * E n := by
        rw [map_mul, hφX]; ring
      rw [e]
      exact m.add_mem (m.mul_mem_right _ hp) (m.mul_mem_left _ (hF (hE n)))
  have s2 : ∀ y ∈ m, φ y - y ∈ m ^ 2 := by
    intro y hy
    change y ∈ Submodule.span (MvPolynomial (Fin r) k)
        (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) k)) at hy
    induction hy using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      rw [hφX, add_sub_cancel_left]; exact hE i
    | zero => rw [map_zero, sub_zero]; exact (m ^ 2).zero_mem
    | add x y _ _ hx hy => rw [map_add, add_sub_add_comm]; exact (m ^ 2).add_mem hx hy
    | smul a x hx ih =>
      have hxm : x ∈ m := hx
      rw [smul_eq_mul, hP]
      have hφx : φ x ∈ m := by
        have := m.add_mem (hF ih) hxm
        rwa [sub_add_cancel] at this
      refine (m ^ 2).add_mem ?_ ((m ^ 2).mul_mem_left _ ih)
      rw [sq]; exact Ideal.mul_mem_mul (s1 a) hφx
  have s3 : ∀ y ∈ m, φ y ∈ m := by
    intro y hy
    have := m.add_mem (hF (s2 y hy)) hy
    rwa [sub_add_cancel] at this
  intro a
  induction a with
  | zero => intro H _; rw [zero_add, pow_one]; exact s1 H
  | succ a ih =>
    intro H hH
    rw [pow_succ] at hH
    refine Submodule.mul_induction_on (C := fun z => φ z - z ∈ m ^ (a + 1 + 1)) hH ?_ ?_
    · intro x hx y hy
      show φ (x * y) - x * y ∈ m ^ (a + 1 + 1)
      rw [hP]
      refine Ideal.add_mem _ ?_ ?_
      · rw [pow_succ _ (a + 1)]; exact Ideal.mul_mem_mul (ih x hx) (s3 y hy)
      · have e : m ^ (a + 1 + 1) = m ^ a * m ^ 2 := by ring
        rw [e]; exact Ideal.mul_mem_mul hx (s2 y hy)
    · intro x y hx hy
      show φ (x + y) - (x + y) ∈ m ^ (a + 1 + 1)
      rw [map_add, add_sub_add_comm]; exact Ideal.add_mem _ hx hy

theorem wcpa_ssd_domain_of_jets : ∀ (k : Type u) [Field k] (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [Algebra k R] (r : ℕ) (x : Fin r → R), (∀ i, x i ∈ IsLocalRing.maximalIdeal R) → (∀ (N a : ℕ) (y : R), y ∈ IsLocalRing.maximalIdeal R ^ a → ∃ F ∈ MvPolynomial.idealOfVars (Fin r) k ^ a, y - MvPolynomial.aeval x F ∈ IsLocalRing.maximalIdeal R ^ N) → (∀ N : ℕ, 2 ≤ N → ∃ β : R →ₐ[k] MvPolynomial (Fin r) k ⧸ MvPolynomial.idealOfVars (Fin r) k ^ N, (∀ i, β (x i) - Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ N) (MvPolynomial.X i) ∈ Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ N)) (MvPolynomial.idealOfVars (Fin r) k ^ 2)) ∧ ∀ y ∈ IsLocalRing.maximalIdeal R, β y ∈ Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin r) k ^ N)) (MvPolynomial.idealOfVars (Fin r) k)) → (∀ (F G : MvPolynomial (Fin r) k) (i j : ℕ), F ∈ MvPolynomial.idealOfVars (Fin r) k ^ i → F ∉ MvPolynomial.idealOfVars (Fin r) k ^ (i + 1) → G ∈ MvPolynomial.idealOfVars (Fin r) k ^ j → G ∉ MvPolynomial.idealOfVars (Fin r) k ^ (j + 1) → F * G ∉ MvPolynomial.idealOfVars (Fin r) k ^ (i + j + 1)) → (∀ (E : Fin r → MvPolynomial (Fin r) k), (∀ i, E i ∈ MvPolynomial.idealOfVars (Fin r) k ^ 2) → ∀ (a : ℕ) (H : MvPolynomial (Fin r) k), H ∈ MvPolynomial.idealOfVars (Fin r) k ^ a → MvPolynomial.aeval (fun i => MvPolynomial.X i + E i) H - H ∈ MvPolynomial.idealOfVars (Fin r) k ^ (a + 1)) → IsDomain R :=
by
  intro k _ R _ _ _ _ r x hx hApprox hJet hOrd hShift
  classical
  set m := IsLocalRing.maximalIdeal R with hm
  set I := MvPolynomial.idealOfVars (Fin r) k with hI

  have d1 : ∀ (n : ℕ) (F : MvPolynomial (Fin r) k), F ∈ I ^ n →
      MvPolynomial.aeval x F ∈ m ^ n := by
    intro n F hF
    have hIdef : I = Ideal.span (Set.range MvPolynomial.X) := rfl
    have h1 : Ideal.map (MvPolynomial.aeval x) I ≤ m := by
      rw [hIdef, Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      simp only [MvPolynomial.aeval_X]
      exact hx i
    have h2 : Ideal.map (MvPolynomial.aeval x) (I ^ n) ≤ m ^ n := by
      rw [Ideal.map_pow]; exact Ideal.pow_right_mono h1 n
    exact h2 (Ideal.mem_map_of_mem _ hF)

  have d2 : ∀ y : R, y ≠ 0 → ∃ a : ℕ, y ∈ m ^ a ∧ y ∉ m ^ (a + 1) := by
    intro y hy
    by_contra hcon
    push_neg at hcon
    have hall : ∀ a : ℕ, y ∈ m ^ a := by
      intro a
      induction a with
      | zero => simp
      | succ n ih => exact hcon n ih
    have hbot : ⨅ i, m ^ i = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing m (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have hmem : y ∈ ⨅ i, m ^ i := (Submodule.mem_iInf _).mpr hall
    rw [hbot] at hmem
    exact hy (Ideal.mem_bot.mp hmem)
  haveI : NoZeroDivisors R := by
    constructor
    intro y z hyz
    by_contra hcon
    push_neg at hcon
    obtain ⟨hy, hz⟩ := hcon
    obtain ⟨a, hya, hya'⟩ := d2 y hy
    obtain ⟨b, hzb, hzb'⟩ := d2 z hz
    obtain ⟨F, hF, hyF⟩ := hApprox (a + b + 2) a y hya
    obtain ⟨G, hG, hzG⟩ := hApprox (a + b + 2) b z hzb
    have hF' : F ∉ I ^ (a + 1) := by
      intro hF1
      apply hya'
      have h1 := d1 (a + 1) F hF1
      have h2 : m ^ (a + b + 2) ≤ m ^ (a + 1) := Ideal.pow_le_pow_right (by omega)
      rw [← sub_add_cancel y (MvPolynomial.aeval x F)]
      exact add_mem (h2 hyF) h1
    have hG' : G ∉ I ^ (b + 1) := by
      intro hG1
      apply hzb'
      have h1 := d1 (b + 1) G hG1
      have h2 : m ^ (a + b + 2) ≤ m ^ (b + 1) := Ideal.pow_le_pow_right (by omega)
      rw [← sub_add_cancel z (MvPolynomial.aeval x G)]
      exact add_mem (h2 hzG) h1
    obtain ⟨β, hJ1, hJ2⟩ := hJet (a + b + 2) (by omega)

    have hE : ∀ i, ∃ e ∈ I ^ 2, Ideal.Quotient.mk (I ^ (a + b + 2)) e =
        β (x i) - Ideal.Quotient.mk (I ^ (a + b + 2)) (MvPolynomial.X i) := by
      intro i
      exact (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp (hJ1 i)
    choose E hEI hEeq using hE
    have hcomp : β.comp (MvPolynomial.aeval x) =
        (Ideal.Quotient.mkₐ k (I ^ (a + b + 2))).comp
          (MvPolynomial.aeval (fun i => MvPolynomial.X i + E i)) := by
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk, map_add,
        hEeq]
      abel
    have hβ : ∀ H : MvPolynomial (Fin r) k, β (MvPolynomial.aeval x H) = Ideal.Quotient.mk (I ^ (a + b + 2))
        (MvPolynomial.aeval (fun i => MvPolynomial.X i + E i) H) := by
      intro H
      have h := congrArg (fun φ => φ H) hcomp
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h
      exact h

    have hkill : ∀ w ∈ m ^ (a + b + 2), β w = 0 := by
      have h1 : Ideal.map β m ≤ Ideal.map (Ideal.Quotient.mk (I ^ (a + b + 2))) I := by
        rw [Ideal.map_le_iff_le_comap]
        intro w hw
        exact Ideal.mem_comap.mpr (hJ2 w hw)
      have h2 : Ideal.map β (m ^ (a + b + 2)) ≤ ⊥ := by
        rw [Ideal.map_pow]
        calc (Ideal.map β m) ^ (a + b + 2)
            ≤ (Ideal.map (Ideal.Quotient.mk (I ^ (a + b + 2))) I) ^ (a + b + 2) :=
              Ideal.pow_right_mono h1 _
          _ = Ideal.map (Ideal.Quotient.mk (I ^ (a + b + 2))) (I ^ (a + b + 2)) :=
              (Ideal.map_pow _ _ _).symm
          _ = ⊥ := Ideal.map_quotient_self _
      intro w hw
      exact Ideal.mem_bot.mp (h2 (Ideal.mem_map_of_mem _ hw))
    have hyβ : β y = Ideal.Quotient.mk (I ^ (a + b + 2))
        (MvPolynomial.aeval (fun i => MvPolynomial.X i + E i) F) := by
      rw [← sub_add_cancel y (MvPolynomial.aeval x F), map_add, hkill _ hyF, hβ, zero_add]
    have hzβ : β z = Ideal.Quotient.mk (I ^ (a + b + 2))
        (MvPolynomial.aeval (fun i => MvPolynomial.X i + E i) G) := by
      rw [← sub_add_cancel z (MvPolynomial.aeval x G), map_add, hkill _ hzG, hβ, zero_add]
    have hprod : Ideal.Quotient.mk (I ^ (a + b + 2))
        (MvPolynomial.aeval (fun i => MvPolynomial.X i + E i) (F * G)) = 0 := by
      rw [map_mul, map_mul, ← hyβ, ← hzβ, ← map_mul, hyz, map_zero]
    have h1 : MvPolynomial.aeval (fun i => MvPolynomial.X i + E i) (F * G) ∈ I ^ (a + b + 1) :=
      Ideal.pow_le_pow_right (by omega) (Ideal.Quotient.eq_zero_iff_mem.mp hprod)
    have hFG : F * G ∈ I ^ (a + b) := by
      rw [pow_add]; exact Ideal.mul_mem_mul hF hG
    have h2 := hShift E hEI (a + b) (F * G) hFG
    have h3 : F * G ∈ I ^ (a + b + 1) := by
      have h4 := sub_mem h1 h2
      rwa [sub_sub_cancel] at h4
    exact hOrd F G a b hF hF' hG hG' h3
  exact NoZeroDivisors.to_isDomain R

theorem wcpa_smooth_stalk_isDomain : ∀ (K : Type u) [Field K] (W : Scheme.{u}) (s : W ⟶ Spec (.of K))
    (n : ℕ) [SmoothOfRelativeDimension n s] (w : W), IsDomain (W.presheaf.stalk w) :=
by
  intro K _ W s n _ w

  have s2 : ∀ (B : Type u) [CommRing B],
      (∀ (M : Ideal B) [M.IsMaximal], IsDomain (Localization.AtPrime M)) →
      ∀ (P : Ideal B) [P.IsPrime], IsDomain (Localization.AtPrime P) := by
    intro B _ hmax P hP
    obtain ⟨M, hM, hPM⟩ := Ideal.exists_le_maximal P hP.ne_top
    haveI := hmax M
    have hcompl : ∀ v : M.primeCompl, ∀ u : P.primeCompl, (v : B) * u ∈ P.primeCompl := by
      intro v u
      exact P.primeCompl.mul_mem (fun h => v.2 (hPM h)) u.2
    haveI hnz : NoZeroDivisors (Localization.AtPrime P) := by
      constructor
      intro x y hxy
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl x
      obtain ⟨⟨b, t⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl y
      rw [← IsLocalization.mk'_mul, IsLocalization.mk'_eq_zero_iff] at hxy
      obtain ⟨u, hu⟩ := hxy
      have h1 : algebraMap B (Localization.AtPrime M) ((u : B) * a) *
          algebraMap B (Localization.AtPrime M) b = 0 := by
        rw [← map_mul, mul_assoc, hu, map_zero]
      rcases mul_eq_zero.mp h1 with h | h
      · left
        obtain ⟨v, hv⟩ := (IsLocalization.map_eq_zero_iff M.primeCompl _ _).mp h
        rw [IsLocalization.mk'_eq_zero_iff]
        refine ⟨⟨(v : B) * u, hcompl v u⟩, ?_⟩
        simp only
        rw [mul_assoc]
        exact hv
      · right
        obtain ⟨v, hv⟩ := (IsLocalization.map_eq_zero_iff M.primeCompl _ _).mp h
        rw [IsLocalization.mk'_eq_zero_iff]
        exact ⟨⟨(v : B), fun h' => v.2 (hPM h')⟩, hv⟩
    exact NoZeroDivisors.to_isDomain _

  obtain ⟨A, _, _, _, p, _, ⟨e⟩⟩ := wcpa_ssd_affine_model K W s n w
  suffices h : IsDomain (Localization.AtPrime p) from
    MulEquiv.isDomain (Localization.AtPrime p) e.toMulEquiv
  refine s2 A ?_ p
  intro m _

  obtain ⟨M, _, φ, hφ⟩ := wcpa_ssd_geom_point K A m
  suffices h : IsDomain (Localization.AtPrime M) from hφ.isDomain φ

  haveI : Algebra.Smooth (AlgebraicClosure K) (TensorProduct K (AlgebraicClosure K) A) :=
    inferInstance
  haveI : IsNoetherianRing (TensorProduct K (AlgebraicClosure K) A) :=
    Algebra.FiniteType.isNoetherianRing (AlgebraicClosure K) _
  haveI : IsNoetherianRing (Localization.AtPrime M) :=
    IsLocalization.isNoetherianRing M.primeCompl (Localization.AtPrime M) ‹_›
  haveI : Algebra.FormallySmooth (TensorProduct K (AlgebraicClosure K) A)
      (Localization.AtPrime M) := Algebra.FormallySmooth.of_isLocalization M.primeCompl
  haveI : Algebra.FormallySmooth (AlgebraicClosure K) (Localization.AtPrime M) :=
    Algebra.FormallySmooth.comp (AlgebraicClosure K) (TensorProduct K (AlgebraicClosure K) A)
      (Localization.AtPrime M)
  have hRES := wcpa_ssd_residue_rational (AlgebraicClosure K)
    (TensorProduct K (AlgebraicClosure K) A) M
  obtain ⟨r, x, hx, hspan, hindep⟩ :=
    wcpa_ssd_cotangent_basis (AlgebraicClosure K) (Localization.AtPrime M) hRES
  have hApprox := wcpa_ssd_poly_approx (AlgebraicClosure K) (Localization.AtPrime M) r x hRES hx
    hspan
  obtain ⟨γ, hγ1, hγ2⟩ :=
    wcpa_ssd_jet_two (AlgebraicClosure K) (Localization.AtPrime M) r x hRES hx hspan hindep
  have hJet := wcpa_ssd_jet_lift (AlgebraicClosure K) (Localization.AtPrime M) r x γ hγ1 hγ2
  exact wcpa_ssd_domain_of_jets (AlgebraicClosure K) (Localization.AtPrime M) r x hx hApprox hJet
    (wcpa_ssd_poly_order_mul (AlgebraicClosure K) r) (wcpa_ssd_subst_shift (AlgebraicClosure K) r)

theorem wc_smooth_irreducible_dim_ge : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d f] [IrreducibleSpace Y], (d : WithBot ℕ∞) ≤ topologicalKrullDim Y :=
by
  classical
  intro K _ _ Y f d _ _

  have s1 : ∀ (ι : Type) [Finite ι] (M : Ideal (MvPolynomial ι K)) [M.IsMaximal],
      (Nat.card ι : ℕ∞) ≤ M.height := by
    intro ι _ M hM
    obtain ⟨a, ha⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hM
    set n := Nat.card ι
    let e : ι ≃ Fin n := Finite.equivFin ι
    let τ : ℕ → (MvPolynomial ι K →ₐ[K] MvPolynomial ι K) := fun j =>
      MvPolynomial.aeval (fun i => if (e i : ℕ) < j then MvPolynomial.C (a i) else MvPolynomial.X i)
    let Q : ℕ → Ideal (MvPolynomial ι K) := fun j => RingHom.ker (τ j)
    have hQp : ∀ j, (Q j).IsPrime := fun j => RingHom.ker_isPrime (τ j)
    have hidem : ∀ j, (τ (j+1)).comp (τ j) = τ (j+1) := by
      intro j
      apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.comp_apply, τ, MvPolynomial.aeval_X]
      by_cases h : (e i : ℕ) < j
      · have h' : (e i : ℕ) < j + 1 := by omega
        simp [h, h']
      · simp [h]
    have hmono : ∀ j, Q j ≤ Q (j+1) := by
      intro j p hp
      simp only [Q, RingHom.mem_ker] at hp ⊢
      rw [← hidem j, AlgHom.comp_apply, hp, map_zero]
    have hlt : ∀ j, j < n → Q j < Q (j+1) := by
      intro j hj
      rw [SetLike.lt_iff_le_and_exists]
      refine ⟨hmono j, ?_⟩
      set i₀ := e.symm ⟨j, hj⟩
      have he : (e i₀ : ℕ) = j := by simp [i₀]
      refine ⟨MvPolynomial.X i₀ - MvPolynomial.C (a i₀), ?_, ?_⟩
      · simp only [Q, RingHom.mem_ker, τ, map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
        have : (e i₀ : ℕ) < j + 1 := by omega
        simp [this]
      · simp only [Q, RingHom.mem_ker, τ, map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
        have : ¬ (e i₀ : ℕ) < j := by omega
        simp only [this, ite_false, MvPolynomial.algebraMap_eq]
        intro h0
        have := congrArg (fun p : MvPolynomial ι K => p.coeff (Finsupp.single i₀ 1)) h0
        have hne : (0 : ι →₀ ℕ) ≠ Finsupp.single i₀ 1 :=
          (Finsupp.single_ne_zero.mpr one_ne_zero).symm
        simp [MvPolynomial.coeff_X, MvPolynomial.coeff_C, hne] at this
    have htop : Q n = M := by
      have hτn : τ n = (Algebra.ofId K (MvPolynomial ι K)).comp (MvPolynomial.aeval a) := by
        apply MvPolynomial.algHom_ext
        intro i
        simp [τ, MvPolynomial.algebraMap_eq]
      ext p
      simp only [Q, RingHom.mem_ker, ha, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rw [hτn, AlgHom.comp_apply]
      simp [MvPolynomial.algebraMap_eq]
    have hind : ∀ j, j ≤ n → (j : ℕ∞) ≤ (Q j).height := by
      intro j
      induction j with
      | zero => intro _; simp
      | succ j ih =>
        intro hj
        by_contra hcon
        rw [not_le] at hcon
        have h1 : (Q (j+1)).height ≤ j := by
          generalize (Q (j+1)).height = h at hcon ⊢
          induction h using ENat.recTopCoe with
          | top => simp at hcon
          | coe k => norm_cast at hcon ⊢; omega
        have := hQp (j+1)
        have h2 := (Ideal.height_le_iff.mp h1) (Q j) (hQp j) (hlt j (by omega))
        exact absurd (ih (by omega)) (not_le.mpr h2)
    rw [← htop]; exact hind n le_rfl

  have s2 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (σ : Type) [Finite σ] (g : σ → A)
      (M : Ideal A) [M.IsPrime] (N : ℕ), Ideal.span (Set.range g) ≤ M → (N : ℕ∞) ≤ M.height →
      (((N - Nat.card σ : ℕ) : ℕ∞) : WithBot ℕ∞) ≤ ringKrullDim (A ⧸ Ideal.span (Set.range g)) := by
    intro A _ _ σ _ g M _ N hIM hN
    set I := Ideal.span (Set.range g) with hI
    have hK := Ideal.height_le_height_add_spanFinrank_of_le hIM
    have hsf : Submodule.spanFinrank I ≤ Nat.card σ := by
      calc Submodule.spanFinrank I ≤ (Set.range g).ncard :=
            Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range g)
        _ ≤ Nat.card σ := by
          rw [← Set.image_univ, ← Set.ncard_univ σ]
          exact Set.ncard_image_le Set.finite_univ
    have hMp : (Ideal.map (Ideal.Quotient.mk I) M).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hIM)
    have hle := Ideal.height_le_ringKrullDim_of_ne_top hMp.ne_top
    refine le_trans ?_ hle
    rw [WithBot.coe_le_coe, ENat.natCast_sub, tsub_le_iff_right]
    calc (N : ℕ∞) ≤ M.height := hN
      _ ≤ _ := hK
      _ ≤ _ := by gcongr

  have s3 : ∀ (R : Type u) [CommRing R] [Algebra K R]
      [Algebra.IsStandardSmoothOfRelativeDimension d K R],
      ∃ (ι σ : Type) (_ : Finite ι) (_ : Finite σ) (g : σ → MvPolynomial ι K),
        Nat.card ι - Nat.card σ = d ∧
          Nonempty (R ≃+* MvPolynomial ι K ⧸ Ideal.span (Set.range g)) := by
    intro R _ _ h
    obtain ⟨ι, σ, _, _, P, hP⟩ := h.out
    refine ⟨ι, σ, inferInstance, inferInstance, P.relation, hP, ?_⟩
    have hker : Ideal.span (Set.range P.relation) =
        RingHom.ker (MvPolynomial.aeval (R := K) P.val).toRingHom := by
      rw [P.span_range_relation_eq_ker, Algebra.Generators.ker_eq_ker_aeval_val]; rfl
    have hsurj : Function.Surjective (MvPolynomial.aeval (R := K) P.val).toRingHom :=
      fun r => ⟨P.σ r, P.aeval_val_σ r⟩
    exact ⟨((Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hsurj)).symm⟩

  have s4 : ∀ (R : Type u) [CommRing R] [Nontrivial R] (φ : K →+* R),
      RingHom.IsStandardSmoothOfRelativeDimension d φ → (d : WithBot ℕ∞) ≤ ringKrullDim R := by
    intro R _ _ φ hφ
    letI := φ.toAlgebra
    haveI : Algebra.IsStandardSmoothOfRelativeDimension d K R := hφ
    obtain ⟨ι, σ, _, _, g, hd, ⟨e⟩⟩ := s3 R
    have hnt : Nontrivial (MvPolynomial ι K ⧸ Ideal.span (Set.range g)) :=
      Equiv.nontrivial e.symm.toEquiv
    have hI : Ideal.span (Set.range g) ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp hnt
    obtain ⟨M, hM, hIM⟩ := Ideal.exists_le_maximal _ hI
    have h1 := s1 ι M
    have h2 := s2 (MvPolynomial ι K) σ g M (Nat.card ι) hIM h1
    rw [hd] at h2
    rw [ringKrullDim_eq_of_ringEquiv e]
    exact_mod_cast h2

  obtain ⟨y⟩ := (IrreducibleSpace.toNonempty : Nonempty Y)
  obtain ⟨U, hU, V, hV, hyV, e, hstd⟩ := (smoothOfRelativeDimension_iff d f).mp ‹_› y
  have hfy : f y ∈ U := (Scheme.Hom.mem_preimage f).mp (e hyV)
  have hUtop : U = ⊤ := by
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_top]
    exact Set.eq_univ_of_forall (fun z => by rw [Subsingleton.elim z (f y)]; exact hfy)
  subst hUtop
  have hyV' : y ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hyV
  obtain ⟨t, -⟩ := hyV'
  haveI : Nontrivial Γ(Y, V) := PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨t⟩
  calc (d : WithBot ℕ∞) ≤ ringKrullDim Γ(Y, V) :=
        s4 _ _ (hstd.comp (RingHom.IsStandardSmoothOfRelativeDimension.equiv
          (Scheme.ΓSpecIso (CommRingCat.of K)).symm.commRingCatIsoToRingEquiv))
    _ = topologicalKrullDim (Spec Γ(Y, V)) :=
        (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim Γ(Y, V)).symm
    _ ≤ topologicalKrullDim Y := hV.fromSpec.isOpenEmbedding.isInducing.topologicalKrullDim_le

theorem wc_smooth_proper_curve_h2_card_eq_h0 : ∀ (k : Type u) [Field k] [IsAlgClosed k] (ℓ : ℕ), ℓ.Prime → (ℓ : k) ≠ 0 → ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of k)) [IsProper fY] [SmoothOfRelativeDimension 1 fY], 0 < Nat.card (wcEtCoh Y ℓ 0) ∧ Nat.card (wcEtCoh Y ℓ 2) = Nat.card (wcEtCoh Y ℓ 0) :=
by
  intro k _ _ ℓ hℓ hℓk Y fY _ _
  classical

  haveI := LocallyOfFiniteType.isLocallyNoetherian fY
  haveI := QuasiCompact.compactSpace_of_compactSpace fY
  haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
  have hdim : topologicalKrullDim Y ≤ ((1 : ℕ) : WithBot ℕ∞) := wc_smooth_alg_closed_dim_le k Y fY 1
  have hGfin := wc_proper_curve_nonclosed_finite k Y fY hdim

  have hirr : ∀ y : Y, IsIrreducible {z : Y | z ⤳ y} := by
    intro y
    haveI : IsDomain (Y.presheaf.stalk y) := wcpa_smooth_stalk_isDomain k Y fY 1 y
    have h := (IrreducibleSpace.isIrreducible_univ (Spec (Y.presheaf.stalk y))).image
      (Y.fromSpecStalk y) (Y.fromSpecStalk y).continuous.continuousOn
    rwa [Set.image_univ, Scheme.range_fromSpecStalk] at h

  have hop : ∀ y : Y, ¬ IsOpen ({y} : Set Y) := by
    intro y hy
    let U : Y.Opens := ⟨{y}, hy⟩
    haveI : SmoothOfRelativeDimension 1 (U.ι ≫ fY) :=
      zero_add 1 ▸ (inferInstance : SmoothOfRelativeDimension (0 + 1) (U.ι ≫ fY))
    have hpt : ∀ a : U.toScheme, U.ι a = y := by
      intro a
      have h1 : U.ι a ∈ Set.range U.ι := ⟨a, rfl⟩
      rw [Scheme.Opens.range_ι] at h1
      exact h1
    have hsub : Subsingleton U.toScheme :=
      ⟨fun a b => U.ι.isOpenEmbedding.injective ((hpt a).trans (hpt b).symm)⟩
    obtain ⟨a, -⟩ : y ∈ Set.range U.ι := by
      rw [Scheme.Opens.range_ι]
      exact Set.mem_singleton y
    haveI : IrreducibleSpace U.toScheme := by
      rw [irreducibleSpace_def]
      have : (⊤ : Set U.toScheme) = {a} :=
        Set.eq_singleton_iff_unique_mem.mpr ⟨trivial, fun b _ => Subsingleton.elim b a⟩
      rw [this]
      exact isIrreducible_singleton
    have h1 := wc_smooth_irreducible_dim_ge k U.toScheme (U.ι ≫ fY) 1
    haveI : Subsingleton (TopologicalSpace.IrreducibleCloseds U.toScheme) := ⟨fun s t => by
      apply TopologicalSpace.IrreducibleCloseds.ext
      obtain ⟨p, hp⟩ := s.isIrreducible.nonempty
      obtain ⟨q, hq⟩ := t.isIrreducible.nonempty
      ext z
      constructor
      · intro _; rwa [Subsingleton.elim z q]
      · intro _; rwa [Subsingleton.elim z p]⟩
    have h2 : topologicalKrullDim U.toScheme ≤ 0 := Order.krullDim_nonpos_of_subsingleton
    exact (by decide : ¬ ((1 : ℕ) : WithBot ℕ∞) ≤ 0) (h1.trans h2)

  have hchain : ∀ a b c : Y, a ⤳ b → b ⤳ c → a ≠ b → b ≠ c → False := by
    intro a b c hab hbc hne1 hne2
    let I : Y → TopologicalSpace.IrreducibleCloseds Y := fun x =>
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hlt : ∀ x z : Y, x ⤳ z → x ≠ z → I z < I x := by
      intro x z hxz hne
      refine lt_of_le_of_ne
        (show (I z : Set Y) ⊆ I x from specializes_iff_closure_subset.mp hxz) ?_
      intro heq
      have hc : closure ({z} : Set Y) = closure {x} :=
        congrArg (fun s : TopologicalSpace.IrreducibleCloseds Y => (s : Set Y)) heq
      have hzx : z ⤳ x := specializes_iff_closure_subset.mpr hc.symm.le
      exact hne (hxz.antisymm hzx).eq
    have h1 := hlt b c hbc hne2
    have h2 := hlt a b hab hne1
    have hmono : StrictMono
        (![I c, I b, I a] : Fin 3 → TopologicalSpace.IrreducibleCloseds Y) := by
      refine Fin.strictMono_iff_lt_succ.mpr ?_
      intro i
      fin_cases i
      · first | exact h1 | simpa using h1
      · first | exact h2 | simpa using h2
    let s : LTSeries (TopologicalSpace.IrreducibleCloseds Y) := LTSeries.mk 2 _ hmono
    have h3 := Order.LTSeries.length_le_krullDim s
    have h4 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := le_trans h3 hdim
    exact (by norm_num : ¬ ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞)) h4

  have hnc : ∀ g : Y, ¬ IsClosed ({g} : Set Y) → ∃ w, g ⤳ w ∧ w ≠ g := by
    intro g hg
    by_contra hcon
    push_neg at hcon
    apply hg
    apply isClosed_of_closure_subset
    intro w hw
    exact hcon w (specializes_iff_mem_closure.mpr hw)
  have hcl : ∀ g y : Y, g ⤳ y → g ≠ y → ¬ IsClosed ({g} : Set Y) := by
    intro g y hgy hne hc
    exact hne (hgy.mem_closed hc (Set.mem_singleton g)).symm

  have huniq : ∀ y : Y, ∃! g : Y, ¬ IsClosed ({g} : Set Y) ∧ g ⤳ y := by
    intro y
    obtain ⟨η, hη⟩ := QuasiSober.sober (hirr y).closure isClosed_closure
    have hηs : ∀ z : Y, z ⤳ y → η ⤳ z := fun z hz => hη.specializes (subset_closure hz)
    have heq : ∀ g : Y, ¬ IsClosed ({g} : Set Y) → g ⤳ y → g = η := by
      intro g hg hgy
      by_contra hne
      obtain ⟨w, hgw, hwg⟩ := hnc g hg
      exact hchain η g w (hηs g hgy) hgw (Ne.symm hne) (Ne.symm hwg)
    have hex : ∃ g : Y, ¬ IsClosed ({g} : Set Y) ∧ g ⤳ y := by
      by_cases hy : IsClosed ({y} : Set Y)
      · by_contra hcon
        push_neg at hcon
        have hstar : ∀ z : Y, z ⤳ y → z = y := by
          intro z hz
          by_contra hne
          exact hcon z (hcl z y hz hne) hz
        apply hop y
        have hcomp : ∀ D ∈ irreducibleComponents Y, y ∈ D → D = {y} := by
          intro D hD hyD
          obtain ⟨d, hd⟩ := QuasiSober.sober (show Maximal IsIrreducible D from hD).prop
            (isClosed_of_mem_irreducibleComponents D hD)
          have hdy' := hstar d (hd.specializes hyD)
          rw [← hd.def, hdy', hy.closure_eq]
        have hfin : {D ∈ irreducibleComponents Y | y ∉ D}.Finite :=
          TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset (fun D hD => hD.1)
        have hclosed : IsClosed (⋃ D ∈ {D ∈ irreducibleComponents Y | y ∉ D}, D) :=
          hfin.isClosed_biUnion (fun D hD => isClosed_of_mem_irreducibleComponents D hD.1)
        have heqc : (⋃ D ∈ {D ∈ irreducibleComponents Y | y ∉ D}, D) = ({y} : Set Y)ᶜ := by
          ext x
          constructor
          · intro hx
            rw [Set.mem_iUnion₂] at hx
            obtain ⟨D, hD, hxD⟩ := hx
            intro hxy
            have hxy' : x = y := Set.mem_singleton_iff.mp hxy
            subst hxy'
            exact hD.2 hxD
          · intro hxy
            obtain ⟨D, hD, hxD⟩ :=
              exists_mem_irreducibleComponents_subset_of_isIrreducible {x} isIrreducible_singleton
            rw [Set.mem_iUnion₂]
            refine ⟨D, ⟨hD, fun hyD => hxy ?_⟩, hxD (Set.mem_singleton x)⟩
            have h' := hcomp D hD hyD
            have hx' : x ∈ D := hxD (Set.mem_singleton x)
            rw [h'] at hx'
            exact hx'
        rw [← isClosed_compl_iff, ← heqc]
        exact hclosed
      · exact ⟨y, hy, specializes_rfl⟩
    obtain ⟨g, hg, hgy⟩ := hex
    exact ⟨g, ⟨hg, hgy⟩, fun g' hg' => (heq g' hg'.1 hg'.2).trans (heq g hg hgy).symm⟩

  choose γ hγ using fun y => (huniq y).exists
  have hγu : ∀ g y : Y, ¬ IsClosed ({g} : Set Y) → g ⤳ y → g = γ y :=
    fun g y hg hgy => (huniq y).unique ⟨hg, hgy⟩ (hγ y)
  set G := {x : Y | ¬ IsClosed ({x} : Set Y)} with hGdef
  haveI : Finite G := hGfin.to_subtype
  let R : LocallyConstant Y (ZMod ℓ) → (G → ZMod ℓ) := fun f g => f g.1
  have hfγ : ∀ (f : LocallyConstant Y (ZMod ℓ)) (y : Y), f (γ y) = f y := by
    intro f y
    have hfib := f.isLocallyConstant.isOpen_fiber (f y)
    exact (hγ y).2.mem_open hfib rfl
  have hRinj : Function.Injective R := by
    intro f f' h
    ext y
    have h' : f (γ y) = f' (γ y) := congrFun h ⟨γ y, (hγ y).1⟩
    rw [← hfγ f y, ← hfγ f' y]
    exact h'
  have hRsurj : Function.Surjective R := by
    intro c
    let F : Y → ZMod ℓ := fun y => c ⟨γ y, (hγ y).1⟩
    have hF : IsLocallyConstant F := by
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro a
      have hc : (F ⁻¹' {a})ᶜ = ⋃ g ∈ {g : G | c g ≠ a}, closure ({(g : Y)} : Set Y) := by
        ext y
        rw [Set.mem_compl_iff, Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion₂]
        constructor
        · intro hy
          exact ⟨⟨γ y, (hγ y).1⟩, hy, specializes_iff_mem_closure.mp (hγ y).2⟩
        · rintro ⟨g, hg, hyg⟩ hFa
          have hg' : c g ≠ a := hg
          apply hg'
          have hgy : (g : Y) = γ y := hγu g y g.2 (specializes_iff_mem_closure.mpr hyg)
          rw [← hFa]
          show c g = c ⟨γ y, (hγ y).1⟩
          congr 1
          exact Subtype.ext hgy
      rw [← isClosed_compl_iff, hc]
      exact (Set.toFinite _).isClosed_biUnion (fun _ _ => isClosed_closure)
    refine ⟨⟨F, hF⟩, ?_⟩
    funext g
    show c ⟨γ g.1, (hγ g.1).1⟩ = c g
    congr 1
    exact Subtype.ext (hγu g.1 g.1 g.2 specializes_rfl).symm
  have hlc : Nat.card (LocallyConstant Y (ZMod ℓ)) = ℓ ^ Set.ncard G := by
    rw [Nat.card_eq_of_bijective R ⟨hRinj, hRsurj⟩, Nat.card_fun, Nat.card_zmod,
      Nat.card_coe_set_eq]

  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  let T₀ : Y.Etale := Scheme.Etale.mk (𝟙 Y)
  have hT : Limits.IsTerminal T₀ :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨ε, -, -⟩ := wc_et_const_hom_sections_equiv Y T₀ hT
  obtain ⟨e, -⟩ := wc_et_const_zmod_sections_locallyConstant Y ℓ
    (fun V S hS x hx => wc_et_locallyConstant_glue Y V S hS ℓ x hx)
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  let E₁ : wcEtCoh Y ℓ 0 ≃ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) :=
    (Abelian.Ext.addEquiv₀).toEquiv
  let E := E₁.trans ((ε _).trans (e T₀).toEquiv)
  have h0 : Nat.card (wcEtCoh Y ℓ 0) = ℓ ^ Set.ncard G := (Nat.card_congr E).trans hlc

  have h2 : Nat.card (wcEtCoh Y ℓ 2) = ℓ ^ Set.ncard G :=
    wc_et_curve_h2_card_reduction k ℓ hℓ hℓk wc_et_henselian_proper_vanishing
      (by
        intro X fX hfX hX hn hd
        exact wc_et_normal_curve_h2_card k X fX hX hn hd ℓ hℓ hℓk) Y fY hdim
  refine ⟨?_, h2.trans h0.symm⟩
  rw [h0]
  exact pow_pos hℓ.pos _

theorem wc_affine_curve_kummer_count : ∀ (k : Type u) [Field k] [IsAlgClosed k] (ℓ : ℕ), ℓ.Prime → (ℓ : k) ≠ 0 → ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of k)) [IsProper fY] [SmoothOfRelativeDimension 1 fY] (A : Type u) [CommRing A] (j : Spec (.of A) ⟶ Y) [IsOpenImmersion j], (Set.range j)ᶜ.Finite → Finite {x : CommRing.Pic A // x ^ ℓ = 1} ∧ Finite (Aˣ ⧸ (powMonoidHom ℓ : Aˣ →* Aˣ).range) ∧ 0 < Nat.card (wcEtCoh Y ℓ 0) ∧ Nat.card {x : CommRing.Pic A // x ^ ℓ = 1} * Nat.card (Aˣ ⧸ (powMonoidHom ℓ : Aˣ →* Aˣ).range) * Nat.card (wcEtCoh Y ℓ 0) = Nat.card (wcEtCoh Y ℓ 1) * ℓ ^ Nat.card ↥((Set.range j)ᶜ) :=
by
  intro k _ _ ℓ hℓ hℓk Y fY _ _ A _ j _ hfin
  obtain ⟨hfinPU, hcard⟩ :=
    wc_affine_kummer_h1_card_of_pic k ℓ hℓ hℓk A (j ≫ fY) (wc_et_gm_h1_affine_pic A)
  obtain ⟨hH1, hgys⟩ := wc_curve_open_gysin_h1_card k ℓ hℓ hℓk Y fY (Spec (.of A)) j hfin
  obtain ⟨h0pos, h20⟩ := wc_smooth_proper_curve_h2_card_eq_h0 k ℓ hℓ hℓk Y fY
  obtain ⟨hP, hU⟩ := hfinPU hH1
  refine ⟨hP, hU, h0pos, ?_⟩
  rw [← hcard, ← h20]
  exact hgys

theorem wc_cp_etale_line_finite_model : ∀ (L : Type u) [Field L] [IsAlgClosed L] (R : Type u) [CommRing R] [Algebra L R] [Algebra (Polynomial L) R] [IsScalarTower L (Polynomial L) R] [Algebra.Etale (Polynomial L) R], _root_.IsReduced R ∧ ∃ ψ : Polynomial L →ₐ[L] R, ψ.toRingHom.Finite ∧ ∀ a : Polynomial L, a ≠ 0 → ψ a ∈ nonZeroDivisors R :=
by
  intro L _ _ R _ _ _ _ _
  classical
  rcases subsingleton_or_nontrivial R with hR | hR
  · refine ⟨⟨fun x _ => Subsingleton.elim x 0⟩, IsScalarTower.toAlgHom L (Polynomial L) R,
      RingHom.Finite.of_surjective _ (fun y => ⟨0, Subsingleton.elim _ _⟩), fun a _ => ?_⟩
    rw [mem_nonZeroDivisors_iff_right]
    intro x _
    exact Subsingleton.elim _ _

  have hreg : ∀ b : Polynomial L, b ≠ 0 → IsSMulRegular R b := fun b hb =>
    Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hb)
  have htf : ∀ b : Polynomial L, b ≠ 0 → algebraMap (Polynomial L) R b ∈ nonZeroDivisors R := by
    intro b hb
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    apply hreg b hb
    show b • x = b • 0
    rw [smul_zero, Algebra.smul_def, mul_comm]
    exact hx
  let K := FractionRing (Polynomial L)
  let RK := TensorProduct (Polynomial L) K R
  let f : R →ₐ[Polynomial L] RK := Algebra.TensorProduct.includeRight
  have hf : Function.Injective f := by
    rw [injective_iff_map_eq_zero]
    intro r hr
    have h1 : TensorProduct.mk (Polynomial L) K R 1 r = 0 := hr
    rw [IsLocalizedModule.eq_zero_iff (nonZeroDivisors (Polynomial L))] at h1
    obtain ⟨⟨s, hs⟩, hsr⟩ := h1
    have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
    apply hreg s hs0
    show s • r = s • 0
    rw [smul_zero]
    exact hsr
  haveI : Algebra.Etale K RK := Algebra.Etale.baseChange (Polynomial L) R K
  haveI : IsReduced RK := Algebra.FormallyUnramified.isReduced_of_field K RK
  have hred : IsReduced R := isReduced_of_injective f hf
  haveI : Module.Finite K RK := Algebra.FormallyUnramified.finite_of_free K RK
  haveI : Algebra.IsAlgebraic K RK := Algebra.IsAlgebraic.of_finite K RK
  have halg : ∀ r : R, IsAlgebraic (Polynomial L) r := by
    intro r
    have h1 : IsAlgebraic K (f r) := Algebra.IsAlgebraic.isAlgebraic _
    have h2 : IsAlgebraic (Polynomial L) (f r) :=
      (IsFractionRing.isAlgebraic_iff (Polynomial L) K RK).mpr h1
    exact (isAlgebraic_algHom_iff f hf).mp h2
  haveI hft : Algebra.FiniteType L R :=
    Algebra.FiniteType.trans (S := Polynomial L) inferInstance inferInstance

  have htr : ∀ p : Ideal R, p ∈ minimalPrimes R → Algebra.trdeg L (R ⧸ p) = 1 := by
    intro p hp
    haveI : p.IsPrime := hp.1.1
    have hinj : Function.Injective (algebraMap (Polynomial L) (R ⧸ p)) := by
      rw [injective_iff_map_eq_zero]
      intro b hb
      by_contra hb0
      rw [IsScalarTower.algebraMap_apply (Polynomial L) R (R ⧸ p), Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem] at hb
      exact Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hp) hb
        (htf b hb0)
    haveI : FaithfulSMul (Polynomial L) (R ⧸ p) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
    haveI : Algebra.IsAlgebraic (Polynomial L) (R ⧸ p) := ⟨fun x => by
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact (halg r).algHom (Ideal.Quotient.mkₐ (Polynomial L) p)⟩
    have h := trdeg_add_eq L (Polynomial L) (A := R ⧸ p)
    rw [Polynomial.trdeg_of_isDomain, trdeg_eq_zero, add_zero] at h
    exact h.symm

  have hψex : ∃ ψ : Polynomial L →ₐ[L] R, ψ.toRingHom.Finite := by
    obtain ⟨s, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg L R
    letI : Algebra (MvPolynomial (Fin s) L) R := g.toRingHom.toAlgebra
    haveI : Module.Finite (MvPolynomial (Fin s) L) R := hgfin
    haveI : IsScalarTower L (MvPolynomial (Fin s) L) R :=
      IsScalarTower.of_algebraMap_eq (fun c => (g.commutes c).symm)
    obtain ⟨Q, -, hQ, hQu⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
      (⊥ : Ideal (MvPolynomial (Fin s) L)) (⊥ : Ideal R) (by
        intro x hx
        have hx' : g x = 0 := Ideal.mem_bot.mp hx
        exact Ideal.mem_bot.mpr (hginj (hx'.trans (map_zero g).symm)))
    haveI := hQ
    obtain ⟨p, hp, hpQ⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal R) ≤ Q)
    have hp' : p ∈ minimalPrimes R := hp
    haveI : p.IsPrime := hp.1.1
    have hinj : Function.Injective (algebraMap (MvPolynomial (Fin s) L) (R ⧸ p)) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin s) L) R (R ⧸ p),
        Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem] at hx
      have hx3 : x ∈ Ideal.under (MvPolynomial (Fin s) L) Q := hpQ hx
      rw [hQu] at hx3
      exact Ideal.mem_bot.mp hx3
    haveI : FaithfulSMul (MvPolynomial (Fin s) L) (R ⧸ p) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) L) (R ⧸ p) := ⟨fun x => by
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact (Algebra.IsIntegral.isIntegral r).map (Ideal.Quotient.mkₐ (MvPolynomial (Fin s) L) p)⟩
    haveI : Algebra.IsAlgebraic (MvPolynomial (Fin s) L) (R ⧸ p) :=
      Algebra.IsIntegral.isAlgebraic
    have ht := trdeg_add_eq L (MvPolynomial (Fin s) L) (A := R ⧸ p)
    rw [MvPolynomial.trdeg_of_isDomain, trdeg_eq_zero, add_zero, htr p hp', Cardinal.mk_fin,
      Cardinal.lift_natCast] at ht
    have hs1 : s = 1 := by exact_mod_cast ht
    subst hs1
    refine ⟨g.comp (MvPolynomial.uniqueAlgEquiv L (Fin 1)).symm.toAlgHom, ?_⟩
    exact RingHom.Finite.comp hgfin (RingHom.Finite.of_surjective _
      (MvPolynomial.uniqueAlgEquiv L (Fin 1)).symm.surjective)
  obtain ⟨ψ, hψ⟩ := hψex
  refine ⟨hred, ψ, hψ, ?_⟩

  intro a ha
  have avoid : ∀ p ∈ minimalPrimes R, ψ a ∉ p := by
    intro p hp hap
    haveI : p.IsPrime := hp.1.1
    let φ : Polynomial L →ₐ[L] R ⧸ p := (Ideal.Quotient.mkₐ L p).comp ψ
    have hφfin : φ.toRingHom.Finite :=
      RingHom.Finite.comp (RingHom.Finite.of_surjective _ Ideal.Quotient.mk_surjective) hψ
    have hφ : ∀ q : Polynomial L, φ q = Polynomial.aeval (φ Polynomial.X) q := by
      intro q
      rw [Polynomial.aeval_algHom_apply, Polynomial.aeval_X_left_apply]
    have hφa : Polynomial.aeval (φ Polynomial.X) a = 0 := by
      rw [← hφ]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hap
    have halgt : IsAlgebraic L (φ Polynomial.X) := ⟨a, ha, hφa⟩
    have ht : IsIntegral L (φ Polynomial.X) := halgt.isIntegral
    let S : Subalgebra L (R ⧸ p) := φ.range
    haveI : Algebra.IsIntegral L S := ⟨fun y => by
      obtain ⟨y, hy⟩ := y
      obtain ⟨q, rfl⟩ := hy
      have h1 : IsIntegral L (φ q) := by
        rw [hφ]
        exact adjoin_le_integralClosure ht (Polynomial.aeval_mem_adjoin_singleton L _)
      exact (isIntegral_algHom_iff S.val Subtype.val_injective).mp h1⟩
    haveI : Algebra.IsIntegral S (R ⧸ p) := ⟨fun y =>
      RingHom.IsIntegral.tower_top φ.rangeRestrict.toRingHom (algebraMap S (R ⧸ p))
        hφfin.to_isIntegral y⟩
    haveI : Algebra.IsIntegral L (R ⧸ p) := Algebra.IsIntegral.trans S
    haveI : Algebra.IsAlgebraic L (R ⧸ p) := Algebra.IsIntegral.isAlgebraic
    have h0 := htr p hp
    rw [trdeg_eq_zero] at h0
    exact zero_ne_one h0
  haveI := hred
  rw [mem_nonZeroDivisors_iff_right]
  intro x hx
  have hxnil : x ∈ nilradical R := by
    rw [nilradical_eq_sInf, Ideal.mem_sInf]
    intro J hJ
    haveI : J.IsPrime := hJ
    obtain ⟨p, hp, hpJ⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal R) ≤ J)
    have hp' : p ∈ minimalPrimes R := hp
    haveI : p.IsPrime := hp.1.1
    have hmem : x * ψ a ∈ p := by rw [hx]; exact p.zero_mem
    rcases Ideal.IsPrime.mem_or_mem ‹p.IsPrime› hmem with h | h
    · exact hpJ h
    · exact absurd h (avoid p hp')
  exact IsNilpotent.eq_zero (mem_nilradical.mp hxnil)

theorem wc_cp_P1_charts : ∀ (K : Type u) [Field K], ∃ (P : Scheme.{u}) (sP : P ⟶ Spec (.of K)) (j0 j1 : Spec (.of (Polynomial K)) ⟶ P) (σ : Spec (.of K) ⟶ P), IsProper sP ∧ IsOpenImmersion j0 ∧ IsOpenImmersion j1 ∧ QuasiCompact j0 ∧ QuasiCompact j1 ∧ j0 ≫ sP = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) ∧ j1 ≫ sP = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) ∧ σ ≫ sP = 𝟙 _ ∧ (Set.range j0)ᶜ = {σ (IsLocalRing.closedPoint K)} ∧ σ (IsLocalRing.closedPoint K) ∈ Set.range j1 ∧ j1 ⁻¹' Set.range j0 = {p | (Polynomial.X : Polynomial K) ∉ p.asIdeal} ∧ j0 ⁻¹' Set.range j1 = {p | (Polynomial.X : Polynomial K) ∉ p.asIdeal} ∧ Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K)))) ≫ j0 = Spec.map (CommRingCat.ofHom (Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) : Localization.Away (Polynomial.X : Polynomial K))).toRingHom) ≫ j1 :=
by
  intro K _

  have huniq : ∀ (d : ℕ) (y z : wcProjK K d), (∀ i : Fin (d + 1), i.val < d → y ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X i)) → (∀ i : Fin (d + 1), i.val < d → z ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X i)) → y = z := by
    intro d y z hy hz
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
      MvPolynomial.gradedAlgebra
    obtain ⟨I, hI⟩ : ∃ I : Ideal (MvPolynomial (Fin (d + 1)) K),
        I = Ideal.span (MvPolynomial.X '' {i : Fin (d + 1) | i.val < d}) := ⟨_, rfl⟩
    have hlast : ∀ i : Fin (d + 1), i ≠ Fin.last d → i.val < d := by
      intro i hi
      have h1 := Fin.lt_last_iff_ne_last.mpr hi
      rw [Fin.lt_iff_val_lt_val, Fin.val_last] at h1
      exact h1
    have key : ∀ (p : Ideal (MvPolynomial (Fin (d + 1)) K)), p.IsPrime →
        (∀ i : Fin (d + 1), i.val < d → MvPolynomial.X i ∈ p) →
        MvPolynomial.X (Fin.last d) ∉ p →
        ∀ (n : ℕ) (h : MvPolynomial (Fin (d + 1)) K), h.IsHomogeneous n → h ∈ p → h ∈ I := by
      intro p hp hX hXl n h hh hmem
      obtain ⟨e, he⟩ : ∃ e : Fin (d + 1) →₀ ℕ, e = Finsupp.single (Fin.last d) n := ⟨_, rfl⟩
      have hIp : I ≤ p := by
        rw [hI, Ideal.span_le, Set.image_subset_iff]
        intro i hi
        exact hX i hi
      have hr : h - MvPolynomial.monomial e (h.coeff e) ∈ I := by
        rw [hI, MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub, MvPolynomial.coeff_monomial] at hm
        have hme : m ≠ e := by
          intro hme'
          rw [hme', if_pos rfl, sub_self] at hm
          exact hm rfl
        rw [if_neg (Ne.symm hme), sub_zero] at hm
        have hdeg : Finsupp.degree m = n := by
          by_contra hne
          exact hm (hh.coeff_eq_zero hne)
        by_contra hno
        push_neg at hno
        apply hme
        have hms : m = Finsupp.single (Fin.last d) (m (Fin.last d)) := by
          ext i
          by_cases hi : i = Fin.last d
          · subst hi; simp
          · rw [Finsupp.single_apply, if_neg (fun h' => hi h'.symm)]
            exact hno i (hlast i hi)
        have hml : m (Fin.last d) = n := by
          have h2 := hdeg
          rw [hms, Finsupp.degree_single] at h2
          exact h2
        calc m = Finsupp.single (Fin.last d) (m (Fin.last d)) := hms
          _ = e := by rw [hml, he]
      have hmono : MvPolynomial.monomial e (h.coeff e) ∈ p := by
        have h3 : MvPolynomial.monomial e (h.coeff e) =
            h - (h - MvPolynomial.monomial e (h.coeff e)) := by ring
        rw [h3]
        exact p.sub_mem hmem (hIp hr)
      have hc0 : h.coeff e = 0 := by
        by_contra hc
        apply hXl
        apply hp.mem_of_pow_mem n
        have h4 : MvPolynomial.X (Fin.last d) ^ n =
            MvPolynomial.C (h.coeff e)⁻¹ * MvPolynomial.monomial e (h.coeff e) := by
          rw [MvPolynomial.C_mul_monomial, inv_mul_cancel₀ hc, he, MvPolynomial.X_pow_eq_monomial]
        rw [h4]
        exact p.mul_mem_left _ hmono
      have h5 : h = h - MvPolynomial.monomial e (h.coeff e) := by
        rw [hc0, map_zero, sub_zero]
      rw [h5]
      exact hr
    have hpt : ∀ x : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K),
        (∀ i : Fin (d + 1), i.val < d → MvPolynomial.X i ∈ x.asHomogeneousIdeal) →
        x.asHomogeneousIdeal.toIdeal = I := by
      intro x hx
      have hXl : MvPolynomial.X (Fin.last d) ∉ x.asHomogeneousIdeal.toIdeal := by
        intro hl
        apply ProjectiveSpectrum.not_irrelevant_le x
        intro a ha
        have hall : ∀ i : Fin (d + 1), MvPolynomial.X i ∈ x.asHomogeneousIdeal.toIdeal := by
          intro i
          by_cases hi : i = Fin.last d
          · rw [hi]; exact hl
          · exact hx i (hlast i hi)
        have ha0 : a.coeff 0 = 0 := by
          rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha
          have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) a 0 :
              MvPolynomial (Fin (d + 1)) K)) = MvPolynomial.homogeneousComponent 0 a :=
            MvPolynomial.decomposition.decompose'_apply a 0
          rw [h6, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha
          exact ha
        have hspan : a ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1)))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro m hm
          rw [MvPolynomial.mem_support_iff] at hm
          have hm0 : m ≠ 0 := by
            rintro rfl
            exact hm ha0
          obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
          exact ⟨i, Set.mem_univ _, hi⟩
        have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1)))) ≤
            x.asHomogeneousIdeal.toIdeal := by
          rw [Ideal.span_le, Set.image_subset_iff]
          intro i _
          exact hall i
        exact hle hspan
      have hhom := x.asHomogeneousIdeal.isHomogeneous
      have hp : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
      apply le_antisymm
      · intro a ha
        rw [← MvPolynomial.sum_homogeneousComponent a]
        apply Ideal.sum_mem
        intro k _
        have h7 := hhom k ha
        have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) a k :
            MvPolynomial (Fin (d + 1)) K)) = MvPolynomial.homogeneousComponent k a :=
          MvPolynomial.decomposition.decompose'_apply a k
        rw [h6] at h7
        exact key _ hp hx hXl k _ (MvPolynomial.homogeneousComponent_isHomogeneous k a) h7
      · rw [hI, Ideal.span_le, Set.image_subset_iff]
        intro i hi
        exact hx i hi
    have hy' := hpt y (fun i hi => by
      have h8 := hy i hi
      rw [Proj.mem_basicOpen, not_not] at h8
      exact h8)
    have hz' := hpt z (fun i hi => by
      have h8 := hz i hi
      rw [Proj.mem_basicOpen, not_not] at h8
      exact h8)
    exact ProjectiveSpectrum.ext (HomogeneousIdeal.ext (hy'.trans hz'.symm))
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have hproper : IsProper (wcProjKStr K 1) := by
    letI : IsScalarTower K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (MvPolynomial (Fin (1+1)) K) :=
      IsScalarTower.of_algebraMap_eq (R := K)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (A := MvPolynomial (Fin (1+1)) K) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)
        (MvPolynomial (Fin (1+1)) K) :=
      Algebra.FiniteType.of_restrictScalars_finiteType K _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0 =>
          (x : MvPolynomial (Fin (1+1)) K)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (1+1)) K).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (1+1)) K).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (1+1)) K).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) K) 0))))
    infer_instance
  haveI := hproper

  have scaling : ∀ (T : Type u) [CommRing T] (ν ι : MvPolynomial (Fin (1 + 1)) K →+* T) (t : T),
      (∀ c : K, ν (MvPolynomial.C c) = ι (MvPolynomial.C c)) →
      (∀ k, ν (MvPolynomial.X k) * t = ι (MvPolynomial.X k)) →
      ∀ (n : ℕ) (a : MvPolynomial (Fin (1 + 1)) K), a.IsHomogeneous n → ν a * t ^ n = ι a := by
    intro T _ ν ι t hC hXk n a ha
    conv_rhs => rw [a.as_sum]
    conv_lhs => rw [a.as_sum]
    rw [map_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    have hdeg : ∑ k ∈ m.support, m k = n := by
      have := ha (MvPolynomial.mem_support_iff.mp hm)
      simpa [Finsupp.weight_apply, Finsupp.sum] using this
    rw [MvPolynomial.monomial_eq, map_mul, map_mul, Finsupp.prod, map_prod, map_prod, ← hdeg,
      ← Finset.prod_pow_eq_pow_sum, mul_assoc, ← Finset.prod_mul_distrib, hC]
    congr 1
    refine Finset.prod_congr rfl (fun k _ => ?_)
    rw [map_pow, map_pow, ← mul_pow, hXk]
  have hX : ∀ k : Fin (1 + 1), (MvPolynomial.X k : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 :=
    fun k => (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X k)).mpr
      (MvPolynomial.isHomogeneous_X K k)
  let δ : Fin (1 + 1) → MvPolynomial (Fin (1 + 1)) K →ₐ[K] Polynomial K := fun i =>
    MvPolynomial.aeval (fun k : Fin (1 + 1) => if k = i then (1 : Polynomial K) else Polynomial.X)
  have hδC : ∀ i c, δ i (MvPolynomial.C c) = Polynomial.C c := by
    intro i c
    simp only [δ, MvPolynomial.aeval_C, Polynomial.algebraMap_eq]
  have hδ00 : δ 0 (MvPolynomial.X 0) = 1 := by simp [δ]
  have hδ01 : δ 0 (MvPolynomial.X 1) = Polynomial.X := by simp [δ]
  have hδ10 : δ 1 (MvPolynomial.X 0) = Polynomial.X := by simp [δ]
  have hδ11 : δ 1 (MvPolynomial.X 1) = 1 := by simp [δ]

  have chart : ∀ i : Fin (1 + 1), ∃ ψ : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i) →+* Polynomial K,
      Function.Bijective ψ ∧
      (∀ c : K, ψ (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X i))
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0) c)) = Polynomial.C c) ∧
      ∀ (n : ℕ) (a : MvPolynomial (Fin (1 + 1)) K)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (n • 1)),
        ψ (HomogeneousLocalization.Away.mk _ (hX i) n a ha) = δ i a := by
    intro i
    let κ := (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X i))).comp
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0))
    have h1 : (MvPolynomial.X (i.succAbove 0) : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (1 • 1) := by
      rw [smul_eq_mul, mul_one]; exact hX _
    let y : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i) :=
      HomogeneousLocalization.Away.mk _ (hX i) 1 (MvPolynomial.X (i.succAbove 0)) h1
    let φ : Polynomial K →+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i) :=
      Polynomial.eval₂RingHom κ y
    have hδi : δ i (MvPolynomial.X i) = 1 := by simp [δ]
    have hδs : δ i (MvPolynomial.X (i.succAbove 0)) = Polynomial.X := by
      simp [δ, Fin.succAbove_ne]
    let L := Localization (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) K))
    have hu : IsUnit ((δ i).toRingHom (MvPolynomial.X i)) := by
      show IsUnit (δ i (MvPolynomial.X i))
      rw [hδi]; exact isUnit_one
    let Λ : L →+* Polynomial K := IsLocalization.Away.lift (MvPolynomial.X i) hu
    have hΛ : ∀ a, Λ (algebraMap _ L a) = δ i a := fun a => IsLocalization.Away.lift_eq _ hu a
    let ψ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X i) →+* Polynomial K := Λ.comp (algebraMap _ L)
    have hF : ∀ (n : ℕ) (a : MvPolynomial (Fin (1 + 1)) K)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (n • 1)),
        ψ (HomogeneousLocalization.Away.mk _ (hX i) n a ha) = δ i a := by
      intro n a ha
      have hs := IsLocalization.mk'_spec L a
        (⟨MvPolynomial.X i ^ n, n, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
      have h2 := congrArg Λ hs
      rw [map_mul, hΛ, hΛ] at h2
      change Λ _ * δ i (MvPolynomial.X i ^ n) = δ i a at h2
      rw [map_pow, hδi, one_pow, mul_one] at h2
      show Λ (algebraMap _ L _) = _
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk'_apply]
      exact h2
    have hC0 : ∀ c : K, (MvPolynomial.C c : MvPolynomial (Fin (1 + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (0 • 1) := fun c => by
      rw [zero_smul]
      exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_C _ c)
    have hκ : ∀ c, κ c = HomogeneousLocalization.Away.mk _ (hX i) 0 (MvPolynomial.C c) (hC0 c) := by
      intro c
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      change (HomogeneousLocalization.mk
          ⟨0, algebraMap K _ c, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩ :
            HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
              (MvPolynomial.X i)).val = _
      rw [HomogeneousLocalization.val_mk]
      congr 1
    have hψφ : ψ.comp φ = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.id_apply]
        show ψ (Polynomial.eval₂RingHom κ y (Polynomial.C c)) = _
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hκ, hF, hδC]
      · rw [RingHom.comp_apply, RingHom.id_apply]
        show ψ (Polynomial.eval₂RingHom κ y Polynomial.X) = _
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hF, hδs]
    have hφψ : φ.comp ψ = RingHom.id _ := by
      refine RingHom.ext fun x => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX i) x
      rw [RingHom.comp_apply, RingHom.id_apply, hF]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply, eq_comm,
        IsLocalization.mk'_eq_iff_eq_mul]
      have hahom : a.IsHomogeneous n := by
        rw [smul_eq_mul, mul_one] at ha
        exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
      have key := scaling L
        ((algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i)) L).comp
            (φ.comp (δ i).toRingHom))
        (algebraMap (MvPolynomial (Fin (1 + 1)) K) L)
        (algebraMap (MvPolynomial (Fin (1 + 1)) K) L (MvPolynomial.X i)) ?_ ?_ n a hahom
      · rw [← key, RingHom.comp_apply, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        congr 1
        exact (map_pow _ _ _).symm
      · intro c
        show algebraMap _ L (φ (δ i (MvPolynomial.C c))) = _
        rw [hδC]
        show algebraMap _ L (Polynomial.eval₂RingHom κ y (Polynomial.C c)) = _
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hκ,
          HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply,
          IsLocalization.mk'_eq_iff_eq_mul]
        show _ = _ * algebraMap (MvPolynomial (Fin (1 + 1)) K) L (MvPolynomial.X i ^ 0)
        rw [pow_zero, map_one, mul_one]
      · intro k
        obtain h | ⟨j, h⟩ := Fin.eq_self_or_eq_succAbove i k
        · rw [h]
          show algebraMap _ L (φ (δ i (MvPolynomial.X i))) * _ = _
          rw [hδi, map_one, map_one, one_mul]
        · rw [h, Fin.fin_one_eq_zero j]
          show algebraMap _ L (φ (δ i (MvPolynomial.X (i.succAbove 0)))) * _ = _
          rw [hδs]
          show algebraMap _ L (Polynomial.eval₂RingHom κ y Polynomial.X) * _ = _
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
            HomogeneousLocalization.algebraMap_apply,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply]
          have hs := IsLocalization.mk'_spec L
            (MvPolynomial.X (i.succAbove 0) : MvPolynomial (Fin (1 + 1)) K)
            (⟨MvPolynomial.X i ^ 1, 1, rfl⟩ : Submonoid.powers (MvPolynomial.X i))
          rw [← hs]
          congr 1
          show _ = algebraMap (MvPolynomial (Fin (1 + 1)) K) L (MvPolynomial.X i ^ 1)
          rw [pow_one]
    refine ⟨ψ, Function.bijective_iff_has_inverse.mpr
      ⟨φ, fun x => RingHom.congr_fun hφψ x, fun x => RingHom.congr_fun hψφ x⟩, ?_, hF⟩
    intro c
    show ψ (κ c) = _
    rw [hκ, hF, hδC]

  have hstr : ∀ (i : Fin (1 + 1)) (ψ : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i) →+* Polynomial K),
      (∀ c : K, ψ (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X i))
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0) c)) = Polynomial.C c) →
      (Spec.map (CommRingCat.ofHom ψ) ≫ Proj.awayι _ (MvPolynomial.X i) (hX i) one_pos) ≫
        wcProjKStr K 1 = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) := by
    intro i ψ hC
    show (Spec.map (CommRingCat.ofHom ψ) ≫ Proj.awayι _ (MvPolynomial.X i) (hX i) one_pos) ≫
      Proj.toSpecZero _ ≫ Spec.map (CommRingCat.ofHom
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0))) = _
    rw [Category.assoc, ← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero,
      ← Spec.map_comp, ← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    refine RingHom.ext fun c => ?_
    show ψ (HomogeneousLocalization.fromZeroRingHom _ _ (algebraMap K _ c)) =
      algebraMap K (Polynomial K) c
    rw [hC, Polynomial.algebraMap_eq]

  have hov : ∀ (i j : Fin (1 + 1)), i ≠ j → ∀ (ψ : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X i) →+* Polynomial K),
      (∀ (n : ℕ) (a : MvPolynomial (Fin (1 + 1)) K)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (n • 1)),
        ψ (HomogeneousLocalization.Away.mk _ (hX i) n a ha) = δ i a) →
      (Spec.map (CommRingCat.ofHom ψ) ≫ Proj.awayι _ (MvPolynomial.X i) (hX i) one_pos) ⁻¹'
        (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X j) :
          Set (Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K))) =
        {p | (Polynomial.X : Polynomial K) ∉ p.asIdeal} := by
    intro i j hij ψ hM
    have hψ : ψ (HomogeneousLocalization.Away.isLocalizationElem (hX i) (hX j)) =
        Polynomial.X := by
      rw [HomogeneousLocalization.Away.isLocalizationElem, hM]
      simp [δ, Ne.symm hij]
    ext p
    have e1 : ((Spec.map (CommRingCat.ofHom ψ) ≫ Proj.awayι _ (MvPolynomial.X i) (hX i) one_pos) p ∈
        (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X j) :
          Set (Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)))) ↔
        (Spec.map (CommRingCat.ofHom ψ) p ∈ Proj.awayι _ (MvPolynomial.X i) (hX i) one_pos ⁻¹ᵁ
          Proj.basicOpen _ (MvPolynomial.X j)) := by
      rw [Scheme.Hom.comp_apply]; rfl
    rw [Set.mem_preimage, e1, Proj.awayι_preimage_basicOpen _ (hX i) one_pos (hX j) one_pos]
    change _ ∉ Ideal.comap (CommRingCat.ofHom ψ).hom p.asIdeal ↔ _
    simp only [Ideal.mem_comap, CommRingCat.hom_ofHom, hψ, Set.mem_setOf_eq]
  obtain ⟨ψ0, hb0, hC0, hM0⟩ := chart 0
  obtain ⟨ψ1, hb1, hC1, hM1⟩ := chart 1
  haveI : IsIso (CommRingCat.ofHom ψ0) := by
    rw [ConcreteCategory.isIso_iff_bijective]; exact hb0
  haveI : IsIso (CommRingCat.ofHom ψ1) := by
    rw [ConcreteCategory.isIso_iff_bijective]; exact hb1
  have hs0 := hstr 0 ψ0 hC0
  have hs1 := hstr 1 ψ1 hC1
  have hr0 : Set.range (Spec.map (CommRingCat.ofHom ψ0) ≫
      Proj.awayι _ (MvPolynomial.X 0) (hX 0) one_pos) =
      (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0) :
        Set (Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K))) := by
    rw [← Scheme.Hom.coe_opensRange, Scheme.Hom.opensRange_comp_of_isIso, Proj.opensRange_awayι]
  have hr1 : Set.range (Spec.map (CommRingCat.ofHom ψ1) ≫
      Proj.awayι _ (MvPolynomial.X 1) (hX 1) one_pos) =
      (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 1) :
        Set (Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K))) := by
    rw [← Scheme.Hom.coe_opensRange, Scheme.Hom.opensRange_comp_of_isIso, Proj.opensRange_awayι]
  have hov10 := hov 1 0 (by decide) ψ1 hM1
  have hov01 := hov 0 1 (by decide) ψ0 hM0

  have hq : (Polynomial.X : Polynomial K) ∈ (Spec.map (CommRingCat.ofHom
      (Polynomial.evalRingHom (0 : K))) (IsLocalRing.closedPoint K)).asIdeal := by
    show (Polynomial.X : Polynomial K) ∈ (PrimeSpectrum.comap (CommRingCat.ofHom
      (Polynomial.evalRingHom (0 : K))).hom (IsLocalRing.closedPoint K)).asIdeal
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
    simp
  have hσnot : (Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : K))) ≫
      Spec.map (CommRingCat.ofHom ψ1) ≫ Proj.awayι _ (MvPolynomial.X 1) (hX 1) one_pos)
        (IsLocalRing.closedPoint K) ∉
      (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0) :
        Set (Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K))) := by
    intro h
    have h' : Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : K)))
        (IsLocalRing.closedPoint K) ∈ (Spec.map (CommRingCat.ofHom ψ1) ≫
          Proj.awayι _ (MvPolynomial.X 1) (hX 1) one_pos) ⁻¹'
        (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0) :
          Set (Proj (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K))) := h
    rw [hov10] at h'
    exact h' hq

  have htrans : Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K)
      (Localization.Away (Polynomial.X : Polynomial K)))) ≫
      (Spec.map (CommRingCat.ofHom ψ0) ≫ Proj.awayι _ (MvPolynomial.X 0) (hX 0) one_pos) =
      Spec.map (CommRingCat.ofHom (Polynomial.aeval (IsLocalization.Away.invSelf
        (Polynomial.X : Polynomial K) : Localization.Away (Polynomial.X : Polynomial K))).toRingHom) ≫
      (Spec.map (CommRingCat.ofHom ψ1) ≫ Proj.awayι _ (MvPolynomial.X 1) (hX 1) one_pos) := by
    let x : MvPolynomial (Fin (1 + 1)) K := MvPolynomial.X 0 * MvPolynomial.X 1
    let τ : Localization.Away (Polynomial.X : Polynomial K) :=
      algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K)) Polynomial.X
    have hτ : IsUnit τ := IsLocalization.Away.algebraMap_isUnit _
    let δ0' : MvPolynomial (Fin (1 + 1)) K →+* Localization.Away (Polynomial.X : Polynomial K) :=
      (algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K))).comp
        (δ 0).toRingHom
    have hδ'0 : δ0' (MvPolynomial.X 0) = 1 := by
      show algebraMap _ (Localization.Away (Polynomial.X : Polynomial K))
        (δ 0 (MvPolynomial.X 0)) = 1
      rw [hδ00, map_one]
    have hδ'1 : δ0' (MvPolynomial.X 1) = τ := by
      show algebraMap _ (Localization.Away (Polynomial.X : Polynomial K))
        (δ 0 (MvPolynomial.X 1)) = τ
      rw [hδ01]
    have hδ'x : δ0' x = τ := by
      show δ0' (MvPolynomial.X 0 * MvPolynomial.X 1) = τ
      rw [map_mul, hδ'0, hδ'1, one_mul]
    have hu : IsUnit (δ0' x) := by rw [hδ'x]; exact hτ
    let Lx := Localization.Away x
    let Λx : Lx →+* Localization.Away (Polynomial.X : Polynomial K) := IsLocalization.Away.lift x hu
    have hΛx : ∀ a, Λx (algebraMap _ Lx a) = δ0' a := fun a => IsLocalization.Away.lift_eq _ hu a
    let θ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) x →+*
        Localization.Away (Polynomial.X : Polynomial K) :=
      Λx.comp (algebraMap _ Lx)
    have hΘ : ∀ {dd : ℕ} (hxd : x ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K dd) (n : ℕ)
        (b : MvPolynomial (Fin (1 + 1)) K)
        (hb : b ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (n • dd)),
        θ (HomogeneousLocalization.Away.mk _ hxd n b hb) * τ ^ n = δ0' b := by
      intro dd hxd n b hb
      have hs := IsLocalization.mk'_spec Lx b (⟨x ^ n, n, rfl⟩ : Submonoid.powers x)
      have h2 := congrArg Λx hs
      rw [map_mul, hΛx, hΛx] at h2
      change Λx _ * δ0' (x ^ n) = δ0' b at h2
      rw [map_pow, hδ'x] at h2
      show Λx (algebraMap _ Lx _) * τ ^ n = _
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk'_apply]
      exact h2
    clear_value θ
    have hxa : x = MvPolynomial.X 0 * MvPolynomial.X 1 := rfl
    have hxb : x = MvPolynomial.X 1 * MvPolynomial.X 0 := mul_comm _ _
    have ha_eq : θ.comp (HomogeneousLocalization.awayMap _ (hX 1) hxa) =
        (algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K))).comp ψ0 := by
      refine RingHom.ext fun z => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX 0) z
      change θ (HomogeneousLocalization.awayMap _ (hX 1) hxa
          (HomogeneousLocalization.Away.mk _ (hX 0) n a ha)) =
        algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K))
          (ψ0 (HomogeneousLocalization.Away.mk _ (hX 0) n a ha))
      rw [HomogeneousLocalization.awayMap_mk, hM0]
      apply ((hτ.pow n).mul_left_inj).mp
      rw [hΘ, map_mul, map_pow, hδ'1]
      rfl
    have hb_eq : θ.comp (HomogeneousLocalization.awayMap _ (hX 0) hxb) =
        (Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
          Localization.Away (Polynomial.X : Polynomial K))).toRingHom.comp ψ1 := by
      refine RingHom.ext fun z => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hX 1) z
      change θ (HomogeneousLocalization.awayMap _ (hX 0) hxb
          (HomogeneousLocalization.Away.mk _ (hX 1) n a ha)) =
        (Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
          Localization.Away (Polynomial.X : Polynomial K)))
          (ψ1 (HomogeneousLocalization.Away.mk _ (hX 1) n a ha))
      rw [HomogeneousLocalization.awayMap_mk, hM1]
      apply ((hτ.pow n).mul_left_inj).mp
      have hahom : a.IsHomogeneous n := by
        rw [smul_eq_mul, mul_one] at ha
        exact (MvPolynomial.mem_homogeneousSubmodule _ _).mp ha
      have key := scaling (Localization.Away (Polynomial.X : Polynomial K))
        ((Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
          Localization.Away (Polynomial.X : Polynomial K))).toRingHom.comp (δ 1).toRingHom)
        δ0' τ ?_ ?_ n a hahom
      · rw [hΘ, map_mul, map_pow, hδ'0, one_pow, mul_one]
        exact key.symm
      · intro c
        show (Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
          Localization.Away (Polynomial.X : Polynomial K))) (δ 1 (MvPolynomial.C c)) =
          algebraMap _ (Localization.Away (Polynomial.X : Polynomial K)) (δ 0 (MvPolynomial.C c))
        rw [hδC, hδC, Polynomial.aeval_C,
          IsScalarTower.algebraMap_apply K (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K)),
          Polynomial.algebraMap_eq]
      · intro k
        fin_cases k
        · show (Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
            Localization.Away (Polynomial.X : Polynomial K))) (δ 1 (MvPolynomial.X 0)) * τ =
            δ0' (MvPolynomial.X 0)
          rw [hδ10, hδ'0, Polynomial.aeval_X, mul_comm]
          exact IsLocalization.Away.mul_invSelf _
        · show (Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
            Localization.Away (Polynomial.X : Polynomial K))) (δ 1 (MvPolynomial.X 1)) * τ =
            δ0' (MvPolynomial.X 1)
          rw [hδ11, hδ'1, map_one, one_mul]
    rw [← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, ← ha_eq, ← hb_eq,
      CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp,
      Category.assoc, Category.assoc, Proj.SpecMap_awayMap_awayι, Proj.SpecMap_awayMap_awayι]
  refine ⟨wcProjK K 1, wcProjKStr K 1,
    Spec.map (CommRingCat.ofHom ψ0) ≫ Proj.awayι _ (MvPolynomial.X 0) (hX 0) one_pos,
    Spec.map (CommRingCat.ofHom ψ1) ≫ Proj.awayι _ (MvPolynomial.X 1) (hX 1) one_pos,
    Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : K))) ≫
      Spec.map (CommRingCat.ofHom ψ1) ≫ Proj.awayι _ (MvPolynomial.X 1) (hX 1) one_pos,
    hproper, inferInstance, inferInstance, ?_, ?_, hs0, hs1, ?_, ?_, ⟨_, rfl⟩, ?_, ?_, htrans⟩
  · haveI : QuasiCompact ((Spec.map (CommRingCat.ofHom ψ0) ≫
        Proj.awayι _ (MvPolynomial.X 0) (hX 0) one_pos) ≫ wcProjKStr K 1) := by
      rw [hs0]; infer_instance
    exact QuasiCompact.of_comp _ (wcProjKStr K 1)
  · haveI : QuasiCompact ((Spec.map (CommRingCat.ofHom ψ1) ≫
        Proj.awayι _ (MvPolynomial.X 1) (hX 1) one_pos) ≫ wcProjKStr K 1) := by
      rw [hs1]; infer_instance
    exact QuasiCompact.of_comp _ (wcProjKStr K 1)
  · rw [Category.assoc, hs1, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have e : (Polynomial.evalRingHom (0 : K)).comp (algebraMap K (Polynomial K)) = RingHom.id K := by
      ext c; simp
    rw [e, CommRingCat.ofHom_id, Spec.map_id]
  · ext z
    rw [hr0, Set.mem_compl_iff, Set.mem_singleton_iff]
    constructor
    · intro hz
      apply huniq 1 z _
      · intro i hi
        have : i = 0 := Fin.ext (Nat.lt_one_iff.mp hi)
        subst this
        exact hz
      · intro i hi
        have : i = 0 := Fin.ext (Nat.lt_one_iff.mp hi)
        subst this
        exact hσnot
    · rintro rfl
      exact hσnot
  · rw [hr0]; exact hov10
  · rw [hr1]; exact hov01

theorem wc_cp_etale_line_smooth_one : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] [Algebra K R] [Algebra (Polynomial K) R] [IsScalarTower K (Polynomial K) R] [Algebra.Etale (Polynomial K) R], SmoothOfRelativeDimension 1 (Spec.map (CommRingCat.ofHom (algebraMap K R))) :=
by
  intro K _ R _ _ _ _ _
  haveI h1 : Algebra.IsStandardSmoothOfRelativeDimension 1 K (MvPolynomial Unit K) := by
    simpa using Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K Unit
  haveI hA : Algebra.IsStandardSmoothOfRelativeDimension 1 K (Polynomial K) :=
    Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 1 (MvPolynomial.uniqueAlgEquiv K Unit)
  haveI hB : Algebra.IsStandardSmoothOfRelativeDimension 0 (Polynomial K) R :=
    Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
  have hC : Algebra.IsStandardSmoothOfRelativeDimension (0 + 1) K R :=
    Algebra.IsStandardSmoothOfRelativeDimension.trans 1 0 K (Polynomial K) R
  rw [zero_add] at hC
  have hD := (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr hC
  have hE := RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _ hD
  exact HasRingHomProperty.Spec_iff.mpr (by simpa using hE)

theorem wc_sf_integralClosure_finite_of_embedding : ∀ (k : Type u) [Field k] [PerfectField k] (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A] (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K] (L : Type u) [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L] [FiniteDimensional K L] (B : Type u) [CommRing B] [Algebra A B] (ι : B →ₐ[A] L), Function.Injective ι → (∀ (k : Type u) [Field k] [PerfectField k] (D : Type u) [CommRing D] [IsDomain D] [Algebra k D] [Algebra.FiniteType k D], Module.Finite D (integralClosure D (FractionRing D))) → Module.Finite A (integralClosure A B) :=
by
  intro k _ _ A _ _ _ _ K _ _ _ L _ _ _ _ _ B _ _ ι hι hN
  classical
  haveI : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  have hinjAL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
  haveI : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.of_finite K L
  haveI : Algebra.IsAlgebraic A L :=
    ⟨fun x => (IsFractionRing.isAlgebraic_iff A K L).mpr (Algebra.IsAlgebraic.isAlgebraic x)⟩

  obtain ⟨D, hDfin, hDfrac⟩ : ∃ D : Subalgebra A L, Module.Finite A D ∧ IsFractionRing D L := by
    obtain ⟨T, hT⟩ := Module.Finite.fg_top (R := K) (M := L)
    obtain ⟨y, hy0, hyint⟩ := Algebra.IsAlgebraic.exists_integral_multiples A T
    refine ⟨Algebra.adjoin A ((T.image (fun t => y • t) : Finset L) : Set L), ?_, ?_⟩
    · apply Algebra.finite_adjoin_of_finite_of_isIntegral
      · exact Finset.finite_toSet _
      · intro x hx
        rw [Finset.mem_coe, Finset.mem_image] at hx
        obtain ⟨t, ht, rfl⟩ := hx
        exact hyint t ht
    · set D := Algebra.adjoin A ((T.image (fun t => y • t) : Finset L) : Set L) with hD
      have P : ∀ z : L, ∃ a : A, a ≠ 0 ∧ algebraMap A L a * z ∈ D := by
        intro z
        have hz : z ∈ Submodule.span K (T : Set L) := by rw [hT]; exact Submodule.mem_top
        induction hz using Submodule.span_induction with
        | mem t ht =>
          refine ⟨y, hy0, ?_⟩
          rw [← Algebra.smul_def]
          apply Algebra.subset_adjoin
          rw [Finset.mem_coe, Finset.mem_image]
          exact ⟨t, ht, rfl⟩
        | zero => exact ⟨1, one_ne_zero, by rw [mul_zero]; exact D.zero_mem⟩
        | add x z _ _ hx hz =>
          obtain ⟨a₁, ha₁, h₁⟩ := hx
          obtain ⟨a₂, ha₂, h₂⟩ := hz
          refine ⟨a₁ * a₂, mul_ne_zero ha₁ ha₂, ?_⟩
          have e : algebraMap A L (a₁ * a₂) * (x + z) = algebraMap A L a₂ * (algebraMap A L a₁ * x)
              + algebraMap A L a₁ * (algebraMap A L a₂ * z) := by
            rw [map_mul]; ring
          rw [e]
          exact D.add_mem (D.mul_mem (D.algebraMap_mem a₂) h₁) (D.mul_mem (D.algebraMap_mem a₁) h₂)
        | smul c x _ hx =>
          obtain ⟨a, ha, h⟩ := hx
          obtain ⟨p, q, hq, hc⟩ := IsFractionRing.div_surjective (A := A) c
          have hq0 : q ≠ 0 := nonZeroDivisors.ne_zero hq
          have hqK : algebraMap A K q ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hq
          have hqc : algebraMap A K q * c = algebraMap A K p := by
            rw [← hc]; field_simp
          refine ⟨q * a, mul_ne_zero hq0 ha, ?_⟩
          have e : algebraMap A L (q * a) * (c • x) = algebraMap A L p * (algebraMap A L a * x) := by
            simp only [Algebra.smul_def, map_mul, IsScalarTower.algebraMap_apply A K L]
            rw [← hqc, map_mul]; ring
          rw [e]
          exact D.mul_mem (D.algebraMap_mem p) h
      apply IsFractionRing.of_field
      intro z
      obtain ⟨a, ha, hmem⟩ := P z
      have ha' : algebraMap A L a ≠ 0 := fun h => ha (hinjAL (h.trans (map_zero _).symm))
      refine ⟨⟨_, hmem⟩, algebraMap A D a, ?_⟩
      have e1 : algebraMap D L (algebraMap A D a) = algebraMap A L a := rfl
      have e2 : algebraMap D L ⟨_, hmem⟩ = algebraMap A L a * z := rfl
      rw [e1, e2]
      field_simp

  letI : Algebra k D := ((algebraMap A D).comp (algebraMap k A)).toAlgebra
  haveI : IsScalarTower k A D := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI := hDfin
  haveI := hDfrac
  haveI : Algebra.FiniteType A D := Module.Finite.finiteType D
  haveI : Algebra.FiniteType k D := Algebra.FiniteType.trans (S := A) inferInstance inferInstance
  have h1 := hN k D

  have h2 : Module.Finite D (integralClosure D L) := by
    let e : FractionRing D ≃ₐ[D] L := IsLocalization.algEquiv (nonZeroDivisors D) (FractionRing D) L
    have hmap := integralClosure_map_algEquiv (R := D) e
    exact Module.Finite.equiv
      ((e.subalgebraMap (integralClosure D (FractionRing D))).trans
        (Subalgebra.equivOfEq _ _ hmap)).toLinearEquiv

  haveI : Module.Finite A (integralClosure D L) := Module.Finite.trans D (integralClosure D L)
  haveI : IsNoetherian A (integralClosure D L) := isNoetherian_of_isNoetherianRing_of_finite A _
  let f : integralClosure A B →ₗ[A] integralClosure D L :=
    { toFun := fun x => ⟨ι x, (x.2.map ι).tower_top⟩
      map_add' := fun x y => Subtype.ext (map_add ι _ _)
      map_smul' := fun a x => Subtype.ext (by
        show ι (a • (x : B)) = a • ι x
        exact map_smul ι a (x : B)) }
  have hf : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    apply hι
    exact congrArg Subtype.val hxy
  exact Module.Finite.of_injective f hf

theorem wc_cp_integral_closure_infinity_finite : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : Type u) [CommRing R] [_root_.IsReduced R] [Algebra K R] (ψ : Polynomial K →ₐ[K] R), ψ.toRingHom.Finite → (∀ a : Polynomial K, a ≠ 0 → ψ a ∈ nonZeroDivisors R) → letI : Algebra (Polynomial K) (Localization.Away (ψ Polynomial.X)) := (Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) : Localization.Away (ψ Polynomial.X))).toRingHom.toAlgebra; Module.Finite (Polynomial K) (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) :=
by
  intro K _ _ R _ _ _ ψ hfin hnzd
  classical

  have s3 : ∀ (A : Type u) [CommRing A] [IsDomain A] (D : Type u) [CommRing D] [IsDomain D]
      [Algebra A D] (F : Type u) [Field F] [Algebra A F] [IsFractionRing A F] (L : Type u) [Field L]
      [Algebra D L] [IsFractionRing D L] [Algebra A L] [Algebra F L] [IsScalarTower A D L]
      [IsScalarTower A F L] (y : A), y ≠ 0 → ∀ (T : Set D), T.Finite →
      (∀ x : D, ∃ n : ℕ, y ^ n • x ∈ Submodule.span A T) → FiniteDimensional F L := by
    intro A _ _ D _ _ _ F _ _ _ L _ _ _ _ _ _ _ y hy T hTfin hT
    let V : Submodule F L := Submodule.span F ((algebraMap D L) '' T)
    have hyF : algebraMap A F y ≠ 0 := fun h =>
      hy (IsFractionRing.injective A F (by rw [h, map_zero]))
    have ha : ∀ x : D, algebraMap D L x ∈ V := by
      intro x
      obtain ⟨n, hn⟩ := hT x
      have h1 := Submodule.mem_map_of_mem (f := (IsScalarTower.toAlgHom A D L).toLinearMap) hn
      rw [Submodule.map_span, map_smul] at h1
      have h2 : y ^ n • algebraMap D L x ∈ V := Submodule.span_le_restrictScalars A F _ h1
      have h3 : y ^ n • algebraMap D L x = (algebraMap A F y ^ n) • algebraMap D L x := by
        rw [Algebra.smul_def, Algebra.smul_def, ← map_pow, ← IsScalarTower.algebraMap_apply]
      rw [h3] at h2
      have := V.smul_mem ((algebraMap A F y ^ n)⁻¹) h2
      rwa [smul_smul, inv_mul_cancel₀ (pow_ne_zero _ hyF), one_smul] at this
    let W : Subalgebra F L := Algebra.adjoin F (Set.range (algebraMap D L))
    have hWV : Subalgebra.toSubmodule W ≤ V := by
      rw [Algebra.adjoin_eq_span]
      apply Submodule.span_le.mpr
      intro z hz
      have : z ∈ (algebraMap D L).rangeS.toSubmonoid := by
        refine (Submonoid.closure_le.mpr ?_) hz
        rintro _ ⟨x, rfl⟩
        exact ⟨x, rfl⟩
      obtain ⟨x, rfl⟩ := this
      exact ha x
    have hVfg : V.FG := Submodule.fg_span (hTfin.image _)
    have hWfg : (Subalgebra.toSubmodule W).FG := by
      have : Module.Finite F V := Module.Finite.iff_fg.mpr hVfg
      have : Module.Finite F (Subalgebra.toSubmodule W) := Submodule.finiteDimensional_of_le hWV
      exact Module.Finite.iff_fg.mp inferInstance
    have hWtop : ∀ l : L, l ∈ W := by
      intro l
      obtain ⟨d1, d2, _, rfl⟩ := IsFractionRing.div_surjective D l
      have hd2W : algebraMap D L d2 ∈ W := Algebra.subset_adjoin ⟨d2, rfl⟩
      have hint : IsIntegral F (algebraMap D L d2) := IsIntegral.of_mem_of_fg W hWfg _ hd2W
      have hinv := Subalgebra.inv_mem_of_algebraic W (x := ⟨_, hd2W⟩) hint.isAlgebraic
      rw [div_eq_mul_inv]
      exact W.mul_mem (Algebra.subset_adjoin ⟨d1, rfl⟩) hinv
    have htop : V = ⊤ := eq_top_iff.mpr (fun l _ => hWV (hWtop l))
    exact ⟨htop ▸ hVfg⟩

  have s6 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (B : Type u) [CommRing B]
      [_root_.IsReduced B] [IsNoetherianRing B] [Algebra A B],
      (∀ q ∈ minimalPrimes B, Module.Finite A (integralClosure A (B ⧸ q))) →
      Module.Finite A (integralClosure A B) := by
    intro A _ _ B _ _ _ _ hq
    let ι := {q : Ideal B // q ∈ minimalPrimes B}
    have : Finite ι := (minimalPrimes.finite_of_isNoetherianRing B).to_subtype
    have : ∀ q : ι, Module.Finite A (integralClosure A (B ⧸ q.1)) := fun q => hq q.1 q.2
    let j : integralClosure A B →ₗ[A] ((q : ι) → integralClosure A (B ⧸ q.1)) :=
      { toFun := fun x q => ⟨Ideal.Quotient.mkₐ A q.1 x, x.2.map (Ideal.Quotient.mkₐ A q.1)⟩
        map_add' := fun x y => by
          funext q
          apply Subtype.ext
          simp
        map_smul' := fun c x => by
          funext q
          apply Subtype.ext
          simp }
    refine Module.Finite.of_injective j ?_
    rw [injective_iff_map_eq_zero]
    intro x hx
    have hmem : ∀ q ∈ minimalPrimes B, (x : B) ∈ q := by
      intro q hq'
      have := congrArg (fun f => ((f ⟨q, hq'⟩ : integralClosure A (B ⧸ q)) : B ⧸ q)) hx
      simp only [j, LinearMap.coe_mk, AddHom.coe_mk, Pi.zero_apply, ZeroMemClass.coe_zero] at this
      exact (Ideal.Quotient.eq_zero_iff_mem).mp this
    have hrad : (x : B) ∈ (⊥ : Ideal B).radical := by
      rw [← Ideal.sInf_minimalPrimes]
      exact Submodule.mem_sInf.mpr hmem
    obtain ⟨n, hn⟩ := hrad
    have hnil : IsNilpotent (x : B) := ⟨n, by simpa using hn⟩
    exact Subtype.ext hnil.eq_zero

  generalize hg : ψ Polynomial.X = g
  obtain ⟨algInst, hinst⟩ : ∃ inst : Algebra (Polynomial K) (Localization.Away g),
      inst = (Polynomial.aeval (IsLocalization.Away.invSelf g :
        Localization.Away g)).toRingHom.toAlgebra := ⟨_, rfl⟩
  rw [← hinst]
  have hψ0 : ∀ p : Polynomial K, ψ p = Polynomial.aeval g p := by
    intro p
    rw [← hg, Polynomial.aeval_algHom_apply, Polynomial.aeval_X_left_apply]
  obtain ⟨u, hu⟩ : ∃ u : Localization.Away g, u = IsLocalization.Away.invSelf g := ⟨_, rfl⟩
  obtain ⟨gb, hgb⟩ : ∃ gb : Localization.Away g, gb = algebraMap R (Localization.Away g) g :=
    ⟨_, rfl⟩
  have hgu : gb * u = 1 := by rw [hu, hgb]; exact IsLocalization.Away.mul_invSelf g
  have halg : ∀ p : Polynomial K,
      algebraMap (Polynomial K) (Localization.Away g) p = Polynomial.aeval u p := by
    intro p; subst hinst; rw [hu]; rfl
  have hψ : ∀ p : Polynomial K,
      algebraMap R (Localization.Away g) (ψ p) = Polynomial.aeval gb p := by
    intro p
    rw [hψ0, hgb, Polynomial.aeval_algebraMap_apply]
  have revA : ∀ (N : ℕ) (f : Polynomial K), f.natDegree ≤ N →
      Polynomial.aeval u (Polynomial.reflect N f) * gb ^ N = Polynomial.aeval gb f := by
    intro N f hf
    letI : Invertible gb := ⟨u, by rw [mul_comm]; exact hgu, hgu⟩
    have := Polynomial.eval₂_reflect_mul_pow (algebraMap K (Localization.Away g)) gb N f hf
    rw [Polynomial.aeval_def, Polynomial.aeval_def]
    exact this
  have revB : ∀ (N : ℕ) (f : Polynomial K), f.natDegree ≤ N →
      Polynomial.aeval gb (Polynomial.reflect N f) * u ^ N = Polynomial.aeval u f := by
    intro N f hf
    letI : Invertible u := ⟨gb, hgu, by rw [mul_comm]; exact hgu⟩
    have := Polynomial.eval₂_reflect_mul_pow (algebraMap K (Localization.Away g)) u N f hf
    rw [Polynomial.aeval_def, Polynomial.aeval_def]
    exact this

  have s1 : ∀ a : Polynomial K, a ≠ 0 →
      algebraMap (Polynomial K) (Localization.Away g) a ∈ nonZeroDivisors (Localization.Away g) := by
    intro a ha
    rw [halg, ← revB a.natDegree a le_rfl, ← hψ]
    refine mul_mem_nonZeroDivisors.mpr ⟨?_, ?_⟩
    · apply IsLocalization.map_nonZeroDivisors_le (Submonoid.powers g) (Localization.Away g)
      refine Submonoid.mem_map_of_mem _ ?_
      apply hnzd
      intro h0
      have hc := congrArg (fun p => Polynomial.coeff p 0) h0
      simp only [Polynomial.coeff_reflect, Polynomial.coeff_zero] at hc
      rw [Polynomial.revAt_le (Nat.zero_le _), Nat.sub_zero] at hc
      exact ha (Polynomial.leadingCoeff_eq_zero.mp hc)
    · have hu' : IsUnit u := isUnit_iff_exists.mpr ⟨gb, by rw [mul_comm]; exact hgu, hgu⟩
      exact (hu'.pow _).mem_nonZeroDivisors

  have hRnoeth : IsNoetherianRing R := by
    letI : Algebra (Polynomial K) R := ψ.toRingHom.toAlgebra
    haveI : Module.Finite (Polynomial K) R := hfin
    exact IsNoetherianRing.of_finite (Polynomial K) R
  haveI : IsNoetherianRing (Localization.Away g) :=
    IsLocalization.isNoetherianRing (Submonoid.powers g) _ hRnoeth
  obtain ⟨m, r, hr⟩ : ∃ (m : ℕ) (r : Fin m → R),
      ∀ x : R, ∃ c : Fin m → Polynomial K, ∑ i, ψ (c i) * r i = x := by
    letI : Algebra (Polynomial K) R := ψ.toRingHom.toAlgebra
    haveI : Module.Finite (Polynomial K) R := hfin
    obtain ⟨m, r, hr⟩ := Module.Finite.exists_fin (R := Polynomial K) (M := R)
    refine ⟨m, r, fun x => ?_⟩
    have hx : x ∈ Submodule.span (Polynomial K) (Set.range r) := by rw [hr]; trivial
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun (Polynomial K)).mp hx
    exact ⟨c, hc⟩
  have s2 : ∀ z : Localization.Away g, ∃ n : ℕ, (Polynomial.X : Polynomial K) ^ n • z ∈
      Submodule.span (Polynomial K)
        (Set.range (fun i => algebraMap R (Localization.Away g) (r i))) := by
    intro z
    obtain ⟨⟨a, ⟨_, k, rfl⟩⟩, hz⟩ := IsLocalization.surj (Submonoid.powers g) z
    have hz2 : z * algebraMap R (Localization.Away g) (g ^ k) =
        algebraMap R (Localization.Away g) a := hz
    obtain ⟨c, rfl⟩ := hr a
    refine ⟨∑ i, (c i).natDegree, ?_⟩
    have hz' : z = algebraMap R (Localization.Away g) (∑ i, ψ (c i) * r i) * u ^ k := by
      calc z = z * (gb * u) ^ k := by rw [hgu, one_pow, mul_one]
        _ = (z * algebraMap R (Localization.Away g) (g ^ k)) * u ^ k := by
          rw [map_pow, ← hgb]; ring
        _ = _ := by rw [hz2]
    rw [hz', Algebra.smul_def, halg, map_pow, Polynomial.aeval_X, map_sum, Finset.sum_mul,
      Finset.mul_sum]
    refine Submodule.sum_mem _ (fun i _ => ?_)
    have hdeg : (c i).natDegree ≤ ∑ j, (c j).natDegree :=
      Finset.single_le_sum (f := fun j => (c j).natDegree) (fun j _ => Nat.zero_le _)
        (Finset.mem_univ i)
    have hpow : u ^ (∑ j, (c j).natDegree) * gb ^ (∑ j, (c j).natDegree) = 1 := by
      rw [← mul_pow, mul_comm, hgu, one_pow]
    have key : u ^ (∑ j, (c j).natDegree) *
        (algebraMap R (Localization.Away g) (ψ (c i) * r i) * u ^ k) =
        (Polynomial.X ^ k * Polynomial.reflect (∑ j, (c j).natDegree) (c i)) •
          algebraMap R (Localization.Away g) (r i) := by
      rw [Algebra.smul_def, halg, map_mul, map_mul, map_pow, Polynomial.aeval_X, hψ,
        ← revA _ _ hdeg]
      linear_combination (Polynomial.aeval u (Polynomial.reflect (∑ j, (c j).natDegree) (c i)) *
        algebraMap R (Localization.Away g) (r i) * u ^ k) * hpow
    rw [key]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

  apply s6 (Polynomial K) (Localization.Away g)
  intro q hq
  haveI : q.IsPrime := Ideal.minimalPrimes_isPrime hq
  have hinj : Function.Injective (algebraMap (Polynomial K) (Localization.Away g ⧸ q)) := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra ha0
    rw [IsScalarTower.algebraMap_apply (Polynomial K) (Localization.Away g)
      (Localization.Away g ⧸ q), Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem] at ha
    exact Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hq) ha
      (s1 a ha0)
  have hT : ∀ x : Localization.Away g ⧸ q, ∃ n : ℕ, (Polynomial.X : Polynomial K) ^ n • x ∈
      Submodule.span (Polynomial K)
        (Set.range (fun i => Ideal.Quotient.mk q (algebraMap R (Localization.Away g) (r i)))) := by
    intro x
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨n, hn⟩ := s2 z
    refine ⟨n, ?_⟩
    have := Submodule.mem_map_of_mem (f := (Ideal.Quotient.mkₐ (Polynomial K) q).toLinearMap) hn
    rw [Submodule.map_span, map_smul, ← Set.range_comp] at this
    exact this
  haveI : FaithfulSMul (Polynomial K) (FractionRing (Localization.Away g ⧸ q)) := by
    rw [faithfulSMul_iff_algebraMap_injective, IsScalarTower.algebraMap_eq (Polynomial K)
      (Localization.Away g ⧸ q) (FractionRing (Localization.Away g ⧸ q))]
    exact (IsFractionRing.injective (Localization.Away g ⧸ q)
      (FractionRing (Localization.Away g ⧸ q))).comp hinj
  letI := FractionRing.liftAlgebra (Polynomial K) (FractionRing (Localization.Away g ⧸ q))
  haveI := FractionRing.isScalarTower_liftAlgebra (Polynomial K)
    (FractionRing (Localization.Away g ⧸ q))
  haveI hfd : FiniteDimensional (FractionRing (Polynomial K))
      (FractionRing (Localization.Away g ⧸ q)) :=
    s3 (Polynomial K) (Localization.Away g ⧸ q) (FractionRing (Polynomial K))
      (FractionRing (Localization.Away g ⧸ q)) Polynomial.X Polynomial.X_ne_zero _
      (Set.finite_range _) hT
  exact wc_sf_integralClosure_finite_of_embedding K (Polynomial K) (FractionRing (Polynomial K))
    (FractionRing (Localization.Away g ⧸ q)) (Localization.Away g ⧸ q)
    (IsScalarTower.toAlgHom (Polynomial K) _ _) (IsFractionRing.injective _ _)
    noether_integralClosure_finite

theorem wc_cpic_localization_structure : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] [Algebra K R] (ψ : Polynomial K →ₐ[K] R), ψ.toRingHom.Finite → letI : Algebra (Polynomial K) (Localization.Away (ψ Polynomial.X)) := (Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) : Localization.Away (ψ Polynomial.X))).toRingHom.toAlgebra; IsLocalization.Away (algebraMap (Polynomial K) (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) Polynomial.X) (Localization.Away (ψ Polynomial.X)) ∧ algebraMap (Polynomial K) (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) Polynomial.X ∈ nonZeroDivisors (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) ∧ ∀ r : Localization.Away (ψ Polynomial.X), IsIntegral (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) r → ∃ b : integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X)), algebraMap (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) (Localization.Away (ψ Polynomial.X)) b = r :=
by
  intro K _ R _ _ ψ hψ
  letI : Algebra (Polynomial K) (Localization.Away (ψ Polynomial.X)) :=
    (Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) :
      Localization.Away (ψ Polynomial.X))).toRingHom.toAlgebra
  classical

  have s1 : ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C] (t : A),
      IsUnit (algebraMap A C t) → (∀ c : C, ∃ e : ℕ, IsIntegral A (c * algebraMap A C t ^ e)) →
      IsLocalization.Away (algebraMap A (integralClosure A C) t) C ∧
      algebraMap A (integralClosure A C) t ∈ nonZeroDivisors (integralClosure A C) ∧
      ∀ r : C, IsIntegral (integralClosure A C) r →
        ∃ b : integralClosure A C, algebraMap (integralClosure A C) C b = r := by
    intro A C _ _ _ t hu hint
    have hinj : Function.Injective (algebraMap (integralClosure A C) C) := Subtype.val_injective
    have hyC : algebraMap (integralClosure A C) C (algebraMap A (integralClosure A C) t) =
        algebraMap A C t :=
      (IsScalarTower.algebraMap_apply A (integralClosure A C) C t).symm
    refine ⟨?_, ?_, ?_⟩
    · constructor
      constructor
      · rintro ⟨_, n, rfl⟩
        show IsUnit (algebraMap (integralClosure A C) C (algebraMap A (integralClosure A C) t ^ n))
        rw [map_pow, hyC]
        exact hu.pow n
      · intro c
        obtain ⟨e, he⟩ := hint c
        refine ⟨⟨⟨c * algebraMap A C t ^ e, (mem_integralClosure_iff A C).mpr he⟩,
          ⟨algebraMap A (integralClosure A C) t ^ e, e, rfl⟩⟩, ?_⟩
        show c * algebraMap (integralClosure A C) C (algebraMap A (integralClosure A C) t ^ e) =
          c * algebraMap A C t ^ e
        rw [map_pow, hyC]
      · intro b₁ b₂ h
        exact ⟨1, by rw [hinj h]⟩
    · rw [mem_nonZeroDivisors_iff_right]
      intro b hb
      apply hinj
      have h := congrArg (algebraMap (integralClosure A C) C) hb
      rw [map_mul, hyC, map_zero] at h
      rw [map_zero]
      exact hu.mul_left_eq_zero.mp h
    · intro r hr
      exact ⟨⟨r, (mem_integralClosure_iff A C).mpr (isIntegral_trans r hr)⟩, rfl⟩

  have s4 : ∀ (C : Type u) [CommRing C] [Algebra R C] [Algebra (Polynomial K) C],
      algebraMap (Polynomial K) C Polynomial.X * algebraMap R C (ψ Polynomial.X) = 1 →
      (∀ k : K, algebraMap (Polynomial K) C (Polynomial.C k) =
        algebraMap R C (ψ (Polynomial.C k))) →
      (∀ c : C, ∃ (n : ℕ) (a : R), c * algebraMap R C (ψ Polynomial.X) ^ n = algebraMap R C a) →
      ∀ c : C, ∃ e : ℕ, IsIntegral (Polynomial K) (c * algebraMap (Polynomial K) C Polynomial.X ^ e) := by
    intro C _ _ _ hunit hC hsurj c
    let f : Polynomial K →+* C := (algebraMap R C).comp ψ.toRingHom
    have hfX : f Polynomial.X = algebraMap R C (ψ Polynomial.X) := rfl
    have hfC : ∀ k : K, f (Polynomial.C k) = algebraMap (Polynomial K) C (Polynomial.C k) :=
      fun k => (hC k).symm

    have key2 : ∀ (e : ℕ) (a : Polynomial K), a.natDegree ≤ e →
        ∃ g : Polynomial K, algebraMap (Polynomial K) C g =
          f a * algebraMap (Polynomial K) C Polynomial.X ^ e := by
      intro e a ha
      have hmem : f a * algebraMap (Polynomial K) C Polynomial.X ^ e ∈
          (algebraMap (Polynomial K) C).range := by
        rw [Polynomial.as_sum_range' a (e + 1) (by omega), map_sum, Finset.sum_mul]
        refine Subring.sum_mem _ (fun i hi => ?_)
        have hi' : i ≤ e := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hi'
        refine RingHom.mem_range.mpr ⟨Polynomial.C (a.coeff i) * Polynomial.X ^ j, ?_⟩
        rw [← Polynomial.C_mul_X_pow_eq_monomial]
        simp only [map_mul, map_pow, hfX, hfC]
        rw [show algebraMap (Polynomial K) C (Polynomial.C (a.coeff i)) *
              algebraMap R C (ψ Polynomial.X) ^ i *
              algebraMap (Polynomial K) C Polynomial.X ^ (i + j) =
            algebraMap (Polynomial K) C (Polynomial.C (a.coeff i)) *
              (algebraMap (Polynomial K) C Polynomial.X * algebraMap R C (ψ Polynomial.X)) ^ i *
              algebraMap (Polynomial K) C Polynomial.X ^ j by ring, hunit, one_pow, mul_one]
      obtain ⟨g, hg⟩ := RingHom.mem_range.mp hmem
      exact ⟨g, hg⟩
    rcases subsingleton_or_nontrivial C with hCs | hCn
    · refine ⟨0, ?_⟩
      rw [Subsingleton.elim (c * algebraMap (Polynomial K) C Polynomial.X ^ 0)
        (algebraMap (Polynomial K) C 0)]
      exact isIntegral_algebraMap
    obtain ⟨n, a, hca⟩ := hsurj c
    obtain ⟨p, hpm, hp⟩ := hψ.to_isIntegral a
    set ι := algebraMap (Polynomial K) C Polynomial.X with hι
    set E := (Finset.range (p.natDegree + 1)).sup (fun i => (p.coeff i).natDegree) with hE
    have hEle : ∀ i, i < p.natDegree → (p.coeff i).natDegree ≤ E := fun i hi =>
      Finset.le_sup (f := fun i => (p.coeff i).natDegree) (Finset.mem_range.mpr (by omega))
    set P : Polynomial C := p.map f with hP
    set b : C := algebraMap R C a with hb
    have hPm : P.Monic := hpm.map f
    have hPdeg : P.natDegree = p.natDegree := hpm.natDegree_map f
    have hPb : P.eval b = 0 := by
      rw [hP, Polynomial.eval_map, hb, show f = (algebraMap R C).comp ψ.toRingHom from rfl,
        ← Polynomial.hom_eval₂, hp, map_zero]
    set v : C := ι ^ E with hv
    set Q : Polynomial C := P.scaleRoots v with hQ
    have hQm : Q.Monic := (Polynomial.monic_scaleRoots_iff v).mpr hPm
    have hQroot : Q.eval (v * b) = 0 := by
      have := Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id C) (r := b) (s := v) hPb
      simpa using this
    have hQlift : Q ∈ Polynomial.lifts (algebraMap (Polynomial K) C) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [hQ, Polynomial.coeff_scaleRoots]
      rcases lt_trichotomy i P.natDegree with hi | hi | hi
      · rw [hP, Polynomial.coeff_map]
        rw [hPdeg] at hi
        rw [← hP, hPdeg]
        obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_lt hi
        rw [show p.natDegree - i = m + 1 by omega]
        obtain ⟨g, hg⟩ := key2 E (p.coeff i) (hEle i hi)
        refine ⟨g * Polynomial.X ^ (E * m), ?_⟩
        rw [map_mul, hg, map_pow, ← hι, hv, pow_succ, pow_mul]
        ring
      · rw [hi, hPm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one]
        exact ⟨1, map_one _⟩
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hi, zero_mul]
        exact ⟨0, map_zero _⟩
    obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hQlift hQm
    have hvb : IsIntegral (Polynomial K) (v * b) := by
      refine ⟨q, hqm, ?_⟩
      rw [← Polynomial.eval_map, hqmap, hQroot]
    refine ⟨E, ?_⟩
    have hc : c * ι ^ E = (v * b) * ι ^ n := by
      rw [hv, show b = c * algebraMap R C (ψ Polynomial.X) ^ n from hca.symm]
      rw [show ι ^ E * (c * algebraMap R C (ψ Polynomial.X) ^ n) * ι ^ n =
          c * ι ^ E * (ι * algebraMap R C (ψ Polynomial.X)) ^ n by ring, hunit, one_pow, mul_one]
    rw [hc]
    exact hvb.mul (isIntegral_algebraMap.pow n)

  have h1 : algebraMap (Polynomial K) (Localization.Away (ψ Polynomial.X)) Polynomial.X *
      algebraMap R (Localization.Away (ψ Polynomial.X)) (ψ Polynomial.X) = 1 := by
    rw [mul_comm]
    change _ * Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) :
      Localization.Away (ψ Polynomial.X)) Polynomial.X = 1
    rw [Polynomial.aeval_X]
    exact IsLocalization.Away.mul_invSelf _
  have h2 : ∀ k : K, algebraMap (Polynomial K) (Localization.Away (ψ Polynomial.X)) (Polynomial.C k) =
      algebraMap R (Localization.Away (ψ Polynomial.X)) (ψ (Polynomial.C k)) := by
    intro k
    change Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) :
      Localization.Away (ψ Polynomial.X)) (Polynomial.C k) = _
    rw [Polynomial.aeval_C]
    have hψC : ψ (Polynomial.C k) = algebraMap K R k := by
      simpa using ψ.commutes k
    rw [hψC, ← IsScalarTower.algebraMap_apply]
  have h3 : ∀ c : Localization.Away (ψ Polynomial.X), ∃ (n : ℕ) (a : R),
      c * algebraMap R (Localization.Away (ψ Polynomial.X)) (ψ Polynomial.X) ^ n =
        algebraMap R (Localization.Away (ψ Polynomial.X)) a :=
    fun c => IsLocalization.Away.surj (ψ Polynomial.X) c
  have hunit : IsUnit (algebraMap (Polynomial K) (Localization.Away (ψ Polynomial.X)) Polynomial.X) :=
    ⟨⟨_, _, h1, by rw [mul_comm]; exact h1⟩, rfl⟩
  exact s1 _ _ _ hunit (s4 _ h1 h2 h3)

theorem wc_cpic_stalk_smooth_data : ∀ (K S : Type u) [Field K] [PerfectField K] [CommRing S] [Algebra K S] [Algebra.FiniteType K S] (n : ℕ), (∀ Q : Ideal S, Q.IsPrime → ∃ s : S, s ∉ Q ∧ Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away s)) → ∀ (P : Ideal S) [P.IsPrime], Algebra.FormallySmooth K (Localization.AtPrime P) ∧ Module.Free (Localization.AtPrime P) Ω[Localization.AtPrime P⁄K] ∧ Module.Finite (Localization.AtPrime P) Ω[Localization.AtPrime P⁄K] ∧ Module.finrank (Localization.AtPrime P) Ω[Localization.AtPrime P⁄K] = n ∧ Algebra.FormallySmooth K (IsLocalRing.ResidueField (Localization.AtPrime P)) :=
by
  intro K S _ _ _ _ _ n h P _
  have h5 : Algebra.FormallySmooth K (IsLocalRing.ResidueField (Localization.AtPrime P)) := by
    haveI : Algebra.EssFiniteType K S := Algebra.EssFiniteType.of_finiteType K S
    haveI : Algebra.EssFiniteType K (Localization.AtPrime P) :=
      Algebra.EssFiniteType.comp K S (Localization.AtPrime P)
    haveI : Algebra.EssFiniteType K (IsLocalRing.ResidueField (Localization.AtPrime P)) :=
      Algebra.EssFiniteType.comp K (Localization.AtPrime P) _
    exact Algebra.FormallySmooth.of_perfectField
  obtain ⟨s, hsP, hs⟩ := h P ‹_›
  haveI := hs
  haveI : Algebra.IsStandardSmooth K (Localization.Away s) :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
  haveI : Algebra.FormallySmooth K (Localization.Away s) := Algebra.Smooth.formallySmooth
  haveI : Module.Free (Localization.Away s) Ω[Localization.Away s⁄K] :=
    Algebra.IsStandardSmooth.free_kaehlerDifferential
  haveI : Algebra.FinitePresentation K (Localization.Away s) :=
    Algebra.IsStandardSmooth.finitePresentation
  haveI : Algebra.EssFiniteType K (Localization.Away s) :=
    Algebra.EssFiniteType.of_finiteType K (Localization.Away s)
  haveI : Module.Finite (Localization.Away s) Ω[Localization.Away s⁄K] :=
    KaehlerDifferential.finite K (Localization.Away s)
  have hle : Submonoid.powers s ≤ P.primeCompl := by
    rintro _ ⟨k, rfl⟩ hk
    exact hsP (‹P.IsPrime›.mem_of_pow_mem k hk)
  letI : Algebra (Localization.Away s) (Localization.AtPrime P) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe (Localization.Away s) (Localization.AtPrime P)
      (Submonoid.powers s) P.primeCompl hle
  haveI : IsScalarTower S (Localization.Away s) (Localization.AtPrime P) :=
    IsLocalization.localization_isScalarTower_of_submonoid_le _ _ _ _ hle
  haveI : IsLocalization (Submonoid.map (algebraMap S (Localization.Away s)) P.primeCompl)
      (Localization.AtPrime P) :=
    IsLocalization.isLocalization_of_submonoid_le _ _ _ _ hle
  haveI : IsScalarTower K (Localization.Away s) (Localization.AtPrime P) :=
    IsScalarTower.of_algebraMap_eq (fun x => by
      rw [IsScalarTower.algebraMap_apply K S (Localization.AtPrime P),
        IsScalarTower.algebraMap_apply S (Localization.Away s) (Localization.AtPrime P),
        ← IsScalarTower.algebraMap_apply K S (Localization.Away s)])
  haveI : Nontrivial (Localization.Away s) :=
    RingHom.domain_nontrivial (algebraMap (Localization.Away s) (Localization.AtPrime P))
  haveI : Algebra.FormallyEtale (Localization.Away s) (Localization.AtPrime P) :=
    Algebra.FormallyEtale.of_isLocalization
      (Submonoid.map (algebraMap S (Localization.Away s)) P.primeCompl)
  have hrk : Module.finrank (Localization.Away s) Ω[Localization.Away s⁄K] = n :=
    Module.finrank_eq_of_rank_eq
      (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential n)
  let e := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K (Localization.Away s)
    (Localization.AtPrime P)
  refine ⟨Algebra.FormallySmooth.comp K (Localization.Away s) (Localization.AtPrime P),
    Module.Free.of_equiv e, Module.Finite.equiv e, ?_, h5⟩
  rw [← LinearEquiv.finrank_eq e, Module.finrank_baseChange, hrk]

theorem wc_cpic_embdim_le_one_normal : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [_root_.IsReduced A], Submodule.spanFinrank (IsLocalRing.maximalIdeal A) ≤ 1 → IsDomain A ∧ IsIntegrallyClosed A :=
by
  intro A _ _ _ _ h
  classical
  obtain ⟨t, hm⟩ : ∃ t : A, IsLocalRing.maximalIdeal A = Ideal.span {t} := by
    have hfg : Submodule.FG (IsLocalRing.maximalIdeal A) := IsNoetherian.noetherian _
    obtain ⟨s, hs, hspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hfg
    have hs1 : s.encard ≤ 1 := by
      rw [hs]; exact_mod_cast h
    rcases Set.encard_le_one_iff_eq.mp hs1 with rfl | ⟨x, rfl⟩
    · refine ⟨0, ?_⟩
      rw [← hspan, Submodule.span_empty, Ideal.span_singleton_eq_bot.mpr rfl]
    · exact ⟨x, hspan.symm⟩
  have hpow : ∀ n : ℕ, IsLocalRing.maximalIdeal A ^ n = Ideal.span {t ^ n} := by
    intro n; rw [hm, Ideal.span_singleton_pow]
  have hrep : ∀ x : A, x ≠ 0 → ∃ (u : A) (n : ℕ), IsUnit u ∧ x = u * t ^ n := by
    intro x hx
    have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal A)
      (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    have hex : ∃ i, x ∉ IsLocalRing.maximalIdeal A ^ i := by
      by_contra hcon
      push_neg at hcon
      have hmem : x ∈ ⨅ i, IsLocalRing.maximalIdeal A ^ i := Submodule.mem_iInf _ |>.mpr hcon
      rw [hK] at hmem
      exact hx ((Submodule.mem_bot A).mp hmem)
    have hN0 : Nat.find hex ≠ 0 := by
      intro h0
      have hs := Nat.find_spec hex
      rw [h0, pow_zero, Ideal.one_eq_top] at hs
      exact hs Submodule.mem_top
    obtain ⟨n, hn⟩ : ∃ n, Nat.find hex = n + 1 := Nat.exists_eq_succ_of_ne_zero hN0
    have hxn : x ∈ IsLocalRing.maximalIdeal A ^ n := by
      have hmin := Nat.find_min hex (show n < Nat.find hex by omega)
      push_neg at hmin
      exact hmin
    rw [hpow, Ideal.mem_span_singleton'] at hxn
    obtain ⟨a, ha⟩ := hxn
    refine ⟨a, n, ?_, ha.symm⟩
    by_contra hau
    have ham : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hau
    rw [hm, Ideal.mem_span_singleton'] at ham
    obtain ⟨b, hb⟩ := ham
    have hs := Nat.find_spec hex
    rw [hn, hpow, Ideal.mem_span_singleton'] at hs
    exact hs ⟨b, by rw [← ha, ← hb, pow_succ]; ring⟩
  have hnzd : NoZeroDivisors A := by
    refine ⟨fun {x y} hxy => ?_⟩
    by_contra hne
    push_neg at hne
    obtain ⟨hx, hy⟩ := hne
    obtain ⟨u, n, hu, rfl⟩ := hrep x hx
    obtain ⟨v, k, hv, rfl⟩ := hrep y hy
    have h1 : (u * v) * t ^ (n + k) = 0 := by rw [← hxy, pow_add]; ring
    have h2 : t ^ (n + k) = 0 := (hu.mul hv).mul_right_eq_zero.mp h1
    have ht : t = 0 := _root_.IsReduced.eq_zero t ⟨_, h2⟩
    subst ht
    rcases n with _ | n
    · rcases k with _ | k
      · rw [add_zero, pow_zero, mul_one] at h1
        exact (hu.mul hv).ne_zero h1
      · exact hy (by simp)
    · exact hx (by simp)
  haveI := hnzd
  haveI : IsDomain A := NoZeroDivisors.to_isDomain A
  refine ⟨inferInstance, ?_⟩
  have hprin : Submodule.IsPrincipal (IsLocalRing.maximalIdeal A) := ⟨⟨t, hm⟩⟩
  have hiff : Submodule.IsPrincipal (IsLocalRing.maximalIdeal A) ↔
      (IsIntegrallyClosed A ∧ ∀ (P : Ideal A), P ≠ ⊥ → P.IsPrime → P = IsLocalRing.maximalIdeal A) :=
    (tfae_of_isNoetherianRing_of_isLocalRing_of_isDomain A).out 5 4
  exact (hiff.mp hprin).1

theorem wc_cpic_local_away_dim_zero : ∀ (B : Type u) [CommRing B] (y : B) (Q : Ideal B) [Q.IsPrime], y ∈ nonZeroDivisors B → y ∈ Q → ringKrullDim B ≤ 1 → algebraMap B (Localization.AtPrime Q) y ∈ nonZeroDivisors (Localization.AtPrime Q) ∧ ringKrullDim (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) ≤ 0 :=
by
  intro B _ y Q _ hy hyQ hdim
  refine ⟨IsLocalization.map_nonZeroDivisors_le Q.primeCompl (Localization.AtPrime Q) ⟨y, hy, rfl⟩, ?_⟩
  have hB1 : ∀ x : PrimeSpectrum B, IsMin x ∨ IsMax x := Order.krullDim_le_one_iff.mp hdim
  have hfinj : Function.Injective
      (PrimeSpectrum.comap (algebraMap B (Localization.AtPrime Q))) :=
    PrimeSpectrum.localization_comap_injective (Localization.AtPrime Q) Q.primeCompl
  have hginj : Function.Injective
      (PrimeSpectrum.comap (algebraMap (Localization.AtPrime Q)
        (Localization.Away (algebraMap B (Localization.AtPrime Q) y)))) :=
    PrimeSpectrum.localization_comap_injective
      (Localization.Away (algebraMap B (Localization.AtPrime Q) y))
      (Submonoid.powers (algebraMap B (Localization.AtPrime Q) y))
  unfold ringKrullDim
  rw [Order.krullDim_nonpos_iff_forall_isMax]
  intro a b hab
  by_contra hba
  have hpp' : PrimeSpectrum.comap (algebraMap B (Localization.AtPrime Q))
        (PrimeSpectrum.comap (algebraMap (Localization.AtPrime Q)
          (Localization.Away (algebraMap B (Localization.AtPrime Q) y))) a) ≤
      PrimeSpectrum.comap (algebraMap B (Localization.AtPrime Q))
        (PrimeSpectrum.comap (algebraMap (Localization.AtPrime Q)
          (Localization.Away (algebraMap B (Localization.AtPrime Q) y))) b) := by
    rw [← PrimeSpectrum.asIdeal_le_asIdeal]
    simp only [PrimeSpectrum.comap_asIdeal]
    exact Ideal.comap_mono (Ideal.comap_mono ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr hab))
  have hnot : ¬ PrimeSpectrum.comap (algebraMap B (Localization.AtPrime Q))
        (PrimeSpectrum.comap (algebraMap (Localization.AtPrime Q)
          (Localization.Away (algebraMap B (Localization.AtPrime Q) y))) b) ≤
      PrimeSpectrum.comap (algebraMap B (Localization.AtPrime Q))
        (PrimeSpectrum.comap (algebraMap (Localization.AtPrime Q)
          (Localization.Away (algebraMap B (Localization.AtPrime Q) y))) a) := by
    intro h
    have hab' : a = b := hginj (hfinj (le_antisymm hpp' h))
    apply hba
    rw [hab']
  have hp'Q : PrimeSpectrum.comap (algebraMap B (Localization.AtPrime Q))
        (PrimeSpectrum.comap (algebraMap (Localization.AtPrime Q)
          (Localization.Away (algebraMap B (Localization.AtPrime Q) y))) b) ≤
      ⟨Q, inferInstance⟩ := by
    rw [← PrimeSpectrum.asIdeal_le_asIdeal]
    simp only [PrimeSpectrum.comap_asIdeal]
    calc Ideal.comap (algebraMap B (Localization.AtPrime Q))
          (Ideal.comap (algebraMap (Localization.AtPrime Q)
            (Localization.Away (algebraMap B (Localization.AtPrime Q) y))) b.asIdeal)
        ≤ Ideal.comap (algebraMap B (Localization.AtPrime Q))
            (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) :=
          Ideal.comap_mono (IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance))
      _ = Q := Localization.AtPrime.under_maximalIdeal
  have hyp' : y ∉ (PrimeSpectrum.comap (algebraMap B (Localization.AtPrime Q))
        (PrimeSpectrum.comap (algebraMap (Localization.AtPrime Q)
          (Localization.Away (algebraMap B (Localization.AtPrime Q) y))) b)).asIdeal := by
    intro h
    simp only [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at h
    exact b.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h
      (IsLocalization.Away.algebraMap_isUnit (algebraMap B (Localization.AtPrime Q) y)))
  rcases hB1 _ with hmin | hmax
  · exact hnot (hmin hpp')
  · have hQ := hmax hp'Q
    rw [← PrimeSpectrum.asIdeal_le_asIdeal] at hQ
    exact hyp' (hQ hyQ)

theorem wc_cpic_local_integrally_closed_in_away : ∀ (B C : Type u) [CommRing B] [CommRing C] [Algebra B C] (y : B) [IsLocalization.Away y C], (∀ r : C, IsIntegral B r → ∃ b : B, algebraMap B C b = r) → ∀ (Q : Ideal B) [Q.IsPrime] (z : Localization.Away (algebraMap B (Localization.AtPrime Q) y)), IsIntegral (Localization.AtPrime Q) z → ∃ a : Localization.AtPrime Q, algebraMap (Localization.AtPrime Q) (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) a = z :=
by
  intro B C _ _ _ y _ H Q _ z hz
  have hBD : ∀ b : B, algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) b
      = algebraMap (Localization.AtPrime Q) (Localization.Away (algebraMap B (Localization.AtPrime Q) y))
          (algebraMap B (Localization.AtPrime Q) b) :=
    fun b => IsScalarTower.algebraMap_apply B (Localization.AtPrime Q) _ b
  have hu : IsUnit (algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) y) := by
    rw [hBD]; exact IsLocalization.Away.algebraMap_isUnit (algebraMap B (Localization.AtPrime Q) y)
  let φ : C →+* Localization.Away (algebraMap B (Localization.AtPrime Q) y) :=
    IsLocalization.Away.lift y hu
  have hφ : ∀ b : B, φ (algebraMap B C b) =
      algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) b :=
    fun b => IsLocalization.Away.lift_eq y hu b
  have hφc : φ.comp (algebraMap B C) =
      algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) := RingHom.ext hφ

  obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization (M := Q.primeCompl)
    (Rₘ := Localization.AtPrime Q) z hz
  have hm' : IsIntegral B
      (algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) (m : B) * z) := by
    rw [← Algebra.smul_def]; exact hm
  obtain ⟨⟨a, ⟨_, k, rfl⟩⟩, hka⟩ :=
    IsLocalization.surj (Submonoid.powers (algebraMap B (Localization.AtPrime Q) y)) z
  obtain ⟨⟨b0, s⟩, hs⟩ := IsLocalization.surj Q.primeCompl a
  simp only at hka hs
  have hvQ : (m : B) * s ∉ Q := fun h => (Ideal.IsPrime.mem_or_mem ‹_› h).elim m.2 s.2
  have hw : IsIntegral B
      (algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) ((m : B) * s) * z) := by
    rw [map_mul, mul_comm (algebraMap B _ (m : B)), mul_assoc]
    exact (isIntegral_algebraMap).mul hm'
  have he : algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) ((m : B) * s) * z
      * algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) y ^ k
      = algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) ((m : B) * b0) := by
    have hka' := hka
    rw [map_pow] at hka'
    simp only [hBD, map_mul, map_pow]
    rw [← hs, map_mul, ← hka']
    ring

  let c : C := IsLocalization.mk' C ((m : B) * b0) (⟨y ^ k, k, rfl⟩ : Submonoid.powers y)
  have hc : c * algebraMap B C (y ^ k) = algebraMap B C ((m : B) * b0) :=
    IsLocalization.mk'_spec C ((m : B) * b0) _
  have hφcw : φ c = algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y))
      ((m : B) * s) * z := by
    have h1 := congrArg φ hc
    rw [map_mul, hφ, hφ, map_pow, ← he] at h1
    exact (hu.pow k).mul_right_cancel h1
  obtain ⟨p, hpm, hp⟩ := hw
  have hx0 : φ (Polynomial.aeval c p) = 0 := by
    rw [Polynomial.aeval_def, Polynomial.hom_eval₂, hφc, hφcw]; exact hp

  obtain ⟨⟨e, ⟨_, i0, rfl⟩⟩, hxe⟩ := IsLocalization.surj (Submonoid.powers y) (Polynomial.aeval c p)
  simp only at hxe
  have h2 : algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) e = 0 := by
    rw [← hφ, ← hxe, map_mul, hx0, zero_mul]
  rw [hBD] at h2
  obtain ⟨⟨_, i, rfl⟩, hi⟩ :=
    (IsLocalization.map_eq_zero_iff (Submonoid.powers (algebraMap B (Localization.AtPrime Q) y)) _ _).mp h2
  simp only at hi
  rw [← map_pow, ← map_mul] at hi
  obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff Q.primeCompl (Localization.AtPrime Q) _).mp hi
  have hkill : algebraMap B C (t : B) * Polynomial.aeval c p = 0 := by
    have hunit : IsUnit (algebraMap B C (y ^ i0 * y ^ i)) := by
      rw [← pow_add]
      exact IsLocalization.map_units C (⟨y ^ (i0 + i), _, rfl⟩ : Submonoid.powers y)
    apply hunit.mul_left_eq_zero.mp
    calc algebraMap B C (t : B) * Polynomial.aeval c p * algebraMap B C (y ^ i0 * y ^ i)
        = algebraMap B C (t : B) * (Polynomial.aeval c p * algebraMap B C (y ^ i0)) *
            algebraMap B C (y ^ i) := by
          rw [map_mul]; ring
      _ = algebraMap B C ((t : B) * (y ^ i * e)) := by rw [hxe, map_mul, map_mul]; ring
      _ = 0 := by rw [ht, map_zero]

  have hint : IsIntegral B (algebraMap B C (t : B) * c) := by
    refine ⟨p.scaleRoots (t : B) * Polynomial.X,
      ((Polynomial.monic_scaleRoots_iff (t : B)).mpr hpm).mul Polynomial.monic_X, ?_⟩
    have hk' : algebraMap B C (t : B) * Polynomial.eval₂ (algebraMap B C) c p = 0 := by
      rw [← Polynomial.aeval_def]; exact hkill
    rw [Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.scaleRoots_eval₂_mul]
    calc algebraMap B C (t : B) ^ p.natDegree * Polynomial.eval₂ (algebraMap B C) c p *
          (algebraMap B C (t : B) * c)
        = algebraMap B C (t : B) ^ p.natDegree * c *
            (algebraMap B C (t : B) * Polynomial.eval₂ (algebraMap B C) c p) := by
          ring
      _ = 0 := by rw [hk', mul_zero]
  obtain ⟨b', hb'⟩ := H _ hint
  have h3 : algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y)) b'
      = algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y))
          ((t : B) * ((m : B) * s)) * z := by
    rw [← hφ, hb', map_mul, hφ, hφcw]; simp only [map_mul]; ring
  have hu' : (t : B) * ((m : B) * s) ∈ Q.primeCompl :=
    fun h => (Ideal.IsPrime.mem_or_mem ‹_› h).elim t.2 hvQ
  refine ⟨IsLocalization.mk' (Localization.AtPrime Q) b' (⟨_, hu'⟩ : Q.primeCompl), ?_⟩
  have h4 := IsLocalization.mk'_spec (Localization.AtPrime Q) b' (⟨_, hu'⟩ : Q.primeCompl)
  have h5 := congrArg (algebraMap (Localization.AtPrime Q)
    (Localization.Away (algebraMap B (Localization.AtPrime Q) y))) h4
  rw [map_mul, ← hBD, ← hBD, h3, mul_comm _ z] at h5
  have hunit : IsUnit (algebraMap B (Localization.Away (algebraMap B (Localization.AtPrime Q) y))
      ((t : B) * ((m : B) * s))) := by
    rw [hBD]; exact (IsLocalization.map_units (Localization.AtPrime Q) (⟨_, hu'⟩ : Q.primeCompl)).map _
  exact hunit.mul_right_cancel h5

theorem wc_cpic_local_normal_of_away_field : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [_root_.IsReduced A] (y : A), y ∈ nonZeroDivisors A → ringKrullDim (Localization.Away y) ≤ 0 → (∀ z : Localization.Away y, IsIntegral A z → ∃ a : A, algebraMap A (Localization.Away y) a = z) → IsDomain A ∧ IsIntegrallyClosed A :=
by
  intro A _ _ _ _ y hy hdim hic
  have hM : Submonoid.powers y ≤ nonZeroDivisors A := Submonoid.powers_le.mpr hy
  have hinj : Function.Injective (algebraMap A (Localization.Away y)) :=
    IsLocalization.injective (Localization.Away y) hM
  haveI : Nontrivial (Localization.Away y) := hinj.nontrivial
  haveI : Ring.KrullDimLE 0 (Localization.Away y) := Ring.krullDimLE_iff.mpr (by exact_mod_cast hdim)
  haveI : IsArtinianRing (Localization.Away y) := IsNoetherianRing.isArtinianRing_of_krullDimLE_zero
  have hidem : ∀ e : Localization.Away y, IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro e he
    have hint : IsIntegral A e := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.X, ?_, ?_⟩
      · exact Polynomial.monic_X_pow_sub (by rw [Polynomial.degree_X]; norm_num)
      · rw [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X, pow_two, he.eq,
          sub_self]
    obtain ⟨a, ha⟩ := hic e hint
    have haa : a * a = a := hinj (by rw [map_mul, ha, he.eq])
    have h0 : a * (1 - a) = 0 := by rw [mul_sub, mul_one, haa, sub_self]
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self a with hu | hu
    · right
      have h1 : 1 - a = 0 := hu.mul_right_eq_zero.mp h0
      have h2 : a = 1 := (sub_eq_zero.mp h1).symm
      rw [← ha, h2, map_one]
    · left
      have h2 : a = 0 := hu.mul_left_eq_zero.mp h0
      rw [← ha, h2, map_zero]
  haveI hloc : IsLocalRing (Localization.Away y) := by
    obtain ⟨m, hm⟩ := Ideal.exists_maximal (Localization.Away y)
    haveI := hm.isPrime
    refine IsLocalRing.of_unique_max_ideal ⟨m, hm, fun I hI => ?_⟩
    by_contra hne
    obtain ⟨r, hrm, hr, hrq⟩ := IsArtinianRing.exists_not_mem_forall_mem_of_ne m
    have hrI := hrq I hI.isPrime hne
    rcases hidem r hr with h | h
    · exact hrm (h ▸ m.zero_mem)
    · exact hI.ne_top ((Ideal.eq_top_iff_one I).mpr (h ▸ hrI))
  have hfield : IsField (Localization.Away y) :=
    IsArtinianRing.isField_of_isReduced_of_isLocalRing (Localization.Away y)
  haveI : IsDomain (Localization.Away y) := hfield.isDomain
  haveI hdom : IsDomain A := Function.Injective.isDomain (algebraMap A (Localization.Away y)) hinj
  haveI : IsFractionRing A (Localization.Away y) := by
    refine IsLocalization.of_le (Submonoid.powers y) (nonZeroDivisors A) hM ?_
    intro r hr
    have hr0 : r ≠ 0 := nonZeroDivisors.ne_zero hr
    have hr0' : algebraMap A (Localization.Away y) r ≠ 0 := by
      intro h
      exact hr0 (hinj (by rw [h, map_zero]))
    obtain ⟨b, hb⟩ := hfield.mul_inv_cancel hr0'
    exact IsUnit.of_mul_eq_one b hb
  exact ⟨hdom, (isIntegrallyClosed_iff (Localization.Away y)).mpr (fun {x} hx => hic x hx)⟩

theorem wc_cpic_reldim_of_away : ∀ (K S T : Type u) [Field K] [CommRing S] [CommRing T] [Algebra K S] [Algebra K T] [Algebra S T] [IsScalarTower K S T] (y : S) [IsLocalization.Away y T] (n : ℕ), Algebra.Smooth K S → y ∈ nonZeroDivisors S → (∀ P' : Ideal T, P'.IsPrime → ∃ t : T, t ∉ P' ∧ Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away t)) → ∀ Q : Ideal S, Q.IsPrime → ∃ s : S, s ∉ Q ∧ Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away s) :=
by
  intro K S T _ _ _ _ _ _ _ y _ n hsm hy h3 Q hQ
  classical

  have rt : ∀ (A O : Type u) [CommRing A] [CommRing O] [Algebra K A] [Algebra K O] [Algebra S A]
      [Algebra S O] [IsScalarTower K S A] [IsScalarTower K S O] (M N : Submonoid S)
      [IsLocalization M A] [IsLocalization N O] [Nontrivial O], M ≤ N →
      Module.Free A Ω[A⁄K] → Nontrivial A ∧ Module.rank O Ω[O⁄K] = Module.rank A Ω[A⁄K] := by
    intro A O _ _ _ _ _ _ _ _ M N _ _ _ hMN hfree
    haveI := hfree
    letI : Algebra A O := IsLocalization.localizationAlgebraOfSubmonoidLe A O M N hMN
    haveI : IsScalarTower S A O :=
      IsLocalization.localization_isScalarTower_of_submonoid_le A O M N hMN
    haveI : IsScalarTower K A O := IsScalarTower.of_algebraMap_eq (fun c => by
      rw [IsScalarTower.algebraMap_apply K S O, IsScalarTower.algebraMap_apply S A O,
        ← IsScalarTower.algebraMap_apply K S A])
    haveI : IsLocalization (N.map (algebraMap S A)) O :=
      IsLocalization.isLocalization_of_submonoid_le A O M N hMN
    haveI : Algebra.FormallyEtale A O :=
      Algebra.FormallyEtale.of_isLocalization (N.map (algebraMap S A))
    haveI : Nontrivial A := RingHom.domain_nontrivial (algebraMap A O)
    refine ⟨inferInstance, ?_⟩
    rw [← (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K A O).rank_eq,
      Module.rank_baseChange, Cardinal.lift_id]

  haveI := hsm
  obtain ⟨s₀, hspan, hs₀⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth K S
  obtain ⟨x, hxs, hxQ⟩ : ∃ x ∈ s₀, x ∉ Q := by
    by_contra hcon
    push_neg at hcon
    apply hQ.ne_top
    rw [eq_top_iff, ← hspan, Ideal.span_le]
    exact hcon
  haveI : Algebra.IsStandardSmooth K (Localization.Away x) := hs₀ x hxs

  obtain ⟨q, hq, hxq, hyq⟩ : ∃ q : Ideal S, q.IsPrime ∧ x ∉ q ∧ y ∉ q := by
    have hnil : x * y ∉ nilradical S := by
      intro h
      obtain ⟨k, hk⟩ := mem_nilradical.mp h
      rw [mul_pow] at hk
      have h0 : x ^ k = 0 := (mul_right_mem_nonZeroDivisors_eq_zero_iff (pow_mem hy k)).mp hk
      exact hxQ (hQ.mem_of_pow_mem k (by rw [h0]; exact Q.zero_mem))
    rw [nilradical_eq_sInf, Ideal.mem_sInf] at hnil
    push_neg at hnil
    obtain ⟨q, hq, hxyq⟩ := hnil
    exact ⟨q, hq, fun h => hxyq (q.mul_mem_right y h), fun h => hxyq (q.mul_mem_left x h)⟩
  haveI := hq

  have hdisj : Disjoint (Submonoid.powers y : Set S) (q : Set S) := by
    rw [Set.disjoint_left]
    rintro _ ⟨k, rfl⟩ hk
    exact hyq (hq.mem_of_pow_mem k hk)
  have hP' := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers y) T q hq hdisj
  obtain ⟨t, htP, hstd⟩ := h3 _ hP'
  haveI := hstd
  haveI : Algebra.IsStandardSmooth K (Localization.Away t) :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n

  have hxN : Submonoid.powers x ≤ q.primeCompl := (Submonoid.powers_le).mpr hxq
  obtain ⟨hntx, hrx⟩ := rt (Localization.Away x) (Localization.AtPrime q) (Submonoid.powers x)
    q.primeCompl hxN Algebra.IsStandardSmooth.free_kaehlerDifferential

  haveI hloc : IsLocalization (IsLocalization.localizationLocalizationSubmodule
      (Submonoid.powers y) (Submonoid.powers t)) (Localization.Away t) :=
    IsLocalization.localization_localization_isLocalization (Submonoid.powers y)
      (Submonoid.powers t) (Localization.Away t)
  have hle : IsLocalization.localizationLocalizationSubmodule (Submonoid.powers y)
      (Submonoid.powers t) ≤ q.primeCompl := by
    intro z hz
    rw [Ideal.mem_primeCompl_iff]
    intro hzq
    obtain ⟨a, b, hab⟩ := IsLocalization.mem_localizationLocalizationSubmodule.mp hz
    obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp a.2
    have hu : IsUnit (algebraMap S T b) := IsLocalization.map_units T b
    have hzP : algebraMap S T z ∈ Ideal.map (algebraMap S T) q := Ideal.mem_map_of_mem _ hzq
    rw [hab] at hzP
    have haP : (a : T) ∈ Ideal.map (algebraMap S T) q := by
      obtain ⟨u, hu'⟩ := hu
      have h := Ideal.mul_mem_right (↑u⁻¹ : T) _ hzP
      rwa [← hu', mul_assoc, Units.mul_inv, mul_one] at h
    rw [← hk] at haP
    exact htP (hP'.mem_of_pow_mem k haP)
  obtain ⟨hntt, hrt⟩ := rt (Localization.Away t) (Localization.AtPrime q) _ q.primeCompl hle
    Algebra.IsStandardSmooth.free_kaehlerDifferential

  haveI := hntx
  haveI := hntt
  refine ⟨x, hxQ, ?_⟩
  rw [Algebra.IsStandardSmoothOfRelativeDimension.iff_of_isStandardSmooth n, ← hrx, hrt]
  exact Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential n

theorem wcpa_dj_cf_ss_field_local_std : ∀ (K S : Type u) [Field K] [CommRing S] [Algebra K S] (n : ℕ),
    SmoothOfRelativeDimension n (Spec.map (CommRingCat.ofHom (algebraMap K S))) →
    ∀ Q : Ideal S, Q.IsPrime → ∃ s : S, s ∉ Q ∧
      Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away s) :=
by
  intro K S _ _ _ n h Q hQ
  obtain ⟨s, hs, H⟩ := (HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension n)
    (Q := RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension n))).mp h
  have hex : ∃ t ∈ s, t ∉ Q := by
    by_contra hc
    push_neg at hc
    have hle : Ideal.span s ≤ Q := Ideal.span_le.mpr hc
    rw [hs] at hle
    exact hQ.ne_top (top_le_iff.mp hle)
  obtain ⟨t, ht, htQ⟩ := hex
  refine ⟨t, htQ, ?_⟩
  have h1 := H t ht
  rw [CommRingCat.hom_ofHom, ← IsScalarTower.algebraMap_eq] at h1
  exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mp h1

theorem wc_cp_infinity_chart_smooth : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : Type u) [CommRing R] [_root_.IsReduced R] [Algebra K R] (ψ : Polynomial K →ₐ[K] R), ψ.toRingHom.Finite → (∀ a : Polynomial K, a ≠ 0 → ψ a ∈ nonZeroDivisors R) → SmoothOfRelativeDimension 1 (Spec.map (CommRingCat.ofHom (algebraMap K R))) → letI : Algebra (Polynomial K) (Localization.Away (ψ Polynomial.X)) := (Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) : Localization.Away (ψ Polynomial.X))).toRingHom.toAlgebra; Module.Finite (Polynomial K) (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) → SmoothOfRelativeDimension 1 (Spec.map (CommRingCat.ofHom ((algebraMap (Polynomial K) (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X)))).comp (algebraMap K (Polynomial K))))) :=
by
  intro K _ _ R _ _ _ ψ hψ _hnzd hsm hB
  letI : Algebra (Polynomial K) (Localization.Away (ψ Polynomial.X)) :=
    (Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) :
      Localization.Away (ψ Polynomial.X))).toRingHom.toAlgebra
  classical
  haveI : PerfectField K := inferInstance

  have s4 : ∀ (S : Type u) [CommRing S] [Algebra K S] (n : ℕ) (t : S),
      SmoothOfRelativeDimension n (Spec.map (CommRingCat.ofHom (algebraMap K S))) →
      SmoothOfRelativeDimension n (Spec.map (CommRingCat.ofHom (algebraMap K (Localization.Away t)))) := by
    intro S _ _ n t h
    haveI := h
    haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away t)))) :=
      IsOpenImmersion.of_isLocalization t
    have e : Spec.map (CommRingCat.ofHom (algebraMap K (Localization.Away t))) =
        Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away t))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K S)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
    rw [e]
    have := smoothOfRelativeDimension_comp 0 n
      (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away t))))
      (Spec.map (CommRingCat.ofHom (algebraMap K S)))
    rwa [zero_add] at this

  have s9 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Algebra.IsIntegral A B],
      ringKrullDim B ≤ ringKrullDim A := by
    intro A B _ _ _ _
    apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap A B))
    intro p q hpq
    have hle : p.asIdeal ≤ q.asIdeal := hpq.le
    have hne : ¬ q.asIdeal ≤ p.asIdeal := fun h => hpq.ne (PrimeSpectrum.ext (le_antisymm hle h))
    obtain ⟨x, hxq, hxp⟩ := Set.not_subset.mp hne
    have := Ideal.under_lt_under_of_integral_mem_sdiff (R := A) hle ⟨hxq, hxp⟩
      (Algebra.IsIntegral.isIntegral x)
    exact this

  have s15 : ∀ (S : Type u) [CommRing S] [Algebra K S] (n : ℕ),
      (∀ Q : Ideal S, Q.IsPrime → ∃ s : S, s ∉ Q ∧
        Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away s)) →
      SmoothOfRelativeDimension n (Spec.map (CommRingCat.ofHom (algebraMap K S))) := by
    intro S _ _ n h
    rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension n)]
    refine ⟨{t | Algebra.IsStandardSmoothOfRelativeDimension n K (Localization.Away t)}, ?_, ?_⟩
    · by_contra hne
      obtain ⟨Q, hQ, hle⟩ := Ideal.exists_le_maximal _ hne
      obtain ⟨t, htQ, ht⟩ := h Q hQ.isPrime
      exact htQ (hle (Ideal.subset_span ht))
    · intro t ht
      show RingHom.IsStandardSmoothOfRelativeDimension n
        ((algebraMap S (Localization.Away t)).comp (algebraMap K S))
      rw [← IsScalarTower.algebraMap_eq]
      exact (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mpr ht

  have core : ∀ (B C : Type u) [CommRing B] [CommRing C] [Algebra K B] [Algebra K C] [Algebra B C]
      [IsScalarTower K B C] (y : B) [IsLocalization.Away y C], y ∈ nonZeroDivisors B →
      (∀ r : C, IsIntegral B r → ∃ b : B, algebraMap B C b = r) →
      Algebra.FiniteType K B → _root_.IsReduced B → ringKrullDim B ≤ 1 →
      Algebra.FiniteType K C → _root_.IsReduced C →
      SmoothOfRelativeDimension 1 (Spec.map (CommRingCat.ofHom (algebraMap K C))) →
      SmoothOfRelativeDimension 1 (Spec.map (CommRingCat.ofHom (algebraMap K B))) := by
    intro B C _ _ _ _ _ _ y _ hy hic hftB hredB hdim hftC hredC hsmC
    haveI := hftB; haveI := hftC; haveI := hredB; haveI := hredC
    haveI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing K B
    haveI : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing K C
    have hCpt := wcpa_dj_cf_ss_field_local_std K C 1 hsmC
    have hCnorm : ∀ (P' : Ideal C) [P'.IsPrime], IsDomain (Localization.AtPrime P') ∧
        IsIntegrallyClosed (Localization.AtPrime P') := by
      intro P' _
      obtain ⟨h1, h2, h3, h4, h5⟩ := wc_cpic_stalk_smooth_data K C 1 hCpt P'
      have hemb := wcpa_embdim_le_rank_omega K (Localization.AtPrime P') h1 h2 h3 h5
      rw [h4] at hemb
      exact wc_cpic_embdim_le_one_normal _ hemb

    have s8 : ∀ (P : Ideal B) [P.IsPrime], y ∉ P → IsDomain (Localization.AtPrime P) ∧
        IsIntegrallyClosed (Localization.AtPrime P) := by
      intro P _ hyP
      have hdisj : Disjoint (Submonoid.powers y : Set B) (P : Set B) := by
        rw [Set.disjoint_left]
        rintro _ ⟨k, rfl⟩ hk
        exact hyP (‹P.IsPrime›.mem_of_pow_mem k hk)
      haveI hP' : (Ideal.map (algebraMap B C) P).IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers y) C P ‹_› hdisj
      have hcomap : Ideal.comap (algebraMap B C) (Ideal.map (algebraMap B C) P) = P :=
        IsLocalization.comap_map_of_isPrime_disjoint (Submonoid.powers y) C ‹P.IsPrime› hdisj
      obtain ⟨hd, hi⟩ := hCnorm (Ideal.map (algebraMap B C) P)
      haveI : IsLocalization.AtPrime (Localization.AtPrime (Ideal.map (algebraMap B C) P)) P := by
        have := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
          (Submonoid.powers y) (Localization.AtPrime (Ideal.map (algebraMap B C) P))
          (Ideal.map (algebraMap B C) P)
        have h2 : P.primeCompl =
            (Ideal.comap (algebraMap B C) (Ideal.map (algebraMap B C) P)).primeCompl := by
          ext x
          rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hcomap]
        unfold IsLocalization.AtPrime at this ⊢
        rw [h2]
        exact this
      let e : Localization.AtPrime P ≃ₐ[B] Localization.AtPrime (Ideal.map (algebraMap B C) P) :=
        IsLocalization.algEquiv P.primeCompl _ _
      haveI := hd
      haveI := hi
      haveI : IsDomain (Localization.AtPrime P) := e.toMulEquiv.isDomain
      exact ⟨inferInstance, IsIntegrallyClosed.of_equiv e.symm.toRingEquiv⟩
    have hBnorm : ∀ (P : Ideal B) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧
        IsIntegrallyClosed (Localization.AtPrime P) := by
      intro P _
      by_cases hyP : y ∈ P
      · obtain ⟨hy1, hd⟩ := wc_cpic_local_away_dim_zero B y P hy hyP hdim
        have hic' := wc_cpic_local_integrally_closed_in_away B C y hic P
        exact wc_cpic_local_normal_of_away_field _ _ hy1 hd hic'
      · exact s8 P hyP
    have hfs := wcfd_tn_perfect_normal_dim_le_one_smooth K B hBnorm hdim
    haveI : Algebra.FinitePresentation K B := (Algebra.FinitePresentation.of_finiteType).mp hftB
    haveI : Algebra.Smooth K B := ⟨hfs, inferInstance⟩
    exact s15 B 1 (wc_cpic_reldim_of_away K B C y 1 inferInstance hy hCpt)

  obtain ⟨hloc, hy, hic⟩ := wc_cpic_localization_structure K R ψ hψ
  letI : Algebra K (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) :=
    ((algebraMap (Polynomial K) (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X)))).comp
      (algebraMap K (Polynomial K))).toAlgebra
  haveI : IsScalarTower K (Polynomial K) (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) :=
    IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower K (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X)))
      (Localization.Away (ψ Polynomial.X)) := by
    apply IsScalarTower.of_algebraMap_eq
    intro c
    show algebraMap K (Localization.Away (ψ Polynomial.X)) c =
      Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) : Localization.Away (ψ Polynomial.X))
        (Polynomial.C c)
    rw [Polynomial.aeval_C]

  letI : Algebra (Polynomial K) R := ψ.toRingHom.toAlgebra
  haveI : IsScalarTower K (Polynomial K) R := IsScalarTower.of_algebraMap_eq' (ψ.comp_algebraMap).symm
  haveI : Module.Finite (Polynomial K) R := hψ
  haveI hftR : Algebra.FiniteType K R := Algebra.FiniteType.trans (S := Polynomial K) inferInstance inferInstance
  have hfpC : Algebra.FinitePresentation R (Localization.Away (ψ Polynomial.X)) :=
    IsLocalization.Away.finitePresentation (ψ Polynomial.X)
  haveI hftC : Algebra.FiniteType K (Localization.Away (ψ Polynomial.X)) :=
    Algebra.FiniteType.trans (S := R) hftR inferInstance
  haveI := hB
  haveI hftB : Algebra.FiniteType K (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) :=
    Algebra.FiniteType.trans (S := Polynomial K) inferInstance inferInstance
  have hred : _root_.IsReduced (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) :=
    isReduced_of_injective (algebraMap (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X)))
      (Localization.Away (ψ Polynomial.X))) Subtype.val_injective
  have hdim : ringKrullDim (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))) ≤ 1 := by
    refine (s9 (Polynomial K) _).trans (le_of_eq ?_)
    rw [Polynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_isField (Field.toIsField K)]
    rfl
  exact core _ _ _ hy hic hftB hred hdim hftC inferInstance (s4 R 1 (ψ Polynomial.X) hsm)

theorem wc_cp_normalization_charts : ∀ (K : Type u) [Field K] [IsAlgClosed K] (P : Scheme.{u}) (sP : P ⟶ Spec (.of K)) (j0 j1 : Spec (.of (Polynomial K)) ⟶ P) (σ : Spec (.of K) ⟶ P), IsOpenImmersion j0 → IsOpenImmersion j1 → j0 ≫ sP = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) → j1 ≫ sP = Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) → (Set.range j0)ᶜ = {σ (IsLocalRing.closedPoint K)} → σ (IsLocalRing.closedPoint K) ∈ Set.range j1 → j1 ⁻¹' Set.range j0 = {p | (Polynomial.X : Polynomial K) ∉ p.asIdeal} → Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K)))) ≫ j0 = Spec.map (CommRingCat.ofHom (Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) : Localization.Away (Polynomial.X : Polynomial K))).toRingHom) ≫ j1 → ∀ (R : Type u) [CommRing R] [Algebra K R] (ψ : Polynomial K →ₐ[K] R), ψ.toRingHom.Finite → (letI : Algebra (Polynomial K) (Localization.Away (ψ Polynomial.X)) := (Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) : Localization.Away (ψ Polynomial.X))).toRingHom.toAlgebra; Module.Finite (Polynomial K) (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X)))) → ∀ (ε : Spec (.of R) ⟶ P) [QuasiCompact ε] [QuasiSeparated ε], ε = Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ j0 → IsFinite ε.fromNormalization ∧ letI : Algebra (Polynomial K) (Localization.Away (ψ Polynomial.X)) := (Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) : Localization.Away (ψ Polynomial.X))).toRingHom.toAlgebra; ∃ i1 : Spec (.of (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X)))) ⟶ ε.normalization, IsOpenImmersion i1 ∧ Set.range i1 = ε.fromNormalization ⁻¹' Set.range j1 ∧ i1 ≫ ε.fromNormalization = Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X))))) ≫ j1 :=
by
  intro K _ _ P sP j0 j1 σ hj0 hj1 hj0s hj1s H0 H1 H2 H3 R _ _ ψ hψ hB ε _ _ hε
  classical
  haveI := hj0
  haveI := hj1

  have hsurj : ∀ {A B : Scheme.{u}} (g : A ⟶ B), IsIso g → Function.Surjective g := by
    intro A B g hg b
    exact ⟨(asIso g).inv b, Scheme.inv_hom_apply (asIso g) b⟩
  have hrange : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C), Function.Surjective f →
      Set.range (f ≫ g) = Set.range g := by
    intro A B C f g hf
    ext x
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨f a, (Scheme.Hom.comp_apply f g a).symm⟩
    · rintro ⟨b, rfl⟩
      obtain ⟨a, rfl⟩ := hf b
      exact ⟨a, Scheme.Hom.comp_apply f g a⟩



  have hT : ∀ (Xs Ps : Scheme.{u}) (e : Xs ⟶ Ps) [QuasiCompact e] [QuasiSeparated e]
      (A S : Type u) [CommRing A] [CommRing S] [Algebra A S] (j : Spec (.of A) ⟶ Ps)
      (ι : Spec (.of S) ⟶ Xs), IsOpenImmersion j → IsOpenImmersion ι →
      Set.range ι = e ⁻¹' Set.range j →
      ι ≫ e = Spec.map (CommRingCat.ofHom (algebraMap A S)) ≫ j →
      ∃ i : Spec (.of (integralClosure A S)) ⟶ e.normalization, IsOpenImmersion i ∧
        Set.range i = e.fromNormalization ⁻¹' Set.range j ∧
        i ≫ e.fromNormalization =
          Spec.map (CommRingCat.ofHom (algebraMap A (integralClosure A S))) ≫ j := by
    intro Xs Ps e _ _ A S _ _ _ j ι hj hι hr hsq

    have L1a : ∀ {Z : Scheme.{u}} {T : CommRingCat.{u}} (g : Spec T ⟶ Z), IsOpenImmersion g →
        ∀ (U : Z.Opens) (hU : IsAffineOpen U), (U : Set Z) = Set.range g →
        ∃ θ : Γ(Z, U) ⟶ T, Function.Bijective θ.hom ∧ Spec.map θ ≫ hU.fromSpec = g := by
      intro Z T g hg U hU hUg
      have hUeq : U = g.opensRange :=
        TopologicalSpace.Opens.ext (by rw [Scheme.Hom.coe_opensRange]; exact hUg)
      subst hUeq
      refine ⟨Spec.preimage (g.isoOpensRange.hom ≫ hU.isoSpec.hom), ?_, ?_⟩
      · rw [← isIso_SpecMap_iff, Spec.map_preimage]
        infer_instance
      · rw [Spec.map_preimage, Category.assoc, hU.isoSpec_hom_fromSpec,
          Scheme.Hom.isoOpensRange_hom_ι]
    let W : Ps.Opens := j.opensRange
    have hW : IsAffineOpen W := isAffineOpen_opensRange j
    have hWr : (W : Set Ps) = Set.range j := Scheme.Hom.coe_opensRange j
    have hVr : ((e ⁻¹ᵁ W : Xs.Opens) : Set Xs) = Set.range ι := by
      show e ⁻¹' (W : Set Ps) = Set.range ι
      rw [hWr, hr]
    have hV : IsAffineOpen (e ⁻¹ᵁ W) := by
      have : e ⁻¹ᵁ W = ι.opensRange :=
        TopologicalSpace.Opens.ext (by rw [hVr, Scheme.Hom.coe_opensRange])
      rw [this]; exact isAffineOpen_opensRange ι
    obtain ⟨θA, hθA, hθAj⟩ := L1a j hj W hW hWr
    obtain ⟨θS, hθS, hθSι⟩ := L1a ι hι (e ⁻¹ᵁ W) hV hVr
    haveI := hW.isOpenImmersion_fromSpec
    have hcompat : e.app W ≫ θS = θA ≫ CommRingCat.ofHom (algebraMap A S) := by
      apply Spec.map_injective
      rw [← cancel_mono hW.fromSpec]
      rw [Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc, hθAj,
        Scheme.Hom.app_eq_appLE, IsAffineOpen.SpecMap_appLE_fromSpec e hW hV le_rfl,
        ← Category.assoc, hθSι, hsq]
    letI : Algebra Γ(Ps, W) Γ(Xs, e ⁻¹ᵁ W) := (e.app W).hom.toAlgebra
    have hcomm : (algebraMap A S).comp θA.hom =
        θS.hom.comp (algebraMap Γ(Ps, W) Γ(Xs, e ⁻¹ᵁ W)) := by
      have := congrArg CommRingCat.Hom.hom hcompat
      rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom] at this
      exact this.symm
    let eA : Γ(Ps, W) ≃+* A := RingEquiv.ofBijective θA.hom hθA
    let eS : Γ(Xs, e ⁻¹ᵁ W) ≃+* S := RingEquiv.ofBijective θS.hom hθS
    have hcomm' : (algebraMap Γ(Ps, W) Γ(Xs, e ⁻¹ᵁ W)).comp eA.symm.toRingHom =
        eS.symm.toRingHom.comp (algebraMap A S) := by
      refine RingHom.ext fun z => ?_
      apply eS.injective
      have h1 : θA.hom (eA.symm z) = z := eA.apply_symm_apply z
      calc eS (algebraMap Γ(Ps, W) Γ(Xs, e ⁻¹ᵁ W) (eA.symm z))
            = θS.hom (algebraMap Γ(Ps, W) Γ(Xs, e ⁻¹ᵁ W) (eA.symm z)) := rfl
        _ = algebraMap A S (θA.hom (eA.symm z)) := (RingHom.congr_fun hcomm (eA.symm z)).symm
        _ = algebraMap A S z := by rw [h1]
        _ = eS (eS.symm (algebraMap A S z)) := (eS.apply_symm_apply _).symm
    let Ξ : integralClosure Γ(Ps, W) Γ(Xs, e ⁻¹ᵁ W) →+* integralClosure A S :=
      RingHom.codRestrict
        (θS.hom.comp (integralClosure Γ(Ps, W) Γ(Xs, e ⁻¹ᵁ W)).val.toRingHom)
        (integralClosure A S) (fun x => IsIntegral.map_of_comp_eq θA.hom θS.hom hcomm x.2)
    have hΞ : Function.Bijective Ξ := by
      constructor
      · intro x y hxy
        apply Subtype.ext
        apply hθS.1
        exact congrArg Subtype.val hxy
      · intro y
        refine ⟨⟨eS.symm y.1, IsIntegral.map_of_comp_eq eA.symm.toRingHom eS.symm.toRingHom
          hcomm' y.2⟩, ?_⟩
        apply Subtype.ext
        exact eS.apply_symm_apply y.1
    let c : Spec (.of (integralClosure Γ(Ps, W) Γ(Xs, e ⁻¹ᵁ W))) ⟶ e.normalization :=
      e.normalizationOpenCover.f ⟨W, hW⟩
    have hc : IsOpenImmersion c := e.normalizationOpenCover.map_prop _
    have hcν : c ≫ e.fromNormalization = Spec.map (CommRingCat.ofHom
        (algebraMap Γ(Ps, W) (integralClosure Γ(Ps, W) Γ(Xs, e ⁻¹ᵁ W)))) ≫ hW.fromSpec :=
      e.ι_fromNormalization ⟨W, hW⟩
    have hcr : Set.range c = e.fromNormalization ⁻¹' (W : Set Ps) := by
      have h := congrArg (fun U : e.normalization.Opens => (U : Set e.normalization))
        (Scheme.Hom.fromNormalization_preimage e ⟨W, hW⟩)
      exact h.symm
    haveI hΞiso : IsIso (Spec.map (CommRingCat.ofHom Ξ)) := isIso_SpecMap_iff.mpr hΞ
    refine ⟨Spec.map (CommRingCat.ofHom Ξ) ≫ c,
      MorphismProperty.comp_mem @IsOpenImmersion _ _ (IsOpenImmersion.of_isIso _) hc, ?_, ?_⟩
    · rw [hrange _ _ (hsurj _ hΞiso), hcr, hWr]
    · have hΞc : Ξ.comp (algebraMap Γ(Ps, W) (integralClosure Γ(Ps, W) Γ(Xs, e ⁻¹ᵁ W))) =
          (algebraMap A (integralClosure A S)).comp θA.hom :=
        RingHom.ext fun x => Subtype.ext (RingHom.congr_fun hcomm x).symm
      rw [Category.assoc, hcν, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        hΞc, CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, Category.assoc, hθAj]



  have s2 : j0 ⁻¹' Set.range j1 = {p | (Polynomial.X : Polynomial K) ∉ p.asIdeal} := by
    let L := Localization.Away (Polynomial.X : Polynomial K)
    let α : Polynomial K →+* L := algebraMap (Polynomial K) L
    let u : L := IsLocalization.Away.invSelf (Polynomial.X : Polynomial K)
    let φ : Polynomial K →+* L := (Polynomial.aeval u).toRingHom
    have hu : α Polynomial.X * u = 1 := IsLocalization.Away.mul_invSelf _
    have hφX' : φ Polynomial.X = u := Polynomial.aeval_X u
    have hφX : IsUnit (φ Polynomial.X) := by
      rw [hφX']; exact IsUnit.of_mul_eq_one (α Polynomial.X) (by rw [mul_comm]; exact hu)
    let Φ : L →+* L := IsLocalization.Away.lift (Polynomial.X : Polynomial K) hφX
    have hΦα : Φ.comp α = φ := IsLocalization.Away.lift_comp _ hφX
    have hΦφ : Φ.comp φ = α := by
      apply Polynomial.ringHom_ext
      · intro a
        have h1 : φ (Polynomial.C a) = α (Polynomial.C a) := by
          show Polynomial.aeval u (Polynomial.C a) = algebraMap (Polynomial K) L (Polynomial.C a)
          rw [Polynomial.aeval_C, ← Polynomial.algebraMap_eq (R := K),
            ← IsScalarTower.algebraMap_apply]
        show Φ (φ (Polynomial.C a)) = α (Polynomial.C a)
        rw [h1]
        exact (RingHom.congr_fun hΦα (Polynomial.C a)).trans h1
      · show Φ (φ Polynomial.X) = α Polynomial.X
        have hΦαX : Φ (α Polynomial.X) = u := (RingHom.congr_fun hΦα Polynomial.X).trans hφX'
        have h2 : u * Φ u = 1 := by
          have := congrArg Φ hu
          rw [map_mul, map_one, hΦαX] at this
          exact this
        rw [hφX']
        linear_combination (α Polynomial.X) * h2 - (Φ u) * hu
    have H3' : ∀ q : PrimeSpectrum L,
        j0 (PrimeSpectrum.comap α q) = j1 (PrimeSpectrum.comap φ q) := by
      intro q
      have h := congrArg (fun f : Spec (.of L) ⟶ P => f q) H3
      simp only [Scheme.Hom.comp_apply, Spec.map_apply, CommRingCat.hom_ofHom] at h
      exact h
    have hrng : ∀ p : PrimeSpectrum (Polynomial K),
        p ∈ Set.range (PrimeSpectrum.comap α) ↔ (Polynomial.X : Polynomial K) ∉ p.asIdeal := by
      intro p
      have := Set.ext_iff.mp
        (PrimeSpectrum.localization_away_comap_range L (Polynomial.X : Polynomial K)) p
      exact this.trans (PrimeSpectrum.mem_basicOpen _ _)
    ext p
    simp only [Set.mem_preimage, Set.mem_setOf_eq]
    constructor
    · rintro ⟨p', hp'⟩
      have hp'0 : p' ∈ j1 ⁻¹' Set.range j0 := ⟨p, hp'.symm⟩
      rw [H2] at hp'0
      obtain ⟨q, hq⟩ := (hrng p').mpr hp'0
      have hq' : PrimeSpectrum.comap φ (PrimeSpectrum.comap Φ q) = p' := by
        rw [← hq, ← PrimeSpectrum.comap_comp_apply, hΦφ]
      have h4 : j0 (PrimeSpectrum.comap α (PrimeSpectrum.comap Φ q)) = j0 p := by
        rw [H3', hq', hp']
      have h5 := (Scheme.Hom.isOpenEmbedding j0).injective h4
      rw [← h5]
      exact (hrng _).mp ⟨_, rfl⟩
    · intro hp
      obtain ⟨q, rfl⟩ := (hrng p).mpr hp
      exact ⟨_, (H3' q).symm⟩



  have s3 : Set.range (Spec.map (CommRingCat.ofHom (algebraMap R
      (Localization.Away (ψ Polynomial.X))))) =
      (Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ j0) ⁻¹' Set.range j1 := by
    ext q
    have L : q ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap R
        (Localization.Away (ψ Polynomial.X))))) ↔ ψ Polynomial.X ∉ q.asIdeal := by
      have e0 : Set.range (Spec.map (CommRingCat.ofHom (algebraMap R
          (Localization.Away (ψ Polynomial.X))))) =
          Set.range (PrimeSpectrum.comap (algebraMap R (Localization.Away (ψ Polynomial.X)))) := by
        ext x
        constructor
        · rintro ⟨y, rfl⟩
          exact ⟨y, (Spec.map_apply (CommRingCat.ofHom (algebraMap R
            (Localization.Away (ψ Polynomial.X)))) y).symm⟩
        · rintro ⟨y, rfl⟩
          exact ⟨y, Spec.map_apply (CommRingCat.ofHom (algebraMap R
            (Localization.Away (ψ Polynomial.X)))) y⟩
      rw [e0, PrimeSpectrum.localization_away_comap_range _ (ψ Polynomial.X)]
      exact PrimeSpectrum.mem_basicOpen _ _
    have Rr : q ∈ (Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ j0) ⁻¹' Set.range j1 ↔
        ψ Polynomial.X ∉ q.asIdeal := by
      rw [Set.mem_preimage, Scheme.Hom.comp_apply, ← Set.mem_preimage (f := j0), s2]
      show (Polynomial.X : Polynomial K) ∉
        (Spec.map (CommRingCat.ofHom ψ.toRingHom) q).asIdeal ↔ _
      rw [Spec.map_apply]
      exact Iff.rfl
    exact L.trans Rr.symm



  have hCst : ∀ a : K, (Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
      Localization.Away (Polynomial.X : Polynomial K))).toRingHom (Polynomial.C a) =
      algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K)) (Polynomial.C a) := by
    intro a
    show Polynomial.aeval _ (Polynomial.C a) = _
    rw [Polynomial.aeval_C, ← Polynomial.algebraMap_eq (R := K),
      ← IsScalarTower.algebraMap_apply]
  have s4 : Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ψ Polynomial.X)))) ≫
      Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ j0 =
      Spec.map (CommRingCat.ofHom (Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) :
        Localization.Away (ψ Polynomial.X))).toRingHom) ≫ j1 := by
    have hu : algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K))
        Polynomial.X * IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) = 1 :=
      IsLocalization.Away.mul_invSelf _
    have huψ : algebraMap R (Localization.Away (ψ Polynomial.X)) (ψ Polynomial.X) *
        IsLocalization.Away.invSelf (ψ Polynomial.X) = 1 := IsLocalization.Away.mul_invSelf _
    have hunit : IsUnit (((algebraMap R (Localization.Away (ψ Polynomial.X))).comp
        ψ.toRingHom) Polynomial.X) := IsUnit.of_mul_eq_one _ huψ
    let m : Localization.Away (Polynomial.X : Polynomial K) →+* Localization.Away (ψ Polynomial.X) :=
      IsLocalization.Away.lift (Polynomial.X : Polynomial K) hunit
    have hm1 : m.comp (algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K))) =
        (algebraMap R (Localization.Away (ψ Polynomial.X))).comp ψ.toRingHom :=
      IsLocalization.Away.lift_comp _ hunit
    have hm2 : m (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K)) =
        IsLocalization.Away.invSelf (ψ Polynomial.X) := by
      have h1 : algebraMap R (Localization.Away (ψ Polynomial.X)) (ψ Polynomial.X) *
          m (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K)) = 1 := by
        have := congrArg m hu
        rw [map_mul, map_one] at this
        rw [← this]
        congr 1
        exact (RingHom.congr_fun hm1 Polynomial.X).symm
      linear_combination (IsLocalization.Away.invSelf (ψ Polynomial.X)) * h1 -
        (m (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K))) * huψ
    have hm3 : m.comp (Polynomial.aeval (R := K) (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
        Localization.Away (Polynomial.X : Polynomial K))).toRingHom =
        (Polynomial.aeval (R := K) (IsLocalization.Away.invSelf (ψ Polynomial.X) :
          Localization.Away (ψ Polynomial.X))).toRingHom := by
      apply Polynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, hCst a, ← RingHom.comp_apply, hm1]
        show algebraMap R (Localization.Away (ψ Polynomial.X)) (ψ (Polynomial.C a)) =
          Polynomial.aeval (R := K) (IsLocalization.Away.invSelf (ψ Polynomial.X) :
            Localization.Away (ψ Polynomial.X)) (Polynomial.C a)
        rw [Polynomial.aeval_C, ← Polynomial.algebraMap_eq (R := K), ψ.commutes,
          ← IsScalarTower.algebraMap_apply]
      · rw [RingHom.comp_apply]
        show m (Polynomial.aeval (R := K) (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
            Localization.Away (Polynomial.X : Polynomial K)) Polynomial.X) =
          Polynomial.aeval (R := K) (IsLocalization.Away.invSelf (ψ Polynomial.X) :
            Localization.Away (ψ Polynomial.X)) Polynomial.X
        rw [Polynomial.aeval_X, Polynomial.aeval_X, hm2]
    calc Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ψ Polynomial.X)))) ≫
          Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ j0
        = Spec.map (CommRingCat.ofHom ((algebraMap R (Localization.Away (ψ Polynomial.X))).comp
            ψ.toRingHom)) ≫ j0 := by
          rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      _ = Spec.map (CommRingCat.ofHom (m.comp
            (algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K))))) ≫ j0 := by
          rw [hm1]
      _ = Spec.map (CommRingCat.ofHom m) ≫ Spec.map (CommRingCat.ofHom
            (algebraMap (Polynomial K) (Localization.Away (Polynomial.X : Polynomial K)))) ≫ j0 := by
          rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      _ = Spec.map (CommRingCat.ofHom m) ≫ Spec.map (CommRingCat.ofHom
            (Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
              Localization.Away (Polynomial.X : Polynomial K))).toRingHom) ≫ j1 := by
          rw [H3]
      _ = Spec.map (CommRingCat.ofHom (m.comp
            (Polynomial.aeval (IsLocalization.Away.invSelf (Polynomial.X : Polynomial K) :
              Localization.Away (Polynomial.X : Polynomial K))).toRingHom)) ≫ j1 := by
          rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      _ = _ := by rw [hm3]



  letI : Algebra (Polynomial K) (Localization.Away (ψ Polynomial.X)) :=
    (Polynomial.aeval (IsLocalization.Away.invSelf (ψ Polynomial.X) :
      Localization.Away (ψ Polynomial.X))).toRingHom.toAlgebra
  have hι : IsOpenImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap R (Localization.Away (ψ Polynomial.X))))) :=
    IsOpenImmersion.of_isLocalization (ψ Polynomial.X)
  have hr : Set.range (Spec.map (CommRingCat.ofHom
      (algebraMap R (Localization.Away (ψ Polynomial.X))))) = ε ⁻¹' Set.range j1 := by
    rw [hε]; exact s3
  have hsq : Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (ψ Polynomial.X)))) ≫ ε =
      Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K)
        (Localization.Away (ψ Polynomial.X)))) ≫ j1 := by
    rw [hε]; exact s4
  obtain ⟨i1, hi1, hi1r, hi1c⟩ := hT (Spec (.of R)) P ε (Polynomial K)
    (Localization.Away (ψ Polynomial.X)) j1 _ hj1 hι hr hsq

  haveI hψF : IsFinite (Spec.map (CommRingCat.ofHom ψ.toRingHom)) :=
    (IsFinite.SpecMap_iff _).mpr hψ


  have hNI : ∀ (X Y : Scheme.{u}) (ε : X ⟶ Y) [QuasiCompact ε] [QuasiSeparated ε] (OY : Y.Opens),
      IsAffineOpen OY → ∀ (εO : X ⟶ (OY : Scheme.{u})), IsFinite εO → εO ≫ OY.ι = ε →
      IsOpenImmersion ε.toNormalization ∧
        Set.range ε.toNormalization = ε.fromNormalization ⁻¹' (OY : Set Y) := by
    intro X Y ε _ _ OY hOY εO hεO hε
    haveI := hεO
    haveI : IsAffine (OY : Scheme.{u}) := hOY
    haveI : IsAffine X := isAffine_of_isAffineHom εO
    have htop : ε ⁻¹ᵁ OY = ⊤ := by
      subst hε
      rw [Scheme.Hom.comp_preimage, Scheme.Opens.ι_preimage_self, Scheme.Hom.preimage_top]
    have hAff : IsAffineOpen (ε ⁻¹ᵁ OY) := by
      rw [htop]; exact isAffineOpen_top X
    have hfin : (ε.app OY).hom.Finite := by
      subst hε
      have h : IsAffineOpen (OY.ι ⁻¹ᵁ OY) := by
        rw [Scheme.Opens.ι_preimage_self]; exact isAffineOpen_top _
      have h1 : (εO.app (OY.ι ⁻¹ᵁ OY)).hom.Finite := IsFinite.finite_app εO _ h
      haveI := Scheme.Hom.isIso_app OY.ι OY (Scheme.Opens.opensRange_ι OY).ge
      have h2 : (OY.ι.app OY).hom.Finite :=
        RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso (OY.ι.app OY)).2
      have h3 := RingHom.Finite.comp h1 h2
      rw [Scheme.Hom.comp_app]
      exact h3
    letI : Algebra Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) := (ε.app OY).hom.toAlgebra
    have hint : Algebra.IsIntegral Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) :=
      algebraMap_isIntegral_iff.mp hfin.to_isIntegral
    have htopI : integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) = ⊤ :=
      integralClosure_eq_top_iff.mpr hint
    have hbij : Function.Bijective (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val := by
      refine ⟨Subtype.val_injective, fun a => ⟨⟨a, ?_⟩, rfl⟩⟩
      rw [htopI]; trivial
    haveI hσ : IsIso (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    have key : (ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization = (ε ⁻¹ᵁ OY).toSpecΓ ≫
        Spec.map (CommRingCat.ofHom
          (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
        ε.normalizationOpenCover.f ⟨OY, hOY⟩ :=
      Scheme.Hom.ι_toNormalization ε ⟨OY, hOY⟩
    haveI hj : IsIso (ε ⁻¹ᵁ OY).ι := by
      rw [← Scheme.isoOfEq_hom_ι X htop, ← Scheme.topIso_hom]
      infer_instance
    haveI hT' : IsIso (ε ⁻¹ᵁ OY).toSpecΓ := by
      rw [← hAff.isoSpec_hom]; infer_instance
    have hc : IsOpenImmersion (ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
      ε.normalizationOpenCover.map_prop _
    have hS : IsIso (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom)) := by
      first
      | infer_instance
      | exact Functor.map_isIso Scheme.Spec _
    have hS' : IsOpenImmersion (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom)) := IsOpenImmersion.of_isIso _
    have hT'' : IsOpenImmersion (ε ⁻¹ᵁ OY).toSpecΓ := IsOpenImmersion.of_isIso _
    have h2 : IsOpenImmersion (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
        ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
      MorphismProperty.comp_mem @IsOpenImmersion _ _ hS' hc
    have h3 : IsOpenImmersion ((ε ⁻¹ᵁ OY).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
        ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
      MorphismProperty.comp_mem @IsOpenImmersion _ _ hT'' h2
    have hOI : IsOpenImmersion ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) := by
      rw [key]; exact h3
    have hι : IsOpenImmersion ε.toNormalization := by
      have e : ε.toNormalization =
          inv (ε ⁻¹ᵁ OY).ι ≫ ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) := by
        rw [IsIso.inv_hom_id_assoc]
      rw [e]
      exact MorphismProperty.comp_mem @IsOpenImmersion _ _ (IsOpenImmersion.of_isIso _) hOI
    have hrng : Set.range ε.toNormalization = ε.fromNormalization ⁻¹' (OY : Set Y) := by
      have e1 := hrange (ε ⁻¹ᵁ OY).ι ε.toNormalization (hsurj _ hj)
      have e2 := hrange (ε ⁻¹ᵁ OY).toSpecΓ (Spec.map (CommRingCat.ofHom
          (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
        ε.normalizationOpenCover.f ⟨OY, hOY⟩) (hsurj _ hT')
      have e3 := hrange (Spec.map (CommRingCat.ofHom
          (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom))
        (ε.normalizationOpenCover.f ⟨OY, hOY⟩) (hsurj _ hS)
      have e4 : Set.range (ε.normalizationOpenCover.f ⟨OY, hOY⟩) =
          ε.fromNormalization ⁻¹' (OY : Set Y) := by
        have h := congrArg (fun U : ε.normalization.Opens => (U : Set ε.normalization))
          (Scheme.Hom.fromNormalization_preimage ε ⟨OY, hOY⟩)
        exact h.symm
      have e5 : Set.range ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) =
          Set.range ((ε ⁻¹ᵁ OY).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
            (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
            ε.normalizationOpenCover.f ⟨OY, hOY⟩) := by
        rw [key]
      exact e1.symm.trans (e5.trans (e2.trans (e3.trans e4)))
    exact ⟨hι, hrng⟩
  obtain ⟨hjo, hjr⟩ := hNI (Spec (.of R)) P ε
    (Scheme.Hom.opensRange j0) (isAffineOpen_opensRange j0)
    (Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ (Scheme.Hom.isoOpensRange j0).hom) inferInstance
    (by rw [Category.assoc, Scheme.Hom.isoOpensRange_hom_ι, hε])
  rw [Scheme.Hom.coe_opensRange] at hjr
  haveI := hjo
  haveI := hi1
  have hιeq : ∀ {A B : Scheme.{u}} (g : A ⟶ B) [IsOpenImmersion g],
      g.opensRange.ι = g.isoOpensRange.inv ≫ g := by
    intro A B g _
    calc g.opensRange.ι = g.isoOpensRange.inv ≫ g.isoOpensRange.hom ≫ g.opensRange.ι :=
          (Iso.inv_hom_id_assoc _ _).symm
      _ = _ := by rw [Scheme.Hom.isoOpensRange_hom_ι]
  haveI hBF : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K)
      (integralClosure (Polynomial K) (Localization.Away (ψ Polynomial.X)))))) :=
    (IsFinite.SpecMap_iff _).mpr (RingHom.finite_algebraMap.mpr hB)
  have hfin : IsFinite ε.fromNormalization := by
    rw [IsFinite.iff_isIntegralHom_and_locallyOfFiniteType]
    refine ⟨inferInstance, ?_⟩
    haveI : IsZariskiLocalAtSource @LocallyOfFiniteType :=
      HasRingHomProperty.instIsZariskiLocalAtSource (P := @LocallyOfFiniteType)
    refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @LocallyOfFiniteType)
      (fun b : Bool => cond b ε.toNormalization.opensRange i1.opensRange) ?_ ?_
    · rw [eq_top_iff]
      intro y _
      rw [TopologicalSpace.Opens.mem_iSup]
      by_cases hy : ε.fromNormalization y ∈ Set.range j0
      · refine ⟨true, ?_⟩
        show y ∈ (ε.toNormalization.opensRange : Set ε.normalization)
        rw [Scheme.Hom.coe_opensRange, hjr]; exact hy
      · refine ⟨false, ?_⟩
        show y ∈ (i1.opensRange : Set ε.normalization)
        rw [Scheme.Hom.coe_opensRange, hi1r]
        have h' : ε.fromNormalization y ∈ (Set.range j0)ᶜ := hy
        rw [H0, Set.mem_singleton_iff] at h'
        show ε.fromNormalization y ∈ Set.range j1
        rw [h']; exact H1
    · intro b
      cases b
      · show LocallyOfFiniteType (i1.opensRange.ι ≫ ε.fromNormalization)
        rw [hιeq i1, Category.assoc, hi1c]
        infer_instance
      · show LocallyOfFiniteType (ε.toNormalization.opensRange.ι ≫ ε.fromNormalization)
        have hε' : ε.toNormalization ≫ ε.fromNormalization =
            Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ j0 := by
          rw [Scheme.Hom.toNormalization_fromNormalization]; exact hε
        rw [hιeq ε.toNormalization, Category.assoc, hε']
        infer_instance
  exact ⟨hfin, i1, hi1, hi1r, hi1c⟩

theorem wc_cp_smooth_two_chart_glue : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) (U0 U1 : Scheme.{u}) (i0 : U0 ⟶ Y) (i1 : U1 ⟶ Y), IsOpenImmersion i0 → IsOpenImmersion i1 → Set.range i0 ∪ Set.range i1 = Set.univ → SmoothOfRelativeDimension 1 (i0 ≫ fY) → SmoothOfRelativeDimension 1 (i1 ≫ fY) → SmoothOfRelativeDimension 1 fY :=
by
  intro K _ Y fY U0 U1 i0 i1 h0 h1 hcov hs0 hs1
  haveI := h0
  haveI := h1
  have hcov' : ∀ x : Y, ∃ (j : Bool) (y : (Bool.rec U0 U1 j : Scheme.{u})),
      (Bool.rec (motive := fun j => (Bool.rec U0 U1 j : Scheme.{u}) ⟶ Y) i0 i1 j) y = x := by
    intro x
    have hx : x ∈ Set.range i0 ∪ Set.range i1 := by rw [hcov]; exact Set.mem_univ x
    rcases hx with ⟨y, hy⟩ | ⟨y, hy⟩
    · exact ⟨false, y, hy⟩
    · exact ⟨true, y, hy⟩
  refine @IsZariskiLocalAtSource.of_openCover (@SmoothOfRelativeDimension.{u} 1)
    HasRingHomProperty.instIsZariskiLocalAtSource _ _ fY
    (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) Bool (fun j => (Bool.rec U0 U1 j : Scheme.{u}))
      (fun j => Bool.rec (motive := fun j => (Bool.rec U0 U1 j : Scheme.{u}) ⟶ Y) i0 i1 j) hcov'
      (fun j => by cases j <;> infer_instance)) ?_
  intro j
  cases j
  · exact hs0
  · exact hs1

theorem wc_cp_boundary_residue_finite : ∀ (K : Type u) [Field K] (P Y : Scheme.{u}) (sP : P ⟶ Spec (.of K)) (σ : Spec (.of K) ⟶ P) (ν : Y ⟶ P), IsFinite ν → σ ≫ sP = 𝟙 _ → ∀ d : Y, ν d = σ (IsLocalRing.closedPoint K) → ((ν ≫ sP).residueFieldMap d).hom.Finite :=
by
  intro K _ P Y sP σ ν hν hσ d hd
  haveI := hν
  have hb : (ν.residueFieldMap d).hom.Finite := by
    have hq : (ν.stalkMap d).hom.QuasiFinite := ν.quasiFiniteAt d
    have hr : (Y.residue d).hom.QuasiFinite :=
      RingHom.QuasiFinite.of_finite (RingHom.Finite.of_surjective _ (Y.residue_surjective d))
    have hc : ((Y.residue d).hom.comp (ν.stalkMap d).hom).QuasiFinite := hr.comp hq
    have he : (ν.residueFieldMap d).hom.comp (P.residue (ν d)).hom =
        (Y.residue d).hom.comp (ν.stalkMap d).hom := by
      rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, Scheme.residue_residueFieldMap]
    rw [← he] at hc
    have hq2 : (ν.residueFieldMap d).hom.QuasiFinite := RingHom.QuasiFinite.of_comp hc
    letI := (ν.residueFieldMap d).hom.toAlgebra
    haveI : Algebra.QuasiFinite (P.residueField (ν d)) (Y.residueField d) := hq2
    exact Module.Finite.of_quasiFinite
  have ha : ∀ (q : Spec (.of K)) (p : P), p = σ q → (sP.residueFieldMap p).hom.Finite := by
    intro q p hp
    subst hp
    have hiso : IsIso (σ ≫ sP) := by rw [hσ]; infer_instance
    have hoi : IsOpenImmersion (σ ≫ sP) := inferInstance
    have hiso2 : IsIso ((σ ≫ sP).residueFieldMap q) := inferInstance
    have hbij : Function.Bijective ((σ ≫ sP).residueFieldMap q).hom :=
      ConcreteCategory.bijective_of_isIso _
    have e := Scheme.residueFieldMap_comp σ sP q
    rw [e] at hbij
    have hbij' : Function.Bijective
        ((σ.residueFieldMap q).hom.comp (sP.residueFieldMap (σ q)).hom) := hbij
    have hinj : Function.Injective (σ.residueFieldMap q).hom :=
      RingHom.injective _
    apply RingHom.Finite.of_surjective
    intro y
    obtain ⟨x, hx⟩ := hbij'.2 ((σ.residueFieldMap q).hom y)
    exact ⟨x, hinj hx⟩
  have hfin := RingHom.Finite.comp hb (ha _ _ hd)
  rw [Scheme.residueFieldMap_comp]
  exact hfin

theorem wc_cp_algclosed_basechange_fibre_count : ∀ (L : Type u) [Field L] [IsAlgClosed L] (Ω : Type u) [Field Ω] [Algebra L Ω] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of L)) (D : Set Y), D.Finite → (∀ d ∈ D, (fY.residueFieldMap d).hom.Finite) → (Limits.pullback.fst fY (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) ⁻¹' D).Finite ∧ Nat.card ↥(Limits.pullback.fst fY (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) ⁻¹' D) = Nat.card ↥D :=
by
  intro L _ _ Ω _ _ Y fY D hD hfin

  have s1 : ∀ x : Y, (fY.residueFieldMap x).hom.Finite →
      Function.Bijective (fY.residueFieldMap x).hom := by
    intro x hx
    have h : IsLocalRing.closedPoint L = fY x := Subsingleton.elim _ _
    let ε : CommRingCat.of L ⟶ (Spec (.of L)).residueField (fY x) :=
      (stalkClosedPointIso (.of L)).inv ≫ (Spec (.of L)).residue (IsLocalRing.closedPoint L) ≫
        (Scheme.residueFieldCongr h).hom
    have hinj : Function.Injective ε.hom := ε.hom.injective
    have hsurj : Function.Surjective ε.hom := by
      have h1 := (ConcreteCategory.bijective_of_isIso (stalkClosedPointIso (CommRingCat.of L)).inv).2
      have h2 := Scheme.residue_surjective (Spec (.of L)) (IsLocalRing.closedPoint L)
      have h3 := (ConcreteCategory.bijective_of_isIso
        (Scheme.residueFieldCongr (X := Spec (.of L)) h).hom).2
      exact h3.comp (h2.comp h1)
    haveI : IsAlgClosed ((Spec (.of L)).residueField (fY x)) :=
      IsAlgClosed.of_ringEquiv L _ (RingEquiv.ofBijective ε.hom ⟨hinj, hsurj⟩)
    exact IsAlgClosed.ringHom_bijective_of_isIntegral _ (RingHom.IsIntegral.of_finite hx)

  have s2 : ∀ {X₀ Y₀ S₀ : Scheme.{u}} (f : X₀ ⟶ S₀) (g : Y₀ ⟶ S₀) (z₁ z₂ : ↥(Limits.pullback f g)),
      Limits.pullback.fst f g z₁ = Limits.pullback.fst f g z₂ →
      Limits.pullback.snd f g z₁ = Limits.pullback.snd f g z₂ →
      Function.Bijective (f.residueFieldMap (Limits.pullback.fst f g z₁)).hom → z₁ = z₂ := by
    intro X₀ Y₀ S₀ f g z₁ z₂ hx hy hb
    obtain ⟨⟨T₁, q₁⟩, rfl⟩ := Scheme.Pullback.carrierEquiv.symm.surjective z₁
    obtain ⟨⟨T₂, q₂⟩, rfl⟩ := Scheme.Pullback.carrierEquiv.symm.surjective z₂
    rw [Scheme.Pullback.carrierEquiv_symm_fst, Scheme.Pullback.carrierEquiv_symm_fst] at hx
    rw [Scheme.Pullback.carrierEquiv_symm_snd, Scheme.Pullback.carrierEquiv_symm_snd] at hy
    rw [Scheme.Pullback.carrierEquiv_symm_fst] at hb
    have e : T₁ = T₂ := Scheme.Pullback.Triplet.ext hx hy
    subst e
    have hpb := Scheme.Pullback.Triplet.isPullback_SpecMap_tensor T₁
    haveI hiso : IsIso (Spec.map ((Scheme.residueFieldCongr T₁.hx).inv ≫ f.residueFieldMap T₁.x)) := by
      rw [isIso_SpecMap_iff]
      exact hb.comp (ConcreteCategory.bijective_of_isIso (Scheme.residueFieldCongr T₁.hx).inv)
    haveI : IsIso (Spec.map T₁.tensorInr) := hpb.isIso_snd_of_isIso
    haveI : Subsingleton ↥(Spec T₁.tensor) :=
      (Scheme.Hom.homeomorph (Spec.map T₁.tensorInr)).injective.subsingleton
    rw [Subsingleton.elim q₁ q₂]

  let F : ↥(Limits.pullback.fst fY (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) ⁻¹' D) → ↥D :=
    fun z => ⟨Limits.pullback.fst fY (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) z.1, z.2⟩
  have hinj : Function.Injective F := by
    intro z₁ z₂ h
    have h' := congrArg Subtype.val h
    apply Subtype.ext
    exact s2 _ _ z₁.1 z₂.1 h' (Subsingleton.elim _ _) (s1 _ (hfin _ z₁.2))
  have hsurj : Function.Surjective F := by
    rintro ⟨d, hd⟩
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := fY) (g := Spec.map (CommRingCat.ofHom (algebraMap L Ω))) d
      (IsLocalRing.closedPoint Ω) (Subsingleton.elim _ _)
    refine ⟨⟨z, ?_⟩, Subtype.ext hz⟩
    show _ ∈ D
    rw [hz]
    exact hd
  haveI : Finite ↥D := hD.to_subtype
  haveI := Finite.of_injective F hinj
  exact ⟨Set.finite_coe_iff.mp this, Nat.card_congr (Equiv.ofBijective F ⟨hinj, hsurj⟩)⟩

theorem wc_etale_A1_curve_compactification_pair : ∀ (L : Type u) [Field L] [IsAlgClosed L] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra L Ω] (R : Type u) [CommRing R] [Algebra L R] [Algebra (Polynomial L) R] [IsScalarTower L (Polynomial L) R] [Algebra.Etale (Polynomial L) R], ∃ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of L)) (j : Spec (.of R) ⟶ Y) (jΩ : Spec (.of (TensorProduct L R Ω)) ⟶ Limits.pullback fY (Spec.map (CommRingCat.ofHom (algebraMap L Ω)))), IsProper fY ∧ SmoothOfRelativeDimension 1 fY ∧ SmoothOfRelativeDimension 1 (Limits.pullback.snd fY (Spec.map (CommRingCat.ofHom (algebraMap L Ω)))) ∧ IsOpenImmersion j ∧ IsOpenImmersion jΩ ∧ (Set.range j)ᶜ.Finite ∧ (Set.range jΩ)ᶜ.Finite ∧ Nat.card ↥((Set.range jΩ)ᶜ) = Nat.card ↥((Set.range j)ᶜ) :=
by
  intro L _ _ Ω _ _ _ R _ _ _ _ _
  classical

  obtain ⟨hred, ψ, hψfin, hnzd⟩ := wc_cp_etale_line_finite_model L R
  haveI := hred

  obtain ⟨P, sP, j0, j1, σ, hsP, hj0, hj1, hqc0, hqc1, hj0s, hj1s, hσ, hc0, hσ1, h10, -, htrans⟩ :=
    wc_cp_P1_charts L
  haveI := hsP
  haveI := hj0
  haveI := hj1
  haveI := hqc0
  haveI := hqc1
  haveI hψF : IsFinite (Spec.map (CommRingCat.ofHom ψ.toRingHom)) :=
    (IsFinite.SpecMap_iff _).mpr hψfin
  obtain ⟨ε, hε⟩ : ∃ ε : Spec (.of R) ⟶ P, ε = Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ j0 :=
    ⟨_, rfl⟩
  haveI : QuasiCompact ε := by rw [hε]; infer_instance
  haveI : QuasiSeparated ε := by rw [hε]; infer_instance

  have hB := wc_cp_integral_closure_infinity_finite L R ψ hψfin hnzd
  obtain ⟨hνfin, i1, hi1, hi1r, hi1c⟩ :=
    wc_cp_normalization_charts L P sP j0 j1 σ hj0 hj1 hj0s hj1s hc0 hσ1 h10 htrans R ψ hψfin hB
      ε hε
  haveI := hνfin
  haveI := hi1

  obtain ⟨hjo, hjr, -, -⟩ := wc_normalization_iso_over_finite_locus (Spec (.of R)) P ε
    (Scheme.Hom.opensRange j0) (isAffineOpen_opensRange j0)
    (Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ (Scheme.Hom.isoOpensRange j0).hom) inferInstance
    (by rw [Category.assoc, Scheme.Hom.isoOpensRange_hom_ι, hε])
  haveI := hjo
  rw [Scheme.Hom.coe_opensRange] at hjr

  have hjf : ε.toNormalization ≫ ε.fromNormalization ≫ sP =
      Spec.map (CommRingCat.ofHom (algebraMap L R)) := by
    rw [← Category.assoc, Scheme.Hom.toNormalization_fromNormalization, hε, Category.assoc, hj0s,
      ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    exact ψ.comp_algebraMap

  have hs0 : SmoothOfRelativeDimension 1 (ε.toNormalization ≫ ε.fromNormalization ≫ sP) := by
    rw [hjf]
    exact wc_cp_etale_line_smooth_one L R
  have hs1 : SmoothOfRelativeDimension 1 (i1 ≫ ε.fromNormalization ≫ sP) := by
    rw [← Category.assoc, hi1c, Category.assoc, hj1s, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact wc_cp_infinity_chart_smooth L R ψ hψfin hnzd (wc_cp_etale_line_smooth_one L R) hB
  have hcover : Set.range ε.toNormalization ∪ Set.range i1 = Set.univ := by
    rw [hjr, hi1r]
    ext y
    simp only [Set.mem_union, Set.mem_preimage, Set.mem_univ, iff_true]
    by_cases hy : ε.fromNormalization y ∈ Set.range j0
    · exact Or.inl hy
    · right
      have h' : ε.fromNormalization y ∈ (Set.range j0)ᶜ := hy
      rw [hc0, Set.mem_singleton_iff] at h'
      rw [h']
      exact hσ1
  have hsm : SmoothOfRelativeDimension 1 (ε.fromNormalization ≫ sP) :=
    wc_cp_smooth_two_chart_glue L ε.normalization (ε.fromNormalization ≫ sP) _ _
      ε.toNormalization i1 hjo hi1 hcover hs0 hs1
  haveI := smoothOfRelativeDimension_isStableUnderBaseChange 1
  have hsmΩ : SmoothOfRelativeDimension 1 (Limits.pullback.snd (ε.fromNormalization ≫ sP)
      (Spec.map (CommRingCat.ofHom (algebraMap L Ω)))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
      (IsPullback.of_hasPullback _ _) hsm

  have hcompl : (Set.range ε.toNormalization)ᶜ =
      ε.fromNormalization ⁻¹' {σ (IsLocalRing.closedPoint L)} := by
    rw [hjr, ← Set.preimage_compl, hc0]
  have hDfin : (Set.range ε.toNormalization)ᶜ.Finite := by
    rw [hcompl]
    exact Scheme.Hom.finite_preimage_singleton _ _
  have hres : ∀ d ∈ (Set.range ε.toNormalization)ᶜ,
      ((ε.fromNormalization ≫ sP).residueFieldMap d).hom.Finite := by
    intro d hd
    rw [hcompl] at hd
    exact wc_cp_boundary_residue_finite L P ε.normalization sP σ ε.fromNormalization hνfin hσ d hd

  obtain ⟨hfinΩ, hcardΩ⟩ := wc_cp_algclosed_basechange_fibre_count L Ω ε.normalization
    (ε.fromNormalization ≫ sP) _ hDfin hres

  have hmr : Set.range (Limits.pullback.map (ε.toNormalization ≫ ε.fromNormalization ≫ sP)
      (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) (ε.fromNormalization ≫ sP)
      (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) ε.toNormalization (𝟙 _) (𝟙 _)
      (by simp) (by simp)) =
      (Limits.pullback.fst (ε.fromNormalization ≫ sP)
        (Spec.map (CommRingCat.ofHom (algebraMap L Ω)))) ⁻¹' Set.range ε.toNormalization := by
    rw [Scheme.Pullback.range_map]
    simp
  have hr : ∀ {A B C : Scheme.{u}} (e : A ≅ B) (g : B ⟶ C),
      Set.range (e.hom ≫ g) = Set.range g := by
    intro A B C e g
    ext x
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨e.hom a, (Scheme.Hom.comp_apply _ _ _).symm⟩
    · rintro ⟨b, rfl⟩
      refine ⟨e.inv b, ?_⟩
      rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id_assoc]
  refine ⟨ε.normalization, ε.fromNormalization ≫ sP, ε.toNormalization,
    (pullbackSpecIso L R Ω).symm.hom ≫ (Limits.pullback.congrHom hjf rfl).symm.hom ≫
      Limits.pullback.map (ε.toNormalization ≫ ε.fromNormalization ≫ sP)
        (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) (ε.fromNormalization ≫ sP)
        (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) ε.toNormalization (𝟙 _) (𝟙 _)
        (by simp) (by simp),
    inferInstance, hsm, hsmΩ, hjo, inferInstance, hDfin, ?_, ?_⟩
  · rw [hr, hr, hmr, ← Set.preimage_compl]
    exact hfinΩ
  · rw [hr, hr, hmr, ← Set.preimage_compl]
    exact hcardΩ

theorem wc_curve_pic_ell_torsion_descent : ∀ (L : Type u) [Field L] [IsAlgClosed L] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra L Ω] (R : Type u) [CommRing R] [Algebra L R] [Algebra (Polynomial L) R] [IsScalarTower L (Polynomial L) R] [Algebra.Etale (Polynomial L) R] (ℓ : ℕ), ℓ.Prime → (ℓ : L) ≠ 0 → ∀ (M : Type u) [AddCommGroup M] [Module (TensorProduct L R Ω) M], Module.Invertible (TensorProduct L R Ω) M → Nonempty (TensorPower (TensorProduct L R Ω) ℓ M ≃ₗ[TensorProduct L R Ω] TensorProduct L R Ω) → ∃ (N : Type u) (_ : AddCommGroup N) (_ : Module R N), Module.Invertible R N ∧ Nonempty (TensorPower R ℓ N ≃ₗ[R] R) ∧ Nonempty (TensorProduct R (TensorProduct L R Ω) N ≃ₗ[TensorProduct L R Ω] M) :=
by
  intro L _ _ Ω _ _ _ R _ _ _ _ _ ℓ hℓ hℓL M _ _ hMinv hμ
  classical
  haveI := hMinv
  have s3 : ∀ (A : Type u) [CommRing A] (P : Type u) [AddCommGroup P] [Module A P]
      [Module.Invertible A P] (n : ℕ),
      CommRing.Pic.mk A P ^ n = 1 ↔ Nonempty (TensorPower A n P ≃ₗ[A] A) := by
    intro A _ P _ _ _ n
    have key : ∀ k : ℕ, ∃ _ : Module.Invertible A (TensorPower A k P),
        CommRing.Pic.mk A (TensorPower A k P) = CommRing.Pic.mk A P ^ k := by
      intro k
      induction k with
      | zero =>
        let e : TensorPower A 0 P ≃ₗ[A] A := PiTensorProduct.isEmptyEquiv (Fin 0)
        have : Module.Invertible A (TensorPower A 0 P) := Module.Invertible.congr e.symm
        refine ⟨this, ?_⟩
        rw [pow_zero, ← CommRing.Pic.mk_self, CommRing.Pic.mk_eq_mk_iff]
        exact ⟨e⟩
      | succ k ih =>
        obtain ⟨hk, hmk⟩ := ih
        let e1 : TensorPower A 1 P ≃ₗ[A] P := PiTensorProduct.subsingletonEquiv 0
        let e : TensorPower A (k + 1) P ≃ₗ[A] TensorProduct A (TensorPower A k P) P :=
          (TensorPower.mulEquiv).symm.trans (TensorProduct.congr (LinearEquiv.refl _ _) e1)
        have : Module.Invertible A (TensorPower A (k + 1) P) := Module.Invertible.congr e.symm
        refine ⟨this, ?_⟩
        rw [pow_succ, ← hmk, ← CommRing.Pic.mk_tensor, CommRing.Pic.mk_eq_mk_iff]
        exact ⟨e⟩
    obtain ⟨hn, hmk⟩ := key n
    rw [← hmk, ← CommRing.Pic.mk_self, CommRing.Pic.mk_eq_mk_iff]
  have hℓΩ : (ℓ : Ω) ≠ 0 := by
    rw [← map_natCast (algebraMap L Ω)]
    exact (map_ne_zero_iff _ (algebraMap L Ω).injective).mpr hℓL
  obtain ⟨Y, fY, j, jΩ, hprop, hsm, hsmΩ, hj, hjΩ, hfin, hfinΩ, hcard⟩ :=
    wc_etale_A1_curve_compactification_pair L Ω R
  haveI := hprop
  haveI := hsm
  haveI := hsmΩ
  haveI := hj
  haveI := hjΩ
  obtain ⟨hPS, hUS, -, hcS⟩ := wc_affine_curve_kummer_count Ω ℓ hℓ hℓΩ
    (Limits.pullback fY (Spec.map (CommRingCat.ofHom (algebraMap L Ω))))
    (Limits.pullback.snd fY (Spec.map (CommRingCat.ofHom (algebraMap L Ω))))
    (TensorProduct L R Ω) jΩ hfinΩ
  obtain ⟨-, -, h0pos, hcR⟩ := wc_affine_curve_kummer_count L ℓ hℓ hℓL Y fY R j hfin
  have h0 := wc_et_alg_closed_field_invariance_card L Y fY Ω
    (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) ℓ hℓL 0
  have h1 := wc_et_alg_closed_field_invariance_card L Y fY Ω
    (Spec.map (CommRingCat.ofHom (algebraMap L Ω))) ℓ hℓL 1
  rw [h0, h1, hcard] at hcS
  have hprod : Nat.card {x : CommRing.Pic R // x ^ ℓ = 1} *
        Nat.card (Rˣ ⧸ (powMonoidHom ℓ : Rˣ →* Rˣ).range) =
      Nat.card {x : CommRing.Pic (TensorProduct L R Ω) // x ^ ℓ = 1} *
        Nat.card ((TensorProduct L R Ω)ˣ ⧸
          (powMonoidHom ℓ : (TensorProduct L R Ω)ˣ →* (TensorProduct L R Ω)ˣ).range) := by
    apply Nat.eq_of_mul_eq_mul_right h0pos
    rw [hcR, hcS]
  let β := CommRing.Pic.mapAlgebra R (TensorProduct L R Ω)
  let βℓ : {x : CommRing.Pic R // x ^ ℓ = 1} →
      {y : CommRing.Pic (TensorProduct L R Ω) // y ^ ℓ = 1} :=
    fun x => ⟨β x.1, by rw [← map_pow, x.2, map_one]⟩
  have hβinj : Function.Injective βℓ := by
    intro x y hxy
    apply Subtype.ext
    exact wc_pic_base_change_alg_closed_injective L Ω R (congrArg Subtype.val hxy)
  let f : Rˣ →* (TensorProduct L R Ω)ˣ :=
    Units.map (algebraMap R (TensorProduct L R Ω)).toMonoidHom
  have hle : (powMonoidHom ℓ : Rˣ →* Rˣ).range ≤ Subgroup.comap f
      (powMonoidHom ℓ : (TensorProduct L R Ω)ˣ →* (TensorProduct L R Ω)ˣ).range := by
    rintro _ ⟨w, rfl⟩
    exact ⟨f w, by simp [powMonoidHom_apply, map_pow]⟩
  let γ := QuotientGroup.map _ _ f hle
  have hγinj : Function.Injective γ := by
    rw [injective_iff_map_eq_one]
    intro a ha
    induction a using QuotientGroup.induction_on with
    | H v =>
      rw [QuotientGroup.map_mk, QuotientGroup.eq_one_iff] at ha
      obtain ⟨w, hw⟩ := ha
      rw [QuotientGroup.eq_one_iff]
      have hw' : (w : TensorProduct L R Ω) ^ ℓ =
          algebraMap R (TensorProduct L R Ω) (v : R) := by
        have := congrArg Units.val hw
        simpa [f, powMonoidHom_apply] using this
      obtain ⟨w₀, hw₀⟩ := wc_units_pow_base_change_alg_closed L Ω R ℓ v w hw'
      exact ⟨w₀, Units.ext (by simpa [powMonoidHom_apply] using hw₀)⟩
  haveI := hPS
  haveI := hUS
  haveI : Finite {x : CommRing.Pic R // x ^ ℓ = 1} := Finite.of_injective βℓ hβinj
  haveI : Finite (Rˣ ⧸ (powMonoidHom ℓ : Rˣ →* Rˣ).range) := Finite.of_injective γ hγinj
  have hPle := Nat.card_le_card_of_injective βℓ hβinj
  have hUle := Nat.card_le_card_of_injective γ hγinj
  haveI : Nonempty {x : CommRing.Pic R // x ^ ℓ = 1} := ⟨⟨1, one_pow ℓ⟩⟩
  have hURpos : 0 < Nat.card (Rˣ ⧸ (powMonoidHom ℓ : Rˣ →* Rˣ).range) := Nat.card_pos
  have hPge : Nat.card {y : CommRing.Pic (TensorProduct L R Ω) // y ^ ℓ = 1} ≤
      Nat.card {x : CommRing.Pic R // x ^ ℓ = 1} := by
    by_contra hcon
    push_neg at hcon
    have h2 := Nat.mul_lt_mul_of_pos_right hcon hURpos
    have h3 := Nat.mul_le_mul_left
      (Nat.card {y : CommRing.Pic (TensorProduct L R Ω) // y ^ ℓ = 1}) hUle
    omega
  have hbij := hβinj.bijective_of_nat_card_le hPge
  have hMpow : CommRing.Pic.mk (TensorProduct L R Ω) M ^ ℓ = 1 :=
    (s3 (TensorProduct L R Ω) M ℓ).mpr hμ
  obtain ⟨x, hx⟩ := hbij.2 ⟨_, hMpow⟩
  have hx1 : β x.1 = CommRing.Pic.mk (TensorProduct L R Ω) M := congrArg Subtype.val hx
  have hmk : CommRing.Pic.mk R x.1.AsModule = x.1 := by
    rw [CommRing.Pic.ext_iff]
    exact ⟨CommRing.Pic.mk.linearEquiv R x.1.AsModule⟩
  letI : AddCommGroup x.1.AsModule := Module.addCommMonoidToAddCommGroup R
  refine ⟨x.1.AsModule, inferInstance, inferInstance, inferInstance, ?_, ?_⟩
  · exact (s3 R x.1.AsModule ℓ).mp (by rw [hmk]; exact x.2)
  · have h := hx1
    rw [CommRing.Pic.mapAlgebra_apply, CommRing.Pic.mk_eq_mk_iff] at h
    exact h

theorem wc_cud_noetherian_locally_domain_pi : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R], (∀ (m : Ideal R) [m.IsMaximal], IsDomain (Localization.AtPrime m)) → ∃ (k : ℕ) (P : Fin k → Ideal R), (∀ i, (P i).IsPrime) ∧ Function.Bijective (RingHom.pi fun i => Ideal.Quotient.mk (P i)) :=
by
  intro R _ _ hloc
  classical
  have hQprime : ∀ (m : Ideal R) [m.IsMaximal],
      (RingHom.ker (algebraMap R (Localization.AtPrime m))).IsPrime := by
    intro m _
    haveI := hloc m
    exact RingHom.ker_isPrime _
  have hQle : ∀ (m : Ideal R) [m.IsMaximal] (p : Ideal R), p.IsPrime → p ≤ m →
      RingHom.ker (algebraMap R (Localization.AtPrime m)) ≤ p := by
    intro m _ p hp hpm x hx
    rw [RingHom.mem_ker] at hx
    obtain ⟨s, hs⟩ := (IsLocalization.map_eq_zero_iff m.primeCompl (Localization.AtPrime m) x).mp hx
    have hsx : (s : R) * x ∈ p := by rw [hs]; exact p.zero_mem
    rcases hp.mem_or_mem hsx with h | h
    · exact absurd (hpm h) s.2
    · exact h
  have hmin : ∀ p ∈ minimalPrimes R, Minimal Ideal.IsPrime p := by
    intro p hp
    rw [minimalPrimes_eq_minimals] at hp
    exact hp
  have key : ∀ (m : Ideal R) [m.IsMaximal] (p : Ideal R), p ∈ minimalPrimes R → p ≤ m →
      RingHom.ker (algebraMap R (Localization.AtPrime m)) = p := by
    intro m _ p hp hpm
    exact (hmin p hp).eq_of_le (hQprime m) (hQle m p (hmin p hp).prop hpm)
  haveI : Finite (minimalPrimes R) := (minimalPrimes.finite_of_isNoetherianRing R).to_subtype
  let e := Finite.equivFin (minimalPrimes R)
  refine ⟨Nat.card (minimalPrimes R), fun i => ((e.symm i : minimalPrimes R) : Ideal R), ?_, ?_, ?_⟩
  · intro i
    exact (hmin _ (e.symm i).2).prop
  · rw [injective_iff_map_eq_zero]
    intro x hx
    have hxp : ∀ p ∈ minimalPrimes R, x ∈ p := by
      intro p hp
      have h := congrFun hx (e ⟨p, hp⟩)
      rw [RingHom.pi_apply, Pi.zero_apply, Ideal.Quotient.eq_zero_iff_mem] at h
      have h' : x ∈ ((e.symm (e ⟨p, hp⟩) : minimalPrimes R) : Ideal R) := h
      rw [Equiv.symm_apply_apply] at h'
      exact h'
    have hspan : Ideal.span {x} = ⊥ := by
      apply ideal_eq_bot_of_localization'
      intro J hJ
      haveI := hJ
      haveI := hQprime J
      rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_eq_bot]
      obtain ⟨p, hp, hpQ⟩ := Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal R))
        (J := RingHom.ker (algebraMap R (Localization.AtPrime J))) bot_le
      exact (RingHom.mem_ker).mp (hpQ (hxp p hp))
    exact Ideal.span_singleton_eq_bot.mp hspan
  · intro y
    have hpair : Pairwise fun i j =>
        IsCoprime ((e.symm i : Ideal R)) ((e.symm j : Ideal R)) := by
      intro i j hij
      rw [Ideal.isCoprime_iff_sup_eq]
      by_contra hne
      obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
      haveI := hm
      have h1 := key m _ (e.symm i).2 (le_sup_left.trans hle)
      have h2 := key m _ (e.symm j).2 (le_sup_right.trans hle)
      exact hij (e.symm.injective (Subtype.ext (h1.symm.trans h2)))
    obtain ⟨r, hr⟩ := Ideal.pi_quotient_surjective hpair y
    exact ⟨r, funext fun i => by rw [RingHom.pi_apply]; exact hr i⟩

theorem wc_cud_units_pi_reduction : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [Algebra L R] (Ω : Type u) [Field Ω] [Algebra L Ω] (n : ℕ) (k : ℕ) (P : Fin k → Ideal R), Function.Bijective (RingHom.pi fun i => Ideal.Quotient.mk (P i)) → (∀ i, ∀ u : (TensorProduct L (R ⧸ P i) Ω)ˣ, ∃ (v : (R ⧸ P i)ˣ) (w : (TensorProduct L (R ⧸ P i) Ω)ˣ), (u : TensorProduct L (R ⧸ P i) Ω) = algebraMap (R ⧸ P i) (TensorProduct L (R ⧸ P i) Ω) v * (w : TensorProduct L (R ⧸ P i) Ω) ^ n) → ∀ u : (TensorProduct L R Ω)ˣ, ∃ (v : Rˣ) (w : (TensorProduct L R Ω)ˣ), (u : TensorProduct L R Ω) = algebraMap R (TensorProduct L R Ω) v * (w : TensorProduct L R Ω) ^ n :=
by
  intro L _ R _ _ Ω _ _ n k P hbij hloc u
  classical
  let g : R →ₐ[L] ∀ i, R ⧸ P i := AlgHom.pi (fun i => Ideal.Quotient.mkₐ L (P i))
  have hg : Function.Bijective g := hbij
  let e : R ≃ₐ[L] ∀ i, R ⧸ P i := AlgEquiv.ofBijective g hg
  have he : ∀ r i, e r i = Ideal.Quotient.mk (P i) r := fun r i => rfl
  let Ψ : TensorProduct L R Ω ≃ₐ[L] ∀ i, TensorProduct L (R ⧸ P i) Ω :=
    ((Algebra.TensorProduct.congr e AlgEquiv.refl).trans
      (Algebra.TensorProduct.comm L (∀ i, R ⧸ P i) Ω)).trans
      ((Algebra.TensorProduct.piRight L L Ω (fun i => R ⧸ P i)).trans
        (AlgEquiv.piCongrRight (fun i => Algebra.TensorProduct.comm L Ω (R ⧸ P i))))
  have hΨ : ∀ r : R, Ψ (algebraMap R (TensorProduct L R Ω) r) =
      fun i => algebraMap (R ⧸ P i) (TensorProduct L (R ⧸ P i) Ω) (Ideal.Quotient.mk (P i) r) := by
    intro r
    funext i
    simp only [Ψ, AlgEquiv.trans_apply, Algebra.TensorProduct.algebraMap_apply,
      Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul,
      Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.piRight_tmul,
      AlgEquiv.piCongrRight_apply, Algebra.algebraMap_self, RingHom.id_apply]
    rfl
  have hunit : ∀ i, ∃ (v : (R ⧸ P i)ˣ) (w : (TensorProduct L (R ⧸ P i) Ω)ˣ),
      Ψ (u : TensorProduct L R Ω) i =
        algebraMap (R ⧸ P i) (TensorProduct L (R ⧸ P i) Ω) v * (w : TensorProduct L (R ⧸ P i) Ω) ^ n := by
    intro i
    obtain ⟨v, w, h⟩ := hloc i (Units.map
      ((Pi.evalMonoidHom (fun i => TensorProduct L (R ⧸ P i) Ω) i).comp
        Ψ.toRingEquiv.toMonoidHom) u)
    exact ⟨v, w, h⟩
  choose v w hvw using hunit
  let V : (∀ i, R ⧸ P i)ˣ :=
    ⟨fun i => (v i : R ⧸ P i), fun i => ((v i)⁻¹ : (R ⧸ P i)ˣ),
      by funext i; simp, by funext i; simp⟩
  let W : (∀ i, TensorProduct L (R ⧸ P i) Ω)ˣ :=
    ⟨fun i => (w i : TensorProduct L (R ⧸ P i) Ω), fun i => ((w i)⁻¹ : (TensorProduct L (R ⧸ P i) Ω)ˣ),
      by funext i; simp, by funext i; simp⟩
  refine ⟨Units.map e.symm.toRingEquiv.toMonoidHom V, Units.map Ψ.symm.toRingEquiv.toMonoidHom W, ?_⟩
  apply Ψ.injective
  rw [map_mul, map_pow, hΨ]
  funext i
  have h1 : Ideal.Quotient.mk (P i) ((Units.map e.symm.toRingEquiv.toMonoidHom V : Rˣ) : R) = v i := by
    rw [← he]
    show e (e.symm (V : ∀ i, R ⧸ P i)) i = v i
    rw [AlgEquiv.apply_symm_apply]
  have h2 : Ψ ((Units.map Ψ.symm.toRingEquiv.toMonoidHom W : (TensorProduct L R Ω)ˣ) : TensorProduct L R Ω) =
      (W : ∀ i, TensorProduct L (R ⧸ P i) Ω) := by
    show Ψ (Ψ.symm _) = _
    rw [AlgEquiv.apply_symm_apply]
  rw [Pi.mul_apply, Pi.pow_apply, h1, h2, hvw i]

theorem wc_cud_algclosed_point_nonvanishing : ∀ (L : Type u) [Field L] [IsAlgClosed L] (T : Type u) [CommRing T] [IsDomain T] [Algebra L T] [Algebra.FiniteType L T] (t : T), t ≠ 0 → ∃ y : T →ₐ[L] L, y t ≠ 0 :=
by
  intro L _ _ T _ _ _ _ t ht
  haveI : IsJacobsonRing T := isJacobsonRing_of_finiteType (A := L)
  have hj : (⊥ : Ideal T).jacobson = ⊥ :=
    IsJacobsonRing.out' _ (Ideal.isRadical_bot_iff.mpr inferInstance)
  have hr' : t ∉ (⊥ : Ideal T).jacobson := by rw [hj, Ideal.mem_bot]; exact ht
  rw [Ideal.jacobson, Ideal.mem_sInf] at hr'
  push_neg at hr'
  obtain ⟨M, ⟨-, hM⟩, hrM⟩ := hr'
  haveI := hM
  letI : Field (T ⧸ M) := Ideal.Quotient.field M
  haveI : Algebra.FiniteType L (T ⧸ M) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ L M) (Ideal.Quotient.mkₐ_surjective L M)
  haveI : Module.Finite L (T ⧸ M) := finite_of_finite_type_of_isJacobsonRing L (T ⧸ M)
  haveI : Algebra.IsIntegral L (T ⧸ M) := Algebra.IsIntegral.of_finite L _
  have hb : Function.Bijective (algebraMap L (T ⧸ M)) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  let e : L ≃ₐ[L] T ⧸ M := AlgEquiv.ofBijective (Algebra.ofId L (T ⧸ M)) hb
  refine ⟨e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ L M), ?_⟩
  intro h0
  apply hrM
  have h1 : Ideal.Quotient.mkₐ L M t = 0 := by
    have h2 := congrArg e h0
    simpa using h2
  exact Ideal.Quotient.eq_zero_iff_mem.mp h1

theorem wc_cud_units_fg_descent : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [Algebra L R] (Ω : Type u) [Field Ω] [Algebra L Ω] (u : (TensorProduct L R Ω)ˣ), ∃ T : Subalgebra L Ω, T.FG ∧ ∃ u' : (TensorProduct L R T)ˣ, Algebra.TensorProduct.map (AlgHom.id L R) T.val (u' : TensorProduct L R T) = u :=
by
  intro L _ R _ _ Ω _ _ u
  classical
  obtain ⟨S, hS⟩ := TensorProduct.exists_finset (u : TensorProduct L R Ω)
  obtain ⟨S', hS'⟩ :=
    TensorProduct.exists_finset ((u⁻¹ : (TensorProduct L R Ω)ˣ) : TensorProduct L R Ω)
  let s : Finset Ω := S.image Prod.snd ∪ S'.image Prod.snd
  let T : Subalgebra L Ω := Algebra.adjoin L (↑s : Set Ω)
  have hT : T.FG := Subalgebra.fg_adjoin_finset s
  have memS : ∀ i ∈ S, i.2 ∈ T := fun i hi =>
    Algebra.subset_adjoin
      (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem Prod.snd hi)))
  have memS' : ∀ i ∈ S', i.2 ∈ T := fun i hi =>
    Algebra.subset_adjoin
      (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_image_of_mem Prod.snd hi)))
  let ι := Algebra.TensorProduct.map (AlgHom.id L R) T.val
  let a : TensorProduct L R T := ∑ i ∈ S.attach, i.1.1 ⊗ₜ[L] (⟨i.1.2, memS i.1 i.2⟩ : T)
  let b : TensorProduct L R T := ∑ i ∈ S'.attach, i.1.1 ⊗ₜ[L] (⟨i.1.2, memS' i.1 i.2⟩ : T)
  have ha : ι a = (u : TensorProduct L R Ω) := by
    rw [hS]
    simp only [a, ι, map_sum, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Subalgebra.coe_val]
    exact Finset.sum_attach S (fun i => i.1 ⊗ₜ[L] i.2)
  have hb : ι b = ((u⁻¹ : (TensorProduct L R Ω)ˣ) : TensorProduct L R Ω) := by
    rw [hS']
    simp only [b, ι, map_sum, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Subalgebra.coe_val]
    exact Finset.sum_attach S' (fun i => i.1 ⊗ₜ[L] i.2)
  have hinj : Function.Injective ι := by
    let f : T →ₗ[L] Ω := T.val.toLinearMap
    have hf : Function.Injective f := fun x y h => Subtype.val_injective h
    have h1 : Function.Injective (LinearMap.lTensor R f) :=
      Module.Flat.lTensor_preserves_injective_linearMap f hf
    have h2 : ∀ x, ι x = LinearMap.lTensor R f x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul r t => rfl
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    intro x y hxy
    apply h1
    rw [← h2, ← h2]
    exact hxy
  have hab : a * b = 1 := hinj (by rw [map_mul, ha, hb, Units.mul_inv, map_one])
  have hba : b * a = 1 := hinj (by rw [map_mul, ha, hb, Units.inv_mul, map_one])
  exact ⟨T, hT, ⟨a, b, hab, hba⟩, ha⟩

theorem wc_cud_tensor_const_of_specializations : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [Nontrivial R] [Algebra L R] (T : Type u) [CommRing T] [Algebra L T], (∀ t : T, t ≠ 0 → ∃ y : T →ₐ[L] L, y t ≠ 0) → ∀ g : TensorProduct L R T, (∀ y : T →ₐ[L] L, Algebra.TensorProduct.lift (AlgHom.id R R) ((Algebra.ofId L R).comp y) (fun _ _ => Commute.all _ _) g ∈ Set.range (algebraMap L R)) → ∃ t : T, g = Algebra.TensorProduct.includeRight t :=
by
  intro L _ R _ _ _ T _ _ hsep g hg
  classical
  have hs : LinearIndepOn L id ({1} : Set R) := LinearIndepOn.singleton (v := id) one_ne_zero
  set b := Module.Basis.extend hs with hb
  have hmem : (1 : R) ∈ hs.extend (Set.subset_univ _) :=
    hs.subset_extend _ (Set.mem_singleton 1)
  set i₀ : hs.extend (Set.subset_univ _) := ⟨1, hmem⟩ with hi₀
  have hb1 : b i₀ = 1 := by
    rw [hb, Module.Basis.coe_extend]
  have hcoord : ∀ (y : T →ₐ[L] L) (z : TensorProduct L R T) (i : hs.extend (Set.subset_univ _)),
      b.repr (Algebra.TensorProduct.lift (AlgHom.id R R) ((Algebra.ofId L R).comp y)
        (fun _ _ => Commute.all _ _) z) i =
        y (TensorProduct.equivFinsuppOfBasisLeft b z i) := by
    intro y z i
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul r t =>
      rw [Algebra.TensorProduct.lift_tmul, TensorProduct.equivFinsuppOfBasisLeft_apply_tmul_apply]
      simp only [AlgHom.id_apply, AlgHom.comp_apply, Algebra.ofId_apply]
      rw [← Algebra.commutes, ← Algebra.smul_def, map_smul, Finsupp.smul_apply, smul_eq_mul,
        map_smul, smul_eq_mul, mul_comm]
    | add z₁ z₂ h₁ h₂ =>
      simp only [map_add, Finsupp.add_apply, h₁, h₂]
  set c := TensorProduct.equivFinsuppOfBasisLeft b g with hc
  have hci : ∀ i, i ≠ i₀ → c i = 0 := by
    intro i hi
    by_contra hne
    obtain ⟨y, hy⟩ := hsep (c i) hne
    obtain ⟨a, ha⟩ := hg y
    apply hy
    have h1 : a • (1 : R) = a • b i₀ := by rw [hb1]
    rw [hc, ← hcoord y g i, ← ha, Algebra.algebraMap_eq_smul_one, h1, map_smul,
      Module.Basis.repr_self, Finsupp.smul_apply, Finsupp.single_apply, if_neg (Ne.symm hi),
      smul_zero]
  have hcs : c = Finsupp.single i₀ (c i₀) := by
    ext i
    by_cases h : i = i₀
    · rw [h, Finsupp.single_eq_same]
    · rw [hci i h, Finsupp.single_apply, if_neg (Ne.symm h)]
  refine ⟨c i₀, ?_⟩
  have hg' : g = (TensorProduct.equivFinsuppOfBasisLeft b).symm c := by
    rw [hc, LinearEquiv.symm_apply_apply]
  rw [hg']
  conv_lhs => rw [hcs]
  rw [TensorProduct.equivFinsuppOfBasisLeft_symm_apply, Finsupp.sum_single_index (by simp), hb1,
    Algebra.TensorProduct.includeRight_apply]

theorem wc_cud_specialization_valuation_gauss : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [IsDomain R] [Algebra L R] (V : ValuationSubring (FractionRing R)), (∀ c : L, algebraMap L (FractionRing R) c ∈ V) → ∀ (T : Type u) [CommRing T] [Algebra L T], (∀ (K : Type u) [Field K] [Algebra L K], IsDomain (TensorProduct L K T)) → ∀ g : (TensorProduct L R T)ˣ, ∃ a : FractionRing R, a ≠ 0 ∧ ∀ y : T →ₐ[L] L, ∃ e : Vˣ, algebraMap R (FractionRing R) (Algebra.TensorProduct.lift (AlgHom.id R R) ((Algebra.ofId L R).comp y) (fun _ _ => Commute.all _ _) (g : TensorProduct L R T)) = a * ((e : V) : FractionRing R) :=
by
  intro L _ R _ _ _ V hV T _ _ hdom g
  classical

  have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra L A] [Algebra L B] (J : Type u)
      (τ : Module.Basis J L T) (φ : A →ₐ[L] B) (z : TensorProduct L A T),
      (Algebra.TensorProduct.basis B τ).repr (Algebra.TensorProduct.map φ (AlgHom.id L T) z) =
        Finsupp.mapRange φ (map_zero φ) ((Algebra.TensorProduct.basis A τ).repr z) := by
    intro A B _ _ _ _ J τ φ z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul a t =>
      ext j
      simp [Algebra.TensorProduct.basis_repr_tmul, Finsupp.mapRange_apply,
        Algebra.TensorProduct.map_tmul, map_mul, AlgHom.commutes]
    | add x₁ x₂ hx₁ hx₂ =>
      rw [map_add, map_add, hx₁, hx₂, map_add, Finsupp.mapRange_add (map_add φ)]

  have s2 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra L A] [Algebra L B]
      (φ : A →ₐ[L] B) (y : T →ₐ[L] L) (z : TensorProduct L A T),
      Algebra.TensorProduct.lift (AlgHom.id B B) ((Algebra.ofId L B).comp y)
          (fun _ _ => Commute.all _ _) (Algebra.TensorProduct.map φ (AlgHom.id L T) z) =
        φ (Algebra.TensorProduct.lift (AlgHom.id A A) ((Algebra.ofId L A).comp y)
          (fun _ _ => Commute.all _ _) z) := by
    intro A B _ _ _ _ φ y z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul a t =>
      simp [Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.map_tmul, Algebra.ofId_apply,
        map_mul, AlgHom.commutes]
    | add x₁ x₂ hx₁ hx₂ => rw [map_add, map_add, hx₁, hx₂, map_add, map_add]

  letI : Algebra L V := (RingHom.codRestrict (algebraMap L (FractionRing R)) V hV).toAlgebra
  haveI : IsScalarTower L V (FractionRing R) := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let φR := IsScalarTower.toAlgHom L R (FractionRing R)
  let φV := IsScalarTower.toAlgHom L V (FractionRing R)
  let φκ := IsScalarTower.toAlgHom L V (IsLocalRing.ResidueField V)
  have hφR : ∀ x : R, φR x = algebraMap R (FractionRing R) x := fun _ => rfl
  have hφV : ∀ x : V, φV x = (x : FractionRing R) := fun _ => rfl
  have hφκ : ∀ x : V, φκ x = IsLocalRing.residue V x := fun x => by
    rw [IsScalarTower.toAlgHom_apply, IsLocalRing.ResidueField.algebraMap_eq]
  let τ := Module.Basis.ofVectorSpace L T

  have hιinj : Function.Injective (Algebra.TensorProduct.map φV (AlgHom.id L T)) := by
    intro z₁ z₂ hz
    have h := congrArg (Algebra.TensorProduct.basis (FractionRing R) τ).repr hz
    rw [s1 V (FractionRing R) _ τ φV, s1 V (FractionRing R) _ τ φV] at h
    apply (Algebra.TensorProduct.basis V τ).repr.injective
    ext j
    have hj := DFunLike.congr_fun h j
    rw [Finsupp.mapRange_apply, Finsupp.mapRange_apply, hφV, hφV] at hj
    exact hj

  have s3 : ∀ z : TensorProduct L (FractionRing R) T, z ≠ 0 →
      ∃ (a : FractionRing R) (h : TensorProduct L V T), a ≠ 0 ∧
        z = algebraMap (FractionRing R) (TensorProduct L (FractionRing R) T) a *
          Algebra.TensorProduct.map φV (AlgHom.id L T) h ∧
        Algebra.TensorProduct.map φκ (AlgHom.id L T) h ≠ 0 := by
    intro z hz
    set c := (Algebra.TensorProduct.basis (FractionRing R) τ).repr z with hc
    have hc0 : c ≠ 0 := by
      intro h0; apply hz
      exact (Algebra.TensorProduct.basis (FractionRing R) τ).repr.injective
        (h0.trans (map_zero _).symm)
    obtain ⟨j₀, hj₀, hmax⟩ := Finset.exists_max_image c.support (fun j => V.valuation (c j))
      (Finsupp.support_nonempty_iff.mpr hc0)
    set a := c j₀ with ha
    have ha0 : a ≠ 0 := Finsupp.mem_support_iff.mp hj₀
    have hmem : ∀ j, c j / a ∈ V := by
      intro j
      by_cases hj : c j = 0
      · rw [hj, zero_div]; exact V.zero_mem
      · rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div]
        have hpos : 0 < V.valuation a := (Valuation.pos_iff _).mpr ha0
        rw [div_le_one₀ hpos]
        exact hmax j (Finsupp.mem_support_iff.mpr hj)
    let d : _ →₀ V := Finsupp.onFinset c.support (fun j => ⟨c j / a, hmem j⟩) (by
      intro j hj
      rw [Finsupp.mem_support_iff]
      intro h0; apply hj
      apply Subtype.ext
      simp [h0])
    have hd : ∀ j, (d j : FractionRing R) = c j / a := fun j => by
      rw [Finsupp.onFinset_apply]
    refine ⟨a, (Algebra.TensorProduct.basis V τ).repr.symm d, ha0, ?_, ?_⟩
    · apply (Algebra.TensorProduct.basis (FractionRing R) τ).repr.injective
      rw [← Algebra.smul_def, map_smul, s1 V (FractionRing R) _ τ φV,
        LinearEquiv.apply_symm_apply]
      ext j
      rw [Finsupp.smul_apply, Finsupp.mapRange_apply, hφV, hd, smul_eq_mul,
        mul_div_cancel₀ _ ha0]
    · intro h0
      have h1 : (Algebra.TensorProduct.basis (IsLocalRing.ResidueField V) τ).repr
          (Algebra.TensorProduct.map φκ (AlgHom.id L T)
            ((Algebra.TensorProduct.basis V τ).repr.symm d)) j₀ =
          (Algebra.TensorProduct.basis (IsLocalRing.ResidueField V) τ).repr 0 j₀ := by
        rw [h0]
      rw [s1 V (IsLocalRing.ResidueField V) _ τ φκ, LinearEquiv.apply_symm_apply, map_zero,
        Finsupp.mapRange_apply, Finsupp.zero_apply, hφκ] at h1
      have hdj : d j₀ = 1 := Subtype.ext (by rw [hd]; exact div_self ha0)
      rw [hdj, map_one] at h1
      exact one_ne_zero h1

  haveI hFdom := hdom (FractionRing R)
  haveI hκdom := hdom (IsLocalRing.ResidueField V)
  set g' := Algebra.TensorProduct.map φR (AlgHom.id L T) (g : TensorProduct L R T) with hg'
  set g'' := Algebra.TensorProduct.map φR (AlgHom.id L T)
    ((g⁻¹ : (TensorProduct L R T)ˣ) : TensorProduct L R T) with hg''
  have hgg : g' * g'' = 1 := by rw [hg', hg'', ← map_mul, Units.mul_inv, map_one]
  have hg'0 : g' ≠ 0 := by intro h0; rw [h0, zero_mul] at hgg; exact zero_ne_one hgg
  have hg''0 : g'' ≠ 0 := by intro h0; rw [h0, mul_zero] at hgg; exact zero_ne_one hgg
  obtain ⟨a, h₁, ha, e₁, n₁⟩ := s3 g' hg'0
  obtain ⟨b, h₂, hb, e₂, n₂⟩ := s3 g'' hg''0
  refine ⟨a, ha, fun y => ?_⟩
  have hεF : ∀ (x : FractionRing R) (w : TensorProduct L (FractionRing R) T),
      Algebra.TensorProduct.lift (AlgHom.id (FractionRing R) (FractionRing R))
          ((Algebra.ofId L (FractionRing R)).comp y) (fun _ _ => Commute.all _ _)
          (algebraMap (FractionRing R) (TensorProduct L (FractionRing R) T) x * w) =
        x * Algebra.TensorProduct.lift (AlgHom.id (FractionRing R) (FractionRing R))
          ((Algebra.ofId L (FractionRing R)).comp y) (fun _ _ => Commute.all _ _) w := by
    intro x w
    simp only [map_mul, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
  have k₁ := s2 R (FractionRing R) φR y (g : TensorProduct L R T)
  rw [← hg', e₁, hεF, s2 V (FractionRing R) φV y, hφV, hφR] at k₁
  have k₂ := s2 R (FractionRing R) φR y ((g⁻¹ : (TensorProduct L R T)ˣ) : TensorProduct L R T)
  rw [← hg'', e₂, hεF, s2 V (FractionRing R) φV y, hφV, hφR] at k₂
  have kR : algebraMap R (FractionRing R) (Algebra.TensorProduct.lift (AlgHom.id R R)
        ((Algebra.ofId L R).comp y) (fun _ _ => Commute.all _ _) (g : TensorProduct L R T)) *
      algebraMap R (FractionRing R) (Algebra.TensorProduct.lift (AlgHom.id R R)
        ((Algebra.ofId L R).comp y) (fun _ _ => Commute.all _ _)
        ((g⁻¹ : (TensorProduct L R T)ˣ) : TensorProduct L R T)) = 1 := by
    rw [← map_mul, ← map_mul, Units.mul_inv, map_one, map_one]
  set w₁ := Algebra.TensorProduct.lift (AlgHom.id V V) ((Algebra.ofId L V).comp y)
    (fun _ _ => Commute.all _ _) h₁ with hw₁
  set w₂ := Algebra.TensorProduct.lift (AlgHom.id V V) ((Algebra.ofId L V).comp y)
    (fun _ _ => Commute.all _ _) h₂ with hw₂
  rw [← k₁, ← k₂] at kR
  have hw : (w₁ : FractionRing R) * (w₂ : FractionRing R) * a * b = 1 := by
    linear_combination kR
  have hconst : Algebra.TensorProduct.map φV (AlgHom.id L T) (h₁ * h₂) =
      Algebra.TensorProduct.map φV (AlgHom.id L T) (algebraMap V (TensorProduct L V T) (w₁ * w₂)) := by
    have hmapc : Algebra.TensorProduct.map φV (AlgHom.id L T)
        (algebraMap V (TensorProduct L V T) (w₁ * w₂)) =
        algebraMap (FractionRing R) (TensorProduct L (FractionRing R) T)
          ((w₁ : FractionRing R) * (w₂ : FractionRing R)) := by
      simp [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.map_tmul, hφV]
    rw [hmapc, map_mul]
    rw [e₁, e₂] at hgg
    have hP : algebraMap (FractionRing R) (TensorProduct L (FractionRing R) T)
          ((w₁ : FractionRing R) * (w₂ : FractionRing R)) *
        algebraMap (FractionRing R) (TensorProduct L (FractionRing R) T) a *
        algebraMap (FractionRing R) (TensorProduct L (FractionRing R) T) b = 1 := by
      rw [← map_mul, ← map_mul, hw, map_one]
    linear_combination (algebraMap (FractionRing R) (TensorProduct L (FractionRing R) T)
          ((w₁ : FractionRing R) * (w₂ : FractionRing R))) * hgg -
      (Algebra.TensorProduct.map φV (AlgHom.id L T) h₁ *
        Algebra.TensorProduct.map φV (AlgHom.id L T) h₂) * hP
  have hprod : h₁ * h₂ = algebraMap V (TensorProduct L V T) (w₁ * w₂) := hιinj hconst
  have hρ := congrArg (Algebra.TensorProduct.map φκ (AlgHom.id L T)) hprod
  have hρc : Algebra.TensorProduct.map φκ (AlgHom.id L T)
      (algebraMap V (TensorProduct L V T) (w₁ * w₂)) =
      algebraMap (IsLocalRing.ResidueField V) (TensorProduct L (IsLocalRing.ResidueField V) T)
        (IsLocalRing.residue V (w₁ * w₂)) := by
    simp [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.map_tmul, hφκ]
  rw [map_mul, hρc] at hρ
  have hres : IsLocalRing.residue V (w₁ * w₂) ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hρ
    exact mul_ne_zero n₁ n₂ hρ
  have hunit : IsUnit (w₁ * w₂) := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hres
  have hu1 : IsUnit w₁ := isUnit_of_mul_isUnit_left hunit
  refine ⟨hu1.unit, ?_⟩
  rw [hu1.unit_spec]
  exact k₁.symm

theorem wc_cud_valuation_intersection_algclosed : ∀ (L : Type u) [Field L] [IsAlgClosed L] (F : Type u) [Field F] [Algebra L F] (x : F), (∀ V : ValuationSubring F, (∀ c : L, algebraMap L F c ∈ V) → x ∈ V) → x ∈ Set.range (algebraMap L F) :=
by
  intro L _ _ F _ _ x hx
  classical
  set s : Set F := Set.range (algebraMap L F) with hs
  have h1 : x ∈ (integralClosure (Subring.closure s) F).toSubring := by
    rw [← iInf_valuationSubring_superset (s := s), Subring.mem_iInf]
    rintro ⟨V, hV⟩
    exact hx V (fun c => hV ⟨c, rfl⟩)
  have h2 : IsIntegral (Subring.closure s) x := h1
  have hmemC : ∀ c : L, algebraMap L F c ∈ Subring.closure s :=
    fun c => Subring.subset_closure ⟨c, rfl⟩
  let f : L →+* Subring.closure s := (algebraMap L F).codRestrict (Subring.closure s) hmemC
  have hf : ∀ c, ((f c : Subring.closure s) : F) = algebraMap L F c := fun c => rfl
  have hinj : Function.Injective f := by
    intro a b hab
    apply (algebraMap L F).injective
    rw [← hf, ← hf, hab]
  have hsurj : Function.Surjective f := by
    rintro ⟨y, hy⟩
    have hle : Subring.closure s ≤ (algebraMap L F).range := by
      rw [Subring.closure_le]
      rintro _ ⟨c, rfl⟩
      exact ⟨c, rfl⟩
    obtain ⟨c, hc⟩ := hle hy
    exact ⟨c, Subtype.ext hc⟩
  let e : L ≃+* Subring.closure s := RingEquiv.ofBijective f ⟨hinj, hsurj⟩
  have hkey : (algebraMap L F).comp e.symm.toRingHom =
      (RingHom.id F).comp (algebraMap (Subring.closure s) F) := by
    ext y
    simp only [RingHom.comp_apply, RingHom.id_apply]
    have hy : e (e.symm y) = y := e.apply_symm_apply y
    conv_rhs => rw [← hy]
    rfl
  have h3 : IsIntegral L x := by
    have := IsIntegral.map_of_comp_eq e.symm.toRingHom (RingHom.id F) hkey h2
    simpa using this
  have h4 := IsAlgClosed.degree_eq_one_of_irreducible L (minpoly.irreducible h3)
  obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one L x h4
  exact ⟨c, hc⟩

theorem wc_curve_units_descent : ∀ (L : Type u) [Field L] [IsAlgClosed L] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra L Ω] (R : Type u) [CommRing R] [Algebra L R] [Algebra (Polynomial L) R] [IsScalarTower L (Polynomial L) R] [Algebra.Etale (Polynomial L) R] (n : ℕ), 0 < n → ∀ u : (TensorProduct L R Ω)ˣ, ∃ (v : Rˣ) (w : (TensorProduct L R Ω)ˣ), (u : TensorProduct L R Ω) = algebraMap R (TensorProduct L R Ω) v * (w : TensorProduct L R Ω) ^ n :=
by
  intro L _ _ Ω _ _ _ R _ _ _ _ _ n hn
  classical
  haveI : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing (Polynomial L) R
  have hloc : ∀ (m : Ideal R) [m.IsMaximal], IsDomain (Localization.AtPrime m) := by
    intro m _
    exact wc_ring_etale_localization_isDomain (Polynomial L) R m
  obtain ⟨k, P, hP, hbij⟩ := wc_cud_noetherian_locally_domain_pi R hloc
  have DC : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra L D] (u : (TensorProduct L D Ω)ˣ),
      ∃ (v : Dˣ) (w : (TensorProduct L D Ω)ˣ), (u : TensorProduct L D Ω) =
        algebraMap D (TensorProduct L D Ω) v * (w : TensorProduct L D Ω) ^ n := by
    intro D _ _ _ u
    obtain ⟨T, hfg, u', hu'⟩ := wc_cud_units_fg_descent L D Ω u
    haveI : Algebra.FiniteType L T := (Subalgebra.fg_iff_finiteType T).mp hfg
    have hsep : ∀ t : T, t ≠ 0 → ∃ y : T →ₐ[L] L, y t ≠ 0 :=
      fun t ht => wc_cud_algclosed_point_nonvanishing L T t ht
    obtain ⟨y₀, -⟩ := hsep 1 one_ne_zero
    obtain ⟨ε, hε⟩ : ∃ ε : (T →ₐ[L] L) → (TensorProduct L D T →ₐ[D] D), ∀ y, ε y =
        Algebra.TensorProduct.lift (AlgHom.id D D) ((Algebra.ofId L D).comp y)
          (fun _ _ => Commute.all _ _) := ⟨_, fun _ => rfl⟩
    have hεalg : ∀ y (d : D), ε y (algebraMap D (TensorProduct L D T) d) = d :=
      fun y d => (ε y).commutes d
    obtain ⟨G₀, hG₀⟩ : ∃ G₀ : Dˣ, (G₀ : D) = ε y₀ (u' : TensorProduct L D T) :=
      ⟨Units.map (ε y₀ : TensorProduct L D T →* D) u', rfl⟩
    obtain ⟨h, hh⟩ : ∃ h : (TensorProduct L D T)ˣ, (h : TensorProduct L D T) =
        algebraMap D (TensorProduct L D T) ((G₀⁻¹ : Dˣ) : D) * (u' : TensorProduct L D T) :=
      ⟨Units.map (algebraMap D (TensorProduct L D T) : D →* TensorProduct L D T) G₀⁻¹ * u', rfl⟩
    have hh0 : ε y₀ (h : TensorProduct L D T) = 1 := by
      rw [hh, map_mul, hεalg, ← hG₀, Units.inv_mul]
    have hconst : ∀ y : T →ₐ[L] L, ε y (h : TensorProduct L D T) ∈ Set.range (algebraMap L D) := by
      intro y
      have hx : ∀ V : ValuationSubring (FractionRing D),
          (∀ c : L, algebraMap L (FractionRing D) c ∈ V) →
          algebraMap D (FractionRing D) (ε y (h : TensorProduct L D T)) ∈ V := by
        intro V hV
        obtain ⟨a, -, he⟩ := wc_cud_specialization_valuation_gauss L D V hV T
          (fun K _ _ => wc_ring_tensor_isDomain_of_isAlgClosed L K T) h
        obtain ⟨e₀, he₀⟩ := he y₀
        obtain ⟨e, hee⟩ := he y
        rw [← hε] at he₀ hee
        rw [hh0, map_one] at he₀
        have hinv : ((e₀ : V) : FractionRing D) * (((e₀⁻¹ : Vˣ) : V) : FractionRing D) = 1 := by
          rw [← MulMemClass.coe_mul, Units.mul_inv, OneMemClass.coe_one]
        have ha : a = (((e₀⁻¹ : Vˣ) : V) : FractionRing D) := by
          calc a = a * (((e₀ : V) : FractionRing D) * (((e₀⁻¹ : Vˣ) : V) : FractionRing D)) := by
                rw [hinv, mul_one]
            _ = (a * ((e₀ : V) : FractionRing D)) * (((e₀⁻¹ : Vˣ) : V) : FractionRing D) := by ring
            _ = (((e₀⁻¹ : Vˣ) : V) : FractionRing D) := by rw [← he₀, one_mul]
        rw [hee, ha]
        exact V.mul_mem _ _ (SetLike.coe_mem _) (SetLike.coe_mem _)
      obtain ⟨c, hc⟩ := wc_cud_valuation_intersection_algclosed L (FractionRing D) _ hx
      refine ⟨c, IsFractionRing.injective D (FractionRing D) ?_⟩
      rw [← IsScalarTower.algebraMap_apply L D (FractionRing D), hc]
    obtain ⟨t, ht⟩ := wc_cud_tensor_const_of_specializations L D T hsep (h : TensorProduct L D T)
      (fun y => by rw [← hε]; exact hconst y)
    have hu'eq : (u' : TensorProduct L D T) =
        algebraMap D (TensorProduct L D T) (G₀ : D) * Algebra.TensorProduct.includeRight t := by
      rw [← ht, hh, ← mul_assoc, ← map_mul, Units.mul_inv, map_one, one_mul]
    have hueq : (u : TensorProduct L D Ω) =
        algebraMap D (TensorProduct L D Ω) (G₀ : D) * Algebra.TensorProduct.includeRight (t : Ω) := by
      rw [← hu', hu'eq, map_mul]
      congr 1
    have hω : (t : Ω) ≠ 0 := by
      intro h0
      rw [h0, map_zero, mul_zero] at hueq
      exact u.ne_zero hueq
    obtain ⟨w₀, hw₀⟩ := IsAlgClosed.exists_pow_nat_eq (t : Ω) hn
    have hw0 : w₀ ≠ 0 := by
      rintro rfl
      rw [zero_pow hn.ne'] at hw₀
      exact hω hw₀.symm
    refine ⟨G₀, Units.map (Algebra.TensorProduct.includeRight :
      Ω →ₐ[L] TensorProduct L D Ω).toMonoidHom (Units.mk0 w₀ hw0), ?_⟩
    rw [hueq]
    show _ = _ * (Algebra.TensorProduct.includeRight w₀ : TensorProduct L D Ω) ^ n
    rw [← map_pow, hw₀]
  exact wc_cud_units_pi_reduction L R Ω n k P hbij
    (fun i => by haveI := hP i; exact DC (R ⧸ P i))

theorem wc_kummer_line_adjust : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (M : Type u) [AddCommGroup M] [Module S M] [Module R M] [IsScalarTower R S M] (N₀ : Type u) [AddCommGroup N₀] [Module R N₀] (ℓ : ℕ), 0 < ℓ → ∀ (μ : TensorPower S ℓ M ≃ₗ[S] S) (μ₀ : TensorPower R ℓ N₀ ≃ₗ[R] R) (φ : TensorProduct R S N₀ ≃ₗ[S] M), (∀ u : Sˣ, ∃ (v : Rˣ) (w : Sˣ), (u : S) = algebraMap R S v * (w : S) ^ ℓ) → ∃ N : Submodule R M, Function.Bijective (N.subtype.liftBaseChange S) ∧ ∀ x : Fin ℓ → N, μ (PiTensorProduct.tprod S (fun i => (x i : M))) ∈ Set.range (algebraMap R S) :=
by
  intro R S _ _ _ M _ _ _ _ N₀ _ _ ℓ _ μ μ₀ φ hU
  classical
  obtain ⟨g, hg⟩ : ∃ g : S → (N₀ →ₗ[R] M), ∀ c n, g c n = φ (c ⊗ₜ[R] n) :=
    ⟨fun c => (φ.toLinearMap.restrictScalars R) ∘ₗ TensorProduct.mk R S N₀ c, fun _ _ => rfl⟩

  have hscale : ∀ (c : S) (n : Fin ℓ → N₀),
      μ (PiTensorProduct.tprod S (fun i => g c (n i))) =
        c ^ ℓ * μ (PiTensorProduct.tprod S (fun i => g 1 (n i))) := by
    intro c n
    have h1 : (fun i => g c (n i)) = fun i => c • g 1 (n i) := by
      funext i
      rw [hg, hg, show c ⊗ₜ[R] n i = c • ((1 : S) ⊗ₜ[R] n i) by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one], φ.map_smul]
    rw [h1, MultilinearMap.map_smul_univ, map_smul, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin, smul_eq_mul]

  obtain ⟨Θ, hΘ⟩ : ∃ Θ : MultilinearMap R (fun _ : Fin ℓ => N₀) S,
      ∀ n, Θ n = μ (PiTensorProduct.tprod S (fun i => g 1 (n i))) :=
    ⟨(μ.toLinearMap.restrictScalars R).compMultilinearMap
      (((PiTensorProduct.tprod S : MultilinearMap S (fun _ : Fin ℓ => M) (TensorPower S ℓ M)).restrictScalars R).compLinearMap
        (fun _ => g 1)), fun _ => rfl⟩
  set u : S := PiTensorProduct.lift Θ (μ₀.symm 1) with hu_def
  have hθ : ∀ x : TensorPower R ℓ N₀, PiTensorProduct.lift Θ x = algebraMap R S (μ₀ x) * u := by
    intro x
    have hx : x = μ₀ x • μ₀.symm 1 := by
      calc x = μ₀.symm (μ₀ x) := (μ₀.symm_apply_apply x).symm
        _ = μ₀.symm (μ₀ x • 1) := by rw [smul_eq_mul, mul_one]
        _ = μ₀ x • μ₀.symm 1 := μ₀.symm.map_smul _ _
    conv_lhs => rw [hx]
    rw [map_smul, Algebra.smul_def]
  have hfac : ∀ n : Fin ℓ → N₀, μ (PiTensorProduct.tprod S (fun i => g 1 (n i))) =
      algebraMap R S (μ₀ (PiTensorProduct.tprod R n)) * u := by
    intro n
    rw [← hΘ, ← hθ, PiTensorProduct.lift.tprod]

  have hdvd1 : ∀ m : Fin ℓ → M, u ∣ μ (PiTensorProduct.tprod S m) := by
    intro m
    choose T hT using fun i => TensorProduct.exists_finset (R := R) (φ.symm (m i))
    obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : MultilinearMap S (fun _ : Fin ℓ => TensorProduct R S N₀) S,
        ∀ t, Ψ t = μ (PiTensorProduct.tprod S (fun i => φ (t i))) :=
      ⟨μ.toLinearMap.compMultilinearMap
        ((PiTensorProduct.tprod S : MultilinearMap S (fun _ : Fin ℓ => M) (TensorPower S ℓ M)).compLinearMap
          (fun _ => φ.toLinearMap)), fun _ => rfl⟩
    have hm : m = fun i => φ (∑ p ∈ T i, p.1 ⊗ₜ[R] p.2) := by
      funext i
      rw [← hT i, φ.apply_symm_apply]
    rw [hm, ← hΨ, MultilinearMap.map_sum_finset]
    apply Finset.dvd_sum
    intro r _
    have h2 : (fun i => (r i).1 ⊗ₜ[R] (r i).2) = fun i => (r i).1 • ((1 : S) ⊗ₜ[R] (r i).2) := by
      funext i
      rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rw [h2, MultilinearMap.map_smul_univ, smul_eq_mul, hΨ]
    apply Dvd.dvd.mul_left
    have h3 := hfac (fun i => (r i).2)
    simp only [hg] at h3
    rw [h3]
    exact Dvd.intro_left _ rfl
  have hdvd : ∀ z : PiTensorProduct S (fun _ : Fin ℓ => M), u ∣ μ z := by
    intro z
    induction z using PiTensorProduct.induction_on with
    | smul_tprod r f =>
      rw [map_smul, smul_eq_mul]
      exact Dvd.dvd.mul_left (hdvd1 f) r
    | add x y hx hy =>
      rw [map_add]
      exact dvd_add hx hy
  have hunit : IsUnit u := by
    apply isUnit_of_dvd_one
    have h := hdvd (μ.symm 1)
    rwa [μ.apply_symm_apply] at h
  obtain ⟨v, w, hvw⟩ := hU hunit.unit
  rw [IsUnit.unit_spec] at hvw
  refine ⟨LinearMap.range (g ((w⁻¹ : Sˣ) : S)), ?_, ?_⟩
  · set c : Sˣ := w⁻¹ with hc
    set N := LinearMap.range (g (c : S)) with hN
    let κ : N₀ →ₗ[R] N := (g (c : S)).rangeRestrict
    have hκ : Function.Surjective κ := LinearMap.surjective_rangeRestrict _
    have hκS : Function.Surjective (κ.baseChange S) := by
      rw [LinearMap.baseChange_eq_ltensor]
      exact LinearMap.lTensor_surjective _ hκ
    have hcomp : ∀ x, N.subtype.liftBaseChange S (κ.baseChange S x) = (c : S) • φ x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul s n =>
        rw [LinearMap.baseChange_tmul, LinearMap.liftBaseChange_tmul]
        show s • g (c : S) n = _
        rw [hg, ← φ.map_smul, ← φ.map_smul, TensorProduct.smul_tmul', TensorProduct.smul_tmul',
          smul_eq_mul, smul_eq_mul, mul_comm]
      | add x y hx hy =>
        rw [map_add, map_add, hx, hy, map_add, smul_add]
    constructor
    · intro a b hab
      obtain ⟨a', rfl⟩ := hκS a
      obtain ⟨b', rfl⟩ := hκS b
      rw [hcomp, hcomp] at hab
      have h1 : φ a' = φ b' := by
        have := congrArg (fun z => ((c⁻¹ : Sˣ) : S) • z) hab
        simpa [smul_smul] using this
      rw [φ.injective h1]
    · intro y
      refine ⟨κ.baseChange S (φ.symm (((c⁻¹ : Sˣ) : S) • y)), ?_⟩
      rw [hcomp, φ.apply_symm_apply, smul_smul, Units.mul_inv, one_smul]
  · intro x
    have hx : ∀ i, ∃ n, g ((w⁻¹ : Sˣ) : S) n = (x i : M) := fun i => LinearMap.mem_range.mp (x i).2
    choose n hn using hx
    have h1 : (fun i => (x i : M)) = fun i => g ((w⁻¹ : Sˣ) : S) (n i) := funext fun i => (hn i).symm
    rw [h1, hscale, hfac, hvw]
    refine ⟨μ₀ (PiTensorProduct.tprod R n) * v, ?_⟩
    rw [map_mul]
    have hw : ((w⁻¹ : Sˣ) : S) ^ ℓ * (w : S) ^ ℓ = 1 := by rw [← mul_pow, Units.inv_mul, one_pow]
    linear_combination (-(algebraMap R S (μ₀ (PiTensorProduct.tprod R n)) * algebraMap R S (v : R))) * hw

theorem wc_kds_char_sum : ∀ (L : Type u) [Field L] (ℓ : ℕ) [NeZero ℓ], ℓ.Prime → ∀ (ζ : L), IsPrimitiveRoot ζ ℓ → (ℓ : L) ≠ 0 ∧ (∀ x : ℕ, ∑ k ∈ Finset.range ℓ, ζ ^ (x * k) = if ℓ ∣ x then (ℓ : L) else 0) ∧ (∀ x : ℕ, ∑ h : ZMod ℓ, ζ ^ (h.val * x) = if ℓ ∣ x then (ℓ : L) else 0) :=
by
  intro L _ ℓ _ hℓ ζ hζ
  have hA : (ℓ : L) ≠ 0 := (hζ.neZero').ne
  have hB : ∀ x : ℕ, ∑ k ∈ Finset.range ℓ, ζ ^ (x * k) = if ℓ ∣ x then (ℓ : L) else 0 := by
    intro x
    simp_rw [pow_mul]
    split_ifs with hx
    · rw [(hζ.pow_eq_one_iff_dvd x).mpr hx]
      simp
    · have hw : ζ ^ x ≠ 1 := fun h => hx ((hζ.pow_eq_one_iff_dvd x).mp h)
      have hwl : (ζ ^ x) ^ ℓ = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
      have h := mul_geom_sum (ζ ^ x) ℓ
      rw [hwl, sub_self] at h
      exact (mul_eq_zero.mp h).resolve_left (sub_ne_zero.mpr hw)
  refine ⟨hA, hB, ?_⟩
  intro x
  rw [← hB x]
  apply Finset.sum_nbij' (fun h : ZMod ℓ => h.val) (fun k => (k : ZMod ℓ))
  · intro h _
    simpa using ZMod.val_lt h
  · intro k _
    simp
  · intro h _
    simp [ZMod.natCast_zmod_val]
  · intro k hk
    have hk' : k < ℓ := by simpa using hk
    simp [ZMod.val_cast_of_lt hk']
  · intro h _
    rw [mul_comm]

theorem wc_kds_eigen_pow : ∀ (L : Type u) [Field L] (ℓ : ℕ) [NeZero ℓ] (ζ : L) (S B : Type u) [CommRing S] [CommRing B] [Algebra L S] [Algebra S B] [Algebra L B] [IsScalarTower L S B] (σ : ZMod ℓ → (B →ₐ[S] B)), σ 0 = AlgHom.id S B → (∀ c c', σ (c + c') = (σ c).comp (σ c')) → ∀ b : B, σ 1 b = algebraMap L B ζ * b → ∀ h : ZMod ℓ, σ h b = algebraMap L B (ζ ^ h.val) * b :=
by
  intro L _ ℓ _ ζ S B _ _ _ _ _ _ σ hσ0 hσadd b hb h
  have hfix : ∀ (c : ZMod ℓ) (x : L), σ c (algebraMap L B x) = algebraMap L B x := by
    intro c x
    rw [IsScalarTower.algebraMap_apply L S B, AlgHom.commutes]
  have hnat : ∀ n : ℕ, σ (n : ZMod ℓ) b = algebraMap L B (ζ ^ n) * b := by
    intro n
    induction n with
    | zero =>
      rw [Nat.cast_zero, hσ0, AlgHom.id_apply, pow_zero, map_one, one_mul]
    | succ n ih =>
      rw [Nat.cast_succ, hσadd, AlgHom.comp_apply, hb, map_mul, hfix, ih, pow_succ, map_mul]
      ring
  have := hnat h.val
  rwa [ZMod.natCast_zmod_val] at this

theorem wc_kds_one_mem_span_S : ∀ (R S B : Type u) [CommRing R] [CommRing S] [CommRing B] [Algebra R S] [Algebra S B] [Algebra R B] [IsScalarTower R S B] (ℓ : ℕ) (M : Submodule S B), (∃ μ : TensorPower S ℓ M ≃ₗ[S] S, ∀ x : Fin ℓ → M, algebraMap S B (μ (PiTensorProduct.tprod S x)) = ∏ i, (x i : B)) → ∀ (N : Submodule R M), Function.Surjective (N.subtype.liftBaseChange S) → (1 : B) ∈ Submodule.span S (Set.range (fun x : Fin ℓ → N => ∏ i, ((x i : M) : B))) :=
by
  intro R S B _ _ _ _ _ _ _ ℓ M hμex N hN
  obtain ⟨μ, hμ⟩ := hμex
  classical
  have s1 : ∀ m : M, (m : B) ∈ Submodule.span S (Set.range (fun n : N => ((n : M) : B))) := by
    intro m
    have hr : LinearMap.range (N.subtype.liftBaseChange S) = ⊤ := LinearMap.range_eq_top.mpr hN
    rw [LinearMap.range_liftBaseChange] at hr
    have hm : m ∈ Submodule.span S (↑(LinearMap.range N.subtype) : Set M) := by
      rw [hr]; trivial
    have h2 := Submodule.apply_mem_span_image_of_mem_span M.subtype hm
    refine Submodule.span_mono ?_ h2
    rintro _ ⟨y, ⟨n, rfl⟩, rfl⟩
    exact ⟨n, rfl⟩
  have s2 : ∀ (k : ℕ) (f : Fin k → B),
      (∀ i, f i ∈ Submodule.span S (Set.range (fun n : N => ((n : M) : B)))) →
      ∏ i, f i ∈ Submodule.span S (Set.range (fun x : Fin k → N => ∏ i, ((x i : M) : B))) := by
    intro k
    induction k with
    | zero =>
      intro f _
      rw [Fin.prod_univ_zero]
      exact Submodule.subset_span ⟨Fin.elim0, by simp only [Fin.prod_univ_zero]⟩
    | succ k ih =>
      intro f hf
      rw [Fin.prod_univ_succ]
      have h1 := Submodule.mul_mem_mul (hf 0) (ih (fun i => f i.succ) (fun i => hf i.succ))
      rw [Submodule.span_mul_span] at h1
      refine Submodule.span_mono ?_ h1
      rintro _ ⟨a, ⟨n, rfl⟩, b, ⟨x, rfl⟩, rfl⟩
      refine ⟨Fin.cons n x, ?_⟩
      simp only [Fin.prod_univ_succ, Fin.cons_zero, Fin.cons_succ]
  let Φ : TensorPower S ℓ M →ₗ[S] B := (Algebra.linearMap S B).comp μ.toLinearMap
  have hΦ : ∀ z, Φ z = algebraMap S B (μ z) := fun z => rfl
  have ht : Φ (μ.symm 1) = 1 := by rw [hΦ, LinearEquiv.apply_symm_apply, map_one]
  rw [← ht]
  have hmem : μ.symm 1 ∈ Submodule.span S
      (Set.range (PiTensorProduct.tprod S (s := fun _ : Fin ℓ => M))) := by
    rw [PiTensorProduct.span_tprod_eq_top]; trivial
  have h3 := Submodule.apply_mem_span_image_of_mem_span Φ hmem
  refine (Submodule.span_le.mpr ?_) h3
  rintro _ ⟨_, ⟨f, rfl⟩, rfl⟩
  rw [hΦ, hμ f]
  exact s2 ℓ (fun i => (f i : B)) (fun i => s1 (f i))

theorem wc_kds_one_mem_span_R : ∀ (R S B : Type u) [CommRing R] [CommRing S] [CommRing B] [Algebra R S] [Algebra S B] [Algebra R B] [IsScalarTower R S B] [Module.FaithfullyFlat R S], Function.Injective (algebraMap S B) → ∀ (Y : Set B), (∀ y ∈ Y, y ∈ Set.range (algebraMap R B)) → (1 : B) ∈ Submodule.span S Y → (1 : B) ∈ Submodule.span R Y :=
by
  intro R S B _ _ _ _ _ _ _ _ hinj Y hY h1
  classical
  let I : Ideal R := Submodule.comap (Algebra.linearMap R B) (Submodule.span R Y)
  have hI : ∀ r, r ∈ I ↔ algebraMap R B r ∈ Submodule.span R Y := fun r => Iff.rfl
  obtain ⟨n, c, g, hg⟩ := Submodule.mem_span_set'.mp h1
  have hr' : ∀ i, ∃ r : R, algebraMap R B r = (g i : B) := fun i => hY _ (g i).2
  choose r hr using hr'
  have hrI : ∀ i, r i ∈ I := fun i => by
    rw [hI, hr]; exact Submodule.subset_span (g i).2
  have hxmem : (∑ i, c i * algebraMap R S (r i)) ∈ Ideal.map (algebraMap R S) I :=
    Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hrI i)))
  have hx1 : (∑ i, c i * algebraMap R S (r i)) = 1 := by
    apply hinj
    rw [map_one, map_sum, ← hg]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, ← IsScalarTower.algebraMap_apply, hr, Algebra.smul_def]
  have heq : Ideal.comap (algebraMap R S) (Ideal.map (algebraMap R S) I) = I :=
    Ideal.comap_map_eq_self_of_faithfullyFlat I
  have h1I : (1 : R) ∈ I := by
    rw [← heq, Ideal.mem_comap, map_one, ← hx1]
    exact hxmem
  have h := (hI 1).1 h1I
  rwa [map_one] at h

theorem wc_kds_monomial_span_mul : ∀ (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] (ℓ : ℕ) (G : Set B), 0 < ℓ → (∀ f : Fin ℓ → B, (∀ t, f t ∈ G) → ∏ t, f t ∈ Set.range (algebraMap R B)) → (∀ (k : ℕ) (f : Fin k → B), (∀ t, f t ∈ G) → ∏ t, f t ∈ Submodule.span R {b : B | ∃ k : ℕ, k < ℓ ∧ ∃ f : Fin k → B, (∀ t, f t ∈ G) ∧ b = ∏ t, f t}) ∧ (∀ (m : ℕ) (s : Finset (Fin m)) (f : Fin m → B), (∀ t, f t ∈ G) → ∏ t ∈ s, f t ∈ Submodule.span R {b : B | ∃ k : ℕ, k < ℓ ∧ ∃ f : Fin k → B, (∀ t, f t ∈ G) ∧ b = ∏ t, f t}) ∧ (∀ x y : B, x ∈ Submodule.span R {b : B | ∃ k : ℕ, k < ℓ ∧ ∃ f : Fin k → B, (∀ t, f t ∈ G) ∧ b = ∏ t, f t} → y ∈ Submodule.span R {b : B | ∃ k : ℕ, k < ℓ ∧ ∃ f : Fin k → B, (∀ t, f t ∈ G) ∧ b = ∏ t, f t} → x * y ∈ Submodule.span R {b : B | ∃ k : ℕ, k < ℓ ∧ ∃ f : Fin k → B, (∀ t, f t ∈ G) ∧ b = ∏ t, f t}) :=
by
  intro R B _ _ _ ℓ G hℓ hG
  set P := Submodule.span R
    {b : B | ∃ k : ℕ, k < ℓ ∧ ∃ f : Fin k → B, (∀ t, f t ∈ G) ∧ b = ∏ t, f t} with hP
  have hA : ∀ (k : ℕ) (f : Fin k → B), (∀ t, f t ∈ G) → ∏ t, f t ∈ P := by
    intro k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
      intro f hf
      by_cases hk : k < ℓ
      · exact Submodule.subset_span ⟨k, hk, f, hf, rfl⟩
      · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le (not_lt.mp hk)
        rw [Fin.prod_univ_add]
        obtain ⟨r, hr⟩ := hG (fun i => f (Fin.castAdd j i)) (fun i => hf _)
        have hy := ih j (by omega) (fun i => f (Fin.natAdd ℓ i)) (fun i => hf _)
        rw [← hr, ← Algebra.smul_def]
        exact Submodule.smul_mem P r hy
  have hB : ∀ (m : ℕ) (s : Finset (Fin m)) (f : Fin m → B), (∀ t, f t ∈ G) →
      ∏ t ∈ s, f t ∈ P := by
    intro m s f hf
    have e : ∏ t ∈ s, f t = ∏ i : Fin s.card, f (s.equivFin.symm i) := by
      rw [← Finset.prod_coe_sort s f]
      exact Fintype.prod_equiv s.equivFin _ _ (fun x => by simp)
    rw [e]
    exact hA _ _ (fun i => hf _)
  have hC : ∀ x y : B, x ∈ P → y ∈ P → x * y ∈ P := by
    intro x y hx hy
    induction hx using Submodule.span_induction with
    | mem a ha =>
      induction hy using Submodule.span_induction with
      | mem b hb =>
        obtain ⟨k, -, f, hf, rfl⟩ := ha
        obtain ⟨k', -, f', hf', rfl⟩ := hb
        have h := hA (k + k') (Fin.append f f') (fun t => by
          refine Fin.addCases (fun i => ?_) (fun i => ?_) t
          · rw [Fin.append_left]; exact hf i
          · rw [Fin.append_right]; exact hf' i)
        simpa only [Fin.prod_univ_add, Fin.append_left, Fin.append_right] using h
      | zero => rw [mul_zero]; exact P.zero_mem
      | add y z _ _ h1 h2 => rw [mul_add]; exact P.add_mem h1 h2
      | smul r y _ h => rw [mul_smul_comm]; exact P.smul_mem r h
    | zero => rw [zero_mul]; exact P.zero_mem
    | add x z _ _ h1 h2 => rw [add_mul]; exact P.add_mem h1 h2
    | smul r x _ h => rw [smul_mul_assoc]; exact P.smul_mem r h
  exact ⟨hA, hB, hC⟩

theorem wc_kds_monomial_trace : ∀ (L : Type u) [Field L] (ℓ : ℕ) [NeZero ℓ] (ζ : L) (R S B : Type u) [CommRing R] [CommRing S] [CommRing B] [Algebra L R] [Algebra R S] [Algebra S B] [Algebra L S] [Algebra L B] [Algebra R B] [IsScalarTower L R S] [IsScalarTower L S B] [IsScalarTower R S B] (σ : ZMod ℓ → (B →ₐ[S] B)) (G : Set B), (∀ x : ℕ, ∑ h : ZMod ℓ, ζ ^ (h.val * x) = if ℓ ∣ x then (ℓ : L) else 0) → (∀ (h : ZMod ℓ), ∀ g ∈ G, σ h g = algebraMap L B (ζ ^ h.val) * g) → ∀ β ∈ Submodule.span R {b : B | ∃ k : ℕ, k < ℓ ∧ ∃ f : Fin k → B, (∀ t, f t ∈ G) ∧ b = ∏ t, f t}, (∀ c : ZMod ℓ, σ c β ∈ Submodule.span R {b : B | ∃ k : ℕ, k < ℓ ∧ ∃ f : Fin k → B, (∀ t, f t ∈ G) ∧ b = ∏ t, f t}) ∧ ∑ h : ZMod ℓ, σ h β ∈ Set.range (algebraMap R B) :=
by
  intro L _ ℓ _ ζ R S B _ _ _ _ _ _ _ _ _ _ _ _ σ G hc hG β hβ
  classical
  have hLB : ∀ x : L, algebraMap L B x = algebraMap R B (algebraMap L R x) := by
    intro x
    rw [IsScalarTower.algebraMap_apply L S B, IsScalarTower.algebraMap_apply L R S,
      ← IsScalarTower.algebraMap_apply R S B]
  have hsm : ∀ (h : ZMod ℓ) (r : R) (x : B), σ h (r • x) = r • σ h x := by
    intro h r x
    rw [Algebra.smul_def, Algebra.smul_def, map_mul, IsScalarTower.algebraMap_apply R S B,
      AlgHom.commutes]
  have heig : ∀ (k : ℕ) (f : Fin k → B), (∀ t, f t ∈ G) → ∀ h : ZMod ℓ,
      σ h (∏ t, f t) = algebraMap L B (ζ ^ (h.val * k)) * ∏ t, f t := by
    intro k f hf h
    rw [map_prod, Finset.prod_congr rfl (fun t _ => hG h (f t) (hf t)), Finset.prod_mul_distrib,
      Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← map_pow, ← pow_mul]
  refine ⟨fun c => ?_, ?_⟩
  · induction hβ using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨k, hk, f, hf, rfl⟩ := hx
      rw [heig k f hf c, hLB, ← Algebra.smul_def]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, hk, f, hf, rfl⟩)
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
    | smul a x _ hx => rw [hsm]; exact Submodule.smul_mem _ _ hx
  · induction hβ using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨k, hk, f, hf, rfl⟩ := hx
      rw [Finset.sum_congr rfl (fun h _ => heig k f hf h), ← Finset.sum_mul, ← map_sum, hc k]
      rcases Nat.eq_zero_or_pos k with rfl | hk0
      · refine ⟨(ℓ : R), ?_⟩
        rw [if_pos (dvd_zero ℓ), Fin.prod_univ_zero, mul_one, map_natCast, map_natCast]
      · have hnd : ¬ ℓ ∣ k := fun hd =>
          (Nat.pos_iff_ne_zero.mp hk0) (Nat.eq_zero_of_dvd_of_lt hd hk)
        refine ⟨0, ?_⟩
        rw [if_neg hnd, map_zero, map_zero, zero_mul]
    | zero => exact ⟨0, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨r₁, h₁⟩ := hx
      obtain ⟨r₂, h₂⟩ := hy
      refine ⟨r₁ + r₂, ?_⟩
      rw [map_add, h₁, h₂, ← Finset.sum_add_distrib]
      simp only [map_add]
    | smul a x _ hx =>
      obtain ⟨r, hr⟩ := hx
      refine ⟨a * r, ?_⟩
      simp only [hsm, ← Finset.smul_sum]
      rw [← hr, map_mul, Algebra.smul_def]

theorem wc_kds_trace_mem_base : ∀ (S B : Type u) [CommRing S] [CommRing B] [Algebra S B] [Module.FaithfullyFlat S B] (ℓ : ℕ) [NeZero ℓ] (σ : ZMod ℓ → (B →ₐ[S] B)), (∀ c c', σ (c + c') = (σ c).comp (σ c')) → Function.Injective (wcTorDescMu S B ℓ σ) → ∀ v : B, ∑ h : ZMod ℓ, σ h v ∈ Set.range (algebraMap S B) :=
by
  intro S B _ _ _ _ ℓ _ σ hadd hinj v
  classical
  have hinv : ∀ c, σ c (∑ h : ZMod ℓ, σ h v) = ∑ h : ZMod ℓ, σ h v := by
    intro c
    rw [map_sum]
    have e : ∀ h, σ c (σ h v) = σ (c + h) v := fun h => by rw [hadd]; rfl
    simp_rw [e]
    exact Equiv.sum_comp (Equiv.addLeft c) (fun h => σ h v)
  generalize ∑ h : ZMod ℓ, σ h v = t at hinv ⊢
  have htens : t ⊗ₜ[S] (1 : B) = (1 : B) ⊗ₜ[S] t := by
    apply hinj
    funext c
    simp [wcTorDescMu, hinv]
  let P : Submodule S B := LinearMap.range (Algebra.linearMap S B)
  have h1 : P.mkQ (1 : B) = 0 := by
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact ⟨1, by simp⟩
  have h2 := congrArg (LinearMap.lTensor B P.mkQ) htens
  rw [LinearMap.lTensor_tmul, LinearMap.lTensor_tmul, h1, TensorProduct.tmul_zero] at h2
  have h3 : P.mkQ t = 0 := by
    apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := S) (B := B) (B ⧸ P)
    rw [map_zero, TensorProduct.mk_apply]
    exact h2.symm
  rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h3
  obtain ⟨s, hs⟩ := h3
  exact ⟨s, by simpa using hs⟩

theorem wc_kds_reconstruction : ∀ (L : Type u) [Field L] (ℓ : ℕ) [NeZero ℓ] (ζ : L) (S B : Type u) [CommRing S] [CommRing B] [Algebra S B] [Algebra L B] (σ : ZMod ℓ → (B →ₐ[S] B)), σ 0 = AlgHom.id S B → (∀ x : ℕ, ∑ k ∈ Finset.range ℓ, ζ ^ (x * k) = if ℓ ∣ x then (ℓ : L) else 0) → ∀ (n : ℕ) (c : Fin n → B) (g : Fin n → Fin ℓ → B), (∀ (h : ZMod ℓ) (α : Fin n) (t : Fin ℓ), σ h (g α t) = algebraMap L B (ζ ^ h.val) * g α t) → ∑ α, c α * ∏ t, g α t = 1 → ∀ v : B, algebraMap L B (ℓ : L) * v = ∑ k : Fin ℓ, ∑ α, (∑ h : ZMod ℓ, σ h (v * ∏ t ∈ Finset.Iio k, g α t)) * (c α * ∏ t ∈ Finset.Ici k, g α t) :=
by
  intro L _ ℓ _ ζ S B _ _ _ _ σ hσ0 hCS n c g hEIG hPART v
  classical
  have s1 : ∀ (h : ZMod ℓ) (k : Fin ℓ) (α : Fin n),
      σ h (∏ t ∈ Finset.Iio k, g α t) =
        algebraMap L B (ζ ^ (h.val * (k : ℕ))) * ∏ t ∈ Finset.Iio k, g α t := by
    intro h k α
    rw [map_prod, Finset.prod_congr rfl (fun t _ => hEIG h α t), Finset.prod_mul_distrib,
      Finset.prod_const, Fin.card_Iio, ← map_pow, ← pow_mul]
  have s2 : ∀ (k : Fin ℓ) (α : Fin n),
      (∏ t ∈ Finset.Iio k, g α t) * ∏ t ∈ Finset.Ici k, g α t = ∏ t, g α t := by
    intro k α
    have hc : (Finset.Iio k)ᶜ = Finset.Ici k := by
      ext t
      simp [not_lt]
    rw [← hc, Finset.prod_mul_prod_compl]
  have s5 : ∀ h : ZMod ℓ, ∑ k : Fin ℓ, algebraMap L B (ζ ^ (h.val * (k : ℕ))) =
      if h = 0 then algebraMap L B (ℓ : L) else 0 := by
    intro h
    rw [← map_sum, Fin.sum_univ_eq_sum_range (fun k => ζ ^ (h.val * k)) ℓ, hCS]
    by_cases hh : h = 0
    · subst hh
      simp
    · have hnd : ¬ ℓ ∣ h.val := by
        intro hd
        exact hh ((ZMod.val_eq_zero h).mp (Nat.eq_zero_of_dvd_of_lt hd (ZMod.val_lt h)))
      rw [if_neg hnd, if_neg hh, map_zero]
  have hterm : ∀ (k : Fin ℓ) (α : Fin n) (h : ZMod ℓ),
      σ h (v * ∏ t ∈ Finset.Iio k, g α t) * (c α * ∏ t ∈ Finset.Ici k, g α t)
        = σ h v * algebraMap L B (ζ ^ (h.val * (k : ℕ))) * (c α * ∏ t, g α t) := by
    intro k α h
    rw [map_mul, s1, ← s2 k α]
    ring
  symm
  calc ∑ k : Fin ℓ, ∑ α, (∑ h : ZMod ℓ, σ h (v * ∏ t ∈ Finset.Iio k, g α t)) *
          (c α * ∏ t ∈ Finset.Ici k, g α t)
      = ∑ k : Fin ℓ, ∑ α, ∑ h : ZMod ℓ,
          σ h v * algebraMap L B (ζ ^ (h.val * (k : ℕ))) * (c α * ∏ t, g α t) := by
        refine Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun α _ => ?_))
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl (fun h _ => hterm k α h)
    _ = ∑ k : Fin ℓ, ∑ h : ZMod ℓ,
          σ h v * algebraMap L B (ζ ^ (h.val * (k : ℕ))) * ∑ α, c α * ∏ t, g α t := by
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun h _ => ?_)
        rw [Finset.mul_sum]
    _ = ∑ h : ZMod ℓ, σ h v * ∑ k : Fin ℓ, algebraMap L B (ζ ^ (h.val * (k : ℕ))) := by
        simp only [hPART, mul_one]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun h _ => ?_)
        rw [Finset.mul_sum]
    _ = ∑ h : ZMod ℓ, if h = 0 then σ h v * algebraMap L B (ℓ : L) else 0 := by
        refine Finset.sum_congr rfl (fun h _ => ?_)
        rw [s5, mul_ite, mul_zero]
    _ = algebraMap L B (ℓ : L) * v := by
        rw [Finset.sum_ite_eq' Finset.univ (0 : ZMod ℓ), if_pos (Finset.mem_univ _), hσ0,
          AlgHom.id_apply, mul_comm]

theorem wc_kds_kappa_bijective : ∀ (L : Type u) [Field L] (ℓ : ℕ) [NeZero ℓ] (R S B : Type u) [CommRing R] [CommRing S] [CommRing B] [Algebra L R] [Algebra R S] [Algebra S B] [Algebra L S] [Algebra L B] [Algebra R B] [IsScalarTower L R S] [IsScalarTower L S B] [IsScalarTower R S B] (σ : ZMod ℓ → (B →ₐ[S] B)) (B₀ : Subalgebra R B), Function.Injective (algebraMap S B) → (ℓ : L) ≠ 0 → (∀ v : B, ∑ h : ZMod ℓ, σ h v ∈ Set.range (algebraMap S B)) → (∀ β ∈ B₀, ∑ h : ZMod ℓ, σ h β ∈ Set.range (algebraMap R B)) → ∀ (n : ℕ) (c : Fin n → R) (g : Fin n → Fin ℓ → B), (∀ (k : Fin ℓ) (α : Fin n), ∏ t ∈ Finset.Iio k, g α t ∈ B₀) → (∀ (k : Fin ℓ) (α : Fin n), ∏ t ∈ Finset.Ici k, g α t ∈ B₀) → (∀ v : B, algebraMap L B (ℓ : L) * v = ∑ k : Fin ℓ, ∑ α, (∑ h : ZMod ℓ, σ h (v * ∏ t ∈ Finset.Iio k, g α t)) * (algebraMap R B (c α) * ∏ t ∈ Finset.Ici k, g α t)) → Function.Bijective (Algebra.TensorProduct.lift (Algebra.ofId S B) B₀.val (fun _ _ => Commute.all _ _)) :=
by
  intro L _ ℓ _ R S B _ _ _ _ _ _ _ _ _ _ _ _ σ B₀ hinj hℓ hS hR n c g haI haC hrec
  classical

  have hS' : ∀ v : B, ∃ s : S, algebraMap S B s = ∑ h : ZMod ℓ, σ h v := fun v => hS v
  choose τ hτ using hS'
  have hτadd : ∀ x y, τ (x + y) = τ x + τ y := by
    intro x y
    apply hinj
    rw [map_add, hτ, hτ, hτ]
    simp only [map_add, Finset.sum_add_distrib]
  have hτlin : ∀ (s : S) x, τ (algebraMap S B s * x) = s * τ x := by
    intro s x
    apply hinj
    rw [map_mul, hτ, hτ, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun h _ => ?_)
    rw [map_mul, AlgHom.commutes]
  have hτ0 : τ 0 = 0 := by
    apply hinj
    rw [hτ, map_zero]
    simp
  have hτR : ∀ β ∈ B₀, ∃ r : R, algebraMap R S r = τ β := by
    intro β hβ
    obtain ⟨r, hr⟩ := hR β hβ
    refine ⟨r, hinj ?_⟩
    rw [hτ, ← hr, ← IsScalarTower.algebraMap_apply]

  have hT : ∀ x : L, algebraMap R B (algebraMap L R x) = algebraMap L B x := by
    intro x
    rw [IsScalarTower.algebraMap_apply L S B, IsScalarTower.algebraMap_apply L R S,
      ← IsScalarTower.algebraMap_apply R S B]
  have hU : algebraMap R B (algebraMap L R (ℓ : L)⁻¹) * algebraMap L B (ℓ : L) = 1 := by
    rw [hT, ← map_mul, inv_mul_cancel₀ hℓ, map_one]
  obtain ⟨u, hu⟩ : ∃ u : R, algebraMap R B u * algebraMap L B (ℓ : L) = 1 := ⟨_, hU⟩

  obtain ⟨bb, hbb⟩ : ∃ bb : Fin ℓ → Fin n → B₀, ∀ k α,
      (bb k α : B) = algebraMap R B (u * c α) * ∏ t ∈ Finset.Ici k, g α t :=
    ⟨fun k α => ⟨_, B₀.mul_mem (B₀.algebraMap_mem _) (haC k α)⟩, fun _ _ => rfl⟩
  have hdual : ∀ v : B, ∑ k : Fin ℓ, ∑ α : Fin n,
      algebraMap S B (τ (v * ∏ t ∈ Finset.Iio k, g α t)) * (bb k α : B) = v := by
    intro v
    calc ∑ k : Fin ℓ, ∑ α : Fin n,
          algebraMap S B (τ (v * ∏ t ∈ Finset.Iio k, g α t)) * (bb k α : B)
        = algebraMap R B u * ∑ k : Fin ℓ, ∑ α : Fin n,
          (∑ h : ZMod ℓ, σ h (v * ∏ t ∈ Finset.Iio k, g α t)) *
            (algebraMap R B (c α) * ∏ t ∈ Finset.Ici k, g α t) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun k _ => ?_)
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun α _ => ?_)
          rw [hbb, hτ, map_mul]
          ring
      _ = algebraMap R B u * (algebraMap L B (ℓ : L) * v) := by rw [hrec v]
      _ = v := by rw [← mul_assoc, hu, one_mul]

  set κ := Algebra.TensorProduct.lift (Algebra.ofId S B) B₀.val (fun _ _ => Commute.all _ _)
    with hκ
  have hκt : ∀ (s : S) (β : B₀), κ (s ⊗ₜ[R] β) = algebraMap S B s * (β : B) := by
    intro s β
    rw [hκ, Algebra.TensorProduct.lift_tmul]
    rfl
  obtain ⟨ψ, hψ⟩ : ∃ ψ : B → TensorProduct R S B₀, ∀ v, ψ v =
      ∑ k : Fin ℓ, ∑ α : Fin n, τ (v * ∏ t ∈ Finset.Iio k, g α t) ⊗ₜ[R] bb k α :=
    ⟨_, fun _ => rfl⟩
  have hright : ∀ v, κ (ψ v) = v := by
    intro v
    rw [hψ]
    simp only [map_sum, hκt]
    exact hdual v
  have hleft : ∀ z, ψ (κ z) = z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero =>
      rw [map_zero, hψ]
      simp only [zero_mul, hτ0, TensorProduct.zero_tmul, Finset.sum_const_zero]
    | tmul s β =>
      rw [hκt]
      have hρ : ∀ k α, ∃ r : R, algebraMap R S r = τ ((β : B) * ∏ t ∈ Finset.Iio k, g α t) :=
        fun k α => hτR _ (B₀.mul_mem β.2 (haI k α))
      choose ρ hρ using hρ
      have e1 : ψ (algebraMap S B s * β) = s ⊗ₜ[R] (∑ k, ∑ α, ρ k α • bb k α) := by
        rw [hψ]
        simp only [TensorProduct.tmul_sum]
        refine Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun α _ => ?_))
        rw [mul_assoc, hτlin, ← hρ, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_comm]
      rw [e1]
      congr 1
      apply Subtype.ext
      rw [← hdual (β : B)]
      simp only [AddSubmonoidClass.coe_finsetSum, Subalgebra.coe_smul]
      simp only [Algebra.smul_def]
      refine Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun α _ => ?_))
      rw [← hρ, ← IsScalarTower.algebraMap_apply]
    | add x y hx hy =>
      have e : ψ (κ x + κ y) = ψ (κ x) + ψ (κ y) := by
        rw [hψ, hψ, hψ]
        simp only [add_mul, hτadd, TensorProduct.add_tmul, Finset.sum_add_distrib]
      rw [map_add, e, hx, hy]
  exact ⟨Function.LeftInverse.injective hleft, Function.RightInverse.surjective hright⟩

theorem wc_kds_tordescL_bijective : ∀ (R S B B₀ : Type u) [CommRing R] [CommRing S] [CommRing B] [CommRing B₀] [Algebra R S] [Algebra S B] [Algebra R B] [IsScalarTower R S B] [Algebra R B₀] (ℓ : ℕ) (σ : ZMod ℓ → (B →ₐ[S] B)) (j : B₀ →ₐ[R] B), Function.Bijective (Algebra.TensorProduct.lift (Algebra.ofId S B) j (fun _ _ => Commute.all _ _)) → Function.Bijective (wcTorDescMu S B ℓ σ) → Function.Bijective (wcTorDescL R B ℓ B₀ (AlgHom.pi (fun h => ((σ h).restrictScalars R).comp j))) :=
by
  intro R S B B₀ _ _ _ _ _ _ _ _ _ ℓ σ j hκ hμ
  let κ : TensorProduct R S B₀ ≃ₗ[S] B := LinearEquiv.ofBijective
    (Algebra.TensorProduct.lift (Algebra.ofId S B) j (fun _ _ => Commute.all _ _)).toLinearMap hκ
  let e : TensorProduct R B B₀ ≃ₗ[S] TensorProduct S B B :=
    ((TensorProduct.AlgebraTensorModule.cancelBaseChange R S B B B₀).symm.restrictScalars S).trans
      ((LinearEquiv.lTensor B κ).trans (TensorProduct.comm S B B))
  have hκ1 : ∀ β : B₀, κ (1 ⊗ₜ[R] β) = j β := by
    intro β
    show (Algebra.TensorProduct.lift (Algebra.ofId S B) j (fun _ _ => Commute.all _ _))
      (1 ⊗ₜ[R] β) = j β
    rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
  have he : ∀ (b : B) (β : B₀), e (b ⊗ₜ[R] β) = j β ⊗ₜ[S] b := by
    intro b β
    show TensorProduct.comm S B B (LinearEquiv.lTensor B κ
      ((TensorProduct.AlgebraTensorModule.cancelBaseChange R S B B B₀).symm (b ⊗ₜ[R] β))) = _
    rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul, LinearEquiv.lTensor_tmul,
      TensorProduct.comm_tmul, hκ1]
  have hfun : ⇑(wcTorDescL R B ℓ B₀ (AlgHom.pi (fun h => ((σ h).restrictScalars R).comp j))) =
      ⇑(wcTorDescMu S B ℓ σ) ∘ ⇑e := by
    funext z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul b β =>
      rw [Function.comp_apply, he]
      funext h
      simp [wcTorDescL, wcTorDescMu, Algebra.TensorProduct.lift_tmul, mul_comm]
    | add x y hx hy =>
      rw [Function.comp_apply] at hx hy ⊢
      rw [map_add, map_add, map_add, hx, hy]
  rw [hfun]
  exact hμ.comp e.bijective

theorem wc_kummer_subalgebra_descent : ∀ (L : Type u) [Field L] (ℓ : ℕ), ℓ.Prime → ∀ (ζ : L), IsPrimitiveRoot ζ ℓ → ∀ (R S B : Type u) [CommRing R] [CommRing S] [CommRing B] [Algebra L R] [Algebra R S] [Algebra S B] [Algebra L S] [Algebra L B] [Algebra R B] [IsScalarTower L R S] [IsScalarTower L S B] [IsScalarTower R S B] [Module.FaithfullyFlat R S] (σ : ZMod ℓ → (B →ₐ[S] B)), σ 0 = AlgHom.id S B → (∀ c c', σ (c + c') = (σ c).comp (σ c')) → Algebra.Etale S B → Module.Finite S B → Function.Surjective (PrimeSpectrum.comap (algebraMap S B)) → Function.Bijective (wcTorDescMu S B ℓ σ) → ∀ (M : Submodule S B), (∀ b : B, b ∈ M ↔ σ 1 b = algebraMap L B ζ * b) → ∀ (N : Submodule R M), Function.Bijective (N.subtype.liftBaseChange S) → (∀ x : Fin ℓ → N, ∏ i, ((x i : M) : B) ∈ Set.range (algebraMap R B)) → ∃ (B₀ : Type u) (_ : CommRing B₀) (_ : Algebra R B₀) (σ₀ : ZMod ℓ → (B₀ →ₐ[R] B₀)) (κ : TensorProduct R S B₀ ≃ₐ[S] B), σ₀ 0 = AlgHom.id R B₀ ∧ (∀ c c', σ₀ (c + c') = (σ₀ c).comp (σ₀ c')) ∧ Algebra.Etale R B₀ ∧ Module.Finite R B₀ ∧ Function.Surjective (PrimeSpectrum.comap (algebraMap R B₀)) ∧ Function.Bijective (wcTorDescMu R B₀ ℓ σ₀) :=
by
  intro L _ ℓ hℓ ζ hprim R S B _ _ _ _ _ _ _ _ _ _ _ _ _ σ hσ0 hσadd hBet hBfin hBsurj hBmu
    M hM N hNbij hprod
  classical
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  haveI := hBet
  haveI := hBfin
  haveI : Module.FaithfullyFlat S B := Module.FaithfullyFlat.of_comap_surjective hBsurj
  haveI : Module.FaithfullyFlat R B := Module.FaithfullyFlat.trans R S B
  have hinj : Function.Injective (algebraMap S B) := FaithfulSMul.algebraMap_injective S B
  obtain ⟨hℓL, hc1, hc2⟩ := wc_kds_char_sum L ℓ hℓ ζ hprim

  obtain ⟨G, hGdef⟩ : ∃ G : Set B, G = {b : B | ∃ x : N, ((x : M) : B) = b} := ⟨_, rfl⟩
  have hGmem : ∀ b, b ∈ G ↔ ∃ x : N, ((x : M) : B) = b := by
    intro b; rw [hGdef]; rfl
  have hG : ∀ (h : ZMod ℓ), ∀ g ∈ G, σ h g = algebraMap L B (ζ ^ h.val) * g := by
    intro h g hg
    obtain ⟨x, rfl⟩ := (hGmem g).1 hg
    exact wc_kds_eigen_pow L ℓ ζ S B σ hσ0 hσadd _ ((hM _).1 (x : M).2) h
  have hGprod : ∀ f : Fin ℓ → B, (∀ t, f t ∈ G) → ∏ t, f t ∈ Set.range (algebraMap R B) := by
    intro f hf
    have hf' : ∀ t, ∃ x : N, ((x : M) : B) = f t := fun t => (hGmem _).1 (hf t)
    choose x hx using hf'
    have h := hprod x
    simpa only [hx] using h

  obtain ⟨hmonA, hmonB, hmonC⟩ := wc_kds_monomial_span_mul R B ℓ G hℓ.pos hGprod
  have h1P : (1 : B) ∈ Submodule.span R
      {b : B | ∃ k : ℕ, k < ℓ ∧ ∃ f : Fin k → B, (∀ t, f t ∈ G) ∧ b = ∏ t, f t} :=
    Submodule.subset_span ⟨0, hℓ.pos, Fin.elim0, fun t => t.elim0, (Fin.prod_univ_zero _).symm⟩
  let B₀ : Subalgebra R B := (Submodule.span R
      {b : B | ∃ k : ℕ, k < ℓ ∧ ∃ f : Fin k → B, (∀ t, f t ∈ G) ∧ b = ∏ t, f t}).toSubalgebra
    h1P hmonC

  obtain ⟨-, μ, hμ⟩ := wc_kummer_eigen_line L ℓ hℓ ζ hprim S B σ hσ0 hσadd hBet hBfin hBsurj
    hBmu M hM
  have hS := wc_kds_one_mem_span_S R S B ℓ M ⟨μ, hμ⟩ N hNbij.2
  have hR := wc_kds_one_mem_span_R R S B hinj _ (by rintro y ⟨x, rfl⟩; exact hprod x) hS
  obtain ⟨n, c, y, hy⟩ := Submodule.mem_span_set'.mp hR
  have hy' : ∀ α, ∃ x : Fin ℓ → N, ∏ i, ((x i : M) : B) = (y α : B) := fun α => (y α).2
  choose xα hxα using hy'
  let g : Fin n → Fin ℓ → B := fun α t => ((xα α t : M) : B)
  have hgG : ∀ α t, g α t ∈ G := fun α t => (hGmem _).2 ⟨xα α t, rfl⟩
  have hpart : ∑ α, algebraMap R B (c α) * ∏ t, g α t = 1 := by
    rw [← hy]
    refine Finset.sum_congr rfl (fun α _ => ?_)
    rw [Algebra.smul_def, ← hxα α]
  have hgEig : ∀ (h : ZMod ℓ) (α : Fin n) (t : Fin ℓ),
      σ h (g α t) = algebraMap L B (ζ ^ h.val) * g α t := fun h α t => hG h _ (hgG α t)
  have hrec := wc_kds_reconstruction L ℓ ζ S B σ hσ0 hc1 n (fun α => algebraMap R B (c α)) g
    hgEig hpart

  have hStr := wc_kds_trace_mem_base S B ℓ σ hσadd hBmu.1
  have hRtr := wc_kds_monomial_trace L ℓ ζ R S B σ G hc2 hG

  have haIio : ∀ (k : Fin ℓ) (α : Fin n), ∏ t ∈ Finset.Iio k, g α t ∈ B₀ :=
    fun k α => hmonB ℓ (Finset.Iio k) (g α) (hgG α)
  have haIci : ∀ (k : Fin ℓ) (α : Fin n), ∏ t ∈ Finset.Ici k, g α t ∈ B₀ :=
    fun k α => hmonB ℓ (Finset.Ici k) (g α) (hgG α)
  have hκ := wc_kds_kappa_bijective L ℓ R S B σ B₀ hinj hℓL hStr
    (fun β hβ => (hRtr β hβ).2) n c g haIio haIci hrec
  let κ : TensorProduct R S B₀ ≃ₐ[S] B := AlgEquiv.ofBijective _ hκ

  let σ₀ : ZMod ℓ → (B₀ →ₐ[R] B₀) := fun c =>
    AlgHom.codRestrict (((σ c).restrictScalars R).comp B₀.val) B₀ (fun x => (hRtr x x.2).1 c)
  let ι : B₀ →ₐ[R] (ZMod ℓ → B) := AlgHom.pi (fun h => ((σ h).restrictScalars R).comp B₀.val)
  have hι0 : ∀ z : B₀, ι z 0 = (z : B) := by
    intro z
    show (σ 0) (z : B) = z
    rw [hσ0]; rfl
  have hιinj : Function.Injective ι := by
    intro x x' hxx
    apply Subtype.ext
    rw [← hι0 x, ← hι0 x', hxx]
  have hshift : ∀ c b h, ι (σ₀ c b) h = ι b (h + c) := by
    intro c b h
    show σ h (σ c b) = σ (h + c) b
    rw [hσadd]; rfl
  have hL := wc_kds_tordescL_bijective R S B B₀ ℓ σ B₀.val hκ hBmu
  obtain ⟨p1, p2, p3, p4, p5, p6⟩ :=
    wc_ff_torsor_descent_props R B ℓ B₀ ι σ₀ hιinj hshift hL
  exact ⟨B₀, inferInstance, inferInstance, σ₀, κ, p4, p5, p1, p2, p3, p6⟩

theorem wc_spec_tensor_isPullback : ∀ (R S B₀ B : Type u) [CommRing R] [CommRing S] [CommRing B₀] [CommRing B] [Algebra R S] [Algebra R B₀] [Algebra S B] (κ : TensorProduct R S B₀ ≃ₐ[S] B), IsPullback (Spec.map (CommRingCat.ofHom (κ.toAlgHom.toRingHom.comp (Algebra.TensorProduct.includeRight : B₀ →ₐ[R] TensorProduct R S B₀).toRingHom))) (Spec.map (CommRingCat.ofHom (algebraMap S B))) (Spec.map (CommRingCat.ofHom (algebraMap R B₀))) (Spec.map (CommRingCat.ofHom (algebraMap R S))) :=
by
  intro R S B₀ B _ _ _ _ _ _ _ κ
  have h1 := (CommRingCat.isPushout_tensorProduct R S B₀).flip
  have h3 : IsPushout (CommRingCat.ofHom (algebraMap R B₀)) (CommRingCat.ofHom (algebraMap R S))
      (CommRingCat.ofHom (κ.toAlgHom.toRingHom.comp
        (Algebra.TensorProduct.includeRight : B₀ →ₐ[R] TensorProduct R S B₀).toRingHom))
      (CommRingCat.ofHom (algebraMap S B)) := by
    refine IsPushout.of_iso h1 (Iso.refl _) (Iso.refl _) (Iso.refl _)
      κ.toRingEquiv.toCommRingCatIso ?_ ?_ ?_ ?_
    · simp
    · simp
    · ext x
      rfl
    · ext s
      change κ (s ⊗ₜ[R] (1 : B₀)) = algebraMap S B s
      rw [← κ.commutes s, Algebra.TensorProduct.algebraMap_apply]
      rfl
  exact isPullback_SpecMap_of_isPushout _ _ _ _ h3

theorem wc_et_curve_torsor_algclosed_descent : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] (s : Spec (.of A) ⟶ Spec (.of K)) (W : Scheme.{u}) [IsAffine W] (e : W ⟶ wcHalA1 s) [Etale e] (L : Type u) [Field L] [IsAlgClosed L] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (zb : Spec (.of L) ⟶ Spec (.of A)) (ι : L →+* Ω) (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback (e ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb)) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∃ (Q : Scheme.{u}) (q : Q ⟶ Limits.pullback (e ≫ wcHalA1Proj s) zb) (β : ZMod ℓ → (Q ⟶ Q)) (j : P ⟶ Q), wcFetTorsor q ℓ β ∧ IsPullback j p q (Limits.pullback.lift (Limits.pullback.fst (e ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb)) (Limits.pullback.snd (e ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom ι) ≫ zb) ≫ Spec.map (CommRingCat.ofHom ι)) (by rw [Limits.pullback.condition, Category.assoc])) :=
by
  intro K _ A _ s W _ e _ L _ _ Ω _ _ zb ι ℓ hℓ hℓK P p α hP
  classical

  have hℓL : (ℓ : L) ≠ 0 := by
    intro h
    have h2 : (Spec.preimage (zb ≫ s)).hom (ℓ : K) = (ℓ : L) := map_natCast _ ℓ
    apply hℓK
    apply (Spec.preimage (zb ≫ s)).hom.injective
    rw [h2, map_zero]
    exact h

  haveI : NeZero (ℓ : L) := ⟨hℓL⟩
  obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ L) (by
    rw [Polynomial.degree_cyclotomic]
    exact_mod_cast (Nat.totient_pos.mpr hℓ.pos).ne')
  have hprim : IsPrimitiveRoot ζ ℓ := (Polynomial.isRoot_cyclotomic_iff).mp hζ

  letI : Algebra L Ω := ι.toAlgebra
  obtain ⟨R, _, _, _, _, ψ, Θ, hRet, hΘ⟩ := wc_ctd_affine_etale_presentation K A s W e L Ω zb
  haveI := hRet
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩

  have core : ∀ (P' : Scheme.{u}) (p' : P' ⟶ Spec (.of (TensorProduct L R Ω)))
      (α' : ZMod ℓ → (P' ⟶ P')), wcFetTorsor p' ℓ α' →
      ∃ (Q : Scheme.{u}) (q : Q ⟶ Spec (.of R)) (β : ZMod ℓ → (Q ⟶ Q)) (j : P' ⟶ Q),
        wcFetTorsor q ℓ β ∧
        IsPullback j p' q (Spec.map (CommRingCat.ofHom (algebraMap R (TensorProduct L R Ω)))) := by
    intro P' p' α' hP'
    obtain ⟨B, _, _, σ, φ, hφ, hσ0, hσadd, hBet, hBfin, hBsurj, hBmu⟩ :=
      wc_fet_torsor_affine_ring_data (TensorProduct L R Ω) P' p' ℓ α' hP'
    letI : Algebra L B := ((algebraMap (TensorProduct L R Ω) B).comp
      (algebraMap L (TensorProduct L R Ω))).toAlgebra
    letI : Algebra R B := ((algebraMap (TensorProduct L R Ω) B).comp
      (algebraMap R (TensorProduct L R Ω))).toAlgebra
    haveI : IsScalarTower L (TensorProduct L R Ω) B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower R (TensorProduct L R Ω) B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)

    let M : Submodule (TensorProduct L R Ω) B :=
      { carrier := {b | σ 1 b = algebraMap L B ζ * b}
        add_mem' := fun {a b} ha hb => by
          simp only [Set.mem_setOf_eq] at ha hb ⊢
          rw [map_add, ha, hb, mul_add]
        zero_mem' := by
          simp only [Set.mem_setOf_eq]
          rw [map_zero, mul_zero]
        smul_mem' := fun c {b} hb => by
          simp only [Set.mem_setOf_eq] at hb ⊢
          rw [map_smul, hb, mul_smul_comm] }
    have hM : ∀ b : B, b ∈ M ↔ σ 1 b = algebraMap L B ζ * b := fun b => Iff.rfl
    obtain ⟨hMinv, μ, hμ⟩ := wc_kummer_eigen_line L ℓ hℓ ζ hprim (TensorProduct L R Ω) B σ hσ0
      hσadd hBet hBfin hBsurj hBmu M hM
    obtain ⟨N₀, _, _, hN₀inv, ⟨μ₀⟩, ⟨φ₀⟩⟩ :=
      wc_curve_pic_ell_torsion_descent L Ω R ℓ hℓ hℓL M hMinv ⟨μ⟩
    have hunits := wc_curve_units_descent L Ω R ℓ hℓ.pos
    obtain ⟨N, hNbij, hNval⟩ :=
      wc_kummer_line_adjust R (TensorProduct L R Ω) M N₀ ℓ hℓ.pos μ μ₀ φ₀ hunits
    have hprod : ∀ x : Fin ℓ → N, ∏ i, ((x i : M) : B) ∈ Set.range (algebraMap R B) := by
      intro x
      obtain ⟨r, hr⟩ := hNval x
      refine ⟨r, ?_⟩
      have h1 := hμ (fun i => (x i : M))
      rw [← hr] at h1
      exact h1
    obtain ⟨B₀, _, _, σ₀, κ, h0', hadd', het', hfin', hsurj', hmu'⟩ :=
      wc_kummer_subalgebra_descent L ℓ hℓ ζ hprim R (TensorProduct L R Ω) B σ hσ0 hσadd hBet
        hBfin hBsurj hBmu M hM N hNbij hprod
    have hQ := wc_fet_torsor_of_ring R B₀ ℓ σ₀ het' hfin' hsurj' h0' hadd' hmu'
    have hsq := wc_spec_tensor_isPullback R (TensorProduct L R Ω) B₀ B κ
    refine ⟨Spec (.of B₀), _, _, φ.hom ≫ Spec.map (CommRingCat.ofHom (κ.toAlgHom.toRingHom.comp
      (Algebra.TensorProduct.includeRight :
        B₀ →ₐ[R] TensorProduct R (TensorProduct L R Ω) B₀).toRingHom)), hQ, ?_⟩
    refine IsPullback.of_iso hsq φ.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp
    · simp [← hφ]
    · simp
    · simp
  exact wc_fet_descent_iso_transport _ _ ψ Θ hΘ ℓ core P p α hP

theorem wc_shens_integral_closure_algclosed : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ζ : A →+* Ω), ∃ (L : Type u) (_ : Field L) (_ : IsAlgClosed L) (ι : L →+* Ω) (A' : Type u) (_ : CommRing A') (_ : IsDomain A') (_ : IsIntegrallyClosed A') (_ : HenselianLocalRing A') (_ : IsSepClosed (IsLocalRing.ResidueField A')) (f : A →+* A') (j : A' →+* L), f.IsIntegral ∧ Function.Injective j ∧ (∀ y : L, ∃ a b : A', j b ≠ 0 ∧ y * j b = j a) ∧ ι.comp (j.comp f) = ζ :=
by
  intro A _ _ _ Ω _ _ ζ
  classical


  refine (fun hfl : ∀ (H : Type u) [CommRing H] [HenselianLocalRing H] (g h : Polynomial H)
      (a : ℕ), g.Monic → h.Monic →
      g.map (IsLocalRing.residue H) = Polynomial.X ^ a * h.map (IsLocalRing.residue H) →
      IsUnit (h.eval 0) → ∃ g₁ g₂ : Polynomial H, g₁.Monic ∧ g₂.Monic ∧ g = g₁ * g₂ ∧
        g₁.map (IsLocalRing.residue H) = Polynomial.X ^ a ∧
        g₂.map (IsLocalRing.residue H) = h.map (IsLocalRing.residue H) => ?_) ?_

  let F : Subfield Ω := Subfield.closure (Set.range ζ)
  let K : IntermediateField F Ω := algebraicClosure F Ω
  have hAC : IsAlgClosed K := IsAlgClosure.isAlgClosed F
  have hmem : ∀ a, ζ a ∈ K := fun a =>
    K.algebraMap_mem ⟨ζ a, Subfield.subset_closure ⟨a, rfl⟩⟩
  let ζL : A →+* K := ζ.codRestrict K hmem
  let ι : K →+* Ω := K.val.toRingHom
  have hcomp : ι.comp ζL = ζ := RingHom.ext fun _ => rfl

  have hden : ∀ c : F, ∃ t : A, ζ t ≠ 0 ∧ ζ t * (c : Ω) ∈ ζ.range := by
    intro c
    obtain ⟨u, hu, w, hw, huw⟩ := Subfield.mem_closure_iff.mp c.2
    have hR : Subring.closure (Set.range ζ) = ζ.range := by
      rw [← ζ.coe_range, Subring.closure_eq]
    rw [hR] at hu hw
    obtain ⟨r, rfl⟩ := hu
    obtain ⟨t, rfl⟩ := hw
    by_cases ht : ζ t = 0
    · refine ⟨1, by simp, ?_⟩
      rw [← huw, ht, div_zero, mul_zero]
      exact zero_mem _
    · refine ⟨t, ht, ?_⟩
      have e : ζ t * (ζ r / ζ t) = ζ r := by field_simp
      rw [← huw, e]
      exact ζ.mem_range_self r

  have hden2 : ∀ (c : ℕ → F) (s : Finset ℕ), ∃ t : A, ζ t ≠ 0 ∧
      ∀ i ∈ s, ζ t * (c i : Ω) ∈ ζ.range := by
    intro c s
    induction s using Finset.induction_on with
    | empty => exact ⟨1, by simp, fun i hi => by simp at hi⟩
    | insert i s hi ih =>
      obtain ⟨t, ht, hts⟩ := ih
      obtain ⟨t', ht', ht's⟩ := hden (c i)
      refine ⟨t' * t, by rw [map_mul]; exact mul_ne_zero ht' ht, ?_⟩
      intro j hj
      rw [map_mul]
      rcases Finset.mem_insert.mp hj with rfl | hj
      · rw [mul_comm (ζ t'), mul_assoc]
        exact Subring.mul_mem _ (ζ.mem_range_self t) ht's
      · rw [mul_assoc]
        exact Subring.mul_mem _ (ζ.mem_range_self t') (hts j hj)

  have hint : ∀ y : K, ∃ s : A, ζL s ≠ 0 ∧ ζL.IsIntegralElem (ζL s * y) := by
    intro y
    have hy : IsIntegral F (y : Ω) := mem_algebraicClosure_iff'.mp y.2
    obtain ⟨q, hqm, hq⟩ := hy
    obtain ⟨t, ht, hts⟩ := hden2 (fun i => q.coeff i) (Finset.range (q.natDegree + 1))
    let p : Polynomial Ω := q.map (algebraMap F Ω)
    have hpm : p.Monic := hqm.map _
    have hpd : p.natDegree = q.natDegree := hqm.natDegree_map _
    let Q : Polynomial Ω := p.scaleRoots (ζ t)
    have hQm : Q.Monic := (Polynomial.monic_scaleRoots_iff (ζ t)).mpr hpm
    have hQ0 : Polynomial.eval₂ (RingHom.id Ω) (ζ t * (y : Ω)) Q = 0 := by
      have h0 : Polynomial.eval₂ (RingHom.id Ω) (y : Ω) p = 0 := by
        rw [Polynomial.eval₂_id, Polynomial.eval_map]
        exact hq
      exact Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id Ω) h0
    have hcoeff : ∀ n, Q.coeff n ∈ ζ.range := by
      intro n
      rw [Polynomial.coeff_scaleRoots, hpd, Polynomial.coeff_map]
      rcases lt_trichotomy n q.natDegree with hn | hn | hn
      · obtain ⟨k, hk⟩ : ∃ k, q.natDegree - n = k + 1 := ⟨q.natDegree - n - 1, by omega⟩
        rw [hk, pow_succ, ← mul_assoc, mul_comm _ (ζ t ^ k), mul_assoc]
        refine Subring.mul_mem _ (Subring.pow_mem _ (ζ.mem_range_self t) k) ?_
        rw [mul_comm]
        exact hts n (Finset.mem_range.mpr (by omega))
      · subst hn
        rw [hqm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one, map_one]
        exact one_mem _
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hn, map_zero, zero_mul]
        exact zero_mem _
    have hlift : Q ∈ Polynomial.lifts ζ :=
      (Polynomial.lifts_iff_coeff_lifts Q).mpr (fun n => (ζ.mem_range).mp (hcoeff n))
    obtain ⟨P, hPmap, -, hPm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hQm
    refine ⟨t, ?_, P, hPm, ?_⟩
    · intro h
      apply ht
      have h' := congrArg ι h
      rw [map_zero] at h'
      exact h'
    · apply ι.injective
      rw [Polynomial.hom_eval₂, hcomp, map_zero]
      change Polynomial.eval₂ ζ (ζ t * (y : Ω)) P = 0
      rw [← Polynomial.eval_map, hPmap, ← Polynomial.eval₂_id]
      exact hQ0

  letI : Algebra A K := ζL.toAlgebra
  let A' := integralClosure A K
  have hfrac : ∀ y : K, ∃ a b : A', (b : K) ≠ 0 ∧ y * (b : K) = (a : K) := by
    intro y
    obtain ⟨s, hs, hsy⟩ := hint y
    exact ⟨⟨ζL s * y, hsy⟩, algebraMap A A' s, hs, mul_comm _ _⟩
  have hroots : ∀ p : Polynomial A', p.Monic → 0 < p.natDegree → ∃ r : A', p.IsRoot r := by
    intro p hpm hpd
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_root (p.map (algebraMap A' K)) (by
      rw [Polynomial.degree_eq_natDegree (hpm.map _).ne_zero, hpm.natDegree_map]
      exact_mod_cast hpd.ne')
    have hy' : Polynomial.eval₂ (algebraMap A' K) y p = 0 := by
      rw [← Polynomial.eval_map]
      exact hy
    have hyA' : IsIntegral A' y := ⟨p, hpm, hy'⟩
    have hyA : IsIntegral A y := isIntegral_trans y hyA'
    refine ⟨⟨y, hyA⟩, ?_⟩
    have h1 : algebraMap A' K (p.eval ⟨y, hyA⟩) = 0 := by
      rw [← Polynomial.eval₂_at_apply]
      exact hy'
    exact Subtype.ext h1
  haveI : FaithfulSMul A' K :=
    (faithfulSMul_iff_algebraMap_injective A' K).mpr Subtype.val_injective
  haveI : IsFractionRing A' K := IsFractionRing.of_field A' K (fun z => by
    obtain ⟨a, b, hb, hab⟩ := hfrac z
    refine ⟨a, b, ?_⟩
    show z = (a : K) / (b : K)
    exact (eq_div_iff hb).mpr hab)
  have hclosed : IsIntegrallyClosed A' :=
    (isIntegrallyClosed_iff K).mpr (fun {x} hx => ⟨⟨x, isIntegral_trans x hx⟩, rfl⟩)

  let f : A →+* A' := algebraMap A A'
  have hfint : f.IsIntegral := fun x => Algebra.IsIntegral.isIntegral x
  have hloc : IsLocalRing A' := by
    refine IsLocalRing.of_isUnit_or_isUnit_one_sub_self (fun x => ?_)
    obtain ⟨g, hgm, hgx⟩ := hfint x
    have hgb : g.map (IsLocalRing.residue A) ≠ 0 := (hgm.map _).ne_zero
    obtain ⟨hb, hgbeq, hndvd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd
      (g.map (IsLocalRing.residue A)) hgb 0
    generalize (g.map (IsLocalRing.residue A)).rootMultiplicity 0 = r at hgbeq
    rw [map_zero, sub_zero] at hgbeq
    have hcoeff0 : hb.coeff 0 ≠ 0 := fun h0 =>
      hndvd (by rw [map_zero, sub_zero]; exact Polynomial.X_dvd_iff.mpr h0)
    have hbm : hb.Monic := by
      have h := hgm.map (IsLocalRing.residue A)
      rw [hgbeq] at h
      exact (Polynomial.monic_X.pow _).of_mul_monic_left h
    have hlift : hb ∈ Polynomial.lifts (IsLocalRing.residue A) :=
      (Polynomial.lifts_iff_coeff_lifts hb).mpr (fun n => IsLocalRing.residue_surjective _)
    obtain ⟨h, hhmap, -, hhm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hbm
    have hh0 : IsUnit (h.eval 0) := by
      rw [← Polynomial.coeff_zero_eq_eval_zero, ← IsLocalRing.residue_ne_zero_iff_isUnit,
        ← Polynomial.coeff_map, hhmap]
      exact hcoeff0
    obtain ⟨g₁, g₂, -, -, hgeq, hg₁map, hg₂map⟩ :=
      hfl A g h r hgm hhm (by rw [hhmap]; exact hgbeq) hh0
    rw [hgeq, Polynomial.eval₂_mul] at hgx
    rcases mul_eq_zero.mp hgx with h1 | h2
    ·
      right
      have hc : IsUnit (g₁.eval 1) := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
        have e : IsLocalRing.residue A (g₁.eval 1) = (g₁.map (IsLocalRing.residue A)).eval 1 := by
          rw [Polynomial.eval_map, ← map_one (IsLocalRing.residue A), Polynomial.eval₂_at_apply]
        rw [e, hg₁map, Polynomial.eval_pow, Polynomial.eval_X, one_pow]
        exact one_ne_zero
      have hdecomp : (Polynomial.X - Polynomial.C 1) *
          ((g₁ - Polynomial.C (g₁.eval 1)) /ₘ (Polynomial.X - Polynomial.C 1)) =
          g₁ - Polynomial.C (g₁.eval 1) :=
        Polynomial.mul_divByMonic_eq_iff_isRoot.mpr (by simp [Polynomial.IsRoot.def])
      have h3 := congrArg (Polynomial.eval₂ f x) hdecomp
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_sub, Polynomial.eval₂_sub, Polynomial.eval₂_X,
        Polynomial.eval₂_C, Polynomial.eval₂_C, map_one, h1] at h3
      have h4 : (1 - x) * Polynomial.eval₂ f x
          ((g₁ - Polynomial.C (g₁.eval 1)) /ₘ (Polynomial.X - Polynomial.C 1)) =
          f (g₁.eval 1) := by
        linear_combination -h3
      exact isUnit_of_mul_isUnit_left (by rw [h4]; exact hc.map f)
    ·
      left
      have hc : IsUnit (g₂.coeff 0) := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit, ← Polynomial.coeff_map, hg₂map, hhmap]
        exact hcoeff0
      have h3 := congrArg (Polynomial.eval₂ f x) (Polynomial.X_mul_divX_add g₂)
      rw [h2, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X,
        Polynomial.eval₂_C] at h3
      have h4 : x * (-Polynomial.eval₂ f x g₂.divX) = f (g₂.coeff 0) := by
        linear_combination -h3
      exact isUnit_of_mul_isUnit_left (by rw [h4]; exact hc.map f)

  have hP : ∀ d : ℕ, ∀ g : Polynomial A', g.Monic → g.natDegree = d → ∀ a₀ : A',
      g.eval a₀ ∈ IsLocalRing.maximalIdeal A' →
        ∃ a, g.IsRoot a ∧ a - a₀ ∈ IsLocalRing.maximalIdeal A' := by
    intro d
    induction d with
    | zero =>
      intro g hg hd a₀ h
      rw [Polynomial.eq_one_of_monic_natDegree_zero hg hd, Polynomial.eval_one] at h
      exact absurd h (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one)
    | succ d ih =>
      intro g hg hd a₀ h
      obtain ⟨r, hr⟩ := hroots g hg (by omega)
      have hdiv := (Polynomial.mul_divByMonic_eq_iff_isRoot).mpr hr
      have hqm : (g /ₘ (Polynomial.X - Polynomial.C r)).Monic := by
        have hg' := hg
        rw [← hdiv] at hg'
        exact (Polynomial.monic_X_sub_C r).of_mul_monic_left hg'
      have hqd : (g /ₘ (Polynomial.X - Polynomial.C r)).natDegree = d := by
        rw [Polynomial.natDegree_divByMonic _ (Polynomial.monic_X_sub_C r), hd,
          Polynomial.natDegree_X_sub_C]
        omega
      have hev : g.eval a₀ = (a₀ - r) * (g /ₘ (Polynomial.X - Polynomial.C r)).eval a₀ := by
        conv_lhs => rw [← hdiv]
        rw [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
      rw [hev] at h
      rcases (IsLocalRing.maximalIdeal.isMaximal A').isPrime.mem_or_mem h with h1 | h1
      · refine ⟨r, hr, ?_⟩
        have h2 := neg_mem h1
        rwa [neg_sub] at h2
      · obtain ⟨a, ha, ha'⟩ := ih _ hqm hqd a₀ h1
        refine ⟨a, ?_, ha'⟩
        rw [← hdiv, Polynomial.IsRoot.def, Polynomial.eval_mul, ha.eq_zero, mul_zero]
  have hhen : HenselianLocalRing A' :=
    @HenselianLocalRing.mk A' _ hloc (fun g hg a₀ h _ => hP _ g hg rfl a₀ h)
  have hres : IsAlgClosed (IsLocalRing.ResidueField A') := by
    refine IsAlgClosed.of_exists_root _ (fun p hpm hpirr => ?_)
    have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue A') :=
      (Polynomial.lifts_iff_coeff_lifts p).mpr (fun n => IsLocalRing.residue_surjective _)
    obtain ⟨P, hPmap, hPdeg, hPm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hpm
    obtain ⟨r, hr⟩ := hroots P hPm (by
      rw [hPdeg]
      exact Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_pos_of_irreducible hpirr))
    refine ⟨IsLocalRing.residue A' r, ?_⟩
    rw [← hPmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hr.eq_zero, map_zero]
  have hsep : IsSepClosed (IsLocalRing.ResidueField A') := IsSepClosed.of_isAlgClosed _
  refine ⟨K, inferInstance, hAC, ι, A', inferInstance, inferInstance, hclosed, hhen, hsep, f,
    (integralClosure A K).val.toRingHom, hfint, fun _ _ h => Subtype.ext h, hfrac, ?_⟩
  exact RingHom.ext fun _ => rfl

  intro H _ _ g h a hgm hhm hred hh0
  classical

  have hetale : ∀ (E : Type u) [CommRing E] [Algebra H E] [Algebra.Etale H E]
      (σ : E →ₐ[H] IsLocalRing.ResidueField H), ∃ τ : E →ₐ[H] H,
        ∀ x : E, IsLocalRing.residue H (τ x) = σ x := by
    intro E _ _ _ σ
    haveI hq : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
    haveI : Algebra.FormallyEtale E (Localization.AtPrime (RingHom.ker σ)) :=
      Algebra.FormallyEtale.of_isLocalization (RingHom.ker σ).primeCompl
    haveI : Algebra.IsEtaleAt H (RingHom.ker σ) :=
      Algebra.FormallyEtale.comp H E (Localization.AtPrime (RingHom.ker σ))
    obtain ⟨g, hg, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := H) (RingHom.ker σ)
    have hσg : IsUnit (σ g) := isUnit_iff_ne_zero.mpr (fun h => hg (RingHom.mem_ker.mpr h))
    let σg : Localization.Away g →ₐ[H] IsLocalRing.ResidueField H :=
      IsLocalization.Away.liftAlgHom g hσg
    have hσg_apply : ∀ y : E, σg (algebraMap E (Localization.Away g) y) = σ y := by
      intro y
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    obtain ⟨Q⟩ := hstd.nonempty_standardEtalePresentation
    let e : Q.Ring ≃ₐ[H] Localization.Away g :=
      AlgEquiv.ofBijective (Q.lift Q.x Q.hasMap) Q.lift_bijective
    have heX : e Q.X = Q.x := by
      rw [AlgEquiv.ofBijective_apply]
      exact Q.lift_X _ _
    set a₀ := σg Q.x with ha₀
    have hf0 : Polynomial.aeval a₀ Q.f = 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply, Q.hasMap.1, map_zero]
    have hf' : Polynomial.aeval a₀ (Polynomial.derivative Q.f) ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact ((StandardEtalePair.HasMap.isUnit_derivative_f Q.P Q.hasMap).map σg).ne_zero
    have hg0 : Polynomial.aeval a₀ Q.g ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact (Q.hasMap.2.map σg).ne_zero
    have hHen := ((HenselianLocalRing.TFAE H).out 1 2).mp (inferInstance : HenselianLocalRing H)
    obtain ⟨a, hroot, hres⟩ := hHen Q.f Q.monic_f a₀ hf0 hf'
    have hres' : ∀ p : Polynomial H,
        IsLocalRing.residue H (Polynomial.aeval a p) = Polynomial.aeval a₀ p := by
      intro p
      rw [← hres, ← IsLocalRing.ResidueField.algebraMap_eq, ← Algebra.ofId_apply,
        ← Algebra.ofId_apply, ← Polynomial.aeval_algHom_apply]
    have hHas : Q.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]
        exact hroot
      · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres']
        exact hg0
    have hcomp : (Algebra.ofId H (IsLocalRing.ResidueField H)).comp (Q.lift a hHas) =
        σg.comp (e : Q.Ring →ₐ[H] Localization.Away g) := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, Q.lift_X, AlgEquiv.coe_toAlgHom, heX,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq, hres]
    refine ⟨((Q.lift a hHas).comp (e.symm : Localization.Away g →ₐ[H] Q.Ring)).comp
      (IsScalarTower.toAlgHom H E (Localization.Away g)), fun y => ?_⟩
    have h1 := congrArg (fun φ => φ (e.symm (algebraMap E (Localization.Away g) y))) hcomp
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
      Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
    rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
      AlgEquiv.coe_toAlgHom, h1, hσg_apply]

  have hhalg : ∀ (κ : Type) [Fintype κ] [DecidableEq κ] (F : κ → MvPolynomial κ H),
      Algebra.Etale H (MvPolynomial (κ ⊕ Unit) H ⧸ Ideal.span (Set.range (Sum.elim
        (fun j => MvPolynomial.rename Sum.inl (F j)) (fun _ : Unit => MvPolynomial.X (Sum.inr ()) *
          MvPolynomial.rename Sum.inl (Matrix.det (Matrix.of fun j k =>
            MvPolynomial.pderiv k (F j))) - 1)))) := by
    intro κ _ _ F
    set Δ : MvPolynomial κ H := Matrix.det (Matrix.of fun j k => MvPolynomial.pderiv k (F j))
      with hΔ
    set rel : κ ⊕ Unit → MvPolynomial (κ ⊕ Unit) H := Sum.elim
      (fun j => MvPolynomial.rename Sum.inl (F j))
      (fun _ : Unit => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl Δ - 1) with hrel
    let P₀ : Algebra.Presentation H (MvPolynomial (κ ⊕ Unit) H ⧸ Ideal.span (Set.range rel))
      (κ ⊕ Unit) (κ ⊕ Unit) := Algebra.Presentation.naive (v := rel)
    have hP₀rel : P₀.relation = rel := Algebra.Presentation.naive_relation _ _
    let P' : Algebra.PreSubmersivePresentation H
        (MvPolynomial (κ ⊕ Unit) H ⧸ Ideal.span (Set.range rel)) (κ ⊕ Unit) (κ ⊕ Unit) :=
      { toPresentation := P₀, map := id, map_inj := Function.injective_id }
    have hzero : ∀ p : MvPolynomial κ H,
        MvPolynomial.pderiv (Sum.inr () : κ ⊕ Unit) (MvPolynomial.rename Sum.inl p) = 0 := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => rw [MvPolynomial.rename_C, MvPolynomial.pderiv_C]
      | add p q hp hq => rw [map_add, map_add, hp, hq, add_zero]
      | mul_X p n hp =>
        rw [map_mul, MvPolynomial.rename_X, MvPolynomial.pderiv_mul, hp,
          MvPolynomial.pderiv_X_of_ne (by simp), zero_mul, mul_zero, add_zero]
    have hJ : P'.jacobiMatrix = Matrix.fromBlocks
        (Matrix.of fun k j => MvPolynomial.rename Sum.inl (MvPolynomial.pderiv k (F j)))
        (Matrix.of fun k (_ : Unit) => MvPolynomial.pderiv (Sum.inl k) (rel (Sum.inr ()))) 0
        (Matrix.of fun (_ : Unit) (_ : Unit) => MvPolynomial.rename Sum.inl Δ) := by
      apply Matrix.ext
      intro i j
      rw [P'.jacobiMatrix_apply]
      show MvPolynomial.pderiv i (P₀.relation j) = _
      rw [hP₀rel]
      rcases i with k | ⟨⟩ <;> rcases j with j | ⟨⟩
      · rw [Matrix.fromBlocks_apply₁₁, Matrix.of_apply]
        simp only [hrel, Sum.elim_inl]
        exact MvPolynomial.pderiv_rename Sum.inl_injective k (F j)
      · rw [Matrix.fromBlocks_apply₁₂, Matrix.of_apply]
      · rw [Matrix.fromBlocks_apply₂₁, Matrix.zero_apply]
        simp only [hrel, Sum.elim_inl]
        exact hzero _
      · rw [Matrix.fromBlocks_apply₂₂, Matrix.of_apply]
        simp only [hrel, Sum.elim_inr]
        rw [map_sub, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self, hzero,
          Derivation.map_one_eq_zero, one_mul, mul_zero, add_zero, sub_zero]
    have hdet : P'.jacobiMatrix.det =
        MvPolynomial.rename Sum.inl Δ * MvPolynomial.rename Sum.inl Δ := by
      have hA : (Matrix.of fun k j => (MvPolynomial.rename (Sum.inl : κ → κ ⊕ Unit) :
            MvPolynomial κ H →ₐ[H] MvPolynomial (κ ⊕ Unit) H) (MvPolynomial.pderiv k (F j))) =
          ((MvPolynomial.rename (Sum.inl : κ → κ ⊕ Unit) :
            MvPolynomial κ H →ₐ[H] MvPolynomial (κ ⊕ Unit) H).mapMatrix
              (Matrix.of fun j k => MvPolynomial.pderiv k (F j))).transpose := by
        apply Matrix.ext
        intro k j
        rfl
      rw [hJ, Matrix.det_fromBlocks_zero₂₁, hA, Matrix.det_transpose, ← AlgHom.map_det, ← hΔ,
        Matrix.det_unique (Matrix.of fun (_ : Unit) (_ : Unit) => MvPolynomial.rename Sum.inl Δ),
        Matrix.of_apply]
    have hunit : IsUnit P'.jacobian := by
      rw [P'.jacobian_eq_jacobiMatrix_det, hdet, Algebra.Generators.algebraMap_apply, map_mul]
      have h : MvPolynomial.aeval P₀.val
          (MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl Δ - 1) = 0 :=
        P₀.aeval_val_relation (Sum.inr ())
      rw [map_sub, map_mul, map_one, sub_eq_zero] at h
      have hu : IsUnit (MvPolynomial.aeval P₀.val (MvPolynomial.rename Sum.inl Δ)) :=
        isUnit_of_mul_isUnit_right (by rw [h]; exact isUnit_one)
      exact hu.mul hu
    let P : Algebra.SubmersivePresentation H
        (MvPolynomial (κ ⊕ Unit) H ⧸ Ideal.span (Set.range rel)) (κ ⊕ Unit) (κ ⊕ Unit) :=
      { toPreSubmersivePresentation := P', jacobian_isUnit := hunit }
    rw [Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero]
    exact ⟨⟨κ ⊕ Unit, κ ⊕ Unit, inferInstance, inferInstance, P, Nat.sub_self _⟩⟩

  have hmv : ∀ (κ : Type) [Fintype κ] [DecidableEq κ] (F : κ → MvPolynomial κ H) (a₀ : κ → H),
      (∀ j, MvPolynomial.eval a₀ (F j) ∈ IsLocalRing.maximalIdeal H) →
      IsUnit (Matrix.det (Matrix.of fun j k => MvPolynomial.eval a₀ (MvPolynomial.pderiv k (F j)))) →
      ∃ a : κ → H, (∀ j, MvPolynomial.eval a (F j) = 0) ∧
        ∀ k, a k - a₀ k ∈ IsLocalRing.maximalIdeal H := by
    intro κ _ _ F a₀ hF hdet
    set Δ : MvPolynomial κ H := Matrix.det (Matrix.of fun j k => MvPolynomial.pderiv k (F j))
      with hΔ
    set rel : κ ⊕ Unit → MvPolynomial (κ ⊕ Unit) H := Sum.elim
      (fun j => MvPolynomial.rename Sum.inl (F j))
      (fun _ : Unit => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl Δ - 1) with hrel
    set I := Ideal.span (Set.range rel) with hI
    haveI : Algebra.Etale H (MvPolynomial (κ ⊕ Unit) H ⧸ I) := hhalg κ F
    have hevΔ : MvPolynomial.eval a₀ Δ = Matrix.det (Matrix.of fun j k =>
        MvPolynomial.eval a₀ (MvPolynomial.pderiv k (F j))) := by
      rw [hΔ, RingHom.map_det]
      rfl
    set res := IsLocalRing.residue H
    have hres : ∀ q : MvPolynomial κ H,
        MvPolynomial.aeval (fun k => res (a₀ k)) q = res (MvPolynomial.eval a₀ q) := by
      intro q
      rw [MvPolynomial.aeval_def, MvPolynomial.eval, MvPolynomial.coe_eval₂Hom,
        MvPolynomial.eval₂_comp_left]
      rfl
    set u := res (MvPolynomial.eval a₀ Δ) with hu
    have hu0 : u ≠ 0 := by
      rw [hu, hevΔ]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hdet
    set pt : κ ⊕ Unit → IsLocalRing.ResidueField H :=
      Sum.elim (fun k => res (a₀ k)) (fun _ => u⁻¹) with hpt
    set Φ := MvPolynomial.aeval (R := H) pt with hΦ
    have hΦI : ∀ a ∈ I, Φ a = 0 := by
      intro a ha
      have : I ≤ RingHom.ker Φ := by
        rw [hI, Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        rcases i with j | _
        · simp only [hrel, Sum.elim_inl, hΦ, MvPolynomial.aeval_rename]
          rw [show pt ∘ Sum.inl = fun k => res (a₀ k) from rfl, hres,
            IsLocalRing.residue_eq_zero_iff]
          exact hF j
        · simp only [hrel, Sum.elim_inr, hΦ, map_sub, map_mul, MvPolynomial.aeval_rename,
            MvPolynomial.aeval_X, map_one]
          rw [show pt ∘ Sum.inl = fun k => res (a₀ k) from rfl, hres]
          simp only [hpt, Sum.elim_inr]
          rw [← hu, inv_mul_cancel₀ hu0, sub_self]
      exact this ha
    let σ' := Ideal.Quotient.liftₐ I Φ hΦI
    obtain ⟨τ, hτ⟩ := hetale _ σ'
    refine ⟨fun k => τ (Ideal.Quotient.mk I (MvPolynomial.X (Sum.inl k))), fun j => ?_,
      fun k => ?_⟩
    · have h1 : (τ.comp (Ideal.Quotient.mkₐ H I)) =
          MvPolynomial.aeval (fun i => τ (Ideal.Quotient.mk I (MvPolynomial.X i))) := by
        rw [MvPolynomial.aeval_unique (τ.comp (Ideal.Quotient.mkₐ H I))]
        rfl
      have h2 := congrArg (fun φ => φ (MvPolynomial.rename Sum.inl (F j))) h1
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, MvPolynomial.aeval_rename] at h2
      have h3 : Ideal.Quotient.mk I (MvPolynomial.rename Sum.inl (F j)) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem, hI]
        exact Ideal.subset_span ⟨Sum.inl j, rfl⟩
      rw [h3, map_zero] at h2
      rw [← MvPolynomial.coe_aeval_eq_eval]
      exact h2.symm
    · rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero, hτ]
      show Φ (MvPolynomial.X (Sum.inl k)) = _
      rw [hΦ, MvPolynomial.aeval_X]
      rfl
  set res := IsLocalRing.residue H with hres_def
  set b := h.natDegree with hb
  have hgdeg : g.natDegree = a + b := by
    have e2 : (Polynomial.X ^ a * h.map res).natDegree = a + b := by
      rw [(Polynomial.monic_X_pow a).natDegree_mul (hhm.map res), Polynomial.natDegree_X_pow,
        hhm.natDegree_map]
    rw [← hgm.natDegree_map res, hred, e2]

  let Gv : (Fin (a + b) → H) → Polynomial H := fun v => Polynomial.X ^ a +
    ∑ i : Fin a, Polynomial.C (v (Fin.castAdd b i)) * Polynomial.X ^ (i : ℕ)
  let Hv : (Fin (a + b) → H) → Polynomial H := fun v => Polynomial.X ^ b +
    ∑ j : Fin b, Polynomial.C (v (Fin.natAdd a j)) * Polynomial.X ^ (j : ℕ)
  have hGvm : ∀ v, (Gv v).Monic := fun v =>
    Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt _)
  have hHvm : ∀ v, (Hv v).Monic := fun v =>
    Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt _)
  have hGvd : ∀ v, (Gv v).natDegree = a := fun v => by
    show (Polynomial.X ^ a + _).natDegree = a
    rw [Polynomial.natDegree_add_eq_left_of_degree_lt, Polynomial.natDegree_X_pow]
    rw [Polynomial.degree_X_pow]
    exact Polynomial.degree_sum_fin_lt _
  have hHvd : ∀ v, (Hv v).natDegree = b := fun v => by
    show (Polynomial.X ^ b + _).natDegree = b
    rw [Polynomial.natDegree_add_eq_left_of_degree_lt, Polynomial.natDegree_X_pow]
    rw [Polynomial.degree_X_pow]
    exact Polynomial.degree_sum_fin_lt _

  let G : Polynomial (MvPolynomial (Fin (a + b)) H) := Polynomial.X ^ a +
    ∑ i : Fin a, Polynomial.C (MvPolynomial.X (Fin.castAdd b i)) * Polynomial.X ^ (i : ℕ)
  let Hp : Polynomial (MvPolynomial (Fin (a + b)) H) := Polynomial.X ^ b +
    ∑ j : Fin b, Polynomial.C (MvPolynomial.X (Fin.natAdd a j)) * Polynomial.X ^ (j : ℕ)
  have hGmap : ∀ v, G.map (MvPolynomial.eval v) = Gv v := fun v => by
    simp [G, Gv, Polynomial.map_sum]
  have hHmap : ∀ v, Hp.map (MvPolynomial.eval v) = Hv v := fun v => by
    simp [Hp, Hv, Polynomial.map_sum]
  let F : Fin (a + b) → MvPolynomial (Fin (a + b)) H := fun n =>
    (G * Hp).coeff n - MvPolynomial.C (g.coeff n)
  have hFev : ∀ v n, MvPolynomial.eval v (F n) = (Gv v * Hv v).coeff n - g.coeff n := by
    intro v n
    simp only [F, map_sub, MvPolynomial.eval_C]
    rw [← Polynomial.coeff_map, Polynomial.map_mul, hGmap, hHmap]

  let a₀ : Fin (a + b) → H := fun m => if (m : ℕ) < a then 0 else h.coeff ((m : ℕ) - a)
  have hGa₀ : Gv a₀ = Polynomial.X ^ a := by
    simp [Gv, a₀]
  have hHa₀ : Hv a₀ = h := by
    have e := hhm.as_sum
    rw [← hb] at e
    conv_rhs => rw [e]
    simp only [Hv, a₀, Fin.coe_natAdd]
    congr 1
    rw [← Fin.sum_univ_eq_sum_range (fun j => Polynomial.C (h.coeff j) * Polynomial.X ^ j) b]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [if_neg (by omega), Nat.add_sub_cancel_left]
  have hres_v : ∀ n, MvPolynomial.eval a₀ (F n) ∈ IsLocalRing.maximalIdeal H := by
    intro n
    rw [← IsLocalRing.residue_eq_zero_iff, hFev, hGa₀, hHa₀, map_sub, ← Polynomial.coeff_map,
      ← Polynomial.coeff_map, Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_X, hred,
      sub_self]

  have hGc : ∀ p : ℕ, G.coeff p = if hp : p < a then MvPolynomial.X (Fin.castAdd b ⟨p, hp⟩)
      else if p = a then 1 else 0 := by
    intro p
    simp only [G, Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finset_sum_coeff,
      Polynomial.coeff_C_mul_X_pow]
    by_cases hp : p < a
    · rw [dif_pos hp, if_neg (by omega), zero_add, Finset.sum_eq_single ⟨p, hp⟩]
      · simp
      · intro i _ hi
        rw [if_neg]
        intro h'
        exact hi (Fin.ext h'.symm)
      · intro h'
        exact absurd (Finset.mem_univ _) h'
    · rw [dif_neg hp, Finset.sum_eq_zero, add_zero]
      intro i _
      rw [if_neg]
      intro h'
      exact hp (by have := i.isLt; omega)
  have hHc : ∀ q : ℕ, Hp.coeff q = if hq : q < b then MvPolynomial.X (Fin.natAdd a ⟨q, hq⟩)
      else if q = b then 1 else 0 := by
    intro q
    simp only [Hp, Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.finset_sum_coeff,
      Polynomial.coeff_C_mul_X_pow]
    by_cases hq : q < b
    · rw [dif_pos hq, if_neg (by omega), zero_add, Finset.sum_eq_single ⟨q, hq⟩]
      · simp
      · intro i _ hi
        rw [if_neg]
        intro h'
        exact hi (Fin.ext h'.symm)
      · intro h'
        exact absurd (Finset.mem_univ _) h'
    · rw [dif_neg hq, Finset.sum_eq_zero, add_zero]
      intro i _
      rw [if_neg]
      intro h'
      exact hq (by have := i.isLt; omega)
  have hpX : ∀ k m : Fin (a + b), MvPolynomial.pderiv m
      (MvPolynomial.X k : MvPolynomial (Fin (a + b)) H) = if k = m then 1 else 0 := by
    intro k m
    split_ifs with hkm
    · subst hkm
      exact MvPolynomial.pderiv_X_self _
    · exact MvPolynomial.pderiv_X_of_ne hkm
  have hD1 : ∀ (m : Fin (a + b)) (p : ℕ), MvPolynomial.eval a₀ (MvPolynomial.pderiv m (G.coeff p)) =
      if (m : ℕ) < a ∧ p = m then 1 else 0 := by
    intro m p
    rw [hGc]
    by_cases hp : p < a
    · rw [dif_pos hp, hpX]
      by_cases hm : Fin.castAdd b ⟨p, hp⟩ = m
      · rw [if_pos hm, if_pos, map_one]
        rw [← hm]
        simp [hp]
      · rw [if_neg hm, if_neg, map_zero]
        rintro ⟨_, hpm⟩
        exact hm (Fin.ext (by simp [hpm]))
    · rw [dif_neg hp]
      have e : MvPolynomial.pderiv m
          (if p = a then (1 : MvPolynomial (Fin (a + b)) H) else 0) = 0 := by
        split_ifs <;> simp
      rw [e, map_zero, if_neg]
      rintro ⟨hm, hpm⟩
      omega
  have hD2 : ∀ (m : Fin (a + b)) (q : ℕ), MvPolynomial.eval a₀ (MvPolynomial.pderiv m (Hp.coeff q)) =
      if a ≤ (m : ℕ) ∧ a + q = m then 1 else 0 := by
    intro m q
    rw [hHc]
    by_cases hq : q < b
    · rw [dif_pos hq, hpX]
      by_cases hm : Fin.natAdd a ⟨q, hq⟩ = m
      · rw [if_pos hm, if_pos, map_one]
        rw [← hm]
        simp
      · rw [if_neg hm, if_neg, map_zero]
        rintro ⟨_, hqm⟩
        exact hm (Fin.ext (by simp [hqm]))
    · rw [dif_neg hq]
      have e : MvPolynomial.pderiv m
          (if q = b then (1 : MvPolynomial (Fin (a + b)) H) else 0) = 0 := by
        split_ifs <;> simp
      rw [e, map_zero, if_neg]
      rintro ⟨hm, hqm⟩
      have := m.isLt
      omega
  have hEG : ∀ p : ℕ, MvPolynomial.eval a₀ (G.coeff p) = if p = a then 1 else 0 := by
    intro p
    rw [← Polynomial.coeff_map, hGmap, hGa₀, Polynomial.coeff_X_pow]
  have hEH : ∀ q : ℕ, MvPolynomial.eval a₀ (Hp.coeff q) = h.coeff q := by
    intro q
    rw [← Polynomial.coeff_map, hHmap, hHa₀]

  have hJ : ∀ n m : Fin (a + b), MvPolynomial.eval a₀ (MvPolynomial.pderiv m (F n)) =
      ∑ x ∈ Finset.HasAntidiagonal.antidiagonal (n : ℕ), ((if x.1 = a then (1 : H) else 0) *
        (if a ≤ (m : ℕ) ∧ a + x.2 = m then 1 else 0) +
        h.coeff x.2 * (if (m : ℕ) < a ∧ x.1 = m then 1 else 0)) := by
    intro n m
    simp only [F, map_sub, MvPolynomial.pderiv_C, sub_zero, Polynomial.coeff_mul, map_sum,
      Derivation.leibniz, smul_eq_mul, map_add, map_mul]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [hEG, hEH, hD1, hD2]
  have hlow : ∀ n m : Fin (a + b), n < m →
      MvPolynomial.eval a₀ (MvPolynomial.pderiv m (F n)) = 0 := by
    intro n m hnm
    have hnm' : (n : ℕ) < m := hnm
    rw [hJ]
    refine Finset.sum_eq_zero (fun x hx => ?_)
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
    have e1 : (if x.1 = a then (1 : H) else 0) *
        (if a ≤ (m : ℕ) ∧ a + x.2 = m then 1 else 0) = 0 := by
      by_cases h1 : x.1 = a
      · rw [if_neg (show ¬(a ≤ (m : ℕ) ∧ a + x.2 = m) by omega), mul_zero]
      · rw [if_neg h1, zero_mul]
    have e2 : (if (m : ℕ) < a ∧ x.1 = m then (1 : H) else 0) = 0 :=
      if_neg (show ¬((m : ℕ) < a ∧ x.1 = m) by omega)
    rw [e1, e2, mul_zero, add_zero]
  have hdiag : ∀ m : Fin (a + b), IsUnit (MvPolynomial.eval a₀ (MvPolynomial.pderiv m (F m))) := by
    intro m
    rw [hJ]
    by_cases hm : (m : ℕ) < a
    · rw [Finset.sum_eq_single ((m : ℕ), 0)]
      · dsimp only
        rw [if_neg (show ¬((m : ℕ) = a) by omega), zero_mul, zero_add,
          if_pos (show (m : ℕ) < a ∧ (m : ℕ) = m from ⟨hm, rfl⟩), mul_one,
          Polynomial.coeff_zero_eq_eval_zero]
        exact hh0
      · intro x hx hne
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
        have e1 : (if x.1 = a then (1 : H) else 0) *
            (if a ≤ (m : ℕ) ∧ a + x.2 = m then 1 else 0) = 0 := by
          rw [if_neg (show ¬(a ≤ (m : ℕ) ∧ a + x.2 = m) by omega), mul_zero]
        have e2 : (if (m : ℕ) < a ∧ x.1 = m then (1 : H) else 0) = 0 := by
          rw [if_neg]
          rintro ⟨_, h2⟩
          exact hne (Prod.ext h2 (by show x.2 = 0; omega))
        rw [e1, e2, mul_zero, add_zero]
      · intro h'
        exact absurd (Finset.HasAntidiagonal.mem_antidiagonal.mpr (by simp)) h'
    · rw [Finset.sum_eq_single (a, (m : ℕ) - a)]
      · dsimp only
        rw [if_pos rfl, if_pos (show a ≤ (m : ℕ) ∧ a + ((m : ℕ) - a) = m by omega),
          if_neg (show ¬((m : ℕ) < a ∧ a = m) by omega), mul_zero, add_zero, mul_one]
        exact isUnit_one
      · intro x hx hne
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
        have e2 : (if (m : ℕ) < a ∧ x.1 = m then (1 : H) else 0) = 0 :=
          if_neg (show ¬((m : ℕ) < a ∧ x.1 = m) by omega)
        rw [e2, mul_zero, add_zero]
        by_cases h1 : x.1 = a
        · rw [if_neg (show ¬(a ≤ (m : ℕ) ∧ a + x.2 = m) from fun ⟨_, h2⟩ =>
            hne (Prod.ext h1 (by show x.2 = (m : ℕ) - a; omega))), mul_zero]
        · rw [if_neg h1, zero_mul]
      · intro h'
        exact absurd (Finset.HasAntidiagonal.mem_antidiagonal.mpr (by simp; omega)) h'
  have hdet : IsUnit (Matrix.det (Matrix.of fun n m =>
      MvPolynomial.eval a₀ (MvPolynomial.pderiv m (F n)))) := by
    rw [Matrix.det_of_lowerTriangular]
    · exact Finset.prod_induction _ IsUnit (fun _ _ => IsUnit.mul) isUnit_one
        (fun m _ => hdiag m)
    · intro n m hnm
      exact hlow n m hnm
  obtain ⟨v, hv0, hvm⟩ := hmv (Fin (a + b)) F a₀ hres_v hdet
  have hvres : ∀ k, res (v k) = res (a₀ k) := by
    intro k
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    exact hvm k
  refine ⟨Gv v, Hv v, hGvm v, hHvm v, ?_, ?_, ?_⟩
  · have hprodm : (Gv v * Hv v).Monic := (hGvm v).mul (hHvm v)
    have hprodd : (Gv v * Hv v).natDegree = a + b := by
      rw [(hGvm v).natDegree_mul (hHvm v), hGvd, hHvd]
    ext n
    rcases lt_trichotomy n (a + b) with hn | hn | hn
    · have e := hv0 ⟨n, hn⟩
      rw [hFev] at e
      exact (sub_eq_zero.mp e).symm
    · subst hn
      have e1 : g.coeff (a + b) = 1 := by
        rw [← hgdeg]
        exact hgm.coeff_natDegree
      have e2 : (Gv v * Hv v).coeff (a + b) = 1 := by
        rw [← hprodd]
        exact hprodm.coeff_natDegree
      rw [e1, e2]
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hgdeg]; exact hn),
        Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hprodd]; exact hn)]
  · have e : (Gv v).map res = (Gv a₀).map res := by
      simp only [Gv, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum,
        Polynomial.map_mul, Polynomial.map_C, hvres]
    rw [e, hGa₀, Polynomial.map_pow, Polynomial.map_X]
  · have e : (Hv v).map res = (Hv a₀).map res := by
      simp only [Hv, Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum,
        Polynomial.map_mul, Polynomial.map_C, hvres]
    rw [e, hHa₀]

theorem wc_hal_bc_closed_point : ∀ (A A' : Type u) [CommRing A] [CommRing A'] [IsLocalRing A] [IsLocalRing A'] (f : A →+* A'), f.IsIntegral → ∀ {Y Y' : Scheme.{u}} (π : Y ⟶ Spec (.of A)) (π' : Y' ⟶ Spec (.of A')) (p : Y' ⟶ Y), IsPullback p π' π (Spec.map (CommRingCat.ofHom f)) → ∀ y : Y, IsClosed ({y} : Set Y) → π y = IsLocalRing.closedPoint A → ∃ y' : Y', IsClosed ({y'} : Set Y') ∧ π' y' = IsLocalRing.closedPoint A' ∧ p y' = y :=
by
  intro A A' _ _ _ _ f hf Y Y' π π' p hpb y hy hπy
  have s1 : (Spec.map (CommRingCat.ofHom f)) (IsLocalRing.closedPoint A') =
      IsLocalRing.closedPoint A := by
    have hmax := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal' f hf
      (IsLocalRing.maximalIdeal A')
    have h2 : PrimeSpectrum.comap f (IsLocalRing.closedPoint A') = IsLocalRing.closedPoint A :=
      PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)
    exact h2
  haveI hg : IsIntegralHom (Spec.map (CommRingCat.ofHom f)) := IsIntegralHom.SpecMap_iff.mpr hf
  haveI hp : IsIntegralHom p := MorphismProperty.of_isPullback hpb.flip hg
  have hK : IsCompact (p ⁻¹' {y}) := p.isProperMap.isCompact_preimage isCompact_singleton
  set S : Set Y' := p ⁻¹' {y} ∩ π' ⁻¹' {IsLocalRing.closedPoint A'} with hS
  have hSc : IsClosed S :=
    IsClosed.inter (hy.preimage p.continuous)
      ((IsLocalRing.isClosed_singleton_closedPoint A').preimage π'.continuous)
  have hSk : IsCompact S := IsCompact.of_isClosed_subset hK hSc Set.inter_subset_left
  obtain ⟨z, hz1, hz2⟩ := Scheme.exists_preimage_of_isPullback hpb y (IsLocalRing.closedPoint A')
    (hπy.trans s1.symm)
  have hzS : z ∈ S := ⟨hz1, hz2⟩
  haveI : CompactSpace S := isCompact_iff_compactSpace.mp hSk
  obtain ⟨w, -, hw⟩ := IsClosed.exists_closed_singleton (X := S) isClosed_univ
    ⟨⟨z, hzS⟩, Set.mem_univ _⟩
  refine ⟨w.1, ?_, w.2.2, w.2.1⟩
  have := hSc.isClosedMap_subtype_val _ hw
  rwa [Set.image_singleton] at this

theorem wc_hal_a1_closed_point_residue_sepclosed : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → IsSepClosed ((wcHalA1 s).residueField x) :=
by
  intro K _ A _ _ _ s x hx hxc

  have crux : ∀ (Q : Ideal (Polynomial A)) [Q.IsMaximal],
      Q.comap Polynomial.C = IsLocalRing.maximalIdeal A → IsSepClosed Q.ResidueField := by
    intro Q _ hQ
    let π : Polynomial A →+* Q.ResidueField := algebraMap (Polynomial A) Q.ResidueField
    let ψ : A →+* Q.ResidueField := π.comp Polynomial.C
    have hloc : IsLocalHom ψ := by
      refine ⟨fun a ha => ?_⟩
      by_contra hna
      have hm : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hna
      rw [← hQ, Ideal.mem_comap] at hm
      have h0 : π (Polynomial.C a) = 0 := Ideal.algebraMap_residueField_eq_zero.mpr hm
      exact ha.ne_zero h0
    let ι : IsLocalRing.ResidueField A →+* Q.ResidueField := IsLocalRing.ResidueField.lift ψ
    letI : Algebra (IsLocalRing.ResidueField A) Q.ResidueField := ι.toAlgebra
    have hsurj : Function.Surjective
        (Polynomial.aeval (R := IsLocalRing.ResidueField A) (π Polynomial.X)) := by
      intro z
      obtain ⟨p, rfl⟩ := Ideal.algebraMap_residueField_surjective Q z
      refine ⟨p.map (IsLocalRing.residue A), ?_⟩
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have h1 : (algebraMap (IsLocalRing.ResidueField A) Q.ResidueField).comp
          (IsLocalRing.residue A) = ψ := by
        rw [RingHom.algebraMap_toAlgebra]
        exact IsLocalRing.ResidueField.lift_comp_residue ψ
      rw [h1]
      have h2 := Polynomial.hom_eval₂ p Polynomial.C π Polynomial.X
      rw [Polynomial.eval₂_C_X] at h2
      exact h2.symm
    have : Algebra.FiniteType (IsLocalRing.ResidueField A) Q.ResidueField :=
      Algebra.FiniteType.of_surjective (Polynomial.aeval _) hsurj
    have := finite_of_finite_type_of_isJacobsonRing (IsLocalRing.ResidueField A) Q.ResidueField
    have : Algebra.IsAlgebraic (IsLocalRing.ResidueField A) Q.ResidueField :=
      Algebra.IsAlgebraic.of_finite _ _
    exact Algebra.IsAlgebraic.isSepClosed (F := IsLocalRing.ResidueField A)

  have transport : ∀ (E F : Type u) [Field E] [Field F], (E ≃+* F) → IsSepClosed E →
      IsSepClosed F := by
    intro E F _ _ σ hE
    letI : Algebra E F := σ.toRingHom.toAlgebra
    have : Algebra.IsAlgebraic E F := ⟨fun z => by
      have hz : z = algebraMap E F (σ.symm z) := (σ.apply_symm_apply z).symm
      rw [hz]
      exact isAlgebraic_algebraMap _⟩
    exact Algebra.IsAlgebraic.isSepClosed (F := E)

  let φ : K →+* A := (Spec.preimage s).hom
  letI : Algebra K A := φ.toAlgebra
  have h₁ : Spec.map (CommRingCat.ofHom (algebraMap K A)) = s := by
    rw [RingHom.algebraMap_toAlgebra]
    simp only [φ, CommRingCat.ofHom_hom, Spec.map_preimage]
  let E₁ : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K A)))
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≅
      Limits.pullback s (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
    Limits.pullback.congrHom h₁ rfl
  let E₂ := pullbackSpecIso K A (Polynomial K)
  let ψ : Polynomial A ≃+* TensorProduct K A (Polynomial K) := (polyEquivTensor K A).toRingEquiv
  let E₃ : Spec (.of (TensorProduct K A (Polynomial K))) ≅ Spec (.of (Polynomial A)) :=
    { hom := Spec.map (CommRingCat.ofHom (ψ : Polynomial A →+* _))
      inv := Spec.map (CommRingCat.ofHom (ψ.symm : _ →+* Polynomial A))
      hom_inv_id := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.comp_symm,
          CommRingCat.ofHom_id, Spec.map_id]
      inv_hom_id := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.symm_comp,
          CommRingCat.ofHom_id, Spec.map_id] }
  let e : wcHalA1 s ≅ Spec (.of (Polynomial A)) := E₁.symm ≪≫ E₂ ≪≫ E₃
  have hC : (ψ : Polynomial A →+* TensorProduct K A (Polynomial K)).comp
      (Polynomial.C : A →+* Polynomial A) =
      (Algebra.TensorProduct.includeLeftRingHom : A →+* TensorProduct K A (Polynomial K)) := by
    ext a
    simp [ψ, polyEquivTensor_apply]
  have he : e.hom ≫ Spec.map (CommRingCat.ofHom Polynomial.C) = wcHalA1Proj s := by
    have h3 : E₃.hom ≫ Spec.map (CommRingCat.ofHom Polynomial.C) =
        Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
      show Spec.map (CommRingCat.ofHom (ψ : Polynomial A →+* TensorProduct K A (Polynomial K))) ≫ _ = _
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hC]
    have h4 : E₂.hom ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
        Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K A)))
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
      pullbackSpecIso_hom_fst K A (Polynomial K)
    show (E₁.inv ≫ E₂.hom ≫ E₃.hom) ≫ _ = _
    rw [Category.assoc, Category.assoc, h3, h4]
    simp only [E₁, Iso.symm_hom, Limits.pullback.congrHom_inv]
    exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)

  let y : PrimeSpectrum (Polynomial A) := e.hom x
  have hyc : IsClosed ({y} : Set (PrimeSpectrum (Polynomial A))) := by
    have h := (Homeomorph.isClosed_image (Scheme.homeoOfIso e)).mpr hx
    rw [Set.image_singleton, Scheme.coe_homeoOfIso] at h
    exact h
  have hmax : y.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal y).mp hyc
  have hcomap : y.asIdeal.comap Polynomial.C = IsLocalRing.maximalIdeal A := by
    have h : (Spec.map (CommRingCat.ofHom Polynomial.C)) (e.hom x) = wcHalA1Proj s x := by
      rw [← Scheme.Hom.comp_apply, he]
    rw [hxc, Spec.map_apply] at h
    exact congrArg PrimeSpectrum.asIdeal h
  have hsepQ := crux y.asIdeal hcomap
  let σ₁ : (Spec (.of (Polynomial A))).residueField y ≃+* y.asIdeal.ResidueField :=
    IsLocalRing.ResidueField.mapEquiv (Spec.stalkIso (.of (Polynomial A)) y).commRingCatIsoToRingEquiv
  let σ₂ : (Spec (.of (Polynomial A))).residueField (e.hom x) ≃+* (wcHalA1 s).residueField x :=
    (asIso (e.hom.residueFieldMap x)).commRingCatIsoToRingEquiv
  exact transport _ _ (σ₁.symm.trans σ₂) hsepQ

theorem wc_shdata_closed_point_compat : ∀ {Y : Scheme.{u}} (y : Y) (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ l, φ l (IsLocalRing.closedPoint B) = (W'.obj l).hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) :=
by
  intro Y y B _ _ Λ _ _ W' φ a hd l
  obtain ⟨hinit, -, hcompat, hφa, -, e, -, he⟩ := hd
  have hEt : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
  have hgeom : ∀ z, wcEtGeomPt Y y z = y := by
    intro z
    rw [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply y _
  have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) z =
      IsLocalRing.closedPoint B :=
    fun z => IsLocalRing.PrimeSpectrum.comap_residue B z
  have ha : a (IsLocalRing.closedPoint B) = y := by
    have h1 := congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
    rw [hres] at h1'
    exact h1'
  have h2 : (W'.obj l).right.hom (φ l (IsLocalRing.closedPoint B)) = y :=
    (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((congrArg (fun f => f (IsLocalRing.closedPoint B)) (hφa l)).trans ha)
  have h3 : (W'.obj l).right.hom ((W'.obj l).hom.left
      (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) = y :=
    (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((congrArg (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
        (Over.w (W'.obj l).hom)).trans (hgeom _))

  have hisoGen : ∀ {V S : Scheme.{u}} (f : V ⟶ S) [Etale f] (v : V),
      ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, f w = f v → w = v := by
    intro V S f _ v
    haveI hlqf : LocallyQuasiFinite f := by
      rw [HasRingHomProperty.iff_appLE (P := @LocallyQuasiFinite)]
      intro U W e
      have h := HasRingHomProperty.appLE @Etale f ‹Etale f› U W e
      letI := (f.appLE U W e).hom.toAlgebra
      haveI : Algebra.Etale _ _ := RingHom.Etale.toAlgebra h
      exact RingHom.quasiFinite_algebraMap.mpr inferInstance
    haveI hd : DiscreteTopology ↑(f ⁻¹' {f v}) := (f.fiberHomeo (f v)).discreteTopology
    have hv : f v ∈ ({f v} : Set S) := Set.mem_singleton _
    have hopen : IsOpen ({⟨v, hv⟩} : Set ↑(f ⁻¹' {f v})) := isOpen_discrete _
    obtain ⟨t, ht, hteq⟩ := isOpen_induced_iff.mp hopen
    refine ⟨⟨t, ht⟩, ?_, ?_⟩
    · have : (⟨v, hv⟩ : ↑(f ⁻¹' {f v})) ∈ Subtype.val ⁻¹' t := by
        rw [hteq]; exact Set.mem_singleton _
      exact this
    · intro w hwU hw
      have hw' : w ∈ f ⁻¹' {f v} := by
        simp only [Set.mem_preimage, Set.mem_singleton_iff]; exact hw
      have : (⟨w, hw'⟩ : ↑(f ⁻¹' {f v})) ∈ Subtype.val ⁻¹' t := hwU
      rw [hteq, Set.mem_singleton_iff] at this
      exact congrArg Subtype.val this
  obtain ⟨O, hwO, hiso⟩ := hisoGen (W'.obj l).right.hom
    ((W'.obj l).hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))

  have hr : Set.range (W'.obj l).hom.left ⊆ Set.range O.ι := by
    rintro _ ⟨z, rfl⟩
    have hz : z = IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)) :=
      Subsingleton.elim (α := PrimeSpectrum (AlgebraicClosure (Y.residueField y))) _ _
    subst hz
    exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mpr hwO
  let lam := IsOpenImmersion.lift O.ι (W'.obj l).hom.left hr
  have hlam : lam ≫ O.ι = (W'.obj l).hom.left := IsOpenImmersion.lift_fac _ _ _
  let R : Y.Etale := Scheme.Etale.mk (O.ι ≫ (W'.obj l).right.hom)
  have hlamR : lam ≫ ((Scheme.Etale.forget Y).obj R).hom = (Over.mk (wcEtGeomPt Y y)).hom := by
    show lam ≫ O.ι ≫ (W'.obj l).right.hom = wcEtGeomPt Y y
    rw [← Category.assoc, hlam]
    exact Over.w (W'.obj l).hom
  let d : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
    StructuredArrow.mk (Y := R) (Over.homMk lam hlamR)
  let iR : R ⟶ (W'.obj l).right := MorphismProperty.Over.homMk O.ι rfl trivial
  let i : d ⟶ W'.obj l := StructuredArrow.homMk iR (by
    apply Over.OverMorphism.ext
    exact hlam)

  obtain ⟨hI1, hI2⟩ := (Functor.initial_iff_of_isCofiltered W').mp hinit
  obtain ⟨l₁, ⟨g₁⟩⟩ := hI1 d
  obtain ⟨l₃, t', ht'⟩ := hI2 (W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁ ≫ i)
    (W'.map (IsCofiltered.minToRight l₁ l))
  have hg : (W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁) ≫ i =
      W'.map (t' ≫ IsCofiltered.minToRight l₁ l) := by
    rw [Functor.map_comp, Category.assoc, Category.assoc]
    exact ht'
  have hg' : (W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left ≫ O.ι =
      (W'.map (t' ≫ IsCofiltered.minToRight l₁ l)).right.left :=
    congrArg (fun k => k.right.left) hg
  have e1 : φ l = φ l₃ ≫ (W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left ≫ O.ι := by
    rw [hg', hcompat]
  have hmem : φ l (IsLocalRing.closedPoint B) ∈ O := by
    have h4 : φ l (IsLocalRing.closedPoint B) = O.ι
        ((W'.map t' ≫ W'.map (IsCofiltered.minToLeft l₁ l) ≫ g₁).right.left
          (φ l₃ (IsLocalRing.closedPoint B))) :=
      (congrArg (fun f => f (IsLocalRing.closedPoint B)) e1).trans
        ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _))
    rw [h4]
    exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mp (Set.mem_range_self _)
  exact hiso _ hmem (h2.trans h3.symm)

theorem wc_geom_lift_eq_of_sepclosed : ∀ {Y V : Scheme.{u}} (y : Y), IsSepClosed (Y.residueField y) → ∀ (h : V ⟶ Y) (t t₀ : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ V), t ≫ h = wcEtGeomPt Y y → t₀ ≫ h = wcEtGeomPt Y y → t (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) = t₀ (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) → t = t₀ :=
by

  have fieldext : ∀ (k L : Type u) [Field k] [Field L] (r : k →+* L)
      (φ ψ : L →+* AlgebraicClosure k),
      φ.comp r = algebraMap k (AlgebraicClosure k) →
      ψ.comp r = algebraMap k (AlgebraicClosure k) →
      ∃ σ : AlgebraicClosure k →+* AlgebraicClosure k, σ.comp ψ = φ ∧
        σ.comp (algebraMap k (AlgebraicClosure k)) = algebraMap k (AlgebraicClosure k) := by
    intro k L _ _ r φ ψ hφ hψ
    have hAlg : @Algebra.IsAlgebraic L (AlgebraicClosure k) _ _ ψ.toAlgebra := by
      letI : Algebra L (AlgebraicClosure k) := ψ.toAlgebra
      refine ⟨fun x => ?_⟩
      obtain ⟨p, hp0, hpx⟩ := Algebra.IsAlgebraic.isAlgebraic (R := k) x
      refine ⟨p.map r, (Polynomial.map_ne_zero_iff r.injective).mpr hp0, ?_⟩
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      rw [Polynomial.aeval_def] at hpx
      change Polynomial.eval₂ (ψ.comp r) x p = 0
      rw [hψ]
      exact hpx
    obtain ⟨σ, hσ⟩ : ∃ σ : AlgebraicClosure k →+* AlgebraicClosure k, ∀ l, σ (ψ l) = φ l := by
      let σ₀ := @IsAlgClosed.lift (AlgebraicClosure k) _ _ L _ _ (AlgebraicClosure k) _ _
        ψ.toAlgebra φ.toAlgebra _ _ hAlg
      exact ⟨@AlgHom.toRingHom L _ _ _ _ _ ψ.toAlgebra φ.toAlgebra σ₀,
        fun l => @AlgHom.commutes L _ _ _ _ _ ψ.toAlgebra φ.toAlgebra σ₀ l⟩
    have h1 : σ.comp ψ = φ := by
      ext l
      exact hσ l
    refine ⟨σ, h1, ?_⟩
    conv_lhs => rw [← hψ]
    rw [← RingHom.comp_assoc, h1, hφ]

  have factor : ∀ (B Y : Scheme.{u}) (h : Y ⟶ B) (b : B) (y : Y) (hy : h y = b)
      (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ Y),
      t ≫ h = wcEtGeomPt B b →
      t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = y →
      ∃ φ : Y.residueField y ⟶ CommRingCat.of (AlgebraicClosure (B.residueField b)),
        t = Spec.map φ ≫ Y.fromSpecResidueField y ∧
        (Scheme.residueFieldCongr hy.symm).hom ≫ h.residueFieldMap y ≫ φ =
          CommRingCat.ofHom (algebraMap (B.residueField b) (AlgebraicClosure (B.residueField b))) := by
    intro B Y h b y hy t ht e
    subst e
    refine ⟨Scheme.descResidueField (Scheme.stalkClosedPointTo t), ?_, ?_⟩
    · exact (Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField _ Y t).symm
    · apply Spec.map_injective
      rw [← cancel_mono (B.fromSpecResidueField b)]
      rw [Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc,
        Scheme.residueFieldCongr_fromSpecResidueField,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← Category.assoc,
        Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField]
      exact ht
  intro Y V y hsep h t t₀ ht ht₀ hpt
  have hy : h (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) = y := by
    have h1 := congrArg (fun f : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Y =>
      f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) ht₀
    simp only [Scheme.Hom.comp_apply] at h1
    refine h1.trans ?_
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply y _
  obtain ⟨φ, hφ1, hφ2⟩ := factor Y V h y _ hy t ht hpt
  obtain ⟨ψ, hψ1, hψ2⟩ := factor Y V h y _ hy t₀ ht₀ rfl
  obtain ⟨σ, hσ1, hσ2⟩ := fieldext (Y.residueField y) _
    ((Scheme.residueFieldCongr hy.symm).hom ≫ h.residueFieldMap _).hom φ.hom ψ.hom
    (congrArg CommRingCat.Hom.hom ((Category.assoc _ _ _).trans hφ2))
    (congrArg CommRingCat.Hom.hom ((Category.assoc _ _ _).trans hψ2))

  haveI : IsPurelyInseparable (Y.residueField y) (AlgebraicClosure (Y.residueField y)) :=
    Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
  let σA : AlgebraicClosure (Y.residueField y) →ₐ[Y.residueField y]
      AlgebraicClosure (Y.residueField y) :=
    { σ with commutes' := fun r => congrArg (fun g => g r) hσ2 }
  have hσid : ∀ x, σ x = x := fun x =>
    DFunLike.congr_fun (Subsingleton.elim σA (AlgHom.id _ _)) x
  have hφψ : φ = ψ := by
    apply CommRingCat.hom_ext
    ext l
    rw [← hσ1, RingHom.comp_apply, hσid]
  rw [hφ1, hφψ]
  exact hψ1.symm

theorem wc_shdata_comparison_map : ∀ {Y Y' : Scheme.{u}} (p : Y' ⟶ Y) (y : Y) (y' : Y') (ι : Spec (.of (AlgebraicClosure (Y'.residueField y'))) ⟶ Spec (.of (AlgebraicClosure (Y.residueField y)))), ι ≫ wcEtGeomPt Y y = wcEtGeomPt Y' y' ≫ p → ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (e : IsLocalRing.ResidueField B →+* AlgebraicClosure (Y.residueField y)), Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ a = wcEtGeomPt Y y → ∀ (B' : Type u) [CommRing B'] [IsLocalRing B'] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y' y')) (Scheme.Etale.forget Y')) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ Y'), wcHalShData y' B' Λ' W'' φ' a' → ∀ (e' : IsLocalRing.ResidueField B' →+* AlgebraicClosure (Y'.residueField y')), (∀ l, Spec.map (CommRingCat.ofHom e') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) ≫ φ' l = (W''.obj l).hom.left) → ∃ β : Spec (.of B') ⟶ Spec (.of B), β ≫ a = a' ≫ p ∧ Spec.map (CommRingCat.ofHom e') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) ≫ β = ι ≫ Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) :=
by
  intro Y Y' p y y' ι hι B _ _ Λ _ _ W' φ a hd e he B' _ _ Λ' _ _ W'' φ' a' hd' e' hK'
  obtain ⟨-, -, hcomp, hφa, hlim, -⟩ := hd
  obtain ⟨hinit, -, -, hφa', -, -⟩ := hd'

  have hq'pt : ∀ x, (Spec.map (CommRingCat.ofHom e') ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B'))) x =
      IsLocalRing.closedPoint B' := by
    intro x
    rw [Scheme.Hom.comp_apply]
    exact IsLocalRing.PrimeSpectrum.comap_residue B' _

  have s0 : ∀ {P E S : Scheme.{u}} (ee : E ⟶ S) [Etale ee] (aa bb : P ⟶ E), aa ≫ ee = bb ≫ ee →
      ∀ (Ω : Type u) [Field Ω] (π : Spec (.of Ω) ⟶ P), π ≫ aa = π ≫ bb →
      ∃ U : P.Opens, π (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ aa = U.ι ≫ bb := by
    intro P E S ee _ aa bb hab Ω _ π hπ
    let c : P ⟶ Limits.pullback ee ee := Limits.pullback.lift aa bb hab
    have hcf : c ≫ Limits.pullback.fst ee ee = aa := Limits.pullback.lift_fst _ _ _
    have hcs : c ≫ Limits.pullback.snd ee ee = bb := Limits.pullback.lift_snd _ _ _
    have hkey : π ≫ c = (π ≫ aa) ≫ Limits.pullback.diagonal ee := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hπ]
    have hpt : ∀ w : Spec (.of Ω), c (π w) = Limits.pullback.diagonal ee (aa (π w)) := by
      intro w
      rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange, ?_, ?_⟩
    · show c (π (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal ee).opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨_, (hpt _).symm⟩
    · set U := c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange with hU
      have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal ee) := by
        rintro _ ⟨x, rfl⟩
        have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at hx0
        have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal ee).opensRange := hx0
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
        rw [Scheme.Hom.comp_apply]
        exact hx'
      obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal ee = U.ι ≫ c :=
        ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal ee) (U.ι ≫ c) hrange⟩
      have h1 : U.ι ≫ aa = t := by
        calc U.ι ≫ aa = (U.ι ≫ c) ≫ Limits.pullback.fst ee ee := by rw [Category.assoc, hcf]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.fst ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      have h2 : U.ι ≫ bb = t := by
        calc U.ι ≫ bb = (U.ι ≫ c) ≫ Limits.pullback.snd ee ee := by rw [Category.assoc, hcs]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.snd ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [h1, h2]

  have s1 : ∀ {Z V : Scheme.{u}} (h : V ⟶ Z) [Etale h] (g₁ g₂ : Spec (.of B') ⟶ V),
      g₁ ≫ h = g₂ ≫ h →
      (Spec.map (CommRingCat.ofHom e') ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B'))) ≫ g₁ =
      (Spec.map (CommRingCat.ofHom e') ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B'))) ≫ g₂ →
      g₁ = g₂ := by
    intro Z V h _ g₁ g₂ hh hq
    obtain ⟨U, hU, hUeq⟩ := s0 h g₁ g₂ hh _ _ hq
    have hU' : IsLocalRing.closedPoint B' ∈ U := by
      have hcp := hq'pt (IsLocalRing.closedPoint (AlgebraicClosure (Y'.residueField y')))
      rw [← hcp]
      exact hU
    have hsub : Set.range ⇑(𝟙 (Spec (.of B'))) ⊆ Set.range ⇑U.ι := by
      intro x _
      rw [Scheme.Opens.range_ι]
      exact (IsLocalRing.specializes_closedPoint (R := B') x).mem_open U.isOpen hU'
    have hk := IsOpenImmersion.lift_fac U.ι (𝟙 _) hsub
    calc g₁ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₁ := by
          rw [hk, Category.id_comp]
      _ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₂ := by
          simp only [Category.assoc, hUeq]
      _ = g₂ := by rw [hk, Category.id_comp]

  have hleg : ∀ l : Λ, ∃ z : Spec (.of B') ⟶ (W'.obj l).right.left,
      z ≫ (W'.obj l).right.hom = a' ≫ p ∧
      (Spec.map (CommRingCat.ofHom e') ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B'))) ≫ z =
        ι ≫ (Spec.map (CommRingCat.ofHom e) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≫ φ l := by
    intro l
    haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
    have ht : (ι ≫ (Spec.map (CommRingCat.ofHom e) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≫ φ l) ≫ (W'.obj l).right.hom =
        wcEtGeomPt Y' y' ≫ p := by
      simp only [Category.assoc]
      rw [hφa l, he]
      exact hι
    obtain ⟨pt, hpt1, hpt2⟩ : ∃ pt : Spec (.of (AlgebraicClosure (Y'.residueField y'))) ⟶
        Limits.pullback (W'.obj l).right.hom p,
        pt ≫ Limits.pullback.fst (W'.obj l).right.hom p = ι ≫ (Spec.map (CommRingCat.ofHom e) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≫ φ l ∧
        pt ≫ Limits.pullback.snd (W'.obj l).right.hom p = wcEtGeomPt Y' y' :=
      ⟨Limits.pullback.lift _ _ ht, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    let D : StructuredArrow (Over.mk (wcEtGeomPt Y' y')) (Scheme.Etale.forget Y') :=
      StructuredArrow.mk (Y := Scheme.Etale.mk (Limits.pullback.snd (W'.obj l).right.hom p))
        (Over.homMk pt hpt2)
    obtain ⟨l'', ⟨g⟩⟩ := ((Functor.initial_iff_of_isCofiltered W'').mp hinit).1 D
    obtain ⟨gl, F1, F2⟩ : ∃ gl : (W''.obj l'').right.left ⟶ Limits.pullback (W'.obj l).right.hom p,
        gl ≫ Limits.pullback.snd (W'.obj l).right.hom p = (W''.obj l'').right.hom ∧
        (W''.obj l'').hom.left ≫ gl = pt :=
      ⟨g.right.left, MorphismProperty.Over.w g.right,
        congrArg (fun f => f.left) (StructuredArrow.w g)⟩
    refine ⟨φ' l'' ≫ gl ≫ Limits.pullback.fst (W'.obj l).right.hom p, ?_, ?_⟩
    · calc (φ' l'' ≫ gl ≫ Limits.pullback.fst (W'.obj l).right.hom p) ≫
            (W'.obj l).right.hom
          = φ' l'' ≫ (gl ≫ Limits.pullback.snd (W'.obj l).right.hom p) ≫ p := by
            simp only [Category.assoc, Limits.pullback.condition, Limits.pullback.condition_assoc]
        _ = a' ≫ p := by rw [F1, ← Category.assoc, hφa' l'']
    · calc (Spec.map (CommRingCat.ofHom e') ≫
            Spec.map (CommRingCat.ofHom (IsLocalRing.residue B'))) ≫
            φ' l'' ≫ gl ≫ Limits.pullback.fst (W'.obj l).right.hom p
          = ((Spec.map (CommRingCat.ofHom e') ≫
              Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) ≫ φ' l'') ≫
              gl) ≫ Limits.pullback.fst (W'.obj l).right.hom p := by
            simp only [Category.assoc]
        _ = pt ≫ Limits.pullback.fst (W'.obj l).right.hom p := by
            rw [hK' l'']
            exact congrArg (fun k => k ≫ Limits.pullback.fst (W'.obj l).right.hom p) F2
        _ = _ := hpt1
  choose z hz₁ hz₂ using hleg

  have hzc : ∀ {l l₁ : Λ} (t : l ⟶ l₁), z l ≫ (W'.map t).right.left = z l₁ := by
    intro l l₁ t
    haveI : Etale (W'.obj l₁).right.hom := (W'.obj l₁).right.prop
    apply s1 (W'.obj l₁).right.hom
    · rw [Category.assoc, MorphismProperty.Over.w (W'.map t).right, hz₁, hz₁]
    · rw [← Category.assoc, hz₂, hz₂]
      simp only [Category.assoc, hcomp t]
  obtain ⟨β, hβ, -⟩ := hlim (Spec (.of B')) z hzc
  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
  refine ⟨β, ?_, ?_⟩
  · rw [← hφa l₀, ← Category.assoc, hβ l₀, hz₁ l₀]
  · have hu : ∀ {l l' : Λ} (t : l ⟶ l'), (ι ≫ (Spec.map (CommRingCat.ofHom e) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≫ φ l) ≫ (W'.map t).right.left =
        ι ≫ (Spec.map (CommRingCat.ofHom e) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≫ φ l' := by
      intro l l' t
      simp only [Category.assoc, hcomp t]
    have huniq := hlim (Spec (.of (AlgebraicClosure (Y'.residueField y')))) _ hu
    have key := huniq.unique
      (y₁ := (Spec.map (CommRingCat.ofHom e') ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B'))) ≫ β)
      (y₂ := ι ≫ Spec.map (CommRingCat.ofHom e) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))
      (fun l => by rw [Category.assoc, hβ l, hz₂ l])
      (fun l => by simp only [Category.assoc])
    simpa only [Category.assoc] using key

theorem wc_integral_over_strictly_henselian : ∀ (B C : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] [CommRing C] [IsLocalRing C] [Algebra B C], Algebra.IsIntegral B C → HenselianLocalRing C ∧ IsSepClosed (IsLocalRing.ResidueField C) :=
by
  intro B C _ _ _ _ _ _ hInt
  classical
  haveI := hInt

  have hloc : IsLocalHom (algebraMap B C) := by
    refine ⟨fun a ha => ?_⟩
    by_contra hna
    have hker : RingHom.ker (algebraMap B C) ≤ IsLocalRing.maximalIdeal B :=
      IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top _)
    obtain ⟨Q, hQ, hQu⟩ :=
      Ideal.exists_ideal_over_maximal_of_isIntegral (S := C) (IsLocalRing.maximalIdeal B) hker
    have hmem : a ∈ IsLocalRing.maximalIdeal B := (IsLocalRing.mem_maximalIdeal a).mpr hna
    rw [← hQu] at hmem
    have hQa : algebraMap B C a ∈ Q := hmem
    exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ hQa ha)
  haveI := hloc

  have hsep : IsSepClosed (IsLocalRing.ResidueField C) := by
    haveI : Algebra.IsAlgebraic (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField C) := by
      constructor
      intro z
      obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨f, hf, hfc⟩ := hInt.isIntegral c
      refine ⟨f.map (IsLocalRing.residue B), (hf.map _).ne_zero, ?_⟩
      have hcomp : (algebraMap (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField C)).comp
          (IsLocalRing.residue B) = (IsLocalRing.residue C).comp (algebraMap B C) := by
        ext b
        exact IsLocalRing.ResidueField.algebraMap_residue b
      rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp, ← Polynomial.hom_eval₂, hfc, map_zero]
    exact Algebra.IsAlgebraic.isSepClosed (F := IsLocalRing.ResidueField B)
  have hofId : ((Algebra.ofId B (IsLocalRing.ResidueField B) : B →ₐ[B] IsLocalRing.ResidueField B) :
      B →+* IsLocalRing.ResidueField B) = IsLocalRing.residue B := by
    ext x
    show Algebra.ofId B (IsLocalRing.ResidueField B) x = IsLocalRing.residue B x
    rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]

  have s3a : ∀ (S : Type u) [CommRing S] [Algebra B S], Algebra.IsStandardEtale B S →
      ∀ φ : S →ₐ[B] IsLocalRing.ResidueField B,
        ∃ τ : S →ₐ[B] B, (Algebra.ofId B (IsLocalRing.ResidueField B)).comp τ = φ := by
    intro S _ _ hS φ
    obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
    have hm := P.hasMap
    have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
      rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
    have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
      rw [Polynomial.aeval_algHom_apply]
      exact (hm.2.map φ).ne_zero
    have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
      obtain ⟨p₁, p₂, N, hc⟩ := P.cond
      have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
      rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
      intro h
      rw [h, zero_mul] at h1
      exact pow_ne_zero N hg0 h1.symm
    have key := (HenselianLocalRing.TFAE B).out 1 2
    obtain ⟨a, ha, hres⟩ := key.mp inferInstance P.f P.monic_f (φ P.x) hf0 hd0
    have hA : P.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
        exact ha
      · have key2 : (Algebra.ofId B (IsLocalRing.ResidueField B)) (Polynomial.aeval a P.g) =
            Polynomial.aeval (φ P.x) P.g := by
          rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
            IsLocalRing.ResidueField.algebraMap_eq, hres]
        rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
        exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
    refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
    have h1 : (Algebra.ofId B (IsLocalRing.ResidueField B)).comp (P.lift a hA) =
        φ.comp P.equivRing.symm.toAlgHom := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
        IsLocalRing.ResidueField.algebraMap_eq, hres]
      have hx : P.equivRing.symm P.X = P.x := (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
      show φ P.x = φ (P.equivRing.symm P.X)
      rw [hx]
    ext s
    have h2 := congrArg (fun F => F (P.equivRing s)) h1
    simpa using h2

  have s3 : ∀ (E : Type u) [CommRing E] [Algebra B E], Algebra.Etale B E →
      ∀ φ : E →ₐ[B] IsLocalRing.ResidueField B,
        ∃ τ : E →ₐ[B] B, (Algebra.ofId B (IsLocalRing.ResidueField B)).comp τ = φ := by
    intro E _ _ hE φ
    have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField B)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := B)
      (RingHom.ker (φ : E →+* IsLocalRing.ResidueField B))
    have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
    have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
    let φ' : Localization.Away s →ₐ[B] IsLocalRing.ResidueField B :=
      IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
    obtain ⟨τ', hτ'⟩ := s3a _ hst φ'
    refine ⟨τ'.comp (IsScalarTower.toAlgHom B E (Localization.Away s)), ?_⟩
    ext e
    have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
    simp only [AlgHom.comp_apply] at h1 ⊢
    rw [IsScalarTower.toAlgHom_apply, h1]
    simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]

  have Fac : ∀ (f : Polynomial B) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField B)), f.Monic →
      g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue B) = g₀ * h₀ →
      ∃ g h : Polynomial B, g.Monic ∧ h.Monic ∧ f = g * h ∧ IsCoprime g h ∧
        g.map (IsLocalRing.residue B) = g₀ ∧ h.map (IsLocalRing.residue B) = h₀ := by
    intro f g₀ h₀ hf hg hh hc hfac
    have hn : f.natDegree = g₀.natDegree + h₀.natDegree := by
      rw [← hg.natDegree_mul hh, ← hfac, hf.natDegree_map]
    let p : Polynomial.MonicDegreeEq B f.natDegree := Polynomial.MonicDegreeEq.mk f hf rfl
    let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField B) g₀.natDegree :=
      Polynomial.MonicDegreeEq.mk g₀ hg rfl
    let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField B) h₀.natDegree :=
      Polynomial.MonicDegreeEq.mk h₀ hh rfl
    have hq : (G₀ : Polynomial (IsLocalRing.ResidueField B)) * (H₀ : Polynomial _) =
        Polynomial.map (algebraMap B (IsLocalRing.ResidueField B)) (p : Polynomial B) ∧
        IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField B)) (H₀ : Polynomial _) := by
      refine ⟨?_, hc⟩
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact hfac.symm
    obtain ⟨τ, hτ⟩ := s3 _ inferInstance
      ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField B)
        _ _ hn p).symm ⟨(G₀, H₀), hq⟩)
    have nat : ∀ (ψ : B →ₐ[B] IsLocalRing.ResidueField B),
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField B)
          _ _ hn p (ψ.comp τ)).1.1 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).1.1 :
          Polynomial.MonicDegreeEq B _) : Polynomial B).map (ψ : B →+* IsLocalRing.ResidueField B) ∧
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField B)
          _ _ hn p (ψ.comp τ)).1.2 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).1.2 :
          Polynomial.MonicDegreeEq B _) : Polynomial B).map (ψ : B →+* IsLocalRing.ResidueField B) := by
      intro ψ
      constructor
      · show (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom B
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField B)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom B
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* B)) :
              Polynomial.MonicDegreeEq B _) : Polynomial B).map
                (ψ : B →+* IsLocalRing.ResidueField B)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
      · show (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom B
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField B)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom B
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* B)) :
              Polynomial.MonicDegreeEq B _) : Polynomial B).map
                (ψ : B →+* IsLocalRing.ResidueField B)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
    obtain ⟨nat1, nat2⟩ := nat (Algebra.ofId B (IsLocalRing.ResidueField B))
    have hφ : Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField B)
        _ _ hn p ((Algebra.ofId B (IsLocalRing.ResidueField B)).comp τ) = ⟨(G₀, H₀), hq⟩ := by
      rw [hτ]
      exact Equiv.apply_symm_apply _ _
    rw [hφ, hofId] at nat1 nat2
    refine ⟨_, _, (Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).1.1.monic,
      (Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).1.2.monic, ?_,
      (Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).2.2,
      nat1.symm, nat2.symm⟩
    rw [(Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).2.1,
      Algebra.algebraMap_self, Polynomial.map_id]
    rfl

  have hs5 : ∀ (D : Type u) [CommRing D] [Algebra B D], Algebra.IsIntegral B D →
      ∀ (J : Ideal D), (∀ b ∈ IsLocalRing.maximalIdeal B, algebraMap B D b ∈ J) →
      ∀ d : D, d * d - d ∈ J → ∃ e : D, e * e = e ∧ e - d ∈ J := by
    intro D _ _ hIntD J hJ d hd
    obtain ⟨F, hF, hFd⟩ := hIntD.isIntegral d
    obtain ⟨F₁, hF₁⟩ : ∃ F₁ : Polynomial B,
        F₁ = Polynomial.X * (Polynomial.X - Polynomial.C 1) * F := ⟨_, rfl⟩
    have hF₁m : F₁.Monic := by
      rw [hF₁]; exact (Polynomial.monic_X.mul (Polynomial.monic_X_sub_C 1)).mul hF
    have hF₁d : Polynomial.aeval d F₁ = 0 := by
      rw [hF₁, map_mul, Polynomial.aeval_def d F, hFd, mul_zero]
    obtain ⟨b, H₀, hsplit, hnd⟩ : ∃ (b : ℕ) (H₀ : Polynomial (IsLocalRing.ResidueField B)),
        F₁.map (IsLocalRing.residue B) = (Polynomial.X - Polynomial.C 1) ^ b * H₀ ∧
          ¬ (Polynomial.X - Polynomial.C 1) ∣ H₀ :=
      ⟨_, Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd _ (hF₁m.map _).ne_zero 1⟩
    have hG₀ : ((Polynomial.X - Polynomial.C 1 : Polynomial (IsLocalRing.ResidueField B)) ^ b).Monic :=
      (Polynomial.monic_X_sub_C 1).pow b
    have hH₀ : H₀.Monic := hG₀.of_mul_monic_left (hsplit ▸ hF₁m.map _)
    have hcop : IsCoprime ((Polynomial.X - Polynomial.C 1 :
        Polynomial (IsLocalRing.ResidueField B)) ^ b) H₀ :=
      ((Irreducible.coprime_iff_not_dvd (Polynomial.irreducible_X_sub_C 1)).mpr hnd).pow_left
    have hFbar : F₁.map (IsLocalRing.residue B) = Polynomial.X * (Polynomial.X - Polynomial.C 1) *
        F.map (IsLocalRing.residue B) := by
      rw [hF₁, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X,
        Polynomial.map_C, map_one]
    have hb : b ≠ 0 := by
      intro hb0
      apply hnd
      rw [hb0, pow_zero, one_mul] at hsplit
      rw [← hsplit, hFbar]
      exact ⟨Polynomial.X * F.map (IsLocalRing.residue B), by ring⟩
    have hH0 : H₀.eval 0 = 0 := by
      have h1 : (F₁.map (IsLocalRing.residue B)).eval 0 = 0 := by
        rw [hFbar, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_X, zero_mul, zero_mul]
      rw [hsplit, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_sub, Polynomial.eval_X,
        Polynomial.eval_C] at h1
      have hu : IsUnit (((0 : IsLocalRing.ResidueField B) - 1) ^ b) := by
        rw [zero_sub]; exact (isUnit_one.neg).pow b
      exact hu.mul_right_eq_zero.mp h1
    obtain ⟨G, H, hGm, hHm, hGH, hGHc, hGr, hHr⟩ := Fac F₁ _ H₀ hF₁m hG₀ hH₀ hcop hsplit
    obtain ⟨U, V, hUV⟩ := hGHc
    have hG1 : G.eval 1 ∈ IsLocalRing.maximalIdeal B := by
      rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.eval_one_map, hGr, Polynomial.eval_pow,
        Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self, zero_pow hb]
    have hH0' : H.eval 0 ∈ IsLocalRing.maximalIdeal B := by
      rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.eval_zero_map, hHr, hH0]
    refine ⟨Polynomial.aeval d (V * H), ?_, ?_⟩
    · have h1 : Polynomial.aeval d (U * G) + Polynomial.aeval d (V * H) = 1 := by
        rw [← map_add, hUV, map_one]
      have h2 : Polynomial.aeval d (U * G) * Polynomial.aeval d (V * H) = 0 := by
        have : U * G * (V * H) = U * V * F₁ := by rw [hGH]; ring
        rw [← map_mul, this, map_mul, hF₁d, mul_zero]
      have h3 : Polynomial.aeval d (U * G) = 1 - Polynomial.aeval d (V * H) := by
        rw [← h1]; ring
      rw [h3] at h2
      linear_combination -h2
    · rw [← Ideal.Quotient.eq]
      have ht : Ideal.Quotient.mk J d * Ideal.Quotient.mk J d = Ideal.Quotient.mk J d := by
        rw [← map_mul]; exact Ideal.Quotient.eq.mpr hd
      have hpow : ∀ n : ℕ, Ideal.Quotient.mk J d ^ (n + 1) = Ideal.Quotient.mk J d := by
        intro n
        induction n with
        | zero => rw [zero_add, pow_one]
        | succ n ih => rw [pow_succ, ih, ht]
      have hcol : ∀ P : Polynomial B, Ideal.Quotient.mk J (Polynomial.aeval d P) =
          Ideal.Quotient.mk J (algebraMap B D (P.eval 0)) * (1 - Ideal.Quotient.mk J d) +
          Ideal.Quotient.mk J (algebraMap B D (P.eval 1)) * Ideal.Quotient.mk J d := by
        intro P
        induction P using Polynomial.induction_on' with
        | add p q hp hq =>
          rw [map_add, map_add, hp, hq, Polynomial.eval_add, Polynomial.eval_add, map_add, map_add,
            map_add, map_add]
          ring
        | monomial n c =>
          rw [Polynomial.aeval_monomial, Polynomial.eval_monomial, Polynomial.eval_monomial]
          cases n with
          | zero =>
            simp only [pow_zero, mul_one]
            ring
          | succ n =>
            rw [map_mul, map_pow, hpow, zero_pow (Nat.succ_ne_zero n), one_pow, mul_zero, mul_one,
              map_zero, map_zero, zero_mul, zero_add]
      rw [hcol (V * H)]
      have h0 : Ideal.Quotient.mk J (algebraMap B D ((V * H).eval 0)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (hJ _ (by
          rw [Polynomial.eval_mul]; exact Ideal.mul_mem_left _ _ hH0'))
      have h1e : (V * H).eval 1 = 1 - U.eval 1 * G.eval 1 := by
        have := congrArg (Polynomial.eval 1) hUV
        rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_one] at this
        rw [Polynomial.eval_mul]
        linear_combination this
      have h1 : Ideal.Quotient.mk J (algebraMap B D ((V * H).eval 1)) = 1 := by
        rw [h1e, map_sub, map_one, map_sub, map_one,
          Ideal.Quotient.eq_zero_iff_mem.mpr (hJ _ (Ideal.mul_mem_left _ _ hG1)), sub_zero]
      rw [h0, h1]
      ring

  have hD : ∀ g : Polynomial C, g.Monic → g.coeff 0 ∈ IsLocalRing.maximalIdeal C →
      IsUnit (g.coeff 1) → ∃ a ∈ IsLocalRing.maximalIdeal C, g.IsRoot a := by
    intro g hg h0 hu
    have hn : 0 < g.natDegree := by
      rcases Nat.eq_zero_or_pos g.natDegree with h | h
      · exfalso
        have h1 := Polynomial.eq_one_of_monic_natDegree_zero hg h
        rw [h1] at hu
        simp [Polynomial.coeff_one] at hu
      · exact h
    obtain ⟨v, hv⟩ : ∃ v, v * g.coeff 1 = 1 := ⟨↑hu.unit⁻¹, hu.val_inv_mul⟩
    have hvu : IsUnit v := ⟨⟨v, g.coeff 1, hv, by rw [mul_comm]; exact hv⟩, rfl⟩
    haveI : Module.Finite C (AdjoinRoot g) := (AdjoinRoot.powerBasis' hg).finite
    haveI : Algebra.IsIntegral C (AdjoinRoot g) := Algebra.IsIntegral.of_finite C (AdjoinRoot g)
    haveI : Algebra.IsIntegral B (AdjoinRoot g) := Algebra.IsIntegral.trans C
    obtain ⟨J, hJdef⟩ : ∃ J : Ideal (AdjoinRoot g),
        J = Ideal.map (algebraMap C (AdjoinRoot g)) (IsLocalRing.maximalIdeal C) := ⟨_, rfl⟩
    have hιJ : ∀ c ∈ IsLocalRing.maximalIdeal C, algebraMap C (AdjoinRoot g) c ∈ J := by
      intro c hc; rw [hJdef]; exact Ideal.mem_map_of_mem _ hc

    have hlin : ∀ l : AdjoinRoot g →ₗ[C] C, ∀ y ∈ J, l y ∈ IsLocalRing.maximalIdeal C := by
      intro l y hy
      have hy' : y ∈ (IsLocalRing.maximalIdeal C) • (⊤ : Submodule C (AdjoinRoot g)) := by
        rw [Ideal.smul_top_eq_map, ← hJdef]; exact hy
      refine Submodule.smul_induction_on hy' ?_ ?_
      · intro r hr n _
        rw [map_smul, smul_eq_mul]
        exact Ideal.mul_mem_right _ _ hr
      · intro x y hx hy
        rw [map_add]; exact add_mem hx hy
    obtain ⟨d, hd⟩ : ∃ d : AdjoinRoot g,
        d = algebraMap C (AdjoinRoot g) v * AdjoinRoot.mk g g.divX := ⟨_, rfl⟩

    have hi : AdjoinRoot.mk g g.divX * AdjoinRoot.root g =
        -algebraMap C (AdjoinRoot g) (g.coeff 0) := by
      have := congrArg (AdjoinRoot.mk g) (Polynomial.divX_mul_X_add g)
      rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C, AdjoinRoot.mk_self] at this
      rw [AdjoinRoot.algebraMap_eq]
      linear_combination this
    have hii : AdjoinRoot.mk g g.divX = AdjoinRoot.mk g g.divX.divX * AdjoinRoot.root g +
        algebraMap C (AdjoinRoot g) (g.coeff 1) := by
      have := congrArg (AdjoinRoot.mk g) (Polynomial.divX_mul_X_add g.divX)
      rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C, Polynomial.coeff_divX, zero_add] at this
      rw [AdjoinRoot.algebraMap_eq]
      exact this.symm
    have hxd : AdjoinRoot.root g * d ∈ J := by
      have : AdjoinRoot.root g * d = -algebraMap C (AdjoinRoot g) (v * g.coeff 0) := by
        rw [hd, map_mul]
        linear_combination (algebraMap C (AdjoinRoot g) v) * hi
      rw [this]
      exact J.neg_mem (hιJ _ (Ideal.mul_mem_left _ _ h0))
    have hdd : d * d - d ∈ J := by
      have hvu' : algebraMap C (AdjoinRoot g) v * algebraMap C (AdjoinRoot g) (g.coeff 1) = 1 := by
        rw [← map_mul, hv, map_one]
      have hd1 : d - 1 = algebraMap C (AdjoinRoot g) v * AdjoinRoot.mk g g.divX.divX *
          AdjoinRoot.root g := by
        rw [hd, hii]
        linear_combination hvu'
      have : d * d - d = (AdjoinRoot.root g * d) *
          (algebraMap C (AdjoinRoot g) v * AdjoinRoot.mk g g.divX.divX) := by
        linear_combination d * hd1
      rw [this]
      exact J.mul_mem_right _ hxd
    have hJB : ∀ b ∈ IsLocalRing.maximalIdeal B, algebraMap B (AdjoinRoot g) b ∈ J := by
      intro b hb
      rw [IsScalarTower.algebraMap_apply B C (AdjoinRoot g)]
      apply hιJ
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu'
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hb
      exact hb (isUnit_of_map_unit _ _ hu')
    obtain ⟨e, he, hed⟩ := hs5 (AdjoinRoot g) inferInstance J hJB d hdd

    obtain ⟨l, hl⟩ : ∃ l : AdjoinRoot g →ₗ[C] C,
        l = (Polynomial.lcoeff C (g.natDegree - 1)).comp (AdjoinRoot.modByMonicHom hg) := ⟨_, rfl⟩
    have hlq : l (AdjoinRoot.mk g g.divX) = 1 := by
      rw [hl, LinearMap.comp_apply, AdjoinRoot.modByMonicHom_mk, Polynomial.lcoeff_apply]
      have hdeg : g.divX.degree < g.degree := by
        apply Polynomial.degree_lt_degree
        rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one]
        omega
      rw [(Polynomial.modByMonic_eq_self_iff hg).mpr hdeg, Polynomial.coeff_divX,
        Nat.sub_add_cancel hn, hg.coeff_natDegree]
    have hsm : ∀ (c : C) (y : AdjoinRoot g), l (algebraMap C (AdjoinRoot g) c * y) = c * l y := by
      intro c y
      rw [← Algebra.smul_def, map_smul, smul_eq_mul]
    have hld : l d = v := by rw [hd, hsm, hlq, mul_one]
    have hle : l e ∉ IsLocalRing.maximalIdeal C := by
      intro hmem
      have h1 : l (e - d) ∈ IsLocalRing.maximalIdeal C := hlin l _ hed
      rw [map_sub, hld] at h1
      have h2 := Ideal.sub_mem _ hmem h1
      rw [sub_sub_cancel] at h2
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h2
      exact h2 hvu
    have hleU : IsUnit (l e) := by
      by_contra h
      apply hle
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact h
    have hxe : AdjoinRoot.root g * e ∈ J := by
      have : AdjoinRoot.root g * e = AdjoinRoot.root g * d + AdjoinRoot.root g * (e - d) := by ring
      rw [this]
      exact J.add_mem hxd (J.mul_mem_left _ hed)

    have hnak : ∃ a : C, algebraMap C (AdjoinRoot g) a * e = AdjoinRoot.root g * e := by
      have hfg : (LinearMap.range (LinearMap.mulRight C e)).FG := by
        rw [LinearMap.range_eq_map]; exact Module.Finite.fg_top.map _
      have hjac := IsLocalRing.maximalIdeal_le_jacobson (R := C) ⊥
      have hstar : ∀ w ∈ J, w * e ∈ IsLocalRing.maximalIdeal C •
          LinearMap.range (LinearMap.mulRight C e) := by
        intro w hw
        have hw' : w ∈ (IsLocalRing.maximalIdeal C) • (⊤ : Submodule C (AdjoinRoot g)) := by
          rw [Ideal.smul_top_eq_map, ← hJdef]; exact hw
        refine Submodule.smul_induction_on hw' ?_ ?_
        · intro r hr n _
          rw [smul_mul_assoc]
          exact Submodule.smul_mem_smul hr (LinearMap.mem_range.mpr ⟨n, rfl⟩)
        · intro x y hx hy
          rw [add_mul]; exact add_mem hx hy
      have hle' : LinearMap.range (LinearMap.mulRight C e) ≤
          (C ∙ e) ⊔ IsLocalRing.maximalIdeal C • LinearMap.range (LinearMap.mulRight C e) := by
        intro z hz
        obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hz
        obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective y
        rw [LinearMap.mulRight_apply, ← AdjoinRoot.aeval_eq]
        have hP : Polynomial.aeval (AdjoinRoot.root g) P =
            Polynomial.aeval (AdjoinRoot.root g) P.divX * AdjoinRoot.root g +
              algebraMap C (AdjoinRoot g) (P.coeff 0) := by
          conv_lhs => rw [← Polynomial.divX_mul_X_add P]
          rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
        have hw : Polynomial.aeval (AdjoinRoot.root g) P.divX * (AdjoinRoot.root g * e) ∈ J :=
          J.mul_mem_left _ hxe
        have heq : Polynomial.aeval (AdjoinRoot.root g) P * e = P.coeff 0 • e +
            (Polynomial.aeval (AdjoinRoot.root g) P.divX * (AdjoinRoot.root g * e)) * e := by
          rw [hP, Algebra.smul_def]
          linear_combination (-(Polynomial.aeval (AdjoinRoot.root g) P.divX * AdjoinRoot.root g)) * he
        rw [heq]
        exact Submodule.add_mem_sup (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self e))
          (hstar _ hw)
      have hN := Submodule.le_of_le_smul_of_le_jacobson_bot hfg hjac hle'
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp
        (hN (LinearMap.mem_range.mpr ⟨AdjoinRoot.root g, rfl⟩))
      refine ⟨a, ?_⟩
      rw [← Algebra.smul_def, ha, LinearMap.mulRight_apply]
    obtain ⟨a, ha⟩ := hnak

    have hpow : ∀ n : ℕ, algebraMap C (AdjoinRoot g) a ^ n * e = AdjoinRoot.root g ^ n * e := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        calc algebraMap C (AdjoinRoot g) a ^ (n + 1) * e
            = algebraMap C (AdjoinRoot g) a * (algebraMap C (AdjoinRoot g) a ^ n * e) := by ring
          _ = algebraMap C (AdjoinRoot g) a * (AdjoinRoot.root g ^ n * e) := by rw [ih]
          _ = AdjoinRoot.root g ^ n * (algebraMap C (AdjoinRoot g) a * e) := by ring
          _ = AdjoinRoot.root g ^ n * (AdjoinRoot.root g * e) := by rw [ha]
          _ = AdjoinRoot.root g ^ (n + 1) * e := by ring
    have h6c : ∀ P : Polynomial C, algebraMap C (AdjoinRoot g) (P.eval a) * e =
        Polynomial.aeval (AdjoinRoot.root g) P * e := by
      intro P
      induction P using Polynomial.induction_on' with
      | add p q hp hq => rw [Polynomial.eval_add, map_add, add_mul, hp, hq, map_add, add_mul]
      | monomial n c =>
        rw [Polynomial.eval_monomial, Polynomial.aeval_monomial, map_mul, map_pow, mul_assoc, hpow,
          mul_assoc]
    have hg0 := h6c g
    rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self, zero_mul] at hg0
    have hl0 := congrArg l hg0
    rw [hsm, map_zero] at hl0
    have hga : g.eval a = 0 := hleU.mul_left_eq_zero.mp hl0
    have hae : l (algebraMap C (AdjoinRoot g) a * e) ∈ IsLocalRing.maximalIdeal C := by
      apply hlin; rw [ha]; exact hxe
    rw [hsm] at hae
    rcases (IsLocalRing.maximalIdeal.isMaximal C).isPrime.mem_or_mem hae with h | h
    · exact ⟨a, h, hga⟩
    · exact absurd h hle

  refine ⟨HenselianLocalRing.mk (fun f hf a₀ h₀ hu => ?_), hsep⟩
  have hc0 : (f.comp (Polynomial.X + Polynomial.C a₀)).coeff 0 ∈ IsLocalRing.maximalIdeal C := by
    rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_comp, Polynomial.eval_add,
      Polynomial.eval_X, Polynomial.eval_C, zero_add]
    exact h₀
  have hc1 : IsUnit ((f.comp (Polynomial.X + Polynomial.C a₀)).coeff 1) := by
    have h1 := Polynomial.coeff_derivative (f.comp (Polynomial.X + Polynomial.C a₀)) 0
    rw [Polynomial.derivative_comp, Polynomial.derivative_X_add_C, one_mul,
      Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_comp, Polynomial.eval_add,
      Polynomial.eval_X, Polynomial.eval_C, zero_add] at h1
    simp only [Nat.cast_zero, zero_add, mul_one] at h1
    rw [← h1]
    exact hu
  obtain ⟨a, ha, hroot⟩ := hD (f.comp (Polynomial.X + Polynomial.C a₀)) (hf.comp_X_add_C a₀) hc0 hc1
  refine ⟨a + a₀, ?_, by rwa [add_sub_cancel_right]⟩
  have h2 : (f.comp (Polynomial.X + Polynomial.C a₀)).eval a = f.eval (a + a₀) := by
    rw [Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C]
  show f.eval (a + a₀) = 0
  rw [← h2]
  exact hroot

theorem wc_shdata_lift_from_strictly_local : ∀ {Y : Scheme.{u}} (y : Y), IsSepClosed (Y.residueField y) → ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (R : Type u) [CommRing R] [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)] (c : Spec (.of R) ⟶ Y) (q : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Spec (.of R)), q (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) = IsLocalRing.closedPoint R → q ≫ c = wcEtGeomPt Y y → ∃ δ : Spec (.of R) ⟶ Spec (.of B), δ ≫ a = c ∧ ∀ l, q ≫ δ ≫ φ l = (W'.obj l).hom.left :=
by
  intro Y y hsep B _ _ Λ _ _ W' φ a hd R _ _ _ c q hq hqc
  classical
  obtain ⟨-, -, hcomp, hφa, hlim, -⟩ := hd

  have s0 : ∀ {P E S : Scheme.{u}} (ee : E ⟶ S) [Etale ee] (aa bb : P ⟶ E), aa ≫ ee = bb ≫ ee →
      ∀ (Ω : Type u) [Field Ω] (pp : Spec (.of Ω) ⟶ P), pp ≫ aa = pp ≫ bb →
      ∃ U : P.Opens, pp (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ aa = U.ι ≫ bb := by
    intro P E S ee _ aa bb hab Ω _ pp hπ
    let c : P ⟶ Limits.pullback ee ee := Limits.pullback.lift aa bb hab
    have hcf : c ≫ Limits.pullback.fst ee ee = aa := Limits.pullback.lift_fst _ _ _
    have hcs : c ≫ Limits.pullback.snd ee ee = bb := Limits.pullback.lift_snd _ _ _
    have hkey : pp ≫ c = (pp ≫ aa) ≫ Limits.pullback.diagonal ee := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hπ]
    have hpt : ∀ w : Spec (.of Ω), c (pp w) = Limits.pullback.diagonal ee (aa (pp w)) := by
      intro w
      rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange, ?_, ?_⟩
    · show c (pp (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal ee).opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨_, (hpt _).symm⟩
    · set U := c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange with hU
      have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal ee) := by
        rintro _ ⟨x, rfl⟩
        have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at hx0
        have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal ee).opensRange := hx0
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
        rw [Scheme.Hom.comp_apply]
        exact hx'
      obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal ee = U.ι ≫ c :=
        ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal ee) (U.ι ≫ c) hrange⟩
      have h1 : U.ι ≫ aa = t := by
        calc U.ι ≫ aa = (U.ι ≫ c) ≫ Limits.pullback.fst ee ee := by rw [Category.assoc, hcf]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.fst ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      have h2 : U.ι ≫ bb = t := by
        calc U.ι ≫ bb = (U.ι ≫ c) ≫ Limits.pullback.snd ee ee := by rw [Category.assoc, hcs]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.snd ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [h1, h2]

  have geomlift : ∀ {Y V : Scheme.{u}} (y : Y), IsSepClosed (Y.residueField y) → ∀ (h : V ⟶ Y) (t t₀ : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ V), t ≫ h = wcEtGeomPt Y y → t₀ ≫ h = wcEtGeomPt Y y → t (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) = t₀ (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) → t = t₀ := by
    have fieldext : ∀ (k L : Type u) [Field k] [Field L] (r : k →+* L)
        (φ ψ : L →+* AlgebraicClosure k),
        φ.comp r = algebraMap k (AlgebraicClosure k) →
        ψ.comp r = algebraMap k (AlgebraicClosure k) →
        ∃ σ : AlgebraicClosure k →+* AlgebraicClosure k, σ.comp ψ = φ ∧
          σ.comp (algebraMap k (AlgebraicClosure k)) = algebraMap k (AlgebraicClosure k) := by
      intro k L _ _ r φ ψ hφ hψ
      have hAlg : @Algebra.IsAlgebraic L (AlgebraicClosure k) _ _ ψ.toAlgebra := by
        letI : Algebra L (AlgebraicClosure k) := ψ.toAlgebra
        refine ⟨fun x => ?_⟩
        obtain ⟨p, hp0, hpx⟩ := Algebra.IsAlgebraic.isAlgebraic (R := k) x
        refine ⟨p.map r, (Polynomial.map_ne_zero_iff r.injective).mpr hp0, ?_⟩
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        rw [Polynomial.aeval_def] at hpx
        change Polynomial.eval₂ (ψ.comp r) x p = 0
        rw [hψ]
        exact hpx
      obtain ⟨σ, hσ⟩ : ∃ σ : AlgebraicClosure k →+* AlgebraicClosure k, ∀ l, σ (ψ l) = φ l := by
        let σ₀ := @IsAlgClosed.lift (AlgebraicClosure k) _ _ L _ _ (AlgebraicClosure k) _ _
          ψ.toAlgebra φ.toAlgebra _ _ hAlg
        exact ⟨@AlgHom.toRingHom L _ _ _ _ _ ψ.toAlgebra φ.toAlgebra σ₀,
          fun l => @AlgHom.commutes L _ _ _ _ _ ψ.toAlgebra φ.toAlgebra σ₀ l⟩
      have h1 : σ.comp ψ = φ := by
        ext l
        exact hσ l
      refine ⟨σ, h1, ?_⟩
      conv_lhs => rw [← hψ]
      rw [← RingHom.comp_assoc, h1, hφ]
    have factor : ∀ (B Y : Scheme.{u}) (h : Y ⟶ B) (b : B) (y : Y) (hy : h y = b)
        (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ Y),
        t ≫ h = wcEtGeomPt B b →
        t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = y →
        ∃ φ : Y.residueField y ⟶ CommRingCat.of (AlgebraicClosure (B.residueField b)),
          t = Spec.map φ ≫ Y.fromSpecResidueField y ∧
          (Scheme.residueFieldCongr hy.symm).hom ≫ h.residueFieldMap y ≫ φ =
            CommRingCat.ofHom (algebraMap (B.residueField b) (AlgebraicClosure (B.residueField b))) := by
      intro B Y h b y hy t ht e
      subst e
      refine ⟨Scheme.descResidueField (Scheme.stalkClosedPointTo t), ?_, ?_⟩
      · exact (Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField _ Y t).symm
      · apply Spec.map_injective
        rw [← cancel_mono (B.fromSpecResidueField b)]
        rw [Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc,
          Scheme.residueFieldCongr_fromSpecResidueField,
          Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← Category.assoc,
          Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField]
        exact ht
    intro Y V y hsep h t t₀ ht ht₀ hpt
    have hy : h (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) = y := by
      have h1 := congrArg (fun f : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Y =>
        f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) ht₀
      simp only [Scheme.Hom.comp_apply] at h1
      refine h1.trans ?_
      simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply y _
    obtain ⟨φ, hφ1, hφ2⟩ := factor Y V h y _ hy t ht hpt
    obtain ⟨ψ, hψ1, hψ2⟩ := factor Y V h y _ hy t₀ ht₀ rfl
    obtain ⟨σ, hσ1, hσ2⟩ := fieldext (Y.residueField y) _
      ((Scheme.residueFieldCongr hy.symm).hom ≫ h.residueFieldMap _).hom φ.hom ψ.hom
      (congrArg CommRingCat.Hom.hom ((Category.assoc _ _ _).trans hφ2))
      (congrArg CommRingCat.Hom.hom ((Category.assoc _ _ _).trans hψ2))
    haveI : IsPurelyInseparable (Y.residueField y) (AlgebraicClosure (Y.residueField y)) :=
      Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
    let σA : AlgebraicClosure (Y.residueField y) →ₐ[Y.residueField y]
        AlgebraicClosure (Y.residueField y) :=
      { σ with commutes' := fun r => congrArg (fun g => g r) hσ2 }
    have hσid : ∀ x, σ x = x := fun x =>
      DFunLike.congr_fun (Subsingleton.elim σA (AlgHom.id _ _)) x
    have hφψ : φ = ψ := by
      apply CommRingCat.hom_ext
      ext l
      rw [← hσ1, RingHom.comp_apply, hσid]
    rw [hφ1, hφψ]
    exact hψ1.symm

  have hetale : ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra.Etale R E]
      (σ : E →ₐ[R] IsLocalRing.ResidueField R), ∃ τ : E →ₐ[R] R,
        ∀ x : E, IsLocalRing.residue R (τ x) = σ x := by
    intro E _ _ _ σ
    haveI hq : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
    haveI : Algebra.FormallyEtale E (Localization.AtPrime (RingHom.ker σ)) :=
      Algebra.FormallyEtale.of_isLocalization (RingHom.ker σ).primeCompl
    haveI : Algebra.IsEtaleAt R (RingHom.ker σ) :=
      Algebra.FormallyEtale.comp R E (Localization.AtPrime (RingHom.ker σ))
    obtain ⟨g, hg, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) (RingHom.ker σ)
    have hσg : IsUnit (σ g) := isUnit_iff_ne_zero.mpr (fun h => hg (RingHom.mem_ker.mpr h))
    let σg : Localization.Away g →ₐ[R] IsLocalRing.ResidueField R :=
      IsLocalization.Away.liftAlgHom g hσg
    have hσg_apply : ∀ y : E, σg (algebraMap E (Localization.Away g) y) = σ y := by
      intro y
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    obtain ⟨Q⟩ := hstd.nonempty_standardEtalePresentation
    let e : Q.Ring ≃ₐ[R] Localization.Away g :=
      AlgEquiv.ofBijective (Q.lift Q.x Q.hasMap) Q.lift_bijective
    have heX : e Q.X = Q.x := by
      rw [AlgEquiv.ofBijective_apply]
      exact Q.lift_X _ _
    set a₀ := σg Q.x with ha₀
    have hf0 : Polynomial.aeval a₀ Q.f = 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply, Q.hasMap.1, map_zero]
    have hf' : Polynomial.aeval a₀ (Polynomial.derivative Q.f) ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact ((StandardEtalePair.HasMap.isUnit_derivative_f Q.P Q.hasMap).map σg).ne_zero
    have hg0 : Polynomial.aeval a₀ Q.g ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact (Q.hasMap.2.map σg).ne_zero
    have hHen := ((HenselianLocalRing.TFAE R).out 1 2).mp (inferInstance : HenselianLocalRing R)
    obtain ⟨a, hroot, hres⟩ := hHen Q.f Q.monic_f a₀ hf0 hf'
    have hres' : ∀ p : Polynomial R,
        IsLocalRing.residue R (Polynomial.aeval a p) = Polynomial.aeval a₀ p := by
      intro p
      rw [← hres, ← IsLocalRing.ResidueField.algebraMap_eq, ← Algebra.ofId_apply,
        ← Algebra.ofId_apply, ← Polynomial.aeval_algHom_apply]
    have hHas : Q.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]
        exact hroot
      · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres']
        exact hg0
    have hcomp : (Algebra.ofId R (IsLocalRing.ResidueField R)).comp (Q.lift a hHas) =
        σg.comp (e : Q.Ring →ₐ[R] Localization.Away g) := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, Q.lift_X, AlgEquiv.coe_toAlgHom, heX,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq, hres]
    refine ⟨((Q.lift a hHas).comp (e.symm : Localization.Away g →ₐ[R] Q.Ring)).comp
      (IsScalarTower.toAlgHom R E (Localization.Away g)), fun y => ?_⟩
    have h1 := congrArg (fun φ => φ (e.symm (algebraMap E (Localization.Away g) y))) hcomp
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
      Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
    rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
      AlgEquiv.coe_toAlgHom, h1, hσg_apply]

  have hres : ∀ (S : Type u) [CommRing S] [Algebra R S], Algebra.Etale R S →
      ∀ (P : Ideal S) [P.IsPrime], P.comap (algebraMap R S) = IsLocalRing.maximalIdeal R →
      ∃ φ₀ : S →ₐ[R] IsLocalRing.ResidueField R, ∀ x, φ₀ x = 0 ↔ x ∈ P := by
    intro S _ _ hE P _ hP
    have hker : RingHom.ker (algebraMap R P.ResidueField) = IsLocalRing.maximalIdeal R := by
      rw [IsScalarTower.algebraMap_eq R S P.ResidueField, ← RingHom.comap_ker,
        Ideal.ker_algebraMap_residueField, hP]
    have : IsLocalHom (algebraMap R P.ResidueField) := by
      constructor
      intro a ha
      by_contra hna
      have hm : a ∈ IsLocalRing.maximalIdeal R := hna
      rw [← hker, RingHom.mem_ker] at hm
      exact ha.ne_zero hm
    let j : IsLocalRing.ResidueField R →+* P.ResidueField :=
      IsLocalRing.ResidueField.lift (algebraMap R P.ResidueField)
    letI : Algebra (IsLocalRing.ResidueField R) P.ResidueField := j.toAlgebra
    have : IsScalarTower R (IsLocalRing.ResidueField R) P.ResidueField :=
      IsScalarTower.of_algebraMap_eq (fun r => by
        rw [RingHom.algebraMap_toAlgebra, IsLocalRing.ResidueField.algebraMap_eq,
          IsLocalRing.ResidueField.lift_residue_apply])
    have : Algebra.FormallyUnramified S (Localization.AtPrime P) :=
      Algebra.FormallyUnramified.of_isLocalization P.primeCompl
    have : Algebra.FormallyUnramified S P.ResidueField :=
      Algebra.FormallyUnramified.comp S (Localization.AtPrime P) P.ResidueField
    have : Algebra.FormallyUnramified R P.ResidueField :=
      Algebra.FormallyUnramified.comp R S P.ResidueField
    have : Algebra.EssFiniteType R P.ResidueField := Algebra.EssFiniteType.comp R S P.ResidueField
    have : Algebra.FormallyUnramified (IsLocalRing.ResidueField R) P.ResidueField :=
      Algebra.FormallyUnramified.of_restrictScalars R _ P.ResidueField
    have : Algebra.EssFiniteType (IsLocalRing.ResidueField R) P.ResidueField :=
      Algebra.EssFiniteType.of_comp R _ P.ResidueField
    have : Algebra.IsSeparable (IsLocalRing.ResidueField R) P.ResidueField :=
      Algebra.FormallyUnramified.isSeparable _ P.ResidueField
    have hsurj := IsSepClosed.algebraMap_surjective (IsLocalRing.ResidueField R) P.ResidueField
    let eq : IsLocalRing.ResidueField R ≃ₐ[R] P.ResidueField :=
      AlgEquiv.ofBijective (IsScalarTower.toAlgHom R (IsLocalRing.ResidueField R) P.ResidueField)
        ⟨(algebraMap (IsLocalRing.ResidueField R) P.ResidueField).injective, hsurj⟩
    refine ⟨eq.symm.toAlgHom.comp (IsScalarTower.toAlgHom R S P.ResidueField), fun x => ?_⟩
    show eq.symm (algebraMap S P.ResidueField x) = 0 ↔ x ∈ P
    rw [EmbeddingLike.map_eq_zero_iff, ← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]

  have hlift : ∀ {V : Scheme.{u}} (h : V ⟶ Y) [Etale h] (v : V),
      h v = c (IsLocalRing.closedPoint R) →
      ∃ g : Spec (.of R) ⟶ V, g ≫ h = c ∧ g (IsLocalRing.closedPoint R) = v := by
    intro V h _ v hv
    obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := h) (g := c) v
      (IsLocalRing.closedPoint R) hv
    obtain ⟨E, ι, hι, hzι, -⟩ :=
      Scheme.exists_affine_mem_range_and_range_subset
        (U := (⊤ : (Limits.pullback h c).Opens)) (x := z) trivial
    obtain ⟨w, hw⟩ := hzι
    have := hι
    let hh : Spec E ⟶ Spec (.of R) := ι ≫ Limits.pullback.snd h c
    have : Etale hh := inferInstance
    let φ : CommRingCat.of R ⟶ E := Spec.preimage hh
    have hφ : Spec.map φ = hh := Spec.map_preimage hh
    have hEt : (CommRingCat.Hom.hom φ).Etale := by
      have : Etale (Spec.map φ) := by rw [hφ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp this
    letI : Algebra R E := (CommRingCat.Hom.hom φ).toAlgebra
    have hAE : Algebra.Etale R E := RingHom.Etale.toAlgebra hEt
    haveI := hAE
    have hqw : (w.asIdeal).comap (algebraMap R E) = IsLocalRing.maximalIdeal R := by
      have h1 : (Spec.map φ) w = IsLocalRing.closedPoint R := by
        rw [hφ]
        show Limits.pullback.snd h c (ι w) = _
        rw [hw, hz2]
      have h2 := congrArg PrimeSpectrum.asIdeal h1
      exact h2
    haveI hwP : w.asIdeal.IsPrime := PrimeSpectrum.isPrime (show PrimeSpectrum E from w)
    obtain ⟨φ₀, hφ₀⟩ := hres E hAE w.asIdeal hqw
    obtain ⟨τ, hτ⟩ := hetale E φ₀
    let τ' : E ⟶ CommRingCat.of R := CommRingCat.ofHom (τ : E →+* R)
    have hret : φ ≫ τ' = 𝟙 _ := by
      ext r
      exact τ.commutes r
    have hpt : (Spec.map τ') (IsLocalRing.closedPoint R) = w := by
      refine (Spec.map_apply τ' _).trans (PrimeSpectrum.ext (Ideal.ext fun x => ?_))
      change (τ : E →+* R) x ∈ IsLocalRing.maximalIdeal R ↔ x ∈ w.asIdeal
      rw [← hφ₀ x, ← hτ x, IsLocalRing.residue_eq_zero_iff]
      exact Iff.rfl
    refine ⟨Spec.map τ' ≫ ι ≫ Limits.pullback.fst h c, ?_, ?_⟩
    · have h3 : ι ≫ Limits.pullback.snd h c = Spec.map φ := hφ.symm
      rw [Category.assoc, Category.assoc, Limits.pullback.condition, ← Category.assoc ι,
        h3, ← Category.assoc, ← Spec.map_comp, hret, Spec.map_id, Category.id_comp]
    · exact (Scheme.Hom.comp_apply _ _ _).trans ((Scheme.Hom.comp_apply _ _ _).trans
        ((congrArg (fun p => Limits.pullback.fst h c (ι p)) hpt).trans
          ((congrArg (Limits.pullback.fst h c) hw).trans hz1)))

  have s6 : ∀ {Z V : Scheme.{u}} (h : V ⟶ Z) [Etale h] (g₁ g₂ : Spec (.of R) ⟶ V),
      g₁ ≫ h = g₂ ≫ h → q ≫ g₁ = q ≫ g₂ → g₁ = g₂ := by
    intro Z V h _ g₁ g₂ hh hg
    obtain ⟨U, hU, hUeq⟩ := s0 h g₁ g₂ hh _ q hg
    have hU' : IsLocalRing.closedPoint R ∈ U := by
      rw [← hq]
      exact hU
    have hsub : Set.range ⇑(𝟙 (Spec (.of R))) ⊆ Set.range ⇑U.ι := by
      intro x _
      rw [Scheme.Opens.range_ι]
      exact (IsLocalRing.specializes_closedPoint (R := R) x).mem_open U.isOpen hU'
    have hk := IsOpenImmersion.lift_fac U.ι (𝟙 _) hsub
    calc g₁ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₁ := by
          rw [hk, Category.id_comp]
      _ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₂ := by
          simp only [Category.assoc, hUeq]
      _ = g₂ := by rw [hk, Category.id_comp]

  have hcm : c (IsLocalRing.closedPoint R) =
      wcEtGeomPt Y y (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) :=
    (congrArg c hq).symm.trans ((Scheme.Hom.comp_apply q c _).symm.trans
      (congrArg (fun g : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Y =>
        g (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) hqc))
  have hleg : ∀ l, ∃ d : Spec (.of R) ⟶ (W'.obj l).right.left,
      d ≫ (W'.obj l).right.hom = c ∧ q ≫ d = (W'.obj l).hom.left := by
    intro l
    haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
    have hpt_l : (W'.obj l).hom.left ≫ (W'.obj l).right.hom = wcEtGeomPt Y y :=
      Over.w (W'.obj l).hom
    obtain ⟨d, hd1, hd2⟩ := hlift (W'.obj l).right.hom
      ((W'.obj l).hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
      ((Scheme.Hom.comp_apply _ _ _).symm.trans
        ((congrArg (fun g : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Y =>
          g (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) hpt_l).trans
          hcm.symm))
    refine ⟨d, hd1, ?_⟩
    apply geomlift y hsep (W'.obj l).right.hom
    · rw [Category.assoc, hd1, hqc]
    · exact hpt_l
    · exact (Scheme.Hom.comp_apply q d _).trans ((congrArg d hq).trans hd2)
  choose d hd1 hd3 using hleg

  have hdc : ∀ {l l₁ : Λ} (t : l ⟶ l₁), d l ≫ (W'.map t).right.left = d l₁ := by
    intro l l₁ t
    haveI : Etale (W'.obj l₁).right.hom := (W'.obj l₁).right.prop
    apply s6 (W'.obj l₁).right.hom
    · rw [Category.assoc, MorphismProperty.Over.w (W'.map t).right, hd1, hd1]
    · rw [← Category.assoc, hd3, hd3]
      exact congrArg (fun f => f.left) (StructuredArrow.w (W'.map t))

  obtain ⟨δ, hδ, -⟩ := hlim (Spec (.of R)) d hdc
  obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
  refine ⟨δ, ?_, fun l => ?_⟩
  · rw [← hφa l₀, ← Category.assoc, hδ l₀, hd1]
  · rw [hδ l, hd3]

theorem wc_shdata_base_change_isPullback : ∀ (A A' : Type u) [CommRing A] [CommRing A'] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsLocalRing A'] (f : A →+* A'), f.IsIntegral → ∀ {Y Y' : Scheme.{u}} (π : Y ⟶ Spec (.of A)) (π' : Y' ⟶ Spec (.of A')) (p : Y' ⟶ Y), IsPullback p π' π (Spec.map (CommRingCat.ofHom f)) → ∀ (y : Y) (y' : Y'), π y = IsLocalRing.closedPoint A → IsSepClosed (Y'.residueField y') → ∀ (ι : Spec (.of (AlgebraicClosure (Y'.residueField y'))) ⟶ Spec (.of (AlgebraicClosure (Y.residueField y)))), ι ≫ wcEtGeomPt Y y = wcEtGeomPt Y' y' ≫ p → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ (e : IsLocalRing.ResidueField B →+* AlgebraicClosure (Y.residueField y)), Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) ≫ a = wcEtGeomPt Y y → ∀ (B' : Type u) [CommRing B'] [IsLocalRing B'] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ'] (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y' y')) (Scheme.Etale.forget Y')) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ Y'), wcHalShData y' B' Λ' W'' φ' a' → ∀ (e' : IsLocalRing.ResidueField B' →+* AlgebraicClosure (Y'.residueField y')), (∀ l, Spec.map (CommRingCat.ofHom e') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) ≫ φ' l = (W''.obj l).hom.left) → ∀ (β : Spec (.of B') ⟶ Spec (.of B)), β ≫ a = a' ≫ p → Spec.map (CommRingCat.ofHom e') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) ≫ β = ι ≫ Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) → IsPullback β (a' ≫ π') (a ≫ π) (Spec.map (CommRingCat.ofHom f)) :=
by
  intro A A' _ _ _ _ _ f hf Y Y' π π' p hpb y y' hy hsep ι hι B _ _ _ Λ _ _ W' φ a hd e he
    B' _ _ Λ' _ _ W'' φ' a' hd' e' hK' β hβ₁ hβ₂
  obtain ⟨-, -, hcomp, hφa, hlim, -⟩ := hd
  have hd'0 := hd'
  obtain ⟨-, -, hcomp', hφa', hlim', -⟩ := hd'0



  have s0 : ∀ {P E S : Scheme.{u}} (ee : E ⟶ S) [Etale ee] (aa bb : P ⟶ E), aa ≫ ee = bb ≫ ee →
      ∀ (Ω : Type u) [Field Ω] (pp : Spec (.of Ω) ⟶ P), pp ≫ aa = pp ≫ bb →
      ∃ U : P.Opens, pp (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ aa = U.ι ≫ bb := by
    intro P E S ee _ aa bb hab Ω _ pp hπ
    let c : P ⟶ Limits.pullback ee ee := Limits.pullback.lift aa bb hab
    have hcf : c ≫ Limits.pullback.fst ee ee = aa := Limits.pullback.lift_fst _ _ _
    have hcs : c ≫ Limits.pullback.snd ee ee = bb := Limits.pullback.lift_snd _ _ _
    have hkey : pp ≫ c = (pp ≫ aa) ≫ Limits.pullback.diagonal ee := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hπ]
    have hpt : ∀ w : Spec (.of Ω), c (pp w) = Limits.pullback.diagonal ee (aa (pp w)) := by
      intro w
      rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
    refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange, ?_, ?_⟩
    · show c (pp (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal ee).opensRange
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      exact ⟨_, (hpt _).symm⟩
    · set U := c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange with hU
      have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal ee) := by
        rintro _ ⟨x, rfl⟩
        have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at hx0
        have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal ee).opensRange := hx0
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
        rw [Scheme.Hom.comp_apply]
        exact hx'
      obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal ee = U.ι ≫ c :=
        ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal ee) (U.ι ≫ c) hrange⟩
      have h1 : U.ι ≫ aa = t := by
        calc U.ι ≫ aa = (U.ι ≫ c) ≫ Limits.pullback.fst ee ee := by rw [Category.assoc, hcf]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.fst ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      have h2 : U.ι ≫ bb = t := by
        calc U.ι ≫ bb = (U.ι ≫ c) ≫ Limits.pullback.snd ee ee := by rw [Category.assoc, hcs]
          _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.snd ee ee := by rw [ht]
          _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
      rw [h1, h2]
  have s6 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Ω : Type u) [Field Ω]
      (qq : Spec (.of Ω) ⟶ Spec (.of R)),
      qq (IsLocalRing.closedPoint Ω) = IsLocalRing.closedPoint R →
      ∀ {Z V : Scheme.{u}} (h : V ⟶ Z) [Etale h] (g₁ g₂ : Spec (.of R) ⟶ V),
      g₁ ≫ h = g₂ ≫ h → qq ≫ g₁ = qq ≫ g₂ → g₁ = g₂ := by
    intro R _ _ Ω _ qq hqq Z V h _ g₁ g₂ hh hg
    obtain ⟨U, hU, hUeq⟩ := s0 h g₁ g₂ hh Ω qq hg
    have hU' : IsLocalRing.closedPoint R ∈ U := by
      rw [← hqq]
      exact hU
    have hsub : Set.range ⇑(𝟙 (Spec (.of R))) ⊆ Set.range ⇑U.ι := by
      intro x _
      rw [Scheme.Opens.range_ι]
      exact (IsLocalRing.specializes_closedPoint (R := R) x).mem_open U.isOpen hU'
    have hk := IsOpenImmersion.lift_fac U.ι (𝟙 _) hsub
    calc g₁ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₁ := by
          rw [hk, Category.id_comp]
      _ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₂ := by
          simp only [Category.assoc, hUeq]
      _ = g₂ := by rw [hk, Category.id_comp]



  obtain ⟨yb, hyb⟩ : ∃ yb, yb = wcEtGeomPt Y y := ⟨_, rfl⟩
  obtain ⟨yb', hyb'⟩ : ∃ yb', yb' = wcEtGeomPt Y' y' := ⟨_, rfl⟩
  obtain ⟨q, hq⟩ : ∃ q : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Spec (.of B),
      q = Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) :=
    ⟨_, rfl⟩
  obtain ⟨q', hq'⟩ : ∃ q' : Spec (.of (AlgebraicClosure (Y'.residueField y'))) ⟶ Spec (.of B'),
      q' = Spec.map (CommRingCat.ofHom e') ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) := ⟨_, rfl⟩
  have hqpt : ∀ x, q x = IsLocalRing.closedPoint B := by
    intro x
    rw [hq, Scheme.Hom.comp_apply]
    exact IsLocalRing.PrimeSpectrum.comap_residue B _
  have hq'pt : ∀ x, q' x = IsLocalRing.closedPoint B' := by
    intro x
    rw [hq', Scheme.Hom.comp_apply]
    exact IsLocalRing.PrimeSpectrum.comap_residue B' _
  have heY : q ≫ a = yb := by
    rw [hq, hyb, Category.assoc]
    exact he
  have hιY : ι ≫ yb = yb' ≫ p := by
    rw [hyb, hyb']
    exact hι
  have hK'' : ∀ l, q' ≫ φ' l = (W''.obj l).hom.left := by
    intro l
    rw [hq', Category.assoc]
    exact hK' l
  have hβq : q' ≫ β = ι ≫ q := by
    rw [hq', hq, Category.assoc]
    exact hβ₂
  obtain ⟨l₀'⟩ := IsCofiltered.nonempty (C := Λ')
  have hq'aY : q' ≫ a' = yb' := by
    rw [← hφa' l₀', ← Category.assoc, hK'' l₀', hyb']
    exact Over.w (W''.obj l₀').hom
  have hyb_pt : ∀ x, yb x = y := by
    intro x
    rw [hyb]
    exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
  have hya : a (IsLocalRing.closedPoint B) = y :=
    (congrArg a (hqpt (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))).symm.trans
      ((Scheme.Hom.comp_apply q a _).symm.trans
        ((congrArg (fun g : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Y =>
          g (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) heY).trans
          (hyb_pt _)))



  letI : Algebra A B := RingHom.toAlgebra (Spec.preimage (a ≫ π)).hom
  letI : Algebra A A' := f.toAlgebra
  have hρ : Spec.map (CommRingCat.ofHom (algebraMap A B)) = a ≫ π := by
    show Spec.map (CommRingCat.ofHom (Spec.preimage (a ≫ π)).hom) = a ≫ π
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have hR0 := isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_tensorProduct A B A')
  rw [hρ] at hR0
  obtain ⟨fstR, sndR, hR, hfstR⟩ : ∃ (fstR : Spec (.of (TensorProduct A B A')) ⟶ Spec (.of B))
      (sndR : Spec (.of (TensorProduct A B A')) ⟶ Spec (.of A')),
      IsPullback fstR sndR (a ≫ π) (Spec.map (CommRingCat.ofHom f)) ∧
      fstR = Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) :=
    ⟨_, _, hR0, rfl⟩



  have hlocB : IsLocalHom (algebraMap A B) := by
    rw [IsLocalRing.isLocalHom_iff_comap_closedPoint]
    have h1 : (a ≫ π) (IsLocalRing.closedPoint B) = IsLocalRing.closedPoint A :=
      (Scheme.Hom.comp_apply a π _).trans ((congrArg π hya).trans hy)
    have h3 := congrArg (fun g : Spec (.of B) ⟶ Spec (.of A) => g (IsLocalRing.closedPoint B)) hρ
    exact (Spec.map_apply (CommRingCat.ofHom (algebraMap A B)) (IsLocalRing.closedPoint B)).symm.trans
      (h3.trans h1)
  have hlocA' : IsLocalHom (algebraMap A A') := by
    rw [IsLocalRing.isLocalHom_iff_comap_closedPoint]
    apply PrimeSpectrum.ext
    rw [PrimeSpectrum.comap_asIdeal]
    have hm := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal f hf (IsLocalRing.maximalIdeal A')
    exact IsLocalRing.eq_maximalIdeal hm
  haveI hintA' : Algebra.IsIntegral A A' := algebraMap_isIntegral_iff.mp hf



  haveI hRloc0 : IsLocalRing (TensorProduct A A' B) :=
    wc_local_tensor_integral A B A' inferInstance hlocB hlocA' hintA'
  haveI hRloc : IsLocalRing (TensorProduct A B A') :=
    (Algebra.TensorProduct.comm A A' B).toRingEquiv.isLocalRing
  haveI hintR : Algebra.IsIntegral B (TensorProduct A B A') :=
    Algebra.IsIntegral.tensorProduct A B A'
  obtain ⟨hhens, hsepR⟩ := wc_integral_over_strictly_henselian B (TensorProduct A B A') hintR
  haveI := hhens
  haveI := hsepR



  have w₁ : (fstR ≫ a) ≫ π = sndR ≫ Spec.map (CommRingCat.ofHom f) := by
    rw [Category.assoc]
    exact hR.w
  obtain ⟨c, hc₁, hc₂⟩ : ∃ c : Spec (.of (TensorProduct A B A')) ⟶ Y',
      c ≫ p = fstR ≫ a ∧ c ≫ π' = sndR :=
    ⟨hpb.lift _ _ w₁, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
  have w₂ : β ≫ (a ≫ π) = (a' ≫ π') ≫ Spec.map (CommRingCat.ofHom f) := by
    rw [← Category.assoc, hβ₁]
    simp only [Category.assoc]
    rw [hpb.w]
  obtain ⟨γ, hγ₁, hγ₂⟩ : ∃ γ : Spec (.of B') ⟶ Spec (.of (TensorProduct A B A')),
      γ ≫ fstR = β ∧ γ ≫ sndR = a' ≫ π' :=
    ⟨hR.lift _ _ w₂, hR.lift_fst _ _ _, hR.lift_snd _ _ _⟩
  have hγc : γ ≫ c = a' := by
    apply hpb.hom_ext
    · rw [Category.assoc, hc₁, ← Category.assoc, hγ₁, hβ₁]
    · rw [Category.assoc, hc₂, hγ₂]
  have w₃ : (ι ≫ q) ≫ (a ≫ π) = (yb' ≫ π') ≫ Spec.map (CommRingCat.ofHom f) := by
    have e1 : (ι ≫ q) ≫ (a ≫ π) = (ι ≫ yb) ≫ π := by
      rw [← heY]
      simp only [Category.assoc]
    rw [e1, hιY]
    simp only [Category.assoc]
    rw [hpb.w]
  obtain ⟨qb, hqb₁, hqb₂⟩ : ∃ qb : Spec (.of (AlgebraicClosure (Y'.residueField y'))) ⟶
      Spec (.of (TensorProduct A B A')), qb ≫ fstR = ι ≫ q ∧ qb ≫ sndR = yb' ≫ π' :=
    ⟨hR.lift _ _ w₃, hR.lift_fst _ _ _, hR.lift_snd _ _ _⟩
  have hq'γ : q' ≫ γ = qb := by
    apply hR.hom_ext
    · rw [Category.assoc, hγ₁, hqb₁, hβq]
    · rw [Category.assoc, hγ₂, hqb₂, ← Category.assoc, hq'aY]
  have hqbc : qb ≫ c = yb' := by
    apply hpb.hom_ext
    · rw [Category.assoc, hc₁, ← Category.assoc, hqb₁, Category.assoc, heY, hιY]
    · rw [Category.assoc, hc₂, hqb₂]
  have hqb0 : qb (IsLocalRing.closedPoint (AlgebraicClosure (Y'.residueField y'))) =
      IsLocalRing.closedPoint (TensorProduct A B A') := by
    have h0 : fstR (qb (IsLocalRing.closedPoint (AlgebraicClosure (Y'.residueField y')))) =
        IsLocalRing.closedPoint B :=
      (Scheme.Hom.comp_apply qb fstR _).symm.trans
        ((congrArg (fun g : Spec (.of (AlgebraicClosure (Y'.residueField y'))) ⟶ Spec (.of B) =>
          g (IsLocalRing.closedPoint (AlgebraicClosure (Y'.residueField y')))) hqb₁).trans
          ((Scheme.Hom.comp_apply ι q _).trans (hqpt _)))
    have h1 : PrimeSpectrum.comap (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B A')
        (qb (IsLocalRing.closedPoint (AlgebraicClosure (Y'.residueField y')))) =
        IsLocalRing.closedPoint B := by
      have h4 := congrArg (fun g : Spec (.of (TensorProduct A B A')) ⟶ Spec (.of B) =>
        g (qb (IsLocalRing.closedPoint (AlgebraicClosure (Y'.residueField y'))))) hfstR
      exact (Spec.map_apply (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
        (qb (IsLocalRing.closedPoint (AlgebraicClosure (Y'.residueField y'))))).symm.trans
        (h4.symm.trans h0)
    have heq : (algebraMap B (TensorProduct A B A')) =
        (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B A') := by
      ext b
      first
        | rfl
        | simp [Algebra.TensorProduct.algebraMap_apply]
    have hint : (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B A').IsIntegral := by
      rw [← heq]
      exact algebraMap_isIntegral_iff.mpr hintR
    have hmax : (qb (IsLocalRing.closedPoint (AlgebraicClosure (Y'.residueField y')))).asIdeal.IsMaximal := by
      haveI hprime : (qb (IsLocalRing.closedPoint (AlgebraicClosure (Y'.residueField y')))).asIdeal.IsPrime :=
        PrimeSpectrum.isPrime _
      apply Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ hint
      have h2 : Ideal.comap (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct A B A')
          (qb (IsLocalRing.closedPoint (AlgebraicClosure (Y'.residueField y')))).asIdeal =
          IsLocalRing.maximalIdeal B :=
        congrArg PrimeSpectrum.asIdeal h1
      first
        | (rw [h2]; infer_instance)
        | (convert IsLocalRing.maximalIdeal.isMaximal B using 1; exact h2)
    apply PrimeSpectrum.ext
    exact IsLocalRing.eq_maximalIdeal hmax



  obtain ⟨δ, hδ₁, hδ₂⟩ := wc_shdata_lift_from_strictly_local y' hsep B' Λ' W'' φ' a' hd'
    (TensorProduct A B A') c qb hqb0 (hqbc.trans hyb')
  have hqbδ : qb ≫ δ = q' := by
