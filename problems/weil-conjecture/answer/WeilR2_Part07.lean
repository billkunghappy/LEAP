  obtain ⟨zb, hzb⟩ : ∃ zb : Spec (.of L) ⟶ Spec (.of A),
      zb = Spec.map (CommRingCat.ofHom jA) ≫ Spec.map (CommRingCat.ofHom f) := ⟨_, rfl⟩
  have hz : z = Spec.map (CommRingCat.ofHom ι) ≫ zb := by
