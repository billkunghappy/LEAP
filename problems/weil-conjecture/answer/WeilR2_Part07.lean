  have hsq : ∀ (V V' : B.Etale) (c : V' ⟶ V) (O O' : A.Etale) (d : O' ⟶ O)
      (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ f)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ f),
      h' ≫ c.left = d.left ≫ h → ℓ₀ V' O' h' hh' ≫ Φ.map c = d ≫ ℓ₀ V O h hh := by
    intro V V' c O O' d h hh h' hh' hc
    have e1 : ((ℓ₀ V' O' h' hh').left ≫ (Φ.map c).left) ≫ Limits.pullback.fst V.hom f =
        h' ≫ c.left :=
      (Category.assoc _ _ _).trans ((congrArg ((ℓ₀ V' O' h' hh').left ≫ ·) (hΦfst c)).trans
        ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ c.left) (hℓ₀ V' O' h' hh'))))
    have e2 : (d.left ≫ (ℓ₀ V O h hh).left) ≫ Limits.pullback.fst V.hom f = d.left ≫ h :=
      (Category.assoc _ _ _).trans (congrArg (d.left ≫ ·) (hℓ₀ V O h hh))
    have s1 : ((ℓ₀ V' O' h' hh').left ≫ (Φ.map c).left) ≫ Limits.pullback.snd V.hom f =
        O'.hom :=
      (Category.assoc _ _ _).trans ((congrArg ((ℓ₀ V' O' h' hh').left ≫ ·) (hΦsnd c)).trans
        (hℓ₀s V' O' h' hh'))
    have s2 : (d.left ≫ (ℓ₀ V O h hh).left) ≫ Limits.pullback.snd V.hom f = O'.hom :=
      (Category.assoc _ _ _).trans ((congrArg (d.left ≫ ·) (hℓ₀s V O h hh)).trans
        (MorphismProperty.Over.w d))
    apply MorphismProperty.Over.Hom.ext
    apply Limits.pullback.hom_ext
    · exact e1.trans (hc.trans e2.symm)
    · exact s1.trans s2.symm

  let η : M.obj ⟶ (P.obj N).obj :=
    { app := fun X => AddCommGrpCat.ofHom (t₀.ρ X.unop (Φ.obj X.unop)
        (Limits.pullback.fst X.unop.hom f) Limits.pullback.condition)
      naturality := fun X Y g => by
        have hcomp : Limits.pullback.fst Y.unop.hom f ≫ g.unop.left =
            (Φ.map g.unop).left ≫ Limits.pullback.fst X.unop.hom f := (hΦfst g.unop).symm
        ext x
        exact t₀.nat X.unop Y.unop g.unop (Φ.obj X.unop) (Φ.obj Y.unop) (Φ.map g.unop)
          (Limits.pullback.fst X.unop.hom f) Limits.pullback.condition
          (Limits.pullback.fst Y.unop.hom f) Limits.pullback.condition hcomp x }
  let φ₀ : M ⟶ P.obj N := ObjectProperty.homMk η
  have hφ₀ : ∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
      (x : M.obj.obj (Opposite.op V)),
      (N.obj.map (ℓ₀ V O k hk).op).hom ((φ₀.hom.app (Opposite.op V)).hom x) = t₀.ρ V O k hk x := by
    intro V O k hk x
    have hc : k ≫ (𝟙 V : V ⟶ V).left = (ℓ₀ V O k hk).left ≫ Limits.pullback.fst V.hom f := by
      rw [hℓ₀]; exact Category.comp_id k
    have e := t₀.nat V V (𝟙 V) (Φ.obj V) O (ℓ₀ V O k hk) (Limits.pullback.fst V.hom f)
      Limits.pullback.condition k hk hc x
    have hid : (M.obj.map (𝟙 V).op) x = x := by simp
    rw [hid] at e
    exact e.symm

  let E : ℕ → Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} :=
    fun n => P.obj (J.cocomplex.X n)
  let δ : ∀ n, E n ⟶ E (n + 1) := fun n => P.map (J.cocomplex.d n (n + 1))
  have hinj : ∀ n, Injective (E n) := fun n => hinjP (J.cocomplex.X n)
  have hδ : ∀ n, δ n ≫ δ (n + 1) = 0 := fun n => by
    show P.map (J.cocomplex.d n (n + 1)) ≫ P.map (J.cocomplex.d (n + 1) (n + 1 + 1)) = 0
    rw [← Functor.map_comp, HomologicalComplex.d_comp_d, Functor.map_zero]
  let a : M ⟶ E 0 := φ₀ ≫ P.map (J.ι.f 0)
  have ha : a ≫ δ 0 = 0 := by
    have h0 : J.ι.f 0 ≫ J.cocomplex.d 0 (0 + 1) = 0 := J.ι_f_zero_comp_complex_d
    have h0' : P.map (J.ι.f 0) ≫ P.map (J.cocomplex.d 0 (0 + 1)) = 0 := by
      rw [← Functor.map_comp, h0, Functor.map_zero]
    exact (Category.assoc φ₀ _ _).trans ((congrArg (φ₀ ≫ ·) h0').trans Limits.comp_zero)
  have hrec : ∃ F : ∀ n, I.cocomplex.X n ⟶ E n, I.ι.f 0 ≫ F 0 = a ∧
      ∀ n, I.cocomplex.d n (n + 1) ≫ F (n + 1) = F n ≫ δ n := by
    haveI := hinj 0
    haveI := hinj 1
    haveI hmono : Mono (I.ι.f 0) := inferInstance
    let S : ℕ → Type _ := fun n => Σ' (g : I.cocomplex.X n ⟶ E n)
      (g' : I.cocomplex.X (n + 1) ⟶ E (n + 1)), I.cocomplex.d n (n + 1) ≫ g' = g ≫ δ n
    let F₀ : I.cocomplex.X 0 ⟶ E 0 := @Injective.factorThru _ _ _ _ _ (hinj 0) a (I.ι.f 0) hmono
    have hF₀ : I.ι.f 0 ≫ F₀ = a := @Injective.comp_factorThru _ _ _ _ _ (hinj 0) a (I.ι.f 0) hmono
    have h₀ : I.ι.f 0 ≫ (F₀ ≫ δ 0) = 0 :=
      (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ δ 0) hF₀).trans ha)
    let F₁ : I.cocomplex.X 1 ⟶ E 1 := I.exact₀.descToInjective (F₀ ≫ δ 0) h₀
    have hF₁ : I.cocomplex.d 0 1 ≫ F₁ = F₀ ≫ δ 0 := I.exact₀.comp_descToInjective _ _
    let step : ∀ n, S n → S (n + 1) := fun n s =>
      haveI := hinj (n + 1 + 1)
      ⟨s.2.1, (I.exact_succ n).descToInjective (s.2.1 ≫ δ (n + 1)) (by
          show I.cocomplex.d n (n + 1) ≫ (s.2.1 ≫ δ (n + 1)) = 0
          rw [← Category.assoc, s.2.2, Category.assoc, hδ, Limits.comp_zero]),
        (I.exact_succ n).comp_descToInjective _ _⟩
    let seq : ∀ n, S n := fun n => Nat.rec (motive := fun n => S n) ⟨F₀, F₁, hF₁⟩ step n
    exact ⟨fun n => (seq n).1, hF₀, fun n => (seq n).2.2⟩
  obtain ⟨F, hF0, hFd⟩ := hrec

  let T : ∀ n, wcEtTransport f (I.cocomplex.X n) (J.cocomplex.X n) := fun n =>
    { ρ := fun V O k hk => ((J.cocomplex.X n).obj.map (ℓ₀ V O k hk).op).hom.comp
        ((F n).hom.app (Opposite.op V)).hom
      nat := by
        intro V V' c O O' d h hh h' hh' hc x
        have key := hsq V V' c O O' d h hh h' hh' hc
        have n1 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ x) ((F n).hom.naturality c.op)
        have n2 : ∀ y : (J.cocomplex.X n).obj.obj (Opposite.op (Φ.obj V)),
            ((J.cocomplex.X n).obj.map (ℓ₀ V' O' h' hh').op).hom
              (((J.cocomplex.X n).obj.map (Φ.map c).op).hom y) =
            ((J.cocomplex.X n).obj.map d.op).hom
              (((J.cocomplex.X n).obj.map (ℓ₀ V O h hh).op).hom y) := by
          intro y
          have e := congrArg (fun φ => (J.cocomplex.X n).obj.map φ.op) key
          simp only [op_comp, Functor.map_comp] at e
          exact congrArg (fun φ => AddCommGrpCat.Hom.hom φ y) e
        exact (congrArg (fun y => ((J.cocomplex.X n).obj.map (ℓ₀ V' O' h' hh').op).hom y) n1).trans
          (n2 _) }
  refine ⟨T, ?_, ?_⟩
  · intro n V O k hk x
    have c1 := congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op V)) x) (hFd n)
    have c2 : ∀ y : (J.cocomplex.X n).obj.obj (Opposite.op (Φ.obj V)),
        ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
          (((J.cocomplex.d n (n + 1)).hom.app (Opposite.op (Φ.obj V))).hom y) =
        ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom
          (((J.cocomplex.X n).obj.map (ℓ₀ V O k hk).op).hom y) := fun y =>
      (congrArg (fun φ => AddCommGrpCat.Hom.hom φ y)
        ((J.cocomplex.d n (n + 1)).hom.naturality (ℓ₀ V O k hk).op)).symm
    exact (congrArg (fun y => ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom y) c1).trans
      (c2 _)
  · intro V O k hk x
    have b1 := congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op V)) x) hF0
    have b2 : ∀ y : N.obj.obj (Opposite.op (Φ.obj V)),
        ((J.cocomplex.X 0).obj.map (ℓ₀ V O k hk).op).hom
          (((J.ι.f 0).hom.app (Opposite.op (Φ.obj V))).hom y) =
        ((J.ι.f 0).hom.app (Opposite.op O)).hom ((N.obj.map (ℓ₀ V O k hk).op).hom y) := fun y =>
      (congrArg (fun φ => AddCommGrpCat.Hom.hom φ y)
        ((J.ι.f 0).hom.naturality (ℓ₀ V O k hk).op)).symm
    exact (congrArg (fun y => ((J.cocomplex.X 0).obj.map (ℓ₀ V O k hk).op).hom y) b1).trans
      ((b2 _).trans
        (congrArg (fun y => ((J.ι.f 0).hom.app (Opposite.op O)).hom y) (hφ₀ V O k hk x)))

theorem wc_et_transport_comparison_homotopy : ∀ {A B : Scheme.{u}} (f : A ⟶ B) {M : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} {N : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}} (I : InjectiveResolution M) (J : InjectiveResolution N) (T T' : ∀ n : ℕ, wcEtTransport f (I.cocomplex.X n) (J.cocomplex.X n)), (∀ (n : ℕ) (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f) (x : (I.cocomplex.X n).obj.obj (Opposite.op V)), (T (n + 1)).ρ V O k hk (((I.cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) = ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((T n).ρ V O k hk x)) → (∀ (n : ℕ) (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f) (x : (I.cocomplex.X n).obj.obj (Opposite.op V)), (T' (n + 1)).ρ V O k hk (((I.cocomplex.d n (n + 1)).hom.app (Opposite.op V)).hom x) = ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((T' n).ρ V O k hk x)) → (∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f) (x : M.obj.obj (Opposite.op V)), (T 0).ρ V O k hk (((I.ι.f 0).hom.app (Opposite.op V)).hom x) = (T' 0).ρ V O k hk (((I.ι.f 0).hom.app (Opposite.op V)).hom x)) → ∃ H : ∀ n : ℕ, wcEtTransport f (I.cocomplex.X (n + 1)) (J.cocomplex.X n), (∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f) (x : (I.cocomplex.X 0).obj.obj (Opposite.op V)), (T 0).ρ V O k hk x - (T' 0).ρ V O k hk x = (H 0).ρ V O k hk (((I.cocomplex.d 0 1).hom.app (Opposite.op V)).hom x)) ∧ ∀ (n : ℕ) (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f) (x : (I.cocomplex.X (n + 1)).obj.obj (Opposite.op V)), (T (n + 1)).ρ V O k hk x - (T' (n + 1)).ρ V O k hk x = ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom ((H n).ρ V O k hk x) + (H (n + 1)).ρ V O k hk (((I.cocomplex.d (n + 1) (n + 1 + 1)).hom.app (Opposite.op V)).hom x) :=
by
  intro A B f M N I J T T' hT hT' hbase
  classical

  have hlan : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] [Limits.HasFiniteLimits C]
      (G : C ⥤ D) [Limits.PreservesFiniteLimits G],
      Limits.PreservesFiniteLimits (G.op.lan : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ _ G _
    have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
        Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
            (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim) := by
      intro C D _ _ L _ _ Y
      refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
      intro F₁ F₂ φ
      have hnat : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
          (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
        fun j => (L.lan.map φ).naturality j.hom
      have hfac : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
          φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
        Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
          (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
      refine (Iso.inv_comp_eq _).1 ?_
      apply Limits.colimit.hom_ext
      intro j
      have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
          (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
          φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
        calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
            = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
          _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
              (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
          _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
                (Category.assoc _ _ _).symm
          _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
          _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
              Category.assoc _ _ _
          _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
              congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
      erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
      exact key
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := wc_lan_eval_iso G.op Y
    haveI := (flat_of_preservesFiniteLimits G).cofiltered Y.unop
    haveI : IsFiltered (CostructuredArrow G.op Y) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence G Y.unop)
    haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow G.op Y)) :=
      IsFiltered.of_equivalence (ULiftHom.equiv (C := CostructuredArrow G.op Y))
    haveI : HasExactColimitsOfShape (ULiftHom.{u+1} (CostructuredArrow G.op Y))
        AddCommGrpCat.{u+1} := AB5OfSize.ofShape (ULiftHom.{u+1} (CostructuredArrow G.op Y))
    haveI : HasExactColimitsOfShape (CostructuredArrow G.op Y) AddCommGrpCat.{u+1} :=
      @HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _
        (ULiftHom.{u+1} (CostructuredArrow G.op Y)) (CostructuredArrow G.op Y) _ _
        (ULiftHom.equiv (C := CostructuredArrow G.op Y)).symm _ _
    exact Limits.preservesLimitsOfShape_of_natIso θ.symm

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
  let Φ := wcEtBaseChange f
  haveI hΦfl : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange f ⋙ Scheme.Etale.forget A) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget B ⋙ Over.pullback f ≅ wcEtBaseChange f ⋙ Scheme.Etale.forget A)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange f) (Scheme.Etale.forget A)⟩
  haveI := flat_of_preservesFiniteLimits Φ
  haveI : Φ.IsContinuous (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology A) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov f)
  haveI := hlan Φ
  let P := Φ.sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology B)
    (Scheme.smallEtaleTopology A)

  have hinjP : ∀ (E : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}) [Injective E],
      Injective (P.obj E) := by
    intro E _
    let adj0 := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous Φ AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology A)
    let L := Functor.sheafPullbackConstruction.sheafPullback Φ AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology A)
    haveI hL : Limits.PreservesFiniteLimits L :=
      Limits.comp_preservesFiniteLimits (sheafToPresheaf _ _)
        (Φ.op.lan ⋙ presheafToSheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1})
    haveI : Limits.PreservesLimitsOfShape Limits.WalkingCospan L :=
      Limits.PreservesFiniteLimits.preservesFiniteLimits Limits.WalkingCospan
    haveI : L.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape L
    exact Injective.injective_of_adjoint adj0 E

  let ℓ₀ : ∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left), k ≫ V.hom = O.hom ≫ f →
      (O ⟶ Φ.obj V) := fun V O k hk =>
    MorphismProperty.Over.homMk (Limits.pullback.lift k O.hom hk) (Limits.pullback.lift_snd _ _ _)
      trivial
  have hℓ₀ : ∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f),
      (ℓ₀ V O k hk).left ≫ Limits.pullback.fst V.hom f = k :=
    fun V O k hk => Limits.pullback.lift_fst _ _ _
  have hℓ₀s : ∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f),
      (ℓ₀ V O k hk).left ≫ Limits.pullback.snd V.hom f = O.hom :=
    fun V O k hk => Limits.pullback.lift_snd _ _ _
  have hΦfst : ∀ {V V' : B.Etale} (c : V' ⟶ V),
      (Φ.map c).left ≫ Limits.pullback.fst V.hom f = Limits.pullback.fst V'.hom f ≫ c.left :=
    fun c => Limits.pullback.lift_fst _ _ _
  have hΦsnd : ∀ {V V' : B.Etale} (c : V' ⟶ V),
      (Φ.map c).left ≫ Limits.pullback.snd V.hom f = Limits.pullback.snd V'.hom f :=
    fun c => Limits.pullback.lift_snd _ _ _
  have hsq : ∀ (V V' : B.Etale) (c : V' ⟶ V) (O O' : A.Etale) (d : O' ⟶ O)
      (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ f)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ f),
      h' ≫ c.left = d.left ≫ h → ℓ₀ V' O' h' hh' ≫ Φ.map c = d ≫ ℓ₀ V O h hh := by
    intro V V' c O O' d h hh h' hh' hc
    have e1 : ((ℓ₀ V' O' h' hh').left ≫ (Φ.map c).left) ≫ Limits.pullback.fst V.hom f =
        h' ≫ c.left :=
      (Category.assoc _ _ _).trans ((congrArg ((ℓ₀ V' O' h' hh').left ≫ ·) (hΦfst c)).trans
        ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ c.left) (hℓ₀ V' O' h' hh'))))
    have e2 : (d.left ≫ (ℓ₀ V O h hh).left) ≫ Limits.pullback.fst V.hom f = d.left ≫ h :=
      (Category.assoc _ _ _).trans (congrArg (d.left ≫ ·) (hℓ₀ V O h hh))
    have s1 : ((ℓ₀ V' O' h' hh').left ≫ (Φ.map c).left) ≫ Limits.pullback.snd V.hom f =
        O'.hom :=
      (Category.assoc _ _ _).trans ((congrArg ((ℓ₀ V' O' h' hh').left ≫ ·) (hΦsnd c)).trans
        (hℓ₀s V' O' h' hh'))
    have s2 : (d.left ≫ (ℓ₀ V O h hh).left) ≫ Limits.pullback.snd V.hom f = O'.hom :=
      (Category.assoc _ _ _).trans ((congrArg (d.left ≫ ·) (hℓ₀s V O h hh)).trans
        (MorphismProperty.Over.w d))
    apply MorphismProperty.Over.Hom.ext
    apply Limits.pullback.hom_ext
    · exact e1.trans (hc.trans e2.symm)
    · exact s1.trans s2.symm

  let E : ℕ → Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} :=
    fun n => P.obj (J.cocomplex.X n)
  let δ : ∀ n, E n ⟶ E (n + 1) := fun n => P.map (J.cocomplex.d n (n + 1))
  have hinj : ∀ n, Injective (E n) := fun n => hinjP (J.cocomplex.X n)
  have hδ : ∀ n, δ n ≫ δ (n + 1) = 0 := fun n => by
    show P.map (J.cocomplex.d n (n + 1)) ≫ P.map (J.cocomplex.d (n + 1) (n + 1 + 1)) = 0
    rw [← Functor.map_comp, HomologicalComplex.d_comp_d, Functor.map_zero]

  let flat : ∀ n, wcEtTransport f (I.cocomplex.X n) (J.cocomplex.X n) → (I.cocomplex.X n ⟶ E n) :=
    fun n t => ObjectProperty.homMk
      ({ app := fun X => AddCommGrpCat.ofHom (t.ρ X.unop (Φ.obj X.unop)
            (Limits.pullback.fst X.unop.hom f) Limits.pullback.condition)
         naturality := fun X Y g => by
          have hcomp : Limits.pullback.fst Y.unop.hom f ≫ g.unop.left =
              (Φ.map g.unop).left ≫ Limits.pullback.fst X.unop.hom f := (hΦfst g.unop).symm
          ext x
          exact t.nat X.unop Y.unop g.unop (Φ.obj X.unop) (Φ.obj Y.unop) (Φ.map g.unop)
            (Limits.pullback.fst X.unop.hom f) Limits.pullback.condition
            (Limits.pullback.fst Y.unop.hom f) Limits.pullback.condition hcomp x } :
        (I.cocomplex.X n).obj ⟶ (E n).obj)
  have hflat : ∀ n (t : wcEtTransport f (I.cocomplex.X n) (J.cocomplex.X n)) (V : B.Etale)
      (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f)
      (x : (I.cocomplex.X n).obj.obj (Opposite.op V)),
      ((J.cocomplex.X n).obj.map (ℓ₀ V O k hk).op).hom (((flat n t).hom.app (Opposite.op V)).hom x) =
        t.ρ V O k hk x := by
    intro n t V O k hk x
    have hc : k ≫ (𝟙 V : V ⟶ V).left = (ℓ₀ V O k hk).left ≫ Limits.pullback.fst V.hom f := by
      rw [hℓ₀]; exact Category.comp_id k
    have e := t.nat V V (𝟙 V) (Φ.obj V) O (ℓ₀ V O k hk) (Limits.pullback.fst V.hom f)
      Limits.pullback.condition k hk hc x
    have hid : ((I.cocomplex.X n).obj.map (𝟙 V).op) x = x := by simp
    rw [hid] at e
    exact e.symm

  let F : ∀ n, I.cocomplex.X n ⟶ E n := fun n => flat n (T n) - flat n (T' n)
  have hFd : ∀ n, I.cocomplex.d n (n + 1) ≫ F (n + 1) = F n ≫ δ n := by
    intro n
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext X
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    have e1 := hT n X.unop (Φ.obj X.unop) (Limits.pullback.fst X.unop.hom f)
      Limits.pullback.condition x
    have e2 := hT' n X.unop (Φ.obj X.unop) (Limits.pullback.fst X.unop.hom f)
      Limits.pullback.condition x
    exact (congrArg₂ (fun a b => a - b) e1 e2).trans
      (map_sub ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op (Φ.obj X.unop))).hom
        ((T n).ρ X.unop (Φ.obj X.unop) (Limits.pullback.fst X.unop.hom f)
          Limits.pullback.condition x)
        ((T' n).ρ X.unop (Φ.obj X.unop) (Limits.pullback.fst X.unop.hom f)
          Limits.pullback.condition x)).symm
  have hι : I.ι.f 0 ≫ F 0 = 0 := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext X
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    exact sub_eq_zero.mpr (hbase X.unop (Φ.obj X.unop) (Limits.pullback.fst X.unop.hom f)
      Limits.pullback.condition x)

  have hrec : ∃ G : ∀ n, I.cocomplex.X (n + 1) ⟶ E n, F 0 = I.cocomplex.d 0 1 ≫ G 0 ∧
      ∀ n, F (n + 1) = G n ≫ δ n + I.cocomplex.d (n + 1) (n + 1 + 1) ≫ G (n + 1) := by
    haveI := hinj 0
    haveI := hinj 1
    let S : ℕ → Type _ := fun n => Σ' (g : I.cocomplex.X (n + 1) ⟶ E n)
      (g' : I.cocomplex.X (n + 1 + 1) ⟶ E (n + 1)),
      F (n + 1) = g ≫ δ n + I.cocomplex.d (n + 1) (n + 1 + 1) ≫ g'
    let G₀ : I.cocomplex.X 1 ⟶ E 0 := I.exact₀.descToInjective (F 0) hι
    have hG₀ : I.cocomplex.d 0 1 ≫ G₀ = F 0 := I.exact₀.comp_descToInjective _ _
    have hF0' : I.cocomplex.d 0 1 ≫ F 1 = F 0 ≫ δ 0 := hFd 0
    have h₁ : I.cocomplex.d 0 (0 + 1) ≫ (F 1 - G₀ ≫ δ 0) = 0 := by
      show I.cocomplex.d 0 1 ≫ (F 1 - G₀ ≫ δ 0) = 0
      rw [Preadditive.comp_sub, hF0', ← Category.assoc, hG₀, sub_self]
    let G₁ : I.cocomplex.X (0 + 2) ⟶ E 1 :=
      (I.exact_succ 0).descToInjective (F 1 - G₀ ≫ δ 0) h₁
    have hG₁ : I.cocomplex.d (0 + 1) (0 + 2) ≫ G₁ = F 1 - G₀ ≫ δ 0 :=
      (I.exact_succ 0).comp_descToInjective _ _
    have s₀ : F (0 + 1) = G₀ ≫ δ 0 + I.cocomplex.d (0 + 1) (0 + 1 + 1) ≫ G₁ :=
      (eq_sub_iff_add_eq.mp hG₁).symm.trans (add_comm _ _)
    have hstep : ∀ n (g : I.cocomplex.X (n + 1) ⟶ E n) (g' : I.cocomplex.X (n + 1 + 1) ⟶ E (n + 1)),
        F (n + 1) = g ≫ δ n + I.cocomplex.d (n + 1) (n + 1 + 1) ≫ g' →
        I.cocomplex.d (n + 1) (n + 1 + 1) ≫ (F (n + 1 + 1) - g' ≫ δ (n + 1)) = 0 := by
      intro n g g' w
      rw [Preadditive.comp_sub, hFd (n + 1), w, Preadditive.add_comp, Category.assoc,
        Category.assoc, hδ n, Limits.comp_zero, zero_add, sub_self]
    let step : ∀ n, S n → S (n + 1) := fun n s =>
      haveI := hinj (n + 1 + 1)
      ⟨s.2.1, (I.exact_succ (n + 1)).descToInjective (F (n + 1 + 1) - s.2.1 ≫ δ (n + 1))
          (hstep n s.1 s.2.1 s.2.2),
        (eq_sub_iff_add_eq.mp ((I.exact_succ (n + 1)).comp_descToInjective _ _)).symm.trans
          (add_comm _ _)⟩
    let seq : ∀ n, S n := fun n => Nat.rec (motive := fun n => S n) ⟨G₀, G₁, s₀⟩ step n
    exact ⟨fun n => (seq n).1, hG₀.symm, fun n => (seq n).2.2⟩
  obtain ⟨G, hG0, hGs⟩ := hrec

  let H : ∀ n, wcEtTransport f (I.cocomplex.X (n + 1)) (J.cocomplex.X n) := fun n =>
    { ρ := fun V O k hk => ((J.cocomplex.X n).obj.map (ℓ₀ V O k hk).op).hom.comp
        ((G n).hom.app (Opposite.op V)).hom
      nat := by
        intro V V' c O O' d h hh h' hh' hc x
        have key := hsq V V' c O O' d h hh h' hh' hc
        have n1 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ x) ((G n).hom.naturality c.op)
        have n2 : ∀ y : (J.cocomplex.X n).obj.obj (Opposite.op (Φ.obj V)),
            ((J.cocomplex.X n).obj.map (ℓ₀ V' O' h' hh').op).hom
              (((J.cocomplex.X n).obj.map (Φ.map c).op).hom y) =
            ((J.cocomplex.X n).obj.map d.op).hom
              (((J.cocomplex.X n).obj.map (ℓ₀ V O h hh).op).hom y) := by
          intro y
          have e := congrArg (fun φ => (J.cocomplex.X n).obj.map φ.op) key
          simp only [op_comp, Functor.map_comp] at e
          exact congrArg (fun φ => AddCommGrpCat.Hom.hom φ y) e
        exact (congrArg (fun y => ((J.cocomplex.X n).obj.map (ℓ₀ V' O' h' hh').op).hom y) n1).trans
          (n2 _) }
  refine ⟨H, ?_, ?_⟩
  · intro V O k hk x
    have b1 := congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op V)) x) hG0
    have a1 := hflat 0 (T 0) V O k hk x
    have a2 := hflat 0 (T' 0) V O k hk x
    calc (T 0).ρ V O k hk x - (T' 0).ρ V O k hk x
        = ((J.cocomplex.X 0).obj.map (ℓ₀ V O k hk).op).hom
            (((flat 0 (T 0)).hom.app (Opposite.op V)).hom x) -
          ((J.cocomplex.X 0).obj.map (ℓ₀ V O k hk).op).hom
            (((flat 0 (T' 0)).hom.app (Opposite.op V)).hom x) :=
          (congrArg₂ (fun a b => a - b) a1 a2).symm
      _ = ((J.cocomplex.X 0).obj.map (ℓ₀ V O k hk).op).hom
            (((F 0).hom.app (Opposite.op V)).hom x) :=
          (map_sub ((J.cocomplex.X 0).obj.map (ℓ₀ V O k hk).op).hom
            (((flat 0 (T 0)).hom.app (Opposite.op V)).hom x)
            (((flat 0 (T' 0)).hom.app (Opposite.op V)).hom x)).symm
      _ = ((J.cocomplex.X 0).obj.map (ℓ₀ V O k hk).op).hom
            (((G 0).hom.app (Opposite.op V)).hom
              (((I.cocomplex.d 0 1).hom.app (Opposite.op V)).hom x)) :=
          congrArg (fun y => ((J.cocomplex.X 0).obj.map (ℓ₀ V O k hk).op).hom y) b1
  · intro n V O k hk x
    have b1 := congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.hom.app (Opposite.op V)) x) (hGs n)
    have a1 := hflat (n + 1) (T (n + 1)) V O k hk x
    have a2 := hflat (n + 1) (T' (n + 1)) V O k hk x
    have c2 : ∀ y : (J.cocomplex.X n).obj.obj (Opposite.op (Φ.obj V)),
        ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
          (((J.cocomplex.d n (n + 1)).hom.app (Opposite.op (Φ.obj V))).hom y) =
        ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom
          (((J.cocomplex.X n).obj.map (ℓ₀ V O k hk).op).hom y) := fun y =>
      (congrArg (fun φ => AddCommGrpCat.Hom.hom φ y)
        ((J.cocomplex.d n (n + 1)).hom.naturality (ℓ₀ V O k hk).op)).symm
    calc (T (n + 1)).ρ V O k hk x - (T' (n + 1)).ρ V O k hk x
        = ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
            (((flat (n + 1) (T (n + 1))).hom.app (Opposite.op V)).hom x) -
          ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
            (((flat (n + 1) (T' (n + 1))).hom.app (Opposite.op V)).hom x) :=
          (congrArg₂ (fun a b => a - b) a1 a2).symm
      _ = ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
            (((F (n + 1)).hom.app (Opposite.op V)).hom x) :=
          (map_sub ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
            (((flat (n + 1) (T (n + 1))).hom.app (Opposite.op V)).hom x)
            (((flat (n + 1) (T' (n + 1))).hom.app (Opposite.op V)).hom x)).symm
      _ = ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
            (@HAdd.hAdd ((J.cocomplex.X (n + 1)).obj.obj (Opposite.op (Φ.obj V)))
              ((J.cocomplex.X (n + 1)).obj.obj (Opposite.op (Φ.obj V)))
              ((J.cocomplex.X (n + 1)).obj.obj (Opposite.op (Φ.obj V))) _
              (((J.cocomplex.d n (n + 1)).hom.app (Opposite.op (Φ.obj V))).hom
                (((G n).hom.app (Opposite.op V)).hom x))
              (((G (n + 1)).hom.app (Opposite.op V)).hom
                (((I.cocomplex.d (n + 1) (n + 1 + 1)).hom.app (Opposite.op V)).hom x))) :=
          congrArg (fun y => ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom y) b1
      _ = ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
            (((J.cocomplex.d n (n + 1)).hom.app (Opposite.op (Φ.obj V))).hom
              (((G n).hom.app (Opposite.op V)).hom x)) +
          ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
            (((G (n + 1)).hom.app (Opposite.op V)).hom
              (((I.cocomplex.d (n + 1) (n + 1 + 1)).hom.app (Opposite.op V)).hom x)) :=
          map_add _ _ _
      _ = ((J.cocomplex.d n (n + 1)).hom.app (Opposite.op O)).hom
            (((J.cocomplex.X n).obj.map (ℓ₀ V O k hk).op).hom
              (((G n).hom.app (Opposite.op V)).hom x)) +
          ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
            (((G (n + 1)).hom.app (Opposite.op V)).hom
              (((I.cocomplex.d (n + 1) (n + 1 + 1)).hom.app (Opposite.op V)).hom x)) :=
          congrArg (fun z => z + ((J.cocomplex.X (n + 1)).obj.map (ℓ₀ V O k hk).op).hom
            (((G (n + 1)).hom.app (Opposite.op V)).hom
              (((I.cocomplex.d (n + 1) (n + 1 + 1)).hom.app (Opposite.op V)).hom x))) (c2 _)

theorem wc_et_chain_transport_comp : ∀ {Y Z W : Scheme.{u}} (g : Y ⟶ Z) (h : Z ⟶ W) (I : CochainComplex (Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}) ℕ) (K : CochainComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) ℕ) (J : CochainComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) ℕ) (σ : ∀ n : ℕ, wcEtTransport h (I.X n) (K.X n)) (κ : ∀ n : ℕ, wcEtTransport g (K.X n) (J.X n)), (∀ (n : ℕ) (V : W.Etale) (O : Z.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ h) (x : (I.X n).obj.obj (Opposite.op V)), (σ (n + 1)).ρ V O k hk (((I.d n (n + 1)).hom.app (Opposite.op V)).hom x) = ((K.d n (n + 1)).hom.app (Opposite.op O)).hom ((σ n).ρ V O k hk x)) → (∀ (n : ℕ) (V : Z.Etale) (O : Y.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ g) (x : (K.X n).obj.obj (Opposite.op V)), (κ (n + 1)).ρ V O k hk (((K.d n (n + 1)).hom.app (Opposite.op V)).hom x) = ((J.d n (n + 1)).hom.app (Opposite.op O)).hom ((κ n).ρ V O k hk x)) → ∃ μ : ∀ n : ℕ, wcEtTransport (g ≫ h) (I.X n) (J.X n), (∀ (n : ℕ) (V : W.Etale) (O : Y.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ (g ≫ h)) (x : (I.X n).obj.obj (Opposite.op V)), (μ (n + 1)).ρ V O k hk (((I.d n (n + 1)).hom.app (Opposite.op V)).hom x) = ((J.d n (n + 1)).hom.app (Opposite.op O)).hom ((μ n).ρ V O k hk x)) ∧ ∀ n : ℕ, wcEtTransportFactor (rfl : g ≫ h = g ≫ h) (σ n) (κ n) (μ n) :=
by
  intro Y Z W g h I K J σ κ hσ hκ
  have pc : ∀ V : W.Etale,
      Limits.pullback.fst V.hom h ≫ V.hom = ((wcEtBaseChange h).obj V).hom ≫ h := by
    intro V
    change Limits.pullback.fst V.hom h ≫ V.hom = Limits.pullback.snd V.hom h ≫ h
    exact Limits.pullback.condition
  have hk1 : ∀ (V : W.Etale) (O : Y.Etale) (k : O.left ⟶ V.left),
      k ≫ V.hom = O.hom ≫ (g ≫ h) → k ≫ V.hom = (O.hom ≫ g) ≫ h :=
    fun V O k hk => hk.trans (Category.assoc _ _ _).symm
  let ℓ : ∀ (V : W.Etale) (O : Y.Etale) (k : O.left ⟶ V.left),
      k ≫ V.hom = O.hom ≫ (g ≫ h) → (O.left ⟶ ((wcEtBaseChange h).obj V).left) :=
    fun V O k hk => Limits.pullback.lift k (O.hom ≫ g) (hk1 V O k hk)
  have hℓ : ∀ (V : W.Etale) (O : Y.Etale) (k : O.left ⟶ V.left)
      (hk : k ≫ V.hom = O.hom ≫ (g ≫ h)),
      ℓ V O k hk ≫ ((wcEtBaseChange h).obj V).hom = O.hom ≫ g := by
    intro V O k hk
    exact Limits.pullback.lift_snd _ _ _
  let μ : ∀ n : ℕ, wcEtTransport (g ≫ h) (I.X n) (J.X n) := fun n =>
    { ρ := fun V O k hk =>
        ((κ n).ρ ((wcEtBaseChange h).obj V) O (ℓ V O k hk) (hℓ V O k hk)).comp
          ((σ n).ρ V ((wcEtBaseChange h).obj V) (Limits.pullback.fst V.hom h) (pc V))
      nat := by
