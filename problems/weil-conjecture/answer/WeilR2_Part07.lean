  have gen : ∀ {Z P Y X : Scheme.{u}} (F : Type u) [Field F] (g' : Z ⟶ P) (z : Z ⟶ Spec (.of F))
      (p : P ⟶ Y) (τ : Spec (.of F) ⟶ Y) (q : Y ⟶ X) (t : Spec (.of F) ⟶ X),
      IsPullback g' z p τ → τ ≫ q = t → IsAffineHom p → IsAffineHom q → ∀ (U : X.Opens),
