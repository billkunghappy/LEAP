    fun V O k hk => Limits.pullback.lift_fst _ _ _
  have hℓ₀s : ∀ (V : B.Etale) (O : A.Etale) (k : O.left ⟶ V.left) (hk : k ≫ V.hom = O.hom ≫ f),
