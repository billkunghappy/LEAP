        ((I F').cocomplex.d (n + 1) (n + 1 + 1)) ((I F').cocomplex.d_comp_d _ _ _)).Exact :=
      (HomologicalComplex.exactAt_iff' _ n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
        (CochainComplex.next ℕ (n + 1))).mp ((I F').cocomplex_exactAt_succ n)
    obtain ⟨O₃, h₃, o₃, w, ho₃, hw⟩ := hS2 _ _ _ hIex O _ hdx (k' u₂)
    obtain ⟨U₃, c₃, u₃, k₃, hu₃, hk₃1, hk₃2⟩ := hS4 (wcSubP R F') U₂ O O₃ k' hk' h₃ u₂ o₃ ho₃
    refine ⟨U₃, (c₃ ≫ c₂) ≫ c₁, u₃, (σ n F').ρ O₃ U₃ k₃ hk₃2 w, ?_, ?_⟩
    · rw [hcompPt, hcompPt, hu₃, hu₂, hu₁]
    · have hA : (k₃ ≫ h₃.left) ≫ O.hom = U₃.hom ≫ wcSubP R F' := by
        rw [Category.assoc, hOw h₃, hk₃2]
      have hD : ((c₃ ≫ c₂).left ≫ k) ≫ V.hom = U₃.hom ≫ wcSubP R F := by
        rw [Category.assoc, hk, ← Category.assoc, hOw (c₃ ≫ c₂)]
      have hcomp : (k₃ ≫ h₃.left) ≫ k'' = (c₃ ≫ c₂).left ≫ k := by
        rw [hk₃1, Category.assoc, hkk, hcl, Category.assoc]
      have e0 := hσd n F' O₃ U₃ k₃ hk₃2 w
      have e1 := (σ (n + 1) F').nat O O₃ h₃ U₃ U₃ (𝟙 U₃) (k₃ ≫ h₃.left) hA k₃ hk₃2
        (by show _ = 𝟙 _ ≫ _; rw [Category.id_comp]) ((e (n + 1) F F' h).ρ V O k'' hk'' t)
      rw [op_id, CategoryTheory.Functor.map_id] at e1
      have e2 := hcone (n + 1) F F' h V O k'' hk'' U₃ (k₃ ≫ h₃.left) hA t
      have e3 := hρ (σ (n + 1) F) hcomp (by rw [hcomp]; exact hD) hD t
      have e4 := (σ (n + 1) F).nat V V (𝟙 V) U₁ U₃ (c₃ ≫ c₂) k hk ((c₃ ≫ c₂).left ≫ k) hD
        (by show _ ≫ 𝟙 _ = _; rw [Category.comp_id]) t
      rw [op_id, CategoryTheory.Functor.map_id] at e4
      calc _ = _ := e0.symm
        _ = _ := congrArg (fun z => (σ (n + 1) F').ρ O₃ U₃ k₃ hk₃2 z) hw
        _ = _ := e1
        _ = _ := e2.symm
        _ = _ := e3
        _ = _ := e4
        _ = _ := congrArg (fun z => ((K.X (n + 1)).obj.map (c₃ ≫ c₂).op).hom z) ht
        _ = _ := (e5 (K.X (n + 1)) (c₃ ≫ c₂) c₁ s).symm



  have hex0 : (ShortComplex.mk εK (K.d 0 1) hεd).Exact := by
    refine hS1 εK (K.d 0 1) hεd ?_
    intro U s hs u
    obtain ⟨U₁, c₁, u₁, F, V, k, hk, t, hu₁, ht⟩ := hgen 0 U s u
    have hdt : (σ 1 F).ρ V U₁ k hk
        ((((I F).cocomplex.d 0 1).hom.app (Opposite.op V)).hom t) = 0 := by
      rw [hσd0 F V U₁ k hk t, ht, hnat (K.d 0 1) c₁ s, hs, map_zero]
    obtain ⟨U₂, c₂, u₂, F', h, O, k', hk', k'', hk'', hu₂, hkk, hvan⟩ :=
      hker 1 F V U₁ k hk _ hdt u₁
    have hdx : (((I F').cocomplex.d 0 1).hom.app (Opposite.op O)).hom
        ((e 0 F F' h).ρ V O k'' hk'' t) = 0 :=
      (hd0 F F' h V O k'' hk'' t).symm.trans hvan
    obtain ⟨O₃, h₃, o₃, l, ho₃, hl⟩ := hS2 _ _ _ (hIex0 F') O _ hdx (k' u₂)
    obtain ⟨O₄, h₄, o₄, a, ho₄, hla⟩ := hS6 (wcSubX R F') O₃ l o₃
    obtain ⟨U₄, c₄, u₄, k₄, hu₄, hk₄1, hk₄2⟩ := hS4 (wcSubP R F') U₂ O O₄ k' hk' (h₄ ≫ h₃) u₂ o₄
      (by rw [hcompPt, ho₄, ho₃])
    refine ⟨U₄, (c₄ ≫ c₂) ≫ c₁, u₄, wcConstSec (Spec (.of R)) (ULift.{u+1} (ZMod m)) U₄ a, ?_, ?_⟩
    · rw [hcompPt, hcompPt, hu₄, hu₂, hu₁]
    · have hA : (k₄ ≫ (h₄ ≫ h₃).left) ≫ O.hom = U₄.hom ≫ wcSubP R F' := by
        rw [Category.assoc, hOw (h₄ ≫ h₃), hk₄2]
      have hD : ((c₄ ≫ c₂).left ≫ k) ≫ V.hom = U₄.hom ≫ wcSubP R F := by
        rw [Category.assoc, hk, ← Category.assoc, hOw (c₄ ≫ c₂)]
      have hcomp : (k₄ ≫ (h₄ ≫ h₃).left) ≫ k'' = (c₄ ≫ c₂).left ≫ k := by
        rw [hk₄1, Category.assoc, hkk, hcl, Category.assoc]
      have e0 := hP F' O₄ U₄ k₄ hk₄2 a
      have ea := hnat (wcInjAug (I F')) h₄ l
      have e1 := (σ 0 F').nat O O₄ (h₄ ≫ h₃) U₄ U₄ (𝟙 U₄) (k₄ ≫ (h₄ ≫ h₃).left) hA k₄ hk₄2
        (by show _ = 𝟙 _ ≫ _; rw [Category.id_comp]) ((e 0 F F' h).ρ V O k'' hk'' t)
      rw [op_id, CategoryTheory.Functor.map_id] at e1
      have e2 := hcone 0 F F' h V O k'' hk'' U₄ (k₄ ≫ (h₄ ≫ h₃).left) hA t
      have e3 := hρ (σ 0 F) hcomp (by rw [hcomp]; exact hD) hD t
      have e4 := (σ 0 F).nat V V (𝟙 V) U₁ U₄ (c₄ ≫ c₂) k hk ((c₄ ≫ c₂).left ≫ k) hD
        (by show _ ≫ 𝟙 _ = _; rw [Category.comp_id]) t
      rw [op_id, CategoryTheory.Functor.map_id] at e4
      calc _ = _ := e0
        _ = _ := congrArg (fun z => (σ 0 F').ρ O₄ U₄ k₄ hk₄2
            (((wcInjAug (I F')).hom.app (Opposite.op O₄)).hom z)) hla.symm
        _ = _ := congrArg (fun z => (σ 0 F').ρ O₄ U₄ k₄ hk₄2 z) ea
        _ = _ := congrArg (fun z => (σ 0 F').ρ O₄ U₄ k₄ hk₄2
            ((((I F').cocomplex.X 0).obj.map h₄.op).hom z)) hl
        _ = _ := congrArg (fun z => (σ 0 F').ρ O₄ U₄ k₄ hk₄2 z)
            (e5 ((I F').cocomplex.X 0) h₄ h₃ _).symm
        _ = _ := e1
        _ = _ := e2.symm
        _ = _ := e3
        _ = _ := e4
        _ = _ := congrArg (fun z => ((K.X 0).obj.map (c₄ ≫ c₂).op).hom z) ht
        _ = _ := (e5 (K.X 0) (c₄ ≫ c₂) c₁ s).symm



  have hmono : Mono εK := by
    apply hS3
    intro U l hl u
    obtain ⟨U₁, c₁, u₁, a, hu₁, hla⟩ := hS6 (Spec (.of R)) U l u
    have h2 : (εK.hom.app (Opposite.op U₁)).hom
        (wcConstSec (Spec (.of R)) (ULift.{u+1} (ZMod m)) U₁ a) = 0 := by
