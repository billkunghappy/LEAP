  obtain ⟨φ, hφ, huniq⟩ := hr G' T'
  have hinv : ∀ (O : Z.Etale) (y : (L.obj ((constantSheaf (Scheme.smallEtaleTopology W)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.obj
