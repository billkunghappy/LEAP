    · intro l
      rw [Category.id_comp]



  have hδβ : δ ≫ β = fstR := by
    have hu : ∀ {l l₁ : Λ} (t : l ⟶ l₁),
        (fstR ≫ φ l) ≫ (W'.map t).right.left = fstR ≫ φ l₁ := by
      intro l l₁ t
      rw [Category.assoc, hcomp t]
    apply (hlim _ (fun l => fstR ≫ φ l) hu).unique
    · intro l
      haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
      apply s6 (TensorProduct A B A') (AlgebraicClosure (Y'.residueField y')) qb hqb0
        (W'.obj l).right.hom
      · simp only [Category.assoc]
        rw [hφa l, hβ₁, ← Category.assoc δ, hδ₁, hc₁]
      · simp only [Category.assoc]
        rw [← Category.assoc qb δ, hqbδ, ← Category.assoc q' β, hβq, ← Category.assoc qb fstR,
          hqb₁]
    · intro l
      rfl
  have hδγ : δ ≫ γ = 𝟙 _ := by
    apply hR.hom_ext
    · rw [Category.assoc, hγ₁, hδβ, Category.id_comp]
    · rw [Category.assoc, hγ₂, ← Category.assoc, hδ₁, hc₂, Category.id_comp]



  refine IsPullback.of_iso hR (Iso.mk δ γ hδγ hγδ) (Iso.refl _) (Iso.refl _) (Iso.refl _)
    ?_ ?_ ?_ ?_
  · show fstR ≫ 𝟙 _ = δ ≫ β
    rw [Category.comp_id, hδβ]
  · show sndR ≫ 𝟙 _ = δ ≫ a' ≫ π'
    rw [Category.comp_id, ← Category.assoc, hδ₁, hc₂]
  · show (a ≫ π) ≫ 𝟙 _ = 𝟙 _ ≫ (a ≫ π)
    rw [Category.comp_id, Category.id_comp]
  · show Spec.map (CommRingCat.ofHom f) ≫ 𝟙 _ = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom f)
    rw [Category.comp_id, Category.id_comp]

theorem wc_hal_shdata_integral_base_change : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] (f : A →+* A'), f.IsIntegral → ∃ (x' : wcHalA1 (Spec.map (CommRingCat.ofHom f) ≫ s)), IsClosed ({x'} : Set (wcHalA1 (Spec.map (CommRingCat.ofHom f) ≫ s))) ∧ wcHalA1Proj (Spec.map (CommRingCat.ofHom f) ≫ s) x' = IsLocalRing.closedPoint A' ∧ ∃ (B' : Type u) (_ : CommRing B') (_ : HenselianLocalRing B') (_ : IsSepClosed (IsLocalRing.ResidueField B')) (Λ' : Type u) (_ : SmallCategory Λ') (_ : IsCofiltered Λ') (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 (Spec.map (CommRingCat.ofHom f) ≫ s)) x')) (Scheme.Etale.forget (wcHalA1 (Spec.map (CommRingCat.ofHom f) ≫ s)))) (φ' : ∀ l, Spec (.of B') ⟶ (W''.obj l).right.left) (a' : Spec (.of B') ⟶ wcHalA1 (Spec.map (CommRingCat.ofHom f) ≫ s)) (β : Spec (.of B') ⟶ Spec (.of B)), wcHalShData x' B' Λ' W'' φ' a' ∧ IsPullback β (a' ≫ wcHalA1Proj (Spec.map (CommRingCat.ofHom f) ≫ s)) (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom f)) :=
by
  intro K _ A _ _ _ s x hx hxc B _ _ _ Λ _ _ W' φ a hd A' _ _ _ f hf
  obtain ⟨-, -, -, -, -, e, -, he⟩ := id hd
  obtain ⟨p, hp1, hp2⟩ : ∃ p : wcHalA1 (Spec.map (CommRingCat.ofHom f) ≫ s) ⟶ wcHalA1 s,
      p ≫ wcHalA1Proj s = wcHalA1Proj (Spec.map (CommRingCat.ofHom f) ≫ s) ≫
        Spec.map (CommRingCat.ofHom f) ∧
      p ≫ Limits.pullback.snd s (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
        Limits.pullback.snd (Spec.map (CommRingCat.ofHom f) ≫ s)
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
    ⟨Limits.pullback.lift
      (wcHalA1Proj (Spec.map (CommRingCat.ofHom f) ≫ s) ≫ Spec.map (CommRingCat.ofHom f))
      (Limits.pullback.snd (Spec.map (CommRingCat.ofHom f) ≫ s)
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
      (by rw [Category.assoc]; exact Limits.pullback.condition),
     Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hpb : IsPullback p (wcHalA1Proj (Spec.map (CommRingCat.ofHom f) ≫ s)) (wcHalA1Proj s)
      (Spec.map (CommRingCat.ofHom f)) := by
    refine IsPullback.of_right ?_ hp1 (IsPullback.of_hasPullback s _).flip
    rw [hp2]
    exact (IsPullback.of_hasPullback (Spec.map (CommRingCat.ofHom f) ≫ s) _).flip
  obtain ⟨x', hx', hxc', hpx⟩ := wc_hal_bc_closed_point A A' f hf (wcHalA1Proj s)
    (wcHalA1Proj (Spec.map (CommRingCat.ofHom f) ≫ s)) p hpb x hx hxc
  have hsep := wc_hal_a1_closed_point_residue_sepclosed K A'
    (Spec.map (CommRingCat.ofHom f) ≫ s) x' hx' hxc'

  have hfac : ∀ {Y Y' : Scheme.{u}} (p : Y' ⟶ Y) (y' : Y') (y : Y), p y' = y →
      ∃ ι : Spec (.of (AlgebraicClosure (Y'.residueField y'))) ⟶
        Spec (.of (AlgebraicClosure (Y.residueField y))),
        ι ≫ wcEtGeomPt Y y = wcEtGeomPt Y' y' ≫ p := by
    intro Y Y' p y' y hy
    subst hy
    letI : Algebra (Y.residueField (p y')) (AlgebraicClosure (Y'.residueField y')) :=
      ((algebraMap (Y'.residueField y') (AlgebraicClosure (Y'.residueField y'))).comp
        (p.residueFieldMap y').hom).toAlgebra
    let lam : AlgebraicClosure (Y.residueField (p y')) →ₐ[Y.residueField (p y')]
        AlgebraicClosure (Y'.residueField y') := IsAlgClosed.lift
    have h1 : (lam : AlgebraicClosure (Y.residueField (p y')) →+* _).comp
        (algebraMap (Y.residueField (p y')) (AlgebraicClosure (Y.residueField (p y')))) =
        (algebraMap (Y'.residueField y') (AlgebraicClosure (Y'.residueField y'))).comp
          (p.residueFieldMap y').hom := by
      ext z
      exact lam.commutes z
    refine ⟨Spec.map (CommRingCat.ofHom (lam : AlgebraicClosure (Y.residueField (p y')) →+* _)), ?_⟩
    unfold wcEtGeomPt
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, h1, CommRingCat.ofHom_comp,
      Spec.map_comp, Category.assoc, CommRingCat.ofHom_hom,
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, Category.assoc]
  obtain ⟨ι, hι⟩ := hfac p x' x hpx
  obtain ⟨B', iB1, iB2, iB3, Λ', iL1, iL2, W'', φ', a', e', hinit, haff, hcompat, hφa, hlim, hint,
    he'⟩ := wc_et_geom_strict_henselization x'
  have hd' : wcHalShData x' B' Λ' W'' φ' a' := ⟨hinit, haff, hcompat, hφa, hlim, e', hint, he'⟩
  have hres : ∀ z : Spec (.of (IsLocalRing.ResidueField B')),
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B'))) z = IsLocalRing.closedPoint B' :=
    fun z => IsLocalRing.PrimeSpectrum.comap_residue B' z
  have hK' : ∀ l, Spec.map (CommRingCat.ofHom e') ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) ≫ φ' l = (W''.obj l).hom.left := by
    intro l
    apply wc_geom_lift_eq_of_sepclosed x' hsep (W''.obj l).right.hom
    · simp only [Category.assoc, hφa l]
      exact he'
    · exact Over.w (W''.obj l).hom
    · refine Eq.trans ?_ (wc_shdata_closed_point_compat x' B' Λ' W'' φ' a' hd' l)
      exact congrArg (φ' l) (hres _)
  obtain ⟨β, hβ₁, hβ₂⟩ := wc_shdata_comparison_map p x x' ι hι B Λ W' φ a hd e he
    B' Λ' W'' φ' a' hd' e' hK'
  have hfin := wc_shdata_base_change_isPullback A A' f hf (wcHalA1Proj s)
    (wcHalA1Proj (Spec.map (CommRingCat.ofHom f) ≫ s)) p hpb x x' hxc hsep ι hι B Λ W' φ a hd e he
    B' Λ' W'' φ' a' hd' e' hK' β hβ₁ hβ₂
  exact ⟨x', hx', hxc', B', iB1, iB2, iB3, Λ', iL1, iL2, W'', φ', a', β, hd', hfin⟩

theorem wc_glc_closed_point_section : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f] (y : Y), IsClosed ({y} : Set Y) → ∃ y₀ : Spec (.of K) ⟶ Y, y₀ ≫ f = 𝟙 _ ∧ y₀ (IsLocalRing.closedPoint K) = y :=
by
  intro K _ _ Y f _ y hy
  haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace f
  haveI hι : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
    (isClosed_singleton_iff_locallyOfFiniteType).mp hy
  haveI hg : LocallyOfFiniteType (Y.fromSpecResidueField y ≫ f) := inferInstance
  let φ : CommRingCat.of K ⟶ Y.residueField y := Spec.preimage (Y.fromSpecResidueField y ≫ f)
  have hφg : Spec.map φ = Y.fromSpecResidueField y ≫ f := Spec.map_preimage _
  have hft : φ.hom.FiniteType := by
    have : LocallyOfFiniteType (Spec.map φ) := by rw [hφg]; exact hg
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
  letI : Algebra K (Y.residueField y) := φ.hom.toAlgebra
  haveI : Algebra.FiniteType K (Y.residueField y) := hft
  haveI : Module.Finite K (Y.residueField y) :=
    finite_of_finite_type_of_isJacobsonRing K (Y.residueField y)
  haveI : Algebra.IsIntegral K (Y.residueField y) := Algebra.IsIntegral.of_finite K _
  have hbij : Function.Bijective φ.hom :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := Y.residueField y)
  let e : K ≃+* Y.residueField y := RingEquiv.ofBijective φ.hom hbij
  let ψ : Y.residueField y ⟶ CommRingCat.of K :=
    CommRingCat.ofHom (e.symm : Y.residueField y →+* K)
  have hφψ : φ ≫ ψ = 𝟙 _ := by
    ext x
    change e.symm (φ.hom x) = x
    exact e.symm_apply_apply x
  refine ⟨Spec.map ψ ≫ Y.fromSpecResidueField y, ?_, ?_⟩
  · rw [Category.assoc, ← hφg, ← Spec.map_comp, hφψ, Spec.map_id]
  · exact Scheme.fromSpecResidueField_apply y _

theorem wc_hal_etale_section_through_closed_point : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [HenselianLocalRing A] [IsAlgClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (W : Scheme.{u}) (e : W ⟶ wcHalA1 s) [Etale e] (w : W), IsClosed ({e w} : Set (wcHalA1 s)) → wcHalA1Proj s (e w) = IsLocalRing.closedPoint A → ∃ σ : Spec (.of A) ⟶ W, σ ≫ e ≫ wcHalA1Proj s = 𝟙 _ ∧ σ (IsLocalRing.closedPoint A) = w :=
by
  intro K _ A _ _ _ s W e _ w hx hxc
  classical

  haveI : Algebra.Smooth K (Polynomial K) := ⟨inferInstance, inferInstance⟩
  haveI : Smooth (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
    exact RingHom.smooth_algebraMap.mpr inferInstance
  haveI : Smooth (wcHalA1Proj s) :=
    MorphismProperty.of_isPullback (P := @Smooth) (IsPullback.of_hasPullback _ _).flip inferInstance
  haveI : Smooth (e ≫ wcHalA1Proj s) := inferInstance
  let res : Spec (.of (IsLocalRing.ResidueField A)) ⟶ Spec (.of A) :=
    Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))
  have hres : ∀ q, res q = IsLocalRing.closedPoint A := fun q =>
    IsLocalRing.PrimeSpectrum.comap_residue A q

  haveI : IsClosedImmersion res :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI : IsClosedImmersion (Limits.pullback.fst (wcHalA1Proj s) res) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback (wcHalA1Proj s) res).flip inferInstance
  haveI : LocallyOfFiniteType (Limits.pullback.snd (wcHalA1Proj s) res) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
      (IsPullback.of_hasPullback (wcHalA1Proj s) res) inferInstance
  obtain ⟨y, hy1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := wcHalA1Proj s) (g := res)
    (e w) (IsLocalRing.closedPoint _) (hxc.trans (hres _).symm)
  have hyc : IsClosed ({y} : Set ↥(Limits.pullback (wcHalA1Proj s) res : Scheme.{u})) := by
    have hinj := (Scheme.Hom.isClosedEmbedding
      (Limits.pullback.fst (wcHalA1Proj s) res)).isEmbedding.injective
    have hset : ({y} : Set ↥(Limits.pullback (wcHalA1Proj s) res : Scheme.{u})) =
        (Limits.pullback.fst (wcHalA1Proj s) res) ⁻¹' {e w} := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact hy1
      · intro hz; exact hinj (hz.trans hy1.symm)
    rw [hset]
    exact hx.preimage (Limits.pullback.fst (wcHalA1Proj s) res).continuous
  obtain ⟨y0, hy0, hy0pt⟩ := wc_glc_closed_point_section (IsLocalRing.ResidueField A) _
    (Limits.pullback.snd (wcHalA1Proj s) res) y hyc
  let s0 := y0 ≫ Limits.pullback.fst (wcHalA1Proj s) res
  have hs0 : s0 ≫ wcHalA1Proj s = res := by
    simp only [s0]
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hy0, Category.id_comp]
  have hs0pt : s0 (IsLocalRing.closedPoint _) = e w :=
    (Scheme.Hom.comp_apply y0 (Limits.pullback.fst (wcHalA1Proj s) res) _).trans
      ((congrArg (Limits.pullback.fst (wcHalA1Proj s) res) hy0pt).trans hy1)

  obtain ⟨t, ht, htpt⟩ := wc_etale_lift_alg_closed_point (IsLocalRing.ResidueField A) e s0 w
    hs0pt.symm

  obtain ⟨R, fo, hfo, hmem, -⟩ := Scheme.exists_affine_mem_range_and_range_subset (U := ⊤)
    (x := t (IsLocalRing.closedPoint (IsLocalRing.ResidueField A))) trivial
  haveI := hfo
  have hrange : Set.range t ⊆ Set.range fo := by
    rintro _ ⟨q, rfl⟩
    rw [Subsingleton.elim q (IsLocalRing.closedPoint _)]
    exact hmem
  let t' := IsOpenImmersion.lift fo t hrange
  have ht' : t' ≫ fo = t := IsOpenImmersion.lift_fac fo t hrange
  haveI : Smooth (fo ≫ e ≫ wcHalA1Proj s) := inferInstance
  let φ := Spec.preimage (fo ≫ e ≫ wcHalA1Proj s)
  have hφ : Spec.map φ = fo ≫ e ≫ wcHalA1Proj s := Spec.map_preimage _
  letI : Algebra A R := φ.hom.toAlgebra
  haveI : Algebra.Smooth A R := by
    have h : Smooth (Spec.map φ) := by rw [hφ]; infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Smooth)] at h
    exact h
  let ψ := Spec.preimage t'
  have hψ : Spec.map ψ = t' := Spec.map_preimage _
  have hφψ : φ ≫ ψ = CommRingCat.ofHom (IsLocalRing.residue A) := by
    apply Spec.map_injective
    rw [Spec.map_comp, hψ, hφ, ← Category.assoc, ht', ← Category.assoc, ht, hs0]
  have hφψ' : ∀ a : A, ψ.hom (φ.hom a) = IsLocalRing.residue A a := fun a =>
    congrArg (fun f => f.hom a) hφψ
  let σbar : R →ₐ[A] IsLocalRing.ResidueField A :=
    { ψ.hom with
      commutes' := fun a => by
        rw [IsLocalRing.ResidueField.algebraMap_eq]
        exact hφψ' a }
  obtain ⟨τ, hτ⟩ := wc_hnas_smooth_section_henselian A R σbar
  let τ' : R ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : R →+* A)
  have hφτ : φ ≫ τ' = 𝟙 _ := by
    ext a
    exact τ.commutes a
  have hτres : τ' ≫ CommRingCat.ofHom (IsLocalRing.residue A) = ψ := by
    ext r
    exact hτ r
  refine ⟨Spec.map τ' ≫ fo, ?_, ?_⟩
  · rw [Category.assoc, ← hφ, ← Spec.map_comp, hφτ, Spec.map_id]
  · have h1 : res ≫ Spec.map τ' ≫ fo = t := by
      rw [← Category.assoc, ← Spec.map_comp, hτres, hψ, ht']
    let pt : Spec (.of (IsLocalRing.ResidueField A)) := IsLocalRing.closedPoint _
    have h2 : (res ≫ Spec.map τ' ≫ fo) pt = t pt :=
      congrArg (fun g : Spec (.of (IsLocalRing.ResidueField A)) ⟶ W => g pt) h1
    exact (congrArg (Spec.map τ' ≫ fo) (hres pt)).symm.trans
      ((Scheme.Hom.comp_apply res (Spec.map τ' ≫ fo) pt).symm.trans (h2.trans htpt))

theorem wc_gfc_basechange_fst_isOpenMap : ∀ (k : Type u) [Field k] (K : Type u) [Field K] [Algebra k K] [Algebra.IsAlgebraic k K] (X : Scheme.{u}) (f : X ⟶ Spec (.of k)), IsOpenMap (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :=
by
  intro k _ K _ _ _ X f

  have s1 : ∀ (K' : Type u) [Field K'] [Algebra k K'] [FiniteDimensional k K'] (R : Type u) [CommRing R]
      [Algebra k R], IsOpenMap (PrimeSpectrum.comap (algebraMap R (TensorProduct k R K'))) := by
    intro K' _ _ _ R _ _
    haveI : Algebra.FinitePresentation k K' :=
      (Algebra.FinitePresentation.of_finiteType).mp inferInstance
    haveI : Algebra.FinitePresentation R (TensorProduct k R K') :=
      Algebra.FinitePresentation.baseChange R
    exact PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation

  have s2 : ∀ (K' : IntermediateField k K) (R : Type u) [CommRing R] [Algebra k R],
      Function.Injective (Algebra.TensorProduct.map (AlgHom.id R R) K'.val :
        TensorProduct k R K' →ₐ[R] TensorProduct k R K) := by
    intro K' R _ _
    have hι : Function.Injective (K'.val.toLinearMap) := Subtype.val_injective
    have h := Module.Flat.lTensor_preserves_injective_linearMap (M := R) _ hι
    have heq : (⇑(Algebra.TensorProduct.map (AlgHom.id R R) K'.val :
        TensorProduct k R K' →ₐ[R] TensorProduct k R K)) = ⇑(LinearMap.lTensor R K'.val.toLinearMap) := by
      funext x
      induction x using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul r c => simp only [Algebra.TensorProduct.map_tmul, LinearMap.lTensor_tmul]; rfl
      | add x y hx hy => simp only [map_add, hx, hy]
    rw [heq]
    exact h

  have s3 : ∀ (K' : IntermediateField k K) (R : Type u) [CommRing R] [Algebra k R],
      (Algebra.TensorProduct.map (AlgHom.id R R) K'.val :
        TensorProduct k R K' →ₐ[R] TensorProduct k R K).toRingHom.IsIntegral := by
    intro K' R _ _
    set μ := (Algebra.TensorProduct.map (AlgHom.id R R) K'.val :
        TensorProduct k R K' →ₐ[R] TensorProduct k R K) with hμ
    have hc : μ.toRingHom.comp (algebraMap k (TensorProduct k R K')) =
        algebraMap k (TensorProduct k R K) := by
      ext a
      simp [hμ, Algebra.TensorProduct.algebraMap_apply]
    intro x
    induction x using TensorProduct.induction_on with
    | zero =>
      have h0 := RingHom.isIntegralElem_map μ.toRingHom (x := 0)
      rwa [map_zero] at h0
    | tmul r c =>
      have e : (r ⊗ₜ[k] c : TensorProduct k R K) = (r ⊗ₜ[k] (1 : K)) * ((1 : R) ⊗ₜ[k] c) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [e]
      refine RingHom.IsIntegralElem.mul _ ?_ ?_
      · have h1 : μ.toRingHom (r ⊗ₜ[k] (1 : K')) = r ⊗ₜ[k] (1 : K) := by
          simp [hμ]
        rw [← h1]
        exact RingHom.isIntegralElem_map _
      · obtain ⟨p, hp, hpc⟩ := (Algebra.IsIntegral.isIntegral (R := k) c)
        refine ⟨p.map (algebraMap k (TensorProduct k R K')), hp.map _, ?_⟩
        rw [Polynomial.eval₂_map, hc]
        have hg : (Algebra.TensorProduct.includeRight : K →ₐ[k] TensorProduct k R K).toRingHom.comp
            (algebraMap k K) = algebraMap k (TensorProduct k R K) := by
          ext a
          exact (Algebra.TensorProduct.includeRight : K →ₐ[k] TensorProduct k R K).commutes a
        have h2 := Polynomial.hom_eval₂ p (algebraMap k K)
          (Algebra.TensorProduct.includeRight : K →ₐ[k] TensorProduct k R K).toRingHom c
        rw [hg, hpc, map_zero] at h2
        simpa only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          Algebra.TensorProduct.includeRight_apply] using h2.symm
    | add x y hx hy => exact RingHom.IsIntegralElem.add _ hx hy

  have hincl : ∀ (R : Type u) [CommRing R] [Algebra k R] (A B : IntermediateField k K) (h : A ≤ B)
      (z : TensorProduct k R A),
      (Algebra.TensorProduct.map (AlgHom.id R R) B.val : TensorProduct k R B →ₐ[R] TensorProduct k R K)
        (Algebra.TensorProduct.map (AlgHom.id R R) (IntermediateField.inclusion h) z) =
      (Algebra.TensorProduct.map (AlgHom.id R R) A.val : TensorProduct k R A →ₐ[R] TensorProduct k R K) z := by
    intro R _ _ A B h z
    induction z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul r c => simp only [Algebra.TensorProduct.map_tmul]; rfl
    | add x y hx hy => simp only [map_add, hx, hy]
  have s4 : ∀ (R : Type u) [CommRing R] [Algebra k R] (F : TensorProduct k R K),
      ∃ K' : IntermediateField k K, FiniteDimensional k K' ∧ ∃ F' : TensorProduct k R K',
        (Algebra.TensorProduct.map (AlgHom.id R R) K'.val :
          TensorProduct k R K' →ₐ[R] TensorProduct k R K) F' = F := by
    intro R _ _ F
    induction F using TensorProduct.induction_on with
    | zero => exact ⟨⊥, inferInstance, 0, map_zero _⟩
    | tmul r c =>
      refine ⟨IntermediateField.adjoin k {c},
        IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral c),
        r ⊗ₜ ⟨c, IntermediateField.mem_adjoin_simple_self k c⟩, ?_⟩
      simp only [Algebra.TensorProduct.map_tmul]
      rfl
    | add x y hx hy =>
      obtain ⟨K₁, h₁, F₁, hF₁⟩ := hx
      obtain ⟨K₂, h₂, F₂, hF₂⟩ := hy
      refine ⟨K₁ ⊔ K₂, IntermediateField.finiteDimensional_sup K₁ K₂,
        Algebra.TensorProduct.map (AlgHom.id R R) (IntermediateField.inclusion le_sup_left) F₁ +
        Algebra.TensorProduct.map (AlgHom.id R R) (IntermediateField.inclusion le_sup_right) F₂, ?_⟩
      rw [map_add, hincl, hincl, hF₁, hF₂]

  have s5 : ∀ (R : Type u) [CommRing R] [Algebra k R],
      IsOpenMap (PrimeSpectrum.comap (algebraMap R (TensorProduct k R K))) := by
    intro R _ _
    rw [PrimeSpectrum.isTopologicalBasis_basic_opens.isOpenMap_iff]
    rintro _ ⟨F, rfl⟩
    obtain ⟨K', hK', F', hF'⟩ := s4 R F
    haveI := hK'
    set μ := (Algebra.TensorProduct.map (AlgHom.id R R) K'.val :
        TensorProduct k R K' →ₐ[R] TensorProduct k R K) with hμ
    have hsurj : Function.Surjective (PrimeSpectrum.comap μ.toRingHom) :=
      RingHom.IsIntegral.comap_surjective (s3 K' R) (s2 K' R)
    have hq : ∀ q, PrimeSpectrum.comap (algebraMap R (TensorProduct k R K)) q =
        PrimeSpectrum.comap (algebraMap R (TensorProduct k R K'))
          (PrimeSpectrum.comap μ.toRingHom q) := by
      intro q
      ext x
      simp only [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
      rw [← AlgHom.commutes μ x]
      rfl
    have hmem : ∀ q, PrimeSpectrum.comap μ.toRingHom q ∈ (PrimeSpectrum.basicOpen F' : Set _) ↔
        q ∈ (PrimeSpectrum.basicOpen F : Set _) := by
      intro q
      simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, PrimeSpectrum.comap_asIdeal,
        Ideal.mem_comap]
      rw [← hF']
      rfl
    have himg : PrimeSpectrum.comap (algebraMap R (TensorProduct k R K)) ''
        (PrimeSpectrum.basicOpen F : Set _) =
        PrimeSpectrum.comap (algebraMap R (TensorProduct k R K')) ''
        (PrimeSpectrum.basicOpen F' : Set _) := by
      ext p
      constructor
      · rintro ⟨q, hqF, rfl⟩
        exact ⟨_, (hmem q).mpr hqF, (hq q).symm⟩
      · rintro ⟨q', hq'F, rfl⟩
        obtain ⟨q, rfl⟩ := hsurj q'
        exact ⟨q, (hmem q).mp hq'F, hq q⟩
    rw [himg]
    exact s1 K' R _ (PrimeSpectrum.isOpen_basicOpen)

  have hop : ∀ {A B C : Scheme.{u}} (a : A ⟶ B) [IsIso a] (b : B ⟶ C), IsOpenMap b →
      IsOpenMap (a ≫ b) := by
    intro A B C a _ b hb
    have : ⇑(a ≫ b) = ⇑b ∘ ⇑a := funext (fun x => Scheme.Hom.comp_apply a b x)
    rw [this]
    exact hb.comp (Scheme.homeoOfIso (asIso a)).isOpenMap
  have key : ∀ (R : Type u) [CommRing R] (g : Spec (.of R) ⟶ X),
      IsOpenMap (Limits.pullback.snd
        (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) g) := by
    intro R _ g
    let ψ := Spec.preimage (g ≫ f)
    letI : Algebra k R := ψ.hom.toAlgebra
    have hψ : Spec.map (CommRingCat.ofHom (algebraMap k R)) = g ≫ f := by
      show Spec.map (CommRingCat.ofHom ψ.hom) = _
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    have h3 : (Limits.pullback.congrHom hψ.symm
        (rfl : Spec.map (CommRingCat.ofHom (algebraMap k K)) = _)).hom ≫
        Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap k R)))
          (Spec.map (CommRingCat.ofHom (algebraMap k K))) =
        Limits.pullback.fst (g ≫ f) (Spec.map (CommRingCat.ofHom (algebraMap k K))) := by
      rw [Limits.pullback.congrHom_hom]
      exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
    have hEq : Limits.pullback.snd
        (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) g =
        (Limits.pullbackSymmetry
          (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) g).hom ≫
        (Limits.pullbackRightPullbackFstIso f (Spec.map (CommRingCat.ofHom (algebraMap k K))) g).hom ≫
        (Limits.pullback.congrHom hψ.symm
          (rfl : Spec.map (CommRingCat.ofHom (algebraMap k K)) = _)).hom ≫
        (pullbackSpecIso k R K).hom ≫
        Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
      rw [pullbackSpecIso_hom_fst, h3, Limits.pullbackRightPullbackFstIso_hom_fst,
        Limits.pullbackSymmetry_hom_comp_fst]
    rw [hEq]
    refine hop _ _ (hop _ _ (hop _ _ (hop _ _ ?_)))
    have h1 : (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct k R K) =
        algebraMap R (TensorProduct k R K) := by
      ext r
      simp [Algebra.TensorProduct.algebraMap_apply]
    rw [h1]
    exact s5 R
  haveI := isOpenMap_isZariskiLocalAtTarget
  have hfin : topologically @IsOpenMap
      (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) := by
    apply IsZariskiLocalAtTarget.of_openCover X.affineOpenCover.openCover
    intro i
    exact key (X.affineOpenCover.X i) (X.affineOpenCover.openCover.f i)
  exact hfin

theorem wc_gfc_tensor_domain_fields_algClosed : ∀ (L : Type u) [Field L] [IsAlgClosed L] (K : Type u) [Field K] [Algebra L K] (M : Type u) [Field M] [Algebra L M], IsDomain (TensorProduct L K M) :=
by
  have main : ∀ (F R S : Type u) [Field F] [IsAlgClosed F] [CommRing R] [IsDomain R] [Algebra F R]
      [CommRing S] [IsDomain S] [Algebra F S], IsDomain (TensorProduct F R S) := by
    intro F R S _ _ _ _ _ _ _ _
    classical

    have s1 : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra F A] [Algebra.FiniteType F A]
        (r : A), r ≠ 0 → ∃ φ : A →ₐ[F] F, φ r ≠ 0 := by
      intro A _ _ _ _ r hr
      haveI : IsJacobsonRing A := isJacobsonRing_of_finiteType (A := F)
      have hj : (⊥ : Ideal A).jacobson = ⊥ :=
        IsJacobsonRing.out' _ (Ideal.isRadical_bot_iff.mpr inferInstance)
      have hr' : r ∉ (⊥ : Ideal A).jacobson := by
        rw [hj, Ideal.mem_bot]; exact hr
      rw [Ideal.jacobson, Ideal.mem_sInf] at hr'
      push_neg at hr'
      obtain ⟨M, ⟨-, hM⟩, hrM⟩ := hr'
      haveI := hM
      letI : Field (A ⧸ M) := Ideal.Quotient.field M
      haveI : Algebra.FiniteType F (A ⧸ M) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ F M)
          (Ideal.Quotient.mkₐ_surjective F M)
      haveI : Module.Finite F (A ⧸ M) := finite_of_finite_type_of_isJacobsonRing F (A ⧸ M)
      haveI : Algebra.IsIntegral F (A ⧸ M) := Algebra.IsIntegral.of_finite F _
      have hb : Function.Bijective (algebraMap F (A ⧸ M)) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      let e : F ≃ₐ[F] A ⧸ M := AlgEquiv.ofBijective (Algebra.ofId F (A ⧸ M)) hb
      refine ⟨e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ F M), ?_⟩
      intro h0
      apply hrM
      have h1 : Ideal.Quotient.mkₐ F M r = 0 := by
        have h2 := congrArg e h0
        simpa using h2
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1

    have s2 : ∀ z : TensorProduct F R S, ∃ T : Finset R, ∀ A : Subalgebra F R, (↑T : Set R) ⊆ A →
        ∃ w : TensorProduct F A S, Algebra.TensorProduct.map A.val (AlgHom.id F S) w = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨∅, fun A _ => ⟨0, map_zero _⟩⟩
      | tmul r s =>
        refine ⟨{r}, fun A hA => ⟨(⟨r, hA (Finset.mem_singleton_self r)⟩ : A) ⊗ₜ[F] s, ?_⟩⟩
        rw [Algebra.TensorProduct.map_tmul]
        rfl
      | add z₁ z₂ h₁ h₂ =>
        obtain ⟨T₁, hT₁⟩ := h₁
        obtain ⟨T₂, hT₂⟩ := h₂
        refine ⟨T₁ ∪ T₂, fun A hA => ?_⟩
        obtain ⟨w₁, hw₁⟩ := hT₁ A (fun t ht => hA (Finset.mem_union_left T₂ ht))
        obtain ⟨w₂, hw₂⟩ := hT₂ A (fun t ht => hA (Finset.mem_union_right T₁ ht))
        exact ⟨w₁ + w₂, by rw [map_add, hw₁, hw₂]⟩

    have s3 : ∀ (A : Type u) [CommRing A] [Algebra F A] (z : TensorProduct F A S), z ≠ 0 →
        ∃ r : A, r ≠ 0 ∧ ∀ φ : A →ₐ[F] F, φ r ≠ 0 →
          Algebra.TensorProduct.productMap ((Algebra.ofId F S).comp φ) (AlgHom.id F S) z ≠ 0 := by
      intro A _ _ z hz
      let b := Module.Basis.ofVectorSpace F S
      let B := Algebra.TensorProduct.basis A b
      have hc : B.repr z ≠ 0 := by
        intro h
        apply hz
        exact (LinearEquiv.map_eq_zero_iff B.repr).mp h
      obtain ⟨i, hi⟩ : ∃ i, B.repr z i ≠ 0 := by
        by_contra h
        push_neg at h
        exact hc (Finsupp.ext h)
      refine ⟨B.repr z i, hi, fun φ hφ h0 => hφ ?_⟩
      have key : ∀ w : TensorProduct F A S,
          b.repr (Algebra.TensorProduct.productMap ((Algebra.ofId F S).comp φ) (AlgHom.id F S) w) i
            = φ (B.repr w i) := by
        intro w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul a m =>
          have e1 : ((Algebra.ofId F S).comp φ) a * (AlgHom.id F S) m = φ a • m := by
            rw [Algebra.smul_def]; rfl
          rw [Algebra.TensorProduct.productMap_apply_tmul, e1, map_smul, Finsupp.smul_apply,
            smul_eq_mul, Algebra.TensorProduct.basis_repr_tmul, Finsupp.smul_apply,
            Finsupp.mapRange_apply, smul_eq_mul, map_mul, AlgHom.commutes]
          simp
        | add w₁ w₂ h₁ h₂ => simp only [map_add, Finsupp.add_apply, h₁, h₂]
      rw [← key, h0]
      simp

    have hinj : ∀ A : Subalgebra F R,
        Function.Injective (Algebra.TensorProduct.map A.val (AlgHom.id F S)) := by
      intro A
      have h : ⇑(Algebra.TensorProduct.map A.val (AlgHom.id F S)) =
          ⇑(LinearMap.rTensor S A.val.toLinearMap) := by
        funext w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul a s => rw [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul]; rfl
        | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂]
      rw [h]
      exact Module.Flat.rTensor_preserves_injective_linearMap _ Subtype.val_injective

    haveI : Nontrivial (TensorProduct F R S) :=
      (Algebra.TensorProduct.includeLeft_injective (R := F) (S := F) (A := R) (B := S)
        (algebraMap F S).injective).nontrivial
    haveI : NoZeroDivisors (TensorProduct F R S) := by
      constructor
      intro x y hxy
      by_contra hne
      push_neg at hne
      obtain ⟨hx, hy⟩ := hne
      obtain ⟨Tx, hTx⟩ := s2 x
      obtain ⟨Ty, hTy⟩ := s2 y
      obtain ⟨A, hAx, hAy, hAfg⟩ : ∃ A : Subalgebra F R, (↑Tx : Set R) ⊆ A ∧ (↑Ty : Set R) ⊆ A ∧
          A.FG :=
        ⟨Algebra.adjoin F (↑(Tx ∪ Ty) : Set R),
          fun t ht => Algebra.subset_adjoin (Finset.mem_union_left Ty ht),
          fun t ht => Algebra.subset_adjoin (Finset.mem_union_right Tx ht),
          Subalgebra.fg_adjoin_finset _⟩
      obtain ⟨x₀, hx₀⟩ := hTx A hAx
      obtain ⟨y₀, hy₀⟩ := hTy A hAy
      have hx0 : x₀ ≠ 0 := by
        rintro rfl
        exact hx (by rw [← hx₀, map_zero])
      have hy0 : y₀ ≠ 0 := by
        rintro rfl
        exact hy (by rw [← hy₀, map_zero])
      have hxy0 : x₀ * y₀ = 0 := hinj A (by rw [map_mul, hx₀, hy₀, hxy, map_zero])
      haveI : Algebra.FiniteType F A := (Subalgebra.fg_iff_finiteType A).mp hAfg
      obtain ⟨r₁, hr₁, H₁⟩ := s3 A x₀ hx0
      obtain ⟨r₂, hr₂, H₂⟩ := s3 A y₀ hy0
      obtain ⟨φ, hφ⟩ := s1 A (r₁ * r₂) (mul_ne_zero hr₁ hr₂)
      rw [map_mul] at hφ
      have h1 := H₁ φ (left_ne_zero_of_mul hφ)
      have h2 := H₂ φ (right_ne_zero_of_mul hφ)
      apply mul_ne_zero h1 h2
      rw [← map_mul, hxy0, map_zero]
    exact NoZeroDivisors.to_isDomain _
  intro L _ _ K _ _ M _ _
  exact main L K M

theorem wc_geom_fibres_connected_of_top_fibres_connected : ∀ (A : Type u) [CommRing A] (V : Scheme.{u}) (g : V ⟶ Spec (.of A)) (τ : Spec (.of A) ⟶ V), τ ≫ g = 𝟙 _ → (∀ s : Spec (.of A), _root_.IsConnected (g ⁻¹' {s})) → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), ConnectedSpace ↥(Limits.pullback g z) :=
by

  have transport : ∀ {α β : Type u} [TopologicalSpace α] [TopologicalSpace β] (e : α ≃ₜ β),
      ConnectedSpace α → ConnectedSpace β := by
    intro α β _ _ e hα
    have h := isConnected_range e.continuous
    rw [e.range_coe] at h
    exact connectedSpace_iff_univ.mpr h
  have domain_conn : ∀ (R : Type u) [CommRing R], IsDomain R → ConnectedSpace (PrimeSpectrum R) := by
    intro R _ hR
    haveI := hR
    haveI : IrreducibleSpace (PrimeSpectrum R) := PrimeSpectrum.irreducibleSpace
    exact IrreducibleSpace.connectedSpace _

  have wc_gfc_basechange_fibre_homeo : ∀ (L : Type u) [Field L] (M : Type u) [Field M] [Algebra L M]
      (Y : Scheme.{u}) (h : Y ⟶ Spec (.of L)) (y : Y) [Algebra L (Y.residueField y)],
      Spec.map (CommRingCat.ofHom (algebraMap L (Y.residueField y))) = Y.fromSpecResidueField y ≫ h →
      Nonempty (↥((Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap L M)))) ⁻¹' {y}) ≃ₜ
        PrimeSpectrum (TensorProduct L (Y.residueField y) M)) := by
    intro L _ M _ _ Y h y _ hy
    exact ⟨((Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap L M)))).fiberHomeo y).symm.trans
      ((Scheme.homeoOfIso (Limits.pullbackSymmetry _ _ ≪≫ Limits.pullbackRightPullbackFstIso h
        (Spec.map (CommRingCat.ofHom (algebraMap L M))) (Y.fromSpecResidueField y) ≪≫
        Limits.pullback.congrHom hy.symm rfl ≪≫ pullbackSpecIso L (Y.residueField y) M)).trans
        (Homeomorph.refl _))⟩

  have top_lemma : ∀ {Y X : Type u} [TopologicalSpace Y] [TopologicalSpace X] (p : Y → X),
      IsOpenMap p → IsClosedMap p → Function.Surjective p → ConnectedSpace X →
      ∀ x : X, (p ⁻¹' {x}).Subsingleton → ConnectedSpace Y := by
    intro Y X _ _ p hpo hpc hps hX x hx
    obtain ⟨x'⟩ := hX.toNonempty
    obtain ⟨y', -⟩ := hps x'
    refine connectedSpace_iff_clopen.mpr ⟨⟨y'⟩, fun U hU => ?_⟩
    by_contra hne
    have hU0 : U.Nonempty := Set.nonempty_iff_ne_empty.mpr (fun h => hne (Or.inl h))
    have hU1 : U ≠ Set.univ := fun h => hne (Or.inr h)
    have himg : ∀ W : Set Y, IsClopen W → W.Nonempty → p '' W = Set.univ := by
      intro W hW hWn
      rcases isClopen_iff.mp ⟨hpc _ hW.isClosed, hpo _ hW.isOpen⟩ with h | h
      · exact absurd h (hWn.image p).ne_empty
      · exact h
    have h1 : x ∈ p '' U := by
      rw [himg U hU hU0]; trivial
    have hUc : (Uᶜ).Nonempty := Set.nonempty_compl.mpr hU1
    have h2 : x ∈ p '' Uᶜ := by
      rw [himg _ hU.compl hUc]; trivial
    obtain ⟨u, hu, hpu⟩ := h1
    obtain ⟨w, hw, hpw⟩ := h2
    have huw : u = w := hx hpu hpw
    exact hw (huw ▸ hu)

  have stage2 : ∀ (L : Type u) [Field L] (M : Type u) [Field M] [Algebra L M] (Y : Scheme.{u})
      (h : Y ⟶ Spec (.of L)) [ConnectedSpace Y],
      (∀ y : Y, _root_.IsConnected
        ((Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap L M)))) ⁻¹' {y})) →
      ConnectedSpace ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap L M)))) := by
    intro L _ M _ _ Y h _ hfib
    have hq := Flat.isQuotientMap_of_surjective
      (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap L M))))
    have hc := hq.isCoinducing.isConnected_preimage_of_isClosed hfib isClosed_univ isConnected_univ
    rw [Set.preimage_univ] at hc
    exact connectedSpace_iff_univ.mpr hc

  have rational_bij : ∀ (L : Type u) [Field L] (X : Scheme.{u}) (f : X ⟶ Spec (.of L))
      (x₀ : Spec (.of L) ⟶ X), x₀ ≫ f = 𝟙 _ →
      ∀ (θ : L →+* X.residueField (x₀ (IsLocalRing.closedPoint L))),
      Spec.map (CommRingCat.ofHom θ) =
        X.fromSpecResidueField (x₀ (IsLocalRing.closedPoint L)) ≫ f → Function.Bijective θ := by
    intro L _ X f x₀ hx₀ θ hθ
    obtain ⟨ψ, hψ⟩ : ∃ ψ : X.residueField (x₀ (IsLocalRing.closedPoint L)) ⟶ CommRingCat.of L,
        x₀ = Spec.map ψ ≫ X.fromSpecResidueField (x₀ (IsLocalRing.closedPoint L)) := by
      refine ⟨(Scheme.SpecToEquivOfField L X x₀).2, ?_⟩
      conv_lhs => rw [← (Scheme.SpecToEquivOfField L X).symm_apply_apply x₀]
      rfl
    have hcomp : CommRingCat.ofHom θ ≫ ψ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_id, hθ, ← Category.assoc, ← hψ, hx₀]
    have h1 : ∀ a, ψ.hom (θ a) = a := by
      intro a
      have := congrArg (fun φ => φ.hom a) hcomp
      simpa using this
    refine ⟨fun a b hab => by rw [← h1 a, ← h1 b, hab], fun t => ⟨ψ.hom t, ?_⟩⟩
    apply ψ.hom.injective
    rw [h1]

  have G : ∀ (k : Type u) [Field k] (X : Scheme.{u}) (f : X ⟶ Spec (.of k))
      (x₀ : Spec (.of k) ⟶ X), x₀ ≫ f = 𝟙 _ → ConnectedSpace X →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra k Ω],
      ConnectedSpace ↥(Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap k Ω)))) := by
    intro k _ X f x₀ hx₀ hX Ω _ _ _

    have hopen : IsOpenMap (Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
      wc_gfc_basechange_fst_isOpenMap k (AlgebraicClosure k) X f
    haveI : IsIntegralHom (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) := by
      rw [IsIntegralHom.SpecMap_iff]
      simp only [CommRingCat.hom_ofHom]
      exact (algebraMap_isIntegral_iff).mpr Algebra.IsAlgebraic.isIntegral
    have hclosed : IsClosedMap (Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
      (Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))).isClosedMap
    have hsurj : Function.Surjective (Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
      Surjective.surj
    have hsub : ((Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) ⁻¹'
          {x₀ (IsLocalRing.closedPoint k)}).Subsingleton := by
      let θ := Spec.preimage (X.fromSpecResidueField (x₀ (IsLocalRing.closedPoint k)) ≫ f)
      letI : Algebra k (X.residueField (x₀ (IsLocalRing.closedPoint k))) := θ.hom.toAlgebra
      have hθ : Spec.map (CommRingCat.ofHom (algebraMap k
          (X.residueField (x₀ (IsLocalRing.closedPoint k))))) =
          X.fromSpecResidueField (x₀ (IsLocalRing.closedPoint k)) ≫ f := by
        show Spec.map (CommRingCat.ofHom θ.hom) = _
        rw [CommRingCat.ofHom_hom, Spec.map_preimage]
      obtain ⟨e⟩ := wc_gfc_basechange_fibre_homeo k (AlgebraicClosure k) X f
        (x₀ (IsLocalRing.closedPoint k)) hθ
      have hbij : Function.Bijective (algebraMap k
          (X.residueField (x₀ (IsLocalRing.closedPoint k)))) :=
        rational_bij k X f x₀ hx₀ θ.hom hθ
      let e1 : k ≃ₐ[k] X.residueField (x₀ (IsLocalRing.closedPoint k)) :=
        AlgEquiv.ofBijective (Algebra.ofId k _) hbij
      let e2 : TensorProduct k (X.residueField (x₀ (IsLocalRing.closedPoint k)))
          (AlgebraicClosure k) ≃ₐ[k] AlgebraicClosure k :=
        (Algebra.TensorProduct.congr e1.symm AlgEquiv.refl).trans
          (Algebra.TensorProduct.lid k (AlgebraicClosure k))
      have hinj := PrimeSpectrum.comap_injective_of_surjective e2.symm.toAlgHom.toRingHom
        e2.symm.surjective
      haveI : Subsingleton (PrimeSpectrum (TensorProduct k
          (X.residueField (x₀ (IsLocalRing.closedPoint k))) (AlgebraicClosure k))) :=
        hinj.subsingleton
      haveI := e.injective.subsingleton
      exact (Set.subsingleton_coe _).mp this
    haveI hXK : ConnectedSpace ↥(Limits.pullback f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) :=
      top_lemma _ hopen hclosed hsurj hX _ hsub

    let e : AlgebraicClosure k →ₐ[k] Ω := IsAlgClosed.lift
    letI : Algebra (AlgebraicClosure k) Ω := e.toRingHom.toAlgebra
    have hfibK : ∀ y : ↥(Limits.pullback f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))),
        _root_.IsConnected ((Limits.pullback.fst (Limits.pullback.snd f
          (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))))
          (Spec.map (CommRingCat.ofHom (algebraMap (AlgebraicClosure k) Ω)))) ⁻¹' {y}) := by
      intro y
      let θ := Spec.preimage ((Limits.pullback f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))).fromSpecResidueField y ≫
          Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))))
      letI : Algebra (AlgebraicClosure k) ((Limits.pullback f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))).residueField y) :=
        θ.hom.toAlgebra
      have hθ : Spec.map (CommRingCat.ofHom (algebraMap (AlgebraicClosure k) ((Limits.pullback f
          (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))).residueField y))) =
          (Limits.pullback f
            (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))).fromSpecResidueField y ≫
          Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) := by
        show Spec.map (CommRingCat.ofHom θ.hom) = _
        rw [CommRingCat.ofHom_hom, Spec.map_preimage]
      obtain ⟨e'⟩ := wc_gfc_basechange_fibre_homeo (AlgebraicClosure k) Ω _ _ y hθ
      have hdom := wc_gfc_tensor_domain_fields_algClosed (AlgebraicClosure k) ((Limits.pullback f
        (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))).residueField y) Ω
      exact isConnected_iff_connectedSpace.mpr (transport e'.symm (domain_conn _ hdom))
    have hΩK := stage2 (AlgebraicClosure k) Ω _ (Limits.pullback.snd f
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) hfibK
    have hι : Spec.map (CommRingCat.ofHom (algebraMap (AlgebraicClosure k) Ω)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) =
        Spec.map (CommRingCat.ofHom (algebraMap k Ω)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      ext a
      exact e.commutes a
    exact transport (Scheme.homeoOfIso (Limits.pullbackLeftPullbackSndIso f
      (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))
      (Spec.map (CommRingCat.ofHom (algebraMap (AlgebraicClosure k) Ω))) ≪≫
        Limits.pullback.congrHom rfl hι)) hΩK

  intro A _ V g τ hτ hfib Ω _ _ z
  obtain ⟨φ, hφ⟩ : ∃ φ : (Spec (.of A)).residueField (z (IsLocalRing.closedPoint Ω)) ⟶
      CommRingCat.of Ω,
      z = Spec.map φ ≫ (Spec (.of A)).fromSpecResidueField (z (IsLocalRing.closedPoint Ω)) := by
    refine ⟨(Scheme.SpecToEquivOfField Ω (Spec (.of A)) z).2, ?_⟩
    conv_lhs => rw [← (Scheme.SpecToEquivOfField Ω (Spec (.of A))).symm_apply_apply z]
    rfl
  letI : Algebra ((Spec (.of A)).residueField (z (IsLocalRing.closedPoint Ω))) Ω :=
    φ.hom.toAlgebra
  have hz : Spec.map (CommRingCat.ofHom (algebraMap
      ((Spec (.of A)).residueField (z (IsLocalRing.closedPoint Ω))) Ω)) ≫
      (Spec (.of A)).fromSpecResidueField (z (IsLocalRing.closedPoint Ω)) = z := by
    refine Eq.trans ?_ hφ.symm
    rfl
  haveI : ConnectedSpace ↥(g ⁻¹' {z (IsLocalRing.closedPoint Ω)}) :=
    isConnected_iff_connectedSpace.mp (hfib _)
  have hF : ConnectedSpace ↥(Limits.pullback g
      ((Spec (.of A)).fromSpecResidueField (z (IsLocalRing.closedPoint Ω)))) :=
    transport (g.fiberHomeo (z (IsLocalRing.closedPoint Ω))).symm inferInstance
  have hw : ((Spec (.of A)).fromSpecResidueField (z (IsLocalRing.closedPoint Ω)) ≫ τ) ≫ g =
      𝟙 _ ≫ (Spec (.of A)).fromSpecResidueField (z (IsLocalRing.closedPoint Ω)) := by
    rw [Category.assoc, hτ, Category.comp_id, Category.id_comp]
  have hG := G ((Spec (.of A)).residueField (z (IsLocalRing.closedPoint Ω))) _
    (Limits.pullback.snd g ((Spec (.of A)).fromSpecResidueField (z (IsLocalRing.closedPoint Ω))))
    (Limits.pullback.lift _ _ hw) (Limits.pullback.lift_snd _ _ _) hF Ω
  exact transport (Scheme.homeoOfIso (Limits.pullbackLeftPullbackSndIso g
    ((Spec (.of A)).fromSpecResidueField (z (IsLocalRing.closedPoint Ω)))
    (Spec.map (CommRingCat.ofHom (algebraMap
      ((Spec (.of A)).residueField (z (IsLocalRing.closedPoint Ω))) Ω))) ≪≫
      Limits.pullback.congrHom rfl hz)) hG

theorem wc_x0_baseChange_preimage : ∀ (X Y X' Y' : Scheme.{u}) (f : X ⟶ Y) [LocallyOfFiniteType f] (σ : Y ⟶ X), σ ≫ f = 𝟙 _ → ∀ (g : Y' ⟶ Y) (f' : X' ⟶ Y') (g' : X' ⟶ X) (σ' : Y' ⟶ X'), IsPullback g' f' f g → σ' ≫ f' = 𝟙 _ → σ' ≫ g' = g ≫ σ → ∀ x' : X', (x' ∈ connectedComponentIn (f' ⁻¹' {f' x'}) (σ' (f' x')) ↔ g' x' ∈ connectedComponentIn (f ⁻¹' {f (g' x')}) (σ (f (g' x')))) :=
by
  intro X Y X' Y' f _ σ hσ g f' g' σ' hpb hσ' hσσ' x'

  have partA : ∀ (Z : Scheme.{u}) [IsLocallyNoetherian Z], LocallyConnectedSpace Z := by
    intro Z _
    have hT : ∀ (T : Type u) [TopologicalSpace T] [TopologicalSpace.NoetherianSpace T] (t : T),
        IsOpen (connectedComponent t) := by
      intro T _ _ t
      let S := {C ∈ irreducibleComponents T | Disjoint C (connectedComponent t)}
      have hSf : S.Finite :=
        TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset (fun C hC => hC.1)
      have hcl : IsClosed (⋃₀ S) :=
        hSf.isClosed_sUnion (fun C hC => isClosed_of_mem_irreducibleComponents C hC.1)
      have heq : (connectedComponent t)ᶜ = ⋃₀ S := by
        ext a
        constructor
        · intro ha
          have hau : a ∈ ⋃₀ irreducibleComponents T := by
            rw [sUnion_irreducibleComponents]; trivial
          obtain ⟨C, hC, haC⟩ := hau
          refine ⟨C, ⟨hC, ?_⟩, haC⟩
          rw [Set.disjoint_left]
          intro b hbC hbK
          apply ha
          have h1 : C ⊆ connectedComponent b :=
            hC.1.isConnected.isPreconnected.subset_connectedComponent hbC
          rw [← connectedComponent_eq hbK] at h1
          exact h1 haC
        · rintro ⟨C, ⟨_, hd⟩, haC⟩ haK
          exact Set.disjoint_left.mp hd haC haK
      rw [← isClosed_compl_iff, heq]
      exact hcl
    rw [locallyConnectedSpace_iff_subsets_isOpen_isConnected]
    intro x U hU
    obtain ⟨t, htU, hto, hxt⟩ := mem_nhds_iff.mp hU
    obtain ⟨W, hW, hxW, hWt⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens Z) (show x ∈ (⟨t, hto⟩ : TopologicalSpace.Opens Z) from hxt)
    haveI := IsLocallyNoetherian.component_noetherian (X := Z) ⟨W, hW⟩
    haveI : TopologicalSpace.NoetherianSpace W := noetherianSpace_of_isAffineOpen W hW
    refine ⟨Subtype.val '' connectedComponent (⟨x, hxW⟩ : W), ?_, ?_, ?_, ?_⟩
    · rintro _ ⟨p, _, rfl⟩
      exact htU (hWt p.2)
    · exact W.isOpen.isOpenMap_subtype_val _ (hT W _)
    · exact ⟨⟨x, hxW⟩, mem_connectedComponent, rfl⟩
    · exact isConnected_connectedComponent.image _ continuous_subtype_val.continuousOn

  have hsurj : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f₁ : A ⟶ S} {g₁ : B ⟶ S},
      IsPullback fst snd f₁ g₁ → ∀ a b, f₁ a = g₁ b → ∃ p, fst p = a ∧ snd p = b := by
    intro P A B S fst snd f₁ g₁ hP a b hab
    obtain ⟨t, ht1, ht2⟩ := Scheme.Pullback.exists_preimage_pullback a b hab
    refine ⟨hP.isoPullback.inv t, ?_, ?_⟩
    · rw [← Scheme.Hom.comp_apply, hP.isoPullback_inv_fst, ht1]
    · rw [← Scheme.Hom.comp_apply, hP.isoPullback_inv_snd, ht2]

  have hP1 : ∀ z' : X', f (g' z') = g (f' z') := by
    intro z'
    rw [← Scheme.Hom.comp_apply, hpb.w, Scheme.Hom.comp_apply]
  have hP2 : ∀ t : Y', g' (σ' t) = σ (g t) := by
    intro t
    rw [← Scheme.Hom.comp_apply, hσσ', Scheme.Hom.comp_apply]
  have hP3 : ∀ t : Y, f (σ t) = t := by
    intro t
    have h := congrArg (fun k : Y ⟶ Y => k t) hσ
    exact (Scheme.Hom.comp_apply σ f t).symm.trans h
  have hP3' : ∀ t : Y', f' (σ' t) = t := by
    intro t
    have h := congrArg (fun k : Y' ⟶ Y' => k t) hσ'
    exact (Scheme.Hom.comp_apply σ' f' t).symm.trans h
  rw [hP1 x']
  generalize hy' : f' x' = y'
  constructor
  ·
    intro hx
    have hK'pre : _root_.IsPreconnected (g' '' connectedComponentIn (f' ⁻¹' {y'}) (σ' y')) :=
      isPreconnected_connectedComponentIn.image _ g'.continuous.continuousOn
    have hsub : g' '' connectedComponentIn (f' ⁻¹' {y'}) (σ' y') ⊆ f ⁻¹' {g y'} := by
      rintro _ ⟨z, hz, rfl⟩
      have hz1 : z ∈ f' ⁻¹' {y'} := connectedComponentIn_subset (f' ⁻¹' {y'}) (σ' y') hz
      have hz' : f' z = y' := hz1
      show f (g' z) = g y'
      rw [hP1, hz']
    have hmem : σ (g y') ∈ g' '' connectedComponentIn (f' ⁻¹' {y'}) (σ' y') :=
      ⟨σ' y', mem_connectedComponentIn (hP3' y'), hP2 y'⟩
    exact hK'pre.subset_connectedComponentIn hmem hsub ⟨x', hx, rfl⟩
  ·
    intro hx
    haveI : LocallyOfFiniteType (f.fiberToSpecResidueField (g y')) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
        (IsPullback.of_hasPullback f (Y.fromSpecResidueField (g y'))) inferInstance
    haveI : IsLocallyNoetherian (f.fiber (g y')) :=
      LocallyOfFiniteType.isLocallyNoetherian (f.fiberToSpecResidueField (g y'))
    haveI : LocallyConnectedSpace (f.fiber (g y')) := partA _
    have hF : IsPullback (f.fiberι (g y')) (f.fiberToSpecResidueField (g y')) f
        (Y.fromSpecResidueField (g y')) := IsPullback.of_hasPullback f (Y.fromSpecResidueField (g y'))
    have hιinj : Function.Injective (f.fiberι (g y')) := by
      intro a b hab
      apply (f.fiberHomeo (g y')).injective
      apply Subtype.ext
      rw [Scheme.Hom.fiberHomeo_apply, Scheme.Hom.fiberHomeo_apply]
      exact hab

    have hσy : σ (g y') ∈ f ⁻¹' {g y'} := hP3 (g y')
    have hVOC : IsOpen ((f.fiberι (g y')) ⁻¹' connectedComponentIn (f ⁻¹' {g y'}) (σ (g y'))) ∧
        _root_.IsConnected ((f.fiberι (g y')) ⁻¹' connectedComponentIn (f ⁻¹' {g y'}) (σ (g y'))) := by
      haveI : LocallyConnectedSpace ↑(f ⁻¹' {g y'}) :=
        (f.fiberHomeo (g y')).symm.locallyConnectedSpace
      have hpre : (f.fiberι (g y')) ⁻¹' connectedComponentIn (f ⁻¹' {g y'}) (σ (g y')) =
          (f.fiberHomeo (g y')) ⁻¹' connectedComponent ⟨σ (g y'), hσy⟩ := by
        ext p
        simp only [Set.mem_preimage]
        rw [connectedComponentIn_eq_image hσy, ← Scheme.Hom.fiberHomeo_apply f (g y') p]
        exact Subtype.val_injective.mem_set_image
      rw [hpre]
      exact ⟨isOpen_connectedComponent.preimage (f.fiberHomeo (g y')).continuous,
        (f.fiberHomeo (g y')).isConnected_preimage.mpr isConnected_connectedComponent⟩
    obtain ⟨hVo, hVc⟩ := hVOC
    let V : (f.fiber (g y')).Opens := ⟨_, hVo⟩
    have hVmem : ∀ p, p ∈ V ↔ f.fiberι (g y') p ∈ connectedComponentIn (f ⁻¹' {g y'}) (σ (g y')) :=
      fun _ => Iff.rfl

    have hw0 : (Y.fromSpecResidueField (g y') ≫ σ) ≫ f = 𝟙 _ ≫ Y.fromSpecResidueField (g y') := by
      rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]
    obtain ⟨σF, hσF1, hσF2⟩ : ∃ σF : Spec (Y.residueField (g y')) ⟶ f.fiber (g y'),
        σF ≫ f.fiberι (g y') = Y.fromSpecResidueField (g y') ≫ σ ∧
        σF ≫ f.fiberToSpecResidueField (g y') = 𝟙 _ :=
      ⟨hF.lift _ _ hw0, hF.lift_fst _ _ _, hF.lift_snd _ _ _⟩
    have hσFV : Set.range σF ⊆ Set.range V.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨s, rfl⟩
      show f.fiberι (g y') (σF s) ∈ connectedComponentIn (f ⁻¹' {g y'}) (σ (g y'))
      have e : f.fiberι (g y') (σF s) = σ (g y') := by
        rw [← Scheme.Hom.comp_apply σF (f.fiberι (g y')), hσF1, Scheme.Hom.comp_apply,
          Scheme.fromSpecResidueField_apply]
      rw [e]
      exact mem_connectedComponentIn hσy
    obtain ⟨τ, hτ⟩ : ∃ τ, τ ≫ V.ι = σF := ⟨_, IsOpenImmersion.lift_fac V.ι σF hσFV⟩
    have hτg : τ ≫ (V.ι ≫ f.fiberToSpecResidueField (g y')) = 𝟙 _ := by
      rw [← Category.assoc, hτ, hσF2]
    have hfib : ∀ s : Spec (Y.residueField (g y')),
        _root_.IsConnected ((V.ι ≫ f.fiberToSpecResidueField (g y')) ⁻¹' {s}) := by
      intro s
      have hu : (V.ι ≫ f.fiberToSpecResidueField (g y')) ⁻¹' {s} = Set.univ := by
        ext p
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_univ, iff_true]
        exact Subsingleton.elim _ _
      rw [hu]
      haveI : ConnectedSpace (V : Scheme.{u}) := isConnected_iff_connectedSpace.mp hVc
      exact isConnected_univ

    obtain ⟨Ω, _, _, ι, -⟩ : ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω)
        (ι : Y'.residueField y' →+* Ω), True :=
      ⟨AlgebraicClosure (Y'.residueField y'), inferInstance, inferInstance, algebraMap _ _, trivial⟩
    obtain ⟨z, hz⟩ : ∃ z : Spec (.of Ω) ⟶ Spec (Y.residueField (g y')),
        z = Spec.map (CommRingCat.ofHom ι) ≫ Spec.map (g.residueFieldMap y') := ⟨_, rfl⟩
    obtain ⟨w, hw⟩ : ∃ w : Spec (.of Ω) ⟶ Y',
        w = Spec.map (CommRingCat.ofHom ι) ≫ Y'.fromSpecResidueField y' := ⟨_, rfl⟩
    have hwpt : ∀ t, w t = y' := by
      intro t
      rw [hw, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    have ha : w ≫ g = z ≫ Y.fromSpecResidueField (g y') := by
      rw [hw, hz, Category.assoc, Category.assoc,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
    have hconn := wc_geom_fibres_connected_of_top_fibres_connected (Y.residueField (g y')) V
      (V.ι ≫ f.fiberToSpecResidueField (g y')) τ hτg hfib Ω z

    obtain ⟨P, fstP, sndP, hP, hPc⟩ : ∃ (P : Scheme.{u}) (fstP : P ⟶ V) (sndP : P ⟶ Spec (.of Ω)),
        IsPullback fstP sndP (V.ι ≫ f.fiberToSpecResidueField (g y')) z ∧ ConnectedSpace P :=
      ⟨_, _, _, IsPullback.of_hasPullback _ _, hconn⟩
    obtain ⟨Q, fstQ, sndQ, hQ⟩ : ∃ (Q : Scheme.{u}) (fstQ : Q ⟶ X') (sndQ : Q ⟶ Spec (.of Ω)),
        IsPullback fstQ sndQ f' w := ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
    have hPw := hP.w
    have hΦw : (fstP ≫ V.ι ≫ f.fiberι (g y')) ≫ f = (sndP ≫ w) ≫ g := by
      rw [Category.assoc, Category.assoc, hF.w, Category.assoc, ha, ← Category.assoc sndP, ← hPw]
      simp only [Category.assoc]
    obtain ⟨Φ, hΦ1, hΦ2⟩ : ∃ Φ : P ⟶ X', Φ ≫ g' = fstP ≫ V.ι ≫ f.fiberι (g y') ∧
        Φ ≫ f' = sndP ≫ w := ⟨hpb.lift _ _ hΦw, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
    have hΦpt : ∀ p, f' (Φ p) = y' := by
      intro p
      rw [← Scheme.Hom.comp_apply, hΦ2, Scheme.Hom.comp_apply, hwpt]
    have hκw : (fstQ ≫ g') ≫ f = (sndQ ≫ z) ≫ Y.fromSpecResidueField (g y') := by
      rw [Category.assoc, hpb.w, ← Category.assoc fstQ, hQ.w, Category.assoc sndQ, ha,
        Category.assoc]
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : Q ⟶ f.fiber (g y'), κ ≫ f.fiberι (g y') = fstQ ≫ g' ∧
        κ ≫ f.fiberToSpecResidueField (g y') = sndQ ≫ z :=
      ⟨hF.lift _ _ hκw, hF.lift_fst _ _ _, hF.lift_snd _ _ _⟩
    have outer := hQ.paste_horiz hpb
    rw [← hκ1, ha] at outer
    have S1 : IsPullback κ sndQ (f.fiberToSpecResidueField (g y')) z :=
      IsPullback.of_right outer hκ2 hF
    obtain ⟨Ψ, hΨ1, hΨ2⟩ : ∃ Ψ : P ⟶ Q, Ψ ≫ fstQ = Φ ∧ Ψ ≫ sndQ = sndP :=
      ⟨hQ.lift _ _ hΦ2, hQ.lift_fst _ _ _, hQ.lift_snd _ _ _⟩
    have hΨκ : Ψ ≫ κ = fstP ≫ V.ι := by
      apply hF.hom_ext
      · rw [Category.assoc, hκ1, ← Category.assoc Ψ, hΨ1, hΦ1]
        simp only [Category.assoc]
      · rw [Category.assoc, hκ2, ← Category.assoc Ψ, hΨ2, ← hPw]
        simp only [Category.assoc]
    have outer2 := hP.flip
    rw [← hΨ2] at outer2
    have S2 : IsPullback Ψ fstP κ V.ι := IsPullback.of_right outer2 hΨκ S1.flip
    have hrange : ∀ (x'' : X') (u : f.fiber (g y')), f' x'' = y' → u ∈ V →
        f.fiberι (g y') u = g' x'' → x'' ∈ Set.range Φ := by
      intro x'' u hx'' huV hu
      obtain ⟨q, hq, -⟩ := hsurj hQ x'' (IsLocalRing.closedPoint Ω)
        (by rw [hx'']; exact (hwpt _).symm)
      have hκq : κ q = u := by
        apply hιinj
        rw [hu, ← Scheme.Hom.comp_apply, hκ1, Scheme.Hom.comp_apply, hq]
      obtain ⟨p, hp, -⟩ := hsurj S2 q ⟨u, huV⟩ (by rw [Scheme.Opens.ι_apply, hκq])
      exact ⟨p, by rw [← hΨ1, Scheme.Hom.comp_apply, hp, hq]⟩

    have hR : _root_.IsConnected (Set.range Φ) := isConnected_range Φ.continuous
    have hRsub : Set.range Φ ⊆ f' ⁻¹' {y'} := by
      rintro _ ⟨p, rfl⟩
      exact hΦpt p
    have hσR : σ' y' ∈ Set.range Φ := by
      have h1 : σ (g y') ∈ Set.range (f.fiberι (g y')) := by
        rw [Scheme.Hom.range_fiberι]; exact hσy
      obtain ⟨p₀, hp₀⟩ := h1
      refine hrange (σ' y') p₀ (hP3' y') ?_ (hp₀.trans (hP2 y').symm)
      rw [hVmem, hp₀]
      exact mem_connectedComponentIn hσy
    have hxR : x' ∈ Set.range Φ := by
      have h1 : g' x' ∈ Set.range (f.fiberι (g y')) := by
        rw [Scheme.Hom.range_fiberι]
        show f (g' x') = g y'
        rw [hP1, hy']
      obtain ⟨p₁, hp₁⟩ := h1
      refine hrange x' p₁ hy' ?_ hp₁
      rw [hVmem, hp₁]
      exact hx
    exact hR.isPreconnected.subset_connectedComponentIn hσR hRsub hxR

theorem wc_x0sg_valuation_through_specialization : ∀ (X : Scheme.{u}) (x x' : X), x' ⤳ x → ∃ (K : Type u) (_ : Field K) (W : ValuationSubring K) (h : Spec (.of W) ⟶ X) (η : Spec (.of W)), η.asIdeal = ⊥ ∧ h η = x' ∧ h (IsLocalRing.closedPoint W) = x :=
by
  intro X x x' hspec
  have hmem : x' ∈ Set.range (X.fromSpecStalk x) := by
    rw [Scheme.range_fromSpecStalk]; exact hspec
  obtain ⟨p, hp⟩ := hmem
  set q : Ideal (X.presheaf.stalk x) := p.asIdeal with hq
  haveI : q.IsPrime := p.isPrime
  haveI : IsDomain (X.presheaf.stalk x ⧸ q) := Ideal.Quotient.isDomain q
  haveI : IsLocalRing (X.presheaf.stalk x ⧸ q) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk q) Ideal.Quotient.mk_surjective
  let D := X.presheaf.stalk x ⧸ q
  let K := FractionRing D
  let f : D →+* K := algebraMap D K
  have hf : Function.Injective f := IsFractionRing.injective D K
  obtain ⟨A, hA, hloc⟩ := IsLocalRing.exists_factor_valuationRing f
  let c : D →+* A := f.codRestrict A.toSubring hA
  have hc : Function.Injective c := by
    intro a b hab
    apply hf
    exact congrArg Subtype.val hab
  let g : X.presheaf.stalk x →+* A := c.comp (Ideal.Quotient.mk q)
  haveI : IsLocalHom (Ideal.Quotient.mk q) :=
    Function.Surjective.isLocalHom _ Ideal.Quotient.mk_surjective
  haveI : IsLocalHom c := hloc
  haveI hg : IsLocalHom g := RingHom.isLocalHom_comp c (Ideal.Quotient.mk q)
  have hker : RingHom.ker g = q := by
    rw [RingHom.ker_comp_of_injective _ hc, Ideal.mk_ker]
  let φ : X.presheaf.stalk x ⟶ CommRingCat.of A := CommRingCat.ofHom g
  let η : Spec (CommRingCat.of A) := (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum A)
  have hη : (Spec.map φ) η = p := by
    apply PrimeSpectrum.ext
    change Ideal.comap g ⊥ = p.asIdeal
    rw [← RingHom.ker_eq_comap_bot, hker]
  refine ⟨K, inferInstance, A, Spec.map φ ≫ X.fromSpecStalk x, η, rfl, ?_, ?_⟩
  · change (X.fromSpecStalk x) ((Spec.map φ) η) = x'
    rw [hη, hp]
  · change (X.fromSpecStalk x) ((Spec.map φ) (IsLocalRing.closedPoint (CommRingCat.of A))) = x
    haveI : IsLocalHom φ.hom := hg
    rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint]

theorem wc_x0sg_affine_smooth_model : ∀ (R : Type u) [CommRing R] (Z : Scheme.{u}) [IsAffine Z] (f : Z ⟶ Spec (.of R)) [Smooth f], ∃ (C : Type u) (_ : CommRing C) (_ : Algebra R C) (_ : Algebra.Smooth R C) (e : Z ≃ₜ PrimeSpectrum C), ∀ z : Z, f z = PrimeSpectrum.comap (algebraMap R C) (e z) :=
by
  intro R _ Z _ f _
  let φ : R →+* Γ(Z, ⊤) := ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ f.appTop).hom
  letI : Algebra R Γ(Z, ⊤) := φ.toAlgebra
  have h1 : RingHom.Smooth (f.appTop).hom := HasRingHomProperty.appTop @Smooth f inferInstance
  have h0 : RingHom.Smooth (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom :=
    RingHom.Smooth.of_bijective (ConcreteCategory.bijective_of_isIso _)
  have hφ : φ.Smooth := by
    have h2 := RingHom.Smooth.comp h0 h1
    simpa only [φ, CommRingCat.hom_comp] using h2
  have hsm : Algebra.Smooth R Γ(Z, ⊤) := RingHom.smooth_algebraMap.mp hφ
  have key : Z.isoSpec.hom ≫ Spec.map ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ f.appTop) = f := by
    rw [Spec.map_comp, ← Category.assoc, Scheme.isoSpec_hom_naturality, Scheme.isoSpec_Spec_hom,
      Category.assoc, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
  refine ⟨Γ(Z, ⊤), inferInstance, φ.toAlgebra, hsm, Scheme.homeoOfIso Z.isoSpec, ?_⟩
  intro z
  have hz := congrArg (fun g : Z ⟶ Spec (CommRingCat.of R) => g z) key
  simp only [Scheme.Hom.comp_apply, Spec.map_apply] at hz
  exact hz.symm

theorem wc_x0sg_generic_component_clopen_lift : ∀ (K : Type u) [Field K] (W : ValuationSubring K) (C : Type u) [CommRing C] [Algebra W C] [Algebra.Smooth W C] (P₀ : PrimeSpectrum C), (PrimeSpectrum.comap (algebraMap W C) P₀).asIdeal = ⊥ → ∃ U : Set (PrimeSpectrum C), IsClopen U ∧ U ∩ {P : PrimeSpectrum C | (PrimeSpectrum.comap (algebraMap W C) P).asIdeal = ⊥} = connectedComponentIn {P : PrimeSpectrum C | (PrimeSpectrum.comap (algebraMap W C) P).asIdeal = ⊥} P₀ :=
by
  intro K _ W C _ _ _ P₀ hP₀

  have s1 : ∀ {α : Type u} [TopologicalSpace α] [TopologicalSpace.NoetherianSpace α] (x : α),
      IsClopen (connectedComponent x) := by
    intro α _ _ x
    refine ⟨isClosed_connectedComponent, ?_⟩
    set S := connectedComponent x
    let 𝓕 := {Z ∈ irreducibleComponents α | Disjoint Z S}
    have hfin : 𝓕.Finite :=
      (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents).subset (fun Z hZ => hZ.1)
    have hcl : IsClosed (⋃ Z ∈ 𝓕, Z) :=
      hfin.isClosed_biUnion (fun Z hZ => isClosed_of_mem_irreducibleComponents Z hZ.1)
    have heq : Sᶜ = ⋃ Z ∈ 𝓕, Z := by
      ext y
      simp only [Set.mem_compl_iff, Set.mem_iUnion, exists_prop]
      constructor
      · intro hy
        refine ⟨irreducibleComponent y, ⟨irreducibleComponent_mem_irreducibleComponents y, ?_⟩,
          mem_irreducibleComponent⟩
        have hne : connectedComponent y ≠ S := fun h => hy (h ▸ mem_connectedComponent)
        exact (connectedComponent_disjoint hne).mono_left
          irreducibleComponent_subset_connectedComponent
      · rintro ⟨Z, ⟨_, hd⟩, hyZ⟩ hyS
        exact Set.disjoint_left.mp hd hyZ hyS
    rw [← isClosed_compl_iff, heq]; exact hcl

  have s4 : IsNoetherianRing (TensorProduct W C K) := by
    have : Algebra.FiniteType K (TensorProduct W K C) := Algebra.FiniteType.baseChange K
    have : IsNoetherianRing (TensorProduct W K C) := Algebra.FiniteType.isNoetherianRing K _
    exact isNoetherianRing_of_ringEquiv _ (Algebra.TensorProduct.comm W K C).toRingEquiv

  have s3 : Set.range (PrimeSpectrum.comap (algebraMap C (TensorProduct W C K))) =
      {P : PrimeSpectrum C | (PrimeSpectrum.comap (algebraMap W C) P).asIdeal = ⊥} := by
    have hloc : IsLocalization (Algebra.algebraMapSubmonoid C (nonZeroDivisors W))
        (TensorProduct W C K) := IsLocalization.tensor K (nonZeroDivisors W)
    rw [PrimeSpectrum.localization_comap_range (TensorProduct W C K)
      (Algebra.algebraMapSubmonoid C (nonZeroDivisors W))]
    ext P
    simp only [Set.mem_setOf_eq, PrimeSpectrum.comap_asIdeal]
    constructor
    · intro hd
      rw [eq_bot_iff]
      intro w hw
      rw [Ideal.mem_bot]
      by_contra hne
      have h1 : algebraMap W C w ∈ (Algebra.algebraMapSubmonoid C (nonZeroDivisors W) : Set C) :=
        Submonoid.mem_map.mpr ⟨w, mem_nonZeroDivisors_of_ne_zero hne, rfl⟩
      exact Set.disjoint_left.mp hd h1 hw
    · intro hb
      rw [Set.disjoint_left]
      intro y hy hyP
      obtain ⟨w, hw, rfl⟩ := Submonoid.mem_map.mp hy
      have : w ∈ Ideal.comap (algebraMap W C) P.asIdeal := hyP
      rw [hb, Ideal.mem_bot] at this
      exact nonZeroDivisors.ne_zero hw this

  have s2 : ∀ e : TensorProduct W C K, IsIdempotentElem e →
      ∃ c : C, IsIdempotentElem c ∧ algebraMap C (TensorProduct W C K) c = e := by
    intro e he
    have hint : _root_.IsIntegral C e := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.X, ?_, ?_⟩
      · exact Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num))
      · simp [Polynomial.eval₂_sub, pow_two, he.eq]
    have hbot : integralClosure W K = ⊥ := IsIntegrallyClosed.integralClosure_eq_bot W K
    have hrange : ∀ t : TensorProduct W C (integralClosure W K),
        ((TensorProduct.toIntegralClosure W C K t : integralClosure C (TensorProduct W C K)) :
          TensorProduct W C K) ∈ Set.range (algebraMap C (TensorProduct W C K)) := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => exact ⟨0, by simp⟩
      | tmul c i =>
        have hi : (i : K) ∈ (⊥ : Subalgebra W K) := hbot ▸ i.2
        obtain ⟨w, hw⟩ := Algebra.mem_bot.mp hi
        refine ⟨w • c, ?_⟩
        have key : ((TensorProduct.toIntegralClosure W C K (c ⊗ₜ i) :
            integralClosure C (TensorProduct W C K)) : TensorProduct W C K) =
            c ⊗ₜ (i : K) := rfl
        rw [key, ← hw, Algebra.algebraMap_eq_smul_one (A := K), ← TensorProduct.smul_tmul,
          Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
      | add a b ha hb =>
        obtain ⟨x, hx⟩ := ha
        obtain ⟨y, hy⟩ := hb
        exact ⟨x + y, by rw [map_add, hx, hy, map_add, Subalgebra.coe_add]⟩
    obtain ⟨t, ht⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := W) (S := C)
      (B := K)).2 ⟨e, hint⟩
    obtain ⟨c, hc⟩ := hrange t
    rw [ht] at hc
    have hinj : Function.Injective (algebraMap C (TensorProduct W C K)) := by
      haveI := Algebra.Smooth.flat W C
      intro x y hxy
      apply Algebra.TensorProduct.includeLeft_injective (R := W) (S := W) (A := C) (B := K)
        (IsFractionRing.injective W K)
      simpa [Algebra.TensorProduct.algebraMap_apply] using hxy
    refine ⟨c, hinj ?_, hc⟩
    rw [map_mul, hc]
    exact he.eq

  set G := {P : PrimeSpectrum C | (PrimeSpectrum.comap (algebraMap W C) P).asIdeal = ⊥} with hG
  set φ := PrimeSpectrum.comap (algebraMap C (TensorProduct W C K)) with hφ
  obtain ⟨Q₀, hQ₀⟩ : P₀ ∈ Set.range φ := by rw [s3]; exact hP₀
  have hS := s1 Q₀
  obtain ⟨e, he, hSe⟩ := PrimeSpectrum.isClopen_iff.mp hS
  obtain ⟨c, hc, hce⟩ := s2 e he
  set U : Set (PrimeSpectrum C) := (PrimeSpectrum.basicOpen c : Set (PrimeSpectrum C)) with hUdef
  have hU : IsClopen U := PrimeSpectrum.isClopen_iff.mpr ⟨c, hc, rfl⟩
  have hpre : φ ⁻¹' U = connectedComponent Q₀ := by
    rw [hSe]
    ext Q
    simp only [Set.mem_preimage, hUdef, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
    show c ∉ Ideal.comap _ Q.asIdeal ↔ e ∉ Q.asIdeal
    rw [Ideal.mem_comap, hce]
  have himg : U ∩ G = φ '' connectedComponent Q₀ := by
    rw [← hpre, Set.image_preimage_eq_inter_range, s3]
  refine ⟨U, hU, ?_⟩
  apply Set.Subset.antisymm
  · rw [himg]
    apply IsPreconnected.subset_connectedComponentIn
    · exact isPreconnected_connectedComponent.image φ
        (PrimeSpectrum.continuous_comap _).continuousOn
    · exact ⟨Q₀, mem_connectedComponent, hQ₀⟩
    · rw [← s3]; exact Set.image_subset_range _ _
  · have hP₀U : P₀ ∈ U := by
      have : Q₀ ∈ φ ⁻¹' U := by rw [hpre]; exact mem_connectedComponent
      rw [← hQ₀]; exact this
    exact Set.subset_inter (isPreconnected_connectedComponentIn.subset_isClopen hU
      ⟨P₀, mem_connectedComponentIn hP₀, hP₀U⟩) (connectedComponentIn_subset _ _)

theorem wc_x0_stableUnderGeneralization : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → StableUnderGeneralization {x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))} :=
by
  intro A _ X _ f _ σ hσ x x' hspec hx
  obtain ⟨K, _, W, h, η, hη, hhη, hhc⟩ :=
    wc_x0sg_valuation_through_specialization X x x' hspec

  have hpb := IsPullback.of_hasPullback f (h ≫ f)
  haveI : IsAffine (Limits.pullback f (h ≫ f)) := inferInstance
  haveI : Smooth (Limits.pullback.snd f (h ≫ f)) :=
    MorphismProperty.of_isPullback (P := @Smooth) hpb inferInstance
  have hσWw : (h ≫ f ≫ σ) ≫ f = 𝟙 _ ≫ (h ≫ f) := by
    rw [Category.assoc, Category.assoc, hσ, Category.comp_id, Category.id_comp]
  obtain ⟨σW, hσW2, hσW1⟩ : ∃ σW : Spec (.of W) ⟶ Limits.pullback f (h ≫ f),
      σW ≫ Limits.pullback.fst f (h ≫ f) = (h ≫ f) ≫ σ ∧
      σW ≫ Limits.pullback.snd f (h ≫ f) = 𝟙 _ :=
    ⟨Limits.pullback.lift (h ≫ f ≫ σ) (𝟙 _) hσWw,
      (Limits.pullback.lift_fst _ _ _).trans (Category.assoc _ _ _).symm,
      Limits.pullback.lift_snd _ _ _⟩
  have htw : h ≫ f = 𝟙 _ ≫ (h ≫ f) := by rw [Category.id_comp]
  obtain ⟨t, ht1, ht2⟩ : ∃ t : Spec (.of W) ⟶ Limits.pullback f (h ≫ f),
      t ≫ Limits.pullback.fst f (h ≫ f) = h ∧ t ≫ Limits.pullback.snd f (h ≫ f) = 𝟙 _ :=
    ⟨Limits.pullback.lift h (𝟙 _) htw, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hpt : ∀ w, Limits.pullback.fst f (h ≫ f) (t w) = h w := fun w => by
    rw [← Scheme.Hom.comp_apply, ht1]
  have hft : ∀ w, Limits.pullback.snd f (h ≫ f) (t w) = w := fun w => by
    rw [← Scheme.Hom.comp_apply, ht2]; rfl
  have hfσW : ∀ w, Limits.pullback.snd f (h ≫ f) (σW w) = w := fun w => by
    rw [← Scheme.Hom.comp_apply, hσW1]; rfl
  have hs2 := wc_x0_baseChange_preimage X (Spec (.of A)) (Limits.pullback f (h ≫ f))
    (Spec (.of W)) f σ hσ (h ≫ f) (Limits.pullback.snd f (h ≫ f))
    (Limits.pullback.fst f (h ≫ f)) σW hpb hσW1 hσW2
  obtain ⟨c, hcx, hηc⟩ : ∃ c : Spec (.of W), h c = x ∧ η ⤳ c :=
    ⟨IsLocalRing.closedPoint W, hhc, IsLocalRing.specializes_closedPoint η⟩

  have hz : t c ∈ connectedComponentIn
      (Limits.pullback.snd f (h ≫ f) ⁻¹' {c}) (σW c) := by
    have := (hs2 (t c)).mpr (by rw [hpt, hcx]; exact hx)
    rwa [hft] at this

  obtain ⟨C, _, _, _, e, he⟩ := wc_x0sg_affine_smooth_model W (Limits.pullback f (h ≫ f))
    (Limits.pullback.snd f (h ≫ f))
  have hP₀ : (PrimeSpectrum.comap (algebraMap W C) (e (σW η))).asIdeal = ⊥ := by
    rw [← he, hfσW]; exact hη
  obtain ⟨UC, hUC, hUCeq⟩ := wc_x0sg_generic_component_clopen_lift K W C (e (σW η)) hP₀
  have hfib : ∀ y, Limits.pullback.snd f (h ≫ f) y = η ↔
      e y ∈ {P : PrimeSpectrum C | (PrimeSpectrum.comap (algebraMap W C) P).asIdeal = ⊥} := by
    intro y
    rw [Set.mem_setOf_eq, ← he]
    constructor
    · intro hy; rw [hy]; exact hη
    · intro hy; exact PrimeSpectrum.ext (hy.trans hη.symm)
  have hU : IsClopen (e ⁻¹' UC) := hUC.preimage e.continuous

  have haU : σW η ∈ e ⁻¹' UC := by
    have : e (σW η) ∈ UC ∩ {P : PrimeSpectrum C |
        (PrimeSpectrum.comap (algebraMap W C) P).asIdeal = ⊥} := by
      rw [hUCeq]; exact mem_connectedComponentIn hP₀
    exact this.1

  have hbU : σW c ∈ e ⁻¹' UC :=
    (hηc.map σW.continuous).mem_closed hU.isClosed haU

  have hcU : t c ∈ e ⁻¹' UC := by
    have hsub := (isPreconnected_connectedComponentIn (F := Limits.pullback.snd f (h ≫ f) ⁻¹'
      {c}) (x := σW c)).subset_isClopen hU
      ⟨σW c, mem_connectedComponentIn (hfσW _), hbU⟩
    exact hsub hz

  have hdU : t η ∈ e ⁻¹' UC :=
    (hηc.map t.continuous).mem_open hU.isOpen hcU
  have hdC : e (t η) ∈ connectedComponentIn
      {P : PrimeSpectrum C | (PrimeSpectrum.comap (algebraMap W C) P).asIdeal = ⊥}
      (e (σW η)) := by
    rw [← hUCeq]; exact ⟨hdU, (hfib _).mp (hft η)⟩

  have hgen : t η ∈ connectedComponentIn (Limits.pullback.snd f (h ≫ f) ⁻¹' {η}) (σW η) := by
    have hsub : e.symm '' connectedComponentIn
        {P : PrimeSpectrum C | (PrimeSpectrum.comap (algebraMap W C) P).asIdeal = ⊥}
        (e (σW η)) ⊆ connectedComponentIn (Limits.pullback.snd f (h ≫ f) ⁻¹' {η}) (σW η) := by
      apply IsPreconnected.subset_connectedComponentIn
      · exact isPreconnected_connectedComponentIn.image _ e.symm.continuous.continuousOn
      · exact ⟨e (σW η), mem_connectedComponentIn hP₀, e.symm_apply_apply _⟩
      · rintro _ ⟨P, hP, rfl⟩
        show Limits.pullback.snd f (h ≫ f) (e.symm P) = η
        rw [hfib, e.apply_symm_apply]
        exact connectedComponentIn_subset _ _ hP
    exact hsub ⟨e (t η), hdC, e.symm_apply_apply _⟩
  have hfin := (hs2 (t η)).mp (by rw [hft]; exact hgen)
  rw [hpt, hhη] at hfin
  exact hfin

theorem wc_x0_noetherian_descent : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → ∃ (A₀ : Type u) (_ : CommRing A₀) (_ : IsNoetherianRing A₀) (φ : A₀ →+* A) (X₀ : Scheme.{u}) (_ : IsAffine X₀) (f₀ : X₀ ⟶ Spec (.of A₀)) (_ : Smooth f₀) (σ₀ : Spec (.of A₀) ⟶ X₀) (p : X ⟶ X₀), σ₀ ≫ f₀ = 𝟙 _ ∧ IsPullback p f f₀ (Spec.map (CommRingCat.ofHom φ)) ∧ σ ≫ p = Spec.map (CommRingCat.ofHom φ) ≫ σ₀ :=
by
  have wc_fnr_smooth_section_descend : ∀ (A : Type u) [CommRing A] (Λ : Finset A → Subring A), Monotone Λ → (∀ S, ∀ a ∈ S, a ∈ Λ S) → ∀ (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → ∃ (S : Finset A) (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of ↥(Λ S))) (σ' : Spec (.of ↥(Λ S)) ⟶ X') (π : X ⟶ X'), IsAffine X' ∧ Smooth f' ∧ σ' ≫ f' = 𝟙 _ ∧ IsPullback π f f' (Spec.map (CommRingCat.ofHom (Λ S).subtype)) ∧ σ ≫ π = Spec.map (CommRingCat.ofHom (Λ S).subtype) ≫ σ' := by
    intro A _ Λ _hΛ hS X _ f _ σ hσ

    have s1 : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → ∃ (φ : A →+* Γ(X, ⊤)) (s : Γ(X, ⊤) →+* A), Spec.map (CommRingCat.ofHom φ) = X.isoSpec.inv ≫ f ∧ Spec.map (CommRingCat.ofHom s) = σ ≫ X.isoSpec.hom ∧ φ.Smooth ∧ s.comp φ = RingHom.id A := by
      intro A _ X _ f _ σ hσ
      refine ⟨(Spec.preimage (X.isoSpec.inv ≫ f)).hom, (Spec.preimage (σ ≫ X.isoSpec.hom)).hom, ?_, ?_, ?_, ?_⟩
      · rw [CommRingCat.ofHom_hom, Spec.map_preimage]
      · rw [CommRingCat.ofHom_hom, Spec.map_preimage]
      · have h0 : Smooth (X.isoSpec.inv ≫ f) := inferInstance
        rw [← Spec.map_preimage (X.isoSpec.inv ≫ f)] at h0
        exact (HasRingHomProperty.Spec_iff (P := @Smooth)).mp h0
      · have h1 : Spec.map (CommRingCat.ofHom ((Spec.preimage (σ ≫ X.isoSpec.hom)).hom.comp
            (Spec.preimage (X.isoSpec.inv ≫ f)).hom)) = Spec.map (𝟙 (CommRingCat.of A)) := by
          rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, CommRingCat.ofHom_hom,
            Spec.map_preimage, Spec.map_preimage, Spec.map_id]
          simp [hσ]
        have h2 := Spec.map_injective h1
        exact congrArg CommRingCat.Hom.hom h2

    have s2 : ∀ (A : Type u) [CommRing A] (Λ : Finset A → Subring A), (∀ S, ∀ a ∈ S, a ∈ Λ S) → ∀ (B : Type u) [CommRing B] [Algebra A B] (s : B →+* A), s.comp (algebraMap A B) = RingHom.id A → ∀ (A₀ : Subalgebra ℤ A), A₀.FG → ∀ (B₀ : Type u) [CommRing B₀] [Algebra A₀ B₀] [Algebra.FiniteType A₀ B₀] (e : B ≃ₐ[A] TensorProduct A₀ A B₀), ∃ S : Finset A, (∀ a : A₀, (a : A) ∈ Λ S) ∧ ∀ y : B₀, s (e.symm ((1 : A) ⊗ₜ[A₀] y)) ∈ Λ S := by
      intro A _ Λ hS B _ _ s hs A₀ hfg B₀ _ _ _ e
      classical
      obtain ⟨t, ht⟩ := hfg
      obtain ⟨u, hu⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra A₀ B₀).FG)
      let h : B₀ →+* A := s.comp (e.symm.toRingHom.comp
        (Algebra.TensorProduct.includeRight : B₀ →ₐ[A₀] TensorProduct A₀ A B₀).toRingHom)
      have hh : ∀ y, h y = s (e.symm ((1 : A) ⊗ₜ[A₀] y)) := fun y => rfl
      have hkey : ∀ a : A₀, h (algebraMap A₀ B₀ a) = (a : A) := by
        intro a
        have e1 : ((1 : A) ⊗ₜ[A₀] algebraMap A₀ B₀ a : TensorProduct A₀ A B₀) =
            algebraMap A (TensorProduct A₀ A B₀) (a : A) := by
          rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
            Algebra.algebraMap_eq_smul_one a, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
          rfl
        rw [hh, e1, AlgEquiv.commutes]
        exact RingHom.congr_fun hs _
      have hA' : ∀ x ∈ Algebra.adjoin ℤ (t : Set A), x ∈ Λ (t ∪ u.image h) := by
        intro x hx
        induction hx using Algebra.adjoin_induction with
        | mem x hx => exact hS _ _ (Finset.mem_union_left _ hx)
        | algebraMap n => rw [eq_intCast]; exact intCast_mem _ n
        | add x y _ _ hx hy => exact add_mem hx hy
        | mul x y _ _ hx hy => exact mul_mem hx hy
      have hA : ∀ a : A₀, (a : A) ∈ Λ (t ∪ u.image h) := by
        intro a
        exact hA' a (by rw [ht]; exact a.2)
      refine ⟨t ∪ u.image h, hA, ?_⟩
      intro y
      rw [← hh]
      have hy : y ∈ (⊤ : Subalgebra A₀ B₀) := trivial
      rw [← hu] at hy
      induction hy using Algebra.adjoin_induction with
      | mem x hx => exact hS _ _ (Finset.mem_union_right _ (Finset.mem_image_of_mem h hx))
      | algebraMap a => rw [hkey]; exact hA a
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy

    have s3 : ∀ (A : Type u) [CommRing A] (A₀ : Subalgebra ℤ A) (R : Subring A), (∀ a : A₀, (a : A) ∈ R) → ∀ (B : Type u) [CommRing B] [Algebra A B] (s : B →+* A), s.comp (algebraMap A B) = RingHom.id A → ∀ (B₀ : Type u) [CommRing B₀] [Algebra A₀ B₀] [Algebra.Smooth A₀ B₀] (e : B ≃ₐ[A] TensorProduct A₀ A B₀), (∀ y : B₀, s (e.symm ((1 : A) ⊗ₜ[A₀] y)) ∈ R) → ∃ (B₁ : Type u) (_ : CommRing B₁) (g : ↥R →+* B₁) (τ : B₁ →+* ↥R) (ψ : B₁ →+* B), g.Smooth ∧ τ.comp g = RingHom.id ↥R ∧ IsPushout (CommRingCat.ofHom R.subtype) (CommRingCat.ofHom g) (CommRingCat.ofHom (algebraMap A B)) (CommRingCat.ofHom ψ) ∧ s.comp ψ = R.subtype.comp τ := by
      intro A _ A₀ R hR B _ _ s hs B₀ _ _ _ e hy
      letI : Algebra A₀ R := (RingHom.codRestrict A₀.val.toRingHom R hR).toAlgebra
      haveI : IsScalarTower A₀ R A := IsScalarTower.of_algebraMap_eq' rfl
      haveI : Algebra.Smooth R (TensorProduct A₀ R B₀) := Algebra.Smooth.baseChange A₀ B₀ R
      have hkey : ∀ a : A₀, s (e.symm ((1 : A) ⊗ₜ[A₀] algebraMap A₀ B₀ a)) = (a : A) := by
        intro a
        have e1 : ((1 : A) ⊗ₜ[A₀] algebraMap A₀ B₀ a : TensorProduct A₀ A B₀) =
            algebraMap A (TensorProduct A₀ A B₀) (a : A) := by
          rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
            Algebra.algebraMap_eq_smul_one a, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
          rfl
        rw [e1, AlgEquiv.commutes]
        exact RingHom.congr_fun hs _
      let h' : B₀ →ₐ[A₀] R :=
        { toRingHom := (s.comp (e.symm.toRingHom.comp
            (Algebra.TensorProduct.includeRight : B₀ →ₐ[A₀] TensorProduct A₀ A B₀).toRingHom)).codRestrict
              R hy
          commutes' := fun a => Subtype.ext (hkey a) }
      let τ : TensorProduct A₀ R B₀ →+* R :=
        (Algebra.TensorProduct.lift (AlgHom.id R R) h' (fun _ _ => Commute.all _ _)).toRingHom
      have hτ : ∀ (r : R) (y : B₀), τ (r ⊗ₜ[A₀] y) = r * h' y := by
        intro r y
        simp [τ, Algebra.TensorProduct.lift_tmul]
      let cbc := Algebra.TensorProduct.cancelBaseChange A₀ R A A B₀
      let E : TensorProduct R A (TensorProduct A₀ R B₀) ≃ₐ[A] B := cbc.trans e.symm
      let ψ : TensorProduct A₀ R B₀ →+* B := E.toRingHom.comp
        (Algebra.TensorProduct.includeRight : TensorProduct A₀ R B₀ →ₐ[R]
          TensorProduct R A (TensorProduct A₀ R B₀)).toRingHom
      have hψ : ∀ (r : R) (y : B₀), ψ (r ⊗ₜ[A₀] y) = e.symm ((r : A) ⊗ₜ[A₀] y) := by
        intro r y
        show e.symm (cbc ((1 : A) ⊗ₜ[R] (r ⊗ₜ[A₀] y))) = _
        rw [Algebra.TensorProduct.cancelBaseChange_tmul, Algebra.smul_def, mul_one]
        rfl
      refine ⟨TensorProduct A₀ R B₀, inferInstance, algebraMap R (TensorProduct A₀ R B₀), τ, ψ,
        RingHom.smooth_algebraMap.mpr inferInstance, ?_, ?_, ?_⟩
      · refine RingHom.ext fun r => ?_
        simp only [RingHom.comp_apply, RingHom.id_apply, Algebra.TensorProduct.algebraMap_apply,
          Algebra.algebraMap_self, hτ, map_one, mul_one]
      · refine IsPushout.of_iso (CommRingCat.isPushout_tensorProduct R A (TensorProduct A₀ R B₀))
          (Iso.refl _) (Iso.refl _) (Iso.refl _) E.toRingEquiv.toCommRingCatIso ?_ ?_ ?_ ?_
        · rfl
        · rfl
        · ext a
          show E (a ⊗ₜ[R] (1 : TensorProduct A₀ R B₀)) = algebraMap A B a
          have h0 := E.commutes a
          rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] at h0
          exact h0
        · rfl
      · refine RingHom.ext fun z => ?_
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul r y =>
          have h2 : ((r : A) ⊗ₜ[A₀] y : TensorProduct A₀ A B₀) =
              algebraMap A _ (r : A) * ((1 : A) ⊗ₜ[A₀] y) := by
            rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
              Algebra.algebraMap_self, RingHom.id_apply, mul_one, one_mul]
          have h4 : s (algebraMap A B (r : A)) = r := RingHom.congr_fun hs _
          simp only [RingHom.comp_apply]
          rw [hψ, hτ, h2, map_mul, map_mul, AlgEquiv.commutes, h4]
          rfl
        | add x y hx hy => simp only [map_add, hx, hy]

    have s4 : ∀ (A : Type u) [CommRing A] (R : Subring A) (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) (σ : Spec (.of A) ⟶ X) (φ : A →+* Γ(X, ⊤)) (s : Γ(X, ⊤) →+* A), Spec.map (CommRingCat.ofHom φ) = X.isoSpec.inv ≫ f → Spec.map (CommRingCat.ofHom s) = σ ≫ X.isoSpec.hom → ∀ (B₁ : Type u) [CommRing B₁] (g : ↥R →+* B₁) (τ : B₁ →+* ↥R) (ψ : B₁ →+* Γ(X, ⊤)), g.Smooth → τ.comp g = RingHom.id ↥R → IsPushout (CommRingCat.ofHom R.subtype) (CommRingCat.ofHom g) (CommRingCat.ofHom φ) (CommRingCat.ofHom ψ) → s.comp ψ = R.subtype.comp τ → ∃ (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of ↥R)) (σ' : Spec (.of ↥R) ⟶ X') (π : X ⟶ X'), IsAffine X' ∧ Smooth f' ∧ σ' ≫ f' = 𝟙 _ ∧ IsPullback π f f' (Spec.map (CommRingCat.ofHom R.subtype)) ∧ σ ≫ π = Spec.map (CommRingCat.ofHom R.subtype) ≫ σ' := by
      intro A _ R X _ f σ φ s hφ hs B₁ _ g τ ψ hg hτ hpo hsψ
      refine ⟨Spec (.of B₁), Spec.map (CommRingCat.ofHom g), Spec.map (CommRingCat.ofHom τ),
        X.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom ψ), inferInstance, ?_, ?_, ?_, ?_⟩
      · exact (HasRingHomProperty.Spec_iff (P := @Smooth)).mpr hg
      · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hτ, CommRingCat.ofHom_id, Spec.map_id]
      · have h1 := (isPullback_SpecMap_of_isPushout _ _ _ _ hpo).flip
        refine IsPullback.of_iso h1 X.isoSpec.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
        · simp
        · simp [hφ]
        · simp
        · simp
      · rw [← Category.assoc, ← hs, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← CommRingCat.ofHom_comp, hsψ]

    obtain ⟨φ, s, hφ, hs, hsm, hsφ⟩ := s1 A X f σ hσ
    letI : Algebra A Γ(X, ⊤) := φ.toAlgebra
    haveI : Algebra.Smooth A Γ(X, ⊤) := RingHom.Smooth.toAlgebra hsm
    obtain ⟨A₀, B₀, _, _, hfg, hsm₀, ⟨e⟩⟩ := Algebra.Smooth.exists_subalgebra_fg ℤ A Γ(X, ⊤)
    haveI := hsm₀
    obtain ⟨S, hA₀, hy⟩ := s2 A Λ hS Γ(X, ⊤) s hsφ A₀ hfg B₀ e
    obtain ⟨B₁, _, g, τ, ψ, hg, hτ, hpo, hsψ⟩ := s3 A A₀ (Λ S) hA₀ Γ(X, ⊤) s hsφ B₀ e hy
    obtain ⟨X', f', σ', π, h1, h2, h3, h4, h5⟩ :=
      s4 A (Λ S) X f σ φ s hφ hs B₁ g τ ψ hg hτ hpo hsψ
    exact ⟨S, X', f', σ', π, h1, h2, h3, h4, h5⟩
  intro A _ X _ f _ σ hσ
  obtain ⟨S, X', f', σ', π, hX', hf', hσ', hpb, hσπ⟩ :=
    wc_fnr_smooth_section_descend A (fun S => Subring.closure (S : Set A))
      (fun S T hST => Subring.closure_mono (Finset.coe_subset.mpr hST))
      (fun S a ha => Subring.subset_closure (Finset.mem_coe.mpr ha))
      X f σ hσ
  exact ⟨↥(Subring.closure (S : Set A)), inferInstance,
    is_noetherian_subring_closure _ S.finite_toSet, (Subring.closure (S : Set A)).subtype,
    X', hX', f', hf', σ', π, hσ', hpb, hσπ⟩

theorem wc_x0c_generic_idempotent_split : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] (C : Type u) [CommRing C] [Algebra R C] [Algebra.FiniteType R C] (s : C →ₐ[R] R) (η : PrimeSpectrum R), η.asIdeal = ⊥ → ∃ (a : R) (c c' : C), a ≠ 0 ∧ (∀ Q : PrimeSpectrum C, a ∉ (PrimeSpectrum.comap (algebraMap R C) Q).asIdeal → (c ∉ Q.asIdeal ↔ c' ∈ Q.asIdeal)) ∧ (∀ Q : PrimeSpectrum C, PrimeSpectrum.comap (algebraMap R C) Q = η → (c ∉ Q.asIdeal ↔ Q ∈ connectedComponentIn (PrimeSpectrum.comap (algebraMap R C) ⁻¹' {η}) (PrimeSpectrum.comap (s : C →+* R) η))) ∧ ∀ q : PrimeSpectrum R, a ∉ q.asIdeal → s c ∉ q.asIdeal :=
by
  intro R _ _ _ C _ _ _ s η hη
  classical

  have hclopen : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X] (x : X),
      IsClopen (connectedComponent x) := by
    intro X _ _ x
    refine ⟨isClosed_connectedComponent, ?_⟩
    have hS : {Z : Set X | Z ∈ irreducibleComponents X ∧ Disjoint Z (connectedComponent x)}.Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset (fun Z hZ => hZ.1)
    have hU : IsClosed (⋃ Z ∈ {Z : Set X | Z ∈ irreducibleComponents X ∧
        Disjoint Z (connectedComponent x)}, Z) :=
      hS.isClosed_biUnion (fun Z hZ => isClosed_of_mem_irreducibleComponents Z hZ.1)
    have hEq : (connectedComponent x)ᶜ = ⋃ Z ∈ {Z : Set X | Z ∈ irreducibleComponents X ∧
        Disjoint Z (connectedComponent x)}, Z := by
      ext z
      simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_setOf_eq, exists_prop]
      constructor
      · intro hz
        refine ⟨irreducibleComponent z, ⟨irreducibleComponent_mem_irreducibleComponents z, ?_⟩,
          mem_irreducibleComponent⟩
        rw [Set.disjoint_left]
        intro w hwZ hwP
        apply hz
        have h1 : irreducibleComponent z ⊆ connectedComponent w :=
          (isIrreducible_irreducibleComponent (x := z)).isConnected.isPreconnected.subset_connectedComponent hwZ
        have h2 : connectedComponent x = connectedComponent w := connectedComponent_eq hwP
        rw [h2]
        exact h1 mem_irreducibleComponent
      · rintro ⟨Z, ⟨_, hZ⟩, hzZ⟩ hzP
        exact Set.disjoint_left.mp hZ hzZ hzP
    rw [← isClosed_compl_iff, hEq]
    exact hU

  have hcc : ∀ {Y X : Type u} [TopologicalSpace Y] [TopologicalSpace X] (ι : Y → X) (y₀ y : Y),
      Topology.IsInducing ι →
      (ι y ∈ connectedComponentIn (Set.range ι) (ι y₀) ↔ y ∈ connectedComponent y₀) := by
    intro Y X _ _ ι y₀ y hι
    constructor
    · intro hy
      have hK : connectedComponentIn (Set.range ι) (ι y₀) ⊆ Set.range ι :=
        connectedComponentIn_subset _ _
      have hpc : IsPreconnected (ι ⁻¹' connectedComponentIn (Set.range ι) (ι y₀)) := by
        rw [← hι.isPreconnected_image, Set.image_preimage_eq_of_subset hK]
        exact isPreconnected_connectedComponentIn
      exact hpc.subset_connectedComponent (mem_connectedComponentIn ⟨y₀, rfl⟩) hy
    · intro hy
      have h1 : ι '' connectedComponent y₀ ⊆ connectedComponentIn (Set.range ι) (ι y₀) :=
        (isPreconnected_connectedComponent.image _ hι.continuous.continuousOn).subset_connectedComponentIn
          ⟨y₀, mem_connectedComponent, rfl⟩ (Set.image_subset_range _ _)
      exact h1 ⟨y, hy, rfl⟩
  haveI : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing R C
  obtain ⟨T, hT⟩ : ∃ T : Submonoid C, T = Algebra.algebraMapSubmonoid C (nonZeroDivisors R) :=
    ⟨_, rfl⟩
  have hTmem : ∀ x, x ∈ T ↔ ∃ r : R, r ≠ 0 ∧ algebraMap R C r = x := by
    intro x
    rw [hT]
    constructor
    · intro hx
      obtain ⟨r, hr, rfl⟩ := Submonoid.mem_map.mp hx
      exact ⟨r, nonZeroDivisors.ne_zero hr, rfl⟩
    · rintro ⟨r, hr, rfl⟩
      exact Algebra.mem_algebraMapSubmonoid_of_mem
        (⟨r, mem_nonZeroDivisors_of_ne_zero hr⟩ : nonZeroDivisors R)
  obtain ⟨L, _, _, _⟩ : ∃ (L : Type u) (_ : CommRing L) (_ : Algebra C L), IsLocalization T L :=
    ⟨Localization T, inferInstance, inferInstance, inferInstance⟩
  haveI : IsNoetherianRing L := IsLocalization.isNoetherianRing T L inferInstance
  obtain ⟨ι, hιd⟩ : ∃ ι : PrimeSpectrum L → PrimeSpectrum C,
      ι = PrimeSpectrum.comap (algebraMap C L) := ⟨_, rfl⟩
  have hι : Topology.IsInducing ι := by
    rw [hιd]
    exact PrimeSpectrum.localization_comap_isInducing L T
  have hιapp : ∀ y, (ι y).asIdeal = Ideal.comap (algebraMap C L) y.asIdeal := by
    intro y
    rw [hιd, PrimeSpectrum.comap_asIdeal]

  have hrange : Set.range ι = PrimeSpectrum.comap (algebraMap R C) ⁻¹' {η} := by
    rw [hιd, PrimeSpectrum.localization_comap_range L T]
    ext Q
    simp only [Set.mem_setOf_eq, Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hd
      apply PrimeSpectrum.ext
      rw [hη, eq_bot_iff]
      intro r hr
      rw [Ideal.mem_bot]
      by_contra hr0
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at hr
      exact Set.disjoint_left.mp hd ((hTmem _).mpr ⟨r, hr0, rfl⟩) hr
    · intro hQ
      rw [Set.disjoint_left]
      intro x hxT hxQ
      obtain ⟨r, hr0, rfl⟩ := (hTmem x).mp hxT
      have hr : r ∈ (PrimeSpectrum.comap (algebraMap R C) Q).asIdeal := by
        rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
        exact hxQ
      rw [hQ, hη, Ideal.mem_bot] at hr
      exact hr0 hr
  have hx0 : PrimeSpectrum.comap (algebraMap R C) (PrimeSpectrum.comap (s : C →+* R) η) = η := by
    apply PrimeSpectrum.ext
    apply Ideal.ext
    intro r
    simp [PrimeSpectrum.comap_asIdeal]
  obtain ⟨y₀, hy₀⟩ : PrimeSpectrum.comap (s : C →+* R) η ∈ Set.range ι := by
    rw [hrange]
    exact hx0

  let D : TopologicalSpace.Clopens (PrimeSpectrum L) := ⟨connectedComponent y₀, hclopen _ y₀⟩
  obtain ⟨e, he⟩ : ∃ e : L, e = ((PrimeSpectrum.isIdempotentElemEquivClopens).symm D : L) :=
    ⟨_, rfl⟩
  have heid : e * e = e := by
    rw [he]
    exact (PrimeSpectrum.isIdempotentElemEquivClopens.symm D).2
  have hstar : ∀ y : PrimeSpectrum L, e ∉ y.asIdeal ↔ y ∈ connectedComponent y₀ := by
    intro y
    have h := PrimeSpectrum.basicOpen_isIdempotentElemEquivClopens_symm D
    rw [← he] at h
    have h2 : y ∈ PrimeSpectrum.basicOpen e ↔ y ∈ D.toOpens := by rw [h]
    rw [PrimeSpectrum.mem_basicOpen] at h2
    exact h2

  obtain ⟨⟨c₀, t⟩, hct⟩ := IsLocalization.mk'_surjective T (S := L) e
  have hct' : IsLocalization.mk' L c₀ t = e := hct
  obtain ⟨d, hd0, hdt⟩ := (hTmem t).mp t.2
  have hspec : e * algebraMap C L (algebraMap R C d) = algebraMap C L c₀ := by
    rw [← hct', hdt]
    exact IsLocalization.mk'_spec L c₀ t
  have hu : IsUnit (algebraMap C L (algebraMap R C d)) := by
    rw [hdt]
    exact IsLocalization.map_units L t
  have hzero : algebraMap C L (c₀ * (c₀ - algebraMap R C d)) = algebraMap C L 0 := by
    rw [map_zero, map_mul, map_sub, ← hspec]
    linear_combination (algebraMap C L (algebraMap R C d)) ^ 2 * heid
  obtain ⟨w, hw⟩ := (IsLocalization.eq_iff_exists T L).mp hzero
  obtain ⟨d₁, hd₁0, hd₁w⟩ := (hTmem w).mp w.2
  have hrel : algebraMap R C d₁ * (c₀ * (c₀ - algebraMap R C d)) = 0 := by
    rw [hd₁w, hw, mul_zero]
  have hF : ∀ y, c₀ ∈ (ι y).asIdeal ↔ e ∈ y.asIdeal := by
    intro y
    rw [hιapp, Ideal.mem_comap, ← hspec, Ideal.mul_unit_mem_iff_mem _ hu]
  have hsc : s c₀ ≠ 0 := by
    intro h0
    have h1 : e ∉ y₀.asIdeal := (hstar y₀).mpr mem_connectedComponent
    apply h1
    rw [← hF, hy₀, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hη]
    simp [h0]
  refine ⟨d₁ * d * s c₀, c₀, algebraMap R C d - c₀,
    mul_ne_zero (mul_ne_zero hd₁0 hd0) hsc, ?_, ?_, ?_⟩
  · intro Q hQ
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, map_mul, map_mul] at hQ
    have hd1Q : algebraMap R C d₁ ∉ Q.asIdeal := fun h =>
      hQ (Q.asIdeal.mul_mem_right _ (Q.asIdeal.mul_mem_right _ h))
    have hdQ : algebraMap R C d ∉ Q.asIdeal := fun h =>
      hQ (Q.asIdeal.mul_mem_right _ (Q.asIdeal.mul_mem_left _ h))
    have hmem : algebraMap R C d₁ * (c₀ * (c₀ - algebraMap R C d)) ∈ Q.asIdeal := by
      rw [hrel]
      exact Q.asIdeal.zero_mem
    have hor := (Q.isPrime.mem_or_mem hmem).resolve_left hd1Q
    have hor2 := Q.isPrime.mem_or_mem hor
    have hneg : algebraMap R C d - c₀ ∈ Q.asIdeal ↔ c₀ - algebraMap R C d ∈ Q.asIdeal := by
      rw [show algebraMap R C d - c₀ = -(c₀ - algebraMap R C d) by ring, Ideal.neg_mem_iff]
    rw [hneg]
    constructor
    · intro hc
      exact hor2.resolve_left hc
    · intro hc' hc
      apply hdQ
      have h3 := Q.asIdeal.sub_mem hc hc'
      rwa [sub_sub_cancel] at h3
  · intro Q hQ
    obtain ⟨y, rfl⟩ : Q ∈ Set.range ι := by
      rw [hrange]
      exact hQ
    rw [← hrange, ← hy₀, hcc ι y₀ y hι, ← hstar, hF]
  · intro q hq hsq
    exact hq (q.asIdeal.mul_mem_left _ hsq)

theorem wc_smooth_algclosed_connected_irreducible : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (Y : Scheme.{u}) (g : Y ⟶ Spec (.of Ω)) [Smooth g] [ConnectedSpace Y], IrreducibleSpace Y :=
by

  have s3 : ∀ (k A : Type u) [Field k] [CommRing A] [Algebra k A] [IsLocalRing A] [IsNoetherianRing A]
      [Algebra.FormallySmooth k A], Function.Surjective (algebraMap k (IsLocalRing.ResidueField A)) →
      IsDomain A := by
    intro k A _ _ _ _ _ _ hres
    classical
    have F2 : ∀ c : k, algebraMap k A c ∈ IsLocalRing.maximalIdeal A → c = 0 := by
      intro c hc
      by_contra hne
      have hu : IsUnit (algebraMap k A c) := (isUnit_iff_ne_zero.mpr hne).map _
      exact (IsLocalRing.mem_maximalIdeal _).mp hc hu
    have hres' : ∀ a : A, ∃ α : k, a - algebraMap k A α ∈ IsLocalRing.maximalIdeal A := by
      intro a
      obtain ⟨α, hα⟩ := hres (IsLocalRing.residue A a)
      refine ⟨α, ?_⟩
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← hα,
        IsScalarTower.algebraMap_apply k A (IsLocalRing.ResidueField A),
        IsLocalRing.ResidueField.algebraMap_eq, sub_self]
    obtain ⟨d, ⟨b⟩⟩ : ∃ d : ℕ, Nonempty (Module.Basis (Fin d) (IsLocalRing.ResidueField A)
        (IsLocalRing.CotangentSpace A)) := ⟨_, ⟨Module.finBasis _ _⟩⟩
    have hy : ∀ i, ∃ a : A, ∃ ha : a ∈ IsLocalRing.maximalIdeal A,
        (IsLocalRing.maximalIdeal A).toCotangent ⟨a, ha⟩ = b i := by
      intro i
      obtain ⟨⟨a, ha⟩, h⟩ := (IsLocalRing.maximalIdeal A).toCotangent_surjective (b i)
      exact ⟨a, ha, h⟩
    choose x hx hxb using hy
    have hmapI : Ideal.map (MvPolynomial.aeval x) (MvPolynomial.idealOfVars (Fin d) k) ≤
        IsLocalRing.maximalIdeal A := by
      show Ideal.map (MvPolynomial.aeval x) (Ideal.span (Set.range MvPolynomial.X)) ≤ _
      rw [Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
      simpa using hx i
    have hψ1 : ∀ p ∈ MvPolynomial.idealOfVars (Fin d) k,
        MvPolynomial.aeval x p ∈ IsLocalRing.maximalIdeal A :=
      fun p hp => hmapI (Ideal.mem_map_of_mem _ hp)
    have hψI : ∀ (n : ℕ) (p : MvPolynomial (Fin d) k), p ∈ MvPolynomial.idealOfVars (Fin d) k ^ n →
        MvPolynomial.aeval x p ∈ IsLocalRing.maximalIdeal A ^ n := by
      intro n p hp
      have h1 : Ideal.map (MvPolynomial.aeval x) (MvPolynomial.idealOfVars (Fin d) k ^ n) ≤
          IsLocalRing.maximalIdeal A ^ n := by
        rw [Ideal.map_pow]; exact Ideal.pow_right_mono hmapI n
      exact h1 (Ideal.mem_map_of_mem _ hp)
    have hI1 : ∀ r : MvPolynomial (Fin d) k, MvPolynomial.constantCoeff r = 0 →
        r ∈ MvPolynomial.idealOfVars (Fin d) k := by
      intro r hr
      have := (MvPolynomial.mem_pow_idealOfVars_iff' 1 r).mpr (by
        intro e he
        have h0 : e = 0 := (Finsupp.degree_eq_zero_iff e).mp (by omega)
        subst h0
        rw [← MvPolynomial.constantCoeff_eq]; exact hr)
      simpa using this
    have hcc : ∀ r : MvPolynomial (Fin d) k, r ∈ MvPolynomial.idealOfVars (Fin d) k →
        MvPolynomial.constantCoeff r = 0 := by
      intro r hr
      rw [← pow_one (MvPolynomial.idealOfVars (Fin d) k), MvPolynomial.mem_pow_idealOfVars_iff'] at hr
      rw [MvPolynomial.constantCoeff_eq]
      exact hr 0 (by simp)
    have F1 : ∀ r : MvPolynomial (Fin d) k, MvPolynomial.aeval x r -
        algebraMap k A (MvPolynomial.constantCoeff r) ∈ IsLocalRing.maximalIdeal A := by
      intro r
      have h := hψ1 (r - MvPolynomial.C (MvPolynomial.constantCoeff r)) (hI1 _ (by simp))
      simpa using h

    have Hspan : ∀ a ∈ IsLocalRing.maximalIdeal A, ∃ c : Fin d → A,
        a - ∑ i, c i * x i ∈ IsLocalRing.maximalIdeal A ^ 2 := by
      intro a ha
      have hrep := b.sum_repr ((IsLocalRing.maximalIdeal A).toCotangent ⟨a, ha⟩)
      choose c hc using fun i => IsLocalRing.residue_surjective
        (b.repr ((IsLocalRing.maximalIdeal A).toCotangent ⟨a, ha⟩) i)
      refine ⟨c, ?_⟩
      have hmem : a - ∑ i, c i * x i ∈ IsLocalRing.maximalIdeal A :=
        sub_mem ha (Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hx i)))
      refine ((IsLocalRing.maximalIdeal A).toCotangent_eq_zero ⟨_, hmem⟩).mp ?_
      have e1 : (⟨a - ∑ i, c i * x i, hmem⟩ : IsLocalRing.maximalIdeal A) =
          ⟨a, ha⟩ - ∑ i, c i • (⟨x i, hx i⟩ : IsLocalRing.maximalIdeal A) := by
        ext; simp
      have e2 : ∑ i, c i • b i = (IsLocalRing.maximalIdeal A).toCotangent ⟨a, ha⟩ := by
        conv_rhs => rw [← hrep]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [← hc i, ← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul]
      rw [e1, map_sub, map_sum]
      simp_rw [map_smul, hxb]
      rw [e2, sub_self]
    have Q1 : ∀ c ∈ IsLocalRing.maximalIdeal A, ∃ p ∈ MvPolynomial.idealOfVars (Fin d) k,
        c - MvPolynomial.aeval x p ∈ IsLocalRing.maximalIdeal A ^ 2 := by
      intro c hc
      obtain ⟨a, ha⟩ := Hspan c hc
      choose α hα using fun i => hres' (a i)
      refine ⟨∑ i, MvPolynomial.C (α i) * MvPolynomial.X i, ?_, ?_⟩
      · exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))
      · have e : c - MvPolynomial.aeval x (∑ i, MvPolynomial.C (α i) * MvPolynomial.X i) =
            (c - ∑ i, a i * x i) + ∑ i, (a i - algebraMap k A (α i)) * x i := by
          simp only [map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X, sub_mul,
            Finset.sum_sub_distrib]
          ring
        rw [e]
        refine Ideal.add_mem _ ha (Ideal.sum_mem _ (fun i _ => ?_))
        rw [pow_two]; exact Ideal.mul_mem_mul (hα i) (hx i)
    have Q : ∀ n : ℕ, ∀ c ∈ IsLocalRing.maximalIdeal A ^ n,
        ∃ p ∈ MvPolynomial.idealOfVars (Fin d) k ^ n,
          c - MvPolynomial.aeval x p ∈ IsLocalRing.maximalIdeal A ^ (n + 1) := by
      intro n
      induction n with
      | zero =>
        intro c _
        obtain ⟨α, hα⟩ := hres' c
        exact ⟨MvPolynomial.C α, by simp, by simpa using hα⟩
      | succ n ih =>
        intro c hc
        rw [pow_succ'] at hc
        refine Submodule.mul_induction_on hc ?_ ?_
        · intro u hu v hv
          obtain ⟨p, hp, hpe⟩ := Q1 u hu
          obtain ⟨q, hq, hqe⟩ := ih v hv
          refine ⟨p * q, ?_, ?_⟩
          · rw [pow_succ']; exact Ideal.mul_mem_mul hp hq
          · have e : u * v - MvPolynomial.aeval x (p * q) =
                (u - MvPolynomial.aeval x p) * v +
                  MvPolynomial.aeval x p * (v - MvPolynomial.aeval x q) := by
              rw [map_mul]; ring
            rw [e]
            refine Ideal.add_mem _ ?_ ?_
            · have h := Ideal.mul_mem_mul hpe hv
              rw [← pow_add, show 2 + n = n + 1 + 1 by omega] at h
              exact h
            · have h := Ideal.mul_mem_mul (hψ1 p hp) hqe
              rw [← pow_succ'] at h
              exact h
        · rintro c₁ c₂ ⟨p₁, hp₁, h₁⟩ ⟨p₂, hp₂, h₂⟩
          refine ⟨p₁ + p₂, Ideal.add_mem _ hp₁ hp₂, ?_⟩
          have e : c₁ + c₂ - MvPolynomial.aeval x (p₁ + p₂) =
              (c₁ - MvPolynomial.aeval x p₁) + (c₂ - MvPolynomial.aeval x p₂) := by
            rw [map_add]; ring
          rw [e]; exact Ideal.add_mem _ h₁ h₂
    have approx : ∀ (n : ℕ) (c : A), ∃ p : MvPolynomial (Fin d) k,
        c - MvPolynomial.aeval x p ∈ IsLocalRing.maximalIdeal A ^ n := by
      intro n c
      induction n with
      | zero => exact ⟨0, by simp⟩
      | succ n ih =>
        obtain ⟨p, hp⟩ := ih
        obtain ⟨q, -, hq⟩ := Q n _ hp
        refine ⟨p + q, ?_⟩
        have e : c - MvPolynomial.aeval x (p + q) =
            c - MvPolynomial.aeval x p - MvPolynomial.aeval x q := by
          rw [map_add]; ring
        rw [e]; exact hq

    have ord : ∀ (i j : ℕ) (p q : MvPolynomial (Fin d) k),
        p ∉ MvPolynomial.idealOfVars (Fin d) k ^ (i + 1) →
        q ∉ MvPolynomial.idealOfVars (Fin d) k ^ (j + 1) →
        p * q ∉ MvPolynomial.idealOfVars (Fin d) k ^ (i + j + 1) := by
      intro i j p q hp hq hpq
      rw [MvPolynomial.mem_pow_idealOfVars_iff'] at hp hq hpq
      push_neg at hp hq
      obtain ⟨e, he, hpe⟩ := hp
      obtain ⟨f, hf, hqf⟩ := hq
      have h1 : (p : MvPowerSeries (Fin d) k).order ≤ (i : ℕ∞) := by
        refine le_trans (MvPowerSeries.order_le (d := e) (by rwa [MvPolynomial.coeff_coe])) ?_
        exact_mod_cast (by omega : Finsupp.degree e ≤ i)
      have h2 : (q : MvPowerSeries (Fin d) k).order ≤ (j : ℕ∞) := by
        refine le_trans (MvPowerSeries.order_le (d := f) (by rwa [MvPolynomial.coeff_coe])) ?_
        exact_mod_cast (by omega : Finsupp.degree f ≤ j)
      have h3 : ((i + j + 1 : ℕ) : ℕ∞) ≤
          ((p * q : MvPolynomial (Fin d) k) : MvPowerSeries (Fin d) k).order := by
        apply MvPowerSeries.le_order
        intro e' he'
        rw [MvPolynomial.coeff_coe]
        exact hpq e' (by exact_mod_cast he')
      rw [MvPolynomial.coe_mul, MvPowerSeries.order_mul] at h3
      have h5 := h3.trans (add_le_add h1 h2)
      norm_cast at h5
      omega

    have unip : ∀ (N : ℕ) (χ : MvPolynomial (Fin d) k →ₐ[k]
        MvPolynomial (Fin d) k ⧸ MvPolynomial.idealOfVars (Fin d) k ^ N),
        (∀ i, χ (MvPolynomial.X i) - Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin d) k ^ N)
          (MvPolynomial.X i) ∈ Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin d) k ^ N))
            (MvPolynomial.idealOfVars (Fin d) k ^ 2)) →
        ∀ p, χ p = 0 → p ∈ MvPolynomial.idealOfVars (Fin d) k ^ N := by
      intro N χ hχ p hp
      have hh : ∀ i, ∃ h ∈ MvPolynomial.idealOfVars (Fin d) k ^ 2,
          Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin d) k ^ N) h =
            χ (MvPolynomial.X i) - Ideal.Quotient.mk _ (MvPolynomial.X i) :=
        fun i => (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp (hχ i)
      choose h hI2 hhχ using hh
      let θ : MvPolynomial (Fin d) k →ₐ[k] MvPolynomial (Fin d) k :=
        MvPolynomial.aeval (fun i => MvPolynomial.X i + h i)
      have hθX : ∀ i, θ (MvPolynomial.X i) = MvPolynomial.X i + h i := fun i => by
        simp only [θ, MvPolynomial.aeval_X]
      have hθχ : ∀ r, Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin d) k ^ N) (θ r) = χ r := by
        have : (Ideal.Quotient.mkₐ k (MvPolynomial.idealOfVars (Fin d) k ^ N)).comp θ = χ := by
          apply MvPolynomial.algHom_ext
          intro i
          rw [AlgHom.comp_apply, hθX, Ideal.Quotient.mkₐ_eq_mk, map_add, hhχ]
          ring
        intro r
        rw [← this]; rfl
      have hhI : ∀ i, h i ∈ MvPolynomial.idealOfVars (Fin d) k :=
        fun i => Ideal.pow_le_self two_ne_zero (hI2 i)
      have hθc : ∀ r, MvPolynomial.constantCoeff (θ r) = MvPolynomial.constantCoeff r := by
        intro r
        have : (MvPolynomial.constantCoeff : MvPolynomial (Fin d) k →+* k).comp θ.toRingHom =
            MvPolynomial.constantCoeff := by
          apply MvPolynomial.ringHom_ext
          · intro a
            change MvPolynomial.constantCoeff (θ (MvPolynomial.C a)) =
              MvPolynomial.constantCoeff (MvPolynomial.C a)
            rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
          · intro i
            change MvPolynomial.constantCoeff (θ (MvPolynomial.X i)) =
              MvPolynomial.constantCoeff (MvPolynomial.X i)
            rw [hθX, map_add, hcc _ (hhI i), add_zero]
        exact RingHom.congr_fun this r
      have C0 : ∀ r, θ r - r ∈ MvPolynomial.idealOfVars (Fin d) k :=
        fun r => hI1 _ (by rw [map_sub, hθc, sub_self])
      have C1 : ∀ r ∈ MvPolynomial.idealOfVars (Fin d) k,
          θ r - r ∈ MvPolynomial.idealOfVars (Fin d) k ^ 2 := by
        intro r hr
        obtain ⟨c, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hr
        have e : θ (∑ i, c i * MvPolynomial.X i) - ∑ i, c i * MvPolynomial.X i =
            ∑ i, ((θ (c i) - c i) * (MvPolynomial.X i + h i) + c i * h i) := by
          rw [map_sum, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [map_mul, hθX]; ring
        rw [e]
        refine Ideal.sum_mem _ (fun i _ => Ideal.add_mem _ ?_ (Ideal.mul_mem_left _ _ (hI2 i)))
        rw [pow_two]
        exact Ideal.mul_mem_mul (C0 _) (Ideal.add_mem _ (Ideal.subset_span ⟨i, rfl⟩) (hhI i))
      have Cj : ∀ j : ℕ, ∀ r ∈ MvPolynomial.idealOfVars (Fin d) k ^ j,
          θ r - r ∈ MvPolynomial.idealOfVars (Fin d) k ^ (j + 1) := by
        intro j
        induction j with
        | zero => intro r _; simpa using C0 r
        | succ j ih =>
          intro r hr
          rw [pow_succ'] at hr
          refine Submodule.mul_induction_on hr ?_ ?_
          · intro u hu v hv
            have hθv : θ v ∈ MvPolynomial.idealOfVars (Fin d) k ^ j := by
              have := Ideal.add_mem _ (Ideal.pow_le_pow_right (Nat.le_succ j) (ih v hv)) hv
              simpa using this
            have e : θ (u * v) - u * v = (θ u - u) * θ v + u * (θ v - v) := by
              rw [map_mul]; ring
            rw [e]
            refine Ideal.add_mem _ ?_ ?_
            · have h' := Ideal.mul_mem_mul (C1 u hu) hθv
              rw [← pow_add, show 2 + j = j + 1 + 1 by omega] at h'
              exact h'
            · have h' := Ideal.mul_mem_mul hu (ih v hv)
              rw [← pow_succ'] at h'
              exact h'
          · intro r₁ r₂ h₁ h₂
            have e : θ (r₁ + r₂) - (r₁ + r₂) = (θ r₁ - r₁) + (θ r₂ - r₂) := by
              rw [map_add]; ring
            rw [e]; exact Ideal.add_mem _ h₁ h₂
      have hθp : θ p ∈ MvPolynomial.idealOfVars (Fin d) k ^ N :=
        Ideal.Quotient.eq_zero_iff_mem.mp (by rw [hθχ]; exact hp)
      have key : ∀ j ≤ N, p ∈ MvPolynomial.idealOfVars (Fin d) k ^ j := by
        intro j
        induction j with
        | zero => intro _; simp
        | succ j ih =>
          intro hj
          have h1 := Cj j p (ih (by omega))
          have h2 : θ p ∈ MvPolynomial.idealOfVars (Fin d) k ^ (j + 1) :=
            Ideal.pow_le_pow_right hj hθp
          have := Ideal.sub_mem _ h2 h1
          simpa using this
      exact key N le_rfl

    have inj2 : ∀ r : MvPolynomial (Fin d) k, MvPolynomial.aeval x r ∈ IsLocalRing.maximalIdeal A ^ 2 →
        r ∈ MvPolynomial.idealOfVars (Fin d) k ^ 2 := by
      intro r hr
      have hr1 : MvPolynomial.aeval x r ∈ IsLocalRing.maximalIdeal A :=
        Ideal.pow_le_self two_ne_zero hr
      have hc0 : MvPolynomial.constantCoeff r = 0 :=
        F2 _ (by have := Ideal.sub_mem _ hr1 (F1 r); simpa using this)
      obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp (hI1 r hc0)
      obtain ⟨γ, hγdef⟩ : ∃ γ : Fin d → k, γ = fun i => MvPolynomial.constantCoeff (c i) := ⟨_, rfl⟩
      have hrem : r - ∑ i, MvPolynomial.C (γ i) * MvPolynomial.X i ∈
          MvPolynomial.idealOfVars (Fin d) k ^ 2 := by
        rw [← hc, ← Finset.sum_sub_distrib]
        refine Ideal.sum_mem _ (fun i _ => ?_)
        rw [← sub_mul, pow_two]
        exact Ideal.mul_mem_mul (hI1 _ (by simp [hγdef])) (Ideal.subset_span ⟨i, rfl⟩)
      have hlin : ∑ i, algebraMap k A (γ i) * x i ∈ IsLocalRing.maximalIdeal A ^ 2 := by
        have h2 := Ideal.sub_mem _ hr (hψI 2 _ hrem)
        have e : MvPolynomial.aeval x r - MvPolynomial.aeval x
            (r - ∑ i, MvPolynomial.C (γ i) * MvPolynomial.X i) =
              ∑ i, algebraMap k A (γ i) * x i := by
          simp [map_sum]
        rwa [e] at h2
      have hγ : ∀ i, γ i = 0 := by
        have hmem : ∑ i, algebraMap k A (γ i) * x i ∈ IsLocalRing.maximalIdeal A :=
          Ideal.pow_le_self two_ne_zero hlin
        have h0 := ((IsLocalRing.maximalIdeal A).toCotangent_eq_zero ⟨_, hmem⟩).mpr hlin
        have e1 : (⟨∑ i, algebraMap k A (γ i) * x i, hmem⟩ : IsLocalRing.maximalIdeal A) =
            ∑ i, algebraMap k A (γ i) • (⟨x i, hx i⟩ : IsLocalRing.maximalIdeal A) := by
          ext; simp [Algebra.smul_def]
        rw [e1, map_sum] at h0
        simp_rw [map_smul, hxb] at h0
        have hli := Fintype.linearIndependent_iff.mp b.linearIndependent
          (fun i => IsLocalRing.residue A (algebraMap k A (γ i))) (by
            refine Eq.trans (Finset.sum_congr rfl (fun i _ => ?_)) h0
            rw [← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul])
        intro i
        exact F2 _ ((IsLocalRing.residue_eq_zero_iff _).mp (hli i))
      have h0 : ∑ i, MvPolynomial.C (γ i) * MvPolynomial.X i = (0 : MvPolynomial (Fin d) k) := by
        simp [hγ]
      rw [h0, sub_zero] at hrem
      exact hrem
    have hH2 : MvPolynomial.idealOfVars (Fin d) k ^ 2 ≤
        Ideal.comap (MvPolynomial.aeval x) (IsLocalRing.maximalIdeal A ^ 2) := fun p hp => hψI 2 p hp
    let ψ2 := Ideal.quotientMapₐ (I := MvPolynomial.idealOfVars (Fin d) k ^ 2)
      (IsLocalRing.maximalIdeal A ^ 2) (MvPolynomial.aeval x) (fun p hp => hH2 hp)
    have hψ2 : ∀ r, ψ2 (Ideal.Quotient.mk _ r) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ 2) (MvPolynomial.aeval x r) := fun r => rfl
    have hbij : Function.Bijective ψ2 := by
      constructor
      · rw [injective_iff_map_eq_zero]
        intro z hz
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
        rw [hψ2, Ideal.Quotient.eq_zero_iff_mem] at hz
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (inj2 r hz)
      · intro z
        obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective z
        obtain ⟨p, hp⟩ := approx 2 c
        exact ⟨Ideal.Quotient.mk _ p, by rw [hψ2]; exact (Ideal.Quotient.eq.mpr hp).symm⟩
    let e2 := AlgEquiv.ofBijective ψ2 hbij
    let φ2 : A →ₐ[k] MvPolynomial (Fin d) k ⧸ MvPolynomial.idealOfVars (Fin d) k ^ 2 :=
      e2.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k (IsLocalRing.maximalIdeal A ^ 2))
    have he2 : ∀ z, e2 z = ψ2 z := fun z => rfl
    have hφ2x : ∀ i, φ2 (x i) = Ideal.Quotient.mk _ (MvPolynomial.X i) := by
      intro i
      show e2.symm (Ideal.Quotient.mkₐ k (IsLocalRing.maximalIdeal A ^ 2) (x i)) = _
      rw [AlgEquiv.symm_apply_eq, he2, hψ2, MvPolynomial.aeval_X]; rfl
    have hφ2m : ∀ a ∈ IsLocalRing.maximalIdeal A, φ2 a ∈
        Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin d) k ^ 2))
          (MvPolynomial.idealOfVars (Fin d) k) := by
      intro a ha
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (φ2 a)
      have h1 : ψ2 (Ideal.Quotient.mk _ r) =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ 2) a := by
        rw [hr, ← he2]
        show e2 (e2.symm _) = _
        rw [AlgEquiv.apply_symm_apply]; rfl
      rw [hψ2, Ideal.Quotient.eq] at h1
      have h2 : MvPolynomial.aeval x r ∈ IsLocalRing.maximalIdeal A := by
        have := Ideal.add_mem _ (Ideal.pow_le_self two_ne_zero h1) ha; simpa using this
      have h3 : MvPolynomial.constantCoeff r = 0 :=
        F2 _ (by have := Ideal.sub_mem _ h2 (F1 r); simpa using this)
      rw [← hr]; exact Ideal.mem_map_of_mem _ (hI1 r h3)

    have tower : ∀ N : ℕ, 2 ≤ N → ∃ φ : A →ₐ[k]
        MvPolynomial (Fin d) k ⧸ MvPolynomial.idealOfVars (Fin d) k ^ N,
        (∀ i, φ (x i) - Ideal.Quotient.mk _ (MvPolynomial.X i) ∈
          Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin d) k ^ N))
            (MvPolynomial.idealOfVars (Fin d) k ^ 2)) ∧
        (∀ a ∈ IsLocalRing.maximalIdeal A, φ a ∈
          Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin d) k ^ N))
            (MvPolynomial.idealOfVars (Fin d) k)) := by
      intro N hN
      induction N, hN using Nat.le_induction with
      | base => exact ⟨φ2, fun i => by rw [hφ2x, sub_self]; exact Ideal.zero_mem _, hφ2m⟩
      | succ N hN ih =>
        obtain ⟨φ, hφ1, hφ2⟩ := ih
        have hle : MvPolynomial.idealOfVars (Fin d) k ^ (N + 1) ≤
            MvPolynomial.idealOfVars (Fin d) k ^ N := Ideal.pow_le_pow_right (Nat.le_succ N)
        let J := Ideal.map (Ideal.Quotient.mkₐ k (MvPolynomial.idealOfVars (Fin d) k ^ (N + 1)))
          (MvPolynomial.idealOfVars (Fin d) k ^ N)
        have hJ : IsNilpotent J := by
          refine ⟨2, ?_⟩
          show Ideal.map (Ideal.Quotient.mkₐ k (MvPolynomial.idealOfVars (Fin d) k ^ (N + 1)))
            (MvPolynomial.idealOfVars (Fin d) k ^ N) ^ 2 = 0
          rw [Ideal.zero_eq_bot, ← Ideal.map_pow, ← pow_mul, eq_bot_iff, Ideal.map_le_iff_le_comap]
          intro s hs
          rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.Quotient.mkₐ_eq_mk,
            Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.pow_le_pow_right (by omega) hs
        let E := DoubleQuot.quotQuotEquivQuotOfLEₐ k hle
        obtain ⟨f, hf⟩ := Algebra.FormallySmooth.exists_lift J hJ (E.symm.toAlgHom.comp φ)
        let π : MvPolynomial (Fin d) k ⧸ MvPolynomial.idealOfVars (Fin d) k ^ (N + 1) →ₐ[k]
            MvPolynomial (Fin d) k ⧸ MvPolynomial.idealOfVars (Fin d) k ^ N :=
          E.toAlgHom.comp (Ideal.Quotient.mkₐ k J)
        have hπ : ∀ s, π (Ideal.Quotient.mk _ s) = Ideal.Quotient.mk _ s := fun s => rfl
        have hπf : ∀ a, π (f a) = φ a := by
          intro a
          have h1 := AlgHom.congr_fun hf a
          show E (Ideal.Quotient.mkₐ k J (f a)) = φ a
          rw [AlgHom.comp_apply] at h1
          rw [h1]
          simp
        have T : ∀ L : Ideal (MvPolynomial (Fin d) k), MvPolynomial.idealOfVars (Fin d) k ^ N ≤ L →
            ∀ w, π w ∈ Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin d) k ^ N)) L →
            w ∈ Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin d) k ^ (N + 1))) L := by
          intro L hL w hw
          obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective w
          rw [hπ] at hw
          obtain ⟨t, ht, hts⟩ :=
            (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hw
          have hst : t - s ∈ L := hL (Ideal.Quotient.eq.mp hts)
          have hs : s ∈ L := by have := Ideal.sub_mem _ ht hst; simpa using this
          exact Ideal.mem_map_of_mem _ hs
        refine ⟨f, fun i => T _ (Ideal.pow_le_pow_right hN) _ ?_,
          fun a ha => T _ (Ideal.pow_le_self (by omega)) _ ?_⟩
        · rw [map_sub, hπf, hπ]; exact hφ1 i
        · rw [hπf]; exact hφ2 a ha
    have jet : ∀ N : ℕ, 2 ≤ N → ∀ r : MvPolynomial (Fin d) k,
        MvPolynomial.aeval x r ∈ IsLocalRing.maximalIdeal A ^ N →
        r ∈ MvPolynomial.idealOfVars (Fin d) k ^ N := by
      intro N hN r hr
      obtain ⟨φ, hφ1, hφ2⟩ := tower N hN
      apply unip N (φ.comp (MvPolynomial.aeval x))
      · intro i
        rw [AlgHom.comp_apply, MvPolynomial.aeval_X]; exact hφ1 i
      · rw [AlgHom.comp_apply]
        have h1 : Ideal.map φ (IsLocalRing.maximalIdeal A ^ N) ≤
            Ideal.map (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin d) k ^ N))
              (MvPolynomial.idealOfVars (Fin d) k ^ N) := by
          rw [Ideal.map_pow, Ideal.map_pow]
          apply Ideal.pow_right_mono
          rw [Ideal.map_le_iff_le_comap]
          intro a ha; exact hφ2 a ha
        have h2 := h1 (Ideal.mem_map_of_mem φ hr)
        rw [Ideal.map_quotient_self, Ideal.mem_bot] at h2
        exact h2

    haveI : NoZeroDivisors A := by
      constructor
      intro a c hac
      by_contra hcon
      push_neg at hcon
      obtain ⟨ha, hc⟩ := hcon
      have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal A)
        (inferInstance : (IsLocalRing.maximalIdeal A).IsMaximal).ne_top
      have hex : ∀ z : A, z ≠ 0 → ∃ i, z ∉ IsLocalRing.maximalIdeal A ^ (i + 1) := by
        intro z hz
        by_contra hall
        push_neg at hall
        apply hz
        have hz' : z ∈ ⨅ i, IsLocalRing.maximalIdeal A ^ i := by
          rw [Ideal.mem_iInf]
          intro i
          exact Ideal.pow_le_pow_right (Nat.le_succ i) (hall i)
        rw [hK] at hz'
        exact hz'
      obtain ⟨i, hi⟩ := hex a ha
      obtain ⟨j, hj⟩ := hex c hc
      obtain ⟨p, hp⟩ := approx (i + j + 2) a
      obtain ⟨q, hq⟩ := approx (i + j + 2) c
      have hpI : p ∉ MvPolynomial.idealOfVars (Fin d) k ^ (i + 1) := by
        intro hpI
        apply hi
        have h2 : a - MvPolynomial.aeval x p ∈ IsLocalRing.maximalIdeal A ^ (i + 1) :=
          Ideal.pow_le_pow_right (by omega) hp
        have := Ideal.add_mem _ h2 (hψI _ _ hpI)
        simpa using this
      have hqI : q ∉ MvPolynomial.idealOfVars (Fin d) k ^ (j + 1) := by
        intro hqI
        apply hj
        have h2 : c - MvPolynomial.aeval x q ∈ IsLocalRing.maximalIdeal A ^ (j + 1) :=
          Ideal.pow_le_pow_right (by omega) hq
        have := Ideal.add_mem _ h2 (hψI _ _ hqI)
        simpa using this
      apply ord i j p q hpI hqI
      have hψpq : MvPolynomial.aeval x (p * q) ∈ IsLocalRing.maximalIdeal A ^ (i + j + 2) := by
        have e : MvPolynomial.aeval x (p * q) =
            -((a - MvPolynomial.aeval x p) * MvPolynomial.aeval x q +
              a * (c - MvPolynomial.aeval x q)) + a * c := by
          rw [map_mul]; ring
        rw [e, hac, add_zero]
        exact neg_mem (Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ hq))
      exact Ideal.pow_le_pow_right (by omega) (jet _ (by omega) _ hψpq)
    exact NoZeroDivisors.to_isDomain A
  intro Ω _ _ Y g _ _

  have s1 : ∀ (X : Type u) [TopologicalSpace X] [ConnectedSpace X],
      (∀ x : X, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ IsPreirreducible U) → IrreducibleSpace X := by
    intro X _ _ hloc
    choose U hUo hxU hUp using hloc
    have key : ∀ (V O : Set X), IsPreirreducible V → IsOpen O → (V ∩ O).Nonempty →
        V ⊆ closure O := by
      intro V O hVp hOo hVO v hv
      rw [mem_closure_iff]
      intro W hWo hvW
      obtain ⟨z, _, hzW, hzO⟩ := hVp W O hWo hOo ⟨v, hv, hvW⟩ hVO
      exact ⟨z, hzW, hzO⟩
    obtain ⟨x₀⟩ := (ConnectedSpace.toNonempty : Nonempty X)
    have hZirr : IsIrreducible (closure (U x₀)) := IsIrreducible.closure ⟨⟨x₀, hxU x₀⟩, hUp x₀⟩
    have hZopen : IsOpen (closure (U x₀)) := by
      rw [isOpen_iff_forall_mem_open]
      intro z hz
      refine ⟨U z, ?_, hUo z, hxU z⟩
      exact key (U z) (U x₀) (hUp z) (hUo x₀) ((mem_closure_iff.mp hz) (U z) (hUo z) (hxU z))
    have hZuniv : closure (U x₀) = Set.univ :=
      IsClopen.eq_univ ⟨isClosed_closure, hZopen⟩ ⟨x₀, subset_closure (hxU x₀)⟩
    rw [irreducibleSpace_def]
    have h : (⊤ : Set X) = closure (U x₀) := hZuniv.symm
    rw [h]; exact hZirr

  have s2 : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B],
      (∀ (m : Ideal B) [m.IsMaximal], IsDomain (Localization.AtPrime m)) →
      ∀ x : PrimeSpectrum B, ∃ U : Set (PrimeSpectrum B), IsOpen U ∧ x ∈ U ∧ IsPreirreducible U := by
    intro B _ _ hdom x
    obtain ⟨m, hm, hxm⟩ := Ideal.exists_le_maximal x.asIdeal x.isPrime.ne_top
    haveI := hdom m
    let M : PrimeSpectrum B := ⟨m, hm.isPrime⟩
    let K : Ideal B := RingHom.ker (algebraMap B (Localization.AtPrime m))
    haveI hK : K.IsPrime := RingHom.ker_isPrime _
    let PK : PrimeSpectrum B := ⟨K, hK⟩
    have hC0 : IsIrreducible (PrimeSpectrum.zeroLocus (K : Set B)) := by
      have h : closure {PK} = PrimeSpectrum.zeroLocus (K : Set B) :=
        PrimeSpectrum.closure_singleton PK
      rw [← h]; exact isIrreducible_singleton.closure
    have hKle : ∀ P : Ideal B, P.IsPrime → P ≤ m → K ≤ P := by
      intro P hP hPm b hb
      have hb' : algebraMap B (Localization.AtPrime m) b = 0 := hb
      obtain ⟨⟨s, hs⟩, hsb⟩ := (IsLocalization.map_eq_zero_iff m.primeCompl _ b).mp hb'
      have h0 : s * b ∈ P := by
        have : s * b = 0 := hsb
        rw [this]; exact P.zero_mem
      exact (hP.mem_or_mem h0).resolve_left (fun h => hs (hPm h))
    have hcomp : ∀ C ∈ irreducibleComponents (PrimeSpectrum B), M ∈ C →
        C ⊆ PrimeSpectrum.zeroLocus (K : Set B) := by
      intro C hC hMC
      have hCirr : IsIrreducible C := hC.1
      have hCcl : IsClosed C := isClosed_of_mem_irreducibleComponents C hC
      have hP := PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp hCirr
      have hPm : PrimeSpectrum.vanishingIdeal C ≤ m := fun f hf =>
        (PrimeSpectrum.mem_vanishingIdeal C f).mp hf M hMC
      have hKP := hKle _ hP hPm
      have hCeq : C = PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal C : Set B) := by
        rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hCcl.closure_eq]
      rw [hCeq]
      exact PrimeSpectrum.zeroLocus_anti_mono hKP
    have hfin := TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := PrimeSpectrum B)
    let S := {C ∈ irreducibleComponents (PrimeSpectrum B) | M ∉ C}
    have hSfin : S.Finite := hfin.subset (fun C hC => hC.1)
    have hUo : IsOpen (⋂ C ∈ S, Cᶜ) :=
      hSfin.isOpen_biInter (fun C hC => (isClosed_of_mem_irreducibleComponents C hC.1).isOpen_compl)
    refine ⟨⋂ C ∈ S, Cᶜ, hUo, ?_, ?_⟩
    · rw [Set.mem_iInter₂]
      intro C hC hxC
      apply hC.2
      have hsp : x ⤳ M := (PrimeSpectrum.le_iff_specializes x M).mp hxm
      exact hsp.mem_closed (isClosed_of_mem_irreducibleComponents C hC.1) hxC
    · apply hC0.isPreirreducible.open_subset hUo
      intro y hy
      have hyC := irreducibleComponent_mem_irreducibleComponents y
      by_cases hMy : M ∈ irreducibleComponent y
      · exact hcomp _ hyC hMy mem_irreducibleComponent
      · exfalso
        exact (Set.mem_iInter₂.mp hy (irreducibleComponent y) ⟨hyC, hMy⟩) mem_irreducibleComponent

  apply s1
  intro y
  obtain ⟨W, hW, hyW, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
  have e : W ≤ g ⁻¹ᵁ (⊤ : (Spec (.of Ω)).Opens) := by simp
  have hsm := HasRingHomProperty.appLE @Smooth g inferInstance ⟨⊤, isAffineOpen_top _⟩ ⟨W, hW⟩ e
  let f₀ : Ω →+* Γ(Y, W) := (g.appLE ⊤ W e).hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
  have hf₀ : f₀.Smooth := RingHom.Smooth.comp
    (RingHom.Smooth.of_bijective
      ((Scheme.ΓSpecIso (CommRingCat.of Ω)).symm.commRingCatIsoToRingEquiv).bijective) hsm
  letI : Algebra Ω Γ(Y, W) := f₀.toAlgebra
  haveI : Algebra.Smooth Ω Γ(Y, W) := hf₀
  haveI : Algebra.FinitePresentation Ω Γ(Y, W) := Algebra.Smooth.finitePresentation
  haveI : Algebra.FiniteType Ω Γ(Y, W) := inferInstance
  haveI : IsNoetherianRing Ω :=
    @PrincipalIdealRing.isNoetherianRing Ω _ (DivisionSemiring.isPrincipalIdealRing Ω)
  haveI : IsNoetherianRing Γ(Y, W) := Algebra.FiniteType.isNoetherianRing Ω Γ(Y, W)
  have hdom : ∀ (m : Ideal Γ(Y, W)) [m.IsMaximal], IsDomain (Localization.AtPrime m) := by
    intro m _
    haveI : IsNoetherianRing (Localization.AtPrime m) :=
      IsLocalization.isNoetherianRing m.primeCompl _ inferInstance
    haveI : Algebra.FormallySmooth Γ(Y, W) (Localization.AtPrime m) :=
      Algebra.FormallySmooth.of_isLocalization m.primeCompl
    haveI : Algebra.FormallySmooth Ω (Localization.AtPrime m) :=
      Algebra.FormallySmooth.comp Ω Γ(Y, W) _
    have hsurj : Function.Surjective
        (algebraMap Ω (IsLocalRing.ResidueField (Localization.AtPrime m))) := by
      letI : Field (Γ(Y, W) ⧸ m) := Ideal.Quotient.field m
      haveI : Algebra.FiniteType Ω (Γ(Y, W) ⧸ m) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω m)
          (Ideal.Quotient.mkₐ_surjective Ω m)
      haveI : Module.Finite Ω (Γ(Y, W) ⧸ m) := finite_of_finite_type_of_isJacobsonRing Ω _
      haveI : Algebra.IsIntegral Ω (Γ(Y, W) ⧸ m) := Algebra.IsIntegral.of_finite Ω _
      haveI : IsDomain (Γ(Y, W) ⧸ m) := Ideal.Quotient.isDomain m
      have hb := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := Γ(Y, W) ⧸ m)
      have hb2 := Ideal.bijective_algebraMap_quotient_residueField m
      have heq : algebraMap Ω m.ResidueField =
          (algebraMap (Γ(Y, W) ⧸ m) m.ResidueField).comp (algebraMap Ω (Γ(Y, W) ⧸ m)) :=
        IsScalarTower.algebraMap_eq _ _ _
      have : Function.Surjective (algebraMap Ω m.ResidueField) := by
        rw [heq]; exact hb2.2.comp hb.2
      exact this
    exact s3 Ω (Localization.AtPrime m) hsurj
  have hloc := s2 Γ(Y, W) hdom
  haveI := hW.isOpenImmersion_fromSpec
  obtain ⟨y', hy'⟩ : y ∈ Set.range hW.fromSpec := by rw [hW.range_fromSpec]; exact hyW
  obtain ⟨U', hU'o, hyU', hU'p⟩ := hloc y'
  exact ⟨hW.fromSpec '' U', hW.fromSpec.isOpenEmbedding.isOpenMap _ hU'o, ⟨y', hyU', hy'⟩,
    hU'p.image _ hW.fromSpec.continuous.continuousOn⟩

theorem wc_x0c_generic_geom_irreducible : ∀ (R : Type u) [CommRing R] [IsDomain R] (C : Type u) [CommRing C] [Algebra R C] [Algebra.Smooth R C] (s : C →ₐ[R] R) (η : PrimeSpectrum R), η.asIdeal = ⊥ → ∀ c : C, (∀ Q : PrimeSpectrum C, PrimeSpectrum.comap (algebraMap R C) Q = η → (c ∉ Q.asIdeal ↔ Q ∈ connectedComponentIn (PrimeSpectrum.comap (algebraMap R C) ⁻¹' {η}) (PrimeSpectrum.comap (s : C →+* R) η))) → IrreducibleSpace (PrimeSpectrum (TensorProduct R (AlgebraicClosure (FractionRing R)) (Localization.Away c))) :=
by
  intro R _ _ C _ _ _ s η hη c hH
  classical

  have hπS : ∀ q, PrimeSpectrum.comap (algebraMap R C) (PrimeSpectrum.comap (s : C →+* R) q) = q := by
    intro q
    apply PrimeSpectrum.ext
    apply Ideal.ext
    intro r
    simp [PrimeSpectrum.comap_asIdeal]
  have hSη_mem : PrimeSpectrum.comap (s : C →+* R) η ∈
      PrimeSpectrum.comap (algebraMap R C) ⁻¹' {η} := by
    simp only [Set.mem_preimage, Set.mem_singleton_iff, hπS]
  have hsc : s c ≠ 0 := by
    have h := (hH _ (hπS η)).mpr (mem_connectedComponentIn hSη_mem)
    intro h0
    apply h
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hη, Ideal.mem_bot]
    simpa using h0

  have hconn : ConnectedSpace (PrimeSpectrum (TensorProduct R (FractionRing R) (Localization.Away c))) := by
    letI : Algebra (Localization.Away c) (TensorProduct R (FractionRing R) (Localization.Away c)) :=
      Algebra.TensorProduct.rightAlgebra
    haveI : IsLocalization (Algebra.algebraMapSubmonoid (Localization.Away c) (nonZeroDivisors R))
        (TensorProduct R (FractionRing R) (Localization.Away c)) :=
      IsLocalization.tensorRight (FractionRing R) (nonZeroDivisors R)
    have h1 := PrimeSpectrum.localization_comap_isEmbedding
      (TensorProduct R (FractionRing R) (Localization.Away c))
      (Algebra.algebraMapSubmonoid (Localization.Away c) (nonZeroDivisors R))
    have h1r := PrimeSpectrum.localization_comap_range
      (TensorProduct R (FractionRing R) (Localization.Away c))
      (Algebra.algebraMapSubmonoid (Localization.Away c) (nonZeroDivisors R))
    have h2 := PrimeSpectrum.localization_comap_isEmbedding (Localization.Away c)
      (Submonoid.powers c)
    have h2r := PrimeSpectrum.localization_away_comap_range (Localization.Away c) c
    have hj := h2.comp h1
    have key : ∀ P : PrimeSpectrum (Localization.Away c),
        P ∈ Set.range (PrimeSpectrum.comap (algebraMap (Localization.Away c)
          (TensorProduct R (FractionRing R) (Localization.Away c)))) ↔
        PrimeSpectrum.comap (algebraMap R C)
          (PrimeSpectrum.comap (algebraMap C (Localization.Away c)) P) = η := by
      intro P
      rw [h1r]
      simp only [Set.mem_setOf_eq]
      constructor
      · intro hd
        apply PrimeSpectrum.ext
        rw [hη]
        apply Ideal.ext
        intro r
        rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap,
          Ideal.mem_comap, Ideal.mem_bot]
        constructor
        · intro hr
          by_contra hr0
          refine Set.disjoint_left.mp hd ?_ hr
          exact Submonoid.mem_map.mpr ⟨r, mem_nonZeroDivisors_of_ne_zero hr0,
            (IsScalarTower.algebraMap_apply R C (Localization.Away c) r).symm⟩
        · rintro rfl
          simp
      · intro hP
        rw [Set.disjoint_left]
        intro x hx hxP
        obtain ⟨r, hr, rfl⟩ := Submonoid.mem_map.mp hx
        have hr' : r ∈ (PrimeSpectrum.comap (algebraMap R C)
            (PrimeSpectrum.comap (algebraMap C (Localization.Away c)) P)).asIdeal := by
          rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap,
            Ideal.mem_comap, ← IsScalarTower.algebraMap_apply]
          exact hxP
        rw [hP, hη, Ideal.mem_bot] at hr'
        exact nonZeroDivisors.ne_zero hr hr'
    have hrange : Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away c)) ∘
        PrimeSpectrum.comap (algebraMap (Localization.Away c)
          (TensorProduct R (FractionRing R) (Localization.Away c)))) =
        connectedComponentIn (PrimeSpectrum.comap (algebraMap R C) ⁻¹' {η})
          (PrimeSpectrum.comap (s : C →+* R) η) := by
      ext Q
      rw [Set.range_comp]
      constructor
      · rintro ⟨P, hP, rfl⟩
        have hc : c ∉ (PrimeSpectrum.comap (algebraMap C (Localization.Away c)) P).asIdeal := by
          have hmem : PrimeSpectrum.comap (algebraMap C (Localization.Away c)) P ∈
              Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away c))) := ⟨P, rfl⟩
          rw [h2r] at hmem
          exact hmem
        exact (hH _ ((key P).mp hP)).mp hc
      · intro hQ
        have hQη0 : Q ∈ PrimeSpectrum.comap (algebraMap R C) ⁻¹' {η} :=
          connectedComponentIn_subset _ _ hQ
        have hQη : PrimeSpectrum.comap (algebraMap R C) Q = η := hQη0
        have hc := (hH Q hQη).mpr hQ
        have hmem : Q ∈ Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away c))) := by
          rw [h2r]
          exact hc
        obtain ⟨P, rfl⟩ := hmem
        exact ⟨P, (key P).mpr hQη, rfl⟩
    have hK : _root_.IsConnected (Set.range (PrimeSpectrum.comap (algebraMap C (Localization.Away c)) ∘
        PrimeSpectrum.comap (algebraMap (Localization.Away c)
          (TensorProduct R (FractionRing R) (Localization.Away c))))) := by
      rw [hrange]
      exact isConnected_connectedComponentIn_iff.mpr hSη_mem
    haveI := isConnected_iff_connectedSpace.mp hK
    exact hj.toHomeomorph.symm.surjective.connectedSpace hj.toHomeomorph.symm.continuous

  have hunit : IsUnit (((Algebra.ofId R (FractionRing R)).comp s) c) := by
    apply isUnit_iff_ne_zero.mpr
    simp only [AlgHom.comp_apply, Algebra.ofId_apply]
    exact (map_ne_zero_iff _ (IsFractionRing.injective R (FractionRing R))).mpr hsc
  let g : Localization.Away c →ₐ[R] FractionRing R :=
    IsLocalization.Away.liftAlgHom (A := R) (f := (Algebra.ofId R (FractionRing R)).comp s) c hunit
  let τ : TensorProduct R (FractionRing R) (Localization.Away c) →ₐ[FractionRing R] FractionRing R :=
    Algebra.TensorProduct.lift (Algebra.ofId (FractionRing R) (FractionRing R)) g
      (fun _ _ => Commute.all _ _)

  haveI : Algebra.Smooth R (Localization.Away c) := Algebra.Smooth.comp R C (Localization.Away c)
  haveI : Algebra.Smooth (FractionRing R) (TensorProduct R (FractionRing R) (Localization.Away c)) :=
    Algebra.Smooth.baseChange R (Localization.Away c) (FractionRing R)
  have hirrD : IrreducibleSpace (PrimeSpectrum (TensorProduct (FractionRing R)
      (TensorProduct R (FractionRing R) (Localization.Away c))
      (AlgebraicClosure (FractionRing R)))) := by
    have hσ : Spec.map (CommRingCat.ofHom (τ : TensorProduct R (FractionRing R) (Localization.Away c)
          →+* FractionRing R)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap (FractionRing R)
          (TensorProduct R (FractionRing R) (Localization.Away c)))) = 𝟙 _ := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]
      exact Spec.map_id _
    have hfib : ∀ t : Spec (.of (FractionRing R)), _root_.IsConnected
        (Spec.map (CommRingCat.ofHom (algebraMap (FractionRing R)
          (TensorProduct R (FractionRing R) (Localization.Away c)))) ⁻¹' {t}) := by
      intro t
      have he : Spec.map (CommRingCat.ofHom (algebraMap (FractionRing R)
          (TensorProduct R (FractionRing R) (Localization.Away c)))) ⁻¹' {t} = Set.univ :=
        Set.eq_univ_of_forall (fun x => Subsingleton.elim (α := PrimeSpectrum (FractionRing R)) _ _)
      rw [he]
      haveI : ConnectedSpace (Spec (.of (TensorProduct R (FractionRing R) (Localization.Away c)))) :=
        hconn
      exact isConnected_univ
    haveI hc2 := wc_geom_fibres_connected_of_top_fibres_connected (FractionRing R)
      (Spec (.of (TensorProduct R (FractionRing R) (Localization.Away c))))
      (Spec.map (CommRingCat.ofHom (algebraMap (FractionRing R)
          (TensorProduct R (FractionRing R) (Localization.Away c)))))
      (Spec.map (CommRingCat.ofHom (τ : TensorProduct R (FractionRing R) (Localization.Away c)
          →+* FractionRing R))) hσ hfib (AlgebraicClosure (FractionRing R))
      (Spec.map (CommRingCat.ofHom (algebraMap (FractionRing R) (AlgebraicClosure (FractionRing R)))))
    haveI hsm : Smooth (Spec.map (CommRingCat.ofHom (algebraMap (FractionRing R)
          (TensorProduct R (FractionRing R) (Localization.Away c))))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.smooth_algebraMap.mpr inferInstance)
    haveI : Smooth (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap (FractionRing R)
          (TensorProduct R (FractionRing R) (Localization.Away c)))))
        (Spec.map (CommRingCat.ofHom (algebraMap (FractionRing R)
          (AlgebraicClosure (FractionRing R)))))) :=
      MorphismProperty.of_isPullback (P := @Smooth) (IsPullback.of_hasPullback _ _) hsm
    have hirr := wc_smooth_algclosed_connected_irreducible (AlgebraicClosure (FractionRing R)) _
      (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap (FractionRing R)
          (TensorProduct R (FractionRing R) (Localization.Away c)))))
        (Spec.map (CommRingCat.ofHom (algebraMap (FractionRing R)
          (AlgebraicClosure (FractionRing R))))))
    let e := Scheme.homeoOfIso (pullbackSpecIso (FractionRing R)
      (TensorProduct R (FractionRing R) (Localization.Away c)) (AlgebraicClosure (FractionRing R)))
    exact Function.Surjective.irreducibleSpace e.continuous e.surjective

  let e : TensorProduct (FractionRing R) (TensorProduct R (FractionRing R) (Localization.Away c))
      (AlgebraicClosure (FractionRing R)) ≃+*
      TensorProduct R (AlgebraicClosure (FractionRing R)) (Localization.Away c) :=
    (Algebra.TensorProduct.comm (FractionRing R)
      (TensorProduct R (FractionRing R) (Localization.Away c))
      (AlgebraicClosure (FractionRing R))).toRingEquiv.trans
    (Algebra.TensorProduct.cancelBaseChange R (FractionRing R) (AlgebraicClosure (FractionRing R))
      (AlgebraicClosure (FractionRing R)) (Localization.Away c)).toRingEquiv
  let h := PrimeSpectrum.homeomorphOfRingEquiv
    (R := TensorProduct (FractionRing R) (TensorProduct R (FractionRing R) (Localization.Away c))
      (AlgebraicClosure (FractionRing R)))
    (S := TensorProduct R (AlgebraicClosure (FractionRing R)) (Localization.Away c)) e
  exact Function.Surjective.irreducibleSpace h.continuous h.surjective

theorem wc_x0c_generic_fibres_preconnected : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] (C : Type u) [CommRing C] [Algebra R C] [Algebra.Smooth R C], IrreducibleSpace (PrimeSpectrum (TensorProduct R (AlgebraicClosure (FractionRing R)) C)) → ∃ a : R, a ≠ 0 ∧ ∀ q : PrimeSpectrum R, a ∉ q.asIdeal → _root_.IsPreconnected (PrimeSpectrum.comap (algebraMap R C) ⁻¹' {q}) :=
by
  classical

  have T0 : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y),
      Continuous f → Function.Surjective f → IsPreirreducible (Set.univ : Set X) →
      IsPreirreducible (Set.univ : Set Y) := by
    intro X Y _ _ f hf hs h
    have := h.image f hf.continuousOn
    rwa [Set.image_univ_of_surjective hs] at this

  have s4 : ∀ (R : Type u) [CommRing R] (L : Type u) [CommRing L] [Algebra R L] (Ω : Type u)
      [CommRing Ω] [Algebra R Ω] [Algebra L Ω] [IsScalarTower R L Ω] (C : Type u) [CommRing C]
      [Algebra R C], IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct L Ω (TensorProduct R L C)))) ↔
        IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct R Ω C))) := by
    intro R _ L _ _ Ω _ _ _ _ C _ _
    let e := PrimeSpectrum.homeomorphOfRingEquiv
      (Algebra.TensorProduct.cancelBaseChange R L L Ω C).toRingEquiv
    exact ⟨fun h => T0 e e.continuous e.surjective h,
      fun h => T0 e.symm e.symm.continuous e.symm.surjective h⟩

  have s5 : ∀ (k : Type u) [Field k] (Ω : Type u) [Field Ω] [Algebra k Ω] (T : Type u) [CommRing T]
      [Algebra k T], IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct k Ω T))) →
        IsPreirreducible (Set.univ : Set (PrimeSpectrum T)) := by
    intro k _ Ω _ _ T _ _ h
    let e := PrimeSpectrum.homeomorphOfRingEquiv (Algebra.TensorProduct.comm k Ω T).toRingEquiv
    have h1 := T0 e e.continuous e.surjective h
    exact T0 _ (PrimeSpectrum.continuous_comap _)
      (PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := T) (B := TensorProduct k T Ω)) h1

  have s6 : ∀ (R : Type u) [CommRing R] (C : Type u) [CommRing C] [Algebra R C] (q : PrimeSpectrum R),
      IsPreirreducible (Set.univ : Set (PrimeSpectrum
        (TensorProduct R (AlgebraicClosure q.asIdeal.ResidueField) C))) →
      IsPreirreducible (PrimeSpectrum.comap (algebraMap R C) ⁻¹' {q}) := by
    intro R _ C _ _ q h
    have h1 := (s4 R q.asIdeal.ResidueField (AlgebraicClosure q.asIdeal.ResidueField) C).mpr h
    have h2 : IsPreirreducible (Set.univ : Set (PrimeSpectrum
        (TensorProduct R q.asIdeal.ResidueField C))) := s5 _ _ _ h1
    let e := PrimeSpectrum.preimageHomeomorphFiber R C q
    have h3 : IsPreirreducible (Set.univ : Set (PrimeSpectrum.comap (algebraMap R C) ⁻¹' {q})) :=
      T0 e.symm e.symm.continuous e.symm.surjective h2
    have h4 := h3.image Subtype.val continuous_subtype_val.continuousOn
    rwa [Subtype.coe_image_univ] at h4

  have s3 : ∀ (R : Type u) [CommRing R] [IsDomain R] (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      [Algebra R Ω], Function.Injective (algebraMap R Ω) →
      ∃ ι : AlgebraicClosure (FractionRing R) →+* Ω,
        ι.comp (algebraMap R (AlgebraicClosure (FractionRing R))) = algebraMap R Ω := by
    intro R _ _ Ω _ _ _ hinj
    let j : FractionRing R →+* Ω := IsFractionRing.lift hinj
    letI : Algebra (FractionRing R) Ω := j.toAlgebra
    let ι₀ : AlgebraicClosure (FractionRing R) →ₐ[FractionRing R] Ω := IsAlgClosed.lift
    refine ⟨ι₀.toRingHom, ?_⟩
    ext r
    rw [RingHom.comp_apply,
      IsScalarTower.algebraMap_apply R (FractionRing R) (AlgebraicClosure (FractionRing R)) r]
    show ι₀ (algebraMap _ _ (algebraMap R (FractionRing R) r)) = _
    rw [ι₀.commutes, RingHom.algebraMap_toAlgebra]
    exact IsFractionRing.lift_algebraMap hinj r

  have s2 : ∀ (L : Type u) [Field L] [IsAlgClosed L] (T : Type u) [CommRing T] [Algebra L T]
      (Ω : Type u) [Field Ω] [Algebra L Ω], IrreducibleSpace (PrimeSpectrum T) →
      IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct L Ω T))) := by
    intro L _ _ T _ _ Ω _ _ hT
    have hN : (nilradical T).IsPrime := by
      rw [← PrimeSpectrum.vanishingIdeal_univ]
      exact PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp
        (IrreducibleSpace.isIrreducible_univ _)
    haveI : IsDomain (T ⧸ nilradical T) := Ideal.Quotient.isDomain _
    let p : T →ₐ[L] T ⧸ nilradical T := Ideal.Quotient.mkₐ L (nilradical T)
    have hp : Function.Surjective p := Ideal.Quotient.mkₐ_surjective L _
    let j : (T ⧸ nilradical T) →ₐ[L] FractionRing (T ⧸ nilradical T) :=
      IsScalarTower.toAlgHom L (T ⧸ nilradical T) (FractionRing (T ⧸ nilradical T))
    have hj : Function.Injective j := IsFractionRing.injective _ _
    let m := Algebra.TensorProduct.map (AlgHom.id L Ω) j
    have hm : Function.Injective m := by
      have hl := Module.Flat.lTensor_preserves_injective_linearMap (M := Ω) j.toLinearMap hj
      have heq : (m : TensorProduct L Ω (T ⧸ nilradical T) → _) =
          (LinearMap.lTensor Ω j.toLinearMap : TensorProduct L Ω (T ⧸ nilradical T) → _) := by
        funext x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => simp [m, Algebra.TensorProduct.map_tmul, LinearMap.lTensor_tmul]
        | add x y hx hy => rw [map_add, map_add, hx, hy]
      rw [heq]
      exact hl
    haveI : IsDomain (TensorProduct L Ω (FractionRing (T ⧸ nilradical T))) :=
      wc_gfc_tensor_domain_fields_algClosed L Ω (FractionRing (T ⧸ nilradical T))
    haveI : IsDomain (TensorProduct L Ω (T ⧸ nilradical T)) := Function.Injective.isDomain m hm
    let g := Algebra.TensorProduct.map (AlgHom.id L Ω) p
    have hg : Function.Surjective g :=
      Algebra.TensorProduct.map_surjective _ _ (fun x => ⟨x, rfl⟩) hp
    have hker : RingHom.ker g ≤ nilradical (TensorProduct L Ω T) := by
      rw [Algebra.TensorProduct.lTensor_ker p hp, Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, mem_nilradical]
      have hx' : x ∈ nilradical T := by
        rw [RingHom.mem_ker] at hx
        exact Ideal.Quotient.eq_zero_iff_mem.mp hx
      exact (mem_nilradical.mp hx').map _
    have hsurj : Function.Surjective
        (PrimeSpectrum.comap (g : TensorProduct L Ω T →+* TensorProduct L Ω (T ⧸ nilradical T))) := by
      intro P
      have hle : RingHom.ker g ≤ P.asIdeal := hker.trans (nilradical_le_prime _)
      haveI hP' : (Ideal.map g P.asIdeal).IsPrime := Ideal.map_isPrime_of_surjective hg hle
      refine ⟨⟨Ideal.map g P.asIdeal, hP'⟩, ?_⟩
      ext1
      rw [PrimeSpectrum.comap_asIdeal]
      show Ideal.comap g (Ideal.map g P.asIdeal) = P.asIdeal
      rw [Ideal.comap_map_of_surjective' g hg, sup_eq_left.mpr hle]
    have hD : IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct L Ω (T ⧸ nilradical T)))) :=
      (IrreducibleSpace.isIrreducible_univ _).isPreirreducible
    exact T0 _ (PrimeSpectrum.continuous_comap _) hsurj hD

  intro R _ _ _ C _ _ _ hirr
  have hgen : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra R Ω],
      Function.Injective (algebraMap R Ω) →
      IsPreirreducible (Set.univ : Set (PrimeSpectrum (TensorProduct R Ω C))) := by
    intro Ω _ _ _ hinj
    obtain ⟨ι, hι⟩ := s3 R Ω hinj
    letI : Algebra (AlgebraicClosure (FractionRing R)) Ω := ι.toAlgebra
    haveI : IsScalarTower R (AlgebraicClosure (FractionRing R)) Ω :=
      IsScalarTower.of_algebraMap_eq' (by rw [RingHom.algebraMap_toAlgebra]; exact hι.symm)
    have h1 := s2 (AlgebraicClosure (FractionRing R))
      (TensorProduct R (AlgebraicClosure (FractionRing R)) C) Ω hirr
    exact (s4 R (AlgebraicClosure (FractionRing R)) Ω C).mp h1
  obtain ⟨a, ha, hspread⟩ := wc_affine_geom_preirreducible_spread R C hgen
  refine ⟨a, ha, fun q hq => ?_⟩
  have hne : algebraMap R (AlgebraicClosure q.asIdeal.ResidueField) a ≠ 0 := by
    rw [IsScalarTower.algebraMap_apply R q.asIdeal.ResidueField
      (AlgebraicClosure q.asIdeal.ResidueField)]
    intro h
    apply hq
    have h' := (map_eq_zero_iff _
      (algebraMap q.asIdeal.ResidueField (AlgebraicClosure q.asIdeal.ResidueField)).injective).mp h
    exact Ideal.algebraMap_residueField_eq_zero.mp h'
  exact (s6 R C q (hspread (AlgebraicClosure q.asIdeal.ResidueField) hne)).isPreconnected

theorem wc_x0_isConstructible_noetherian : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → Topology.IsConstructible {x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))} :=
by
  intro A _ _ X _ f _ σ hσ
  classical

  have wc_x0c_affine_model : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra A B) (_ : Algebra.Smooth A B) (s : B →ₐ[A] A) (h : X ≃ₜ PrimeSpectrum B), (∀ x : X, f x = PrimeSpectrum.comap (algebraMap A B) (h x)) ∧ ∀ p : Spec (.of A), h (σ p) = PrimeSpectrum.comap (s : B →+* A) p := by
    intro A _ X _ f _ σ hσ
    let ι := Scheme.ΓSpecIso (CommRingCat.of A)
    let φ : A →+* Γ(X, ⊤) := f.appTop.hom.comp ι.inv.hom
    letI : Algebra A Γ(X, ⊤) := φ.toAlgebra
    have hιid : ι.hom.hom.comp ι.inv.hom = RingHom.id A := by
      ext a
      exact congrArg (fun g => g.hom a) ι.inv_hom_id
    have hsm : Algebra.Smooth A Γ(X, ⊤) := by
      rw [← RingHom.smooth_algebraMap]
      exact RingHom.Smooth.comp (RingHom.Smooth.of_bijective ι.commRingCatIsoToRingEquiv.symm.bijective)
        (HasRingHomProperty.iff_of_isAffine.mp ‹Smooth f›)
    have happ : σ.appTop.hom.comp f.appTop.hom = RingHom.id _ := by
      have h1 := Scheme.Hom.comp_appTop σ f
      rw [hσ] at h1
      ext a
      have h2 := congrArg (fun g => g.hom a) h1
      simpa using h2.symm
    let sR : Γ(X, ⊤) →+* A := ι.hom.hom.comp σ.appTop.hom
    let s : Γ(X, ⊤) →ₐ[A] A :=
      { sR with
        commutes' := by
          intro a
          show ι.hom.hom (σ.appTop.hom (f.appTop.hom (ι.inv.hom a))) = a
          have h3 : σ.appTop.hom (f.appTop.hom (ι.inv.hom a)) = ι.inv.hom a :=
            congrArg (fun g => g (ι.inv.hom a)) happ
          rw [h3]
          exact congrArg (fun g => g a) hιid }
    refine ⟨Γ(X, ⊤), inferInstance, inferInstance, hsm, s, Scheme.homeoOfIso X.isoSpec, ?_, ?_⟩
    · intro x
      have h1 := congrArg (fun g => g x) (Scheme.isoSpec_hom_naturality f)
      simp only [Scheme.Hom.comp_apply, Scheme.isoSpec_Spec_hom, Spec.map_apply] at h1
      change f x = PrimeSpectrum.comap (f.appTop.hom.comp ι.inv.hom) (X.isoSpec.hom x)
      have h2 := congrArg (PrimeSpectrum.comap ι.inv.hom) h1
      have h3 : ∀ z : PrimeSpectrum A, PrimeSpectrum.comap ι.inv.hom
          (PrimeSpectrum.comap ι.hom.hom z) = z := by
        intro z
        rw [← PrimeSpectrum.comap_comp_apply, hιid, PrimeSpectrum.comap_id]
      exact (h2.trans (h3 (f x))).symm
    · intro p
      have h1 := congrArg (fun g => g p) (Scheme.isoSpec_hom_naturality σ)
      simp only [Scheme.Hom.comp_apply, Scheme.isoSpec_Spec_hom, Spec.map_apply] at h1
      change X.isoSpec.hom (σ p) = PrimeSpectrum.comap sR p
      rw [← h1]
      rfl

  have wc_x0c_quotient_base_change : ∀ (A : Type u) [CommRing A] (B : Type u) [CommRing B] [Algebra A B] [Algebra.Smooth A B] (s : B →ₐ[A] A) (p : Ideal A) [p.IsPrime], ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (A ⧸ p) C) (_ : Algebra.Smooth (A ⧸ p) C) (sC : C →ₐ[A ⧸ p] A ⧸ p) (ψ : B →+* C), Function.Surjective ψ ∧ (∀ a : A, ψ (algebraMap A B a) = algebraMap (A ⧸ p) C (Ideal.Quotient.mk p a)) ∧ (∀ b : B, sC (ψ b) = Ideal.Quotient.mk p (s b)) ∧ ∀ Q' : PrimeSpectrum B, p ≤ (PrimeSpectrum.comap (algebraMap A B) Q').asIdeal → Q' ∈ Set.range (PrimeSpectrum.comap ψ) := by
    intro A _ B _ _ _ s p _
    refine ⟨TensorProduct A (A ⧸ p) B, inferInstance, inferInstance, inferInstance,
      Algebra.TensorProduct.lift (Algebra.ofId (A ⧸ p) (A ⧸ p)) ((Ideal.Quotient.mkₐ A p).comp s)
        (fun _ _ => Commute.all _ _),
      (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A (A ⧸ p) B).toRingHom,
      ?_, ?_, ?_, ?_⟩
    · exact Algebra.TensorProduct.includeRight_surjective B
        (by rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective)
    · intro a
      rw [← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_apply]
      exact (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A (A ⧸ p) B).commutes a
    · intro b
      simp [Algebra.TensorProduct.lift_tmul]
    · intro Q' hQ'
      have hle : p ≤ Ideal.comap (Algebra.ofId A B) Q'.asIdeal := by
        intro r hr
        have := hQ' hr
        rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at this
        exact this
      let φ : TensorProduct A (A ⧸ p) B →ₐ[A] B ⧸ Q'.asIdeal :=
        Algebra.TensorProduct.productMap (Ideal.quotientMapₐ Q'.asIdeal (Algebra.ofId A B) hle)
          (Ideal.Quotient.mkₐ A Q'.asIdeal)
      have hφψ : (φ : TensorProduct A (A ⧸ p) B →+* B ⧸ Q'.asIdeal).comp
          (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A (A ⧸ p) B).toRingHom =
          Ideal.Quotient.mk Q'.asIdeal := by
        ext b
        simp [φ, Algebra.TensorProduct.productMap_apply_tmul]
      refine ⟨PrimeSpectrum.comap (φ : TensorProduct A (A ⧸ p) B →+* B ⧸ Q'.asIdeal)
        ⟨⊥, Ideal.isPrime_bot⟩, ?_⟩
      rw [← PrimeSpectrum.comap_comp_apply, hφψ]
      apply PrimeSpectrum.ext
      rw [PrimeSpectrum.comap_asIdeal]
      exact Ideal.mk_ker

  have wc_x0c_constructible_of_locally_monochrome : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X] [QuasiSober X] (E : Set X), (∀ x : X, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ (closure {x} ∩ U ⊆ E ∨ closure {x} ∩ U ⊆ Eᶜ)) → Topology.IsConstructible E := by
    intro X _ _ _ E H
    have hopen : ∀ U : Set X, IsOpen U → Topology.IsConstructible U := by
      intro U hU
      exact (show IsRetrocompact U from
        fun V _ _ => TopologicalSpace.NoetherianSpace.isCompact _).isConstructible hU
    have hclosed : ∀ Z : Set X, IsClosed Z → Topology.IsConstructible Z := by
      intro Z hZ
      have := (hopen Zᶜ hZ.isOpen_compl).compl
      rwa [compl_compl] at this
    have key : ∀ Z : TopologicalSpace.Closeds X, Topology.IsConstructible (E ∩ (Z : Set X)) := by
      intro Z
      induction Z using WellFoundedLT.induction with
      | _ Z ih =>
      obtain ⟨S, hSf, hScl, hSirr, hZS⟩ :=
        TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible Z.isClosed
      rcases S.eq_empty_or_nonempty with hS | hS
      · rw [hZS, hS, Set.sUnion_empty, Set.inter_empty]
        exact Topology.IsConstructible.empty
      obtain ⟨T, hTmax⟩ := hSf.exists_maximal hS
      have hTS : T ∈ S := hTmax.prop
      obtain ⟨ξ, hξ⟩ := QuasiSober.sober (hSirr T hTS) (hScl T hTS)
      have hξT : ξ ∈ T := hξ.mem
      obtain ⟨U, hU, hξU, hmono⟩ := H ξ
      rw [hξ.def] at hmono
      set W : Set X := U ∩ (⋃ T' ∈ {T' | T' ∈ S ∧ T' ≠ T}, T')ᶜ with hW
      have hWo : IsOpen W := by
        apply hU.inter
        rw [isOpen_compl_iff]
        apply Set.Finite.isClosed_biUnion (hSf.subset (fun _ h => h.1))
        intro T' hT'
        exact hScl T' hT'.1
      have hξW : ξ ∈ W := by
        refine ⟨hξU, ?_⟩
        simp only [Set.mem_compl_iff, Set.mem_iUnion, not_exists]
        intro T' hT' hξT'
        apply hT'.2
        have h1 : T ⊆ T' := by
          rw [← hξ.def]
          exact closure_minimal (Set.singleton_subset_iff.mpr hξT') (hScl T' hT'.1)
        exact le_antisymm (hTmax.2 hT'.1 h1) h1
      have hZW : (Z : Set X) ∩ W ⊆ T ∩ U := by
        rintro x ⟨hxZ, hxU, hxn⟩
        refine ⟨?_, hxU⟩
        rw [hZS] at hxZ
        obtain ⟨T', hT'S, hxT'⟩ := hxZ
        by_contra hxT
        apply hxn
        simp only [Set.mem_iUnion]
        refine ⟨T', ⟨hT'S, ?_⟩, hxT'⟩
        rintro rfl
        exact hxT hxT'
      let Z' : TopologicalSpace.Closeds X := ⟨(Z : Set X) ∩ Wᶜ, Z.isClosed.inter hWo.isClosed_compl⟩
      have hZ'lt : Z' < Z := by
        rw [SetLike.lt_iff_le_and_exists]
        refine ⟨fun x hx => hx.1, ξ, ?_, fun h => h.2 hξW⟩
        show ξ ∈ (Z : Set X)
        rw [hZS]
        exact ⟨T, hTS, hξT⟩
      have hIH := ih Z' hZ'lt
      have hsplit : E ∩ (Z : Set X) = (E ∩ ((Z : Set X) ∩ W)) ∪ (E ∩ (Z' : Set X)) := by
        ext x
        constructor
        · rintro ⟨hxE, hxZ⟩
          by_cases hxW : x ∈ W
          · exact Or.inl ⟨hxE, hxZ, hxW⟩
          · exact Or.inr ⟨hxE, hxZ, hxW⟩
        · rintro (⟨hxE, hxZ, -⟩ | ⟨hxE, hxZ, -⟩)
          · exact ⟨hxE, hxZ⟩
          · exact ⟨hxE, hxZ⟩
      rw [hsplit]
      apply Topology.IsConstructible.union _ hIH
      rcases hmono with h | h
      · have : E ∩ ((Z : Set X) ∩ W) = (Z : Set X) ∩ W :=
          Set.inter_eq_right.mpr (fun x hx => h (hZW hx))
        rw [this]
        exact (hclosed _ Z.isClosed).inter (hopen _ hWo)
      · have : E ∩ ((Z : Set X) ∩ W) = ∅ := by
          ext x
          simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
          intro hxE hxZ hxW
          exact h (hZW ⟨hxZ, hxW⟩) hxE
        rw [this]
        exact Topology.IsConstructible.empty
    have := key ⊤
    rwa [TopologicalSpace.Closeds.coe_top, Set.inter_univ] at this

  have hS3 : ∀ {X Y X' Y' : Type u} [TopologicalSpace X] [TopologicalSpace X'] (f : X → Y)
      (σ : Y → X) (f' : X' → Y') (σ' : Y' → X') (j : X' → X) (i : Y' → Y),
      (∀ y', f' (σ' y') = y') → Topology.IsEmbedding j → Function.Injective i →
      (∀ x', f (j x') = i (f' x')) → (∀ y', j (σ' y') = σ (i y')) →
      (∀ x, f x ∈ Set.range i → x ∈ Set.range j) → ∀ x',
      (x' ∈ connectedComponentIn (f' ⁻¹' {f' x'}) (σ' (f' x')) ↔
        j x' ∈ connectedComponentIn (f ⁻¹' {f (j x')}) (σ (f (j x')))) := by
    intro X Y X' Y' _ _ f σ f' σ' j i hs hj hi hfj hjs hr x'
    have hF : j '' (f' ⁻¹' {f' x'}) = f ⁻¹' {f (j x')} := by
      ext x
      constructor
      · rintro ⟨x'', hx'', rfl⟩
        simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx'' ⊢
        rw [hfj, hfj, hx'']
      · intro hx
        simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx
        obtain ⟨x'', rfl⟩ := hr x ⟨f' x', by rw [hx, hfj]⟩
        refine ⟨x'', ?_, rfl⟩
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        apply hi
        rw [← hfj, ← hfj, hx]
    have hσ1 : j (σ' (f' x')) = σ (f (j x')) := by rw [hjs, hfj]
    have hσ2 : σ' (f' x') ∈ f' ⁻¹' {f' x'} := by
      simp only [Set.mem_preimage, Set.mem_singleton_iff, hs]
    constructor
    · intro hx
      have h1 : j '' connectedComponentIn (f' ⁻¹' {f' x'}) (σ' (f' x')) ⊆
          connectedComponentIn (f ⁻¹' {f (j x')}) (σ (f (j x'))) := by
        apply IsPreconnected.subset_connectedComponentIn
        · exact isPreconnected_connectedComponentIn.image _ hj.continuous.continuousOn
        · exact ⟨_, mem_connectedComponentIn hσ2, hσ1⟩
        · rw [← hF]
          exact Set.image_mono (connectedComponentIn_subset _ _)
      exact h1 ⟨x', hx, rfl⟩
    · intro hx
      have hK : connectedComponentIn (f ⁻¹' {f (j x')}) (σ (f (j x'))) ⊆ Set.range j := by
        intro z hz
        have hz' := connectedComponentIn_subset _ _ hz
        rw [← hF] at hz'
        obtain ⟨w, -, rfl⟩ := hz'
        exact ⟨w, rfl⟩
      have hσ3 : σ (f (j x')) ∈ f ⁻¹' {f (j x')} := by
        rw [← hσ1, ← hF]
        exact ⟨_, hσ2, rfl⟩
      have h2 : j ⁻¹' connectedComponentIn (f ⁻¹' {f (j x')}) (σ (f (j x'))) ⊆
          connectedComponentIn (f' ⁻¹' {f' x'}) (σ' (f' x')) := by
        apply IsPreconnected.subset_connectedComponentIn
        · rw [← hj.isInducing.isPreconnected_image, Set.image_preimage_eq_of_subset hK]
          exact isPreconnected_connectedComponentIn
        · show j (σ' (f' x')) ∈ connectedComponentIn (f ⁻¹' {f (j x')}) (σ (f (j x')))
          rw [hσ1]
          exact mem_connectedComponentIn hσ3
        · intro z hz
          have hz' := connectedComponentIn_subset _ _ hz
          rw [← hF] at hz'
          obtain ⟨w, hw, hwz⟩ := hz'
          rw [← hj.injective hwz]
          exact hw
      exact h2 hx

  have hS9 : ∀ {X Y : Type u} [TopologicalSpace X] (π : X → Y) (σ : Y → X),
      (∀ y, π (σ y) = y) → ∀ (S : Set Y) (O O' : Set X), IsOpen O → IsOpen O' →
      (∀ x, π x ∈ S → (x ∈ O ↔ x ∉ O')) → (∀ y ∈ S, σ y ∈ O) →
      (∀ y ∈ S, _root_.IsPreconnected (O ∩ π ⁻¹' {y})) → ∀ x, π x ∈ S →
      (x ∈ connectedComponentIn (π ⁻¹' {π x}) (σ (π x)) ↔ x ∈ O) := by
    intro X Y _ π σ hs S O O' hO hO' hc hσO hpc x hx
    have hσF : σ (π x) ∈ π ⁻¹' {π x} := by
      simp only [Set.mem_preimage, Set.mem_singleton_iff, hs]
    have hKF := connectedComponentIn_subset (π ⁻¹' {π x}) (σ (π x))
    have hKO : connectedComponentIn (π ⁻¹' {π x}) (σ (π x)) ⊆ O := by
      have h := isPreconnected_iff_subset_of_disjoint.mp
        (isPreconnected_connectedComponentIn (x := σ (π x)) (F := π ⁻¹' {π x})) O O' hO hO' ?_ ?_
      · rcases h with h | h
        · exact h
        · exfalso
          have h1 := h (mem_connectedComponentIn hσF)
          have h2 := hσO _ hx
          have h3 : π (σ (π x)) ∈ S := by rw [hs]; exact hx
          exact ((hc _ h3).mp h2) h1
      · intro z hz
        have hz' : π z = π x := hKF hz
        have hzS : π z ∈ S := by rw [hz']; exact hx
        by_cases hzO : z ∈ O
        · exact Or.inl hzO
        · exact Or.inr (by
            by_contra h
            exact hzO ((hc z hzS).mpr h))
      · ext z
        simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
        intro hz hzO hzO'
        have hz' : π z = π x := hKF hz
        have hzS : π z ∈ S := by rw [hz']; exact hx
        exact (hc z hzS).mp hzO hzO'
    constructor
    · intro h
      exact hKO h
    · intro h
      have h4 : O ∩ π ⁻¹' {π x} ⊆ connectedComponentIn (π ⁻¹' {π x}) (σ (π x)) :=
        (hpc _ hx).subset_connectedComponentIn ⟨hσO _ hx, hσF⟩ Set.inter_subset_right
      exact h4 ⟨h, rfl⟩

  have hS8 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] (C : Type u)
      [CommRing C] [Algebra R C] [Algebra.Smooth R C] (s : C →ₐ[R] R), ∃ (a : R) (c c' : C),
      a ≠ 0 ∧ ∀ Q : PrimeSpectrum C, a ∉ (PrimeSpectrum.comap (algebraMap R C) Q).asIdeal →
      ((Q ∈ connectedComponentIn (PrimeSpectrum.comap (algebraMap R C) ⁻¹'
          {PrimeSpectrum.comap (algebraMap R C) Q})
          (PrimeSpectrum.comap (s : C →+* R) (PrimeSpectrum.comap (algebraMap R C) Q)) ↔
        c ∉ Q.asIdeal) ∧ (c ∉ Q.asIdeal ↔ c' ∈ Q.asIdeal)) := by
    intro R _ _ _ C _ _ _ s
    let η : PrimeSpectrum R := ⟨⊥, Ideal.isPrime_bot⟩
    obtain ⟨a₁, c, c', ha₁, hC1, hC2, hC3⟩ := wc_x0c_generic_idempotent_split R C s η rfl
    have hirr := wc_x0c_generic_geom_irreducible R C s η rfl c hC2
    haveI : Algebra.Smooth R (Localization.Away c) := Algebra.Smooth.comp R C (Localization.Away c)
    obtain ⟨a₂, ha₂, hpc⟩ := wc_x0c_generic_fibres_preconnected R (Localization.Away c) hirr
    refine ⟨a₁ * a₂, c, c', mul_ne_zero ha₁ ha₂, ?_⟩
    intro Q hQ
    have hπS : ∀ q, PrimeSpectrum.comap (algebraMap R C) (PrimeSpectrum.comap (s : C →+* R) q) = q := by
      intro q
      apply PrimeSpectrum.ext
      apply Ideal.ext
      intro r
      simp [PrimeSpectrum.comap_asIdeal]
    have hcomp : ∀ z, PrimeSpectrum.comap (algebraMap R (Localization.Away c)) z =
        PrimeSpectrum.comap (algebraMap R C)
          (PrimeSpectrum.comap (algebraMap C (Localization.Away c)) z) := by
      intro z
      rw [IsScalarTower.algebraMap_eq R C (Localization.Away c), PrimeSpectrum.comap_comp_apply]
    have h9 := hS9 (PrimeSpectrum.comap (algebraMap R C)) (PrimeSpectrum.comap (s : C →+* R)) hπS
      {q | a₁ * a₂ ∉ q.asIdeal} (PrimeSpectrum.basicOpen c : Set (PrimeSpectrum C))
      (PrimeSpectrum.basicOpen c' : Set (PrimeSpectrum C))
      (PrimeSpectrum.basicOpen c).isOpen (PrimeSpectrum.basicOpen c').isOpen
      (by
        intro x hx
        have hx1 : a₁ ∉ (PrimeSpectrum.comap (algebraMap R C) x).asIdeal :=
          fun h => hx (Ideal.mul_mem_right _ _ h)
        simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, not_not]
        exact hC1 x hx1)
      (by
        intro y hy
        have hy1 : a₁ ∉ y.asIdeal := fun h => hy (Ideal.mul_mem_right _ _ h)
        have := hC3 y hy1
        simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, PrimeSpectrum.comap_asIdeal,
          Ideal.mem_comap]
        simpa using this)
      (by
        intro y hy
        have hy2 : a₂ ∉ y.asIdeal := fun h => hy (Ideal.mul_mem_left _ _ h)
        have heq : (PrimeSpectrum.basicOpen c : Set (PrimeSpectrum C)) ∩
            PrimeSpectrum.comap (algebraMap R C) ⁻¹' {y} =
            PrimeSpectrum.comap (algebraMap C (Localization.Away c)) ''
              (PrimeSpectrum.comap (algebraMap R (Localization.Away c)) ⁻¹' {y}) := by
          have hpre : PrimeSpectrum.comap (algebraMap R (Localization.Away c)) ⁻¹' {y} =
              PrimeSpectrum.comap (algebraMap C (Localization.Away c)) ⁻¹'
                (PrimeSpectrum.comap (algebraMap R C) ⁻¹' {y}) := by
            ext z
            simp only [Set.mem_preimage, hcomp]
          rw [hpre, Set.image_preimage_eq_inter_range,
            PrimeSpectrum.localization_away_comap_range (Localization.Away c) c, Set.inter_comm]
        rw [heq]
        exact (hpc y hy2).image _ (PrimeSpectrum.continuous_comap _).continuousOn)
      Q hQ
    refine ⟨?_, ?_⟩
    · rw [h9, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
    · exact hC1 Q (fun h => hQ (Ideal.mul_mem_right _ _ h))

  obtain ⟨B, _, _, _, s, h, hf, hσh⟩ := wc_x0c_affine_model A X f σ hσ
  have hπS : ∀ p, PrimeSpectrum.comap (algebraMap A B) (PrimeSpectrum.comap (s : B →+* A) p) = p := by
    intro p
    apply PrimeSpectrum.ext
    apply Ideal.ext
    intro r
    simp [PrimeSpectrum.comap_asIdeal]
  have hE : {x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))} =
      h ⁻¹' {Q : PrimeSpectrum B | Q ∈ connectedComponentIn
        (PrimeSpectrum.comap (algebraMap A B) ⁻¹' {PrimeSpectrum.comap (algebraMap A B) Q})
        (PrimeSpectrum.comap (s : B →+* A) (PrimeSpectrum.comap (algebraMap A B) Q))} := by
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_preimage]
    have h3 := hS3 f σ (PrimeSpectrum.comap (algebraMap A B)) (PrimeSpectrum.comap (s : B →+* A))
      h.symm id hπS h.symm.isEmbedding Function.injective_id
      (fun Q => by rw [hf, Homeomorph.apply_symm_apply]; rfl)
      (fun p => (Homeomorph.symm_apply_eq h).mpr (hσh p).symm)
      (fun x _ => h.symm.surjective x) (h x)
    rw [Homeomorph.symm_apply_apply] at h3
    exact h3.symm
  rw [hE]
  apply Topology.IsConstructible.preimage_of_isOpenEmbedding h.isOpenEmbedding
  haveI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing A B
  apply wc_x0c_constructible_of_locally_monochrome (PrimeSpectrum B)
  intro Q
  obtain ⟨p, hp⟩ : ∃ p : Ideal A, p = (PrimeSpectrum.comap (algebraMap A B) Q).asIdeal := ⟨_, rfl⟩
  haveI : p.IsPrime := hp ▸ PrimeSpectrum.isPrime _
  have hpmem : ∀ r, r ∈ p ↔ algebraMap A B r ∈ Q.asIdeal := by
    intro r
    rw [hp, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
  obtain ⟨C, _, _, _, sC, ψ, hψs, hψa, hψs', hψr⟩ := wc_x0c_quotient_base_change A B s p
  have hj := PrimeSpectrum.isClosedEmbedding_comap_of_surjective C ψ hψs
  have hi := PrimeSpectrum.comap_injective_of_surjective (Ideal.Quotient.mk p)
    Ideal.Quotient.mk_surjective
  have hπSC : ∀ P, PrimeSpectrum.comap (algebraMap (A ⧸ p) C)
      (PrimeSpectrum.comap (sC : C →+* A ⧸ p) P) = P := by
    intro P
    apply PrimeSpectrum.ext
    apply Ideal.ext
    intro r
    simp [PrimeSpectrum.comap_asIdeal]
  have hStar := hS3 (PrimeSpectrum.comap (algebraMap A B)) (PrimeSpectrum.comap (s : B →+* A))
    (PrimeSpectrum.comap (algebraMap (A ⧸ p) C)) (PrimeSpectrum.comap (sC : C →+* A ⧸ p))
    (PrimeSpectrum.comap ψ) (PrimeSpectrum.comap (Ideal.Quotient.mk p)) hπSC hj.isEmbedding hi
    (by
      intro Q''
      apply PrimeSpectrum.ext
      apply Ideal.ext
      intro r
      simp only [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hψa])
    (by
      intro P
      apply PrimeSpectrum.ext
      apply Ideal.ext
      intro r
      simp [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hψs'])
    (by
      rintro x ⟨P, hP⟩
      apply hψr
      rw [← hP, PrimeSpectrum.comap_asIdeal]
      intro r hr
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hr]
      exact zero_mem _)
  obtain ⟨a, c, c', ha, hcc⟩ := hS8 (A ⧸ p) C sC
  obtain ⟨Q₀, hQ₀⟩ := hψr Q hp.le
  have hbot : (PrimeSpectrum.comap (algebraMap (A ⧸ p) C) Q₀).asIdeal = ⊥ := by
    apply Ideal.ext
    intro r'
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r'
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, ← hψa, Ideal.mem_bot,
      Ideal.Quotient.eq_zero_iff_mem, hpmem, ← hQ₀, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
  have hDa : ∀ Q'' : PrimeSpectrum C,
      Q'' ∈ PrimeSpectrum.comap (algebraMap (A ⧸ p) C) ⁻¹' (PrimeSpectrum.basicOpen a : Set _) →
      a ∉ (PrimeSpectrum.comap (algebraMap (A ⧸ p) C) Q'').asIdeal := fun Q'' h => h
  have haQ₀ : a ∉ (PrimeSpectrum.comap (algebraMap (A ⧸ p) C) Q₀).asIdeal := by
    rw [hbot, Ideal.mem_bot]
    exact ha
  have hnbhd : ∀ (V : Set (PrimeSpectrum C)) (T : Set (PrimeSpectrum B)), IsOpen V → Q₀ ∈ V →
      (∀ Q'' ∈ V, PrimeSpectrum.comap ψ Q'' ∈ T) →
      ∃ U, IsOpen U ∧ Q ∈ U ∧ closure {Q} ∩ U ⊆ T := by
    intro V T hV hQV hVT
    obtain ⟨t, ht, htV⟩ := hj.isEmbedding.isInducing.isOpen_iff.mp hV
    have hcl : closure {Q} ⊆ Set.range (PrimeSpectrum.comap ψ) :=
      closure_minimal (by rintro _ rfl; exact ⟨Q₀, hQ₀⟩) hj.isClosed_range
    refine ⟨t, ht, ?_, ?_⟩
    · rw [← hQ₀]
      show Q₀ ∈ PrimeSpectrum.comap ψ ⁻¹' t
      rw [htV]
      exact hQV
    · rintro Q' ⟨hQ'c, hQ't⟩
      obtain ⟨Q₀', rfl⟩ := hcl hQ'c
      apply hVT
      rw [← htV]
      exact hQ't
  have hVopen : ∀ e : C, IsOpen ((PrimeSpectrum.basicOpen e : Set (PrimeSpectrum C)) ∩
      PrimeSpectrum.comap (algebraMap (A ⧸ p) C) ⁻¹' (PrimeSpectrum.basicOpen a : Set _)) :=
    fun e => (PrimeSpectrum.basicOpen e).isOpen.inter
      ((PrimeSpectrum.basicOpen a).isOpen.preimage (PrimeSpectrum.continuous_comap _))
  by_cases hc : c ∈ Q₀.asIdeal
  · have hc' : c' ∉ Q₀.asIdeal := fun h => ((hcc Q₀ haQ₀).2.mpr h) hc
    obtain ⟨U, hU, hQU, hsub⟩ := hnbhd _ ({Q : PrimeSpectrum B | Q ∈ connectedComponentIn
        (PrimeSpectrum.comap (algebraMap A B) ⁻¹' {PrimeSpectrum.comap (algebraMap A B) Q})
        (PrimeSpectrum.comap (s : B →+* A) (PrimeSpectrum.comap (algebraMap A B) Q))}ᶜ)
      (hVopen c') ⟨hc', haQ₀⟩
      (fun Q'' hQ'' => by
        obtain ⟨h1, h2⟩ := hQ''
        have haQ'' := hDa Q'' h2
        have hcQ : c ∈ Q''.asIdeal := by
          by_contra hn
          exact h1 ((hcc Q'' haQ'').2.mp hn)
        intro hmem
        exact ((hcc Q'' haQ'').1.mp ((hStar Q'').mpr hmem)) hcQ)
    exact ⟨U, hU, hQU, Or.inr hsub⟩
  · obtain ⟨U, hU, hQU, hsub⟩ := hnbhd _ {Q : PrimeSpectrum B | Q ∈ connectedComponentIn
        (PrimeSpectrum.comap (algebraMap A B) ⁻¹' {PrimeSpectrum.comap (algebraMap A B) Q})
        (PrimeSpectrum.comap (s : B →+* A) (PrimeSpectrum.comap (algebraMap A B) Q))}
      (hVopen c) ⟨hc, haQ₀⟩
      (fun Q'' hQ'' => by
        obtain ⟨h1, h2⟩ := hQ''
        have haQ'' := hDa Q'' h2
        exact (hStar Q'').mp ((hcc Q'' haQ'').1.mpr h1))
    exact ⟨U, hU, hQU, Or.inl hsub⟩

theorem wc_smooth_section_fibre_component_isOpen : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → IsOpen {x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))} :=
by
  intro A _ _ X _ f _ σ hσ
  have hgen := wc_x0_stableUnderGeneralization A X f σ hσ
  obtain ⟨A₀, _, _, φ, X₀, _, f₀, _, σ₀, p, hσ₀, hpb, hσp⟩ :=
    wc_x0_noetherian_descent A X f σ hσ
  have hcon0 := wc_x0_isConstructible_noetherian A₀ X₀ f₀ σ₀ hσ₀
  have hpre : {x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))} =
      p ⁻¹' {x : X₀ | x ∈ connectedComponentIn (f₀ ⁻¹' {f₀ x}) (σ₀ (f₀ x))} := by
    ext x
    exact wc_x0_baseChange_preimage X₀ (Spec (.of A₀)) X (Spec (.of A)) f₀ σ₀ hσ₀
      (Spec.map (CommRingCat.ofHom φ)) f p σ hpb hσ hσp x
  have hcon : Topology.IsConstructible
      {x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))} := by
    rw [hpre]
    exact p.isConstructible_preimage hcon0
  have h1 : IsOpen (X.isoSpec.inv ⁻¹'
      {x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))}) :=
    PrimeSpectrum.isOpen_of_stableUnderGeneralization_of_isConstructible
      (hgen.preimage X.isoSpec.inv.continuous) (X.isoSpec.inv.isConstructible_preimage hcon)
  have h2 : {x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))} =
      X.isoSpec.hom ⁻¹' (X.isoSpec.inv ⁻¹'
        {x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))}) := by
    ext x
    simp only [Set.mem_preimage]
    rw [← Scheme.Hom.comp_apply, X.isoSpec.hom_inv_id]
    rfl
  rw [h2]
  exact h1.preimage X.isoSpec.hom.continuous

theorem wc_smooth_section_geom_connected_affine_nbhd : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → ∃ U : X.Opens, IsAffineOpen U ∧ Set.range σ ⊆ (U : Set X) ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), ConnectedSpace ↥(Limits.pullback (U.ι ≫ f) z) :=
by
  intro A _ _ X _ f _ σ hσ
  have hfσ : ∀ s, f (σ s) = s := by
    intro s
    rw [← Scheme.Hom.comp_apply, hσ]
    rfl
  have hX0o := wc_smooth_section_fibre_component_isOpen A X f σ hσ
  let V : X.Opens := ⟨{x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))}, hX0o⟩
  have hVmem : ∀ x : X, x ∈ (V : Set X) ↔
      x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x)) := fun _ => Iff.rfl
  have hσV : ∀ s, σ s ∈ (V : Set X) := by
    intro s
    rw [hVmem, hfσ s]
    exact mem_connectedComponentIn (hfσ s)
  have hCsub : ∀ s, ∀ y ∈ connectedComponentIn (f ⁻¹' {s}) (σ s), f y = s := by
    intro s y hy
    have h1 : y ∈ f ⁻¹' {s} := connectedComponentIn_subset (f ⁻¹' {s}) (σ s) hy
    exact h1
  have hCV : ∀ s, connectedComponentIn (f ⁻¹' {s}) (σ s) ⊆ (V : Set X) := by
    intro s y hy
    rw [hVmem, hCsub s y hy]
    exact hy
  have hσr : Set.range σ ⊆ Set.range V.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨s, rfl⟩
    exact hσV s
  obtain ⟨τ, hτ⟩ : ∃ τ, τ ≫ V.ι = σ := ⟨_, IsOpenImmersion.lift_fac V.ι σ hσr⟩
  have hτg : τ ≫ V.ι ≫ f = 𝟙 _ := by rw [← Category.assoc, hτ, hσ]
  have hfib : ∀ s, _root_.IsConnected ((V.ι ≫ f) ⁻¹' {s}) := by
    intro s
    have hpre : (V.ι ≫ f) ⁻¹' {s} = V.ι ⁻¹' connectedComponentIn (f ⁻¹' {s}) (σ s) := by
      ext x
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
      constructor
      · intro hx
        have hx0 : V.ι x ∈ (V : Set X) := by
          have h1 : V.ι x ∈ Set.range V.ι := ⟨x, rfl⟩
          rwa [Scheme.Opens.range_ι] at h1
        rw [hVmem, hx] at hx0
        exact hx0
      · intro hx
        exact hCsub s _ hx
    rw [hpre]
    have hconn : _root_.IsConnected (connectedComponentIn (f ⁻¹' {s}) (σ s)) :=
      isConnected_connectedComponentIn_iff.mpr (hfσ s)
    exact hconn.preimage_of_isOpenMap V.ι.isOpenEmbedding.injective
      V.ι.isOpenEmbedding.isOpenMap (by rw [Scheme.Opens.range_ι]; exact hCV s)
  have hgc := wc_geom_fibres_connected_of_top_fibres_connected A V (V.ι ≫ f) τ hτg hfib
  have hirr : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)),
      IrreducibleSpace ↥(Limits.pullback (V.ι ≫ f) z) := by
    intro Ω _ _ z
    have := hgc Ω z
    have : Smooth (Limits.pullback.snd (V.ι ≫ f) z) :=
      MorphismProperty.of_isPullback (P := @Smooth) (IsPullback.of_hasPullback _ _)
        inferInstance
    exact wc_smooth_algclosed_connected_irreducible Ω _ (Limits.pullback.snd (V.ι ≫ f) z)
  obtain ⟨g0, hg0V, hg0⟩ := (isAffineOpen_top X).exists_basicOpen_le (V := V)
    ⟨σ (IsLocalRing.closedPoint A), hσV _⟩ (by trivial)
  have hσU : Set.range σ ⊆ ((X.basicOpen g0 : X.Opens) : Set X) := by
    rintro _ ⟨s, rfl⟩
    exact ((IsLocalRing.specializes_closedPoint s).map σ.continuous).mem_open
      (X.basicOpen g0).isOpen hg0
  refine ⟨X.basicOpen g0, (isAffineOpen_top X).basicOpen g0, hσU, ?_⟩
  intro Ω _ _ z
  have hUV : X.basicOpen g0 ≤ V := hg0V
  let j := X.homOfLE hUV
  have hj : j ≫ V.ι = (X.basicOpen g0).ι := Scheme.homOfLE_ι X hUV
  have e : (X.basicOpen g0).ι ≫ f = j ≫ (V.ι ≫ f) := by rw [← Category.assoc, hj]
  have hrU : Set.range (z ≫ σ) ⊆ Set.range (X.basicOpen g0).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨w, rfl⟩
    exact hσU ⟨z w, (Scheme.Hom.comp_apply z σ w).symm⟩
  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ, ℓ ≫ (X.basicOpen g0).ι = z ≫ σ :=
    ⟨_, IsOpenImmersion.lift_fac (X.basicOpen g0).ι (z ≫ σ) hrU⟩
  have hw : ℓ ≫ (X.basicOpen g0).ι ≫ f = 𝟙 _ ≫ z := by
    rw [← Category.assoc, hℓ, Category.assoc, hσ, Category.comp_id, Category.id_comp]
  have hne : Nonempty ↥(Limits.pullback ((X.basicOpen g0).ι ≫ f) z) :=
    ⟨Limits.pullback.lift ℓ (𝟙 _) hw (IsLocalRing.closedPoint Ω)⟩
  rw [e] at hne ⊢
  have := hirr Ω z
  let iso := Limits.pullbackRightPullbackFstIso (V.ι ≫ f) z j
  let m : Limits.pullback (j ≫ V.ι ≫ f) z ⟶ Limits.pullback (V.ι ≫ f) z :=
    iso.inv ≫ Limits.pullback.snd j (Limits.pullback.fst (V.ι ≫ f) z)
  have : IsOpenImmersion m := inferInstance
  have : PreirreducibleSpace ↥(Limits.pullback (j ≫ V.ι ≫ f) z) := by
    constructor
    have h := (IrreducibleSpace.isIrreducible_univ
      ↥(Limits.pullback (V.ι ≫ f) z)).isPreirreducible.preimage m.isOpenEmbedding
    simpa using h
  have : IrreducibleSpace ↥(Limits.pullback (j ≫ V.ι ≫ f) z) :=
    @IrreducibleSpace.mk _ _ inferInstance hne
  infer_instance

theorem wc_shens_fet_section : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of B)), IsFinite q → Etale q → Set.range q = Set.univ → ∃ τ : Spec (.of B) ⟶ Y, τ ≫ q = 𝟙 _ :=
by
  intro B _ _ _ Y q hfin het hsurj
  classical
  have hens : ∀ (R S : Type u) [CommRing R] [HenselianLocalRing R] [CommRing S] [Algebra R S] [Algebra.Etale R S] (P : Ideal S) [P.IsPrime] [P.LiesOver (IsLocalRing.maximalIdeal R)], Function.Bijective (Ideal.ResidueField.mapₐ (IsLocalRing.maximalIdeal R) P (Algebra.ofId R S) (P.over_def (IsLocalRing.maximalIdeal R))) → ∃ σ : S →ₐ[R] R, Ideal.comap σ (IsLocalRing.maximalIdeal R) = P := by
    intro R S _ _ _ _ _ P _ _ hbij
    let φ : R →+* P.ResidueField := algebraMap R P.ResidueField
    have hφker : ∀ r : R, φ r = 0 ↔ r ∈ IsLocalRing.maximalIdeal R := by
      intro r
      have h1 : φ r = algebraMap S P.ResidueField (algebraMap R S r) :=
        IsScalarTower.algebraMap_apply R S P.ResidueField r
      rw [h1, Ideal.algebraMap_residueField_eq_zero, Ideal.over_def P (IsLocalRing.maximalIdeal R),
        Ideal.under_def, Ideal.mem_comap]
    have hφsurj : Function.Surjective φ := by
      intro y
      obtain ⟨z, rfl⟩ := hbij.2 y
      obtain ⟨r, rfl⟩ := Ideal.algebraMap_residueField_surjective (IsLocalRing.maximalIdeal R) z
      exact ⟨r, ((Ideal.ResidueField.mapₐ (IsLocalRing.maximalIdeal R) P (Algebra.ofId R S)
        (P.over_def (IsLocalRing.maximalIdeal R))).commutes r).symm⟩
    obtain ⟨u, huP, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) P
    obtain ⟨Pr⟩ := hstd.nonempty_standardEtalePresentation
    have hfu : IsUnit (algebraMap S P.ResidueField u) := by
      rw [isUnit_iff_ne_zero]
      intro h
      exact huP (Ideal.algebraMap_residueField_eq_zero.mp h)
    let ψ : Localization.Away u →ₐ[R] P.ResidueField :=
      IsLocalization.Away.liftAlgHom (A := R) u (f := IsScalarTower.toAlgHom R S P.ResidueField) hfu
    have hψ : ∀ s : S, ψ (algebraMap S (Localization.Away u) s) = algebraMap S P.ResidueField s := by
      intro s
      exact (IsLocalization.Away.liftAlgHom_apply u hfu _).trans (IsLocalization.Away.lift_eq u _ s)
    have heval : ∀ p : Polynomial R,
        Polynomial.eval₂ φ (ψ Pr.x) p = ψ (Polynomial.aeval Pr.x p) := by
      intro p
      rw [← Polynomial.aeval_algHom_apply, Polynomial.aeval_def]
    obtain ⟨hx1, hx2⟩ := Pr.hasMap
    have hy1 : Polynomial.eval₂ φ (ψ Pr.x) Pr.f = 0 := by rw [heval, hx1, map_zero]
    have hy2 : Polynomial.eval₂ φ (ψ Pr.x) Pr.g ≠ 0 := by
      rw [heval]
      exact (hx2.map ψ).ne_zero
    have hy3 : Polynomial.eval₂ φ (ψ Pr.x) (Polynomial.derivative Pr.f) ≠ 0 := by
      obtain ⟨p₁, p₂, n, hc⟩ := Pr.cond
      intro h0
      have h := congrArg (Polynomial.eval₂ φ (ψ Pr.x)) hc
      simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_pow, h0, hy1,
        zero_mul, add_zero] at h
      exact pow_ne_zero n hy2 h.symm
    have hHens := ((HenselianLocalRing.TFAE R).out 1 3).mp ‹HenselianLocalRing R›
    obtain ⟨a, ha1, ha2⟩ := hHens φ hφsurj Pr.f Pr.monic_f (ψ Pr.x) hy1 hy3
    have hga : IsUnit (Polynomial.eval a Pr.g) := by
      have h1 : φ (Polynomial.eval a Pr.g) ≠ 0 := by
        rw [← Polynomial.eval₂_hom, ha2]
        exact hy2
      by_contra hn
      exact h1 ((hφker _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hn))
    have hA : Pr.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]; exact ha1
      · rw [Polynomial.coe_aeval_eq_eval]; exact hga
    let τ : Pr.Ring →ₐ[R] R := Pr.P.lift a hA
    let e : Pr.Ring ≃ₐ[R] Localization.Away u :=
      AlgEquiv.ofBijective (Pr.lift Pr.x Pr.hasMap) Pr.lift_bijective
    let σ₀ : Localization.Away u →ₐ[R] R := τ.comp (e.symm : Localization.Away u →ₐ[R] Pr.Ring)
    let σ : S →ₐ[R] R := σ₀.comp (IsScalarTower.toAlgHom R S (Localization.Away u))
    have hagree : ψ.comp (e : Pr.Ring →ₐ[R] Localization.Away u) =
        (Algebra.ofId R P.ResidueField).comp τ := by
      apply StandardEtalePair.hom_ext
      have h1 : e Pr.X = Pr.x := StandardEtalePair.lift_X _ _ Pr.hasMap
      have h2 : τ Pr.X = a := StandardEtalePair.lift_X _ _ hA
      show ψ (e Pr.X) = Algebra.ofId R P.ResidueField (τ Pr.X)
      rw [h1, h2, Algebra.ofId_apply]
      exact ha2.symm
    have hagree' : ∀ t, ψ t = φ (σ₀ t) := by
      intro t
      have h := AlgHom.congr_fun hagree (e.symm t)
      change ψ (e (e.symm t)) = algebraMap R P.ResidueField (τ (e.symm t)) at h
      rw [AlgEquiv.apply_symm_apply] at h
      exact h
    refine ⟨σ, ?_⟩
    ext s
    rw [Ideal.mem_comap, ← hφker]
    change φ (σ₀ (algebraMap S (Localization.Away u) s)) = 0 ↔ s ∈ P
    rw [← hagree', hψ, Ideal.algebraMap_residueField_eq_zero]

  have key : ∃ (C : Type u) (_ : CommRing C) (φ : B →+* C) (e : Y ≅ Spec (.of C)),
      φ.Etale ∧ Function.Surjective (PrimeSpectrum.comap φ) ∧
      e.hom ≫ Spec.map (CommRingCat.ofHom φ) = q := by
    haveI : IsAffine Y := isAffine_of_isAffineHom q
    let φ : B →+* Γ(Y, ⊤) := ((Scheme.ΓSpecIso (.of B)).inv ≫ q.appTop).hom
    have he : Y.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom φ) = q := by
      rw [CommRingCat.ofHom_hom, Spec.map_comp, ← Category.assoc, Scheme.isoSpec_hom_naturality,
        Category.assoc, Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
        Category.comp_id]
    have hφe : φ.Etale := by
      have h : Etale (Spec.map (CommRingCat.ofHom φ)) := by
        rw [← Iso.inv_hom_id_assoc Y.isoSpec (Spec.map (CommRingCat.ofHom φ)), he]
        infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp h
    refine ⟨Γ(Y, ⊤), inferInstance, φ, Y.isoSpec, hφe, ?_, he⟩
    intro x
    obtain ⟨y, hy⟩ : x ∈ Set.range q := by rw [hsurj]; trivial
    refine ⟨Y.isoSpec.hom y, ?_⟩
    rw [← hy, ← he, Scheme.Hom.comp_apply]
    rfl
  obtain ⟨C, _, φ, e, hφe, hcs, he⟩ := key
  letI : Algebra B C := φ.toAlgebra
  haveI : Algebra.Etale B C := RingHom.etale_algebraMap.mp hφe
  obtain ⟨x, hx⟩ := hcs (IsLocalRing.closedPoint B)
  have hPm : Ideal.comap φ x.asIdeal = IsLocalRing.maximalIdeal B := by
    have h := congrArg PrimeSpectrum.asIdeal hx
    rw [PrimeSpectrum.comap_asIdeal] at h
    exact h
  haveI : x.asIdeal.LiesOver (IsLocalRing.maximalIdeal B) :=
    ⟨by rw [Ideal.under_def]; exact hPm.symm⟩
  have hbij : Function.Bijective (Ideal.ResidueField.mapₐ (IsLocalRing.maximalIdeal B) x.asIdeal
      (Algebra.ofId B C) (x.asIdeal.over_def (IsLocalRing.maximalIdeal B))) := by
    refine ⟨(Ideal.ResidueField.mapₐ (IsLocalRing.maximalIdeal B) x.asIdeal
      (Algebra.ofId B C) (x.asIdeal.over_def (IsLocalRing.maximalIdeal B))).toRingHom.injective, ?_⟩
    haveI hloc : IsLocalHom (algebraMap B (Localization.AtPrime x.asIdeal)) := by
      refine ⟨fun b hb => ?_⟩
      rw [IsScalarTower.algebraMap_apply B C (Localization.AtPrime x.asIdeal),
        IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime x.asIdeal) x.asIdeal] at hb
      by_contra hn
      have hm : b ∈ IsLocalRing.maximalIdeal B := hn
      rw [← hPm, Ideal.mem_comap] at hm
      exact hb hm
    have hs := IsSepClosed.algebraMap_surjective (IsLocalRing.ResidueField B)
      (IsLocalRing.ResidueField (Localization.AtPrime x.asIdeal))
    intro y
    obtain ⟨z, hz⟩ := hs y
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective z
    refine ⟨algebraMap B (IsLocalRing.maximalIdeal B).ResidueField b, ?_⟩
    rw [AlgHom.commutes, ← hz, IsLocalRing.ResidueField.algebraMap_residue]
    rfl
  obtain ⟨σ, -⟩ := hens B C x.asIdeal hbij
  refine ⟨Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ e.inv, ?_⟩
  have hσφ : σ.toRingHom.comp φ = RingHom.id B := by
    ext b
    exact σ.commutes b
  rw [← he, Category.assoc, Iso.inv_hom_id_assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hσφ,
    CommRingCat.ofHom_id, Spec.map_id]

theorem wc_fnr_normal_noetherian_exhaustion : ∀ (K : Type u) [Field K] [IsAlgClosed K] (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (κ : K →+* A), ∃ Λ : Finset A → Subring A, Monotone Λ ∧ (∀ S, ∀ a ∈ S, a ∈ Λ S) ∧ (∀ S (c : K), κ c ∈ Λ S) ∧ (∀ S, IsNoetherianRing ↥(Λ S)) ∧ (∀ S, IsIntegrallyClosed ↥(Λ S)) :=
by

  have hs3 : ∀ (K : Type u) [Field K] (d : ℕ) (B : Type u) [CommRing B] [IsDomain B] [Algebra (MvPolynomial (Fin d) K) B] [Module.Finite (MvPolynomial (Fin d) K) B], Function.Injective (algebraMap (MvPolynomial (Fin d) K) B) → ∃ (n : ℕ) (G : Finset (FractionRing B)), ∀ x : FractionRing B, _root_.IsIntegral (MvPolynomial (Fin d) K) x → x ^ (ringExpChar K ^ n) ∈ Submodule.span (MvPolynomial (Fin d) K) (G : Set (FractionRing B)) := by
    intro K _ d B _ _ _ _ hinj
    classical
    have hPL : Function.Injective (algebraMap (MvPolynomial (Fin d) K) (FractionRing B)) := by
      rw [IsScalarTower.algebraMap_eq (MvPolynomial (Fin d) K) B (FractionRing B)]
