      (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ U)
      Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) :=
    Scheme.Hom.finite_app p _ hU'
  haveI hflatL : Module.Flat Γ(Limits.pullback f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀)))), Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ U)
