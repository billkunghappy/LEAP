      mU ≫ Limits.pullback.fst (U.ι ≫ (F.obj l).hom ≫ wcHalA1Proj s)
        (Spec.map (CommRingCat.ofHom j)) := by
    rw [Category.assoc, hτq, hmU1]
  obtain ⟨v, hv2⟩ : ∃ v, v ≫ Limits.pullback.snd pl r = mU := ⟨_, hipb.lift_snd _ _ hv⟩
  refine ⟨hpb.lift (v ≫ Limits.pullback.fst pl r) (𝟙 _) ?_, hpb.lift_snd _ _ _⟩
  rw [Category.id_comp, Category.assoc, Limits.pullback.condition, ← Category.assoc, hv2]
  apply Limits.pullback.hom_ext
  · rw [Category.assoc, hr1, ← Category.assoc, hmU1, Category.assoc, hφUf]
    exact (Limits.pullback.lift_fst _ _ _).symm
  · rw [Category.assoc, hr2, hmU2]
    exact (Limits.pullback.lift_snd _ _ _).symm

theorem wc_et_milnor_fibre_h1_vanishing : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Subsingleton (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ 1) :=
by
  intro K _ _ ℓ hℓ hℓK A _ _ _ s x hx hxc B _ _ _ Λ _ _ W' φ a hd Ω _ _ z
  classical

  have hsec : ∀ {Y Y' : Scheme.{u}} (h : Y' ⟶ Y),
      (∀ (P : Scheme.{u}) (p : P ⟶ Y') (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α →
        ∃ σ : Y' ⟶ P, σ ≫ p = 𝟙 Y') →
      ∀ (P : Scheme.{u}) (p : P ⟶ Y) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α →
        ∃ u : Y' ⟶ P, u ≫ p = h := by
    intro Y Y' h H P p α hP
    obtain ⟨α', hα'⟩ := wc_fet_torsor_base_change p h ℓ α hP
    obtain ⟨σ, hσ⟩ := H _ _ α' hα'
