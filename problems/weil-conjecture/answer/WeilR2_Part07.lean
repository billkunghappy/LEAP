        Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} φ) ∧
        Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} φ) := by
    intro C D _ _ J K G _ _ _ _ _ S R φ _ _ _ _
    haveI hΦA : (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).Additive :=
