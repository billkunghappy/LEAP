  haveI : IsScalarTower Γ(X, W) Γ(Limits.pullback f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))), Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ W)
