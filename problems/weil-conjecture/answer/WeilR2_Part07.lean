theorem wc_plp_loc_etale_of_etale_nbhd : ∀ {N X : Scheme.{u}} (ν : N ⟶ X) [IsAffineHom ν] (U : X.Opens) (hU : IsAffineOpen U) (y : X) (hy : y ∈ U) (W : X.Opens), y ∈ W → Etale (ν ∣_ W) → wcCg2LocEtale (Scheme.Hom.app ν U).hom (hU.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl :=
by
  intro N X ν _ U hU y hy W hyW hW

  have alg : ∀ {R S Rr Sr : Type u} [CommRing R] [CommRing S] [CommRing Rr] [CommRing Sr]
      [Algebra R Rr] [Algebra S Sr] (φ : R →+* S) (r : R) [IsLocalization.Away r Rr]
      [IsLocalization.Away (φ r) Sr], (IsLocalization.Away.map Rr Sr φ r).Etale →
      ∀ (Q : Ideal R) [Q.IsPrime], r ∉ Q → wcCg2LocEtale φ Q.primeCompl := by
    intro R S Rr Sr _ _ _ _ _ _ φ r _ _ hg Q _ hrQ
    have E0 : (IsLocalization.Away.map Rr Sr φ r).comp (algebraMap R Rr) =
        (algebraMap S Sr).comp φ := IsLocalization.map_comp _
    have E0x : ∀ x, (IsLocalization.Away.map Rr Sr φ r) (algebraMap R Rr x) =
        algebraMap S Sr (φ x) := fun x => RingHom.congr_fun E0 x
    have ha : Submonoid.powers r ≤ Q.primeCompl := (Submonoid.powers_le).mpr hrQ
    have hb : Submonoid.powers (φ r) ≤ Q.primeCompl.map φ :=
      (Submonoid.powers_le).mpr (Submonoid.mem_map_of_mem φ hrQ)
    letI : Algebra Rr (Localization Q.primeCompl) :=
      IsLocalization.localizationAlgebraOfSubmonoidLe Rr (Localization Q.primeCompl)
        (Submonoid.powers r) Q.primeCompl ha
    haveI : IsScalarTower R Rr (Localization Q.primeCompl) :=
      IsLocalization.localization_isScalarTower_of_submonoid_le Rr (Localization Q.primeCompl)
        (Submonoid.powers r) Q.primeCompl ha
    haveI : IsLocalization (Q.primeCompl.map (algebraMap R Rr)) (Localization Q.primeCompl) :=
      IsLocalization.isLocalization_of_submonoid_le Rr (Localization Q.primeCompl)
        (Submonoid.powers r) Q.primeCompl ha
    letI : Algebra Sr (Localization (Q.primeCompl.map φ)) :=
      IsLocalization.localizationAlgebraOfSubmonoidLe Sr (Localization (Q.primeCompl.map φ))
        (Submonoid.powers (φ r)) (Q.primeCompl.map φ) hb
    haveI : IsScalarTower S Sr (Localization (Q.primeCompl.map φ)) :=
      IsLocalization.localization_isScalarTower_of_submonoid_le Sr
        (Localization (Q.primeCompl.map φ)) (Submonoid.powers (φ r)) (Q.primeCompl.map φ) hb
    have h1 : IsLocalization ((Q.primeCompl.map φ).map (algebraMap S Sr))
        (Localization (Q.primeCompl.map φ)) :=
      IsLocalization.isLocalization_of_submonoid_le Sr (Localization (Q.primeCompl.map φ))
        (Submonoid.powers (φ r)) (Q.primeCompl.map φ) hb
    have hsub : (Q.primeCompl.map (algebraMap R Rr)).map (IsLocalization.Away.map Rr Sr φ r) =
        (Q.primeCompl.map φ).map (algebraMap S Sr) := by
      ext z
      simp only [Submonoid.mem_map]
      constructor
      · rintro ⟨_, ⟨m, hm, rfl⟩, rfl⟩
        exact ⟨φ m, ⟨m, hm, rfl⟩, (E0x m).symm⟩
      · rintro ⟨_, ⟨m, hm, rfl⟩, rfl⟩
        exact ⟨algebraMap R Rr m, ⟨m, hm, rfl⟩, E0x m⟩
    haveI : IsLocalization ((Q.primeCompl.map (algebraMap R Rr)).map
        (IsLocalization.Away.map Rr Sr φ r)) (Localization (Q.primeCompl.map φ)) := by
      rw [hsub]; exact h1
    have key := RingHom.Etale.isStableUnderBaseChange.localizationPreserves
      (IsLocalization.Away.map Rr Sr φ r) (Q.primeCompl.map (algebraMap R Rr))
      (Localization Q.primeCompl) (Localization (Q.primeCompl.map φ)) hg
    have heq : (IsLocalization.map (Localization (Q.primeCompl.map φ)) φ
        Q.primeCompl.le_comap_map :
          Localization Q.primeCompl →+* Localization (Q.primeCompl.map φ)) =
        IsLocalization.map (Localization (Q.primeCompl.map φ))
          (IsLocalization.Away.map Rr Sr φ r)
          (Q.primeCompl.map (algebraMap R Rr)).le_comap_map := by
      apply IsLocalization.ringHom_ext Q.primeCompl
      ext x
      simp only [RingHom.comp_apply]
      rw [IsLocalization.map_eq, IsScalarTower.algebraMap_apply R Rr (Localization Q.primeCompl) x,
        IsLocalization.map_eq, E0x, ← IsScalarTower.algebraMap_apply]
    unfold wcCg2LocEtale
    rw [heq]
    exact key
  haveI : IsZariskiLocalAtTarget @Etale := HasRingHomProperty.instIsZariskiLocalAtTarget @Etale
  obtain ⟨r, hrW, hyr⟩ := hU.exists_basicOpen_le (V := W) ⟨y, hyW⟩ hy

  have h1 : Etale (ν ∣_ X.basicOpen r) := by
    have h0 := IsZariskiLocalAtTarget.restrict hW (W.ι ⁻¹ᵁ X.basicOpen r)
    have heq : W.ι ''ᵁ (W.ι ⁻¹ᵁ X.basicOpen r) = X.basicOpen r := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hrW
    haveI := h0
    rw [Arrow.iso_w' ((morphismRestrictRestrict ν W _) ≪≫ morphismRestrictEq ν heq)]
    infer_instance

  have hV : IsAffineOpen (X.basicOpen r) := hU.basicOpen r
  have hV' : IsAffineOpen (ν ⁻¹ᵁ X.basicOpen r) := hV.preimage ν
  have h2 : (ν.app (X.basicOpen r)).hom.Etale := by
    haveI : IsAffine (X.basicOpen r) := hV
    haveI : IsAffine (ν ⁻¹ᵁ X.basicOpen r) := hV'
    have h := h1
    rw [HasRingHomProperty.iff_of_isAffine (P := @Etale), morphismRestrict_appTop] at h
    have h' := (RingHom.RespectsIso.cancel_right_isIso RingHom.Etale.respectsIso
      (ν.app ((X.basicOpen r).ι ''ᵁ ⊤)) (N.presheaf.map (eqToHom _).op)).mp h
    rwa [Scheme.Opens.ι_image_top] at h'

  haveI := hU.isLocalization_basicOpen r
  haveI := (hU.preimage ν).isLocalization_basicOpen ((ν.app U).hom r)
  have h3 : (IsLocalization.Away.map Γ(X, X.basicOpen r) Γ(N, N.basicOpen ((ν.app U).hom r))
      (ν.app U).hom r).Etale := by
    rw [IsAffineOpen.app_basicOpen_eq_away_map ν hU (hU.preimage ν) r, CommRingCat.hom_comp] at h2
    have h3 := (RingHom.RespectsIso.cancel_right_isIso RingHom.Etale.respectsIso _ _).mp h2
    rw [CommRingCat.hom_ofHom] at h3
    exact h3

  have hr : r ∉ (hU.primeIdealOf ⟨y, hy⟩).asIdeal := by
    have e1 : hU.fromSpec (hU.primeIdealOf ⟨y, hy⟩) = y := hU.fromSpec_primeIdealOf ⟨y, hy⟩
    have e2 : hU.primeIdealOf ⟨y, hy⟩ ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen r := by
      show hU.fromSpec (hU.primeIdealOf ⟨y, hy⟩) ∈ X.basicOpen r
      rw [e1]; exact hyr
    rw [hU.fromSpec_preimage_basicOpen] at e2
    exact e2
  exact alg (ν.app U).hom r h3 _ hr

theorem wc_pdp_normalization_chart : ∀ {X P : Scheme.{u}} (g : P ⟶ X) [QuasiCompact g] [QuasiSeparated g] (U : X.Opens) (hU : IsAffineOpen U), ∃ j : Γ(Scheme.Hom.normalization g, Scheme.Hom.fromNormalization g ⁻¹ᵁ U) →+* Γ(P, g ⁻¹ᵁ U), Function.Injective j ∧ j.comp (Scheme.Hom.app (Scheme.Hom.fromNormalization g) U).hom = (Scheme.Hom.app g U).hom ∧ ∀ t : Γ(P, g ⁻¹ᵁ U), (Scheme.Hom.app g U).hom.IsIntegralElem t ↔ ∃ c, j c = t :=
by
  intro X P g _ _ U hU
  letI : Algebra Γ(X, U) Γ(P, g ⁻¹ᵁ U) := (Scheme.Hom.app g U).hom.toAlgebra
  let e := Scheme.Hom.normalizationObjIso g hU
  let I := integralClosure Γ(X, U) Γ(P, g ⁻¹ᵁ U)
  let j : Γ(Scheme.Hom.normalization g, Scheme.Hom.fromNormalization g ⁻¹ᵁ U) →+* Γ(P, g ⁻¹ᵁ U) :=
    I.val.toRingHom.comp e.hom.hom
  have hK : ∀ c, j c = ((e.hom.hom c : I) : Γ(P, g ⁻¹ᵁ U)) := fun _ => rfl
  have hhi : ∀ y : I, e.hom.hom (e.inv.hom y) = y := fun y => CommRingCat.hom_inv_apply e y
  have hih : ∀ c, e.inv.hom (e.hom.hom c) = c := fun c => CommRingCat.inv_hom_apply e c
  refine ⟨j, ?_, ?_, ?_⟩
  · intro c₁ c₂ h
    rw [hK, hK] at h
    have h' : e.hom.hom c₁ = e.hom.hom c₂ := Subtype.ext h
    rw [← hih c₁, ← hih c₂, h']
  · ext r
    have h := Scheme.Hom.fromNormalization_app g hU
    rw [RingHom.comp_apply, h]
    change ((e.hom.hom (e.inv.hom (algebraMap Γ(X, U) I r)) : I) : Γ(P, g ⁻¹ᵁ U)) = _
    rw [hhi]
    rfl
  · intro t
    have ha : (Scheme.Hom.app g U).hom.IsIntegralElem t ↔ t ∈ I := Iff.rfl
    rw [ha]
    constructor
    · intro ht
      exact ⟨e.inv.hom ⟨t, ht⟩, by rw [hK, hhi]⟩
    · rintro ⟨c, rfl⟩
      rw [hK]
      exact (e.hom.hom c).2

theorem wc_pdp_generic_units_flat : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) [Smooth f] (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))), IsFinite p → Etale p → ∀ (U : X.Opens) (hU : IsAffineOpen U), (Scheme.Hom.app (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) U).hom.Flat ∧ ∀ a₀ : A₀, a₀ ≠ 0 → IsUnit ((Scheme.Hom.app (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) U).hom (wcPlpChartMap f hU a₀)) :=
by
  intro A₀ _ _ X f _ P p hPf hPe U hU
  haveI : IsFinite p := hPf
  haveI : Etale p := hPe
  haveI hηflat : Flat (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) := by
    apply (HasRingHomProperty.Spec_iff (P := @Flat)).mpr
    have : Module.Flat A₀ (FractionRing A₀) :=
      IsLocalization.flat (FractionRing A₀) (nonZeroDivisors A₀)
    exact RingHom.flat_algebraMap_iff.mpr this
  haveI : IsAffineHom (Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback f _).flip
      inferInstance
  haveI hgflat : Flat (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := inferInstance
  haveI : IsAffineHom (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := inferInstance
  have hW := hU.preimage (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))
  refine ⟨?_, ?_⟩
  · rw [Scheme.Hom.app_eq_appLE]
    exact HasRingHomProperty.appLE (P := @Flat) _ hgflat ⟨U, hU⟩ ⟨_, hW⟩ le_rfl
  · intro a₀ ha₀
    have key : Spec.preimage (hU.fromSpec ≫ f) ≫ Scheme.Hom.app (p ≫ Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) U =
        CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)) ≫
          Spec.preimage (hW.fromSpec ≫ p ≫ Limits.pullback.snd f
            (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_comp, Spec.map_preimage, Spec.map_preimage,
        Scheme.Hom.app_eq_appLE, ← Category.assoc (Spec.map _) hU.fromSpec f,
        IsAffineOpen.SpecMap_appLE_fromSpec _ hU hW]
      simp only [Category.assoc]
      rw [Limits.pullback.condition]
    have h2 := congrArg (fun φ => (CommRingCat.Hom.hom φ) a₀) key
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    have hu : IsUnit (algebraMap A₀ (FractionRing A₀) a₀) :=
      IsLocalization.map_units (FractionRing A₀)
        (⟨a₀, mem_nonZeroDivisors_of_ne_zero ha₀⟩ : nonZeroDivisors A₀)
    unfold wcPlpChartMap
    rw [h2]
    exact hu.map _

theorem wc_pdp_regC_abstract : ∀ (A R C T : Type u) [CommRing A] [CommRing R] [CommRing C] [CommRing T] (ψ : A →+* R) (φ : R →+* C) (j : C →+* T) (𝔮 : Ideal R) [𝔮.IsPrime] (a b : A), Function.Injective j → (∀ t : T, (j.comp φ).IsIntegralElem t ↔ ∃ c, j c = t) → (j.comp φ).Flat → IsUnit (j (φ (ψ a))) → IsDomain (Localization.AtPrime 𝔮) → IsIntegrallyClosed (Localization.AtPrime 𝔮) → algebraMap R (Localization.AtPrime 𝔮) (ψ a) ≠ 0 → (∀ (k : ℕ) (y z : Localization.AtPrime 𝔮), algebraMap R (Localization.AtPrime 𝔮) (ψ b) ^ k * y = algebraMap R (Localization.AtPrime 𝔮) (ψ a) ^ k * z → ∃ w, y = algebraMap R (Localization.AtPrime 𝔮) (ψ a) ^ k * w) → wcPlpRegC ψ φ 𝔮 a b :=
by

  have t_s4 : ∀ (C : Type u) [CommRing C] (M : Submonoid C) (α β : C),
      (∀ c : C, α * c = 0 → c = 0) →
      (∀ c₁ c₂ : C, β * c₁ = α * c₂ → ∃ m ∈ M, ∃ w : C, m * c₁ = α * w) →
      (∀ y : Localization M, algebraMap C (Localization M) α * y = 0 → y = 0) ∧
      (∀ y z : Localization M, algebraMap C (Localization M) β * y =
        algebraMap C (Localization M) α * z → ∃ w, y = algebraMap C (Localization M) α * w) := by
    intro C _ M α β h1 h2
    constructor
    · intro y hy
      obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective M y
      rw [IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.mk'_eq_zero_iff] at hy
      obtain ⟨m, hm⟩ := hy
      rw [IsLocalization.mk'_eq_zero_iff]
      refine ⟨m, h1 _ ?_⟩
      rw [← hm]; ring
    · intro y z h
      obtain ⟨⟨c₁, s₁⟩, rfl⟩ := IsLocalization.mk'_surjective M y
      obtain ⟨⟨c₂, s₂⟩, rfl⟩ := IsLocalization.mk'_surjective M z
      rw [IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.mul_mk'_eq_mk'_of_mul,
        IsLocalization.eq] at h
      obtain ⟨t, ht⟩ := h
      obtain ⟨m, hmM, w, hw⟩ := h2 ((t : C) * s₂ * c₁) (t * s₁ * c₂) (by linear_combination ht)
      refine ⟨IsLocalization.mk' (Localization M) w (⟨m, hmM⟩ * t * s₂ * s₁), ?_⟩
      rw [IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.eq]
      refine ⟨1, ?_⟩
      show (1 : C) * ((m * t * s₂ * s₁) * c₁) = 1 * (s₁ * (α * w))
      linear_combination (s₁ : C) * hw

  have t_s3 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] [Module.Flat R T]
      (S : Submonoid R),
      Module.Flat (Localization S) (Localization (Algebra.algebraMapSubmonoid T S)) := by
    intro R T _ _ _ _ S
    have : IsLocalizedModule S (IsScalarTower.toAlgHom R T
        (Localization (Algebra.algebraMapSubmonoid T S))).toLinearMap :=
      isLocalizedModule_iff_isLocalization.mpr inferInstance
    exact Module.Flat.of_isLocalizedModule (Localization S) S
      (IsScalarTower.toAlgHom R T (Localization (Algebra.algebraMapSubmonoid T S))).toLinearMap

  have t_s2 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (S : Submonoid R) (e : T),
      IsIntegral (Localization S)
        (algebraMap T (Localization (Algebra.algebraMapSubmonoid T S)) e) →
      ∃ r ∈ S, IsIntegral R (algebraMap R T r * e) := by
    intro R T _ _ _ S e h
    obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization S _ h
    have hm' : IsIntegral R (algebraMap T (Localization (Algebra.algebraMapSubmonoid T S))
        (algebraMap R T m * e)) := by
      convert hm using 1
      rw [Submonoid.smul_def, Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply]
    obtain ⟨p, hp, hpy⟩ := hm'
    have h0 : algebraMap T (Localization (Algebra.algebraMapSubmonoid T S))
        (Polynomial.aeval (algebraMap R T m * e) p) = algebraMap T _ 0 := by
      rw [map_zero, ← Polynomial.aeval_algebraMap_apply]; exact hpy
    obtain ⟨⟨c, hc⟩, hc0⟩ := IsLocalization.exists_of_eq (M := Algebra.algebraMapSubmonoid T S) h0
    obtain ⟨s, hs, rfl⟩ := hc
    refine ⟨s * m, S.mul_mem hs m.2, ?_⟩
    refine ⟨Polynomial.X * p.scaleRoots s,
      Polynomial.monic_X.mul ((Polynomial.monic_scaleRoots_iff s).mpr hp), ?_⟩
    have key : algebraMap R T (s * m) * e = algebraMap R T s * (algebraMap R T m * e) := by
      rw [map_mul, mul_assoc]
    rw [key, ← Polynomial.aeval_def, Polynomial.aeval_mul, Polynomial.aeval_X,
      Polynomial.aeval_def, Polynomial.scaleRoots_eval₂_mul]
    have hc0' : algebraMap R T s *
        Polynomial.eval₂ (algebraMap R T) (algebraMap R T m * e) p = 0 := by
      rw [mul_zero] at hc0; exact hc0
    calc _ = (algebraMap R T m * e) * (algebraMap R T s) ^ p.natDegree *
          (algebraMap R T s * Polynomial.eval₂ (algebraMap R T) (algebraMap R T m * e) p) := by
          ring
      _ = 0 := by rw [hc0', mul_zero]

  have t_minpoly_smul : ∀ (K L : Type u) [Field K] [CommRing L] [Algebra K L] (x : L) (s : K),
      s ≠ 0 → IsIntegral K x →
      minpoly K (algebraMap K L s * x) = (minpoly K x).scaleRoots s := by
    intro K L _ _ _ x s hs hx
    have hsx : IsIntegral K (algebraMap K L s * x) := isIntegral_algebraMap.mul hx
    have h1 : minpoly K (algebraMap K L s * x) ∣ (minpoly K x).scaleRoots s :=
      minpoly.dvd K _ (Polynomial.scaleRoots_aeval_eq_zero (minpoly.aeval K x))
    have hx' : algebraMap K L s⁻¹ * (algebraMap K L s * x) = x := by
      rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hs, map_one, one_mul]
    have h2 : minpoly K x ∣ (minpoly K (algebraMap K L s * x)).scaleRoots s⁻¹ := by
      apply minpoly.dvd K x
      have h := Polynomial.scaleRoots_aeval_eq_zero (r := s⁻¹)
        (minpoly.aeval K (algebraMap K L s * x))
      rw [hx'] at h
      exact h
    have hm1 : (minpoly K x).Monic := minpoly.monic hx
    have hm2 : (minpoly K (algebraMap K L s * x)).Monic := minpoly.monic hsx
    have d2 := Polynomial.natDegree_le_of_dvd h2
      ((Polynomial.monic_scaleRoots_iff s⁻¹).mpr hm2).ne_zero
    rw [Polynomial.natDegree_scaleRoots] at d2
    exact (Polynomial.eq_of_monic_of_dvd_of_natDegree_le hm2
      ((Polynomial.monic_scaleRoots_iff s).mpr hm1) h1
      (by rw [Polynomial.natDegree_scaleRoots]; exact d2)).symm

  have t_s1 : ∀ (O T : Type u) [CommRing O] [IsDomain O] [IsIntegrallyClosed O] [CommRing T]
      [Algebra O T] [Module.Flat O T] (a b : O), a ≠ 0 →
      (∀ (k : ℕ) (y z : O), b ^ k * y = a ^ k * z → ∃ w, y = a ^ k * w) → ∀ (e : T),
      IsIntegral O (algebraMap O T a * e) → IsIntegral O (algebraMap O T b * e) →
      IsIntegral O e := by
    intro O T _ _ _ _ _ _ a b ha hH e hae hbe
    by_cases hb : b = 0
    · obtain ⟨w, hw⟩ := hH 1 1 0 (by simp [hb])
      have hw' : a * w = 1 := by simpa using hw.symm
      have : e = algebraMap O T w * (algebraMap O T a * e) := by
        rw [← mul_assoc, ← map_mul, mul_comm w a, hw', map_one, one_mul]
      rw [this]; exact isIntegral_algebraMap.mul hae
    · let K := FractionRing O
      let L := Localization (Algebra.algebraMapSubmonoid T (nonZeroDivisors O))
      letI : Algebra K L := localizationAlgebra (nonZeroDivisors O) T
      have hD : Algebra.algebraMapSubmonoid T (nonZeroDivisors O) ≤ nonZeroDivisors T := by
        rintro _ ⟨d, hd, rfl⟩
        have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := T) hd
        rw [mem_nonZeroDivisors_iff]
        constructor
        · intro x hx
          refine hreg ?_
          show d • x = d • (0 : T)
          rw [smul_zero, Algebra.smul_def]; exact hx
        · intro x hx
          refine hreg ?_
          show d • x = d • (0 : T)
          rw [smul_zero, Algebra.smul_def, mul_comm]; exact hx
      have hinj : Function.Injective (algebraMap T L) := IsLocalization.injective L hD
      have hmapO : ∀ c : O, IsIntegral O (algebraMap O T c * e) →
          IsIntegral O (algebraMap K L (algebraMap O K c) * algebraMap T L e) := by
        intro c hc
        have := hc.map (IsScalarTower.toAlgHom O T L)
        rwa [IsScalarTower.toAlgHom_apply, map_mul, ← IsScalarTower.algebraMap_apply,
          IsScalarTower.algebraMap_apply O K L] at this
      have haK : algebraMap O K a ≠ 0 := fun h =>
        ha (IsFractionRing.injective O K (by rw [h, map_zero]))
      have hbK : algebraMap O K b ≠ 0 := fun h =>
        hb (IsFractionRing.injective O K (by rw [h, map_zero]))
      have he'' : IsIntegral K (algebraMap T L e) := by
        have : algebraMap T L e = algebraMap K L (algebraMap O K a)⁻¹ *
            (algebraMap K L (algebraMap O K a) * algebraMap T L e) := by
          rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ haK, map_one, one_mul]
        rw [this]; exact isIntegral_algebraMap.mul (hmapO a hae).tower_top
      have hcoef : ∀ c : O, algebraMap O K c ≠ 0 → IsIntegral O (algebraMap O T c * e) →
          ∀ i, ∃ y : O, algebraMap O K y = (minpoly K (algebraMap T L e)).coeff i *
            (algebraMap O K c) ^ ((minpoly K (algebraMap T L e)).natDegree - i) := by
        intro c hc0 hc i
        obtain ⟨F, hFm, hF⟩ := hmapO c hc
        have hdvd : minpoly K (algebraMap K L (algebraMap O K c) * algebraMap T L e) ∣
            F.map (algebraMap O K) := by
          apply minpoly.dvd
          rw [Polynomial.aeval_map_algebraMap]; exact hF
        obtain ⟨G, hG⟩ := IsIntegrallyClosed.eq_map_mul_C_of_dvd K hFm hdvd
        rw [(minpoly.monic (isIntegral_algebraMap.mul he'')).leadingCoeff, Polynomial.C_1,
          mul_one, t_minpoly_smul K L _ _ hc0 he''] at hG
        refine ⟨G.coeff i, ?_⟩
        rw [← Polynomial.coeff_map, hG, Polynomial.coeff_scaleRoots]
      have hcoefO : ∀ i, ∃ w : O, algebraMap O K w = (minpoly K (algebraMap T L e)).coeff i := by
        intro i
        obtain ⟨y, hy⟩ := hcoef a haK hae i
        obtain ⟨z, hz⟩ := hcoef b hbK hbe i
        have hyz : b ^ ((minpoly K (algebraMap T L e)).natDegree - i) * y =
            a ^ ((minpoly K (algebraMap T L e)).natDegree - i) * z := by
          apply IsFractionRing.injective O K
          simp only [map_mul, map_pow]
          rw [hy, hz]; ring
        obtain ⟨w, hw⟩ := hH _ y z hyz
        refine ⟨w, ?_⟩
        have hw' : algebraMap O K y = algebraMap O K a ^
            ((minpoly K (algebraMap T L e)).natDegree - i) * algebraMap O K w := by
          rw [hw, map_mul, map_pow]
        have h0 : algebraMap O K a ^ ((minpoly K (algebraMap T L e)).natDegree - i) *
            (algebraMap O K w - (minpoly K (algebraMap T L e)).coeff i) = 0 := by
          linear_combination hy - hw'
        exact sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_left (pow_ne_zero _ haK))
      have hlift : minpoly K (algebraMap T L e) ∈ Polynomial.lifts (algebraMap O K) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro i
        obtain ⟨w, hw⟩ := hcoefO i
        exact ⟨w, hw⟩
      obtain ⟨μ₀, hμ₀map, -, hμ₀m⟩ :=
        Polynomial.lifts_and_natDegree_eq_and_monic hlift (minpoly.monic he'')
      refine ⟨μ₀, hμ₀m, ?_⟩
      apply hinj
      rw [map_zero, ← Polynomial.aeval_def, ← Polynomial.aeval_algebraMap_apply,
        ← Polynomial.aeval_map_algebraMap K, hμ₀map, minpoly.aeval]

  intro A R C T _ _ _ _ ψ φ j 𝔮 _ a b hj hint hflat hunit hdom hic hne hH
  unfold wcPlpRegC
  apply t_s4 C (𝔮.primeCompl.map φ) (φ (ψ a)) (φ (ψ b))
  · intro c hc
    apply hj
    rw [map_zero]
    have : j (φ (ψ a)) * j c = 0 := by rw [← map_mul, hc, map_zero]
    exact hunit.mul_right_eq_zero.mp this
  · intro c₁ c₂ hc
    letI : Algebra R T := (j.comp φ).toAlgebra
    haveI : Module.Flat R T := hflat
    obtain ⟨v, hv⟩ := hunit
    have hγ : ∀ x : R, algebraMap R T x = j (φ x) := fun x => rfl
    have hae : algebraMap R T (ψ a) * ((↑v⁻¹ : T) * j c₁) = j c₁ := by
      rw [hγ, ← hv, Units.mul_inv_cancel_left]
    have hbe : algebraMap R T (ψ b) * ((↑v⁻¹ : T) * j c₁) = j c₂ := by
      have h2 : j (φ (ψ b)) * j c₁ = ↑v * j c₂ := by rw [← map_mul, hc, map_mul, hv]
      rw [hγ, mul_left_comm, h2, Units.inv_mul_cancel_left]
    have hI1 : IsIntegral R (algebraMap R T (ψ a) * ((↑v⁻¹ : T) * j c₁)) :=
      (hint _).mpr ⟨c₁, hae.symm⟩
    have hI2 : IsIntegral R (algebraMap R T (ψ b) * ((↑v⁻¹ : T) * j c₁)) :=
      (hint _).mpr ⟨c₂, hbe.symm⟩
    haveI hT'flat : Module.Flat (Localization.AtPrime 𝔮)
        (Localization (Algebra.algebraMapSubmonoid T 𝔮.primeCompl)) := t_s3 R T 𝔮.primeCompl
    have hpush : ∀ x : R, IsIntegral R (algebraMap R T x * ((↑v⁻¹ : T) * j c₁)) →
        IsIntegral (Localization.AtPrime 𝔮)
          (algebraMap (Localization.AtPrime 𝔮)
            (Localization (Algebra.algebraMapSubmonoid T 𝔮.primeCompl))
            (algebraMap R (Localization.AtPrime 𝔮) x) *
          algebraMap T (Localization (Algebra.algebraMapSubmonoid T 𝔮.primeCompl))
            ((↑v⁻¹ : T) * j c₁)) := by
      intro x hx
      have := hx.map (IsScalarTower.toAlgHom R T
        (Localization (Algebra.algebraMapSubmonoid T 𝔮.primeCompl)))
      rw [IsScalarTower.toAlgHom_apply, map_mul, ← IsScalarTower.algebraMap_apply,
        IsScalarTower.algebraMap_apply R (Localization.AtPrime 𝔮)
          (Localization (Algebra.algebraMapSubmonoid T 𝔮.primeCompl))] at this
      exact this.tower_top
    have hO := t_s1 (Localization.AtPrime 𝔮)
      (Localization (Algebra.algebraMapSubmonoid T 𝔮.primeCompl)) _ _ hne hH
      (algebraMap T (Localization (Algebra.algebraMapSubmonoid T 𝔮.primeCompl))
        ((↑v⁻¹ : T) * j c₁)) (hpush _ hI1) (hpush _ hI2)
    obtain ⟨r, hr, hrI⟩ := t_s2 R T 𝔮.primeCompl _ hO
    obtain ⟨w, hw⟩ := (hint _).mp hrI
    refine ⟨φ r, Submonoid.mem_map_of_mem φ hr, w, ?_⟩
    apply hj
    rw [map_mul, map_mul, hw, hγ, ← hv, mul_left_comm (↑v : T), Units.mul_inv_cancel_left]

theorem wc_plp_depth_pair : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], IsFinite p → Etale p → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ x : X, 2 ≤ (f x).asIdeal.height → ∀ (U : X.Opens) (hU : IsAffineOpen U) (hx : x ∈ U), ∃ a b : A₀, @wcPlpRegA A₀ _ (f x).asIdeal (f x).isPrime a b ∧ wcPlpRegC (wcPlpChartMap f hU) (Scheme.Hom.app (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) U).hom (hU.primeIdealOf ⟨x, hx⟩).asIdeal a b :=
by
  intro A₀ _ _ _ _ X _ _ f _ P p _ _ hPf hPe hnorm _ _ x hx2 U hU hxU
  classical

  have key : ∀ (𝔭 : Ideal A₀) [𝔭.IsPrime], 2 ≤ 𝔭.height → ∃ a b : A₀, a ≠ 0 ∧ wcPlpRegA 𝔭 a b ∧
      wcCg2HP (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔭)
        (algebraMap A₀ (Localization.AtPrime 𝔭) a) (algebraMap A₀ (Localization.AtPrime 𝔭) b) := by
    intro 𝔭 _ h2
    haveI : IsIntegrallyClosed (Localization.AtPrime 𝔭) :=
      isIntegrallyClosed_of_isLocalization (Localization.AtPrime 𝔭) 𝔭.primeCompl
        (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
    have hm : (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)).height = 𝔭.height := by
      rw [← IsLocalization.height_under 𝔭.primeCompl
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)),
        IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime 𝔭) 𝔭]
    obtain ⟨a', ha'm, b', hb'm, ha'0, hb'0, hH'⟩ :=
      wc_cg2_normal_depth_two (Localization.AtPrime 𝔭) (by rw [hm]; exact h2)
    obtain ⟨⟨a, s⟩, has0⟩ := IsLocalization.surj 𝔭.primeCompl a'
    obtain ⟨⟨b, t⟩, hbt0⟩ := IsLocalization.surj 𝔭.primeCompl b'
    have has : a' * algebraMap A₀ (Localization.AtPrime 𝔭) (s : A₀) =
        algebraMap A₀ (Localization.AtPrime 𝔭) a := has0
    have hbt : b' * algebraMap A₀ (Localization.AtPrime 𝔭) (t : A₀) =
        algebraMap A₀ (Localization.AtPrime 𝔭) b := hbt0
    obtain ⟨us, hus⟩ := IsLocalization.map_units (Localization.AtPrime 𝔭) s
    obtain ⟨ut, hut⟩ := IsLocalization.map_units (Localization.AtPrime 𝔭) t
    have hιa : algebraMap A₀ (Localization.AtPrime 𝔭) a ≠ 0 := by
      rw [← has, ← hus]; exact mul_ne_zero ha'0 us.ne_zero
    have hιb : algebraMap A₀ (Localization.AtPrime 𝔭) b ≠ 0 := by
      rw [← hbt, ← hut]; exact mul_ne_zero hb'0 ut.ne_zero
    have haP : a ∈ 𝔭 := by
      rw [← IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔭) 𝔭 a, ← has]
      exact Ideal.mul_mem_right _ _ ha'm
    have hbP : b ∈ 𝔭 := by
      rw [← IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔭) 𝔭 b, ← hbt]
      exact Ideal.mul_mem_right _ _ hb'm
    have hH : ∀ y z : Localization.AtPrime 𝔭, algebraMap A₀ (Localization.AtPrime 𝔭) b * y =
        algebraMap A₀ (Localization.AtPrime 𝔭) a * z →
        ∃ w, y = algebraMap A₀ (Localization.AtPrime 𝔭) a * w := by
      intro y z h
      have h' : b' * ((ut : Localization.AtPrime 𝔭) * y) = a' * ((us : Localization.AtPrime 𝔭) * z) := by
        rw [hut, hus, ← mul_assoc, hbt, h, ← has, mul_assoc]
      obtain ⟨w, hw⟩ := hH' _ _ h'
      refine ⟨((us⁻¹ : (Localization.AtPrime 𝔭)ˣ) : Localization.AtPrime 𝔭) *
        ((ut⁻¹ : (Localization.AtPrime 𝔭)ˣ) : Localization.AtPrime 𝔭) * w, ?_⟩
      have e1 : y = ((ut⁻¹ : (Localization.AtPrime 𝔭)ˣ) : Localization.AtPrime 𝔭) *
          ((ut : Localization.AtPrime 𝔭) * y) := by
        rw [← mul_assoc, Units.inv_mul, one_mul]
      have e2 : a' = algebraMap A₀ (Localization.AtPrime 𝔭) a *
          ((us⁻¹ : (Localization.AtPrime 𝔭)ˣ) : Localization.AtPrime 𝔭) := by
        rw [← has, ← hus, mul_assoc, Units.mul_inv, mul_one]
      rw [e1, hw, e2]; ring
    have hreg : ∀ y : Localization.AtPrime 𝔭,
        algebraMap A₀ (Localization.AtPrime 𝔭) a * y = 0 → y = 0 :=
      fun y h => (mul_eq_zero.mp h).resolve_left hιa
    have hA : wcPlpRegA 𝔭 a b := by
      unfold wcPlpRegA
      exact ⟨haP, hbP, hreg, hH⟩
    have hHP : wcCg2HP (Localization.AtPrime 𝔭) (Localization.AtPrime 𝔭)
        (algebraMap A₀ (Localization.AtPrime 𝔭) a) (algebraMap A₀ (Localization.AtPrime 𝔭) b) := by
      unfold wcCg2HP
      exact ⟨IsSMulRegular.of_ne_zero hιa, IsSMulRegular.of_ne_zero hιb, fun m n h => hH m n h⟩
    exact ⟨a, b, fun h => hιa (by rw [h, map_zero]), hA, hHP⟩
  obtain ⟨a, b, ha0, hA, hHP⟩ := @key (f x).asIdeal (f x).isPrime hx2
  refine ⟨a, b, hA, ?_⟩
  haveI : (f x).asIdeal.IsPrime := (f x).isPrime

  have hψ : (wcPlpChartMap f hU).Smooth := by
    have h : Smooth (Spec.map (Spec.preimage (hU.fromSpec ≫ f))) := by
      rw [Spec.map_preimage]; infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Smooth)] at h
    exact h
  have hcomap : (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.comap (wcPlpChartMap f hU) = (f x).asIdeal := by
    let q : Spec Γ(X, U) := hU.primeIdealOf ⟨x, hxU⟩
    have h1 : hU.fromSpec q = x := hU.fromSpec_primeIdealOf ⟨x, hxU⟩
    have h2 : (hU.fromSpec ≫ f) q = f x := by
      rw [Scheme.Hom.comp_apply, h1]
    have h3 : (Spec.map (Spec.preimage (hU.fromSpec ≫ f))) q = f x := by
      rw [Spec.map_preimage]; exact h2
    rw [← h3]
    rfl

  letI : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hxU).hom.toAlgebra
  haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x) (hU.primeIdealOf ⟨x, hxU⟩).asIdeal :=
    hU.isLocalization_stalk ⟨x, hxU⟩
  obtain ⟨hd, hic⟩ := hnorm x
  let e := IsLocalization.algEquiv (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl
    (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal) (X.presheaf.stalk x)
  haveI hOd : IsDomain (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal) :=
    MulEquiv.isDomain _ e.toMulEquiv
  haveI hOic : IsIntegrallyClosed (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal) :=
    IsIntegrallyClosed.of_equiv e.symm.toRingEquiv

  let φl : Localization.AtPrime (f x).asIdeal →+*
      Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal :=
    Localization.localRingHom (f x).asIdeal (hU.primeIdealOf ⟨x, hxU⟩).asIdeal
      (wcPlpChartMap f hU) hcomap.symm
  have hφlflat : φl.Flat := RingHom.Flat.localRingHom hψ.flat _ _ hcomap.symm
  letI : Algebra (Localization.AtPrime (f x).asIdeal)
      (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal) := φl.toAlgebra
  haveI : Module.Flat (Localization.AtPrime (f x).asIdeal)
      (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal) := hφlflat
  have hHPO := (wc_cg2_hartogs_props (Localization.AtPrime (f x).asIdeal) _ _).2.2 hHP
    (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal)
  have hφ : ∀ r : A₀, φl (algebraMap A₀ (Localization.AtPrime (f x).asIdeal) r) =
      algebraMap Γ(X, U) (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal)
        (wcPlpChartMap f hU r) :=
    fun r => Localization.localRingHom_to_map _ _ _ _ r
  have hsmul : ∀ (r : A₀) (k : ℕ) (y : Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal),
      (algebraMap A₀ (Localization.AtPrime (f x).asIdeal) r) ^ k • y =
        (algebraMap Γ(X, U) (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal)
          (wcPlpChartMap f hU r)) ^ k * y := by
    intro r k y
    rw [Algebra.smul_def, map_pow]
    exact congrArg (fun t => t ^ k * y) (hφ r)
  have hne : algebraMap Γ(X, U) (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal)
      (wcPlpChartMap f hU a) ≠ 0 := by
    intro h0
    have h1 : (algebraMap A₀ (Localization.AtPrime (f x).asIdeal) a) •
        (1 : Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal) =
        (algebraMap A₀ (Localization.AtPrime (f x).asIdeal) a) •
        (0 : Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal) := by
      rw [smul_zero, ← pow_one (algebraMap A₀ (Localization.AtPrime (f x).asIdeal) a), hsmul,
        pow_one, h0, zero_mul]
    exact one_ne_zero (hHPO.1 h1)
  have hkH : ∀ (k : ℕ) (y z : Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal),
      algebraMap Γ(X, U) (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal)
          (wcPlpChartMap f hU b) ^ k * y =
        algebraMap Γ(X, U) (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal)
          (wcPlpChartMap f hU a) ^ k * z →
      ∃ w, y = algebraMap Γ(X, U) (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal)
          (wcPlpChartMap f hU a) ^ k * w := by
    intro k y z h
    obtain ⟨m, hm, -⟩ := (wc_cg2_hartogs_props (Localization.AtPrime (f x).asIdeal) _ _).1
      (Localization.AtPrime (hU.primeIdealOf ⟨x, hxU⟩).asIdeal) hHPO k k y z
      (by rw [hsmul, hsmul]; exact h)
    exact ⟨m, by rw [hm, hsmul]⟩

  obtain ⟨j, hjinj, hjcomp, hjint⟩ := wc_pdp_normalization_chart
    (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) U hU
  obtain ⟨hgflat, hunit⟩ := wc_pdp_generic_units_flat A₀ X f P p hPf hPe U hU
  refine wc_pdp_regC_abstract _ _ _ _ (wcPlpChartMap f hU) _ j _ a b hjinj ?_ ?_ ?_ hOd hOic hne hkH
  · rw [hjcomp]; exact hjint
  · rw [hjcomp]; exact hgflat
  · have h := hunit a ha0
    rw [← hjcomp] at h
    exact h

theorem wc_plp_transcendence_reduction : wcPlpClosedPurity.{u} → wcPlpGeneralPurity.{u} :=
by

  have s1 : ∀ (A R : Type u) [CommRing A] [CommRing R] (ψ : A →+* R), ψ.FiniteType → ∀ (𝔭 : Ideal A) (𝔮 : Ideal R) [𝔮.IsPrime], 𝔮.comap ψ = 𝔭 → ∃ (n : ℕ) (g : Fin n → R), (∀ h : MvPolynomial (Fin n) A, MvPolynomial.eval₂ ψ g h ∈ 𝔮 ↔ h ∈ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭) ∧ ∀ J : Ideal R, 𝔮 ≤ J → (∀ h : MvPolynomial (Fin n) A, MvPolynomial.eval₂ ψ g h ∈ J → h ∈ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭) → J = 𝔮 := by
    intro A R _ _ ψ hft 𝔭 𝔮 _ h𝔮
    subst h𝔮
    set 𝔭 := 𝔮.comap ψ with h𝔭
    let θ : A ⧸ 𝔭 →+* R ⧸ 𝔮 := Ideal.quotientMap 𝔮 ψ le_rfl
    have hθinj : Function.Injective θ := Ideal.quotientMap_injective' le_rfl
    have hθmk : ∀ a : A, θ (Ideal.Quotient.mk 𝔭 a) = Ideal.Quotient.mk 𝔮 (ψ a) := fun a =>
      Ideal.quotientMap_mk
    letI : Algebra (A ⧸ 𝔭) (R ⧸ 𝔮) := θ.toAlgebra
    have hθalg : algebraMap (A ⧸ 𝔭) (R ⧸ 𝔮) = θ := rfl
    haveI : FaithfulSMul (A ⧸ 𝔭) (R ⧸ 𝔮) :=
      (faithfulSMul_iff_algebraMap_injective (A ⧸ 𝔭) (R ⧸ 𝔮)).mpr hθinj
    have hFT : Algebra.FiniteType (A ⧸ 𝔭) (R ⧸ 𝔮) := by
      letI := ψ.toAlgebra
      haveI : Algebra.FiniteType A R := hft
      haveI : Algebra.FiniteType A (R ⧸ 𝔮) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ A 𝔮) (Ideal.Quotient.mkₐ_surjective A 𝔮)
      haveI : IsScalarTower A (A ⧸ 𝔭) (R ⧸ 𝔮) := IsScalarTower.of_algebraMap_eq fun a => by
        rw [hθalg, Ideal.Quotient.algebraMap_eq, hθmk]
        rfl
      exact Algebra.FiniteType.of_restrictScalars_finiteType A (A ⧸ 𝔭) (R ⧸ 𝔮)
    obtain ⟨s, hs⟩ := hFT.out
    haveI : Algebra.IsAlgebraic (Algebra.adjoin (A ⧸ 𝔭) (s : Set (R ⧸ 𝔮))) (R ⧸ 𝔮) := by
      constructor
      intro x
      have hx : x ∈ Algebra.adjoin (A ⧸ 𝔭) (s : Set (R ⧸ 𝔮)) := by rw [hs]; trivial
      exact isAlgebraic_algebraMap (⟨x, hx⟩ : Algebra.adjoin (A ⧸ 𝔭) (s : Set (R ⧸ 𝔮)))
    obtain ⟨t, hts, hT⟩ := exists_isTranscendenceBasis_subset (R := A ⧸ 𝔭) (s : Set (R ⧸ 𝔮))
    haveI : Finite t := (s.finite_toSet.subset hts).to_subtype
    obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin t
    let gb : Fin n → R ⧸ 𝔮 := Subtype.val ∘ e.symm
    have hind : AlgebraicIndependent (A ⧸ 𝔭) gb := hT.1.comp e.symm e.symm.injective
    have hrange : Set.range gb = Set.range (Subtype.val : t → R ⧸ 𝔮) :=
      e.symm.surjective.range_comp _
    have halg : Algebra.IsAlgebraic (Algebra.adjoin (A ⧸ 𝔭) (Set.range gb)) (R ⧸ 𝔮) := by
      rw [hrange]; exact hT.isAlgebraic
    choose g hg using fun i => Ideal.Quotient.mk_surjective (I := 𝔮) (gb i)
    have hgcomp : (Ideal.Quotient.mk 𝔮) ∘ g = gb := funext hg
    have key : ∀ h : MvPolynomial (Fin n) A, Ideal.Quotient.mk 𝔮 (MvPolynomial.eval₂ ψ g h) =
        MvPolynomial.aeval gb (MvPolynomial.map (Ideal.Quotient.mk 𝔭) h) := by
      intro h
      rw [MvPolynomial.eval₂_comp_left, hgcomp, MvPolynomial.aeval_def, MvPolynomial.eval₂_map]
      congr 1
    have hinj := (algebraicIndependent_iff_injective_aeval).mp hind
    have hI : ∀ h : MvPolynomial (Fin n) A, MvPolynomial.eval₂ ψ g h ∈ 𝔮 ↔
        h ∈ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭 := by
      intro h
      rw [← Ideal.Quotient.eq_zero_iff_mem, key, map_eq_zero_iff _ hinj]
      rw [← RingHom.mem_ker, MvPolynomial.ker_map, Ideal.mk_ker]
    refine ⟨n, g, hI, ?_⟩
    intro J hJ hJh
    by_contra hne
    have hnle : ¬ J ≤ 𝔮 := fun h => hne (le_antisymm h hJ)
    obtain ⟨r, hrJ, hrq⟩ := Set.not_subset.mp hnle
    set x := Ideal.Quotient.mk 𝔮 r with hx
    have hx0 : x ≠ 0 := by
      rw [hx, Ne, Ideal.Quotient.eq_zero_iff_mem]; exact hrq
    have hxI : x ∈ J.map (Ideal.Quotient.mk 𝔮) := Ideal.mem_map_of_mem _ hrJ
    have hxalg : IsAlgebraic (Algebra.adjoin (A ⧸ 𝔭) (Set.range gb)) x :=
      Algebra.IsAlgebraic.isAlgebraic x
    have hund := Ideal.under_ne_bot_of_algebraic_mem hx0 hxI hxalg
    obtain ⟨sv, hsv, hsv0⟩ := (Submodule.ne_bot_iff _).mp hund
    have hsvI : (sv : R ⧸ 𝔮) ∈ J.map (Ideal.Quotient.mk 𝔮) := hsv
    have hsvmem : (sv : R ⧸ 𝔮) ∈ (MvPolynomial.aeval (R := A ⧸ 𝔭) gb).range := by
      rw [← Algebra.adjoin_range_eq_range_aeval (A ⧸ 𝔭) gb]; exact sv.2
    obtain ⟨hb, hhb⟩ := hsvmem
    obtain ⟨h, rfl⟩ := MvPolynomial.map_surjective (Ideal.Quotient.mk 𝔭) Ideal.Quotient.mk_surjective hb
    have hhb' : MvPolynomial.aeval (R := A ⧸ 𝔭) gb (MvPolynomial.map (Ideal.Quotient.mk 𝔭) h) =
        (sv : R ⧸ 𝔮) := hhb
    have hevJ : MvPolynomial.eval₂ ψ g h ∈ J := by
      rw [← Ideal.mem_quotient_iff_mem hJ, key, hhb']
      exact hsvI
    have hev𝔮 := (hI h).mpr (hJh h hevJ)
    apply hsv0
    apply Subtype.ext
    rw [← Ideal.Quotient.eq_zero_iff_mem, key, hhb'] at hev𝔮
    simpa using hev𝔮

  have s2 : ∀ (A R : Type u) [CommRing A] [CommRing R] (ψ : A →+* R) (𝔭 : Ideal A) (𝔮 : Ideal R) (n : ℕ) (g : Fin n → R), (∀ h : MvPolynomial (Fin n) A, MvPolynomial.eval₂ ψ g h ∈ 𝔮 ↔ h ∈ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭) → (∀ J : Ideal R, 𝔮 ≤ J → (∀ h : MvPolynomial (Fin n) A, MvPolynomial.eval₂ ψ g h ∈ J → h ∈ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭) → J = 𝔮) → (𝔮.comap (MvPolynomial.eval₂Hom (RingHom.id R) g)).comap (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) = 𝔮 ∧ (𝔮.comap (MvPolynomial.eval₂Hom (RingHom.id R) g)).comap (MvPolynomial.map ψ) = Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭 ∧ ∀ Q : Ideal (MvPolynomial (Fin n) R), 𝔮.comap (MvPolynomial.eval₂Hom (RingHom.id R) g) ≤ Q → Q.comap (MvPolynomial.map ψ) = Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭 → Q = 𝔮.comap (MvPolynomial.eval₂Hom (RingHom.id R) g) := by
    intro A R _ _ ψ 𝔭 𝔮 n g hI hII
    set ε := MvPolynomial.eval₂Hom (RingHom.id R) g with hε
    have hεC : ε.comp (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) = RingHom.id R :=
      RingHom.ext fun r => MvPolynomial.eval₂Hom_C _ _ r
    have hsurj : Function.Surjective ε := fun r => ⟨MvPolynomial.C r, MvPolynomial.eval₂Hom_C _ _ r⟩
    have hεψ : ∀ h : MvPolynomial (Fin n) A, ε (MvPolynomial.map ψ h) = MvPolynomial.eval₂ ψ g h := by
      intro h
      rw [hε, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_map, RingHom.id_comp]
    refine ⟨?_, ?_, ?_⟩
    · rw [Ideal.comap_comap, hεC, Ideal.comap_id]
    · ext h
      rw [Ideal.mem_comap, Ideal.mem_comap, hεψ, hI]
    · intro Q hle hQ
      have hker : Ideal.comap ε ⊥ ≤ Q := le_trans (Ideal.comap_mono bot_le) hle
      have hcm : Ideal.comap ε (Ideal.map ε Q) = Q := by
        rw [Ideal.comap_map_of_surjective ε hsurj, sup_eq_left.mpr hker]
      have hJ : 𝔮 ≤ Ideal.map ε Q := by
        calc 𝔮 = Ideal.map ε (Ideal.comap ε 𝔮) := (Ideal.map_comap_of_surjective ε hsurj 𝔮).symm
          _ ≤ Ideal.map ε Q := Ideal.map_mono hle
      have heq := hII (Ideal.map ε Q) hJ (by
        intro h hh
        rw [← hQ, Ideal.mem_comap, ← hcm, Ideal.mem_comap, hεψ]
        exact hh)
      rw [← hcm, heq]

  have s3 : ∀ (A R : Type u) [CommRing A] [CommRing R] (ψ : A →+* R) (𝔭 : Ideal A) (𝔮 : Ideal R) [𝔮.IsPrime] (n : ℕ) (𝔮' : Ideal (MvPolynomial (Fin n) R)), 𝔮.comap ψ = 𝔭 → 𝔮'.comap (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) = 𝔮 → 𝔮'.comap (MvPolynomial.map ψ) = Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭 → (∀ Q' : Ideal (MvPolynomial (Fin n) R), Q' ≤ 𝔮' → Q'.comap (MvPolynomial.map ψ) ≠ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭 → Q'.comap (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) ≠ 𝔮) ∧ ((∃ Q₀ : Ideal R, Q₀.IsPrime ∧ Q₀ ≤ 𝔮 ∧ Q₀ ≠ 𝔮 ∧ Q₀.comap ψ = 𝔭) → ∀ Q' : Ideal (MvPolynomial (Fin n) R), Q'.IsPrime → Q' ≤ 𝔮' → Q'.comap (MvPolynomial.map ψ) = Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭 → (∀ Q'' : Ideal (MvPolynomial (Fin n) R), Q''.IsPrime → Q'' ≤ Q' → Q''.comap (MvPolynomial.map ψ) = Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭 → Q'' = Q') → Q'.comap (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) ≠ 𝔮) := by
    intro A R _ _ ψ 𝔭 𝔮 _ n 𝔮' h𝔮 h𝔮C h𝔮ψ
    have star : ∀ Q'' : Ideal (MvPolynomial (Fin n) R),
        (Q''.comap (MvPolynomial.C : R →+* MvPolynomial (Fin n) R)).comap ψ = 𝔭 →
        Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭 ≤ Q''.comap (MvPolynomial.map ψ) := by
      intro Q'' hQ''
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [← hQ''] at hx
      rw [Ideal.mem_comap, Ideal.mem_comap, MvPolynomial.map_C]
      exact hx
    have upper : ∀ Q'' : Ideal (MvPolynomial (Fin n) R), Q'' ≤ 𝔮' →
        Q''.comap (MvPolynomial.map ψ) ≤ Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭 := by
      intro Q'' hle
      rw [← h𝔮ψ]
      exact Ideal.comap_mono hle
    refine ⟨?_, ?_⟩
    · intro Q' hle hne hC
      apply hne
      refine le_antisymm (upper Q' hle) (star Q' ?_)
      rw [hC, h𝔮]
    · rintro ⟨Q₀, hQ₀, hQ₀le, hQ₀ne, hQ₀ψ⟩ Q' hQ' hle hlies hmin hC
      haveI := hQ₀
      haveI := hQ'
      haveI : Q'.LiesOver 𝔮 := ⟨by
        rw [Ideal.under, MvPolynomial.algebraMap_eq]
        exact hC.symm⟩
      obtain ⟨P, hPle, hP, hPl⟩ := Ideal.exists_ideal_le_liesOver_of_le (R := R)
        (S := MvPolynomial (Fin n) R) (p := Q₀) (q := 𝔮) Q' hQ₀le
      have hPQ₀ : P.comap (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) = Q₀ := by
        have := hPl.over
        rw [Ideal.under, MvPolynomial.algebraMap_eq] at this
        exact this.symm
      have hPlies : P.comap (MvPolynomial.map ψ) = Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) 𝔭 :=
        le_antisymm (upper P (le_trans hPle hle)) (star P (by rw [hPQ₀, hQ₀ψ]))
      have hPeq := hmin P hP hPle hPlies
      apply hQ₀ne
      rw [← hPQ₀, hPeq, hC]

  have s4 : ∀ {R C : Type u} [CommRing R] [CommRing C] (φ : R →+* C) (n : ℕ), CategoryTheory.IsPushout (CommRingCat.ofHom φ) (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin n) R)) (CommRingCat.ofHom (MvPolynomial.C : C →+* MvPolynomial (Fin n) C)) (CommRingCat.ofHom (MvPolynomial.map φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C)) ∧ (φ.Smooth → (MvPolynomial.map φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C).Smooth) ∧ (φ.Finite → (MvPolynomial.map φ : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C).Finite) := by
    intro R C _ _ φ n
    letI := φ.toAlgebra
    letI : Algebra (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) C) := MvPolynomial.algebraMvPolynomial
    have hmap : algebraMap (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) C) = MvPolynomial.map φ :=
      MvPolynomial.algebraMap_def
    refine ⟨?_, ?_, ?_⟩
    · have h := CommRingCat.isPushout_of_isPushout R C (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) C)
      rw [MvPolynomial.algebraMap_eq, MvPolynomial.algebraMap_eq, hmap] at h
      exact h
    · intro hs
      have := RingHom.Smooth.isStableUnderBaseChange R C (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) C) hs
      rw [hmap] at this
      exact this
    · intro hf
      have := RingHom.finite_isStableUnderBaseChange R C (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) C) hf
      rw [hmap] at this
      exact this

  have s5 : ∀ {R C R' C' : Type u} [CommRing R] [CommRing C] [CommRing R'] [CommRing C'] (φ : R →+* C) (ρ : R →+* R') (χ : C →+* C') (φ' : R' →+* C'), CategoryTheory.IsPushout (CommRingCat.ofHom φ) (CommRingCat.ofHom ρ) (CommRingCat.ofHom χ) (CommRingCat.ofHom φ') → ∀ (Q' : Ideal R') [Q'.IsPrime], wcCg2LocEtale φ (Q'.comap ρ).primeCompl → wcCg2LocEtale φ' Q'.primeCompl := by
    intro R C R' C' _ _ _ _ φ ρ χ φ' hP Q' _ hE
    have h1 : (Q'.comap ρ).primeCompl ≤ Q'.primeCompl.comap ρ := fun s hs => hs
    have hw : χ.comp φ = φ'.comp ρ := congrArg CommRingCat.Hom.hom hP.w
    have h2 : (Q'.comap ρ).primeCompl.map φ ≤ (Q'.primeCompl.map φ').comap χ := by
      rintro _ ⟨s, hs, rfl⟩
      refine ⟨ρ s, h1 hs, ?_⟩
      show φ' (ρ s) = χ (φ s)
      rw [← RingHom.comp_apply φ' ρ, ← hw, RingHom.comp_apply]
    set M := (Q'.comap ρ).primeCompl with hM
    set M' := Q'.primeCompl with hM'
    set φQ : Localization M →+* Localization (M.map φ) :=
      IsLocalization.map (Localization (M.map φ)) φ M.le_comap_map with hφQ
    set φQ' : Localization M' →+* Localization (M'.map φ') :=
      IsLocalization.map (Localization (M'.map φ')) φ' M'.le_comap_map with hφQ'
    set ρQ : Localization M →+* Localization M' := IsLocalization.map (Localization M') ρ h1 with hρQ
    set χQ : Localization (M.map φ) →+* Localization (M'.map φ') :=
      IsLocalization.map (Localization (M'.map φ')) χ h2 with hχQ
    have T := CommRingCat.isPushout_of_isLocalization φ φQ (IsLocalization.map_comp _) M
    have L := CommRingCat.isPushout_of_isLocalization φ' φQ' (IsLocalization.map_comp _) M'
    have big := hP.paste_vert L
    have e1 : CommRingCat.ofHom ρ ≫ CommRingCat.ofHom (algebraMap R' (Localization M')) =
        CommRingCat.ofHom (algebraMap R (Localization M)) ≫ CommRingCat.ofHom ρQ := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hρQ, IsLocalization.map_comp]
    have e2 : CommRingCat.ofHom χ ≫ CommRingCat.ofHom (algebraMap C' (Localization (M'.map φ'))) =
        CommRingCat.ofHom (algebraMap C (Localization (M.map φ))) ≫ CommRingCat.ofHom χQ := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hχQ, IsLocalization.map_comp]
    rw [e1, e2] at big
    have hB : CommRingCat.ofHom φQ ≫ CommRingCat.ofHom χQ = CommRingCat.ofHom ρQ ≫ CommRingCat.ofHom φQ' := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply IsLocalization.ringHom_ext M
      ext r
      simp only [RingHom.comp_apply, hφQ, hχQ, hρQ, hφQ', IsLocalization.map_eq]
      rw [← RingHom.comp_apply χ φ, hw, RingHom.comp_apply]
    have B := IsPushout.of_top big hB T
    have Bf := B.flip
    have h3 := RingHom.IsStableUnderBaseChange.pushout_inl RingHom.Etale.isStableUnderBaseChange
      RingHom.Etale.respectsIso (CommRingCat.ofHom ρQ) (CommRingCat.ofHom φQ) hE
    have h4 := Bf.inl_isoPushout_inv
    have h5 := (RingHom.Etale.respectsIso.cancel_right_isIso _ Bf.isoPushout.inv).mpr h3
    rw [← CommRingCat.hom_comp, h4] at h5
    exact h5

  have s6 : ∀ {P P' : Type u} [CommRing P] [CommRing P'] (θ : P →+* P'), θ.Flat → ∀ α β : P, (∀ y : P, α * y = 0 → y = 0) → (∀ y z : P, β * y = α * z → ∃ w, y = α * w) → (∀ y : P', θ α * y = 0 → y = 0) ∧ (∀ y z : P', θ β * y = θ α * z → ∃ w, y = θ α * w) := by
    intro P P' _ _ θ hθ α β h1 h2
    letI := θ.toAlgebra
    haveI : Module.Flat P P' := hθ
    have hsm : ∀ (p : P) (m : P'), p • m = θ p * m := fun p m => rfl
    refine ⟨?_, ?_⟩
    · intro y hy
      let f : Fin 1 → P := fun _ => α
      let x : Fin 1 → P' := fun _ => y
      have hs : ∑ i, f i • x i = 0 := by
        rw [Fin.sum_univ_one]
        show α • y = 0
        rw [hsm]; exact hy
      have htr : Module.IsTrivialRelation f x :=
        Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := P) (M := P') hs
      obtain ⟨k, a, y', hx, ha⟩ := htr
      have h0 : y = ∑ j, a 0 j • y' j := hx 0
      rw [h0]
      refine Finset.sum_eq_zero fun j _ => ?_
      have h3 : ∑ i, f i * a i j = 0 := ha j
      rw [Fin.sum_univ_one] at h3
      rw [h1 _ h3, zero_smul]
    · intro y z hyz
      let f : Fin 2 → P := ![β, -α]
      let x : Fin 2 → P' := ![y, z]
      have hs : ∑ i, f i • x i = 0 := by
        rw [Fin.sum_univ_two]
        show β • y + (-α) • z = 0
        rw [hsm, hsm, map_neg, neg_mul, hyz, add_neg_cancel]
      have htr : Module.IsTrivialRelation f x :=
        Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := P) (M := P') hs
      obtain ⟨k, a, y', hx, ha⟩ := htr
      have hw : ∀ j, ∃ w, a 0 j = α * w := by
        intro j
        have h3 : ∑ i, f i * a i j = 0 := ha j
        rw [Fin.sum_univ_two] at h3
        have h4 : β * a 0 j + -α * a 1 j = 0 := h3
        exact h2 _ (a 1 j) (by linear_combination h4)
      choose w hw using hw
      refine ⟨∑ j, θ (w j) * y' j, ?_⟩
      have h0 : y = ∑ j, a 0 j • y' j := hx 0
      rw [h0, Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [hw j, hsm, map_mul, mul_assoc]

  have s7 : ∀ {C C' : Type u} [CommRing C] [CommRing C'] (χ : C →+* C'), χ.Flat → ∀ (S : Submonoid C) (S' : Submonoid C') (h : S ≤ S'.comap χ), (IsLocalization.map (Localization S') χ h : Localization S →+* Localization S').Flat := by
    intro C C' _ _ χ hχ S S' h
    letI := χ.toAlgebra
    haveI : Module.Flat C C' := hχ
    letI : Algebra (Localization S) (Localization S') :=
      (IsLocalization.map (Localization S') χ h : Localization S →+* Localization S').toAlgebra
    haveI : Module.Flat C (Localization S') := Localization.flat C' S'
    haveI : IsScalarTower C (Localization S) (Localization S') := by
      apply IsScalarTower.of_algebraMap_eq
      intro x
      rw [RingHom.algebraMap_toAlgebra, IsLocalization.map_eq]
      rfl
    haveI : IsLocalizedModule S (LinearMap.id : Localization S' →ₗ[C] Localization S') :=
      isLocalizedModule_id S (Localization S') (Localization S)
    exact Module.Flat.of_isLocalizedModule (Localization S) S
      (LinearMap.id : Localization S' →ₗ[C] Localization S')

  have s8 : ∀ (R S R' : Type u) [CommRing R] [CommRing S] [CommRing R'] [Algebra R S]
      [Algebra R R'] [IsNoetherianRing R] [Module.Finite R S] [Module.Flat R R']
      (𝔫 : Ideal R) [𝔫.IsPrime] (𝔫' : Ideal R') [𝔫'.IsPrime]
      (h𝔫 : 𝔫'.comap (algebraMap R R') = 𝔫)
      (hE : Algebra.Etale R' (TensorProduct R R' S)),
      wcCg2LocEtale (algebraMap R S) 𝔫.primeCompl := by
    intro R S R' _ _ _ _ _ _ _ _ 𝔫 _ 𝔫' _ h𝔫 hE
    unfold wcCg2LocEtale
    change (algebraMap (Localization.AtPrime 𝔫)
      (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl))).Etale
    let φ : Localization.AtPrime 𝔫 →+* Localization.AtPrime 𝔫' :=
      Localization.localRingHom 𝔫 𝔫' (algebraMap R R') h𝔫.symm
    letI : Algebra (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫') := φ.toAlgebra
    haveI : IsScalarTower R (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫') :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        rw [RingHom.algebraMap_toAlgebra]
        show _ = Localization.localRingHom 𝔫 𝔫' (algebraMap R R') h𝔫.symm (algebraMap R _ x)
        rw [Localization.localRingHom_to_map,
          IsScalarTower.algebraMap_apply R R' (Localization.AtPrime 𝔫') x])
    have hφflat : φ.Flat :=
      RingHom.Flat.localRingHom (RingHom.flat_algebraMap_iff.mpr inferInstance) 𝔫' 𝔫 h𝔫.symm
    haveI : Module.Flat (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫') := hφflat
    haveI : IsLocalHom (algebraMap (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')) :=
      Localization.isLocalHom_localRingHom 𝔫 𝔫' (algebraMap R R') h𝔫.symm
    haveI : Module.FaithfullyFlat (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫') :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hFF : (algebraMap (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')).FaithfullyFlat :=
      RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance
    haveI : Algebra.IsPushout R (Localization.AtPrime 𝔫) S
        (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl)) :=
      (Algebra.isPushout_of_isLocalization 𝔫.primeCompl (Localization.AtPrime 𝔫) S
        (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl))).symm
    haveI : Algebra.Etale (Localization.AtPrime 𝔫')
        (TensorProduct R' (Localization.AtPrime 𝔫') (TensorProduct R R' S)) :=
      Algebra.Etale.baseChange R' (TensorProduct R R' S) (Localization.AtPrime 𝔫')
    let e : TensorProduct R' (Localization.AtPrime 𝔫') (TensorProduct R R' S) ≃ₐ[Localization.AtPrime 𝔫']
        TensorProduct (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')
          (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl)) :=
      (Algebra.TensorProduct.cancelBaseChange R R' (Localization.AtPrime 𝔫')
        (Localization.AtPrime 𝔫') S).trans
        ((Algebra.TensorProduct.cancelBaseChange R (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')
          (Localization.AtPrime 𝔫') S).symm.trans
          (Algebra.TensorProduct.congr (AlgEquiv.refl : Localization.AtPrime 𝔫' ≃ₐ[Localization.AtPrime 𝔫']
            Localization.AtPrime 𝔫')
            (Algebra.IsPushout.equiv R (Localization.AtPrime 𝔫) S
              (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl)))))
    haveI hEtA : Algebra.Etale (Localization.AtPrime 𝔫')
        (TensorProduct (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')
          (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl))) :=
      Algebra.Etale.of_equiv e
    have hEt : (algebraMap (Localization.AtPrime 𝔫')
        (TensorProduct (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')
          (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl)))).Etale :=
      RingHom.etale_algebraMap.mpr hEtA
    exact RingHom.CodescendsAlong.algebraMap_tensorProduct RingHom.FaithfullyFlat
      (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')
      (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl))
      RingHom.Etale.codescendsAlong_faithfullyFlat hFF hEt

  have s9 : ∀ (R C : Type u) [CommRing R] [CommRing C] [Algebra R C] (n : ℕ) (𝔮' : Ideal (MvPolynomial (Fin n) R)) [𝔮'.IsPrime], wcCg2LocEtale (MvPolynomial.map (algebraMap R C) : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C) 𝔮'.primeCompl → Algebra.Etale (Localization.AtPrime 𝔮') (TensorProduct R (Localization.AtPrime 𝔮') C) := by
    intro R C _ _ _ n 𝔮' _ hE
    unfold wcCg2LocEtale at hE
    have sq1 := (s4 (algebraMap R C) n).1
    have sq2 := CommRingCat.isPushout_of_isLocalization
      (MvPolynomial.map (algebraMap R C) : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C)
      (IsLocalization.map (Localization (𝔮'.primeCompl.map (MvPolynomial.map (algebraMap R C) : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C))) (MvPolynomial.map (algebraMap R C) : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C) 𝔮'.primeCompl.le_comap_map : Localization 𝔮'.primeCompl →+* Localization (𝔮'.primeCompl.map (MvPolynomial.map (algebraMap R C) : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C)))
      (IsLocalization.map_comp _) 𝔮'.primeCompl
    have hp := sq1.paste_vert sq2
    have e1 : CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) ≫
        CommRingCat.ofHom (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime 𝔮')) =
        CommRingCat.ofHom (algebraMap R (Localization.AtPrime 𝔮')) := by
      rw [← CommRingCat.ofHom_comp, ← MvPolynomial.algebraMap_eq,
        ← IsScalarTower.algebraMap_eq]
    rw [e1] at hp
    have ht := (CommRingCat.isPushout_tensorProduct R (Localization.AtPrime 𝔮') C).flip
    have he := hp.inr_isoIsPushout_hom _ _ ht
    have hEt := (RingHom.Etale.respectsIso.cancel_right_isIso
      (CommRingCat.ofHom (IsLocalization.map (Localization (𝔮'.primeCompl.map (MvPolynomial.map (algebraMap R C) : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C))) (MvPolynomial.map (algebraMap R C) : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C) 𝔮'.primeCompl.le_comap_map : Localization 𝔮'.primeCompl →+* Localization (𝔮'.primeCompl.map (MvPolynomial.map (algebraMap R C) : MvPolynomial (Fin n) R →+* MvPolynomial (Fin n) C))))
      (hp.isoIsPushout _ _ ht).hom).mpr hE
    rw [← CommRingCat.hom_comp, he] at hEt
    exact RingHom.etale_algebraMap.mp hEt

  intro hCP A R C _ _ _ _ ψ φ hψ hφ 𝔭 _ 𝔮 _ h𝔮 hdp P2 P3
  obtain ⟨a, b, hRA, hRC⟩ := hdp
  have hψft : ψ.FiniteType := RingHom.FiniteType.of_finitePresentation hψ.finitePresentation
  haveI : IsNoetherianRing R := by
    letI := ψ.toAlgebra
    haveI : Algebra.FiniteType A R := hψft
    exact Algebra.FiniteType.isNoetherianRing A R
  obtain ⟨n, g, hI, hII⟩ := s1 A R ψ hψft 𝔭 𝔮 h𝔮
  obtain ⟨h𝔮C, h𝔮ψ, hclosed⟩ := s2 A R ψ 𝔭 𝔮 n g hI hII
  have hprime : (𝔮.comap (MvPolynomial.eval₂Hom (RingHom.id R) g)).IsPrime :=
    Ideal.comap_isPrime _ _
  generalize 𝔮.comap (MvPolynomial.eval₂Hom (RingHom.id R) g) = 𝔮' at h𝔮C h𝔮ψ hclosed hprime
  haveI := hprime
  have s4ψ := s4 ψ n
  have s4φ := s4 φ n
  have hCflat : ∀ (X : Type u) [CommRing X], (MvPolynomial.C : X →+* MvPolynomial (Fin n) X).Flat := by
    intro X _
    rw [← MvPolynomial.algebraMap_eq]
    exact RingHom.flat_algebraMap_iff.mpr inferInstance
  have htrans : ∀ (Q' : Ideal (MvPolynomial (Fin n) R)) [Q'.IsPrime], Q' ≤ 𝔮' →
      Q'.comap (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) ≠ 𝔮 →
      wcCg2LocEtale (MvPolynomial.map φ) Q'.primeCompl := by
    intro Q' _ hle hne
    have hQle : Q'.comap (MvPolynomial.C : R →+* MvPolynomial (Fin n) R) ≤ 𝔮 :=
      h𝔮C ▸ Ideal.comap_mono hle
    exact s5 φ MvPolynomial.C MvPolynomial.C (MvPolynomial.map φ) s4φ.1 Q'
      (P2 _ hQle hne)
  have hT := s3 A R ψ 𝔭 𝔮 n 𝔮' h𝔮 h𝔮C h𝔮ψ
  have h𝔭 : 𝔭 = (𝔮'.comap (MvPolynomial.map ψ)).comap (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) := by
    rw [Ideal.comap_comap]
    have e : (MvPolynomial.map ψ).comp (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) =
        (MvPolynomial.C : R →+* MvPolynomial (Fin n) R).comp ψ :=
      RingHom.ext fun x => MvPolynomial.map_C ψ x
    rw [e, ← Ideal.comap_comap, h𝔮C, h𝔮]
  have hRegA : wcPlpRegA (𝔮'.comap (MvPolynomial.map ψ)) (MvPolynomial.C a) (MvPolynomial.C b) := by
    obtain ⟨ha, hb, hreg1, hreg2⟩ := hRA
    have h6 := s6
      (Localization.localRingHom 𝔭 (𝔮'.comap (MvPolynomial.map ψ)) MvPolynomial.C h𝔭)
      (RingHom.Flat.localRingHom (hCflat A) _ _ h𝔭) _ _ hreg1 hreg2
    rw [Localization.localRingHom_to_map, Localization.localRingHom_to_map] at h6
    refine ⟨?_, ?_, h6.1, h6.2⟩
    · rw [h𝔮ψ]; exact Ideal.mem_map_of_mem _ ha
    · rw [h𝔮ψ]; exact Ideal.mem_map_of_mem _ hb
  have hRegC : wcPlpRegC (MvPolynomial.map ψ) (MvPolynomial.map φ) 𝔮' (MvPolynomial.C a)
      (MvPolynomial.C b) := by
    obtain ⟨hreg1, hreg2⟩ := hRC
    have hS : 𝔮.primeCompl.map φ ≤ (𝔮'.primeCompl.map (MvPolynomial.map φ)).comap
        (MvPolynomial.C : C →+* MvPolynomial (Fin n) C) := by
      intro x hx
      obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hx
      refine Submonoid.mem_map.mpr ⟨MvPolynomial.C s, ?_, MvPolynomial.map_C φ s⟩
      intro hs'
      apply hs
      rw [← h𝔮C]
      exact hs'
    have h6 := s6 _ (s7 _ (hCflat C) _ _ hS) _ _ hreg1 hreg2
    rw [IsLocalization.map_eq, IsLocalization.map_eq] at h6
    have e1 : ∀ x : A, (MvPolynomial.map φ) ((MvPolynomial.map ψ) (MvPolynomial.C x)) =
        (MvPolynomial.C (φ (ψ x)) : MvPolynomial (Fin n) C) := by
      intro x
      rw [MvPolynomial.map_C, MvPolynomial.map_C]
    unfold wcPlpRegC
    rw [e1, e1]
    exact h6
  have hE' : wcCg2LocEtale (MvPolynomial.map φ) 𝔮'.primeCompl := by
    refine hCP (MvPolynomial (Fin n) A) (MvPolynomial (Fin n) R) (MvPolynomial (Fin n) C)
      (MvPolynomial.map ψ) (MvPolynomial.map φ) (s4ψ.2.1 hψ) (s4φ.2.2 hφ)
      (𝔮'.comap (MvPolynomial.map ψ)) 𝔮' rfl ?_ ⟨_, _, hRegA, hRegC⟩ ?_ ?_
    · intro Q _ hle hQc
      exact hclosed Q hle (hQc.trans h𝔮ψ)
    · intro Q' _ hle hne
      rw [h𝔮ψ] at hne
      exact htrans Q' hle (hT.1 Q' hle hne)
    · intro Q' _ hle hlies hmin
      rw [h𝔮ψ] at hlies hmin
      exact htrans Q' hle (hT.2 P3 Q' inferInstance hle hlies hmin)
  letI := φ.toAlgebra
  have hE2 := s9 R C n 𝔮' hE'
  haveI : Module.Finite R C := hφ
  haveI : Module.Flat R (Localization.AtPrime 𝔮') :=
    Module.Flat.trans R (MvPolynomial (Fin n) R) (Localization.AtPrime 𝔮')
  have hmax : (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮')).comap
      (algebraMap R (Localization.AtPrime 𝔮')) = 𝔮 := by
    rw [IsScalarTower.algebraMap_eq R (MvPolynomial (Fin n) R) (Localization.AtPrime 𝔮'),
      ← Ideal.comap_comap]
    have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮')).comap
        (algebraMap (MvPolynomial (Fin n) R) (Localization.AtPrime 𝔮')) = 𝔮' :=
      Localization.AtPrime.under_maximalIdeal
    rw [h1, MvPolynomial.algebraMap_eq, h𝔮C]
  exact s8 R C (Localization.AtPrime 𝔮') 𝔮
    (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮')) hmax hE2

theorem wc_fpc_residue_field_finite : ∀ (A R : Type u) [CommRing A] [CommRing R] (ψ : A →+* R), ψ.FiniteType → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (𝔮 : Ideal R) [𝔮.IsPrime] (hq : 𝔮.comap ψ = 𝔭), (∀ Q : Ideal R, Q.IsPrime → 𝔮 ≤ Q → Q.comap ψ = 𝔭 → Q = 𝔮) → (Ideal.ResidueField.map 𝔭 𝔮 ψ hq.symm).Finite :=
by
  intro A R _ _ ψ hψ 𝔭 _ 𝔮 _ hq hCl
  classical
  letI : Algebra 𝔭.ResidueField 𝔮.ResidueField :=
    (Ideal.ResidueField.map 𝔭 𝔮 ψ hq.symm).toAlgebra
  have hc : ∀ a : A, algebraMap 𝔭.ResidueField 𝔮.ResidueField (algebraMap A 𝔭.ResidueField a) =
      algebraMap R 𝔮.ResidueField (ψ a) := by
    intro a
    rw [RingHom.algebraMap_toAlgebra]
    exact Ideal.ResidueField.map_algebraMap 𝔭 𝔮 ψ hq.symm a
  have hp1 : (1 : A) ∉ 𝔭 := fun h => ‹𝔭.IsPrime›.ne_top ((Ideal.eq_top_iff_one _).mpr h)
  have hpmul : ∀ a b : A, a ∉ 𝔭 → b ∉ 𝔭 → a * b ∉ 𝔭 := fun a b ha hb h =>
    (‹𝔭.IsPrime›.mem_or_mem h).elim ha hb
  have hψa : ∀ a : A, a ∉ 𝔭 → algebraMap R 𝔮.ResidueField (ψ a) ≠ 0 := by
    intro a ha h
    rw [Ideal.algebraMap_residueField_eq_zero] at h
    apply ha
    rw [← hq]
    exact h
  obtain ⟨T, hT⟩ : ∃ T : Subalgebra 𝔭.ResidueField 𝔮.ResidueField,
      T = Algebra.adjoin 𝔭.ResidueField (Set.range (algebraMap R 𝔮.ResidueField)) := ⟨_, rfl⟩
  have hjT : ∀ r : R, algebraMap R 𝔮.ResidueField r ∈ T := by
    intro r
    rw [hT]
    exact Algebra.subset_adjoin (Set.mem_range_self r)

  have hFG : T.FG := by
    letI : Algebra A R := ψ.toAlgebra
    have hft : Algebra.FiniteType A R := hψ
    obtain ⟨s, hs⟩ := hft.out
    refine ⟨s.image (algebraMap R 𝔮.ResidueField), ?_⟩
    rw [hT]
    apply le_antisymm
    · apply Algebra.adjoin_mono
      intro x hx
      rw [Finset.coe_image] at hx
      obtain ⟨r, _, rfl⟩ := hx
      exact Set.mem_range_self r
    · apply Algebra.adjoin_le
      rintro _ ⟨r, rfl⟩
      have hr : r ∈ Algebra.adjoin A (s : Set R) := by rw [hs]; trivial
      induction hr using Algebra.adjoin_induction with
      | mem x hx =>
        apply Algebra.subset_adjoin
        rw [Finset.coe_image]
        exact Set.mem_image_of_mem _ hx
      | algebraMap a =>
        rw [RingHom.algebraMap_toAlgebra, ← hc]
        exact Subalgebra.algebraMap_mem _ _
      | add x y _ _ hx hy => rw [map_add]; exact Subalgebra.add_mem _ hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact Subalgebra.mul_mem _ hx hy

  have hden : ∀ t ∈ T, ∃ a : A, a ∉ 𝔭 ∧ ∃ r : R,
      algebraMap R 𝔮.ResidueField (ψ a) * t = algebraMap R 𝔮.ResidueField r := by
    intro t ht
    rw [hT] at ht
    induction ht using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨r, rfl⟩ := hx
      exact ⟨1, hp1, r, by rw [map_one, map_one, one_mul]⟩
    | algebraMap c =>
      obtain ⟨x', y', hy', rfl⟩ := IsFractionRing.div_surjective (A := A ⧸ 𝔭) c
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x'
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y'
      rw [Ideal.algebraMap_quotient_residueField_mk, Ideal.algebraMap_quotient_residueField_mk]
      have hy0 : y ∉ 𝔭 := by
        intro h
        exact nonZeroDivisors.ne_zero hy' ((Ideal.Quotient.eq_zero_iff_mem).mpr h)
      have hne : algebraMap A 𝔭.ResidueField y ≠ 0 := by
        rw [Ne, Ideal.algebraMap_residueField_eq_zero]
        exact hy0
      refine ⟨y, hy0, ψ x, ?_⟩
      have e : algebraMap A 𝔭.ResidueField y *
          (algebraMap A 𝔭.ResidueField x / algebraMap A 𝔭.ResidueField y) =
          algebraMap A 𝔭.ResidueField x := by
        field_simp
      rw [← hc, ← hc, ← map_mul, e]
    | add x y _ _ hx hy =>
      obtain ⟨a₁, ha₁, r₁, h₁⟩ := hx
      obtain ⟨a₂, ha₂, r₂, h₂⟩ := hy
      refine ⟨a₁ * a₂, hpmul _ _ ha₁ ha₂, ψ a₂ * r₁ + ψ a₁ * r₂, ?_⟩
      rw [map_mul, map_mul, map_add, map_mul, map_mul, ← h₁, ← h₂]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨a₁, ha₁, r₁, h₁⟩ := hx
      obtain ⟨a₂, ha₂, r₂, h₂⟩ := hy
      refine ⟨a₁ * a₂, hpmul _ _ ha₁ ha₂, r₁ * r₂, ?_⟩
      rw [map_mul, map_mul, map_mul, ← h₁, ← h₂]
      ring

  have hunit : ∀ z : T, z ≠ 0 → IsUnit z := by
    intro z hz
    by_contra hnu
    obtain ⟨M, hM, hzM⟩ := Ideal.exists_le_maximal (Ideal.span {z})
      (by rw [Ne, Ideal.span_singleton_eq_top]; exact hnu)
    have hzM' : z ∈ M := hzM (Ideal.mem_span_singleton_self z)
    haveI : M.IsPrime := hM.isPrime
    let ι : R →+* T := (algebraMap R 𝔮.ResidueField).codRestrict T hjT
    have hι : ∀ r : R, ((ι r : T) : 𝔮.ResidueField) = algebraMap R 𝔮.ResidueField r :=
      fun r => rfl
    let Q : Ideal R := M.comap ι
    haveI hQprime : Q.IsPrime := Ideal.IsPrime.comap ι
    have h𝔮Q : 𝔮 ≤ Q := by
      intro r hr
      show ι r ∈ M
      have h0 : ι r = 0 := by
        apply Subtype.ext
        rw [hι]
        exact (Ideal.algebraMap_residueField_eq_zero).mpr hr
      rw [h0]
      exact M.zero_mem
    have hQp : Q.comap ψ = 𝔭 := by
      ext a
      constructor
      · intro ha
        by_contra hap
        have hne : algebraMap A 𝔭.ResidueField a ≠ 0 := by
          rw [Ne, Ideal.algebraMap_residueField_eq_zero]
          exact hap
        have hu : IsUnit (algebraMap 𝔭.ResidueField T (algebraMap A 𝔭.ResidueField a)) :=
          (isUnit_iff_ne_zero.mpr hne).map _
        have heq : algebraMap 𝔭.ResidueField T (algebraMap A 𝔭.ResidueField a) = ι (ψ a) := by
          apply Subtype.ext
          rw [hι, ← hc]
          rfl
        rw [heq] at hu
        exact hM.ne_top (Ideal.eq_top_of_isUnit_mem M ha hu)
      · intro ha
        apply h𝔮Q
        rw [← hq] at ha
        exact ha
    have hQ : Q = 𝔮 := hCl Q hQprime h𝔮Q hQp
    obtain ⟨a, ha, r, hr⟩ := hden z z.2
    have hrT : ι (ψ a) * z = ι r := by
      apply Subtype.ext
      rw [Subalgebra.coe_mul, hι, hι]
      exact hr
    have hrM : ι r ∈ M := by
      rw [← hrT]
      exact M.mul_mem_left _ hzM'
    have hr𝔮 : r ∈ 𝔮 := by
      rw [← hQ]
      exact hrM
    rw [(Ideal.algebraMap_residueField_eq_zero).mpr hr𝔮] at hr
    rcases mul_eq_zero.mp hr with h | h
    · exact hψa a ha h
    · exact hz (Subtype.ext h)

  have htop : T = ⊤ := by
    rw [eq_top_iff]
    intro w _
    obtain ⟨x', y', hy', rfl⟩ := IsFractionRing.div_surjective (A := R ⧸ 𝔮) w
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x'
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y'
    rw [Ideal.algebraMap_quotient_residueField_mk, Ideal.algebraMap_quotient_residueField_mk]
    have hy0 : y ∉ 𝔮 := by
      intro h
      exact nonZeroDivisors.ne_zero hy' ((Ideal.Quotient.eq_zero_iff_mem).mpr h)
    have hne : algebraMap R 𝔮.ResidueField y ≠ 0 := by
      rw [Ne, Ideal.algebraMap_residueField_eq_zero]
      exact hy0
    have hneT : (⟨algebraMap R 𝔮.ResidueField y, hjT y⟩ : T) ≠ 0 := by
      intro h
      exact hne (congrArg Subtype.val h)
    obtain ⟨b, hb⟩ := (hunit _ hneT).exists_right_inv
    have hb' : algebraMap R 𝔮.ResidueField y * (b : 𝔮.ResidueField) = 1 := by
      have := congrArg Subtype.val hb
      rw [Subalgebra.coe_mul] at this
      exact this
    have hbinv : (b : 𝔮.ResidueField) = (algebraMap R 𝔮.ResidueField y)⁻¹ :=
      eq_inv_of_mul_eq_one_right hb'
    rw [div_eq_mul_inv, ← hbinv]
    exact T.mul_mem (hjT x) b.2

  rw [htop] at hFG
  haveI : Algebra.FiniteType 𝔭.ResidueField 𝔮.ResidueField := ⟨hFG⟩
  exact finite_of_finite_type_of_isJacobsonRing 𝔭.ResidueField 𝔮.ResidueField

theorem wc_fpc_finite_residue_tower : ∀ (A₀ : Type u) [CommRing A₀] [IsLocalRing A₀] [IsNoetherianRing A₀] (K : Type u) [Field K] (ρ₀ : A₀ →+* K), ρ₀.Finite → RingHom.ker ρ₀ = IsLocalRing.maximalIdeal A₀ → ∃ (A₁ : Type u) (_ : CommRing A₁) (_ : IsLocalRing A₁) (_ : IsNoetherianRing A₁) (_ : Algebra A₀ A₁) (ρ₁ : A₁ →+* K), Module.Flat A₀ A₁ ∧ Function.Surjective ρ₁ ∧ RingHom.ker ρ₁ = IsLocalRing.maximalIdeal A₁ ∧ ρ₁.comp (algebraMap A₀ A₁) = ρ₀ ∧ ∀ P : Ideal A₁, P.IsPrime → P.comap (algebraMap A₀ A₁) = IsLocalRing.maximalIdeal A₀ → P = IsLocalRing.maximalIdeal A₁ :=
by
  intro A₀ _ _ _ K _ ρ₀ hfin₀ hker₀
  classical

  have hloc : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (μ : Polynomial A), μ.Monic →
      Irreducible (μ.map (IsLocalRing.residue A)) →
      (Ideal.map (AdjoinRoot.of μ) (IsLocalRing.maximalIdeal A)).IsMaximal ∧
      (∀ M : Ideal (AdjoinRoot μ), M.IsMaximal →
        M = Ideal.map (AdjoinRoot.of μ) (IsLocalRing.maximalIdeal A)) ∧
      ∀ P : Ideal (AdjoinRoot μ), P.IsPrime → P.comap (AdjoinRoot.of μ) = IsLocalRing.maximalIdeal A →
        P = Ideal.map (AdjoinRoot.of μ) (IsLocalRing.maximalIdeal A) := by
    intro A _ _ μ hμ hirr
    have hNmax : (Ideal.map (AdjoinRoot.of μ) (IsLocalRing.maximalIdeal A)).IsMaximal := by
      let e := AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot (IsLocalRing.maximalIdeal A) μ
      have h0 : (Ideal.span {μ.map (IsLocalRing.residue A)} :
          Ideal (Polynomial (IsLocalRing.ResidueField A))).IsMaximal :=
        PrincipalIdealRing.isMaximal_of_irreducible hirr
      have h1 : (Ideal.span {μ.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A))}).IsMaximal :=
        h0
      have h2 := (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp h1
      exact Ideal.Quotient.maximal_of_isField _ (MulEquiv.isField h2 e.toMulEquiv)
    haveI : Module.Finite A (AdjoinRoot μ) := hμ.finite_adjoinRoot
    haveI : Algebra.IsIntegral A (AdjoinRoot μ) := Algebra.IsIntegral.of_finite A _
    refine ⟨hNmax, ?_, ?_⟩
    · intro M hM
      haveI := hM
      have hc : (M.comap (algebraMap A (AdjoinRoot μ))).IsMaximal := Ideal.IsMaximal.under A M
      have hc' : M.comap (AdjoinRoot.of μ) = IsLocalRing.maximalIdeal A := by
        rw [← AdjoinRoot.algebraMap_eq]; exact IsLocalRing.eq_maximalIdeal hc
      have hle : Ideal.map (AdjoinRoot.of μ) (IsLocalRing.maximalIdeal A) ≤ M :=
        Ideal.map_le_iff_le_comap.mpr hc'.ge
      exact (hNmax.eq_of_le hM.ne_top hle).symm
    · intro P hP hPc
      have hle : Ideal.map (AdjoinRoot.of μ) (IsLocalRing.maximalIdeal A) ≤ P :=
        Ideal.map_le_iff_le_comap.mpr hPc.ge
      exact (hNmax.eq_of_le hP.ne_top hle).symm

  have hlift : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (ρ : A →+* K), ρ.Finite →
      RingHom.ker ρ = IsLocalRing.maximalIdeal A → ∀ y : K, ∃ μ : Polynomial A, μ.Monic ∧
        Irreducible (μ.map (IsLocalRing.residue A)) ∧ Polynomial.eval₂ ρ y μ = 0 := by
    intro A _ _ ρ hfin hker y
    haveI hlh : IsLocalHom ρ := ⟨fun a ha => by
      by_contra hna
      have h1 : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hna
      rw [← hker] at h1
      exact ha.ne_zero (RingHom.mem_ker.mp h1)⟩
    let ρb : IsLocalRing.ResidueField A →+* K := IsLocalRing.ResidueField.lift ρ
    have hρb : ρb.comp (IsLocalRing.residue A) = ρ := IsLocalRing.ResidueField.lift_comp_residue ρ
    letI : Algebra (IsLocalRing.ResidueField A) K := ρb.toAlgebra
    have hint : IsIntegral (IsLocalRing.ResidueField A) y := by
      obtain ⟨p, hp, hp0⟩ := hfin.to_isIntegral y
      refine ⟨p.map (IsLocalRing.residue A), hp.map _, ?_⟩
      show Polynomial.eval₂ ρb y (p.map (IsLocalRing.residue A)) = 0
      rw [Polynomial.eval₂_map, hρb]
      exact hp0
    have hlifts : minpoly (IsLocalRing.ResidueField A) y ∈ Polynomial.lifts (IsLocalRing.residue A) :=
      (Polynomial.mem_lifts _).mpr
        (Polynomial.map_surjective _ IsLocalRing.residue_surjective _)
    obtain ⟨μ, hμmap, -, hμ⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlifts
      (minpoly.monic hint)
    refine ⟨μ, hμ, ?_, ?_⟩
    · rw [hμmap]; exact minpoly.irreducible hint
    · rw [← hρb, ← Polynomial.eval₂_map, hμmap]
      have := minpoly.aeval (IsLocalRing.ResidueField A) y
      rw [Polynomial.aeval_def] at this
      exact this

  have hstep : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (ρ : A →+* K),
      ρ.Finite → RingHom.ker ρ = IsLocalRing.maximalIdeal A → ∀ y : K,
      ∃ (A₁ : Type u) (_ : CommRing A₁) (_ : IsLocalRing A₁) (_ : IsNoetherianRing A₁)
        (_ : Algebra A A₁) (ρ₁ : A₁ →+* K), Module.Flat A A₁ ∧ ρ₁.Finite ∧
        RingHom.ker ρ₁ = IsLocalRing.maximalIdeal A₁ ∧ ρ₁.comp (algebraMap A A₁) = ρ ∧
        y ∈ ρ₁.range ∧ ∀ P : Ideal A₁, P.IsPrime →
          P.comap (algebraMap A A₁) = IsLocalRing.maximalIdeal A → P = IsLocalRing.maximalIdeal A₁ := by
    intro A _ _ _ ρ hfin hker y
    obtain ⟨μ, hμ, hirr, hroot⟩ := hlift A ρ hfin hker y
    obtain ⟨hNmax, hmax, hprime⟩ := hloc A μ hμ hirr
    letI : IsLocalRing (AdjoinRoot μ) :=
      IsLocalRing.of_unique_max_ideal ⟨_, hNmax, fun M hM => hmax M hM⟩
    have hNm : Ideal.map (AdjoinRoot.of μ) (IsLocalRing.maximalIdeal A) =
        IsLocalRing.maximalIdeal (AdjoinRoot μ) := IsLocalRing.eq_maximalIdeal hNmax
    have hcomp : (AdjoinRoot.lift ρ y hroot).comp (AdjoinRoot.of μ) = ρ :=
      RingHom.ext fun a => AdjoinRoot.lift_of hroot
    haveI : Module.Free A (AdjoinRoot μ) := hμ.free_adjoinRoot
    have hker1 : RingHom.ker (AdjoinRoot.lift ρ y hroot) =
        Ideal.map (AdjoinRoot.of μ) (IsLocalRing.maximalIdeal A) := by
      symm
      apply hNmax.eq_of_le (RingHom.ker_ne_top _)
      rw [Ideal.map_le_iff_le_comap, RingHom.comap_ker, hcomp, hker]
    refine ⟨AdjoinRoot μ, inferInstance, inferInstance, inferInstance, inferInstance,
      AdjoinRoot.lift ρ y hroot, Module.Flat.of_free, ?_, ?_, ?_,
      ⟨AdjoinRoot.root μ, AdjoinRoot.lift_root hroot⟩, ?_⟩
    · exact RingHom.Finite.of_comp_finite (f := AdjoinRoot.of μ) (by rw [hcomp]; exact hfin)
    · rw [hker1, hNm]
    · rw [AdjoinRoot.algebraMap_eq]; exact hcomp
    · intro P hP hPc
      rw [AdjoinRoot.algebraMap_eq] at hPc
      rw [← hNm]; exact hprime P hP hPc

  have hind : ∀ (m : ℕ) (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
      (ρ : A →+* K) (y : Fin m → K), ρ.Finite → RingHom.ker ρ = IsLocalRing.maximalIdeal A →
      ∃ (A₁ : Type u) (_ : CommRing A₁) (_ : IsLocalRing A₁) (_ : IsNoetherianRing A₁)
        (_ : Algebra A A₁) (ρ₁ : A₁ →+* K), Module.Flat A A₁ ∧
        RingHom.ker ρ₁ = IsLocalRing.maximalIdeal A₁ ∧ ρ₁.comp (algebraMap A A₁) = ρ ∧
        (∀ i, y i ∈ ρ₁.range) ∧ ∀ P : Ideal A₁, P.IsPrime →
          P.comap (algebraMap A A₁) = IsLocalRing.maximalIdeal A → P = IsLocalRing.maximalIdeal A₁ := by
    intro m
    induction m with
    | zero =>
      intro A _ _ _ ρ y hfin hker
      refine ⟨A, inferInstance, inferInstance, inferInstance, inferInstance, ρ, Module.Flat.self,
        hker, ?_, fun i => i.elim0, ?_⟩
      · rw [Algebra.algebraMap_self, RingHom.comp_id]
      · intro P _ hP
        rw [Algebra.algebraMap_self, Ideal.comap_id] at hP
        exact hP
    | succ m ih =>
      intro A _ _ _ ρ y hfin hker
      obtain ⟨A₁, _, _, _, _, ρ₁, hflat₁, hfin₁, hker₁, hcomp₁, hmem₁, huniq₁⟩ :=
        hstep A ρ hfin hker (y 0)
      obtain ⟨A₂, _, _, _, _, ρ₂, hflat₂, hker₂, hcomp₂, hmem₂, huniq₂⟩ :=
        ih A₁ ρ₁ (fun i => y i.succ) hfin₁ hker₁
      letI : Algebra A A₂ := ((algebraMap A₁ A₂).comp (algebraMap A A₁)).toAlgebra
      haveI : IsScalarTower A A₁ A₂ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      refine ⟨A₂, inferInstance, inferInstance, inferInstance, inferInstance, ρ₂,
        Module.Flat.trans A A₁ A₂, hker₂, ?_, ?_, ?_⟩
      · show ρ₂.comp ((algebraMap A₁ A₂).comp (algebraMap A A₁)) = ρ
        rw [← RingHom.comp_assoc, hcomp₂, hcomp₁]
      · intro i
        rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨j, rfl⟩
        · obtain ⟨r, hr⟩ := hmem₁
          exact ⟨algebraMap A₁ A₂ r, by rw [← RingHom.comp_apply, hcomp₂, hr]⟩
        · exact hmem₂ j
      · intro P hP hPc
        apply huniq₂ P hP
        apply huniq₁ _ (Ideal.IsPrime.comap _)
        rw [Ideal.comap_comap]
        exact hPc

  letI : Algebra A₀ K := ρ₀.toAlgebra
  haveI : Module.Finite A₀ K := hfin₀
  obtain ⟨m, y, hy⟩ := Module.Finite.exists_fin (R := A₀) (M := K)
  obtain ⟨A₁, _, _, _, _, ρ₁, hflat, hker₁, hcomp, hmem, huniq⟩ := hind m A₀ ρ₀ y hfin₀ hker₀
  refine ⟨A₁, inferInstance, inferInstance, inferInstance, inferInstance, ρ₁, hflat, ?_, hker₁,
    hcomp, huniq⟩
  intro z
  have hz : z ∈ Submodule.span A₀ (Set.range y) := by rw [hy]; trivial
  have hzr : z ∈ ρ₁.range := by
    induction hz using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact hmem i
    | zero => exact zero_mem _
    | add x w _ _ hx hw => exact add_mem hx hw
    | smul a x _ hx =>
      rw [Algebra.smul_def]
      refine mul_mem ⟨algebraMap A₀ A₁ a, ?_⟩ hx
      rw [← RingHom.comp_apply, hcomp]
      rfl
  exact hzr

theorem wc_fpc_henselian_completion : ∀ (A₁ : Type u) [CommRing A₁] [IsLocalRing A₁] [IsNoetherianRing A₁] (K : Type u) [Field K] (ρ₁ : A₁ →+* K), Function.Surjective ρ₁ → RingHom.ker ρ₁ = IsLocalRing.maximalIdeal A₁ → ∃ (A' : Type u) (_ : CommRing A') (_ : IsLocalRing A') (_ : IsNoetherianRing A') (_ : HenselianLocalRing A') (_ : Algebra A₁ A') (ρ' : A' →+* K), Module.Flat A₁ A' ∧ Function.Surjective ρ' ∧ RingHom.ker ρ' = IsLocalRing.maximalIdeal A' ∧ ρ'.comp (algebraMap A₁ A') = ρ₁ ∧ ∀ P : Ideal A', P.IsPrime → P.comap (algebraMap A₁ A') = IsLocalRing.maximalIdeal A₁ → P = IsLocalRing.maximalIdeal A' :=
by
  intro A₁ _ _ _ K _ ρ₁ hsurj hker
  classical
  obtain ⟨hloc, hcomp, -, -⟩ := wc_hnas_completion_local_complete A₁
  letI := hloc
  haveI := hcomp
  haveI hnoeth := wc_hnas_completion_noetherian A₁
  have hflat : Module.Flat A₁ (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁) :=
    AdicCompletion.flat_of_isNoetherian _
  haveI hhr : HenselianRing (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁)
      (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁)) :=
    IsAdicComplete.henselianRing _ _
  have hhl : HenselianLocalRing (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁) :=
    { toIsLocalRing := hloc
      is_henselian := fun f hf a₀ h1 h2 =>
        HenselianRing.is_henselian f hf a₀ h1 (h2.map _) }
  have H₀ : ∀ a ∈ IsLocalRing.maximalIdeal A₁ ^ 1, ρ₁ a = 0 := by
    intro a ha
    rw [pow_one, ← hker] at ha
    exact ha
  let ρ' : AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁ →+* K :=
    (Ideal.Quotient.lift _ ρ₁ H₀).comp
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A₁) 1).toRingHom
  have hcompat : ∀ x : A₁,
      ρ' (algebraMap A₁ (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁) x) = ρ₁ x := by
    intro x
    show Ideal.Quotient.lift _ ρ₁ H₀ (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A₁) 1
      (AdicCompletion.of (IsLocalRing.maximalIdeal A₁) A₁ x)) = ρ₁ x
    rw [AdicCompletion.evalₐ_of, Ideal.Quotient.lift_mk]
  have hsurj' : Function.Surjective ρ' := fun k => by
    obtain ⟨a, rfl⟩ := hsurj k
    exact ⟨_, hcompat a⟩
  have hkerρ : RingHom.ker ρ' =
      IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁) := by
    haveI := RingHom.ker_isMaximal_of_surjective ρ' hsurj'
    exact IsLocalRing.eq_maximalIdeal this
  have hsup : Ideal.map (algebraMap A₁ (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁))
      (IsLocalRing.maximalIdeal A₁) ≤
      IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁) := by
    apply Ideal.map_le_of_le_comap
    intro a ha
    rw [Ideal.mem_comap, ← hkerρ, RingHom.mem_ker, hcompat, ← RingHom.mem_ker, hker]
    exact ha
  have hmeq : IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁) =
      Ideal.map (algebraMap A₁ (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁))
        (IsLocalRing.maximalIdeal A₁) := by
    apply le_antisymm _ hsup
    intro b hb
    obtain ⟨p, hp⟩ := (wc_hnas_hs_completion_levels A₁).1 1 b
    rw [pow_one] at hp
    have hip : algebraMap A₁ (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁) p ∈
        IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁) := by
      have := Ideal.sub_mem _ hb (hsup hp)
      rwa [sub_sub_cancel] at this
    have hp1 : p ∈ IsLocalRing.maximalIdeal A₁ := by
      rw [← hkerρ, RingHom.mem_ker, hcompat] at hip
      rw [← hker]
      exact hip
    have := Ideal.add_mem _ hp (Ideal.mem_map_of_mem
      (algebraMap A₁ (AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁)) hp1)
    rwa [sub_add_cancel] at this
  refine ⟨AdicCompletion (IsLocalRing.maximalIdeal A₁) A₁, inferInstance, hloc, hnoeth, hhl,
    inferInstance, ρ', hflat, hsurj', hkerρ, RingHom.ext hcompat, ?_⟩
  intro P hP hPc
  apply le_antisymm (IsLocalRing.le_maximalIdeal hP.ne_top)
  rw [hmeq]
  exact Ideal.map_le_of_le_comap (le_of_eq hPc.symm)

theorem wc_fpc_section_power_series : ∀ (H D : Type u) [CommRing H] [IsLocalRing H] [IsNoetherianRing H] [CommRing D] [Algebra H D] [Algebra.Smooth H D] (τ : D →ₐ[H] H), ∃ (e : ℕ) (θ : D →ₐ[H] MvPowerSeries (Fin e) H), θ.toRingHom.Flat ∧ ∀ x : D, MvPowerSeries.constantCoeff (θ x) = τ x :=
by
  intro H D _ _ _ _ _ _ τ
  classical
  haveI : Algebra.FiniteType H D := inferInstance
  haveI : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing H D

  have hcot : Module.Free H (RingHom.ker τ).Cotangent ∧
      Module.Finite H (RingHom.ker τ).Cotangent := by
    letI : Algebra D H := τ.toRingHom.toAlgebra
    haveI : IsScalarTower H D H := IsScalarTower.of_algebraMap_eq (fun a => (τ.commutes a).symm)
    have hsurj : Function.Surjective (algebraMap D H) := fun a => ⟨algebraMap H D a, τ.commutes a⟩
    obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := H) (P := D) (A := H)
      hsurj).mp inferInstance
    have hP : Module.Projective H (RingHom.ker (algebraMap D H)).Cotangent :=
      Module.Projective.of_split
        ((KaehlerDifferential.kerCotangentToTensor H D H).restrictScalars H)
        (l.restrictScalars H) (by
          ext y
          exact LinearMap.congr_fun hl y)
    have hFin : Module.Finite H (RingHom.ker (algebraMap D H)).Cotangent := by
      refine Module.Finite.of_surjective (l.restrictScalars H) ?_
      intro y
      exact ⟨KaehlerDifferential.kerCotangentToTensor H D H y, LinearMap.congr_fun hl y⟩
    have hFree : Module.Free H (RingHom.ker (algebraMap D H)).Cotangent :=
      Module.free_of_flat_of_isLocalRing
    exact ⟨hFree, hFin⟩
  haveI := hcot.1
  haveI := hcot.2

  have hbasis : ∃ (d : ℕ) (x : Fin d → D), (∀ i, τ (x i) = 0) ∧
      (∀ y ∈ RingHom.ker τ, ∃ c : Fin d → H,
        y - ∑ i, algebraMap H D (c i) * x i ∈ RingHom.ker τ ^ 2) ∧
      (∀ (M : Type u) [AddCommGroup M] [Module H M] (N : Submodule H M) (m : Fin d → M),
        (∀ i, m i ∈ N) → ∃ δ : D →+ M, (∀ β, δ β ∈ N) ∧ (∀ a : H, δ (algebraMap H D a) = 0) ∧
          (∀ β γ : D, δ (β * γ) = τ β • δ γ + τ γ • δ β) ∧ ∀ i, δ (x i) = m i) := by
    set I := RingHom.ker τ with hI
    let b := Module.finBasis H I.Cotangent
    choose xI hxI using fun i => I.toCotangent_surjective (b i)
    have hsm : ∀ (c : H) (y : I), I.toCotangent (c • y) = c • I.toCotangent y := by
      intro c y
      exact LinearMap.map_smul_of_tower I.toCotangent c y
    refine ⟨Module.finrank H I.Cotangent, fun i => (xI i : D), fun i => (xI i).2, ?_, ?_⟩
    · intro y hy
      refine ⟨b.repr (I.toCotangent ⟨y, hy⟩), ?_⟩
      have h0 : I.toCotangent (⟨y, hy⟩ - ∑ i, (b.repr (I.toCotangent ⟨y, hy⟩) i) • xI i) = 0 := by
        rw [map_sub, map_sum]
        simp only [hsm, hxI]
        rw [b.sum_repr, sub_self]
      rw [Ideal.toCotangent_eq_zero] at h0
      simpa [Submodule.coe_sum, Algebra.smul_def] using h0
    · intro M _ _ N m hm
      let lam : I.Cotangent →ₗ[H] M := b.constr H m
      have hE : ∀ β : D, β - algebraMap H D (τ β) ∈ I := by
        intro β
        rw [hI, RingHom.mem_ker, map_sub, AlgHom.commutes]
        simp
      let E : D → I := fun β => ⟨β - algebraMap H D (τ β), hE β⟩
      have hEadd : ∀ β γ, E (β + γ) = E β + E γ := by
        intro β γ; apply Subtype.ext; simp only [E, Submodule.coe_add, map_add]; ring
      let δ : D →+ M :=
        { toFun := fun β => lam (I.toCotangent (E β))
          map_zero' := by
            have : E 0 = 0 := by apply Subtype.ext; simp [E]
            simp [this]
          map_add' := by
            intro β γ
            simp only [hEadd, map_add] }
      have hδ : ∀ β, δ β = lam (I.toCotangent (E β)) := fun _ => rfl
      refine ⟨δ, ?_, ?_, ?_, ?_⟩
      · intro β
        have h1 : lam (I.toCotangent (E β)) ∈ LinearMap.range lam := ⟨_, rfl⟩
        rw [Module.Basis.constr_range] at h1
        rw [hδ]
        exact Submodule.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hm i) h1
      · intro a
        have : E (algebraMap H D a) = 0 := by
          apply Subtype.ext; simp [E, AlgHom.commutes]
        rw [hδ, this, map_zero, map_zero]
      · intro β γ
        have hkey : I.toCotangent (E (β * γ) - (τ β) • E γ - (τ γ) • E β) = 0 := by
          rw [Ideal.toCotangent_eq_zero]
          have e : ((E (β * γ) - (τ β) • E γ - (τ γ) • E β : I) : D) =
              (β - algebraMap H D (τ β)) * (γ - algebraMap H D (τ γ)) := by
            simp only [E, Submodule.coe_sub, Submodule.coe_smul_of_tower, Algebra.smul_def,
              map_mul]
            ring
          rw [e, pow_two]
          exact Ideal.mul_mem_mul (hE β) (hE γ)
        rw [map_sub, map_sub, hsm, hsm, sub_sub, sub_eq_zero] at hkey
        rw [hδ, hδ, hδ, hkey, map_add, map_smul, map_smul]
      · intro i
        have : E (xI i : D) = xI i := by
          apply Subtype.ext
          have h0 : τ (xI i : D) = 0 := (xI i).2
          simp [E, h0]
        rw [hδ, this, hxI, Module.Basis.constr_basis]
  obtain ⟨d, x, hx0, hgen, hder⟩ := hbasis

  have hMem : ∀ (n : ℕ) (p : MvPolynomial (Fin d) H),
      p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n ↔ ∀ e ∈ p.support, n ≤ Finsupp.degree e := by
    have hadd : ∀ (k : ℕ) (p q : MvPolynomial (Fin d) H),
        (∀ e ∈ p.support, k ≤ Finsupp.degree e) → (∀ e ∈ q.support, k ≤ Finsupp.degree e) →
        ∀ e ∈ (p + q).support, k ≤ Finsupp.degree e := by
      intro k p q hp hq e he
      rcases Finset.mem_union.mp (MvPolynomial.support_add he) with h | h
      · exact hp e h
      · exact hq e h
    have hmul : ∀ (k l : ℕ) (p q : MvPolynomial (Fin d) H),
        (∀ e ∈ p.support, k ≤ Finsupp.degree e) → (∀ e ∈ q.support, l ≤ Finsupp.degree e) →
        ∀ e ∈ (p * q).support, k + l ≤ Finsupp.degree e := by
      intro k l p q hp hq e he
      obtain ⟨e1, he1, e2, he2, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul p q he)
      rw [map_add]
      exact add_le_add (hp e1 he1) (hq e2 he2)
    have hJ : ∀ q ∈ Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) H)),
        ∀ e ∈ q.support, 1 ≤ Finsupp.degree e := by
      intro q hq
      induction hq using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨i, rfl⟩ := hy
        intro e he
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_X'] at he
        split_ifs at he with h
        · subst h; simp
        · exact absurd rfl he
      | zero => intro e he; simp at he
      | add y z _ _ hy hz => exact hadd 1 y z hy hz
      | smul r y _ hy =>
        intro e he
        have := hmul 0 1 r y (fun _ _ => Nat.zero_le _) hy e he
        simpa using this
    intro n p
    constructor
    · intro hp
      induction n generalizing p with
      | zero => intro e _; exact Nat.zero_le _
      | succ n ih =>
        rw [pow_succ] at hp
        exact Submodule.mul_induction_on
          (C := fun r => ∀ e ∈ r.support, n + 1 ≤ Finsupp.degree e) hp
          (fun m hm q hq => hmul n 1 m q (ih m hm) (hJ q hq))
          (fun y z hy hz => hadd _ y z hy hz)
    · intro h
      rw [MvPolynomial.as_sum p]
      refine Ideal.sum_mem _ (fun e he => ?_)
      refine Ideal.pow_le_pow_right (h e he) ?_
      rw [MvPolynomial.monomial_eq]
      refine Ideal.mul_mem_left _ _ ?_
      have hdeg : Finsupp.degree e = ∑ i ∈ e.support, e i := rfl
      rw [hdeg, ← Finset.prod_pow_eq_pow_sum, Finsupp.prod]
      exact Ideal.prod_mem_prod (fun i _ =>
        Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _)

  have hS1 : ∀ (n : ℕ) (β : D), ∃ p : MvPolynomial (Fin d) H,
      β - MvPolynomial.aeval x p ∈ (RingHom.ker τ) ^ n := by
    have hxI : ∀ i, x i ∈ RingHom.ker τ := fun i => RingHom.mem_ker.mpr (hx0 i)
    have T1 : ∀ v ∈ RingHom.ker τ, ∃ q : MvPolynomial (Fin d) H,
        MvPolynomial.aeval x q ∈ RingHom.ker τ ∧
          v - MvPolynomial.aeval x q ∈ RingHom.ker τ ^ 2 := by
      intro v hv
      obtain ⟨c, hc⟩ := hgen v hv
      have e : MvPolynomial.aeval x (∑ i, MvPolynomial.C (c i) * MvPolynomial.X i) =
          ∑ i, algebraMap H D (c i) * x i := by
        simp [map_sum, MvPolynomial.aeval_X]
      refine ⟨∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_, ?_⟩
      · rw [e]
        exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hxI i))
      · rw [e]; exact hc
    have T : ∀ k : ℕ, ∀ y ∈ RingHom.ker τ ^ k, ∃ p : MvPolynomial (Fin d) H,
        MvPolynomial.aeval x p ∈ RingHom.ker τ ^ k ∧
          y - MvPolynomial.aeval x p ∈ RingHom.ker τ ^ (k + 1) := by
      intro k
      induction k with
      | zero =>
        intro y _
        refine ⟨MvPolynomial.C (τ y), by simp, ?_⟩
        rw [zero_add, pow_one, MvPolynomial.aeval_C, RingHom.mem_ker, map_sub, AlgHom.commutes]
        simp
      | succ k ih =>
        intro y hy
        rw [pow_succ] at hy
        refine Submodule.mul_induction_on (C := fun y => ∃ p : MvPolynomial (Fin d) H,
          MvPolynomial.aeval x p ∈ RingHom.ker τ ^ (k + 1) ∧
            y - MvPolynomial.aeval x p ∈ RingHom.ker τ ^ (k + 1 + 1)) hy ?_ ?_
        · intro u hu v hv
          obtain ⟨p, hp1, hp2⟩ := ih u hu
          obtain ⟨q, hq1, hq2⟩ := T1 v hv
          refine ⟨p * q, ?_, ?_⟩
          · rw [map_mul, pow_succ]; exact Ideal.mul_mem_mul hp1 hq1
          · rw [map_mul]
            have e : u * v - MvPolynomial.aeval x p * MvPolynomial.aeval x q =
                (u - MvPolynomial.aeval x p) * v +
                  MvPolynomial.aeval x p * (v - MvPolynomial.aeval x q) := by ring
            rw [e]
            refine Ideal.add_mem _ ?_ ?_
            · rw [pow_succ]; exact Ideal.mul_mem_mul hp2 hv
            · rw [show k + 1 + 1 = k + 2 from rfl, pow_add]; exact Ideal.mul_mem_mul hp1 hq2
        · intro y1 y2 h1 h2
          obtain ⟨p1, h11, h12⟩ := h1
          obtain ⟨p2, h21, h22⟩ := h2
          refine ⟨p1 + p2, ?_, ?_⟩
          · rw [map_add]; exact Ideal.add_mem _ h11 h21
          · rw [map_add, show y1 + y2 - (MvPolynomial.aeval x p1 + MvPolynomial.aeval x p2) =
              (y1 - MvPolynomial.aeval x p1) + (y2 - MvPolynomial.aeval x p2) by ring]
            exact Ideal.add_mem _ h12 h22
    intro n
    induction n with
    | zero => intro β; exact ⟨0, by simp⟩
    | succ n ih =>
      intro β
      obtain ⟨p, hp⟩ := ih β
      obtain ⟨q, -, hq⟩ := T n _ hp
      refine ⟨p + q, ?_⟩
      rw [map_add, show β - (MvPolynomial.aeval x p + MvPolynomial.aeval x q) =
        β - MvPolynomial.aeval x p - MvPolynomial.aeval x q by ring]
      exact hq


  have hS2 : ∀ (n : ℕ) (p : MvPolynomial (Fin d) H),
      MvPolynomial.aeval x p ∈ (RingHom.ker τ) ^ n →
        p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n := by
    set J := Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) H)) with hJdef
    have hXJ : ∀ i, (MvPolynomial.X i : MvPolynomial (Fin d) H) ∈ J :=
      fun i => Ideal.subset_span (Set.mem_range_self i)
    have hprod0 : ∀ (k : ℕ) (p q : MvPolynomial (Fin d) H), p * q ∈ J ^ k →
        Ideal.Quotient.mk (J ^ k) p * Ideal.Quotient.mk (J ^ k) q = 0 := by
      intro k p q h
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]; exact h
    have C : ∀ n : ℕ, ∃ ψ : D →ₐ[H] MvPolynomial (Fin d) H ⧸ J ^ (n + 1),
        (∀ i, ψ (x i) = Ideal.Quotient.mk _ (MvPolynomial.X i)) ∧
        (∀ β, τ β = 0 → ∃ p ∈ J, ψ β = Ideal.Quotient.mk _ p) := by
      intro n
      induction n with
      | zero =>
        refine ⟨(Algebra.ofId H _).comp τ, ?_, ?_⟩
        · intro i
          rw [AlgHom.comp_apply, hx0, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem,
            zero_add, pow_one]
          exact hXJ i
        · intro β hβ
          exact ⟨0, J.zero_mem, by rw [AlgHom.comp_apply, hβ, map_zero, map_zero]⟩
      | succ n ih =>
        obtain ⟨ψ, hψ1, hψ2⟩ := ih
        have hle : J ^ (n + 1 + 1) ≤ J ^ (n + 1) := Ideal.pow_le_pow_right (Nat.le_succ (n + 1))
        let g : MvPolynomial (Fin d) H ⧸ J ^ (n + 1 + 1) →ₐ[H]
            MvPolynomial (Fin d) H ⧸ J ^ (n + 1) :=
          Ideal.Quotient.factorₐ H hle
        have hg : ∀ p, g (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ p := fun p => rfl
        have hgs : Function.Surjective g := by
          intro z
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
          exact ⟨_, hg p⟩
        have hJm : J ^ (n + 1) ≤ J := Ideal.pow_le_self (by omega)
        have hker : ∀ z, g z = 0 → ∃ p ∈ J ^ (n + 1), z = Ideal.Quotient.mk _ p := by
          intro z hz
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
          rw [hg, Ideal.Quotient.eq_zero_iff_mem] at hz
          exact ⟨p, hz, rfl⟩
        have hsq : J ^ (n + 1) * J ^ (n + 1) ≤ J ^ (n + 1 + 1) := by
          rw [← pow_add]; exact Ideal.pow_le_pow_right (by omega)
        have hnil : IsNilpotent (RingHom.ker g) := by
          have h2 : RingHom.ker g ^ 2 = ⊥ := by
            rw [pow_two, eq_bot_iff]
            refine Ideal.mul_le.mpr (fun z hz w hw => ?_)
            obtain ⟨p, hp, rfl⟩ := hker z hz
            obtain ⟨q, hq, rfl⟩ := hker w hw
            rw [Ideal.mem_bot]
            exact hprod0 _ _ _ (hsq (Ideal.mul_mem_mul hp hq))
          exact ⟨2, h2⟩
        let ψ' := Algebra.FormallySmooth.liftOfSurjective ψ g hgs hnil
        have hψ' : ∀ β, g (ψ' β) = ψ β := fun β =>
          Algebra.FormallySmooth.liftOfSurjective_apply ψ g hgs hnil β
        have hpre : ∀ β, τ β = 0 → ∃ p ∈ J, ψ' β = Ideal.Quotient.mk _ p := by
          intro β hβ
          obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective (ψ' β)
          obtain ⟨p0, hp0, hp0e⟩ := hψ2 β hβ
          have h1 := hψ' β
          rw [← hq, hg, hp0e, Ideal.Quotient.eq] at h1
          refine ⟨q, ?_, hq.symm⟩
          have e : q = (q - p0) + p0 := by ring
          rw [e]
          exact J.add_mem (hJm h1) hp0
        let N : Submodule H (MvPolynomial (Fin d) H ⧸ J ^ (n + 1 + 1)) :=
          (Ideal.map (Ideal.Quotient.mk (J ^ (n + 1 + 1))) (J ^ (n + 1))).restrictScalars H
        have hNmem : ∀ z, z ∈ N ↔ ∃ p ∈ J ^ (n + 1), Ideal.Quotient.mk _ p = z := by
          intro z
          exact Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective
        let ε : Fin d → MvPolynomial (Fin d) H ⧸ J ^ (n + 1 + 1) :=
          fun i => Ideal.Quotient.mk _ (MvPolynomial.X i) - ψ' (x i)
        have hε : ∀ i, ε i ∈ N := by
          intro i
          rw [hNmem]
          obtain ⟨p, hp, he⟩ := hker (ε i) (by
            simp only [ε, map_sub, hg, hψ', hψ1, sub_self])
          exact ⟨p, hp, he.symm⟩
        obtain ⟨δ, hδN, hδa, hδmul, hδx⟩ := hder _ N ε hε
        have hsmQ : ∀ (a : H) (z : MvPolynomial (Fin d) H ⧸ J ^ (n + 1 + 1)),
            a • z = algebraMap H _ a * z := fun a z => Algebra.smul_def a z
        have hδ1 : δ 1 = 0 := by
          have := hδa 1
          rwa [map_one] at this
        have hδδ : ∀ β γ, δ β * δ γ = 0 := by
          intro β γ
          obtain ⟨p, hp, hpe⟩ := (hNmem _).mp (hδN β)
          obtain ⟨q, hq, hqe⟩ := (hNmem _).mp (hδN γ)
          rw [← hpe, ← hqe]
          exact hprod0 _ _ _ (hsq (Ideal.mul_mem_mul hp hq))
        have hJδ : ∀ β γ, τ β = 0 → ψ' β * δ γ = 0 := by
          intro β γ hβ
          obtain ⟨p, hp, hpe⟩ := hpre β hβ
          obtain ⟨q, hq, hqe⟩ := (hNmem _).mp (hδN γ)
          rw [hpe, ← hqe]
          apply hprod0
          rw [pow_succ']
          exact Ideal.mul_mem_mul hp hq
        have hsub : ∀ β, τ (β - algebraMap H D (τ β)) = 0 := by
          intro β; rw [map_sub, AlgHom.commutes]; simp
        have hcorr : ∀ β γ, ψ' β * δ γ = algebraMap H _ (τ β) * δ γ := by
          intro β γ
          have h := hJδ _ γ (hsub β)
          rw [map_sub, AlgHom.commutes, sub_mul, sub_eq_zero] at h
          exact h
        let ψn : D →ₐ[H] MvPolynomial (Fin d) H ⧸ J ^ (n + 1 + 1) :=
          { toFun := fun β => ψ' β + δ β
            map_one' := by simp only [map_one, hδ1, add_zero]
            map_mul' := by
              intro β γ
              show ψ' (β * γ) + δ (β * γ) = (ψ' β + δ β) * (ψ' γ + δ γ)
              rw [map_mul, hδmul, hsmQ, hsmQ]
              linear_combination (-(hcorr β γ) - (hcorr γ β) - hδδ β γ)
            map_zero' := by simp only [map_zero, add_zero]
            map_add' := by
              intro β γ
              simp only [map_add]
              ring
            commutes' := by
              intro a
              simp only [AlgHom.commutes, hδa, add_zero] }
        refine ⟨ψn, ?_, ?_⟩
        · intro i
          show ψ' (x i) + δ (x i) = _
          rw [hδx]
          simp only [ε]
          ring
        · intro β hβ
          obtain ⟨p, hp, hpe⟩ := hpre β hβ
          obtain ⟨q, hq, hqe⟩ := (hNmem _).mp (hδN β)
          refine ⟨p + q, J.add_mem hp (hJm hq), ?_⟩
          show ψ' β + δ β = _
          rw [hpe, ← hqe, map_add]
    intro n p hp
    rcases n with _ | n
    · simp
    obtain ⟨ψ, hψ1, hψ2⟩ := C n
    have hcomp : ψ.comp (MvPolynomial.aeval x) = Ideal.Quotient.mkₐ H (J ^ (n + 1)) := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, MvPolynomial.aeval_X, hψ1, Ideal.Quotient.mkₐ_eq_mk]
    have hpow : ∀ k : ℕ, ∀ y ∈ RingHom.ker τ ^ k, ∃ q ∈ J ^ k,
        ψ y = Ideal.Quotient.mk _ q := by
      intro k
      induction k with
      | zero =>
        intro y _
        obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective (ψ y)
        exact ⟨q, by simp, hq.symm⟩
      | succ k ih =>
        intro y hy
        rw [pow_succ] at hy
        refine Submodule.mul_induction_on (C := fun y => ∃ q ∈ J ^ (k + 1),
          ψ y = Ideal.Quotient.mk _ q) hy ?_ ?_
        · intro u hu v hv
          obtain ⟨q1, hq1, e1⟩ := ih u hu
          obtain ⟨q2, hq2, e2⟩ := hψ2 v (RingHom.mem_ker.mp hv)
          refine ⟨q1 * q2, ?_, ?_⟩
          · rw [pow_succ]; exact Ideal.mul_mem_mul hq1 hq2
          · rw [map_mul, e1, e2, map_mul]
        · intro y1 y2 h1 h2
          obtain ⟨q1, hq1, e1⟩ := h1
          obtain ⟨q2, hq2, e2⟩ := h2
          exact ⟨q1 + q2, Ideal.add_mem _ hq1 hq2, by rw [map_add, e1, e2, map_add]⟩
    obtain ⟨q, hq, hqe⟩ := hpow (n + 1) _ hp
    have h1 : Ideal.Quotient.mk (J ^ (n + 1)) p = 0 := by
      rw [← Ideal.Quotient.mkₐ_eq_mk H, ← hcomp, AlgHom.comp_apply, hqe,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hq
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1

  have hF : ∀ n, ∀ p : MvPolynomial (Fin d) H,
      p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n →
        MvPolynomial.aeval x p ∈ (RingHom.ker τ) ^ n := by
    intro n p hp
    have hJ : Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) H)) ≤
        Ideal.comap (MvPolynomial.aeval x) (RingHom.ker τ) := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      simp only [SetLike.mem_coe, Ideal.mem_comap, MvPolynomial.aeval_X]
      exact RingHom.mem_ker.mpr (hx0 i)
    have := (Ideal.pow_right_mono hJ n).trans (Ideal.le_comap_pow _ n) hp
    exact Ideal.mem_comap.mp this
  have hcoef : ∀ n, ∀ p : MvPolynomial (Fin d) H,
      p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n →
        ∀ e, Finsupp.degree e < n → p.coeff e = 0 := by
    intro n p hp e he
    by_contra h
    exact absurd ((hMem n p).mp hp e (MvPolynomial.mem_support_iff.mpr h)) (not_le.mpr he)
  have hcrit : ∀ n, ∀ p : MvPolynomial (Fin d) H,
      (∀ e, Finsupp.degree e < n → p.coeff e = 0) →
        p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n := by
    intro n p hp
    rw [hMem]
    intro e he
    by_contra h
    exact MvPolynomial.mem_support_iff.mp he (hp e (not_le.mp h))

  set I := RingHom.ker τ with hI

  have hA : ∀ (n : ℕ) (p : MvPolynomial (Fin d) H),
      (∀ ν : Fin d →₀ ℕ, Finsupp.degree ν < n → p.coeff ν = 0) →
        MvPolynomial.aeval x p ∈ I ^ n := fun n p h => hF n p (hcrit n p h)

  have hS2c : ∀ (n : ℕ) (p : MvPolynomial (Fin d) H), MvPolynomial.aeval x p ∈ I ^ n →
      ∀ ν : Fin d →₀ ℕ, Finsupp.degree ν < n → p.coeff ν = 0 :=
    fun n p h => hcoef n p (hS2 n p h)

  have hK : ∀ (n : ℕ) (p q : MvPolynomial (Fin d) H),
      (∀ ν : Fin d →₀ ℕ, Finsupp.degree ν < n → p.coeff ν = q.coeff ν) →
        Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x p) =
          Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x q) := by
    intro n p q h
    rw [Ideal.Quotient.eq, ← map_sub]
    apply hA
    intro ν hν
    rw [MvPolynomial.coeff_sub, h ν hν, sub_self]

  have hT : ∀ (n : ℕ) (F G : MvPowerSeries (Fin d) H) (ν : Fin d →₀ ℕ),
      Finsupp.degree ν < n → (MvPowerSeries.truncTotal n (F * G)).coeff ν =
        (MvPowerSeries.truncTotal n F * MvPowerSeries.truncTotal n G).coeff ν := by
    intro n F G ν hν
    rw [MvPowerSeries.coeff_truncTotal _ hν, MvPowerSeries.coeff_mul, MvPolynomial.coeff_mul]
    refine Finset.sum_congr rfl (fun ab hab => ?_)
    have hab' : ab.1 + ab.2 = ν := Finset.HasAntidiagonal.mem_antidiagonal.mp hab
    have hdeg : Finsupp.degree ab.1 + Finsupp.degree ab.2 = Finsupp.degree ν := by
      rw [← map_add, hab']
    rw [MvPowerSeries.coeff_truncTotal _ (show Finsupp.degree ab.1 < n by omega),
      MvPowerSeries.coeff_truncTotal _ (show Finsupp.degree ab.2 < n by omega)]

  let f : ∀ n : ℕ, MvPowerSeries (Fin d) H →ₐ[H] D ⧸ I ^ n := fun n =>
    { toFun := fun F => Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n F))
      map_one' := by
        show Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n 1)) = 1
        have h1 : (1 : D ⧸ I ^ n) = Ideal.Quotient.mk (I ^ n)
            (MvPolynomial.aeval x (1 : MvPolynomial (Fin d) H)) := by rw [map_one, map_one]
        rw [h1]
        apply hK
        intro ν hν
        rw [MvPowerSeries.coeff_truncTotal _ hν, MvPowerSeries.coeff_one, MvPolynomial.coeff_one]
        by_cases h : ν = 0
        · subst h; simp
        · simp [h, Ne.symm h]
      map_mul' := by
        intro F G
        show Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n (F * G))) =
          Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n F)) *
          Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n G))
        rw [← map_mul, ← map_mul]
        exact hK n _ _ (fun ν hν => hT n F G ν hν)
      map_zero' := by
        show Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n 0)) = 0
        rw [map_zero, map_zero, map_zero]
      map_add' := by
        intro F G
        show Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n (F + G))) =
          Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n F)) +
          Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n G))
        rw [map_add, map_add, map_add]
      commutes' := by
        intro r
        show Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x
          (MvPowerSeries.truncTotal n (algebraMap H (MvPowerSeries (Fin d) H) r))) =
          algebraMap H (D ⧸ I ^ n) r
        rw [← Ideal.Quotient.mk_algebraMap, ← MvPolynomial.aeval_C x r]
        apply hK
        intro ν hν
        rw [MvPowerSeries.coeff_truncTotal _ hν, MvPowerSeries.algebraMap_apply,
          Algebra.algebraMap_self, RingHom.id_apply, MvPowerSeries.coeff_C, MvPolynomial.coeff_C]
        by_cases h : ν = 0
        · subst h; simp
        · simp [h, Ne.symm h] }
  have hf : ∀ n F, f n F =
      Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n F)) :=
    fun _ _ => rfl
  have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
      (Ideal.Quotient.factorₐ H (Ideal.pow_le_pow_right hle : I ^ n ≤ I ^ m)).comp (f n) = f m := by
    intro m n hle
    apply AlgHom.ext
    intro F
    change Ideal.Quotient.mk (I ^ m) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n F)) =
      Ideal.Quotient.mk (I ^ m) (MvPolynomial.aeval x (MvPowerSeries.truncTotal m F))
    apply hK
    intro ν hν
    rw [MvPowerSeries.coeff_truncTotal _ hν,
      MvPowerSeries.coeff_truncTotal _ (lt_of_lt_of_le hν hle)]
  let Φ : MvPowerSeries (Fin d) H →ₐ[H] AdicCompletion I D := AdicCompletion.liftAlgHom I f hcompat
  have hΦ : ∀ (n : ℕ) (F : MvPowerSeries (Fin d) H), AdicCompletion.evalₐ I n (Φ F) =
      Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n F)) :=
    fun n F => AdicCompletion.evalₐ_liftAlgHom I f hcompat n F

  have hinj : Function.Injective Φ := by
    intro F G hFG
    apply MvPowerSeries.ext
    intro ν
    have h := congrArg (AdicCompletion.evalₐ I (Finsupp.degree ν + 1)) hFG
    rw [hΦ, hΦ, Ideal.Quotient.eq, ← map_sub] at h
    have h2 := hS2c _ _ h ν (Nat.lt_succ_self _)
    rw [MvPolynomial.coeff_sub, MvPowerSeries.coeff_truncTotal _ (Nat.lt_succ_self _),
      MvPowerSeries.coeff_truncTotal _ (Nat.lt_succ_self _), sub_eq_zero] at h2
    exact h2
  have hsurj : Function.Surjective Φ := by
    intro ξ
    obtain ⟨g, rfl⟩ := AdicCompletion.mk_surjective I D ξ
    have hC : ∀ (m N : ℕ), m ≤ N → (g : ℕ → D) N - (g : ℕ → D) m ∈ I ^ m := by
      intro m N h
      have := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := I) (M := D) h g
      rw [Submodule.Quotient.eq] at this
      have e : (I ^ m • ⊤ : Submodule D D) = I ^ m := by
        rw [Ideal.smul_eq_mul, Ideal.mul_top]
      rw [e] at this
      exact this
    choose p hp using fun n => hS1 n ((g : ℕ → D) n)
    have hstab : ∀ m n, m ≤ n → ∀ ν : Fin d →₀ ℕ, Finsupp.degree ν < m →
        (p n).coeff ν = (p m).coeff ν := by
      intro m n hmn ν hν
      have h1 : MvPolynomial.aeval x (p n - p m) ∈ I ^ m := by
        have e : MvPolynomial.aeval x (p n - p m) =
            ((g : ℕ → D) n - (g : ℕ → D) m) - ((g : ℕ → D) n - MvPolynomial.aeval x (p n)) +
              ((g : ℕ → D) m - MvPolynomial.aeval x (p m)) := by
          rw [map_sub]; ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.sub_mem _ (hC m n hmn)
          (Ideal.pow_le_pow_right hmn (hp n))) (hp m)
      have h2 := hS2c m _ h1 ν hν
      rwa [MvPolynomial.coeff_sub, sub_eq_zero] at h2
    let F : MvPowerSeries (Fin d) H := fun ν => (p (Finsupp.degree ν + 1)).coeff ν
    refine ⟨F, ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hΦ, AdicCompletion.evalₐ_mk]
    have h1 : Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (MvPowerSeries.truncTotal n F)) =
        Ideal.Quotient.mk (I ^ n) (MvPolynomial.aeval x (p n)) := by
      apply hK
      intro ν hν
      rw [MvPowerSeries.coeff_truncTotal _ hν]
      show (p (Finsupp.degree ν + 1)).coeff ν = _
      exact (hstab _ _ (by omega) ν (Nat.lt_succ_self _)).symm
    rw [h1, Ideal.Quotient.eq]
    have e : MvPolynomial.aeval x (p n) - (g : ℕ → D) n =
        -((g : ℕ → D) n - MvPolynomial.aeval x (p n)) := by ring
    rw [e]
    exact neg_mem (hp n)

  let Ψ : MvPowerSeries (Fin d) H ≃ₐ[H] AdicCompletion I D := AlgEquiv.ofBijective Φ ⟨hinj, hsurj⟩
  let θ : D →ₐ[H] MvPowerSeries (Fin d) H :=
    Ψ.symm.toAlgHom.comp (IsScalarTower.toAlgHom H D (AdicCompletion I D))
  have hflat : θ.toRingHom.Flat := by
    have e : θ.toRingHom = (Ψ.symm.toAlgHom.toRingHom).comp (algebraMap D (AdicCompletion I D)) :=
      rfl
    rw [e]
    exact RingHom.Flat.comp
      (RingHom.flat_algebraMap_iff.mpr (AdicCompletion.flat_of_isNoetherian I))
      (RingHom.Flat.of_bijective (f := Ψ.symm.toAlgHom.toRingHom) Ψ.symm.bijective)
  have hcc : ∀ z : D, MvPowerSeries.constantCoeff (θ z) = τ z := by
    intro z
    have hΨ : Φ (θ z) = algebraMap D (AdicCompletion I D) z := by
      show Ψ (Ψ.symm (algebraMap D (AdicCompletion I D) z)) = _
      exact Ψ.apply_symm_apply _
    have h1 := congrArg (AdicCompletion.evalₐ I 1) hΨ
    rw [hΦ, AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      AdicCompletion.evalₐ_of] at h1
    have htr : MvPowerSeries.truncTotal 1 (θ z) =
        MvPolynomial.C (MvPowerSeries.constantCoeff (θ z)) := by
      ext ν
      rw [MvPolynomial.coeff_C]
      by_cases h : ν = 0
      · subst h
        rw [MvPowerSeries.coeff_truncTotal _ (by simp), if_pos rfl,
          MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
      · have h' : Finsupp.degree ν ≠ 0 := fun h0 => h ((Finsupp.degree_eq_zero_iff ν).mp h0)
        rw [MvPowerSeries.coeff_truncTotal_eq_zero _ (by omega), if_neg (Ne.symm h)]
    rw [htr, MvPolynomial.aeval_C, Ideal.Quotient.eq, pow_one, hI, RingHom.mem_ker, map_sub,
      AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_eq_zero] at h1
    exact h1
  exact ⟨d, θ, hflat, hcc⟩

theorem wc_cpp_flat_power_series_chart : ∀ (A R : Type u) [CommRing A] [CommRing R] [IsNoetherianRing A] (ψ : A →+* R), ψ.Smooth → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (𝔮 : Ideal R) [𝔮.IsPrime], 𝔮.comap ψ = 𝔭 → (∀ Q : Ideal R, Q.IsPrime → 𝔮 ≤ Q → Q.comap ψ = 𝔭 → Q = 𝔮) → ∃ (A' : Type u) (_ : CommRing A') (_ : IsLocalRing A') (_ : IsNoetherianRing A') (e : ℕ) (α : A →+* A') (β : R →+* MvPowerSeries (Fin e) A'), α.Flat ∧ β.Flat ∧ β.comp ψ = (MvPowerSeries.C (σ := Fin e) (R := A')).comp α ∧ (IsLocalRing.maximalIdeal A').comap α = 𝔭 ∧ (∀ P : Ideal A', P.IsPrime → P.comap α = 𝔭 → P = IsLocalRing.maximalIdeal A') ∧ (IsLocalRing.maximalIdeal (MvPowerSeries (Fin e) A')).comap β = 𝔮 :=
by
  intro A R _ _ _ ψ hψ 𝔭 _ 𝔮 _ hq hcl
  classical

  have hψft : ψ.FiniteType := RingHom.FiniteType.of_finitePresentation hψ.finitePresentation

  have hφfin := wc_fpc_residue_field_finite A R ψ hψft 𝔭 𝔮 hq hcl

  obtain ⟨ρ₀, hρ₀⟩ : ∃ ρ₀ : Localization.AtPrime 𝔭 →+* 𝔮.ResidueField,
      ρ₀ = (Ideal.ResidueField.map 𝔭 𝔮 ψ hq.symm).comp
        (IsLocalRing.residue (Localization.AtPrime 𝔭)) := ⟨_, rfl⟩
  have hρ₀fin : ρ₀.Finite := by
    rw [hρ₀]
    exact RingHom.Finite.comp hφfin
      (RingHom.Finite.of_surjective _ IsLocalRing.residue_surjective)
  have hρ₀ker : RingHom.ker ρ₀ = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) := by
    ext x
    rw [RingHom.mem_ker, hρ₀, RingHom.comp_apply,
      map_eq_zero_iff _ (Ideal.ResidueField.map 𝔭 𝔮 ψ hq.symm).injective,
      IsLocalRing.residue_eq_zero_iff]

  obtain ⟨A₁, _, _, _, _, ρ₁, hA₁flat, hρ₁surj, hρ₁ker, hρ₁comp, hA₁uniq⟩ :=
    wc_fpc_finite_residue_tower (Localization.AtPrime 𝔭) 𝔮.ResidueField ρ₀ hρ₀fin hρ₀ker
  obtain ⟨α₁, hα₁⟩ : ∃ α₁ : A →+* A₁,
      α₁ = (algebraMap (Localization.AtPrime 𝔭) A₁).comp
        (algebraMap A (Localization.AtPrime 𝔭)) := ⟨_, rfl⟩
  have hα₁flat : α₁.Flat := by
    rw [hα₁]
    exact RingHom.Flat.comp
      (RingHom.flat_algebraMap_iff.mpr (IsLocalization.flat (Localization.AtPrime 𝔭) 𝔭.primeCompl))
      (RingHom.flat_algebraMap_iff.mpr hA₁flat)
  have hα₁sq : ρ₁.comp α₁ = (algebraMap R 𝔮.ResidueField).comp ψ := by
    refine RingHom.ext fun x => ?_
    rw [hα₁, RingHom.comp_apply, RingHom.comp_apply, ← RingHom.comp_apply ρ₁, hρ₁comp, hρ₀,
      RingHom.comp_apply, RingHom.comp_apply]
    exact Ideal.ResidueField.map_algebraMap 𝔭 𝔮 ψ hq.symm x
  have hA₁uniq' : ∀ P : Ideal A₁, P.IsPrime → P.comap α₁ = 𝔭 →
      P = IsLocalRing.maximalIdeal A₁ := by
    intro P hP hPc
    apply hA₁uniq P hP
    have h1 : (P.comap (algebraMap (Localization.AtPrime 𝔭) A₁)).comap
        (algebraMap A (Localization.AtPrime 𝔭)) = 𝔭 := by
      rw [Ideal.comap_comap, ← hα₁]
      exact hPc
    calc P.comap (algebraMap (Localization.AtPrime 𝔭) A₁)
        = Ideal.map (algebraMap A (Localization.AtPrime 𝔭))
            ((P.comap (algebraMap (Localization.AtPrime 𝔭) A₁)).comap
              (algebraMap A (Localization.AtPrime 𝔭))) :=
          (IsLocalization.map_under 𝔭.primeCompl (Localization.AtPrime 𝔭) _).symm
      _ = Ideal.map (algebraMap A (Localization.AtPrime 𝔭)) 𝔭 := by rw [h1]
      _ = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) :=
          Localization.AtPrime.map_eq_maximalIdeal

  obtain ⟨A', _, _, _, _, _, ρ', hA'flat, hρ'surj, hρ'ker, hρ'comp, hA'uniq⟩ :=
    wc_fpc_henselian_completion A₁ 𝔮.ResidueField ρ₁ hρ₁surj hρ₁ker

  obtain ⟨α, hα⟩ : ∃ α : A →+* A', α = (algebraMap A₁ A').comp α₁ := ⟨_, rfl⟩
  have hαflat : α.Flat := by
    rw [hα]
    exact RingHom.Flat.comp hα₁flat (RingHom.flat_algebraMap_iff.mpr hA'flat)
  have hαsq : ρ'.comp α = (algebraMap R 𝔮.ResidueField).comp ψ := by
    rw [← hα₁sq, ← hρ'comp, hα]
    rfl
  have hmA : (IsLocalRing.maximalIdeal A').comap α = 𝔭 := by
    ext y
    rw [Ideal.mem_comap, ← hρ'ker, RingHom.mem_ker, ← RingHom.comp_apply ρ' α y, hαsq,
      RingHom.comp_apply, Ideal.algebraMap_residueField_eq_zero, ← Ideal.mem_comap, hq]
  have huniq : ∀ P : Ideal A', P.IsPrime → P.comap α = 𝔭 →
      P = IsLocalRing.maximalIdeal A' := by
    intro P hP hPc
    apply hA'uniq P hP
    haveI := hP
    apply hA₁uniq' _ (Ideal.IsPrime.comap _)
    rw [Ideal.comap_comap, ← hα]
    exact hPc

  letI : Algebra A R := ψ.toAlgebra
  letI : Algebra A A' := α.toAlgebra
  haveI : Module.Flat A A' := hαflat
  haveI : Algebra.Smooth A R := hψ
  haveI : Algebra.Smooth A' (TensorProduct A A' R) := Algebra.Smooth.baseChange A R A'
  obtain ⟨ε, hε⟩ : ∃ ε : IsLocalRing.ResidueField A' ≃+* 𝔮.ResidueField,
      ∀ h : A', ε (IsLocalRing.residue A' h) = ρ' h := by
    refine ⟨(Ideal.quotEquivOfEq hρ'ker.symm).trans
      (RingHom.quotientKerEquivOfSurjective hρ'surj), fun h => ?_⟩
    show (RingHom.quotientKerEquivOfSurjective hρ'surj)
      (Ideal.quotEquivOfEq hρ'ker.symm (Ideal.Quotient.mk _ h)) = ρ' h
    rw [Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]
  have hgA : ∀ a : A, ε.symm (algebraMap R 𝔮.ResidueField (ψ a)) =
      algebraMap A (IsLocalRing.ResidueField A') a := by
    intro a
    have h1 : algebraMap R 𝔮.ResidueField (ψ a) = ε (IsLocalRing.residue A' (α a)) := by
      rw [hε]
      exact (RingHom.congr_fun hαsq a).symm
    rw [h1, RingEquiv.symm_apply_apply, IsScalarTower.algebraMap_apply A A'
      (IsLocalRing.ResidueField A'), IsLocalRing.ResidueField.algebraMap_eq]
    rfl
  let g : R →ₐ[A] IsLocalRing.ResidueField A' :=
    { toRingHom := ε.symm.toRingHom.comp (algebraMap R 𝔮.ResidueField)
      commutes' := fun a => hgA a }
  let σ : TensorProduct A A' R →ₐ[A'] IsLocalRing.ResidueField A' :=
    Algebra.TensorProduct.lift (Algebra.ofId A' _) g (fun _ _ => Commute.all _ _)
  have hσ : ∀ r : R, σ ((1 : A') ⊗ₜ[A] r) = ε.symm (algebraMap R 𝔮.ResidueField r) := by
    intro r
    show Algebra.TensorProduct.lift (Algebra.ofId A' _) g (fun _ _ => Commute.all _ _)
      ((1 : A') ⊗ₜ[A] r) = _
    rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    rfl
  obtain ⟨τ, hτ⟩ := wc_hnas_smooth_section_henselian A' (TensorProduct A A' R) σ
  obtain ⟨e, θ, hθflat, hθcc⟩ := wc_fpc_section_power_series A' (TensorProduct A A' R) τ
  obtain ⟨β, hβ⟩ : ∃ β : R →+* MvPowerSeries (Fin e) A',
      β = θ.toRingHom.comp
        (Algebra.TensorProduct.includeRight : R →ₐ[A] TensorProduct A A' R).toRingHom :=
    ⟨_, rfl⟩
  have hβr : ∀ r : R, β r = θ ((1 : A') ⊗ₜ[A] r) := by
    intro r
    rw [hβ]
    rfl
  have hinc : (Algebra.TensorProduct.includeRight : R →ₐ[A] TensorProduct A A' R).toRingHom =
      (Algebra.TensorProduct.comm A R A').toRingEquiv.toRingHom.comp
        (algebraMap R (TensorProduct A R A')) := by
    refine RingHom.ext fun r => ?_
    show (1 : A') ⊗ₜ[A] r =
      Algebra.TensorProduct.comm A R A' (algebraMap R (TensorProduct A R A') r)
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      Algebra.TensorProduct.comm_tmul]
  have hincflat :
      (Algebra.TensorProduct.includeRight : R →ₐ[A] TensorProduct A A' R).toRingHom.Flat := by
    rw [hinc]
    exact RingHom.Flat.comp (RingHom.flat_algebraMap_iff.mpr inferInstance)
      (RingHom.Flat.of_bijective (Algebra.TensorProduct.comm A R A').bijective)
  have hβflat : β.Flat := by
    rw [hβ]
    exact RingHom.Flat.comp hincflat hθflat
  have hsq : β.comp ψ = (MvPowerSeries.C (σ := Fin e) (R := A')).comp α := by
    refine RingHom.ext fun x => ?_
    rw [RingHom.comp_apply, hβr, RingHom.comp_apply]
    have h1 : (1 : A') ⊗ₜ[A] ψ x = algebraMap A' (TensorProduct A A' R) (α x) := by
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
      exact (Algebra.TensorProduct.tmul_one_eq_one_tmul x).symm
    rw [h1, AlgHom.commutes, MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply]
  have hcomap : (IsLocalRing.maximalIdeal (MvPowerSeries (Fin e) A')).comap β = 𝔮 := by
    ext r
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      MvPowerSeries.isUnit_iff_constantCoeff, ← IsLocalRing.notMem_maximalIdeal, not_not,
      ← IsLocalRing.residue_eq_zero_iff, hβr, hθcc, hτ, hσ,
      map_eq_zero_iff _ ε.symm.injective, Ideal.algebraMap_residueField_eq_zero]
  exact ⟨A', inferInstance, inferInstance, inferInstance, e, α, β, hαflat, hβflat, hsq, hmA,
    huniq, hcomap⟩

theorem wc_cfp_mvPowerSeries_flat : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (e : ℕ), Module.Flat A (MvPowerSeries (Fin e) A) :=
by
  intro A _ _ e
  apply Module.Flat.of_forall_isTrivialRelation
  intro l f x hrel
  have hcoef : ∀ n : Fin e →₀ ℕ, ∑ i, f i * MvPowerSeries.coeff n (x i) = 0 := by
    intro n
    have h := congrArg (MvPowerSeries.coeff (R := A) n) hrel
    simpa [map_sum, MvPowerSeries.coeff_smul] using h
  set L : (Fin l → A) →ₗ[A] A := Fintype.linearCombination A f with hL
  have hLapp : ∀ v : Fin l → A, L v = ∑ i, f i * v i := by
    intro v
    rw [hL, Fintype.linearCombination_apply]
    exact Finset.sum_congr rfl (fun i _ => by rw [smul_eq_mul, mul_comm])
  have hfg : (LinearMap.ker L).FG := IsNoetherian.noetherian _
  obtain ⟨k, y, hspan⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hmem : ∀ n : Fin e →₀ ℕ,
      (fun i => MvPowerSeries.coeff n (x i)) ∈ Submodule.span A (Set.range y) := by
    intro n
    rw [hspan, LinearMap.mem_ker, hLapp]
    exact hcoef n
  choose c hc using fun n => (Submodule.mem_span_range_iff_exists_fun A).mp (hmem n)
  have hy : ∀ j, ∑ i, f i * y j i = 0 := by
    intro j
    have hj : y j ∈ LinearMap.ker L := hspan ▸ Submodule.subset_span ⟨j, rfl⟩
    rw [LinearMap.mem_ker, hLapp] at hj
    exact hj
  refine ⟨k, fun i j => y j i, fun j => (fun n => c n j : (Fin e →₀ ℕ) → A), ?_, hy⟩
  intro i
  ext n
  have h := congrFun (hc n) i
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at h
  rw [map_sum]
  simp only [MvPowerSeries.coeff_smul]
  rw [← h]
  exact Finset.sum_congr rfl (fun j _ => by rw [mul_comm]; rfl)

theorem wc_rh_chart_regular : ∀ (A : Type u) [CommRing A] (C₀ : Type u) [CommRing C₀] [Algebra A C₀] (a c : A), IsSMulRegular A c → wcCg2LocEtale (algebraMap A C₀) (Submonoid.powers a) → ∀ u : Localization ((Submonoid.powers a).map (algebraMap A C₀)), algebraMap A (Localization ((Submonoid.powers a).map (algebraMap A C₀))) c * u = 0 → u = 0 :=
by
  intro A _ C₀ _ _ a c hc hE u hu
  unfold wcCg2LocEtale at hE
  set M := Submonoid.powers a with hM
  set Ca := Localization (M.map (algebraMap A C₀)) with hCa
  set φ : Localization M →+* Ca :=
    IsLocalization.map Ca (algebraMap A C₀) M.le_comap_map with hφdef
  have hφ : φ.Flat :=
    RingHom.Smooth.flat ((RingHom.etale_iff_formallyUnramified_and_smooth φ).mp hE).2
  have h1 : IsSMulRegular (Localization M) (algebraMap A (Localization M) c) :=
    IsSMulRegular.of_flat hc
  letI : Algebra (Localization M) Ca := φ.toAlgebra
  haveI : Module.Flat (Localization M) Ca := hφ
  have h2 : IsSMulRegular Ca
      (algebraMap (Localization M) Ca (algebraMap A (Localization M) c)) :=
    IsSMulRegular.of_flat h1
  have hkey : algebraMap (Localization M) Ca (algebraMap A (Localization M) c) =
      algebraMap A Ca c := by
    rw [RingHom.algebraMap_toAlgebra, hφdef, IsLocalization.map_eq,
      IsScalarTower.algebraMap_apply A C₀ Ca c]
  exact h2.right_eq_zero_of_smul (by rw [Algebra.smul_def, hkey]; exact hu)

theorem wc_rh_chart_dual_separates : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (C₀ : Type u) [CommRing C₀] [Algebra A C₀] [Module.Finite A C₀] (a : A), wcCg2LocEtale (algebraMap A C₀) (Submonoid.powers a) → ∀ y : C₀, (∀ φ : Module.Dual A C₀, φ y = 0) → algebraMap C₀ (Localization ((Submonoid.powers a).map (algebraMap A C₀))) y = 0 :=
by
  intro A _ _ C₀ _ _ _ a hEt y hy
  classical
  let φa : Localization (Submonoid.powers a) →+*
      Localization ((Submonoid.powers a).map (algebraMap A C₀)) :=
    IsLocalization.map (Localization ((Submonoid.powers a).map (algebraMap A C₀)))
      (algebraMap A C₀) (Submonoid.powers a).le_comap_map
  letI : Algebra (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap A C₀))) := φa.toAlgebra
  haveI hE : Algebra.Etale (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap A C₀))) := hEt
  haveI hF : Module.Finite (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap A C₀))) :=
    RingHom.finite_localizationPreserves (algebraMap A C₀) (Submonoid.powers a)
      (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap A C₀)))
      (RingHom.finite_algebraMap.mpr inferInstance)
  haveI : Module.FinitePresentation (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap A C₀))) :=
    Module.finitePresentation_of_finite _ _
  haveI : Module.Projective (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap A C₀))) :=
    Module.Flat.projective_of_finitePresentation
  by_contra hne
  have hex : ¬ ∀ ψ : Module.Dual (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap A C₀))),
      ψ (algebraMap C₀ (Localization ((Submonoid.powers a).map (algebraMap A C₀))) y) = 0 := by
    rwa [Module.forall_dual_apply_eq_zero_iff]
  push_neg at hex
  obtain ⟨ψ, hψ⟩ := hex
  have key : ∀ r : A, φa (algebraMap A (Localization (Submonoid.powers a)) r) =
      algebraMap C₀ (Localization ((Submonoid.powers a).map (algebraMap A C₀)))
        (algebraMap A C₀ r) :=
    fun r => IsLocalization.map_eq _ _
  have hsm : ∀ (q : Localization (Submonoid.powers a))
      (z : Localization ((Submonoid.powers a).map (algebraMap A C₀))), φa q * z = q • z := by
    intro q z
    rw [Algebra.smul_def]
    rfl
  let g : C₀ →ₗ[A] Localization (Submonoid.powers a) :=
    { toFun := fun x => ψ (algebraMap C₀
        (Localization ((Submonoid.powers a).map (algebraMap A C₀))) x)
      map_add' := fun x z => by simp only [map_add]
      map_smul' := fun r x => by
        simp only [RingHom.id_apply]
        rw [Algebra.smul_def r x, map_mul, ← key r, hsm, ψ.map_smul, smul_eq_mul,
          Algebra.smul_def r] }
  haveI : Module.FinitePresentation A C₀ := Module.finitePresentation_of_finite _ _
  obtain ⟨h, s, hhs⟩ := Module.FinitePresentation.exists_lift_of_isLocalizedModule
    (Submonoid.powers a) (Algebra.linearMap A (Localization (Submonoid.powers a))) g
  have e := LinearMap.congr_fun hhs y
  rw [LinearMap.comp_apply, Algebra.linearMap_apply, hy h, map_zero, LinearMap.smul_apply,
    Submonoid.smul_def, Algebra.smul_def] at e
  have hu := IsLocalization.map_units (Localization (Submonoid.powers a)) s
  exact hψ ((hu.mul_right_eq_zero).mp e.symm)

theorem wc_rh_finite_of_charts : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (a b : A), wcCg2HP A A a b → ∀ (M N : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M] [AddCommGroup N] [Module A N] (κ : M →ₗ[A] N), (∀ x : N, ∃ (n : ℕ) (y : M), a ^ n • x = κ y) → (∀ x : N, ∃ (m : ℕ) (z : M), b ^ m • x = κ z) → (∀ y : M, κ y = 0 → ∃ k : ℕ, a ^ k • y = 0) → (∀ x : N, (∀ (n : ℕ) (y : M), a ^ n • x = κ y → ∀ φ : Module.Dual A M, φ y = 0) → (∀ (m : ℕ) (z : M), b ^ m • x = κ z → ∀ φ : Module.Dual A M, φ z = 0) → x = 0) → Module.Finite A N :=
by
  intro A _ _ a b hHP M N _ _ _ _ _ κ h1 h2 h3 h4
  obtain ⟨ra, _, W⟩ := hHP
  have canc : ∀ (k : ℕ) (x y : A), a ^ k * x = a ^ k * y → x = y := by
    intro k x y h
    exact (IsSMulRegular.pow k ra) (show a ^ k • x = a ^ k • y by simpa only [smul_eq_mul] using h)
  have W' : ∀ m n : A, b * m = a * n → ∃ k, m = a * k := by
    intro m n h
    obtain ⟨k, hk⟩ := W m n (by simpa only [smul_eq_mul] using h)
    exact ⟨k, by simpa only [smul_eq_mul] using hk⟩
  have C : ∀ (j : ℕ) (s q : A), b ^ j * s = a * q → ∃ k, s = a * k := by
    intro j
    induction j with
    | zero => intro s q h; exact ⟨q, by simpa using h⟩
    | succ j ih =>
      intro s q h
      obtain ⟨k', hk'⟩ := ih (b * s) q (by rw [← mul_assoc, ← pow_succ]; exact h)
      exact W' s k' hk'
  have H : ∀ (i j : ℕ) (p q : A), b ^ j * p = a ^ i * q →
      ∃ t, p = a ^ i * t ∧ q = b ^ j * t := by
    intro i
    induction i with
    | zero => intro j p q h; exact ⟨p, by simp, by simpa using h.symm⟩
    | succ i ih =>
      intro j p q h
      obtain ⟨t', hp, hq⟩ := ih j p (a * q) (by rw [h, pow_succ, mul_assoc])
      obtain ⟨s, hs⟩ := C j t' q hq.symm
      refine ⟨s, by rw [hp, hs, pow_succ, mul_assoc], ?_⟩
      apply canc 1
      rw [pow_one, hq, hs]; ring
  have cross : ∀ (c d : A) (x : N) (y z : M), d • x = κ y → c • x = κ z →
      ∀ φ : Module.Dual A M, c * φ y = d * φ z := by
    intro c d x y z hy hz φ
    have hk : κ (c • y - d • z) = 0 := by
      rw [map_sub, map_smul, map_smul, ← hy, ← hz, smul_smul, smul_smul, mul_comm c d, sub_self]
    obtain ⟨k, hk'⟩ := h3 _ hk
    have := congrArg φ hk'
    simp only [map_smul, map_zero, map_sub, smul_eq_mul] at this
    have h0 : c * φ y - d * φ z = 0 := by
      apply canc k
      rw [this, mul_zero]
    exact sub_eq_zero.mp h0
  have val : ∀ (x : N) (φ : Module.Dual A M), ∃ t : A,
      (∀ (n : ℕ) (y : M), a ^ n • x = κ y → φ y = a ^ n * t) ∧
      (∀ (m : ℕ) (z : M), b ^ m • x = κ z → φ z = b ^ m * t) := by
    intro x φ
    obtain ⟨n₀, y₀, hy₀⟩ := h1 x
    obtain ⟨m₀, z₀, hz₀⟩ := h2 x
    obtain ⟨t, ht1, _⟩ := H n₀ m₀ (φ y₀) (φ z₀) (cross _ _ x y₀ z₀ hy₀ hz₀ φ)
    refine ⟨t, ?_, ?_⟩
    · intro n y hy
      have e := cross _ _ x y₀ y hy₀ hy φ
      apply canc n₀
      rw [← e, ht1]; ring
    · intro m z hz
      have e := cross _ _ x y₀ z hy₀ hz φ
      apply canc n₀
      rw [← e, ht1]; ring
  choose v hva hvb using val
  have uniq : ∀ (x : N) (φ : Module.Dual A M) (n : ℕ) (y : M) (t : A),
      a ^ n • x = κ y → φ y = a ^ n * t → v x φ = t := by
    intro x φ n y t hy ht
    apply canc n
    rw [← hva x φ n y hy, ht]
  let L : N →ₗ[A] Module.Dual A M →ₗ[A] A := LinearMap.mk₂ A v
    (fun x x' φ => by
      obtain ⟨n, y, hy⟩ := h1 x
      obtain ⟨n', y', hy'⟩ := h1 x'
      refine uniq (x + x') φ (n + n') (a ^ n' • y + a ^ n • y') _ ?_ ?_
      · rw [map_add, map_smul, map_smul, ← hy, ← hy', smul_smul, smul_smul, smul_add, pow_add,
          mul_comm (a ^ n') (a ^ n)]
      · rw [map_add, map_smul, map_smul, hva x φ n y hy, hva x' φ n' y' hy']
        simp only [smul_eq_mul, pow_add]; ring)
    (fun c x φ => by
      obtain ⟨n, y, hy⟩ := h1 x
      refine uniq (c • x) φ n (c • y) _ ?_ ?_
      · rw [map_smul, ← hy, smul_comm]
      · rw [map_smul, hva x φ n y hy]
        simp only [smul_eq_mul]; ring)
    (fun x φ φ' => by
      obtain ⟨n, y, hy⟩ := h1 x
      refine uniq x (φ + φ') n y _ hy ?_
      rw [LinearMap.add_apply, hva x φ n y hy, hva x φ' n y hy]; ring)
    (fun c x φ => by
      obtain ⟨n, y, hy⟩ := h1 x
      refine uniq x (c • φ) n y _ hy ?_
      rw [LinearMap.smul_apply, hva x φ n y hy]
      simp only [smul_eq_mul]; ring)
  have hL : ∀ x φ, L x φ = v x φ := fun x φ => rfl
  have hinj : Function.Injective L := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    have hv0 : ∀ φ, v x φ = 0 := fun φ => by rw [← hL, hx, LinearMap.zero_apply]
    apply h4 x
    · intro n y hy φ; rw [hva x φ n y hy, hv0, mul_zero]
    · intro m z hz φ; rw [hvb x φ m z hz, hv0, mul_zero]
  exact Module.Finite.of_injective L hinj

theorem wc_rh_locEtale_of_chart_iso : ∀ (A : Type u) [CommRing A] (C₀ D : Type u) [CommRing C₀] [Algebra A C₀] [CommRing D] [Algebra A D] (a : A) (κ : C₀ →ₐ[A] D), (∀ x : D, ∃ (n : ℕ) (y : C₀), a ^ n • x = κ y) → (∀ y : C₀, κ y = 0 → ∃ n : ℕ, a ^ n • y = 0) → wcCg2LocEtale (algebraMap A C₀) (Submonoid.powers a) → wcCg2LocEtale (algebraMap A D) (Submonoid.powers a) :=
by
  intro A _ C₀ D _ _ _ _ a κ h1 h2 h
  unfold wcCg2LocEtale at h ⊢
  have hle : (Submonoid.powers a).map (algebraMap A C₀) ≤
      ((Submonoid.powers a).map (algebraMap A D)).comap (κ : C₀ →+* D) := by
    rintro _ ⟨p, hp, rfl⟩
    rw [Submonoid.mem_comap]
    exact Submonoid.mem_map.mpr ⟨p, hp, by simp⟩
  set κa : Localization ((Submonoid.powers a).map (algebraMap A C₀)) →+*
      Localization ((Submonoid.powers a).map (algebraMap A D)) :=
    IsLocalization.map (Localization ((Submonoid.powers a).map (algebraMap A D)))
      (κ : C₀ →+* D) hle with hκa
  have hsurj : Function.Surjective κa := by
    intro ξ
    obtain ⟨⟨x, s⟩, hxs⟩ := IsLocalization.surj ((Submonoid.powers a).map (algebraMap A D)) ξ
    obtain ⟨p, hp, hps⟩ := Submonoid.mem_map.mp s.2
    obtain ⟨m, rfl⟩ := hp
    obtain ⟨n, y, hy⟩ := h1 x
    have hmem : algebraMap A C₀ (a ^ (n + m)) ∈ (Submonoid.powers a).map (algebraMap A C₀) :=
      Submonoid.mem_map.mpr ⟨a ^ (n + m), ⟨n + m, rfl⟩, rfl⟩
    refine ⟨IsLocalization.mk' (Localization ((Submonoid.powers a).map (algebraMap A C₀))) y
      ⟨_, hmem⟩, ?_⟩
    rw [hκa, IsLocalization.map_mk', IsLocalization.mk'_eq_iff_eq_mul]
    simp only at hxs ⊢
    simp only [AlgHom.coe_toRingHom, AlgHom.commutes]
    rw [← hps] at hxs
    rw [← hy, Algebra.smul_def]
    simp only [pow_add, map_mul]
    beta_reduce at hxs
    linear_combination (-(algebraMap D (Localization ((Submonoid.powers a).map (algebraMap A D)))
      (algebraMap A D (a ^ n)))) * hxs
  have hinj : Function.Injective κa := by
    rw [injective_iff_map_eq_zero]
    intro η hη
    obtain ⟨⟨y, t⟩, rfl⟩ :=
      IsLocalization.mk'_surjective ((Submonoid.powers a).map (algebraMap A C₀)) η
    rw [hκa, IsLocalization.map_mk', IsLocalization.mk'_eq_zero_iff] at hη
    obtain ⟨⟨μ, hμ⟩, hμy⟩ := hη
    obtain ⟨p, hp, rfl⟩ := Submonoid.mem_map.mp hμ
    obtain ⟨k, rfl⟩ := hp
    simp only [AlgHom.coe_toRingHom] at hμy
    have hk : κ (a ^ k • y) = 0 := by
      rw [Algebra.smul_def, map_mul, AlgHom.commutes]
      exact hμy
    obtain ⟨j, hj⟩ := h2 _ hk
    rw [smul_smul, ← pow_add, Algebra.smul_def] at hj
    rw [IsLocalization.mk'_eq_zero_iff]
    exact ⟨⟨_, Submonoid.mem_map.mpr
      ⟨a ^ (j + k), ⟨j + k, rfl⟩, rfl⟩⟩, hj⟩
  have hkey : (RingEquiv.ofBijective κa ⟨hinj, hsurj⟩).toRingHom.comp
      (IsLocalization.map (Localization ((Submonoid.powers a).map (algebraMap A C₀)))
        (algebraMap A C₀) (Submonoid.powers a).le_comap_map :
        Localization (Submonoid.powers a) →+*
          Localization ((Submonoid.powers a).map (algebraMap A C₀))) =
      (IsLocalization.map (Localization ((Submonoid.powers a).map (algebraMap A D)))
        (algebraMap A D) (Submonoid.powers a).le_comap_map :
        Localization (Submonoid.powers a) →+*
          Localization ((Submonoid.powers a).map (algebraMap A D))) := by
    apply IsLocalization.ringHom_ext (Submonoid.powers a)
    ext r
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
      RingEquiv.ofBijective_apply, IsLocalization.map_eq, hκa, AlgHom.coe_toRingHom,
      AlgHom.commutes]
  have hE := RingHom.Etale.respectsIso.1 _ (RingEquiv.ofBijective κa ⟨hinj, hsurj⟩) h
  rw [hkey] at hE
  exact hE

theorem wc_rh_two_chart_glue : ∀ (A : Type u) [CommRing A] (a b : A) (C₀ : Type u) [CommRing C₀] [Algebra A C₀], (∀ u : Localization ((Submonoid.powers a).map (algebraMap A C₀)), algebraMap A (Localization ((Submonoid.powers a).map (algebraMap A C₀))) b * u = 0 → u = 0) → (∀ v : Localization ((Submonoid.powers b).map (algebraMap A C₀)), algebraMap A (Localization ((Submonoid.powers b).map (algebraMap A C₀))) a * v = 0 → v = 0) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra A D), wcCg2HP A D a b ∧ ∃ κ : C₀ →ₐ[A] D, (∀ x : D, ∃ (n : ℕ) (y : C₀), a ^ n • x = κ y) ∧ (∀ y : C₀, κ y = 0 → ∃ n : ℕ, a ^ n • y = 0) ∧ (∀ x : D, ∃ (n : ℕ) (y : C₀), b ^ n • x = κ y) ∧ (∀ y : C₀, κ y = 0 → ∃ n : ℕ, b ^ n • y = 0) ∧ (∀ x : D, (∀ (n : ℕ) (y : C₀), a ^ n • x = κ y → algebraMap C₀ (Localization ((Submonoid.powers a).map (algebraMap A C₀))) y = 0) → (∀ (m : ℕ) (z : C₀), b ^ m • x = κ z → algebraMap C₀ (Localization ((Submonoid.powers b).map (algebraMap A C₀))) z = 0) → x = 0) :=
by
  intro A _ a b C₀ _ _ hRb hRa
  classical

  have s1 : ∀ r : A,
      IsUnit (algebraMap A (Localization ((Submonoid.powers r).map (algebraMap A C₀))) r) ∧
      (∀ u : Localization ((Submonoid.powers r).map (algebraMap A C₀)), ∃ (n : ℕ) (y : C₀),
        algebraMap A (Localization ((Submonoid.powers r).map (algebraMap A C₀))) r ^ n * u =
          algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀))) y) ∧
      (∀ y : C₀, algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀))) y = 0 →
        ∃ n : ℕ, r ^ n • y = 0) := by
    intro r
    have hmem : ∀ s ∈ (Submonoid.powers r).map (algebraMap A C₀),
        ∃ k : ℕ, algebraMap A C₀ (r ^ k) = s := by
      intro s hs
      obtain ⟨x, hx, rfl⟩ := Submonoid.mem_map.mp hs
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hx
      exact ⟨k, rfl⟩
    have htow : ∀ x : A, algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀)))
        (algebraMap A C₀ x) = algebraMap A (Localization ((Submonoid.powers r).map (algebraMap A C₀))) x :=
      fun x => (IsScalarTower.algebraMap_apply A C₀ _ x).symm
    refine ⟨?_, ?_, ?_⟩
    · have h1 : algebraMap A C₀ r ∈ (Submonoid.powers r).map (algebraMap A C₀) :=
        Submonoid.mem_map_of_mem _ (Submonoid.mem_powers r)
      have h2 := IsLocalization.map_units (Localization ((Submonoid.powers r).map (algebraMap A C₀)))
        (⟨_, h1⟩ : (Submonoid.powers r).map (algebraMap A C₀))
      have h3 : IsUnit (algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀)))
          (algebraMap A C₀ r)) := h2
      rwa [htow] at h3
    · intro u
      obtain ⟨⟨y, ⟨s, hs⟩⟩, hys⟩ := IsLocalization.surj ((Submonoid.powers r).map (algebraMap A C₀)) u
      have hys' : u * algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀))) s =
          algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀))) y := hys
      obtain ⟨k, hk⟩ := hmem s hs
      refine ⟨k, y, ?_⟩
      rw [← hys', ← hk, htow, map_pow, mul_comm]
    · intro y hy
      obtain ⟨⟨m, hm⟩, hm0⟩ := (IsLocalization.map_eq_zero_iff
        ((Submonoid.powers r).map (algebraMap A C₀)) _ y).mp hy
      obtain ⟨k, hk⟩ := hmem m hm
      refine ⟨k, ?_⟩
      rw [Algebra.smul_def, hk]
      exact hm0

  have s2 : ∀ (r s t : A), t = r * s →
      (∀ u : Localization ((Submonoid.powers r).map (algebraMap A C₀)),
        algebraMap A (Localization ((Submonoid.powers r).map (algebraMap A C₀))) s * u = 0 → u = 0) →
      ∃ ι : Localization ((Submonoid.powers r).map (algebraMap A C₀)) →ₐ[A]
          Localization ((Submonoid.powers t).map (algebraMap A C₀)),
        (∀ y : C₀, ι (algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀))) y) =
          algebraMap C₀ (Localization ((Submonoid.powers t).map (algebraMap A C₀))) y) ∧
        ∀ u, ι u = 0 → u = 0 := by
    intro r s t ht hreg
    subst ht
    obtain ⟨hut, -, -⟩ := s1 (r * s)
    obtain ⟨hρ, -, -⟩ := s1 r
    have hur : IsUnit (algebraMap A (Localization ((Submonoid.powers (r * s)).map (algebraMap A C₀))) r) := by
      rw [map_mul] at hut
      exact isUnit_of_mul_isUnit_left hut
    have hf : ∀ y : ↥((Submonoid.powers r).map (algebraMap A C₀)),
        IsUnit (IsScalarTower.toAlgHom A C₀
          (Localization ((Submonoid.powers (r * s)).map (algebraMap A C₀))) (y : C₀)) := by
      rintro ⟨y, hy⟩
      obtain ⟨x, hx, rfl⟩ := Submonoid.mem_map.mp hy
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hx
      show IsUnit (IsScalarTower.toAlgHom A C₀
          (Localization ((Submonoid.powers (r * s)).map (algebraMap A C₀))) (algebraMap A C₀ (r ^ k)))
      rw [IsScalarTower.toAlgHom_apply, ← IsScalarTower.algebraMap_apply A C₀, map_pow]
      exact hur.pow k
    obtain ⟨ι, hι⟩ : ∃ ι : Localization ((Submonoid.powers r).map (algebraMap A C₀)) →ₐ[A]
        Localization ((Submonoid.powers (r * s)).map (algebraMap A C₀)),
        ∀ y : C₀, ι (algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀))) y) =
          algebraMap C₀ (Localization ((Submonoid.powers (r * s)).map (algebraMap A C₀))) y := by
      refine ⟨IsLocalization.liftAlgHom hf, fun y => ?_⟩
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl
    refine ⟨ι, hι, ?_⟩
    intro w hw
    have hind : ∀ k : ℕ,
        algebraMap A (Localization ((Submonoid.powers r).map (algebraMap A C₀))) s ^ k * w = 0 →
          w = 0 := by
      intro k
      induction k with
      | zero => intro h; simpa using h
      | succ k ih =>
        intro h
        apply ih
        apply hreg
        rw [← mul_assoc, ← pow_succ']
        exact h
    obtain ⟨⟨z, ⟨m₀, hm₀⟩⟩, hz⟩ := IsLocalization.surj ((Submonoid.powers r).map (algebraMap A C₀)) w
    have hz' : w * algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀))) m₀ =
        algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀))) z := hz
    have hu0 : IsUnit (algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀))) m₀) :=
      IsLocalization.map_units (Localization ((Submonoid.powers r).map (algebraMap A C₀)))
        (⟨m₀, hm₀⟩ : (Submonoid.powers r).map (algebraMap A C₀))
    have h0 : algebraMap C₀ (Localization ((Submonoid.powers (r * s)).map (algebraMap A C₀))) z = 0 := by
      rw [← hι, ← hz', map_mul, hw, zero_mul]
    obtain ⟨⟨m, hm⟩, hmz⟩ := (IsLocalization.map_eq_zero_iff
      ((Submonoid.powers (r * s)).map (algebraMap A C₀)) _ z).mp h0
    obtain ⟨x, hx, rfl⟩ := Submonoid.mem_map.mp hm
    obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hx
    have hmz' : algebraMap A C₀ ((r * s) ^ k) * z = 0 := hmz
    have h2 := congrArg (algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀)))) hmz'
    rw [map_mul, map_zero, ← IsScalarTower.algebraMap_apply A C₀, ← hz'] at h2
    have h3 : algebraMap A (Localization ((Submonoid.powers r).map (algebraMap A C₀))) r ^ k *
        ((algebraMap A (Localization ((Submonoid.powers r).map (algebraMap A C₀))) s ^ k * w) *
          algebraMap C₀ (Localization ((Submonoid.powers r).map (algebraMap A C₀))) m₀) = 0 := by
      rw [← h2, map_pow, map_mul]
      ring
    have h4 := (hρ.pow k).mul_right_eq_zero.mp h3
    exact hind k (hu0.mul_left_eq_zero.mp h4)

  have main : ∀ (P Q R : Type u) [CommRing P] [CommRing Q] [CommRing R] [Algebra A P] [Algebra A Q]
      [Algebra A R] (p : C₀ →ₐ[A] P) (q : C₀ →ₐ[A] Q) (ι : P →ₐ[A] R) (j : Q →ₐ[A] R),
      (∀ y : C₀, ι (p y) = j (q y)) →
      IsUnit (algebraMap A P a) → IsUnit (algebraMap A Q b) →
      (∀ u : P, algebraMap A P b * u = 0 → u = 0) →
      (∀ v : Q, algebraMap A Q a * v = 0 → v = 0) →
      (∀ u : P, ∃ (n : ℕ) (y : C₀), algebraMap A P a ^ n * u = p y) →
      (∀ v : Q, ∃ (n : ℕ) (z : C₀), algebraMap A Q b ^ n * v = q z) →
      (∀ y : C₀, p y = 0 → ∃ n : ℕ, a ^ n • y = 0) →
      (∀ y : C₀, q y = 0 → ∃ n : ℕ, b ^ n • y = 0) →
      (∀ u : P, ι u = 0 → u = 0) → (∀ v : Q, j v = 0 → v = 0) →
      ∃ (D : Type u) (_ : CommRing D) (_ : Algebra A D), wcCg2HP A D a b ∧ ∃ κ : C₀ →ₐ[A] D,
        (∀ x : D, ∃ (n : ℕ) (y : C₀), a ^ n • x = κ y) ∧
        (∀ y : C₀, κ y = 0 → ∃ n : ℕ, a ^ n • y = 0) ∧
        (∀ x : D, ∃ (n : ℕ) (y : C₀), b ^ n • x = κ y) ∧
        (∀ y : C₀, κ y = 0 → ∃ n : ℕ, b ^ n • y = 0) ∧
        (∀ x : D, (∀ (n : ℕ) (y : C₀), a ^ n • x = κ y → p y = 0) →
          (∀ (m : ℕ) (z : C₀), b ^ m • x = κ z → q z = 0) → x = 0) := by
    intro P Q R _ _ _ _ _ _ p q ι j hsq hua hub hRb' hRa' surja surjb kera kerb hι hj
    let E : Subalgebra A (P × Q) :=
      AlgHom.equalizer (ι.comp (AlgHom.fst A P Q)) (j.comp (AlgHom.snd A P Q))
    have memE : ∀ x : P × Q, x ∈ E ↔ ι x.1 = j x.2 := fun x => AlgHom.mem_equalizer _ _ x
    have hmem : ∀ y : C₀, (p.prod q) y ∈ E := fun y => (memE _).mpr (hsq y)
    let κ : C₀ →ₐ[A] E := AlgHom.codRestrict (p.prod q) E hmem
    have k1 : ∀ x : E, ∃ (n : ℕ) (y : C₀), a ^ n • x = κ y := by
      intro x
      have hx : ι x.1.1 = j x.1.2 := (memE _).mp x.2
      obtain ⟨n, y, hy⟩ := surja x.1.1
      refine ⟨n, y, ?_⟩
      apply Subtype.ext
      refine Prod.ext ?_ ?_
      · show a ^ n • x.1.1 = p y
        rw [Algebra.smul_def, map_pow]
        exact hy
      · show a ^ n • x.1.2 = q y
        rw [Algebra.smul_def, map_pow]
        have h1 : j (algebraMap A Q a ^ n * x.1.2 - q y) = ι (algebraMap A P a ^ n * x.1.1 - p y) := by
          simp only [map_sub, map_mul, map_pow, AlgHom.commutes, hx, hsq]
        have h2 : algebraMap A Q a ^ n * x.1.2 - q y = 0 := by
          apply hj
          rw [h1, hy, sub_self, map_zero]
        exact sub_eq_zero.mp h2
    have k3 : ∀ x : E, ∃ (n : ℕ) (y : C₀), b ^ n • x = κ y := by
      intro x
      have hx : ι x.1.1 = j x.1.2 := (memE _).mp x.2
      obtain ⟨n, y, hy⟩ := surjb x.1.2
      refine ⟨n, y, ?_⟩
      apply Subtype.ext
      refine Prod.ext ?_ ?_
      · show b ^ n • x.1.1 = p y
        rw [Algebra.smul_def, map_pow]
        have h1 : ι (algebraMap A P b ^ n * x.1.1 - p y) = j (algebraMap A Q b ^ n * x.1.2 - q y) := by
          simp only [map_sub, map_mul, map_pow, AlgHom.commutes, hx, hsq]
        have h2 : algebraMap A P b ^ n * x.1.1 - p y = 0 := by
          apply hι
          rw [h1, hy, sub_self, map_zero]
        exact sub_eq_zero.mp h2
      · show b ^ n • x.1.2 = q y
        rw [Algebra.smul_def, map_pow]
        exact hy
    have k2 : ∀ y : C₀, κ y = 0 → ∃ n : ℕ, a ^ n • y = 0 := by
      intro y hy
      apply kera
      exact congrArg (fun z : E => (z : P × Q).1) hy
    have k4 : ∀ y : C₀, κ y = 0 → ∃ n : ℕ, b ^ n • y = 0 := by
      intro y hy
      apply kerb
      exact congrArg (fun z : E => (z : P × Q).2) hy
    have hHP : wcCg2HP A E a b := by
      unfold wcCg2HP
      refine ⟨?_, ?_, ?_⟩
      · intro x y hxy
        have h1 : a • x = a • y := hxy
        have h1' := congrArg (fun z : E => (z : P × Q)) h1
        have e1 : a • x.1.1 = a • y.1.1 := congrArg Prod.fst h1'
        have e2 : a • x.1.2 = a • y.1.2 := congrArg Prod.snd h1'
        rw [Algebra.smul_def, Algebra.smul_def] at e1 e2
        apply Subtype.ext
        refine Prod.ext ?_ ?_
        · exact hua.mul_left_cancel e1
        · exact sub_eq_zero.mp (hRa' _ (by rw [mul_sub, e2, sub_self]))
      · intro x y hxy
        have h1 : b • x = b • y := hxy
        have h1' := congrArg (fun z : E => (z : P × Q)) h1
        have e1 : b • x.1.1 = b • y.1.1 := congrArg Prod.fst h1'
        have e2 : b • x.1.2 = b • y.1.2 := congrArg Prod.snd h1'
        rw [Algebra.smul_def, Algebra.smul_def] at e1 e2
        apply Subtype.ext
        refine Prod.ext ?_ ?_
        · exact sub_eq_zero.mp (hRb' _ (by rw [mul_sub, e1, sub_self]))
        · exact hub.mul_left_cancel e2
      · intro m n hmn
        have h' := congrArg (fun z : E => (z : P × Q)) hmn
        have W2 : b • m.1.2 = a • n.1.2 := congrArg Prod.snd h'
        rw [Algebra.smul_def, Algebra.smul_def] at W2
        have E1 : ι m.1.1 = j m.1.2 := (memE _).mp m.2
        obtain ⟨α', hα'⟩ : ∃ α' : P, algebraMap A P a * α' = 1 := ⟨_, hua.mul_val_inv⟩
        obtain ⟨β', hβ'⟩ : ∃ β' : Q, algebraMap A Q b * β' = 1 := ⟨_, hub.mul_val_inv⟩
        have hjW := congrArg j W2
        rw [map_mul, map_mul, AlgHom.commutes, AlgHom.commutes, ← E1] at hjW
        have hια : algebraMap A R a * ι α' = 1 := by
          rw [← AlgHom.commutes ι a, ← map_mul, hα', map_one]
        have hjβ : algebraMap A R b * j β' = 1 := by
          rw [← AlgHom.commutes j b, ← map_mul, hβ', map_one]
        have hk : (m.1.1 * α', n.1.2 * β') ∈ E := by
          rw [memE]
          show ι (m.1.1 * α') = j (n.1.2 * β')
          rw [map_mul, map_mul]
          calc ι m.1.1 * ι α' = ι m.1.1 * ι α' * (algebraMap A R b * j β') := by rw [hjβ, mul_one]
            _ = (algebraMap A R b * ι m.1.1) * ι α' * j β' := by ring
            _ = (algebraMap A R a * j n.1.2) * ι α' * j β' := by rw [hjW]
            _ = j n.1.2 * j β' * (algebraMap A R a * ι α') := by ring
            _ = j n.1.2 * j β' := by rw [hια, mul_one]
        refine ⟨⟨(m.1.1 * α', n.1.2 * β'), hk⟩, ?_⟩
        apply Subtype.ext
        refine Prod.ext ?_ ?_
        · show m.1.1 = a • (m.1.1 * α')
          rw [Algebra.smul_def, mul_left_comm, hα', mul_one]
        · show m.1.2 = a • (n.1.2 * β')
          rw [Algebra.smul_def, ← mul_assoc, ← W2, mul_comm (algebraMap A Q b) _, mul_assoc, hβ',
            mul_one]
    refine ⟨E, inferInstance, inferInstance, hHP, κ, k1, k2, k3, k4, ?_⟩
    intro x hxa hxb
    obtain ⟨n, y, hy⟩ := k1 x
    obtain ⟨m, z, hz⟩ := k3 x
    have hpy := hxa n y hy
    have hqz := hxb m z hz
    have e1 : a ^ n • x.1.1 = p y := congrArg (fun w : E => (w : P × Q).1) hy
    have e2 : b ^ m • x.1.2 = q z := congrArg (fun w : E => (w : P × Q).2) hz
    rw [hpy, Algebra.smul_def, map_pow] at e1
    rw [hqz, Algebra.smul_def, map_pow] at e2
    apply Subtype.ext
    refine Prod.ext ?_ ?_
    · exact (hua.pow n).mul_right_eq_zero.mp e1
    · exact (hub.pow m).mul_right_eq_zero.mp e2

  obtain ⟨hua, surja, kera⟩ := s1 a
  obtain ⟨hub, surjb, kerb⟩ := s1 b
  obtain ⟨ιa, hιa, inja⟩ := s2 a b (a * b) rfl hRb
  obtain ⟨ιb, hιb, injb⟩ := s2 b a (a * b) (mul_comm a b) hRa
  obtain ⟨D, i1, i2, hHP, κ, k1, k2, k3, k4, sep⟩ :=
    main (Localization ((Submonoid.powers a).map (algebraMap A C₀)))
      (Localization ((Submonoid.powers b).map (algebraMap A C₀)))
      (Localization ((Submonoid.powers (a * b)).map (algebraMap A C₀)))
      (IsScalarTower.toAlgHom A C₀ (Localization ((Submonoid.powers a).map (algebraMap A C₀))))
      (IsScalarTower.toAlgHom A C₀ (Localization ((Submonoid.powers b).map (algebraMap A C₀))))
      ιa ιb
      (fun y => by rw [IsScalarTower.toAlgHom_apply, IsScalarTower.toAlgHom_apply, hιa, hιb])
      hua hub hRb hRa
      (fun u => by
        obtain ⟨n, y, h⟩ := surja u
        exact ⟨n, y, h.trans (IsScalarTower.toAlgHom_apply A C₀ _ y).symm⟩)
      (fun v => by
        obtain ⟨n, y, h⟩ := surjb v
        exact ⟨n, y, h.trans (IsScalarTower.toAlgHom_apply A C₀ _ y).symm⟩)
      (fun y h => kera y ((IsScalarTower.toAlgHom_apply A C₀ _ y).symm.trans h))
      (fun y h => kerb y ((IsScalarTower.toAlgHom_apply A C₀ _ y).symm.trans h))
      inja injb
  exact ⟨D, i1, i2, hHP, κ, k1, k2, k3, k4, fun x h1 h2 =>
    sep x (fun n y h => (IsScalarTower.toAlgHom_apply A C₀ _ y).trans (h1 n y h))
      (fun m z h => (IsScalarTower.toAlgHom_apply A C₀ _ z).trans (h2 m z h))⟩

theorem wc_cfp_reflexive_hull : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (a b : A), a ∈ IsLocalRing.maximalIdeal A → b ∈ IsLocalRing.maximalIdeal A → wcCg2HP A A a b → ∀ (C₀ : Type u) [CommRing C₀] [Algebra A C₀] [Module.Finite A C₀], wcCg2LocEtale (algebraMap A C₀) (Submonoid.powers a) → wcCg2LocEtale (algebraMap A C₀) (Submonoid.powers b) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra A D), Module.Finite A D ∧ wcCg2HP A D a b ∧ wcCg2LocEtale (algebraMap A D) (Submonoid.powers a) ∧ wcCg2LocEtale (algebraMap A D) (Submonoid.powers b) ∧ ∃ κ : C₀ →ₐ[A] D, (∀ x : D, ∃ (n : ℕ) (y : C₀), a ^ n • x = κ y) ∧ (∀ y : C₀, κ y = 0 → ∃ n : ℕ, a ^ n • y = 0) ∧ (∀ x : D, ∃ (n : ℕ) (y : C₀), b ^ n • x = κ y) ∧ (∀ y : C₀, κ y = 0 → ∃ n : ℕ, b ^ n • y = 0) :=
by
  intro A _ _ _ a b _ _ hHP C₀ _ _ _ hCa hCb
  obtain ⟨ra, rb, _⟩ := id hHP
  have hRb := wc_rh_chart_regular A C₀ a b rb hCa
  have hRa := wc_rh_chart_regular A C₀ b a ra hCb
  obtain ⟨D, iR, iA, hHPD, κ, k1, k2, k3, k4, sep⟩ := wc_rh_two_chart_glue A a b C₀ hRb hRa
  have hfin : Module.Finite A D := by
    refine wc_rh_finite_of_charts A a b hHP C₀ D κ.toLinearMap ?_ ?_ ?_ ?_
    · intro x
      obtain ⟨n, y, h⟩ := k1 x
      exact ⟨n, y, by first | exact h | simpa using h⟩
    · intro x
      obtain ⟨n, y, h⟩ := k3 x
      exact ⟨n, y, by first | exact h | simpa using h⟩
    · intro y hy
      exact k2 y (by first | exact hy | simpa using hy)
    · intro x hxa hxb
      apply sep x
      · intro n y h
        exact wc_rh_chart_dual_separates A C₀ a hCa y
          (hxa n y (by first | exact h | simpa using h))
      · intro m z h
        exact wc_rh_chart_dual_separates A C₀ b hCb z
          (hxb m z (by first | exact h | simpa using h))
  exact ⟨D, iR, iA, hfin, hHPD, wc_rh_locEtale_of_chart_iso A C₀ D a κ k1 k2 hCa,
    wc_rh_locEtale_of_chart_iso A C₀ D b κ k3 k4 hCb, κ, k1, k2, k3, k4⟩

theorem wc_cfi_powerSeries_facts : ∀ (A : Type u) [CommRing A] (e : ℕ) (a b : A), wcCg2HP A A a b → (∀ f : MvPowerSeries (Fin e) A, f - MvPowerSeries.C (σ := Fin e) (R := A) (MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f) ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A)))) ∧ (∀ (n : ℕ) (f : MvPowerSeries (Fin e) A), f ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n ↔ ∀ ν : Fin e →₀ ℕ, Finsupp.degree ν < n → MvPowerSeries.coeff ν f = 0) ∧ (∀ (n K : ℕ) (u : MvPowerSeries (Fin e) A), MvPowerSeries.C (σ := Fin e) (R := A) a ^ K * u ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n → u ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) ∧ (∀ (n K : ℕ) (u : MvPowerSeries (Fin e) A), MvPowerSeries.C (σ := Fin e) (R := A) b ^ K * u ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n → u ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) ∧ (∀ (n i j : ℕ) (u v : MvPowerSeries (Fin e) A), MvPowerSeries.C (σ := Fin e) (R := A) b ^ j * u - MvPowerSeries.C (σ := Fin e) (R := A) a ^ i * v ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n → ∃ w, u - MvPowerSeries.C (σ := Fin e) (R := A) a ^ i * w ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n ∧ v - MvPowerSeries.C (σ := Fin e) (R := A) b ^ j * w ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) ∧ (∀ u : MvPowerSeries (Fin e) A, (∀ n : ℕ, u ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) → u = 0) ∧ (∀ x : ℕ → MvPowerSeries (Fin e) A, (∀ n, x (n + 1) - x n ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) → ∃ x', ∀ n, x' - x n ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) :=
by
  intro A _ e a b hA
  classical

  have s1 : ∀ (n : ℕ) (f : MvPowerSeries (Fin e) A),
      f ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n →
      ∀ ν : Fin e →₀ ℕ, Finsupp.degree ν < n → MvPowerSeries.coeff ν f = 0 := by
    intro n f hf
    let O : ℕ → Ideal (MvPowerSeries (Fin e) A) := fun m =>
      { carrier := {g | ((m : ℕ) : ℕ∞) ≤ g.order}
        add_mem' := fun {x y} hx hy => le_trans (le_min hx hy) MvPowerSeries.min_order_le_add
        zero_mem' := by simp [MvPowerSeries.order_zero]
        smul_mem' := fun c x hx => by
          show (m : ℕ∞) ≤ (c * x).order
          exact le_trans hx (le_trans le_add_self MvPowerSeries.order_mul_ge) }
    have hJ : Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ≤ O 1 := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      show ((1:ℕ) : ℕ∞) ≤ (MvPowerSeries.X i).order
      rw [Nat.cast_one, ENat.one_le_iff_ne_zero]
      exact (MvPowerSeries.order_ne_zero_iff_constCoeff_eq_zero).mpr
        (MvPowerSeries.constantCoeff_X i)
    have hmul : ∀ m k, O m * O k ≤ O (m + k) := by
      intro m k
      rw [Ideal.mul_le]
      intro r hr s hs
      show ((m + k : ℕ) : ℕ∞) ≤ (r * s).order
      rw [Nat.cast_add]
      exact le_trans (add_le_add hr hs) MvPowerSeries.order_mul_ge
    have hpow : ∀ n, Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n ≤ O n := by
      intro n
      induction n with
      | zero => intro x _; show ((0:ℕ):ℕ∞) ≤ _; simp
      | succ n ih => rw [pow_succ]; exact le_trans (Ideal.mul_mono ih hJ) (hmul n 1)
    intro ν hν
    apply MvPowerSeries.coeff_of_lt_order
    exact lt_of_lt_of_le (by exact_mod_cast hν) (hpow n hf)

  have s2 : ∀ (n : ℕ) (f : MvPowerSeries (Fin e) A),
      (∀ ν : Fin e →₀ ℕ, Finsupp.degree ν < n → MvPowerSeries.coeff ν f = 0) →
      f ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n := by
    intro n
    induction n with
    | zero => intro f _; simp
    | succ n ih =>
      intro f hf
      let P : Fin e → (Fin e →₀ ℕ) → Prop := fun i ν => ν i ≠ 0 ∧ ∀ j, ν j ≠ 0 → i ≤ j
      let g : Fin e → MvPowerSeries (Fin e) A := fun i μ =>
        if P i (μ + Finsupp.single i 1) then MvPowerSeries.coeff (μ + Finsupp.single i 1) f else 0
      have hg : ∀ i, g i ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n := by
        intro i
        apply ih
        intro μ hμ
        show (if P i (μ + Finsupp.single i 1) then
          MvPowerSeries.coeff (μ + Finsupp.single i 1) f else 0) = 0
        rw [hf _ (by rw [map_add, Finsupp.degree_single]; omega)]
        simp
      have hcoeff : ∀ i ν, MvPowerSeries.coeff ν (MvPowerSeries.X i * g i) =
          if P i ν then MvPowerSeries.coeff ν f else 0 := by
        intro i ν
        rw [MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul]
        split_ifs with h1 h2 h2
        · rw [one_mul]
          show (if P i (ν - Finsupp.single i 1 + Finsupp.single i 1) then
            MvPowerSeries.coeff (ν - Finsupp.single i 1 + Finsupp.single i 1) f else 0) = _
          rw [tsub_add_cancel_of_le h1, if_pos h2]
        · rw [one_mul]
          show (if P i (ν - Finsupp.single i 1 + Finsupp.single i 1) then
            MvPowerSeries.coeff (ν - Finsupp.single i 1 + Finsupp.single i 1) f else 0) = _
          rw [tsub_add_cancel_of_le h1, if_neg h2]
        · exfalso; apply h1; rw [Finsupp.single_le_iff]; exact Nat.one_le_iff_ne_zero.mpr h2.1
        · rfl
      have hsum : f = ∑ i, MvPowerSeries.X i * g i := by
        ext ν
        rw [map_sum]
        simp_rw [hcoeff]
        by_cases hν : ν = 0
        · subst hν
          rw [hf 0 (by simp)]
          simp
        · have hne : ν.support.Nonempty := Finsupp.support_nonempty_iff.mpr hν
          have hP0 : P (ν.support.min' hne) ν :=
            ⟨Finsupp.mem_support_iff.mp (Finset.min'_mem _ _),
              fun j hj => Finset.min'_le _ _ (Finsupp.mem_support_iff.mpr hj)⟩
          rw [Finset.sum_eq_single (ν.support.min' hne)]
          · rw [if_pos hP0]
          · intro i _ hi
            rw [if_neg]
            intro hPi
            exact hi (le_antisymm (hPi.2 _ hP0.1) (hP0.2 i hPi.1))
          · intro h; exact absurd (Finset.mem_univ _) h
      rw [hsum]
      apply Ideal.sum_mem
      intro i _
      rw [pow_succ, mul_comm (MvPowerSeries.X i)]
      exact Ideal.mul_mem_mul (hg i) (Ideal.subset_span ⟨i, rfl⟩)
  have hCmul : ∀ (c : A) (K : ℕ) (u : MvPowerSeries (Fin e) A) (ν : Fin e →₀ ℕ),
      MvPowerSeries.coeff ν (MvPowerSeries.C (σ := Fin e) (R := A) c ^ K * u) =
        c ^ K * MvPowerSeries.coeff ν u := by
    intro c K u ν
    rw [← map_pow, MvPowerSeries.coeff_C_mul]
  have hreg : ∀ c : A, IsSMulRegular A c → ∀ (n K : ℕ) (u : MvPowerSeries (Fin e) A),
      MvPowerSeries.C (σ := Fin e) (R := A) c ^ K * u ∈
        Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n →
      u ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n := by
    intro c hc n K u hu
    apply s2
    intro ν hν
    have h0 := s1 n _ hu ν hν
    rw [hCmul] at h0
    apply hc.pow K
    show c ^ K * MvPowerSeries.coeff ν u = c ^ K * 0
    rw [h0, mul_zero]
  refine ⟨?_, fun n f => ⟨s1 n f, s2 n f⟩, hreg a hA.1, hreg b hA.2.1, ?_, ?_, ?_⟩
  ·
    intro f
    have := s2 1 (f - MvPowerSeries.C (σ := Fin e) (R := A)
      (MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f)) (by
        intro ν hν
        have hν0 : ν = 0 := (Finsupp.degree_eq_zero_iff ν).mp (by omega)
        subst hν0
        rw [map_sub, MvPowerSeries.coeff_zero_eq_constantCoeff_apply,
          MvPowerSeries.coeff_zero_eq_constantCoeff_apply, MvPowerSeries.constantCoeff_C, sub_self])
    rwa [pow_one] at this
  ·
    intro n i j u v huv
    have hlow := s1 n _ huv
    have hpt : ∀ ν : Fin e →₀ ℕ, ∃ m : A, Finsupp.degree ν < n →
        MvPowerSeries.coeff ν u = a ^ i * m ∧ MvPowerSeries.coeff ν v = b ^ j * m := by
      intro ν
      by_cases hν : Finsupp.degree ν < n
      · have h0 := hlow ν hν
        rw [map_sub, hCmul, hCmul, sub_eq_zero] at h0
        obtain ⟨hp, -, hw⟩ := hA
        have step1 : ∀ (L : ℕ) (z z' : A), b ^ L • z = a • z' → ∃ w, z = a • w := by
          intro L
          induction L with
          | zero => intro z z' h; exact ⟨z', by rwa [pow_zero, one_smul] at h⟩
          | succ L ih =>
            intro z z' h
            obtain ⟨k, hk⟩ := hw (b ^ L • z) z' (by rw [smul_smul, ← pow_succ']; exact h)
            exact ih z k hk
        have hart : ∀ (K L : ℕ) (z z' : A), b ^ L • z = a ^ K • z' → ∃ w, z = a ^ K • w := by
          intro K
          induction K with
          | zero => intro L z z' _; exact ⟨z, by rw [pow_zero, one_smul]⟩
          | succ K ih =>
            intro L z z' h
            obtain ⟨w1, hw1⟩ := step1 L z (a ^ K • z') (by rw [h, pow_succ', mul_smul])
            have h2 : b ^ L • w1 = a ^ K • z' := by
              apply hp
              show a • (b ^ L • w1) = a • (a ^ K • z')
              rw [smul_comm, ← hw1, h, pow_succ', mul_smul]
            obtain ⟨w, hw⟩ := ih L w1 z' h2
            exact ⟨w, by rw [hw1, hw, smul_smul, ← pow_succ']⟩
        have h0' : b ^ j • MvPowerSeries.coeff ν u = a ^ i • MvPowerSeries.coeff ν v := by
          rw [smul_eq_mul, smul_eq_mul]; exact h0
        obtain ⟨m, hm⟩ := hart i j _ _ h0'
        refine ⟨m, fun _ => ⟨by rw [hm, smul_eq_mul], ?_⟩⟩
        apply hp.pow i
        show a ^ i • MvPowerSeries.coeff ν v = a ^ i • (b ^ j * m)
        rw [← h0', hm, ← smul_eq_mul (b ^ j) m, smul_comm]
      · exact ⟨0, fun h => absurd h hν⟩
    choose W hW using hpt
    obtain ⟨w, hw⟩ : ∃ w : MvPowerSeries (Fin e) A, ∀ ν, MvPowerSeries.coeff ν w = W ν :=
      ⟨W, fun ν => rfl⟩
    refine ⟨w, s2 n _ ?_, s2 n _ ?_⟩
    · intro ν hν
      rw [map_sub, hCmul, hw, (hW ν hν).1, sub_self]
    · intro ν hν
      rw [map_sub, hCmul, hw, (hW ν hν).2, sub_self]
  ·
    intro u hu
    ext ν
    rw [map_zero]
    exact s1 (Finsupp.degree ν + 1) u (hu _) ν (Nat.lt_succ_self _)
  ·
    intro x hx
    have hstab : ∀ (ν : Fin e →₀ ℕ) (m : ℕ), Finsupp.degree ν + 1 ≤ m →
        MvPowerSeries.coeff ν (x m) = MvPowerSeries.coeff ν (x (Finsupp.degree ν + 1)) := by
      intro ν m hm
      induction m, hm using Nat.le_induction with
      | base => rfl
      | succ m hm ih =>
        have h0 := s1 m _ (hx m) ν (by omega)
        rw [map_sub, sub_eq_zero] at h0
        rw [h0, ih]
    obtain ⟨y, hy⟩ : ∃ y : MvPowerSeries (Fin e) A, ∀ ν,
        MvPowerSeries.coeff ν y = MvPowerSeries.coeff ν (x (Finsupp.degree ν + 1)) :=
      ⟨fun ν => MvPowerSeries.coeff ν (x (Finsupp.degree ν + 1)), fun ν => rfl⟩
    refine ⟨y, fun n => s2 n _ ?_⟩
    intro ν hν
    rw [map_sub, hy, hstab ν n (by omega), sub_self]

theorem wc_cfi_tensor_coeff_equiv : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (e : ℕ) (D : Type u) [CommRing D] [Algebra A D] [Module.Finite A D], ∃ τ : TensorProduct A (MvPowerSeries (Fin e) A) D →ₗ[A] ((Fin e →₀ ℕ) → D), Function.Bijective τ ∧ (∀ (f : MvPowerSeries (Fin e) A) (d : D) (ν : Fin e →₀ ℕ), τ (f ⊗ₜ[A] d) ν = MvPowerSeries.coeff ν f • d) ∧ ∀ (n : ℕ) (y : TensorProduct A (MvPowerSeries (Fin e) A) D), y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) ↔ ∀ ν : Fin e →₀ ℕ, Finsupp.degree ν < n → τ y ν = 0 :=
by
  intro A _ _ e D _ _ _
  classical
  set J : Ideal (MvPowerSeries (Fin e) A) :=
    Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) with hJdef

  have hJ1 : ∀ x ∈ Submodule.span (MvPowerSeries (Fin e) A)
        (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))), (1 : ℕ∞) ≤ x.order := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      apply MvPowerSeries.le_order
      intro d hd
      have hd0 : Finsupp.degree d = 0 := by
        have h1 : ((Finsupp.degree d : ℕ) : ℕ∞) < 1 := hd
        exact_mod_cast ENat.lt_one_iff_eq_zero.mp h1
      rw [(Finsupp.degree_eq_zero_iff d).mp hd0, MvPowerSeries.coeff_zero_X]
    | zero => simp
    | add x y _ _ hx hy => exact le_trans (le_min hx hy) MvPowerSeries.min_order_le_add
    | smul a x _ hx =>
      rw [smul_eq_mul]
      exact le_trans (le_add_left hx) MvPowerSeries.le_order_mul
  have hJn : ∀ n : ℕ, ∀ x ∈ J ^ n, (n : ℕ∞) ≤ x.order := by
    intro n
    induction n with
    | zero => intro x _; simp
    | succ n ih =>
      intro x hx
      rw [pow_succ] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro a ha b hb
        rw [Nat.cast_succ]
        exact le_trans (add_le_add (ih a ha) (hJ1 b hb)) MvPowerSeries.le_order_mul
      · intro x y hx hy
        exact le_trans (le_min hx hy) MvPowerSeries.min_order_le_add
  have hlowc : ∀ n : ℕ, ∀ x ∈ J ^ n, ∀ ν : Fin e →₀ ℕ, Finsupp.degree ν < n →
      MvPowerSeries.coeff ν x = 0 := by
    intro n x hx ν hν
    exact MvPowerSeries.coeff_of_lt_order
      (lt_of_lt_of_le (by exact_mod_cast hν) (hJn n x hx))

  have hlow : ∀ n : ℕ, ∀ f : MvPowerSeries (Fin e) A,
      (∀ ν : Fin e →₀ ℕ, Finsupp.degree ν < n → MvPowerSeries.coeff ν f = 0) → f ∈ J ^ n := by
    intro n
    induction n with
    | zero => intro f _; simp
    | succ n ih =>
      intro f hf
      obtain ⟨g, hgc⟩ : ∃ g : Fin e → MvPowerSeries (Fin e) A, ∀ i μ,
          MvPowerSeries.coeff μ (g i) =
            if (∀ j, j < i → μ j = 0) then MvPowerSeries.coeff (μ + Finsupp.single i 1) f
            else 0 :=
        ⟨fun i μ => if (∀ j, j < i → μ j = 0) then MvPowerSeries.coeff (μ + Finsupp.single i 1) f
            else 0, fun i μ => rfl⟩
      have hg : ∀ i, g i ∈ J ^ n := by
        intro i
        apply ih
        intro μ hμ
        rw [hgc]
        split_ifs
        · apply hf
          rw [map_add, Finsupp.degree_single]
          omega
        · rfl
      have hterm : ∀ i ν, MvPowerSeries.coeff ν (MvPowerSeries.X i * g i) =
          if (0 < ν i ∧ ∀ j, j < i → ν j = 0) then MvPowerSeries.coeff ν f else 0 := by
        intro i ν
        rw [MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul, one_mul]
        by_cases h1 : 0 < ν i
        · have hle : Finsupp.single i 1 ≤ ν := by
            rw [Finsupp.single_le_iff]; omega
          rw [if_pos hle, hgc]
          have hsub : ∀ j, j < i → (ν - Finsupp.single i 1 : Fin e →₀ ℕ) j = ν j := by
            intro j hj
            rw [Finsupp.tsub_apply, Finsupp.single_apply, if_neg (ne_of_lt hj).symm, tsub_zero]
          have hiff : (∀ j, j < i → (ν - Finsupp.single i 1 : Fin e →₀ ℕ) j = 0) ↔
              (∀ j, j < i → ν j = 0) := by
            constructor
            · intro h j hj; rw [← hsub j hj]; exact h j hj
            · intro h j hj; rw [hsub j hj]; exact h j hj
          rw [tsub_add_cancel_of_le hle]
          by_cases h2 : ∀ j, j < i → ν j = 0
          · rw [if_pos (hiff.mpr h2), if_pos ⟨h1, h2⟩]
          · rw [if_neg (fun h => h2 (hiff.mp h)), if_neg (fun h => h2 h.2)]
        · have hle : ¬ Finsupp.single i 1 ≤ ν := by
            rw [Finsupp.single_le_iff]; omega
          rw [if_neg hle, if_neg (fun h => h1 h.1)]
      have hfe : f = ∑ i, MvPowerSeries.X i * g i := by
        refine MvPowerSeries.ext (fun ν => ?_)
        rw [map_sum]
        simp_rw [hterm]
        by_cases hν : ν = 0
        · subst hν
          rw [hf 0 (by simp)]
          simp
        · have hne : ν.support.Nonempty := Finsupp.support_nonempty_iff.mpr hν
          obtain ⟨i₀, hi₀mem, hi₀min⟩ : ∃ i₀ ∈ ν.support, ∀ j ∈ ν.support, i₀ ≤ j :=
            ⟨ν.support.min' hne, Finset.min'_mem _ _, fun j hj => Finset.min'_le _ _ hj⟩
          have hi₀pos : 0 < ν i₀ := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hi₀mem)
          have hbelow : ∀ j, j < i₀ → ν j = 0 := by
            intro j hj
            by_contra hj0
            exact absurd hj (not_lt.mpr (hi₀min j (Finsupp.mem_support_iff.mpr hj0)))
          rw [Finset.sum_eq_single i₀]
          · rw [if_pos ⟨hi₀pos, hbelow⟩]
          · intro i _ hi
            rw [if_neg]
            rintro ⟨hpos, hb⟩
            have hle : i₀ ≤ i := hi₀min i (Finsupp.mem_support_iff.mpr hpos.ne')
            have hlt : i₀ < i := lt_of_le_of_ne hle (Ne.symm hi)
            exact absurd (hb i₀ hlt) hi₀pos.ne'
          · intro h; exact absurd (Finset.mem_univ _) h
      rw [hfe, pow_succ]
      apply Ideal.sum_mem
      intro i _
      rw [mul_comm (MvPowerSeries.X i)]
      exact Ideal.mul_mem_mul (hg i) (Ideal.subset_span ⟨i, rfl⟩)

  obtain ⟨τ, hτ⟩ : ∃ τ : TensorProduct A (MvPowerSeries (Fin e) A) D →ₗ[A] ((Fin e →₀ ℕ) → D),
      ∀ (f : MvPowerSeries (Fin e) A) (d : D) (ν : Fin e →₀ ℕ),
        τ (f ⊗ₜ[A] d) ν = MvPowerSeries.coeff ν f • d := by
    let β : MvPowerSeries (Fin e) A →ₗ[A] D →ₗ[A] ((Fin e →₀ ℕ) → D) :=
      LinearMap.mk₂ A (fun f d ν => MvPowerSeries.coeff ν f • d)
        (fun f₁ f₂ d => by funext ν; simp [add_smul])
        (fun c f d => by funext ν; simp [mul_smul])
        (fun f d₁ d₂ => by funext ν; simp [smul_add])
        (fun c f d => by funext ν; simp only [Pi.smul_apply]; exact smul_comm _ _ _)
    exact ⟨TensorProduct.lift β, fun f d ν => rfl⟩

  obtain ⟨r, p, hp⟩ := Module.Finite.exists_fin' A D
  have hfg : (LinearMap.ker p).FG := IsNoetherian.noetherian _
  obtain ⟨s, k, hk⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hpc : ∀ c : Fin r → A, p c = ∑ i, c i • p (Pi.single i 1) := by
    intro c
    have hc : c = ∑ i, c i • (Pi.single i 1 : Fin r → A) := by
      ext j
      simp [Finset.sum_apply, Pi.single_apply]
    conv_lhs => rw [hc]
    simp only [map_sum, map_smul]

  have hexp : ∀ y : TensorProduct A (MvPowerSeries (Fin e) A) D,
      ∃ m : Fin r → MvPowerSeries (Fin e) A, y = ∑ i, m i ⊗ₜ[A] p (Pi.single i 1) := by
    intro y
    induction y using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul x d =>
      obtain ⟨c, rfl⟩ := hp d
      refine ⟨fun i => c i • x, ?_⟩
      rw [hpc c, TensorProduct.tmul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [TensorProduct.smul_tmul]
    | add y₁ y₂ h₁ h₂ =>
      obtain ⟨m₁, rfl⟩ := h₁
      obtain ⟨m₂, rfl⟩ := h₂
      exact ⟨m₁ + m₂, by simp [TensorProduct.add_tmul, Finset.sum_add_distrib]⟩

  have hτexp : ∀ (f : Fin r → MvPowerSeries (Fin e) A) (ν : Fin e →₀ ℕ),
      τ (∑ i, f i ⊗ₜ[A] p (Pi.single i 1)) ν = p (fun i => MvPowerSeries.coeff ν (f i)) := by
    intro f ν
    rw [map_sum, Finset.sum_apply, hpc (fun i => MvPowerSeries.coeff ν (f i))]
    exact Finset.sum_congr rfl (fun i _ => hτ _ _ _)

  have hkill : ∀ (P : (Fin e →₀ ℕ) → Prop) (f : Fin r → MvPowerSeries (Fin e) A),
      (∀ ν, P ν → p (fun i => MvPowerSeries.coeff ν (f i)) = 0) →
      ∃ f' : Fin r → MvPowerSeries (Fin e) A,
        (∑ i, f i ⊗ₜ[A] p (Pi.single i 1) = ∑ i, f' i ⊗ₜ[A] p (Pi.single i 1)) ∧
        ∀ i ν, P ν → MvPowerSeries.coeff ν (f' i) = 0 := by
    intro P f hP
    have hΛ : ∀ ν, ∃ c : Fin s → A, P ν →
        ∑ j, c j • k j = fun i => MvPowerSeries.coeff ν (f i) := by
      intro ν
      by_cases hν : P ν
      · have hmem : (fun i => MvPowerSeries.coeff ν (f i)) ∈ Submodule.span A (Set.range k) := by
          rw [hk, LinearMap.mem_ker]; exact hP ν hν
        obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hmem
        exact ⟨c, fun _ => hc⟩
      · exact ⟨0, fun h => absurd h hν⟩
    choose Λ hΛ using hΛ
    obtain ⟨g, hg⟩ : ∃ g : Fin s → MvPowerSeries (Fin e) A,
        ∀ j ν, MvPowerSeries.coeff ν (g j) = Λ ν j :=
      ⟨fun j ν => Λ ν j, fun j ν => rfl⟩
    refine ⟨fun i => f i - ∑ j, k j i • g j, ?_, ?_⟩
    · have hzero : ∑ i, (∑ j, k j i • g j) ⊗ₜ[A] p (Pi.single i 1) = 0 := by
        simp_rw [TensorProduct.sum_tmul, TensorProduct.smul_tmul]
        rw [Finset.sum_comm]
        simp_rw [← TensorProduct.tmul_sum]
        apply Finset.sum_eq_zero
        intro j _
        have hkj : k j ∈ LinearMap.ker p := by
          rw [← hk]; exact Submodule.subset_span ⟨j, rfl⟩
        have h0 := hpc (k j)
        rw [LinearMap.mem_ker.mp hkj] at h0
        rw [← h0, TensorProduct.tmul_zero]
      simp_rw [TensorProduct.sub_tmul, Finset.sum_sub_distrib, hzero, sub_zero]
    · intro i ν hν
      simp only [map_sub, map_sum, map_smul, hg, smul_eq_mul]
      have h1 := congrFun (hΛ ν hν) i
      rw [Finset.sum_apply] at h1
      simp only [Pi.smul_apply, smul_eq_mul] at h1
      rw [← h1, sub_eq_zero]
      exact Finset.sum_congr rfl (fun j _ => mul_comm _ _)

  refine ⟨τ, ⟨?_, ?_⟩, hτ, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro y hy
    obtain ⟨f, rfl⟩ := hexp y
    obtain ⟨f', hf', hf'0⟩ := hkill (fun _ => True) f
      (fun ν _ => by rw [← hτexp f ν, hy, Pi.zero_apply])
    have h0 : ∀ i, f' i = 0 := fun i =>
      MvPowerSeries.ext (fun ν => by rw [hf'0 i ν trivial, map_zero])
    rw [hf']
    simp [h0]
  · intro t
    obtain ⟨F, hF⟩ : ∃ F : Fin r → MvPowerSeries (Fin e) A,
        ∀ i ν, MvPowerSeries.coeff ν (F i) = Function.surjInv hp (t ν) i :=
      ⟨fun i ν => Function.surjInv hp (t ν) i, fun i ν => rfl⟩
    refine ⟨∑ i, F i ⊗ₜ[A] p (Pi.single i 1), ?_⟩
    funext ν
    rw [hτexp]
    simp only [hF]
    exact Function.surjInv_eq hp (t ν)
  · intro n y
    constructor
    · intro hy ν hν
      have key : ∀ w ∈ Submodule.span (TensorProduct A (MvPowerSeries (Fin e) A) D)
            (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D) ''
              ((J ^ n : Ideal (MvPowerSeries (Fin e) A)) : Set (MvPowerSeries (Fin e) A))),
          ∀ z : TensorProduct A (MvPowerSeries (Fin e) A) D, τ (z * w) ν = 0 := by
        intro w hw
        induction hw using Submodule.span_induction with
        | mem w hw =>
          obtain ⟨x, hx, rfl⟩ := hw
          intro z
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul g d =>
            rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
              Algebra.TensorProduct.tmul_mul_tmul, mul_one, hτ,
              hlowc n (g * x) (Ideal.mul_mem_left _ g hx) ν hν, zero_smul]
          | add z₁ z₂ h₁ h₂ => rw [add_mul, map_add, Pi.add_apply, h₁, h₂, add_zero]
        | zero => intro z; simp
        | add w₁ w₂ _ _ h₁ h₂ => intro z; rw [mul_add, map_add, Pi.add_apply, h₁, h₂, add_zero]
        | smul a w _ h => intro z; rw [smul_eq_mul, ← mul_assoc]; exact h (z * a)
      simpa using key y hy 1
    · intro hy
      obtain ⟨f, rfl⟩ := hexp y
      obtain ⟨f', hf', hf'0⟩ := hkill (fun ν => Finsupp.degree ν < n) f
        (fun ν hν => by rw [← hτexp f ν]; exact hy ν hν)
      rw [hf']
      apply Ideal.sum_mem
      intro i _
      have hmem : f' i ∈ J ^ n := hlow n (f' i) (fun ν hν => hf'0 i ν hν)
      have heq : f' i ⊗ₜ[A] p (Pi.single i 1) =
          algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D) (f' i) *
            ((1 : MvPowerSeries (Fin e) A) ⊗ₜ[A] p (Pi.single i 1)) := by
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
          one_mul, Algebra.algebraMap_self, RingHom.id_apply]
      rw [heq]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hmem)

theorem wc_cfi_tensor_hp_facts : ∀ (A : Type u) [CommRing A] (e : ℕ) (D : Type u) [CommRing D] [Algebra A D] (a b : A) (τ : TensorProduct A (MvPowerSeries (Fin e) A) D →ₗ[A] ((Fin e →₀ ℕ) → D)), Function.Bijective τ → (∀ (f : MvPowerSeries (Fin e) A) (d : D) (ν : Fin e →₀ ℕ), τ (f ⊗ₜ[A] d) ν = MvPowerSeries.coeff ν f • d) → (∀ (n : ℕ) (y : TensorProduct A (MvPowerSeries (Fin e) A) D), y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) ↔ ∀ ν : Fin e →₀ ℕ, Finsupp.degree ν < n → τ y ν = 0) → wcCg2HP A D a b → (∀ (n K : ℕ) (y : TensorProduct A (MvPowerSeries (Fin e) A) D), (MvPowerSeries.C (σ := Fin e) (R := A) a) ^ K • y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) → y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) ∧ (∀ (n K : ℕ) (y : TensorProduct A (MvPowerSeries (Fin e) A) D), (MvPowerSeries.C (σ := Fin e) (R := A) b) ^ K • y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) → y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) ∧ (∀ (n i j : ℕ) (m₁ m₂ : TensorProduct A (MvPowerSeries (Fin e) A) D), (MvPowerSeries.C (σ := Fin e) (R := A) b) ^ j • m₁ - (MvPowerSeries.C (σ := Fin e) (R := A) a) ^ i • m₂ ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) → ∃ w, m₁ - (MvPowerSeries.C (σ := Fin e) (R := A) a) ^ i • w ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) ∧ (∀ y : TensorProduct A (MvPowerSeries (Fin e) A) D, (∀ n : ℕ, y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) → y = 0) ∧ (∀ x : ℕ → TensorProduct A (MvPowerSeries (Fin e) A) D, (∀ n, x (n + 1) - x n ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) → ∃ x', ∀ n, x' - x n ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) :=
by
  intro A _ e D _ _ a b τ hbij _hτ hJ hD
  classical
  have key : ∀ (x : A) (K : ℕ) (y : TensorProduct A (MvPowerSeries (Fin e) A) D)
      (ν : Fin e →₀ ℕ),
      τ ((MvPowerSeries.C (σ := Fin e) (R := A) x) ^ K • y) ν = x ^ K • τ y ν := by
    intro x K y ν
    have h1 : (MvPowerSeries.C (σ := Fin e) (R := A) x) ^ K • y = x ^ K • y := by
      rw [← map_pow]
      exact algebraMap_smul (MvPowerSeries (Fin e) A) (x ^ K) y
    rw [h1, map_smul, Pi.smul_apply]
  have reg : ∀ x : A, IsSMulRegular D x → ∀ (n K : ℕ)
      (y : TensorProduct A (MvPowerSeries (Fin e) A) D),
      (∀ ν : Fin e →₀ ℕ, Finsupp.degree ν < n →
        τ ((MvPowerSeries.C (σ := Fin e) (R := A) x) ^ K • y) ν = 0) →
      ∀ ν : Fin e →₀ ℕ, Finsupp.degree ν < n → τ y ν = 0 := by
    intro x hx n K y h ν hν
    have h2 := h ν hν
    rw [key] at h2
    have h3 : x ^ K • τ y ν = x ^ K • (0 : D) := by rw [h2, smul_zero]
    exact (hx.pow K) h3
  have hart : ∀ (K L : ℕ) (z z' : D), b ^ L • z = a ^ K • z' → ∃ w, z = a ^ K • w := by
    obtain ⟨hp, -, hw⟩ := hD
    have step1 : ∀ (L : ℕ) (z z' : D), b ^ L • z = a • z' → ∃ w, z = a • w := by
      intro L
      induction L with
      | zero => intro z z' h; exact ⟨z', by rwa [pow_zero, one_smul] at h⟩
      | succ L ih =>
        intro z z' h
        obtain ⟨k, hk⟩ := hw (b ^ L • z) z' (by rw [smul_smul, ← pow_succ']; exact h)
        exact ih z k hk
    intro K
    induction K with
    | zero => intro L z z' _; exact ⟨z, by rw [pow_zero, one_smul]⟩
    | succ K ih =>
      intro L z z' h
      obtain ⟨w1, hw1⟩ := step1 L z (a ^ K • z') (by rw [h, pow_succ', mul_smul])
      have h2 : b ^ L • w1 = a ^ K • z' := by
        apply hp
        show a • (b ^ L • w1) = a • (a ^ K • z')
        rw [smul_comm, ← hw1, h, pow_succ', mul_smul]
      obtain ⟨w, hw⟩ := ih L w1 z' h2
      exact ⟨w, by rw [hw1, hw, smul_smul, ← pow_succ']⟩
  refine ⟨fun n K y h => (hJ n y).2 (reg a hD.1 n K y ((hJ n _).1 h)),
    fun n K y h => (hJ n y).2 (reg b hD.2.1 n K y ((hJ n _).1 h)), ?_, ?_, ?_⟩
  · intro n i j m₁ m₂ h
    have h1 := (hJ n _).1 h
    have hex : ∀ ν : Fin e →₀ ℕ, ∃ t : D, Finsupp.degree ν < n → τ m₁ ν = a ^ i • t := by
      intro ν
      by_cases hν : Finsupp.degree ν < n
      · have h2 := h1 ν hν
        rw [map_sub, Pi.sub_apply, key, key, sub_eq_zero] at h2
        obtain ⟨t, ht⟩ := hart i j _ _ h2
        exact ⟨t, fun _ => ht⟩
      · exact ⟨0, fun h' => absurd h' hν⟩
    choose t ht using hex
    obtain ⟨w, hw⟩ := hbij.2 t
    refine ⟨w, (hJ n _).2 ?_⟩
    intro ν hν
    rw [map_sub, Pi.sub_apply, key, hw, ← ht ν hν, sub_self]
  · intro y hy
    apply hbij.1
    rw [map_zero]
    funext ν
    exact (hJ _ y).1 (hy (Finsupp.degree ν + 1)) ν (Nat.lt_succ_self _)
  · intro x hx
    have hstep : ∀ (ν : Fin e →₀ ℕ) (m : ℕ), Finsupp.degree ν < m →
        τ (x (m + 1)) ν = τ (x m) ν := by
      intro ν m hm
      have h := (hJ m _).1 (hx m) ν hm
      rw [map_sub, Pi.sub_apply, sub_eq_zero] at h
      exact h
    have hT : ∀ (ν : Fin e →₀ ℕ) (d : ℕ),
        τ (x (Finsupp.degree ν + 1 + d)) ν = τ (x (Finsupp.degree ν + 1)) ν := by
      intro ν d
      induction d with
      | zero => rfl
      | succ d ih =>
        rw [← ih]
        exact hstep ν (Finsupp.degree ν + 1 + d) (by omega)
    obtain ⟨x', hx'⟩ := hbij.2 (fun ν => τ (x (Finsupp.degree ν + 1)) ν)
    refine ⟨x', fun n => (hJ n _).2 ?_⟩
    intro ν hν
    obtain ⟨d, rfl⟩ : ∃ d, n = Finsupp.degree ν + 1 + d := ⟨n - (Finsupp.degree ν + 1), by omega⟩
    rw [map_sub, Pi.sub_apply, hx', hT ν d, sub_self]

theorem wc_cfi_special_fibre : ∀ (A : Type u) [CommRing A] (e : ℕ) (C : Type u) [CommRing C] [Algebra (MvPowerSeries (Fin e) A) C], (∀ f : MvPowerSeries (Fin e) A, f - MvPowerSeries.C (σ := Fin e) (R := A) (MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f) ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A)))) → letI : Algebra (MvPowerSeries (Fin e) A) A := (MvPowerSeries.constantCoeff (σ := Fin e) (R := A)).toAlgebra; (∀ y : TensorProduct (MvPowerSeries (Fin e) A) A C, ∃ s : C, y = (1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s) ∧ (∀ s : C, (1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s = 0 → s ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) C) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))))) :=
by
  intro A _ e C _ _ hJ
  letI : Algebra (MvPowerSeries (Fin e) A) A :=
    (MvPowerSeries.constantCoeff (σ := Fin e) (R := A)).toAlgebra
  have hsm : ∀ (f : MvPowerSeries (Fin e) A) (x : A),
      f • x = MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f * x := fun _ _ => rfl
  have key : ∀ x : A, (MvPowerSeries.C (σ := Fin e) (R := A) x) • (1 : A) = x := by
    intro x
    rw [hsm, MvPowerSeries.constantCoeff_C, mul_one]
  refine ⟨fun y => ?_, fun s hs => ?_⟩
  · induction y using TensorProduct.induction_on with
    | zero => exact ⟨0, (TensorProduct.tmul_zero _ _).symm⟩
    | tmul x s =>
      refine ⟨(MvPowerSeries.C (σ := Fin e) (R := A) x) • s, ?_⟩
      have h := TensorProduct.smul_tmul (R := MvPowerSeries (Fin e) A)
        (MvPowerSeries.C (σ := Fin e) (R := A) x) (1 : A) s
      rw [key] at h
      exact h
    | add y₁ y₂ h₁ h₂ =>
      obtain ⟨s₁, rfl⟩ := h₁
      obtain ⟨s₂, rfl⟩ := h₂
      exact ⟨s₁ + s₂, (TensorProduct.tmul_add _ _ _).symm⟩
  · set I := Ideal.map (algebraMap (MvPowerSeries (Fin e) A) C)
      (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A)))) with hI
    have hq : ∀ (f : MvPowerSeries (Fin e) A) (z : C),
        f • Ideal.Quotient.mk I z = Ideal.Quotient.mk I (algebraMap _ C f * z) := by
      intro f z
      rw [Algebra.smul_def, ← Ideal.Quotient.mk_algebraMap, ← map_mul]
    let β : A →ₗ[MvPowerSeries (Fin e) A] C →ₗ[MvPowerSeries (Fin e) A] C ⧸ I :=
      LinearMap.mk₂ (MvPowerSeries (Fin e) A)
        (fun x s => Ideal.Quotient.mk I
          (algebraMap (MvPowerSeries (Fin e) A) C (MvPowerSeries.C (σ := Fin e) (R := A) x) * s))
        (fun x₁ x₂ s => by simp only [map_add, add_mul])
        (fun f x s => by
          rw [hq, Ideal.Quotient.eq, hsm, map_mul, map_mul]
          have h1 : algebraMap (MvPowerSeries (Fin e) A) C
                (MvPowerSeries.C (σ := Fin e) (R := A)
                  (MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f)) *
              algebraMap (MvPowerSeries (Fin e) A) C (MvPowerSeries.C (σ := Fin e) (R := A) x) * s -
              algebraMap (MvPowerSeries (Fin e) A) C f *
              (algebraMap (MvPowerSeries (Fin e) A) C (MvPowerSeries.C (σ := Fin e) (R := A) x) * s) =
              algebraMap (MvPowerSeries (Fin e) A) C
                (-(f - MvPowerSeries.C (σ := Fin e) (R := A)
                  (MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f))) *
              (algebraMap (MvPowerSeries (Fin e) A) C (MvPowerSeries.C (σ := Fin e) (R := A) x) * s) := by
            rw [map_neg, map_sub]
            ring
          rw [h1]
          exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (neg_mem (hJ f))))
        (fun x s₁ s₂ => by simp only [mul_add, map_add])
        (fun f x s => by
          rw [hq, Algebra.smul_def, mul_left_comm])
    have hL : TensorProduct.lift β ((1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s) = Ideal.Quotient.mk I s := by
      rw [TensorProduct.lift.tmul]
      simp [β]
    rw [hs, map_zero] at hL
    exact Ideal.Quotient.eq_zero_iff_mem.mp hL.symm

theorem wc_cfi_chart_inverse : ∀ (A S D : Type u) [CommRing A] [CommRing S] [CommRing D] [Algebra A S] [Algebra A D] (a : A) (κ : S →ₐ[A] D), (∀ x : D, ∃ (n : ℕ) (y : S), a ^ n • x = κ y) → (∀ y : S, κ y = 0 → ∃ n : ℕ, a ^ n • y = 0) → ∃ g : D →ₐ[A] Localization.Away (algebraMap A S a), ∀ y : S, g (κ y) = algebraMap S (Localization.Away (algebraMap A S a)) y :=
by
  intro A S D _ _ _ _ _ a κ H1 H2
  set s : S := algebraMap A S a with hs
  set d : D := algebraMap A D a with hd
  have hκs : κ s = d := κ.commutes a
  have hκpow : ∀ n : ℕ, κ (s ^ n) = d ^ n := fun n => by rw [map_pow, hκs]
  have hsmulS : ∀ (n : ℕ) (y : S), a ^ n • y = s ^ n * y := fun n y => by
    rw [Algebra.smul_def, map_pow]
  have hsmulD : ∀ (n : ℕ) (x : D), a ^ n • x = d ^ n * x := fun n x => by
    rw [Algebra.smul_def, map_pow]
  have hy : Submonoid.powers s ≤ (Submonoid.powers d).comap (κ : S →+* D) := by
    rintro m ⟨n, rfl⟩
    exact ⟨n, (hκpow n).symm⟩
  let κa : Localization.Away s →+* Localization.Away d :=
    IsLocalization.map (M := Submonoid.powers s) (T := Submonoid.powers d)
      (Localization.Away d) (κ : S →+* D) hy
  have hmapmk : ∀ (y : S) (m : Submonoid.powers s),
      κa (IsLocalization.mk' (Localization.Away s) y m) =
        IsLocalization.mk' (Localization.Away d) ((κ : S →+* D) y) ⟨(κ : S →+* D) m, hy m.2⟩ :=
    fun y m => IsLocalization.map_mk' hy y m
  have hmapeq : ∀ y : S, κa (algebraMap S (Localization.Away s) y) =
      algebraMap D (Localization.Away d) (κ y) :=
    fun y => IsLocalization.map_eq hy y
  have hinj : Function.Injective κa := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨y, m⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers s) z
    rw [hmapmk, IsLocalization.mk'_eq_zero_iff] at hz
    obtain ⟨⟨c, k, rfl⟩, hc⟩ := hz
    have h0 : κ (s ^ k * y) = 0 := by
      rw [map_mul, hκpow]
      exact hc
    obtain ⟨j, hj⟩ := H2 _ h0
    rw [hsmulS] at hj
    rw [IsLocalization.mk'_eq_zero_iff]
    refine ⟨⟨s ^ (j + k), j + k, rfl⟩, ?_⟩
    show s ^ (j + k) * y = 0
    rw [pow_add, mul_assoc]
    exact hj
  have hsurj : Function.Surjective κa := by
    intro w
    obtain ⟨⟨x, ⟨c, n, rfl⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers d) w
    obtain ⟨k, y, hky⟩ := H1 x
    rw [hsmulD] at hky
    refine ⟨IsLocalization.mk' (Localization.Away s) y
      (⟨s ^ (n + k), n + k, rfl⟩ : Submonoid.powers s), ?_⟩
    rw [hmapmk, IsLocalization.mk'_eq_iff_eq]
    congr 1
    show d ^ n * κ y = κ (s ^ (n + k)) * x
    rw [hκpow, ← hky, pow_add]
    ring
  let e := RingEquiv.ofBijective κa ⟨hinj, hsurj⟩
  have hstar : ∀ y : S, e.symm (algebraMap D (Localization.Away d) (κ y)) =
      algebraMap S (Localization.Away s) y := by
    intro y
    rw [RingEquiv.symm_apply_eq]
    show algebraMap D _ (κ y) = κa (algebraMap S _ y)
    exact (hmapeq y).symm
  refine ⟨AlgHom.mk (e.symm.toRingHom.comp (algebraMap D (Localization.Away d))) ?_, ?_⟩
  · intro r
    show e.symm (algebraMap D _ (algebraMap A D r)) = _
    rw [← κ.commutes r, hstar, ← IsScalarTower.algebraMap_apply]
  · intro y
    exact hstar y

theorem wc_cfi_retraction : ∀ (R S : Type u) [CommRing R] [IsNoetherianRing R] [CommRing S] [Algebra R S] [Module.Finite R S] (α : R), wcCg2LocEtale (algebraMap R S) (Submonoid.powers α) → IsSMulRegular S α → ∃ (r N : ℕ) (ι : S →ₗ[R] (Fin r → R)) (ρ : (Fin r → R) →ₗ[R] S), ∀ z : S, ρ (ι z) = α ^ N • z :=
by
  intro R S _ _ _ _ _ α hE _
  classical

  have unif : ∀ {ι : Type} [Fintype ι] {X : Type u} [AddCommGroup X] [Module R X] (f : ι → X),
      (∀ i, ∃ m : ℕ, α ^ m • f i = 0) → ∃ m : ℕ, ∀ i, α ^ m • f i = 0 := by
    intro ι _ X _ _ f hf
    choose m hm using hf
    refine ⟨∑ i, m i, fun i => ?_⟩
    have hle : m i ≤ ∑ i, m i :=
      Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
    rw [← Nat.sub_add_cancel hle, pow_add, mul_smul, hm i, smul_zero]

  obtain ⟨r, p, hp⟩ := Module.Finite.exists_fin' R S
  have hpk : ∀ u : Fin r → R, p u = ∑ j, u j • p (Pi.single j 1) := by
    intro u
    conv_lhs => rw [show u = ∑ j, u j • (Pi.single j (1:R) : Fin r → R) by
      ext i; simp [Finset.sum_apply, Pi.single_apply]]
    rw [map_sum]
    simp only [map_smul]

  obtain ⟨N₀, v, ha, hb⟩ : ∃ (N₀ : ℕ) (v : Fin r → Fin r → R),
      (∀ j : Fin r, ∃ m : ℕ, α ^ m • (p (v j) - α ^ N₀ • p (Pi.single j 1)) = 0) ∧
      (∀ k : Fin r → R, p k = 0 → ∃ m : ℕ, α ^ m • (∑ j, k j • v j) = 0) := by
    let Rα := Localization (Submonoid.powers α)
    let T := (Submonoid.powers α).map (algebraMap R S)
    let Sα := Localization T
    let φ : Rα →+* Sα :=
      IsLocalization.map Sα (algebraMap R S) (Submonoid.powers α).le_comap_map
    letI : Algebra Rα Sα := φ.toAlgebra
    haveI : Algebra.Etale Rα Sα := hE
    haveI : Module.Finite Rα Sα :=
      RingHom.finite_localizationPreserves (algebraMap R S) (Submonoid.powers α) Rα Sα
        (RingHom.finite_algebraMap.mpr inferInstance)
    haveI : IsNoetherianRing Rα :=
      IsLocalization.isNoetherianRing (Submonoid.powers α) Rα inferInstance
    haveI : Module.FinitePresentation Rα Sα := Module.finitePresentation_of_finite Rα Sα
    haveI : Module.Projective Rα Sα := Module.Flat.projective_of_finitePresentation
    have hdag : ∀ (x : R) (s : S),
        algebraMap R Rα x • algebraMap S Sα s = algebraMap S Sα (x • s) := by
      intro x s
      rw [Algebra.smul_def, Algebra.smul_def (A := S), map_mul]
      congr 1
      exact IsLocalization.map_eq (S := Rα) _ _
    let pα : (Fin r → Rα) →ₗ[Rα] Sα :=
      Fintype.linearCombination Rα (fun j => algebraMap S Sα (p (Pi.single j 1)))
    have hpα : ∀ c, pα c = ∑ j, c j • algebraMap S Sα (p (Pi.single j 1)) := fun c =>
      Fintype.linearCombination_apply Rα _ c
    have h5 : ∀ u : Fin r → R,
        pα (fun i => algebraMap R Rα (u i)) = algebraMap S Sα (p u) := by
      intro u
      rw [hpα, hpk u, map_sum]
      exact Finset.sum_congr rfl (fun j _ => hdag _ _)
    have hsurj : Function.Surjective pα := by
      intro y
      obtain ⟨⟨s, ⟨t, ht⟩⟩, rfl⟩ := IsLocalization.mk'_surjective T y
      obtain ⟨x, hx, rfl⟩ := Submonoid.mem_map.mp ht
      obtain ⟨k, rfl⟩ := hp s
      refine ⟨IsLocalization.mk' Rα (1 : R) (⟨x, hx⟩ : Submonoid.powers α) •
        (fun i => algebraMap R Rα (k i)), ?_⟩
      rw [map_smul, h5, Algebra.smul_def]
      show φ _ * _ = _
      rw [IsLocalization.map_mk', mul_comm, IsLocalization.mul_mk'_eq_mk'_of_mul, map_one,
        mul_one]
    obtain ⟨σ, hσ⟩ := Module.projective_lifting_property pα LinearMap.id hsurj
    have hσ' : ∀ y, pα (σ y) = y := fun y => LinearMap.congr_fun hσ y
    obtain ⟨⟨b, hbM⟩, hbint⟩ := IsLocalization.exist_integer_multiples (Submonoid.powers α)
      (Finset.univ : Finset (Fin r × Fin r))
      (fun ji => σ (algebraMap S Sα (p (Pi.single ji.1 1))) ji.2)
    obtain ⟨N₀, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hbM
    have hex : ∀ j i, ∃ y : R, algebraMap R Rα y =
        algebraMap R Rα (α ^ N₀) * σ (algebraMap S Sα (p (Pi.single j 1))) i := by
      intro j i
      obtain ⟨y, hy⟩ := hbint (j, i) (Finset.mem_univ _)
      exact ⟨y, by rw [hy, Algebra.smul_def]⟩
    choose v hv using hex
    refine ⟨N₀, v, ?_, ?_⟩
    · intro j
      have h1 : algebraMap S Sα (p (v j) - α ^ N₀ • p (Pi.single j 1)) = 0 := by
        rw [map_sub, ← h5, ← hdag]
        have : (fun i => algebraMap R Rα (v j i)) =
            algebraMap R Rα (α ^ N₀) • σ (algebraMap S Sα (p (Pi.single j 1))) := by
          funext i; rw [hv]; rfl
        rw [this, map_smul, hσ', sub_self]
      obtain ⟨⟨_, hm⟩, hm0⟩ := (IsLocalization.map_eq_zero_iff T Sα _).mp h1
      obtain ⟨m, hm', rfl⟩ := Submonoid.mem_map.mp hm
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm'
      exact ⟨n, by rw [Algebra.smul_def]; exact hm0⟩
    · intro k hk
      have h0 : ∑ j, algebraMap R Rα (k j) • σ (algebraMap S Sα (p (Pi.single j 1))) = 0 := by
        have e1 : pα (fun i => algebraMap R Rα (k i)) = 0 := by rw [h5, hk, map_zero]
        have e2 := congrArg σ e1
        rw [hpα, map_sum, map_zero] at e2
        simpa only [map_smul] using e2
      have hi : ∀ i, ∃ m : ℕ, α ^ m • (∑ j, k j • v j) i = 0 := by
        intro i
        have e3 : algebraMap R Rα ((∑ j, k j • v j) i) = 0 := by
          have e4 : algebraMap R Rα ((∑ j, k j • v j) i) = algebraMap R Rα (α ^ N₀) *
              (∑ j, algebraMap R Rα (k j) • σ (algebraMap S Sα (p (Pi.single j 1)))) i := by
            rw [Finset.sum_apply, Finset.sum_apply, map_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [Pi.smul_apply, Pi.smul_apply, smul_eq_mul, smul_eq_mul, map_mul, hv]
            ring
          rw [e4, h0, Pi.zero_apply, mul_zero]
        obtain ⟨⟨_, hm⟩, hm0⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers α) Rα _).mp e3
        obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
        exact ⟨n, by rw [smul_eq_mul]; exact hm0⟩
      obtain ⟨m, hm⟩ := unif _ hi
      exact ⟨m, funext fun i => by rw [Pi.smul_apply, hm i, Pi.zero_apply]⟩

  obtain ⟨mA, hmA⟩ := unif _ ha
  have hA' : ∀ j, α ^ mA • p (v j) = α ^ (mA + N₀) • p (Pi.single j 1) := by
    intro j
    have h := hmA j
    rw [smul_sub, sub_eq_zero, smul_smul, ← pow_add] at h
    exact h
  have hfg : (LinearMap.ker p).FG := IsNoetherian.noetherian _
  obtain ⟨s, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  let L : (Fin r → R) →ₗ[R] (Fin r → R) := Fintype.linearCombination R v
  have hL : ∀ k, L k = ∑ j, k j • v j := fun k => Fintype.linearCombination_apply R v k
  have hgk : ∀ t, p (g t) = 0 := fun t => by
    have : g t ∈ LinearMap.ker p := hg ▸ Submodule.subset_span (Set.mem_range_self t)
    exact this
  obtain ⟨mB, hmB⟩ := unif (fun t => L (g t)) (fun t => by rw [hL]; exact hb _ (hgk t))
  let ι₀ : (Fin r → R) →ₗ[R] (Fin r → R) := α ^ (mA + mB) • L
  have hK : LinearMap.ker p ≤ LinearMap.ker ι₀ := by
    rw [← hg, Submodule.span_le]
    rintro _ ⟨t, rfl⟩
    show α ^ (mA + mB) • L (g t) = 0
    have h : α ^ mB • L (g t) = 0 := hmB t
    rw [pow_add, mul_smul, h, smul_zero]
  refine ⟨r, mA + mB + N₀,
    ((LinearMap.ker p).liftQ ι₀ hK).comp (p.quotKerEquivOfSurjective hp).symm.toLinearMap, p, ?_⟩
  intro z
  obtain ⟨k, rfl⟩ := hp z
  have h1 : (p.quotKerEquivOfSurjective hp).symm (p k) = Submodule.Quotient.mk k := by
    rw [LinearEquiv.symm_apply_eq]; rfl
  rw [LinearMap.comp_apply, LinearEquiv.coe_coe, h1, Submodule.liftQ_apply]
  show p (α ^ (mA + mB) • L k) = _
  rw [hL, map_smul, map_sum, hpk k, Finset.smul_sum, Finset.smul_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [map_smul, smul_comm (α ^ (mA + mB)) (k j), smul_comm (α ^ (mA + mB + N₀)) (k j)]
  congr 1
  rw [show mA + mB = mB + mA by omega, pow_add, mul_smul, hA', smul_smul, ← pow_add]
  congr 2
  omega

theorem wc_cfi_level_maps : ∀ (A : Type u) [CommRing A] (e : ℕ) (C : Type u) [CommRing C] [Algebra (MvPowerSeries (Fin e) A) C] (D : Type u) [CommRing D] [Algebra A D] (a b : A), (∀ f : MvPowerSeries (Fin e) A, f - MvPowerSeries.C (σ := Fin e) (R := A) (MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f) ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A)))) → wcCg2LocEtale (algebraMap (MvPowerSeries (Fin e) A) C) (Submonoid.powers (MvPowerSeries.C (σ := Fin e) (R := A) a)) → wcCg2LocEtale (algebraMap (MvPowerSeries (Fin e) A) C) (Submonoid.powers (MvPowerSeries.C (σ := Fin e) (R := A) b)) → (∀ (n K : ℕ) (y : TensorProduct A (MvPowerSeries (Fin e) A) D), (MvPowerSeries.C (σ := Fin e) (R := A) a) ^ K • y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) → y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) → (∀ (n K : ℕ) (y : TensorProduct A (MvPowerSeries (Fin e) A) D), (MvPowerSeries.C (σ := Fin e) (R := A) b) ^ K • y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) → y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) → (∀ (n i j : ℕ) (m₁ m₂ : TensorProduct A (MvPowerSeries (Fin e) A) D), (MvPowerSeries.C (σ := Fin e) (R := A) b) ^ j • m₁ - (MvPowerSeries.C (σ := Fin e) (R := A) a) ^ i • m₂ ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) → ∃ w, m₁ - (MvPowerSeries.C (σ := Fin e) (R := A) a) ^ i • w ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) → letI : Algebra (MvPowerSeries (Fin e) A) A := (MvPowerSeries.constantCoeff (σ := Fin e) (R := A)).toAlgebra; ∀ κ : TensorProduct (MvPowerSeries (Fin e) A) A C →ₐ[A] D, ∃ φ : ∀ n : ℕ, C →ₐ[MvPowerSeries (Fin e) A] (TensorProduct A (MvPowerSeries (Fin e) A) D ⧸ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ (n + 1))), (∀ (n : ℕ) (s : C) (x : TensorProduct A (MvPowerSeries (Fin e) A) D), Ideal.Quotient.mk (Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ (n + 2))) x = φ (n + 1) s → Ideal.Quotient.mk (Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ (n + 1))) x = φ n s) ∧ (∀ (n : ℕ) (s : C) (x : TensorProduct A (MvPowerSeries (Fin e) A) D), Ideal.Quotient.mk (Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ (n + 1))) x = φ n s → x - (1 : MvPowerSeries (Fin e) A) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s) ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))))) :=
by
  intro A _ e C _ _ D _ _ a b hB0 hCa hCb hEa hEb hEw κ
  letI : Algebra (MvPowerSeries (Fin e) A) A :=
    (MvPowerSeries.constantCoeff (σ := Fin e) (R := A)).toAlgebra
  generalize Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) = J
    at hB0 hEa hEb hEw ⊢
  obtain ⟨I', hI'⟩ : ∃ I' : Ideal (TensorProduct A (MvPowerSeries (Fin e) A) D),
      I' = Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
        (TensorProduct A (MvPowerSeries (Fin e) A) D)) J := ⟨_, rfl⟩
  have hpow : ∀ k : ℕ, I' ^ k = Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
      (TensorProduct A (MvPowerSeries (Fin e) A) D)) (J ^ k) := by
    intro k
    rw [hI', Ideal.map_pow]

  have hsm : ∀ (k : ℕ) (c : MvPowerSeries (Fin e) A) (x : TensorProduct A (MvPowerSeries (Fin e) A) D),
      (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D) c) •
        (Ideal.Quotient.mk (I' ^ k) x) = Ideal.Quotient.mk (I' ^ k) (c • x) := by
    intro k c x
    rw [Algebra.smul_def c x, map_mul]
    first
      | rfl
      | exact Algebra.smul_def _ _
      | exact smul_eq_mul _ _

  have hHP : ∀ k : ℕ, wcCg2HP (TensorProduct A (MvPowerSeries (Fin e) A) D)
      (TensorProduct A (MvPowerSeries (Fin e) A) D ⧸ I' ^ k)
      (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)
        (MvPowerSeries.C (σ := Fin e) (R := A) a))
      (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)
        (MvPowerSeries.C (σ := Fin e) (R := A) b)) := by
    intro k
    refine ⟨?_, ?_, ?_⟩
    · intro p q hpq
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective p
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective q
      have h' := hpq
      simp only [hsm] at h'
      have h'' : MvPowerSeries.C (σ := Fin e) (R := A) a ^ 1 • (x - y) ∈
          Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
            (TensorProduct A (MvPowerSeries (Fin e) A) D)) (J ^ k) := by
        rw [pow_one, smul_sub, ← hpow]
        exact Ideal.Quotient.eq.mp h'
      rw [Ideal.Quotient.eq, hpow]
      exact hEa k 1 _ h''
    · intro p q hpq
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective p
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective q
      have h' := hpq
      simp only [hsm] at h'
      have h'' : MvPowerSeries.C (σ := Fin e) (R := A) b ^ 1 • (x - y) ∈
          Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
            (TensorProduct A (MvPowerSeries (Fin e) A) D)) (J ^ k) := by
        rw [pow_one, smul_sub, ← hpow]
        exact Ideal.Quotient.eq.mp h'
      rw [Ideal.Quotient.eq, hpow]
      exact hEb k 1 _ h''
    · intro p q hpq
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective p
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective q
      rw [hsm, hsm, Ideal.Quotient.eq, hpow] at hpq
      obtain ⟨w, hw⟩ := hEw k 1 1 x y (by rwa [pow_one, pow_one])
      refine ⟨Ideal.Quotient.mk _ w, ?_⟩
      rw [hsm, Ideal.Quotient.eq, hpow]
      rwa [pow_one] at hw

  have hCa' := wc_cg2_locEtale_baseChange (MvPowerSeries (Fin e) A)
    (TensorProduct A (MvPowerSeries (Fin e) A) D) C _ hCa
  have hCb' := wc_cg2_locEtale_baseChange (MvPowerSeries (Fin e) A)
    (TensorProduct A (MvPowerSeries (Fin e) A) D) C _ hCb

  have key : ∀ f : MvPowerSeries (Fin e) A,
      (1 : MvPowerSeries (Fin e) A) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[MvPowerSeries (Fin e) A]
        algebraMap (MvPowerSeries (Fin e) A) C f) =
      algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)
        (MvPowerSeries.C (σ := Fin e) (R := A)
          (MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f)) := by
    intro f
    have h1 : (1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] algebraMap (MvPowerSeries (Fin e) A) C f =
        algebraMap A (TensorProduct (MvPowerSeries (Fin e) A) A C)
          (MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f) := by
      rw [Algebra.algebraMap_eq_smul_one f, ← TensorProduct.smul_tmul,
        Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.smul_def, mul_one]
      all_goals rfl
    rw [h1, κ.commutes,
      Algebra.algebraMap_eq_smul_one (MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f),
      ← TensorProduct.smul_tmul, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply, Algebra.smul_def, mul_one, MvPowerSeries.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply]

  obtain ⟨g, hg⟩ : ∃ g : C →ₐ[MvPowerSeries (Fin e) A]
      TensorProduct A (MvPowerSeries (Fin e) A) D ⧸ I' ^ 1, ∀ s : C,
      g s = Ideal.Quotient.mk (I' ^ 1) ((1 : MvPowerSeries (Fin e) A) ⊗ₜ[A]
        κ ((1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s)) := by
    let ψ : C →+* TensorProduct A (MvPowerSeries (Fin e) A) D ⧸ I' ^ 1 :=
      (Ideal.Quotient.mk (I' ^ 1)).comp
        ((Algebra.TensorProduct.includeRight :
            D →ₐ[A] TensorProduct A (MvPowerSeries (Fin e) A) D).toRingHom.comp
          (κ.toRingHom.comp
            (Algebra.TensorProduct.includeRight :
              C →ₐ[MvPowerSeries (Fin e) A] TensorProduct (MvPowerSeries (Fin e) A) A C).toRingHom))
    have hψ : ∀ s, ψ s = Ideal.Quotient.mk (I' ^ 1) ((1 : MvPowerSeries (Fin e) A) ⊗ₜ[A]
        κ ((1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s)) := fun s => rfl
    refine ⟨{ ψ with commutes' := fun f => ?_ }, fun s => hψ s⟩
    show ψ (algebraMap (MvPowerSeries (Fin e) A) C f) = _
    rw [hψ, key, ← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq, ← map_sub, pow_one, hI']
    apply Ideal.mem_map_of_mem
    have h := J.neg_mem (hB0 f)
    rwa [neg_sub] at h

  obtain ⟨φ₁, hφ₁⟩ : ∃ φ₁ : TensorProduct (MvPowerSeries (Fin e) A)
      (TensorProduct A (MvPowerSeries (Fin e) A) D) C →ₐ[TensorProduct A (MvPowerSeries (Fin e) A) D]
      TensorProduct A (MvPowerSeries (Fin e) A) D ⧸ I' ^ 1, ∀ s : C,
      φ₁ ((1 : TensorProduct A (MvPowerSeries (Fin e) A) D) ⊗ₜ[MvPowerSeries (Fin e) A] s) =
        Ideal.Quotient.mk (I' ^ 1) ((1 : MvPowerSeries (Fin e) A) ⊗ₜ[A]
          κ ((1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s)) :=
    ⟨Algebra.TensorProduct.lift (R := MvPowerSeries (Fin e) A)
      (S := TensorProduct A (MvPowerSeries (Fin e) A) D)
      (A := TensorProduct A (MvPowerSeries (Fin e) A) D) (B := C)
      (C := TensorProduct A (MvPowerSeries (Fin e) A) D ⧸ I' ^ 1)
      (Ideal.Quotient.mkₐ _ (I' ^ 1)) g
      (fun x y => Commute.all ((Ideal.Quotient.mkₐ _ (I' ^ 1)) x) (g y)),
      fun s => by rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul, hg]⟩

  obtain ⟨Φ, hΦ⟩ := wc_cg2_formal_section_lift (TensorProduct A (MvPowerSeries (Fin e) A) D) I'
    _ _ hHP (TensorProduct (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D) C)
    hCa' hCb' φ₁

  obtain ⟨φ, hφ⟩ : ∃ φ : ∀ n : ℕ, C →ₐ[MvPowerSeries (Fin e) A]
      (TensorProduct A (MvPowerSeries (Fin e) A) D ⧸ Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
        (TensorProduct A (MvPowerSeries (Fin e) A) D)) (J ^ (n + 1))),
      ∀ (n : ℕ) (s : C), φ n s = Ideal.quotientEquivAlgOfEq (MvPowerSeries (Fin e) A) (hpow (n + 1))
        (AdicCompletion.evalₐ I' (n + 1)
          (Φ ((1 : TensorProduct A (MvPowerSeries (Fin e) A) D) ⊗ₜ[MvPowerSeries (Fin e) A] s))) :=
    ⟨fun n => (Ideal.quotientEquivAlgOfEq (MvPowerSeries (Fin e) A) (hpow (n + 1))).toAlgHom.comp
      ((((AdicCompletion.evalₐ I' (n + 1)).comp Φ).restrictScalars (MvPowerSeries (Fin e) A)).comp
        Algebra.TensorProduct.includeRight), fun n s => rfl⟩
  have hev : ∀ (z : AdicCompletion I' (TensorProduct A (MvPowerSeries (Fin e) A) D)) (k : ℕ),
      ∃ y, ∀ m ≤ k, AdicCompletion.evalₐ I' m z = Ideal.Quotient.mk (I' ^ m) y := by
    intro z k
    obtain ⟨r, rfl⟩ := AdicCompletion.mk_surjective I' _ z
    refine ⟨(r : ℕ → TensorProduct A (MvPowerSeries (Fin e) A) D) k, fun m hm => ?_⟩
    rw [AdicCompletion.evalₐ_mk]
    exact (AdicCompletion.Ideal.mk_eq_mk I' hm r).symm
  have hφy : ∀ (s : C) (k : ℕ), ∃ y : TensorProduct A (MvPowerSeries (Fin e) A) D, ∀ m ≤ k,
      φ m s = Ideal.Quotient.mk (Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
        (TensorProduct A (MvPowerSeries (Fin e) A) D)) (J ^ (m + 1))) y := by
    intro s k
    obtain ⟨y, hy⟩ := hev (Φ ((1 : TensorProduct A (MvPowerSeries (Fin e) A) D) ⊗ₜ[MvPowerSeries (Fin e) A] s)) (k + 1)
    refine ⟨y, fun m hm => ?_⟩
    rw [hφ, hy (m + 1) (by omega), Ideal.quotientEquivAlgOfEq_mk]
  have hφ0 : ∀ s : C, φ 0 s = Ideal.Quotient.mk (Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
        (TensorProduct A (MvPowerSeries (Fin e) A) D)) (J ^ (0 + 1)))
      ((1 : MvPowerSeries (Fin e) A) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s)) := by
    intro s
    have h1 : AdicCompletion.evalₐ I' (0 + 1)
        (Φ ((1 : TensorProduct A (MvPowerSeries (Fin e) A) D) ⊗ₜ[MvPowerSeries (Fin e) A] s)) =
        Ideal.Quotient.mk (I' ^ (0 + 1)) ((1 : MvPowerSeries (Fin e) A) ⊗ₜ[A]
          κ ((1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s)) := by
      rw [← hφ₁, ← hΦ]
      rfl
    rw [hφ, h1, Ideal.quotientEquivAlgOfEq_mk]
  refine ⟨φ, ?_, ?_⟩
  · intro n s x hx
    obtain ⟨y, hy⟩ := hφy s (n + 1)
    have h1 := Ideal.Quotient.eq.mp (hx.trans (hy (n + 1) le_rfl))
    have h2 : x - y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
        (TensorProduct A (MvPowerSeries (Fin e) A) D)) (J ^ (n + 1)) :=
      Ideal.map_mono (Ideal.pow_le_pow_right (by omega)) h1
    rw [hy n (Nat.le_succ n)]
    exact Ideal.Quotient.eq.mpr h2
  · intro n s x hx
    obtain ⟨y, hy⟩ := hφy s n
    have h1 := Ideal.Quotient.eq.mp (hx.trans (hy n le_rfl))
    have h2 := Ideal.Quotient.eq.mp ((hy 0 (Nat.zero_le _)).symm.trans (hφ0 s))
    have h1' : x - y ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
        (TensorProduct A (MvPowerSeries (Fin e) A) D)) J :=
      Ideal.map_mono (Ideal.pow_le_self (Nat.succ_ne_zero n)) h1
    have h2' : y - (1 : MvPowerSeries (Fin e) A) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s) ∈
        Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
        (TensorProduct A (MvPowerSeries (Fin e) A) D)) J := by
      simpa only [zero_add, pow_one] using h2
    have h3 := Ideal.add_mem _ h1' h2'
    rwa [sub_add_sub_cancel] at h3

theorem wc_cfi_limit_map : ∀ (R C E : Type u) [CommRing R] [CommRing C] [Algebra R C] [CommRing E] [Algebra R E] (J : Ideal R), (∀ y : E, (∀ n : ℕ, y ∈ Ideal.map (algebraMap R E) (J ^ n)) → y = 0) → (∀ x : ℕ → E, (∀ n, x (n + 1) - x n ∈ Ideal.map (algebraMap R E) (J ^ n)) → ∃ x' : E, ∀ n, x' - x n ∈ Ideal.map (algebraMap R E) (J ^ n)) → ∀ φ : ∀ n : ℕ, C →ₐ[R] (E ⧸ Ideal.map (algebraMap R E) (J ^ (n + 1))), (∀ (n : ℕ) (s : C) (x : E), Ideal.Quotient.mk (Ideal.map (algebraMap R E) (J ^ (n + 2))) x = φ (n + 1) s → Ideal.Quotient.mk (Ideal.map (algebraMap R E) (J ^ (n + 1))) x = φ n s) → ∃ Ψ : C →ₐ[R] E, ∀ (n : ℕ) (s : C), Ideal.Quotient.mk (Ideal.map (algebraMap R E) (J ^ (n + 1))) (Ψ s) = φ n s :=
by
  intro R C E _ _ _ _ _ J hsep hcpl φ hcomp
  classical
  have hmono : ∀ n, Ideal.map (algebraMap R E) (J ^ (n + 1)) ≤
      Ideal.map (algebraMap R E) (J ^ n) :=
    fun n => Ideal.map_mono (Ideal.pow_le_pow_right (Nat.le_succ n))
  have huniq : ∀ (s : C) (y y' : E),
      (∀ n, Ideal.Quotient.mk (Ideal.map (algebraMap R E) (J ^ (n + 1))) y = φ n s) →
      (∀ n, Ideal.Quotient.mk (Ideal.map (algebraMap R E) (J ^ (n + 1))) y' = φ n s) →
      y = y' := by
    intro s y y' hy hy'
    apply sub_eq_zero.mp
    apply hsep
    intro n
    apply hmono n
    rw [← Ideal.Quotient.eq, hy, hy']
  have hex : ∀ s : C, ∃ y : E,
      ∀ n, Ideal.Quotient.mk (Ideal.map (algebraMap R E) (J ^ (n + 1))) y = φ n s := by
    intro s
    choose x hx using fun n => Ideal.Quotient.mk_surjective (φ n s)
    have ha : ∀ n, x (n + 1) - x n ∈ Ideal.map (algebraMap R E) (J ^ (n + 1)) := by
      intro n
      rw [← Ideal.Quotient.eq, hx n]
      exact hcomp n s (x (n + 1)) (hx (n + 1))
    obtain ⟨x', hx'⟩ := hcpl x (fun n => hmono n (ha n))
    refine ⟨x', fun n => ?_⟩
    rw [← hx n, Ideal.Quotient.eq]
    have := Ideal.add_mem _ (hx' (n + 1)) (ha n)
    rwa [sub_add_sub_cancel] at this
  choose f hf using hex
  let Ψ : C →ₐ[R] E :=
    { toFun := f
      map_one' := huniq 1 _ _ (hf 1) (fun n => by rw [map_one, map_one])
      map_mul' := fun s t => huniq (s * t) _ _ (hf (s * t))
        (fun n => by rw [map_mul, map_mul, hf, hf])
      map_zero' := huniq 0 _ _ (hf 0) (fun n => by rw [map_zero, map_zero])
      map_add' := fun s t => huniq (s + t) _ _ (hf (s + t))
        (fun n => by rw [map_add, map_add, hf, hf])
      commutes' := fun r => huniq (algebraMap R C r) _ _ (hf _)
        (fun n => by rw [Ideal.Quotient.mk_algebraMap, AlgHom.commutes]) }
  exact ⟨Ψ, fun n s => hf s n⟩

theorem wc_cfi_level_chart_iso : ∀ (A : Type u) [CommRing A] (e : ℕ) (C : Type u) [CommRing C] [Algebra (MvPowerSeries (Fin e) A) C] (D : Type u) [CommRing D] [Algebra A D] (a : A), (∀ f : MvPowerSeries (Fin e) A, f - MvPowerSeries.C (σ := Fin e) (R := A) (MvPowerSeries.constantCoeff (σ := Fin e) (R := A) f) ∈ Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A)))) → wcCg2LocEtale (algebraMap (MvPowerSeries (Fin e) A) C) (Submonoid.powers (MvPowerSeries.C (σ := Fin e) (R := A) a)) → wcCg2LocEtale (algebraMap A D) (Submonoid.powers a) → letI : Algebra (MvPowerSeries (Fin e) A) A := (MvPowerSeries.constantCoeff (σ := Fin e) (R := A)).toAlgebra; (∀ y : TensorProduct (MvPowerSeries (Fin e) A) A C, ∃ s : C, y = (1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s) → (∀ s : C, (1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s = 0 → s ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) C) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))))) → ∀ κ : TensorProduct (MvPowerSeries (Fin e) A) A C →ₐ[A] D, (∀ x : D, ∃ (n : ℕ) (y : TensorProduct (MvPowerSeries (Fin e) A) A C), a ^ n • x = κ y) → ∀ g : D →ₐ[A] Localization.Away (algebraMap A (TensorProduct (MvPowerSeries (Fin e) A) A C) a), (∀ y, g (κ y) = algebraMap (TensorProduct (MvPowerSeries (Fin e) A) A C) (Localization.Away (algebraMap A (TensorProduct (MvPowerSeries (Fin e) A) A C) a)) y) → ∀ (n : ℕ) (φ : C →ₐ[MvPowerSeries (Fin e) A] (TensorProduct A (MvPowerSeries (Fin e) A) D ⧸ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ (n + 1)))), (∀ (s : C) (x : TensorProduct A (MvPowerSeries (Fin e) A) D), Ideal.Quotient.mk (Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ (n + 1))) x = φ s → x - (1 : MvPowerSeries (Fin e) A) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[MvPowerSeries (Fin e) A] s) ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))))) → (∀ z : C, φ z = 0 → ∃ K : ℕ, (MvPowerSeries.C (σ := Fin e) (R := A) a) ^ K • z ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A) C) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ (n + 1))) ∧ (∀ y : TensorProduct A (MvPowerSeries (Fin e) A) D, ∃ (K : ℕ) (z : C), Ideal.Quotient.mk (Ideal.map (algebraMap (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D)) (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ (n + 1))) ((MvPowerSeries.C (σ := Fin e) (R := A) a) ^ K • y) = φ z) :=
by
  intro A _ e C _ _ D _ _ a h0 hCc hDc hsurj0 _hker0 κ hkc g hg n φ hφκ
  letI : Algebra (MvPowerSeries (Fin e) A) A :=
    (MvPowerSeries.constantCoeff (σ := Fin e) (R := A)).toAlgebra
  classical

  have t5 : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]
      (α : R), IsUnit (algebraMap R T α) → ∀ (f : S →ₐ[R] T),
      ∃ f' : Localization ((Submonoid.powers α).map (algebraMap R S)) →ₐ[R] T,
        ∀ s : S, f' (algebraMap S (Localization ((Submonoid.powers α).map (algebraMap R S))) s) =
          f s := by
    intro R S T _ _ _ _ _ α hu f
    refine ⟨IsLocalization.liftAlgHom (M := (Submonoid.powers α).map (algebraMap R S)) (f := f) ?_, ?_⟩
    · rintro ⟨y, x, ⟨k, rfl⟩, rfl⟩
      show IsUnit (f (algebraMap R S (α ^ k)))
      rw [AlgHom.commutes, map_pow]
      exact hu.pow k
    · intro s
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl

  have t2 : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]
      (α : R) [Algebra.FormallyUnramified R (Localization ((Submonoid.powers α).map (algebraMap R S)))],
      IsUnit (algebraMap R T α) → ∀ (I : Ideal T), IsNilpotent I → ∀ (u₁ u₂ : S →ₐ[R] T),
      (∀ s, u₁ s - u₂ s ∈ I) → u₁ = u₂ := by
    intro R S T _ _ _ _ _ α _ hu I hI u₁ u₂ h
    obtain ⟨v₁, hv₁⟩ := t5 R S T α hu u₁
    obtain ⟨v₂, hv₂⟩ := t5 R S T α hu u₂
    have key : (Ideal.Quotient.mkₐ R I).comp v₁ = (Ideal.Quotient.mkₐ R I).comp v₂ := by
      apply IsLocalization.algHom_ext ((Submonoid.powers α).map (algebraMap R S))
      ext s
      change Ideal.Quotient.mk I (v₁ (algebraMap S _ s)) = Ideal.Quotient.mk I (v₂ (algebraMap S _ s))
      rw [hv₁, hv₂]
      exact Ideal.Quotient.eq.mpr (h s)
    have hv : v₁ = v₂ := by
      apply Algebra.FormallyUnramified.ext I hI
      intro x
      exact AlgHom.congr_fun key x
    ext s
    rw [← hv₁, ← hv₂, hv]

  have t1 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (M : Submonoid R),
      wcCg2LocEtale (algebraMap R S) M →
      Algebra.FormallyEtale R (Localization (M.map (algebraMap R S))) := by
    intro R S _ _ _ M h
    let ψ : Localization M →+* Localization (M.map (algebraMap R S)) :=
      IsLocalization.map (Localization (M.map (algebraMap R S))) (algebraMap R S) M.le_comap_map
    letI : Algebra (Localization M) (Localization (M.map (algebraMap R S))) := ψ.toAlgebra
    haveI : Algebra.Etale (Localization M) (Localization (M.map (algebraMap R S))) := h
    haveI : Algebra.FormallyEtale R (Localization M) := Algebra.FormallyEtale.of_isLocalization M
    haveI : IsScalarTower R (Localization M) (Localization (M.map (algebraMap R S))) :=
      IsScalarTower.of_algebraMap_eq' (by
        ext r
        show algebraMap R _ r = ψ (algebraMap R (Localization M) r)
        rw [IsLocalization.map_eq]
        exact IsScalarTower.algebraMap_apply R S _ r)
    exact Algebra.FormallyEtale.comp R (Localization M) _

  have t7 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (α : R) (I : Ideal R) (z : S),
      algebraMap S (Localization ((Submonoid.powers α).map (algebraMap R S))) z ∈
        Ideal.map (algebraMap R (Localization ((Submonoid.powers α).map (algebraMap R S)))) I →
      ∃ K : ℕ, α ^ K • z ∈ Ideal.map (algebraMap R S) I := by
    intro R S _ _ _ α I z hz
    rw [IsScalarTower.algebraMap_eq R S (Localization ((Submonoid.powers α).map (algebraMap R S))),
      ← Ideal.map_map] at hz
    obtain ⟨⟨x, m⟩, hxm⟩ := (IsLocalization.mem_map_algebraMap_iff
      ((Submonoid.powers α).map (algebraMap R S)) _).mp hz
    rw [← map_mul, IsLocalization.eq_iff_exists ((Submonoid.powers α).map (algebraMap R S))] at hxm
    obtain ⟨c, hc⟩ := hxm
    obtain ⟨_, ⟨k1, rfl⟩, hc1⟩ := c.2
    obtain ⟨_, ⟨k2, rfl⟩, hm2⟩ := m.2
    refine ⟨k1 + k2, ?_⟩
    have e : α ^ (k1 + k2) • z = (c : S) * (x : S) := by
      rw [← hc, ← hc1, ← hm2, Algebra.smul_def, pow_add, map_mul]; ring
    rw [e]
    exact Ideal.mul_mem_left _ _ x.2

  have t8 : ∀ (R S Q : Type u) [CommRing R] [CommRing S] [CommRing Q] [Algebra R S] [Algebra R Q]
      (α : R) (I : Ideal R) (φ : S →ₐ[R] Q), (∀ j ∈ I, algebraMap R Q j = 0) →
      ∃ φ' : (Localization ((Submonoid.powers α).map (algebraMap R S)) ⧸
          Ideal.map (algebraMap R (Localization ((Submonoid.powers α).map (algebraMap R S)))) I) →ₐ[R]
          Localization ((Submonoid.powers α).map (algebraMap R Q)),
        ∀ s : S, φ' (Ideal.Quotient.mk (Ideal.map (algebraMap R (Localization ((Submonoid.powers α).map
          (algebraMap R S)))) I) (algebraMap S (Localization ((Submonoid.powers α).map
            (algebraMap R S))) s)) =
          algebraMap Q (Localization ((Submonoid.powers α).map (algebraMap R Q))) (φ s) := by
    intro R S Q _ _ _ _ _ α I φ hQ
    have hu : IsUnit (algebraMap R (Localization ((Submonoid.powers α).map (algebraMap R Q))) α) := by
      rw [IsScalarTower.algebraMap_apply R Q]
      exact IsLocalization.map_units _
        (⟨algebraMap R Q α, α, Submonoid.mem_powers α, rfl⟩ : (Submonoid.powers α).map (algebraMap R Q))
    obtain ⟨f', hf'⟩ := t5 R S _ α hu ((IsScalarTower.toAlgHom R Q _).comp φ)
    refine ⟨Ideal.Quotient.liftₐ _ f' ?_, ?_⟩
    · have hle : Ideal.map (algebraMap R (Localization ((Submonoid.powers α).map (algebraMap R S)))) I ≤
          RingHom.ker f' := by
        rw [Ideal.map_le_iff_le_comap]
        intro j hj
        rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes, IsScalarTower.algebraMap_apply R Q,
          hQ j hj, map_zero]
      intro x hx
      exact hle hx
    · intro s
      exact hf' s

  have t9 : ∀ (R T : Type u) [CommRing R] [CommRing T] [Algebra R T] (J : Ideal R) (N : ℕ),
      (∀ j ∈ J ^ N, algebraMap R T j = 0) → IsNilpotent (Ideal.map (algebraMap R T) J) := by
    intro R T _ _ _ J N h
    refine ⟨N, ?_⟩
    rw [← Ideal.map_pow, Ideal.zero_eq_bot, Ideal.map_eq_bot_iff_le_ker]
    intro j hj
    exact h j hj

  have t10 : ∀ (R T T' : Type u) [CommRing R] [CommRing T] [CommRing T'] [Algebra R T] [Algebra R T']
      (f : T →ₐ[R] T') (J : Ideal R) (x y : T), x - y ∈ Ideal.map (algebraMap R T) J →
      f x - f y ∈ Ideal.map (algebraMap R T') J := by
    intro R T T' _ _ _ _ _ f J x y h
    rw [← map_sub]
    have := Ideal.mem_map_of_mem (f : T →+* T') h
    rwa [Ideal.map_map, AlgHom.comp_algebraMap] at this

  have t11 : ∀ (R C E' : Type u) [CommRing R] [CommRing C] [CommRing E'] [Algebra R C] [Algebra R E']
      (α : R) (I : Ideal R) (φ : C →ₐ[R] E')
      (φ' : (Localization ((Submonoid.powers α).map (algebraMap R C)) ⧸
        Ideal.map (algebraMap R (Localization ((Submonoid.powers α).map (algebraMap R C)))) I) →ₐ[R]
        Localization ((Submonoid.powers α).map (algebraMap R E'))),
      (∀ s : C, φ' (Ideal.Quotient.mk (Ideal.map (algebraMap R (Localization ((Submonoid.powers α).map
        (algebraMap R C)))) I) (algebraMap C (Localization ((Submonoid.powers α).map
          (algebraMap R C))) s)) =
        algebraMap E' (Localization ((Submonoid.powers α).map (algebraMap R E'))) (φ s)) →
      (∀ y : E', ∃ w, φ' w =
        algebraMap E' (Localization ((Submonoid.powers α).map (algebraMap R E'))) y) →
      ∀ (y : E'), ∃ (K : ℕ) (z : C), α ^ K • y = φ z := by
    intro R C E' _ _ _ _ _ α I φ φ' hφ' hsurj y
    obtain ⟨w, hw⟩ := hsurj y
    obtain ⟨u, rfl⟩ := Ideal.Quotient.mk_surjective w
    obtain ⟨⟨s, m⟩, hsm⟩ := IsLocalization.surj ((Submonoid.powers α).map (algebraMap R C)) u
    obtain ⟨_, ⟨k, rfl⟩, hm⟩ := m.2
    have h1 : algebraMap E' (Localization ((Submonoid.powers α).map (algebraMap R E'))) (α ^ k • y) =
        algebraMap E' (Localization ((Submonoid.powers α).map (algebraMap R E'))) (φ s) := by
      rw [← hφ']
      simp only at hsm
      rw [← hsm, ← hm, map_mul, map_mul, hw, ← IsScalarTower.algebraMap_apply R C,
        Ideal.Quotient.mk_algebraMap, AlgHom.commutes, Algebra.smul_def, map_mul,
        ← IsScalarTower.algebraMap_apply R E', mul_comm]
    obtain ⟨c, hc⟩ :=
      (IsLocalization.eq_iff_exists ((Submonoid.powers α).map (algebraMap R E')) _).mp h1
    obtain ⟨_, ⟨m', rfl⟩, hc'⟩ := c.2
    refine ⟨m' + k, α ^ m' • s, ?_⟩
    rw [map_smul, pow_add, mul_smul, Algebra.smul_def (α ^ m') (α ^ k • y),
      Algebra.smul_def (α ^ m') (φ s), hc', hc]

  have t3 : ∀ (A B D W : Type u) [CommRing A] [CommRing B] [CommRing D] [CommRing W] [Algebra A B]
      [Algebra A D] [Algebra B W] (a : A)
      [Algebra.FormallySmooth A (Localization ((Submonoid.powers a).map (algebraMap A D)))],
      IsUnit (algebraMap B W (algebraMap A B a)) → ∀ (I₀ : Ideal B),
      (∀ j ∈ I₀, algebraMap B W j = 0) → ∀ (I : Ideal W), IsNilpotent I → ∀ (θ : D →+* W ⧸ I),
      (∀ x : A, θ (algebraMap A D x) = algebraMap B (W ⧸ I) (algebraMap A B x)) →
      ∃ hb : (TensorProduct A B D ⧸ Ideal.map (algebraMap B (TensorProduct A B D)) I₀) →ₐ[B] W,
        ∀ d : D, Ideal.Quotient.mk I (hb (Ideal.Quotient.mk
          (Ideal.map (algebraMap B (TensorProduct A B D)) I₀) ((1 : B) ⊗ₜ[A] d))) = θ d := by
    intro A B D W _ _ _ _ _ _ _ a _ hu I₀ hI₀ I hI θ hθ
    letI : Algebra A W := ((algebraMap B W).comp (algebraMap A B)).toAlgebra
    haveI : IsScalarTower A B W := IsScalarTower.of_algebraMap_eq' rfl
    let θ' : D →ₐ[A] W ⧸ I :=
      { θ with
        commutes' := fun x => by
          show θ (algebraMap A D x) = _
          rw [hθ, IsScalarTower.algebraMap_apply A B (W ⧸ I)] }
    have hu' : IsUnit (algebraMap A (W ⧸ I) a) := by
      rw [IsScalarTower.algebraMap_apply A B (W ⧸ I), IsScalarTower.algebraMap_apply B W (W ⧸ I)]
      exact hu.map _
    obtain ⟨θt, hθt⟩ := t5 A D (W ⧸ I) a hu' θ'
    have hker : IsNilpotent (RingHom.ker (Ideal.Quotient.mkₐ A I)) := by
      have e : RingHom.ker (Ideal.Quotient.mkₐ A I) = I := by
        ext x
        rw [RingHom.mem_ker, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
      rw [e]; exact hI
    let ℓ := Algebra.FormallySmooth.liftOfSurjective θt (Ideal.Quotient.mkₐ A I)
      (Ideal.Quotient.mkₐ_surjective A I) hker
    let ℓ₀ : D →ₐ[A] W := ℓ.comp (IsScalarTower.toAlgHom A D
      (Localization ((Submonoid.powers a).map (algebraMap A D))))
    have hℓ₀ : ∀ d, Ideal.Quotient.mk I (ℓ₀ d) = θ d := by
      intro d
      have h1 := Algebra.FormallySmooth.liftOfSurjective_apply θt (Ideal.Quotient.mkₐ A I)
        (Ideal.Quotient.mkₐ_surjective A I) hker
        (algebraMap D (Localization ((Submonoid.powers a).map (algebraMap A D))) d)
      rw [hθt] at h1
      exact h1
    let L : TensorProduct A B D →ₐ[B] W :=
      Algebra.TensorProduct.lift (Algebra.ofId B W) ℓ₀ (fun _ _ => Commute.all _ _)
    have hle : Ideal.map (algebraMap B (TensorProduct A B D)) I₀ ≤ RingHom.ker L := by
      rw [Ideal.map_le_iff_le_comap]
      intro j hj
      rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes]
      exact hI₀ j hj
    refine ⟨Ideal.Quotient.liftₐ _ L (fun x hx => by
      have := hle hx
      rwa [RingHom.mem_ker] at this), ?_⟩
    intro d
    show Ideal.Quotient.mk I (L ((1 : B) ⊗ₜ[A] d)) = θ d
    rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
    exact hℓ₀ d

  have t4 : ∀ (A B C D Q : Type u) [CommRing A] [CommRing B] [CommRing C] [CommRing D] [CommRing Q]
      [Algebra A B] [Algebra B A] [Algebra B C] [Algebra A D] [Algebra B Q] (a : A),
      (∀ f : B, algebraMap B Q (algebraMap A B (algebraMap B A f)) = algebraMap B Q f) →
      IsUnit (algebraMap B Q (algebraMap A B a)) →
      ∀ (κ : TensorProduct B A C →ₐ[A] D)
        (g : D →ₐ[A] Localization.Away (algebraMap A (TensorProduct B A C) a)),
      (∀ y, g (κ y) = algebraMap (TensorProduct B A C)
        (Localization.Away (algebraMap A (TensorProduct B A C) a)) y) →
      ∀ (ε : C →ₐ[B] Q),
      ∃ θ : D →+* Q, (∀ x : A, θ (algebraMap A D x) = algebraMap B Q (algebraMap A B x)) ∧
        ∀ s : C, θ (κ ((1 : A) ⊗ₜ[B] s)) = ε s := by
    intro A B C D Q _ _ _ _ _ _ _ _ _ _ a hι hu κ g hg ε
    let ι : A →ₐ[B] Q :=
      { toRingHom := (algebraMap B Q).comp (algebraMap A B)
        commutes' := fun f => hι f }
    let κ₀ : TensorProduct B A C →ₐ[B] Q := Algebra.TensorProduct.productMap ι ε
    have hκ₀ : ∀ x : A, κ₀ (algebraMap A (TensorProduct B A C) x) =
        algebraMap B Q (algebraMap A B x) := by
      intro x
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.productMap_apply_tmul,
        map_one, mul_one]
      rfl
    have hunit : IsUnit (κ₀.toRingHom (algebraMap A (TensorProduct B A C) a)) := by
      show IsUnit (κ₀ (algebraMap A (TensorProduct B A C) a))
      rw [hκ₀]
      exact hu
    let lam := IsLocalization.Away.lift
      (S := Localization.Away (algebraMap A (TensorProduct B A C) a))
      (algebraMap A (TensorProduct B A C) a) hunit
    refine ⟨lam.comp g.toRingHom, ?_, ?_⟩
    · intro x
      show lam (g (algebraMap A D x)) = _
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply A (TensorProduct B A C)
        (Localization.Away (algebraMap A (TensorProduct B A C) a)), IsLocalization.Away.lift_eq]
      exact hκ₀ x
    · intro s
      show lam (g (κ ((1 : A) ⊗ₜ[B] s))) = _
      rw [hg, IsLocalization.Away.lift_eq]
      show κ₀ ((1 : A) ⊗ₜ[B] s) = ε s
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]

  have t6 : ∀ (A B D V : Type u) [CommRing A] [CommRing B] [CommRing D] [CommRing V] [Algebra A B]
      [Algebra A D] [Algebra B V] (a : A)
      [Algebra.FormallyUnramified A (Localization ((Submonoid.powers a).map (algebraMap A D)))],
      IsUnit (algebraMap B V (algebraMap A B a)) → ∀ (I₀ : Ideal B) (I : Ideal V), IsNilpotent I →
      ∀ (f g : (TensorProduct A B D ⧸ Ideal.map (algebraMap B (TensorProduct A B D)) I₀) →ₐ[B] V),
      (∀ d : D, f (Ideal.Quotient.mk (Ideal.map (algebraMap B (TensorProduct A B D)) I₀)
        ((1 : B) ⊗ₜ[A] d)) - g (Ideal.Quotient.mk (Ideal.map (algebraMap B (TensorProduct A B D)) I₀)
        ((1 : B) ⊗ₜ[A] d)) ∈ I) → f = g := by
    intro A B D V _ _ _ _ _ _ _ a _ hu I₀ I hI f g h
    letI : Algebra A V := ((algebraMap B V).comp (algebraMap A B)).toAlgebra
    haveI : IsScalarTower A B V := IsScalarTower.of_algebraMap_eq' rfl
    let F := f.comp (Ideal.Quotient.mkₐ B (Ideal.map (algebraMap B (TensorProduct A B D)) I₀))
    let G := g.comp (Ideal.Quotient.mkₐ B (Ideal.map (algebraMap B (TensorProduct A B D)) I₀))
    have h0 : (F.restrictScalars A).comp Algebra.TensorProduct.includeRight =
        (G.restrictScalars A).comp Algebra.TensorProduct.includeRight :=
      t2 A D V a hu I hI _ _ (fun d => h d)
    have hFG : F = G := by
      apply Algebra.TensorProduct.ext
      · apply AlgHom.ext
        intro b
        exact ((F.comp Algebra.TensorProduct.includeLeft).commutes b).trans
          ((G.comp Algebra.TensorProduct.includeLeft).commutes b).symm
      · exact h0
    exact Ideal.Quotient.algHom_ext B hFG

  have tmain : ∀ (A B C D : Type u) [CommRing A] [CommRing B] [CommRing C] [CommRing D]
      [Algebra A B] [Algebra B A] [Algebra B C] [Algebra A D] (J : Ideal B) (a : A) (N : ℕ),
      (∀ f : B, f - algebraMap A B (algebraMap B A f) ∈ J) →
      wcCg2LocEtale (algebraMap B C) (Submonoid.powers (algebraMap A B a)) →
      wcCg2LocEtale (algebraMap A D) (Submonoid.powers a) →
      (∀ y : TensorProduct B A C, ∃ s : C, y = (1 : A) ⊗ₜ[B] s) →
      ∀ (κ : TensorProduct B A C →ₐ[A] D),
      (∀ x : D, ∃ (n : ℕ) (y : TensorProduct B A C), a ^ n • x = κ y) →
      ∀ (g : D →ₐ[A] Localization.Away (algebraMap A (TensorProduct B A C) a)),
      (∀ y, g (κ y) = algebraMap (TensorProduct B A C)
        (Localization.Away (algebraMap A (TensorProduct B A C) a)) y) →
      ∀ (φ : C →ₐ[B] (TensorProduct A B D ⧸ Ideal.map (algebraMap B (TensorProduct A B D)) (J ^ N))),
      (∀ (s : C) (x : TensorProduct A B D),
        Ideal.Quotient.mk (Ideal.map (algebraMap B (TensorProduct A B D)) (J ^ N)) x = φ s →
        x - (1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s) ∈ Ideal.map (algebraMap B (TensorProduct A B D)) J) →
      (∀ z : C, φ z = 0 → ∃ K : ℕ, (algebraMap A B a) ^ K • z ∈ Ideal.map (algebraMap B C) (J ^ N)) ∧
      (∀ y : TensorProduct A B D, ∃ (K : ℕ) (z : C),
        Ideal.Quotient.mk (Ideal.map (algebraMap B (TensorProduct A B D)) (J ^ N))
          ((algebraMap A B a) ^ K • y) = φ z) := by
    intro A B C D _ _ _ _ _ _ _ _ J a N h0 hCc hDc hsurj0 κ hkc g hg φ hφκ
    haveI hCet : Algebra.FormallyEtale B
        (Localization ((Submonoid.powers (algebraMap A B a)).map (algebraMap B C))) :=
      t1 B C _ hCc
    haveI hDet : Algebra.FormallyEtale A
        (Localization ((Submonoid.powers a).map (algebraMap A D))) :=
      t1 A D _ hDc
    set α : B := algebraMap A B a with hα
    let Cα := Localization ((Submonoid.powers α).map (algebraMap B C))
    let IC : Ideal Cα := Ideal.map (algebraMap B Cα) (J ^ N)
    let W := Cα ⧸ IC
    have hWu : IsUnit (algebraMap B W α) := by
      rw [IsScalarTower.algebraMap_apply B Cα W, IsScalarTower.algebraMap_apply B C Cα]
      exact (IsLocalization.map_units Cα
        (⟨algebraMap B C α, α, Submonoid.mem_powers α, rfl⟩ :
          (Submonoid.powers α).map (algebraMap B C))).map _
    have hJW : ∀ j ∈ J ^ N, algebraMap B W j = 0 := by
      intro j hj
      rw [IsScalarTower.algebraMap_apply B Cα W]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hj)
    let I : Ideal W := Ideal.map (algebraMap B W) J
    have hInil : IsNilpotent I := t9 B W J N hJW
    letI : CommRing (W ⧸ I) := Ideal.Quotient.commRing I
    letI : Algebra B (W ⧸ I) := Ideal.Quotient.algebra B
    have hJQ : ∀ j ∈ J, algebraMap B (W ⧸ I) j = 0 := by
      intro j hj
      rw [IsScalarTower.algebraMap_apply B W (W ⧸ I)]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hj)
    have hQu : IsUnit (algebraMap B (W ⧸ I) (algebraMap A B a)) := by
      rw [IsScalarTower.algebraMap_apply B W (W ⧸ I)]
      exact hWu.map _
    let ε : C →ₐ[B] (W ⧸ I) := (IsScalarTower.toAlgHom B W (W ⧸ I)).comp
      ((IsScalarTower.toAlgHom B Cα W).comp (IsScalarTower.toAlgHom B C Cα))
    have hι : ∀ f : B, algebraMap B (W ⧸ I) (algebraMap A B (algebraMap B A f)) =
        algebraMap B (W ⧸ I) f := by
      intro f
      have := hJQ _ (h0 f)
      rw [map_sub, sub_eq_zero] at this
      exact this.symm
    obtain ⟨θ, hθA, hθκ⟩ := t4 A B C D (W ⧸ I) a hι hQu κ g hg ε
    obtain ⟨hb, hhb⟩ := t3 A B D W a hWu (J ^ N) hJW I hInil θ hθA
    let E := TensorProduct A B D
    let IE : Ideal E := Ideal.map (algebraMap B E) (J ^ N)
    let F : E →ₐ[B] W := hb.comp (Ideal.Quotient.mkₐ B IE)
    have hstar : ∀ s : C, F ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s)) -
        algebraMap Cα W (algebraMap C Cα s) ∈ I := by
      intro s
      apply Ideal.Quotient.eq.mp
      have h1 : Ideal.Quotient.mk I (F ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s))) =
          θ (κ ((1 : A) ⊗ₜ[B] s)) := hhb _
      rw [h1, hθκ]
      rfl
    have hu12 : hb.comp φ =
        (IsScalarTower.toAlgHom B Cα W).comp (IsScalarTower.toAlgHom B C Cα) := by
      apply t2 B C W α hWu I hInil
      intro s
      obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (φ s)
      have h1 := t10 B E W F J x _ (hφκ s x hx)
      have hFx : F x = hb (φ s) := by
        show hb (Ideal.Quotient.mk IE x) = hb (φ s)
        rw [hx]
      have e : (hb.comp φ) s - ((IsScalarTower.toAlgHom B Cα W).comp
          (IsScalarTower.toAlgHom B C Cα)) s =
          (F x - F ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s))) +
          (F ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s)) - algebraMap Cα W (algebraMap C Cα s)) := by
        rw [hFx]
        simp only [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom']
        ring
      rw [e]
      exact add_mem h1 (hstar s)
    have hdag : ∀ s : C, hb (φ s) = algebraMap Cα W (algebraMap C Cα s) :=
      fun s => AlgHom.congr_fun hu12 s
    refine ⟨?_, ?_⟩
    · intro z hz
      apply t7 B C α (J ^ N) z
      have := hdag z
      rw [hz, map_zero] at this
      exact Ideal.Quotient.eq_zero_iff_mem.mp this.symm
    · let En := E ⧸ IE
      have hJE : ∀ j ∈ J ^ N, algebraMap B En j = 0 := by
        intro j hj
        rw [IsScalarTower.algebraMap_apply B E En]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hj)
      obtain ⟨φ', hφ'⟩ := t8 B C En α (J ^ N) φ hJE
      let Vt := Localization ((Submonoid.powers α).map (algebraMap B En))
      have hVu : IsUnit (algebraMap B Vt α) := by
        rw [IsScalarTower.algebraMap_apply B En Vt]
        exact IsLocalization.map_units Vt
          (⟨algebraMap B En α, α, Submonoid.mem_powers α, rfl⟩ :
            (Submonoid.powers α).map (algebraMap B En))
      have hJV : ∀ j ∈ J ^ N, algebraMap B Vt j = 0 := by
        intro j hj
        rw [IsScalarTower.algebraMap_apply B En Vt, hJE j hj, map_zero]
      let I' : Ideal Vt := Ideal.map (algebraMap B Vt) J
      have hI'nil : IsNilpotent I' := t9 B Vt J N hJV
      let f1 : En →ₐ[B] Vt := φ'.comp hb
      let f2 : En →ₐ[B] Vt := IsScalarTower.toAlgHom B En Vt
      have hkey : ∀ s : C, f1 (Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s))) -
          f2 (Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s))) ∈ I' := by
        intro s
        obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (φ s)
        have i1 := t10 B W Vt φ' J _ _ (hstar s)
        have i2 : φ' (algebraMap Cα W (algebraMap C Cα s)) =
            f2 (Ideal.Quotient.mk IE x) := by
          have := hφ' s
          rw [← hx] at this
          exact this
        have i3 := t10 B E Vt (f2.comp (Ideal.Quotient.mkₐ B IE)) J _ _ (hφκ s x hx)
        have e : f1 (Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s))) -
            f2 (Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s))) =
            (φ' (F ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s))) -
              φ' (algebraMap Cα W (algebraMap C Cα s))) +
            ((f2.comp (Ideal.Quotient.mkₐ B IE)) x -
              (f2.comp (Ideal.Quotient.mkₐ B IE)) ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s))) := by
          rw [i2]
          show φ' (hb (Ideal.Quotient.mk IE _)) - f2 (Ideal.Quotient.mk IE _) =
            (φ' (hb (Ideal.Quotient.mk IE _)) - f2 (Ideal.Quotient.mk IE x)) +
            (f2 (Ideal.Quotient.mk IE x) - f2 (Ideal.Quotient.mk IE _))
          ring
        rw [e]
        exact add_mem i1 i3
      have hΔ : ∀ d : D, f1 (Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] d)) -
          f2 (Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] d)) ∈ I' := by
        intro d
        obtain ⟨k, y, hky⟩ := hkc d
        obtain ⟨s, rfl⟩ := hsurj0 y
        have hsc : Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] κ ((1 : A) ⊗ₜ[B] s)) =
            α ^ k • Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] d) := by
          rw [← hky, TensorProduct.tmul_smul, ← IsScalarTower.algebraMap_smul B (a ^ k), map_pow]
          exact map_smul (Ideal.Quotient.mkₐ B IE) _ _
        have h1 := hkey s
        rw [hsc, map_smul, map_smul, ← smul_sub, Algebra.smul_def] at h1
        have hv : IsUnit (algebraMap B Vt (α ^ k)) := by rw [map_pow]; exact hVu.pow k
        have e : f1 (Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] d)) -
            f2 (Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] d)) =
            ((hv.unit⁻¹ : Vtˣ) : Vt) * (algebraMap B Vt (α ^ k) *
              (f1 (Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] d)) -
                f2 (Ideal.Quotient.mk IE ((1 : B) ⊗ₜ[A] d)))) := by
          rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
        rw [e]
        exact Ideal.mul_mem_left _ _ h1
      have hsec : f1 = f2 := t6 A B D Vt a hVu (J ^ N) I' hI'nil f1 f2 hΔ
      intro y
      obtain ⟨K, z, hKz⟩ := t11 B C En α (J ^ N) φ φ' hφ'
        (fun w => ⟨hb w, AlgHom.congr_fun hsec w⟩) (Ideal.Quotient.mk IE y)
      refine ⟨K, z, ?_⟩
      rw [← hKz]
      exact map_smul (Ideal.Quotient.mkₐ B IE) _ _

  have hAB : ∀ x : A, algebraMap A (MvPowerSeries (Fin e) A) x =
      MvPowerSeries.C (σ := Fin e) (R := A) x := fun x => MvPowerSeries.algebraMap_apply
  obtain ⟨hK, hS⟩ := tmain A (MvPowerSeries (Fin e) A) C D
    (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A)))) a (n + 1)
    (fun f => by rw [hAB]; exact h0 f) (by rw [hAB]; exact hCc) hDc hsurj0 κ hkc g hg φ hφκ
  refine ⟨fun z hz => ?_, fun y => ?_⟩
  · obtain ⟨K, hK'⟩ := hK z hz
    rw [hAB] at hK'
    exact ⟨K, hK'⟩
  · obtain ⟨K, z, hz⟩ := hS y
    rw [hAB] at hz
    exact ⟨K, z, hz⟩

theorem wc_cfi_formal_functions : ∀ (B : Type u) [CommRing B] (J : Ideal B) (γ δ : B) (C E : Type u) [CommRing C] [Algebra B C] [CommRing E] [Algebra B E] (Ψ : C →ₗ[B] E) (r N : ℕ) (ι : C →ₗ[B] (Fin r → B)) (ρ : (Fin r → B) →ₗ[B] C), (∀ z, ρ (ι z) = γ ^ N • z) → IsSMulRegular C γ → (∀ (n K : ℕ) (u : B), γ ^ K * u ∈ J ^ n → u ∈ J ^ n) → (∀ (n i j : ℕ) (u v : B), δ ^ j * u - γ ^ i * v ∈ J ^ n → ∃ w, u - γ ^ i * w ∈ J ^ n) → (∀ u : B, (∀ n : ℕ, u ∈ J ^ n) → u = 0) → (∀ x : ℕ → B, (∀ n, x (n + 1) - x n ∈ J ^ n) → ∃ x', ∀ n, x' - x n ∈ J ^ n) → (∀ (n K : ℕ) (y : E), γ ^ K • y ∈ Ideal.map (algebraMap B E) (J ^ n) → y ∈ Ideal.map (algebraMap B E) (J ^ n)) → (∀ y : E, (∀ n : ℕ, y ∈ Ideal.map (algebraMap B E) (J ^ n)) → y = 0) → (∀ (n : ℕ) (z : C), Ψ z ∈ Ideal.map (algebraMap B E) (J ^ n) → ∃ K : ℕ, γ ^ K • z ∈ Ideal.map (algebraMap B C) (J ^ n)) → (∀ (n : ℕ) (y : E), ∃ (K : ℕ) (z : C), γ ^ K • y - Ψ z ∈ Ideal.map (algebraMap B E) (J ^ n)) → (∀ (n : ℕ) (y : E), ∃ (K : ℕ) (z : C), δ ^ K • y - Ψ z ∈ Ideal.map (algebraMap B E) (J ^ n)) → Function.Injective Ψ ∧ ∀ y : E, ∃ (K : ℕ) (z : C), Ψ z = γ ^ K • y :=
by
  intro B _ J γ δ C E _ _ _ _ Ψ r N ι ρ hρι hCreg hBreg hBweak hBsep hBcomp hEreg hEsep hker hγ hδ

  have memC : ∀ (n : ℕ) (z : C), z ∈ Ideal.map (algebraMap B C) (J ^ n) ↔
      z ∈ (J ^ n) • (⊤ : Submodule B C) := by
    intro n z
    rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
  have memE : ∀ (n : ℕ) (y : E), y ∈ Ideal.map (algebraMap B E) (J ^ n) ↔
      y ∈ (J ^ n) • (⊤ : Submodule B E) := by
    intro n y
    rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
  have hsmulE : ∀ (n : ℕ) (b : B) (y : E), y ∈ Ideal.map (algebraMap B E) (J ^ n) →
      b • y ∈ Ideal.map (algebraMap B E) (J ^ n) := by
    intro n b y hy
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ hy
  have hΨJ : ∀ (n : ℕ) (z : C), z ∈ Ideal.map (algebraMap B C) (J ^ n) →
      Ψ z ∈ Ideal.map (algebraMap B E) (J ^ n) := by
    intro n z hz
    rw [memC] at hz
    rw [memE]
    refine Submodule.smul_induction_on (p := fun x => Ψ x ∈ (J ^ n) • (⊤ : Submodule B E)) hz ?_ ?_
    · intro a ha m _
      rw [map_smul]
      exact Submodule.smul_mem_smul ha Submodule.mem_top
    · intro x y hx hy
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  have hιJ : ∀ (n : ℕ) (z : C), z ∈ Ideal.map (algebraMap B C) (J ^ n) → ∀ i, ι z i ∈ J ^ n := by
    intro n z hz
    rw [memC] at hz
    refine Submodule.smul_induction_on (p := fun x => ∀ i, ι x i ∈ J ^ n) hz ?_ ?_
    · intro a ha m _ i
      rw [map_smul, Pi.smul_apply, smul_eq_mul]
      exact Ideal.mul_mem_right _ _ ha
    · intro x y hx hy i
      rw [map_add, Pi.add_apply]
      exact Ideal.add_mem _ (hx i) (hy i)
  have hρJ : ∀ (n : ℕ) (w : Fin r → B), (∀ i, w i ∈ J ^ n) →
      ρ w ∈ Ideal.map (algebraMap B C) (J ^ n) := by
    intro n w hw
    rw [memC]
    rw [pi_eq_sum_univ w, map_sum]
    refine Submodule.sum_mem _ (fun i _ => ?_)
    rw [map_smul]
    exact Submodule.smul_mem_smul (hw i) Submodule.mem_top

  have hinj : Function.Injective Ψ := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    have hι0 : ι z = 0 := by
      funext i
      show ι z i = 0
      apply hBsep
      intro n
      obtain ⟨K, hK⟩ := hker n z (by rw [hz]; exact Submodule.zero_mem _)
      have h := hιJ n _ hK i
      rw [map_smul, Pi.smul_apply, smul_eq_mul] at h
      exact hBreg n K _ h
    have h1 : γ ^ N • z = γ ^ N • (0 : C) := by rw [← hρι, hι0, map_zero, smul_zero]
    exact hCreg.pow N h1

  have hunif : ∀ (n : ℕ) (y : E), ∃ v : C,
      γ ^ N • y - Ψ v ∈ Ideal.map (algebraMap B E) (J ^ n) := by
    intro n y
    obtain ⟨K, z, hz⟩ := hγ n y
    obtain ⟨L, z', hz'⟩ := hδ n y
    have h2 : Ψ (δ ^ L • z - γ ^ K • z') ∈ Ideal.map (algebraMap B E) (J ^ n) := by
      have e : Ψ (δ ^ L • z - γ ^ K • z') =
          δ ^ L • (-(γ ^ K • y - Ψ z)) + γ ^ K • (δ ^ L • y - Ψ z') := by
        simp only [map_sub, map_smul, smul_neg, smul_sub]
        rw [smul_comm (δ ^ L) (γ ^ K) y]
        abel
      rw [e]
      exact Ideal.add_mem _ (hsmulE _ _ _ (neg_mem hz)) (hsmulE _ _ _ hz')
    obtain ⟨M, hM⟩ := hker n _ h2
    have hcoord : ∀ i, δ ^ L * (γ ^ M * ι z i) - γ ^ (K + M) * ι z' i ∈ J ^ n := by
      intro i
      have e : δ ^ L * (γ ^ M * ι z i) - γ ^ (K + M) * ι z' i =
          ι (γ ^ M • (δ ^ L • z - γ ^ K • z')) i := by
        simp only [map_smul, map_sub, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
        ring
      rw [e]
      exact hιJ n _ hM i
    have hw : ∀ i, ∃ w, ι z i - γ ^ K * w ∈ J ^ n := by
      intro i
      obtain ⟨w, hw⟩ := hBweak n (K + M) L _ _ (hcoord i)
      refine ⟨w, hBreg n M _ ?_⟩
      have e : γ ^ M * (ι z i - γ ^ K * w) = γ ^ M * ι z i - γ ^ (K + M) * w := by ring
      rw [e]
      exact hw
    choose w hw using hw
    refine ⟨ρ w, hEreg n K _ ?_⟩
    have h3 : ρ (ι z - γ ^ K • w) ∈ Ideal.map (algebraMap B C) (J ^ n) := hρJ n _ (fun i => by
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
      exact hw i)
    have h4 := hΨJ n _ h3
    have e : γ ^ K • (γ ^ N • y - Ψ (ρ w)) =
        γ ^ N • (γ ^ K • y - Ψ z) + Ψ (ρ (ι z - γ ^ K • w)) := by
      simp only [map_sub, map_smul, hρι, smul_sub]
      rw [smul_comm (γ ^ K) (γ ^ N) y]
      abel
    rw [e]
    exact Ideal.add_mem _ (hsmulE _ _ _ hz) h4

  refine ⟨hinj, fun y => ?_⟩
  choose v hv using fun n => hunif n y
  have hcauchy : ∀ i n, ι (v (n + 1)) i - ι (v n) i ∈ J ^ n := by
    intro i n
    have h1 : Ψ (v (n + 1) - v n) ∈ Ideal.map (algebraMap B E) (J ^ n) := by
      have e : Ψ (v (n + 1) - v n) = (γ ^ N • y - Ψ (v n)) - (γ ^ N • y - Ψ (v (n + 1))) := by
        rw [map_sub]
        abel
      rw [e]
      exact Ideal.sub_mem _ (hv n)
        (Ideal.map_mono (Ideal.pow_le_pow_right (Nat.le_succ n)) (hv (n + 1)))
    obtain ⟨M, hM⟩ := hker n _ h1
    apply hBreg n M
    have e : γ ^ M * (ι (v (n + 1)) i - ι (v n) i) = ι (γ ^ M • (v (n + 1) - v n)) i := by
      simp only [map_smul, map_sub, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
    rw [e]
    exact hιJ n _ hM i
  choose u hu using fun i => hBcomp (fun n => ι (v n) i) (hcauchy i)
  refine ⟨N + N, ρ u, sub_eq_zero.mp (hEsep _ (fun n => ?_))⟩
  have h1 : ρ (u - ι (v n)) ∈ Ideal.map (algebraMap B C) (J ^ n) := hρJ n _ (fun i => by
    rw [Pi.sub_apply]
    exact hu i n)
  have e : Ψ (ρ u) - γ ^ (N + N) • y =
      Ψ (ρ (u - ι (v n))) - γ ^ N • (γ ^ N • y - Ψ (v n)) := by
    simp only [map_sub, map_smul, hρι, smul_sub, pow_add, mul_smul]
    abel
  rw [e]
  exact Ideal.sub_mem _ (hΨJ n _ h1) (hsmulE _ _ _ (hv n))

theorem wc_cfp_formal_iso : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (e : ℕ) (C : Type u) [CommRing C] [Algebra (MvPowerSeries (Fin e) A) C] [Module.Finite (MvPowerSeries (Fin e) A) C] (D : Type u) [CommRing D] [Algebra A D] [Module.Finite A D] (a b : A), a ∈ IsLocalRing.maximalIdeal A → b ∈ IsLocalRing.maximalIdeal A → Module.Flat A (MvPowerSeries (Fin e) A) → wcCg2HP A A a b → wcCg2HP (MvPowerSeries (Fin e) A) C (MvPowerSeries.C (σ := Fin e) (R := A) a) (MvPowerSeries.C (σ := Fin e) (R := A) b) → wcCg2LocEtale (algebraMap (MvPowerSeries (Fin e) A) C) (Submonoid.powers (MvPowerSeries.C (σ := Fin e) (R := A) a)) → wcCg2LocEtale (algebraMap (MvPowerSeries (Fin e) A) C) (Submonoid.powers (MvPowerSeries.C (σ := Fin e) (R := A) b)) → wcCg2HP A D a b → wcCg2LocEtale (algebraMap A D) (Submonoid.powers a) → wcCg2LocEtale (algebraMap A D) (Submonoid.powers b) → letI : Algebra (MvPowerSeries (Fin e) A) A := (MvPowerSeries.constantCoeff (σ := Fin e) (R := A)).toAlgebra; ∀ κ : TensorProduct (MvPowerSeries (Fin e) A) A C →ₐ[A] D, (∀ x : D, ∃ (n : ℕ) (y : TensorProduct (MvPowerSeries (Fin e) A) A C), a ^ n • x = κ y) → (∀ y : TensorProduct (MvPowerSeries (Fin e) A) A C, κ y = 0 → ∃ n : ℕ, a ^ n • y = 0) → (∀ x : D, ∃ (n : ℕ) (y : TensorProduct (MvPowerSeries (Fin e) A) A C), b ^ n • x = κ y) → (∀ y : TensorProduct (MvPowerSeries (Fin e) A) A C, κ y = 0 → ∃ n : ℕ, b ^ n • y = 0) → Nonempty (TensorProduct A (MvPowerSeries (Fin e) A) D ≃ₐ[MvPowerSeries (Fin e) A] C) :=
by
  intro A _ _ _ e C _ _ _ D _ _ _ a b ha hb hflat hA hC hCa hCb hD hDa hDb κ hk1 hk2 hk3 hk4
  letI : Algebra (MvPowerSeries (Fin e) A) A :=
    (MvPowerSeries.constantCoeff (σ := Fin e) (R := A)).toAlgebra
  classical
  obtain ⟨hB0, _hBcrit, hBa, hBb, hBweak, hBsep, hBcomp⟩ := wc_cfi_powerSeries_facts A e a b hA
  obtain ⟨τ, hτbij, hτ, hτJ⟩ := wc_cfi_tensor_coeff_equiv A e D
  obtain ⟨hEa, hEb, hEweak, hEsep, hEcomp⟩ :=
    wc_cfi_tensor_hp_facts A e D a b τ hτbij hτ hτJ hD
  obtain ⟨hsurj0, hker0⟩ := wc_cfi_special_fibre A e C hB0
  obtain ⟨ga, hga⟩ :=
    wc_cfi_chart_inverse A (TensorProduct (MvPowerSeries (Fin e) A) A C) D a κ hk1 hk2
  obtain ⟨gb, hgb⟩ :=
    wc_cfi_chart_inverse A (TensorProduct (MvPowerSeries (Fin e) A) A C) D b κ hk3 hk4
  obtain ⟨φ, hφc, hφκ⟩ := wc_cfi_level_maps A e C D a b hB0 hCa hCb hEa hEb hEweak κ
  obtain ⟨Ψ, hΨ⟩ := wc_cfi_limit_map (MvPowerSeries (Fin e) A) C
    (TensorProduct A (MvPowerSeries (Fin e) A) D)
    (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A)))) hEsep hEcomp φ hφc
  have chart : ∀ c : A,
      wcCg2LocEtale (algebraMap (MvPowerSeries (Fin e) A) C)
        (Submonoid.powers (MvPowerSeries.C (σ := Fin e) (R := A) c)) →
      wcCg2LocEtale (algebraMap A D) (Submonoid.powers c) →
      (∀ x : D, ∃ (n : ℕ) (y : TensorProduct (MvPowerSeries (Fin e) A) A C), c ^ n • x = κ y) →
      ∀ g : D →ₐ[A] Localization.Away (algebraMap A (TensorProduct (MvPowerSeries (Fin e) A) A C) c),
      (∀ y, g (κ y) = algebraMap (TensorProduct (MvPowerSeries (Fin e) A) A C)
        (Localization.Away (algebraMap A (TensorProduct (MvPowerSeries (Fin e) A) A C) c)) y) →
      (∀ (n : ℕ) (z : C), Ψ.toLinearMap z ∈ Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
          (TensorProduct A (MvPowerSeries (Fin e) A) D))
          (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n) →
        ∃ K : ℕ, (MvPowerSeries.C (σ := Fin e) (R := A) c) ^ K • z ∈
          Ideal.map (algebraMap (MvPowerSeries (Fin e) A) C)
          (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) ∧
      (∀ (n : ℕ) (y : TensorProduct A (MvPowerSeries (Fin e) A) D), ∃ (K : ℕ) (z : C),
        (MvPowerSeries.C (σ := Fin e) (R := A) c) ^ K • y - Ψ.toLinearMap z ∈
          Ideal.map (algebraMap (MvPowerSeries (Fin e) A)
          (TensorProduct A (MvPowerSeries (Fin e) A) D))
          (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))) ^ n)) := by
    intro c hCc hDc hkc g hg
    constructor
    · intro n z hz
      cases n with
      | zero =>
        exact ⟨0, by simp only [pow_zero, Ideal.one_eq_top, Ideal.map_top, Submodule.mem_top]⟩
      | succ m =>
        have h0 : φ m z = 0 := by
          rw [← hΨ m z]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hz
        exact (wc_cfi_level_chart_iso A e C D c hB0 hCc hDc hsurj0 hker0 κ hkc g hg m (φ m)
          (hφκ m)).1 z h0
    · intro n y
      cases n with
      | zero =>
        exact ⟨0, 0, by simp only [pow_zero, Ideal.one_eq_top, Ideal.map_top, Submodule.mem_top]⟩
      | succ m =>
        obtain ⟨K, z, hKz⟩ := (wc_cfi_level_chart_iso A e C D c hB0 hCc hDc hsurj0 hker0 κ hkc g
          hg m (φ m) (hφκ m)).2 y
        refine ⟨K, z, ?_⟩
        rw [← hΨ m z] at hKz
        exact Ideal.Quotient.eq.mp hKz
  obtain ⟨hkerα, hsurjα⟩ := chart a hCa hDa hk1 ga hga
  obtain ⟨hkerβ, hsurjβ⟩ := chart b hCb hDb hk3 gb hgb
  obtain ⟨rα, Nα, ια, ρα, hρα⟩ := wc_cfi_retraction (MvPowerSeries (Fin e) A) C _ hCa hC.1
  obtain ⟨rβ, Nβ, ιβ, ρβ, hρβ⟩ := wc_cfi_retraction (MvPowerSeries (Fin e) A) C _ hCb hC.2.1
  obtain ⟨hinj, hα⟩ := wc_cfi_formal_functions (MvPowerSeries (Fin e) A)
    (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))))
    (MvPowerSeries.C (σ := Fin e) (R := A) a) (MvPowerSeries.C (σ := Fin e) (R := A) b) C
    (TensorProduct A (MvPowerSeries (Fin e) A) D) Ψ.toLinearMap rα Nα ια ρα hρα hC.1 hBa
    (fun n i j u v h => (hBweak n i j u v h).imp fun w hw => hw.1) hBsep hBcomp hEa hEsep
    hkerα hsurjα hsurjβ
  obtain ⟨_, hβ⟩ := wc_cfi_formal_functions (MvPowerSeries (Fin e) A)
    (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin e) (R := A))))
    (MvPowerSeries.C (σ := Fin e) (R := A) b) (MvPowerSeries.C (σ := Fin e) (R := A) a) C
    (TensorProduct A (MvPowerSeries (Fin e) A) D) Ψ.toLinearMap rβ Nβ ιβ ρβ hρβ hC.2.1 hBb
    (fun n i j u v h => (hBweak n j i v u (by rw [← neg_sub]; exact neg_mem h)).imp
      fun w hw => hw.2) hBsep hBcomp hEb hEsep hkerβ hsurjβ hsurjα
  have hsurj : Function.Surjective Ψ := by
    intro y
    obtain ⟨K, z, hz⟩ := hα y
    obtain ⟨L, z', hz'⟩ := hβ y
    have h1 : MvPowerSeries.C (σ := Fin e) (R := A) b ^ L • z =
        MvPowerSeries.C (σ := Fin e) (R := A) a ^ K • z' := by
      apply hinj
      rw [map_smul, map_smul, hz, hz', smul_comm]
    have hart : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M] (p q : R),
        wcCg2HP R M p q → ∀ (K L : ℕ) (z z' : M), q ^ L • z = p ^ K • z' →
          ∃ w, z = p ^ K • w := by
      intro R M _ _ _ p q hpq
      obtain ⟨hp, -, hw⟩ := hpq
      have step1 : ∀ (L : ℕ) (z z' : M), q ^ L • z = p • z' → ∃ w, z = p • w := by
        intro L
        induction L with
        | zero => intro z z' h; exact ⟨z', by rwa [pow_zero, one_smul] at h⟩
        | succ L ih =>
          intro z z' h
          obtain ⟨k, hk⟩ := hw (q ^ L • z) z' (by rw [smul_smul, ← pow_succ']; exact h)
          exact ih z k hk
      intro K
      induction K with
      | zero => intro L z z' _; exact ⟨z, by rw [pow_zero, one_smul]⟩
      | succ K ih =>
        intro L z z' h
        obtain ⟨w1, hw1⟩ := step1 L z (p ^ K • z') (by rw [h, pow_succ', mul_smul])
        have h2 : q ^ L • w1 = p ^ K • z' := by
          apply hp
          show p • (q ^ L • w1) = p • (p ^ K • z')
          rw [smul_comm, ← hw1, h, pow_succ', mul_smul]
        obtain ⟨w, hw⟩ := ih L w1 z' h2
        exact ⟨w, by rw [hw1, hw, smul_smul, ← pow_succ']⟩
    obtain ⟨w, hw⟩ := hart _ C _ _ hC K L z z' h1
    refine ⟨w, ?_⟩
    have h2 : MvPowerSeries.C (σ := Fin e) (R := A) a ^ K • (Ψ.toLinearMap w - y) = 0 := by
      rw [smul_sub, ← map_smul Ψ.toLinearMap, ← hw, hz, sub_self]
    have h3 : Ψ.toLinearMap w - y = 0 :=
      hEsep _ (fun n => hEa n K _ (by rw [h2]; exact Submodule.zero_mem _))
    exact sub_eq_zero.mp h3
  exact ⟨(AlgEquiv.ofBijective Ψ ⟨hinj, hsurj⟩).symm⟩

theorem wc_cfp_locEtale_tensor_transport : ∀ (A B D C : Type u) [CommRing A] [CommRing B] [CommRing D] [CommRing C] [Algebra A B] [Algebra A D] [Algebra B C] (Ψ : TensorProduct A B D ≃ₐ[B] C) (Q : Ideal B) [Q.IsPrime], wcCg2LocEtale (algebraMap B C) Q.primeCompl → Algebra.Etale (Localization.AtPrime Q) (TensorProduct A (Localization.AtPrime Q) D) :=
by
  intro A B D C _ _ _ _ _ _ _ Ψ Q _ h
  classical
  have s3 : ∀ (R S : Type u) [CommRing R] [IsLocalRing R] [CommRing S] [Algebra R S],
      wcCg2LocEtale (algebraMap R S) (IsLocalRing.maximalIdeal R).primeCompl →
      Algebra.Etale R S := by
    intro R S _ _ _ _ h
    have hM : (IsLocalRing.maximalIdeal R).primeCompl ≤ IsUnit.submonoid R := fun s hs =>
      (IsUnit.mem_submonoid_iff s).mpr (IsLocalRing.notMem_maximalIdeal.mp hs)
    have hM' : (IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S) ≤
        IsUnit.submonoid S := by
      rintro _ ⟨s, hs, rfl⟩
      exact (IsUnit.mem_submonoid_iff _).mpr
        (((IsUnit.mem_submonoid_iff s).mp (hM hs)).map (algebraMap R S))
    let e1 := IsLocalization.atUnits R (IsLocalRing.maximalIdeal R).primeCompl
      (S := Localization (IsLocalRing.maximalIdeal R).primeCompl) hM
    let e2 := IsLocalization.atUnits S ((IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S))
      (S := Localization ((IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S))) hM'
    have hE1 := RingHom.Etale.respectsIso.2 _ e1.toRingEquiv h
    have hE2 := RingHom.Etale.respectsIso.1 _ e2.symm.toRingEquiv hE1
    have heq : algebraMap R S = e2.symm.toRingEquiv.toRingHom.comp
        ((IsLocalization.map (Localization ((IsLocalRing.maximalIdeal R).primeCompl.map
          (algebraMap R S))) (algebraMap R S) (IsLocalRing.maximalIdeal R).primeCompl.le_comap_map :
          Localization (IsLocalRing.maximalIdeal R).primeCompl →+*
            Localization ((IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S))).comp
          e1.toRingEquiv.toRingHom) := by
      ext1 r
      have h1' : e1 r = algebraMap R (Localization (IsLocalRing.maximalIdeal R).primeCompl) r :=
        e1.commutes r
      have h2' : e2 (algebraMap R S r) = algebraMap S
          (Localization ((IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S)))
          (algebraMap R S r) :=
        e2.commutes (algebraMap R S r)
      show algebraMap R S r = e2.symm (IsLocalization.map
        (M := (IsLocalRing.maximalIdeal R).primeCompl)
        (S := Localization (IsLocalRing.maximalIdeal R).primeCompl)
        (T := (IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S))
        (Localization ((IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S)))
        (algebraMap R S) (IsLocalRing.maximalIdeal R).primeCompl.le_comap_map (e1 r))
      rw [h1', IsLocalization.map_eq, ← h2', AlgEquiv.symm_apply_apply]
    rw [← RingHom.etale_algebraMap, heq]
    exact hE2
  have pbc : ∀ (R S R' : Type u) [CommRing R] [CommRing S] [CommRing R'] [Algebra R S]
      [Algebra R R'] (Q' : Ideal R') [Q'.IsPrime],
      wcCg2LocEtale (algebraMap R S) (Q'.comap (algebraMap R R')).primeCompl →
      wcCg2LocEtale (algebraMap R' (TensorProduct R R' S)) Q'.primeCompl := by
    intro R S R' _ _ _ _ _ Q' _ h
    unfold wcCg2LocEtale at h ⊢
    let j : R →+* R' := algebraMap R R'
    let φ : R →+* S := algebraMap R S
    let ψ : R' →+* TensorProduct R R' S := algebraMap R' (TensorProduct R R' S)
    let incR : S →+* TensorProduct R R' S :=
      (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := S)).toRingHom
    let incL : R' →+* TensorProduct R R' S :=
      Algebra.TensorProduct.includeLeftRingHom (R := R) (A := R') (B := S)
    let M : Submonoid R := (Q'.comap j).primeCompl
    let M' : Submonoid R' := Q'.primeCompl
    have E5 : incR.comp φ = ψ.comp j := by
      apply RingHom.ext
      intro r
      show (1 : R') ⊗ₜ[R] (algebraMap R S r) = algebraMap R' (TensorProduct R R' S) (algebraMap R R' r)
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
      exact (Algebra.TensorProduct.tmul_one_eq_one_tmul r).symm
    have E4 : incL = ψ := by
      apply RingHom.ext
      intro x
      show x ⊗ₜ[R] (1 : S) = algebraMap R' (TensorProduct R R' S) x
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    have hι : M ≤ M'.comap j := by
      intro s hs
      exact hs
    have hv : M.map φ ≤ (M'.map ψ).comap incR := by
      rintro _ ⟨s, hs, rfl⟩
      refine ⟨j s, hι hs, ?_⟩
      exact (RingHom.congr_fun E5 s).symm
    let ι : Localization M →+* Localization M' :=
      IsLocalization.map (M := M) (S := Localization M) (Localization M') j hι
    let v : Localization (M.map φ) →+* Localization (M'.map ψ) :=
      IsLocalization.map (M := M.map φ) (S := Localization (M.map φ)) (Localization (M'.map ψ))
        incR hv
    let f : Localization M →+* Localization (M.map φ) :=
      IsLocalization.map (M := M) (S := Localization M) (Localization (M.map φ)) φ
        M.le_comap_map
    let g : Localization M' →+* Localization (M'.map ψ) :=
      IsLocalization.map (M := M') (S := Localization M') (Localization (M'.map ψ)) ψ
        M'.le_comap_map
    have C1 : ι.comp (algebraMap R (Localization M)) =
        (algebraMap R' (Localization M')).comp j := IsLocalization.map_comp hι
    have C2 : v.comp (algebraMap S (Localization (M.map φ))) =
        (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp incR :=
      IsLocalization.map_comp hv
    have C3 : f.comp (algebraMap R (Localization M)) =
        (algebraMap S (Localization (M.map φ))).comp φ := IsLocalization.map_comp M.le_comap_map
    have C4 : g.comp (algebraMap R' (Localization M')) =
        (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp ψ :=
      IsLocalization.map_comp M'.le_comap_map
    have SqL := (CommRingCat.isPushout_of_isLocalization (Rₘ := Localization M)
      (Sₘ := Localization (M.map φ)) φ f C3 M).flip
    have Sq2 := (CommRingCat.isPushout_of_isLocalization (Rₘ := Localization M')
      (Sₘ := Localization (M'.map ψ)) ψ g C4 M').flip
    have Sq1 : IsPushout (CommRingCat.ofHom j) (CommRingCat.ofHom φ) (CommRingCat.ofHom ψ)
        (CommRingCat.ofHom incR) := by
      rw [← E4]
      exact CommRingCat.isPushout_tensorProduct R R' S
    have Outer := Sq1.paste_horiz Sq2
    have e1 : CommRingCat.ofHom j ≫ CommRingCat.ofHom (algebraMap R' (Localization M')) =
        CommRingCat.ofHom (algebraMap R (Localization M)) ≫ CommRingCat.ofHom ι := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, C1]
    have e2 : CommRingCat.ofHom incR ≫
          CommRingCat.ofHom (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))) =
        CommRingCat.ofHom (algebraMap S (Localization (M.map φ))) ≫ CommRingCat.ofHom v := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, C2]
    rw [e1, e2] at Outer
    have hQ : CommRingCat.ofHom ι ≫ CommRingCat.ofHom g = CommRingCat.ofHom f ≫ CommRingCat.ofHom v := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply IsLocalization.ringHom_ext M
      calc (g.comp ι).comp (algebraMap R (Localization M))
          = g.comp (ι.comp (algebraMap R (Localization M))) := rfl
        _ = g.comp ((algebraMap R' (Localization M')).comp j) := by rw [C1]
        _ = (g.comp (algebraMap R' (Localization M'))).comp j := rfl
        _ = ((algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp ψ).comp j := by
            rw [C4]
        _ = (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp (ψ.comp j) := rfl
        _ = (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp (incR.comp φ) := by
            rw [E5]
        _ = ((algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp incR).comp φ := rfl
        _ = (v.comp (algebraMap S (Localization (M.map φ)))).comp φ := by rw [C2]
        _ = v.comp ((algebraMap S (Localization (M.map φ))).comp φ) := rfl
        _ = v.comp (f.comp (algebraMap R (Localization M))) := by rw [C3]
        _ = (v.comp f).comp (algebraMap R (Localization M)) := rfl
    have Qpo := (CategoryTheory.IsPushout.paste_horiz_iff SqL hQ).mp Outer
    haveI : (RingHom.toMorphismProperty RingHom.Etale).IsStableUnderCobaseChange :=
      RingHom.isStableUnderCobaseChange_toMorphismProperty_iff.mpr RingHom.Etale.isStableUnderBaseChange
    have hf : (RingHom.toMorphismProperty RingHom.Etale) (CommRingCat.ofHom f) := h
    exact CategoryTheory.MorphismProperty.of_isPushout
      (P := RingHom.toMorphismProperty RingHom.Etale) Qpo hf
  have s1 : (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap
      (algebraMap B (Localization.AtPrime Q)) = Q :=
    Localization.AtPrime.comap_maximalIdeal
  have hpc : ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap
      (algebraMap B (Localization.AtPrime Q))).primeCompl = Q.primeCompl := by
    ext x
    simp only [Ideal.mem_primeCompl_iff, s1]
  have h' : wcCg2LocEtale (algebraMap B C)
      ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap
        (algebraMap B (Localization.AtPrime Q))).primeCompl := by
    rw [hpc]; exact h
  have hT := pbc B C (Localization.AtPrime Q)
    (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) h'
  haveI : Algebra.Etale (Localization.AtPrime Q)
      (TensorProduct B (Localization.AtPrime Q) C) :=
    s3 (Localization.AtPrime Q) (TensorProduct B (Localization.AtPrime Q) C) hT
  let iso : TensorProduct B (Localization.AtPrime Q) C ≃ₐ[Localization.AtPrime Q]
      TensorProduct A (Localization.AtPrime Q) D :=
    (Algebra.TensorProduct.congr
      (AlgEquiv.refl : Localization.AtPrime Q ≃ₐ[Localization.AtPrime Q] Localization.AtPrime Q)
      Ψ.symm).trans
      (Algebra.TensorProduct.cancelBaseChange A B (Localization.AtPrime Q)
        (Localization.AtPrime Q) D)
  exact Algebra.Etale.of_equiv iso

theorem wc_cpp_formal_purity : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (e : ℕ) (C : Type u) [CommRing C] [Algebra (MvPowerSeries (Fin e) A) C] [Module.Finite (MvPowerSeries (Fin e) A) C] (a b : A), a ∈ IsLocalRing.maximalIdeal A → b ∈ IsLocalRing.maximalIdeal A → (∀ y : A, a * y = 0 → y = 0) → (∀ y z : A, b * y = a * z → ∃ w, y = a * w) → (∀ y : C, algebraMap (MvPowerSeries (Fin e) A) C (MvPowerSeries.C (σ := Fin e) (R := A) a) * y = 0 → y = 0) → (∀ y z : C, algebraMap (MvPowerSeries (Fin e) A) C (MvPowerSeries.C (σ := Fin e) (R := A) b) * y = algebraMap (MvPowerSeries (Fin e) A) C (MvPowerSeries.C (σ := Fin e) (R := A) a) * z → ∃ w, y = algebraMap (MvPowerSeries (Fin e) A) C (MvPowerSeries.C (σ := Fin e) (R := A) a) * w) → (∀ (Q : Ideal (MvPowerSeries (Fin e) A)) [Q.IsPrime], Q.comap (MvPowerSeries.C (σ := Fin e) (R := A)) ≠ IsLocalRing.maximalIdeal A → wcCg2LocEtale (algebraMap (MvPowerSeries (Fin e) A) C) Q.primeCompl) → (∀ (Q : Ideal (MvPowerSeries (Fin e) A)) [Q.IsPrime], Q.comap (MvPowerSeries.C (σ := Fin e) (R := A)) = IsLocalRing.maximalIdeal A → Q ≤ RingHom.ker (MvPowerSeries.map (σ := Fin e) (IsLocalRing.residue A)) → wcCg2LocEtale (algebraMap (MvPowerSeries (Fin e) A) C) Q.primeCompl) → Algebra.Etale (MvPowerSeries (Fin e) A) C :=
by
  intro A _ _ _ e C _ _ _ a b ha hb hA1 hA2 hC1 hC2 h1 h2
  classical

  have s1 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (M : Type u)
      [AddCommGroup M] [Module R M] [Module.Finite R M] (a b : R), a ∈ IsLocalRing.maximalIdeal R →
      (∀ m : M, a • m = 0 → m = 0) → (∀ m n : M, b • m = a • n → ∃ k : M, m = a • k) →
      wcCg2HP R M a b := by
    intro R _ _ _ M _ _ _ a b ha hreg hweak
    have hra : IsSMulRegular M a := by
      intro x y hxy
      have hxy' : a • x = a • y := hxy
      exact sub_eq_zero.mp (hreg _ (by rw [smul_sub, hxy', sub_self]))
    have hb0 : ∀ m : M, b • m = 0 → m = 0 := by
      intro m hm
      have hpow : ∀ n : ℕ, ∃ k : M, m = a ^ n • k := by
        intro n
        induction n with
        | zero => exact ⟨m, by rw [pow_zero, one_smul]⟩
        | succ n ih =>
          obtain ⟨k, hk⟩ := ih
          have hbk : b • k = 0 := by
            apply (hra.pow n)
            show a ^ n • (b • k) = a ^ n • (0 : M)
            rw [smul_zero, smul_comm, ← hk, hm]
          obtain ⟨k', hk'⟩ := hweak k 0 (by rw [hbk, smul_zero])
          exact ⟨k', by rw [hk, hk', pow_succ, mul_smul]⟩
      have hI : Ideal.span {a} ≤ (⊥ : Ideal R).jacobson := by
        rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
        exact (Ideal.span_singleton_le_iff_mem _).mpr ha
      have hK := Ideal.iInf_pow_smul_eq_bot_of_le_jacobson (M := M) _ hI
      have hmem : m ∈ ⨅ i, (Ideal.span {a}) ^ i • (⊤ : Submodule R M) := by
        rw [Submodule.mem_iInf]
        intro i
        obtain ⟨k, hk⟩ := hpow i
        rw [Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul, hk]
        exact Submodule.smul_mem_pointwise_smul k (a ^ i) ⊤ Submodule.mem_top
      rw [hK] at hmem
      exact (Submodule.mem_bot R).mp hmem
    have hrb : IsSMulRegular M b := by
      intro x y hxy
      have hxy' : b • x = b • y := hxy
      exact sub_eq_zero.mp (hb0 _ (by rw [smul_sub, hxy', sub_self]))
    exact ⟨hra, hrb, hweak⟩

  have s3 : ∀ (R S : Type u) [CommRing R] [IsLocalRing R] [CommRing S] [Algebra R S],
      wcCg2LocEtale (algebraMap R S) (IsLocalRing.maximalIdeal R).primeCompl →
      Algebra.Etale R S := by
    intro R S _ _ _ _ h
    have hM : (IsLocalRing.maximalIdeal R).primeCompl ≤ IsUnit.submonoid R := fun s hs =>
      (IsUnit.mem_submonoid_iff s).mpr (IsLocalRing.notMem_maximalIdeal.mp hs)
    have hM' : (IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S) ≤
        IsUnit.submonoid S := by
      rintro _ ⟨s, hs, rfl⟩
      exact (IsUnit.mem_submonoid_iff _).mpr
        (((IsUnit.mem_submonoid_iff s).mp (hM hs)).map (algebraMap R S))
    let e1 := IsLocalization.atUnits R (IsLocalRing.maximalIdeal R).primeCompl
      (S := Localization (IsLocalRing.maximalIdeal R).primeCompl) hM
    let e2 := IsLocalization.atUnits S ((IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S))
      (S := Localization ((IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S))) hM'
    have hE1 := RingHom.Etale.respectsIso.2 _ e1.toRingEquiv h
    have hE2 := RingHom.Etale.respectsIso.1 _ e2.symm.toRingEquiv hE1
    have heq : algebraMap R S = e2.symm.toRingEquiv.toRingHom.comp
        ((IsLocalization.map (Localization ((IsLocalRing.maximalIdeal R).primeCompl.map
          (algebraMap R S))) (algebraMap R S) (IsLocalRing.maximalIdeal R).primeCompl.le_comap_map :
          Localization (IsLocalRing.maximalIdeal R).primeCompl →+*
            Localization ((IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S))).comp
          e1.toRingEquiv.toRingHom) := by
      ext1 r
      have h1' : e1 r = algebraMap R (Localization (IsLocalRing.maximalIdeal R).primeCompl) r :=
        e1.commutes r
      have h2' : e2 (algebraMap R S r) = algebraMap S
          (Localization ((IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S)))
          (algebraMap R S r) :=
        e2.commutes (algebraMap R S r)
      show algebraMap R S r = e2.symm (IsLocalization.map
        (M := (IsLocalRing.maximalIdeal R).primeCompl)
        (S := Localization (IsLocalRing.maximalIdeal R).primeCompl)
        (T := (IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S))
        (Localization ((IsLocalRing.maximalIdeal R).primeCompl.map (algebraMap R S)))
        (algebraMap R S) (IsLocalRing.maximalIdeal R).primeCompl.le_comap_map (e1 r))
      rw [h1', IsLocalization.map_eq, ← h2', AlgEquiv.symm_apply_apply]
    rw [← RingHom.etale_algebraMap, heq]
    exact hE2

  haveI hBflat : Module.Flat A (MvPowerSeries (Fin e) A) := wc_cfp_mvPowerSeries_flat A e

  have hHPA : wcCg2HP A A a b := s1 A A a b ha (fun m hm => hA1 m (by rwa [smul_eq_mul] at hm))
    (fun m n h => by
      obtain ⟨w, hw⟩ := hA2 m n (by rwa [smul_eq_mul, smul_eq_mul] at h)
      exact ⟨w, by rw [hw, smul_eq_mul]⟩)
  have hcaM : MvPowerSeries.C (σ := Fin e) (R := A) a ∈
      IsLocalRing.maximalIdeal (MvPowerSeries (Fin e) A) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
      MvPowerSeries.constantCoeff_C]
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp ha)
  have hHPC : wcCg2HP (MvPowerSeries (Fin e) A) C (MvPowerSeries.C (σ := Fin e) (R := A) a)
      (MvPowerSeries.C (σ := Fin e) (R := A) b) :=
    s1 _ C _ _ hcaM (fun m hm => hC1 m (by rwa [Algebra.smul_def] at hm)) (fun m n h => by
      obtain ⟨w, hw⟩ := hC2 m n (by rwa [Algebra.smul_def, Algebra.smul_def] at h)
      exact ⟨w, by rw [hw, Algebra.smul_def]⟩)
  have hchart : ∀ x : A, x ∈ IsLocalRing.maximalIdeal A →
      wcCg2LocEtale (algebraMap (MvPowerSeries (Fin e) A) C)
        (Submonoid.powers (MvPowerSeries.C (σ := Fin e) (R := A) x)) := by
    intro x hx
    apply wc_cg2_locEtale_away
    intro Q _ hxQ
    apply h1 Q
    intro hQ
    apply hxQ
    have hx' : x ∈ Q.comap (MvPowerSeries.C (σ := Fin e) (R := A)) := by rw [hQ]; exact hx
    exact hx'

  obtain ⟨D, _, _, hDfin, hΨ⟩ : ∃ (D : Type u) (_ : CommRing D) (_ : Algebra A D),
      Module.Finite A D ∧
      Nonempty (TensorProduct A (MvPowerSeries (Fin e) A) D ≃ₐ[MvPowerSeries (Fin e) A] C) := by
    letI algBA : Algebra (MvPowerSeries (Fin e) A) A :=
      (MvPowerSeries.constantCoeff (σ := Fin e) (R := A)).toAlgebra
    haveI : Module.Finite A (TensorProduct (MvPowerSeries (Fin e) A) A C) :=
      Module.Finite.base_change _ A C
    have hcc : ∀ x : A, algebraMap (MvPowerSeries (Fin e) A) A
        (MvPowerSeries.C (σ := Fin e) (R := A) x) = x := fun x => MvPowerSeries.constantCoeff_C x
    have hC₀a : wcCg2LocEtale (algebraMap A (TensorProduct (MvPowerSeries (Fin e) A) A C))
        (Submonoid.powers a) := by
      have := wc_cg2_locEtale_baseChange (MvPowerSeries (Fin e) A) A C _ (hchart a ha)
      rwa [hcc] at this
    have hC₀b : wcCg2LocEtale (algebraMap A (TensorProduct (MvPowerSeries (Fin e) A) A C))
        (Submonoid.powers b) := by
      have := wc_cg2_locEtale_baseChange (MvPowerSeries (Fin e) A) A C _ (hchart b hb)
      rwa [hcc] at this
    obtain ⟨D, _, _, hDfin, hHPD, hDa, hDb, κ, hk1, hk2, hk3, hk4⟩ :=
      wc_cfp_reflexive_hull A a b ha hb hHPA (TensorProduct (MvPowerSeries (Fin e) A) A C) hC₀a hC₀b
    haveI := hDfin
    exact ⟨D, inferInstance, inferInstance, hDfin,
      wc_cfp_formal_iso A e C D a b ha hb hBflat hHPA hHPC (hchart a ha) (hchart b hb) hHPD hDa hDb
        κ hk1 hk2 hk3 hk4⟩
  haveI := hDfin
  obtain ⟨Ψ⟩ := hΨ

  obtain ⟨Q₀, hQ₀⟩ : ∃ Q : Ideal (MvPowerSeries (Fin e) A),
      Q = RingHom.ker (MvPowerSeries.map (σ := Fin e) (IsLocalRing.residue A)) := ⟨_, rfl⟩
  haveI hQ₀P : Q₀.IsPrime := by
    haveI : IsDomain (MvPowerSeries (Fin e) (IsLocalRing.ResidueField A)) :=
      NoZeroDivisors.to_isDomain _
    rw [hQ₀]
    exact RingHom.ker_isPrime _
  have hQ₀c : Q₀.comap (MvPowerSeries.C (σ := Fin e) (R := A)) = IsLocalRing.maximalIdeal A := by
    ext x
    rw [Ideal.mem_comap, hQ₀, RingHom.mem_ker, MvPowerSeries.map_C,
      ← IsLocalRing.residue_eq_zero_iff]
    constructor
    · intro h
      exact (MvPowerSeries.C_inj _ _).mp (h.trans (map_zero _).symm)
    · intro h
      rw [h, map_zero]
  have hloc := h2 Q₀ hQ₀c hQ₀.le
  have hEt := wc_cfp_locEtale_tensor_transport A (MvPowerSeries (Fin e) A) D C Ψ Q₀ hloc
  haveI : Module.Flat (MvPowerSeries (Fin e) A) (Localization.AtPrime Q₀) :=
    IsLocalization.flat _ Q₀.primeCompl
  haveI : Module.Flat A (Localization.AtPrime Q₀) :=
    Module.Flat.trans A (MvPowerSeries (Fin e) A) _
  have hcomap : (IsLocalRing.maximalIdeal (Localization.AtPrime Q₀)).comap
      (algebraMap A (Localization.AtPrime Q₀)) = IsLocalRing.maximalIdeal A := by
    have hAB : algebraMap A (MvPowerSeries (Fin e) A) = MvPowerSeries.C (σ := Fin e) (R := A) := by
      ext1 x
      exact MvPowerSeries.algebraMap_apply
    have hm : (IsLocalRing.maximalIdeal (Localization.AtPrime Q₀)).comap
        (algebraMap (MvPowerSeries (Fin e) A) (Localization.AtPrime Q₀)) = Q₀ :=
      Localization.AtPrime.comap_maximalIdeal
    rw [IsScalarTower.algebraMap_eq A (MvPowerSeries (Fin e) A) (Localization.AtPrime Q₀),
      ← Ideal.comap_comap, hm, hAB, hQ₀c]
  have hlocD := wc_cg2_etale_descent A D (Localization.AtPrime Q₀) (IsLocalRing.maximalIdeal A)
    (IsLocalRing.maximalIdeal (Localization.AtPrime Q₀)) hcomap hEt
  haveI : Algebra.Etale A D := s3 A D hlocD
  haveI : Algebra.Etale (MvPowerSeries (Fin e) A) (TensorProduct A (MvPowerSeries (Fin e) A) D) :=
    Algebra.Etale.baseChange A D _
  exact Algebra.Etale.of_equiv Ψ

theorem wc_cpp_weak_regular_flat_transfer : ∀ (R C R' Cₘ : Type u) [CommRing R] [CommRing C] [CommRing R'] [CommRing Cₘ] [Algebra R C] [Algebra R R'] [Module.Flat R R'] [Algebra C Cₘ] (M : Submonoid R) [IsLocalization (M.map (algebraMap R C)) Cₘ], (∀ s ∈ M, IsUnit (algebraMap R R' s)) → ∀ x y : C, (∀ z : Cₘ, algebraMap C Cₘ x * z = 0 → z = 0) → (∀ z w : Cₘ, algebraMap C Cₘ y * z = algebraMap C Cₘ x * w → ∃ v, z = algebraMap C Cₘ x * v) → (∀ z : TensorProduct R R' C, ((1 : R') ⊗ₜ[R] x) * z = 0 → z = 0) ∧ (∀ z w : TensorProduct R R' C, ((1 : R') ⊗ₜ[R] y) * z = ((1 : R') ⊗ₜ[R] x) * w → ∃ v, z = ((1 : R') ⊗ₜ[R] x) * v) :=
by
  intro R C R' Cₘ _ _ _ _ _ _ _ _ M _ hM x y H1 H2
  letI : Algebra R Cₘ := ((algebraMap C Cₘ).comp (algebraMap R C)).toAlgebra
  haveI : IsScalarTower R C Cₘ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : TensorProduct R R' C →ₐ[R'] TensorProduct R R' Cₘ,
      ∀ (r : R') (c : C), Φ (r ⊗ₜ[R] c) = r ⊗ₜ[R] algebraMap C Cₘ c :=
    ⟨Algebra.TensorProduct.map (AlgHom.id R' R') (IsScalarTower.toAlgHom R C Cₘ),
      fun r c => by simp⟩

  have hunits : ∀ t : M.map (algebraMap R C),
      IsUnit ((Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R R' C).toRingHom t) := by
    rintro ⟨_, s, hs, rfl⟩
    show IsUnit ((Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R R' C)
      (algebraMap R C s))
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R R' (TensorProduct R R' C)]
    exact (hM s hs).map _
  obtain ⟨g₀, hg₀⟩ : ∃ g₀ : Cₘ →+* TensorProduct R R' C,
      ∀ c : C, g₀ (algebraMap C Cₘ c) = (1 : R') ⊗ₜ[R] c :=
    ⟨IsLocalization.lift (M := M.map (algebraMap R C)) hunits,
      fun c => IsLocalization.lift_eq hunits c⟩

  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : TensorProduct R R' Cₘ →ₐ[R] TensorProduct R R' C,
      ∀ (r : R') (z : Cₘ), Ψ (r ⊗ₜ[R] z) = (r ⊗ₜ[R] (1 : C)) * g₀ z := by
    let g : Cₘ →ₐ[R] TensorProduct R R' C :=
      { g₀ with
        commutes' := fun r => by
          show g₀ (algebraMap C Cₘ (algebraMap R C r)) = _
          rw [hg₀]
          have := (Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R R' C).commutes r
          rw [Algebra.TensorProduct.includeRight_apply] at this
          exact this }
    refine ⟨Algebra.TensorProduct.lift Algebra.TensorProduct.includeLeft g
      (fun _ _ => Commute.all _ _), fun r z => ?_⟩
    rw [Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.includeLeft_apply]
    rfl
  have hΨΦ : ∀ t, Ψ (Φ t) = t := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul r c =>
      rw [hΦ, hΨ, hg₀, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add a b ha hb => rw [map_add, map_add, ha, hb]
  have hΦg : ∀ z : Cₘ, Φ (g₀ z) = (1 : R') ⊗ₜ[R] z := by
    have h : ((Φ : TensorProduct R R' C →+* TensorProduct R R' Cₘ).comp g₀) =
        (Algebra.TensorProduct.includeRight : Cₘ →ₐ[R] TensorProduct R R' Cₘ).toRingHom := by
      apply IsLocalization.ringHom_ext (M.map (algebraMap R C))
      ext c
      simp [hg₀, hΦ]
    intro z
    exact RingHom.congr_fun h z
  have hΦΨ : ∀ t, Φ (Ψ t) = t := by
    intro t
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul r z =>
      rw [hΨ, map_mul Φ, hΦ, map_one, hΦg, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add a b ha hb => rw [map_add, map_add, ha, hb]
  have hΦinj : Function.Injective Φ := Function.LeftInverse.injective hΨΦ

  have hK : ∀ (d : Cₘ) (t : TensorProduct R R' Cₘ),
      (LinearMap.lTensor R' (LinearMap.mulLeft R d)) t = ((1 : R') ⊗ₜ[R] d) * t := by
    intro d t
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul r e =>
      rw [LinearMap.lTensor_tmul, LinearMap.mulLeft_apply, Algebra.TensorProduct.tmul_mul_tmul,
        one_mul]
    | add a b ha hb => rw [map_add, mul_add, ha, hb]
  refine ⟨fun z hz => ?_, fun z w hzw => ?_⟩
  · have hinj0 : Function.Injective (LinearMap.mulLeft R (algebraMap C Cₘ x)) := by
      intro a b hab
      rw [LinearMap.mulLeft_apply, LinearMap.mulLeft_apply] at hab
      have : algebraMap C Cₘ x * (a - b) = 0 := by rw [mul_sub, hab, sub_self]
      exact sub_eq_zero.mp (H1 _ this)
    have hinj : Function.Injective
        (LinearMap.lTensor R' (LinearMap.mulLeft R (algebraMap C Cₘ x))) :=
      Module.Flat.lTensor_preserves_injective_linearMap _ hinj0
    have h1 : Φ z = 0 := by
      apply hinj
      rw [map_zero, hK, ← hΦ, ← map_mul Φ, hz, map_zero]
    rw [← hΨΦ z, h1, map_zero]
  · let μx : Cₘ →ₗ[R] Cₘ := LinearMap.mulLeft R (algebraMap C Cₘ x)
    let μy : Cₘ →ₗ[R] Cₘ := LinearMap.mulLeft R (algebraMap C Cₘ y)
    let N : Submodule R Cₘ := LinearMap.range μx
    let q : Cₘ →ₗ[R] Cₘ ⧸ N := N.mkQ
    have hKx : ∀ t, LinearMap.lTensor R' μx t = ((1 : R') ⊗ₜ[R] algebraMap C Cₘ x) * t :=
      hK _
    have hKy : ∀ t, LinearMap.lTensor R' μy t = ((1 : R') ⊗ₜ[R] algebraMap C Cₘ y) * t :=
      hK _
    have hex : Function.Exact μx (q ∘ₗ μy) := by
      intro z
      show Submodule.Quotient.mk (algebraMap C Cₘ y * z) = (0 : Cₘ ⧸ N) ↔
        z ∈ Set.range (fun d => algebraMap C Cₘ x * d)
      rw [Submodule.Quotient.mk_eq_zero]
      constructor
      · rintro ⟨w, hw⟩
        obtain ⟨v, hv⟩ := H2 z w hw.symm
        exact ⟨v, hv.symm⟩
      · rintro ⟨w, rfl⟩
        exact ⟨algebraMap C Cₘ y * w, by
          show algebraMap C Cₘ x * (algebraMap C Cₘ y * w) = _
          ring⟩
    have hex' := Module.Flat.lTensor_exact R' hex
    have hq0 : q ∘ₗ μx = 0 := by
      apply LinearMap.ext
      intro d
      show Submodule.Quotient.mk (μx d) = (0 : Cₘ ⧸ N)
      exact (Submodule.Quotient.mk_eq_zero N).mpr ⟨d, rfl⟩
    have hz : (LinearMap.lTensor R' (q ∘ₗ μy)) (Φ z) = 0 := by
      rw [LinearMap.lTensor_comp_apply, hKy, ← hΦ, ← map_mul Φ, hzw, map_mul Φ, hΦ, ← hKx,
        ← LinearMap.lTensor_comp_apply, hq0, LinearMap.lTensor_zero, LinearMap.zero_apply]
    obtain ⟨v', hv'⟩ := (hex' (Φ z)).mp hz
    refine ⟨Ψ v', ?_⟩
    apply hΦinj
    rw [map_mul Φ, hΦΨ, hΦ, ← hKx, hv']

theorem wc_cpp_locEtale_prime_base_change : ∀ (R S R' : Type u) [CommRing R] [CommRing S] [CommRing R'] [Algebra R S] [Algebra R R'] (Q' : Ideal R') [Q'.IsPrime], wcCg2LocEtale (algebraMap R S) (Q'.comap (algebraMap R R')).primeCompl → wcCg2LocEtale (algebraMap R' (TensorProduct R R' S)) Q'.primeCompl :=
by
  classical
  intro R S R' _ _ _ _ _ Q' _ h
  unfold wcCg2LocEtale at h ⊢

  let j : R →+* R' := algebraMap R R'
  let φ : R →+* S := algebraMap R S
  let ψ : R' →+* TensorProduct R R' S := algebraMap R' (TensorProduct R R' S)
  let incR : S →+* TensorProduct R R' S :=
    (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := S)).toRingHom
  let incL : R' →+* TensorProduct R R' S :=
    Algebra.TensorProduct.includeLeftRingHom (R := R) (A := R') (B := S)
  let M : Submonoid R := (Q'.comap j).primeCompl
  let M' : Submonoid R' := Q'.primeCompl

  have E5 : incR.comp φ = ψ.comp j := by
    apply RingHom.ext
    intro r
    show (1 : R') ⊗ₜ[R] (algebraMap R S r) = algebraMap R' (TensorProduct R R' S) (algebraMap R R' r)
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    exact (Algebra.TensorProduct.tmul_one_eq_one_tmul r).symm
  have E4 : incL = ψ := by
    apply RingHom.ext
    intro x
    show x ⊗ₜ[R] (1 : S) = algebraMap R' (TensorProduct R R' S) x
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
  have hι : M ≤ M'.comap j := by
    intro s hs
    exact hs
  have hv : M.map φ ≤ (M'.map ψ).comap incR := by
    rintro _ ⟨s, hs, rfl⟩
    refine ⟨j s, hι hs, ?_⟩
    exact (RingHom.congr_fun E5 s).symm

  let ι : Localization M →+* Localization M' :=
    IsLocalization.map (M := M) (S := Localization M) (Localization M') j hι
  let v : Localization (M.map φ) →+* Localization (M'.map ψ) :=
    IsLocalization.map (M := M.map φ) (S := Localization (M.map φ)) (Localization (M'.map ψ))
      incR hv
  let f : Localization M →+* Localization (M.map φ) :=
    IsLocalization.map (M := M) (S := Localization M) (Localization (M.map φ)) φ
      M.le_comap_map
  let g : Localization M' →+* Localization (M'.map ψ) :=
    IsLocalization.map (M := M') (S := Localization M') (Localization (M'.map ψ)) ψ
      M'.le_comap_map
  have C1 : ι.comp (algebraMap R (Localization M)) =
      (algebraMap R' (Localization M')).comp j := IsLocalization.map_comp hι
  have C2 : v.comp (algebraMap S (Localization (M.map φ))) =
      (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp incR :=
    IsLocalization.map_comp hv
  have C3 : f.comp (algebraMap R (Localization M)) =
      (algebraMap S (Localization (M.map φ))).comp φ := IsLocalization.map_comp M.le_comap_map
  have C4 : g.comp (algebraMap R' (Localization M')) =
      (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp ψ :=
    IsLocalization.map_comp M'.le_comap_map

  have SqL := (CommRingCat.isPushout_of_isLocalization (Rₘ := Localization M)
    (Sₘ := Localization (M.map φ)) φ f C3 M).flip
  have Sq2 := (CommRingCat.isPushout_of_isLocalization (Rₘ := Localization M')
    (Sₘ := Localization (M'.map ψ)) ψ g C4 M').flip
  have Sq1 : IsPushout (CommRingCat.ofHom j) (CommRingCat.ofHom φ) (CommRingCat.ofHom ψ)
      (CommRingCat.ofHom incR) := by
    rw [← E4]
    exact CommRingCat.isPushout_tensorProduct R R' S

  have Outer := Sq1.paste_horiz Sq2
  have e1 : CommRingCat.ofHom j ≫ CommRingCat.ofHom (algebraMap R' (Localization M')) =
      CommRingCat.ofHom (algebraMap R (Localization M)) ≫ CommRingCat.ofHom ι := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, C1]
  have e2 : CommRingCat.ofHom incR ≫
        CommRingCat.ofHom (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))) =
      CommRingCat.ofHom (algebraMap S (Localization (M.map φ))) ≫ CommRingCat.ofHom v := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, C2]
  rw [e1, e2] at Outer

  have hQ : CommRingCat.ofHom ι ≫ CommRingCat.ofHom g = CommRingCat.ofHom f ≫ CommRingCat.ofHom v := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply IsLocalization.ringHom_ext M
    calc (g.comp ι).comp (algebraMap R (Localization M))
        = g.comp (ι.comp (algebraMap R (Localization M))) := rfl
      _ = g.comp ((algebraMap R' (Localization M')).comp j) := by rw [C1]
      _ = (g.comp (algebraMap R' (Localization M'))).comp j := rfl
      _ = ((algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp ψ).comp j := by
          rw [C4]
      _ = (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp (ψ.comp j) := rfl
      _ = (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp (incR.comp φ) := by
          rw [E5]
      _ = ((algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp incR).comp φ := rfl
      _ = (v.comp (algebraMap S (Localization (M.map φ)))).comp φ := by rw [C2]
      _ = v.comp ((algebraMap S (Localization (M.map φ))).comp φ) := rfl
      _ = v.comp (f.comp (algebraMap R (Localization M))) := by rw [C3]
      _ = (v.comp f).comp (algebraMap R (Localization M)) := rfl

  have Q := (CategoryTheory.IsPushout.paste_horiz_iff SqL hQ).mp Outer

  haveI : (RingHom.toMorphismProperty RingHom.Etale).IsStableUnderCobaseChange :=
    RingHom.isStableUnderCobaseChange_toMorphismProperty_iff.mpr RingHom.Etale.isStableUnderBaseChange
  have hf : (RingHom.toMorphismProperty RingHom.Etale) (CommRingCat.ofHom f) := h
  exact CategoryTheory.MorphismProperty.of_isPushout
    (P := RingHom.toMorphismProperty RingHom.Etale) Q hf

theorem wc_cpp_fibre_generic_transfer : ∀ (A R A' : Type u) [CommRing A] [CommRing R] [CommRing A'] [IsLocalRing A'] [IsNoetherianRing A'] (e : ℕ) (ψ : A →+* R) (α : A →+* A') (β : R →+* MvPowerSeries (Fin e) A'), β.Flat → β.comp ψ = (MvPowerSeries.C (σ := Fin e) (R := A')).comp α → ∀ (𝔭 : Ideal A) [𝔭.IsPrime], (∀ P : Ideal A', P.IsPrime → P.comap α = 𝔭 → P = IsLocalRing.maximalIdeal A') → ∀ (Q : Ideal (MvPowerSeries (Fin e) A')) [Q.IsPrime], Q.comap (MvPowerSeries.C (σ := Fin e) (R := A')) = IsLocalRing.maximalIdeal A' → Q ≤ RingHom.ker (MvPowerSeries.map (σ := Fin e) (IsLocalRing.residue A')) → ∀ Q' : Ideal R, Q'.IsPrime → Q' ≤ Q.comap β → Q'.comap ψ = 𝔭 → Q' = Q.comap β :=
by
  intro A R A' _ _ _ _ _ e ψ α β hβ hsq 𝔭 _ huniq Q _ _ hQker Q' hQ' hle hQ'𝔭
  classical
  letI : Algebra R (MvPowerSeries (Fin e) A') := β.toAlgebra
  haveI : Module.Flat R (MvPowerSeries (Fin e) A') := hβ
  haveI : (Q.comap β).IsPrime := Ideal.IsPrime.comap β
  haveI : Q.LiesOver (Q.comap β) := ⟨rfl⟩
  haveI := hQ'
  obtain ⟨P, hPQ, hP, hlo⟩ :=
    Ideal.exists_ideal_le_liesOver_of_le (p := Q') (q := Q.comap β) Q hle
  have hPβ : P.comap β = Q' := (Ideal.over_def P Q').symm
  haveI := hP
  have hP0 : P.comap (MvPowerSeries.C (σ := Fin e) (R := A')) = IsLocalRing.maximalIdeal A' := by
    apply huniq _ (Ideal.IsPrime.comap _)
    rw [Ideal.comap_comap, ← hsq, ← Ideal.comap_comap, hPβ, hQ'𝔭]
  have hCm : ∀ a ∈ IsLocalRing.maximalIdeal A', MvPowerSeries.C (σ := Fin e) (R := A') a ∈ P := by
    intro a ha
    rw [← hP0] at ha
    exact ha
  obtain ⟨k, s, hs⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal A'))
  have hQP : Q ≤ P := by
    intro f hf
    have hf0 : MvPowerSeries.map (IsLocalRing.residue A') f = 0 := hQker hf
    have hcoeff : ∀ n, MvPowerSeries.coeff n f ∈ IsLocalRing.maximalIdeal A' := by
      intro n
      rw [← IsLocalRing.residue_eq_zero_iff]
      have := congrArg (MvPowerSeries.coeff n) hf0
      rw [MvPowerSeries.coeff_map, map_zero] at this
      exact this
    have hc : ∀ n, ∃ c : Fin k → A', ∑ i, c i • s i = MvPowerSeries.coeff n f := by
      intro n
      have h := hcoeff n
      rw [← hs] at h
      exact (Submodule.mem_span_range_iff_exists_fun A').mp h
    choose c hc using hc
    let g : Fin k → MvPowerSeries (Fin e) A' := fun i n => c n i
    have hg : ∀ i n, MvPowerSeries.coeff n (g i) = c n i := fun _ _ => rfl
    have hfeq : f = ∑ i, MvPowerSeries.C (σ := Fin e) (R := A') (s i) * g i := by
      ext n
      rw [map_sum, ← hc n]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [MvPowerSeries.coeff_C_mul, hg, smul_eq_mul, mul_comm]
    rw [hfeq]
    refine Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (hCm _ ?_))
    rw [← hs]
    exact Submodule.subset_span ⟨i, rfl⟩
  have hPQeq : P = Q := le_antisymm hPQ hQP
  rw [← hPβ, hPQeq]

theorem wc_plp_closed_point_purity : wcPlpClosedPurity.{u} :=
by
  unfold wcPlpClosedPurity
  intro A R C _ _ _ _ ψ φ hψ hφ 𝔭 _ 𝔮 _ hq hcl hreg hP2 hP3
  obtain ⟨a, b, hA, hC⟩ := hreg
  obtain ⟨haP, hbP, hA1, hA2⟩ := hA
  obtain ⟨hC1, hC2⟩ := hC

  haveI hRn : IsNoetherianRing R := by
    letI : Algebra A R := ψ.toAlgebra
    haveI : Algebra.FiniteType A R :=
      RingHom.FiniteType.of_finitePresentation hψ.finitePresentation
    exact Algebra.FiniteType.isNoetherianRing A R

  obtain ⟨A', _, _, _, e, α, β, hα, hβ, hsq, hmA, huniq, hmB⟩ :=
    wc_cpp_flat_power_series_chart A R ψ hψ 𝔭 𝔮 hq hcl
  letI : Algebra R C := φ.toAlgebra
  letI : Algebra R (MvPowerSeries (Fin e) A') := β.toAlgebra
  haveI : Module.Finite R C := hφ
  haveI : Module.Flat R (MvPowerSeries (Fin e) A') := hβ
  have hsqx : ∀ x : A, β (ψ x) = MvPowerSeries.C (α x) := fun x => RingHom.congr_fun hsq x
  have hcomp : ∀ Q : Ideal (MvPowerSeries (Fin e) A'),
      (Q.comap β).comap ψ = (Q.comap (MvPowerSeries.C (σ := Fin e) (R := A'))).comap α := by
    intro Q
    rw [Ideal.comap_comap, Ideal.comap_comap, hsq]
  have hleq : ∀ (Q : Ideal (MvPowerSeries (Fin e) A')), Q.IsPrime → Q.comap β ≤ 𝔮 := by
    intro Q hQ
    rw [← hmB]
    exact Ideal.comap_mono (IsLocalRing.le_maximalIdeal hQ.ne_top)
  have hkey : ∀ x : A, algebraMap (MvPowerSeries (Fin e) A')
      (TensorProduct R (MvPowerSeries (Fin e) A') C) (MvPowerSeries.C (α x)) =
      (1 : MvPowerSeries (Fin e) A') ⊗ₜ[R] φ (ψ x) := by
    intro x
    rw [Algebra.TensorProduct.algebraMap_apply, ← hsqx]
    exact Algebra.TensorProduct.tmul_one_eq_one_tmul (ψ x)

  have hunitA : ∀ s ∈ 𝔭.primeCompl, IsUnit (α s) := by
    intro s hs
    have hs' : s ∉ 𝔭 := hs
    apply IsLocalRing.notMem_maximalIdeal.mp
    intro h
    apply hs'
    rw [← hmA]
    exact h
  have hregA : (∀ y : A', α a * y = 0 → y = 0) ∧
      (∀ y z : A', α b * y = α a * z → ∃ w, y = α a * w) := by
    letI : Algebra A A' := α.toAlgebra
    haveI : Module.Flat A A' := hα
    have hM : 𝔭.primeCompl.map (algebraMap A A) = 𝔭.primeCompl := by
      ext x
      simp
    haveI : IsLocalization (𝔭.primeCompl.map (algebraMap A A)) (Localization.AtPrime 𝔭) := by
      rw [hM]
      exact Localization.isLocalization
    obtain ⟨h1, h2⟩ := wc_cpp_weak_regular_flat_transfer A A A' (Localization.AtPrime 𝔭)
      𝔭.primeCompl hunitA a b hA1 hA2
    let E := Algebra.TensorProduct.rid A A' A'
    have hE : ∀ x : A, E ((1 : A') ⊗ₜ[A] x) = α x := by
      intro x
      rw [Algebra.TensorProduct.rid_tmul, Algebra.smul_def, mul_one]
      try rfl
    refine ⟨fun y hy => ?_, fun y z hyz => ?_⟩
    · have h0 : ((1 : A') ⊗ₜ[A] a) * E.symm y = 0 := by
        apply E.injective
        rw [map_mul, map_zero, hE, AlgEquiv.apply_symm_apply]
        exact hy
      have h3 := congrArg E (h1 _ h0)
      rw [AlgEquiv.apply_symm_apply, map_zero] at h3
      exact h3
    · have h0 : ((1 : A') ⊗ₜ[A] b) * E.symm y = ((1 : A') ⊗ₜ[A] a) * E.symm z := by
        apply E.injective
        rw [map_mul, map_mul, hE, hE, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
        exact hyz
      obtain ⟨v, hv⟩ := h2 _ _ h0
      refine ⟨E v, ?_⟩
      have h3 := congrArg E hv
      rw [AlgEquiv.apply_symm_apply, map_mul, hE] at h3
      exact h3

  have hunitR : ∀ s ∈ 𝔮.primeCompl, IsUnit (algebraMap R (MvPowerSeries (Fin e) A') s) := by
    intro s hs
    have hs' : s ∉ 𝔮 := hs
    apply IsLocalRing.notMem_maximalIdeal.mp
    intro h
    apply hs'
    rw [← hmB]
    exact h
  haveI : IsLocalization (𝔮.primeCompl.map (algebraMap R C))
      (Localization (𝔮.primeCompl.map φ)) := Localization.isLocalization
  have hregC := wc_cpp_weak_regular_flat_transfer R C (MvPowerSeries (Fin e) A')
    (Localization (𝔮.primeCompl.map φ)) 𝔮.primeCompl hunitR (φ (ψ a)) (φ (ψ b)) hC1 hC2

  have hEt : Algebra.Etale (MvPowerSeries (Fin e) A')
      (TensorProduct R (MvPowerSeries (Fin e) A') C) := by
    refine wc_cpp_formal_purity A' e (TensorProduct R (MvPowerSeries (Fin e) A') C) (α a) (α b)
      ?_ ?_ hregA.1 hregA.2 ?_ ?_ ?_ ?_
    · show a ∈ (IsLocalRing.maximalIdeal A').comap α
      rw [hmA]
      exact haP
    · show b ∈ (IsLocalRing.maximalIdeal A').comap α
      rw [hmA]
      exact hbP
    · intro y hy
      rw [hkey] at hy
      exact hregC.1 y hy
    · intro y z hyz
      rw [hkey, hkey] at hyz
      rw [hkey]
      exact hregC.2 y z hyz
    · intro Q hQp hQ
      haveI : (Q.comap β).IsPrime := Ideal.IsPrime.comap β
      apply wc_cpp_locEtale_prime_base_change R C (MvPowerSeries (Fin e) A') Q
      refine hP2 (Q.comap β) (hleq Q hQp) ?_
      intro h
      exact hQ (huniq _ (Ideal.IsPrime.comap _) (by rw [← hcomp]; exact h))
    · intro Q hQp hQ hQk
      haveI : (Q.comap β).IsPrime := Ideal.IsPrime.comap β
      apply wc_cpp_locEtale_prime_base_change R C (MvPowerSeries (Fin e) A') Q
      have hfib : (Q.comap β).comap ψ = 𝔭 := by
        rw [hcomp, hQ, hmA]
      exact hP3 (Q.comap β) (hleq Q hQp) hfib
        (wc_cpp_fibre_generic_transfer A R A' e ψ α β hβ hsq 𝔭 huniq Q hQ hQk)

  exact wc_cg2_etale_descent R C (MvPowerSeries (Fin e) A') 𝔮
    (IsLocalRing.maximalIdeal (MvPowerSeries (Fin e) A')) hmB hEt

theorem wc_pff_local_purity : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (κ : K →+* A₀) (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∀ [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ x : X, 2 ≤ (f x).asIdeal.height → (∀ x' : X, x' ⤳ x → x' ≠ x → ∃ W : X.Opens, x' ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W)) → (∃ ξ : X, ξ ⤳ x ∧ ξ ≠ x ∧ f ξ = f x) → ∃ W : X.Opens, x ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) :=
by
  intro K _ _ ℓ hℓ hℓK A₀ _ _ _ _ κ X _ _ f _ P p α hP _ _ hnorm hfin hpb x hx Hgen Hfib
  classical
  suffices H : ∀ {N : Scheme.{u}} (ν : N ⟶ X) [IsFinite ν],
      (∀ x' : X, x' ⤳ x → x' ≠ x → ∃ W : X.Opens, x' ∈ W ∧ Etale (ν ∣_ W)) →
      (∀ (U : X.Opens) (hU : IsAffineOpen U) (hx : x ∈ U), ∃ a b : A₀,
        @wcPlpRegA A₀ _ (f x).asIdeal (f x).isPrime a b ∧
          wcPlpRegC (wcPlpChartMap f hU) (Scheme.Hom.app ν U).hom
            (hU.primeIdealOf ⟨x, hx⟩).asIdeal a b) →
      ∃ W : X.Opens, x ∈ W ∧ Etale (ν ∣_ W) by
    exact @H _ _ hfin Hgen
      (wc_plp_depth_pair A₀ X f P p hP.finite hP.etale hnorm hfin hpb x hx)
  intro N ν _ Hgen' hdp
  haveI : IsAffineHom ν := inferInstance
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
  haveI : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩

  have hψ : (wcPlpChartMap f hU).Smooth := by
    have h : Smooth (Spec.map (Spec.preimage (hU.fromSpec ≫ f))) := by
      rw [Spec.map_preimage]; infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Smooth)] at h
    exact h
  have hcomap : ∀ (y : X) (hy : y ∈ U),
      (hU.primeIdealOf ⟨y, hy⟩).asIdeal.comap (wcPlpChartMap f hU) = (f y).asIdeal := by
    intro y hy
    let q : Spec Γ(X, U) := hU.primeIdealOf ⟨y, hy⟩
    have h1 : hU.fromSpec q = y := hU.fromSpec_primeIdealOf ⟨y, hy⟩
    have h2 : (hU.fromSpec ≫ f) q = f y := by
      rw [Scheme.Hom.comp_apply, h1]
    have h3 : (Spec.map (Spec.preimage (hU.fromSpec ≫ f))) q = f y := by
      rw [Spec.map_preimage]; exact h2
    rw [← h3]
    rfl
  have hle : ∀ (y z : X) (hy : y ∈ U) (hz : z ∈ U),
      (hU.primeIdealOf ⟨y, hy⟩).asIdeal ≤ (hU.primeIdealOf ⟨z, hz⟩).asIdeal ↔ y ⤳ z := by
    intro y z hy hz
    let qy : Spec Γ(X, U) := hU.primeIdealOf ⟨y, hy⟩
    let qz : Spec Γ(X, U) := hU.primeIdealOf ⟨z, hz⟩
    have h1 : hU.fromSpec qy = y := hU.fromSpec_primeIdealOf ⟨y, hy⟩
    have h2 : hU.fromSpec qz = z := hU.fromSpec_primeIdealOf ⟨z, hz⟩
    have e1 : (hU.primeIdealOf ⟨y, hy⟩).asIdeal ≤ (hU.primeIdealOf ⟨z, hz⟩).asIdeal ↔ qy ⤳ qz :=
      PrimeSpectrum.le_iff_specializes (hU.primeIdealOf ⟨y, hy⟩) (hU.primeIdealOf ⟨z, hz⟩)
    have e2 : hU.fromSpec qy ⤳ hU.fromSpec qz ↔ qy ⤳ qz :=
      hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff
    rw [e1, ← e2, h1, h2]
  have hsurj : ∀ (Q : Ideal Γ(X, U)) (hQ : Q.IsPrime),
      ∃ (y : X) (hy : y ∈ U), (hU.primeIdealOf ⟨y, hy⟩).asIdeal = Q := by
    intro Q hQ
    let q : Spec Γ(X, U) := (⟨Q, hQ⟩ : PrimeSpectrum Γ(X, U))
    have hmem : hU.fromSpec q ∈ U := by
      have : hU.fromSpec q ∈ Set.range hU.fromSpec := ⟨q, rfl⟩
      rw [hU.range_fromSpec] at this
      exact this
    refine ⟨_, hmem, ?_⟩
    have h1 : hU.fromSpec (hU.primeIdealOf ⟨_, hmem⟩ : Spec Γ(X, U)) = hU.fromSpec q :=
      hU.fromSpec_primeIdealOf ⟨_, hmem⟩
    have h2 := hU.fromSpec.isOpenEmbedding.injective h1
    exact congrArg (fun t : Spec Γ(X, U) => t.asIdeal) h2
  have hbasic : ∀ (r : Γ(X, U)), r ∉ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal → x ∈ X.basicOpen r := by
    intro r hr
    let q : Spec Γ(X, U) := hU.primeIdealOf ⟨x, hxU⟩
    have h1 : hU.fromSpec q = x := hU.fromSpec_primeIdealOf ⟨x, hxU⟩
    have h2 : q ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen r := by
      rw [hU.fromSpec_preimage_basicOpen]
      exact hr
    rw [← h1]
    exact h2

  have hφfin : (Scheme.Hom.app ν U).hom.Finite := IsFinite.finite_app ν U hU
  have hφfp : (Scheme.Hom.app ν U).hom.FinitePresentation :=
    RingHom.FinitePresentation.of_finiteType.mp hφfin.finiteType

  obtain ⟨a, b, hA, hC⟩ := hdp U hU hxU
  haveI : (f x).asIdeal.IsPrime := (f x).isPrime

  have hEt : wcCg2LocEtale (Scheme.Hom.app ν U).hom
      (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl := by
    refine wc_plp_transcendence_reduction wc_plp_closed_point_purity A₀ Γ(X, U)
      Γ(N, ν ⁻¹ᵁ U) (wcPlpChartMap f hU) (Scheme.Hom.app ν U).hom hψ hφfin (f x).asIdeal
      (hU.primeIdealOf ⟨x, hxU⟩).asIdeal (hcomap x hxU) ⟨a, b, hA, hC⟩ ?_ ?_
    · intro Q _ hQle hQne
      obtain ⟨y, hy, hyQ⟩ := hsurj Q ‹_›
      subst hyQ
      have hyx : y ⤳ x := (hle y x hy hxU).mp hQle
      have hne : y ≠ x := by
        rintro rfl
        exact hQne rfl
      obtain ⟨W, hyW, hW⟩ := Hgen' y hyx hne
      exact wc_plp_loc_etale_of_etale_nbhd ν U hU y hy W hyW hW
    · obtain ⟨ξ, hξx, hξne, hfξ⟩ := Hfib
      have hξU : ξ ∈ U := hξx.mem_open U.isOpen hxU
      refine ⟨(hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal, inferInstance,
        (hle ξ x hξU hxU).mpr hξx, ?_, ?_⟩
      · intro h
        have h2 : x ⤳ ξ := (hle x ξ hxU hξU).mp h.ge
        exact hξne (hξx.antisymm h2).eq
      · rw [hcomap ξ hξU, hfξ]

  obtain ⟨r, hr, hrEt⟩ := wc_fnteg_spread_etale (Scheme.Hom.app ν U).hom hφfin hφfp
    (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl hEt (hU.primeIdealOf ⟨x, hxU⟩).asIdeal
    (by
      rw [Set.disjoint_left]
      intro s hs hs'
      exact hs hs')
  exact ⟨X.basicOpen r, hbasic r hr, wc_fnteg_basicOpen_etale ν U hU r hrEt⟩

theorem wc_cg2_purity_from_fibre_point : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (κ : K →+* A₀) (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∀ [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ x : X, 2 ≤ (f x).asIdeal.height → (∀ x' : X, (f x').asIdeal < (f x).asIdeal → ∃ W : X.Opens, x' ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W)) → (∃ y : X, f y = f x ∧ ∃ W : X.Opens, y ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W)) → ∃ W : X.Opens, x ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) :=
by
  intro K _ _ ℓ hℓ hℓK A₀ _ _ _ _ κ X _ _ f _ hconn P p α hP _ _ hnorm hfin hpb x hx H_lt hE
  classical
  have hpur := wc_pff_local_purity K ℓ hℓ hℓK A₀ κ X f P p α hP hnorm hfin hpb
  have hirr := wc_pff_fibre_preirreducible A₀ X f hconn (f x)
  let Q : X → Prop := fun z => ∃ W : X.Opens, z ∈ W ∧ Etale (Scheme.Hom.fromNormalization
    (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W)
  have hpur' : ∀ z : X, 2 ≤ (f z).asIdeal.height → (∀ x' : X, x' ⤳ z → x' ≠ z → Q x') →
      (∃ ξ : X, ξ ⤳ z ∧ ξ ≠ z ∧ f ξ = f z) → Q z := hpur
  have H_lt' : ∀ x' : X, (f x').asIdeal < (f x).asIdeal → Q x' := H_lt
  obtain ⟨y, hyf, hyQ⟩ : ∃ y : X, f y = f x ∧ Q y := hE
  show Q x

  have hQgen : ∀ z z' : X, z' ⤳ z → Q z → Q z' := by
    rintro z z' h ⟨W, hzW, hW⟩
    exact ⟨W, h.mem_open W.isOpen hzW, hW⟩

  have hfeq : ∀ (S : Set X) (z : X), z ∈ closure S → (∀ s ∈ S, f s = f x) →
      ∀ s ∈ S, z ⤳ s → f z = f x := by
    intro S z hz hS s hs hzs
    have h1 : f z ⤳ f x := by rw [← hS s hs]; exact hzs.map f.continuous
    have h2 : f x ⤳ f z := by
      rw [specializes_iff_mem_closure]
      have h4 : f '' closure S ⊆ closure (f '' S) := image_closure_subset_closure_image f.continuous
      have h3 : f '' S ⊆ {f x} := by
        rintro _ ⟨s', hs', rfl⟩
        exact hS s' hs'
      exact closure_mono h3 (h4 ⟨z, hz, rfl⟩)
    exact (h1.antisymm h2).eq

  have hFirr : IsIrreducible (f ⁻¹' {f x}) := ⟨⟨x, rfl⟩, hirr⟩
  obtain ⟨g₀, hg₀gen⟩ : ∃ g, IsGenericPoint g (closure (f ⁻¹' {f x})) :=
    ⟨_, hFirr.isGenericPoint_genericPoint_closure⟩
  have hg₀sp : ∀ z ∈ f ⁻¹' {f x}, g₀ ⤳ z := fun z hz => hg₀gen.specializes (subset_closure hz)
  have hg₀f : f g₀ = f x :=
    hfeq _ g₀ hg₀gen.mem (fun s hs => hs) x (show f x = f x from rfl)
      (hg₀sp x (show f x = f x from rfl))
  have hg₀Q : Q g₀ := hQgen y g₀ (hg₀sp y hyf) hyQ
  by_contra hxQ

  have hchain : ∀ c : Set {z : X // f z = f x ∧ ¬ Q z},
      IsChain (fun a b : {z : X // f z = f x ∧ ¬ Q z} => b.1 ⤳ a.1) c →
      ∃ ub : {z : X // f z = f x ∧ ¬ Q z}, ∀ a ∈ c, ub.1 ⤳ a.1 := by
    intro c hc
    by_cases hce : c.Nonempty
    · obtain ⟨a₀, ha₀⟩ := hce
      have hSpre : IsPreirreducible (Subtype.val '' c) := by
        rintro u v hu hv ⟨_, ⟨a, ha, rfl⟩, hau⟩ ⟨_, ⟨b, hb, rfl⟩, hbv⟩
        by_cases hab : a = b
        · subst hab
          exact ⟨a.1, ⟨a, ha, rfl⟩, hau, hbv⟩
        · rcases hc ha hb hab with h | h
          · exact ⟨b.1, ⟨b, hb, rfl⟩, h.mem_open hu hau, hbv⟩
          · exact ⟨a.1, ⟨a, ha, rfl⟩, hau, h.mem_open hv hbv⟩
      have hSirr : IsIrreducible (Subtype.val '' c) := ⟨⟨a₀.1, a₀, ha₀, rfl⟩, hSpre⟩
      have hgen := hSirr.isGenericPoint_genericPoint_closure
      have hsp : ∀ a ∈ c, hSirr.genericPoint ⤳ a.1 := fun a ha =>
        hgen.specializes (subset_closure ⟨a, ha, rfl⟩)
      have hf : f hSirr.genericPoint = f x :=
        hfeq _ _ hgen.mem (by rintro _ ⟨a, -, rfl⟩; exact a.2.1) a₀.1 ⟨a₀, ha₀, rfl⟩ (hsp a₀ ha₀)
      have hnQ : ¬ Q hSirr.genericPoint := by
        rintro ⟨W, hW, hWe⟩
        obtain ⟨_, haW, ⟨a, ha, rfl⟩⟩ := mem_closure_iff.mp hgen.mem W W.isOpen hW
        exact a.2.2 ⟨W, haW, hWe⟩
      exact ⟨⟨_, hf, hnQ⟩, fun a ha => hsp a ha⟩
    · exact ⟨⟨x, rfl, hxQ⟩, fun a ha => absurd ⟨a, ha⟩ hce⟩
  have htrans : ∀ {a b c : {z : X // f z = f x ∧ ¬ Q z}}, b.1 ⤳ a.1 → c.1 ⤳ b.1 → c.1 ⤳ a.1 :=
    fun hab hbc => hbc.trans hab
  obtain ⟨m, hm⟩ := exists_maximal_of_chains_bounded
    (r := fun a b : {z : X // f z = f x ∧ ¬ Q z} => b.1 ⤳ a.1) hchain htrans

  apply m.2.2
  apply hpur' m.1 (by rw [m.2.1]; exact hx)
  · intro x' hx'm hne
    by_contra hx'Q
    have hle : (f x').asIdeal ≤ (f x).asIdeal := by
      rw [← m.2.1]
      exact (PrimeSpectrum.le_iff_specializes _ _).mpr (hx'm.map f.continuous)
    rcases hle.lt_or_eq with hlt | heq
    · exact hx'Q (H_lt' x' hlt)
    · have hf' : f x' = f x := PrimeSpectrum.ext heq
      have hmx : m.1 ⤳ x' := hm ⟨x', hf', hx'Q⟩ hx'm
      exact hne (hx'm.antisymm hmx).eq
  · refine ⟨g₀, hg₀sp m.1 m.2.1, ?_, hg₀f.trans m.2.1.symm⟩
    intro h
    rw [h] at hg₀Q
    exact m.2.2 hg₀Q

theorem wc_fntame_etale_codim_ge_two : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (κ : K →+* A₀) (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → (∃ r : Spec (.of (FractionRing A₀)) ⟶ P, r ≫ p = Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])) → ∀ [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ x : X, 2 ≤ (f x).asIdeal.height → (∀ x' : X, (f x').asIdeal.height < (f x).asIdeal.height → ∃ W : X.Opens, x' ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W)) → ∃ W : X.Opens, x ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) :=
by
  intro K _ _ ℓ hℓ hℓK A₀ _ _ _ _ κ X _ _ f _ σ hσ hconn P p α hP hr _ _ hnorm hfin hpb x hx IH
  have H_lt : ∀ x' : X, (f x').asIdeal < (f x).asIdeal → ∃ W : X.Opens, x' ∈ W ∧
      Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) := by
    intro x' h
    haveI : (f x').asIdeal.IsPrime := (f x').isPrime
    exact IH x' (Ideal.height_strict_mono_of_isPrime h)
  obtain ⟨W₀, hW₀mem, hW₀⟩ := wc_cg2_etale_at_section_point K ℓ hℓ hℓK A₀ κ X f σ hσ hconn P p α
    hP hr hnorm hfin hpb x hx H_lt
  have hfσ : f (σ (f x)) = f x := by
    rw [← Scheme.Hom.comp_apply, hσ]
    rfl
  exact wc_cg2_purity_from_fibre_point K ℓ hℓ hℓK A₀ κ X f hconn P p α hP hnorm hfin hpb x hx
    H_lt ⟨σ (f x), hfσ, W₀, hW₀mem, hW₀⟩

theorem wc_fet_ext_noetherian_tame : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (κ : K →+* A₀) (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → (∃ r : Spec (.of (FractionRing A₀)) ⟶ P, r ≫ p = Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])) → ∃ (Y : Scheme.{u}) (q : Y ⟶ X) (β : ZMod ℓ → (Y ⟶ Y)) (i : P ⟶ Y), wcFetTorsor q ℓ β ∧ IsPullback i p q (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) :=
by
  intro K _ _ ℓ hℓ hℓK A₀ _ _ _ _ κ X _ _ f _ σ hσ hconn P p α hP hr
  classical
  haveI : IsFinite p := hP.finite
  haveI : Etale p := hP.etale
  haveI : IsAffineHom (Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))).flip
      inferInstance
  haveI : IsAffineHom (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := inferInstance
  haveI : Flat f := inferInstance

  have hpb := wc_fntame_normalization_generic_pullback A₀ X f P p inferInstance

  have hnorm := wc_fntame_smooth_stalk_normal A₀ X f

  have hfin := wc_fntame_normalization_finite A₀ X f P p hP.finite hP.etale hnorm

  have H : ∀ n : ℕ, ∀ x : X, (f x).asIdeal.height = n →
      ∃ W : X.Opens, x ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro x hx
      rcases n with _ | _ | n
      · exact wc_fntame_etale_over_generic A₀ X f P p hP.finite hP.etale hfin hpb x
          (by rw [hx]; rfl)
      · exact wc_fntame_etale_codim_one K ℓ hℓ hℓK A₀ κ X f σ hσ hconn P p α hP hr hnorm hfin hpb x
          (by rw [hx]; rfl)
      · apply wc_fntame_etale_codim_ge_two K ℓ hℓ hℓK A₀ κ X f σ hσ hconn P p α hP hr hnorm hfin
          hpb x
        · rw [hx]
          exact_mod_cast (by omega : 2 ≤ n + 1 + 1)
        · intro x' hx'
          have hne : (f x').asIdeal.height ≠ ⊤ := Ideal.height_ne_top (f x').isPrime.ne_top
          obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hne
          refine ih m ?_ x' hm.symm
          rw [hx, ← hm] at hx'
          exact_mod_cast hx'
  have H' : ∀ x : X, ∃ W : X.Opens, x ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫
      Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) :=
    fun x => H _ x (ENat.natCast_toNat (Ideal.height_ne_top (f x).isPrime.ne_top)).symm
  choose W hxW hW using H'
  have hsup : iSup W = ⊤ := by
    rw [eq_top_iff]
    intro x _
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxW x⟩
  haveI : IsZariskiLocalAtTarget @Etale := HasRingHomProperty.instIsZariskiLocalAtTarget @Etale
  have hEt : Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) :=
    (IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @Etale) W hsup).mpr hW

  have Hc : ∀ c, p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) =
      (α c ≫ Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) ≫
      Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := fun c => by
    rw [Category.assoc, Scheme.Hom.toNormalization_fromNormalization, ← Category.assoc, hP.act_p c]
  let β : ZMod ℓ → (Scheme.Hom.normalization (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⟶
      Scheme.Hom.normalization (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) := fun c =>
    Scheme.Hom.normalizationDesc _ _ _ (Hc c)
  have e₁ : ∀ c, Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ≫ β c =
      α c ≫ Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := fun c =>
    Scheme.Hom.toNormalization_normalizationDesc _ _ _ _
  have e₂ : ∀ c, β c ≫ Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) =
      Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := fun c =>
    Scheme.Hom.normalizationDesc_comp _ _ _ _
  have hβ0 : β 0 = 𝟙 _ := by
    apply Scheme.Hom.normalization.hom_ext _ _ _ (Scheme.Hom.fromNormalization (p ≫
      Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))))
    · rw [e₁, hP.act_zero, Category.id_comp, Category.comp_id]
    · exact e₂ 0
    · exact Category.id_comp _
  have hβadd : ∀ c c', β (c + c') = β c' ≫ β c := by
    intro c c'
    apply Scheme.Hom.normalization.hom_ext _ _ _ (Scheme.Hom.fromNormalization (p ≫
      Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))))
    · rw [e₁, hP.act_add, ← Category.assoc, e₁, Category.assoc, Category.assoc, e₁]
    · exact e₂ _
    · rw [Category.assoc, e₂, e₂]

  have hY := wc_fntame_torsor_of_generic_torsor _ ℓ β _ p _ α hℓ.ne_zero hfin hEt e₂ hβ0 hβadd hpb
    (fun c => (e₁ c).symm) hP (wc_fntame_flat_generic_generization A₀ X f)
  exact ⟨_, _, β, _, hY, hpb⟩

theorem wc_et_milnor_torsor_normal_generic : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsDomain A] [IsIntegrallyClosed A] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (L : Type u) [Field L] [IsAlgClosed L] (j : A →+* L), Function.Injective j → (∀ y : L, ∃ a₁ b₁ : A, j b₁ ≠ 0 ∧ y * j b₁ = j a₁) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom j))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∃ σ : Limits.pullback (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom j)) ⟶ P, σ ≫ p = 𝟙 _ :=
by
  intro K _ _ ℓ hℓ hℓK A _ _ _ _ _ s x hx hxc B _ _ _ Λ _ _ W' φ a hd L _ _ j hj hfrac P p α hP
  classical

  have hax : a (IsLocalRing.closedPoint B) = x := by
    obtain ⟨-, -, -, -, -, e0, -, he0⟩ := hd
    have pt : Spec (.of (AlgebraicClosure ((wcHalA1 s).residueField x))) :=
      IsLocalRing.closedPoint _
    have h1 := congrArg (fun g : Spec (.of (AlgebraicClosure ((wcHalA1 s).residueField x))) ⟶
      wcHalA1 s => g pt) he0
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h1
    have h2 : ∀ q, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) q =
        IsLocalRing.closedPoint B := fun q => IsLocalRing.PrimeSpectrum.comap_residue B q
    exact (congrArg (fun y => a y) (h2 _)).symm.trans
      (h1.trans (Scheme.fromSpecResidueField_apply x _))

  haveI hkA : IsAlgClosed (IsLocalRing.ResidueField A) := by
    letI : Algebra A L := j.toAlgebra
    haveI : IsFractionRing A L := by
      refine ⟨?_, ?_, ?_⟩
      · intro b
        have hb : (b : A) ≠ 0 := nonZeroDivisors.ne_zero b.2
        exact IsUnit.mk0 _ (fun h => hb (hj (by rw [map_zero]; exact h)))
      · intro y
        obtain ⟨a₁, b₁, hb, hy⟩ := hfrac y
        have hb' : b₁ ∈ nonZeroDivisors A :=
          mem_nonZeroDivisors_of_ne_zero (fun h => hb (by rw [h, map_zero]))
        exact ⟨⟨a₁, ⟨b₁, hb'⟩⟩, hy⟩
      · intro x y hxy
        exact ⟨1, by rw [hj hxy]⟩
    apply IsAlgClosed.of_exists_root
    intro p hmon hirr
    obtain ⟨f, hf, hdeg, hfm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      ((Polynomial.mem_lifts p).2 (Polynomial.map_surjective (IsLocalRing.residue A)
        IsLocalRing.residue_surjective p)) hmon
    have hpdeg : 0 < p.natDegree :=
      Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_pos_of_irreducible hirr)
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_root (f.map j)
      (Polynomial.natDegree_pos_iff_degree_pos.mp
        (by rw [Polynomial.natDegree_map_eq_of_injective hj, hdeg]; exact hpdeg)).ne'
    have hyint : IsIntegral A y :=
      ⟨f, hfm, by change Polynomial.eval₂ j y f = 0; rw [← Polynomial.eval_map]; exact hy⟩
    obtain ⟨a0, ha0⟩ := IsIntegrallyClosed.isIntegral_iff.mp hyint
    have ha0' : j a0 = y := ha0
    refine ⟨IsLocalRing.residue A a0, ?_⟩
    have h1 : j (f.eval a0) = 0 := by
      rw [← Polynomial.eval₂_hom, ← Polynomial.eval_map, ha0']
      exact hy
    have h2 : f.eval a0 = 0 := hj (by rw [h1, map_zero])
    rw [← hf, Polynomial.eval_map, Polynomial.eval₂_hom, h2, map_zero]

  have hd0 := hd
  obtain ⟨_, haff, hcompat, hφa, hlim, -⟩ := hd0
  let F : Λ ⥤ Over (wcHalA1 s) :=
    W' ⋙ StructuredArrow.proj _ _ ⋙ Scheme.Etale.forget (wcHalA1 s)
  have hπ : ∀ l, φ l ≫ (F.obj l).hom ≫ wcHalA1Proj s = a ≫ wcHalA1Proj s := by
    intro l
    show φ l ≫ (W'.obj l).right.hom ≫ wcHalA1Proj s = a ≫ wcHalA1Proj s
    rw [← Category.assoc, hφa l]
  obtain ⟨l, Pl, pl, αl, jj, hPl, hpb⟩ := wc_fet_torsor_cofiltered_limit_descent
    (Spec (.of A)) (Spec (.of L)) (wcHalA1 s) (Spec.map (CommRingCat.ofHom j))
    (wcHalA1Proj s) Λ F (Spec (.of B)) (a ≫ wcHalA1Proj s) φ hπ haff hcompat hlim ℓ hℓ.ne_zero
    P p α hP
  haveI : IsAffine (F.obj l).left := haff l
  haveI : Etale (F.obj l).hom := (W'.obj l).right.prop
  have hφe : φ l ≫ (F.obj l).hom = a := hφa l
  have hew : (F.obj l).hom (φ l (IsLocalRing.closedPoint B)) = x :=
    (Scheme.Hom.comp_apply (φ l) (F.obj l).hom (IsLocalRing.closedPoint B)).symm.trans
      ((congrArg (fun g : Spec (.of B) ⟶ wcHalA1 s => g (IsLocalRing.closedPoint B)) hφe).trans hax)

  obtain ⟨σ, hσ, hσw⟩ := wc_hal_etale_section_through_closed_point K A s (F.obj l).left
    (F.obj l).hom (φ l (IsLocalRing.closedPoint B)) (by rw [hew]; exact hx) (by rw [hew]; exact hxc)

  haveI : Algebra.Smooth K (Polynomial K) := ⟨inferInstance, inferInstance⟩
  haveI : Smooth (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
    exact RingHom.smooth_algebraMap.mpr inferInstance
  haveI : Smooth (wcHalA1Proj s) :=
    MorphismProperty.of_isPullback (P := @Smooth) (IsPullback.of_hasPullback _ _).flip inferInstance
  haveI : Smooth ((F.obj l).hom ≫ wcHalA1Proj s) := inferInstance

  obtain ⟨U, hUaff, hσU, hconn⟩ := wc_smooth_section_geom_connected_affine_nbhd A (F.obj l).left
    ((F.obj l).hom ≫ wcHalA1Proj s) σ hσ
  haveI : IsAffine U := hUaff
  haveI : Smooth (U.ι ≫ (F.obj l).hom ≫ wcHalA1Proj s) := inferInstance
  have hσr : Set.range σ ⊆ Set.range U.ι := by rw [Scheme.Opens.range_ι]; exact hσU
  obtain ⟨σU, hσUf⟩ : ∃ σU, σU ≫ U.ι = σ := ⟨_, IsOpenImmersion.lift_fac U.ι σ hσr⟩
  have hσU1 : σU ≫ (U.ι ≫ (F.obj l).hom ≫ wcHalA1Proj s) = 𝟙 _ := by
    rw [← Category.assoc, hσUf, hσ]

  have hrw : (Limits.pullback.fst (U.ι ≫ (F.obj l).hom ≫ wcHalA1Proj s)
        (Spec.map (CommRingCat.ofHom j)) ≫ U.ι) ≫ ((F.obj l).hom ≫ wcHalA1Proj s) =
      Limits.pullback.snd (U.ι ≫ (F.obj l).hom ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom j)) ≫
        Spec.map (CommRingCat.ofHom j) := by
    rw [Category.assoc]; exact Limits.pullback.condition
  obtain ⟨r, hr1, hr2⟩ : ∃ r, r ≫ Limits.pullback.fst ((F.obj l).hom ≫ wcHalA1Proj s)
        (Spec.map (CommRingCat.ofHom j)) = Limits.pullback.fst (U.ι ≫ (F.obj l).hom ≫ wcHalA1Proj s)
        (Spec.map (CommRingCat.ofHom j)) ≫ U.ι ∧
      r ≫ Limits.pullback.snd ((F.obj l).hom ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom j)) =
        Limits.pullback.snd (U.ι ≫ (F.obj l).hom ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom j)) :=
    ⟨Limits.pullback.lift _ _ hrw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨αU, hPU⟩ := wc_fet_torsor_base_change pl r ℓ αl hPl

  obtain ⟨Y, q, β, i, hY, hipb⟩ := wc_fet_ext_noetherian_reduction wc_fet_ext_noetherian_tame
    K ℓ hℓ hℓK A (Spec.preimage s).hom L j hj hfrac _ (U.ι ≫ (F.obj l).hom ≫ wcHalA1Proj s) σU
    hσU1 hconn (Limits.pullback pl r) (Limits.pullback.snd pl r) αU hPU

  have hφU : Set.range (φ l) ⊆ Set.range U.ι := by
    rintro _ ⟨b, rfl⟩
    have hb : φ l b ⤳ φ l (IsLocalRing.closedPoint B) :=
      (IsLocalRing.specializes_closedPoint b).map (φ l).continuous
    have hw : φ l (IsLocalRing.closedPoint B) ∈ (U : Set (F.obj l).left) := hσU ⟨_, hσw⟩
    exact (Set.ext_iff.mp (Scheme.Opens.range_ι U) _).mpr (hb.mem_open U.isOpen hw)
  obtain ⟨φU, hφUf⟩ : ∃ φU, φU ≫ U.ι = φ l := ⟨_, IsOpenImmersion.lift_fac U.ι (φ l) hφU⟩

  obtain ⟨βB, hβB⟩ := wc_fet_torsor_base_change q φU ℓ β hY
  obtain ⟨τ, hτ⟩ := wc_shens_fet_section B (Limits.pullback q φU) (Limits.pullback.snd q φU)
    hβB.finite hβB.etale hβB.surj
  have hτq : (τ ≫ Limits.pullback.fst q φU) ≫ q = φU := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hτ, Category.id_comp]

  have hπU : φU ≫ (U.ι ≫ (F.obj l).hom ≫ wcHalA1Proj s) = a ≫ wcHalA1Proj s := by
    rw [← Category.assoc, hφUf]
    exact hπ l
  have hmU : (Limits.pullback.fst (a ≫ wcHalA1Proj s) (Spec.map (CommRingCat.ofHom j)) ≫ φU) ≫
