theorem wc_fntame_flat_generic_generization : ∀ (A : Type u) [CommRing A] [IsDomain A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [Flat f] (x : X), ∃ x' ∈ Set.range (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))), x' ⤳ x :=
by
  intro A _ _ X f _ x
  classical
  let η : Spec (.of A) := ⟨⊥, Ideal.isPrime_bot⟩
  have hη : η ⤳ f x := by
    have hb : (⊥ : Ideal A) ≤ (f x).asIdeal := bot_le
    first
    | exact (PrimeSpectrum.le_iff_specializes (R := ↑(CommRingCat.of A)) η (f x)).mp hb
    | exact (PrimeSpectrum.le_iff_specializes (R := A) η (f x)).mp hb
    | exact (PrimeSpectrum.le_iff_specializes (R := ↑(CommRingCat.of A)) η (f x)).mp
        ((PrimeSpectrum.asIdeal_le_asIdeal (R := ↑(CommRingCat.of A)) η (f x)).mp hb)
  obtain ⟨x', hx', hfx'⟩ := (Flat.generalizingMap f) hη
  refine ⟨x', ?_, hx'⟩
  rw [Scheme.Pullback.range_fst, Set.mem_preimage, hfx']
  let ξ : Spec (.of (FractionRing A)) := ⟨⊥, Ideal.isPrime_bot⟩
  refine ⟨ξ, ?_⟩
  apply PrimeSpectrum.ext
  first
  | (rw [Spec.map_apply]
     exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective A (FractionRing A)))
  | (show Ideal.comap (algebraMap A (FractionRing A)) ⊥ = ⊥
     exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective A (FractionRing A)))

theorem wc_fntame_torsor_of_generic_torsor : ∀ {X N T P : Scheme.{u}} (q : N ⟶ X) (m : ℕ) (β : ZMod m → (N ⟶ N)) (j : T ⟶ X) (p : P ⟶ T) (i : P ⟶ N) (α : ZMod m → (P ⟶ P)), m ≠ 0 → IsFinite q → Etale q → (∀ c, β c ≫ q = q) → β 0 = 𝟙 N → (∀ c c', β (c + c') = β c' ≫ β c) → IsPullback i p q j → (∀ c, α c ≫ i = i ≫ β c) → wcFetTorsor p m α → (∀ x : X, ∃ x' ∈ Set.range j, x' ⤳ x) → wcFetTorsor q m β :=
by
  intro X N T P q m β j p i α hm hqf hqe hβp hβ0 hβadd hpb he hP hgen
  classical
  haveI : NeZero m := ⟨hm⟩
  haveI := hqf
  haveI := hqe

  have hgraph : ∀ {W Y : Scheme.{u}} (p : W ⟶ Y) (b : W ⟶ W) (hb : b ≫ p = p),
      IsFinite p → Etale p →
      IsOpenImmersion (Limits.pullback.lift b (𝟙 W) (hb.trans (Category.id_comp p).symm)) ∧
      IsClosed (Set.range (Limits.pullback.lift b (𝟙 W) (hb.trans (Category.id_comp p).symm))) := by
    intro W Y p b hb hpf hpe
    haveI := hpf
    haveI := hpe
    have G2 : Limits.pullback.lift b (𝟙 W) (hb.trans (Category.id_comp p).symm) ≫
        Limits.pullback.snd p p = 𝟙 W := Limits.pullback.lift_snd _ _ _
    generalize Limits.pullback.lift b (𝟙 W) (hb.trans (Category.id_comp p).symm) = G at G2 ⊢
    haveI : Mono G := mono_of_mono_fac G2
    haveI : Etale G := by
      apply MorphismProperty.of_postcomp (W := @Etale) (W' := @Etale) _
        (Limits.pullback.snd p p) inferInstance
      rw [G2]; infer_instance
    haveI : IsClosedImmersion (G ≫ Limits.pullback.snd p p) := by rw [G2]; infer_instance
    haveI : IsClosedImmersion G := IsClosedImmersion.of_comp G (Limits.pullback.snd p p)
    exact ⟨IsOpenImmersion.of_flat_of_mono G, G.isClosedEmbedding.isClosed_range⟩
  let Γ : ZMod m → (N ⟶ Limits.pullback q q) := fun g =>
    Limits.pullback.lift (β g) (𝟙 N) ((hβp g).trans (Category.id_comp q).symm)
  have hΓ : ∀ g, IsOpenImmersion (Γ g) ∧ IsClosed (Set.range (Γ g)) :=
    fun g => hgraph q (β g) (hβp g) hqf hqe
  have Γ1 : ∀ g, Γ g ≫ Limits.pullback.fst q q = β g := fun g => Limits.pullback.lift_fst _ _ _
  have Γ2 : ∀ g, Γ g ≫ Limits.pullback.snd q q = 𝟙 N := fun g => Limits.pullback.lift_snd _ _ _
  let R : ZMod m → Set ↥(Limits.pullback q q) := fun g => Set.range ⇑(Γ g)
  let Bad : Set ↥(Limits.pullback q q) := (⋃ g, R g)ᶜ ∪
    ⋃ (g : ZMod m), ⋃ (g' : ZMod m), ⋃ (_ : g ≠ g'), (R g ∩ R g')

  have hBad : IsOpen Bad := by
    apply IsOpen.union
    · apply isOpen_compl_iff.mpr
      apply isClosed_iUnion_of_finite
      intro g
      exact (hΓ g).2
    · apply isOpen_iUnion
      intro g
      apply isOpen_iUnion
      intro g'
      apply isOpen_iUnion
      intro _
      haveI := (hΓ g).1
      haveI := (hΓ g').1
      exact (IsOpenImmersion.isOpen_range (Γ g)).inter (IsOpenImmersion.isOpen_range (Γ g'))
  have hρ : IsOpenMap ⇑(Limits.pullback.snd q q ≫ q) := Scheme.Hom.isOpenMap _
  have hB : IsOpen (⇑(Limits.pullback.snd q q ≫ q) '' Bad) := hρ _ hBad

  have hαp : ∀ g, α g ≫ p = p := hP.act_p
  let Γ₀ : ZMod m → (P ⟶ Limits.pullback p p) := fun g =>
    Limits.pullback.lift (α g) (𝟙 P) ((hαp g).trans (Category.id_comp p).symm)
  have Γ01 : ∀ g, Γ₀ g ≫ Limits.pullback.fst p p = α g :=
    fun g => Limits.pullback.lift_fst _ _ _
  have Γ02 : ∀ g, Γ₀ g ≫ Limits.pullback.snd p p = 𝟙 P :=
    fun g => Limits.pullback.lift_snd _ _ _
  let κ := Limits.pullback.map p p q q i i j hpb.w.symm hpb.w.symm
  have κ1 : κ ≫ Limits.pullback.fst q q = Limits.pullback.fst p p ≫ i :=
    Limits.pullback.lift_fst _ _ _
  have κ2 : κ ≫ Limits.pullback.snd q q = Limits.pullback.snd p p ≫ i :=
    Limits.pullback.lift_snd _ _ _
  have K : ∀ g, Γ₀ g ≫ κ = i ≫ Γ g := by
    intro g
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [κ1, reassoc_of% (Γ01 g), Γ1, he g]
    · simp only [Category.assoc]
      rw [κ2, reassoc_of% (Γ02 g), Γ2, Category.comp_id]
  have L : ∀ g {S : Scheme.{u}} (t₁ : S ⟶ N) (t₂ : S ⟶ Limits.pullback p p),
      t₁ ≫ Γ g = t₂ ≫ κ → (t₂ ≫ Limits.pullback.snd p p) ≫ Γ₀ g = t₂ := by
    intro g S t₁ t₂ ht
    have e1 : t₂ ≫ Limits.pullback.fst p p ≫ i = t₁ ≫ β g := by
      rw [← κ1, ← Category.assoc, ← ht, Category.assoc, Γ1]
    have e2 : t₂ ≫ Limits.pullback.snd p p ≫ i = t₁ := by
      rw [← κ2, ← Category.assoc, ← ht, Category.assoc, Γ2, Category.comp_id]
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [Γ01]
      apply hpb.hom_ext
      · simp only [Category.assoc]
        rw [he g, reassoc_of% e2, e1]
      · simp only [Category.assoc]
        rw [hαp g, Limits.pullback.condition]
    · simp only [Category.assoc]
      rw [Γ02, Category.comp_id]
  have hG : ∀ g, ⇑κ ⁻¹' Set.range (Γ g) = Set.range (Γ₀ g) := by
    intro g
    ext z
    constructor
    · intro hz
      have hzT : z ∈ Set.range (Limits.pullback.snd (Γ g) κ) := by
        rw [Scheme.Pullback.range_snd]; exact hz
      obtain ⟨w, rfl⟩ := hzT
      have hL := L g (Limits.pullback.fst (Γ g) κ) (Limits.pullback.snd (Γ g) κ)
        Limits.pullback.condition
      refine ⟨(Limits.pullback.snd (Γ g) κ ≫ Limits.pullback.snd p p) w, ?_⟩
      have := Scheme.Hom.comp_apply (Limits.pullback.snd (Γ g) κ ≫ Limits.pullback.snd p p)
        (Γ₀ g) w
      rw [hL] at this
      exact this.symm
    · rintro ⟨v, rfl⟩
      refine ⟨i v, ?_⟩
      have := Scheme.Hom.comp_apply (Γ₀ g) κ v
      rw [K g, Scheme.Hom.comp_apply] at this
      exact this
  have hs : IsPullback (κ ≫ Limits.pullback.fst q q) (Limits.pullback.snd p p) q (i ≫ q) := by
    rw [κ1, hpb.w]
    exact (IsPullback.of_hasPullback p p).paste_horiz hpb
  have hbig : IsPullback κ (Limits.pullback.snd p p ≫ p) (Limits.pullback.snd q q ≫ q) j :=
    (IsPullback.of_right hs κ2 (IsPullback.of_hasPullback q q)).paste_vert hpb
  have hcov : ⋃ g, Set.range (Γ₀ g) = Set.univ := hP.graph_cover
  have hdisj₀ : Pairwise fun g g' => Disjoint (Set.range (Γ₀ g)) (Set.range (Γ₀ g')) :=
    hP.graph_disj

  have hgood : ∀ z, (Limits.pullback.snd q q ≫ q) z ∈ Set.range j → z ∉ Bad := by
    rintro z ⟨t, ht⟩ hz
    obtain ⟨w, rfl, _⟩ := Scheme.exists_preimage_of_isPullback hbig z t ht.symm
    rcases hz with hy | hy
    · apply hy
      have hc : w ∈ ⋃ g, Set.range (Γ₀ g) := by rw [hcov]; exact Set.mem_univ _
      obtain ⟨g, hg⟩ := Set.mem_iUnion.mp hc
      rw [← hG g] at hg
      exact Set.mem_iUnion.mpr ⟨g, hg⟩
    · obtain ⟨g, hy⟩ := Set.mem_iUnion.mp hy
      obtain ⟨g', hy⟩ := Set.mem_iUnion.mp hy
      obtain ⟨hgg', hy⟩ := Set.mem_iUnion.mp hy
      obtain ⟨h1, h2⟩ := hy
      have h1' : w ∈ ⇑κ ⁻¹' Set.range (Γ g) := h1
      have h2' : w ∈ ⇑κ ⁻¹' Set.range (Γ g') := h2
      rw [hG g] at h1'
      rw [hG g'] at h2'
      exact Set.disjoint_left.mp (hdisj₀ hgg') h1' h2'

  have hBempty : ∀ z, z ∉ Bad := by
    intro z hz
    obtain ⟨x', ⟨t, rfl⟩, hsp⟩ := hgen ((Limits.pullback.snd q q ≫ q) z)
    have hx' : j t ∈ ⇑(Limits.pullback.snd q q ≫ q) '' Bad := hsp.mem_open hB ⟨z, hz, rfl⟩
    obtain ⟨z', hz', hz'eq⟩ := hx'
    exact hgood z' ⟨t, hz'eq.symm⟩ hz'

  have hsurj : Set.range q = Set.univ := by
    have hcl : IsClosed (Set.range ⇑q) := (Scheme.Hom.isClosedMap q).isClosed_range
    apply Set.eq_univ_of_forall
    intro x
    obtain ⟨x', ⟨t, rfl⟩, hsp⟩ := hgen x
    have ht : t ∈ Set.range p := by rw [hP.surj]; exact Set.mem_univ _
    obtain ⟨a, rfl⟩ := ht
    have hmem : j (p a) ∈ Set.range ⇑q := by
      refine ⟨i a, ?_⟩
      have h1 := Scheme.Hom.comp_apply i q a
      have h2 := Scheme.Hom.comp_apply p j a
      rw [hpb.w] at h1
      exact h1.symm.trans h2
    exact hsp.mem_closed hcl hmem
  have hdisj : Pairwise fun g g' => Disjoint (Set.range (Γ g)) (Set.range (Γ g')) := by
    intro g g' hgg'
    rw [Set.disjoint_left]
    intro z h1 h2
    exact hBempty z (Or.inr (Set.mem_iUnion.mpr ⟨g, Set.mem_iUnion.mpr ⟨g',
      Set.mem_iUnion.mpr ⟨hgg', h1, h2⟩⟩⟩))
  have hcover : ⋃ g, Set.range (Γ g) = Set.univ := by
    apply Set.eq_univ_of_forall
    intro z
    by_contra h
    exact hBempty z (Or.inl h)
  exact ⟨hqf, hqe, hsurj, hβp, hβ0, hβadd, fun g => (hΓ g).1, hdisj, hcover⟩

theorem wc_fnteg_generic_localized_etale : ∀ (A₀ : Type u) [CommRing A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) (N : Scheme.{u}) (ν : N ⟶ X) (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (τ : P ⟶ N), IsPullback τ p ν (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → Etale p → ∀ (R R' : CommRingCat.{u}) (φ : R ⟶ R') (a : Spec R' ⟶ N) (b : Spec R ⟶ X) (ψ : CommRingCat.of A₀ ⟶ R), IsPullback (Spec.map φ) a b ν → b ≫ f = Spec.map ψ → (IsLocalization.map (Localization (((nonZeroDivisors A₀).map ψ.hom).map φ.hom)) φ.hom ((nonZeroDivisors A₀).map ψ.hom).le_comap_map : Localization ((nonZeroDivisors A₀).map ψ.hom) →+* Localization (((nonZeroDivisors A₀).map ψ.hom).map φ.hom)).Etale :=
by
  intro A₀ _ X f N ν P p τ hpb hp R R' φ a b ψ hsq hψ
  let M : Submonoid R := (nonZeroDivisors A₀).map ψ.hom
  let φM : Localization M →+* Localization (M.map φ.hom) :=
    IsLocalization.map (Localization (M.map φ.hom)) φ.hom M.le_comap_map
  let algR : R →+* Localization M := algebraMap R (Localization M)
  let algR' : R' →+* Localization (M.map φ.hom) := algebraMap R' (Localization (M.map φ.hom))
  have hcomp : φM.comp algR = algR'.comp φ.hom := IsLocalization.map_comp M.le_comap_map
  have hpo := CommRingCat.isPushout_of_isLocalization φ.hom φM hcomp M
  have hSpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
  have Q := hSpb.paste_horiz hsq.flip
  have hunit : ∀ y : nonZeroDivisors A₀, IsUnit ((algR.comp ψ.hom) y) := fun y =>
    IsLocalization.map_units (Localization M) (⟨ψ.hom y, Submonoid.mem_map_of_mem ψ.hom y.2⟩ : M)
  let lam : FractionRing A₀ →+* Localization M := IsLocalization.lift hunit
  have hlam : lam.comp (algebraMap A₀ (FractionRing A₀)) = algR.comp ψ.hom :=
    IsLocalization.lift_comp hunit
  have hcomm : (Spec.map (CommRingCat.ofHom algR) ≫ b) ≫ f =
      Spec.map (CommRingCat.ofHom lam) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) := by
    rw [Category.assoc, hψ, ← Spec.map_comp, ← Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom,
      CommRingCat.hom_ofHom]
    exact hlam.symm
  let j := Limits.pullback.lift _ _ hcomm
  have hj : j ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) =
      Spec.map (CommRingCat.ofHom algR) ≫ b := Limits.pullback.lift_fst _ _ _
  have Q' : IsPullback (Spec.map (CommRingCat.ofHom algR') ≫ a) (Spec.map (CommRingCat.ofHom φM)) ν
      (j ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := by
    rw [hj]; exact Q
  have hw : (Spec.map (CommRingCat.ofHom algR') ≫ a) ≫ ν = (Spec.map (CommRingCat.ofHom φM) ≫ j) ≫
      Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) := by
    simpa only [Category.assoc] using Q'.w
  have hout : IsPullback (hpb.lift _ _ hw ≫ τ) (Spec.map (CommRingCat.ofHom φM)) ν
      (j ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := by
    rw [hpb.lift_fst]; exact Q'
  have hcart := IsPullback.of_right hout (hpb.lift_snd _ _ hw) hpb
  have het : Etale (Spec.map (CommRingCat.ofHom φM)) :=
    MorphismProperty.of_isPullback (P := @Etale) hcart hp
  exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp het

theorem wc_fnteg_spread_etale : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (φ : R →+* R'), φ.Finite → φ.FinitePresentation → ∀ (M : Submonoid R), (IsLocalization.map (Localization (M.map φ)) φ M.le_comap_map : Localization M →+* Localization (M.map φ)).Etale → ∀ (𝔭 : Ideal R) [𝔭.IsPrime], Disjoint (M : Set R) (𝔭 : Set R) → ∃ r : R, r ∉ 𝔭 ∧ ((algebraMap R' (Localization.Away (φ r))).comp φ).Etale :=
by
  intro R R' _ _ φ hf hp M hM 𝔭 _ hdisj
  classical
  letI : Algebra R R' := φ.toAlgebra
  haveI : Module.Finite R R' := hf
  haveI : Algebra.FinitePresentation R R' := hp

  have hloc : ∀ (𝔮 : Ideal R') [𝔮.IsPrime], (∀ m ∈ M, φ m ∉ 𝔮) → Algebra.IsEtaleAt R 𝔮 := by
    intro 𝔮 _ hq
    let N : Submonoid R' := M.map φ
    let S := Localization N
    let T := Localization.AtPrime 𝔮
    let φM : Localization M →+* S := IsLocalization.map S φ M.le_comap_map
    letI : Algebra (Localization M) S := φM.toAlgebra
    haveI : Algebra.Etale (Localization M) S := hM
    haveI : Algebra.FormallyEtale R (Localization M) := Algebra.FormallyEtale.of_isLocalization M
    haveI : IsScalarTower R (Localization M) S := by
      apply IsScalarTower.of_algebraMap_eq'
      rw [IsScalarTower.algebraMap_eq R R' S]
      exact (IsLocalization.map_comp M.le_comap_map).symm
    haveI : Algebra.FormallyEtale R S := Algebra.FormallyEtale.comp R (Localization M) S
    have hN : N ≤ 𝔮.primeCompl := by
      rintro _ ⟨m, hm, rfl⟩
      exact hq m hm
    letI : Algebra S T := IsLocalization.localizationAlgebraOfSubmonoidLe S T N 𝔮.primeCompl hN
    haveI : IsScalarTower R' S T :=
      IsLocalization.localization_isScalarTower_of_submonoid_le S T N 𝔮.primeCompl hN
    haveI : IsLocalization (Submonoid.map (algebraMap R' S) 𝔮.primeCompl) T :=
      IsLocalization.isLocalization_of_submonoid_le S T N 𝔮.primeCompl hN
    haveI : Algebra.FormallyEtale S T :=
      Algebra.FormallyEtale.of_isLocalization (Submonoid.map (algebraMap R' S) 𝔮.primeCompl)
    haveI : IsScalarTower R S T := by
      apply IsScalarTower.of_algebraMap_eq'
      rw [IsScalarTower.algebraMap_eq R R' T, IsScalarTower.algebraMap_eq R' S T,
        IsScalarTower.algebraMap_eq R R' S, RingHom.comp_assoc]
    exact Algebra.FormallyEtale.comp R S T

  have hfib : ∀ 𝔮 : PrimeSpectrum R', Ideal.comap φ 𝔮.asIdeal = 𝔭 →
      𝔮 ∈ Algebra.etaleLocus R R' := by
    intro 𝔮 h𝔮
    rw [Algebra.mem_etaleLocus_iff]
    apply hloc
    intro m hm hm'
    have h1 : m ∈ 𝔭 := by rw [← h𝔮]; exact hm'
    exact Set.disjoint_left.mp hdisj hm h1

  have hZ : IsClosed (Algebra.etaleLocus R R')ᶜ := Algebra.isOpen_etaleLocus.isClosed_compl
  have hint : φ.IsIntegral := RingHom.IsIntegral.of_finite hf
  have hC : IsClosed (PrimeSpectrum.comap φ '' (Algebra.etaleLocus R R')ᶜ) :=
    PrimeSpectrum.isClosedMap_comap_of_isIntegral φ hint _ hZ
  have hpt : (⟨𝔭, inferInstance⟩ : PrimeSpectrum R) ∈
      (PrimeSpectrum.comap φ '' (Algebra.etaleLocus R R')ᶜ)ᶜ := by
    rintro ⟨𝔮, h𝔮Z, h𝔮⟩
    apply h𝔮Z
    apply hfib
    have h1 := congrArg PrimeSpectrum.asIdeal h𝔮
    rw [PrimeSpectrum.comap_asIdeal] at h1
    exact h1
  obtain ⟨v, ⟨r, rfl⟩, hpv, hvC⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hpt hC.isOpen_compl
  have hr : r ∉ 𝔭 := hpv
  have hsub : (PrimeSpectrum.basicOpen (algebraMap R R' r) : Set (PrimeSpectrum R')) ⊆
      Algebra.etaleLocus R R' := by
    intro 𝔮 h𝔮
    by_contra hne
    have hmem : PrimeSpectrum.comap φ 𝔮 ∈ (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum R)) := by
      show r ∉ (PrimeSpectrum.comap φ 𝔮).asIdeal
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
      exact h𝔮
    exact hvC hmem ⟨𝔮, hne, rfl⟩
  haveI hE : Algebra.Etale R (Localization.Away (algebraMap R R' r)) :=
    Algebra.basicOpen_subset_etaleLocus_iff_etale.mp hsub
  refine ⟨r, hr, ?_⟩
  have h2 := RingHom.etale_algebraMap.mpr hE
  rw [IsScalarTower.algebraMap_eq R R' (Localization.Away (algebraMap R R' r))] at h2
  exact h2

theorem wc_fnteg_basicOpen_etale : ∀ {X N : Scheme.{u}} (ν : N ⟶ X) [IsAffineHom ν] (U : X.Opens), IsAffineOpen U → ∀ r : Γ(X, U), ((algebraMap Γ(N, ν ⁻¹ᵁ U) (Localization.Away ((ν.app U).hom r))).comp (ν.app U).hom).Etale → Etale (ν ∣_ X.basicOpen r) :=
by
  have s1 : ∀ {R R' S Q : Type u} [CommRing R] [CommRing R'] [CommRing S] [CommRing Q]
      [Algebra R S] [Algebra R' Q] (φ : R →+* R') (r : R) [IsLocalization.Away r S]
      [IsLocalization.Away (φ r) Q],
      ((algebraMap R' (Localization.Away (φ r))).comp φ).Etale →
      (IsLocalization.Away.map S Q φ r).Etale := by
    intro R R' S Q _ _ _ _ _ _ φ r _ _ h
    have hc : ((algebraMap R' Q).comp φ).Etale := by
      let e := IsLocalization.algEquiv (Submonoid.powers (φ r)) (Localization.Away (φ r)) Q
      have : (algebraMap R' Q).comp φ =
          e.toRingEquiv.toRingHom.comp ((algebraMap R' (Localization.Away (φ r))).comp φ) := by
        ext x; simp [e]
      rw [this]
      exact RingHom.Etale.respectsIso.1 _ _ h
    have hcomp : (IsLocalization.Away.map S Q φ r).comp (algebraMap R S) =
        (algebraMap R' Q).comp φ :=
      IsLocalization.map_comp _
    letI : Algebra S Q := (IsLocalization.Away.map S Q φ r).toAlgebra
    letI : Algebra R Q := ((algebraMap R' Q).comp φ).toAlgebra
    haveI : IsScalarTower R S Q := IsScalarTower.of_algebraMap_eq' hcomp.symm
    haveI : Algebra.Etale R Q := hc
    haveI : Algebra.FormallyEtale S Q :=
      Algebra.FormallyEtale.localization_base (M := Submonoid.powers r)
    haveI : Algebra.FinitePresentation R S := IsLocalization.Away.finitePresentation (S := S) r
    haveI : Algebra.FiniteType R S := Algebra.FiniteType.of_finitePresentation
    haveI : Algebra.FinitePresentation S Q :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R S Q
    exact (⟨inferInstance, inferInstance⟩ : Algebra.Etale S Q)
  intro X N ν _ U hU r h
  have hV : IsAffineOpen (X.basicOpen r) := hU.basicOpen r
  have hV' : IsAffineOpen (ν ⁻¹ᵁ X.basicOpen r) := hV.preimage ν
  have s2 : ∀ (V : X.Opens), IsAffineOpen V → IsAffineOpen (ν ⁻¹ᵁ V) → (ν.app V).hom.Etale →
      Etale (ν ∣_ V) := by
    intro V h1 h2 h3
    haveI : IsAffine V := h1
    haveI : IsAffine (ν ⁻¹ᵁ V) := h2
    rw [HasRingHomProperty.iff_of_isAffine (P := @Etale), morphismRestrict_appTop]
    refine (RingHom.RespectsIso.cancel_right_isIso RingHom.Etale.respectsIso
      (ν.app (V.ι ''ᵁ ⊤)) (N.presheaf.map (eqToHom _).op)).mpr ?_
    have e : V.ι ''ᵁ ⊤ = V := Scheme.Opens.ι_image_top V
    rw [e]
    exact h3
  apply s2 _ hV hV'
  haveI := hU.isLocalization_basicOpen r
  haveI := (hU.preimage ν).isLocalization_basicOpen ((ν.app U).hom r)
  rw [IsAffineOpen.app_basicOpen_eq_away_map ν hU (hU.preimage ν) r, CommRingCat.hom_comp]
  refine (RingHom.RespectsIso.cancel_right_isIso RingHom.Etale.respectsIso _ _).mpr ?_
  rw [CommRingCat.hom_ofHom]
  exact s1 _ r h

theorem wc_fntame_etale_over_generic : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsNoetherianRing A₀] (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], IsFinite p → Etale p → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ x : X, (f x).asIdeal.height = 0 → ∃ W : X.Opens, x ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) :=
by
  intro A₀ _ _ _ X _ _ f _ P p _ _ _ hPe hfin hpb x hx
  classical

  have hfx : (f x).asIdeal = ⊥ := by
    haveI := (f x).isPrime
    have h1 := Ideal.height_eq_zero_iff.mp hx
    rw [IsDomain.minimalPrimes_eq_singleton_bot] at h1
    exact h1

  have key : ∀ (N : Scheme.{u}) (ν : N ⟶ X) (τ : P ⟶ N), IsFinite ν →
      IsPullback τ p ν (Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) →
      ∃ W : X.Opens, x ∈ W ∧ Etale (ν ∣_ W) := by
    intro N ν τ hνfin hνpb
    haveI := hνfin

    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
    haveI : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
    have hφfin : (ν.app U).hom.Finite := IsFinite.finite_app ν U hU
    have hφfp : (ν.app U).hom.FinitePresentation :=
      RingHom.FinitePresentation.of_finiteType.mp hφfin.finiteType
    obtain ⟨ψ, hψ⟩ : ∃ ψ : CommRingCat.of A₀ ⟶ Γ(X, U), hU.fromSpec ≫ f = Spec.map ψ :=
      ⟨_, (Spec.map_preimage _).symm⟩
    obtain ⟨𝔭, h𝔭⟩ : ∃ 𝔭, hU.fromSpec 𝔭 = x := ⟨_, hU.fromSpec_primeIdealOf ⟨x, hxU⟩⟩
    have h1 : (Spec.map ψ) 𝔭 = f x := by rw [← hψ, Scheme.Hom.comp_apply, h𝔭]
    have hcomap : Ideal.comap ψ.hom 𝔭.asIdeal = ⊥ := by
      rw [← hfx, ← h1, Spec.map_apply]
      rfl
    have hdisj : Disjoint (((nonZeroDivisors A₀).map ψ.hom : Submonoid Γ(X, U)) : Set Γ(X, U))
        (𝔭.asIdeal : Set Γ(X, U)) := by
      rw [Set.disjoint_left]
      intro m hm hm'
      obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hm
      have hs' : s ∈ Ideal.comap ψ.hom 𝔭.asIdeal := hm'
      rw [hcomap] at hs'
      exact nonZeroDivisors.ne_zero hs ((Submodule.mem_bot _).mp hs')

    have hsq : IsPullback (Spec.map (ν.app U)) (hU.preimage ν).fromSpec hU.fromSpec ν := by
      haveI := hU.isOpenImmersion_fromSpec
      haveI := (hU.preimage ν).isOpenImmersion_fromSpec
      refine IsOpenImmersion.isPullback _ _ _ _ ?_ ?_
      · rw [← Scheme.Hom.appLE_eq_app, IsAffineOpen.SpecMap_appLE_fromSpec]
      · rw [IsAffineOpen.opensRange_fromSpec, IsAffineOpen.opensRange_fromSpec]

    have h4 := wc_fnteg_generic_localized_etale A₀ X f N ν P p τ hνpb hPe _ _ (ν.app U) _ _ ψ
      hsq hψ
    haveI := 𝔭.isPrime
    obtain ⟨r, hr𝔭, hr⟩ := wc_fnteg_spread_etale (ν.app U).hom hφfin hφfp _ h4 𝔭.asIdeal hdisj
    refine ⟨X.basicOpen r, ?_, wc_fnteg_basicOpen_etale ν U hU r hr⟩
    have hmem : 𝔭 ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen r := by
      rw [hU.fromSpec_preimage_basicOpen]
      exact hr𝔭
    rw [← h𝔭]
    exact hmem
  exact key _ _ _ hfin hpb

theorem wc_rlufd_nagata : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] (x : A), Prime x → UniqueFactorizationMonoid (Localization.Away x) → UniqueFactorizationMonoid A :=
by
  intro A _ _ _ x hx hB
  classical
  have hx0 : x ≠ 0 := hx.ne_zero
  have hle : Submonoid.powers x ≤ nonZeroDivisors A :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hx0
  have hinj : Function.Injective (algebraMap A (Localization.Away x)) :=
    IsLocalization.injective (Localization.Away x) hle
  have : WfDvdMonoid A := IsNoetherianRing.wfDvdMonoid
  have star : ∀ a' : A, ¬ x ∣ a' → ∀ b : A,
      algebraMap A (Localization.Away x) a' ∣ algebraMap A (Localization.Away x) b → a' ∣ b := by
    intro a' hnd b hdvd
    obtain ⟨z, hz⟩ := hdvd
    obtain ⟨m, t, ht⟩ := IsLocalization.Away.surj x z
    have h1 : b * x ^ m = a' * t := by
      apply hinj
      rw [map_mul, map_mul, map_pow, hz, mul_assoc, ht]
    have h2 : x ^ m ∣ a' * t := ⟨b, by rw [← h1, mul_comm]⟩
    obtain ⟨t', rfl⟩ := hx.pow_dvd_of_dvd_mul_left m hnd h2
    refine ⟨t', ?_⟩
    apply mul_right_cancel₀ (pow_ne_zero m hx0)
    rw [h1]; ring
  have descent : ∀ a' : A, ¬ x ∣ a' → Prime (algebraMap A (Localization.Away x) a') →
      Prime a' := by
    intro a' hnd hq
    refine ⟨?_, ?_, ?_⟩
    · rintro rfl
      exact hq.ne_zero (map_zero _)
    · intro hu
      exact hq.not_isUnit (hu.map _)
    · intro b c hbc
      have hd : algebraMap A (Localization.Away x) a' ∣
          algebraMap A (Localization.Away x) b * algebraMap A (Localization.Away x) c := by
        rw [← map_mul]; exact map_dvd (algebraMap A (Localization.Away x)) hbc
      have := hq.dvd_or_dvd hd
      exact this.imp (star a' hnd b) (star a' hnd c)
  rw [UniqueFactorizationMonoid.iff_exists_prime_mem_of_isPrime]
  intro P hP0 hPp
  by_cases hxP : x ∈ P
  · exact ⟨x, hxP, hx⟩
  have hdisj : Disjoint (↑(Submonoid.powers x) : Set A) ↑P := by
    rw [Set.disjoint_left]
    intro y hy hyP
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hy
    exact hxP (hPp.mem_of_pow_mem n hyP)
  have hPBp := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers x)
    (Localization.Away x) P hPp hdisj
  have hcomap := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers x)
    (Localization.Away x) hPp hdisj
  have hPB0 : P.map (algebraMap A (Localization.Away x)) ≠ ⊥ := by
    obtain ⟨p0, hp0, hp00⟩ := (Submodule.ne_bot_iff P).mp hP0
    rw [Submodule.ne_bot_iff]
    refine ⟨_, Ideal.mem_map_of_mem _ hp0, ?_⟩
    intro h
    exact hp00 (hinj (by rw [h, map_zero]))
  obtain ⟨q, hqPB, hqp⟩ := hPBp.exists_mem_prime_of_ne_bot hPB0
  obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj x q
  have hu : IsUnit (algebraMap A (Localization.Away x) x) :=
    IsLocalization.Away.algebraMap_isUnit x
  have ha0 : a ≠ 0 := by
    rintro rfl
    rw [map_zero] at ha
    exact hqp.ne_zero ((IsUnit.mul_left_eq_zero (hu.pow n)).mp ha)
  obtain ⟨k, a', hnd, rfl⟩ := WfDvdMonoid.max_power_factor ha0 hx.irreducible
  have hass : Associated (algebraMap A (Localization.Away x) a') q := by
    have e : algebraMap A (Localization.Away x) a' * algebraMap A (Localization.Away x) x ^ k =
        q * algebraMap A (Localization.Away x) x ^ n := by
      rw [ha, map_mul, map_pow, mul_comm]
    have h1 := associated_mul_unit_left (algebraMap A (Localization.Away x) a') _ (hu.pow k)
    rw [e] at h1
    exact h1.symm.trans (associated_mul_unit_left q _ (hu.pow n))
  have hprime : Prime (algebraMap A (Localization.Away x) a') := hass.symm.prime hqp
  have hmemB : algebraMap A (Localization.Away x) a' ∈
      P.map (algebraMap A (Localization.Away x)) := by
    obtain ⟨v, hv⟩ := hass.symm
    rw [← hv]
    exact Ideal.mul_mem_right _ _ hqPB
  have hmem : a' ∈ P := by
    rw [← hcomap]
    exact Ideal.mem_comap.mpr hmemB
  exact ⟨a', hmem, descent a' hnd hprime⟩

theorem wc_rlufd_spanFinrank_lt : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsRegularLocalRing A → ∀ (𝔭 : Ideal A) [𝔭.IsPrime], 𝔭 ≠ IsLocalRing.maximalIdeal A → IsRegularLocalRing (Localization.AtPrime 𝔭) → Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)) < Submodule.spanFinrank (IsLocalRing.maximalIdeal A) :=
by
  intro A _ _ _ hA 𝔭 _ hne hP
  haveI := Ideal.finiteHeight_of_isNoetherianRing 𝔭
  have h4 : 𝔭 < IsLocalRing.maximalIdeal A :=
    lt_of_le_of_ne (IsLocalRing.le_maximalIdeal_of_isPrime 𝔭) hne
  have h5 := Ideal.height_strict_mono_of_isPrime h4
  have e1 := @IsRegularLocalRing.spanFinrank_maximalIdeal (Localization.AtPrime 𝔭) _ hP
  have e0 := @IsRegularLocalRing.spanFinrank_maximalIdeal A _ hA
  have e2 := IsLocalization.AtPrime.ringKrullDim_eq_height 𝔭 (Localization.AtPrime 𝔭)
  have e3 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := A)
  have key : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)) : ℕ) :
      WithBot ℕ∞) < ((Submodule.spanFinrank (IsLocalRing.maximalIdeal A) : ℕ) : WithBot ℕ∞) := by
    calc ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)) : ℕ) :
          WithBot ℕ∞) = ringKrullDim (Localization.AtPrime 𝔭) := by exact_mod_cast e1
      _ = ((𝔭.height : ℕ∞) : WithBot ℕ∞) := e2
      _ < (((IsLocalRing.maximalIdeal A).height : ℕ∞) : WithBot ℕ∞) := WithBot.coe_lt_coe.mpr h5
      _ = ringKrullDim A := e3
      _ = ((Submodule.spanFinrank (IsLocalRing.maximalIdeal A) : ℕ) : WithBot ℕ∞) := by
          exact_mod_cast e0.symm
  exact_mod_cast key

theorem wc_rlufd_away_localization_ufm : ∀ (A : Type u) [CommRing A] (x : A), (∀ (𝔭 : Ideal A) [𝔭.IsPrime], x ∉ 𝔭 → UniqueFactorizationMonoid (Localization.AtPrime 𝔭)) → ∀ (𝔫 : Ideal (Localization.Away x)) [𝔫.IsPrime], UniqueFactorizationMonoid (Localization.AtPrime 𝔫) :=
by
  intro A _ x hloc 𝔫 h𝔫
  haveI h𝔭 : (Ideal.comap (algebraMap A (Localization (Submonoid.powers x))) 𝔫).IsPrime :=
    Ideal.comap_isPrime _ 𝔫
  have hu : IsUnit (algebraMap A (Localization (Submonoid.powers x)) x) :=
    IsLocalization.Away.algebraMap_isUnit x
  have hx : x ∉ Ideal.comap (algebraMap A (Localization (Submonoid.powers x))) 𝔫 := fun h =>
    h𝔫.ne_top (Ideal.eq_top_of_isUnit_mem 𝔫 (Ideal.mem_comap.mp h) hu)
  have hU := hloc (Ideal.comap (algebraMap A (Localization (Submonoid.powers x))) 𝔫) hx
  exact MulEquiv.uniqueFactorizationMonoid
    (IsLocalization.localizationLocalizationAtPrimeIsoLocalization
      (Submonoid.powers x) 𝔫).toMulEquiv hU

theorem wc_rlufd_minimal_prime_locally_principal : ∀ (B : Type u) [CommRing B] [IsDomain B] (a : B), a ≠ 0 → ∀ Q ∈ (Ideal.span {a}).minimalPrimes, ∀ (𝔫 : Ideal B) [𝔫.IsPrime], UniqueFactorizationMonoid (Localization.AtPrime 𝔫) → (Q.map (algebraMap B (Localization.AtPrime 𝔫))).IsPrincipal :=
by
  intro B _ _ a ha Q hQ 𝔫 _ hU
  classical
  have hQmin : Minimal (fun q : Ideal B => q.IsPrime ∧ Ideal.span {a} ≤ q) Q := hQ
  have hQp : Q.IsPrime := hQmin.1.1
  have haQ : a ∈ Q := hQmin.1.2 (Ideal.mem_span_singleton_self a)
  by_cases hQn : Q ≤ 𝔫
  · have hdisj : Disjoint (𝔫.primeCompl : Set B) (Q : Set B) :=
      Set.disjoint_left.mpr fun x hx hxQ => hx (hQn hxQ)
    have hP : (Q.map (algebraMap B (Localization.AtPrime 𝔫))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint 𝔫.primeCompl (Localization.AtPrime 𝔫) Q hQp hdisj
    have hcomap : Ideal.comap (algebraMap B (Localization.AtPrime 𝔫))
        (Q.map (algebraMap B (Localization.AtPrime 𝔫))) = Q :=
      IsLocalization.under_map_of_isPrime_disjoint 𝔫.primeCompl (Localization.AtPrime 𝔫) hQp hdisj
    have hinj : Function.Injective (algebraMap B (Localization.AtPrime 𝔫)) :=
      IsLocalization.injective (Localization.AtPrime 𝔫) (Ideal.primeCompl_le_nonZeroDivisors 𝔫)
    have hφa : algebraMap B (Localization.AtPrime 𝔫) a ≠ 0 := by
      intro h
      apply ha
      apply hinj
      rw [h, map_zero]
    have hφaP : algebraMap B (Localization.AtPrime 𝔫) a ∈
        Q.map (algebraMap B (Localization.AtPrime 𝔫)) :=
      Ideal.mem_map_of_mem _ haQ
    obtain ⟨f, hfp, hfa⟩ := UniqueFactorizationMonoid.exists_prime_factors _ hφa
    have hfP : f.prod ∈ Q.map (algebraMap B (Localization.AtPrime 𝔫)) := by
      obtain ⟨c, hc⟩ := hfa.dvd'
      rw [hc]
      exact Ideal.mul_mem_right c _ hφaP
    obtain ⟨p, hpf, hpP⟩ := (hP.multiset_prod_mem_iff_exists_mem f).mp hfP
    have hpp : Prime p := hfp p hpf
    have hp0 : p ≠ 0 := hpp.ne_zero
    have hP'prime : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hp0).mpr hpp
    have hP'le : Ideal.span {p} ≤ Q.map (algebraMap B (Localization.AtPrime 𝔫)) :=
      (Ideal.span_singleton_le_iff_mem _).mpr hpP
    have hφaP' : algebraMap B (Localization.AtPrime 𝔫) a ∈ Ideal.span {p} :=
      Ideal.mem_span_singleton.mpr (dvd_trans (Multiset.dvd_prod hpf) hfa.dvd)
    have hQ'eq : Ideal.comap (algebraMap B (Localization.AtPrime 𝔫)) (Ideal.span {p}) = Q := by
      apply hQmin.eq_of_le ⟨Ideal.comap_isPrime _ _,
        (Ideal.span_singleton_le_iff_mem _).mpr (Ideal.mem_comap.mpr hφaP')⟩
      calc Ideal.comap (algebraMap B (Localization.AtPrime 𝔫)) (Ideal.span {p})
          ≤ Ideal.comap (algebraMap B (Localization.AtPrime 𝔫))
            (Q.map (algebraMap B (Localization.AtPrime 𝔫))) := Ideal.comap_mono hP'le
        _ = Q := hcomap
    have hmap : Q.map (algebraMap B (Localization.AtPrime 𝔫)) = Ideal.span {p} := by
      rw [← hQ'eq]
      exact IsLocalization.map_under 𝔫.primeCompl (Localization.AtPrime 𝔫) _
    exact ⟨⟨p, hmap⟩⟩
  · obtain ⟨q, hqQ, hqn⟩ := SetLike.not_le_iff_exists.mp hQn
    have hu : IsUnit (algebraMap B (Localization.AtPrime 𝔫) q) :=
      IsLocalization.map_units (Localization.AtPrime 𝔫) (⟨q, hqn⟩ : 𝔫.primeCompl)
    have htop : Q.map (algebraMap B (Localization.AtPrime 𝔫)) = ⊤ :=
      Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hqQ) hu
    rw [htop]
    exact ⟨⟨1, Ideal.span_singleton_one.symm⟩⟩

theorem wc_rlufd_projective_of_locally_principal : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B] (Q : Ideal B), (∀ (𝔫 : Ideal B) [𝔫.IsMaximal], (Q.map (algebraMap B (Localization.AtPrime 𝔫))).IsPrincipal) → Module.Projective B ↥Q :=
by
  intro B _ _ _ Q h
  haveI : Module.FinitePresentation B ↥Q := Module.finitePresentation_of_finite B ↥Q
  refine Module.projective_of_localization_maximal' (fun P _ => Localization.AtPrime P)
    (fun P _ => ↥(Submodule.localized' (Localization.AtPrime P) P.primeCompl
      (Algebra.linearMap B (Localization.AtPrime P)) Q))
    (fun P _ => Submodule.toLocalized' (Localization.AtPrime P) P.primeCompl
      (Algebra.linearMap B (Localization.AtPrime P)) Q) ?_
  intro I hI
  have hEq := Ideal.localized'_eq_map (Localization.AtPrime I) I.primeCompl Q
  obtain ⟨g, hg⟩ := (h I).principal
  have hEq' := hEq.trans hg
  by_cases hg0 : g = 0
  · subst hg0
    haveI : Subsingleton ↥(Submodule.localized' (Localization.AtPrime I) I.primeCompl
        (Algebra.linearMap B (Localization.AtPrime I)) Q) := by
      constructor
      intro a b
      apply Subtype.ext
      have ha := (SetLike.ext_iff.mp hEq' _).mp a.2
      have hb := (SetLike.ext_iff.mp hEq' _).mp b.2
      rw [Submodule.span_singleton_eq_bot.mpr rfl, Submodule.mem_bot] at ha hb
      rw [ha, hb]
    exact Module.Projective.of_free
  · exact Module.Projective.of_equiv ((LinearEquiv.toSpanNonzeroSingleton _ _ g hg0).trans
      (LinearEquiv.ofEq _ _ hEq'.symm))

theorem wc_rlufd_ses_stably_free : ∀ (B : Type u) [CommRing B] (K F M : Type u) [AddCommGroup K] [Module B K] [AddCommGroup F] [Module B F] [AddCommGroup M] [Module B M] (f : K →ₗ[B] F) (g : F →ₗ[B] M) (r : ℕ), Function.Injective f → Function.Exact f g → Function.Surjective g → Module.Projective B M → Nonempty (F ≃ₗ[B] (Fin r → B)) → Module.Projective B K ∧ ((∃ a b : ℕ, Nonempty ((K × (Fin a → B)) ≃ₗ[B] (Fin b → B))) → ∃ a b : ℕ, Nonempty ((M × (Fin a → B)) ≃ₗ[B] (Fin b → B))) :=
by
  intro B _ K F M _ _ _ _ _ _ f g r hf hex hg hM hφ
  obtain ⟨φ⟩ := hφ
  obtain ⟨l, hl⟩ :=
    LinearMap.exists_rightInverse_of_surjective g (LinearMap.range_eq_top.mpr hg)
  obtain ⟨e, he1, -⟩ := hex.splitSurjectiveEquiv hf ⟨l, hl⟩
  haveI : Module.Projective B F := Module.Projective.of_equiv φ.symm
  refine ⟨?_, ?_⟩
  · refine Module.Projective.of_split f (LinearMap.fst B K M ∘ₗ (e : F →ₗ[B] K × M)) ?_
    apply LinearMap.ext
    intro k
    have hk : f k = e.symm (k, 0) := by rw [he1]; rfl
    rw [LinearMap.comp_apply, LinearMap.comp_apply, hk, LinearEquiv.coe_coe,
      LinearEquiv.apply_symm_apply]
    rfl
  · rintro ⟨a, b, ⟨ψ⟩⟩
    refine ⟨b, r + a, ⟨?_⟩⟩
    exact ((((((LinearEquiv.prodCongr (LinearEquiv.refl B M) ψ.symm).trans
      (LinearEquiv.prodAssoc B M K (Fin a → B)).symm).trans
      (LinearEquiv.prodCongr (LinearEquiv.prodComm B M K) (LinearEquiv.refl B (Fin a → B)))).trans
      (LinearEquiv.prodCongr e.symm (LinearEquiv.refl B (Fin a → B)))).trans
      (LinearEquiv.prodCongr φ (LinearEquiv.refl B (Fin a → B)))).trans
      (LinearEquiv.sumArrowLequivProdArrow (Fin r) (Fin a) B B).symm).trans
      (LinearEquiv.funCongrLeft B B finSumFinEquiv.symm)

theorem wc_rlufd_localized_free : ∀ (A : Type u) [CommRing A] (S : Submonoid A) (M : Type u) [AddCommGroup M] [Module A M] (r : ℕ), Nonempty (M ≃ₗ[A] (Fin r → A)) → Nonempty (LocalizedModule S M ≃ₗ[Localization S] (Fin r → Localization S)) :=
by
  intro A _ S M _ _ r ⟨e⟩
  exact ⟨((Module.Basis.ofEquivFun e).ofIsLocalizedModule (Localization S) S
    (LocalizedModule.mkLinearMap S M)).equivFun⟩

theorem wc_rlufd_localized_pd_stably_free : (∀ (B : Type u) [CommRing B] (K F M : Type u) [AddCommGroup K] [Module B K] [AddCommGroup F] [Module B F] [AddCommGroup M] [Module B M] (f : K →ₗ[B] F) (g : F →ₗ[B] M) (r : ℕ), Function.Injective f → Function.Exact f g → Function.Surjective g → Module.Projective B M → Nonempty (F ≃ₗ[B] (Fin r → B)) → Module.Projective B K ∧ ((∃ a b : ℕ, Nonempty ((K × (Fin a → B)) ≃ₗ[B] (Fin b → B))) → ∃ a b : ℕ, Nonempty ((M × (Fin a → B)) ≃ₗ[B] (Fin b → B)))) → (∀ (A : Type u) [CommRing A] (S : Submonoid A) (M : Type u) [AddCommGroup M] [Module A M] (r : ℕ), Nonempty (M ≃ₗ[A] (Fin r → A)) → Nonempty (LocalizedModule S M ≃ₗ[Localization S] (Fin r → Localization S))) → ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (S : Submonoid A) (n : ℕ) (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M], CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of A M) n → Module.Projective (Localization S) (LocalizedModule S M) → ∃ a b : ℕ, Nonempty ((LocalizedModule S M × (Fin a → Localization S)) ≃ₗ[Localization S] (Fin b → Localization S)) :=
by
  intro SES LOCFREE A _ _ _ S n
  have base : ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      HasProjectiveDimensionLT (ModuleCat.of A M) 1 →
      ∃ a b : ℕ, Nonempty ((LocalizedModule S M × (Fin a → Localization S)) ≃ₗ[Localization S]
        (Fin b → Localization S)) := by
    intro M _ _ _ hM
    haveI : Projective (ModuleCat.of A M) := projective_iff_hasProjectiveDimensionLT_one.mpr hM
    haveI : Module.Projective A M := (IsProjective.iff_projective (R := A) (P := M)).mpr this
    haveI : Module.Free A M := Module.free_of_flat_of_isLocalRing
    obtain ⟨e'⟩ := LOCFREE A S M (Module.finrank A M) ⟨(Module.finBasis A M).equivFun⟩
    exact ⟨0, Module.finrank A M, ⟨LinearEquiv.prodUnique.trans e'⟩⟩
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro M _ _ _ hM hP
  match n, ih, hM with
  | 0, _, hM =>
    haveI := hM
    exact base M (hasProjectiveDimensionLT_of_ge _ 0 1 (by omega))
  | 1, _, hM => exact base M hM
  | m + 2, ih, hM =>
    obtain ⟨r, π, hπ⟩ := Module.Finite.exists_fin' A M
    haveI : Module.Finite A (LinearMap.ker π) := Module.IsNoetherian.finite A _
    have hK : HasProjectiveDimensionLT (ModuleCat.of A (LinearMap.ker π)) (m + 1) := by
      let T : ShortComplex (ModuleCat.{u} A) :=
        ShortComplex.mk (ModuleCat.ofHom (LinearMap.ker π).subtype) (ModuleCat.ofHom π)
          (by ext x; exact x.2)
      have hT : T.ShortExact := by
        refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
        · rw [ShortComplex.moduleCat_exact_iff]
          intro x hx
          exact ⟨⟨x, hx⟩, rfl⟩
        · exact (ModuleCat.mono_iff_injective _).mpr Subtype.val_injective
        · exact (ModuleCat.epi_iff_surjective _).mpr hπ
      haveI hP2 : Projective T.X₂ :=
        (IsProjective.iff_projective (R := A) (P := Fin r → A)).mp inferInstance
      have h2 : HasProjectiveDimensionLT T.X₂ (m + 1) :=
        hasProjectiveDimensionLT_of_ge _ 1 (m + 1) (by omega)
      have h3 : HasProjectiveDimensionLT T.X₃ (m + 1 + 1) := hM
      exact hT.hasProjectiveDimensionLT_X₁ (m + 1) h2 h3
    have hi := LocalizedModule.map_injective S (LinearMap.ker π).subtype Subtype.val_injective
    have hs := LocalizedModule.map_surjective S π hπ
    have he0 := LocalizedModule.map_exact S _ _ (LinearMap.exact_subtype_ker_map π)
    have h1 : ⇑(LocalizedModule.map S (LinearMap.ker π).subtype) =
        ⇑(IsLocalizedModule.map S (LocalizedModule.mkLinearMap S (LinearMap.ker π))
          (LocalizedModule.mkLinearMap S (Fin r → A)) (LinearMap.ker π).subtype) := by
      funext x
      induction x using LocalizedModule.induction_on with
      | h a s => rw [LocalizedModule.map_mk, IsLocalizedModule.map_LocalizedModules]
    have h2 : ⇑(LocalizedModule.map S π) =
        ⇑(IsLocalizedModule.map S (LocalizedModule.mkLinearMap S (Fin r → A))
          (LocalizedModule.mkLinearMap S M) π) := by
      funext x
      induction x using LocalizedModule.induction_on with
      | h a s => rw [LocalizedModule.map_mk, IsLocalizedModule.map_LocalizedModules]
    have he : Function.Exact (LocalizedModule.map S (LinearMap.ker π).subtype)
        (LocalizedModule.map S π) := by
      rw [h1, h2]
      exact he0
    obtain ⟨efree⟩ := LOCFREE A S (Fin r → A) r ⟨LinearEquiv.refl A _⟩
    have key := SES (Localization S) (LocalizedModule S (LinearMap.ker π))
      (LocalizedModule S (Fin r → A)) (LocalizedModule S M)
      (LocalizedModule.map S (LinearMap.ker π).subtype) (LocalizedModule.map S π) r
      (by exact hi) (by exact he) (by exact hs) hP ⟨efree⟩
    obtain ⟨hKP, hstab⟩ := key
    exact hstab (ih (m + 1) (by omega) (LinearMap.ker π) hK hKP)

theorem wc_rlufd_localized_comap_equiv : ∀ (A : Type u) [CommRing A] (S : Submonoid A) (Q : Ideal (Localization S)), Nonempty (LocalizedModule S ↥(Q.comap (algebraMap A (Localization S))) ≃ₗ[Localization S] ↥Q) :=
by
  intro A _ S Q
  exact ⟨LinearEquiv.extendScalarsOfIsLocalization S (Localization S)
    ((IsLocalizedModule.iso S (Algebra.idealMap (Localization S)
        (Q.comap (algebraMap A (Localization S))))).trans
      ((LinearEquiv.ofEq _ _ (IsLocalization.map_comap S (Localization S) Q)).restrictScalars A))⟩

theorem wc_rlufd_stably_free_ideal_principal : ∀ (B : Type u) [CommRing B] [IsDomain B] (L : Ideal B) (a b : ℕ), Nonempty ((↥L × (Fin a → B)) ≃ₗ[B] (Fin b → B)) → Submodule.IsPrincipal L :=
by
  intro B _ _ L a b ⟨φ₀⟩
  classical
  by_cases hL : L = ⊥
  · subst hL; exact bot_isPrincipal
  obtain ⟨l₀, hl₀, hl₀ne⟩ := (Submodule.ne_bot_iff L).mp hL
  let cons := Fin.consLinearEquiv B (fun _ : Fin (a + 1) => B)
  have hb : b = a + 1 := by
    have hσ : Function.Injective (LinearMap.toSpanSingleton B ↥L ⟨l₀, hl₀⟩) := by
      intro s t hst
      have h := congrArg Subtype.val hst
      simp only [LinearMap.toSpanSingleton_apply, Submodule.coe_smul, smul_eq_mul] at h
      exact mul_right_cancel₀ hl₀ne h
    have h1 : a + 1 ≤ b := by
      let f : (Fin (a + 1) → B) →ₗ[B] (Fin b → B) :=
        φ₀.toLinearMap ∘ₗ (LinearMap.prodMap (LinearMap.toSpanSingleton B ↥L ⟨l₀, hl₀⟩)
          (LinearMap.id : (Fin a → B) →ₗ[B] (Fin a → B))) ∘ₗ cons.symm.toLinearMap
      apply le_of_fin_injective B f
      have hf : (f : (Fin (a + 1) → B) → (Fin b → B)) =
          φ₀ ∘ (Prod.map (LinearMap.toSpanSingleton B ↥L ⟨l₀, hl₀⟩) id) ∘ cons.symm := by
        simp only [f, LinearMap.coe_comp, LinearEquiv.coe_coe, LinearMap.coe_prodMap,
          LinearMap.id_coe]
      rw [hf]
      exact φ₀.injective.comp ((hσ.prodMap Function.injective_id).comp cons.symm.injective)
    have h2 : b ≤ a + 1 := by
      let g : (Fin b → B) →ₗ[B] (Fin (a + 1) → B) :=
        cons.toLinearMap ∘ₗ (LinearMap.prodMap L.subtype
          (LinearMap.id : (Fin a → B) →ₗ[B] (Fin a → B))) ∘ₗ φ₀.symm.toLinearMap
      apply le_of_fin_injective B g
      have hg : (g : (Fin b → B) → (Fin (a + 1) → B)) =
          cons ∘ (Prod.map L.subtype id) ∘ φ₀.symm := by
        simp only [g, LinearMap.coe_comp, LinearEquiv.coe_coe, LinearMap.coe_prodMap,
          LinearMap.id_coe]
      rw [hg]
      exact cons.injective.comp ((L.injective_subtype.prodMap Function.injective_id).comp
        φ₀.symm.injective)
    omega
  subst hb
  let U : (Fin (a + 1) → B) →ₗ[B] (Fin (a + 1) → B) :=
    cons.toLinearMap ∘ₗ (LinearMap.prodMap L.subtype
      (LinearMap.id : (Fin a → B) →ₗ[B] (Fin a → B))) ∘ₗ φ₀.symm.toLinearMap
  have hc : LinearMap.det U ∈ L := by
    rw [← LinearMap.det_toMatrix' U, Matrix.det_succ_row_zero]
    apply Ideal.sum_mem
    intro j _
    apply Ideal.mul_mem_right
    apply Ideal.mul_mem_left
    rw [LinearMap.toMatrix'_apply]
    simp [U, cons]
  have hle : L ≤ Ideal.span {LinearMap.det U} := by
    intro l hl
    let T : (Fin (a + 1) → B) →ₗ[B] (Fin (a + 1) → B) :=
      φ₀.toLinearMap ∘ₗ (LinearMap.prodMap (LinearMap.toSpanSingleton B ↥L ⟨l, hl⟩)
        (LinearMap.id : (Fin a → B) →ₗ[B] (Fin a → B))) ∘ₗ cons.symm.toLinearMap
    have hUT : U ∘ₗ T = Matrix.toLin' (Matrix.diagonal (Fin.cons l (fun _ => (1 : B)))) := by
      apply LinearMap.ext
      intro v
      funext i
      refine Fin.cases ?_ (fun k => ?_) i
      · simp [U, T, cons, Matrix.toLin'_apply, Matrix.mulVec_diagonal, mul_comm]
      · simp [U, T, cons, Matrix.toLin'_apply, Matrix.mulVec_diagonal, Fin.tail]
    have hdet := congrArg LinearMap.det hUT
    rw [LinearMap.det_comp, LinearMap.det_toLin', Matrix.det_diagonal, Fin.prod_univ_succ] at hdet
    simp only [Fin.cons_zero, Fin.cons_succ, Finset.prod_const_one, mul_one] at hdet
    exact Ideal.mem_span_singleton'.mpr ⟨LinearMap.det T, by rw [mul_comm]; exact hdet⟩
  exact ⟨⟨LinearMap.det U, le_antisymm hle ((Ideal.span_singleton_le_iff_mem L).mpr hc)⟩⟩

theorem wc_rlufd_ufm_of_locally_ufm_stably_free : (∀ (B : Type u) [CommRing B] [IsDomain B] (a : B), a ≠ 0 → ∀ Q ∈ (Ideal.span {a}).minimalPrimes, ∀ (𝔫 : Ideal B) [𝔫.IsPrime], UniqueFactorizationMonoid (Localization.AtPrime 𝔫) → (Q.map (algebraMap B (Localization.AtPrime 𝔫))).IsPrincipal) → (∀ (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B] (Q : Ideal B), (∀ (𝔫 : Ideal B) [𝔫.IsMaximal], (Q.map (algebraMap B (Localization.AtPrime 𝔫))).IsPrincipal) → Module.Projective B ↥Q) → (∀ (B : Type u) [CommRing B] [IsDomain B] (L : Ideal B) (a b : ℕ), Nonempty ((↥L × (Fin a → B)) ≃ₗ[B] (Fin b → B)) → Submodule.IsPrincipal L) → ∀ (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B], (∀ (𝔫 : Ideal B) [𝔫.IsMaximal], UniqueFactorizationMonoid (Localization.AtPrime 𝔫)) → (∀ (Q : Ideal B), Module.Projective B ↥Q → ∃ a b : ℕ, Nonempty ((↥Q × (Fin a → B)) ≃ₗ[B] (Fin b → B))) → UniqueFactorizationMonoid B :=
by
  intro MINP LOCPROJ SFP B _ _ _ hloc hSF
  rw [UniqueFactorizationMonoid.iff_exists_prime_mem_of_isPrime]
  intro I hI hIp
  haveI := hIp
  obtain ⟨a, haI, ha0⟩ := (Submodule.ne_bot_iff I).mp hI
  have hspan : Ideal.span {a} ≤ I := (Ideal.span_singleton_le_iff_mem I).mpr haI
  obtain ⟨Q, hQ, hQI⟩ := Ideal.exists_minimalPrimes_le hspan
  have hQp : Q.IsPrime := hQ.1.1
  have haQ : a ∈ Q := hQ.1.2 (Ideal.mem_span_singleton_self a)
  have hprin : ∀ (𝔫 : Ideal B) [𝔫.IsMaximal],
      (Q.map (algebraMap B (Localization.AtPrime 𝔫))).IsPrincipal :=
    fun 𝔫 _ => MINP B a ha0 Q hQ 𝔫 (hloc 𝔫)
  have hproj : Module.Projective B ↥Q := LOCPROJ B Q hprin
  obtain ⟨a₁, b₁, hφ⟩ := hSF Q hproj
  haveI hQP : Submodule.IsPrincipal Q := SFP B Q a₁ b₁ hφ
  have hg : Ideal.span {Submodule.IsPrincipal.generator Q} = Q :=
    Submodule.IsPrincipal.span_singleton_generator Q
  have hg0 : Submodule.IsPrincipal.generator Q ≠ 0 := by
    intro h
    rw [h, Ideal.span_singleton_eq_bot.mpr rfl] at hg
    rw [← hg] at haQ
    exact ha0 ((Submodule.mem_bot B).mp haQ)
  have hgp : Prime (Submodule.IsPrincipal.generator Q) := by
    rw [← hg] at hQp
    exact (Ideal.span_singleton_prime hg0).mp hQp
  exact ⟨_, hQI (Submodule.IsPrincipal.generator_mem Q), hgp⟩

theorem wc_fco_regular_local_ufd : ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A], IsDomain A ∧ UniqueFactorizationMonoid A :=
by
  have QR := wc_rl_quot_regular wc_rl_quot_embdim
  have DOM := wc_rl_isDomain wc_rl_quot_embdim QR
  have DESC := wc_rl_pd_quot_descent wc_rl_min_presentation wc_rl_quotSMulTop_map_injective
    wc_rl_quotSMulTop_projective
  have FPD := wc_rl_finite_pd_of_regular wc_rl_min_presentation wc_rl_quot_embdim QR DOM DESC
  have SF := wc_rlufd_localized_pd_stably_free wc_rlufd_ses_stably_free wc_rlufd_localized_free
  have KAP := wc_rlufd_ufm_of_locally_ufm_stably_free wc_rlufd_minimal_prime_locally_principal
    wc_rlufd_projective_of_locally_principal wc_rlufd_stably_free_ideal_principal
  have key : ∀ (n : ℕ) (A : Type u) [CommRing A] [IsRegularLocalRing A],
      Submodule.spanFinrank (IsLocalRing.maximalIdeal A) = n → UniqueFactorizationMonoid A := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro A _ _ hn
    haveI hdom : IsDomain A := DOM A inferInstance
    by_cases hm : IsLocalRing.maximalIdeal A = ⊥
    · rw [UniqueFactorizationMonoid.iff_exists_prime_mem_of_isPrime]
      intro I hI hIp
      exact absurd (le_bot_iff.mp (hm ▸ IsLocalRing.le_maximalIdeal_of_isPrime I)) hI
    · obtain ⟨x, hxm, hx2⟩ : ∃ x ∈ IsLocalRing.maximalIdeal A,
          x ∉ IsLocalRing.maximalIdeal A ^ 2 := by
        by_contra hcon
        push_neg at hcon
        apply hm
        apply Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (IsLocalRing.maximalIdeal A)
          (IsLocalRing.maximalIdeal A) (IsNoetherian.noetherian _) _
          (IsLocalRing.maximalIdeal_le_jacobson ⊥)
        rw [Ideal.smul_eq_mul, ← pow_two]
        exact fun y hy => hcon y hy
      have hx0 : x ≠ 0 := by
        rintro rfl
        exact hx2 (Submodule.zero_mem _)
      obtain ⟨hreg, -⟩ := QR A inferInstance x hxm hx2
      haveI : IsLocalRing (A ⧸ Ideal.span {x}) := hreg.toIsLocalRing
      haveI : IsDomain (A ⧸ Ideal.span {x}) := DOM _ hreg
      have hxp : Prime x := by
        rw [← Ideal.span_singleton_prime hx0, ← Ideal.Quotient.isDomain_iff_prime]
        infer_instance
      haveI : IsDomain (Localization.Away x) :=
        IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hx0)
      have hloc : ∀ (𝔭 : Ideal A) [𝔭.IsPrime], x ∉ 𝔭 →
          UniqueFactorizationMonoid (Localization.AtPrime 𝔭) := by
        intro 𝔭 _ hx𝔭
        have hne : 𝔭 ≠ IsLocalRing.maximalIdeal A := fun h => hx𝔭 (h ▸ hxm)
        have hr := wc_hnas_pfc_regular_localization A inferInstance 𝔭
        have hlt := wc_rlufd_spanFinrank_lt A inferInstance 𝔭 hne hr
        haveI := hr
        exact ih _ (lt_of_lt_of_eq hlt hn) (Localization.AtPrime 𝔭) rfl
      have hB : ∀ (𝔫 : Ideal (Localization.Away x)) [𝔫.IsMaximal],
          UniqueFactorizationMonoid (Localization.AtPrime 𝔫) :=
        fun 𝔫 _ => wc_rlufd_away_localization_ufm A x hloc 𝔫
      have hSF : ∀ (Q : Ideal (Localization.Away x)), Module.Projective (Localization.Away x) ↥Q →
          ∃ a b : ℕ, Nonempty ((↥Q × (Fin a → Localization.Away x)) ≃ₗ[Localization.Away x]
            (Fin b → Localization.Away x)) := by
        intro Q hQ
        obtain ⟨E⟩ := wc_rlufd_localized_comap_equiv A (Submonoid.powers x) Q
        obtain ⟨n₀, hn₀⟩ := FPD A inferInstance
          ↥(Q.comap (algebraMap A (Localization (Submonoid.powers x))))
        haveI hP : Module.Projective (Localization (Submonoid.powers x))
            (LocalizedModule (Submonoid.powers x)
              ↥(Q.comap (algebraMap A (Localization (Submonoid.powers x))))) :=
          Module.Projective.of_equiv E.symm
        obtain ⟨a, b, ⟨φ⟩⟩ := SF A (Submonoid.powers x) n₀ _ hn₀ hP
        exact ⟨a, b, ⟨(LinearEquiv.prodCongr E.symm (LinearEquiv.refl _ _)).trans φ⟩⟩
      exact wc_rlufd_nagata A x hxp (KAP (Localization.Away x) hB hSF)
  intro A _ _
  exact ⟨DOM A inferInstance, key _ A rfl⟩

theorem wc_fco_stalk_regular : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) [Smooth f] (y : X), (f y).asIdeal.height = 1 → IsRegularLocalRing (X.presheaf.stalk y) :=
by
  have hF : ∀ (K : Type u) [Field K], IsRegularLocalRing K := fun _ _ => inferInstance

  have s9 : ∀ (R S : Type u) [CommRing R] [CommRing S] (e : R ≃+* S) (Q : Ideal R) [Q.IsPrime]
      (Q' : Ideal S) [Q'.IsPrime], Q' = Q.map e →
      Nonempty (Localization.AtPrime Q ≃+* Localization.AtPrime Q') := by
    intro R S _ _ e Q _ Q' _ hQ
    refine ⟨IsLocalization.ringEquivOfRingEquiv (M := Q.primeCompl) (T := Q'.primeCompl)
      (Localization.AtPrime Q) (Localization.AtPrime Q') e ?_⟩
    subst hQ
    ext s
    rw [Submonoid.mem_map]
    constructor
    · rintro ⟨t, ht, hts⟩
      refine Ideal.mem_primeCompl_iff.mpr (fun hmem => ?_)
      rw [Ideal.mem_map_of_equiv] at hmem
      obtain ⟨t', ht', h⟩ := hmem
      have htt : t' = t := e.injective (h.trans hts.symm)
      exact (Ideal.mem_primeCompl_iff.mp ht) (htt ▸ ht')
    · intro hs
      refine ⟨e.symm s, Ideal.mem_primeCompl_iff.mpr (fun h => ?_), ?_⟩
      · apply Ideal.mem_primeCompl_iff.mp hs
        rw [Ideal.mem_map_of_equiv]
        exact ⟨e.symm s, h, by simp⟩
      · show e (e.symm s) = s
        simp

  have s2 : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [IsNoetherianRing A]
      (𝔭 : Ideal A) [𝔭.IsPrime], 𝔭.height = 1 → IsRegularLocalRing (Localization.AtPrime 𝔭) := by
    intro A _ _ _ _ 𝔭 _ h
    haveI : IsNoetherianRing (Localization.AtPrime 𝔭) :=
      IsLocalization.isNoetherianRing 𝔭.primeCompl _ ‹_›
    haveI : IsIntegrallyClosed (Localization.AtPrime 𝔭) :=
      isIntegrallyClosed_of_isLocalization _ 𝔭.primeCompl (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
    have hdim : ringKrullDim (Localization.AtPrime 𝔭) = 1 := by
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height 𝔭, h]
      rfl
    obtain ⟨hnf, hrad⟩ := ringKrullDim_eq_one_iff_of_isLocalRing_isDomain.mp hdim
    haveI : IsDiscreteValuationRing (Localization.AtPrime 𝔭) := by
      have key : IsDiscreteValuationRing (Localization.AtPrime 𝔭) ↔
          (IsIntegrallyClosed (Localization.AtPrime 𝔭) ∧
            ∃! P : Ideal (Localization.AtPrime 𝔭), P ≠ ⊥ ∧ P.IsPrime) :=
        (IsDiscreteValuationRing.TFAE _ hnf).out 1 4
      refine key.mpr ⟨inferInstance, ?_⟩
      refine ⟨IsLocalRing.maximalIdeal _, ⟨?_, inferInstance⟩, ?_⟩
      · intro hm
        exact hnf (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm)
      · rintro P ⟨hP, hPp⟩
        obtain ⟨x, hxP, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hP
        apply le_antisymm (IsLocalRing.le_maximalIdeal hPp.ne_top)
        calc IsLocalRing.maximalIdeal _ ≤ (Ideal.span {x}).radical := hrad x hx0
          _ ≤ P := (Ideal.IsPrime.radical_le_iff hPp).mpr
              (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hxP))
    infer_instance

  have s3 : (∀ (C₀ : Type u) [CommRing C₀] [IsLocalRing C₀] [IsNoetherianRing C₀],
      IsRegularLocalRing C₀ → ∀ (𝔮 : Ideal (Polynomial C₀)) [𝔮.IsPrime],
      𝔮.comap Polynomial.C = IsLocalRing.maximalIdeal C₀ →
      IsRegularLocalRing (Localization.AtPrime 𝔮)) →
      ∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (p : Ideal C) [p.IsPrime],
      IsRegularLocalRing (Localization.AtPrime p) → ∀ (Q : Ideal (Polynomial C)) [Q.IsPrime],
      Q.comap Polynomial.C = p → IsRegularLocalRing (Localization.AtPrime Q) := by
    intro H C _ _ p _ hreg Q _ hQ
    letI : Algebra (Polynomial C) (Polynomial (Localization.AtPrime p)) :=
      (Polynomial.mapRingHom (algebraMap C (Localization.AtPrime p))).toAlgebra
    haveI hML : IsLocalization (Submonoid.map Polynomial.C p.primeCompl)
        (Polynomial (Localization.AtPrime p)) :=
      Polynomial.isLocalization p.primeCompl (Localization.AtPrime p)
    have hdisj : Disjoint ((Submonoid.map Polynomial.C p.primeCompl : Submonoid (Polynomial C)) :
        Set (Polynomial C)) (Q : Set (Polynomial C)) := by
      refine Set.disjoint_left.mpr ?_
      rintro _ ⟨s, hs, rfl⟩ hsQ
      apply hs
      rw [← hQ]
      exact hsQ
    haveI h𝔮 : (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.map Polynomial.C p.primeCompl) _ Q ‹_›
        hdisj
    have h𝔮Q : (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).comap
        (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))) = Q :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.map Polynomial.C p.primeCompl) _ ‹_›
        hdisj
    haveI : IsNoetherianRing (Localization.AtPrime p) :=
      IsLocalization.isNoetherianRing p.primeCompl _ ‹_›
    have hc : (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).comap
        Polynomial.C = IsLocalRing.maximalIdeal (Localization.AtPrime p) := by
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (Ideal.comap_isPrime Polynomial.C _).ne_top
      · rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
        intro c hc
        rw [Ideal.mem_comap, Ideal.mem_comap]
        have : Polynomial.C (algebraMap C (Localization.AtPrime p) c) =
            algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)) (Polynomial.C c) := by
          show _ = Polynomial.map (algebraMap C (Localization.AtPrime p)) (Polynomial.C c)
          rw [Polynomial.map_C]
        rw [this]
        apply Ideal.mem_map_of_mem
        rw [← hQ] at hc
        exact hc
    haveI hR𝔮 := H (Localization.AtPrime p) hreg _ hc
    have hgen : ∀ (P : Ideal (Polynomial C)) [P.IsPrime],
        P = (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))).comap
          (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))) →
        IsLocalization.AtPrime (Localization.AtPrime
          (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))))) P := by
      intro P _ hP
      subst hP
      exact IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
        (Submonoid.map Polynomial.C p.primeCompl) _ _
    haveI := hgen Q h𝔮Q.symm
    let E : Localization.AtPrime
        (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p))))
        ≃+* Localization.AtPrime Q := (IsLocalization.algEquiv Q.primeCompl
      (Localization.AtPrime (Q.map (algebraMap (Polynomial C) (Polynomial (Localization.AtPrime p)))))
      (Localization.AtPrime Q)).toRingEquiv
    exact @IsRegularLocalRing.of_ringEquiv _ _ hR𝔮 _ _ E

  have s4 : (∀ (C : Type u) [CommRing C] [IsNoetherianRing C] (p : Ideal C) [p.IsPrime],
      IsRegularLocalRing (Localization.AtPrime p) → ∀ (Q : Ideal (Polynomial C)) [Q.IsPrime],
      Q.comap Polynomial.C = p → IsRegularLocalRing (Localization.AtPrime Q)) →
      (∀ (R S : Type u) [CommRing R] [CommRing S] (e : R ≃+* S) (Q : Ideal R) [Q.IsPrime]
        (Q' : Ideal S) [Q'.IsPrime], Q' = Q.map e →
        Nonempty (Localization.AtPrime Q ≃+* Localization.AtPrime Q')) →
      ∀ (n : ℕ) (C : Type u) [CommRing C] [IsNoetherianRing C] (p : Ideal C) [p.IsPrime],
      IsRegularLocalRing (Localization.AtPrime p) →
      ∀ (Q : Ideal (MvPolynomial (Fin n) C)) [Q.IsPrime],
      Q.comap (MvPolynomial.C : C →+* MvPolynomial (Fin n) C) = p →
      IsRegularLocalRing (Localization.AtPrime Q) := by
    intro H1 H2 n
    induction n with
    | zero =>
      intro C _ _ p _ hreg Q _ hQ
      have hsymm : ∀ c : C, (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).toRingEquiv.symm c =
          MvPolynomial.C c := by
        intro c
        have h := (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).symm.commutes c
        rw [Algebra.algebraMap_self, RingHom.id_apply, MvPolynomial.algebraMap_eq] at h
        exact h
      have hmap : Q.map (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).toRingEquiv = p := by
        rw [← hQ]
        ext c
        rw [Ideal.mem_map_of_equiv, Ideal.mem_comap]
        constructor
        · rintro ⟨z, hz, rfl⟩
          rw [← hsymm, RingEquiv.symm_apply_apply]
          exact hz
        · intro hc
          exact ⟨MvPolynomial.C c, hc, by rw [← hsymm, RingEquiv.apply_symm_apply]⟩
      obtain ⟨Φ⟩ := H2 _ _ (MvPolynomial.isEmptyAlgEquiv C (Fin 0)).toRingEquiv Q p hmap.symm
      haveI := hreg
      exact IsRegularLocalRing.of_ringEquiv Φ.symm
    | succ n ih =>
      intro C _ _ p _ hreg Q _ hQ
      haveI hQ' : (Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv).IsPrime :=
        Ideal.map_isPrime_of_equiv _
      haveI : ((Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv).comap Polynomial.C).IsPrime :=
        Ideal.comap_isPrime _ _
      have hEC : ∀ c : C, (MvPolynomial.finSuccEquiv C n).toRingEquiv (MvPolynomial.C c) =
          Polynomial.C (MvPolynomial.C c) := by
        intro c
        show MvPolynomial.finSuccEquiv C n (MvPolynomial.C c) = _
        rw [MvPolynomial.finSuccEquiv_apply, MvPolynomial.eval₂Hom_C]
        rfl
      have hmemE : ∀ z, (MvPolynomial.finSuccEquiv C n).toRingEquiv z ∈
          Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv ↔ z ∈ Q := by
        intro z
        rw [Ideal.mem_map_of_equiv]
        constructor
        · rintro ⟨w, hw, h⟩
          rw [(MvPolynomial.finSuccEquiv C n).toRingEquiv.injective h] at hw
          exact hw
        · intro hz
          exact ⟨z, hz, rfl⟩
      have hQ₀ : ((Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv).comap Polynomial.C).comap
          (MvPolynomial.C : C →+* MvPolynomial (Fin n) C) = p := by
        rw [← hQ]
        ext c
        rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, ← hEC, hmemE]
      have h0 := ih C p hreg _ hQ₀
      haveI := H1 (MvPolynomial (Fin n) C) _ h0
        (Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv) rfl
      obtain ⟨Φ⟩ := H2 _ _ (MvPolynomial.finSuccEquiv C n).toRingEquiv Q
        (Q.map (MvPolynomial.finSuccEquiv C n).toRingEquiv) rfl
      exact IsRegularLocalRing.of_ringEquiv Φ.symm

  have s5 : (∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u)
      [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra A B] [IsLocalHom (algebraMap A B)]
      [Module.Flat A B], IsRegularLocalRing A →
      IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)) →
      IsRegularLocalRing B) →
      ∀ (P : Type u) [CommRing P] [IsNoetherianRing P] (T : Type u) [CommRing T] [Algebra P T]
      [Algebra.Etale P T] (q : Ideal T) [q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime (q.comap (algebraMap P T))) →
      IsRegularLocalRing (Localization.AtPrime q) := by
    intro R1 P _ _ T _ _ _ q _ hreg
    haveI : IsNoetherianRing T := Algebra.FiniteType.isNoetherianRing P T
    haveI : IsNoetherianRing (Localization.AtPrime (q.comap (algebraMap P T))) :=
      IsLocalization.isNoetherianRing (q.comap (algebraMap P T)).primeCompl _ ‹_›
    haveI : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl _ ‹_›
    letI : Algebra (Localization.AtPrime (q.comap (algebraMap P T))) (Localization.AtPrime q) :=
      (Localization.localRingHom (q.comap (algebraMap P T)) q (algebraMap P T) rfl).toAlgebra
    haveI : IsLocalHom (algebraMap (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q)) :=
      Localization.isLocalHom_localRingHom (q.comap (algebraMap P T)) q _ rfl
    haveI : Module.Flat (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := by
      rw [← RingHom.flat_algebraMap_iff]
      exact RingHom.Flat.localRingHom (RingHom.flat_algebraMap_iff.mpr inferInstance) q _ rfl
    haveI : IsScalarTower P (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := IsScalarTower.of_algebraMap_eq (fun x => by
      rw [RingHom.algebraMap_toAlgebra, Localization.localRingHom_to_map,
        IsScalarTower.algebraMap_apply P T (Localization.AtPrime q)])
    haveI : Algebra.FormallyUnramified P (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.comp P T _
    haveI : Algebra.FormallyUnramified (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := Algebra.FormallyUnramified.of_restrictScalars P _ _
    haveI : Algebra.EssFiniteType P (Localization.AtPrime q) := Algebra.EssFiniteType.comp P T _
    haveI : Algebra.EssFiniteType (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q) := Algebra.EssFiniteType.of_comp P _ _
    have hm : Ideal.map (algebraMap (Localization.AtPrime (q.comap (algebraMap P T)))
        (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime (q.comap (algebraMap P T))))
        = IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.map_maximalIdeal
    have hres : IsRegularLocalRing (IsLocalRing.ResidueField (Localization.AtPrime q)) :=
      @hF _ (IsLocalRing.ResidueField.field _)
    let E : IsLocalRing.ResidueField (Localization.AtPrime q) ≃+* (Localization.AtPrime q ⧸
        Ideal.map (algebraMap (Localization.AtPrime (q.comap (algebraMap P T)))
          (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime (q.comap (algebraMap P T))))) :=
      Ideal.quotEquivOfEq hm.symm
    have hfib : IsRegularLocalRing (Localization.AtPrime q ⧸ Ideal.map
        (algebraMap (Localization.AtPrime (q.comap (algebraMap P T))) (Localization.AtPrime q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime (q.comap (algebraMap P T))))) :=
      IsRegularLocalRing.of_ringEquiv E
    exact R1 _ _ hreg hfib

  have s1 : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [Smooth f]
      (x : X), ∃ (n : ℕ) (T : Type u) (_ : CommRing T) (_ : Algebra (MvPolynomial (Fin n) A) T)
      (q : Ideal T) (_ : q.IsPrime), Algebra.Etale (MvPolynomial (Fin n) A) T ∧
      Nonempty (X.presheaf.stalk x ≃+* Localization.AtPrime q) ∧
      (q.comap (algebraMap (MvPolynomial (Fin n) A) T)).comap
        (MvPolynomial.C : A →+* MvPolynomial (Fin n) A) = (f x).asIdeal := by
    intro A _ X f _ x
    classical
    obtain ⟨V, hV, hxV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
    have e : V ≤ f ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have hsm := (smooth_iff f).mp ‹_› (isAffineOpen_top (Spec (.of A))) hV e
    let e' : A ≃+* Γ(Spec (.of A), ⊤) :=
      Iso.commRingCatIsoToRingEquiv (Scheme.ΓSpecIso (CommRingCat.of A)).symm
    have he' : (e'.toRingHom).Smooth := RingHom.Smooth.of_bijective e'.bijective
    let φ : A →+* Γ(X, V) := (Scheme.Hom.appLE f ⊤ V e).hom.comp e'.toRingHom
    have hφ : φ.Smooth := RingHom.Smooth.comp he' hsm
    letI : Algebra A Γ(X, V) := φ.toAlgebra
    haveI : Algebra.Smooth A Γ(X, V) := RingHom.Smooth.toAlgebra hφ
    obtain ⟨s, hs, hstd⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth A Γ(X, V)
    let p := (hV.primeIdealOf ⟨x, hxV⟩).asIdeal
    haveI hp : p.IsPrime := (hV.primeIdealOf ⟨x, hxV⟩).isPrime
    obtain ⟨b, hbs, hbp⟩ : ∃ b ∈ s, b ∉ p := by
      by_contra h
      push_neg at h
      have h1 : Ideal.span s ≤ p := Ideal.span_le.mpr h
      rw [hs] at h1
      exact hp.ne_top (top_le_iff.mp h1)
    have hC : Algebra.IsStandardSmooth A (Localization.Away b) := hstd b hbs
    obtain ⟨n, g, hgC, hg⟩ := RingHom.IsStandardSmooth.exists_etale_mvPolynomial
      (RingHom.isStandardSmooth_algebraMap.mpr hC)
    letI : Algebra (MvPolynomial (Fin n) A) (Localization.Away b) := g.toAlgebra
    have hEt : Algebra.Etale (MvPolynomial (Fin n) A) (Localization.Away b) :=
      RingHom.Etale.toAlgebra hg
    have hdisj : Disjoint ((Submonoid.powers b : Submonoid Γ(X, V)) : Set Γ(X, V))
        (p : Set Γ(X, V)) := by
      refine Set.disjoint_left.mpr ?_
      rintro y ⟨k, rfl⟩ hy
      exact hbp (hp.mem_of_pow_mem k hy)
    let q := p.map (algebraMap Γ(X, V) (Localization.Away b))
    haveI hq : q.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers b) (Localization.Away b) p hp
        hdisj
    have hcomap : Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q = p :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers b) (Localization.Away b) hp
        hdisj
    letI : Algebra Γ(X, V) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxV⟩ : V)
    have hgen : ∀ (P : Ideal Γ(X, V)) [P.IsPrime], P = p →
        IsLocalization.AtPrime (X.presheaf.stalk x) P := by
      intro P _ hP
      subst hP
      exact hV.isLocalization_stalk ⟨x, hxV⟩
    haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x)
        (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q) := hgen _ hcomap
    let Φ₁ := IsLocalization.algEquiv
      (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q).primeCompl
      (X.presheaf.stalk x)
      (Localization.AtPrime (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q))
    let Φ₂ := IsLocalization.localizationLocalizationAtPrimeIsoLocalization
      (Submonoid.powers b) q
    refine ⟨n, Localization.Away b, inferInstance, inferInstance, q, hq, hEt,
      ⟨Φ₁.toRingEquiv.trans Φ₂.toRingEquiv⟩, ?_⟩
    have hcomp : (algebraMap (MvPolynomial (Fin n) A) (Localization.Away b)).comp MvPolynomial.C =
        (algebraMap Γ(X, V) (Localization.Away b)).comp φ :=
      hgC.trans (IsScalarTower.algebraMap_eq A Γ(X, V) (Localization.Away b))
    rw [Ideal.comap_comap, hcomp, ← Ideal.comap_comap, hcomap]
    have key := IsAffineOpen.SpecMap_appLE_fromSpec f (isAffineOpen_top (Spec (.of A))) hV e
    rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp] at key
    obtain ⟨pt, hpt⟩ : ∃ pt : Spec Γ(X, V), pt = hV.primeIdealOf ⟨x, hxV⟩ := ⟨_, rfl⟩
    have hx' : hV.fromSpec pt = x := by
      rw [hpt]; exact hV.fromSpec_primeIdealOf ⟨x, hxV⟩
    have h1 : f x = Spec.map ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
        Scheme.Hom.appLE f ⊤ V e) pt := by
      rw [← hx', ← Scheme.Hom.comp_apply, ← key]
    rw [h1, hpt]
    first
      | rfl
      | (rw [Spec.map_apply, PrimeSpectrum.comap_asIdeal]; rfl)

  intro A₀ _ _ _ _ X f _ y hy
  have R1 := wc_hnas_pfc_regular_flat_ascent
  have H1 := s3 (wc_pfc_pc_poly_localization_regular R1)
  have Hmv := s4 H1 s9
  obtain ⟨n, T, _, _, q, _, hEt, ⟨Φ⟩, hq⟩ := s1 A₀ X f y
  haveI := hEt
  haveI : (f y).asIdeal.IsPrime := (f y).isPrime
  have h𝔭 := s2 A₀ (f y).asIdeal hy
  have hQ := Hmv n A₀ (f y).asIdeal h𝔭 (q.comap (algebraMap (MvPolynomial (Fin n) A₀) T)) hq
  have hT := s5 R1 (MvPolynomial (Fin n) A₀) T q hQ
  exact @IsRegularLocalRing.of_ringEquiv _ _ hT _ _ Φ.symm

theorem wc_fco_etale_nbhd_of_stalk : ∀ (X N : Scheme.{u}) [IsLocallyNoetherian X] (ν : N ⟶ X), IsFinite ν → ∀ x : X, Etale (Limits.pullback.snd ν (X.fromSpecStalk x)) → ∃ W : X.Opens, x ∈ W ∧ Etale (ν ∣_ W) :=
by

  have wc_fnteg_spread_etale : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (φ : R →+* R'), φ.Finite → φ.FinitePresentation → ∀ (M : Submonoid R), (IsLocalization.map (Localization (M.map φ)) φ M.le_comap_map : Localization M →+* Localization (M.map φ)).Etale → ∀ (𝔭 : Ideal R) [𝔭.IsPrime], Disjoint (M : Set R) (𝔭 : Set R) → ∃ r : R, r ∉ 𝔭 ∧ ((algebraMap R' (Localization.Away (φ r))).comp φ).Etale := by
    intro R R' _ _ φ hf hp M hM 𝔭 _ hdisj
    classical
    letI : Algebra R R' := φ.toAlgebra
    haveI : Module.Finite R R' := hf
    haveI : Algebra.FinitePresentation R R' := hp
    have hloc : ∀ (𝔮 : Ideal R') [𝔮.IsPrime], (∀ m ∈ M, φ m ∉ 𝔮) → Algebra.IsEtaleAt R 𝔮 := by
      intro 𝔮 _ hq
      let N : Submonoid R' := M.map φ
      let S := Localization N
      let T := Localization.AtPrime 𝔮
      let φM : Localization M →+* S := IsLocalization.map S φ M.le_comap_map
      letI : Algebra (Localization M) S := φM.toAlgebra
      haveI : Algebra.Etale (Localization M) S := hM
      haveI : Algebra.FormallyEtale R (Localization M) := Algebra.FormallyEtale.of_isLocalization M
      haveI : IsScalarTower R (Localization M) S := by
        apply IsScalarTower.of_algebraMap_eq'
        rw [IsScalarTower.algebraMap_eq R R' S]
        exact (IsLocalization.map_comp M.le_comap_map).symm
      haveI : Algebra.FormallyEtale R S := Algebra.FormallyEtale.comp R (Localization M) S
      have hN : N ≤ 𝔮.primeCompl := by
        rintro _ ⟨m, hm, rfl⟩
        exact hq m hm
      letI : Algebra S T := IsLocalization.localizationAlgebraOfSubmonoidLe S T N 𝔮.primeCompl hN
      haveI : IsScalarTower R' S T :=
        IsLocalization.localization_isScalarTower_of_submonoid_le S T N 𝔮.primeCompl hN
      haveI : IsLocalization (Submonoid.map (algebraMap R' S) 𝔮.primeCompl) T :=
        IsLocalization.isLocalization_of_submonoid_le S T N 𝔮.primeCompl hN
      haveI : Algebra.FormallyEtale S T :=
        Algebra.FormallyEtale.of_isLocalization (Submonoid.map (algebraMap R' S) 𝔮.primeCompl)
      haveI : IsScalarTower R S T := by
        apply IsScalarTower.of_algebraMap_eq'
        rw [IsScalarTower.algebraMap_eq R R' T, IsScalarTower.algebraMap_eq R' S T,
          IsScalarTower.algebraMap_eq R R' S, RingHom.comp_assoc]
      exact Algebra.FormallyEtale.comp R S T
    have hfib : ∀ 𝔮 : PrimeSpectrum R', Ideal.comap φ 𝔮.asIdeal = 𝔭 →
        𝔮 ∈ Algebra.etaleLocus R R' := by
      intro 𝔮 h𝔮
      rw [Algebra.mem_etaleLocus_iff]
      apply hloc
      intro m hm hm'
      have h1 : m ∈ 𝔭 := by rw [← h𝔮]; exact hm'
      exact Set.disjoint_left.mp hdisj hm h1
    have hZ : IsClosed (Algebra.etaleLocus R R')ᶜ := Algebra.isOpen_etaleLocus.isClosed_compl
    have hint : φ.IsIntegral := RingHom.IsIntegral.of_finite hf
    have hC : IsClosed (PrimeSpectrum.comap φ '' (Algebra.etaleLocus R R')ᶜ) :=
      PrimeSpectrum.isClosedMap_comap_of_isIntegral φ hint _ hZ
    have hpt : (⟨𝔭, inferInstance⟩ : PrimeSpectrum R) ∈
        (PrimeSpectrum.comap φ '' (Algebra.etaleLocus R R')ᶜ)ᶜ := by
      rintro ⟨𝔮, h𝔮Z, h𝔮⟩
      apply h𝔮Z
      apply hfib
      have h1 := congrArg PrimeSpectrum.asIdeal h𝔮
      rw [PrimeSpectrum.comap_asIdeal] at h1
      exact h1
    obtain ⟨v, ⟨r, rfl⟩, hpv, hvC⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hpt hC.isOpen_compl
    have hr : r ∉ 𝔭 := hpv
    have hsub : (PrimeSpectrum.basicOpen (algebraMap R R' r) : Set (PrimeSpectrum R')) ⊆
        Algebra.etaleLocus R R' := by
      intro 𝔮 h𝔮
      by_contra hne
      have hmem : PrimeSpectrum.comap φ 𝔮 ∈ (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum R)) := by
        show r ∉ (PrimeSpectrum.comap φ 𝔮).asIdeal
        rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
        exact h𝔮
      exact hvC hmem ⟨𝔮, hne, rfl⟩
    haveI hE : Algebra.Etale R (Localization.Away (algebraMap R R' r)) :=
      Algebra.basicOpen_subset_etaleLocus_iff_etale.mp hsub
    refine ⟨r, hr, ?_⟩
    have h2 := RingHom.etale_algebraMap.mpr hE
    rw [IsScalarTower.algebraMap_eq R R' (Localization.Away (algebraMap R R' r))] at h2
    exact h2

  have s4 : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (r : R),
      ((algebraMap S (Localization.Away (φ r))).comp φ).Etale →
      (Localization.awayMap φ r).Etale := by
    intro R S _ _ φ r h
    have hcomp : (Localization.awayMap φ r).comp (algebraMap R (Localization.Away r)) =
        (algebraMap S (Localization.Away (φ r))).comp φ := IsLocalization.map_comp _
    have hfpψ : ((algebraMap S (Localization.Away (φ r))).comp φ).FinitePresentation := by
      letI : Algebra R (Localization.Away (φ r)) :=
        ((algebraMap S (Localization.Away (φ r))).comp φ).toAlgebra
      haveI : Algebra.Etale R (Localization.Away (φ r)) := h
      exact Algebra.Etale.finitePresentation
    have hA : (algebraMap R (Localization.Away r)).FiniteType :=
      RingHom.FiniteType.of_finitePresentation
        (RingHom.finitePresentation_algebraMap.mpr (IsLocalization.Away.finitePresentation r))
    have hfp : (Localization.awayMap φ r).FinitePresentation :=
      RingHom.FinitePresentation.of_comp_finiteType (algebraMap R (Localization.Away r))
        (hcomp ▸ hfpψ) hA
    letI : Algebra R (Localization.Away (φ r)) :=
      ((algebraMap S (Localization.Away (φ r))).comp φ).toAlgebra
    letI : Algebra (Localization.Away r) (Localization.Away (φ r)) :=
      (Localization.awayMap φ r).toAlgebra
    haveI : IsScalarTower R (Localization.Away r) (Localization.Away (φ r)) :=
      IsScalarTower.of_algebraMap_eq' hcomp.symm
    haveI : Algebra.Etale R (Localization.Away (φ r)) := h
    haveI : Algebra.FormallyEtale R (Localization.Away r) :=
      Algebra.FormallyEtale.of_isLocalization (Submonoid.powers r)
    haveI : Algebra.FormallyEtale (Localization.Away r) (Localization.Away (φ r)) :=
      Algebra.FormallyEtale.of_restrictScalars (R := R)
    haveI : Algebra.FinitePresentation (Localization.Away r) (Localization.Away (φ r)) := hfp
    show Algebra.Etale (Localization.Away r) (Localization.Away (φ r))
    exact Algebra.Etale.mk

  have s3 : ∀ (X N : Scheme.{u}) (ν : N ⟶ X) [IsAffineHom ν] (U : X.Opens), IsAffineOpen U →
      ∀ r : Γ(X, U), (Localization.awayMap (ν.app U).hom r).Etale → Etale (ν ∣_ X.basicOpen r) := by
    intro X N ν _ U hU r h
    have hV := hU.preimage ν
    have hW : IsAffineOpen (X.basicOpen r) := hU.basicOpen r
    have hW' : IsAffineOpen (ν ⁻¹ᵁ X.basicOpen r) := by
      rw [Scheme.preimage_basicOpen]; exact hV.basicOpen _
    haveI : IsAffine (X.basicOpen r) := hW
    haveI : IsAffine (ν ⁻¹ᵁ X.basicOpen r) := hW'
    have e₂ : ν ⁻¹ᵁ X.basicOpen r = N.basicOpen ((ν.appLE U (ν ⁻¹ᵁ U) le_rfl).hom r) := by
      rw [Scheme.preimage_basicOpen, Scheme.Hom.appLE_eq_app]
    have h' : RingHom.Etale (ν.app (X.basicOpen r)).hom := by
      rw [Scheme.Hom.app_eq_appLE]
      rw [Scheme.Hom.appLE_congr ν _ rfl e₂ (fun f => RingHom.Etale f.hom),
        IsAffineOpen.appLE_eq_away_map ν hU hV le_rfl r, CommRingCat.hom_ofHom]
      haveI := hU.isLocalization_basicOpen r
      haveI := hV.isLocalization_basicOpen ((ν.appLE U (ν ⁻¹ᵁ U) le_rfl).hom r)
      rw [Scheme.Hom.app_eq_appLE] at h
      exact (RingHom.Etale.respectsIso.isLocalization_away_iff _ _ _ r).mp h
    have h'' : RingHom.Etale (ν.app ((X.basicOpen r).ι ''ᵁ ⊤)).hom := by
      rw [Scheme.Opens.ι_image_top]; exact h'
    rw [HasRingHomProperty.iff_of_isAffine (P := @Etale), morphismRestrict_appTop]
    exact (RingHom.RespectsIso.cancel_right_isIso RingHom.Etale.respectsIso _ _).mpr h''

  have s2 : ∀ (X N : Scheme.{u}) (ν : N ⟶ X) [IsAffineHom ν] (U : X.Opens) (hU : IsAffineOpen U)
      (x : X) (hx : x ∈ U), Etale (Limits.pullback.snd ν (X.fromSpecStalk x)) →
      (IsLocalization.map (Localization ((hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl.map
        (ν.app U).hom)) (ν.app U).hom (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl.le_comap_map :
        Localization (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl →+*
          Localization ((hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl.map (ν.app U).hom)).Etale := by
    intro X N ν _ U hU x hx h
    letI : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hx).hom.toAlgebra
    haveI : IsLocalization (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl (X.presheaf.stalk x) :=
      hU.isLocalization_stalk ⟨x, hx⟩
    let fₘ : X.presheaf.stalk x →+*
        Localization ((hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl.map (ν.app U).hom) :=
      IsLocalization.map _ (ν.app U).hom (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl.le_comap_map
    have hb : fₘ.comp (algebraMap Γ(X, U) (X.presheaf.stalk x)) =
        (algebraMap Γ(N, ν ⁻¹ᵁ U) _).comp (ν.app U).hom := IsLocalization.map_comp _
    have hA := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_of_isLocalization (ν.app U).hom fₘ hb
        (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl)
    have hV := hU.preimage ν
    have hB : IsPullback (Spec.map (ν.appLE U (ν ⁻¹ᵁ U) le_rfl)) hV.fromSpec hU.fromSpec ν :=
      IsOpenImmersion.isPullback _ _ _ _ (IsAffineOpen.SpecMap_appLE_fromSpec ν hU hV le_rfl).symm
        (by rw [IsAffineOpen.opensRange_fromSpec, IsAffineOpen.opensRange_fromSpec])
    rw [Scheme.Hom.appLE_eq_app] at hB
    have hP := IsPullback.paste_horiz hA hB.flip
    have hbot : Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) (X.presheaf.stalk x))) ≫
        hU.fromSpec = X.fromSpecStalk x := by
      rw [← hU.fromSpecStalk_eq_fromSpecStalk hx, IsAffineOpen.fromSpecStalk.eq_1]
      rfl
    rw [hbot] at hP
    have h1 : Etale (hP.isoPullback.hom ≫ Limits.pullback.snd ν (X.fromSpecStalk x)) :=
      inferInstance
    rw [hP.isoPullback_hom_snd] at h1
    have h2 : fₘ.Etale := HasRingHomProperty.Spec_iff (P := @Etale).mp h1
    let ε := IsLocalization.algEquiv (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
      (Localization (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl) (X.presheaf.stalk x)
    have hg : (IsLocalization.map (Localization ((hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl.map
        (ν.app U).hom)) (ν.app U).hom (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl.le_comap_map :
        Localization (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl →+*
          Localization ((hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl.map (ν.app U).hom)) =
        fₘ.comp ε.toRingEquiv.toRingHom := by
      apply IsLocalization.ringHom_ext (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
      ext a
      simp only [RingHom.comp_apply, IsLocalization.map_eq, RingEquiv.toRingHom_eq_coe,
        RingEquiv.coe_toRingHom, AlgEquiv.coe_ringEquiv, AlgEquiv.commutes, fₘ]
    rw [hg]
    exact RingHom.Etale.respectsIso.2 _ _ h2

  intro X N _ ν hν x h
  haveI := hν
  obtain ⟨U, hU, hx, -⟩ := exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
  haveI : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  have hfin := IsFinite.finite_app ν U hU
  have hfp : (ν.app U).hom.FinitePresentation :=
    RingHom.FinitePresentation.of_finiteType.mp (RingHom.FiniteType.of_finite hfin)
  have het := s2 X N ν U hU x hx h
  obtain ⟨r, hr𝔭, hr⟩ := wc_fnteg_spread_etale (ν.app U).hom hfin hfp _ het
    (hU.primeIdealOf ⟨x, hx⟩).asIdeal (Set.disjoint_left.mpr fun a ha h𝔭 => ha h𝔭)
  refine ⟨X.basicOpen r, ?_, s3 X N ν U hU r (s4 _ r hr)⟩
  rw [Scheme.mem_basicOpen X r x hx]
  letI : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hx).hom.toAlgebra
  haveI : IsLocalization.AtPrime (X.presheaf.stalk x) (hU.primeIdealOf ⟨x, hx⟩).asIdeal :=
    hU.isLocalization_stalk ⟨x, hx⟩
  exact (IsLocalization.AtPrime.isUnit_to_map_iff _ _ r).mpr hr𝔭

theorem wc_fntame_smooth_stalk_normal : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [IsNoetherianRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [Smooth f] (x : X), IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x) :=
by
  have halg : ∀ (R T : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing T]
      [Algebra R T] [Algebra.Etale R T] (q : Ideal T) [q.IsPrime],
      IsDomain (Localization.AtPrime q) ∧ IsIntegrallyClosed (Localization.AtPrime q) := by
    intro R T _ _ _ _ _ _ q _
    classical
    have s2 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] [Algebra.Etale K A] (y : A),
        ∃ ε γ : A, IsIdempotentElem ε ∧ y * γ = ε ∧ (1 - ε) * y = 0 := by
      intro K A _ _ _ _ y
      obtain ⟨I, _, Ai, hF, hA, e, -⟩ := (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
      let ε' : (i : I) → Ai i := fun i => if e y i = 0 then 0 else 1
      let γ' : (i : I) → Ai i := fun i => (e y i)⁻¹
      have hε' : IsIdempotentElem ε' := by
        show ε' * ε' = ε'
        funext i
        simp only [Pi.mul_apply, ε']
        split_ifs <;> simp
      refine ⟨e.symm ε', e.symm γ', hε'.map e.symm, ?_, ?_⟩
      · apply e.injective
        rw [map_mul, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
        funext i
        simp only [Pi.mul_apply, ε', γ']
        split_ifs with h
        · rw [h, zero_mul]
        · exact mul_inv_cancel₀ h
      · apply e.injective
        rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
        funext i
        simp only [Pi.mul_apply, Pi.sub_apply, Pi.one_apply, Pi.zero_apply, ε']
        split_ifs with h
        · rw [h, mul_zero]
        · simp
    let K := FractionRing R
    let S := TensorProduct R T K
    let j : T →ₐ[R] S := Algebra.TensorProduct.includeLeft
    have hj : ∀ t : T, j t = TensorProduct.tmul R t (1 : K) := fun t => rfl
    have hjinj : Function.Injective j :=
      Algebra.TensorProduct.includeLeft_injective (R := R) (S := R) (A := T) (B := K)
        (IsFractionRing.injective R K)
    have hQ : ∀ y : S, ∃ ε γ : S, IsIdempotentElem ε ∧ y * γ = ε ∧ (1 - ε) * y = 0 := by
      intro y
      let c : S ≃ₐ[R] TensorProduct R K T := Algebra.TensorProduct.comm R T K
      obtain ⟨ε', γ', hε', h1, h2⟩ := s2 K (TensorProduct R K T) (c y)
      refine ⟨c.symm ε', c.symm γ', hε'.map c.symm, ?_, ?_⟩
      · apply c.injective
        rw [map_mul, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
        exact h1
      · apply c.injective
        rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
        exact h2
    have hlift : ∀ z : S, IsIntegral T z → ∃ t : T, j t = z := by
      intro z hint
      obtain ⟨w, hw⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := R) (S := T)
        (B := K)).2 ⟨z, (mem_integralClosure_iff T S).mpr hint⟩
      have hw' := congrArg Subtype.val hw
      simp only at hw'
      have key : ∀ w' : TensorProduct R T (integralClosure R K),
          ∃ t : T, ((TensorProduct.toIntegralClosure R T K w' : integralClosure T S) : S) = j t := by
        intro w'
        induction w' using TensorProduct.induction_on with
        | zero => exact ⟨0, by rw [map_zero, map_zero]; rfl⟩
        | tmul t c =>
          have hc : (c : K) ∈ (⊥ : Subalgebra R K) := by
            rw [← IsIntegrallyClosed.integralClosure_eq_bot R K]; exact c.2
          obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hc
          refine ⟨r • t, ?_⟩
          rw [hj]
          change TensorProduct.tmul R t (c : K) = _
          rw [TensorProduct.smul_tmul, ← hr, Algebra.algebraMap_eq_smul_one]
        | add x y hx hy =>
          obtain ⟨t₁, h₁⟩ := hx
          obtain ⟨t₂, h₂⟩ := hy
          exact ⟨t₁ + t₂, by rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]⟩
      obtain ⟨t, ht⟩ := key w
      exact ⟨t, ht.symm.trans hw'⟩
    have hliftI : ∀ ε : S, IsIdempotentElem ε → ∃ e : T, j e = ε := by
      intro ε hε
      apply hlift
      refine ⟨Polynomial.X ^ 2 - Polynomial.X,
        Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num)), ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, pow_two, hε.eq,
        sub_self]
    have hsep : ∀ a b : S, a * b = 0 →
        ∃ ε : S, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
      intro a b hab
      obtain ⟨ε, γ, hε, h1, h2⟩ := hQ a
      refine ⟨ε, hε, ?_, h2⟩
      rw [← h1, mul_comm a γ, mul_assoc, hab, mul_zero]
    have hnzd : NoZeroDivisors (Localization.AtPrime q) := by
      refine ⟨fun {x y} hxy => ?_⟩
      obtain ⟨⟨s, u⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
      obtain ⟨⟨s', u'⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
      dsimp only at hxy ⊢
      rw [← IsLocalization.mk'_mul] at hxy
      obtain ⟨m, hm⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp hxy
      obtain ⟨ε, hε, h1, h2⟩ := hsep (j ((m : T) * s)) (j s')
        (by rw [← map_mul, mul_assoc, hm, map_zero])
      obtain ⟨e, rfl⟩ := hliftI ε hε
      have he1 : e * s' = 0 := hjinj (by rw [map_mul, h1, map_zero])
      have he2 : (1 - e) * ((m : T) * s) = 0 :=
        hjinj (by rw [map_mul, map_sub, map_one, h2, map_zero])
      have he3 : e * e = e := hjinj (by rw [map_mul]; exact hε.eq)
      set π := algebraMap T (Localization.AtPrime q) with hπ
      have hē : π e * π e = π e := by rw [← map_mul, he3]
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (π e) with hu | hu
      · right
        have h1' : π e = 1 := hu.mul_left_cancel (by rw [hē, mul_one])
        have hs' : π s' = 0 := by
          have := congrArg π he1
          rwa [map_mul, h1', one_mul, map_zero] at this
        rw [IsLocalization.mk'_eq_mul_mk'_one, hs', zero_mul]
      · left
        have h0 : π e = 0 := (hu.mul_right_eq_zero).mp (by rw [sub_mul, one_mul, hē, sub_self])
        have hs : π s = 0 := by
          have := congrArg π he2
          rw [map_mul, map_sub, map_one, h0, sub_zero, one_mul, map_mul, map_zero] at this
          exact ((IsLocalization.map_units (Localization.AtPrime q) m).mul_right_eq_zero).mp this
        rw [IsLocalization.mk'_eq_mul_mk'_one, hs, zero_mul]
    haveI hdom : IsDomain (Localization.AtPrime q) := NoZeroDivisors.to_isDomain _
    refine ⟨hdom, ?_⟩
    let L := Localization.AtPrime q
    let F := FractionRing L
    have hmk : ∀ (a : T) (s : q.primeCompl),
        algebraMap L F (IsLocalization.mk' L a s) * algebraMap T F s = algebraMap T F a := by
      intro a s
      rw [IsScalarTower.algebraMap_apply T L F (s : T), IsScalarTower.algebraMap_apply T L F a,
        ← map_mul, IsLocalization.mk'_spec]
    have hπne : ∀ s : T, s ∈ q.primeCompl → algebraMap T F s ≠ 0 := by
      intro s hs h
      rw [IsScalarTower.algebraMap_apply T L F] at h
      have h' := (IsFractionRing.injective L F) (h.trans (map_zero _).symm)
      exact (IsLocalization.map_units L (⟨s, hs⟩ : q.primeCompl)).ne_zero h'
    have hRne : ∀ r : R, r ≠ 0 → algebraMap R F r ≠ 0 := by
      intro r hr h
      rw [IsScalarTower.algebraMap_apply R T F, IsScalarTower.algebraMap_apply T L F] at h
      have h' : algebraMap T L (algebraMap R T r) = 0 :=
        (IsFractionRing.injective L F) (h.trans (map_zero _).symm)
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl L _).mp h'
      have hu : IsUnit (j (algebraMap R T r)) := by
        rw [AlgHom.commutes]
        have e1 : algebraMap R S r = Algebra.TensorProduct.includeRight (algebraMap R K r) :=
          (AlgHom.commutes _ r).symm
        rw [e1]
        exact (IsUnit.mk0 _ ((map_ne_zero_iff _ (IsFractionRing.injective R K)).mpr hr)).map _
      have hjm : j (m : T) = 0 := by
        have := congrArg j hm
        rw [map_mul, map_zero] at this
        exact (hu.mul_left_eq_zero).mp this
      have hm0 : (m : T) = 0 := hjinj (hjm.trans (map_zero j).symm)
      exact m.2 (by rw [hm0]; exact q.zero_mem)
    let ι : R →ₐ[R] F := Algebra.ofId R F
    have hι : Function.Injective ι :=
      (injective_iff_map_eq_zero ι).mpr (fun r hr => by
        by_contra h
        exact hRne r h hr)
    let κ : K →ₐ[R] F := IsFractionRing.liftAlgHom (R := R) (A := R) (K := K) (L := F) hι
    let ρ : S →ₐ[R] F := Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R T F) κ
    have hρj : ∀ t : T, ρ (j t) = algebraMap T F t := by
      intro t
      rw [hj]
      show Algebra.TensorProduct.productMap (IsScalarTower.toAlgHom R T F) κ (t ⊗ₜ[R] (1 : K)) = _
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
      rfl
    have hinv : ∀ g : S, ρ g ≠ 0 → ∃ g' : S, ρ g * ρ g' = 1 := by
      intro g hg
      obtain ⟨ε, γ, -, h1, h2⟩ := hQ g
      refine ⟨γ, ?_⟩
      rw [← map_mul, h1]
      have h3 := congrArg ρ h2
      rw [map_mul, map_sub, map_one, map_zero] at h3
      have h4 := (mul_eq_zero.mp h3).resolve_right hg
      exact (sub_eq_zero.mp h4).symm
    have hrangeL : ∀ l : L, ∃ g : S, ρ g = algebraMap L F l := by
      intro l
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl l
      dsimp only
      obtain ⟨g', hg'⟩ := hinv (j s) (by rw [hρj]; exact hπne s s.2)
      rw [hρj] at hg'
      refine ⟨j a * g', ?_⟩
      rw [map_mul, hρj, ← hmk a s, mul_assoc, hg', mul_one]
    have hrange : ∀ y : F, ∃ g : S, ρ g = y := by
      intro y
      obtain ⟨a', b', hb', rfl⟩ := IsFractionRing.div_surjective L y
      obtain ⟨ga, hga⟩ := hrangeL a'
      obtain ⟨gb, hgb⟩ := hrangeL b'
      have hb0 : algebraMap L F b' ≠ 0 :=
        (map_ne_zero_iff _ (IsFractionRing.injective L F)).mpr (nonZeroDivisors.ne_zero hb')
      obtain ⟨g', hg'⟩ := hinv gb (by rw [hgb]; exact hb0)
      refine ⟨ga * g', ?_⟩
      rw [map_mul, hga, div_eq_mul_inv, ← hgb, inv_eq_of_mul_eq_one_right hg']
    refine (isIntegrallyClosed_iff F).mpr ?_
    intro x hx
    obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization q.primeCompl x hx
    have hmx : m • x = algebraMap T F m * x := by rw [Submonoid.smul_def, Algebra.smul_def]
    rw [hmx] at hm
    obtain ⟨Q, hQm, hQx⟩ := hm
    obtain ⟨z, hz⟩ := hrange (algebraMap T F m * x)
    obtain ⟨v, hv⟩ : ∃ v : S, v = Q.eval₂ (algebraMap T S) z := ⟨_, rfl⟩
    have hρalg : ((ρ : S →+* F).comp (algebraMap T S)) = algebraMap T F :=
      RingHom.ext (fun t => hρj t)
    have hρv : ρ v = 0 := by
      have h0 : (ρ : S →+* F) v = 0 := by
        rw [hv, Polynomial.hom_eval₂, hρalg]
        change Polynomial.eval₂ (algebraMap T F) (ρ z) Q = 0
        rw [hz]
        exact hQx
      exact h0
    obtain ⟨δ, γ', hδ, h1, h2⟩ := hQ v
    have hρδ : ρ δ = 0 := by rw [← h1, map_mul, hρv, zero_mul]
    obtain ⟨z', hz'⟩ : ∃ z' : S, z' = (1 - δ) * z := ⟨_, rfl⟩
    obtain ⟨c, hc⟩ := Polynomial.sub_dvd_eval_sub z' z (Q.map (algebraMap T S))
    rw [Polynomial.eval_map, Polynomial.eval_map, ← hv] at hc
    have hz'int : IsIntegral T z' := by
      refine ⟨Polynomial.X * Q, Polynomial.monic_X.mul hQm, ?_⟩
      rw [Polynomial.eval₂_X_mul]
      have e1 : Q.eval₂ (algebraMap T S) z' = v + (z' - z) * c := by rw [← hc]; ring
      rw [e1, hz']
      linear_combination z * h2 + z ^ 2 * c * hδ.eq
    obtain ⟨t, ht⟩ := hlift z' hz'int
    have hρz' : ρ z' = algebraMap T F m * x := by
      rw [hz', map_mul, map_sub, map_one, hρδ, sub_zero, one_mul, hz]
    have hπt : algebraMap T F t = algebraMap T F m * x := by
      rw [← hρj t, ht, hρz']
    refine ⟨IsLocalization.mk' L t m, ?_⟩
    apply mul_right_cancel₀ (hπne m m.2)
    rw [hmk, hπt, mul_comm]
  have hgeo : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [Smooth f]
      (x : X), ∃ (n : ℕ) (T : Type u) (_ : CommRing T) (_ : Algebra (MvPolynomial (Fin n) A) T)
      (q : Ideal T) (_ : q.IsPrime), Algebra.Etale (MvPolynomial (Fin n) A) T ∧
      Nonempty (X.presheaf.stalk x ≃+* Localization.AtPrime q) := by
    intro A _ X f _ x
    classical
    obtain ⟨V, hV, hxV, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
    have e : V ≤ f ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have hsm := (smooth_iff f).mp ‹_› (isAffineOpen_top (Spec (.of A))) hV e
    let e' : A ≃+* Γ(Spec (.of A), ⊤) :=
      Iso.commRingCatIsoToRingEquiv (Scheme.ΓSpecIso (CommRingCat.of A)).symm
    have he' : (e'.toRingHom).Smooth := RingHom.Smooth.of_bijective e'.bijective
    let φ : A →+* Γ(X, V) := (Scheme.Hom.appLE f ⊤ V e).hom.comp e'.toRingHom
    have hφ : φ.Smooth := RingHom.Smooth.comp he' hsm
    letI : Algebra A Γ(X, V) := φ.toAlgebra
    haveI : Algebra.Smooth A Γ(X, V) := RingHom.Smooth.toAlgebra hφ
    obtain ⟨s, hs, hstd⟩ := Algebra.Smooth.exists_span_eq_top_isStandardSmooth A Γ(X, V)
    let p := (hV.primeIdealOf ⟨x, hxV⟩).asIdeal
    haveI hp : p.IsPrime := (hV.primeIdealOf ⟨x, hxV⟩).isPrime
    obtain ⟨b, hbs, hbp⟩ : ∃ b ∈ s, b ∉ p := by
      by_contra h
      push_neg at h
      have h1 : Ideal.span s ≤ p := Ideal.span_le.mpr h
      rw [hs] at h1
      exact hp.ne_top (top_le_iff.mp h1)
    have hC : Algebra.IsStandardSmooth A (Localization.Away b) := hstd b hbs
    obtain ⟨n, g, -, hg⟩ := RingHom.IsStandardSmooth.exists_etale_mvPolynomial
      (RingHom.isStandardSmooth_algebraMap.mpr hC)
    letI : Algebra (MvPolynomial (Fin n) A) (Localization.Away b) := g.toAlgebra
    have hEt : Algebra.Etale (MvPolynomial (Fin n) A) (Localization.Away b) :=
      RingHom.Etale.toAlgebra hg
    have hdisj : Disjoint ((Submonoid.powers b : Submonoid Γ(X, V)) : Set Γ(X, V))
        (p : Set Γ(X, V)) := by
      refine Set.disjoint_left.mpr ?_
      rintro y ⟨k, rfl⟩ hy
      exact hbp (hp.mem_of_pow_mem k hy)
    let q := p.map (algebraMap Γ(X, V) (Localization.Away b))
    haveI hq : q.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers b) (Localization.Away b) p hp hdisj
    have hcomap : Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q = p :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers b) (Localization.Away b) hp hdisj
    letI : Algebra Γ(X, V) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxV⟩ : V)
    have hgen : ∀ (P : Ideal Γ(X, V)) [P.IsPrime], P = p →
        IsLocalization.AtPrime (X.presheaf.stalk x) P := by
      intro P _ hP
      subst hP
      exact hV.isLocalization_stalk ⟨x, hxV⟩
    haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x)
        (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q) := hgen _ hcomap
    let Φ₁ := IsLocalization.algEquiv
      (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q).primeCompl
      (X.presheaf.stalk x)
      (Localization.AtPrime (Ideal.comap (algebraMap Γ(X, V) (Localization.Away b)) q))
    let Φ₂ := IsLocalization.localizationLocalizationAtPrimeIsoLocalization
      (Submonoid.powers b) q
    exact ⟨n, Localization.Away b, inferInstance, inferInstance, q, hq, hEt,
      ⟨Φ₁.toRingEquiv.trans Φ₂.toRingEquiv⟩⟩
  have hpoly : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (n : ℕ),
      IsIntegrallyClosed (MvPolynomial (Fin n) A) := by
    intro A _ _ _ n
    induction n with
    | zero =>
      exact IsIntegrallyClosed.of_equiv (MvPolynomial.isEmptyAlgEquiv A (Fin 0)).symm.toRingEquiv
    | succ n ih =>
      haveI := ih
      exact IsIntegrallyClosed.of_equiv (MvPolynomial.finSuccEquiv A n).symm.toRingEquiv
  intro A _ _ _ _ X f _ x
  obtain ⟨n, T, _, _, q, _, hEt, ⟨Φ⟩⟩ := hgeo A X f x
  haveI := hEt
  haveI := hpoly A n
  obtain ⟨hD, hI⟩ := halg (MvPolynomial (Fin n) A) T q
  exact ⟨MulEquiv.isDomain _ Φ.toMulEquiv, IsIntegrallyClosed.of_equiv Φ.symm⟩

theorem wc_fco_fibre_common_generization : ∀ (A₀ : Type u) [CommRing A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) [Smooth f], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ y y' : X, f y = f y' → ∃ ξ : X, f ξ = f y ∧ ξ ⤳ y ∧ ξ ⤳ y' :=
by

  have s1 : ∀ (T : Type u) [TopologicalSpace T] [T0Space T] [PreconnectedSpace T],
      (∀ x : T, ∃ g : T, g ⤳ x ∧ ∀ w : T, w ⤳ x → g ⤳ w) →
      (∀ x : T, ∃ V : Set T, IsOpen V ∧ x ∈ V ∧
        {η : T | η ∈ V ∧ ∀ w : T, w ⤳ η → η ⤳ w}.Finite) →
      ∀ x y : T, ∃ ξ : T, ξ ⤳ x ∧ ξ ⤳ y := by
    intro T _ _ _ h1 h2 x y
    choose g hg₁ hg₂ using h1
    have hA : ∀ x w, w ⤳ g x → g x ⤳ w := fun x w hw => hg₂ x w (hw.trans (hg₁ x))
    have hB : ∀ x w, w ⤳ x → g w = g x := by
      intro x w hw
      have e1 : g x ⤳ g w := hg₂ x (g w) ((hg₁ w).trans hw)
      have e2 : g w ⤳ g x := hg₂ w (g x) (e1.trans (hg₁ w))
      exact (e2.antisymm e1).eq
    have hB' : ∀ η, (∀ w, w ⤳ η → η ⤳ w) → g η = η := by
      intro η hη
      exact ((hg₁ η).antisymm (hη _ (hg₁ η))).eq
    have hC : IsLocallyConstant g := by
      rw [IsLocallyConstant.iff_exists_open]
      intro x
      obtain ⟨V, hV, hxV, hM⟩ := h2 x
      let M' := {η : T | (η ∈ V ∧ ∀ w : T, w ⤳ η → η ⤳ w) ∧ η ≠ g x}
      have hM' : M'.Finite := hM.subset (fun η h => h.1)
      refine ⟨V \ ⋃ η ∈ M', closure {η},
        hV.sdiff (hM'.isClosed_biUnion (fun _ _ => isClosed_closure)), ⟨hxV, ?_⟩, ?_⟩
      · simp only [Set.mem_iUnion, not_exists]
        intro η hη hx
        have hηx : η ⤳ x := specializes_iff_mem_closure.mpr hx
        exact hη.2 ((hB' η hη.1.2).symm.trans (hB x η hηx))
      · rintro w ⟨hwV, hwU⟩
        by_contra hne
        apply hwU
        simp only [Set.mem_iUnion]
        exact ⟨g w, ⟨⟨(hg₁ w).mem_open hV hwV, hA w⟩, hne⟩,
          specializes_iff_mem_closure.mp (hg₁ w)⟩
    refine ⟨g x, hg₁ x, ?_⟩
    rw [hC.apply_eq_of_preconnectedSpace x y]
    exact hg₁ y

  have s2 : ∀ (Y : Scheme.{u}) (y : Y), IsDomain (Y.presheaf.stalk y) →
      ∃ g : Y, g ⤳ y ∧ ∀ w : Y, w ⤳ y → g ⤳ w := by
    intro Y y hd
    let q : PrimeSpectrum (Y.presheaf.stalk y) := ⟨⊥, Ideal.isPrime_bot⟩
    have hq : ∀ P : PrimeSpectrum (Y.presheaf.stalk y), q ⤳ P := fun P =>
      (PrimeSpectrum.le_iff_specializes q P).mp bot_le
    refine ⟨Y.fromSpecStalk y q, ?_, ?_⟩
    · have := (hq (IsLocalRing.closedPoint _)).map (Y.fromSpecStalk y).continuous
      rwa [Scheme.fromSpecStalk_closedPoint] at this
    · intro w hw
      have hw' : w ∈ Set.range (Y.fromSpecStalk y) := by
        rw [Scheme.range_fromSpecStalk]; exact hw
      obtain ⟨P, rfl⟩ := hw'
      exact (hq P).map (Y.fromSpecStalk y).continuous

  have s3 : ∀ (Y : Scheme.{u}) [IsLocallyNoetherian Y] (y : Y), ∃ V : Set Y, IsOpen V ∧ y ∈ V ∧
      {η : Y | η ∈ V ∧ ∀ w : Y, w ⤳ η → η ⤳ w}.Finite := by
    intro Y _ y
    obtain ⟨W, hW, hyW, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := y) trivial
    haveI : IsNoetherianRing Γ(Y, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
    refine ⟨W, W.isOpen, hyW, ?_⟩
    have hemb : Topology.IsOpenEmbedding hW.fromSpec := hW.fromSpec.isOpenEmbedding
    have hMin : {P : PrimeSpectrum Γ(Y, W) | P.asIdeal ∈ minimalPrimes Γ(Y, W)}.Finite :=
      (minimalPrimes.finite_of_isNoetherianRing _).preimage
        (fun a _ b _ h => PrimeSpectrum.ext h)
    refine (hMin.image hW.fromSpec).subset ?_
    rintro η ⟨hηW, hη⟩
    have hηW' : η ∈ Set.range hW.fromSpec := by rw [hW.range_fromSpec]; exact hηW
    obtain ⟨P, rfl⟩ := hηW'
    refine ⟨P, ?_, rfl⟩
    show P.asIdeal ∈ minimalPrimes _
    refine ⟨⟨P.isPrime, bot_le⟩, fun Q hQ hQP => ?_⟩
    have h1 : (⟨Q, hQ.1⟩ : PrimeSpectrum Γ(Y, W)) ⤳ P :=
      (PrimeSpectrum.le_iff_specializes _ _).mp hQP
    have h2 := hη _ (h1.map hW.fromSpec.continuous)
    exact (PrimeSpectrum.le_iff_specializes P ⟨Q, hQ.1⟩).mpr
      (hemb.isInducing.specializes_iff.mp h2)

  intro A₀ _ X f _ hconn y y' hyy'
  obtain ⟨Ω, _, _, z, hz⟩ : ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω)
      (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ∀ p, z p = f y := by
    let k := (Spec (.of A₀)).residueField (f y)
    refine ⟨AlgebraicClosure k, inferInstance, inferInstance,
      Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) ≫
        (Spec (.of A₀)).fromSpecResidueField (f y), fun p => ?_⟩
    simp only [Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply _ _
  haveI : ConnectedSpace ↥(Limits.pullback f z) := hconn _ z
  have hdom : ∀ t : ↥(Limits.pullback f z), IsDomain ((Limits.pullback f z).presheaf.stalk t) :=
    fun t => (wc_fntame_smooth_stalk_normal Ω _ (Limits.pullback.snd f z) t).1
  haveI : IsLocallyNoetherian (Limits.pullback f z) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd f z)
  have hy : y ∈ Set.range (Limits.pullback.fst f z) := by
    rw [Scheme.Pullback.range_fst]; exact ⟨IsLocalRing.closedPoint _, hz _⟩
  have hy' : y' ∈ Set.range (Limits.pullback.fst f z) := by
    rw [Scheme.Pullback.range_fst]; exact ⟨IsLocalRing.closedPoint _, (hz _).trans hyy'⟩
  obtain ⟨t, ht⟩ := hy
  obtain ⟨t', ht'⟩ := hy'
  obtain ⟨ζ, hζ, hζ'⟩ := s1 ↥(Limits.pullback f z) (fun t => s2 _ t (hdom t)) (s3 _) t t'
  refine ⟨Limits.pullback.fst f z ζ, ?_, ?_, ?_⟩
  · rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply, hz]
  · have := hζ.map (Limits.pullback.fst f z).continuous
    exact ht ▸ this
  · have := hζ'.map (Limits.pullback.fst f z).continuous
    exact ht' ▸ this

theorem wc_fsa_stalk_torsor_ring : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) (ℓ : ℕ) [NeZero ℓ] (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∀ (y : X) (ϖ₀ : A₀), IsDomain (X.presheaf.stalk y) → (Spec.preimage (X.fromSpecStalk y ≫ f)).hom ϖ₀ ≠ 0 → (∀ a : A₀, a ≠ 0 → ∃ (n : ℕ) (v : (X.presheaf.stalk y)ˣ), (Spec.preimage (X.fromSpecStalk y ≫ f)).hom a = v * (Spec.preimage (X.fromSpecStalk y ≫ f)).hom ϖ₀ ^ n) → ∃ (S C : Type u) (_ : CommRing S) (_ : CommRing C) (_ : Algebra (X.presheaf.stalk y) S) (_ : IsLocalization.Away ((Spec.preimage (X.fromSpecStalk y ≫ f)).hom ϖ₀) S) (_ : Algebra S C) (_ : Algebra (X.presheaf.stalk y) C) (_ : IsScalarTower (X.presheaf.stalk y) S C) (σC : ZMod ℓ → (C →ₐ[S] C)) (e : Limits.pullback (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk y) ≅ Spec (.of C)), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk y) C)) = Limits.pullback.snd _ _ ∧ σC 0 = AlgHom.id S C ∧ (∀ c c', σC (c + c') = (σC c).comp (σC c')) ∧ Algebra.Etale S C ∧ Module.Finite S C ∧ Function.Surjective (PrimeSpectrum.comap (algebraMap S C)) ∧ Function.Bijective (wcTorDescMu S C ℓ σC) :=
by
  intro A₀ _ _ X f ℓ _ P p α hP y ϖ₀ _ hπ0 hfact
  classical
  set φ := (Spec.preimage (X.fromSpecStalk y ≫ f)).hom with hφ
  have hϖ0 : ϖ₀ ≠ 0 := by
    rintro rfl
    exact hπ0 (map_zero _)

  let S := Localization.Away (φ ϖ₀)
  haveI hSloc : IsLocalization (Submonoid.map φ (nonZeroDivisors A₀)) S := by
    refine IsLocalization.of_le_of_exists_dvd (Submonoid.powers (φ ϖ₀)) _ ?_ ?_
    · rintro x ⟨n, rfl⟩
      exact Submonoid.mem_map.mpr
        ⟨ϖ₀ ^ n, mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hϖ0), map_pow _ _ _⟩
    · intro x hx
      obtain ⟨a, ha, rfl⟩ := Submonoid.mem_map.mp hx
      obtain ⟨n, v, hv⟩ := hfact a (nonZeroDivisors.ne_zero ha)
      refine ⟨φ ϖ₀ ^ n, ⟨n, rfl⟩, ((v⁻¹ : (X.presheaf.stalk y)ˣ) : X.presheaf.stalk y), ?_⟩
      rw [hv, mul_right_comm, Units.mul_inv, one_mul]

  let φF : FractionRing A₀ →+* S :=
    IsLocalization.map S φ (Submonoid.le_comap_map (nonZeroDivisors A₀))
  have hpo := CommRingCat.isPushout_of_isLocalization φ φF
    (IsLocalization.map_comp (Submonoid.le_comap_map (nonZeroDivisors A₀))) (nonZeroDivisors A₀)
  have hpb0 := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
  have hkf : Spec.map (CommRingCat.ofHom φ) = X.fromSpecStalk y ≫ f := by
    rw [hφ, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hw : (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk y) S)) ≫ X.fromSpecStalk y) ≫ f =
      Spec.map (CommRingCat.ofHom φF) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) := by
    rw [Category.assoc, ← hkf]
    exact hpb0.w
  let j := Limits.pullback.lift _ _ hw
  have hjf : j ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) =
      Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk y) S)) ≫ X.fromSpecStalk y :=
    Limits.pullback.lift_fst _ _ _
  have hjs : j ≫ Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) =
      Spec.map (CommRingCat.ofHom φF) :=
    Limits.pullback.lift_snd _ _ _
  have hbig : IsPullback
      (j ≫ Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))
      (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk y) S)))
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) (X.fromSpecStalk y ≫ f) := by
    rw [hjs, ← hkf]
    exact hpb0.flip
  have hj : IsPullback j (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk y) S)))
      (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))
      (X.fromSpecStalk y) :=
    IsPullback.of_right hbig hjf
      (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))).flip

  obtain ⟨α', hP'⟩ := wc_fet_torsor_base_change p j ℓ α hP
  obtain ⟨C, _, _, σC, ψ, hψ, h0, hadd, het, hfin, hsurj, hbij⟩ :=
    wc_fet_torsor_affine_ring_data S (Limits.pullback p j) (Limits.pullback.snd p j) ℓ α' hP'
  have hpb := (IsPullback.of_hasPullback p j).paste_vert hj
  letI : Algebra (X.presheaf.stalk y) C :=
    ((algebraMap S C).comp (algebraMap (X.presheaf.stalk y) S)).toAlgebra
  haveI : IsScalarTower (X.presheaf.stalk y) S C := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hOC : Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk y) C)) =
      Spec.map (CommRingCat.ofHom (algebraMap S C)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk y) S)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    try rfl
  refine ⟨S, C, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, σC, hpb.isoPullback.symm ≪≫ ψ, ?_, h0, hadd, het, hfin, hsurj,
    hbij⟩
  rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, hOC, ← Category.assoc ψ.hom, hψ]
  exact hpb.isoPullback_inv_snd

theorem wc_fsa_ufd_kummer_generator : ∀ (L : Type u) [Field L] (ℓ : ℕ), ℓ.Prime → ∀ (ζ : L), IsPrimitiveRoot ζ ℓ → ∀ (S C : Type u) [CommRing S] [IsDomain S] [UniqueFactorizationMonoid S] [CommRing C] [Algebra L S] [Algebra S C] [Algebra L C] [IsScalarTower L S C] (σC : ZMod ℓ → (C →ₐ[S] C)), σC 0 = AlgHom.id S C → (∀ c c', σC (c + c') = (σC c).comp (σC c')) → Algebra.Etale S C → Module.Finite S C → Function.Surjective (PrimeSpectrum.comap (algebraMap S C)) → Function.Bijective (wcTorDescMu S C ℓ σC) → ∃ (t : C) (a : Sˣ), σC 1 t = algebraMap L C ζ * t ∧ t ^ ℓ = algebraMap S C a :=
by
  classical
  intro L _ ℓ hℓ ζ hζ S C _ _ _ _ _ _ _ _ σC hσ0 hσadd hCet hCfin hCsurj hCbij

  have t_dual : ∀ (I : Ideal S) [Module.Projective S I] [Module.Finite S I],
      ∃ (n : ℕ) (x : Fin n → S) (φ : Fin n → (I →ₗ[S] S)), (∀ j, x j ∈ I) ∧
        ∀ z : I, (z : S) = ∑ j, φ j z * x j := by
    intro I _ _
    obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' S I
    obtain ⟨h, hh⟩ := Module.projective_lifting_property f LinearMap.id hf
    refine ⟨n, fun j => (f (fun k => if j = k then 1 else 0) : S),
      fun j => (LinearMap.proj j).comp h, fun j => (f _).2, ?_⟩
    intro z
    have hz : f (h z) = z := by rw [← LinearMap.comp_apply, hh]; rfl
    conv_lhs => rw [← hz, LinearMap.pi_apply_eq_sum_univ f (h z)]
    simp

  have t_principal : ∀ (I : Ideal S) (n : ℕ) (x : Fin n → S) (φ : Fin n → (I →ₗ[S] S)),
      (∀ j, x j ∈ I) → (∀ z : I, (z : S) = ∑ j, φ j z * x j) → ∃ b ∈ I, I = Ideal.span {b} := by
    intro I n x φ hx hφ
    letI := UniqueFactorizationMonoid.strongNormalizationMonoid (α := S)
    letI := UniqueFactorizationMonoid.toStrongNormalizedGCDMonoid S
    by_cases h0 : ∃ X₀ : I, (X₀ : S) ≠ 0
    swap
    · push_neg at h0
      refine ⟨0, I.zero_mem, ?_⟩
      ext z
      rw [Ideal.mem_span_singleton, zero_dvd_iff]
      exact ⟨fun hz => h0 ⟨z, hz⟩, fun hz => hz ▸ I.zero_mem⟩
    obtain ⟨X₀, hX₀⟩ := h0
    have hA : ∀ (z w : I) j, (w : S) * φ j z = (z : S) * φ j w := by
      intro z w j
      have e1 : (w : S) • z = (z : S) • w := Subtype.ext (by simp [mul_comm])
      have e2 := congrArg (φ j) e1
      simpa [map_smul, smul_eq_mul] using e2
    let f : Option (Fin n) → S := fun k => Option.elim k (X₀ : S) (fun j => φ j X₀)
    obtain ⟨g, hg, hg1⟩ := Finset.extract_gcd f (Finset.univ_nonempty (α := Option (Fin n)))
    have hD : Finset.univ.gcd f ≠ 0 := by
      intro hD
      rw [Finset.gcd_eq_zero_iff] at hD
      exact hX₀ (hD none (Finset.mem_univ _))
    have hb : (X₀ : S) = Finset.univ.gcd f * g none := hg none (Finset.mem_univ _)
    have hc : ∀ j, φ j X₀ = Finset.univ.gcd f * g (some j) :=
      fun j => hg (some j) (Finset.mem_univ _)
    have hbI : g none = ∑ j, g (some j) * x j := by
      apply mul_left_cancel₀ hD
      rw [← hb, Finset.mul_sum, hφ X₀]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hc j, mul_assoc]
    have hbmem : g none ∈ I := by
      rw [hbI]
      exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (hx j))
    refine ⟨g none, hbmem, ?_⟩
    apply le_antisymm
    · intro z hz
      rw [Ideal.mem_span_singleton]
      have hdiv : ∀ k ∈ (Finset.univ : Finset (Option (Fin n))), g none ∣ z * g k := by
        intro k _
        cases k with
        | none => exact Dvd.intro_left _ rfl
        | some j =>
          have h1 := hA ⟨z, hz⟩ X₀ j
          have h2 : z * g (some j) = g none * φ j ⟨z, hz⟩ := by
            apply mul_left_cancel₀ hD
            calc Finset.univ.gcd f * (z * g (some j))
                = z * (Finset.univ.gcd f * g (some j)) := by ring
              _ = z * φ j X₀ := by rw [hc j]
              _ = (X₀ : S) * φ j ⟨z, hz⟩ := h1.symm
              _ = Finset.univ.gcd f * (g none * φ j ⟨z, hz⟩) := by rw [hb]; ring
          rw [h2]
          exact Dvd.intro _ rfl
      have h3 := Finset.dvd_gcd hdiv
      rw [Finset.gcd_mul_left, hg1, mul_one] at h3
      exact h3.trans (normalize_associated z).dvd
    · rw [Ideal.span_singleton_le_iff_mem]
      exact hbmem

  let M : Submodule S C :=
    { carrier := {b | σC 1 b = algebraMap L C ζ * b}
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_setOf_eq] at *
        rw [map_add, ha, hb, mul_add]
      zero_mem' := by simp
      smul_mem' := by
        intro s b hb
        simp only [Set.mem_setOf_eq] at *
        rw [map_smul, hb, mul_smul_comm] }
  have hM : ∀ b : C, b ∈ M ↔ σC 1 b = algebraMap L C ζ * b := fun b => Iff.rfl
  obtain ⟨hinv, μ, hμ⟩ := wc_kummer_eigen_line L ℓ hℓ ζ hζ S C σC hσ0 hσadd hCet hCfin hCsurj
    hCbij M hM

  obtain ⟨I, ⟨e⟩⟩ := Module.Invertible.exists_linearEquiv_ideal S M
  haveI : Module.Invertible S I := Module.Invertible.congr e
  obtain ⟨n, x, φ, hx, hφ⟩ := t_dual I
  obtain ⟨b, hbI, hIb⟩ := t_principal I n x φ hx hφ
  obtain ⟨t₀, ht₀⟩ : ∃ t₀ : M, t₀ = e.symm ⟨b, hbI⟩ := ⟨_, rfl⟩
  have hgen : ∀ m : M, ∃ c : S, m = c • t₀ := by
    intro m
    have hm : ((e m : I) : S) ∈ Ideal.span {b} := hIb ▸ (e m).2
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hm
    refine ⟨c, ?_⟩
    apply e.injective
    rw [ht₀, map_smul, LinearEquiv.apply_symm_apply]
    apply Subtype.ext
    rw [← hc]
    rfl

  obtain ⟨T₀, hT₀⟩ : ∃ T : TensorPower S ℓ M, T = PiTensorProduct.tprod S (fun _ : Fin ℓ => t₀) :=
    ⟨_, rfl⟩
  have hspan : ∀ y : TensorPower S ℓ M, ∃ c : S, y = c • T₀ := by
    intro y
    have hle : Submodule.span S (Set.range (PiTensorProduct.tprod S (s := fun _ : Fin ℓ => M)))
        ≤ Submodule.span S {T₀} := by
      rw [Submodule.span_le]
      rintro _ ⟨v, rfl⟩
      choose c hc using fun i => hgen (v i)
      have hv : v = fun i => c i • t₀ := funext hc
      rw [hv, MultilinearMap.map_smul_univ, ← hT₀]
      exact Submodule.smul_mem _ _ (Submodule.subset_span rfl)
    rw [PiTensorProduct.span_tprod_eq_top] at hle
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hle Submodule.mem_top (x := y))
    exact ⟨c, hc.symm⟩
  obtain ⟨c, hc⟩ := hspan (μ.symm 1)
  have h1 : μ T₀ * c = 1 := by
    have h2 := congrArg μ hc
    rw [LinearEquiv.apply_symm_apply, map_smul, smul_eq_mul] at h2
    rw [mul_comm]
    exact h2.symm
  have hu : IsUnit (μ T₀) := IsUnit.of_mul_eq_one c h1
  refine ⟨(t₀ : C), hu.unit, (hM _).mp t₀.2, ?_⟩
  rw [IsUnit.unit_spec, hT₀, hμ]
  simp [Finset.prod_const]

theorem wc_fsa_kummer_span : ∀ (L : Type u) [Field L] (ℓ : ℕ), ℓ.Prime → ∀ (ζ : L), IsPrimitiveRoot ζ ℓ → ∀ (S C : Type u) [CommRing S] [CommRing C] [Algebra S C] [Algebra L C] (σC : ZMod ℓ → (C →ₐ[S] C)), σC 0 = AlgHom.id S C → (∀ c c', σC (c + c') = (σC c).comp (σC c')) → Algebra.Etale S C → Function.Surjective (PrimeSpectrum.comap (algebraMap S C)) → Function.Bijective (wcTorDescMu S C ℓ σC) → ∀ (t : C) (u : Sˣ), (∀ h : ZMod ℓ, σC h t = algebraMap L C (ζ ^ h.val) * t) → t ^ ℓ = algebraMap S C u → Function.Injective (algebraMap S C) ∧ ∀ v : C, ∃ s : Fin ℓ → S, v = ∑ i, algebraMap S C (s i) * t ^ (i : ℕ) :=
by
  intro L _ ℓ hℓ ζ hζ S C _ _ _ _ σC hσ0 hσadd hEt hsurj hbij t u ht htu
  classical
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  haveI := hEt
  haveI : Module.Flat S C := inferInstance
  haveI : Module.FaithfullyFlat S C := Module.FaithfullyFlat.of_comap_surjective hsurj
  haveI : FaithfulSMul S C := Module.FaithfullyFlat.faithfulSMul
  refine ⟨FaithfulSMul.algebraMap_injective S C, ?_⟩

  have hdesc : ∀ v : C, ∑ h : ZMod ℓ, σC h v ∈ Set.range (algebraMap S C) := by
    intro v
    have hinv : ∀ c, σC c (∑ h : ZMod ℓ, σC h v) = ∑ h : ZMod ℓ, σC h v := by
      intro c
      rw [map_sum]
      have e : ∀ h, σC c (σC h v) = σC (c + h) v := fun h => by rw [hσadd]; rfl
      simp_rw [e]
      exact Equiv.sum_comp (Equiv.addLeft c) (fun h => σC h v)
    generalize ∑ h : ZMod ℓ, σC h v = τ at hinv ⊢
    have htens : τ ⊗ₜ[S] (1 : C) = (1 : C) ⊗ₜ[S] τ := by
      apply hbij.1
      funext c
      simp [wcTorDescMu, hinv]
    let P : Submodule S C := LinearMap.range (Algebra.linearMap S C)
    have h1 : P.mkQ (1 : C) = 0 := by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact ⟨1, by simp⟩
    have h2 := congrArg (LinearMap.lTensor C P.mkQ) htens
    rw [LinearMap.lTensor_tmul, LinearMap.lTensor_tmul, h1, TensorProduct.tmul_zero] at h2
    have h3 : P.mkQ τ = 0 := by
      apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := S) (B := C) (C ⧸ P)
      rw [map_zero, TensorProduct.mk_apply]
      exact h2.symm
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h3
    obtain ⟨s, hs⟩ := h3
    exact ⟨s, by simpa using hs⟩

  haveI : NeZero (ℓ : L) := hζ.neZero'
  have hℓL : (ℓ : L) ≠ 0 := NeZero.ne _
  obtain ⟨c, hc⟩ : ∃ c : C, c = algebraMap L C ((ℓ : L)⁻¹) := ⟨_, rfl⟩
  have hcl : c * (ℓ : C) = 1 := by
    rw [hc, ← map_natCast (algebraMap L C), ← map_mul, inv_mul_cancel₀ hℓL, map_one]
  have hσc : ∀ h, σC h c = c := by
    intro h
    have e1 : σC h (ℓ : C) = (ℓ : C) := map_natCast _ _
    calc σC h c = σC h c * ((ℓ : C) * c) := by rw [mul_comm (ℓ : C) c, hcl, mul_one]
      _ = σC h (c * (ℓ : C)) * c := by rw [map_mul, e1]; ring
      _ = c := by rw [hcl, map_one, one_mul]
  have hσpow : ∀ (h : ZMod ℓ) (k : ℕ),
      σC h (t ^ k) = algebraMap L C (ζ ^ (h.val * k)) * t ^ k := by
    intro h k
    rw [map_pow, ht, mul_pow, ← map_pow, ← pow_mul]
  obtain ⟨a, ha⟩ : ∃ a : C, a = algebraMap S C ((u⁻¹ : Sˣ) : S) := ⟨_, rfl⟩
  have hcancel : ∀ i : ℕ, t ^ ((ℓ - 1) * i) * a ^ i * t ^ i = 1 := by
    intro i
    have hl1 : 1 ≤ ℓ := hℓ.one_lt.le
    have e : t ^ ((ℓ - 1) * i) * t ^ i = (t ^ ℓ) ^ i := by
      rw [← pow_add, ← pow_mul]
      congr 1
      calc (ℓ - 1) * i + i = (ℓ - 1 + 1) * i := by ring
        _ = ℓ * i := by rw [Nat.sub_add_cancel hl1]
    calc t ^ ((ℓ - 1) * i) * a ^ i * t ^ i = (t ^ ((ℓ - 1) * i) * t ^ i) * a ^ i := by ring
      _ = (t ^ ℓ * a) ^ i := by rw [e, mul_pow]
      _ = 1 := by rw [htu, ha, ← map_mul, Units.mul_inv, map_one, one_pow]

  have hchar : ∀ h : ZMod ℓ, ∑ i : Fin ℓ, ζ ^ (h.val * ((ℓ - 1) * (i : ℕ))) =
      if h = 0 then (ℓ : L) else 0 := by
    intro h
    have e : ∀ i : Fin ℓ, ζ ^ (h.val * ((ℓ - 1) * (i : ℕ))) =
        (ζ ^ (h.val * (ℓ - 1))) ^ (i : ℕ) := by
      intro i; rw [← pow_mul, mul_assoc]
    simp_rw [e]
    rw [Fin.sum_univ_eq_sum_range (fun k => (ζ ^ (h.val * (ℓ - 1))) ^ k) ℓ]
    split_ifs with h0
    · subst h0
      simp
    · have hndvd : ¬ ℓ ∣ h.val * (ℓ - 1) := by
        intro hd
        rcases (Nat.Prime.dvd_mul hℓ).mp hd with h1 | h1
        · have hpos : 0 < h.val := by
            rw [Nat.pos_iff_ne_zero]
            intro h2
            exact h0 ((ZMod.val_eq_zero h).mp h2)
          exact absurd (Nat.le_of_dvd hpos h1) (not_le.mpr (ZMod.val_lt h))
        · have h2 := hℓ.two_le
          have hpos : 0 < ℓ - 1 := by omega
          have := Nat.le_of_dvd hpos h1
          omega
      have hy1 : ζ ^ (h.val * (ℓ - 1)) ≠ 1 := by
        intro hy
        exact hndvd ((hζ.pow_eq_one_iff_dvd _).mp hy)
      have hyl : (ζ ^ (h.val * (ℓ - 1))) ^ ℓ = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
      have hg := mul_geom_sum (ζ ^ (h.val * (ℓ - 1))) ℓ
      rw [hyl, sub_self] at hg
      exact (mul_eq_zero.mp hg).resolve_left (sub_ne_zero.mpr hy1)

  have hident : ∀ v : C, ∑ i : Fin ℓ, (∑ h : ZMod ℓ, σC h (c * v * t ^ ((ℓ - 1) * (i : ℕ)))) *
      a ^ (i : ℕ) * t ^ (i : ℕ) = v := by
    intro v
    have hterm : ∀ (i : Fin ℓ) (h : ZMod ℓ),
        σC h (c * v * t ^ ((ℓ - 1) * (i : ℕ))) * a ^ (i : ℕ) * t ^ (i : ℕ)
          = c * σC h v * algebraMap L C (ζ ^ (h.val * ((ℓ - 1) * (i : ℕ)))) := by
      intro i h
      rw [map_mul, map_mul, hσc, hσpow]
      have := hcancel (i : ℕ)
      linear_combination (c * σC h v * algebraMap L C (ζ ^ (h.val * ((ℓ - 1) * (i : ℕ))))) * this
    calc ∑ i : Fin ℓ, (∑ h : ZMod ℓ, σC h (c * v * t ^ ((ℓ - 1) * (i : ℕ)))) *
          a ^ (i : ℕ) * t ^ (i : ℕ)
        = ∑ i : Fin ℓ, ∑ h : ZMod ℓ,
            c * σC h v * algebraMap L C (ζ ^ (h.val * ((ℓ - 1) * (i : ℕ)))) := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Finset.sum_mul, Finset.sum_mul]
          exact Finset.sum_congr rfl (fun h _ => hterm i h)
      _ = ∑ h : ZMod ℓ, c * σC h v *
            algebraMap L C (∑ i : Fin ℓ, ζ ^ (h.val * ((ℓ - 1) * (i : ℕ)))) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun h _ => ?_)
          rw [map_sum, Finset.mul_sum]
      _ = ∑ h : ZMod ℓ, c * σC h v * algebraMap L C (if h = 0 then (ℓ : L) else 0) := by
          refine Finset.sum_congr rfl (fun h _ => ?_)
          rw [hchar h]
      _ = c * σC 0 v * algebraMap L C (ℓ : L) := by
          rw [Finset.sum_eq_single 0]
          · rw [if_pos rfl]
          · intro h _ h0
            rw [if_neg h0, map_zero, mul_zero]
          · intro h
            exact absurd (Finset.mem_univ _) h
      _ = v := by
          rw [hσ0, map_natCast, AlgHom.id_apply]
          linear_combination v * hcl

  intro v
  have hd : ∀ i : Fin ℓ, ∃ s : S,
      algebraMap S C s = ∑ h : ZMod ℓ, σC h (c * v * t ^ ((ℓ - 1) * (i : ℕ))) :=
    fun i => hdesc _
  choose s' hs' using hd
  refine ⟨fun i => s' i * ((u⁻¹ : Sˣ) : S) ^ (i : ℕ), ?_⟩
  conv_lhs => rw [← hident v]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [map_mul, map_pow, hs' i, ha]

theorem wc_fsa_kummer_integral_closure : ∀ (O : Type u) [CommRing O] [IsDomain O] [IsIntegrallyClosed O] (π : O), π ≠ 0 → ∀ (S C : Type u) [CommRing S] [CommRing C] [Algebra O S] [IsLocalization.Away π S] [Algebra S C] [Algebra O C] [IsScalarTower O S C] (L : Type u) [Field L] [Algebra L C] (ℓ : ℕ), ℓ.Prime → IsUnit (ℓ : O) → ∀ (ζ : L), IsPrimitiveRoot ζ ℓ → ∀ (σC : ZMod ℓ → (C →ₐ[S] C)) (t : C) (u : Oˣ), (∀ h : ZMod ℓ, σC h t = algebraMap L C (ζ ^ h.val) * t) → t ^ ℓ = algebraMap O C u → Function.Injective (algebraMap S C) → (∀ v : C, ∃ s : Fin ℓ → S, v = ∑ i, algebraMap S C (s i) * t ^ (i : ℕ)) → Nonempty (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u : O)) ≃ₐ[O] integralClosure O C) :=
by
  intro O _ _ _ π hπ S C _ _ _ _ _ _ _ L _ _ ℓ hℓ hℓO ζ hζ σC t u heig hpow hinj hspan
  classical
  have hℓpos : 0 < ℓ := hℓ.pos

  have orth : ∀ i j : ℕ, i < ℓ → j < ℓ →
      ∑ k ∈ Finset.range ℓ, ζ ^ (k * (ℓ - j)) * ζ ^ (k * i) = if i = j then (ℓ : L) else 0 := by
    intro i j hi hj
    have hterm : ∀ k : ℕ, ζ ^ (k * (ℓ - j)) * ζ ^ (k * i) = (ζ ^ (ℓ - j + i)) ^ k := by
      intro k
      rw [← pow_add, ← mul_add, ← pow_mul, mul_comm]
    simp_rw [hterm]
    split_ifs with hij
    · rw [show ℓ - j + i = ℓ by omega, hζ.pow_eq_one]
      simp
    · have hnd : ¬ ℓ ∣ (ℓ - j + i) := by
        rintro ⟨q, hq⟩
        have h1 : q < 2 := by
          by_contra hq2
          have hq2' : 2 ≤ q := by omega
          have := Nat.mul_le_mul_left ℓ hq2'
          omega
        interval_cases q <;> omega
      have hne : ζ ^ (ℓ - j + i) ≠ 1 := by
        rw [Ne, hζ.pow_eq_one_iff_dvd]; exact hnd
      have hpw : (ζ ^ (ℓ - j + i)) ^ ℓ = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
      have h := mul_geom_sum (ζ ^ (ℓ - j + i)) ℓ
      rw [hpw, sub_self] at h
      exact (mul_eq_zero.mp h).resolve_left (sub_ne_zero.mpr hne)

  have proj : ∀ (s : ℕ → S) (j : ℕ), j < ℓ →
      ∑ k ∈ Finset.range ℓ, algebraMap L C (ζ ^ (k * (ℓ - j))) *
        σC (k : ZMod ℓ) (∑ i ∈ Finset.range ℓ, algebraMap S C (s i) * t ^ i) =
        (ℓ : C) * algebraMap S C (s j) * t ^ j := by
    intro s j hj
    have h1 : ∀ k ∈ Finset.range ℓ, algebraMap L C (ζ ^ (k * (ℓ - j))) *
        σC (k : ZMod ℓ) (∑ i ∈ Finset.range ℓ, algebraMap S C (s i) * t ^ i) =
        ∑ i ∈ Finset.range ℓ, algebraMap S C (s i) *
          algebraMap L C (ζ ^ (k * (ℓ - j)) * ζ ^ (k * i)) * t ^ i := by
      intro k hk
      have hkv : ((k : ZMod ℓ)).val = k := ZMod.val_cast_of_lt (Finset.mem_range.mp hk)
      rw [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [map_mul, map_pow, AlgHom.commutes, heig, hkv]
      rw [mul_pow, ← pow_mul]
      ring
    rw [Finset.sum_congr rfl h1, Finset.sum_comm]
    have h2 : ∀ i ∈ Finset.range ℓ, ∑ k ∈ Finset.range ℓ, algebraMap S C (s i) *
        algebraMap L C (ζ ^ (k * (ℓ - j)) * ζ ^ (k * i)) * t ^ i =
        if i = j then (ℓ : C) * algebraMap S C (s j) * t ^ j else 0 := by
      intro i hi
      have e1 : ∑ k ∈ Finset.range ℓ, algebraMap S C (s i) *
          algebraMap L C (ζ ^ (k * (ℓ - j)) * ζ ^ (k * i)) * t ^ i =
          algebraMap S C (s i) *
            algebraMap L C (∑ k ∈ Finset.range ℓ, ζ ^ (k * (ℓ - j)) * ζ ^ (k * i)) * t ^ i := by
        rw [map_sum, Finset.mul_sum, Finset.sum_mul]
      rw [e1, orth i j (Finset.mem_range.mp hi) hj]
      split_ifs with hij
      · subst hij; rw [map_natCast]; ring
      · rw [map_zero, mul_zero, zero_mul]
    rw [Finset.sum_congr rfl h2, Finset.sum_ite_eq', if_pos (Finset.mem_range.mpr hj)]

  have away : ∀ s : S, IsIntegral O s → ∃ c : O, algebraMap O S c = s := by
    intro s hs
    have hunit : ∀ y : Submonoid.powers π,
        IsUnit ((Algebra.ofId O (FractionRing O)) (y : O)) := by
      rintro ⟨_, n, rfl⟩
      show IsUnit (algebraMap O (FractionRing O) (π ^ n))
      exact isUnit_iff_ne_zero.mpr
        ((map_ne_zero_iff _ (IsFractionRing.injective O (FractionRing O))).mpr (pow_ne_zero n hπ))
    let g : S →ₐ[O] FractionRing O :=
      IsLocalization.liftAlgHom (M := Submonoid.powers π) (f := Algebra.ofId O (FractionRing O)) hunit
    obtain ⟨c, hc⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral (hs.map g)
    obtain ⟨⟨a, ⟨_, n, rfl⟩⟩, ha⟩ := IsLocalization.surj (Submonoid.powers π) s
    have ha' : s * algebraMap O S (π ^ n) = algebraMap O S a := ha
    have hg : g s * algebraMap O (FractionRing O) (π ^ n) = algebraMap O (FractionRing O) a := by
      have := congrArg g ha'
      rwa [map_mul, AlgHom.commutes, AlgHom.commutes] at this
    have hca : c * π ^ n = a := by
      apply IsFractionRing.injective O (FractionRing O)
      rw [map_mul, hc, hg]
    refine ⟨c, ?_⟩
    have hu : IsUnit (algebraMap O S (π ^ n)) := by
      rw [map_pow]; exact (IsLocalization.Away.algebraMap_isUnit π).pow n
    refine (hu.mul_left_inj).mp ?_
    rw [ha', ← hca, map_mul]

  have hmon : (Polynomial.X ^ ℓ - Polynomial.C (u : O)).Monic :=
    Polynomial.monic_X_pow_sub_C _ hℓpos.ne'
  have hdegf : (Polynomial.X ^ ℓ - Polynomial.C (u : O)).natDegree = ℓ :=
    Polynomial.natDegree_X_pow_sub_C
  have hf1 : (Polynomial.X ^ ℓ - Polynomial.C (u : O)) ≠ 1 := by
    intro h
    have := congrArg Polynomial.natDegree h
    rw [hdegf, Polynomial.natDegree_one] at this
    omega
  have nf : ∀ x : AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u : O)), ∃ c : ℕ → O,
      x = ∑ i ∈ Finset.range ℓ, algebraMap O (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u : O))) (c i) *
        AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C (u : O)) ^ i := by
    intro x
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective x
    refine ⟨(p %ₘ (Polynomial.X ^ ℓ - Polynomial.C (u : O))).coeff, ?_⟩
    have hmk : AdjoinRoot.mk (Polynomial.X ^ ℓ - Polynomial.C (u : O)) p =
        AdjoinRoot.mk (Polynomial.X ^ ℓ - Polynomial.C (u : O))
          (p %ₘ (Polynomial.X ^ ℓ - Polynomial.C (u : O))) := by
      rw [AdjoinRoot.mk_eq_mk]
      refine ⟨p /ₘ (Polynomial.X ^ ℓ - Polynomial.C (u : O)), ?_⟩
      have := Polynomial.modByMonic_add_div p (Polynomial.X ^ ℓ - Polynomial.C (u : O))
      linear_combination -this
    have hdeg : (p %ₘ (Polynomial.X ^ ℓ - Polynomial.C (u : O))).natDegree < ℓ := by
      have := Polynomial.natDegree_modByMonic_lt p hmon hf1
      rwa [hdegf] at this
    rw [hmk, ← AdjoinRoot.aeval_eq, Polynomial.aeval_eq_sum_range' hdeg]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Algebra.smul_def]

  obtain ⟨ℓu, hℓu⟩ := hℓO
  set ℓinv : C := algebraMap O C ((ℓu⁻¹ : Oˣ) : O) with hℓinv
  have hℓinv1 : ℓinv * (ℓ : C) = 1 := by
    rw [hℓinv, ← map_natCast (algebraMap O C) ℓ, ← hℓu, ← map_mul, Units.inv_mul, map_one]
  set tinv : C := t ^ (ℓ - 1) * algebraMap O C ((u⁻¹ : Oˣ) : O) with htinv
  have ht1 : t * tinv = 1 := by
    rw [htinv, ← mul_assoc, ← pow_succ', Nat.sub_add_cancel (by omega : 1 ≤ ℓ), hpow, ← map_mul,
      Units.mul_inv, map_one]
  have hti : IsIntegral O t := by
    refine IsIntegral.of_pow hℓpos ?_
    rw [hpow]; exact isIntegral_algebraMap
  have htinvi : IsIntegral O tinv := (hti.pow _).mul isIntegral_algebraMap
  have hℓinvi : IsIntegral O ℓinv := isIntegral_algebraMap
  have hζi : ∀ m : ℕ, IsIntegral O (algebraMap L C (ζ ^ m)) := by
    intro m
    refine IsIntegral.of_pow hℓpos ?_
    rw [← map_pow, ← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow, map_one]
    exact isIntegral_one
  have hinjOS : Function.Injective (algebraMap O S) :=
    IsLocalization.injective S (powers_le_nonZeroDivisors_of_noZeroDivisors hπ)
  have hinjOC : Function.Injective (algebraMap O C) := by
    rw [IsScalarTower.algebraMap_eq O S C]
    exact hinj.comp hinjOS
  have extract : ∀ (s : ℕ → S) (j : ℕ), j < ℓ → algebraMap S C (s j) =
      ℓinv * (∑ k ∈ Finset.range ℓ, algebraMap L C (ζ ^ (k * (ℓ - j))) *
        σC (k : ZMod ℓ) (∑ i ∈ Finset.range ℓ, algebraMap S C (s i) * t ^ i)) * tinv ^ j := by
    intro s j hj
    rw [proj s j hj]
    calc algebraMap S C (s j) = algebraMap S C (s j) * (ℓinv * (ℓ : C)) * (t * tinv) ^ j := by
          rw [hℓinv1, ht1, one_pow, mul_one, mul_one]
      _ = _ := by ring

  have hroot : Polynomial.eval₂ (↑(Algebra.ofId O C)) t
      (Polynomial.X ^ ℓ - Polynomial.C (u : O)) = 0 := by
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hpow]
    exact sub_self _
  let φ := AdjoinRoot.liftAlgHom (Polynomial.X ^ ℓ - Polynomial.C (u : O)) (Algebra.ofId O C) t hroot
  have hφr : φ (AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C (u : O))) = t :=
    AdjoinRoot.liftAlgHom_root _ _ _ _
  have star : ∀ c : ℕ → O, φ (∑ i ∈ Finset.range ℓ,
      algebraMap O (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u : O))) (c i) *
        AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C (u : O)) ^ i) =
      ∑ i ∈ Finset.range ℓ, algebraMap O C (c i) * t ^ i := by
    intro c
    rw [map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, map_pow, AlgHom.commutes, hφr]
  have hmem : ∀ x, φ x ∈ integralClosure O C := by
    intro x
    obtain ⟨c, rfl⟩ := nf x
    rw [star]
    exact Subalgebra.sum_mem _ (fun i _ => Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
      (Subalgebra.pow_mem _ (show t ∈ integralClosure O C from hti) _))

  have hφinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨c, rfl⟩ := nf x
    rw [star] at hx
    have hc : ∀ j < ℓ, c j = 0 := by
      intro j hj
      have := extract (fun i => algebraMap O S (c i)) j hj
      simp only [← IsScalarTower.algebraMap_apply] at this
      simp only [hx, map_zero, mul_zero, Finset.sum_const_zero, zero_mul] at this
      exact (map_eq_zero_iff _ hinjOC).mp this
    exact Finset.sum_eq_zero (fun i hi => by
      rw [hc i (Finset.mem_range.mp hi), map_zero, zero_mul])

  have hsurj : ∀ v : C, IsIntegral O v → ∃ x, φ x = v := by
    intro v hv
    obtain ⟨s₀, hs₀⟩ := hspan v
    let s : ℕ → S := fun i => if h : i < ℓ then s₀ ⟨i, h⟩ else 0
    have hvs : v = ∑ i ∈ Finset.range ℓ, algebraMap S C (s i) * t ^ i := by
      rw [hs₀, ← Fin.sum_univ_eq_sum_range (fun i => algebraMap S C (s i) * t ^ i) ℓ]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp [s]
    have hcoef : ∀ j, ∃ c : O, j < ℓ → algebraMap O S c = s j := by
      intro j
      by_cases hj : j < ℓ
      · have hint : IsIntegral O (algebraMap S C (s j)) := by
          rw [extract s j hj, ← hvs]
          refine (hℓinvi.mul ?_).mul (htinvi.pow j)
          refine IsIntegral.sum _ (fun k _ => (hζi _).mul ?_)
          exact hv.map ((σC (k : ZMod ℓ)).restrictScalars O)
        have hint' : IsIntegral O (s j) :=
          (isIntegral_algHom_iff (IsScalarTower.toAlgHom O S C) hinj).mp hint
        obtain ⟨c, hc⟩ := away (s j) hint'
        exact ⟨c, fun _ => hc⟩
      · exact ⟨0, fun h => absurd h hj⟩
    choose c hc using hcoef
    refine ⟨∑ i ∈ Finset.range ℓ,
      algebraMap O (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u : O))) (c i) *
        AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C (u : O)) ^ i, ?_⟩
    rw [star, hvs]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    rw [IsScalarTower.algebraMap_apply O S C, hc i (Finset.mem_range.mp hi)]

  let Φ := φ.codRestrict (integralClosure O C) hmem
  refine ⟨AlgEquiv.ofBijective Φ ⟨?_, ?_⟩⟩
  · intro x y hxy
    apply hφinj
    exact congrArg Subtype.val hxy
  · rintro ⟨v, hv⟩
    obtain ⟨x, hx⟩ := hsurj v hv
    exact ⟨x, Subtype.ext hx⟩

theorem wc_fsa_normalization_stalk_etale : ∀ {X Y : Scheme.{u}} (g : Y ⟶ X) [QuasiCompact g] [QuasiSeparated g] [IsAffineHom g] (x : X) (D : Type u) [CommRing D] [Algebra (X.presheaf.stalk x) D] (e : Limits.pullback g (X.fromSpecStalk x) ≅ Spec (.of D)), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) D)) = Limits.pullback.snd g (X.fromSpecStalk x) → Algebra.Etale (X.presheaf.stalk x) (integralClosure (X.presheaf.stalk x) D) → Etale (Limits.pullback.snd (Scheme.Hom.fromNormalization g) (X.fromSpecStalk x)) :=
by
  intro X Y g _ _ _ x D _ _ e he hEt

  obtain ⟨U, hU, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
    (show x ∈ (⊤ : X.Opens) from trivial)
  have hU : IsAffineOpen U := hU
  letI iB : Algebra Γ(X, U) Γ(Y, g ⁻¹ᵁ U) := (g.app U).hom.toAlgebra
  letI iO : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hxU).hom.toAlgebra
  haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x) (hU.primeIdealOf ⟨x, hxU⟩).asIdeal :=
    hU.isLocalization_stalk ⟨x, hxU⟩

  have s3 : ∀ {Z : Scheme.{u}} (ν : Z ⟶ X) (C : Type u) [CommRing C] [Algebra Γ(X, U) C]
      (i : Spec (.of C) ⟶ Z),
      IsPullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) C))) i hU.fromSpec ν →
      ∃ e : Limits.pullback ν (X.fromSpecStalk x) ≅
          Spec (.of (TensorProduct Γ(X, U) (X.presheaf.stalk x) C)),
        e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
          (TensorProduct Γ(X, U) (X.presheaf.stalk x) C))) =
          Limits.pullback.snd ν (X.fromSpecStalk x) := by
    intro Z ν C _ _ i H₁
    have H₂ := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct Γ(X, U) (X.presheaf.stalk x) C)
    have H := H₂.flip.paste_horiz H₁.flip
    have hb : Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) (X.presheaf.stalk x))) ≫
        hU.fromSpec = X.fromSpecStalk x := by
      rw [← hU.fromSpecStalk_eq_fromSpecStalk hxU]; rfl
    rw [hb] at H
    refine ⟨H.isoPullback.symm, ?_⟩
    rw [Iso.symm_hom]
    exact H.isoPullback_inv_snd

  have s4 : ∀ (O D T : Type u) [CommRing O] [CommRing D] [CommRing T] [Algebra O D] [Algebra O T]
      (φ : Spec (.of D) ≅ Spec (.of T)),
      φ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap O T)) =
        Spec.map (CommRingCat.ofHom (algebraMap O D)) → Nonempty (D ≃ₐ[O] T) := by
    intro O D T _ _ _ _ _ φ hφ
    let ψ : CommRingCat.of T ⟶ CommRingCat.of D := Spec.preimage φ.hom
    let ψ' : CommRingCat.of D ⟶ CommRingCat.of T := Spec.preimage φ.inv
    have h1 : ψ ≫ ψ' = 𝟙 _ := Spec.map_injective (by
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Iso.inv_hom_id, Spec.map_id])
    have h2 : ψ' ≫ ψ = 𝟙 _ := Spec.map_injective (by
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Iso.hom_inv_id, Spec.map_id])
    have h3 : CommRingCat.ofHom (algebraMap O T) ≫ ψ = CommRingCat.ofHom (algebraMap O D) :=
      Spec.map_injective (by rw [Spec.map_comp, Spec.map_preimage, hφ])
    let r : T ≃+* D := (Iso.mk ψ ψ' h1 h2).commRingCatIsoToRingEquiv
    refine ⟨(AlgEquiv.ofRingEquiv (f := r) ?_).symm⟩
    intro c
    exact congrArg (fun f => CommRingCat.Hom.hom f c) h3

  have H₁ : IsPullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) Γ(Y, g ⁻¹ᵁ U))))
      (hU.preimage g).fromSpec hU.fromSpec g := by
    refine IsOpenImmersion.isPullback _ _ _ _ ?_ ?_
    · have hφ : CommRingCat.ofHom (algebraMap Γ(X, U) Γ(Y, g ⁻¹ᵁ U)) =
          g.appLE U (g ⁻¹ᵁ U) le_rfl := by
        rw [← Scheme.Hom.app_eq_appLE]; rfl
      rw [hφ]
      exact (IsAffineOpen.SpecMap_appLE_fromSpec g hU (hU.preimage g) le_rfl).symm
    · rw [hU.opensRange_fromSpec, (hU.preimage g).opensRange_fromSpec]
  obtain ⟨e₁, he₁⟩ := s3 g Γ(Y, g ⁻¹ᵁ U) (hU.preimage g).fromSpec H₁
  have hφ : (e.symm ≪≫ e₁).hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
      (TensorProduct Γ(X, U) (X.presheaf.stalk x) Γ(Y, g ⁻¹ᵁ U)))) =
      Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) D)) := by
    rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, he₁, ← he, Iso.inv_hom_id_assoc]
  obtain ⟨ε⟩ := s4 _ _ _ _ hφ

  have hT : Algebra.Etale (X.presheaf.stalk x)
      (TensorProduct Γ(X, U) (X.presheaf.stalk x) (integralClosure Γ(X, U) Γ(Y, g ⁻¹ᵁ U))) := by
    haveI := Algebra.Etale.of_equiv ε.mapIntegralClosure
    exact Algebra.Etale.of_equiv (AlgEquiv.ofBijective _
      (TensorProduct.toIntegralClosure_bijective_of_isLocalization (B := Γ(Y, g ⁻¹ᵁ U))
        (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl)).symm

  have hoi : IsOpenImmersion (g.normalizationOpenCover.f ⟨U, hU⟩) :=
    g.normalizationOpenCover.map_prop ⟨U, hU⟩
  letI hAI : Algebra Γ(X, U) (integralClosure Γ(X, U) Γ(Y, g ⁻¹ᵁ U)) := inferInstance
  have H₂ : IsPullback (Spec.map (CommRingCat.ofHom
      (algebraMap Γ(X, U) (integralClosure Γ(X, U) Γ(Y, g ⁻¹ᵁ U)))))
      (g.normalizationOpenCover.f ⟨U, hU⟩) hU.fromSpec g.fromNormalization := by
    refine @IsOpenImmersion.isPullback _ _ _ _ _ _ _ _ hoi _ ?_ ?_
    · exact Scheme.Hom.ι_fromNormalization g ⟨U, hU⟩
    · rw [hU.opensRange_fromSpec]; exact Scheme.Hom.fromNormalization_preimage g ⟨U, hU⟩
  obtain ⟨e₂, he₂⟩ := @s3 _ g.fromNormalization (integralClosure Γ(X, U) Γ(Y, g ⁻¹ᵁ U)) _ hAI
    (g.normalizationOpenCover.f ⟨U, hU⟩) H₂
  rw [← he₂]
  haveI : Etale (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
      (TensorProduct Γ(X, U) (X.presheaf.stalk x) (integralClosure Γ(X, U) Γ(Y, g ⁻¹ᵁ U)))))) :=
    (HasRingHomProperty.Spec_iff (P := @Etale)).mpr (RingHom.etale_algebraMap.mpr hT)
  infer_instance

theorem wc_fco_etale_stalk_at_section : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (κ : K →+* A₀) (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _) (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → (∃ r : Spec (.of (FractionRing A₀)) ⟶ P, r ≫ p = Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])) → ∀ [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], (∀ y : X, (f y).asIdeal.height = 1 → IsRegularLocalRing (X.presheaf.stalk y) ∧ UniqueFactorizationMonoid (X.presheaf.stalk y)) → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ q : Spec (.of A₀), q.asIdeal.height = 1 → Etale (Limits.pullback.snd (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (X.fromSpecStalk (σ q))) :=
by
  intro K _ _ ℓ hℓ hℓK A₀ _ _ _ _ κ X _ _ f _ σ hσ P p α hP hrex _ _ hreg hnorm hfin hpb q hq
  classical

  have s1 : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [IsNoetherianRing A]
      (q : Ideal A) [q.IsPrime], q.height = 1 → IsDiscreteValuationRing (Localization.AtPrime q) := by
    intro A _ _ _ _ q _ hq
    haveI : IsIntegrallyClosed (Localization.AtPrime q) :=
      isIntegrallyClosed_of_isLocalization _ q.primeCompl (Ideal.primeCompl_le_nonZeroDivisors q)
    have hdim : ringKrullDim (Localization.AtPrime q) = 1 := by
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height q, hq]; rfl
    have hnf : ¬ IsField (Localization.AtPrime q) := by
      intro h
      rw [ringKrullDim_eq_zero_of_isField h] at hdim
      exact absurd hdim (by decide)
    have key : IsDiscreteValuationRing (Localization.AtPrime q) ↔
        (IsIntegrallyClosed (Localization.AtPrime q) ∧
          ∃! P : Ideal (Localization.AtPrime q), P ≠ ⊥ ∧ P.IsPrime) :=
      (IsDiscreteValuationRing.TFAE (Localization.AtPrime q) hnf).out 1 4
    refine key.mpr ⟨inferInstance, ?_⟩
    refine ⟨IsLocalRing.maximalIdeal _, ⟨?_, inferInstance⟩, ?_⟩
    · intro h
      exact hnf ((IsLocalRing.isField_iff_maximalIdeal_eq).mpr h)
    · rintro P ⟨hP0, hP⟩
      haveI : Ring.KrullDimLE 1 (Localization.AtPrime q) :=
        Ring.krullDimLE_iff.mpr (le_of_eq hdim)
      rcases Ring.krullDimLE_one_iff.mp this P hP with h | h
      · rw [IsDomain.minimalPrimes_eq_singleton_bot] at h
        exact absurd h hP0
      · exact IsLocalRing.eq_maximalIdeal h

  have s2 : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (s : Spec (.of A) ⟶ X) (q : PrimeSpectrum A),
      ∃ ρ : X.presheaf.stalk (s q) ⟶ CommRingCat.of (Localization.AtPrime q.asIdeal),
        IsLocalHom ρ.hom ∧ Spec.map ρ ≫ X.fromSpecStalk (s q) =
          Spec.map (CommRingCat.ofHom (algebraMap A (Localization.AtPrime q.asIdeal))) ≫ s := by
    intro A _ X s q
    have hcp0 : (Spec.map (CommRingCat.ofHom (algebraMap A (Localization.AtPrime q.asIdeal))))
        (IsLocalRing.closedPoint (Localization.AtPrime q.asIdeal)) = q :=
      PrimeSpectrum.ext (IsLocalization.AtPrime.under_maximalIdeal _ q.asIdeal)
    have hcp : (Spec.map (CommRingCat.ofHom (algebraMap A (Localization.AtPrime q.asIdeal))) ≫ s)
        (IsLocalRing.closedPoint (Localization.AtPrime q.asIdeal)) = s q :=
      (Scheme.Hom.comp_apply _ s _).trans (congrArg s hcp0)
    have key : ∀ y : X,
        (Spec.map (CommRingCat.ofHom (algebraMap A (Localization.AtPrime q.asIdeal))) ≫ s)
          (IsLocalRing.closedPoint (Localization.AtPrime q.asIdeal)) = y →
        ∃ ρ : X.presheaf.stalk y ⟶ CommRingCat.of (Localization.AtPrime q.asIdeal),
          IsLocalHom ρ.hom ∧ Spec.map ρ ≫ X.fromSpecStalk y =
            Spec.map (CommRingCat.ofHom (algebraMap A (Localization.AtPrime q.asIdeal))) ≫ s := by
      intro y hy
      subst hy
      exact ⟨Scheme.stalkClosedPointTo _, Scheme.isLocalHom_stalkClosedPointTo _,
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk _⟩
    exact key _ hcp

  have s4 : ∀ (A : Type u) [CommRing A] [IsDomain A] (q : Ideal A) [q.IsPrime]
      [IsDiscreteValuationRing (Localization.AtPrime q)] (O : Type u) [CommRing O] [IsDomain O]
      [UniqueFactorizationMonoid O] (φ : A →+* O) (ρ : O →+* Localization.AtPrime q),
      IsLocalHom ρ → ρ.comp φ = algebraMap A (Localization.AtPrime q) →
      ∃ ϖ₀ : A, Prime (φ ϖ₀) ∧ Irreducible (algebraMap A (Localization.AtPrime q) ϖ₀) ∧
        ∀ a : A, a ≠ 0 → ∃ (n : ℕ) (v : Oˣ), φ a = v * φ ϖ₀ ^ n := by
    intro A _ _ q _ _ O _ _ _ φ ρ hρl hρφ
    have hρφx : ∀ x : A, ρ (φ x) = algebraMap A (Localization.AtPrime q) x := fun x => by
      rw [← hρφ]; rfl
    have hunit : ∀ b : A, b ∉ q → IsUnit (φ b) := by
      intro b hb
      have h1 : IsUnit (ρ (φ b)) := by
        rw [hρφx]
        exact IsLocalization.map_units (Localization.AtPrime q) (⟨b, hb⟩ : q.primeCompl)
      exact isUnit_of_map_unit ρ _ h1
    have hinjA : Function.Injective (algebraMap A (Localization.AtPrime q)) :=
      IsLocalization.injective _ (Ideal.primeCompl_le_nonZeroDivisors q)
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (Localization.AtPrime q)
    obtain ⟨⟨a₀, s₀⟩, hmk⟩ := IsLocalization.mk'_surjective q.primeCompl ϖ
    have hspec : algebraMap A (Localization.AtPrime q) a₀ =
        ϖ * algebraMap A (Localization.AtPrime q) s₀ := by
      rw [← hmk, IsLocalization.mk'_spec]
    have hirr0 : Irreducible (algebraMap A (Localization.AtPrime q) a₀) := by
      rw [hspec]
      have hu : IsUnit (algebraMap A (Localization.AtPrime q) (s₀ : A)) :=
        IsLocalization.map_units (Localization.AtPrime q) s₀
      exact (irreducible_mul_isUnit hu).mpr hϖ
    have hπirr : Irreducible (φ a₀) := by
      refine ⟨?_, ?_⟩
      · intro h
        have := h.map ρ
        rw [hρφx] at this
        exact hirr0.not_isUnit this
      · intro x y hxy
        have h1 : algebraMap A (Localization.AtPrime q) a₀ = ρ x * ρ y := by
          rw [← hρφx, hxy, map_mul]
        rcases hirr0.isUnit_or_isUnit h1 with h | h
        · exact Or.inl (isUnit_of_map_unit ρ _ h)
        · exact Or.inr (isUnit_of_map_unit ρ _ h)
    refine ⟨a₀, UniqueFactorizationMonoid.irreducible_iff_prime.mp hπirr, hirr0, ?_⟩
    intro a ha
    have ha' : algebraMap A (Localization.AtPrime q) a ≠ 0 := by
      intro h
      exact ha (hinjA (by rw [h, map_zero]))
    obtain ⟨n, w, hw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha' hirr0
    obtain ⟨⟨b, c⟩, hbc⟩ := IsLocalization.mk'_surjective q.primeCompl (w : Localization.AtPrime q)
    have hb : b ∉ q := by
      have := w.isUnit
      rw [← hbc] at this
      exact (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime q) q b c).mp this
    have hc : (c : A) ∉ q := c.2
    have heq : a * c = b * a₀ ^ n := by
      apply hinjA
      have hs : IsLocalization.mk' (Localization.AtPrime q) b c * algebraMap A _ (c : A) =
          algebraMap A _ b := IsLocalization.mk'_spec _ b c
      rw [map_mul, map_mul, map_pow, hw, ← hbc]
      dsimp only
      rw [← hs]
      ring
    obtain ⟨ub, hub⟩ := hunit b hb
    obtain ⟨uc, huc⟩ := hunit c hc
    refine ⟨n, ub * uc⁻¹, ?_⟩
    have h2 : φ a * φ c = φ b * φ a₀ ^ n := by rw [← map_mul, heq, map_mul, map_pow]
    rw [← hub, ← huc] at h2
    calc φ a = φ a * (uc : O) * ((uc⁻¹ : Oˣ) : O) := by rw [mul_assoc, Units.mul_inv, mul_one]
      _ = _ := by rw [h2, Units.val_mul]; ring

  have s6 : ∀ (q : PrimeSpectrum A₀) (y : X)
      (ρ : X.presheaf.stalk y ⟶ CommRingCat.of (Localization.AtPrime q.asIdeal)),
      Spec.map ρ ≫ X.fromSpecStalk y =
        Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime q.asIdeal))) ≫ σ →
      ∀ (r : Spec (.of (FractionRing A₀)) ⟶ P), r ≫ p = Limits.pullback.lift
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _)
        (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]) →
      ∀ (C : Type u) [CommRing C] [Algebra (X.presheaf.stalk y) C]
        (e : Limits.pullback (p ≫ Limits.pullback.fst f
          (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk y) ≅
          Spec (.of C)),
        e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk y) C)) =
          Limits.pullback.snd _ _ →
        ∃ ψ : C →+* FractionRing A₀, ψ.comp (algebraMap (X.presheaf.stalk y) C) =
          (algebraMap (Localization.AtPrime q.asIdeal) (FractionRing A₀)).comp ρ.hom := by
    intro q y ρ hρ r hr C _ _ e he
    have htow : Spec.map (CommRingCat.ofHom
          (algebraMap (Localization.AtPrime q.asIdeal) (FractionRing A₀))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime q.asIdeal))) =
        Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
    have hw : r ≫ (p ≫ Limits.pullback.fst f
          (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) =
        (Spec.map (CommRingCat.ofHom
          (algebraMap (Localization.AtPrime q.asIdeal) (FractionRing A₀))) ≫
          Spec.map ρ) ≫ X.fromSpecStalk y := by
      rw [← Category.assoc, hr, Limits.pullback.lift_fst, Category.assoc, hρ, ← Category.assoc, htow]
    let m := Limits.pullback.lift _ _ hw
    refine ⟨(Spec.preimage (m ≫ e.hom)).hom, ?_⟩
    have h1 : Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk y) C) ≫
          Spec.preimage (m ≫ e.hom)) =
        Spec.map (ρ ≫ CommRingCat.ofHom
          (algebraMap (Localization.AtPrime q.asIdeal) (FractionRing A₀))) := by
      rw [Spec.map_comp, Spec.map_preimage, Category.assoc, he, Spec.map_comp]
      exact Limits.pullback.lift_snd _ _ _
    exact congrArg CommRingCat.Hom.hom (Spec.map_injective h1)

  have seig : ∀ (L : Type u) [Field L] (ℓ : ℕ) [NeZero ℓ] (ζ : L) (S C : Type u) [CommRing S]
      [CommRing C] [Algebra L S] [Algebra S C] [Algebra L C] [IsScalarTower L S C]
      (σC : ZMod ℓ → (C →ₐ[S] C)), σC 0 = AlgHom.id S C →
      (∀ c c', σC (c + c') = (σC c).comp (σC c')) → ∀ t : C, σC 1 t = algebraMap L C ζ * t →
      ∀ h : ZMod ℓ, σC h t = algebraMap L C (ζ ^ h.val) * t := by
    intro L _ ℓ _ ζ S C _ _ _ _ _ _ σC hσ0 hσadd t ht1
    have hfix : ∀ c : ZMod ℓ, σC c (algebraMap L C ζ) = algebraMap L C ζ := by
      intro c
      rw [IsScalarTower.algebraMap_apply L S C, AlgHom.commutes]
    have key : ∀ n : ℕ, σC (n : ZMod ℓ) t = algebraMap L C (ζ ^ n) * t := by
      intro n
      induction n with
      | zero => rw [Nat.cast_zero, hσ0, pow_zero, map_one, one_mul, AlgHom.id_apply]
      | succ n ih =>
        rw [Nat.cast_succ, hσadd, AlgHom.comp_apply, ht1, map_mul, ih, hfix, pow_succ, map_mul]
        ring
    intro h
    have := key h.val
    rwa [ZMod.natCast_zmod_val] at this

  have s10 : ∀ (O : Type u) [CommRing O] [IsDomain O] [UniqueFactorizationMonoid O] (π : O),
      Prime π → ∀ (S : Type u) [CommRing S] [Algebra O S] [IsLocalization.Away π S]
      (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V] (F' : Type u) [Field F']
      [Algebra V F'] [IsFractionRing V F'] (ρ : O →+* V), Irreducible (ρ π) →
      ∀ (χ : S →+* F'), χ.comp (algebraMap O S) = (algebraMap V F').comp ρ →
      ∀ (ℓ : ℕ), 0 < ℓ → ∀ (a : Sˣ) (s : F'), s ^ ℓ = χ a →
      ∃ (w : Oˣ) (b : Sˣ), (a : S) = algebraMap O S w * (b : S) ^ ℓ := by
    intro O _ _ _ π hπ S _ _ _ V _ _ _ F' _ _ _ ρ hρπ χ hχ ℓ hℓ a s hs
    have hπ0 : π ≠ 0 := hπ.ne_zero
    have hinjS : Function.Injective (algebraMap O S) :=
      IsLocalization.injective S (powers_le_nonZeroDivisors_of_noZeroDivisors hπ0)
    have hχx : ∀ x : O, χ (algebraMap O S x) = algebraMap V F' (ρ x) := fun x => by
      rw [← RingHom.comp_apply, hχ]; rfl
    let U : Sˣ := (IsLocalization.Away.algebraMap_isUnit π).unit
    have hU : (U : S) = algebraMap O S π := IsUnit.unit_spec _
    obtain ⟨⟨x, ⟨_, n, rfl⟩⟩, hx⟩ := IsLocalization.surj (Submonoid.powers π) (a : S)
    obtain ⟨⟨y, ⟨_, m, rfl⟩⟩, hy⟩ := IsLocalization.surj (Submonoid.powers π) ((a⁻¹ : Sˣ) : S)
    have hx' : (a : S) * algebraMap O S (π ^ n) = algebraMap O S x := hx
    have hy' : ((a⁻¹ : Sˣ) : S) * algebraMap O S (π ^ m) = algebraMap O S y := hy
    have hxy : x * y = π ^ (n + m) := by
      apply hinjS
      rw [map_mul, ← hx', ← hy', pow_add, map_mul]
      calc (a : S) * algebraMap O S (π ^ n) * (((a⁻¹ : Sˣ) : S) * algebraMap O S (π ^ m))
          = ((a : S) * ((a⁻¹ : Sˣ) : S)) * (algebraMap O S (π ^ n) * algebraMap O S (π ^ m)) := by
            ring
        _ = _ := by rw [Units.mul_inv, one_mul]
    obtain ⟨i, -, hassoc⟩ := (dvd_prime_pow hπ (n + m)).mp ⟨y, hxy.symm⟩
    obtain ⟨u, hu⟩ := hassoc
    have ha : (a : S) * (U : S) ^ n = (U : S) ^ i * algebraMap O S ((u⁻¹ : Oˣ) : O) := by
      rw [hU, ← map_pow, ← map_pow, hx', ← map_mul, ← hu, mul_assoc, Units.mul_inv, mul_one]
    set ϖ := ρ π with hϖ
    have hϖ0 : ϖ ≠ 0 := hρπ.ne_zero
    have hF : s ^ ℓ * algebraMap V F' ϖ ^ n =
        algebraMap V F' ϖ ^ i * algebraMap V F' (ρ ((u⁻¹ : Oˣ) : O)) := by
      have := congrArg χ ha
      rw [map_mul, map_mul, map_pow, map_pow, hU, hχx, hχx, ← hs] at this
      exact this
    obtain ⟨c, d, hd, hcd⟩ := IsFractionRing.div_surjective (A := V) s
    have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
    have hdF : algebraMap V F' d ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective V F')).mpr hd0
    have hV : c ^ ℓ * ϖ ^ n = d ^ ℓ * ϖ ^ i * ρ ((u⁻¹ : Oˣ) : O) := by
      apply IsFractionRing.injective V F'
      rw [← hcd, div_pow] at hF
      have hdl : algebraMap V F' d ^ ℓ ≠ 0 := pow_ne_zero _ hdF
      simp only [map_mul, map_pow]
      field_simp at hF
      linear_combination hF
    have hρu : IsUnit (ρ ((u⁻¹ : Oˣ) : O)) := (Units.isUnit _).map ρ
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ.ne', zero_mul] at hV
      exact mul_ne_zero (mul_ne_zero (pow_ne_zero _ hd0) (pow_ne_zero _ hϖ0)) hρu.ne_zero hV.symm
    obtain ⟨kc, uc, hc⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc0 hρπ
    obtain ⟨kd, ud, hdd⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hd0 hρπ
    obtain ⟨ru, hru⟩ := hρu
    have hexp : kc * ℓ + n = kd * ℓ + i := by
      apply IsDiscreteValuationRing.unit_mul_pow_congr_pow hρπ hρπ (uc ^ ℓ) (ud ^ ℓ * ru)
      rw [Units.val_mul, Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, hru]
      rw [hc, hdd] at hV
      linear_combination hV
    set k : ℤ := (kc : ℤ) - kd with hk
    have hk' : k * ℓ = (i : ℤ) - n := by
      have : ((kc * ℓ + n : ℕ) : ℤ) = ((kd * ℓ + i : ℕ) : ℤ) := by rw [hexp]
      push_cast at this
      rw [hk]; linarith
    let W : Sˣ := Units.map (algebraMap O S).toMonoidHom u⁻¹
    have haU : a * U ^ n = U ^ i * W := by
      apply Units.ext
      simp only [Units.val_mul, Units.val_pow_eq_pow_val]
      exact ha
    refine ⟨u⁻¹, U ^ k, ?_⟩
    have h1 : a = U ^ i * W * (U ^ n)⁻¹ := eq_mul_inv_of_mul_eq haU
    have h2 : (U ^ k) ^ ℓ = U ^ i * (U ^ n)⁻¹ := by
      rw [← zpow_natCast (U ^ k), ← zpow_mul, hk', zpow_sub, zpow_natCast, zpow_natCast]
    have h3 : a = W * (U ^ k) ^ ℓ := by
      rw [h1, h2, mul_right_comm, mul_comm]
    have := congrArg Units.val h3
    rw [Units.val_mul, Units.val_pow_eq_pow_val] at this
    exact this

  have s12 : ∀ (O : Type u) [CommRing O] (ℓ : ℕ), 0 < ℓ → IsUnit (ℓ : O) → ∀ u : Oˣ,
      Algebra.Etale O (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u : O))) := by
    intro O _ ℓ hℓ hℓu u
    obtain ⟨L, hL⟩ := hℓu
    have hmon : (Polynomial.X ^ ℓ - Polynomial.C (u : O)).Monic :=
      Polynomial.monic_X_pow_sub_C _ hℓ.ne'
    let Pp : StandardEtalePair O :=
      { f := Polynomial.X ^ ℓ - Polynomial.C (u : O)
        monic_f := hmon
        g := 1
        cond := by
          refine ⟨Polynomial.C (((L⁻¹ : Oˣ) : O) * ((u⁻¹ : Oˣ) : O)) * Polynomial.X,
            -Polynomial.C ((u⁻¹ : Oˣ) : O), 0, ?_⟩
          rw [Polynomial.derivative_sub, Polynomial.derivative_C, sub_zero,
            Polynomial.derivative_X_pow, pow_zero]
          obtain ⟨k, rfl⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by omega⟩
          have e1 : (((k + 1 : ℕ) : O)) = (L : O) := by rw [hL]
          have e2 : Polynomial.C (((k + 1 : ℕ) : O)) * Polynomial.C ((L⁻¹ : Oˣ) : O) = 1 := by
            rw [← Polynomial.C_mul, e1, Units.mul_inv, Polynomial.C_1]
          have e3 : Polynomial.C (u : O) * Polynomial.C ((u⁻¹ : Oˣ) : O) = 1 := by
            rw [← Polynomial.C_mul, Units.mul_inv, Polynomial.C_1]
          simp only [Nat.add_sub_cancel, Polynomial.C_mul]
          linear_combination (Polynomial.X ^ (k + 1) * Polynomial.C ((u⁻¹ : Oˣ) : O)) * e2 + e3 }
    have hroot : Pp.HasMap (AdjoinRoot.root (Polynomial.X ^ ℓ - Polynomial.C (u : O))) := by
      refine ⟨?_, ?_⟩
      · show Polynomial.aeval _ (Polynomial.X ^ ℓ - Polynomial.C (u : O)) = 0
        rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
      · show IsUnit (Polynomial.aeval _ (1 : Polynomial O))
        rw [map_one]; exact isUnit_one
    have hX : Polynomial.eval₂ (↑(Algebra.ofId O Pp.Ring)) Pp.X
        (Polynomial.X ^ ℓ - Polynomial.C (u : O)) = 0 := by
      have := (StandardEtalePair.hasMap_X (P := Pp)).1
      rw [Polynomial.aeval_def] at this
      exact this
    let inv : AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u : O)) →ₐ[O] Pp.Ring :=
      AdjoinRoot.liftAlgHom _ (Algebra.ofId O Pp.Ring) Pp.X hX
    have h1 : (Pp.lift _ hroot).comp inv = AlgHom.id O _ := by
      apply AdjoinRoot.algHom_ext
      simp only [AlgHom.comp_apply, inv, AdjoinRoot.liftAlgHom_root, StandardEtalePair.lift_X,
        AlgHom.id_apply]
    have h2 : inv.comp (Pp.lift _ hroot) = AlgHom.id O _ := by
      apply StandardEtalePair.hom_ext
      simp only [AlgHom.comp_apply, inv, AdjoinRoot.liftAlgHom_root, StandardEtalePair.lift_X,
        AlgHom.id_apply]
    have hbij : Function.Bijective (Pp.lift _ hroot) :=
      ⟨fun a b hab => by
        have := congrArg inv hab
        rwa [← AlgHom.comp_apply, h2, ← AlgHom.comp_apply, h2] at this,
       fun b => ⟨inv b, by rw [← AlgHom.comp_apply, h1, AlgHom.id_apply]⟩⟩
    haveI : Algebra.IsStandardEtale O (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u : O))) :=
      ⟨⟨⟨Pp, _, hroot, hbij⟩⟩⟩
    infer_instance

  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  obtain ⟨q', hq'⟩ : ∃ q' : PrimeSpectrum A₀, q' = q := ⟨q, rfl⟩
  subst hq'
  have hfq : f (σ q') = q' := by
    have h1 : (σ ≫ f) q' = (𝟙 (Spec (.of A₀)) : Spec (.of A₀) ⟶ _) q' := by rw [hσ]
    exact (Scheme.Hom.comp_apply σ f q').symm.trans h1
  obtain ⟨hdom, hic⟩ := hnorm (σ q')
  haveI := hdom
  haveI := hic
  haveI hufd : UniqueFactorizationMonoid (X.presheaf.stalk (σ q')) :=
    (hreg (σ q') (by rw [hfq]; exact hq)).2
  haveI : IsDiscreteValuationRing (Localization.AtPrime q'.asIdeal) := s1 A₀ q'.asIdeal hq
  obtain ⟨ρ, hρloc, hρ⟩ := s2 A₀ X σ q'
  set φ := Spec.preimage (X.fromSpecStalk (σ q') ≫ f) with hφ
  have hρφ : ρ.hom.comp φ.hom = algebraMap A₀ (Localization.AtPrime q'.asIdeal) := by
    have h1 : Spec.map (φ ≫ ρ) =
        Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime q'.asIdeal))) := by
      rw [Spec.map_comp, hφ, Spec.map_preimage, ← Category.assoc, hρ, Category.assoc, hσ,
        Category.comp_id]
    have h2 := Spec.map_injective h1
    exact congrArg CommRingCat.Hom.hom h2
  obtain ⟨ϖ₀, hπprime, hϖirr, hfact⟩ := s4 A₀ q'.asIdeal
    (X.presheaf.stalk (σ q')) φ.hom ρ.hom hρloc hρφ
  have hπ0 : φ.hom ϖ₀ ≠ 0 := hπprime.ne_zero

  obtain ⟨S, C, _, _, _, _, _, _, _, σC, e, he, hσ0, hσadd, hCet, hCfin, hCsurj, hCbij⟩ :=
    wc_fsa_stalk_torsor_ring A₀ X f ℓ P p α hP (σ q') ϖ₀ hdom hπ0 hfact
  obtain ⟨r, hr⟩ := hrex
  obtain ⟨ψ, hψ⟩ := s6 q' (σ q') ρ hρ r hr C e he
  haveI hSdom : IsDomain S := IsLocalization.Away.isDomain S hπ0
  haveI hSufd : UniqueFactorizationMonoid S :=
    UniqueFactorizationMonoid.of_isLocalization (Submonoid.powers (φ.hom ϖ₀)) S
  letI : Algebra K S :=
    ((algebraMap (X.presheaf.stalk (σ q')) S).comp (φ.hom.comp κ)).toAlgebra
  letI : Algebra K C := ((algebraMap S C).comp (algebraMap K S)).toAlgebra
  haveI : IsScalarTower K S C := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : NeZero (ℓ : K) := ⟨hℓK⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K ℓ

  obtain ⟨t, a, ht1, hta⟩ := wc_fsa_ufd_kummer_generator K ℓ hℓ ζ hζ S C
    σC hσ0 hσadd hCet hCfin hCsurj hCbij
  have hirr : Irreducible (ρ.hom (φ.hom ϖ₀)) := by
    have h : ρ.hom (φ.hom ϖ₀) = algebraMap A₀ (Localization.AtPrime q'.asIdeal) ϖ₀ := by
      rw [← hρφ]; rfl
    rw [h]
    exact hϖirr
  have hχ : (ψ.comp (algebraMap S C)).comp (algebraMap (X.presheaf.stalk (σ q')) S) =
      (algebraMap (Localization.AtPrime q'.asIdeal) (FractionRing A₀)).comp ρ.hom := by
    rw [RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq, hψ]
  have hs : (ψ t) ^ ℓ = (ψ.comp (algebraMap S C)) (a : S) := by
    rw [← map_pow, hta]
    rfl
  obtain ⟨w, b, hab⟩ := s10 (X.presheaf.stalk (σ q')) (φ.hom ϖ₀) hπprime S
    (Localization.AtPrime q'.asIdeal) (FractionRing A₀) ρ.hom hirr (ψ.comp (algebraMap S C)) hχ
    ℓ hℓ.pos a (ψ t) hs
  obtain ⟨t', ht'⟩ : ∃ t' : C, t' = t * algebraMap S C ((b⁻¹ : Sˣ) : S) := ⟨_, rfl⟩
  have hbb : (b : S) ^ ℓ * ((b⁻¹ : Sˣ) : S) ^ ℓ = 1 := by
    rw [← mul_pow, Units.mul_inv, one_pow]
  have ht'ℓ : t' ^ ℓ =
      algebraMap (X.presheaf.stalk (σ q')) C (w : X.presheaf.stalk (σ q')) := by
    rw [ht', mul_pow, hta, ← map_pow, ← map_mul, hab, mul_assoc, hbb, mul_one,
      ← IsScalarTower.algebraMap_apply]
  have hteig : ∀ h : ZMod ℓ, σC h t = algebraMap K C (ζ ^ h.val) * t :=
    seig K ℓ ζ S C σC hσ0 hσadd t ht1
  have ht'eig : ∀ h : ZMod ℓ, σC h t' = algebraMap K C (ζ ^ h.val) * t' := by
    intro h
    rw [ht', map_mul, AlgHom.commutes, hteig h, mul_assoc]
  have ht'ℓS : t' ^ ℓ = algebraMap S C
      ((Units.map (algebraMap (X.presheaf.stalk (σ q')) S).toMonoidHom w : Sˣ) : S) :=
    ht'ℓ.trans (IsScalarTower.algebraMap_apply _ S C _)

  obtain ⟨hinj, hspan⟩ := wc_fsa_kummer_span K ℓ hℓ ζ hζ S C σC hσ0 hσadd hCet hCsurj hCbij t'
    _ ht'eig ht'ℓS
  have hℓO : IsUnit (ℓ : X.presheaf.stalk (σ q')) := by
    have h2 := hℓK.isUnit.map (φ.hom.comp κ)
    rwa [map_natCast] at h2

  obtain ⟨eqv⟩ := wc_fsa_kummer_integral_closure (X.presheaf.stalk (σ q')) (φ.hom ϖ₀) hπ0 S C K
    ℓ hℓ hℓO ζ hζ σC t' w ht'eig ht'ℓ hinj hspan
  haveI := s12 (X.presheaf.stalk (σ q')) ℓ hℓ.pos hℓO w
  have hEt : Algebra.Etale (X.presheaf.stalk (σ q'))
      (integralClosure (X.presheaf.stalk (σ q')) C) := Algebra.Etale.of_equiv eqv
  haveI : IsFinite p := hP.finite
  haveI : IsAffineHom (Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback f
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))).flip
      inferInstance
  haveI : IsAffineHom (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := inferInstance

  exact wc_fsa_normalization_stalk_etale _ (σ q') C e he hEt

theorem wc_fcg_height_one_uniformizer : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (𝔭 : Ideal A₀) [𝔭.IsPrime], 𝔭.height = 1 → ∃ ϖ : A₀, ϖ ∈ 𝔭 ∧ ϖ ≠ 0 ∧ ∀ a : A₀, a ≠ 0 → ∃ (n : ℕ) (s r : A₀), s ∉ 𝔭 ∧ r ∉ 𝔭 ∧ s * a = ϖ ^ n * r :=
by
  intro A₀ _ _ _ _ 𝔭 _ h
  haveI : IsIntegrallyClosed (Localization.AtPrime 𝔭) :=
    isIntegrallyClosed_of_isLocalization (Localization.AtPrime 𝔭) 𝔭.primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
  have hdim : ringKrullDim (Localization.AtPrime 𝔭) = 1 := by
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height 𝔭 (Localization.AtPrime 𝔭), h]
    rfl
  have hnf : ¬ IsField (Localization.AtPrime 𝔭) := by
    intro hf
    have h0 := ringKrullDim_eq_zero_of_isField hf
    rw [hdim] at h0
    exact zero_ne_one h0.symm
  haveI : Ring.KrullDimLE 1 (Localization.AtPrime 𝔭) := by
    rw [Ring.krullDimLE_iff, hdim]; exact le_of_eq rfl
  have hmax : ∀ I : Ideal (Localization.AtPrime 𝔭), I ≠ ⊥ → I.IsPrime → I.IsMaximal :=
    Ring.krullDimLE_one_iff_of_noZeroDivisors.mp inferInstance
  have huniq : ∃! P : Ideal (Localization.AtPrime 𝔭), P ≠ ⊥ ∧ P.IsPrime := by
    refine ⟨IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭), ⟨?_, inferInstance⟩, ?_⟩
    · intro h0
      exact hnf (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h0)
    · rintro Q ⟨hQ0, hQp⟩
      exact IsLocalRing.eq_maximalIdeal (hmax Q hQ0 hQp)
  have htfae := (IsDiscreteValuationRing.TFAE (Localization.AtPrime 𝔭) hnf).out 1 4
  haveI hdvr : IsDiscreteValuationRing (Localization.AtPrime 𝔭) :=
    htfae.mpr ⟨inferInstance, huniq⟩
  have hinj : Function.Injective (algebraMap A₀ (Localization.AtPrime 𝔭)) :=
    IsLocalization.injective (Localization.AtPrime 𝔭) (Ideal.primeCompl_le_nonZeroDivisors 𝔭)
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible (Localization.AtPrime 𝔭)
  obtain ⟨⟨x, t⟩, hxt⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl π
  have hspec : π * algebraMap A₀ (Localization.AtPrime 𝔭) t =
      algebraMap A₀ (Localization.AtPrime 𝔭) x := by
    rw [← hxt]
    exact IsLocalization.mk'_spec (Localization.AtPrime 𝔭) x t
  have hirr : Irreducible (algebraMap A₀ (Localization.AtPrime 𝔭) x) := by
    rw [← hspec]
    exact (irreducible_mul_isUnit (IsLocalization.map_units (Localization.AtPrime 𝔭) t)).mpr hπ
  refine ⟨x, ?_, ?_, ?_⟩
  · by_contra hx
    exact hirr.not_isUnit
      ((IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime 𝔭) 𝔭 x).mpr hx)
  · rintro rfl
    exact hirr.ne_zero (map_zero _)
  · intro a ha
    have ha' : algebraMap A₀ (Localization.AtPrime 𝔭) a ≠ 0 :=
      fun h0 => ha (hinj (h0.trans (map_zero _).symm))
    obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha' hirr
    obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.mk'_surjective 𝔭.primeCompl (u : Localization.AtPrime 𝔭)
    change IsLocalization.mk' (Localization.AtPrime 𝔭) r s = (u : Localization.AtPrime 𝔭) at hrs
    have hr : r ∉ 𝔭 := by
      have hU : IsUnit (IsLocalization.mk' (Localization.AtPrime 𝔭) r s) := by
        rw [hrs]; exact u.isUnit
      exact (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime 𝔭) 𝔭 r s).mp hU
    refine ⟨n, s, r, s.2, hr, ?_⟩
    apply hinj
    have hs := IsLocalization.mk'_spec (Localization.AtPrime 𝔭) r s
    rw [hrs] at hs
    simp only [map_mul, map_pow]
    rw [hu, ← hs]
    ring

theorem wc_fcg_stalk_uniformizer_prime : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) [Smooth f] (y : X) (ϖ : A₀), ϖ ∈ (f y).asIdeal → ϖ ≠ 0 → (∀ a : A₀, a ≠ 0 → ∃ (n : ℕ) (s r : A₀), s ∉ (f y).asIdeal ∧ r ∉ (f y).asIdeal ∧ s * a = ϖ ^ n * r) → Prime (((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm y).hom ϖ) ∧ ∀ s : A₀, s ∉ (f y).asIdeal → IsUnit (((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm y).hom s) :=
by
  have core : ∀ (A B O : Type u) [CommRing A] [IsDomain A] [CommRing B] [CommRing O] [Algebra A B]
      [Algebra.Smooth A B] [Algebra B O] (p : Ideal B) [p.IsPrime] [IsLocalization.AtPrime O p] (ϖ : A),
      ϖ ∈ Ideal.comap (algebraMap A B) p → ϖ ≠ 0 →
      (∀ a : A, a ≠ 0 → ∃ (n : ℕ) (s r : A), s ∉ Ideal.comap (algebraMap A B) p ∧
        r ∉ Ideal.comap (algebraMap A B) p ∧ s * a = ϖ ^ n * r) →
      Prime (algebraMap B O (algebraMap A B ϖ)) := by
    intro A B O _ _ _ _ _ _ _ p _ _ ϖ hϖP hϖ0 hϖ
    classical

    have hdomain : ∀ (k C : Type u) [Field k] [CommRing C] [Algebra k C] [Algebra.Smooth k C]
        (q : Ideal C) [q.IsPrime], IsDomain (Localization.AtPrime q) := by
      intro k C _ _ _ _ q hqP
      haveI : Smooth (Spec.map (CommRingCat.ofHom (algebraMap k C))) := by
        rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
        exact RingHom.smooth_algebraMap.mpr inferInstance
      have hD := (wc_fntame_smooth_stalk_normal k (Spec (.of C))
        (Spec.map (CommRingCat.ofHom (algebraMap k C))) (⟨q, hqP⟩ : PrimeSpectrum C)).1
      let e : Localization.AtPrime q ≃+* ↑((Spec (CommRingCat.of C)).presheaf.stalk
          (⟨q, hqP⟩ : PrimeSpectrum C)) :=
        (StructureSheaf.stalkIso C (⟨q, hqP⟩ : PrimeSpectrum C)).toRingEquiv
      exact @MulEquiv.isDomain _ _ _ _ hD e.toMulEquiv
    have hunitO : ∀ t : B, t ∉ p → IsUnit (algebraMap B O t) := fun t ht =>
      (IsLocalization.AtPrime.isUnit_to_map_iff O p t).mpr ht

    have hne : algebraMap B O (algebraMap A B ϖ) ≠ 0 := by
      letI : Algebra A O := ((algebraMap B O).comp (algebraMap A B)).toAlgebra
      haveI : IsScalarTower A B O := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      haveI : Module.Flat B O := IsLocalization.flat O p.primeCompl
      haveI : Module.Flat A O := Module.Flat.trans A B O
      have hreg : IsSMulRegular O ϖ :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hϖ0)
      haveI : IsLocalRing O := IsLocalization.AtPrime.isLocalRing O p
      intro h
      apply one_ne_zero (α := O)
      apply hreg
      show ϖ • (1 : O) = ϖ • (0 : O)
      rw [smul_zero, Algebra.smul_def, mul_one]
      exact h

    have hspan : Ideal.map ((algebraMap B O).comp (algebraMap A B)) (Ideal.comap (algebraMap A B) p) =
        Ideal.span {algebraMap B O (algebraMap A B ϖ)} := by
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [Ideal.mem_comap]
        by_cases ha0 : a = 0
        · rw [ha0, map_zero]; exact Ideal.zero_mem _
        obtain ⟨n, s, r, hs, hr, hsar⟩ := hϖ a ha0
        cases n with
        | zero =>
          exfalso; apply hr
          rw [pow_zero, one_mul] at hsar
          rw [← hsar]; exact Ideal.mul_mem_left _ _ ha
        | succ m =>
          obtain ⟨w, hw⟩ := (hunitO _ hs).exists_left_inv
          rw [Ideal.mem_span_singleton']
          refine ⟨w * algebraMap B O (algebraMap A B r) * algebraMap B O (algebraMap A B ϖ) ^ m, ?_⟩
          have h2 := congrArg (fun z => algebraMap B O (algebraMap A B z)) hsar
          simp only [map_mul, map_pow] at h2
          rw [RingHom.comp_apply]
          calc w * algebraMap B O (algebraMap A B r) * algebraMap B O (algebraMap A B ϖ) ^ m *
                algebraMap B O (algebraMap A B ϖ)
              = w * (algebraMap B O (algebraMap A B ϖ) ^ (m + 1) *
                  algebraMap B O (algebraMap A B r)) := by
                ring
            _ = w * (algebraMap B O (algebraMap A B s) * algebraMap B O (algebraMap A B a)) := by
                rw [h2]
            _ = (w * algebraMap B O (algebraMap A B s)) * algebraMap B O (algebraMap A B a) := by ring
            _ = algebraMap B O (algebraMap A B a) := by rw [hw, one_mul]
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.mem_map_of_mem _ hϖP

    have hprime : (Ideal.map ((algebraMap B O).comp (algebraMap A B))
        (Ideal.comap (algebraMap A B) p)).IsPrime := by
      set Pc := Ideal.comap (algebraMap A B) p with hPc
      let θ : B →ₐ[A] TensorProduct A Pc.ResidueField B := Algebra.TensorProduct.includeRight
      have hθA : ∀ s : A, θ (algebraMap A B s) =
          algebraMap A (TensorProduct A Pc.ResidueField B) s := fun s => θ.commutes s

      have hden : ∀ c : TensorProduct A Pc.ResidueField B, ∃ s : A, s ∉ Pc ∧ ∃ b : B,
          algebraMap A (TensorProduct A Pc.ResidueField B) s * c = θ b := by
        intro c
        induction c using TensorProduct.induction_on with
        | zero =>
          exact ⟨1, Ideal.ne_top_iff_one _ |>.mp (Ideal.IsPrime.ne_top inferInstance), 0,
            by rw [mul_zero, map_zero]⟩
        | tmul x b₀ =>
          obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective x
          obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective Pc.primeCompl z
          refine ⟨s, s.2, algebraMap A B a * b₀, ?_⟩
          have hκ : algebraMap A Pc.ResidueField s *
              IsLocalRing.residue _ (IsLocalization.mk' (Localization.AtPrime Pc) a s) =
              algebraMap A Pc.ResidueField a := by
            rw [IsScalarTower.algebraMap_apply A (Localization.AtPrime Pc) Pc.ResidueField,
              IsScalarTower.algebraMap_apply A (Localization.AtPrime Pc) Pc.ResidueField a,
              IsLocalRing.ResidueField.algebraMap_eq, ← map_mul, IsLocalization.mk'_spec']
          rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul, one_mul, hκ]
          show _ = (1 : Pc.ResidueField) ⊗ₜ[A] (algebraMap A B a * b₀)
          rw [Algebra.algebraMap_eq_smul_one (A := Pc.ResidueField), TensorProduct.smul_tmul,
            Algebra.smul_def]
        | add c₁ c₂ h₁ h₂ =>
          obtain ⟨s₁, hs₁, b₁, e₁⟩ := h₁
          obtain ⟨s₂, hs₂, b₂, e₂⟩ := h₂
          refine ⟨s₁ * s₂, Ideal.IsPrime.mul_notMem inferInstance hs₁ hs₂,
            algebraMap A B s₂ * b₁ + algebraMap A B s₁ * b₂, ?_⟩
          simp only [map_add, map_mul, hθA]
          rw [← e₁, ← e₂]
          ring

      have hker : ∀ b : B, θ b = 0 → ∃ s : A, s ∉ Pc ∧
          algebraMap A B s * b ∈ Ideal.map (algebraMap A B) Pc := by
        intro b hb
        let I := Ideal.map (algebraMap A B) Pc
        let M : Submonoid (B ⧸ I) :=
          Submonoid.map ((Ideal.Quotient.mk I).comp (algebraMap A B)) Pc.primeCompl
        have halg : ∀ a : A, algebraMap A (Localization M) a =
            algebraMap (B ⧸ I) (Localization M) (Ideal.Quotient.mk I (algebraMap A B a)) := by
          intro a
          rw [IsScalarTower.algebraMap_apply A (B ⧸ I) (Localization M), Ideal.Quotient.mk_algebraMap]
        have h1 : Pc ≤ RingHom.ker (Algebra.ofId A (Localization M)) := by
          intro a ha
          rw [RingHom.mem_ker]
          show algebraMap A (Localization M) a = 0
          rw [halg, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha), map_zero]
        have h2 : Pc.primeCompl ≤ Submonoid.comap (Algebra.ofId A (Localization M))
            (IsUnit.submonoid (Localization M)) := by
          intro s hs
          show IsUnit (algebraMap A (Localization M) s)
          rw [halg]
          exact IsLocalization.map_units (Localization M)
            (⟨Ideal.Quotient.mk I (algebraMap A B s), Submonoid.mem_map_of_mem _ hs⟩ : M)
        let fκ : Pc.ResidueField →ₐ[A] Localization M :=
          Ideal.ResidueField.liftₐ Pc (Algebra.ofId A (Localization M)) h1 h2
        let g : B →ₐ[A] Localization M :=
          (IsScalarTower.toAlgHom A (B ⧸ I) (Localization M)).comp (Ideal.Quotient.mkₐ A I)
        let G := Algebra.TensorProduct.lift fκ g (fun _ _ => Commute.all _ _)
        have hG : G (θ b) = algebraMap (B ⧸ I) (Localization M) (Ideal.Quotient.mk I b) := by
          show G (1 ⊗ₜ b) = _
          rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
          rfl
        rw [hb, map_zero] at hG
        obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff M (Localization M) _).mp hG.symm
        obtain ⟨s, hs, hsm⟩ := Submonoid.mem_map.mp m.2
        refine ⟨s, hs, ?_⟩
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
        rw [← hsm] at hm
        exact hm

      let Lp : TensorProduct A Pc.ResidueField B →ₐ[A] p.ResidueField :=
        Algebra.TensorProduct.lift (Ideal.ResidueField.mapₐ Pc p (Algebra.ofId A B) rfl)
          (IsScalarTower.toAlgHom A B p.ResidueField) (fun _ _ => Commute.all _ _)
      have hLp : ∀ b, Lp (θ b) = algebraMap B p.ResidueField b := by
        intro b
        show Lp (1 ⊗ₜ b) = _
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      let q : Ideal (TensorProduct A Pc.ResidueField B) := RingHom.ker Lp
      haveI hq : q.IsPrime := RingHom.ker_isPrime Lp
      have hqp : ∀ b, θ b ∈ q ↔ b ∈ p := by
        intro b
        rw [RingHom.mem_ker, hLp, Ideal.algebraMap_residueField_eq_zero]
      haveI : IsDomain (Localization.AtPrime q) := hdomain Pc.ResidueField _ q
      have hg : ∀ t : p.primeCompl,
          IsUnit (((algebraMap _ (Localization.AtPrime q)).comp θ.toRingHom) t) := by
        intro t
        exact IsLocalization.map_units (Localization.AtPrime q)
          (⟨θ t, (hqp t).not.mpr t.2⟩ : q.primeCompl)
      let ψ : O →+* Localization.AtPrime q := IsLocalization.lift (M := p.primeCompl) (S := O) hg
      have hψ : ∀ b, ψ (algebraMap B O b) = algebraMap _ (Localization.AtPrime q) (θ b) :=
        fun b => IsLocalization.lift_eq hg b
      have hker_eq : Ideal.map ((algebraMap B O).comp (algebraMap A B)) Pc = RingHom.ker ψ := by
        apply le_antisymm
        · rw [Ideal.map_le_iff_le_comap]
          intro a ha
          rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply, hψ, hθA,
            Algebra.TensorProduct.algebraMap_apply,
            (Ideal.algebraMap_residueField_eq_zero).mpr ha, TensorProduct.zero_tmul, map_zero]
        · intro z hz
          rw [RingHom.mem_ker] at hz
          obtain ⟨⟨b, t⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl z
          have hzt := IsLocalization.mk'_spec O b t
          have h1 : algebraMap _ (Localization.AtPrime q) (θ b) = 0 := by
            rw [← hψ, ← hzt, map_mul, hz, zero_mul]
          obtain ⟨m, hmb⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl _ _).mp h1
          obtain ⟨s₀, hs₀, b₁, e₁⟩ := hden (m : TensorProduct A Pc.ResidueField B)
          have hb₁ : b₁ ∉ p := by
            rw [← hqp, ← e₁, ← hθA]
            exact hq.mul_notMem ((hqp _).not.mpr hs₀) m.2
          have h2 : θ (b₁ * b) = 0 := by
            rw [map_mul, ← e₁, mul_assoc, hmb, mul_zero]
          obtain ⟨s₁, hs₁, hmem⟩ := hker (b₁ * b) h2
          have hu : IsUnit (algebraMap B O (algebraMap A B s₁ * b₁)) :=
            hunitO _ (Ideal.IsPrime.mul_notMem inferInstance hs₁ hb₁)
          have hbmem : algebraMap B O b ∈
              Ideal.map ((algebraMap B O).comp (algebraMap A B)) Pc := by
            have h3 : algebraMap B O (algebraMap A B s₁ * (b₁ * b)) ∈
                Ideal.map ((algebraMap B O).comp (algebraMap A B)) Pc := by
              rw [← Ideal.map_map]
              exact Ideal.mem_map_of_mem _ hmem
            rw [← mul_assoc, map_mul] at h3
            exact (Ideal.unit_mul_mem_iff_mem _ hu).mp h3
          rw [← hzt] at hbmem
          exact (Ideal.mul_unit_mem_iff_mem _ (hunitO _ t.2)).mp hbmem
      rw [hker_eq]
      exact RingHom.ker_isPrime ψ
    rw [hspan] at hprime
    exact (Ideal.span_singleton_prime hne).mp hprime
  intro A₀ _ _ X f _ y ϖ hϖ𝔭 hϖ0 hϖ
  classical

  have hF : X.fromSpecStalk y ≫ f = Spec.map ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫
      f.appTop ≫ X.presheaf.Γgerm y) := by
    have e1 : (Spec (CommRingCat.of A₀)).toSpecΓ ≫
        Spec.map (Scheme.ΓSpecIso (CommRingCat.of A₀)).inv = 𝟙 _ := by
      rw [← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
    calc X.fromSpecStalk y ≫ f
        = X.fromSpecStalk y ≫ f ≫ (Spec (CommRingCat.of A₀)).toSpecΓ ≫
            Spec.map (Scheme.ΓSpecIso (CommRingCat.of A₀)).inv := by
          rw [e1, Category.comp_id]
      _ = (X.fromSpecStalk y ≫ X.toSpecΓ) ≫ Spec.map f.appTop ≫
            Spec.map (Scheme.ΓSpecIso (CommRingCat.of A₀)).inv := by
          rw [← Category.assoc f, Scheme.toSpecΓ_naturality]
          simp only [Category.assoc]
      _ = _ := by
          rw [Scheme.fromSpecStalk_toSpecΓ]
          simp only [Spec.map_comp, Category.assoc]
          try rfl

  obtain ⟨V, hV, hyV, -⟩ :=
    exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := y) trivial
  have e : V ≤ f ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  have hsm := (smooth_iff f).mp ‹_› (isAffineOpen_top (Spec (.of A₀))) hV e
  let e' : A₀ ≃+* Γ(Spec (.of A₀), ⊤) :=
    Iso.commRingCatIsoToRingEquiv (Scheme.ΓSpecIso (CommRingCat.of A₀)).symm
  have he' : (e'.toRingHom).Smooth := RingHom.Smooth.of_bijective e'.bijective
  let φ0 : A₀ →+* Γ(X, V) := (Scheme.Hom.appLE f ⊤ V e).hom.comp e'.toRingHom
  have hφ0 : φ0.Smooth := RingHom.Smooth.comp he' hsm
  letI : Algebra A₀ Γ(X, V) := φ0.toAlgebra
  haveI : Algebra.Smooth A₀ Γ(X, V) := RingHom.Smooth.toAlgebra hφ0
  letI : Algebra Γ(X, V) (X.presheaf.stalk y) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨y, hyV⟩ : V)
  have hcomp : ∀ a : A₀, algebraMap Γ(X, V) (X.presheaf.stalk y) (algebraMap A₀ Γ(X, V) a) =
      ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm y).hom a := by
    intro a
    change (X.presheaf.germ V y hyV).hom ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
      (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv.hom a))) =
      (X.presheaf.germ ⊤ y trivial).hom
        (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv.hom a))
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (le_top : V ≤ ⊤)) y hyV _
  generalize hφ : ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫
    X.presheaf.Γgerm y) = φ at hF hcomp ⊢

  have hm : Ideal.comap φ.hom (IsLocalRing.maximalIdeal (X.presheaf.stalk y)) = (f y).asIdeal := by
    obtain ⟨c, hc⟩ : ∃ c : Spec (X.presheaf.stalk y),
        c = IsLocalRing.closedPoint (X.presheaf.stalk y) := ⟨_, rfl⟩
    have hyc : X.fromSpecStalk y c = y := by rw [hc]; exact Scheme.fromSpecStalk_closedPoint
    have hy : f y = (Spec.map φ) c := by
      calc f y = f (X.fromSpecStalk y c) := by rw [hyc]
        _ = (X.fromSpecStalk y ≫ f) c := by rw [Scheme.Hom.comp_apply]
        _ = (Spec.map φ) c := by rw [hF]
    have hm' : ((Spec.map φ) c).asIdeal =
        Ideal.comap φ.hom (IsLocalRing.maximalIdeal (X.presheaf.stalk y)) := by
      subst hc
      rfl
    rw [hy, hm']
  have hunit : ∀ s : A₀, s ∉ (f y).asIdeal → IsUnit (φ.hom s) := by
    intro s hs
    rw [← hm, Ideal.mem_comap] at hs
    exact IsLocalRing.notMem_maximalIdeal.mp hs

  let p := (hV.primeIdealOf ⟨y, hyV⟩).asIdeal
  haveI hp : p.IsPrime := (hV.primeIdealOf ⟨y, hyV⟩).isPrime
  haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk y) p := hV.isLocalization_stalk ⟨y, hyV⟩
  have hφeq : φ.hom = (algebraMap Γ(X, V) (X.presheaf.stalk y)).comp (algebraMap A₀ Γ(X, V)) :=
    RingHom.ext (fun a => (hcomp a).symm)
  have h𝔭 : Ideal.comap (algebraMap A₀ Γ(X, V)) p = (f y).asIdeal := by
    rw [← hm, hφeq, ← Ideal.comap_comap]
    congr 1
    exact (IsLocalization.AtPrime.under_maximalIdeal (X.presheaf.stalk y) p).symm
  have hϖP : ϖ ∈ Ideal.comap (algebraMap A₀ Γ(X, V)) p := by rw [h𝔭]; exact hϖ𝔭
  have hϖ' : ∀ a : A₀, a ≠ 0 → ∃ (n : ℕ) (s r : A₀), s ∉ Ideal.comap (algebraMap A₀ Γ(X, V)) p ∧
      r ∉ Ideal.comap (algebraMap A₀ Γ(X, V)) p ∧ s * a = ϖ ^ n * r := by
    rw [h𝔭]; exact hϖ

  refine ⟨?_, hunit⟩
  rw [← hcomp]
  exact core A₀ Γ(X, V) (X.presheaf.stalk y) p ϖ hϖP hϖ0 hϖ'

theorem wc_fcg_normalization_stalk_model : ∀ (X P : Scheme.{u}) (g : P ⟶ X) [QuasiCompact g] [QuasiSeparated g], IsAffineHom g → ∀ (x : X), letI : Algebra (X.presheaf.stalk x) Γ(Limits.pullback g (X.fromSpecStalk x), ⊤) := ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫ (Limits.pullback.snd g (X.fromSpecStalk x)).appTop).hom.toAlgebra; ∃ e : Limits.pullback (Scheme.Hom.fromNormalization g) (X.fromSpecStalk x) ≅ Spec (.of (integralClosure (X.presheaf.stalk x) Γ(Limits.pullback g (X.fromSpecStalk x), ⊤))), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) (integralClosure (X.presheaf.stalk x) Γ(Limits.pullback g (X.fromSpecStalk x), ⊤)))) = Limits.pullback.snd (Scheme.Hom.fromNormalization g) (X.fromSpecStalk x) :=
by
  intro X P g _ _ hgaff x
  letI iZ : Algebra (X.presheaf.stalk x) Γ(Limits.pullback g (X.fromSpecStalk x), ⊤) :=
    ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
      (Limits.pullback.snd g (X.fromSpecStalk x)).appTop).hom.toAlgebra
  haveI : IsAffineHom g := hgaff

  obtain ⟨U, hU, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
    (show x ∈ (⊤ : X.Opens) from trivial)
  have hU : IsAffineOpen U := hU
  letI iB : Algebra Γ(X, U) Γ(P, g ⁻¹ᵁ U) := (g.app U).hom.toAlgebra
  letI iO : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hxU).hom.toAlgebra
  haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x) (hU.primeIdealOf ⟨x, hxU⟩).asIdeal :=
    hU.isLocalization_stalk ⟨x, hxU⟩

  have s1 : ∀ {Z : Scheme.{u}} (ν : Z ⟶ X) (C : Type u) [CommRing C] [Algebra Γ(X, U) C]
      (i : Spec (.of C) ⟶ Z),
      IsPullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) C))) i hU.fromSpec ν →
      ∃ e : Limits.pullback ν (X.fromSpecStalk x) ≅
          Spec (.of (TensorProduct Γ(X, U) (X.presheaf.stalk x) C)),
        e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
          (TensorProduct Γ(X, U) (X.presheaf.stalk x) C))) =
          Limits.pullback.snd ν (X.fromSpecStalk x) := by
    intro Z ν C _ _ i H₁
    have H₂ := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct Γ(X, U) (X.presheaf.stalk x) C)
    have H := H₂.flip.paste_horiz H₁.flip
    have hb : Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) (X.presheaf.stalk x))) ≫
        hU.fromSpec = X.fromSpecStalk x := by
      rw [← hU.fromSpecStalk_eq_fromSpecStalk hxU]; rfl
    rw [hb] at H
    refine ⟨H.isoPullback.symm, ?_⟩
    rw [Iso.symm_hom]
    exact H.isoPullback_inv_snd

  have s4 : ∀ (T : Type u) [CommRing T] [Algebra (X.presheaf.stalk x) T]
      (e : Limits.pullback g (X.fromSpecStalk x) ≅ Spec (.of T)),
      e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) T)) =
        Limits.pullback.snd g (X.fromSpecStalk x) →
      Nonempty (T ≃ₐ[X.presheaf.stalk x] Γ(Limits.pullback g (X.fromSpecStalk x), ⊤)) := by
    intro T _ _ e he
    let ρ : CommRingCat.of T ≅ Γ(Limits.pullback g (X.fromSpecStalk x), ⊤) :=
      (Scheme.ΓSpecIso (CommRingCat.of T)).symm ≪≫ Scheme.Γ.mapIso e.op
    have hρ : ρ.hom = (Scheme.ΓSpecIso (CommRingCat.of T)).inv ≫ e.hom.appTop := rfl
    have key : CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) T) ≫ ρ.hom =
        (Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
          (Limits.pullback.snd g (X.fromSpecStalk x)).appTop := by
      rw [hρ, ← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc,
        ← Scheme.Hom.comp_appTop, he]
      rfl
    let r : T ≃+* Γ(Limits.pullback g (X.fromSpecStalk x), ⊤) := ρ.commRingCatIsoToRingEquiv
    refine ⟨AlgEquiv.ofRingEquiv (f := r) ?_⟩
    intro o
    exact congrArg (fun f => CommRingCat.Hom.hom f o) key

  have H₁ : IsPullback (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U) Γ(P, g ⁻¹ᵁ U))))
      (hU.preimage g).fromSpec hU.fromSpec g := by
    refine IsOpenImmersion.isPullback _ _ _ _ ?_ ?_
    · have hφ : CommRingCat.ofHom (algebraMap Γ(X, U) Γ(P, g ⁻¹ᵁ U)) =
          g.appLE U (g ⁻¹ᵁ U) le_rfl := by
        rw [← Scheme.Hom.app_eq_appLE]; rfl
      rw [hφ]
      exact (IsAffineOpen.SpecMap_appLE_fromSpec g hU (hU.preimage g) le_rfl).symm
    · rw [hU.opensRange_fromSpec, (hU.preimage g).opensRange_fromSpec]

  obtain ⟨e₁, he₁⟩ := s1 g Γ(P, g ⁻¹ᵁ U) (hU.preimage g).fromSpec H₁
  obtain ⟨ε⟩ := s4 _ e₁ he₁

  let κ := AlgEquiv.ofBijective
    (TensorProduct.toIntegralClosure Γ(X, U) (X.presheaf.stalk x) Γ(P, g ⁻¹ᵁ U))
    (TensorProduct.toIntegralClosure_bijective_of_isLocalization (B := Γ(P, g ⁻¹ᵁ U))
      (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl)
  let θ := κ.trans ε.mapIntegralClosure

  have hoi : IsOpenImmersion (g.normalizationOpenCover.f ⟨U, hU⟩) :=
    g.normalizationOpenCover.map_prop ⟨U, hU⟩
  letI hAI : Algebra Γ(X, U) (integralClosure Γ(X, U) Γ(P, g ⁻¹ᵁ U)) := inferInstance
  have H₂ : IsPullback (Spec.map (CommRingCat.ofHom
      (algebraMap Γ(X, U) (integralClosure Γ(X, U) Γ(P, g ⁻¹ᵁ U)))))
      (g.normalizationOpenCover.f ⟨U, hU⟩) hU.fromSpec g.fromNormalization := by
    refine @IsOpenImmersion.isPullback _ _ _ _ _ _ _ _ hoi _ ?_ ?_
    · exact Scheme.Hom.ι_fromNormalization g ⟨U, hU⟩
    · rw [hU.opensRange_fromSpec]; exact Scheme.Hom.fromNormalization_preimage g ⟨U, hU⟩
  obtain ⟨e₂, he₂⟩ := @s1 _ g.fromNormalization (integralClosure Γ(X, U) Γ(P, g ⁻¹ᵁ U)) _ hAI
    (g.normalizationOpenCover.f ⟨U, hU⟩) H₂

  let α := θ.toRingEquiv.toCommRingCatIso
  have hα : CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
      (integralClosure (X.presheaf.stalk x) Γ(Limits.pullback g (X.fromSpecStalk x), ⊤))) ≫ α.inv =
      CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
        (TensorProduct Γ(X, U) (X.presheaf.stalk x) (integralClosure Γ(X, U) Γ(P, g ⁻¹ᵁ U)))) := by
    ext o
    exact θ.symm.commutes o
  refine ⟨e₂ ≪≫ (Scheme.Spec.mapIso α.op).symm, ?_⟩
  change (e₂.hom ≫ Spec.map α.inv) ≫ _ = _
  rw [Category.assoc, ← Spec.map_comp, hα, he₂]

theorem wc_fcg_generic_stalk_torsor_ring : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (ℓ : ℕ) [NeZero ℓ] (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∀ (x : X) (ϖ : A₀), ϖ ∈ (f x).asIdeal → ϖ ≠ 0 → (∀ a : A₀, a ≠ 0 → ∃ (n : ℕ) (s r : A₀), s ∉ (f x).asIdeal ∧ r ∉ (f x).asIdeal ∧ s * a = ϖ ^ n * r) → letI : Algebra (X.presheaf.stalk x) Γ(Limits.pullback (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk x), ⊤) := ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫ (Limits.pullback.snd (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk x)).appTop).hom.toAlgebra; ∃ (C : Type u) (_ : CommRing C) (_ : Algebra (Localization.Away (((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom ϖ)) C) (_ : Algebra (X.presheaf.stalk x) C) (_ : IsScalarTower (X.presheaf.stalk x) (Localization.Away (((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom ϖ)) C) (σ : ZMod ℓ → (C →ₐ[Localization.Away (((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom ϖ)] C)), σ 0 = AlgHom.id _ C ∧ (∀ c c', σ (c + c') = (σ c).comp (σ c')) ∧ Algebra.Etale (Localization.Away (((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom ϖ)) C ∧ Module.Finite (Localization.Away (((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom ϖ)) C ∧ Function.Surjective (PrimeSpectrum.comap (algebraMap (Localization.Away (((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom ϖ)) C)) ∧ Function.Bijective (wcTorDescMu (Localization.Away (((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom ϖ)) C ℓ σ) ∧ Nonempty (Γ(Limits.pullback (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk x), ⊤) ≃ₐ[X.presheaf.stalk x] C) :=
by
  intro A₀ _ _ X f P p ℓ _ α hP x ϖ hϖ𝔭 hϖ0 hϖ

  have hF : X.fromSpecStalk x ≫ f = Spec.map ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫
      f.appTop ≫ X.presheaf.Γgerm x) := by
    have e1 : (Spec (CommRingCat.of A₀)).toSpecΓ ≫
        Spec.map (Scheme.ΓSpecIso (CommRingCat.of A₀)).inv = 𝟙 _ := by
      first
        | rw [← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
        | rw [SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
    calc X.fromSpecStalk x ≫ f
        = X.fromSpecStalk x ≫ f ≫ (Spec (CommRingCat.of A₀)).toSpecΓ ≫
            Spec.map (Scheme.ΓSpecIso (CommRingCat.of A₀)).inv := by
          rw [e1, Category.comp_id]
      _ = (X.fromSpecStalk x ≫ X.toSpecΓ) ≫ Spec.map f.appTop ≫
            Spec.map (Scheme.ΓSpecIso (CommRingCat.of A₀)).inv := by
          rw [← Category.assoc f, Scheme.toSpecΓ_naturality]
          simp only [Category.assoc]
      _ = _ := by
          rw [Scheme.fromSpecStalk_toSpecΓ]
          simp only [Spec.map_comp, Category.assoc]
          try rfl
  generalize hφ : ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫
    X.presheaf.Γgerm x) = φ at hF ⊢

  have hunit : ∀ s : A₀, s ∉ (f x).asIdeal → IsUnit (φ.hom s) := by
    intro s hs
    obtain ⟨c, hc⟩ : ∃ c : Spec (X.presheaf.stalk x),
        c = IsLocalRing.closedPoint (X.presheaf.stalk x) := ⟨_, rfl⟩
    have hxc : X.fromSpecStalk x c = x := by rw [hc]; exact Scheme.fromSpecStalk_closedPoint
    have hx : f x = (Spec.map φ) c := by
      calc f x = f (X.fromSpecStalk x c) := by rw [hxc]
        _ = (X.fromSpecStalk x ≫ f) c := by rw [Scheme.Hom.comp_apply]
        _ = (Spec.map φ) c := by rw [hF]
    have hm : ((Spec.map φ) c).asIdeal =
        Ideal.comap φ.hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) := by
      subst hc
      first
        | rfl
        | (rw [Spec.map_apply]; rfl)
    rw [hx, hm, Ideal.mem_comap] at hs
    exact IsLocalRing.notMem_maximalIdeal.mp hs

  have hloc : IsLocalization (Submonoid.map φ.hom (nonZeroDivisors A₀))
      (Localization.Away (φ.hom ϖ)) := by
    refine (IsLocalization.iff_of_le_of_exists_dvd (Submonoid.powers (φ.hom ϖ)) _ ?_ ?_).mp
      Localization.isLocalization
    · rintro _ ⟨n, rfl⟩
      show (φ.hom ϖ) ^ n ∈ _
      rw [← map_pow]
      exact Submonoid.mem_map_of_mem _ (mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hϖ0))
    · rintro _ ⟨a, ha, rfl⟩
      have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
      obtain ⟨n, s, r, _, hr, hsar⟩ := hϖ a ha0
      obtain ⟨w, hw⟩ := (hunit r hr).exists_right_inv
      refine ⟨(φ.hom ϖ) ^ n, ⟨n, rfl⟩, ⟨φ.hom s * w, ?_⟩⟩
      have h2 := congrArg φ.hom hsar
      rw [map_mul, map_mul, map_pow] at h2
      calc (φ.hom ϖ) ^ n = (φ.hom ϖ) ^ n * (φ.hom r * w) := by rw [hw, mul_one]
        _ = φ.hom s * φ.hom a * w := by rw [← mul_assoc, ← h2]
        _ = φ.hom a * (φ.hom s * w) := by ring
  haveI := hloc

  obtain ⟨h', hpb⟩ : ∃ h' : Spec (CommRingCat.of (Localization.Away (φ.hom ϖ))) ⟶
      Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))),
      IsPullback h' (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
        (Localization.Away (φ.hom ϖ)))))
        (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))
        (X.fromSpecStalk x) := by
    have hg : ∀ y : nonZeroDivisors A₀, IsUnit (((algebraMap (X.presheaf.stalk x)
        (Localization.Away (φ.hom ϖ))).comp φ.hom) y) := fun y =>
      IsLocalization.map_units (M := Submonoid.map φ.hom (nonZeroDivisors A₀))
        (Localization.Away (φ.hom ϖ)) ⟨φ.hom y, Submonoid.mem_map_of_mem _ y.2⟩
    have hfm := IsLocalization.lift_comp (M := nonZeroDivisors A₀) (S := FractionRing A₀) hg
    have hPO := CommRingCat.isPushout_of_isLocalization φ.hom
      (IsLocalization.lift (M := nonZeroDivisors A₀) (S := FractionRing A₀) hg) hfm
      (nonZeroDivisors A₀)
    have H1 : IsPullback (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
          (Localization.Away (φ.hom ϖ)))))
        (Spec.map (CommRingCat.ofHom
          (IsLocalization.lift (M := nonZeroDivisors A₀) (S := FractionRing A₀) hg)))
        (X.fromSpecStalk x ≫ f)
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) := by
      rw [hF]
      exact isPullback_SpecMap_of_isPushout _ _ _ _ hPO
    refine ⟨Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
        (Localization.Away (φ.hom ϖ)))) ≫ X.fromSpecStalk x)
      (Spec.map (CommRingCat.ofHom
        (IsLocalization.lift (M := nonZeroDivisors A₀) (S := FractionRing A₀) hg)))
      (by rw [Category.assoc]; exact H1.w), ?_⟩
    refine IsPullback.of_right
      (h₁₂ := Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))
      (h₂₂ := f) ?_ (Limits.pullback.lift_fst _ _ _) (IsPullback.of_hasPullback _ _).flip
    rw [Limits.pullback.lift_snd]
    exact H1.flip

  obtain ⟨α', hα'⟩ := wc_fet_torsor_base_change p h' ℓ α hP
  obtain ⟨C, instC, instTC, σ, Φ, hΦ, h0, hadd, het, hfin, hsurj, hmu⟩ :=
    wc_fet_torsor_affine_ring_data (Localization.Away (φ.hom ϖ)) (Limits.pullback p h')
      (Limits.pullback.snd p h') ℓ α' hα'
  have Hpaste := (IsPullback.of_hasPullback p h').paste_vert hpb
  have he := Hpaste.isoPullback_inv_snd
  letI algOC : Algebra (X.presheaf.stalk x) C :=
    ((algebraMap (Localization.Away (φ.hom ϖ)) C).comp
      (algebraMap (X.presheaf.stalk x) (Localization.Away (φ.hom ϖ)))).toAlgebra
  have tower : IsScalarTower (X.presheaf.stalk x) (Localization.Away (φ.hom ϖ)) C :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hΨ : (Hpaste.isoPullback.symm ≪≫ Φ).hom ≫
      Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) C)) =
      Limits.pullback.snd (p ≫ Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk x) := by
    have e2 : CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) C) =
        CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) (Localization.Away (φ.hom ϖ))) ≫
          CommRingCat.ofHom (algebraMap (Localization.Away (φ.hom ϖ)) C) :=
      CommRingCat.ofHom_comp _ _
    rw [e2, Spec.map_comp, Iso.trans_hom, Iso.symm_hom, Category.assoc, reassoc_of% hΦ]
    exact he

  let I : Γ(Limits.pullback (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk x), ⊤) ≅ CommRingCat.of C :=
    { hom := (Hpaste.isoPullback.symm ≪≫ Φ).inv.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of C)).hom
      inv := (Scheme.ΓSpecIso (CommRingCat.of C)).inv ≫ (Hpaste.isoPullback.symm ≪≫ Φ).hom.appTop
      hom_inv_id := by
        rw [Category.assoc, Iso.hom_inv_id_assoc, ← Scheme.Hom.comp_appTop, Iso.hom_inv_id,
          Scheme.Hom.id_appTop]
      inv_hom_id := by
        rw [Category.assoc, ← Category.assoc (Scheme.Hom.appTop _), ← Scheme.Hom.comp_appTop,
          Iso.inv_hom_id, Scheme.Hom.id_appTop, Category.id_comp, Iso.inv_hom_id] }
  have key : (Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
      (Limits.pullback.snd (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk x)).appTop ≫ I.hom =
      CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) C) := by
    show _ ≫ _ ≫ ((Hpaste.isoPullback.symm ≪≫ Φ).inv.appTop ≫
      (Scheme.ΓSpecIso (CommRingCat.of C)).hom) = _
    rw [← hΨ, Scheme.Hom.comp_appTop, Category.assoc,
      ← Category.assoc (Scheme.Hom.appTop (Hpaste.isoPullback.symm ≪≫ Φ).hom),
      ← Scheme.Hom.comp_appTop, Iso.inv_hom_id, Scheme.Hom.id_appTop, Category.id_comp,
      Scheme.ΓSpecIso_naturality]
    exact Iso.inv_hom_id_assoc _ _

  letI instΓ : Algebra (X.presheaf.stalk x) Γ(Limits.pullback (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk x), ⊤) :=
    ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫ (Limits.pullback.snd (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk x)).appTop).hom.toAlgebra
  have hcompat : ∀ r : X.presheaf.stalk x, I.commRingCatIsoToRingEquiv
      (algebraMap (X.presheaf.stalk x) _ r) = algebraMap (X.presheaf.stalk x) C r := fun r =>
    congrArg (fun g => g.hom r) key
  exact ⟨C, instC, instTC, algOC, tower, σ, h0, hadd, het, hfin, hsurj, hmu,
    ⟨AlgEquiv.ofRingEquiv (f := I.commRingCatIsoToRingEquiv) hcompat⟩⟩

theorem wc_fcg_kummer_normal_form : ∀ (K : Type u) [Field K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (ζ : K), IsPrimitiveRoot ζ ℓ → ∀ (O : Type u) [CommRing O] [IsDomain O] [UniqueFactorizationMonoid O] [Algebra K O] (ϖ : O), Prime ϖ → ∀ (T : Type u) [CommRing T] [Algebra O T] [IsLocalization.Away ϖ T] (C : Type u) [CommRing C] [Algebra T C] [Algebra O C] [IsScalarTower O T C] (σ : ZMod ℓ → (C →ₐ[T] C)), σ 0 = AlgHom.id T C → (∀ c c', σ (c + c') = (σ c).comp (σ c')) → Algebra.Etale T C → Module.Finite T C → Function.Surjective (PrimeSpectrum.comap (algebraMap T C)) → Function.Bijective (wcTorDescMu T C ℓ σ) → ∃ (t : C) (k : ℕ) (u : Oˣ), k < ℓ ∧ σ 1 t = algebraMap O C (algebraMap K O ζ) * t ∧ t ^ ℓ = algebraMap O C (ϖ ^ k * (u : O)) ∧ (∀ c : C, ∃ s : Fin ℓ → T, c = ∑ i, algebraMap T C (s i) * t ^ (i : ℕ)) ∧ Function.Injective (algebraMap T C) :=
by
  intro K _ ℓ hℓ _ ζ hζ O _ _ _ _ ϖ hϖ T _ _ _ C _ _ _ _ σ hσ0 hσadd hCet hCfin hCsurj hCmu
  classical
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  have hℓpos : 0 < ℓ := hℓ.pos
  have hle : Submonoid.powers ϖ ≤ nonZeroDivisors O :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hϖ.ne_zero
  haveI : IsDomain T := IsLocalization.isDomain_of_le_nonZeroDivisors T hle
  have hinjOT : Function.Injective (algebraMap O T) := IsLocalization.injective T hle
  haveI : UniqueFactorizationMonoid T :=
    UniqueFactorizationMonoid.of_isLocalization (Submonoid.powers ϖ) T
  letI : Algebra K T := ((algebraMap O T).comp (algebraMap K O)).toAlgebra
  letI : Algebra K C := ((algebraMap O C).comp (algebraMap K O)).toAlgebra
  haveI : IsScalarTower K T C := IsScalarTower.of_algebraMap_eq
    (fun x => IsScalarTower.algebraMap_apply O T C (algebraMap K O x))

  obtain ⟨t₀, a, hσt₀, ht₀⟩ :=
    wc_fsa_ufd_kummer_generator K ℓ hℓ ζ hζ T C σ hσ0 hσadd hCet hCfin hCsurj hCmu

  obtain ⟨N, x, hx⟩ := IsLocalization.Away.surj ϖ (a : T)
  obtain ⟨M, y, hy⟩ := IsLocalization.Away.surj ϖ ((a⁻¹ : Tˣ) : T)
  have hxy : x * y = ϖ ^ (N + M) := by
    apply hinjOT
    rw [map_mul, ← hx, ← hy, map_pow, pow_add]
    have h1 : (a : T) * ((a⁻¹ : Tˣ) : T) = 1 := a.mul_inv
    linear_combination (algebraMap O T ϖ ^ N * algebraMap O T ϖ ^ M) * h1
  obtain ⟨n, -, v, hv⟩ := (dvd_prime_pow hϖ (N + M)).mp ⟨y, hxy.symm⟩
  have hxu : x = ϖ ^ n * ((v⁻¹ : Oˣ) : O) := by
    rw [← hv, mul_assoc, Units.mul_inv, mul_one]
  have hau : (a : T) * algebraMap O T ϖ ^ N =
      algebraMap O T ϖ ^ n * algebraMap O T ((v⁻¹ : Oˣ) : O) := by
    rw [hx, hxu, map_mul, map_pow]

  obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
  obtain ⟨q, k, hdiv, hk⟩ : ∃ q k, ℓ * q + k = n + N * m ∧ k < ℓ :=
    ⟨_, _, Nat.div_add_mod _ ℓ, Nat.mod_lt _ hℓpos⟩
  have hπw : algebraMap O T ϖ * IsLocalization.Away.invSelf ϖ = 1 :=
    IsLocalization.Away.mul_invSelf ϖ
  have key : (algebraMap O T ϖ ^ N * (IsLocalization.Away.invSelf ϖ : T) ^ q) ^ ℓ * (a : T) =
      algebraMap O T (ϖ ^ k * ((v⁻¹ : Oˣ) : O)) := by
    rw [map_mul, map_pow]
    calc (algebraMap O T ϖ ^ N * (IsLocalization.Away.invSelf ϖ : T) ^ q) ^ ℓ * (a : T)
        = (algebraMap O T ϖ ^ (N * m) * ((a : T) * algebraMap O T ϖ ^ N)) *
            (IsLocalization.Away.invSelf ϖ : T) ^ (ℓ * q) := by
          rw [hm]; ring
      _ = (algebraMap O T ϖ ^ (ℓ * q + k) * algebraMap O T ((v⁻¹ : Oˣ) : O)) *
            (IsLocalization.Away.invSelf ϖ : T) ^ (ℓ * q) := by
          rw [hau, hdiv]; ring
      _ = (algebraMap O T ϖ * IsLocalization.Away.invSelf ϖ) ^ (ℓ * q) *
            (algebraMap O T ϖ ^ k * algebraMap O T ((v⁻¹ : Oˣ) : O)) := by ring
      _ = algebraMap O T ϖ ^ k * algebraMap O T ((v⁻¹ : Oˣ) : O) := by
          rw [hπw, one_pow, one_mul]

  have htℓ : (algebraMap T C (algebraMap O T ϖ ^ N * (IsLocalization.Away.invSelf ϖ : T) ^ q) * t₀) ^ ℓ
      = algebraMap O C (ϖ ^ k * ((v⁻¹ : Oˣ) : O)) := by
    rw [mul_pow, ht₀, ← map_pow, ← map_mul, key, ← IsScalarTower.algebraMap_apply]
  have hσt : σ 1 (algebraMap T C (algebraMap O T ϖ ^ N * (IsLocalization.Away.invSelf ϖ : T) ^ q) * t₀)
      = algebraMap O C (algebraMap K O ζ) *
        (algebraMap T C (algebraMap O T ϖ ^ N * (IsLocalization.Away.invSelf ϖ : T) ^ q) * t₀) := by
    rw [map_mul, AlgHom.commutes, hσt₀]
    show algebraMap T C (algebraMap O T ϖ ^ N * (IsLocalization.Away.invSelf ϖ : T) ^ q) *
        (algebraMap O C (algebraMap K O ζ) * t₀) = _
    ring
  set t : C := algebraMap T C (algebraMap O T ϖ ^ N * (IsLocalization.Away.invSelf ϖ : T) ^ q) * t₀
    with ht
  have hz : algebraMap O C (algebraMap K O ζ) =
      algebraMap T C (algebraMap O T (algebraMap K O ζ)) :=
    IsScalarTower.algebraMap_apply O T C _
  have hpow : ∀ j : ℕ, σ (j : ZMod ℓ) t = algebraMap O C (algebraMap K O ζ) ^ j * t := by
    intro j
    induction j with
    | zero => simp [hσ0]
    | succ j ih =>
      rw [Nat.cast_succ, hσadd, AlgHom.comp_apply, hσt, map_mul, ih, hz, AlgHom.commutes]
      ring
  have hall : ∀ h : ZMod ℓ, σ h t = algebraMap K C (ζ ^ h.val) * t := by
    intro h
    have h1 := hpow h.val
    rw [ZMod.natCast_zmod_val] at h1
    rw [h1, map_pow]
    rfl
  have hunit : IsUnit (algebraMap O T (ϖ ^ k * ((v⁻¹ : Oˣ) : O))) := by
    rw [map_mul, map_pow]
    exact ((IsLocalization.Away.algebraMap_isUnit ϖ).pow k).mul ((v⁻¹).isUnit.map (algebraMap O T))
  have htℓ' : t ^ ℓ = algebraMap T C (hunit.unit : T) := by
    rw [IsUnit.unit_spec, ← IsScalarTower.algebraMap_apply]
    exact htℓ
  obtain ⟨hinj, hspan⟩ :=
    wc_fsa_kummer_span K ℓ hℓ ζ hζ T C σ hσ0 hσadd hCet hCsurj hCmu t hunit.unit hall htℓ'
  exact ⟨t, k, v⁻¹, hk, hσt, htℓ, hspan, hinj⟩

theorem wc_fcg_kummer_unramified_etale : ∀ (K : Type u) [Field K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (ζ : K), IsPrimitiveRoot ζ ℓ → ∀ (O : Type u) [CommRing O] [IsDomain O] [IsIntegrallyClosed O] [Algebra K O] (ϖ : O), ϖ ≠ 0 → ∀ (T : Type u) [CommRing T] [Algebra O T] [IsLocalization.Away ϖ T] (C : Type u) [CommRing C] [Algebra T C] [Algebra O C] [IsScalarTower O T C], Function.Injective (algebraMap T C) → ∀ (σ : ZMod ℓ → (C →ₐ[T] C)), σ 0 = AlgHom.id T C → (∀ c c', σ (c + c') = (σ c).comp (σ c')) → ∀ (t : C) (u : Oˣ), σ 1 t = algebraMap O C (algebraMap K O ζ) * t → t ^ ℓ = algebraMap O C (u : O) → (∀ c : C, ∃ s : Fin ℓ → T, c = ∑ i, algebraMap T C (s i) * t ^ (i : ℕ)) → Algebra.Etale O (integralClosure O C) :=
by
  intro K _ ℓ hℓ hℓK ζ hζ O _ _ _ _ ϖ hϖ T _ _ _ C _ _ _ _ hinj σ hσ0 hσadd t u hσt htℓ hspan
  classical
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩

  have hℓO : IsUnit (ℓ : O) := by
    have := (Ne.isUnit hℓK).map (algebraMap K O)
    rwa [map_natCast] at this

  letI : Algebra K C := ((algebraMap O C).comp (algebraMap K O)).toAlgebra
  set z : C := algebraMap O C (algebraMap K O ζ) with hz
  have hzT : z = algebraMap T C (algebraMap O T (algebraMap K O ζ)) := by
    rw [hz, IsScalarTower.algebraMap_apply O T C]
  have hfix : ∀ g : C →ₐ[T] C, g z = z := by
    intro g; rw [hzT, AlgHom.commutes]

  have horb_nat : ∀ n : ℕ, σ (n : ZMod ℓ) t = z ^ n * t := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero, hσ0, pow_zero, one_mul]; rfl
    | succ n ih =>
      rw [Nat.cast_succ, hσadd, AlgHom.comp_apply, hσt, map_mul, hfix, ih, pow_succ]
      ring
  have horb : ∀ h : ZMod ℓ, σ h t = algebraMap K C (ζ ^ h.val) * t := by
    intro h
    have e1 : algebraMap K C (ζ ^ h.val) = z ^ h.val := by
      rw [map_pow]; rfl
    rw [e1, ← horb_nat h.val, ZMod.natCast_zmod_val]
  obtain ⟨e⟩ := wc_fsa_kummer_integral_closure O ϖ hϖ T C K ℓ hℓ hℓO ζ hζ σ t u horb htℓ hinj hspan

  have hEt : Algebra.Etale O (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u : O))) := by
    set f : Polynomial O := Polynomial.X ^ ℓ - Polynomial.C (u : O) with hf
    have hmon : f.Monic := Polynomial.monic_X_pow_sub_C _ hℓ.ne_zero
    obtain ⟨w, hw⟩ := hℓO.exists_left_inv
    have hcert : Polynomial.derivative f * (Polynomial.C (w * ((u⁻¹ : Oˣ) : O)) * Polynomial.X)
        + f * Polynomial.C (-((u⁻¹ : Oˣ) : O)) = (1 : Polynomial O) ^ 1 := by
      have hd : Polynomial.derivative f = Polynomial.C (ℓ : O) * Polynomial.X ^ (ℓ - 1) := by
        rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero]
      have hX : (Polynomial.X : Polynomial O) ^ (ℓ - 1) * Polynomial.X = Polynomial.X ^ ℓ := by
        rw [← pow_succ, Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hℓ.ne_zero)]
      have h1 : Polynomial.C (ℓ : O) * Polynomial.C w = 1 := by
        rw [← Polynomial.C_mul, mul_comm, hw, Polynomial.C_1]
      have h2 : Polynomial.C ((u⁻¹ : Oˣ) : O) * Polynomial.C (u : O) = 1 := by
        rw [← Polynomial.C_mul, Units.inv_mul, Polynomial.C_1]
      rw [hd, hf, pow_one]
      calc Polynomial.C (ℓ : O) * Polynomial.X ^ (ℓ - 1) *
              (Polynomial.C (w * ((u⁻¹ : Oˣ) : O)) * Polynomial.X) +
            (Polynomial.X ^ ℓ - Polynomial.C (u : O)) * Polynomial.C (-((u⁻¹ : Oˣ) : O))
          = (Polynomial.C (ℓ : O) * Polynomial.C w) * Polynomial.C ((u⁻¹ : Oˣ) : O) *
              (Polynomial.X ^ (ℓ - 1) * Polynomial.X) -
              Polynomial.C ((u⁻¹ : Oˣ) : O) * Polynomial.X ^ ℓ +
              Polynomial.C ((u⁻¹ : Oˣ) : O) * Polynomial.C (u : O) := by
            rw [Polynomial.C_mul, Polynomial.C_neg]; ring
        _ = 1 := by rw [h1, h2, hX]; ring
    let P : StandardEtalePair O := ⟨f, hmon, 1, ⟨_, _, 1, hcert⟩⟩
    have hPf : P.f = f := rfl
    have hPg : P.g = 1 := rfl
    have hmap : P.HasMap (AdjoinRoot.root f) := by
      refine ⟨?_, ?_⟩
      · rw [hPf, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
      · rw [hPg, map_one]; exact isUnit_one
    have hX : Polynomial.eval₂ (↑(Algebra.ofId O P.Ring)) P.X f = 0 := by
      have := (StandardEtalePair.hasMap_X (P := P)).1
      rw [hPf, Polynomial.aeval_def] at this
      exact this
    let φ : P.Ring →ₐ[O] AdjoinRoot f := P.lift (AdjoinRoot.root f) hmap
    let ψ : AdjoinRoot f →ₐ[O] P.Ring := AdjoinRoot.liftAlgHom f (Algebra.ofId O P.Ring) P.X hX
    have e' : P.Ring ≃ₐ[O] AdjoinRoot f := AlgEquiv.ofAlgHom φ ψ
      (AdjoinRoot.algHom_ext (by
        simp only [AlgHom.comp_apply, AlgHom.id_apply, ψ, φ, AdjoinRoot.liftAlgHom_root,
          StandardEtalePair.lift_X]))
      (StandardEtalePair.hom_ext (by
        simp only [AlgHom.comp_apply, AlgHom.id_apply, ψ, φ, AdjoinRoot.liftAlgHom_root,
          StandardEtalePair.lift_X]))
    exact Algebra.Etale.of_equiv e'
  exact Algebra.Etale.of_equiv e

theorem wc_fcg_kummer_ramified_absurd : ∀ (O : Type u) [CommRing O] [IsDomain O] (ϖ : O), Prime ϖ → ∀ (T : Type u) [CommRing T] [Algebra O T] [IsLocalization.Away ϖ T] (C : Type u) [CommRing C] [Algebra T C] [Algebra O C] [IsScalarTower O T C], Function.Injective (algebraMap T C) → ∀ (t : C) (k ℓ : ℕ) (u : Oˣ), 1 ≤ k → k < ℓ → t ^ ℓ = algebraMap O C (ϖ ^ k * (u : O)) → ∀ [(Ideal.span {ϖ}).IsPrime], Algebra.Etale (Localization.AtPrime (Ideal.span {ϖ})) (TensorProduct O (Localization.AtPrime (Ideal.span {ϖ})) (integralClosure O C)) → False :=
by
  intro O _ _ ϖ hϖ T _ _ _ C _ _ _ _ hTC t k ℓ u hk hkℓ ht _ hE
  classical

  have s1 : ∀ (R S : Type u) [CommRing R] [IsLocalRing R] [CommRing S] [Algebra R S]
      [Algebra.Etale R S],
      IsReduced (S ⧸ Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R)) := by
    intro R S _ _ _ _ _
    haveI : Algebra.Etale (IsLocalRing.ResidueField R)
        (TensorProduct R (IsLocalRing.ResidueField R) S) :=
      Algebra.Etale.baseChange R S _
    haveI : IsReduced (TensorProduct R (IsLocalRing.ResidueField R) S) :=
      Algebra.FormallyUnramified.isReduced_of_field (IsLocalRing.ResidueField R) _
    let e1 := Algebra.TensorProduct.quotIdealMapEquivTensorQuot S (IsLocalRing.maximalIdeal R)
    let e2 : TensorProduct R S (IsLocalRing.ResidueField R) ≃ₐ[R]
        TensorProduct R (IsLocalRing.ResidueField R) S :=
      Algebra.TensorProduct.comm R S (IsLocalRing.ResidueField R)
    have h3 : IsReduced (TensorProduct R S (IsLocalRing.ResidueField R)) :=
      isReduced_of_injective e2.toRingEquiv.toRingHom e2.injective
    haveI : IsReduced (TensorProduct R S (R ⧸ IsLocalRing.maximalIdeal R)) := h3
    exact isReduced_of_injective e1.toRingEquiv.toRingHom e1.injective

  have s2 : ∀ (R S : Type u) [CommRing R] [IsLocalRing R] [CommRing S] [Algebra R S]
      [Algebra.IsIntegral R S], Function.Injective (algebraMap R S) →
      ∀ r : R, r ∈ IsLocalRing.maximalIdeal R → ¬ IsUnit (algebraMap R S r) := by
    intro R S _ _ _ _ _ hinj r hr hu
    have hker : RingHom.ker (algebraMap R S) ≤ IsLocalRing.maximalIdeal R := by
      rw [(RingHom.injective_iff_ker_eq_bot _).mp hinj]; exact bot_le
    obtain ⟨Q, hQ, hQu⟩ :=
      Ideal.exists_ideal_over_maximal_of_isIntegral (IsLocalRing.maximalIdeal R) hker
    have hmem : algebraMap R S r ∈ Q := by
      rw [← hQu] at hr; exact hr
    exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem Q hmem hu)

  have s3 : ∀ (S : Type u) [CommRing S] (I : Ideal S) (p : S), I = Ideal.span {p} →
      IsReduced (S ⧸ I) → IsSMulRegular S p → ∀ (s : S) (k ℓ : ℕ) (v : Sˣ), 1 ≤ k → k < ℓ →
      s ^ ℓ = p ^ k * (v : S) → IsUnit p := by
    intro S _ I p hI hred hreg s k ℓ v hk hkℓ hs
    have h1 : s ^ ℓ ∈ I := by
      rw [hI, hs]
      obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      rw [pow_succ]
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self p))
    have h2 : Ideal.Quotient.mk I s = 0 := by
      apply IsNilpotent.eq_zero
      exact ⟨ℓ, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact h1⟩
    rw [Ideal.Quotient.eq_zero_iff_mem, hI, Ideal.mem_span_singleton'] at h2
    obtain ⟨z, rfl⟩ := h2
    obtain ⟨m, rfl⟩ : ∃ m, ℓ = k + (m + 1) := ⟨ℓ - k - 1, by omega⟩
    have h3 : p ^ k * (p ^ (m + 1) * z ^ (k + (m + 1))) = p ^ k * (v : S) := by
      rw [← hs]; ring
    have h4 : p ^ (m + 1) * z ^ (k + (m + 1)) = (v : S) := hreg.pow k h3
    refine IsUnit.of_mul_eq_one (p ^ m * z ^ (k + (m + 1)) * ↑v⁻¹) ?_
    calc p * (p ^ m * z ^ (k + (m + 1)) * ↑v⁻¹)
        = (p ^ (m + 1) * z ^ (k + (m + 1))) * ↑v⁻¹ := by ring
      _ = 1 := by rw [h4]; simp

  have key : ∀ (B : Type u) [CommRing B] [Algebra O B] [Algebra.IsIntegral O B],
      Function.Injective (algebraMap O B) → IsSMulRegular B ϖ →
      ∀ tB : B, tB ^ ℓ = algebraMap O B (ϖ ^ k * (u : O)) →
      ∀ (R : Type u) [CommRing R] [IsLocalRing R] [Algebra O R] [Module.Flat O R],
      algebraMap O R ϖ ∈ IsLocalRing.maximalIdeal R →
      IsLocalRing.maximalIdeal R = Ideal.map (algebraMap O R) (Ideal.span {ϖ}) →
      Algebra.Etale R (TensorProduct O R B) → False := by
    intro B _ _ _ hOB hregB tB htB R _ _ _ _ hπ hmax hEt
    have hinjRS : Function.Injective (algebraMap R (TensorProduct O R B)) := by
      have := Algebra.TensorProduct.includeLeft_injective (R := O) (S := R) (A := R) (B := B) hOB
      intro a b hab
      apply this
      simp only [Algebra.TensorProduct.includeLeft_apply]
      simpa only [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
        RingHom.id_apply] using hab
    haveI : Algebra.IsIntegral R (TensorProduct O R B) := Algebra.IsIntegral.tensorProduct O R B
    have hregS : IsSMulRegular (TensorProduct O R B) ϖ := hregB.lTensor R
    have hsm : ∀ x : TensorProduct O R B,
        algebraMap R (TensorProduct O R B) (algebraMap O R ϖ) * x = ϖ • x := by
      intro x
      rw [← Algebra.smul_def, algebraMap_smul]
    have hregπ : IsSMulRegular (TensorProduct O R B)
        (algebraMap R (TensorProduct O R B) (algebraMap O R ϖ)) := by
      intro x y h
      change algebraMap R (TensorProduct O R B) (algebraMap O R ϖ) * x =
        algebraMap R (TensorProduct O R B) (algebraMap O R ϖ) * y at h
      apply hregS
      change ϖ • x = ϖ • y
      rw [← hsm, ← hsm]; exact h
    have hI : Ideal.map (algebraMap R (TensorProduct O R B)) (IsLocalRing.maximalIdeal R) =
        Ideal.span {algebraMap R (TensorProduct O R B) (algebraMap O R ϖ)} := by
      rw [hmax, Ideal.map_map, Ideal.map_span, Set.image_singleton, RingHom.comp_apply]
    let v : (TensorProduct O R B)ˣ :=
      Units.map ((algebraMap R (TensorProduct O R B)).comp (algebraMap O R)).toMonoidHom u
    have hs : ((1 : R) ⊗ₜ[O] tB) ^ ℓ =
        algebraMap R (TensorProduct O R B) (algebraMap O R ϖ) ^ k * (v : TensorProduct O R B) := by
      rw [Algebra.TensorProduct.tmul_pow, one_pow, htB,
        ← Algebra.TensorProduct.algebraMap_apply', IsScalarTower.algebraMap_apply O R
          (TensorProduct O R B)]
      simp [v, map_mul, map_pow]
    have hred := s1 R (TensorProduct O R B)
    have hU := s3 (TensorProduct O R B) _ _ hI hred hregπ _ k ℓ v hk hkℓ hs
    exact s2 R (TensorProduct O R B) hinjRS _ hπ hU

  have hϖ0 : ϖ ≠ 0 := hϖ.ne_zero
  have hOT : Function.Injective (algebraMap O T) :=
    IsLocalization.injective T (powers_le_nonZeroDivisors_of_noZeroDivisors hϖ0)
  have hOC : Function.Injective (algebraMap O C) := by
    rw [IsScalarTower.algebraMap_eq O T C]; exact hTC.comp hOT
  have hϖC : IsUnit (algebraMap O C ϖ) := by
    rw [IsScalarTower.algebraMap_apply O T C]
    exact (IsLocalization.Away.algebraMap_isUnit ϖ).map _
  have htint : IsIntegral O t :=
    ⟨Polynomial.X ^ ℓ - Polynomial.C (ϖ ^ k * (u : O)),
      Polynomial.monic_X_pow_sub_C _ (by omega),
      by rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, ht, sub_self]⟩
  have hOB : Function.Injective (algebraMap O (integralClosure O C)) := by
    intro a b h
    apply hOC
    have := congrArg (fun z : integralClosure O C => (z : C)) h
    simpa using this
  have hregB : IsSMulRegular (integralClosure O C) ϖ := by
    intro x y h
    change ϖ • x = ϖ • y at h
    have h' : algebraMap O C ϖ * (x : C) = algebraMap O C ϖ * (y : C) := by
      have := congrArg (fun z : integralClosure O C => (z : C)) h
      simpa [Algebra.smul_def] using this
    exact Subtype.ext (hϖC.mul_left_cancel h')
  have htB : (⟨t, htint⟩ : integralClosure O C) ^ ℓ =
      algebraMap O (integralClosure O C) (ϖ ^ k * (u : O)) := by
    apply Subtype.ext
    simp [ht]
  exact key (integralClosure O C) hOB hregB ⟨t, htint⟩ htB (Localization.AtPrime (Ideal.span {ϖ}))
    ((IsLocalization.AtPrime.to_map_mem_maximal_iff _ (Ideal.span {ϖ}) ϖ).2
      (Ideal.mem_span_singleton_self ϖ))
    Localization.AtPrime.map_eq_maximalIdeal.symm hE

theorem wc_fcg_etale_basechange_through_open : ∀ {X N Y₁ Y₂ : Scheme.{u}} (ν : N ⟶ X) (W : X.Opens), Etale (ν ∣_ W) → ∀ (h₁ : Y₁ ⟶ X) (h₂ : Y₂ ⟶ Y₁), Set.range (h₂ ≫ h₁) ⊆ (W : Set X) → Etale (Limits.pullback.snd (Limits.pullback.snd ν h₁) h₂) :=
by
  intro X N Y₁ Y₂ ν W hν h₁ h₂ hrange
  have H' : Set.range (h₂ ≫ h₁) ⊆ Set.range W.ι := by
    rw [Scheme.Opens.range_ι]; exact hrange
  have hℓ : IsOpenImmersion.lift W.ι (h₂ ≫ h₁) H' ≫ W.ι = h₂ ≫ h₁ :=
    IsOpenImmersion.lift_fac _ _ _
  have hout : IsPullback (Limits.pullback.snd (Limits.pullback.snd ν h₁) h₂)
      (Limits.pullback.fst (Limits.pullback.snd ν h₁) h₂ ≫ Limits.pullback.fst ν h₁)
      (h₂ ≫ h₁) ν :=
    IsPullback.paste_vert (IsPullback.of_hasPullback (Limits.pullback.snd ν h₁) h₂).flip
      (IsPullback.of_hasPullback ν h₁).flip
  have hR : IsPullback (ν ∣_ W) (ν ⁻¹ᵁ W).ι W.ι ν := isPullback_morphismRestrict ν W
  have w : (Limits.pullback.snd (Limits.pullback.snd ν h₁) h₂ ≫
      IsOpenImmersion.lift W.ι (h₂ ≫ h₁) H') ≫ W.ι =
      (Limits.pullback.fst (Limits.pullback.snd ν h₁) h₂ ≫ Limits.pullback.fst ν h₁) ≫ ν :=
    by rw [Category.assoc, hℓ]; exact hout.w
  have hm1 := hR.lift_fst _ _ w
  have hm2 := hR.lift_snd _ _ w
  have htop : IsPullback (Limits.pullback.snd (Limits.pullback.snd ν h₁) h₂)
      (hR.lift _ _ w) (IsOpenImmersion.lift W.ι (h₂ ≫ h₁) H') (ν ∣_ W) := by
    refine IsPullback.of_bot ?_ hm1.symm hR
    rw [hm2, hℓ]
    exact hout
  exact MorphismProperty.of_isPullback (P := @Etale) htop.flip hν

theorem wc_fcg_spec_model_etale_transfer : ∀ (O O' B₁ B₂ : Type u) [CommRing O] [CommRing O'] [CommRing B₁] [CommRing B₂] [Algebra O O'] [Algebra O B₁] [Algebra O B₂] (Z : Scheme.{u}) (q : Z ⟶ Spec (.of O)) (e : Z ≅ Spec (.of B₁)), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap O B₁)) = q → ∀ (θ : B₁ ≃ₐ[O] B₂), (Algebra.Etale O B₂ → Etale q) ∧ (Etale (Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap O O')))) → Algebra.Etale O' (TensorProduct O O' B₂)) :=
by
  intro O O' B₁ B₂ _ _ _ _ _ _ _ Z q e he θ
  subst he
  let ψ : CommRingCat.of B₁ ⟶ CommRingCat.of B₂ := CommRingCat.ofHom (θ : B₁ →+* B₂)
  let ψ' : CommRingCat.of B₂ ⟶ CommRingCat.of B₁ := CommRingCat.ofHom (θ.symm : B₂ →+* B₁)
  have h1 : CommRingCat.ofHom (algebraMap O B₁) ≫ ψ = CommRingCat.ofHom (algebraMap O B₂) := by
    ext a
    exact θ.commutes a
  have h2 : ψ' ≫ ψ = 𝟙 _ := by
    ext y
    exact θ.apply_symm_apply y
  have h3 : ψ ≫ ψ' = 𝟙 _ := by
    ext x
    exact θ.symm_apply_apply x
  have s1 : Spec.map ψ ≫ Spec.map (CommRingCat.ofHom (algebraMap O B₁)) =
      Spec.map (CommRingCat.ofHom (algebraMap O B₂)) := by
    rw [← Spec.map_comp, h1]
  have s2 : Spec.map ψ' ≫ Spec.map ψ = 𝟙 _ := by
    rw [← Spec.map_comp, h3, Spec.map_id]
  have s3 : Spec.map ψ ≫ Spec.map ψ' = 𝟙 _ := by
    rw [← Spec.map_comp, h2, Spec.map_id]
  haveI : IsIso (Spec.map ψ') := ⟨⟨Spec.map ψ, s2, s3⟩⟩
  let u : Z ⟶ Spec (.of B₂) := e.hom ≫ Spec.map ψ'
  haveI : IsIso u := by dsimp only [u]; infer_instance
  have hu : u ≫ Spec.map (CommRingCat.ofHom (algebraMap O B₂)) =
      e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap O B₁)) := by
    dsimp only [u]
    rw [← s1, Category.assoc, ← Category.assoc (Spec.map ψ'), s2, Category.id_comp]
  constructor
  · intro hE
    have hg : Etale (Spec.map (CommRingCat.ofHom (algebraMap O B₂))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Etale)]
      exact RingHom.etale_algebraMap.mpr hE
    rw [← hu]
    infer_instance
  · intro hE
    let m : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap O O')))
        (e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap O B₁))) ⟶
        Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap O O')))
          (Spec.map (CommRingCat.ofHom (algebraMap O B₂))) :=
      Limits.pullback.map _ _ _ _ (𝟙 _) u (𝟙 _) (by simp) (by rw [Category.comp_id, hu])
    haveI : IsIso m := by dsimp only [m]; infer_instance
    have hm : m ≫ Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap O O')))
        (Spec.map (CommRingCat.ofHom (algebraMap O B₂))) =
        Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap O O')))
          (e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap O B₁))) := by
      first
        | exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
        | exact Limits.pullback.lift_fst _ _ _
        | (dsimp only [m, Limits.pullback.map]; rw [Limits.pullback.lift_fst, Category.comp_id])
    let Φ := (Limits.pullbackSymmetry (e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap O B₁)))
        (Spec.map (CommRingCat.ofHom (algebraMap O O')))).hom ≫ m ≫ (pullbackSpecIso O O' B₂).hom
    haveI : IsIso Φ := by dsimp only [Φ]; infer_instance
    have key : Φ ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : O' →+* TensorProduct O O' B₂)) =
        Limits.pullback.snd (e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap O B₁)))
          (Spec.map (CommRingCat.ofHom (algebraMap O O'))) := by
      dsimp only [Φ]
      rw [Category.assoc, Category.assoc, pullbackSpecIso_hom_fst, hm,
        Limits.pullbackSymmetry_hom_comp_fst]
    have hS : Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : O' →+* TensorProduct O O' B₂)) =
        inv Φ ≫ Limits.pullback.snd (e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap O B₁)))
          (Spec.map (CommRingCat.ofHom (algebraMap O O'))) := by
      rw [← key, IsIso.inv_hom_id_assoc]
    have hEt : Etale (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : O' →+* TensorProduct O O' B₂))) := by
      rw [hS]
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Etale)] at hEt
    exact (RingHom.etale_algebraMap (R := O') (S := TensorProduct O O' B₂)).mp hEt

theorem wc_fcg_localization_lands_in_open : ∀ (A₀ : Type u) [CommRing A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) (x ξ : X), ξ ⤳ x → f ξ = f x → ∀ (ϖ : A₀), ϖ ∈ (f x).asIdeal → ∀ (Q : Ideal (X.presheaf.stalk x)) [Q.IsPrime], Q ≤ Ideal.span {((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom ϖ} → ∀ W : X.Opens, ξ ∈ W → Set.range (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) (Localization.AtPrime Q))) ≫ X.fromSpecStalk x) ⊆ (W : Set X) :=
by
  intro A₀ _ X f x ξ hξx hf ϖ hϖ Q _ hQ W hξW
  have hF : X.fromSpecStalk x ≫ f = Spec.map ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫
      f.appTop ≫ X.presheaf.Γgerm x) := by
    have h1 : f = X.toSpecΓ ≫ Spec.map f.appTop ≫
        Spec.map (Scheme.ΓSpecIso (CommRingCat.of A₀)).inv := by
      have h2 := Scheme.toSpecΓ_naturality f
      rw [← SpecMap_ΓSpecIso_hom] at h2
      rw [← Category.assoc, ← h2, Category.assoc, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
        Category.comp_id]
    conv_lhs => rw [h1]
    rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ, ← Spec.map_comp, ← Spec.map_comp]
    simp only [Category.assoc]
    rfl
  have hpt : ∀ z, (f (X.fromSpecStalk x z)).asIdeal = Ideal.comap
      ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom z.asIdeal := by
    intro z
    rw [← Scheme.Hom.comp_apply, hF]
    rfl
  obtain ⟨𝔮, h𝔮⟩ : ξ ∈ Set.range (X.fromSpecStalk x) := by
    rw [Scheme.range_fromSpecStalk]; exact hξx
  have hmem : ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom ϖ
      ∈ 𝔮.asIdeal := by
    have h := hpt 𝔮
    rw [h𝔮, hf] at h
    rw [h] at hϖ
    exact Ideal.mem_comap.mp hϖ
  have hQ𝔮 : Q ≤ 𝔮.asIdeal := hQ.trans ((Ideal.span_singleton_le_iff_mem _).mpr hmem)
  rintro _ ⟨z, rfl⟩
  rw [Scheme.Hom.comp_apply]
  have h𝔯 : (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
      (Localization.AtPrime Q))) z).asIdeal ≤ Q := by
    have e : (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
        (Localization.AtPrime Q))) z).asIdeal =
        Ideal.comap (algebraMap (X.presheaf.stalk x) (Localization.AtPrime Q)) z.asIdeal := rfl
    rw [e]
    calc Ideal.comap (algebraMap (X.presheaf.stalk x) (Localization.AtPrime Q)) z.asIdeal
        ≤ Ideal.comap (algebraMap (X.presheaf.stalk x) (Localization.AtPrime Q))
            (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) :=
          Ideal.comap_mono (IsLocalRing.le_maximalIdeal z.isPrime.ne_top)
      _ = Q := Localization.AtPrime.under_maximalIdeal (I := Q)
  have hle : @LE.le (PrimeSpectrum (X.presheaf.stalk x)) _
      (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
        (Localization.AtPrime Q))) z) 𝔮 := h𝔯.trans hQ𝔮
  have hsp := ((PrimeSpectrum.le_iff_specializes _ _).mp hle).map
    (X.fromSpecStalk x).continuous
  rw [h𝔮] at hsp
  exact hsp.mem_open W.isOpen hξW

theorem wc_fco_etale_stalk_of_generization : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (κ : K →+* A₀) (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∀ [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], (∀ y : X, (f y).asIdeal.height = 1 → IsRegularLocalRing (X.presheaf.stalk y) ∧ UniqueFactorizationMonoid (X.presheaf.stalk y)) → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ (x ξ : X), (f x).asIdeal.height = 1 → ξ ⤳ x → f ξ = f x → ∀ W : X.Opens, ξ ∈ W → Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) → Etale (Limits.pullback.snd (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (X.fromSpecStalk x)) :=
by
  intro K _ _ ℓ hℓ hℓK A₀ _ _ _ _ κ X _ _ f _ P p α hP _ _ hreg hnorm hfin hpb x ξ hx hξx hξf W hξW hW
  classical
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  haveI : IsFinite p := hP.finite
  haveI : Etale p := hP.etale
  haveI : IsAffineHom (Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))).flip
      inferInstance
  haveI hgaff : IsAffineHom (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) := inferInstance

  haveI : (f x).asIdeal.IsPrime := PrimeSpectrum.isPrime _
  obtain ⟨ϖ, hϖ𝔭, hϖ0, hϖ⟩ := wc_fcg_height_one_uniformizer A₀ (f x).asIdeal hx
  obtain ⟨hprime, -⟩ := wc_fcg_stalk_uniformizer_prime A₀ X f x ϖ hϖ𝔭 hϖ0 hϖ
  haveI : IsDomain (X.presheaf.stalk x) := (hnorm x).1
  haveI : UniqueFactorizationMonoid (X.presheaf.stalk x) := (hreg x hx).2
  letI : Algebra K (X.presheaf.stalk x) :=
    (((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫ X.presheaf.Γgerm x).hom.comp κ).toAlgebra

  haveI : NeZero (ℓ : K) := ⟨hℓK⟩
  obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ K)
    (Polynomial.degree_cyclotomic_pos ℓ K hℓ.pos).ne'
  have hζp : IsPrimitiveRoot ζ ℓ := Polynomial.isRoot_cyclotomic_iff.mp hζ

  letI : Algebra (X.presheaf.stalk x) Γ(Limits.pullback (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk x), ⊤) :=
    ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫ (Limits.pullback.snd (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (X.fromSpecStalk x)).appTop).hom.toAlgebra
  obtain ⟨C, _, _, _, _, σ, hσ0, hσadd, hCet, hCfin, hCsurj, hCmu, ⟨θ₀⟩⟩ :=
    wc_fcg_generic_stalk_torsor_ring A₀ X f P p ℓ α hP x ϖ hϖ𝔭 hϖ0 hϖ

  obtain ⟨e, he⟩ := wc_fcg_normalization_stalk_model X P (p ≫ Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) hgaff x

  haveI hQ : (Ideal.span {((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫
      X.presheaf.Γgerm x).hom ϖ}).IsPrime :=
    (Ideal.span_singleton_prime hprime.ne_zero).mpr hprime

  have hT := wc_fcg_spec_model_etale_transfer (X.presheaf.stalk x)
    (Localization.AtPrime (Ideal.span {((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫
      X.presheaf.Γgerm x).hom ϖ}))
    _ (integralClosure (X.presheaf.stalk x) C) _ _ e he θ₀.mapIntegralClosure

  obtain ⟨t, k, u, hk, hσt, htℓ, hspan, hinj⟩ := wc_fcg_kummer_normal_form K ℓ hℓ hℓK ζ hζp
    (X.presheaf.stalk x) _ hprime _ C σ hσ0 hσadd hCet hCfin hCsurj hCmu
  rcases Nat.eq_zero_or_pos k with rfl | hkpos
  ·
    rw [pow_zero, one_mul] at htℓ
    haveI : IsIntegrallyClosed (X.presheaf.stalk x) := (hnorm x).2
    exact hT.1 (wc_fcg_kummer_unramified_etale K ℓ hℓ hℓK ζ hζp (X.presheaf.stalk x) _
      hprime.ne_zero _ C hinj σ hσ0 hσadd t u hσt htℓ hspan)
  ·
    have hrange := wc_fcg_localization_lands_in_open A₀ X f x ξ hξx hξf ϖ hϖ𝔭
      (Ideal.span {((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv ≫ f.appTop ≫
        X.presheaf.Γgerm x).hom ϖ}) le_rfl W hξW
    have hE := wc_fcg_etale_basechange_through_open _ W hW (X.fromSpecStalk x) _ hrange
    exact (wc_fcg_kummer_ramified_absurd (X.presheaf.stalk x) _ hprime _ C hinj t k ℓ u hkpos hk
      htℓ (hT.2 hE)).elim

theorem wc_fntame_etale_codim_one : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (κ : K →+* A₀) (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → (∃ r : Spec (.of (FractionRing A₀)) ⟶ P, r ≫ p = Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])) → ∀ [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) → ∀ x : X, (f x).asIdeal.height = 1 → ∃ W : X.Opens, x ∈ W ∧ Etale (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ∣_ W) :=
by
  intro K _ _ ℓ hℓ hℓK A₀ _ _ _ _ κ X _ _ f _ σ hσ hconn P p α hP hr _ _ hnorm hfin hpb x hx
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f

  have hreg : ∀ y : X, (f y).asIdeal.height = 1 →
      IsRegularLocalRing (X.presheaf.stalk y) ∧ UniqueFactorizationMonoid (X.presheaf.stalk y) := by
    intro y hy
    haveI := wc_fco_stalk_regular A₀ X f y hy
    exact ⟨inferInstance, (wc_fco_regular_local_ufd _).2⟩

  have hσx : f (σ (f x)) = f x := by
    rw [← Scheme.Hom.comp_apply, hσ]; rfl
  obtain ⟨ξ, hξf, hξx, hξs⟩ :=
    wc_fco_fibre_common_generization A₀ X f hconn x (σ (f x)) hσx.symm

  have hA := wc_fco_etale_stalk_at_section K ℓ hℓ hℓK A₀ κ X f σ hσ P p α hP hr hreg hnorm hfin
    hpb (f x) hx
  obtain ⟨W₀, hW₀, hW₀e⟩ := wc_fco_etale_nbhd_of_stalk X _ _ hfin (σ (f x)) hA
  have hξW : ξ ∈ W₀ := hξs.mem_open W₀.isOpen hW₀

  have hB := wc_fco_etale_stalk_of_generization K ℓ hℓ hℓK A₀ κ X f P p α hP hreg hnorm hfin hpb
    x ξ hx hξx hξf W₀ hξW hW₀e
  exact wc_fco_etale_nbhd_of_stalk X _ _ hfin x hB

theorem wc_cg2_normal_depth_two (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
    [IsIntegrallyClosed R] [IsNoetherianRing R] (h2 : 2 ≤ (IsLocalRing.maximalIdeal R).height) :
    ∃ a ∈ IsLocalRing.maximalIdeal R, ∃ b ∈ IsLocalRing.maximalIdeal R, a ≠ 0 ∧ b ≠ 0 ∧
      ∀ y z : R, b * y = a * z → ∃ w, y = a * w :=
by
  classical

  have s1 : ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M],
      IsLocalRing.maximalIdeal R ∉ associatedPrimes R M →
      ∃ b ∈ IsLocalRing.maximalIdeal R, IsSMulRegular M b := by
    intro M _ _ _ hM
    by_contra hcon
    push_neg at hcon
    have hsub : (IsLocalRing.maximalIdeal R : Set R) ⊆
        ⋃ p ∈ associatedPrimes R M, (p : Set R) := by
      rw [biUnion_associatedPrimes_eq_compl_regular R M]
      intro r hr
      exact hcon r hr
    have hfin := associatedPrimes.finite R M
    obtain ⟨p, hp, hle⟩ := (Ideal.subset_union_prime_finite (f := id) hfin ⊥ ⊥
      (fun i hi _ _ => (show IsAssociatedPrime i M from hi).isPrime)).mp hsub
    have hpP : p.IsPrime := (show IsAssociatedPrime p M from hp).isPrime
    have hle' : p ≤ IsLocalRing.maximalIdeal R := IsLocalRing.le_maximalIdeal hpP.ne_top
    have : p = IsLocalRing.maximalIdeal R := le_antisymm hle' hle
    exact hM (this ▸ hp)

  have s2 : ∀ (I : Ideal R), I ≠ ⊥ → ∀ (a x : R), a ≠ 0 →
      (∀ r ∈ I, ∃ q ∈ I, x * r = a * q) → ∃ w, x = a * w := by
    intro I hI a x ha h
    have hinj := IsFractionRing.injective R (FractionRing R)
    have hia : algebraMap R (FractionRing R) a ≠ 0 := fun h => ha (hinj (by rw [h, map_zero]))
    let N : Submodule R (FractionRing R) :=
      Submodule.map (Algebra.linearMap R (FractionRing R)) I
    have hN : N ≠ ⊥ := by
      obtain ⟨r, hrI, hr0⟩ := (Submodule.ne_bot_iff I).mp hI
      rw [Submodule.ne_bot_iff]
      exact ⟨algebraMap R (FractionRing R) r, Submodule.mem_map_of_mem hrI,
        fun h => hr0 (hinj (by rw [h, map_zero]))⟩
    have hFG : N.FG := (IsNoetherian.noetherian I).map _
    have hstab : ∀ n ∈ N, (algebraMap R (FractionRing R) x / algebraMap R (FractionRing R) a) • n
        ∈ N := by
      intro n hn
      obtain ⟨r, hrI, rfl⟩ := Submodule.mem_map.mp hn
      obtain ⟨q, hqI, hq⟩ := h r hrI
      have e : (algebraMap R (FractionRing R) x / algebraMap R (FractionRing R) a) •
          (Algebra.linearMap R (FractionRing R) r) = Algebra.linearMap R (FractionRing R) q := by
        simp only [Algebra.linearMap_apply, smul_eq_mul]
        rw [div_mul_eq_mul_div, div_eq_iff hia, ← map_mul, ← map_mul, hq, mul_comm]
      rw [e]
      exact Submodule.mem_map_of_mem hqI
    have hint := isIntegral_of_smul_mem_submodule N hN hFG _ hstab
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨y, hinj ?_⟩
    rw [map_mul, hy]
    field_simp

  have s3 : ∀ (a x c : R), a ≠ 0 → c ∈ IsLocalRing.maximalIdeal R → x * c = a →
      (∀ r ∈ IsLocalRing.maximalIdeal R, ∃ q, x * r = a * q) → False := by
    intro a x c ha hc hxc H
    have heq : IsLocalRing.maximalIdeal R = Ideal.span {c} := by
      apply le_antisymm
      · intro r hr
        obtain ⟨q, hq⟩ := H r hr
        rw [Ideal.mem_span_singleton']
        refine ⟨q, ?_⟩
        apply mul_left_cancel₀ ha
        calc a * (q * c) = c * (a * q) := by ring
          _ = c * (x * r) := by rw [hq]
          _ = (x * c) * r := by ring
          _ = a * r := by rw [hxc]
      · rw [Ideal.span_singleton_le_iff_mem]; exact hc
    have hmin : IsLocalRing.maximalIdeal R ∈ (Ideal.span {c}).minimalPrimes := by
      rw [← heq, Ideal.minimalPrimes_eq_subsingleton_self]
      rfl
    have hle := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes_of_isLocalRing
      (Ideal.span {c}) hmin
    have := h2.trans hle
    norm_num at this

  have hm0 : IsLocalRing.maximalIdeal R ≠ ⊥ := by
    intro h
    rw [h, Ideal.height_bot] at h2
    norm_num at h2
  obtain ⟨a, ha𝔪, ha0⟩ := (Submodule.ne_bot_iff _).mp hm0

  have hnotAss : IsLocalRing.maximalIdeal R ∉ associatedPrimes R (R ⧸ Ideal.span {a}) := by
    intro hA
    have hA' : IsAssociatedPrime (IsLocalRing.maximalIdeal R) (R ⧸ Ideal.span {a}) := hA
    rw [isAssociatedPrime_iff] at hA'
    obtain ⟨_, xbar, hx⟩ := hA'
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective xbar
    have hmem : ∀ r, r ∈ IsLocalRing.maximalIdeal R ↔ r * x ∈ Ideal.span {a} := by
      intro r
      rw [hx, Submodule.mem_colon_singleton, Submodule.mem_bot, ← Ideal.Quotient.eq_zero_iff_mem]
      rfl
    have H : ∀ r ∈ IsLocalRing.maximalIdeal R, ∃ q, x * r = a * q := by
      intro r hr
      obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp ((hmem r).mp hr)
      exact ⟨q, by rw [mul_comm x, ← hq, mul_comm]⟩
    have Z : ¬ ∃ w, x = a * w := by
      rintro ⟨w, rfl⟩
      have h1 : (1 : R) ∈ IsLocalRing.maximalIdeal R :=
        (hmem 1).mpr (by rw [one_mul]; exact Ideal.mem_span_singleton'.mpr ⟨w, mul_comm _ _⟩)
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    by_cases hcase : ∀ r ∈ IsLocalRing.maximalIdeal R, ∃ q ∈ IsLocalRing.maximalIdeal R,
        x * r = a * q
    · exact Z (s2 _ hm0 a x ha0 hcase)
    · push_neg at hcase
      obtain ⟨r₀, hr₀, hno⟩ := hcase
      obtain ⟨q₀, hq₀⟩ := H r₀ hr₀
      have hq₀m : q₀ ∉ IsLocalRing.maximalIdeal R := fun h => hno q₀ h hq₀
      have hu : IsUnit q₀ := by
        by_contra hnu
        exact hq₀m ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
      obtain ⟨v, hv⟩ := hu.exists_right_inv
      refine s3 a x (r₀ * v) ha0 (Ideal.mul_mem_right _ _ hr₀) ?_ H
      calc x * (r₀ * v) = (x * r₀) * v := by ring
        _ = a * (q₀ * v) := by rw [hq₀]; ring
        _ = a := by rw [hv, mul_one]

  obtain ⟨b, hb𝔪, hbreg⟩ := s1 (R ⧸ Ideal.span {a}) hnotAss
  have hprop : ∀ y z : R, b * y = a * z → ∃ w, y = a * w := by
    intro y z hyz
    have h1 : b • (Ideal.Quotient.mk (Ideal.span {a}) y) = b • 0 := by
      rw [smul_zero]
      show Ideal.Quotient.mk (Ideal.span {a}) (b * y) = 0
      rw [hyz, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self a)
    have h2' : Ideal.Quotient.mk (Ideal.span {a}) y = 0 := hbreg h1
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at h2'
    obtain ⟨w, hw⟩ := h2'
    exact ⟨w, by rw [← hw, mul_comm]⟩
  have hb0 : b ≠ 0 := by
    rintro rfl
    obtain ⟨w, hw⟩ := hprop 1 0 (by ring)
    have hu : IsUnit a := IsUnit.of_mul_eq_one w hw.symm
    exact (IsLocalRing.mem_maximalIdeal _).mp ha𝔪 hu
  exact ⟨a, ha𝔪, b, hb𝔪, ha0, hb0, hprop⟩

theorem wc_cg2_hartogs_props (R : Type u) [CommRing R] (a b : R) :
    (∀ (M : Type u) [AddCommGroup M] [Module R M], wcCg2HP R M a b →
      ∀ (i j : ℕ) (m₁ m₂ : M), b ^ j • m₁ = a ^ i • m₂ → ∃ m, m₁ = a ^ i • m ∧ m₂ = b ^ j • m) ∧
    (∀ (M N : Type u) [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] [Module.Flat R N],
      wcCg2HP R M a b → wcCg2HP R (TensorProduct R N M) a b) ∧
    (wcCg2HP R R a b → ∀ (N : Type u) [AddCommGroup N] [Module R N] [Module.Flat R N],
      wcCg2HP R N a b) :=
by
  have htrans : ∀ (M M' : Type u) [AddCommGroup M] [Module R M] [AddCommGroup M'] [Module R M'],
      (M ≃ₗ[R] M') → wcCg2HP R M a b → wcCg2HP R M' a b := by
    intro M M' _ _ _ _ e hM
    obtain ⟨Ra, Rb, H3⟩ := hM
    refine ⟨?_, ?_, ?_⟩
    · intro x y hxy
      have hxy' : a • x = a • y := hxy
      apply e.symm.injective
      apply Ra
      change a • e.symm x = a • e.symm y
      rw [← e.symm.map_smul, ← e.symm.map_smul, hxy']
    · intro x y hxy
      have hxy' : b • x = b • y := hxy
      apply e.symm.injective
      apply Rb
      change b • e.symm x = b • e.symm y
      rw [← e.symm.map_smul, ← e.symm.map_smul, hxy']
    · intro m n h
      obtain ⟨k, hk⟩ := H3 (e.symm m) (e.symm n)
        (by rw [← e.symm.map_smul, ← e.symm.map_smul, h])
      exact ⟨e k, by rw [← e.map_smul, ← hk, e.apply_symm_apply]⟩
  have part1 : ∀ (M : Type u) [AddCommGroup M] [Module R M], wcCg2HP R M a b →
      ∀ (i j : ℕ) (m₁ m₂ : M), b ^ j • m₁ = a ^ i • m₂ → ∃ m, m₁ = a ^ i • m ∧ m₂ = b ^ j • m := by
    intro M _ _ hM
    obtain ⟨Ra, Rb, H3⟩ := hM
    have hA : ∀ (j : ℕ) (x y : M), b ^ j • x = a • y → ∃ k, x = a • k := by
      intro j
      induction j with
      | zero => intro x y h; exact ⟨y, by simpa using h⟩
      | succ j ih =>
        intro x y h
        obtain ⟨k', hk'⟩ := H3 (b ^ j • x) y (by rw [smul_smul, ← pow_succ']; exact h)
        exact ih x k' hk'
    have hB : ∀ (i j : ℕ) (x y : M), b ^ j • x = a ^ i • y → ∃ k, x = a ^ i • k := by
      intro i
      induction i with
      | zero => intro j x y _; exact ⟨x, by simp⟩
      | succ i ih =>
        intro j x y h
        rw [pow_succ', mul_smul] at h
        obtain ⟨k, rfl⟩ := hA j x (a ^ i • y) h
        have h2 : b ^ j • k = a ^ i • y := by
          apply Ra
          change a • (b ^ j • k) = a • (a ^ i • y)
          rw [smul_comm a (b ^ j) k]; exact h
        obtain ⟨k', rfl⟩ := ih j k y h2
        exact ⟨k', by rw [pow_succ', mul_smul]⟩
    intro i j m₁ m₂ h
    obtain ⟨m, rfl⟩ := hB i j m₁ m₂ h
    refine ⟨m, rfl, ?_⟩
    apply Ra.pow i
    change a ^ i • m₂ = a ^ i • (b ^ j • m)
    rw [← h, smul_comm]
  have part2 : ∀ (M N : Type u) [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
      [Module.Flat R N], wcCg2HP R M a b → wcCg2HP R (TensorProduct R N M) a b := by
    intro M N _ _ _ _ _ hM
    obtain ⟨Ra, Rb, H3⟩ := hM
    have hsmul : ∀ (c : R) (x : TensorProduct R N M),
        LinearMap.lTensor N (LinearMap.lsmul R M c) x = c • x := by
      intro c x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul n m => simp [TensorProduct.tmul_smul]
      | add x y hx hy => rw [map_add, hx, hy, smul_add]
    have hreg : ∀ c : R, IsSMulRegular M c → IsSMulRegular (TensorProduct R N M) c := by
      intro c hc
      have hinj : Function.Injective (LinearMap.lTensor N (LinearMap.lsmul R M c)) :=
        Module.Flat.lTensor_preserves_injective_linearMap _ (fun x y h => hc h)
      intro x y hxy
      apply hinj
      rw [hsmul, hsmul]
      exact hxy
    refine ⟨hreg a Ra, hreg b Rb, ?_⟩
    let ψ : M →ₗ[R] M × M := (LinearMap.lsmul R M a).prod (LinearMap.lsmul R M b)
    let φ : M × M →ₗ[R] M := (LinearMap.lsmul R M b).coprod (-(LinearMap.lsmul R M a))
    have hex : Function.Exact ψ φ := by
      rintro ⟨m, n⟩
      have hφ : φ (m, n) = b • m - a • n := by
        simp [φ, sub_eq_add_neg]
      rw [hφ, sub_eq_zero]
      constructor
      · intro h'
        obtain ⟨k, hk⟩ := H3 m n h'
        refine ⟨k, ?_⟩
        have hbk : b • k = n := by
          apply Ra
          change a • (b • k) = a • n
          rw [smul_comm, ← hk]; exact h'
        simp [ψ, hk, hbk]
      · rintro ⟨k, hk⟩
        simp only [ψ, LinearMap.prod_apply] at hk
        obtain ⟨rfl, rfl⟩ := hk
        exact smul_comm b a k
    have hex' := Module.Flat.lTensor_exact N hex
    let P := TensorProduct.prodRight R R N M M
    have E1 : ∀ z, LinearMap.lTensor N φ z = b • (P z).1 - a • (P z).2 := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul n p =>
        obtain ⟨m, m'⟩ := p
        simp [P, φ, TensorProduct.tmul_smul, sub_eq_add_neg,
          TensorProduct.tmul_neg, TensorProduct.tmul_add]
      | add x y hx hy =>
        rw [map_add, hx, hy, map_add]
        simp only [Prod.fst_add, Prod.snd_add, smul_add]
        abel
    have E2 : ∀ w, P (LinearMap.lTensor N ψ w) = (a • w, b • w) := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp only [map_zero, smul_zero]; rfl
      | tmul n m => simp [P, ψ, TensorProduct.tmul_smul]
      | add x y hx hy => rw [map_add, map_add, hx, hy]; simp [smul_add]
    intro x y h
    obtain ⟨w, hw⟩ := (hex' (P.symm (x, y))).mp
      (by rw [E1, LinearEquiv.apply_symm_apply, h, sub_self])
    refine ⟨w, ?_⟩
    have hw' := congrArg P hw
    rw [E2, LinearEquiv.apply_symm_apply] at hw'
    exact (congrArg Prod.fst hw').symm
  refine ⟨part1, part2, ?_⟩
  intro hRR N _ _ _
  exact htrans _ _ (TensorProduct.rid R N) (part2 R N hRR)

theorem wc_cg2_section_completion (A : Type u) [CommRing A] [IsDomain A] [IsLocalRing A]
    [IsNoetherianRing A] (B : Type u) [CommRing B] [Algebra A B] [Algebra.Smooth A B]
    (s : B →ₐ[A] A) :
    (∀ a b : A, wcCg2HP A A a b → ∀ n : ℕ, wcCg2HP A (B ⧸ (RingHom.ker s) ^ n) a b) ∧
      IsDomain (AdicCompletion (RingHom.ker s) B) :=
by
  classical

  have hcot : Module.Free A (RingHom.ker s).Cotangent ∧
      Module.Finite A (RingHom.ker s).Cotangent := by
    letI : Algebra B A := s.toRingHom.toAlgebra
    haveI : IsScalarTower A B A := IsScalarTower.of_algebraMap_eq (fun a => (s.commutes a).symm)
    have hsurj : Function.Surjective (algebraMap B A) := fun a => ⟨algebraMap A B a, s.commutes a⟩
    obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := A) (P := B) (A := A)
      hsurj).mp inferInstance
    have hP : Module.Projective A (RingHom.ker (algebraMap B A)).Cotangent :=
      Module.Projective.of_split
        ((KaehlerDifferential.kerCotangentToTensor A B A).restrictScalars A)
        (l.restrictScalars A) (by
          ext y
          exact LinearMap.congr_fun hl y)
    have hF : Module.Finite A (RingHom.ker (algebraMap B A)).Cotangent := by
      refine Module.Finite.of_surjective (l.restrictScalars A) ?_
      intro y
      exact ⟨KaehlerDifferential.kerCotangentToTensor A B A y, LinearMap.congr_fun hl y⟩
    have hFree : Module.Free A (RingHom.ker (algebraMap B A)).Cotangent :=
      Module.free_of_flat_of_isLocalRing
    exact ⟨hFree, hF⟩
  haveI := hcot.1
  haveI := hcot.2

  have hbasis : ∃ (d : ℕ) (x : Fin d → B), (∀ i, s (x i) = 0) ∧
      (∀ y ∈ RingHom.ker s, ∃ c : Fin d → A,
        y - ∑ i, algebraMap A B (c i) * x i ∈ RingHom.ker s ^ 2) ∧
      (∀ (M : Type u) [AddCommGroup M] [Module A M] (N : Submodule A M) (m : Fin d → M),
        (∀ i, m i ∈ N) → ∃ D : B →+ M, (∀ β, D β ∈ N) ∧ (∀ a : A, D (algebraMap A B a) = 0) ∧
          (∀ β γ : B, D (β * γ) = s β • D γ + s γ • D β) ∧ ∀ i, D (x i) = m i) := by
    set I := RingHom.ker s with hI
    let b := Module.finBasis A I.Cotangent
    choose xI hxI using fun i => I.toCotangent_surjective (b i)
    have hsm : ∀ (c : A) (y : I), I.toCotangent (c • y) = c • I.toCotangent y := by
      intro c y
      exact LinearMap.map_smul_of_tower I.toCotangent c y
    refine ⟨Module.finrank A I.Cotangent, fun i => (xI i : B), fun i => (xI i).2, ?_, ?_⟩
    · intro y hy
      refine ⟨b.repr (I.toCotangent ⟨y, hy⟩), ?_⟩
      have h0 : I.toCotangent (⟨y, hy⟩ - ∑ i, (b.repr (I.toCotangent ⟨y, hy⟩) i) • xI i) = 0 := by
        rw [map_sub, map_sum]
        simp only [hsm, hxI]
        rw [b.sum_repr, sub_self]
      rw [Ideal.toCotangent_eq_zero] at h0
      simpa [Submodule.coe_sum, Algebra.smul_def] using h0
    · intro M _ _ N m hm
      let lam : I.Cotangent →ₗ[A] M := b.constr A m
      have hE : ∀ β : B, β - algebraMap A B (s β) ∈ I := by
        intro β
        rw [hI, RingHom.mem_ker, map_sub, AlgHom.commutes]
        simp
      let E : B → I := fun β => ⟨β - algebraMap A B (s β), hE β⟩
      have hEadd : ∀ β γ, E (β + γ) = E β + E γ := by
        intro β γ; apply Subtype.ext; simp only [E, Submodule.coe_add, map_add]; ring
      let D : B →+ M :=
        { toFun := fun β => lam (I.toCotangent (E β))
          map_zero' := by
            have : E 0 = 0 := by apply Subtype.ext; simp [E]
            simp [this]
          map_add' := by
            intro β γ
            simp only [hEadd, map_add] }
      have hD : ∀ β, D β = lam (I.toCotangent (E β)) := fun _ => rfl
      refine ⟨D, ?_, ?_, ?_, ?_⟩
      · intro β
        have h1 : lam (I.toCotangent (E β)) ∈ LinearMap.range lam := ⟨_, rfl⟩
        rw [Module.Basis.constr_range] at h1
        rw [hD]
        exact Submodule.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hm i) h1
      · intro a
        have : E (algebraMap A B a) = 0 := by
          apply Subtype.ext; simp [E, AlgHom.commutes]
        rw [hD, this, map_zero, map_zero]
      · intro β γ
        have hkey : I.toCotangent (E (β * γ) - (s β) • E γ - (s γ) • E β) = 0 := by
          rw [Ideal.toCotangent_eq_zero]
          have e : ((E (β * γ) - (s β) • E γ - (s γ) • E β : I) : B) =
              (β - algebraMap A B (s β)) * (γ - algebraMap A B (s γ)) := by
            simp only [E, Submodule.coe_sub, Submodule.coe_smul_of_tower, Algebra.smul_def,
              map_mul]
            ring
          rw [e, pow_two]
          exact Ideal.mul_mem_mul (hE β) (hE γ)
        rw [map_sub, map_sub, hsm, hsm, sub_sub, sub_eq_zero] at hkey
        rw [hD, hD, hD, hkey, map_add, map_smul, map_smul]
      · intro i
        have : E (xI i : B) = xI i := by
          apply Subtype.ext
          have h0 : s (xI i : B) = 0 := (xI i).2
          simp [E, h0]
        rw [hD, this, hxI, Module.Basis.constr_basis]
  obtain ⟨d, x, hx0, hgen, hder⟩ := hbasis

  have hMem : ∀ (n : ℕ) (p : MvPolynomial (Fin d) A),
      p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n ↔ ∀ e ∈ p.support, n ≤ Finsupp.degree e := by
    have hadd : ∀ (k : ℕ) (p q : MvPolynomial (Fin d) A),
        (∀ e ∈ p.support, k ≤ Finsupp.degree e) → (∀ e ∈ q.support, k ≤ Finsupp.degree e) →
        ∀ e ∈ (p + q).support, k ≤ Finsupp.degree e := by
      intro k p q hp hq e he
      rcases Finset.mem_union.mp (MvPolynomial.support_add he) with h | h
      · exact hp e h
      · exact hq e h
    have hmul : ∀ (k l : ℕ) (p q : MvPolynomial (Fin d) A),
        (∀ e ∈ p.support, k ≤ Finsupp.degree e) → (∀ e ∈ q.support, l ≤ Finsupp.degree e) →
        ∀ e ∈ (p * q).support, k + l ≤ Finsupp.degree e := by
      intro k l p q hp hq e he
      obtain ⟨e1, he1, e2, he2, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul p q he)
      rw [map_add]
      exact add_le_add (hp e1 he1) (hq e2 he2)
    have hJ : ∀ q ∈ Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) A)),
        ∀ e ∈ q.support, 1 ≤ Finsupp.degree e := by
      intro q hq
      induction hq using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨i, rfl⟩ := hy
        intro e he
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_X'] at he
        split_ifs at he with h
        · subst h; simp
        · exact absurd rfl he
      | zero => intro e he; simp at he
      | add y z _ _ hy hz => exact hadd 1 y z hy hz
      | smul r y _ hy =>
        intro e he
        have := hmul 0 1 r y (fun _ _ => Nat.zero_le _) hy e he
        simpa using this
    intro n p
    constructor
    · intro hp
      induction n generalizing p with
      | zero => intro e _; exact Nat.zero_le _
      | succ n ih =>
        rw [pow_succ] at hp
        exact Submodule.mul_induction_on
          (C := fun r => ∀ e ∈ r.support, n + 1 ≤ Finsupp.degree e) hp
          (fun m hm q hq => hmul n 1 m q (ih m hm) (hJ q hq))
          (fun y z hy hz => hadd _ y z hy hz)
    · intro h
      rw [MvPolynomial.as_sum p]
      refine Ideal.sum_mem _ (fun e he => ?_)
      refine Ideal.pow_le_pow_right (h e he) ?_
      rw [MvPolynomial.monomial_eq]
      refine Ideal.mul_mem_left _ _ ?_
      have hdeg : Finsupp.degree e = ∑ i ∈ e.support, e i := rfl
      rw [hdeg, ← Finset.prod_pow_eq_pow_sum, Finsupp.prod]
      exact Ideal.prod_mem_prod (fun i _ =>
        Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _)

  have hS1 : ∀ (n : ℕ) (β : B), ∃ p : MvPolynomial (Fin d) A,
      β - MvPolynomial.aeval x p ∈ (RingHom.ker s) ^ n := by
    have hxI : ∀ i, x i ∈ RingHom.ker s := fun i => RingHom.mem_ker.mpr (hx0 i)
    have T1 : ∀ v ∈ RingHom.ker s, ∃ q : MvPolynomial (Fin d) A,
        MvPolynomial.aeval x q ∈ RingHom.ker s ∧
          v - MvPolynomial.aeval x q ∈ RingHom.ker s ^ 2 := by
      intro v hv
      obtain ⟨c, hc⟩ := hgen v hv
      have e : MvPolynomial.aeval x (∑ i, MvPolynomial.C (c i) * MvPolynomial.X i) =
          ∑ i, algebraMap A B (c i) * x i := by
        simp [map_sum, MvPolynomial.aeval_X]
      refine ⟨∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_, ?_⟩
      · rw [e]
        exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hxI i))
      · rw [e]; exact hc
    have T : ∀ k : ℕ, ∀ y ∈ RingHom.ker s ^ k, ∃ p : MvPolynomial (Fin d) A,
        MvPolynomial.aeval x p ∈ RingHom.ker s ^ k ∧
          y - MvPolynomial.aeval x p ∈ RingHom.ker s ^ (k + 1) := by
      intro k
      induction k with
      | zero =>
        intro y _
        refine ⟨MvPolynomial.C (s y), by simp, ?_⟩
        rw [zero_add, pow_one, MvPolynomial.aeval_C, RingHom.mem_ker, map_sub, AlgHom.commutes]
        simp
      | succ k ih =>
        intro y hy
        rw [pow_succ] at hy
        refine Submodule.mul_induction_on (C := fun y => ∃ p : MvPolynomial (Fin d) A,
          MvPolynomial.aeval x p ∈ RingHom.ker s ^ (k + 1) ∧
            y - MvPolynomial.aeval x p ∈ RingHom.ker s ^ (k + 1 + 1)) hy ?_ ?_
        · intro u hu v hv
          obtain ⟨p, hp1, hp2⟩ := ih u hu
          obtain ⟨q, hq1, hq2⟩ := T1 v hv
          refine ⟨p * q, ?_, ?_⟩
          · rw [map_mul, pow_succ]; exact Ideal.mul_mem_mul hp1 hq1
          · rw [map_mul]
            have e : u * v - MvPolynomial.aeval x p * MvPolynomial.aeval x q =
                (u - MvPolynomial.aeval x p) * v +
                  MvPolynomial.aeval x p * (v - MvPolynomial.aeval x q) := by ring
            rw [e]
            refine Ideal.add_mem _ ?_ ?_
            · rw [pow_succ]; exact Ideal.mul_mem_mul hp2 hv
            · rw [show k + 1 + 1 = k + 2 from rfl, pow_add]; exact Ideal.mul_mem_mul hp1 hq2
        · intro y1 y2 h1 h2
          obtain ⟨p1, h11, h12⟩ := h1
          obtain ⟨p2, h21, h22⟩ := h2
          refine ⟨p1 + p2, ?_, ?_⟩
          · rw [map_add]; exact Ideal.add_mem _ h11 h21
          · rw [map_add, show y1 + y2 - (MvPolynomial.aeval x p1 + MvPolynomial.aeval x p2) =
              (y1 - MvPolynomial.aeval x p1) + (y2 - MvPolynomial.aeval x p2) by ring]
            exact Ideal.add_mem _ h12 h22
    intro n
    induction n with
    | zero => intro β; exact ⟨0, by simp⟩
    | succ n ih =>
      intro β
      obtain ⟨p, hp⟩ := ih β
      obtain ⟨q, -, hq⟩ := T n _ hp
      refine ⟨p + q, ?_⟩
      rw [map_add, show β - (MvPolynomial.aeval x p + MvPolynomial.aeval x q) =
        β - MvPolynomial.aeval x p - MvPolynomial.aeval x q by ring]
      exact hq


  have hS2 : ∀ (n : ℕ) (p : MvPolynomial (Fin d) A),
      MvPolynomial.aeval x p ∈ (RingHom.ker s) ^ n →
        p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n := by
    set J := Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) A)) with hJdef
    have hXJ : ∀ i, (MvPolynomial.X i : MvPolynomial (Fin d) A) ∈ J :=
      fun i => Ideal.subset_span (Set.mem_range_self i)
    have hprod0 : ∀ (k : ℕ) (p q : MvPolynomial (Fin d) A), p * q ∈ J ^ k →
        Ideal.Quotient.mk (J ^ k) p * Ideal.Quotient.mk (J ^ k) q = 0 := by
      intro k p q h
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]; exact h
    have C : ∀ n : ℕ, ∃ ψ : B →ₐ[A] MvPolynomial (Fin d) A ⧸ J ^ (n + 1),
        (∀ i, ψ (x i) = Ideal.Quotient.mk _ (MvPolynomial.X i)) ∧
        (∀ β, s β = 0 → ∃ p ∈ J, ψ β = Ideal.Quotient.mk _ p) := by
      intro n
      induction n with
      | zero =>
        refine ⟨(Algebra.ofId A _).comp s, ?_, ?_⟩
        · intro i
          rw [AlgHom.comp_apply, hx0, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem,
            zero_add, pow_one]
          exact hXJ i
        · intro β hβ
          exact ⟨0, J.zero_mem, by rw [AlgHom.comp_apply, hβ, map_zero, map_zero]⟩
      | succ n ih =>
        obtain ⟨ψ, hψ1, hψ2⟩ := ih
        have hle : J ^ (n + 1 + 1) ≤ J ^ (n + 1) := Ideal.pow_le_pow_right (Nat.le_succ (n + 1))
        let g : MvPolynomial (Fin d) A ⧸ J ^ (n + 1 + 1) →ₐ[A]
            MvPolynomial (Fin d) A ⧸ J ^ (n + 1) :=
          Ideal.Quotient.factorₐ A hle
        have hg : ∀ p, g (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ p := fun p => rfl
        have hgs : Function.Surjective g := by
          intro z
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
          exact ⟨_, hg p⟩
        have hJm : J ^ (n + 1) ≤ J := Ideal.pow_le_self (by omega)
        have hker : ∀ z, g z = 0 → ∃ p ∈ J ^ (n + 1), z = Ideal.Quotient.mk _ p := by
          intro z hz
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
          rw [hg, Ideal.Quotient.eq_zero_iff_mem] at hz
          exact ⟨p, hz, rfl⟩
        have hsq : J ^ (n + 1) * J ^ (n + 1) ≤ J ^ (n + 1 + 1) := by
          rw [← pow_add]; exact Ideal.pow_le_pow_right (by omega)
        have hnil : IsNilpotent (RingHom.ker g) := by
          have h2 : RingHom.ker g ^ 2 = ⊥ := by
            rw [pow_two, eq_bot_iff]
            refine Ideal.mul_le.mpr (fun z hz w hw => ?_)
            obtain ⟨p, hp, rfl⟩ := hker z hz
            obtain ⟨q, hq, rfl⟩ := hker w hw
            rw [Ideal.mem_bot]
            exact hprod0 _ _ _ (hsq (Ideal.mul_mem_mul hp hq))
          exact ⟨2, h2⟩
        let ψ' := Algebra.FormallySmooth.liftOfSurjective ψ g hgs hnil
        have hψ' : ∀ β, g (ψ' β) = ψ β := fun β =>
          Algebra.FormallySmooth.liftOfSurjective_apply ψ g hgs hnil β
        have hpre : ∀ β, s β = 0 → ∃ p ∈ J, ψ' β = Ideal.Quotient.mk _ p := by
          intro β hβ
          obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective (ψ' β)
          obtain ⟨p0, hp0, hp0e⟩ := hψ2 β hβ
          have h1 := hψ' β
          rw [← hq, hg, hp0e, Ideal.Quotient.eq] at h1
          refine ⟨q, ?_, hq.symm⟩
          have e : q = (q - p0) + p0 := by ring
          rw [e]
          exact J.add_mem (hJm h1) hp0
        let N : Submodule A (MvPolynomial (Fin d) A ⧸ J ^ (n + 1 + 1)) :=
          (Ideal.map (Ideal.Quotient.mk (J ^ (n + 1 + 1))) (J ^ (n + 1))).restrictScalars A
        have hNmem : ∀ z, z ∈ N ↔ ∃ p ∈ J ^ (n + 1), Ideal.Quotient.mk _ p = z := by
          intro z
          exact Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective
        let ε : Fin d → MvPolynomial (Fin d) A ⧸ J ^ (n + 1 + 1) :=
          fun i => Ideal.Quotient.mk _ (MvPolynomial.X i) - ψ' (x i)
        have hε : ∀ i, ε i ∈ N := by
          intro i
          rw [hNmem]
          obtain ⟨p, hp, he⟩ := hker (ε i) (by
            simp only [ε, map_sub, hg, hψ', hψ1, sub_self])
          exact ⟨p, hp, he.symm⟩
        obtain ⟨D, hDN, hDa, hDmul, hDx⟩ := hder _ N ε hε
        have hsmQ : ∀ (a : A) (z : MvPolynomial (Fin d) A ⧸ J ^ (n + 1 + 1)),
            a • z = algebraMap A _ a * z := fun a z => Algebra.smul_def a z
        have hD1 : D 1 = 0 := by
          have := hDa 1
          rwa [map_one] at this
        have hDD : ∀ β γ, D β * D γ = 0 := by
          intro β γ
          obtain ⟨p, hp, hpe⟩ := (hNmem _).mp (hDN β)
          obtain ⟨q, hq, hqe⟩ := (hNmem _).mp (hDN γ)
          rw [← hpe, ← hqe]
          exact hprod0 _ _ _ (hsq (Ideal.mul_mem_mul hp hq))
        have hJD : ∀ β γ, s β = 0 → ψ' β * D γ = 0 := by
          intro β γ hβ
          obtain ⟨p, hp, hpe⟩ := hpre β hβ
          obtain ⟨q, hq, hqe⟩ := (hNmem _).mp (hDN γ)
          rw [hpe, ← hqe]
          apply hprod0
          rw [pow_succ']
          exact Ideal.mul_mem_mul hp hq
        have hsub : ∀ β, s (β - algebraMap A B (s β)) = 0 := by
          intro β; rw [map_sub, AlgHom.commutes]; simp
        have hcorr : ∀ β γ, ψ' β * D γ = algebraMap A _ (s β) * D γ := by
          intro β γ
          have h := hJD _ γ (hsub β)
          rw [map_sub, AlgHom.commutes, sub_mul, sub_eq_zero] at h
          exact h
        let ψn : B →ₐ[A] MvPolynomial (Fin d) A ⧸ J ^ (n + 1 + 1) :=
          { toFun := fun β => ψ' β + D β
            map_one' := by simp only [map_one, hD1, add_zero]
            map_mul' := by
              intro β γ
              show ψ' (β * γ) + D (β * γ) = (ψ' β + D β) * (ψ' γ + D γ)
              rw [map_mul, hDmul, hsmQ, hsmQ]
              linear_combination (-(hcorr β γ) - (hcorr γ β) - hDD β γ)
            map_zero' := by simp only [map_zero, add_zero]
            map_add' := by
              intro β γ
              simp only [map_add]
              ring
            commutes' := by
              intro a
              simp only [AlgHom.commutes, hDa, add_zero] }
        refine ⟨ψn, ?_, ?_⟩
        · intro i
          show ψ' (x i) + D (x i) = _
          rw [hDx]
          simp only [ε]
          ring
        · intro β hβ
          obtain ⟨p, hp, hpe⟩ := hpre β hβ
          obtain ⟨q, hq, hqe⟩ := (hNmem _).mp (hDN β)
          refine ⟨p + q, J.add_mem hp (hJm hq), ?_⟩
          show ψ' β + D β = _
          rw [hpe, ← hqe, map_add]
    intro n p hp
    rcases n with _ | n
    · simp
    obtain ⟨ψ, hψ1, hψ2⟩ := C n
    have hcomp : ψ.comp (MvPolynomial.aeval x) = Ideal.Quotient.mkₐ A (J ^ (n + 1)) := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, MvPolynomial.aeval_X, hψ1, Ideal.Quotient.mkₐ_eq_mk]
    have hpow : ∀ k : ℕ, ∀ y ∈ RingHom.ker s ^ k, ∃ q ∈ J ^ k,
        ψ y = Ideal.Quotient.mk _ q := by
      intro k
      induction k with
      | zero =>
        intro y _
        obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective (ψ y)
        exact ⟨q, by simp, hq.symm⟩
      | succ k ih =>
        intro y hy
        rw [pow_succ] at hy
        refine Submodule.mul_induction_on (C := fun y => ∃ q ∈ J ^ (k + 1),
          ψ y = Ideal.Quotient.mk _ q) hy ?_ ?_
        · intro u hu v hv
          obtain ⟨q1, hq1, e1⟩ := ih u hu
          obtain ⟨q2, hq2, e2⟩ := hψ2 v (RingHom.mem_ker.mp hv)
          refine ⟨q1 * q2, ?_, ?_⟩
          · rw [pow_succ]; exact Ideal.mul_mem_mul hq1 hq2
          · rw [map_mul, e1, e2, map_mul]
        · intro y1 y2 h1 h2
          obtain ⟨q1, hq1, e1⟩ := h1
          obtain ⟨q2, hq2, e2⟩ := h2
          exact ⟨q1 + q2, Ideal.add_mem _ hq1 hq2, by rw [map_add, e1, e2, map_add]⟩
    obtain ⟨q, hq, hqe⟩ := hpow (n + 1) _ hp
    have h1 : Ideal.Quotient.mk (J ^ (n + 1)) p = 0 := by
      rw [← Ideal.Quotient.mkₐ_eq_mk A, ← hcomp, AlgHom.comp_apply, hqe,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hq
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1

  have hF : ∀ n, ∀ p : MvPolynomial (Fin d) A,
      p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n →
        MvPolynomial.aeval x p ∈ (RingHom.ker s) ^ n := by
    intro n p hp
    have hJ : Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) A)) ≤
        Ideal.comap (MvPolynomial.aeval x) (RingHom.ker s) := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      simp only [SetLike.mem_coe, Ideal.mem_comap, MvPolynomial.aeval_X]
      exact RingHom.mem_ker.mpr (hx0 i)
    have := (Ideal.pow_right_mono hJ n).trans (Ideal.le_comap_pow _ n) hp
    exact Ideal.mem_comap.mp this
  have hcoef : ∀ n, ∀ p : MvPolynomial (Fin d) A,
      p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n →
        ∀ e, Finsupp.degree e < n → p.coeff e = 0 := by
    intro n p hp e he
    by_contra h
    exact absurd ((hMem n p).mp hp e (MvPolynomial.mem_support_iff.mpr h)) (not_le.mpr he)
  have hcrit : ∀ n, ∀ p : MvPolynomial (Fin d) A,
      (∀ e, Finsupp.degree e < n → p.coeff e = 0) →
        p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n := by
    intro n p hp
    rw [hMem]
    intro e he
    by_contra h
    exact MvPolynomial.mem_support_iff.mp he (hp e (not_le.mp h))
  refine ⟨?_, ?_⟩
  ·
    intro a b hab n
    obtain ⟨ha, hb, h3⟩ := hab
    have hsm : ∀ (c : A) (β : B), c • (Ideal.Quotient.mk ((RingHom.ker s) ^ n) β) =
        Ideal.Quotient.mk ((RingHom.ker s) ^ n) (algebraMap A B c * β) := by
      intro c β
      rw [Algebra.smul_def, map_mul]; rfl
    have hreg : ∀ c : A, IsSMulRegular A c → ∀ δ : B,
        algebraMap A B c * δ ∈ (RingHom.ker s) ^ n → δ ∈ (RingHom.ker s) ^ n := by
      intro c hc δ hδ
      obtain ⟨p, hp⟩ := hS1 n δ
      have h1 : MvPolynomial.aeval x (MvPolynomial.C c * p) ∈ (RingHom.ker s) ^ n := by
        have e : MvPolynomial.aeval x (MvPolynomial.C c * p) =
            algebraMap A B c * δ - algebraMap A B c * (δ - MvPolynomial.aeval x p) := by
          rw [map_mul, MvPolynomial.aeval_C]; ring
        rw [e]
        exact Ideal.sub_mem _ hδ (Ideal.mul_mem_left _ _ hp)
      have h2 := hcoef n _ (hS2 n _ h1)
      have h3 : p ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n := by
        apply hcrit
        intro e he
        have := h2 e he
        rw [MvPolynomial.coeff_C_mul] at this
        apply hc
        simp only [smul_eq_mul, mul_zero]
        exact this
      have h4 := hF n p h3
      have e : δ = (δ - MvPolynomial.aeval x p) + MvPolynomial.aeval x p := by ring
      rw [e]
      exact Ideal.add_mem _ hp h4
    have hregQ : ∀ c : A, IsSMulRegular A c → IsSMulRegular (B ⧸ (RingHom.ker s) ^ n) c := by
      intro c hc m1 m2 h
      obtain ⟨β1, rfl⟩ := Ideal.Quotient.mk_surjective m1
      obtain ⟨β2, rfl⟩ := Ideal.Quotient.mk_surjective m2
      simp only [hsm] at h
      rw [Ideal.Quotient.eq] at h ⊢
      apply hreg c hc
      rw [mul_sub]; exact h
    refine ⟨hregQ a ha, hregQ b hb, ?_⟩
    intro m k hmk
    obtain ⟨β, rfl⟩ := Ideal.Quotient.mk_surjective m
    obtain ⟨γ, rfl⟩ := Ideal.Quotient.mk_surjective k
    rw [hsm, hsm, Ideal.Quotient.eq] at hmk
    obtain ⟨p, hp⟩ := hS1 n β
    obtain ⟨q, hq⟩ := hS1 n γ
    have h1 : MvPolynomial.aeval x (MvPolynomial.C b * p - MvPolynomial.C a * q) ∈
        (RingHom.ker s) ^ n := by
      have e : MvPolynomial.aeval x (MvPolynomial.C b * p - MvPolynomial.C a * q) =
          (algebraMap A B b * β - algebraMap A B a * γ) -
            algebraMap A B b * (β - MvPolynomial.aeval x p)
            + algebraMap A B a * (γ - MvPolynomial.aeval x q) := by
        rw [map_sub, map_mul, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_C]; ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.sub_mem _ hmk (Ideal.mul_mem_left _ _ hp))
        (Ideal.mul_mem_left _ _ hq)
    have h2 := hcoef n _ (hS2 n _ h1)
    have hw : ∀ e, ∃ w : A, Finsupp.degree e < n → p.coeff e = a * w := by
      intro e
      by_cases he : Finsupp.degree e < n
      · have := h2 e he
        rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_C_mul,
          sub_eq_zero] at this
        obtain ⟨w, hw⟩ := h3 (p.coeff e) (q.coeff e)
          (by simpa [smul_eq_mul] using this)
        exact ⟨w, fun _ => by simpa [smul_eq_mul] using hw⟩
      · exact ⟨0, fun h => absurd h he⟩
    choose wf hwf using hw
    let w : MvPolynomial (Fin d) A := ∑ e ∈ p.support, MvPolynomial.monomial e (wf e)
    have hcw : ∀ e, w.coeff e = if e ∈ p.support then wf e else 0 := by
      intro e
      simp only [w, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
      rw [Finset.sum_ite_eq']
    have h4 : p - MvPolynomial.C a * w ∈ (Ideal.span (Set.range MvPolynomial.X)) ^ n := by
      apply hcrit
      intro e he
      rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_C_mul, hcw]
      split_ifs with hs
      · rw [hwf e he, sub_self]
      · rw [MvPolynomial.notMem_support_iff.mp hs]; ring
    have h5 := hF n _ h4
    refine ⟨Ideal.Quotient.mk _ (MvPolynomial.aeval x w), ?_⟩
    rw [hsm, Ideal.Quotient.eq]
    have e : β - algebraMap A B a * MvPolynomial.aeval x w =
        (β - MvPolynomial.aeval x p) + MvPolynomial.aeval x (p - MvPolynomial.C a * w) := by
      rw [map_sub, map_mul, MvPolynomial.aeval_C]; ring
    rw [e]
    exact Ideal.add_mem _ hp h5
  ·
    set I := RingHom.ker s with hI
    set J := Ideal.span (Set.range (MvPolynomial.X : Fin d → MvPolynomial (Fin d) A)) with hJdef
    have hpow_le : ∀ m n, m ≤ n → I ^ n ≤ I ^ m := fun m n h => Ideal.pow_le_pow_right h
    have hlead : ∀ (k N : ℕ) (β : B), k + 1 ≤ N → β ∈ I ^ k → β ∉ I ^ (k + 1) →
        ∃ p : MvPolynomial (Fin d) A, β - MvPolynomial.aeval x p ∈ I ^ N ∧ p ∈ J ^ k ∧
          MvPolynomial.homogeneousComponent k p ≠ 0 := by
      intro k N β hN hβ hβ'
      obtain ⟨p, hp⟩ := hS1 N β
      have hpk : p ∈ J ^ k := by
        apply hS2
        have e : MvPolynomial.aeval x p = β - (β - MvPolynomial.aeval x p) := by ring
        rw [e]
        exact Ideal.sub_mem _ hβ (hpow_le k N (by omega) hp)
      refine ⟨p, hp, hpk, ?_⟩
      intro h0
      apply hβ'
      have hp1 : p ∈ J ^ (k + 1) := by
        apply hcrit
        intro e he
        rcases Nat.lt_succ_iff_lt_or_eq.mp he with h | h
        · exact hcoef k p hpk e h
        · have := congrArg (fun q : MvPolynomial (Fin d) A => q.coeff e) h0
          simp only [MvPolynomial.coeff_homogeneousComponent, h, if_true,
            MvPolynomial.coeff_zero] at this
          exact this
      have e : β = (β - MvPolynomial.aeval x p) + MvPolynomial.aeval x p := by ring
      rw [e]
      exact Ideal.add_mem _ (hpow_le (k + 1) N hN hp) (hF _ p hp1)
    have hprod : ∀ (k j : ℕ) (β γ : B), β ∈ I ^ k → β ∉ I ^ (k + 1) → γ ∈ I ^ j →
        γ ∉ I ^ (j + 1) → β * γ ∉ I ^ (k + j + 1) := by
      intro k j β γ hβ hβ' hγ hγ'
      obtain ⟨p, hp, hpk, hpk0⟩ := hlead k (k + j + 1) β (by omega) hβ hβ'
      obtain ⟨q, hq, hqj, hqj0⟩ := hlead j (k + j + 1) γ (by omega) hγ hγ'
      set pk := MvPolynomial.homogeneousComponent k p with hpkdef
      set qj := MvPolynomial.homogeneousComponent j q with hqjdef
      have hhom : (pk * qj).IsHomogeneous (k + j) :=
        (MvPolynomial.homogeneousComponent_isHomogeneous k p).mul
          (MvPolynomial.homogeneousComponent_isHomogeneous j q)
      obtain ⟨e, he⟩ := MvPolynomial.ne_zero_iff.mp (mul_ne_zero hpk0 hqj0)
      have hdeg : Finsupp.degree e = k + j := by
        by_contra h
        exact he (hhom.coeff_eq_zero h)
      have hrest : ∀ (r : MvPolynomial (Fin d) A) (m : ℕ), r ∈ J ^ m →
          r - MvPolynomial.homogeneousComponent m r ∈ J ^ (m + 1) := by
        intro r m hr
        apply hcrit
        intro e' he'
        rw [MvPolynomial.coeff_sub, MvPolynomial.coeff_homogeneousComponent]
        split_ifs with h
        · ring
        · rw [hcoef m r hr e' (by omega), sub_zero]
      have hhc : ∀ (r : MvPolynomial (Fin d) A) (m : ℕ),
          MvPolynomial.homogeneousComponent m r ∈ J ^ m := by
        intro r m
        apply hcrit
        intro e' he'
        exact (MvPolynomial.homogeneousComponent_isHomogeneous m r).coeff_eq_zero (by omega)
      have hdiff : p * q - pk * qj ∈ J ^ (k + j + 1) := by
        have e2 : p * q - pk * qj = pk * (q - qj) + (p - pk) * q := by ring
        rw [e2]
        refine Ideal.add_mem _ ?_ ?_
        · rw [show k + j + 1 = k + (j + 1) by omega, pow_add]
          exact Ideal.mul_mem_mul (hhc p k) (hrest q j hqj)
        · rw [show k + j + 1 = (k + 1) + j by omega, pow_add]
          exact Ideal.mul_mem_mul (hrest p k hpk) hqj
      have hc := hcoef _ _ hdiff e (by omega)
      rw [MvPolynomial.coeff_sub, sub_eq_zero] at hc
      have hpq : p * q ∉ J ^ (k + j + 1) := by
        intro h
        apply he
        rw [← hc]
        exact hcoef _ _ h e (by omega)
      intro hbg
      apply hpq
      apply hS2
      have e3 : MvPolynomial.aeval x (p * q) =
          β * γ - ((β - MvPolynomial.aeval x p) * γ +
            MvPolynomial.aeval x p * (γ - MvPolynomial.aeval x q)) := by
        rw [map_mul]; ring
      rw [e3]
      exact Ideal.sub_mem _ hbg (Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp)
        (Ideal.mul_mem_left _ _ hq))
    have hC : ∀ (f : AdicCompletion.AdicCauchySequence I B) (m N : ℕ), m ≤ N →
        (f : ℕ → B) N - (f : ℕ → B) m ∈ I ^ m := by
      intro f m N h
      have := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := I) (M := B) h f
      rw [Submodule.Quotient.eq] at this
      have e : (I ^ m • ⊤ : Submodule B B) = I ^ m := by
        rw [Ideal.smul_eq_mul, Ideal.mul_top]
      rw [e] at this
      exact this
    have hord : ∀ z : AdicCompletion I B, z ≠ 0 →
        ∃ (k : ℕ) (f : AdicCompletion.AdicCauchySequence I B),
          z = AdicCompletion.mk I B f ∧ (∀ N, k ≤ N → (f : ℕ → B) N ∈ I ^ k) ∧
            (∀ N, k + 1 ≤ N → (f : ℕ → B) N ∉ I ^ (k + 1)) := by
      intro z hz
      obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I B z
      have hex : ∃ n, (f : ℕ → B) n ∉ I ^ n := by
        by_contra h
        push_neg at h
        apply hz
        apply AdicCompletion.ext_evalₐ
        intro n
        rw [AdicCompletion.evalₐ_mk, map_zero, Ideal.Quotient.eq_zero_iff_mem]
        exact h n
      have hex' : ∃ k, (f : ℕ → B) (k + 1) ∉ I ^ (k + 1) := by
        obtain ⟨n, hn⟩ := hex
        rcases n with _ | n
        · exact absurd (by simp) hn
        · exact ⟨n, hn⟩
      refine ⟨Nat.find hex', f, rfl, ?_, ?_⟩
      · intro N hN
        have hk : (f : ℕ → B) (Nat.find hex') ∈ I ^ (Nat.find hex') := by
          rcases h : Nat.find hex' with _ | k
          · simp
          · have := Nat.find_min hex' (show k < Nat.find hex' by omega)
            push_neg at this
            exact this
        have e : (f : ℕ → B) N = ((f : ℕ → B) N - (f : ℕ → B) (Nat.find hex')) +
            (f : ℕ → B) (Nat.find hex') := by ring
        rw [e]
        exact Ideal.add_mem _ (hC f _ N hN) hk
      · intro N hN hmem
        apply Nat.find_spec hex'
        have e : (f : ℕ → B) (Nat.find hex' + 1) = (f : ℕ → B) N -
            ((f : ℕ → B) N - (f : ℕ → B) (Nat.find hex' + 1)) := by ring
        rw [e]
        exact Ideal.sub_mem _ hmem (hC f _ N hN)
    have hnt : Nontrivial (AdicCompletion I B) := by
      refine nontrivial_of_ne 1 0 ?_
      intro h
      have h1 := congrArg (AdicCompletion.evalₐ I 1) h
      rw [map_one, map_zero, ← map_one (Ideal.Quotient.mk (I ^ 1)),
        Ideal.Quotient.eq_zero_iff_mem, pow_one, hI, RingHom.mem_ker, map_one] at h1
      exact one_ne_zero h1
    have hnzd : NoZeroDivisors (AdicCompletion I B) := by
      constructor
      intro z z' hzz
      by_contra hne
      push_neg at hne
      obtain ⟨k, f, rfl, hf1, hf2⟩ := hord z hne.1
      obtain ⟨j, g, rfl, hg1, hg2⟩ := hord z' hne.2
      have h := congrArg (AdicCompletion.evalₐ I (k + j + 1)) hzz
      rw [map_mul, map_zero, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, ← map_mul,
        Ideal.Quotient.eq_zero_iff_mem] at h
      exact hprod k j _ _ (hf1 _ (by omega)) (hf2 _ (by omega)) (hg1 _ (by omega))
        (hg2 _ (by omega)) h
    exact NoZeroDivisors.to_isDomain _

theorem wc_cg2_integral_closure_hartogs (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B]
    (a b : B) (ha : a ≠ 0) (hb : b ≠ 0)
    (hH : ∀ (i j : ℕ) (m n : B), b ^ j * m = a ^ i * n → ∃ k, m = a ^ i * k)
    (L : Type u) [CommRing L] [Algebra B L]
    (hL2 : ∀ (β : B) (y : L), β ≠ 0 → β • y = 0 → y = 0)
    (hL3 : Module.Finite (FractionRing B) (TensorProduct B (FractionRing B) L))
    (hua : IsUnit (algebraMap B L a)) (hub : IsUnit (algebraMap B L b)) :
    wcCg2HP B (integralClosure B L) a b :=
by
  classical

  have hreg : ∀ r : B, IsUnit (algebraMap B L r) → IsSMulRegular (integralClosure B L) r := by
    intro r hr k₁ k₂ h
    have h1 : r • k₁ = r • k₂ := h
    apply Subtype.ext
    have h' : algebraMap B L r * (k₁ : L) = algebraMap B L r * (k₂ : L) := by
      rw [← Algebra.smul_def, ← Algebra.smul_def]
      exact congrArg Subtype.val h1
    exact hr.mul_left_cancel h'
  refine ⟨hreg a hua, hreg b hub, ?_⟩
  intro m n hmn
  have := hL3

  have hι : Function.Injective
      (Algebra.TensorProduct.includeRight : L →ₐ[B] TensorProduct B (FractionRing B) L) := by
    have : IsLocalizedModule (nonZeroDivisors B) (TensorProduct.mk B (FractionRing B) L 1) :=
      (isLocalizedModule_iff_isBaseChange (nonZeroDivisors B) (FractionRing B) _).mpr
        (TensorProduct.isBaseChange B L (FractionRing B))
    intro y₁ y₂ h
    have h' : TensorProduct.mk B (FractionRing B) L 1 y₁ =
        TensorProduct.mk B (FractionRing B) L 1 y₂ := h
    obtain ⟨c, hc⟩ := (IsLocalizedModule.eq_iff_exists (nonZeroDivisors B) _).mp h'
    have h0 : (c : B) • (y₁ - y₂) = 0 := by
      rw [smul_sub, sub_eq_zero]
      exact hc
    exact sub_eq_zero.mp (hL2 _ _ (nonZeroDivisors.ne_zero c.2) h0)

  have s2 : ∀ (y : TensorProduct B (FractionRing B) L), IsIntegral (FractionRing B) y →
      ∀ α : FractionRing B, α ≠ 0 →
      minpoly (FractionRing B) (algebraMap (FractionRing B) _ α * y) =
        (minpoly (FractionRing B) y).scaleRoots α := by
    intro y hy α hα
    have hmon : ((minpoly (FractionRing B) y).scaleRoots α).Monic :=
      (Polynomial.monic_scaleRoots_iff α).mpr (minpoly.monic hy)
    refine (minpoly.unique _ _ hmon ?_ ?_).symm
    · exact Polynomial.scaleRoots_aeval_eq_zero (minpoly.aeval _ y)
    · intro q hq hqroot
      have hq' : (q.scaleRoots α⁻¹).Monic := (Polynomial.monic_scaleRoots_iff _).mpr hq
      have hroot : Polynomial.aeval y (q.scaleRoots α⁻¹) = 0 := by
        have := Polynomial.scaleRoots_aeval_eq_zero (r := α⁻¹) hqroot
        rwa [← mul_assoc, ← map_mul, inv_mul_cancel₀ hα, map_one, one_mul] at this
      have := minpoly.min _ y hq' hroot
      rw [Polynomial.degree_scaleRoots] at this ⊢
      exact this

  have s4 : ∀ (y : TensorProduct B (FractionRing B) L), IsIntegral B y →
      ∃ g : Polynomial B, g.map (algebraMap B (FractionRing B)) = minpoly (FractionRing B) y := by
    intro y hy
    obtain ⟨g, hg, hgy⟩ := hy
    have hdvd : minpoly (FractionRing B) y ∣ g.map (algebraMap B (FractionRing B)) := by
      apply minpoly.dvd
      rw [Polynomial.aeval_map_algebraMap, Polynomial.aeval_def]
      exact hgy
    obtain ⟨g', hg'⟩ := IsIntegrallyClosed.eq_map_mul_C_of_dvd (FractionRing B) hg hdvd
    have hmon := minpoly.monic
      (IsIntegral.tower_top (A := FractionRing B) (⟨g, hg, hgy⟩ : IsIntegral B y))
    refine ⟨g', ?_⟩
    rw [hmon.leadingCoeff, Polynomial.C_1, mul_one] at hg'
    exact hg'

  set ua : L := ↑(hua.unit⁻¹) with hua_def
  set c : L := ua * (m : L) with hc_def
  have hma : (m : L) = algebraMap B L a * c := by
    rw [hc_def, ← mul_assoc, hua_def, IsUnit.mul_val_inv, one_mul]
  have hmn' : algebraMap B L b * (m : L) = algebraMap B L a * (n : L) := by
    rw [← Algebra.smul_def, ← Algebra.smul_def]
    exact congrArg Subtype.val hmn
  have hnb : (n : L) = algebraMap B L b * c := by
    calc (n : L) = ua * (algebraMap B L a * n) := by
          rw [← mul_assoc, hua_def, IsUnit.val_inv_mul, one_mul]
      _ = ua * (algebraMap B L b * m) := by rw [hmn']
      _ = algebraMap B L b * c := by rw [hc_def]; ring
  have hιa : ∀ r : B, (Algebra.TensorProduct.includeRight : L →ₐ[B] TensorProduct B (FractionRing B) L)
      (algebraMap B L r) = algebraMap (FractionRing B) (TensorProduct B (FractionRing B) L)
        (algebraMap B (FractionRing B) r) := by
    intro r
    rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
  set ι : L →ₐ[B] TensorProduct B (FractionRing B) L := Algebra.TensorProduct.includeRight with hι_def
  set x : TensorProduct B (FractionRing B) L := ι c with hx_def
  have hxm : ι m = algebraMap (FractionRing B) _ (algebraMap B (FractionRing B) a) * x := by
    rw [hma, map_mul, hιa]
  have hxn : ι n = algebraMap (FractionRing B) _ (algebraMap B (FractionRing B) b) * x := by
    rw [hnb, map_mul, hιa]
  have hxint : IsIntegral (FractionRing B) x := IsIntegral.of_finite _ x
  have hinjK := IsFractionRing.injective B (FractionRing B)
  have hα : algebraMap B (FractionRing B) a ≠ 0 := fun h => ha (hinjK (by rw [h, map_zero]))
  have hβ : algebraMap B (FractionRing B) b ≠ 0 := fun h => hb (hinjK (by rw [h, map_zero]))
  have hsm := s2 x hxint _ hα
  have hsn := s2 x hxint _ hβ
  obtain ⟨g₁, hg₁⟩ := s4 (ι m) (IsIntegral.map ι m.2)
  obtain ⟨g₂, hg₂⟩ := s4 (ι n) (IsIntegral.map ι n.2)
  rw [hxm, hsm] at hg₁
  rw [hxn, hsn] at hg₂

  have hcoef : ∀ i, (minpoly (FractionRing B) x).coeff i ∈
      Set.range (algebraMap B (FractionRing B)) := by
    intro i
    have e₁ := congrArg (fun p => Polynomial.coeff p i) hg₁
    have e₂ := congrArg (fun p => Polynomial.coeff p i) hg₂
    simp only [Polynomial.coeff_map, Polynomial.coeff_scaleRoots] at e₁ e₂
    have hB : b ^ ((minpoly (FractionRing B) x).natDegree - i) * g₁.coeff i =
        a ^ ((minpoly (FractionRing B) x).natDegree - i) * g₂.coeff i := by
      apply hinjK
      simp only [map_mul, map_pow, e₁, e₂]
      ring
    obtain ⟨k, hk⟩ := hH _ _ _ _ hB
    refine ⟨k, ?_⟩
    have h2 : (algebraMap B (FractionRing B) a) ^ ((minpoly (FractionRing B) x).natDegree - i) *
        algebraMap B (FractionRing B) k =
        (algebraMap B (FractionRing B) a) ^ ((minpoly (FractionRing B) x).natDegree - i) *
          (minpoly (FractionRing B) x).coeff i := by
      rw [← map_pow, ← map_mul, ← hk, e₁, map_pow]
      ring
    exact mul_left_cancel₀ (pow_ne_zero _ hα) h2
  have hlift : minpoly (FractionRing B) x ∈ Polynomial.lifts (algebraMap B (FractionRing B)) :=
    (Polynomial.lifts_iff_coeff_lifts _).mpr hcoef
  obtain ⟨μ₀, hμ₀map, -, hμ₀mon⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic hlift (minpoly.monic hxint)
  have hc0 : Polynomial.aeval c μ₀ = 0 := by
    apply hι
    rw [map_zero, ← Polynomial.aeval_algHom_apply,
      ← Polynomial.aeval_map_algebraMap (FractionRing B), hμ₀map]
    exact minpoly.aeval _ _
  have hcint : c ∈ integralClosure B L :=
    ⟨μ₀, hμ₀mon, by rw [← Polynomial.aeval_def]; exact hc0⟩
  refine ⟨⟨c, hcint⟩, Subtype.ext ?_⟩
  rw [hma]
  exact (Algebra.smul_def a c).symm

theorem wc_cg2_locEtale_away (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
    [IsNoetherianRing R] [Module.Finite R S] (a : R)
    (h : ∀ (Q : Ideal R) [Q.IsPrime], a ∉ Q → wcCg2LocEtale (algebraMap R S) Q.primeCompl) :
    wcCg2LocEtale (algebraMap R S) (Submonoid.powers a) :=
by
  classical
  have wc_fnteg_spread_etale : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (φ : R →+* R'), φ.Finite → φ.FinitePresentation → ∀ (M : Submonoid R), (IsLocalization.map (Localization (M.map φ)) φ M.le_comap_map : Localization M →+* Localization (M.map φ)).Etale → ∀ (𝔭 : Ideal R) [𝔭.IsPrime], Disjoint (M : Set R) (𝔭 : Set R) → ∃ r : R, r ∉ 𝔭 ∧ ((algebraMap R' (Localization.Away (φ r))).comp φ).Etale := by
    intro R R' _ _ φ hf hp M hM 𝔭 _ hdisj
    letI : Algebra R R' := φ.toAlgebra
    haveI : Module.Finite R R' := hf
    haveI : Algebra.FinitePresentation R R' := hp
    have hloc : ∀ (𝔮 : Ideal R') [𝔮.IsPrime], (∀ m ∈ M, φ m ∉ 𝔮) → Algebra.IsEtaleAt R 𝔮 := by
      intro 𝔮 _ hq
      let N : Submonoid R' := M.map φ
      let S := Localization N
      let T := Localization.AtPrime 𝔮
      let φM : Localization M →+* S := IsLocalization.map S φ M.le_comap_map
      letI : Algebra (Localization M) S := φM.toAlgebra
      haveI : Algebra.Etale (Localization M) S := hM
      haveI : Algebra.FormallyEtale R (Localization M) := Algebra.FormallyEtale.of_isLocalization M
      haveI : IsScalarTower R (Localization M) S := by
        apply IsScalarTower.of_algebraMap_eq'
        rw [IsScalarTower.algebraMap_eq R R' S]
        exact (IsLocalization.map_comp M.le_comap_map).symm
      haveI : Algebra.FormallyEtale R S := Algebra.FormallyEtale.comp R (Localization M) S
      have hN : N ≤ 𝔮.primeCompl := by
        rintro _ ⟨m, hm, rfl⟩
        exact hq m hm
      letI : Algebra S T := IsLocalization.localizationAlgebraOfSubmonoidLe S T N 𝔮.primeCompl hN
      haveI : IsScalarTower R' S T :=
        IsLocalization.localization_isScalarTower_of_submonoid_le S T N 𝔮.primeCompl hN
      haveI : IsLocalization (Submonoid.map (algebraMap R' S) 𝔮.primeCompl) T :=
        IsLocalization.isLocalization_of_submonoid_le S T N 𝔮.primeCompl hN
      haveI : Algebra.FormallyEtale S T :=
        Algebra.FormallyEtale.of_isLocalization (Submonoid.map (algebraMap R' S) 𝔮.primeCompl)
      haveI : IsScalarTower R S T := by
        apply IsScalarTower.of_algebraMap_eq'
        rw [IsScalarTower.algebraMap_eq R R' T, IsScalarTower.algebraMap_eq R' S T,
          IsScalarTower.algebraMap_eq R R' S, RingHom.comp_assoc]
      exact Algebra.FormallyEtale.comp R S T
    have hfib : ∀ 𝔮 : PrimeSpectrum R', Ideal.comap φ 𝔮.asIdeal = 𝔭 →
        𝔮 ∈ Algebra.etaleLocus R R' := by
      intro 𝔮 h𝔮
      rw [Algebra.mem_etaleLocus_iff]
      apply hloc
      intro m hm hm'
      have h1 : m ∈ 𝔭 := by rw [← h𝔮]; exact hm'
      exact Set.disjoint_left.mp hdisj hm h1
    have hZ : IsClosed (Algebra.etaleLocus R R')ᶜ := Algebra.isOpen_etaleLocus.isClosed_compl
    have hint : φ.IsIntegral := RingHom.IsIntegral.of_finite hf
    have hC : IsClosed (PrimeSpectrum.comap φ '' (Algebra.etaleLocus R R')ᶜ) :=
      PrimeSpectrum.isClosedMap_comap_of_isIntegral φ hint _ hZ
    have hpt : (⟨𝔭, inferInstance⟩ : PrimeSpectrum R) ∈
        (PrimeSpectrum.comap φ '' (Algebra.etaleLocus R R')ᶜ)ᶜ := by
      rintro ⟨𝔮, h𝔮Z, h𝔮⟩
      apply h𝔮Z
      apply hfib
      have h1 := congrArg PrimeSpectrum.asIdeal h𝔮
      rw [PrimeSpectrum.comap_asIdeal] at h1
      exact h1
    obtain ⟨v, ⟨r, rfl⟩, hpv, hvC⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hpt hC.isOpen_compl
    have hr : r ∉ 𝔭 := hpv
    have hsub : (PrimeSpectrum.basicOpen (algebraMap R R' r) : Set (PrimeSpectrum R')) ⊆
        Algebra.etaleLocus R R' := by
      intro 𝔮 h𝔮
      by_contra hne
      have hmem : PrimeSpectrum.comap φ 𝔮 ∈ (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum R)) := by
        show r ∉ (PrimeSpectrum.comap φ 𝔮).asIdeal
        rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
        exact h𝔮
      exact hvC hmem ⟨𝔮, hne, rfl⟩
    haveI hE : Algebra.Etale R (Localization.Away (algebraMap R R' r)) :=
      Algebra.basicOpen_subset_etaleLocus_iff_etale.mp hsub
    refine ⟨r, hr, ?_⟩
    have h2 := RingHom.etale_algebraMap.mpr hE
    rw [IsScalarTower.algebraMap_eq R R' (Localization.Away (algebraMap R R' r))] at h2
    exact h2
  set φ : R →+* S := algebraMap R S with hφ
  have hfin : φ.Finite := RingHom.finite_algebraMap.mpr inferInstance
  have hfp : φ.FinitePresentation :=
    RingHom.FinitePresentation.of_finiteType.mp (RingHom.FiniteType.of_finite hfin)
  let G : Set R := { r | ((algebraMap S (Localization.Away (φ r))).comp φ).Etale }
  have hcov : ∀ (Q : Ideal R) [Q.IsPrime], a ∉ Q → ∃ r ∈ G, r ∉ Q := by
    intro Q _ haQ
    obtain ⟨r, hrQ, hr⟩ := wc_fnteg_spread_etale φ hfin hfp Q.primeCompl (h Q haQ) Q
      (Set.disjoint_left.mpr (fun x hx hxQ => hx hxQ))
    exact ⟨r, hr, hrQ⟩
  let Sa := Localization ((Submonoid.powers a).map φ)
  have hspan : Ideal.span ((fun r => algebraMap S Sa (φ r)) '' G) = ⊤ := by
    have hrad : a ∈ (Ideal.span G).radical := by
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro P ⟨hJP, hP⟩
      by_contra haP
      obtain ⟨r, hrG, hrP⟩ := hcov P haP
      exact hrP (hJP (Ideal.subset_span hrG))
    obtain ⟨n, hn⟩ := hrad
    have hmem : ((algebraMap S Sa).comp φ) (a ^ n) ∈
        Ideal.span ((fun r => algebraMap S Sa (φ r)) '' G) := by
      have := Ideal.mem_map_of_mem ((algebraMap S Sa).comp φ) hn
      rw [Ideal.map_span] at this
      exact this
    apply Ideal.eq_top_of_isUnit_mem _ hmem
    exact IsLocalization.map_units Sa (⟨φ (a ^ n), Submonoid.mem_map_of_mem φ
      (pow_mem (Submonoid.mem_powers a) n)⟩ : (Submonoid.powers a).map φ)
  unfold wcCg2LocEtale
  apply RingHom.Etale.ofLocalizationSpanTarget _ _ hspan
  rintro ⟨t, r, hrG, rfl⟩
  change ((algebraMap Sa (Localization.Away (algebraMap S Sa (φ r)))).comp
    (IsLocalization.map Sa φ (Submonoid.powers a).le_comap_map :
      Localization (Submonoid.powers a) →+* Sa)).Etale
  have hg : ((algebraMap S (Localization.Away (φ r))).comp φ).Etale := hrG
  let Sr := Localization.Away (φ r)
  let g : R →+* Sr := (algebraMap S Sr).comp φ
  let Ra := Localization (Submonoid.powers a)
  let T := Localization.Away (g a)
  have h1 : (IsLocalization.Away.map Ra T g a).Etale :=
    RingHom.Etale.propertyIsLocal.localizationAwayPreserves g a Ra T hg
  have : IsLocalization.Away (φ a) Sa := by
    show IsLocalization (Submonoid.powers (φ a)) Sa
    rw [← Submonoid.map_powers]; infer_instance
  let T' := Localization.Away (algebraMap S Sa (φ r))
  have : IsLocalization.Away (φ a * φ r) T' := IsLocalization.Away.mul' Sa T' (φ a) (φ r)
  have : IsLocalization.Away (algebraMap S Sr (φ a)) T :=
    (inferInstance : IsLocalization.Away (g a) T)
  have : IsLocalization.Away (φ a * φ r) T := IsLocalization.Away.mul Sr T (φ r) (φ a)
  let e : T ≃ₐ[S] T' := IsLocalization.algEquiv (Submonoid.powers (φ a * φ r)) T T'
  have key : (algebraMap Sa T').comp (IsLocalization.map Sa φ (Submonoid.powers a).le_comap_map :
      Localization (Submonoid.powers a) →+* Sa) =
      e.toRingEquiv.toRingHom.comp (IsLocalization.Away.map Ra T g a) := by
    apply IsLocalization.ringHom_ext (Submonoid.powers a)
    ext x
    simp only [RingHom.comp_apply]
    rw [IsLocalization.map_eq, IsLocalization.Away.map, IsLocalization.map_eq]
    rw [← IsScalarTower.algebraMap_apply S Sa T']
    change _ = e (algebraMap Sr T (algebraMap S Sr (φ x)))
    rw [← IsScalarTower.algebraMap_apply S Sr T, AlgEquiv.commutes]
  rw [key]
  exact RingHom.Etale.respectsIso.1 _ _ h1

theorem wc_cg2_locEtale_baseChange (R R' S : Type u) [CommRing R] [CommRing R'] [CommRing S]
    [Algebra R R'] [Algebra R S] (a : R)
    (h : wcCg2LocEtale (algebraMap R S) (Submonoid.powers a)) :
    wcCg2LocEtale (algebraMap R' (TensorProduct R R' S)) (Submonoid.powers (algebraMap R R' a)) :=
by
  classical
  unfold wcCg2LocEtale at h ⊢

  let j : R →+* R' := algebraMap R R'
  let φ : R →+* S := algebraMap R S
  let ψ : R' →+* TensorProduct R R' S := algebraMap R' (TensorProduct R R' S)
  let incR : S →+* TensorProduct R R' S :=
    (Algebra.TensorProduct.includeRight (R := R) (A := R') (B := S)).toRingHom
  let incL : R' →+* TensorProduct R R' S :=
    Algebra.TensorProduct.includeLeftRingHom (R := R) (A := R') (B := S)
  let M : Submonoid R := Submonoid.powers a
  let M' : Submonoid R' := Submonoid.powers (j a)

  have E5 : incR.comp φ = ψ.comp j := by
    apply RingHom.ext
    intro r
    show (1 : R') ⊗ₜ[R] (algebraMap R S r) = algebraMap R' (TensorProduct R R' S) (algebraMap R R' r)
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    exact (Algebra.TensorProduct.tmul_one_eq_one_tmul r).symm
  have E4 : incL = ψ := by
    apply RingHom.ext
    intro x
    show x ⊗ₜ[R] (1 : S) = algebraMap R' (TensorProduct R R' S) x
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
  have E1 : M.map j = M' := Submonoid.map_powers j a
  have E2 : (M.map φ).map incR = M'.map ψ := by
    show (Submonoid.map φ (Submonoid.powers a)).map incR = (Submonoid.powers (j a)).map ψ
    rw [Submonoid.map_powers, Submonoid.map_powers, Submonoid.map_powers]
    exact congrArg Submonoid.powers (RingHom.congr_fun E5 a)

  haveI hR'a : IsLocalization (M.map j) (Localization M') := by
    rw [E1]; infer_instance
  haveI hTa : IsLocalization ((M.map φ).map incR) (Localization (M'.map ψ)) := by
    rw [E2]; infer_instance
  have hι : M ≤ M'.comap j := Submonoid.map_le_iff_le_comap.mp E1.le
  have hv : M.map φ ≤ (M'.map ψ).comap incR := Submonoid.map_le_iff_le_comap.mp E2.le
  let ι : Localization M →+* Localization M' :=
    IsLocalization.map (M := M) (S := Localization M) (Localization M') j hι
  let v : Localization (M.map φ) →+* Localization (M'.map ψ) :=
    IsLocalization.map (M := M.map φ) (S := Localization (M.map φ)) (Localization (M'.map ψ))
      incR hv
  let f : Localization M →+* Localization (M.map φ) :=
    IsLocalization.map (M := M) (S := Localization M) (Localization (M.map φ)) φ
      M.le_comap_map
  let g : Localization M' →+* Localization (M'.map ψ) :=
    IsLocalization.map (M := M') (S := Localization M') (Localization (M'.map ψ)) ψ
      M'.le_comap_map
  have C1 : ι.comp (algebraMap R (Localization M)) =
      (algebraMap R' (Localization M')).comp j := IsLocalization.map_comp hι
  have C2 : v.comp (algebraMap S (Localization (M.map φ))) =
      (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp incR :=
    IsLocalization.map_comp hv
  have C3 : f.comp (algebraMap R (Localization M)) =
      (algebraMap S (Localization (M.map φ))).comp φ := IsLocalization.map_comp M.le_comap_map
  have C4 : g.comp (algebraMap R' (Localization M')) =
      (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp ψ :=
    IsLocalization.map_comp M'.le_comap_map

  have Sq1 : IsPushout (CommRingCat.ofHom φ) (CommRingCat.ofHom j) (CommRingCat.ofHom incR)
      (CommRingCat.ofHom incL) := (CommRingCat.isPushout_tensorProduct R R' S).flip
  have Sq2 := (CommRingCat.isPushout_of_isLocalization (Rₘ := Localization (M.map φ))
    (Sₘ := Localization (M'.map ψ)) incR v C2 (M.map φ)).flip
  have SqL := (CommRingCat.isPushout_of_isLocalization (Rₘ := Localization M)
    (Sₘ := Localization M') j ι C1 M).flip

  have Outer := Sq1.paste_horiz Sq2
  have e1 : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap S (Localization (M.map φ))) =
      CommRingCat.ofHom (algebraMap R (Localization M)) ≫ CommRingCat.ofHom f := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, C3]
  have e2 : CommRingCat.ofHom incL ≫
        CommRingCat.ofHom (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))) =
      CommRingCat.ofHom (algebraMap R' (Localization M')) ≫ CommRingCat.ofHom g := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, C4, E4]
  rw [e1, e2] at Outer

  have hQ : CommRingCat.ofHom f ≫ CommRingCat.ofHom v = CommRingCat.ofHom ι ≫ CommRingCat.ofHom g := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply IsLocalization.ringHom_ext M
    calc (v.comp f).comp (algebraMap R (Localization M))
        = v.comp (f.comp (algebraMap R (Localization M))) := rfl
      _ = v.comp ((algebraMap S (Localization (M.map φ))).comp φ) := by rw [C3]
      _ = (v.comp (algebraMap S (Localization (M.map φ)))).comp φ := rfl
      _ = ((algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp incR).comp φ := by
          rw [C2]
      _ = (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp (incR.comp φ) := rfl
      _ = (algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp (ψ.comp j) := by
          rw [E5]
      _ = ((algebraMap (TensorProduct R R' S) (Localization (M'.map ψ))).comp ψ).comp j := rfl
      _ = (g.comp (algebraMap R' (Localization M'))).comp j := by rw [C4]
      _ = g.comp ((algebraMap R' (Localization M')).comp j) := rfl
      _ = g.comp (ι.comp (algebraMap R (Localization M))) := by rw [C1]
      _ = (g.comp ι).comp (algebraMap R (Localization M)) := rfl

  have Q := (CategoryTheory.IsPushout.paste_horiz_iff SqL hQ).mp Outer

  haveI : (RingHom.toMorphismProperty RingHom.Etale).IsStableUnderCobaseChange :=
    RingHom.isStableUnderCobaseChange_toMorphismProperty_iff.mpr RingHom.Etale.isStableUnderBaseChange
  have hf : (RingHom.toMorphismProperty RingHom.Etale) (CommRingCat.ofHom f) := h
  exact CategoryTheory.MorphismProperty.of_isPushout
    (P := RingHom.toMorphismProperty RingHom.Etale) Q.flip hf

theorem wc_cg2_integral_points (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    (B : Type u) [CommRing B] [Algebra A B] (s : B →ₐ[A] A) (C : Type u) [CommRing C] [Algebra B C]
    [Algebra.IsIntegral B C] :
    letI : Algebra B (FractionRing A) := ((algebraMap A (FractionRing A)).comp s.toRingHom).toAlgebra
    ∃ Ψ : (TensorProduct B (FractionRing A) C →ₐ[FractionRing A] FractionRing A) →
        (C →ₐ[B] B ⧸ (RingHom.ker s) ^ 1), Function.Injective Ψ :=
by
  letI : Algebra B (FractionRing A) := ((algebraMap A (FractionRing A)).comp s.toRingHom).toAlgebra
  classical
  have hι : Function.Injective (algebraMap A (FractionRing A)) :=
    IsFractionRing.injective A (FractionRing A)
  have hBK : ∀ b : B, algebraMap B (FractionRing A) b = algebraMap A (FractionRing A) (s b) :=
    fun _ => rfl
  let χ : (TensorProduct B (FractionRing A) C →ₐ[FractionRing A] FractionRing A) →
      (C →ₐ[B] FractionRing A) := fun φ =>
    (φ.restrictScalars B).comp Algebra.TensorProduct.includeRight
  have hχ : ∀ φ c, χ φ c = φ (TensorProduct.tmul B (1 : FractionRing A) c) := fun _ _ => rfl
  have hdesc : ∀ φ c, ∃ y : A, algebraMap A (FractionRing A) y = χ φ c := by
    intro φ c
    have hcomp : (algebraMap A (FractionRing A)).comp s.toRingHom =
        (χ φ).toRingHom.comp (algebraMap B C) := by
      ext b
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, AlgHom.commutes]
      exact (hBK b).symm
    have hint : IsIntegral A (χ φ c) :=
      IsIntegral.map_of_comp_eq s.toRingHom (χ φ).toRingHom hcomp (Algebra.IsIntegral.isIntegral c)
    exact IsIntegrallyClosed.isIntegral_iff.mp hint
  choose f hf using hdesc
  have hsA : ∀ x : A, s (algebraMap A B x) = x := fun x => by
    rw [s.commutes, Algebra.algebraMap_self, RingHom.id_apply]
  let χ' : (TensorProduct B (FractionRing A) C →ₐ[FractionRing A] FractionRing A) → (C →+* A) :=
    fun φ =>
    { toFun := f φ
      map_one' := hι (by rw [hf, map_one, map_one])
      map_mul' := fun x y => hι (by rw [hf, map_mul, map_mul, hf, hf])
      map_zero' := hι (by rw [hf, map_zero, map_zero])
      map_add' := fun x y => hι (by rw [hf, map_add, map_add, hf, hf]) }
  have hfB : ∀ φ (b : B), f φ (algebraMap B C b) = s b := fun φ b =>
    hι (by rw [hf, AlgHom.commutes, hBK])
  let Ψ : (TensorProduct B (FractionRing A) C →ₐ[FractionRing A] FractionRing A) →
      (C →ₐ[B] B ⧸ (RingHom.ker s) ^ 1) := fun φ =>
    { toRingHom := (Ideal.Quotient.mk _).comp ((algebraMap A B).comp (χ' φ))
      commutes' := fun b => by
        show Ideal.Quotient.mk _ (algebraMap A B (f φ (algebraMap B C b))) =
          algebraMap B (B ⧸ (RingHom.ker s) ^ 1) b
        rw [hfB, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq, pow_one, RingHom.mem_ker,
          map_sub, hsA, sub_self] }
  refine ⟨Ψ, ?_⟩
  intro φ₁ φ₂ h
  have h1 : ∀ c, f φ₁ c = f φ₂ c := by
    intro c
    have := AlgHom.congr_fun h c
    change Ideal.Quotient.mk _ (algebraMap A B (f φ₁ c)) =
      Ideal.Quotient.mk _ (algebraMap A B (f φ₂ c)) at this
    rw [Ideal.Quotient.eq, pow_one, RingHom.mem_ker, map_sub, hsA, hsA, sub_eq_zero] at this
    exact this
  apply Algebra.TensorProduct.ext'
  intro k c
  have e : TensorProduct.tmul B k c = k • TensorProduct.tmul B (1 : FractionRing A) c := by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  rw [e, map_smul, map_smul, ← hχ, ← hχ, ← hf, ← hf, h1]

theorem wc_cg2_formal_section_lift (B : Type u) [CommRing B] (I : Ideal B) (a b : B)
    (hHP : ∀ n : ℕ, wcCg2HP B (B ⧸ I ^ n) a b) (C : Type u) [CommRing C] [Algebra B C]
    (ha : wcCg2LocEtale (algebraMap B C) (Submonoid.powers a))
    (hb : wcCg2LocEtale (algebraMap B C) (Submonoid.powers b))
    (φ₁ : C →ₐ[B] B ⧸ I ^ 1) :
    ∃ Φ : C →ₐ[B] AdicCompletion I B, (AdicCompletion.evalₐ I 1).comp Φ = φ₁ :=
by

  have hart : ∀ (R M : Type u) [CommRing R] [AddCommGroup M] [Module R M] (a b : R),
      wcCg2HP R M a b → ∀ (i j : ℕ) (m₁ m₂ : M), b ^ j • m₁ = a ^ i • m₂ →
        ∃ m, m₁ = a ^ i • m ∧ m₂ = b ^ j • m := by
    intro R M _ _ _ a b hHP
    have L : ∀ (j : ℕ) (m n : M), b ^ j • m = a • n → ∃ k, m = a • k := by
      intro j
      induction j with
      | zero => intro m n h; exact ⟨n, by simpa using h⟩
      | succ j ih =>
        intro m n h
        obtain ⟨k', hk'⟩ := hHP.2.2 (b ^ j • m) n (by rw [smul_smul, ← pow_succ']; exact h)
        exact ih m k' hk'
    intro i
    induction i with
    | zero => intro j m₁ m₂ h; exact ⟨m₁, by simp, by simpa using h.symm⟩
    | succ i ih =>
      intro j m₁ m₂ h
      obtain ⟨k, rfl⟩ := L j m₁ (a ^ i • m₂) (by rw [h, pow_succ', mul_smul])
      have h2 : b ^ j • k = a ^ i • m₂ := by
        apply hHP.1
        show a • (b ^ j • k) = a • (a ^ i • m₂)
        rw [smul_smul, mul_comm, ← smul_smul, h, pow_succ', mul_smul]
      obtain ⟨m, hm1, hm2⟩ := ih j k m₂ h2
      exact ⟨m, by rw [hm1, pow_succ', mul_smul], hm2⟩

  have s1 : ∀ (B : Type u) [CommRing B] (I : Ideal B) (C : Type u) [CommRing C] [Algebra B C]
      (φ₁ : C →ₐ[B] B ⧸ I ^ 1)
      (hstep : ∀ n : ℕ, 1 ≤ n → ∀ ψ : C →ₐ[B] B ⧸ I ^ n, ∃ χ : C →ₐ[B] B ⧸ I ^ (n + 1),
        (Ideal.Quotient.factorₐ B (Ideal.pow_le_pow_right (I := I) (Nat.le_succ n))).comp χ = ψ),
      ∃ Φ : C →ₐ[B] AdicCompletion I B, (AdicCompletion.evalₐ I 1).comp Φ = φ₁ := by
    intro B _ I C _ _ φ₁ hstep
    choose F hF using hstep
    let g : (k : ℕ) → C →ₐ[B] B ⧸ I ^ (k + 1) := fun k =>
      Nat.rec (motive := fun k => C →ₐ[B] B ⧸ I ^ (k + 1)) φ₁
        (fun k gk => F (k + 1) (by omega) gk) k
    have hg : ∀ k, (Ideal.Quotient.factorₐ B (Ideal.pow_le_pow_right (I := I)
        (Nat.le_succ (k + 1)))).comp (g (k + 1)) = g k := fun k => hF (k + 1) (by omega) (g k)
    let f : (n : ℕ) → C →ₐ[B] B ⧸ I ^ n := fun n =>
      Nat.casesOn (motive := fun n => C →ₐ[B] B ⧸ I ^ n) n
        ((Ideal.Quotient.factorₐ B (Ideal.pow_le_pow_right (I := I) (Nat.zero_le 1))).comp φ₁)
        (fun k => g k)
    have hf1 : ∀ n, (Ideal.Quotient.factorₐ B (Ideal.pow_le_pow_right (I := I)
        (Nat.le_succ n))).comp (f (n + 1)) = f n := by
      intro n
      cases n with
      | zero => rfl
      | succ k => exact hg k
    have hf : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorₐ B (Ideal.pow_le_pow_right (I := I) hle)).comp (f n) = f m := by
      intro m n hle
      induction n, hle using Nat.le_induction with
      | base =>
        apply AlgHom.ext
        intro c
        obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (f m c)
        rw [AlgHom.comp_apply, ← hy, Ideal.Quotient.factorₐ_apply_mk]
      | succ n hmn ih =>
        rw [← ih, ← hf1 n, ← AlgHom.comp_assoc, Ideal.Quotient.factorₐ_comp]
    refine ⟨AdicCompletion.liftAlgHom I f hf, ?_⟩
    apply AlgHom.ext
    intro c
    rw [AlgHom.comp_apply, AdicCompletion.evalₐ_liftAlgHom]
    rfl

  have s2 : ∀ (B : Type u) [CommRing B] (I : Ideal B) (n : ℕ) (hn : 1 ≤ n) (u v : B ⧸ I ^ (n + 1))
      (hu : Ideal.Quotient.factorₐ B (Ideal.pow_le_pow_right (I := I) (Nat.le_succ n)) u = 0)
      (hv : Ideal.Quotient.factorₐ B (Ideal.pow_le_pow_right (I := I) (Nat.le_succ n)) v = 0),
      u * v = 0 := by
    intro B _ I n hn u v hu hv
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective u
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective v
    rw [Ideal.Quotient.factorₐ_apply_mk, Ideal.Quotient.eq_zero_iff_mem] at hu hv
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    have h := Ideal.mul_mem_mul hu hv
    rw [← pow_add] at h
    exact Ideal.pow_le_pow_right (by omega) h

  have s8 : ∀ (B T : Type u) [CommRing B] [CommRing T] [Algebra B T] (x : B)
      (hx : IsSMulRegular T x),
      Function.Injective (algebraMap T (Localization.Away (algebraMap B T x))) := by
    intro B T _ _ _ x hx t t' h
    rw [IsLocalization.eq_iff_exists (Submonoid.powers (algebraMap B T x))] at h
    obtain ⟨⟨c, hc⟩, hc'⟩ := h
    obtain ⟨m, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hc
    apply hx.pow m
    simp only [Algebra.smul_def, map_pow]
    exact hc'

  have s3a : ∀ (B C : Type u) [CommRing B] [CommRing C] [Algebra B C] (x : B)
      (h : wcCg2LocEtale (algebraMap B C) (Submonoid.powers x)),
      Algebra.FormallyEtale B (Localization ((Submonoid.powers x).map (algebraMap B C))) := by
    intro B C _ _ _ x h
    let μ : Localization (Submonoid.powers x) →+*
        Localization ((Submonoid.powers x).map (algebraMap B C)) :=
      IsLocalization.map _ (algebraMap B C) (Submonoid.powers x).le_comap_map
    letI : Algebra (Localization (Submonoid.powers x))
        (Localization ((Submonoid.powers x).map (algebraMap B C))) := μ.toAlgebra
    haveI : Algebra.Etale (Localization (Submonoid.powers x))
        (Localization ((Submonoid.powers x).map (algebraMap B C))) := h
    haveI : Algebra.FormallyEtale B (Localization (Submonoid.powers x)) :=
      Algebra.FormallyEtale.of_isLocalization (Submonoid.powers x)
    haveI : IsScalarTower B (Localization (Submonoid.powers x))
        (Localization ((Submonoid.powers x).map (algebraMap B C))) :=
      IsScalarTower.of_algebraMap_eq (fun β => by
        show _ = μ (algebraMap B _ β)
        rw [IsLocalization.map_eq, IsScalarTower.algebraMap_apply B C
          (Localization ((Submonoid.powers x).map (algebraMap B C))) β])
    exact Algebra.FormallyEtale.comp B (Localization (Submonoid.powers x)) _

  have s3 : ∀ (B C : Type u) [CommRing B] [CommRing C] [Algebra B C] (x : B)
      (hx : Algebra.FormallyEtale B (Localization ((Submonoid.powers x).map (algebraMap B C))))
      (S S' : Type u) [CommRing S] [CommRing S'] [Algebra B S] [Algebra B S']
      (hxS : IsUnit (algebraMap B S x)) (π : S →ₐ[B] S') (hπ : Function.Surjective π)
      (hsq : ∀ u v : S, π u = 0 → π v = 0 → u * v = 0) (ψ : C →ₐ[B] S'),
      ∃! χ : C →ₐ[B] S, π.comp χ = ψ := by
    intro B C _ _ _ x hx S S' _ _ _ _ hxS π hπ hsq ψ
    haveI := hx
    have hK : IsNilpotent (RingHom.ker (π : S →+* S')) := by
      refine ⟨2, ?_⟩
      rw [pow_two, Ideal.zero_eq_bot, eq_bot_iff, Ideal.mul_le]
      intro r hr s hs
      rw [RingHom.mem_ker] at hr hs
      exact (Ideal.mem_bot).mpr (hsq r s hr hs)
    have hunits : ∀ (R : Type u) [CommRing R] [Algebra B R], IsUnit (algebraMap B R x) →
        ∀ (f : C →ₐ[B] R) (y : (Submonoid.powers x).map (algebraMap B C)), IsUnit (f y) := by
      intro R _ _ hu f y
      obtain ⟨y, hy⟩ := y
      obtain ⟨z, hz, rfl⟩ := Submonoid.mem_map.mp hy
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hz
      show IsUnit (f (algebraMap B C (x ^ k)))
      rw [AlgHom.commutes, map_pow]
      exact hu.pow k
    have hxS' : IsUnit (algebraMap B S' x) := by rw [← π.commutes]; exact hxS.map π
    have huniq : ∀ χ₁ χ₂ : C →ₐ[B] S, π.comp χ₁ = ψ → π.comp χ₂ = ψ → χ₁ = χ₂ := by
      intro χ₁ χ₂ h₁ h₂
      let e₁ : Localization ((Submonoid.powers x).map (algebraMap B C)) →ₐ[B] S :=
        IsLocalization.liftAlgHom (M := (Submonoid.powers x).map (algebraMap B C)) (f := χ₁)
          (hunits S hxS χ₁)
      let e₂ : Localization ((Submonoid.powers x).map (algebraMap B C)) →ₐ[B] S :=
        IsLocalization.liftAlgHom (M := (Submonoid.powers x).map (algebraMap B C)) (f := χ₂)
          (hunits S hxS χ₂)
      have he₁ : ∀ c, e₁ (algebraMap C _ c) = χ₁ c := fun c => by
        rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]; rfl
      have he₂ : ∀ c, e₂ (algebraMap C _ c) = χ₂ c := fun c => by
        rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]; rfl
      have hpe : π.comp e₁ = π.comp e₂ := by
        apply AlgHom.coe_ringHom_injective
        apply IsLocalization.ringHom_ext ((Submonoid.powers x).map (algebraMap B C))
        ext c
        have e1 := AlgHom.congr_fun h₁ c
        have e2 := AlgHom.congr_fun h₂ c
        simp only [AlgHom.comp_apply] at e1 e2
        simp only [RingHom.comp_apply, AlgHom.coe_toRingHom, AlgHom.comp_apply, he₁, he₂, e1, e2]
      have he := Algebra.FormallyUnramified.lift_unique' π hK e₁ e₂ hpe
      apply AlgHom.ext
      intro c
      rw [← he₁, ← he₂, he]
    let ψx : Localization ((Submonoid.powers x).map (algebraMap B C)) →ₐ[B] S' :=
      IsLocalization.liftAlgHom (M := (Submonoid.powers x).map (algebraMap B C)) (f := ψ)
        (hunits S' hxS' ψ)
    have hψx : ∀ c, ψx (algebraMap C _ c) = ψ c := fun c => by
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]; rfl
    have hex : π.comp ((Algebra.FormallySmooth.liftOfSurjective ψx π hπ hK).comp
        (IsScalarTower.toAlgHom B C
          (Localization ((Submonoid.powers x).map (algebraMap B C))))) = ψ := by
      apply AlgHom.ext
      intro c
      have h1 := Algebra.FormallySmooth.comp_liftOfSurjective ψx π hπ hK
      have h2 := AlgHom.congr_fun h1 (algebraMap C _ c)
      simp only [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom'] at h2 ⊢
      rw [h2, hψx]
    exact ⟨_, hex, fun χ' hχ' => huniq χ' _ hχ' hex⟩

  have s4 : ∀ (B T T' : Type u) [CommRing B] [CommRing T] [CommRing T'] [Algebra B T]
      [Algebra B T'] (π : T →ₐ[B] T') (hπ : Function.Surjective π)
      (hsq : ∀ u v : T, π u = 0 → π v = 0 → u * v = 0) (x : B),
      ∃ πx : Localization.Away (algebraMap B T x) →ₐ[B] Localization.Away (algebraMap B T' x),
        (∀ t : T, πx (algebraMap T _ t) = algebraMap T' _ (π t)) ∧ Function.Surjective πx ∧
        ∀ u v, πx u = 0 → πx v = 0 → u * v = 0 := by
    intro B T T' _ _ _ _ _ π hπ hsq x
    have hπx : π (algebraMap B T x) = algebraMap B T' x := π.commutes x
    let f : T →ₐ[B] Localization.Away (algebraMap B T' x) :=
      (IsScalarTower.toAlgHom B T' (Localization.Away (algebraMap B T' x))).comp π
    have hf : ∀ t, f t = algebraMap T' (Localization.Away (algebraMap B T' x)) (π t) :=
      fun t => rfl
    have hu' : IsUnit (algebraMap T' (Localization.Away (algebraMap B T' x))
        (algebraMap B T' x)) :=
      IsLocalization.Away.algebraMap_isUnit _
    have hfu : ∀ y : Submonoid.powers (algebraMap B T x), IsUnit (f y) := by
      rintro ⟨y, hy⟩
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hy
      show IsUnit (f (algebraMap B T x ^ k))
      rw [map_pow, hf, hπx]
      exact hu'.pow k
    let πx : Localization.Away (algebraMap B T x) →ₐ[B] Localization.Away (algebraMap B T' x) :=
      IsLocalization.liftAlgHom (M := Submonoid.powers (algebraMap B T x)) hfu
    have hπxt : ∀ t : T, πx (algebraMap T _ t) = algebraMap T' _ (π t) := fun t => by
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]; rfl
    refine ⟨πx, hπxt, ?_, ?_⟩
    · intro z'
      obtain ⟨k, t', ht'⟩ := IsLocalization.Away.surj (algebraMap B T' x) z'
      obtain ⟨t, rfl⟩ := hπ t'
      have hmem : algebraMap B T x ^ k ∈ Submonoid.powers (algebraMap B T x) :=
        Submonoid.pow_mem _ (Submonoid.mem_powers _) k
      have hspec : IsLocalization.mk' (Localization.Away (algebraMap B T x)) t ⟨_, hmem⟩ *
          algebraMap T _ (algebraMap B T x ^ k) = algebraMap T _ t :=
        IsLocalization.mk'_spec _ _ _
      refine ⟨IsLocalization.mk' (Localization.Away (algebraMap B T x)) t ⟨_, hmem⟩, ?_⟩
      apply (hu'.pow k).mul_right_cancel
      have key : (algebraMap T' (Localization.Away (algebraMap B T' x)) (algebraMap B T' x)) ^ k =
          πx (algebraMap T _ (algebraMap B T x ^ k)) := by
        rw [hπxt, map_pow, hπx, map_pow]
      rw [ht', key, ← map_mul, hspec, hπxt]
    · intro u v hu hv
      obtain ⟨⟨t, s⟩, hts⟩ := IsLocalization.surj (Submonoid.powers (algebraMap B T x)) u
      obtain ⟨⟨t2, s2⟩, hts2⟩ := IsLocalization.surj (Submonoid.powers (algebraMap B T x)) v
      dsimp only at hts hts2
      have h1 : algebraMap T' (Localization.Away (algebraMap B T' x)) (π t) = 0 := by
        rw [← hπxt, ← hts, map_mul, hu, zero_mul]
      have h2 : algebraMap T' (Localization.Away (algebraMap B T' x)) (π t2) = 0 := by
        rw [← hπxt, ← hts2, map_mul, hv, zero_mul]
      obtain ⟨⟨m1, hm1⟩, hm1'⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (algebraMap B T' x)) _ (π t)).mp h1
      obtain ⟨⟨m2, hm2⟩, hm2'⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (algebraMap B T' x)) _ (π t2)).mp h2
      obtain ⟨k1, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm1
      obtain ⟨k2, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm2
      have h1' : π (algebraMap B T x ^ k1 * t) = 0 := by
        rw [map_mul, map_pow, hπx]; exact hm1'
      have h2' : π (algebraMap B T x ^ k2 * t2) = 0 := by
        rw [map_mul, map_pow, hπx]; exact hm2'
      have h := hsq _ _ h1' h2'
      have hU : IsUnit (algebraMap T (Localization.Away (algebraMap B T x)) ↑s *
          algebraMap T (Localization.Away (algebraMap B T x)) ↑s2 *
          (algebraMap T (Localization.Away (algebraMap B T x)) (algebraMap B T x) ^ k1 *
          algebraMap T (Localization.Away (algebraMap B T x)) (algebraMap B T x) ^ k2)) :=
        ((IsLocalization.map_units _ s).mul (IsLocalization.map_units _ s2)).mul
          (((IsLocalization.Away.algebraMap_isUnit _).pow k1).mul
            ((IsLocalization.Away.algebraMap_isUnit _).pow k2))
      apply hU.mul_left_eq_zero.mp
      have e : u * v * (algebraMap T (Localization.Away (algebraMap B T x)) ↑s *
          algebraMap T (Localization.Away (algebraMap B T x)) ↑s2 *
          (algebraMap T (Localization.Away (algebraMap B T x)) (algebraMap B T x) ^ k1 *
          algebraMap T (Localization.Away (algebraMap B T x)) (algebraMap B T x) ^ k2)) =
          algebraMap T (Localization.Away (algebraMap B T x))
            ((algebraMap B T x ^ k1 * t) * (algebraMap B T x ^ k2 * t2)) := by
        simp only [map_mul, map_pow]
        rw [← hts, ← hts2]
        ring
      rw [e, h, map_zero]

  have s5 : ∀ (B T : Type u) [CommRing B] [CommRing T] [Algebra B T] (a b : B)
      (hHP : wcCg2HP B T a b)
      (P : Type u) [CommRing P] [Algebra T P] [IsLocalization.Away (algebraMap B T (a * b)) P]
      (ρa : Localization.Away (algebraMap B T a) →+* P)
      (ρb : Localization.Away (algebraMap B T b) →+* P)
      (hρa : ∀ t : T, ρa (algebraMap T _ t) = algebraMap T P t)
      (hρb : ∀ t : T, ρb (algebraMap T _ t) = algebraMap T P t)
      (z : Localization.Away (algebraMap B T a)) (w : Localization.Away (algebraMap B T b))
      (hzw : ρa z = ρb w), ∃ t : T, algebraMap T _ t = z ∧ algebraMap T _ t = w := by
    intro B T _ _ _ a b hHP P _ _ _ ρa ρb hρa hρb z w hzw
    obtain ⟨i, t₁, h₁⟩ := IsLocalization.Away.surj (algebraMap B T a) z
    obtain ⟨j, t₂, h₂⟩ := IsLocalization.Away.surj (algebraMap B T b) w
    have e1 : algebraMap T P t₁ = ρa z * algebraMap T P (algebraMap B T a) ^ i := by
      rw [← hρa t₁, ← h₁, map_mul, map_pow, hρa]
    have e2 : algebraMap T P t₂ = ρb w * algebraMap T P (algebraMap B T b) ^ j := by
      rw [← hρb t₂, ← h₂, map_mul, map_pow, hρb]
    have hP : algebraMap T P (algebraMap B T b ^ j * t₁) =
        algebraMap T P (algebraMap B T a ^ i * t₂) := by
      rw [map_mul, map_mul, map_pow, map_pow, e1, e2, hzw]; ring
    obtain ⟨⟨c, hc⟩, hc'⟩ :=
      (IsLocalization.eq_iff_exists (Submonoid.powers (algebraMap B T (a * b))) P).mp hP
    obtain ⟨m, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hc
    have hreg : IsSMulRegular T ((a * b) ^ m) := (hHP.1.mul hHP.2.1).pow m
    have hbt : b ^ j • t₁ = a ^ i • t₂ := by
      apply hreg
      simp only [Algebra.smul_def, map_pow, map_mul] at hc' ⊢
      linear_combination hc'
    obtain ⟨t, ht₁, ht₂⟩ := hart B T a b hHP i j t₁ t₂ hbt
    refine ⟨t, ?_, ?_⟩
    · apply ((IsLocalization.Away.algebraMap_isUnit (algebraMap B T a)
        (S := Localization.Away (algebraMap B T a))).pow i).mul_right_cancel
      rw [h₁, ht₁, Algebra.smul_def]
      simp only [map_mul, map_pow]
      ring
    · apply ((IsLocalization.Away.algebraMap_isUnit (algebraMap B T b)
        (S := Localization.Away (algebraMap B T b))).pow j).mul_right_cancel
      rw [h₂, ht₂, Algebra.smul_def]
      simp only [map_mul, map_pow]
      ring

  have s6 : ∀ (B T T' C : Type u) [CommRing B] [CommRing T] [CommRing T'] [CommRing C]
      [Algebra B T] [Algebra B T'] [Algebra B C] (a b : B)
      (hHP : wcCg2HP B T a b) (hreg : IsSMulRegular T' a)
      (π : T →ₐ[B] T') (hπ : Function.Surjective π)
      (hsq : ∀ u v : T, π u = 0 → π v = 0 → u * v = 0)
      (hLa : ∀ (S S' : Type u) [CommRing S] [CommRing S'] [Algebra B S] [Algebra B S'],
        IsUnit (algebraMap B S a) → ∀ π' : S →ₐ[B] S', Function.Surjective π' →
        (∀ u v : S, π' u = 0 → π' v = 0 → u * v = 0) →
        ∀ ψ' : C →ₐ[B] S', ∃! χ' : C →ₐ[B] S, π'.comp χ' = ψ')
      (hLb : ∀ (S S' : Type u) [CommRing S] [CommRing S'] [Algebra B S] [Algebra B S'],
        IsUnit (algebraMap B S b) → ∀ π' : S →ₐ[B] S', Function.Surjective π' →
        (∀ u v : S, π' u = 0 → π' v = 0 → u * v = 0) →
        ∀ ψ' : C →ₐ[B] S', ∃! χ' : C →ₐ[B] S, π'.comp χ' = ψ')
      (ψ : C →ₐ[B] T'), ∃ χ : C →ₐ[B] T, π.comp χ = ψ := by
    intro B T T' C _ _ _ _ _ _ _ a b hHP hreg π hπ hsq hLa hLb ψ
    have hres : ∀ (R : Type u) [CommRing R] [Algebra B R] (x z : B),
        IsUnit (algebraMap R (Localization.Away (algebraMap B R z)) (algebraMap B R x)) →
        ∃ ρ : Localization.Away (algebraMap B R x) →ₐ[B] Localization.Away (algebraMap B R z),
          ∀ r : R, ρ (algebraMap R _ r) = algebraMap R _ r := by
      intro R _ _ x z hu
      have hfu : ∀ y : Submonoid.powers (algebraMap B R x),
          IsUnit ((IsScalarTower.toAlgHom B R (Localization.Away (algebraMap B R z))) y) := by
        rintro ⟨y, hy⟩
        obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hy
        rw [IsScalarTower.coe_toAlgHom', map_pow]
        exact hu.pow k
      refine ⟨IsLocalization.liftAlgHom (M := Submonoid.powers (algebraMap B R x)) hfu, ?_⟩
      intro r
      rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
      rfl
    have hunitL : ∀ (R : Type u) [CommRing R] [Algebra B R] (x y : B),
        IsUnit (algebraMap R (Localization.Away (algebraMap B R (x * y))) (algebraMap B R x)) := by
      intro R _ _ x y
      have h := IsLocalization.Away.algebraMap_isUnit (algebraMap B R (x * y))
        (S := Localization.Away (algebraMap B R (x * y)))
      have h' : IsUnit (algebraMap R (Localization.Away (algebraMap B R (x * y)))
          (algebraMap B R x) *
          algebraMap R (Localization.Away (algebraMap B R (x * y))) (algebraMap B R y)) := by
        rw [← map_mul (algebraMap R (Localization.Away (algebraMap B R (x * y)))),
          ← map_mul (algebraMap B R)]
        exact h
      exact isUnit_of_mul_isUnit_left h'
    have hunitR : ∀ (R : Type u) [CommRing R] [Algebra B R] (x y : B),
        IsUnit (algebraMap R (Localization.Away (algebraMap B R (x * y))) (algebraMap B R y)) := by
      intro R _ _ x y
      have h := IsLocalization.Away.algebraMap_isUnit (algebraMap B R (x * y))
        (S := Localization.Away (algebraMap B R (x * y)))
      have h' : IsUnit (algebraMap R (Localization.Away (algebraMap B R (x * y)))
          (algebraMap B R x) *
          algebraMap R (Localization.Away (algebraMap B R (x * y))) (algebraMap B R y)) := by
        rw [← map_mul (algebraMap R (Localization.Away (algebraMap B R (x * y)))),
          ← map_mul (algebraMap B R)]
        exact h
      exact isUnit_of_mul_isUnit_right h'
    have hunitB : ∀ (R : Type u) [CommRing R] [Algebra B R] (x z : B),
        IsUnit (algebraMap R (Localization.Away (algebraMap B R z)) (algebraMap B R x)) →
        IsUnit (algebraMap B (Localization.Away (algebraMap B R z)) x) := by
      intro R _ _ x z hu
      rw [IsScalarTower.algebraMap_apply B R (Localization.Away (algebraMap B R z))]
      exact hu
    have hself : ∀ (R : Type u) [CommRing R] [Algebra B R] (x : B),
        IsUnit (algebraMap R (Localization.Away (algebraMap B R x)) (algebraMap B R x)) :=
      fun R _ _ x => IsLocalization.Away.algebraMap_isUnit _
    obtain ⟨πa, hπa, hπas, hπasq⟩ := s4 B T T' π hπ hsq a
    obtain ⟨πb, hπb, hπbs, hπbsq⟩ := s4 B T T' π hπ hsq b
    obtain ⟨πab, hπab, hπabs, hπabsq⟩ := s4 B T T' π hπ hsq (a * b)
    obtain ⟨ρa, hρa⟩ := hres T a (a * b) (hunitL T a b)
    obtain ⟨ρb, hρb⟩ := hres T b (a * b) (hunitR T a b)
    obtain ⟨ρa', hρa'⟩ := hres T' a (a * b) (hunitL T' a b)
    obtain ⟨ρb', hρb'⟩ := hres T' b (a * b) (hunitR T' a b)
    obtain ⟨χa, hχa, -⟩ := hLa _ _ (hunitB T a a (hself T a)) πa hπas hπasq
      ((IsScalarTower.toAlgHom B T' (Localization.Away (algebraMap B T' a))).comp ψ)
    obtain ⟨χb, hχb, -⟩ := hLb _ _ (hunitB T b b (hself T b)) πb hπbs hπbsq
      ((IsScalarTower.toAlgHom B T' (Localization.Away (algebraMap B T' b))).comp ψ)
    have sqa : ∀ z, πab (ρa z) = ρa' (πa z) := by
      intro z
      have h : (πab.comp ρa : Localization.Away (algebraMap B T a) →+*
          Localization.Away (algebraMap B T' (a * b))) = (ρa'.comp πa : _ →+* _) := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (algebraMap B T a))
        ext t
        simp only [RingHom.comp_apply, AlgHom.coe_toRingHom, AlgHom.comp_apply, hρa, hπa, hπab,
          hρa']
      exact congrArg (fun F : Localization.Away (algebraMap B T a) →+*
          Localization.Away (algebraMap B T' (a * b)) => F z) h
    have sqb : ∀ z, πab (ρb z) = ρb' (πb z) := by
      intro z
      have h : (πab.comp ρb : Localization.Away (algebraMap B T b) →+*
          Localization.Away (algebraMap B T' (a * b))) = (ρb'.comp πb : _ →+* _) := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (algebraMap B T b))
        ext t
        simp only [RingHom.comp_apply, AlgHom.coe_toRingHom, AlgHom.comp_apply, hρb, hπb, hπab,
          hρb']
      exact congrArg (fun F : Localization.Away (algebraMap B T b) →+*
          Localization.Away (algebraMap B T' (a * b)) => F z) h
    have hA : πab.comp (ρa.comp χa) =
        (IsScalarTower.toAlgHom B T' (Localization.Away (algebraMap B T' (a * b)))).comp ψ := by
      apply AlgHom.ext
      intro c
      have h := AlgHom.congr_fun hχa c
      simp only [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom'] at h ⊢
      rw [sqa, h, hρa']
    have hB : πab.comp (ρb.comp χb) =
        (IsScalarTower.toAlgHom B T' (Localization.Away (algebraMap B T' (a * b)))).comp ψ := by
      apply AlgHom.ext
      intro c
      have h := AlgHom.congr_fun hχb c
      simp only [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom'] at h ⊢
      rw [sqb, h, hρb']
    obtain ⟨_, _, huniq⟩ := hLa _ _ (hunitB T a (a * b) (hunitL T a b)) πab hπabs hπabsq
      ((IsScalarTower.toAlgHom B T' (Localization.Away (algebraMap B T' (a * b)))).comp ψ)
    have hagree : ρa.comp χa = ρb.comp χb := by
      rw [huniq _ hA, huniq _ hB]
    let ιa := IsScalarTower.toAlgHom B T (Localization.Away (algebraMap B T a))
    have hιa : ∀ t, ιa t = algebraMap T _ t := fun t => rfl
    have hinj : Function.Injective ιa := by
      intro t t' h
      exact s8 B T a hHP.1 h
    have hmem : ∀ c, χa c ∈ ιa.range := by
      intro c
      obtain ⟨t, ht, -⟩ := s5 B T a b hHP (Localization.Away (algebraMap B T (a * b)))
        ρa.toRingHom ρb.toRingHom (fun t => hρa t) (fun t => hρb t) (χa c) (χb c)
        (by have h := AlgHom.congr_fun hagree c; simp only [AlgHom.comp_apply] at h; exact h)
      exact ⟨t, ht⟩
    let χ : C →ₐ[B] T :=
      (AlgEquiv.ofInjective ιa hinj).symm.toAlgHom.comp (χa.codRestrict ιa.range hmem)
    have hχ : ∀ c, algebraMap T _ (χ c) = χa c := by
      intro c
      rw [← hιa]
      have h := AlgEquiv.ofInjective_apply ιa hinj ((AlgEquiv.ofInjective ιa hinj).symm
        (χa.codRestrict ιa.range hmem c))
      rw [AlgEquiv.apply_symm_apply] at h
      exact h.symm
    refine ⟨χ, ?_⟩
    apply AlgHom.ext
    intro c
    apply s8 B T' a hreg
    rw [AlgHom.comp_apply, ← hπa, hχ]
    have h := AlgHom.congr_fun hχa c
    simpa only [AlgHom.comp_apply, IsScalarTower.coe_toAlgHom'] using h

  have hEa := s3a B C a ha
  have hEb := s3a B C b hb
  have hstep : ∀ n : ℕ, 1 ≤ n → ∀ ψ : C →ₐ[B] B ⧸ I ^ n, ∃ χ : C →ₐ[B] B ⧸ I ^ (n + 1),
      (Ideal.Quotient.factorₐ B (Ideal.pow_le_pow_right (I := I) (Nat.le_succ n))).comp χ = ψ := by
    intro n hn ψ
    exact s6 B (B ⧸ I ^ (n + 1)) (B ⧸ I ^ n) C a b (hHP (n + 1)) (hHP n).1
      (Ideal.Quotient.factorₐ B (Ideal.pow_le_pow_right (I := I) (Nat.le_succ n)))
      (fun y => by
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact ⟨Ideal.Quotient.mk _ x, Ideal.Quotient.factorₐ_apply_mk _ _ _⟩)
      (s2 B I n hn) (s3 B C a hEa) (s3 B C b hEb) ψ
  exact s1 B I C φ₁ hstep

theorem wc_cg2_orthogonal_points (R : Type u) [CommRing R] [IsDomain R] (D : Type u) [CommRing D]
    [Algebra R D] (a : R) (ha : a ≠ 0)
    (hE : wcCg2LocEtale (algebraMap R D) (Submonoid.powers a))
    (n : ℕ) (ψ : Fin n → (D →ₐ[R] R)) (hψ : Function.Injective ψ) :
    ∃ (k : ℕ) (m : Fin n → D), ∀ c c' : Fin n, ψ c' (m c) = if c = c' then a ^ k else 0 :=
by
  classical
  have hM : Submonoid.powers a ≤ nonZeroDivisors R :=
    powers_le_nonZeroDivisors_of_noZeroDivisors ha
  have hinj : Function.Injective (algebraMap R (Localization (Submonoid.powers a))) :=
    IsLocalization.injective _ hM
  haveI : IsDomain (Localization (Submonoid.powers a)) := IsLocalization.isDomain_localization hM
  let Φ : Localization (Submonoid.powers a) →+*
      Localization ((Submonoid.powers a).map (algebraMap R D)) :=
    IsLocalization.map (Localization ((Submonoid.powers a).map (algebraMap R D))) (algebraMap R D)
      (Submonoid.powers a).le_comap_map
  letI : Algebra (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap R D))) := Φ.toAlgebra
  haveI : Algebra.Etale (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap R D))) := hE

  have hc : ∀ c, (Submonoid.powers a).map (algebraMap R D) ≤
      (Submonoid.powers a).comap (ψ c : D →+* R) := by
    intro c y hy
    obtain ⟨x, hx, rfl⟩ := Submonoid.mem_map.mp hy
    show ψ c (algebraMap R D x) ∈ Submonoid.powers a
    rw [AlgHom.commutes]
    exact hx
  let χ : Fin n → (Localization ((Submonoid.powers a).map (algebraMap R D)) →+*
      Localization (Submonoid.powers a)) := fun c =>
    IsLocalization.map (Localization (Submonoid.powers a)) (ψ c : D →+* R) (hc c)
  have htr : ∀ c (x : D), χ c (algebraMap D _ x) = algebraMap R _ (ψ c x) := fun c x =>
    IsLocalization.map_eq (hc c) x
  have hsec : ∀ c (r : Localization (Submonoid.powers a)), χ c (Φ r) = r := by
    intro c r
    have h1 : (χ c).comp Φ = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers a)
      ext x
      simp only [RingHom.comp_apply, RingHom.id_apply]
      have h2 : Φ (algebraMap R _ x) = algebraMap D _ (algebraMap R D x) :=
        IsLocalization.map_eq _ x
      rw [h2, htr, AlgHom.commutes]
      rfl
    exact RingHom.congr_fun h1 r
  let χ' : Fin n → (Localization ((Submonoid.powers a).map (algebraMap R D)) →ₐ[Localization
      (Submonoid.powers a)] Localization (Submonoid.powers a)) := fun c =>
    { χ c with commutes' := fun r => hsec c r }
  have hχ' : Function.Injective χ' := by
    intro c c' hcc
    apply hψ
    apply AlgHom.ext
    intro x
    apply hinj
    rw [← htr, ← htr]
    exact DFunLike.congr_fun hcc (algebraMap D _ x)

  have s1 : ∃ e : Fin n → Localization ((Submonoid.powers a).map (algebraMap R D)),
      ∀ c c' : Fin n, χ' c' (e c) = if c = c' then 1 else 0 := by
    obtain ⟨t, ht1, ht2⟩ :=
      (Algebra.FormallyUnramified.iff_exists_tensorProduct
        (R := Localization (Submonoid.powers a))
        (S := Localization ((Submonoid.powers a).map (algebraMap R D)))).mp inferInstance
    let g := fun c => Algebra.TensorProduct.lift
      ((Algebra.ofId (Localization (Submonoid.powers a))
        (Localization ((Submonoid.powers a).map (algebraMap R D)))).comp (χ' c))
      (AlgHom.id (Localization (Submonoid.powers a))
        (Localization ((Submonoid.powers a).map (algebraMap R D))))
      (fun _ _ => Commute.all _ _)
    let h := fun c c' => Algebra.TensorProduct.lift (χ' c) (χ' c') (fun _ _ => Commute.all _ _)
    have E1 : ∀ c c', (χ' c').comp (g c) = h c c' := by
      intro c c'
      apply Algebra.TensorProduct.ext'
      intro x y
      simp [g, h, Algebra.TensorProduct.lift_tmul]
    have E2 : ∀ c, h c c = (χ' c).comp (Algebra.TensorProduct.lmul' _) := by
      intro c
      apply Algebra.TensorProduct.ext'
      intro x y
      simp [h, Algebra.TensorProduct.lift_tmul, Algebra.TensorProduct.lmul'_apply_tmul]
    refine ⟨fun c => g c t, fun c c' => ?_⟩
    have key : χ' c' (g c t) = h c c' t := by
      rw [← E1 c c']; rfl
    rw [key]
    split_ifs with hcc
    · subst hcc
      rw [E2, AlgHom.comp_apply, ht2, map_one]
    · have hne : χ' c ≠ χ' c' := fun heq => hcc (hχ' heq)
      obtain ⟨s, hs⟩ := DFunLike.ne_iff.mp hne
      have h0 := congrArg (h c c') (ht1 s)
      rw [map_mul, map_sub, map_zero] at h0
      simp only [h, Algebra.TensorProduct.lift_tmul, map_one, one_mul, mul_one] at h0
      have hd : χ' c' s - χ' c s ≠ 0 := sub_ne_zero.mpr (fun e => hs e.symm)
      exact (mul_eq_zero.mp h0).resolve_left hd
  obtain ⟨e, he⟩ := s1

  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples
    ((Submonoid.powers a).map (algebraMap R D)) Finset.univ e
  choose m hm using fun c => (RingHom.mem_rangeS).mp (hb c (Finset.mem_univ c))
  obtain ⟨x, hx, hxb⟩ := Submonoid.mem_map.mp b.2
  obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hx
  refine ⟨k, m, fun c c' => ?_⟩
  apply hinj
  have hec : χ c' (e c) = if c = c' then 1 else 0 := he c c'
  rw [← htr, hm, Algebra.smul_def, map_mul, ← hxb, htr, AlgHom.commutes, hec]
  split_ifs <;> simp

theorem wc_cg2_torsionfree_of_locEtale (R : Type u) [CommRing R] [IsDomain R] (D : Type u)
    [CommRing D] [Algebra R D] (a : R) (ha : a ≠ 0) (hreg : IsSMulRegular D a)
    (hE : wcCg2LocEtale (algebraMap R D) (Submonoid.powers a)) :
    ∀ (r : R) (x : D), r ≠ 0 → r • x = 0 → x = 0 :=
by
  classical
  intro r x hr hx
  have hM : Submonoid.powers a ≤ nonZeroDivisors R :=
    powers_le_nonZeroDivisors_of_noZeroDivisors ha
  let φa : Localization (Submonoid.powers a) →+*
      Localization ((Submonoid.powers a).map (algebraMap R D)) :=
    IsLocalization.map (Localization ((Submonoid.powers a).map (algebraMap R D)))
      (algebraMap R D) (Submonoid.le_comap_map (Submonoid.powers a))
  have hE' : φa.Etale := hE
  letI : Algebra (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap R D))) := φa.toAlgebra
  haveI : Algebra.Etale (Localization (Submonoid.powers a))
      (Localization ((Submonoid.powers a).map (algebraMap R D))) := hE'.toAlgebra
  haveI : IsDomain (Localization (Submonoid.powers a)) :=
    IsLocalization.isDomain_localization hM
  have hinj := IsLocalization.injective (Localization (Submonoid.powers a)) hM
  have hr' : algebraMap R (Localization (Submonoid.powers a)) r ≠ 0 := by
    intro h
    apply hr
    apply hinj
    rw [h, map_zero]
  have hnzd : algebraMap R (Localization (Submonoid.powers a)) r ∈
      nonZeroDivisors (Localization (Submonoid.powers a)) :=
    mem_nonZeroDivisors_of_ne_zero hr'
  have hsreg := Module.Flat.isSMulRegular_of_nonZeroDivisors
    (M := Localization ((Submonoid.powers a).map (algebraMap R D))) hnzd
  have hcomp : algebraMap R (Localization (Submonoid.powers a)) r •
      algebraMap D (Localization ((Submonoid.powers a).map (algebraMap R D))) x = 0 := by
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
    have h1 : φa (algebraMap R (Localization (Submonoid.powers a)) r) =
        algebraMap D (Localization ((Submonoid.powers a).map (algebraMap R D)))
          (algebraMap R D r) :=
      IsLocalization.map_eq _ r
    rw [h1, ← map_mul, ← Algebra.smul_def, hx, map_zero]
  have hx0 : algebraMap D (Localization ((Submonoid.powers a).map (algebraMap R D))) x = 0 :=
    hsreg.right_eq_zero_of_smul hcomp
  rw [IsLocalization.map_eq_zero_iff ((Submonoid.powers a).map (algebraMap R D))] at hx0
  obtain ⟨⟨m, hm⟩, hmx⟩ := hx0
  obtain ⟨y, hy, rfl⟩ := Submonoid.mem_map.mp hm
  obtain ⟨n, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hy
  have hax : (a ^ n) • x = 0 := by
    rw [Algebra.smul_def]
    exact hmx
  exact (hreg.pow n).right_eq_zero_of_smul hax

theorem wc_cg2_fg_tensor_field_trivial (R : Type u) [CommRing R] (N : Type u) [AddCommGroup N]
    [Module R N] [Module.Finite R N] (hTF : ∀ (r : R) (y : N), r ≠ 0 → r • y = 0 → y = 0)
    (K : Type u) [Field K] [Algebra R K] (h : Subsingleton (TensorProduct R K N)) :
    Subsingleton N :=
by
  classical
  by_contra hN
  rw [not_subsingleton_iff_nontrivial] at hN
  let p : PrimeSpectrum R := ⟨RingHom.ker (algebraMap R K), RingHom.ker_isPrime _⟩
  haveI hpI : p.asIdeal.IsPrime := p.isPrime
  have hann : Module.annihilator R N ≤ p.asIdeal := by
    intro r hr
    by_contra hr0
    have hr0' : r ≠ 0 := fun h0 => hr0 (h0 ▸ Ideal.zero_mem _)
    obtain ⟨y, hy⟩ := exists_ne (0 : N)
    exact hy (hTF r y hr0' (Module.mem_annihilator.mp hr y))
  have hsupp : p ∈ Module.support R N := Module.mem_support_iff_of_finite.mpr hann
  have hk : Nontrivial (TensorProduct R p.asIdeal.ResidueField N) :=
    (Module.mem_support_iff_nontrivial_residueField_tensorProduct p).mp hsupp
  have h₁ : p.asIdeal ≤ RingHom.ker (algebraMap R K) := le_rfl
  have h₂ : p.asIdeal.primeCompl ≤ Submonoid.comap (algebraMap R K) (IsUnit.submonoid K) := by
    intro x hx
    rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
    refine isUnit_iff_ne_zero.mpr ?_
    intro h0
    exact hx (RingHom.mem_ker.mpr h0)
  let φ := Ideal.ResidueField.lift p.asIdeal (algebraMap R K) h₁ h₂
  letI : Algebra p.asIdeal.ResidueField K := φ.toAlgebra
  haveI : IsScalarTower R p.asIdeal.ResidueField K := IsScalarTower.of_algebraMap_eq
    (fun x => (Ideal.ResidueField.lift_algebraMap p.asIdeal (algebraMap R K) h₁ h₂ x).symm)
  obtain ⟨v, hv⟩ := exists_ne (0 : TensorProduct R p.asIdeal.ResidueField N)
  have hf : Function.Injective (LinearMap.toSpanSingleton p.asIdeal.ResidueField _ v) := by
    rw [injective_iff_map_eq_zero]
    intro c hc
    rw [LinearMap.toSpanSingleton_apply] at hc
    exact (smul_eq_zero.mp hc).resolve_right hv
  haveI := TensorProduct.nontrivial_of_linearMap_injective_of_flat_left
    p.asIdeal.ResidueField K _ _ hf
  haveI : Nontrivial (TensorProduct R K N) :=
    (TensorProduct.AlgebraTensorModule.cancelBaseChange R p.asIdeal.ResidueField K K N).symm.toEquiv.nontrivial
  exact false_of_nontrivial_of_subsingleton (TensorProduct R K N)

theorem wc_cg2_split_range_tensor_trivial (R : Type u) [CommRing R] [IsDomain R] (D : Type u)
    [AddCommGroup D] [Module R D] [Module.Finite R D] (K : Type u) [Field K] [Algebra R K]
    (n : ℕ) (hrk : Module.finrank K (TensorProduct R K D) ≤ n)
    (Ψ : D →ₗ[R] (Fin n → R)) (α : R) (hα : algebraMap R K α ≠ 0) (m : Fin n → D)
    (hm : ∀ c c' : Fin n, Ψ (m c) c' = if c = c' then α else 0) :
    Subsingleton (TensorProduct R K
      (LinearMap.range (α • LinearMap.id - Fintype.linearCombination R m ∘ₗ Ψ))) :=
by
  classical
  set σ := Fintype.linearCombination R m with hσdef
  set π := α • LinearMap.id - σ ∘ₗ Ψ with hπdef
  have hσapp : ∀ v, σ v = ∑ c, v c • m c := fun v => Fintype.linearCombination_apply R m v
  have s1 : ∀ v, Ψ (σ v) = α • v := by
    intro v
    funext c'
    rw [hσapp, map_sum]
    simp only [map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, hm, mul_ite, mul_zero,
      Finset.sum_ite_eq', Finset.mem_univ, if_true]
    ring
  have hπapp : ∀ x, π x = α • x - σ (Ψ x) := fun x => rfl
  have s2 : ∀ v, π (σ v) = 0 := by
    intro v; rw [hπapp, s1, map_smul, sub_self]
  have s3 : ∀ x, Ψ (π x) = 0 := by
    intro x; rw [hπapp, map_sub, map_smul, s1, sub_self]
  have s4 : ∀ w, Ψ.baseChange K (σ.baseChange K w) = algebraMap R K α • w := by
    intro w
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul k v =>
      rw [LinearMap.baseChange_tmul, LinearMap.baseChange_tmul, s1, TensorProduct.tmul_smul,
        algebraMap_smul]
    | add x y hx hy => rw [map_add, map_add, hx, hy, smul_add]
  have hinj : Function.Injective (σ.baseChange K) := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    have h := s4 w
    rw [hw, map_zero] at h
    exact (smul_eq_zero.mp h.symm).resolve_left hα
  have hdim1 : Module.finrank K (TensorProduct R K (Fin n → R)) = n := by
    rw [Module.finrank_baseChange, Module.finrank_fin_fun]
  have hle := LinearMap.finrank_le_finrank_of_injective hinj
  have heq : Module.finrank K (TensorProduct R K (Fin n → R)) =
      Module.finrank K (TensorProduct R K D) := by omega
  have hsurj : Function.Surjective (σ.baseChange K) :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank heq).mp hinj
  have s6 : ∀ z, π.baseChange K z = 0 := by
    intro z
    obtain ⟨w, rfl⟩ := hsurj z
    rw [← LinearMap.comp_apply, ← LinearMap.baseChange_comp]
    have h0 : π ∘ₗ σ = 0 := LinearMap.ext s2
    rw [h0, LinearMap.baseChange_zero, LinearMap.zero_apply]
  set ρ := π.rangeRestrict with hρdef
  set j := (LinearMap.range π).subtype with hjdef
  have hρsurj : Function.Surjective (ρ.baseChange K) := by
    rw [LinearMap.baseChange_eq_ltensor]
    exact LinearMap.lTensor_surjective K (LinearMap.surjective_rangeRestrict π)
  have hjρ : ∀ w, j.baseChange K (ρ.baseChange K w) = π.baseChange K w := by
    intro w
    rw [← LinearMap.comp_apply, ← LinearMap.baseChange_comp, hρdef, hjdef,
      LinearMap.subtype_comp_rangeRestrict]
  have hρj0 : ∀ y : LinearMap.range π, ρ (j y) = α • y := by
    rintro ⟨y, x, rfl⟩
    apply Subtype.ext
    change π (π x) = α • π x
    rw [hπapp (π x), s3, map_zero, sub_zero]
  have hρj : ∀ z, ρ.baseChange K (j.baseChange K z) = algebraMap R K α • z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul k v =>
      rw [LinearMap.baseChange_tmul, LinearMap.baseChange_tmul, hρj0, TensorProduct.tmul_smul,
        algebraMap_smul]
    | add x y hx hy => rw [map_add, map_add, hx, hy, smul_add]
  refine subsingleton_of_forall_eq 0 (fun z => ?_)
  obtain ⟨w, rfl⟩ := hρsurj z
  have h := hρj (ρ.baseChange K w)
  rw [hjρ, s6, map_zero] at h
  exact (smul_eq_zero.mp h.symm).resolve_left hα

theorem wc_cg2_complete_split (R : Type u) [CommRing R] [IsDomain R] (D : Type u) [CommRing D]
    [Algebra R D] [Module.Finite R D] (a b : R) (ha : a ≠ 0) (hb : b ≠ 0) (hHP : wcCg2HP R D a b)
    (hEa : wcCg2LocEtale (algebraMap R D) (Submonoid.powers a))
    (hEb : wcCg2LocEtale (algebraMap R D) (Submonoid.powers b))
    (K : Type u) [Field K] [Algebra R K] (haK : algebraMap R K a ≠ 0) (hbK : algebraMap R K b ≠ 0)
    (n : ℕ) (hrk : Module.finrank K (TensorProduct R K D) ≤ n)
    (ψ : Fin n → (D →ₐ[R] R)) (hψ : Function.Injective ψ) :
    Algebra.Etale R D :=
by
  classical
  obtain ⟨k, m, hm⟩ := wc_cg2_orthogonal_points R D a ha hEa n ψ hψ
  obtain ⟨l, m', hm'⟩ := wc_cg2_orthogonal_points R D b hb hEb n ψ hψ
  have hTF := wc_cg2_torsionfree_of_locEtale R D a ha hHP.1 hEa
  let Ψ : D →ₐ[R] (Fin n → R) := AlgHom.pi ψ
  have hΨ : ∀ x c, Ψ x c = ψ c x := fun _ _ => rfl
  have hak : a ^ k ≠ 0 := pow_ne_zero _ ha
  have hαK : algebraMap R K (a ^ k) ≠ 0 := by
    rw [map_pow]; exact pow_ne_zero _ haK
  have hsplit := wc_cg2_split_range_tensor_trivial R D K n hrk Ψ.toLinearMap (a ^ k) hαK m
    (fun c c' => hm c c')
  have hN'TF : ∀ (r : R) (y : LinearMap.range ((a ^ k) • LinearMap.id -
      Fintype.linearCombination R m ∘ₗ Ψ.toLinearMap)), r ≠ 0 → r • y = 0 → y = 0 := by
    intro r y hr hy
    have h1 : r • (y : D) = 0 := by
      have := congrArg Subtype.val hy
      simpa using this
    exact (Submodule.coe_eq_zero).mp (hTF r y hr h1)
  have hsub := wc_cg2_fg_tensor_field_trivial R _ hN'TF K hsplit
  have hinj : Function.Injective Ψ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    have hmem : (a ^ k) • x ∈ LinearMap.range ((a ^ k) • LinearMap.id -
        Fintype.linearCombination R m ∘ₗ Ψ.toLinearMap) := by
      refine ⟨x, ?_⟩
      simp only [LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply,
        LinearMap.comp_apply, AlgHom.toLinearMap_apply, hx, map_zero, sub_zero]
    have h0 : (⟨(a ^ k) • x, hmem⟩ : LinearMap.range ((a ^ k) • LinearMap.id -
        Fintype.linearCombination R m ∘ₗ Ψ.toLinearMap)) = 0 := @Subsingleton.elim _ hsub _ _
    have h1 : (a ^ k) • x = 0 := congrArg Subtype.val h0
    exact hTF _ x hak h1
  have hsum : ∀ (j : ℕ) (r : R) (mm : Fin n → D),
      (∀ c c' : Fin n, ψ c' (mm c) = if c = c' then r ^ j else 0) →
      ∀ y : Fin n → R, Ψ (∑ c, y c • mm c) = (r ^ j) • y := by
    intro j r mm hmm y
    funext c'
    rw [hΨ, map_sum]
    simp only [map_smul, hmm, smul_eq_mul, mul_ite, mul_zero, Finset.sum_ite_eq',
      Finset.mem_univ, if_true, Pi.smul_apply]
    try ring
  have hsurj : Function.Surjective Ψ := by
    intro y
    have hu := hsum k a m hm y
    have hv := hsum l b m' hm' y
    have huv : b ^ l • (∑ c, y c • m c) = a ^ k • (∑ c, y c • m' c) := by
      apply hinj
      rw [map_smul, map_smul, hu, hv, smul_smul, smul_smul, mul_comm]
    obtain ⟨w, hw, -⟩ := (wc_cg2_hartogs_props R a b).1 D hHP k l _ _ huv
    refine ⟨w, ?_⟩
    funext c
    have h := congrFun hu c
    rw [hw, map_smul] at h
    simp only [Pi.smul_apply, smul_eq_mul] at h
    exact mul_left_cancel₀ hak h
  let e : D ≃ₐ[R] (Fin n → R) := AlgEquiv.ofBijective Ψ ⟨hinj, hsurj⟩
  exact Algebra.Etale.of_equiv e.symm

theorem wc_cg2_etale_descent (R S R' : Type u) [CommRing R] [CommRing S] [CommRing R'] [Algebra R S]
    [Algebra R R'] [IsNoetherianRing R] [Module.Finite R S] [Module.Flat R R']
    (𝔫 : Ideal R) [𝔫.IsPrime] (𝔫' : Ideal R') [𝔫'.IsPrime]
    (h𝔫 : 𝔫'.comap (algebraMap R R') = 𝔫)
    (hE : Algebra.Etale R' (TensorProduct R R' S)) :
    wcCg2LocEtale (algebraMap R S) 𝔫.primeCompl :=
by
  unfold wcCg2LocEtale
  change (algebraMap (Localization.AtPrime 𝔫)
    (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl))).Etale
  let φ : Localization.AtPrime 𝔫 →+* Localization.AtPrime 𝔫' :=
    Localization.localRingHom 𝔫 𝔫' (algebraMap R R') h𝔫.symm
  letI : Algebra (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫') := φ.toAlgebra
  haveI : IsScalarTower R (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫') :=
    IsScalarTower.of_algebraMap_eq (fun x => by
      rw [RingHom.algebraMap_toAlgebra]
      show _ = Localization.localRingHom 𝔫 𝔫' (algebraMap R R') h𝔫.symm (algebraMap R _ x)
      rw [Localization.localRingHom_to_map,
        IsScalarTower.algebraMap_apply R R' (Localization.AtPrime 𝔫') x])
  have hφflat : φ.Flat :=
    RingHom.Flat.localRingHom (RingHom.flat_algebraMap_iff.mpr inferInstance) 𝔫' 𝔫 h𝔫.symm
  haveI : Module.Flat (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫') := hφflat
  haveI : IsLocalHom (algebraMap (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')) :=
    Localization.isLocalHom_localRingHom 𝔫 𝔫' (algebraMap R R') h𝔫.symm
  haveI : Module.FaithfullyFlat (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫') :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hFF : (algebraMap (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')).FaithfullyFlat :=
    RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance
  haveI : Algebra.IsPushout R (Localization.AtPrime 𝔫) S
      (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl)) :=
    (Algebra.isPushout_of_isLocalization 𝔫.primeCompl (Localization.AtPrime 𝔫) S
      (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl))).symm
  haveI : Algebra.Etale (Localization.AtPrime 𝔫')
      (TensorProduct R' (Localization.AtPrime 𝔫') (TensorProduct R R' S)) :=
    Algebra.Etale.baseChange R' (TensorProduct R R' S) (Localization.AtPrime 𝔫')
  let e : TensorProduct R' (Localization.AtPrime 𝔫') (TensorProduct R R' S) ≃ₐ[Localization.AtPrime 𝔫']
      TensorProduct (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')
        (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl)) :=
    (Algebra.TensorProduct.cancelBaseChange R R' (Localization.AtPrime 𝔫')
      (Localization.AtPrime 𝔫') S).trans
      ((Algebra.TensorProduct.cancelBaseChange R (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')
        (Localization.AtPrime 𝔫') S).symm.trans
        (Algebra.TensorProduct.congr (AlgEquiv.refl : Localization.AtPrime 𝔫' ≃ₐ[Localization.AtPrime 𝔫']
          Localization.AtPrime 𝔫')
          (Algebra.IsPushout.equiv R (Localization.AtPrime 𝔫) S
            (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl)))))
  haveI hEtA : Algebra.Etale (Localization.AtPrime 𝔫')
      (TensorProduct (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')
        (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl))) :=
    Algebra.Etale.of_equiv e
  have hEt : (algebraMap (Localization.AtPrime 𝔫')
      (TensorProduct (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')
        (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl)))).Etale :=
    RingHom.etale_algebraMap.mpr hEtA
  exact RingHom.CodescendsAlong.algebraMap_tensorProduct RingHom.FaithfullyFlat
    (Localization.AtPrime 𝔫) (Localization.AtPrime 𝔫')
    (Localization (Algebra.algebraMapSubmonoid S 𝔫.primeCompl))
    RingHom.Etale.codescendsAlong_faithfullyFlat hFF hEt

theorem wc_cg2_ring_core (A : Type u) [CommRing A] [IsDomain A] [IsLocalRing A] [IsIntegrallyClosed A]
    [IsNoetherianRing A] (h2 : 2 ≤ (IsLocalRing.maximalIdeal A).height)
    (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B] [Algebra A B] [Algebra.Smooth A B]
    (s : B →ₐ[A] A) (L : Type u) [CommRing L] [Algebra B L] [Algebra A L] [IsScalarTower A B L]
    (hL1 : ∀ a : A, a ≠ 0 → IsUnit (algebraMap A L a))
    (hL2 : ∀ (b : B) (y : L), b ≠ 0 → b • y = 0 → y = 0)
    (hL3 : Module.Finite (FractionRing B) (TensorProduct B (FractionRing B) L))
    (hFin : Module.Finite B (integralClosure B L))
    (hE : ∀ (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap A B) ≠ IsLocalRing.maximalIdeal A →
      wcCg2LocEtale (algebraMap B (integralClosure B L)) Q.primeCompl)
    (hPt : wcCg2FibrePts s (integralClosure B L)) :
    wcCg2LocEtale (algebraMap B (integralClosure B L))
      ((IsLocalRing.maximalIdeal A).comap s).primeCompl :=
by
  classical

  obtain ⟨a, ha𝔪, b, hb𝔪, ha0, hb0, hab⟩ := wc_cg2_normal_depth_two A h2
  obtain ⟨hs2i, -, hs2iii⟩ := wc_cg2_hartogs_props A a b
  have hHPA : wcCg2HP A A a b := by
    refine ⟨?_, ?_, ?_⟩
    · intro x y hxy
      exact mul_left_cancel₀ ha0 hxy
    · intro x y hxy
      exact mul_left_cancel₀ hb0 hxy
    · intro m k hmk
      obtain ⟨w, hw⟩ := hab m k hmk
      exact ⟨w, hw⟩

  haveI : Module.Flat A B := Algebra.Smooth.flat_of_isNoetherianRing A B
  haveI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing A B
  haveI := hFin
  have hHPB : wcCg2HP A B a b := hs2iii hHPA B

  have htrans : ∀ (R R' M : Type u) [CommRing R] [CommRing R'] [Algebra R R'] [AddCommGroup M]
      [Module R M] [Module R' M] [IsScalarTower R R' M] (x y : R),
      wcCg2HP R M x y → wcCg2HP R' M (algebraMap R R' x) (algebraMap R R' y) := by
    intro R R' M _ _ _ _ _ _ _ x y h
    obtain ⟨h1, h2, h3⟩ := h
    refine ⟨?_, ?_, ?_⟩
    · intro m k hmk
      apply h1
      have e1 : algebraMap R R' x • m = x • m := algebraMap_smul R' x m
      have e2 : algebraMap R R' x • k = x • k := algebraMap_smul R' x k
      change algebraMap R R' x • m = algebraMap R R' x • k at hmk
      change x • m = x • k
      rw [← e1, ← e2]
      exact hmk
    · intro m k hmk
      apply h2
      have e1 : algebraMap R R' y • m = y • m := algebraMap_smul R' y m
      have e2 : algebraMap R R' y • k = y • k := algebraMap_smul R' y k
      change algebraMap R R' y • m = algebraMap R R' y • k at hmk
      change y • m = y • k
      rw [← e1, ← e2]
      exact hmk
    · intro m k hmk
      rw [algebraMap_smul, algebraMap_smul] at hmk
      obtain ⟨w, hw⟩ := h3 m k hmk
      exact ⟨w, by rw [hw, algebraMap_smul]⟩

  have hHB : ∀ (i j : ℕ) (m k : B), algebraMap A B b ^ j * m = algebraMap A B a ^ i * k →
      ∃ w, m = algebraMap A B a ^ i * w := by
    intro i j m k h
    have h' : b ^ j • m = a ^ i • k := by
      rw [Algebra.smul_def, Algebra.smul_def, map_pow, map_pow]
      exact h
    obtain ⟨w, hw, -⟩ := hs2i B hHPB i j m k h'
    exact ⟨w, by rw [hw, Algebra.smul_def, map_pow]⟩
  have hsx : ∀ x : A, s (algebraMap A B x) = x := fun x => s.commutes x
  have hxB : ∀ x : A, x ≠ 0 → algebraMap A B x ≠ 0 := by
    intro x hx h
    apply hx
    rw [← hsx x, h, map_zero]
  have hunit : ∀ x : A, x ≠ 0 → IsUnit (algebraMap B L (algebraMap A B x)) := by
    intro x hx
    rw [← IsScalarTower.algebraMap_apply]
    exact hL1 x hx

  have hHPC : wcCg2HP B (integralClosure B L) (algebraMap A B a) (algebraMap A B b) :=
    wc_cg2_integral_closure_hartogs B _ _ (hxB a ha0) (hxB b hb0) hHB L hL2 hL3
      (hunit a ha0) (hunit b hb0)

  have hEx : ∀ x ∈ IsLocalRing.maximalIdeal A,
      wcCg2LocEtale (algebraMap B (integralClosure B L)) (Submonoid.powers (algebraMap A B x)) := by
    intro x hx
    apply wc_cg2_locEtale_away
    intro Q _ hxQ
    apply hE Q
    intro hQ
    apply hxQ
    have hx' : x ∈ Q.comap (algebraMap A B) := by rw [hQ]; exact hx
    exact Ideal.mem_comap.mp hx'

  obtain ⟨hs3a, hdom⟩ := wc_cg2_section_completion A B s
  haveI := hdom
  have hHPq : ∀ k : ℕ, wcCg2HP B (B ⧸ RingHom.ker s ^ k) (algebraMap A B a) (algebraMap A B b) :=
    fun k => htrans A B _ a b (hs3a a b hHPA k)

  letI : Algebra B (FractionRing A) := ((algebraMap A (FractionRing A)).comp s.toRingHom).toAlgebra
  obtain ⟨n, ρ, hρ, hrk⟩ := hPt
  obtain ⟨Ψ7, hΨ7⟩ := wc_cg2_integral_points A B s (integralClosure B L)

  have hlift : ∀ c : Fin n, ∃ Φ : integralClosure B L →ₐ[B] AdicCompletion (RingHom.ker s) B,
      (AdicCompletion.evalₐ (RingHom.ker s) 1).comp Φ = Ψ7 (ρ c) := fun c =>
    wc_cg2_formal_section_lift B (RingHom.ker s) _ _ hHPq _ (hEx a ha𝔪) (hEx b hb𝔪) (Ψ7 (ρ c))
  choose Φ hΦ using hlift
  let ψ : Fin n → (TensorProduct B (AdicCompletion (RingHom.ker s) B) (integralClosure B L) →ₐ[
      AdicCompletion (RingHom.ker s) B] AdicCompletion (RingHom.ker s) B) :=
    fun c => Algebra.TensorProduct.lift (AlgHom.id _ _) (Φ c) (fun _ _ => Commute.all _ _)
  have hψ1 : ∀ c γ, ψ c (TensorProduct.tmul B (1 : AdicCompletion (RingHom.ker s) B) γ) = Φ c γ := by
    intro c γ
    simp only [ψ, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
  have hψinj : Function.Injective ψ := by
    intro c c' h
    have hΦe : Φ c = Φ c' := by
      apply AlgHom.ext
      intro γ
      rw [← hψ1 c γ, ← hψ1 c' γ, h]
    apply hρ
    apply hΨ7
    rw [← hΦ c, ← hΦ c', hΦe]

  let sbar : B ⧸ RingHom.ker s ^ 1 →+* A :=
    Ideal.Quotient.lift (RingHom.ker s ^ 1) s.toRingHom (fun x hx => by
      rw [pow_one] at hx
      exact RingHom.mem_ker.mp hx)
  let g : AdicCompletion (RingHom.ker s) B →+* A :=
    sbar.comp (AdicCompletion.evalₐ (RingHom.ker s) 1).toRingHom
  have hg : ∀ β : B, g (algebraMap B (AdicCompletion (RingHom.ker s) B) β) = s β := by
    intro β
    show sbar ((AdicCompletion.evalₐ (RingHom.ker s) 1) (algebraMap B _ β)) = s β
    rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
    exact Ideal.Quotient.lift_mk _ _ _
  letI : Algebra (AdicCompletion (RingHom.ker s) B) (FractionRing A) :=
    ((algebraMap A (FractionRing A)).comp g).toAlgebra
  haveI : IsScalarTower B (AdicCompletion (RingHom.ker s) B) (FractionRing A) :=
    IsScalarTower.of_algebraMap_eq (fun β => by
      show algebraMap A (FractionRing A) (s β) =
        algebraMap A (FractionRing A) (g (algebraMap B _ β))
      rw [hg])
  haveI : Module.Flat B (AdicCompletion (RingHom.ker s) B) := AdicCompletion.flat_of_isNoetherian _
  have hgx : ∀ x : A,
      g (algebraMap B (AdicCompletion (RingHom.ker s) B) (algebraMap A B x)) = x := fun x => by
    rw [hg, hsx]
  have hne : ∀ x : A, x ≠ 0 → algebraMap (AdicCompletion (RingHom.ker s) B) (FractionRing A)
      (algebraMap B _ (algebraMap A B x)) ≠ 0 := by
    intro x hx h
    apply hx
    have h' : algebraMap A (FractionRing A) (g (algebraMap B _ (algebraMap A B x))) = 0 := h
    rw [hgx] at h'
    exact (IsFractionRing.injective A (FractionRing A)) (by rw [h', map_zero])
  have hne' : ∀ x : A, x ≠ 0 →
      algebraMap B (AdicCompletion (RingHom.ker s) B) (algebraMap A B x) ≠ 0 := by
    intro x hx h
    apply hne x hx
    rw [h, map_zero]

  have hrk' : Module.finrank (FractionRing A) (TensorProduct (AdicCompletion (RingHom.ker s) B)
      (FractionRing A) (TensorProduct B (AdicCompletion (RingHom.ker s) B) (integralClosure B L))) ≤ n :=
    (LinearEquiv.finrank_eq (Algebra.TensorProduct.cancelBaseChange B
      (AdicCompletion (RingHom.ker s) B) (FractionRing A) (FractionRing A)
      (integralClosure B L)).toLinearEquiv).le.trans hrk

  have hHPh : wcCg2HP (AdicCompletion (RingHom.ker s) B)
      (TensorProduct B (AdicCompletion (RingHom.ker s) B) (integralClosure B L))
      (algebraMap B _ (algebraMap A B a)) (algebraMap B _ (algebraMap A B b)) :=
    htrans B _ _ _ _ ((wc_cg2_hartogs_props B _ _).2.1 (integralClosure B L)
      (AdicCompletion (RingHom.ker s) B) hHPC)

  have hEt : Algebra.Etale (AdicCompletion (RingHom.ker s) B)
      (TensorProduct B (AdicCompletion (RingHom.ker s) B) (integralClosure B L)) :=
    wc_cg2_complete_split _ _ _ _ (hne' a ha0) (hne' b hb0) hHPh
      (wc_cg2_locEtale_baseChange B _ _ _ (hEx a ha𝔪))
      (wc_cg2_locEtale_baseChange B _ _ _ (hEx b hb𝔪))
      (FractionRing A) (hne a ha0) (hne b hb0) n hrk' ψ hψinj

  exact wc_cg2_etale_descent B (integralClosure B L) (AdicCompletion (RingHom.ker s) B)
    ((IsLocalRing.maximalIdeal A).comap s) ((IsLocalRing.maximalIdeal A).comap g) (by
      rw [Ideal.comap_comap]
      ext β
      simp only [Ideal.mem_comap, RingHom.comp_apply, hg]) hEt

theorem wc_cg2_open_of_stalk_etale : ∀ {N X : Scheme.{u}} (ν : N ⟶ X) [IsFinite ν] (U : X.Opens)
    (hU : IsAffineOpen U), IsNoetherianRing Γ(X, U) → ∀ (y : X) (hy : y ∈ U),
    wcCg2LocEtale (ν.app U).hom (hU.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl →
    ∃ W : X.Opens, y ∈ W ∧ Etale (ν ∣_ W) :=
by
  have spread : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (φ : R →+* R'), φ.Finite →
      φ.FinitePresentation → ∀ (M : Submonoid R),
      (IsLocalization.map (Localization (M.map φ)) φ M.le_comap_map :
        Localization M →+* Localization (M.map φ)).Etale →
      ∀ (𝔭 : Ideal R) [𝔭.IsPrime], Disjoint (M : Set R) (𝔭 : Set R) →
      ∃ r : R, r ∉ 𝔭 ∧ ((algebraMap R' (Localization.Away (φ r))).comp φ).Etale := by
    intro R R' _ _ φ hf hp M hM 𝔭 _ hdisj
    classical
    letI : Algebra R R' := φ.toAlgebra
    haveI : Module.Finite R R' := hf
    haveI : Algebra.FinitePresentation R R' := hp
    have hloc : ∀ (𝔮 : Ideal R') [𝔮.IsPrime], (∀ m ∈ M, φ m ∉ 𝔮) → Algebra.IsEtaleAt R 𝔮 := by
      intro 𝔮 _ hq
      let N : Submonoid R' := M.map φ
      let S := Localization N
      let T := Localization.AtPrime 𝔮
      let φM : Localization M →+* S := IsLocalization.map S φ M.le_comap_map
      letI : Algebra (Localization M) S := φM.toAlgebra
      haveI : Algebra.Etale (Localization M) S := hM
      haveI : Algebra.FormallyEtale R (Localization M) := Algebra.FormallyEtale.of_isLocalization M
      haveI : IsScalarTower R (Localization M) S := by
        apply IsScalarTower.of_algebraMap_eq'
        rw [IsScalarTower.algebraMap_eq R R' S]
        exact (IsLocalization.map_comp M.le_comap_map).symm
      haveI : Algebra.FormallyEtale R S := Algebra.FormallyEtale.comp R (Localization M) S
      have hN : N ≤ 𝔮.primeCompl := by
        rintro _ ⟨m, hm, rfl⟩
        exact hq m hm
      letI : Algebra S T := IsLocalization.localizationAlgebraOfSubmonoidLe S T N 𝔮.primeCompl hN
      haveI : IsScalarTower R' S T :=
        IsLocalization.localization_isScalarTower_of_submonoid_le S T N 𝔮.primeCompl hN
      haveI : IsLocalization (Submonoid.map (algebraMap R' S) 𝔮.primeCompl) T :=
        IsLocalization.isLocalization_of_submonoid_le S T N 𝔮.primeCompl hN
      haveI : Algebra.FormallyEtale S T :=
        Algebra.FormallyEtale.of_isLocalization (Submonoid.map (algebraMap R' S) 𝔮.primeCompl)
      haveI : IsScalarTower R S T := by
        apply IsScalarTower.of_algebraMap_eq'
        rw [IsScalarTower.algebraMap_eq R R' T, IsScalarTower.algebraMap_eq R' S T,
          IsScalarTower.algebraMap_eq R R' S, RingHom.comp_assoc]
      exact Algebra.FormallyEtale.comp R S T
    have hfib : ∀ 𝔮 : PrimeSpectrum R', Ideal.comap φ 𝔮.asIdeal = 𝔭 →
        𝔮 ∈ Algebra.etaleLocus R R' := by
      intro 𝔮 h𝔮
      rw [Algebra.mem_etaleLocus_iff]
      apply hloc
      intro m hm hm'
      have h1 : m ∈ 𝔭 := by rw [← h𝔮]; exact hm'
      exact Set.disjoint_left.mp hdisj hm h1
    have hZ : IsClosed (Algebra.etaleLocus R R')ᶜ := Algebra.isOpen_etaleLocus.isClosed_compl
    have hint : φ.IsIntegral := RingHom.IsIntegral.of_finite hf
    have hC : IsClosed (PrimeSpectrum.comap φ '' (Algebra.etaleLocus R R')ᶜ) :=
      PrimeSpectrum.isClosedMap_comap_of_isIntegral φ hint _ hZ
    have hpt : (⟨𝔭, inferInstance⟩ : PrimeSpectrum R) ∈
        (PrimeSpectrum.comap φ '' (Algebra.etaleLocus R R')ᶜ)ᶜ := by
      rintro ⟨𝔮, h𝔮Z, h𝔮⟩
      apply h𝔮Z
      apply hfib
      have h1 := congrArg PrimeSpectrum.asIdeal h𝔮
      rw [PrimeSpectrum.comap_asIdeal] at h1
      exact h1
    obtain ⟨v, ⟨r, rfl⟩, hpv, hvC⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hpt hC.isOpen_compl
    have hr : r ∉ 𝔭 := hpv
    have hsub : (PrimeSpectrum.basicOpen (algebraMap R R' r) : Set (PrimeSpectrum R')) ⊆
        Algebra.etaleLocus R R' := by
      intro 𝔮 h𝔮
      by_contra hne
      have hmem : PrimeSpectrum.comap φ 𝔮 ∈ (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum R)) := by
        show r ∉ (PrimeSpectrum.comap φ 𝔮).asIdeal
        rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
        exact h𝔮
      exact hvC hmem ⟨𝔮, hne, rfl⟩
    haveI hE : Algebra.Etale R (Localization.Away (algebraMap R R' r)) :=
      Algebra.basicOpen_subset_etaleLocus_iff_etale.mp hsub
    refine ⟨r, hr, ?_⟩
    have h2 := RingHom.etale_algebraMap.mpr hE
    rw [IsScalarTower.algebraMap_eq R R' (Localization.Away (algebraMap R R' r))] at h2
    exact h2
  have basicOpenEt : ∀ {X N : Scheme.{u}} (ν : N ⟶ X) [IsAffineHom ν] (U : X.Opens),
      IsAffineOpen U → ∀ r : Γ(X, U),
      ((algebraMap Γ(N, ν ⁻¹ᵁ U) (Localization.Away ((ν.app U).hom r))).comp (ν.app U).hom).Etale →
      Etale (ν ∣_ X.basicOpen r) := by
    have s1 : ∀ {R R' S Q : Type u} [CommRing R] [CommRing R'] [CommRing S] [CommRing Q]
        [Algebra R S] [Algebra R' Q] (φ : R →+* R') (r : R) [IsLocalization.Away r S]
        [IsLocalization.Away (φ r) Q],
        ((algebraMap R' (Localization.Away (φ r))).comp φ).Etale →
        (IsLocalization.Away.map S Q φ r).Etale := by
      intro R R' S Q _ _ _ _ _ _ φ r _ _ h
      have hc : ((algebraMap R' Q).comp φ).Etale := by
        let e := IsLocalization.algEquiv (Submonoid.powers (φ r)) (Localization.Away (φ r)) Q
        have : (algebraMap R' Q).comp φ =
            e.toRingEquiv.toRingHom.comp ((algebraMap R' (Localization.Away (φ r))).comp φ) := by
          ext x; simp [e]
        rw [this]
        exact RingHom.Etale.respectsIso.1 _ _ h
      have hcomp : (IsLocalization.Away.map S Q φ r).comp (algebraMap R S) =
          (algebraMap R' Q).comp φ :=
        IsLocalization.map_comp _
      letI : Algebra S Q := (IsLocalization.Away.map S Q φ r).toAlgebra
      letI : Algebra R Q := ((algebraMap R' Q).comp φ).toAlgebra
      haveI : IsScalarTower R S Q := IsScalarTower.of_algebraMap_eq' hcomp.symm
      haveI : Algebra.Etale R Q := hc
      haveI : Algebra.FormallyEtale S Q :=
        Algebra.FormallyEtale.localization_base (M := Submonoid.powers r)
      haveI : Algebra.FinitePresentation R S := IsLocalization.Away.finitePresentation (S := S) r
      haveI : Algebra.FiniteType R S := Algebra.FiniteType.of_finitePresentation
      haveI : Algebra.FinitePresentation S Q :=
        Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R S Q
      exact (⟨inferInstance, inferInstance⟩ : Algebra.Etale S Q)
    intro X N ν _ U hU r h
    have hV : IsAffineOpen (X.basicOpen r) := hU.basicOpen r
    have hV' : IsAffineOpen (ν ⁻¹ᵁ X.basicOpen r) := hV.preimage ν
    have s2 : ∀ (V : X.Opens), IsAffineOpen V → IsAffineOpen (ν ⁻¹ᵁ V) → (ν.app V).hom.Etale →
        Etale (ν ∣_ V) := by
      intro V h1 h2 h3
      haveI : IsAffine V := h1
      haveI : IsAffine (ν ⁻¹ᵁ V) := h2
      rw [HasRingHomProperty.iff_of_isAffine (P := @Etale), morphismRestrict_appTop]
      refine (RingHom.RespectsIso.cancel_right_isIso RingHom.Etale.respectsIso
        (ν.app (V.ι ''ᵁ ⊤)) (N.presheaf.map (eqToHom _).op)).mpr ?_
      have e : V.ι ''ᵁ ⊤ = V := Scheme.Opens.ι_image_top V
      rw [e]
      exact h3
    apply s2 _ hV hV'
    haveI := hU.isLocalization_basicOpen r
    haveI := (hU.preimage ν).isLocalization_basicOpen ((ν.app U).hom r)
    rw [IsAffineOpen.app_basicOpen_eq_away_map ν hU (hU.preimage ν) r, CommRingCat.hom_comp]
    refine (RingHom.RespectsIso.cancel_right_isIso RingHom.Etale.respectsIso _ _).mpr ?_
    rw [CommRingCat.hom_ofHom]
    exact s1 _ r h
  intro N X ν _ U hU hR y hy hloc
  haveI : IsNoetherianRing Γ(X, U) := hR
  have hfin : (ν.app U).hom.Finite := IsFinite.finite_app ν U hU
  have hfp : (ν.app U).hom.FinitePresentation :=
    RingHom.FinitePresentation.of_finiteType.mp (RingHom.Finite.finiteType hfin)
  have hdisj : Disjoint ((hU.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl : Set Γ(X, U))
      ((hU.primeIdealOf ⟨y, hy⟩).asIdeal : Set Γ(X, U)) := by
    rw [Set.disjoint_left]
    intro a ha
    exact (Ideal.mem_primeCompl_iff).mp ha
  obtain ⟨r, hr, het⟩ := spread (ν.app U).hom hfin hfp
    (hU.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl hloc (hU.primeIdealOf ⟨y, hy⟩).asIdeal hdisj
  have hW : Etale (ν ∣_ X.basicOpen r) := basicOpenEt ν U hU r het
  have hmem : y ∈ X.basicOpen r := by
    have h1 : hU.primeIdealOf ⟨y, hy⟩ ∈ PrimeSpectrum.basicOpen r :=
      (PrimeSpectrum.mem_basicOpen r _).mpr hr
    rw [← hU.fromSpec_preimage_basicOpen r] at h1
    have h2 : hU.fromSpec (hU.primeIdealOf ⟨y, hy⟩) ∈ X.basicOpen r := h1
    rwa [hU.fromSpec_primeIdealOf] at h2
  exact ⟨X.basicOpen r, hmem, hW⟩

theorem wc_cg2_torsor_point_fibre : ∀ {Y P : Scheme.{u}} (p : P ⟶ Y) (m : ℕ) (a : ZMod m → (P ⟶ P)),
    wcFetTorsor p m a → m ≠ 0 → ∀ (E : Type u) [Field E] (y : Spec (.of E) ⟶ Y)
    (r : Spec (.of E) ⟶ P), r ≫ p = y →
    wcCg2SchemePts (Limits.pullback p y) (Limits.pullback.snd p y) :=
by
  intro Y P p m a hP hm E _ y r hr
  haveI : NeZero m := ⟨hm⟩

  let G : ZMod m → (P ⟶ Limits.pullback p p) := fun c =>
    Limits.pullback.lift (a c) (𝟙 P) ((hP.act_p c).trans (Category.id_comp p).symm)
  have hG1 : ∀ c, G c ≫ Limits.pullback.fst p p = a c := fun c => Limits.pullback.lift_fst _ _ _
  have hG2 : ∀ c, G c ≫ Limits.pullback.snd p p = 𝟙 P := fun c => Limits.pullback.lift_snd _ _ _

  have hkw : Limits.pullback.fst p y ≫ p = (Limits.pullback.snd p y ≫ r) ≫ p := by
    rw [Category.assoc, hr]; exact Limits.pullback.condition
  let k : Limits.pullback p y ⟶ Limits.pullback p p :=
    Limits.pullback.lift (Limits.pullback.fst p y) (Limits.pullback.snd p y ≫ r) hkw
  have hk1 : k ≫ Limits.pullback.fst p p = Limits.pullback.fst p y := Limits.pullback.lift_fst _ _ _
  have hk2 : k ≫ Limits.pullback.snd p p = Limits.pullback.snd p y ≫ r :=
    Limits.pullback.lift_snd _ _ _

  have htw : ∀ c, (r ≫ a c) ≫ p = 𝟙 _ ≫ y := fun c => by
    rw [Category.assoc, hP.act_p c, hr, Category.id_comp]
  let t : ZMod m → (Spec (.of E) ⟶ Limits.pullback p y) := fun c =>
    Limits.pullback.lift (r ≫ a c) (𝟙 _) (htw c)
  have ht1 : ∀ c, t c ≫ Limits.pullback.fst p y = r ≫ a c := fun c => Limits.pullback.lift_fst _ _ _
  have ht2 : ∀ c, t c ≫ Limits.pullback.snd p y = 𝟙 _ := fun c => Limits.pullback.lift_snd _ _ _

  have hpb : ∀ c, IsPullback r (t c) (G c) k := by
    intro c
    have hw : r ≫ G c = t c ≫ k := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [hG1, hk1, ht1]
      · simp only [Category.assoc]
        rw [hG2, hk2, Category.comp_id, ← Category.assoc, ht2, Category.id_comp]
    have hfl : ∀ s : Limits.PullbackCone (G c) k, (s.snd ≫ Limits.pullback.snd p y) ≫ r = s.fst := by
      intro s
      rw [Category.assoc, ← hk2, ← Category.assoc, ← s.condition, Category.assoc, hG2,
        Category.comp_id]
    refine IsPullback.of_isLimit' ⟨hw⟩ ?_
    refine Limits.PullbackCone.IsLimit.mk _ (fun s => s.snd ≫ Limits.pullback.snd p y) ?_ ?_ ?_
    · intro s
      exact hfl s
    · intro s
      show (s.snd ≫ Limits.pullback.snd p y) ≫ t c = s.snd
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, ht1, ← Category.assoc, hfl s, ← hk1, ← Category.assoc, ← s.condition,
          Category.assoc, hG1]
      · rw [Category.assoc, ht2, Category.comp_id]
    · intro s m' _ h2
      show m' = s.snd ≫ Limits.pullback.snd p y
      rw [← h2, Category.assoc, ht2, Category.comp_id]

  have hoi : ∀ c, IsOpenImmersion (t c) := fun c =>
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) (hpb c) (hP.graph_open c)

  have e1 : ∀ c x, (G c) (r x) = k (t c x) := fun c x =>
    (Scheme.Hom.comp_apply r (G c) x).symm.trans
      ((congrArg (fun f : Spec (.of E) ⟶ Limits.pullback p p => f x) (hpb c).w).trans
        (Scheme.Hom.comp_apply (t c) k x))
  have hdisj : ∀ c c' x x', t c x = t c' x' → c = c' := by
    intro c c' x x' hxx
    by_contra hne
    exact Set.disjoint_left.mp (hP.graph_disj hne) ⟨r x, e1 c x⟩
      ⟨r x', (e1 c' x').trans (congrArg k hxx.symm)⟩
  have hcov : ∀ w, ∃ c x, t c x = w := by
    intro w
    have hw : k w ∈ ⋃ c, Set.range (G c) := by
      first
      | exact Set.eq_univ_iff_forall.mp hP.graph_cover (k w)
      | exact hP.graph_cover.symm ▸ Set.mem_univ (k w)
    rw [Set.mem_iUnion] at hw
    obtain ⟨c, q, hq⟩ := hw
    obtain ⟨e, -, he⟩ := Scheme.Pullback.exists_preimage_pullback (f := G c) (g := k) q w hq
    refine ⟨c, (hpb c).isoPullback.inv e, ?_⟩
    exact (Scheme.Hom.comp_apply _ (t c) e).symm.trans
      ((congrArg (fun f : Limits.pullback (G c) k ⟶ Limits.pullback p y => f e)
        (hpb c).isoPullback_inv_snd).trans he)

  haveI : IsFinite p := hP.finite
  haveI : IsAffineHom (Limits.pullback.snd p y) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback p y) inferInstance
  haveI : IsAffine (Limits.pullback p y) := isAffine_of_isAffineHom (Limits.pullback.snd p y)

  have key : ∀ c, (Limits.pullback.snd p y).appTop ≫ (t c).appTop = 𝟙 _ := fun c => by
    rw [← Scheme.Hom.comp_appTop, ht2 c, Scheme.Hom.id_appTop]
  unfold wcCg2SchemePts
  letI algE : Algebra E Γ(Limits.pullback p y, ⊤) :=
    ((Limits.pullback.snd p y).appTop.hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom).toAlgebra
  let ρ : ZMod m → (Γ(Limits.pullback p y, ⊤) →ₐ[E] E) := fun c =>
    { toRingHom := ((t c).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of E)).hom).hom
      commutes' := fun e => by
        have h1 : (Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫
            ((Limits.pullback.snd p y).appTop ≫ (t c).appTop) ≫
              (Scheme.ΓSpecIso (CommRingCat.of E)).hom = 𝟙 _ := by
          rw [key c, Category.id_comp, Iso.inv_hom_id]
        first
        | exact congrArg (fun f => CommRingCat.Hom.hom f e) h1
        | (have h2 := congrArg (fun f => CommRingCat.Hom.hom f e) h1
           simpa [RingHom.algebraMap_toAlgebra] using h2) }
  let eq : Fin m ≃ ZMod m := (ZMod.finEquiv m).toEquiv
  refine ⟨m, fun i => ρ (eq i), ?_, ?_⟩
  · intro i j hij
    have h1 : (t (eq i)).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of E)).hom =
        (t (eq j)).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of E)).hom := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro v
      exact DFunLike.congr_fun hij v
    have h2 : (t (eq i)).appTop = (t (eq j)).appTop := (cancel_mono _).mp h1
    have h3 : t (eq i) = t (eq j) := ext_of_isAffine h2
    exact eq.injective (hdisj _ _ _ _
      (congrArg (fun f : Spec (.of E) ⟶ Limits.pullback p y => f (IsLocalRing.closedPoint E)) h3))
  · let Φ : Γ(Limits.pullback p y, ⊤) →ₗ[E] (Fin m → E) :=
      LinearMap.pi (fun i => (ρ (eq i)).toLinearMap)
    have hΦ : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro g hg
      have hρg : ∀ c, ρ c g = 0 := by
        intro c
        have h := congrFun hg (eq.symm c)
        have h' : ρ (eq (eq.symm c)) g = 0 := h
        rwa [Equiv.apply_symm_apply] at h'
      have hz : ∀ c, (t c).appTop g = 0 := by
        intro c
        have h2 : (Scheme.ΓSpecIso (CommRingCat.of E)).hom ((t c).appTop g) = 0 := hρg c
        calc (t c).appTop g = (Scheme.ΓSpecIso (CommRingCat.of E)).inv
              ((Scheme.ΓSpecIso (CommRingCat.of E)).hom ((t c).appTop g)) :=
              (Iso.hom_inv_id_apply _ _).symm
          _ = (Scheme.ΓSpecIso (CommRingCat.of E)).inv 0 := by rw [h2]
          _ = 0 := map_zero _
      apply TopCat.Presheaf.section_ext (Limits.pullback p y).sheaf ⊤ g 0
      intro w hw
      obtain ⟨c, x, rfl⟩ := hcov w
      haveI := hoi c
      have hinj : Function.Injective ((t c).stalkMap x) :=
        (ConcreteCategory.bijective_of_isIso ((t c).stalkMap x)).1
      have e2 := Scheme.Hom.germ_stalkMap_apply (t c) ⊤ x hw g
      have hg0 : (t c).app ⊤ g = 0 := hz c
      first
      | rw [hg0, map_zero] at e2
      | simp only [hg0, map_zero] at e2
      have e3 : (t c).stalkMap x ((Limits.pullback p y).presheaf.germ ⊤ (t c x) hw 0) = 0 := by
        rw [map_zero, map_zero]
      change ((Limits.pullback p y).presheaf.germ ⊤ (t c x) hw) g =
        ((Limits.pullback p y).presheaf.germ ⊤ (t c x) hw) 0
      exact hinj (e2.trans e3.symm)
    calc Module.finrank E Γ(Limits.pullback p y, ⊤) ≤ Module.finrank E (Fin m → E) :=
          LinearMap.finrank_le_finrank_of_injective hΦ
      _ = m := Module.finrank_fin_fun E

theorem wc_cg2ard_section : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) (σ : Spec (.of A₀) ⟶ X), σ ≫ f = 𝟙 _ → ∀ (U : X.Opens) (hU : IsAffineOpen U) (𝔭 : Ideal A₀) [𝔭.IsPrime] (w : Spec (.of A₀)), w.asIdeal = 𝔭 → ∀ (hw : σ w ∈ U), ∃ θ : Γ(X, U) →+* Localization.AtPrime 𝔭, θ.comp ((f.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of A₀)).inv.hom) = algebraMap A₀ (Localization.AtPrime 𝔭) ∧ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)).comap θ = (hU.primeIdealOf ⟨σ w, hw⟩).asIdeal ∧ ∃ h : ⊤ ≤ (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) ⁻¹ᵁ U, (Scheme.ΓSpecIso (.of (FractionRing A₀))).hom.hom.comp ((Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ).appLE U ⊤ h).hom = (algebraMap (Localization.AtPrime 𝔭) (FractionRing A₀)).comp θ :=
by
  intro A₀ _ _ X f σ hσ U hU 𝔭 _ w hw𝔭 hw

  have key2 : ∀ (R S : Type u) [CommRing R] [CommRing S] (g : R →+* S)
      (h : ⊤ ≤ (Spec.map (CommRingCat.ofHom g)) ⁻¹ᵁ ⊤),
      (Scheme.ΓSpecIso (.of S)).hom.hom.comp ((Spec.map (CommRingCat.ofHom g)).appLE ⊤ ⊤ h).hom =
        g.comp (Scheme.ΓSpecIso (.of R)).hom.hom := by
    intro R S _ _ g h
    have e : (Spec.map (CommRingCat.ofHom g)).appLE ⊤ ⊤ h =
        (Spec.map (CommRingCat.ofHom g)).appTop :=
      Scheme.Hom.appLE_eq_app (U := ⊤) _
    rw [e, ← CommRingCat.hom_comp, Scheme.ΓSpecIso_naturality, CommRingCat.hom_comp,
      CommRingCat.hom_ofHom]
  have hK : Ideal.comap (algebraMap A₀ (Localization.AtPrime 𝔭))
      (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)) = 𝔭 :=
    IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime 𝔭) 𝔭

  have hτ : ⊤ ≤ (Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime 𝔭))) ≫ σ) ⁻¹ᵁ U := by
    intro c _
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
    have h1 : Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime 𝔭))) c ⤳ w := by
      apply (PrimeSpectrum.le_iff_specializes _ _).mp
      change Ideal.comap (algebraMap A₀ (Localization.AtPrime 𝔭)) c.asIdeal ≤ w.asIdeal
      rw [hw𝔭]
      exact (Ideal.comap_mono (IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top c.isPrime))).trans
          hK.le
    exact (h1.map σ.continuous).mem_open U.isOpen hw
  obtain ⟨c₀, hc₀⟩ : ∃ c₀ : Spec (.of (Localization.AtPrime 𝔭)),
      c₀.asIdeal = IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) :=
    ⟨IsLocalRing.closedPoint (Localization.AtPrime 𝔭), rfl⟩
  have hc0 : Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime 𝔭))) c₀ = w := by
    apply PrimeSpectrum.ext
    change Ideal.comap (algebraMap A₀ (Localization.AtPrime 𝔭)) c₀.asIdeal = w.asIdeal
    rw [hw𝔭, hc₀]
    exact hK
  have hc : (Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime 𝔭))) ≫ σ) c₀ = σ w := by
    rw [Scheme.Hom.comp_apply, hc0]
  have hφ : Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ =
      Spec.map (CommRingCat.ofHom (algebraMap (Localization.AtPrime 𝔭) (FractionRing A₀))) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime 𝔭))) ≫ σ) := by
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq A₀ (Localization.AtPrime 𝔭) (FractionRing A₀)]
  obtain ⟨τ, hτdef⟩ : ∃ τ, τ = Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime 𝔭))) ≫ σ :=
    ⟨_, rfl⟩
  rw [← hτdef] at hτ hc hφ
  have hτf : τ ≫ f = Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime 𝔭))) := by
    rw [hτdef, Category.assoc, hσ, Category.comp_id]
  refine ⟨(Scheme.ΓSpecIso (.of (Localization.AtPrime 𝔭))).hom.hom.comp (τ.appLE U ⊤ hτ).hom,
    ?_, ?_, ?_⟩
  ·
    have e2 : ∀ (φ : Spec (.of (Localization.AtPrime 𝔭)) ⟶ Spec (.of A₀)) (h : ⊤ ≤ φ ⁻¹ᵁ ⊤),
        φ = Spec.map (CommRingCat.ofHom (algebraMap A₀ (Localization.AtPrime 𝔭))) →
        (Scheme.ΓSpecIso (.of (Localization.AtPrime 𝔭))).hom.hom.comp (φ.appLE ⊤ ⊤ h).hom =
          (algebraMap A₀ (Localization.AtPrime 𝔭)).comp (Scheme.ΓSpecIso (.of A₀)).hom.hom := by
      rintro φ h rfl
      exact key2 _ _ _ h
    show ((Scheme.ΓSpecIso (.of (Localization.AtPrime 𝔭))).hom.hom.comp
      ((f.appLE ⊤ U le_top ≫ τ.appLE U ⊤ hτ).hom)).comp (Scheme.ΓSpecIso (.of A₀)).inv.hom = _
    rw [Scheme.Hom.appLE_comp_appLE τ f ⊤ U ⊤ le_top hτ, e2 _ _ hτf, RingHom.comp_assoc,
      ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id, RingHom.comp_id]
  ·
    have hV := isAffineOpen_top (Spec (.of (Localization.AtPrime 𝔭)))
    have h1 : PrimeSpectrum.comap (Scheme.ΓSpecIso (.of (Localization.AtPrime 𝔭))).inv.hom
        (hV.primeIdealOf ⟨c₀, trivial⟩) = c₀ := by
      have := hV.fromSpec_primeIdealOf ⟨c₀, trivial⟩
      rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at this
      exact (Spec.map_apply _ _).symm.trans this
    have hP : hV.primeIdealOf ⟨c₀, trivial⟩ =
        PrimeSpectrum.comap (Scheme.ΓSpecIso (.of (Localization.AtPrime 𝔭))).hom.hom c₀ := by
      conv_rhs => rw [← h1]
      rw [← PrimeSpectrum.comap_comp_apply, ← CommRingCat.hom_comp, Iso.hom_inv_id,
        CommRingCat.hom_id, PrimeSpectrum.comap_id]
    have h2 := IsAffineOpen.comap_primeIdealOf_appLE (f := τ) (x := c₀) U hU ⊤ hV hτ trivial
    rw [hP] at h2
    have h3 := congrArg PrimeSpectrum.asIdeal h2
    change Ideal.comap (τ.appLE U ⊤ hτ).hom
      (Ideal.comap (Scheme.ΓSpecIso (.of (Localization.AtPrime 𝔭))).hom.hom c₀.asIdeal) = _ at h3
    rw [Ideal.comap_comap, hc₀] at h3
    have h4 : (⟨σ w, hw⟩ : U) = ⟨τ c₀, by rw [hc]; exact hw⟩ := Subtype.ext hc.symm
    rw [h4]
    exact h3
  ·
    rw [hφ]
    have hτeq : τ ⁻¹ᵁ U = ⊤ := top_le_iff.mp hτ
    have hτ' : ⊤ ≤ (Spec.map (CommRingCat.ofHom (algebraMap (Localization.AtPrime 𝔭)
        (FractionRing A₀))) ≫ τ) ⁻¹ᵁ U :=
      le_of_eq (by rw [Scheme.Hom.comp_preimage, hτeq, Scheme.Hom.preimage_top])
    refine ⟨hτ', ?_⟩
    rw [← Scheme.Hom.appLE_comp_appLE (Spec.map (CommRingCat.ofHom (algebraMap
      (Localization.AtPrime 𝔭) (FractionRing A₀)))) τ U ⊤ ⊤ hτ
      (Scheme.Hom.preimage_top _).symm.le,
      CommRingCat.hom_comp, ← RingHom.comp_assoc, key2, RingHom.comp_assoc]

theorem wc_cg2ard_point_contraction : ∀ (A₀ : Type u) [CommRing A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) (U : X.Opens) (hU : IsAffineOpen U) (Q₀ : PrimeSpectrum Γ(X, U)), (f (hU.fromSpec Q₀)).asIdeal = Q₀.asIdeal.comap ((f.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of A₀)).inv.hom) :=
by
  intro A₀ _ X f U hU Q₀
  have h := IsAffineOpen.SpecMap_appLE_fromSpec f (isAffineOpen_top (Spec (.of A₀))) hU le_top
  rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp] at h
  have h3 := congrArg (fun g : Spec Γ(X, U) ⟶ Spec (.of A₀) => (g Q₀).asIdeal) h
  calc (f (hU.fromSpec Q₀)).asIdeal = ((hU.fromSpec ≫ f) Q₀).asIdeal := rfl
    _ = ((Spec.map ((Scheme.ΓSpecIso (.of A₀)).inv ≫ f.appLE ⊤ U le_top)) Q₀).asIdeal := h3.symm
    _ = _ := by
      first
        | rfl
        | (erw [Spec.map_apply]; rfl)
        | (erw [Spec.map_apply, PrimeSpectrum.comap_asIdeal, CommRingCat.hom_comp])

theorem wc_cg2ard_generic_L : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] (X : Scheme.{u}) (f : X ⟶ Spec (.of A₀)) (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))), IsFinite p → Etale p → ∀ (U : X.Opens), IsAffineOpen U → letI : Algebra Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) := ((p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))).app U).hom.toAlgebra; (∀ a : A₀, a ≠ 0 → IsUnit (algebraMap Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) (((f.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of A₀)).inv.hom) a))) ∧ Module.Flat Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) ∧ (∃ G : Finset Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U), ∀ l, ∃ a : A₀, a ≠ 0 ∧ algebraMap Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) (((f.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of A₀)).inv.hom) a) * l ∈ Submodule.span Γ(X, U) (G : Set Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U))) ∧ (∀ l, ∃ a : A₀, a ≠ 0 ∧ IsIntegral Γ(X, U) (algebraMap Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) (((f.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of A₀)).inv.hom) a) * l)) :=
by
  intro A₀ _ _ X f P p hpfin hpet U hU

  have alg : ∀ (R S L : Type u) [CommRing R] [CommRing S] [CommRing L] [Algebra R S] [Algebra S L]
      [Algebra R L] [IsScalarTower R S L] (ψ : A₀ →+* R)
      [IsLocalization (Submonoid.map ψ (nonZeroDivisors A₀)) S] [Module.Finite S L] [Module.Flat S L],
      (∀ a : A₀, a ≠ 0 → IsUnit (algebraMap R L (ψ a))) ∧ Module.Flat R L ∧
      (∃ G : Finset L, ∀ l, ∃ a : A₀, a ≠ 0 ∧
        algebraMap R L (ψ a) * l ∈ Submodule.span R (G : Set L)) ∧
      (∀ l, ∃ a : A₀, a ≠ 0 ∧ IsIntegral R (algebraMap R L (ψ a) * l)) := by
    intro R S L _ _ _ _ _ _ _ ψ _ _ _
    classical
    have hmem : ∀ a : A₀, a ≠ 0 → ψ a ∈ Submonoid.map ψ (nonZeroDivisors A₀) := fun a ha =>
      Submonoid.mem_map.mpr ⟨a, mem_nonZeroDivisors_of_ne_zero ha, rfl⟩
    have hdesc : ∀ m : Submonoid.map ψ (nonZeroDivisors A₀), ∃ a : A₀, a ≠ 0 ∧ (m : R) = ψ a := by
      rintro ⟨m, hm⟩
      obtain ⟨a, ha, rfl⟩ := Submonoid.mem_map.mp hm
      exact ⟨a, nonZeroDivisors.ne_zero ha, rfl⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro a ha
      rw [IsScalarTower.algebraMap_apply R S L]
      exact (IsLocalization.map_units S
        (⟨ψ a, hmem a ha⟩ : Submonoid.map ψ (nonZeroDivisors A₀))).map _
    · haveI := IsLocalization.flat S (Submonoid.map ψ (nonZeroDivisors A₀))
      exact Module.Flat.trans R S L
    · obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := S) (M := L)
      refine ⟨Finset.univ.image g, fun l => ?_⟩
      have hl : l ∈ Submodule.span S (Set.range g) := by rw [hg]; trivial
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun S).mp hl
      obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples
        (Submonoid.map ψ (nonZeroDivisors A₀)) Finset.univ c
      choose r hr using fun i => hb i (Finset.mem_univ i)
      obtain ⟨a, ha, hba⟩ := hdesc b
      refine ⟨a, ha, ?_⟩
      have key : algebraMap R L (ψ a) * l = ∑ i, r i • g i := by
        rw [← Algebra.smul_def, ← hc, Finset.smul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [← smul_assoc, ← hba, ← hr i, algebraMap_smul]
      rw [key]
      refine Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ?_))
      simp
    · intro l
      haveI := Algebra.IsIntegral.of_finite S L
      obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
        (Submonoid.map ψ (nonZeroDivisors A₀)) l (Algebra.IsIntegral.isIntegral (R := S) l)
      obtain ⟨a, ha, hma⟩ := hdesc m
      refine ⟨a, ha, ?_⟩
      rw [← Algebra.smul_def, ← hma]
      exact hm

  have hS : letI : Algebra Γ(X, U) Γ(Limits.pullback f (Spec.map (CommRingCat.ofHom
        (algebraMap A₀ (FractionRing A₀)))), Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ U) := (Scheme.Hom.app (Limits.pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) U).hom.toAlgebra
      IsLocalization (Submonoid.map ((f.appLE ⊤ U le_top).hom.comp
        (Scheme.ΓSpecIso (.of A₀)).inv.hom) (nonZeroDivisors A₀))
        Γ(Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))),
          Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
            (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ U) := by
    open Limits TensorProduct in
    set_option backward.defeqAttrib.useBackward true in
    set_option backward.isDefEq.respectTransparency false in
    · have s2 : ∀ {R R' S P : CommRingCat.{u}} (a : R ⟶ S) (b : R ⟶ R') (c : S ⟶ P) (d : R' ⟶ P),
          IsPushout a b c d → ∀ (M : Submonoid R), (letI : Algebra R R' := b.hom.toAlgebra;
            IsLocalization M R') → ∀ (N : Submonoid S), M.map a.hom = N →
            (letI : Algebra S P := c.hom.toAlgebra; IsLocalization N P) := by
        intro R R' S P a b c d h M hM N hN
        subst hN
        letI : Algebra R S := a.hom.toAlgebra
        letI : Algebra R R' := b.hom.toAlgebra
        letI : Algebra S P := c.hom.toAlgebra
        letI : Algebra R' P := d.hom.toAlgebra
        letI : Algebra R P := (a ≫ c).hom.toAlgebra
        haveI : IsScalarTower R S P := .of_algebraMap_eq' rfl
        haveI : IsScalarTower R R' P := .of_algebraMap_eq' (congrArg CommRingCat.Hom.hom h.w)
        have h' : Algebra.IsPushout R R' S P := CommRingCat.isPushout_iff_isPushout.mp h.flip
        exact (Algebra.isLocalization_iff_isPushout M R' (T := S) (B := P)).mpr h'.symm
      have s3 : letI : Algebra Γ(Spec (.of A₀), ⊤) Γ(Spec (.of (FractionRing A₀)), ⊤) :=
            (Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))
              ⊤ ⊤ le_top).hom.toAlgebra
          IsLocalization ((nonZeroDivisors A₀).map
            (Scheme.ΓSpecIso (.of A₀)).commRingCatIsoToRingEquiv.symm)
            Γ(Spec (.of (FractionRing A₀)), ⊤) := by
        let eR : Γ(Spec (.of A₀), ⊤) ≃+* A₀ := (Scheme.ΓSpecIso (.of A₀)).commRingCatIsoToRingEquiv
        let eS : Γ(Spec (.of (FractionRing A₀)), ⊤) ≃+* FractionRing A₀ :=
          (Scheme.ΓSpecIso (.of (FractionRing A₀))).commRingCatIsoToRingEquiv
        have h1 := IsLocalization.isLocalization_of_base_ringEquiv (nonZeroDivisors A₀)
          (FractionRing A₀) eR.symm
        letI i1 : Algebra Γ(Spec (.of A₀), ⊤) (FractionRing A₀) :=
          ((algebraMap A₀ (FractionRing A₀)).comp eR.symm.symm.toRingHom).toAlgebra
        have h2 := (IsLocalization.isLocalization_iff_of_ringEquiv
          ((nonZeroDivisors A₀).map eR.symm) eS.symm).mp h1
        have hnat := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))
        have hEq : (Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))
            ⊤ ⊤ le_top).hom = eS.symm.toRingHom.comp (algebraMap Γ(Spec (.of A₀), ⊤) (FractionRing A₀)) := by
          ext x
          apply eS.injective
          simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
            RingHom.coe_coe, RingEquiv.apply_symm_apply]
          exact congrArg (fun φ => φ.hom x) hnat
        show @IsLocalization _ _ _ _ _ (RingHom.toAlgebra _)
        rw [hEq]
        exact h2
      have hpush := (isIso_pushoutSection_iff (IsPullback.of_hasPullback f
          (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))
        (US := ⊤) (UT := ⊤) (UX := U) (UY := pullback.fst f (Spec.map (CommRingCat.ofHom
          (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ U)
        (by simp) (by simp) (by simp)).mp
        (isIso_pushoutSection_of_isAffineOpen _ _ _ _ (isAffineOpen_top _) (isAffineOpen_top _) hU)
      have hMeq : ((nonZeroDivisors A₀).map
            (Scheme.ΓSpecIso (.of A₀)).commRingCatIsoToRingEquiv.symm).map
            (f.appLE ⊤ U le_top).hom =
          Submonoid.map ((f.appLE ⊤ U le_top).hom.comp
            (Scheme.ΓSpecIso (.of A₀)).inv.hom) (nonZeroDivisors A₀) := by
        ext x
        simp only [Submonoid.mem_map]
        constructor
        · rintro ⟨y, ⟨a, ha, rfl⟩, rfl⟩
          exact ⟨a, ha, rfl⟩
        · rintro ⟨a, ha, rfl⟩
          exact ⟨_, ⟨a, ha, rfl⟩, rfl⟩
      have h := s2 _ _ _ _ hpush _ s3 _ hMeq
      show @IsLocalization _ _ _ _ _ (RingHom.toAlgebra _)
      rw [Scheme.Hom.app_eq_appLE]
      exact h

  haveI : IsFinite p := hpfin
  haveI : Etale p := hpet
  haveI hπaff : IsAffineHom (Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))).flip
      inferInstance
  have hU' : IsAffineOpen (Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ U) := hU.preimage _
  letI algRL : Algebra Γ(X, U) Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) := ((p ≫ Limits.pullback.fst f (Spec.map
      (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))).app U).hom.toAlgebra
  letI algRS : Algebra Γ(X, U) Γ(Limits.pullback f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀)))), Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ U) := (Scheme.Hom.app (Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) U).hom.toAlgebra
  letI algSL : Algebra Γ(Limits.pullback f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀)))), Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ U)
      Γ(P, (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A₀ (FractionRing A₀))))) ⁻¹ᵁ U) :=
    (p.app (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ U)).hom.toAlgebra
  haveI : IsScalarTower Γ(X, U) Γ(Limits.pullback f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀)))), Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
      (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ U)
