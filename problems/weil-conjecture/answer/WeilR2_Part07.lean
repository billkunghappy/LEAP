    let adj0 := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous Φ AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology A)
    let L := Functor.sheafPullbackConstruction.sheafPullback Φ AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology A)
