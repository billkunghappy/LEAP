  have hs4 : ∀ (K : Type u) [Field K] [IsAlgClosed K] (d n : ℕ), ∃ T : Finset (MvPolynomial (Fin d) K), ∀ f : MvPolynomial (Fin d) K, ∃ g : MvPolynomial (Fin d) K → MvPolynomial (Fin d) K, f = ∑ t ∈ T, g t ^ (ringExpChar K ^ n) * t := by
    intro K _ _ d n
    classical
    set q := ringExpChar K ^ n with hqdef
    have hp : 0 < ringExpChar K := expChar_pos K (ringExpChar K)
    have hq : 0 < q := pow_pos hp n
    let mono : (Fin d → Fin q) → MvPolynomial (Fin d) K := fun e =>
      MvPolynomial.monomial (∑ i, Finsupp.single i (e i : ℕ)) 1
    refine ⟨Finset.univ.image mono, ?_⟩
    intro f
    induction f using MvPolynomial.induction_on' with
    | monomial m c =>
      obtain ⟨c', hc'⟩ := IsAlgClosed.exists_pow_nat_eq c hq
      let e₀ : Fin d → Fin q := fun i => ⟨m i % q, Nat.mod_lt _ hq⟩
      let s : Fin d →₀ ℕ := ∑ i, Finsupp.single i (m i / q)
      have hm : q • s + (∑ i, Finsupp.single i ((e₀ i : ℕ))) = m := by
        ext i
        simp [s, e₀, Finsupp.single_apply, Nat.div_add_mod]
      have ht₀ : mono e₀ ∈ Finset.univ.image mono := Finset.mem_image_of_mem _ (Finset.mem_univ _)
      refine ⟨fun t => if t = mono e₀ then MvPolynomial.monomial s c' else 0, ?_⟩
      rw [Finset.sum_eq_single (mono e₀)]
      · dsimp only
        rw [if_pos rfl]
        simp only [mono]
        rw [MvPolynomial.monomial_pow, MvPolynomial.monomial_mul, hm, hc', mul_one]
      · intro t _ ht
        dsimp only
        rw [if_neg ht, zero_pow hq.ne', zero_mul]
      · intro h
        exact absurd ht₀ h
    | add f₁ f₂ h₁ h₂ =>
      obtain ⟨g₁, hg₁⟩ := h₁
      obtain ⟨g₂, hg₂⟩ := h₂
      refine ⟨fun t => g₁ t + g₂ t, ?_⟩
      rw [hg₁, hg₂, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun t _ => ?_)
      rw [hqdef, add_pow_expChar_pow, add_mul]

  have hs5 : ∀ (P : Type u) [CommRing P] [IsNoetherianRing P] (L : Type u) [Field L] [Algebra P L] (p n : ℕ) [ExpChar L p] (T : Finset P) (G : Finset L), (∀ f : P, ∃ g : P → P, f = ∑ t ∈ T, g t ^ (p ^ n) * t) → ∀ C : Subalgebra P L, (∀ x ∈ C, x ^ (p ^ n) ∈ Submodule.span P (G : Set L)) → Module.Finite P C := by
    intro P _ _ L _ _ p n _ T G hT C hC
    classical
    set φ : L →+* L := iterateFrobenius L p n with hφdef
    have hφ : ∀ x, φ x = x ^ (p ^ n) := fun x => iterateFrobenius_def p n x
    have hφinj : Function.Injective φ := iterateFrobenius_inj L p n
    set ρ : P →+* L := φ.comp (algebraMap P L) with hρdef
    set R0 : Subring L := ρ.range with hR0
    haveI : IsNoetherianRing R0 := isNoetherianRing_range ρ
    have hρmem : ∀ f : P, φ (algebraMap P L f) ∈ R0 := fun f => ⟨f, rfl⟩
    let gen : Finset L := (T ×ˢ G).image (fun tg => algebraMap P L tg.1 * tg.2)
    let M0 : Submodule R0 L := Submodule.span R0 (gen : Set L)
    haveI : Module.Finite R0 M0 := Module.Finite.span_finset R0 gen
    haveI : IsNoetherian R0 M0 := isNoetherian_of_isNoetherianRing_of_finite R0 M0
    let N : Submodule R0 L := Submodule.span R0 ((fun x => x ^ (p ^ n)) '' (C : Set L))
    have hNM : N ≤ M0 := by
      rw [Submodule.span_le]
      rintro _ ⟨x, hx, rfl⟩
      obtain ⟨a, -, ha⟩ := Submodule.mem_span_finset.mp (hC x hx)
      show x ^ (p ^ n) ∈ M0
      rw [← ha]
      refine Submodule.sum_mem _ (fun g hg => ?_)
      obtain ⟨h, hh⟩ := hT (a g)
      rw [Algebra.smul_def, hh, map_sum, Finset.sum_mul]
      refine Submodule.sum_mem _ (fun t ht => ?_)
      have e : algebraMap P L (h t ^ (p ^ n) * t) * g =
          (⟨φ (algebraMap P L (h t)), hρmem (h t)⟩ : R0) • (algebraMap P L t * g) := by
        rw [Subring.smul_def, smul_eq_mul]
        show _ = φ (algebraMap P L (h t)) * (algebraMap P L t * g)
        rw [hφ, map_mul, map_pow]
        ring
      rw [e]
      have hmem : algebraMap P L t * g ∈ gen :=
        Finset.mem_image.mpr ⟨(t, g), Finset.mem_product.mpr ⟨ht, hg⟩, rfl⟩
      exact Submodule.smul_mem _ _ (Submodule.subset_span (Finset.mem_coe.mpr hmem))
    have hNfg : N.FG := (isNoetherian_submodule.mp inferInstance) N hNM
    obtain ⟨S0, hS0⟩ := hNfg
    have hgen : ∀ s ∈ S0, ∃ U : Finset L, (U : Set L) ⊆ (fun x => x ^ (p ^ n)) '' (C : Set L) ∧
        s ∈ Submodule.span R0 (U : Set L) := by
      intro s hs
      have hsN : s ∈ N := hS0 ▸ Submodule.subset_span hs
      exact Submodule.mem_span_finite_of_mem_span hsN
    choose U hU1 hU2 using hgen
    let V : Finset L := S0.attach.biUnion (fun s => U s.1 s.2)
    have hV1 : (V : Set L) ⊆ (fun x => x ^ (p ^ n)) '' (C : Set L) := by
      intro v hv
      obtain ⟨s, -, hvs⟩ := Finset.mem_biUnion.mp hv
      exact hU1 s.1 s.2 hvs
    have hNV : N ≤ Submodule.span R0 (V : Set L) := by
      rw [← hS0, Submodule.span_le]
      intro s hs
      refine Submodule.span_mono ?_ (hU2 s hs)
      intro v hv
      exact Finset.mem_biUnion.mpr ⟨⟨s, hs⟩, Finset.mem_attach _ _, hv⟩
    let W : Set L := {c | c ∈ C ∧ φ c ∈ (V : Set L)}
    have hWfin : W.Finite := by
      apply (V.finite_toSet.preimage hφinj.injOn).subset
      intro c hc
      exact hc.2
    let S' : Submodule R0 L :=
      { carrier := {y | ∃ z ∈ Submodule.span P W, φ z = y}
        add_mem' := by
          rintro _ _ ⟨z₁, hz₁, rfl⟩ ⟨z₂, hz₂, rfl⟩
          exact ⟨z₁ + z₂, Submodule.add_mem _ hz₁ hz₂, map_add φ z₁ z₂⟩
        zero_mem' := ⟨0, Submodule.zero_mem _, map_zero φ⟩
        smul_mem' := by
          rintro ⟨r, f, rfl⟩ _ ⟨z, hz, rfl⟩
          refine ⟨f • z, Submodule.smul_mem _ f hz, ?_⟩
          rw [Subring.smul_def, smul_eq_mul, Algebra.smul_def, map_mul]
          rfl }
    have hVS : Submodule.span R0 (V : Set L) ≤ S' := by
      rw [Submodule.span_le]
      intro v hv
      obtain ⟨c, hc, rfl⟩ := hV1 hv
      refine ⟨c, Submodule.subset_span ⟨hc, ?_⟩, hφ c⟩
      rw [hφ]
      exact hv
    have hCW : Subalgebra.toSubmodule C = Submodule.span P W := by
      apply le_antisymm
      · intro x hx
        have h1 : x ^ (p ^ n) ∈ S' := hVS (hNV (Submodule.subset_span ⟨x, hx, rfl⟩))
        obtain ⟨z, hz, hzx⟩ := h1
        rw [← hφinj (hzx.trans (hφ x).symm)]
        exact hz
      · exact Submodule.span_le.mpr (fun c hc => hc.1)
    have hfg : (Subalgebra.toSubmodule C).FG := by
      rw [hCW]
      exact ⟨hWfin.toFinset, by rw [Set.Finite.coe_toFinset]⟩
    exact Module.Finite.iff_fg.mpr hfg
  intro K _ _ A _ _ _ κ
  classical

  have s2 : ∀ (B : Type u) [CommRing B] [IsDomain B] (j : B →+* A), Function.Injective j →
      ∃ T : Subring A, (∀ a : A, a ∈ T ↔ (∃ f : Polynomial B, f.Monic ∧ f.eval₂ j a = 0) ∧
        ∃ b₁ b₂ : B, b₁ ≠ 0 ∧ j b₁ * a = j b₂) ∧
        Nonempty (↥T ≃+* ↥(integralClosure B (FractionRing B))) := by
    intro B _ _ j hj
    have hAinj : Function.Injective (algebraMap A (FractionRing A)) :=
      IsFractionRing.injective A (FractionRing A)
    have hgi : Function.Injective ((algebraMap A (FractionRing A)).comp j) := hAinj.comp hj
    let ι : FractionRing B →+* FractionRing A := IsFractionRing.lift hgi
    have hι : ∀ b : B, ι (algebraMap B (FractionRing B) b) = algebraMap A (FractionRing A) (j b) :=
      fun b => IsFractionRing.lift_algebraMap hgi b
    have hcomp : ι.comp (algebraMap B (FractionRing B)) = (algebraMap A (FractionRing A)).comp j :=
      RingHom.ext fun b => hι b
    have hev : ∀ (f : Polynomial B) (y : FractionRing B),
        ι (f.eval₂ (algebraMap B (FractionRing B)) y) =
          f.eval₂ ((algebraMap A (FractionRing A)).comp j) (ι y) := by
      intro f y
      rw [Polynomial.hom_eval₂, hcomp]
    have hevA : ∀ (f : Polynomial B) (a : A),
        algebraMap A (FractionRing A) (f.eval₂ j a) =
          f.eval₂ ((algebraMap A (FractionRing A)).comp j) (algebraMap A (FractionRing A) a) :=
      fun f a => Polynomial.hom_eval₂ f j _ a
    have hrange : ∀ y : integralClosure B (FractionRing B),
        ι (y : FractionRing B) ∈ (algebraMap A (FractionRing A)).range := by
      intro y
      have hy : _root_.IsIntegral B (y : FractionRing B) := y.2
      obtain ⟨f, hfm, hf⟩ := hy
      have hi : _root_.IsIntegral A (ι (y : FractionRing B)) :=
        ⟨f.map j, hfm.map j, by rw [Polynomial.eval₂_map, ← hev, hf, map_zero]⟩
      obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hi
      exact ⟨a, ha⟩
    let eA : A ≃+* (algebraMap A (FractionRing A)).range :=
      RingEquiv.ofBijective (algebraMap A (FractionRing A)).rangeRestrict
        ⟨fun x y h => hAinj (congrArg Subtype.val h),
          (algebraMap A (FractionRing A)).rangeRestrict_surjective⟩
    let ψ1 : integralClosure B (FractionRing B) →+* (algebraMap A (FractionRing A)).range :=
      (ι.comp (integralClosure B (FractionRing B)).val.toRingHom).codRestrict _ hrange
    let ψ : integralClosure B (FractionRing B) →+* A := eA.symm.toRingHom.comp ψ1
    have hψ : ∀ y, algebraMap A (FractionRing A) (ψ y) = ι (y : FractionRing B) := by
      intro y
      have h1 : eA (ψ y) = ψ1 y := eA.apply_symm_apply _
      exact congrArg Subtype.val h1
    have hψinj : Function.Injective ψ := by
      intro y y' h
      apply Subtype.ext
      apply ι.injective
      rw [← hψ, ← hψ, h]
    have hmemψ : ∀ a : A, a ∈ ψ.range ↔ (∃ f : Polynomial B, f.Monic ∧ f.eval₂ j a = 0) ∧
        ∃ b₁ b₂ : B, b₁ ≠ 0 ∧ j b₁ * a = j b₂ := by
      intro a
      rw [RingHom.mem_range]
      constructor
      · rintro ⟨y, rfl⟩
        have hy : _root_.IsIntegral B (y : FractionRing B) := y.2
        obtain ⟨f, hfm, hf⟩ := hy
        refine ⟨⟨f, hfm, ?_⟩, ?_⟩
        · apply hAinj
          rw [hevA, hψ, ← hev, hf, map_zero, map_zero]
        · obtain ⟨b₂, b₁, hb₁, hyb⟩ := IsFractionRing.div_surjective B (y : FractionRing B)
          have hb₁0 : b₁ ≠ 0 := nonZeroDivisors.ne_zero hb₁
          have hb₁f : algebraMap B (FractionRing B) b₁ ≠ 0 := fun h0 =>
            hb₁0 (IsFractionRing.injective B (FractionRing B) (h0.trans (map_zero _).symm))
          refine ⟨b₁, b₂, hb₁0, ?_⟩
          apply hAinj
          rw [map_mul, hψ, ← hι, ← hι, ← map_mul, ← hyb]
          congr 1
          field_simp
      · rintro ⟨⟨f, hfm, hf⟩, b₁, b₂, hb₁, hab⟩
        have hjb₁ : algebraMap A (FractionRing A) (j b₁) ≠ 0 := by
          intro h0
          apply hb₁
          apply hj
          apply hAinj
          rw [h0, map_zero, map_zero]
        have hιy0 : ι (algebraMap B (FractionRing B) b₂ / algebraMap B (FractionRing B) b₁) =
            algebraMap A (FractionRing A) a := by
          rw [map_div₀, hι, hι, ← hab, map_mul]
          field_simp
        have hy0int : _root_.IsIntegral B
            (algebraMap B (FractionRing B) b₂ / algebraMap B (FractionRing B) b₁) := by
          refine ⟨f, hfm, ?_⟩
          apply ι.injective
          rw [hev, hιy0, ← hevA, hf, map_zero, map_zero]
        refine ⟨⟨_, hy0int⟩, ?_⟩
        apply hAinj
        rw [hψ]
        exact hιy0
    exact ⟨ψ.range, hmemψ, ⟨(RingEquiv.ofBijective ψ.rangeRestrict
      ⟨fun x y h => hψinj (congrArg Subtype.val h), ψ.rangeRestrict_surjective⟩).symm⟩⟩

  have s6 : ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra K B] [Algebra.FiniteType K B],
      IsNoetherianRing ↥(integralClosure B (FractionRing B)) := by
    intro B _ _ _ _
    obtain ⟨d, g, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg K B
    letI : Algebra (MvPolynomial (Fin d) K) B := g.toRingHom.toAlgebra
    haveI : Module.Finite (MvPolynomial (Fin d) K) B := hfin
    have hinj' : Function.Injective (algebraMap (MvPolynomial (Fin d) K) B) := hinj
    obtain ⟨n, G, hG⟩ := hs3 K d B hinj'
    obtain ⟨T, hT⟩ := hs4 K d n
    haveI : ExpChar (FractionRing B) (ringExpChar K) :=
      expChar_of_injective_algebraMap (algebraMap K (FractionRing B)).injective (ringExpChar K)
    haveI hfinC := hs5 (MvPolynomial (Fin d) K) (FractionRing B)
      (ringExpChar K) n T G hT (integralClosure (MvPolynomial (Fin d) K) (FractionRing B))
      (fun x hx => hG x hx)
    haveI : IsNoetherianRing (integralClosure (MvPolynomial (Fin d) K) (FractionRing B)) :=
      IsNoetherianRing.of_finite (MvPolynomial (Fin d) K) _
    haveI : Algebra.IsIntegral (MvPolynomial (Fin d) K) B := Algebra.IsIntegral.of_finite _ _
    have hmem : ∀ x : FractionRing B, x ∈ integralClosure (MvPolynomial (Fin d) K) (FractionRing B) ↔
        x ∈ integralClosure B (FractionRing B) := by
      intro x
      rw [mem_integralClosure_iff, mem_integralClosure_iff]
      exact ⟨fun h => h.tower_top, fun h => isIntegral_trans x h⟩
    let e : integralClosure (MvPolynomial (Fin d) K) (FractionRing B) ≃+*
        integralClosure B (FractionRing B) :=
      { toFun := fun x => ⟨x.1, (hmem x.1).1 x.2⟩
        invFun := fun x => ⟨x.1, (hmem x.1).2 x.2⟩
        left_inv := fun x => rfl
        right_inv := fun x => rfl
        map_mul' := fun x y => rfl
        map_add' := fun x y => rfl }
    exact isNoetherianRing_of_ringEquiv _ e
  letI : Algebra K A := κ.toAlgebra
  have hT : ∀ S : Finset A, ∃ T : Subring A, (∀ a : A, a ∈ T ↔
      (∃ f : Polynomial (Algebra.adjoin K (S : Set A)),
        f.Monic ∧ f.eval₂ (Algebra.adjoin K (S : Set A)).val.toRingHom a = 0) ∧
      ∃ b₁ b₂ : Algebra.adjoin K (S : Set A), b₁ ≠ 0 ∧
        (Algebra.adjoin K (S : Set A)).val.toRingHom b₁ * a =
          (Algebra.adjoin K (S : Set A)).val.toRingHom b₂) ∧
      Nonempty (↥T ≃+* ↥(integralClosure (Algebra.adjoin K (S : Set A))
        (FractionRing (Algebra.adjoin K (S : Set A))))) :=
    fun S => s2 _ (Algebra.adjoin K (S : Set A)).val.toRingHom Subtype.val_injective
  choose Λ hmem he using hT
  refine ⟨Λ, ?_, ?_, ?_, ?_, ?_⟩
  · intro S S' hSS' a ha
    rw [hmem] at ha ⊢
    obtain ⟨⟨f, hfm, hf⟩, b₁, b₂, hb₁, hb⟩ := ha
    have h : Algebra.adjoin K (S : Set A) ≤ Algebra.adjoin K (S' : Set A) :=
      Algebra.adjoin_mono (Finset.coe_subset.mpr hSS')
    have hc : (Algebra.adjoin K (S' : Set A)).val.toRingHom.comp
        (Subalgebra.inclusion h).toRingHom = (Algebra.adjoin K (S : Set A)).val.toRingHom :=
      RingHom.ext fun _ => rfl
    refine ⟨⟨f.map (Subalgebra.inclusion h).toRingHom, hfm.map _, ?_⟩,
      Subalgebra.inclusion h b₁, Subalgebra.inclusion h b₂, ?_, ?_⟩
    · rw [Polynomial.eval₂_map, hc]
      exact hf
    · intro h0
      apply hb₁
      apply Subalgebra.inclusion_injective h
      rw [h0, map_zero]
    · exact hb
  · intro S a ha
    rw [hmem]
    refine ⟨⟨Polynomial.X - Polynomial.C ⟨a, Algebra.subset_adjoin ha⟩,
      Polynomial.monic_X_sub_C _, ?_⟩, 1, ⟨a, Algebra.subset_adjoin ha⟩, one_ne_zero, ?_⟩
    · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
      exact sub_self a
    · rw [map_one, one_mul]
      rfl
  · intro S c
    rw [hmem]
    refine ⟨⟨Polynomial.X - Polynomial.C (algebraMap K (Algebra.adjoin K (S : Set A)) c),
      Polynomial.monic_X_sub_C _, ?_⟩, 1, algebraMap K (Algebra.adjoin K (S : Set A)) c,
      one_ne_zero, ?_⟩
    · rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C]
      exact sub_self _
    · rw [map_one, one_mul]
      rfl
  · intro S
    obtain ⟨e⟩ := he S
    haveI : Algebra.FiniteType K (Algebra.adjoin K (S : Set A)) :=
      (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset S)
    haveI := s6 (Algebra.adjoin K (S : Set A))
    exact isNoetherianRing_of_ringEquiv _ e.symm
  · intro S
    obtain ⟨e⟩ := he S
    haveI : IsIntegrallyClosed (integralClosure (Algebra.adjoin K (S : Set A))
        (FractionRing (Algebra.adjoin K (S : Set A)))) :=
      integralClosure.isIntegrallyClosedOfFiniteExtension (R := Algebra.adjoin K (S : Set A))
        (FractionRing (Algebra.adjoin K (S : Set A))) (L := FractionRing (Algebra.adjoin K (S : Set A)))
    exact IsIntegrallyClosed.of_equiv e.symm

theorem wc_fnr_smooth_section_descend : ∀ (A : Type u) [CommRing A] (Λ : Finset A → Subring A), Monotone Λ → (∀ S, ∀ a ∈ S, a ∈ Λ S) → ∀ (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → ∃ (S : Finset A) (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of ↥(Λ S))) (σ' : Spec (.of ↥(Λ S)) ⟶ X') (π : X ⟶ X'), IsAffine X' ∧ Smooth f' ∧ σ' ≫ f' = 𝟙 _ ∧ IsPullback π f f' (Spec.map (CommRingCat.ofHom (Λ S).subtype)) ∧ σ ≫ π = Spec.map (CommRingCat.ofHom (Λ S).subtype) ≫ σ' :=
by
  intro A _ Λ _hΛ hS X _ f _ σ hσ

  have s1 : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → ∃ (φ : A →+* Γ(X, ⊤)) (s : Γ(X, ⊤) →+* A), Spec.map (CommRingCat.ofHom φ) = X.isoSpec.inv ≫ f ∧ Spec.map (CommRingCat.ofHom s) = σ ≫ X.isoSpec.hom ∧ φ.Smooth ∧ s.comp φ = RingHom.id A := by
    intro A _ X _ f _ σ hσ
    refine ⟨(Spec.preimage (X.isoSpec.inv ≫ f)).hom, (Spec.preimage (σ ≫ X.isoSpec.hom)).hom, ?_, ?_, ?_, ?_⟩
    · rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    · rw [CommRingCat.ofHom_hom, Spec.map_preimage]
    · have h0 : Smooth (X.isoSpec.inv ≫ f) := inferInstance
      rw [← Spec.map_preimage (X.isoSpec.inv ≫ f)] at h0
      exact (HasRingHomProperty.Spec_iff (P := @Smooth)).mp h0
    · have h1 : Spec.map (CommRingCat.ofHom ((Spec.preimage (σ ≫ X.isoSpec.hom)).hom.comp
          (Spec.preimage (X.isoSpec.inv ≫ f)).hom)) = Spec.map (𝟙 (CommRingCat.of A)) := by
        rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, CommRingCat.ofHom_hom,
          Spec.map_preimage, Spec.map_preimage, Spec.map_id]
        simp [hσ]
      have h2 := Spec.map_injective h1
      exact congrArg CommRingCat.Hom.hom h2

  have s2 : ∀ (A : Type u) [CommRing A] (Λ : Finset A → Subring A), (∀ S, ∀ a ∈ S, a ∈ Λ S) → ∀ (B : Type u) [CommRing B] [Algebra A B] (s : B →+* A), s.comp (algebraMap A B) = RingHom.id A → ∀ (A₀ : Subalgebra ℤ A), A₀.FG → ∀ (B₀ : Type u) [CommRing B₀] [Algebra A₀ B₀] [Algebra.FiniteType A₀ B₀] (e : B ≃ₐ[A] TensorProduct A₀ A B₀), ∃ S : Finset A, (∀ a : A₀, (a : A) ∈ Λ S) ∧ ∀ y : B₀, s (e.symm ((1 : A) ⊗ₜ[A₀] y)) ∈ Λ S := by
    intro A _ Λ hS B _ _ s hs A₀ hfg B₀ _ _ _ e
    classical
    obtain ⟨t, ht⟩ := hfg
    obtain ⟨u, hu⟩ := (Algebra.FiniteType.out : (⊤ : Subalgebra A₀ B₀).FG)
    let h : B₀ →+* A := s.comp (e.symm.toRingHom.comp
      (Algebra.TensorProduct.includeRight : B₀ →ₐ[A₀] TensorProduct A₀ A B₀).toRingHom)
    have hh : ∀ y, h y = s (e.symm ((1 : A) ⊗ₜ[A₀] y)) := fun y => rfl
    have hkey : ∀ a : A₀, h (algebraMap A₀ B₀ a) = (a : A) := by
      intro a
      have e1 : ((1 : A) ⊗ₜ[A₀] algebraMap A₀ B₀ a : TensorProduct A₀ A B₀) =
          algebraMap A (TensorProduct A₀ A B₀) (a : A) := by
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
          Algebra.algebraMap_eq_smul_one a, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        rfl
      rw [hh, e1, AlgEquiv.commutes]
      exact RingHom.congr_fun hs _
    have hA' : ∀ x ∈ Algebra.adjoin ℤ (t : Set A), x ∈ Λ (t ∪ u.image h) := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact hS _ _ (Finset.mem_union_left _ hx)
      | algebraMap n => rw [eq_intCast]; exact intCast_mem _ n
      | add x y _ _ hx hy => exact add_mem hx hy
      | mul x y _ _ hx hy => exact mul_mem hx hy
    have hA : ∀ a : A₀, (a : A) ∈ Λ (t ∪ u.image h) := by
      intro a
      exact hA' a (by rw [ht]; exact a.2)
    refine ⟨t ∪ u.image h, hA, ?_⟩
    intro y
    rw [← hh]
    have hy : y ∈ (⊤ : Subalgebra A₀ B₀) := trivial
    rw [← hu] at hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx => exact hS _ _ (Finset.mem_union_right _ (Finset.mem_image_of_mem h hx))
    | algebraMap a => rw [hkey]; exact hA a
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy

  have s3 : ∀ (A : Type u) [CommRing A] (A₀ : Subalgebra ℤ A) (R : Subring A), (∀ a : A₀, (a : A) ∈ R) → ∀ (B : Type u) [CommRing B] [Algebra A B] (s : B →+* A), s.comp (algebraMap A B) = RingHom.id A → ∀ (B₀ : Type u) [CommRing B₀] [Algebra A₀ B₀] [Algebra.Smooth A₀ B₀] (e : B ≃ₐ[A] TensorProduct A₀ A B₀), (∀ y : B₀, s (e.symm ((1 : A) ⊗ₜ[A₀] y)) ∈ R) → ∃ (B₁ : Type u) (_ : CommRing B₁) (g : ↥R →+* B₁) (τ : B₁ →+* ↥R) (ψ : B₁ →+* B), g.Smooth ∧ τ.comp g = RingHom.id ↥R ∧ IsPushout (CommRingCat.ofHom R.subtype) (CommRingCat.ofHom g) (CommRingCat.ofHom (algebraMap A B)) (CommRingCat.ofHom ψ) ∧ s.comp ψ = R.subtype.comp τ := by
    intro A _ A₀ R hR B _ _ s hs B₀ _ _ _ e hy
    letI : Algebra A₀ R := (RingHom.codRestrict A₀.val.toRingHom R hR).toAlgebra
    haveI : IsScalarTower A₀ R A := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Smooth R (TensorProduct A₀ R B₀) := Algebra.Smooth.baseChange A₀ B₀ R
    have hkey : ∀ a : A₀, s (e.symm ((1 : A) ⊗ₜ[A₀] algebraMap A₀ B₀ a)) = (a : A) := by
      intro a
      have e1 : ((1 : A) ⊗ₜ[A₀] algebraMap A₀ B₀ a : TensorProduct A₀ A B₀) =
          algebraMap A (TensorProduct A₀ A B₀) (a : A) := by
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
          Algebra.algebraMap_eq_smul_one a, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        rfl
      rw [e1, AlgEquiv.commutes]
      exact RingHom.congr_fun hs _
    let h' : B₀ →ₐ[A₀] R :=
      { toRingHom := (s.comp (e.symm.toRingHom.comp
          (Algebra.TensorProduct.includeRight : B₀ →ₐ[A₀] TensorProduct A₀ A B₀).toRingHom)).codRestrict
            R hy
        commutes' := fun a => Subtype.ext (hkey a) }
    let τ : TensorProduct A₀ R B₀ →+* R :=
      (Algebra.TensorProduct.lift (AlgHom.id R R) h' (fun _ _ => Commute.all _ _)).toRingHom
    have hτ : ∀ (r : R) (y : B₀), τ (r ⊗ₜ[A₀] y) = r * h' y := by
      intro r y
      simp [τ, Algebra.TensorProduct.lift_tmul]
    let cbc := Algebra.TensorProduct.cancelBaseChange A₀ R A A B₀
    let E : TensorProduct R A (TensorProduct A₀ R B₀) ≃ₐ[A] B := cbc.trans e.symm
    let ψ : TensorProduct A₀ R B₀ →+* B := E.toRingHom.comp
      (Algebra.TensorProduct.includeRight : TensorProduct A₀ R B₀ →ₐ[R]
        TensorProduct R A (TensorProduct A₀ R B₀)).toRingHom
    have hψ : ∀ (r : R) (y : B₀), ψ (r ⊗ₜ[A₀] y) = e.symm ((r : A) ⊗ₜ[A₀] y) := by
      intro r y
      show e.symm (cbc ((1 : A) ⊗ₜ[R] (r ⊗ₜ[A₀] y))) = _
      rw [Algebra.TensorProduct.cancelBaseChange_tmul, Algebra.smul_def, mul_one]
      rfl
    refine ⟨TensorProduct A₀ R B₀, inferInstance, algebraMap R (TensorProduct A₀ R B₀), τ, ψ,
      RingHom.smooth_algebraMap.mpr inferInstance, ?_, ?_, ?_⟩
    · refine RingHom.ext fun r => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply, Algebra.TensorProduct.algebraMap_apply,
        Algebra.algebraMap_self, hτ, map_one, mul_one]
    · refine IsPushout.of_iso (CommRingCat.isPushout_tensorProduct R A (TensorProduct A₀ R B₀))
        (Iso.refl _) (Iso.refl _) (Iso.refl _) E.toRingEquiv.toCommRingCatIso ?_ ?_ ?_ ?_
      · rfl
      · rfl
      · ext a
        show E (a ⊗ₜ[R] (1 : TensorProduct A₀ R B₀)) = algebraMap A B a
        have h0 := E.commutes a
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] at h0
        exact h0
      · rfl
    · refine RingHom.ext fun z => ?_
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul r y =>
        have h2 : ((r : A) ⊗ₜ[A₀] y : TensorProduct A₀ A B₀) =
            algebraMap A _ (r : A) * ((1 : A) ⊗ₜ[A₀] y) := by
          rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
            Algebra.algebraMap_self, RingHom.id_apply, mul_one, one_mul]
        have h4 : s (algebraMap A B (r : A)) = r := RingHom.congr_fun hs _
        simp only [RingHom.comp_apply]
        rw [hψ, hτ, h2, map_mul, map_mul, AlgEquiv.commutes, h4]
        rfl
      | add x y hx hy => simp only [map_add, hx, hy]

  have s4 : ∀ (A : Type u) [CommRing A] (R : Subring A) (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) (σ : Spec (.of A) ⟶ X) (φ : A →+* Γ(X, ⊤)) (s : Γ(X, ⊤) →+* A), Spec.map (CommRingCat.ofHom φ) = X.isoSpec.inv ≫ f → Spec.map (CommRingCat.ofHom s) = σ ≫ X.isoSpec.hom → ∀ (B₁ : Type u) [CommRing B₁] (g : ↥R →+* B₁) (τ : B₁ →+* ↥R) (ψ : B₁ →+* Γ(X, ⊤)), g.Smooth → τ.comp g = RingHom.id ↥R → IsPushout (CommRingCat.ofHom R.subtype) (CommRingCat.ofHom g) (CommRingCat.ofHom φ) (CommRingCat.ofHom ψ) → s.comp ψ = R.subtype.comp τ → ∃ (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of ↥R)) (σ' : Spec (.of ↥R) ⟶ X') (π : X ⟶ X'), IsAffine X' ∧ Smooth f' ∧ σ' ≫ f' = 𝟙 _ ∧ IsPullback π f f' (Spec.map (CommRingCat.ofHom R.subtype)) ∧ σ ≫ π = Spec.map (CommRingCat.ofHom R.subtype) ≫ σ' := by
    intro A _ R X _ f σ φ s hφ hs B₁ _ g τ ψ hg hτ hpo hsψ
    refine ⟨Spec (.of B₁), Spec.map (CommRingCat.ofHom g), Spec.map (CommRingCat.ofHom τ),
      X.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom ψ), inferInstance, ?_, ?_, ?_, ?_⟩
    · exact (HasRingHomProperty.Spec_iff (P := @Smooth)).mpr hg
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hτ, CommRingCat.ofHom_id, Spec.map_id]
    · have h1 := (isPullback_SpecMap_of_isPushout _ _ _ _ hpo).flip
      refine IsPullback.of_iso h1 X.isoSpec.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp [hφ]
      · simp
      · simp
    · rw [← Category.assoc, ← hs, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← CommRingCat.ofHom_comp, hsψ]

  obtain ⟨φ, s, hφ, hs, hsm, hsφ⟩ := s1 A X f σ hσ
  letI : Algebra A Γ(X, ⊤) := φ.toAlgebra
  haveI : Algebra.Smooth A Γ(X, ⊤) := RingHom.Smooth.toAlgebra hsm
  obtain ⟨A₀, B₀, _, _, hfg, hsm₀, ⟨e⟩⟩ := Algebra.Smooth.exists_subalgebra_fg ℤ A Γ(X, ⊤)
  haveI := hsm₀
  obtain ⟨S, hA₀, hy⟩ := s2 A Λ hS Γ(X, ⊤) s hsφ A₀ hfg B₀ e
  obtain ⟨B₁, _, g, τ, ψ, hg, hτ, hpo, hsψ⟩ := s3 A A₀ (Λ S) hA₀ Γ(X, ⊤) s hsφ B₀ e hy
  obtain ⟨X', f', σ', π, h1, h2, h3, h4, h5⟩ :=
    s4 A (Λ S) X f σ φ s hφ hs B₁ g τ ψ hg hτ hpo hsψ
  exact ⟨S, X', f', σ', π, h1, h2, h3, h4, h5⟩

theorem wc_fnr_noetherian_section_component_open : ∀ (A₀ : Type u) [CommRing A₀] [IsNoetherianRing A₀] (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _), ∃ U : X.Opens, CompactSpace ↥(U : Scheme.{u}) ∧ QuasiSeparatedSpace ↥(U : Scheme.{u}) ∧ Set.range σ ⊆ (U : Set X) ∧ (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback (U.ι ≫ f) z)) ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)) (t : ↥(Limits.pullback f z)), t ∈ connectedComponent ((Limits.pullback.lift (z ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]) : Spec (.of Ω) ⟶ Limits.pullback f z) (IsLocalRing.closedPoint Ω)) → Limits.pullback.fst f z t ∈ (U : Set X) :=
by
  intro A₀ _ _ X _ f _ σ hσ
  classical
  have hgen := wc_x0_stableUnderGeneralization A₀ X f σ hσ
  have hcons := wc_x0_isConstructible_noetherian A₀ X f σ hσ
  set E : Set X := {x : X | x ∈ connectedComponentIn (f ⁻¹' {f x}) (σ (f x))} with hE

  have hopen : IsOpen E := by
    have h1 : Topology.IsConstructible (X.isoSpec.inv ⁻¹' E) :=
      Scheme.Hom.isConstructible_preimage X.isoSpec.inv hcons
    have h2 : StableUnderGeneralization (X.isoSpec.inv ⁻¹' E) :=
      hgen.preimage X.isoSpec.inv.continuous
    have h3 : IsOpen (X.isoSpec.inv ⁻¹' E) :=
      PrimeSpectrum.isOpen_of_stableUnderGeneralization_of_isConstructible h2 h1
    have h4 : X.isoSpec.hom ⁻¹' (X.isoSpec.inv ⁻¹' E) = E := by
      ext x
      have hx : X.isoSpec.inv (X.isoSpec.hom x) = x := by
        rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
        rfl
      simp only [Set.mem_preimage, hx]
    rw [← h4]
    exact h3.preimage X.isoSpec.hom.continuous
  let U : X.Opens := ⟨E, hopen⟩
  have hU : (U : Set X) = E := rfl

  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have : AlgebraicGeometry.IsNoetherian X := AlgebraicGeometry.IsNoetherian.mk
  have hcU : IsCompact (U : Set X) := TopologicalSpace.NoetherianSpace.isCompact _
  have C1 : CompactSpace ↥(U : Scheme.{u}) := by
    rw [← isCompact_univ_iff, U.ι.isOpenEmbedding.isInducing.isCompact_iff, Set.image_univ,
      Scheme.Opens.range_ι]
    exact hcU

  have C2 : QuasiSeparatedSpace ↥(U : Scheme.{u}) := quasiSeparatedSpace_of_quasiSeparated U.ι

  have C3 : Set.range σ ⊆ (U : Set X) := by
    rintro _ ⟨y, rfl⟩
    have hy : f (σ y) = y := by
      rw [← Scheme.Hom.comp_apply, hσ]
      rfl
    show σ y ∈ connectedComponentIn (f ⁻¹' {f (σ y)}) (σ (f (σ y)))
    rw [hy]
    exact mem_connectedComponentIn (Set.mem_preimage.mpr (Set.mem_singleton_iff.mpr hy))

  have key : ∀ (Ω : Type u) [Field Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀))
      (t : ↥(Limits.pullback f z)),
      t ∈ connectedComponent ((Limits.pullback.lift (z ≫ σ) (𝟙 _)
        (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]) :
          Spec (.of Ω) ⟶ Limits.pullback f z) (IsLocalRing.closedPoint Ω)) ↔
        Limits.pullback.fst f z t ∈ (U : Set X) := by
    intro Ω _ z t
    have hB := wc_x0_baseChange_preimage X (Spec (.of A₀)) (Limits.pullback f z) (Spec (.of Ω))
      f σ hσ z (Limits.pullback.snd f z) (Limits.pullback.fst f z)
      (Limits.pullback.lift (z ≫ σ) (𝟙 _)
        (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]))
      (IsPullback.of_hasPullback f z) (Limits.pullback.lift_snd _ _ _)
      (Limits.pullback.lift_fst _ _ _) t
    have huniv : (Limits.pullback.snd f z) ⁻¹' {Limits.pullback.snd f z t} = Set.univ :=
      Set.eq_univ_of_forall (fun _ => Subsingleton.elim _ _)
    have hpt : Limits.pullback.snd f z t = IsLocalRing.closedPoint Ω := Subsingleton.elim _ _
    rw [huniv, hpt, connectedComponentIn_univ] at hB
    exact hB

  have C4 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)),
      ConnectedSpace ↥(Limits.pullback (U.ι ≫ f) z) := by
    intro Ω _ _ z
    have hconn : _root_.IsConnected ((Limits.pullback.fst f z) ⁻¹' (U : Set X)) := by
      have hpre : (Limits.pullback.fst f z) ⁻¹' (U : Set X) =
          connectedComponent ((Limits.pullback.lift (z ≫ σ) (𝟙 _)
            (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]) :
              Spec (.of Ω) ⟶ Limits.pullback f z) (IsLocalRing.closedPoint Ω)) := by
        ext t
        exact (key Ω z t).symm
      rw [hpre]
      exact isConnected_connectedComponent
    have hrange : Set.range (Limits.pullback.snd U.ι (Limits.pullback.fst f z)) =
        (Limits.pullback.fst f z) ⁻¹' (U : Set X) := by
      rw [IsOpenImmersion.range_pullbackSnd, Scheme.Opens.opensRange_ι]
      rfl
    have hV : ConnectedSpace ↥(Limits.pullback U.ι (Limits.pullback.fst f z)) := by
      rw [connectedSpace_iff_univ]
      obtain ⟨t, ht⟩ := hconn.nonempty
      rw [← hrange] at ht
      obtain ⟨v, -⟩ := ht
      refine ⟨⟨v, Set.mem_univ _⟩, ?_⟩
      rw [← (Limits.pullback.snd U.ι (Limits.pullback.fst f z)).isOpenEmbedding.isInducing.isPreconnected_image,
        Set.image_univ, hrange]
      exact hconn.isPreconnected
    exact (Homeomorph.connectedSpace_iff
      (Scheme.homeoOfIso (Limits.pullbackRightPullbackFstIso f z U.ι))).mp hV
  exact ⟨U, C1, C2, C3, C4, fun Ω _ _ z t ht => (key Ω z t).mp ht⟩

theorem wc_fnr_factor_through_component_open : ∀ (A A' : Type u) [CommRing A] [CommRing A'] (ι : A' →+* A) (X X' : Scheme.{u}) (f : X ⟶ Spec (.of A)) (f' : X' ⟶ Spec (.of A')) (σ : Spec (.of A) ⟶ X) (σ' : Spec (.of A') ⟶ X') (hσ : σ ≫ f = 𝟙 _) (hσ' : σ' ≫ f' = 𝟙 _) (π : X ⟶ X'), IsPullback π f f' (Spec.map (CommRingCat.ofHom ι)) → σ ≫ π = Spec.map (CommRingCat.ofHom ι) ≫ σ' → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (U : X'.Opens), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A')) (t : ↥(Limits.pullback f' z)), t ∈ connectedComponent ((Limits.pullback.lift (z ≫ σ') (𝟙 _) (by rw [Category.assoc, hσ', Category.comp_id, Category.id_comp]) : Spec (.of Ω) ⟶ Limits.pullback f' z) (IsLocalRing.closedPoint Ω)) → Limits.pullback.fst f' z t ∈ (U : Set X')) → ∃ πU : X ⟶ (U : Scheme.{u}), πU ≫ U.ι = π ∧ IsPullback πU f (U.ι ≫ f') (Spec.map (CommRingCat.ofHom ι)) :=
by
  intro A A' _ _ ι X X' f f' σ σ' hσ hσ' π hπ hσπ hconn U hU
  have hcomm : π ≫ f' = f ≫ Spec.map (CommRingCat.ofHom ι) := hπ.toCommSq.w

  have hr : Set.range π ⊆ (U : Set X') := by
    rintro _ ⟨x, rfl⟩
    obtain ⟨e, he⟩ : ∃ e : Spec (.of (AlgebraicClosure (X.residueField x))) ⟶ X,
        e (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))) = x :=
      ⟨Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x)
          (AlgebraicClosure (X.residueField x)))) ≫ X.fromSpecResidueField x,
        (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply x _)⟩
    have hΘw : (Limits.pullback.fst f (e ≫ f) ≫ π) ≫ f' =
        Limits.pullback.snd f (e ≫ f) ≫ ((e ≫ f) ≫ Spec.map (CommRingCat.ofHom ι)) := by
      rw [Category.assoc, hcomm, ← Category.assoc, Limits.pullback.condition, Category.assoc]
    obtain ⟨Θ, hΘ1, hΘ2⟩ : ∃ Θ : Limits.pullback f (e ≫ f) ⟶
        Limits.pullback f' ((e ≫ f) ≫ Spec.map (CommRingCat.ofHom ι)),
        Θ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst f (e ≫ f) ≫ π ∧
        Θ ≫ Limits.pullback.snd _ _ = Limits.pullback.snd f (e ≫ f) :=
      ⟨Limits.pullback.lift _ _ hΘw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hs₀w : ((e ≫ f) ≫ σ) ≫ f = 𝟙 _ ≫ (e ≫ f) := by
      rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]
    obtain ⟨s₀, hs₀1, hs₀2⟩ : ∃ s₀ : Spec (.of (AlgebraicClosure (X.residueField x))) ⟶
        Limits.pullback f (e ≫ f),
        s₀ ≫ Limits.pullback.fst _ _ = (e ≫ f) ≫ σ ∧ s₀ ≫ Limits.pullback.snd _ _ = 𝟙 _ :=
      ⟨Limits.pullback.lift _ _ hs₀w, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have ht₀w : e ≫ f = 𝟙 _ ≫ (e ≫ f) := (Category.id_comp _).symm
    obtain ⟨t₀, ht₀1, -⟩ : ∃ t₀ : Spec (.of (AlgebraicClosure (X.residueField x))) ⟶
        Limits.pullback f (e ≫ f),
        t₀ ≫ Limits.pullback.fst _ _ = e ∧ t₀ ≫ Limits.pullback.snd _ _ = 𝟙 _ :=
      ⟨Limits.pullback.lift _ _ ht₀w, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hs' : s₀ ≫ Θ = (Limits.pullback.lift (((e ≫ f) ≫ Spec.map (CommRingCat.ofHom ι)) ≫ σ')
        (𝟙 _) (by rw [Category.assoc, hσ', Category.comp_id, Category.id_comp]) :
        Spec (.of (AlgebraicClosure (X.residueField x))) ⟶
          Limits.pullback f' ((e ≫ f) ≫ Spec.map (CommRingCat.ofHom ι))) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hΘ1, ← Category.assoc, hs₀1, Limits.pullback.lift_fst,
          Category.assoc, hσπ]
        simp only [Category.assoc]
      · rw [Category.assoc, hΘ2, hs₀2, Limits.pullback.lift_snd]
    have := hconn (AlgebraicClosure (X.residueField x)) (e ≫ f)
    have hrange : Set.range Θ ⊆ connectedComponent
        ((Limits.pullback.lift (((e ≫ f) ≫ Spec.map (CommRingCat.ofHom ι)) ≫ σ')
        (𝟙 _) (by rw [Category.assoc, hσ', Category.comp_id, Category.id_comp]) :
        Spec (.of (AlgebraicClosure (X.residueField x))) ⟶
          Limits.pullback f' ((e ≫ f) ≫ Spec.map (CommRingCat.ofHom ι)))
          (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) := by
      apply (isConnected_range Θ.continuous).isPreconnected.subset_connectedComponent
      exact ⟨s₀ (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))),
        (Scheme.Hom.comp_apply s₀ Θ _).symm.trans (by rw [hs'])⟩
    have hmem := hU (AlgebraicClosure (X.residueField x))
      ((e ≫ f) ≫ Spec.map (CommRingCat.ofHom ι))
      (Θ (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))))
      (hrange ⟨_, rfl⟩)
    have hpt : Limits.pullback.fst f' ((e ≫ f) ≫ Spec.map (CommRingCat.ofHom ι))
        (Θ (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))))) = π x := by
      calc _ = (Θ ≫ Limits.pullback.fst f' ((e ≫ f) ≫ Spec.map (CommRingCat.ofHom ι)))
              (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) :=
            (Scheme.Hom.comp_apply _ _ _).symm
        _ = (Limits.pullback.fst f (e ≫ f) ≫ π)
              (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) := by
            rw [hΘ1]
        _ = π (Limits.pullback.fst f (e ≫ f)
              (t₀ (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x))))) :=
            Scheme.Hom.comp_apply _ _ _
        _ = π ((t₀ ≫ Limits.pullback.fst f (e ≫ f))
              (IsLocalRing.closedPoint (AlgebraicClosure (X.residueField x)))) :=
            congrArg π (Scheme.Hom.comp_apply _ _ _).symm
        _ = π x := by rw [ht₀1, he]
    rw [hpt] at hmem
    exact hmem

  have hr' : Set.range π ⊆ Set.range U.ι := by rw [Scheme.Opens.range_ι]; exact hr
  obtain ⟨πU, hfac⟩ : ∃ πU : X ⟶ (U : Scheme.{u}), πU ≫ U.ι = π :=
    ⟨IsOpenImmersion.lift U.ι π hr', IsOpenImmersion.lift_fac _ _ _⟩
  refine ⟨πU, hfac, ?_⟩
  have hw : πU ≫ (U.ι ≫ f') = f ≫ Spec.map (CommRingCat.ofHom ι) := by
    rw [← Category.assoc, hfac, hcomm]
  refine IsPullback.of_isLimit' ⟨hw⟩ ?_
  refine Limits.PullbackCone.IsLimit.mk hw
    (fun s => hπ.lift (s.fst ≫ U.ι) s.snd (by rw [Category.assoc]; exact s.condition)) ?_ ?_ ?_
  · intro s
    rw [← cancel_mono U.ι, Category.assoc, hfac, IsPullback.lift_fst]
  · intro s
    exact IsPullback.lift_snd _ _ _ _
  · intro s m h1 h2
    apply hπ.hom_ext
    · rw [IsPullback.lift_fst, ← hfac, ← Category.assoc, h1]
    · rw [IsPullback.lift_snd, h2]

theorem wc_fnr_torsor_point_descend : ∀ (A : Type u) [CommRing A] [IsDomain A] (Λ : Finset A → Subring A) (hΛ : Monotone Λ), (∀ S, ∀ a ∈ S, a ∈ Λ S) → ∀ (L : Type u) [Field L] [IsAlgClosed L] (j : A →+* L), Function.Injective j → (∀ y : L, ∃ a₁ b₁ : A, j b₁ ≠ 0 ∧ y * j b₁ = j a₁) → ∀ (S₀ : Finset A) (X' : Scheme.{u}) [IsAffine X'] (f' : X' ⟶ Spec (.of ↥(Λ S₀))) (σ' : Spec (.of ↥(Λ S₀)) ⟶ X') (hσ' : σ' ≫ f' = 𝟙 _) (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) (σ : Spec (.of A) ⟶ X) (π : X ⟶ X'), σ ≫ f = 𝟙 _ → IsPullback π f f' (Spec.map (CommRingCat.ofHom (Λ S₀).subtype)) → σ ≫ π = Spec.map (CommRingCat.ofHom (Λ S₀).subtype) ≫ σ' → ∀ (m : ℕ), m ≠ 0 → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom j))) (α : ZMod m → (P ⟶ P)), wcFetTorsor p m α → ∃ (T : Finset A) (hT : S₀ ≤ T) (φ : FractionRing ↥(Λ T) →+* L) (PT : Scheme.{u}) (pT : PT ⟶ Limits.pullback f' (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT))))) (αT : ZMod m → (PT ⟶ PT)) (jP : P ⟶ PT) (mT : Limits.pullback f (Spec.map (CommRingCat.ofHom j)) ⟶ Limits.pullback f' (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT))))), φ.comp (algebraMap ↥(Λ T) (FractionRing ↥(Λ T))) = j.comp (Λ T).subtype ∧ wcFetTorsor pT m αT ∧ IsPullback jP p pT mT ∧ mT ≫ Limits.pullback.fst _ _ = Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ π ∧ mT ≫ Limits.pullback.snd _ _ = Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j)) ≫ Spec.map (CommRingCat.ofHom φ) ∧ ∃ r : Spec (.of (FractionRing ↥(Λ T))) ⟶ PT, r ≫ pT = Limits.pullback.lift ((Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) ≫ σ') (𝟙 _) (by rw [Category.assoc, hσ', Category.comp_id, Category.id_comp]) :=
by
  intro A _ _ Λ hΛ hS L _ _ j hj hfrac S₀ X' _ f' σ' hσ' X f σ π hσ hπ hσπ m hm P p α hP
  classical

  obtain ⟨φ, hφx⟩ : ∃ φ : ∀ T : Finset A, FractionRing ↥(Λ T) →+* L,
      ∀ T (x : ↥(Λ T)), φ T (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)) x) = j x := by
    refine ⟨fun T => IsFractionRing.lift (g := j.comp (Λ T).subtype)
      (hj.comp Subtype.val_injective : Function.Injective (j.comp (Λ T).subtype)), fun T x => ?_⟩
    exact IsFractionRing.lift_algebraMap _ x
  obtain ⟨τ, hτx⟩ : ∃ τ : ∀ T T' : Finset A, T ≤ T' →
      (FractionRing ↥(Λ T) →+* FractionRing ↥(Λ T')),
      ∀ T T' (h : T ≤ T') (x : ↥(Λ T)), τ T T' h (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)) x) =
        algebraMap ↥(Λ T') (FractionRing ↥(Λ T')) (Subring.inclusion (hΛ h) x) := by
    refine ⟨fun T T' h => IsFractionRing.lift
      (g := (algebraMap ↥(Λ T') (FractionRing ↥(Λ T'))).comp (Subring.inclusion (hΛ h)))
      ((IsFractionRing.injective _ _).comp (Subring.inclusion_injective (hΛ h)) :
        Function.Injective ((algebraMap ↥(Λ T') (FractionRing ↥(Λ T'))).comp
          (Subring.inclusion (hΛ h)))), fun T T' h x => ?_⟩
    exact IsFractionRing.lift_algebraMap _ x
  have D1 : ∀ (T T' : Finset A) (h : T ≤ T'), (φ T').comp (τ T T' h) = φ T := fun T T' h =>
    IsLocalization.ringHom_ext (nonZeroDivisors ↥(Λ T)) (RingHom.ext fun x => by
      simp only [RingHom.comp_apply, hτx, hφx]; try rfl)
  have D2 : ∀ (T : Finset A) (h : T ≤ T), τ T T h = RingHom.id _ := fun T h =>
    IsLocalization.ringHom_ext (nonZeroDivisors ↥(Λ T)) (RingHom.ext fun x => by
      simp only [RingHom.comp_apply, hτx, RingHom.id_apply]; try rfl)
  have D3 : ∀ (T T' T'' : Finset A) (h : T ≤ T') (h' : T' ≤ T''),
      (τ T' T'' h').comp (τ T T' h) = τ T T'' (h.trans h') := fun T T' T'' h h' =>
    IsLocalization.ringHom_ext (nonZeroDivisors ↥(Λ T)) (RingHom.ext fun x => by
      simp only [RingHom.comp_apply, hτx]; try rfl)
  have SD1 : ∀ (T T' : Finset A) (h : T ≤ T'), Spec.map (CommRingCat.ofHom (φ T')) ≫
      Spec.map (CommRingCat.ofHom (τ T T' h)) = Spec.map (CommRingCat.ofHom (φ T)) := by
    intro T T' h
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, D1]
  have SD3 : ∀ (T T' T'' : Finset A) (h : T ≤ T') (h' : T' ≤ T''),
      Spec.map (CommRingCat.ofHom (τ T' T'' h')) ≫ Spec.map (CommRingCat.ofHom (τ T T' h)) =
        Spec.map (CommRingCat.ofHom (τ T T'' (h.trans h'))) := by
    intro T T' T'' h h'
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, D3]
  have SD4 : ∀ (S T T' : Finset A) (h1 : S ≤ T) (h2 : T ≤ T'),
      Spec.map (CommRingCat.ofHom (τ T T' h2)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) ≫
          Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ h1))) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T') (FractionRing ↥(Λ T')))) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ (h1.trans h2)))) := by
    intro S T T' h1 h2
    simp only [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext x
    simp only [RingHom.comp_apply, hτx]
    try rfl
  have SD5 : ∀ (S T : Finset A) (h : S ≤ T),
      Spec.map (CommRingCat.ofHom (φ T)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) ≫
          Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ h))) =
      Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom (Λ S).subtype) := by
    intro S T h
    simp only [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext x
    simp only [RingHom.comp_apply, hφx]
    try rfl

  let G : Finset A → (Finset A ⥤ CommRingCat.{u}) := fun T₀ =>
    { obj := fun V => CommRingCat.of (FractionRing ↥(Λ (T₀ ∪ V)))
      map := fun {V V'} hV => CommRingCat.ofHom
        (τ (T₀ ∪ V) (T₀ ∪ V') (Finset.union_subset_union_right (leOfHom hV)))
      map_id := fun V => by rw [D2]; rfl
      map_comp := fun {V V' V''} h h' => by rw [← CommRingCat.ofHom_comp, D3] }
  let cc : ∀ T₀ : Finset A, Limits.Cocone (G T₀) := fun T₀ =>
    { pt := CommRingCat.of L
      ι := { app := fun V => CommRingCat.ofHom (φ (T₀ ∪ V))
             naturality := fun V V' hV => by
               change CommRingCat.ofHom (τ _ _ _) ≫ CommRingCat.ofHom (φ _) =
                 CommRingCat.ofHom (φ _) ≫ 𝟙 _
               rw [Category.comp_id, ← CommRingCat.ofHom_comp, D1] } }
  have hcol : ∀ T₀, Limits.IsColimit (cc T₀) := by
    intro T₀
    haveI : Limits.ReflectsColimitsOfShape (Finset A) (forget CommRingCat.{u}) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    refine Limits.isColimitOfReflects (forget CommRingCat.{u})
      (Limits.Types.FilteredColimit.isColimitOf' _ _ ?_ ?_)
    · intro y
      obtain ⟨a₁, b₁, hb, hy⟩ := hfrac y
      have ha : a₁ ∈ Λ (T₀ ∪ {a₁, b₁}) := hS _ _ (by simp)
      have hb' : b₁ ∈ Λ (T₀ ∪ {a₁, b₁}) := hS _ _ (by simp)
      have hb0 : algebraMap ↥(Λ (T₀ ∪ {a₁, b₁})) (FractionRing ↥(Λ (T₀ ∪ {a₁, b₁})))
          ⟨b₁, hb'⟩ ≠ 0 := by
        intro h0
        apply hb
        have h1 := hφx (T₀ ∪ {a₁, b₁}) ⟨b₁, hb'⟩
        rw [h0, map_zero] at h1
        exact h1.symm
      refine ⟨{a₁, b₁}, algebraMap ↥(Λ (T₀ ∪ {a₁, b₁})) (FractionRing ↥(Λ (T₀ ∪ {a₁, b₁})))
        ⟨a₁, ha⟩ / algebraMap ↥(Λ (T₀ ∪ {a₁, b₁})) (FractionRing ↥(Λ (T₀ ∪ {a₁, b₁})))
        ⟨b₁, hb'⟩, ?_⟩
      change y = φ (T₀ ∪ {a₁, b₁}) _
      rw [map_div₀, hφx, hφx]
      exact eq_div_of_mul_eq (G₀ := L) hb hy
    · intro V x y hxy
      have h' : φ (T₀ ∪ V) x = φ (T₀ ∪ V) y := hxy
      have h2 := (φ (T₀ ∪ V)).injective h'
      exact ⟨V, 𝟙 V, by rw [h2]⟩
  have hlim : ∀ T₀, Limits.IsLimit (Scheme.Spec.mapCone (cc T₀).op) := fun T₀ =>
    Limits.isLimitOfPreserves Scheme.Spec (hcol T₀).op
  have hlimEU : ∀ (T₀ : Finset A) (Z : Scheme.{u})
      (zz : ∀ l : (Finset A)ᵒᵖ, Z ⟶ ((G T₀).op ⋙ Scheme.Spec).obj l),
      (∀ {l l' : (Finset A)ᵒᵖ} (t : l ⟶ l'), zz l ≫ ((G T₀).op ⋙ Scheme.Spec).map t = zz l') →
      ∃! z₀ : Z ⟶ Spec (.of L), ∀ l, z₀ ≫ Spec.map (CommRingCat.ofHom (φ (T₀ ∪ l.unop))) = zz l := by
    intro T₀ Z zz hzz
    have hnat : ∀ (l l' : (Finset A)ᵒᵖ) (t : l ⟶ l'),
        ((Functor.const (Finset A)ᵒᵖ).obj Z).map t ≫ zz l' = zz l ≫ ((G T₀).op ⋙ Scheme.Spec).map t := by
      intro l l' t
      rw [Functor.const_obj_map]
      exact (Category.id_comp _).trans (hzz t).symm
    let s : Limits.Cone ((G T₀).op ⋙ Scheme.Spec) :=
      { pt := Z, π := { app := zz, naturality := hnat } }
    exact (hlim T₀).existsUnique s

  let F : (Finset A)ᵒᵖ ⥤ Over (Spec (.of ↥(Λ S₀))) :=
    ((G S₀).op ⋙ Scheme.Spec).toOver (Spec (.of ↥(Λ S₀)))
      (fun l => Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (S₀ ∪ l.unop)) (FractionRing ↥(Λ (S₀ ∪ l.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ (Finset.subset_union_left : S₀ ⊆ S₀ ∪ l.unop)))))
      (fun {l l'} t => SD4 S₀ (S₀ ∪ l'.unop) (S₀ ∪ l.unop) Finset.subset_union_left
        (Finset.union_subset_union_right (leOfHom t.unop)))

  have H1 : IsPullback (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ π) (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j))) f' (Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom (Λ S₀).subtype)) :=
    (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom j))).paste_horiz hπ
  obtain ⟨E, hE1, hE2⟩ : ∃ E : Limits.pullback (Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom (Λ S₀).subtype)) f' ≅ Limits.pullback f (Spec.map (CommRingCat.ofHom j)),
      E.hom ≫ Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j)) = Limits.pullback.fst _ _ ∧
      E.hom ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ π = Limits.pullback.snd _ _ :=
    ⟨IsPullback.isoIsPullback _ _ (IsPullback.of_hasPullback _ _) H1.flip,
      IsPullback.isoIsPullback_hom_fst _ _ _ _, IsPullback.isoIsPullback_hom_snd _ _ _ _⟩
  obtain ⟨α', hP'⟩ := wc_fet_torsor_base_change p E.hom m α hP

  obtain ⟨T₁, hT₁, Pl, pl, αl, hPl, c₁, hc₁f, hc₁s, jP₁, hjP₁⟩ : ∃ (T₁ : Finset A) (hT₁ : S₀ ≤ T₁)
      (Pl : Scheme.{u}) (pl : Pl ⟶ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁)) (FractionRing ↥(Λ (T₁))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT₁)))) f') (αl : ZMod m → (Pl ⟶ Pl)),
      wcFetTorsor pl m αl ∧ ∃ c₁ : Limits.pullback f (Spec.map (CommRingCat.ofHom j)) ⟶ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁)) (FractionRing ↥(Λ (T₁))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT₁)))) f',
        c₁ ≫ Limits.pullback.fst _ _ = Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j)) ≫ Spec.map (CommRingCat.ofHom (φ (T₁))) ∧
        c₁ ≫ Limits.pullback.snd _ _ = Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ π ∧
        ∃ jP₁ : P ⟶ Pl, IsPullback jP₁ p pl c₁ := by
    obtain ⟨l, Pl, pl, αl, j₀, hPl, hj₀⟩ := wc_fet_torsor_cofiltered_limit_descent
      (Spec (.of ↥(Λ S₀))) X' (Spec (.of ↥(Λ S₀))) f' (𝟙 _) (Finset A)ᵒᵖ F (Spec (.of L))
      (Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom (Λ S₀).subtype))
      (fun l => Spec.map (CommRingCat.ofHom (φ (S₀ ∪ l.unop))))
      (fun l => by rw [Category.comp_id]; exact SD5 S₀ (S₀ ∪ l.unop) Finset.subset_union_left)
      (fun l => (inferInstance : IsAffine (Spec (.of (FractionRing ↥(Λ (S₀ ∪ l.unop)))))))
      (fun t => SD1 _ _ _) (fun Z zz hzz => hlimEU S₀ Z zz hzz) m hm
      (Limits.pullback p E.hom) (Limits.pullback.snd p E.hom) α' hP'
    have w0 : (Limits.pullback.fst (Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom (Λ S₀).subtype)) f' ≫ Spec.map (CommRingCat.ofHom (φ (S₀ ∪ l.unop)))) ≫ (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (S₀ ∪ l.unop)) (FractionRing ↥(Λ (S₀ ∪ l.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ (Finset.subset_union_left : S₀ ⊆ S₀ ∪ l.unop))))) =
        Limits.pullback.snd (Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom (Λ S₀).subtype)) f' ≫ f' := by
      rw [Category.assoc, SD5 S₀ (S₀ ∪ l.unop) Finset.subset_union_left]
      exact Limits.pullback.condition
    have hj₀' : IsPullback j₀ (Limits.pullback.snd p E.hom)
        (pl : Pl ⟶ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (S₀ ∪ l.unop)) (FractionRing ↥(Λ (S₀ ∪ l.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ (Finset.subset_union_left : S₀ ⊆ S₀ ∪ l.unop))))) f') (Limits.pullback.lift _ _ w0) := hj₀
    have w1 : (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j)) ≫ Spec.map (CommRingCat.ofHom (φ (S₀ ∪ l.unop)))) ≫ (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (S₀ ∪ l.unop)) (FractionRing ↥(Λ (S₀ ∪ l.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ (Finset.subset_union_left : S₀ ⊆ S₀ ∪ l.unop))))) = (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ π) ≫ f' := by
      rw [Category.assoc, SD5 S₀ (S₀ ∪ l.unop) Finset.subset_union_left, Category.assoc, hπ.w,
        Limits.pullback.condition_assoc]
    refine ⟨S₀ ∪ l.unop, Finset.subset_union_left, Pl, pl, αl, hPl, Limits.pullback.lift _ _ w1,
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _, ?_⟩
    haveI : IsIso (Limits.pullback.fst p E.hom) :=
      (IsPullback.of_hasPullback p E.hom).isIso_fst_of_isIso
    refine ⟨inv (Limits.pullback.fst p E.hom) ≫ j₀, IsPullback.of_iso hj₀'
      (asIso (Limits.pullback.fst p E.hom)) (Iso.refl _) E (Iso.refl _) ?_ ?_ ?_ ?_⟩
    · simp
    · rw [asIso_hom]; exact Limits.pullback.condition.symm
    · exact (Category.comp_id _).trans (Category.id_comp _).symm
    · refine (Category.comp_id _).trans ?_
      refine Limits.pullback.hom_ext ?_ ?_
      · refine (Limits.pullback.lift_fst _ _ _).trans ?_
        refine Eq.trans ?_ (Category.assoc _ _ _).symm
        refine Eq.trans ?_ (congrArg (E.hom ≫ ·) (Limits.pullback.lift_fst _ _ w1).symm)
        rw [← hE1, Category.assoc]
        rfl
      · refine (Limits.pullback.lift_snd _ _ _).trans ?_
        refine Eq.trans ?_ (Category.assoc _ _ _).symm
        refine Eq.trans ?_ (congrArg (E.hom ≫ ·) (Limits.pullback.lift_snd _ _ w1).symm)
        exact hE2.symm

  obtain ⟨σL, hσLf, hσLs⟩ : ∃ σL : Spec (.of L) ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom j)),
      σL ≫ Limits.pullback.fst _ _ = Spec.map (CommRingCat.ofHom j) ≫ σ ∧ σL ≫ Limits.pullback.snd _ _ = 𝟙 _ :=
    ⟨Limits.pullback.lift _ _ (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨v, hv⟩ : σL (IsLocalRing.closedPoint L) ∈ Set.range p := by
    rw [hP.surj]; exact Set.mem_univ _
  haveI := hP.etale
  obtain ⟨t, ht, -⟩ := wc_etale_lift_alg_closed_point L p σL v hv

  obtain ⟨ρ₁, hρf, hρs⟩ : ∃ ρ₁ : Spec (.of (FractionRing ↥(Λ T₁))) ⟶ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁)) (FractionRing ↥(Λ (T₁))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT₁)))) f',
      ρ₁ ≫ Limits.pullback.fst _ _ = 𝟙 _ ∧ ρ₁ ≫ Limits.pullback.snd _ _ = (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁)) (FractionRing ↥(Λ (T₁))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT₁)))) ≫ σ' :=
    ⟨Limits.pullback.lift _ _ (by rw [Category.assoc, hσ', Category.comp_id, Category.id_comp]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hσc : σL ≫ c₁ = Spec.map (CommRingCat.ofHom (φ (T₁))) ≫ ρ₁ := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hc₁f, hρf, reassoc_of% hσLs, Category.id_comp, Category.comp_id]
    · simp only [Category.assoc, hc₁s, hρs, reassoc_of% hσLf, hσπ, reassoc_of% (SD5 S₀ T₁ hT₁)]
  have w2 : (t ≫ jP₁) ≫ pl = Spec.map (CommRingCat.ofHom (φ (T₁))) ≫ ρ₁ := by
    rw [Category.assoc, hjP₁.w, ← Category.assoc, ht, hσc]
  obtain ⟨a, -, ha2⟩ : ∃ a : Spec (.of L) ⟶ Limits.pullback pl ρ₁,
      a ≫ Limits.pullback.fst _ _ = t ≫ jP₁ ∧ a ≫ Limits.pullback.snd _ _ = Spec.map (CommRingCat.ofHom (φ (T₁))) :=
    ⟨Limits.pullback.lift _ _ w2, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  haveI := hPl.etale
  haveI : LocallyOfFinitePresentation (Limits.pullback.snd pl ρ₁) := inferInstance

  let D1 : (Finset A)ᵒᵖ ⥤ Scheme.{u} := (G T₁).op ⋙ Scheme.Spec
  let tt : D1 ⟶ (Functor.const (Finset A)ᵒᵖ).obj (Spec (.of (FractionRing ↥(Λ T₁)))) :=
    { app := fun V => Spec.map (CommRingCat.ofHom (τ (T₁) (T₁ ∪ V.unop) Finset.subset_union_left))
      naturality := fun V V' hV =>
        (SD3 T₁ (T₁ ∪ V'.unop) (T₁ ∪ V.unop) Finset.subset_union_left
          (Finset.union_subset_union_right (leOfHom hV.unop))).trans (Category.comp_id _).symm }
  have hcond : (Scheme.Spec.mapCone (cc T₁).op).π ≫ tt =
      (Functor.const (Finset A)ᵒᵖ).map (a ≫ Limits.pullback.snd pl ρ₁) := by
    ext V
    rw [NatTrans.comp_app, Functor.const_map_app, ha2]
    exact SD1 _ _ _
  haveI : ∀ {i i' : (Finset A)ᵒᵖ} (g : i ⟶ i'), IsAffineHom (D1.map g) := fun g => by
    change IsAffineHom (Spec.map _); infer_instance
  haveI : ∀ i, CompactSpace ↥(D1.obj i) := fun i => by
    change CompactSpace ↥(Spec _); infer_instance
  haveI : ∀ i, QuasiSeparatedSpace ↥(D1.obj i) := fun i => by
    change QuasiSeparatedSpace ↥(Spec _); infer_instance
  obtain ⟨i, g, -, hg⟩ := Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation D1 tt
    (Limits.pullback.snd pl ρ₁) (Scheme.Spec.mapCone (cc T₁).op) (hlim _) a hcond
  have h₁ : T₁ ≤ T₁ ∪ i.unop := Finset.subset_union_left
  have hT : S₀ ≤ T₁ ∪ i.unop := hT₁.trans h₁
  have hg' : g ≫ Limits.pullback.snd pl ρ₁ = Spec.map (CommRingCat.ofHom (τ (T₁) (T₁ ∪ i.unop) h₁)) := hg

  have wd : (Limits.pullback.snd f' (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁ ∪ i.unop)) (FractionRing ↥(Λ (T₁ ∪ i.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) ≫ Spec.map (CommRingCat.ofHom (τ (T₁) (T₁ ∪ i.unop) h₁))) ≫ (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁)) (FractionRing ↥(Λ (T₁))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT₁)))) =
      Limits.pullback.fst f' (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁ ∪ i.unop)) (FractionRing ↥(Λ (T₁ ∪ i.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) ≫ f' := by
    rw [Category.assoc, SD4 S₀ T₁ (T₁ ∪ i.unop) hT₁ h₁]
    exact Limits.pullback.condition.symm
  obtain ⟨d, hdf, hds⟩ : ∃ d : Limits.pullback f' (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁ ∪ i.unop)) (FractionRing ↥(Λ (T₁ ∪ i.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) ⟶ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁)) (FractionRing ↥(Λ (T₁))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT₁)))) f',
      d ≫ Limits.pullback.fst _ _ = Limits.pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom (τ (T₁) (T₁ ∪ i.unop) h₁)) ∧
      d ≫ Limits.pullback.snd _ _ = Limits.pullback.fst _ _ :=
    ⟨Limits.pullback.lift _ _ wd, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have wm : (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ π) ≫ f' = (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j)) ≫ Spec.map (CommRingCat.ofHom (φ (T₁ ∪ i.unop)))) ≫ (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁ ∪ i.unop)) (FractionRing ↥(Λ (T₁ ∪ i.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) := by
    rw [Category.assoc, hπ.w, Limits.pullback.condition_assoc, Category.assoc, SD5 S₀ _ hT]
  obtain ⟨mT, hmTf, hmTs⟩ : ∃ mT : Limits.pullback f (Spec.map (CommRingCat.ofHom j)) ⟶ Limits.pullback f' (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁ ∪ i.unop)) (FractionRing ↥(Λ (T₁ ∪ i.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))),
      mT ≫ Limits.pullback.fst _ _ = Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ π ∧
      mT ≫ Limits.pullback.snd _ _ = Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j)) ≫ Spec.map (CommRingCat.ofHom (φ (T₁ ∪ i.unop))) :=
    ⟨Limits.pullback.lift _ _ wm, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hmd : mT ≫ d = c₁ := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hdf, reassoc_of% hmTs, SD1, hc₁f]
    · simp only [Category.assoc, hds, hmTf, hc₁s]
  obtain ⟨αT, hPT⟩ := wc_fet_torsor_base_change pl d m αl hPl
  obtain ⟨jP, hjPf, hjPs⟩ : ∃ jP : P ⟶ Limits.pullback pl d,
      jP ≫ Limits.pullback.fst _ _ = jP₁ ∧ jP ≫ Limits.pullback.snd _ _ = p ≫ mT :=
    ⟨Limits.pullback.lift _ _ (by rw [hjP₁.w, Category.assoc, hmd]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hjP : IsPullback jP p (Limits.pullback.snd pl d) mT :=
    IsPullback.of_right (by rw [hjPf, hmd]; exact hjP₁) hjPs (IsPullback.of_hasPullback pl d)

  have hτρ : Spec.map (CommRingCat.ofHom (τ (T₁) (T₁ ∪ i.unop) h₁)) ≫ ρ₁ = Limits.pullback.lift ((Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁ ∪ i.unop)) (FractionRing ↥(Λ (T₁ ∪ i.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) ≫ σ') (𝟙 _)
        (by rw [Category.assoc, hσ', Category.comp_id, Category.id_comp]) ≫ d := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hρf, hdf, Limits.pullback.lift_snd_assoc, Category.comp_id,
        Category.id_comp]
    · simp only [Category.assoc, hρs, hds, Limits.pullback.lift_fst,
        reassoc_of% (SD4 S₀ T₁ (T₁ ∪ i.unop) hT₁ h₁)]
  have wr : (g ≫ Limits.pullback.fst pl ρ₁) ≫ pl = Limits.pullback.lift ((Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ (T₁ ∪ i.unop)) (FractionRing ↥(Λ (T₁ ∪ i.unop))))) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) ≫ σ') (𝟙 _)
        (by rw [Category.assoc, hσ', Category.comp_id, Category.id_comp]) ≫ d := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hg', hτρ]
  refine ⟨T₁ ∪ i.unop, hT, φ (T₁ ∪ i.unop), Limits.pullback pl d, Limits.pullback.snd pl d, αT, jP, mT,
    RingHom.ext fun x => hφx _ x, hPT, hjP, hmTf, hmTs,
    Limits.pullback.lift _ _ wr, Limits.pullback.lift_snd _ _ _⟩

theorem wc_fnr_base_change_qcqs_geom_connected : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (φ : R →+* R') (V : Scheme.{u}) [CompactSpace V] [QuasiSeparatedSpace V] (g : V ⟶ Spec (.of R)), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of R)), ConnectedSpace ↥(Limits.pullback g z)) → CompactSpace ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom φ))) ∧ QuasiSeparatedSpace ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom φ))) ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of R')), ConnectedSpace ↥(Limits.pullback (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom φ))) z) :=
by
  intro R R' _ _ φ V _ _ g hconn
  haveI : QuasiCompact g := quasiCompact_of_compactSpace g
  haveI : QuasiSeparated g := QuasiSeparated.of_quasiSeparatedSpace g
  haveI : QuasiCompact (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom φ))) := inferInstance
  haveI : QuasiSeparated (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom φ))) := inferInstance
  refine ⟨?_, ?_, ?_⟩
  · exact QuasiCompact.compactSpace_of_compactSpace
      (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom φ)))
  · exact quasiSeparatedSpace_of_quasiSeparated
      (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom φ)))
  · intro Ω _ _ z
    have e := Limits.pullbackLeftPullbackSndIso g (Spec.map (CommRingCat.ofHom φ)) z
    haveI := hconn Ω (z ≫ Spec.map (CommRingCat.ofHom φ))
    exact (Scheme.homeoOfIso e).connectedSpace_iff.mpr inferInstance

theorem wc_fnr_torsor_pullback_paste : ∀ {P P₁ B B₁ B₂ C₃ Y₃ X : Scheme.{u}} (p : P ⟶ B) (p₁ : P₁ ⟶ B₁) (jP : P ⟶ P₁) (m₁ : B ⟶ B₁), IsPullback jP p p₁ m₁ → ∀ (c : B₂ ⟶ B₁) (n : B ⟶ B₂), n ≫ c = m₁ → ∀ (q₃ : Y₃ ⟶ C₃) (g : B₂ ⟶ C₃) (i₃ : Limits.pullback p₁ c ⟶ Y₃), IsPullback i₃ (Limits.pullback.snd p₁ c) q₃ g → ∀ (k : B ⟶ X) (ρ : X ⟶ C₃), k ≫ ρ = n ≫ g → ∃ i : P ⟶ Limits.pullback q₃ ρ, IsPullback i p (Limits.pullback.snd q₃ ρ) k :=
by
  intro P P₁ B B₁ B₂ C₃ Y₃ X p p₁ jP m₁ hjP c n hnc q₃ g i₃ hi₃ k ρ hk
  subst hnc
  have w₁ : jP ≫ p₁ = (p ≫ n) ≫ c := by
    rw [hjP.w, Category.assoc]
  have hu1 : Limits.pullback.lift jP (p ≫ n) w₁ ≫ Limits.pullback.fst p₁ c = jP :=
    Limits.pullback.lift_fst _ _ _
  have hu2 : Limits.pullback.lift jP (p ≫ n) w₁ ≫ Limits.pullback.snd p₁ c = p ≫ n :=
    Limits.pullback.lift_snd _ _ _
  have hout : IsPullback (Limits.pullback.lift jP (p ≫ n) w₁ ≫ Limits.pullback.fst p₁ c) p p₁
      (n ≫ c) := by
    rw [hu1]; exact hjP
  have hL : IsPullback (Limits.pullback.lift jP (p ≫ n) w₁) p (Limits.pullback.snd p₁ c) n :=
    IsPullback.of_right hout hu2 (IsPullback.of_hasPullback p₁ c)
  have h3 := hL.paste_horiz hi₃
  have w₂ : (Limits.pullback.lift jP (p ≫ n) w₁ ≫ i₃) ≫ q₃ = (p ≫ k) ≫ ρ := by
    rw [h3.w, Category.assoc, hk]
  have hi1 : Limits.pullback.lift _ _ w₂ ≫ Limits.pullback.fst q₃ ρ =
      Limits.pullback.lift jP (p ≫ n) w₁ ≫ i₃ := Limits.pullback.lift_fst _ _ _
  have hi2 : Limits.pullback.lift _ _ w₂ ≫ Limits.pullback.snd q₃ ρ = p ≫ k :=
    Limits.pullback.lift_snd _ _ _
  have hout2 : IsPullback (Limits.pullback.lift _ _ w₂ ≫ Limits.pullback.fst q₃ ρ) p q₃
      (k ≫ ρ) := by
    rw [hi1, hk]; exact h3
  exact ⟨_, IsPullback.of_right hout2 hi2 (IsPullback.of_hasPullback q₃ ρ)⟩

theorem wc_fet_ext_noetherian_reduction : (∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [IsNoetherianRing A₀] (κ : K →+* A₀) (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (σ : Spec (.of A₀) ⟶ X) (hσ : σ ≫ f = 𝟙 _), (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A₀)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → (∃ r : Spec (.of (FractionRing A₀)) ⟶ P, r ≫ p = Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))) ≫ σ) (𝟙 _) (by rw [Category.assoc, hσ, Category.comp_id, Category.id_comp])) → ∃ (Y : Scheme.{u}) (q : Y ⟶ X) (β : ZMod ℓ → (Y ⟶ Y)) (i : P ⟶ Y), wcFetTorsor q ℓ β ∧ IsPullback i p q (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) → ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (κ : K →+* A) (L : Type u) [Field L] [IsAlgClosed L] (j : A →+* L), Function.Injective j → (∀ y : L, ∃ a₁ b₁ : A, j b₁ ≠ 0 ∧ y * j b₁ = j a₁) → ∀ (X : Scheme.{u}) [IsAffine X] (f : X ⟶ Spec (.of A)) [Smooth f] (σ : Spec (.of A) ⟶ X), σ ≫ f = 𝟙 _ → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), ConnectedSpace ↥(Limits.pullback f z)) → ∀ (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom j))) (α : ZMod ℓ → (P ⟶ P)), wcFetTorsor p ℓ α → ∃ (Y : Scheme.{u}) (q : Y ⟶ X) (β : ZMod ℓ → (Y ⟶ Y)) (i : P ⟶ Y), wcFetTorsor q ℓ β ∧ IsPullback i p q (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j))) :=
by
  intro N K _ _ ℓ hℓ hℓK A _ _ _ κ L _ _ j hj hfrac X _ f _ σ hσ hconn P p α hP
  classical
  obtain ⟨Λ, hΛ, hS, hκ, hnoeth, hic⟩ := wc_fnr_normal_noetherian_exhaustion K A κ
  obtain ⟨S₀, X', f', σ', π, hX'aff, hf'sm, hσ', hπ, hσπ⟩ :=
    wc_fnr_smooth_section_descend A Λ hΛ hS X f σ hσ
  haveI := hX'aff
  haveI := hf'sm
  haveI := hnoeth S₀
  obtain ⟨U₀, hcpt, hqs, hσU, hUconn, hUcomp⟩ :=
    wc_fnr_noetherian_section_component_open ↥(Λ S₀) X' f' σ' hσ'
  haveI := hcpt
  haveI := hqs
  obtain ⟨πU, hπUf, hπU⟩ := wc_fnr_factor_through_component_open A ↥(Λ S₀) (Λ S₀).subtype X X'
    f f' σ σ' hσ hσ' π hπ hσπ hconn U₀ hUcomp
  have hσr : Set.range σ' ⊆ Set.range U₀.ι := by rw [Scheme.Opens.range_ι]; exact hσU
  obtain ⟨σU, hσUf⟩ : ∃ σU, σU ≫ U₀.ι = σ' := ⟨_, IsOpenImmersion.lift_fac U₀.ι σ' hσr⟩
  have hσUg : σU ≫ (U₀.ι ≫ f') = 𝟙 _ := by rw [← Category.assoc, hσUf, hσ']
  obtain ⟨T, hT, φ, PT, pT, αT, jP, mT, hφ, hPT, hjP, hm1, hm2, r₅, hr₅⟩ :=
    wc_fnr_torsor_point_descend A Λ hΛ hS L j hj hfrac S₀ X' f' σ' hσ' X f σ π hσ hπ hσπ ℓ
      hℓ.ne_zero P p α hP
  haveI : IsNoetherianRing ↥(Λ T) := hnoeth T
  haveI : IsIntegrallyClosed ↥(Λ T) := hic T
  haveI : Smooth (U₀.ι ≫ f') := inferInstance
  haveI : Smooth (Limits.pullback.snd (U₀.ι ≫ f')
      (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT))))) := inferInstance

  have hσTw : (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT))) ≫ σU) ≫ (U₀.ι ≫ f') =
      𝟙 _ ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT))) := by
    rw [Category.assoc, hσUg, Category.comp_id, Category.id_comp]
  obtain ⟨σT, hσT1, hσT2⟩ : ∃ σT : Spec (.of ↥(Λ T)) ⟶ Limits.pullback (U₀.ι ≫ f')
        (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))),
      σT ≫ Limits.pullback.fst (U₀.ι ≫ f')
          (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) =
        Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT))) ≫ σU ∧
      σT ≫ Limits.pullback.snd (U₀.ι ≫ f')
          (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) = 𝟙 _ :=
    ⟨Limits.pullback.lift _ _ hσTw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hσT1' : σT ≫ Limits.pullback.fst (U₀.ι ≫ f')
      (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) ≫ U₀.ι =
      Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT))) ≫ σ' := by
    rw [← Category.assoc, hσT1, Category.assoc, hσUf]
  obtain ⟨hVc, hVq, hVconn⟩ := wc_fnr_base_change_qcqs_geom_connected ↥(Λ S₀) ↥(Λ T)
    (Subring.inclusion (hΛ hT)) _ (U₀.ι ≫ f') hUconn
  haveI := hVc
  haveI := hVq

  have hrw : (Limits.pullback.fst (Limits.pullback.snd (U₀.ι ≫ f')
        (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T))))) ≫
      Limits.pullback.fst (U₀.ι ≫ f') (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) ≫
        U₀.ι) ≫ f' =
      Limits.pullback.snd (Limits.pullback.snd (U₀.ι ≫ f')
        (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T))))) ≫
      (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) := by
    simp only [Category.assoc]
    rw [Limits.pullback.condition, Limits.pullback.condition_assoc]
  obtain ⟨rr, hrr1, hrr2⟩ : ∃ rr : Limits.pullback (Limits.pullback.snd (U₀.ι ≫ f')
        (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T))))) ⟶
      Limits.pullback f' (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))),
      rr ≫ Limits.pullback.fst _ _ = Limits.pullback.fst (Limits.pullback.snd (U₀.ι ≫ f')
        (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T))))) ≫
      Limits.pullback.fst (U₀.ι ≫ f') (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) ≫
        U₀.ι ∧
      rr ≫ Limits.pullback.snd _ _ = Limits.pullback.snd (Limits.pullback.snd (U₀.ι ≫ f')
        (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T))))) :=
    ⟨Limits.pullback.lift _ _ hrw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨αW, hW⟩ := wc_fet_torsor_base_change pT rr ℓ αT hPT

  have hτw : (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) ≫ σT) ≫
      Limits.pullback.snd (U₀.ι ≫ f') (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) =
      𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) := by
    rw [Category.assoc, hσT2, Category.comp_id, Category.id_comp]
  have hτr : Limits.pullback.lift _ _ hτw ≫ rr = Limits.pullback.lift
      ((Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) ≫ σ') (𝟙 _)
      (by rw [Category.assoc, hσ', Category.comp_id, Category.id_comp]) := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hrr1, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc,
        Category.assoc, hσT1', Category.assoc]
    · rw [Category.assoc, hrr2, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
  have hr5' : r₅ ≫ pT = Limits.pullback.lift _ _ hτw ≫ rr := by rw [hr₅, hτr]
  obtain ⟨Y, qW, β, iW, hY, hiW⟩ := N K ℓ hℓ hℓK ↥(Λ T) (κ.codRestrict (Λ T) (hκ T)) _
    (Limits.pullback.snd (U₀.ι ≫ f') (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))))
    σT hσT2 hVconn (Limits.pullback pT rr) (Limits.pullback.snd pT rr) αW hW
    ⟨Limits.pullback.lift r₅ _ hr5', Limits.pullback.lift_snd _ _ _⟩

  have hsubc : (Λ T).subtype.comp (Subring.inclusion (hΛ hT)) = (Λ S₀).subtype :=
    RingHom.ext fun _ => rfl
  have hsub : Spec.map (CommRingCat.ofHom (Λ T).subtype) ≫
      Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT))) =
      Spec.map (CommRingCat.ofHom (Λ S₀).subtype) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hsubc]
  have hρw : πU ≫ (U₀.ι ≫ f') = (f ≫ Spec.map (CommRingCat.ofHom (Λ T).subtype)) ≫
      Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT))) := by
    rw [← Category.assoc, hπUf, hπ.w, Category.assoc, hsub]
  obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : X ⟶ Limits.pullback (U₀.ι ≫ f')
        (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))),
      ρ ≫ Limits.pullback.fst _ _ = πU ∧
      ρ ≫ Limits.pullback.snd _ _ = f ≫ Spec.map (CommRingCat.ofHom (Λ T).subtype) :=
    ⟨Limits.pullback.lift _ _ hρw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have hjφ : Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom (Λ T).subtype) =
      Spec.map (CommRingCat.ofHom φ) ≫
        Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) := by
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hφ]
  have hnw : (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ ρ) ≫
      Limits.pullback.snd (U₀.ι ≫ f') (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))) =
      (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j)) ≫ Spec.map (CommRingCat.ofHom φ)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T)))) := by
    simp only [Category.assoc]
    rw [hρ2, Limits.pullback.condition_assoc, hjφ]
  obtain ⟨n, hn1, hn2⟩ : ∃ n : Limits.pullback f (Spec.map (CommRingCat.ofHom j)) ⟶
      Limits.pullback (Limits.pullback.snd (U₀.ι ≫ f')
        (Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ hT)))))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥(Λ T) (FractionRing ↥(Λ T))))),
      n ≫ Limits.pullback.fst _ _ = Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j)) ≫ ρ ∧
      n ≫ Limits.pullback.snd _ _ =
        Limits.pullback.snd f (Spec.map (CommRingCat.ofHom j)) ≫ Spec.map (CommRingCat.ofHom φ) :=
    ⟨Limits.pullback.lift _ _ hnw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hnr : n ≫ rr = mT := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hrr1, reassoc_of% hn1, reassoc_of% hρ1, hπUf, hm1]
    · rw [Category.assoc, hrr2, hn2, hm2]
  obtain ⟨i, hi⟩ := wc_fnr_torsor_pullback_paste p pT jP mT hjP rr n hnr qW
    (Limits.pullback.fst _ _) iW hiW (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom j))) ρ
    hn1.symm
  obtain ⟨β', hβ'⟩ := wc_fet_torsor_base_change qW ρ ℓ β hY
  exact ⟨Limits.pullback qW ρ, Limits.pullback.snd qW ρ, β', i, hβ', hi⟩

theorem wc_fntame_normalization_generic_pullback : ∀ (A : Type u) [CommRing A] [IsDomain A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))) [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))))], IsIntegralHom p → IsPullback (Scheme.Hom.toNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))))) p (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))))) (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))) :=
by
  intro A _ _ X f P p _ _ hp
  open Limits TensorProduct in
  set_option backward.defeqAttrib.useBackward true in
  set_option backward.isDefEq.respectTransparency false in
  ·
    have s2 : ∀ {R R' S P : CommRingCat.{u}} (a : R ⟶ S) (b : R ⟶ R') (c : S ⟶ P) (d : R' ⟶ P),
        IsPushout a b c d → ∀ (M : Submonoid R), (letI : Algebra R R' := b.hom.toAlgebra;
          IsLocalization M R') → (letI : Algebra S P := c.hom.toAlgebra;
          IsLocalization (M.map a.hom) P) := by
      intro R R' S P a b c d h M hM
      letI : Algebra R S := a.hom.toAlgebra
      letI : Algebra R R' := b.hom.toAlgebra
      letI : Algebra S P := c.hom.toAlgebra
      letI : Algebra R' P := d.hom.toAlgebra
      letI : Algebra R P := (a ≫ c).hom.toAlgebra
      haveI : IsScalarTower R S P := .of_algebraMap_eq' rfl
      haveI : IsScalarTower R R' P := .of_algebraMap_eq' (congrArg CommRingCat.Hom.hom h.w)
      have h' : Algebra.IsPushout R R' S P := CommRingCat.isPushout_iff_isPushout.mp h.flip
      exact (Algebra.isLocalization_iff_isPushout M R' (T := S) (B := P)).mpr h'.symm

    have s3 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (M : Submonoid R)
        [IsLocalization M S], ∃ M' : Submonoid Γ(Spec (.of R), ⊤),
        letI : Algebra Γ(Spec (.of R), ⊤) Γ(Spec (.of S), ⊤) :=
          (Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom (algebraMap R S))) ⊤ ⊤ le_top).hom.toAlgebra;
        IsLocalization M' Γ(Spec (.of S), ⊤) := by
      intro R S _ _ _ M _
      let eR : Γ(Spec (.of R), ⊤) ≃+* R := (Scheme.ΓSpecIso (.of R)).commRingCatIsoToRingEquiv
      let eS : Γ(Spec (.of S), ⊤) ≃+* S := (Scheme.ΓSpecIso (.of S)).commRingCatIsoToRingEquiv
      refine ⟨M.map eR.symm, ?_⟩
      have h1 := IsLocalization.isLocalization_of_base_ringEquiv M S eR.symm
      letI i1 : Algebra Γ(Spec (.of R), ⊤) S :=
        ((algebraMap R S).comp eR.symm.symm.toRingHom).toAlgebra
      have h2 := (IsLocalization.isLocalization_iff_of_ringEquiv (M.map eR.symm) eS.symm).mp h1
      have hnat := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap R S))
      have hEq : (Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom (algebraMap R S))) ⊤ ⊤ le_top).hom =
          eS.symm.toRingHom.comp (algebraMap Γ(Spec (.of R), ⊤) S) := by
        ext x
        apply eS.injective
        simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, RingEquiv.apply_symm_apply]
        exact congrArg (fun φ => φ.hom x) hnat
      show @IsLocalization _ _ _ _ _ (RingHom.toAlgebra _)
      rw [hEq]
      exact h2

    have s4 : ∀ {X S Y : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S) [QuasiCompact f] [QuasiSeparated f]
        [Flat g], (∀ y : Y, ∃ (U : S.Opens) (V : Y.Opens) (_ : IsAffineOpen U) (_ : IsAffineOpen V)
          (hVU : V ≤ g ⁻¹ᵁ U), y ∈ V ∧ ∃ M : Submonoid Γ(S, U),
          letI : Algebra Γ(S, U) Γ(Y, V) := (g.appLE U V hVU).hom.toAlgebra;
          IsLocalization M Γ(Y, V)) → IsIso (Scheme.Hom.normalizationPullback f g) := by
      intro X S Y f g _ _ _ hloc
      apply IsZariskiLocalAtTarget.of_forall_exists_morphismRestrict (P := .isomorphisms _)
        fun x ↦ ?_
      obtain ⟨U, V, hU, hV, hVU, hxV, M, hM⟩ := hloc (pullback.snd f.fromNormalization g x)
      let W := pullback.snd (Scheme.Hom.fromNormalization f) g ⁻¹ᵁ V
      refine ⟨W, hxV, (isIso_morphismRestrict_iff_isIso_app _ (U := W) (hV.preimage _)).mpr ?_⟩
      have := isIso_pushoutSection_of_isQuasiSeparated_of_flat_right
        (.of_hasPullback f.fromNormalization g) hVU le_rfl (UY := W)
        (by simp_rw [W, ← Scheme.Hom.comp_preimage, pullback.condition, Scheme.Hom.comp_preimage,
          ← Scheme.Hom.preimage_inf, inf_eq_right.mpr hVU]) hU hV
        (hU.preimage f.fromNormalization).isCompact
        (hU.preimage f.fromNormalization).isQuasiSeparated
      rw [← @isIso_comp_left_iff _ _ _ _ _ _ _ this,
        ← isIso_comp_left_iff (pushout.congrHom f.fromNormalization.app_eq_appLE rfl).hom]
      algebraize [(f.app U).hom, (g.appLE U V hVU).hom, ((pullback.snd f g).app V).hom]
      have := isIso_pushoutSection_of_isQuasiSeparated_of_flat_right
        (.of_hasPullback f g) hVU le_rfl (UY := pullback.snd f g ⁻¹ᵁ V)
        (by simp_rw [← Scheme.Hom.comp_preimage, pullback.condition, Scheme.Hom.comp_preimage,
          ← Scheme.Hom.preimage_inf, inf_eq_right.mpr hVU]) hU hV (f.isCompact_preimage hU.isCompact)
        (f.isQuasiSeparated_preimage hU.isQuasiSeparated)
      let e₀ := (CommRingCat.isPushout_tensorProduct ..).flip.isoPushout ≪≫
        (pushout.congrHom f.app_eq_appLE rfl ≪≫ @asIso _ _ _ _ _ this :)
      let e : Γ(Y, V) ⊗[Γ(S, U)] Γ(X, f ⁻¹ᵁ U) ≃ₐ[Γ(Y, V)]
          Γ(pullback f g, pullback.snd f g ⁻¹ᵁ V) :=
        { toRingEquiv := e₀.commRingCatIsoToRingEquiv,
          commutes' r := by
            change (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ e₀.hom) r =
              (pullback.snd f g).app V r
            congr 2
            simp [e₀, pushout.inr_desc_assoc, Scheme.Hom.app_eq_appLE] }
      let ψ : Γ(Y, V) ⊗[Γ(S, U)] integralClosure Γ(S, U) Γ(X, f ⁻¹ᵁ U) →ₐ[Γ(Y, V)]
          integralClosure Γ(Y, V) Γ(pullback f g, pullback.snd f g ⁻¹ᵁ V) :=
        e.mapIntegralClosure.toAlgHom.comp (TensorProduct.toIntegralClosure _ _ _)
      have hψ : Function.Bijective ψ := e.mapIntegralClosure.bijective.comp
        (TensorProduct.toIntegralClosure_bijective_of_isLocalization M)
      let φ : pushout (f.fromNormalization.app U) (g.appLE U V hVU) ⟶
          Γ((pullback.snd f g).normalization, f.normalizationPullback g ⁻¹ᵁ W) :=
        pushout.map _ _
          (CommRingCat.ofHom (algebraMap Γ(S, U) (integralClosure Γ(S, U) Γ(X, f ⁻¹ᵁ U))))
          (g.appLE U V hVU) (f.normalizationObjIso hU).hom (𝟙 _) (𝟙 _)
          (by simp [Scheme.Hom.fromNormalization_app _ hU]) (by simp) ≫
        (CommRingCat.isPushout_tensorProduct ..).flip.isoPushout.inv ≫
        (RingEquiv.ofBijective ψ.toRingHom hψ).toCommRingCatIso.hom ≫
        ((pullback.snd f g).normalizationObjIso hV).inv ≫
        (pullback.snd f g).normalization.presheaf.map (eqToHom
          (by simp only [W, ← Scheme.Hom.comp_preimage, Scheme.Hom.normalizationPullback_snd])).op
      convert! show IsIso φ by dsimp only [φ]; infer_instance using 1
      ext1
      · dsimp [φ]
        simp only [Scheme.Hom.app_eq_appLE, colimit.ι_desc_assoc, span_left, PushoutCocone.mk_pt,
          PushoutCocone.mk_ι_app, Category.id_comp, Scheme.Hom.appLE_comp_appLE, eqToHom_op,
          Category.assoc, IsPushout.inl_isoPushout_inv_assoc]
        simp_rw [← Category.assoc, ← IsIso.comp_inv_eq]
        simp only [← Functor.map_inv, inv_eqToHom, Scheme.Hom.appLE_map, IsIso.Iso.inv_inv,
          Category.assoc]
        have : Mono (CommRingCat.ofHom (integralClosure Γ(Y, V)
            Γ(pullback f g, pullback.snd f g ⁻¹ᵁ V)).val.toRingHom) :=
          ConcreteCategory.mono_of_injective _ Subtype.val_injective
        rw [← cancel_mono (CommRingCat.ofHom (Subalgebra.val _).toRingHom)]
        simp only [Category.assoc, Scheme.Hom.normalizationObjIso_hom_val,
          Scheme.Hom.appLE_comp_appLE, Scheme.Hom.toNormalization_normalizationPullback_fst,
          ← CommRingCat.ofHom_comp]
        have H : pullback.snd f g ⁻¹ᵁ V ≤ pullback.fst f g ⁻¹ᵁ f ⁻¹ᵁ U := by
          rw [← Scheme.Hom.comp_preimage, pullback.condition, Scheme.Hom.comp_preimage]
          exact Scheme.Hom.preimage_mono _ hVU
        trans (f.normalizationObjIso hU).hom ≫ CommRingCat.ofHom
            (integralClosure Γ(S, U) Γ(X, f ⁻¹ᵁ U)).val.toRingHom ≫ (pullback.fst f g).appLE _ _ H
        · rw [reassoc_of% Scheme.Hom.normalizationObjIso_hom_val, Scheme.Hom.appLE_comp_appLE]
        · congr 1
          ext x
          change (pullback.fst f g).appLE _ _ H x = _
          trans (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom ≫ e₀.hom) x
          · congr 2; simp [e₀, pushout.inl_desc_assoc]
          · simp [ψ, TensorProduct.toIntegralClosure, e]; rfl
      · dsimp [φ]
        simp only [Scheme.Hom.app_eq_appLE, colimit.ι_desc_assoc, span_right, PushoutCocone.mk_pt,
          PushoutCocone.mk_ι_app, Category.id_comp, Scheme.Hom.appLE_comp_appLE,
          Scheme.Hom.normalizationPullback_snd, eqToHom_op, IsPushout.inr_isoPushout_inv_assoc]
        simp_rw [← Category.assoc, ← IsIso.comp_inv_eq]
        simp only [← Functor.map_inv, inv_eqToHom, Scheme.Hom.appLE_map, ← Scheme.Hom.app_eq_appLE,
          Scheme.Hom.fromNormalization_app _ hV, IsIso.Iso.inv_inv, Category.assoc, Iso.inv_hom_id,
          Category.comp_id]
        exact congr(CommRingCat.ofHom $(ψ.comp_algebraMap.symm))

    haveI : Epi (CommRingCat.ofHom (algebraMap A (FractionRing A))) :=
      IsLocalization.epi (nonZeroDivisors A) _
    haveI : Mono (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))) :=
      Functor.map_mono Scheme.Spec (CommRingCat.ofHom (algebraMap A (FractionRing A))).op
    haveI hflatη : Flat (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.flat_algebraMap_iff.mpr
        (IsLocalization.flat (FractionRing A) (nonZeroDivisors A)))
    haveI : Flat (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))) :=
      MorphismProperty.of_isPullback (P := @Flat)
        (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))).flip
        hflatη
    haveI : IsAffineHom (pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))).flip
        inferInstance

    let Xη : Scheme.{u} := Limits.pullback f (Spec.map (CommRingCat.ofHom
      (algebraMap A (FractionRing A))))
    let πη : Xη ⟶ X := Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
      (algebraMap A (FractionRing A))))
    have hloc : ∀ y : Xη, ∃ (U : X.Opens) (V : Xη.Opens) (_ : IsAffineOpen U) (_ : IsAffineOpen V)
          (hVU : V ≤ πη ⁻¹ᵁ U), y ∈ V ∧ ∃ M : Submonoid Γ(X, U),
          letI : Algebra Γ(X, U) Γ(Xη, V) := (πη.appLE U V hVU).hom.toAlgebra;
          IsLocalization M Γ(Xη, V) := by
      intro y
      obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
        (Set.mem_univ (πη y)) isOpen_univ
      refine ⟨U, πη ⁻¹ᵁ U, hU, hU.preimage _, le_rfl, hyU, ?_⟩
      obtain ⟨M₀, hM₀⟩ := s3 A (FractionRing A) (nonZeroDivisors A)
      exact ⟨_, s2 _ _ _ _ ((isIso_pushoutSection_iff (IsPullback.of_hasPullback f
          (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))))
        (US := ⊤) (UT := ⊤) (UX := U) (UY := pullback.fst f (Spec.map (CommRingCat.ofHom
          (algebraMap A (FractionRing A)))) ⁻¹ᵁ U)
        (by simp) (by simp) (by simp)).mp
        (isIso_pushoutSection_of_isAffineOpen _ _ _ _ (isAffineOpen_top _) (isAffineOpen_top _) hU))
        M₀ hM₀⟩

    have h₀ : IsPullback (𝟙 P) p (p ≫ pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A (FractionRing A))))) (pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A (FractionRing A))))) :=
      (IsPullback.of_vert_isIso_mono ⟨by simp⟩).flip
    have he₁ := h₀.isoPullback_hom_fst
    have he₂ := h₀.isoPullback_hom_snd
    have hq : pullback.snd (p ≫ pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A (FractionRing A))))) (pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A (FractionRing A))))) = h₀.isoPullback.inv ≫ p := by
      calc _ = h₀.isoPullback.inv ≫ h₀.isoPullback.hom ≫ Limits.pullback.snd
            (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom
              (algebraMap A (FractionRing A))))) (Limits.pullback.fst f (Spec.map
              (CommRingCat.ofHom (algebraMap A (FractionRing A))))) :=
            (Iso.inv_hom_id_assoc _ _).symm
        _ = _ := by rw [he₂]
    haveI : IsIntegralHom (pullback.snd (p ≫ pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A (FractionRing A))))) (pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A (FractionRing A)))))) := by
      rw [hq]; infer_instance
    haveI := s4 (p ≫ pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A (FractionRing A))))) (pullback.fst f (Spec.map (CommRingCat.ofHom
        (algebraMap A (FractionRing A))))) hloc
    refine IsPullback.of_iso_pullback ⟨by simp⟩ (asIso (h₀.isoPullback.hom ≫
      Scheme.Hom.toNormalization (Limits.pullback.snd (p ≫ Limits.pullback.fst f (Spec.map
        (CommRingCat.ofHom (algebraMap A (FractionRing A))))) (Limits.pullback.fst f (Spec.map
        (CommRingCat.ofHom (algebraMap A (FractionRing A)))))) ≫
      Scheme.Hom.normalizationPullback (p ≫ Limits.pullback.fst f (Spec.map
        (CommRingCat.ofHom (algebraMap A (FractionRing A))))) (Limits.pullback.fst f (Spec.map
        (CommRingCat.ofHom (algebraMap A (FractionRing A))))))) ?_ ?_
    · rw [asIso_hom, Category.assoc, Category.assoc,
        Scheme.Hom.toNormalization_normalizationPullback_fst, ← Category.assoc, he₁,
        Category.id_comp]
    · rw [asIso_hom, Category.assoc, Category.assoc, Scheme.Hom.normalizationPullback_snd,
        Scheme.Hom.toNormalization_fromNormalization, he₂]

theorem wc_fnf_fromNormalization_finite_of_local : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) [QuasiCompact g] [QuasiSeparated g], (∀ y : Y, ∃ W : Y.Opens, IsAffineOpen W ∧ y ∈ W ∧ (letI : Algebra Γ(Y, W) Γ(X, g ⁻¹ᵁ W) := (Scheme.Hom.app g W).hom.toAlgebra; Module.Finite Γ(Y, W) (integralClosure Γ(Y, W) Γ(X, g ⁻¹ᵁ W)))) → IsFinite (Scheme.Hom.fromNormalization g) :=
by
  intro X Y g _ _ H
  rw [IsFinite.iff_isIntegralHom_and_locallyOfFiniteType]
  refine ⟨inferInstance, ?_⟩
  choose W hW hyW hfin using H
  have hsup : iSup W = ⊤ :=
    eq_top_iff.mpr fun y _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hyW y⟩
  have hV : iSup (fun y => Scheme.Hom.fromNormalization g ⁻¹ᵁ W y) = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup, hsup, Scheme.Hom.preimage_top]
  haveI : IsZariskiLocalAtSource @LocallyOfFiniteType :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  refine (IsZariskiLocalAtSource.iff_of_iSup_eq_top (P := @LocallyOfFiniteType)
    (fun y => Scheme.Hom.fromNormalization g ⁻¹ᵁ W y) hV).mpr ?_
  intro y
  let U : Y.affineOpens := ⟨W y, hW y⟩
  haveI : IsOpenImmersion ((Scheme.Hom.normalizationOpenCover g).f U) :=
    (Scheme.Hom.normalizationOpenCover g).map_prop U
  have e : Scheme.Hom.fromNormalization g ⁻¹ᵁ W y =
      ((Scheme.Hom.normalizationOpenCover g).f U).opensRange :=
    Scheme.Hom.fromNormalization_preimage g U
  have hS : LocallyOfFiniteType
      (Spec.map ((Scheme.Hom.normalizationDiagramMap g).app (Opposite.op (W y)))) := by
    letI : Algebra Γ(Y, W y) Γ(X, g ⁻¹ᵁ W y) := (Scheme.Hom.app g (W y)).hom.toAlgebra
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr
      ((RingHom.finite_algebraMap.mpr (hfin y)).finiteType :
        RingHom.FiniteType ((Scheme.Hom.normalizationDiagramMap g).app (Opposite.op (W y))).hom)
  have key : (Scheme.Hom.fromNormalization g ⁻¹ᵁ W y).ι ≫ Scheme.Hom.fromNormalization g =
      ((Scheme.Hom.normalization g).isoOfEq e).hom ≫
        ((Scheme.Hom.normalizationOpenCover g).f U).isoOpensRange.inv ≫
        ((Scheme.Hom.normalizationOpenCover g).f U ≫ Scheme.Hom.fromNormalization g) := by
    rw [← Category.assoc, ← Category.assoc, Category.assoc ((Scheme.Hom.normalization g).isoOfEq e).hom,
      Scheme.Hom.isoOpensRange_inv_comp, Scheme.isoOfEq_hom_ι]
  rw [key, Scheme.Hom.ι_fromNormalization g U]
  have hS' : LocallyOfFiniteType
      (Spec.map ((Scheme.Hom.normalizationDiagramMap g).app (Opposite.op (U : Y.Opens)))) := hS
  have h1 : LocallyOfFiniteType (IsAffineOpen.fromSpec U.2) := by
    haveI : IsOpenImmersion (IsAffineOpen.fromSpec U.2) := IsAffineOpen.isOpenImmersion_fromSpec _
    first
      | exact IsZariskiLocalAtSource.of_isOpenImmersion (P := @LocallyOfFiniteType) _
      | infer_instance
  have h2 : LocallyOfFiniteType ((Scheme.Hom.normalization g).isoOfEq e).hom := inferInstance
  have h3 : LocallyOfFiniteType
      ((Scheme.Hom.normalizationOpenCover g).f U).isoOpensRange.inv := inferInstance
  exact MorphismProperty.comp_mem _ _ _ h2 (MorphismProperty.comp_mem _ _ _ h3
    (MorphismProperty.comp_mem _ _ _ hS' h1))

theorem wc_fnf_integralClosure_finite_of_etale_field : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [IsNoetherianRing R] (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K] (A : Type u) [CommRing A] [Algebra K A] [Algebra R A] [IsScalarTower R K A] [Algebra.Etale K A], Module.Finite R (integralClosure R A) :=
by
  intro R _ _ _ _ K _ _ _ A _ _ _ _ _
  obtain ⟨I, hI, Ai, hF, hAlg, e, hfs⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
  haveI := hI
  letI : ∀ i, Algebra R (Ai i) := fun i =>
    ((algebraMap K (Ai i)).comp (algebraMap R K)).toAlgebra
  haveI : ∀ i, IsScalarTower R K (Ai i) := fun i => IsScalarTower.of_algebraMap_eq' rfl
  let ε : ∀ i, A →ₐ[R] Ai i := fun i =>
    ((Pi.evalAlgHom K Ai i).comp e.toAlgHom).restrictScalars R
  let ψ : ∀ i, integralClosure R A →ₐ[R] integralClosure R (Ai i) := fun i =>
    (ε i).mapIntegralClosure
  let Φ : integralClosure R A →ₗ[R] ∀ i, integralClosure R (Ai i) :=
    LinearMap.pi (fun i => (ψ i).toLinearMap)
  have hΦ : Function.Injective Φ := by
    intro x y hxy
    apply Subtype.ext
    apply e.injective
    funext i
    have h := congrFun hxy i
    have h2 := congrArg Subtype.val h
    exact h2
  haveI : ∀ i, Module.Finite R (integralClosure R (Ai i)) := fun i => by
    haveI := (hfs i).1
    haveI := (hfs i).2
    exact IsIntegralClosure.finite R K (Ai i) (integralClosure R (Ai i))
  haveI : Module.Finite R (∀ i, integralClosure R (Ai i)) := Module.Finite.pi
  haveI : IsNoetherian R (∀ i, integralClosure R (Ai i)) :=
    isNoetherian_of_isNoetherianRing_of_finite R _
  exact Module.Finite.of_injective Φ hΦ

theorem wc_fnf_integralClosure_finite_of_etale_localization : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] (T : Type u) [CommRing T] [Algebra R T] (M : Submonoid R) [IsLocalization M T] (B : Type u) [CommRing B] [Algebra T B] [Algebra R B] [IsScalarTower R T B] [Algebra.Etale T B], (∀ (A : Type u) [CommRing A] [Algebra (FractionRing R) A] [Algebra R A] [IsScalarTower R (FractionRing R) A] [Algebra.Etale (FractionRing R) A], Module.Finite R (integralClosure R A)) → Module.Finite R (integralClosure R B) :=
by
  intro R _ _ _ T _ _ M _ B _ _ _ _ _ H
  by_cases h0 : (0 : R) ∈ M
  · haveI : Unique T := IsLocalization.uniqueOfZeroMem (M := M) h0
    haveI : Subsingleton B := by
      apply subsingleton_of_zero_eq_one
      rw [← map_zero (algebraMap T B), ← map_one (algebraMap T B), Subsingleton.elim (0 : T) 1]
    haveI : Subsingleton (integralClosure R B) :=
      ⟨fun a b => Subtype.ext (Subsingleton.elim _ _)⟩
    haveI : Finite (integralClosure R B) := Finite.of_subsingleton
    exact Module.Finite.of_finite
  · have hM : M ≤ nonZeroDivisors R := le_nonZeroDivisors_of_noZeroDivisors h0
    have hu : ∀ y : M, IsUnit (algebraMap R (FractionRing R) (y : R)) := fun y =>
      IsUnit.mk0 _ (fun h => (nonZeroDivisors.ne_zero (hM y.2))
        ((IsFractionRing.injective R (FractionRing R)) (by rw [h, map_zero])))
    letI : Algebra T (FractionRing R) := (IsLocalization.lift (M := M) hu).toAlgebra
    haveI : IsScalarTower R T (FractionRing R) :=
      IsScalarTower.of_algebraMap_eq' (IsLocalization.lift_comp (M := M) hu).symm
    haveI : IsDomain T := IsLocalization.isDomain_of_le_nonZeroDivisors T hM
    haveI : IsFractionRing T (FractionRing R) :=
      IsFractionRing.isFractionRing_of_isDomain_of_isLocalization M T (FractionRing R)
    have hA : Module.Finite R (integralClosure R (TensorProduct T (FractionRing R) B)) :=
      H (TensorProduct T (FractionRing R) B)
    have hj : Function.Injective
        (Algebra.TensorProduct.includeRight : B →ₐ[T] TensorProduct T (FractionRing R) B) :=
      Algebra.TensorProduct.includeRight_injective (A := FractionRing R) (B := B)
        (IsFractionRing.injective T (FractionRing R))
    let j : B →ₐ[R] TensorProduct T (FractionRing R) B :=
      (Algebra.TensorProduct.includeRight : B →ₐ[T] TensorProduct T (FractionRing R) B).restrictScalars R
    have hj' : Function.Injective j := hj
    have key : ∀ (A : Type u) [CommRing A] [Algebra R A] (j : B →ₐ[R] A),
        Function.Injective j → Module.Finite R (integralClosure R A) →
        Module.Finite R (integralClosure R B) := by
      intro A _ _ j hj hfin
      let Ψ := AlgHom.mapIntegralClosure j
      have hΨ : Function.Injective Ψ := by
        intro x y hxy
        apply Subtype.ext
        apply hj
        exact congrArg Subtype.val hxy
      haveI : IsNoetherian R (integralClosure R A) :=
        isNoetherian_of_isNoetherianRing_of_finite R (integralClosure R A)
      exact Module.Finite.of_injective Ψ.toLinearMap hΨ
    exact key _ j hj' hA

theorem wc_fnf_pi_quotient_away_normal_domain : ∀ (R : Type u) [CommRing R] (k : ℕ) (P : Fin k → Ideal R), (∀ i, (P i).IsPrime) → Function.Bijective (RingHom.pi fun i => Ideal.Quotient.mk (P i)) → (∀ (q : Ideal R) [q.IsPrime], IsIntegrallyClosed (Localization.AtPrime q)) → ∀ (p : Ideal R) [p.IsPrime], ∃ r : R, r ∉ p ∧ ∀ (S : Type u) [CommRing S] [Algebra R S] [IsLocalization.Away r S], IsDomain S ∧ IsIntegrallyClosed S :=
by
  intro R _ k P hP hbij hic p _
  classical
  have hφapp : ∀ x j, (RingHom.pi fun i => Ideal.Quotient.mk (P i)) x j = Ideal.Quotient.mk (P j) x :=
    fun _ _ => rfl
  obtain ⟨E, hE⟩ : ∃ E : Fin k → R, ∀ j, (RingHom.pi fun i => Ideal.Quotient.mk (P i)) (E j) =
      Pi.single j 1 :=
    ⟨fun j => (hbij.2 (Pi.single j 1)).choose, fun j => (hbij.2 _).choose_spec⟩
  have hidem : ∀ j, IsIdempotentElem (E j) := by
    intro j
    apply hbij.1
    rw [map_mul, hE]
    funext t
    by_cases h : t = j
    · subst h; simp
    · simp [Pi.single_eq_of_ne h]
  have hsum : ∑ j, E j = 1 := by
    apply hbij.1
    rw [map_sum, map_one]
    funext t
    rw [Finset.sum_apply, Finset.sum_eq_single t]
    · rw [hE]; simp
    · intro b _ hb
      rw [hE]; exact Pi.single_eq_of_ne (Ne.symm hb) _
    · intro h; exact absurd (Finset.mem_univ t) h
  obtain ⟨i, hi⟩ : ∃ i, E i ∉ p := by
    by_contra hcon
    push_neg at hcon
    have h1 : (1 : R) ∈ p := hsum ▸ Ideal.sum_mem p (fun j _ => hcon j)
    exact (Ideal.IsPrime.ne_top inferInstance) ((Ideal.eq_top_iff_one p).2 h1)
  have hspan : Ideal.span {1 - E i} = P i := by
    apply le_antisymm
    · rw [Ideal.span_singleton_le_iff_mem, ← Ideal.Quotient.eq_zero_iff_mem]
      have h := congrFun (hE i) i
      rw [hφapp] at h
      rw [map_sub, map_one, h]
      simp
    · intro x hx
      have hxE : x * E i = 0 := by
        apply hbij.1
        rw [map_mul, hE, map_zero]
        funext t
        by_cases h : t = i
        · subst h
          simp [hφapp, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
        · simp [Pi.single_eq_of_ne h]
      rw [Ideal.mem_span_singleton]
      exact ⟨x, by linear_combination hxE⟩
  refine ⟨E i, hi, fun S _ _ _ => ?_⟩
  haveI := IsLocalization.Away.quotient_of_isIdempotentElem (hidem i)
  haveI : (Ideal.span {1 - E i}).IsPrime := hspan ▸ hP i
  let f := IsLocalization.algEquiv (Submonoid.powers (E i)) S (R ⧸ Ideal.span {1 - E i})
  haveI hdom : IsDomain S :=
    MulEquiv.isDomain (R ⧸ Ideal.span {1 - E i}) f.toRingEquiv.toMulEquiv
  refine ⟨hdom, ?_⟩
  apply IsIntegrallyClosed.of_localization_maximal
  intro m _ _
  haveI := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
    (Submonoid.powers (E i)) (Localization.AtPrime m) m
  let e := IsLocalization.algEquiv (Ideal.comap (algebraMap R S) m).primeCompl
    (Localization.AtPrime (Ideal.comap (algebraMap R S) m)) (Localization.AtPrime m)
  exact IsIntegrallyClosed.of_equiv e.toRingEquiv

theorem wc_fnf_normal_domain_affine_nbhd : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X], (∀ (R : Type u) [CommRing R] [IsNoetherianRing R], (∀ (q : Ideal R) [q.IsPrime], IsDomain (Localization.AtPrime q) ∧ IsIntegrallyClosed (Localization.AtPrime q)) → ∀ (p : Ideal R) [p.IsPrime], ∃ r : R, r ∉ p ∧ ∀ (S : Type u) [CommRing S] [Algebra R S] [IsLocalization.Away r S], IsDomain S ∧ IsIntegrallyClosed S) → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → ∀ x : X, ∃ W : X.Opens, IsAffineOpen W ∧ x ∈ W ∧ IsDomain Γ(X, W) ∧ IsIntegrallyClosed Γ(X, W) :=
by
  intro X _ H hst x
  obtain ⟨U, hU, hxU, -⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (show x ∈ (⊤ : X.Opens) from trivial)
  have hU' : IsAffineOpen U := hU
  haveI : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  have key : ∀ z : U, IsDomain (Localization.AtPrime (hU'.primeIdealOf z).asIdeal) ∧
      IsIntegrallyClosed (Localization.AtPrime (hU'.primeIdealOf z).asIdeal) := by
    rintro ⟨w, hw⟩
    letI := TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨w, hw⟩ : U)
    haveI := hU'.isLocalization_stalk ⟨w, hw⟩
    let e := IsLocalization.algEquiv (hU'.primeIdealOf ⟨w, hw⟩).asIdeal.primeCompl
      (Localization.AtPrime (hU'.primeIdealOf ⟨w, hw⟩).asIdeal) (X.presheaf.stalk w)
    haveI := (hst w).1
    haveI := (hst w).2
    exact ⟨MulEquiv.isDomain _ e.toMulEquiv, IsIntegrallyClosed.of_equiv e.toRingEquiv.symm⟩
  have hsurj : ∀ y : Spec Γ(X, U), ∃ z : U, hU'.primeIdealOf z = y := by
    intro y
    have hy : hU'.fromSpec y ∈ U := by
      have h0 : hU'.fromSpec y ∈ Set.range hU'.fromSpec := ⟨y, rfl⟩
      rw [hU'.range_fromSpec] at h0
      exact h0
    refine ⟨⟨hU'.fromSpec y, hy⟩, ?_⟩
    haveI := hU'.isOpenImmersion_fromSpec
    apply hU'.fromSpec.isOpenEmbedding.injective
    exact hU'.fromSpec_primeIdealOf ⟨hU'.fromSpec y, hy⟩
  have hloc : ∀ y : PrimeSpectrum Γ(X, U), IsDomain (Localization.AtPrime y.asIdeal) ∧
      IsIntegrallyClosed (Localization.AtPrime y.asIdeal) := by
    intro y
    obtain ⟨z, rfl⟩ := hsurj y
    exact key z
  obtain ⟨r, hr, hS⟩ := H Γ(X, U) (fun q hq => hloc ⟨q, hq⟩) (hU'.primeIdealOf ⟨x, hxU⟩).asIdeal
  haveI := hU'.isLocalization_basicOpen r
  obtain ⟨hd, hic⟩ := hS Γ(X, X.basicOpen r)
  refine ⟨X.basicOpen r, hU'.basicOpen r, ?_, hd, hic⟩
  have h1 : hU'.primeIdealOf ⟨x, hxU⟩ ∈ PrimeSpectrum.basicOpen r :=
    (PrimeSpectrum.mem_basicOpen _ _).mpr hr
  rw [← hU'.fromSpec_preimage_basicOpen r] at h1
  have h2 := (Scheme.Hom.mem_preimage _).mp h1
  rw [hU'.fromSpec_primeIdealOf ⟨x, hxU⟩] at h2
  exact h2

theorem wc_fnf_generic_fibre_sections_isLocalization : ∀ (A : Type u) [CommRing A] [IsDomain A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) (W : X.Opens), IsAffineOpen W → ∃ M : Submonoid Γ(X, W), letI : Algebra Γ(X, W) Γ(Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))), Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))) ⁻¹ᵁ W) := (Scheme.Hom.app (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A))))) W).hom.toAlgebra; IsLocalization M Γ(Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))), Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))) ⁻¹ᵁ W) :=
by
  intro A _ _ X f W hW
  open Limits in
  set_option backward.defeqAttrib.useBackward true in
  set_option backward.isDefEq.respectTransparency false in
  ·
    have s2 : ∀ {R R' S P : CommRingCat.{u}} (a : R ⟶ S) (b : R ⟶ R') (c : S ⟶ P) (d : R' ⟶ P),
        IsPushout a b c d → ∀ (M : Submonoid R), (letI : Algebra R R' := b.hom.toAlgebra;
          IsLocalization M R') → (letI : Algebra S P := c.hom.toAlgebra;
          IsLocalization (M.map a.hom) P) := by
      intro R R' S P a b c d h M hM
      letI : Algebra R S := a.hom.toAlgebra
      letI : Algebra R R' := b.hom.toAlgebra
      letI : Algebra S P := c.hom.toAlgebra
      letI : Algebra R' P := d.hom.toAlgebra
      letI : Algebra R P := (a ≫ c).hom.toAlgebra
      haveI : IsScalarTower R S P := .of_algebraMap_eq' rfl
      haveI : IsScalarTower R R' P := .of_algebraMap_eq' (congrArg CommRingCat.Hom.hom h.w)
      have h' : Algebra.IsPushout R R' S P := CommRingCat.isPushout_iff_isPushout.mp h.flip
      exact (Algebra.isLocalization_iff_isPushout M R' (T := S) (B := P)).mpr h'.symm

    have s3 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (M : Submonoid R)
        [IsLocalization M S], ∃ M' : Submonoid Γ(Spec (.of R), ⊤),
        letI : Algebra Γ(Spec (.of R), ⊤) Γ(Spec (.of S), ⊤) :=
          (Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom (algebraMap R S))) ⊤ ⊤ le_top).hom.toAlgebra;
        IsLocalization M' Γ(Spec (.of S), ⊤) := by
      intro R S _ _ _ M _
      let eR : Γ(Spec (.of R), ⊤) ≃+* R := (Scheme.ΓSpecIso (.of R)).commRingCatIsoToRingEquiv
      let eS : Γ(Spec (.of S), ⊤) ≃+* S := (Scheme.ΓSpecIso (.of S)).commRingCatIsoToRingEquiv
      refine ⟨M.map eR.symm, ?_⟩
      have h1 := IsLocalization.isLocalization_of_base_ringEquiv M S eR.symm
      letI i1 : Algebra Γ(Spec (.of R), ⊤) S :=
        ((algebraMap R S).comp eR.symm.symm.toRingHom).toAlgebra
      have h2 := (IsLocalization.isLocalization_iff_of_ringEquiv (M.map eR.symm) eS.symm).mp h1
      have hnat := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap R S))
      have hEq : (Scheme.Hom.appLE (Spec.map (CommRingCat.ofHom (algebraMap R S))) ⊤ ⊤ le_top).hom =
          eS.symm.toRingHom.comp (algebraMap Γ(Spec (.of R), ⊤) S) := by
        ext x
        apply eS.injective
        simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, RingEquiv.apply_symm_apply]
        exact congrArg (fun φ => φ.hom x) hnat
      show @IsLocalization _ _ _ _ _ (RingHom.toAlgebra _)
      rw [hEq]
      exact h2

    obtain ⟨M₀, hM₀⟩ := s3 A (FractionRing A) (nonZeroDivisors A)
    have hloc := s2 _ _ _ _ ((isIso_pushoutSection_iff (IsPullback.of_hasPullback f
          (Spec.map (CommRingCat.ofHom (algebraMap A (FractionRing A)))))
        (US := ⊤) (UT := ⊤) (UX := W) (UY := pullback.fst f (Spec.map (CommRingCat.ofHom
          (algebraMap A (FractionRing A)))) ⁻¹ᵁ W)
        (by simp) (by simp) (by simp)).mp
        (isIso_pushoutSection_of_isAffineOpen _ _ _ _ (isAffineOpen_top _) (isAffineOpen_top _) hW))
        M₀ hM₀
    refine ⟨Submonoid.map (Scheme.Hom.appLE f ⊤ W (by simp)).hom M₀, ?_⟩
    show @IsLocalization _ _ _ _ _ (RingHom.toAlgebra _)
    rw [Scheme.Hom.app_eq_appLE]
    exact hloc

theorem wc_fntame_normalization_finite : ∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsNoetherianRing A₀] (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (f : X ⟶ Spec (.of A₀)) [Smooth f] (P : Scheme.{u}) (p : P ⟶ Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) [QuasiCompact (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))] [QuasiSeparated (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))], IsFinite p → Etale p → (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) → IsFinite (Scheme.Hom.fromNormalization (p ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))))) :=
