    · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc,
        IsPullback.lift_fst, Category.id_comp]
    · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, Category.id_comp]

  have hd0 := hd
  obtain ⟨_, haff, hcompat, hφa, hlim, -⟩ := hd0
  let F : Λ ⥤ Over (wcHalA1 s) :=
