          (separableClosure (FractionRing (MvPolynomial (Fin d) K)) (FractionRing B))).injective _
    haveI : IsScalarTower (MvPolynomial (Fin d) K)
        (separableClosure (FractionRing (MvPolynomial (Fin d) K)) (FractionRing B)) (FractionRing B) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Module.Finite (MvPolynomial (Fin d) K) (integralClosure (MvPolynomial (Fin d) K)
        (separableClosure (FractionRing (MvPolynomial (Fin d) K)) (FractionRing B))) :=
      IsIntegralClosure.finite (MvPolynomial (Fin d) K) (FractionRing (MvPolynomial (Fin d) K))
