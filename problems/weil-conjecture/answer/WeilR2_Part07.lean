theorem wc_et_slice_module_restrict_exact : ∀ {X : Scheme.{u}} (T : X.Etale) [hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] [(wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (ℓ : ℕ) (ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj (wcEtZModRing X ℓ)), (SheafOfModules.pushforward.{u+1} ψ).Additive ∧ Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} ψ) ∧ Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} ψ) :=
by
  intro X T hc hcc ℓ ψ
  have hts : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}), Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) := by
