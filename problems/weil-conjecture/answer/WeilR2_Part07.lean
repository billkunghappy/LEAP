    have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} R).mapCocone
        ((PresheafOfModules.sheafification (J := J) (𝟙 R.obj)).mapCocone c₀)) :=
      Limits.IsColimit.ofIsoColimit
        (Limits.isColimitOfPreserves
          (PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ⋙ SheafOfModules.toSheaf.{u+1} R) h₀)
        (Functor.mapCoconeMapCocone c₀).symm
    haveI : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj))
        (SheafOfModules.toSheaf.{u+1} R) :=
      Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
    let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 R.obj) ≅ K :=
      Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫ Functor.rightUnitor K
    exact Limits.preservesColimit_of_iso_diagram _ e
  haveI := hts (Scheme.smallEtaleTopology T.left) (wcEtZModRing T.left ℓ)
  haveI := hts (Scheme.smallEtaleTopology X) (wcEtZModRing X ℓ)
  have adj := (wcEtSlice T).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
  haveI := adj.leftAdjoint_preservesColimits.{0, 0}
  haveI : Limits.PreservesFiniteColimits ((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)) :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits _
  have hpe : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
