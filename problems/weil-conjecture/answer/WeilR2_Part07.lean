    hV.preimage p
  obtain ⟨M, hM⟩ := wc_fnf_generic_fibre_sections_isLocalization A₀ X f W hW
  letI : Algebra Γ(X, W) Γ(Limits.pullback f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))), Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ W) :=
    (Scheme.Hom.app (Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀))))) W).hom.toAlgebra
  letI : Algebra Γ(Limits.pullback f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))), Limits.pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap A₀ (FractionRing A₀)))) ⁻¹ᵁ W)
      Γ(P, p ⁻¹ᵁ (Limits.pullback.fst f
