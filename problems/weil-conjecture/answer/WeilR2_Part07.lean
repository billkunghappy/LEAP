    haveI hd : DiscreteTopology ↑(φ₁ ⁻¹' {φ₁ v}) := (φ₁.fiberHomeo (φ₁ v)).discreteTopology
    have hv : φ₁ v ∈ ({φ₁ v} : Set _) := Set.mem_singleton _
    have hopen : IsOpen ({⟨v, hv⟩} : Set ↑(φ₁ ⁻¹' {φ₁ v})) := isOpen_discrete _
    obtain ⟨t, ht, hteq⟩ := isOpen_induced_iff.mp hopen
    refine ⟨⟨t, ht⟩, ?_, ?_⟩
    · have : (⟨v, hv⟩ : ↑(φ₁ ⁻¹' {φ₁ v})) ∈ Subtype.val ⁻¹' t := by
        rw [hteq]; exact Set.mem_singleton _
      exact this
    · intro x hxU hx
      have hx' : x ∈ φ₁ ⁻¹' {φ₁ v} := by
        simp only [Set.mem_preimage, Set.mem_singleton_iff]; exact hx
      have : (⟨x, hx'⟩ : ↑(φ₁ ⁻¹' {φ₁ v})) ∈ Subtype.val ⁻¹' t := hxU
      rw [hteq, Set.mem_singleton_iff] at this
      exact congrArg Subtype.val this
  have hrange' : Set.range w ⊆ Set.range U'.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨p, rfl⟩
    rw [hsub p (IsLocalRing.closedPoint K)]
    exact hwU'
  let v₀ := IsOpenImmersion.lift U'.ι w hrange'
  have hv₀ : v₀ ≫ U'.ι = w := IsOpenImmersion.lift_fac _ _ _
  refine ⟨(U' : Scheme.{u}), U'.ι ≫ hW.fromSpec, inferInstance, v₀, U'.ι ≫ φ₁, ?_, inferInstance,
    ?_, ?_⟩
  · rw [← Category.assoc, hv₀, hw]
  · rw [← Category.assoc, hv₀, hwφ]
  · intro v hv
    have h1 : φ₁ (U'.ι v) = φ₁ (w (IsLocalRing.closedPoint K)) := by
      rw [← Scheme.Hom.comp_apply, hv, ← hwφ]
      exact Scheme.Hom.comp_apply w φ₁ _
    have hmem : U'.ι v ∈ U' := by
      have h := Set.mem_range_self (f := U'.ι) v
      rwa [Scheme.Opens.range_ι] at h
    have h2 := hiso (U'.ι v) hmem h1
    apply U'.ι.isOpenEmbedding.injective
    rw [h2, ← hv₀]
    exact Scheme.Hom.comp_apply v₀ U'.ι _

theorem wc_et_point_fibre_isPullback : ∀ (K : Type u) [Field K] (X V : Scheme.{u}) (φ : V ⟶ X) [Etale φ] (x₀ : Spec (.of K) ⟶ X) (v₀ : Spec (.of K) ⟶ V) [IsClosedImmersion x₀] [IsClosedImmersion v₀], v₀ ≫ φ = x₀ → (∀ v : V, φ v = x₀ (IsLocalRing.closedPoint K) → v = v₀ (IsLocalRing.closedPoint K)) → IsPullback (𝟙 (Spec (.of K))) v₀ x₀ φ :=
by
  intro K _ X V φ _ x₀ v₀ _ _ h hfib
  have hsq : 𝟙 (Spec (.of K)) ≫ x₀ = v₀ ≫ φ := by rw [Category.id_comp, h]
  let s : Spec (.of K) ⟶ Limits.pullback x₀ φ := Limits.pullback.lift (𝟙 _) v₀ hsq
  have hs1 : s ≫ Limits.pullback.fst x₀ φ = 𝟙 _ := Limits.pullback.lift_fst _ _ _
  have hs2 : s ≫ Limits.pullback.snd x₀ φ = v₀ := Limits.pullback.lift_snd _ _ _
  haveI hp : Etale (Limits.pullback.fst x₀ φ) := inferInstance
  have hle : @Etale ≤ (@IsOpenImmersion).diagonal := by
    intro A B f hf
    rw [MorphismProperty.diagonal_iff]
    haveI := hf
    infer_instance
  haveI hpost : (@IsOpenImmersion).HasOfPostcompProperty @Etale :=
    (MorphismProperty.hasOfPostcompProperty_iff_le_diagonal).mpr hle
  have hso : IsOpenImmersion s := by
    apply MorphismProperty.of_postcomp (W := @IsOpenImmersion) (W' := @Etale) s
      (Limits.pullback.fst x₀ φ) hp
    rw [hs1]; infer_instance
  have hss : Surjective s := by
    constructor
    intro z
    let pt : ↥(Spec (.of K)) := IsLocalRing.closedPoint K
    refine ⟨pt, ?_⟩
    apply (Limits.pullback.snd x₀ φ).isClosedEmbedding.injective
    have e1 : (Limits.pullback.snd x₀ φ) (s pt) = v₀ pt := by
      rw [← Scheme.Hom.comp_apply, hs2]
    have e2 : φ ((Limits.pullback.snd x₀ φ) z) = x₀ pt := by
      rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]
      congr 1
      exact Subsingleton.elim _ _
    rw [e1]
    exact (hfib _ e2).symm
  haveI : IsIso s := (isIso_iff_isOpenImmersion_and_surjective s).mpr ⟨hso, hss⟩
  exact IsPullback.of_iso_pullback ⟨hsq⟩ (asIso s) hs1 hs2

theorem wc_et_slice_zmod_restrict_unit : ∀ {X : Scheme.{u}} (T : X.Etale) [hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] [(wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (ℓ : ℕ), ∃ ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj (wcEtZModRing X ℓ), Nonempty ((SheafOfModules.pushforward.{u+1} ψ).obj (SheafOfModules.unit (wcEtZModRing X ℓ)) ≅ SheafOfModules.unit (wcEtZModRing T.left ℓ)) :=
