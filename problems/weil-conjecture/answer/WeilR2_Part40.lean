      rw [CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply]
      exact congrArg _ hxy
    rw [e, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply,
      CommRingCat.hom_ofHom] at h3
    have h4 := IsFractionRing.injective R (FractionRing R) h3
    exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of R)).hom).1 h4
  have hc := Limits.pullback.condition (f := u) (g := u')
  have e1 : (l.l ≫ μ ≫ ι ≫ Limits.pullback.snd u u') ≫ u' = τ' i ≫ u' := by
    rw [hst'.2.1.1 i]
    calc (l.l ≫ μ ≫ ι ≫ Limits.pullback.snd u u') ≫ u'
        = (l.l ≫ μ ≫ ι ≫ Limits.pullback.fst u u') ≫ u := by simp only [Category.assoc, hc]
      _ = 𝟙 _ := by rw [hfr, hst.2.1.1 i]
  have e2 : Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫
      l.l ≫ μ ≫ ι ≫ Limits.pullback.snd u u' =
      Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ τ' i := by
    rw [← Category.assoc, hfl, ← Category.assoc, hℓ, Category.assoc, ← Category.assoc j, hjι,
      Limits.pullback.lift_snd, ht3]
  exact ⟨l.l, hfr, ext_of_isDominant_of_isSeparated u' e1 _ e2⟩

theorem wcpa_dj_nccw_generic_curve_dims : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), wcpaDjSemistable u → nccwsuH1 u ∧ nccwsuH2 u :=
by
  intro R _ _ _ Z u hss
  classical

  have s2 : ∀ {W X : Type u} [TopologicalSpace W] [TopologicalSpace X] (g : W → X) (O : Set X),
      IsOpen O → (∀ x ∈ O, ∃ w, g w = x) →
      (∀ (w : W) (x : X), g w ⤳ x → x ∈ O → ∃ w', w ⤳ w' ∧ g w' = x) →
      (∀ w₀ w₁ w₂ : W, w₀ ⤳ w₁ → w₁ ⤳ w₂ → w₀ = w₁ ∨ w₁ = w₂) →
      ∀ x₀ x₁ x₂ : X, x₂ ∈ O → x₀ ⤳ x₁ → x₁ ⤳ x₂ → x₀ = x₁ ∨ x₁ = x₂ := by
    intro W X _ _ g O hO hs hl hc x₀ x₁ x₂ hx₂ h01 h12
    have hx₁ : x₁ ∈ O := h12.mem_open hO hx₂
    have hx₀ : x₀ ∈ O := h01.mem_open hO hx₁
    obtain ⟨w₀, hw₀⟩ := hs x₀ hx₀
    obtain ⟨w₁, h1, hw₁⟩ := hl w₀ x₁ (by rw [hw₀]; exact h01) hx₁
    obtain ⟨w₂, h2, hw₂⟩ := hl w₁ x₂ (by rw [hw₁]; exact h12) hx₂
    rcases hc w₀ w₁ w₂ h1 h2 with e | e
    · left; rw [← hw₀, ← hw₁, e]
    · right; rw [← hw₁, ← hw₂, e]

  have s3 : ∀ {W X : Type u} [TopologicalSpace W] [TopologicalSpace X] [QuasiSober W]
      [JacobsonSpace W] (g : W → X) (O : Set X), Continuous g → (∀ x ∈ O, ∃ w, g w = x) →
      (∀ w, g w ∈ O) → (∀ w w' : W, w ⤳ w' → g w = g w' → w = w') →
      (∀ E ∈ irreducibleComponents W, ∀ y ∈ E, ∃ y' ∈ E, y' ≠ y) →
      ∀ x ∈ O, (∀ x' : X, x' ⤳ x → x' = x) → ∀ U : Set X, IsOpen U → x ∈ U →
      ∃ x' ∈ U, x' ∈ O ∧ x ⤳ x' ∧ x' ≠ x := by
    intro W X _ _ _ _ g O hg hs hO hI hE x hx hGP U hU hxU
    by_contra hcon
    push_neg at hcon
    obtain ⟨w, hw⟩ := hs x hx
    obtain ⟨E, hEc, hwE⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
      (isIrreducible_singleton (x := w)).closure
    have hwE' : w ∈ E := hwE (subset_closure (Set.mem_singleton w))
    have hEcl0 : IsClosed E := isClosed_of_mem_irreducibleComponents E hEc
    obtain ⟨e, he⟩ := QuasiSober.sober hEc.1 hEcl0
    have hew : e ⤳ w := he.specializes hwE'
    have hge : g e = x := hGP (g e) (by rw [← hw]; exact hew.map hg)
    have hew' : e = w := hI e w hew (hge.trans hw.symm)
    have hEcl : E = closure {w} := by rw [← he.def, hew']
    obtain ⟨w₁, hw₁E, hw₁ne⟩ := hE E hEc w hwE'
    have hloc : ({w} : Set W) = g ⁻¹' U ∩ E := by
      ext w'
      constructor
      · intro h0
        rw [Set.mem_singleton_iff.mp h0]
        exact ⟨by rw [Set.mem_preimage, hw]; exact hxU, hwE'⟩
      · rintro ⟨hw'U, hw'E⟩
        rw [hEcl] at hw'E
        have hsp : w ⤳ w' := specializes_iff_mem_closure.mpr hw'E
        have h1 : g w' = x := hcon (g w') hw'U (hO w') (by rw [← hw]; exact hsp.map hg)
        exact Set.mem_singleton_iff.mpr (hI w w' hsp (hw.trans h1.symm)).symm
    have hlc : IsLocallyClosed ({w} : Set W) := ⟨g ⁻¹' U, E, hU.preimage hg, hEcl0, hloc⟩
    have hcl : IsClosed ({w} : Set W) := isClosed_singleton_of_isLocallyClosed_singleton hlc
    have hmem : w₁ ∈ ({w} : Set W) := by rw [← hcl.closure_eq, ← hEcl]; exact hw₁E
    exact hw₁ne (Set.mem_singleton_iff.mp hmem)

  obtain ⟨ι, hι⟩ : ∃ ι : Spec (.of (FractionRing R)) ⟶ Spec (.of R),
      ι = Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) := ⟨_, rfl⟩
  obtain ⟨t, ht⟩ : ∃ t : Spec (.of (AlgebraicClosure (FractionRing R))) ⟶
      Spec (.of (FractionRing R)),
      t = Spec.map (CommRingCat.ofHom
        (algebraMap (FractionRing R) (AlgebraicClosure (FractionRing R)))) := ⟨_, rfl⟩
  haveI hιo : IsOpenImmersion ι := by rw [hι]; exact wcpa_dj_ldx_gen_open_immersion R
  have htint : IsIntegralHom t := by
    rw [ht, IsIntegralHom.SpecMap_iff, CommRingCat.hom_ofHom]
    exact algebraMap_isIntegral_iff.mpr inferInstance
  have htsurj : Surjective t :=
    ⟨fun p => ⟨Classical.arbitrary _, Subsingleton.elim _ _⟩⟩
  have hw0 : Limits.pullback.fst u (t ≫ ι) ≫ u = (Limits.pullback.snd u (t ≫ ι) ≫ t) ≫ ι := by
    rw [Limits.pullback.condition, Category.assoc]
  obtain ⟨h, hhdef⟩ : ∃ h : Limits.pullback u (t ≫ ι) ⟶ Limits.pullback u ι,
      h = Limits.pullback.lift (Limits.pullback.fst u (t ≫ ι))
        (Limits.pullback.snd u (t ≫ ι) ≫ t) hw0 := ⟨_, rfl⟩
  have hfac : h ≫ Limits.pullback.fst u ι = Limits.pullback.fst u (t ≫ ι) := by
    rw [hhdef]; exact Limits.pullback.lift_fst _ _ _
  have hmid : h ≫ Limits.pullback.snd u ι = Limits.pullback.snd u (t ≫ ι) ≫ t := by
    rw [hhdef]; exact Limits.pullback.lift_snd _ _ _
  have hbig : IsPullback (h ≫ Limits.pullback.fst u ι) (Limits.pullback.snd u (t ≫ ι)) u
      (t ≫ ι) := by
    rw [hfac]; exact IsPullback.of_hasPullback u (t ≫ ι)
  have hsq : IsPullback h (Limits.pullback.snd u (t ≫ ι)) (Limits.pullback.snd u ι) t :=
    IsPullback.of_right hbig hmid (IsPullback.of_hasPullback u ι)
  haveI hhint : IsIntegralHom h :=
    MorphismProperty.of_isPullback (P := @IsIntegralHom) hsq.flip htint
  haveI hhsurj : Surjective h :=
    MorphismProperty.of_isPullback (P := @Surjective) hsq.flip htsurj
  have hrange : ∀ z : Z, z ∈ Set.range ⇑(Limits.pullback.fst u ι) ↔
      u z ≠ IsLocalRing.closedPoint R :=
    wcpa_dj_ldx_range_generic R Z (Limits.pullback u ι) u (Limits.pullback.snd u ι)
      (Limits.pullback.fst u ι) (by rw [← hι]; exact IsPullback.of_hasPullback u ι)

  have hgpt : ∀ w, Limits.pullback.fst u (t ≫ ι) w = Limits.pullback.fst u ι (h w) := by
    intro w; rw [← Scheme.Hom.comp_apply, hfac]
  have hOopen : IsOpen {z : Z | u z ≠ IsLocalRing.closedPoint R} :=
    (IsLocalRing.isClosed_singleton_closedPoint R).isOpen_compl.preimage u.continuous
  have hs : ∀ x ∈ {z : Z | u z ≠ IsLocalRing.closedPoint R},
      ∃ w, Limits.pullback.fst u (t ≫ ι) w = x := by
    intro x hx
    obtain ⟨v, hv⟩ := (hrange x).mpr hx
    obtain ⟨w, hw⟩ := h.surjective v
    exact ⟨w, by rw [hgpt, hw, hv]⟩
  have hO : ∀ w, Limits.pullback.fst u (t ≫ ι) w ∈ {z : Z | u z ≠ IsLocalRing.closedPoint R} :=
    fun w => (hrange _).mp ⟨h w, (hgpt w).symm⟩
  have hI : ∀ w w', w ⤳ w' → Limits.pullback.fst u (t ≫ ι) w =
      Limits.pullback.fst u (t ≫ ι) w' → w = w' := by
    intro w w' hsp heq
    rw [hgpt, hgpt] at heq
    have h1 : h w = h w' := (Limits.pullback.fst u ι).isOpenEmbedding.isEmbedding.injective heq
    exact wcpa_dj_lr1k_gs_integral_incomparable h w w' hsp h1
  have hl : ∀ w x, Limits.pullback.fst u (t ≫ ι) w ⤳ x →
      x ∈ {z : Z | u z ≠ IsLocalRing.closedPoint R} →
      ∃ w', w ⤳ w' ∧ Limits.pullback.fst u (t ≫ ι) w' = x := by
    intro w x hsp hx
    obtain ⟨v, hv⟩ := (hrange x).mpr hx
    rw [← hv, hgpt] at hsp
    have hsp' : h w ⤳ v :=
      ((Limits.pullback.fst u ι).isOpenEmbedding.isInducing.specializes_iff).mp hsp
    obtain ⟨w', hw', hw'v⟩ := (Scheme.Hom.isClosedMap h).specializingMap hsp'
    exact ⟨w', hw', by rw [hgpt, hw'v, hv]⟩

  haveI : IsProper u := hss.2.1
  haveI : JacobsonSpace ↥(Spec (.of (AlgebraicClosure (FractionRing R)))) := inferInstance
  haveI : JacobsonSpace ↥(Limits.pullback u (t ≫ ι)) :=
    LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd u (t ≫ ι))
  refine ⟨?_, ?_⟩
  · intro x₀ x₁ x₂ hx h01 h12
    exact s2 (⇑(Limits.pullback.fst u (t ≫ ι))) _ hOopen hs hl
      (wcpa_dj_lcc_cm_fio_chain_short _ Z u hss _ (t ≫ ι)) x₀ x₁ x₂ hx h01 h12
  · intro x hx hGP U hxU
    obtain ⟨x', hx'U, hx'O, hsp, hne⟩ := s3 (⇑(Limits.pullback.fst u (t ≫ ι))) _
      (Limits.pullback.fst u (t ≫ ι)).continuous hs hO hI
      (wcpa_dj_lccg_component_nontrivial u hss _ (t ≫ ι)) x hx hGP (U : Set Z) U.isOpen hxU
    exact ⟨x', hx'U, hx'O, hsp, hne⟩

theorem wcpa_dj_nccw_dims_transfer : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (X X₀ : Scheme.{u}) (v₀ : X₀ ⟶ Spec (.of R)) (f : X ⟶ X₀) (V₀ : X₀.Opens), (∀ x : X₀, v₀ x ≠ IsLocalRing.closedPoint R → x ∈ V₀) → IsFinite (f ∣_ V₀) → (∀ y : X, nccwsuGP y → nccwsuGP (f y)) → nccwsuH1 v₀ → nccwsuH2 v₀ → nccwsuH1 (f ≫ v₀) ∧ nccwsuH2 (f ≫ v₀) :=
by
  intro R _ _ _ X X₀ v₀ f V₀ hV hfin hGP H1 H2
  classical
  haveI := hfin
  have incomp : ∀ {A B : Scheme.{u}} (h : A ⟶ B) [IsIntegralHom h] (a a₁ : A), a ⤳ a₁ →
      h a = h a₁ → a = a₁ := by
    intro A B h _ a a₁ hsp heq
    obtain ⟨U₀, hU, hb, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := h a₁) (U := ⊤) trivial
    have hV : IsAffineOpen (h ⁻¹ᵁ U₀) := hU.preimage h
    have ha₁V : a₁ ∈ h ⁻¹ᵁ U₀ := hb
    have haV : a ∈ h ⁻¹ᵁ U₀ := hsp.mem_open (h ⁻¹ᵁ U₀).isOpen ha₁V
    obtain ⟨p, hp⟩ : a ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact haV
    obtain ⟨p₁, hp₁⟩ : a₁ ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact ha₁V
    have hsp' : p ⤳ p₁ := by
      rw [← hV.fromSpec.isOpenEmbedding.isInducing.specializes_iff, hp, hp₁]; exact hsp
    have hle : p.asIdeal ≤ p₁.asIdeal := (PrimeSpectrum.le_iff_specializes p p₁).mpr hsp'
    have hsq := hU.SpecMap_appLE_fromSpec h hV le_rfl
    rw [Scheme.Hom.appLE_eq_app] at hsq
    have e : (Spec.map (h.app U₀)) p = (Spec.map (h.app U₀)) p₁ := by
      apply hU.fromSpec.isOpenEmbedding.injective
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hsq, Scheme.Hom.comp_apply,
        Scheme.Hom.comp_apply, hp, hp₁, heq]
    have e2 : Ideal.comap (h.app U₀).hom p.asIdeal = Ideal.comap (h.app U₀).hom p₁.asIdeal :=
      congrArg PrimeSpectrum.asIdeal e
    have hint : (h.app U₀).hom.IsIntegral := ((isIntegralHom_iff h).mp inferInstance).2 U₀ hU
    have hpp : p.asIdeal = p₁.asIdeal := by
      by_contra hne
      obtain ⟨x, hx1, hx0⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hle hne)
      letI := (h.app U₀).hom.toAlgebra
      haveI := p.isPrime
      have hxi : IsIntegral Γ(B, U₀) x := hint x
      have := Ideal.under_lt_under_of_integral_mem_sdiff (R := Γ(B, U₀)) hle ⟨hx1, hx0⟩ hxi
      exact (ne_of_lt this) e2
    have : p = p₁ := PrimeSpectrum.ext hpp
    rw [← hp, ← hp₁, this]
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have hstar : ∀ w : (f ⁻¹ᵁ V₀).toScheme, V₀.ι ((f ∣_ V₀) w) = f ((f ⁻¹ᵁ V₀).ι w) :=
    fun w => by rw [pt (morphismRestrict_ι f V₀) w, Scheme.Hom.comp_apply]
  have hlift : ∀ a : X, f a ∈ V₀ → ∃ w : (f ⁻¹ᵁ V₀).toScheme, (f ⁻¹ᵁ V₀).ι w = a := by
    intro a ha
    have h1 : a ∈ f ⁻¹ᵁ V₀ := by rw [Scheme.Hom.mem_preimage]; exact ha
    have : a ∈ Set.range (f ⁻¹ᵁ V₀).ι := by
      rw [Scheme.Opens.range_ι]; exact h1
    exact this
  have hliftV : ∀ y : X₀, y ∈ V₀ → ∃ w : V₀.toScheme, V₀.ι w = y := by
    intro y hy
    have : y ∈ Set.range V₀.ι := by
      rw [Scheme.Opens.range_ι]; exact hy
    exact this
  have hmemV : ∀ w : V₀.toScheme, V₀.ι w ∈ V₀ := by
    intro w
    have : V₀.ι w ∈ Set.range V₀.ι := ⟨w, rfl⟩
    rw [Scheme.Opens.range_ι] at this
    exact this
  have hmemW : ∀ w : (f ⁻¹ᵁ V₀).toScheme, f ((f ⁻¹ᵁ V₀).ι w) ∈ V₀ := by
    intro w
    rw [← hstar]
    exact hmemV _

  have s1 : ∀ a b : X, f a ∈ V₀ → f b ∈ V₀ → a ⤳ b → f a = f b → a = b := by
    intro a b ha hb hab heq
    obtain ⟨wa, hwa⟩ := hlift a ha
    obtain ⟨wb, hwb⟩ := hlift b hb
    have h1 : wa ⤳ wb := by
      rw [← hwa, ← hwb] at hab
      exact ((f ⁻¹ᵁ V₀).ι.isOpenEmbedding.isInducing.specializes_iff).mp hab
    have h2 : (f ∣_ V₀) wa = (f ∣_ V₀) wb := by
      apply V₀.ι.isOpenEmbedding.isEmbedding.injective
      rw [hstar, hstar, hwa, hwb, heq]
    have h3 := incomp (f ∣_ V₀) wa wb h1 h2
    rw [← hwa, ← hwb, h3]

  have s2 : ∀ C : Set X, IsClosed C →
      IsOpen ((V₀ : Set X₀) \ ⇑f '' (C ∩ ⇑f ⁻¹' (V₀ : Set X₀))) := by
    intro C hC
    have hD : IsClosed (⇑(f ∣_ V₀) '' (⇑(f ⁻¹ᵁ V₀).ι ⁻¹' C)) :=
      (f ∣_ V₀).isClosedMap _ (hC.preimage (f ⁻¹ᵁ V₀).ι.continuous)
    have hO : IsOpen (⇑V₀.ι '' (⇑(f ∣_ V₀) '' (⇑(f ⁻¹ᵁ V₀).ι ⁻¹' C))ᶜ) :=
      V₀.ι.isOpenEmbedding.isOpenMap _ hD.isOpen_compl
    convert hO using 1
    ext z
    constructor
    · rintro ⟨hz, hzn⟩
      obtain ⟨w, hw⟩ := hliftV z hz
      refine ⟨w, ?_, hw⟩
      rintro ⟨c, hc, hcw⟩
      apply hzn
      refine ⟨(f ⁻¹ᵁ V₀).ι c, ⟨hc, hmemW c⟩, ?_⟩
      rw [← hstar, hcw, hw]
    · rintro ⟨w, hw, rfl⟩
      refine ⟨hmemV w, ?_⟩
      rintro ⟨c, ⟨hc, hcV⟩, hcz⟩
      obtain ⟨wc, hwc⟩ := hlift c hcV
      apply hw
      refine ⟨wc, ?_, ?_⟩
      · show (f ⁻¹ᵁ V₀).ι wc ∈ C
        rw [hwc]; exact hc
      · apply V₀.ι.isOpenEmbedding.isEmbedding.injective
        rw [hstar, hwc, hcz]

  have s3 : ∀ (a : X) (y : X₀), f a ∈ V₀ → y ∈ V₀ → f a ⤳ y → ∃ b : X, a ⤳ b ∧ f b = y := by
    intro a y ha hy hay
    obtain ⟨wa, hwa⟩ := hlift a ha
    obtain ⟨wy, hwy⟩ := hliftV y hy
    have h1 : (f ∣_ V₀) wa ⤳ wy := by
      rw [← hwa, ← hstar, ← hwy] at hay
      exact (V₀.ι.isOpenEmbedding.isInducing.specializes_iff).mp hay
    have hE : IsClosed (⇑(f ∣_ V₀) '' closure {wa}) := (f ∣_ V₀).isClosedMap _ isClosed_closure
    have h2 : wy ∈ ⇑(f ∣_ V₀) '' closure {wa} := by
      have h3 : closure {(f ∣_ V₀) wa} ⊆ ⇑(f ∣_ V₀) '' closure {wa} :=
        closure_minimal (Set.singleton_subset_iff.mpr ⟨wa, subset_closure rfl, rfl⟩) hE
      exact h3 (specializes_iff_mem_closure.mp h1)
    obtain ⟨wb, hwb, hwbe⟩ := h2
    refine ⟨(f ⁻¹ᵁ V₀).ι wb, ?_, ?_⟩
    · rw [← hwa]
      exact (specializes_iff_mem_closure.mpr hwb).map (f ⁻¹ᵁ V₀).ι.continuous
    · rw [← hstar, hwbe, hwy]

  have s4 : ∀ x x' : X, x ⤳ x' → v₀ (f x') ≠ IsLocalRing.closedPoint R →
      v₀ (f x) ≠ IsLocalRing.closedPoint R := by
    intro x x' hxx' h hx
    apply h
    have h1 := (hxx'.map f.continuous).map v₀.continuous
    rw [hx] at h1
    exact Set.mem_singleton_iff.mp
      (h1.mem_closed (IsLocalRing.isClosed_singleton_closedPoint R) rfl)
  refine ⟨?_, ?_⟩
  ·
    intro x₀ x₁ x₂ hx₂ h01 h12
    rw [Scheme.Hom.comp_apply] at hx₂
    have hx₁ := s4 x₁ x₂ h12 hx₂
    have hx₀ := s4 x₀ x₁ h01 hx₁
    rcases H1 (f x₀) (f x₁) (f x₂) hx₂ (h01.map f.continuous) (h12.map f.continuous) with h | h
    · exact Or.inl (s1 x₀ x₁ (hV _ hx₀) (hV _ hx₁) h01 h)
    · exact Or.inr (s1 x₁ x₂ (hV _ hx₁) (hV _ hx₂) h12 h)
  ·
    intro x hx hGPx U hxU
    rw [Scheme.Hom.comp_apply] at hx
    have hfxV : f x ∈ V₀ := hV _ hx
    have hC : IsClosed (closure {x} ∩ (U : Set X)ᶜ) :=
      isClosed_closure.inter U.isOpen.isClosed_compl
    let O : X₀.Opens := ⟨(V₀ : Set X₀) \ ⇑f '' ((closure {x} ∩ (U : Set X)ᶜ) ∩
      ⇑f ⁻¹' (V₀ : Set X₀)), s2 _ hC⟩
    have hfxO' : f x ∈ (V₀ : Set X₀) \ ⇑f '' ((closure {x} ∩ (U : Set X)ᶜ) ∩
        ⇑f ⁻¹' (V₀ : Set X₀)) := by
      refine ⟨hfxV, ?_⟩
      rintro ⟨c, ⟨⟨hcx, hcU⟩, hcV⟩, hcf⟩
      have hxc : x ⤳ c := specializes_iff_mem_closure.mpr hcx
      have hxc' := s1 x c hfxV hcV hxc hcf.symm
      apply hcU
      rw [← hxc']; exact hxU
    have hfxO : f x ∈ O := hfxO'
    obtain ⟨y, hyO, hyv, hxy, hyne⟩ := H2 (f x) hx (hGP x hGPx) O hfxO
    have hyO' : y ∈ (V₀ : Set X₀) \ ⇑f '' ((closure {x} ∩ (U : Set X)ᶜ) ∩
        ⇑f ⁻¹' (V₀ : Set X₀)) := hyO
    obtain ⟨hyV, hyn⟩ := hyO'
    obtain ⟨b, hxb, hfb⟩ := s3 x y hfxV hyV hxy
    refine ⟨b, ?_, ?_, hxb, ?_⟩
    · by_contra hbU
      apply hyn
      refine ⟨b, ⟨⟨specializes_iff_mem_closure.mp hxb, hbU⟩, ?_⟩, hfb⟩
      show f b ∈ V₀
      rw [hfb]; exact hyV
    · rw [Scheme.Hom.comp_apply, hfb]; exact hyv
    · intro hbx
      apply hyne
      rw [← hfb, hbx]

theorem wcpa_dj_nccw_fibre_dim_translation : nccwsuDimFact.{u} → ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (X : Scheme.{u}) (v : X ⟶ Spec (.of R)), IsProper v → (∀ x : X, IsDomain (X.presheaf.stalk x)) → nccwsuGEN v → nccwsuH1 v → nccwsuH2 v → nccwsuP10 v :=
by
  intro hDim R _ _ _ X v hv hdom hGEN hH1 hH2
  classical
  unfold nccwsuDimFact at hDim

  have hN : TopologicalSpace.NoetherianSpace ↥(⇑v ⁻¹' {IsLocalRing.closedPoint R}) := by
    haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian v
    haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace v
    haveI : AlgebraicGeometry.IsNoetherian X := AlgebraicGeometry.IsNoetherian.mk
    exact TopologicalSpace.NoetherianSpace.set _
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hmax : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
  have hcp : ∀ z : PrimeSpectrum R, z = IsLocalRing.closedPoint R ↔ ϖ ∈ z.asIdeal := by
    intro z
    constructor
    · rintro rfl
      show ϖ ∈ IsLocalRing.maximalIdeal R
      rw [hmax]
      exact Ideal.mem_span_singleton_self ϖ
    · intro h
      apply PrimeSpectrum.ext
      show z.asIdeal = IsLocalRing.maximalIdeal R
      exact le_antisymm (IsLocalRing.le_maximalIdeal z.isPrime.ne_top)
        (by rw [hmax, Ideal.span_singleton_le_iff_mem]; exact h)

  have hchart : ∀ x : X, ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B) (_ : Algebra R B)
      (ρ : PrimeSpectrum B → X) (U : X.Opens), Algebra.FiniteType R B ∧
      (∀ p q : PrimeSpectrum B, p ≤ q ↔ ρ p ⤳ ρ q) ∧
      (∀ p : PrimeSpectrum B, algebraMap R B ϖ ∈ p.asIdeal ↔ v (ρ p) = IsLocalRing.closedPoint R) ∧
      ρ ⊥ ∈ U ∧ (∀ y ∈ U, ρ ⊥ ⤳ y → y ∈ Set.range ρ) ∧
      (∀ y : X, y ⤳ x → y ∈ Set.range ρ) := by
    intro x
    obtain ⟨U, hU, hxU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : X.Opens) from trivial)
    haveI := hU.isOpenImmersion_fromSpec
    let xh : U := ⟨x, hxU⟩
    letI : Algebra Γ(X, U) (X.presheaf.stalk (xh : X)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf xh
    haveI hlocz := hU.isLocalization_stalk xh
    haveI : IsDomain (X.presheaf.stalk (xh : X)) := hdom x
    let Q₀ : Ideal Γ(X, U) := RingHom.ker (algebraMap Γ(X, U) (X.presheaf.stalk (xh : X)))
    haveI hQ₀ : Q₀.IsPrime := RingHom.ker_isPrime _
    let mk := Ideal.Quotient.mk Q₀
    have hmk : Function.Surjective mk := Ideal.Quotient.mk_surjective
    have hker : RingHom.ker mk = Q₀ := Ideal.mk_ker
    obtain ⟨φ', hφ'⟩ : ∃ φ' : CommRingCat.of R ⟶ Γ(X, U), Spec.map φ' = hU.fromSpec ≫ v :=
      ⟨_, Spec.map_preimage _⟩
    have hFTφ : φ'.hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map φ') := by rw [hφ']; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    have hvρ : ∀ a : PrimeSpectrum Γ(X, U), v (hU.fromSpec a) = PrimeSpectrum.comap φ'.hom a := by
      intro a
      have e1 := congrArg (fun f : Spec Γ(X, U) ⟶ Spec (.of R) => f a) hφ'
      exact ((Scheme.Hom.comp_apply hU.fromSpec v a).symm.trans e1.symm).trans (Spec.map_apply _ _)
    have hspec : ∀ a b : PrimeSpectrum Γ(X, U), hU.fromSpec a ⤳ hU.fromSpec b ↔ a ≤ b := by
      intro a b
      exact (hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff).trans
        (PrimeSpectrum.le_iff_specializes a b).symm
    have hmemU : ∀ a, hU.fromSpec a ∈ U := by
      intro a
      rw [← SetLike.mem_coe, ← hU.range_fromSpec]
      exact ⟨a, rfl⟩
    have hcomap_le : ∀ p q : PrimeSpectrum (Γ(X, U) ⧸ Q₀),
        PrimeSpectrum.comap mk p ≤ PrimeSpectrum.comap mk q ↔ p ≤ q := by
      intro p q
      rw [← PrimeSpectrum.asIdeal_le_asIdeal, ← PrimeSpectrum.asIdeal_le_asIdeal,
        PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal]
      constructor
      · intro h
        have := Ideal.map_mono (f := mk) h
        rwa [Ideal.map_comap_of_surjective mk hmk, Ideal.map_comap_of_surjective mk hmk] at this
      · exact fun h => Ideal.comap_mono h
    have hrange' : ∀ a : PrimeSpectrum Γ(X, U), Q₀ ≤ a.asIdeal →
        ∃ p, PrimeSpectrum.comap mk p = a := by
      intro a ha
      haveI := a.isPrime
      refine ⟨⟨Ideal.map mk a.asIdeal, Ideal.map_isPrime_of_surjective hmk (by rw [hker]; exact ha)⟩, ?_⟩
      apply PrimeSpectrum.ext
      rw [PrimeSpectrum.comap_asIdeal]
      show Ideal.comap mk (Ideal.map mk a.asIdeal) = a.asIdeal
      rw [Ideal.comap_map_of_surjective mk hmk, ← RingHom.ker_eq_comap_bot, hker, sup_eq_left.mpr ha]
    have hbot0 : (PrimeSpectrum.comap mk ⊥).asIdeal = Q₀ := by
      rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.asIdeal_bot, ← RingHom.ker_eq_comap_bot, hker]
    letI : Algebra R (Γ(X, U) ⧸ Q₀) := (mk.comp φ'.hom).toAlgebra
    refine ⟨Γ(X, U) ⧸ Q₀, inferInstance, inferInstance, inferInstance,
      fun p => hU.fromSpec (PrimeSpectrum.comap mk p), U, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective mk hmk) hFTφ
    · intro p q
      show p ≤ q ↔ hU.fromSpec (PrimeSpectrum.comap mk p) ⤳ hU.fromSpec (PrimeSpectrum.comap mk q)
      rw [hspec, hcomap_le]
    · intro p
      show mk (φ'.hom ϖ) ∈ p.asIdeal ↔ v (hU.fromSpec (PrimeSpectrum.comap mk p)) = _
      rw [hvρ]
      exact (hcp (PrimeSpectrum.comap φ'.hom (PrimeSpectrum.comap mk p))).symm
    · exact hmemU _
    · intro y hyU hy
      let Py := hU.primeIdealOf ⟨y, hyU⟩
      have hPy : hU.fromSpec Py = y := hU.fromSpec_primeIdealOf ⟨y, hyU⟩
      rw [← hPy] at hy
      have hle : PrimeSpectrum.comap mk ⊥ ≤ Py := (hspec _ _).mp hy
      have hQ : Q₀ ≤ Py.asIdeal := by
        rw [← hbot0]; exact (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr hle
      obtain ⟨p, hp⟩ := hrange' Py hQ
      exact ⟨p, by show hU.fromSpec (PrimeSpectrum.comap mk p) = y; rw [hp, hPy]⟩
    · intro y hy
      have hyU : y ∈ U := hy.mem_open U.isOpen hxU
      let Py := hU.primeIdealOf ⟨y, hyU⟩
      have hPy : hU.fromSpec Py = y := hU.fromSpec_primeIdealOf ⟨y, hyU⟩
      have hPx : hU.fromSpec (hU.primeIdealOf xh) = x := hU.fromSpec_primeIdealOf xh
      have hle : Py ≤ hU.primeIdealOf xh := by
        rw [← hspec, hPy, hPx]; exact hy
      have hle' : Py.asIdeal ≤ (hU.primeIdealOf xh).asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr hle
      have hQ : Q₀ ≤ Py.asIdeal := by
        intro a ha
        have h0 : algebraMap Γ(X, U) (X.presheaf.stalk (xh : X)) a = 0 := ha
        obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff (hU.primeIdealOf xh).asIdeal.primeCompl
          (X.presheaf.stalk (xh : X)) a).mp h0
        have hma : (m : Γ(X, U)) * a ∈ Py.asIdeal := by rw [hm]; exact Py.asIdeal.zero_mem
        exact (Py.isPrime.mem_or_mem hma).resolve_left (fun h => m.2 (hle' h))
      obtain ⟨p, hp⟩ := hrange' Py hQ
      exact ⟨p, by show hU.fromSpec (PrimeSpectrum.comap mk p) = y; rw [hp, hPy]⟩

  have hloc : ∀ x : X,
      (∀ x₀ x₁ : X, v x₀ = IsLocalRing.closedPoint R → x₀ ⤳ x₁ → x₁ ⤳ x → x₀ = x₁ ∨ x₁ = x) ∧
      (IsClosed ({x} : Set X) → v x = IsLocalRing.closedPoint R →
        ∃ x' : X, v x' = IsLocalRing.closedPoint R ∧ x' ⤳ x ∧ x' ≠ x) := by
    intro x
    obtain ⟨B, _, _, _, ρ, U, hFT, hord, hϖB, hbotU, hrng, hgen⟩ := hchart x
    have hinj : Function.Injective ρ := fun p q h =>
      le_antisymm ((hord p q).mpr (h ▸ specializes_rfl)) ((hord q p).mpr (h ▸ specializes_rfl))
    obtain ⟨px, rfl⟩ := hgen x specializes_rfl
    have hb0 : algebraMap R B ϖ ≠ 0 := by
      intro hb
      obtain ⟨x', hx'x, hx'v⟩ := hGEN (ρ px)
      obtain ⟨q, rfl⟩ := hgen x' hx'x
      exact hx'v ((hϖB q).mp (by rw [hb]; exact q.asIdeal.zero_mem))
    have hdim : ringKrullDim (Localization.Away (algebraMap R B ϖ)) = 1 := by
      let g := PrimeSpectrum.comap (algebraMap B (Localization.Away (algebraMap R B ϖ)))
      have hgi : Function.Injective g :=
        PrimeSpectrum.localization_comap_injective _ (Submonoid.powers (algebraMap R B ϖ))
      have hgle : ∀ c d, c ≤ d ↔ g c ≤ g d := by
        intro c d
        rw [PrimeSpectrum.le_iff_specializes, PrimeSpectrum.le_iff_specializes,
          (PrimeSpectrum.localization_comap_isInducing _
            (Submonoid.powers (algebraMap R B ϖ))).specializes_iff]
      have hgb : ∀ c, algebraMap R B ϖ ∉ (g c).asIdeal := by
        intro c hc
        rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at hc
        exact c.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hc
          (IsLocalization.Away.algebraMap_isUnit (algebraMap R B ϖ)))
      have hrg : ∀ p : PrimeSpectrum B, algebraMap R B ϖ ∉ p.asIdeal → ∃ c, g c = p := by
        intro p hp
        have : p ∈ Set.range g := by
          rw [PrimeSpectrum.localization_away_comap_range (Localization.Away (algebraMap R B ϖ))
            (algebraMap R B ϖ)]
          exact hp
        exact this
      apply le_antisymm
      · show Order.krullDim (PrimeSpectrum (Localization.Away (algebraMap R B ϖ))) ≤ 1
        rw [Order.krullDim_le_one_iff]
        intro c
        by_contra hc
        rw [not_or, not_isMin_iff, not_isMax_iff] at hc
        obtain ⟨⟨c₁, h1⟩, ⟨c₂, h2⟩⟩ := hc
        have l1 : g c₁ < g c := lt_of_le_of_ne ((hgle _ _).mp h1.le) (fun e => h1.ne (hgi e))
        have l2 : g c < g c₂ := lt_of_le_of_ne ((hgle _ _).mp h2.le) (fun e => h2.ne (hgi e))
        have hv2 : v (ρ (g c₂)) ≠ IsLocalRing.closedPoint R := fun e => hgb c₂ ((hϖB _).mpr e)
        rcases hH1 _ _ _ hv2 ((hord _ _).mp l1.le) ((hord _ _).mp l2.le) with e | e
        · exact l1.ne (hinj e)
        · exact l2.ne (hinj e)
      · show 1 ≤ Order.krullDim (PrimeSpectrum (Localization.Away (algebraMap R B ϖ)))
        rw [Order.one_le_krullDim_iff]
        have hbot : algebraMap R B ϖ ∉ (⊥ : PrimeSpectrum B).asIdeal := by
          rw [PrimeSpectrum.asIdeal_bot]
          intro h
          exact hb0 (Ideal.mem_bot.mp h)
        have hηv : v (ρ ⊥) ≠ IsLocalRing.closedPoint R := fun e => hbot ((hϖB _).mpr e)
        have hηgp : nccwsuGP (ρ ⊥) := by
          intro y hy
          have hyx : y ⤳ ρ px := hy.trans ((hord ⊥ px).mp bot_le)
          obtain ⟨q, rfl⟩ := hgen y hyx
          have : q ≤ ⊥ := (hord q ⊥).mpr hy
          rw [le_bot_iff.mp this]
        obtain ⟨x', hx'U, hx'v, hηx', hx'ne⟩ := hH2 (ρ ⊥) hηv hηgp U hbotU
        obtain ⟨q, rfl⟩ := hrng x' hx'U hηx'
        have hq : algebraMap R B ϖ ∉ q.asIdeal := fun h => hx'v ((hϖB q).mp h)
        have hqne : q ≠ ⊥ := fun h => hx'ne (by rw [h])
        obtain ⟨c₀, hc₀⟩ := hrg ⊥ hbot
        obtain ⟨c₁, hc₁⟩ := hrg q hq
        refine ⟨c₀, c₁, lt_of_le_of_ne ((hgle _ _).mpr (by rw [hc₀, hc₁]; exact bot_le)) ?_⟩
        intro e
        apply hqne
        rw [← hc₁, ← e, hc₀]
    obtain ⟨hch, hmin⟩ := hDim R ϖ hϖ B hFT hb0 hdim
    refine ⟨fun x₀ x₁ hv0 h01 h1x => ?_, fun hcl hvx => ?_⟩
    · obtain ⟨p₀, rfl⟩ := hgen x₀ (h01.trans h1x)
      obtain ⟨p₁, rfl⟩ := hgen x₁ h1x
      have hb : algebraMap R B ϖ ∈ p₀.asIdeal := (hϖB p₀).mpr hv0
      rcases hch p₀.asIdeal p₁.asIdeal px.asIdeal p₀.isPrime p₁.isPrime px.isPrime hb
        ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr ((hord _ _).mpr h01))
        ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr ((hord _ _).mpr h1x)) with e | e
      · left; rw [PrimeSpectrum.ext e]
      · right; rw [PrimeSpectrum.ext e]
    · by_contra hne
      push_neg at hne
      have hb : algebraMap R B ϖ ∈ px.asIdeal := (hϖB px).mpr hvx
      have hmaxl : px.asIdeal.IsMaximal := by
        obtain ⟨m, hm, hpm⟩ := Ideal.exists_le_maximal px.asIdeal px.isPrime.ne_top
        have hsp : ρ px ⤳ ρ ⟨m, hm.isPrime⟩ :=
          (hord _ _).mp ((PrimeSpectrum.asIdeal_le_asIdeal px ⟨m, hm.isPrime⟩).mp hpm)
        have h1 : ρ ⟨m, hm.isPrime⟩ = ρ px := hsp.mem_closed hcl (Set.mem_singleton _)
        have e : m = px.asIdeal := congrArg PrimeSpectrum.asIdeal (hinj h1)
        rw [← e]
        exact hm
      have hminP : px.asIdeal ∈ (Ideal.span {algebraMap R B ϖ}).minimalPrimes := by
        show (px.asIdeal.IsPrime ∧ Ideal.span {algebraMap R B ϖ} ≤ px.asIdeal) ∧
          ∀ ⦃q : Ideal B⦄, (q.IsPrime ∧ Ideal.span {algebraMap R B ϖ} ≤ q) →
            q ≤ px.asIdeal → px.asIdeal ≤ q
        refine ⟨⟨px.isPrime, (Ideal.span_singleton_le_iff_mem _).mpr hb⟩, ?_⟩
        rintro q ⟨hqp, hqb⟩ hqle
        have hbq : algebraMap R B ϖ ∈ q := (Ideal.span_singleton_le_iff_mem _).mp hqb
        have h1 : ρ ⟨q, hqp⟩ ⤳ ρ px :=
          (hord _ _).mp ((PrimeSpectrum.asIdeal_le_asIdeal ⟨q, hqp⟩ px).mp hqle)
        have h2 : v (ρ ⟨q, hqp⟩) = IsLocalRing.closedPoint R := (hϖB _).mp hbq
        have e : q = px.asIdeal := congrArg PrimeSpectrum.asIdeal (hinj (hne _ h2 h1))
        exact le_of_eq e.symm
      exact hmin _ hminP hmaxl

  have hXs : IsClosed (⇑v ⁻¹' {IsLocalRing.closedPoint R}) :=
    (IsLocalRing.isClosed_singleton_closedPoint R).preimage v.continuous
  have F1 : ∀ x₀ x₁ x₂ : X, x₀ ∈ ⇑v ⁻¹' {IsLocalRing.closedPoint R} → x₀ ⤳ x₁ → x₁ ⤳ x₂ →
      x₀ = x₁ ∨ x₁ = x₂ :=
    fun x₀ x₁ x₂ h0 h01 h12 => (hloc x₂).1 x₀ x₁ h0 h01 h12
  have F2 : ∀ x ∈ ⇑v ⁻¹' {IsLocalRing.closedPoint R}, IsClosed ({x} : Set X) →
      ∃ x' ∈ ⇑v ⁻¹' {IsLocalRing.closedPoint R}, x' ⤳ x ∧ x' ≠ x := by
    intro x hx hcl
    obtain ⟨x', h1, h2, h3⟩ := (hloc x).2 hcl hx
    exact ⟨x', h1, h2, h3⟩
  refine ⟨hN, ?_, ?_⟩
  · intro L hLcl hLirr hLs hLnt L' hL'irr hLL' hL's
    obtain ⟨x, hx⟩ := QuasiSober.sober hLirr hLcl
    obtain ⟨x', hx'⟩ := QuasiSober.sober hL'irr.closure isClosed_closure
    have hx's : x' ∈ ⇑v ⁻¹' {IsLocalRing.closedPoint R} := closure_minimal hL's hXs hx'.mem
    have hx'x : x' ⤳ x := hx'.specializes (subset_closure (hLL' hx.mem))
    obtain ⟨y, hyL, hyx⟩ := hLnt.exists_ne x
    have hxy : x ⤳ y := hx.specializes hyL
    rcases F1 x' x y hx's hx'x hxy with e | e
    · have hc : closure L' = L := by rw [← hx'.def, e, hx.def]
      refine Set.Subset.antisymm ?_ hLL'
      rw [← hc]
      exact subset_closure
    · exact absurd e.symm hyx
  · intro L hLcl hLirr hLs hmaxL
    by_contra hnt
    rw [Set.not_nontrivial_iff] at hnt
    obtain ⟨x, hxL⟩ := hLirr.nonempty
    have hLx : L = {x} := hnt.eq_singleton_of_mem hxL
    have hxcl : IsClosed ({x} : Set X) := by rw [← hLx]; exact hLcl
    obtain ⟨x', hx's, hx'x, hne⟩ := F2 x (hLs hxL) hxcl
    have hsub : L ⊆ closure {x'} := by
      rw [hLx]
      exact Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp hx'x)
    have hc := hmaxL (closure {x'}) isIrreducible_singleton.closure hsub
      (closure_minimal (Set.singleton_subset_iff.mpr hx's) hXs)
    have hx'L : x' ∈ L := by rw [← hc]; exact subset_closure (Set.mem_singleton x')
    rw [hLx] at hx'L
    exact hne hx'L

theorem wcpa_dj_nccw_smooth_generic_transfer : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (X Y : Scheme.{u}) (v : X ⟶ Spec (.of R)) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ X), IsPullback a π v (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) → ∀ t : Y, nccwSm v (a t) ↔ ∃ W : Y.Opens, t ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ π) :=
by
  intro R _ _ _ X Y v π a hpb t
  haveI hK : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := by
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have inj : Function.Injective (algebraMap R (FractionRing R)) :=
      IsFractionRing.injective R (FractionRing R)
    have hϖ0 : algebraMap R (FractionRing R) ϖ ≠ 0 := by
      intro h
      exact hϖ.ne_zero (inj (h.trans (map_zero _).symm))
    haveI : IsLocalization.Away ϖ (FractionRing R) := by
      refine IsLocalization.Away.mk ϖ (IsUnit.mk0 _ hϖ0) ?_ ?_
      · intro s
        obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := R) s
        have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
        obtain ⟨n, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hϖ
        refine ⟨n, a * ↑v⁻¹, ?_⟩
        have hv : algebraMap R (FractionRing R) (↑v) * algebraMap R (FractionRing R) (↑v⁻¹) = 1 := by
          rw [← map_mul, Units.mul_inv, map_one]
        have hv0 : algebraMap R (FractionRing R) (↑v) ≠ 0 := by
          intro h; rw [h, zero_mul] at hv; exact zero_ne_one hv
        have hpn : algebraMap R (FractionRing R) ϖ ^ n ≠ 0 := pow_ne_zero _ hϖ0
        rw [map_mul, map_mul, map_pow]
        field_simp
        linear_combination -(algebraMap R (FractionRing R) a) * hv
      · intro a b h
        exact ⟨0, by rw [pow_zero, one_mul, one_mul]; exact inj h⟩
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization ϖ
  haveI ha : IsOpenImmersion a :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip hK
  unfold nccwSm
  constructor
  · rintro ⟨W, hW, hsm⟩
    refine ⟨a ⁻¹ᵁ W, (Scheme.Hom.mem_preimage a).2 hW, ?_⟩
    have h1 : IsPullback (a ∣_ W) (a ⁻¹ᵁ W).ι W.ι a := isPullback_morphismRestrict a W
    have h2 : IsPullback (a ∣_ W) ((a ⁻¹ᵁ W).ι ≫ π) (W.ι ≫ v)
        (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := h1.paste_vert hpb
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hsm
  · rintro ⟨W, hW, hsm⟩
    haveI := hsm
    refine ⟨(W.ι ≫ a).opensRange, ?_, ?_⟩
    · show a t ∈ ((W.ι ≫ a).opensRange : Set X)
      rw [Scheme.Hom.coe_opensRange]
      have hx : t ∈ Set.range W.ι := by rw [Scheme.Opens.range_ι]; exact hW
      obtain ⟨x, hx⟩ := hx
      exact ⟨x, by rw [Scheme.Hom.comp_apply, hx]⟩
    · have heq : (W.ι ≫ a).opensRange.ι ≫ v = (W.ι ≫ a).isoOpensRange.inv ≫ (W.ι ≫ π) ≫
          Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) := by
        symm
        rw [Category.assoc, ← hpb.w, ← Category.assoc W.ι a v, Iso.inv_comp_eq,
          ← Category.assoc, Scheme.Hom.isoOpensRange_hom_ι]
      rw [heq]
      have : SmoothOfRelativeDimension (0 + (1 + 0)) ((W.ι ≫ a).isoOpensRange.inv ≫ (W.ι ≫ π) ≫
          Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := inferInstance
      exact this

theorem wcpa_dj_nccw_setup : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G), IsAdicComplete (IsLocalRing.maximalIdeal R) R → IsAlgClosed (IsLocalRing.ResidueField R) → nccwProps.{u} → nccwH R u u' τ τ' π a a' h ι j γ γ' → ∃ (S S' N : Scheme.{u}) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwSetup R u u' τ τ' ι γ' ν ν' μ q q' st zk η₀ η ηZ :=
by
  intro R _ _ _ Z Z' Y G u u' n τ τ' π a a' h ι j γ γ' hcomp halg hPr hH
  classical
  obtain ⟨hn, hst, hst', hgc, hgc', hpb, hpb', hsec, hι, hGr, hj, hjd, hjι, hjr, hγ, hne, hp,
    hu, hz, hmax⟩ := id hH
  have hNag : wcpaDjNccNagata.{u} := hPr.2.2.2.2.1
  have hGI : wcpaDjNcGenIso.{u} := hPr.2.2.2.1
  haveI hup : IsProper u := hst.1.2.1
  haveI hup' : IsProper u' := hst'.1.2.1
  haveI := hι
  have pt : ∀ {A B C : Scheme.{u}} {f : A ⟶ B} {g : B ⟶ C} {k : A ⟶ C}, f ≫ g = k →
      ∀ x, g (f x) = k x := by
    intro A B C f g k hk x
    rw [← Scheme.Hom.comp_apply, hk]
  have hcondpt : ∀ g : ↥(Limits.pullback u u'),
      u (Limits.pullback.fst u u' g) = u' (Limits.pullback.snd u u' g) := fun g =>
    (pt (Limits.pullback.condition (f := u) (g := u')) g).trans (Scheme.Hom.comp_apply _ _ _)

  obtain ⟨N, μ, hμfin, hμsurj, hNnds, hμNL, hNgen, hBir, hBir'⟩ :=
    wcpa_dj_nccw_graph_normalization R Z Z' Y G u u' n τ τ' π a a' h ι j γ γ' hcomp hPr hH
  haveI := hμfin
  haveI := hμsurj
  have hgen1 : nccwsuGEN ((μ ≫ ι ≫ Limits.pullback.fst u u') ≫ u) := by
    simpa only [Category.assoc] using hNgen
  have hcond : (μ ≫ ι ≫ Limits.pullback.snd u u') ≫ u' =
      μ ≫ ι ≫ Limits.pullback.fst u u' ≫ u := by
    simp only [Category.assoc, Limits.pullback.condition]
  have hgen2 : nccwsuGEN ((μ ≫ ι ≫ Limits.pullback.snd u u') ≫ u') := by
    rw [hcond]; exact hNgen

  obtain ⟨S, ν, q, hq1, hνfin, hνsurj, hSnds, hνNL, hqprop, hSgen, hνGP, hqiso⟩ :=
    wcpa_dj_nccw_rel_normalization R hcomp hNag N Z u (μ ≫ ι ≫ Limits.pullback.fst u u') hup
      inferInstance hNnds hgen1 hBir
  obtain ⟨S', ν', q', hq1', hνfin', hνsurj', hS'nds, hνNL', hqprop', hS'gen, hνGP', hqiso'⟩ :=
    wcpa_dj_nccw_rel_normalization R hcomp hNag N Z' u' (μ ≫ ι ≫ Limits.pullback.snd u u') hup'
      inferInstance hNnds hgen2 hBir'
  haveI := hνfin
  haveI := hνfin'
  haveI := hqprop
  haveI := hqprop'
  have hνpt : ∀ y : N, ν (q y) = Limits.pullback.fst u u' (ι (μ y)) := fun y => by
    rw [pt hq1 y, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
  have hνpt' : ∀ y : N, ν' (q' y) = Limits.pullback.snd u u' (ι (μ y)) := fun y => by
    rw [pt hq1' y, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
  have huN0 : ∀ y : N, (q ≫ ν ≫ u) y = u (Limits.pullback.fst u u' (ι (μ y))) := fun y => by
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hνpt]
  have hcomp_eq : q ≫ ν ≫ u = μ ≫ ι ≫ Limits.pullback.fst u u' ≫ u := by
    rw [show μ ≫ ι ≫ Limits.pullback.fst u u' ≫ u = (μ ≫ ι ≫ Limits.pullback.fst u u') ≫ u by
      simp only [Category.assoc], ← hq1, Category.assoc]
  have hNgen' : nccwsuGEN (q ≫ ν ≫ u) := by rw [hcomp_eq]; exact hNgen

  have gen8 : ∀ {X S₁ : Scheme.{u}} (w : X ⟶ Spec (.of R)) (p : G ⟶ X) (ν₁ : S₁ ⟶ X)
      (q₁ : N ⟶ S₁), wcpaDjSemistable w → (∀ y : N, (q ≫ ν ≫ u) y = w (p (μ y))) →
      (∀ y : N, ν₁ (q₁ y) = p (μ y)) → IsClosedMap ⇑(μ ≫ p) → nccwsuNL ν₁ →
      (∀ V : X.Opens, IsFinite ((μ ≫ p) ∣_ V) → IsIso (q₁ ∣_ ν₁ ⁻¹ᵁ V)) →
      (∀ ξ : X, nccwsuMaxS w ξ → ∃ W : X.Opens, ξ ∈ W ∧ IsIso (p ∣_ W)) →
      ∀ ξ : X, nccwsuMaxS w ξ → ∃ y : N, nccwsuPt (q ≫ ν ≫ u) ν₁ q₁ ξ y ∧
        ∀ g : G, p g = ξ → g = μ y := by
    intro X S₁ w p ν₁ q₁ hwss huN hνq hcl hNL1 hiso1 hgi ξ hξ
    obtain ⟨hdom, hic, hncl⟩ := wcpa_dj_nccw_max_point_dvr R halg X w hwss ξ hξ
    obtain ⟨W, hξW, hWiso⟩ := hgi ξ hξ
    haveI := hWiso
    obtain ⟨e, he⟩ : ∃ e : W.toScheme ⟶ G, e = inv (p ∣_ W) ≫ (p ⁻¹ᵁ W).ι := ⟨_, rfl⟩
    haveI : IsOpenImmersion e := by rw [he]; infer_instance
    have hep : e ≫ p = W.ι := by
      rw [he, Category.assoc, ← morphismRestrict_ι, IsIso.inv_hom_id_assoc]
    obtain ⟨x0, hx0⟩ : ∃ x0 : W.toScheme, W.ι x0 = ξ := ⟨⟨ξ, hξW⟩, rfl⟩
    have hpγ : p (e x0) = ξ := by
      rw [pt hep, hx0]
    have huniq : ∀ g : G, p g = ξ → g = e x0 := by
      intro g hg
      have hgr : g ∈ Set.range (p ⁻¹ᵁ W).ι := by
        rw [Scheme.Opens.range_ι]
        show g ∈ p ⁻¹ᵁ W
        rw [Scheme.Hom.mem_preimage, hg]; exact hξW
      obtain ⟨g1, hg1⟩ := hgr
      have h1 : (p ∣_ W) g1 = x0 := by
        apply W.ι.isOpenEmbedding.injective
        rw [pt (morphismRestrict_ι p W), Scheme.Hom.comp_apply, hg1, hg, hx0]
      have h2 : inv (p ∣_ W) x0 = g1 := by
        rw [← h1]
        exact pt (IsIso.hom_inv_id (p ∣_ W)) _
      rw [he, Scheme.Hom.comp_apply, h2, hg1]
    haveI hdomW : IsDomain (X.presheaf.stalk (W.ι x0)) := by
      rw [hx0]; exact hdom
    haveI hicW : IsIntegrallyClosed (X.presheaf.stalk (W.ι x0)) := by
      rw [hx0]; exact hic
    have eW : X.presheaf.stalk (W.ι x0) ≃+* W.toScheme.presheaf.stalk x0 :=
      (asIso (W.ι.stalkMap x0)).commRingCatIsoToRingEquiv
    have eG : G.presheaf.stalk (e x0) ≃+* W.toScheme.presheaf.stalk x0 :=
      (asIso (e.stalkMap x0)).commRingCatIsoToRingEquiv
    have eGX : G.presheaf.stalk (e x0) ≃+* X.presheaf.stalk (W.ι x0) :=
      eG.trans eW.symm
    have hdomG : IsDomain (G.presheaf.stalk (e x0)) := MulEquiv.isDomain _ eGX.toMulEquiv
    have hicG : IsIntegrallyClosed (G.presheaf.stalk (e x0)) :=
      IsIntegrallyClosed.of_equiv eGX.symm
    obtain ⟨y, hy, -⟩ := hμNL (e x0) hdomG hicG
    have hμy : μ y = e x0 := (hy y).mpr rfl
    have hfib : ∀ y' : N, p (μ y') = ξ → y' = y := fun y' h' => (hy y').mp (huniq _ h')
    refine ⟨y, ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, fun g hg => (huniq g hg).trans hμy.symm⟩
    · rw [huN, hμy, hpγ]; exact hξ.1
    · rw [hνq, hμy, hpγ]
    · intro y' hy'1 hy'2
      apply hfib
      have hsp : p (μ y') ⤳ p (μ y) := by
        have := hy'2.map (μ ≫ p).continuous
        simpa only [Scheme.Hom.comp_apply] using this
      rw [hμy, hpγ] at hsp
      exact hξ.2 _ (by rw [← huN]; exact hy'1) hsp
    · intro y' _ _ hy'3
      apply hfib
      rw [← hνq]; exact hy'3
    · intro w' hw'
      obtain ⟨w0, hw0, -⟩ := hNL1 ξ hdom hic
      have e1 : q₁ y = w0 := (hw0 _).mp (by rw [hνq, hμy, hpγ])
      rw [(hw0 w').mp hw', e1]
    · refine ⟨ν₁ ⁻¹ᵁ W, ?_, ?_⟩
      · rw [Scheme.Hom.mem_preimage, hνq, hμy, hpγ]; exact hξW
      · apply hiso1
        rw [morphismRestrict_comp]
        haveI h1 : IsFinite (μ ∣_ p ⁻¹ᵁ W) := inferInstance
        haveI h2 : IsFinite (p ∣_ W) := inferInstance
        exact MorphismProperty.comp_mem (@AlgebraicGeometry.IsFinite) _ _ h1 h2
    · refine closure_minimal (Set.singleton_subset_iff.mpr ?_) ?_
      · show (q ≫ ν ≫ u) y = IsLocalRing.closedPoint R
        rw [huN, hμy, hpγ]; exact hξ.1
      · exact (IsLocalRing.isClosed_singleton_closedPoint R).preimage (q ≫ ν ≫ u).continuous
    · have hnt : ∃ x1 ∈ closure ({ξ} : Set X), x1 ≠ ξ := by
        by_contra hc
        push_neg at hc
        apply hncl
        have hcl1 : closure ({ξ} : Set X) = {ξ} :=
          Set.eq_singleton_iff_unique_mem.mpr ⟨subset_closure (Set.mem_singleton ξ), hc⟩
        rw [← hcl1]; exact isClosed_closure
      obtain ⟨x1, hx1, hx1ne⟩ := hnt
      have hclim : IsClosed (⇑(μ ≫ p) '' closure {y}) := hcl _ isClosed_closure
      have hξim : ξ ∈ ⇑(μ ≫ p) '' closure {y} :=
        ⟨y, subset_closure (Set.mem_singleton y), by rw [Scheme.Hom.comp_apply, hμy, hpγ]⟩
      have hx1im : x1 ∈ ⇑(μ ≫ p) '' closure {y} :=
        closure_minimal (Set.singleton_subset_iff.mpr hξim) hclim hx1
      obtain ⟨y1, hy1, hy1x⟩ := hx1im
      refine ⟨y, subset_closure (Set.mem_singleton y), y1, hy1, fun e' => hx1ne ?_⟩
      rw [← hy1x, ← e', Scheme.Hom.comp_apply, hμy, hpγ]

  obtain ⟨y0, -⟩ := μ.surjective γ
  have hηex : ∀ ξ : Z', ∃ y : N, nccwsuMaxS u' ξ →
      nccwsuPt (q ≫ ν ≫ u) ν' q' ξ y ∧
        ∀ g : G, (ι ≫ Limits.pullback.snd u u') g = ξ → g = μ y := by
    intro ξ
    by_cases hξ : nccwsuMaxS u' ξ
    · obtain ⟨y, hy⟩ := gen8 u' (ι ≫ Limits.pullback.snd u u') ν' q' hst'.1
        (fun y => by rw [huN0, hcondpt, Scheme.Hom.comp_apply])
        (fun y => (hνpt' y).trans (Scheme.Hom.comp_apply _ _ _).symm)
        (μ ≫ ι ≫ Limits.pullback.snd u u').isClosedMap hνNL' hqiso'
        (fun ξ hξ => hGI R Z Z' u u' hst.1 hst'.1 Y π a a' h hpb hpb' G ι j hι hGr hj hjd hjι
          hjr ξ hξ.1 hξ.2) ξ hξ
      exact ⟨y, fun _ => hy⟩
    · exact ⟨y0, fun h' => absurd h' hξ⟩
  choose η hη using hηex
  have hηZex : ∀ ξ : Z, ∃ y : N, nccwsuMaxS u ξ →
      nccwsuPt (q ≫ ν ≫ u) ν q ξ y ∧
        ∀ g : G, (ι ≫ Limits.pullback.fst u u') g = ξ → g = μ y := by
    intro ξ
    by_cases hξ : nccwsuMaxS u ξ
    · obtain ⟨y, hy⟩ := gen8 u (ι ≫ Limits.pullback.fst u u') ν q hst.1
        (fun y => by rw [huN0, Scheme.Hom.comp_apply])
        (fun y => (hνpt y).trans (Scheme.Hom.comp_apply _ _ _).symm)
        (μ ≫ ι ≫ Limits.pullback.fst u u').isClosedMap hνNL hqiso
        (wcpa_dj_nccw_geniso_swap hPr R Z Z' Y G u u' n τ τ' π a a' h ι j γ γ' hH) ξ hξ
      exact ⟨y, fun _ => hy⟩
    · exact ⟨y0, fun h' => absurd h' hξ⟩
  choose ηZ hηZ using hηZex

  have hξ'max : nccwsuMaxS u' ((ι ≫ Limits.pullback.snd u u') γ') := by
    refine ⟨?_, hmax⟩
    have hp2 := hp
    have hu2 := hu
    simp only [Scheme.Hom.comp_apply] at hp2 hu2 ⊢
    rw [← hcondpt, hp2, hu2]
  obtain ⟨hPt0, hγ'0⟩ := hη _ hξ'max
  set η₀ := η ((ι ≫ Limits.pullback.snd u u') γ') with hη₀def
  have hμη₀ : μ η₀ = γ' := (hγ'0 γ' rfl).symm

  have hsec' := wcpa_dj_nccw_section_lift R Z Z' Y G u u' n τ τ' π a a' h ι j γ γ' hH N μ
    hμfin hμNL
  choose st hst1 hst2 using hsec'

  obtain ⟨hZ1, hZ2⟩ := wcpa_dj_nccw_generic_curve_dims R Z u hst.1
  obtain ⟨hZ'1, hZ'2⟩ := wcpa_dj_nccw_generic_curve_dims R Z' u' hst'.1
  obtain ⟨-, ⟨V₀, hV₀, hV₀fin⟩, hBirGP, -⟩ := hBir
  obtain ⟨-, ⟨V₀', hV₀', hV₀fin'⟩, -, -⟩ := hBir'
  have hV₀mem : ∀ x : Z, u x ≠ IsLocalRing.closedPoint R → x ∈ V₀ := fun x hx => by
    have : x ∈ (V₀ : Set Z) := by rw [hV₀]; exact hx
    exact this
  have hV₀mem' : ∀ x : Z', u' x ≠ IsLocalRing.closedPoint R → x ∈ V₀' := fun x hx => by
    have : x ∈ (V₀' : Set Z') := by rw [hV₀']; exact hx
    exact this
  obtain ⟨hN1, hN2⟩ := wcpa_dj_nccw_dims_transfer R N Z u (q ≫ ν) V₀ hV₀mem
    (by rw [hq1]; exact hV₀fin) (fun y hy => by rw [hq1]; exact hBirGP y hy) hZ1 hZ2
  have hN1' : nccwsuH1 (q ≫ ν ≫ u) := by simpa only [Category.assoc] using hN1
  have hN2' : nccwsuH2 (q ≫ ν ≫ u) := by simpa only [Category.assoc] using hN2
  obtain ⟨hS1, hS2⟩ := wcpa_dj_nccw_dims_transfer R S Z u ν ⊤ (fun x _ => by simp)
    inferInstance hνGP hZ1 hZ2
  obtain ⟨hS'1, hS'2⟩ := wcpa_dj_nccw_dims_transfer R S' Z' u' ν' ⊤ (fun x _ => by simp)
    inferInstance hνGP' hZ'1 hZ'2
  have hDim := wcpa_dj_nccw_flat_fibre_dims
  obtain ⟨hNnoeth, hNa, hNb⟩ := wcpa_dj_nccw_fibre_dim_translation hDim R N (q ≫ ν ≫ u)
    inferInstance (fun x => (hNnds x).1) hNgen' hN1' hN2'
  obtain ⟨hSnoeth, hSa, hSb⟩ := wcpa_dj_nccw_fibre_dim_translation hDim R S (ν ≫ u)
    inferInstance (fun x => (hSnds x).1) hSgen hS1 hS2
  obtain ⟨hS'noeth, -, -⟩ := wcpa_dj_nccw_fibre_dim_translation hDim R S' (ν' ≫ u')
    inferInstance (fun x => (hS'nds x).1) hS'gen hS'1 hS'2

  have e1 : j ≫ ι ≫ Limits.pullback.fst u u' = a := by
    rw [← Category.assoc, hjι, Limits.pullback.lift_fst]
  have e2 : j ≫ ι ≫ Limits.pullback.snd u u' = a' := by
    rw [← Category.assoc, hjι, Limits.pullback.lift_snd]
  have haj : ∀ t : Y, Limits.pullback.fst u u' (ι (j t)) = a t := fun t => by
    rw [← pt e1 t, Scheme.Hom.comp_apply]
  have haj' : ∀ t : Y, Limits.pullback.snd u u' (ι (j t)) = a' t := fun t => by
    rw [← pt e2 t, Scheme.Hom.comp_apply]

  refine ⟨S, S', N, ν, ν', μ, q, q', st, q η₀, η₀, η, ηZ, ?_⟩
  unfold nccwSetup
  refine ⟨⟨hq1, hq1'⟩, ⟨hνfin, hνfin', hμfin, hνsurj, hνsurj', hμsurj⟩, ⟨hSnds, hS'nds, hNnds⟩,
    ⟨wcpa_dj_nccw_flat_of_domain_generic R S (ν ≫ u) (fun x => (hSnds x).1) hSgen,
      inferInstance,
      wcpa_dj_nccw_flat_of_domain_generic R S' (ν' ≫ u') (fun x => (hS'nds x).1) hS'gen,
      inferInstance,
      wcpa_dj_nccw_flat_of_domain_generic R N (q ≫ ν ≫ u) (fun x => (hNnds x).1) hNgen',
      inferInstance⟩,
    ⟨hqprop, hqprop'⟩, ⟨⟨ν ⁻¹ᵁ V₀, ?_, hqiso V₀ hV₀fin⟩, ⟨ν' ⁻¹ᵁ V₀', ?_, hqiso' V₀' hV₀fin'⟩⟩,
    ⟨?_, hPt0.1, hPt0.2.2.1, ?_, hPt0.2.1⟩,
    fun ξ h1 h2 => (hη ξ ⟨h1, h2⟩).1, fun ξ h1 h2 => (hηZ ξ ⟨h1, h2⟩).1,
    fun i => ⟨by rw [hq1]; exact hst1 i, by rw [hq1']; exact hst2 i⟩,
    ⟨hNnoeth, hSnoeth, hS'noeth, hNa, hNb, hSa, hSb⟩, ?_, ⟨hνNL', hνNL⟩⟩
  · intro s hs
    rw [Scheme.Hom.mem_preimage]
    exact hV₀mem _ (by rwa [Scheme.Hom.comp_apply] at hs)
  · intro s hs
    rw [Scheme.Hom.mem_preimage]
    exact hV₀mem' _ (by rwa [Scheme.Hom.comp_apply] at hs)
  · rw [hνpt, hμη₀, Scheme.Hom.comp_apply]
  · intro y hy
    haveI : IsIntegralHom ν := inferInstance
    have hsp : q η₀ ⤳ q y := hy.map q.continuous
    have hsp2 : ν (q η₀) ⤳ ν (q y) := hsp.map ν.continuous
    have hzc : ν (q η₀) = (ι ≫ Limits.pullback.fst u u') γ := by
      rw [hνpt, hμη₀, ← hp, Scheme.Hom.comp_apply]
    have hq : ν (q y) = ν (q η₀) := by
      rw [hzc] at hsp2 ⊢
      exact Set.mem_singleton_iff.mp (hsp2.mem_closed hz (Set.mem_singleton _))
    exact (wcpa_dj_lr1k_gs_integral_incomparable ν (q η₀) (q y) hsp hq.symm).symm
  · intro y hy
    have hy' : u ((ι ≫ Limits.pullback.fst u u') (μ y)) ≠ IsLocalRing.closedPoint R := by
      rw [Scheme.Hom.comp_apply, ← huN0]; exact hy
    obtain ⟨t, ht⟩ := wcpa_dj_ldx_ncds_generic_in_range R Z Z' u u' inferInstance Y π a a' h hpb
      G ι j hι hjd hjι (μ y) hy'
    have hA : ν (q y) = a t := by rw [hνpt, ← ht, haj]
    have hA' : ν' (q' y) = a' t := by rw [hνpt', ← ht, haj']
    rw [hA, hA']
    exact (wcpa_dj_nccw_smooth_generic_transfer R Z Y u π a hpb t).trans
      (wcpa_dj_nccw_smooth_generic_transfer R Z' Y u' π a' hpb' t).symm

theorem wcpa_dj_nccw_eb_sections : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → (nccwEbExS u ν q st zk).Finite ∧ (nccwEbExS u ν q st zk).ncard ≤ 1 ∧ (¬ nccwSm u (ν zk) → nccwEbExS u ν q st zk = ∅) :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA
  classical
  obtain ⟨-, -, -, hH, hS⟩ := hA
  obtain ⟨-, hst, -⟩ := hH
  have hup : IsProper u := hst.1.2.1
  obtain ⟨hsec1, hsec2, hsec3⟩ := hst.2.1
  have hνfin : IsFinite ν := hS.2.1.1
  have hqp : IsProper q := hS.2.2.2.2.1.1
  have hstτ : ∀ i, st i ≫ q ≫ ν = τ i := fun i => (hS.2.2.2.2.2.2.2.2.2.1 i).1

  have hsecN : ∀ i, st i ≫ q ≫ ν ≫ u = 𝟙 _ := by
    intro i
    calc st i ≫ q ≫ ν ≫ u = (st i ≫ q ≫ ν) ≫ u := by simp only [Category.assoc]
      _ = 𝟙 _ := by rw [hstτ i, hsec1 i]

  have hrange : ∀ i, IsClosed (Set.range ⇑(st i)) := by
    intro i
    haveI := hup
    haveI := hνfin
    haveI := hqp
    haveI : IsClosedImmersion (st i ≫ q ≫ ν ≫ u) := by rw [hsecN i]; infer_instance
    haveI : IsClosedImmersion (st i) := IsClosedImmersion.of_comp (st i) (q ≫ ν ≫ u)
    exact (st i).isClosedEmbedding.isClosed_range

  have gen_unique : ∀ p₀ : Spec (.of R), p₀ ≠ IsLocalRing.closedPoint R → p₀.asIdeal = ⊥ := by
    intro p₀ hp₀
    by_contra hne
    apply hp₀
    have hmax : p₀.asIdeal.IsMaximal := Ideal.IsPrime.isMaximal p₀.isPrime hne
    exact PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)

  have key : ∀ p ∈ nccwEbExS u ν q st zk, ∀ (i : Fin n) (p₀ : Spec (.of R)),
      p.1 = closure {st i p₀} → p.2 = st i (u (ν zk)) ∧ τ i (u (ν zk)) = ν zk := by
    intro p hp i p₀ hJ
    obtain ⟨⟨-, hgJ, hgq⟩, -⟩ := hp
    have hqg : q p.2 = zk := hgq
    have hg : p.2 ∈ closure {st i p₀} := by rw [← hJ]; exact hgJ
    have hsub : closure {st i p₀} ⊆ Set.range ⇑(st i) :=
      closure_minimal (Set.singleton_subset_iff.mpr ⟨p₀, rfl⟩) (hrange i)
    obtain ⟨r, hr⟩ := hsub hg
    have hr2 : r = u (ν zk) := by
      have e1 : (st i ≫ q ≫ ν ≫ u) r = r := by rw [hsecN i]; rfl
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hr, hqg] at e1
      exact e1.symm
    have hτ : τ i r = ν zk := by
      rw [← hstτ i, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hr, hqg]
    subst hr2
    exact ⟨hr.symm, hτ⟩

  have hsub : (nccwEbExS u ν q st zk).Subsingleton := by
    intro p hp p' hp'
    obtain ⟨i, p₀, hp₀, hJ⟩ := hp.2
    obtain ⟨i', p₀', hp₀', hJ'⟩ := hp'.2
    obtain ⟨hg, hτ⟩ := key p hp i p₀ hJ
    obtain ⟨hg', hτ'⟩ := key p' hp' i' p₀' hJ'
    have hii : i = i' := by
      by_contra hne
      exact hsec2 i i' _ _ hne (hτ.trans hτ'.symm)
    subst hii
    have hpp : p₀ = p₀' :=
      PrimeSpectrum.ext ((gen_unique p₀ hp₀).trans (gen_unique p₀' hp₀').symm)
    subst hpp
    exact Prod.ext (hJ.trans hJ'.symm) (hg.trans hg'.symm)

  have hfin := hsub.finite
  refine ⟨hfin, (Set.ncard_le_one_iff hfin).mpr (fun ha hb => hsub ha hb), ?_⟩
  intro hns
  rw [Set.eq_empty_iff_forall_notMem]
  intro p hp
  obtain ⟨i, p₀, hp₀, hJ⟩ := hp.2
  obtain ⟨-, hτ⟩ := key p hp i p₀ hJ
  obtain ⟨W, hW, hWsm⟩ := hsec3 i (u (ν zk))
  exact hns ⟨W, by rw [← hτ]; exact hW, hWsm⟩

theorem wcpa_dj_nccw_ebbi_lb_completion_henselian : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], HenselianLocalRing (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
by
  intro A _ _ _
  haveI := AdicCompletion.isAdicComplete_of_fg
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal A))
  refine ⟨fun f hf a₀ h₁ h₂ => ?_⟩
  exact HenselianRing.is_henselian f hf a₀ h₁ (h₂.map (Ideal.Quotient.mk _))

theorem wcpa_dj_nccw_ebbi_lb_branch_primes : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (D : Type u) [CommRing D] [Algebra A D], Module.Finite A D → HenselianLocalRing (AdicCompletion (IsLocalRing.maximalIdeal A) A) → ∀ (𝔮 : Ideal D), 𝔮.IsPrime → (∀ P : Ideal D, P.IsPrime → 𝔮 ≤ P) → ∀ c : A, c ∉ Ideal.comap (algebraMap A D) 𝔮 → (∀ d : D, ∃ (n : ℕ) (a : A), algebraMap A D a = algebraMap A D c ^ n * d) → ∃ β : Ideal D → PrimeSpectrum (AdicCompletion (IsLocalRing.maximalIdeal A) A), (∀ 𝔫 : Ideal D, 𝔫.IsMaximal → Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) (β 𝔫).asIdeal = Ideal.comap (algebraMap A D) 𝔮) ∧ (∀ 𝔫 𝔫' : Ideal D, 𝔫.IsMaximal → 𝔫'.IsMaximal → β 𝔫 = β 𝔫' → 𝔫 = 𝔫') :=
by


  have hHL : ∀ (A D : Type u) [CommRing A] [CommRing D] [IsDomain D] [Algebra A D] [IsLocalRing A], HenselianLocalRing A → Algebra.IsIntegral A D → IsLocalRing D ∧ IsLocalHom (algebraMap A D) := by
    intro A D _ _ _ _ _ hHen hInt
    have hloc : IsLocalHom (algebraMap A D) := by
      refine ⟨fun a ha => ?_⟩
      by_contra hna
      have hker : RingHom.ker (algebraMap A D) ≤ IsLocalRing.maximalIdeal A :=
        IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top _)
      obtain ⟨Q, hQ, hQu⟩ :=
        Ideal.exists_ideal_over_maximal_of_isIntegral (S := D) (IsLocalRing.maximalIdeal A) hker
      have hmem : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hna
      rw [← hQu] at hmem
      have hQa : algebraMap A D a ∈ Q := hmem
      exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ hQa ha)
    have hofId : ((Algebra.ofId A (IsLocalRing.ResidueField A) : A →ₐ[A] IsLocalRing.ResidueField A) :
        A →+* IsLocalRing.ResidueField A) = IsLocalRing.residue A := by
      ext x
      show Algebra.ofId A (IsLocalRing.ResidueField A) x = IsLocalRing.residue A x
      rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
    have s2 : ∀ (S : Type u) [CommRing S] [Algebra A S], Algebra.IsStandardEtale A S →
        ∀ φ : S →ₐ[A] IsLocalRing.ResidueField A,
          ∃ τ : S →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
      intro S _ _ hS φ
      obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
      have hm := P.hasMap
      have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
        rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
      have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
        rw [Polynomial.aeval_algHom_apply]
        exact (hm.2.map φ).ne_zero
      have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
        obtain ⟨p₁, p₂, N, hc⟩ := P.cond
        have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
        rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
        intro h
        rw [h, zero_mul] at h1
        exact pow_ne_zero N hg0 h1.symm
      have key := (HenselianLocalRing.TFAE A).out 1 2
      obtain ⟨a, ha, hres⟩ := key.mp hHen P.f P.monic_f (φ P.x) hf0 hd0
      have hA : P.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
          exact ha
        · have key2 : (Algebra.ofId A (IsLocalRing.ResidueField A)) (Polynomial.aeval a P.g) =
              Polynomial.aeval (φ P.x) P.g := by
            rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
              IsLocalRing.ResidueField.algebraMap_eq, hres]
          rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
          exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
      refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
      have h1 : (Algebra.ofId A (IsLocalRing.ResidueField A)).comp (P.lift a hA) =
          φ.comp P.equivRing.symm.toAlgHom := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
          IsLocalRing.ResidueField.algebraMap_eq, hres]
        have hx : P.equivRing.symm P.X = P.x := (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
        show φ P.x = φ (P.equivRing.symm P.X)
        rw [hx]
      ext s
      have h2 := congrArg (fun F => F (P.equivRing s)) h1
      simpa using h2
    have s3 : ∀ (E : Type u) [CommRing E] [Algebra A E], Algebra.Etale A E →
        ∀ φ : E →ₐ[A] IsLocalRing.ResidueField A,
          ∃ τ : E →ₐ[A] A, (Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ = φ := by
      intro E _ _ hE φ
      have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A)).IsPrime := RingHom.ker_isPrime _
      obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A)
        (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A))
      have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
      have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
        rintro ⟨y, k, rfl⟩
        simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
      let φ' : Localization.Away s →ₐ[A] IsLocalRing.ResidueField A :=
        IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
      obtain ⟨τ', hτ'⟩ := s2 _ hst φ'
      refine ⟨τ'.comp (IsScalarTower.toAlgHom A E (Localization.Away s)), ?_⟩
      ext e
      have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
      simp only [AlgHom.comp_apply] at h1 ⊢
      rw [IsScalarTower.toAlgHom_apply, h1]
      simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
    have s4 : ∀ (f : Polynomial A) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField A)), f.Monic →
        g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue A) = g₀ * h₀ →
        ∃ g h : Polynomial A, g.Monic ∧ h.Monic ∧ f = g * h ∧
          g.map (IsLocalRing.residue A) = g₀ ∧ h.map (IsLocalRing.residue A) = h₀ := by
      intro f g₀ h₀ hf hg hh hc hfac
      have hn : f.natDegree = g₀.natDegree + h₀.natDegree := by
        rw [← hg.natDegree_mul hh, ← hfac, hf.natDegree_map]
      let p : Polynomial.MonicDegreeEq A f.natDegree := Polynomial.MonicDegreeEq.mk f hf rfl
      let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A) g₀.natDegree :=
        Polynomial.MonicDegreeEq.mk g₀ hg rfl
      let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A) h₀.natDegree :=
        Polynomial.MonicDegreeEq.mk h₀ hh rfl
      have hq : (G₀ : Polynomial (IsLocalRing.ResidueField A)) * (H₀ : Polynomial _) =
          Polynomial.map (algebraMap A (IsLocalRing.ResidueField A)) (p : Polynomial A) ∧
          IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField A)) (H₀ : Polynomial _) := by
        refine ⟨?_, hc⟩
        rw [IsLocalRing.ResidueField.algebraMap_eq]
        exact hfac.symm
      obtain ⟨τ, hτ⟩ := s3 _ inferInstance
        ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
          _ _ hn p).symm ⟨(G₀, H₀), hq⟩)
      have nat : ∀ (ψ : A →ₐ[A] IsLocalRing.ResidueField A),
          (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
            _ _ hn p (ψ.comp τ)).1.1 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.1 :
            Polynomial.MonicDegreeEq A _) : Polynomial A).map (ψ : A →+* IsLocalRing.ResidueField A) ∧
          (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
            _ _ hn p (ψ.comp τ)).1.2 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.2 :
            Polynomial.MonicDegreeEq A _) : Polynomial A).map (ψ : A →+* IsLocalRing.ResidueField A) := by
        intro ψ
        constructor
        · show (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
              (((ψ.comp τ).comp (IsScalarTower.toAlgHom A
                (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
                (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
                Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                  IsLocalRing.ResidueField A)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
            (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
              ((τ.comp (IsScalarTower.toAlgHom A
                (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
                (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
                Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A)) :
                Polynomial.MonicDegreeEq A _) : Polynomial A).map
                  (ψ : A →+* IsLocalRing.ResidueField A)
          rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
          rfl
        · show (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
              (((ψ.comp τ).comp (IsScalarTower.toAlgHom A
                (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
                (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
                Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                  IsLocalRing.ResidueField A)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
            (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
              ((τ.comp (IsScalarTower.toAlgHom A
                (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
                (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
                Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A)) :
                Polynomial.MonicDegreeEq A _) : Polynomial A).map
                  (ψ : A →+* IsLocalRing.ResidueField A)
          rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
          rfl
      obtain ⟨nat1, nat2⟩ := nat (Algebra.ofId A (IsLocalRing.ResidueField A))
      have hφ : Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A)
          _ _ hn p ((Algebra.ofId A (IsLocalRing.ResidueField A)).comp τ) = ⟨(G₀, H₀), hq⟩ := by
        rw [hτ]
        exact Equiv.apply_symm_apply _ _
      rw [hφ, hofId] at nat1 nat2
      refine ⟨_, _, (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.1.monic,
        (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).1.2.monic, ?_,
        nat1.symm, nat2.symm⟩
      rw [(Polynomial.UniversalCoprimeFactorizationRing.homEquiv A _ _ hn p τ).2.1,
        Algebra.algebraMap_self, Polynomial.map_id]
      rfl
    have s5 : ∀ (q : Polynomial (IsLocalRing.ResidueField A)), q.Monic →
        ∃ (a : ℕ) (r : Polynomial (IsLocalRing.ResidueField A)), r.Monic ∧
          q = Polynomial.X ^ a * r ∧ r.coeff 0 ≠ 0 ∧
          IsCoprime ((Polynomial.X : Polynomial (IsLocalRing.ResidueField A)) ^ a) r := by
      intro q hq
      obtain ⟨r, hr, hnd⟩ :=
        Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd q hq.ne_zero 0
      rw [map_zero, sub_zero] at hr hnd
      refine ⟨_, r, ?_, hr, ?_, ?_⟩
      · exact (Polynomial.monic_X_pow _).of_mul_monic_left (hr ▸ hq)
      · intro h
        exact hnd (Polynomial.X_dvd_iff.mpr h)
      · exact IsCoprime.pow_left ((Irreducible.coprime_iff_not_dvd Polynomial.irreducible_X).mpr hnd)
    refine ⟨?_, hloc⟩
    apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
    intro d
    obtain ⟨F, hF, hFd⟩ := hInt.isIntegral d
    obtain ⟨a, r, hr, hsplit, hr0, hcop⟩ := s5 (F.map (IsLocalRing.residue A)) (hF.map _)
    obtain ⟨g, h, -, -, hFgh, hgr, hhr⟩ :=
      s4 F (Polynomial.X ^ a) r hF (Polynomial.monic_X_pow a) hr hcop hsplit
    have hg1 : IsUnit (g.eval 1) := by
      apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
      rw [← Polynomial.eval_one_map, hgr, Polynomial.eval_pow, Polynomial.eval_X, one_pow]
      exact one_ne_zero
    have hh0 : IsUnit (h.eval 0) := by
      apply (IsLocalRing.residue_ne_zero_iff_isUnit _).mp
      rw [← Polynomial.eval_zero_map, hhr, ← Polynomial.coeff_zero_eq_eval_zero]
      exact hr0
    have hprod : Polynomial.aeval d g * Polynomial.aeval d h = 0 := by
      rw [← map_mul, ← hFgh, Polynomial.aeval_def]
      exact hFd
    rcases mul_eq_zero.mp hprod with hgd | hhd
    · right
      have hdvd := Polynomial.sub_dvd_eval_sub 1 d (g.map (algebraMap A D))
      rw [Polynomial.eval_one_map, Polynomial.eval_map, ← Polynomial.aeval_def, hgd,
        sub_zero] at hdvd
      exact isUnit_of_dvd_unit hdvd (hg1.map _)
    · left
      have hdvd := Polynomial.sub_dvd_eval_sub 0 d (h.map (algebraMap A D))
      rw [Polynomial.eval_zero_map, Polynomial.eval_map, ← Polynomial.aeval_def, hhd,
        sub_zero, zero_sub] at hdvd
      have hu := (isUnit_of_dvd_unit hdvd (hh0.map _)).neg
      rwa [neg_neg] at hu
  intro A _ _ _ D _ _ hfin hHens 𝔮 h𝔮 hmin c hc hbir
  classical
  haveI := h𝔮
  haveI : Module.Finite A D := hfin

  have hFF : Module.FaithfullyFlat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
    haveI : IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal A) A) := hHens.toIsLocalRing
    haveI : Module.Flat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      AdicCompletion.flat_of_isNoetherian _
    haveI : IsLocalHom (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) := by
      refine ⟨fun a ha => ?_⟩
      by_contra hna
      have hm : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hna
      obtain ⟨v, hv⟩ := ha.exists_right_inv
      have h1 := congrArg (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1) hv
      rw [map_mul, map_one] at h1
      have h2 : AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1
          (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) = 0 := by
        rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem, pow_one]
        exact hm
      rw [h2, zero_mul] at h1
      have h3 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ 1) 1 = 0 := by
        rw [map_one]; exact h1.symm
      rw [Ideal.Quotient.eq_zero_iff_mem, pow_one] at h3
      exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
    exact Module.FaithfullyFlat.of_flat_of_isLocalHom
  haveI : Algebra.IsIntegral A D := Algebra.IsIntegral.of_finite A D

  have key : ∀ (B : Type u) [CommRing B] [Algebra A B] [Module.FaithfullyFlat A B], HenselianLocalRing B →
      ∃ β : Ideal D → PrimeSpectrum B, (∀ 𝔫 : Ideal D, 𝔫.IsMaximal → Ideal.comap (algebraMap A B) (β 𝔫).asIdeal = Ideal.comap (algebraMap A D) 𝔮) ∧ (∀ 𝔫 𝔫' : Ideal D, 𝔫.IsMaximal → 𝔫'.IsMaximal → β 𝔫 = β 𝔫' → 𝔫 = 𝔫') := by
    intro B _ _ _ hB
    haveI : IsLocalRing B := hB.toIsLocalRing
    obtain ⟨ρ, hρ⟩ : ∃ ρ : B →+* TensorProduct A D B, ∀ b, ρ b = (1 : D) ⊗ₜ[A] b :=
      ⟨(Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A D B).toRingHom, fun b => rfl⟩
    have hlam : ∀ d : D, algebraMap D (TensorProduct A D B) d = d ⊗ₜ[A] (1 : B) := fun d => rfl
    have hcomp : ∀ a : A, ρ (algebraMap A B a) =
        algebraMap D (TensorProduct A D B) (algebraMap A D a) := by
      intro a
      rw [hρ, ← IsScalarTower.algebraMap_apply]
      exact (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A D B).commutes a
    have hcomap : ∀ J : Ideal (TensorProduct A D B),
        Ideal.comap (algebraMap A B) (Ideal.comap ρ J) =
          Ideal.comap (algebraMap A D) (Ideal.comap (algebraMap D (TensorProduct A D B)) J) := by
      intro J
      ext a
      simp only [Ideal.mem_comap]
      rw [hcomp]

    have hbirE : ∀ x : TensorProduct A D B, ∃ (n : ℕ) (b : B),
        ρ b = ρ (algebraMap A B c) ^ n * x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => exact ⟨0, 0, by simp⟩
      | tmul d b =>
        obtain ⟨n, a, ha⟩ := hbir d
        refine ⟨n, algebraMap A B a * b, ?_⟩
        rw [map_mul, hcomp, hcomp, ← map_pow, ha, hρ, hlam, hlam, Algebra.TensorProduct.tmul_mul_tmul,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      | add x y hx hy =>
        obtain ⟨n₁, b₁, h₁⟩ := hx
        obtain ⟨n₂, b₂, h₂⟩ := hy
        refine ⟨n₁ + n₂, (algebraMap A B c) ^ n₂ * b₁ + (algebraMap A B c) ^ n₁ * b₂, ?_⟩
        rw [map_add, map_mul, map_mul, map_pow, map_pow, h₁, h₂]
        ring

    have hQle : ∀ Q Q' : Ideal (TensorProduct A D B), Q.IsPrime → Q'.IsPrime →
        ρ (algebraMap A B c) ∉ Q' → Ideal.comap ρ Q = Ideal.comap ρ Q' → Q ≤ Q' := by
      intro Q Q' hQ hQ' hγ' heq x hx
      obtain ⟨n, b, hb⟩ := hbirE x
      have h1 : b ∈ Ideal.comap ρ Q := by
        rw [Ideal.mem_comap, hb]
        exact Q.mul_mem_left _ hx
      rw [heq, Ideal.mem_comap, hb] at h1
      rcases hQ'.mem_or_mem h1 with h | h
      · exact absurd (hQ'.mem_of_pow_mem n h) hγ'
      · exact h

    have hint : ∀ x : TensorProduct A D B, ρ.IsIntegralElem x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => exact ρ.isIntegralElem_zero
      | tmul d b =>
        have e : d ⊗ₜ[A] b = algebraMap D (TensorProduct A D B) d * ρ b := by
          rw [hρ, hlam, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [e]
        refine RingHom.IsIntegralElem.mul ρ ?_ (ρ.isIntegralElem_map)
        obtain ⟨p, hp, hpd⟩ := Algebra.IsIntegral.isIntegral (R := A) d
        refine ⟨p.map (algebraMap A B), hp.map _, ?_⟩
        rw [Polynomial.eval₂_map]
        have hc2 : ρ.comp (algebraMap A B) =
            (algebraMap D (TensorProduct A D B)).comp (algebraMap A D) :=
          RingHom.ext fun a => hcomp a
        rw [hc2, ← Polynomial.hom_eval₂, hpd, map_zero]
      | add x y hx hy => exact RingHom.IsIntegralElem.add ρ hx hy

    have huniq : ∀ Q M M' : Ideal (TensorProduct A D B), Q.IsPrime → M.IsMaximal → M'.IsMaximal →
        Q ≤ M → Q ≤ M' → M = M' := by
      intro Q M M' hQ hM hM' hQM hQM'
      letI : Algebra B (TensorProduct A D B ⧸ Q) := ((Ideal.Quotient.mk Q).comp ρ).toAlgebra
      haveI : IsDomain (TensorProduct A D B ⧸ Q) := Ideal.Quotient.isDomain Q
      have hIntQ : Algebra.IsIntegral B (TensorProduct A D B ⧸ Q) := by
        refine ⟨fun y => ?_⟩
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
        obtain ⟨p, hp, hpx⟩ := hint x
        refine ⟨p, hp, ?_⟩
        rw [RingHom.algebraMap_toAlgebra, ← Polynomial.hom_eval₂, hpx, map_zero]
      haveI : IsLocalRing (TensorProduct A D B ⧸ Q) := (hHL B (TensorProduct A D B ⧸ Q) hB hIntQ).1
      have hK : ∀ N : Ideal (TensorProduct A D B), N.IsMaximal → Q ≤ N →
          N = Ideal.comap (Ideal.Quotient.mk Q) (IsLocalRing.maximalIdeal (TensorProduct A D B ⧸ Q)) := by
        intro N hN hQN
        apply hN.eq_of_le
        · exact Ideal.comap_ne_top _ (IsLocalRing.maximalIdeal.isMaximal _).ne_top
        · intro x hx
          rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          obtain ⟨w, hw⟩ := hu.exists_right_inv
          obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective w
          have h1 : x * y - 1 ∈ Q := Ideal.Quotient.eq.mp (by rw [map_mul, hw, map_one])
          have h2 : (1 : TensorProduct A D B) ∈ N := by
            have := N.sub_mem (N.mul_mem_right y hx) (hQN h1)
            rwa [sub_sub_cancel] at this
          exact hN.ne_top ((Ideal.eq_top_iff_one _).mpr h2)
      rw [hK M hM hQM, hK M' hM' hQM']

    have hex : ∀ 𝔫 : Ideal D, 𝔫.IsMaximal → ∃ Q M : Ideal (TensorProduct A D B), Q.IsPrime ∧
        M.IsMaximal ∧ Q ≤ M ∧ Ideal.comap (algebraMap D (TensorProduct A D B)) M = 𝔫 ∧
        Ideal.comap (algebraMap D (TensorProduct A D B)) Q = 𝔮 := by
      intro 𝔫 h𝔫
      obtain ⟨P, hP⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := D)
        (B := TensorProduct A D B) ⟨𝔫, h𝔫.isPrime⟩
      have hPc : Ideal.comap (algebraMap D (TensorProduct A D B)) P.asIdeal = 𝔫 :=
        congrArg PrimeSpectrum.asIdeal hP
      obtain ⟨M, hM, hPM⟩ := Ideal.exists_le_maximal P.asIdeal P.isPrime.ne_top
      have hMc : Ideal.comap (algebraMap D (TensorProduct A D B)) M = 𝔫 := by
        refine (h𝔫.eq_of_le (Ideal.comap_ne_top _ hM.ne_top) ?_).symm
        rw [← hPc]
        exact Ideal.comap_mono hPM
      haveI := hM.isPrime
      obtain ⟨Q, hQmin, hQM⟩ :=
        Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal (TensorProduct A D B)) ≤ M)
      have hQp : Q.IsPrime := hQmin.1.1
      refine ⟨Q, M, hQp, hM, hQM, hMc, ?_⟩
      haveI := hQp
      have hle : 𝔮 ≤ Ideal.comap (algebraMap D (TensorProduct A D B)) Q := hmin _ (hQp.comap _)
      by_contra hne
      have hlt' : 𝔮 < Ideal.under D Q := lt_of_le_of_ne hle (Ne.symm hne)
      obtain ⟨P', hP'Q, hP'p, hP'l⟩ := Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt Q hlt'
      have hQP' : Q ≤ P' := hQmin.2 ⟨hP'p, bot_le⟩ hP'Q
      have e : P' = Q := le_antisymm hP'Q hQP'
      have hov := hP'l.over
      rw [e] at hov
      exact hne hov.symm
    choose! Q M hQM using hex
    have hγ : ∀ 𝔫 : Ideal D, 𝔫.IsMaximal → ρ (algebraMap A B c) ∉ Q 𝔫 := by
      intro 𝔫 h𝔫 hmem
      obtain ⟨-, -, -, -, hQc⟩ := hQM 𝔫 h𝔫
      apply hc
      have h1 : c ∈ Ideal.comap (algebraMap A B) (Ideal.comap ρ (Q 𝔫)) := hmem
      rw [hcomap, hQc] at h1
      exact h1
    refine ⟨fun 𝔫 => if h : (Q 𝔫).IsPrime then ⟨Ideal.comap ρ (Q 𝔫), Ideal.IsPrime.comap ρ (hK := h)⟩
      else IsLocalRing.closedPoint B, ?_, ?_⟩
    · intro 𝔫 h𝔫
      obtain ⟨hQp, -, -, -, hQc⟩ := hQM 𝔫 h𝔫
      dsimp only
      rw [dif_pos hQp]
      exact (hcomap (Q 𝔫)).trans (by rw [hQc])
    · intro 𝔫 𝔫' h𝔫 h𝔫' hβ
      obtain ⟨hQp, hM, hQM1, hMc, -⟩ := hQM 𝔫 h𝔫
      obtain ⟨hQp', hM', hQM1', hMc', -⟩ := hQM 𝔫' h𝔫'
      dsimp only at hβ
      rw [dif_pos hQp, dif_pos hQp'] at hβ
      have hc' : Ideal.comap ρ (Q 𝔫) = Ideal.comap ρ (Q 𝔫') := congrArg PrimeSpectrum.asIdeal hβ
      have hQQ : Q 𝔫 = Q 𝔫' := le_antisymm (hQle _ _ hQp hQp' (hγ 𝔫' h𝔫') hc')
        (hQle _ _ hQp' hQp (hγ 𝔫 h𝔫) hc'.symm)
      have hMM : M 𝔫 = M 𝔫' :=
        huniq (Q 𝔫) (M 𝔫) (M 𝔫') hQp hM hM' hQM1 (by rw [hQQ]; exact hQM1')
      rw [← hMc, ← hMc', hMM]
  exact key (AdicCompletion (IsLocalRing.maximalIdeal A) A) hHens

theorem wcpa_dj_nccw_ebbi_lb_finite_closed_model : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsProper f → ∀ (C : Set X), IsClosed C → (∀ x ∈ C, ∀ x' ∈ C, x' ⤳ x → f x' = f x → x' = x) → ∃ (Z : Scheme.{u}) (ι : Z ⟶ X), IsClosedImmersion ι ∧ Set.range ι = C ∧ IsFinite (ι ≫ f) :=
by
  intro X Y f hf C hC hCs
  haveI : IsProper f := hf
  let Cc : TopologicalSpace.Closeds X := ⟨C, hC⟩
  let I := Scheme.IdealSheafData.vanishingIdeal Cc
  have hrange : Set.range I.subschemeι = C := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hlqf : LocallyQuasiFinite (I.subschemeι ≫ f) := by
    apply wcpa_dj_ldx_lqf_of_no_fibre_specialization (I.subschemeι ≫ f) inferInstance
    intro z z' hzz' hfz
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hfz
    have h1 : I.subschemeι z' ⤳ I.subschemeι z := hzz'.map I.subschemeι.continuous
    have hz : I.subschemeι z ∈ C := by rw [← hrange]; exact ⟨z, rfl⟩
    have hz' : I.subschemeι z' ∈ C := by rw [← hrange]; exact ⟨z', rfl⟩
    exact (Scheme.Hom.isClosedEmbedding I.subschemeι).injective
      (hCs _ hz _ hz' h1 hfz)
  exact ⟨I.subscheme, I.subschemeι, inferInstance, hrange,
    IsFinite.of_isProper_of_locallyQuasiFinite _⟩

theorem wcpa_dj_nccw_ebbi_lb_finite_affine_points : ∀ (R : CommRingCat.{u}) (Z : Scheme.{u}) (h : Z ⟶ Spec R), IsFinite h → ((Scheme.ΓSpecIso R).inv ≫ h.appTop).hom.Finite ∧ ∃ e : ↥Z ≃ₜ PrimeSpectrum Γ(Z, ⊤), ∀ z : ↥Z, h z = PrimeSpectrum.comap ((Scheme.ΓSpecIso R).inv ≫ h.appTop).hom (e z) :=
by
  intro R Z h hfin
  haveI : IsAffine Z := isAffine_of_isAffineHom h
  have h2 : (h.appTop).hom.Finite := ((isFinite_iff h).mp hfin).2 ⊤ (isAffineOpen_top (Spec R))
  refine ⟨?_, ?_⟩
  · have hb := ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso R).inv
    have hs : ((Scheme.ΓSpecIso R).inv).hom.Finite := RingHom.Finite.of_surjective _ hb.2
    rw [CommRingCat.hom_comp]
    exact RingHom.Finite.comp h2 hs
  · have key : Z.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso R).inv ≫ h.appTop) = h := by
      rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
        ← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
    refine ⟨Scheme.homeoOfIso Z.isoSpec, fun z => ?_⟩
    have he : (Scheme.homeoOfIso Z.isoSpec) z = Z.toSpecΓ z := by
      rw [Scheme.homeoOfIso_apply, Scheme.isoSpec_hom]
    have hz : h z = PrimeSpectrum.comap ((Scheme.ΓSpecIso R).inv ≫ h.appTop).hom (Z.toSpecΓ z) := by
      calc h z = (Z.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso R).inv ≫ h.appTop)) z := by rw [key]
        _ = _ := by rw [Scheme.Hom.comp_apply, Spec.map_apply]
    rw [hz]
    exact congrArg _ he.symm

theorem wcpa_dj_nccw_ebbi_lb_birational : ∀ (R : CommRingCat.{u}) (Z : Scheme.{u}) [IsAffine Z] (h : Z ⟶ Spec R) (c : R), IsClosedImmersion (h ∣_ ((Spec R).basicOpen ((Scheme.ΓSpecIso R).inv.hom c))) → ∀ d : Γ(Z, ⊤), ∃ (n : ℕ) (a : R), ((Scheme.ΓSpecIso R).inv ≫ h.appTop).hom a = ((Scheme.ΓSpecIso R).inv ≫ h.appTop).hom c ^ n * d :=
by
  intro R Z _ h c hci d
  set c' := (Scheme.ΓSpecIso R).inv.hom c with hc'
  set U := (Spec R).basicOpen c' with hU
  have hUaff : IsAffineOpen U := (isAffineOpen_top (Spec R)).basicOpen c'
  have : IsAffine U := hUaff

  have key : ∀ {A B C : CommRingCat.{u}} (g : A ⟶ B) (e : B ⟶ C) [IsIso e],
      Function.Surjective (g ≫ e).hom → Function.Surjective g.hom := by
    intro A B C g e _ hge t
    obtain ⟨s, hs⟩ := hge (e.hom t)
    refine ⟨s, (ConcreteCategory.bijective_of_isIso e).1 ?_⟩
    rw [CommRingCat.comp_apply] at hs
    exact hs
  have hsurj : Function.Surjective (h.app U).hom := by
    have h1 := Scheme.Hom.app_surjective (h ∣_ U) ⊤ (isAffineOpen_top _)
    rw [morphismRestrict_app] at h1
    have h2 : Function.Surjective (h.app (U.ι ''ᵁ ⊤)).hom :=
      @key _ _ _ _ _ (by
        have hiso : ∀ {A B : CommRingCat.{u}} (p : A = B), IsIso (eqToHom p) := fun p => by
          subst p; exact IsIso.id _
        rw [eqToHom_op, eqToHom_map]; exact hiso _) h1
    rw [Scheme.Opens.ι_image_top] at h2
    exact h2

  set ψ := h.appTop.hom with hψ
  have nat : ∀ x, (h.app U).hom (((Spec R).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom x) =
      (Z.presheaf.map (homOfLE (le_top : h ⁻¹ᵁ U ≤ ⊤)).op).hom (ψ x) := by
    intro x
    rw [← CommRingCat.comp_apply, Scheme.Hom.naturality]
    rfl
  obtain ⟨y, hy⟩ := hsurj ((Z.presheaf.map (homOfLE (le_top : h ⁻¹ᵁ U ≤ ⊤)).op).hom d)
  have := (isAffineOpen_top (Spec R)).isLocalization_basicOpen c'
  obtain ⟨m, a₁, hya⟩ := IsLocalization.Away.surj c' y
  have hya' : y * (((Spec R).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom c') ^ m =
      ((Spec R).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom a₁ := hya
  have e1 := congrArg (h.app U).hom hya'
  rw [map_mul, map_pow, nat, nat, hy, ← map_pow, ← map_mul, ← sub_eq_zero, ← map_sub] at e1

  have hle : Z.basicOpen (ψ c') ≤ h ⁻¹ᵁ U := by
    rw [hU, Scheme.preimage_basicOpen]; exact le_rfl
  have e2 : (Z.presheaf.map (homOfLE (Z.basicOpen_le (ψ c'))).op).hom (d * ψ c' ^ m - ψ a₁) = 0 := by
    have : (Z.presheaf.map (homOfLE (Z.basicOpen_le (ψ c'))).op) =
        (Z.presheaf.map (homOfLE (le_top : h ⁻¹ᵁ U ≤ ⊤)).op) ≫ Z.presheaf.map (homOfLE hle).op := by
      rw [← Functor.map_comp]; rfl
    rw [this, CommRingCat.comp_apply, e1, map_zero]
  obtain ⟨k, hk⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen Z
    (isAffineOpen_top Z) (d * ψ c' ^ m - ψ a₁) (ψ c') e2
  refine ⟨k + m, (Scheme.ΓSpecIso R).hom.hom (c' ^ k * a₁), ?_⟩
  rw [CommRingCat.comp_apply, CommRingCat.comp_apply, Iso.hom_inv_id_apply]
  change ψ (c' ^ k * a₁) = ψ c' ^ (k + m) * d
  rw [map_mul, map_pow, pow_add]
  linear_combination -hk

theorem wcpa_dj_nccw_ebbi_lb_pullback_restrict_iso : ∀ {X Y S : Scheme.{u}} (q : X ⟶ S) (g : Y ⟶ S) (W : S.Opens), IsIso (q ∣_ W) → ∀ V : Y.Opens, (V : Set Y) ⊆ g ⁻¹' (W : Set S) → IsIso (Limits.pullback.snd q g ∣_ V) :=
by
  intro X Y S q g W hq V hV
  have hle : V ≤ g ⁻¹ᵁ W := fun x hx => hV hx
  have outer := (isPullback_morphismRestrict (Limits.pullback.snd q g) V).flip.paste_horiz
    (IsPullback.of_hasPullback q g)
  have right := (isPullback_morphismRestrict q W).flip
  have w : ((Limits.pullback.snd q g ⁻¹ᵁ V).ι ≫ Limits.pullback.fst q g) ≫ q =
      (Limits.pullback.snd q g ∣_ V ≫ g.resLE W V hle) ≫ W.ι := by
    rw [Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι, Limits.pullback.condition,
      ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
  have outer' : IsPullback (right.lift _ _ w ≫ (q ⁻¹ᵁ W).ι) (Limits.pullback.snd q g ∣_ V) q
      (g.resLE W V hle ≫ W.ι) := by
    rw [right.lift_fst, Scheme.Hom.resLE_comp_ι]
    exact outer
  have left := IsPullback.of_right outer' (right.lift_snd _ _ w) right
  exact left.isIso_snd_of_isIso

theorem wcpa_dj_nccw_ebbi_local_branches : ∀ (S N : Scheme.{u}) (q : N ⟶ S), IsProper q → IsLocallyNoetherian S → ∀ zk : S, (∀ s : S, s ⤳ zk → s ≠ zk → ∃ W : S.Opens, s ∈ W ∧ IsIso (q ∣_ W)) → ∀ y : N, q y ⤳ zk → q y ≠ zk → (closure {y} ∩ ⇑q ⁻¹' {zk}).Finite → (∀ g ∈ closure {y} ∩ ⇑q ⁻¹' {zk}, IsClosed ({g} : Set N)) → ∃ β : N → PrimeSpectrum (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)), (∀ g ∈ closure {y} ∩ ⇑q ⁻¹' {zk}, S.fromSpecStalk zk (PrimeSpectrum.comap (algebraMap (S.presheaf.stalk zk) (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk))) (β g)) = q y) ∧ Set.InjOn β (closure {y} ∩ ⇑q ⁻¹' {zk}) :=
by
  intro S N q hqp hSln zk hLI y hyz hyne _hTfin hTcl
  classical
  haveI : IsProper q := hqp
  haveI : IsLocallyNoetherian S := hSln

  have hg0inj : Function.Injective (S.fromSpecStalk zk) :=
    (S.fromSpecStalk zk).isEmbedding.injective
  have hg0sp : ∀ P, S.fromSpecStalk zk P ⤳ zk := by
    intro P
    have h : S.fromSpecStalk zk P ∈ Set.range (S.fromSpecStalk zk) := ⟨P, rfl⟩
    rw [Scheme.range_fromSpecStalk] at h
    exact h
  have hp1emb : Topology.IsEmbedding (Limits.pullback.fst q (S.fromSpecStalk zk)) :=
    Scheme.Hom.isEmbedding _
  have hcond : ∀ n, q (Limits.pullback.fst q (S.fromSpecStalk zk) n) =
      S.fromSpecStalk zk (Limits.pullback.snd q (S.fromSpecStalk zk) n) := by
    intro n
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
  have hrange : ∀ m : N, q m ⤳ zk → ∃ n, Limits.pullback.fst q (S.fromSpecStalk zk) n = m := by
    intro m hm
    have h : q m ∈ Set.range (S.fromSpecStalk zk) := by
      rw [Scheme.range_fromSpecStalk]; exact hm
    obtain ⟨P, hP⟩ := h
    obtain ⟨n, hn, -⟩ := Scheme.Pullback.exists_preimage_pullback m P hP.symm
    exact ⟨n, hn⟩
  have hqinj : ∀ (W : S.Opens), IsIso (q ∣_ W) → ∀ a1 b1 : N, q a1 ∈ W → q b1 ∈ W →
      q a1 = q b1 → a1 = b1 := by
    intro W hW a1 b1 ha hb hab
    have key : ∀ c : (q ⁻¹ᵁ W).toScheme, W.ι ((q ∣_ W) c) = q ((q ⁻¹ᵁ W).ι c) := fun c => by
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
    obtain ⟨a', rfl⟩ : a1 ∈ Set.range (q ⁻¹ᵁ W).ι := by rw [Scheme.Opens.range_ι]; exact ha
    obtain ⟨b', rfl⟩ : b1 ∈ Set.range (q ⁻¹ᵁ W).ι := by rw [Scheme.Opens.range_ι]; exact hb
    have h1 : (q ∣_ W) a' = (q ∣_ W) b' := W.ι.isOpenEmbedding.injective (by rw [key, key, hab])
    have e : ∀ c, (inv (q ∣_ W)) ((q ∣_ W) c) = c := fun c => by
      rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]; rfl
    rw [← e a', ← e b', h1]

  obtain ⟨yA, hyA⟩ := hrange y hyz
  have hC1 : ∀ n, n ∈ closure ({yA} : Set ↥(Limits.pullback q (S.fromSpecStalk zk))) ↔
      Limits.pullback.fst q (S.fromSpecStalk zk) n ∈ closure ({y} : Set N) := by
    intro n
    rw [hp1emb.isInducing.closure_eq_preimage_closure_image, Set.image_singleton, hyA]
    rfl
  have hC2 : ∀ x ∈ closure ({yA} : Set ↥(Limits.pullback q (S.fromSpecStalk zk))),
      ∀ x' ∈ closure ({yA} : Set ↥(Limits.pullback q (S.fromSpecStalk zk))), x' ⤳ x →
      Limits.pullback.snd q (S.fromSpecStalk zk) x' = Limits.pullback.snd q (S.fromSpecStalk zk) x →
      x' = x := by
    intro x hx x' hx' hspec heq
    apply hp1emb.injective
    by_cases hP : Limits.pullback.snd q (S.fromSpecStalk zk) x = IsLocalRing.closedPoint _
    · have hqx' : q (Limits.pullback.fst q (S.fromSpecStalk zk) x') = zk := by
