    have hx : x ∈ b ⁻¹ᵁ V := hbV
    letI := (g.app V).hom.toAlgebra
    let e : Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) ≃+* integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V) :=
      (Scheme.Hom.normalizationObjIso g hV).commRingCatIsoToRingEquiv
    let p := (hW.primeIdealOf ⟨x, hx⟩).asIdeal
    let Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := p.comap e.symm.toRingHom
    haveI : Q.IsPrime := Ideal.comap_isPrime _ _
    obtain ⟨hd, hic⟩ := h ⟨V, hV⟩ Q
    set y : (b ⁻¹ᵁ V : Scheme) := ⟨x, hx⟩
    show IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) ∧
      IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk y.1)
    letI : Algebra Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V)
        ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
      TopCat.Presheaf.algebra_section_stalk (Scheme.Hom.normalization g).presheaf y
    haveI := hW.isLocalization_stalk y
    have hM : p.primeCompl.map e.toMonoidHom = Q.primeCompl := by
      ext z
      constructor
      · rintro ⟨w, hw, rfl⟩
        show e.symm (e w) ∉ p
        rw [e.symm_apply_apply]
        exact hw
      · intro hz
        exact ⟨e.symm z, hz, e.apply_symm_apply z⟩
    let f : (Scheme.Hom.normalization g).presheaf.stalk y.1 ≃+* Localization.AtPrime Q :=
      IsLocalization.ringEquivOfRingEquiv (M := p.primeCompl) (T := Q.primeCompl) _ _ e hM
    haveI : IsDomain ((Scheme.Hom.normalization g).presheaf.stalk y.1) :=
      MulEquiv.isDomain _ f.toMulEquiv
    exact ⟨inferInstance, IsIntegrallyClosed.of_equiv f.symm⟩

  have s6 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (L : Type u) [CommRing L] [Algebra A L], Nonempty (L ≃ₐ[A] ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal)) → ∀ Q ∈ minimalPrimes (integralClosure A L), Q.comap (algebraMap A (integralClosure A L)) ∈ minimalPrimes A := by
    intro A _ _ L _ _ ⟨e⟩ Q hQ
    have : Q.IsPrime := hQ.1.1
    set q := Q.comap (algebraMap A (integralClosure A L)) with hq
    have hqp : q.IsPrime := Ideal.comap_isPrime _ _
    have hdis := Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hQ
    have hunit : ∀ a : A, (∀ P ∈ minimalPrimes A, a ∉ P) → IsUnit (algebraMap A L a) := by
      intro a ha
      have h1 : IsUnit (e (algebraMap A L a)) := by
        rw [e.commutes, Pi.isUnit_iff]
        intro P
        rw [Pi.algebraMap_apply]
        exact (IsLocalization.AtPrime.isUnit_to_map_iff _ P.1.asIdeal a).mpr (ha _ P.2)
      have h2 := h1.map e.symm
      simpa using h2
    have hsub : (q : Set A) ⊆ ⋃ P ∈ minimalPrimes A, ((id P : Ideal A) : Set A) := by
      intro a haq
      by_contra hcon
      simp only [Set.mem_iUnion, not_exists, id] at hcon
      have hu := hunit a (fun P hP h => hcon P hP h)
      have hnzd : algebraMap A (integralClosure A L) a ∈ nonZeroDivisors (integralClosure A L) := by
        rw [mem_nonZeroDivisors_iff_right]
        intro c hc
        apply Subtype.ext
        have hc' : (c : L) * algebraMap A L a = 0 := by
          have := congrArg (fun z : integralClosure A L => (z : L)) hc
          simpa using this
        simpa using (hu.mul_left_eq_zero).mp hc'
      exact Set.disjoint_left.mp hdis haq hnzd
    obtain ⟨P, hP, hle⟩ := (Ideal.subset_union_prime_finite (minimalPrimes.finite_of_isNoetherianRing A)
      (f := id) ⊥ ⊥ (fun P hP _ _ => hP.1.1)).mp hsub
    have heq : q = P := le_antisymm hle (hP.2 ⟨hqp, bot_le⟩ hle)
    rw [heq]
    exact hP

  have s7 : ∀ (X R : Scheme.{u}) (g : X ⟶ R) [QuasiCompact g] [QuasiSeparated g], (∀ V : R.affineOpens, letI := (g.app V).hom.toAlgebra; ∀ Q ∈ minimalPrimes (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)), Q.comap (algebraMap Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) ∈ minimalPrimes Γ(R, V)) → ∀ x : Scheme.Hom.normalization g, ∃ x' : Scheme.Hom.normalization g, x' ⤳ x ∧ ∀ y : R, y ⤳ Scheme.Hom.fromNormalization g x' → y = Scheme.Hom.fromNormalization g x' := by
    intro X R g _ _ hD x
    set b := Scheme.Hom.fromNormalization g
    obtain ⟨V, hV, hbV, -⟩ := exists_isAffineOpen_mem_and_subset (x := b x) (U := ⊤) trivial
    have hW : IsAffineOpen (b ⁻¹ᵁ V) := hV.preimage b
    have hx : x ∈ b ⁻¹ᵁ V := hbV
    letI := (g.app V).hom.toAlgebra
    set p := hW.primeIdealOf ⟨x, hx⟩
    obtain ⟨q₀, hq₀, hle⟩ := Ideal.exists_minimalPrimes_le (J := p.asIdeal) (I := ⊥) bot_le
    let s : Spec Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) := ⟨q₀, hq₀.1.1⟩
    refine ⟨hW.fromSpec s, ?_, ?_⟩
    · have hsp : s ⤳ p := (PrimeSpectrum.le_iff_specializes _ _).mp hle
      have := hsp.map hW.fromSpec.continuous
      rwa [hW.fromSpec_primeIdealOf] at this
    · have hcomp := IsAffineOpen.SpecMap_appLE_fromSpec b hV hW le_rfl
      have hbx : b (hW.fromSpec s) = hV.fromSpec ((Spec.map (b.appLE V (b ⁻¹ᵁ V) le_rfl)) s) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hcomp]
      let e : Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) ≃+* integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V) :=
        (Scheme.Hom.normalizationObjIso g hV).commRingCatIsoToRingEquiv
      let Q : Ideal (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := q₀.comap e.symm.toRingHom
      have hQ : Q ∈ minimalPrimes (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V)) := by
        have := Ideal.minimalPrimes_comap_of_surjective (f := e.symm.toRingHom) e.symm.surjective hq₀
        rw [Ideal.comap_bot_of_injective e.symm.toRingHom e.symm.injective] at this
        exact this
      have hP := hD ⟨V, hV⟩ Q hQ
      set t := (Spec.map (b.appLE V (b ⁻¹ᵁ V) le_rfl)) s with ht
      have hideal : t.asIdeal =
          Q.comap (algebraMap Γ(R, V) (integralClosure Γ(R, V) Γ(X, g ⁻¹ᵁ V))) := by
        show q₀.comap (b.appLE V (b ⁻¹ᵁ V) le_rfl).hom = _
        rw [← Scheme.Hom.app_eq_appLE, Scheme.Hom.fromNormalization_app g hV, CommRingCat.hom_comp,
          ← Ideal.comap_comap]
        rfl
      rw [hbx]
      intro y hy
      have hmem : hV.fromSpec t ∈ (V : Set R) := hV.range_fromSpec ▸ ⟨t, rfl⟩
      have hyV : y ∈ (V : Set R) := hy.mem_open V.isOpen hmem
      rw [← hV.range_fromSpec] at hyV
      obtain ⟨t', rfl⟩ := hyV
      have hsp : t' ⤳ t := hV.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp hy
      have hle' : t'.asIdeal ≤ t.asIdeal := (PrimeSpectrum.le_iff_specializes _ _).mpr hsp
      rw [hideal] at hle'
      have hge := hP.2 ⟨t'.isPrime, bot_le⟩ hle'
      rw [← hideal] at hge
      have : t' = t := PrimeSpectrum.ext (le_antisymm (hideal ▸ hle') hge)
      rw [this]

  have hC2 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → wcpaDjNccNagata.{u} → ∀ (T : Scheme.{u}) (s : T ⟶ Spec (.of R)), IsProper s → AlgebraicGeometry.IsReduced T → ∀ (X : Scheme.{u}) (g : X ⟶ T) [QuasiCompact g] [QuasiSeparated g], (∀ V : T.affineOpens, letI := (g.app V).hom.toAlgebra; Nonempty (Γ(X, g ⁻¹ᵁ V) ≃ₐ[Γ(T, V)] ((P : {P : PrimeSpectrum Γ(T, V) // P.asIdeal ∈ minimalPrimes Γ(T, V)}) → Localization.AtPrime P.1.asIdeal))) → (∀ V : T.affineOpens, IsNoetherianRing Γ(T, V)) ∧ IsFinite (Scheme.Hom.fromNormalization g) ∧ ∀ x : Scheme.Hom.normalization g, IsDomain ((Scheme.Hom.normalization g).presheaf.stalk x) ∧ IsIntegrallyClosed ((Scheme.Hom.normalization g).presheaf.stalk x) := by
    intro R _ _ _ hcomp hNag T s hs hred X g _ _ hL
    haveI := hs
    haveI := hred
    have hnoeth : ∀ V : T.affineOpens, IsNoetherianRing Γ(T, V) := by
      intro V
      obtain ⟨φ, hφ⟩ := s0 R T s V
      letI := φ.toAlgebra
      haveI : Algebra.FiniteType R Γ(T, V) := hφ
      exact Algebra.FiniteType.isNoetherianRing R _
    have hfinP : ∀ V : T.affineOpens, ∀ P ∈ minimalPrimes Γ(T, V),
        Module.Finite (Γ(T, V) ⧸ P) (integralClosure (Γ(T, V) ⧸ P) (FractionRing (Γ(T, V) ⧸ P))) := by
      intro V P hP
      obtain ⟨φ, hφ⟩ := s0 R T s V
      letI := φ.toAlgebra
      haveI : Algebra.FiniteType R Γ(T, V) := hφ
      haveI : P.IsPrime := hP.1.1
      exact hNag R hcomp (Γ(T, V) ⧸ P)
        (Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R P) (Ideal.Quotient.mkₐ_surjective R P))
        inferInstance
    refine ⟨hnoeth, ?_, ?_⟩
    · apply s6a X T g
      intro V
      letI := (g.app V).hom.toAlgebra
      haveI := hnoeth V
      exact integralClosure_prod_minimal_finite Γ(T, V) Γ(X, g ⁻¹ᵁ V) (hL V) (hfinP V)
    · exact s6b X T g (fun V => by
        letI := (g.app V).hom.toAlgebra
        haveI := hnoeth V
        exact integralClosure_prod_minimal_stalks_normal Γ(T, V) Γ(X, g ⁻¹ᵁ V) (hL V))

  have hC6 : ∀ (X T : Scheme.{u}) (g : X ⟶ T) [QuasiCompact g] [QuasiSeparated g], (∀ V : T.affineOpens, IsNoetherianRing Γ(T, V)) → (∀ V : T.affineOpens, letI := (g.app V).hom.toAlgebra; Nonempty (Γ(X, g ⁻¹ᵁ V) ≃ₐ[Γ(T, V)] ((P : {P : PrimeSpectrum Γ(T, V) // P.asIdeal ∈ minimalPrimes Γ(T, V)}) → Localization.AtPrime P.1.asIdeal))) → ∀ x : Scheme.Hom.normalization g, ∃ x' : Scheme.Hom.normalization g, x' ⤳ x ∧ ∀ y : T, y ⤳ Scheme.Hom.fromNormalization g x' → y = Scheme.Hom.fromNormalization g x' := by
    intro X T g _ _ hnoeth hL
    apply s7 X T g
    intro V
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V
    exact s6 Γ(T, V) Γ(X, g ⁻¹ᵁ V) (hL V)

  have hC7 : ∀ (G : Scheme.{u}), AlgebraicGeometry.IsReduced G → (∀ γ : G, (∀ γ' : G, γ' ⤳ γ → γ' = γ) → IsDomain (G.presheaf.stalk γ) ∧ IsIntegrallyClosed (G.presheaf.stalk γ)) ∧ (∀ γ : G, ∃ γ' : G, (∀ γ'' : G, γ'' ⤳ γ' → γ'' = γ') ∧ γ' ⤳ γ) := by
    intro G hGr
    haveI := hGr
    refine ⟨fun γ hγ => ?_, fun γ => ?_⟩
    · have hprime : ∀ q : Ideal (G.presheaf.stalk γ), q.IsPrime →
          q = IsLocalRing.maximalIdeal (G.presheaf.stalk γ) := by
        intro q hq
        let t : Spec (G.presheaf.stalk γ) := ⟨q, hq⟩
        have h1 : G.fromSpecStalk γ t ⤳ γ := by
          have : G.fromSpecStalk γ t ∈ Set.range (G.fromSpecStalk γ) := ⟨t, rfl⟩
          rw [Scheme.range_fromSpecStalk] at this
          exact this
        have h2 : G.fromSpecStalk γ t = G.fromSpecStalk γ (IsLocalRing.closedPoint _) := by
          rw [hγ _ h1, Scheme.fromSpecStalk_closedPoint]
        have h3 := (G.fromSpecStalk γ).isEmbedding.injective h2
        exact congrArg PrimeSpectrum.asIdeal h3
      have hmax : IsLocalRing.maximalIdeal (G.presheaf.stalk γ) = ⊥ := by
        rw [eq_bot_iff]
        intro x hx
        have hnil : x ∈ nilradical (G.presheaf.stalk γ) := by
          rw [nilradical_eq_sInf, Ideal.mem_sInf]
          intro J hJ
          rw [hprime J hJ]
          exact hx
        exact (Ideal.mem_bot).mpr (IsReduced.eq_zero x (mem_nilradical.mp hnil))
      have hF : IsField (G.presheaf.stalk γ) := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hmax
      refine ⟨hF.isDomain, ?_⟩
      letI := hF.toField
      infer_instance
    · obtain ⟨γ', hγ'⟩ := QuasiSober.sober (isIrreducible_irreducibleComponent (x := γ))
        isClosed_irreducibleComponent
      refine ⟨γ', fun γ'' h'' => ?_, hγ'.specializes mem_irreducibleComponent⟩
      have hmaxl := (irreducibleComponent_mem_irreducibleComponents γ).2
      have hsub : irreducibleComponent γ ⊆ closure {γ''} := by
        rw [← hγ'.def]
        exact specializes_iff_closure_subset.mp h''
      have h1 := hmaxl isIrreducible_singleton.closure hsub
      have h2 : γ' ⤳ γ'' := by
        rw [specializes_iff_mem_closure, hγ'.def]
        exact h1 (subset_closure rfl)
      exact (h''.antisymm h2).eq

  have hC8 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (X Y G : Scheme.{u}) (v : X ⟶ Spec (.of R)) (a : Y ⟶ X) (p : G ⟶ X) (j : Y ⟶ G), IsOpenImmersion a → IsOpenImmersion j → j ≫ p = a → (∀ z : X, z ∈ Set.range ⇑a ↔ v z ≠ IsLocalRing.closedPoint R) → (∀ γ : G, v (p γ) ≠ IsLocalRing.closedPoint R → γ ∈ Set.range ⇑j) → ∃ V : X.Opens, (V : Set X) = (⇑v ⁻¹' {IsLocalRing.closedPoint R})ᶜ ∧ IsIso (p ∣_ V) := by
    intro R _ _ _ X Y G v a p j ha hj hjp hr hg
    haveI := ha
    haveI := hj
    let V : X.Opens := a.opensRange
    have hV : (V : Set X) = Set.range a := Scheme.Hom.coe_opensRange a
    refine ⟨V, ?_, ?_⟩
    · rw [hV]
      ext z
      simp only [Set.mem_compl_iff, Set.mem_preimage, Set.mem_singleton_iff]
      exact hr z
    · have hrange : Set.range j = Set.range (p ⁻¹ᵁ V).ι := by
        rw [Scheme.Opens.range_ι]
        ext γ₀
        constructor
        · rintro ⟨t, rfl⟩
          show p (j t) ∈ (V : Set X)
          rw [hV, ← Scheme.Hom.comp_apply, hjp]
          exact ⟨t, rfl⟩
        · intro hγ
          apply hg
          have h1 : p γ₀ ∈ (V : Set X) := hγ
          rw [hV] at h1
          exact (hr _).mp h1
      let ej := IsOpenImmersion.isoOfRangeEq j (p ⁻¹ᵁ V).ι hrange
      let ea := IsOpenImmersion.isoOfRangeEq a V.ι (by rw [Scheme.Opens.range_ι, hV])
      have key : ej.hom ≫ (p ∣_ V) = ea.hom := by
        rw [← cancel_mono V.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc,
          IsOpenImmersion.isoOfRangeEq_hom_fac, hjp, IsOpenImmersion.isoOfRangeEq_hom_fac]
      have heq : p ∣_ V = ej.inv ≫ ea.hom := by rw [← key, Iso.inv_hom_id_assoc]
      rw [heq]
      infer_instance

  have hC9 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (X Y G : Scheme.{u}) (v : X ⟶ Spec (.of R)) (a : Y ⟶ X) (p : G ⟶ X) (j : Y ⟶ G), Flat v → IsOpenImmersion a → IsOpenImmersion j → j ≫ p = a → (∀ z : X, z ∈ Set.range ⇑a ↔ v z ≠ IsLocalRing.closedPoint R) → (∀ γ : G, v (p γ) ≠ IsLocalRing.closedPoint R → γ ∈ Set.range ⇑j) → IsClosedMap ⇑p → (∀ γ : G, (∀ γ' : G, γ' ⤳ γ → γ' = γ) → γ ∈ Set.range ⇑j) → Surjective p ∧ (∀ γ : G, (∀ γ' : G, γ' ⤳ γ → γ' = γ) → v (p γ) ≠ IsLocalRing.closedPoint R ∧ ∀ z' : X, z' ⤳ p γ → z' = p γ) ∧ (∀ z : X, (∀ z' : X, z' ⤳ z → z' = z) → ∃ γ₀ : G, (∀ γ : G, p γ = z ↔ γ = γ₀) ∧ (∀ γ' : G, γ' ⤳ γ₀ → γ' = γ₀) ∧ IsIso (p.stalkMap γ₀)) := by
    intro R _ _ _ X Y G v a p j hfl ha hj hjp hr hg hcl hjgen
    haveI := hfl
    haveI := ha
    haveI := hj
    have pa : ∀ t, p (j t) = a t := fun t => by rw [← Scheme.Hom.comp_apply, hjp]
    have hD : ∀ z : X, ∃ z', z' ⤳ z ∧ z' ∈ Set.range a := by
      intro z
      by_cases hz : v z = IsLocalRing.closedPoint R
      · let η : Spec (.of R) := ⟨⊥, Ideal.isPrime_bot⟩
        have hη : η ⤳ v z := by rw [hz]; exact IsLocalRing.specializes_closedPoint η
        obtain ⟨z', hz', hvz'⟩ := Flat.generalizingMap v hη
        refine ⟨z', hz', (hr z').mpr ?_⟩
        rw [hvz']
        intro h0
        exact IsDiscreteValuationRing.not_a_field R (congrArg PrimeSpectrum.asIdeal h0).symm
      · exact ⟨z, specializes_refl z, (hr z).mpr hz⟩
    refine ⟨⟨fun z => ?_⟩, fun γ hγ => ?_, fun z hz => ?_⟩
    · obtain ⟨z', hz', t, rfl⟩ := hD z
      exact hz'.mem_closed hcl.isClosed_range ⟨j t, pa t⟩
    · obtain ⟨t, rfl⟩ := hjgen γ hγ
      refine ⟨by rw [pa]; exact (hr _).mp ⟨t, rfl⟩, fun z' hz' => ?_⟩
      rw [pa] at hz' ⊢
      obtain ⟨t', rfl⟩ := hz'.mem_open a.isOpenEmbedding.isOpen_range ⟨t, rfl⟩
      have htt : t' ⤳ t := a.isOpenEmbedding.isInducing.specializes_iff.mp hz'
      have h1 : j t' = j t := hγ _ (htt.map j.continuous)
      rw [j.isOpenEmbedding.injective h1]
    · obtain ⟨z', hz', t, rfl⟩ := hD z
      have hzz : a t = z := hz _ hz'
      subst hzz
      refine ⟨j t, fun γ₀ => ⟨fun hγ => ?_, fun hγ => by rw [hγ, pa]⟩, fun γ₁ hγ₁ => ?_, ?_⟩
      · have hv : v (p γ₀) ≠ IsLocalRing.closedPoint R := by rw [hγ]; exact (hr _).mp ⟨t, rfl⟩
        obtain ⟨t', rfl⟩ := hg γ₀ hv
        rw [pa] at hγ
        rw [a.isOpenEmbedding.injective hγ]
      · obtain ⟨t'', rfl⟩ := hγ₁.mem_open j.isOpenEmbedding.isOpen_range ⟨t, rfl⟩
        have h1 : t'' ⤳ t := j.isOpenEmbedding.isInducing.specializes_iff.mp hγ₁
        have h2 : a t'' = a t := hz _ (h1.map a.continuous)
        rw [a.isOpenEmbedding.injective h2]
      · have e1 := Scheme.Hom.stalkMap_comp j p t
        have e2 := Scheme.Hom.stalkMap_congr_hom (j ≫ p) a hjp t
        have hiso : IsIso ((j ≫ p).stalkMap t) := by rw [e2]; infer_instance
        rw [e1] at hiso
        have hjs : IsIso (j.stalkMap t) := inferInstance
        exact @IsIso.of_isIso_comp_right _ _ _ _ _ (p.stalkMap (j t)) (j.stalkMap t) hjs hiso

  have hC10 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (N G X : Scheme.{u}) (v : X ⟶ Spec (.of R)) (μ : N ⟶ G) (p : G ⟶ X), IsFinite μ → Surjective μ → (∀ y : G, IsDomain (G.presheaf.stalk y) → IsIntegrallyClosed (G.presheaf.stalk y) → ∃ w : N, (∀ w' : N, μ w' = y ↔ w' = w) ∧ IsIso (μ.stalkMap w)) → (∀ y : N, ∃ y' : N, y' ⤳ y ∧ ∀ g : G, g ⤳ μ y' → g = μ y') → (∀ γ : G, (∀ γ' : G, γ' ⤳ γ → γ' = γ) → IsDomain (G.presheaf.stalk γ) ∧ IsIntegrallyClosed (G.presheaf.stalk γ)) → Surjective p → (∃ V : X.Opens, (V : Set X) = (⇑v ⁻¹' {IsLocalRing.closedPoint R})ᶜ ∧ IsIso (p ∣_ V)) → (∀ γ : G, (∀ γ' : G, γ' ⤳ γ → γ' = γ) → v (p γ) ≠ IsLocalRing.closedPoint R ∧ ∀ z' : X, z' ⤳ p γ → z' = p γ) → (∀ z : X, (∀ z' : X, z' ⤳ z → z' = z) → ∃ γ₀ : G, (∀ γ : G, p γ = z ↔ γ = γ₀) ∧ (∀ γ' : G, γ' ⤳ γ₀ → γ' = γ₀) ∧ IsIso (p.stalkMap γ₀)) → (Surjective (μ ≫ p) ∧ (∃ V : X.Opens, (V : Set X) = (⇑v ⁻¹' {IsLocalRing.closedPoint R})ᶜ ∧ IsFinite ((μ ≫ p) ∣_ V)) ∧ (∀ y : N, (∀ y' : N, y' ⤳ y → y' = y) → ∀ z' : X, z' ⤳ (μ ≫ p) y → z' = (μ ≫ p) y) ∧ (∀ z : X, (∀ z' : X, z' ⤳ z → z' = z) → ∃ y : N, (∀ y' : N, (μ ≫ p) y' = z ↔ y' = y) ∧ IsIso ((μ ≫ p).stalkMap y))) ∧ ∀ x : N, ∃ x' : N, x' ⤳ x ∧ (μ ≫ p ≫ v) x' ≠ IsLocalRing.closedPoint R := by
    intro R _ _ _ N G X v μ p hfin hsurj hNL hgz hGgen hpsurj hV hGP hXgen
    refine ⟨⟨?_, ?_, ?_, ?_⟩, ?_⟩
    · haveI := hsurj
      haveI := hpsurj
      infer_instance
    · obtain ⟨V, hV1, hV2⟩ := hV
      refine ⟨V, hV1, ?_⟩
      haveI := hfin
      haveI := hV2
      rw [morphismRestrict_comp]
      have hf1 : IsFinite (μ ∣_ p ⁻¹ᵁ V) := inferInstance
      have hf2 : IsFinite (p ∣_ V) := inferInstance
      exact MorphismProperty.comp_mem (@AlgebraicGeometry.IsFinite) _ _ hf1 hf2
    · intro y hy
      obtain ⟨y', hy', hgen⟩ := hgz y
      have hyy : y' = y := hy y' hy'
      subst hyy
      intro z' hz'
      rw [Scheme.Hom.comp_apply] at hz' ⊢
      exact (hGP (μ y') hgen).2 z' hz'
    · intro z hz
      obtain ⟨γ₀, hfib, hgen0, hiso⟩ := hXgen z hz
      obtain ⟨hd, hic⟩ := hGgen γ₀ hgen0
      obtain ⟨w, hw, hwiso⟩ := hNL γ₀ hd hic
      refine ⟨w, fun y' => ?_, ?_⟩
      · rw [Scheme.Hom.comp_apply, hfib, hw]
      · have hw0 : μ w = γ₀ := (hw w).mpr rfl
        rw [Scheme.Hom.stalkMap_comp]
        have hp1 : IsIso (p.stalkMap (μ w)) := by rw [hw0]; exact hiso
        exact @IsIso.comp_isIso _ _ _ _ _ _ _ hp1 hwiso
    · intro x
      obtain ⟨x', hx', hgen⟩ := hgz x
      refine ⟨x', hx', ?_⟩
      simp only [Scheme.Hom.comp_apply]
      exact (hGP (μ x') hgen).1

  intro R _ _ _ Z Z' Y G u u' n τ τ' π a a' h ι j γ γ' hcomp hPr hH
  classical
  obtain ⟨hn, hst, hst', hgc, hgc', hpb, hpb', hsec, hι, hGr, hj, hjd, hjι, hjr, -⟩ := id hH
  have hNag : wcpaDjNccNagata.{u} := hPr.2.2.2.2.1
  haveI hup : IsProper u := hst.1.2.1
  haveI hup' : IsProper u' := hst'.1.2.1
  haveI := hι
  haveI := hj
  haveI := hGr
  have hcondpt : ∀ g : ↥(Limits.pullback u u'),
      u (Limits.pullback.fst u u' g) = u' (Limits.pullback.snd u u' g) := fun g => by
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  haveI hsP : IsProper (ι ≫ Limits.pullback.fst u u' ≫ u) := inferInstance
  obtain ⟨X, g, hqc, hqs, hL⟩ := hC1 R G (ι ≫ Limits.pullback.fst u u' ≫ u)
  haveI := hqc
  haveI := hqs
  obtain ⟨hnoeth, hfin, hnds⟩ :=
    hC2 R hcomp hNag G (ι ≫ Limits.pullback.fst u u' ≫ u) hsP hGr X g hL
  have hloc : ∀ V : G.affineOpens, letI := (g.app V).hom.toAlgebra; ∀ (p : Ideal Γ(G, V)) [p.IsPrime], IsDomain (Localization.AtPrime p) → IsIntegrallyClosed (Localization.AtPrime p) → ∃ (Q : Ideal (integralClosure Γ(G, V) Γ(X, g ⁻¹ᵁ V))) (_ : Q.IsPrime) (hQ : p = Q.comap (algebraMap Γ(G, V) (integralClosure Γ(G, V) Γ(X, g ⁻¹ᵁ V)))), (∀ Q' : Ideal (integralClosure Γ(G, V) Γ(X, g ⁻¹ᵁ V)), Q'.IsPrime → Q'.comap (algebraMap Γ(G, V) (integralClosure Γ(G, V) Γ(X, g ⁻¹ᵁ V))) = p → Q' = Q) ∧ Function.Bijective (Localization.localRingHom p Q (algebraMap Γ(G, V) (integralClosure Γ(G, V) Γ(X, g ⁻¹ᵁ V))) hQ) := by
    intro V
    letI := (g.app V).hom.toAlgebra
    haveI := hnoeth V
    obtain ⟨hinj, hcond⟩ :=
      wcpa_dj_nccw_gn_local_normal_conductor Γ(G, V) Γ(X, g ⁻¹ᵁ V) (hL V)
    exact fun p hp hd hic => by
      haveI := hp
      exact wcpa_dj_nccw_gn_unique_prime_over Γ(G, V) (integralClosure Γ(G, V) Γ(X, g ⁻¹ᵁ V))
        hinj p (hcond p hd hic)
  have hNL : nccwsuNL (Scheme.Hom.fromNormalization g) :=
    wcpa_dj_nccw_gn_normal_locus X G g hloc
  obtain ⟨hGgen, hGsp⟩ := hC7 G hGr
  have hgz := hC6 X G g hnoeth hL
  haveI : IsLocallyNoetherian G :=
    LocallyOfFiniteType.isLocallyNoetherian (ι ≫ Limits.pullback.fst u u' ≫ u)
  have hjgen : ∀ γ₀ : G, (∀ γ'' : G, γ'' ⤳ γ₀ → γ'' = γ₀) → γ₀ ∈ Set.range j := by
    intro γ₀ hγ₀
    obtain ⟨ξ, hξ, hξγ⟩ :=
      wcpa_dj_lqg_generization G (Set.range j) j.isOpenEmbedding.isOpen_range hjd γ₀
    rw [← hγ₀ ξ hξγ]
    exact hξ
  haveI := hfin
  have hsurj : Surjective (Scheme.Hom.fromNormalization g) := by
    refine ⟨fun γ₀ => ?_⟩
    obtain ⟨γ₁, hγ₁gen, hγ₁⟩ := hGsp γ₀
    obtain ⟨hd, hic⟩ := hGgen γ₁ hγ₁gen
    obtain ⟨w, hw, -⟩ := hNL γ₁ hd hic
    exact hγ₁.mem_closed (Scheme.Hom.fromNormalization g).isClosedMap.isClosed_range
      ⟨w, (hw w).mpr rfl⟩
  haveI ha : IsOpenImmersion a :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip (wcpa_dj_ldx_gen_open_immersion R)
  haveI ha' : IsOpenImmersion a' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb'.flip (wcpa_dj_ldx_gen_open_immersion R)
  have e1 : j ≫ ι ≫ Limits.pullback.fst u u' = a := by
    rw [← Category.assoc, hjι, Limits.pullback.lift_fst]
  have e2 : j ≫ ι ≫ Limits.pullback.snd u u' = a' := by
    rw [← Category.assoc, hjι, Limits.pullback.lift_snd]
  have hr1 := wcpa_dj_ldx_range_generic R Z Y u π a hpb
  have hr2 := wcpa_dj_ldx_range_generic R Z' Y u' π a' hpb'
  have hgr1 : ∀ γ₀ : G, u ((ι ≫ Limits.pullback.fst u u') γ₀) ≠ IsLocalRing.closedPoint R →
      γ₀ ∈ Set.range j :=
    wcpa_dj_ldx_ncds_generic_in_range R Z Z' u u' inferInstance Y π a a' h hpb G ι j hι hjd hjι
  have hgr2 : ∀ γ₀ : G, u' ((ι ≫ Limits.pullback.snd u u') γ₀) ≠ IsLocalRing.closedPoint R →
      γ₀ ∈ Set.range j := by
    intro γ₀ hγ₀
    apply hgr1
    have hc := hcondpt (ι γ₀)
    simp only [Scheme.Hom.comp_apply] at hγ₀ ⊢
    rw [hc]
    exact hγ₀
  have hcl1 : IsClosedMap ⇑(ι ≫ Limits.pullback.fst u u') :=
    (ι ≫ Limits.pullback.fst u u').isClosedMap
  have hcl2 : IsClosedMap ⇑(ι ≫ Limits.pullback.snd u u') :=
    (ι ≫ Limits.pullback.snd u u').isClosedMap
  have hiso1 := hC8 R Z Y G u a (ι ≫ Limits.pullback.fst u u') j ha hj e1 hr1 hgr1
  have hiso2 := hC8 R Z' Y G u' a' (ι ≫ Limits.pullback.snd u u') j ha' hj e2 hr2 hgr2
  obtain ⟨hps1, hGP1, hXg1⟩ :=
    hC9 R Z Y G u a (ι ≫ Limits.pullback.fst u u') j hst.1.1 ha hj e1 hr1 hgr1 hcl1 hjgen
  obtain ⟨hps2, hGP2, hXg2⟩ :=
    hC9 R Z' Y G u' a' (ι ≫ Limits.pullback.snd u u') j hst'.1.1 ha' hj e2 hr2 hgr2 hcl2 hjgen
  obtain ⟨hBir1, hGEN1⟩ := hC10 R _ G Z u (Scheme.Hom.fromNormalization g)
    (ι ≫ Limits.pullback.fst u u') hfin hsurj hNL hgz hGgen hps1 hiso1 hGP1 hXg1
  obtain ⟨hBir2, -⟩ := hC10 R _ G Z' u' (Scheme.Hom.fromNormalization g)
    (ι ≫ Limits.pullback.snd u u') hfin hsurj hNL hgz hGgen hps2 hiso2 hGP2 hXg2
  refine ⟨Scheme.Hom.normalization g, Scheme.Hom.fromNormalization g, hfin, hsurj, hnds, hNL, ?_,
    hBir1, hBir2⟩
  intro x
  obtain ⟨x', h1, h2⟩ := hGEN1 x
  exact ⟨x', h1, by simpa only [Scheme.Hom.comp_apply] using h2⟩

theorem nccwrn_ring_finite : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A], (∀ P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}, IsField (Localization.AtPrime P.1.asIdeal)) → (∀ (P : Ideal A) [P.IsPrime], Module.Finite (A ⧸ P) (integralClosure (A ⧸ P) (FractionRing (A ⧸ P)))) → ∀ (C : Type u) [CommRing C] [Algebra A C], Nonempty (C ≃ₐ[A] ↥(integralClosure A ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal))) → Module.Finite A C :=
by
  intro A _ _ hF hN C _ _ ⟨e⟩
  classical
  have r1 : ∀ (P : Ideal A) [P.IsPrime], IsField (Localization.AtPrime P) →
      ∃ ψ : Localization.AtPrime P →ₐ[A] FractionRing (A ⧸ P), Function.Injective ψ := by
    intro P _ hP
    have hunit : ∀ y : P.primeCompl,
        IsUnit ((Algebra.ofId A (FractionRing (A ⧸ P))) (y : A)) := by
      intro y
      apply isUnit_iff_ne_zero.mpr
      rw [Algebra.ofId_apply, IsScalarTower.algebraMap_apply A (A ⧸ P) (FractionRing (A ⧸ P))]
      intro h
      have h1 := IsFractionRing.injective (A ⧸ P) (FractionRing (A ⧸ P))
        (h.trans (map_zero _).symm)
      rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem] at h1
      exact y.2 h1
    let ψ : Localization.AtPrime P →ₐ[A] FractionRing (A ⧸ P) :=
      IsLocalization.liftAlgHom (M := P.primeCompl) (S := Localization.AtPrime P) hunit
    refine ⟨ψ, ?_⟩
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hne
    obtain ⟨b, hb⟩ := hP.mul_inv_cancel hne
    have h2 : ψ (x * b) = 1 := by rw [hb, map_one]
    rw [map_mul, hx, zero_mul] at h2
    exact zero_ne_one h2
  haveI : Finite (minimalPrimes A) := (minimalPrimes.finite_of_isNoetherianRing A).to_subtype
  haveI hι : Finite {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A} :=
    Finite.of_injective (fun P => (⟨P.1.asIdeal, P.2⟩ : minimalPrimes A)) (by
      intro P Q h
      apply Subtype.ext
      apply PrimeSpectrum.ext
      exact congrArg Subtype.val h)
  have hψ : ∀ P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A},
      ∃ ψ : Localization.AtPrime P.1.asIdeal →ₐ[A] FractionRing (A ⧸ P.1.asIdeal),
        Function.Injective ψ := fun P => r1 P.1.asIdeal (hF P)
  choose ψ hψinj using hψ
  haveI hfin : ∀ P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A},
      Module.Finite A (integralClosure (A ⧸ P.1.asIdeal) (FractionRing (A ⧸ P.1.asIdeal))) :=
    fun P => by
      haveI := hN P.1.asIdeal
      exact Module.Finite.trans (A ⧸ P.1.asIdeal) _
  have hmem : ∀ (x : integralClosure A ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) →
      Localization.AtPrime P.1.asIdeal)) (P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}),
      ψ P (x.1 P) ∈ integralClosure (A ⧸ P.1.asIdeal) (FractionRing (A ⧸ P.1.asIdeal)) := by
    intro x P
    have h1 : IsIntegral A x.1 := x.2
    have h2 : IsIntegral A (x.1 P) :=
      h1.map (Pi.evalAlgHom A (fun P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A} =>
        Localization.AtPrime P.1.asIdeal) P)
    have h3 : IsIntegral A (ψ P (x.1 P)) := h2.map (ψ P)
    exact h3.tower_top
  let g : integralClosure A ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) →
      Localization.AtPrime P.1.asIdeal) →ₗ[A]
      ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) →
        integralClosure (A ⧸ P.1.asIdeal) (FractionRing (A ⧸ P.1.asIdeal))) :=
    { toFun := fun x P => ⟨ψ P (x.1 P), hmem x P⟩
      map_add' := by
        intro x y
        funext P
        apply Subtype.ext
        simp
      map_smul' := by
        intro a x
        funext P
        apply Subtype.ext
        simp }
  have hinj : Function.Injective g := by
    intro x y h
    apply Subtype.ext
    funext P
    have h' := congrArg (fun f => (f P).1) h
    exact hψinj P h'
  haveI : IsNoetherian A ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) →
      integralClosure (A ⧸ P.1.asIdeal) (FractionRing (A ⧸ P.1.asIdeal))) :=
    isNoetherian_of_isNoetherianRing_of_finite _ _
  haveI hC : Module.Finite A (integralClosure A
      ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) →
        Localization.AtPrime P.1.asIdeal)) := Module.Finite.of_injective g hinj
  exact Module.Finite.equiv e.symm.toLinearEquiv

theorem nccwrn_ring_stalks_normal : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A], (∀ P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}, IsField (Localization.AtPrime P.1.asIdeal)) → ∀ (C : Type u) [CommRing C] [Algebra A C], Nonempty (C ≃ₐ[A] ↥(integralClosure A ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal))) → ∀ Q : PrimeSpectrum C, IsDomain (Localization.AtPrime Q.asIdeal) ∧ IsIntegrallyClosed (Localization.AtPrime Q.asIdeal) :=
by
  intro A _ _ hF C _ _ ⟨f⟩ Q
  classical

  have s1 : ∀ (j : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A})
      (z : Localization.AtPrime j.1.asIdeal), z = 0 ∨ IsUnit z := by
    intro j z
    by_cases hz : z = 0
    · exact Or.inl hz
    · right
      obtain ⟨b, hb⟩ := (hF j).mul_inv_cancel hz
      exact IsUnit.of_mul_eq_one b hb

  have s2 : ∀ (ι : Type u) (K : ι → Type u) [∀ i, CommRing (K i)] [∀ i, Algebra A (K i)]
      [DecidableEq ι] (j : ι) (w : K j), IsIntegral A w →
      IsIntegral A (Pi.single j w : (i : ι) → K i) := by
    intro ι K _ _ _ j w hw
    obtain ⟨p, hp, hpw⟩ := hw
    refine ⟨Polynomial.X * p, Polynomial.monic_X.mul hp, ?_⟩
    rw [← Polynomial.aeval_def]
    have key : ∀ i, (Polynomial.aeval (Pi.single j w : (i : ι) → K i) p) i =
        Polynomial.aeval ((Pi.single j w : (i : ι) → K i) i) p := fun i =>
      (Polynomial.aeval_algHom_apply (Pi.evalAlgHom A K i) _ p).symm
    rw [map_mul, Polynomial.aeval_X]
    funext i
    rw [Pi.mul_apply, key i, Pi.zero_apply]
    by_cases hij : i = j
    · rw [hij, Pi.single_eq_same, Polynomial.aeval_def, hpw, mul_zero]
    · rw [Pi.single_eq_of_ne hij, zero_mul]

  have s3 : ∀ (B K : Type u) [CommRing B] [CommRing K] [Nontrivial K], (∀ z : K, z = 0 ∨ IsUnit z) →
      ∀ (ρ : B →+* K) (Q : Ideal B) [Q.IsPrime] (ε : B), ε ∉ Q → (∀ b : B, ρ b = 0 → b * ε = 0) →
      (∀ z : K, ∃ x y : B, ρ y ≠ 0 ∧ z * ρ y = ρ x) →
      (∀ z : K, ρ.IsIntegralElem z → ∃ b : B, ρ b = z) →
      IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q) := by
    intro B K _ _ _ h0u ρ Q hQ ε hε hker hfrac hint
    have hfield : IsField K := by
      refine ⟨exists_pair_ne K, fun a b => mul_comm a b, fun {a} ha => ?_⟩
      rcases h0u a with h | h
      · exact absurd h ha
      · exact h.exists_right_inv
    haveI : IsDomain K := hfield.isDomain
    have hne : ∀ s : B, s ∉ Q → ρ s ≠ 0 := by
      intro s hs h
      have h1 := hker s h
      rcases hQ.mem_or_mem (show s * ε ∈ Q by rw [h1]; exact Q.zero_mem) with h2 | h2
      · exact hs h2
      · exact hε h2
    have hunit : ∀ s : Q.primeCompl, IsUnit (ρ s) := fun s =>
      (h0u _).resolve_left (hne s.1 s.2)
    let ψ : Localization.AtPrime Q →+* K := IsLocalization.lift (M := Q.primeCompl) hunit
    have hψ : ∀ b, ψ (algebraMap B (Localization.AtPrime Q) b) = ρ b := fun b =>
      IsLocalization.lift_eq hunit b
    have hψinj : Function.Injective ψ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl z
      have hspec := IsLocalization.mk'_spec (Localization.AtPrime Q) b s
      have h1 : ψ (IsLocalization.mk' (Localization.AtPrime Q) b s) *
          ψ (algebraMap B (Localization.AtPrime Q) s) = ψ (algebraMap B (Localization.AtPrime Q) b) := by
        rw [← map_mul, hspec]
      rw [hz, zero_mul, hψ] at h1
      have h2 := hker b h1.symm
      have h3 : algebraMap B (Localization.AtPrime Q) b * algebraMap B (Localization.AtPrime Q) ε = 0 := by
        rw [← map_mul, h2, map_zero]
      have hu : IsUnit (algebraMap B (Localization.AtPrime Q) ε) :=
        IsLocalization.map_units (Localization.AtPrime Q) (⟨ε, hε⟩ : Q.primeCompl)
      have h4 : algebraMap B (Localization.AtPrime Q) b = 0 := hu.mul_left_eq_zero.mp h3
      show IsLocalization.mk' (Localization.AtPrime Q) b s = 0
      rw [IsLocalization.mk'_eq_mul_mk'_one, h4, zero_mul]
    haveI hdom : IsDomain (Localization.AtPrime Q) := Function.Injective.isDomain ψ hψinj
    refine ⟨hdom, ?_⟩
    letI : Algebra (Localization.AtPrime Q) K := ψ.toAlgebra
    haveI : IsFractionRing (Localization.AtPrime Q) K := by
      refine ⟨?_, ?_, ?_⟩
      · intro y
        apply (h0u _).resolve_left
        show ψ y ≠ 0
        intro h
        exact nonZeroDivisors.ne_zero y.2 (hψinj (h.trans (map_zero ψ).symm))
      · intro z
        obtain ⟨x, y, hy, hz⟩ := hfrac z
        have hy' : algebraMap B (Localization.AtPrime Q) y ∈ nonZeroDivisors (Localization.AtPrime Q) := by
          apply mem_nonZeroDivisors_of_ne_zero
          intro h
          apply hy
          rw [← hψ, h, map_zero]
        refine ⟨⟨algebraMap B _ x, ⟨_, hy'⟩⟩, ?_⟩
        show z * ψ (algebraMap B _ y) = ψ (algebraMap B _ x)
        rw [hψ, hψ, hz]
      · intro x y h
        exact ⟨1, by rw [hψinj h]⟩
    letI : Algebra B K := ρ.toAlgebra
    haveI : IsScalarTower B (Localization.AtPrime Q) K :=
      IsScalarTower.of_algebraMap_eq (fun b => (hψ b).symm)
    rw [isIntegrallyClosed_iff K]
    intro z hz
    obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization Q.primeCompl z hz
    rw [Submonoid.smul_def, Algebra.smul_def] at hm
    obtain ⟨b, hb⟩ := hint _ hm
    refine ⟨IsLocalization.mk' (Localization.AtPrime Q) b m, ?_⟩
    show ψ (IsLocalization.mk' _ b m) = z
    have hmne : ρ m ≠ 0 := hne m.1 m.2
    apply mul_right_cancel₀ hmne
    have e1 : ψ (IsLocalization.mk' (Localization.AtPrime Q) b m) * ρ m = ρ b := by
      rw [← hψ m, ← map_mul, IsLocalization.mk'_spec, hψ]
    rw [e1, hb]
    exact mul_comm _ _

  have hB : ∀ (L : Type u) [CommRing L] [Algebra A L],
      (L ≃ₐ[A] ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) →
        Localization.AtPrime P.1.asIdeal)) →
      ∀ (Q : Ideal (integralClosure A L)) [Q.IsPrime],
        IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q) := by
    intro L _ _ e Q _
    let ι := {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}
    haveI : Finite ι := by
      haveI := (minimalPrimes.finite_of_isNoetherianRing A).to_subtype
      refine Finite.of_injective (fun P : ι => (⟨P.1.asIdeal, P.2⟩ : minimalPrimes A)) ?_
      intro P Q h
      exact Subtype.ext (PrimeSpectrum.ext (congrArg Subtype.val h))
    haveI : Fintype ι := Fintype.ofFinite ι
    let K := fun i : ι => Localization.AtPrime i.1.asIdeal
    have hεint : ∀ i : ι, IsIntegral A (e.symm (Pi.single i 1)) := fun i =>
      (s2 ι K i 1 isIntegral_one).map e.symm
    let εB : ι → integralClosure A L := fun i => ⟨e.symm (Pi.single i 1), hεint i⟩
    have hsum : ∑ i, εB i = 1 := by
      apply Subtype.ext
      rw [AddSubmonoidClass.coe_finset_sum]
      show ∑ i, e.symm (Pi.single i 1) = 1
      have h1 : ∑ i, (Pi.single i 1 : (i : ι) → K i) = 1 := Finset.univ_sum_single 1
      rw [← map_sum, h1, map_one]
    obtain ⟨j, hj⟩ : ∃ j, εB j ∉ Q := by
      by_contra h
      push_neg at h
      apply ‹Q.IsPrime›.ne_top
      rw [Ideal.eq_top_iff_one, ← hsum]
      exact Ideal.sum_mem Q (fun i _ => h i)
    let ρA : integralClosure A L →ₐ[A] Localization.AtPrime j.1.asIdeal :=
      (Pi.evalAlgHom A K j).comp (e.toAlgHom.comp (integralClosure A L).val)
    let ρ : integralClosure A L →+* Localization.AtPrime j.1.asIdeal := ρA.toRingHom
    have hρA : ∀ a : A, ρ (algebraMap A (integralClosure A L) a) =
        algebraMap A (Localization.AtPrime j.1.asIdeal) a := fun a => ρA.commutes a
    have hker : ∀ b : integralClosure A L, ρ b = 0 → b * εB j = 0 := by
      intro b hb
      apply Subtype.ext
      apply e.injective
      show e (b.1 * e.symm (Pi.single j 1)) = e 0
      rw [map_mul, e.apply_symm_apply, map_zero]
      funext i
      rw [Pi.mul_apply, Pi.zero_apply]
      by_cases hij : i = j
      · rw [hij, Pi.single_eq_same, mul_one]
        exact hb
      · rw [Pi.single_eq_of_ne hij, mul_zero]
    have hfrac : ∀ z : Localization.AtPrime j.1.asIdeal, ∃ x y : integralClosure A L,
        ρ y ≠ 0 ∧ z * ρ y = ρ x := by
      intro z
      obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective j.1.asIdeal.primeCompl z
      refine ⟨algebraMap A _ a, algebraMap A _ t, ?_, ?_⟩
      · rw [hρA]
        exact (IsLocalization.map_units (Localization.AtPrime j.1.asIdeal) t).ne_zero
      · rw [hρA, hρA]
        exact IsLocalization.mk'_spec (Localization.AtPrime j.1.asIdeal) a t
    have hint : ∀ z : Localization.AtPrime j.1.asIdeal, ρ.IsIntegralElem z →
        ∃ b : integralClosure A L, ρ b = z := by
      intro z hz
      letI : Algebra (integralClosure A L) (Localization.AtPrime j.1.asIdeal) := ρ.toAlgebra
      haveI : IsScalarTower A (integralClosure A L) (Localization.AtPrime j.1.asIdeal) :=
        IsScalarTower.of_algebraMap_eq (fun a => (hρA a).symm)
      have hz' : IsIntegral (integralClosure A L) z := hz
      have hzA : IsIntegral A z := isIntegral_trans z hz'
      have hl : IsIntegral A (e.symm (Pi.single j z)) := (s2 ι K j z hzA).map e.symm
      refine ⟨⟨e.symm (Pi.single j z), hl⟩, ?_⟩
      show e (e.symm (Pi.single j z)) j = z
      rw [e.apply_symm_apply, Pi.single_eq_same]
    exact s3 (integralClosure A L) (Localization.AtPrime j.1.asIdeal) (s1 j) ρ Q
      (εB j) hj hker hfrac hint

  have hmain := hB _ AlgEquiv.refl
  let e := f.toRingEquiv
  let Q' := Ideal.comap e.symm.toRingHom Q.asIdeal
  haveI : Q'.IsPrime := Ideal.comap_isPrime _ _
  have H : Submonoid.map e.toMonoidHom Q.asIdeal.primeCompl = Q'.primeCompl := by
    ext x
    rw [Submonoid.mem_map]
    constructor
    · rintro ⟨c, hc, rfl⟩
      rw [Ideal.mem_primeCompl_iff] at hc ⊢
      intro h
      apply hc
      have h' : e.symm.toRingHom (e.toMonoidHom c) ∈ Q.asIdeal := Ideal.mem_comap.mp h
      have h'' : e.symm.toRingHom (e.toMonoidHom c) = c := e.symm_apply_apply c
      rw [h''] at h'
      exact h'
    · intro hx
      rw [Ideal.mem_primeCompl_iff] at hx
      refine ⟨e.symm x, ?_, ?_⟩
      · rw [Ideal.mem_primeCompl_iff]
        exact fun h => hx (Ideal.mem_comap.mpr h)
      · exact e.apply_symm_apply x
  let g := IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime Q.asIdeal)
    (Localization.AtPrime Q') e H
  obtain ⟨hd, hic⟩ := hmain Q'
  haveI := hd
  haveI := hic
  exact ⟨MulEquiv.isDomain (Localization.AtPrime Q') g.toMulEquiv,
    IsIntegrallyClosed.of_equiv (R := Localization.AtPrime Q') (S := Localization.AtPrime Q.asIdeal)
      g.symm⟩

theorem nccwrn_ring_normal_point : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A], (∀ P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}, IsField (Localization.AtPrime P.1.asIdeal)) → ∀ (C : Type u) [CommRing C] [Algebra A C], Nonempty (C ≃ₐ[A] ↥(integralClosure A ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal))) → ∀ p : PrimeSpectrum A, IsDomain (Localization.AtPrime p.asIdeal) → IsIntegrallyClosed (Localization.AtPrime p.asIdeal) → ∃ Q : PrimeSpectrum C, ∃ hQ : p.asIdeal = Q.asIdeal.comap (algebraMap A C), (∀ Q' : PrimeSpectrum C, Q'.asIdeal.comap (algebraMap A C) = p.asIdeal → Q' = Q) ∧ Function.Bijective (Localization.localRingHom p.asIdeal Q.asIdeal (algebraMap A C) hQ) :=
by
  have s1 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (hfield : ∀ P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}, IsField (Localization.AtPrime P.1.asIdeal)) (p : Ideal A) [p.IsPrime] (hdom : IsDomain (Localization.AtPrime p)), ∃ i₀ : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}, i₀.1.asIdeal = RingHom.ker (algebraMap A (Localization.AtPrime p)) ∧ ∃ t : A, t ∉ p ∧ ∀ P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}, P ≠ i₀ → algebraMap A (Localization.AtPrime P.1.asIdeal) t = 0 := by
    intro A _ _ hfield p _ hdom
    classical
    set K := RingHom.ker (algebraMap A (Localization.AtPrime p)) with hKdef
    haveI hKp : K.IsPrime := RingHom.ker_isPrime _
    have hzero : ∀ a, a ∈ K → ∃ s : A, s ∉ p ∧ s * a = 0 := by
      intro a ha
      rw [RingHom.mem_ker] at ha
      obtain ⟨⟨s, hs⟩, h⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl _ a).mp ha
      exact ⟨s, hs, h⟩
    have habs : ∀ P' : Ideal A, P' ≤ p → P'.IsPrime → K ≤ P' := by
      intro P' hP' hP'p a ha
      obtain ⟨s, hs, h⟩ := hzero a ha
      have h1 : s * a ∈ P' := by rw [h]; exact P'.zero_mem
      exact (hP'p.mem_or_mem h1).resolve_left (fun h' => hs (hP' h'))
    have hKle : K ≤ p := by
      intro a ha
      obtain ⟨s, hs, h⟩ := hzero a ha
      have h1 : s * a ∈ p := by rw [h]; exact p.zero_mem
      exact ((inferInstance : p.IsPrime).mem_or_mem h1).resolve_left hs
    have hKmin : K ∈ minimalPrimes A := by
      refine ⟨⟨hKp, bot_le⟩, fun P' hP' hP'K => ?_⟩
      exact habs P' (hP'K.trans hKle) hP'.1
    let i₀ : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A} := ⟨⟨K, hKp⟩, hKmin⟩
    have hesc : ∀ P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}, P ≠ i₀ →
        ∃ s, s ∈ P.1.asIdeal ∧ s ∉ p := by
      intro P hP
      by_contra hcon
      push_neg at hcon
      have h1 : K ≤ P.1.asIdeal := habs _ hcon P.1.isPrime
      have h2 : P.1.asIdeal ≤ K := P.2.2 ⟨hKp, bot_le⟩ h1
      exact hP (Subtype.ext (PrimeSpectrum.ext (le_antisymm h2 h1)))
    have hdie : ∀ P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}, ∀ s ∈ P.1.asIdeal,
        algebraMap A (Localization.AtPrime P.1.asIdeal) s = 0 := by
      intro P s hs
      by_contra hne
      obtain ⟨y, hy⟩ := (hfield P).mul_inv_cancel hne
      have hu : IsUnit (algebraMap A (Localization.AtPrime P.1.asIdeal) s) :=
        ⟨⟨_, y, hy, by rw [mul_comm]; exact hy⟩, rfl⟩
      rw [IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime P.1.asIdeal) P.1.asIdeal] at hu
      exact hu hs
    haveI hfin : Finite {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A} := by
      haveI : Finite (minimalPrimes A) := (minimalPrimes.finite_of_isNoetherianRing A).to_subtype
      refine Finite.of_injective (fun P => (⟨P.1.asIdeal, P.2⟩ : minimalPrimes A)) ?_
      intro P P' h
      exact Subtype.ext (PrimeSpectrum.ext (congrArg Subtype.val h))
    letI : Fintype {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A} := Fintype.ofFinite _
    choose! sP hsPmem hsPnot using hesc
    refine ⟨i₀, rfl, ∏ P ∈ Finset.univ.erase i₀, sP P, ?_, ?_⟩
    · intro hmem
      obtain ⟨P, hP, hPp⟩ := (Ideal.IsPrime.prod_mem_iff (p := p)).mp hmem
      exact hsPnot P (Finset.ne_of_mem_erase hP) hPp
    · intro P hP
      obtain ⟨r, hr⟩ := Finset.dvd_prod_of_mem sP (Finset.mem_erase.mpr ⟨hP, Finset.mem_univ P⟩)
      rw [hr, map_mul, hdie P _ (hsPmem P hP), zero_mul]
  have s2 : ∀ (A : Type u) [CommRing A] (p P₀ : Ideal A) [p.IsPrime] [P₀.IsPrime] (hdom : IsDomain (Localization.AtPrime p)) (hic : IsIntegrallyClosed (Localization.AtPrime p)) (hK : P₀ = RingHom.ker (algebraMap A (Localization.AtPrime p))), ∃ j : Localization.AtPrime p →+* Localization.AtPrime P₀, j.comp (algebraMap A (Localization.AtPrime p)) = algebraMap A (Localization.AtPrime P₀) ∧ Function.Injective j ∧ ∀ f : Localization.AtPrime P₀, IsIntegral A f → ∃ y : Localization.AtPrime p, j y = f := by
    intro A _ p P₀ _ _ hdom hic hK
    classical
    have hmemK : ∀ a, a ∈ P₀ ↔ algebraMap A (Localization.AtPrime p) a = 0 := by
      intro a; rw [hK, RingHom.mem_ker]
    have hle : P₀ ≤ p := by
      intro a ha
      rw [hmemK] at ha
      obtain ⟨⟨s, hs⟩, h⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl _ a).mp ha
      have h1 : s * a ∈ p := by rw [h]; exact p.zero_mem
      exact ((inferInstance : p.IsPrime).mem_or_mem h1).resolve_left hs
    have hmk0 : ∀ (a : A) (s : p.primeCompl), algebraMap A (Localization.AtPrime p) a = 0 →
        IsLocalization.mk' (Localization.AtPrime p) a s = 0 := fun a s h =>
      (IsLocalization.mk'_eq_zero_iff a s).mpr ((IsLocalization.map_eq_zero_iff p.primeCompl _ a).mp h)
    have hunit : ∀ s : p.primeCompl, IsUnit (algebraMap A (Localization.AtPrime P₀) s) := by
      intro s
      rw [IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime P₀) P₀]
      exact fun h => s.2 (hle h)
    let j : Localization.AtPrime p →+* Localization.AtPrime P₀ :=
      IsLocalization.lift (M := p.primeCompl) hunit
    have hj : j.comp (algebraMap A (Localization.AtPrime p)) = algebraMap A (Localization.AtPrime P₀) :=
      IsLocalization.lift_comp hunit
    have hj' : ∀ a, j (algebraMap A (Localization.AtPrime p) a) = algebraMap A (Localization.AtPrime P₀) a :=
      fun a => RingHom.congr_fun hj a
    have hjinj : Function.Injective j := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl x
      have h1 : j (algebraMap A (Localization.AtPrime p) a) = 0 := by
        rw [← IsLocalization.mk'_spec (Localization.AtPrime p) a s, map_mul, hx, zero_mul]
      rw [hj'] at h1
      obtain ⟨⟨u, hu⟩, hua⟩ := (IsLocalization.map_eq_zero_iff P₀.primeCompl _ a).mp h1
      have h2 : u * a ∈ P₀ := by rw [hua]; exact P₀.zero_mem
      have ha : a ∈ P₀ := ((inferInstance : P₀.IsPrime).mem_or_mem h2).resolve_left hu
      exact hmk0 a s ((hmemK a).mp ha)
    refine ⟨j, hj, hjinj, ?_⟩
    letI : Algebra (Localization.AtPrime p) (Localization.AtPrime P₀) := j.toAlgebra
    haveI : IsScalarTower A (Localization.AtPrime p) (Localization.AtPrime P₀) :=
      IsScalarTower.of_algebraMap_eq' hj.symm
    haveI : IsFractionRing (Localization.AtPrime p) (Localization.AtPrime P₀) := by
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨x, hx⟩
        have hx0 : x ≠ 0 := nonZeroDivisors.ne_zero hx
        obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl x
        have ha : a ∉ P₀ := by
          rw [hmemK]
          exact fun h => hx0 (hmk0 a s h)
        have hga : IsUnit (algebraMap A (Localization.AtPrime P₀) a) := by
          rw [IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime P₀) P₀]
          exact ha
        show IsUnit (j (IsLocalization.mk' (Localization.AtPrime p) a s))
        have e : j (IsLocalization.mk' (Localization.AtPrime p) a s) *
            algebraMap A (Localization.AtPrime P₀) s = algebraMap A (Localization.AtPrime P₀) a := by
          rw [← hj', ← hj', ← map_mul, IsLocalization.mk'_spec]
        rw [← e] at hga
        exact isUnit_of_mul_isUnit_left hga
      · intro z
        obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective P₀.primeCompl z
        have hs : algebraMap A (Localization.AtPrime p) s ∈ nonZeroDivisors (Localization.AtPrime p) := by
          apply mem_nonZeroDivisors_of_ne_zero
          exact fun h => s.2 ((hmemK _).mpr h)
        refine ⟨(algebraMap A (Localization.AtPrime p) a, ⟨_, hs⟩), ?_⟩
        show _ * j (algebraMap A (Localization.AtPrime p) s) = j (algebraMap A (Localization.AtPrime p) a)
        rw [hj', hj']
        exact IsLocalization.mk'_spec _ a s
      · intro x y h
        exact ⟨1, by rw [hjinj h]⟩
    intro f hf
    have hf' : IsIntegral (Localization.AtPrime p) f := hf.tower_top
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hf'
    exact ⟨y, hy⟩
  have s3 : ∀ (A : Type u) [CommRing A] (p : Ideal A) [p.IsPrime] (C : Type u) [CommRing C] [Algebra A C] (ι : Type u) (B : ι → Type u) [∀ i, CommRing (B i)] [∀ i, Algebra A (B i)] (θ : C →ₐ[A] ((i : ι) → B i)) (hθ : Function.Injective θ) (hint : ∀ c : C, IsIntegral A (θ c)) (i₀ : ι) (t : A) (ht : t ∉ p) (ht0 : ∀ i : ι, i ≠ i₀ → algebraMap A (B i) t = 0) (j : Localization.AtPrime p →+* B i₀) (hj : j.comp (algebraMap A (Localization.AtPrime p)) = algebraMap A (B i₀)) (hjinj : Function.Injective j) (hjint : ∀ f : B i₀, IsIntegral A f → ∃ y : Localization.AtPrime p, j y = f), ∃ α : C →+* Localization.AtPrime p, α.comp (algebraMap A C) = algebraMap A (Localization.AtPrime p) ∧ ∀ c : C, ∃ u ∈ p.primeCompl, ∃ b : A, algebraMap A C u * c = algebraMap A C b := by
    intro A _ p _ C _ _ ι B _ _ θ hθ hint i₀ t ht ht0 j hj hjinj hjint
    classical
    have hj' : ∀ a, j (algebraMap A (Localization.AtPrime p) a) = algebraMap A (B i₀) a :=
      fun a => RingHom.congr_fun hj a
    have hrange : ∀ c : C, ∃ y, j y = θ c i₀ := fun c =>
      hjint _ ((hint c).map (Pi.evalAlgHom A B i₀))
    choose α₀ hα₀ using hrange
    let α : C →+* Localization.AtPrime p :=
      { toFun := α₀
        map_one' := hjinj (by simp only [hα₀, map_one, Pi.one_apply])
        map_mul' := fun x y => hjinj (by simp only [hα₀, map_mul, Pi.mul_apply])
        map_zero' := hjinj (by simp only [hα₀, map_zero, Pi.zero_apply])
        map_add' := fun x y => hjinj (by simp only [hα₀, map_add, Pi.add_apply]) }
    have hαj : ∀ c, j (α c) = θ c i₀ := hα₀
    refine ⟨α, ?_, ?_⟩
    · apply RingHom.ext
      intro a
      apply hjinj
      rw [RingHom.comp_apply, hαj, AlgHom.commutes, Pi.algebraMap_apply, hj']
    · intro c
      obtain ⟨⟨b₀, s₀⟩, hbs⟩ := IsLocalization.mk'_surjective p.primeCompl (α c)
      have hs : algebraMap A (Localization.AtPrime p) s₀ * α c = algebraMap A (Localization.AtPrime p) b₀ := by
        rw [← hbs, mul_comm]; exact IsLocalization.mk'_spec _ b₀ s₀
      refine ⟨t * s₀, fun h => ((inferInstance : p.IsPrime).mem_or_mem h).elim ht s₀.2, t * b₀, ?_⟩
      apply hθ
      funext i
      by_cases hi : i = i₀
      · subst hi
        have e := congrArg j hs
        rw [map_mul, hj', hj', hαj] at e
        simp only [map_mul, AlgHom.commutes, Pi.mul_apply, Pi.algebraMap_apply]
        rw [mul_assoc, e]
      · simp only [map_mul, AlgHom.commutes, Pi.mul_apply, Pi.algebraMap_apply, ht0 i hi, zero_mul]
  have s4 : ∀ (A : Type u) [CommRing A] (p : Ideal A) [p.IsPrime] (C : Type u) [CommRing C] [Algebra A C] (α : C →+* Localization.AtPrime p) (hα : α.comp (algebraMap A C) = algebraMap A (Localization.AtPrime p)) (hD : ∀ c : C, ∃ u ∈ p.primeCompl, ∃ b : A, algebraMap A C u * c = algebraMap A C b), ∃ Q : PrimeSpectrum C, ∃ hQ : p = Q.asIdeal.comap (algebraMap A C), (∀ Q' : PrimeSpectrum C, Q'.asIdeal.comap (algebraMap A C) = p → Q' = Q) ∧ Function.Bijective (Localization.localRingHom p Q.asIdeal (algebraMap A C) hQ) := by
    intro A _ p _ C _ _ α hα hD
    classical
    let Q : PrimeSpectrum C := ⟨(IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap α, Ideal.comap_isPrime α _⟩
    have hQ : p = Q.asIdeal.comap (algebraMap A C) := by
      ext a
      show a ∈ p ↔ α (algebraMap A C a) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime p)
      rw [show α (algebraMap A C a) = algebraMap A (Localization.AtPrime p) a from RingHom.congr_fun hα a,
        IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime p) p a]
    have hmem : ∀ Q'' : PrimeSpectrum C, Q''.asIdeal.comap (algebraMap A C) = p → ∀ (c : C) (u b : A),
        u ∈ p.primeCompl → algebraMap A C u * c = algebraMap A C b → (c ∈ Q''.asIdeal ↔ b ∈ p) := by
      intro Q'' hQ'' c u b hu hub
      have hu' : algebraMap A C u ∉ Q''.asIdeal := fun h => hu (by rw [← hQ'']; exact h)
      constructor
      · intro hc
        rw [← hQ'', Ideal.mem_comap, ← hub]
        exact Q''.asIdeal.mul_mem_left _ hc
      · intro hb
        have h1 : algebraMap A C u * c ∈ Q''.asIdeal := by
          rw [hub, ← Ideal.mem_comap, hQ'']; exact hb
        exact (Q''.isPrime.mem_or_mem h1).resolve_left hu'
    refine ⟨Q, hQ, ?_, ?_⟩
    · intro Q' hQ'
      refine PrimeSpectrum.ext (Ideal.ext fun c => ?_)
      obtain ⟨u, hu, b, hub⟩ := hD c
      rw [hmem Q' hQ' c u b hu hub, hmem Q hQ.symm c u b hu hub]
    · have hunit : ∀ y : Q.asIdeal.primeCompl, IsUnit (α y) := by
        intro y
        by_contra h
        exact y.2 ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr h))
      let ψ : Localization.AtPrime Q.asIdeal →+* Localization.AtPrime p :=
        IsLocalization.lift (M := Q.asIdeal.primeCompl) hunit
      have hcomp : ψ.comp (Localization.localRingHom p Q.asIdeal (algebraMap A C) hQ) = RingHom.id _ := by
        apply IsLocalization.ringHom_ext p.primeCompl
        ext a
        simp only [RingHom.comp_apply, Localization.localRingHom_to_map, RingHom.id_apply]
        rw [IsLocalization.lift_eq]
        exact RingHom.congr_fun hα a
      refine ⟨Function.LeftInverse.injective (g := ψ) (fun x => RingHom.congr_fun hcomp x), ?_⟩
      intro z
      obtain ⟨⟨c, v⟩, rfl⟩ := IsLocalization.mk'_surjective Q.asIdeal.primeCompl z
      obtain ⟨u, hu, b, hub⟩ := hD c
      obtain ⟨u', hu', b', hub'⟩ := hD (v : C)
      have hb' : b' ∉ p := by
        intro hb
        have h1 : algebraMap A C b' ∈ Q.asIdeal := by
          rw [← Ideal.mem_comap, ← hQ]; exact hb
        rw [← hub'] at h1
        rcases Q.isPrime.mem_or_mem h1 with h | h
        · exact hu' (by rw [hQ]; exact h)
        · exact v.2 h
      have hub2 : u * b' ∈ p.primeCompl := fun h =>
        ((inferInstance : p.IsPrime).mem_or_mem h).elim hu hb'
      refine ⟨IsLocalization.mk' (Localization.AtPrime p) (b * u') (⟨u * b', hub2⟩ : p.primeCompl), ?_⟩
      rw [Localization.localRingHom_mk', IsLocalization.mk'_eq_iff_eq]
      congr 1
      simp only [map_mul]
      linear_combination (algebraMap A C b) * hub' - (algebraMap A C b') * hub
  intro A _ _ hfield C _ _ ⟨e⟩ p hdom hic
  classical
  obtain ⟨i₀, hK, t, ht, ht0⟩ := s1 A hfield p.asIdeal hdom
  haveI : i₀.1.asIdeal.IsPrime := i₀.1.isPrime
  obtain ⟨j, hj, hjinj, hjint⟩ := s2 A p.asIdeal i₀.1.asIdeal hdom hic hK
  let θ : C →ₐ[A] ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal) :=
    (integralClosure A ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal)).val.comp e.toAlgHom
  have hθ : Function.Injective θ := Subtype.val_injective.comp e.injective
  have hint : ∀ c : C, IsIntegral A (θ c) := fun c => (e c).2
  obtain ⟨α, hα, hD⟩ := s3 A p.asIdeal C _ (fun P => Localization.AtPrime P.1.asIdeal) θ hθ hint i₀ t ht ht0 j hj hjinj hjint
  exact s4 A p.asIdeal C α hα hD

theorem nccwrn_norm_finite : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [QuasiCompact f] [QuasiSeparated f], (∀ (U : Y.Opens), IsAffineOpen U → letI := (f.app U).hom.toAlgebra; Module.Finite Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))) → IsFinite f.fromNormalization :=
by
  intro X Y f _ _ h
  rw [isFinite_iff]
  refine ⟨inferInstance, fun U hU => ?_⟩
  rw [Scheme.Hom.fromNormalization_app f hU, CommRingCat.hom_comp]
  letI := (f.app U).hom.toAlgebra
  exact RingHom.Finite.comp
    (RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso _).2)
    (RingHom.finite_algebraMap.mpr (h U hU))

theorem nccwrn_norm_stalks : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [QuasiCompact f] [QuasiSeparated f], (∀ (U : Y.Opens), IsAffineOpen U → letI := (f.app U).hom.toAlgebra; ∀ Q : PrimeSpectrum ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)), IsDomain (Localization.AtPrime Q.asIdeal) ∧ IsIntegrallyClosed (Localization.AtPrime Q.asIdeal)) → ∀ s : f.normalization, IsDomain (f.normalization.presheaf.stalk s) ∧ IsIntegrallyClosed (f.normalization.presheaf.stalk s) :=
by
  intro X Y f _ _ h s
  have transport : ∀ (B C T : Type u) [CommRing B] [CommRing C] [CommRing T] (_ : Algebra B T)
      (e : B ≃+* C) (P : Ideal B) [P.IsPrime], IsLocalization.AtPrime T P →
      (∀ Q : PrimeSpectrum C, IsDomain (Localization.AtPrime Q.asIdeal) ∧
        IsIntegrallyClosed (Localization.AtPrime Q.asIdeal)) →
      IsDomain T ∧ IsIntegrallyClosed T := by
    intro B C T _ _ _ _ e P _ _ hyp
    have hP' : (P.map e).IsPrime := Ideal.map_isPrime_of_equiv e
    have hM : Submonoid.map e.toMonoidHom P.primeCompl = (P.map e).primeCompl := by
      ext c
      rw [Submonoid.mem_map, Ideal.mem_primeCompl_iff, Ideal.mem_map_of_equiv]
      constructor
      · rintro ⟨b, hb, hbc⟩ ⟨x, hx, hxc⟩
        have : x = b := e.injective (hxc.trans hbc.symm)
        exact hb (this ▸ hx)
      · intro hc
        refine ⟨e.symm c, fun hm => hc ⟨e.symm c, hm, by simp⟩, by simp⟩
    let φ : T ≃+* Localization.AtPrime (P.map e) :=
      IsLocalization.ringEquivOfRingEquiv T (Localization.AtPrime (P.map e)) e hM
    obtain ⟨hD, hI⟩ := hyp ⟨P.map e, hP'⟩
    exact ⟨MulEquiv.isDomain (Localization.AtPrime (P.map e)) φ.toMulEquiv,
      IsIntegrallyClosed.of_equiv φ.symm⟩
  obtain ⟨U, hU, hyU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens)
    (show f.fromNormalization s ∈ (⊤ : Y.Opens) from trivial)
  have hU' : IsAffineOpen U := hU
  have hW : IsAffineOpen (f.fromNormalization ⁻¹ᵁ U) := hU'.preimage f.fromNormalization
  have hs : s ∈ f.fromNormalization ⁻¹ᵁ U := hyU
  have hloc := hW.isLocalization_stalk ⟨s, hs⟩
  letI := (f.app U).hom.toAlgebra
  let e : Γ(f.normalization, f.fromNormalization ⁻¹ᵁ U) ≃+*
      ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)) :=
    (f.normalizationObjIso hU').commRingCatIsoToRingEquiv
  exact transport _ _ _ _ e _ hloc (h U hU')

theorem nccwrn_norm_normal_locus : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [QuasiCompact f] [QuasiSeparated f], (∀ (U : Y.Opens), IsAffineOpen U → letI := (f.app U).hom.toAlgebra; ∀ p : PrimeSpectrum Γ(Y, U), IsDomain (Localization.AtPrime p.asIdeal) → IsIntegrallyClosed (Localization.AtPrime p.asIdeal) → ∃ Q : PrimeSpectrum ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)), ∃ hQ : p.asIdeal = Q.asIdeal.comap (algebraMap Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))), (∀ Q' : PrimeSpectrum ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)), Q'.asIdeal.comap (algebraMap Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))) = p.asIdeal → Q' = Q) ∧ Function.Bijective (Localization.localRingHom p.asIdeal Q.asIdeal (algebraMap Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))) hQ)) → ∀ y : Y, IsDomain (Y.presheaf.stalk y) → IsIntegrallyClosed (Y.presheaf.stalk y) → ∃ w : f.normalization, (∀ w' : f.normalization, f.fromNormalization w' = y ↔ w' = w) ∧ IsIso (f.fromNormalization.stalkMap w) :=
by
  intro X Y f _ _ hH y hdom hic
  have s1 : ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C] (p : PrimeSpectrum A)
      (Q : PrimeSpectrum C) (hQ : p.asIdeal = Q.asIdeal.comap (algebraMap A C)),
      Function.Bijective (Localization.localRingHom p.asIdeal Q.asIdeal (algebraMap A C) hQ) →
      IsIso ((Spec.map (CommRingCat.ofHom (algebraMap A C))).stalkMap Q) := by
    intro A C _ _ _ p Q hQ hbij
    obtain rfl : p = PrimeSpectrum.comap (algebraMap A C) Q := PrimeSpectrum.ext hQ
    have e := Scheme.arrowStalkMapSpecIso (CommRingCat.ofHom (algebraMap A C)) Q
    have h2 : IsIso (CommRingCat.ofHom (Localization.localRingHom
        (PrimeSpectrum.comap (algebraMap A C) Q).asIdeal Q.asIdeal (algebraMap A C) hQ)) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    exact ((MorphismProperty.isomorphisms CommRingCat).arrow_mk_iso_iff e).mpr h2
  obtain ⟨U, hU, hyU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens)
    (show y ∈ (⊤ : Y.Opens) from trivial)
  have hU : IsAffineOpen U := hU
  letI := (f.app U).hom.toAlgebra
  set p := hU.primeIdealOf ⟨y, hyU⟩ with hp
  have hpy : hU.fromSpec p = y := hU.fromSpec_primeIdealOf ⟨y, hyU⟩
  have s3 : IsDomain (Localization.AtPrime p.asIdeal) ∧
      IsIntegrallyClosed (Localization.AtPrime p.asIdeal) := by
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk y) := (Y.presheaf.germ U y hyU).hom.toAlgebra
    haveI := hU.isLocalization_stalk ⟨y, hyU⟩
    let e := IsLocalization.algEquiv p.asIdeal.primeCompl (Y.presheaf.stalk y)
      (Localization.AtPrime p.asIdeal)
    exact ⟨MulEquiv.isDomain (Y.presheaf.stalk y) e.symm.toMulEquiv,
      IsIntegrallyClosed.of_equiv e.toRingEquiv⟩
  obtain ⟨hd, hi⟩ := s3
  obtain ⟨Q, hQ, huniq, hbij⟩ := hH U hU p hd hi
  let j : Spec (.of ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))) ⟶ f.normalization :=
    f.normalizationOpenCover.f ⟨U, hU⟩
  haveI : IsOpenImmersion j := f.normalizationOpenCover.map_prop ⟨U, hU⟩
  have hpre : f.fromNormalization ⁻¹ᵁ U = j.opensRange :=
    Scheme.Hom.fromNormalization_preimage f ⟨U, hU⟩
  have hcomm : j ≫ f.fromNormalization = Spec.map (CommRingCat.ofHom
      (algebraMap Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)))) ≫ hU.fromSpec :=
    Scheme.Hom.ι_fromNormalization f ⟨U, hU⟩
  let q : Spec (.of ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))) := Q
  haveI hiso : IsIso ((Spec.map (CommRingCat.ofHom
      (algebraMap Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))))).stalkMap q) :=
    s1 Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)) p Q hQ hbij
  haveI := hU.isOpenImmersion_fromSpec
  have hinj : Function.Injective hU.fromSpec := hU.fromSpec.isOpenEmbedding.injective
  have hpt : ∀ Q' : Spec (.of ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))),
      f.fromNormalization (j Q') = hU.fromSpec ((Spec.map (CommRingCat.ofHom
        (algebraMap Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))))) Q') := by
    intro Q'
    rw [← Scheme.Hom.comp_apply, hcomm, Scheme.Hom.comp_apply]
  have hqp : (Spec.map (CommRingCat.ofHom
      (algebraMap Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))))) q = p :=
    PrimeSpectrum.ext hQ.symm
  refine ⟨j q, fun w' => ⟨fun hw' => ?_, fun hw' => ?_⟩, ?_⟩
  · have hmem : w' ∈ f.fromNormalization ⁻¹ᵁ U := by
      show f.fromNormalization w' ∈ U
      rw [hw']; exact hyU
    rw [hpre, Scheme.Hom.mem_opensRange] at hmem
    obtain ⟨Q', rfl⟩ := hmem
    have h1 : hU.fromSpec ((Spec.map (CommRingCat.ofHom
        (algebraMap Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))))) Q') = hU.fromSpec p :=
      (hpt Q').symm.trans (hw'.trans hpy.symm)
    have h2 : (PrimeSpectrum.comap
        (algebraMap Γ(Y, U) ↥(integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U))) Q' : PrimeSpectrum Γ(Y, U))
        = p := hinj h1
    exact congrArg j (huniq Q' (congrArg PrimeSpectrum.asIdeal h2))
  · subst hw'
    exact (hpt q).trans ((congrArg hU.fromSpec hqp).trans hpy)
  · have h1 : IsIso ((j ≫ f.fromNormalization).stalkMap q) := by
      rw [Scheme.Hom.stalkMap_congr_hom _ _ hcomm q, Scheme.Hom.stalkMap_comp]
      refine IsIso.comp_isIso' ?_ (IsIso.comp_isIso' ?_ hiso)
      · infer_instance
      · exact IsOpenImmersion.instIsIsoCommRingCatStalkMap hU.fromSpec _
    rw [Scheme.Hom.stalkMap_comp] at h1
    haveI hj : IsIso (j.stalkMap q) := IsOpenImmersion.instIsIsoCommRingCatStalkMap j q
    exact (isIso_comp_right_iff _ (j.stalkMap q)).mp h1

theorem nccwrn_norm_iso_over_integral : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [QuasiCompact f] [QuasiSeparated f] (V : Y.Opens), IsIntegralHom (f ∣_ V) → IsIso (f.toNormalization ∣_ f.fromNormalization ⁻¹ᵁ V) :=
by
  intro X Y f _ _ V hV

  have chart : ∀ {A B S : Scheme.{u}} (W : S.Opens) (a : A ⟶ B) (k : B ⟶ W) (g : A ⟶ S),
      IsIso a → IsOpenImmersion g → (∀ s ∈ W, ∃ x, g x = s) → a ≫ k ≫ W.ι = g → IsIso k := by
    intro A B S W a k g ha hg hrange hfac
    have h1 : IsOpenImmersion (a ≫ k) := by
      haveI : IsOpenImmersion ((a ≫ k) ≫ W.ι) := by rw [Category.assoc, hfac]; exact hg
      exact IsOpenImmersion.of_comp _ W.ι
    have h2 : IsOpenImmersion k := by
      rw [← IsIso.inv_hom_id_assoc a k]
      infer_instance
    have h3 : Surjective k := by
      constructor
      intro w
      obtain ⟨x, hx⟩ := hrange w.1 w.2
      refine ⟨a x, ?_⟩
      apply Subtype.ext
      have := congrArg (fun g => g x) hfac
      simp only [Scheme.Hom.comp_apply] at this
      rw [← hx, ← this]
      rfl
    exact (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨h2, h3⟩
  have chart2 : ∀ {A B S C D : Scheme.{u}} (W : S.Opens) (a : A ⟶ B) (k : B ⟶ W)
      (T₁ : A ⟶ C) (T₂ : C ⟶ D) (j : D ⟶ S), IsOpenImmersion j →
      IsIso a → IsIso T₁ → IsIso T₂ → (∀ s ∈ W, ∃ x, j x = s) →
      a ≫ k ≫ W.ι = T₁ ≫ T₂ ≫ j → IsIso k := by
    intro A B S C D W a k T₁ T₂ j hj ha h1 h2 hW hfac
    refine chart W a k (T₁ ≫ T₂ ≫ j) ha inferInstance ?_ hfac
    intro s hs
    obtain ⟨x, hx⟩ := hW s hs
    obtain ⟨y, hy⟩ := (T₁ ≫ T₂).surjective x
    refine ⟨y, ?_⟩
    rw [← Category.assoc, Scheme.Hom.comp_apply, hy, hx]

  have s1 : ∀ (U : Y.affineOpens), IsAffineOpen (f ⁻¹ᵁ (U : Y.Opens)) →
      (f.app U).hom.IsIntegral →
      IsIso (f.toNormalization ∣_ f.fromNormalization ⁻¹ᵁ (U : Y.Opens)) := by
    intro U hfU hint
    letI := (f.app U).hom.toAlgebra
    haveI : Algebra.IsIntegral Γ(Y, U) Γ(X, f ⁻¹ᵁ U) := ⟨fun x => hint x⟩
    have hT : integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U) = ⊤ :=
      integralClosure_eq_top_iff.mpr inferInstance
    have hbij : Function.Bijective
        (integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)).val.toRingHom := by
      refine ⟨fun a b h => Subtype.ext h, fun m => ⟨⟨m, ?_⟩, rfl⟩⟩
      rw [hT]; exact Algebra.mem_top
    haveI : IsIso (CommRingCat.ofHom (integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)).val.toRingHom) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    haveI : IsIso (f ⁻¹ᵁ (U : Y.Opens)).toSpecΓ := by
      rw [← hfU.isoSpec_hom]; infer_instance
    have e : f ⁻¹ᵁ (U : Y.Opens) =
        f.toNormalization ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ (U : Y.Opens)) := by
      rw [← Scheme.Hom.comp_preimage, Scheme.Hom.toNormalization_fromNormalization]
    have fac : (X.isoOfEq e).hom ≫ (f.toNormalization ∣_ f.fromNormalization ⁻¹ᵁ (U : Y.Opens)) ≫
        (f.fromNormalization ⁻¹ᵁ (U : Y.Opens)).ι =
        (f ⁻¹ᵁ (U : Y.Opens)).toSpecΓ ≫
          Spec.map (CommRingCat.ofHom (integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)).val.toRingHom) ≫
          f.normalizationOpenCover.f U := by
      rw [morphismRestrict_ι, ← Category.assoc, Scheme.isoOfEq_hom_ι]
      exact f.ι_toNormalization U
    have hjo := f.normalizationOpenCover.map_prop U
    have hSp : IsIso (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)).val.toRingHom)) :=
      (inferInstance : IsIso (Scheme.Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, U) Γ(X, f ⁻¹ᵁ U)).val.toRingHom).op))
    exact chart2 _ (X.isoOfEq e).hom _ _ _ _ hjo (Iso.isIso_hom _) (by infer_instance)
      hSp (fun s hs => by rw [f.fromNormalization_preimage U] at hs; exact hs) fac

  have s2 : ∀ U : Y.Opens, IsAffineOpen U → U ≤ V →
      IsAffineOpen (f ⁻¹ᵁ U) ∧ (f.app U).hom.IsIntegral := by
    intro U hU hUV
    have hU' : IsAffineOpen (V.ι ⁻¹ᵁ U) :=
      hU.preimage_of_isOpenImmersion V.ι (by rw [Scheme.Opens.opensRange_ι]; exact hUV)
    have himg : V.ι ''ᵁ (V.ι ⁻¹ᵁ U) = U := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hUV
    obtain ⟨hAff, hInt⟩ := (isIntegralHom_iff _).mp hV
    refine ⟨?_, ?_⟩
    · have h1 := (@IsAffineHom.isAffine_preimage _ _ _ hAff _ hU').image_of_isOpenImmersion
        (f ⁻¹ᵁ V).ι
      rwa [image_morphismRestrict_preimage, himg] at h1
    · have gen : ∀ {A B C : CommRingCat.{u}} (F : A ⟶ B) (r : B ⟶ C),
          (F ≫ r).hom.IsIntegral → IsIso r → F.hom.IsIntegral := by
        intro A B C F r hFr _
        have key : F = (F ≫ r) ≫ inv r := by simp
        rw [key, CommRingCat.hom_comp]
        exact RingHom.IsIntegral.trans _ _ hFr
          (RingHom.isIntegral_of_surjective _ (ConcreteCategory.bijective_of_isIso (inv r)).2)
      have transport : ∀ (U₁ U₂ : Y.Opens), U₁ = U₂ → (f.app U₁).hom.IsIntegral →
          (f.app U₂).hom.IsIntegral := by
        intro U₁ U₂ h hh; subst h; exact hh
      have h1 := hInt _ hU'
      rw [morphismRestrict_app] at h1
      refine transport _ _ himg (gen _ _ h1 ?_)
      have hiso : ∀ {a b : CommRingCat.{u}} (p : a = b), IsIso (eqToHom p) := by
        intro a b p; subst p; rw [eqToHom_refl]; infer_instance
      rw [eqToHom_op, eqToHom_map]
      exact hiso _

  rw [← MorphismProperty.isomorphisms.iff]
  let O : {U : Y.affineOpens // (U : Y.Opens) ≤ V} → (f.fromNormalization ⁻¹ᵁ V).toScheme.Opens :=
    fun i => (f.fromNormalization ⁻¹ᵁ V).ι ⁻¹ᵁ (f.fromNormalization ⁻¹ᵁ (i.1 : Y.Opens))
  have hO : iSup O = ⊤ := by
    apply top_unique
    intro w _
    rw [TopologicalSpace.Opens.mem_iSup]
    have hw : f.fromNormalization ((f.fromNormalization ⁻¹ᵁ V).ι w) ∈ V := by
      exact w.2
    obtain ⟨U', hU'B, hwU', hU'V⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens) hw
    exact ⟨⟨⟨U', hU'B⟩, hU'V⟩, hwU'⟩
  refine (IsZariskiLocalAtTarget.iff_of_iSup_eq_top
    (P := MorphismProperty.isomorphisms Scheme.{u}) O hO).mpr ?_
  intro i
  have hOi : (f.fromNormalization ⁻¹ᵁ V).ι ''ᵁ O i = f.fromNormalization ⁻¹ᵁ (i.1 : Y.Opens) := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    exact inf_eq_right.mpr (fun x hx => i.2 hx)
  rw [MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms _)
    (morphismRestrictRestrict f.toNormalization (f.fromNormalization ⁻¹ᵁ V) (O i))]
  rw [MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms _)
    (morphismRestrictEq f.toNormalization hOi)]
  rw [MorphismProperty.isomorphisms.iff]
  obtain ⟨⟨U, hU⟩, hUV⟩ := i
  obtain ⟨ha, hi⟩ := s2 U hU hUV
  exact s1 ⟨U, hU⟩ ha hi

theorem nccwrn_irreducible_nbhd : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X], (∀ x : X, IsDomain (X.presheaf.stalk x)) → ∀ (W : X.Opens) (x : X), x ∈ W → ∃ (V : X.Opens) (η : X), x ∈ V ∧ V ≤ W ∧ η ∈ V ∧ (∀ η' : X, η' ⤳ η → η' = η) ∧ (∀ v ∈ V, η ⤳ v) ∧ (∀ (v : X) (hv : η ⤳ v), v ∈ V → letI := (X.presheaf.stalkSpecializes hv).hom.toAlgebra; IsFractionRing (X.presheaf.stalk v) (X.presheaf.stalk η)) ∧ ∀ (V' : X.Opens), V' ≤ V → ∀ (hη : η ∈ V'), Function.Injective (X.presheaf.germ V' η hη).hom :=
by
  intro X _ hdom W x hxW

  have hL : ∀ (y η : X), η ⤳ y → (∀ η' : X, η' ⤳ η → η' = η) →
      ∀ P : PrimeSpectrum (X.presheaf.stalk y), P.asIdeal = ⊥ → X.fromSpecStalk y P = η := by
    intro y η hy hη P hP
    obtain ⟨Q, hQ⟩ := (Set.ext_iff.mp (Scheme.range_fromSpecStalk (X := X) (x := y)) η).mpr hy
    have hQ' : X.fromSpecStalk y Q = η := hQ
    have h1 : P ⤳ (show PrimeSpectrum (X.presheaf.stalk y) from Q) :=
      (PrimeSpectrum.le_iff_specializes _ _).mp (by
        show P.asIdeal ≤ _
        rw [hP]; exact bot_le)
    have h2 := h1.map (X.fromSpecStalk y).continuous
    have h3 : X.fromSpecStalk y P ⤳ η := by
      rw [← hQ']; exact h2
    exact hη _ h3

  have hB : ∀ (v η : X) (hv : η ⤳ v), (∀ η' : X, η' ⤳ η → η' = η) →
      ∀ a : X.presheaf.stalk v, a ≠ 0 → IsUnit ((X.presheaf.stalkSpecializes hv).hom a) := by
    intro v η hv hη a ha
    haveI := hdom v
    let P : PrimeSpectrum (X.presheaf.stalk v) :=
      ⟨Ideal.comap (X.presheaf.stalkSpecializes hv).hom
        (IsLocalRing.maximalIdeal (X.presheaf.stalk η)), inferInstance⟩
    have hP1 : X.fromSpecStalk v P = η := by
      have e2 : (Spec.map (X.presheaf.stalkSpecializes hv) ≫ X.fromSpecStalk v)
          (show Spec (X.presheaf.stalk η) from IsLocalRing.closedPoint (X.presheaf.stalk η)) = η := by
        rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
        exact Scheme.fromSpecStalk_closedPoint
      rw [Scheme.Hom.comp_apply] at e2
      exact e2
    let P₀ : PrimeSpectrum (X.presheaf.stalk v) := ⟨⊥, Ideal.isPrime_bot⟩
    have hP₀ : X.fromSpecStalk v P₀ = η := hL v η hv hη P₀ rfl
    have hP2 : P = P₀ := (X.fromSpecStalk v).injective (hP1.trans hP₀.symm)
    rw [← IsLocalRing.notMem_maximalIdeal]
    intro hmem
    apply ha
    have h3 : a ∈ P.asIdeal := hmem
    rw [hP2] at h3
    exact (Ideal.mem_bot).mp h3

  have hinj : ∀ (v η : X) (hv : η ⤳ v), (∀ η' : X, η' ⤳ η → η' = η) →
      Function.Injective (X.presheaf.stalkSpecializes hv).hom := by
    intro v η hv hη
    haveI := hdom η
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    have hu := hB v η hv hη a hne
    rw [ha] at hu
    exact not_isUnit_zero hu

  have hfrac : ∀ (v η : X) (hv : η ⤳ v), (∀ η' : X, η' ⤳ η → η' = η) →
      letI := (X.presheaf.stalkSpecializes hv).hom.toAlgebra
      IsFractionRing (X.presheaf.stalk v) (X.presheaf.stalk η) := by
    intro v η hv hη
    letI := (X.presheaf.stalkSpecializes hv).hom.toAlgebra
    haveI := hdom v
    haveI := hdom η
    obtain ⟨U, hU, hvU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X)) (show v ∈ (⊤ : X.Opens) from trivial)
    have hU' : IsAffineOpen U := hU
    have hηU : η ∈ U := hv.mem_open U.isOpen hvU
    letI : Algebra Γ(X, U) (X.presheaf.stalk η) := (X.presheaf.germ U η hηU).hom.toAlgebra
    haveI : IsLocalization.AtPrime (X.presheaf.stalk η) (hU'.primeIdealOf ⟨η, hηU⟩).asIdeal :=
      hU'.isLocalization_stalk ⟨η, hηU⟩
    have hgerm : ∀ t : Γ(X, U), (X.presheaf.stalkSpecializes hv).hom
        ((X.presheaf.germ U v hvU).hom t) = (X.presheaf.germ U η hηU).hom t := by
      intro t
      rw [← X.presheaf.germ_stalkSpecializes hvU hv]
      rfl
    refine (isLocalization_iff (nonZeroDivisors (X.presheaf.stalk v)) _).mpr ⟨?_, ?_, ?_⟩
    · intro y
      exact hB v η hv hη y.1 (nonZeroDivisors.ne_zero y.2)
    · intro z
      obtain ⟨⟨a, s⟩, hz⟩ := IsLocalization.surj (hU'.primeIdealOf ⟨η, hηU⟩).asIdeal.primeCompl z
      have hsu : IsUnit ((X.presheaf.germ U η hηU).hom (s : Γ(X, U))) :=
        IsLocalization.map_units (X.presheaf.stalk η) s
      have hs0 : (X.presheaf.germ U v hvU).hom (s : Γ(X, U)) ≠ 0 := by
        intro h0
        have h4 := hgerm s
        rw [h0, map_zero] at h4
        rw [← h4] at hsu
        exact not_isUnit_zero hsu
      refine ⟨⟨(X.presheaf.germ U v hvU).hom a,
        ⟨(X.presheaf.germ U v hvU).hom (s : Γ(X, U)), mem_nonZeroDivisors_of_ne_zero hs0⟩⟩, ?_⟩
      show z * (X.presheaf.stalkSpecializes hv).hom ((X.presheaf.germ U v hvU).hom (s : Γ(X, U))) =
        (X.presheaf.stalkSpecializes hv).hom ((X.presheaf.germ U v hvU).hom a)
      rw [hgerm, hgerm]
      exact hz
    · intro a b hab
      exact ⟨1, by rw [hinj v η hv hη hab]⟩

  obtain ⟨U, hU, hxU, hUW⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens X)) hxW
  have hU' : IsAffineOpen U := hU
  haveI : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  haveI : TopologicalSpace.NoetherianSpace (U : Set X) := noetherianSpace_of_isAffineOpen U hU'
  have hSo : IsOpen (U : Set X) := U.isOpen
  haveI : QuasiSober (U : Set X) := hSo.isOpenEmbedding_subtypeVal.quasiSober
  have hind : Topology.IsInducing (Subtype.val : ↥(U : Set X) → X) := Topology.IsInducing.subtypeVal
  have hGPc : ∀ Z ∈ irreducibleComponents (U : Set X), ∀ m : (U : Set X), IsGenericPoint m Z →
      ∀ η' : X, η' ⤳ m.1 → η' = m.1 := by
    intro Z hZ m hm η' h
    have hη'U : η' ∈ (U : Set X) := h.mem_open hSo m.2
    have h1 : (⟨η', hη'U⟩ : (U : Set X)) ⤳ m :=
      (hind.specializes_iff (x := ⟨η', hη'U⟩) (y := m)).mp h
    have hsub : Z ⊆ closure {(⟨η', hη'U⟩ : (U : Set X))} := by
      rw [← hm.def]; exact h1.closure_subset
    have hle : closure {(⟨η', hη'U⟩ : (U : Set X))} ⊆ Z :=
      hZ.2 isIrreducible_singleton.closure hsub
    have h2 : m ⤳ ⟨η', hη'U⟩ := hm.specializes (hle (subset_closure (Set.mem_singleton _)))
    exact congrArg Subtype.val (h1.antisymm h2).eq
  have hgen : ∀ Z ∈ irreducibleComponents (U : Set X), ∃ m : (U : Set X), IsGenericPoint m Z :=
    fun Z hZ => QuasiSober.sober hZ.1 (isClosed_of_mem_irreducibleComponents Z hZ)
  let xh : (U : Set X) := ⟨x, hxU⟩
  obtain ⟨m₀, hm₀⟩ := hgen (irreducibleComponent xh) (irreducibleComponent_mem_irreducibleComponents xh)
  have hηGP : ∀ η' : X, η' ⤳ m₀.1 → η' = m₀.1 :=
    hGPc _ (irreducibleComponent_mem_irreducibleComponents xh) m₀ hm₀
  have hηx : m₀.1 ⤳ x := (hm₀.specializes mem_irreducibleComponent).map continuous_subtype_val
  have huniq : ∀ ξ : X, ξ ⤳ x → (∀ η' : X, η' ⤳ ξ → η' = ξ) → ξ = m₀.1 := by
    intro ξ hξ hξGP
    haveI := hdom x
    let P₀ : PrimeSpectrum (X.presheaf.stalk x) := ⟨⊥, Ideal.isPrime_bot⟩
    exact (hL x ξ hξ hξGP P₀ rfl).symm.trans (hL x m₀.1 hηx hηGP P₀ rfl)

  have hCfin : (irreducibleComponents (U : Set X)).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  let Bad : Set (Set (U : Set X)) := {Z | Z ∈ irreducibleComponents (U : Set X) ∧ xh ∉ Z}
  have hBadfin : Bad.Finite := hCfin.subset (fun Z hZ => hZ.1)
  have hBcl : IsClosed (⋃₀ Bad) :=
    hBadfin.isClosed_sUnion (fun Z hZ => isClosed_of_mem_irreducibleComponents Z hZ.1)
  have hV₀open : IsOpen (Subtype.val '' (⋃₀ Bad)ᶜ : Set X) :=
    hSo.isOpenMap_subtype_val _ hBcl.isOpen_compl
  let V : X.Opens := ⟨Subtype.val '' (⋃₀ Bad)ᶜ, hV₀open⟩
  have hmemV : ∀ v : X, v ∈ V ↔ v ∈ (Subtype.val '' (⋃₀ Bad)ᶜ : Set X) := fun v => Iff.rfl
  have hxV : x ∈ V := by
    rw [hmemV]
    refine ⟨xh, ?_, rfl⟩
    intro h
    obtain ⟨Z, hZ, hxZ⟩ := Set.mem_sUnion.mp h
    exact hZ.2 hxZ
  have hVW : V ≤ W := by
    intro v hv
    rw [hmemV] at hv
    obtain ⟨u, -, rfl⟩ := hv
    exact hUW u.2
  have hspec : ∀ v ∈ V, m₀.1 ⤳ v := by
    intro v hv
    rw [hmemV] at hv
    obtain ⟨u, hu, rfl⟩ := hv
    obtain ⟨mu, hmu⟩ := hgen (irreducibleComponent u) (irreducibleComponent_mem_irreducibleComponents u)
    have hxZ : xh ∈ irreducibleComponent u := by
      by_contra h
      exact hu (Set.mem_sUnion.mpr ⟨irreducibleComponent u,
        ⟨irreducibleComponent_mem_irreducibleComponents u, h⟩, mem_irreducibleComponent⟩)
    have h1 : mu.1 ⤳ x := (hmu.specializes hxZ).map continuous_subtype_val
    have h2 : mu.1 = m₀.1 :=
      huniq mu.1 h1 (hGPc _ (irreducibleComponent_mem_irreducibleComponents u) mu hmu)
    rw [← h2]
    exact (hmu.specializes mem_irreducibleComponent).map continuous_subtype_val
  have hηV : m₀.1 ∈ V := (hspec x hxV).mem_open V.isOpen hxV
  refine ⟨V, m₀.1, hxV, hVW, hηV, hηGP, hspec, ?_, ?_⟩
  · intro v hv _
    exact hfrac v m₀.1 hv hηGP
  · intro V' hV'V hη
    rw [injective_iff_map_eq_zero]
    intro s hs
    apply TopCat.Presheaf.section_ext X.sheaf V' s 0
    intro y hy
    show (X.presheaf.germ V' y hy).hom s = (X.presheaf.germ V' y hy).hom 0
    rw [map_zero]
    have hηy := hspec y (hV'V hy)
    have e : (X.presheaf.stalkSpecializes hηy).hom ((X.presheaf.germ V' y hy).hom s) =
        (X.presheaf.germ V' m₀.1 hη).hom s := by
      rw [← X.presheaf.germ_stalkSpecializes hy hηy]
      rfl
    apply hinj y m₀.1 hηy hηGP
    rw [map_zero, e]
    exact hs

theorem nccwrn_generic_sheaf : ∀ (N : Scheme.{u}), (∀ x : N, IsIntegrallyClosed (N.presheaf.stalk x)) → (∀ (W : N.Opens) (x : N), x ∈ W → ∃ (V : N.Opens) (η : N), x ∈ V ∧ V ≤ W ∧ η ∈ V ∧ (∀ η' : N, η' ⤳ η → η' = η) ∧ (∀ v ∈ V, η ⤳ v) ∧ (∀ (v : N) (hv : η ⤳ v), v ∈ V → letI := (N.presheaf.stalkSpecializes hv).hom.toAlgebra; IsFractionRing (N.presheaf.stalk v) (N.presheaf.stalk η)) ∧ ∀ (V' : N.Opens), V' ≤ V → ∀ (hη : η ∈ V'), Function.Injective (N.presheaf.germ V' η hη).hom) → (∀ (W : N.Opens) (s s' : Γ(N, W)), (∀ (η : N) (hη : η ∈ W), (∀ x' : N, x' ⤳ η → x' = η) → (N.presheaf.germ W η hη).hom s = (N.presheaf.germ W η hη).hom s') → s = s') ∧ (∀ (W : N.Opens) (h : (η : N) → N.presheaf.stalk η), (∀ (x : N) (hx : x ∈ W) (η : N) (hηx : η ⤳ x), (∀ x' : N, x' ⤳ η → x' = η) → (N.presheaf.stalkSpecializes hηx).hom.IsIntegralElem (h η)) → ∃ s : Γ(N, W), ∀ (η : N) (hη : η ∈ W), (∀ x' : N, x' ⤳ η → x' = η) → (N.presheaf.germ W η hη).hom s = h η) :=
by
  intro N hIC H8
  have GLu : ∀ (W : N.Opens) (s s' : Γ(N, W)), (∀ (η : N) (hη : η ∈ W),
      (∀ x' : N, x' ⤳ η → x' = η) →
      (N.presheaf.germ W η hη).hom s = (N.presheaf.germ W η hη).hom s') → s = s' := by
    intro W s s' hgerm
    apply TopCat.Presheaf.section_ext N.sheaf W s s'
    intro x hx
    obtain ⟨V, η, hxV, hVW, hηV, hGP, -, -, hinj⟩ := H8 W x hx
    have hr : (N.presheaf.map (homOfLE hVW).op).hom s
        = (N.presheaf.map (homOfLE hVW).op).hom s' := by
      apply hinj V le_rfl hηV
      have e1 := TopCat.Presheaf.germ_res_apply N.presheaf (homOfLE hVW) η hηV s
      have e2 := TopCat.Presheaf.germ_res_apply N.presheaf (homOfLE hVW) η hηV s'
      exact e1.trans ((hgerm η (hVW hηV) hGP).trans e2.symm)
    have e1 := TopCat.Presheaf.germ_res_apply N.presheaf (homOfLE hVW) x hxV s
    have e2 := TopCat.Presheaf.germ_res_apply N.presheaf (homOfLE hVW) x hxV s'
    exact e1.symm.trans ((congrArg (N.presheaf.germ V x hxV).hom hr).trans e2)
  have LS : ∀ (W : N.Opens) (h : (η : N) → N.presheaf.stalk η),
      (∀ (x : N) (hx : x ∈ W) (η : N) (hηx : η ⤳ x), (∀ x' : N, x' ⤳ η → x' = η) →
        (N.presheaf.stalkSpecializes hηx).hom.IsIntegralElem (h η)) →
      ∀ (x : N), x ∈ W → ∃ (V : N.Opens) (t : Γ(N, V)), x ∈ V ∧ V ≤ W ∧
        ∀ (η : N) (hη : η ∈ V), (∀ x' : N, x' ⤳ η → x' = η) →
          (N.presheaf.germ V η hη).hom t = h η := by
    intro W h hint x hx
    obtain ⟨V, η, hxV, hVW, hηV, hGP, hspec, hfrac, -⟩ := H8 W x hx
    have hηx : η ⤳ x := hspec x hxV
    obtain ⟨g, hg⟩ : ∃ g, (N.presheaf.stalkSpecializes hηx).hom g = h η := by
      letI := (N.presheaf.stalkSpecializes hηx).hom.toAlgebra
      haveI := hfrac x hηx hxV
      exact IsIntegrallyClosed.algebraMap_eq_of_integral (hint x hx η hηx hGP)
    obtain ⟨U, hxU, t₀, ht₀⟩ := TopCat.Presheaf.exists_germ_eq N.presheaf g
    refine ⟨U ⊓ V, (N.presheaf.map (homOfLE inf_le_left : U ⊓ V ⟶ U).op).hom t₀,
      ⟨hxU, hxV⟩, inf_le_right.trans hVW, ?_⟩
    intro η' hη' hGP'
    have hee : η = η' := hGP' η (hspec η' hη'.2)
    subst hee
    have e1 := TopCat.Presheaf.germ_res_apply N.presheaf (homOfLE inf_le_left : U ⊓ V ⟶ U)
      η hη' t₀
    have e2 := TopCat.Presheaf.germ_stalkSpecializes_apply N.presheaf hxU hηx t₀
    refine e1.trans (e2.symm.trans ?_)
    rw [ht₀]
    exact hg
  refine ⟨GLu, ?_⟩
  intro W h hint
  choose V t hxV hVW hgerm using fun (x : ↥W) => LS W h hint x.1 x.2
  have hcompat : TopCat.Presheaf.IsCompatible N.sheaf.obj V t := by
    intro a b
    apply GLu
    intro η hη hGP
    have e1 := TopCat.Presheaf.germ_res_apply N.presheaf ((V a).infLELeft (V b)) η hη (t a)
    have e2 := TopCat.Presheaf.germ_res_apply N.presheaf ((V a).infLERight (V b)) η hη (t b)
    exact e1.trans ((hgerm a η _ hGP).trans ((hgerm b η _ hGP).symm.trans e2.symm))
  obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' N.sheaf V W
    (fun a => homOfLE (hVW a)) (by
      intro x hx
      exact (TopologicalSpace.Opens.mem_iSup).mpr ⟨⟨x, hx⟩, hxV ⟨x, hx⟩⟩) t hcompat
  refine ⟨s, fun η hη hGP => ?_⟩
  have e1 := TopCat.Presheaf.germ_res_apply N.presheaf (homOfLE (hVW ⟨η, hη⟩)) η
    (hxV ⟨η, hη⟩) s
  have e2 := hs ⟨η, hη⟩
  refine e1.symm.trans ?_
  refine Eq.trans ?_ (hgerm ⟨η, hη⟩ η (hxV ⟨η, hη⟩) hGP)
  exact congrArg (N.presheaf.germ (V ⟨η, hη⟩) η (hxV ⟨η, hη⟩)).hom e2

theorem nccwrn_chart : ∀ (N X : Scheme.{u}) (φ : N ⟶ X), (∀ x : N, IsDomain (N.presheaf.stalk x)) → (∀ (W : N.Opens) (s s' : Γ(N, W)), (∀ (η : N) (hη : η ∈ W), (∀ x' : N, x' ⤳ η → x' = η) → (N.presheaf.germ W η hη).hom s = (N.presheaf.germ W η hη).hom s') → s = s') → (∀ (W : N.Opens) (h : (η : N) → N.presheaf.stalk η), (∀ (x : N) (hx : x ∈ W) (η : N) (hηx : η ⤳ x), (∀ x' : N, x' ⤳ η → x' = η) → (N.presheaf.stalkSpecializes hηx).hom.IsIntegralElem (h η)) → ∃ s : Γ(N, W), ∀ (η : N) (hη : η ∈ W), (∀ x' : N, x' ⤳ η → x' = η) → (N.presheaf.germ W η hη).hom s = h η) → (∀ y : N, (∀ x' : N, x' ⤳ y → x' = y) → ∀ x' : X, x' ⤳ φ y → x' = φ y) → (∀ z : X, (∀ x' : X, x' ⤳ z → x' = z) → ∃ y : N, (∀ y' : N, φ y' = z ↔ y' = y) ∧ IsIso (φ.stalkMap y)) → ∀ (U : X.Opens), IsAffineOpen U → letI := (φ.app U).hom.toAlgebra; (∀ P : {P : PrimeSpectrum Γ(X, U) // P.asIdeal ∈ minimalPrimes Γ(X, U)}, IsField (Localization.AtPrime P.1.asIdeal)) ∧ Nonempty (↥(integralClosure Γ(X, U) Γ(N, φ ⁻¹ᵁ U)) ≃ₐ[Γ(X, U)] ↥(integralClosure Γ(X, U) ((P : {P : PrimeSpectrum Γ(X, U) // P.asIdeal ∈ minimalPrimes Γ(X, U)}) → Localization.AtPrime P.1.asIdeal))) :=
by

  have s1 : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U),
      (∀ P : {P : PrimeSpectrum Γ(X, U) // P.asIdeal ∈ minimalPrimes Γ(X, U)}, ∀ x' : X,
        x' ⤳ hU.fromSpec P.1 → x' = hU.fromSpec P.1) ∧
      (∀ (x : X) (hx : x ∈ U), (∀ x' : X, x' ⤳ x → x' = x) →
        (hU.primeIdealOf ⟨x, hx⟩).asIdeal ∈ minimalPrimes Γ(X, U)) := by
    intro X U hU
    have hemb := hU.fromSpec.isOpenEmbedding
    have hrange := hU.range_fromSpec
    refine ⟨?_, ?_⟩
    · rintro ⟨P, hP⟩ x' hx'
      have hmem : hU.fromSpec P ∈ (U : Set X) := by rw [← hrange]; exact ⟨P, rfl⟩
      have hx'U : x' ∈ (U : Set X) := hx'.mem_open U.isOpen hmem
      rw [← hrange] at hx'U
      obtain ⟨Q, rfl⟩ := hx'U
      have hQP' : Q ⤳ P := hemb.isInducing.specializes_iff.mp hx'
      have hQP : (Q : PrimeSpectrum Γ(X, U)).asIdeal ≤ P.asIdeal :=
        (PrimeSpectrum.le_iff_specializes (Q : PrimeSpectrum Γ(X, U)) P).mpr hQP'
      have : (Q : PrimeSpectrum Γ(X, U)).asIdeal = P.asIdeal := by
        apply le_antisymm hQP
        exact hP.2 ⟨Q.2, bot_le⟩ hQP
      rw [PrimeSpectrum.ext this]
    · intro x hx hgp
      set p := hU.primeIdealOf ⟨x, hx⟩ with hp
      have hfp : hU.fromSpec p = x := hU.fromSpec_primeIdealOf ⟨x, hx⟩
      obtain ⟨q, hq, hqp⟩ :=
        Ideal.exists_minimalPrimes_le (I := (⊥ : Ideal Γ(X, U))) (J := p.asIdeal) bot_le
      have hqprime : q.IsPrime := hq.1.1
      set Q : PrimeSpectrum Γ(X, U) := ⟨q, hqprime⟩
      have hsp : Q ⤳ p := (PrimeSpectrum.le_iff_specializes Q p).mp hqp
      have h2 : hU.fromSpec Q ⤳ hU.fromSpec p := hsp.map hU.fromSpec.continuous
      rw [hfp] at h2
      have h3 := hgp _ h2
      have h4 : Q = p := hemb.injective (h3.trans hfp.symm)
      have : p.asIdeal = q := by rw [← h4]
      rw [this]; exact hq

  have s2 : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U) (x : X) (hx : x ∈ U)
      (P : PrimeSpectrum Γ(X, U)), hU.fromSpec P = x →
      ∃ ε : Localization.AtPrime P.asIdeal ≃+* X.presheaf.stalk x,
        ∀ a : Γ(X, U), ε (algebraMap Γ(X, U) (Localization.AtPrime P.asIdeal) a) =
          (X.presheaf.germ U x hx).hom a := by
    intro X U hU x hx P hP
    subst hP
    let iA : Algebra Γ(X, U) (X.presheaf.stalk (hU.fromSpec P)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨hU.fromSpec P, hx⟩
    have hL := hU.isLocalization_stalk' P hx
    let e := @IsLocalization.algEquiv Γ(X, U) _ P.asIdeal.primeCompl
      (Localization.AtPrime P.asIdeal) _ _ _ (X.presheaf.stalk (hU.fromSpec P)) _ iA hL
    refine ⟨e.toRingEquiv, ?_⟩
    intro a
    exact e.commutes a

  have s3 : ∀ (A : Type u) [CommRing A] (P : PrimeSpectrum A), P.asIdeal ∈ minimalPrimes A →
      IsDomain (Localization.AtPrime P.asIdeal) → IsField (Localization.AtPrime P.asIdeal) := by
    intro A _ P hP hD
    apply IsLocalRing.isField_iff_maximalIdeal_eq.mpr
    have hm : Ideal.comap (algebraMap A (Localization.AtPrime P.asIdeal))
        (IsLocalRing.maximalIdeal (Localization.AtPrime P.asIdeal)) = P.asIdeal :=
      Localization.AtPrime.comap_maximalIdeal
    have h1 : Ideal.comap (algebraMap A (Localization.AtPrime P.asIdeal))
        (⊥ : Ideal (Localization.AtPrime P.asIdeal)) ≤ P.asIdeal := by
      calc _ ≤ Ideal.comap (algebraMap A (Localization.AtPrime P.asIdeal))
            (IsLocalRing.maximalIdeal (Localization.AtPrime P.asIdeal)) := Ideal.comap_mono bot_le
        _ = _ := hm
    haveI hb : (⊥ : Ideal (Localization.AtPrime P.asIdeal)).IsPrime := Ideal.isPrime_bot
    have h2 : Ideal.comap (algebraMap A (Localization.AtPrime P.asIdeal))
        (⊥ : Ideal (Localization.AtPrime P.asIdeal)) = P.asIdeal :=
      le_antisymm h1 (hP.2 ⟨Ideal.comap_isPrime _ _, bot_le⟩ h1)
    rw [← IsLocalization.map_comap P.asIdeal.primeCompl (Localization.AtPrime P.asIdeal)
        (IsLocalRing.maximalIdeal (Localization.AtPrime P.asIdeal)),
      ← IsLocalization.map_comap P.asIdeal.primeCompl (Localization.AtPrime P.asIdeal)
        (⊥ : Ideal (Localization.AtPrime P.asIdeal))]
    exact congrArg _ (hm.trans h2.symm)

  have s7 : ∀ (A M L : Type u) [CommRing A] [CommRing M] [CommRing L] [Algebra A M] [Algebra A L]
      (Θ : M →ₐ[A] L), Function.Injective Θ → (∀ f : L, IsIntegral A f → ∃ s : M, Θ s = f) →
      Nonempty (↥(integralClosure A M) ≃ₐ[A] ↥(integralClosure A L)) := by
    intro A M L _ _ _ _ _ Θ hinj hsurj
    refine ⟨AlgEquiv.ofBijective (Θ.mapIntegralClosure) ⟨?_, ?_⟩⟩
    · intro x y hxy
      apply Subtype.ext
      apply hinj
      have := congrArg Subtype.val hxy
      simpa using this
    · rintro ⟨f, hf⟩
      obtain ⟨s, hs⟩ := hsurj f hf
      have hsi : IsIntegral A s := (isIntegral_algHom_iff Θ hinj).mp (hs ▸ hf)
      refine ⟨⟨s, hsi⟩, ?_⟩
      apply Subtype.ext
      simpa using hs

  intro N X φ hDom hGLu hGLe hB3 hB4 U hU
  letI := (φ.app U).hom.toAlgebra

  have hGPiso : ∀ η : N, (∀ x' : N, x' ⤳ η → x' = η) → IsIso (φ.stalkMap η) := by
    intro η hη
    obtain ⟨y, hy, hiso⟩ := hB4 (φ η) (hB3 η hη)
    have : η = y := (hy η).mp rfl
    subst this
    exact hiso
  have hGPfib : ∀ z : X, (∀ x' : X, x' ⤳ z → x' = z) → ∃ y : N, φ y = z ∧
      (∀ x' : N, x' ⤳ y → x' = y) ∧ ∀ y' : N, φ y' = z → y' = y := by
    intro z hz
    obtain ⟨y, hy, -⟩ := hB4 z hz
    have hφy : φ y = z := (hy y).mpr rfl
    refine ⟨y, hφy, ?_, fun y' h' => (hy y').mp h'⟩
    intro x' hx'
    apply (hy x').mp
    have h1 : φ x' ⤳ φ y := hx'.map φ.continuous
    rw [hφy] at h1
    exact hz _ h1
  obtain ⟨hs1a, hs1b⟩ := s1 X U hU
  have hrange := hU.range_fromSpec
  have hzU : ∀ P : {P : PrimeSpectrum Γ(X, U) // P.asIdeal ∈ minimalPrimes Γ(X, U)},
      hU.fromSpec P.1 ∈ U := by
    intro P
    show hU.fromSpec P.1 ∈ (U : Set X)
    rw [← hrange]; exact ⟨P.1, rfl⟩
  choose y hyφ hyGP hyuniq using fun P : {P : PrimeSpectrum Γ(X, U) // P.asIdeal ∈ minimalPrimes Γ(X, U)} =>
    hGPfib (hU.fromSpec P.1) (hs1a P)
  have hxU : ∀ P, φ (y P) ∈ U := fun P => by rw [hyφ P]; exact hzU P
  have hy : ∀ P, y P ∈ φ ⁻¹ᵁ U := hxU

  have hyinj : Function.Injective y := by
    intro P Q hPQ
    have h1 : hU.fromSpec P.1 = hU.fromSpec Q.1 := by rw [← hyφ P, ← hyφ Q, hPQ]
    exact Subtype.ext (hU.fromSpec.isOpenEmbedding.injective h1)

  have hcov : ∀ η : N, η ∈ φ ⁻¹ᵁ U → (∀ x' : N, x' ⤳ η → x' = η) → ∃ P, y P = η := by
    intro η hηW hηGP
    have hφη : φ η ∈ U := hηW
    have hmin := hs1b (φ η) hφη (hB3 η hηGP)
    refine ⟨⟨_, hmin⟩, ?_⟩
    have hz : hU.fromSpec (hU.primeIdealOf ⟨φ η, hφη⟩) = φ η := hU.fromSpec_primeIdealOf ⟨φ η, hφη⟩
    exact (hyuniq ⟨_, hmin⟩ η hz.symm).symm

  choose ε hε using fun P : {P : PrimeSpectrum Γ(X, U) // P.asIdeal ∈ minimalPrimes Γ(X, U)} =>
    s2 X U hU (φ (y P)) (hxU P) P.1 (hyφ P).symm
  let σ : ∀ P, X.presheaf.stalk (φ (y P)) ≃+* N.presheaf.stalk (y P) := fun P =>
    (@asIso _ _ _ _ (φ.stalkMap (y P)) (hGPiso _ (hyGP P))).commRingCatIsoToRingEquiv
  let τ : ∀ P, Localization.AtPrime P.1.asIdeal ≃+* N.presheaf.stalk (y P) := fun P =>
    (ε P).trans (σ P)
  have hτ : ∀ P (a : Γ(X, U)), τ P (algebraMap Γ(X, U) (Localization.AtPrime P.1.asIdeal) a) =
      (N.presheaf.germ (φ ⁻¹ᵁ U) (y P) (hy P)).hom ((φ.app U).hom a) := by
    intro P a
    show σ P (ε P _) = _
    rw [hε P a]
    exact Scheme.Hom.germ_stalkMap_apply φ U (y P) (hxU P) a
  refine ⟨?_, ?_⟩
  ·
    intro P
    haveI : IsDomain (Localization.AtPrime P.1.asIdeal) :=
      MulEquiv.isDomain _ (τ P).toMulEquiv
    exact s3 _ P.1 P.2 inferInstance
  ·
    let Θi : ∀ P : {P : PrimeSpectrum Γ(X, U) // P.asIdeal ∈ minimalPrimes Γ(X, U)},
        Γ(N, φ ⁻¹ᵁ U) →ₐ[Γ(X, U)] Localization.AtPrime P.1.asIdeal := fun P =>
      { toRingHom := (τ P).symm.toRingHom.comp (N.presheaf.germ (φ ⁻¹ᵁ U) (y P) (hy P)).hom
        commutes' := by
          intro a
          show (τ P).symm ((N.presheaf.germ (φ ⁻¹ᵁ U) (y P) (hy P)).hom ((φ.app U).hom a)) = _
          rw [← hτ P a, RingEquiv.symm_apply_apply] }
    let Θ := AlgHom.pi Θi
    have hΘ : ∀ s P, τ P (Θ s P) = (N.presheaf.germ (φ ⁻¹ᵁ U) (y P) (hy P)).hom s := by
      intro s P
      show τ P ((τ P).symm _) = _
      exact RingEquiv.apply_symm_apply _ _
    have hΘinj : Function.Injective Θ := by
      intro s s' hss'
      apply hGLu
      intro η hη hηGP
      obtain ⟨P, rfl⟩ := hcov η hη hηGP
      rw [← hΘ s P, ← hΘ s' P, hss']
    apply s7 _ _ _ Θ hΘinj
    intro f hf

    classical
    let h : (η : N) → N.presheaf.stalk η := fun η =>
      if hex : ∃ P, y P = η then hex.choose_spec ▸ τ hex.choose (f hex.choose) else 0
    have hh : ∀ P, h (y P) = τ P (f P) := by
      intro P
      have hex : ∃ Q, y Q = y P := ⟨P, rfl⟩
      simp only [h, dif_pos hex]
      have key : ∀ (Q : {P : PrimeSpectrum Γ(X, U) // P.asIdeal ∈ minimalPrimes Γ(X, U)})
          (hQ : y Q = y P), (hQ ▸ τ Q (f Q) : N.presheaf.stalk (y P)) = τ P (f P) := by
        intro Q hQ
        obtain rfl : Q = P := hyinj hQ
        rfl
      exact key _ _
    obtain ⟨s, hs⟩ := hGLe (φ ⁻¹ᵁ U) h (by
      intro x hx η hηx hηGP
      have hηW : η ∈ φ ⁻¹ᵁ U := hηx.mem_open (φ ⁻¹ᵁ U).isOpen hx
      obtain ⟨P, rfl⟩ := hcov η hηW hηGP
      rw [hh P]
      have hfi : IsIntegral Γ(X, U) (f P) := hf.map (Pi.evalAlgHom Γ(X, U) _ P)
      have h1 := RingHom.IsIntegralElem.map hfi (τ P).toRingHom
      have hcomp : (τ P).toRingHom.comp (algebraMap Γ(X, U) (Localization.AtPrime P.1.asIdeal)) =
          (N.presheaf.stalkSpecializes hηx).hom.comp
            ((N.presheaf.germ (φ ⁻¹ᵁ U) x hx).hom.comp (φ.app U).hom) := by
        ext a
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
        rw [hτ P a, TopCat.Presheaf.germ_stalkSpecializes_apply]
      rw [hcomp] at h1
      exact RingHom.IsIntegralElem.of_comp h1)
    refine ⟨s, ?_⟩
    funext P
    apply (τ P).injective
    rw [hΘ s P, hs (y P) (hy P) (hyGP P), hh P]

theorem wcpa_dj_nccw_rel_normalization : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → wcpaDjNccNagata.{u} → ∀ (N X : Scheme.{u}) (w : X ⟶ Spec (.of R)) (φ : N ⟶ X), IsProper w → IsProper φ → nccwsuNDS N → nccwsuGEN (φ ≫ w) → nccwsuBir w φ → ∃ (S : Scheme.{u}) (ν : S ⟶ X) (q : N ⟶ S), q ≫ ν = φ ∧ IsFinite ν ∧ Surjective ν ∧ nccwsuNDS S ∧ nccwsuNL ν ∧ IsProper q ∧ nccwsuGEN (ν ≫ w) ∧ (∀ s : S, nccwsuGP s → nccwsuGP (ν s)) ∧ ∀ V : X.Opens, IsFinite (φ ∣_ V) → IsIso (q ∣_ ν ⁻¹ᵁ V) :=
by
  intro R _ _ _ hcomp hNag N X w φ hw hφ hN hgen hBir
  obtain ⟨hB1, -, hB3, hB4⟩ := hBir
  haveI := hw
  haveI := hφ
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian w
  haveI : IsLocallyNoetherian N := LocallyOfFiniteType.isLocallyNoetherian (φ ≫ w)

  have hnag : ∀ (U : X.Opens), IsAffineOpen U → ∀ (P : Ideal Γ(X, U)) [P.IsPrime],
      Module.Finite (Γ(X, U) ⧸ P) (integralClosure (Γ(X, U) ⧸ P) (FractionRing (Γ(X, U) ⧸ P))) := by
    intro U hU P hP
    have h1 : (w.appLE ⊤ U le_top).hom.FiniteType :=
      HasRingHomProperty.appLE @LocallyOfFiniteType w inferInstance ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
    have h2 : ((Ideal.Quotient.mk P).comp ((w.appLE ⊤ U le_top).hom.comp
        (Scheme.ΓSpecIso (.of R)).inv.hom)).FiniteType := by
      refine RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _
        Ideal.Quotient.mk_surjective) (RingHom.FiniteType.comp h1 ?_)
      exact RingHom.FiniteType.of_surjective _
        ((ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of R)).inv).2)
    letI : Algebra R (Γ(X, U) ⧸ P) := ((Ideal.Quotient.mk P).comp ((w.appLE ⊤ U le_top).hom.comp
        (Scheme.ΓSpecIso (.of R)).inv.hom)).toAlgebra
    exact hNag R hcomp (Γ(X, U) ⧸ P) h2 inferInstance

  have h8 := nccwrn_irreducible_nbhd N (fun x => (hN x).1)
  obtain ⟨hGLu, hGLe⟩ := nccwrn_generic_sheaf N (fun x => (hN x).2) h8

  have hchart := nccwrn_chart N X φ (fun x => (hN x).1) hGLu hGLe hB3 hB4
  have hnoeth : ∀ U : X.Opens, IsAffineOpen U → IsNoetherianRing Γ(X, U) := fun U hU =>
    IsLocallyNoetherian.component_noetherian ⟨U, hU⟩

  have hcomp' : φ.toNormalization ≫ φ.fromNormalization = φ :=
    Scheme.Hom.toNormalization_fromNormalization φ
  have hpt : ∀ y : N, φ.fromNormalization (φ.toNormalization y) = φ y := fun y => by
    rw [← Scheme.Hom.comp_apply, hcomp']

  have hfin : IsFinite φ.fromNormalization := by
    apply nccwrn_norm_finite φ
    intro U hU
    letI := (φ.app U).hom.toAlgebra
    haveI := hnoeth U hU
    obtain ⟨hfield, he⟩ := hchart U hU
    exact nccwrn_ring_finite Γ(X, U) hfield (fun P _ => hnag U hU P) _ he

  have hNDS : nccwsuNDS φ.normalization := by
    refine nccwrn_norm_stalks φ ?_
    intro U hU
    letI := (φ.app U).hom.toAlgebra
    haveI := hnoeth U hU
    obtain ⟨hfield, he⟩ := hchart U hU
    exact nccwrn_ring_stalks_normal Γ(X, U) hfield _ he

  have hNL : nccwsuNL φ.fromNormalization := by
    refine nccwrn_norm_normal_locus φ ?_
    intro U hU
    letI := (φ.app U).hom.toAlgebra
    haveI := hnoeth U hU
    obtain ⟨hfield, he⟩ := hchart U hU
    exact nccwrn_ring_normal_point Γ(X, U) hfield _ he

  haveI hqp : IsProper φ.toNormalization := by
    haveI : IsProper (φ.toNormalization ≫ φ.fromNormalization) := by rw [hcomp']; exact hφ
    exact IsProper.of_comp φ.toNormalization φ.fromNormalization

  have hνs : Surjective φ.fromNormalization := by
    haveI : Surjective (φ.toNormalization ≫ φ.fromNormalization) := by rw [hcomp']; exact hB1
    exact Surjective.of_comp φ.toNormalization φ.fromNormalization

  have hqsurj : ∀ s : φ.normalization, ∃ y : N, φ.toNormalization y = s := by
    have hcl : IsClosed (Set.range φ.toNormalization) :=
      φ.toNormalization.isClosedMap.isClosed_range
    have hd : DenseRange φ.toNormalization := φ.toNormalization.denseRange
    have huniv : Set.range φ.toNormalization = Set.univ := by
      rw [← hcl.closure_eq]; exact hd.closure_range
    intro s
    have : s ∈ Set.range φ.toNormalization := by rw [huniv]; exact Set.mem_univ s
    exact this

  have hGEN : nccwsuGEN (φ.fromNormalization ≫ w) := by
    intro s
    obtain ⟨y, rfl⟩ := hqsurj s
    obtain ⟨y', hy', hne⟩ := hgen y
    refine ⟨φ.toNormalization y', hy'.map φ.toNormalization.continuous, ?_⟩
    rw [Scheme.Hom.comp_apply, hpt]
    rw [Scheme.Hom.comp_apply] at hne
    exact hne

  have hGP : ∀ s : φ.normalization, nccwsuGP s → nccwsuGP (φ.fromNormalization s) := by
    intro s hs
    obtain ⟨y, rfl⟩ := hqsurj s
    obtain ⟨Z, hZ, hyZ⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible ({y} : Set N) isIrreducible_singleton
    obtain ⟨η, hη⟩ := QuasiSober.sober hZ.1
      (isClosed_of_mem_irreducibleComponents Z hZ)
    have hηy : η ⤳ y := by
      rw [specializes_iff_mem_closure, hη.def]; exact hyZ rfl
    have hηGP : nccwsuGP η := by
      intro η' h'
      have hsub : Z ⊆ closure {η'} := by
        rw [← hη.def]; exact h'.closure_subset
      have hle : closure {η'} ⊆ Z := hZ.2 isIrreducible_singleton.closure hsub
      have hη'Z : η' ∈ Z := hle (subset_closure rfl)
      have h2 : η ⤳ η' := by
        rw [specializes_iff_mem_closure, hη.def]; exact hη'Z
      exact (h'.antisymm h2).eq
    have hqη : φ.toNormalization η = φ.toNormalization y :=
      hs _ (hηy.map φ.toNormalization.continuous)
    rw [← hqη, hpt]
    exact hB3 η hηGP

  have hiso : ∀ V : X.Opens, IsFinite (φ ∣_ V) →
      IsIso (φ.toNormalization ∣_ φ.fromNormalization ⁻¹ᵁ V) := by
    intro V hV
    haveI := hV
    exact nccwrn_norm_iso_over_integral φ V inferInstance
  exact ⟨φ.normalization, φ.fromNormalization, φ.toNormalization, hcomp', hfin, hνs, hNDS, hNL,
    hqp, hGEN, hGP, hiso⟩

theorem wcpa_dj_nccw_flat_fibre_dims : nccwsuDimFact.{u} :=
by
  have s1 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R), Irreducible ϖ → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra R B], algebraMap R B ϖ ≠ 0 → ringKrullDim (Localization.Away (algebraMap R B ϖ)) = 1 → ∃ x : B, ¬ IsAlgebraic R x := by
    intro R _ _ _ ϖ hϖ B _ _ _ hb hdim
    by_contra hcon
    push_neg at hcon
    set b := algebraMap R B ϖ with hbdef
    haveI : IsDomain (Localization.Away b) :=
      IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hb)
    have hbu : IsUnit (algebraMap B (Localization.Away b) b) := IsLocalization.Away.algebraMap_isUnit b
    have hRu : ∀ c : R, c ≠ 0 → IsUnit (algebraMap B (Localization.Away b) (algebraMap R B c)) := by
      intro c hc
      obtain ⟨n, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc hϖ
      rw [hv, map_mul, map_mul, map_pow, map_pow]
      exact ((v.isUnit.map _).map _).mul (hbu.pow n)
    have hxu : ∀ x : B, x ≠ 0 → IsUnit (algebraMap B (Localization.Away b) x) := by
      intro x hx
      obtain ⟨p, hp0, hpx⟩ := hcon x
      obtain ⟨q, hpq, hnd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd p hp0 0
      have hq : Polynomial.aeval x q = 0 := by
        rw [hpq, map_zero, sub_zero, Polynomial.aeval_mul, Polynomial.aeval_X_pow] at hpx
        exact (mul_eq_zero.mp hpx).resolve_left (pow_ne_zero _ hx)
      have hc : q.coeff 0 ≠ 0 := by
        intro h
        apply hnd
        rw [map_zero, sub_zero]
        exact Polynomial.X_dvd_iff.mpr h
      have key : x * (- Polynomial.aeval x q.divX) = algebraMap R B (q.coeff 0) := by
        have h2 := congrArg (Polynomial.aeval x) (Polynomial.divX_mul_X_add q)
        rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, hq] at h2
        linear_combination -h2
      have := hRu _ hc
      rw [← key, map_mul] at this
      exact isUnit_of_mul_isUnit_left this
    have hfield : IsField (Localization.Away b) := by
      refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, ?_⟩
      intro z hz
      obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers b) z
      have hx : x ≠ 0 := by
        rintro rfl
        exact hz (IsLocalization.mk'_zero _)
      have hu : IsUnit (IsLocalization.mk' (Localization.Away b) x s) := by
        have h1 := IsLocalization.mk'_spec (Localization.Away b) x s
        have h2 := hxu x hx
        rw [← h1] at h2
        exact isUnit_of_mul_isUnit_left h2
      obtain ⟨w, hw⟩ := hu.exists_right_inv
      exact ⟨w, hw⟩
    rw [ringKrullDim_eq_zero_of_isField hfield] at hdim
    exact absurd hdim (by decide)
  have s3 : ∀ (R : Type u) [CommRing R] [IsDomain R] (B : Type u) [CommRing B] [IsDomain B] [Algebra R B], Algebra.FiniteType R B → ∀ (P : Ideal B) [P.IsPrime], Algebra.QuasiFiniteAt R P → ∀ x : B, IsAlgebraic R x := by
    intro R _ _ B _ _ _ hft P _ hqf x
    haveI := hft
    haveI := hqf
    have hz := Algebra.ZariskisMainProperty.of_finiteType (R := R) P
    obtain ⟨r, hrP, hri, hr⟩ := Algebra.zariskisMainProperty_iff.mp hz
    obtain ⟨m, hm⟩ := hr x
    have hr0 : r ≠ 0 := fun h => hrP (h ▸ P.zero_mem)
    have hrm : r ^ m ∈ nonZeroDivisors B := mem_nonZeroDivisors_of_ne_zero (pow_ne_zero _ hr0)
    exact IsAlgebraic.of_mul hrm (hri.pow m).isAlgebraic hm.isAlgebraic
  have s2 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R), Irreducible ϖ → ∀ (B : Type u) [CommRing B] [Algebra R B], Algebra.FiniteType R B → ∀ (P : Ideal B) [P.IsPrime], P ∈ (Ideal.span {algebraMap R B ϖ}).minimalPrimes → P.IsMaximal → Algebra.QuasiFiniteAt R P := by
    classical
    intro R _ _ _ ϖ hϖ B _ _ hft P _ hmin hmax
    haveI := hft
    haveI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing R B
    set b := algebraMap R B ϖ with hbdef
    have hMfin := Ideal.finite_minimalPrimes_of_isNoetherianRing B (Ideal.span {b})
    set S := hMfin.toFinset.erase P with hS
    have hQ : ∀ Q ∈ S, ∃ f, f ∈ Q ∧ f ∉ P := by
      intro Q hQS
      rw [Finset.mem_erase, Set.Finite.mem_toFinset] at hQS
      obtain ⟨hQP, hQm⟩ := hQS
      by_contra hcon
      push_neg at hcon
      have hle : Q ≤ P := hcon
      have hmin' : Minimal (fun q : Ideal B => q.IsPrime ∧ Ideal.span {b} ≤ q) P := hmin
      have hQm' : Minimal (fun q : Ideal B => q.IsPrime ∧ Ideal.span {b} ≤ q) Q := hQm
      have := hmin'.eq_of_le hQm'.1 hle
      exact hQP this
    choose! f hfQ hfP using hQ
    set g := ∏ Q ∈ S, f Q with hg
    have hgP : g ∉ P := by
      rw [hg]
      intro h
      obtain ⟨Q, hQS, hQ⟩ := (Ideal.IsPrime.prod_mem_iff (p := P)).mp h
      exact hfP Q hQS hQ
    have hgQ : ∀ Q ∈ S, g ∈ Q := fun Q hQS =>
      Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem f hQS) (hfQ Q hQS)
    have hbP : b ∈ P := (Ideal.span_singleton_le_iff_mem P).mp hmin.1.2
    let q : PrimeSpectrum B := ⟨P, inferInstance⟩
    apply Algebra.QuasiFiniteAt.of_isOpen_singleton_fiber q
    convert isOpen_induced (PrimeSpectrum.isOpen_basicOpen (a := g)) using 1
    ext ⟨Q', hQ'⟩
    simp only [Set.mem_singleton_iff, Set.mem_preimage, PrimeSpectrum.mem_basicOpen]
    constructor
    · intro h
      have := congrArg Subtype.val h
      simp only at this
      subst this
      exact hgP
    · intro hg'
      apply Subtype.ext
      simp only
      have hfib : Q'.asIdeal.comap (algebraMap R B) = P.comap (algebraMap R B) := by
        have := hQ'
        simp only [Set.mem_preimage, Set.mem_singleton_iff] at this
        exact congrArg PrimeSpectrum.asIdeal this
      have hbQ' : b ∈ Q'.asIdeal := by
        have : ϖ ∈ P.comap (algebraMap R B) := hbP
        rw [← hfib] at this
        exact this
      obtain ⟨Q, hQm, hQle⟩ := Ideal.exists_minimalPrimes_le
        ((Ideal.span_singleton_le_iff_mem Q'.asIdeal).mpr hbQ')
      by_cases hQP : Q = P
      · subst hQP
        have := hmax.eq_of_le Q'.isPrime.ne_top hQle
        exact PrimeSpectrum.ext this.symm
      · exfalso
        apply hg'
        apply hQle
        apply hgQ
        rw [Finset.mem_erase, Set.Finite.mem_toFinset]
        exact ⟨hQP, hQm⟩
  have s4 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R), Irreducible ϖ → ∀ (B : Type u) [CommRing B] [Algebra R B], Algebra.FiniteType R B → ∀ P₀ P₁ P₂ : Ideal B, P₀.IsPrime → P₁.IsPrime → P₂.IsPrime → algebraMap R B ϖ ∈ P₀ → P₀ < P₁ → P₁ < P₂ → (P₀.comap (algebraMap R B)).IsMaximal ∧ Algebra.FiniteType (R ⧸ P₀.comap (algebraMap R B)) (B ⧸ P₀) ∧ ∃ Q₁ Q₂ : Ideal (B ⧸ P₀), Q₁.IsPrime ∧ Q₂.IsPrime ∧ ⊥ < Q₁ ∧ Q₁ < Q₂ := by
    intro R _ _ _ ϖ hϖ B _ _ hft P₀ P₁ P₂ h0 h1 h2 hb h01 h12
    haveI := hft
    refine ⟨?_, ?_, ?_⟩
    · apply Ideal.IsPrime.isMaximal_of_ne_bot (Ideal.IsPrime.comap _)
      intro h
      have : ϖ ∈ P₀.comap (algebraMap R B) := hb
      rw [h, Ideal.mem_bot] at this
      exact hϖ.ne_zero this
    · haveI : Algebra.FiniteType R (B ⧸ P₀) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ R P₀) (Ideal.Quotient.mkₐ_surjective R P₀)
      exact Algebra.FiniteType.of_restrictScalars_finiteType R (R ⧸ P₀.comap (algebraMap R B)) (B ⧸ P₀)
    · have hker : RingHom.ker (Ideal.Quotient.mk P₀) = P₀ := Ideal.mk_ker
      have hc : ∀ P : Ideal B, P₀ ≤ P → (P.map (Ideal.Quotient.mk P₀)).comap (Ideal.Quotient.mk P₀) = P := by
        intro P hP
        rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, hker]
        exact sup_eq_left.mpr hP
      refine ⟨P₁.map (Ideal.Quotient.mk P₀), P₂.map (Ideal.Quotient.mk P₀),
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [hker]; exact h01.le),
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [hker]; exact (h01.trans h12).le),
        ?_, ?_⟩
      · obtain ⟨t, ht1, ht0⟩ := SetLike.exists_of_lt h01
        refine bot_lt_iff_ne_bot.mpr ?_
        intro h
        have : Ideal.Quotient.mk P₀ t ∈ P₁.map (Ideal.Quotient.mk P₀) := Ideal.mem_map_of_mem _ ht1
        rw [h, Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem] at this
        exact ht0 this
      · refine lt_of_le_of_ne (Ideal.map_mono h12.le) ?_
        intro h
        have := congrArg (Ideal.comap (Ideal.Quotient.mk P₀)) h
        rw [hc P₁ h01.le, hc P₂ (h01.trans h12).le] at this
        exact h12.ne this
  have s6 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R), Irreducible ϖ → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra R B], algebraMap R B ϖ ≠ 0 → ∀ (P : Ideal B) [P.IsPrime] (n : ℕ) (x : Fin n → B), AlgebraicIndependent (R ⧸ P.comap (algebraMap R B)) (Ideal.Quotient.mk P ∘ x) → AlgebraicIndependent R x := by
    intro R _ _ _ ϖ hϖ B _ _ _ hb P _ n x hind
    set p := P.comap (algebraMap R B) with hp
    rw [algebraicIndependent_iff] at hind ⊢
    have hpne : p ≠ ⊤ := (Ideal.IsPrime.comap (algebraMap R B) (K := P)).ne_top

    have caseA : ∀ G : MvPolynomial (Fin n) R, MvPolynomial.aeval x G = 0 → ∀ e, IsUnit (G.coeff e) → False := by
      intro G hG e he
      set Gb := MvPolynomial.map (Ideal.Quotient.mk p) G
      have hGb : Gb ≠ 0 := by
        intro h
        have hce := congrArg (fun F : MvPolynomial (Fin n) (R ⧸ p) => F.coeff e) h
        simp only [Gb, MvPolynomial.coeff_map, MvPolynomial.coeff_zero] at hce
        haveI : Nontrivial (R ⧸ p) := Ideal.Quotient.nontrivial_iff.mpr hpne
        exact (he.map (Ideal.Quotient.mk p)).ne_zero hce
      apply hGb
      apply hind
      have e1 : MvPolynomial.aeval (Ideal.Quotient.mk P ∘ x) Gb = MvPolynomial.aeval (Ideal.Quotient.mk P ∘ x) G := by
        simp only [Gb]
        rw [← Ideal.Quotient.algebraMap_eq]
        exact MvPolynomial.aeval_map_algebraMap (R ⧸ p) _ G
      rw [e1]
      have e2 : MvPolynomial.aeval (Ideal.Quotient.mk P ∘ x) G = Ideal.Quotient.mkₐ R P (MvPolynomial.aeval x G) := by
        rw [MvPolynomial.aeval_def, MvPolynomial.aeval_def, Ideal.Quotient.mkₐ_eq_mk,
          MvPolynomial.eval₂_comp_left, IsScalarTower.algebraMap_eq R B (B ⧸ P), Ideal.Quotient.algebraMap_eq]
      rw [e2, hG, map_zero]
    have key : ∀ N : ℕ, ∀ G : MvPolynomial (Fin n) R, MvPolynomial.aeval x G = 0 → ∀ d, G.coeff d ≠ 0 → ¬ ϖ ^ (N + 1) ∣ G.coeff d → False := by
      intro N
      induction N with
      | zero =>
        intro G hG d hd hnd
        obtain ⟨k, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hd hϖ
        cases k with
        | zero => exact caseA G hG d (by rw [hv, pow_zero, mul_one]; exact v.isUnit)
        | succ k => exact hnd (by rw [hv, zero_add, pow_one, pow_succ]; exact ⟨v * ϖ ^ k, by ring⟩)
      | succ N ih =>
        intro G hG d hd hnd
        by_cases hall : ∀ i, ϖ ∣ G.coeff i
        · obtain ⟨G', hG'⟩ := (MvPolynomial.C_dvd_iff_dvd_coeff ϖ G).mpr hall
          have hG'0 : MvPolynomial.aeval x G' = 0 := by
            rw [hG', map_mul, MvPolynomial.aeval_C] at hG
            exact (mul_eq_zero.mp hG).resolve_left hb
          have hcd : G.coeff d = ϖ * G'.coeff d := by rw [hG', MvPolynomial.coeff_C_mul]
          refine ih G' hG'0 d ?_ ?_
          · intro h; apply hd; rw [hcd, h, mul_zero]
          · intro h; apply hnd; rw [hcd, pow_succ']; exact mul_dvd_mul_left ϖ h
        · push_neg at hall
          obtain ⟨e, he⟩ := hall
          have he0 : G.coeff e ≠ 0 := fun h => he (h ▸ dvd_zero ϖ)
          obtain ⟨k, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible he0 hϖ
          cases k with
          | zero => exact caseA G hG e (by rw [hv, pow_zero, mul_one]; exact v.isUnit)
          | succ k => exact he (by rw [hv, pow_succ]; exact ⟨v * ϖ ^ k, by ring⟩)
    intro F hF
    by_contra hF0
    obtain ⟨d, hd⟩ := MvPolynomial.exists_coeff_ne_zero hF0
    obtain ⟨N, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hd hϖ
    refine key N F hF d hd ?_
    rintro ⟨c, hc⟩
    rw [hv, pow_succ, mul_assoc] at hc
    have h1 : (v : R) = ϖ * c := by
      have hne : ϖ ^ N ≠ 0 := pow_ne_zero _ hϖ.ne_zero
      apply mul_left_cancel₀ hne
      linear_combination hc
    exact hϖ.not_isUnit (isUnit_of_mul_isUnit_left (h1 ▸ v.isUnit))
  have s5 : ∀ (k A : Type u) [Field k] [CommRing A] [IsDomain A] [Algebra k A], Algebra.FiniteType k A → ∀ Q₁ Q₂ : Ideal A, Q₁.IsPrime → Q₂.IsPrime → ⊥ < Q₁ → Q₁ < Q₂ → ∃ y : Fin 2 → A, AlgebraicIndependent k y := by
    intro k A _ _ _ _ hft Q₁ Q₂ hQ₁ hQ₂ h01 h12
    haveI := hft
    obtain ⟨s, g, hg, hgi⟩ := exists_integral_inj_algHom_of_fg k A
    letI : Algebra (MvPolynomial (Fin s) k) A := g.toRingHom.toAlgebra
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) A := ⟨fun a => hgi a⟩
    have l1 := Ideal.IsIntegral.under_lt_under (R := MvPolynomial (Fin s) k) h01
    have l2 := Ideal.IsIntegral.under_lt_under (R := MvPolynomial (Fin s) k) h12
    let l : LTSeries (PrimeSpectrum (MvPolynomial (Fin s) k)) :=
      { length := 2
        toFun := ![⟨Ideal.under _ (⊥ : Ideal A), inferInstance⟩, ⟨Ideal.under _ Q₁, inferInstance⟩,
          ⟨Ideal.under _ Q₂, inferInstance⟩]
        step := by
          intro i
          fin_cases i
          · exact l1
          · exact l2 }
    have hdim : ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (MvPolynomial (Fin s) k) :=
      Order.LTSeries.length_le_krullDim l
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
      ENat.card_eq_coe_fintype_card, Fintype.card_fin] at hdim
    have hs : 2 ≤ s := by
      have h2 : ((2:ℕ∞) : WithBot ℕ∞) ≤ ((s : ℕ∞) : WithBot ℕ∞) := hdim
      have h3 : (2:ℕ∞) ≤ (s : ℕ∞) := WithBot.coe_le_coe.mp h2
      exact_mod_cast h3
    exact ⟨_, ((MvPolynomial.algebraicIndependent_X (Fin s) k).comp _ (Fin.castLE_injective hs)).map' hg⟩
  have s8 : ∀ (k A : Type u) [Field k] [CommRing A] [IsDomain A] [Algebra k A], Algebra.FiniteType k A → ∀ y : Fin 2 → A, AlgebraicIndependent k y → (2 : WithBot ℕ∞) ≤ ringKrullDim A := by
    intro k A _ _ _ _ hft y hy
    haveI := hft
    obtain ⟨s, g, hg, hgi⟩ := exists_integral_inj_algHom_of_fg k A

    set T : Set A := Set.range (g ∘ MvPolynomial.X) with hT
    have hmem : ∀ p, g p ∈ Algebra.adjoin k T := by
      intro p
      rw [hT, Algebra.adjoin_range_eq_range_aeval]
      exact ⟨p, by rw [← MvPolynomial.aeval_unique g]; rfl⟩
    set S := Algebra.adjoin k T
    let φ : MvPolynomial (Fin s) k →+* S := (g.codRestrict S hmem).toRingHom
    have hφ : (algebraMap S A).comp φ = g.toRingHom := by
      ext p <;> rfl
    haveI : Algebra.IsAlgebraic S A := by
      refine ⟨fun a => IsIntegral.isAlgebraic ?_⟩
      obtain ⟨p, hpm, hp⟩ := hgi a
      refine ⟨p.map φ, hpm.map φ, ?_⟩
      rw [Polynomial.eval₂_map, hφ]
      exact hp
    have c1 := hy.lift_cardinalMk_le_trdeg
    have c2 : Algebra.trdeg k A ≤ Cardinal.mk T := Algebra.IsAlgebraic.trdeg_le_cardinalMk k T
    have c3 : Cardinal.lift.{0, u} (Cardinal.mk T) ≤ Cardinal.lift.{u, 0} (Cardinal.mk (Fin s)) :=
      Cardinal.mk_range_le_lift
    have c4 := c1.trans ((Cardinal.lift_le.mpr c2).trans c3)
    rw [Cardinal.mk_fin, Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_natCast] at c4
    have hs : 2 ≤ s := by exact_mod_cast c4

    letI : Algebra (MvPolynomial (Fin s) k) A := g.toRingHom.toAlgebra
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) A := ⟨fun a => hgi a⟩
    haveI : Algebra.HasGoingUp (MvPolynomial (Fin s) k) A := Algebra.HasGoingUp.of_isIntegral
    have hdimP : ((2 : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (PrimeSpectrum (MvPolynomial (Fin s) k)) := by
      show ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (MvPolynomial (Fin s) k)
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field, zero_add,
        ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      show ((2:ℕ∞) : WithBot ℕ∞) ≤ ((s : ℕ∞) : WithBot ℕ∞)
      exact WithBot.coe_le_coe.mpr (by exact_mod_cast hs)
    obtain ⟨l, hl⟩ := Order.le_krullDim_iff.mp hdimP
    have hker : RingHom.ker (algebraMap (MvPolynomial (Fin s) k) A) ≤ l.head.asIdeal := by
      have : RingHom.ker (algebraMap (MvPolynomial (Fin s) k) A) = ⊥ :=
        (RingHom.injective_iff_ker_eq_bot _).mp hg
      rw [this]; exact bot_le
    obtain ⟨Q, hQ, hQu⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isDomain l.head.asIdeal hker
    haveI : Q.LiesOver l.head.asIdeal := ⟨hQu.symm⟩
    obtain ⟨L, hL, -⟩ := Ideal.exists_ltSeries_of_hasGoingUp l Q
    have := Order.LTSeries.length_le_krullDim L
    rw [hL, hl] at this
    exact this
  have s7 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R), Irreducible ϖ → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra R B], Algebra.FiniteType R B → algebraMap R B ϖ ≠ 0 → ∀ x : Fin 2 → B, AlgebraicIndependent R x → ∃ (_ : Algebra (FractionRing R) (Localization.Away (algebraMap R B ϖ))), Algebra.FiniteType (FractionRing R) (Localization.Away (algebraMap R B ϖ)) ∧ AlgebraicIndependent (FractionRing R) (algebraMap B (Localization.Away (algebraMap R B ϖ)) ∘ x) := by
    intro R _ _ _ ϖ hϖ B _ _ _ hft hb x hx
    haveI := hft
    set b := algebraMap R B ϖ with hbdef
    have hbu : IsUnit (algebraMap B (Localization.Away b) b) := IsLocalization.Away.algebraMap_isUnit b
    have hunit : ∀ y : nonZeroDivisors R, IsUnit (algebraMap R (Localization.Away b) (y : R)) := by
      intro y
      have hc : (y : R) ≠ 0 := nonZeroDivisors.ne_zero y.2
      obtain ⟨n, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc hϖ
      rw [hv, IsScalarTower.algebraMap_apply R B (Localization.Away b), map_mul, map_mul, map_pow, map_pow]
      exact ((v.isUnit.map _).map _).mul (hbu.pow n)
    let ψ : FractionRing R →+* Localization.Away b := IsLocalization.lift hunit
    letI inst : Algebra (FractionRing R) (Localization.Away b) := ψ.toAlgebra
    haveI : IsScalarTower R (FractionRing R) (Localization.Away b) :=
      IsScalarTower.of_algebraMap_eq (fun r => (IsLocalization.lift_eq hunit r).symm)
    refine ⟨inst, ?_, ?_⟩
    · haveI : Algebra.FiniteType B (Localization.Away b) :=
        IsLocalization.finiteType_of_monoid_fg (Submonoid.powers b) _
      haveI : Algebra.FiniteType R (Localization.Away b) := Algebra.FiniteType.trans (S := B) hft inferInstance
      exact Algebra.FiniteType.of_restrictScalars_finiteType R (FractionRing R) (Localization.Away b)
    · have hinj : Function.Injective (algebraMap B (Localization.Away b)) :=
        IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors hb)
      have h1 : AlgebraicIndependent R (algebraMap B (Localization.Away b) ∘ x) :=
        hx.map' (f := IsScalarTower.toAlgHom R B (Localization.Away b)) hinj
      haveI : Algebra.IsAlgebraic R (FractionRing R) := IsLocalization.isAlgebraic _ (nonZeroDivisors R)
      exact h1.extendScalars (FractionRing R)

  intro R _ _ _ ϖ hϖ B _ _ _ hft hb hdim
  haveI := hft
  have star : ∀ x : Fin 2 → B, ¬ AlgebraicIndependent R x := by
    intro x hx
    obtain ⟨inst, hft', hind⟩ := s7 R ϖ hϖ B hft hb x hx
    letI := inst
    haveI : IsDomain (Localization.Away (algebraMap R B ϖ)) :=
      IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hb)
    have h2 := s8 (FractionRing R) (Localization.Away (algebraMap R B ϖ)) hft' _ hind
    rw [hdim] at h2
    exact absurd h2 (by decide)
  refine ⟨?_, ?_⟩
  · intro P₀ P₁ P₂ h0 h1 h2 hb0 h01 h12
    by_contra hne
    push_neg at hne
    obtain ⟨hmax, hft0, Q₁, Q₂, hQ1, hQ2, hb1, h12'⟩ := s4 R ϖ hϖ B hft P₀ P₁ P₂ h0 h1 h2 hb0
      (lt_of_le_of_ne h01 hne.1) (lt_of_le_of_ne h12 hne.2)
    haveI := hmax
    haveI := h0
    letI : Field (R ⧸ P₀.comap (algebraMap R B)) := Ideal.Quotient.field _
    haveI : IsDomain (B ⧸ P₀) := Ideal.Quotient.isDomain P₀
    obtain ⟨y, hy⟩ := s5 (R ⧸ P₀.comap (algebraMap R B)) (B ⧸ P₀) hft0 Q₁ Q₂ hQ1 hQ2 hb1 h12'
    choose x hx using fun i => Ideal.Quotient.mk_surjective (I := P₀) (y i)
    have hxy : Ideal.Quotient.mk P₀ ∘ x = y := funext hx
    apply star x
    exact s6 R ϖ hϖ B hb P₀ 2 x (hxy ▸ hy)
  · intro P hP hmax
    haveI : P.IsPrime := hP.1.1
    have hq := s2 R ϖ hϖ B hft P hP hmax
    have halg := s3 R B hft P hq
    obtain ⟨x, hx⟩ := s1 R ϖ hϖ B hb hdim
    exact hx (halg x)

theorem wcpa_dj_nccw_flat_of_domain_generic : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (X : Scheme.{u}) (v : X ⟶ Spec (.of R)), (∀ x : X, IsDomain (X.presheaf.stalk x)) → nccwsuGEN v → Flat v :=
by
  intro R _ _ _ X v hD hG
  have crit : ∀ (P : Ideal R) [P.IsPrime] (A : Type u) [CommRing A] [Algebra R A]
      [IsLocalization.AtPrime A P] (B : Type u) [CommRing B] [IsDomain B] (φ : A →+* B),
      (∀ r : R, r ≠ 0 → φ (algebraMap R A r) ≠ 0) → φ.Flat := by
    intro P _ A _ _ _ B _ _ φ hφ
    letI := φ.toAlgebra
    haveI : IsDomain A := IsLocalization.isDomain_of_atPrime A P
    haveI : IsDedekindDomain A := IsLocalization.AtPrime.isDedekindDomain R P A
    show Module.Flat A B
    rw [IsDedekindDomain.flat_iff_torsion_eq_bot, eq_bot_iff]
    intro b hb
    rw [Submodule.mem_torsion_iff] at hb
    obtain ⟨⟨a, ha⟩, hab⟩ := hb
    have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
    obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.mk'_surjective P.primeCompl a
    dsimp only at hrs
    have hr : r ≠ 0 := by
      rintro rfl
      apply ha0
      rw [← hrs, IsLocalization.mk'_zero]
    have h1 := IsLocalization.mk'_spec A r s
    have hφa : φ a ≠ 0 := by
      intro h0
      apply hφ r hr
      rw [← h1, map_mul, hrs, h0, zero_mul]
    have hab' : φ a * b = 0 := by
      have : a • b = 0 := hab
      rwa [Algebra.smul_def, RingHom.algebraMap_toAlgebra] at this
    exact (Submodule.mem_bot A).mpr ((mul_eq_zero.mp hab').resolve_left hφa)
  have stalk_flat : ∀ (p : PrimeSpectrum R) (B : Type u) [CommRing B] [IsDomain B]
      (φ : (Spec.structureSheaf R).presheaf.stalk p →+* B),
      (∀ r : R, r ≠ 0 → φ (StructureSheaf.toStalk R p r) ≠ 0) → φ.Flat := by
    intro p B _ _ φ hφ
    haveI := StructureSheaf.IsLocalization.to_stalk R p
    refine crit p.asIdeal _ B φ ?_
    intro r hr
    rw [StructureSheaf.stalkAlgebra_map]
    exact hφ r hr
  have unit_lem : ∀ (q : PrimeSpectrum R) (r : R), r ∉ q.asIdeal →
      IsUnit (StructureSheaf.toStalk R q r) := by
    intro q r hr
    haveI := StructureSheaf.IsLocalization.to_stalk R q
    have := IsLocalization.map_units ((Spec.structureSheaf R).presheaf.stalk q)
      (⟨r, hr⟩ : q.asIdeal.primeCompl)
    rwa [StructureSheaf.stalkAlgebra_map] at this
  apply Flat.of_stalkMap
  intro x
  obtain ⟨x', h, hx'⟩ := hG x
  haveI := hD x
  have hq : ∀ r : R, r ≠ 0 → r ∉ (v x').asIdeal := by
    intro r hr hrq
    apply hx'
    have hne : (v x').asIdeal ≠ ⊥ := fun e => hr (by rw [e] at hrq; exact (Submodule.mem_bot R).mp hrq)
    have hmax := Ring.DimensionLEOne.maximalOfPrime hne (v x').isPrime
    exact PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)
  have hv : v x' ⤳ v x := h.map v.continuous
  have key : ∀ r : R, r ≠ 0 →
      (v.stalkMap x).hom (StructureSheaf.toStalk R (v x) r) ≠ 0 := by
    intro r hr h0
    have hu2 : IsUnit ((v.stalkMap x').hom (StructureSheaf.toStalk R (v x') r)) :=
      (unit_lem (v x') r (hq r hr)).map _
    have e1 : (Spec.structureSheaf R).presheaf.stalkSpecializes hv
        (StructureSheaf.toStalk R (v x) r) = StructureSheaf.toStalk R (v x') r :=
      StructureSheaf.toStalk_stalkSpecializes_apply hv r
    have e2 := Scheme.Hom.stalkSpecializes_stalkMap_apply v x' x h
      (StructureSheaf.toStalk R (v x) r)
    have e3 : (v.stalkMap x').hom (StructureSheaf.toStalk R (v x') r) =
        X.presheaf.stalkSpecializes h ((v.stalkMap x).hom (StructureSheaf.toStalk R (v x) r)) := by
      rw [← e1]
      exact e2
    rw [h0, map_zero] at e3
    exact hu2.ne_zero e3
  exact stalk_flat (v x) _ (v.stalkMap x).hom key

theorem wcpa_dj_nccw_special_fibre_topology : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of R)), IsProper u' → Topology.IsClosedEmbedding ⇑(Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) ∧ Set.range ⇑(Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) = ⇑u' ⁻¹' {IsLocalRing.closedPoint R} ∧ TopologicalSpace.NoetherianSpace ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) ∧ (∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), ∃ x, closure {x} = X ∧ ∀ x' : Z', u' x' = IsLocalRing.closedPoint R → x' ⤳ Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x → x' = Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x) ∧ (∀ ξ : Z', u' ξ = IsLocalRing.closedPoint R → (∀ x' : Z', u' x' = IsLocalRing.closedPoint R → x' ⤳ ξ → x' = ξ) → ∃ x, Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x = ξ ∧ closure {x} ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) :=
by
  intro R _ _ _ Z' u' hprop
  set ρ : Spec (.of (IsLocalRing.ResidueField R)) ⟶ Spec (.of R) :=
    Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) with hρ
  set f := Limits.pullback.fst u' ρ with hf
  haveI : IsClosedImmersion ρ :=
    IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue R))
      IsLocalRing.residue_surjective
  have C1 : Topology.IsClosedEmbedding ⇑f := f.isClosedEmbedding
  have hrng : Set.range ⇑ρ = {IsLocalRing.closedPoint R} := by
    have key : ∀ p : Spec (.of (IsLocalRing.ResidueField R)), ρ p = IsLocalRing.closedPoint R := by
      intro p
      apply PrimeSpectrum.ext
      rw [hρ, Spec.map_apply]
      show Ideal.comap (IsLocalRing.residue R) p.asIdeal = IsLocalRing.maximalIdeal R
      haveI := p.isPrime
      rw [Ideal.eq_bot_of_prime p.asIdeal, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
    ext y
    constructor
    · rintro ⟨p, rfl⟩
      exact key p
    · intro hy
      replace hy : y = IsLocalRing.closedPoint R := hy
      exact ⟨IsLocalRing.closedPoint (IsLocalRing.ResidueField R), (key _).trans hy.symm⟩
  have C2 : Set.range ⇑f = ⇑u' ⁻¹' {IsLocalRing.closedPoint R} := by
    rw [hf, Scheme.Pullback.range_fst, hrng]
  have C3 : TopologicalSpace.NoetherianSpace ↥(Limits.pullback u' ρ) := by
    haveI : IsLocallyNoetherian (Limits.pullback u' ρ) :=
