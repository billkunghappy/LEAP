theorem wcpa_dj_glt_st_completion_facts : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], ∃ (_ : IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P)), IsLocalHom (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) ∧ IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) ∧ Module.FaithfullyFlat P (AdicCompletion (IsLocalRing.maximalIdeal P) P) ∧ IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P) = (IsLocalRing.maximalIdeal P).map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) ∧ ∀ (k : ℕ) (z : AdicCompletion (IsLocalRing.maximalIdeal P) P), ∃ p : P, z - algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p ∈ ((IsLocalRing.maximalIdeal P).map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))) ^ k :=
