    rw [RingEquiv.trans_apply, IsScalarTower.algebraMap_apply Γ(S, W) (Localization.AtPrime 𝔪), hΦ]
    congr 2
    exact φ.commutes b
  have s2 (B : Type u) [CommRing B] (𝔪 : Ideal B) [𝔪.IsMaximal] (C₀ : Type u) [CommRing C₀]
      [Algebra B C₀] (hC₀ft : Algebra.FiniteType B C₀)
      (hC₀ : ∀ (P : Ideal C₀) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧
        IsIntegrallyClosed (Localization.AtPrime P))
      (A : Type u) [CommRing A] [Algebra B A]
      (e₁ : AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
        (Localization.AtPrime 𝔪) ≃+* A)
      (he₁ : ∀ b : B, e₁ (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal
        (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) b) = algebraMap B A b)
      (hExcL : ∀ (C : Type u) [CommRing C] [Algebra (Localization.AtPrime 𝔪) C],
        Algebra.FiniteType (Localization.AtPrime 𝔪) C →
        (∀ (P : Ideal C) [P.IsPrime],
          IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) →
        ∀ (D : Type u) [CommRing D]
          [Algebra (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
            (Localization.AtPrime 𝔪)) D] [Algebra C D] [Algebra (Localization.AtPrime 𝔪) D]
          [IsScalarTower (Localization.AtPrime 𝔪)
            (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
              (Localization.AtPrime 𝔪)) D]
          [IsScalarTower (Localization.AtPrime 𝔪) C D],
