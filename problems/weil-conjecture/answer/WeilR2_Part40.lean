  have pull : ∀ (X' X : Scheme.{u}) (h : X' ⟶ X) {m : ℕ} (W : Fin m → X.Opens),
      (∀ a b, Function.Surjective (h.app (W a ⊓ W b)).hom) →
      (∀ a b d, Function.Injective (h.app (W a ⊓ W b ⊓ W d)).hom) →
      wcpaP1rRawH1 W → wcpaP1rRawH1 (fun a => h ⁻¹ᵁ W a) := by
    intro X' X h m W hs hi hW c hc
    choose c' hc' using fun a b => hs a b (c a b)
    obtain ⟨β, hβ⟩ := hW c' (by
      intro a b d
      apply hi a b d
      rw [map_add, hnat h, hnat h, hnat h, hc', hc', hc']
