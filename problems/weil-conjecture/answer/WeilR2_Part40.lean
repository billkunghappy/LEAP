    obtain ⟨c, hc⟩ := IsLocalizedModule.exists_of_eq (S := 𝔭.primeCompl) heq
    refine ⟨(c : B) * s, (c * s).2, σ0 c * x0, ?_⟩
    rw [hd, map_mul, mul_assoc]
    exact hc



  have s4 : ∀ (B : Type u) [CommRing B] (A0 A1 : Type u) [CommRing A0] [CommRing A1]
      (σ0 : B →+* A0) (σ1 : B →+* A1) (d : A0 →+ A1),
