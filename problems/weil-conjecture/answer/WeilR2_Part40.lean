      let F : MvPowerSeries (Fin r) P := fun e => (h e.degree).coeff e
      refine ⟨F, ?_⟩
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [hΨ, AdicCompletion.evalₐ_mk]
      have e1 : Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F)) =
          Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (∑ k ∈ Finset.range n, h k)) := by
        apply HC
        intro d hd
        rw [MvPowerSeries.coeff_truncTotal _ hd, MvPolynomial.coeff_sum,
          Finset.sum_eq_single_of_mem d.degree (Finset.mem_range.mpr hd)]
        · rfl
        · intro k _ hk
          exact (hh k).coeff_eq_zero (Ne.symm hk)
      rw [e1, map_sum]
      simp only [he]
      rw [Finset.sum_range_sub]
      have hc0 : c 0 = 0 := by simp [c]
      rw [hc0, sub_zero]
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · rw [Ideal.Quotient.eq]; simp
      · simp only [c, if_neg hn.ne']
    have : IsNoetherianRing (MvPowerSeries (Fin r) P) := MvPowerSeries.isNoetherianRing P
    exact isNoetherianRing_of_surjective (MvPowerSeries (Fin r) P) _ Ψ hsurj

  have s3 : ∀ (A : Type u) [CommRing A] (I : Ideal A) (M : Type u) [AddCommGroup M] [Module A M]
      (D : A → M), (∀ a b, D (a + b) = D a + D b) → (∀ a b, D (a * b) = a • D b + b • D a) →
      ∀ (n : ℕ), ∀ a ∈ I ^ (n + 1), D a ∈ I ^ n • (⊤ : Submodule A M) := by
    intro A _ I M _ _ D hadd hmul n
    induction n with
    | zero => intro a _; simp
    | succ n ih =>
      intro a ha
      rw [pow_succ] at ha
      refine Submodule.mul_induction_on ha ?_ ?_
      · intro m hm i hi
        rw [hmul]
        refine add_mem ?_ ?_
        · exact Submodule.smul_mem_smul hm Submodule.mem_top
        · have h1 := Submodule.smul_mem_smul hi (ih m hm)
          rw [← Submodule.smul_assoc, smul_eq_mul, ← pow_succ'] at h1
          exact h1
      · intro x y hx hy
        rw [hadd]; exact add_mem hx hy

  have s4 : ∀ (O : Type u) [CommRing O] (I : Ideal O) (M : Type u) [AddCommGroup M] [Module O M]
      (d : O → M), (∀ a b, d (a + b) = d a + d b) → (∀ a b, d (a * b) = a • d b + b • d a) →
      (∀ (n : ℕ), ∀ a ∈ I ^ (n + 1), d a ∈ I ^ n • (⊤ : Submodule O M)) →
      ∃ D : AdicCompletion I O → AdicCompletion I M, (∀ a b, D (a + b) = D a + D b) ∧
        (∀ a b, D (a * b) = a • D b + b • D a) ∧
        ∀ f : O, D (algebraMap O (AdicCompletion I O) f) = AdicCompletion.of I M (d f) := by
    intro O _ I M _ _ d hadd hmul hcont
    have hI : ∀ n : ℕ, (I ^ n • (⊤ : Submodule O O)) = I ^ n := fun n => by
      rw [Ideal.smul_eq_mul, Ideal.mul_top]
    have hsub : ∀ a b, d (a - b) = d a - d b := by
      intro a b
      have := hadd (a - b) b
      rw [sub_add_cancel] at this
      rw [this, add_sub_cancel_right]
    have hdiff : ∀ (k : ℕ) (a b : O), a - b ∈ I ^ (k + 1) →
        (Submodule.Quotient.mk (d a) : M ⧸ (I ^ k • (⊤ : Submodule O M))) =
          Submodule.Quotient.mk (d b) := by
      intro k a b hab
      rw [Submodule.Quotient.eq, ← hsub]
      exact hcont k _ hab
    let Rep : AdicCompletion I O → (ℕ → O) → Prop := fun x h =>
      ∀ n, x.val n = Ideal.Quotient.mk (I ^ n • (⊤ : Submodule O O)) (h n)
    have hRep_cmp : ∀ x h, Rep x h → ∀ m n, m ≤ n → h n - h m ∈ I ^ m := by
      intro x h hx m n hmn
      have e1 : x.val m = AdicCompletion.transitionMap I O hmn (x.val n) := (x.prop hmn).symm
      rw [hx m, hx n] at e1
      have e2 : (Ideal.Quotient.mk (I ^ m • (⊤ : Submodule O O)) (h n)) =
          Ideal.Quotient.mk (I ^ m • (⊤ : Submodule O O)) (h m) := e1.symm
      rw [Ideal.Quotient.eq, hI] at e2
      exact e2
    have hRep_two : ∀ x h h', Rep x h → Rep x h' → ∀ n, h n - h' n ∈ I ^ n := by
      intro x h h' hx hx' n
      have e := (hx n).symm.trans (hx' n)
      rw [Ideal.Quotient.eq, hI] at e
      exact e
    let lift : AdicCompletion I O → ℕ → O := fun x n =>
      (Ideal.Quotient.mk_surjective (x.val n)).choose
    have hlift : ∀ x, Rep x (lift x) := fun x n =>
      (Ideal.Quotient.mk_surjective (x.val n)).choose_spec.symm
    let D : AdicCompletion I O → AdicCompletion I M := fun x =>
      ⟨fun k => Submodule.Quotient.mk (d (lift x (k + 1))), by
        intro m n hmn
        show (Submodule.Quotient.mk (d (lift x (n + 1))) : M ⧸ (I ^ m • (⊤ : Submodule O M))) =
          Submodule.Quotient.mk (d (lift x (m + 1)))
        exact hdiff m _ _ (hRep_cmp x (lift x) (hlift x) (m + 1) (n + 1) (by omega))⟩
    have hDval : ∀ x h, Rep x h → ∀ k, (D x).val k = Submodule.Quotient.mk (d (h (k + 1))) := by
      intro x h hx k
      show (Submodule.Quotient.mk (d (lift x (k + 1))) : M ⧸ (I ^ k • (⊤ : Submodule O M))) = _
      exact hdiff k _ _ (hRep_two x (lift x) h (hlift x) hx (k + 1))
    refine ⟨D, ?_, ?_, ?_⟩
    · intro a b
      have hab : Rep (a + b) (fun n => lift a n + lift b n) := by
        intro n
        rw [AdicCompletion.val_add, Pi.add_apply, hlift a n, hlift b n, map_add]
      apply AdicCompletion.ext
      intro k
      rw [hDval _ _ hab k, AdicCompletion.val_add, Pi.add_apply, hDval _ _ (hlift a) k,
        hDval _ _ (hlift b) k, hadd, Submodule.Quotient.mk_add]
    · intro a b
      have hab : Rep (a * b) (fun n => lift a n * lift b n) := by
        intro n
        rw [AdicCompletion.val_mul, hlift a n, hlift b n, map_mul]
      apply AdicCompletion.ext
      intro k
      rw [hDval _ _ hab k, AdicCompletion.val_add, Pi.add_apply, AdicCompletion.smul_eval,
        AdicCompletion.smul_eval, hDval _ _ (hlift a) k, hDval _ _ (hlift b) k, hlift a k, hlift b k]
      show (Submodule.Quotient.mk (d (lift a (k + 1) * lift b (k + 1))) :
          M ⧸ (I ^ k • (⊤ : Submodule O M))) =
        Submodule.Quotient.mk (lift a k • d (lift b (k + 1))) +
          Submodule.Quotient.mk (lift b k • d (lift a (k + 1)))
      rw [← Submodule.Quotient.mk_add, Submodule.Quotient.eq, hmul]
      have e : lift a (k + 1) • d (lift b (k + 1)) + lift b (k + 1) • d (lift a (k + 1)) -
          (lift a k • d (lift b (k + 1)) + lift b k • d (lift a (k + 1))) =
          (lift a (k + 1) - lift a k) • d (lift b (k + 1)) +
            (lift b (k + 1) - lift b k) • d (lift a (k + 1)) := by
        rw [sub_smul, sub_smul]; abel
      rw [e]
      exact add_mem (Submodule.smul_mem_smul (hRep_cmp a _ (hlift a) k (k + 1) (by omega)) trivial)
        (Submodule.smul_mem_smul (hRep_cmp b _ (hlift b) k (k + 1) (by omega)) trivial)
    · intro f
      have hf : Rep (algebraMap O (AdicCompletion I O) f) (fun _ => f) := by
        intro n
        rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
          AdicCompletion.of_apply]
        rfl
      apply AdicCompletion.ext
      intro k
      rw [hDval _ _ hf k, AdicCompletion.of_apply]
      rfl

  have s5 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (M : Type u)
      [AddCommGroup M] [Module A M] [Module.Finite A M] (D : A → M),
      (∀ a b, D (a + b) = D a + D b) → (∀ a b, D (a * b) = a • D b + b • D a) →
      (∀ (n : ℕ), ∀ a ∈ IsLocalRing.maximalIdeal A ^ (n + 1),
        D a ∈ IsLocalRing.maximalIdeal A ^ n • (⊤ : Submodule A M)) →
      ∀ (S : Set A) (x y : A), (∀ s ∈ S, D s = 0) →
      (∀ (t : A) (n : ℕ), ∃ p ∈ Subring.closure (insert x (insert y S)),
        t - p ∈ IsLocalRing.maximalIdeal A ^ n) →
      ∀ t : A, D t ∈ Submodule.span A {D x, D y} := by
    intro A _ _ _ M _ _ _ D hadd hmul hcont S x y hS hdense
    set N := Submodule.span A {D x, D y} with hN
    have h0 : D 0 = 0 := by
      calc D 0 = D 0 + D 0 - D 0 := by abel
        _ = D (0 + 0) - D 0 := by rw [hadd]
        _ = 0 := by rw [add_zero, sub_self]
    have h1 : D 1 = 0 := by
      calc D 1 = D 1 + D 1 - D 1 := by abel
        _ = D (1 * 1) - D 1 := by rw [hmul, one_smul]
        _ = 0 := by rw [mul_one, sub_self]
    have hneg : ∀ a, D (-a) = - D a := by
      intro a
      have : D (-a) + D a = 0 := by rw [← hadd, neg_add_cancel, h0]
      exact eq_neg_of_add_eq_zero_left this
    have hcl : ∀ p ∈ Subring.closure (insert x (insert y S)), D p ∈ N := by
      intro p hp
      induction hp using Subring.closure_induction with
      | mem z hz =>
        rcases hz with rfl | rfl | hz
        · exact Submodule.subset_span (by simp)
        · exact Submodule.subset_span (by simp)
        · rw [hS z hz]; exact N.zero_mem
      | zero => rw [h0]; exact N.zero_mem
      | one => rw [h1]; exact N.zero_mem
      | add a b _ _ ha hb => rw [hadd]; exact N.add_mem ha hb
      | neg a _ ha => rw [hneg]; exact N.neg_mem ha
      | mul a b _ _ ha hb => rw [hmul]; exact N.add_mem (N.smul_mem _ hb) (N.smul_mem _ ha)
    intro t
    have hq : ∀ n : ℕ, N.mkQ (D t) ∈
        (IsLocalRing.maximalIdeal A) ^ n • (⊤ : Submodule A (M ⧸ N)) := by
      intro n
      obtain ⟨p, hp, hpt⟩ := hdense t (n + 1)
      have e : D t = D p + D (t - p) := by rw [← hadd, add_sub_cancel]
      have hp0 : N.mkQ (D p) = 0 := (Submodule.Quotient.mk_eq_zero N).mpr (hcl p hp)
      rw [e, map_add, hp0, zero_add]
      have h2 := Submodule.mem_map_of_mem (f := N.mkQ) (hcont n (t - p) hpt)
      rw [Submodule.map_smul'', Submodule.map_top, Submodule.range_mkQ] at h2
      exact h2
    have hbot := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := M ⧸ N) (IsLocalRing.maximalIdeal A)
      (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    have hmem : N.mkQ (D t) ∈
        (⨅ i : ℕ, (IsLocalRing.maximalIdeal A) ^ i • (⊤ : Submodule A (M ⧸ N))) :=
      Submodule.mem_iInf _ |>.mpr hq
    rw [hbot, Submodule.mem_bot] at hmem
    exact (Submodule.Quotient.mk_eq_zero N).mp hmem

  have s7 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (c : R), c ∈ IsLocalRing.maximalIdeal R →
      ∀ (A : Type u) [CommRing A] [IsLocalRing A] (σ : R →+* A)
      (e : A ≃+* (MvPowerSeries (Fin 2) R ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c})),
      (∀ r : R, e (σ r) = Ideal.Quotient.mk _ (MvPowerSeries.C r)) →
      ∀ (t : A) (n : ℕ), ∃ p ∈ Subring.closure (insert (e.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 0)))
        (insert (e.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 1))) (Set.range σ))),
        t - p ∈ IsLocalRing.maximalIdeal A ^ n := by
    intro R _ _ c hc A _ _ σ e he
    classical
    let J : Ideal (MvPowerSeries (Fin 2) R) :=
      Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}
    let Γ := Subring.closure (insert (e.symm (Ideal.Quotient.mk J (MvPowerSeries.X 0)))
      (insert (e.symm (Ideal.Quotient.mk J (MvPowerSeries.X 1))) (Set.range σ)))
    have split : ∀ (n : ℕ) (H : MvPowerSeries (Fin 2) R), (∀ m : Fin 2 →₀ ℕ, m 0 ≤ n → m 1 ≤ n →
        MvPowerSeries.coeff m H = 0) → ∃ H₀ H₁ : MvPowerSeries (Fin 2) R,
        H = MvPowerSeries.X 0 ^ (n + 1) * H₀ + MvPowerSeries.X 1 ^ (n + 1) * H₁ := by
      intro n H hH
      let A' : MvPowerSeries (Fin 2) R := fun m => if n < m 0 then MvPowerSeries.coeff m H else 0
      have hA0 : MvPowerSeries.X 0 ^ (n + 1) ∣ A' := by
        rw [MvPowerSeries.X_pow_dvd_iff]
        intro m hm
        show (if n < m 0 then MvPowerSeries.coeff m H else 0) = 0
        rw [if_neg (by omega)]
      have hB1 : MvPowerSeries.X 1 ^ (n + 1) ∣ H - A' := by
        rw [MvPowerSeries.X_pow_dvd_iff]
        intro m hm
        rw [map_sub]
        show MvPowerSeries.coeff m H - (if n < m 0 then MvPowerSeries.coeff m H else 0) = 0
        by_cases h : n < m 0
        · rw [if_pos h, sub_self]
        · rw [if_neg h, hH m (by omega) (by omega), sub_zero]
      obtain ⟨H₀, hH₀⟩ := hA0
      obtain ⟨H₁, hH₁⟩ := hB1
      exact ⟨H₀, H₁, by rw [← hH₀, ← hH₁]; ring⟩
    have hnu : ∀ i : Fin 2, ¬ IsUnit (Ideal.Quotient.mk J (MvPowerSeries.X i)) := by
      intro i hu
      obtain ⟨g, hg⟩ := hu.exists_right_inv
      obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective g
      rw [← map_mul, ← map_one (Ideal.Quotient.mk J), Ideal.Quotient.eq] at hg
      obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.mp hg
      have h2 := congrArg MvPowerSeries.constantCoeff hh
      simp only [map_mul, map_sub, map_one, MvPowerSeries.constantCoeff_X,
        MvPowerSeries.constantCoeff_C, zero_mul, mul_zero, zero_sub] at h2
      apply (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal c).mp hc))
      exact IsUnit.of_mul_eq_one (MvPowerSeries.constantCoeff h)
        (by linear_combination (-1 : R) * h2)
    have hmax : ∀ i : Fin 2, e.symm (Ideal.Quotient.mk J (MvPowerSeries.X i)) ∈
        IsLocalRing.maximalIdeal A := by
      intro i
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      apply hnu i
      have := hu.map e
      rwa [RingEquiv.apply_symm_apply] at this
    let ρ : MvPolynomial (Fin 2) R →+* A := e.symm.toRingHom.comp
      ((Ideal.Quotient.mk J).comp MvPolynomial.coeToMvPowerSeries.ringHom)
    have hρ : ∀ P : MvPolynomial (Fin 2) R,
        ρ P = e.symm (Ideal.Quotient.mk J (P : MvPowerSeries (Fin 2) R)) := fun P => rfl
    have hρΓ : ∀ P : MvPolynomial (Fin 2) R, ρ P ∈ Γ := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C a =>
        rw [hρ, MvPolynomial.coe_C]
        have : e.symm (Ideal.Quotient.mk J (MvPowerSeries.C a)) = σ a := by
          rw [RingEquiv.symm_apply_eq]; exact (he a).symm
        rw [this]
        exact Subring.subset_closure (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨a, rfl⟩))
      | add p q hp hq => rw [map_add]; exact Γ.add_mem hp hq
      | mul_X p i hp =>
        rw [map_mul]
        refine Γ.mul_mem hp ?_
        rw [hρ, MvPolynomial.coe_X]
        fin_cases i
        · exact Subring.subset_closure (Set.mem_insert _ _)
        · exact Subring.subset_closure (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
    intro t n
    obtain ⟨G, hG⟩ := Ideal.Quotient.mk_surjective (e t)
    set Nn : Fin 2 →₀ ℕ := Finsupp.single 0 n + Finsupp.single 1 n with hNn
    set P := MvPowerSeries.trunc' R Nn G with hP
    have hH : ∀ m : Fin 2 →₀ ℕ, m 0 ≤ n → m 1 ≤ n →
        MvPowerSeries.coeff m (G - (P : MvPowerSeries (Fin 2) R)) = 0 := by
      intro m h0 h1
      have hle : m ≤ Nn := by
        rw [Finsupp.le_def]
        intro i
        fin_cases i <;> simp [hNn] <;> omega
      rw [map_sub, MvPolynomial.coeff_coe, hP, MvPowerSeries.coeff_trunc', if_pos hle, sub_self]
    obtain ⟨H₀, H₁, hsplit⟩ := split n _ hH
    refine ⟨ρ P, hρΓ P, ?_⟩
    have ht : t = e.symm (Ideal.Quotient.mk J G) := by rw [hG, RingEquiv.symm_apply_apply]
    have hdiff : t - ρ P = e.symm (Ideal.Quotient.mk J (MvPowerSeries.X 0)) ^ (n + 1) *
        e.symm (Ideal.Quotient.mk J H₀) + e.symm (Ideal.Quotient.mk J (MvPowerSeries.X 1)) ^ (n + 1) *
        e.symm (Ideal.Quotient.mk J H₁) := by
      rw [ht, hρ, ← map_sub, ← map_sub, hsplit]
      simp only [map_add, map_mul, map_pow]
    rw [hdiff]
    have hpow : ∀ i : Fin 2, e.symm (Ideal.Quotient.mk J (MvPowerSeries.X i)) ^ (n + 1) ∈
        IsLocalRing.maximalIdeal A ^ n :=
      fun i => Ideal.pow_le_pow_right (Nat.le_succ n) (Ideal.pow_mem_pow (hmax i) (n + 1))
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (hpow 0)) (Ideal.mul_mem_right _ _ (hpow 1))

  have s8 : ∀ (O B : Type u) [CommRing O] [CommRing B] [Algebra O B] (Ω N : Type u) [AddCommGroup Ω]
      [Module O Ω] [Module.Finite O Ω] [AddCommGroup N] [Module O N] [Module B N]
      [IsScalarTower O B N] (j : Ω →ₗ[O] N), IsBaseChange B j → ∀ (𝔮 : Ideal O) [𝔮.IsPrime]
      (Q : Ideal B) [Q.IsPrime], Q.comap (algebraMap O B) = 𝔮 → ∀ (S : Set Ω),
      Submodule.span O S = ⊤ → ∀ (w₁ w₂ : N) (s t : B), s ∉ Q → s • w₁ + t • w₂ = 0 →
      (∀ ω ∈ S, j ω ∈ Submodule.span B {w₁, w₂}) →
      FiniteDimensional 𝔮.ResidueField (TensorProduct O 𝔮.ResidueField Ω) ∧
        Module.finrank 𝔮.ResidueField (TensorProduct O 𝔮.ResidueField Ω) ≤ 1 := by
    intro O B _ _ _ Ω N _ _ _ _ _ _ _ j hj 𝔮 _ Q _ hQ S hS w₁ w₂ s t hs hrel hspan
    classical
    set K := 𝔮.ResidueField
    set L := Q.ResidueField
    letI : Algebra K L := (Ideal.ResidueField.map 𝔮 Q (algebraMap O B) hQ.symm).toAlgebra
    haveI : IsScalarTower O K L := by
      apply IsScalarTower.of_algebraMap_eq
      intro r
      show algebraMap O L r = Ideal.ResidueField.map 𝔮 Q (algebraMap O B) hQ.symm (algebraMap O K r)
      rw [Ideal.ResidueField.map_algebraMap, IsScalarTower.algebraMap_apply O B L]
    refine ⟨inferInstance, ?_⟩
    set W := TensorProduct O L Ω
    have e1 : Module.finrank K (TensorProduct O K Ω) = Module.finrank L W := by
      rw [← Module.finrank_baseChange (R := L) (S := K) (M' := TensorProduct O K Ω)]
      exact LinearEquiv.finrank_eq (TensorProduct.AlgebraTensorModule.cancelBaseChange O K L L Ω)
    rw [e1]
    let g : Ω →ₗ[O] W := TensorProduct.mk O L Ω 1
    let φ : N →ₗ[B] W := hj.lift g
    have hφ : ∀ ω, φ (j ω) = (1 : L) ⊗ₜ ω := fun ω => hj.lift_eq g ω
    set v := φ w₂
    have hBL : ∀ (b : B) (w : W), b • w = algebraMap B L b • w := fun b w =>
      (algebraMap_smul L b w).symm
    have hs' : algebraMap B L s ≠ 0 := by
      intro h
      exact hs (Ideal.algebraMap_residueField_eq_zero.mp h)
    have hw1 : φ w₁ = (-((algebraMap B L s)⁻¹ * algebraMap B L t)) • v := by
      have h1 := congrArg φ hrel
      rw [map_add, map_smul, map_smul, map_zero, hBL, hBL] at h1
      have h2 : algebraMap B L s • φ w₁ = -(algebraMap B L t • v) := eq_neg_of_add_eq_zero_left h1
      calc φ w₁ = (algebraMap B L s)⁻¹ • (algebraMap B L s • φ w₁) := by
            rw [smul_smul, inv_mul_cancel₀ hs', one_smul]
        _ = _ := by rw [h2, smul_neg, smul_smul]; exact (neg_smul _ _).symm
    set P : Submodule L W := Submodule.span L {v}
    have h1P : ∀ ω ∈ S, (1 : L) ⊗ₜ[O] ω ∈ P := by
      intro ω hω
      obtain ⟨a, b, hab⟩ := Submodule.mem_span_pair.mp (hspan ω hω)
      rw [← hφ, ← hab, map_add, map_smul, map_smul, hw1, hBL, hBL, smul_smul]
      exact P.add_mem (P.smul_mem _ (Submodule.mem_span_singleton_self v))
        (P.smul_mem _ (Submodule.mem_span_singleton_self v))
    have hall : ∀ ω : Ω, (1 : L) ⊗ₜ[O] ω ∈ P := by
      intro ω
      have hle : Submodule.span O S ≤ (P.restrictScalars O).comap g := by
        rw [Submodule.span_le]
        intro ω hω
        exact h1P ω hω
      rw [hS] at hle
      exact hle Submodule.mem_top
    have hW : ∀ w : W, w ∈ P := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => exact P.zero_mem
      | tmul l ω =>
        have : l ⊗ₜ[O] ω = l • ((1 : L) ⊗ₜ[O] ω) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [this]
        exact P.smul_mem l (hall ω)
      | add x y hx hy => exact P.add_mem hx hy
    apply finrank_le_one v
    intro w
    exact Submodule.mem_span_singleton.mp (hW w)

  intro R _ _ _ _ Z u hu z _ _ c e hc0 hc he 𝔮 hr
  letI : Algebra R (Z.presheaf.stalk z) :=
    ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).toAlgebra
  have hψ : ∀ r : R, algebraMap R (Z.presheaf.stalk z) r =
      (Z.presheaf.germ ⊤ z trivial).hom (wcCnSigma u ⊤ r) := fun r => rfl
  obtain ⟨hEFT, hNoeth⟩ := s1 R Z u hu z
  haveI : Algebra.EssFiniteType R (Z.presheaf.stalk z) := hEFT
  haveI : IsNoetherianRing (Z.presheaf.stalk z) := hNoeth
  haveI : Module.Finite (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄R] := KaehlerDifferential.finite R _
  obtain ⟨hloc, hlh⟩ := s2loc (Z.presheaf.stalk z)
  haveI := hloc
  haveI := hlh
  haveI : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))
    (Z.presheaf.stalk z)) := s2noeth (Z.presheaf.stalk z)
  haveI : Module.Flat (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal
    (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) := AdicCompletion.flat_of_isNoetherian _
  haveI : Module.FaithfullyFlat (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal
    (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hbc : IsBaseChange (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))
      (Z.presheaf.stalk z)) (AdicCompletion.of (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))
        Ω[Z.presheaf.stalk z⁄R]) := by
    refine IsBaseChange.of_equiv (AdicCompletion.ofTensorProductEquivOfFiniteNoetherian
      (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) Ω[Z.presheaf.stalk z⁄R]) ?_
    intro x
    show AdicCompletion.ofTensorProduct (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))
      Ω[Z.presheaf.stalk z⁄R] (1 ⊗ₜ x) = _
    rw [AdicCompletion.ofTensorProduct_tmul, one_smul]
  haveI : Module.Finite (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))
      (Z.presheaf.stalk z)) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))
        Ω[Z.presheaf.stalk z⁄R]) :=
    Module.Finite.equiv (AdicCompletion.ofTensorProductEquivOfFiniteNoetherian
      (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) Ω[Z.presheaf.stalk z⁄R])
  have hdadd : ∀ a b : Z.presheaf.stalk z, KaehlerDifferential.D R (Z.presheaf.stalk z) (a + b) =
      KaehlerDifferential.D R (Z.presheaf.stalk z) a +
        KaehlerDifferential.D R (Z.presheaf.stalk z) b := fun a b => map_add _ a b
  have hdmul : ∀ a b : Z.presheaf.stalk z, KaehlerDifferential.D R (Z.presheaf.stalk z) (a * b) =
      a • KaehlerDifferential.D R (Z.presheaf.stalk z) b +
        b • KaehlerDifferential.D R (Z.presheaf.stalk z) a := fun a b => Derivation.leibniz _ a b
  obtain ⟨D, hDadd, hDmul, hDof⟩ := s4 (Z.presheaf.stalk z)
    (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) Ω[Z.presheaf.stalk z⁄R]
    (KaehlerDifferential.D R (Z.presheaf.stalk z)) hdadd hdmul
    (s3 _ _ _ _ hdadd hdmul)
  set σ : R →+* AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z) :=
    (algebraMap (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))
      (Z.presheaf.stalk z))).comp ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)) with hσ
  have heσ : ∀ r : R, e (σ r) = Ideal.Quotient.mk _ (MvPowerSeries.C r) := fun r =>
    RingHom.congr_fun he r
  have hDσ : ∀ s ∈ Set.range σ, D s = 0 := by
    rintro _ ⟨r, rfl⟩
    show D (algebraMap (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal
      (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) (algebraMap R (Z.presheaf.stalk z) r)) = 0
    rw [hDof, Derivation.map_algebraMap, map_zero]
  have hspan := s5 _ _ D hDadd hDmul (s3 _ _ _ D hDadd hDmul) (Set.range σ) _ _ hDσ
    (s7 R c hc _ σ e heσ)
  set x' := e.symm (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 -
    MvPowerSeries.C c}) (MvPowerSeries.X 0)) with hx'
  set y' := e.symm (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 -
    MvPowerSeries.C c}) (MvPowerSeries.X 1)) with hy'
  have hxy : x' * y' = σ c := by
    apply e.injective
    rw [map_mul, hx', hy', RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply, heσ, ← map_mul,
      Ideal.Quotient.eq]
    exact Ideal.mem_span_singleton_self _
  have hrel : y' • D x' + x' • D y' = 0 := by
    have h1 := hDmul x' y'
    rw [hxy, hDσ _ ⟨c, rfl⟩] at h1
    rw [add_comm]
    exact h1.symm
  obtain ⟨Q, hQ⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat
    (A := Z.presheaf.stalk z) (B := AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))
      (Z.presheaf.stalk z)) 𝔮
  have hQ' : Q.asIdeal.comap (algebraMap (Z.presheaf.stalk z) (AdicCompletion
      (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))) = 𝔮.asIdeal :=
    congrArg PrimeSpectrum.asIdeal hQ
  obtain ⟨r, hrm, hrq⟩ := hr
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hϖq : algebraMap R (Z.presheaf.stalk z) ϖ ∉ 𝔮.asIdeal := by
    intro h
    rw [hϖ.maximalIdeal_eq, Ideal.mem_span_singleton'] at hrm
    obtain ⟨a, rfl⟩ := hrm
    apply hrq
    rw [← hψ, map_mul]
    exact Ideal.mul_mem_left _ _ h
  have hcq : algebraMap R (Z.presheaf.stalk z) c ∉ 𝔮.asIdeal := by
    obtain ⟨n, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc0 hϖ
    rw [hv, map_mul, map_pow]
    intro h
    rcases 𝔮.isPrime.mem_or_mem h with h1 | h1
    · exact 𝔮.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 (v.isUnit.map _))
    · exact hϖq (𝔮.isPrime.mem_of_pow_mem n h1)
  have hσc : σ c ∉ Q.asIdeal := by
    intro h
    apply hcq
    rw [← hQ']
    exact h
  have hy : y' ∉ Q.asIdeal := by
    intro h
    apply hσc
    rw [← hxy]
    exact Ideal.mul_mem_left _ _ h
  exact s8 _ _ _ _ _ hbc 𝔮.asIdeal Q.asIdeal hQ' (Set.range (KaehlerDifferential.D R
    (Z.presheaf.stalk z))) (KaehlerDifferential.span_range_derivation R _) (D x') (D y') y' x' hy hrel
    (by rintro _ ⟨f, rfl⟩; rw [← hDof]; exact hspan _)

theorem wcpa_dj_lqu_sigma_pnt : ∀ (C P' : Scheme.{u}) (g : C ⟶ P'), wcpaDjSemistable g → IsLocallyNoetherian P' → ∀ (U : P'.Opens) (_ : IsAffineOpen U) (V₀ : C.Opens) (hV₀ : IsAffineOpen V₀) (e : V₀ ≤ g ⁻¹ᵁ U) (m r : ℕ) (p : MvPolynomial (Fin m) Γ(P', U) →+* Γ(C, V₀)) (F : Fin r → MvPolynomial (Fin m) Γ(P', U)), p.comp MvPolynomial.C = (g.appLE U V₀ e).hom → Function.Surjective p → RingHom.ker p = Ideal.span (Set.range F) → ∀ (L : Type u) [Field L] [IsAlgClosed L] (χ : Γ(C, V₀) →+* L), (¬ ∃ W : C.Opens, hV₀.fromSpec ⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩ ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) → wcpaLquPNT (fun j => MvPolynomial.map (χ.comp (g.appLE U V₀ e).hom) (F j)) (fun l => χ (p (MvPolynomial.X l))) :=
by
  intro C P' g hss hPn U hU V₀ hV₀ e m r p F hpC hpsurj hF L _ _ χ hns
  classical
  haveI : IsLocallyNoetherian P' := hPn
  haveI hgprop : IsProper g := hss.2.1
  haveI hgflat : Flat g := hss.1
  letI alg1 : Algebra Γ(P', U) Γ(C, V₀) := (g.appLE U V₀ e).hom.toAlgebra
  letI alg2 : Algebra Γ(P', U) L := (χ.comp (g.appLE U V₀ e).hom).toAlgebra

  obtain ⟨ι, hιo, hιa, hιf⟩ :=
    wcpa_dj_lqu_sp_fibre_chart C P' g U hU V₀ hV₀ e L (χ.comp (g.appLE U V₀ e).hom)

  obtain ⟨P0, μ, hP0C, hP0s, hP0k, hμP0, hμ1⟩ :=
    wcpa_dj_lqu_sp_pres_basechange Γ(P', U) Γ(C, V₀) m r p F hpC hpsurj hF L χ rfl

  let xT : Spec (.of (TensorProduct Γ(P', U) L Γ(C, V₀))) := ⟨RingHom.ker μ, RingHom.ker_isPrime μ⟩
  have hμχ : μ.comp (Algebra.TensorProduct.includeRight :
      Γ(C, V₀) →ₐ[Γ(P', U)] TensorProduct Γ(P', U) L Γ(C, V₀)).toRingHom = χ :=
    RingHom.ext (fun b => hμ1 b)
  have hx : Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (χ.comp (g.appLE U V₀ e).hom)) ≫
      hU.fromSpec) (ι xT) = hV₀.fromSpec ⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩ := by
    rw [← Scheme.Hom.comp_apply, hιf, Scheme.Hom.comp_apply]
    congr 1
    apply PrimeSpectrum.ext
    ext b
    change μ ((1 : L) ⊗ₜ[Γ(P', U)] b) = 0 ↔ χ b = 0
    rw [hμ1 b]

  have hns' : ¬ ∃ W : (Limits.pullback g (Spec.map (CommRingCat.ofHom
      (χ.comp (g.appLE U V₀ e).hom)) ≫ hU.fromSpec)).Opens, ι xT ∈ W ∧
      SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom
        (χ.comp (g.appLE U V₀ e).hom)) ≫ hU.fromSpec)) := by
    intro hW
    obtain ⟨W', hW'1, hW'2⟩ := wcpa_dj_bsc_smooth_descend P' C g L _ (ι xT) hgflat inferInstance hW
    exact hns ⟨W', hx ▸ hW'1, hW'2⟩

  obtain ⟨eC, heC⟩ := (hss.2.2 L _ (ι xT)).resolve_left hns'
  haveI : IsLocallyNoetherian (Limits.pullback g (Spec.map (CommRingCat.ofHom
      (χ.comp (g.appLE U V₀ e).hom)) ≫ hU.fromSpec)) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g _)
  obtain ⟨hd, hs⟩ := wcpa_dj_lqr_completion_bridge L _ eC
  obtain ⟨u, v, ⟨hu, hv, hspan, hind⟩, huv⟩ :=
    wcpa_dj_lqu_sp_node_basis L _ _ (eC.toRingHom.comp (algebraMap _ _))
      (by rw [RingHom.comp_assoc]; exact heC) hd hs

  obtain ⟨σ, hσφ, hunit, hfrac, hker⟩ :=
    wcpa_dj_lqu_sp_stalk_loc L (TensorProduct Γ(P', U) L Γ(C, V₀)) _ _ ι hιo hιa xT
  have hρφ : ∀ a : L, (σ.comp P0) (MvPolynomial.C a) =
      ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd g _).appTop ≫
        (Limits.pullback g _).presheaf.germ ⊤ (ι xT) trivial).hom a := by
    intro a
    rw [← hσφ, RingHom.comp_apply, ← RingHom.comp_apply P0, hP0C]
    rfl
  have hP0F : ∀ j, P0 (MvPolynomial.map (χ.comp (g.appLE U V₀ e).hom) (F j)) = 0 := by
    intro j
    have hmem : MvPolynomial.map (χ.comp (g.appLE U V₀ e).hom) (F j) ∈ RingHom.ker P0 := by
      rw [hP0k]
      exact Ideal.subset_span ⟨j, rfl⟩
    exact hmem
  have hev : ∀ h, MvPolynomial.eval (fun l => χ (p (MvPolynomial.X l))) h = μ (P0 h) := by
    intro h
    rw [← hμP0]
    rfl

  obtain ⟨hdens, hstrict⟩ := wcpa_dj_lqu_sp_trunc_transfer L m r
    (fun j => MvPolynomial.map (χ.comp (g.appLE U V₀ e).hom) (F j))
    (fun l => χ (p (MvPolynomial.X l)))
    (fun j => by rw [hev, hP0F j, map_zero])
    _ (σ.comp P0)
    (fun h hh => hunit (P0 h) (fun hmem => hh (by rw [hev]; exact RingHom.mem_ker.mp hmem)))
    (fun j => by rw [RingHom.comp_apply, hP0F j, map_zero])
    (by
      intro y
      obtain ⟨t, s', hs', hy⟩ := hfrac y
      obtain ⟨h, rfl⟩ := hP0s t
      obtain ⟨s0, rfl⟩ := hP0s s'
      refine ⟨h, s0, fun h0 => hs' (RingHom.mem_ker.mpr (by rw [← hev]; exact h0)), hy⟩)
    (by
      intro h hρh
      obtain ⟨s', hs', hs'0⟩ := hker (P0 h) hρh
      obtain ⟨s0, rfl⟩ := hP0s s'
      refine ⟨s0, fun h0 => hs' (RingHom.mem_ker.mpr (by rw [← hev]; exact h0)), ?_⟩
      have hmem : s0 * h ∈ RingHom.ker P0 := RingHom.mem_ker.mpr (by rw [map_mul]; exact hs'0)
      rw [hP0k] at hmem
      exact hmem)

  exact wcpa_dj_lqu_sp_pnt_of_nt L m r
    (fun j => MvPolynomial.map (χ.comp (g.appLE U V₀ e).hom) (F j))
    (fun l => χ (p (MvPolynomial.X l))) _ (σ.comp P0) hdens (fun n h => hstrict n h) u v hu hv
    (fun y hy => by
      obtain ⟨c₁, c₂, h⟩ := hspan y hy
      exact ⟨c₁, c₂, by rw [hρφ, hρφ]; exact h⟩)
    (fun c₁ c₂ h => hind c₁ c₂ (by rw [hρφ, hρφ] at h; exact h)) huv

theorem wcpa_dj_nccw_ebn_smooth_of_omega : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), wcpaDjSemistable u → ∀ (z : Z) (𝔮 : PrimeSpectrum (Z.presheaf.stalk z)), (letI := ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).toAlgebra; FiniteDimensional 𝔮.asIdeal.ResidueField (TensorProduct (Z.presheaf.stalk z) 𝔮.asIdeal.ResidueField (Ω[Z.presheaf.stalk z⁄R])) ∧ Module.finrank 𝔮.asIdeal.ResidueField (TensorProduct (Z.presheaf.stalk z) 𝔮.asIdeal.ResidueField (Ω[Z.presheaf.stalk z⁄R])) ≤ 1) → nccwSm u (Z.fromSpecStalk z 𝔮) :=
by
  intro R _ _ _ Z u hsemi z 𝔮 hΩ
  classical

  have s7 : ∀ (A L : Type u) [CommRing A] [CommRing L] (m : ℕ) (ψ : A →+* L) (c v : Fin m → L)
      (G : MvPolynomial (Fin m) A),
      TrivSqZeroExt.fst (MvPolynomial.eval₂ ((TrivSqZeroExt.inlHom L L).comp ψ)
        (fun i => (TrivSqZeroExt.inl (c i) + TrivSqZeroExt.inr (v i) : DualNumber L)) G) =
          MvPolynomial.eval₂ ψ c G ∧
      TrivSqZeroExt.snd (MvPolynomial.eval₂ ((TrivSqZeroExt.inlHom L L).comp ψ)
        (fun i => (TrivSqZeroExt.inl (c i) + TrivSqZeroExt.inr (v i) : DualNumber L)) G) =
          ∑ i, v i * MvPolynomial.eval₂ ψ c (MvPolynomial.pderiv i G) := by
    intro A L _ _ m ψ c v G
    induction G using MvPolynomial.induction_on with
    | C a => simp [MvPolynomial.eval₂_C]
    | add p q hp hq =>
      refine ⟨?_, ?_⟩
      · rw [MvPolynomial.eval₂_add, TrivSqZeroExt.fst_add, hp.1, hq.1, MvPolynomial.eval₂_add]
      · rw [MvPolynomial.eval₂_add, TrivSqZeroExt.snd_add, hp.2, hq.2, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_add, MvPolynomial.eval₂_add, mul_add]
    | mul_X p n hp =>
      refine ⟨?_, ?_⟩
      · rw [MvPolynomial.eval₂_mul, TrivSqZeroExt.fst_mul, hp.1, MvPolynomial.eval₂_X,
          MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X]
        simp
      · rw [MvPolynomial.eval₂_mul, DualNumber.snd_mul, hp.1, hp.2, MvPolynomial.eval₂_X]
        simp only [TrivSqZeroExt.fst_add, TrivSqZeroExt.snd_add, TrivSqZeroExt.fst_inl,
          TrivSqZeroExt.snd_inl, TrivSqZeroExt.fst_inr, TrivSqZeroExt.snd_inr, add_zero, zero_add]
        have e : ∀ i, MvPolynomial.eval₂ ψ c (MvPolynomial.pderiv i (p * MvPolynomial.X n)) =
            MvPolynomial.eval₂ ψ c p * (if n = i then 1 else 0) +
              c n * MvPolynomial.eval₂ ψ c (MvPolynomial.pderiv i p) := by
          intro i
          rw [Derivation.leibniz, MvPolynomial.pderiv_X, smul_eq_mul, smul_eq_mul,
            MvPolynomial.eval₂_add, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_mul,
            MvPolynomial.eval₂_X]
          by_cases h : n = i
          · subst h; simp
          · simp [h]
        simp only [e, mul_add, Finset.sum_add_distrib, mul_ite, mul_one, mul_zero,
          Finset.sum_ite_eq, Finset.mem_univ, ite_true]
        rw [Finset.sum_mul]
        have h2 : ∑ i, v i * (c n * MvPolynomial.eval₂ ψ c (MvPolynomial.pderiv i p)) =
            ∑ i, v i * MvPolynomial.eval₂ ψ c (MvPolynomial.pderiv i p) * c n :=
          Finset.sum_congr rfl fun i _ => by ring
        rw [h2]
        ring

  have s8 : ∀ (A B O L : Type u) [CommRing A] [CommRing B] [CommRing O] [Field L] [Algebra B O]
      (M : Submonoid B) [IsLocalization M O] (m r : ℕ) (p : MvPolynomial (Fin m) A →+* B)
      (F : Fin r → MvPolynomial (Fin m) A) (Θ : MvPolynomial (Fin m) A →+* DualNumber L)
      (χO : O →+* L), Function.Surjective p → RingHom.ker p = Ideal.span (Set.range F) →
      (∀ j, Θ (F j) = 0) → (∀ G, TrivSqZeroExt.fst (Θ G) = χO (algebraMap B O (p G))) →
      ∃ D : O → L, (∀ x y, D (x + y) = D x + D y) ∧
        (∀ x y, D (x * y) = χO x * D y + χO y * D x) ∧
        ∀ G, D (algebraMap B O (p G)) = TrivSqZeroExt.snd (Θ G) := by
    intro A B O L _ _ _ _ _ M _ m r p F Θ χO hp hker hΘ hfst
    have hle : RingHom.ker p ≤ RingHom.ker Θ := by
      rw [hker, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact hΘ j
    let ΘB : B →+* DualNumber L := p.liftOfSurjective hp ⟨Θ, hle⟩
    have hΘB : ∀ G, ΘB (p G) = Θ G := fun G => p.liftOfSurjective_comp_apply hp ⟨Θ, hle⟩ G
    have hfstB : ∀ y, TrivSqZeroExt.fst (ΘB y) = χO (algebraMap B O y) := by
      intro y
      obtain ⟨G, rfl⟩ := hp y
      rw [hΘB, hfst]
    have hunit : ∀ y : M, IsUnit (ΘB y) := by
      intro y
      rw [TrivSqZeroExt.isUnit_iff_isUnit_fst, hfstB]
      exact (IsLocalization.map_units O y).map χO
    let ΘO : O →+* DualNumber L := IsLocalization.lift hunit
    have hΘO : ∀ y, ΘO (algebraMap B O y) = ΘB y := IsLocalization.lift_eq hunit
    have hfstO' : (TrivSqZeroExt.fstHom L L L).toRingHom.comp ΘO = χO := by
      apply IsLocalization.ringHom_ext M
      ext y
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        TrivSqZeroExt.fstHom_apply, hΘO, hfstB]
    have hfstO : ∀ x, TrivSqZeroExt.fst (ΘO x) = χO x := fun x => RingHom.congr_fun hfstO' x
    refine ⟨fun x => TrivSqZeroExt.snd (ΘO x), ?_, ?_, ?_⟩
    · intro x y
      simp only [map_add, TrivSqZeroExt.snd_add]
    · intro x y
      simp only [map_mul, DualNumber.snd_mul, hfstO]
      ring
    · intro G
      simp only [hΘO, hΘB]

  have s9 : ∀ (A O K : Type u) [CommRing A] [CommRing O] [Field K] [Algebra A O] (f : O →+* K)
      (P : Ideal O) [P.IsPrime], RingHom.ker f = P → ∀ (D : Fin 2 → O → K) (r : Fin 2 → O),
      (∀ j a, D j (algebraMap A O a) = 0) → (∀ j x y, D j (x + y) = D j x + D j y) →
      (∀ j x y, D j (x * y) = f x * D j y + f y * D j x) →
      D 0 (r 0) * D 1 (r 1) - D 1 (r 0) * D 0 (r 1) ≠ 0 →
      FiniteDimensional P.ResidueField (TensorProduct O P.ResidueField (Ω[O⁄A])) →
      2 ≤ Module.finrank P.ResidueField (TensorProduct O P.ResidueField (Ω[O⁄A])) := by
    intro A O K _ _ _ _ f P _ hker D r hA hadd hmul hdet hfd
    letI : Algebra O K := f.toAlgebra
    letI : Algebra A K := (f.comp (algebraMap A O)).toAlgebra
    haveI : IsScalarTower A O K := IsScalarTower.of_algebraMap_eq (fun a => rfl)
    have hunit : P.primeCompl ≤ Submonoid.comap f (IsUnit.submonoid K) := by
      intro s hs
      simp only [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
      apply IsUnit.mk0
      intro h0
      apply hs
      rw [← hker]
      exact h0
    let fbar := Ideal.ResidueField.lift P f (le_of_eq hker.symm) hunit
    letI : Algebra P.ResidueField K := fbar.toAlgebra
    haveI : IsScalarTower O P.ResidueField K := IsScalarTower.of_algebraMap_eq
      (fun x => (Ideal.ResidueField.lift_algebraMap P f (le_of_eq hker.symm) hunit x).symm)
    let Dd : Fin 2 → Derivation A O K := fun j => Derivation.mk'
      { toFun := D j
        map_add' := hadd j
        map_smul' := fun a x => by
          rw [Algebra.smul_def, hmul, hA, mul_zero, add_zero, RingHom.id_apply, Algebra.smul_def]
          rfl }
      (fun x y => by
        show D j (x * y) = x • D j y + y • D j x
        rw [hmul, Algebra.smul_def, Algebra.smul_def]
        rfl)
    let ℓ : Fin 2 → (TensorProduct O P.ResidueField (Ω[O⁄A])) →ₗ[P.ResidueField] K :=
      fun j => LinearMap.liftBaseChange P.ResidueField (Dd j).liftKaehlerDifferential
    have hℓ : ∀ j x, ℓ j (1 ⊗ₜ KaehlerDifferential.D A O x) = D j x := by
      intro j x
      simp only [ℓ, LinearMap.liftBaseChange_tmul, one_smul,
        Derivation.liftKaehlerDifferential_comp_D]
      rfl
    let w : Fin 2 → TensorProduct O P.ResidueField (Ω[O⁄A]) :=
      fun i => 1 ⊗ₜ KaehlerDifferential.D A O (r i)
    have hli : LinearIndependent P.ResidueField ![w 0, w 1] := by
      rw [LinearIndependent.pair_iff]
      intro s t hst
      have e0 := congrArg (ℓ 0) hst
      have e1 := congrArg (ℓ 1) hst
      simp only [map_add, map_smul, map_zero, w, hℓ, Algebra.smul_def] at e0 e1
      have e0' : fbar s * D 0 (r 0) + fbar t * D 0 (r 1) = 0 := e0
      have e1' : fbar s * D 1 (r 0) + fbar t * D 1 (r 1) = 0 := e1
      have hs : fbar s * (D 0 (r 0) * D 1 (r 1) - D 1 (r 0) * D 0 (r 1)) = 0 := by
        linear_combination (D 1 (r 1)) * e0' - (D 0 (r 1)) * e1'
      have ht : fbar t * (D 0 (r 0) * D 1 (r 1) - D 1 (r 0) * D 0 (r 1)) = 0 := by
        linear_combination (D 0 (r 0)) * e1' - (D 1 (r 0)) * e0'
      have hs0 : fbar s = 0 := (mul_eq_zero.mp hs).resolve_right hdet
      have ht0 : fbar t = 0 := (mul_eq_zero.mp ht).resolve_right hdet
      exact ⟨fbar.injective (hs0.trans (map_zero fbar).symm),
        fbar.injective (ht0.trans (map_zero fbar).symm)⟩
    have := hli.fintype_card_le_finrank
    simpa using this

  have s6 : ∀ (K : Type u) [Field K] (m r : ℕ) (J : Matrix (Fin r) (Fin m) K) (α β : Fin m → K),
      (∀ (a b : K) (μ : Fin r → K), a • α + b • β = Matrix.vecMul μ J → a = 0 ∧ b = 0) →
      ∃ (v : Fin 2 → Fin m → K) (l : Fin 2 → Fin m), (∀ k j, ∑ i, J j i * v k i = 0) ∧
        v 0 (l 0) * v 1 (l 1) - v 1 (l 0) * v 0 (l 1) ≠ 0 := by
    intro K _ m r J α β h
    let T : (Fin m → K) →ₗ[K] (Fin r → K) := Matrix.mulVecLin J
    have hT : ∀ x, x ∈ LinearMap.ker T ↔ Matrix.mulVec J x = 0 := fun x => by
      rw [LinearMap.mem_ker, Matrix.mulVecLin_apply]
    let Ψ : LinearMap.ker T →ₗ[K] (Fin 2 → K) :=
      { toFun := fun x => ![α ⬝ᵥ (x : Fin m → K), β ⬝ᵥ (x : Fin m → K)]
        map_add' := fun x y => by
          ext k; fin_cases k <;> simp [dotProduct_add]
        map_smul' := fun c x => by
          ext k; fin_cases k <;> simp [dotProduct_smul] }
    have hΨ0 : ∀ x : LinearMap.ker T, Ψ x 0 = α ⬝ᵥ (x : Fin m → K) := fun x => rfl
    have hΨ1 : ∀ x : LinearMap.ker T, Ψ x 1 = β ⬝ᵥ (x : Fin m → K) := fun x => rfl
    have hsurj : LinearMap.range Ψ = ⊤ := by
      by_contra hne
      obtain ⟨φ, hφ0, hφ⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.mpr hne)
      set a := φ (fun j => if (0 : Fin 2) = j then 1 else 0) with ha
      set b := φ (fun j => if (1 : Fin 2) = j then 1 else 0) with hb
      have hφx : ∀ x : Fin 2 → K, φ x = x 0 * a + x 1 * b := by
        intro x
        rw [LinearMap.pi_apply_eq_sum_univ φ x, Fin.sum_univ_two]
        simp only [smul_eq_mul, ha, hb]
      set w := a • α + b • β with hw
      have hwN : ∀ x ∈ LinearMap.ker T, w ⬝ᵥ x = 0 := by
        intro x hx
        have h1 : Ψ ⟨x, hx⟩ ∈ LinearMap.ker φ := hφ ⟨⟨x, hx⟩, rfl⟩
        rw [LinearMap.mem_ker, hφx, hΨ0, hΨ1] at h1
        rw [hw, add_dotProduct, smul_dotProduct, smul_dotProduct, smul_eq_mul, smul_eq_mul]
        simp only at h1
        linear_combination h1
      let g : Module.Dual K (Fin m → K) :=
        { toFun := fun x => w ⬝ᵥ x
          map_add' := fun x y => dotProduct_add w x y
          map_smul' := fun c x => by simp [dotProduct_smul] }
      have hg : g ∈ (LinearMap.ker T).dualAnnihilator := by
        rw [Submodule.mem_dualAnnihilator]
        intro x hx
        exact hwN x hx
      rw [← LinearMap.range_dualMap_eq_dualAnnihilator_ker] at hg
      obtain ⟨ψ, hψ⟩ := hg
      set μ : Fin r → K := fun j => ψ (fun j' => if j = j' then 1 else 0) with hμ
      have hwx : ∀ x, w ⬝ᵥ x = (Matrix.vecMul μ J) ⬝ᵥ x := by
        intro x
        have h1 : g x = ψ (T x) := by rw [← hψ]; rfl
        have h2 : g x = w ⬝ᵥ x := rfl
        rw [← h2, h1, ← Matrix.dotProduct_mulVec, LinearMap.pi_apply_eq_sum_univ ψ (T x)]
        simp only [dotProduct, smul_eq_mul, hμ, T, Matrix.mulVecLin_apply]
        refine Finset.sum_congr rfl fun j _ => ?_
        ring
      have hwμ : w = Matrix.vecMul μ J := by
        funext i
        have := hwx (Pi.single i 1)
        simpa [dotProduct_single] using this
      obtain ⟨ha0, hb0⟩ := h a b μ hwμ
      apply hφ0
      apply LinearMap.ext
      intro x
      rw [hφx, ha0, hb0]
      simp
    have h10 : (![1, 0] : Fin 2 → K) ∈ LinearMap.range Ψ := by rw [hsurj]; trivial
    have h01 : (![0, 1] : Fin 2 → K) ∈ LinearMap.range Ψ := by rw [hsurj]; trivial
    obtain ⟨x0, hx0⟩ := h10
    obtain ⟨x1, hx1⟩ := h01
    have a0 : α ⬝ᵥ (x0 : Fin m → K) = 1 := by rw [← hΨ0, hx0]; rfl
    have b0 : β ⬝ᵥ (x0 : Fin m → K) = 0 := by rw [← hΨ1, hx0]; rfl
    have a1 : α ⬝ᵥ (x1 : Fin m → K) = 0 := by rw [← hΨ0, hx1]; rfl
    have b1 : β ⬝ᵥ (x1 : Fin m → K) = 1 := by rw [← hΨ1, hx1]; rfl
    have hker0 : Matrix.mulVec J (x0 : Fin m → K) = 0 := (hT _).mp x0.2
    have hker1 : Matrix.mulVec J (x1 : Fin m → K) = 0 := (hT _).mp x1.2
    set v0 : Fin m → K := (x0 : Fin m → K) with hv0
    set v1 : Fin m → K := (x1 : Fin m → K) with hv1
    have hCB : (∑ i, ∑ k, α i * β k * (v0 i * v1 k - v1 i * v0 k)) = 1 := by
      have e : (∑ i, ∑ k, α i * β k * (v0 i * v1 k - v1 i * v0 k)) =
          (α ⬝ᵥ v0) * (β ⬝ᵥ v1) - (α ⬝ᵥ v1) * (β ⬝ᵥ v0) := by
        simp only [dotProduct, Finset.sum_mul_sum, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun k _ => ?_
        ring
      rw [e, a0, b0, a1, b1]
      ring
    have hne : (∑ i, ∑ k, α i * β k * (v0 i * v1 k - v1 i * v0 k)) ≠ 0 := by
      rw [hCB]; exact one_ne_zero
    obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
    obtain ⟨k, -, hk⟩ := Finset.exists_ne_zero_of_sum_ne_zero hi
    refine ⟨![v0, v1], ![i, k], ?_, ?_⟩
    · intro k' j
      fin_cases k'
      · have := congrFun hker0 j
        simpa [Matrix.mulVec, dotProduct] using this
      · have := congrFun hker1 j
        simpa [Matrix.mulVec, dotProduct] using this
    · simp only [Matrix.cons_val_zero, Matrix.cons_val_one]
      intro h0
      apply hk
      rw [h0, mul_zero]

  letI alg : Algebra R (Z.presheaf.stalk z) :=
    ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).toAlgebra
  obtain ⟨hfd, hle⟩ := hΩ
  by_contra hns
  haveI : IsProper u := hsemi.2.1

  obtain ⟨V₀, hV₀, hz, -⟩ := exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
  have e : V₀ ≤ u ⁻¹ᵁ ⊤ := by
    first
      | exact fun x _ => trivial
      | (rw [Scheme.Hom.preimage_top]; exact le_top)
  have hft := HasRingHomProperty.appLE (@LocallyOfFiniteType) u inferInstance
    ⟨⊤, isAffineOpen_top _⟩ ⟨V₀, hV₀⟩ e
  letI algAB : Algebra Γ(Spec (.of R), ⊤) Γ(Z, V₀) := (u.appLE ⊤ V₀ e).hom.toAlgebra
  have hft' : Algebra.FiniteType Γ(Spec (.of R), ⊤) Γ(Z, V₀) := hft
  obtain ⟨m, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft'
  let p : MvPolynomial (Fin m) Γ(Spec (.of R), ⊤) →+* Γ(Z, V₀) := f.toRingHom
  have hps : Function.Surjective p := hf
  have hpC : p.comp MvPolynomial.C = (u.appLE ⊤ V₀ e).hom := by
    refine RingHom.ext fun a => ?_
    show f (MvPolynomial.C a) = _
    rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
    rfl
  haveI : IsNoetherianRing Γ(Spec (.of R), ⊤) :=
    isNoetherianRing_of_ringEquiv R (Scheme.ΓSpecIso (.of R)).symm.commRingCatIsoToRingEquiv
  have hfg : (RingHom.ker p).FG := IsNoetherian.noetherian _
  obtain ⟨r, F, hF⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hker : RingHom.ker p = Ideal.span (Set.range F) := hF.symm
  have memF : ∀ j, p (F j) = 0 := fun j => by
    have : F j ∈ RingHom.ker p := by rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩
    exact RingHom.mem_ker.mp this

  let χO : Z.presheaf.stalk z →+* AlgebraicClosure 𝔮.asIdeal.ResidueField :=
    (algebraMap 𝔮.asIdeal.ResidueField (AlgebraicClosure 𝔮.asIdeal.ResidueField)).comp
      (algebraMap (Z.presheaf.stalk z) 𝔮.asIdeal.ResidueField)
  let χB : Γ(Z, V₀) →+* AlgebraicClosure 𝔮.asIdeal.ResidueField :=
    χO.comp (Z.presheaf.germ V₀ z hz).hom
  have hkerO : RingHom.ker χO = 𝔮.asIdeal := by
    show RingHom.ker ((algebraMap 𝔮.asIdeal.ResidueField
      (AlgebraicClosure 𝔮.asIdeal.ResidueField)).comp _) = _
    rw [RingHom.ker_comp_of_injective _
      (algebraMap 𝔮.asIdeal.ResidueField (AlgebraicClosure 𝔮.asIdeal.ResidueField)).injective,
      Ideal.ker_algebraMap_residueField]
  have hkerB : RingHom.ker χB = 𝔮.asIdeal.comap (Z.presheaf.germ V₀ z hz).hom := by
    show RingHom.ker (χO.comp _) = _
    rw [← RingHom.comap_ker, hkerO]
  have hpt : hV₀.fromSpec ⟨RingHom.ker χB, RingHom.ker_isPrime χB⟩ = Z.fromSpecStalk z 𝔮 := by
    have h1 : Z.fromSpecStalk z 𝔮 = hV₀.fromSpec (Spec.map (Z.presheaf.germ V₀ z hz) 𝔮) := by
      rw [← hV₀.fromSpecStalk_eq_fromSpecStalk hz]
      first
        | rfl
        | (rw [IsAffineOpen.fromSpecStalk, Scheme.Hom.comp_apply])
    rw [h1]
    have h2 : (Spec.map (Z.presheaf.germ V₀ z hz)) 𝔮 =
        (⟨RingHom.ker χB, RingHom.ker_isPrime χB⟩ : PrimeSpectrum Γ(Z, V₀)) := by
      refine (Spec.map_apply _ _).trans ?_
      exact PrimeSpectrum.ext hkerB.symm
    exact congrArg (fun x => hV₀.fromSpec x) h2.symm
  have hns' : ¬ ∃ W : Z.Opens, hV₀.fromSpec ⟨RingHom.ker χB, RingHom.ker_isPrime χB⟩ ∈ W ∧
      SmoothOfRelativeDimension 1 (W.ι ≫ u) := by
    rw [hpt]; exact hns

  have hPNT := wcpa_dj_lqu_sigma_pnt Z (Spec (.of R)) u hsemi inferInstance ⊤ (isAffineOpen_top _)
    V₀ hV₀ e m r p F hpC hps hker (AlgebraicClosure 𝔮.asIdeal.ResidueField) χB hns'
  unfold wcpaLquPNT at hPNT
  obtain ⟨α, β, -, hind, -⟩ := hPNT
  let ψ : Γ(Spec (.of R), ⊤) →+* AlgebraicClosure 𝔮.asIdeal.ResidueField :=
    χB.comp (u.appLE ⊤ V₀ e).hom
  let c : Fin m → AlgebraicClosure 𝔮.asIdeal.ResidueField := fun l => χB (p (MvPolynomial.X l))
  have hEid : ∀ G, MvPolynomial.eval₂ ψ c G = χB (p G) := by
    intro G
    have : MvPolynomial.eval₂Hom ψ c = χB.comp p := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [MvPolynomial.eval₂Hom_C]
        show χB ((u.appLE ⊤ V₀ e).hom a) = χB (p (MvPolynomial.C a))
        rw [← RingHom.congr_fun hpC a]
        rfl
      · intro i
        rw [MvPolynomial.eval₂Hom_X']
        rfl
    exact RingHom.congr_fun this G
  let Fb : Fin r → MvPolynomial (Fin m) (AlgebraicClosure 𝔮.asIdeal.ResidueField) :=
    fun j => MvPolynomial.map ψ (F j)
  have hFb0 : ∀ j, MvPolynomial.eval c (Fb j) = 0 := by
    intro j
    show MvPolynomial.eval c (MvPolynomial.map ψ (F j)) = 0
    rw [MvPolynomial.eval_map, hEid, memF, map_zero]
  let J : Matrix (Fin r) (Fin m) (AlgebraicClosure 𝔮.asIdeal.ResidueField) :=
    Matrix.of fun j l => MvPolynomial.eval c (MvPolynomial.pderiv l (Fb j))
  have hJ' : ∀ j i, MvPolynomial.eval₂ ψ c (MvPolynomial.pderiv i (F j)) = J j i := by
    intro j i
    show _ = MvPolynomial.eval c (MvPolynomial.pderiv i (MvPolynomial.map ψ (F j)))
    rw [MvPolynomial.pderiv_map, MvPolynomial.eval_map]

  have hlin : ∀ (a b : AlgebraicClosure 𝔮.asIdeal.ResidueField) (μ : Fin r → _),
      a • α + b • β = Matrix.vecMul μ J → a = 0 ∧ b = 0 := by
    intro a b μ hμ
    have h1 := (wcpa_dj_sno_jets_lin_I2 _ m r Fb c hFb0 (a • α + b • β)).mpr ⟨μ, hμ⟩
    apply hind a b
    have h2 : MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β =
        wcpaLquLin c (a • α + b • β) := by
      simp only [wcpaLquLin, Finset.mul_sum, ← Finset.sum_add_distrib, Pi.add_apply,
        Pi.smul_apply, smul_eq_mul, map_add, map_mul]
      refine Finset.sum_congr rfl fun l _ => ?_
      ring
    rw [h2]
    exact h1

  obtain ⟨v, l, hv, hminor⟩ := s6 _ m r J α β hlin

  letI algBO : Algebra Γ(Z, V₀) (Z.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hz⟩
  haveI hloc := hV₀.isLocalization_stalk ⟨z, hz⟩
  have hΘ : ∀ k : Fin 2, ∃ D : Z.presheaf.stalk z → AlgebraicClosure 𝔮.asIdeal.ResidueField,
      (∀ x y, D (x + y) = D x + D y) ∧ (∀ x y, D (x * y) = χO x * D y + χO y * D x) ∧
      ∀ G, D (algebraMap Γ(Z, V₀) (Z.presheaf.stalk z) (p G)) =
        TrivSqZeroExt.snd (MvPolynomial.eval₂Hom
          ((TrivSqZeroExt.inlHom (AlgebraicClosure 𝔮.asIdeal.ResidueField)
            (AlgebraicClosure 𝔮.asIdeal.ResidueField)).comp ψ)
          (fun i => (TrivSqZeroExt.inl (c i) + TrivSqZeroExt.inr (v k i) :
            DualNumber (AlgebraicClosure 𝔮.asIdeal.ResidueField))) G) := by
    intro k
    refine @s8 _ _ _ _ _ _ _ _ _ (hV₀.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl hloc m r p F _ χO
      hps hker ?_ ?_
    · intro j
      apply TrivSqZeroExt.ext
      · rw [MvPolynomial.coe_eval₂Hom, (s7 _ _ m ψ c (v k) (F j)).1, hEid, memF, map_zero,
          TrivSqZeroExt.fst_zero]
      · rw [MvPolynomial.coe_eval₂Hom, (s7 _ _ m ψ c (v k) (F j)).2, TrivSqZeroExt.snd_zero]
        simp only [hJ']
        rw [← hv k j]
        exact Finset.sum_congr rfl fun i _ => mul_comm _ _
    · intro G
      rw [MvPolynomial.coe_eval₂Hom, (s7 _ _ m ψ c (v k) G).1, hEid]
      rfl
  choose D hDadd hDmul hDG using hΘ
  have hDC : ∀ k a, D k (algebraMap Γ(Z, V₀) (Z.presheaf.stalk z) (p (MvPolynomial.C a))) = 0 := by
    intro k a
    rw [hDG, MvPolynomial.eval₂Hom_C]
    simp
  have hDX : ∀ k i, D k (algebraMap Γ(Z, V₀) (Z.presheaf.stalk z) (p (MvPolynomial.X i))) =
      v k i := by
    intro k i
    rw [hDG, MvPolynomial.eval₂Hom_X']
    simp

  have s2 : ∀ r₀ : R, (Z.presheaf.germ V₀ z hz).hom ((u.appLE ⊤ V₀ e).hom
      ((Scheme.ΓSpecIso (.of R)).inv.hom r₀)) =
      (Z.presheaf.germ ⊤ z trivial).hom (wcCnSigma u ⊤ r₀) := by
    intro r₀
    have h1 : (Z.presheaf.germ ⊤ z trivial).hom (wcCnSigma u ⊤ r₀) =
        (Z.presheaf.germ ⊤ z trivial).hom
          (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r₀)) := by
      unfold wcCnSigma
      exact TopCat.Presheaf.germ_res_apply Z.presheaf
        (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)) z (show z ∈ (⊤ : Z.Opens) from trivial) _
    rw [h1]
    exact TopCat.Presheaf.germ_res_apply Z.presheaf (homOfLE e) z hz _
  have hDR : ∀ k (r₀ : R), D k (algebraMap R (Z.presheaf.stalk z) r₀) = 0 := by
    intro k r₀
    have h1 : algebraMap R (Z.presheaf.stalk z) r₀ = algebraMap Γ(Z, V₀) (Z.presheaf.stalk z)
        (p (MvPolynomial.C ((Scheme.ΓSpecIso (.of R)).inv.hom r₀))) := by
      rw [show p (MvPolynomial.C ((Scheme.ΓSpecIso (.of R)).inv.hom r₀)) =
        (u.appLE ⊤ V₀ e).hom ((Scheme.ΓSpecIso (.of R)).inv.hom r₀) from RingHom.congr_fun hpC _]
      exact (s2 r₀).symm
    rw [h1, hDC]

  have hrank := s9 R (Z.presheaf.stalk z) _ χO 𝔮.asIdeal hkerO D
    (fun i => algebraMap Γ(Z, V₀) (Z.presheaf.stalk z) (p (MvPolynomial.X (l i))))
    hDR hDadd hDmul (by simp only [hDX]; exact hminor) hfd
  omega

theorem wcpa_dj_nccw_eb_count_normal_node : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ¬ nccwSm u (ν zk) → IsDomain (Z.presheaf.stalk (ν zk)) → IsIntegrallyClosed (Z.presheaf.stalk (ν zk)) → nccwEbBh R u ν zk = ∅ ∧ (nccwEbBv R u ν zk).Finite ∧ (nccwEbBv R u ν zk).ncard ≤ 2 :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA hsm
    hd hic
  classical

  have evcompat : ∀ {A : Type u} [CommRing A] (I : Ideal A) {m n : ℕ} (hle : m ≤ n)
      (x : AdicCompletion I A),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I n x) =
        AdicCompletion.evalₐ I m x := by
    intro A _ I m n hle x
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    rw [show Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ n) (s.1 n)) =
      Ideal.Quotient.mk (I ^ m) (s.1 n) from Ideal.Quotient.factor_mk _ _]
    rw [Ideal.Quotient.eq]
    have h := AdicCompletion.AdicCauchySequence.mk_eq_mk hle s
    rw [Submodule.Quotient.eq] at h
    have h' : (I ^ m • ⊤ : Submodule A A) = I ^ m := by
      rw [smul_eq_mul, Ideal.mul_top]
    rw [h'] at h
    exact h

  have L2 : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      (φ : A ≃+* B), ∃ ψ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
        ψ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
          algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ a) := by
    intro A B _ _ _ _ φ
    have fp : ∀ (C : Type u) [CommRing C] (I : Ideal C) {m n : ℕ} (hle : m ≤ n) (y : C),
        Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ n) y) =
          Ideal.Quotient.mk (I ^ m) y :=
      fun C _ I m n hle y => Ideal.Quotient.factor_mk _ _
    have build : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
        (f : A →+* B) (hf : IsLocalRing.maximalIdeal A ≤
          Ideal.comap f (IsLocalRing.maximalIdeal B)),
        ∃ F : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B,
          ∀ n x, AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) n (F x) =
            Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) f
              ((Ideal.pow_right_mono hf n).trans (Ideal.le_comap_pow f n))
              (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x) := by
      intro A B _ _ _ _ f hf
      refine ⟨AdicCompletion.liftRingHom (IsLocalRing.maximalIdeal B)
        (fun n => (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) f
          ((Ideal.pow_right_mono hf n).trans (Ideal.le_comap_pow f n))).comp
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom) ?_, ?_⟩
      · intro m n hle
        ext x
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
        rw [← evcompat (IsLocalRing.maximalIdeal A) hle x]
        obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x)
        rw [← hy, Ideal.quotientMap_mk, fp, fp, Ideal.quotientMap_mk]
      · intro n x
        rw [AdicCompletion.evalₐ_liftRingHom]
        rfl
    have hle1 : IsLocalRing.maximalIdeal A ≤
        Ideal.comap (φ : A →+* B) (IsLocalRing.maximalIdeal B) := by
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
      intro hu; apply hx
      have := hu.map φ.symm
      simpa using this
    have hle2 : IsLocalRing.maximalIdeal B ≤
        Ideal.comap (φ.symm : B →+* A) (IsLocalRing.maximalIdeal A) := by
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
      intro hu; apply hx
      have := hu.map φ
      simpa using this
    obtain ⟨F, hF⟩ := build A B (φ : A →+* B) hle1
    obtain ⟨G, hG⟩ := build B A (φ.symm : B →+* A) hle2
    have hGF : ∀ x, G (F x) = x := by
      intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [hG, hF]
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x)
      rw [← hy, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      simp
    have hFG : ∀ x, F (G x) = x := by
      intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [hF, hG]
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) n x)
      rw [← hy, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      simp
    refine ⟨{ F with
      invFun := G
      left_inv := hGF
      right_inv := hFG }, ?_⟩
    intro a
    show F _ = _
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hF]
    simp [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Ideal.quotientMap_mk]

  obtain ⟨hcomp, halg, hPr, hH, hS⟩ := hA
  obtain ⟨-, hL, -, -, -, hEx, -⟩ := hPr
  obtain ⟨-, hst, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hp, hu, hz, -⟩ := hH
  obtain ⟨-, -, -, -, -, -, ⟨hQ7a, -⟩, -, -, -, -, -, ⟨-, hP12Z⟩⟩ := hS
  have hss : wcpaDjSemistable u := by unfold wcpaDjStablePtd at hst; exact hst.1
  have hprop : IsProper u := by unfold wcpaDjSemistable at hss; exact hss.2.1
  haveI := hprop
  have hzeq := hQ7a.trans hp
  have hzu : u (ν zk) = IsLocalRing.closedPoint R := by rw [hzeq]; exact hu
  have hzc : IsClosed ({ν zk} : Set Z) := by rw [hzeq]; exact hz

  have hLs := hL R hcomp halg Z u hss (ν zk) hzu hzc
  obtain ⟨-, c, e, hc, he⟩ := hLs.resolve_left (fun h1 => hsm h1.1)

  have hdomZ := wcpa_dj_nccw_ebn_completion_domain hEx R hcomp Z u inferInstance (ν zk) hzc hd hic
  have hc0 : c ≠ 0 := by
    intro hc0
    haveI := hdomZ
    haveI hT : IsDomain (MvPowerSeries (Fin 2) R ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}) :=
      Function.Injective.isDomain e.symm.toRingHom e.symm.injective
    have hX : (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c :
        MvPowerSeries (Fin 2) R) = MvPowerSeries.X 0 * MvPowerSeries.X 1 := by
      rw [hc0, map_zero, sub_zero]
    have hxy : (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C c : MvPowerSeries (Fin 2) R)}) (MvPowerSeries.X (0 : Fin 2))) *
        Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C c : MvPowerSeries (Fin 2) R)}) (MvPowerSeries.X (1 : Fin 2)) = 0 := by
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      convert Ideal.mem_span_singleton_self
        (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c : MvPowerSeries (Fin 2) R)
        using 1
      exact hX.symm
    rcases mul_eq_zero.mp hxy with h0 | h0
    · obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      rw [hX] at hg
      have hdvd : (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) R) ∣ MvPowerSeries.X 0 :=
        ⟨g * MvPowerSeries.X 0, by
          calc (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) R)
              = g * (MvPowerSeries.X 0 * MvPowerSeries.X 1) := hg.symm
            _ = MvPowerSeries.X 1 * (g * MvPowerSeries.X 0) := by ring⟩
      have h1 := MvPowerSeries.X_dvd_iff.mp hdvd (Finsupp.single 0 1) (by simp)
      rw [MvPowerSeries.coeff_index_single_X] at h1
      simp at h1
    · obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      rw [hX] at hg
      have hdvd : (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) R) ∣ MvPowerSeries.X 1 :=
        ⟨g * MvPowerSeries.X 1, by
          calc (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) R)
              = g * (MvPowerSeries.X 0 * MvPowerSeries.X 1) := hg.symm
            _ = MvPowerSeries.X 0 * (g * MvPowerSeries.X 1) := by ring⟩
      have h1 := MvPowerSeries.X_dvd_iff.mp hdvd (Finsupp.single 1 1) (by simp)
      rw [MvPowerSeries.coeff_index_single_X] at h1
      simp at h1

  obtain ⟨w, hw, hiso⟩ := hP12Z (ν zk) hd hic
  have hzw : zk = w := (hw zk).mp rfl
  subst hzw
  let φ : Z.presheaf.stalk (ν zk) ≃+* S.presheaf.stalk zk :=
    (asIso (ν.stalkMap zk)).commRingCatIsoToRingEquiv
  obtain ⟨Ψ, hΨ⟩ := L2 _ _ φ

  have key : ν.appTop ≫ S.presheaf.germ ⊤ zk trivial =
      Z.presheaf.germ ⊤ (ν zk) trivial ≫ ν.stalkMap zk :=
    (Scheme.Hom.germ_stalkMap ν ⊤ zk trivial).symm
  have L4cat : (Scheme.ΓSpecIso (.of R)).inv ≫ (ν ≫ u).appTop ≫ S.presheaf.germ ⊤ zk trivial =
      (Scheme.ΓSpecIso (.of R)).inv ≫ u.appTop ≫
        Z.presheaf.germ ⊤ (ν zk) trivial ≫ ν.stalkMap zk := by
    rw [← key, Scheme.Hom.comp_appTop, Category.assoc]
  have hres : ∀ r : R, (Z.presheaf.germ ⊤ (ν zk) trivial).hom (wcCnSigma u ⊤ r) =
      (Z.presheaf.germ ⊤ (ν zk) trivial).hom (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r)) := by
    intro r
    unfold wcCnSigma
    exact TopCat.Presheaf.germ_res_apply Z.presheaf
      (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)) (ν zk) (show ν zk ∈ (⊤ : Z.Opens) from trivial) _
  have L4 : ∀ r : R,
      ((Scheme.ΓSpecIso (.of R)).inv ≫ (ν ≫ u).appTop ≫ S.presheaf.germ ⊤ zk trivial).hom r =
        φ ((Z.presheaf.germ ⊤ (ν zk) trivial).hom (wcCnSigma u ⊤ r)) := by
    intro r
    rw [L4cat, hres r]
    rfl
  have hsig : ∀ r : R, nccwEbSig R u ν zk r = algebraMap _ _
      (φ ((Z.presheaf.germ ⊤ (ν zk) trivial).hom (wcCnSigma u ⊤ r))) := by
    intro r
    unfold nccwEbSig
    rw [RingHom.comp_apply, L4 r]
  have hE : ∀ r : R, (Ψ.symm.trans e) (nccwEbSig R u ν zk r) =
      Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C c}) (MvPowerSeries.C r) := by
    intro r
    show e (Ψ.symm (nccwEbSig R u ν zk r)) = _
    rw [hsig r, ← hΨ, RingEquiv.symm_apply_apply]
    exact RingHom.congr_fun he r

  obtain ⟨Px, Py, hPxy⟩ := wcpa_dj_nccw_ebn_vertical_primes R c hc
  let f : PrimeSpectrum (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk))
      (S.presheaf.stalk zk)) → Ideal (MvPowerSeries (Fin 2) R ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}) :=
    fun β => Ideal.comap (Ψ.symm.trans e).symm β.asIdeal
  have hfinj : Function.Injective f := by
    intro β1 β2 h12
    apply PrimeSpectrum.ext
    exact Ideal.comap_injective_of_surjective (Ψ.symm.trans e).symm
      (Ψ.symm.trans e).symm.surjective h12
  have hmaps : ∀ β ∈ nccwEbBv R u ν zk, f β ∈ ({Px, Py} : Set (Ideal (MvPowerSeries (Fin 2) R ⧸
      Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}))) := by
    rintro β ⟨⟨a, ha, haβ⟩, hσ⟩
    have hP : (f β).IsPrime := Ideal.comap_isPrime _ _
    have hC : ∀ r ∈ IsLocalRing.maximalIdeal R, Ideal.Quotient.mk (Ideal.span
        {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}) (MvPowerSeries.C r) ∈ f β := by
      intro r hr
      show _ ∈ Ideal.comap (Ψ.symm.trans e).symm β.asIdeal
      rw [Ideal.mem_comap, ← hE r, RingEquiv.symm_apply_apply]
      exact hσ r hr
    have hnu : ¬ IsUnit (algebraMap (S.presheaf.stalk zk)
        (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)) a) := by
      intro hu
      have h1 := hu.map (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) 1)
      have h2 : AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) 1
          (algebraMap (S.presheaf.stalk zk) (AdicCompletion
            (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)) a) = 0 := by
        rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
          AdicCompletion.evalₐ_of, Ideal.Quotient.eq_zero_iff_mem, pow_one]
        exact ha
      rw [h2] at h1
      have h3 : (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (S.presheaf.stalk zk) ^ 1)) 1 = 0 := by
        rw [map_one]; exact (isUnit_zero_iff.mp h1).symm
      rw [Ideal.Quotient.eq_zero_iff_mem, pow_one] at h3
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
    have ht : ∃ t, t ∉ f β ∧ ¬ IsUnit t := by
      refine ⟨(Ψ.symm.trans e) (algebraMap _ _ a), ?_, ?_⟩
      · show _ ∉ Ideal.comap (Ψ.symm.trans e).symm β.asIdeal
        rw [Ideal.mem_comap, RingEquiv.symm_apply_apply]
        exact haβ
      · intro hu
        apply hnu
        have := hu.map (Ψ.symm.trans e).symm
        rwa [RingEquiv.symm_apply_apply] at this
    rcases hPxy (f β) hP hC ht with h1 | h1
    · rw [h1]; exact Set.mem_insert _ _
    · rw [h1]; exact Set.mem_insert_of_mem _ rfl
  have hTf : ({Px, Py} : Set (Ideal (MvPowerSeries (Fin 2) R ⧸
      Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}))).Finite :=
    Set.toFinite _
  have hinjOn : Set.InjOn f (nccwEbBv R u ν zk) := fun _ _ _ _ h12 => hfinj h12
  have hBvfin : (nccwEbBv R u ν zk).Finite :=
    Set.Finite.of_finite_image (hTf.subset (by rintro _ ⟨β, hβ, rfl⟩; exact hmaps β hβ)) hinjOn
  have hcard : (nccwEbBv R u ν zk).ncard ≤ 2 := by
    have h1 := Set.ncard_le_ncard_of_injOn f hmaps hinjOn hTf
    have h2 := Set.ncard_insert_le Px ({Py} : Set (Ideal (MvPowerSeries (Fin 2) R ⧸
      Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c})))
    rw [Set.ncard_singleton] at h2
    omega

  have hpt : ∀ p : Spec (S.presheaf.stalk zk), ν (S.fromSpecStalk zk p) =
      Z.fromSpecStalk (ν zk) (Spec.map (ν.stalkMap zk) p) := by
    intro p
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply,
      Scheme.SpecMap_stalkMap_fromSpecStalk]
  have hBh : nccwEbBh R u ν zk = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    rintro β ⟨-, ⟨r, hr, hrβ⟩, hns⟩
    apply hns
    have hpt' := hpt (PrimeSpectrum.comap (algebraMap
          (S.presheaf.stalk zk) (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk))
            (S.presheaf.stalk zk))) β)
    rw [hpt']
    have hq : (Z.presheaf.germ ⊤ (ν zk) trivial).hom (wcCnSigma u ⊤ r) ∉
        (PrimeSpectrum.comap (ν.stalkMap zk).hom (PrimeSpectrum.comap (algebraMap
          (S.presheaf.stalk zk) (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk))
            (S.presheaf.stalk zk))) β)).asIdeal := by
      intro hmem
      apply hrβ
      rw [hsig r]
      exact hmem
    have hrank := wcpa_dj_nccw_ebn_omega_rank R hcomp Z u inferInstance (ν zk) hzu hzc c e hc0 hc
      he _ ⟨r, hr, hq⟩
    have hfin := wcpa_dj_nccw_ebn_smooth_of_omega R Z u hss (ν zk) _ hrank
    first
      | exact hfin
      | (convert hfin using 3; exact Spec.map_apply _ _)
      | (refine (congrArg (fun x => nccwSm u (Z.fromSpecStalk (ν zk) x))
          (Spec.map_apply _ _)).mpr ?_; exact hfin)
  exact ⟨hBh, hBvfin, hcard⟩

theorem nccwff_powerseries_props : ∀ (R : Type u) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R →
    IsAdicComplete (IsLocalRing.maximalIdeal (PowerSeries R)) (PowerSeries R) ∧
    ringKrullDim (PowerSeries R) = 2 ∧ IsRegularLocalRing (PowerSeries R) ∧
    Function.Injective (PowerSeries.C : R →+* PowerSeries R) ∧
    ∃ ρ : IsLocalRing.ResidueField R ≃+* IsLocalRing.ResidueField (PowerSeries R),
      ρ.toRingHom.comp (IsLocalRing.residue R) =
        (IsLocalRing.residue (PowerSeries R)).comp (PowerSeries.C : R →+* PowerSeries R) :=
by
  intro R _ _ _ hcomp
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hm : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} := hϖ.maximalIdeal_eq
  have hCmem : PowerSeries.C ϖ ∈ ({PowerSeries.C ϖ, PowerSeries.X} : Set (PowerSeries R)) :=
    Set.mem_insert _ _
  have hXmem : PowerSeries.X ∈ ({PowerSeries.C ϖ, PowerSeries.X} : Set (PowerSeries R)) :=
    Set.mem_insert_of_mem _ rfl

  have hP : IsLocalRing.maximalIdeal (PowerSeries R) =
      Ideal.span {PowerSeries.C ϖ, PowerSeries.X} := by
    apply le_antisymm
    · intro f hf
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        PowerSeries.isUnit_iff_constantCoeff] at hf
      have h0 : PowerSeries.constantCoeff f ∈ Ideal.span {ϖ} := by
        rw [← hm]; exact hf
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp h0
      rw [Ideal.mem_span_pair]
      refine ⟨PowerSeries.C a, PowerSeries.mk fun p => PowerSeries.coeff (p + 1) f, ?_⟩
      conv_rhs => rw [PowerSeries.eq_X_mul_shift_add_const f]
      rw [← ha, map_mul]
      ring
    · rw [Ideal.span_le]
      intro g hg
      rcases hg with rfl | rfl
      · rw [SetLike.mem_coe, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          PowerSeries.isUnit_iff_constantCoeff, PowerSeries.constantCoeff_C]
        exact hϖ.not_isUnit
      · rw [SetLike.mem_coe, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          PowerSeries.isUnit_iff_constantCoeff, PowerSeries.constantCoeff_X]
        exact not_isUnit_zero

  have hfilt : ∀ (n : ℕ) (f : PowerSeries R),
      f ∈ (Ideal.span {PowerSeries.C ϖ, PowerSeries.X} : Ideal (PowerSeries R)) ^ n ↔
        ∀ k, PowerSeries.coeff k f ∈ (Ideal.span {ϖ} : Ideal R) ^ (n - k) := by
    let J : ℕ → Ideal (PowerSeries R) := fun n =>
      { carrier := {f | ∀ k, PowerSeries.coeff k f ∈ (Ideal.span {ϖ} : Ideal R) ^ (n - k)}
        add_mem' := fun {a b} ha hb k => by rw [map_add]; exact add_mem (ha k) (hb k)
        zero_mem' := fun k => by rw [map_zero]; exact zero_mem _
        smul_mem' := fun c {f} hf k => by
          rw [smul_eq_mul, PowerSeries.coeff_mul]
          apply Ideal.sum_mem
          intro p hp
          apply Ideal.mul_mem_left
          have hp2 : p.2 ≤ k := by
            have := Finset.HasAntidiagonal.mem_antidiagonal.mp hp; omega
          exact Ideal.pow_le_pow_right (by omega) (hf p.2) }
    have hJ : ∀ n f, f ∈ J n ↔
        ∀ k, PowerSeries.coeff k f ∈ (Ideal.span {ϖ} : Ideal R) ^ (n - k) := fun n f => Iff.rfl
    have h1 : ∀ n, (Ideal.span {PowerSeries.C ϖ, PowerSeries.X} : Ideal (PowerSeries R)) ^ n
        ≤ J n := by
      intro n
      induction n with
      | zero =>
        intro f _
        rw [hJ]
        intro k
        rw [Nat.zero_sub, pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      | succ n ih =>
        rw [pow_succ, Ideal.mul_le]
        intro r hr s hs
        have hr' := (hJ _ _).mp (ih hr)
        rw [Ideal.mem_span_pair] at hs
        obtain ⟨a, b, rfl⟩ := hs
        have hC : PowerSeries.C ϖ * r ∈ J (n + 1) := by
          rw [hJ]
          intro k
          rw [PowerSeries.coeff_C_mul]
          have : ϖ * PowerSeries.coeff k r ∈ (Ideal.span {ϖ} : Ideal R) ^ (n - k + 1) := by
            rw [pow_succ']
            exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self ϖ) (hr' k)
          exact Ideal.pow_le_pow_right (by omega) this
        have hX : PowerSeries.X * r ∈ J (n + 1) := by
          rw [hJ]
          intro k
          cases k with
          | zero => rw [PowerSeries.coeff_zero_X_mul]; exact zero_mem _
          | succ k =>
            rw [PowerSeries.coeff_succ_X_mul]
            have e : n + 1 - (k + 1) = n - k := by omega
            rw [e]
            exact hr' k
        have e : r * (a * PowerSeries.C ϖ + b * PowerSeries.X) =
            a * (PowerSeries.C ϖ * r) + b * (PowerSeries.X * r) := by ring
        rw [e]
        exact add_mem (Ideal.mul_mem_left _ a hC) (Ideal.mul_mem_left _ b hX)
    have h2 : ∀ n, J n ≤
        (Ideal.span {PowerSeries.C ϖ, PowerSeries.X} : Ideal (PowerSeries R)) ^ n := by
      intro n
      induction n with
      | zero =>
        intro f _
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      | succ n ih =>
        intro f hf
        rw [hJ] at hf
        rw [PowerSeries.eq_X_mul_shift_add_const f]
        apply add_mem
        · have hg : (PowerSeries.mk fun p => PowerSeries.coeff (p + 1) f) ∈ J n := by
            rw [hJ]
            intro k
            rw [PowerSeries.coeff_mk]
            have e : n + 1 - (k + 1) = n - k := by omega
            rw [← e]
            exact hf (k + 1)
          rw [pow_succ']
          exact Ideal.mul_mem_mul (Ideal.subset_span hXmem) (ih hg)
        · have h0 := hf 0
          rw [Nat.sub_zero, Ideal.span_singleton_pow,
            PowerSeries.coeff_zero_eq_constantCoeff_apply] at h0
          obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h0
          rw [← hc, map_mul, map_pow]
          exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow (Ideal.subset_span hCmem) _)
    intro n f
    rw [← hJ]
    exact ⟨fun h => h1 n h, fun h => h2 n h⟩
  have hsm : ∀ {A : Type u} [CommRing A] (I : Ideal A) (n : ℕ) (x y : A),
      x ≡ y [SMOD I ^ n • (⊤ : Submodule A A)] ↔ x - y ∈ I ^ n := by
    intro A _ I n x y
    rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
  have hcompl : IsAdicComplete
      (Ideal.span {PowerSeries.C ϖ, PowerSeries.X} : Ideal (PowerSeries R)) (PowerSeries R) := by
    rw [hm] at hcomp
    have hH := hcomp.toIsHausdorff
    have hPc := hcomp.toIsPrecomplete
    haveI : IsHausdorff (Ideal.span {PowerSeries.C ϖ, PowerSeries.X} : Ideal (PowerSeries R))
        (PowerSeries R) := ⟨fun x hx => by
      ext k
      rw [map_zero]
      apply hH.haus
      intro j
      rw [hsm, sub_zero]
      have hx' := hx (j + k)
      rw [hsm, sub_zero] at hx'
      have := (hfilt (j + k) x).mp hx' k
      rwa [Nat.add_sub_cancel] at this⟩
    haveI : IsPrecomplete (Ideal.span {PowerSeries.C ϖ, PowerSeries.X} : Ideal (PowerSeries R))
        (PowerSeries R) := ⟨fun f hf => by
      have hc : ∀ k, ∃ L : R, ∀ j, PowerSeries.coeff k (f (j + k)) ≡ L
          [SMOD (Ideal.span {ϖ} : Ideal R) ^ j • (⊤ : Submodule R R)] := by
        intro k
        apply hPc.prec
        intro j j' hjj
        rw [hsm, ← map_sub]
        have := (hfilt (j + k) _).mp ((hsm _ _ _ _).mp (hf (by omega : j + k ≤ j' + k))) k
        rwa [Nat.add_sub_cancel] at this
      choose L hL using hc
      refine ⟨PowerSeries.mk L, fun n => ?_⟩
      rw [hsm, hfilt]
      intro k
      rw [map_sub, PowerSeries.coeff_mk]
      by_cases hk : k ≤ n
      · have e : n - k + k = n := by omega
        have := (hsm _ _ _ _).mp (hL k (n - k))
        rw [e] at this
        exact this
      · have e : n - k = 0 := by omega
        rw [e, pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top⟩
    exact IsAdicComplete.mk

  have hfin : ({PowerSeries.C ϖ, PowerSeries.X} : Set (PowerSeries R)).Finite := Set.toFinite _
  have hs : Submodule.spanFinrank (IsLocalRing.maximalIdeal (PowerSeries R)) ≤ 2 := by
    rw [hP]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite hfin).trans ?_
    refine (Set.ncard_insert_le _ _).trans ?_
    rw [Set.ncard_singleton]
  have hht := Ideal.height_le_spanFinrank (IsLocalRing.maximalIdeal (PowerSeries R))
    (IsLocalRing.maximalIdeal.isMaximal _).ne_top
  have hge := (ringKrullDim_succ_le_ringKrullDim_powerseries (R := R))
  rw [IsDiscreteValuationRing.ringKrullDim_eq_one R,
    ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim] at hge
  have h2le : (2 : ℕ∞) ≤ (IsLocalRing.maximalIdeal (PowerSeries R)).height := by
    have e : (1 : WithBot ℕ∞) + 1 = ((2 : ℕ∞) : WithBot ℕ∞) := rfl
    rw [e] at hge
    exact_mod_cast hge
  have hs2 : Submodule.spanFinrank (IsLocalRing.maximalIdeal (PowerSeries R)) = 2 := by
    have h3 : (2 : ℕ∞) ≤
        ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (PowerSeries R)) : ℕ) : ℕ∞) :=
      h2le.trans hht
    have h4 : 2 ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal (PowerSeries R)) := by
      exact_mod_cast h3
    omega
  have hh2 : (IsLocalRing.maximalIdeal (PowerSeries R)).height = 2 := by
    refine le_antisymm (hht.trans ?_) h2le
    rw [hs2]
    rfl
  have hdim : ringKrullDim (PowerSeries R) = 2 := by
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, hh2]
    rfl

  haveI hloc : IsLocalHom (PowerSeries.C : R →+* PowerSeries R) := ⟨fun a ha => by
    have := PowerSeries.isUnit_iff_constantCoeff.mp ha
    rwa [PowerSeries.constantCoeff_C] at this⟩
  have hinj : Function.Injective
      (IsLocalRing.ResidueField.map (PowerSeries.C : R →+* PowerSeries R)) :=
    (IsLocalRing.ResidueField.map (PowerSeries.C : R →+* PowerSeries R)).injective
  have hsurj : Function.Surjective
      (IsLocalRing.ResidueField.map (PowerSeries.C : R →+* PowerSeries R)) := by
    intro y
    obtain ⟨f, rfl⟩ := IsLocalRing.residue_surjective y
    refine ⟨IsLocalRing.residue R (PowerSeries.constantCoeff f), ?_⟩
    rw [IsLocalRing.ResidueField.map_residue]
    show Ideal.Quotient.mk _ (PowerSeries.C (PowerSeries.constantCoeff f)) =
      Ideal.Quotient.mk _ f
    apply Ideal.Quotient.eq.mpr
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff,
      map_sub, PowerSeries.constantCoeff_C, sub_self]
    exact not_isUnit_zero
  refine ⟨?_, hdim, ?_, PowerSeries.C_injective,
    ⟨RingEquiv.ofBijective _ ⟨hinj, hsurj⟩, ?_⟩⟩
  · rw [hP]; exact hcompl
  · exact IsRegularLocalRing.mk (by rw [hdim, hs2]; rfl)
  · ext r
    exact IsLocalRing.ResidueField.map_residue _ r

theorem wcpa_dj_npr_psr_maximalIdeal : ∀ (Λ : Type u) [CommRing Λ] [IsLocalRing Λ], IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) Λ) = Ideal.map (MvPowerSeries.C : Λ →+* MvPowerSeries (Fin 2) Λ) (IsLocalRing.maximalIdeal Λ) ⊔ Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} :=
by
  intro Λ _ _
  classical
  have hmem : ∀ f : MvPowerSeries (Fin 2) Λ,
      f ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) Λ) ↔
        MvPowerSeries.constantCoeff f ∈ IsLocalRing.maximalIdeal Λ := by
    intro f
    rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal, IsLocalRing.notMem_maximalIdeal,
      MvPowerSeries.isUnit_iff_constantCoeff]
  have hspan : ∀ g : MvPowerSeries (Fin 2) Λ, MvPowerSeries.constantCoeff g = 0 →
      g ∈ Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Λ), MvPowerSeries.X 1} := by
    intro g hg
    let g₁ : MvPowerSeries (Fin 2) Λ := fun m => if m 0 = 0 then MvPowerSeries.coeff m g else 0
    have hg₁ : ∀ m, MvPowerSeries.coeff m g₁ = if m 0 = 0 then MvPowerSeries.coeff m g else 0 :=
      fun m => rfl
    obtain ⟨h₀, e₀⟩ : (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Λ) ∣ g - g₁ := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      rw [map_sub, hg₁, if_pos hm, sub_self]
    obtain ⟨h₁, e₁⟩ : (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Λ) ∣ g₁ := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      rw [hg₁]
      split_ifs with h0
      · have hm0 : m = 0 := by
          ext i
          fin_cases i
          · simpa using h0
          · simpa using hm
        rw [hm0, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hg]
      · rfl
    rw [Ideal.mem_span_pair]
    refine ⟨h₀, h₁, ?_⟩
    rw [mul_comm h₀, mul_comm h₁, ← e₀, ← e₁, sub_add_cancel]
  apply le_antisymm
  · intro f hf
    have hc := (hmem f).mp hf
    have hdecomp : f = MvPowerSeries.C (MvPowerSeries.constantCoeff f) +
        (f - MvPowerSeries.C (MvPowerSeries.constantCoeff f)) := by ring
    rw [hdecomp]
    refine Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ hc))
      (Ideal.mem_sup_right (hspan _ ?_))
    rw [map_sub, MvPowerSeries.constantCoeff_C, sub_self]
  · refine sup_le ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, hmem, MvPowerSeries.constantCoeff_C]
      exact ha
    · rw [Ideal.span_le]
      rintro _ (rfl | rfl)
      · exact (hmem _).mpr (by rw [MvPowerSeries.constantCoeff_X]; exact Ideal.zero_mem _)
      · exact (hmem _).mpr (by rw [MvPowerSeries.constantCoeff_X]; exact Ideal.zero_mem _)

theorem wcpa_dj_npr_psr_dim_ge : ∀ (Λ : Type u) [CommRing Λ] (n : ℕ), (n : WithBot ℕ∞) ≤ ringKrullDim Λ → ((n + 2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (MvPowerSeries (Fin 2) Λ) :=
by
  intro Λ _ n hn
  have ha : MvPowerSeries.HasSubst (![PowerSeries.X, 0] : Fin 2 → PowerSeries Λ) := by
    apply MvPowerSeries.hasSubst_of_constantCoeff_zero
    intro i
    fin_cases i
    · exact MvPowerSeries.constantCoeff_X ()
    · simp
  have hb : MvPowerSeries.HasSubst
      (fun _ : Unit => (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Λ)) := by
    apply MvPowerSeries.hasSubst_of_constantCoeff_zero
    intro i
    simp
  let f : MvPowerSeries (Fin 2) Λ →+* PowerSeries Λ :=
    (MvPowerSeries.substAlgHom (R := Λ) ha).toRingHom
  have hf1 : f (MvPowerSeries.X 1) = 0 := by
    show MvPowerSeries.substAlgHom ha (MvPowerSeries.X 1) = 0
    rw [MvPowerSeries.coe_substAlgHom, MvPowerSeries.subst_X ha]
    simp
  have hsurj : Function.Surjective f := by
    intro p
    refine ⟨MvPowerSeries.subst
      (fun _ : Unit => (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Λ)) p, ?_⟩
    show MvPowerSeries.substAlgHom ha _ = p
    rw [MvPowerSeries.coe_substAlgHom, MvPowerSeries.subst_comp_subst_apply hb ha]
    have : (fun s : Unit => MvPowerSeries.subst (![PowerSeries.X, 0] : Fin 2 → PowerSeries Λ)
        ((fun _ : Unit => (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) Λ)) s)) =
        MvPowerSeries.X := by
      funext s
      rw [MvPowerSeries.subst_X ha]
      rfl
    rw [this, MvPowerSeries.subst_self]
    rfl
  have h2 : ringKrullDim (PowerSeries Λ) + 1 ≤ ringKrullDim (MvPowerSeries (Fin 2) Λ) :=
    ringKrullDim_succ_le_of_surjective f hsurj MvPowerSeries.X_mem_nonzeroDivisors hf1
  have h1 : ringKrullDim Λ + 1 ≤ ringKrullDim (PowerSeries Λ) :=
    ringKrullDim_succ_le_ringKrullDim_powerseries
  have hcast : ((n + 2 : ℕ) : WithBot ℕ∞) = (n : WithBot ℕ∞) + 1 + 1 := by
    push_cast
    rw [add_assoc, one_add_one_eq_two]
  rw [hcast]
  calc (n : WithBot ℕ∞) + 1 + 1 ≤ ringKrullDim Λ + 1 + 1 := by gcongr
    _ ≤ ringKrullDim (PowerSeries Λ) + 1 := by gcongr
    _ ≤ ringKrullDim (MvPowerSeries (Fin 2) Λ) := h2

theorem wcpa_dj_stc_kmnb_xy_domain : ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A] (h : A),
    h ∈ IsLocalRing.maximalIdeal A → h ≠ 0 →
    IsDomain (MvPowerSeries (Fin 2) A ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h}) ∧
    (∀ a : A, MvPowerSeries.C a ∈ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h} → a = 0) ∧
    MvPowerSeries.X 0 ∉ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h} ∧
    MvPowerSeries.X 1 ∉ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h} :=
by
  intro A _ _ h hm h0
  classical

  have hmem : ∀ x : A, x ∈ IsLocalRing.maximalIdeal A ↔ ¬ IsUnit x := fun x => by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  have hmne : IsLocalRing.maximalIdeal A ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal A).ne_top
  have hhnu : ¬ IsUnit h := (hmem h).mp hm
  have hnhnu : ¬ IsUnit (-h) := fun hu => hhnu (by simpa using hu.neg)

  have hreg : IsRegularLocalRing (MvPowerSeries (Fin 2) A) := by
    haveI : IsNoetherianRing (MvPowerSeries (Fin 2) A) := wcpa_dj_nd_mvpowerseries_two_noetherian A
    have hA := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
    have hdim := wcpa_dj_npr_psr_dim_ge A
      (Submodule.spanFinrank (IsLocalRing.maximalIdeal A)) hA.le
    obtain ⟨s, hs_card, hs_span⟩ :=
      (IsNoetherian.noetherian (IsLocalRing.maximalIdeal A)).exists_span_set_encard_eq_spanFinrank
    have hs_span' : Ideal.span s = IsLocalRing.maximalIdeal A := hs_span
    have hs_fin : s.Finite := Set.finite_of_encard_eq_coe hs_card
    have hs_ncard : s.ncard = Submodule.spanFinrank (IsLocalRing.maximalIdeal A) := by
      have := hs_fin.cast_ncard_eq
      rw [hs_card] at this
      exact_mod_cast this
    have hmP : IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) A) =
        Ideal.span ((MvPowerSeries.C : A →+* MvPowerSeries (Fin 2) A) '' s ∪
          {MvPowerSeries.X 0, MvPowerSeries.X 1}) := by
      rw [wcpa_dj_npr_psr_maximalIdeal A, Ideal.span_union, ← Ideal.map_span, hs_span']
    have h2 : ({MvPowerSeries.X 0, MvPowerSeries.X 1} : Set (MvPowerSeries (Fin 2) A)).ncard ≤ 2 :=
      (Set.ncard_insert_le _ _).trans (by rw [Set.ncard_singleton])
    apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
    refine le_trans ?_ hdim
    rw [hmP]
    have hle : Submodule.spanFinrank (Ideal.span ((MvPowerSeries.C : A →+* MvPowerSeries (Fin 2) A) '' s ∪
          {MvPowerSeries.X 0, MvPowerSeries.X 1})) ≤
        Submodule.spanFinrank (IsLocalRing.maximalIdeal A) + 2 := by
      calc _ ≤ ((MvPowerSeries.C : A →+* MvPowerSeries (Fin 2) A) '' s ∪
              {MvPowerSeries.X 0, MvPowerSeries.X 1}).ncard :=
            Submodule.spanFinrank_span_le_ncard_of_finite ((hs_fin.image _).union (Set.toFinite _))
        _ ≤ ((MvPowerSeries.C : A →+* MvPowerSeries (Fin 2) A) '' s).ncard +
              ({MvPowerSeries.X 0, MvPowerSeries.X 1} : Set (MvPowerSeries (Fin 2) A)).ncard :=
            Set.ncard_union_le _ _
        _ ≤ s.ncard + 2 := add_le_add (Set.ncard_image_le hs_fin) h2
        _ = _ := by rw [hs_ncard]
    exact_mod_cast hle
  obtain ⟨hdom, hufd⟩ := wc_fco_regular_local_ufd (MvPowerSeries (Fin 2) A)
  haveI := hdom
  haveI := hufd

  have axis_mul : ∀ (σ : Fin 2) (U V : MvPowerSeries (Fin 2) A),
      PowerSeries.mk (fun i => MvPowerSeries.coeff (Finsupp.single σ i) (U * V)) =
      PowerSeries.mk (fun i => MvPowerSeries.coeff (Finsupp.single σ i) U) *
      PowerSeries.mk (fun i => MvPowerSeries.coeff (Finsupp.single σ i) V) := by
    intro σ U V
    ext i
    rw [PowerSeries.coeff_mk, PowerSeries.coeff_mul, MvPowerSeries.coeff_mul,
      Finsupp.antidiagonal_single, Finset.sum_map]
    simp [PowerSeries.coeff_mk]

  have n01 : (0 : Fin 2 →₀ ℕ) ≠ Finsupp.single 0 1 := by
    intro h'; have := DFunLike.congr_fun h' 0; simp at this
  have n02 : (0 : Fin 2 →₀ ℕ) ≠ Finsupp.single 1 1 := by
    intro h'; have := DFunLike.congr_fun h' 1; simp at this
  have n03 : (0 : Fin 2 →₀ ℕ) ≠ Finsupp.single 0 1 + Finsupp.single 1 1 := by
    intro h'; have := DFunLike.congr_fun h' 0; simp at this
  have n12 : (Finsupp.single 0 1 : Fin 2 →₀ ℕ) ≠ Finsupp.single 1 1 := by
    intro h'; have := DFunLike.congr_fun h' 0; simp at this
  have n13 : (Finsupp.single 0 1 : Fin 2 →₀ ℕ) ≠ Finsupp.single 0 1 + Finsupp.single 1 1 := by
    intro h'; have := DFunLike.congr_fun h' 1; simp at this
  have n23 : (Finsupp.single 1 1 : Fin 2 →₀ ℕ) ≠ Finsupp.single 0 1 + Finsupp.single 1 1 := by
    intro h'; have := DFunLike.congr_fun h' 0; simp at this

  have coeff_e : ∀ U V : MvPowerSeries (Fin 2) A,
      MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) (U * V) =
        MvPowerSeries.constantCoeff U *
          MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) V +
        MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) U *
          MvPowerSeries.constantCoeff V +
        MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1) U *
          MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) 1) V +
        MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) 1) U *
          MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1) V := by
    intro U V
    have hS : Finset.HasAntidiagonal.antidiagonal
        (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) =
        {(0, Finsupp.single 0 1 + Finsupp.single 1 1), (Finsupp.single 0 1, Finsupp.single 1 1),
          (Finsupp.single 1 1, Finsupp.single 0 1), (Finsupp.single 0 1 + Finsupp.single 1 1, 0)} := by
      ext ⟨p, q⟩
      simp only [Finset.HasAntidiagonal.mem_antidiagonal, Finset.mem_insert, Finset.mem_singleton,
        Prod.mk.injEq]
      constructor
      · intro hpq
        have e0 := DFunLike.congr_fun hpq 0
        have e1 := DFunLike.congr_fun hpq 1
        simp only [Finsupp.coe_add, Pi.add_apply, Finsupp.single_apply] at e0 e1
        simp at e0 e1
        have ha : p 0 = 0 ∨ p 0 = 1 := by omega
        have hb : p 1 = 0 ∨ p 1 = 1 := by omega
        rcases ha with ha | ha <;> rcases hb with hb | hb
        · left
          constructor <;> ext i <;> fin_cases i <;> simp <;> omega
        · right; right; left
          constructor <;> ext i <;> fin_cases i <;> simp <;> omega
        · right; left
          constructor <;> ext i <;> fin_cases i <;> simp <;> omega
        · right; right; right
          constructor <;> ext i <;> fin_cases i <;> simp <;> omega
      · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
        · simp
        · rfl
        · rw [add_comm]
        · simp
    rw [MvPowerSeries.coeff_mul, hS, Finset.sum_insert, Finset.sum_insert, Finset.sum_insert,
      Finset.sum_singleton]
    · simp only [MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
      ring
    · simp [n13.symm, n23.symm]
    · simp [n01.symm, n12, n13, Ne.symm n01]
    · simp [n01, n02, n03]

  have hF0 : MvPowerSeries.constantCoeff
      (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h : MvPowerSeries (Fin 2) A) = -h := by
    simp
  have hXX : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) A) =
      MvPowerSeries.monomial (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) 1 := by
    rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, mul_one]
  have hFe : MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1)
      (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h : MvPowerSeries (Fin 2) A) = 1 := by
    rw [map_sub, hXX, MvPowerSeries.coeff_monomial, MvPowerSeries.coeff_C, if_pos rfl,
      if_neg (Ne.symm n03), sub_zero]
  have hFax : ∀ σ : Fin 2, PowerSeries.mk (fun i => MvPowerSeries.coeff (Finsupp.single σ i)
      (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h : MvPowerSeries (Fin 2) A)) =
      PowerSeries.C (-h) := by
    intro σ
    ext i
    rw [PowerSeries.coeff_mk, map_sub, hXX, MvPowerSeries.coeff_monomial, MvPowerSeries.coeff_C,
      PowerSeries.coeff_C]
    have hne : Finsupp.single σ i ≠ Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1 := by
      intro h'
      fin_cases σ
      · have := DFunLike.congr_fun h' 1; simp at this
      · have := DFunLike.congr_fun h' 0; simp at this
    rw [if_neg hne]
    by_cases hi : i = 0
    · subst hi; simp
    · rw [if_neg (by simpa using hi), if_neg hi, sub_zero]

  have no_const : ∀ (U V : PowerSeries A) (c : A),
      PowerSeries.constantCoeff U ∈ IsLocalRing.maximalIdeal A →
      IsUnit (PowerSeries.coeff 1 U) → U * V = PowerSeries.C c → V = 0 := by
    intro U V c hU0 hU1 hUV
    by_contra hV
    have hex : ∃ j, PowerSeries.coeff j V ≠ 0 := by
      by_contra hall
      push_neg at hall
      exact hV (PowerSeries.ext (fun n => by simp [hall n]))
    have hKrull : ⨅ i, IsLocalRing.maximalIdeal A ^ i = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing _ hmne
    have hQ : ∃ k, ∃ j, PowerSeries.coeff j V ∉ IsLocalRing.maximalIdeal A ^ (k + 1) := by
      obtain ⟨j, hj⟩ := hex
      have hj' : PowerSeries.coeff j V ∉ ⨅ i, IsLocalRing.maximalIdeal A ^ i := by
        rw [hKrull, Ideal.mem_bot]; exact hj
      rw [Ideal.mem_iInf] at hj'
      push_neg at hj'
      obtain ⟨k, hk⟩ := hj'
      exact ⟨k, j, fun h' => hk (Ideal.pow_le_pow_right (Nat.le_succ k) h')⟩
    set K := Nat.find hQ with hKdef
    have hK : ∃ j, PowerSeries.coeff j V ∉ IsLocalRing.maximalIdeal A ^ (K + 1) := Nat.find_spec hQ
    have hallK : ∀ j, PowerSeries.coeff j V ∈ IsLocalRing.maximalIdeal A ^ K := by
      intro j
      by_cases hK0 : K = 0
      · rw [hK0, pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      · obtain ⟨K', hK'⟩ := Nat.exists_eq_succ_of_ne_zero hK0
        have hlt : K' < K := by omega
        have := Nat.find_min hQ hlt
        push_neg at this
        rw [hK']
        exact this j
    set j0 := Nat.find hK with hj0def
    have hj0 : PowerSeries.coeff j0 V ∉ IsLocalRing.maximalIdeal A ^ (K + 1) := Nat.find_spec hK
    have hmin : ∀ b, b < j0 → PowerSeries.coeff b V ∈ IsLocalRing.maximalIdeal A ^ (K + 1) := by
      intro b hb
      have := Nat.find_min hK hb
      push_neg at this
      exact this
    have hc : PowerSeries.coeff (j0 + 1) (U * V) = 0 := by
      rw [hUV, PowerSeries.coeff_C]; simp
    have hmemj0 : ((0 : ℕ), j0) ∈ Finset.HasAntidiagonal.antidiagonal j0 :=
      Finset.HasAntidiagonal.mem_antidiagonal.mpr (by simp)
    rw [PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_succ,
      ← Finset.add_sum_erase _ _ hmemj0] at hc
    simp only [zero_add] at hc
    have ht1 : PowerSeries.coeff 0 U * PowerSeries.coeff (j0 + 1) V ∈
        IsLocalRing.maximalIdeal A ^ (K + 1) := by
      rw [pow_succ']
      apply Ideal.mul_mem_mul
      · rw [PowerSeries.coeff_zero_eq_constantCoeff_apply]; exact hU0
      · exact hallK _
    have hrest : ∑ p ∈ (Finset.HasAntidiagonal.antidiagonal j0).erase (0, j0),
        PowerSeries.coeff (p.1 + 1) U * PowerSeries.coeff p.2 V ∈
        IsLocalRing.maximalIdeal A ^ (K + 1) := by
      apply Ideal.sum_mem
      intro p hp
      rw [Finset.mem_erase, Finset.HasAntidiagonal.mem_antidiagonal] at hp
      obtain ⟨hpne, hpsum⟩ := hp
      have hp1 : p.1 ≠ 0 := by
        intro h1
        apply hpne
        ext
        · exact h1
        · simp only; omega
      exact Ideal.mul_mem_left _ _ (hmin _ (by omega))
    have hprod : PowerSeries.coeff 1 U * PowerSeries.coeff j0 V =
        -(PowerSeries.coeff 0 U * PowerSeries.coeff (j0 + 1) V +
          ∑ p ∈ (Finset.HasAntidiagonal.antidiagonal j0).erase (0, j0),
            PowerSeries.coeff (p.1 + 1) U * PowerSeries.coeff p.2 V) := by
      linear_combination hc
    have hprodm : PowerSeries.coeff 1 U * PowerSeries.coeff j0 V ∈
        IsLocalRing.maximalIdeal A ^ (K + 1) := by
      rw [hprod]; exact neg_mem (Ideal.add_mem _ ht1 hrest)
    obtain ⟨w, hw⟩ := hU1
    have hv : PowerSeries.coeff j0 V =
        ↑w⁻¹ * (PowerSeries.coeff 1 U * PowerSeries.coeff j0 V) := by
      rw [← hw, ← mul_assoc, Units.inv_mul, one_mul]
    exact hj0 (by rw [hv]; exact Ideal.mul_mem_left _ _ hprodm)

  have hFne : (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h :
      MvPowerSeries (Fin 2) A) ≠ 0 := by
    intro h'
    rw [h', map_zero] at hF0
    exact h0 (neg_eq_zero.mp hF0.symm)
  have hFnu : ¬ IsUnit (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h :
      MvPowerSeries (Fin 2) A) := by
    rw [MvPowerSeries.isUnit_iff_constantCoeff, hF0]; exact hnhnu

  have hc0 : ∀ W : MvPowerSeries (Fin 2) A, PowerSeries.constantCoeff
      (PowerSeries.mk (fun i => MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) i) W)) =
      MvPowerSeries.constantCoeff W := by
    intro W
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_mk, Finsupp.single_zero,
      MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
  have hc1 : ∀ W : MvPowerSeries (Fin 2) A, PowerSeries.coeff 1
      (PowerSeries.mk (fun i => MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) i) W)) =
      MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1) W := by
    intro W
    rw [PowerSeries.coeff_mk]
  have hcm : ∀ W : MvPowerSeries (Fin 2) A, ¬ IsUnit W →
      MvPowerSeries.constantCoeff W ∈ IsLocalRing.maximalIdeal A := by
    intro W hW
    rw [hmem]
    intro hu
    exact hW (MvPowerSeries.isUnit_iff_constantCoeff.mpr hu)
  have hCneg : ∀ (Z : PowerSeries A), Z = 0 → PowerSeries.mk
      (fun i => MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) i) (MvPowerSeries.X 0 *
        MvPowerSeries.X 1 - MvPowerSeries.C h : MvPowerSeries (Fin 2) A)) ≠ 0 := by
    intro _ _ h'
    rw [hFax 0] at h'
    have := congrArg (PowerSeries.coeff 0) h'
    rw [PowerSeries.coeff_C, if_pos rfl, map_zero] at this
    exact h0 (neg_eq_zero.mp this)
  have hirr : Irreducible (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h :
      MvPowerSeries (Fin 2) A) := by
    refine irreducible_iff.mpr ⟨hFnu, ?_⟩
    intro U V hUV
    by_contra hcon
    push_neg at hcon
    obtain ⟨hU, hV⟩ := hcon
    have hu := hcm U hU
    have hv := hcm V hV
    have hcoef := coeff_e U V
    rw [← hUV, hFe] at hcoef
    have hx : MvPowerSeries.constantCoeff U *
          MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) V +
        MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) U *
          MvPowerSeries.constantCoeff V ∈ IsLocalRing.maximalIdeal A :=
      Ideal.add_mem _ (Ideal.mul_mem_right _ _ hu) (Ideal.mul_mem_left _ _ hv)
    have hsum : IsUnit (MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1) U *
          MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) 1) V +
        MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) 1) U *
          MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1) V) := by
      by_contra hn
      apply hmne
      rw [Ideal.eq_top_iff_one, hcoef, add_assoc]
      exact Ideal.add_mem _ hx ((hmem _).mpr hn)
    have hor : IsUnit (MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1) U *
          MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) 1) V) ∨
        IsUnit (MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) 1) U *
          MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1) V) := by
      by_contra hn
      push_neg at hn
      exact (IsLocalRing.nonunits_add hn.1 hn.2) hsum
    have hax := axis_mul 0 U V
    rw [← hUV] at hax
    rcases hor with h1 | h1
    · have hU10 := isUnit_of_mul_isUnit_left h1
      have hz := no_const _ _ (-h) (by rw [hc0]; exact hu) (by rw [hc1]; exact hU10)
        (by rw [← hax, hFax 0])
      rw [hz, mul_zero] at hax
      exact hCneg 0 rfl hax
    · have hV10 := isUnit_of_mul_isUnit_right h1
      have hz := no_const _ _ (-h) (by rw [hc0]; exact hv) (by rw [hc1]; exact hV10)
        (by rw [mul_comm, ← hax, hFax 0])
      rw [hz, zero_mul] at hax
      exact hCneg 0 rfl hax

  have hprime : Prime (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h :
      MvPowerSeries (Fin 2) A) := UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr
  have hIP := (Ideal.span_singleton_prime hFne).mpr hprime

  have hX : ∀ σ : Fin 2, (MvPowerSeries.X σ : MvPowerSeries (Fin 2) A) ∉
      Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h} := by
    intro σ hσ
    obtain ⟨G, hG⟩ := Ideal.mem_span_singleton'.mp hσ
    have hax := axis_mul σ G (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h)
    rw [hG, hFax σ] at hax
    have h1 := congrArg (PowerSeries.coeff 1) hax
    rw [PowerSeries.coeff_mk, PowerSeries.coeff_mul_C, MvPowerSeries.coeff_X, if_pos rfl] at h1
    apply hhnu
    exact IsUnit.of_mul_eq_one (-(PowerSeries.coeff 1
      (PowerSeries.mk (fun i => MvPowerSeries.coeff (Finsupp.single σ i) G)))) (by linear_combination -h1)

  obtain ⟨ψ, hψX0, hψX1, hψC⟩ : ∃ ψ : MvPowerSeries ℕ A →+* MvPowerSeries (Fin 2) A,
      ψ (MvPowerSeries.X 0) = MvPowerSeries.X 0 ∧ ψ (MvPowerSeries.X 1) = MvPowerSeries.X 1 ∧
      ∀ a : A, ψ (MvPowerSeries.C a) = MvPowerSeries.C a := by
    have hasSub : MvPowerSeries.HasSubst (fun n : ℕ => if n = 0 then
        (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) A) else if n = 1 then MvPowerSeries.X 1 else 0) := by
      refine MvPowerSeries.HasSubst.mk (fun s => ?_) (fun d => ?_)
      · split_ifs <;> simp only [MvPowerSeries.constantCoeff_X, map_zero] <;> exact IsNilpotent.zero
      · apply (Set.finite_le_nat 1).subset
        intro s hs
        simp only [Set.mem_setOf_eq] at hs ⊢
        by_contra hlt
        apply hs
        rw [if_neg (by omega), if_neg (by omega), map_zero]
    refine ⟨(MvPowerSeries.substAlgHom (R := A) hasSub).toRingHom, ?_, ?_, ?_⟩
    · show MvPowerSeries.substAlgHom hasSub _ = _
      rw [MvPowerSeries.substAlgHom_apply, MvPowerSeries.subst_X hasSub]
      simp
    · show MvPowerSeries.substAlgHom hasSub _ = _
      rw [MvPowerSeries.substAlgHom_apply, MvPowerSeries.subst_X hasSub]
      simp
    · intro a
      show MvPowerSeries.substAlgHom hasSub _ = _
      rw [MvPowerSeries.substAlgHom_apply, MvPowerSeries.subst_C]
  have hψF : ψ (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h : MvPowerSeries ℕ A) =
      (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h : MvPowerSeries (Fin 2) A) := by
    rw [map_sub, map_mul, hψX0, hψX1, hψC]
  refine ⟨(Ideal.Quotient.isDomain_iff_prime _).mpr hIP, ?_, ?_, ?_⟩
  · intro a ha
    obtain ⟨G, hG⟩ := Ideal.mem_span_singleton'.mp ha
    have hG' := congrArg ψ hG
    rw [map_mul, hψF, hψC] at hG'
    exact (wcpa_dj_stc_tu_const_inj A h hm).1 a
      (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton'.mpr ⟨ψ G, hG'⟩))
  · intro hσ
    obtain ⟨G, hG⟩ := Ideal.mem_span_singleton'.mp hσ
    have hG' := congrArg ψ hG
    rw [map_mul, hψF, hψX0] at hG'
    exact hX 0 (Ideal.mem_span_singleton'.mpr ⟨ψ G, hG'⟩)
  · intro hσ
    obtain ⟨G, hG⟩ := Ideal.mem_span_singleton'.mp hσ
    have hG' := congrArg ψ hG
    rw [map_mul, hψF, hψX1] at hG'
    exact hX 1 (Ideal.mem_span_singleton'.mpr ⟨ψ G, hG'⟩)

theorem nccwff_model_rings_normal : ∀ (R : Type u) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R →
    (IsDomain (PowerSeries R) ∧ IsIntegrallyClosed (PowerSeries R)) ∧
    ∀ c : R, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal R →
      IsDomain (nccwffQ R c) ∧ IsIntegrallyClosed (nccwffQ R c) :=
by
  intro R _ _ _ hcomp
  classical

  have s1 : ∀ (T : Type u) [CommRing T] [IsDomain T] (w : T), w ≠ 0 →
      (∀ (r : T) (m : ℕ), 0 < m → r ^ m ∈ Ideal.span {w} → r ∈ Ideal.span {w}) →
      (∀ (q : Ideal T) [q.IsPrime], w ∉ q → IsIntegrallyClosed (Localization.AtPrime q)) →
      IsIntegrallyClosed T := by
    intro T _ _ w hw hrad hloc

    have H1 : ∀ (L : Type u) [Field L] [Algebra T L], Function.Injective (algebraMap T L) →
        ∀ (a b : T) (p : Polynomial T), b ≠ 0 →
        (Polynomial.eval₂ (algebraMap T L) (algebraMap T L a / algebraMap T L b) p = 0 ↔
          Polynomial.eval a (p.scaleRoots b) = 0) := by
      intro L _ _ hinj a b p hb
      have hb' : algebraMap T L b ≠ 0 := by
        intro h; exact hb (hinj (h.trans (map_zero _).symm))
      have key := Polynomial.scaleRoots_eval₂_mul (p := p) (algebraMap T L)
        (algebraMap T L a / algebraMap T L b) b
      rw [mul_div_cancel₀ _ hb', Polynomial.eval₂_at_apply] at key
      constructor
      · intro h
        rw [h, mul_zero] at key
        exact hinj (key.trans (map_zero _).symm)
      · intro h
        rw [h, map_zero] at key
        exact (mul_eq_zero.mp key.symm).resolve_left (pow_ne_zero _ hb')
    have H1' : ∀ (L : Type u) [Field L] (φ : T →+* L), Function.Injective φ →
        ∀ (a b : T) (p : Polynomial T), b ≠ 0 →
        (Polynomial.eval₂ φ (φ a / φ b) p = 0 ↔ Polynomial.eval a (p.scaleRoots b) = 0) := by
      intro L _ φ hinj a b p hb
      letI : Algebra T L := φ.toAlgebra
      exact H1 L hinj a b p hb

    have H2 : ∀ (g : Polynomial T) (r : T), g.Monic →
        Polynomial.eval r (g.scaleRoots w) = 0 → r ^ g.natDegree ∈ Ideal.span {w} := by
      intro g r hg h
      rw [Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots,
        Finset.sum_range_succ, Polynomial.coeff_scaleRoots, Nat.sub_self, pow_zero, mul_one] at h
      have hlc : g.coeff g.natDegree = 1 := hg
      rw [hlc, one_mul] at h
      have hr : r ^ g.natDegree = -∑ i ∈ Finset.range g.natDegree,
          (g.scaleRoots w).coeff i * r ^ i := by
        rw [eq_neg_iff_add_eq_zero, add_comm]; exact h
      rw [hr]
      refine neg_mem (Ideal.sum_mem _ (fun i hi => ?_))
      rw [Polynomial.coeff_scaleRoots]
      have hi' : g.natDegree - i ≠ 0 := by
        have := Finset.mem_range.mp hi; omega
      apply Ideal.mul_mem_right
      apply Ideal.mul_mem_left
      rw [Ideal.mem_span_singleton]
      exact dvd_pow_self w hi'

    have H3 : ∀ (L : Type u) [Field L] [Algebra T L] (y : L) (g : Polynomial T), g.Monic →
        Polynomial.eval₂ (algebraMap T L) y g = 0 → 0 < g.natDegree := by
      intro L _ _ y g hg h
      refine (Polynomial.Monic.natDegree_pos hg).mpr ?_
      rintro rfl
      rw [Polynomial.eval₂_one] at h
      exact one_ne_zero h
    let K := FractionRing T
    have hinjK : Function.Injective (algebraMap T K) := IsFractionRing.injective T K
    rw [isIntegrallyClosed_iff K]
    intro x hx
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective T x
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    have hbK : algebraMap T K b ≠ 0 := by
      intro h; exact hb0 (hinjK (h.trans (map_zero _).symm))
    obtain ⟨p, hpm, hp⟩ := hx
    have hE : Polynomial.eval a (p.scaleRoots b) = 0 := (H1 K hinjK a b p hb0).mp hp

    let J : Ideal T :=
      { carrier := {t | b ∣ t * a}
        add_mem' := fun {s t} hs ht => by
          show b ∣ (s + t) * a
          rw [add_mul]; exact dvd_add hs ht
        zero_mem' := by show b ∣ 0 * a; rw [zero_mul]; exact dvd_zero b
        smul_mem' := fun c t ht => by
          show b ∣ (c * t) * a
          rw [mul_assoc]; exact dvd_mul_of_dvd_right ht c }
    have hJ : ∀ t, t ∈ J ↔ b ∣ t * a := fun t => Iff.rfl

    have hG : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] (α : T →+* A),
        Function.Injective α → ∃ s : A, s * α b = α a := by
      intro A _ _ _ α hα
      let L := FractionRing A
      have hβ : Function.Injective (algebraMap A L) := IsFractionRing.injective A L
      have hγ : Function.Injective ((algebraMap A L).comp α) := hβ.comp hα
      have hy := (H1' L ((algebraMap A L).comp α) hγ a b p hb0).mpr hE
      have hint : IsIntegral A ((algebraMap A L) (α a) / (algebraMap A L) (α b)) := by
        refine ⟨p.map α, hpm.map α, ?_⟩
        rw [Polynomial.eval₂_map]
        exact hy
      obtain ⟨s, hs⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
      have hbL : algebraMap A L (α b) ≠ 0 := by
        intro h; exact hb0 (hγ (h.trans (map_zero _).symm))
      refine ⟨s, hβ ?_⟩
      rw [map_mul, hs, div_mul_cancel₀ _ hbL]
    have hc : ∀ (q : Ideal T) [q.IsPrime], w ∉ q → ∃ u ∈ J, u ∉ q := by
      intro q _ hwq
      haveI := hloc q hwq
      have hα : Function.Injective (algebraMap T (Localization.AtPrime q)) :=
        IsLocalization.injective (Localization.AtPrime q) q.primeCompl_le_nonZeroDivisors
      obtain ⟨s, hs⟩ := hG (Localization.AtPrime q) (algebraMap T (Localization.AtPrime q)) hα
      obtain ⟨⟨t, u⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl s
      have h3 : algebraMap T (Localization.AtPrime q) (t * b) =
          algebraMap T (Localization.AtPrime q) (u * a) := by
        have hspec := IsLocalization.mk'_spec (Localization.AtPrime q) t u
        simp only at hs
        rw [map_mul, map_mul, ← hspec, ← hs]
        ring
      have h4 := hα h3
      refine ⟨u, ?_, u.2⟩
      rw [hJ]
      exact ⟨t, by rw [← h4, mul_comm]⟩

    have hd : ∃ N : ℕ, w ^ N ∈ J := by
      by_contra hcon
      push_neg at hcon
      have hdisj : Disjoint (J : Set T) (Submonoid.powers w : Set T) := by
        rw [Set.disjoint_left]
        rintro t htJ ⟨N, rfl⟩
        exact hcon N htJ
      obtain ⟨q, hq, hJq, hqd⟩ := Ideal.exists_le_prime_disjoint J (Submonoid.powers w) hdisj
      have hwq : w ∉ q := by
        intro h
        exact Set.disjoint_left.mp hqd h (Submonoid.mem_powers w)
      obtain ⟨u, huJ, huq⟩ := hc q hwq
      exact huq (hJq huJ)

    have he : ∀ N : ℕ, w ^ N ∈ J → ∃ y, algebraMap T K y = algebraMap T K a / algebraMap T K b := by
      intro N
      induction N with
      | zero =>
        intro h0
        rw [hJ, pow_zero, one_mul] at h0
        obtain ⟨s, hs⟩ := h0
        refine ⟨s, ?_⟩
        rw [hs, map_mul, mul_div_cancel_left₀ _ hbK]
      | succ N ih =>
        intro hN
        apply ih
        rw [hJ] at hN
        obtain ⟨r, hr⟩ := hN
        have hwK : algebraMap T K w ≠ 0 := by
          intro h; exact hw (hinjK (h.trans (map_zero _).symm))
        have hrw : algebraMap T K r / algebraMap T K w =
            algebraMap T K (w ^ N) * (algebraMap T K a / algebraMap T K b) := by
          rw [div_eq_iff hwK]
          have hr' := congrArg (algebraMap T K) hr
          rw [map_mul, map_mul, map_pow] at hr'
          calc algebraMap T K r = (algebraMap T K b * algebraMap T K r) / algebraMap T K b :=
                (mul_div_cancel_left₀ _ hbK).symm
            _ = (algebraMap T K w ^ (N + 1) * algebraMap T K a) / algebraMap T K b := by rw [hr']
            _ = algebraMap T K (w ^ N) * (algebraMap T K a / algebraMap T K b) *
                  algebraMap T K w := by rw [map_pow]; ring
        have hint : IsIntegral T (algebraMap T K r / algebraMap T K w) := by
          rw [hrw]
          exact IsIntegral.mul isIntegral_algebraMap ⟨p, hpm, hp⟩
        obtain ⟨g, hgm, hg⟩ := hint
        have hdeg := H3 K _ g hgm hg
        have hE' := (H1 K hinjK r w g hw).mp hg
        have hrm := hrad r _ hdeg (H2 g r hgm hE')
        obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp hrm
        rw [hJ]
        refine ⟨s, ?_⟩
        apply mul_left_cancel₀ hw
        rw [← hs] at hr
        calc w * (w ^ N * a) = w ^ (N + 1) * a := by ring
          _ = b * (s * w) := hr
          _ = w * (b * s) := by ring
    obtain ⟨N, hN⟩ := hd
    exact he N hN

  have s2 : ∀ (ϖ : R), IsLocalRing.maximalIdeal R = Ideal.span {ϖ} → ∀ (n : ℕ), 0 < n →
      ∀ (r : MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n)})
        (m : ℕ), 0 < m →
      r ^ m ∈ Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n)}) (MvPowerSeries.C ϖ)} →
      r ∈ Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n)}) (MvPowerSeries.C ϖ)} := by
    intro ϖ hmax n hn r m hm hr
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [← map_pow] at hr
    set f : MvPowerSeries (Fin 2) R := MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n) with hf
    set I : Ideal (MvPowerSeries (Fin 2) R) := Ideal.span {f} with hI
    set k := IsLocalRing.ResidueField R
    set res := IsLocalRing.residue R
    have hϖm : ϖ ∈ IsLocalRing.maximalIdeal R := by rw [hmax]; exact Ideal.mem_span_singleton_self ϖ
    have hresϖ : res ϖ = 0 := (IsLocalRing.residue_eq_zero_iff ϖ).mpr hϖm

    have hφ : ∀ i : Fin 2, ∃ φ : MvPowerSeries (Fin 2) R →+* PowerSeries k,
        ∀ g (j : ℕ), PowerSeries.coeff j (φ g) = res (MvPowerSeries.coeff (Finsupp.single i j) g) := by
      intro i
      let φ : MvPowerSeries (Fin 2) R →+* PowerSeries k :=
        { toFun := fun g => PowerSeries.mk (fun j => res (MvPowerSeries.coeff (Finsupp.single i j) g))
          map_one' := by
            ext j
            rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_one, PowerSeries.coeff_one]
            by_cases hj : j = 0
            · subst hj; simp
            · rw [if_neg hj, if_neg (by rwa [Finsupp.single_eq_zero]), map_zero]
          map_mul' := by
            intro a b
            ext j
            rw [PowerSeries.coeff_mk, PowerSeries.coeff_mul, MvPowerSeries.coeff_mul,
              Finsupp.antidiagonal_single, Finset.sum_map, map_sum]
            refine Finset.sum_congr rfl (fun p _ => ?_)
            simp [PowerSeries.coeff_mk]
          map_zero' := by ext j; simp
          map_add' := by intro a b; ext j; simp }
      exact ⟨φ, fun g j => PowerSeries.coeff_mk (R := k) j
        (fun j => res (MvPowerSeries.coeff (Finsupp.single i j) g))⟩
    obtain ⟨φ0, hφ0⟩ := hφ 0
    obtain ⟨φ1, hφ1⟩ := hφ 1
    have hφC : ∀ (φ : MvPowerSeries (Fin 2) R →+* PowerSeries k) (i : Fin 2),
        (∀ g (j : ℕ), PowerSeries.coeff j (φ g) = res (MvPowerSeries.coeff (Finsupp.single i j) g)) →
        φ (MvPowerSeries.C ϖ) = 0 := by
      intro φ i hφi
      ext j
      rw [hφi, MvPowerSeries.coeff_C, map_zero]
      split_ifs
      · exact hresϖ
      · exact map_zero _
    have hφX : ∀ (φ : MvPowerSeries (Fin 2) R →+* PowerSeries k) (i i' : Fin 2), i ≠ i' →
        (∀ g (j : ℕ), PowerSeries.coeff j (φ g) = res (MvPowerSeries.coeff (Finsupp.single i j) g)) →
        φ (MvPowerSeries.X i') = 0 := by
      intro φ i i' hii' hφi
      ext j
      rw [hφi, MvPowerSeries.coeff_X, map_zero]
      rw [if_neg]
      · exact map_zero _
      · intro h
        have := congrArg (fun m => m i') h
        simp only [Finsupp.single_apply, if_neg hii', if_pos rfl] at this
        exact absurd this (by norm_num)
    have hφf : ∀ (φ : MvPowerSeries (Fin 2) R →+* PowerSeries k),
        φ (MvPowerSeries.C ϖ) = 0 → (φ (MvPowerSeries.X 0) = 0 ∨ φ (MvPowerSeries.X 1) = 0) →
        φ f = 0 := by
      intro φ hC hX
      have hCn : MvPowerSeries.C (ϖ ^ n) = (MvPowerSeries.C ϖ : MvPowerSeries (Fin 2) R) ^ n := map_pow _ _ _
      rw [hf, map_sub, map_mul, hCn, map_pow, hC, zero_pow hn.ne']
      rcases hX with h | h <;> rw [h] <;> ring
    have hC0 := hφC φ0 0 hφ0
    have hC1 := hφC φ1 1 hφ1
    have hf0 := hφf φ0 hC0 (Or.inr (hφX φ0 0 1 (by decide) hφ0))
    have hf1 := hφf φ1 hC1 (Or.inl (hφX φ1 1 0 (by decide) hφ1))

    have hnec : ∀ (φ : MvPowerSeries (Fin 2) R →+* PowerSeries k), φ (MvPowerSeries.C ϖ) = 0 → φ f = 0 →
        ∀ g, Ideal.Quotient.mk I g ∈ Ideal.span {Ideal.Quotient.mk I (MvPowerSeries.C ϖ)} → φ g = 0 := by
      intro φ hC hF g hg
      obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hg
      obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective a
      rw [← map_mul, Ideal.Quotient.eq, hI, Ideal.mem_span_singleton'] at ha
      obtain ⟨c, hc⟩ := ha
      have := congrArg φ hc
      rw [map_mul, hF, mul_zero, map_sub, map_mul, hC, mul_zero, zero_sub, eq_comm, neg_eq_zero] at this
      exact this

    have hsuf : ∀ g, φ0 g = 0 → φ1 g = 0 →
        Ideal.Quotient.mk I g ∈ Ideal.span {Ideal.Quotient.mk I (MvPowerSeries.C ϖ)} := by
      intro g hg0 hg1
      have hax : ∀ mm : Fin 2 →₀ ℕ, (mm 0 = 0 ∨ mm 1 = 0) →
          MvPowerSeries.coeff mm g ∈ Ideal.span {ϖ} := by
        intro mm hmm
        rw [← hmax, ← IsLocalRing.residue_eq_zero_iff]
        rcases hmm with h | h
        · have e : mm = Finsupp.single 1 (mm 1) := by
            ext j; fin_cases j <;> simp [h]
          rw [e, ← hφ1, hg1, map_zero]
        · have e : mm = Finsupp.single 0 (mm 0) := by
            ext j; fin_cases j <;> simp [h]
          rw [e, ← hφ0, hg0, map_zero]
      let h₁ : MvPowerSeries (Fin 2) R := fun mm =>
        if hmm : (mm 0 = 0 ∨ mm 1 = 0) then Classical.choose (Ideal.mem_span_singleton'.mp (hax mm hmm))
        else 0
      set g' := g - MvPowerSeries.C ϖ * h₁ with hg'
      have hg'ax : ∀ mm : Fin 2 →₀ ℕ, (mm 0 = 0 ∨ mm 1 = 0) → MvPowerSeries.coeff mm g' = 0 := by
        intro mm hmm
        rw [hg', map_sub, MvPowerSeries.coeff_C_mul]
        have hc : MvPowerSeries.coeff mm h₁ =
            Classical.choose (Ideal.mem_span_singleton'.mp (hax mm hmm)) := by
          show h₁ mm = _
          simp only [h₁, dif_pos hmm]
        rw [hc, mul_comm, Classical.choose_spec (Ideal.mem_span_singleton'.mp (hax mm hmm)), sub_self]
      have hX0 : MvPowerSeries.X 0 ∣ g' := by
        rw [MvPowerSeries.X_dvd_iff]
        intro mm hmm
        exact hg'ax mm (Or.inl hmm)
      obtain ⟨g'', hg''⟩ := hX0
      have hXcoeff : ∀ (s : Fin 2) (mm : Fin 2 →₀ ℕ) (ψ : MvPowerSeries (Fin 2) R),
          MvPowerSeries.coeff (mm + Finsupp.single s 1) (MvPowerSeries.X s * ψ) = MvPowerSeries.coeff mm ψ := by
        intro s mm ψ
        rw [MvPowerSeries.X, MvPowerSeries.coeff_monomial_mul, if_pos le_add_self, one_mul,
          add_tsub_cancel_right]
      have hX1 : MvPowerSeries.X 1 ∣ g'' := by
        rw [MvPowerSeries.X_dvd_iff]
        intro mm hmm
        rw [← hXcoeff 0 mm g'', ← hg'']
        apply hg'ax
        right
        simp [hmm]
      obtain ⟨h₂, hh₂⟩ := hX1
      have hdecomp : g = MvPowerSeries.C ϖ * h₁ + f * h₂ + MvPowerSeries.C ϖ ^ n * h₂ := by
        have : g = g' + MvPowerSeries.C ϖ * h₁ := by rw [hg']; ring
        rw [this, hg'', hh₂, hf, map_pow]
        ring
      have hmkf : Ideal.Quotient.mk I f = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f)
      rw [Ideal.mem_span_singleton']
      refine ⟨Ideal.Quotient.mk I h₁ + Ideal.Quotient.mk I (MvPowerSeries.C ϖ) ^ (n - 1) *
        Ideal.Quotient.mk I h₂, ?_⟩
      rw [hdecomp, map_add, map_add, map_mul, map_mul, hmkf, map_mul, map_pow]
      obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
      rw [Nat.add_sub_cancel]
      ring
    have e0 := hnec φ0 hC0 hf0 _ hr
    have e1 := hnec φ1 hC1 hf1 _ hr
    rw [map_pow] at e0 e1
    exact hsuf g (pow_eq_zero_iff hm.ne' |>.mp e0) (pow_eq_zero_iff hm.ne' |>.mp e1)
  refine ⟨⟨inferInstance, ?_⟩, ?_⟩
  ·
    haveI := (nccwff_powerseries_props R hcomp).2.2.1
    obtain ⟨_, hufd⟩ := wc_fco_regular_local_ufd (PowerSeries R)
    haveI := hufd
    exact UniqueFactorizationMonoid.instIsIntegrallyClosed
  ·
    intro c hc0 hcm
    refine ⟨(wcpa_dj_stc_kmnb_xy_domain R c hcm hc0).1, ?_⟩
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    obtain ⟨e, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc0 hϖ
    have hmax : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have he : 0 < e := by
      rcases Nat.eq_zero_or_pos e with h | h
      · exfalso
        subst h
        rw [pow_zero, mul_one] at hcm
        exact (IsLocalRing.mem_maximalIdeal _).mp hcm v.isUnit
      · exact h
    have hϖm : ϖ ∈ IsLocalRing.maximalIdeal R := by
      rw [hmax]; exact Ideal.mem_span_singleton_self ϖ
    have hϖe : ϖ ^ e ∈ IsLocalRing.maximalIdeal R := Ideal.pow_mem_of_mem _ hϖm e he
    have hϖ0 : ϖ ≠ 0 := hϖ.ne_zero
    have hϖe0 : ϖ ^ e ≠ 0 := pow_ne_zero e hϖ0
    obtain ⟨hdomT, hCinj, -, -⟩ := wcpa_dj_stc_kmnb_xy_domain R (ϖ ^ e) hϖe hϖe0
    haveI := hdomT

    have hlocF : ∀ z : fexaAA R ϖ e, IsUnit z ∨
        z ∈ Ideal.span {fexaW R ϖ e, fexaX R ϖ e, fexaY R ϖ e} := by
      intro z
      obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective z
      by_cases hu : IsUnit (MvPowerSeries.constantCoeff g)
      · left
        exact (MvPowerSeries.isUnit_iff_constantCoeff.mpr hu).map _
      · right
        have hc0m : MvPowerSeries.constantCoeff g ∈ IsLocalRing.maximalIdeal R :=
          (IsLocalRing.mem_maximalIdeal _).mpr hu
        rw [hmax] at hc0m
        obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hc0m
        set g' := g - MvPowerSeries.C (MvPowerSeries.constantCoeff g) with hg'
        have hg'0 : ∀ mm : Fin 2 →₀ ℕ, mm 0 = 0 → mm 1 = 0 → MvPowerSeries.coeff mm g' = 0 := by
          intro mm h0 h1
          have hmm : mm = 0 := by
            ext j; fin_cases j <;> simp [h0, h1]
          subst hmm
          rw [hg', map_sub, MvPowerSeries.coeff_C, if_pos rfl,
            MvPowerSeries.coeff_zero_eq_constantCoeff_apply, sub_self]
        let P : MvPowerSeries (Fin 2) R := fun mm => if mm 0 = 0 then MvPowerSeries.coeff mm g' else 0
        have hX0 : MvPowerSeries.X 0 ∣ g' - P := by
          rw [MvPowerSeries.X_dvd_iff]
          intro mm hmm
          rw [map_sub]
          show MvPowerSeries.coeff mm g' - (if mm 0 = 0 then MvPowerSeries.coeff mm g' else 0) = 0
          rw [if_pos hmm, sub_self]
        have hX1 : MvPowerSeries.X 1 ∣ P := by
          rw [MvPowerSeries.X_dvd_iff]
          intro mm hmm
          show (if mm 0 = 0 then MvPowerSeries.coeff mm g' else 0) = 0
          split_ifs with h0
          · exact hg'0 mm h0 hmm
          · rfl
        obtain ⟨A, hA⟩ := hX0
        obtain ⟨B, hB⟩ := hX1
        have hg : g = MvPowerSeries.C a * MvPowerSeries.C ϖ + MvPowerSeries.X 0 * A +
            MvPowerSeries.X 1 * B := by
          rw [← map_mul, ha, ← hA, ← hB, hg']
          ring
        rw [hg, map_add, map_add, map_mul, map_mul, map_mul]
        refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_
        · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _))
        · exact Ideal.mul_mem_right _ _
            (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))
        · exact Ideal.mul_mem_right _ _
            (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
    have hTic : IsIntegrallyClosed (MvPowerSeries (Fin 2) R ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ e)}) := by
      refine s1 (MvPowerSeries (Fin 2) R ⧸
          Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ e)})
        (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
          MvPowerSeries.C (ϖ ^ e) : MvPowerSeries (Fin 2) R)}) (MvPowerSeries.C ϖ)) ?_
        (s2 ϖ hmax e he) ?_
      · intro h
        have hXnot : ∀ i j : Fin 2, i ≠ j →
            Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
              MvPowerSeries.C (ϖ ^ e) : MvPowerSeries (Fin 2) R)}) (MvPowerSeries.X i) ≠ 0 := by
          intro i j hij hX
          rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hX
          obtain ⟨c, hc⟩ := hX
          have hfx : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) R) =
              MvPowerSeries.X j * MvPowerSeries.X i := by
            fin_cases i <;> fin_cases j <;> simp at hij ⊢ <;> ring
          have hcoef := congrArg (MvPowerSeries.coeff (Finsupp.single i 1)) hc
          rw [mul_sub, hfx, map_sub, MvPowerSeries.coeff_X, if_pos rfl,
            mul_comm c (MvPowerSeries.C (ϖ ^ e)), MvPowerSeries.coeff_C_mul] at hcoef
          have hz : MvPowerSeries.coeff (Finsupp.single i 1)
              (c * (MvPowerSeries.X j * MvPowerSeries.X i)) = 0 := by
            have hd : MvPowerSeries.X j ∣ c * (MvPowerSeries.X j * MvPowerSeries.X i) :=
              ⟨c * MvPowerSeries.X i, by ring⟩
            rw [MvPowerSeries.X_dvd_iff] at hd
            exact hd _ (by simp [Finsupp.single_apply, hij])
          rw [hz, zero_sub] at hcoef
          have hunit : IsUnit (ϖ ^ e) := by
            refine isUnit_iff_exists_inv.mpr ⟨-(MvPowerSeries.coeff (Finsupp.single i 1) c), ?_⟩
            rw [mul_neg]
            exact hcoef
          exact (IsLocalRing.mem_maximalIdeal _).mp hϖe hunit
        have hxy : Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
              MvPowerSeries.C (ϖ ^ e) : MvPowerSeries (Fin 2) R)}) (MvPowerSeries.X 0) *
            Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
              MvPowerSeries.C (ϖ ^ e) : MvPowerSeries (Fin 2) R)}) (MvPowerSeries.X 1) = 0 := by
          rw [← map_mul]
          have hrel : Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
              MvPowerSeries.C (ϖ ^ e) : MvPowerSeries (Fin 2) R)})
              (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ e)) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
          rw [map_sub, sub_eq_zero] at hrel
          have hpow : Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
              MvPowerSeries.C (ϖ ^ e) : MvPowerSeries (Fin 2) R)}) (MvPowerSeries.C (ϖ ^ e)) =
              (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
              MvPowerSeries.C (ϖ ^ e) : MvPowerSeries (Fin 2) R)}) (MvPowerSeries.C ϖ)) ^ e :=
            (congrArg (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
              MvPowerSeries.C (ϖ ^ e) : MvPowerSeries (Fin 2) R)}))
              (map_pow MvPowerSeries.C ϖ e)).trans (map_pow _ _ _)
          rw [hrel, hpow, h, zero_pow he.ne']
        rcases mul_eq_zero.mp hxy with h0 | h1
        · exact hXnot 0 1 (by decide) h0
        · exact hXnot 1 0 (by decide) h1
      · intro q _ hq
        haveI : IsRegularLocalRing (Localization.AtPrime q) :=
          fexa_offcenter_regular R ϖ hϖ e he hlocF q hq
        obtain ⟨hd, hufd⟩ := wc_fco_regular_local_ufd (Localization.AtPrime q)
        haveI := hd
        haveI := hufd
        exact UniqueFactorizationMonoid.instIsIntegrallyClosed
    obtain ⟨Φ, -⟩ := wcpa_dj_mn_rescale R v (ϖ ^ e)
    exact IsIntegrallyClosed.of_equiv Φ.symm

theorem wcpa_dj_nccw_ebn_xy_sub_c_normal : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ c : R, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal R → IsDomain (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}) ∧ IsIntegrallyClosed (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}) :=
by
  intro R _ _ _ hR c hc0 hc
  exact (nccwff_model_rings_normal R hR).2 c hc0 hc

theorem wcpa_dj_stc_ktc_compl_lift : ∀ (R T : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [CommRing T] [IsLocalRing T], IsAdicComplete (IsLocalRing.maximalIdeal T) T → ∀ (f : R →+* T), IsLocalHom f → ∃ fh : AdicCompletion (IsLocalRing.maximalIdeal R) R →+* T, IsLocalHom fh ∧ fh.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) = f :=
by
  intro R T _ _ _ _ _ hT f hf
  haveI := hT
  have hmn : IsLocalRing.maximalIdeal R ≤ Ideal.comap f (IsLocalRing.maximalIdeal T) :=
    Ideal.map_le_iff_le_comap.mp (IsLocalRing.map_maximalIdeal_le f)
  have hk : ∀ k : ℕ, IsLocalRing.maximalIdeal R ^ k ≤
      Ideal.comap f (IsLocalRing.maximalIdeal T ^ k) := fun k =>
    (Ideal.pow_right_mono hmn k).trans (Ideal.le_comap_pow f k)
  let g : ∀ k : ℕ, AdicCompletion (IsLocalRing.maximalIdeal R) R →+*
      T ⧸ IsLocalRing.maximalIdeal T ^ k := fun k =>
    (Ideal.quotientMap (IsLocalRing.maximalIdeal T ^ k) f (hk k)).comp
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) k).toRingHom
  have L1 : ∀ {j k : ℕ} (h : j ≤ k) (ξ : AdicCompletion (IsLocalRing.maximalIdeal R) R),
      Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal R) h
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) k ξ) =
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) j ξ := by
    intro j k h ξ
    obtain ⟨x, rfl⟩ := AdicCompletion.mk_surjective (IsLocalRing.maximalIdeal R) R ξ
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    show Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ j) ((x : ℕ → R) k) =
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ j) ((x : ℕ → R) j)
    rw [Ideal.Quotient.eq]
    have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk h x
    rw [Submodule.Quotient.eq] at h1
    simpa [Ideal.smul_eq_mul, Ideal.mul_top] using h1
  have hg : ∀ {j k : ℕ} (h : j ≤ k),
      (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal T) h).comp (g k) = g j := by
    intro j k h
    refine RingHom.ext fun ξ => ?_
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) k ξ)
    have h2 : AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) j ξ =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ j) r := by
      rw [← L1 h ξ, ← hr]; rfl
    show Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal T) h
        (Ideal.quotientMap (IsLocalRing.maximalIdeal T ^ k) f (hk k)
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) k ξ)) =
      Ideal.quotientMap (IsLocalRing.maximalIdeal T ^ j) f (hk j)
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) j ξ)
    rw [h2, ← hr, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
    rfl
  let fh := IsAdicComplete.liftRingHom (IsLocalRing.maximalIdeal T) g hg
  have hstar : ∀ (k : ℕ) (ξ : AdicCompletion (IsLocalRing.maximalIdeal R) R),
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal T ^ k) (fh ξ) = g k ξ := fun k ξ =>
    IsAdicComplete.mk_liftRingHom (IsLocalRing.maximalIdeal T) g hg k ξ
  have hcomp : fh.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) = f := by
    refine RingHom.ext fun r => ?_
    rw [RingHom.comp_apply, ← sub_eq_zero]
    apply IsHausdorff.haus' (I := IsLocalRing.maximalIdeal T)
    intro k
    rw [SModEq.sub_mem, sub_zero, Ideal.smul_eq_mul, Ideal.mul_top, ← Ideal.Quotient.eq, hstar]
    show Ideal.quotientMap (IsLocalRing.maximalIdeal T ^ k) f (hk k)
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) k
        (AdicCompletion.of (IsLocalRing.maximalIdeal R) R r)) = _
    rw [AdicCompletion.evalₐ_of, Ideal.quotientMap_mk]
  have L2 : ∀ ζ : AdicCompletion (IsLocalRing.maximalIdeal R) R, ¬ IsUnit ζ →
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) 1 ζ = 0 := by
    intro ζ hζ
    by_contra hne
    apply hζ
    have hlift : ∀ k : ℕ, ∃ t : R, Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ k) t =
        AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) k ζ := fun k =>
      Ideal.Quotient.mk_surjective _
    choose t ht using hlift
    have htc : ∀ {j k : ℕ}, j ≤ k → t k - t j ∈ IsLocalRing.maximalIdeal R ^ j := by
      intro j k h
      rw [← Ideal.Quotient.eq]
      have e1 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ j) (t k) =
          Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal R) h
            (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ k) (t k)) := rfl
      rw [e1, ht k, L1 h, ht j]
    have ht1 : t 1 ∉ IsLocalRing.maximalIdeal R := by
      intro hm
      apply hne
      rw [← ht 1, Ideal.Quotient.eq_zero_iff_mem, pow_one]
      exact hm
    have htu : ∀ k : ℕ, 1 ≤ k → IsUnit (t k) := by
      intro k hk
      by_contra hnu
      have hkm : t k ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal _).mpr hnu
      have hd := htc hk
      rw [pow_one] at hd
      apply ht1
      have h3 := Ideal.sub_mem _ hkm hd
      rwa [sub_sub_cancel] at h3
    let s : ℕ → R := fun k => Ring.inverse (t k)
    have hs : ∀ k : ℕ, 1 ≤ k → t k * s k = 1 := fun k hk => Ring.mul_inverse_cancel _ (htu k hk)
    have hcau : ∀ n : ℕ, s n ≡ s (n + 1)
        [SMOD (IsLocalRing.maximalIdeal R ^ n • ⊤ : Submodule R R)] := by
      intro n
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      · have h1 := hs n hn
        have h2 := hs (n + 1) (by omega)
        have e : s n - s (n + 1) = s n * s (n + 1) * (t (n + 1) - t n) := by
          linear_combination (-(s n)) * h2 + s (n + 1) * h1
        rw [e]
        exact Ideal.mul_mem_left _ _ (htc (Nat.le_succ n))
    let y := AdicCompletion.mk (IsLocalRing.maximalIdeal R) R
      (AdicCompletion.AdicCauchySequence.mk (IsLocalRing.maximalIdeal R) R s hcau)
    have hy : ζ * y = 1 := by
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [map_mul, map_one, AdicCompletion.evalₐ_mk, ← ht n]
      show Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n) (t n) *
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n) (s n) = 1
      rw [← map_mul]
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn
        rw [← map_one (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ 0)), Ideal.Quotient.eq,
          pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      · rw [hs n hn, map_one]
    exact ⟨⟨ζ, y, hy, by rw [mul_comm]; exact hy⟩, rfl⟩
  have hloc : IsLocalHom fh := by
    refine ⟨fun ζ hζu => ?_⟩
    by_contra hζ
    have h0 := L2 ζ hζ
    have h1 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal T ^ 1) (fh ζ) = 0 := by
      rw [hstar]
      show Ideal.quotientMap (IsLocalRing.maximalIdeal T ^ 1) f (hk 1)
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) 1 ζ) = 0
      rw [h0, map_zero]
    rw [Ideal.Quotient.eq_zero_iff_mem, pow_one] at h1
    exact (IsLocalRing.mem_maximalIdeal _).mp h1 hζu
  exact ⟨fh, hloc, hcomp⟩

theorem wcpa_dj_glt_cc_adic_congr : ∀ (R₁ R₂ : Type u) [CommRing R₁] [CommRing R₂]
    [IsLocalRing R₁] [IsLocalRing R₂] (f : R₁ ≃+* R₂),
    ∃ ε : AdicCompletion (IsLocalRing.maximalIdeal R₁) R₁ ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal R₂) R₂,
      ε.toRingHom.comp (algebraMap R₁ (AdicCompletion (IsLocalRing.maximalIdeal R₁) R₁)) =
        (algebraMap R₂ (AdicCompletion (IsLocalRing.maximalIdeal R₂) R₂)).comp f.toRingHom :=
by
  intro R₁ R₂ _ _ _ _ f
  have key : ∀ {A B : Type u} [CommRing A] [CommRing B] (I : Ideal A) (J : Ideal B)
      (φ : A →+* B) (hIJ : I ≤ Ideal.comap φ J),
      ∃ Φ : AdicCompletion I A →+* AdicCompletion J B, ∀ (x : AdicCompletion I A) (n : ℕ) (a : A),
        AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) a →
        AdicCompletion.evalₐ J n (Φ x) = Ideal.Quotient.mk (J ^ n) (φ a) := by
    intro A B _ _ I J φ hIJ
    have hn : ∀ n : ℕ, I ^ n ≤ Ideal.comap φ (J ^ n) := fun n =>
      le_trans (Ideal.pow_right_mono hIJ n) (Ideal.le_comap_pow φ n)
    let g : ∀ n : ℕ, AdicCompletion I A →+* B ⧸ J ^ n := fun n =>
      (Ideal.quotientMap (J ^ n) φ (hn n)).comp
        (AdicCompletion.evalₐ I n : AdicCompletion I A →+* A ⧸ I ^ n)
    have hg : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow J hle).comp (g n) = g m := by
      intro m n hle
      ext x
      obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I A x
      simp only [g, RingHom.comp_apply, AlgHom.coe_toRingHom, AdicCompletion.evalₐ_mk,
        Ideal.quotientMap_mk]
      have h1 := AdicCompletion.Ideal.mk_eq_mk I hle s
      have h2 := congrArg (Ideal.quotientMap (J ^ m) φ (hn m)) h1
      simp only [Ideal.quotientMap_mk] at h2
      rw [← h2]
      rfl
    refine ⟨AdicCompletion.liftRingHom J g hg, ?_⟩
    intro x n a hx
    rw [AdicCompletion.evalₐ_liftRingHom]
    simp only [g, RingHom.comp_apply, AlgHom.coe_toRingHom, hx, Ideal.quotientMap_mk]
  have h1 : IsLocalRing.maximalIdeal R₁ ≤
      Ideal.comap (f : R₁ →+* R₂) (IsLocalRing.maximalIdeal R₂) := by
    intro x hx
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
    intro hu
    apply hx
    simpa using (MulEquiv.isUnit_map f).mp hu
  have h2 : IsLocalRing.maximalIdeal R₂ ≤
      Ideal.comap (f.symm : R₂ →+* R₁) (IsLocalRing.maximalIdeal R₁) := by
    intro x hx
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
    intro hu
    apply hx
    simpa using (MulEquiv.isUnit_map f.symm).mp hu
  obtain ⟨Φ, hΦ⟩ := key _ _ (f : R₁ →+* R₂) h1
  obtain ⟨Ψ, hΨ⟩ := key _ _ (f.symm : R₂ →+* R₁) h2
  have hΦΨ : Φ.comp Ψ = RingHom.id _ := by
    ext1 y
    apply AdicCompletion.ext_evalₐ
    intro n
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
    rw [RingHom.comp_apply, hΦ _ n (f.symm b) (hΨ y n b hb.symm), RingHom.id_apply, ← hb]
    simp
  have hΨΦ : Ψ.comp Φ = RingHom.id _ := by
    ext1 y
    apply AdicCompletion.ext_evalₐ
    intro n
    obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
    rw [RingHom.comp_apply, hΨ _ n (f b) (hΦ y n b hb.symm), RingHom.id_apply, ← hb]
    simp
  refine ⟨RingEquiv.ofRingHom Φ Ψ hΦΨ hΨΦ, ?_⟩
  ext1 r
  apply AdicCompletion.ext_evalₐ
  intro n
  simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
    RingEquiv.ofRingHom_apply, AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply]
  rw [hΦ _ n r (AdicCompletion.evalₐ_of _ _ r), AdicCompletion.evalₐ_of]
  rfl

theorem wcpa_dj_stc_ktc_compl_ext : ∀ (R T : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [CommRing T] [IsLocalRing T], IsAdicComplete (IsLocalRing.maximalIdeal T) T → ∀ (φ₁ φ₂ : AdicCompletion (IsLocalRing.maximalIdeal R) R →+* T), φ₁.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) = φ₂.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) → IsLocalHom (φ₁.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))) → φ₁ = φ₂ :=
by
  intro R T _ _ _ _ _ hT φ₁ φ₂ hφ hloc
  haveI := hT
  haveI := hloc
  have hmap : Ideal.map (φ₁.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)))
      (IsLocalRing.maximalIdeal R) ≤ IsLocalRing.maximalIdeal T := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    exact map_nonunit (φ₁.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))) x hx
  have hs3 : ∀ (ψ : AdicCompletion (IsLocalRing.maximalIdeal R) R →+* T),
      ψ.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) =
        φ₁.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) →
      ∀ k : ℕ, ∀ η ∈ Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
        (IsLocalRing.maximalIdeal R ^ k), ψ η ∈ IsLocalRing.maximalIdeal T ^ k := by
    intro ψ hψ k η hη
    have h1 : ψ η ∈ Ideal.map ψ (Ideal.map
        (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
        (IsLocalRing.maximalIdeal R ^ k)) := Ideal.mem_map_of_mem ψ hη
    rw [Ideal.map_map, hψ, Ideal.map_pow] at h1
    exact Ideal.pow_right_mono hmap k h1
  apply RingHom.ext
  intro ξ
  rw [← sub_eq_zero]
  apply IsHausdorff.haus' (I := IsLocalRing.maximalIdeal T)
  intro k
  rw [SModEq.sub_mem, sub_zero, smul_eq_mul, Ideal.mul_top]
  have hfg : (IsLocalRing.maximalIdeal R).FG := IsNoetherian.noetherian _
  have hmem : ∀ (b : AdicCompletion (IsLocalRing.maximalIdeal R) R),
      b ∈ Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
        (IsLocalRing.maximalIdeal R ^ k) ↔
      AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k b = 0 := by
    intro b
    have h1 := AdicCompletion.pow_smul_top_eq_ker_eval (M := R) (n := k) hfg
    have h2 := Ideal.smul_top_eq_map (S := AdicCompletion (IsLocalRing.maximalIdeal R) R)
      (IsLocalRing.maximalIdeal R ^ k)
    have h3 := SetLike.ext_iff.mp (h2.symm.trans h1) b
    rw [Submodule.restrictScalars_mem, LinearMap.mem_ker] at h3
    exact h3
  have hof : ∀ (p : R), AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k
      (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) p) =
      Submodule.Quotient.mk p := by
    intro p
    change AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k
      (AdicCompletion.of (IsLocalRing.maximalIdeal R) R p) = _
    rw [AdicCompletion.eval_of]
    rfl
  obtain ⟨p, hp⟩ : ∃ p : R, ξ - algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) p ∈
      Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))
        (IsLocalRing.maximalIdeal R ^ k) := by
    obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _
      (AdicCompletion.eval (IsLocalRing.maximalIdeal R) R k ξ)
    refine ⟨p, (hmem _).mpr ?_⟩
    rw [map_sub, hof, hp, sub_self]
  have e : φ₁ ξ - φ₂ ξ =
      φ₁ (ξ - algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) p) -
        φ₂ (ξ - algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) p) := by
    have h2 := RingHom.congr_fun hφ p
    simp only [RingHom.comp_apply] at h2
    rw [map_sub, map_sub, h2]
    ring
  rw [e]
  exact Ideal.sub_mem _ (hs3 φ₁ rfl k _ hp) (hs3 φ₂ hφ.symm k _ hp)

theorem wcpa_dj_nccw_ebnb_completion_generators : ∀ (S Z : Scheme.{u}) (ν : S ⟶ Z), IsFinite ν → ∀ zk : S, IsNoetherianRing (Z.presheaf.stalk (ν zk)) → IsNoetherianRing (S.presheaf.stalk zk) → ∀ ψ : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (ν zk))) (Z.presheaf.stalk (ν zk)) →+* AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk), (∀ x : Z.presheaf.stalk (ν zk), ψ (algebraMap _ _ x) = algebraMap (S.presheaf.stalk zk) (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)) ((ν.stalkMap zk).hom x)) → ∃ (n : ℕ) (c : Fin n → S.presheaf.stalk zk), ∀ b : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk), ∃ x : Fin n → AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (ν zk))) (Z.presheaf.stalk (ν zk)), b = ∑ i, ψ (x i) * algebraMap (S.presheaf.stalk zk) (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)) (c i) :=
by
  intro S Z ν hν zk hO hA ψ hψ
  classical
  have main : ∀ (O A : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] [CommRing A]
      [IsLocalRing A] [IsNoetherianRing A] (φ : O →+* A) [IsLocalHom φ] (B : Type u)
      [CommRing B] (α : O →+* B) (𝔫 : Ideal B) (h𝔫 : 𝔫.IsMaximal) (β : B →+* A), α.Finite →
      @IsLocalization B _ (@Ideal.primeCompl B _ 𝔫 h𝔫.isPrime) A _ β.toAlgebra →
      β.comp α = φ →
      ∀ ψ : AdicCompletion (IsLocalRing.maximalIdeal O) O →+*
        AdicCompletion (IsLocalRing.maximalIdeal A) A,
      (∀ x : O, ψ (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) x) =
        algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (φ x)) →
      ∃ (n : ℕ) (c : Fin n → A), ∀ b : AdicCompletion (IsLocalRing.maximalIdeal A) A,
        ∃ x : Fin n → AdicCompletion (IsLocalRing.maximalIdeal O) O,
          b = ∑ i, ψ (x i) * algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (c i) := by
    intro O A _ _ _ _ _ _ φ _ B _ α 𝔫 h𝔫 β hfin hloc hφ ψ hψ
    letI : Algebra O B := α.toAlgebra
    haveI : Module.Finite O B := hfin
    letI : Algebra B A := β.toAlgebra
    haveI := h𝔫
    haveI : IsLocalization.AtPrime A 𝔫 := hloc

    have hcontr : 𝔫.comap (algebraMap O B) = IsLocalRing.maximalIdeal O := by
      haveI : (𝔫.comap (algebraMap O B)).IsMaximal := Ideal.IsMaximal.under O 𝔫
      exact IsLocalRing.eq_maximalIdeal inferInstance

    obtain ⟨T⟩ := wc_hnas_pfc_gcl_finite_completion_tensor O B inferInstance
      (IsLocalRing.maximalIdeal O)
    obtain ⟨E, iE, aE, ⟨Sp⟩⟩ := wc_hnas_pfc_gcl_semilocal_completion_split O B inferInstance
      (IsLocalRing.maximalIdeal O) 𝔫 hcontr

    let j : Localization.AtPrime 𝔫 ≃ₐ[B] A := IsLocalization.algEquiv 𝔫.primeCompl _ _
    obtain ⟨ε₁, hε₁⟩ := wcpa_dj_glt_cc_adic_congr (Localization.AtPrime 𝔫) A j.toRingEquiv

    let a : O ≃ₐ[O] Localization.AtPrime (IsLocalRing.maximalIdeal O) :=
      IsLocalization.atUnits O (IsLocalRing.maximalIdeal O).primeCompl
        (S := Localization.AtPrime (IsLocalRing.maximalIdeal O))
        (fun x hx => IsLocalRing.notMem_maximalIdeal.mp hx)
    obtain ⟨ε₀, hε₀⟩ := wcpa_dj_glt_cc_adic_congr O
      (Localization.AtPrime (IsLocalRing.maximalIdeal O)) a.toRingEquiv
    have hε₀' : ∀ x : O, ε₀ (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) x) =
        algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal
          (Localization.AtPrime (IsLocalRing.maximalIdeal O)))
          (Localization.AtPrime (IsLocalRing.maximalIdeal O))) x := by
      intro x
      have h1 : ε₀ (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) x) =
          algebraMap (Localization.AtPrime (IsLocalRing.maximalIdeal O))
            (AdicCompletion (IsLocalRing.maximalIdeal
              (Localization.AtPrime (IsLocalRing.maximalIdeal O)))
              (Localization.AtPrime (IsLocalRing.maximalIdeal O))) (a x) :=
        RingHom.congr_fun hε₀ x
      have h2 : a x = algebraMap O (Localization.AtPrime (IsLocalRing.maximalIdeal O)) x :=
        a.commutes x
      rw [h1, h2, ← IsScalarTower.algebraMap_apply]
    let ε₀' := AlgEquiv.ofRingEquiv (f := ε₀) hε₀'

    let Θ := Algebra.TensorProduct.congr (AlgEquiv.refl : B ≃ₐ[B] B) ε₀'

    let κ : TensorProduct O B (AdicCompletion (IsLocalRing.maximalIdeal O) O) →+*
        AdicCompletion (IsLocalRing.maximalIdeal A) A :=
      ε₁.toRingHom.comp ((RingHom.fst _ E).comp
        (Sp.toRingHom.comp (T.toRingHom.comp Θ.toRingHom)))
    have hsurj : Function.Surjective κ := by
      intro z
      refine ⟨Θ.symm (T.symm (Sp.symm (ε₁.symm z, 0))), ?_⟩
      show ε₁ ((Sp (T (Θ (Θ.symm (T.symm (Sp.symm (ε₁.symm z, 0))))))).1) = z
      simp only [AlgEquiv.apply_symm_apply, RingEquiv.apply_symm_apply]
    have hκ1 : ∀ b : B, κ (b ⊗ₜ[O] (1 : AdicCompletion (IsLocalRing.maximalIdeal O) O)) =
        algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (β b) := by
      intro b
      have e0 : b ⊗ₜ[O] (1 : AdicCompletion (IsLocalRing.maximalIdeal O) O) =
          algebraMap B _ b := by
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
      have e2 : Sp (T (Θ (algebraMap B (TensorProduct O B
          (AdicCompletion (IsLocalRing.maximalIdeal O) O)) b))) = algebraMap B _ b := by
        rw [AlgEquiv.commutes, AlgEquiv.commutes, AlgEquiv.commutes]
      have e1 : ε₁ (algebraMap (Localization.AtPrime 𝔫)
          (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫))
            (Localization.AtPrime 𝔫)) (algebraMap B (Localization.AtPrime 𝔫) b)) =
          algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)
            (j (algebraMap B (Localization.AtPrime 𝔫) b)) :=
        RingHom.congr_fun hε₁ _
      show ε₁ ((Sp (T (Θ (b ⊗ₜ[O] (1 : AdicCompletion (IsLocalRing.maximalIdeal O) O))))).1) = _
      rw [e0, e2, Prod.algebraMap_apply, IsScalarTower.algebraMap_apply B
        (Localization.AtPrime 𝔫) (AdicCompletion (IsLocalRing.maximalIdeal
          (Localization.AtPrime 𝔫)) (Localization.AtPrime 𝔫)) b, e1, j.commutes]
      rfl
    have hκ3 : ∀ x : O, κ ((1 : B) ⊗ₜ[O]
        algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) x) =
        algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (φ x) := by
      intro x
      rw [Algebra.algebraMap_eq_smul_one (A := AdicCompletion (IsLocalRing.maximalIdeal O) O) x,
        ← TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one (A := B) x, hκ1, ← hφ]
      rfl

    obtain ⟨hlocA, hcompl, hιA, -⟩ := wc_hnas_completion_local_complete A
    let lam : AdicCompletion (IsLocalRing.maximalIdeal O) O →+*
        AdicCompletion (IsLocalRing.maximalIdeal A) A :=
      κ.comp (Algebra.TensorProduct.includeRight : AdicCompletion (IsLocalRing.maximalIdeal O) O
        →ₐ[O] TensorProduct O B (AdicCompletion (IsLocalRing.maximalIdeal O) O)).toRingHom
    have hψc : ψ.comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) =
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ :=
      RingHom.ext hψ
    have hlocal : IsLocalHom (ψ.comp (algebraMap O
        (AdicCompletion (IsLocalRing.maximalIdeal O) O))) := by
      rw [hψc]
      exact RingHom.isLocalHom_comp _ _
    have hagree : ψ.comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) =
        lam.comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) := by
      refine RingHom.ext fun x => ?_
      rw [RingHom.comp_apply, hψ x]
      exact (hκ3 x).symm
    have hψlam : ψ = lam := wcpa_dj_stc_ktc_compl_ext O _ hcompl ψ lam hagree hlocal

    obtain ⟨n, s, hspan⟩ := Module.Finite.exists_fin (R := O) (M := B)
    have G1 : ∀ w : TensorProduct O B (AdicCompletion (IsLocalRing.maximalIdeal O) O),
        ∃ y : Fin n → AdicCompletion (IsLocalRing.maximalIdeal O) O,
          w = ∑ i, s i ⊗ₜ[O] y i := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => exact ⟨0, by simp⟩
      | tmul b m =>
        have hb : b ∈ Submodule.span O (Set.range s) := by rw [hspan]; trivial
        obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun O).mp hb
        refine ⟨fun i => c i • m, ?_⟩
        rw [← hc, TensorProduct.sum_tmul]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [TensorProduct.smul_tmul]
      | add w₁ w₂ h₁ h₂ =>
        obtain ⟨y₁, rfl⟩ := h₁
        obtain ⟨y₂, rfl⟩ := h₂
        refine ⟨y₁ + y₂, ?_⟩
        simp only [Pi.add_apply, TensorProduct.tmul_add, Finset.sum_add_distrib]
    refine ⟨n, fun i => β (s i), fun b => ?_⟩
    obtain ⟨w, rfl⟩ := hsurj b
    obtain ⟨y, rfl⟩ := G1 w
    refine ⟨y, ?_⟩
    rw [map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    have e : s i ⊗ₜ[O] y i = (s i ⊗ₜ[O] (1 : AdicCompletion (IsLocalRing.maximalIdeal O) O)) *
        ((1 : B) ⊗ₜ[O] y i) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [e, map_mul, hκ1, mul_comm, hψlam]
    rfl
  haveI := hν
  haveI := hO
  haveI := hA
  obtain ⟨B, iB, α, 𝔫, h𝔫, β, hfin, hloc, hcomp⟩ :=
    wcpa_dj_lr1k_ebnb_finite_stalk_chart ν zk (ν zk) rfl (S.presheaf.stalk zk) (RingEquiv.refl _)
  have hφ : β.comp α = (ν.stalkMap zk).hom := by
    rw [hcomp, TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl,
      Category.id_comp, RingEquiv.toRingHom_refl, RingHom.id_comp]
  exact main _ _ (ν.stalkMap zk).hom B α 𝔫 h𝔫 β hfin hloc hφ ψ hψ

theorem wcpa_dj_nccw_ebnb_two_chain : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → IsClosed ({zk} : Set S) ∧ ∃ s s' : S, s' ⤳ s ∧ s ⤳ zk ∧ s ≠ zk ∧ (ν ≫ u) s = IsLocalRing.closedPoint R ∧ (ν ≫ u) s' ≠ IsLocalRing.closedPoint R ∧ ∃ p₀ p₁ : Ideal (S.presheaf.stalk zk), p₀.IsPrime ∧ p₁.IsPrime ∧ p₀ < p₁ ∧ p₁ < IsLocalRing.maximalIdeal (S.presheaf.stalk zk) :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA
  classical
  obtain ⟨-, -, -, hH, hS⟩ := hA
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hfst, hu, hcl, -⟩ := hH
  obtain ⟨-, ⟨hνfin, -⟩, -, ⟨hflat, -⟩, -, -, ⟨hzk, -⟩, -, -, -, ⟨-, -, -, -, -, -, hP10⟩, -, -⟩ :=
    hS
  have hνz : ν zk = (ι ≫ Limits.pullback.fst u u') γ := hzk.trans hfst
  have hclν : IsClosed ({ν zk} : Set Z) := by rw [hνz]; exact hcl
  have hzkc : IsClosed ({zk} : Set S) := by
    haveI := hνfin
    have hF : IsClosed (⇑ν ⁻¹' {ν zk}) := hclν.preimage ν.continuous
    haveI : DiscreteTopology ↑(⇑ν ⁻¹' {ν zk}) := (ν.fiberHomeo (ν zk)).discreteTopology
    have h := hF.isClosedMap_subtype_val {(⟨zk, rfl⟩ : ↑(⇑ν ⁻¹' {ν zk}))} (isClosed_discrete _)
    simpa [Set.image_singleton] using h
  have hzkF : (ν ≫ u) zk = IsLocalRing.closedPoint R := by
    rw [Scheme.Hom.comp_apply, hνz]; exact hu
  have hFc : IsClosed (⇑(ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R}) :=
    (IsLocalRing.isClosed_singleton_closedPoint R).preimage (ν ≫ u).continuous

  have hs : ∃ s : S, (ν ≫ u) s = IsLocalRing.closedPoint R ∧ s ⤳ zk ∧ s ≠ zk := by
    by_contra H
    push_neg at H
    have hnt := hP10 {zk} hzkc isIrreducible_singleton
      (Set.singleton_subset_iff.mpr hzkF) (by
        intro L' hL' hzL' hL'F
        have hC := hL'.closure
        have hg := hC.isGenericPoint_genericPoint isClosed_closure
        have hCF : closure L' ⊆ ⇑(ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} :=
          closure_minimal hL'F hFc
        have hgF := hCF hg.mem
        have hgz : hC.genericPoint ⤳ zk := hg.specializes (subset_closure (hzL' rfl))
        have hgeq : hC.genericPoint = zk := H _ hgF hgz
        have hCz : closure L' = {zk} := by
          rw [← hg.def, hgeq, hzkc.closure_eq]
        apply Set.Subset.antisymm
        · intro x hx
          have hx' := subset_closure hx
          rwa [hCz] at hx'
        · exact hzL')
    exact Set.not_nontrivial_singleton hnt
  obtain ⟨s, hsF, hszk, hsne⟩ := hs

  haveI := hflat
  have hgen : GeneralizingMap ⇑(ν ≫ u) := Flat.generalizingMap (ν ≫ u)
  let ηR : Spec (.of R) := (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum R)
  have hηsp : ηR ⤳ (ν ≫ u) s := by
    rw [hsF]
    exact (PrimeSpectrum.le_iff_specializes _ _).mp
      (show (⊥ : Ideal R) ≤ IsLocalRing.maximalIdeal R from bot_le)
  obtain ⟨s', hs's, hs'η⟩ := hgen hηsp
  have hs'F : (ν ≫ u) s' ≠ IsLocalRing.closedPoint R := by
    rw [hs'η]
    intro heq
    have h2 := congrArg PrimeSpectrum.asIdeal heq
    exact IsDiscreteValuationRing.not_a_field R h2.symm
  have hs'ne : s' ≠ s := by
    intro h3
    apply hs'F
    rw [h3]
    exact hsF

  have hsR : s ∈ Set.range ⇑(S.fromSpecStalk zk) := by
    rw [Scheme.range_fromSpecStalk]; exact hszk
  have hs'R : s' ∈ Set.range ⇑(S.fromSpecStalk zk) := by
    rw [Scheme.range_fromSpecStalk]; exact hs's.trans hszk
  obtain ⟨P₁, hP₁⟩ := hsR
  obtain ⟨P₀, hP₀⟩ := hs'R
  have hemb : Topology.IsInducing ⇑(S.fromSpecStalk zk) :=
    (S.fromSpecStalk zk).isEmbedding.isInducing
  have h01sp : P₀ ⤳ P₁ := by
    rw [← hemb.specializes_iff, hP₀, hP₁]; exact hs's
  have h01le : P₀.asIdeal ≤ P₁.asIdeal := (PrimeSpectrum.le_iff_specializes _ _).mpr h01sp
  refine ⟨hzkc, s, s', hs's, hszk, hsne, hsF, hs'F, P₀.asIdeal, P₁.asIdeal, P₀.isPrime,
    P₁.isPrime, ?_, ?_⟩
  · refine lt_of_le_of_ne h01le ?_
    intro heq
    apply hs'ne
    rw [← hP₀, ← hP₁, PrimeSpectrum.ext heq]
  · refine lt_of_le_of_ne (IsLocalRing.le_maximalIdeal P₁.isPrime.ne_top) ?_
    intro heq
    apply hsne
    have h4 : P₁ = IsLocalRing.closedPoint (S.presheaf.stalk zk) := PrimeSpectrum.ext heq
    rw [← hP₁, h4, Scheme.fromSpecStalk_closedPoint]

theorem wcpa_dj_nccw_ebnb_birational : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → _root_.IsReduced (Z.presheaf.stalk (ν zk)) → (∀ p₀ p₁ p₂ p₃ : Ideal (Z.presheaf.stalk (ν zk)), p₀.IsPrime → p₁.IsPrime → p₂.IsPrime → p₃.IsPrime → p₀ < p₁ → p₁ < p₂ → p₂ < p₃ → False) → (∃ s s' : S, s' ⤳ s ∧ s ⤳ zk ∧ s ≠ zk ∧ (ν ≫ u) s = IsLocalRing.closedPoint R ∧ (ν ≫ u) s' ≠ IsLocalRing.closedPoint R) → ∀ c : S.presheaf.stalk zk, ∃ x t : Z.presheaf.stalk (ν zk), (ν.stalkMap zk).hom t ≠ 0 ∧ (ν.stalkMap zk).hom t * c = (ν.stalkMap zk).hom x :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA hred
    hchain hss c
  obtain ⟨s, s', hs's, hszk, hsne, hsu, hs'u⟩ := hss
  obtain ⟨-, -, -, -, hS⟩ := hA
  obtain ⟨-, ⟨hνfin, -⟩, ⟨hnormS, -, -⟩, -, -, -, -, -, -, -, -, -, ⟨-, hP12Z⟩⟩ := hS

  have t_generic : ∀ (X : Scheme.{u}) (x : X), IsDomain (X.presheaf.stalk x) → ∃ g : X, g ⤳ x ∧
      (∀ y : X, y ⤳ x → g ⤳ y) ∧ (∀ g' : X, g' ⤳ g → g' = g) := by
    intro X x hd
    let p0 : PrimeSpectrum (X.presheaf.stalk x) := ⟨⊥, Ideal.isPrime_bot⟩
    have hr : ∀ y : X, y ⤳ x → ∃ p : PrimeSpectrum (X.presheaf.stalk x),
        X.fromSpecStalk x p = y := by
      intro y hy
      have : y ∈ Set.range (X.fromSpecStalk x) := by rw [Scheme.range_fromSpecStalk]; exact hy
      exact this
    have hgen : ∀ y : X, y ⤳ x → X.fromSpecStalk x p0 ⤳ y := by
      intro y hy
      obtain ⟨p, rfl⟩ := hr y hy
      exact ((PrimeSpectrum.le_iff_specializes p0 p).mp bot_le).map (X.fromSpecStalk x).continuous
    refine ⟨X.fromSpecStalk x p0, hgen x specializes_rfl, hgen, ?_⟩
    intro g' hg'
    obtain ⟨p, rfl⟩ := hr g' (hg'.trans (hgen x specializes_rfl))
    have h2 : p ⤳ p0 := ((X.fromSpecStalk x).isEmbedding.isInducing.specializes_iff).mp hg'
    have h3 : p.asIdeal ≤ ⊥ := (PrimeSpectrum.le_iff_specializes p p0).mpr h2
    have : p = p0 := PrimeSpectrum.ext (le_antisymm h3 bot_le)
    rw [this]

  have t_chain : ∀ (X : Scheme.{u}) (x y₀ y₁ y₂ : X), (∀ p₀ p₁ p₂ p₃ : Ideal (X.presheaf.stalk x),
      p₀.IsPrime → p₁.IsPrime → p₂.IsPrime → p₃.IsPrime → p₀ < p₁ → p₁ < p₂ → p₂ < p₃ → False) →
      y₀ ⤳ y₁ → y₁ ⤳ y₂ → y₂ ⤳ x → y₀ ≠ y₁ → y₁ ≠ y₂ → y₂ ≠ x → False := by
    intro X x y₀ y₁ y₂ hc h01 h12 h2x n01 n12 n2x
    have hr : ∀ y : X, y ⤳ x → ∃ p : PrimeSpectrum (X.presheaf.stalk x),
        X.fromSpecStalk x p = y := by
      intro y hy
      have : y ∈ Set.range (X.fromSpecStalk x) := by rw [Scheme.range_fromSpecStalk]; exact hy
      exact this
    have hind := (X.fromSpecStalk x).isEmbedding.isInducing
    have lt : ∀ a b : PrimeSpectrum (X.presheaf.stalk x),
        X.fromSpecStalk x a ⤳ X.fromSpecStalk x b →
        X.fromSpecStalk x a ≠ X.fromSpecStalk x b → a.asIdeal < b.asIdeal := by
      intro a b hab nab
      refine lt_of_le_of_ne
        ((PrimeSpectrum.le_iff_specializes a b).mpr (hind.specializes_iff.mp hab)) ?_
      intro e
      exact nab (congrArg _ (PrimeSpectrum.ext e))
    have hcl : X.fromSpecStalk x (IsLocalRing.closedPoint (X.presheaf.stalk x)) = x :=
      Scheme.fromSpecStalk_closedPoint
    obtain ⟨q₂, rfl⟩ := hr y₂ h2x
    obtain ⟨q₁, rfl⟩ := hr _ (h12.trans h2x)
    obtain ⟨q₀, rfl⟩ := hr _ (h01.trans (h12.trans h2x))
    have h2x' : X.fromSpecStalk x q₂ ⤳
        X.fromSpecStalk x (IsLocalRing.closedPoint (X.presheaf.stalk x)) := by
      rw [hcl]; exact h2x
    have n2x' : X.fromSpecStalk x q₂ ≠
        X.fromSpecStalk x (IsLocalRing.closedPoint (X.presheaf.stalk x)) := by
      rw [hcl]; exact n2x
    exact hc _ _ _ _ q₀.isPrime q₁.isPrime q₂.isPrime (IsLocalRing.closedPoint _).isPrime
      (lt _ _ h01 n01) (lt _ _ h12 n12) (lt _ _ h2x' n2x')

  have t_fib : ∀ (S Z : Scheme.{u}) (ν : S ⟶ Z), IsFinite ν → ∀ s₁ s₂ : S, s₁ ⤳ s₂ →
      ν s₁ = ν s₂ → s₁ = s₂ := by
    intro S Z ν hν s₁ s₂ hsp he
    haveI : LocallyQuasiFinite ν := inferInstance
    have hd := ν.isDiscrete_preimage_singleton (ν s₂)
    rw [isDiscrete_iff_discreteTopology] at hd
    have h1 : (⟨s₁, he⟩ : ν ⁻¹' {ν s₂}) ⤳ ⟨s₂, rfl⟩ :=
      Topology.IsInducing.subtypeVal.specializes_iff.mp hsp
    exact congrArg Subtype.val (specializes_iff_eq.mp h1)

  have t_loc : ∀ (X : Scheme.{u}) (x z : X) (h : x ⤳ z),
      letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
      IsLocalization.AtPrime (X.presheaf.stalk x)
        ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap
          (X.presheaf.stalkSpecializes h).hom) := by
    intro X x z h
    have key : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [IsLocalRing S]
        (gR : A →+* R) (gS : A →+* S) (φ : R →+* S), φ.comp gR = gS →
        ∀ (P Q : Ideal A) [P.IsPrime] [Q.IsPrime],
        @IsLocalization.AtPrime A _ R _ gR.toAlgebra P _ →
        @IsLocalization.AtPrime A _ S _ gS.toAlgebra Q _ →
        letI := φ.toAlgebra; IsLocalization.AtPrime S ((IsLocalRing.maximalIdeal S).comap φ) := by
      intro A R S _ _ _ _ gR gS φ hcomp P Q _ _ hR hS
      letI : Algebra A R := gR.toAlgebra
      letI : Algebra A S := gS.toAlgebra
      letI : Algebra R S := φ.toAlgebra
      have hc : ∀ a, φ (gR a) = gS a := fun a => by rw [← hcomp]; rfl
      haveI : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq (fun a => (hc a).symm)
      have hle : P.primeCompl ≤ Q.primeCompl := by
        intro a ha haQ
        have hu : IsUnit (gR a) := IsLocalization.map_units R (⟨a, ha⟩ : P.primeCompl)
        have hu' : IsUnit (gS a) := hc a ▸ hu.map φ
        have hm : gS a ∈ IsLocalRing.maximalIdeal S := by
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q S]
          exact Ideal.mem_map_of_mem _ haQ
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu') hm
      haveI := IsLocalization.isLocalization_of_submonoid_le R S P.primeCompl Q.primeCompl hle
      show IsLocalization _ S
      refine IsLocalization.of_le (Submonoid.map (algebraMap A R) Q.primeCompl) _ ?_ ?_
      · rintro _ ⟨a, ha, rfl⟩
        show φ (gR a) ∉ IsLocalRing.maximalIdeal S
        rw [hc a]
        exact IsLocalRing.notMem_maximalIdeal.mpr
          (IsLocalization.map_units S (⟨a, ha⟩ : Q.primeCompl))
      · intro r hr
        exact IsLocalRing.notMem_maximalIdeal.mp hr
    obtain ⟨W, hW, hzW, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
    have hxW : x ∈ W := h.mem_open W.isOpen hzW
    have hLz := hW.isLocalization_stalk ⟨z, hzW⟩
    have hLx := hW.isLocalization_stalk ⟨x, hxW⟩
    have hcomp : (X.presheaf.stalkSpecializes h).hom.comp (X.presheaf.germ W z hzW).hom =
        (X.presheaf.germ W x hxW).hom := by
      rw [← CommRingCat.hom_comp, TopCat.Presheaf.germ_stalkSpecializes]
    exact key Γ(X, W) _ _ _ _ _ hcomp _ _ hLz hLx

  have t_field : ∀ (X : Scheme.{u}) (g x : X), g ⤳ x → _root_.IsReduced (X.presheaf.stalk x) →
      (∀ g' : X, g' ⤳ g → g' = g) → IsField (X.presheaf.stalk g) := by
    intro X g x hgx hred hmax
    letI := (X.presheaf.stalkSpecializes hgx).hom.toAlgebra
    haveI := t_loc X g x hgx
    haveI : _root_.IsReduced (X.presheaf.stalk g) :=
      isReduced_localizationPreserves ((IsLocalRing.maximalIdeal (X.presheaf.stalk g)).comap
        (X.presheaf.stalkSpecializes hgx).hom).primeCompl (X.presheaf.stalk g) hred
    have hprime : ∀ J : Ideal (X.presheaf.stalk g), J.IsPrime →
        J = IsLocalRing.maximalIdeal _ := by
      intro J hJ
      have hr : X.fromSpecStalk g ⟨J, hJ⟩ ⤳ g := by
        have : X.fromSpecStalk g ⟨J, hJ⟩ ∈ Set.range (X.fromSpecStalk g) := ⟨_, rfl⟩
        rw [Scheme.range_fromSpecStalk] at this
        exact this
      have e1 := hmax _ hr
      have e2 : X.fromSpecStalk g (IsLocalRing.closedPoint (X.presheaf.stalk g)) = g :=
        Scheme.fromSpecStalk_closedPoint
      have e3 := (X.fromSpecStalk g).isEmbedding.injective (e1.trans e2.symm)
      exact congrArg PrimeSpectrum.asIdeal e3
    rw [IsLocalRing.isField_iff_maximalIdeal_eq]
    rw [eq_bot_iff]
    intro m hm
    have hn : IsNilpotent m :=
      (nilpotent_iff_mem_prime).mpr (fun J hJ => by rw [hprime J hJ]; exact hm)
    exact (Submodule.mem_bot _).mpr hn.eq_zero

  have t_inj : ∀ (X : Scheme.{u}) (g y : X) (h : g ⤳ y), IsDomain (X.presheaf.stalk y) →
      Function.Injective (X.presheaf.stalkSpecializes h).hom := by
    intro X g y h hdom
    letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
    haveI := t_loc X g y h
    have hle : ((IsLocalRing.maximalIdeal (X.presheaf.stalk g)).comap
        (X.presheaf.stalkSpecializes h).hom).primeCompl ≤
          nonZeroDivisors (X.presheaf.stalk y) := by
      intro a ha
      apply mem_nonZeroDivisors_of_ne_zero
      rintro rfl
      exact ha (Ideal.zero_mem _)
    exact IsLocalization.injective (X.presheaf.stalk g) hle

  haveI hdomA : IsDomain (S.presheaf.stalk zk) := (hnormS zk).1
  obtain ⟨s₀, hs₀zk, hgen, hmax⟩ := t_generic S zk hdomA
  have hs₀s := hgen s hszk
  have hs₀s' := hgen s' (hs's.trans hszk)

  have hs₀cl : (ν ≫ u) s₀ ≠ IsLocalRing.closedPoint R := by
    intro e
    have h1 := hs₀s'.map (ν ≫ u).continuous
    have h2 : (ν ≫ u) s' ∈ ({IsLocalRing.closedPoint R} : Set (Spec (.of R))) :=
      h1.mem_closed (IsLocalRing.isClosed_singleton_closedPoint R) e
    exact hs'u h2

  have hνs₀s : ν s₀ ≠ ν s := by
    intro e
    apply hs₀cl
    have : (ν ≫ u) s₀ = (ν ≫ u) s := by simp only [Scheme.Hom.comp_apply, e]
    rw [this]; exact hsu
  have hνszk : ν s ≠ ν zk := fun e => hsne (t_fib S Z ν hνfin s zk hszk e)
  have hg : ν s₀ ⤳ ν zk := hs₀zk.map ν.continuous
  have hgmax : ∀ g' : Z, g' ⤳ ν s₀ → g' = ν s₀ := by
    intro g' hg'
    by_contra hne
    exact t_chain Z (ν zk) g' (ν s₀) (ν s) hchain hg' (hs₀s.map ν.continuous)
      (hszk.map ν.continuous) hne hνs₀s hνszk

  have hF : IsField (Z.presheaf.stalk (ν s₀)) := t_field Z (ν s₀) (ν zk) hg hred hgmax
  have hd : IsDomain (Z.presheaf.stalk (ν s₀)) := hF.isDomain
  have hic : IsIntegrallyClosed (Z.presheaf.stalk (ν s₀)) := by
    letI := hF.toField; infer_instance
  obtain ⟨w, hw, hiso⟩ := hP12Z (ν s₀) hd hic
  have hws : s₀ = w := (hw s₀).mp rfl
  subst hws
  have hθ : Function.Bijective (ν.stalkMap s₀).hom :=
    ConcreteCategory.bijective_of_isIso (ν.stalkMap s₀)

  have hspS := t_inj S s₀ zk hs₀zk hdomA
  have hnat : ∀ x, (ν.stalkMap s₀).hom ((Z.presheaf.stalkSpecializes hg).hom x) =
      (S.presheaf.stalkSpecializes hs₀zk).hom ((ν.stalkMap zk).hom x) :=
    fun x => Scheme.Hom.stalkSpecializes_stalkMap_apply ν s₀ zk hs₀zk x
  letI := (Z.presheaf.stalkSpecializes hg).hom.toAlgebra
  haveI := t_loc Z (ν s₀) (ν zk) hg
  obtain ⟨y, hy⟩ := hθ.2 ((S.presheaf.stalkSpecializes hs₀zk).hom c)
  obtain ⟨⟨a0, ⟨t0, ht0⟩⟩, hmk⟩ := IsLocalization.mk'_surjective
    ((IsLocalRing.maximalIdeal (Z.presheaf.stalk (ν s₀))).comap
      (Z.presheaf.stalkSpecializes hg).hom).primeCompl y
  have hspec := IsLocalization.mk'_spec (Z.presheaf.stalk (ν s₀)) a0 ⟨t0, ht0⟩
  have hunit := IsLocalization.map_units (Z.presheaf.stalk (ν s₀))
    (⟨t0, ht0⟩ : ((IsLocalRing.maximalIdeal (Z.presheaf.stalk (ν s₀))).comap
      (Z.presheaf.stalkSpecializes hg).hom).primeCompl)
  have key : (Z.presheaf.stalkSpecializes hg).hom t0 * y =
      (Z.presheaf.stalkSpecializes hg).hom a0 := by
    rw [mul_comm, ← hmk]; exact hspec
  refine ⟨a0, t0, ?_, ?_⟩
  · intro h0
    have hu : IsUnit ((S.presheaf.stalkSpecializes hs₀zk).hom ((ν.stalkMap zk).hom t0)) := by
      rw [← hnat]; exact hunit.map (ν.stalkMap s₀).hom
    rw [h0, map_zero] at hu
    exact not_isUnit_zero hu
  · apply hspS
    rw [map_mul, ← hnat t0, ← hnat a0, ← hy, ← map_mul, key]

theorem wcpa_dj_nccw_ebnb_q2_axes : ∀ (R : Type u) [CommRing R], ∃ π₀ π₁ : (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) →+* PowerSeries R, Function.Surjective π₀ ∧ Function.Surjective π₁ ∧ (∀ r : R, π₀ (Ideal.Quotient.mk _ (MvPowerSeries.C r)) = PowerSeries.C r) ∧ (∀ r : R, π₁ (Ideal.Quotient.mk _ (MvPowerSeries.C r)) = PowerSeries.C r) ∧ π₀ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = PowerSeries.X ∧ π₀ (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = 0 ∧ π₁ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = 0 ∧ π₁ (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = PowerSeries.X ∧ (∀ P : Ideal (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), P.IsPrime → RingHom.ker π₀ ≤ P ∨ RingHom.ker π₁ ≤ P) ∧ (∀ a, π₀ a = 0 → π₁ a = 0 → a = 0) :=
by
  intro R _

  have branch : ∀ i : Fin 2, ∃ ρ : MvPowerSeries (Fin 2) R →+* PowerSeries R,
      ∀ (F : MvPowerSeries (Fin 2) R) (n : ℕ),
        PowerSeries.coeff n (ρ F) = MvPowerSeries.coeff (Finsupp.single i n) F := by
    intro i
    refine ⟨{ toFun := fun F => PowerSeries.mk (fun n => MvPowerSeries.coeff (Finsupp.single i n) F),
              map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ },
      fun F n => by
        show PowerSeries.coeff n (PowerSeries.mk
          (fun n => MvPowerSeries.coeff (Finsupp.single i n) F)) = _
        exact PowerSeries.coeff_mk _ _⟩
    · ext n
      simp [PowerSeries.coeff_one, MvPowerSeries.coeff_one, Finsupp.single_eq_zero]
    · intro F G
      ext n
      simp only [PowerSeries.coeff_mk, PowerSeries.coeff_mul, MvPowerSeries.coeff_mul,
        Finsupp.antidiagonal_single, Finset.sum_map]
      rfl
    · ext n
      simp
    · intro F G
      ext n
      simp
  obtain ⟨ρ₀, hρ₀⟩ := branch 0
  obtain ⟨ρ₁, hρ₁⟩ := branch 1
  have h01 : (0 : Fin 2) ≠ 1 := by decide

  have hs0 : ∀ m : Fin 2 →₀ ℕ, m 1 = 0 → m = Finsupp.single 0 (m 0) := by
    intro m hm
    ext k
    fin_cases k <;> simp [hm]
  have hs1 : ∀ m : Fin 2 →₀ ℕ, m 0 = 0 → m = Finsupp.single 1 (m 1) := by
    intro m hm
    ext k
    fin_cases k <;> simp [hm]

  have hC : ∀ (i : Fin 2) (ρ : MvPowerSeries (Fin 2) R →+* PowerSeries R),
      (∀ (F : MvPowerSeries (Fin 2) R) (n : ℕ),
        PowerSeries.coeff n (ρ F) = MvPowerSeries.coeff (Finsupp.single i n) F) →
      ∀ r : R, ρ (MvPowerSeries.C r) = PowerSeries.C r := by
    intro i ρ hρ r
    ext n
    rw [hρ, MvPowerSeries.coeff_C, PowerSeries.coeff_C]
    simp [Finsupp.single_eq_zero]
  have hXi : ∀ (i : Fin 2) (ρ : MvPowerSeries (Fin 2) R →+* PowerSeries R),
      (∀ (F : MvPowerSeries (Fin 2) R) (n : ℕ),
        PowerSeries.coeff n (ρ F) = MvPowerSeries.coeff (Finsupp.single i n) F) →
      ρ (MvPowerSeries.X i) = PowerSeries.X := by
    intro i ρ hρ
    ext n
    rw [hρ, MvPowerSeries.coeff_X, PowerSeries.coeff_X]
    by_cases hn : n = 1
    · subst hn; simp
    · rw [if_neg hn, if_neg]
      intro h
      exact hn (Finsupp.single_injective i h)
  have hXj : ∀ (i j : Fin 2) (ρ : MvPowerSeries (Fin 2) R →+* PowerSeries R),
      (∀ (F : MvPowerSeries (Fin 2) R) (n : ℕ),
        PowerSeries.coeff n (ρ F) = MvPowerSeries.coeff (Finsupp.single i n) F) →
      i ≠ j → ρ (MvPowerSeries.X j) = 0 := by
    intro i j ρ hρ hij
    ext n
    rw [hρ, MvPowerSeries.coeff_X, map_zero, if_neg]
    intro h
    have := congrArg (fun m : Fin 2 →₀ ℕ => m j) h
    simp [hij] at this
  have hkill : ∀ (ρ : MvPowerSeries (Fin 2) R →+* PowerSeries R),
      ρ (MvPowerSeries.X 0 * MvPowerSeries.X 1) = 0 →
      ∀ a ∈ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) R)},
        ρ a = 0 := by
    intro ρ h a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, h, mul_zero]
  have hk0 : ρ₀ (MvPowerSeries.X 0 * MvPowerSeries.X 1) = 0 := by
    rw [map_mul, hXj 0 1 ρ₀ hρ₀ h01, mul_zero]
  have hk1 : ρ₁ (MvPowerSeries.X 0 * MvPowerSeries.X 1) = 0 := by
    rw [map_mul, hXj 1 0 ρ₁ hρ₁ h01.symm, zero_mul]
  set I := Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) R)} with hI
  let π₀ := Ideal.Quotient.lift I ρ₀ (hkill ρ₀ hk0)
  let π₁ := Ideal.Quotient.lift I ρ₁ (hkill ρ₁ hk1)
  have hπ₀ : ∀ F, π₀ (Ideal.Quotient.mk I F) = ρ₀ F := fun F => Ideal.Quotient.lift_mk _ _ _
  have hπ₁ : ∀ F, π₁ (Ideal.Quotient.mk I F) = ρ₁ F := fun F => Ideal.Quotient.lift_mk _ _ _

  have hdiv0 : ∀ F, ρ₀ F = 0 → MvPowerSeries.X 1 ∣ F := by
    intro F hF
    rw [MvPowerSeries.X_dvd_iff]
    intro m hm
    rw [hs0 m hm, ← hρ₀, hF, map_zero]
  have hdiv1 : ∀ F, ρ₁ F = 0 → MvPowerSeries.X 0 ∣ F := by
    intro F hF
    rw [MvPowerSeries.X_dvd_iff]
    intro m hm
    rw [hs1 m hm, ← hρ₁, hF, map_zero]
  have hxy : Ideal.Quotient.mk I (MvPowerSeries.X 0) * Ideal.Quotient.mk I (MvPowerSeries.X 1) = 0 := by
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Set.mem_singleton _)
  refine ⟨π₀, π₁, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro f
    let Ff : MvPowerSeries (Fin 2) R :=
      fun m : Fin 2 →₀ ℕ => if m 1 = 0 then PowerSeries.coeff (m 0) f else 0
    refine ⟨Ideal.Quotient.mk I Ff, ?_⟩
    rw [hπ₀]
    ext n
    rw [hρ₀]
    change (if (Finsupp.single (0 : Fin 2) n) 1 = 0 then
      PowerSeries.coeff ((Finsupp.single (0 : Fin 2) n) 0) f else 0) = PowerSeries.coeff n f
    simp
  · intro f
    let Ff : MvPowerSeries (Fin 2) R :=
      fun m : Fin 2 →₀ ℕ => if m 0 = 0 then PowerSeries.coeff (m 1) f else 0
    refine ⟨Ideal.Quotient.mk I Ff, ?_⟩
    rw [hπ₁]
    ext n
    rw [hρ₁]
    change (if (Finsupp.single (1 : Fin 2) n) 0 = 0 then
      PowerSeries.coeff ((Finsupp.single (1 : Fin 2) n) 1) f else 0) = PowerSeries.coeff n f
    simp
  · intro r; rw [hπ₀]; exact hC 0 ρ₀ hρ₀ r
  · intro r; rw [hπ₁]; exact hC 1 ρ₁ hρ₁ r
  · rw [hπ₀]; exact hXi 0 ρ₀ hρ₀
  · rw [hπ₀]; exact hXj 0 1 ρ₀ hρ₀ h01
  · rw [hπ₁]; exact hXj 1 0 ρ₁ hρ₁ h01.symm
  · rw [hπ₁]; exact hXi 1 ρ₁ hρ₁
  · intro P hP
    have hmem : Ideal.Quotient.mk I (MvPowerSeries.X 0) * Ideal.Quotient.mk I (MvPowerSeries.X 1) ∈ P := by
      rw [hxy]; exact P.zero_mem
    rcases hP.mem_or_mem hmem with hx | hy
    · right
      intro a ha
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
      rw [RingHom.mem_ker, hπ₁] at ha
      obtain ⟨G, rfl⟩ := hdiv1 F ha
      rw [map_mul]
      exact P.mul_mem_right _ hx
    · left
      intro a ha
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
      rw [RingHom.mem_ker, hπ₀] at ha
      obtain ⟨G, rfl⟩ := hdiv0 F ha
      rw [map_mul]
      exact P.mul_mem_right _ hy
  · intro a ha0 ha1
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [hπ₀] at ha0
    rw [hπ₁] at ha1
    obtain ⟨G, rfl⟩ := hdiv0 F ha0
    have hG : MvPowerSeries.X 0 ∣ G := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      have e : MvPowerSeries.coeff (Finsupp.single 1 1 + m) (MvPowerSeries.X 1 * G) =
          MvPowerSeries.coeff m G := by
        rw [MvPowerSeries.X_def, MvPowerSeries.coeff_add_monomial_mul, one_mul]
      rw [← e]
      have hm' : (Finsupp.single (1 : Fin 2) 1 + m : Fin 2 →₀ ℕ) 0 = 0 := by
        rw [Finsupp.add_apply, hm, Finsupp.single_apply]
        simp
      rw [hs1 (Finsupp.single (1 : Fin 2) 1 + m) hm', ← hρ₁, ha1, map_zero]
    obtain ⟨H, rfl⟩ := hG
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton']
    exact ⟨H, by ring⟩

theorem wcpa_dj_nccw_ebnb_axis_chain : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ (B : Type u) [CommRing B] (π : B →+* PowerSeries R), Function.Surjective π → ∀ P₀ P₁ P₂ P₃ : Ideal B, P₀.IsPrime → P₁.IsPrime → P₂.IsPrime → P₃.IsPrime → RingHom.ker π ≤ P₀ → P₀ < P₁ → P₁ < P₂ → P₂ < P₃ → False :=
by
  intro R _ _ _ _ B _ π hπ P₀ P₁ P₂ P₃ hP₀ hP₁ hP₂ hP₃ hk h01 h12 h23
  classical

  have mheight : (IsLocalRing.maximalIdeal (PowerSeries R)).height ≤ 2 := by
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hmR := hϖ.maximalIdeal_eq
    set s : Finset (PowerSeries R) := {PowerSeries.C ϖ, PowerSeries.X} with hs
    have hspan : IsLocalRing.maximalIdeal (PowerSeries R) =
        Ideal.span (↑s : Set (PowerSeries R)) := by
      apply le_antisymm
      · intro φ hφ
        have hc : ¬ IsUnit (PowerSeries.constantCoeff φ) := by
          intro hu
          exact (IsLocalRing.mem_maximalIdeal _).mp hφ
            (PowerSeries.isUnit_iff_constantCoeff.mpr hu)
        have hcm : PowerSeries.constantCoeff φ ∈ IsLocalRing.maximalIdeal R := hc
        rw [hmR, Ideal.mem_span_singleton'] at hcm
        obtain ⟨a, ha⟩ := hcm
        have e := PowerSeries.sub_const_eq_X_mul_shift φ
        have hφeq : φ = PowerSeries.C a * PowerSeries.C ϖ +
            PowerSeries.X * PowerSeries.mk (fun p => PowerSeries.coeff (p + 1) φ) := by
          rw [← e, ← map_mul, ha]; ring
        rw [hφeq]
        apply Ideal.add_mem
        · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp [hs]))
        · exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp [hs]))
      · rw [Ideal.span_le]
        intro φ hφ
        simp only [hs, Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
          Set.mem_singleton_iff] at hφ
        show φ ∈ IsLocalRing.maximalIdeal (PowerSeries R)
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, PowerSeries.isUnit_iff_constantCoeff]
        rcases hφ with rfl | rfl
        · rw [PowerSeries.constantCoeff_C]; exact hϖ.not_isUnit
        · rw [PowerSeries.constantCoeff_X]; exact not_isUnit_zero
    have hmin : IsLocalRing.maximalIdeal (PowerSeries R) ∈
        (Ideal.span (↑s : Set (PowerSeries R))).minimalPrimes := by
      rw [← hspan, Ideal.minimalPrimes_eq_subsingleton_self]
      exact Set.mem_singleton _
    have h1 := Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmin
    have h2 : s.card ≤ 2 := Finset.card_le_two
    exact h1.trans (by exact_mod_cast h2)

  have height3 : ∀ (Q₀ Q₁ Q₂ Q₃ : Ideal (PowerSeries R)), Q₀.IsPrime → Q₁.IsPrime →
      Q₂.IsPrime → Q₃.IsPrime → Q₀ < Q₁ → Q₁ < Q₂ → Q₂ < Q₃ → ¬ Q₃.height ≤ 2 := by
    intro Q₀ Q₁ Q₂ Q₃ h0 h1 h2 h3 h01' h12' h23' H
    have a2 : Q₂.height < ((2 : ℕ) : ℕ∞) :=
      Ideal.height_le_iff.mp (by exact_mod_cast H) Q₂ h2 h23'
    have b2 : Q₂.height ≤ ((1 : ℕ) : ℕ∞) := by
      have : ((2 : ℕ) : ℕ∞) = ((1 : ℕ) : ℕ∞) + 1 := by norm_num
      rw [this] at a2
      exact (ENat.lt_add_one_iff (by simp)).mp a2
    have a1 : Q₁.height < ((1 : ℕ) : ℕ∞) := Ideal.height_le_iff.mp b2 Q₁ h1 h12'
    have b1 : Q₁.height ≤ ((0 : ℕ) : ℕ∞) := by
      have : ((1 : ℕ) : ℕ∞) = ((0 : ℕ) : ℕ∞) + 1 := by norm_num
      rw [this] at a1
      exact (ENat.lt_add_one_iff (by simp)).mp a1
    have a0 : Q₀.height < ((0 : ℕ) : ℕ∞) := Ideal.height_le_iff.mp b1 Q₀ h0 h01'
    simp at a0

  have k0 : RingHom.ker π ≤ P₀ := hk
  have k1 : RingHom.ker π ≤ P₁ := k0.trans h01.le
  have k2 : RingHom.ker π ≤ P₂ := k1.trans h12.le
  have k3 : RingHom.ker π ≤ P₃ := k2.trans h23.le
  have pr : ∀ P : Ideal B, P.IsPrime → RingHom.ker π ≤ P → (Ideal.map π P).IsPrime := by
    intro P hP hkP
    exact Ideal.map_isPrime_of_surjective hπ hkP
  have st : ∀ P P' : Ideal B, RingHom.ker π ≤ P → RingHom.ker π ≤ P' → P < P' →
      Ideal.map π P < Ideal.map π P' := by
    intro P P' hkP hkP' hlt
    refine lt_of_le_of_ne (Ideal.map_mono hlt.le) ?_
    intro heq
    apply hlt.ne
    have := congrArg (Ideal.comap π) heq
    rwa [Ideal.comap_map_of_surjective' π hπ, Ideal.comap_map_of_surjective' π hπ,
      sup_eq_left.mpr hkP, sup_eq_left.mpr hkP'] at this

  have hQ3 := pr P₃ hP₃ k3
  have hle : Ideal.map π P₃ ≤ IsLocalRing.maximalIdeal (PowerSeries R) :=
    IsLocalRing.le_maximalIdeal_of_isPrime _
  exact height3 _ _ _ _ (pr P₀ hP₀ k0) (pr P₁ hP₁ k1) (pr P₂ hP₂ k2) hQ3
    (st _ _ k0 k1 h01) (st _ _ k1 k2 h12) (st _ _ k2 k3 h23)
    ((Ideal.height_mono hle).trans mheight)

theorem wcpa_dj_nccw_ebnb_stalk_q2_facts : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], ∀ (_ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) R ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) R)))), _root_.IsReduced A ∧ ∀ p₀ p₁ p₂ p₃ : Ideal A, p₀.IsPrime → p₁.IsPrime → p₂.IsPrime → p₃.IsPrime → p₀ < p₁ → p₁ < p₂ → p₂ < p₃ → False :=
by
  intro R _ _ _ hcomp A _ _ _ eZ
  classical
  obtain ⟨π₀, π₁, hs₀, hs₁, -, -, -, -, -, -, hprime, hjoint⟩ := wcpa_dj_nccw_ebnb_q2_axes R

  have hQ2 : _root_.IsReduced (MvPowerSeries (Fin 2) R ⧸
      (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) R))) := by
    refine ⟨fun a ha => ?_⟩
    exact hjoint a (ha.map π₀).eq_zero (ha.map π₁).eq_zero

  have hinj : Function.Injective
      (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) := by
    intro x y hxy
    apply AdicCompletion.of_injective (IsLocalRing.maximalIdeal A) A
    simpa [AdicCompletion.algebraMap_apply] using hxy
  have hhat : _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
    isReduced_of_injective eZ eZ.injective
  refine ⟨isReduced_of_injective (algebraMap A _) hinj, ?_⟩
  intro p₀ p₁ p₂ p₃ hp₀ hp₁ hp₂ hp₃ h01 h12 h23

  have hchain : (∀ q : Ideal A, q.IsPrime → ∃ Q : Ideal (AdicCompletion (IsLocalRing.maximalIdeal A) A),
      Q.IsPrime ∧ Q.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = q) ∧
      (∀ p q : Ideal A, p.IsPrime → q.IsPrime → p ≤ q →
        ∀ Q : Ideal (AdicCompletion (IsLocalRing.maximalIdeal A) A), Q.IsPrime →
        Q.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = q →
        ∃ P : Ideal (AdicCompletion (IsLocalRing.maximalIdeal A) A), P.IsPrime ∧ P ≤ Q ∧
          P.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = p) := by
    haveI hflat : Module.Flat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      AdicCompletion.flat_of_isNoetherian (IsLocalRing.maximalIdeal A)
    haveI hff : Module.FaithfullyFlat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    haveI hgd : Algebra.HasGoingDown A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      Algebra.HasGoingDown.of_flat
    refine ⟨?_, ?_⟩
    · intro q hq
      obtain ⟨y, hy⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat
        (A := A) (B := AdicCompletion (IsLocalRing.maximalIdeal A) A) (⟨q, hq⟩ : PrimeSpectrum A)
      refine ⟨y.asIdeal, y.isPrime, ?_⟩
      have := congrArg PrimeSpectrum.asIdeal hy
      simpa [PrimeSpectrum.comap_asIdeal] using this
    · intro p q hp hq hpq Q hQ hQc
      rcases eq_or_lt_of_le hpq with h | h
      · exact ⟨Q, hQ, le_refl Q, by rw [hQc, h]⟩
      · haveI := hp
        haveI := hQ
        have hlt' : p < Ideal.under A Q := by
          rw [Ideal.under_def, hQc]; exact h
        obtain ⟨P, hPQ, hP, hlo⟩ := Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt Q hlt'
        refine ⟨P, hP, hPQ, ?_⟩
        rw [← Ideal.under_def]
        exact hlo.over.symm
  obtain ⟨hlift, hdown⟩ := hchain
  obtain ⟨Q₃, hQ₃, hQ₃c⟩ := hlift p₃ hp₃
  obtain ⟨Q₂, hQ₂, hQ₂le, hQ₂c⟩ := hdown p₂ p₃ hp₂ hp₃ h23.le Q₃ hQ₃ hQ₃c
  obtain ⟨Q₁, hQ₁, hQ₁le, hQ₁c⟩ := hdown p₁ p₂ hp₁ hp₂ h12.le Q₂ hQ₂ hQ₂c
  obtain ⟨Q₀, hQ₀, hQ₀le, hQ₀c⟩ := hdown p₀ p₁ hp₀ hp₁ h01.le Q₁ hQ₁ hQ₁c
  have s01 : Q₀ < Q₁ := lt_of_le_of_ne hQ₀le (fun h => h01.ne (by rw [← hQ₀c, ← hQ₁c, h]))
  have s12 : Q₁ < Q₂ := lt_of_le_of_ne hQ₁le (fun h => h12.ne (by rw [← hQ₁c, ← hQ₂c, h]))
  have s23 : Q₂ < Q₃ := lt_of_le_of_ne hQ₂le (fun h => h23.ne (by rw [← hQ₂c, ← hQ₃c, h]))

  have hcomapeq : ∀ Q : Ideal (AdicCompletion (IsLocalRing.maximalIdeal A) A),
      (Q.comap eZ.symm.toRingHom).comap eZ.toRingHom = Q := by
    intro Q
    ext x
    simp only [Ideal.mem_comap, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      RingEquiv.symm_apply_apply]
  have tr : ∀ Q Q' : Ideal (AdicCompletion (IsLocalRing.maximalIdeal A) A), Q < Q' →
      Q.comap eZ.symm.toRingHom < Q'.comap eZ.symm.toRingHom := by
    intro Q Q' h
    refine lt_of_le_of_ne (Ideal.comap_mono h.le) (fun he => h.ne ?_)
    rw [← hcomapeq Q, ← hcomapeq Q', he]
  haveI := hQ₀
  haveI := hQ₁
  haveI := hQ₂
  haveI := hQ₃
  have hP₀ : (Q₀.comap eZ.symm.toRingHom).IsPrime := Ideal.IsPrime.comap _
  have hP₁ : (Q₁.comap eZ.symm.toRingHom).IsPrime := Ideal.IsPrime.comap _
  have hP₂ : (Q₂.comap eZ.symm.toRingHom).IsPrime := Ideal.IsPrime.comap _
  have hP₃ : (Q₃.comap eZ.symm.toRingHom).IsPrime := Ideal.IsPrime.comap _

  rcases hprime _ hP₀ with hk | hk
  · exact wcpa_dj_nccw_ebnb_axis_chain R hcomp _ π₀ hs₀ _ _ _ _ hP₀ hP₁ hP₂ hP₃ hk
      (tr _ _ s01) (tr _ _ s12) (tr _ _ s23)
  · exact wcpa_dj_nccw_ebnb_axis_chain R hcomp _ π₁ hs₁ _ _ _ _ hP₀ hP₁ hP₂ hP₃ hk
      (tr _ _ s01) (tr _ _ s12) (tr _ _ s23)

theorem wcpa_dj_nccw_ebnb_kernel_axis : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ (D : Type u) [CommRing D] [IsDomain D] (Ψ : (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) →+* D), (∃ (n : ℕ) (c : Fin n → D), ∀ b : D, ∃ x : Fin n → (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), b = ∑ i, Ψ (x i) * c i) → (∃ Q₀ Q₁ Q₂ : Ideal D, Q₀.IsPrime ∧ Q₁.IsPrime ∧ Q₂.IsPrime ∧ Q₀ < Q₁ ∧ Q₁ < Q₂) → ∃ πs : (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) →+* PowerSeries R, Function.Surjective πs ∧ RingHom.ker πs = RingHom.ker Ψ ∧ (∀ r : R, πs (Ideal.Quotient.mk _ (MvPowerSeries.C r)) = PowerSeries.C r) ∧ ((πs (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = PowerSeries.X ∧ πs (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = 0) ∨ (πs (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = 0 ∧ πs (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = PowerSeries.X)) :=
by
  intro R _ _ _ hcomp D _ _ Ψ hfin hch
  obtain ⟨Q₀, Q₁, Q₂, hQ₀, hQ₁, hQ₂, h01, h12⟩ := hch
  obtain ⟨π₀, π₁, hs₀, hs₁, hC₀, hC₁, hx₀, hy₀, hx₁, hy₁, hprime, -⟩ :=
    wcpa_dj_nccw_ebnb_q2_axes R

  have hgen : ∀ (B : Type u) [CommRing B] (Φ : B →+* D),
      (∃ (n : ℕ) (c : Fin n → D), ∀ b : D, ∃ x : Fin n → B, b = ∑ i, Φ (x i) * c i) →
      ∀ Q Q' : Ideal D, Q.IsPrime → Q < Q' → Q.comap Φ < Q'.comap Φ := by
    intro B _ Φ hf Q Q' hQ hQQ'
    classical
    obtain ⟨n, c, hc⟩ := hf
    letI : Algebra B D := Φ.toAlgebra
    haveI : Module.Finite B D := by
      refine ⟨⟨Finset.univ.image c, ?_⟩⟩
      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
      refine Submodule.eq_top_iff'.mpr fun b => ?_
      obtain ⟨x, hx⟩ := hc b
      rw [Submodule.mem_span_range_iff_exists_fun]
      refine ⟨x, ?_⟩
      rw [hx]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]
    haveI : Algebra.IsIntegral B D := Algebra.IsIntegral.of_finite B D
    obtain ⟨y, hy', hy⟩ := SetLike.exists_of_lt hQQ'
    exact Ideal.under_lt_under_of_integral_mem_sdiff hQQ'.le ⟨hy', hy⟩
      (Algebra.IsIntegral.isIntegral y)
  have hlt : ∀ Q Q' : Ideal D, Q.IsPrime → Q < Q' → Q.comap Ψ < Q'.comap Ψ :=
    hgen _ Ψ hfin
  have hP0 : RingHom.ker Ψ ≤ Q₀.comap Ψ := fun a ha => by
    rw [Ideal.mem_comap, (RingHom.mem_ker).mp ha]
    exact Q₀.zero_mem
  have h01' := hlt Q₀ Q₁ hQ₀ h01
  have h12' := hlt Q₁ Q₂ hQ₁ h12
  haveI hPprime : (RingHom.ker Ψ).IsPrime := RingHom.ker_isPrime Ψ
  have key : ∀ π : (MvPowerSeries (Fin 2) R ⧸
      Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) →+* PowerSeries R,
      Function.Surjective π → RingHom.ker π ≤ RingHom.ker Ψ → RingHom.ker π = RingHom.ker Ψ := by
    intro π hs hle
    rcases lt_or_eq_of_le hle with hlt' | heq
    · exact (wcpa_dj_nccw_ebnb_axis_chain R hcomp _ π hs (RingHom.ker π) (Q₀.comap Ψ)
        (Q₁.comap Ψ) (Q₂.comap Ψ) (RingHom.ker_isPrime π) (Ideal.IsPrime.comap Ψ)
        (Ideal.IsPrime.comap Ψ) (Ideal.IsPrime.comap Ψ) le_rfl (lt_of_lt_of_le hlt' hP0)
        h01' h12').elim
    · exact heq
  rcases hprime (RingHom.ker Ψ) hPprime with h | h
  · exact ⟨π₀, hs₀, key π₀ hs₀ h, hC₀, Or.inl ⟨hx₀, hy₀⟩⟩
  · exact ⟨π₁, hs₁, key π₁ hs₁ h, hC₁, Or.inr ⟨hx₁, hy₁⟩⟩

theorem wcpa_dj_nccw_ebnb_completion_chain : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], (∀ q : Ideal A, q.IsPrime → ∃ Q : Ideal (AdicCompletion (IsLocalRing.maximalIdeal A) A), Q.IsPrime ∧ Q.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = q) ∧ (∀ p q : Ideal A, p.IsPrime → q.IsPrime → p ≤ q → ∀ Q : Ideal (AdicCompletion (IsLocalRing.maximalIdeal A) A), Q.IsPrime → Q.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = q → ∃ P : Ideal (AdicCompletion (IsLocalRing.maximalIdeal A) A), P.IsPrime ∧ P ≤ Q ∧ P.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = p) :=
by
  intro A _ _ _
  haveI hflat : Module.Flat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
    AdicCompletion.flat_of_isNoetherian (IsLocalRing.maximalIdeal A)
  haveI hff : Module.FaithfullyFlat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  haveI hgd : Algebra.HasGoingDown A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
    Algebra.HasGoingDown.of_flat
  refine ⟨?_, ?_⟩
  · intro q hq
    obtain ⟨y, hy⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat
      (A := A) (B := AdicCompletion (IsLocalRing.maximalIdeal A) A) (⟨q, hq⟩ : PrimeSpectrum A)
    refine ⟨y.asIdeal, y.isPrime, ?_⟩
    have := congrArg PrimeSpectrum.asIdeal hy
    simpa [PrimeSpectrum.comap_asIdeal] using this
  · intro p q hp hq hpq Q hQ hQc
    rcases eq_or_lt_of_le hpq with h | h
    · exact ⟨Q, hQ, le_refl Q, by rw [hQc, h]⟩
    · haveI := hp
      haveI := hQ
      have hlt' : p < Ideal.under A Q := by
        rw [Ideal.under_def, hQc]; exact h
      obtain ⟨P, hPQ, hP, hlo⟩ := Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt Q hlt'
      refine ⟨P, hP, hPQ, ?_⟩
      rw [← Ideal.under_def]
      exact hlo.over.symm

theorem wcpa_dj_nccw_ebnb_finite_birational_iso : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R] (B D : Type u) [CommRing B] [CommRing D] [IsDomain D] (Ψ : B →+* D) (πs : B →+* PowerSeries R), Function.Surjective πs → RingHom.ker πs = RingHom.ker Ψ → ∀ (n : ℕ) (c : Fin n → D), (∀ b : D, ∃ x : Fin n → B, b = ∑ i, Ψ (x i) * c i) → (∀ i, ∃ x t : B, Ψ t ≠ 0 ∧ Ψ t * c i = Ψ x) → ∃ e : D ≃+* PowerSeries R, ∀ y : B, e (Ψ y) = πs y :=
by
  classical
  intro R _ _ _ B D _ _ _ Ψ πs hs hk n c hgen hden

  have s3 : ∀ (c : R) (z : FractionRing R), c ≠ 0 → (∀ k : ℕ, ∃ r : R,
      algebraMap R (FractionRing R) r = algebraMap R (FractionRing R) c * z ^ k) →
      ∃ r : R, algebraMap R (FractionRing R) r = z := by
    intro c z hc h
    have hc' : algebraMap R (FractionRing R) c ≠ 0 := by
      intro h0; apply hc; exact IsFractionRing.injective R (FractionRing R) (by rw [h0, map_zero])
    have hle : Subalgebra.toSubmodule (Algebra.adjoin R {z}) ≤
        Submodule.span R {(algebraMap R (FractionRing R) c)⁻¹} := by
      rw [Algebra.adjoin_eq_span, Submodule.span_le]
      rintro x hx
      obtain ⟨k, rfl⟩ := Submonoid.mem_closure_singleton.mp hx
      obtain ⟨r, hr⟩ := h k
      rw [SetLike.mem_coe, Submodule.mem_span_singleton]
      refine ⟨r, ?_⟩
      rw [Algebra.smul_def, hr, mul_right_comm, mul_inv_cancel₀ hc', one_mul]
    have hfg : (Subalgebra.toSubmodule (Algebra.adjoin R {z})).FG :=
      Submodule.FG.of_le (Submodule.fg_span_singleton _) hle
    have hint : IsIntegral R z :=
      IsIntegral.of_mem_of_fg _ hfg z (Algebra.self_mem_adjoin_singleton R z)
    exact IsIntegrallyClosed.isIntegral_iff.mp hint

  have s4 : ∀ (τ a : PowerSeries R), τ ≠ 0 → (∀ k : ℕ, τ ^ k ∣ a ^ (k + 1)) →
      ∃ f : PowerSeries (FractionRing R),
        PowerSeries.map (algebraMap R (FractionRing R)) τ * f =
          PowerSeries.map (algebraMap R (FractionRing R)) a ∧
        ∀ k : ℕ, ∃ b : PowerSeries R, PowerSeries.map (algebraMap R (FractionRing R)) τ * f ^ k =
          PowerSeries.map (algebraMap R (FractionRing R)) b := by
    intro τ a hτ hk
    have hMinj : Function.Injective (PowerSeries.map (algebraMap R (FractionRing R))) :=
      PowerSeries.map_injective _ (IsFractionRing.injective R (FractionRing R))
    have hMτ : PowerSeries.map (algebraMap R (FractionRing R)) τ ≠ 0 :=
      fun h => hτ (hMinj (by rw [h, map_zero]))
    obtain ⟨f, hf⟩ : ∃ f : PowerSeries (FractionRing R),
        PowerSeries.map (algebraMap R (FractionRing R)) τ * f =
          PowerSeries.map (algebraMap R (FractionRing R)) a := by
      by_cases ha : a = 0
      · exact ⟨0, by rw [ha, map_zero, mul_zero]⟩
      have hτo : τ.order ≠ ⊤ := by rwa [Ne, PowerSeries.order_eq_top]
      have hao : a.order ≠ ⊤ := by rwa [Ne, PowerSeries.order_eq_top]
      obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hτo
      obtain ⟨p, hp⟩ := ENat.ne_top_iff_exists.mp hao
      have hmt : τ.order.toNat = m := by rw [← hm]; exact ENat.toNat_coe m
      obtain ⟨w, hw⟩ := hk m
      have hord := congrArg PowerSeries.order hw
      rw [PowerSeries.order_mul, PowerSeries.order_pow, PowerSeries.order_pow, ← hm, ← hp] at hord
      have hle : m • (m : ℕ∞) ≤ (m + 1) • (p : ℕ∞) := by
        rw [hord]; exact le_self_add
      simp only [nsmul_eq_mul] at hle
      have hle' : m * m ≤ (m + 1) * p := by exact_mod_cast hle
      have hmp : m ≤ p := by
        by_contra hcon
        push_neg at hcon
        have := Nat.mul_le_mul_left (m + 1) (Nat.succ_le_of_lt hcon)
        nlinarith
      have hXa : (PowerSeries.X : PowerSeries R) ^ τ.order.toNat ∣ a := by
        rw [hmt, PowerSeries.X_pow_dvd_iff]
        intro i hi
        apply PowerSeries.coeff_of_lt_order
        rw [← hp]
        exact_mod_cast lt_of_lt_of_le hi hmp
      obtain ⟨g, hg⟩ := hXa
      have hτu := PowerSeries.X_pow_order_mul_divXPowOrder (f := τ)
      have hu0 : PowerSeries.constantCoeff
          (PowerSeries.map (algebraMap R (FractionRing R)) τ.divXPowOrder) ≠ 0 := by
        rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_map,
          PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.constantCoeff_divXPowOrder]
        intro h0
        exact PowerSeries.coeff_order hτ
          (IsFractionRing.injective R (FractionRing R) (by rw [h0, map_zero]))
      have hMτ' : PowerSeries.map (algebraMap R (FractionRing R)) τ =
          PowerSeries.X ^ τ.order.toNat *
            PowerSeries.map (algebraMap R (FractionRing R)) τ.divXPowOrder := by
        conv_lhs => rw [← hτu]
        rw [map_mul, map_pow, PowerSeries.map_X]
      refine ⟨PowerSeries.map (algebraMap R (FractionRing R)) g *
        (PowerSeries.map (algebraMap R (FractionRing R)) τ.divXPowOrder)⁻¹, ?_⟩
      rw [hMτ', hg, map_mul, map_pow, PowerSeries.map_X]
      calc PowerSeries.X ^ τ.order.toNat *
            PowerSeries.map (algebraMap R (FractionRing R)) τ.divXPowOrder *
            (PowerSeries.map (algebraMap R (FractionRing R)) g *
              (PowerSeries.map (algebraMap R (FractionRing R)) τ.divXPowOrder)⁻¹)
          = PowerSeries.X ^ τ.order.toNat * PowerSeries.map (algebraMap R (FractionRing R)) g *
            (PowerSeries.map (algebraMap R (FractionRing R)) τ.divXPowOrder *
              (PowerSeries.map (algebraMap R (FractionRing R)) τ.divXPowOrder)⁻¹) := by ring
        _ = _ := by rw [PowerSeries.mul_inv_cancel _ hu0, mul_one]
    refine ⟨f, hf, fun k => ?_⟩
    cases k with
    | zero => exact ⟨τ, by rw [pow_zero, mul_one]⟩
    | succ j =>
      obtain ⟨b, hb⟩ := hk j
      refine ⟨b, mul_left_cancel₀ (pow_ne_zero j hMτ) ?_⟩
      calc PowerSeries.map (algebraMap R (FractionRing R)) τ ^ j *
            (PowerSeries.map (algebraMap R (FractionRing R)) τ * f ^ (j + 1))
          = (PowerSeries.map (algebraMap R (FractionRing R)) τ * f) ^ (j + 1) := by ring
        _ = PowerSeries.map (algebraMap R (FractionRing R)) (τ ^ j * b) := by
          rw [hf, ← map_pow, hb]
        _ = PowerSeries.map (algebraMap R (FractionRing R)) τ ^ j *
            PowerSeries.map (algebraMap R (FractionRing R)) b := by rw [map_mul, map_pow]

  have s5 : ∀ (τ : PowerSeries R) (f : PowerSeries (FractionRing R)), τ ≠ 0 →
      (∀ k : ℕ, ∃ b : PowerSeries R, PowerSeries.map (algebraMap R (FractionRing R)) τ * f ^ k =
        PowerSeries.map (algebraMap R (FractionRing R)) b) →
      ∃ F : PowerSeries R, PowerSeries.map (algebraMap R (FractionRing R)) F = f := by
    intro τ f hτ hb
    have hc : PowerSeries.coeff τ.order.toNat τ ≠ 0 := PowerSeries.coeff_order hτ
    have hτu := PowerSeries.X_pow_order_mul_divXPowOrder (f := τ)
    have hMτ' : PowerSeries.map (algebraMap R (FractionRing R)) τ =
        PowerSeries.X ^ τ.order.toNat *
          PowerSeries.map (algebraMap R (FractionRing R)) τ.divXPowOrder := by
      conv_lhs => rw [← hτu]
      rw [map_mul, map_pow, PowerSeries.map_X]
    have hU0 : PowerSeries.constantCoeff
        (PowerSeries.map (algebraMap R (FractionRing R)) τ.divXPowOrder) =
          algebraMap R (FractionRing R) (PowerSeries.coeff τ.order.toNat τ) := by
      rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_map,
        PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.constantCoeff_divXPowOrder]
    have hbS : ∀ k, PowerSeries.map (algebraMap R (FractionRing R)) τ * f ^ k ∈
        (PowerSeries.map (algebraMap R (FractionRing R))).range := by
      intro k
      obtain ⟨b, hb⟩ := hb k
      exact RingHom.mem_range.mpr ⟨b, hb.symm⟩
    have key : ∀ n, ∃ r : R, algebraMap R (FractionRing R) r = PowerSeries.coeff n f := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n IH =>
        let g : PowerSeries R :=
          PowerSeries.mk (fun i => if h : i < n then Classical.choose (IH i h) else 0)
        have hg : ∀ i, PowerSeries.coeff i (PowerSeries.map (algebraMap R (FractionRing R)) g) =
            if i < n then PowerSeries.coeff i f else 0 := by
          intro i
          rw [PowerSeries.coeff_map, PowerSeries.coeff_mk]
          split_ifs with h
          · exact Classical.choose_spec (IH i h)
          · exact map_zero _
        have hh : ∀ i < n, PowerSeries.coeff i
            (f - PowerSeries.map (algebraMap R (FractionRing R)) g) = 0 := by
          intro i hi
          rw [map_sub, hg, if_pos hi, sub_self]
        obtain ⟨H, hH⟩ := PowerSeries.X_pow_dvd_iff.mpr hh
        have hH0 : PowerSeries.constantCoeff H = PowerSeries.coeff n f := by
          have e1 : PowerSeries.coeff n (f - PowerSeries.map (algebraMap R (FractionRing R)) g) =
              PowerSeries.coeff n f := by
            rw [map_sub, hg, if_neg (lt_irrefl n), sub_zero]
          rw [← e1, hH, PowerSeries.coeff_X_pow_mul', if_pos le_rfl, Nat.sub_self,
            PowerSeries.coeff_zero_eq_constantCoeff_apply]
        have hhS : ∀ k, PowerSeries.map (algebraMap R (FractionRing R)) τ *
            (f - PowerSeries.map (algebraMap R (FractionRing R)) g) ^ k ∈
            (PowerSeries.map (algebraMap R (FractionRing R))).range := by
          intro k
          have e : PowerSeries.map (algebraMap R (FractionRing R)) τ *
              (f - PowerSeries.map (algebraMap R (FractionRing R)) g) ^ k =
              ∑ i ∈ Finset.range (k + 1),
                (PowerSeries.map (algebraMap R (FractionRing R)) τ * f ^ i) *
                (-(PowerSeries.map (algebraMap R (FractionRing R)) g)) ^ (k - i) *
                ((k.choose i : ℕ) : PowerSeries (FractionRing R)) := by
            rw [sub_eq_add_neg, add_pow, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun i _ => by ring)
          rw [e]
          refine Subring.sum_mem _ (fun i _ => ?_)
          exact Subring.mul_mem _ (Subring.mul_mem _ (hbS i)
            (Subring.pow_mem _ (Subring.neg_mem _ (RingHom.mem_range.mpr ⟨g, rfl⟩)) _))
            (RingHom.mem_range.mpr ⟨_, map_natCast _ _⟩)
        have hlead : ∀ k, PowerSeries.coeff (τ.order.toNat + n * k)
            (PowerSeries.map (algebraMap R (FractionRing R)) τ *
              (f - PowerSeries.map (algebraMap R (FractionRing R)) g) ^ k) =
            algebraMap R (FractionRing R) (PowerSeries.coeff τ.order.toNat τ) *
              (PowerSeries.coeff n f) ^ k := by
          intro k
          have e : PowerSeries.map (algebraMap R (FractionRing R)) τ *
              (f - PowerSeries.map (algebraMap R (FractionRing R)) g) ^ k =
              PowerSeries.X ^ (τ.order.toNat + n * k) *
                (PowerSeries.map (algebraMap R (FractionRing R)) τ.divXPowOrder * H ^ k) := by
            rw [hMτ', hH, mul_pow, ← pow_mul, pow_add]
            ring
          rw [e, PowerSeries.coeff_X_pow_mul', if_pos le_rfl, Nat.sub_self,
            PowerSeries.coeff_zero_eq_constantCoeff_apply, map_mul, map_pow, hU0, hH0]
        obtain ⟨r, hr⟩ := s3 (PowerSeries.coeff τ.order.toNat τ) (PowerSeries.coeff n f) hc
          (fun k => by
            obtain ⟨β, hβ⟩ := hhS k
            refine ⟨PowerSeries.coeff (τ.order.toNat + n * k) β, ?_⟩
            rw [← hlead k, ← hβ, PowerSeries.coeff_map])
        exact ⟨r, hr⟩
    choose F hF using key
    refine ⟨PowerSeries.mk F, ?_⟩
    ext n
    rw [PowerSeries.coeff_map, PowerSeries.coeff_mk, hF]

  have P : ∀ (τ a : PowerSeries R), τ ≠ 0 → (∀ k : ℕ, τ ^ k ∣ a ^ (k + 1)) → τ ∣ a := by
    intro τ a hτ hk
    obtain ⟨f, hf, hfk⟩ := s4 τ a hτ hk
    obtain ⟨F, hF⟩ := s5 τ f hτ hfk
    refine ⟨F, PowerSeries.map_injective _ (IsFractionRing.injective R (FractionRing R)) ?_⟩
    rw [map_mul, hF, hf]

  obtain ⟨φ, hφi, hφ⟩ : ∃ φ : PowerSeries R →+* D, Function.Injective φ ∧
      ∀ y : B, φ (πs y) = Ψ y := by
    refine ⟨RingHom.liftOfRightInverse πs (Function.surjInv hs) (Function.rightInverse_surjInv hs)
      ⟨Ψ, hk ▸ le_rfl⟩, ?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro a ha
      obtain ⟨y, rfl⟩ := hs a
      rw [RingHom.liftOfRightInverse_comp_apply] at ha
      have : y ∈ RingHom.ker Ψ := ha
      rw [← hk] at this
      exact this
    · intro y
      exact RingHom.liftOfRightInverse_comp_apply _ _ _ _ y

  obtain ⟨τ, hτ, hτd⟩ : ∃ τ : B, Ψ τ ≠ 0 ∧ ∀ d : D, ∃ y : B, Ψ τ * d = Ψ y := by
    choose x' t ht hxt using hden
    refine ⟨∏ i, t i, ?_, ?_⟩
    · rw [map_prod]
      exact Finset.prod_ne_zero_iff.mpr (fun i _ => ht i)
    · intro d
      obtain ⟨x, rfl⟩ := hgen d
      refine ⟨∑ i, x i * (∏ j ∈ Finset.univ.erase i, t j) * x' i, ?_⟩
      rw [Finset.mul_sum, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← Finset.mul_prod_erase Finset.univ t (Finset.mem_univ i), map_mul, map_mul, map_mul,
        map_prod, ← hxt i]
      ring

  have hτ0 : πs τ ≠ 0 := fun h => hτ (by rw [← hφ, h, map_zero])
  have hsurj : Function.Surjective φ := by
    intro d
    obtain ⟨y, hy⟩ := hτd d
