          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β0 b) -
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β0 a) := by
    intro c0 hc0
    obtain ⟨β', hβ'⟩ := R (fun a b =>
      (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
        L.V a ⊓ L.V b ≤ L.V a ⊓ L.V b ⊓ ⊤)).op).hom (c0 a b)) (by
      intro a b d
      have h := congrArg (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
