      exact ⟨key, fun x hx => key x (by rw [mul_comm]; exact hx)⟩
    have htb : φ ϖ ∈ IsLocalRing.maximalIdeal ↑(Z'.presheaf.stalk ξ) := by
      have h1 := hKpt (IsLocalRing.closedPoint _)
      rw [Scheme.fromSpecStalk_closedPoint, hξ] at h1
      have h2 : Ideal.comap φ (IsLocalRing.maximalIdeal ↑(Z'.presheaf.stalk ξ)) =
          IsLocalRing.maximalIdeal R := by
        have := congrArg PrimeSpectrum.asIdeal h1
        exact this.symm
      have h3 : ϖ ∈ IsLocalRing.maximalIdeal R := hϖ.not_isUnit
      rw [← h2] at h3
      exact h3
    have hc : ∀ J : Ideal ↑(Z'.presheaf.stalk ξ), J.IsPrime → φ ϖ ∈ J →
        J = IsLocalRing.maximalIdeal ↑(Z'.presheaf.stalk ξ) := by
      intro J hJ htJ
      let P : Spec (Z'.presheaf.stalk ξ) := (⟨J, hJ⟩ : PrimeSpectrum ↑(Z'.presheaf.stalk ξ))
      have hcm : Ideal.comap φ J = IsLocalRing.maximalIdeal R := by
        apply IsLocalRing.eq_maximalIdeal
        apply Ideal.IsPrime.isMaximal (Ideal.comap_isPrime φ J)
        intro hbot
