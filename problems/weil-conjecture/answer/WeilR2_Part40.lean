      IsPullback.isoIsPullback _ _ Sq_c Sq_b
    let Ψ : Limits.pullback j pr ≅ Spec (.of (TensorProduct Γ(S, W) Γ(N, V) A)) :=
      κ ≪≫ pullbackSpecIso Γ(S, W) Γ(N, V) A
