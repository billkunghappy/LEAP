  obtain ⟨e, he⟩ := s6 Z' Y a' ha' ξ (fun y hy hne =>
    (wcpa_dj_ldx_range_generic R Z' Y u' π a' hpb' y).mpr (fun hy' => hne (hmax y hy' hy)))
