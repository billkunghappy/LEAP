        simp only at h1
        rw [pt (E2 i) p, pt (E2 i') q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
        exact h1
      · intro i p
        obtain ⟨W, hW, hWsm⟩ := hS3 i (b p)
        refine ⟨Limits.pullback.fst uu b ⁻¹ᵁ W, ?_, ?_⟩
        · show Limits.pullback.fst uu b (τ' i p) ∈ W
          rw [pt (E2 i) p, Scheme.Hom.comp_apply]
          exact hW
        · have h1 : IsPullback (Limits.pullback.fst uu b ∣_ W) (Limits.pullback.fst uu b ⁻¹ᵁ W).ι
              W.ι (Limits.pullback.fst uu b) := isPullback_morphismRestrict _ W
          have h2 : IsPullback (Limits.pullback.fst uu b ∣_ W)
              ((Limits.pullback.fst uu b ⁻¹ᵁ W).ι ≫ Limits.pullback.snd uu b) (W.ι ≫ uu) b :=
            h1.paste_vert hpb
          exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hWsm

    have hstab' : ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T')
        (E : Set ↥(Limits.pullback (Limits.pullback.snd uu b) s)),
        E ∈ irreducibleComponents ↥(Limits.pullback (Limits.pullback.snd uu b) s) →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback (Limits.pullback.snd uu b) s)
            (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd (Limits.pullback.snd uu b) s) →
        3 ≤ (E ∩ closure Eᶜ).ncard +
          Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)} := by
      intro K _ _ s E hE hdat
      obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
      obtain ⟨e, I1, I2⟩ : ∃ e : Limits.pullback (Limits.pullback.snd uu b) s ≅
          Limits.pullback uu (s ≫ b),
          e.hom ≫ Limits.pullback.fst uu (s ≫ b) =
            Limits.pullback.fst (Limits.pullback.snd uu b) s ≫ Limits.pullback.fst uu b ∧
          e.hom ≫ Limits.pullback.snd uu (s ≫ b) = Limits.pullback.snd (Limits.pullback.snd uu b) s :=
        ⟨_, Limits.pullbackLeftPullbackSndIso_hom_fst uu b s,
          Limits.pullbackLeftPullbackSndIso_hom_snd uu b s⟩
      obtain ⟨h, hh⟩ : ∃ h : ↥(Limits.pullback (Limits.pullback.snd uu b) s) ≃ₜ
          ↥(Limits.pullback uu (s ≫ b)), ∀ x, h x = e.hom x :=
        ⟨Scheme.homeoOfIso e, Scheme.homeoOfIso_apply e⟩
      have hE0 : h '' E ∈ irreducibleComponents ↥(Limits.pullback uu (s ≫ b)) := by
        refine image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
          ?_ h.surjective hE
        intro y
        apply Set.Subsingleton.isPreirreducible
        intro a ha a' ha'
        exact h.injective (ha.trans ha'.symm)
      have hcnt : (h '' E ∩ closure (h '' E)ᶜ).ncard = (E ∩ closure Eᶜ).ncard := by
        rw [← h.image_compl, ← h.image_closure, ← Set.image_inter h.injective]
        exact Set.ncard_image_of_injective _ h.injective
      have hdat0 : ∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu (s ≫ b))
            (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = h '' E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd uu (s ≫ b) := by
        refine ⟨Er, ι ≫ e.hom, θ, inferInstance, hred, ?_, ?_⟩
        · ext y
          constructor
          · rintro ⟨x, rfl⟩
            refine ⟨ι x, ?_, ?_⟩
            · rw [← hrange]; exact ⟨x, rfl⟩
            · rw [hh, Scheme.Hom.comp_apply]
          · rintro ⟨z, hz, rfl⟩
            rw [← hrange] at hz
            obtain ⟨x, rfl⟩ := hz
            exact ⟨x, by rw [hh, Scheme.Hom.comp_apply]⟩
        · rw [hθ, Category.assoc, I2]
      have key := hstab K (s ≫ b) (h '' E) hE0 hdat0
      have hiff : ∀ i : Fin n,
          (∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)) ↔
          (∃ y ∈ h '' E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst uu (s ≫ b) y = τ i ((s ≫ b) p)) := by
        intro i
        constructor
        · rintro ⟨x, hx, p, hp⟩
          refine ⟨h x, ⟨x, hx, rfl⟩, p, ?_⟩
          rw [hh, pt I1 x, Scheme.Hom.comp_apply, hp, pt (E2 i) (s p), Scheme.Hom.comp_apply,
            Scheme.Hom.comp_apply]
        · rintro ⟨y, ⟨x, hx, rfl⟩, p, hp⟩
          refine ⟨x, hx, p, ?_⟩
          set c := Limits.pullback.fst (Limits.pullback.snd uu b) s x with hc
          have e1 : Limits.pullback.fst uu b c = τ i (b (s p)) := by
            have h1 := pt I1 x
            rw [Scheme.Hom.comp_apply, ← hh, hp, Scheme.Hom.comp_apply] at h1
            exact h1.symm
          have e2 : Limits.pullback.snd uu b c = s p := by
            rw [hc, pt (Limits.pullback.condition (f := Limits.pullback.snd uu b) (g := s)) x,
              Scheme.Hom.comp_apply,
              Subsingleton.elim (Limits.pullback.snd (Limits.pullback.snd uu b) s x) p]
          have hc1 : Limits.pullback.fst uu b c = τ i (b (Limits.pullback.snd uu b c)) := by
            rw [e2]; exact e1
          have key2 := (wcpa_dj_mm_section_point_unique Z T T' (Limits.pullback uu b) uu b
            (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) (τ i) (τ' i) hpb (hS1 i) (E1 i)
            (E2 i) c).mp hc1
          rw [key2, e2]
      have hcard : Nat.card {i : Fin n // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst (Limits.pullback.snd uu b) s x = τ' i (s p)} =
          Nat.card {i : Fin n // ∃ y ∈ h '' E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst uu (s ≫ b) y = τ i ((s ≫ b) p)} :=
        Nat.card_congr (Equiv.subtypeEquivRight hiff)
      rw [hcard, ← hcnt]
      exact key
    exact ⟨τ', ⟨wcpa_dj_mm_semistable_basechange T T' Z b uu hss, hsec', hstab'⟩, E1, E2⟩
  intro T Z Z' u u' n τ τ' hst hst' hgc hgc' V Y v π a a' hpb hpb' hsec R _ _ _ b e hgb

  obtain ⟨τb, hτbst, hτbs, hτbf⟩ := wcpa_dj_lcp_stableptd_basechange u n τ b hst
  obtain ⟨τb', hτbst', hτbs', hτbf'⟩ := wcpa_dj_lcp_stableptd_basechange u' n τ' b hst'

  have hgcb : GeometricallyConnected (Limits.pullback.snd u b) :=
    MorphismProperty.of_isPullback (P := @GeometricallyConnected)
      (IsPullback.of_hasPullback u b) hgc
  have hgcb' : GeometricallyConnected (Limits.pullback.snd u' b) :=
    MorphismProperty.of_isPullback (P := @GeometricallyConnected)
      (IsPullback.of_hasPullback u' b) hgc'

  have hq : Limits.pullback.fst π (e ≫ π) ≫ π = Limits.pullback.snd π (e ≫ π) ≫ e ≫ π :=
    Limits.pullback.condition
  have hgb' : Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ b =
      (e ≫ π) ≫ v := by
    rw [hgb, Category.assoc]
  have wK : (Limits.pullback.fst π (e ≫ π) ≫ a) ≫ u =
      (Limits.pullback.snd π (e ≫ π) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) ≫ b := by
    simp only [Category.assoc]
    rw [hpb.w, reassoc_of% hq, hgb]
  have wK' : (Limits.pullback.fst π (e ≫ π) ≫ a') ≫ u' =
      (Limits.pullback.snd π (e ≫ π) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) ≫ b := by
    simp only [Category.assoc]
    rw [hpb'.w, reassoc_of% hq, hgb]
  obtain ⟨aK, haK1, haK2⟩ : ∃ aK : Limits.pullback π (e ≫ π) ⟶ Limits.pullback u b,
      aK ≫ Limits.pullback.fst u b = Limits.pullback.fst π (e ≫ π) ≫ a ∧
      aK ≫ Limits.pullback.snd u b = Limits.pullback.snd π (e ≫ π) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) :=
    ⟨Limits.pullback.lift _ _ wK, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨aK', haK1', haK2'⟩ : ∃ aK' : Limits.pullback π (e ≫ π) ⟶ Limits.pullback u' b,
      aK' ≫ Limits.pullback.fst u' b = Limits.pullback.fst π (e ≫ π) ≫ a' ∧
      aK' ≫ Limits.pullback.snd u' b = Limits.pullback.snd π (e ≫ π) ≫
        Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) :=
    ⟨Limits.pullback.lift _ _ wK', Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have hpbK : IsPullback aK (Limits.pullback.snd π (e ≫ π)) (Limits.pullback.snd u b)
      (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := by
    refine IsPullback.of_right (h₁₂ := Limits.pullback.fst u b) (h₂₂ := b) (v₁₃ := u) ?_ haK2
      (IsPullback.of_hasPullback u b)
    rw [haK1, hgb']
    exact (IsPullback.of_hasPullback π (e ≫ π)).paste_horiz hpb
  have hpbK' : IsPullback aK' (Limits.pullback.snd π (e ≫ π)) (Limits.pullback.snd u' b)
      (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := by
    refine IsPullback.of_right (h₁₂ := Limits.pullback.fst u' b) (h₂₂ := b) (v₁₃ := u') ?_ haK2'
      (IsPullback.of_hasPullback u' b)
    rw [haK1', hgb']
    exact (IsPullback.of_hasPullback π (e ≫ π)).paste_horiz hpb'

  have wsK : e ≫ π = 𝟙 _ ≫ (e ≫ π) := by rw [Category.id_comp]
  refine ⟨τb, τb', Limits.pullback π (e ≫ π), Limits.pullback.snd π (e ≫ π), aK, aK',
    Limits.pullback.lift e (𝟙 _) wsK, hτbst, hτbst', hgcb, hgcb',
    fun i => ⟨hτbs i, hτbf i⟩, fun i => ⟨hτbs' i, hτbf' i⟩, hpbK, hpbK', ?_,
    Limits.pullback.lift_snd _ _ _, ?_, ?_⟩
  ·
    intro i
    obtain ⟨t0, h1, h2, h3⟩ := hsec i
    have wt : (e ≫ π ≫ t0) ≫ π = 𝟙 _ ≫ (e ≫ π) := by
      rw [Category.assoc, Category.assoc, h1, Category.comp_id, Category.id_comp]
    refine ⟨Limits.pullback.lift (e ≫ π ≫ t0) (𝟙 _) wt, Limits.pullback.lift_snd _ _ _, ?_, ?_⟩
    · apply Limits.pullback.hom_ext
      · simp only [Category.assoc, haK1, Limits.pullback.lift_fst_assoc, h2, hτbf]
        rw [reassoc_of% hgb]
      · simp only [Category.assoc, haK2, Limits.pullback.lift_snd_assoc, hτbs,
          Category.id_comp, Category.comp_id]
    · apply Limits.pullback.hom_ext
      · simp only [Category.assoc, haK1', Limits.pullback.lift_fst_assoc, h3, hτbf']
        rw [reassoc_of% hgb]
      · simp only [Category.assoc, haK2', Limits.pullback.lift_snd_assoc, hτbs',
          Category.id_comp, Category.comp_id]
  · rw [haK1, Limits.pullback.lift_fst_assoc]
  · rw [haK1', Limits.pullback.lift_fst_assoc]

theorem wcpa_dj_lqg_generization : ∀ (X : Scheme.{u}) [IsLocallyNoetherian X] (U : Set X), IsOpen U → Dense U → ∀ x : X, ∃ ξ ∈ U, ξ ⤳ x :=
by
  intro X _ U hUo hUd x
  obtain ⟨W, hW, hxW, -⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
    (U := (⊤ : X.Opens)) (x := x) (by trivial)
  haveI : IsNoetherianRing Γ(X, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
  haveI : TopologicalSpace.NoetherianSpace ↥(W : Set X) :=
    AlgebraicGeometry.noetherianSpace_of_isAffineOpen W hW
  let x' : ↥(W : Set X) := ⟨x, hxW⟩
  set Z : Set ↥(W : Set X) := irreducibleComponent x' with hZ
  have hZmem : Z ∈ irreducibleComponents ↥(W : Set X) :=
    irreducibleComponent_mem_irreducibleComponents x'
  have hZirr : IsIrreducible Z := isIrreducible_irreducibleComponent
  have hxZ : x' ∈ Z := mem_irreducibleComponent
  obtain ⟨o, ho, hone, hoZ⟩ :=
    TopologicalSpace.NoetherianSpace.exists_isOpen_nonempty_subset_irreducibleComponent Z hZmem
  have hS₀ : IsIrreducible (Subtype.val '' Z) :=
    hZirr.image _ continuous_subtype_val.continuousOn
  have hη : IsGenericPoint hS₀.genericPoint (closure (Subtype.val '' Z)) :=
    hS₀.isGenericPoint_genericPoint_closure
  refine ⟨hS₀.genericPoint, ?_, ?_⟩
  · have hopen : IsOpen (Subtype.val '' o : Set X) := W.isOpen.isOpenMap_subtype_val o ho
    obtain ⟨p, hpo, hpU⟩ := hUd.inter_open_nonempty _ hopen (hone.image _)
    have hpS : p ∈ closure (Subtype.val '' Z) :=
      subset_closure (by obtain ⟨q, hq, hqp⟩ := hpo; exact ⟨q, hoZ hq, hqp⟩)
    exact (hη.mem_open_set_iff hUo).mpr ⟨p, hpS, hpU⟩
  · exact hη.specializes (subset_closure ⟨x', hxZ, rfl⟩)

theorem wcpa_dj_ldx_nc_base_reduction : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], (∀ (R' : Type u) [CommRing R'] [IsDomain R'] [IsDiscreteValuationRing R'], IsAdicComplete (IsLocalRing.maximalIdeal R') R' → IsAlgClosed (IsLocalRing.ResidueField R') → wcpaDjNcConcl R') → wcpaDjNcConcl R :=
by
  intro R _ _ _ hR'
  unfold wcpaDjNcConcl
  intro Z Z' u u' n τ τ' hn hst hst' hgc hgc' Y π a a' h hpb hpb' hsec G ι j hι hG hj hjd hjι hjr
    γ γ' hγ hp hu
  by_contra hne
  haveI hup : IsProper u := hst.1.2.1
  haveI hup' : IsProper u' := hst'.1.2.1
  haveI := hι
  haveI := hj

  obtain ⟨S, _, _, _, ψ, hSalg, hψinj, hψmax, hψint⟩ := wcpa_dj_ldx_nc_br_integral_algclosed R
  obtain ⟨R', _, _, _, c, hcomp, hcinj, hcmax, hcres⟩ := wcpa_dj_ldx_nc_br_completion S
  haveI hcloc : IsLocalHom c := by
    refine ⟨fun x hx => ?_⟩
    by_contra hnu
    have hxm : x ∈ IsLocalRing.maximalIdeal S :=
      (IsLocalRing.mem_maximalIdeal x).mpr (mem_nonunits_iff.mpr hnu)
    have hcx : c x ∈ IsLocalRing.maximalIdeal R' := by
      rw [← hcmax]; exact Ideal.mem_map_of_mem c hxm
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hcx)) hx
  have hres_surj : Function.Surjective (IsLocalRing.ResidueField.map c) := by
    intro y
    obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨s, hs⟩ := hcres x
    refine ⟨IsLocalRing.residue S s, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue]
    have hs' := (IsLocalRing.maximalIdeal R').neg_mem hs
    rw [neg_sub] at hs'
    exact Ideal.Quotient.eq.mpr hs'
  haveI halg : IsAlgClosed (IsLocalRing.ResidueField R') :=
    IsAlgClosed.of_ringEquiv _ _ (RingEquiv.ofBijective _
      ⟨(IsLocalRing.ResidueField.map c).injective, hres_surj⟩)
  have hφinj : Function.Injective (c.comp ψ) := hcinj.comp hψinj
  have hφmax : Ideal.map (c.comp ψ) (IsLocalRing.maximalIdeal R) =
      IsLocalRing.maximalIdeal R' := by
    rw [← Ideal.map_map, hψmax, hcmax]
  have hφint : ∀ x : R', ∃ p : Polynomial R, p.Monic ∧
      Polynomial.eval₂ (c.comp ψ) x p ∈ IsLocalRing.maximalIdeal R' := by
    intro x
    obtain ⟨s, hs⟩ := hcres x
    obtain ⟨p, hpm, hp0⟩ := hψint s
    refine ⟨p, hpm, ?_⟩
    have e1 : Polynomial.eval₂ (c.comp ψ) (c s) p = 0 := by
      rw [← Polynomial.hom_eval₂, hp0, map_zero]
    rw [← Ideal.Quotient.eq_zero_iff_mem, Polynomial.hom_eval₂,
      Ideal.Quotient.eq.mpr hs, ← Polynomial.hom_eval₂, e1, map_zero]

  obtain ⟨ε, hε⟩ := wcpa_dj_ldx_nc_br_gen_square R R' (c.comp ψ) hφinj hφmax
  obtain ⟨hbflat, hbsurj, hbclosed⟩ := wcpa_dj_ldx_nc_br_spec_map R R' (c.comp ψ) hφinj hφmax
  have hrigid := wcpa_dj_ldx_nc_br_fibre_rigid R R' (c.comp ψ) hφinj hφmax hφint Z u
  haveI hgen' : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap R' (FractionRing R')))) :=
    wcpa_dj_ldx_gen_open_immersion R'
  have hc := hR' R' hcomp halg
  unfold wcpaDjNcConcl at hc
  set b := Spec.map (CommRingCat.ofHom (c.comp ψ)) with hbdef
  set gen' := Spec.map (CommRingCat.ofHom (algebraMap R' (FractionRing R'))) with hgendef

  obtain ⟨t₀, ht₀π, -, -⟩ := hsec ⟨0, by omega⟩
  have hgb : gen' ≫ b =
      (ε ≫ t₀) ≫ π ≫ Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) := by
    rw [← hε.w, Category.assoc, reassoc_of% ht₀π]
  obtain ⟨τb, τb', -, -, -, -, -, hτbst, hτbst', hgcb, hgcb', hτb, hτb', -⟩ :=
    wcpa_dj_lqg_bc_config (Spec (.of R)) Z Z' u u' n τ τ' hst hst' hgc hgc'
      (Spec (.of (FractionRing R))) Y _ π a a' hpb hpb' hsec R' b (ε ≫ t₀) hgb

  obtain ⟨YK, βY, πK, hYK⟩ : ∃ (YK : Scheme.{u}) (βY : YK ⟶ Y)
      (πK : YK ⟶ Spec (.of (FractionRing R'))), IsPullback βY πK π ε :=
    ⟨_, _, _, IsPullback.of_hasPullback π ε⟩
  obtain ⟨aK, haK1, haK2⟩ : ∃ aK : YK ⟶ Limits.pullback u b,
      aK ≫ Limits.pullback.fst u b = βY ≫ a ∧ aK ≫ Limits.pullback.snd u b = πK ≫ gen' :=
    ⟨Limits.pullback.lift (βY ≫ a) (πK ≫ gen') (by
      simp only [Category.assoc]
      rw [hpb.w, ← hε.w, reassoc_of% hYK.w]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨aK', haK1', haK2'⟩ : ∃ aK' : YK ⟶ Limits.pullback u' b,
      aK' ≫ Limits.pullback.fst u' b = βY ≫ a' ∧ aK' ≫ Limits.pullback.snd u' b = πK ≫ gen' :=
    ⟨Limits.pullback.lift (βY ≫ a') (πK ≫ gen') (by
      simp only [Category.assoc]
      rw [hpb'.w, ← hε.w, reassoc_of% hYK.w]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hK : aK ≫ Limits.pullback.snd u b = aK' ≫ Limits.pullback.snd u' b := by
    rw [haK2, haK2']

  have hpbK : IsPullback aK πK (Limits.pullback.snd u b) gen' := by
    have hout := hYK.paste_horiz hpb
    rw [← haK1, hε.w] at hout
    exact IsPullback.of_right hout haK2 (IsPullback.of_hasPullback _ _)
  have hpbK' : IsPullback aK' πK (Limits.pullback.snd u' b) gen' := by
    have hout := hYK.paste_horiz hpb'
    rw [← haK1', hε.w] at hout
    exact IsPullback.of_right hout haK2' (IsPullback.of_hasPullback _ _)

  have hsecK : ∀ i, ∃ t : Spec (.of (FractionRing R')) ⟶ YK, t ≫ πK = 𝟙 _ ∧
      t ≫ aK = gen' ≫ τb i ∧ t ≫ aK' = gen' ≫ τb' i := by
    intro i
    obtain ⟨t, ht1, ht2, ht3⟩ := hsec i
    have hw : (ε ≫ t) ≫ π = 𝟙 _ ≫ ε := by
      rw [Category.assoc, ht1, Category.comp_id, Category.id_comp]
    refine ⟨hYK.lift (ε ≫ t) (𝟙 _) hw, hYK.lift_snd _ _ _, ?_, ?_⟩
    · apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [haK1, reassoc_of% (hYK.lift_fst (ε ≫ t) (𝟙 _) hw)]
        try simp only [Category.assoc]
        rw [ht2, reassoc_of% hε.w, (hτb i).2]
      · simp only [Category.assoc]
        rw [haK2, reassoc_of% (hYK.lift_snd (ε ≫ t) (𝟙 _) hw), (hτb i).1]
        simp
    · apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [haK1', reassoc_of% (hYK.lift_fst (ε ≫ t) (𝟙 _) hw)]
        try simp only [Category.assoc]
        rw [ht3, reassoc_of% hε.w, (hτb' i).2]
      · simp only [Category.assoc]
        rw [haK2', reassoc_of% (hYK.lift_snd (ε ≫ t) (𝟙 _) hw), (hτb' i).1]
        simp

  haveI hYKred : AlgebraicGeometry.IsReduced YK := by
    haveI := wcpa_dj_ldx_semistable_fibre_reduced _ _ _ hτbst.1 (FractionRing R') gen'
    exact isReduced_of_isOpenImmersion hpbK.isoPullback.hom
  haveI hZbn : IsLocallyNoetherian (Limits.pullback u b) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd u b)
  obtain ⟨Γ', ι', j', hι', hΓ'red, hj', hj'd, hj'ι, hj'r⟩ :=
    wcpa_dj_lie_graph_closure (Spec (.of R')) _ _ (Spec (.of (FractionRing R'))) YK _ _ _ πK aK aK'
      hK hgen' inferInstance hZbn hYKred hpbK hpbK'
  haveI := hι'

  obtain ⟨β, hβ1, hβ2⟩ : ∃ β : Limits.pullback (Limits.pullback.snd u b)
      (Limits.pullback.snd u' b) ⟶ Limits.pullback u u',
      β ≫ Limits.pullback.fst u u' =
        Limits.pullback.fst (Limits.pullback.snd u b) (Limits.pullback.snd u' b) ≫
          Limits.pullback.fst u b ∧
      β ≫ Limits.pullback.snd u u' =
        Limits.pullback.snd (Limits.pullback.snd u b) (Limits.pullback.snd u' b) ≫
          Limits.pullback.fst u' b :=
    ⟨Limits.pullback.lift
      (Limits.pullback.fst (Limits.pullback.snd u b) (Limits.pullback.snd u' b) ≫
        Limits.pullback.fst u b)
      (Limits.pullback.snd (Limits.pullback.snd u b) (Limits.pullback.snd u' b) ≫
        Limits.pullback.fst u' b) (by
        simp only [Category.assoc]
        rw [Limits.pullback.condition, Limits.pullback.condition_assoc,
          Limits.pullback.condition]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hs4 : IsPullback β
      (Limits.pullback.fst (Limits.pullback.snd u b) (Limits.pullback.snd u' b) ≫
        Limits.pullback.snd u b) (Limits.pullback.fst u u' ≫ u) b := by
    have h1 := (IsPullback.of_hasPullback (Limits.pullback.snd u b)
      (Limits.pullback.snd u' b)).flip.paste_horiz (IsPullback.of_hasPullback u' b)
    rw [← hβ2, ← Limits.pullback.condition] at h1
    have h2 := IsPullback.of_right h1 hβ1 (IsPullback.of_hasPullback u u').flip
    exact h2.paste_vert (IsPullback.of_hasPullback u b)
  haveI hβflat : Flat β := MorphismProperty.of_isPullback (P := @Flat) hs4.flip hbflat
  haveI hβsurj : Surjective β := MorphismProperty.of_isPullback (P := @Surjective) hs4.flip hbsurj

  have hgq : Limits.pullback.lift a a' h ≫ Limits.pullback.fst u u' ≫ u =
      π ≫ Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) := by
    rw [Limits.pullback.lift_fst_assoc, hpb.w]
  have hg'q : Limits.pullback.lift aK aK' hK ≫
      Limits.pullback.fst (Limits.pullback.snd u b) (Limits.pullback.snd u' b) ≫
        Limits.pullback.snd u b = πK ≫ gen' := by
    rw [Limits.pullback.lift_fst_assoc, haK2]
  have hg7 : IsPullback (Limits.pullback.lift aK aK' hK) βY β (Limits.pullback.lift a a' h) := by
    have hout := hYK.flip.paste_horiz hε.flip
    rw [← hg'q, ← hgq] at hout
    refine IsPullback.of_right hout ?_ hs4.flip
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hβ1, Limits.pullback.lift_fst_assoc, haK1, Limits.pullback.lift_fst]
    · simp only [Category.assoc]
      rw [hβ2, Limits.pullback.lift_snd_assoc, haK1', Limits.pullback.lift_snd]

  obtain ⟨x, hx⟩ := β.surjective (ι γ)
  obtain ⟨x', hx'x, hx'⟩ := Flat.generalizingMap β
    (show ι γ' ⤳ β x by rw [hx]; exact hγ.map ι.continuous)
  haveI hGn : IsLocallyNoetherian G :=
    LocallyOfFiniteType.isLocallyNoetherian (ι ≫ Limits.pullback.fst u u' ≫ u)
  obtain ⟨η, ⟨y, rfl⟩, hηγ'⟩ :=
    wcpa_dj_lqg_generization G (Set.range j) (IsOpenImmersion.isOpen_range j) hjd γ'
  obtain ⟨x₀, hx₀x', hx₀⟩ := Flat.generalizingMap β
    (show ι (j y) ⤳ β x' by rw [hx']; exact hηγ'.map ι.continuous)
  have hx₀g : β x₀ = Limits.pullback.lift a a' h y := by
    rw [hx₀, ← hjι, Scheme.Hom.comp_apply]
  obtain ⟨p, hp1, -⟩ := Scheme.exists_preimage_of_isPullback hg7 x₀ y hx₀g
  have hclosed : IsClosed (Set.range ι') := ι'.isClosedEmbedding.isClosed_range
  have hx₀r : x₀ ∈ Set.range ι' := ⟨j' p, by rw [← hp1, ← hj'ι, Scheme.Hom.comp_apply]⟩
  have hx'r : x' ∈ Set.range ι' := hx₀x'.mem_closed hclosed hx₀r
  have hxr : x ∈ Set.range ι' := hx'x.mem_closed hclosed hx'r
  obtain ⟨g₁, rfl⟩ := hxr
  obtain ⟨g₁', rfl⟩ := hx'r
  have hg : g₁' ⤳ g₁ := (ι'.isClosedEmbedding.isInducing.specializes_iff).mp hx'x

  have e1 : ∀ w : ↥(Limits.pullback (Limits.pullback.snd u b) (Limits.pullback.snd u' b)),
      Limits.pullback.fst u b
        (Limits.pullback.fst (Limits.pullback.snd u b) (Limits.pullback.snd u' b) w) =
        Limits.pullback.fst u u' (β w) := by
    intro w
    show (Limits.pullback.fst (Limits.pullback.snd u b) (Limits.pullback.snd u' b) ≫
      Limits.pullback.fst u b) w = (β ≫ Limits.pullback.fst u u') w
    rw [hβ1]
  have hwg₁ : Limits.pullback.fst u b ((ι' ≫ Limits.pullback.fst _ _) g₁) =
      (ι ≫ Limits.pullback.fst u u') γ := by
    simp only [Scheme.Hom.comp_apply]
    rw [e1, hx]
  have hwg₁' : Limits.pullback.fst u b ((ι' ≫ Limits.pullback.fst _ _) g₁') =
      (ι ≫ Limits.pullback.fst u u') γ := by
    have hp' := hp
    simp only [Scheme.Hom.comp_apply] at hp' ⊢
    rw [e1, hx', hp']
  have hsnd : Limits.pullback.snd u b ((ι' ≫ Limits.pullback.fst _ _) g₁) =
      IsLocalRing.closedPoint R' := by
    apply hbclosed
    show (Limits.pullback.snd u b ≫ b) ((ι' ≫ Limits.pullback.fst _ _) g₁) = _
    rw [← Limits.pullback.condition]
    show u (Limits.pullback.fst u b ((ι' ≫ Limits.pullback.fst _ _) g₁)) = _
    rw [hwg₁]
    exact hu
  have hww : (ι' ≫ Limits.pullback.fst _ _) g₁' = (ι' ≫ Limits.pullback.fst _ _) g₁ :=
    hrigid _ _ (hg.map (ι' ≫ Limits.pullback.fst _ _).continuous) (hwg₁'.trans hwg₁.symm) hsnd

  have heq := hc _ _ _ _ n τb τb' hn hτbst hτbst' hgcb hgcb' YK πK aK aK' hK hpbK hpbK' hsecK
    Γ' ι' j' hι' hΓ'red hj' hj'd hj'ι hj'r g₁ g₁' hg hww hsnd
  exact hne (ι.isClosedEmbedding.injective (by rw [← hx', ← hx, heq]))

theorem wcpa_dj_ldx_ncds_chain_short_special : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), wcpaDjSemistable u → ∀ x x' x'' : Z, u x = IsLocalRing.closedPoint R → x ⤳ x' → x' ⤳ x'' → x = x' ∨ x' = x'' :=
by
  intro R _ _ Z u hss x x' x'' hx hxx' hx'x''
  let φ : R →+* AlgebraicClosure (IsLocalRing.ResidueField R) :=
    (algebraMap (IsLocalRing.ResidueField R) (AlgebraicClosure (IsLocalRing.ResidueField R))).comp
      (IsLocalRing.residue R)
  let s : Spec (.of (AlgebraicClosure (IsLocalRing.ResidueField R))) ⟶ Spec (.of R) :=
    Spec.map (CommRingCat.ofHom φ)
  have hφint : φ.IsIntegral := by
    have h₁ : (IsLocalRing.residue R).IsIntegral :=
      RingHom.isIntegral_of_surjective _ IsLocalRing.residue_surjective
    have h₂ : (algebraMap (IsLocalRing.ResidueField R)
        (AlgebraicClosure (IsLocalRing.ResidueField R))).IsIntegral :=
      algebraMap_isIntegral_iff.mpr inferInstance
    exact RingHom.IsIntegral.trans _ _ h₁ h₂
  haveI hsint : IsIntegralHom s := IsIntegralHom.SpecMap_iff.mpr hφint
  haveI : UniversallyClosed (Limits.pullback.fst u s) := inferInstance
  have hspec : SpecializingMap ⇑(Limits.pullback.fst u s) :=
    (Limits.pullback.fst u s).isClosedMap.specializingMap
  let pt : ↥(Spec (.of (AlgebraicClosure (IsLocalRing.ResidueField R)))) :=
    IsLocalRing.closedPoint (AlgebraicClosure (IsLocalRing.ResidueField R))
  have hs : s pt = IsLocalRing.closedPoint R := by
    show (Spec.map (CommRingCat.ofHom φ)) pt = IsLocalRing.closedPoint R
    rw [Spec.map_apply]
    exact IsLocalRing.comap_closedPoint φ
  obtain ⟨p, hp, -⟩ := Scheme.Pullback.exists_preimage_pullback x pt (hx.trans hs.symm)
  rw [← hp] at hxx'
  obtain ⟨p', hpp', hp'⟩ := hspec hxx'
  rw [← hp'] at hx'x''
  obtain ⟨p'', hp'p'', hp''⟩ := hspec hx'x''
  rcases wcpa_dj_lcc_cm_fio_chain_short (Spec (.of R)) Z u hss _ s p p' p'' hpp' hp'p'' with h | h
  · left
    rw [← hp, ← hp', h]
  · right
    rw [← hp', ← hp'', h]

theorem wcpa_dj_ldx_ncds_closed_fibre_rigid : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Z Z' : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)), LocallyOfFiniteType u' → ∀ q q' : ↥(Limits.pullback u u'), q' ⤳ q → Limits.pullback.fst u u' q' = Limits.pullback.fst u u' q → Limits.pullback.snd u u' q' = Limits.pullback.snd u u' q → IsClosed ({Limits.pullback.snd u u' q} : Set Z') → u' (Limits.pullback.snd u u' q) = IsLocalRing.closedPoint R → q' = q :=
by
  intro R _ _ Z Z' u u' hlft q q' hsp hF hG hcl hpt

  have incomp : ∀ {S T : Type u} [CommRing S] [CommRing T] [IsDomain T] (f : S →+* T)
      (J : Ideal T) (x : T), x ∈ J → x ≠ 0 → f.IsIntegralElem x →
      Ideal.comap f ⊥ < Ideal.comap f J := by
    intro S T _ _ _ f J x hx hx0 hfx
    letI := f.toAlgebra
    have hmem : x ∈ (J : Set T) \ ((⊥ : Ideal T) : Set T) := ⟨hx, by simpa using hx0⟩
    exact Ideal.under_lt_under_of_integral_mem_sdiff (R := S) (I := (⊥ : Ideal T)) bot_le hmem hfx

  have intgen : ∀ {S T : Type u} [CommRing S] [CommRing T] (f : S →+* T) (s : Set T),
      Subring.closure s = ⊤ → (∀ t ∈ s, f.IsIntegralElem t) → ∀ t, f.IsIntegralElem t := by
    intro S T _ _ f s hs h t
    letI := f.toAlgebra
    have hle : Subring.closure s ≤ (integralClosure S T).toSubring := by
      rw [Subring.closure_le]
      intro x hx
      rw [SetLike.mem_coe, Subalgebra.mem_toSubring, mem_integralClosure_iff]
      exact h x hx
    have := hle (hs ▸ Subring.mem_top t)
    rw [Subalgebra.mem_toSubring, mem_integralClosure_iff] at this
    exact this

  obtain ⟨U, hU, hzU, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := Limits.pullback.fst u u' q) (U := ⊤) trivial
  obtain ⟨V, hV, hzV, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := Limits.pullback.snd u u' q) (U := ⊤) trivial
  haveI hιA : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
  haveI hιB : IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
  let α : R →+* Γ(Z, U) := (Spec.preimage (hU.fromSpec ≫ u)).hom
  have hα : Spec.map (CommRingCat.ofHom α) = hU.fromSpec ≫ u := Spec.map_preimage _
  let β : R →+* Γ(Z', V) := (Spec.preimage (hV.fromSpec ≫ u')).hom
  have hβ : Spec.map (CommRingCat.ofHom β) = hV.fromSpec ≫ u' := Spec.map_preimage _
  letI : Algebra R Γ(Z, U) := α.toAlgebra
  letI : Algebra R Γ(Z', V) := β.toAlgebra
  let iA : Γ(Z, U) →+* TensorProduct R Γ(Z, U) Γ(Z', V) := Algebra.TensorProduct.includeLeftRingHom
  let iB : Γ(Z', V) →+* TensorProduct R Γ(Z, U) Γ(Z', V) :=
    Algebra.TensorProduct.includeRight.toRingHom
  have h1 : iA.comp α = iB.comp β := Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
  have hcl' : Subring.closure (Set.range iA ∪ Set.range iB) = ⊤ := by
    rw [eq_top_iff]
    rintro t -
    induction t using TensorProduct.induction_on with
    | zero => exact zero_mem _
    | tmul a r =>
      have e : a ⊗ₜ[R] r = iA a * iB r := by
        show a ⊗ₜ[R] r = (a ⊗ₜ[R] (1 : Γ(Z', V))) * ((1 : Γ(Z, U)) ⊗ₜ[R] r)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [e]
      exact mul_mem (Subring.subset_closure (Or.inl ⟨a, rfl⟩))
        (Subring.subset_closure (Or.inr ⟨r, rfl⟩))
    | add x y hx hy => exact add_mem hx hy

  have hβft : β.FiniteType := by
    have : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom β)) := by rw [hβ]; infer_instance
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this

  have zariski : ∀ (M : Ideal Γ(Z', V)), M.IsMaximal →
      Ideal.comap β M = IsLocalRing.maximalIdeal R →
      ∀ x : Γ(Z', V), ∃ p : Polynomial R, p.Monic ∧ Polynomial.eval₂ β x p ∈ M := by
    intro M hM hc x
    letI : Field (Γ(Z', V) ⧸ M) := Ideal.Quotient.field M
    let g : IsLocalRing.ResidueField R →+* Γ(Z', V) ⧸ M :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) ((Ideal.Quotient.mk M).comp β) (by
        intro a ha
        rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, ← Ideal.mem_comap, hc]
        exact ha)
    have hg : g.comp (IsLocalRing.residue R) = (Ideal.Quotient.mk M).comp β := by
      ext a; rfl
    have hgft : g.FiniteType := by
      have h0 : ((Ideal.Quotient.mk M).comp β).FiniteType :=
        hβft.comp_surjective Ideal.Quotient.mk_surjective
      rw [← hg] at h0
      exact RingHom.FiniteType.of_comp_finiteType h0
    letI : Algebra (IsLocalRing.ResidueField R) (Γ(Z', V) ⧸ M) := g.toAlgebra
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField R) (Γ(Z', V) ⧸ M) := hgft
    haveI : Module.Finite (IsLocalRing.ResidueField R) (Γ(Z', V) ⧸ M) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    obtain ⟨pb, hpbm, hpb0⟩ :=
      IsIntegral.of_finite (IsLocalRing.ResidueField R) (Ideal.Quotient.mk M x)
    have hlift : pb ∈ Polynomial.lifts (IsLocalRing.residue R) := by
      rw [Polynomial.mem_lifts]
      exact Polynomial.map_surjective _ IsLocalRing.residue_surjective pb
    obtain ⟨p, hpmap, -, hpm⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hpbm
    refine ⟨p, hpm, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have e : Ideal.Quotient.mk M (Polynomial.eval₂ β x p) =
        Polynomial.eval₂ ((Ideal.Quotient.mk M).comp β) (Ideal.Quotient.mk M x) p :=
      Polynomial.hom_eval₂ _ _ _ _
    rw [e, ← hg, ← Polynomial.eval₂_map, hpmap]
    exact hpb0

  have core : ∀ (Q Q' : Ideal (TensorProduct R Γ(Z, U) Γ(Z', V))), Q'.IsPrime → Q' ≤ Q →
      Ideal.comap iA Q = Ideal.comap iA Q' → Ideal.comap iB Q = Ideal.comap iB Q' →
      (Ideal.comap iB Q).IsMaximal →
      Ideal.comap β (Ideal.comap iB Q) = IsLocalRing.maximalIdeal R → Q = Q' := by
    intro Q Q' hQ' hQQ' hQA hQB hMmax hMc
    have hint' : ∀ t, ((Ideal.Quotient.mk Q').comp iA).IsIntegralElem t := by
      apply intgen _ (Set.range ((Ideal.Quotient.mk Q').comp iA) ∪
        Set.range ((Ideal.Quotient.mk Q').comp iB))
      · rw [eq_top_iff]
        intro d _
        obtain ⟨b0, rfl⟩ := Ideal.Quotient.mk_surjective d
        have hle2 : Subring.closure (Set.range iA ∪ Set.range iB) ≤
            (Subring.closure (Set.range ((Ideal.Quotient.mk Q').comp iA) ∪
              Set.range ((Ideal.Quotient.mk Q').comp iB))).comap (Ideal.Quotient.mk Q') := by
          rw [Subring.closure_le]
          rintro _ (⟨a, rfl⟩ | ⟨r, rfl⟩)
          · exact Subring.subset_closure (Or.inl ⟨a, rfl⟩)
          · exact Subring.subset_closure (Or.inr ⟨r, rfl⟩)
        exact hle2 (hcl' ▸ Subring.mem_top b0)
      · rintro _ (⟨a, rfl⟩ | ⟨r, rfl⟩)
        · exact RingHom.isIntegralElem_map _
        · obtain ⟨p, hpm, hp0⟩ := zariski _ hMmax hMc r
          refine ⟨p.map α, hpm.map α, ?_⟩
          rw [Polynomial.eval₂_map]
          have e : ((Ideal.Quotient.mk Q').comp iA).comp α =
              ((Ideal.Quotient.mk Q').comp iB).comp β := by
            rw [RingHom.comp_assoc, h1, ← RingHom.comp_assoc]
          rw [e, ← Polynomial.hom_eval₂, RingHom.comp_apply]
          refine Ideal.Quotient.eq_zero_iff_mem.mpr ?_
          rw [← Ideal.mem_comap, ← hQB]
          exact hp0
    by_contra hne
    have hlt : Q' < Q := lt_of_le_of_ne hQQ' (Ne.symm hne)
    obtain ⟨x, hxQ, hxQ'⟩ := SetLike.exists_of_lt hlt
    have := incomp ((Ideal.Quotient.mk Q').comp iA) (Ideal.map (Ideal.Quotient.mk Q') Q)
      (Ideal.Quotient.mk Q' x) (Ideal.mem_map_of_mem _ hxQ)
      (fun h0 => hxQ' (Ideal.Quotient.eq_zero_iff_mem.mp h0)) (hint' _)
    rw [← Ideal.comap_comap, ← Ideal.comap_comap, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker,
      Ideal.comap_map_mk hQQ', hQA] at this
    exact lt_irrefl _ this

  have hpb := isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_tensorProduct R Γ(Z, U) Γ(Z', V))
  have e1 : Spec.map (CommRingCat.ofHom (algebraMap R Γ(Z, U))) = hU.fromSpec ≫ u := hα
  have e2 : Spec.map (CommRingCat.ofHom (algebraMap R Γ(Z', V))) = hV.fromSpec ≫ u' := hβ
  rw [e1, e2] at hpb
  let m := Limits.pullback.map (hU.fromSpec ≫ u) (hV.fromSpec ≫ u') u u' hU.fromSpec hV.fromSpec
    (𝟙 _) (by simp) (by simp)
  let κ := hpb.isoPullback.hom ≫ m
  haveI hκo : IsOpenImmersion κ := inferInstance
  have hmF : m ≫ Limits.pullback.fst u u' =
      Limits.pullback.fst (hU.fromSpec ≫ u) (hV.fromSpec ≫ u') ≫ hU.fromSpec :=
    Limits.pullback.lift_fst _ _ _
  have hmG : m ≫ Limits.pullback.snd u u' =
      Limits.pullback.snd (hU.fromSpec ≫ u) (hV.fromSpec ≫ u') ≫ hV.fromSpec :=
    Limits.pullback.lift_snd _ _ _
  have hκF : κ ≫ Limits.pullback.fst u u' = Spec.map (CommRingCat.ofHom iA) ≫ hU.fromSpec := by
    show (hpb.isoPullback.hom ≫ m) ≫ Limits.pullback.fst u u' = _
    rw [Category.assoc, hmF, ← Category.assoc, IsPullback.isoPullback_hom_fst]
  have hκG : κ ≫ Limits.pullback.snd u u' = Spec.map (CommRingCat.ofHom iB) ≫ hV.fromSpec := by
    show (hpb.isoPullback.hom ≫ m) ≫ Limits.pullback.snd u u' = _
    rw [Category.assoc, hmG, ← Category.assoc, IsPullback.isoPullback_hom_snd]
  have hrange : ∀ p : ↥(Limits.pullback u u'), Limits.pullback.fst u u' p ∈ U →
      Limits.pullback.snd u u' p ∈ V → ∃ c, κ c = p := by
    intro p hpU hpV
    have hm : p ∈ Set.range m := by
      rw [Scheme.Pullback.range_map]
      refine ⟨?_, ?_⟩
      · show Limits.pullback.fst u u' p ∈ Set.range hU.fromSpec
        rw [hU.range_fromSpec]; exact hpU
      · show Limits.pullback.snd u u' p ∈ Set.range hV.fromSpec
        rw [hV.range_fromSpec]; exact hpV
    obtain ⟨c, hc⟩ := hm
    refine ⟨hpb.isoPullback.inv c, ?_⟩
    show (hpb.isoPullback.inv ≫ hpb.isoPullback.hom ≫ m) c = p
    rw [Iso.inv_hom_id_assoc]
    exact hc
  obtain ⟨Q, hQ⟩ := hrange q hzU hzV
  obtain ⟨Q', hQ'⟩ := hrange q' (by rw [hF]; exact hzU) (by rw [hG]; exact hzV)
  have hsp' : Q' ⤳ Q :=
    (κ.isOpenEmbedding.isInducing.specializes_iff).mp (by rw [hQ, hQ']; exact hsp)
  have hle : (Q' : PrimeSpectrum (TensorProduct R Γ(Z, U) Γ(Z', V))).asIdeal ≤
      (Q : PrimeSpectrum (TensorProduct R Γ(Z, U) Γ(Z', V))).asIdeal := by
    have := (PrimeSpectrum.le_iff_specializes (R := TensorProduct R Γ(Z, U) Γ(Z', V)) Q' Q).mpr hsp'
    exact this
  have hFQ : ∀ c, hU.fromSpec (Spec.map (CommRingCat.ofHom iA) c) =
      Limits.pullback.fst u u' (κ c) := by
    intro c
    rw [← Scheme.Hom.comp_apply, ← hκF, Scheme.Hom.comp_apply]
  have hGQ : ∀ c, hV.fromSpec (Spec.map (CommRingCat.ofHom iB) c) =
      Limits.pullback.snd u u' (κ c) := by
    intro c
    rw [← Scheme.Hom.comp_apply, ← hκG, Scheme.Hom.comp_apply]
  have hA : Ideal.comap iA (Q : PrimeSpectrum (TensorProduct R Γ(Z, U) Γ(Z', V))).asIdeal =
      Ideal.comap iA (Q' : PrimeSpectrum (TensorProduct R Γ(Z, U) Γ(Z', V))).asIdeal := by
    have h0 : Spec.map (CommRingCat.ofHom iA) Q = Spec.map (CommRingCat.ofHom iA) Q' := by
      apply hU.fromSpec.isOpenEmbedding.injective
      rw [hFQ, hFQ, hQ, hQ', hF]
    have := congrArg PrimeSpectrum.asIdeal h0
    rw [Spec.map_apply, Spec.map_apply] at this
    exact this
  have hB0 : Spec.map (CommRingCat.ofHom iB) Q = Spec.map (CommRingCat.ofHom iB) Q' := by
    apply hV.fromSpec.isOpenEmbedding.injective
    rw [hGQ, hGQ, hQ, hQ', hG]
  have hB : Ideal.comap iB (Q : PrimeSpectrum (TensorProduct R Γ(Z, U) Γ(Z', V))).asIdeal =
      Ideal.comap iB (Q' : PrimeSpectrum (TensorProduct R Γ(Z, U) Γ(Z', V))).asIdeal := by
    have := congrArg PrimeSpectrum.asIdeal hB0
    rw [Spec.map_apply, Spec.map_apply] at this
    exact this
  have hGq : hV.fromSpec (Spec.map (CommRingCat.ofHom iB) Q) = Limits.pullback.snd u u' q := by
    rw [hGQ, hQ]
  have hMcl : IsClosed ({Spec.map (CommRingCat.ofHom iB) Q} :
      Set (Spec (CommRingCat.of Γ(Z', V)))) := by
    have e : ({Spec.map (CommRingCat.ofHom iB) Q} : Set (Spec (CommRingCat.of Γ(Z', V)))) =
        hV.fromSpec ⁻¹' {Limits.pullback.snd u u' q} := by
      ext y
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact hGq
      · intro hy; exact hV.fromSpec.isOpenEmbedding.injective (hy.trans hGq.symm)
    rw [e]
    exact hcl.preimage hV.fromSpec.continuous
  have hMmax : (Ideal.comap iB
      (Q : PrimeSpectrum (TensorProduct R Γ(Z, U) Γ(Z', V))).asIdeal).IsMaximal := by
    have := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hMcl
    rw [Spec.map_apply] at this
    exact this
  have hMc : Ideal.comap β (Ideal.comap iB
      (Q : PrimeSpectrum (TensorProduct R Γ(Z, U) Γ(Z', V))).asIdeal) =
      IsLocalRing.maximalIdeal R := by
    have h0 : Spec.map (CommRingCat.ofHom β) (Spec.map (CommRingCat.ofHom iB) Q) =
        IsLocalRing.closedPoint R := by
      rw [hβ, Scheme.Hom.comp_apply, hGq]; exact hpt
    have := congrArg PrimeSpectrum.asIdeal h0
    rw [Spec.map_apply, Spec.map_apply] at this
    exact this
  have hQQ := core _ _ (Q' : PrimeSpectrum (TensorProduct R Γ(Z, U) Γ(Z', V))).isPrime hle hA hB
    hMmax hMc
  have hqq : (Q : PrimeSpectrum (TensorProduct R Γ(Z, U) Γ(Z', V))) = Q' := PrimeSpectrum.ext hQQ
  rw [← hQ, ← hQ']
  exact congrArg κ hqq.symm

theorem wcpa_dj_ldx_ncds_generic_in_range : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)), IsSeparated u' → ∀ (Y : Scheme.{u}) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u'), IsPullback a π u (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) → ∀ (G : Scheme.{u}) (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G), IsClosedImmersion ι → Dense (Set.range ⇑j) → j ≫ ι = Limits.pullback.lift a a' h → ∀ γ : G, u ((ι ≫ Limits.pullback.fst u u') γ) ≠ IsLocalRing.closedPoint R → γ ∈ Set.range ⇑j :=
by
  intro R _ _ _ Z Z' u u' hsep Y π a a' h hpb G ι j hι hjd hjι γ hγ
  haveI := hsep
  haveI := hι
  haveI hgen : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := by
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have inj : Function.Injective (algebraMap R (FractionRing R)) :=
      IsFractionRing.injective R (FractionRing R)
    have hϖ0 : algebraMap R (FractionRing R) ϖ ≠ 0 := by
      intro h
      exact hϖ.ne_zero (inj (h.trans (map_zero _).symm))
    haveI : IsLocalization.Away ϖ (FractionRing R) := by
      refine IsLocalization.Away.mk ϖ (IsUnit.mk0 _ hϖ0) ?_ ?_
      · intro s
        obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := R) s
        have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
        obtain ⟨n, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hϖ
        refine ⟨n, a * ↑v⁻¹, ?_⟩
        have hv : algebraMap R (FractionRing R) (↑v) * algebraMap R (FractionRing R) (↑v⁻¹) = 1 := by
          rw [← map_mul, Units.mul_inv, map_one]
        have hv0 : algebraMap R (FractionRing R) (↑v) ≠ 0 := by
          intro h; rw [h, zero_mul] at hv; exact zero_ne_one hv
        have hpn : algebraMap R (FractionRing R) ϖ ^ n ≠ 0 := pow_ne_zero _ hϖ0
        rw [map_mul, map_mul, map_pow]
        field_simp
        linear_combination -(algebraMap R (FractionRing R) a) * hv
      · intro a b h
        exact ⟨0, by rw [pow_zero, one_mul, one_mul]; exact inj h⟩
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization ϖ
  haveI ha : IsOpenImmersion a :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip hgen
  have hr : (ι ≫ Limits.pullback.fst u u') γ ∈ Set.range ⇑a := by
    have hrange : Set.range ⇑a = ⇑u ⁻¹' Set.range
        ⇑(Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := by
      rw [← Scheme.Pullback.range_fst]
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        refine ⟨hpb.isoPullback.hom y, ?_⟩
        rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_hom_fst]
      · rintro ⟨w, rfl⟩
        refine ⟨hpb.isoPullback.inv w, ?_⟩
        rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst]
    rw [hrange, Set.mem_preimage]
    revert hγ
    generalize u ((ι ≫ Limits.pullback.fst u u') γ) = p
    intro hp
    have hbot : (p : PrimeSpectrum R).asIdeal = ⊥ := by
      by_contra hne
      apply hp
      obtain ⟨P, _, huniq⟩ :=
        ((IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime R).mp inferInstance).2
      have e1 : (p : PrimeSpectrum R).asIdeal = P :=
        huniq _ ⟨hne, (p : PrimeSpectrum R).isPrime⟩
      have e2 : IsLocalRing.maximalIdeal R = P :=
        huniq _ ⟨IsDiscreteValuationRing.not_a_field R,
          (IsLocalRing.maximalIdeal.isMaximal R).isPrime⟩
      apply PrimeSpectrum.ext
      rw [e1, ← e2]
      rfl
    obtain ⟨q⟩ : Nonempty (Spec (.of (FractionRing R))) :=
      ⟨(⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (FractionRing R))⟩
    refine ⟨q, ?_⟩
    apply PrimeSpectrum.ext
    rw [hbot]
    have hq0 : (q : PrimeSpectrum (FractionRing R)).asIdeal = ⊥ := by
      haveI := (q : PrimeSpectrum (FractionRing R)).isPrime
      exact Ideal.eq_bot_of_prime _
    rw [Spec.map_apply]
    change Ideal.comap (algebraMap R (FractionRing R))
      (q : PrimeSpectrum (FractionRing R)).asIdeal = ⊥
    rw [hq0]
    exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective R (FractionRing R))
  have hσw : 𝟙 Y ≫ a = Limits.pullback.lift a a' h ≫ Limits.pullback.fst u u' := by
    rw [Category.id_comp, Limits.pullback.lift_fst]
  let σ : Y ⟶ Limits.pullback a (Limits.pullback.fst u u') :=
    Limits.pullback.lift (𝟙 Y) (Limits.pullback.lift a a' h) hσw
  have hσp : σ ≫ Limits.pullback.fst a (Limits.pullback.fst u u') = 𝟙 Y :=
    Limits.pullback.lift_fst _ _ _
  have hσn : σ ≫ Limits.pullback.snd a (Limits.pullback.fst u u') = j ≫ ι := by
    rw [hjι]; exact Limits.pullback.lift_snd _ _ _
  have hσnpt : ∀ y, Limits.pullback.snd a (Limits.pullback.fst u u') (σ y) = ι (j y) := by
    intro y
    have := congrArg (fun f : Y ⟶ Limits.pullback u u' => f y) hσn
    simpa only [Scheme.Hom.comp_apply] using this
  haveI : IsSeparated (Limits.pullback.fst u u') := inferInstance
  haveI : IsSeparated (Limits.pullback.fst a (Limits.pullback.fst u u')) := inferInstance
  haveI : IsClosedImmersion (σ ≫ Limits.pullback.fst a (Limits.pullback.fst u u')) := by
    rw [hσp]; infer_instance
  haveI : IsClosedImmersion σ :=
    IsClosedImmersion.of_comp σ (Limits.pullback.fst a (Limits.pullback.fst u u'))
  have hC : IsClosed (Set.range ⇑σ) := σ.isClosedEmbedding.isClosed_range
  have hrn : ι γ ∈ Set.range ⇑(Limits.pullback.snd a (Limits.pullback.fst u u')) := by
    rw [Scheme.Pullback.range_snd]
    rw [Scheme.Hom.comp_apply] at hr
    exact hr
  obtain ⟨q, hq⟩ := hrn
  have hιinj : Function.Injective ι := ι.isClosedEmbedding.injective
  have hninj : Function.Injective (Limits.pullback.snd a (Limits.pullback.fst u u')) :=
    (Limits.pullback.snd a (Limits.pullback.fst u u')).isOpenEmbedding.injective
  have hqC : q ∈ Set.range ⇑σ := by
    by_contra hqC
    have hO : IsOpen (⇑(Limits.pullback.snd a (Limits.pullback.fst u u')) '' (Set.range ⇑σ)ᶜ) :=
      (Limits.pullback.snd a (Limits.pullback.fst u u')).isOpenEmbedding.isOpenMap _
        hC.isOpen_compl
    have hU : IsOpen (⇑ι ⁻¹'
        (⇑(Limits.pullback.snd a (Limits.pullback.fst u u')) '' (Set.range ⇑σ)ᶜ)) :=
      hO.preimage ι.continuous
    obtain ⟨g, ⟨y, rfl⟩, hgU⟩ := hjd.exists_mem_open hU ⟨γ, ⟨q, hqC, hq⟩⟩
    obtain ⟨q', hq'C, hq'⟩ := hgU
    apply hq'C
    refine ⟨y, hninj ?_⟩
    rw [hσnpt, hq']
  obtain ⟨y₀, rfl⟩ := hqC
  exact ⟨y₀, hιinj (by rw [← hσnpt, hq])⟩

theorem wcpa_dj_ldx_nc_generic_local_iso : wcpaDjNcGenIso.{u} :=
by
  intro R _ _ _ Z Z' u u' hss hss' Y π a a' h hpb hpb' G ι j hι hG hj hjd hjι hjr ξ hξ hmax

  have s1 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] (t : O),
      t ∈ nonZeroDivisors O → IsLocalRing.maximalIdeal O = Ideal.span {t} →
      ∃ _ : IsDomain O, IsDiscreteValuationRing O := by
    intro O _ _ _ t ht hm
    have ht0 : t ≠ 0 := nonZeroDivisors.ne_zero ht
    have hpow : ∀ n : ℕ, t ^ n ∈ nonZeroDivisors O := fun n => pow_mem ht n
    have hKrull := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal O)
      (IsLocalRing.maximalIdeal.isMaximal O).ne_top
    rw [hm] at hKrull
    have hfac : ∀ x : O, x ≠ 0 → ∃ (n : ℕ) (v : O), IsUnit v ∧ x = v * t ^ n := by
      intro x hx
      have hex : ∃ m : ℕ, x ∉ Ideal.span {t ^ m} := by
        by_contra hcon
        push_neg at hcon
        apply hx
        have : x ∈ ⨅ i, Ideal.span {t} ^ i := by
          rw [Ideal.mem_iInf]
          intro i
          rw [Ideal.span_singleton_pow]
          exact hcon i
        rw [hKrull] at this
        exact (Submodule.mem_bot O).mp this
      classical
      let m := Nat.find hex
      have hm1 : x ∉ Ideal.span {t ^ m} := Nat.find_spec hex
      have hm0 : m ≠ 0 := by
        intro h0
        apply hm1
        rw [h0, pow_zero, Ideal.span_singleton_one]
        exact Submodule.mem_top
      have hn : x ∈ Ideal.span {t ^ (m - 1)} := by
        have := Nat.find_min hex (show m - 1 < m by omega)
        push_neg at this
        exact this
      obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp hn
      refine ⟨m - 1, v, ?_, hv.symm⟩
      by_contra hvu
      have hvm : v ∈ IsLocalRing.maximalIdeal O := hvu
      rw [hm] at hvm
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hvm
      apply hm1
      rw [Ideal.mem_span_singleton']
      refine ⟨w, ?_⟩
      rw [← hv, ← hw, mul_assoc, ← pow_succ']
      congr 2
      omega
    have hnzd : NoZeroDivisors O := by
      constructor
      intro x y hxy
      by_contra hne
      push_neg at hne
      obtain ⟨hx, hy⟩ := hne
      obtain ⟨n, v, hv, rfl⟩ := hfac x hx
      obtain ⟨k, w, hw, rfl⟩ := hfac y hy
      have e : (v * w) * t ^ (n + k) = 0 := by
        rw [← hxy, pow_add]; ring
      rw [(hv.mul hw).mul_right_eq_zero] at e
      exact nonZeroDivisors.ne_zero (hpow (n + k)) e
    have : IsDomain O := NoZeroDivisors.to_isDomain O
    refine ⟨inferInstance, ?_⟩
    apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
    refine ⟨t, IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal t ht0 hm, ?_⟩
    intro x hx
    obtain ⟨n, v, hv, rfl⟩ := hfac x hx
    refine ⟨n, hv.unit, ?_⟩
    rw [IsUnit.unit_spec, mul_comm]

  have s3 : ∀ (G X : Scheme.{u}) (p : G ⟶ X), IsProper p → ∀ (x : X)
      [hdom : IsDomain ↑(X.presheaf.stalk x)] [IsDiscreteValuationRing ↑(X.presheaf.stalk x)]
      (e : Spec (.of (FractionRing ↑(X.presheaf.stalk x))) ⟶ G),
      e ≫ p = Spec.map (CommRingCat.ofHom (algebraMap ↑(X.presheaf.stalk x)
        (FractionRing ↑(X.presheaf.stalk x)))) ≫ X.fromSpecStalk x →
      ∃ σ : Spec (X.presheaf.stalk x) ⟶ G, σ ≫ p = X.fromSpecStalk x := by
    intro G X p hp x hdom _ e he
    have hv : ValuativeCriterion p := by
      rw [IsProper.eq_valuativeCriterion] at hp
      exact hp.1.1.1
    let S : ValuativeCommSq p := @ValuativeCommSq.mk _ _ p ↑(X.presheaf.stalk x) _ hdom
      inferInstance (FractionRing ↑(X.presheaf.stalk x)) _ _ _ e (X.fromSpecStalk x) ⟨he⟩
    obtain ⟨l⟩ := hv S
    refine ⟨(show Spec (X.presheaf.stalk x) ⟶ G from l.default.l), ?_⟩
    exact l.default.fac_right

  have s6 : ∀ (X Y : Scheme.{u}) (a' : Y ⟶ X), IsOpenImmersion a' → ∀ (x : X)
      [IsDomain ↑(X.presheaf.stalk x)] [IsDiscreteValuationRing ↑(X.presheaf.stalk x)],
      (∀ y : X, y ⤳ x → y ≠ x → y ∈ Set.range ⇑a') →
      ∃ e : Spec (.of (FractionRing ↑(X.presheaf.stalk x))) ⟶ Y,
        e ≫ a' = Spec.map (CommRingCat.ofHom (algebraMap ↑(X.presheaf.stalk x)
          (FractionRing ↑(X.presheaf.stalk x)))) ≫ X.fromSpecStalk x := by
    intro X Y a' ha x _ _ hgen
    have hrange : Set.range ⇑(Spec.map (CommRingCat.ofHom (algebraMap ↑(X.presheaf.stalk x)
          (FractionRing ↑(X.presheaf.stalk x)))) ≫ X.fromSpecStalk x) ⊆ Set.range ⇑a' := by
      rintro _ ⟨q, rfl⟩
      set q' := Spec.map (CommRingCat.ofHom (algebraMap ↑(X.presheaf.stalk x)
          (FractionRing ↑(X.presheaf.stalk x)))) q with hq'
      have hq'0 : q'.asIdeal = ⊥ := by
        have hp0 : (q : PrimeSpectrum (FractionRing ↑(X.presheaf.stalk x))).asIdeal = ⊥ := by
          have := (q : PrimeSpectrum (FractionRing ↑(X.presheaf.stalk x))).isPrime
          exact Ideal.eq_bot_of_prime _
        rw [hq', Spec.map_apply]
        change Ideal.comap (algebraMap ↑(X.presheaf.stalk x) (FractionRing ↑(X.presheaf.stalk x)))
          (q : PrimeSpectrum (FractionRing ↑(X.presheaf.stalk x))).asIdeal = ⊥
        rw [hp0]
        exact Ideal.comap_bot_of_injective _
          (IsFractionRing.injective ↑(X.presheaf.stalk x) (FractionRing ↑(X.presheaf.stalk x)))
      rw [Scheme.Hom.comp_apply]
      apply hgen
      · have : X.fromSpecStalk x q' ∈ Set.range ⇑(X.fromSpecStalk x) := ⟨q', rfl⟩
        rw [Scheme.range_fromSpecStalk] at this
        exact this
      · intro heq
        have heq' := heq.trans (Scheme.fromSpecStalk_closedPoint (x := x)).symm
        have h2 := (X.fromSpecStalk x).isEmbedding.injective heq'
        apply IsDiscreteValuationRing.not_a_field ↑(X.presheaf.stalk x)
        have h3 : (IsLocalRing.closedPoint ↑(X.presheaf.stalk x)).asIdeal =
          IsLocalRing.maximalIdeal ↑(X.presheaf.stalk x) := rfl
        rw [← h3, ← h2, hq'0]
    exact ⟨IsOpenImmersion.lift a' _ hrange, IsOpenImmersion.lift_fac _ _ _⟩

  have s4 : ∀ (G X : Scheme.{u}) (p : G ⟶ X), IsSeparated p → LocallyOfFiniteType p →
      AlgebraicGeometry.IsReduced G → IsLocallyNoetherian X → ∀ (x : X)
      (σ : Spec (X.presheaf.stalk x) ⟶ G), σ ≫ p = X.fromSpecStalk x → ∀ (D : Set G),
      Dense D → (∀ g ∈ D, ∀ g' : G, p g' = p g → g' = g) →
      ∃ W : X.Opens, x ∈ W ∧ IsIso (p ∣_ W) := by
    intro G X p hsep hlft hG hX x σ hσ D hD hinj
    obtain ⟨U, hxU, f, -, hf⟩ := spread_out_of_isGermInjective' (𝟙 X) p σ
      (by rw [hσ, Category.comp_id])
    rw [Category.comp_id] at hf
    refine ⟨U, hxU, ?_⟩
    have hP := isPullback_morphismRestrict p U
    let f' : U.toScheme ⟶ (p ⁻¹ᵁ U).toScheme := hP.lift (𝟙 _) f (by rw [hf, Category.id_comp])
    have hf'1 : f' ≫ (p ∣_ U) = 𝟙 _ := hP.lift_fst _ _ _
    have hf'2 : f' ≫ (p ⁻¹ᵁ U).ι = f := hP.lift_snd _ _ _
    have : IsClosedImmersion (f' ≫ (p ∣_ U)) := by rw [hf'1]; infer_instance
    have : IsClosedImmersion f' := IsClosedImmersion.of_comp f' (p ∣_ U)
    have : AlgebraicGeometry.IsReduced (p ⁻¹ᵁ U).toScheme :=
      isReduced_of_isOpenImmersion (p ⁻¹ᵁ U).ι
    have hD' : Dense (⇑(p ⁻¹ᵁ U).ι ⁻¹' D) :=
      hD.preimage (p ⁻¹ᵁ U).ι.isOpenEmbedding.isOpenMap
    have hsub : ⇑(p ⁻¹ᵁ U).ι ⁻¹' D ⊆ Set.range ⇑f' := by
      intro w hw
      refine ⟨(p ∣_ U) w, ?_⟩
      apply (p ⁻¹ᵁ U).ι.isOpenEmbedding.injective
      apply hinj _ hw
      have e1 : (p ⁻¹ᵁ U).ι (f' ((p ∣_ U) w)) = f ((p ∣_ U) w) := by
        rw [← hf'2, Scheme.Hom.comp_apply]
      have e2 : p (f ((p ∣_ U) w)) = U.ι ((p ∣_ U) w) := by
        rw [← hf, Scheme.Hom.comp_apply]
      have e3 : U.ι ((p ∣_ U) w) = p ((p ⁻¹ᵁ U).ι w) := by
        rw [← Scheme.Hom.comp_apply (p ∣_ U) U.ι, morphismRestrict_ι, Scheme.Hom.comp_apply]
      rw [e1, e2, e3]
    have : Surjective f' := by
      rw [surjective_iff]
      intro w
      have h1 : closure (⇑(p ⁻¹ᵁ U).ι ⁻¹' D) ⊆ Set.range ⇑f' :=
        closure_minimal hsub f'.isClosedEmbedding.isClosed_range
      rw [hD'.closure_eq] at h1
      exact h1 (Set.mem_univ w)
    have : IsIso f' := isIso_of_isClosedImmersion_of_surjective f'
    have : p ∣_ U = inv f' := by
      rw [← cancel_epi f', hf'1, IsIso.hom_inv_id]
    rw [this]
    infer_instance

  have hfl : Flat u' := hss'.1
  have s2 : ∃ t : ↑(Z'.presheaf.stalk ξ), t ∈ nonZeroDivisors ↑(Z'.presheaf.stalk ξ) ∧
      IsLocalRing.maximalIdeal ↑(Z'.presheaf.stalk ξ) = Ideal.span {t} := by
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hϖ0 : ϖ ≠ 0 := hϖ.ne_zero
    set φ : R →+* ↑(Z'.presheaf.stalk ξ) :=
      ((Scheme.ΓSpecIso (.of R)).inv ≫ u'.appTop ≫ Z'.presheaf.germ ⊤ ξ trivial).hom with hφ
    have hK : Z'.fromSpecStalk ξ ≫ u' = Spec.map (CommRingCat.ofHom φ) := by
      have e0 : (Spec (.of R)).toSpecΓ = Spec.map (Scheme.ΓSpecIso (.of R)).hom :=
        (Scheme.isoSpec_hom _).symm.trans (Scheme.isoSpec_Spec_hom _)
      rw [← cancel_mono (Spec (.of R)).toSpecΓ, Category.assoc, Scheme.toSpecΓ_naturality,
        ← Category.assoc, Scheme.fromSpecStalk_toSpecΓ, e0, ← Spec.map_comp, ← Spec.map_comp, hφ,
        CommRingCat.ofHom_hom, Iso.hom_inv_id_assoc]
    have hKpt : ∀ P : Spec (Z'.presheaf.stalk ξ),
        u' (Z'.fromSpecStalk ξ P) = PrimeSpectrum.comap φ P := by
      intro P
      rw [← Scheme.Hom.comp_apply, hK, Spec.map_apply, CommRingCat.hom_ofHom]
    obtain ⟨W, hW, hξW, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z'.isBasis_affineOpens)
      (show ξ ∈ (⊤ : Z'.Opens) from trivial)
    have hW' : IsAffineOpen W := hW
    letI : Algebra Γ(Z', W) (Z'.presheaf.stalk ξ) :=
      TopCat.Presheaf.algebra_section_stalk Z'.presheaf (⟨ξ, hξW⟩ : W)
    haveI hloc : IsLocalization.AtPrime (Z'.presheaf.stalk ξ)
        (hW'.primeIdealOf ⟨ξ, hξW⟩).asIdeal :=
      hW'.isLocalization_stalk ⟨ξ, hξW⟩
    have halg : algebraMap Γ(Z', W) (Z'.presheaf.stalk ξ) = (Z'.presheaf.germ W ξ hξW).hom := rfl
    have hσt : algebraMap Γ(Z', W) (Z'.presheaf.stalk ξ) (wcCnSigma u' W ϖ) = φ ϖ := by
      rw [halg, wcCnSigma, hφ]
      simp only [RingHom.coe_comp, Function.comp_apply]
      exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
    have hφflat : φ.Flat := by
      have e : W ≤ u' ⁻¹ᵁ (⊤ : (Spec (.of R)).Opens) := fun _ _ => trivial
      have h1 : (u'.appLE ⊤ W e).hom.Flat :=
        HasRingHomProperty.appLE (P := @Flat) u' hfl ⟨⊤, isAffineOpen_top _⟩ ⟨W, hW'⟩ e
      have h2 : (Scheme.ΓSpecIso (.of R)).inv.hom.Flat :=
        RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso _)
      have h3 : (Z'.presheaf.germ W ξ hξW).hom.Flat := by
        rw [← halg, RingHom.flat_algebraMap_iff]
        exact IsLocalization.flat _ (hW'.primeIdealOf ⟨ξ, hξW⟩).asIdeal.primeCompl
      have e2 : φ = (Z'.presheaf.germ W ξ hξW).hom.comp ((u'.appLE ⊤ W e).hom.comp
          (Scheme.ΓSpecIso (.of R)).inv.hom) := by
        rw [hφ]
        ext r
        simp only [RingHom.coe_comp, Function.comp_apply, CommRingCat.comp_apply,
          Scheme.Hom.appLE]
