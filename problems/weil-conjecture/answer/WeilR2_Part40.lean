theorem wcpa_dj_nccw_ebn_omega_rank : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), LocallyOfFiniteType u → ∀ (z : Z), u z = IsLocalRing.closedPoint R → IsClosed ({z} : Set Z) → ∀ (c : R) (e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z) ≃+* (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c})), c ≠ 0 → c ∈ IsLocalRing.maximalIdeal R → e.toRingHom.comp ((algebraMap (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))).comp ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤))) = (Ideal.Quotient.mk _).comp MvPowerSeries.C → ∀ 𝔮 : PrimeSpectrum (Z.presheaf.stalk z), (∃ r ∈ IsLocalRing.maximalIdeal R, (Z.presheaf.germ ⊤ z trivial).hom (wcCnSigma u ⊤ r) ∉ 𝔮.asIdeal) → letI := ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).toAlgebra; FiniteDimensional 𝔮.asIdeal.ResidueField (TensorProduct (Z.presheaf.stalk z) 𝔮.asIdeal.ResidueField (Ω[Z.presheaf.stalk z⁄R])) ∧ Module.finrank 𝔮.asIdeal.ResidueField (TensorProduct (Z.presheaf.stalk z) 𝔮.asIdeal.ResidueField (Ω[Z.presheaf.stalk z⁄R])) ≤ 1 :=
by

  have s1 : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)),
      LocallyOfFiniteType u → ∀ (z : Z),
      letI := ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).toAlgebra;
      Algebra.EssFiniteType R (Z.presheaf.stalk z) ∧ IsNoetherianRing (Z.presheaf.stalk z) := by
    intro R _ _ Z u hu z
    have h1 : (Scheme.ΓSpecIso (.of R)).inv.hom.EssFiniteType :=
      (RingHom.FiniteType.of_surjective _
        (Scheme.ΓSpecIso (.of R)).commRingCatIsoToRingEquiv.symm.surjective).essFiniteType
    have h2 : ((Spec (.of R)).presheaf.germ ⊤ (u z) trivial).hom.EssFiniteType := by
      letI : Algebra Γ(Spec (.of R), ⊤) ((Spec (.of R)).presheaf.stalk (u z)) :=
        ((Spec (.of R)).presheaf.germ ⊤ (u z) trivial).hom.toAlgebra
      have hloc := IsAffineOpen.isLocalization_stalk (isAffineOpen_top (Spec (.of R))) ⟨u z, trivial⟩
      exact Algebra.EssFiniteType.of_isLocalization _
        ((isAffineOpen_top (Spec (.of R))).primeIdealOf ⟨u z, trivial⟩).asIdeal.primeCompl
    have h3 : (u.stalkMap z).hom.EssFiniteType := AlgebraicGeometry.LocallyOfFiniteType.stalkMap u z
    have h4 := (h1.comp h2).comp h3
    have heq : ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)) =
        (u.stalkMap z).hom.comp (((Spec (.of R)).presheaf.germ ⊤ (u z) trivial).hom.comp
          (Scheme.ΓSpecIso (.of R)).inv.hom) := by
      have key : u.appTop ≫ Z.presheaf.germ ⊤ z trivial =
          (Spec (.of R)).presheaf.germ ⊤ (u z) trivial ≫ u.stalkMap z :=
        (Scheme.Hom.germ_stalkMap u ⊤ z trivial).symm
      have hres : ∀ s, (Z.presheaf.germ ⊤ z trivial).hom
          ((Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op).hom s) =
          (Z.presheaf.germ ⊤ z trivial).hom s := fun s =>
        TopCat.Presheaf.germ_res_apply Z.presheaf (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)) z
