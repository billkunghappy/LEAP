    exact (asIso (τ.stalkMap y) ≪≫ Spec.stalkIso _ y).commRingCatIsoToRingEquiv
  have s4 (S : Scheme.{u}) (W : S.Opens) (hW : IsAffineOpen W) (s : S) (hs : s ∈ W) (A : Type u)
      [CommRing A] (e : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk s))
        (S.presheaf.stalk s) ≃+* A) :
      ∃ e₁ : AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime (hW.primeIdealOf ⟨s, hs⟩).asIdeal)) (Localization.AtPrime (hW.primeIdealOf ⟨s, hs⟩).asIdeal) ≃+* A, ∀ b : Γ(S, W), e₁ (algebraMap Γ(S, W) (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime (hW.primeIdealOf ⟨s, hs⟩).asIdeal)) (Localization.AtPrime (hW.primeIdealOf ⟨s, hs⟩).asIdeal)) b) = e (algebraMap (S.presheaf.stalk s) (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)) ((S.presheaf.germ W s hs).hom b)) := by
    have factorPow_evalₐ : ∀ (O : Type u) [CommRing O] (I : Ideal O) {m n : ℕ} (hmn : m ≤ n),
