  obtain ⟨r, hr_surj, hr_ker, hr_alg⟩ : ∃ r : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
      IsLocalRing.ResidueField A, Function.Surjective r ∧
      RingHom.ker r = IsLocalRing.maximalIdeal _ ∧
      ∀ a, r (algebraMap A _ a) = IsLocalRing.residue A a := by
    refine ⟨e₀.symm.toRingHom.comp (IsLocalRing.residue _), ?_, ?_, ?_⟩
