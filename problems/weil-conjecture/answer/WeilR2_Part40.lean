    exact ⟨hsm, c, e, hc, he⟩

theorem wcpa_dj_ldx_nc_fibre_connected : wcpaDjNcFibConn.{u} :=
by
  classical

  have s1 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O],
      HenselianLocalRing (AdicCompletion (IsLocalRing.maximalIdeal O) O) := by
    intro O _ _ _
    have hfg : (IsLocalRing.maximalIdeal O).FG := IsNoetherian.noetherian _
    have h1 : IsAdicComplete (IsLocalRing.maximalIdeal O)
        (AdicCompletion (IsLocalRing.maximalIdeal O) O) := AdicCompletion.isAdicComplete hfg
    have h2 := (IsAdicComplete.map_algebraMap_iff (R := O)
      (S := AdicCompletion (IsLocalRing.maximalIdeal O) O) (IsLocalRing.maximalIdeal O)
      (AdicCompletion (IsLocalRing.maximalIdeal O) O)).mpr h1
    rw [← AdicCompletion.maximalIdeal_eq_map] at h2
    have := h2
    have := IsAdicComplete.henselianRing (AdicCompletion (IsLocalRing.maximalIdeal O) O)
      (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal O) O))
    refine HenselianLocalRing.mk ?_
    intro f hf a₀ h₁ h₂
    exact HenselianRing.is_henselian f hf a₀ h₁ (h₂.map _)

  have s2 : ∀ (S : Scheme.{u}) (w : S), Flat (S.fromSpecStalk w) := by
    intro S w
    obtain ⟨W, hW, hwW, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := w) trivial
    rw [← hW.fromSpecStalk_eq_fromSpecStalk hwW]
    show Flat (Spec.map (S.presheaf.germ W w hwW) ≫ hW.fromSpec)
    have : Flat (Spec.map (S.presheaf.germ W w hwW)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      let x : W := ⟨w, hwW⟩
      letI := TopCat.Presheaf.algebra_section_stalk S.presheaf x
      have hloc := hW.isLocalization_stalk x
      have := IsLocalization.flat (S.presheaf.stalk (x : S)) (hW.primeIdealOf x).asIdeal.primeCompl
      exact RingHom.flat_algebraMap_iff.mpr this
    infer_instance

  have s4 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (E : Scheme.{u}) (p : E ⟶ Spec (.of R)), Flat p → ∀ x : E, ∃ x' : E, x' ⤳ x ∧
        p x' ≠ IsLocalRing.closedPoint R := by
    intro R _ _ _ E p hp x
    by_cases hx : p x = IsLocalRing.closedPoint R
    · let η : PrimeSpectrum R := ⟨⊥, Ideal.isPrime_bot⟩
      have hη : η ⤳ p x := by rw [hx]; exact IsLocalRing.specializes_closedPoint η
      obtain ⟨x', hx', hpx'⟩ := Flat.generalizingMap p hη
      refine ⟨x', hx', ?_⟩
      rw [hpx']
      intro h
      apply IsDiscreteValuationRing.not_a_field R
      have : η.asIdeal = (IsLocalRing.closedPoint R).asIdeal := by rw [h]
      exact this.symm
    · exact ⟨x, specializes_refl x, hx⟩
  intro R _ _ _ _ S X sS q _ hlft hqp hflat ⟨V, hV, hiso⟩ w hw hwc hdom
  have := hlft
  have := hqp
  have := hflat
  have := hiso
  have : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian sS
  have hhens : HenselianLocalRing
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk w)) (S.presheaf.stalk w)) := s1 _
  have := hdom
  set A := AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk w)) (S.presheaf.stalk w)
    with hAdef
  obtain ⟨b, hbdef⟩ : ∃ b : Spec (.of A) ⟶ S,
      b = Spec.map (CommRingCat.ofHom (algebraMap (S.presheaf.stalk w) A)) ≫
        S.fromSpecStalk w := ⟨_, rfl⟩
  have hbflat : Flat b := by
    have : Flat (Spec.map (CommRingCat.ofHom (algebraMap (S.presheaf.stalk w) A))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact RingHom.flat_algebraMap_iff.mpr (AdicCompletion.flat_of_isNoetherian _)
    have := s2 S w
    rw [hbdef]
    infer_instance
  have hbm : b (IsLocalRing.closedPoint A) = w := by
    have : IsLocalHom (CommRingCat.Hom.hom
        (CommRingCat.ofHom (algebraMap (S.presheaf.stalk w) A))) := by
      rw [CommRingCat.hom_ofHom]; infer_instance
    have e1 : (Spec.map (CommRingCat.ofHom (algebraMap (S.presheaf.stalk w) A)))
        (IsLocalRing.closedPoint A) = IsLocalRing.closedPoint (S.presheaf.stalk w) :=
      Spec_closedPoint
    rw [hbdef]
    exact (congrArg (S.fromSpecStalk w) e1).trans Scheme.fromSpecStalk_closedPoint
  obtain ⟨XA, hXA⟩ : ∃ XA : Scheme.{u}, XA = Limits.pullback q b := ⟨_, rfl⟩
  subst hXA
  have hFflat : Flat (Limits.pullback.fst q b) :=
    MorphismProperty.of_isPullback (P := @Flat) (IsPullback.of_hasPullback q b).flip hbflat
  have hqF : ∀ z, q (Limits.pullback.fst q b z) = b (Limits.pullback.snd q b z) := by
    intro z
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  rw [isPreconnected_closed_iff]
  intro t t' ht ht' hcov ⟨x₁, hx₁w, hx₁t⟩ ⟨x₂, hx₂w, hx₂t'⟩
  by_contra hempty
  rw [Set.not_nonempty_iff_eq_empty] at hempty
  have hqw : IsClosed (⇑q ⁻¹' {w}) := hwc.preimage q.continuous
  have hmA : IsClosed ({IsLocalRing.closedPoint A} : Set (Spec (.of A))) :=
    IsLocalRing.isClosed_singleton_closedPoint A
  set T₁ : Set ↥(Limits.pullback q b) := ⇑(Limits.pullback.fst q b) ⁻¹' (⇑q ⁻¹' {w} ∩ t) ∩
    ⇑(Limits.pullback.snd q b) ⁻¹' ({IsLocalRing.closedPoint A} : Set (Spec (.of A)))
    with hT₁def
  set T₂ : Set ↥(Limits.pullback q b) := ⇑(Limits.pullback.fst q b) ⁻¹' (⇑q ⁻¹' {w} ∩ t') ∩
    ⇑(Limits.pullback.snd q b) ⁻¹' ({IsLocalRing.closedPoint A} : Set (Spec (.of A)))
    with hT₂def
  have hT₁ : IsClosed T₁ := ((hqw.inter ht).preimage (Limits.pullback.fst q b).continuous).inter
    (hmA.preimage (Limits.pullback.snd q b).continuous)
  have hT₂ : IsClosed T₂ := ((hqw.inter ht').preimage (Limits.pullback.fst q b).continuous).inter
    (hmA.preimage (Limits.pullback.snd q b).continuous)
  have hdisj : Disjoint T₁ T₂ := by
    rw [Set.disjoint_left]
    rintro z ⟨⟨h1, h2⟩, -⟩ ⟨⟨-, h3⟩, -⟩
    have : Limits.pullback.fst q b z ∈ ⇑q ⁻¹' {w} ∩ (t ∩ t') := ⟨h1, h2, h3⟩
    rw [hempty] at this
    exact this
  have hunion : T₁ ∪ T₂ = ⇑(Limits.pullback.snd q b) ⁻¹' {IsLocalRing.closedPoint A} := by
    ext z
    constructor
    · rintro (⟨-, h⟩ | ⟨-, h⟩) <;> exact h
    · intro hz
      have hz' : Limits.pullback.snd q b z = IsLocalRing.closedPoint A := hz
      have hFz : Limits.pullback.fst q b z ∈ ⇑q ⁻¹' {w} := by
        show q (Limits.pullback.fst q b z) ∈ ({w} : Set S)
        rw [hqF, hz', hbm]
        rfl
      rcases hcov hFz with h | h
      · exact Or.inl ⟨⟨hFz, h⟩, hz⟩
      · exact Or.inr ⟨⟨hFz, h⟩, hz⟩
  obtain ⟨C, hC, hCT⟩ := wc_proper_henselian_closed_fibre_clopen_extend A
    (Limits.pullback q b) (Limits.pullback.snd q b) T₁ T₂ hT₁ hT₂ hdisj hunion
  obtain ⟨z₁, hz₁F, hz₁q⟩ := Scheme.Pullback.exists_preimage_pullback (f := q) (g := b) x₁
    (IsLocalRing.closedPoint A) (hx₁w.trans hbm.symm)
  obtain ⟨z₂, hz₂F, hz₂q⟩ := Scheme.Pullback.exists_preimage_pullback (f := q) (g := b) x₂
    (IsLocalRing.closedPoint A) (hx₂w.trans hbm.symm)
  have hz₁T : z₁ ∈ T₁ := by
    refine ⟨?_, hz₁q⟩
    show Limits.pullback.fst q b z₁ ∈ ⇑q ⁻¹' {w} ∩ t
    rw [hz₁F]
    exact ⟨hx₁w, hx₁t⟩
  have hz₂T : z₂ ∈ T₂ := by
    refine ⟨?_, hz₂q⟩
    show Limits.pullback.fst q b z₂ ∈ ⇑q ⁻¹' {w} ∩ t'
    rw [hz₂F]
    exact ⟨hx₂w, hx₂t'⟩
  have hz₁C : z₁ ∈ C := (hCT z₁ hz₁q).mpr hz₁T
  have hz₂C : z₂ ∉ C := fun h => Set.disjoint_left.mp hdisj ((hCT z₂ hz₂q).mp h) hz₂T
  have hp : Flat (Limits.pullback.fst q b ≫ q ≫ sS) := inferInstance
  obtain ⟨z₁', hz₁'s, hz₁'p⟩ := s4 R _ _ hp z₁
  obtain ⟨z₂', hz₂'s, hz₂'p⟩ := s4 R _ _ hp z₂
  have hz₁'C : z₁' ∈ C := hz₁'s.mem_open hC.isOpen hz₁C
  have hz₂'C : z₂' ∈ Cᶜ := hz₂'s.mem_open hC.isClosed.isOpen_compl hz₂C
  have hΩ : ∀ z, (Limits.pullback.fst q b ≫ q ≫ sS) z ≠ IsLocalRing.closedPoint R →
      z ∈ Set.range ((Limits.pullback.snd q b) ⁻¹ᵁ (b ⁻¹ᵁ V)).ι := by
    intro z hz
    rw [Scheme.Opens.range_ι, SetLike.mem_coe, Scheme.Hom.mem_preimage,
      Scheme.Hom.mem_preimage, ← hqF]
    apply hV
    simpa only [Scheme.Hom.comp_apply] using hz

  have hPre : IsPreirreducible (Set.range ((Limits.pullback.snd q b) ⁻¹ᵁ (b ⁻¹ᵁ V)).ι) := by
    have hbig := ((isPullback_morphismRestrict (Limits.pullback.snd q b) (b ⁻¹ᵁ V)).flip).paste_horiz
      (IsPullback.of_hasPullback q b)
    rw [← morphismRestrict_ι] at hbig
    have hR := (isPullback_morphismRestrict q V).flip
    let κ := hR.lift (((Limits.pullback.snd q b) ⁻¹ᵁ (b ⁻¹ᵁ V)).ι ≫ Limits.pullback.fst q b)
      ((Limits.pullback.snd q b ∣_ (b ⁻¹ᵁ V)) ≫ (b ∣_ V)) (by
        rw [Category.assoc, Category.assoc]
        exact hbig.w)
    have hκ1 : κ ≫ (q ⁻¹ᵁ V).ι =
        ((Limits.pullback.snd q b) ⁻¹ᵁ (b ⁻¹ᵁ V)).ι ≫ Limits.pullback.fst q b := hR.lift_fst _ _ _
    have hκ2 : κ ≫ (q ∣_ V) = (Limits.pullback.snd q b ∣_ (b ⁻¹ᵁ V)) ≫ (b ∣_ V) :=
      hR.lift_snd _ _ _
    rw [← hκ1] at hbig
    have hsq := IsPullback.of_right hbig hκ2 hR
    have hisoA : IsIso (Limits.pullback.snd q b ∣_ (b ⁻¹ᵁ V)) :=
      MorphismProperty.of_isPullback (P := MorphismProperty.isomorphisms Scheme) hsq hiso
    let e := Scheme.homeoOfIso (asIso (Limits.pullback.snd q b ∣_ (b ⁻¹ᵁ V)))
    have h1 : IsPreirreducible (Set.univ : Set (b ⁻¹ᵁ V).toScheme) := by
      have hW : IsPreirreducible ((b ⁻¹ᵁ V : (Spec (.of A)).Opens) : Set (Spec (.of A))) :=
        (IrreducibleSpace.isIrreducible_univ _).isPreirreducible.open_subset (b ⁻¹ᵁ V).isOpen
          (Set.subset_univ _)
      have := hW.preimage (b ⁻¹ᵁ V).ι.isOpenEmbedding
      convert this
      ext y
      simp only [Set.mem_univ, Set.mem_preimage, true_iff]
      rw [← Scheme.Opens.range_ι]
      exact ⟨y, rfl⟩
    have h2 := h1.image (fun y => ((Limits.pullback.snd q b) ⁻¹ᵁ (b ⁻¹ᵁ V)).ι (e.symm y))
      ((((Limits.pullback.snd q b) ⁻¹ᵁ (b ⁻¹ᵁ V)).ι.continuous.comp e.symm.continuous).continuousOn)
    rw [Set.image_univ] at h2
    have h3 : Set.range (fun y => ((Limits.pullback.snd q b) ⁻¹ᵁ (b ⁻¹ᵁ V)).ι (e.symm y)) =
        Set.range ((Limits.pullback.snd q b) ⁻¹ᵁ (b ⁻¹ᵁ V)).ι :=
      e.symm.surjective.range_comp _
    rwa [h3] at h2
  obtain ⟨z, -, hzC, hzC'⟩ := hPre C Cᶜ hC.isOpen hC.isClosed.isOpen_compl
    ⟨z₁', hΩ z₁' hz₁'p, hz₁'C⟩ ⟨z₂', hΩ z₂' hz₂'p, hz₂'C⟩
  exact hzC' hzC

theorem wcpa_dj_ncc_nag_reduced_to_domains (B : Type u) [CommRing B] [IsNoetherianRing B]
    [_root_.IsReduced B] (h : ∀ p ∈ minimalPrimes B, wcpaDjNccN1 (B ⧸ p)) :
    wcpaDjNccN1 B :=
by
  classical
  unfold wcpaDjNccN1 at h ⊢
  haveI hfin : Finite ↥(minimalPrimes B) := (minimalPrimes.finite_of_isNoetherianRing B).to_subtype
  haveI hprime : ∀ i : ↥(minimalPrimes B), (i.1).IsPrime := fun i => i.2.1.1
  let g : ∀ i : ↥(minimalPrimes B), B →+* FractionRing (B ⧸ i.1) := fun i =>
    (algebraMap (B ⧸ i.1) (FractionRing (B ⧸ i.1))).comp (Ideal.Quotient.mk i.1)
  have hg : ∀ i : ↥(minimalPrimes B), ∀ b : B,
      g i b = algebraMap (B ⧸ i.1) (FractionRing (B ⧸ i.1)) (Ideal.Quotient.mk i.1 b) :=
    fun i b => rfl
  have hunit : ∀ i : ↥(minimalPrimes B), ∀ s : nonZeroDivisors B, IsUnit (g i s) := by
    intro i s
    have hs : (s : B) ∉ i.1 := fun hm =>
      Set.disjoint_left.mp (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes i.2) hm s.2
    have h1 : Ideal.Quotient.mk i.1 (s : B) ≠ 0 := by
      rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
    have h2 : g i s ≠ 0 := by
      intro h0
      apply h1
      rw [hg] at h0
      exact (IsFractionRing.injective (B ⧸ i.1) (FractionRing (B ⧸ i.1)))
        (h0.trans (map_zero _).symm)
    exact isUnit_iff_ne_zero.mpr h2
  let φ : ∀ i : ↥(minimalPrimes B), FractionRing B →+* FractionRing (B ⧸ i.1) := fun i =>
    IsLocalization.lift (M := nonZeroDivisors B) (S := FractionRing B) (hunit i)
  have hφ : ∀ i : ↥(minimalPrimes B), ∀ b : B, φ i (algebraMap B (FractionRing B) b) = g i b :=
    fun i b => IsLocalization.lift_eq (hunit i) b
  have hcomp : ∀ i : ↥(minimalPrimes B),
      (algebraMap (B ⧸ i.1) (FractionRing (B ⧸ i.1))).comp (Ideal.Quotient.mk i.1)
        = (φ i).comp (algebraMap B (FractionRing B)) :=
    fun i => RingHom.ext fun b => (hφ i b).symm
  have hint : ∀ i : ↥(minimalPrimes B), ∀ y : FractionRing B, IsIntegral B y →
      IsIntegral (B ⧸ i.1) (φ i y) :=
    fun i y hy => hy.map_of_comp_eq (Ideal.Quotient.mk i.1) (φ i) (hcomp i)
  have hsmul : ∀ (i : ↥(minimalPrimes B)) (b : B) (x : FractionRing (B ⧸ i.1)),
      b • x = g i b * x := by
    intro i b x
    rw [Algebra.smul_def, IsScalarTower.algebraMap_apply B (B ⧸ i.1) (FractionRing (B ⧸ i.1)),
      Ideal.Quotient.algebraMap_eq]
    rfl
  let F : integralClosure B (FractionRing B) →ₗ[B]
      (∀ i : ↥(minimalPrimes B), integralClosure (B ⧸ i.1) (FractionRing (B ⧸ i.1))) :=
    { toFun := fun y i => ⟨φ i y.1, hint i y.1 y.2⟩
      map_add' := by
        intro y z
        funext i
        apply Subtype.ext
        show φ i (y.1 + z.1) = φ i y.1 + φ i z.1
        exact map_add _ _ _
      map_smul' := by
        intro b y
        funext i
        apply Subtype.ext
        show φ i (b • y.1) = b • φ i y.1
        rw [Algebra.smul_def, map_mul, hφ, hsmul] }
  have hinj : Function.Injective F := by
    rw [injective_iff_map_eq_zero]
    intro y hy
    obtain ⟨⟨b, s⟩, hbs'⟩ := IsLocalization.mk'_surjective (nonZeroDivisors B) y.1
    have hbs : IsLocalization.mk' (FractionRing B) b s = y.1 := hbs'
    have hspec := IsLocalization.mk'_spec (FractionRing B) b s
    rw [hbs] at hspec
    have hb : ∀ i : ↥(minimalPrimes B), b ∈ i.1 := by
      intro i
      have hyi : φ i y.1 = 0 := by
        have := congrArg (fun f => (f i : FractionRing (B ⧸ i.1))) hy
        exact this
      have e := congrArg (φ i) hspec
      rw [map_mul, hyi, zero_mul, hφ, hg] at e
      have e2 : Ideal.Quotient.mk i.1 b = 0 :=
        (IsFractionRing.injective (B ⧸ i.1) (FractionRing (B ⧸ i.1)))
          (e.symm.trans (map_zero _).symm)
      exact Ideal.Quotient.eq_zero_iff_mem.mp e2
    have hbinf : b ∈ sInf (minimalPrimes B) := by
      rw [Ideal.mem_sInf]
      intro p hp
      exact hb ⟨p, hp⟩
    have hb0 : b = 0 := by
      have hrad : sInf (minimalPrimes B) = (⊥ : Ideal B).radical := Ideal.sInf_minimalPrimes
      rw [hrad] at hbinf
      obtain ⟨n, hn⟩ := hbinf
      exact _root_.IsReduced.eq_zero b ⟨n, hn⟩
    apply Subtype.ext
    rw [← hbs, hb0, IsLocalization.mk'_zero]
    rfl
  haveI hC : ∀ i : ↥(minimalPrimes B),
      Module.Finite B (integralClosure (B ⧸ i.1) (FractionRing (B ⧸ i.1))) := by
    intro i
    haveI := h i.1 i.2
    exact Module.Finite.trans (B ⧸ i.1) _
  haveI : Module.Finite B
      (∀ i : ↥(minimalPrimes B), integralClosure (B ⧸ i.1) (FractionRing (B ⧸ i.1))) :=
    Module.Finite.pi
  haveI : IsNoetherian B
      (∀ i : ↥(minimalPrimes B), integralClosure (B ⧸ i.1) (FractionRing (B ⧸ i.1))) :=
    isNoetherian_of_isNoetherianRing_of_finite _ _
  exact Module.Finite.of_injective F hinj

theorem wcpa_dj_ncc_nag_complete_dvr (R : Type u) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] (hR : IsAdicComplete (IsLocalRing.maximalIdeal R) R) :
    wcpaDjNccNag R :=
by
  classical

  have s2 : ∀ (ϖ : R), Irreducible ϖ → ∀ (a : ℕ → R), (∀ n, ϖ ^ n ∣ a (n + 1) - a n) →
      ∃ ℓ : R, ∀ n, ϖ ^ n ∣ ℓ - a n := by
    intro ϖ hϖ a ha
    have hI : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have key : ∀ (n : ℕ) (y w : R),
        y ≡ w [SMOD (IsLocalRing.maximalIdeal R) ^ n • (⊤ : Submodule R R)] ↔ ϖ ^ n ∣ y - w := by
      intro n y w
      rw [SModEq.sub_mem, hI, Ideal.span_singleton_pow, Ideal.smul_eq_mul, Ideal.mul_top,
        Ideal.mem_span_singleton]
    have tele : ∀ m k, ϖ ^ m ∣ a (m + k) - a m := by
      intro m k
      induction k with
      | zero => simp
      | succ k ih =>
        have e : a (m + (k+1)) - a m = (a (m + k + 1) - a (m + k)) + (a (m+k) - a m) := by
          rw [← add_assoc]; ring
        rw [e]
        exact dvd_add ((pow_dvd_pow ϖ (Nat.le_add_right m k)).trans (ha (m+k))) ih
    haveI := hR
    obtain ⟨ℓ, hℓ⟩ := IsPrecomplete.prec (I := IsLocalRing.maximalIdeal R) (M := R) inferInstance
      (f := a) (by
        intro m n hmn
        rw [key]
        obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hmn
        rw [← dvd_neg, neg_sub]; exact tele m k)
    refine ⟨ℓ, fun n => ?_⟩
    rw [← dvd_neg, neg_sub]
    exact (key n _ _).mp (hℓ n)
  refine ⟨inferInstance, ?_⟩
  intro D _ _ _ hD
  have hprime := RingHom.ker_isPrime (algebraMap R D)
  by_cases hker : RingHom.ker (algebraMap R D) = ⊥
  ·
    have hinjRD : Function.Injective (algebraMap R D) :=
      (RingHom.injective_iff_ker_eq_bot _).mpr hker
    let e : R ≃+* D := RingEquiv.ofBijective (algebraMap R D) ⟨hinjRD, hD⟩
    haveI : IsDiscreteValuationRing D :=
      IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible D
    have hϖR : Irreducible (e.symm ϖ) := hϖ.map e.symm
    have hcomp : ∀ a : ℕ → D, (∀ n, ϖ ^ n ∣ a (n + 1) - a n) →
        ∃ ℓ : D, ∀ n, ϖ ^ n ∣ ℓ - a n := by
      intro a ha
      obtain ⟨ℓ', hℓ'⟩ := s2 (e.symm ϖ) hϖR (fun n => e.symm (a n)) (fun n => by
        have h := map_dvd e.symm (ha n)
        simpa [map_sub, map_pow] using h)
      refine ⟨e ℓ', fun n => ?_⟩
      have h := map_dvd e (hℓ' n)
      simpa [map_sub, map_pow] using h
    intro L _ _ _ _ hfin
    haveI : FiniteDimensional (FractionRing D) L := hfin
    have hinj : Function.Injective (algebraMap D L) := by
      rw [IsScalarTower.algebraMap_eq D (FractionRing D) L, RingHom.coe_comp]
      exact (algebraMap (FractionRing D) L).injective.comp (IsFractionRing.injective D _)

    have hkrull : ∀ s : D, (∀ n : ℕ, ϖ ^ n ∣ s) → s = 0 := by
      intro s h
      by_contra hs
      obtain ⟨k, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hs hϖ
      have h1 := h (k+1)
      rw [pow_succ, mul_comm (u:D)] at h1
      have h2 : ϖ ∣ (u:D) := (mul_dvd_mul_iff_left (pow_ne_zero k hϖ.ne_zero)).mp h1
      exact hϖ.not_isUnit (isUnit_of_dvd_unit h2 u.isUnit)

    have hlift : ∀ (m : ℕ) (z : Fin m → L), (∀ c : Fin m → D, ∀ b ∈ integralClosure D L,
        ∑ i, c i • z i = algebraMap D L ϖ * b → ∀ i, ϖ ∣ c i) →
        ∀ (n : ℕ) (c : Fin m → D), ∀ b ∈ integralClosure D L,
          ∑ i, c i • z i = algebraMap D L ϖ ^ n * b → ∀ i, ϖ ^ n ∣ c i := by
      intro m z hfree n
      induction n with
      | zero => intro c b _ _ i; simp
      | succ n ih =>
        intro c b hb h i
        have hb' : algebraMap D L ϖ ^ n * b ∈ integralClosure D L :=
          Subalgebra.mul_mem _ (Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ ϖ) n) hb
        have h1 := hfree c _ hb' (by rw [h, pow_succ']; ring)
        choose c' hc' using h1
        have hne : algebraMap D L ϖ ≠ 0 := by
          intro h0; apply hϖ.ne_zero; apply hinj; rw [h0, map_zero]
        have h2 : ∑ i, c i • z i = algebraMap D L ϖ * ∑ i, c' i • z i := by
          rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [hc' j, mul_smul, Algebra.smul_def ϖ]
        have h3 : ∑ i, c' i • z i = algebraMap D L ϖ ^ n * b := by
          apply mul_left_cancel₀ hne
          rw [← h2, h, pow_succ']; ring
        rw [hc' i, pow_succ']
        exact mul_dvd_mul_left ϖ (ih c' b hb h3 i)

    have hbound : ∀ (m : ℕ) (z : Fin m → L), (∀ i, z i ∈ integralClosure D L) →
        (∀ c : Fin m → D, ∀ b ∈ integralClosure D L,
          ∑ i, c i • z i = algebraMap D L ϖ * b → ∀ i, ϖ ∣ c i) →
        m ≤ Module.finrank (FractionRing D) L := by
      intro m z _ hfree
      have hl := hlift m z hfree
      have hA : LinearIndependent D z := by
        rw [Fintype.linearIndependent_iff]
        intro g hg i
        exact hkrull _ (fun n => hl n g 0 (zero_mem _) (by rw [hg, mul_zero]) i)
      have hK : LinearIndependent (FractionRing D) z :=
        (LinearIndependent.iff_fractionRing D (FractionRing D)).mp hA
      simpa using hK.fintype_card_le_finrank

    obtain ⟨m, z, hz, hfree, hspan⟩ : ∃ (m : ℕ) (z : Fin m → L),
        (∀ i, z i ∈ integralClosure D L) ∧
        (∀ c : Fin m → D, ∀ b ∈ integralClosure D L,
          ∑ i, c i • z i = algebraMap D L ϖ * b → ∀ i, ϖ ∣ c i) ∧
        ∀ x ∈ integralClosure D L, ∃ c : Fin m → D, ∃ b ∈ integralClosure D L,
          x = ∑ i, c i • z i + algebraMap D L ϖ * b := by
      have hDu : ∀ c : D, ¬ ϖ ∣ c → IsUnit c := by
        intro c hc
        by_contra hu
        apply hc
        have hm : c ∈ IsLocalRing.maximalIdeal D := (IsLocalRing.mem_maximalIdeal c).mpr hu
        rw [(IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ,
          Ideal.mem_span_singleton] at hm
        exact hm
      generalize Module.finrank (FractionRing D) L = N at hbound
      let P : ℕ → Prop := fun m => ∃ z : Fin m → L, (∀ i, z i ∈ integralClosure D L) ∧
        (∀ c : Fin m → D, ∀ b ∈ integralClosure D L,
          ∑ i, c i • z i = algebraMap D L ϖ * b → ∀ i, ϖ ∣ c i)
      have hP0 : P 0 := ⟨Fin.elim0, fun i => i.elim0, fun c b _ _ i => i.elim0⟩
      obtain ⟨z, hz, hfree⟩ : P (Nat.findGreatest P N) :=
        Nat.findGreatest_spec (Nat.zero_le N) hP0
      refine ⟨Nat.findGreatest P N, z, hz, hfree, fun x hx => ?_⟩
      have hnot : ¬ P (Nat.findGreatest P N + 1) := by
        intro hP
        have h1 := hbound _ hP.choose hP.choose_spec.1 hP.choose_spec.2
        have h2 := Nat.le_findGreatest h1 hP
        omega
      have hz' : ∀ i, (Fin.snoc (α := fun _ => L) z x) i ∈ integralClosure D L := by
        intro i
        refine Fin.lastCases ?_ (fun j => ?_) i
        · simp only [Fin.snoc_last]; exact hx
        · simp only [Fin.snoc_castSucc]; exact hz j
      have hex : ∃ c : Fin (Nat.findGreatest P N + 1) → D, ∃ b ∈ integralClosure D L,
          ∑ i, c i • (Fin.snoc (α := fun _ => L) z x) i = algebraMap D L ϖ * b ∧
            ∃ j, ¬ ϖ ∣ c j := by
        by_contra hcon
        push_neg at hcon
        exact hnot ⟨_, hz', fun c b hb h => hcon c b hb h⟩
      obtain ⟨c, b, hb, hsum, j, hj⟩ := hex
      rw [Fin.sum_univ_castSucc] at hsum
      simp only [Fin.snoc_castSucc, Fin.snoc_last] at hsum
      by_cases hl : ϖ ∣ c (Fin.last _)
      · exfalso
        obtain ⟨e', he'⟩ := hl
        have hb2 : b - e' • x ∈ integralClosure D L :=
          Subalgebra.sub_mem _ hb (Subalgebra.smul_mem _ hx e')
        have h3 : ∑ i, c i.castSucc • z i = algebraMap D L ϖ * (b - e' • x) := by
          rw [mul_sub, ← hsum, he', mul_smul, Algebra.smul_def ϖ]; ring
        have h4 := hfree _ _ hb2 h3
        apply hj
        refine Fin.lastCases ?_ (fun i => ?_) j
        · exact ⟨e', he'⟩
        · exact h4 i
      · obtain ⟨u, hu⟩ := hDu _ hl
        refine ⟨fun i => -(↑u⁻¹ * c i.castSucc), (↑u⁻¹ : D) • b, Subalgebra.smul_mem _ hb _, ?_⟩
        have hx1 : (u : D) • x = algebraMap D L ϖ * b - ∑ i, c i.castSucc • z i := by
          rw [hu]; exact eq_sub_of_add_eq' hsum
        calc x = (↑u⁻¹ : D) • ((u : D) • x) := by rw [smul_smul, Units.inv_mul, one_smul]
          _ = _ := by
            rw [hx1, smul_sub, Finset.smul_sum]
            simp only [Algebra.smul_def, map_neg, map_mul, neg_mul, Finset.sum_neg_distrib,
              mul_assoc]
            ring

    have hsep : ∀ x ∈ integralClosure D L,
        (∀ n : ℕ, ∃ b ∈ integralClosure D L, x = algebraMap D L ϖ ^ n * b) → x = 0 := by
      intro x hx hdiv
      have hnorm : ∀ y ∈ integralClosure D L, ∃ s : D,
          algebraMap D (FractionRing D) s = Algebra.norm (FractionRing D) y := by
        intro y hy
        exact IsIntegrallyClosed.isIntegral_iff.mp
          (Algebra.isIntegral_norm (FractionRing D) (show IsIntegral D y from hy))
      obtain ⟨s, hs⟩ := hnorm x hx
      have hs0 : s = 0 := by
        apply hkrull
        intro n
        obtain ⟨b, hb, hxb⟩ := hdiv n
        obtain ⟨r, hr⟩ := hnorm b hb
        have h1 : Algebra.norm (FractionRing D) x =
            (algebraMap D (FractionRing D) ϖ) ^ (Module.finrank (FractionRing D) L * n) *
              algebraMap D (FractionRing D) r := by
          rw [hxb, map_mul, map_pow, IsScalarTower.algebraMap_apply D (FractionRing D) L,
            Algebra.norm_algebraMap, hr, pow_mul]
        have h2 : s = ϖ ^ (Module.finrank (FractionRing D) L * n) * r := by
          apply IsFractionRing.injective D (FractionRing D)
          rw [hs, h1, map_mul, map_pow]
        rw [h2]
        exact dvd_mul_of_dvd_left (pow_dvd_pow ϖ (Nat.le_mul_of_pos_left n Module.finrank_pos)) r
      have h0 : Algebra.norm (FractionRing D) x = 0 := by rw [← hs, hs0, map_zero]
      exact Algebra.norm_eq_zero_iff.mp h0

    let w : Fin m → integralClosure D L := fun i => ⟨z i, hz i⟩
    suffices hs : Function.Surjective (Fintype.linearCombination D w) from
      Module.Finite.of_surjective _ hs
    rintro ⟨x, hx⟩
    have hstep : ∀ y : integralClosure D L, ∃ p : (Fin m → D) × integralClosure D L,
        (y : L) = ∑ i, p.1 i • z i + algebraMap D L ϖ * (p.2 : L) := by
      intro y
      obtain ⟨c, b, hb, h⟩ := hspan y y.2
      exact ⟨(c, ⟨b, hb⟩), h⟩
    choose step hstep using hstep
    let seq : ℕ → (Fin m → D) × integralClosure D L := fun n =>
      @Nat.rec (fun _ => (Fin m → D) × integralClosure D L) ((0 : Fin m → D), ⟨x, hx⟩)
        (fun k p => (p.1 + ϖ ^ k • (step p.2).1, (step p.2).2)) n
    have seq0 : seq 0 = ((0 : Fin m → D), ⟨x, hx⟩) := rfl
    have seqS : ∀ n, seq (n+1) =
        ((seq n).1 + ϖ ^ n • (step (seq n).2).1, (step (seq n).2).2) := fun n => rfl
    have key : ∀ (a c : Fin m → D) (b : L) (k : ℕ),
        ∑ i, (a + ϖ ^ k • c) i • z i + algebraMap D L ϖ ^ (k+1) * b =
          ∑ i, a i • z i + algebraMap D L ϖ ^ k * (∑ i, c i • z i + algebraMap D L ϖ * b) := by
      intro a c b k
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      simp only [Algebra.smul_def, map_add, map_mul,
        map_pow, add_mul, Finset.sum_add_distrib, mul_add, Finset.mul_sum, mul_assoc]
      rw [pow_succ]; ring
    have inv : ∀ n, x = ∑ i, (seq n).1 i • z i + algebraMap D L ϖ ^ n * ((seq n).2 : L) := by
      intro n
      induction n with
      | zero => rw [seq0]; simp
      | succ n ih =>
        rw [seqS]
        calc x = _ := ih
          _ = _ := by rw [hstep (seq n).2]
          _ = _ := (key _ _ _ n).symm
    have hc : ∀ i, ∃ ℓ : D, ∀ n, ϖ ^ n ∣ ℓ - (seq n).1 i := fun i =>
      hcomp (fun n => (seq n).1 i) (fun n => ⟨(step (seq n).2).1 i, by rw [seqS]; simp⟩)
    choose ℓ hℓ using hc
    refine ⟨ℓ, ?_⟩
    apply Subtype.ext
    rw [Fintype.linearCombination_apply]
    have hsum_coe : ((∑ i, ℓ i • w i : integralClosure D L) : L) = ∑ i, ℓ i • z i := by
      simp [w]
    rw [hsum_coe]
    have hmemS : ∀ c : Fin m → D, ∑ i, c i • z i ∈ integralClosure D L := fun c =>
      Subalgebra.sum_mem _ (fun i _ => Subalgebra.smul_mem _ (hz i) _)
    have h0 := hsep (x - ∑ i, ℓ i • z i) (Subalgebra.sub_mem _ hx (hmemS ℓ)) (fun n => by
      choose e' he' using fun i => hℓ i n
      refine ⟨-(∑ i, e' i • z i) + ((seq n).2 : L),
        Subalgebra.add_mem _ (Subalgebra.neg_mem _ (hmemS e')) (seq n).2.2, ?_⟩
      have hl : ∀ i, ℓ i = (seq n).1 i + ϖ ^ n * e' i := fun i => by rw [← he' i]; ring
      conv_lhs => rw [inv n]
      simp only [hl, Algebra.smul_def, map_add, map_mul, map_pow, add_mul,
        Finset.sum_add_distrib, mul_add, Finset.mul_sum, mul_assoc, mul_neg]
      ring)
    exact (sub_eq_zero.mp h0).symm
  ·
    have hmax : (RingHom.ker (algebraMap R D)).IsMaximal := Ideal.IsPrime.isMaximal hprime hker
    have hfield : IsField (R ⧸ RingHom.ker (algebraMap R D)) :=
      (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp hmax
    have hDf : IsField D :=
      MulEquiv.isField hfield (RingHom.quotientKerEquivOfSurjective hD).symm.toMulEquiv
    intro L _ _ _ _ hfin
    have hsurj : Function.Surjective (algebraMap D (FractionRing D)) :=
      IsFractionRing.surjective_iff_isField.mpr hDf
    have hbij : Function.Bijective (algebraMap D (FractionRing D)) :=
      ⟨IsFractionRing.injective D _, hsurj⟩
    let e := RingEquiv.ofBijective _ hbij
    haveI : Module.Finite D (FractionRing D) :=
      Module.Finite.of_surjective (Algebra.linearMap D (FractionRing D)) hsurj
    haveI := hfin
    haveI : Module.Finite D L := Module.Finite.trans (FractionRing D) L
    haveI : IsNoetherianRing D :=
      isNoetherianRing_of_surjective (FractionRing D) D e.symm.toRingHom e.symm.surjective
    exact Module.Finite.of_injective (integralClosure D L).val.toLinearMap Subtype.val_injective

theorem wcpa_dj_ncc_nagata : wcpaDjNccNagata.{u} :=
by
  unfold wcpaDjNccNagata
  intro R _ _ _ hR B _ _ hB hred
  haveI := hred
  have htrans : ∀ (A A' : Type u) [CommRing A] [CommRing A'], (A ≃+* A') →
      wcpaDjNccNag A → wcpaDjNccNag A' := by
    intro A A' _ _ e h
    refine ⟨?_, ?_⟩
    · haveI := h.1
      exact isNoetherianRing_of_ringEquiv A e
    · intro D _ _ _ hD
      letI : Algebra A D := ((algebraMap A' D).comp e.toRingHom).toAlgebra
      exact h.2 D (hD.comp e.surjective)
  have hpoly : ∀ n : ℕ, wcpaDjNccNag (MvPolynomial (Fin n) R) := by
    intro n
    induction n with
    | zero =>
      exact htrans R _ (MvPolynomial.isEmptyAlgEquiv R (Fin 0)).symm.toRingEquiv
        (wcpa_dj_ncc_nag_complete_dvr R hR)
    | succ n ih =>
      exact htrans _ _ (MvPolynomial.finSuccEquiv R n).symm.toRingEquiv
        (wcpa_dj_ncc_nag_monogenic wcpa_dj_ncc_nag_fin wcpa_dj_ncc_nag_poly
          wcpa_dj_ncc_nag_star _ ih)
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hB
  have hN := hpoly n
  haveI : IsNoetherianRing (MvPolynomial (Fin n) R) := hN.1
  haveI : IsNoetherianRing B := isNoetherianRing_of_surjective _ B f.toRingHom hf
  refine wcpa_dj_ncc_nag_reduced_to_domains B (fun p hp => ?_)
  haveI : p.IsPrime := hp.1.1
  letI : Algebra (MvPolynomial (Fin n) R) (B ⧸ p) :=
    ((Ideal.Quotient.mk p).comp f.toRingHom).toAlgebra
  have h2 : wcpaDjNccN2 (B ⧸ p) :=
    hN.2 (B ⧸ p) (Ideal.Quotient.mk_surjective.comp hf)
  exact h2 (FractionRing (B ⧸ p)) (Module.Finite.self _)

theorem wcpa_dj_ncce_gring_fg_fibres : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ (B : Type u) [CommRing B] [Algebra R B], Algebra.FiniteType R B → ∀ (𝔪 : Ideal B) [𝔪.IsPrime] (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L], (∃ s : Finset L, IntermediateField.adjoin 𝔭.ResidueField (s : Set L) = ⊤) → ∀ (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro R _ _ _ hR B _ _ hB
  haveI hRloc : IsLocalRing R := IsDiscreteValuationRing.toIsLocalRing
  haveI hRpid : IsPrincipalIdealRing R := IsDiscreteValuationRing.toIsPrincipalIdealRing
  haveI hRnoeth : IsNoetherianRing R := PrincipalIdealRing.isNoetherianRing
  have asc := wc_hnas_pfc_regular_flat_ascent.{u}
  have desc := wc_hnas_pfc_regular_flat_descent.{u}
  have loc := wc_hnas_pfc_regular_localization.{u}
  have sbc := wc_hnas_pfc_completion_surj_base_change.{u}
  have hCL := wc_hnas_pfc_gring_complete_local.{u} asc desc loc sbc
  have hPCF := wc_hnas_pfc_poly_complete_fibres.{u} asc desc loc sbc
  have hpoly : ∀ n : ℕ, (IsNoetherianRing (MvPolynomial (Fin n) R) ∧ ∀ (𝔪 : Ideal (MvPolynomial (Fin n) R)) [𝔪.IsPrime], ∀ (Λ : Type u) [CommRing Λ] [Algebra (Localization.AtPrime 𝔪) Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪) ≃ₐ[Localization.AtPrime 𝔪] Λ) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra (Localization.AtPrime 𝔪) L] [Algebra 𝔭.ResidueField L] [IsScalarTower (Localization.AtPrime 𝔪) 𝔭.ResidueField L] [FiniteDimensional 𝔭.ResidueField L] (𝔔 : Ideal (TensorProduct (Localization.AtPrime 𝔪) L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) := by
    intro n
    induction n with
    | zero =>
      exact wc_hnas_pfc_gring_of_surjective.{u} sbc R (MvPolynomial (Fin 0) R) MvPolynomial.C
        (MvPolynomial.C_surjective _) (hCL R hR)
    | succ n ih =>
      exact wc_hnas_pfc_gring_of_surjective.{u} sbc _ _
        (MvPolynomial.finSuccEquiv R n).symm.toRingEquiv.toRingHom
        (MvPolynomial.finSuccEquiv R n).symm.surjective
        (wc_hnas_pfc_gring_polynomial.{u} asc desc loc sbc hCL hPCF _ ih)
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hB
  have hGB := wc_hnas_pfc_gring_of_surjective.{u} sbc _ B f.toRingHom hf (hpoly n)
  intro 𝔪 _ Λ _ _ hΛ 𝔭 _ L _ _ _ _ hs 𝔔 _
  haveI : IsNoetherianRing B := hGB.1
  haveI : IsNoetherianRing (Localization.AtPrime 𝔪) :=
    IsLocalization.isNoetherianRing 𝔪.primeCompl _ hGB.1
  exact wc_hnas_pfc_fibre_fg_upgrade.{u} asc desc loc (Localization.AtPrime 𝔪) (hGB.2 𝔪) Λ hΛ
    𝔭 L hs 𝔔

theorem wcpa_dj_ncce_fibre_regular : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], (∀ (Λ : Type u) [CommRing Λ] [Algebra A Λ], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃ₐ[A] Λ) → ∀ (𝔭 : Ideal A) [𝔭.IsPrime] (L : Type u) [Field L] [Algebra A L] [Algebra 𝔭.ResidueField L] [IsScalarTower A 𝔭.ResidueField L], (∃ s : Finset L, IntermediateField.adjoin 𝔭.ResidueField (s : Set L) = ⊤) → ∀ (𝔔 : Ideal (TensorProduct A L Λ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → ∀ (C : Type u) [CommRing C] [Algebra A C], Algebra.FiniteType A C → ∀ (D : Type u) [CommRing D] [Algebra (AdicCompletion (IsLocalRing.maximalIdeal A) A) D] [Algebra C D] [Algebra A D] [IsScalarTower A (AdicCompletion (IsLocalRing.maximalIdeal A) A) D] [IsScalarTower A C D], Algebra.IsPushout A (AdicCompletion (IsLocalRing.maximalIdeal A) A) C D → ∀ (𝔮 : Ideal C) [𝔮.IsPrime] (𝔔 : Ideal (𝔮.Fiber D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) :=
by
  intro A _ _ _ H C _ _ hC D _ _ _ _ _ _ h 𝔮 _ 𝔔 _
  classical
  let 𝔭 : Ideal A := 𝔮.comap (algebraMap A C)
  haveI : 𝔭.IsPrime := Ideal.comap_isPrime _ _
  letI : Algebra 𝔭.ResidueField 𝔮.ResidueField :=
    (Ideal.ResidueField.map 𝔭 𝔮 (algebraMap A C) rfl).toAlgebra
  haveI : IsScalarTower A 𝔭.ResidueField 𝔮.ResidueField := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    ext a
    rw [RingHom.comp_apply, RingHom.algebraMap_toAlgebra, Ideal.ResidueField.map_algebraMap,
      IsScalarTower.algebraMap_apply A C 𝔮.ResidueField]
  have hfg : ∃ s : Finset 𝔮.ResidueField,
      IntermediateField.adjoin 𝔭.ResidueField (s : Set 𝔮.ResidueField) = ⊤ := by
    obtain ⟨t, ht⟩ := hC.out
    refine ⟨t.image (algebraMap C 𝔮.ResidueField), ?_⟩
    have hc : ∀ c : C, algebraMap C 𝔮.ResidueField c ∈ IntermediateField.adjoin 𝔭.ResidueField
        (((t.image (algebraMap C 𝔮.ResidueField)) : Finset _) : Set 𝔮.ResidueField) := by
      intro c
      have hc' : c ∈ Algebra.adjoin A (t : Set C) := by rw [ht]; trivial
      induction hc' using Algebra.adjoin_induction with
      | mem x hx =>
        apply IntermediateField.subset_adjoin
        rw [Finset.coe_image]
        exact Set.mem_image_of_mem _ hx
      | algebraMap r =>
        rw [← IsScalarTower.algebraMap_apply A C, IsScalarTower.algebraMap_apply A 𝔭.ResidueField]
        exact IntermediateField.algebraMap_mem _ _
      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
    rw [eq_top_iff]
    intro z _
    obtain ⟨x, y, _, rfl⟩ := IsFractionRing.div_surjective (A := C ⧸ 𝔮) z
    obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨d, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [← Ideal.Quotient.algebraMap_eq, ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply]
    exact div_mem (hc c) (hc d)
  haveI := h.symm
  let e : 𝔮.Fiber D ≃+* TensorProduct A 𝔮.ResidueField
      (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
    ((Algebra.TensorProduct.congr (AlgEquiv.refl : 𝔮.ResidueField ≃ₐ[𝔮.ResidueField] 𝔮.ResidueField)
      (Algebra.IsPushout.equiv A C (AdicCompletion (IsLocalRing.maximalIdeal A) A) D).symm).trans
      (Algebra.TensorProduct.cancelBaseChange A C 𝔮.ResidueField 𝔮.ResidueField
        (AdicCompletion (IsLocalRing.maximalIdeal A) A))).toRingEquiv
  let 𝔔' : Ideal (TensorProduct A 𝔮.ResidueField (AdicCompletion (IsLocalRing.maximalIdeal A) A)) :=
    Ideal.comap e.symm 𝔔
  haveI : 𝔔'.IsPrime := Ideal.comap_isPrime _ _
  have hreg := H (AdicCompletion (IsLocalRing.maximalIdeal A) A) ⟨AlgEquiv.refl⟩ 𝔭
    𝔮.ResidueField hfg 𝔔'
  have hM : Submonoid.map e.symm.toMonoidHom 𝔔'.primeCompl = 𝔔.primeCompl := by
    ext y
    rw [Submonoid.mem_map]
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact hx
    · intro hy
      refine ⟨e y, ?_, ?_⟩
      · show e.symm (e y) ∉ 𝔔
        rw [RingEquiv.symm_apply_apply]
        exact hy
      · show e.symm (e y) = y
        exact RingEquiv.symm_apply_apply e y
  haveI := hreg
  let φ : Localization.AtPrime 𝔔' ≃+* Localization.AtPrime 𝔔 :=
    IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime 𝔔') (Localization.AtPrime 𝔔)
      e.symm hM
  exact IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime 𝔔') φ

theorem wcpa_dj_ncce_flat_serre_ascent : ∀ (C D : Type u) [CommRing C] [CommRing D] [Algebra C D] [IsNoetherianRing C] [IsNoetherianRing D] [Module.Flat C D], (∀ (𝔮 : Ideal C) [𝔮.IsPrime], IsDomain (Localization.AtPrime 𝔮) ∧ IsIntegrallyClosed (Localization.AtPrime 𝔮)) → (∀ (𝔮 : Ideal C) [𝔮.IsPrime] (𝔔 : Ideal (𝔮.Fiber D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → wcpaDjNcceSerre D :=
by
  intro C D _ _ _ _ _ _ hCn hfib

  have s4 : ∀ (V : Type u) [CommRing V] [IsLocalRing V] [IsNoetherianRing V] [IsDomain V]
      [IsIntegrallyClosed V], (IsLocalRing.maximalIdeal V).height ≤ 1 → IsRegularLocalRing V := by
    intro V _ _ _ _ _ hle
    rw [isRegularLocalRing_iff]
    have hfg : (IsLocalRing.maximalIdeal V).FG := IsNoetherian.noetherian _
    by_cases hf : IsField V
    · have hbot : IsLocalRing.maximalIdeal V = ⊥ :=
        (IsLocalRing.isField_iff_maximalIdeal_eq).mp hf
      have h0 : (IsLocalRing.maximalIdeal V).spanFinrank = 0 :=
        (Submodule.spanFinrank_eq_zero_iff_eq_bot hfg).mpr hbot
      rw [h0, ringKrullDim_eq_zero_of_isField hf]
      rfl
    · have hdim : ringKrullDim V = 1 := by
        rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim]
        have hn0 : ¬ ringKrullDim V ≤ 0 := by
          intro h0
          haveI : Ring.KrullDimLE 0 V := Ring.krullDimLE_iff.mpr (by exact_mod_cast h0)
          exact hf (Ring.KrullDimLE.isField_of_isDomain)
        rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim] at hn0
        generalize (IsLocalRing.maximalIdeal V).height = h at hle hn0 ⊢
        cases h with
        | top => exact absurd hle (by simp)
        | coe n =>
          have h1 : n ≤ 1 := by exact_mod_cast hle
          have h2 : ¬ n ≤ 0 := fun h => hn0 (by exact_mod_cast h)
          have : n = 1 := by omega
          subst this
          rfl
      have hm0 : IsLocalRing.maximalIdeal V ≠ ⊥ := fun h =>
        hf ((IsLocalRing.isField_iff_maximalIdeal_eq).mpr h)
      have huniq : ∃! P : Ideal V, P ≠ ⊥ ∧ P.IsPrime := by
        refine ⟨IsLocalRing.maximalIdeal V, ⟨hm0, inferInstance⟩, ?_⟩
        rintro P ⟨hP0, hPp⟩
        by_contra hne
        have hlt : P < IsLocalRing.maximalIdeal V :=
          lt_of_le_of_ne (IsLocalRing.le_maximalIdeal hPp.ne_top) hne
        have hmh : (IsLocalRing.maximalIdeal V).height = 1 := by
          have := hdim
          rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim] at this
          exact_mod_cast this
        have hPh : P.height < 1 := by
          have := (Ideal.height_le_iff (p := IsLocalRing.maximalIdeal V) (n := 1)).mp hmh.le P
            hPp hlt
          exact this
        have hP0' : P.height ≤ 0 := by
          generalize P.height = k at hPh ⊢
          cases k with
          | top => simp at hPh
          | coe n =>
            have : n < 1 := by exact_mod_cast hPh
            have : n = 0 := by omega
            subst this; rfl
        have hbotlt : (⊥ : Ideal V) < P := bot_lt_iff_ne_bot.mpr hP0
        have := (Ideal.height_le_iff (p := P) (n := 0)).mp hP0' ⊥ Ideal.isPrime_bot hbotlt
        exact absurd this (by simp)
      have hpr : Submodule.IsPrincipal (IsLocalRing.maximalIdeal V) :=
        ((IsDiscreteValuationRing.TFAE V hf).out 4 5).mp
          (⟨inferInstance, huniq⟩ : IsIntegrallyClosed V ∧ ∃! P : Ideal V, P ≠ ⊥ ∧ P.IsPrime)
      obtain ⟨g, hg⟩ := hpr.principal
      have hle1 : (IsLocalRing.maximalIdeal V).spanFinrank ≤ 1 := by
        rw [hg]
        have := Submodule.spanFinrank_span_le_ncard_of_finite (R := V) (Set.finite_singleton g)
        rwa [Set.ncard_singleton] at this
      have hne0 : (IsLocalRing.maximalIdeal V).spanFinrank ≠ 0 := fun h =>
        hm0 ((Submodule.spanFinrank_eq_zero_iff_eq_bot hfg).mp h)
      have : (IsLocalRing.maximalIdeal V).spanFinrank = 1 := by omega
      rw [this, hdim]
      rfl

  have s5 : ∀ (A B : Type u) [CommRing A] [CommRing B] (φ : A →+* B), φ.Flat → ∀ a b : A,
      (∀ y : A, a * y = 0 → y = 0) → (∀ y z : A, b * y = a * z → ∃ w, y = a * w) →
      (∀ y : B, φ a * y = 0 → y = 0) ∧ ∀ y z : B, φ b * y = φ a * z → ∃ w, y = φ a * w := by
    intro A B _ _ φ hφ a b ha hb
    letI := φ.toAlgebra
    haveI : Module.Flat A B := hφ
    have hwr : RingTheory.Sequence.IsWeaklyRegular A [a, b] := by
      rw [RingTheory.Sequence.isWeaklyRegular_cons_iff,
        RingTheory.Sequence.isWeaklyRegular_singleton_iff]
      refine ⟨?_, ?_⟩
      · rw [isSMulRegular_iff_right_eq_zero_of_smul]
        intro y hy
        exact ha y hy
      · rw [isSMulRegular_iff_right_eq_zero_of_smul]
        intro ybar hy
        obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ ybar
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hy
        obtain ⟨z, -, hz⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hy
        obtain ⟨w, hw⟩ := hb y z (by rw [← smul_eq_mul, ← hz, smul_eq_mul])
        rw [Submodule.Quotient.mk_eq_zero, hw]
        exact (Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr ⟨w, Submodule.mem_top, rfl⟩
    have hwr' := RingTheory.Sequence.IsWeaklyRegular.of_flat (S := B) hwr
    simp only [List.map_cons, List.map_nil] at hwr'
    rw [RingTheory.Sequence.isWeaklyRegular_cons_iff,
      RingTheory.Sequence.isWeaklyRegular_singleton_iff] at hwr'
    obtain ⟨h1, h2⟩ := hwr'
    rw [isSMulRegular_iff_right_eq_zero_of_smul] at h1 h2
    refine ⟨fun y hy => h1 y hy, fun y z hyz => ?_⟩
    have hm : (Submodule.Quotient.mk y : QuotSMulTop (algebraMap A B a) B) = 0 := by
      apply h2
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
      refine (Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr ⟨z, Submodule.mem_top, ?_⟩
      rw [smul_eq_mul, smul_eq_mul]
      exact hyz.symm
    rw [Submodule.Quotient.mk_eq_zero] at hm
    obtain ⟨w, -, hw⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hm
    exact ⟨w, hw.symm⟩

  have s3 : ∀ (𝔮 : Ideal C) [𝔮.IsPrime] (P : Ideal D) [P.IsPrime]
      (h : 𝔮 = P.comap (algebraMap C D)),
      IsRegularLocalRing (Localization.AtPrime P ⧸ Ideal.map
        (Localization.localRingHom 𝔮 P (algebraMap C D) h)
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮))) := by
    intro 𝔮 _ P _ h
    obtain ⟨x, hx⟩ : ∃ x : PrimeSpectrum (𝔮.Fiber D),
        Ideal.comap Algebra.TensorProduct.includeRight x.asIdeal = P := by
      have hq : PrimeSpectrum.comap (algebraMap C D) ⟨P, ‹_›⟩ = ⟨𝔮, ‹_›⟩ :=
        PrimeSpectrum.ext h.symm
      refine ⟨PrimeSpectrum.preimageEquivFiber C D ⟨𝔮, ‹_›⟩ ⟨⟨P, ‹_›⟩, hq⟩, ?_⟩
      have := congrArg (fun z => z.1.asIdeal)
        ((PrimeSpectrum.preimageEquivFiber C D ⟨𝔮, ‹_›⟩).symm_apply_apply ⟨⟨P, ‹_›⟩, hq⟩)
      exact this
    subst hx
    haveI : x.asIdeal.IsPrime := x.isPrime
    letI : Algebra (Localization.AtPrime 𝔮)
        (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight x.asIdeal)) :=
      (Localization.localRingHom 𝔮 _ (algebraMap C D) h).toAlgebra
    have htow : ∀ c : C, algebraMap C
        (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight x.asIdeal)) c =
        Localization.localRingHom 𝔮 _ (algebraMap C D) h (algebraMap C (Localization.AtPrime 𝔮) c) := by
      intro c
      rw [Localization.localRingHom_to_map, IsScalarTower.algebraMap_apply C D]
    haveI : IsScalarTower C (Localization.AtPrime 𝔮)
        (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight x.asIdeal)) :=
      IsScalarTower.of_algebraMap_eq (fun c => by rw [htow]; rfl)
    haveI := hfib 𝔮 x.asIdeal
    haveI hreg : IsRegularLocalRing
        (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight x.asIdeal) ⧸
          Ideal.map (algebraMap C
            (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight x.asIdeal))) 𝔮) := by
      have e := (Ideal.Fiber.localizationAlgEquivQuotient 𝔮 x.asIdeal).toRingEquiv
      exact IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime x.asIdeal) e
    have heq : Ideal.map (algebraMap C
            (Localization.AtPrime (Ideal.comap Algebra.TensorProduct.includeRight x.asIdeal))) 𝔮 =
        Ideal.map (Localization.localRingHom 𝔮 _ (algebraMap C D) h)
          (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)) := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal 𝔮 (Localization.AtPrime 𝔮), Ideal.map_map]
      congr 1
      ext c
      exact htow c
    exact IsRegularLocalRing.of_ringEquiv (Ideal.quotEquivOfEq heq)

  intro P _
  set 𝔮 := P.comap (algebraMap C D) with h𝔮
  haveI : IsNoetherianRing (Localization.AtPrime 𝔮) :=
    IsLocalization.isNoetherianRing 𝔮.primeCompl _ inferInstance
  haveI : IsNoetherianRing (Localization.AtPrime P) :=
    IsLocalization.isNoetherianRing P.primeCompl _ inferInstance
  obtain ⟨hdom, hic⟩ := hCn 𝔮
  haveI := hdom
  haveI := hic
  set φ := Localization.localRingHom 𝔮 P (algebraMap C D) rfl with hφ
  haveI hφloc : IsLocalHom φ := Localization.isLocalHom_localRingHom 𝔮 P (algebraMap C D) rfl
  have hφflat : φ.Flat :=
    RingHom.Flat.localRingHom (RingHom.flat_algebraMap_iff.mpr inferInstance) P 𝔮 rfl
  have s1 : 𝔮.height ≤ P.height := by
    rw [Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown 𝔮 P]
    exact le_self_add
  have hhtC : (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮)).height = 𝔮.height := by
    have := (IsLocalRing.maximalIdeal_height_eq_ringKrullDim
      (R := Localization.AtPrime 𝔮)).trans
      (IsLocalization.AtPrime.ringKrullDim_eq_height 𝔮 (Localization.AtPrime 𝔮))
    exact_mod_cast this
  have hhtD : (IsLocalRing.maximalIdeal (Localization.AtPrime P)).height = P.height := by
    have := (IsLocalRing.maximalIdeal_height_eq_ringKrullDim
      (R := Localization.AtPrime P)).trans
      (IsLocalization.AtPrime.ringKrullDim_eq_height P (Localization.AtPrime P))
    exact_mod_cast this
  have s9 : 𝔮.height ≤ 1 → IsRegularLocalRing (Localization.AtPrime P) := by
    intro hq1
    haveI : IsRegularLocalRing (Localization.AtPrime 𝔮) := s4 _ (by rw [hhtC]; exact hq1)
    letI : Algebra (Localization.AtPrime 𝔮) (Localization.AtPrime P) := φ.toAlgebra
    haveI : IsLocalHom (algebraMap (Localization.AtPrime 𝔮) (Localization.AtPrime P)) := hφloc
    haveI : Module.Flat (Localization.AtPrime 𝔮) (Localization.AtPrime P) := hφflat
    exact wc_hnas_pfc_regular_flat_ascent _ _ inferInstance (s3 𝔮 P rfl)
  refine ⟨fun hP1 => s9 (s1.trans hP1), fun hP2 => ?_⟩
  by_cases hq1 : 𝔮.height ≤ 1
  · haveI := s9 hq1
    obtain ⟨hd, hu⟩ := wc_fco_regular_local_ufd (Localization.AtPrime P)
    haveI := hd
    haveI := hu
    obtain ⟨a, ha, b, hb, ha0, -, hab⟩ :=
      wc_cg2_normal_depth_two (Localization.AtPrime P) (by rw [hhtD]; exact hP2)
    exact ⟨a, ha, b, hb, fun y hy => (mul_eq_zero.mp hy).resolve_left ha0, hab⟩
  · have hq2 : 2 ≤ 𝔮.height := by
      revert hq1
      generalize 𝔮.height = k
      cases k with
      | top => intro _; exact le_top
      | coe n =>
        intro h
        have : ¬ n ≤ 1 := fun h' => h (by exact_mod_cast h')
        have : 2 ≤ n := by omega
        exact_mod_cast this
    obtain ⟨a, ha, b, hb, ha0, -, hab⟩ :=
      wc_cg2_normal_depth_two (Localization.AtPrime 𝔮) (by rw [hhtC]; exact hq2)
    obtain ⟨h1, h2⟩ := s5 _ _ φ hφflat a b
      (fun y hy => (mul_eq_zero.mp hy).resolve_left ha0) hab
    exact ⟨φ a, map_nonunit φ a ha, φ b, map_nonunit φ b hb, h1, h2⟩

theorem wcpa_dj_ncce_serre_localize : ∀ (T : Type u) [CommRing T] [IsNoetherianRing T], wcpaDjNcceSerre T → ∀ (Q : Ideal T) [Q.IsPrime], wcpaDjNcceSerre (Localization.AtPrime Q) :=
by
  intro T _ _ hT Q _
  intro P' _
  haveI hPp : (Ideal.comap (algebraMap T (Localization.AtPrime Q)) P').IsPrime :=
    Ideal.IsPrime.comap _
  obtain ⟨hR1, hS2⟩ := hT (Ideal.comap (algebraMap T (Localization.AtPrime Q)) P')
  have hh : (Ideal.comap (algebraMap T (Localization.AtPrime Q)) P').height = P'.height :=
    IsLocalization.height_under Q.primeCompl P'
  let e : Localization.AtPrime (Ideal.comap (algebraMap T (Localization.AtPrime Q)) P') ≃+*
      Localization.AtPrime P' :=
    (IsLocalization.localizationLocalizationAtPrimeIsoLocalization Q.primeCompl P').toRingEquiv
  have hmem : ∀ x, x ∈ IsLocalRing.maximalIdeal
      (Localization.AtPrime (Ideal.comap (algebraMap T (Localization.AtPrime Q)) P')) →
      e x ∈ IsLocalRing.maximalIdeal (Localization.AtPrime P') := by
    intro x hx
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    exact fun hu => hx ((MulEquiv.isUnit_map e.toMulEquiv).mp hu)
  constructor
  · intro h1
    haveI := hR1 (by rw [hh]; exact h1)
    exact IsRegularLocalRing.of_ringEquiv e
  · intro h2
    obtain ⟨a, ha, b, hb, hreg, hquo⟩ := hS2 (by rw [hh]; exact h2)
    refine ⟨e a, hmem a ha, e b, hmem b hb, ?_, ?_⟩
    · intro y hy
      have h3 : a * e.symm y = 0 := by
        apply e.injective
        rw [map_mul, RingEquiv.apply_symm_apply, hy, map_zero]
      have h0 := hreg _ h3
      rw [← RingEquiv.apply_symm_apply e y, h0, map_zero]
    · intro y z hyz
      have h3 : b * e.symm y = a * e.symm z := by
        apply e.injective
        rw [map_mul, map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply, hyz]
      obtain ⟨w, hw⟩ := hquo _ _ h3
      refine ⟨e w, ?_⟩
      rw [← RingEquiv.apply_symm_apply e y, hw, map_mul]

theorem wcpa_dj_ncce_serre_local_normal : ∀ (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S], wcpaDjNcceSerre S → IsDomain S ∧ IsIntegrallyClosed S :=
by
  intro S _ _ _ hS
  classical

  have s1 : ∀ (I : Ideal S) (x : S), x ∉ I → ∃ (P : Ideal S) (_ : P.IsPrime) (y : S),
      (∀ s : S, s * x ∈ I → s ∈ P) ∧ (∀ r : S, r ∈ P ↔ r * y ∈ I) ∧
      algebraMap S (Localization.AtPrime P) y ∉ I.map (algebraMap S (Localization.AtPrime P)) ∧
      ∀ m ∈ IsLocalRing.maximalIdeal (Localization.AtPrime P),
        m * algebraMap S (Localization.AtPrime P) y ∈
          I.map (algebraMap S (Localization.AtPrime P)) := by
    intro I x hx
    have hx' : (Submodule.Quotient.mk x : S ⧸ I) ≠ 0 := by
      rwa [Ne, Submodule.Quotient.mk_eq_zero]
    obtain ⟨P, hP, hle⟩ := exists_le_isAssociatedPrime_of_isNoetherianRing S _ hx'
    obtain ⟨hPp, ybar, hPy⟩ := isAssociatedPrime_iff.mp hP
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ ybar
    have hmem : ∀ r : S, r ∈ P ↔ r * y ∈ I := by
      intro r
      rw [hPy, Submodule.mem_colon_singleton, Submodule.mem_bot, ← Submodule.Quotient.mk_smul,
        smul_eq_mul, Submodule.Quotient.mk_eq_zero]
    refine ⟨P, hPp, y, ?_, hmem, ?_, ?_⟩
    · intro s hs
      apply hle
      rw [Submodule.mem_colon_singleton, Submodule.mem_bot, ← Submodule.Quotient.mk_smul,
        smul_eq_mul, Submodule.Quotient.mk_eq_zero]
      exact hs
    · intro h
      obtain ⟨m, hm, hmy⟩ :=
        (IsLocalization.algebraMap_mem_map_algebraMap_iff P.primeCompl _ I y).mp h
      exact hm ((hmem m).mpr hmy)
    · intro m hm
      obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl m
      have hr : r ∈ P := (IsLocalization.AtPrime.mk'_mem_maximal_iff _ P r s).mp hm
      rw [mul_comm, IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.mk'_mem_map_algebraMap_iff]
      exact ⟨1, P.primeCompl.one_mem, by rw [one_mul, mul_comm]; exact (hmem r).mp hr⟩

  have two_le : ∀ (P : Ideal S), ¬ P.height ≤ 1 → 2 ≤ P.height := by
    intro P h
    have h1 : 1 < P.height := lt_of_not_ge h
    have := Order.add_one_le_of_lt h1
    simpa [one_add_one_eq_two] using this

  have hred : IsReduced S := by
    refine ⟨fun x hx => ?_⟩
    by_contra hx0
    obtain ⟨P, hPp, y, h1, -, h3, h4⟩ := s1 ⊥ x (by simpa using hx0)
    simp only [Ideal.map_bot, Ideal.mem_bot] at h3 h4
    by_cases hle : P.height ≤ 1
    · haveI := (hS P).1 hle
      haveI := (wc_fco_regular_local_ufd (Localization.AtPrime P)).1
      have h0 : algebraMap S (Localization.AtPrime P) x = 0 := (hx.map _).eq_zero
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff P.primeCompl _ x).mp h0
      exact m.2 (h1 m (by rw [hm]; exact Ideal.zero_mem _))
    · obtain ⟨a, ha, b, hb, hreg, -⟩ := (hS P).2 (two_le P hle)
      exact h3 (hreg _ (h4 a ha))

  have unmixed : ∀ (f a : S), f ∈ nonZeroDivisors S →
      (∀ (P : Ideal S) [P.IsPrime], P.height ≤ 1 → algebraMap S (Localization.AtPrime P) a ∈
        (Ideal.span {f}).map (algebraMap S (Localization.AtPrime P))) → a ∈ Ideal.span {f} := by
    intro f a hf hloc
    by_contra ha
    obtain ⟨P, hPp, y, h1, -, h3, h4⟩ := s1 (Ideal.span {f}) a ha
    by_cases hle : P.height ≤ 1
    · obtain ⟨m, hm, hma⟩ :=
        (IsLocalization.algebraMap_mem_map_algebraMap_iff P.primeCompl _ _ a).mp (hloc P hle)
      exact hm (h1 m hma)
    · obtain ⟨a', ha', b', hb', hreg, hreg2⟩ := (hS P).2 (two_le P hle)
      have hc : algebraMap S (Localization.AtPrime P) f ∈
          nonZeroDivisors (Localization.AtPrime P) :=
        IsLocalization.map_nonZeroDivisors_le P.primeCompl _ ⟨f, hf, rfl⟩
      have hspan : (Ideal.span {f}).map (algebraMap S (Localization.AtPrime P)) =
          Ideal.span {algebraMap S (Localization.AtPrime P) f} := by
        rw [Ideal.map_span, Set.image_singleton]
      rw [hspan] at h3 h4
      obtain ⟨y1, hy1⟩ := Ideal.mem_span_singleton'.mp (h4 a' ha')
      obtain ⟨y2, hy2⟩ := Ideal.mem_span_singleton'.mp (h4 b' hb')
      have e : b' * y1 = a' * y2 := by
        have h0 : (b' * y1 - a' * y2) * algebraMap S (Localization.AtPrime P) f = 0 := by
          calc (b' * y1 - a' * y2) * algebraMap S (Localization.AtPrime P) f
              = b' * (y1 * algebraMap S (Localization.AtPrime P) f) -
                  a' * (y2 * algebraMap S (Localization.AtPrime P) f) := by ring
            _ = b' * (a' * algebraMap S (Localization.AtPrime P) y) -
                  a' * (b' * algebraMap S (Localization.AtPrime P) y) := by rw [hy1, hy2]
            _ = 0 := by ring
        exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hc).mp h0)
      obtain ⟨w, hw⟩ := hreg2 y1 y2 e
      have hz : algebraMap S (Localization.AtPrime P) y =
          w * algebraMap S (Localization.AtPrime P) f := by
        have h0 : a' * (algebraMap S (Localization.AtPrime P) y -
            w * algebraMap S (Localization.AtPrime P) f) = 0 := by
          calc a' * (algebraMap S (Localization.AtPrime P) y -
                w * algebraMap S (Localization.AtPrime P) f)
              = a' * algebraMap S (Localization.AtPrime P) y -
                  (a' * w) * algebraMap S (Localization.AtPrime P) f := by ring
            _ = y1 * algebraMap S (Localization.AtPrime P) f -
                  y1 * algebraMap S (Localization.AtPrime P) f := by rw [← hy1, ← hw]
            _ = 0 := sub_self _
        exact sub_eq_zero.mp (hreg _ h0)
      exact h3 (Ideal.mem_span_singleton'.mpr ⟨w, hz.symm⟩)

  have lowh : ∀ (f a : S) (p : Polynomial S), f ∈ nonZeroDivisors S → p.Monic →
      (p.scaleRoots f).eval a = 0 → ∀ (P : Ideal S) [P.IsPrime], P.height ≤ 1 →
      algebraMap S (Localization.AtPrime P) a ∈
        (Ideal.span {f}).map (algebraMap S (Localization.AtPrime P)) := by
    intro f a p hf hp he P _ hle
    haveI := (hS P).1 hle
    obtain ⟨hdom, hufd⟩ := wc_fco_regular_local_ufd (Localization.AtPrime P)
    haveI := hdom
    haveI := hufd
    have hc : algebraMap S (Localization.AtPrime P) f ∈
        nonZeroDivisors (Localization.AtPrime P) :=
      IsLocalization.map_nonZeroDivisors_le P.primeCompl _ ⟨f, hf, rfl⟩
    have hc0 : algebraMap (Localization.AtPrime P) (FractionRing (Localization.AtPrime P))
        (algebraMap S (Localization.AtPrime P) f) ≠ 0 := by
      rw [Ne, map_eq_zero_iff _ (IsFractionRing.injective _ _)]
      exact nonZeroDivisors.ne_zero hc
    set ψ := algebraMap (Localization.AtPrime P) (FractionRing (Localization.AtPrime P)) with hψ
    set φ := algebraMap S (Localization.AtPrime P) with hφ
    have hξ : ψ (φ f) * (ψ (φ a) / ψ (φ f)) = ψ (φ a) := mul_div_cancel₀ _ hc0
    have hint : IsIntegral (Localization.AtPrime P) (ψ (φ a) / ψ (φ f)) := by
      refine ⟨p.map φ, hp.map φ, ?_⟩
      have key := Polynomial.scaleRoots_eval₂_mul (p := p) (ψ.comp φ) (ψ (φ a) / ψ (φ f)) f
      have e1 : (ψ.comp φ) f * (ψ (φ a) / ψ (φ f)) = (ψ.comp φ) a := hξ
      rw [e1, Polynomial.eval₂_at_apply, he, map_zero] at key
      have e2 : Polynomial.eval₂ (ψ.comp φ) (ψ (φ a) / ψ (φ f)) p = 0 := by
        have hne : (ψ.comp φ) f ^ p.natDegree ≠ 0 := pow_ne_zero _ hc0
        exact (mul_eq_zero.mp key.symm).resolve_left hne
      rw [Polynomial.eval₂_map]
      exact e2
    obtain ⟨z, hz⟩ := (IsIntegrallyClosed.isIntegral_iff
      (K := FractionRing (Localization.AtPrime P))).mp hint
    have hza : φ a = z * φ f := by
      apply IsFractionRing.injective (Localization.AtPrime P)
        (FractionRing (Localization.AtPrime P))
      rw [map_mul, ← hψ, hz]
      exact (div_mul_cancel₀ _ hc0).symm
    rw [Ideal.map_span, Set.image_singleton]
    exact Ideal.mem_span_singleton'.mpr ⟨z, hza.symm⟩

  have crit : (∀ (f a : S) (p : Polynomial S), f ∈ nonZeroDivisors S → p.Monic →
      (p.scaleRoots f).eval a = 0 → a ∈ Ideal.span {f}) → IsIntegrallyClosed S := by
    intro H
    rw [isIntegrallyClosed_iff (FractionRing S)]
    rintro x ⟨p, hp, hpx⟩
    obtain ⟨⟨a, ⟨f, hf⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors S) x
    have hfx := IsLocalization.mk'_spec' (FractionRing S) a ⟨f, hf⟩
    have key := Polynomial.scaleRoots_eval₂_mul (p := p) (algebraMap S (FractionRing S))
      (IsLocalization.mk' (FractionRing S) a ⟨f, hf⟩) f
    rw [hfx, hpx, mul_zero, Polynomial.eval₂_at_apply] at key
    have he : (p.scaleRoots f).eval a = 0 :=
      IsFractionRing.injective S (FractionRing S) (by rw [key, map_zero])
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp (H f a p hf hp he)
    refine ⟨w, ?_⟩
    rw [IsLocalization.eq_mk'_iff_mul_eq, ← map_mul]
    exact congrArg _ hw
  haveI := hred
  haveI hic : IsIntegrallyClosed S :=
    crit (fun f a p hf hp he => unmixed f a hf (lowh f a p hf hp he))

  have hdomS : IsDomain S := by
    have hMfin : (minimalPrimes S).Finite := minimalPrimes.finite_of_isNoetherianRing S
    have hsInf : sInf (minimalPrimes S) = ⊥ := by
      show sInf (⊥ : Ideal S).minimalPrimes = ⊥
      rw [Ideal.sInf_minimalPrimes]
      exact Ideal.radical_bot_of_isReduced
    have hmin : ∀ q ∈ minimalPrimes S, ∀ q' : Ideal S, q'.IsPrime → q' ≤ q → q' = q :=
      fun q hq q' hq' hle =>
        Minimal.eq_of_le (show Minimal (fun q : Ideal S => q.IsPrime ∧ ⊥ ≤ q) q from hq)
          ⟨hq', bot_le⟩ hle
    have hprime : ∀ q ∈ minimalPrimes S, q.IsPrime := fun q hq =>
      (show Minimal (fun q : Ideal S => q.IsPrime ∧ ⊥ ≤ q) q from hq).1.1
    by_cases hbot : (⊥ : Ideal S) ∈ minimalPrimes S
    · haveI : (⊥ : Ideal S).IsPrime := hprime ⊥ hbot
      exact IsDomain.of_bot_isPrime S
    exfalso
    obtain ⟨p₁, hp₁, -⟩ :=
      Ideal.exists_minimalPrimes_le (bot_le : ⊥ ≤ IsLocalRing.maximalIdeal S)
    have hp₁M : p₁ ∈ minimalPrimes S := hp₁
    have hFs : hMfin.toFinset = insert p₁ (hMfin.toFinset.erase p₁) :=
      (Finset.insert_erase (hMfin.mem_toFinset.mpr hp₁M)).symm
    have hinf : p₁ ⊓ (hMfin.toFinset.erase p₁).inf id = ⊥ := by
      have h0 : hMfin.toFinset.inf id = ⊥ := by
        rw [Finset.inf_id_eq_sInf, Set.Finite.coe_toFinset, hsInf]
      rw [hFs, Finset.inf_insert] at h0
      exact h0
    have hTne : (hMfin.toFinset.erase p₁).Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hT
      apply hbot
      rw [hT, Finset.inf_empty, inf_top_eq] at hinf
      rw [← hinf]
      exact hp₁M
    have havoid : ¬ ((p₁ ⊔ (hMfin.toFinset.erase p₁).inf id : Ideal S) : Set S) ⊆
        ⋃ i ∈ (hMfin.toFinset : Set (Ideal S)), ((id i : Ideal S) : Set S) := by
      rw [Ideal.subset_union_prime (s := hMfin.toFinset) (f := id) p₁ p₁
        (fun i hi _ _ => hprime i (hMfin.mem_toFinset.mp hi))]
      rintro ⟨q, hqFs, hq⟩
      have hqM : q ∈ minimalPrimes S := hMfin.mem_toFinset.mp hqFs
      have hpq : p₁ = q := hmin q hqM p₁ (hprime p₁ hp₁M) (le_sup_left.trans hq)
      have hJ : (hMfin.toFinset.erase p₁).inf id ≤ p₁ := by
        have := (le_sup_right : (hMfin.toFinset.erase p₁).inf id ≤ _).trans hq
        rw [← hpq] at this
        exact this
      obtain ⟨t, htT, htle⟩ := (Ideal.IsPrime.inf_le' (hprime p₁ hp₁M)).mp hJ
      have htM : t ∈ minimalPrimes S := hMfin.mem_toFinset.mp (Finset.mem_of_mem_erase htT)
      exact (Finset.ne_of_mem_erase htT) (hmin p₁ hp₁M t (hprime t htM) htle)
    rw [Set.not_subset] at havoid
    obtain ⟨f, hfJ, hfU⟩ := havoid
    obtain ⟨i, hi, j, hj, rfl⟩ := Submodule.mem_sup.mp hfJ
    have hfq : ∀ q ∈ minimalPrimes S, i + j ∉ q := fun q hq hmem =>
      hfU (Set.mem_biUnion (Finset.mem_coe.mpr (hMfin.mem_toFinset.mpr hq)) hmem)
    have hij : i * j = 0 := by
      have h0 : i * j ∈ p₁ ⊓ (hMfin.toFinset.erase p₁).inf id :=
        Submodule.mem_inf.mpr ⟨Ideal.mul_mem_right _ _ hi, Ideal.mul_mem_left _ _ hj⟩
      rw [hinf] at h0
      exact Ideal.mem_bot.mp h0
    have hfnzd : i + j ∈ nonZeroDivisors S := by
      have h : ∀ z, (i + j) * z = 0 → z = 0 := by
        intro z hz
        have hzm : z ∈ sInf (minimalPrimes S) := by
          rw [Submodule.mem_sInf]
          intro q hq
          have h0 : (i + j) * z ∈ q := by rw [hz]; exact q.zero_mem
          exact ((hprime q hq).mem_or_mem h0).resolve_left (hfq q hq)
        rw [hsInf] at hzm
        exact Ideal.mem_bot.mp hzm
      rw [mem_nonZeroDivisors_iff]
      exact ⟨h, fun z hz => h z (by rw [mul_comm]; exact hz)⟩
    have hfe : algebraMap S (FractionRing S) (i + j) *
        IsLocalization.mk' (FractionRing S) i (⟨i + j, hfnzd⟩ : nonZeroDivisors S) =
        algebraMap S (FractionRing S) i :=
      IsLocalization.mk'_spec' (FractionRing S) i _
    have hunit : IsUnit (algebraMap S (FractionRing S) (i + j)) :=
      IsLocalization.map_units (FractionRing S) (⟨i + j, hfnzd⟩ : nonZeroDivisors S)
    set e := IsLocalization.mk' (FractionRing S) i (⟨i + j, hfnzd⟩ : nonZeroDivisors S)
      with hedef
    have hee : e * e = e := by
      have h1 : algebraMap S (FractionRing S) (i + j) *
          (algebraMap S (FractionRing S) (i + j) * (e * e - e)) = 0 := by
        calc _ = (algebraMap S (FractionRing S) (i + j) * e) *
              (algebraMap S (FractionRing S) (i + j) * e) -
              algebraMap S (FractionRing S) (i + j) *
                (algebraMap S (FractionRing S) (i + j) * e) := by ring
          _ = algebraMap S (FractionRing S) (i * i - (i + j) * i) := by
              rw [hfe]; simp only [map_sub, map_mul]
          _ = 0 := by
              rw [show i * i - (i + j) * i = -(i * j) by ring, hij, neg_zero, map_zero]
      rw [hunit.mul_right_eq_zero, hunit.mul_right_eq_zero, sub_eq_zero] at h1
      exact h1
    have heint : IsIntegral S e := by
      refine ⟨Polynomial.X ^ 2 - Polynomial.X,
        Polynomial.monic_X_pow_sub (by rw [Polynomial.degree_X]; norm_num), ?_⟩
      simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X]
      rw [sq, hee, sub_self]
    obtain ⟨e₀, he₀⟩ := (IsIntegrallyClosed.isIntegral_iff (K := FractionRing S)).mp heint
    have hinj := IsFractionRing.injective S (FractionRing S)
    have he₀i : e₀ * (i + j) = i := hinj (by rw [map_mul, he₀, mul_comm]; exact hfe)
    have he₀2 : e₀ * e₀ = e₀ := hinj (by rw [map_mul, he₀, hee])
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self e₀ with hu | hu
    · have h1 : e₀ = 1 := by
        have h0 : e₀ * (e₀ - 1) = 0 := by rw [mul_sub, he₀2, mul_one, sub_self]
        rw [hu.mul_right_eq_zero, sub_eq_zero] at h0
        exact h0
      rw [h1, one_mul] at he₀i
      apply hfq p₁ hp₁M
      rw [he₀i]
      exact hi
    · have h0 : e₀ = 0 := by
        have h0 : (1 - e₀) * e₀ = 0 := by rw [sub_mul, he₀2, one_mul, sub_self]
        rwa [hu.mul_right_eq_zero] at h0
      rw [h0, zero_mul] at he₀i
      obtain ⟨t, htT⟩ := hTne
      have htM : t ∈ minimalPrimes S := hMfin.mem_toFinset.mp (Finset.mem_of_mem_erase htT)
      apply hfq t htM
      rw [← he₀i, zero_add]
      exact Finset.inf_le (f := id) htT hj
  exact ⟨hdomS, hic⟩

theorem wcpa_dj_ncc_excellent : wcpaDjNccExcellent.{u} :=
by
  intro R _ _ _ hR B _ _ hB 𝔪 _ C _ _ hC hCn D _ _ _ _ _ _ h Q _
  haveI := hB
  haveI := hC
  haveI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing R B
  haveI hAn : IsNoetherianRing (Localization.AtPrime 𝔪) :=
    IsLocalization.isNoetherianRing 𝔪.primeCompl _ inferInstance
  haveI : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing (Localization.AtPrime 𝔪) C
  have H := wcpa_dj_ncce_gring_fg_fibres R hR B hB 𝔪
  haveI : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
      (Localization.AtPrime 𝔪)) :=
    wc_hnas_completion_noetherian (Localization.AtPrime 𝔪)
  haveI := h
  haveI : Algebra.FiniteType (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
      (Localization.AtPrime 𝔪)) D :=
    Algebra.FiniteType.equiv (Algebra.FiniteType.baseChange (A := C) _)
      (Algebra.IsPushout.equiv (Localization.AtPrime 𝔪) _ C D)
  haveI : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing
    (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)) D
  haveI : Module.Flat (Localization.AtPrime 𝔪)
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
        (Localization.AtPrime 𝔪)) :=
    AdicCompletion.flat_of_isNoetherian _
  haveI : Module.Flat C D :=
    Module.Flat.isBaseChange (Localization.AtPrime 𝔪) C _ D (Algebra.IsPushout.symm h).out
  have hfib := wcpa_dj_ncce_fibre_regular (Localization.AtPrime 𝔪) H C hC D h
  have hS := wcpa_dj_ncce_flat_serre_ascent C D hCn hfib
