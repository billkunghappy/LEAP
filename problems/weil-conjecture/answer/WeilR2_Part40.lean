  exact ⟨hsubV.finite, (Set.ncard_le_one hsubV.finite).mpr (fun _ ha _ hb => hsubV ha hb),
    hsubH.finite, (Set.ncard_le_one hsubH.finite).mpr (fun _ ha _ hb => hsubH ha hb)⟩

theorem wcpa_dj_nccw_exit_bound : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → (nccwEx u ν q st zk).Finite ∧ (nccwEx u ν q st zk).ncard ≤ 2 :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA
  classical

  have s1 : nccwEx u ν q st zk ⊆
      (nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk) ∪ nccwEbExS u ν q st zk := by
    intro p hp
    have hp' := hp
    obtain ⟨⟨-, -, -, hor⟩, -, -⟩ := hp
    rcases hor with hC | ⟨y, ⟨hy1, hy2⟩, hJ⟩
    · exact Or.inl (Or.inl ⟨hp', hC.2.2.2⟩)
    · rcases hy2 with ⟨i, p₀, hp₀, rfl⟩ | hns
      · exact Or.inr ⟨hp', i, p₀, hp₀, hJ⟩
      · exact Or.inl (Or.inr ⟨hp', y, hy1, hns, hJ⟩)

  have s3 : nccwSm u (ν zk) → nccwEbExH u ν q st zk = ∅ := by
    rintro ⟨W, hzW, hW⟩
    ext p
    refine ⟨fun hp => ?_, fun hp => hp.elim⟩
    obtain ⟨⟨-, hp2, hp3⟩, y, -, hns, hJ⟩ := hp
    exfalso
    apply hns
    refine ⟨W, ?_, hW⟩
    have hy : y ⤳ p.2 := by
      rw [specializes_iff_mem_closure, ← hJ]
      exact hp2
    have h1 : ν (q y) ⤳ ν (q p.2) := (hy.map q.continuous).map ν.continuous
    have h2 : q p.2 = zk := hp3
    rw [h2] at h1
    exact h1.mem_open W.isOpen hzW

  obtain ⟨hSfin, hScard, hSempty⟩ := wcpa_dj_nccw_eb_sections R Z Z' Y G S S' N u u' n τ τ' π a a'
    h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA
  obtain ⟨f, hfV, hfH, hfinj⟩ := wcpa_dj_nccw_eb_branch_injection R Z Z' Y G S S' N u u' n τ τ' π
    a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA
  have key : ∀ T : Set (PrimeSpectrum (AdicCompletion
      (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk))), T.Finite →
      (∀ p ∈ nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk, f p ∈ T) →
      (nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk).Finite ∧
        (nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk).ncard ≤ T.ncard := by
    intro T hT hmaps
    have hfin : (nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk).Finite :=
      Set.Finite.of_finite_image (hT.subset (by rintro _ ⟨p, hp, rfl⟩; exact hmaps p hp)) hfinj
    exact ⟨hfin, Set.ncard_le_ncard_of_injOn f hmaps hfinj hT⟩
  by_cases hsm : nccwSm u (ν zk)
  · have hEH := s3 hsm
    obtain ⟨hBvfin, hBvcard⟩ := wcpa_dj_nccw_eb_count_smooth R Z Z' Y G S S' N u u' n τ τ' π a a'
      h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA hsm
    obtain ⟨hVHfin, hVHcard⟩ := key _ hBvfin (by
      rintro p (hp | hp)
      · exact hfV p hp
      · rw [hEH] at hp
        exact hp.elim)
    have hU : ((nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk) ∪
        nccwEbExS u ν q st zk).Finite := hVHfin.union hSfin
    refine ⟨hU.subset s1, ?_⟩
    have c1 := Set.ncard_le_ncard s1 hU
    have c2 := Set.ncard_union_le (nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk)
      (nccwEbExS u ν q st zk)
    omega
  · have hES := hSempty hsm
    have s1' : nccwEx u ν q st zk ⊆ nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk := by
      intro p hp
      rcases s1 hp with h' | h'
      · exact h'
      · rw [hES] at h'
        exact h'.elim
    have hT : (nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk).Finite ∧
        (nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk).ncard ≤ 2 := by
      by_cases hnorm : IsDomain (Z.presheaf.stalk (ν zk)) ∧
          IsIntegrallyClosed (Z.presheaf.stalk (ν zk))
      · obtain ⟨hd, hic⟩ := hnorm
        obtain ⟨hBh, hBvfin, hBvcard⟩ := wcpa_dj_nccw_eb_count_normal_node R Z Z' Y G S S' N u u'
          n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA hsm hd hic
        obtain ⟨h1, h2⟩ := key _ hBvfin (by
          rintro p (hp | hp)
          · exact hfV p hp
          · have h3 := hfH p hp
            rw [hBh] at h3
            exact h3.elim)
        exact ⟨h1, by omega⟩
      · obtain ⟨hBvfin, hBvcard, hBhfin, hBhcard⟩ := wcpa_dj_nccw_eb_count_nonnormal_node R Z Z'
          Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA hsm hnorm
        obtain ⟨h1, h2⟩ := key _ (hBvfin.union hBhfin) (by
          rintro p (hp | hp)
          · exact Or.inl (hfV p hp)
          · exact Or.inr (hfH p hp))
        have h3 := Set.ncard_union_le (nccwEbBv R u ν zk) (nccwEbBh R u ν zk)
        exact ⟨h1, by omega⟩
    exact ⟨hT.1.subset s1', (Set.ncard_le_ncard s1' hT.1).trans hT.2⟩

theorem nccwff_zk_closed : ∀ (S Z : Scheme.{u}) (ν : S ⟶ Z) (zk : S), IsFinite ν →
    IsClosed ({ν zk} : Set Z) → IsClosed ({zk} : Set S) :=
by
  intro S Z ν zk hfin hcl
  haveI := hfin
  have hF : IsClosed (⇑ν ⁻¹' {ν zk}) := hcl.preimage ν.continuous
  haveI : DiscreteTopology ↑(⇑ν ⁻¹' {ν zk}) := (ν.fiberHomeo (ν zk)).discreteTopology
  have h := hF.isClosedMap_subtype_val {(⟨zk, rfl⟩ : ↑(⇑ν ⁻¹' {ν zk}))} (isClosed_discrete _)
  simpa [Set.image_singleton] using h

theorem nccwff_node_ring_props : ∀ (R : Type u) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R →
    ∀ c : R, c ≠ 0 → c ∈ IsLocalRing.maximalIdeal R →
    ∃ (_ : IsLocalRing (nccwffQ R c)),
      IsAdicComplete (IsLocalRing.maximalIdeal (nccwffQ R c)) (nccwffQ R c) ∧
      ringKrullDim (nccwffQ R c) = 2 ∧ Function.Injective (nccwffPsi R c) ∧
      ∃ ρ : IsLocalRing.ResidueField R ≃+* IsLocalRing.ResidueField (nccwffQ R c),
        ρ.toRingHom.comp (IsLocalRing.residue R) =
          (IsLocalRing.residue (nccwffQ R c)).comp (nccwffPsi R c) :=
by
  intro R _ _ _ hcomp c _hc0 hcm
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hm : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} := hϖ.maximalIdeal_eq

  have hsm : ∀ {B : Type u} [CommRing B] (K : Ideal B) (n : ℕ) (x y : B),
      x ≡ y [SMOD K ^ n • (⊤ : Submodule B B)] ↔ x - y ∈ K ^ n := by
    intro B _ K n x y
    rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]


  have hX : ∀ (i : Fin 2) (g : MvPowerSeries (Fin 2) R) (e : Fin 2 →₀ ℕ),
      MvPowerSeries.coeff e (MvPowerSeries.X i * g) =
        if 1 ≤ e i then MvPowerSeries.coeff (e - Finsupp.single i 1) g else 0 := by
    intro i g e
    rw [MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul, one_mul]
    by_cases h : 1 ≤ e i
    · rw [if_pos (Finsupp.single_le_iff.mpr h), if_pos h]
    · rw [if_neg (fun h' => h (Finsupp.single_le_iff.mp h')), if_neg h]
  have hsub : ∀ (e : Fin 2 →₀ ℕ) (i k : Fin 2),
      (e - Finsupp.single i 1 : Fin 2 →₀ ℕ) k = e k - (if i = k then 1 else 0) := by
    intro e i k
    rw [Finsupp.tsub_apply, Finsupp.single_apply]
  have hadd : ∀ (e : Fin 2 →₀ ℕ) (i k : Fin 2),
      (e + Finsupp.single i 1 : Fin 2 →₀ ℕ) k = e k + (if i = k then 1 else 0) := by
    intro e i k
    rw [Finsupp.add_apply, Finsupp.single_apply]
  have hext : ∀ e e' : Fin 2 →₀ ℕ, e 0 = e' 0 → e 1 = e' 1 → e = e' := by
    intro e e' h0 h1
    ext k
    fin_cases k
    · exact h0
    · exact h1
  have h01 : (0 : Fin 2) ≠ 1 := by decide
  have h10 : (1 : Fin 2) ≠ 0 := by decide
  have hsumsub : ∀ (i : Fin 2) (e : Fin 2 →₀ ℕ), 1 ≤ e i →
      (e - Finsupp.single i 1 : Fin 2 →₀ ℕ) 0 + (e - Finsupp.single i 1 : Fin 2 →₀ ℕ) 1 =
        e 0 + e 1 - 1 := by
    rw [Fin.forall_fin_two]
    constructor
    · intro e he
      rw [hsub, hsub]
      simp only [if_true, h01, if_false]
      omega
    · intro e he
      rw [hsub, hsub]
      simp only [if_true, h10, if_false]
      omega

  have hD : ∀ φ : MvPowerSeries (Fin 2) R, ∃ g₀ g₁ : MvPowerSeries (Fin 2) R,
      φ = MvPowerSeries.C (MvPowerSeries.constantCoeff φ) + MvPowerSeries.X 0 * g₀ +
        MvPowerSeries.X 1 * g₁ ∧
      (∀ e, MvPowerSeries.coeff e g₀ = MvPowerSeries.coeff (e + Finsupp.single 0 1) φ) ∧
      (∀ e, MvPowerSeries.coeff e g₁ =
        if e 0 = 0 then MvPowerSeries.coeff (e + Finsupp.single 1 1) φ else 0) := by
    intro φ
    obtain ⟨g₀, hg₀⟩ : ∃ g₀ : MvPowerSeries (Fin 2) R,
        ∀ e, MvPowerSeries.coeff e g₀ = MvPowerSeries.coeff (e + Finsupp.single 0 1) φ :=
      ⟨fun e => MvPowerSeries.coeff (e + Finsupp.single 0 1) φ, fun e => rfl⟩
    obtain ⟨g₁, hg₁⟩ : ∃ g₁ : MvPowerSeries (Fin 2) R, ∀ e, MvPowerSeries.coeff e g₁ =
        if e 0 = 0 then MvPowerSeries.coeff (e + Finsupp.single 1 1) φ else 0 :=
      ⟨fun e => if e 0 = 0 then MvPowerSeries.coeff (e + Finsupp.single 1 1) φ else 0,
        fun e => rfl⟩
    refine ⟨g₀, g₁, ?_, hg₀, hg₁⟩
    ext e
    rw [map_add, map_add, MvPowerSeries.coeff_C, hX, hX, hg₀, hg₁]
    rw [hsub e 1 0, if_neg h10, Nat.sub_zero]
    by_cases h0 : e 0 = 0
    · by_cases h1 : e 1 = 0
      · have he : e = 0 := hext _ _ (by simp [h0]) (by simp [h1])
        subst he
        simp [MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
      · have he : e ≠ 0 := fun h => h1 (by rw [h]; rfl)
        have e1 : e - Finsupp.single 1 1 + Finsupp.single 1 1 = e :=
          hext _ _ (by rw [hadd, hsub]; simp [h10]) (by rw [hadd, hsub]; simp; omega)
        rw [if_neg he, if_neg (by omega), if_pos (by omega), if_pos h0, e1]
        simp
    · have he : e ≠ 0 := fun h => h0 (by rw [h]; rfl)
      have e1 : e - Finsupp.single 0 1 + Finsupp.single 0 1 = e :=
        hext _ _ (by rw [hadd, hsub]; simp; omega) (by rw [hadd, hsub]; simp [h01])
      rw [if_neg he, if_pos (by omega), e1, if_neg h0]
      simp


  have hCmem : MvPowerSeries.C ϖ ∈ ({MvPowerSeries.C ϖ, MvPowerSeries.X 0, MvPowerSeries.X 1} :
      Set (MvPowerSeries (Fin 2) R)) := Set.mem_insert _ _
  have hX0mem : MvPowerSeries.X 0 ∈ ({MvPowerSeries.C ϖ, MvPowerSeries.X 0, MvPowerSeries.X 1} :
      Set (MvPowerSeries (Fin 2) R)) := Set.mem_insert_of_mem _ (Set.mem_insert _ _)
  have hX1mem : MvPowerSeries.X 1 ∈ ({MvPowerSeries.C ϖ, MvPowerSeries.X 0, MvPowerSeries.X 1} :
      Set (MvPowerSeries (Fin 2) R)) :=
    Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)
  have hmemA : ∀ φ : MvPowerSeries (Fin 2) R, φ ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) R)
      ↔ MvPowerSeries.constantCoeff φ ∈ IsLocalRing.maximalIdeal R := by
    intro φ
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
      IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  have hmA : IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) R) =
      Ideal.span {MvPowerSeries.C ϖ, MvPowerSeries.X 0, MvPowerSeries.X 1} := by
    apply le_antisymm
    · intro φ hφ
      rw [hmemA, hm] at hφ
      obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hφ
      obtain ⟨g₀, g₁, hφeq, -, -⟩ := hD φ
      rw [hφeq, ← ht, map_mul]
      refine add_mem (add_mem ?_ ?_) ?_
      · exact Ideal.mul_mem_left _ _ (Ideal.subset_span hCmem)
      · exact Ideal.mul_mem_right _ _ (Ideal.subset_span hX0mem)
      · exact Ideal.mul_mem_right _ _ (Ideal.subset_span hX1mem)
    · rw [Ideal.span_le]
      intro g hg
      rcases hg with rfl | rfl | rfl
      · rw [SetLike.mem_coe, hmemA, MvPowerSeries.constantCoeff_C, hm]
        exact Ideal.mem_span_singleton_self ϖ
      · rw [SetLike.mem_coe, hmemA, MvPowerSeries.constantCoeff_X]
        exact zero_mem _
      · rw [SetLike.mem_coe, hmemA, MvPowerSeries.constantCoeff_X]
        exact zero_mem _


  have hfilt : ∀ (n : ℕ) (φ : MvPowerSeries (Fin 2) R),
      φ ∈ (Ideal.span {MvPowerSeries.C ϖ, MvPowerSeries.X 0, MvPowerSeries.X 1} :
        Ideal (MvPowerSeries (Fin 2) R)) ^ n ↔
        ∀ e : Fin 2 →₀ ℕ, MvPowerSeries.coeff e φ ∈ (Ideal.span {ϖ} : Ideal R) ^ (n - (e 0 + e 1)) := by
    let F : ℕ → Ideal (MvPowerSeries (Fin 2) R) := fun n =>
      { carrier := {φ | ∀ e : Fin 2 →₀ ℕ,
          MvPowerSeries.coeff e φ ∈ (Ideal.span {ϖ} : Ideal R) ^ (n - (e 0 + e 1))}
        add_mem' := fun {a b} ha hb e => by rw [map_add]; exact add_mem (ha e) (hb e)
        zero_mem' := fun e => by rw [LinearMap.map_zero]; exact zero_mem _
        smul_mem' := fun a {φ} hφ e => by
          rw [smul_eq_mul, MvPowerSeries.coeff_mul]
          apply Ideal.sum_mem
          intro p hp
          apply Ideal.mul_mem_left
          have hpe := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          have hp0 : p.1 0 + p.2 0 = e 0 := by rw [← Finsupp.add_apply, hpe]
          have hp1 : p.1 1 + p.2 1 = e 1 := by rw [← Finsupp.add_apply, hpe]
          exact Ideal.pow_le_pow_right (by omega) (hφ p.2) }
    have hF : ∀ n φ, φ ∈ F n ↔ ∀ e : Fin 2 →₀ ℕ,
        MvPowerSeries.coeff e φ ∈ (Ideal.span {ϖ} : Ideal R) ^ (n - (e 0 + e 1)) :=
      fun n φ => Iff.rfl
    have h1 : ∀ n, (Ideal.span {MvPowerSeries.C ϖ, MvPowerSeries.X 0, MvPowerSeries.X 1} :
        Ideal (MvPowerSeries (Fin 2) R)) ^ n ≤ F n := by
      intro n
      induction n with
      | zero =>
        intro φ _
        rw [hF]
        intro e
        rw [Nat.zero_sub, pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      | succ n ih =>
        rw [pow_succ, Ideal.mul_le]
        intro r hr s hs
        have hr' := (hF _ _).mp (ih hr)
        obtain ⟨a, z, hz, rfl⟩ := Ideal.mem_span_insert.mp hs
        obtain ⟨b, d, rfl⟩ := Ideal.mem_span_pair.mp hz
        have hC : MvPowerSeries.C ϖ * r ∈ F (n + 1) := by
          rw [hF]
          intro e
          rw [MvPowerSeries.coeff_C_mul]
          have : ϖ * MvPowerSeries.coeff e r ∈
              (Ideal.span {ϖ} : Ideal R) ^ (n - (e 0 + e 1) + 1) := by
            rw [pow_succ']
            exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self ϖ) (hr' e)
          exact Ideal.pow_le_pow_right (by omega) this
        have hXi : ∀ i : Fin 2, MvPowerSeries.X i * r ∈ F (n + 1) := by
          intro i
          rw [hF]
          intro e
          rw [hX]
          by_cases hi : 1 ≤ e i
          · rw [if_pos hi]
            have h2 := hr' (e - Finsupp.single i 1)
            rw [hsumsub i e hi] at h2
            have e2 : n - (e 0 + e 1 - 1) = n + 1 - (e 0 + e 1) := by
              have : 1 ≤ e 0 + e 1 := by
                rcases Fin.exists_fin_two.mp ⟨i, rfl⟩ with h | h <;> subst h <;> omega
              omega
            rw [e2] at h2
            exact h2
          · rw [if_neg hi]
            exact zero_mem _
        have e : r * (a * MvPowerSeries.C ϖ + (b * MvPowerSeries.X 0 + d * MvPowerSeries.X 1)) =
            a * (MvPowerSeries.C ϖ * r) + b * (MvPowerSeries.X 0 * r) +
              d * (MvPowerSeries.X 1 * r) := by ring
        rw [e]
        exact add_mem (add_mem (Ideal.mul_mem_left _ a hC) (Ideal.mul_mem_left _ b (hXi 0)))
          (Ideal.mul_mem_left _ d (hXi 1))
    have h2 : ∀ n, F n ≤ (Ideal.span {MvPowerSeries.C ϖ, MvPowerSeries.X 0, MvPowerSeries.X 1} :
        Ideal (MvPowerSeries (Fin 2) R)) ^ n := by
      intro n
      induction n with
      | zero =>
        intro φ _
        rw [pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      | succ n ih =>
        intro φ hφ
        rw [hF] at hφ
        obtain ⟨g₀, g₁, hφeq, hg₀, hg₁⟩ := hD φ
        rw [hφeq]
        have hg₀F : g₀ ∈ F n := by
          rw [hF]
          intro e
          rw [hg₀]
          have h := hφ (e + Finsupp.single 0 1)
          rw [hadd, hadd] at h
          simp only [if_true, h01, if_false] at h
          have e2 : n + 1 - (e 0 + 1 + (e 1 + 0)) = n - (e 0 + e 1) := by omega
          rw [e2] at h
          exact h
        have hg₁F : g₁ ∈ F n := by
          rw [hF]
          intro e
          rw [hg₁]
          by_cases he0 : e 0 = 0
          · rw [if_pos he0]
            have h := hφ (e + Finsupp.single 1 1)
            rw [hadd, hadd] at h
            simp only [if_true, h10, if_false] at h
            have e2 : n + 1 - (e 0 + 0 + (e 1 + 1)) = n - (e 0 + e 1) := by omega
            rw [e2] at h
            exact h
          · rw [if_neg he0]
            exact zero_mem _
        refine add_mem (add_mem ?_ ?_) ?_
        · have h0 := hφ 0
          have e0 : n + 1 - ((0 : Fin 2 →₀ ℕ) 0 + (0 : Fin 2 →₀ ℕ) 1) = n + 1 := by simp
          rw [e0, Ideal.span_singleton_pow, MvPowerSeries.coeff_zero_eq_constantCoeff_apply] at h0
          obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp h0
          rw [← ht, map_mul, map_pow]
          exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow (Ideal.subset_span hCmem) _)
        · rw [pow_succ']
          exact Ideal.mul_mem_mul (Ideal.subset_span hX0mem) (ih hg₀F)
        · rw [pow_succ']
          exact Ideal.mul_mem_mul (Ideal.subset_span hX1mem) (ih hg₁F)
    intro n φ
    rw [← hF]
    exact ⟨fun h => h1 n h, fun h => h2 n h⟩


  have hAprec : IsPrecomplete
      (Ideal.span {MvPowerSeries.C ϖ, MvPowerSeries.X 0, MvPowerSeries.X 1} :
        Ideal (MvPowerSeries (Fin 2) R)) (MvPowerSeries (Fin 2) R) := by
    rw [hm] at hcomp
    have hPc := hcomp.toIsPrecomplete
    refine ⟨fun f hf => ?_⟩
    have hc : ∀ e : Fin 2 →₀ ℕ, ∃ L : R, ∀ j, MvPowerSeries.coeff e (f (j + (e 0 + e 1))) ≡ L
        [SMOD (Ideal.span {ϖ} : Ideal R) ^ j • (⊤ : Submodule R R)] := by
      intro e
      apply hPc.prec
      intro j j' hjj
      rw [hsm, ← map_sub]
      have := (hfilt (j + (e 0 + e 1)) _).mp
        ((hsm _ _ _ _).mp (hf (by omega : j + (e 0 + e 1) ≤ j' + (e 0 + e 1)))) e
      rwa [Nat.add_sub_cancel] at this
    choose L hL using hc
    obtain ⟨G, hG⟩ : ∃ G : MvPowerSeries (Fin 2) R, ∀ e, MvPowerSeries.coeff e G = L e :=
      ⟨fun e => L e, fun e => rfl⟩
    refine ⟨G, fun n => ?_⟩
    rw [hsm, hfilt]
    intro e
    rw [map_sub, hG]
    by_cases hk : e 0 + e 1 ≤ n
    · have e2 : n - (e 0 + e 1) + (e 0 + e 1) = n := by omega
      have := (hsm _ _ _ _).mp (hL e (n - (e 0 + e 1)))
      rw [e2] at this
      exact this
    · have e2 : n - (e 0 + e 1) = 0 := by omega
      rw [e2, pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top


  have hquotprec : ∀ (A : Type u) [CommRing A] (J I : Ideal A), IsPrecomplete J A →
      IsPrecomplete (Ideal.map (Ideal.Quotient.mk I) J) (A ⧸ I) := by
    intro A _ J I hJ
    refine ⟨fun a ha => ?_⟩
    have hinc : ∀ k, a (k + 1) - a k ∈ Ideal.map (Ideal.Quotient.mk I) (J ^ k) := by
      intro k
      rw [Ideal.map_pow]
      have := (hsm _ _ _ _).mp (ha (Nat.le_succ k))
      rw [← neg_sub]
      exact neg_mem this
    choose j hj hjeq using fun k =>
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp (hinc k)
    obtain ⟨b₀, hb₀⟩ := Ideal.Quotient.mk_surjective (a 0)
    let b : ℕ → A := fun n => b₀ + ∑ k ∈ Finset.range n, j k
    have hb : ∀ n, Ideal.Quotient.mk I (b n) = a n := by
      intro n
      induction n with
      | zero => simp [b, hb₀]
      | succ n ih =>
        have e : b (n + 1) = b n + j n := by
          simp only [b, Finset.sum_range_succ]; ring
        rw [e, map_add, ih, hjeq]; ring
    have hbc : ∀ m n, m ≤ n → b m - b n ∈ J ^ m := by
      intro m n hmn
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmn
      have e : b m - b (m + d) = -∑ k ∈ Finset.range d, j (m + k) := by
        simp only [b, Finset.sum_range_add]; ring
      rw [e]
      refine neg_mem (Ideal.sum_mem _ fun k _ => ?_)
      exact Ideal.pow_le_pow_right (by omega) (hj (m + k))
    obtain ⟨ℓ, hℓ⟩ := hJ.prec (fun {m n} hmn => (hsm _ _ _ _).mpr (hbc m n hmn))
    refine ⟨Ideal.Quotient.mk I ℓ, fun n => ?_⟩
    rw [hsm, ← hb n, ← map_sub, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ ((hsm _ _ _ _).mp (hℓ n))


  have hquotloc : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (I : Ideal A),
      I ≤ IsLocalRing.maximalIdeal A → ∃ (_ : IsLocalRing (A ⧸ I)),
        IsLocalRing.maximalIdeal (A ⧸ I) =
          Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal A) := by
    intro A _ _ I hI
    have hne : I ≠ ⊤ := fun h =>
      (IsLocalRing.maximalIdeal.isMaximal A).ne_top (top_le_iff.mp (h ▸ hI))
    haveI : Nontrivial (A ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hne
    haveI hQ : IsLocalRing (A ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    refine ⟨hQ, ?_⟩
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective (IsLocalRing.maximalIdeal.isMaximal A) with h | h
    · exfalso
      have h1 := Ideal.comap_map_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
        (IsLocalRing.maximalIdeal A)
      rw [h, Ideal.comap_top] at h1
      have h2 : Ideal.comap (Ideal.Quotient.mk I) ⊥ = I := by
        rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
      rw [h2, sup_eq_left.mpr hI] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top h1.symm
    · exact (IsLocalRing.eq_maximalIdeal h).symm


  have hf𝔪 : (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c :
      MvPowerSeries (Fin 2) R) ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) R) := by
    rw [hmemA, map_sub, map_mul, MvPowerSeries.constantCoeff_X, MvPowerSeries.constantCoeff_C,
      zero_mul, zero_sub]
    exact neg_mem hcm
  have hIle : Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c :
      MvPowerSeries (Fin 2) R)} ≤ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) R) :=
    (Ideal.span_singleton_le_iff_mem _).mpr hf𝔪
  let e11 : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1
  have hxy : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) R) =
      MvPowerSeries.monomial e11 1 := by
    rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, mul_one]
  have he11 : e11 ≠ 0 := by
    intro h
    have := congrArg (fun f => f 0) h
    simp [e11] at this
  have hf0 : (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c :
      MvPowerSeries (Fin 2) R) ≠ 0 := by
    intro h
    have := congrArg (MvPowerSeries.coeff e11) h
    rw [map_sub, hxy, MvPowerSeries.coeff_monomial, MvPowerSeries.coeff_C, if_pos rfl,
      if_neg he11, sub_zero, map_zero] at this
    exact one_ne_zero this
  have hfnzd : (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c :
      MvPowerSeries (Fin 2) R) ∈ nonZeroDivisors (MvPowerSeries (Fin 2) R) :=
    mem_nonZeroDivisors_of_ne_zero hf0


  have hdimA : ringKrullDim (MvPowerSeries (Fin 2) R) = 3 := by
    apply le_antisymm
    · have hs : Submodule.spanFinrank (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) R)) ≤ 3 := by
        rw [hmA]
        refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans ?_
        refine (Set.ncard_insert_le _ _).trans ?_
        have := Set.ncard_insert_le (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) R)
          {MvPowerSeries.X 1}
        rw [Set.ncard_singleton] at this
        omega
      have hht := Ideal.height_le_spanFinrank (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) R))
        (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim]
      have h3 : (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) R)).height ≤ 3 :=
        hht.trans (by exact_mod_cast hs)
      exact le_of_le_of_eq (WithBot.coe_le_coe.mpr h3) rfl
    · have e0 : MvPowerSeries (Fin 0) R ≃+* R := by
        refine RingEquiv.ofBijective (MvPowerSeries.constantCoeff) ⟨?_, ?_⟩
        · rw [injective_iff_map_eq_zero]
          intro φ hφ
          ext e
          have he : e = 0 := Subsingleton.elim _ _
          rw [he, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hφ, map_zero]
        · intro r
          exact ⟨MvPowerSeries.C r, by simp⟩
      have h0 : ringKrullDim (MvPowerSeries (Fin 0) R) = 1 := by
        rw [ringKrullDim_eq_of_ringEquiv e0, IsDiscreteValuationRing.ringKrullDim_eq_one]
      have h1 : 2 ≤ ringKrullDim (MvPowerSeries (Fin 1) R) := by
        have := ringKrullDim_succ_le_ringKrullDim_powerseries (R := MvPowerSeries (Fin 0) R)
        rw [h0, ← ringKrullDim_eq_of_ringEquiv (MvPowerSeries.finSuccEquiv R 0).toRingEquiv] at this
        exact this
      have h2 : ringKrullDim (MvPowerSeries (Fin 1) R) + 1 ≤
          ringKrullDim (MvPowerSeries (Fin 2) R) := by
        have := ringKrullDim_succ_le_ringKrullDim_powerseries (R := MvPowerSeries (Fin 1) R)
        rw [← ringKrullDim_eq_of_ringEquiv (MvPowerSeries.finSuccEquiv R 1).toRingEquiv] at this
        exact this
      calc (3 : WithBot ℕ∞) = 2 + 1 := rfl
        _ ≤ ringKrullDim (MvPowerSeries (Fin 1) R) + 1 := by gcongr
        _ ≤ _ := h2
  have hcancel : ∀ d : WithBot ℕ∞, d + 1 = 3 → d = 2 := by
    intro d h
    induction d using WithBot.recBotCoe with
    | bot => simp at h
    | coe d =>
      have h3 : (3 : WithBot ℕ∞) = ((3 : ℕ∞) : WithBot ℕ∞) := rfl
      rw [h3, ← WithBot.coe_one, ← WithBot.coe_add] at h
      have h' : d + 1 = 3 := WithBot.coe_injective h
      induction d using ENat.recTopCoe with
      | top => simp at h'
      | coe m =>
        have h'' : ((m + 1 : ℕ) : ℕ∞) = ((3 : ℕ) : ℕ∞) := by push_cast; exact h'
        have h4 : m + 1 = 3 := Nat.cast_injective h''
        have : m = 2 := by omega
        subst this
        rfl


  obtain ⟨hloc, hmQ⟩ := hquotloc (MvPowerSeries (Fin 2) R) _ hIle
  refine ⟨hloc, ?_, ?_, ?_, ?_⟩
  ·
    haveI hH : IsHausdorff (IsLocalRing.maximalIdeal (nccwffQ R c)) (nccwffQ R c) := ⟨fun z hz => by
      have hmem : z ∈ ⨅ i : ℕ, IsLocalRing.maximalIdeal (nccwffQ R c) ^ i :=
        Ideal.mem_iInf.mpr (fun i => by
          have := (hsm _ _ _ _).mp (hz i)
          rwa [sub_zero] at this)
      rw [Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal (nccwffQ R c))
        (IsLocalRing.maximalIdeal.isMaximal _).ne_top] at hmem
      exact hmem⟩
    haveI hP : IsPrecomplete (IsLocalRing.maximalIdeal (nccwffQ R c)) (nccwffQ R c) := by
      rw [hmQ, hmA]
      exact hquotprec _ _ _ hAprec
    exact IsAdicComplete.mk
  ·
    have h := ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
      hfnzd hf𝔪
    rw [hdimA] at h
    exact hcancel _ h
  ·
    rw [injective_iff_map_eq_zero]
    intro r hr
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hr
    obtain ⟨g, hg⟩ := hr
    let d : ℕ → (Fin 2 →₀ ℕ) := fun i => Finsupp.single 0 i + Finsupp.single 1 i
    have hcoeff : ∀ m, MvPowerSeries.coeff m (MvPowerSeries.C r : MvPowerSeries (Fin 2) R) =
        (if e11 ≤ m then MvPowerSeries.coeff (m - e11) g else 0) -
          MvPowerSeries.coeff m g * c := by
      intro m
      rw [← hg, mul_sub, hxy, map_sub, MvPowerSeries.coeff_mul_monomial,
        MvPowerSeries.coeff_mul_C]
      simp
    have hd0 : d 0 = 0 := by simp [d]
    have hdne : ∀ i, d (i + 1) ≠ 0 := by
      intro i h
      have := congrArg (fun f => f 0) h
      simp [d] at this
    have hle : ∀ i, e11 ≤ d (i + 1) := by
      intro i k
      fin_cases k <;> simp [d, e11]
    have hsubd : ∀ i, d (i + 1) - e11 = d i := by
      intro i
      ext k
      fin_cases k <;> simp [d, e11]
    have hnle : ¬ e11 ≤ d 0 := by
      intro h
      have := h 0
      simp [d, e11] at this
    have hrec : ∀ i, MvPowerSeries.coeff (d i) g = MvPowerSeries.coeff (d (i + 1)) g * c := by
      intro i
      have h := hcoeff (d (i + 1))
      rw [MvPowerSeries.coeff_C, if_neg (hdne i), if_pos (hle i), hsubd i] at h
      exact (sub_eq_zero.mp h.symm)
    have hr0 : r = - (MvPowerSeries.coeff (d 0) g * c) := by
      have h := hcoeff (d 0)
      rw [hd0] at h
      rw [MvPowerSeries.coeff_C, if_pos rfl, if_neg (by rw [← hd0]; exact hnle)] at h
      rw [h, ← hd0]; ring
    have hpow : ∀ i, MvPowerSeries.coeff (d 0) g ∈ IsLocalRing.maximalIdeal R ^ i := by
      intro i
      have : ∀ i, MvPowerSeries.coeff (d 0) g = MvPowerSeries.coeff (d i) g * c ^ i := by
        intro i
        induction i with
        | zero => simp
        | succ i ih => rw [ih, hrec i, pow_succ]; ring
      rw [this i]
      exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hcm i)
    have h0 : MvPowerSeries.coeff (d 0) g = 0 := by
      have := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
        (IsLocalRing.maximalIdeal.isMaximal R).ne_top
      have hmm : MvPowerSeries.coeff (d 0) g ∈ ⨅ i : ℕ, IsLocalRing.maximalIdeal R ^ i :=
        Ideal.mem_iInf.mpr hpow
      rw [this] at hmm
      exact hmm
    rw [hr0, h0, zero_mul, neg_zero]
  ·
    haveI hlh : IsLocalHom (nccwffPsi R c) := ⟨fun r hr => by
      by_contra hn
      have hrm : MvPowerSeries.C r ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) R) := by
        rw [hmemA, MvPowerSeries.constantCoeff_C, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        exact hn
      have hψm : nccwffPsi R c r ∈ IsLocalRing.maximalIdeal (nccwffQ R c) := by
        rw [hmQ]
        exact Ideal.mem_map_of_mem _ hrm
      exact (IsLocalRing.mem_maximalIdeal _).mp hψm hr⟩
    have hinj : Function.Injective (IsLocalRing.ResidueField.map (nccwffPsi R c)) :=
      (IsLocalRing.ResidueField.map (nccwffPsi R c)).injective
    have hsurj : Function.Surjective (IsLocalRing.ResidueField.map (nccwffPsi R c)) := by
      intro y
      obtain ⟨q, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨φ, rfl⟩ := Ideal.Quotient.mk_surjective q
      refine ⟨IsLocalRing.residue R (MvPowerSeries.constantCoeff φ), ?_⟩
      rw [IsLocalRing.ResidueField.map_residue, ← sub_eq_zero, ← map_sub,
        IsLocalRing.residue_eq_zero_iff, hmQ]
      have e : nccwffPsi R c (MvPowerSeries.constantCoeff φ) - Ideal.Quotient.mk _ φ =
          Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
            MvPowerSeries.C c : MvPowerSeries (Fin 2) R)})
            (MvPowerSeries.C (MvPowerSeries.constantCoeff φ) - φ) := by
        rw [map_sub]; rfl
      rw [e]
      apply Ideal.mem_map_of_mem
      rw [hmemA, map_sub, MvPowerSeries.constantCoeff_C, sub_self]
      exact zero_mem _
    refine ⟨RingEquiv.ofBijective _ ⟨hinj, hsurj⟩, ?_⟩
    ext r
    exact IsLocalRing.ResidueField.map_residue _ r

theorem nccwff_normal_point_model : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ →
    ∀ (M : Type u) [CommRing M] [IsDomain M] [IsIntegrallyClosed M] (ψ : R →+* M)
      (e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (ν zk)))
        (Z.presheaf.stalk (ν zk)) ≃+* M),
      e.toRingHom.comp (nccwffSig u (ν zk)) = ψ →
      ∃ e' : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk))
        (S.presheaf.stalk zk) ≃+* M, e'.toRingHom.comp (nccwffSig (ν ≫ u) zk) = ψ :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA
    M _ _ _ ψ e hψ

  have factorPow_evalₐ : ∀ (O : Type u) [CommRing O] (I : Ideal O) {m n : ℕ} (hmn : m ≤ n),
      (Ideal.Quotient.factorPow I hmn).comp (AdicCompletion.evalₐ I n).toRingHom =
        (AdicCompletion.evalₐ I m).toRingHom := by
    intro O _ I m n hmn
    ext x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I O x
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
      AdicCompletion.evalₐ_mk]
    rw [Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have hc := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn c
    rw [Submodule.Quotient.eq] at hc
    have e0 : I ^ m • (⊤ : Submodule O O) = I ^ m := by
      rw [smul_eq_mul, Ideal.mul_top]
    rw [e0] at hc
    exact hc

  have transport : ∀ (O O' : Type u) [CommRing O] [CommRing O'] (I : Ideal O) (J : Ideal O')
      (φ : O ≃+* O'), J = Ideal.map φ I →
      ∃ Φ : AdicCompletion I O ≃+* AdicCompletion J O',
        ∀ x, Φ (algebraMap O _ x) = algebraMap O' _ (φ x) := by
    intro O O' _ _ I J φ hJ
    have hJn : ∀ n : ℕ, J ^ n = Ideal.map φ (I ^ n) := fun n => by rw [Ideal.map_pow, hJ]
    have hIn : ∀ n : ℕ, I ^ n = Ideal.map φ.symm (J ^ n) := fun n => by
      rw [hJn]
      ext x
      rw [Ideal.map_symm, Ideal.mem_comap, Ideal.mem_map_of_equiv]
      constructor
      · intro hx; exact ⟨x, hx, rfl⟩
      · rintro ⟨y, hy, hxy⟩; rw [← φ.injective hxy]; exact hy
    let qq : ∀ n : ℕ, O ⧸ I ^ n ≃+* O' ⧸ J ^ n := fun n => Ideal.quotientEquiv _ _ φ (hJn n)
    let qq' : ∀ n : ℕ, O' ⧸ J ^ n ≃+* O ⧸ I ^ n := fun n =>
      Ideal.quotientEquiv _ _ φ.symm (hIn n)
    have hq : ∀ n x, qq n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (φ x) := fun n x =>
      Ideal.quotientEquiv_mk _ _ _ _ _
    have hq' : ∀ n x, qq' n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (φ.symm x) :=
      fun n x => Ideal.quotientEquiv_mk _ _ _ _ _
    have hF : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow J hle).comp
        ((qq n).toRingHom.comp (AdicCompletion.evalₐ I n).toRingHom) =
        (qq m).toRingHom.comp (AdicCompletion.evalₐ I m).toRingHom := by
      intro m n hle
      rw [← factorPow_evalₐ O I hle, ← RingHom.comp_assoc, ← RingHom.comp_assoc]
      congr 1
      apply Ideal.Quotient.ringHom_ext
      ext x
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hq,
        Ideal.Quotient.factor_mk]
    have hG : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp
        ((qq' n).toRingHom.comp (AdicCompletion.evalₐ J n).toRingHom) =
        (qq' m).toRingHom.comp (AdicCompletion.evalₐ J m).toRingHom := by
      intro m n hle
      rw [← factorPow_evalₐ O' J hle, ← RingHom.comp_assoc, ← RingHom.comp_assoc]
      congr 1
      apply Ideal.Quotient.ringHom_ext
      ext x
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hq',
        Ideal.Quotient.factor_mk]
    let F := AdicCompletion.liftRingHom J _ hF
    let G := AdicCompletion.liftRingHom I _ hG
    have hFe : ∀ n x, AdicCompletion.evalₐ J n (F x) = qq n (AdicCompletion.evalₐ I n x) :=
      fun n x => AdicCompletion.evalₐ_liftRingHom J _ hF n x
    have hGe : ∀ n x, AdicCompletion.evalₐ I n (G x) = qq' n (AdicCompletion.evalₐ J n x) :=
      fun n x => AdicCompletion.evalₐ_liftRingHom I _ hG n x
    have hqq : ∀ n y, qq' n (qq n y) = y := by
      intro n y
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hq, hq', RingEquiv.symm_apply_apply]
    have hqq' : ∀ n y, qq n (qq' n y) = y := by
      intro n y
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hq', hq, RingEquiv.apply_symm_apply]
    refine ⟨RingEquiv.ofRingHom F G ?_ ?_, ?_⟩
    · refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hFe, hGe, hqq']
    · refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hGe, hFe, hqq]
    · intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      show AdicCompletion.evalₐ J n (F _) = _
      rw [hFe]
      simp [hq]

  have descent : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O],
      (AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+* M) →
      IsDomain O ∧ IsIntegrallyClosed O := by
    intro O _ _ _ e
    set 𝔪 := IsLocalRing.maximalIdeal O with h𝔪
    set alg := algebraMap O (AdicCompletion 𝔪 O) with halg
    have hinj : Function.Injective alg := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      have hmem : a ∈ ⨅ i, 𝔪 ^ i := by
        rw [Submodule.mem_iInf]
        intro i
        have h1 : AdicCompletion.evalₐ 𝔪 i (alg a) = Ideal.Quotient.mk _ a := by simp [halg]
        rw [ha, map_zero] at h1
        exact Ideal.Quotient.eq_zero_iff_mem.mp h1.symm
      rw [Ideal.iInf_pow_eq_bot_of_isLocalRing 𝔪
        (IsLocalRing.maximalIdeal.isMaximal O).ne_top] at hmem
      exact hmem
    set f : O →+* M := e.toRingHom.comp alg with hf
    have hfinj : Function.Injective f := e.injective.comp hinj
    haveI hdom : IsDomain O := hfinj.isDomain f
    haveI : Module.Flat O (AdicCompletion 𝔪 O) := AdicCompletion.flat_of_isNoetherian 𝔪
    haveI : Module.FaithfullyFlat O (AdicCompletion 𝔪 O) := by
      refine Module.FaithfullyFlat.mk ?_
      intro m hm htop
      rw [IsLocalRing.eq_maximalIdeal hm] at htop
      let ε := (AdicCompletion.evalₐ 𝔪 1).toLinearMap
      have hle : 𝔪 • (⊤ : Submodule O (AdicCompletion 𝔪 O)) ≤ LinearMap.ker ε := by
        apply Submodule.smul_le.mpr
        intro r hr x _
        rw [LinearMap.mem_ker, map_smul, Algebra.smul_def]
        have : algebraMap O (O ⧸ 𝔪 ^ 1) r = 0 := by
          rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem, pow_one]
          exact hr
        rw [this, zero_mul]
      have h1 : (1 : AdicCompletion 𝔪 O) ∈ LinearMap.ker ε :=
        hle (by rw [htop]; exact Submodule.mem_top)
      rw [LinearMap.mem_ker] at h1
      have h2 : (1 : O ⧸ 𝔪 ^ 1) = 0 := by
        rw [← h1]; simp [ε]
      rw [eq_comm, Ideal.Quotient.zero_eq_one_iff, pow_one] at h2
      exact (IsLocalRing.maximalIdeal.isMaximal O).ne_top h2
    have hdiv : ∀ a b : O, (∃ c, alg a = c * alg b) → ∃ d, a = d * b := by
      intro a b ⟨c, hc⟩
      have h1 : a ∈ Ideal.comap alg (Ideal.map alg (Ideal.span {b})) := by
        rw [Ideal.mem_comap, Ideal.map_span, Set.image_singleton]
        exact Ideal.mem_span_singleton'.mpr ⟨c, hc.symm⟩
      rw [halg, Ideal.comap_map_eq_self_of_faithfullyFlat] at h1
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp h1
      exact ⟨d, hd.symm⟩
    refine ⟨hdom, ?_⟩
    have hnz : nonZeroDivisors O ≤ (nonZeroDivisors M).comap f := fun b hb =>
      mem_nonZeroDivisors_of_ne_zero (fun h0 => nonZeroDivisors.ne_zero hb
        (hfinj (h0.trans (map_zero f).symm)))
    let g : FractionRing O →+* FractionRing M := IsLocalization.map (FractionRing M) f hnz
    have hgc : (algebraMap M (FractionRing M)).comp f =
        g.comp (algebraMap O (FractionRing O)) :=
      (IsLocalization.map_comp hnz).symm
    rw [isIntegrallyClosed_iff (FractionRing O)]
    intro x hx
    have hx' : IsIntegral M (g x) := IsIntegral.map_of_comp_eq f g hgc hx
    obtain ⟨m, hm⟩ := (isIntegrallyClosed_iff (FractionRing M)).mp inferInstance hx'
    obtain ⟨⟨a, b⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors O) x
    have hgx : g (IsLocalization.mk' (FractionRing O) a b) =
        IsLocalization.mk' (FractionRing M) (f a) ⟨f b, hnz b.2⟩ :=
      IsLocalization.map_mk' _ _ _
    rw [hgx, IsLocalization.eq_mk'_iff_mul_eq, ← map_mul] at hm
    have hm' : m * f b = f a := IsFractionRing.injective M (FractionRing M) hm
    have hab : alg a = e.symm m * alg b := by
      apply e.injective
      rw [map_mul, RingEquiv.apply_symm_apply]
      exact hm'.symm
    obtain ⟨d, hd⟩ := hdiv a b ⟨_, hab⟩
    refine ⟨d, ?_⟩
    rw [IsLocalization.eq_mk'_iff_mul_eq, ← map_mul, ← hd]

  have hs3 : ∀ r : R, (ν.stalkMap zk).hom ((Z.presheaf.germ ⊤ (ν zk) trivial).hom
      (wcCnSigma u ⊤ r)) = (S.presheaf.germ ⊤ zk trivial).hom (wcCnSigma (ν ≫ u) ⊤ r) := by
    intro r
    show (ν.stalkMap zk).hom ((Z.presheaf.germ ⊤ (ν zk) trivial).hom
      ((Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op).hom
        (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r)))) =
      (S.presheaf.germ ⊤ zk trivial).hom
        ((S.presheaf.map (homOfLE (le_top : (⊤ : S.Opens) ≤ ⊤)).op).hom
          ((ν ≫ u).appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r)))
    have k1 : ∀ (X : Scheme.{u}) (x : X) (y : Γ(X, ⊤)),
        (X.presheaf.germ ⊤ x trivial).hom
          ((X.presheaf.map (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op).hom y) =
        (X.presheaf.germ ⊤ x trivial).hom y := by
      intro X x y
      exact X.presheaf.germ_res_apply (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)) x trivial y
    rw [k1, k1, Scheme.Hom.comp_appTop]
    exact Scheme.Hom.germ_stalkMap_apply ν ⊤ zk trivial
      (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r))

  obtain ⟨-, -, -, hH, hS⟩ := hA
  obtain ⟨-, hst, -⟩ := hH
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, ⟨-, hP12⟩⟩ := hS
  haveI : IsProper u := hst.1.2.1
  haveI : LocallyOfFiniteType u := inferInstance
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian u
  obtain ⟨hdom, hic⟩ := descent (Z.presheaf.stalk (ν zk)) e
  obtain ⟨w, hw, hiso⟩ := hP12 (ν zk) hdom hic
  have hwz : zk = w := (hw zk).mp rfl
  subst hwz
  let φ := (asIso (ν.stalkMap zk)).commRingCatIsoToRingEquiv
  obtain ⟨Φ, hΦ⟩ := transport _ _ (IsLocalRing.maximalIdeal _) (IsLocalRing.maximalIdeal _) φ
    (IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv φ)).symm
  refine ⟨Φ.symm.trans e, ?_⟩
  rw [← hψ]
  refine RingHom.ext fun r => ?_
  simp only [RingEquiv.toRingHom_eq_coe, RingHom.comp_apply, RingEquiv.coe_toRingHom,
    RingEquiv.trans_apply]
  congr 1
  rw [← hs3 r]
  have hφ : ∀ x, (ν.stalkMap zk).hom x = φ x := fun x => rfl
  rw [hφ, ← hΦ, RingEquiv.symm_apply_apply]

theorem nccwffnz_stalk_dim_two : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → 2 ≤ ringKrullDim (S.presheaf.stalk zk) :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA
  classical

  have s6 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [IsDomain A]
      [IsIntegrallyClosed A], ¬ (2 ≤ ringKrullDim A) → ValuationRing A := by
    intro A _ _ _ _ _ hlt
    by_cases hF : IsField A
    · rw [ValuationRing.iff_dvd_total]
      constructor
      intro x y
      by_cases hx : x = 0
      · right; rw [hx]; exact dvd_zero y
      · left
        obtain ⟨x', hx'⟩ := hF.mul_inv_cancel hx
        exact ⟨x' * y, by rw [← mul_assoc, hx', one_mul]⟩
    · have tfae := IsDiscreteValuationRing.TFAE A hF
      have h4 : IsIntegrallyClosed A ∧ ∃! P : Ideal A, P ≠ ⊥ ∧ P.IsPrime := by
        refine ⟨inferInstance, IsLocalRing.maximalIdeal A, ⟨?_, inferInstance⟩, ?_⟩
        · intro h0
          exact hF ((IsLocalRing.isField_iff_maximalIdeal_eq).mpr h0)
        · rintro P ⟨hP0, hPp⟩
          by_contra hPm
          apply hlt
          have hle : P ≤ IsLocalRing.maximalIdeal A := IsLocalRing.le_maximalIdeal hPp.ne_top
          let p0 : PrimeSpectrum A := ⟨⊥, Ideal.isPrime_bot⟩
          let p1 : PrimeSpectrum A := ⟨P, hPp⟩
          let p2 : PrimeSpectrum A := IsLocalRing.closedPoint A
          have h01 : p0 < p1 := by
            rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
            exact bot_lt_iff_ne_bot.mpr hP0
          have h12 : p1 < p2 := by
            rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
            exact lt_of_le_of_ne hle hPm
          let s : LTSeries (PrimeSpectrum A) :=
            ⟨2, ![p0, p1, p2], fun i => by
              fin_cases i
              · exact h01
              · exact h12⟩
          have h2 : ((2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim A := Order.LTSeries.length_le_krullDim s
          exact_mod_cast h2
      haveI : IsDiscreteValuationRing A := (tfae.out 1 4).mpr h4
      infer_instance

  have s7 : ∀ (O B K : Type u) [CommRing O] [IsDomain O] [ValuationRing O] [CommRing B]
      [CommRing K] [IsDomain K] (φ : O →+* B) [IsLocalHom φ] (θ : B →+* K),
      Function.Injective θ → (∀ b : B, ∃ x y : O, θ (φ y) ≠ 0 ∧ θ (φ y) * θ b = θ (φ x)) →
      Function.Surjective φ := by
    intro O B K _ _ _ _ _ _ φ _ θ hθ hfr b
    obtain ⟨x, y, hy0, key⟩ := hfr b
    rcases ValuationRing.dvd_total x y with ⟨c, hc⟩ | ⟨c, hc⟩
    · rw [hc, map_mul, map_mul] at key hy0
      have hx0 : θ (φ x) ≠ 0 := left_ne_zero_of_mul hy0
      have h1 : θ (φ c * b) = θ 1 := by
        rw [map_mul, map_one]
        apply mul_left_cancel₀ hx0
        rw [mul_one, ← mul_assoc, key]
      have h2 : φ c * b = 1 := hθ h1
      have hcu : IsUnit c := isUnit_of_map_unit φ c (IsUnit.of_mul_eq_one _ h2)
      obtain ⟨d, hd⟩ := hcu.exists_right_inv
      refine ⟨d, ?_⟩
      calc φ d = φ d * (φ c * b) := by rw [h2, mul_one]
        _ = φ (c * d) * b := by rw [map_mul]; ring
        _ = b := by rw [hd, map_one, one_mul]
    · refine ⟨c, hθ ?_⟩
      rw [hc, map_mul, map_mul] at key
      exact (mul_left_cancel₀ hy0 key).symm

  have s8 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (x x' : X), x' ⤳ x → f x' = f x →
      Function.Surjective (f.stalkMap x).hom → x' = x := by
    intro X Y f x x' hsp hfx hs
    have hr : x' ∈ Set.range (X.fromSpecStalk x) := by
      rw [Scheme.range_fromSpecStalk]; exact hsp
    obtain ⟨P, hP⟩ := hr
    have e := Scheme.SpecMap_stalkMap_fromSpecStalk f (x := x)
    have e1 : Y.fromSpecStalk (f x) (Spec.map (f.stalkMap x) P) = f x' := by
      rw [← Scheme.Hom.comp_apply, e, Scheme.Hom.comp_apply, hP]
    have e2 : Spec.map (f.stalkMap x) P = IsLocalRing.closedPoint (Y.presheaf.stalk (f x)) := by
      apply (Y.fromSpecStalk (f x)).isEmbedding.injective
      rw [e1, hfx, Scheme.fromSpecStalk_closedPoint]
    have e3 : PrimeSpectrum.comap (f.stalkMap x).hom (IsLocalRing.closedPoint (X.presheaf.stalk x))
        = IsLocalRing.closedPoint (Y.presheaf.stalk (f x)) :=
      IsLocalRing.comap_closedPoint (f.stalkMap x).hom
    have e4 : P = IsLocalRing.closedPoint (X.presheaf.stalk x) :=
      PrimeSpectrum.comap_injective_of_surjective _ hs (e2.trans e3.symm)
    rw [← hP, e4, Scheme.fromSpecStalk_closedPoint]

  have s45 : ∀ (X : Scheme.{u}) (x x' : X) (hxx : x' ⤳ x),
      (∀ k : X.presheaf.stalk x', ∃ a s : X.presheaf.stalk x,
        IsUnit ((X.presheaf.stalkSpecializes hxx).hom s) ∧
        (X.presheaf.stalkSpecializes hxx).hom s * k = (X.presheaf.stalkSpecializes hxx).hom a) ∧
      (IsDomain (X.presheaf.stalk x) → Function.Injective (X.presheaf.stalkSpecializes hxx).hom) := by
    intro X x x' hxx
    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    have hx'U : x' ∈ U := hxx.mem_open U.isOpen hxU
    obtain ⟨xU, rfl⟩ : ∃ xU : U, xU.1 = x := ⟨⟨x, hxU⟩, rfl⟩
    obtain ⟨x'U, rfl⟩ : ∃ x'U : U, x'U.1 = x' := ⟨⟨x', hx'U⟩, rfl⟩
    haveI hL := hU.isLocalization_stalk xU
    haveI hL' := hU.isLocalization_stalk x'U
    have hsp : ∀ c : Γ(X, U), (X.presheaf.stalkSpecializes hxx).hom
        (algebraMap Γ(X, U) (X.presheaf.stalk ↑xU) c) =
        algebraMap Γ(X, U) (X.presheaf.stalk ↑x'U) c := by
      intro c
      rw [TopCat.Presheaf.stalk_open_algebraMap, TopCat.Presheaf.stalk_open_algebraMap]
      exact TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf xU.2 hxx c
    refine ⟨fun k => ?_, fun hdom => ?_⟩
    · obtain ⟨⟨a₁, s₁⟩, hk⟩ := IsLocalization.mk'_surjective
        (S := X.presheaf.stalk ↑x'U) (hU.primeIdealOf x'U).asIdeal.primeCompl k
      dsimp only at hk
      refine ⟨algebraMap Γ(X, U) (X.presheaf.stalk ↑xU) a₁,
        algebraMap Γ(X, U) (X.presheaf.stalk ↑xU) (s₁ : Γ(X, U)), ?_, ?_⟩
      · rw [hsp]; exact IsLocalization.map_units (X.presheaf.stalk ↑x'U) s₁
      · rw [hsp, hsp, ← hk, mul_comm, IsLocalization.mk'_spec]
    · rw [injective_iff_map_eq_zero]
      intro b hb
      obtain ⟨⟨c, t⟩, hct⟩ := IsLocalization.mk'_surjective
        (S := X.presheaf.stalk ↑xU) (hU.primeIdealOf xU).asIdeal.primeCompl b
      dsimp only at hct
      subst hct
      have e1 := IsLocalization.mk'_spec (X.presheaf.stalk ↑xU) c t
      have e2 : algebraMap Γ(X, U) (X.presheaf.stalk ↑x'U) c = 0 := by
        rw [← hsp, ← e1, map_mul, hb, zero_mul]
      obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff (hU.primeIdealOf x'U).asIdeal.primeCompl
        (X.presheaf.stalk ↑x'U) c).mp e2
      have hm0 : algebraMap Γ(X, U) (X.presheaf.stalk ↑xU) (m : Γ(X, U)) ≠ 0 := by
        intro h0
        have h1 := IsLocalization.map_units (X.presheaf.stalk ↑x'U) m
        rw [← hsp, h0, map_zero] at h1
        exact not_isUnit_zero h1
      have e3 : algebraMap Γ(X, U) (X.presheaf.stalk ↑xU) c = 0 := by
        have h5 : algebraMap Γ(X, U) (X.presheaf.stalk ↑xU) ((m : Γ(X, U)) * c) = 0 := by
          rw [hm, map_zero]
        rw [map_mul] at h5
        exact (mul_eq_zero.mp h5).resolve_left hm0
      rw [e3] at e1
      exact (IsLocalization.map_units (X.presheaf.stalk ↑xU) t).mul_left_eq_zero.mp e1

  obtain ⟨-, -, -, hH, hS⟩ := hA
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hp, hu, -, hmax⟩ := hH
  obtain ⟨-, -, ⟨hSst, -, hNst⟩, ⟨-, hloft, -, -, hflat, -⟩, -, ⟨⟨V, hV, hVi⟩, -⟩,
    ⟨-, hη₀s, hη₀max, hη₀q, hη₀ν'⟩, hQ8, -⟩ := hS
  have hξu : u' ((ι ≫ Limits.pullback.snd u u') γ') = IsLocalRing.closedPoint R := by
    have e1 : (ι ≫ Limits.pullback.snd u u' ≫ u') γ' = (ι ≫ Limits.pullback.fst u u' ≫ u) γ' := by
      rw [← Limits.pullback.condition]
    rw [← Scheme.Hom.comp_apply, Category.assoc, e1, ← Category.assoc, Scheme.Hom.comp_apply, hp, hu]
  obtain ⟨-, -, -, huniq, -, -, -, hnt⟩ := hQ8 _ hξu hmax
  have hη₀eq : η₀ = η ((ι ≫ Limits.pullback.snd u u') γ') := huniq η₀ hη₀s hη₀max hη₀ν'
  rw [← hη₀eq] at hnt
  obtain ⟨n₂, hn₂mem, hne⟩ := hnt.exists_ne η₀
  have hsp : η₀ ⤳ n₂ := specializes_iff_mem_closure.mpr hn₂mem
  have hqn : q n₂ = zk := hη₀q n₂ hsp
  have hqη : q η₀ = zk := hη₀q η₀ (specializes_refl η₀)
  subst hqn

  by_contra hlt
  haveI := hloft
  haveI : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian (ν ≫ u)
  haveI := (hSst (q n₂)).1
  haveI := (hSst (q n₂)).2
  haveI : ValuationRing (S.presheaf.stalk (q n₂)) := s6 _ hlt

  haveI := hflat
  have hgen := Flat.generalizingMap (q ≫ ν ≫ u)
  let ηR : PrimeSpectrum R := ⟨⊥, Ideal.isPrime_bot⟩
  have hηR : ηR ⤳ (q ≫ ν ≫ u) n₂ :=
    (PrimeSpectrum.le_iff_specializes _ _).mp
      ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mp bot_le)
  obtain ⟨ζ, hζ, hζf⟩ := hgen hηR
  have hζcp : (ν ≫ u) (q ζ) ≠ IsLocalRing.closedPoint R := by
    rw [← Scheme.Hom.comp_apply, hζf]
    intro hc
    apply IsDiscreteValuationRing.not_a_field R
    have := congrArg PrimeSpectrum.asIdeal hc
    exact this.symm
  have hζV : q ζ ∈ V := hV (q ζ) hζcp

  have hiso : IsIso (q.stalkMap ζ) := by
    haveI := hVi
    let xV : ↥(q ⁻¹ᵁ V) := ⟨ζ, hζV⟩
    have e := morphismRestrictStalkMap q V xV
    have key : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) [IsIso g] (x : X), IsIso (g.stalkMap x) :=
      fun g _ x => inferInstance
    have h1 : (MorphismProperty.isomorphisms _) ((q ∣_ V).stalkMap xV) :=
      (MorphismProperty.isomorphisms.iff _).mpr (key (q ∣_ V) xV)
    exact (MorphismProperty.isomorphisms.iff _).mp
      (((MorphismProperty.isomorphisms _).arrow_mk_iso_iff e).mp h1)
  have hψbij : Function.Bijective (q.stalkMap ζ).hom := ConcreteCategory.bijective_of_isIso _
  have hsq : q ζ ⤳ q n₂ := hζ.map q.continuous
  have hcomm : ∀ w, (q.stalkMap ζ).hom ((S.presheaf.stalkSpecializes hsq).hom w) =
      (N.presheaf.stalkSpecializes hζ).hom ((q.stalkMap n₂).hom w) := by
    intro w
    have e := Scheme.Hom.stalkSpecializes_stalkMap q ζ n₂ hζ
    have := congrArg (fun f => CommRingCat.Hom.hom f w) e
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this
  obtain ⟨hfrac, -⟩ := s45 S (q n₂) (q ζ) hsq
  obtain ⟨-, hinj⟩ := s45 N n₂ ζ hζ
  have hθ := hinj (hNst n₂).1
  haveI : IsDomain (N.presheaf.stalk ζ) := (hNst ζ).1
  have hfr : ∀ b, ∃ x y, (N.presheaf.stalkSpecializes hζ).hom ((q.stalkMap n₂).hom y) ≠ 0 ∧
      (N.presheaf.stalkSpecializes hζ).hom ((q.stalkMap n₂).hom y) *
        (N.presheaf.stalkSpecializes hζ).hom b =
      (N.presheaf.stalkSpecializes hζ).hom ((q.stalkMap n₂).hom x) := by
    intro b
    obtain ⟨k, hk⟩ := hψbij.2 ((N.presheaf.stalkSpecializes hζ).hom b)
    obtain ⟨x, y, hyu, hyx⟩ := hfrac k
    refine ⟨x, y, ?_, ?_⟩
    · rw [← hcomm]; exact (hyu.map (q.stalkMap ζ).hom).ne_zero
    · rw [← hcomm, ← hcomm, ← hk, ← map_mul, hyx]
  have hφs := s7 _ _ _ (q.stalkMap n₂).hom (N.presheaf.stalkSpecializes hζ).hom hθ hfr
  exact hne (s8 N S q n₂ η₀ hsp hqη hφs).symm

theorem nccwffnz_affine_model : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → _root_.IsReduced (Z.presheaf.stalk (ν zk)) → ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.FiniteType R B) (𝔪 : Ideal B) (_ : 𝔪.IsMaximal) (C : Type u) (_ : CommRing C) (_ : Algebra (Localization.AtPrime 𝔪) C) (_ : Module.Finite (Localization.AtPrime 𝔪) C) (𝔫 : Ideal C) (_ : 𝔫.IsMaximal) (eO : Localization.AtPrime 𝔪 ≃+* Z.presheaf.stalk (ν zk)) (eS : Localization.AtPrime 𝔫 ≃+* S.presheaf.stalk zk), eO.toRingHom.comp (algebraMap R (Localization.AtPrime 𝔪)) = (Z.presheaf.germ ⊤ (ν zk) trivial).hom.comp (wcCnSigma u ⊤) ∧ eS.toRingHom.comp ((algebraMap C (Localization.AtPrime 𝔫)).comp (algebraMap (Localization.AtPrime 𝔪) C)) = (ν.stalkMap zk).hom.comp eO.toRingHom ∧ (∀ (P : Ideal C) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) ∧ ∀ 𝔭 ∈ minimalPrimes (Localization.AtPrime 𝔪), ∀ c : C, ∃ s ∉ 𝔭, ∃ b, s • c = algebraMap (Localization.AtPrime 𝔪) C b :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA hOred
  obtain ⟨-, -, -, hH, hS⟩ := hA
  obtain ⟨-, hst, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hp, -, hz, -⟩ := hH
  obtain ⟨-, ⟨hνfin, -⟩, ⟨hP3, -⟩, -, -, -, ⟨hP7, -⟩, -, -, -, -, -, -, hP12⟩ := hS
  haveI : IsProper u := hst.1.2.1
  have hzcl : IsClosed ({ν zk} : Set Z) := by
    rw [hP7, hp]; exact hz
  have s1 : ∀ (B C₀ : Type u) [CommRing B] [CommRing C₀] (f : B →+* C₀) (𝔭₀ : Ideal B) [𝔭₀.IsPrime] (Q₀ : Ideal C₀), (∀ P : Ideal B, P.IsPrime → P ≤ 𝔭₀ → P = 𝔭₀) → (∀ Q' : Ideal C₀, Q'.IsPrime → Q'.comap f = 𝔭₀ → Q' = Q₀) → (∀ c : C₀, ∃ (b t : B) (y : C₀), t ∉ 𝔭₀ ∧ y ∉ Q₀ ∧ y * (f t * c - f b) = 0) → ∀ c : C₀, ∃ t ∉ 𝔭₀, ∃ b : B, f t * c = f b := by
    intro B C₀ _ _ f 𝔭₀ h𝔭₀ Q₀ hmin huniq hS c
    obtain ⟨b, t, y, ht, hy, hyd⟩ := hS c
    have key : ∃ t' ∉ 𝔭₀, f t' * (f t * c - f b) = 0 := by
      by_contra hcon
      push_neg at hcon
      obtain ⟨Q', hQ'p, hJQ', hdisj⟩ := Ideal.exists_le_prime_disjoint
        (Ideal.span {f t * c - f b}).annihilator (Submonoid.map f 𝔭₀.primeCompl) (by
          rw [Set.disjoint_left]
          rintro z hzJ ⟨a, ha, rfl⟩
          rw [SetLike.mem_coe, Submodule.mem_annihilator_span_singleton, smul_eq_mul] at hzJ
          exact hcon a ha hzJ)
      have hle : Q'.comap f ≤ 𝔭₀ := by
        intro a ha
        by_contra hna
        exact Set.disjoint_left.mp hdisj ha ⟨a, hna, rfl⟩
      have heq : Q'.comap f = 𝔭₀ := hmin _ (Ideal.comap_isPrime f Q') hle
      have hQ : Q' = Q₀ := huniq Q' hQ'p heq
      apply hy
      rw [← hQ]
      apply hJQ'
      rw [Submodule.mem_annihilator_span_singleton, smul_eq_mul]
      exact hyd
    obtain ⟨t', ht', h0⟩ := key
    refine ⟨t' * t, fun hm => (h𝔭₀.mem_or_mem hm).elim ht' ht, t' * b, ?_⟩
    rw [map_mul, map_mul]
    linear_combination h0

  have s2 : ∀ (B C₀ : Type u) [CommRing B] [CommRing C₀] [Algebra B C₀] (𝔪 : Ideal B) [𝔪.IsPrime] (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime], (∀ c₀ : C₀, ∃ t : B, t ∉ Ideal.comap (algebraMap B (Localization.AtPrime 𝔪)) 𝔭 ∧ ∃ b : B, algebraMap B C₀ t * c₀ = algebraMap B C₀ b) → ∀ c : Localization (Algebra.algebraMapSubmonoid C₀ 𝔪.primeCompl), ∃ s ∉ 𝔭, ∃ b : Localization.AtPrime 𝔪, s • c = algebraMap (Localization.AtPrime 𝔪) (Localization (Algebra.algebraMapSubmonoid C₀ 𝔪.primeCompl)) b := by
    intro B C₀ _ _ _ 𝔪 _ 𝔭 _ hyp c
    obtain ⟨⟨c₀, y⟩, hcy⟩ := IsLocalization.surj (Algebra.algebraMapSubmonoid C₀ 𝔪.primeCompl) c
    obtain ⟨m, hm, hmy⟩ := y.2
    obtain ⟨t, ht, b₀, hb₀⟩ := hyp c₀
    refine ⟨algebraMap B _ t, ht, IsLocalization.mk' (Localization.AtPrime 𝔪) b₀ ⟨m, hm⟩, ?_⟩
    have hu : IsUnit (algebraMap C₀ (Localization (Algebra.algebraMapSubmonoid C₀ 𝔪.primeCompl))
        (y : C₀)) := IsLocalization.map_units _ y
    have htow : ∀ x : B, algebraMap (Localization.AtPrime 𝔪)
        (Localization (Algebra.algebraMapSubmonoid C₀ 𝔪.primeCompl)) (algebraMap B _ x) =
        algebraMap C₀ (Localization (Algebra.algebraMapSubmonoid C₀ 𝔪.primeCompl))
          (algebraMap B C₀ x) := by
      intro x
      rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
    have e1 : algebraMap C₀ (Localization (Algebra.algebraMapSubmonoid C₀ 𝔪.primeCompl)) (y : C₀) =
        algebraMap (Localization.AtPrime 𝔪)
          (Localization (Algebra.algebraMapSubmonoid C₀ 𝔪.primeCompl)) (algebraMap B _ m) := by
      rw [htow, hmy]
    have hspec : IsLocalization.mk' (Localization.AtPrime 𝔪) b₀
        (⟨m, hm⟩ : 𝔪.primeCompl) * algebraMap B _ m = algebraMap B _ b₀ :=
      IsLocalization.mk'_spec _ _ _
    simp only at hcy
    apply (hu.mul_left_inj).mp
    rw [Algebra.smul_def, htow t, mul_assoc, hcy, ← map_mul, hb₀, e1, ← map_mul, hspec, htow]

  have s4 : ∀ (Z S : Scheme.{u}) (ν : S ⟶ Z) (U : Z.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen (ν ⁻¹ᵁ U)) (Q : PrimeSpectrum Γ(S, ν ⁻¹ᵁ U)), hU.fromSpec (PrimeSpectrum.comap (ν.app U).hom Q) = ν (hV.fromSpec Q) := by
    intro Z S ν U hU hV Q
    have h := IsAffineOpen.SpecMap_appLE_fromSpec ν hU hV le_rfl
    rw [Scheme.Hom.appLE_eq_app] at h
    have h2 := congrArg (fun g => g Q) h
    simp only [Scheme.Hom.comp_apply, Spec.map_apply] at h2
    exact h2

  have s5 : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U) (x : X) (hx : x ∈ U), IsClosed ({x} : Set X) → (hU.primeIdealOf ⟨x, hx⟩).asIdeal.IsMaximal := by
    intro X U hU x hx hcl
    rw [← PrimeSpectrum.isClosed_singleton_iff_isMaximal]
    have hinj : Function.Injective hU.fromSpec := by
      haveI := hU.isOpenImmersion_fromSpec
      exact hU.fromSpec.isOpenEmbedding.injective
    have e : ({hU.primeIdealOf ⟨x, hx⟩} : Set _) = hU.fromSpec ⁻¹' {x} := by
      ext p
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact hU.fromSpec_primeIdealOf ⟨x, hx⟩
      · intro hp; apply hinj; rw [hp, hU.fromSpec_primeIdealOf]
    rw [e]
    exact hcl.preimage hU.fromSpec.continuous

  have s6 : ∀ (R : Type u) [CommRing R] (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), LocallyOfFiniteType u → ∀ (U : Z.Opens), IsAffineOpen U → (wcCnSigma u U).FiniteType := by
    intro R _ Z u hu U hU
    have hle : U ≤ u ⁻¹ᵁ ⊤ := fun x _ => trivial
    have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType u hu ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ hle
    have e : wcCnSigma u U = (u.appLE ⊤ U hle).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom := rfl
    rw [e]
    exact h1.comp (RingHom.FiniteType.of_surjective _
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of R)).inv).2)

  have s7 : ∀ (B : Type u) [CommRing B] (𝔪 : Ideal B) [𝔪.IsPrime], _root_.IsReduced (Localization.AtPrime 𝔪) → ∀ (𝔭 : Ideal (Localization.AtPrime 𝔪)) [𝔭.IsPrime], 𝔭 ∈ minimalPrimes (Localization.AtPrime 𝔪) → (∀ P : Ideal B, P.IsPrime → P ≤ Ideal.comap (algebraMap B (Localization.AtPrime 𝔪)) 𝔭 → P = Ideal.comap (algebraMap B (Localization.AtPrime 𝔪)) 𝔭) ∧ IsField (Localization.AtPrime (Ideal.comap (algebraMap B (Localization.AtPrime 𝔪)) 𝔭)) := by
    intro B _ 𝔪 _ hred 𝔭 h𝔭p h𝔭
    constructor
    · intro P hP hle
      have hdisj : Disjoint (𝔪.primeCompl : Set B) P := by
        rw [Set.disjoint_left]
        intro b hb hbP
        have h1 : algebraMap B (Localization.AtPrime 𝔪) b ∈ 𝔭 := hle hbP
        have hu : IsUnit (algebraMap B (Localization.AtPrime 𝔪) b) :=
          IsLocalization.map_units (Localization.AtPrime 𝔪) (⟨b, hb⟩ : 𝔪.primeCompl)
        exact h𝔭p.ne_top (Ideal.eq_top_of_isUnit_mem _ h1 hu)
      have hmp : (Ideal.map (algebraMap B (Localization.AtPrime 𝔪)) P).IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint 𝔪.primeCompl _ P hP hdisj
      have hcm : Ideal.comap (algebraMap B (Localization.AtPrime 𝔪))
          (Ideal.map (algebraMap B (Localization.AtPrime 𝔪)) P) = P :=
        IsLocalization.under_map_of_isPrime_disjoint 𝔪.primeCompl _ hP hdisj
      have hmle : Ideal.map (algebraMap B (Localization.AtPrime 𝔪)) P ≤ 𝔭 :=
        Ideal.map_le_iff_le_comap.mpr hle
      have h2 := h𝔭.2 ⟨hmp, bot_le⟩ hmle
      have heq : Ideal.map (algebraMap B (Localization.AtPrime 𝔪)) P = 𝔭 := le_antisymm hmle h2
      rw [← heq, hcm]
    · haveI : Ring.KrullDimLE 0 (Localization.AtPrime 𝔭) :=
        Ring.KrullDimLE.of_isLocalization 𝔭 h𝔭 _
      have hF : IsField (Localization.AtPrime 𝔭) := Ring.KrullDimLE.isField_of_isReduced
      haveI := IsLocalization.isLocalization_atPrime_localization_atPrime 𝔪.primeCompl 𝔭
      exact MulEquiv.isField hF (IsLocalization.algEquiv
        (Ideal.comap (algebraMap B (Localization.AtPrime 𝔪)) 𝔭).primeCompl
        (Localization.AtPrime (Ideal.comap (algebraMap B (Localization.AtPrime 𝔪)) 𝔭))
        (Localization.AtPrime 𝔭)).toMulEquiv

  have s8 : ∀ (C₀ : Type u) [CommRing C₀] (M : Submonoid C₀) (𝔫₀ : Ideal C₀) [𝔫₀.IsMaximal], Disjoint (M : Set C₀) (𝔫₀ : Set C₀) → ∀ (T : Type u) [CommRing T] [Algebra C₀ T] [IsLocalization.AtPrime T 𝔫₀], ∃ (𝔫 : Ideal (Localization M)) (_ : 𝔫.IsMaximal) (e : Localization.AtPrime 𝔫 ≃+* T), ∀ c : C₀, e (algebraMap (Localization M) (Localization.AtPrime 𝔫) (algebraMap C₀ (Localization M) c)) = algebraMap C₀ T c := by
    intro C₀ _ M 𝔫₀ h𝔫₀ hdisj T _ _ _
    have hp : (Ideal.map (algebraMap C₀ (Localization M)) 𝔫₀).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint M _ 𝔫₀ h𝔫₀.isPrime hdisj
    have hc : Ideal.comap (algebraMap C₀ (Localization M))
        (Ideal.map (algebraMap C₀ (Localization M)) 𝔫₀) = 𝔫₀ :=
      IsLocalization.under_map_of_isPrime_disjoint M _ h𝔫₀.isPrime hdisj
    have hmax : (Ideal.map (algebraMap C₀ (Localization M)) 𝔫₀).IsMaximal := by
      obtain ⟨J, hJ, hle⟩ := Ideal.exists_le_maximal _ hp.ne_top
      have h1 : Ideal.comap (algebraMap C₀ (Localization M)) J = 𝔫₀ := by
        have h2 : 𝔫₀ ≤ Ideal.comap (algebraMap C₀ (Localization M)) J := by
          rw [← hc]; exact Ideal.comap_mono hle
        exact (h𝔫₀.eq_of_le (Ideal.comap_ne_top _ hJ.ne_top) h2).symm
      have h3 : J = Ideal.map (algebraMap C₀ (Localization M)) 𝔫₀ := by
        rw [← IsLocalization.map_under M (Localization M) J]
        show Ideal.map _ (Ideal.comap _ J) = _
        rw [h1]
      rw [← h3]; exact hJ
    refine ⟨_, hmax, ?_⟩
    have h1 := IsLocalization.isLocalization_atPrime_localization_atPrime M
      (Ideal.map (algebraMap C₀ (Localization M)) 𝔫₀)
    have h2 : (Ideal.comap (algebraMap C₀ (Localization M))
        (Ideal.map (algebraMap C₀ (Localization M)) 𝔫₀)).primeCompl = 𝔫₀.primeCompl := by
      ext x
      rw [Ideal.mem_primeCompl_iff, Ideal.mem_primeCompl_iff, hc]
    have h1' : IsLocalization (Ideal.comap (algebraMap C₀ (Localization M))
        (Ideal.map (algebraMap C₀ (Localization M)) 𝔫₀)).primeCompl
        (Localization.AtPrime (Ideal.map (algebraMap C₀ (Localization M)) 𝔫₀)) := h1
    rw [h2] at h1'
    haveI : IsLocalization 𝔫₀.primeCompl
        (Localization.AtPrime (Ideal.map (algebraMap C₀ (Localization M)) 𝔫₀)) := h1'
    refine ⟨(IsLocalization.algEquiv 𝔫₀.primeCompl _ T).toRingEquiv, fun c => ?_⟩
    rw [← IsScalarTower.algebraMap_apply]
    exact (IsLocalization.algEquiv 𝔫₀.primeCompl _ T).commutes c

  have s9 : ∀ (S : Scheme.{u}) (V : S.Opens), IsAffineOpen V → (∀ x : S, IsDomain (S.presheaf.stalk x) ∧ IsIntegrallyClosed (S.presheaf.stalk x)) → ∀ (M : Submonoid Γ(S, V)) (P : Ideal (Localization M)) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P) := by
    intro S V hV hS M P _
    haveI := IsLocalization.isLocalization_atPrime_localization_atPrime M P
    have hy : hV.fromSpec ⟨Ideal.comap (algebraMap Γ(S, V) (Localization M)) P, inferInstance⟩ ∈ V := by
      show _ ∈ (V : Set S)
      rw [← hV.range_fromSpec]; exact ⟨_, rfl⟩
    letI : Algebra Γ(S, V) (S.presheaf.stalk
        (hV.fromSpec ⟨Ideal.comap (algebraMap Γ(S, V) (Localization M)) P, inferInstance⟩)) :=
      TopCat.Presheaf.algebra_section_stalk S.presheaf ⟨_, hy⟩
    haveI : IsLocalization (Ideal.comap (algebraMap Γ(S, V) (Localization M)) P).primeCompl
        (S.presheaf.stalk
          (hV.fromSpec ⟨Ideal.comap (algebraMap Γ(S, V) (Localization M)) P, inferInstance⟩)) :=
      hV.isLocalization_stalk' _ hy
    let e := IsLocalization.algEquiv (Ideal.comap (algebraMap Γ(S, V) (Localization M)) P).primeCompl
      (Localization.AtPrime P) (S.presheaf.stalk
        (hV.fromSpec ⟨Ideal.comap (algebraMap Γ(S, V) (Localization M)) P, inferInstance⟩))
    obtain ⟨hd, hi⟩ := hS (hV.fromSpec ⟨Ideal.comap (algebraMap Γ(S, V) (Localization M)) P, inferInstance⟩)
    exact ⟨MulEquiv.isDomain _ e.toMulEquiv, IsIntegrallyClosed.of_equiv e.symm.toRingEquiv⟩

  have s3 : ∀ (Z S : Scheme.{u}) (ν : S ⟶ Z) (U : Z.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen (ν ⁻¹ᵁ U)), (∀ x : Z, IsDomain (Z.presheaf.stalk x) → IsIntegrallyClosed (Z.presheaf.stalk x) → ∃ w : S, (∀ w' : S, ν w' = x ↔ w' = w) ∧ IsIso (ν.stalkMap w)) → ∀ (𝔭₀ : Ideal Γ(Z, U)) [𝔭₀.IsPrime], IsField (Localization.AtPrime 𝔭₀) → ∃ Q₀ : Ideal Γ(S, ν ⁻¹ᵁ U), Q₀.IsPrime ∧ (∀ Q' : Ideal Γ(S, ν ⁻¹ᵁ U), Q'.IsPrime → Q'.comap (ν.app U).hom = 𝔭₀ → Q' = Q₀) ∧ ∀ c : Γ(S, ν ⁻¹ᵁ U), ∃ (b t : Γ(Z, U)) (y : Γ(S, ν ⁻¹ᵁ U)), t ∉ 𝔭₀ ∧ y ∉ Q₀ ∧ y * ((ν.app U).hom t * c - (ν.app U).hom b) = 0 := by
    intro Z S ν U hU hV P12 𝔭₀ h𝔭₀ hF
    have hinjU : Function.Injective hU.fromSpec := by
      haveI := hU.isOpenImmersion_fromSpec
      exact hU.fromSpec.isOpenEmbedding.injective
    have hinjV : Function.Injective hV.fromSpec := by
      haveI := hV.isOpenImmersion_fromSpec
      exact hV.fromSpec.isOpenEmbedding.injective
    have hηU : hU.fromSpec ⟨𝔭₀, h𝔭₀⟩ ∈ U := by
      show _ ∈ (U : Set Z)
      rw [← hU.range_fromSpec]; exact ⟨_, rfl⟩
    letI : Algebra Γ(Z, U) (Z.presheaf.stalk (hU.fromSpec ⟨𝔭₀, h𝔭₀⟩)) :=
      TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨_, hηU⟩
    haveI : IsLocalization 𝔭₀.primeCompl (Z.presheaf.stalk (hU.fromSpec ⟨𝔭₀, h𝔭₀⟩)) :=
      hU.isLocalization_stalk' ⟨𝔭₀, h𝔭₀⟩ hηU
    let eη := IsLocalization.algEquiv 𝔭₀.primeCompl (Localization.AtPrime 𝔭₀)
      (Z.presheaf.stalk (hU.fromSpec ⟨𝔭₀, h𝔭₀⟩))
    have hFη : IsField (Z.presheaf.stalk (hU.fromSpec ⟨𝔭₀, h𝔭₀⟩)) :=
      MulEquiv.isField hF eη.symm.toMulEquiv
    have hdη : IsDomain (Z.presheaf.stalk (hU.fromSpec ⟨𝔭₀, h𝔭₀⟩)) := hFη.isDomain
    have hiη : IsIntegrallyClosed (Z.presheaf.stalk (hU.fromSpec ⟨𝔭₀, h𝔭₀⟩)) := by
      letI := hFη.toField; infer_instance
    obtain ⟨w, hiff, hiso⟩ := P12 _ hdη hiη
    have hνw : ν w = hU.fromSpec ⟨𝔭₀, h𝔭₀⟩ := (hiff w).2 rfl
    have hwV : w ∈ ν ⁻¹ᵁ U := by
      show ν w ∈ U
      rw [hνw]; exact hηU
    refine ⟨(hV.primeIdealOf ⟨w, hwV⟩).asIdeal, inferInstance, ?_, ?_⟩
    · intro Q' hQ' hcomap
      have h1 := s4 Z S ν U hU hV ⟨Q', hQ'⟩
      have h2 : PrimeSpectrum.comap (ν.app U).hom ⟨Q', hQ'⟩ = ⟨𝔭₀, h𝔭₀⟩ := PrimeSpectrum.ext hcomap
      rw [h2] at h1
      have h3 : hV.fromSpec ⟨Q', hQ'⟩ = w := (hiff _).1 h1.symm
      have h4 : (⟨Q', hQ'⟩ : PrimeSpectrum _) = hV.primeIdealOf ⟨w, hwV⟩ := by
        apply hinjV; rw [h3, hV.fromSpec_primeIdealOf]
      exact congrArg PrimeSpectrum.asIdeal h4
    · intro c
      have hνwU : ν w ∈ U := hwV
      letI : Algebra Γ(Z, U) (Z.presheaf.stalk (ν w)) :=
        TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨_, hνwU⟩
      haveI hlocZ := hU.isLocalization_stalk ⟨ν w, hνwU⟩
      have hpe : hU.primeIdealOf ⟨ν w, hνwU⟩ = ⟨𝔭₀, h𝔭₀⟩ := by
        apply hinjU; rw [hU.fromSpec_primeIdealOf]; exact hνw
      letI : Algebra Γ(S, ν ⁻¹ᵁ U) (S.presheaf.stalk w) :=
        TopCat.Presheaf.algebra_section_stalk S.presheaf ⟨_, hwV⟩
      haveI hlocS := hV.isLocalization_stalk ⟨w, hwV⟩
      obtain ⟨x, hx⟩ := (ConcreteCategory.bijective_of_isIso (ν.stalkMap w)).2
        ((S.presheaf.germ (ν ⁻¹ᵁ U) w hwV).hom c)
      obtain ⟨⟨b, ⟨t, ht⟩⟩, hbt⟩ := IsLocalization.surj (hU.primeIdealOf ⟨ν w, hνwU⟩).asIdeal.primeCompl x
      change x * (Z.presheaf.germ U (ν w) hνwU).hom t = (Z.presheaf.germ U (ν w) hνwU).hom b at hbt
      have hbt' := congrArg (ν.stalkMap w).hom hbt
      rw [map_mul] at hbt'
      erw [hx, Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.germ_stalkMap_apply] at hbt'
      have h0 : algebraMap Γ(S, ν ⁻¹ᵁ U) (S.presheaf.stalk w)
          ((ν.app U).hom t * c - (ν.app U).hom b) = 0 := by
        change (S.presheaf.germ (ν ⁻¹ᵁ U) w hwV).hom ((ν.app U).hom t * c - (ν.app U).hom b) = 0
        rw [map_sub, map_mul, mul_comm]
        erw [hbt']
        exact sub_self _
      obtain ⟨⟨m, hm⟩, hm0⟩ :=
        (IsLocalization.map_eq_zero_iff (hV.primeIdealOf ⟨w, hwV⟩).asIdeal.primeCompl _ _).mp h0
      refine ⟨b, t, m, ?_, hm, hm0⟩
      rw [hpe] at ht
      exact ht

  have glue : ∀ (R : Type u) [CommRing R] (Z S : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (ν : S ⟶ Z) (zk : S),
      LocallyOfFiniteType u → IsFinite ν →
      (∀ x : S, IsDomain (S.presheaf.stalk x) ∧ IsIntegrallyClosed (S.presheaf.stalk x)) →
      (∀ x : Z, IsDomain (Z.presheaf.stalk x) → IsIntegrallyClosed (Z.presheaf.stalk x) → ∃ w : S, (∀ w' : S, ν w' = x ↔ w' = w) ∧ IsIso (ν.stalkMap w)) →
      IsClosed ({ν zk} : Set Z) → _root_.IsReduced (Z.presheaf.stalk (ν zk)) →
      ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B) (_ : Algebra.FiniteType R B) (𝔪 : Ideal B) (_ : 𝔪.IsMaximal) (C : Type u) (_ : CommRing C) (_ : Algebra (Localization.AtPrime 𝔪) C) (_ : Module.Finite (Localization.AtPrime 𝔪) C) (𝔫 : Ideal C) (_ : 𝔫.IsMaximal) (eO : Localization.AtPrime 𝔪 ≃+* Z.presheaf.stalk (ν zk)) (eS : Localization.AtPrime 𝔫 ≃+* S.presheaf.stalk zk), eO.toRingHom.comp (algebraMap R (Localization.AtPrime 𝔪)) = (Z.presheaf.germ ⊤ (ν zk) trivial).hom.comp (wcCnSigma u ⊤) ∧ eS.toRingHom.comp ((algebraMap C (Localization.AtPrime 𝔫)).comp (algebraMap (Localization.AtPrime 𝔪) C)) = (ν.stalkMap zk).hom.comp eO.toRingHom ∧ (∀ (P : Ideal C) [P.IsPrime], IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P)) ∧ ∀ 𝔭 ∈ minimalPrimes (Localization.AtPrime 𝔪), ∀ c : C, ∃ s ∉ 𝔭, ∃ b, s • c = algebraMap (Localization.AtPrime 𝔪) C b := by
    intro R _ Z S u ν zk hlft hfin hP3 hP12 hzcl hOred
    haveI := hfin
    obtain ⟨U, hU, hzU, -⟩ := exists_isAffineOpen_mem_and_subset (x := ν zk) (U := ⊤) trivial
    have hV : IsAffineOpen (ν ⁻¹ᵁ U) := IsAffineHom.isAffine_preimage U hU
    have hzkV : zk ∈ ν ⁻¹ᵁ U := hzU
    have hinjU : Function.Injective hU.fromSpec := by
      haveI := hU.isOpenImmersion_fromSpec
      exact hU.fromSpec.isOpenEmbedding.injective
    letI iRB : Algebra R Γ(Z, U) := (wcCnSigma u U).toAlgebra
    letI iBC : Algebra Γ(Z, U) Γ(S, ν ⁻¹ᵁ U) := (ν.app U).hom.toAlgebra
    haveI hBCfin : Module.Finite Γ(Z, U) Γ(S, ν ⁻¹ᵁ U) := IsFinite.finite_app ν U hU
    have h𝔪 : (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal.IsMaximal := s5 Z U hU (ν zk) hzU hzcl
    letI iO : Algebra Γ(Z, U) (Z.presheaf.stalk (ν zk)) :=
      TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨_, hzU⟩
    haveI hlocO : IsLocalization.AtPrime (Z.presheaf.stalk (ν zk))
        (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal := hU.isLocalization_stalk ⟨ν zk, hzU⟩
    let eOa := IsLocalization.algEquiv (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal.primeCompl
      (Localization.AtPrime (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal) (Z.presheaf.stalk (ν zk))
    have hcomap : (hV.primeIdealOf ⟨zk, hzkV⟩).asIdeal.comap (algebraMap Γ(Z, U) Γ(S, ν ⁻¹ᵁ U)) =
        (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal := by
      have h1 := s4 Z S ν U hU hV (hV.primeIdealOf ⟨zk, hzkV⟩)
      rw [hV.fromSpec_primeIdealOf] at h1
      have h2 : PrimeSpectrum.comap (ν.app U).hom (hV.primeIdealOf ⟨zk, hzkV⟩) =
          hU.primeIdealOf ⟨ν zk, hzU⟩ := hinjU (by rw [h1, hU.fromSpec_primeIdealOf])
      exact congrArg PrimeSpectrum.asIdeal h2
    have h𝔫₀ : (hV.primeIdealOf ⟨zk, hzkV⟩).asIdeal.IsMaximal :=
      Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap Γ(Z, U) Γ(S, ν ⁻¹ᵁ U))
        (fun x => Algebra.IsIntegral.isIntegral x) _ (by rw [hcomap]; exact h𝔪)
    have hdisj : Disjoint ((Algebra.algebraMapSubmonoid Γ(S, ν ⁻¹ᵁ U)
        (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal.primeCompl : Submonoid _) : Set Γ(S, ν ⁻¹ᵁ U))
        ((hV.primeIdealOf ⟨zk, hzkV⟩).asIdeal : Set Γ(S, ν ⁻¹ᵁ U)) := by
      rw [Set.disjoint_left]
      rintro y ⟨m, hm, rfl⟩ hy
      apply hm
      rw [← hcomap]; exact hy
    letI iS : Algebra Γ(S, ν ⁻¹ᵁ U) (S.presheaf.stalk zk) :=
      TopCat.Presheaf.algebra_section_stalk S.presheaf ⟨_, hzkV⟩
    haveI hlocS : IsLocalization.AtPrime (S.presheaf.stalk zk) (hV.primeIdealOf ⟨zk, hzkV⟩).asIdeal :=
      hV.isLocalization_stalk ⟨zk, hzkV⟩
    obtain ⟨𝔫, h𝔫, eS, hE2⟩ := s8 Γ(S, ν ⁻¹ᵁ U) (Algebra.algebraMapSubmonoid Γ(S, ν ⁻¹ᵁ U)
        (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal.primeCompl) _ hdisj (S.presheaf.stalk zk)
    have htowC : ∀ b : Γ(Z, U), algebraMap (Localization.AtPrime (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal)
        (Localization (Algebra.algebraMapSubmonoid Γ(S, ν ⁻¹ᵁ U)
          (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal.primeCompl))
        (algebraMap Γ(Z, U) (Localization.AtPrime (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal) b) =
        algebraMap Γ(S, ν ⁻¹ᵁ U) (Localization (Algebra.algebraMapSubmonoid Γ(S, ν ⁻¹ᵁ U)
          (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal.primeCompl)) (algebraMap Γ(Z, U) Γ(S, ν ⁻¹ᵁ U) b) := by
      intro b
      rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
    refine ⟨Γ(Z, U), inferInstance, iRB, s6 R Z u hlft U hU, _, h𝔪,
      Localization (Algebra.algebraMapSubmonoid Γ(S, ν ⁻¹ᵁ U)
        (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal.primeCompl), inferInstance, inferInstance,
      inferInstance, 𝔫, h𝔫, eOa.toRingEquiv, eS, ?_, ?_, ?_, ?_⟩
    · apply RingHom.ext; intro r
      show eOa (algebraMap R (Localization.AtPrime (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal) r) =
        (Z.presheaf.germ ⊤ (ν zk) trivial).hom (wcCnSigma u ⊤ r)
      rw [IsScalarTower.algebraMap_apply R Γ(Z, U)
        (Localization.AtPrime (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal), AlgEquiv.commutes]
      have k1 : ∀ (V : Z.Opens) (hV : ν zk ∈ V) (y : Γ(Z, ⊤)),
          (Z.presheaf.germ V (ν zk) hV).hom ((Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom y) =
          (Z.presheaf.germ ⊤ (ν zk) trivial).hom y :=
        fun V hV y => Z.presheaf.germ_res_apply (homOfLE le_top) (ν zk) hV y
      exact (k1 U hzU _).trans (k1 ⊤ trivial _).symm
    · apply IsLocalization.ringHom_ext (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal.primeCompl
      apply RingHom.ext; intro b
      show eS (algebraMap (Localization (Algebra.algebraMapSubmonoid Γ(S, ν ⁻¹ᵁ U)
          (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal.primeCompl)) (Localization.AtPrime 𝔫) (algebraMap
        (Localization.AtPrime (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal)
        (Localization (Algebra.algebraMapSubmonoid Γ(S, ν ⁻¹ᵁ U)
          (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal.primeCompl))
        (algebraMap Γ(Z, U) (Localization.AtPrime (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal) b))) =
        (ν.stalkMap zk).hom (eOa (algebraMap Γ(Z, U) _ b))
      rw [htowC b, hE2, AlgEquiv.commutes]
      exact (Scheme.Hom.germ_stalkMap_apply ν U zk hzU b).symm
    · intro P _
      exact s9 S (ν ⁻¹ᵁ U) hV hP3 _ P
    · intro 𝔭 h𝔭 c
      haveI : 𝔭.IsPrime := h𝔭.1.1
      haveI : _root_.IsReduced (Localization.AtPrime (hU.primeIdealOf ⟨ν zk, hzU⟩).asIdeal) :=
        isReduced_of_injective eOa eOa.injective
      obtain ⟨hmin, hfield⟩ := s7 Γ(Z, U) _ inferInstance 𝔭 h𝔭
      obtain ⟨Q₀, -, hU', hS'⟩ := s3 Z S ν U hU hV hP12 _ hfield
      have hcore := s1 Γ(Z, U) Γ(S, ν ⁻¹ᵁ U) (ν.app U).hom _ Q₀ hmin hU' hS'
      exact s2 Γ(Z, U) Γ(S, ν ⁻¹ᵁ U) _ 𝔭 (fun c₀ => by
        obtain ⟨t, ht, b, hb⟩ := hcore c₀
        exact ⟨t, ht, b, hb⟩) c
  exact glue R Z S u ν zk inferInstance hνfin hP3 hP12 hzcl hOred

theorem nccwffnz_cf_evalₐ_compat : ∀ (R : Type u) [CommRing R] (I : Ideal R) (x : AdicCompletion I R) (m n : ℕ) (y : R), m ≤ n → AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) y → AdicCompletion.evalₐ I m x = Ideal.Quotient.mk (I ^ m) y :=
by
  intro R _ I x m n y hmn h
  obtain ⟨f, rfl⟩ : ∃ f, AdicCompletion.mk I R f = x :=
    AdicCompletion.induction_on (p := fun x => ∃ f, AdicCompletion.mk I R f = x) I R x
      (fun f => ⟨f, rfl⟩)
  rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq] at h
  rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq]
  have h₂ : f n - y ∈ I ^ m := Ideal.pow_le_pow_right hmn h
  have h₃ : f n - f m ∈ I ^ m := by
    have hc := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn f
    rw [Submodule.Quotient.eq] at hc
    have hle : (I ^ m • (⊤ : Submodule R R)) ≤ I ^ m :=
      Submodule.smul_le.mpr (fun r hr s _ => by
        rw [smul_eq_mul]; exact Ideal.mul_mem_right s _ hr)
    exact hle hc
  have h₄ := Ideal.sub_mem _ h₂ h₃
  rwa [sub_sub_sub_cancel_left] at h₄

theorem nccwffnz_cf_tensor_levels : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A) (C : Type u) [CommRing C] [Algebra A C] [Module.Finite A C], ∃ φ : ∀ n : ℕ, TensorProduct A (AdicCompletion I A) C →+* C ⧸ (Ideal.map (algebraMap A C) I ^ n), (∀ (n : ℕ) (a : AdicCompletion I A) (a₀ : A) (c : C), AdicCompletion.evalₐ I n a = Ideal.Quotient.mk (I ^ n) a₀ → φ n (TensorProduct.tmul A a c) = Ideal.Quotient.mk (Ideal.map (algebraMap A C) I ^ n) (algebraMap A C a₀ * c)) ∧ (∀ (m n : ℕ) (d : TensorProduct A (AdicCompletion I A) C) (z : C), m ≤ n → φ n d = Ideal.Quotient.mk (Ideal.map (algebraMap A C) I ^ n) z → φ m d = Ideal.Quotient.mk (Ideal.map (algebraMap A C) I ^ m) z) ∧ (∀ d : TensorProduct A (AdicCompletion I A) C, (∀ n, φ n d = 0) → d = 0) ∧ ∀ z : ℕ → C, (∀ n, z (n + 1) - z n ∈ Ideal.map (algebraMap A C) I ^ n) → ∃ d : TensorProduct A (AdicCompletion I A) C, ∀ n, φ n d = Ideal.Quotient.mk (Ideal.map (algebraMap A C) I ^ n) (z n) :=
by
  intro A _ _ I C _ _ _
  classical
  have hcomap : ∀ n : ℕ, I ^ n ≤ Ideal.comap (Algebra.ofId A C) (Ideal.map (algebraMap A C) I ^ n) := by
    intro n x hx
    rw [Ideal.mem_comap, Algebra.ofId_apply, ← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hx
  let φ : ∀ n : ℕ, TensorProduct A (AdicCompletion I A) C →+* C ⧸ (Ideal.map (algebraMap A C) I ^ n) :=
    fun n => (Algebra.TensorProduct.productMap
      ((Ideal.quotientMapₐ (Ideal.map (algebraMap A C) I ^ n) (Algebra.ofId A C) (hcomap n)).comp
        (AdicCompletion.evalₐ I n))
      (Ideal.Quotient.mkₐ A (Ideal.map (algebraMap A C) I ^ n))).toRingHom
  have hφ1 : ∀ (n : ℕ) (a : AdicCompletion I A) (a₀ : A) (c : C),
      AdicCompletion.evalₐ I n a = Ideal.Quotient.mk (I ^ n) a₀ →
      φ n (TensorProduct.tmul A a c) =
        Ideal.Quotient.mk (Ideal.map (algebraMap A C) I ^ n) (algebraMap A C a₀ * c) := by
    intro n a a₀ c h
    show Algebra.TensorProduct.productMap _ _ (TensorProduct.tmul A a c) = _
    rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.comp_apply, h, Ideal.quotient_map_mkₐ]
    simp only [Ideal.Quotient.mkₐ_eq_mk, Algebra.ofId_apply, map_mul]

  have hE : ∀ n : ℕ, I ^ n • (⊤ : Submodule A C) =
      (Ideal.map (algebraMap A C) I ^ n).restrictScalars A := by
    intro n
    rw [Ideal.smul_top_eq_map, Ideal.map_pow]
  let θ : ∀ n : ℕ, (C ⧸ (I ^ n • (⊤ : Submodule A C))) →+ (C ⧸ (Ideal.map (algebraMap A C) I ^ n)) :=
    fun n => ((Submodule.quotEquivOfEq _ _ (hE n)).trans
      (Submodule.Quotient.restrictScalarsEquiv A (Ideal.map (algebraMap A C) I ^ n))).toAddEquiv.toAddMonoidHom
  have hθinj : ∀ n, Function.Injective (θ n) := fun n =>
    ((Submodule.quotEquivOfEq _ _ (hE n)).trans
      (Submodule.Quotient.restrictScalarsEquiv A (Ideal.map (algebraMap A C) I ^ n))).injective
  have hθmk : ∀ (n : ℕ) (x : C), θ n (Submodule.Quotient.mk x) =
      Ideal.Quotient.mk (Ideal.map (algebraMap A C) I ^ n) x := by
    intro n x
    show (Submodule.Quotient.restrictScalarsEquiv A (Ideal.map (algebraMap A C) I ^ n))
      ((Submodule.quotEquivOfEq _ _ (hE n)) (Submodule.Quotient.mk x)) = _
    rw [Submodule.quotEquivOfEq_mk, Submodule.Quotient.restrictScalarsEquiv_mk]
    rfl

  have hcomp : ∀ (n : ℕ) (d : TensorProduct A (AdicCompletion I A) C),
      θ n ((AdicCompletion.ofTensorProduct I C d).val n) = φ n d := by
    intro n d
    induction d using TensorProduct.induction_on with
    | zero => rw [map_zero, AdicCompletion.val_zero_apply, map_zero, map_zero]
    | tmul a c =>
      obtain ⟨a₀, ha₀⟩ := Submodule.Quotient.mk_surjective _ (a.val n)
      have hle : I ^ n • (⊤ : Submodule A A) ≤ I ^ n := by
        rw [Ideal.smul_eq_mul, Ideal.mul_top]
      have hev : AdicCompletion.evalₐ I n a = Ideal.Quotient.mk (I ^ n) a₀ := by
        rw [← AdicCompletion.factor_eval_eq_evalₐ I a hle, AdicCompletion.eval_apply, ← ha₀]
        exact Submodule.factor_mk hle a₀
      rw [hφ1 n a a₀ c hev, AdicCompletion.ofTensorProduct_tmul, AdicCompletion.smul_eval,
        AdicCompletion.of_apply, Submodule.mkQ_apply, ← ha₀]
      rw [show (Submodule.Quotient.mk a₀ : A ⧸ I ^ n • (⊤ : Submodule A A)) =
          Ideal.Quotient.mk (I ^ n • ⊤) a₀ from rfl, AdicCompletion.mk_smul_mk,
        ← Submodule.Quotient.mk_smul, hθmk, Algebra.smul_def]
    | add x y hx hy =>
      rw [map_add, AdicCompletion.val_add_apply, map_add, map_add, hx, hy]

  have s7 : ∀ (x : AdicCompletion I A) (m n : ℕ) (y : A), m ≤ n →
      AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) y →
      AdicCompletion.evalₐ I m x = Ideal.Quotient.mk (I ^ m) y := by
    intro x m n y hmn h
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq] at h ⊢
    have h2 := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn f
    rw [Submodule.Quotient.eq, Ideal.smul_eq_mul, Ideal.mul_top] at h2
    have h3 := Ideal.sub_mem _ (Ideal.pow_le_pow_right hmn h) h2
    rwa [sub_sub_sub_cancel_left] at h3
  have hbij := AdicCompletion.ofTensorProduct_bijective_of_finite_of_isNoetherian I C
  refine ⟨φ, hφ1, ?_, ?_, ?_⟩
  ·
    intro m n d z hmn hd
    have key : ∀ d : TensorProduct A (AdicCompletion I A) C, ∃ w : C,
        φ n d = Ideal.Quotient.mk (Ideal.map (algebraMap A C) I ^ n) w ∧
        φ m d = Ideal.Quotient.mk (Ideal.map (algebraMap A C) I ^ m) w := by
      intro d
      induction d using TensorProduct.induction_on with
      | zero => exact ⟨0, by rw [map_zero, map_zero], by rw [map_zero, map_zero]⟩
      | tmul a c =>
        obtain ⟨a₀, ha₀⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n a)
        exact ⟨algebraMap A C a₀ * c, hφ1 n a a₀ c ha₀.symm,
          hφ1 m a a₀ c (s7 a m n a₀ hmn ha₀.symm)⟩
      | add x y hx hy =>
        obtain ⟨w₁, h₁, h₁'⟩ := hx
        obtain ⟨w₂, h₂, h₂'⟩ := hy
        exact ⟨w₁ + w₂, by rw [map_add, h₁, h₂, map_add], by rw [map_add, h₁', h₂', map_add]⟩
    obtain ⟨w, hw, hw'⟩ := key d
    rw [hw', Ideal.Quotient.eq]
    rw [hw, Ideal.Quotient.eq] at hd
    exact Ideal.pow_le_pow_right hmn hd
  ·
    intro d hd
    apply hbij.1
    rw [map_zero]
    apply AdicCompletion.ext
    intro n
    rw [AdicCompletion.val_zero_apply]
    apply hθinj n
    rw [hcomp, hd, map_zero]
  ·
    intro z hz
    have hc : ∀ n, z n ≡ z (n + 1) [SMOD (I ^ n • (⊤ : Submodule A C))] := by
      intro n
      rw [SModEq.sub_mem, hE n, Submodule.restrictScalars_mem]
      have := Submodule.neg_mem _ (hz n)
      rwa [neg_sub] at this
    obtain ⟨d, hd⟩ := hbij.2 (AdicCompletion.mk I C (AdicCompletion.AdicCauchySequence.mk I C z hc))
    refine ⟨d, fun n => ?_⟩
    rw [← hcomp, hd, AdicCompletion.mk_apply_coe, AdicCompletion.AdicCauchySequence.mk_coe,
      Submodule.mkQ_apply, hθmk]

theorem nccwffnz_cf_sep_elem : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (C : Type u) [CommRing C] [Algebra A C] [Module.Finite A C] (𝔫 : Ideal C) [𝔫.IsMaximal], Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) ≤ 𝔫 ∧ ∃ (e : C) (N : ℕ), 1 ≤ N ∧ 1 - e ∈ 𝔫 ∧ (∀ P : Ideal C, P.IsMaximal → P ≠ 𝔫 → e ∈ P) ∧ (e * e - e) ^ N ∈ Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) ∧ ∀ n : ℕ, ∀ y ∈ 𝔫 ^ (N * n), e ^ (N * n) * y ∈ Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) ^ n :=
by
  intro A _ _ _ C _ _ _ 𝔫 _
  classical
  have hI : (algebraMap A C).IsIntegral :=
    algebraMap_isIntegral_iff.mpr (Algebra.IsIntegral.of_finite A C)
  have h1 : ∀ P : Ideal C, P.IsMaximal →
      Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) ≤ P := by
    intro P hP
    have hc : (P.comap (algebraMap A C)).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A C) hI P
    have := IsLocalRing.eq_maximalIdeal hc
    rw [Ideal.map_le_iff_le_comap, this]
  have h2 : ∀ Q : Ideal C, Q.IsPrime →
      Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) ≤ Q → Q.IsMaximal := by
    intro Q hQ hJQ
    have hle := Ideal.map_le_iff_le_comap.mp hJQ
    have hne : Q.comap (algebraMap A C) ≠ ⊤ := Ideal.comap_ne_top _ hQ.ne_top
    have heq := Ideal.IsMaximal.eq_of_le (IsLocalRing.maximalIdeal.isMaximal A) hne hle
    have hcm : (Q.comap (algebraMap A C)).IsMaximal := heq ▸ IsLocalRing.maximalIdeal.isMaximal A
    exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap A C) hI Q hcm
  have hfin : {P : Ideal C | P.IsMaximal}.Finite := by
    letI := Ideal.Quotient.field (IsLocalRing.maximalIdeal A)
    haveI : Module.Finite (A ⧸ IsLocalRing.maximalIdeal A)
        (C ⧸ Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A)) :=
      Module.Finite.of_restrictScalars_finite A (A ⧸ IsLocalRing.maximalIdeal A)
        (C ⧸ Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A))
    haveI : IsArtinianRing (C ⧸ Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A)) :=
      IsArtinianRing.of_finite (A ⧸ IsLocalRing.maximalIdeal A)
        (C ⧸ Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A))
    have hA := IsArtinianRing.setOfPred_isMaximal_finite
      (C ⧸ Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A))
    have hcm : ∀ P : Ideal C, Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) ≤ P →
        (P.map (Ideal.Quotient.mk (Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A)))).comap
          (Ideal.Quotient.mk (Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A))) = P := by
      intro P hP
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact sup_eq_left.mpr hP
    refine Set.Finite.of_finite_image
      (f := Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A))))
      (hA.subset ?_) ?_
    · rintro _ ⟨P, hP, rfl⟩
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective
          (Ideal.Quotient.mk (Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A)))
          Ideal.Quotient.mk_surjective hP with h | h
      · exfalso
        apply hP.ne_top
        rw [← hcm P (h1 P hP), h, Ideal.comap_top]
      · exact h
    · intro P hP P' hP' h
      rw [← hcm P (h1 P hP), ← hcm P' (h1 P' hP')]
      exact congrArg _ h
  have hcrt : ∃ e : C, 1 - e ∈ 𝔫 ∧ ∀ P : Ideal C, P.IsMaximal → P ≠ 𝔫 → e ∈ P := by
    have hz : ∀ P : Ideal C, P.IsMaximal → P ≠ 𝔫 → ∃ z, z ∈ P ∧ 1 - z ∈ 𝔫 := by
      intro P hP hne
      have hcop : 𝔫 ⊔ P = ⊤ := Ideal.IsMaximal.coprime_of_ne ‹_› hP hne.symm
      have h1m : (1 : C) ∈ 𝔫 ⊔ P := hcop ▸ Submodule.mem_top
      obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp h1m
      refine ⟨z, hz, ?_⟩
      have : 1 - z = y := by rw [← hyz]; ring
      rw [this]; exact hy
    choose! a ha using hz
    refine ⟨∏ P ∈ hfin.toFinset.filter (· ≠ 𝔫), a P, ?_, ?_⟩
    · rw [← Ideal.Quotient.eq, map_prod, map_one, eq_comm]
      apply Finset.prod_eq_one
      intro P hP
      rw [Finset.mem_filter, Set.Finite.mem_toFinset] at hP
      have h1a := (ha P hP.1 hP.2).2
      rw [← map_one (Ideal.Quotient.mk 𝔫)]
      exact (Ideal.Quotient.eq.mpr h1a).symm
    · intro P hP hne
      have hPS : P ∈ hfin.toFinset.filter (· ≠ 𝔫) := by
        rw [Finset.mem_filter, Set.Finite.mem_toFinset]
        exact ⟨hP, hne⟩
      rw [← Finset.mul_prod_erase _ a hPS]
      exact P.mul_mem_right _ (ha P hP hne).1
  obtain ⟨e, he1, heP⟩ := hcrt
  have hrad : ∀ y ∈ 𝔫, e * y ∈
      (Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A)).radical := by
    intro y hy
    rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
    rintro Q ⟨hJQ, hQ⟩
    have hQm := h2 Q hQ hJQ
    by_cases hQn : Q = 𝔫
    · rw [hQn]; exact 𝔫.mul_mem_left e hy
    · exact Ideal.mul_mem_right y Q (heP Q hQm hQn)
  haveI : IsNoetherianRing C := IsNoetherianRing.of_finite A C
  have hK : Ideal.span {e} * 𝔫 ≤
      (Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A)).radical := by
    apply Ideal.mul_le.mpr
    intro r hr s hs
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hr
    rw [mul_assoc]
    exact Ideal.mul_mem_left _ c (hrad s hs)
  obtain ⟨N₀, hN₀⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hK
    (IsNoetherian.noetherian (Ideal.span {e} * 𝔫))
  have hN : (Ideal.span {e} * 𝔫) ^ (N₀ + 1) ≤
      Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) :=
    (Ideal.pow_le_pow_right (Nat.le_succ N₀)).trans hN₀
  refine ⟨h1 𝔫 ‹_›, e, N₀ + 1, by omega, he1, heP, ?_, ?_⟩
  · have hm : e * e - e ∈ Ideal.span {e} * 𝔫 := by
      have : e * e - e = -(e * (1 - e)) := by ring
      rw [this]
      exact (Ideal.span {e} * 𝔫).neg_mem (Ideal.mul_mem_mul (Ideal.mem_span_singleton_self e) he1)
    exact hN (Ideal.pow_mem_pow hm _)
  · intro n y hy
    have h3 : e ^ ((N₀ + 1) * n) * y ∈ (Ideal.span {e} * 𝔫) ^ ((N₀ + 1) * n) := by
      rw [mul_pow]
      exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self e) _) hy
    rw [pow_mul] at h3
    exact Ideal.pow_right_mono hN n h3

theorem nccwffnz_cf_newton : ∀ (C : Type u) [CommRing C] (J 𝔫 : Ideal C) (e : C) (N : ℕ), (e * e - e) ^ N ∈ J → 1 - e ∈ 𝔫 → ∃ c : ℕ → C, (∀ n, c n * c n - c n ∈ J ^ n) ∧ (∀ n, c (n + 1) - c n ∈ J ^ n) ∧ (∀ n, 1 - c n ∈ 𝔫) ∧ ∀ (n : ℕ) (P : Ideal C), e ∈ P → c n ∈ P :=
by
  intro C _ J 𝔫 e N hJ h1
  obtain ⟨E, hE0, hES⟩ : ∃ E : ℕ → C, E 0 = e ∧
      ∀ k, E (k + 1) = 3 * E k ^ 2 - 2 * E k ^ 3 :=
    ⟨fun k => Nat.rec e (fun _ y => 3 * y ^ 2 - 2 * y ^ 3) k, rfl, fun _ => rfl⟩
  have s2 : ∀ k, (e * e - e) ^ (k + 1) ∣ E k * E k - E k := by
    intro k
    induction k with
    | zero => simp [hE0]
    | succ k ih =>
      have hid : E (k + 1) * E (k + 1) - E (k + 1) =
          ((E k * E k - E k) * (E k * E k - E k)) * (4 * (E k * E k - E k) - 3) := by
        rw [hES]; ring
      rw [hid]
      apply Dvd.dvd.mul_right
      have h2 : (e * e - e) ^ (k + 1 + 1) ∣ (e * e - e) ^ (k + 1) * (e * e - e) ^ (k + 1) := by
        rw [← pow_add]; exact pow_dvd_pow _ (by omega)
      exact h2.trans (mul_dvd_mul ih ih)
  have s3 : ∀ k, (e * e - e) ^ (k + 1) ∣ E (k + 1) - E k := by
    intro k
    have hid : E (k + 1) - E k = (E k * E k - E k) * (1 - 2 * E k) := by
      rw [hES]; ring
    rw [hid]
    exact (s2 k).mul_right _
  have s4 : ∀ a j, (e * e - e) ^ a ∣ E (a + j) - E a := by
    intro a j
    induction j with
    | zero => rw [add_zero, sub_self]; exact dvd_zero _
    | succ j ih =>
      have hid : E (a + (j + 1)) - E a = (E (a + j + 1) - E (a + j)) + (E (a + j) - E a) := by
        rw [← add_assoc]; ring
      rw [hid]
      exact dvd_add ((pow_dvd_pow _ (by omega)).trans (s3 (a + j))) ih
  have s5 : ∀ n, (e * e - e) ^ (N * n) ∈ J ^ n := by
    intro n
    rw [pow_mul]
    exact Ideal.pow_mem_pow hJ n
  have s8 : ∀ k, 1 - E k ∈ 𝔫 := by
    intro k
    induction k with
    | zero => rw [hE0]; exact h1
    | succ k ih =>
      have hid : 1 - E (k + 1) = (1 - E k) * ((1 - E k) * (1 + 2 * E k)) := by
        rw [hES]; ring
      rw [hid]
      exact 𝔫.mul_mem_right _ ih
  have s9 : ∀ (P : Ideal C), e ∈ P → ∀ k, E k ∈ P := by
    intro P hP k
    induction k with
    | zero => rw [hE0]; exact hP
    | succ k ih =>
      have hid : E (k + 1) = E k * (E k * (3 - 2 * E k)) := by
        rw [hES]; ring
      rw [hid]
      exact P.mul_mem_right _ ih
  refine ⟨fun n => E (N * n), ?_, ?_, fun n => s8 (N * n), fun n P hP => s9 P hP (N * n)⟩
  · intro n
    exact Ideal.mem_of_dvd (J ^ n) ((pow_dvd_pow _ (Nat.le_succ _)).trans (s2 (N * n))) (s5 n)
  · intro n
    have h := s4 (N * n) N
    rw [show N * n + N = N * (n + 1) by ring] at h
    exact Ideal.mem_of_dvd (J ^ n) h (s5 n)

theorem nccwffnz_cf_localize : ∀ (C : Type u) [CommRing C] (𝔫 : Ideal C) [𝔫.IsMaximal], (∀ (m : ℕ) (y : Localization.AtPrime 𝔫), ∃ b : C, algebraMap C (Localization.AtPrime 𝔫) b - y ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ m) ∧ (∀ (m : ℕ) (z : C), algebraMap C (Localization.AtPrime 𝔫) z ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ m → ∃ s ∉ 𝔫, s * z ∈ 𝔫 ^ m) ∧ ∀ (m : ℕ) (z : C), z ∈ 𝔫 ^ m → algebraMap C (Localization.AtPrime 𝔫) z ∈ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ m :=
by
  intro C _ 𝔫 _
  have key : ∀ m : ℕ, IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ m =
      Ideal.map (algebraMap C (Localization.AtPrime 𝔫)) (𝔫 ^ m) := by
    intro m
    rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal]
  refine ⟨?_, ?_, ?_⟩
  · intro m y
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔫.primeCompl y
    have hs : (s : C) ∉ 𝔫 := s.2
    obtain ⟨r, i, hi, hri⟩ := Ideal.IsMaximal.exists_inv (inferInstance : 𝔫.IsMaximal) hs
    refine ⟨a * r * ∑ j ∈ Finset.range m, i ^ j, ?_⟩
    have hrs : r * (s : C) = 1 - i := eq_sub_of_add_eq hri
    have a1 : (s : C) * (a * r * ∑ j ∈ Finset.range m, i ^ j) - a = -(a * i ^ m) := by
      calc (s : C) * (a * r * ∑ j ∈ Finset.range m, i ^ j) - a
          = a * ((r * s) * ∑ j ∈ Finset.range m, i ^ j) - a := by ring
        _ = a * (1 - i ^ m) - a := by rw [hrs, mul_neg_geom_sum]
        _ = -(a * i ^ m) := by ring
    have a2 : (s : C) * (a * r * ∑ j ∈ Finset.range m, i ^ j) - a ∈ 𝔫 ^ m := by
      rw [a1]
      exact (𝔫 ^ m).neg_mem ((𝔫 ^ m).mul_mem_left a (Ideal.pow_mem_pow hi m))
    have hw : IsLocalization.mk' (Localization.AtPrime 𝔫) (1 : C) s *
        algebraMap C (Localization.AtPrime 𝔫) (s : C) = 1 := by
      rw [IsLocalization.mk'_spec, map_one]
    have hy : IsLocalization.mk' (Localization.AtPrime 𝔫) a s =
        algebraMap C (Localization.AtPrime 𝔫) a *
          IsLocalization.mk' (Localization.AtPrime 𝔫) (1 : C) s :=
      IsLocalization.mk'_eq_mul_mk'_one a s
    have a3 : algebraMap C (Localization.AtPrime 𝔫) (a * r * ∑ j ∈ Finset.range m, i ^ j) -
        IsLocalization.mk' (Localization.AtPrime 𝔫) a s =
        algebraMap C (Localization.AtPrime 𝔫)
            ((s : C) * (a * r * ∑ j ∈ Finset.range m, i ^ j) - a) *
          IsLocalization.mk' (Localization.AtPrime 𝔫) (1 : C) s := by
      rw [hy, map_sub, map_mul (algebraMap C (Localization.AtPrime 𝔫)) (s : C)]
      linear_combination
        (-(algebraMap C (Localization.AtPrime 𝔫) (a * r * ∑ j ∈ Finset.range m, i ^ j))) * hw
    rw [a3, key]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ a2)
  · intro m z hz
    rw [key, IsLocalization.mem_map_algebraMap_iff 𝔫.primeCompl (Localization.AtPrime 𝔫)] at hz
    obtain ⟨⟨⟨i, hi⟩, ⟨t, ht⟩⟩, hx⟩ := hz
    simp only at hx
    rw [← map_mul] at hx
    obtain ⟨⟨u, hu⟩, hu'⟩ :=
      (IsLocalization.eq_iff_exists 𝔫.primeCompl (Localization.AtPrime 𝔫)).mp hx
    simp only at hu'
    refine ⟨u * t, 𝔫.primeCompl.mul_mem hu ht, ?_⟩
    have e : u * t * z = u * i := by rw [← hu']; ring
    rw [e]
    exact (𝔫 ^ m).mul_mem_left u hi
  · intro m z hz
    rw [key]
    exact Ideal.mem_map_of_mem _ hz

theorem nccwffnz_cf_pr_map : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (C : Type u) [CommRing C] [Algebra A C] (𝔫 : Ideal C) [𝔫.IsMaximal], Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) ≤ 𝔫 → ∃ pr : TensorProduct A (AdicCompletion (IsLocalRing.maximalIdeal A) A) C →+* AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) (Localization.AtPrime 𝔫), (∀ c : C, pr (TensorProduct.tmul A (1 : AdicCompletion (IsLocalRing.maximalIdeal A) A) c) = algebraMap (Localization.AtPrime 𝔫) _ (algebraMap C (Localization.AtPrime 𝔫) c)) ∧ ∀ (n : ℕ) (a : AdicCompletion (IsLocalRing.maximalIdeal A) A) (a₀ : A) (c : C), AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n a = Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n) a₀ → AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) n (pr (TensorProduct.tmul A a c)) = Ideal.Quotient.mk (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ n) (algebraMap C (Localization.AtPrime 𝔫) (algebraMap A C a₀ * c)) :=
by
  intro A _ _ C _ _ 𝔫 _ hJ

  have compat : ∀ (R : Type u) [CommRing R] (I : Ideal R) (x : AdicCompletion I R) (m n : ℕ)
      (y : R), m ≤ n → AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) y →
      AdicCompletion.evalₐ I m x = Ideal.Quotient.mk (I ^ m) y := by
    intro R _ I x m n y hmn h
    obtain ⟨F, rfl⟩ : ∃ F, AdicCompletion.mk I R F = x :=
      AdicCompletion.induction_on (p := fun x => ∃ F, AdicCompletion.mk I R F = x) I R x
        (fun F => ⟨F, rfl⟩)
    rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq] at h
    rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq]
    have h₂ : F n - y ∈ I ^ m := Ideal.pow_le_pow_right hmn h
    have h₃ : F n - F m ∈ I ^ m := by
      have hc := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn F
      rw [Submodule.Quotient.eq] at hc
      have hle : (I ^ m • (⊤ : Submodule R R)) ≤ I ^ m :=
        Submodule.smul_le.mpr (fun r hr s _ => by
          rw [smul_eq_mul]; exact Ideal.mul_mem_right s _ hr)
      exact hle hc
    have h₄ := Ideal.sub_mem _ h₂ h₃
    rwa [sub_sub_sub_cancel_left] at h₄

  have tens : ∀ (B : Type u) [CommRing B] [Algebra A B] (T : Type u) [CommRing T]
      (f : B →+* T) (g : C →+* T), (∀ a : A, f (algebraMap A B a) = g (algebraMap A C a)) →
      ∃ pr : TensorProduct A B C →+* T, ∀ (b : B) (c : C),
        pr (TensorProduct.tmul A b c) = f b * g c := by
    intro B _ _ T _ f g hfg
    letI : Algebra A T := (g.comp (algebraMap A C)).toAlgebra
    let f' : B →ₐ[A] T := { f with commutes' := fun a => hfg a }
    let g' : C →ₐ[A] T := { g with commutes' := fun a => rfl }
    exact ⟨(Algebra.TensorProduct.productMap f' g').toRingHom,
      fun b c => Algebra.TensorProduct.productMap_apply_tmul f' g' b c⟩

  let κ : A →+* Localization.AtPrime 𝔫 :=
    (algebraMap C (Localization.AtPrime 𝔫)).comp (algebraMap A C)
  have hκ : ∀ n, IsLocalRing.maximalIdeal A ^ n ≤
      Ideal.comap κ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ n) := by
    intro n
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    apply Ideal.pow_right_mono
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap]
    show algebraMap C (Localization.AtPrime 𝔫) (algebraMap A C a) ∈ _
    rw [IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔫) 𝔫]
    exact hJ (Ideal.mem_map_of_mem _ ha)
  let fn : ∀ n, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
      Localization.AtPrime 𝔫 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ n :=
    fun n => (Ideal.quotientMap _ κ (hκ n)).comp
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
  have hfn : ∀ (n : ℕ) (a : AdicCompletion (IsLocalRing.maximalIdeal A) A) (a₀ : A),
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n a =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n) a₀ →
      fn n a = Ideal.Quotient.mk _ (κ a₀) := by
    intro n a a₀ h
    show Ideal.quotientMap _ κ (hκ n) (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n a) = _
    rw [h, Ideal.quotientMap_mk]
  have hcomp : ∀ {m n : ℕ} (hle : m ≤ n),
      (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) hle).comp
        (fn n) = fn m := by
    intro m n hle
    ext x
    obtain ⟨a₀, ha₀⟩ :=
      Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x)
    rw [RingHom.comp_apply, hfn n x a₀ ha₀.symm, hfn m x a₀ (compat A _ x m n a₀ hle ha₀.symm)]
    exact Ideal.Quotient.factor_mk _ _
  let f := AdicCompletion.liftRingHom (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) fn hcomp
  have hf : ∀ (n : ℕ) (a : AdicCompletion (IsLocalRing.maximalIdeal A) A) (a₀ : A),
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n a =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n) a₀ →
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) n (f a) =
        Ideal.Quotient.mk _ (κ a₀) := by
    intro n a a₀ h
    rw [AdicCompletion.evalₐ_liftRingHom]
    exact hfn n a a₀ h
  let g : C →+* AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫))
      (Localization.AtPrime 𝔫) :=
    (algebraMap (Localization.AtPrime 𝔫) _).comp (algebraMap C (Localization.AtPrime 𝔫))
  have hg : ∀ (n : ℕ) (c : C),
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) n (g c) =
        Ideal.Quotient.mk _ (algebraMap C (Localization.AtPrime 𝔫) c) := by
    intro n c
    show AdicCompletion.evalₐ _ n
      (algebraMap (Localization.AtPrime 𝔫) _ (algebraMap C (Localization.AtPrime 𝔫) c)) = _
    rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self_apply, AdicCompletion.evalₐ_of]
  have hfg : ∀ a : A, f (algebraMap A _ a) = g (algebraMap A C a) := by
    intro a
    apply AdicCompletion.ext_evalₐ
    intro n
    have hev : AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ n) a := by
      rw [(AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).commutes a,
        Ideal.Quotient.algebraMap_eq]
    rw [hf n _ a hev, hg n]
    rfl
  obtain ⟨pr, hpr⟩ := tens _ _ f g hfg
  refine ⟨pr, fun c => ?_, fun n a a₀ c h => ?_⟩
  · rw [hpr, map_one, one_mul]
    rfl
  · rw [hpr, map_mul, hf n a a₀ h, hg n c, ← map_mul, map_mul (algebraMap C _)]
    rfl

theorem nccwffnz_completion_factor : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (C : Type u) [CommRing C] [Algebra A C] [Module.Finite A C] (𝔫 : Ideal C) [𝔫.IsMaximal], ∃ pr : TensorProduct A (AdicCompletion (IsLocalRing.maximalIdeal A) A) C →+* AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) (Localization.AtPrime 𝔫), Function.Surjective pr ∧ (∀ c : C, pr (TensorProduct.tmul A (1 : AdicCompletion (IsLocalRing.maximalIdeal A) A) c) = algebraMap (Localization.AtPrime 𝔫) _ (algebraMap C (Localization.AtPrime 𝔫) c)) ∧ ∀ d, pr d = 0 → ∃ s, pr s = 1 ∧ s * d = 0 :=
by
  intro A _ _ _ C _ _ _ 𝔫 _
  classical
  obtain ⟨hJn, e, N, hN1, he1, heP, hδ, hSep⟩ := nccwffnz_cf_sep_elem A C 𝔫
  obtain ⟨c, hC1, hC2, hC3, hC4⟩ := nccwffnz_cf_newton C
    (Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A)) 𝔫 e N hδ he1
  obtain ⟨φ, hφ1, hφ2, hφ3, hφ4⟩ := nccwffnz_cf_tensor_levels A (IsLocalRing.maximalIdeal A) C
  obtain ⟨pr, hpr1, hpr2⟩ := nccwffnz_cf_pr_map A C 𝔫 hJn
  obtain ⟨hLa, hLb, hLc⟩ := nccwffnz_cf_localize C 𝔫
  generalize hJdef : Ideal.map (algebraMap A C) (IsLocalRing.maximalIdeal A) = J at *
  generalize hMLdef : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) = ML at *
  have hnt : ∀ x : C, x ∈ 𝔫 → 1 - x ∈ 𝔫 → False := by
    intro x hx h1x
    apply Ideal.IsMaximal.ne_top ‹𝔫.IsMaximal›
    rw [Ideal.eq_top_iff_one]
    have := 𝔫.add_mem h1x hx
    rwa [sub_add_cancel] at this

  have hJML : ∀ n, J ^ n ≤ (ML ^ n).comap (algebraMap C (Localization.AtPrime 𝔫)) := by
    intro n z hz
    exact hLc n z (Ideal.pow_right_mono hJn n hz)

  have hR : ∀ n (d : TensorProduct A (AdicCompletion (IsLocalRing.maximalIdeal A) A) C) (z : C),
      φ n d = Ideal.Quotient.mk (J ^ n) z →
      AdicCompletion.evalₐ ML n (pr d) =
        Ideal.Quotient.mk (ML ^ n) (algebraMap C (Localization.AtPrime 𝔫) z) := by
    intro n d z hd
    have key : ∀ d, AdicCompletion.evalₐ ML n (pr d) =
        Ideal.quotientMap (ML ^ n) (algebraMap C (Localization.AtPrime 𝔫)) (hJML n) (φ n d) := by
      intro d
      induction d using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a x =>
        obtain ⟨a₀, ha₀⟩ :=
          Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n a)
        rw [hpr2 n a a₀ x ha₀.symm, hφ1 n a a₀ x ha₀.symm, Ideal.quotientMap_mk]
      | add x y hx hy => simp only [map_add, hx, hy]
    rw [key, hd, Ideal.quotientMap_mk]

  have hcn : ∀ n, c n ∉ 𝔫 := fun n h => hnt (c n) h (hC3 n)
  have hLc' : ∀ n, algebraMap C (Localization.AtPrime 𝔫) (c n) - 1 ∈ ML ^ n := by
    intro n
    have h1 : algebraMap C (Localization.AtPrime 𝔫) (c n * c n - c n) ∈ ML ^ n := hJML n (hC1 n)
    have hu : IsUnit (algebraMap C (Localization.AtPrime 𝔫) (c n)) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff _ 𝔫 (c n)).mpr (hcn n)
    have h2 : algebraMap C (Localization.AtPrime 𝔫) (c n) *
        (algebraMap C (Localization.AtPrime 𝔫) (c n) - 1) ∈ ML ^ n := by
      have : algebraMap C (Localization.AtPrime 𝔫) (c n * c n - c n) =
          algebraMap C (Localization.AtPrime 𝔫) (c n) *
            (algebraMap C (Localization.AtPrime 𝔫) (c n) - 1) := by
        rw [map_sub, map_mul]; ring
      rwa [this] at h1
    exact (Ideal.unit_mul_mem_iff_mem _ hu).mp h2

  have hunit : ∀ n (s : C), s ∉ 𝔫 → IsUnit (s * c n + 1 - c n) := by
    intro n s hs
    by_contra hv
    obtain ⟨P, hP, hvP⟩ := Ideal.exists_le_maximal (Ideal.span {s * c n + 1 - c n})
      (by rwa [Ne, Ideal.span_singleton_eq_top])
    have hvP' : s * c n + 1 - c n ∈ P := hvP (Ideal.mem_span_singleton_self _)
    by_cases hPn : P = 𝔫
    · rw [hPn] at hvP'
      apply hs
      have h1 : s * c n + 1 - c n - (s - 1) * (-(1 - c n)) = s := by ring
      rw [← h1]
      exact 𝔫.sub_mem hvP' (𝔫.mul_mem_left _ (𝔫.neg_mem (hC3 n)))
    · have hcP : c n ∈ P := hC4 n P (heP P hP hPn)
      apply hP.ne_top
      rw [Ideal.eq_top_iff_one]
      have h1 : s * c n + 1 - c n - c n * (s - 1) = 1 := by ring
      rw [← h1]
      exact P.sub_mem hvP' (P.mul_mem_right _ hcP)

  have hAbs : ∀ n (z : C), algebraMap C (Localization.AtPrime 𝔫) z ∈ ML ^ (N * n) →
      c n * z ∈ J ^ n := by
    intro n z hz
    obtain ⟨s, hs, hsz⟩ := hLb (N * n) z hz
    have hs' : e ^ (N * n) * s ∉ 𝔫 := by
      intro h
      rcases (Ideal.IsMaximal.isPrime ‹𝔫.IsMaximal›).mem_or_mem h with h | h
      · exact hnt e ((Ideal.IsMaximal.isPrime ‹𝔫.IsMaximal›).mem_of_pow_mem _ h) he1
      · exact hs h
    have hs'z : e ^ (N * n) * s * z ∈ J ^ n := by rw [mul_assoc]; exact hSep n _ hsz
    obtain ⟨w, hw⟩ := (hunit n _ hs').exists_right_inv
    have hid : c n * z = (c n * c n * (e ^ (N * n) * s * z) - (c n * c n - c n) * z) * w := by
      calc c n * z = c n * z * ((e ^ (N * n) * s) * c n + 1 - c n) * w := by
            rw [mul_assoc (c n * z), hw, mul_one]
        _ = _ := by ring
    rw [hid]
    exact (J ^ n).mul_mem_right _ ((J ^ n).sub_mem ((J ^ n).mul_mem_left _ hs'z)
      ((J ^ n).mul_mem_right _ (hC1 n)))

  obtain ⟨s₀, hs₀⟩ := hφ4 c hC2
  have hprs₀ : pr s₀ = 1 := by
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hR n s₀ (c n) (hs₀ n), map_one, ← map_one (Ideal.Quotient.mk (ML ^ n)), Ideal.Quotient.eq]
    exact hLc' n
  have hNn : ∀ n, n ≤ N * n := fun n => Nat.le_mul_of_pos_left n hN1

  have hker : ∀ d, pr d = 0 → ∃ s, pr s = 1 ∧ s * d = 0 := by
    intro d hd
    refine ⟨s₀, hprs₀, hφ3 _ (fun n => ?_)⟩
    obtain ⟨z, hz⟩ := Ideal.Quotient.mk_surjective (φ (N * n) d)
    have h1 := hR (N * n) d z hz.symm
    rw [hd, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem] at h1
    have h2 := hAbs n z h1
    have h3 : φ n d = Ideal.Quotient.mk (J ^ n) z := hφ2 n (N * n) d z (hNn n) hz.symm
    rw [map_mul, hs₀ n, h3, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact h2

  have hsurj : Function.Surjective pr := by
    intro t
    have hy : ∀ n, ∃ y : Localization.AtPrime 𝔫,
        Ideal.Quotient.mk (ML ^ (N * n)) y = AdicCompletion.evalₐ ML (N * n) t :=
      fun n => Ideal.Quotient.mk_surjective _
    choose y hy using hy
    choose b hb using fun n => hLa (N * n) (y n)
    have hNs : ∀ n, N * n ≤ N * (n + 1) := fun n => by gcongr; omega
    have hyc : ∀ n, y (n + 1) - y n ∈ ML ^ (N * n) := by
      intro n
      have h1 := nccwffnz_cf_evalₐ_compat _ ML t (N * n) (N * (n + 1)) (y (n + 1)) (hNs n)
        (hy (n + 1)).symm
      rw [← hy n, Ideal.Quotient.eq] at h1
      have := (ML ^ (N * n)).neg_mem h1
      rwa [neg_sub] at this
    have hzc : ∀ n, c (n + 1) * b (n + 1) - c n * b n ∈ J ^ n := by
      intro n
      have e1 : c (n + 1) * b (n + 1) - c n * b n =
          (c (n + 1) - c n) * b (n + 1) + c n * (b (n + 1) - b n) := by ring
      rw [e1]
      refine (J ^ n).add_mem ((J ^ n).mul_mem_right _ (hC2 n)) (hAbs n _ ?_)
      have e2 : algebraMap C (Localization.AtPrime 𝔫) (b (n + 1) - b n) =
          (algebraMap C (Localization.AtPrime 𝔫) (b (n + 1)) - y (n + 1)) + (y (n + 1) - y n) -
            (algebraMap C (Localization.AtPrime 𝔫) (b n) - y n) := by
        rw [map_sub]; ring
      rw [e2]
      exact Ideal.sub_mem _ (Ideal.add_mem _ (Ideal.pow_le_pow_right (hNs n) (hb (n + 1)))
        (hyc n)) (hb n)
    obtain ⟨d, hd⟩ := hφ4 (fun n => c n * b n) hzc
    have hd' : ∀ n, φ n d = Ideal.Quotient.mk (J ^ n) (c n * b n) := hd
    refine ⟨d, AdicCompletion.ext_evalₐ (fun n => ?_)⟩
    rw [hR n d _ (hd' n)]
    have h1 := nccwffnz_cf_evalₐ_compat _ ML t n (N * n) (y n) (hNn n) (hy n).symm
    rw [h1, Ideal.Quotient.eq]
    have e3 : algebraMap C (Localization.AtPrime 𝔫) (c n * b n) - y n =
        (algebraMap C (Localization.AtPrime 𝔫) (c n) - 1) *
          algebraMap C (Localization.AtPrime 𝔫) (b n) +
          (algebraMap C (Localization.AtPrime 𝔫) (b n) - y n) := by
      rw [map_mul]; ring
    rw [e3]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (hLc' n))
      (Ideal.pow_le_pow_right (hNn n) (hb n))
  exact ⟨pr, hsurj, hpr1, hker⟩

theorem nccwffnz_completion_isLocalRing : ∀ (L : Type u) [CommRing L] [IsLocalRing L] [IsNoetherianRing L], IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal L) L) :=
by
  intro L _ _ _
  infer_instance

theorem nccwffnz_integral_dim_inj : ∀ (P T : Type u) [CommRing P] [IsDomain P] [CommRing T] (f : P →+* T), f.IsIntegral → ringKrullDim P ≤ 2 → (∃ P₀ P₁ P₂ : Ideal T, P₀.IsPrime ∧ P₁.IsPrime ∧ P₂.IsPrime ∧ P₀ < P₁ ∧ P₁ < P₂) → Function.Injective f :=
by
  intro P T _ _ _ f hf hdim ⟨P₀, P₁, P₂, h0, h1, h2, h01, h12⟩
  letI : Algebra P T := f.toAlgebra
  have hint : ∀ x : T, IsIntegral P x := fun x => hf x
  rw [injective_iff_map_eq_zero]
  intro a ha
  by_contra ha0
  have key : ∀ (I J : Ideal T), I.IsPrime → I < J → Ideal.comap f I < Ideal.comap f J := by
    intro I J hI hIJ
    obtain ⟨x, hxJ, hxI⟩ := SetLike.exists_of_lt hIJ
    haveI := hI
    exact Ideal.under_lt_under_of_integral_mem_sdiff (R := P) hIJ.le ⟨hxJ, hxI⟩ (hint x)
  have q01 := key P₀ P₁ h0 h01
  have q12 := key P₁ P₂ h1 h12
  have qb : (⊥ : Ideal P) < Ideal.comap f P₀ := by
    rw [bot_lt_iff_ne_bot]
    intro hb
    have hmem : a ∈ Ideal.comap f P₀ := by rw [Ideal.mem_comap, ha]; exact P₀.zero_mem
    rw [hb, Ideal.mem_bot] at hmem
    exact ha0 hmem
  let p : Fin 4 → PrimeSpectrum P := ![⟨⊥, Ideal.isPrime_bot⟩,
    ⟨Ideal.comap f P₀, Ideal.comap_isPrime f P₀⟩, ⟨Ideal.comap f P₁, Ideal.comap_isPrime f P₁⟩,
    ⟨Ideal.comap f P₂, Ideal.comap_isPrime f P₂⟩]
  have hmono : StrictMono p := by
    rw [Fin.strictMono_iff_lt_succ]
    intro i
    fin_cases i
    · exact qb
    · exact q01
    · exact q12
  let s : LTSeries (PrimeSpectrum P) := ⟨3, p, fun i => hmono Fin.castSucc_lt_succ⟩
  have h3 : ((3 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim P := Order.LTSeries.length_le_krullDim s
  have h32 : ((3 : ℕ) : WithBot ℕ∞) ≤ 2 := le_trans h3 hdim
  exact absurd h32 (by decide)

theorem nccwffnz_birational_integral_surj : ∀ (P T : Type u) [CommRing P] [IsDomain P] [IsIntegrallyClosed P] [CommRing T] [IsDomain T] (f : P →+* T), Function.Injective f → f.IsIntegral → ∀ h : P, f h ≠ 0 → (∀ t : T, ∃ p : P, f h * t = f p) → Function.Surjective f :=
by
  intro P T _ _ _ _ _ f hf hint h hh hsurj t
  obtain ⟨p, hp⟩ := hsurj t
  have hh0 : h ≠ 0 := by
    rintro rfl
    exact hh (map_zero f)
  obtain ⟨g, hgm, hg⟩ := hint t
  have h1 : Polynomial.eval₂ f (f p) (g.scaleRoots h) = 0 := by
    rw [← hp, Polynomial.scaleRoots_eval₂_mul, hg, mul_zero]
  have hq0 : Polynomial.eval p (g.scaleRoots h) = 0 := by
    apply hf
    rw [← Polynomial.eval₂_at_apply, h1, map_zero]
  have hι0 : algebraMap P (FractionRing P) h ≠ 0 := by
    rw [Ne, IsFractionRing.to_map_eq_zero_iff]
    exact hh0
  set x : FractionRing P := algebraMap P (FractionRing P) p / algebraMap P (FractionRing P) h
    with hxdef
  have hx : algebraMap P (FractionRing P) h * x = algebraMap P (FractionRing P) p :=
    mul_div_cancel₀ _ hι0
  have hxint : IsIntegral P x := by
    refine ⟨g, hgm, ?_⟩
    have e := Polynomial.scaleRoots_eval₂_mul (p := g) (algebraMap P (FractionRing P)) x h
    rw [hx, Polynomial.eval₂_at_apply, hq0, map_zero] at e
    exact (mul_eq_zero.mp e.symm).resolve_left (pow_ne_zero _ hι0)
  obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (K := FractionRing P)).mp hxint
  have hyp : h * y = p := by
    apply IsFractionRing.injective P (FractionRing P)
    rw [map_mul, hy, hx]
  refine ⟨y, ?_⟩
  apply mul_left_cancel₀ hh
  rw [← map_mul, hyp, hp]

theorem nccwffnz_Q0_structure : ∀ (R : Type u) [CommRing R] [IsDomain R], ∃ π₁ π₂ : nccwffQ R 0 →+* PowerSeries R, (∀ r, π₁ (nccwffPsi R 0 r) = PowerSeries.C r) ∧ (∀ r, π₂ (nccwffPsi R 0 r) = PowerSeries.C r) ∧ Function.Surjective π₁ ∧ Function.Surjective π₂ ∧ (∀ a, π₁ a = 0 → ∃ g, a = nccwffnzX R 1 * g) ∧ (∀ a, π₂ a = 0 → ∃ g, a = nccwffnzX R 0 * g) ∧ π₁ (nccwffnzX R 1) = 0 ∧ π₂ (nccwffnzX R 0) = 0 ∧ nccwffnzX R 0 ≠ 0 ∧ nccwffnzX R 1 ≠ 0 ∧ _root_.IsReduced (nccwffQ R 0) :=
by
  intro R _ _
  classical

  have axis : ∀ i : Fin 2, ∃ p : MvPowerSeries (Fin 2) R →+* PowerSeries R,
      ∀ (F : MvPowerSeries (Fin 2) R) (k : ℕ),
        PowerSeries.coeff k (p F) = MvPowerSeries.coeff (Finsupp.single i k) F := by
    intro i
    refine ⟨{ toFun := fun F => PowerSeries.mk (fun k => MvPowerSeries.coeff (Finsupp.single i k) F)
              map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ }, ?_⟩
    · ext k
      simp [PowerSeries.coeff_one, MvPowerSeries.coeff_one, Finsupp.single_eq_zero]
    · intro F G
      ext k
      simp only [PowerSeries.coeff_mk, MvPowerSeries.coeff_mul, PowerSeries.coeff_mul]
      rw [Finsupp.antidiagonal_single, Finset.sum_map]
      rfl
    · ext k
      simp
    · intro F G
      ext k
      simp
    · intro F k
      simp

  have dvd : ∀ i j : Fin 2, i ≠ j → ∀ F : MvPowerSeries (Fin 2) R,
      (∀ k : ℕ, MvPowerSeries.coeff (Finsupp.single i k) F = 0) → MvPowerSeries.X j ∣ F := by
    intro i j hij F hF
    rw [MvPowerSeries.X_dvd_iff]
    intro m hm
    have hm' : m = Finsupp.single i (m i) := by
      ext a
      by_cases ha : a = i
      · subst ha
        simp
      · have haj : a = j := by
          fin_cases i <;> fin_cases j <;> fin_cases a <;> simp_all
        subst haj
        simp [Ne.symm hij, hm]
    rw [hm']
    exact hF _

  have hC : ∀ (p : MvPowerSeries (Fin 2) R →+* PowerSeries R) (i : Fin 2),
      (∀ (F : MvPowerSeries (Fin 2) R) (k : ℕ),
        PowerSeries.coeff k (p F) = MvPowerSeries.coeff (Finsupp.single i k) F) →
      ∀ r, p (MvPowerSeries.C r) = PowerSeries.C r := by
    intro p i hp r
    ext k
    rw [hp, MvPowerSeries.coeff_C, PowerSeries.coeff_C]
    simp [Finsupp.single_eq_zero]
  have hX : ∀ (p : MvPowerSeries (Fin 2) R →+* PowerSeries R) (i : Fin 2),
      (∀ (F : MvPowerSeries (Fin 2) R) (k : ℕ),
        PowerSeries.coeff k (p F) = MvPowerSeries.coeff (Finsupp.single i k) F) →
      p (MvPowerSeries.X i) = PowerSeries.X := by
    intro p i hp
    ext k
    rw [hp, MvPowerSeries.coeff_X, PowerSeries.coeff_X]
    simp [Finsupp.single_eq_single_iff]
  have hXj : ∀ (p : MvPowerSeries (Fin 2) R →+* PowerSeries R) (i j : Fin 2), i ≠ j →
      (∀ (F : MvPowerSeries (Fin 2) R) (k : ℕ),
        PowerSeries.coeff k (p F) = MvPowerSeries.coeff (Finsupp.single i k) F) →
      p (MvPowerSeries.X j) = 0 := by
    intro p i j hij hp
    ext k
    rw [hp, MvPowerSeries.coeff_X, map_zero]
    simp [Finsupp.single_eq_single_iff, hij]
  have hkill : ∀ (p : MvPowerSeries (Fin 2) R →+* PowerSeries R),
      p (MvPowerSeries.X 0 * MvPowerSeries.X 1) = 0 → ∀ a ∈ nccwffnzI R, p a = 0 := by
    intro p hp a ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    simp [hp]
  obtain ⟨p0, hp0⟩ := axis 0
  obtain ⟨p1, hp1⟩ := axis 1
  have h01 : (0 : Fin 2) ≠ 1 := by decide
  have h10 : (1 : Fin 2) ≠ 0 := by decide
  have hk0 : ∀ a ∈ nccwffnzI R, p0 a = 0 :=
    hkill p0 (by rw [map_mul, hXj p0 0 1 h01 hp0, mul_zero])
  have hk1 : ∀ a ∈ nccwffnzI R, p1 a = 0 :=
    hkill p1 (by rw [map_mul, hXj p1 1 0 h10 hp1, zero_mul])
  set π₁ : nccwffQ R 0 →+* PowerSeries R := Ideal.Quotient.lift (nccwffnzI R) p0 hk0 with hπ₁
  set π₂ : nccwffQ R 0 →+* PowerSeries R := Ideal.Quotient.lift (nccwffnzI R) p1 hk1 with hπ₂
  have e1 : ∀ F, π₁ (Ideal.Quotient.mk (nccwffnzI R) F) = p0 F := fun F =>
    Ideal.Quotient.lift_mk _ _ _
  have e2 : ∀ F, π₂ (Ideal.Quotient.mk (nccwffnzI R) F) = p1 F := fun F =>
    Ideal.Quotient.lift_mk _ _ _

  have c1 : ∀ r, π₁ (nccwffPsi R 0 r) = PowerSeries.C r := fun r => by
    rw [RingHom.comp_apply, e1, hC p0 0 hp0]
  have c2 : ∀ r, π₂ (nccwffPsi R 0 r) = PowerSeries.C r := fun r => by
    rw [RingHom.comp_apply, e2, hC p1 1 hp1]
  have v1y : π₁ (nccwffnzX R 1) = 0 := by rw [e1, hXj p0 0 1 h01 hp0]
  have v2x : π₂ (nccwffnzX R 0) = 0 := by rw [e2, hXj p1 1 0 h10 hp1]
  have v1x : π₁ (nccwffnzX R 0) = PowerSeries.X := by rw [e1, hX p0 0 hp0]
  have v2y : π₂ (nccwffnzX R 1) = PowerSeries.X := by rw [e2, hX p1 1 hp1]

  have surj : ∀ (p : MvPowerSeries (Fin 2) R →+* PowerSeries R) (i j : Fin 2), i ≠ j →
      (∀ (F : MvPowerSeries (Fin 2) R) (k : ℕ),
        PowerSeries.coeff k (p F) = MvPowerSeries.coeff (Finsupp.single i k) F) →
      Function.Surjective p := by
    intro p i j hij hp f
    let G : MvPowerSeries (Fin 2) R := fun m => if m j = 0 then PowerSeries.coeff (m i) f else 0
    refine ⟨G, ?_⟩
    ext k
    rw [hp]
    show (if (Finsupp.single i k) j = 0 then PowerSeries.coeff ((Finsupp.single i k) i) f else 0) = _
    simp [hij]
  have s1 : Function.Surjective π₁ := by
    intro f
    obtain ⟨F, hF⟩ := surj p0 0 1 h01 hp0 f
    exact ⟨Ideal.Quotient.mk _ F, (e1 F).trans hF⟩
  have s2 : Function.Surjective π₂ := by
    intro f
    obtain ⟨F, hF⟩ := surj p1 1 0 h10 hp1 f
    exact ⟨Ideal.Quotient.mk _ F, (e2 F).trans hF⟩

  have k1 : ∀ a, π₁ a = 0 → ∃ g, a = nccwffnzX R 1 * g := by
    intro a ha
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [e1] at ha
    have hF : ∀ k : ℕ, MvPowerSeries.coeff (Finsupp.single 0 k) F = 0 := fun k => by
      rw [← hp0, ha, map_zero]
    obtain ⟨G, rfl⟩ := dvd 0 1 h01 F hF
    exact ⟨Ideal.Quotient.mk _ G, map_mul _ _ _⟩
  have k2 : ∀ a, π₂ a = 0 → ∃ g, a = nccwffnzX R 0 * g := by
    intro a ha
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [e2] at ha
    have hF : ∀ k : ℕ, MvPowerSeries.coeff (Finsupp.single 1 k) F = 0 := fun k => by
      rw [← hp1, ha, map_zero]
    obtain ⟨G, rfl⟩ := dvd 1 0 h10 F hF
    exact ⟨Ideal.Quotient.mk _ G, map_mul _ _ _⟩

  have nx : nccwffnzX R 0 ≠ 0 := by
    intro h
    have := v1x
    rw [h, map_zero] at this
    exact PowerSeries.X_ne_zero this.symm
  have ny : nccwffnzX R 1 ≠ 0 := by
    intro h
    have := v2y
    rw [h, map_zero] at this
    exact PowerSeries.X_ne_zero this.symm

  have hxy : nccwffnzX R 0 * nccwffnzX R 1 = 0 := by
    show Ideal.Quotient.mk (nccwffnzI R) (MvPowerSeries.X 0) *
      Ideal.Quotient.mk (nccwffnzI R) (MvPowerSeries.X 1) = 0
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton.mpr ⟨1, by simp⟩

  have red : _root_.IsReduced (nccwffQ R 0) := by
    refine ⟨fun a ha => ?_⟩
    have h1 : π₁ a = 0 := (ha.map π₁).eq_zero
    have h2 : π₂ a = 0 := (ha.map π₂).eq_zero
    obtain ⟨g, rfl⟩ := k1 a h1
    rw [map_mul, v2y] at h2
    have hg : π₂ g = 0 := (mul_eq_zero.mp h2).resolve_left PowerSeries.X_ne_zero
    obtain ⟨g', rfl⟩ := k2 g hg
    rw [← mul_assoc, mul_comm (nccwffnzX R 1), hxy, zero_mul]
  exact ⟨π₁, π₂, c1, c2, s1, s2, k1, k2, v1y, v2x, nx, ny, red⟩

theorem nccwffnz_completion_chain : ∀ (L : Type u) [CommRing L] [IsLocalRing L] [IsNoetherianRing L], 2 ≤ ringKrullDim L → ∃ P₀ P₁ P₂ : Ideal (AdicCompletion (IsLocalRing.maximalIdeal L) L), P₀.IsPrime ∧ P₁.IsPrime ∧ P₂.IsPrime ∧ P₀ < P₁ ∧ P₁ < P₂ :=
by
  intro L _ _ _ hdim
  classical

  have h2 : ((2 : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (PrimeSpectrum L) := by
    exact_mod_cast hdim
  obtain ⟨l, hl⟩ := (Order.le_krullDim_iff).mp h2
  have hmono := l.strictMono
  set q0 := l ⟨0, by omega⟩ with hq0
  set q1 := l ⟨1, by omega⟩ with hq1
  set q2 := l ⟨2, by omega⟩ with hq2
  have h01 : q0 < q1 := hmono (by simp [Fin.lt_def])
  have h12 : q1 < q2 := hmono (by simp [Fin.lt_def])
  have h01' : q0.asIdeal < q1.asIdeal := h01
  have h12' : q1.asIdeal < q2.asIdeal := h12

  have h2m : q2.asIdeal ≤ IsLocalRing.maximalIdeal L :=
    IsLocalRing.le_maximalIdeal q2.isPrime.ne_top
  have h1m : q1.asIdeal < IsLocalRing.maximalIdeal L := lt_of_lt_of_le h12' h2m

  haveI := AdicCompletion.flat_of_isNoetherian (IsLocalRing.maximalIdeal L)
  haveI : Algebra.HasGoingDown L (AdicCompletion (IsLocalRing.maximalIdeal L) L) :=
    Algebra.HasGoingDown.of_flat

  set M := RingHom.ker (AdicCompletion.evalOneₐ (IsLocalRing.maximalIdeal L)) with hM
  letI : Field (L ⧸ IsLocalRing.maximalIdeal L) :=
    Ideal.Quotient.field (IsLocalRing.maximalIdeal L)
  haveI hMmax : M.IsMaximal :=
    RingHom.ker_isMaximal_of_surjective (K := L ⧸ IsLocalRing.maximalIdeal L)
      (AdicCompletion.evalOneₐ (IsLocalRing.maximalIdeal L))
      (AdicCompletion.evalOneₐ_surjective _)
  haveI hMp : M.IsPrime := hMmax.isPrime
  haveI hMl : M.LiesOver (IsLocalRing.maximalIdeal L) := by
    rw [Ideal.liesOver_iff, Ideal.under_def]
    ext x
    rw [Ideal.mem_comap, hM, RingHom.mem_ker, AdicCompletion.algebraMap_apply,
      AdicCompletion.evalOneₐ_of, Ideal.Quotient.eq_zero_iff_mem, Algebra.algebraMap_self,
      RingHom.id_apply]

  obtain ⟨P₁, hP₁M, hP₁p, hP₁l⟩ := Ideal.exists_ideal_lt_liesOver_of_lt (p := q1.asIdeal)
    (q := IsLocalRing.maximalIdeal L) M h1m
  haveI := hP₁p
  haveI := hP₁l

  obtain ⟨P₀, hP₀1, hP₀p, -⟩ := Ideal.exists_ideal_lt_liesOver_of_lt (p := q0.asIdeal)
    (q := q1.asIdeal) P₁ h01'
  exact ⟨P₀, P₁, M, hP₀p, hP₁p, hMp, hP₀1, hP₁M⟩

theorem nccwffnz_conductor : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [_root_.IsReduced A] (C : Type u) [CommRing C] [Algebra A C] [Module.Finite A C], (∀ 𝔭 ∈ minimalPrimes A, ∀ c : C, ∃ s ∉ 𝔭, ∃ b : A, s • c = algebraMap A C b) → ∃ h ∈ nonZeroDivisors A, ∀ c : C, ∃ b : A, h • c = algebraMap A C b :=
by
  intro A _ _ _ C _ _ _ hbir
  classical
  let J : Ideal A :=
    { carrier := {a | ∀ c : C, ∃ b : A, a • c = algebraMap A C b}
      add_mem' := by
        intro a a' ha ha' c
        obtain ⟨b, hb⟩ := ha c
        obtain ⟨b', hb'⟩ := ha' c
        exact ⟨b + b', by rw [add_smul, hb, hb', map_add]⟩
      zero_mem' := by
        intro c
        exact ⟨0, by rw [zero_smul, map_zero]⟩
      smul_mem' := by
        intro r a ha c
        obtain ⟨b, hb⟩ := ha c
        exact ⟨r * b, by rw [smul_eq_mul, mul_smul, hb, Algebra.smul_def, map_mul]⟩ }
  have hmem : ∀ a : A, a ∈ J ↔ ∀ c : C, ∃ b : A, a • c = algebraMap A C b := fun a => Iff.rfl

  have huni : ∀ 𝔭 ∈ minimalPrimes A, ¬ J ≤ 𝔭 := by
    intro 𝔭 h𝔭 hJ
    haveI h𝔭p : 𝔭.IsPrime := Ideal.minimalPrimes_isPrime h𝔭
    obtain ⟨S, hS⟩ := Module.Finite.fg_top (R := A) (M := C)
    have hb := hbir 𝔭 h𝔭
    choose σ hσ β hβ using hb
    obtain ⟨s, hs⟩ : ∃ s : A, s = ∏ d ∈ S, σ d := ⟨_, rfl⟩
    have hsp : s ∉ 𝔭 := by
      rw [hs]
      exact Submonoid.prod_mem 𝔭.primeCompl (fun d _ => hσ d)
    have hall : ∀ c ∈ Submodule.span A (S : Set C), ∃ b : A, s • c = algebraMap A C b := by
      intro c hc
      induction hc using Submodule.span_induction with
      | mem x hx =>
        have hx' : x ∈ S := hx
        refine ⟨(∏ d ∈ S.erase x, σ d) * β x, ?_⟩
        rw [hs, ← Finset.prod_erase_mul S σ hx', mul_smul, hβ x, Algebra.smul_def, map_mul]
      | zero => exact ⟨0, by rw [smul_zero, map_zero]⟩
      | add x y _ _ hx hy =>
        obtain ⟨b₁, h₁⟩ := hx
        obtain ⟨b₂, h₂⟩ := hy
        exact ⟨b₁ + b₂, by rw [smul_add, h₁, h₂, map_add]⟩
      | smul a x _ hx =>
        obtain ⟨b, hb⟩ := hx
        exact ⟨a * b, by rw [smul_comm s a x, hb, Algebra.smul_def, map_mul]⟩
    have hsJ : s ∈ J := by
      rw [hmem]
      intro c
      have hc : c ∈ Submodule.span A (S : Set C) := by
        rw [hS]; exact Submodule.mem_top
      exact hall c hc
    exact hsp (hJ hsJ)

  have hfin : (minimalPrimes A).Finite := minimalPrimes.finite_of_isNoetherianRing A
  have hnot : ¬ ((J : Set A) ⊆ ⋃ p ∈ minimalPrimes A, ((id p : Ideal A) : Set A)) := by
    intro hsub
    obtain ⟨p, hp, hJp⟩ := (Ideal.subset_union_prime_finite (f := id) (I := J) hfin ⊥ ⊥
      (fun p hp _ _ => Ideal.minimalPrimes_isPrime hp)).mp hsub
    exact huni p hp hJp
  obtain ⟨h, hJ, hh⟩ := Set.not_subset.mp hnot
  have hh' : ∀ p ∈ minimalPrimes A, h ∉ p := fun p hp hhp => hh (Set.mem_biUnion hp hhp)
  have key : ∀ x : A, h * x = 0 → x = 0 := by
    intro x hx
    have hxs : x ∈ sInf (minimalPrimes A) := by
      rw [Ideal.mem_sInf]
      intro p hp
      have h0 : h * x ∈ p := by rw [hx]; exact p.zero_mem
      exact ((Ideal.minimalPrimes_isPrime hp).mem_or_mem h0).resolve_left (hh' p hp)
    rw [minimalPrimes, Ideal.sInf_minimalPrimes, Ideal.radical_bot_of_isReduced] at hxs
    exact (Ideal.mem_bot).mp hxs
  have hnzd : h ∈ nonZeroDivisors A := by
    refine mem_nonZeroDivisors_iff.mpr ⟨?_, ?_⟩
    · intro x hx
      exact key x hx
    · intro x hx
      exact key x (by rw [mul_comm]; exact hx)
  exact ⟨h, hnzd, (hmem h).mp hJ⟩

theorem nccwff_node_zero_model : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ →
    ∀ (e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (ν zk)))
        (Z.presheaf.stalk (ν zk)) ≃+* nccwffQ R 0),
      e.toRingHom.comp (nccwffSig u (ν zk)) = nccwffPsi R 0 →
      ∃ e' : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk))
        (S.presheaf.stalk zk) ≃+* PowerSeries R,
        e'.toRingHom.comp (nccwffSig (ν ≫ u) zk) = (PowerSeries.C : R →+* PowerSeries R) :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA e he
  classical
  have hA' := hA
  obtain ⟨hcomp, -, ⟨-, -, -, -, -, hE, -⟩, hH, -⟩ := hA'

  have factorPow_evalₐ : ∀ (O : Type u) [CommRing O] (I : Ideal O) {m n : ℕ} (hmn : m ≤ n),
      (Ideal.Quotient.factorPow I hmn).comp (AdicCompletion.evalₐ I n).toRingHom =
        (AdicCompletion.evalₐ I m).toRingHom := by
    intro O _ I m n hmn
    ext x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I O x
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
      AdicCompletion.evalₐ_mk]
    rw [Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have hc := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn c
    rw [Submodule.Quotient.eq] at hc
    have e0 : I ^ m • (⊤ : Submodule O O) = I ^ m := by
      rw [smul_eq_mul, Ideal.mul_top]
    rw [e0] at hc
    exact hc

  have transport : ∀ (O O' : Type u) [CommRing O] [CommRing O'] (I : Ideal O) (J : Ideal O')
      (φ : O ≃+* O'), J = Ideal.map φ I →
      ∃ Φ : AdicCompletion I O ≃+* AdicCompletion J O',
        ∀ x, Φ (algebraMap O _ x) = algebraMap O' _ (φ x) := by
    intro O O' _ _ I J φ hJ
    have hJn : ∀ n : ℕ, J ^ n = Ideal.map φ (I ^ n) := fun n => by rw [Ideal.map_pow, hJ]
    have hIn : ∀ n : ℕ, I ^ n = Ideal.map φ.symm (J ^ n) := fun n => by
      rw [hJn]
      ext x
      rw [Ideal.map_symm, Ideal.mem_comap, Ideal.mem_map_of_equiv]
      constructor
      · intro hx; exact ⟨x, hx, rfl⟩
      · rintro ⟨y, hy, hxy⟩; rw [← φ.injective hxy]; exact hy
    let qq : ∀ n : ℕ, O ⧸ I ^ n ≃+* O' ⧸ J ^ n := fun n => Ideal.quotientEquiv _ _ φ (hJn n)
    let qq' : ∀ n : ℕ, O' ⧸ J ^ n ≃+* O ⧸ I ^ n := fun n =>
      Ideal.quotientEquiv _ _ φ.symm (hIn n)
    have hq : ∀ n x, qq n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (φ x) := fun n x =>
      Ideal.quotientEquiv_mk _ _ _ _ _
    have hq' : ∀ n x, qq' n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (φ.symm x) :=
      fun n x => Ideal.quotientEquiv_mk _ _ _ _ _
    have hF : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow J hle).comp
        ((qq n).toRingHom.comp (AdicCompletion.evalₐ I n).toRingHom) =
        (qq m).toRingHom.comp (AdicCompletion.evalₐ I m).toRingHom := by
      intro m n hle
      rw [← factorPow_evalₐ O I hle, ← RingHom.comp_assoc, ← RingHom.comp_assoc]
      congr 1
      apply Ideal.Quotient.ringHom_ext
      ext x
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hq,
        Ideal.Quotient.factor_mk]
    have hG : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp
        ((qq' n).toRingHom.comp (AdicCompletion.evalₐ J n).toRingHom) =
        (qq' m).toRingHom.comp (AdicCompletion.evalₐ J m).toRingHom := by
      intro m n hle
      rw [← factorPow_evalₐ O' J hle, ← RingHom.comp_assoc, ← RingHom.comp_assoc]
      congr 1
      apply Ideal.Quotient.ringHom_ext
      ext x
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hq',
        Ideal.Quotient.factor_mk]
    let F := AdicCompletion.liftRingHom J _ hF
    let G := AdicCompletion.liftRingHom I _ hG
    have hFe : ∀ n x, AdicCompletion.evalₐ J n (F x) = qq n (AdicCompletion.evalₐ I n x) :=
      fun n x => AdicCompletion.evalₐ_liftRingHom J _ hF n x
    have hGe : ∀ n x, AdicCompletion.evalₐ I n (G x) = qq' n (AdicCompletion.evalₐ J n x) :=
      fun n x => AdicCompletion.evalₐ_liftRingHom I _ hG n x
    have hqq : ∀ n y, qq' n (qq n y) = y := by
      intro n y
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hq, hq', RingEquiv.symm_apply_apply]
    have hqq' : ∀ n y, qq n (qq' n y) = y := by
      intro n y
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [hq', hq, RingEquiv.apply_symm_apply]
    refine ⟨RingEquiv.ofRingHom F G ?_ ?_, ?_⟩
    · refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hFe, hGe, hqq']
    · refine RingHom.ext fun x => ?_
      apply AdicCompletion.ext_evalₐ
      intro n
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hGe, hFe, hqq]
    · intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      show AdicCompletion.evalₐ J n (F _) = _
      rw [hFe]
      simp [hq]

  have hinjc : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O],
      Function.Injective (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) := by
    intro O _ _ _
    rw [injective_iff_map_eq_zero]
    intro a ha
    have hmem : a ∈ ⨅ i, (IsLocalRing.maximalIdeal O) ^ i := by
      rw [Submodule.mem_iInf]
      intro i
      have h1 : AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) i
          (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) a) =
          Ideal.Quotient.mk _ a := by simp
      rw [ha, map_zero] at h1
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1.symm
    rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _
      (IsLocalRing.maximalIdeal.isMaximal O).ne_top] at hmem
    exact hmem

  have hloc : ∀ (D T : Type u) [CommRing D] [CommRing T] [IsLocalRing T] (pr : D →+* T),
      Function.Surjective pr → (∀ d, pr d = 0 → ∃ s, pr s = 1 ∧ s * d = 0) →
      (IsDomain (Localization.AtPrime ((IsLocalRing.maximalIdeal T).comap pr)) ∧
        IsIntegrallyClosed (Localization.AtPrime ((IsLocalRing.maximalIdeal T).comap pr))) →
      IsDomain T ∧ IsIntegrallyClosed T := by
    intro D T _ _ _ pr hprs hprk hDQ
    obtain ⟨hd, hi⟩ := hDQ
    letI : Algebra D T := pr.toAlgebra
    have hQ : ∀ d : D, d ∉ (IsLocalRing.maximalIdeal T).comap pr ↔ IsUnit (pr d) := by
      intro d
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
    haveI : IsLocalization ((IsLocalRing.maximalIdeal T).comap pr).primeCompl T :=
      { map_units := fun y => (hQ y.1).mp y.2
        surj := fun t => by
          obtain ⟨d, rfl⟩ := hprs t
          exact ⟨⟨d, 1⟩, by simp; try rfl⟩
        exists_of_eq := fun {a b} hab => by
          have h0 : pr (a - b) = 0 := by rw [map_sub, sub_eq_zero]; exact hab
          obtain ⟨s, hs1, hs0⟩ := hprk _ h0
          refine ⟨⟨s, (hQ s).mpr (by rw [hs1]; exact isUnit_one)⟩, ?_⟩
          show s * a = s * b
          rw [← sub_eq_zero, ← mul_sub]; exact hs0 }
    let φ := IsLocalization.algEquiv ((IsLocalRing.maximalIdeal T).comap pr).primeCompl
      (Localization.AtPrime ((IsLocalRing.maximalIdeal T).comap pr)) T
    exact ⟨MulEquiv.isDomain _ φ.symm.toMulEquiv, IsIntegrallyClosed.of_equiv φ.toRingEquiv⟩

  have hs3 : ∀ r : R, (ν.stalkMap zk).hom ((Z.presheaf.germ ⊤ (ν zk) trivial).hom
      (wcCnSigma u ⊤ r)) = (S.presheaf.germ ⊤ zk trivial).hom (wcCnSigma (ν ≫ u) ⊤ r) := by
    intro r
    show (ν.stalkMap zk).hom ((Z.presheaf.germ ⊤ (ν zk) trivial).hom
      ((Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op).hom
        (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r)))) =
      (S.presheaf.germ ⊤ zk trivial).hom
        ((S.presheaf.map (homOfLE (le_top : (⊤ : S.Opens) ≤ ⊤)).op).hom
          ((ν ≫ u).appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r)))
    have k1 : ∀ (X : Scheme.{u}) (x : X) (y : Γ(X, ⊤)),
        (X.presheaf.germ ⊤ x trivial).hom
          ((X.presheaf.map (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)).op).hom y) =
        (X.presheaf.germ ⊤ x trivial).hom y := by
      intro X x y
      exact X.presheaf.germ_res_apply (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)) x trivial y
    rw [k1, k1, Scheme.Hom.comp_appTop]
    exact Scheme.Hom.germ_stalkMap_apply ν ⊤ zk trivial
      (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r))

  obtain ⟨π₁, π₂, hπ₁C, hπ₂C, hπ₁s, hπ₂s, hπ₁k, hπ₂k, -, -, hx0, hy0, hQred⟩ :=
    nccwffnz_Q0_structure R
  have hxy : nccwffnzX R 0 * nccwffnzX R 1 = 0 := by
    show Ideal.Quotient.mk (nccwffnzI R) (MvPowerSeries.X 0) *
      Ideal.Quotient.mk (nccwffnzI R) (MvPowerSeries.X 1) = 0
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    have e0 : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) R) =
        MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (0 : R) := by
      rw [map_zero, sub_zero]
    rw [e0]
    exact Ideal.subset_span (Set.mem_singleton _)

  have core : ∀ (A Â C T : Type u) [CommRing A] [CommRing Â] [Algebra A Â]
      [CommRing C] [Algebra A C] [Module.Finite A C] [CommRing T] [IsDomain T]
      (κ : R →+* A) (ιT : C →+* T) (eÂ : Â ≃+* nccwffQ R 0)
      (pr : TensorProduct A Â C →+* T),
      (∀ r, eÂ (algebraMap A Â (κ r)) = nccwffPsi R 0 r) →
      Function.Surjective pr →
