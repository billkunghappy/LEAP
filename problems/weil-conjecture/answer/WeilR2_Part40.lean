    have hXJ : ∀ i, (Ψ₀ : MvPowerSeries (Fin 2) S →+* B) (MvPowerSeries.X i) ∈
        IsLocalRing.maximalIdeal B :=
      Fin.forall_fin_two.mpr ⟨by simpa [hΨ0] using huB, by simpa [hΨ1] using hvB⟩
    have hdec' : ∀ b : B, ∃ (s : S) (b₁ b₂ : B),
        b - ι s - (Ψ₀ : MvPowerSeries (Fin 2) S →+* B) (MvPowerSeries.X 0) * b₁ -
          (Ψ₀ : MvPowerSeries (Fin 2) S →+* B) (MvPowerSeries.X 1) * b₂ ∈
          (IsLocalRing.maximalIdeal S).map ι := by
