  haveI := hιloc
  obtain ⟨π, hπsurj, hπker, hπcomp⟩ := wcpa_dj_nd_fibre_completion_bridge A R φ hε

  have hinjres : Function.Injective (IsLocalRing.ResidueField.map
      (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) := RingHom.injective _
  have hsurjres : Function.Surjective (IsLocalRing.ResidueField.map
      (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) := by
    intro y
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨a, ha⟩ := hÂres b
    refine ⟨IsLocalRing.residue A a, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue]
    have ha' : algebraMap A _ a - b ∈ IsLocalRing.maximalIdeal
