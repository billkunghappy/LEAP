  choose V' hV'le hV'ne hV'eq using fun i => s7 T B L εT V₃.1 (σA i ≫ φ₁) (V₃.1.ι ≫ sB i) k hk (hab i)

  obtain ⟨W, hWdef⟩ : ∃ W : T.Opens, W = V₄.1 ⊓ V₅.1 ⊓ ⨅ i, V' i := ⟨_, rfl⟩
  have hW4 : W ≤ V₄.1 := fun x hx => by rw [hWdef] at hx; exact hx.1.1
  have hW5 : W ≤ V₅.1 := fun x hx => by rw [hWdef] at hx; exact hx.1.2
  have hWi : ∀ i, W ≤ V' i := fun i x hx => by rw [hWdef] at hx; exact iInf_le V' i hx.2
  have hW3 : W ≤ V₃.1 := hW4.trans h43
  have hWne : W ≠ ⊥ := by
