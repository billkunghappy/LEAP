theorem fex_h1_An : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
    IsAdicComplete (IsLocalRing.maximalIdeal A) A → ringKrullDim A = 2 →
    (∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : IsDiscreteValuationRing R) (c : R),
        c ≠ 0 ∧ c ∈ IsLocalRing.maximalIdeal R ∧ IsAdicComplete (IsLocalRing.maximalIdeal R) R ∧
        Nonempty (A ≃+* (MvPowerSeries (Fin 2) R ⧸
          Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}))) →
    ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of A)), IsProper f → AlgebraicGeometry.IsIntegral X →
      (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
      (∃ U : (Spec (.of A)).Opens, U ≠ ⊥ ∧ IsIso (f ∣_ U)) → wcpaDjFexH1 X :=
by
  intro A _ _ _ hAc hdim hAn X f hf hX hnorm hU

  obtain ⟨Y, ρ, hρ, hY, hYst, hU₀, hYH1⟩ := fex_An_resolution A hAc hdim hAn

  obtain ⟨Z, g, h, hZ, hZn, hg, hh, hgV, hhV⟩ := fex_graph_model A hAc hdim X Y f ρ hf hρ hX hY
    hnorm (fun y => (hYst y).2.2.1) hU hU₀
  haveI := hf
  haveI := hρ
  haveI := hg
  haveI := hh

  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian (g ≫ f)
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace (g ≫ f)
  haveI : IsNoetherian Z := ⟨⟩
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace ρ
  have hZaff : ∀ U V : Z.Opens, IsAffineOpen U → IsAffineOpen V → IsAffineOpen (U ⊓ V) := by
    intro U V hU' hV'
    haveI : IsSeparated (Limits.terminal.from Z) := by
      rw [Subsingleton.elim (Limits.terminal.from Z) ((g ≫ f) ≫ Limits.terminal.from _)]
      infer_instance
    exact hU'.inf hV'

  have hP1h : wcpaLccP1 h :=
    fexr_proper_birational_P1 Z Y h hh hZ hY (fun y => (hYst y).2.2.1) hhV
  have hP1g : wcpaLccP1 g := fexr_proper_birational_P1 Z X g hg hZ hX hnorm hgV

  have hle1 : ∀ a : WithBot ℕ∞, a ≤ 2 → a ≠ 2 → a ≤ 1 := by
    intro a h1 h2
    have hlt : a < 2 := lt_of_le_of_ne h1 h2
    induction a using WithBot.recBotCoe with
    | bot => exact bot_le
    | coe m =>
      have hm : m < (2 : ℕ∞) := WithBot.coe_lt_coe.mp hlt
      induction m using ENat.recTopCoe with
      | top => exact absurd hm (not_top_lt)
      | coe n =>
        have hn : n < 2 := by exact_mod_cast hm
        show ((n : ℕ∞) : WithBot ℕ∞) ≤ ((1 : ℕ∞) : WithBot ℕ∞)
        exact WithBot.coe_le_coe.mpr (by exact_mod_cast (by omega : n ≤ 1))

  have hPy : ∀ y : Y, wcpaDjFexH1 (Limits.pullback h (Y.fromSpecStalk y)) := by
    intro y
    obtain ⟨hPint, hPn, hPU⟩ := fex_local_base_change Y Z h hh hY hZ hZn hhV y
    obtain ⟨hnoeth, hreg, -, hd⟩ := hYst y
    haveI := hnoeth
    by_cases h2 : ringKrullDim (Y.presheaf.stalk y) = 2
    · exact fex_h1_regular (Y.presheaf.stalk y) hreg h2 _
        (Limits.pullback.snd h (Y.fromSpecStalk y)) inferInstance hPint hPn hPU
    · exact fex_h1_low_dim (Y.presheaf.stalk y) hreg (hle1 _ hd h2) _
        (Limits.pullback.snd h (Y.fromSpecStalk y)) inferInstance hPint hPn hPU

  obtain ⟨k, V, hVaff, hVtop⟩ : ∃ (k : ℕ) (V : Fin k → Y.Opens), (∀ a, IsAffineOpen (V a)) ∧
      (⨆ a, V a) = ⊤ := by
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
      (fun U : Y.affineOpens => ((U : Y.Opens) : Set Y))
      (fun U => (U : Y.Opens).isOpen) (by
        intro x _
        obtain ⟨U, hU', hxU, -⟩ :=
          (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Y))
            (show x ∈ (⊤ : Y.Opens) from trivial)
        exact Set.mem_iUnion.mpr ⟨⟨U, hU'⟩, hxU⟩)
    refine ⟨t.card, fun a => ((t.equivFin.symm a).1 : Y.Opens), fun a => (t.equivFin.symm a).1.2, ?_⟩
    rw [eq_top_iff]
    intro x _
    obtain ⟨U, hUt, hxU⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨t.equivFin ⟨U, hUt⟩, by simpa using hxU⟩

  have hTw : wcpaDjTwH1 (⟨k, V, fun _ _ => 1⟩ : wcpaDjCoc Y) ⊤ (wcStructMod Y) 0 := by
    apply hYH1
    refine ⟨hVaff, hVtop, fun a => rfl, fun a b c => ?_⟩
    simp

  have hZH1 : wcpaDjFexH1 Z :=
    fexr_leray Z Y h hZaff hP1h k V hVtop
      (fun a => fex_leray_local_affine Z Y h inferInstance inferInstance (V a) (hVaff a)
        (fun y _ => hPy y)) hTw

  exact fexr_leray_inj Z X g hP1g hZH1

theorem fex_fd_height_le_of_birational_ft : ∀ (A B : Type u) [CommRing A] [IsNoetherianRing A] [CommRing B] [IsDomain B] (φ : A →+* B), φ.FiniteType → (∀ b : B, ∃ a t : A, φ t ≠ 0 ∧ φ t * b = φ a) → ∀ P : Ideal B, P.IsPrime → (P.height : WithBot ℕ∞) ≤ ringKrullDim A :=
by
  intro A B _ _ _ _ φ hft hbir P hP
  classical
  have s2 : ∀ (C D : Type u) [CommRing C] [IsDomain C] [IsNoetherianRing C] [CommRing D]
      (ψ : Polynomial C →+* D), Function.Surjective ψ → ∀ t a : C, t ≠ 0 →
      ψ (Polynomial.C t * Polynomial.X - Polynomial.C a) = 0 → ringKrullDim D ≤ ringKrullDim C := by
    intro C D _ _ _ _ ψ hψ t a ht hψf
    have hf0 : (Polynomial.C t * Polynomial.X - Polynomial.C a : Polynomial C) ≠ 0 := by
      intro h
      have := congrArg (fun p => Polynomial.coeff p 1) h
      simp [Polynomial.coeff_sub, Polynomial.coeff_C] at this
      exact ht this
    have hnzd := mem_nonZeroDivisors_of_ne_zero hf0
    have h1 := ringKrullDim_succ_le_of_surjective ψ hψ hnzd hψf
    rw [Polynomial.ringKrullDim_of_isNoetherianRing] at h1
    have hC0 : 0 ≤ ringKrullDim C := ringKrullDim_nonneg_of_nontrivial
    generalize ringKrullDim D = x at h1 ⊢
    generalize ringKrullDim C = y at h1 hC0 ⊢
    induction x using WithBot.recBotCoe with
    | bot => exact bot_le
    | coe d =>
      lift y to ℕ∞ using (ne_bot_of_le_ne_bot (by decide) hC0)
      have h2 : d + 1 ≤ y + 1 := by exact_mod_cast h1
      exact_mod_cast (ENat.add_le_add_iff_right ENat.one_ne_top).mp h2
  have s3 : ∀ (S : Subring B), IsNoetherianRing S → ∀ (s : Finset B),
      (∀ b ∈ s, ∃ t a : B, t ∈ S ∧ a ∈ S ∧ t ≠ 0 ∧ t * b = a) →
      IsNoetherianRing (Subring.closure ((S : Set B) ∪ (s : Set B))) ∧
        ringKrullDim (Subring.closure ((S : Set B) ∪ (s : Set B))) ≤ ringKrullDim S := by
    intro S hS s
    induction s using Finset.induction_on with
    | empty =>
      intro _
      have h : Subring.closure ((S : Set B) ∪ ((∅ : Finset B) : Set B)) = S := by
        rw [Finset.coe_empty, Set.union_empty, Subring.closure_eq]
      let e := RingEquiv.subringCongr h
      exact ⟨isNoetherianRing_of_surjective S _ e.symm.toRingHom e.symm.surjective,
        (ringKrullDim_eq_of_ringEquiv e).le⟩
    | insert b s hbs ih =>
      intro hyp
      obtain ⟨hTN, hTd⟩ := ih (fun x hx => hyp x (Finset.mem_insert_of_mem hx))
      have hle : Subring.closure ((S : Set B) ∪ (s : Set B)) ≤
          Subring.closure ((S : Set B) ∪ ((insert b s : Finset B) : Set B)) :=
        Subring.closure_mono (by
          rw [Finset.coe_insert]; exact Set.union_subset_union_right _ (Set.subset_insert _ _))
      have hb : b ∈ Subring.closure ((S : Set B) ∪ ((insert b s : Finset B) : Set B)) :=
        Subring.subset_closure (by simp)
      let ψ : Polynomial (Subring.closure ((S : Set B) ∪ (s : Set B))) →+*
          Subring.closure ((S : Set B) ∪ ((insert b s : Finset B) : Set B)) :=
        Polynomial.eval₂RingHom (Subring.inclusion hle) ⟨b, hb⟩
      have hST : ∀ x ∈ (S : Set B) ∪ (s : Set B), x ∈ Subring.closure ((S : Set B) ∪ (s : Set B)) :=
        fun x hx => Subring.subset_closure hx
      have hψ : Function.Surjective ψ := by
        have hcl : Subring.closure ((S : Set B) ∪ ((insert b s : Finset B) : Set B)) ≤
            (ψ.range).map (Subring.closure ((S : Set B) ∪ ((insert b s : Finset B) : Set B))).subtype := by
          apply Subring.closure_le.mpr
          intro x hx
          rw [Finset.coe_insert] at hx
          by_cases hxb : x = b
          · subst hxb
            exact Subring.mem_map.mpr ⟨ψ Polynomial.X, ⟨Polynomial.X, rfl⟩, by simp [ψ]⟩
          · have hx' : x ∈ (S : Set B) ∪ (s : Set B) := by
              rcases hx with h | h
              · exact Or.inl h
              · exact Or.inr ((Set.mem_insert_iff.mp h).resolve_left hxb)
            exact Subring.mem_map.mpr ⟨ψ (Polynomial.C ⟨x, hST x hx'⟩), ⟨_, rfl⟩, by simp [ψ]⟩
        intro y
        obtain ⟨z, hz, hzy⟩ := Subring.mem_map.mp (hcl y.2)
        obtain ⟨w, rfl⟩ := hz
        exact ⟨w, Subtype.ext hzy⟩
      haveI := hTN
      haveI : IsNoetherianRing (Subring.closure ((S : Set B) ∪ ((insert b s : Finset B) : Set B))) :=
        isNoetherianRing_of_surjective _ _ ψ hψ
      obtain ⟨t, a, htS, haS, ht0, htb⟩ := hyp b (Finset.mem_insert_self b s)
      have htT := hST t (Or.inl htS)
      have haT := hST a (Or.inl haS)
      have ht' : (⟨t, htT⟩ : Subring.closure ((S : Set B) ∪ (s : Set B))) ≠ 0 :=
        fun h => ht0 (congrArg Subtype.val h)
      have hψf : ψ (Polynomial.C ⟨t, htT⟩ * Polynomial.X - Polynomial.C ⟨a, haT⟩) = 0 := by
        apply Subtype.ext
        simp [ψ, htb]
      exact ⟨inferInstance, (s2 _ _ ψ hψ _ _ ht' hψf).trans hTd⟩
  haveI hSN : IsNoetherianRing φ.range := isNoetherianRing_range φ
  have hSA : ringKrullDim φ.range ≤ ringKrullDim A :=
    ringKrullDim_le_of_surjective φ.rangeRestrict φ.rangeRestrict_surjective
  letI := φ.toAlgebra
  have hft' : Algebra.FiniteType A B := hft
  obtain ⟨s, hs⟩ := hft'.out
  have hcl : Subring.closure (((φ.range : Subring B) : Set B) ∪ (s : Set B)) = ⊤ := by
    have h := congrArg Subalgebra.toSubring hs
    rw [Algebra.adjoin_eq_ring_closure, Algebra.top_toSubring] at h
    rw [← h, RingHom.algebraMap_toAlgebra, RingHom.coe_range]
  obtain ⟨_, hd⟩ := s3 φ.range hSN s (fun b _ => by
    obtain ⟨a₀, t₀, ht₀, he⟩ := hbir b
    exact ⟨φ t₀, φ a₀, RingHom.mem_range_self φ t₀, RingHom.mem_range_self φ a₀, ht₀, he⟩)
  have hB : ringKrullDim (Subring.closure (((φ.range : Subring B) : Set B) ∪ (s : Set B))) =
      ringKrullDim B :=
    ringKrullDim_eq_of_ringEquiv ((RingEquiv.subringCongr hcl).trans Subring.topEquiv)
  calc (P.height : WithBot ℕ∞) ≤ ringKrullDim B := Ideal.height_le_ringKrullDim_of_ne_top hP.ne_top
    _ = _ := hB.symm
    _ ≤ ringKrullDim φ.range := hd
    _ ≤ ringKrullDim A := hSA

theorem fex_fibre_dimension : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
    ringKrullDim A = 2 → ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of A)), IsProper f →
    AlgebraicGeometry.IsIntegral X → (∃ U : (Spec (.of A)).Opens, U ≠ ⊥ ∧ IsIso (f ∣_ U)) →
    topologicalKrullDim ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A}) ≤ 1 :=
by
  intro A _ _ _ hdim X f hf hX hU
  haveI := hf
  haveI := hX
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have s3 : ∀ V : X.Opens, V ≠ ⊥ → ∀ b : Γ(X, V), ∃ a t : A,
      ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appLE ⊤ V le_top).hom t ≠ 0 ∧
      ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appLE ⊤ V le_top).hom t * b =
      ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appLE ⊤ V le_top).hom a := by
    intro V hV b
    obtain ⟨U, hU0, hUiso⟩ := hU
    obtain ⟨p0, hp0⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU0
    obtain ⟨y', hy'⟩ := (f ∣_ U).surjective ⟨p0, hp0⟩
    have hfy' : f y'.1 ∈ U := by
      rw [← morphismRestrict_base_coe, hy']; exact hp0
    obtain ⟨y, hyV, hyU⟩ : ((V : Set X) ∩ (f ⁻¹ᵁ U : Set X)).Nonempty :=
      nonempty_preirreducible_inter V.isOpen (f ⁻¹ᵁ U).isOpen
        ((TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV) ⟨y'.1, hfy'⟩

    have hiso : IsIso (f.stalkMap y) := by
      have e := morphismRestrictStalkMap f U ⟨y, hyU⟩
      have : IsIso (Scheme.Hom.stalkMap (f ∣_ U) ⟨y, hyU⟩) :=
        ((isIso_iff_isIso_stalkMap (f ∣_ U)).mp hUiso).2 _
      exact (Arrow.isIso_iff_isIso_of_isIso e.hom).mp this
    have hsurj : Function.Surjective (f.stalkMap y).hom :=
      (ConcreteCategory.bijective_of_isIso (f.stalkMap y)).2
    set β := (X.presheaf.germ V y hyV).hom b with hβ
    obtain ⟨σ, hσ⟩ := hsurj β
    have hT := isAffineOpen_top (Spec (.of A))
    set z : (⊤ : (Spec (.of A)).Opens) := ⟨f y, trivial⟩ with hz
    letI : Algebra Γ(Spec (.of A), ⊤) ((Spec (.of A)).presheaf.stalk (z : Spec (.of A))) :=
      TopCat.Presheaf.algebra_section_stalk (Spec (.of A)).presheaf z
    haveI := hT.isLocalization_stalk z
    obtain ⟨⟨a', t'⟩, hat⟩ := IsLocalization.mk'_surjective (hT.primeIdealOf z).asIdeal.primeCompl σ
    simp only at hat
    have hspec := IsLocalization.mk'_spec ((Spec (.of A)).presheaf.stalk (z : Spec (.of A))) a' t'
    rw [hat] at hspec
    have hunit : IsUnit (algebraMap Γ(Spec (.of A), ⊤)
        ((Spec (.of A)).presheaf.stalk (z : Spec (.of A))) (t' : Γ(Spec (.of A), ⊤))) :=
      IsLocalization.map_units _ t'

    have hcomp : ∀ s : Γ(Spec (.of A), ⊤),
        (f.stalkMap y).hom (algebraMap Γ(Spec (.of A), ⊤)
          ((Spec (.of A)).presheaf.stalk (z : Spec (.of A))) s) =
        (X.presheaf.germ V y hyV).hom ((f.appLE ⊤ V le_top).hom s) := by
      intro s
      have hc : (Spec (.of A)).presheaf.germ ⊤ (f y) trivial ≫ f.stalkMap y =
          f.appLE ⊤ V le_top ≫ X.presheaf.germ V y hyV := by
        have h1 := Scheme.Hom.germ_stalkMap f ⊤ y trivial
        rw [h1, Scheme.Hom.app_eq_appLE]
        rw [← Scheme.Hom.appLE_map (e := le_top) (i := (homOfLE (show V ≤ f ⁻¹ᵁ ⊤ from le_top)).op)]
        rw [Category.assoc, TopCat.Presheaf.germ_res]
      have := congrArg (fun g => g.hom s) hc
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this
    refine ⟨(Scheme.ΓSpecIso (.of A)).hom a', (Scheme.ΓSpecIso (.of A)).hom t', ?_, ?_⟩
    · have e1 : ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appLE ⊤ V le_top).hom
          ((Scheme.ΓSpecIso (.of A)).hom t') = (f.appLE ⊤ V le_top).hom t' := by
        rw [CommRingCat.hom_comp, RingHom.comp_apply]
        congr 1
        exact Iso.hom_inv_id_apply _ _
      rw [e1]
      intro h0
      have h1 := hcomp t'
      rw [h0, map_zero] at h1
      have h2 := hunit.map (f.stalkMap y).hom
      rw [h1] at h2
      exact not_isUnit_zero h2
    · have e1 : ∀ s, ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appLE ⊤ V le_top).hom
          ((Scheme.ΓSpecIso (.of A)).hom s) = (f.appLE ⊤ V le_top).hom s := by
        intro s
        rw [CommRingCat.hom_comp, RingHom.comp_apply]
        congr 1
        exact Iso.hom_inv_id_apply _ _
      rw [e1, e1]
      apply germ_injective_of_isIntegral X y hyV
      rw [map_mul, ← hcomp, ← hcomp, ← hβ, ← hσ, ← map_mul, ← hspec, mul_comm]

  have hcl : ∀ p : Spec (.of A), IsLocalRing.closedPoint A ⤳ p →
      p = IsLocalRing.closedPoint A := by
    intro p hp
    exact hp.mem_closed (IsLocalRing.isClosed_singleton_closedPoint A) rfl

  have hgen : ∃ η : X, (∀ y : X, η ⤳ y) ∧ f η ≠ IsLocalRing.closedPoint A := by
    refine ⟨genericPoint X, fun y => (genericPoint_spec X).specializes (Set.mem_univ y), ?_⟩
    intro hη
    obtain ⟨U, hU0, hUiso⟩ := hU
    haveI := hUiso
    obtain ⟨p0, hp0⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU0
    have hsurj : ∀ p ∈ U, ∃ y : X, f y = p := by
      intro p hp
      obtain ⟨y, hy⟩ := (f ∣_ U).surjective ⟨p, hp⟩
      refine ⟨y.1, ?_⟩
      rw [← morphismRestrict_base_coe, hy]
    have hspec : ∀ y : X, IsLocalRing.closedPoint A ⤳ f y := by
      intro y
      rw [← hη]
      exact ((genericPoint_spec X).specializes (Set.mem_univ y)).map f.continuous
    have hmU : IsLocalRing.closedPoint A ∈ U := by
      obtain ⟨y, hy⟩ := hsurj p0 hp0
      have h1 := hcl _ (hspec y)
      rw [hy] at h1
      rw [← h1]
      exact hp0
    have hall : ∀ p : Spec (.of A), p = IsLocalRing.closedPoint A := by
      intro p
      obtain ⟨y, hy⟩ := hsurj p ((IsLocalRing.specializes_closedPoint p).mem_open U.isOpen hmU)
      rw [← hy]
      exact hcl _ (hspec y)
    haveI : Subsingleton (PrimeSpectrum A) := ⟨fun p q => (hall p).trans (hall q).symm⟩
    have h0 : ringKrullDim A ≤ 0 := Order.krullDim_nonpos_of_subsingleton
    rw [hdim] at h0
    exact absurd h0 (by decide)
  obtain ⟨η, hη, hηm⟩ := hgen

  have hstalk : ∀ x : X, ringKrullDim (X.presheaf.stalk x) ≤ 2 := by
    intro x
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
    have hWne : W ≠ ⊥ := by
      rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
      exact ⟨x, hxW⟩
    haveI : Nonempty W := ⟨⟨x, hxW⟩⟩
    haveI : IsDomain Γ(X, W) := IsIntegral.component_integral W
    have hft : ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appLE ⊤ W le_top).hom.FiniteType := by
      rw [CommRingCat.hom_comp]
      refine RingHom.FiniteType.comp ?_ ?_
      · exact HasRingHomProperty.appLE @LocallyOfFiniteType f inferInstance
          ⟨⊤, isAffineOpen_top _⟩ ⟨W, hW⟩ le_top
      · exact RingHom.FiniteType.of_surjective _ (ConcreteCategory.bijective_of_isIso _).2
    have hbir := s3 W hWne
    set x' : W := ⟨x, hxW⟩ with hx'
    have hP := fex_fd_height_le_of_birational_ft A Γ(X, W) _ hft hbir
      (hW.primeIdealOf x').asIdeal inferInstance
    letI : Algebra Γ(X, W) (X.presheaf.stalk (x' : X)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf x'
    haveI := hW.isLocalization_stalk x'
    have e := IsLocalization.AtPrime.ringKrullDim_eq_height (hW.primeIdealOf x').asIdeal
      (X.presheaf.stalk (x' : X))
    calc ringKrullDim (X.presheaf.stalk x) = ringKrullDim (X.presheaf.stalk (x' : X)) := rfl
      _ = _ := e
      _ ≤ ringKrullDim A := hP
      _ = 2 := hdim

  have hFc : IsClosed (⇑f ⁻¹' {IsLocalRing.closedPoint A}) :=
    (IsLocalRing.isClosed_singleton_closedPoint A).preimage f.continuous
  have hemb := hFc.isClosedEmbedding_subtypeVal

  have hgp : ∀ Z : TopologicalSpace.IrreducibleCloseds ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A}),
      ∃ w : X, IsGenericPoint w (Subtype.val '' (Z : Set ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A}))) := by
    intro Z
    exact QuasiSober.sober (Z.isIrreducible.image _ continuous_subtype_val.continuousOn)
      (hemb.isClosedMap _ Z.isClosed)

  have hstep : ∀ Z Z' : TopologicalSpace.IrreducibleCloseds ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A}),
      Z < Z' → ∀ w w' : X, IsGenericPoint w (Subtype.val '' (Z : Set ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A}))) →
      IsGenericPoint w' (Subtype.val '' (Z' : Set ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A}))) → w' ⤳ w ∧ w' ≠ w := by
    intro Z Z' hZ w w' hw hw'
    refine ⟨hw'.specializes (Set.image_mono hZ.le hw.mem), ?_⟩
    intro hww
    apply hZ.ne
    apply SetLike.coe_injective
    have h1 : Subtype.val '' (Z : Set ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A})) =
        Subtype.val '' (Z' : Set ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A})) := by
      rw [← hw.def, ← hw'.def, hww]
    exact Subtype.val_injective.image_injective h1.symm |>.symm
  have hlt : Order.krullDim (TopologicalSpace.IrreducibleCloseds
      ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A})) < ((2 : ℕ) : WithBot ℕ∞) := by
    rw [Order.krullDim_lt_coe_iff]
    intro l
    by_contra hl
    push_neg at hl
    have h01 : l ⟨0, by omega⟩ < l ⟨1, by omega⟩ := l.strictMono (Fin.mk_lt_mk.mpr (by norm_num))
    have h12 : l ⟨1, by omega⟩ < l ⟨2, by omega⟩ := l.strictMono (Fin.mk_lt_mk.mpr (by norm_num))
    obtain ⟨w0, hw0⟩ := hgp (l ⟨0, by omega⟩)
    obtain ⟨w1, hw1⟩ := hgp (l ⟨1, by omega⟩)
    obtain ⟨w2, hw2⟩ := hgp (l ⟨2, by omega⟩)
    obtain ⟨s10, n10⟩ := hstep _ _ h01 w0 w1 hw0 hw1
    obtain ⟨s21, n21⟩ := hstep _ _ h12 w1 w2 hw1 hw2
    have hw2F : f w2 = IsLocalRing.closedPoint A := by
      obtain ⟨z, -, hz⟩ := hw2.mem
      rw [← hz]
      exact z.2
    have nη : η ≠ w2 := fun h => hηm (h ▸ hw2F)
    have d1 := wcpa_dj_rtsx_dim_lt_of_specializes X η w2 (hη w2) nη
    have d2 := wcpa_dj_rtsx_dim_lt_of_specializes X w2 w1 s21 n21
    have d3 := wcpa_dj_rtsx_dim_lt_of_specializes X w1 w0 s10 n10
    have d0 : 0 ≤ ringKrullDim (X.presheaf.stalk η) := ringKrullDim_nonneg_of_nontrivial
    have d4 := hstalk w0
    generalize ringKrullDim (X.presheaf.stalk η) = a at d0 d1
    generalize ringKrullDim (X.presheaf.stalk w2) = b at d1 d2
    generalize ringKrullDim (X.presheaf.stalk w1) = c at d2 d3
    generalize ringKrullDim (X.presheaf.stalk w0) = d at d3 d4
    lift d to ℕ∞ using (ne_bot_of_gt d3)
    lift c to ℕ∞ using (ne_bot_of_gt d2)
    lift b to ℕ∞ using (ne_bot_of_gt d1)
    lift a to ℕ∞ using (ne_bot_of_le_ne_bot (by decide) d0)
    have hab' : a < b := WithBot.coe_lt_coe.mp d1
    have hbc' : b < c := WithBot.coe_lt_coe.mp d2
    have hcd' : c < d := WithBot.coe_lt_coe.mp d3
    have hd' : d ≤ ((2 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp d4
    have h1 := Order.add_one_le_of_lt hab'
    have h2 := Order.add_one_le_of_lt hbc'
    have h3 := Order.add_one_le_of_lt hcd'
    have h4 : a + 1 + 1 + 1 ≤ ((2 : ℕ) : ℕ∞) := by
      calc a + 1 + 1 + 1 ≤ b + 1 + 1 := by gcongr
        _ ≤ c + 1 := by gcongr
        _ ≤ d := h3
        _ ≤ _ := hd'
    have h5 : ((3 : ℕ) : ℕ∞) ≤ a + 1 + 1 + 1 := by
      have : (0 : ℕ∞) ≤ a := bot_le
      calc ((3 : ℕ) : ℕ∞) = 0 + 1 + 1 + 1 := by norm_num
        _ ≤ a + 1 + 1 + 1 := by gcongr
    have := h5.trans h4
    norm_cast at this
  show Order.krullDim (TopologicalSpace.IrreducibleCloseds
      ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A})) ≤ 1
  generalize Order.krullDim (TopologicalSpace.IrreducibleCloseds
      ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A})) = a at hlt
  induction a using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe e =>
    have h' : e < ((2 : ℕ) : ℕ∞) := WithBot.coe_lt_coe.mp hlt
    have : e ≤ 1 := Order.le_of_lt_add_one (by rw [one_add_one_eq_two]; exact_mod_cast h')
    exact_mod_cast this

theorem fex_rf_pullback_refinement : ∀ (X C : Scheme.{u}) (ι : C ⟶ X), IsClosedImmersion ι → CompactSpace ↥X → ∀ L : wcpaDjCoc C, wcpaDjCocOK L → 0 < L.m → ∃ (m : ℕ) (U : Fin m → X.Opens) (β : Fin m → Fin L.m), (∀ j, IsAffineOpen (U j)) ∧ (⨆ j, U j) = ⊤ ∧ ∀ j, ι ⁻¹ᵁ U j ≤ L.V (β j) :=
by
  intro X C ι hι hX L hL hm
  haveI := hι
  have hcov : (⨆ a, L.V a) = ⊤ := hL.2.1
  have hemb : Topology.IsClosedEmbedding ⇑ι := ι.isClosedEmbedding
  have hloc : ∀ x : X, ∃ (W : X.Opens) (b : Fin L.m),
      IsAffineOpen W ∧ x ∈ W ∧ ι ⁻¹ᵁ W ≤ L.V b := by
    intro x
    by_cases hx : x ∈ Set.range ⇑ι
    · obtain ⟨c, rfl⟩ := hx
      have hc : c ∈ (⨆ a, L.V a) := by rw [hcov]; trivial
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hc
      obtain ⟨O, hO, hOeq⟩ := hemb.isInducing.isOpen_iff.mp (L.V a).isOpen
      have hcO : ι c ∈ (⟨O, hO⟩ : X.Opens) := by
        show ι c ∈ O
        have : c ∈ ⇑ι ⁻¹' O := by rw [hOeq]; exact ha
        exact this
      obtain ⟨W, hWa, hxW, hWO⟩ := exists_isAffineOpen_mem_and_subset hcO
      refine ⟨W, a, hWa, hxW, ?_⟩
      intro z hz
      have h1 : ι z ∈ W := hz
      have h2 : ι z ∈ O := hWO h1
      have h3 : z ∈ ⇑ι ⁻¹' O := h2
      rw [hOeq] at h3
      exact h3
    · have hopen : IsOpen (Set.range ⇑ι)ᶜ := isOpen_compl_iff.mpr hemb.isClosed_range
      have hxO : x ∈ (⟨(Set.range ⇑ι)ᶜ, hopen⟩ : X.Opens) := hx
      obtain ⟨W, hWa, hxW, hWO⟩ := exists_isAffineOpen_mem_and_subset hxO
      refine ⟨W, ⟨0, hm⟩, hWa, hxW, ?_⟩
      intro z hz
      have h1 : ι z ∈ W := hz
      exact absurd ⟨z, rfl⟩ (hWO h1)
  choose W b hWaff hxW hWle using hloc
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (W x : Set X))
    (fun x => (W x).isOpen.mem_nhds (hxW x))
  refine ⟨t.card, fun j => W ((t.equivFin.symm j : t) : X),
    fun j => b ((t.equivFin.symm j : t) : X), fun j => hWaff _, ?_, fun j => hWle _⟩
  rw [eq_top_iff]
  intro y _
  have hy : y ∈ ⋃ x ∈ t, (W x : Set X) := by rw [ht]; trivial
  obtain ⟨x, hxt, hyx⟩ := Set.mem_iUnion₂.mp hy
  refine TopologicalSpace.Opens.mem_iSup.mpr ⟨t.equivFin ⟨x, hxt⟩, ?_⟩
  show y ∈ W ((t.equivFin.symm (t.equivFin ⟨x, hxt⟩) : t) : X)
  rw [Equiv.symm_apply_apply]
  exact hyx

theorem fex_rf_h2_chart_dim : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)), topologicalKrullDim ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A}) ≤ 1 → ∀ (O : X.Opens), IsAffineOpen O → ringKrullDim (Γ(X, O) ⧸ Ideal.map (wcCnSigma f O) (IsLocalRing.maximalIdeal A)) ≤ 1 :=
by
  intro A _ _ X f hdim O hO

  have hpt : ∀ q : PrimeSpectrum Γ(X, O),
      Ideal.map (wcCnSigma f O) (IsLocalRing.maximalIdeal A) ≤ q.asIdeal →
      f (hO.fromSpec q) = IsLocalRing.closedPoint A := by
    intro q hq
    have hxO : hO.fromSpec q ∈ O := by
      have h : hO.fromSpec q ∈ Set.range hO.fromSpec := ⟨q, rfl⟩
      rw [hO.range_fromSpec] at h
      exact h
    have hle : IsLocalRing.maximalIdeal A ≤ (f (hO.fromSpec q)).asIdeal := by
      intro a ha
      by_contra hna
      have h1 : f (hO.fromSpec q) ∈ PrimeSpectrum.basicOpen a := hna
      have h2 : hO.fromSpec q ∈
          X.basicOpen (f.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) := by
        rw [← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine]
        exact h1
      have h3 : hO.fromSpec q ∈ X.basicOpen (wcCnSigma f O a) := by
        rw [show wcCnSigma f O a = (X.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op).hom
          (f.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) from rfl, Scheme.basicOpen_res]
        exact ⟨hxO, h2⟩
      have h4 : q ∈ hO.fromSpec ⁻¹ᵁ X.basicOpen (wcCnSigma f O a) := h3
      rw [hO.fromSpec_preimage_basicOpen] at h4
      exact h4 (hq (Ideal.mem_map_of_mem _ ha))
    have heq : (f (hO.fromSpec q)).asIdeal = IsLocalRing.maximalIdeal A :=
      le_antisymm (IsLocalRing.le_maximalIdeal (f (hO.fromSpec q)).isPrime.ne_top) hle
    exact PrimeSpectrum.ext heq

  haveI := hO.isOpenImmersion_fromSpec
  set J := Ideal.map (wcCnSigma f O) (IsLocalRing.maximalIdeal A) with hJ
  have hc : Topology.IsInducing (PrimeSpectrum.comap (Ideal.Quotient.mk J)) :=
    (PrimeSpectrum.isClosedEmbedding_comap_of_surjective _ (Ideal.Quotient.mk J)
      Ideal.Quotient.mk_surjective).isInducing
  have he : Topology.IsInducing (fun q : PrimeSpectrum Γ(X, O) => hO.fromSpec q) :=
    hO.fromSpec.isOpenEmbedding.isInducing
  have hg := he.comp hc
  have hland : ∀ p : PrimeSpectrum (Γ(X, O) ⧸ J),
      ((fun q : PrimeSpectrum Γ(X, O) => hO.fromSpec q) ∘
        (PrimeSpectrum.comap (Ideal.Quotient.mk J))) p ∈
        ⇑f ⁻¹' {IsLocalRing.closedPoint A} := by
    intro p
    show f (hO.fromSpec (PrimeSpectrum.comap (Ideal.Quotient.mk J) p)) = _
    apply hpt
    intro j hj
    show Ideal.Quotient.mk J j ∈ p.asIdeal
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hj]
    exact p.asIdeal.zero_mem
  have hdimle := (hg.codRestrict hland).topologicalKrullDim_le
  rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim] at hdimle
  exact hdimle.trans hdim

theorem fex_rf_h2_mv : ∀ (X : Scheme.{u}) (𝔟 𝔞 : ∀ W : X.Opens, Ideal Γ(X, W)), (∀ U W : X.Opens, IsAffineOpen U → IsAffineOpen W → IsAffineOpen (U ⊓ W)) → (∀ (W W' : X.Opens), IsAffineOpen W → IsAffineOpen W' → ∀ h : W' ≤ W, 𝔟 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔟 W)) → (∀ (W W' : X.Opens), IsAffineOpen W → IsAffineOpen W' → ∀ h : W' ≤ W, 𝔞 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔞 W)) → (∀ W, 𝔞 W ≤ 𝔟 W) → (∀ (O : X.Opens), IsAffineOpen O → ∀ (n : ℕ) (W : Fin n → X.Opens), (∀ a, IsAffineOpen (W a)) → (∀ a, W a ≤ O) → ∀ θ : ∀ a b : Fin n, Γ(X, W a ⊓ W b), (∀ a b, θ a b ∈ 𝔟 (W a ⊓ W b)) → (∀ a b d, fexRfD1 W θ a b d ∈ 𝔞 (W a ⊓ W b ⊓ W d)) → ∃ κ : ∀ a : Fin n, Γ(X, W a), (∀ a, κ a ∈ 𝔟 (W a)) ∧ ∀ a b, θ a b - fexRfD0 W κ a b ∈ 𝔞 (W a ⊓ W b)) → ∀ {m : ℕ} (V : Fin m → X.Opens), (∀ a, IsAffineOpen (V a)) → ∀ z : ∀ a b d : Fin m, Γ(X, V a ⊓ V b ⊓ V d), (∀ a b d, z a b d ∈ 𝔟 (V a ⊓ V b ⊓ V d)) → (∀ a b d e, fexRfD2 V z a b d e = 0) → ∃ η : ∀ a b : Fin m, Γ(X, V a ⊓ V b), (∀ a b, η a b ∈ 𝔟 (V a ⊓ V b)) ∧ ∀ a b d, z a b d - fexRfD1 V η a b d ∈ 𝔞 (V a ⊓ V b ⊓ V d) :=
by
  intro X 𝔟 𝔞 hinter h𝔟 h𝔞 _ hrel m
  have hres : ∀ {U V' W' : X.Opens} (h1 : V' ≤ U) (h2 : W' ≤ V') (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V' W' h1 h2 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hid : ∀ {U : X.Opens} (h : U ≤ U) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro U h x
    rw [show homOfLE h = 𝟙 U from rfl, op_id, CategoryTheory.Functor.map_id]
    rfl
  have hR : ∀ {Q : X.Opens} (T : X.Opens) (h : T ≤ Q) {x y : Γ(X, Q)}, x = y →
      (X.presheaf.map (homOfLE h).op).hom x = (X.presheaf.map (homOfLE h).op).hom y := by
    intro Q T h x y e
    rw [e]
  have RS : ∀ (𝔠 : ∀ W : X.Opens, Ideal Γ(X, W)), (∀ (W W' : X.Opens), IsAffineOpen W →
      IsAffineOpen W' → ∀ h : W' ≤ W, 𝔠 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔠 W)) →
      ∀ {U U' : X.Opens}, IsAffineOpen U → IsAffineOpen U' → ∀ (h : U' ≤ U) {x : Γ(X, U)},
      x ∈ 𝔠 U → (X.presheaf.map (homOfLE h).op).hom x ∈ 𝔠 U' := by
    intro 𝔠 h𝔠 U U' hU hU' h x hx
    rw [h𝔠 U U' hU hU' h]
    exact Ideal.mem_map_of_mem _ hx
  induction m with
  | zero =>
    intro V _ z _ _
    exact ⟨fun a => (Nat.not_lt_zero _ a.isLt).elim, fun a => (Nat.not_lt_zero _ a.isLt).elim,
      fun a => (Nat.not_lt_zero _ a.isLt).elim⟩
  | succ m ih =>
    intro V hV z hz hδz
    obtain ⟨η', hη'𝔟, hη'z⟩ := ih (fun a => V a.succ) (fun a => hV _)
      (fun a b d => z a.succ b.succ d.succ) (fun a b d => hz _ _ _) (fun a b d e => hδz _ _ _ _)

    obtain ⟨θ, hθdef⟩ : ∃ θ : ∀ a b : Fin m, Γ(X, V 0 ⊓ V a.succ ⊓ (V 0 ⊓ V b.succ)),
        θ = fun a b =>
          (X.presheaf.map (homOfLE (show V 0 ⊓ V a.succ ⊓ (V 0 ⊓ V b.succ) ≤
              V 0 ⊓ V a.succ ⊓ V b.succ by
            intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
            (z 0 a.succ b.succ) -
          (X.presheaf.map (homOfLE (show V 0 ⊓ V a.succ ⊓ (V 0 ⊓ V b.succ) ≤
              V a.succ ⊓ V b.succ by
            intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
            (η' a b) := ⟨_, rfl⟩
    have hθ𝔟 : ∀ a b, θ a b ∈ 𝔟 (V 0 ⊓ V a.succ ⊓ (V 0 ⊓ V b.succ)) := by
      intro a b
      rw [hθdef]
      exact Ideal.sub_mem _
        (RS 𝔟 h𝔟 (by repeat' first | exact hV _ | apply hinter)
          (by repeat' first | exact hV _ | apply hinter) _ (hz _ _ _))
        (RS 𝔟 h𝔟 (by repeat' first | exact hV _ | apply hinter)
          (by repeat' first | exact hV _ | apply hinter) _ (hη'𝔟 a b))
    have hθ𝔞 : ∀ a b d, fexRfD1 (fun a : Fin m => V 0 ⊓ V a.succ) θ a b d ∈
        𝔞 (V 0 ⊓ V a.succ ⊓ (V 0 ⊓ V b.succ) ⊓ (V 0 ⊓ V d.succ)) := by
      intro a b d
      have E := hR (V 0 ⊓ V a.succ ⊓ (V 0 ⊓ V b.succ) ⊓ (V 0 ⊓ V d.succ))
        (by intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)
        (hδz 0 a.succ b.succ d.succ)
      have key : fexRfD1 (fun a : Fin m => V 0 ⊓ V a.succ) θ a b d =
          (X.presheaf.map (homOfLE (show V 0 ⊓ V a.succ ⊓ (V 0 ⊓ V b.succ) ⊓ (V 0 ⊓ V d.succ) ≤
              V a.succ ⊓ V b.succ ⊓ V d.succ by
            intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
            (z a.succ b.succ d.succ - fexRfD1 (fun a : Fin m => V a.succ) η' a b d) := by
        simp only [fexRfD1, fexRfD2, hθdef, map_sub, map_add, map_zero, hres] at E ⊢
        linear_combination -E
      rw [key]
      exact RS 𝔞 h𝔞 (by repeat' first | exact hV _ | apply hinter)
        (by repeat' first | exact hV _ | apply hinter) _ (hη'z a b d)
    obtain ⟨κ, hκ𝔟, hκ⟩ := hrel (V 0) (hV 0) m (fun a => V 0 ⊓ V a.succ)
      (fun a => hinter _ _ (hV 0) (hV _)) (fun a => inf_le_left) θ hθ𝔟 hθ𝔞

    obtain ⟨η, hηdef⟩ : ∃ η : ∀ a b : Fin (m + 1), Γ(X, V a ⊓ V b),
        η = fun a b => Fin.cases (motive := fun a => Γ(X, V a ⊓ V b))
          (Fin.cases (motive := fun b => Γ(X, V 0 ⊓ V b))
            ((X.presheaf.map (homOfLE (show V 0 ⊓ V 0 ≤ V 0 ⊓ V 0 ⊓ V 0 by
              intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
              (z 0 0 0))
            (fun b => (X.presheaf.map (homOfLE (show V 0 ⊓ V b.succ ≤ V 0 ⊓ V 0 ⊓ V b.succ by
              intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
              (z 0 0 b.succ) - κ b) b)
          (fun a => Fin.cases (motive := fun b => Γ(X, V a.succ ⊓ V b))
            ((X.presheaf.map (homOfLE (show V a.succ ⊓ V 0 ≤ V 0 ⊓ V a.succ ⊓ V 0 by
              intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
              (z 0 a.succ 0) +
             (X.presheaf.map (homOfLE (show V a.succ ⊓ V 0 ≤ V 0 ⊓ V a.succ by
              intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
              (κ a))
            (fun b => η' a b) b) a := ⟨_, rfl⟩
    have hη00 : η 0 0 = (X.presheaf.map (homOfLE (show V 0 ⊓ V 0 ≤ V 0 ⊓ V 0 ⊓ V 0 by
        intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
        (z 0 0 0) := by
      rw [hηdef]; simp only [Fin.cases_zero]
    have hη0s : ∀ b : Fin m, η 0 b.succ =
        (X.presheaf.map (homOfLE (show V 0 ⊓ V b.succ ≤ V 0 ⊓ V 0 ⊓ V b.succ by
          intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
          (z 0 0 b.succ) - κ b := by
      intro b; rw [hηdef]; simp only [Fin.cases_zero, Fin.cases_succ]
    have hηs0 : ∀ a : Fin m, η a.succ 0 =
        (X.presheaf.map (homOfLE (show V a.succ ⊓ V 0 ≤ V 0 ⊓ V a.succ ⊓ V 0 by
          intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
          (z 0 a.succ 0) +
        (X.presheaf.map (homOfLE (show V a.succ ⊓ V 0 ≤ V 0 ⊓ V a.succ by
          intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
          (κ a) := by
      intro a; rw [hηdef]; simp only [Fin.cases_zero, Fin.cases_succ]
    have hηss : ∀ a b : Fin m, η a.succ b.succ = η' a b := by
      intro a b; rw [hηdef]; simp only [Fin.cases_succ]
    have hη𝔟 : ∀ a b, η a b ∈ 𝔟 (V a ⊓ V b) := by
      intro a b
      cases a using Fin.cases with
      | zero =>
        cases b using Fin.cases with
        | zero =>
          rw [hη00]
          exact RS 𝔟 h𝔟 (by repeat' first | exact hV _ | apply hinter)
            (by repeat' first | exact hV _ | apply hinter) _ (hz _ _ _)
        | succ b =>
          rw [hη0s]
          exact Ideal.sub_mem _ (RS 𝔟 h𝔟 (by repeat' first | exact hV _ | apply hinter)
            (by repeat' first | exact hV _ | apply hinter) _ (hz _ _ _)) (hκ𝔟 b)
      | succ a =>
        cases b using Fin.cases with
        | zero =>
          rw [hηs0]
          exact Ideal.add_mem _ (RS 𝔟 h𝔟 (by repeat' first | exact hV _ | apply hinter)
            (by repeat' first | exact hV _ | apply hinter) _ (hz _ _ _))
            (RS 𝔟 h𝔟 (by repeat' first | exact hV _ | apply hinter)
            (by repeat' first | exact hV _ | apply hinter) _ (hκ𝔟 a))
        | succ b =>
          rw [hηss]
          exact hη'𝔟 a b
    refine ⟨η, hη𝔟, fun i j l => ?_⟩
    cases i using Fin.cases with
    | zero =>
      cases j using Fin.cases with
      | zero =>
        cases l using Fin.cases with
        | zero =>

          have key : z 0 0 0 - fexRfD1 V η 0 0 0 = 0 := by
            simp only [fexRfD1, hη00, hres, hid]
            ring
          rw [key]; exact Ideal.zero_mem _
        | succ d =>

          have E := hR (V 0 ⊓ V 0 ⊓ V d.succ)
            (by intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)
            (hδz 0 0 0 d.succ)
          have key : z 0 0 d.succ - fexRfD1 V η 0 0 d.succ = 0 := by
            simp only [fexRfD1, fexRfD2, hη00, hη0s, map_sub, map_add, map_zero, hres, hid]
              at E ⊢
            linear_combination E
          rw [key]; exact Ideal.zero_mem _
      | succ b =>
        cases l using Fin.cases with
        | zero =>

          have E := hR (V 0 ⊓ V b.succ ⊓ V 0)
            (by intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)
            (hδz 0 0 0 b.succ)
          have key : z 0 b.succ 0 - fexRfD1 V η 0 b.succ 0 = 0 := by
            simp only [fexRfD1, fexRfD2, hη00, hη0s, hηs0, map_sub, map_add, map_zero, hres,
              hid] at E ⊢
            linear_combination -E
          rw [key]; exact Ideal.zero_mem _
        | succ d =>

          have E := hR (V 0 ⊓ V b.succ ⊓ V d.succ)
            (by intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)
            (hδz 0 0 b.succ d.succ)
          have key : z 0 b.succ d.succ - fexRfD1 V η 0 b.succ d.succ =
              (X.presheaf.map (homOfLE (show V 0 ⊓ V b.succ ⊓ V d.succ ≤
                  V 0 ⊓ V b.succ ⊓ (V 0 ⊓ V d.succ) by
                intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
                (θ b d - fexRfD0 (fun a : Fin m => V 0 ⊓ V a.succ) κ b d) := by
            simp only [fexRfD0, fexRfD1, fexRfD2, hθdef, hη0s, hηss, map_sub, map_add,
              map_zero, hres, hid] at E ⊢
            linear_combination E
          rw [key]
          exact RS 𝔞 h𝔞 (by repeat' first | exact hV _ | apply hinter)
            (by repeat' first | exact hV _ | apply hinter) _ (hκ b d)
    | succ a =>
      cases j using Fin.cases with
      | zero =>
        cases l using Fin.cases with
        | zero =>

          have E := hR (V a.succ ⊓ V 0 ⊓ V 0)
            (by intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)
            (hδz 0 a.succ 0 0)
          have key : z a.succ 0 0 - fexRfD1 V η a.succ 0 0 = 0 := by
            simp only [fexRfD1, fexRfD2, hη00, hηs0, map_sub, map_add, map_zero, hres, hid]
              at E ⊢
            linear_combination E
          rw [key]; exact Ideal.zero_mem _
        | succ d =>

          have E := hR (V a.succ ⊓ V 0 ⊓ V d.succ)
            (by intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)
            (hδz 0 a.succ 0 d.succ)
          have key : z a.succ 0 d.succ - fexRfD1 V η a.succ 0 d.succ =
              -(X.presheaf.map (homOfLE (show V a.succ ⊓ V 0 ⊓ V d.succ ≤
                  V 0 ⊓ V a.succ ⊓ (V 0 ⊓ V d.succ) by
                intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
                (θ a d - fexRfD0 (fun a : Fin m => V 0 ⊓ V a.succ) κ a d) := by
            simp only [fexRfD0, fexRfD1, fexRfD2, hθdef, hη0s, hηs0, hηss, map_sub, map_add,
              map_zero, hres, hid] at E ⊢
            linear_combination E
          rw [key]
          exact neg_mem (RS 𝔞 h𝔞 (by repeat' first | exact hV _ | apply hinter)
            (by repeat' first | exact hV _ | apply hinter) _ (hκ a d))
      | succ b =>
        cases l using Fin.cases with
        | zero =>

          have E := hR (V a.succ ⊓ V b.succ ⊓ V 0)
            (by intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)
            (hδz 0 a.succ b.succ 0)
          have key : z a.succ b.succ 0 - fexRfD1 V η a.succ b.succ 0 =
              (X.presheaf.map (homOfLE (show V a.succ ⊓ V b.succ ⊓ V 0 ≤
                  V 0 ⊓ V a.succ ⊓ (V 0 ⊓ V b.succ) by
                intro x hx; simp only [TopologicalSpace.Opens.mem_inf] at hx ⊢; tauto)).op).hom
                (θ a b - fexRfD0 (fun a : Fin m => V 0 ⊓ V a.succ) κ a b) := by
            simp only [fexRfD0, fexRfD1, fexRfD2, hθdef, hηs0, hηss, map_sub, map_add,
              map_zero, hres, hid] at E ⊢
            linear_combination E
          rw [key]
          exact RS 𝔞 h𝔞 (by repeat' first | exact hV _ | apply hinter)
            (by repeat' first | exact hV _ | apply hinter) _ (hκ a b)
        | succ d =>

          have h := hη'z a b d
          simp only [fexRfD1] at h ⊢
          simp only [hηss]
          exact h

theorem fex_rf_h2_refine : ∀ (X : Scheme.{u}) (𝔟 𝔞 : ∀ W : X.Opens, Ideal Γ(X, W)), (∀ U W : X.Opens, IsAffineOpen U → IsAffineOpen W → IsAffineOpen (U ⊓ W)) → (∀ (W W' : X.Opens), IsAffineOpen W → IsAffineOpen W' → ∀ h : W' ≤ W, 𝔟 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔟 W)) → (∀ (W W' : X.Opens), IsAffineOpen W → IsAffineOpen W' → ∀ h : W' ≤ W, 𝔞 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔞 W)) → (∀ W, 𝔞 W ≤ 𝔟 W) → ∀ (O : X.Opens), IsAffineOpen O → (∀ (t : ℕ) (g : Fin t → Γ(X, O)), ∀ θ : ∀ a b : Fin t, Γ(X, X.basicOpen (g a) ⊓ X.basicOpen (g b)), (∀ a b, θ a b ∈ 𝔟 (X.basicOpen (g a) ⊓ X.basicOpen (g b))) → (∀ a b d, fexRfD1 (fun i => X.basicOpen (g i)) θ a b d ∈ 𝔞 (X.basicOpen (g a) ⊓ X.basicOpen (g b) ⊓ X.basicOpen (g d))) → ∃ κ : ∀ a : Fin t, Γ(X, X.basicOpen (g a)), (∀ a, κ a ∈ 𝔟 (X.basicOpen (g a))) ∧ ∀ a b, θ a b - fexRfD0 (fun i => X.basicOpen (g i)) κ a b ∈ 𝔞 (X.basicOpen (g a) ⊓ X.basicOpen (g b))) → ∀ (n : ℕ) (W : Fin n → X.Opens), (∀ a, IsAffineOpen (W a)) → (∀ a, W a ≤ O) → ∀ θ : ∀ a b : Fin n, Γ(X, W a ⊓ W b), (∀ a b, θ a b ∈ 𝔟 (W a ⊓ W b)) → (∀ a b d, fexRfD1 W θ a b d ∈ 𝔞 (W a ⊓ W b ⊓ W d)) → ∃ κ : ∀ a : Fin n, Γ(X, W a), (∀ a, κ a ∈ 𝔟 (W a)) ∧ ∀ a b, θ a b - fexRfD0 W κ a b ∈ 𝔞 (W a ⊓ W b) :=
by
  intro X 𝔟 𝔞 hinter h𝔟 h𝔞 _ O hO hbasic n W hW hWO θ hθ hδ
  classical

  have hF : ∀ (U₁ U₂ U₃ : X.Opens) (h1 : U₂ ≤ U₁) (h2 : U₃ ≤ U₂) (h3 : U₃ ≤ U₁) (x : Γ(X, U₁)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE h3).op).hom x := by
    intro U₁ U₂ U₃ h1 h2 h3 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hF' : ∀ (U₁ U₂ U₃ : X.Opens) (h1 : U₂ ≤ U₁) (h2 : U₃ ≤ U₂) (x : Γ(X, U₁)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x :=
    fun U₁ U₂ U₃ h1 h2 x => hF U₁ U₂ U₃ h1 h2 (h2.trans h1) x

  have hstab : ∀ (𝔠 : ∀ W : X.Opens, Ideal Γ(X, W)), (∀ (W W' : X.Opens), IsAffineOpen W →
      IsAffineOpen W' → ∀ h : W' ≤ W, 𝔠 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔠 W)) →
      ∀ (U V : X.Opens), IsAffineOpen U → IsAffineOpen V → ∀ (h : V ≤ U) (x : Γ(X, U)),
      x ∈ 𝔠 U → (X.presheaf.map (homOfLE h).op).hom x ∈ 𝔠 V := by
    intro 𝔠 h𝔠 U V hU hV h x hx
    rw [h𝔠 U V hU hV h]
    exact Ideal.mem_map_of_mem _ hx

  have hUnit : ∀ (Y V : X.Opens) (s : Γ(X, Y)) (h : V ≤ Y), V = X.basicOpen s →
      IsUnit ((X.presheaf.map (homOfLE h).op).hom s) := by
    intro Y V s h hV
    subst hV
    exact RingedSpace.isUnit_res_basicOpen _ _

  have hM : ∀ (𝔠 : ∀ W : X.Opens, Ideal Γ(X, W)), (∀ (W W' : X.Opens), IsAffineOpen W →
      IsAffineOpen W' → ∀ h : W' ≤ W, 𝔠 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔠 W)) →
      ∀ (Y : X.Opens), IsAffineOpen Y →
      ∀ (V : X.Opens) (s : Γ(X, Y)) (h : V ≤ Y), V = X.basicOpen s → ∀ x : Γ(X, Y),
      ((X.presheaf.map (homOfLE h).op).hom x ∈ 𝔠 V ↔ ∃ e : ℕ, s ^ e * x ∈ 𝔠 Y) := by
    intro 𝔠 h𝔠 Y hY V s h hV x
    subst hV
    rw [h𝔠 Y (X.basicOpen s) hY (hY.basicOpen s) h]
    have := hY.isLocalization_basicOpen s
    change algebraMap Γ(X, Y) Γ(X, X.basicOpen s) x ∈
      Ideal.map (algebraMap Γ(X, Y) Γ(X, X.basicOpen s)) (𝔠 Y) ↔ _
    rw [IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers s)]
    constructor
    · rintro ⟨m, hm, hmx⟩
      obtain ⟨e, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hm
      exact ⟨e, hmx⟩
    · rintro ⟨e, he⟩
      exact ⟨s ^ e, Submonoid.mem_powers_iff _ _ |>.mpr ⟨e, rfl⟩, he⟩

  have hN : ∀ (𝔠 : ∀ W : X.Opens, Ideal Γ(X, W)), (∀ (W W' : X.Opens), IsAffineOpen W →
      IsAffineOpen W' → ∀ h : W' ≤ W, 𝔠 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔠 W)) →
      ∀ (Y : X.Opens), IsAffineOpen Y →
      ∀ (V : X.Opens) (s : Γ(X, Y)) (h : V ≤ Y), V = X.basicOpen s → ∀ y ∈ 𝔠 V,
      ∃ (e : ℕ) (x : Γ(X, Y)), x ∈ 𝔠 Y ∧
        (X.presheaf.map (homOfLE h).op).hom (s ^ e) * y = (X.presheaf.map (homOfLE h).op).hom x := by
    intro 𝔠 h𝔠 Y hY V s h hV y hy
    subst hV
    rw [h𝔠 Y (X.basicOpen s) hY (hY.basicOpen s) h] at hy
    have := hY.isLocalization_basicOpen s
    change y ∈ Ideal.map (algebraMap Γ(X, Y) Γ(X, X.basicOpen s)) (𝔠 Y) at hy
    obtain ⟨⟨⟨x, hx⟩, ⟨m, hm⟩⟩, hxy⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers s) Γ(X, X.basicOpen s)).mp hy
    obtain ⟨e, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hm
    exact ⟨e, x, hx, by rw [mul_comm]; exact hxy⟩

  have hspan : ∀ (Y : X.Opens), IsAffineOpen Y → ∀ (t : ℕ) (h : Fin t → Γ(X, Y)),
      Y ≤ ⨆ i, X.basicOpen (h i) → Ideal.span (Set.range h) = ⊤ := by
    intro Y hY t h hcov
    have e : (⨆ f : Set.range h, X.basicOpen (f : Γ(X, Y))) = ⨆ i, X.basicOpen (h i) :=
      iSup_range' (fun f => X.basicOpen f) h
    rw [← hY.iSup_basicOpen_eq_self_iff, e]
    exact le_antisymm (iSup_le fun i => X.basicOpen_le (h i)) hcov

  have hsep : ∀ (Y : X.Opens), IsAffineOpen Y → ∀ (t : ℕ) (h : Fin t → Γ(X, Y))
      (U : Fin t → X.Opens), (∀ i, U i = X.basicOpen (h i)) → Y ≤ ⨆ i, U i →
      ∀ x : Γ(X, Y), (∀ (i : Fin t) (hi : U i ≤ Y),
        (X.presheaf.map (homOfLE hi).op).hom x ∈ 𝔞 (U i)) → x ∈ 𝔞 Y := by
    intro Y hY t h U hU hcov x hx
    have hsp := hspan Y hY t h (hcov.trans (iSup_congr hU).le)
    refine Submodule.mem_of_span_eq_top_of_smul_pow_mem (𝔞 Y) (Set.range h) hsp x ?_
    rintro ⟨_, i, rfl⟩
    have hUY : U i ≤ Y := (hU i).le.trans (X.basicOpen_le (h i))
    obtain ⟨e, he⟩ := (hM 𝔞 h𝔞 Y hY (U i) (h i) hUY (hU i) x).mp (hx i hUY)
    exact ⟨e, by rw [smul_eq_mul]; exact he⟩

  have hglue : ∀ (Y : X.Opens), IsAffineOpen Y → ∀ (t : ℕ) (h : Fin t → Γ(X, Y))
      (U : Fin t → X.Opens), (∀ i, U i = X.basicOpen (h i)) → Y ≤ ⨆ i, U i →
      ∀ μ : ∀ i : Fin t, Γ(X, U i), (∀ i, μ i ∈ 𝔟 (U i)) →
      (∀ i j, fexRfD0 U μ i j ∈ 𝔞 (U i ⊓ U j)) →
      ∃ κ : Γ(X, Y), κ ∈ 𝔟 Y ∧ ∀ (i : Fin t) (hi : U i ≤ Y),
        (X.presheaf.map (homOfLE hi).op).hom κ - μ i ∈ 𝔞 (U i) := by
    intro Y hY t h U hU hcov μ hμ hδμ
    have hUY : ∀ i, U i ≤ Y := fun i => (hU i).le.trans (X.basicOpen_le (h i))
    have hUaff : ∀ i, IsAffineOpen (U i) := fun i => by rw [hU i]; exact hY.basicOpen (h i)

    have h1 : ∀ i, ∃ (e : ℕ) (x : Γ(X, Y)), x ∈ 𝔟 Y ∧
        (X.presheaf.map (homOfLE (hUY i)).op).hom (h i ^ e) * μ i =
          (X.presheaf.map (homOfLE (hUY i)).op).hom x :=
      fun i => hN 𝔟 h𝔟 Y hY (U i) (h i) (hUY i) (hU i) (μ i) (hμ i)
    choose e y hy hey using h1
    obtain ⟨E, hE⟩ : ∃ E : ℕ, E = Finset.univ.sup e := ⟨_, rfl⟩
    have heE : ∀ i, e i ≤ E := fun i => hE ▸ Finset.le_sup (Finset.mem_univ i)
    obtain ⟨y', hy'⟩ : ∃ y' : Fin t → Γ(X, Y), y' = fun i => h i ^ (E - e i) * y i := ⟨_, rfl⟩
    have hy'𝔟 : ∀ i, y' i ∈ 𝔟 Y := fun i => by
      rw [hy']; exact Ideal.mul_mem_left _ _ (hy i)
    have hey' : ∀ i, (X.presheaf.map (homOfLE (hUY i)).op).hom (h i ^ E) * μ i =
        (X.presheaf.map (homOfLE (hUY i)).op).hom (y' i) := by
      intro i
      have hpow : h i ^ E = h i ^ (E - e i) * h i ^ e i := by
        rw [← pow_add, Nat.sub_add_cancel (heE i)]
      rw [hpow, map_mul, mul_assoc, hey i, ← map_mul, hy']

    have hpair : ∀ i j, ∃ l : ℕ, (h i * h j) ^ l * (h i ^ E * y' j - h j ^ E * y' i) ∈ 𝔞 Y := by
      intro i j
      have hij : U i ⊓ U j ≤ Y := inf_le_left.trans (hUY i)
      have eA := congrArg (X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op).hom (hey' i)
      have eB := congrArg (X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op).hom (hey' j)
      rw [map_mul, hF _ _ _ _ _ hij, hF _ _ _ _ _ hij] at eA eB
      have hmem := Ideal.mul_mem_left (𝔞 _)
        ((X.presheaf.map (homOfLE hij).op).hom ((h i * h j) ^ E)) (hδμ i j)
      have hid : (X.presheaf.map (homOfLE hij).op).hom ((h i * h j) ^ E) * fexRfD0 U μ i j =
          (X.presheaf.map (homOfLE hij).op).hom (h i ^ E * y' j - h j ^ E * y' i) := by
        simp only [fexRfD0]
        simp only [map_mul, map_pow, map_sub] at eA eB ⊢
        linear_combination ((X.presheaf.map (homOfLE hij).op).hom (h i)) ^ E * eB -
          ((X.presheaf.map (homOfLE hij).op).hom (h j)) ^ E * eA
      rw [hid] at hmem
      exact (hM 𝔞 h𝔞 Y hY _ (h i * h j) hij (by rw [hU i, hU j, X.basicOpen_mul]) _).mp hmem
    choose l hl using hpair
    obtain ⟨N, hN'⟩ : ∃ N : ℕ, N = Finset.univ.sup (fun p : Fin t × Fin t => l p.1 p.2) :=
      ⟨_, rfl⟩
    have hlN : ∀ i j, l i j ≤ N := fun i j => hN' ▸
      Finset.le_sup (f := fun p : Fin t × Fin t => l p.1 p.2) (Finset.mem_univ (i, j))
    obtain ⟨z, hz⟩ : ∃ z : Fin t → Γ(X, Y), z = fun i => h i ^ N * y' i := ⟨_, rfl⟩
    have hstar : ∀ i j, h i ^ (E + N) * z j - h j ^ (E + N) * z i ∈ 𝔞 Y := by
      intro i j
      have e1 : h i ^ (E + N) * z j - h j ^ (E + N) * z i = (h i * h j) ^ (N - l i j) *
          ((h i * h j) ^ l i j * (h i ^ E * y' j - h j ^ E * y' i)) := by
        rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel (hlN i j)]
        simp only [hz]
        ring
      rw [e1]
      exact Ideal.mul_mem_left _ _ (hl i j)

    have hsp : Ideal.span (Set.range h) = ⊤ := hspan Y hY t h (hcov.trans (iSup_congr hU).le)
    have hspF := Ideal.span_pow_eq_top _ hsp (E + N)
    rw [← Set.range_comp] at hspF
    have h1mem : (1 : Γ(X, Y)) ∈ Ideal.span (Set.range ((fun x => x ^ (E + N)) ∘ h)) := by
      rw [hspF]; exact Submodule.mem_top
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1mem
    simp only [Function.comp_apply] at hc
    have hκ𝔟 : ∑ j, c j * z j ∈ 𝔟 Y := Ideal.sum_mem _ fun j _ =>
      Ideal.mul_mem_left _ _ (by rw [hz]; exact Ideal.mul_mem_left _ _ (hy'𝔟 j))
    have hkey : ∀ i, h i ^ (E + N) * ∑ j, c j * z j - z i ∈ 𝔞 Y := by
      intro i
      have e2 : ∑ j, c j * (h i ^ (E + N) * z j - h j ^ (E + N) * z i) =
          h i ^ (E + N) * ∑ j, c j * z j - z i * ∑ j, c j * h j ^ (E + N) := by
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl (fun j _ => by ring)
      rw [hc, mul_one] at e2
      rw [← e2]
      exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (hstar i j))
    refine ⟨∑ j, c j * z j, hκ𝔟, fun i hi => ?_⟩
    show (X.presheaf.map (homOfLE (hUY i)).op).hom (∑ j, c j * z j) - μ i ∈ 𝔞 (U i)
    have hu : IsUnit ((X.presheaf.map (homOfLE (hUY i)).op).hom (h i ^ (E + N))) := by
      rw [map_pow]; exact (hUnit Y _ (h i) (hUY i) (hU i)).pow _
    rw [← Ideal.unit_mul_mem_iff_mem _ hu]
    have hmem := hstab 𝔞 h𝔞 Y (U i) hY (hUaff i) (hUY i) _ (hkey i)
    convert hmem using 1
    have e3 := hey' i
    simp only [hz, map_mul, map_pow, map_sub] at e3 ⊢
    linear_combination (-((X.presheaf.map (homOfLE (hUY i)).op).hom (h i)) ^ N) * e3

  have hcover : ∃ (t : ℕ) (g : Fin t → Γ(X, O)) (τ : Fin t → Fin n),
      (∀ i, X.basicOpen (g i) ≤ W (τ i)) ∧ ∀ a, W a ≤ ⨆ i, X.basicOpen (g i) := by
    have hfin : ∀ a, ∃ s : Finset {f : Γ(X, O) // X.basicOpen f ≤ W a},
        (W a : Set X) ⊆ ⋃ f ∈ s, (X.basicOpen (f : Γ(X, O)) : Set X) := by
      intro a
      refine (hW a).isCompact.elim_finite_subcover
        (fun f : {f : Γ(X, O) // X.basicOpen f ≤ W a} => (X.basicOpen (f : Γ(X, O)) : Set X))
        (fun f => (X.basicOpen _).isOpen) ?_
      intro x hx
      obtain ⟨f, hf1, hf2⟩ := hO.exists_basicOpen_le (V := W a) ⟨x, hx⟩ (hWO a hx)
      exact Set.mem_iUnion.mpr ⟨⟨f, hf1⟩, hf2⟩
    choose s hs using hfin
    let P : Finset (Σ a : Fin n, {f : Γ(X, O) // X.basicOpen f ≤ W a}) := Finset.univ.sigma s
    let eP := P.equivFin
    refine ⟨P.card, fun i => ((eP.symm i : P) : Σ a : Fin n, {f : Γ(X, O) // X.basicOpen f ≤ W a}).2.1,
      fun i => ((eP.symm i : P) : Σ a : Fin n, {f : Γ(X, O) // X.basicOpen f ≤ W a}).1,
      fun i => ((eP.symm i : P) : Σ a : Fin n, {f : Γ(X, O) // X.basicOpen f ≤ W a}).2.2, ?_⟩
    intro a x hx
    have hx' := hs a hx
    rw [Set.mem_iUnion₂] at hx'
    obtain ⟨f, hf, hxf⟩ := hx'
    have hmem : (⟨a, f⟩ : Σ a : Fin n, {f : Γ(X, O) // X.basicOpen f ≤ W a}) ∈ P :=
      Finset.mem_sigma.mpr ⟨Finset.mem_univ _, hf⟩
    rw [TopologicalSpace.Opens.mem_iSup]
    obtain ⟨i, hi⟩ : ∃ i, eP.symm i = ⟨_, hmem⟩ := ⟨eP ⟨_, hmem⟩, eP.symm_apply_apply _⟩
    refine ⟨i, ?_⟩
    show x ∈ X.basicOpen
      ((eP.symm i : P) : Σ a : Fin n, {f : Γ(X, O) // X.basicOpen f ≤ W a}).2.1
    rw [hi]
    exact hxf

  obtain ⟨t, g, τ, hgW, hcov⟩ := hcover
  have hDaff : ∀ i, IsAffineOpen (X.basicOpen (g i)) := fun i => hO.basicOpen (g i)
  obtain ⟨θ', hθ'def⟩ : ∃ θ' : ∀ i j : Fin t, Γ(X, X.basicOpen (g i) ⊓ X.basicOpen (g j)),
      θ' = fun i j => (X.presheaf.map (homOfLE (inf_le_inf (hgW i) (hgW j))).op).hom
        (θ (τ i) (τ j)) := ⟨_, rfl⟩
  have hθ' : ∀ i j, θ' i j ∈ 𝔟 (X.basicOpen (g i) ⊓ X.basicOpen (g j)) := by
    intro i j
    rw [hθ'def]
    exact hstab 𝔟 h𝔟 _ _ (hinter _ _ (hW _) (hW _)) (hinter _ _ (hDaff i) (hDaff j)) _ _
      (hθ _ _)
  have hδ' : ∀ i j k, fexRfD1 (fun i => X.basicOpen (g i)) θ' i j k ∈
      𝔞 (X.basicOpen (g i) ⊓ X.basicOpen (g j) ⊓ X.basicOpen (g k)) := by
    intro i j k
    have hle : X.basicOpen (g i) ⊓ X.basicOpen (g j) ⊓ X.basicOpen (g k) ≤
        W (τ i) ⊓ W (τ j) ⊓ W (τ k) := inf_le_inf (inf_le_inf (hgW i) (hgW j)) (hgW k)
    have e : fexRfD1 (fun i => X.basicOpen (g i)) θ' i j k =
        (X.presheaf.map (homOfLE hle).op).hom (fexRfD1 W θ (τ i) (τ j) (τ k)) := by
      simp only [hθ'def, fexRfD1, map_sub, map_add, hF']
    rw [e]
    exact hstab 𝔞 h𝔞 _ _ (hinter _ _ (hinter _ _ (hW _) (hW _)) (hW _))
      (hinter _ _ (hinter _ _ (hDaff i) (hDaff j)) (hDaff k)) hle _ (hδ _ _ _)
  obtain ⟨lam, hlam𝔟, hlam⟩ := hbasic t g θ' hθ' hδ'

  obtain ⟨μ, hμdef⟩ : ∃ μ : ∀ (a : Fin n) (i : Fin t), Γ(X, W a ⊓ X.basicOpen (g i)),
      μ = fun a i => (X.presheaf.map (homOfLE (inf_le_right :
          W a ⊓ X.basicOpen (g i) ≤ X.basicOpen (g i))).op).hom (lam i) -
        (X.presheaf.map (homOfLE (inf_le_inf_left (W a) (hgW i))).op).hom (θ a (τ i)) :=
    ⟨_, rfl⟩
  have hμ𝔟 : ∀ a i, μ a i ∈ 𝔟 (W a ⊓ X.basicOpen (g i)) := by
    intro a i
    rw [hμdef]
    exact Ideal.sub_mem _
      (hstab 𝔟 h𝔟 _ _ (hDaff i) (hinter _ _ (hW a) (hDaff i)) _ _ (hlam𝔟 i))
      (hstab 𝔟 h𝔟 _ _ (hinter _ _ (hW a) (hW (τ i))) (hinter _ _ (hW a) (hDaff i)) _ _
        (hθ a (τ i)))
  have hcompat : ∀ a i j, fexRfD0 (fun i => W a ⊓ X.basicOpen (g i)) (μ a) i j ∈
      𝔞 ((W a ⊓ X.basicOpen (g i)) ⊓ (W a ⊓ X.basicOpen (g j))) := by
    intro a i j
    have hV : IsAffineOpen ((W a ⊓ X.basicOpen (g i)) ⊓ (W a ⊓ X.basicOpen (g j))) :=
      hinter _ _ (hinter _ _ (hW a) (hDaff i)) (hinter _ _ (hW a) (hDaff j))
    have hle1 : (W a ⊓ X.basicOpen (g i)) ⊓ (W a ⊓ X.basicOpen (g j)) ≤
        W a ⊓ W (τ i) ⊓ W (τ j) :=
      le_inf (le_inf (inf_le_left.trans inf_le_left)
        ((inf_le_left.trans inf_le_right).trans (hgW i)))
        ((inf_le_right.trans inf_le_right).trans (hgW j))
    have hle2 : (W a ⊓ X.basicOpen (g i)) ⊓ (W a ⊓ X.basicOpen (g j)) ≤
        X.basicOpen (g i) ⊓ X.basicOpen (g j) := inf_le_inf inf_le_right inf_le_right
    have hB := hstab 𝔞 h𝔞 _ _ (hinter _ _ (hinter _ _ (hW a) (hW (τ i))) (hW (τ j))) hV hle1 _
      (hδ a (τ i) (τ j))
    have hA := hstab 𝔞 h𝔞 _ _ (hinter _ _ (hDaff i) (hDaff j)) hV hle2 _ (hlam i j)
    have key : fexRfD0 (fun i => W a ⊓ X.basicOpen (g i)) (μ a) i j =
        (X.presheaf.map (homOfLE hle1).op).hom (fexRfD1 W θ a (τ i) (τ j)) -
        (X.presheaf.map (homOfLE hle2).op).hom
          (θ' i j - fexRfD0 (fun i => X.basicOpen (g i)) lam i j) := by
      simp only [hμdef, hθ'def, fexRfD0, fexRfD1, map_sub, map_add, hF']
      ring
    rw [key]
    exact Ideal.sub_mem _ hB hA
  have hκex : ∀ a, ∃ κa : Γ(X, W a), κa ∈ 𝔟 (W a) ∧ ∀ (i : Fin t)
      (hi : W a ⊓ X.basicOpen (g i) ≤ W a),
      (X.presheaf.map (homOfLE hi).op).hom κa - μ a i ∈ 𝔞 (W a ⊓ X.basicOpen (g i)) := by
    intro a
    refine hglue (W a) (hW a) t (fun i => (X.presheaf.map (homOfLE (hWO a)).op).hom (g i))
      (fun i => W a ⊓ X.basicOpen (g i))
      (fun i => (X.basicOpen_res (g i) (homOfLE (hWO a)).op).symm) ?_ (μ a) (hμ𝔟 a)
      (hcompat a)
    intro x hx
    have hx' := hcov a hx
    rw [TopologicalSpace.Opens.mem_iSup] at hx' ⊢
    obtain ⟨i, hi⟩ := hx'
    exact ⟨i, TopologicalSpace.Opens.mem_inf.mpr ⟨hx, hi⟩⟩
  choose κ hκ𝔟 hκ using hκex
  refine ⟨κ, hκ𝔟, fun a b => ?_⟩
  have hab : W a ⊓ W b ≤ O := inf_le_left.trans (hWO a)
  refine hsep (W a ⊓ W b) (hinter _ _ (hW a) (hW b)) t
    (fun i => (X.presheaf.map (homOfLE hab).op).hom (g i))
    (fun i => W a ⊓ W b ⊓ X.basicOpen (g i))
    (fun i => (X.basicOpen_res (g i) (homOfLE hab).op).symm) ?_ _ ?_
  · intro x hx
    have hx' := hcov a (TopologicalSpace.Opens.mem_inf.mp hx).1
    rw [TopologicalSpace.Opens.mem_iSup] at hx' ⊢
    obtain ⟨i, hi⟩ := hx'
    exact ⟨i, TopologicalSpace.Opens.mem_inf.mpr ⟨hx, hi⟩⟩
  · intro i hi
    show (X.presheaf.map (homOfLE (inf_le_left :
      W a ⊓ W b ⊓ X.basicOpen (g i) ≤ W a ⊓ W b)).op).hom (θ a b - fexRfD0 W κ a b) ∈
        𝔞 (W a ⊓ W b ⊓ X.basicOpen (g i))
    have hV : IsAffineOpen (W a ⊓ W b ⊓ X.basicOpen (g i)) :=
      hinter _ _ (hinter _ _ (hW a) (hW b)) (hDaff i)
    have hle1 : W a ⊓ W b ⊓ X.basicOpen (g i) ≤ W a ⊓ W b ⊓ W (τ i) :=
      le_inf inf_le_left (inf_le_right.trans (hgW i))
    have hle2 : W a ⊓ W b ⊓ X.basicOpen (g i) ≤ W b ⊓ X.basicOpen (g i) :=
      inf_le_inf_right _ inf_le_right
    have hle3 : W a ⊓ W b ⊓ X.basicOpen (g i) ≤ W a ⊓ X.basicOpen (g i) :=
      inf_le_inf_right _ inf_le_left
    have hP := hstab 𝔞 h𝔞 _ _ (hinter _ _ (hinter _ _ (hW a) (hW b)) (hW (τ i))) hV hle1 _
      (hδ a b (τ i))
    have hQb := hstab 𝔞 h𝔞 _ _ (hinter _ _ (hW b) (hDaff i)) hV hle2 _ (hκ b i inf_le_left)
    have hQa := hstab 𝔞 h𝔞 _ _ (hinter _ _ (hW a) (hDaff i)) hV hle3 _ (hκ a i inf_le_left)
    have key : (X.presheaf.map (homOfLE (inf_le_left :
        W a ⊓ W b ⊓ X.basicOpen (g i) ≤ W a ⊓ W b)).op).hom (θ a b - fexRfD0 W κ a b) =
        (X.presheaf.map (homOfLE hle1).op).hom (fexRfD1 W θ a b (τ i)) -
        (X.presheaf.map (homOfLE hle2).op).hom
          ((X.presheaf.map (homOfLE (inf_le_left :
            W b ⊓ X.basicOpen (g i) ≤ W b)).op).hom (κ b) - μ b i) +
        (X.presheaf.map (homOfLE hle3).op).hom
          ((X.presheaf.map (homOfLE (inf_le_left :
            W a ⊓ X.basicOpen (g i) ≤ W a)).op).hom (κ a) - μ a i) := by
      simp only [hμdef, fexRfD0, fexRfD1, map_sub, map_add, hF']
      ring
    rw [key]
    exact Ideal.add_mem _ (Ideal.sub_mem _ hP hQb) hQa

theorem fex_rf_h2_basic : ∀ (X : Scheme.{u}) (𝔟 𝔞 : ∀ W : X.Opens, Ideal Γ(X, W)), (∀ (W W' : X.Opens), IsAffineOpen W → IsAffineOpen W' → ∀ h : W' ≤ W, 𝔟 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔟 W)) → (∀ (W W' : X.Opens), IsAffineOpen W → IsAffineOpen W' → ∀ h : W' ≤ W, 𝔞 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔞 W)) → (∀ W, 𝔞 W ≤ 𝔟 W) → ∀ (O : X.Opens), IsAffineOpen O → (∀ (t k : ℕ) (g : Fin t → Γ(X, O)) (n : Fin t → Fin t → Γ(X, O)), (∀ a b, n a b ∈ 𝔟 O) → (∀ a b d, ∃ l : ℕ, (g a * g b * g d) ^ l * (g a ^ k * n b d - g b ^ k * n a d + g d ^ k * n a b) ∈ 𝔞 O) → ∃ (k' : ℕ) (c : Fin t → Γ(X, O)), (∀ a, c a ∈ 𝔟 O) ∧ ∀ a b, ∃ l : ℕ, (g a * g b) ^ l * ((g a * g b) ^ k' * n a b - (g a * g b) ^ k * (g a ^ k' * c b - g b ^ k' * c a)) ∈ 𝔞 O) → ∀ (t : ℕ) (g : Fin t → Γ(X, O)), ∀ θ : ∀ a b : Fin t, Γ(X, X.basicOpen (g a) ⊓ X.basicOpen (g b)), (∀ a b, θ a b ∈ 𝔟 (X.basicOpen (g a) ⊓ X.basicOpen (g b))) → (∀ a b d, fexRfD1 (fun i => X.basicOpen (g i)) θ a b d ∈ 𝔞 (X.basicOpen (g a) ⊓ X.basicOpen (g b) ⊓ X.basicOpen (g d))) → ∃ κ : ∀ a : Fin t, Γ(X, X.basicOpen (g a)), (∀ a, κ a ∈ 𝔟 (X.basicOpen (g a))) ∧ ∀ a b, θ a b - fexRfD0 (fun i => X.basicOpen (g i)) κ a b ∈ 𝔞 (X.basicOpen (g a) ⊓ X.basicOpen (g b)) :=
by
  intro X 𝔟 𝔞 h𝔟 h𝔞 _ O hO halg t g θ hθ hδ
  classical

  have hF : ∀ (U V W : X.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (h3 : W ≤ U) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE h3).op).hom x := by
    intro U V W h1 h2 h3 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl

  have hUnit : ∀ (V : X.Opens) (s : Γ(X, O)) (h : V ≤ O), V = X.basicOpen s →
      IsUnit ((X.presheaf.map (homOfLE h).op).hom s) := by
    intro V s h hV
    subst hV
    exact RingedSpace.isUnit_res_basicOpen _ _

  have hM : ∀ (𝔠 : ∀ W : X.Opens, Ideal Γ(X, W)), (∀ (W W' : X.Opens), IsAffineOpen W →
      IsAffineOpen W' → ∀ h : W' ≤ W, 𝔠 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔠 W)) →
      ∀ (V : X.Opens) (s : Γ(X, O)) (h : V ≤ O), V = X.basicOpen s → ∀ x : Γ(X, O),
      ((X.presheaf.map (homOfLE h).op).hom x ∈ 𝔠 V ↔ ∃ e : ℕ, s ^ e * x ∈ 𝔠 O) := by
    intro 𝔠 h𝔠 V s h hV x
    subst hV
    rw [h𝔠 O (X.basicOpen s) hO (hO.basicOpen s) h]
    have := hO.isLocalization_basicOpen s
    change algebraMap Γ(X, O) Γ(X, X.basicOpen s) x ∈
      Ideal.map (algebraMap Γ(X, O) Γ(X, X.basicOpen s)) (𝔠 O) ↔ _
    rw [IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers s)]
    constructor
    · rintro ⟨m, hm, hmx⟩
      obtain ⟨e, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hm
      exact ⟨e, hmx⟩
    · rintro ⟨e, he⟩
      exact ⟨s ^ e, Submonoid.mem_powers_iff _ _ |>.mpr ⟨e, rfl⟩, he⟩

  have hN : ∀ (𝔠 : ∀ W : X.Opens, Ideal Γ(X, W)), (∀ (W W' : X.Opens), IsAffineOpen W →
      IsAffineOpen W' → ∀ h : W' ≤ W, 𝔠 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔠 W)) →
      ∀ (V : X.Opens) (s : Γ(X, O)) (h : V ≤ O), V = X.basicOpen s → ∀ y ∈ 𝔠 V,
      ∃ (e : ℕ) (x : Γ(X, O)), x ∈ 𝔠 O ∧
        (X.presheaf.map (homOfLE h).op).hom (s ^ e) * y = (X.presheaf.map (homOfLE h).op).hom x := by
    intro 𝔠 h𝔠 V s h hV y hy
    subst hV
    rw [h𝔠 O (X.basicOpen s) hO (hO.basicOpen s) h] at hy
    have := hO.isLocalization_basicOpen s
    change y ∈ Ideal.map (algebraMap Γ(X, O) Γ(X, X.basicOpen s)) (𝔠 O) at hy
    obtain ⟨⟨⟨x, hx⟩, ⟨m, hm⟩⟩, hxy⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers s) Γ(X, X.basicOpen s)).mp hy
    obtain ⟨e, rfl⟩ := Submonoid.mem_powers_iff _ _ |>.mp hm
    exact ⟨e, x, hx, by rw [mul_comm]; exact hxy⟩

  have hp2 : ∀ a b, X.basicOpen (g a) ⊓ X.basicOpen (g b) ≤ O :=
    fun a b => inf_le_left.trans (X.basicOpen_le (g a))
  have hθN : ∀ a b, ∃ (e : ℕ) (x : Γ(X, O)), x ∈ 𝔟 O ∧
      (X.presheaf.map (homOfLE (hp2 a b)).op).hom ((g a * g b) ^ e) * θ a b =
        (X.presheaf.map (homOfLE (hp2 a b)).op).hom x :=
    fun a b => hN 𝔟 h𝔟 _ (g a * g b) (hp2 a b) (X.basicOpen_mul _ _).symm (θ a b) (hθ a b)
  choose e x hx hex using hθN
  set K : ℕ := Finset.univ.sup (fun p : Fin t × Fin t => e p.1 p.2) with hK
  have heK : ∀ a b, e a b ≤ K := fun a b =>
    Finset.le_sup (f := fun p : Fin t × Fin t => e p.1 p.2) (Finset.mem_univ (a, b))
  set n : Fin t → Fin t → Γ(X, O) := fun a b => (g a * g b) ^ (K - e a b) * x a b with hndef
  have hn𝔟 : ∀ a b, n a b ∈ 𝔟 O := fun a b => Ideal.mul_mem_left _ _ (hx a b)
  have hn : ∀ a b, (X.presheaf.map (homOfLE (hp2 a b)).op).hom ((g a * g b) ^ K) * θ a b =
      (X.presheaf.map (homOfLE (hp2 a b)).op).hom (n a b) := by
    intro a b
    have hpow : (g a * g b) ^ K = (g a * g b) ^ (K - e a b) * (g a * g b) ^ e a b := by
      rw [← pow_add, Nat.sub_add_cancel (heK a b)]
    rw [hpow, map_mul, mul_assoc, hex a b, ← map_mul]

  have hp3 : ∀ a b d, X.basicOpen (g a) ⊓ X.basicOpen (g b) ⊓ X.basicOpen (g d) ≤ O :=
    fun a b d => inf_le_left.trans (inf_le_left.trans (X.basicOpen_le (g a)))
  have hcoc : ∀ a b d, ∃ l : ℕ, (g a * g b * g d) ^ l *
      (g a ^ K * n b d - g b ^ K * n a d + g d ^ K * n a b) ∈ 𝔞 O := by
    intro a b d
    have eA := congrArg (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
      X.basicOpen (g a) ⊓ X.basicOpen (g b) ⊓ X.basicOpen (g d) ≤
        X.basicOpen (g b) ⊓ X.basicOpen (g d))).op).hom (hn b d)
    have eB := congrArg (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
      X.basicOpen (g a) ⊓ X.basicOpen (g b) ⊓ X.basicOpen (g d) ≤
        X.basicOpen (g a) ⊓ X.basicOpen (g d))).op).hom (hn a d)
    have eC := congrArg (X.presheaf.map (homOfLE (inf_le_left :
      X.basicOpen (g a) ⊓ X.basicOpen (g b) ⊓ X.basicOpen (g d) ≤
        X.basicOpen (g a) ⊓ X.basicOpen (g b))).op).hom (hn a b)
    rw [map_mul, hF _ _ _ _ _ (hp3 a b d), hF _ _ _ _ _ (hp3 a b d)] at eA eB eC
    have hmem := Ideal.mul_mem_left (𝔞 _)
      ((X.presheaf.map (homOfLE (hp3 a b d)).op).hom ((g a * g b * g d) ^ K)) (hδ a b d)
    have hid : (X.presheaf.map (homOfLE (hp3 a b d)).op).hom ((g a * g b * g d) ^ K) *
        fexRfD1 (fun i => X.basicOpen (g i)) θ a b d =
        (X.presheaf.map (homOfLE (hp3 a b d)).op).hom
          (g a ^ K * n b d - g b ^ K * n a d + g d ^ K * n a b) := by
      simp only [fexRfD1]
      simp only [map_mul, map_pow, map_sub, map_add] at eA eB eC ⊢
      linear_combination
        ((X.presheaf.map (homOfLE (hp3 a b d)).op).hom (g a)) ^ K * eA -
        ((X.presheaf.map (homOfLE (hp3 a b d)).op).hom (g b)) ^ K * eB +
        ((X.presheaf.map (homOfLE (hp3 a b d)).op).hom (g d)) ^ K * eC
    rw [hid] at hmem
    exact (hM 𝔞 h𝔞 _ (g a * g b * g d) (hp3 a b d)
      (by rw [X.basicOpen_mul, X.basicOpen_mul]) _).mp hmem

  obtain ⟨k', c, hc𝔟, hZ⟩ := halg t K g n hn𝔟 hcoc

  have hU1 : ∀ a, IsUnit ((X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (g a)) :=
    fun a => hUnit _ (g a) _ rfl
  choose w hw using fun a => (hU1 a).exists_left_inv
  refine ⟨fun a => w a ^ k' * (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (c a),
    fun a => ?_, fun a b => ?_⟩
  · refine Ideal.mul_mem_left _ _ ?_
    rw [h𝔟 O _ hO (hO.basicOpen (g a)) (X.basicOpen_le (g a))]
    exact Ideal.mem_map_of_mem _ (hc𝔟 a)
  · have hκ : ∀ a, (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (g a ^ k') *
        (w a ^ k' * (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (c a)) =
        (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (c a) := by
      intro a
      rw [map_pow, ← mul_assoc, ← mul_pow, mul_comm _ (w a), hw, one_pow, one_mul]
    have ea := congrArg (X.presheaf.map (homOfLE (inf_le_left :
      X.basicOpen (g a) ⊓ X.basicOpen (g b) ≤ X.basicOpen (g a))).op).hom (hκ a)
    have eb := congrArg (X.presheaf.map (homOfLE (inf_le_right :
      X.basicOpen (g a) ⊓ X.basicOpen (g b) ≤ X.basicOpen (g b))).op).hom (hκ b)
    rw [map_mul, hF _ _ _ _ _ (hp2 a b), hF _ _ _ _ _ (hp2 a b)] at ea eb
    have eθ := hn a b
    have hu : IsUnit ((X.presheaf.map (homOfLE (hp2 a b)).op).hom ((g a * g b) ^ (K + k'))) := by
      rw [map_pow]
      exact (hUnit _ (g a * g b) (hp2 a b) (X.basicOpen_mul _ _).symm).pow _
    obtain ⟨l, hl⟩ := hZ a b
    have hZmem := (hM 𝔞 h𝔞 _ (g a * g b) (hp2 a b) (X.basicOpen_mul _ _).symm _).mpr ⟨l, hl⟩
    rw [← Ideal.unit_mul_mem_iff_mem _ hu]
    convert hZmem using 1
    simp only [fexRfD0]
    simp only [map_mul, map_pow, map_sub] at ea eb eθ ⊢
    linear_combination
      ((X.presheaf.map (homOfLE (hp2 a b)).op).hom (g a) *
        (X.presheaf.map (homOfLE (hp2 a b)).op).hom (g b)) ^ k' * eθ -
      ((X.presheaf.map (homOfLE (hp2 a b)).op).hom (g a) *
        (X.presheaf.map (homOfLE (hp2 a b)).op).hom (g b)) ^ K *
        ((X.presheaf.map (homOfLE (hp2 a b)).op).hom (g a)) ^ k' * eb +
      ((X.presheaf.map (homOfLE (hp2 a b)).op).hom (g a) *
        (X.presheaf.map (homOfLE (hp2 a b)).op).hom (g b)) ^ K *
        ((X.presheaf.map (homOfLE (hp2 a b)).op).hom (g b)) ^ k' * ea

theorem fex_rf_h2_alg : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (J 𝔞 𝔟 : Ideal R), ringKrullDim (R ⧸ J) ≤ 1 → 𝔞 ≤ 𝔟 → J * 𝔟 ≤ 𝔞 → ∀ (t k : ℕ) (g : Fin t → R) (n : Fin t → Fin t → R), (∀ a b, n a b ∈ 𝔟) → (∀ a b d, ∃ l : ℕ, (g a * g b * g d) ^ l * (g a ^ k * n b d - g b ^ k * n a d + g d ^ k * n a b) ∈ 𝔞) → ∃ (k' : ℕ) (c : Fin t → R), (∀ a, c a ∈ 𝔟) ∧ ∀ a b, ∃ l : ℕ, (g a * g b) ^ l * ((g a * g b) ^ k' * n a b - (g a * g b) ^ k * (g a ^ k' * c b - g b ^ k' * c a)) ∈ 𝔞 :=
by
  intro R _ _ J 𝔞 𝔟 hdim _ hJb

  have raise : ∀ (s x : R) (l L : ℕ), l ≤ L → s ^ l * x ∈ 𝔞 → s ^ L * x ∈ 𝔞 := by
    intro s x l L hl hx
    rw [← Nat.sub_add_cancel hl, pow_add, mul_assoc]
    exact Ideal.mul_mem_left _ _ hx

  have s1 : ∀ P : Ideal R, P.IsPrime → J ≤ P → P ∉ J.minimalPrimes → P.IsMaximal := by
    intro P hP hJP hmin
    have hdim' := hdim
    rw [ringKrullDim_quotient, Order.krullDim_le_one_iff] at hdim'
    let x : PrimeSpectrum.zeroLocus (R := R) (J : Set R) := ⟨⟨P, hP⟩, hJP⟩
    rcases hdim' x with hx | hx
    · exfalso
      obtain ⟨q, hq, hqP⟩ := Ideal.exists_minimalPrimes_le hJP
      let y : PrimeSpectrum.zeroLocus (R := R) (J : Set R) := ⟨⟨q, hq.1.1⟩, hq.1.2⟩
      have hyx : y ≤ x := hqP
      have hxy : x ≤ y := hx hyx
      have hPq : P ≤ q := hxy
      apply hmin
      rwa [le_antisymm hPq hqP]
    · obtain ⟨M, hM, hPM⟩ := Ideal.exists_le_maximal P hP.ne_top
      let z : PrimeSpectrum.zeroLocus (R := R) (J : Set R) := ⟨⟨M, hM.isPrime⟩, hJP.trans hPM⟩
      have hxz : x ≤ z := hPM
      have hMP : M ≤ P := hx hxz
      rwa [le_antisymm hPM hMP]

  have s2 : ∀ p ∈ J.minimalPrimes, ∀ x ∈ p, ∃ v ∉ p, ∃ n : ℕ, v * x ^ n ∈ J := by
    intro p hp x hx
    by_contra hcon
    push_neg at hcon
    have hpp : p.IsPrime := hp.1.1
    have h1 : (1 : R) ∉ p := fun h => hpp.ne_top ((Ideal.eq_top_iff_one p).mpr h)
    let S : Submonoid R :=
      { carrier := {y | ∃ v ∉ p, ∃ n : ℕ, y = v * x ^ n}
        one_mem' := ⟨1, h1, 0, by simp⟩
        mul_mem' := by
          rintro a b ⟨v, hv, n, rfl⟩ ⟨v', hv', n', rfl⟩
          exact ⟨v * v', fun h => (hpp.mem_or_mem h).elim hv hv', n + n', by ring⟩ }
    have hdisj : Disjoint (J : Set R) (S : Set R) := by
      rw [Set.disjoint_left]
      rintro y hyJ ⟨v, hv, n, rfl⟩
      exact hcon v hv n hyJ
    obtain ⟨P, hP, hJP, hPS⟩ := Ideal.exists_le_prime_disjoint J S hdisj
    have hPp : P ≤ p := by
      intro y hy
      by_contra hyp
      exact Set.disjoint_left.mp hPS hy (show y ∈ (S : Set R) from ⟨y, hyp, 0, by simp⟩)
    have hpP : p ≤ P := hp.2 ⟨hP, hJP⟩ hPp
    exact Set.disjoint_left.mp hPS (hpP hx) (show x ∈ (S : Set R) from ⟨1, h1, 1, by simp⟩)

  have s3 : ∀ (p : Ideal R), p.IsPrime → (∀ x ∈ p, ∃ v ∉ p, ∃ n : ℕ, v * x ^ n ∈ J) → ∀ (t e : ℕ) (g y : Fin t → R), (∀ i, y i ∈ 𝔟) → (∀ i j, ∃ l : ℕ, (g i * g j) ^ l * (g j ^ e * y i - g i ^ e * y j) ∈ 𝔞) → ∃ u ∉ p, ∃ m ∈ 𝔟, ∀ i, ∃ l : ℕ, g i ^ l * (u * y i - g i ^ e * m) ∈ 𝔞 := by
    intro p hp hloc t e g y hy hc
    by_cases hA : ∃ a, g a ∉ p
    · obtain ⟨a, ha⟩ := hA
      choose l hl using hc a
      refine ⟨g a ^ (e + Finset.univ.sup l), fun h => ha (hp.mem_of_pow_mem _ h),
        g a ^ (Finset.univ.sup l) * y a, Ideal.mul_mem_left _ _ (hy a),
        fun b => ⟨Finset.univ.sup l, ?_⟩⟩
      have h1 := raise _ _ (l b) (Finset.univ.sup l) (Finset.le_sup (Finset.mem_univ b)) (hl b)
      convert 𝔞.neg_mem h1 using 1
      ring
    · push_neg at hA
      choose v hv n hn using fun i => hloc (g i) (hA i)
      haveI := hp
      refine ⟨∏ i, v i, ?_, 0, 𝔟.zero_mem, fun i => ⟨n i, ?_⟩⟩
      · intro hmem
        obtain ⟨i, _, hi⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
        exact hv i hi
      · have h1 : v i * g i ^ n i * y i ∈ 𝔞 := hJb (Ideal.mul_mem_mul (hn i) (hy i))
        convert Ideal.mul_mem_left 𝔞 (∏ j ∈ Finset.univ.erase i, v j) h1 using 1
        rw [← Finset.mul_prod_erase Finset.univ v (Finset.mem_univ i)]
        ring

  have s4 : ∀ (𝔠 : Ideal R), (∀ P : Ideal R, P.IsPrime → 𝔠 ≤ P → P.IsMaximal) → ∀ h : R, ∃ (N : ℕ) (r : R), h ^ N - h ^ (N + 1) * r ∈ 𝔠 := by
    intro 𝔠 hmax h
    haveI : Ring.KrullDimLE 0 (R ⧸ 𝔠) := Ring.KrullDimLE.mk₀ (fun Q hQ => by
      have h1 : (Q.comap (Ideal.Quotient.mk 𝔠)).IsMaximal := hmax _ (Ideal.IsPrime.comap _) (by
        intro x hx
        rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
        exact Q.zero_mem)
      have h2 := Ideal.map_comap_of_surjective (Ideal.Quotient.mk 𝔠) Ideal.Quotient.mk_surjective Q
      rw [← h2]
      refine Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective ?_
      rw [Ideal.mk_ker]
      intro x hx
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
      exact Q.zero_mem)
    haveI : IsArtinianRing (R ⧸ 𝔠) := isArtinianRing_iff_krullDimLE_zero.mpr inferInstance
    obtain ⟨n, y, hy⟩ := IsArtinian.exists_pow_succ_smul_dvd (Ideal.Quotient.mk 𝔠 h) (1 : R ⧸ 𝔠)
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
    refine ⟨n, r, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    simp only [smul_eq_mul, mul_one] at hy
    rw [map_sub, map_mul, map_pow, map_pow, hy, sub_self]

  have hart : ∀ 𝔠 : Ideal R, J ≤ 𝔠 → (∀ P : Ideal R, P.IsPrime → 𝔠 ≤ P → P ∉ J.minimalPrimes) → ∀ h : R, ∃ (N : ℕ) (r : R), h ^ N - h ^ (N + 1) * r ∈ 𝔠 :=
    fun 𝔠 hJc hnm h => s4 𝔠 (fun P hP hcP => s1 P hP (hJc.trans hcP) (hnm P hP hcP)) h
  have havoid : ∀ (t e : ℕ) (g y : Fin t → R), (∀ i, y i ∈ 𝔟) → (∀ i j, ∃ l : ℕ, (g i * g j) ^ l * (g j ^ e * y i - g i ^ e * y j) ∈ 𝔞) → ∀ p ∈ J.minimalPrimes, ∃ u ∉ p, ∃ m ∈ 𝔟, ∀ i, ∃ l : ℕ, g i ^ l * (u * y i - g i ^ e * m) ∈ 𝔞 :=
    fun t e g y hy hc p hp => s3 p hp.1.1 (s2 p hp) t e g y hy hc

  have hext : ∀ (t : ℕ) (g : Fin t → R) (h : R) (x : Fin t → R) (e : ℕ), (∀ i, x i ∈ 𝔟) → (∀ i j, ∃ l : ℕ, (h * g i * g j) ^ l * (g j ^ e * x i - g i ^ e * x j) ∈ 𝔞) → ∃ (E : ℕ) (s : Fin t → R) (w : R), (∀ i, s i ∈ 𝔟) ∧ w ∈ 𝔟 ∧ (∀ i j, ∃ l : ℕ, (g i * g j) ^ l * (g j ^ E * s i - g i ^ E * s j) ∈ 𝔞) ∧ ∀ i, ∃ l : ℕ, (h * g i) ^ l * ((h * g i) ^ E * x i - (h * g i) ^ e * (h ^ E * s i - g i ^ E * w)) ∈ 𝔞 := by
    intro t g h x e hx hxc
    choose l hl using hxc
    obtain ⟨L, hL⟩ : ∃ L : ℕ, ∀ i j, l i j ≤ L :=
      ⟨Finset.univ.sup (fun p : Fin t × Fin t => l p.1 p.2), fun i j =>
        Finset.le_sup (f := fun p : Fin t × Fin t => l p.1 p.2) (Finset.mem_univ (i, j))⟩
    have hyb : ∀ i, h ^ L * x i ∈ 𝔟 := fun i => Ideal.mul_mem_left _ _ (hx i)
    have hyc : ∀ i j, (g i * g j) ^ L * (g j ^ e * (h ^ L * x i) - g i ^ e * (h ^ L * x j)) ∈ 𝔞 := by
      intro i j
      have h1 := raise _ _ _ _ (hL i j) (hl i j)
      convert h1 using 1
      ring
    let 𝔠 : Ideal R :=
      { carrier := {u | ∃ m ∈ 𝔟, ∀ i, ∃ l : ℕ, g i ^ l * (u * (h ^ L * x i) - g i ^ e * m) ∈ 𝔞}
        add_mem' := by
          rintro u₁ u₂ ⟨m₁, hm₁, h₁⟩ ⟨m₂, hm₂, h₂⟩
          refine ⟨m₁ + m₂, Ideal.add_mem _ hm₁ hm₂, fun i => ?_⟩
          obtain ⟨l₁, hl₁⟩ := h₁ i
          obtain ⟨l₂, hl₂⟩ := h₂ i
          refine ⟨l₁ + l₂, ?_⟩
          have := Ideal.add_mem _ (Ideal.mul_mem_left _ (g i ^ l₂) hl₁)
            (Ideal.mul_mem_left _ (g i ^ l₁) hl₂)
          convert this using 1
          ring
        zero_mem' := ⟨0, 𝔟.zero_mem, fun i => ⟨0, by simp⟩⟩
        smul_mem' := by
          rintro c u ⟨m, hm, hu⟩
          refine ⟨c * m, Ideal.mul_mem_left _ _ hm, fun i => ?_⟩
          obtain ⟨l', hl'⟩ := hu i
          refine ⟨l', ?_⟩
          have := Ideal.mul_mem_left _ c hl'
          rw [smul_eq_mul]
          convert this using 1
          ring }
    have hmem : ∀ u, u ∈ 𝔠 ↔ ∃ m ∈ 𝔟, ∀ i, ∃ l : ℕ, g i ^ l * (u * (h ^ L * x i) - g i ^ e * m) ∈ 𝔞 :=
      fun u => Iff.rfl
    have hJc : J ≤ 𝔠 := by
      intro u hu
      rw [hmem]
      refine ⟨0, 𝔟.zero_mem, fun i => ⟨0, ?_⟩⟩
      convert hJb (Ideal.mul_mem_mul hu (hyb i)) using 1
      ring
    have hnm : ∀ P : Ideal R, P.IsPrime → 𝔠 ≤ P → P ∉ J.minimalPrimes := by
      intro P _ hcP hPmin
      obtain ⟨u, hu, m, hm, hmi⟩ := havoid t e g (fun i => h ^ L * x i) hyb
        (fun i j => ⟨L, hyc i j⟩) P hPmin
      exact hu (hcP ((hmem u).mpr ⟨m, hm, hmi⟩))
    obtain ⟨N, r, hNr⟩ := hart 𝔠 hJc hnm h
    have hpow : ∀ E' : ℕ, h ^ N - h ^ (N + E') * r ^ E' ∈ 𝔠 := by
      intro E'
      induction E' with
      | zero => simp
      | succ E' ih =>
        have := 𝔠.add_mem ih (𝔠.mul_mem_left ((h * r) ^ E') hNr)
        convert this using 1
        ring
    obtain ⟨m, hm, hmi⟩ := (hmem _).mp (hpow (L + e))
    refine ⟨N + (L + e), fun i => g i ^ (N + L) * r ^ (L + e) * (h ^ L * x i), -m,
      fun i => Ideal.mul_mem_left _ _ (hyb i), 𝔟.neg_mem hm, fun i j => ⟨L, ?_⟩, fun i => ?_⟩
    · have := Ideal.mul_mem_left 𝔞 ((g i * g j) ^ (N + L) * r ^ (L + e)) (hyc i j)
      convert this using 1
      ring
    · obtain ⟨li, hli⟩ := hmi i
      refine ⟨li, ?_⟩
      have := Ideal.mul_mem_left 𝔞 (h ^ (e + li) * g i ^ (N + (L + e))) hli
      convert this using 1
      ring

  have hstep : ∀ (t k : ℕ) (g : Fin (t + 1) → R) (n : Fin (t + 1) → Fin (t + 1) → R), (∀ a b, n a b ∈ 𝔟) → (∀ a b d, ∃ l : ℕ, (g a * g b * g d) ^ l * (g a ^ k * n b d - g b ^ k * n a d + g d ^ k * n a b) ∈ 𝔞) → ∀ (k₁ : ℕ) (c' : Fin t → R), (∀ i, c' i ∈ 𝔟) → (∀ i j : Fin t, ∃ l : ℕ, (g i.castSucc * g j.castSucc) ^ l * ((g i.castSucc * g j.castSucc) ^ k₁ * n i.castSucc j.castSucc - (g i.castSucc * g j.castSucc) ^ k * (g i.castSucc ^ k₁ * c' j - g j.castSucc ^ k₁ * c' i)) ∈ 𝔞) → ∃ (k' : ℕ) (c : Fin (t + 1) → R), (∀ a, c a ∈ 𝔟) ∧ ∀ a b, ∃ l : ℕ, (g a * g b) ^ l * ((g a * g b) ^ k' * n a b - (g a * g b) ^ k * (g a ^ k' * c b - g b ^ k' * c a)) ∈ 𝔞 := by
    intro t k g n hn hyp k₁ c' hc' hres
    set S := Fin.last t with hS
    set h := g S with hh
    have hx : ∀ i : Fin t, (h * g i.castSucc) ^ k₁ * n S i.castSucc - h ^ (k + k₁) * g i.castSucc ^ k * c' i ∈ 𝔟 :=
      fun i => Ideal.sub_mem _ (Ideal.mul_mem_left _ _ (hn _ _)) (Ideal.mul_mem_left _ _ (hc' i))
    have hxc : ∀ i j : Fin t, ∃ l : ℕ, (h * g i.castSucc * g j.castSucc) ^ l *
        (g j.castSucc ^ (k + k₁) * ((h * g i.castSucc) ^ k₁ * n S i.castSucc - h ^ (k + k₁) * g i.castSucc ^ k * c' i)
          - g i.castSucc ^ (k + k₁) * ((h * g j.castSucc) ^ k₁ * n S j.castSucc - h ^ (k + k₁) * g j.castSucc ^ k * c' j)) ∈ 𝔞 := by
      intro i j
      obtain ⟨l₁, hl₁⟩ := hyp S i.castSucc j.castSucc
      obtain ⟨l₂, hl₂⟩ := hres i j
      refine ⟨l₁ + l₂, ?_⟩
      have := Ideal.sub_mem _
        (Ideal.mul_mem_left 𝔞 ((h * g i.castSucc * g j.castSucc) ^ (l₂ + k₁)) hl₁)
        (Ideal.mul_mem_left 𝔞 (h ^ (l₁ + l₂ + (k + k₁)) * (g i.castSucc * g j.castSucc) ^ l₁) hl₂)
      convert this using 1
      ring
    obtain ⟨E, s, w, hs, hw, hsc, hrel⟩ := hext t (fun i => g i.castSucc) h _ (k + k₁) hx hxc
    refine ⟨k₁ + E, Fin.lastCases (h ^ k₁ * w) (fun i => g i.castSucc ^ E * c' i + g i.castSucc ^ k₁ * s i),
      fun a => ?_, fun a b => ?_⟩
    · induction a using Fin.lastCases with
      | last => simp only [Fin.lastCases_last]; exact Ideal.mul_mem_left _ _ hw
      | cast i =>
        simp only [Fin.lastCases_castSucc]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hc' i)) (Ideal.mul_mem_left _ _ (hs i))
    · obtain ⟨l₂, hl₂⟩ := hyp S S S
      induction a using Fin.lastCases with
      | last =>
        induction b using Fin.lastCases with
        | last =>
          simp only [Fin.lastCases_last]
          refine ⟨3 * l₂ + k, ?_⟩
          have := Ideal.mul_mem_left 𝔞 (h ^ (3 * l₂ + k + 2 * (k₁ + E))) hl₂
          rw [← hh] at this ⊢
          convert this using 1
          ring
        | cast i =>
          simp only [Fin.lastCases_last, Fin.lastCases_castSucc]
          obtain ⟨l₃, hl₃⟩ := hrel i
          refine ⟨l₃, ?_⟩
          rw [← hh]
          convert hl₃ using 1
          ring
      | cast i =>
        induction b using Fin.lastCases with
        | last =>
          simp only [Fin.lastCases_last, Fin.lastCases_castSucc]
          obtain ⟨l₁, hl₁⟩ := hyp S i.castSucc S
          obtain ⟨l₃, hl₃⟩ := hrel i
          rw [← hh] at hl₁ hl₂ ⊢
          refine ⟨(2 * l₁ + 3 * l₂ + k) + k + l₃, ?_⟩
          have hZ := Ideal.add_mem _
            (Ideal.mul_mem_left 𝔞 (h ^ (3 * l₂ + k) * g i.castSucc ^ (l₁ + 3 * l₂ + k)) hl₁)
            (Ideal.mul_mem_left 𝔞 (h ^ (2 * l₁) * g i.castSucc ^ ((2 * l₁ + 3 * l₂ + k) + k)) hl₂)
          have := Ideal.sub_mem _
            (Ideal.mul_mem_left 𝔞 ((h * g i.castSucc) ^ (l₃ + (k₁ + E)) * g i.castSucc ^ k) hZ)
            (Ideal.mul_mem_left 𝔞 ((h * g i.castSucc) ^ ((2 * l₁ + 3 * l₂ + k) + k)) hl₃)
          convert this using 1
          ring
        | cast j =>
          simp only [Fin.lastCases_castSucc]
          obtain ⟨lB, hlB⟩ := hres i j
          obtain ⟨lC, hlC⟩ := hsc i j
          refine ⟨lB + lC, ?_⟩
          have := Ideal.add_mem _
            (Ideal.mul_mem_left 𝔞 ((g i.castSucc * g j.castSucc) ^ (E + lC)) hlB)
            (Ideal.mul_mem_left 𝔞 ((g i.castSucc * g j.castSucc) ^ ((k + k₁) + lB)) hlC)
          convert this using 1
          ring

  intro t k
  induction t with
  | zero =>
    intro g n _ _
    exact ⟨0, fun i => i.elim0, fun a => a.elim0, fun a => a.elim0⟩
  | succ t ih =>
    intro g n hn hyp
    obtain ⟨k₁, c', hc', hres⟩ := ih (fun i => g i.castSucc) (fun i j => n i.castSucc j.castSucc)
      (fun a b => hn _ _) (fun a b d => hyp _ _ _)
    exact hstep t k g n hn hyp k₁ c' hc' hres

theorem fex_rf_fibre_h2 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)), IsProper f → topologicalKrullDim ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A}) ≤ 1 → ∀ {m : ℕ} (V : Fin m → X.Opens), (∀ a, IsAffineOpen (V a)) → (⨆ a, V a) = ⊤ → ∀ (𝔟 𝔞 : ∀ W : X.Opens, Ideal Γ(X, W)), (∀ (W W' : X.Opens), IsAffineOpen W → IsAffineOpen W' → ∀ h : W' ≤ W, 𝔟 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔟 W)) → (∀ (W W' : X.Opens), IsAffineOpen W → IsAffineOpen W' → ∀ h : W' ≤ W, 𝔞 W' = Ideal.map (X.presheaf.map (homOfLE h).op).hom (𝔞 W)) → (∀ W, 𝔞 W ≤ 𝔟 W) → (∀ W, Ideal.map (wcCnSigma f W) (IsLocalRing.maximalIdeal A) * 𝔟 W ≤ 𝔞 W) → ∀ z : ∀ a b d : Fin m, Γ(X, V a ⊓ V b ⊓ V d), (∀ a b d, z a b d ∈ 𝔟 (V a ⊓ V b ⊓ V d)) → (∀ a b d e, fexRfD2 V z a b d e = 0) → ∃ η : ∀ a b : Fin m, Γ(X, V a ⊓ V b), (∀ a b, η a b ∈ 𝔟 (V a ⊓ V b)) ∧ ∀ a b d, z a b d - fexRfD1 V η a b d ∈ 𝔞 (V a ⊓ V b ⊓ V d) :=
by
  intro A _ _ _ X f hf hdim m V hV _hcov 𝔟 𝔞 h𝔟 h𝔞 h𝔞𝔟 hJ z hz hδz
  haveI := hf
  haveI hsepX : IsSeparated (Limits.terminal.from X) := by
    rw [show Limits.terminal.from X = f ≫ Limits.terminal.from _ from Limits.terminal.hom_ext _ _]
    infer_instance
  have hinter : ∀ U W : X.Opens, IsAffineOpen U → IsAffineOpen W → IsAffineOpen (U ⊓ W) :=
    fun U W hU hW => hU.inf hW
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have hrel : ∀ (O : X.Opens), IsAffineOpen O → ∀ (n : ℕ) (W : Fin n → X.Opens),
      (∀ a, IsAffineOpen (W a)) → (∀ a, W a ≤ O) → ∀ θ : ∀ a b : Fin n, Γ(X, W a ⊓ W b),
      (∀ a b, θ a b ∈ 𝔟 (W a ⊓ W b)) → (∀ a b d, fexRfD1 W θ a b d ∈ 𝔞 (W a ⊓ W b ⊓ W d)) →
      ∃ κ : ∀ a : Fin n, Γ(X, W a), (∀ a, κ a ∈ 𝔟 (W a)) ∧
        ∀ a b, θ a b - fexRfD0 W κ a b ∈ 𝔞 (W a ⊓ W b) := by
    intro O hO
    haveI : IsNoetherianRing Γ(X, O) := IsLocallyNoetherian.component_noetherian ⟨O, hO⟩
    have halg := fex_rf_h2_alg Γ(X, O) (Ideal.map (wcCnSigma f O) (IsLocalRing.maximalIdeal A))
      (𝔞 O) (𝔟 O) (fex_rf_h2_chart_dim A X f hdim O hO) (h𝔞𝔟 O) (hJ O)
    exact fex_rf_h2_refine X 𝔟 𝔞 hinter h𝔟 h𝔞 h𝔞𝔟 O hO
      (fex_rf_h2_basic X 𝔟 𝔞 h𝔟 h𝔞 h𝔞𝔟 O hO halg)
  exact fex_rf_h2_mv X 𝔟 𝔞 hinter h𝔟 h𝔞 h𝔞𝔟 hrel V hV z hz hδz

theorem fex_rf_ar1_bridge : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) (L : wcpaDjCoc X) (J₁ J₂ : Ideal A), J₂ ≤ J₁ → ∀ z : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b), (∀ a b d, fexRfD1 L.V z a b d ∈ Ideal.map (wcCnSigma f (L.V a ⊓ L.V b ⊓ L.V d)) J₂) → (∀ e, wcCbcmD L ⊤ 0 1 ((fun e => (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)) : wcCbcmV L ⊤ e ≤ L.V (e 0) ⊓ L.V (e 1))).op).hom (z (e 0) (e 1))) : wcCbcmC L ⊤ 1) e ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) J₂) ∧ ∀ w' : wcCbcmC L ⊤ 1, (∀ e, w' e ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) J₁) → wcCbcmD L ⊤ 0 1 (((fun e => (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)) : wcCbcmV L ⊤ e ≤ L.V (e 0) ⊓ L.V (e 1))).op).hom (z (e 0) (e 1))) : wcCbcmC L ⊤ 1) - w') = 0 → ∃ w : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b), (∀ a b, w a b ∈ Ideal.map (wcCnSigma f (L.V a ⊓ L.V b)) J₁) ∧ ∀ a b d, fexRfD1 L.V (fun a b => z a b - w a b) a b d = 0 :=
by
  intro A _ X f L J₁ J₂ hJ z hz
  classical

  have hres : ∀ {U V W' : X.Opens} (h1 : V ≤ U) (h2 : W' ≤ V) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
      (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W' h1 h2 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hid : ∀ {U : X.Opens} (h : U ≤ U) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro U h x
    rw [show homOfLE h = 𝟙 U from rfl, op_id, CategoryTheory.Functor.map_id]
    rfl
  have hrt : ∀ {U V : X.Opens} (h1 : V ≤ U) (h2 : U ≤ V) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) = x := by
    intro U V h1 h2 x
    rw [hres, hid]

  have hT : ∀ (y : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b)) {O : X.Opens} (i j i' j' : Fin L.m),
      i = i' → j = j' → ∀ (h : O ≤ L.V i ⊓ L.V j) (h' : O ≤ L.V i' ⊓ L.V j'),
      (X.presheaf.map (homOfLE h).op).hom (y i j) = (X.presheaf.map (homOfLE h').op).hom (y i' j') := by
    intro y O i j i' j' hi hj h h'
    subst hi hj
    rfl
  have hT3 : ∀ (y : ∀ a b d : Fin L.m, Γ(X, L.V a ⊓ L.V b ⊓ L.V d)) {O : X.Opens}
      (i j k i' j' k' : Fin L.m), i = i' → j = j' → k = k' →
      ∀ (h : O ≤ L.V i ⊓ L.V j ⊓ L.V k) (h' : O ≤ L.V i' ⊓ L.V j' ⊓ L.V k'),
      (X.presheaf.map (homOfLE h).op).hom (y i j k) =
        (X.presheaf.map (homOfLE h').op).hom (y i' j' k') := by
    intro y O i j k i' j' k' hi hj hk h h'
    subst hi hj hk
    rfl
  have hCtr : ∀ (c : wcCbcmC L ⊤ 1) (E e : Fin (1 + 1) ↪o Fin L.m), E = e →
      ∀ (O : X.Opens) (h1 : O ≤ wcCbcmV L ⊤ E) (h2 : wcCbcmV L ⊤ e ≤ O),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom (c E)) = c e := by
    intro c E e hE O h1 h2
    subst hE
    rw [hres, hid]

  have hσres : ∀ (V W : X.Opens) (h : W ≤ V),
      (X.presheaf.map (homOfLE h).op).hom.comp (wcCnSigma f V) = wcCnSigma f W := by
    intro V W h
    refine RingHom.ext fun x => ?_
    simp only [wcCnSigma, RingHom.comp_apply]
    exact hres _ _ _
  have s0 : ∀ (J : Ideal A) (U W : X.Opens) (h : W ≤ U) (x : Γ(X, U)),
      x ∈ Ideal.map (wcCnSigma f U) J →
      (X.presheaf.map (homOfLE h).op).hom x ∈ Ideal.map (wcCnSigma f W) J := by
    intro J U W h x hx
    have := Ideal.mem_map_of_mem (X.presheaf.map (homOfLE h).op).hom hx
    rwa [Ideal.map_map, hσres] at this

  have mk2 : ∀ a b : Fin L.m, a < b → ∃ E : Fin (1 + 1) ↪o Fin L.m, E 0 = a ∧ E 1 = b := by
    intro a b hab
    refine ⟨OrderEmbedding.ofStrictMono ![a, b] ?_, rfl, rfl⟩
    refine Fin.strictMono_iff_lt_succ.mpr fun i => ?_
    fin_cases i
    first | exact hab | simpa using hab
  have mk3 : ∀ a b d : Fin L.m, a < b → b < d →
      ∃ E : Fin (1 + 1 + 1) ↪o Fin L.m, E 0 = a ∧ E 1 = b ∧ E 2 = d := by
    intro a b d hab hbd
    refine ⟨OrderEmbedding.ofStrictMono ![a, b, d] ?_, rfl, rfl, rfl⟩
    refine Fin.strictMono_iff_lt_succ.mpr fun i => ?_
    fin_cases i
    · first | exact hab | simpa using hab
    · first | exact hbd | simpa using hbd
  have kE2 : ∀ (E : Fin (1 + 1) ↪o Fin L.m) (a b : Fin L.m), E 0 = a → E 1 = b →
      L.V a ⊓ L.V b ≤ wcCbcmV L ⊤ E := by
    intro E a b h0 h1
    subst h0 h1
    show _ ≤ (⨅ k, L.V (E k)) ⊓ ⊤
    refine le_inf (le_iInf fun k => ?_) le_top
    fin_cases k
    · exact inf_le_left
    · exact inf_le_right
  have hW2 : ∀ (E : Fin (1 + 1) ↪o Fin L.m) (a b : Fin L.m), E 0 = a → E 1 = b →
      wcCbcmV L ⊤ E ≤ L.V a ⊓ L.V b := by
    intro E a b h0 h1
    subst h0 h1
    exact le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1))
  have kE3 : ∀ (E : Fin (1 + 1 + 1) ↪o Fin L.m) (a b d : Fin L.m), E 0 = a → E 1 = b → E 2 = d →
      L.V a ⊓ L.V b ⊓ L.V d ≤ wcCbcmV L ⊤ E := by
    intro E a b d h0 h1 h2
    subst h0 h1 h2
    show _ ≤ (⨅ k, L.V (E k)) ⊓ ⊤
    refine le_inf (le_iInf fun k => ?_) le_top
    fin_cases k
    · exact inf_le_left.trans inf_le_left
    · exact inf_le_left.trans inf_le_right
    · exact inf_le_right
  have hW3 : ∀ (E : Fin (1 + 1 + 1) ↪o Fin L.m) (a b d : Fin L.m), E 0 = a → E 1 = b → E 2 = d →
      wcCbcmV L ⊤ E ≤ L.V a ⊓ L.V b ⊓ L.V d := by
    intro E a b d h0 h1 h2
    subst h0 h1 h2
    exact le_inf (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)))
      (inf_le_left.trans (iInf_le _ 2))

  have s1 : ∀ (y : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b)) (e : Fin (1 + 1 + 1) ↪o Fin L.m),
      wcCbcmD L ⊤ 0 1 ((fun e => (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)) : wcCbcmV L ⊤ e ≤ L.V (e 0) ⊓ L.V (e 1))).op).hom (y (e 0) (e 1))) : wcCbcmC L ⊤ 1) e =
      (X.presheaf.map (homOfLE (le_inf (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1))) (inf_le_left.trans (iInf_le _ 2)) : wcCbcmV L ⊤ e ≤ L.V (e 0) ⊓ L.V (e 1) ⊓ L.V (e 2))).op).hom (fexRfD1 L.V y (e 0) (e 1) (e 2)) := by
    intro y e
    have key : ∀ (s : Fin 2 → Γ(X, wcCbcmV L ⊤ e)) (R P' Q' R' G : Γ(X, wcCbcmV L ⊤ e)),
        s 0 = P' → s 1 = -Q' → G = 1 → R = R' →
        ∑ x, s x + (-1) ^ (1 + 1) * (G * R) = P' - Q' + R' := by
      intro s R P' Q' R' G h0 h1 hG hR
      rw [Fin.sum_univ_two, h0, h1, hG, hR]
      ring
    simp only [wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, fexRfD1, map_add, map_sub]
    refine key _ _ _ _ _ _ ?_ ?_ ?_ ?_
    · show (-1) ^ ((0 : Fin 2) : ℕ) * _ = _
      rw [Fin.val_zero, pow_zero, one_mul, hres, hres]
      try exact hT y _ _ _ _ (by first | rfl | simp [Fin.succAbove]) (by first | rfl | simp [Fin.succAbove]) _ _
    · show (-1) ^ ((1 : Fin 2) : ℕ) * _ = _
      rw [Fin.val_one, pow_one, neg_one_mul, hres, hres]
      try congr 1
      try exact hT y _ _ _ _ (by first | rfl | simp [Fin.succAbove]) (by first | rfl | simp [Fin.succAbove]) _ _
    · rw [pow_zero, map_one]
    · rw [hres, hres]
      try exact hT y _ _ _ _ (by first | rfl | simp [Fin.succAbove]) (by first | rfl | simp [Fin.succAbove]) _ _

  have s5 : ∀ (O : X.Opens) (t : Fin 3 → Fin L.m) (r : Fin 3 → Fin 3 → Γ(X, O)),
      (∀ x y z, t x = t y → r x z = r y z) → (∀ x y, r y x = -r x y) → (∀ x, r x x = 0) →
      (∀ x y z, t x < t y → t y < t z → r y z - r x z + r x y = 0) →
      r 1 2 - r 0 2 + r 0 1 = 0 := by
    intro O t r H1 H2 H3 H4
    have a01 := H2 0 1
    have a02 := H2 0 2
    have a12 := H2 1 2
    rcases eq_or_ne (t 0) (t 1) with h01 | h01
    · linear_combination -H1 0 1 2 h01 + H1 0 1 1 h01 + H3 1
    rcases eq_or_ne (t 1) (t 2) with h12 | h12
    · linear_combination H1 1 2 2 h12 + H3 2 - H1 1 2 0 h12 + a01 - a02
    rcases eq_or_ne (t 0) (t 2) with h02 | h02
    · linear_combination -H1 0 2 2 h02 - H3 2 + H1 0 2 1 h02 + a12
    rcases h01.lt_or_gt with h01 | h01 <;> rcases h12.lt_or_gt with h12 | h12 <;>
      rcases h02.lt_or_gt with h02 | h02
    · linear_combination H4 0 1 2 h01 h12
    · exact absurd ((h01.trans h12).trans h02) (lt_irrefl _)
    · linear_combination -H4 0 2 1 h02 h12 + a12
    · linear_combination H4 2 0 1 h02 h01 + a12 - a02
    · linear_combination -H4 1 0 2 h01 h02 + a01
    · linear_combination H4 1 2 0 h12 h02 - a02 + a01
    · exact absurd (h12.trans (h01.trans h02)) (lt_irrefl _)
    · linear_combination -H4 2 1 0 h12 h01 + a01 - a02 + a12

  have s6 : ∀ (u : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b)), (∀ a, u a a = 0) →
      (∀ a b, u b a = -(X.presheaf.map (homOfLE (le_inf inf_le_right inf_le_left : L.V b ⊓ L.V a ≤ L.V a ⊓ L.V b)).op).hom (u a b)) →
      (∀ a b d, a < b → b < d → fexRfD1 L.V u a b d = 0) → ∀ a b d, fexRfD1 L.V u a b d = 0 := by
    intro u hdiag hanti hsort a b d
    have hO : ∀ x, L.V a ⊓ L.V b ⊓ L.V d ≤ L.V (![a, b, d] x) := by
      intro x
      fin_cases x
      · exact inf_le_left.trans inf_le_left
      · exact inf_le_left.trans inf_le_right
      · exact inf_le_right
    obtain ⟨r, hr⟩ : ∃ r : Fin 3 → Fin 3 → Γ(X, L.V a ⊓ L.V b ⊓ L.V d), ∀ x y, r x y =
        (X.presheaf.map (homOfLE (le_inf (hO x) (hO y))).op).hom
          (u (![a, b, d] x) (![a, b, d] y)) := ⟨_, fun _ _ => rfl⟩
    have H1 : ∀ x y z, ![a, b, d] x = ![a, b, d] y → r x z = r y z := by
      intro x y z h
      rw [hr, hr]
      exact hT u _ _ _ _ h rfl _ _
    have H2 : ∀ x y, r y x = -r x y := by
      intro x y
      rw [hr, hr, hanti (![a, b, d] x) (![a, b, d] y), map_neg, hres]
    have H3 : ∀ x, r x x = 0 := by
      intro x
      rw [hr, hdiag, map_zero]
    have H4 : ∀ x y z, ![a, b, d] x < ![a, b, d] y → ![a, b, d] y < ![a, b, d] z →
        r y z - r x z + r x y = 0 := by
      intro x y z hxy hyz
      have e := congrArg (X.presheaf.map (homOfLE (le_inf (le_inf (hO x) (hO y)) (hO z))).op).hom
        (hsort _ _ _ hxy hyz)
      simp only [fexRfD1, map_add, map_sub, map_zero, hres] at e
      rw [hr, hr, hr]
      exact e
    have key := s5 _ ![a, b, d] r H1 H2 H3 H4
    rw [hr, hr, hr] at key
    simp only [fexRfD1]
    exact key
  refine ⟨fun e => ?_, ?_⟩
  ·
    rw [s1 z e]
    exact s0 J₂ _ _ _ _ (hz (e 0) (e 1) (e 2))
  ·
    intro w' hw' hD

    have alt_lift : ∀ c : wcCbcmC L ⊤ 1, ∃ u : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b),
        (∀ e : Fin (1 + 1) ↪o Fin L.m, (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)) : wcCbcmV L ⊤ e ≤ L.V (e 0) ⊓ L.V (e 1))).op).hom (u (e 0) (e 1)) = c e) ∧
        (∀ a, u a a = 0) ∧
        ∀ a b, u b a = -(X.presheaf.map (homOfLE (le_inf inf_le_right inf_le_left : L.V b ⊓ L.V a ≤ L.V a ⊓ L.V b)).op).hom (u a b) := by
      intro c
      have mk2c := mk2
      choose E2 hE2 using mk2c
      refine ⟨fun a b => if hab : a < b then
          (X.presheaf.map (homOfLE (kE2 (E2 a b hab) a b (hE2 a b hab).1 (hE2 a b hab).2)).op).hom
            (c (E2 a b hab))
        else if hba : b < a then
          -(X.presheaf.map (homOfLE (le_inf inf_le_right inf_le_left : L.V a ⊓ L.V b ≤ L.V b ⊓ L.V a)).op).hom
            ((X.presheaf.map (homOfLE (kE2 (E2 b a hba) b a (hE2 b a hba).1 (hE2 b a hba).2)).op).hom
              (c (E2 b a hba)))
        else 0, ?_, ?_, ?_⟩
      · intro e
        have hlt : e 0 < e 1 := e.strictMono (show (0 : Fin (1 + 1)) < 1 by decide)
        have hEe : E2 (e 0) (e 1) hlt = e := by
          refine RelEmbedding.ext fun x => ?_
          fin_cases x
          · exact (hE2 _ _ hlt).1
          · exact (hE2 _ _ hlt).2
        simp only [dif_pos hlt]
        exact hCtr c _ _ hEe _ _ _
      · intro a
        simp
      · intro a b
        rcases lt_trichotomy a b with h | rfl | h
        · simp only [dif_pos h, dif_neg (lt_asymm h)]
        · simp
        · simp only [dif_pos h, dif_neg (lt_asymm h), map_neg, neg_neg]
          exact (hrt _ _ _).symm
    obtain ⟨u, hρu, hdiag, hanti⟩ := alt_lift
      (((fun e => (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)) : wcCbcmV L ⊤ e ≤ L.V (e 0) ⊓ L.V (e 1))).op).hom (z (e 0) (e 1))) : wcCbcmC L ⊤ 1) - w')
    have hDu : ∀ E : Fin (1 + 1 + 1) ↪o Fin L.m,
        wcCbcmD L ⊤ 0 1 ((fun e => (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)) : wcCbcmV L ⊤ e ≤ L.V (e 0) ⊓ L.V (e 1))).op).hom (u (e 0) (e 1))) : wcCbcmC L ⊤ 1) E = 0 := by
      intro E
      have hfun : ((fun e => (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)) : wcCbcmV L ⊤ e ≤ L.V (e 0) ⊓ L.V (e 1))).op).hom (u (e 0) (e 1))) : wcCbcmC L ⊤ 1) =
          ((fun e => (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)) : wcCbcmV L ⊤ e ≤ L.V (e 0) ⊓ L.V (e 1))).op).hom (z (e 0) (e 1))) : wcCbcmC L ⊤ 1) - w' := by
        funext e
        exact hρu e
      rw [hfun, hD]
      rfl

    have hsort : ∀ a b d, a < b → b < d → fexRfD1 L.V u a b d = 0 := by
      intro a b d hab hbd
      obtain ⟨E, hE0, hE1, hE2⟩ := mk3 a b d hab hbd
      have e1 := (s1 u E).symm.trans (hDu E)
      have e2 := (hT3 (fexRfD1 L.V u) a b d (E 0) (E 1) (E 2) hE0.symm hE1.symm hE2.symm
        (hW3 E a b d hE0 hE1 hE2) _).trans e1
      have e3 := congrArg (X.presheaf.map (homOfLE (kE3 E a b d hE0 hE1 hE2)).op).hom e2
      rwa [hrt, map_zero] at e3
    have hcoc := s6 u hdiag hanti hsort
    obtain ⟨w, hw⟩ : ∃ w : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b), ∀ a b, w a b = z a b - u a b :=
      ⟨_, fun _ _ => rfl⟩
    have hρw : ∀ e : Fin (1 + 1) ↪o Fin L.m, (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)) : wcCbcmV L ⊤ e ≤ L.V (e 0) ⊓ L.V (e 1))).op).hom (w (e 0) (e 1)) ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) J₁ := by
      intro e
      rw [hw, map_sub, hρu e]
      have h4 := hw' e
      convert h4 using 1
      exact sub_sub_cancel _ _
    have hδw : ∀ a b d, fexRfD1 L.V w a b d ∈ Ideal.map (wcCnSigma f (L.V a ⊓ L.V b ⊓ L.V d)) J₁ := by
      intro a b d
      have e5 : fexRfD1 L.V w a b d = fexRfD1 L.V z a b d - fexRfD1 L.V u a b d := by
        simp only [fexRfD1, hw, map_sub]
        abel
      rw [e5, hcoc a b d, sub_zero]
      exact Ideal.map_mono hJ (hz a b d)

    have hA : ∀ a b, a < b → w a b ∈ Ideal.map (wcCnSigma f (L.V a ⊓ L.V b)) J₁ := by
      intro a b hab
      obtain ⟨E, hE0, hE1⟩ := mk2 a b hab
      have m1 := hρw E
      rw [hT w _ _ a b hE0 hE1 _ (hW2 E a b hE0 hE1)] at m1
      have m2 := s0 J₁ _ _ (kE2 E a b hE0 hE1) _ m1
      rwa [hrt] at m2
    have hB : ∀ a, w a a ∈ Ideal.map (wcCnSigma f (L.V a ⊓ L.V a)) J₁ := by
      intro a
      have m1 := hδw a a a
      have e6 : fexRfD1 L.V w a a a = (X.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V a ⊓ L.V a ≤ L.V a ⊓ L.V a)).op).hom (w a a) := by
        simp only [fexRfD1]
        rw [sub_self, zero_add]
      rw [e6] at m1
      have m2 := s0 J₁ _ _ (le_inf le_rfl inf_le_left : L.V a ⊓ L.V a ≤ L.V a ⊓ L.V a ⊓ L.V a) _ m1
      rwa [hrt] at m2
    have hC : ∀ a b, b < a → w a b ∈ Ideal.map (wcCnSigma f (L.V a ⊓ L.V b)) J₁ := by
      intro a b hba
      have m1 := hδw a b a
      have m2 := s0 J₁ _ (L.V a ⊓ L.V b ⊓ L.V a)
        (le_inf (inf_le_left.trans inf_le_right) inf_le_right) _ (hA b a hba)
      have m3 := s0 J₁ _ (L.V a ⊓ L.V b ⊓ L.V a)
        (le_inf (inf_le_left.trans inf_le_left) inf_le_right) _ (hB a)
      have e7 : (X.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ⊓ L.V a ≤ L.V a ⊓ L.V b)).op).hom (w a b) =
          fexRfD1 L.V w a b a -
            (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right : L.V a ⊓ L.V b ⊓ L.V a ≤ L.V b ⊓ L.V a)).op).hom (w b a) +
            (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right : L.V a ⊓ L.V b ⊓ L.V a ≤ L.V a ⊓ L.V a)).op).hom (w a a) := by
        simp only [fexRfD1]
        ring
      have m4 : (X.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ⊓ L.V a ≤ L.V a ⊓ L.V b)).op).hom (w a b) ∈ Ideal.map (wcCnSigma f (L.V a ⊓ L.V b ⊓ L.V a)) J₁ := by
        rw [e7]
        exact Ideal.add_mem _ (Ideal.sub_mem _ m1 m2) m3
      have m5 := s0 J₁ _ _ (le_inf le_rfl inf_le_left : L.V a ⊓ L.V b ≤ L.V a ⊓ L.V b ⊓ L.V a) _ m4
      rwa [hrt] at m5
    refine ⟨w, fun a b => ?_, fun a b d => ?_⟩
    · rcases lt_trichotomy a b with h | rfl | h
      · exact hA a b h
      · exact hB a
      · exact hC a b h
    · have hfun : (fun a b => z a b - w a b) = u := by
        funext a b
        rw [hw, sub_sub_cancel]
      rw [hfun]
      exact hcoc a b d

theorem fex_rf_ar1_rees_nerve : ∀ (A : Type u) [CommRing A] (I : Ideal A) (X : Scheme.{u}) (f : X ⟶ Spec (.of A)), IsProper f → ∀ (L : wcpaDjCoc X), wcpaDjCocOK L → ∃ (Xr : Scheme.{u}) (h : Xr ⟶ Spec (.of (reesAlgebra I))) (L' : wcpaDjCoc Xr) (Θ : ∀ p N : ℕ, wcCbcmC L' ⊤ p →+ wcCbcmC L ⊤ p), IsProper h ∧ wcpaDjCocOK L' ∧ (∀ (p N : ℕ) (Y : wcCbcmC L' ⊤ p), Θ (p + 1) N (wcCbcmD L' ⊤ 0 p Y) = wcCbcmD L ⊤ 0 p (Θ p N Y)) ∧ (∀ (p N : ℕ) (b : reesAlgebra I) (Y : wcCbcmC L' ⊤ p), Θ p N (wcCbcmSig h L' ⊤ p b * Y) = ∑ d ∈ Finset.range (N + 1), wcCbcmSig f L ⊤ p ((b : Polynomial A).coeff d) * Θ p (N - d) Y) ∧ (∀ (p : ℕ) (Y : wcCbcmC L' ⊤ p), (∀ N, Θ p N Y = 0) → Y = 0) ∧ (∀ (p N : ℕ) (Y : wcCbcmC L' ⊤ p) (e : Fin (p + 1) ↪o Fin L.m), Θ p N Y e ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) (I ^ N)) ∧ (∀ (p N : ℕ) (x : wcCbcmC L ⊤ p), (∀ e, x e ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) (I ^ N)) → ∃ Y : wcCbcmC L' ⊤ p, Θ p N Y = x ∧ ∀ M, M ≠ N → Θ p M Y = 0) :=
by
  intro A _ I X f hf L hL
  classical
  haveI := hf

  obtain ⟨Xr, h, pr, hh, hpr, hchart⟩ := wc_rees_chart_model A I X f
  choose θ hθinj hθC hθσ hθgen using hchart
  have hθC' : ∀ (W : X.Opens) (hW : IsAffineOpen W) (s : Γ(X, W)),
      θ W hW ((pr.app W).hom s) = Polynomial.C s := fun W hW s => hθC W hW s
  have hθσ' : ∀ (W : X.Opens) (hW : IsAffineOpen W) (b : reesAlgebra I),
      θ W hW (wcCnSigma h (pr ⁻¹ᵁ W) b) = Polynomial.map (wcCnSigma f W) (b : Polynomial A) :=
    fun W hW b => hθσ W hW b
  have hθgen' : ∀ (W : X.Opens) (hW : IsAffineOpen W) (z : Γ(Xr, pr ⁻¹ᵁ W)),
      z ∈ Subring.closure (Set.range (pr.app W).hom ∪ Set.range (wcCnSigma h (pr ⁻¹ᵁ W))) :=
    fun W hW z => hθgen W hW z

  have hres : ∀ (Y : Scheme.{u}) {U V W' : Y.Opens} (h1 : V ≤ U) (h2 : W' ≤ V) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
      (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro Y U V W' h1 h2 x
    change (Y.presheaf.map (homOfLE h1).op ≫ Y.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hid : ∀ (Y : Scheme.{u}) {U : Y.Opens} (h : U ≤ U) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h).op).hom x = x := by
    intro Y U h x
    rw [show homOfLE h = 𝟙 U from rfl, op_id, CategoryTheory.Functor.map_id]
    rfl
  have hσres : ∀ {B : Type u} [CommRing B] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of B))
      (V W : Y.Opens) (hle : W ≤ V) (b : B),
      (Y.presheaf.map (homOfLE hle).op).hom (wcCnSigma q V b) = wcCnSigma q W b := by
    intro B _ Y q V W hle b
    simp only [wcCnSigma, RingHom.comp_apply]
    exact hres Y _ _ _
  have htop0 : ∀ (W : X.Opens) (x : Γ(X, W)), x ∈ Ideal.map (wcCnSigma f W) (I ^ 0) := by
    intro W x
    rw [pow_zero, Ideal.one_eq_top, Ideal.map_top]
    exact Submodule.mem_top

  haveI hsepX : IsSeparated (Limits.terminal.from X) := by
    rw [show Limits.terminal.from X = f ≫ Limits.terminal.from _ from Limits.terminal.hom_ext _ _]
    infer_instance
  have haff : ∀ {p : ℕ} (e : Fin (p + 1) ↪o Fin L.m), IsAffineOpen (wcCbcmV L ⊤ e) := by
    intro p e
    show IsAffineOpen ((⨅ k, L.V (e k)) ⊓ ⊤)
    rw [inf_top_eq, ← Finset.inf_univ_eq_iInf, ← Finset.inf'_eq_inf Finset.univ_nonempty]
    exact Finset.inf'_induction _ _ (fun a ha b hb => ha.inf hb) (fun k _ => hL.1 (e k))

  have heq : ∀ {p : ℕ} (e : Fin (p + 1) ↪o Fin L.m),
      wcCbcmV (wcpaDjCocPull pr L) ⊤ e = pr ⁻¹ᵁ (wcCbcmV L ⊤ e) := by
    intro p e
    apply le_antisymm
    · intro x hx
      refine ⟨?_, trivial⟩
      have h1 := hx.1
      simp only [wcCbcmV] at h1 ⊢
      rw [TopologicalSpace.Opens.coe_iInf, Set.mem_iInter] at h1 ⊢
      exact fun k => h1 k
    · intro x hx
      refine ⟨?_, trivial⟩
      have h1 := hx.1
      simp only [wcCbcmV] at h1 ⊢
      rw [TopologicalSpace.Opens.coe_iInf, Set.mem_iInter] at h1 ⊢
      exact fun k => h1 k

  have hθres : ∀ (W W' : X.Opens) (hW : IsAffineOpen W) (hW' : IsAffineOpen W') (hle : W' ≤ W)
      (z : Γ(Xr, pr ⁻¹ᵁ W)),
      θ W' hW' ((Xr.presheaf.map (homOfLE (pr.preimage_mono hle)).op).hom z) =
        Polynomial.map (X.presheaf.map (homOfLE hle).op).hom (θ W hW z) := by
    intro W W' hW hW' hle z
    have key : Set.EqOn
        ((θ W' hW').comp (Xr.presheaf.map (homOfLE (pr.preimage_mono hle)).op).hom)
        ((Polynomial.mapRingHom (X.presheaf.map (homOfLE hle).op).hom).comp (θ W hW))
        (Set.range (pr.app W).hom ∪ Set.range (wcCnSigma h (pr ⁻¹ᵁ W))) := by
      rintro _ (⟨s, rfl⟩ | ⟨b, rfl⟩)
      · have e1 : (Xr.presheaf.map (homOfLE (pr.preimage_mono hle)).op).hom ((pr.app W).hom s) =
            (pr.app W').hom ((X.presheaf.map (homOfLE hle).op).hom s) := by
          have := congrArg (fun φ => φ.hom s) (Scheme.Hom.naturality pr (homOfLE hle).op)
          simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
          exact this.symm
        simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom]
        rw [e1, hθC', hθC', Polynomial.map_C]
      · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom]
        rw [hσres, hθσ', hθσ', Polynomial.map_map]
        congr 1
        exact (RingHom.ext fun b => hσres X f W W' hle b).symm
    exact RingHom.eqOn_set_closure key (hθgen' W hW z)

  have hcoef : ∀ (W : X.Opens) (hW : IsAffineOpen W) (z : Γ(Xr, pr ⁻¹ᵁ W)) (N : ℕ),
      (θ W hW z).coeff N ∈ Ideal.map (wcCnSigma f W) (I ^ N) := by
    intro W hW z N
    obtain ⟨Rr, hRr⟩ : ∃ Rr : Subring (Polynomial Γ(X, W)),
        ∀ P, P ∈ Rr ↔ ∀ N, P.coeff N ∈ Ideal.map (wcCnSigma f W) (I ^ N) :=
      ⟨{ carrier := {P | ∀ N, P.coeff N ∈ Ideal.map (wcCnSigma f W) (I ^ N)}
         mul_mem' := fun {P Q} hP hQ N => by
           rw [Polynomial.coeff_mul]
           refine Ideal.sum_mem _ (fun ij hij => ?_)
           rw [Finset.HasAntidiagonal.mem_antidiagonal] at hij
           have hm := Ideal.mul_mem_mul (hP ij.1) (hQ ij.2)
           rw [← Ideal.map_mul, ← pow_add, hij] at hm
           exact hm
         one_mem' := fun N => by
           rw [Polynomial.coeff_one]
           split_ifs with h0
           · subst h0; exact htop0 W 1
           · exact zero_mem _
         add_mem' := fun {P Q} hP hQ N => by
           rw [Polynomial.coeff_add]
           exact Ideal.add_mem _ (hP N) (hQ N)
         zero_mem' := fun N => by
           rw [Polynomial.coeff_zero]
           exact zero_mem _
         neg_mem' := fun {P} hP N => by
           rw [Polynomial.coeff_neg]
           exact neg_mem (hP N) },
       fun P => Iff.rfl⟩
    have hcl : Subring.closure (Set.range (pr.app W).hom ∪ Set.range (wcCnSigma h (pr ⁻¹ᵁ W))) ≤
        Rr.comap (θ W hW) := by
      rw [Subring.closure_le]
      rintro _ (⟨s, rfl⟩ | ⟨b, rfl⟩)
      · rw [SetLike.mem_coe, Subring.mem_comap, hRr, hθC']
        intro N
        rw [Polynomial.coeff_C]
        split_ifs with h0
        · subst h0; exact htop0 W s
        · exact zero_mem _
      · rw [SetLike.mem_coe, Subring.mem_comap, hRr, hθσ']
        intro N
        rw [Polynomial.coeff_map]
        exact Ideal.mem_map_of_mem _ ((mem_reesAlgebra_iff I _).mp b.2 N)
    have hz := hcl (hθgen' W hW z)
    rw [Subring.mem_comap, hRr] at hz
    exact hz N

  have hlift : ∀ (W : X.Opens) (hW : IsAffineOpen W) (N : ℕ) (x : Γ(X, W)),
      x ∈ Ideal.map (wcCnSigma f W) (I ^ N) → ∃ z, θ W hW z = Polynomial.monomial N x := by
    intro W hW N x hx
    obtain ⟨T, hT⟩ : ∃ T : Ideal Γ(X, W),
        ∀ y, y ∈ T ↔ ∃ z, θ W hW z = Polynomial.monomial N y :=
      ⟨{ carrier := {y | ∃ z, θ W hW z = Polynomial.monomial N y}
         add_mem' := fun {a b} ha hb => by
           obtain ⟨z1, h1⟩ := ha
           obtain ⟨z2, h2⟩ := hb
           exact ⟨z1 + z2, by rw [map_add, h1, h2, map_add]⟩
         zero_mem' := ⟨0, by rw [map_zero, map_zero]⟩
         smul_mem' := fun c {a} ha => by
           obtain ⟨z, hz⟩ := ha
           exact ⟨(pr.app W).hom c * z, by
             rw [map_mul, hθC' W hW c, hz, Polynomial.C_mul_monomial, smul_eq_mul]⟩ },
       fun y => Iff.rfl⟩
    have hIT : Ideal.map (wcCnSigma f W) (I ^ N) ≤ T := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, hT]
      refine ⟨wcCnSigma h (pr ⁻¹ᵁ W) ⟨Polynomial.monomial N a, reesAlgebra.monomial_mem.mpr ha⟩, ?_⟩
      rw [hθσ' W hW]
      exact Polynomial.map_monomial _
    exact (hT x).mp (hIT hx)

  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : ∀ (p : ℕ) (e : Fin (p + 1) ↪o Fin L.m),
      Γ(Xr, wcCbcmV (wcpaDjCocPull pr L) ⊤ e) →+* Polynomial Γ(X, wcCbcmV L ⊤ e),
      ∀ p e, Φ p e = (θ (wcCbcmV L ⊤ e) (haff e)).comp
        (Xr.presheaf.map (homOfLE (heq e).ge).op).hom :=
    ⟨fun p e => (θ (wcCbcmV L ⊤ e) (haff e)).comp (Xr.presheaf.map (homOfLE (heq e).ge).op).hom,
      fun _ _ => rfl⟩
  have hΦinj : ∀ (p : ℕ) (e : Fin (p + 1) ↪o Fin L.m), Function.Injective (Φ p e) := by
    intro p e z1 z2 hz
    rw [hΦdef, RingHom.comp_apply, RingHom.comp_apply] at hz
    have h2 := congrArg (Xr.presheaf.map (homOfLE (heq e).le).op).hom (hθinj _ _ hz)
    rwa [hres, hres, hid, hid] at h2
  have hΦres : ∀ (p q : ℕ) (e : Fin (p + 1) ↪o Fin L.m) (e' : Fin (q + 1) ↪o Fin L.m)
      (h1 : wcCbcmV L ⊤ e ≤ wcCbcmV L ⊤ e')
      (h2 : wcCbcmV (wcpaDjCocPull pr L) ⊤ e ≤ wcCbcmV (wcpaDjCocPull pr L) ⊤ e')
      (z : Γ(Xr, wcCbcmV (wcpaDjCocPull pr L) ⊤ e')),
      Φ p e ((Xr.presheaf.map (homOfLE h2).op).hom z) =
        Polynomial.map (X.presheaf.map (homOfLE h1).op).hom (Φ q e' z) := by
    intro p q e e' h1 h2 z
    rw [hΦdef, hΦdef, RingHom.comp_apply, RingHom.comp_apply, hres,
      ← hθres _ _ (haff e') (haff e) h1, hres]
  have hΦσ : ∀ (p : ℕ) (e : Fin (p + 1) ↪o Fin L.m) (b : reesAlgebra I),
      Φ p e (wcCnSigma h (wcCbcmV (wcpaDjCocPull pr L) ⊤ e) b) =
        Polynomial.map (wcCnSigma f (wcCbcmV L ⊤ e)) (b : Polynomial A) := by
    intro p e b
    rw [hΦdef, RingHom.comp_apply, hσres, hθσ']
  have hΦcoef : ∀ (p : ℕ) (e : Fin (p + 1) ↪o Fin L.m) (z) (N : ℕ),
      (Φ p e z).coeff N ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) (I ^ N) := by
    intro p e z N
    rw [hΦdef, RingHom.comp_apply]
    exact hcoef _ _ _ N
  have hΦlift : ∀ (p : ℕ) (e : Fin (p + 1) ↪o Fin L.m) (N : ℕ) (x : Γ(X, wcCbcmV L ⊤ e)),
      x ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) (I ^ N) →
        ∃ z, Φ p e z = Polynomial.monomial N x := by
    intro p e N x hx
    obtain ⟨z, hz⟩ := hlift _ (haff e) N x hx
    refine ⟨(Xr.presheaf.map (homOfLE (heq e).le).op).hom z, ?_⟩
    rw [hΦdef, RingHom.comp_apply, hres, hid, hz]

  have hneg : ∀ (R : Type u) [CommRing R] (n N : ℕ) (Q : Polynomial R),
      ((-1 : Polynomial R) ^ n * Q).coeff N = (-1 : R) ^ n * Q.coeff N := by
    intro R _ n N Q
    rw [← Polynomial.C_1, ← Polynomial.C_neg, ← Polynomial.C_pow, Polynomial.coeff_C_mul]

  obtain ⟨Θ, hΘ⟩ : ∃ Θ : ∀ p N : ℕ, wcCbcmC (wcpaDjCocPull pr L) ⊤ p →+ wcCbcmC L ⊤ p,
      ∀ p N Y e, Θ p N Y e = (Φ p e (Y e)).coeff N :=
    ⟨fun p N => AddMonoidHom.mk' (fun Y e => (Φ p e (Y e)).coeff N) (by
      intro Y1 Y2
      funext e
      show (Φ p e (Y1 e + Y2 e)).coeff N = _
      rw [map_add, Polynomial.coeff_add]
      rfl), fun _ _ _ _ => rfl⟩
  refine ⟨Xr, h, wcpaDjCocPull pr L, Θ, hh, wcpa_dj_lge_cbcm_pull_ok Xr X pr L hpr hL,
    ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro p N Y
    funext a
    rw [hΘ]
    simp only [wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, pow_zero, map_one, one_mul,
      map_add, map_sum, map_mul, map_pow, map_neg, Polynomial.coeff_add,
      Polynomial.finsetSum_coeff, hneg]
    refine congrArg₂ (· + ·) (Finset.sum_congr rfl fun k _ => ?_) ?_
    · congr 1
      refine (congrArg (fun P => Polynomial.coeff P N) (hΦres (p + 1) p a
        ((Fin.succAboveOrderEmb k.castSucc).trans a)
        (inf_le_inf_right ⊤ (le_iInf fun i => iInf_le (fun j => L.V (a j)) _)) _ _)).trans ?_
      rw [Polynomial.coeff_map, hΘ]
      rfl
    · congr 1
      refine (congrArg (fun P => Polynomial.coeff P N) (hΦres (p + 1) p a
        ((Fin.succAboveOrderEmb (Fin.last (p + 1))).trans a)
        (inf_le_inf_right ⊤ (le_iInf fun i => iInf_le (fun j => L.V (a j)) _)) _ _)).trans ?_
      rw [Polynomial.coeff_map, hΘ]
      rfl
  ·
    intro p N b Y
    funext e
    have key : (wcCbcmSig h (wcpaDjCocPull pr L) ⊤ p b * Y) e =
        wcCnSigma h (wcCbcmV (wcpaDjCocPull pr L) ⊤ e) b * Y e := rfl
    rw [Finset.sum_apply, hΘ, key, map_mul, hΦσ, Polynomial.coeff_mul,
      Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
    refine Finset.sum_congr rfl fun d _ => ?_
    rw [Pi.mul_apply, hΘ, Polynomial.coeff_map]
    rfl
  ·
    intro p Y hY
    funext e
    apply hΦinj p e
    rw [Pi.zero_apply, map_zero]
    refine Polynomial.ext fun N => ?_
    rw [Polynomial.coeff_zero]
    exact (hΘ p N Y e).symm.trans (congrFun (hY N) e)
  ·
    intro p N Y e
    rw [hΘ]
    exact hΦcoef p e (Y e) N
  ·
    intro p N x hx
    choose z hz using fun e => hΦlift p e N (x e) (hx e)
    obtain ⟨Y, hY⟩ : ∃ Y : wcCbcmC (wcpaDjCocPull pr L) ⊤ p,
        ∀ e, Φ p e (Y e) = Polynomial.monomial N (x e) := ⟨z, hz⟩
    refine ⟨Y, ?_, ?_⟩
    · funext e
      rw [hΘ, hY, Polynomial.coeff_monomial, if_pos rfl]
    · intro M hM
      funext e
      rw [hΘ, hY, Polynomial.coeff_monomial, if_neg (Ne.symm hM)]
      rfl

theorem fex_rf_ar1_alt_of_rees : ∀ (A : Type u) [CommRing A] (I : Ideal A) (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) (L : wcpaDjCoc X), wcpaDjCocOK L → ∀ (Xr : Scheme.{u}) (h : Xr ⟶ Spec (.of (reesAlgebra I))) (L' : wcpaDjCoc Xr) (Θ : ∀ p N : ℕ, wcCbcmC L' ⊤ p →+ wcCbcmC L ⊤ p), IsNoetherianRing (reesAlgebra I) → wcpaDjCocOK L' → wcCbcmFG h L' 0 → (∀ (p N : ℕ) (Y : wcCbcmC L' ⊤ p), Θ (p + 1) N (wcCbcmD L' ⊤ 0 p Y) = wcCbcmD L ⊤ 0 p (Θ p N Y)) → (∀ (p N : ℕ) (b : reesAlgebra I) (Y : wcCbcmC L' ⊤ p), Θ p N (wcCbcmSig h L' ⊤ p b * Y) = ∑ d ∈ Finset.range (N + 1), wcCbcmSig f L ⊤ p ((b : Polynomial A).coeff d) * Θ p (N - d) Y) → (∀ (p : ℕ) (Y : wcCbcmC L' ⊤ p), (∀ N, Θ p N Y = 0) → Y = 0) → (∀ (p N : ℕ) (Y : wcCbcmC L' ⊤ p) (e : Fin (p + 1) ↪o Fin L.m), Θ p N Y e ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) (I ^ N)) → (∀ (p N : ℕ) (x : wcCbcmC L ⊤ p), (∀ e, x e ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) (I ^ N)) → ∃ Y : wcCbcmC L' ⊤ p, Θ p N Y = x ∧ ∀ M, M ≠ N → Θ p M Y = 0) → ∃ k : ℕ, ∀ (n : ℕ) (y : wcCbcmC L ⊤ 1), (∀ e, wcCbcmD L ⊤ 0 1 y e ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) (I ^ (n + k))) → ∃ w' : wcCbcmC L ⊤ 1, (∀ e, w' e ∈ Ideal.map (wcCnSigma f (wcCbcmV L ⊤ e)) (I ^ n)) ∧ wcCbcmD L ⊤ 0 1 (y - w') = 0 :=
by
  intro A _ I X f L hL Xr h L' Θ hB hL' hFG hΘD hΘmul hΘinj hΘmem hΘlift
  haveI := hB
  classical

  have hstab : ∀ (b : reesAlgebra I) (w : wcCbcmC L' ⊤ (1 + 1)),
      w ∈ (wcCbcmD L' ⊤ 0 1).range →
        wcCbcmSig h L' ⊤ (1 + 1) b * w ∈ (wcCbcmD L' ⊤ 0 1).range := by
    rintro b w ⟨x, rfl⟩
    exact ⟨wcCbcmSig h L' ⊤ 1 b * x, wcpa_dj_lge_cbcm_d_smul _ Xr h L' ⊤ 0 1 b x⟩

  obtain ⟨k₀, c, -, hc⟩ := hFG.2 1
  have hF : ∀ i : (Σ N : ℕ, {Y : wcCbcmC L' ⊤ (1 + 1) // wcCbcmD L' ⊤ 0 (1 + 1) Y = 0 ∧
      ∃ y0 : wcCbcmC L ⊤ 1, Θ (1 + 1) N Y = wcCbcmD L ⊤ 0 1 y0 ∧
        ∀ M, M ≠ N → Θ (1 + 1) M Y = 0}),
      ∃ (b : Fin k₀ → reesAlgebra I) (w : wcCbcmC L' ⊤ (1 + 1)),
        w ∈ (wcCbcmD L' ⊤ 0 1).range ∧
        i.2.1 = ∑ l, wcCbcmSig h L' ⊤ (1 + 1) (b l) * c l + w := by
    intro i
    obtain ⟨b, x, hx⟩ := hc i.2.1 i.2.2.1
    refine ⟨b, wcCbcmD L' ⊤ 0 1 x, ⟨x, rfl⟩, ?_⟩
    refine hx.trans ?_
    rfl

  obtain ⟨q, s, hs⟩ := wc_noeth_span_finite_subfamily _ _ (wcCbcmSig h L' ⊤ (1 + 1))
    (wcCbcmD L' ⊤ 0 1).range hstab
    (fun i : (Σ N : ℕ, {Y : wcCbcmC L' ⊤ (1 + 1) // wcCbcmD L' ⊤ 0 (1 + 1) Y = 0 ∧
      ∃ y0 : wcCbcmC L ⊤ 1, Θ (1 + 1) N Y = wcCbcmD L ⊤ 0 1 y0 ∧
        ∀ M, M ≠ N → Θ (1 + 1) M Y = 0}) => i.2.1) k₀ c hF
  choose y0 hy0 hzero using fun j : Fin q => (s j).2.2.2
  obtain ⟨k, hk⟩ : ∃ k : ℕ, k = Finset.univ.sup (fun j : Fin q => (s j).1) := ⟨_, rfl⟩
  have hsel : ∀ j, (s j).1 ≤ k := fun j => by
    rw [hk]; exact Finset.le_sup (f := fun j : Fin q => (s j).1) (Finset.mem_univ j)
  refine ⟨k, fun n y hy => ?_⟩
  obtain ⟨N, hN⟩ : ∃ N : ℕ, N = n + k := ⟨_, rfl⟩
  rw [← hN] at hy

  obtain ⟨Y, hYN, hYM⟩ := hΘlift (1 + 1) N (wcCbcmD L ⊤ 0 1 y) hy
  have hcoc : wcCbcmD L' ⊤ 0 (1 + 1) Y = 0 := by
    apply hΘinj (1 + 1 + 1)
    intro M
    rw [hΘD (1 + 1) M Y]
    by_cases hM : M = N
    · rw [hM, hYN]
      exact wcpa_dj_lge_cbcm_dd_zero X L ⊤ 0 1 hL y
    · rw [hYM M hM, map_zero]

  obtain ⟨b, w, ⟨x, hx⟩, hYdec⟩ := hs ⟨N, Y, hcoc, y, hYN, hYM⟩
  have hYdec' : Y = ∑ j, wcCbcmSig h L' ⊤ (1 + 1) (b j) * (s j).2.1 + wcCbcmD L' ⊤ 0 1 x := by
    rw [hx]; exact hYdec
  have hterm : ∀ j, Θ (1 + 1) N (wcCbcmSig h L' ⊤ (1 + 1) (b j) * (s j).2.1) =
      wcCbcmD L ⊤ 0 1 (wcCbcmSig f L ⊤ 1
        (((b j : reesAlgebra I) : Polynomial A).coeff (N - (s j).1)) * y0 j) := by
    intro j
    rw [hΘmul (1 + 1) N (b j) (s j).2.1]
    rw [Finset.sum_eq_single_of_mem (N - (s j).1) (Finset.mem_range.mpr (by omega))]
    · have h1 : N - (N - (s j).1) = (s j).1 := by have := hsel j; omega
      rw [h1, hy0 j, wcpa_dj_lge_cbcm_d_smul A X f L ⊤ 0 1 _ (y0 j)]
    · intro d hd hne
      have h2 : N - d ≠ (s j).1 := by
        have := hsel j; have := Finset.mem_range.mp hd; omega
      rw [hzero j (N - d) h2, mul_zero]
  have hsum : Θ (1 + 1) N Y = wcCbcmD L ⊤ 0 1 (∑ j, wcCbcmSig f L ⊤ 1
      (((b j : reesAlgebra I) : Polynomial A).coeff (N - (s j).1)) * y0 j + Θ 1 N x) := by
    conv_lhs => rw [hYdec']
    rw [map_add (Θ (1 + 1) N), map_sum (Θ (1 + 1) N), hΘD 1 N x, map_add (wcCbcmD L ⊤ 0 1),
      map_sum (wcCbcmD L ⊤ 0 1)]
    congr 1
    exact Finset.sum_congr rfl fun j _ => hterm j
  refine ⟨∑ j, wcCbcmSig f L ⊤ 1
      (((b j : reesAlgebra I) : Polynomial A).coeff (N - (s j).1)) * y0 j + Θ 1 N x,
    fun e => ?_, ?_⟩
  ·
    show (∑ j, wcCbcmSig f L ⊤ 1
      (((b j : reesAlgebra I) : Polynomial A).coeff (N - (s j).1)) * y0 j) e + (Θ 1 N x) e ∈ _
    rw [Finset.sum_apply]
    refine Ideal.add_mem _ (Ideal.sum_mem _ fun j _ => ?_) ?_
    · show wcCnSigma f (wcCbcmV L ⊤ e)
          (((b j : reesAlgebra I) : Polynomial A).coeff (N - (s j).1)) * y0 j e ∈ _
      refine Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ?_)
      have hmem := (mem_reesAlgebra_iff I _).mp (b j).2 (N - (s j).1)
      exact Ideal.pow_le_pow_right (by have := hsel j; omega) hmem
    · exact Ideal.map_mono (Ideal.pow_le_pow_right (by omega)) (hΘmem 1 N x e)
  · rw [map_sub, ← hYN, hsum, sub_self]

theorem fex_rf_cech_ar1 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A) (X : Scheme.{u}) (f : X ⟶ Spec (.of A)), IsProper f → ∀ {m : ℕ} (V : Fin m → X.Opens), (∀ a, IsAffineOpen (V a)) → (⨆ a, V a) = ⊤ → ∃ k : ℕ, ∀ (n : ℕ) (z : ∀ a b : Fin m, Γ(X, V a ⊓ V b)), (∀ a b d, fexRfD1 V z a b d ∈ Ideal.map (wcCnSigma f (V a ⊓ V b ⊓ V d)) (I ^ (n + k))) → ∃ w : ∀ a b : Fin m, Γ(X, V a ⊓ V b), (∀ a b, w a b ∈ Ideal.map (wcCnSigma f (V a ⊓ V b)) (I ^ n)) ∧ ∀ a b d, fexRfD1 V (fun a b => z a b - w a b) a b d = 0 :=
by
  intro A _ _ I X f hf m V hV hcov
  let L : wcpaDjCoc X := ⟨m, V, fun _ _ => 1⟩
  have hL : wcpaDjCocOK L := by
    refine ⟨hV, hcov, fun _ => rfl, fun a b c => ?_⟩
    change (X.presheaf.map _).hom 1 * (X.presheaf.map _).hom 1 = (X.presheaf.map _).hom 1
    rw [map_one, map_one, map_one, mul_one]
  obtain ⟨Xr, h, L', Θ, hh, hL', h1, h2, h3, h4, h5⟩ := fex_rf_ar1_rees_nerve A I X f hf L hL
  haveI hB : IsNoetherianRing (reesAlgebra I) :=
    @Algebra.FiniteType.isNoetherianRing A (reesAlgebra I) _ _ _
      ((Subalgebra.fg_iff_finiteType _).mp (reesAlgebra.fg (IsNoetherian.noetherian I))) _
  have hFG : wcCbcmFG h L' 0 := wcpa_dj_lge_cbcm_cech_fg (reesAlgebra I) Xr h L' hh hL' 0
  obtain ⟨k, hk⟩ := fex_rf_ar1_alt_of_rees A I X f L hL Xr h L' Θ hB hL' hFG h1 h2 h3 h4 h5
  refine ⟨k, fun n z hz => ?_⟩
  have hb := fex_rf_ar1_bridge A X f L (I ^ n) (I ^ (n + k))
    (Ideal.pow_le_pow_right (by omega)) z hz
  obtain ⟨w', hw'I, hw'D⟩ := hk n _ hb.1
  exact hb.2 w' hw'I hw'D

theorem fex_h1_restrict_fibre : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
    IsAdicComplete (IsLocalRing.maximalIdeal A) A →
    ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of A)), IsProper f →
    topologicalKrullDim ↥(⇑f ⁻¹' {IsLocalRing.closedPoint A}) ≤ 1 → wcpaDjFexH1 X →
    ∀ (C : Scheme.{u}) (ι : C ⟶ X), IsClosedImmersion ι → AlgebraicGeometry.IsReduced C →
      Set.range ⇑ι ⊆ ⇑f ⁻¹' {IsLocalRing.closedPoint A} → wcpaDjFexH1 C :=
by
  intro A _ _ _ _ X f hf hdim hX C ι hι hC hr
  haveI := hf
  haveI := hι
  classical

  have hres : ∀ (Y : Scheme.{u}) {U V W' : Y.Opens} (h1 : V ≤ U) (h2 : W' ≤ V) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
      (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro Y U V W' h1 h2 x
    change (Y.presheaf.map (homOfLE h1).op ≫ Y.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hid : ∀ (Y : Scheme.{u}) {U : Y.Opens} (h : U ≤ U) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h).op).hom x = x := by
    intro Y U h x
    rw [show homOfLE h = 𝟙 U from rfl, op_id, CategoryTheory.Functor.map_id]
    rfl
  have tr : ∀ (Y : Scheme.{u}) {T P Q R : Y.Opens} (hTP : T ≤ P) (hTQ : T ≤ Q) (hTR : T ≤ R)
      (S : Y.Opens) (hS : S ≤ T) (x : Γ(Y, P)) (y : Γ(Y, Q)) (z : Γ(Y, R)),
      (Y.presheaf.map (homOfLE hTP).op).hom x =
        (Y.presheaf.map (homOfLE hTQ).op).hom y + (Y.presheaf.map (homOfLE hTR).op).hom z →
      (Y.presheaf.map (homOfLE (hS.trans hTP)).op).hom x =
        (Y.presheaf.map (homOfLE (hS.trans hTQ)).op).hom y +
          (Y.presheaf.map (homOfLE (hS.trans hTR)).op).hom z := by
    intro Y T P Q R hTP hTQ hTR S hS x y z e
    have e2 := congrArg (Y.presheaf.map (homOfLE hS).op).hom e
    rw [map_add, hres Y, hres Y, hres Y] at e2
    exact e2

  have tw_of_raw : ∀ (Y : Scheme.{u}) (K : wcpaDjCoc Y), wcpaP1rRawH1 K.V →
      wcpaDjTwH1 K ⊤ (wcStructMod Y) 0 := by
    intro Y K hraw
    refine fun (c0 : ∀ a b, Γ(Y, K.V a ⊓ K.V b ⊓ ⊤)) hc => ?_
    have hT : ∀ (O : Y.Opens), O ≤ O ⊓ ⊤ := fun O => le_inf le_rfl le_top
    have hT' : ∀ (O : Y.Opens), O ⊓ ⊤ ≤ O := fun O => inf_le_left
    obtain ⟨β, hβ⟩ := hraw
      (fun a b => (Y.presheaf.map (homOfLE (hT (K.V a ⊓ K.V b))).op).hom (c0 a b)) (by
        intro a b d
        have e := hc a b d
        simp only [pow_zero, one_smul] at e
        rw [hres Y, hres Y, hres Y]
        exact tr Y _ _ _ (K.V a ⊓ K.V b ⊓ K.V d) (by simp) _ _ _ e)
    refine ⟨fun a => (Y.presheaf.map (homOfLE (hT' (K.V a))).op).hom (β a), fun a b => ?_⟩
    have e := congrArg (Y.presheaf.map (homOfLE (hT' (K.V a ⊓ K.V b))).op).hom (hβ a b)
    rw [map_sub, hres Y, hres Y, hres Y, hid Y] at e
    simp only [pow_zero, one_smul]
    show c0 a b = (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE _).op).hom (β b)) -
      (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE _).op).hom (β a))
    rw [hres Y, hres Y]
    exact e
  have raw_of_tw : ∀ (Y : Scheme.{u}) (K : wcpaDjCoc Y), wcpaDjTwH1 K ⊤ (wcStructMod Y) 0 →
      wcpaP1rRawH1 K.V := by
    intro Y K htw c hc
    obtain ⟨β0, hβ0⟩ := htw (fun a b =>
        (Y.presheaf.map (homOfLE (inf_le_left : K.V a ⊓ K.V b ⊓ ⊤ ≤ K.V a ⊓ K.V b)).op).hom
          (c a b)) (by
      intro a b d
      simp only [pow_zero, one_smul]
      show (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE _).op).hom (c a d)) =
        (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE _).op).hom (c b d)) +
        (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE _).op).hom (c a b))
      rw [hres Y, hres Y, hres Y]
      exact tr Y _ _ _ _ inf_le_left _ _ _ (hc a b d))
    let β1 : ∀ a, Γ(Y, K.V a ⊓ ⊤) := fun a => β0 a
    have hβ0' : ∀ a b,
        (Y.presheaf.map (homOfLE (inf_le_left : K.V a ⊓ K.V b ⊓ ⊤ ≤ K.V a ⊓ K.V b)).op).hom
          (c a b) =
        (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
          K.V a ⊓ K.V b ⊓ ⊤ ≤ K.V b ⊓ ⊤)).op).hom (β1 b) -
        (Y.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
          K.V a ⊓ K.V b ⊓ ⊤ ≤ K.V a ⊓ ⊤)).op).hom (β1 a) := by
      intro a b
      have e := hβ0 a b
      simp only [pow_zero, one_smul] at e
      exact e
    clear_value β1
    refine ⟨fun a => (Y.presheaf.map (homOfLE (le_inf le_rfl le_top : K.V a ≤ K.V a ⊓ ⊤)).op).hom
      (β1 a), fun a b => ?_⟩
    have e := congrArg (Y.presheaf.map (homOfLE (le_inf le_rfl le_top :
      K.V a ⊓ K.V b ≤ K.V a ⊓ K.V b ⊓ ⊤)).op).hom (hβ0' a b)
    rw [map_sub, hres Y, hres Y, hres Y, hid Y] at e
    show c a b = (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE _).op).hom (β1 b)) -
      (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE _).op).hom (β1 a))
    rw [hres Y, hres Y]
    exact e
  intro L hL
  by_cases hm : L.m = 0
  · intro c _
    exact ⟨fun a => absurd a.isLt (by omega), fun a _ => absurd a.isLt (by omega)⟩
  haveI hsepX : IsSeparated (Limits.terminal.from X) := by
    rw [show Limits.terminal.from X = f ≫ Limits.terminal.from _ from Limits.terminal.hom_ext _ _]
    infer_instance
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f

  obtain ⟨m, U, β, hUaff, hUcov, hle⟩ :=
    fex_rf_pullback_refinement X C ι hι inferInstance L hL (Nat.pos_of_ne_zero hm)
  have h2 : ∀ a b, IsAffineOpen (U a ⊓ U b) := fun a b => (hUaff a).inf (hUaff b)
  let gM : ∀ i j : Fin m, (Γ(C, ι ⁻¹ᵁ U i ⊓ ι ⁻¹ᵁ U j))ˣ := fun i j =>
    Units.map (C.presheaf.map (homOfLE (inf_le_inf (hle i) (hle j))).op).hom.toMonoidHom
      (L.g (β i) (β j))
  let M : wcpaDjCoc C := ⟨m, fun j => ι ⁻¹ᵁ U j, gM⟩
  have hM : wcpaDjCocOK M := by
    refine ⟨fun j => (hUaff j).preimage ι, ?_, fun i => ?_, fun a b c => ?_⟩
    · show (⨆ j, ι ⁻¹ᵁ U j) = ⊤
      rw [← Scheme.Hom.preimage_iSup, hUcov]
      rfl
    · apply Units.ext
      show (C.presheaf.map (homOfLE (inf_le_inf (hle i) (hle i))).op).hom
        ((L.g (β i) (β i) : Γ(C, L.V (β i) ⊓ L.V (β i)))) = 1
      rw [hL.2.2.1 (β i), Units.val_one, map_one]
    · show (C.presheaf.map (homOfLE _).op).hom ((C.presheaf.map (homOfLE (inf_le_inf (hle a)
            (hle b))).op).hom ((L.g (β a) (β b) : Γ(C, L.V (β a) ⊓ L.V (β b))))) *
          (C.presheaf.map (homOfLE _).op).hom ((C.presheaf.map (homOfLE (inf_le_inf (hle b)
            (hle c))).op).hom ((L.g (β b) (β c) : Γ(C, L.V (β b) ⊓ L.V (β c))))) =
        (C.presheaf.map (homOfLE _).op).hom ((C.presheaf.map (homOfLE (inf_le_inf (hle a)
            (hle c))).op).hom ((L.g (β a) (β c) : Γ(C, L.V (β a) ⊓ L.V (β c)))))
      rw [hres C, hres C, hres C]
      have e := congrArg (C.presheaf.map (homOfLE (show
        ι ⁻¹ᵁ U a ⊓ ι ⁻¹ᵁ U b ⊓ ι ⁻¹ᵁ U c ≤ L.V (β a) ⊓ L.V (β b) ⊓ L.V (β c) from
          inf_le_inf (inf_le_inf (hle a) (hle b)) (hle c))).op).hom (hL.2.2.2 (β a) (β b) (β c))
      rw [map_mul, hres C, hres C, hres C] at e
      exact e

  let KX : wcpaDjCoc X := ⟨m, U, fun _ _ => 1⟩
  have hKX : wcpaDjCocOK KX := by
    refine ⟨hUaff, hUcov, fun _ => rfl, fun a b c => ?_⟩
    change (X.presheaf.map _).hom 1 * (X.presheaf.map _).hom 1 = (X.presheaf.map _).hom 1
    rw [map_one, map_one, map_one, mul_one]
  have hrawX : wcpaP1rRawH1 U := raw_of_tw X KX (hX KX hKX)

  have hraw_C : wcpaP1rRawH1 (fun j => ι ⁻¹ᵁ U j) := by
    have nat : ∀ (V W : X.Opens) (h : W ≤ V) (s : Γ(X, V)),
        (ι.app W).hom ((X.presheaf.map (homOfLE h).op).hom s) =
          (C.presheaf.map (homOfLE (ι.preimage_mono h)).op).hom ((ι.app V).hom s) := by
      intro V W h s
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.naturality]
      rfl
    have hD1ι : ∀ (y : ∀ a b : Fin m, Γ(X, U a ⊓ U b)) (a b d : Fin m),
        (ι.app (U a ⊓ U b ⊓ U d)).hom (fexRfD1 U y a b d) =
          fexRfD1 (fun j => ι ⁻¹ᵁ U j) (fun a b => (ι.app (U a ⊓ U b)).hom (y a b)) a b d := by
      intro y a b d
      show (ι.app _).hom (_ - _ + _) = _
      rw [map_add, map_sub, nat, nat, nat]
      all_goals rfl
    have hDD : ∀ (y : ∀ a b : Fin m, Γ(X, U a ⊓ U b)) (a b d e : Fin m),
        fexRfD2 U (fexRfD1 U y) a b d e = 0 := by
      intro y a b d e
      simp only [fexRfD2, fexRfD1, map_add, map_sub, hres X]
      abel
    have hD1sub : ∀ (y w : ∀ a b : Fin m, Γ(X, U a ⊓ U b)) (a b d : Fin m),
        fexRfD1 U (fun a b => y a b - w a b) a b d = fexRfD1 U y a b d - fexRfD1 U w a b d := by
      intro y w a b d
      simp only [fexRfD1, map_sub]
      abel
    have hσres : ∀ (V W : X.Opens) (h : W ≤ V),
        (X.presheaf.map (homOfLE h).op).hom.comp (wcCnSigma f V) = wcCnSigma f W := by
      intro V W h
      refine RingHom.ext fun x => ?_
      simp only [wcCnSigma, RingHom.comp_apply]
      exact hres X _ _ _
    have hJqc : ∀ (J : Ideal A) (V W : X.Opens) (h : W ≤ V),
        Ideal.map (wcCnSigma f W) J =
          Ideal.map (X.presheaf.map (homOfLE h).op).hom (Ideal.map (wcCnSigma f V) J) := by
      intro J V W h
      rw [Ideal.map_map, hσres]
    have hKqc : ∀ (V W : X.Opens), IsAffineOpen V → IsAffineOpen W → ∀ h : W ≤ V,
        RingHom.ker (ι.app W).hom =
          Ideal.map (X.presheaf.map (homOfLE h).op).hom (RingHom.ker (ι.app V).hom) := by
      intro V W hV hW h
      have e1 : (Scheme.Hom.ker ι).ideal ⟨W, hW⟩ = RingHom.ker (ι.app W).hom :=
        Scheme.Hom.ker_apply ι ⟨W, hW⟩
      have e2 : (Scheme.Hom.ker ι).ideal ⟨V, hV⟩ = RingHom.ker (ι.app V).hom :=
        Scheme.Hom.ker_apply ι ⟨V, hV⟩
      rw [← e1, ← e2]
      exact ((Scheme.Hom.ker ι).map_ideal (U := ⟨W, hW⟩) (V := ⟨V, hV⟩) h).symm

    have hs3 : ∀ (W : X.Opens) (a : A), a ∈ IsLocalRing.maximalIdeal A →
        (ι.app W).hom (wcCnSigma f W a) = 0 := by
      intro W a ha
      rw [← basicOpen_eq_bot_iff, ← Scheme.preimage_basicOpen, eq_bot_iff]
      intro x hx
      have hx1 : ι x ∈ X.basicOpen (wcCnSigma f W a) := hx
      have hx2 : ι x ∈ X.basicOpen (f.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) := by
        rw [show wcCnSigma f W a = (X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
          (f.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) from rfl,
          Scheme.basicOpen_res] at hx1
        exact hx1.2
      rw [← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine] at hx2
      have hx3 : f (ι x) ∈ PrimeSpectrum.basicOpen a := hx2
      have hcp : f (ι x) = IsLocalRing.closedPoint A := hr ⟨x, rfl⟩
      rw [hcp] at hx3
      have hx4 : (IsLocalRing.closedPoint A : PrimeSpectrum A) ∈ PrimeSpectrum.basicOpen a := hx3
      exact (PrimeSpectrum.mem_basicOpen a _).mp hx4 ha
    have hIK : ∀ (N : ℕ) (W : X.Opens), 1 ≤ N →
        Ideal.map (wcCnSigma f W) (IsLocalRing.maximalIdeal A ^ N) ≤ RingHom.ker (ι.app W).hom := by
      intro N W hN
      refine Ideal.map_le_iff_le_comap.mpr ?_
      intro a ha
      exact Ideal.mem_comap.mpr (RingHom.mem_ker.mpr
        (hs3 W a (Ideal.pow_le_self (by omega) ha)))

    intro c hc
    choose ct hct using fun a b => Scheme.Hom.app_surjective ι (U a ⊓ U b) (h2 a b) (c a b)
    have hcz : ∀ a b d, fexRfD1 (fun j => ι ⁻¹ᵁ U j)
        (fun a b => (ι.app (U a ⊓ U b)).hom (ct a b)) a b d = 0 := by
      intro a b d
      have hfun : (fun a b => (ι.app (U a ⊓ U b)).hom (ct a b)) = c :=
        funext fun a => funext fun b => hct a b
      rw [hfun]
      have e := hc a b d
      simp only [fexRfD1]
      linear_combination -e
    have hzK : ∀ a b d, fexRfD1 U ct a b d ∈ RingHom.ker (ι.app (U a ⊓ U b ⊓ U d)).hom := by
      intro a b d
      refine RingHom.mem_ker.mpr ?_
      rw [hD1ι]
      exact hcz a b d

    obtain ⟨η, hηK, hηz⟩ := fex_rf_fibre_h2 A X f hf hdim U hUaff hUcov
      (fun W => RingHom.ker (ι.app W).hom)
      (fun W => Ideal.map (wcCnSigma f W) (IsLocalRing.maximalIdeal A ^ 1))
      (fun V W hV hW h => hKqc V W hV hW h) (fun V W _ _ h => hJqc _ V W h)
      (fun W => hIK 1 W le_rfl)
      (fun W => by
        rw [pow_one]
        exact (Ideal.mul_mono_right le_top).trans (by rw [Ideal.mul_top]))
      (fexRfD1 U ct) hzK (fun a b d e => hDD ct a b d e)
    obtain ⟨y0, hy0def⟩ : ∃ y0 : ∀ a b : Fin m, Γ(X, U a ⊓ U b),
        y0 = fun a b => ct a b - η a b := ⟨_, rfl⟩
    have hy0c : ∀ a b, (ι.app (U a ⊓ U b)).hom (y0 a b) = c a b := by
      intro a b
      rw [hy0def]
      simp only [map_sub, hct, RingHom.mem_ker.mp (hηK a b)]
      exact sub_zero _
    have hy0D : ∀ a b d, fexRfD1 U y0 a b d ∈
        Ideal.map (wcCnSigma f (U a ⊓ U b ⊓ U d)) (IsLocalRing.maximalIdeal A ^ 1) := by
      intro a b d
      rw [hy0def, hD1sub]
      exact hηz a b d

    have hstep : ∀ n : ℕ, ∃ y : ∀ a b : Fin m, Γ(X, U a ⊓ U b),
        (∀ a b, y a b - y0 a b ∈
          Ideal.map (wcCnSigma f (U a ⊓ U b)) (IsLocalRing.maximalIdeal A ^ 1)) ∧
        ∀ a b d, fexRfD1 U y a b d ∈
          Ideal.map (wcCnSigma f (U a ⊓ U b ⊓ U d)) (IsLocalRing.maximalIdeal A ^ (n + 1)) := by
      intro n
      induction n with
      | zero => exact ⟨y0, fun a b => by rw [sub_self]; exact Ideal.zero_mem _, hy0D⟩
      | succ n ih =>
        obtain ⟨y, hyy0, hyD⟩ := ih
        obtain ⟨η', hη'I, hη'z⟩ := fex_rf_fibre_h2 A X f hf hdim U hUaff hUcov
          (fun W => Ideal.map (wcCnSigma f W) (IsLocalRing.maximalIdeal A ^ (n + 1)))
          (fun W => Ideal.map (wcCnSigma f W) (IsLocalRing.maximalIdeal A ^ (n + 1 + 1)))
          (fun V W _ _ h => hJqc _ V W h) (fun V W _ _ h => hJqc _ V W h)
          (fun W => Ideal.map_mono (Ideal.pow_le_pow_right (by omega)))
          (fun W => le_of_eq (by
            rw [pow_succ' (IsLocalRing.maximalIdeal A) (n + 1), Ideal.map_mul]))
          (fexRfD1 U y) hyD (fun a b d e => hDD y a b d e)
        refine ⟨fun a b => y a b - η' a b, fun a b => ?_, fun a b d => ?_⟩
        · have h1 : η' a b ∈
              Ideal.map (wcCnSigma f (U a ⊓ U b)) (IsLocalRing.maximalIdeal A ^ 1) :=
            Ideal.map_mono (Ideal.pow_le_pow_right (by omega)) (hη'I a b)
          have h3 := Ideal.sub_mem _ (hyy0 a b) h1
          convert h3 using 1
          ring
        · rw [hD1sub]
          exact hη'z a b d

    obtain ⟨k, hk⟩ := fex_rf_cech_ar1 A (IsLocalRing.maximalIdeal A) X f hf U hUaff hUcov
    obtain ⟨y, hyy0, hyD⟩ := hstep k
    obtain ⟨w, hwI, hwD⟩ := hk 1 y (fun a b d => by rw [Nat.add_comm 1 k]; exact hyD a b d)

    obtain ⟨βX, hβX⟩ := hrawX (fun a b => y a b - w a b) (fun a b d => by
      have e := hwD a b d
      simp only [fexRfD1] at e
      linear_combination -e)

    refine ⟨fun a => (ι.app (U a)).hom (βX a), fun a b => ?_⟩
    have hwK : (ι.app (U a ⊓ U b)).hom (w a b) = 0 :=
      RingHom.mem_ker.mp (hIK 1 _ le_rfl (hwI a b))
    have hyK : (ι.app (U a ⊓ U b)).hom (y a b - y0 a b) = 0 :=
      RingHom.mem_ker.mp (hIK 1 _ le_rfl (hyy0 a b))
    have hy0y : (ι.app (U a ⊓ U b)).hom (y0 a b) = (ι.app (U a ⊓ U b)).hom (y a b - w a b) := by
      rw [map_sub, hwK, sub_zero]
      rw [map_sub, sub_eq_zero] at hyK
      exact hyK.symm
    have e := congrArg (ι.app (U a ⊓ U b)).hom (hβX a b)
    simp only [map_sub, nat] at e
    rw [← hy0c a b, hy0y, map_sub]
    exact e
  exact wcpa_dj_lge_sti_descend C L M hL hM β hle ⊥ (wcStructMod C)
    (fun O hO s => by
      obtain rfl := le_bot_iff.mp hO
      exact Subsingleton.elim (α := Γ(C, ⊥)) s 0)
    (fun i j => Or.inr rfl) 0 (tw_of_raw C M hraw_C)

theorem fex_cp1_topology : ∀ (k : Type u) [Field k] (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (q : C ⟶ Spec (.of k)), IsProper q → topologicalKrullDim C ≤ 1 →
    (∀ y : C, y ≠ genericPoint C → IsClosed ({y} : Set C)) ∧
    (∀ Z : Set C, IsClosed Z → genericPoint C ∉ Z → Z.Finite) :=
by
  intro k _ C _ q hq hdim
  haveI := hq
  have hmm : ∀ x : TopologicalSpace.IrreducibleCloseds C, IsMin x ∨ IsMax x :=
    Order.krullDim_le_one_iff.mp hdim
  have s2 : ∀ y : C, y ≠ genericPoint C → IsClosed ({y} : Set C) := by
    intro y hy
    let Y : TopologicalSpace.IrreducibleCloseds C :=
      ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
    let U : TopologicalSpace.IrreducibleCloseds C :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ C, isClosed_univ⟩
    have hnmax : ¬ IsMax Y := by
      intro hY
      have hYU : Y ≤ U := by
        rw [← SetLike.coe_subset_coe]
        exact Set.subset_univ _
      have h1 : U ≤ Y := hY hYU
      rw [← SetLike.coe_subset_coe] at h1
      have h2 : closure ({y} : Set C) = Set.univ := Set.eq_univ_of_univ_subset h1
      have hg : IsGenericPoint y Set.univ := h2
      exact hy (hg.eq (genericPoint_spec C))
    have hmin : IsMin Y := (hmm Y).resolve_right hnmax
    rw [← closure_subset_iff_isClosed]
    intro z hz
    let Zc : TopologicalSpace.IrreducibleCloseds C :=
      ⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩
    have h1 : Zc ≤ Y := by
      rw [← SetLike.coe_subset_coe]
      exact closure_minimal (Set.singleton_subset_iff.mpr hz) isClosed_closure
    have h2 : Y ≤ Zc := hmin h1
    rw [← SetLike.coe_subset_coe] at h1 h2
    have h3 : closure ({y} : Set C) = closure {z} := Set.Subset.antisymm h2 h1
    have h4 : Inseparable y z := inseparable_iff_closure_eq.mpr h3
    exact h4.eq.symm
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
  haveI : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace q
  haveI : AlgebraicGeometry.IsNoetherian C := {}
  refine ⟨s2, ?_⟩
  intro Z hZ hη
  obtain ⟨S, hSfin, hScl, hSirr, hZS⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hZ
  have hZS' := hZS
  rw [hZS]
  refine hSfin.sUnion ?_
  intro t ht
  obtain ⟨ξ, hξ⟩ := QuasiSober.sober (hSirr t ht) (hScl t ht)
  have hξt : ξ ∈ t := hξ.mem
  have hξZ : ξ ∈ Z := by rw [hZS']; exact Set.mem_sUnion_of_mem hξt ht
  have hne : ξ ≠ genericPoint C := fun h => hη (h ▸ hξZ)
  have ht' : t = {ξ} := by rw [← hξ.def, (s2 ξ hne).closure_eq]
  rw [ht']
  exact Set.finite_singleton ξ

theorem fex_cp1_raw_h1 : ∀ (Y : Scheme.{u}) {m : ℕ} (V : Fin m → Y.Opens),
    (∀ a, IsAffineOpen (V a)) → (⨆ a, V a) = ⊤ → wcpaDjFexH1 Y → wcpaP1rRawH1 V :=
by
  intro Y m V hV hcov hH1

  have hres : ∀ {U V W' : Y.Opens} (h1 : V ≤ U) (h2 : W' ≤ V) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
      (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W' h1 h2 x
    change (Y.presheaf.map (homOfLE h1).op ≫ Y.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hid : ∀ {U : Y.Opens} (h : U ≤ U) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h).op).hom x = x := by
    intro U h x
    rw [show homOfLE h = 𝟙 U from rfl, op_id, CategoryTheory.Functor.map_id]
    rfl
  have tr : ∀ {T P Q R : Y.Opens} (hTP : T ≤ P) (hTQ : T ≤ Q) (hTR : T ≤ R)
      (S : Y.Opens) (hS : S ≤ T) (x : Γ(Y, P)) (y : Γ(Y, Q)) (z : Γ(Y, R)),
      (Y.presheaf.map (homOfLE hTP).op).hom x =
        (Y.presheaf.map (homOfLE hTQ).op).hom y + (Y.presheaf.map (homOfLE hTR).op).hom z →
      (Y.presheaf.map (homOfLE (hS.trans hTP)).op).hom x =
        (Y.presheaf.map (homOfLE (hS.trans hTQ)).op).hom y +
          (Y.presheaf.map (homOfLE (hS.trans hTR)).op).hom z := by
    intro T P Q R hTP hTQ hTR S hS x y z e
    have e2 := congrArg (Y.presheaf.map (homOfLE hS).op).hom e
    rw [map_add, hres, hres, hres] at e2
    exact e2

  let L : wcpaDjCoc Y := ⟨m, V, fun _ _ => 1⟩
  have hOK : wcpaDjCocOK L := by
    refine ⟨hV, hcov, fun a => rfl, ?_⟩
    intro a b c
    simp only [L, Units.val_one, map_one, one_mul]
  have hTw := hH1 L hOK
  intro c hc
  have hT : ∀ (O : Y.Opens), O ≤ O ⊓ ⊤ := fun O => le_inf le_rfl le_top
  have hT' : ∀ (O : Y.Opens), O ⊓ ⊤ ≤ O := fun O => inf_le_left
  obtain ⟨β', hβ'⟩ := hTw
    (fun a b => (Y.presheaf.map (homOfLE (hT' (V a ⊓ V b))).op).hom (c a b)) (by
      intro a b d
      simp only [pow_zero, one_smul]
      show (Y.presheaf.map (homOfLE _).op).hom
          ((Y.presheaf.map (homOfLE (hT' (V a ⊓ V d))).op).hom (c a d)) =
        (Y.presheaf.map (homOfLE _).op).hom
          ((Y.presheaf.map (homOfLE (hT' (V b ⊓ V d))).op).hom (c b d)) +
        (Y.presheaf.map (homOfLE _).op).hom
          ((Y.presheaf.map (homOfLE (hT' (V a ⊓ V b))).op).hom (c a b))
      rw [hres, hres, hres]
      exact tr _ _ _ (V a ⊓ V b ⊓ V d ⊓ ⊤) inf_le_left _ _ _ (hc a b d))
  obtain ⟨β0, hβ0⟩ : ∃ β0 : ∀ a : Fin m, Γ(Y, V a ⊓ ⊤), ∀ a b : Fin m,
      (Y.presheaf.map (homOfLE (hT' (V a ⊓ V b))).op).hom (c a b) =
      (Y.presheaf.map (homOfLE (show V a ⊓ V b ⊓ ⊤ ≤ V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β0 b) -
        (Y.presheaf.map (homOfLE (show V a ⊓ V b ⊓ ⊤ ≤ V a ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β0 a) := by
    refine ⟨β', fun a b => ?_⟩
    have h := hβ' a b
    simp only [pow_zero, one_smul] at h
    exact h
  refine ⟨fun a => (Y.presheaf.map (homOfLE (hT (V a))).op).hom (β0 a), fun a b => ?_⟩
  have e := congrArg (Y.presheaf.map (homOfLE (hT (V a ⊓ V b))).op).hom (hβ0 a b)
  rw [map_sub, hres, hres, hres, hid] at e
  show c a b =
    (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE (hT (V b))).op).hom (β0 b)) -
      (Y.presheaf.map (homOfLE _).op).hom ((Y.presheaf.map (homOfLE (hT (V a))).op).hom (β0 a))
  rw [hres, hres]
  exact e

theorem fex_cp1_mittag_leffler : ∀ (k : Type u) [Field k] (C : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C] (q : C ⟶ Spec (.of k)), IsProper q →
    (∀ y : C, y ≠ genericPoint C → IsClosed ({y} : Set C)) →
    (∀ f : C.residueField (genericPoint C), f ∈ Set.range ⇑(fexRho C (genericPoint C))) →
    (∀ f : C.residueField (genericPoint C), {y : C | f ∉ Set.range ⇑(fexRho C y)}.Finite) →
    (∀ {m : ℕ} (V : Fin m → C.Opens), (∀ a, IsAffineOpen (V a)) → (⨆ a, V a) = ⊤ →
      wcpaP1rRawH1 V) →
    ∀ x : C, x ≠ genericPoint C → ∀ f : C.residueField (genericPoint C),
      ∃ β : C.presheaf.stalk x, ∀ y : C, y ≠ x → f + fexRho C x β ∈ Set.range ⇑(fexRho C y) :=
by
  intro k _ C _ q hq H2 H3 H4 H5 x hx f
  classical

  have hηmem : ∀ U : C.Opens, (U : Set C).Nonempty → genericPoint C ∈ U := by
    intro U hne
    obtain ⟨y, hy⟩ := hne
    exact ((genericPoint_spec C).mem_open_set_iff U.isOpen).mpr ⟨y, Set.mem_univ y, hy⟩

  obtain ⟨E, hEdef⟩ : ∃ E : ∀ U : C.Opens, genericPoint C ∈ U →
      (Γ(C, U) →+* C.residueField (genericPoint C)),
      ∀ U hU s, E U hU s =
        (C.residue (genericPoint C)).hom ((C.presheaf.germ U (genericPoint C) hU).hom s) :=
    ⟨fun U hU => (C.presheaf.germ U (genericPoint C) hU ≫ C.residue (genericPoint C)).hom,
      fun _ _ _ => rfl⟩

  have E1 : ∀ (U : C.Opens) (w : C) (hw : w ∈ U) (hU : genericPoint C ∈ U) (s : Γ(C, U)),
      fexRho C w ((C.presheaf.germ U w hw).hom s) = E U hU s := by
    intro U w hw hU s
    rw [hEdef]
    have e := TopCat.Presheaf.germ_stalkSpecializes_assoc C.presheaf hw
      (genericPoint_specializes w) (C.residue (genericPoint C))
    have e2 := congrArg
      (fun φ : C.presheaf.obj (Opposite.op U) ⟶ C.residueField (genericPoint C) => φ.hom s) e
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
    show (C.presheaf.stalkSpecializes (genericPoint_specializes w) ≫
      C.residue (genericPoint C)).hom ((C.presheaf.germ U w hw).hom s) = _
    rw [CommRingCat.hom_comp, RingHom.comp_apply]
    exact e2

  have E2 : ∀ (U : C.Opens) (hU : genericPoint C ∈ U), Function.Injective (E U hU) := by
    intro U hU a b hab
    rw [hEdef, hEdef] at hab
    exact germ_injective_of_isIntegral C (genericPoint C) hU (RingHom.injective _ hab)

  have E3 : ∀ (U V : C.Opens) (i : U ⟶ V) (hU : genericPoint C ∈ U) (s : Γ(C, V)),
      E U hU ((C.presheaf.map i.op).hom s) = E V (leOfHom i hU) s := by
    intro U V i hU s
    rw [hEdef, hEdef]
    have e := congrArg
      (fun φ : C.presheaf.obj (Opposite.op V) ⟶ C.presheaf.stalk (genericPoint C) =>
        (C.residue (genericPoint C)).hom (φ.hom s))
      (TopCat.Presheaf.germ_res C.presheaf i (genericPoint C) hU)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
    exact e
  have E3c : ∀ (U V : C.Opens) (i : U ⟶ V) (hU : genericPoint C ∈ U) (s : Γ(C, V)),
      E U hU (ConcreteCategory.hom (C.presheaf.map i.op) s) = E V (leOfHom i hU) s := E3

  have E4 : ∀ (U : C.Opens) (hU : genericPoint C ∈ U) (g : C.residueField (genericPoint C)),
      (∀ w ∈ U, g ∈ Set.range ⇑(fexRho C w)) → ∃ s, E U hU s = g := by
    intro U hU g hg
    have hloc : ∀ w : U, ∃ (O : C.Opens) (hwO : (w : C) ∈ O) (_ : O ≤ U) (s : Γ(C, O)),
        fexRho C w ((C.presheaf.germ O w hwO).hom s) = g := by
      intro w
      obtain ⟨t, ht⟩ := hg w w.2
      obtain ⟨O, hwO, s, hs⟩ := TopCat.Presheaf.exists_germ_eq C.presheaf t
      refine ⟨O ⊓ U, TopologicalSpace.Opens.mem_inf.mpr ⟨hwO, w.2⟩, inf_le_right,
        (C.presheaf.map (homOfLE inf_le_left : O ⊓ U ⟶ O).op).hom s, ?_⟩
      have e := congrArg (fun φ : C.presheaf.obj (Opposite.op O) ⟶ C.presheaf.stalk w =>
        φ.hom s) (TopCat.Presheaf.germ_res C.presheaf (homOfLE inf_le_left : O ⊓ U ⟶ O) w
          (TopologicalSpace.Opens.mem_inf.mpr ⟨hwO, w.2⟩))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
      rw [e, ← ht]
      congr 1
    choose O hwO hOU s hs using hloc
    have hηO : ∀ w, genericPoint C ∈ O w := fun w => hηmem (O w) ⟨w, hwO w⟩
    have hEs : ∀ w, E (O w) (hηO w) (s w) = g := fun w =>
      (E1 (O w) w (hwO w) (hηO w) (s w)).symm.trans (hs w)
    have hcompat : TopCat.Presheaf.IsCompatible C.presheaf O s := by
      intro i j
      apply E2 (O i ⊓ O j) (TopologicalSpace.Opens.mem_inf.mpr ⟨hηO i, hηO j⟩)
      rw [E3c, E3c, hEs, hEs]
    have hcov : U ≤ iSup O := by
      intro z hz
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨z, hz⟩, hwO ⟨z, hz⟩⟩
    obtain ⟨t, ht, -⟩ := TopCat.Sheaf.existsUnique_gluing' C.sheaf O U
      (fun w => homOfLE (hOU w)) hcov s hcompat
    refine ⟨t, ?_⟩
    have h1 := congrArg (E (O ⟨_, hU⟩) (hηO _)) (ht ⟨_, hU⟩)
    rw [hEs] at h1
    exact (E3c _ _ (homOfLE (hOU ⟨_, hU⟩)) (hηO _) t).symm.trans h1

  have hZ'fin : ({y : C | f ∉ Set.range ⇑(fexRho C y)} \ {x}).Finite :=
    (H4 f).subset Set.diff_subset
  have hZ'cl : IsClosed ({y : C | f ∉ Set.range ⇑(fexRho C y)} \ {x}) := by
    rw [← Set.biUnion_of_singleton ({y : C | f ∉ Set.range ⇑(fexRho C y)} \ {x})]
    refine hZ'fin.isClosed_biUnion (fun z hz => H2 z ?_)
    rintro rfl
    exact hz.1 (H3 f)
  obtain ⟨W, hWaff, hxW, hWO⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp C.isBasis_affineOpens)
      (show x ∈ (⟨_, hZ'cl.isOpen_compl⟩ : C.Opens) from fun h => h.2 (Set.mem_singleton x))
  have hWreg : ∀ y ∈ W, y ≠ x → f ∈ Set.range ⇑(fexRho C y) := by
    intro y hy hyx
    by_contra hf
    exact hWO hy ⟨hf, hyx⟩

  haveI := hq
  haveI : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace q
  have hxcl : IsClosed ({x} : Set C) := H2 x hx
  have hloc : ∀ y : C, ∃ U' : C.Opens, IsAffineOpen U' ∧ y ∈ U' ∧ (x ∈ U' → U' = W) := by
    intro y
    by_cases hyx : y = x
    · exact ⟨W, hWaff, by rw [hyx]; exact hxW, fun _ => rfl⟩
    · obtain ⟨U', hU'aff, hyU', hU'le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp C.isBasis_affineOpens)
          (show y ∈ (⟨_, hxcl.isOpen_compl⟩ : C.Opens) from hyx)
      exact ⟨U', hU'aff, hyU', fun hxU => absurd (Set.mem_singleton x) (hU'le hxU)⟩
  choose Uf hUfaff hyUf hUfW using hloc
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun y => (Uf y : Set C))
    (fun y => (Uf y).isOpen) (fun z _ => Set.mem_iUnion.mpr ⟨z, hyUf z⟩)
  obtain ⟨m, V, hVaff, hVtop, hVne, hVW⟩ : ∃ (m : ℕ) (V : Fin m → C.Opens),
      (∀ a, IsAffineOpen (V a)) ∧ (⨆ a, V a) = ⊤ ∧ (∀ a, (V a : Set C).Nonempty) ∧
      (∀ a, x ∈ V a → V a = W) := by
    refine ⟨t.card, fun j => Uf (t.equivFin.symm j), fun j => hUfaff _, ?_,
      fun j => ⟨_, hyUf _⟩, fun j => hUfW _⟩
    rw [eq_top_iff]
    intro z _
    have hz := ht (Set.mem_univ z)
    rw [Set.mem_iUnion₂] at hz
    obtain ⟨y, hyt, hzy⟩ := hz
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨t.equivFin ⟨y, hyt⟩, by simpa using hzy⟩

  obtain ⟨φ, hφ1, hφ0⟩ : ∃ φ : Fin m → C.residueField (genericPoint C),
      (∀ a, x ∈ V a → φ a = f) ∧ (∀ a, x ∉ V a → φ a = 0) :=
    ⟨fun a => if x ∈ V a then f else 0, fun a h => if_pos h, fun a h => if_neg h⟩
  have hηV : ∀ a, genericPoint C ∈ V a := fun a => hηmem _ (hVne a)
  have rsub : ∀ (z : C) (g₁ g₂ : C.residueField (genericPoint C)),
      g₁ ∈ Set.range ⇑(fexRho C z) → g₂ ∈ Set.range ⇑(fexRho C z) →
      g₁ - g₂ ∈ Set.range ⇑(fexRho C z) := by
    rintro z _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨a - b, map_sub _ a b⟩
  have radd : ∀ (z : C) (g₁ g₂ : C.residueField (genericPoint C)),
      g₁ ∈ Set.range ⇑(fexRho C z) → g₂ ∈ Set.range ⇑(fexRho C z) →
      g₁ + g₂ ∈ Set.range ⇑(fexRho C z) := by
    rintro z _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨a + b, map_add _ a b⟩
  have r0 : ∀ z : C, (0 : C.residueField (genericPoint C)) ∈ Set.range ⇑(fexRho C z) :=
    fun z => ⟨0, map_zero _⟩
  have hdiff : ∀ (a b : Fin m) (z : C), z ∈ V a ⊓ V b →
      φ a - φ b ∈ Set.range ⇑(fexRho C z) := by
    intro a b z hz
    have hza : z ∈ V a := (TopologicalSpace.Opens.mem_inf.mp hz).1
    have hzb : z ∈ V b := (TopologicalSpace.Opens.mem_inf.mp hz).2
    by_cases ha : x ∈ V a <;> by_cases hb : x ∈ V b
    · rw [hφ1 a ha, hφ1 b hb, sub_self]; exact r0 z
    · rw [hφ1 a ha, hφ0 b hb, sub_zero]
      refine hWreg z (by rw [← hVW a ha]; exact hza) ?_
      intro hzx
      rw [hzx] at hzb
      exact hb hzb
    · rw [hφ0 a ha, hφ1 b hb]
      refine rsub z _ _ (r0 z) (hWreg z (by rw [← hVW b hb]; exact hzb) ?_)
      intro hzx
      rw [hzx] at hza
      exact ha hza
    · rw [hφ0 a ha, hφ0 b hb, sub_zero]; exact r0 z

  have hηab : ∀ a b, genericPoint C ∈ V a ⊓ V b := fun a b =>
    TopologicalSpace.Opens.mem_inf.mpr ⟨hηV a, hηV b⟩
  have hc : ∀ a b, ∃ c : Γ(C, V a ⊓ V b), E (V a ⊓ V b) (hηab a b) c = φ a - φ b :=
    fun a b => E4 _ _ _ (fun z hz => hdiff a b z hz)
  choose c hc using hc
  obtain ⟨β, hβ⟩ := H5 V hVaff hVtop c (by
    intro a b d
    have hT : genericPoint C ∈ V a ⊓ V b ⊓ V d :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨hηab a b, hηV d⟩
    apply E2 _ hT
    rw [map_add, E3, E3, E3, hc, hc, hc]
    ring)
  have hrel : ∀ a b, φ a + E (V a) (hηV a) (β a) = φ b + E (V b) (hηV b) (β b) := by
    intro a b
    have h1 := congrArg (E (V a ⊓ V b) (hηab a b)) (hβ a b)
    rw [hc, map_sub, E3, E3] at h1
    linear_combination h1

  have hxtop : x ∈ (⨆ a, V a) := by rw [hVtop]; trivial
  obtain ⟨a₀, hxa₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hxtop
  refine ⟨(C.presheaf.germ (V a₀) x hxa₀).hom (β a₀), fun y hy => ?_⟩
  have hytop : y ∈ (⨆ a, V a) := by rw [hVtop]; trivial
  obtain ⟨a, hya⟩ := TopologicalSpace.Opens.mem_iSup.mp hytop
  rw [E1 (V a₀) x hxa₀ (hηV a₀), ← hφ1 a₀ hxa₀, hrel a₀ a, ← E1 (V a) y hya (hηV a)]
  by_cases hxa : x ∈ V a
  · rw [hφ1 a hxa]
    exact radd y _ _ (hWreg y (by rw [← hVW a hxa]; exact hya) hy) ⟨_, rfl⟩
  · rw [hφ0 a hxa, zero_add]
    exact ⟨_, rfl⟩

theorem fex_cp1_integral_const : ∀ (k : Type u) [Field k] [IsAlgClosed k] (C : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C] (q : C ⟶ Spec (.of k)), IsProper q →
    ∀ g : C.residueField (genericPoint C), (∀ y : C, (fexRho C y).IsIntegralElem g) →
      g ∈ Set.range ⇑(wcpaDjFK k q (genericPoint C)) :=
by
  intro k _ _ C _ q hq g hg
  classical
  haveI := hq
  letI : Algebra k (C.residueField (genericPoint C)) := (wcpaDjFK k q (genericPoint C)).toAlgebra
  have s3 : ∀ (R : Type u) [CommRing R] (ρ : R →+* C.residueField (genericPoint C))
      (V : ValuationSubring (C.residueField (genericPoint C))),
      (∀ r : R, ρ r ∈ V) → ∀ g : C.residueField (genericPoint C), ρ.IsIntegralElem g → g ∈ V := by
    intro R _ ρ V h g hg
    obtain ⟨p, hpm, hp⟩ := hg
    let ρV : R →+* V := ρ.codRestrict V h
    have hcomp : (algebraMap V (C.residueField (genericPoint C))).comp ρV = ρ := by
      ext r; rfl
    have hint : IsIntegral V g :=
      ⟨p.map ρV, hpm.map ρV, by rw [Polynomial.eval₂_map, hcomp]; exact hp⟩
    obtain ⟨y', hy'⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
    rw [← hy']
    exact y'.2
  have hall : ∀ V : ValuationSubring (C.residueField (genericPoint C)), wcpaDjNtV' k V → g ∈ V := by
    intro V hV
    have hW : IsAffineOpen (⊤ : (Spec (.of k)).Opens) := isAffineOpen_top _
    have hcond : ∀ r : Γ(Spec (.of k), ⊤), (q.app ⊤ ≫ C.presheaf.germ (q ⁻¹ᵁ ⊤) (genericPoint C)
        trivial ≫ C.residue (genericPoint C)).hom r ∈ V := by
      intro r
      have e : wcpaDjFK k q (genericPoint C) ((Scheme.ΓSpecIso (.of k)).hom r) =
          (q.app ⊤ ≫ C.presheaf.germ (q ⁻¹ᵁ ⊤) (genericPoint C) trivial ≫
            C.residue (genericPoint C)).hom r := by
        show ((Scheme.ΓSpecIso (.of k)).inv ≫ q.appTop ≫ C.presheaf.germ ⊤ (genericPoint C) trivial ≫
          C.residue (genericPoint C)).hom ((Scheme.ΓSpecIso (.of k)).hom r) = _
        rw [CommRingCat.hom_comp, RingHom.comp_apply, Iso.hom_inv_id_apply]
        rfl
      rw [← e]
      exact hV.1 _
    obtain ⟨y, -, hy⟩ := wcpa_dj_lcp_ra_valuative_center q inferInstance ⊤ hW (genericPoint C)
      trivial V hcond
    refine s3 (C.presheaf.stalk y) (fexRho C y) V ?_ g (hg y)
    intro a
    obtain ⟨O', hyO, σ, rfl⟩ := TopCat.Presheaf.exists_germ_eq C.presheaf a
    obtain ⟨hη', v, hv, -⟩ := hy O' hyO σ
    have e : fexRho C y (C.presheaf.germ O' y hyO σ) =
        (C.presheaf.germ O' (genericPoint C) hη' ≫ C.residue (genericPoint C)).hom σ := by
      simp only [fexRho, CommRingCat.hom_comp, RingHom.comp_apply]
      rw [TopCat.Presheaf.germ_stalkSpecializes_apply]
    rw [e, ← hv]
    exact v.2
  obtain ⟨c, hc⟩ := (wcpa_dj_ffv_integral_const k (C.residueField (genericPoint C))).2 g hall
  exact ⟨c, hc⟩

theorem fex_cp1_normal : ∀ (k : Type u) [Field k] (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (q : C ⟶ Spec (.of k)),
    (∀ y : C, letI := (fexRho C y).toAlgebra;
      IsFractionRing (C.presheaf.stalk y) (C.residueField (genericPoint C))) →
    (∀ f : C.residueField (genericPoint C), f ∈ Set.range ⇑(fexRho C (genericPoint C))) →
    (∀ x : C, x ≠ genericPoint C → ∀ f : C.residueField (genericPoint C),
      ∃ β : C.presheaf.stalk x, ∀ y : C, y ≠ x → f + fexRho C x β ∈ Set.range ⇑(fexRho C y)) →
    (∀ g : C.residueField (genericPoint C), (∀ y : C, (fexRho C y).IsIntegralElem g) →
      g ∈ Set.range ⇑(wcpaDjFK k q (genericPoint C))) →
    (∀ (y : C) (c : k), wcpaDjFK k q (genericPoint C) c ∈ Set.range ⇑(fexRho C y)) →
    ∀ x : C, IsIntegrallyClosed (C.presheaf.stalk x) :=
by
  intro k _ C _ q hfrac hgen hML hIC hconst x
  letI : Algebra (C.presheaf.stalk x) (C.residueField (genericPoint C)) := (fexRho C x).toAlgebra
  haveI : IsFractionRing (C.presheaf.stalk x) (C.residueField (genericPoint C)) := hfrac x
  refine (isIntegrallyClosed_iff (C.residueField (genericPoint C))).mpr ?_
  intro g hg
  have hg' : (fexRho C x).IsIntegralElem g := hg
  show ∃ y, fexRho C x y = g
  by_cases hx : x = genericPoint C
  · subst hx
    exact hgen g
  · obtain ⟨β, hβ⟩ := hML x hx g
    have hhx : (fexRho C x).IsIntegralElem (g + fexRho C x β) :=
      RingHom.IsIntegralElem.add (fexRho C x) hg' (RingHom.isIntegralElem_map (fexRho C x))
    have hall : ∀ y : C, (fexRho C y).IsIntegralElem (g + fexRho C x β) := by
      intro y
      by_cases hy : y = x
      · subst hy
        exact hhx
      · obtain ⟨a, ha⟩ := hβ y hy
        rw [← ha]
        exact RingHom.isIntegralElem_map (fexRho C y)
    obtain ⟨c, hc⟩ := hIC _ hall
    obtain ⟨γ, hγ⟩ := hconst x c
    refine ⟨γ - β, ?_⟩
    rw [map_sub, hγ, hc, add_sub_cancel_right]

theorem fex_cp1_poly_in_t : ∀ (k : Type u) [Field k] (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (q : C ⟶ Spec (.of k)) (p : C) (ϖ : C.presheaf.stalk p), ϖ ≠ 0 →
    IsLocalRing.maximalIdeal (C.presheaf.stalk p) = Ideal.span {ϖ} →
    Function.Injective ⇑(fexRho C p) →
    (∀ f : C.residueField (genericPoint C), ∃ (n : ℕ) (a : C.presheaf.stalk p),
      fexRho C p ϖ ^ n * f = fexRho C p a) →
    (∀ a : C.presheaf.stalk p, ∃ (c : k), ∃ b ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk p),
      fexRho C p a = wcpaDjFK k q (genericPoint C) c + fexRho C p b) →
    (∀ (y : C) (c : k), wcpaDjFK k q (genericPoint C) c ∈ Set.range ⇑(fexRho C y)) →
    (∀ g : C.residueField (genericPoint C), (∀ y : C, g ∈ Set.range ⇑(fexRho C y)) →
      g ∈ Set.range ⇑(wcpaDjFK k q (genericPoint C))) →
    ∀ t : C.residueField (genericPoint C), (∀ y : C, y ≠ p → t ∈ Set.range ⇑(fexRho C y)) →
    (∃ b ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk p), t * fexRho C p ϖ = 1 + fexRho C p b) →
    ∀ f : C.residueField (genericPoint C), (∀ y : C, y ≠ p → f ∈ Set.range ⇑(fexRho C y)) →
      ∃ P : Polynomial k, f = P.eval₂ (wcpaDjFK k q (genericPoint C)) t :=
by
  intro k _ C _ q p ϖ H1 H2 H3 H4 H5 H6 H7 t Ht1 Ht2
  classical
  have s1 : fexRho C p ϖ ≠ 0 := fun h => H1 (H3 (h.trans (map_zero _).symm))
  obtain ⟨b₀, hb₀, hb₀eq⟩ := Ht2
  have s3 : ∀ m : ℕ, ∃ b₁ ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk p),
      (t * fexRho C p ϖ) ^ m = 1 + fexRho C p b₁ := by
    intro m
    induction m with
    | zero => exact ⟨0, Ideal.zero_mem _, by simp⟩
    | succ m ih =>
      obtain ⟨b₁, hb₁, h⟩ := ih
      refine ⟨b₁ + b₀ + b₁ * b₀,
        Ideal.add_mem _ (Ideal.add_mem _ hb₁ hb₀) (Ideal.mul_mem_left _ b₁ hb₀), ?_⟩
      rw [pow_succ, h, hb₀eq, map_add, map_add, map_mul]
      ring
  have s4 : ∀ n : ℕ, ∀ f : C.residueField (genericPoint C),
      (∀ y : C, y ≠ p → f ∈ Set.range ⇑(fexRho C y)) →
      (∃ a : C.presheaf.stalk p, fexRho C p ϖ ^ n * f = fexRho C p a) →
      ∃ P : Polynomial k, f = P.eval₂ (wcpaDjFK k q (genericPoint C)) t := by
    intro n
    induction n with
    | zero =>
      intro f hf hfa
      obtain ⟨a, ha⟩ := hfa
      rw [pow_zero, one_mul] at ha
      have hall : ∀ y : C, f ∈ Set.range ⇑(fexRho C y) := by
        intro y
        by_cases hy : y = p
        · rw [hy]; exact ⟨a, ha.symm⟩
        · exact hf y hy
      obtain ⟨c, hc⟩ := H7 f hall
      exact ⟨Polynomial.C c, by rw [Polynomial.eval₂_C, hc]⟩
    | succ n ih =>
      intro f hf hfa
      obtain ⟨a, ha⟩ := hfa
      obtain ⟨c, b, hb, hab⟩ := H5 a
      obtain ⟨γ, hγ⟩ := H6 p c
      obtain ⟨b₁, hb₁, h3⟩ := s3 (n + 1)
      have key : fexRho C p ϖ ^ (n + 1) * (f - wcpaDjFK k q (genericPoint C) c * t ^ (n + 1)) =
          fexRho C p (b - γ * b₁) := by
        rw [map_sub, map_mul]
        linear_combination ha + hab - wcpaDjFK k q (genericPoint C) c * h3 +
          fexRho C p b₁ * hγ
      have hmem : b - γ * b₁ ∈ Ideal.span {ϖ} := by
        rw [← H2]; exact Ideal.sub_mem _ hb (Ideal.mul_mem_left _ γ hb₁)
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hmem
      have hcancel : fexRho C p ϖ ^ n * (f - wcpaDjFK k q (genericPoint C) c * t ^ (n + 1)) =
          fexRho C p d := by
        apply mul_left_cancel₀ s1
        rw [← mul_assoc, ← pow_succ', key, ← hd, map_mul, mul_comm]
      have hreg : ∀ y : C, y ≠ p →
          (f - wcpaDjFK k q (genericPoint C) c * t ^ (n + 1)) ∈ Set.range ⇑(fexRho C y) := by
        intro y hy
        obtain ⟨a1, ha1⟩ := hf y hy
        obtain ⟨a2, ha2⟩ := H6 y c
        obtain ⟨a3, ha3⟩ := Ht1 y hy
        exact ⟨a1 - a2 * a3 ^ (n + 1), by rw [map_sub, map_mul, map_pow, ha1, ha2, ha3]⟩
      obtain ⟨P', hP'⟩ := ih _ hreg ⟨d, hcancel⟩
      refine ⟨P' + Polynomial.C c * Polynomial.X ^ (n + 1), ?_⟩
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
        Polynomial.eval₂_X_pow, ← hP']
      ring
  intro f hf
  obtain ⟨n, a, ha⟩ := H4 f
  exact s4 n f hf ⟨a, ha⟩

theorem fex_cp1_rational_in_t : ∀ (k : Type u) [Field k] (C : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C] (q : C ⟶ Spec (.of k)) (p : C)
    (t : C.residueField (genericPoint C)),
    (∀ f : C.residueField (genericPoint C), (∀ y : C, y ≠ p → f ∈ Set.range ⇑(fexRho C y)) →
      ∃ P : Polynomial k, f = P.eval₂ (wcpaDjFK k q (genericPoint C)) t) →
    (∀ Q : Polynomial k, Q ≠ 0 → Q.eval₂ (wcpaDjFK k q (genericPoint C)) t ≠ 0) →
    (∀ y : C, y ≠ p → t ∈ Set.range ⇑(fexRho C y)) →
    (∀ (y : C) (c : k), wcpaDjFK k q (genericPoint C) c ∈ Set.range ⇑(fexRho C y)) →
    (∀ y : C, y ≠ genericPoint C → ∀ s ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk y),
      ∀ f : C.residueField (genericPoint C), ∃ (N : ℕ) (a : C.presheaf.stalk y),
        fexRho C y s ^ N * f = fexRho C y a) →
    (∀ y : C, y ≠ genericPoint C → ∀ a : C.presheaf.stalk y, ∃ (c : k),
      ∃ b ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk y),
        fexRho C y a = wcpaDjFK k q (genericPoint C) c + fexRho C y b) →
    (∀ f : C.residueField (genericPoint C), f ∈ Set.range ⇑(fexRho C (genericPoint C))) →
    (∀ f : C.residueField (genericPoint C), {y : C | f ∉ Set.range ⇑(fexRho C y)}.Finite) →
    letI : Algebra k (C.residueField (genericPoint C)) := (wcpaDjFK k q (genericPoint C)).toAlgebra
    ∀ f : C.residueField (genericPoint C), f ∈ IntermediateField.adjoin k {t} :=
by
  intro k _ C _ q p t h1 h2 h3 h4 h5 h6 h7 h8
  letI : Algebra k (C.residueField (genericPoint C)) := (wcpaDjFK k q (genericPoint C)).toAlgebra
  intro f
  classical
  have hS_mem : ∀ y, y ∈ (h8 f).toFinset.erase p ↔
      y ≠ p ∧ f ∉ Set.range ⇑(fexRho C y) := by
    intro y
    rw [Finset.mem_erase, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
  have key : ∀ y ∈ (h8 f).toFinset.erase p, ∃ c : k, ∃ N : ℕ,
      (t - wcpaDjFK k q (genericPoint C) c) ^ N * f ∈ Set.range ⇑(fexRho C y) := by
    intro y hy
    obtain ⟨hyp, hyf⟩ := (hS_mem y).mp hy
    have hyη : y ≠ genericPoint C := by
      rintro rfl
      exact hyf (h7 f)
    obtain ⟨a, ha⟩ := h3 y hyp
    obtain ⟨c, b, hb, hab⟩ := h6 y hyη a
    obtain ⟨N, a', ha'⟩ := h5 y hyη b hb f
    refine ⟨c, N, a', ?_⟩
    have e : t - wcpaDjFK k q (genericPoint C) c = fexRho C y b := by
      rw [← ha, hab]; ring
    rw [e, ha']
  choose! c N hcN using key
  have hgreg : ∀ y, y ≠ p → ∀ z,
      (t - wcpaDjFK k q (genericPoint C) (c z)) ^ (N z) ∈ (fexRho C y).range := by
    intro y hy z
    apply Subring.pow_mem
    apply Subring.sub_mem
    · exact RingHom.mem_range.mpr (h3 y hy)
    · exact RingHom.mem_range.mpr (h4 y (c z))
  have hGeq : (∏ z ∈ (h8 f).toFinset.erase p,
      (Polynomial.X - Polynomial.C (c z)) ^ (N z)).eval₂ (wcpaDjFK k q (genericPoint C)) t =
      ∏ z ∈ (h8 f).toFinset.erase p, (t - wcpaDjFK k q (genericPoint C) (c z)) ^ (N z) := by
    simp only [Polynomial.eval₂_finsetProd, Polynomial.eval₂_pow, Polynomial.eval₂_sub,
      Polynomial.eval₂_X, Polynomial.eval₂_C]
  have hQmon : (∏ z ∈ (h8 f).toFinset.erase p,
      (Polynomial.X - Polynomial.C (c z)) ^ (N z)).Monic :=
    Polynomial.monic_prod_of_monic _ _ (fun z _ => (Polynomial.monic_X_sub_C (c z)).pow (N z))
  have hG0 : (∏ z ∈ (h8 f).toFinset.erase p,
      (t - wcpaDjFK k q (genericPoint C) (c z)) ^ (N z)) ≠ 0 := by
    rw [← hGeq]; exact h2 _ hQmon.ne_zero
  have hGf : ∀ y, y ≠ p → (∏ z ∈ (h8 f).toFinset.erase p,
      (t - wcpaDjFK k q (genericPoint C) (c z)) ^ (N z)) * f ∈ Set.range ⇑(fexRho C y) := by
    intro y hy
    apply RingHom.mem_range.mp
    by_cases hyS : y ∈ (h8 f).toFinset.erase p
    · rw [← Finset.mul_prod_erase _ _ hyS]
      have e : (t - wcpaDjFK k q (genericPoint C) (c y)) ^ (N y) *
          (∏ z ∈ ((h8 f).toFinset.erase p).erase y,
            (t - wcpaDjFK k q (genericPoint C) (c z)) ^ (N z)) * f =
          ((t - wcpaDjFK k q (genericPoint C) (c y)) ^ (N y) * f) *
          (∏ z ∈ ((h8 f).toFinset.erase p).erase y,
            (t - wcpaDjFK k q (genericPoint C) (c z)) ^ (N z)) := by ring
      rw [e]
      exact Subring.mul_mem _ (RingHom.mem_range.mpr (hcN y hyS))
        (Subring.prod_mem _ (fun z _ => hgreg y hy z))
    · have hf : f ∈ Set.range ⇑(fexRho C y) := by
        by_contra hf
        exact hyS ((hS_mem y).mpr ⟨hy, hf⟩)
      exact Subring.mul_mem _ (Subring.prod_mem _ (fun z _ => hgreg y hy z))
        (RingHom.mem_range.mpr hf)
  obtain ⟨P, hP⟩ := h1 _ hGf
  have hmem : ∀ R : Polynomial k,
      R.eval₂ (wcpaDjFK k q (genericPoint C)) t ∈ IntermediateField.adjoin k {t} := by
    intro R
    have e : R.eval₂ (wcpaDjFK k q (genericPoint C)) t = Polynomial.aeval t R := by
      rw [Polynomial.aeval_def]; rfl
    rw [e]
    exact IntermediateField.algebra_adjoin_le_adjoin k {t}
      (Polynomial.aeval_mem_adjoin_singleton k t)
  have hfeq : f = P.eval₂ (wcpaDjFK k q (genericPoint C)) t /
      (∏ z ∈ (h8 f).toFinset.erase p,
        (Polynomial.X - Polynomial.C (c z)) ^ (N z)).eval₂ (wcpaDjFK k q (genericPoint C)) t := by
    rw [← hP, hGeq, mul_div_cancel_left₀ f hG0]
  rw [hfeq]
  exact IntermediateField.div_mem _ (hmem P) (hmem _)

theorem fex_cp1_regular_locus_open : ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C]
    (f : C.residueField (genericPoint C)), IsOpen {y : C | f ∈ Set.range ⇑(fexRho C y)} :=
by
  intro C _ f
  rw [isOpen_iff_forall_mem_open]
  rintro y ⟨a, rfl⟩
  obtain ⟨O', hy, σ, rfl⟩ := C.presheaf.exists_germ_eq a
  have key : ∀ (w : C) (hw : w ∈ O'), fexRho C w (C.presheaf.germ O' w hw σ) =
      (C.residue (genericPoint C)).hom (C.presheaf.germ O' (genericPoint C)
        ((genericPoint_specializes w).mem_open O'.isOpen hw) σ) := by
    intro w hw
    simp only [fexRho, CommRingCat.hom_comp, RingHom.comp_apply,
      TopCat.Presheaf.germ_stalkSpecializes_apply]
  refine ⟨(O' : Set C), ?_, O'.isOpen, hy⟩
  intro z hz
  refine ⟨C.presheaf.germ O' z hz σ, ?_⟩
  rw [key z hz, key y hy]

theorem fex_cp1_rho_basics : ∀ (C : Scheme.{u}) [AlgebraicGeometry.IsIntegral C] (y : C),
    Function.Injective ⇑(fexRho C y) ∧
    (letI := (fexRho C y).toAlgebra;
      IsFractionRing (C.presheaf.stalk y) (C.residueField (genericPoint C))) ∧
    Function.Surjective ⇑(fexRho C (genericPoint C)) ∧
    (IsDiscreteValuationRing (C.presheaf.stalk y) → ∀ s ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk y),
      ∀ f : C.residueField (genericPoint C), ∃ (N : ℕ) (a : C.presheaf.stalk y),
        fexRho C y s ^ N * f = fexRho C y a) :=
by
  intro C _ y
  classical
  have hrinj : Function.Injective (C.residue (genericPoint C)).hom :=
    RingHom.injective _
  have hrsurj : Function.Surjective (C.residue (genericPoint C)).hom :=
    Scheme.residue_surjective C _
  have hkey : ∀ z : C, fexRho C z =
      (C.residue (genericPoint C)).hom.comp (algebraMap (C.presheaf.stalk z) C.functionField) :=
    fun z => rfl
  have hinj : ∀ z : C, Function.Injective ⇑(fexRho C z) := by
    intro z
    rw [hkey z, RingHom.coe_comp]
    exact hrinj.comp (IsFractionRing.injective (C.presheaf.stalk z) C.functionField)
  have hfrac : letI := (fexRho C y).toAlgebra;
      IsFractionRing (C.presheaf.stalk y) (C.residueField (genericPoint C)) := by
    letI := (fexRho C y).toAlgebra
    let e : C.functionField ≃+* C.residueField (genericPoint C) :=
      RingEquiv.ofBijective (C.residue (genericPoint C)).hom ⟨hrinj, hrsurj⟩
    let h : C.functionField ≃ₐ[C.presheaf.stalk y] C.residueField (genericPoint C) :=
      AlgEquiv.ofRingEquiv (f := e) (fun x => rfl)
    exact IsLocalization.isLocalization_of_algEquiv (nonZeroDivisors (C.presheaf.stalk y)) h
  have hsurj : Function.Surjective ⇑(fexRho C (genericPoint C)) := by
    have h1 : fexRho C (genericPoint C) = (C.residue (genericPoint C)).hom := by
      show (C.presheaf.stalkSpecializes (genericPoint_specializes (genericPoint C)) ≫
        C.residue (genericPoint C)).hom = _
      rw [TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp]
    rw [h1]
    exact hrsurj
  refine ⟨hinj y, hfrac, hsurj, ?_⟩
  intro hdvr s hs f
  letI := (fexRho C y).toAlgebra
  haveI := hfrac
  obtain ⟨⟨a', ⟨b, hb⟩⟩, hf⟩ := IsLocalization.surj (nonZeroDivisors (C.presheaf.stalk y)) f
  have hf0 : f * fexRho C y b = fexRho C y a' := hf
  have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (C.presheaf.stalk y)
  obtain ⟨j, u, hbu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hϖ
  have hs' : s ∈ Ideal.span {ϖ} := by
    rw [← hϖ.maximalIdeal_eq]
    convert hs
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hs'
  refine ⟨j, c ^ j * ↑u⁻¹ * a', ?_⟩
  have hVU : fexRho C y ↑u⁻¹ * fexRho C y ↑u = 1 := by
    rw [← map_mul, Units.inv_mul, map_one]
  have hf' : f * (fexRho C y ↑u * fexRho C y ϖ ^ j) = fexRho C y a' := by
    rw [← map_pow, ← map_mul, ← hbu]
    exact hf0
  rw [← hc]
  simp only [map_mul, map_pow]
  linear_combination (fexRho C y c ^ j * fexRho C y ↑u⁻¹) * hf' -
    (fexRho C y c ^ j * fexRho C y ϖ ^ j * f) * hVU

theorem fex_cp1_constants : ∀ (k : Type u) [Field k] [IsAlgClosed k] (C : Scheme.{u})
    [AlgebraicGeometry.IsIntegral C] (q : C ⟶ Spec (.of k)), LocallyOfFiniteType q →
    (∀ (y : C) (c : k), wcpaDjFK k q (genericPoint C) c ∈ Set.range ⇑(fexRho C y)) ∧
    (∀ y : C, IsClosed ({y} : Set C) → ∀ a : C.presheaf.stalk y, ∃ (c : k),
      ∃ b ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk y),
        fexRho C y a = wcpaDjFK k q (genericPoint C) c + fexRho C y b) :=
by
  intro k _ _ C _ q hq
  haveI := hq
  have hsurj : ∀ (y : C), IsClosed ({y} : Set C) →
      Function.Surjective ((C.evaluation ⊤ y trivial).hom.comp
        (q.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom)) := by
    intro y hy
    haveI : JacobsonSpace C := LocallyOfFiniteType.jacobsonSpace q
    haveI : LocallyOfFiniteType (C.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    set g := C.fromSpecResidueField y ≫ q with hg
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hft : (Spec.preimage g).hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    have hs2 : (C.fromSpecResidueField y).appTop ≫ (Scheme.ΓSpecIso (C.residueField y)).hom =
        C.evaluation ⊤ y trivial := by
      rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
      simp only [Category.assoc]
      erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc, Scheme.germ_residue]
    have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ q.appTop ≫
        C.evaluation ⊤ y trivial := by
      rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ, hg, Scheme.Hom.comp_appTop,
        Category.assoc, hs2]
    have hφ : (C.evaluation ⊤ y trivial).hom.comp
        (q.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom) =
        (Spec.preimage g).hom := by
      rw [heq]; rfl
    rw [hφ]
    letI : Algebra k (C.residueField y) := (Spec.preimage g).hom.toAlgebra
    haveI : Algebra.FiniteType k (C.residueField y) := hft
    haveI : Module.Finite k (C.residueField y) := finite_of_finite_type_of_isJacobsonRing k _
    intro s
    have hs : IsIntegral k s := Algebra.IsIntegral.isIntegral s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible k (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one k s hdeg
    exact ⟨c, hc⟩
  have hA : ∀ (y : C) (c : k), fexRho C y ((C.presheaf.germ ⊤ y trivial).hom
      (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom c))) =
      wcpaDjFK k q (genericPoint C) c := by
    intro y c
    simp only [fexRho, wcpaDjFK, CommRingCat.hom_comp, RingHom.comp_apply]
    erw [TopCat.Presheaf.germ_stalkSpecializes_apply]
  refine ⟨fun y c => ⟨_, hA y c⟩, ?_⟩
  intro y hy a
  obtain ⟨c, hc⟩ := hsurj y hy ((C.residue y).hom a)
  refine ⟨c, a - (C.presheaf.germ ⊤ y trivial).hom
    (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom c)), ?_, ?_⟩
  · rw [← IsLocalRing.residue_eq_zero_iff]
    change (C.residue y).hom _ = 0
    rw [map_sub, sub_eq_zero, ← hc]
    rfl
  · rw [map_sub, hA]
    ring

theorem fex_curve_P1 : ∀ (k : Type u) [Field k] [IsAlgClosed k] (C : Scheme.{u})
    (q : C ⟶ Spec (.of k)), IsProper q → AlgebraicGeometry.IsIntegral C →
    topologicalKrullDim C ≤ 1 → Nontrivial C → wcpaDjFexH1 C →
    ∃ θ : C ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) k)
        MvPolynomial.gradedAlgebra,
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) k)
          MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom (algebraMap k
          ↥(MvPolynomial.homogeneousSubmodule (Fin 2) k 0))) = q :=
by
  intro k _ _ C q hq hC hdim hnt hH1
  classical
  haveI := hq
  haveI := hC
  haveI := hnt
  obtain ⟨hcl, hfin⟩ := fex_cp1_topology k C q hq hdim
  have hρ := fex_cp1_rho_basics C
  have hinj : ∀ y : C, Function.Injective ⇑(fexRho C y) := fun y => (hρ y).1
  have hfrac : ∀ y : C, letI := (fexRho C y).toAlgebra;
      IsFractionRing (C.presheaf.stalk y) (C.residueField (genericPoint C)) := fun y => (hρ y).2.1
  have hsurjη : Function.Surjective ⇑(fexRho C (genericPoint C)) := (hρ (genericPoint C)).2.2.1
  have hregη : ∀ f : C.residueField (genericPoint C),
      f ∈ Set.range ⇑(fexRho C (genericPoint C)) := fun f => hsurjη f
  obtain ⟨hconst, hres⟩ := fex_cp1_constants k C q inferInstance
  have hpole : ∀ f : C.residueField (genericPoint C),
      {y : C | f ∉ Set.range ⇑(fexRho C y)}.Finite := by
    intro f
    apply hfin
    · exact (fex_cp1_regular_locus_open C f).isClosed_compl
    · intro h
      exact h (hregη f)
  have hraw : ∀ {m : ℕ} (V : Fin m → C.Opens), (∀ a, IsAffineOpen (V a)) → (⨆ a, V a) = ⊤ →
      wcpaP1rRawH1 V := fun V hV hT => fex_cp1_raw_h1 C V hV hT hH1
  have hML := fex_cp1_mittag_leffler k C q hq hcl hregη hpole hraw
  have hIC := fex_cp1_integral_const k C q hq
  have hnorm := fex_cp1_normal k C q hfrac hregη hML hIC hconst
  have hdvr : ∀ x : C, x ≠ genericPoint C → IsDiscreteValuationRing (C.presheaf.stalk x) :=
    wc_curve_stalk_dvr k C q hnorm hcl
  have hval : ∀ y : C, ValuationRing (C.presheaf.stalk y) := by
    intro y
    by_cases hy : y = genericPoint C
    · rw [hy]
      exact inferInstanceAs (ValuationRing C.functionField)
    · haveI := hdvr y hy
      infer_instance

  obtain ⟨p, hp⟩ := exists_ne (genericPoint C)
  haveI hpdvr := hdvr p hp
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (C.presheaf.stalk p)
  have hmax : IsLocalRing.maximalIdeal (C.presheaf.stalk p) = Ideal.span {ϖ} :=
    hϖ.maximalIdeal_eq
  have hϖ0 : ϖ ≠ 0 := hϖ.ne_zero
  have hρϖ : fexRho C p ϖ ≠ 0 := fun h => hϖ0 (hinj p (h.trans (map_zero _).symm))
  have hϖmem : ϖ ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk p) := by
    rw [hmax]; exact Ideal.mem_span_singleton_self ϖ
  obtain ⟨β, hβ⟩ := hML p hp (fexRho C p ϖ)⁻¹
  obtain ⟨t, ht⟩ : ∃ t : C.residueField (genericPoint C), t = (fexRho C p ϖ)⁻¹ + fexRho C p β :=
    ⟨_, rfl⟩
  have htreg : ∀ y : C, y ≠ p → t ∈ Set.range ⇑(fexRho C y) := by
    intro y hy; rw [ht]; exact hβ y hy
  have htϖ : ∃ b ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk p),
      t * fexRho C p ϖ = 1 + fexRho C p b := by
    refine ⟨β * ϖ, Ideal.mul_mem_left _ β hϖmem, ?_⟩
    rw [ht, add_mul, inv_mul_cancel₀ hρϖ, map_mul]
  have hglob : ∀ g : C.residueField (genericPoint C), (∀ y : C, g ∈ Set.range ⇑(fexRho C y)) →
      g ∈ Set.range ⇑(wcpaDjFK k q (genericPoint C)) := by
    intro g hg
    apply hIC g
    intro y
    obtain ⟨a, ha⟩ := hg y
    rw [← ha]
    exact (fexRho C y).isIntegralElem_map
  letI : Algebra k (C.residueField (genericPoint C)) := (wcpaDjFK k q (genericPoint C)).toAlgebra
  have htr : Transcendental k t := by
    intro halg
    have hint : IsIntegral k t := halg.isIntegral
    have hdeg : (minpoly k t).degree = 1 :=
      IsAlgClosed.degree_eq_one_of_irreducible k (minpoly.irreducible hint)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one k t hdeg
    have hc' : wcpaDjFK k q (genericPoint C) c = t := hc
    obtain ⟨γ, hγ⟩ := hconst p c
    have h1 : fexRho C p ((γ - β) * ϖ) = 1 := by
      rw [map_mul, map_sub, hγ, hc', ht, add_sub_cancel_right, inv_mul_cancel₀ hρϖ]
    have h2 : (γ - β) * ϖ = 1 := hinj p (h1.trans (map_one _).symm)
    exact hϖ.not_isUnit ⟨⟨ϖ, γ - β, by rw [mul_comm]; exact h2, h2⟩, rfl⟩
  have hQ : ∀ Q : Polynomial k, Q ≠ 0 → Q.eval₂ (wcpaDjFK k q (genericPoint C)) t ≠ 0 := by
    intro Q hQ0 hQt
    exact htr ⟨Q, hQ0, by rw [Polynomial.aeval_def]; exact hQt⟩
  have hpoly := fex_cp1_poly_in_t k C q p ϖ hϖ0 hmax (hinj p) ((hρ p).2.2.2 hpdvr ϖ hϖmem)
    (hres p (hcl p hp)) hconst hglob t htreg htϖ
  have hrat := fex_cp1_rational_in_t k C q p t hpoly hQ htreg hconst
    (fun y hy => (hρ y).2.2.2 (hdvr y hy)) (fun y hy => hres y (hcl y hy)) hregη hpole
  have htop : IntermediateField.adjoin k {t} = ⊤ := by
    rw [eq_top_iff]
    intro f _
    exact hrat f
  exact wcpa_dj_p1rec_valuative_curve_P1 k C q hval rfl ⟨t, htr, htop⟩

theorem fex_cnc_mv : ∀ (Y : Scheme.{u}), wcpaDjFexH1 Y → ∀ (U₁ U₂ : Y.Opens), U₁ ⊔ U₂ = ⊤ → IsCompact (U₁ : Set Y) → IsCompact (U₂ : Set Y) → ∀ f : Γ(Y, U₁ ⊓ U₂), ∃ (g₁ : Γ(Y, U₁)) (g₂ : Γ(Y, U₂)), f = (Y.presheaf.map (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)).op).hom g₂ - (Y.presheaf.map (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g₁ :=
by
  intro Y hH U₁ U₂ hcov hc₁ hc₂ f
  classical
  have hres : ∀ {A B C : Y.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(Y, A)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hrefine : ∀ U : Y.Opens, IsCompact (U : Set Y) → ∃ (r : ℕ) (W : Fin r → Y.Opens),
      (∀ a, IsAffineOpen (W a)) ∧ (∀ a, W a ≤ U) ∧ ∀ x ∈ U, ∃ a, x ∈ W a := by
    intro U hU
    obtain ⟨s, hs, hUs⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hU
    obtain ⟨t, ht⟩ : ∃ t : Finset Y.affineOpens, ∀ i, i ∈ t ↔ i ∈ s :=
      ⟨hs.toFinset, fun i => hs.mem_toFinset⟩
    refine ⟨t.card, fun a => (t.equivFin.symm a).1.1, fun a => (t.equivFin.symm a).1.2, ?_, ?_⟩
    · intro a
      have hmem : (t.equivFin.symm a).1 ∈ s := (ht _).mp (t.equivFin.symm a).2
      rw [hUs]
      exact le_iSup₂ (f := fun (i : Y.affineOpens) (_ : i ∈ s) => (i : Y.Opens)) _ hmem
    · intro x hx
      rw [hUs] at hx
      simp only [TopologicalSpace.Opens.mem_iSup] at hx
      obtain ⟨i, his, hxi⟩ := hx
      refine ⟨t.equivFin ⟨i, (ht i).mpr his⟩, ?_⟩
      simp only [Equiv.symm_apply_apply]
      exact hxi

  obtain ⟨r₁, W₁, hA₁, hle₁, hcv₁⟩ := hrefine U₁ hc₁
  obtain ⟨r₂, W₂, hA₂, hle₂, hcv₂⟩ := hrefine U₂ hc₂
  obtain ⟨V, hVl, hVr⟩ : ∃ V : Fin (r₁ + r₂) → Y.Opens,
      (∀ i, V (Fin.castAdd r₂ i) = W₁ i) ∧ (∀ i, V (Fin.natAdd r₁ i) = W₂ i) :=
    ⟨Fin.append W₁ W₂, fun i => Fin.append_left _ _ i, fun i => Fin.append_right _ _ i⟩
  obtain ⟨ε, hεl, hεr⟩ : ∃ ε : Fin (r₁ + r₂) → ℤ,
      (∀ i, ε (Fin.castAdd r₂ i) = 0) ∧ (∀ i, ε (Fin.natAdd r₁ i) = 1) :=
    ⟨Fin.append (fun _ => 0) (fun _ => 1), fun i => Fin.append_left _ _ i,
      fun i => Fin.append_right _ _ i⟩
  have hAff : ∀ a, IsAffineOpen (V a) := by
    intro a
    refine Fin.addCases (fun i => ?_) (fun i => ?_) a
    · rw [hVl]; exact hA₁ i
    · rw [hVr]; exact hA₂ i
  have htype : ∀ a, (ε a = 0 ∧ V a ≤ U₁) ∨ (ε a = 1 ∧ V a ≤ U₂) := by
    intro a
    refine Fin.addCases (fun i => ?_) (fun i => ?_) a
    · exact Or.inl ⟨hεl i, by rw [hVl]; exact hle₁ i⟩
    · exact Or.inr ⟨hεr i, by rw [hVr]; exact hle₂ i⟩
  have hcU₁ : ∀ x ∈ U₁, ∃ a, ε a = 0 ∧ x ∈ V a := by
    intro x hx
    obtain ⟨i, hi⟩ := hcv₁ x hx
    exact ⟨Fin.castAdd r₂ i, hεl i, by rw [hVl]; exact hi⟩
  have hcU₂ : ∀ x ∈ U₂, ∃ a, ε a = 1 ∧ x ∈ V a := by
    intro x hx
    obtain ⟨i, hi⟩ := hcv₂ x hx
    exact ⟨Fin.natAdd r₁ i, hεr i, by rw [hVr]; exact hi⟩
  have hV₁ : ∀ a, ε a = 0 → V a ≤ U₁ := fun a ha =>
    (htype a).elim (fun h => h.2) (fun h => absurd (h.1.symm.trans ha) one_ne_zero)
  have hV₂ : ∀ a, ε a = 1 → V a ≤ U₂ := fun a ha =>
    (htype a).elim (fun h => absurd (h.1.symm.trans ha) zero_ne_one) (fun h => h.2)

  have hT : ∀ a b, ε a ≠ ε b → V a ⊓ V b ⊓ ⊤ ≤ U₁ ⊓ U₂ := by
    intro a b hab
    rcases htype a with ⟨ha, ha'⟩ | ⟨ha, ha'⟩ <;> rcases htype b with ⟨hb, hb'⟩ | ⟨hb, hb'⟩
    · exact absurd (ha.trans hb.symm) hab
    · exact inf_le_left.trans (inf_le_inf ha' hb')
    · exact inf_le_left.trans (le_inf (inf_le_right.trans hb') (inf_le_left.trans ha'))
    · exact absurd (ha.trans hb.symm) hab

  obtain ⟨c, hsame, hval⟩ : ∃ c : ∀ a b : Fin (r₁ + r₂), Γ(Y, V a ⊓ V b ⊓ ⊤),
      (∀ a b, ε a = ε b → c a b = 0) ∧
      (∀ a b (h : V a ⊓ V b ⊓ ⊤ ≤ U₁ ⊓ U₂),
        c a b = (ε b - ε a) • (Y.presheaf.map (homOfLE h).op).hom f) := by
    refine ⟨fun a b => if h : V a ⊓ V b ⊓ ⊤ ≤ U₁ ⊓ U₂ then
      (ε b - ε a) • (Y.presheaf.map (homOfLE h).op).hom f else 0, ?_, ?_⟩
    · intro a b hab
      by_cases h : V a ⊓ V b ⊓ ⊤ ≤ U₁ ⊓ U₂
      · simp only [dif_pos h, hab, sub_self, zero_smul]
      · simp only [dif_neg h]
    · intro a b h
      simp only [dif_pos h]
  have hR : ∀ x y (O : Y.Opens) (hO : O ≤ V x ⊓ V y ⊓ ⊤) (hU : O ≤ U₁ ⊓ U₂),
      (Y.presheaf.map (homOfLE hO).op).hom (c x y) =
        (ε y - ε x) • (Y.presheaf.map (homOfLE hU).op).hom f := by
    intro x y O hO hU
    by_cases hxy : ε x = ε y
    · rw [hsame x y hxy, map_zero, hxy, sub_self, zero_smul]
    · rw [hval x y (hT x y hxy), map_zsmul, hres]
  have hcoc : ∀ a b d,
      (Y.presheaf.map (homOfLE (show V a ⊓ V b ⊓ V d ⊓ ⊤ ≤ V a ⊓ V d ⊓ ⊤ from
        inf_le_inf_right ⊤ (inf_le_inf_right (V d) inf_le_left))).op).hom (c a d) =
      (Y.presheaf.map (homOfLE (show V a ⊓ V b ⊓ V d ⊓ ⊤ ≤ V b ⊓ V d ⊓ ⊤ from
        inf_le_inf_right ⊤ (inf_le_inf_right (V d) inf_le_right))).op).hom (c b d) +
      (Y.presheaf.map (homOfLE (show V a ⊓ V b ⊓ V d ⊓ ⊤ ≤ V a ⊓ V b ⊓ ⊤ from
        le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c a b) := by
    intro a b d
    by_cases hall : ε a = ε b ∧ ε b = ε d
    · rw [hsame a d (hall.1.trans hall.2), hsame b d hall.2, hsame a b hall.1]
      simp only [map_zero, add_zero]
    · have hTU : V a ⊓ V b ⊓ V d ⊓ ⊤ ≤ U₁ ⊓ U₂ := by
        by_cases hab : ε a = ε b
        · have hbd : ε b ≠ ε d := fun h => hall ⟨hab, h⟩
          exact (inf_le_inf_right ⊤ (inf_le_inf_right (V d) inf_le_right)).trans (hT b d hbd)
        · exact (le_inf (inf_le_left.trans inf_le_left) inf_le_right).trans (hT a b hab)
      rw [hR a d _ _ hTU, hR b d _ _ hTU, hR a b _ _ hTU, ← add_smul, sub_add_sub_cancel]

  have hOK : wcpaDjCocOK (⟨r₁ + r₂, V, fun _ _ => 1⟩ : wcpaDjCoc Y) := by
    unfold wcpaDjCocOK
    refine ⟨fun a => hAff a, ?_, fun a => rfl, ?_⟩
    · apply eq_top_iff.mpr
      intro x _
      have hx : x ∈ U₁ ⊔ U₂ := by rw [hcov]; trivial
      rw [TopologicalSpace.Opens.mem_sup] at hx
      rcases hx with hx | hx
      · obtain ⟨a, _, hxa⟩ := hcU₁ x hx
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hxa⟩
      · obtain ⟨a, _, hxa⟩ := hcU₂ x hx
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hxa⟩
    · intro a b d
      simp only [Units.val_one, map_one, mul_one]
  unfold wcpaDjFexH1 at hH
  have hH' := hH ⟨r₁ + r₂, V, fun _ _ => 1⟩ hOK
  unfold wcpaDjTwH1 at hH'
  obtain ⟨β, hβ⟩ := hH' c (by
    intro a b d
    simp only [pow_zero, one_smul]
    exact hcoc a b d)
  obtain ⟨β0, hβ0⟩ : ∃ β0 : ∀ a : Fin (r₁ + r₂), Γ(Y, V a ⊓ ⊤), ∀ a b,
      c a b = (Y.presheaf.map (homOfLE (show V a ⊓ V b ⊓ ⊤ ≤ V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β0 b) -
        (Y.presheaf.map (homOfLE (show V a ⊓ V b ⊓ ⊤ ≤ V a ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β0 a) := by
    refine ⟨β, fun a b => ?_⟩
    have h1 := hβ a b
    simp only [pow_zero, one_smul] at h1
    exact h1

  have hglue : ∀ (t : ℤ) (U : Y.Opens), (∀ a, ε a = t → V a ≤ U) →
      (∀ x ∈ U, ∃ a, ε a = t ∧ x ∈ V a) →
      ∃ g : Γ(Y, U), ∀ a (ha : ε a = t) (h : V a ⊓ ⊤ ≤ U),
        (Y.presheaf.map (homOfLE h).op).hom g = β0 a := by
    intro t U hVU hUc
    have hOU : ∀ i : {a : Fin (r₁ + r₂) // ε a = t}, V i.1 ⊓ ⊤ ≤ U :=
      fun i => inf_le_left.trans (hVU i.1 i.2)
    have hle : U ≤ iSup (fun i : {a : Fin (r₁ + r₂) // ε a = t} => V i.1 ⊓ ⊤) := by
      intro x hx
      obtain ⟨a, ha, hxa⟩ := hUc x hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨a, ha⟩, ⟨hxa, trivial⟩⟩
    have hcompat : TopCat.Presheaf.IsCompatible Y.sheaf.obj
        (fun i : {a : Fin (r₁ + r₂) // ε a = t} => V i.1 ⊓ ⊤) (fun i => β0 i.1) := by
      intro i j
      have hA := hβ0 i.1 j.1
      rw [hsame i.1 j.1 (i.2.trans j.2.symm)] at hA
      have hA' := congrArg (Y.presheaf.map (homOfLE (show (V i.1 ⊓ ⊤) ⊓ (V j.1 ⊓ ⊤) ≤
        V i.1 ⊓ V j.1 ⊓ ⊤ from le_inf (inf_le_inf inf_le_left inf_le_left) le_top)).op).hom hA
      rw [map_zero, map_sub, hres, hres] at hA'
      have h2 := sub_eq_zero.mp hA'.symm
      exact h2.symm
    obtain ⟨g, hg, -⟩ := Y.sheaf.existsUnique_gluing' _ U (fun i => homOfLE (hOU i)) hle _ hcompat
    exact ⟨g, fun a ha h => hg ⟨a, ha⟩⟩
  obtain ⟨g₁, hg₁⟩ := hglue 0 U₁ hV₁ hcU₁
  obtain ⟨g₂, hg₂⟩ := hglue 1 U₂ hV₂ hcU₂
  refine ⟨g₁, g₂, ?_⟩
  have hloc : ∀ a b (ha : ε a = 0) (hb : ε b = 1) (h : V a ⊓ V b ⊓ ⊤ ≤ U₁ ⊓ U₂),
      (Y.presheaf.map (homOfLE h).op).hom f =
        (Y.presheaf.map (homOfLE h).op).hom
          ((Y.presheaf.map (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)).op).hom g₂ -
            (Y.presheaf.map (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g₁) := by
    intro a b ha hb h
    have e1 := hval a b h
    rw [ha, hb, sub_zero, one_smul] at e1
    rw [← e1, hβ0 a b, ← hg₂ b hb (inf_le_left.trans (hV₂ b hb)),
      ← hg₁ a ha (inf_le_left.trans (hV₁ a ha))]
    simp only [map_sub, hres]
  have hQ : ∀ p : {p : Fin (r₁ + r₂) × Fin (r₁ + r₂) // ε p.1 = 0 ∧ ε p.2 = 1},
      V p.1.1 ⊓ V p.1.2 ⊓ ⊤ ≤ U₁ ⊓ U₂ :=
    fun p => inf_le_left.trans (inf_le_inf (hV₁ _ p.2.1) (hV₂ _ p.2.2))
  refine Y.sheaf.eq_of_locally_eq'
    (fun p : {p : Fin (r₁ + r₂) × Fin (r₁ + r₂) // ε p.1 = 0 ∧ ε p.2 = 1} =>
      V p.1.1 ⊓ V p.1.2 ⊓ ⊤) (U₁ ⊓ U₂) (fun p => homOfLE (hQ p)) ?_ _ _ ?_
  · intro x hx
    obtain ⟨a, ha, hxa⟩ := hcU₁ x hx.1
    obtain ⟨b, hb, hxb⟩ := hcU₂ x hx.2
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨(a, b), ha, hb⟩, ⟨⟨hxa, hxb⟩, trivial⟩⟩
  · intro p
    exact hloc p.1.1 p.1.2 p.2.1 p.2.2 (hQ p)

theorem fex_cnc_component_const : ∀ (k : Type u) [Field k] [IsAlgClosed k] (C : Scheme.{u}) (q : C ⟶ Spec (.of k)), IsProper q → ∀ (E : Set C), IsClosed E → IsIrreducible E → ∀ (U₁ U₂ : C.Opens), U₁ ⊔ U₂ = ⊤ → ∀ (h₁ : Γ(C, U₁)) (h₂ : Γ(C, U₂)), (∀ x ∈ E, x ∈ U₁ ⊓ U₂ → x ∉ C.basicOpen ((C.presheaf.map (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)).op).hom h₂ - (C.presheaf.map (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom h₁)) → ∃ κ : k, (∀ x ∈ E, x ∈ U₁ → x ∉ C.basicOpen (h₁ - (C.presheaf.map (homOfLE (le_top : U₁ ≤ ⊤)).op).hom (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ)))) ∧ (∀ x ∈ E, x ∈ U₂ → x ∉ C.basicOpen (h₂ - (C.presheaf.map (homOfLE (le_top : U₂ ≤ ⊤)).op).hom (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ)))) :=
by
  intro k _ _ C q hq E hE hEirr U₁ U₂ hcov h₁ h₂ hH
  classical
  haveI := hq

  let I := Scheme.IdealSheafData.vanishingIdeal (⟨E, hE⟩ : TopologicalSpace.Closeds C)
  let Z : Scheme.{u} := I.subscheme
  let ι : Z ⟶ C := I.subschemeι
  have hrange : Set.range ⇑ι = E := by
    show Set.range ⇑I.subschemeι = E
    rw [I.range_subschemeι]
    rfl
  haveI hZred : AlgebraicGeometry.IsReduced Z := by
    have hU : ∀ U : C.affineOpens, AlgebraicGeometry.IsReduced (I.glueDataObj U) := by
      intro U
      haveI : _root_.IsReduced (C.presheaf.obj (Opposite.op U.1) ⧸ I.ideal U) :=
        (Ideal.isRadical_iff_quotient_reduced _).mp (by
          show ((Scheme.IdealSheafData.vanishingIdeal
            (⟨E, hE⟩ : TopologicalSpace.Closeds C)).ideal U).IsRadical
          rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
          exact PrimeSpectrum.isRadical_vanishingIdeal _)
      show AlgebraicGeometry.IsReduced (Spec (.of (C.presheaf.obj (Opposite.op U.1) ⧸ I.ideal U)))
      infer_instance
    haveI : ∀ i, AlgebraicGeometry.IsReduced (I.subschemeCover.openCover.X i) := fun i => hU i
    exact IsReduced.of_openCover _ I.subschemeCover.openCover
  haveI hιci : IsClosedImmersion ι := by
    show IsClosedImmersion I.subschemeι
    infer_instance
  haveI hZirr : IrreducibleSpace Z := by
    have hind := ι.isClosedEmbedding.isInducing
    have hSr : E ⊆ Set.range ⇑ι := by rw [hrange]
    have hirr : IsIrreducible (⇑ι ⁻¹' E) := by
      refine ⟨?_, ?_⟩
      · obtain ⟨y, hy⟩ := hEirr.nonempty
        obtain ⟨x, rfl⟩ := hSr hy
        exact ⟨x, hy⟩
      · intro u v hu hv hxu hyv
        obtain ⟨x, hxS, hxu⟩ := hxu
        obtain ⟨y, hyS, hyv⟩ := hyv
        obtain ⟨u', hu', rfl⟩ := hind.isOpen_iff.mp hu
        obtain ⟨v', hv', rfl⟩ := hind.isOpen_iff.mp hv
        obtain ⟨z, hzS, hzu, hzv⟩ := hEirr.2 u' v' hu' hv' ⟨ι x, hxS, hxu⟩ ⟨ι y, hyS, hyv⟩
        obtain ⟨w, rfl⟩ := hSr hzS
        exact ⟨w, hzS, hzu, hzv⟩
    have huniv : ⇑ι ⁻¹' E = Set.univ := by rw [← hrange]; exact Set.preimage_range _
    rw [irreducibleSpace_def]
    rw [huniv] at hirr
    exact hirr
  haveI hZint : AlgebraicGeometry.IsIntegral Z := isIntegral_of_irreducibleSpace_of_isReduced Z

  have hN : ∀ (V U : C.Opens) (hVU : V ≤ U) (h : Γ(C, U)),
      ι.app V ((C.presheaf.map (homOfLE hVU).op).hom h) =
        (Z.presheaf.map (homOfLE (Scheme.Hom.preimage_mono ι hVU)).op).hom (ι.app U h) := by
    intro V U hVU h
    change (C.presheaf.map (homOfLE hVU).op ≫ ι.app V).hom h = _
    rw [ι.naturality]
    rfl
  have hres : ∀ {A B D : Z.Opens} (hBA : B ≤ A) (hDB : D ≤ B) (x : Γ(Z, A)),
      (Z.presheaf.map (homOfLE hDB).op).hom ((Z.presheaf.map (homOfLE hBA).op).hom x) =
        (Z.presheaf.map (homOfLE (hDB.trans hBA)).op).hom x := by
    intro A B D hBA hDB x
    change (Z.presheaf.map (homOfLE hBA).op ≫ Z.presheaf.map (homOfLE hDB).op).hom x = _
    rw [← Functor.map_comp]
    rfl

  let O₁ : Z.Opens := ι ⁻¹ᵁ U₁
  let O₂ : Z.Opens := ι ⁻¹ᵁ U₂
  let s₁ : Γ(Z, O₁) := ι.app U₁ h₁
  let s₂ : Γ(Z, O₂) := ι.app U₂ h₂
  have hcovZ : O₁ ⊔ O₂ = ⊤ := by
    rw [← Scheme.Hom.preimage_sup, hcov, Scheme.Hom.preimage_top]

  have hW0 : (Z.presheaf.map (homOfLE (Scheme.Hom.preimage_mono ι
        (inf_le_left : U₁ ⊓ U₂ ≤ U₁))).op).hom s₁ =
      (Z.presheaf.map (homOfLE (Scheme.Hom.preimage_mono ι
        (inf_le_right : U₁ ⊓ U₂ ≤ U₂))).op).hom s₂ := by
    have hd : ι.app (U₁ ⊓ U₂) ((C.presheaf.map (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)).op).hom h₂ -
        (C.presheaf.map (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom h₁) = 0 := by
      rw [← basicOpen_eq_bot_iff, ← Scheme.preimage_basicOpen, eq_bot_iff]
      intro z hz
      have hz' : ι z ∈ C.basicOpen ((C.presheaf.map (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)).op).hom h₂ -
          (C.presheaf.map (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom h₁) := hz
      have hzE : ι z ∈ E := by rw [← hrange]; exact ⟨z, rfl⟩
      exact (hH (ι z) hzE (C.basicOpen_le _ hz') hz').elim
    rw [map_sub, hN, hN, sub_eq_zero] at hd
    exact hd.symm
  have hagree : ∀ (W : Z.Opens) (hW1 : W ≤ O₁) (hW2 : W ≤ O₂),
      (Z.presheaf.map (homOfLE hW1).op).hom s₁ = (Z.presheaf.map (homOfLE hW2).op).hom s₂ := by
    intro W hW1 hW2
    have hWW : W ≤ ι ⁻¹ᵁ (U₁ ⊓ U₂) := le_inf hW1 hW2
    have e1 := hres (Scheme.Hom.preimage_mono ι (inf_le_left : U₁ ⊓ U₂ ≤ U₁)) hWW s₁
    have e2 := hres (Scheme.Hom.preimage_mono ι (inf_le_right : U₁ ⊓ U₂ ≤ U₂)) hWW s₂
    rw [hW0] at e1
    exact e1.symm.trans e2

  let U : Bool → Z.Opens := fun b => Bool.rec O₂ O₁ b
  have hle : (⊤ : Z.Opens) ≤ iSup U := by rw [iSup_bool_eq]; exact hcovZ.ge
  let iUV : ∀ b, U b ⟶ ⊤ := fun b => homOfLE le_top
  let sf : ∀ b, Γ(Z, U b) := fun b => Bool.rec (motive := fun b => Γ(Z, U b)) s₂ s₁ b
  have hcompat : TopCat.Presheaf.IsCompatible Z.sheaf.obj U sf := by
    intro i j
    cases i <;> cases j
    · rfl
    · exact (hagree _ inf_le_right inf_le_left).symm
    · exact hagree _ inf_le_left inf_le_right
    · rfl
  obtain ⟨φ, hφ, -⟩ := Z.sheaf.existsUnique_gluing' U ⊤ iUV hle sf hcompat

  have hsurjΓ : Function.Surjective (Scheme.ΓSpecIso (.of k)).inv.hom := by
    intro y
    refine ⟨(Scheme.ΓSpecIso (.of k)).hom.hom y, ?_⟩
    change ((Scheme.ΓSpecIso (.of k)).hom ≫ (Scheme.ΓSpecIso (.of k)).inv).hom y = y
    rw [Iso.hom_inv_id]
    rfl
  have hfin : ((ι ≫ q).appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom).Finite :=
    RingHom.Finite.comp (finite_appTop_of_universallyClosed k (ι ≫ q))
      (RingHom.Finite.of_surjective _ hsurjΓ)
  haveI : Nonempty (⊤ : Z.Opens) := by
    obtain ⟨z⟩ := (inferInstance : Nonempty Z)
    exact ⟨⟨z, trivial⟩⟩
  have hbij := IsAlgClosed.ringHom_bijective_of_isIntegral
    ((ι ≫ q).appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom) (RingHom.IsIntegral.of_finite hfin)
  obtain ⟨κ, hκ⟩ := hbij.2 φ
  have hκ' : ι.app ⊤ (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ)) = φ := by
    rw [← hκ]
    rfl
  have hfinal : ∀ (V : C.Opens) (h : Γ(C, V)) (s : Γ(Z, ι ⁻¹ᵁ V)), ι.app V h = s →
      (Z.presheaf.map (homOfLE (Scheme.Hom.preimage_mono ι (le_top : V ≤ ⊤))).op).hom φ = s →
      ∀ x ∈ E, x ∈ V → x ∉ C.basicOpen (h - (C.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
        (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ))) := by
    intro V h s hs hφs x hxE hxV hx
    have hxr : x ∈ Set.range ⇑ι := by rw [hrange]; exact hxE
    obtain ⟨z, rfl⟩ := hxr
    have hz : z ∈ ι ⁻¹ᵁ C.basicOpen (h - (C.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
        (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ))) := hx
    rw [Scheme.preimage_basicOpen, map_sub, hN, hs, hκ', hφs, sub_self, Scheme.basicOpen_zero] at hz
    exact hz
  exact ⟨κ, hfinal U₁ h₁ s₁ rfl (hφ true), hfinal U₂ h₂ s₂ rfl (hφ false)⟩

theorem fex_curve_no_cycle : ∀ (k : Type u) [Field k] [IsAlgClosed k] (C : Scheme.{u})
    (q : C ⟶ Spec (.of k)), IsProper q → AlgebraicGeometry.IsReduced C →
    topologicalKrullDim C ≤ 1 → wcpaDjFexH1 C →
    ∀ (m : ℕ) (E : Fin (m + 2) → Set C) (p : Fin (m + 2) → C),
      (∀ i, E i ∈ irreducibleComponents C) → Function.Injective E → Function.Injective p →
      (∀ i, p i ∈ E i ∧ p i ∈ E (finRotate (m + 2) i)) → False :=
by

  have fex_cnc_rotate_chain : ∀ (k : Type u) [Field k] (m : ℕ) (κ : Fin (m + 2) → k),
      (∀ i : Fin (m + 2), i ≠ Fin.last (m + 1) → κ i = κ (finRotate (m + 2) i)) →
      κ 0 = κ (Fin.last (m + 1)) + 1 → False := by
    intro k _ m κ hrot h0
    have key : ∀ j : ℕ, (hj : j < m + 2) → κ ⟨j, hj⟩ = κ 0 := by
      intro j
      induction j with
      | zero => intro hj; rfl
      | succ j ih =>
        intro hj
        have hj' : j < m + 2 := by omega
        have hne : (⟨j, hj'⟩ : Fin (m + 2)) ≠ Fin.last (m + 1) := by
          intro h
          have := congrArg Fin.val h
          simp at this
          omega
        have hr : finRotate (m + 2) ⟨j, hj'⟩ = ⟨j + 1, hj⟩ :=
          Fin.ext (coe_finRotate_of_ne_last hne)
        rw [← hr, ← hrot _ hne, ih hj']
    have hL : κ (Fin.last (m + 1)) = κ 0 := key (m + 1) (by omega)
    rw [hL] at h0
    have h10 : (1 : k) = 0 := by linear_combination -h0
    exact one_ne_zero h10

  have fex_cnc_const_eq : ∀ (k : Type u) [Field k] (C : Scheme.{u}) (q : C ⟶ Spec (.of k))
      (U : C.Opens) (x : C), x ∈ U → ∀ (h : Γ(C, U)) (κ₁ κ₂ : k),
      x ∉ C.basicOpen (h - (C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ₁))) →
      x ∉ C.basicOpen (h - (C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ₂))) → κ₁ = κ₂ := by
    intro k _ C q U x hx h κ₁ κ₂ h1 h2
    by_contra hne
    rw [Scheme.mem_basicOpen _ _ _ hx] at h1 h2
    have hu : IsUnit ((C.presheaf.germ U x hx).hom
        ((C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom (κ₁ - κ₂))))) :=
      (Ne.isUnit (sub_ne_zero.mpr hne)).map ((C.presheaf.germ U x hx).hom.comp
        ((C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
          (q.appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom)))
    have heq : (C.presheaf.germ U x hx).hom ((C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom (κ₁ - κ₂)))) =
        (C.presheaf.germ U x hx).hom (h - (C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
          (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ₂))) +
        -(C.presheaf.germ U x hx).hom (h - (C.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
          (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ₁))) := by
      simp only [map_sub]
      ring
    rw [heq] at hu
    rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add hu with h' | h'
    · exact h2 h'
    · exact h1 (IsUnit.neg_iff _ |>.mp h')

  have fex_cnc_idempotent : ∀ (Y : Scheme.{u}) (A B W : Y.Opens) (hA : A ≤ W) (hB : B ≤ W),
      W ≤ A ⊔ B → A ⊓ B = ⊥ → ∃ e : Γ(Y, W), (Y.presheaf.map (homOfLE hA).op).hom e = 1 ∧
        (Y.presheaf.map (homOfLE hB).op).hom e = 0 := by
    intro Y A B W hA hB hW hAB
    have hs1 : Subsingleton Γ(Y, A ⊓ B) := by rw [hAB]; infer_instance
    have hs2 : Subsingleton Γ(Y, B ⊓ A) := by rw [inf_comm, hAB]; infer_instance
    let U : Bool → Y.Opens := fun b => Bool.rec B A b
    have hle : W ≤ iSup U := by rw [iSup_bool_eq]; exact hW
    let iUV : ∀ b, U b ⟶ W := fun b => homOfLE (by cases b; exacts [hB, hA])
    let sf : ∀ b, Γ(Y, U b) := fun b => Bool.rec (motive := fun b => Γ(Y, U b)) 0 1 b
    have hcompat : TopCat.Presheaf.IsCompatible Y.sheaf.obj U sf := by
      intro i j
      cases i <;> cases j
      · rfl
      · exact Subsingleton.elim (α := Γ(Y, B ⊓ A)) _ _
      · exact Subsingleton.elim (α := Γ(Y, A ⊓ B)) _ _
      · rfl
    obtain ⟨e, he, -⟩ := Y.sheaf.existsUnique_gluing' U W iUV hle sf hcompat
    exact ⟨e, he true, he false⟩

  have fex_cnc_two_comp_closed : ∀ (X : Type u) [TopologicalSpace X] [T0Space X],
      topologicalKrullDim X ≤ 1 → ∀ (x : X) (F F' : Set X), F ∈ irreducibleComponents X →
      F' ∈ irreducibleComponents X → F ≠ F' → x ∈ F → x ∈ F' → IsClosed ({x} : Set X) := by
    intro X _ _ hdim x F F' hF hF' hne hxF hxF'
    rw [← closure_subset_iff_isClosed]
    intro y hy
    by_contra hyx
    rw [Set.mem_singleton_iff] at hyx
    let Z0 : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Z1 : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Z2 : TopologicalSpace.IrreducibleCloseds X :=
      ⟨F, hF.1, isClosed_of_mem_irreducibleComponents F hF⟩
    have h01 : Z0 < Z1 := by
      refine lt_of_le_of_ne ?_ ?_
      · show closure {y} ⊆ closure {x}
        exact closure_minimal (Set.singleton_subset_iff.mpr hy) isClosed_closure
      · intro h
        have h' : closure ({y} : Set X) = closure {x} :=
          congrArg (fun Z : TopologicalSpace.IrreducibleCloseds X => (Z : Set X)) h
        exact hyx (inseparable_iff_closure_eq.mpr h').eq
    have h12 : Z1 < Z2 := by
      refine lt_of_le_of_ne ?_ ?_
      · show closure {x} ⊆ F
        exact closure_minimal (Set.singleton_subset_iff.mpr hxF)
          (isClosed_of_mem_irreducibleComponents F hF)
      · intro h
        have h' : closure ({x} : Set X) = F :=
          congrArg (fun Z : TopologicalSpace.IrreducibleCloseds X => (Z : Set X)) h
        apply hne
        have hsub : F ⊆ F' := h' ▸ closure_minimal (Set.singleton_subset_iff.mpr hxF')
          (isClosed_of_mem_irreducibleComponents F' hF')
        exact hsub.antisymm (hF.2 hF'.1 hsub)
    let s1 : LTSeries (TopologicalSpace.IrreducibleCloseds X) :=
      (RelSeries.singleton _ Z0).snoc Z1 h01
    let s : LTSeries (TopologicalSpace.IrreducibleCloseds X) :=
      s1.snoc Z2 (show s1.last < Z2 by
        rw [show s1.last = Z1 from RelSeries.last_snoc _ _ _]; exact h12)
    have hlen := Order.LTSeries.length_le_krullDim s
    have hs : s.length = 2 := rfl
    rw [hs] at hlen
    have h2 : ((2 : ℕ) : WithBot ℕ∞) ≤ 1 := hlen.trans hdim
    norm_num at h2

  have fex_cnc_cut_nbhd : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X]
      [QuasiSober X], (∀ (x : X) (F F' : Set X), F ∈ irreducibleComponents X →
        F' ∈ irreducibleComponents X → F ≠ F' → x ∈ F → x ∈ F' → IsClosed ({x} : Set X)) →
      ∀ p : X, ∃ U : Set X, IsOpen U ∧ p ∈ U ∧ ∀ x ∈ U, x ≠ p → ∀ F ∈ irreducibleComponents X,
        ∀ F' ∈ irreducibleComponents X, x ∈ F → x ∈ F' → F = F' := by
    intro X _ _ _ hcl p
    have hfinC : (irreducibleComponents X).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    have hpair : ∀ F ∈ irreducibleComponents X, ∀ F' ∈ irreducibleComponents X, F ≠ F' →
        (F ∩ F').Finite := by
      intro F hF F' hF' hne
      have hc : IsClosed (F ∩ F') := (isClosed_of_mem_irreducibleComponents F hF).inter
        (isClosed_of_mem_irreducibleComponents F' hF')
      obtain ⟨S, hSfin, hSc, hSi, hSeq⟩ :=
        TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hc
      rw [hSeq]
      refine hSfin.sUnion (fun t ht => ?_)
      obtain ⟨η, hη⟩ := QuasiSober.sober (hSi t ht) (hSc t ht)
      have hηt : η ∈ t := hη.mem
      have hsub : t ⊆ F ∩ F' := by rw [hSeq]; exact Set.subset_sUnion_of_mem ht
      have hηc : IsClosed ({η} : Set X) := hcl η F F' hF hF' hne (hsub hηt).1 (hsub hηt).2
      have ht' : t = {η} := by rw [← hη.def, hηc.closure_eq]
      rw [ht']
      exact Set.finite_singleton η
    let T : Set X := {x | x ≠ p ∧ ∃ F ∈ irreducibleComponents X, ∃ F' ∈ irreducibleComponents X,
      F ≠ F' ∧ x ∈ F ∧ x ∈ F'}
    have hTfin : T.Finite := by
      have hPfin : {P : Set X × Set X | P.1 ∈ irreducibleComponents X ∧
          P.2 ∈ irreducibleComponents X ∧ P.1 ≠ P.2}.Finite :=
        (hfinC.prod hfinC).subset (fun P hP => ⟨hP.1, hP.2.1⟩)
      apply (hPfin.biUnion (fun P hP => hpair P.1 hP.1 P.2 hP.2.1 hP.2.2)).subset
      rintro x ⟨-, F, hF, F', hF', hne, hxF, hxF'⟩
      exact Set.mem_biUnion (x := (F, F')) ⟨hF, hF', hne⟩ ⟨hxF, hxF'⟩
    have hTcl : IsClosed T := by
      rw [← Set.biUnion_of_singleton T]
      exact hTfin.isClosed_biUnion (fun x hx => by
        obtain ⟨-, F, hF, F', hF', hne, hxF, hxF'⟩ := hx
        exact hcl x F F' hF hF' hne hxF hxF')
    refine ⟨Tᶜ, hTcl.isOpen_compl, fun h => h.1 rfl, ?_⟩
    intro x hxU hxp F hF F' hF' hxF hxF'
    by_contra hne
    exact hxU ⟨hxp, F, hF, F', hF', hne, hxF, hxF'⟩

  intro k _ _ C q hq _hred hdim hH1 m E p hE hinj hpinj hp
  classical
  haveI := hq
  haveI : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace q
  haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian q
  haveI : IsNoetherian C := {}

  have hcl := fex_cnc_two_comp_closed C hdim
  have hL0 : Fin.last (m + 1) ≠ (0 : Fin (m + 2)) := by
    intro h
    have := congrArg Fin.val h
    simp at this
  have hrotL : finRotate (m + 2) (Fin.last (m + 1)) = 0 := finRotate_last
  have hpL : p (Fin.last (m + 1)) ∈ E (Fin.last (m + 1)) ∧ p (Fin.last (m + 1)) ∈ E 0 := by
    have := hp (Fin.last (m + 1))
    rw [hrotL] at this
    exact this
  have hpcl : IsClosed ({p (Fin.last (m + 1))} : Set C) :=
    hcl _ _ _ (hE _) (hE 0) (fun h => hL0 (hinj h)) hpL.1 hpL.2
  obtain ⟨U, hUo, hpU, hUcut⟩ := fex_cnc_cut_nbhd C hcl (p (Fin.last (m + 1)))

  let U₁ : C.Opens := ⟨({p (Fin.last (m + 1))} : Set C)ᶜ, hpcl.isOpen_compl⟩
  let U₂ : C.Opens := ⟨U, hUo⟩
  have hU₁ : ∀ x, x ∈ U₁ ↔ x ≠ p (Fin.last (m + 1)) := fun x => Iff.rfl
  have hU₂ : ∀ x, x ∈ U₂ ↔ x ∈ U := fun x => Iff.rfl
  have hcov : U₁ ⊔ U₂ = ⊤ := by
    apply eq_top_iff.mpr
    intro x _
    rw [TopologicalSpace.Opens.mem_sup]
    by_cases hx : x = p (Fin.last (m + 1))
    · right
      rw [hU₂, hx]
      exact hpU
    · left
      exact (hU₁ x).mpr hx
  let Fo : Set C := ⋃₀ {F | F ∈ irreducibleComponents C ∧ F ≠ E (Fin.last (m + 1))}
  have hFo : IsClosed Fo := by
    apply Set.Finite.isClosed_sUnion
    · exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset
        (fun F hF => hF.1)
    · intro F hF
      exact isClosed_of_mem_irreducibleComponents F hF.1
  let W : C.Opens := U₁ ⊓ U₂
  let A : C.Opens := W ⊓ ⟨Foᶜ, hFo.isOpen_compl⟩
  let B : C.Opens := W ⊓ ⟨(E (Fin.last (m + 1)))ᶜ,
    (isClosed_of_mem_irreducibleComponents _ (hE (Fin.last (m + 1)))).isOpen_compl⟩
  have hEL_in : ∀ x, x ∈ W → x ∈ E (Fin.last (m + 1)) → ∀ F ∈ irreducibleComponents C, x ∈ F →
      F = E (Fin.last (m + 1)) := by
    intro x hxW hxL F hF hxF
    exact hUcut x ((hU₂ x).mp hxW.2) ((hU₁ x).mp hxW.1) F hF _ (hE _) hxF hxL
  have hA_of : ∀ x, x ∈ W → x ∈ E (Fin.last (m + 1)) → x ∈ A := by
    intro x hxW hxL
    refine ⟨hxW, ?_⟩
    show x ∉ Fo
    intro hxFo
    obtain ⟨F, ⟨hF, hne⟩, hxF⟩ := hxFo
    exact hne (hEL_in x hxW hxL F hF hxF)
  have hB_of : ∀ j, j ≠ Fin.last (m + 1) → ∀ x, x ∈ W → x ∈ E j → x ∈ B := by
    intro j hj x hxW hxj
    refine ⟨hxW, ?_⟩
    show x ∉ E (Fin.last (m + 1))
    intro hxL
    exact hj (hinj (hEL_in x hxW hxL (E j) (hE j) hxj))
  have hAB : A ⊓ B = ⊥ := by
    apply eq_bot_iff.mpr
    intro x hx
    have hxA : x ∉ Fo := hx.1.2
    have hxB : x ∉ E (Fin.last (m + 1)) := hx.2.2
    by_cases hc : irreducibleComponent x = E (Fin.last (m + 1))
    · exact (hxB (hc ▸ mem_irreducibleComponent)).elim
    · exact (hxA ⟨irreducibleComponent x,
        ⟨irreducibleComponent_mem_irreducibleComponents x, hc⟩, mem_irreducibleComponent⟩).elim
  have hWAB : W ≤ A ⊔ B := by
    intro x hx
    rw [TopologicalSpace.Opens.mem_sup]
    by_cases hxL : x ∈ E (Fin.last (m + 1))
    · exact Or.inl (hA_of x hx hxL)
    · right
      refine ⟨hx, ?_⟩
      show x ∉ E (Fin.last (m + 1))
      exact hxL

  have hAW : A ≤ W := inf_le_left
  have hBW : B ≤ W := inf_le_left
  obtain ⟨e, he1, he0⟩ := fex_cnc_idempotent C A B W hAW hBW hWAB hAB
  obtain ⟨g₁, g₂, hg⟩ := fex_cnc_mv C hH1 U₁ U₂ hcov
    (TopologicalSpace.NoetherianSpace.isCompact _) (TopologicalSpace.NoetherianSpace.isCompact _) e

  have he_van : ∀ x, x ∈ B → x ∉ C.basicOpen e := by
    intro x hxB hx
    have h1 : C.basicOpen ((C.presheaf.map (homOfLE hBW).op).hom e) = B ⊓ C.basicOpen e :=
      C.basicOpen_res e _
    rw [he0, Scheme.basicOpen_zero] at h1
    have h2 : x ∈ B ⊓ C.basicOpen e := ⟨hxB, hx⟩
    rw [← h1] at h2
    exact h2
  have he1_van : ∀ x, x ∈ A → x ∉ C.basicOpen (e - 1) := by
    intro x hxA hx
    have h1 : C.basicOpen ((C.presheaf.map (homOfLE hAW).op).hom (e - 1)) =
        A ⊓ C.basicOpen (e - 1) := C.basicOpen_res (e - 1) _
    rw [map_sub, map_one, he1, sub_self, Scheme.basicOpen_zero] at h1
    have h2 : x ∈ A ⊓ C.basicOpen (e - 1) := ⟨hxA, hx⟩
    rw [← h1] at h2
    exact h2
  have hge : (C.presheaf.map (homOfLE (inf_le_right : U₁ ⊓ U₂ ≤ U₂)).op).hom (g₂ - 1) -
      (C.presheaf.map (homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g₁ = e - 1 := by
    rw [map_sub, map_one, hg]
    ring

  have hconst : ∀ j : Fin (m + 2), ∃ κ : k,
      (∀ x ∈ E j, x ∈ U₁ → x ∉ C.basicOpen (g₁ - (C.presheaf.map (homOfLE (le_top : U₁ ≤ ⊤)).op).hom
        (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ)))) ∧
      (∀ x ∈ E j, x ∈ U₂ → x ∉ C.basicOpen
        ((if j = Fin.last (m + 1) then g₂ - 1 else g₂) -
          (C.presheaf.map (homOfLE (le_top : U₂ ≤ ⊤)).op).hom
            (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom κ)))) := by
    intro j
    by_cases hj : j = Fin.last (m + 1)
    · subst hj
      rw [if_pos rfl]
      exact fex_cnc_component_const k C q hq (E (Fin.last (m + 1)))
        (isClosed_of_mem_irreducibleComponents _ (hE _)) (hE _).1 U₁ U₂ hcov g₁ (g₂ - 1)
        (fun x hxE hxW => by
          rw [hge]
          exact he1_van x (hA_of x hxW hxE))
    · rw [if_neg hj]
      exact fex_cnc_component_const k C q hq (E j)
        (isClosed_of_mem_irreducibleComponents _ (hE j)) (hE j).1 U₁ U₂ hcov g₁ g₂
        (fun x hxE hxW => by
          rw [← hg]
          exact he_van x (hB_of j hj x hxW hxE))
  choose κ hκ using hconst

  have hrot : ∀ i : Fin (m + 2), i ≠ Fin.last (m + 1) → κ i = κ (finRotate (m + 2) i) := by
    intro i hi
    have hpi : p i ∈ U₁ := (hU₁ (p i)).mpr (fun h => hi (hpinj h))
    exact fex_cnc_const_eq k C q U₁ (p i) hpi g₁ (κ i) (κ (finRotate (m + 2) i))
      ((hκ i).1 (p i) (hp i).1 hpi) ((hκ (finRotate (m + 2) i)).1 (p i) (hp i).2 hpi)
  have hpU₂ : p (Fin.last (m + 1)) ∈ U₂ := (hU₂ _).mpr hpU
  have h0 := (hκ 0).2 (p (Fin.last (m + 1))) hpL.2 hpU₂
  rw [if_neg (Ne.symm hL0)] at h0
  have hLv := (hκ (Fin.last (m + 1))).2 (p (Fin.last (m + 1))) hpL.1 hpU₂
  rw [if_pos rfl] at hLv
  have hshift : g₂ - 1 - (C.presheaf.map (homOfLE (le_top : U₂ ≤ ⊤)).op).hom
      (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom (κ (Fin.last (m + 1))))) =
      g₂ - (C.presheaf.map (homOfLE (le_top : U₂ ≤ ⊤)).op).hom
      (q.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom (κ (Fin.last (m + 1)) + 1))) := by
    simp only [map_add, map_one]
    ring
  rw [hshift] at hLv
  have h01 : κ 0 = κ (Fin.last (m + 1)) + 1 :=
    fex_cnc_const_eq k C q U₂ (p (Fin.last (m + 1))) hpU₂ g₂ _ _ h0 hLv
  exact fex_cnc_rotate_chain k m κ hrot h01

theorem wcpa_dj_ldx_nc_exceptional_forest : wcpaDjNcForest.{u} :=
by

  have fex_reduced_subscheme : ∀ (X : Scheme.{u}) (Z : Set X), IsClosed Z →
      ∃ (C : Scheme.{u}) (ι : C ⟶ X), IsClosedImmersion ι ∧ AlgebraicGeometry.IsReduced C ∧
        Set.range ⇑ι = Z := by
    intro X Z hZ
    let I := Scheme.IdealSheafData.vanishingIdeal (⟨Z, hZ⟩ : TopologicalSpace.Closeds X)
    refine ⟨I.subscheme, I.subschemeι, inferInstance, ?_, ?_⟩
    · have hU : ∀ U : X.affineOpens, AlgebraicGeometry.IsReduced (I.glueDataObj U) := by
        intro U
        haveI : _root_.IsReduced (X.presheaf.obj (Opposite.op U.1) ⧸ I.ideal U) :=
          (Ideal.isRadical_iff_quotient_reduced _).mp (by
            show ((Scheme.IdealSheafData.vanishingIdeal
              (⟨Z, hZ⟩ : TopologicalSpace.Closeds X)).ideal U).IsRadical
            rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
            exact PrimeSpectrum.isRadical_vanishingIdeal _)
        show AlgebraicGeometry.IsReduced (Spec (.of (X.presheaf.obj (Opposite.op U.1) ⧸ I.ideal U)))
        infer_instance
      haveI : ∀ i, AlgebraicGeometry.IsReduced (I.subschemeCover.openCover.X i) := fun i => hU i
      exact IsReduced.of_openCover _ I.subschemeCover.openCover
    · rw [I.range_subschemeι]
      rfl
  intro A _ _ _ hAc hk hdim hcase X f hf hX hnorm hU
  classical
  haveI := hk
  haveI := hf

  have hH1 : wcpaDjFexH1 X := by
    rcases hcase with hreg | hAn
    · exact fex_h1_regular A hreg hdim X f hf hX hnorm hU
    · exact fex_h1_An A hAc hdim hAn X f hf hX hnorm hU
  have hFdim := fex_fibre_dimension A hdim X f hf hX hU

  have hfac : ∀ (C : Scheme.{u}) (g : C ⟶ Spec (.of A)), AlgebraicGeometry.IsReduced C →
      (∀ x, g x = IsLocalRing.closedPoint A) →
      ∃ q : C ⟶ Spec (.of (IsLocalRing.ResidueField A)),
        q ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) = g := by
    intro C g hC hg
    have hker : IsLocalRing.maximalIdeal A ≤
        RingHom.ker ((Scheme.ΓSpecIso (.of A)).inv ≫ g.appTop).hom := by
      intro a ha
      rw [RingHom.mem_ker, ← basicOpen_eq_bot_iff, CommRingCat.hom_comp, RingHom.comp_apply,
        ← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine, eq_bot_iff]
      intro x hx
      have hx' : g x ∈ PrimeSpectrum.basicOpen a := hx
      rw [hg x] at hx'
      have hx'' : (IsLocalRing.closedPoint A : PrimeSpectrum A) ∈ PrimeSpectrum.basicOpen a := hx'
      exact absurd ha ((PrimeSpectrum.mem_basicOpen a _).mp hx'')
    exact ⟨g.liftQuotient _ hker, g.liftQuotient_comp _ hker⟩

  have key : ∀ (C : Scheme.{u}) (ι : C ⟶ X), IsClosedImmersion ι → AlgebraicGeometry.IsReduced C →
      Set.range ⇑ι ⊆ ⇑f ⁻¹' {IsLocalRing.closedPoint A} →
      topologicalKrullDim C ≤ 1 ∧ wcpaDjFexH1 C ∧
      ∃ q : C ⟶ Spec (.of (IsLocalRing.ResidueField A)), IsProper q ∧
        q ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) = ι ≫ f := by
    intro C ι hι hC hr
    haveI := hι
    refine ⟨?_, fex_h1_restrict_fibre A hAc X f hf hFdim hH1 C ι hι hC hr, ?_⟩
    · have hind : Topology.IsInducing
          (Set.codRestrict (⇑ι) (⇑f ⁻¹' {IsLocalRing.closedPoint A}) (fun x => hr ⟨x, rfl⟩)) :=
        ι.isClosedEmbedding.isInducing.codRestrict _
      exact hind.topologicalKrullDim_le.trans hFdim
    · obtain ⟨q, hq⟩ := hfac C (ι ≫ f) hC (fun x => by
        rw [Scheme.Hom.comp_apply]; exact hr ⟨x, rfl⟩)
      haveI : IsProper (q ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) := by
        rw [hq]; infer_instance
      exact ⟨q, IsProper.of_comp q (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))), hq⟩

  have hirr : ∀ (C : Scheme.{u}) (ι : C ⟶ X), IsClosedImmersion ι → ∀ S : Set X,
      IsIrreducible S → S ⊆ Set.range ⇑ι → IsIrreducible (⇑ι ⁻¹' S) := by
    intro C ι hι S hS hSr
    haveI := hι
    have hind := ι.isClosedEmbedding.isInducing
    refine ⟨?_, ?_⟩
    · obtain ⟨y, hy⟩ := hS.nonempty
      obtain ⟨x, rfl⟩ := hSr hy
      exact ⟨x, hy⟩
    · intro u v hu hv hxu hyv
      obtain ⟨x, hxS, hxu⟩ := hxu
      obtain ⟨y, hyS, hyv⟩ := hyv
      obtain ⟨u', hu', rfl⟩ := hind.isOpen_iff.mp hu
      obtain ⟨v', hv', rfl⟩ := hind.isOpen_iff.mp hv
      obtain ⟨z, hzS, hzu, hzv⟩ := hS.2 u' v' hu' hv' ⟨ι x, hxS, hxu⟩ ⟨ι y, hyS, hyv⟩
      obtain ⟨w, rfl⟩ := hSr hzS
      exact ⟨w, hzS, hzu, hzv⟩
  refine ⟨?_, ?_⟩
  ·
    intro E hE hEnt
    obtain ⟨Er, ι, hι, hEr, hrange⟩ := fex_reduced_subscheme X E hE.2.1
    haveI := hι
    haveI := hEr
    obtain ⟨hdC, hHC, q, hqp, hq⟩ := key Er ι hι hEr (by rw [hrange]; exact hE.2.2.1)
    have hirrE : IsIrreducible (⇑ι ⁻¹' E) := hirr Er ι hι E hE.1 (by rw [hrange])
    have huniv : ⇑ι ⁻¹' E = Set.univ := by rw [← hrange]; exact Set.preimage_range _
    haveI : IrreducibleSpace Er := by
      rw [irreducibleSpace_def]
      rw [huniv] at hirrE
      exact hirrE
    haveI : AlgebraicGeometry.IsIntegral Er := isIntegral_of_irreducibleSpace_of_isReduced Er
    have hnt : Nontrivial Er := by
      obtain ⟨x, hx, y, hy, hxy⟩ := hEnt
      rw [← hrange] at hx hy
      obtain ⟨x', rfl⟩ := hx
      obtain ⟨y', rfl⟩ := hy
      exact ⟨⟨x', y', fun h => hxy (by rw [h])⟩⟩
    obtain ⟨θ, hθ⟩ := fex_curve_P1 (IsLocalRing.ResidueField A) Er q hqp inferInstance hdC hnt hHC
    refine ⟨Er, ι, θ, hι, hEr, hrange, ?_⟩
    rw [← hq, ← hθ]
    simp only [Category.assoc]
  ·
    intro m E p hE hinj hpinj hp
    have hZc : IsClosed (⋃ i, E i) := isClosed_iUnion_of_finite (fun i => (hE i).2.1)
    have hZF : (⋃ i, E i) ⊆ ⇑f ⁻¹' {IsLocalRing.closedPoint A} :=
      Set.iUnion_subset (fun i => (hE i).2.2.1)
    obtain ⟨C, ι, hι, hC, hrange⟩ := fex_reduced_subscheme X (⋃ i, E i) hZc
    haveI := hι
    haveI := hC
    obtain ⟨hdC, hHC, q, hqp, -⟩ := key C ι hι hC (by rw [hrange]; exact hZF)
    have hEZ : ∀ i, E i ⊆ Set.range ⇑ι := fun i => by
      rw [hrange]; exact Set.subset_iUnion E i
    have himg : ∀ i, ⇑ι '' (⇑ι ⁻¹' E i) = E i := fun i =>
      Set.image_preimage_eq_of_subset (hEZ i)
    have hpZ : ∀ i, p i ∈ Set.range ⇑ι := fun i => hEZ i (hp i).1
    choose p' hp' using hpZ
    apply fex_curve_no_cycle (IsLocalRing.ResidueField A) C q hqp hC hdC hHC m
      (fun i => ⇑ι ⁻¹' E i) p'
    · intro i
      refine ⟨hirr C ι hι (E i) (hE i).1 (hEZ i), fun T hT hle => ?_⟩
      have h1 : ⇑ι '' T = E i := by
        apply (hE i).2.2.2 _ (hT.image _ ι.isClosedEmbedding.continuous.continuousOn)
        · rw [← himg i]; exact Set.image_mono hle
        · rintro _ ⟨x, -, rfl⟩
          exact hZF (by rw [← hrange]; exact ⟨x, rfl⟩)
      intro x hx
      show ι x ∈ E i
      rw [← h1]
      exact ⟨x, hx, rfl⟩
    · intro i j hij
      apply hinj
      have h2 := congrArg (fun S => ⇑ι '' S) hij
      simp only [himg] at h2
      exact h2
    · intro i j hij
      apply hpinj
      rw [← hp' i, ← hp' j, hij]
    · intro i
      refine ⟨?_, ?_⟩
      · show ι (p' i) ∈ E i
        rw [hp' i]; exact (hp i).1
      · show ι (p' i) ∈ E (finRotate (m + 2) i)
        rw [hp' i]; exact (hp i).2

theorem wcpa_dj_ldx_ncs_residue_rational : ∀ (R : Type u) [CommRing R] [IsLocalRing R], IsAlgClosed (IsLocalRing.ResidueField R) → ∀ (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), LocallyOfFiniteType u → ∀ z : Z, u z = IsLocalRing.closedPoint R → IsClosed ({z} : Set Z) → Function.Surjective ((Z.evaluation ⊤ z trivial).hom.comp (wcCnSigma u ⊤)) :=
by
  intro R _ _ halg Z u hu z hz hzc
  haveI : LocallyOfFiniteType u := hu
  haveI : IsClosedImmersion (Z.fromSpecResidueField z) :=
    isClosed_singleton_iff_isClosedImmersion.mp hzc
  set g := Z.fromSpecResidueField z ≫ u with hg
  have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
  have hft : (Spec.preimage g).hom.FiniteType := by
    have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
  have hs2 : (Z.fromSpecResidueField z).appTop ≫ (Scheme.ΓSpecIso (Z.residueField z)).hom =
      Z.evaluation ⊤ z trivial := by
    rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
    simp only [Category.assoc]
    erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
      Iso.inv_hom_id_assoc, Scheme.germ_residue]
  have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ u.appTop ≫
      Z.evaluation ⊤ z trivial := by
    rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ, hg, Scheme.Hom.comp_appTop,
      Category.assoc, hs2]
  have hres : Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op = 𝟙 _ := by
    rw [show (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op = 𝟙 _ from rfl,
      CategoryTheory.Functor.map_id]
  have hφ : (Z.evaluation ⊤ z trivial).hom.comp (wcCnSigma u ⊤) = (Spec.preimage g).hom := by
    rw [heq]
    simp only [wcCnSigma, hres, CommRingCat.hom_id, RingHom.id_comp]
    rfl
  rw [hφ]
  set f := (Spec.preimage g).hom with hf

  let pt : Spec (Z.residueField z) := IsLocalRing.closedPoint (Z.residueField z)
  have hpt : (Spec.map (Spec.preimage g)) pt = IsLocalRing.closedPoint R := by
    rw [hψ, hg, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    exact hz
  have hid := congrArg PrimeSpectrum.asIdeal hpt
  change Ideal.comap f (pt : PrimeSpectrum (Z.residueField z)).asIdeal =
    IsLocalRing.maximalIdeal R at hid
  have hbot : (pt : PrimeSpectrum (Z.residueField z)).asIdeal = ⊥ := by
    haveI := (pt : PrimeSpectrum (Z.residueField z)).isPrime
    exact Ideal.eq_bot_of_prime _
  rw [hbot] at hid
  have hker : ∀ a ∈ IsLocalRing.maximalIdeal R, f a = 0 := by
    intro a ha
    rw [← hid, Ideal.mem_comap, Ideal.mem_bot] at ha
    exact ha
  let fb : IsLocalRing.ResidueField R →+* Z.residueField z :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) f hker
  have hcomp : fb.comp (IsLocalRing.residue R) = f :=
    RingHom.ext fun a => Ideal.Quotient.lift_mk (IsLocalRing.maximalIdeal R) f hker
  have hftb : fb.FiniteType :=
    RingHom.FiniteType.of_comp_finiteType (f := IsLocalRing.residue R) (by rw [hcomp]; exact hft)
  haveI : IsAlgClosed (IsLocalRing.ResidueField R) := halg
  letI : Algebra (IsLocalRing.ResidueField R) (Z.residueField z) := fb.toAlgebra
  haveI : Algebra.FiniteType (IsLocalRing.ResidueField R) (Z.residueField z) := hftb
  haveI : Module.Finite (IsLocalRing.ResidueField R) (Z.residueField z) :=
    finite_of_finite_type_of_isJacobsonRing _ _
  intro s
  have hs : IsIntegral (IsLocalRing.ResidueField R) s := Algebra.IsIntegral.isIntegral s
  have hdeg := IsAlgClosed.degree_eq_one_of_irreducible (IsLocalRing.ResidueField R)
    (minpoly.irreducible hs)
  obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one (IsLocalRing.ResidueField R) s hdeg
  obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective c
  exact ⟨a, (RingHom.congr_fun hcomp a).symm.trans hc⟩

theorem wcpa_dj_ldx_ncs_hensel_section : ∀ (R : Type u) [CommRing R] [IsLocalRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (z : Z), u z = IsLocalRing.closedPoint R → (∃ W : Z.Opens, z ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ u)) → Function.Surjective ((Z.evaluation ⊤ z trivial).hom.comp (wcCnSigma u ⊤)) → ∃ σ : Spec (.of R) ⟶ Z, σ ≫ u = 𝟙 _ ∧ σ (IsLocalRing.closedPoint R) = z :=
by
  have hHensel := wc_hnas_smooth_section_henselian
  intro R _ _ hcomp Z u z hz hW hsurj
  classical
  obtain ⟨W, hzW, hsm⟩ := hW

  haveI : IsAdicComplete (IsLocalRing.maximalIdeal R) R := hcomp
  haveI hHR : HenselianRing R (IsLocalRing.maximalIdeal R) := IsAdicComplete.henselianRing R _
  haveI hHL : HenselianLocalRing R := HenselianLocalRing.mk (fun f hf a₀ h₁ h₂ =>
    HenselianRing.is_henselian f hf a₀ h₁ (h₂.map (Ideal.Quotient.mk _)))

  let z' : W.toScheme := ⟨z, hzW⟩
  have hgz : (W.ι ≫ u) z' = IsLocalRing.closedPoint R := by
    rw [Scheme.Hom.comp_apply]
    exact hz
  haveI := hsm
  obtain ⟨U, hU, V, hV, hzV, e, hstd⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := 1)
      (f := W.ι ≫ u) z'
  have hUtop : U = ⊤ := by
    have hmem : (W.ι ≫ u) z' ∈ U := e hzV
    rw [hgz] at hmem
    exact (IsLocalRing.closedPoint_mem_iff (R := R) U).mp hmem
  subst hUtop
  have hγbij : Function.Bijective (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom :=
    ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of R)).inv
  have hfsm : (((W.ι ≫ u).appLE ⊤ V e).hom.comp (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom).Smooth :=
    RingHom.Smooth.comp (RingHom.Smooth.of_bijective hγbij)
      (RingHom.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1 _ hstd).smooth

  have hevres : ∀ (U₁ U₂ : W.toScheme.Opens) (i : U₁ ⟶ U₂) (x : W.toScheme) (hx : x ∈ U₁)
      (s : Γ(W.toScheme, U₂)), (W.toScheme.evaluation U₁ x hx).hom
        ((W.toScheme.presheaf.map i.op).hom s) = (W.toScheme.evaluation U₂ x (i.le hx)).hom s := by
    intro U₁ U₂ i x hx s
    have hcat : W.toScheme.presheaf.map i.op ≫ W.toScheme.evaluation U₁ x hx =
        W.toScheme.evaluation U₂ x (i.le hx) := by
      rw [← Scheme.germ_residue, ← Scheme.germ_residue, ← Category.assoc,
        TopCat.Presheaf.germ_res]
    have := congrArg (fun φ => φ.hom s) hcat
    exact this
  have hkey : ∀ r : R, (W.toScheme.evaluation V z' hzV).hom
      ((((W.ι ≫ u).appLE ⊤ V e).hom.comp (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom) r) =
      (W.ι.residueFieldMap z').hom ((Z.evaluation ⊤ z trivial).hom (wcCnSigma u ⊤ r)) := by
    intro r
    have hσr : wcCnSigma u ⊤ r =
        (u.app ⊤).hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r) := by
      show (Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op).hom
        ((u.appTop).hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)) = _
      rw [show (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)) = 𝟙 _ from rfl, op_id,
        CategoryTheory.Functor.map_id]
      rfl
    have hnat := Scheme.evaluation_naturality_apply W.ι (V := ⊤) z' trivial
      ((u.app ⊤).hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r))
    rw [hσr]
    refine Eq.trans ?_ hnat.symm
    have happ : ∀ x, ((W.ι ≫ u).appLE ⊤ V e).hom x =
        (W.toScheme.presheaf.map (homOfLE e).op).hom ((W.ι.app (u ⁻¹ᵁ ⊤)).hom ((u.app ⊤).hom x)) := by
      intro x
      rw [Scheme.Hom.appLE, Scheme.Hom.comp_app]
      rfl
    have hr := hevres V ((W.ι ≫ u) ⁻¹ᵁ ⊤) (homOfLE e) z' hzV
      ((W.ι.app (u ⁻¹ᵁ ⊤)).hom ((u.app ⊤).hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)))
    show (W.toScheme.evaluation V z' hzV).hom
      (((W.ι ≫ u).appLE ⊤ V e).hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)) = _
    rw [happ]
    exact hr
  have hρbij : Function.Bijective (W.ι.residueFieldMap z').hom :=
    ConcreteCategory.bijective_of_isIso (W.ι.residueFieldMap z')
  have hsurj' : Function.Surjective ((W.toScheme.evaluation V z' hzV).hom.comp
      (((W.ι ≫ u).appLE ⊤ V e).hom.comp (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom)) := by
    intro t
    obtain ⟨t0, ht0⟩ := hρbij.2 t
    obtain ⟨r, hr⟩ := hsurj t0
    refine ⟨r, ?_⟩
    rw [RingHom.comp_apply, hkey, ← ht0]
    exact congrArg _ hr

  let f : R →+* Γ(W.toScheme, V) :=
    ((W.ι ≫ u).appLE ⊤ V e).hom.comp (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom
  let ev : Γ(W.toScheme, V) →+* W.toScheme.residueField z' := (W.toScheme.evaluation V z' hzV).hom
  let χ : R →+* W.toScheme.residueField z' := ev.comp f
  have hχsurj : Function.Surjective χ := hsurj'
  have hker : RingHom.ker χ = IsLocalRing.maximalIdeal R := by
    haveI := RingHom.ker_isMaximal_of_surjective χ hχsurj
    exact IsLocalRing.eq_maximalIdeal this
  let χbar : IsLocalRing.ResidueField R →+* W.toScheme.residueField z' :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) χ (fun a ha => by
      rw [← hker] at ha
      exact RingHom.mem_ker.mp ha)
  have hχbar : ∀ r : R, χbar (IsLocalRing.residue R r) = χ r := fun r => rfl
  have hχbij : Function.Bijective χbar := by
    refine ⟨χbar.injective, fun t => ?_⟩
    obtain ⟨r, hr⟩ := hχsurj t
    exact ⟨IsLocalRing.residue R r, by rw [hχbar]; exact hr⟩
  let E := RingEquiv.ofBijective χbar hχbij
  let s : Γ(W.toScheme, V) →+* IsLocalRing.ResidueField R := E.symm.toRingHom.comp ev
  have hs1 : ∀ r : R, s (f r) = IsLocalRing.residue R r := fun r =>
    E.symm_apply_apply (IsLocalRing.residue R r)
  have hs2 : ∀ d, s d = 0 ↔ ev d = 0 := fun d => map_eq_zero_iff _ E.symm.injective

  letI : Algebra R Γ(W.toScheme, V) := f.toAlgebra
  haveI : Algebra.Smooth R Γ(W.toScheme, V) := hfsm
  let σbar : Γ(W.toScheme, V) →ₐ[R] IsLocalRing.ResidueField R :=
    AlgHom.mk s (fun r => by
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact hs1 r)
  obtain ⟨τ, hτ⟩ := hHensel R Γ(W.toScheme, V) σbar
  have hτ1 : ∀ r : R, τ (f r) = r := fun r => by
    have := τ.commutes r
    exact this
  have hτ2 : ∀ d, τ d ∈ IsLocalRing.maximalIdeal R ↔ ev d = 0 := by
    intro d
    rw [← IsLocalRing.residue_eq_zero_iff, hτ d]
    exact hs2 d

  have hs7 : ∀ d : Γ(W.toScheme, V), d ∈ (hV.primeIdealOf ⟨z', hzV⟩).asIdeal ↔ ev d = 0 := by
    intro d
    have e1 := Scheme.evaluation_eq_zero_iff_notMem_basicOpen W.toScheme z' hzV d
    have e2 := Scheme.mem_basicOpen W.toScheme d z' hzV
    have e3 : d ∈ (hV.primeIdealOf ⟨z', hzV⟩).asIdeal ↔
        (W.toScheme.presheaf.germ V z' hzV).hom d ∈ IsLocalRing.maximalIdeal _ := by
      rw [IsAffineOpen.primeIdealOf_eq_map_closedPoint]
      exact Iff.rfl
    rw [e3, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact (e1.trans (not_congr e2)).symm

  refine ⟨Spec.map (CommRingCat.ofHom τ.toRingHom) ≫ hV.fromSpec ≫ W.ι, ?_, ?_⟩
  · have h1 := IsAffineOpen.SpecMap_appLE_fromSpec (W.ι ≫ u) hU hV e
    rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at h1
    calc (Spec.map (CommRingCat.ofHom τ.toRingHom) ≫ hV.fromSpec ≫ W.ι) ≫ u
        = Spec.map (CommRingCat.ofHom τ.toRingHom) ≫ (hV.fromSpec ≫ W.ι ≫ u) := by
          simp only [Category.assoc]
      _ = Spec.map (CommRingCat.ofHom τ.toRingHom) ≫ Spec.map ((W.ι ≫ u).appLE ⊤ V e) ≫
          Spec.map (Scheme.ΓSpecIso (CommRingCat.of R)).inv := by rw [h1]
      _ = 𝟙 _ := by
          rw [← Spec.map_comp, ← Spec.map_comp, ← Spec.map_id]
          congr 1
          ext r
          exact hτ1 r
  · have hpt : Spec.map (CommRingCat.ofHom τ.toRingHom) (IsLocalRing.closedPoint R) =
        hV.primeIdealOf ⟨z', hzV⟩ := by
      apply PrimeSpectrum.ext
      apply Ideal.ext
      intro d
      exact (hτ2 d).trans (hs7 d).symm
    show W.ι (hV.fromSpec (Spec.map (CommRingCat.ofHom τ.toRingHom)
      (IsLocalRing.closedPoint R))) = z
    rw [hpt, IsAffineOpen.fromSpec_primeIdealOf]
    rfl

theorem wcpa_dj_sp_smooth_stalk_model : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (y : Y), IsNoetherianRing (S.presheaf.stalk (g y)) → (∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) → IsNoetherianRing (Y.presheaf.stalk y) ∧ ∃ (Q : Ideal (Polynomial (S.presheaf.stalk (g y)))) (_ : Q.IsPrime) (β : Localization.AtPrime Q →+* Y.presheaf.stalk y), Q.comap Polynomial.C = IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)) ∧ β.comp ((algebraMap (Polynomial (S.presheaf.stalk (g y))) (Localization.AtPrime Q)).comp Polynomial.C) = (g.stalkMap y).hom ∧ IsLocalHom β ∧ β.Flat ∧ Ideal.map β (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) = IsLocalRing.maximalIdeal (Y.presheaf.stalk y) :=
by
  intro S Y g y hR hW
  obtain ⟨W, hyW, hsm⟩ := hW

  have L1 : ∀ (X S : Scheme.{u}) (h : X ⟶ S) (x : X), SmoothOfRelativeDimension 1 h → ∃ (A B : Type u) (_ : CommRing A) (_ : CommRing B) (f : A →+* B) (iA : A →+* S.presheaf.stalk (h x)) (iB : B →+* X.presheaf.stalk x) (𝔮 : Ideal B) (_ : 𝔮.IsPrime), RingHom.IsStandardSmoothOfRelativeDimension 1 f ∧ @IsLocalization.AtPrime A _ (S.presheaf.stalk (h x)) _ iA.toAlgebra (𝔮.comap f) _ ∧ @IsLocalization.AtPrime B _ (X.presheaf.stalk x) _ iB.toAlgebra 𝔮 _ ∧ (h.stalkMap x).hom.comp iA = iB.comp f := by
    intro X S h x hsm
    obtain ⟨U, hU, V, hV, hxV, e, hstd⟩ := hsm.exists_isStandardSmoothOfRelativeDimension x
    have hxU : h x ∈ U := e hxV
    have h1 : S.presheaf.germ U (h x) hxU ≫ h.stalkMap x = h.appLE U V e ≫ X.presheaf.germ V x hxV := by
      rw [Scheme.Hom.germ_stalkMap]
      rw [← TopCat.Presheaf.germ_res X.presheaf (homOfLE e) x hxV]
      rfl
    have hcomm : (h.stalkMap x).hom.comp (S.presheaf.germ U (h x) hxU).hom =
        (X.presheaf.germ V x hxV).hom.comp (h.appLE U V e).hom := by
      have := congrArg CommRingCat.Hom.hom h1
      rwa [CommRingCat.hom_comp, CommRingCat.hom_comp] at this
    have hB : @IsLocalization.AtPrime _ _ (X.presheaf.stalk x) _ (X.presheaf.germ V x hxV).hom.toAlgebra
        (hV.primeIdealOf ⟨x, hxV⟩).asIdeal _ := hV.isLocalization_stalk ⟨x, hxV⟩
    have hA0 : @IsLocalization.AtPrime _ _ (S.presheaf.stalk (h x)) _ (S.presheaf.germ U (h x) hxU).hom.toAlgebra
        (hU.primeIdealOf ⟨h x, hxU⟩).asIdeal _ := hU.isLocalization_stalk ⟨h x, hxU⟩
    have hidB : (hV.primeIdealOf ⟨x, hxV⟩).asIdeal =
        (IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap (X.presheaf.germ V x hxV).hom := by
      letI := (X.presheaf.germ V x hxV).hom.toAlgebra
      exact (IsLocalization.AtPrime.under_maximalIdeal (X.presheaf.stalk x) _).symm
    have hidA : (hU.primeIdealOf ⟨h x, hxU⟩).asIdeal =
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (h x))).comap (S.presheaf.germ U (h x) hxU).hom := by
      letI := (S.presheaf.germ U (h x) hxU).hom.toAlgebra
      exact (IsLocalization.AtPrime.under_maximalIdeal (S.presheaf.stalk (h x)) _).symm
    have hlh : IsLocalHom (h.stalkMap x).hom := inferInstance
    have hloc : (IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap (h.stalkMap x).hom =
        IsLocalRing.maximalIdeal (S.presheaf.stalk (h x)) :=
      ((IsLocalRing.local_hom_TFAE (h.stalkMap x).hom).out 1 5).mp hlh
    have heq : ((hV.primeIdealOf ⟨x, hxV⟩).asIdeal).comap (h.appLE U V e).hom =
        (hU.primeIdealOf ⟨h x, hxU⟩).asIdeal := by
      rw [hidB, hidA, Ideal.comap_comap, ← hcomm, ← Ideal.comap_comap, hloc]
    refine ⟨_, _, _, _, (h.appLE U V e).hom, (S.presheaf.germ U (h x) hxU).hom,
      (X.presheaf.germ V x hxV).hom, (hV.primeIdealOf ⟨x, hxV⟩).asIdeal, inferInstance, hstd, ?_, hB, hcomm⟩
    have gen : ∀ (I : Ideal Γ(S, U)) [I.IsPrime], I = (hU.primeIdealOf ⟨h x, hxU⟩).asIdeal →
        @IsLocalization.AtPrime _ _ (S.presheaf.stalk (h x)) _ (S.presheaf.germ U (h x) hxU).hom.toAlgebra
          (hU.primeIdealOf ⟨h x, hxU⟩).asIdeal _ →
        @IsLocalization.AtPrime _ _ (S.presheaf.stalk (h x)) _ (S.presheaf.germ U (h x) hxU).hom.toAlgebra I _ := by
      rintro I _ rfl hh; exact hh
    exact gen _ heq hA0

  have L2 : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (W : Y.Opens) (y : Y) (hy : y ∈ W) (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B) (iA : A →+* S.presheaf.stalk ((W.ι ≫ g) ⟨y, hy⟩)) (iB : B →+* W.toScheme.presheaf.stalk ⟨y, hy⟩) (𝔮 : Ideal B) [𝔮.IsPrime], @IsLocalization.AtPrime A _ _ _ iA.toAlgebra (𝔮.comap f) _ → @IsLocalization.AtPrime B _ _ _ iB.toAlgebra 𝔮 _ → ((W.ι ≫ g).stalkMap ⟨y, hy⟩).hom.comp iA = iB.comp f → ∃ (iA' : A →+* S.presheaf.stalk (g y)) (iB' : B →+* Y.presheaf.stalk y), @IsLocalization.AtPrime A _ _ _ iA'.toAlgebra (𝔮.comap f) _ ∧ @IsLocalization.AtPrime B _ _ _ iB'.toAlgebra 𝔮 _ ∧ (g.stalkMap y).hom.comp iA' = iB'.comp f := by
    intro S Y g W y hy A B _ _ f iA iB 𝔮 _ hA hB hc
    refine ⟨iA, (W.stalkIso ⟨y, hy⟩).hom.hom.comp iB, hA, ?_, ?_⟩
    · letI := iB.toAlgebra
      letI : Algebra B (Y.presheaf.stalk y) := ((W.stalkIso ⟨y, hy⟩).hom.hom.comp iB).toAlgebra
      let e : W.toScheme.presheaf.stalk ⟨y, hy⟩ ≃ₐ[B] Y.presheaf.stalk y :=
        AlgEquiv.ofRingEquiv (f := (W.stalkIso ⟨y, hy⟩).commRingCatIsoToRingEquiv) (fun _ => rfl)
      exact IsLocalization.isLocalization_of_algEquiv 𝔮.primeCompl e
    · ext a
      have h1 := RingHom.congr_fun hc a
      simp only [RingHom.comp_apply] at h1
      have key := Scheme.Hom.stalkMap_comp W.ι g ⟨y, hy⟩
      rw [← Scheme.Opens.stalkIso_inv] at key
      have h2 := congrArg (fun φ => CommRingCat.Hom.hom φ (iA a)) key
      simp only at h2
      have h3 : (g.stalkMap (W.ι ⟨y, hy⟩) ≫ (W.stalkIso ⟨y, hy⟩).inv) ≫ (W.stalkIso ⟨y, hy⟩).hom =
          g.stalkMap y := by simp
      have h4 := congrArg (fun φ => CommRingCat.Hom.hom φ (iA a)) h3
      simp only [CommRingCat.hom_comp] at h4
      simp only [RingHom.comp_apply]
      rw [← h1]
      refine Eq.trans ?_ (congrArg (CommRingCat.Hom.hom (W.stalkIso ⟨y, hy⟩).hom) h2.symm)
      exact h4.symm

  have L3a : ∀ (A B : Type u) [CommRing A] [CommRing B] (f : A →+* B), RingHom.IsStandardSmoothOfRelativeDimension 1 f → ∃ γ : Polynomial A →+* B, γ.Etale ∧ γ.comp Polynomial.C = f := by
    intro A B _ _ f hf
    obtain ⟨g₀, hg₀C, hg₀⟩ := hf.exists_etale_mvPolynomial
    let ι := MvPolynomial.uniqueAlgEquiv A (Fin 1)
    refine ⟨g₀.comp ι.symm.toRingEquiv.toRingHom, ?_, ?_⟩
    · exact RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective ι.symm.bijective) hg₀
    · ext a
      simp [ι]
      rw [← hg₀C]
      simp

  have L3c : ∀ (A R : Type u) [CommRing A] [CommRing R] [IsLocalRing R] (iA : A →+* R) (𝔭 : Ideal A) [𝔭.IsPrime], @IsLocalization.AtPrime A _ R _ iA.toAlgebra 𝔭 _ → ∀ (p' : Ideal (Polynomial A)) [p'.IsPrime], p'.comap Polynomial.C = 𝔭 → ∃ (Q : Ideal (Polynomial R)) (_ : Q.IsPrime), Q.comap (Polynomial.mapRingHom iA) = p' ∧ Q.comap Polynomial.C = IsLocalRing.maximalIdeal R ∧ @IsLocalization.AtPrime (Polynomial A) _ (Localization.AtPrime Q) _ ((algebraMap (Polynomial R) (Localization.AtPrime Q)).comp (Polynomial.mapRingHom iA)).toAlgebra p' _ := by
    intro A R _ _ _ iA 𝔭 _ hR p' _ hp'
    letI : Algebra A R := iA.toAlgebra
    letI : Algebra (Polynomial A) (Polynomial R) := Polynomial.algebra A R
    have hPL : IsLocalization (Submonoid.map (Polynomial.C : A →+* Polynomial A) 𝔭.primeCompl) (Polynomial R) :=
      Polynomial.isLocalization 𝔭.primeCompl R
    have halg : algebraMap (Polynomial A) (Polynomial R) = Polynomial.mapRingHom iA := by
      rw [Polynomial.algebraMap_def]; rfl
    have hdisj : Disjoint ((Submonoid.map (Polynomial.C : A →+* Polynomial A) 𝔭.primeCompl : Set (Polynomial A))) (p' : Set (Polynomial A)) := by
      rw [Set.disjoint_left]
      rintro _ ⟨s, hs, rfl⟩ hsp
      apply hs
      rw [← hp']
      exact hsp
    set Q := Ideal.map (algebraMap (Polynomial A) (Polynomial R)) p' with hQdef
    haveI hQ : Q.IsPrime := IsLocalization.isPrime_of_isPrime_disjoint _ (Polynomial R) p' inferInstance hdisj
    have hQc : Q.comap (algebraMap (Polynomial A) (Polynomial R)) = p' :=
      IsLocalization.comap_map_of_isPrime_disjoint _ (Polynomial R) inferInstance hdisj
    refine ⟨Q, hQ, ?_, ?_, ?_⟩
    · rw [← halg]; exact hQc
    · have e1 : (Q.comap Polynomial.C).comap iA = 𝔭 := by
        rw [Ideal.comap_comap, ← Polynomial.mapRingHom_comp_C, ← Ideal.comap_comap, ← halg, hQc, hp']
      have e2 : Q.comap Polynomial.C = Ideal.map iA ((Q.comap Polynomial.C).comap iA) := by
        haveI : (Q.comap Polynomial.C).IsPrime := Ideal.comap_isPrime _ _
        exact (IsLocalization.map_comap 𝔭.primeCompl R (Q.comap Polynomial.C)).symm
      rw [e2, e1]
      exact IsLocalization.AtPrime.map_eq_maximalIdeal 𝔭 R
    · let algT : Algebra (Polynomial A) (Localization.AtPrime Q) :=
        ((algebraMap (Polynomial R) (Localization.AtPrime Q)).comp (Polynomial.mapRingHom iA)).toAlgebra
      have htow := @IsScalarTower.of_algebraMap_eq' (Polynomial A) (Polynomial R)
        (Localization.AtPrime Q) _ _ _ (Polynomial.algebra A R) inferInstance algT
        (by rw [halg]; rfl)
      have key := @IsLocalization.isLocalization_isLocalization_atPrime_isLocalization (Polynomial A) _
        (Submonoid.map (Polynomial.C : A →+* Polynomial A) 𝔭.primeCompl) (Polynomial R) _
        (Polynomial.algebra A R) (Localization.AtPrime Q) _ algT inferInstance htow hPL Q hQ
        inferInstance
      have gen : ∀ (I : Ideal (Polynomial A)) [I.IsPrime], I = p' →
          @IsLocalization.AtPrime (Polynomial A) _ (Localization.AtPrime Q) _ algT I _ →
          @IsLocalization.AtPrime (Polynomial A) _ (Localization.AtPrime Q) _ algT p' _ := by
        rintro I _ rfl h; exact h
      exact gen _ hQc key

  have L3b1 : ∀ (P B T O : Type u) [CommRing P] [CommRing B] [CommRing T] [CommRing O] [IsLocalRing T] [IsLocalRing O] (γ : P →+* B) (𝔮 : Ideal B) [𝔮.IsPrime] (iT : P →+* T) (iB : B →+* O) (β : T →+* O), γ.Etale → @IsLocalization.AtPrime P _ T _ iT.toAlgebra (𝔮.comap γ) _ → @IsLocalization.AtPrime B _ O _ iB.toAlgebra 𝔮 _ → β.comp iT = iB.comp γ → IsLocalHom β ∧ β.Flat := by
    intro P B T O _ _ _ _ _ _ γ 𝔮 _ iT iB β hγ hT hO hβ
    letI : Algebra P B := γ.toAlgebra
    letI : Algebra P T := iT.toAlgebra
    letI : Algebra B O := iB.toAlgebra
    letI : Algebra T O := β.toAlgebra
    letI : Algebra P O := (iB.comp γ).toAlgebra
    haveI : IsScalarTower P B O := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower P T O := IsScalarTower.of_algebraMap_eq' hβ.symm
    constructor
    · have h1 : IsLocalRing.maximalIdeal T = Ideal.map iT (𝔮.comap γ) :=
        (IsLocalization.AtPrime.map_eq_maximalIdeal (𝔮.comap γ) T).symm
      have h2 : IsLocalRing.maximalIdeal O = Ideal.map iB 𝔮 :=
        (IsLocalization.AtPrime.map_eq_maximalIdeal 𝔮 O).symm
      have h3 : Ideal.map β (IsLocalRing.maximalIdeal T) ≤ IsLocalRing.maximalIdeal O := by
        rw [h1, h2, Ideal.map_map, hβ, ← Ideal.map_map]
        exact Ideal.map_mono Ideal.map_comap_le
      exact ((IsLocalRing.local_hom_TFAE β).out 3 1).mp h3
    · haveI : Algebra.Etale P B := RingHom.Etale.toAlgebra hγ
      haveI : Module.Flat P B := inferInstance
      haveI : Module.Flat B O := IsLocalization.flat O 𝔮.primeCompl
      haveI : Module.Flat P O := Module.Flat.trans P B O
      have : Module.Flat T O := (Module.flat_iff_of_isLocalization T (𝔮.comap γ).primeCompl O).mpr inferInstance
      exact RingHom.flat_algebraMap_iff.mp this

  have L3b2 : ∀ (P B T O : Type u) [CommRing P] [CommRing B] [CommRing T] [CommRing O] [IsLocalRing T] [IsLocalRing O] [IsNoetherianRing T] (γ : P →+* B) (𝔮 : Ideal B) [𝔮.IsPrime] (iT : P →+* T) (iB : B →+* O) (β : T →+* O), γ.Etale → @IsLocalization.AtPrime P _ T _ iT.toAlgebra (𝔮.comap γ) _ → @IsLocalization.AtPrime B _ O _ iB.toAlgebra 𝔮 _ → β.comp iT = iB.comp γ → IsLocalHom β → Ideal.map β (IsLocalRing.maximalIdeal T) = IsLocalRing.maximalIdeal O ∧ IsNoetherianRing O := by
    intro P B T O _ _ _ _ _ _ _ γ 𝔮 _ iT iB β hγ hT hO hβ hloc
    letI : Algebra P B := γ.toAlgebra
    letI : Algebra P T := iT.toAlgebra
    letI : Algebra B O := iB.toAlgebra
    letI : Algebra T O := β.toAlgebra
    letI : Algebra P O := (iB.comp γ).toAlgebra
    haveI : IsScalarTower P B O := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower P T O := IsScalarTower.of_algebraMap_eq' hβ.symm
    haveI : Algebra.Etale P B := RingHom.Etale.toAlgebra hγ
    haveI : Algebra.FormallyUnramified B O := Algebra.FormallyUnramified.of_isLocalization 𝔮.primeCompl
    haveI : Algebra.FormallyUnramified P O := Algebra.FormallyUnramified.comp P B O
    haveI : Algebra.FormallyUnramified T O := Algebra.FormallyUnramified.localization_base (𝔮.comap γ).primeCompl
    haveI : Algebra.FiniteType P B := Algebra.FiniteType.of_finitePresentation
    haveI : Algebra.EssFiniteType P B := Algebra.EssFiniteType.of_finiteType P B
    haveI : Algebra.EssFiniteType B O := Algebra.EssFiniteType.of_isLocalization O 𝔮.primeCompl
    haveI : Algebra.EssFiniteType P O := Algebra.EssFiniteType.comp P B O
    haveI : Algebra.EssFiniteType T O := Algebra.EssFiniteType.of_comp P T O
    haveI : IsLocalHom (algebraMap T O) := hloc
    refine ⟨?_, Algebra.EssFiniteType.isNoetherianRing T O⟩
    exact Algebra.FormallyUnramified.map_maximalIdeal

  obtain ⟨A, B, _, _, f, iA, iB, 𝔮, h𝔮, hstd, hA, hB, hcomm⟩ := L1 W.toScheme S (W.ι ≫ g) ⟨y, hyW⟩ hsm
  obtain ⟨iA', iB', hA', hB', hcomm'⟩ := L2 S Y g W y hyW A B f iA iB 𝔮 hA hB hcomm

  obtain ⟨γ, hγ, hγC⟩ := L3a A B f hstd
  haveI hp' : (𝔮.comap γ).IsPrime := Ideal.comap_isPrime γ 𝔮
  have hp'C : (𝔮.comap γ).comap Polynomial.C = 𝔮.comap f := by
    rw [Ideal.comap_comap, hγC]

  obtain ⟨Q, hQ, hQp', hQC, hT⟩ := L3c A (S.presheaf.stalk (g y)) iA' (𝔮.comap f) hA' (𝔮.comap γ) hp'C
  haveI := hQ
  haveI : IsNoetherianRing (Localization.AtPrime Q) := IsLocalization.isNoetherianRing Q.primeCompl _ inferInstance

  set iT : Polynomial A →+* Localization.AtPrime Q :=
    (algebraMap (Polynomial (S.presheaf.stalk (g y))) (Localization.AtPrime Q)).comp (Polynomial.mapRingHom iA') with hiT
  letI : Algebra (Polynomial A) (Localization.AtPrime Q) := iT.toAlgebra
  have hu : ∀ s : (𝔮.comap γ).primeCompl, IsUnit ((iB'.comp γ) s) := by
    intro s
    letI := iB'.toAlgebra
    have hs : γ s ∈ 𝔮.primeCompl := s.2
    exact IsLocalization.map_units (Y.presheaf.stalk y) (⟨γ s, hs⟩ : 𝔮.primeCompl)
  let β : Localization.AtPrime Q →+* Y.presheaf.stalk y := IsLocalization.lift (M := (𝔮.comap γ).primeCompl) hu
  have hβ : β.comp iT = iB'.comp γ := IsLocalization.lift_comp hu

  obtain ⟨hloc, hflat⟩ := L3b1 (Polynomial A) B (Localization.AtPrime Q) (Y.presheaf.stalk y) γ 𝔮 iT iB' β hγ hT hB' hβ
  obtain ⟨hmax, hnoeth⟩ := L3b2 (Polynomial A) B (Localization.AtPrime Q) (Y.presheaf.stalk y) γ 𝔮 iT iB' β hγ hT hB' hβ hloc
  refine ⟨hnoeth, Q, hQ, β, hQC, ?_, hloc, hflat, hmax⟩

  letI : Algebra A (S.presheaf.stalk (g y)) := iA'.toAlgebra
  apply IsLocalization.ringHom_ext (𝔮.comap f).primeCompl
  rw [RingHom.algebraMap_toAlgebra]
  calc (β.comp ((algebraMap (Polynomial (S.presheaf.stalk (g y))) (Localization.AtPrime Q)).comp Polynomial.C)).comp iA'
      = (β.comp iT).comp Polynomial.C := by
        rw [hiT]; ext a; simp
    _ = (g.stalkMap y).hom.comp iA' := by
        rw [hβ, RingHom.comp_assoc, hγC, hcomm']

theorem wcpa_dj_sp_poly_prime_params : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (n : ℕ) (t : Fin n → R), (n : WithBot ℕ∞) = ringKrullDim R → Ideal.span (Set.range t) = IsLocalRing.maximalIdeal R → ∀ (Q : Ideal (Polynomial R)) [Q.IsPrime], Q.comap Polynomial.C = IsLocalRing.maximalIdeal R → ∃ (e : ℕ) (f : Fin e → Polynomial R), e ≤ 1 ∧ (e = 0 → Q = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal R)) ∧ Ideal.span (Set.range (Fin.append (fun i => algebraMap (Polynomial R) (Localization.AtPrime Q) (Polynomial.C (t i))) (fun j => algebraMap (Polynomial R) (Localization.AtPrime Q) (f j)))) = IsLocalRing.maximalIdeal (Localization.AtPrime Q) ∧ ((n + e : ℕ) : WithBot ℕ∞) = ringKrullDim (Localization.AtPrime Q) :=
by
  intro R _ _ _ n t hn ht Q _ hQc
  classical
  have hΦs : Function.Surjective (Polynomial.mapRingHom (IsLocalRing.residue R)) :=
    Polynomial.map_surjective _ IsLocalRing.residue_surjective
  have hker : RingHom.ker (Polynomial.mapRingHom (IsLocalRing.residue R)) =
      Ideal.map Polynomial.C (IsLocalRing.maximalIdeal R) := by
    rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue]
  have hP₀Q : Ideal.map Polynomial.C (IsLocalRing.maximalIdeal R) ≤ Q := by
    rw [Ideal.map_le_iff_le_comap, hQc]
  have hspan : ∀ (e : ℕ) (f : Fin e → Polynomial R),
      Ideal.span (Set.range (fun i => Polynomial.C (t i))) ⊔ Ideal.span (Set.range f) = Q →
      Ideal.span (Set.range (Fin.append (fun i => algebraMap (Polynomial R) (Localization.AtPrime Q) (Polynomial.C (t i))) (fun j => algebraMap (Polynomial R) (Localization.AtPrime Q) (f j)))) = IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
    intro e f h
    have hr : Set.range (Fin.append (fun i => algebraMap (Polynomial R) (Localization.AtPrime Q) (Polynomial.C (t i))) (fun j => algebraMap (Polynomial R) (Localization.AtPrime Q) (f j))) =
        (algebraMap (Polynomial R) (Localization.AtPrime Q)) '' (Set.range (fun i => Polynomial.C (t i)) ∪ Set.range f) := by
      ext x
      simp only [Set.mem_range, Set.mem_image, Set.mem_union]
      constructor
      · rintro ⟨i, rfl⟩
        induction i using Fin.addCases with
        | left i => exact ⟨_, Or.inl ⟨i, rfl⟩, by simp⟩
        | right j => exact ⟨_, Or.inr ⟨j, rfl⟩, by simp⟩
      · rintro ⟨y, (⟨i, rfl⟩ | ⟨j, rfl⟩), rfl⟩
        · exact ⟨Fin.castAdd e i, by simp⟩
        · exact ⟨Fin.natAdd n j, by simp⟩
    rw [hr, ← Ideal.map_span, Ideal.span_union, h, Localization.AtPrime.map_eq_maximalIdeal]
  have hC : Ideal.span (Set.range (fun i => Polynomial.C (t i))) =
      Ideal.map Polynomial.C (IsLocalRing.maximalIdeal R) := by
    rw [← ht, Ideal.map_span, ← Set.range_comp]
    rfl
  have hdimQ : ringKrullDim (Localization.AtPrime Q) = (Q.height : WithBot ℕ∞) :=
    IsLocalization.AtPrime.ringKrullDim_eq_height Q (Localization.AtPrime Q)
  have h𝔪h : (IsLocalRing.maximalIdeal R).height = (n : ℕ∞) := by
    have h1 : ((IsLocalRing.maximalIdeal R).height : WithBot ℕ∞) = ((n : ℕ∞) : WithBot ℕ∞) := by
      rw [IsLocalRing.maximalIdeal_height_eq_ringKrullDim, ← hn]
      rfl
    exact WithBot.coe_injective h1
  have hcomap : Ideal.comap (Polynomial.mapRingHom (IsLocalRing.residue R))
      (Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue R)) Q) = Q := by
    rw [Ideal.comap_map_of_surjective' _ hΦs, hker, sup_eq_left.mpr hP₀Q]
  haveI hQ'p : (Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue R)) Q).IsPrime :=
    Ideal.map_isPrime_of_surjective hΦs (by rw [hker]; exact hP₀Q)
  by_cases hQ' : Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue R)) Q = ⊥
  · have hQeq : Q = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal R) := by
      rw [← hcomap, hQ', ← RingHom.ker_eq_comap_bot, hker]
    refine ⟨0, Fin.elim0, Nat.zero_le 1, fun _ => hQeq, ?_, ?_⟩
    · apply hspan
      rw [Set.range_eq_empty (Fin.elim0 : Fin 0 → Polynomial R), Ideal.span_empty, sup_bot_eq,
        hC, ← hQeq]
    · rw [hdimQ, hQeq, Polynomial.height_map_C, h𝔪h]
      rfl
  · haveI hQ'm : (Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue R)) Q).IsMaximal :=
      IsPrime.to_maximal_ideal hQ'
    haveI hQm : Q.IsMaximal := by
      rw [← hcomap]; exact Ideal.comap_isMaximal_of_surjective _ hΦs
    obtain ⟨f₀, hf₀⟩ := hΦs (Submodule.IsPrincipal.generator
      (Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue R)) Q))
    have hQeq : Q = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal R) ⊔ Ideal.span {f₀} := by
      apply le_antisymm
      · intro x hx
        have hx' : Polynomial.mapRingHom (IsLocalRing.residue R) x ∈
            Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue R)) Q := Ideal.mem_map_of_mem _ hx
        rw [← Submodule.IsPrincipal.span_singleton_generator
          (Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue R)) Q),
          Ideal.mem_span_singleton'] at hx'
        obtain ⟨a, ha⟩ := hx'
        obtain ⟨c, rfl⟩ := hΦs a
        have hmem : x - c * f₀ ∈ Ideal.map Polynomial.C (IsLocalRing.maximalIdeal R) := by
          rw [← hker, RingHom.mem_ker, map_sub, map_mul, hf₀, ha, sub_self]
        have hx2 : x = (x - c * f₀) + c * f₀ := by ring
        rw [hx2]
        exact Ideal.add_mem _ (Ideal.mem_sup_left hmem)
          (Ideal.mem_sup_right (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self f₀)))
      · refine sup_le hP₀Q ?_
        rw [Ideal.span_singleton_le_iff_mem, ← hcomap, Ideal.mem_comap, hf₀]
        exact Submodule.IsPrincipal.generator_mem _
    refine ⟨1, fun _ => f₀, le_refl _, fun h => absurd h one_ne_zero, ?_, ?_⟩
    · apply hspan
      rw [Set.range_const, hC, ← hQeq]
    · haveI : Q.LiesOver (IsLocalRing.maximalIdeal R) :=
        ⟨by rw [Ideal.under_def, Polynomial.algebraMap_eq, hQc]⟩
      rw [hdimQ, Polynomial.height_eq_height_add_one (IsLocalRing.maximalIdeal R) Q, h𝔪h]
      rfl

theorem wcpa_dj_sp_flat_unram_params : ∀ (C A : Type u) [CommRing C] [CommRing A] [IsLocalRing C] [IsLocalRing A] [IsNoetherianRing C] [IsNoetherianRing A] (β : C →+* A), IsLocalHom β → β.Flat → Ideal.map β (IsLocalRing.maximalIdeal C) = IsLocalRing.maximalIdeal A → ∀ (N : ℕ) (s : Fin N → C), Ideal.span (Set.range s) = IsLocalRing.maximalIdeal C → (N : WithBot ℕ∞) = ringKrullDim C → Ideal.span (Set.range (fun i => β (s i))) = IsLocalRing.maximalIdeal A ∧ (N : WithBot ℕ∞) = ringKrullDim A :=
by
  intro C A _ _ _ _ _ _ β hβl hβf hβm N s hs hN
  refine ⟨?_, ?_⟩
  · rw [← hβm, ← hs, Ideal.map_span, ← Set.range_comp]
    rfl
  · letI : Algebra C A := β.toAlgebra
    haveI : Module.Flat C A := hβf
    haveI : IsLocalHom (algebraMap C A) := hβl
    haveI : Algebra.HasGoingDown C A := inferInstance
    have hlies : (IsLocalRing.maximalIdeal A).LiesOver (IsLocalRing.maximalIdeal C) := inferInstance
    have h := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
      (IsLocalRing.maximalIdeal C) (IsLocalRing.maximalIdeal A)
    have hJ : Ideal.map (algebraMap C A) (IsLocalRing.maximalIdeal C) = IsLocalRing.maximalIdeal A := hβm
    have hbot : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap C A) (IsLocalRing.maximalIdeal C)))
        (IsLocalRing.maximalIdeal A) = ⊥ := Ideal.map_mk_eq_bot_of_le hJ.ge
    haveI : Nontrivial (A ⧸ Ideal.map (algebraMap C A) (IsLocalRing.maximalIdeal C)) :=
      Ideal.Quotient.nontrivial_iff.mpr
        (by rw [hJ]; exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top)
    rw [hbot, Ideal.height_bot, add_zero] at h
    rw [hN, ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
      ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := A), h]

theorem wcpa_dj_sp_section_stalk : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (τ : S ⟶ Y) (p₀ : S), IsSeparated g → τ ≫ g = 𝟙 S → IsClosed (Set.range ⇑τ) ∧ ∃ ψ : Y.presheaf.stalk (τ p₀) →+* S.presheaf.stalk (g (τ p₀)), ψ.comp (g.stalkMap (τ p₀)).hom = RingHom.id _ ∧ ∀ (z' : Y) (hz : z' ⤳ τ p₀), (z' ∈ Set.range ⇑τ ↔ RingHom.ker ψ ≤ Ideal.comap (Y.presheaf.stalkSpecializes hz).hom (IsLocalRing.maximalIdeal (Y.presheaf.stalk z'))) :=
by
  intro S Y g τ p₀ hsep h
  have hgτ : ∀ q : S, g (τ q) = q := by
    intro q
    rw [← Scheme.Hom.comp_apply, h]
    rfl
  refine ⟨?_, ?_⟩
  · have : IsClosedImmersion (τ ≫ g) := by rw [h]; infer_instance
    have : IsClosedImmersion τ := IsClosedImmersion.of_comp τ g
    exact τ.isClosedEmbedding.isClosed_range
  · let c := S.presheaf.stalkCongr (Inseparable.of_eq (hgτ p₀))
    have key : g.stalkMap (τ p₀) ≫ τ.stalkMap p₀ = c.hom := by
      rw [← Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_congr_hom (τ ≫ g) (𝟙 S) h p₀,
        Scheme.Hom.stalkMap_id]
      exact Category.comp_id _
    have key' : (τ.stalkMap p₀).hom.comp (g.stalkMap (τ p₀)).hom = c.hom.hom := by
      rw [← CommRingCat.hom_comp, key]
    have hsurj : Function.Surjective (τ.stalkMap p₀).hom := by
      intro b
      refine ⟨(g.stalkMap (τ p₀)).hom (c.inv.hom b), ?_⟩
      rw [← RingHom.comp_apply, key', ← CommRingCat.comp_apply, c.inv_hom_id, CommRingCat.id_apply]
    have hinj : Function.Injective c.inv.hom := (ConcreteCategory.bijective_of_isIso c.inv).1
    refine ⟨c.inv.hom.comp (τ.stalkMap p₀).hom, ?_, ?_⟩
    · rw [RingHom.comp_assoc, key', ← CommRingCat.hom_comp, c.hom_inv_id, CommRingCat.hom_id]
    · intro z' hz
      rw [RingHom.ker_comp_of_injective _ hinj]
      constructor
      · rintro ⟨p', rfl⟩
        have hp : p' ⤳ p₀ := by
          have := hz.map g.continuous
          rwa [hgτ, hgτ] at this
        intro a ha
        rw [RingHom.mem_ker] at ha
        rw [Ideal.mem_comap]
        have sq := Scheme.Hom.stalkSpecializes_stalkMap τ p' p₀ hp
        have e : (τ.stalkMap p').hom ((Y.presheaf.stalkSpecializes hz).hom a) = 0 := by
          have := congrArg (fun f => f.hom a) sq
          simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
          rw [this, ha, map_zero]
        by_contra hne
        have hu : IsUnit ((Y.presheaf.stalkSpecializes hz).hom a) := by
          rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hne
        have := hu.map (τ.stalkMap p').hom
        rw [e] at this
        exact not_isUnit_zero this
      · intro hle
        have hPprime : (Ideal.comap (Y.presheaf.stalkSpecializes hz).hom
            (IsLocalRing.maximalIdeal (Y.presheaf.stalk z'))).IsPrime := Ideal.comap_isPrime _ _
        have hQ : (Ideal.map (τ.stalkMap p₀).hom (Ideal.comap (Y.presheaf.stalkSpecializes hz).hom
            (IsLocalRing.maximalIdeal (Y.presheaf.stalk z')))).IsPrime :=
          Ideal.map_isPrime_of_surjective hsurj hle
        let Q : Spec (S.presheaf.stalk p₀) := (⟨_, hQ⟩ : PrimeSpectrum _)
        let c0 : Spec (Y.presheaf.stalk z') := IsLocalRing.closedPoint (Y.presheaf.stalk z')
        have hcomap : Ideal.comap (τ.stalkMap p₀).hom
            (Ideal.map (τ.stalkMap p₀).hom (Ideal.comap (Y.presheaf.stalkSpecializes hz).hom
            (IsLocalRing.maximalIdeal (Y.presheaf.stalk z')))) = Ideal.comap (Y.presheaf.stalkSpecializes hz).hom
            (IsLocalRing.maximalIdeal (Y.presheaf.stalk z')) := by
          rw [Ideal.comap_map_of_surjective' _ hsurj]; exact sup_eq_left.mpr hle
        have sq1 := Scheme.SpecMap_stalkMap_fromSpecStalk τ (x := p₀)
        have sq2 := Scheme.SpecMap_stalkSpecializes_fromSpecStalk hz
        have e1 : Y.fromSpecStalk (τ p₀) ((Spec.map (τ.stalkMap p₀)) Q) =
            τ (S.fromSpecStalk p₀ Q) := by
          rw [← Scheme.Hom.comp_apply, sq1, Scheme.Hom.comp_apply]
        have e2 : Y.fromSpecStalk (τ p₀) ((Spec.map (Y.presheaf.stalkSpecializes hz)) c0) = z' := by
          have h2 : (Spec.map (Y.presheaf.stalkSpecializes hz) ≫ Y.fromSpecStalk (τ p₀)) c0 =
              Y.fromSpecStalk z' c0 := by rw [sq2]
          rw [Scheme.Hom.comp_apply] at h2
          rw [h2]
          exact Scheme.fromSpecStalk_closedPoint
        have e3 : (Spec.map (τ.stalkMap p₀)) Q = (Spec.map (Y.presheaf.stalkSpecializes hz)) c0 := by
          apply PrimeSpectrum.ext
          exact hcomap
        exact ⟨S.fromSpecStalk p₀ Q, by rw [← e1, e3, e2]⟩

theorem wcpa_dj_sp_retraction_kernel : ∀ (R A : Type u) [CommRing R] [CommRing A] [IsLocalRing R] [IsLocalRing A] [IsNoetherianRing A] (φ : R →+* A) (ψ : A →+* R), ψ.comp φ = RingHom.id R → ∀ (n e : ℕ) (t : Fin n → R) (w : Fin e → A), Ideal.span (Set.range t) = IsLocalRing.maximalIdeal R → Ideal.span (Set.range (Fin.append (fun i => φ (t i)) w)) = IsLocalRing.maximalIdeal A → Ideal.span (Set.range (Fin.append (fun i => φ (t i)) (fun j => w j - φ (ψ (w j))))) = IsLocalRing.maximalIdeal A ∧ RingHom.ker ψ = Ideal.span (Set.range (fun j => w j - φ (ψ (w j)))) :=
by
  intro R A _ _ _ _ _ φ ψ hψφ n e t w ht hw
  have F1 : ∀ r, ψ (φ r) = r := fun r => by
    have := RingHom.congr_fun hψφ r
    simpa using this
  set w' : Fin e → A := fun j => w j - φ (ψ (w j)) with hw'def
  have F2 : ∀ j, ψ (w' j) = 0 := fun j => by simp [w', F1]
  have hloc : IsLocalHom ψ := Function.Surjective.isLocalHom ψ (fun r => ⟨φ r, F1 r⟩)
  have F4 : ∀ x ∈ IsLocalRing.maximalIdeal A, ψ x ∈ IsLocalRing.maximalIdeal R := by
    intro x hx
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    exact fun h => hx (isUnit_of_map_unit ψ x h)
  have hT : Ideal.span (Set.range (fun i => φ (t i))) =
      Ideal.map φ (IsLocalRing.maximalIdeal R) := by
    rw [← ht, Ideal.map_span, ← Set.range_comp]
    rfl
  have hφt_le : ∀ (v : Fin e → A), Ideal.span (Set.range (fun i => φ (t i))) ≤
      Ideal.span (Set.range (Fin.append (fun i => φ (t i)) v)) := by
    intro v
    apply Ideal.span_mono
    rintro _ ⟨i, rfl⟩
    exact ⟨Fin.castAdd e i, Fin.append_left _ _ i⟩
  have hwmem : ∀ j, w j ∈ IsLocalRing.maximalIdeal A := by
    intro j
    rw [← hw]
    exact Ideal.subset_span ⟨Fin.natAdd n j, Fin.append_right _ _ j⟩
  have P : ∀ j, φ (ψ (w j)) ∈ Ideal.span (Set.range (fun i => φ (t i))) := by
    intro j
    rw [hT]
    exact Ideal.mem_map_of_mem φ (F4 _ (hwmem j))
  have hspan : Ideal.span (Set.range (Fin.append (fun i => φ (t i)) w')) =
      IsLocalRing.maximalIdeal A := by
    apply le_antisymm
    · rw [Ideal.span_le, Set.range_subset_iff]
      intro k
      refine Fin.addCases (fun i => ?_) (fun j => ?_) k
      · rw [Fin.append_left, ← hw]
        exact Ideal.subset_span ⟨Fin.castAdd e i, Fin.append_left _ _ i⟩
      · rw [Fin.append_right]
        have h2 : φ (ψ (w j)) ∈ IsLocalRing.maximalIdeal A := by
          rw [← hw]; exact hφt_le w (P j)
        exact Ideal.sub_mem _ (hwmem j) h2
    · rw [← hw, Ideal.span_le, Set.range_subset_iff]
      intro k
      refine Fin.addCases (fun i => ?_) (fun j => ?_) k
      · rw [Fin.append_left]
        exact Ideal.subset_span ⟨Fin.castAdd e i, Fin.append_left _ _ i⟩
      · rw [Fin.append_right]
        have h1 : w' j ∈ Ideal.span (Set.range (Fin.append (fun i => φ (t i)) w')) :=
          Ideal.subset_span ⟨Fin.natAdd n j, Fin.append_right _ _ j⟩
        have h2 := hφt_le w' (P j)
        have h3 : w j = w' j + φ (ψ (w j)) := by simp [w']
        rw [SetLike.mem_coe, h3]
        exact Ideal.add_mem _ h1 h2
  refine ⟨hspan, ?_⟩
  have hK_le : Ideal.span (Set.range w') ≤ RingHom.ker ψ := by
    rw [Ideal.span_le, Set.range_subset_iff]
    intro j
    exact (RingHom.mem_ker).mpr (F2 j)
  have hsup : RingHom.ker ψ ≤
      Ideal.span (Set.range w') ⊔ IsLocalRing.maximalIdeal A • RingHom.ker ψ := by
    intro a ha
    rw [RingHom.mem_ker] at ha
    have haM : a ∈ IsLocalRing.maximalIdeal A := by
      apply IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top ψ)
      exact (RingHom.mem_ker).mpr ha
    rw [← hspan, Ideal.mem_span_range_iff_exists_fun] at haM
    obtain ⟨c, hc⟩ := haM
    rw [Fin.sum_univ_add] at hc
    simp only [Fin.append_left, Fin.append_right] at hc
    have h0 : ∑ i, ψ (c (Fin.castAdd e i)) * t i = 0 := by
      have := congrArg ψ hc
      rw [ha, map_add, map_sum, map_sum] at this
      simp only [map_mul, F1, F2, mul_zero, Finset.sum_const_zero, add_zero] at this
      exact this
    have h00 : ∑ i, φ (ψ (c (Fin.castAdd e i))) * φ (t i) = 0 := by
      have := congrArg φ h0
      rw [map_sum, map_zero] at this
      simpa only [map_mul] using this
    have hdecomp : a = ∑ j, c (Fin.natAdd n j) * w' j +
        ∑ i, (c (Fin.castAdd e i) - φ (ψ (c (Fin.castAdd e i)))) * φ (t i) := by
      rw [← hc]
      simp only [sub_mul, Finset.sum_sub_distrib, h00]
      ring
    rw [hdecomp]
    apply Submodule.add_mem_sup
    · exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩))
    · apply Submodule.sum_mem
      intro i _
      rw [mul_comm, ← smul_eq_mul]
      apply Submodule.smul_mem_smul
      · rw [← hspan]
        exact Ideal.subset_span ⟨Fin.castAdd e i, Fin.append_left _ _ i⟩
      · rw [RingHom.mem_ker, map_sub, F1, sub_self]
  have hle : RingHom.ker ψ ≤ Ideal.span (Set.range w') :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) hsup
  exact le_antisymm hle hK_le

theorem wcpa_dj_sp_no_retraction : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Q : Ideal (Polynomial R)) [Q.IsPrime], Q = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal R) → ∀ θ : Localization.AtPrime Q →+* R, θ.comp ((algebraMap (Polynomial R) (Localization.AtPrime Q)).comp Polynomial.C) = RingHom.id R → False :=
by
  intro R _ _ Q _ hQ θ hθ
  set ι := algebraMap (Polynomial R) (Localization.AtPrime Q) with hι
  set a := θ (ι Polynomial.X) with ha
  have hp : (Polynomial.X - Polynomial.C a) ∈ Q.primeCompl := by
    show (Polynomial.X - Polynomial.C a) ∉ Q
    intro hmem
    rw [hQ, Ideal.mem_map_C_iff] at hmem
    have h1 := hmem 1
    rw [Polynomial.coeff_sub, Polynomial.coeff_X_one, Polynomial.coeff_C] at h1
    simp only [one_ne_zero, if_false, sub_zero] at h1
    exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h1)
  have hu : IsUnit (ι (Polynomial.X - Polynomial.C a)) :=
    IsLocalization.map_units (Localization.AtPrime Q) (⟨_, hp⟩ : Q.primeCompl)
  have hu' := hu.map θ
  have hCa : θ (ι (Polynomial.C a)) = a := RingHom.congr_fun hθ a
  rw [map_sub, map_sub, hCa, ← ha, sub_self] at hu'
  exact not_isUnit_zero hu'

theorem wcpa_dj_stc_kms_section_local : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (τ : S ⟶ Y) (p₀ : S) (n : ℕ)
    (t : Fin n → S.presheaf.stalk (g (τ p₀))),
    IsSeparated g → τ ≫ g = 𝟙 S →
    (∃ W : Y.Opens, τ p₀ ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) →
    IsNoetherianRing (S.presheaf.stalk (g (τ p₀))) →
    (n : WithBot ℕ∞) = ringKrullDim (S.presheaf.stalk (g (τ p₀))) →
    Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (S.presheaf.stalk (g (τ p₀))) →
    IsRegularLocalRing (Y.presheaf.stalk (τ p₀)) ∧
    ∃ (ψ : Y.presheaf.stalk (τ p₀) →+* S.presheaf.stalk (g (τ p₀))) (z : Y.presheaf.stalk (τ p₀)),
      ψ.comp (g.stalkMap (τ p₀)).hom = RingHom.id _ ∧
      RingHom.ker ψ = Ideal.span {z} ∧
      Ideal.span (Set.range (Fin.append (fun l => (g.stalkMap (τ p₀)).hom (t l)) ![z])) =
        IsLocalRing.maximalIdeal (Y.presheaf.stalk (τ p₀)) ∧
      ((n + 1 : ℕ) : WithBot ℕ∞) = ringKrullDim (Y.presheaf.stalk (τ p₀)) ∧
      ∀ (y' : Y) (h : y' ⤳ τ p₀), (y' ∈ Set.range ⇑τ ↔
        (Y.presheaf.stalkSpecializes h).hom z ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y')) :=
by
  intro S Y g τ p₀ n t hsep hτ hsm hRN hn ht
  classical
  haveI := hRN
  obtain ⟨hNoeth, Q, hQ, β, hQc, hβc, hβl, hβf, hβm⟩ :=
    wcpa_dj_sp_smooth_stalk_model S Y g (τ p₀) hRN hsm
  haveI := hNoeth
  haveI := hQ
  obtain ⟨e, f, he1, he0, hspanQ, hdimQ⟩ :=
    wcpa_dj_sp_poly_prime_params (S.presheaf.stalk (g (τ p₀))) n t hn ht Q hQc
  obtain ⟨hspanO, hdimO⟩ := wcpa_dj_sp_flat_unram_params (Localization.AtPrime Q)
    (Y.presheaf.stalk (τ p₀)) β hβl hβf hβm (n + e) _ hspanQ hdimQ
  obtain ⟨w, hw⟩ : ∃ w : Fin (n + e) → Y.presheaf.stalk (τ p₀),
      w = Fin.append (fun i => (g.stalkMap (τ p₀)).hom (t i))
        (fun k => β (algebraMap (Polynomial (S.presheaf.stalk (g (τ p₀))))
          (Localization.AtPrime Q) (f k))) := ⟨_, rfl⟩
  have hspanO' : Ideal.span (Set.range w) =
      IsLocalRing.maximalIdeal (Y.presheaf.stalk (τ p₀)) := by
    rw [← hspanO]
    congr 2
    funext i
    rw [hw]
    induction i using Fin.addCases with
    | left i =>
      simp only [Fin.append_left]
      exact (RingHom.congr_fun hβc (t i)).symm
    | right k =>
      simp only [Fin.append_right]
  obtain ⟨-, ψ, hψ, hψiff⟩ := wcpa_dj_sp_section_stalk S Y g τ p₀ hsep hτ
  have he : e = 1 := by
    rcases Nat.lt_or_ge e 1 with h | h
    · exfalso
      have he0' : e = 0 := by omega
      refine wcpa_dj_sp_no_retraction _ Q (he0 he0') (ψ.comp β) ?_
      rw [RingHom.comp_assoc, hβc, hψ]
    · omega
  subst he
  obtain ⟨hspan'', hker⟩ := wcpa_dj_sp_retraction_kernel (S.presheaf.stalk (g (τ p₀)))
    (Y.presheaf.stalk (τ p₀)) (g.stalkMap (τ p₀)).hom ψ hψ n 1 t
    (fun k => β (algebraMap (Polynomial (S.presheaf.stalk (g (τ p₀))))
      (Localization.AtPrime Q) (f k))) ht (by rw [hw] at hspanO'; exact hspanO')
  obtain ⟨wd, hwd⟩ : ∃ wd : Fin 1 → Y.presheaf.stalk (τ p₀),
      wd = fun k => β (algebraMap (Polynomial (S.presheaf.stalk (g (τ p₀))))
          (Localization.AtPrime Q) (f k)) -
        (g.stalkMap (τ p₀)).hom (ψ (β (algebraMap (Polynomial (S.presheaf.stalk (g (τ p₀))))
          (Localization.AtPrime Q) (f k)))) := ⟨_, rfl⟩
  have hwdz : wd = ![wd 0] := by
    funext k
    rw [Fin.fin_one_eq_zero k]
    rfl
  have hker' : RingHom.ker ψ = Ideal.span {wd 0} := by
    have h1 : RingHom.ker ψ = Ideal.span (Set.range wd) := by
      rw [hwd]; exact hker
    rw [h1]
    congr 1
    ext x
    constructor
    · rintro ⟨k, rfl⟩
      rw [Fin.fin_one_eq_zero k]
      exact Set.mem_singleton _
    · intro hx
      rw [Set.mem_singleton_iff.mp hx]
      exact ⟨0, rfl⟩
  have hspanW : Ideal.span (Set.range (Fin.append (fun l => (g.stalkMap (τ p₀)).hom (t l))
      ![wd 0])) = IsLocalRing.maximalIdeal (Y.presheaf.stalk (τ p₀)) := by
    rw [← hwdz, hwd]; exact hspan''
  have hreg : IsRegularLocalRing (Y.presheaf.stalk (τ p₀)) := by
    apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
    set P := Fin.append (fun l => (g.stalkMap (τ p₀)).hom (t l)) ![wd 0] with hP
    have h1 : (IsLocalRing.maximalIdeal (Y.presheaf.stalk (τ p₀))).spanFinrank ≤
        (Set.range P).ncard := by
      rw [← hspanW]
      exact Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range P)
    have h2 : (Set.range P).ncard ≤ n + 1 := by
      rw [← Set.image_univ]
      refine (Set.ncard_image_le Set.finite_univ).trans ?_
      rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]
    rw [← hdimO]
    exact_mod_cast h1.trans h2
  refine ⟨hreg, ψ, wd 0, hψ, hker', hspanW, hdimO, ?_⟩
  intro y' h
  rw [hψiff y' h, hker', Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]

theorem wcpa_dj_stc_kms_coeff_maps : ∀ (R B : Type u) [CommRing R] [CommRing B] [IsDomain B] (φ : R →+* B) (ψ : B →+* R) (z : B),
    ψ.comp φ = RingHom.id R → RingHom.ker ψ = Ideal.span {z} → z ≠ 0 →
    ∃ c : ℕ → B →+ R, (∀ i r b, c i (φ r * b) = r * c i b) ∧ (∀ b, c 0 (z * b) = 0) ∧
      (∀ i b, c (i + 1) (z * b) = c i b) ∧ (∀ r, c 0 (φ r) = r) ∧ (∀ i r, c (i + 1) (φ r) = 0) ∧
      (∀ k b b', c k (b * b') = ∑ p ∈ Finset.range (k + 1), c p b * c (k - p) b') ∧
      (∀ (k : ℕ) (b : B), b - ∑ i ∈ Finset.range k, φ (c i b) * z ^ i ∈ Ideal.span {z ^ k}) :=
by
  intro R B _ _ _ φ ψ z hψφ hker hz
  have hψφ' : ∀ r, ψ (φ r) = r := fun r => by
    have := RingHom.congr_fun hψφ r
    simpa using this
  have hψz : ψ z = 0 := by
    have : z ∈ RingHom.ker ψ := by rw [hker]; exact Ideal.mem_span_singleton_self z
    exact (RingHom.mem_ker).mp this
  have hex : ∀ b : B, ∃ q : B, z * q = b - φ (ψ b) := by
    intro b
    have hmem : b - φ (ψ b) ∈ RingHom.ker ψ := by
      rw [RingHom.mem_ker, map_sub, hψφ', sub_self]
    rw [hker, Ideal.mem_span_singleton'] at hmem
    obtain ⟨a, ha⟩ := hmem
    exact ⟨a, by rw [mul_comm]; exact ha⟩
  choose d hd using hex
  have uniq : ∀ b q, z * q = b - φ (ψ b) → d b = q := by
    intro b q hq
    exact mul_left_cancel₀ hz ((hd b).trans hq.symm)
  have hadd : ∀ x y, d (x + y) = d x + d y := by
    intro x y
    apply uniq
    rw [mul_add, hd x, hd y, map_add, map_add]; ring
  obtain ⟨D, hD⟩ : ∃ D : B →+ B, ∀ b, D b = d b := ⟨AddMonoidHom.mk' d hadd, fun _ => rfl⟩
  have hE : ∀ b, b = φ (ψ b) + z * D b := by
    intro b; rw [hD, hd b]; ring
  have hDφ : ∀ r b, D (φ r * b) = φ r * D b := by
    intro r b
    rw [hD, hD]
    apply uniq
    rw [map_mul ψ, hψφ', map_mul φ]
    linear_combination φ r * hd b
  have hDz : ∀ b, D (z * b) = b := by
    intro b; rw [hD]; apply uniq; rw [map_mul, hψz, zero_mul, map_zero, sub_zero]
  have hDφ0 : ∀ r, D (φ r) = 0 := by
    intro r; rw [hD]; apply uniq; rw [hψφ', sub_self, mul_zero]
  have hDmul : ∀ b b', D (b * b') = b * D b' + φ (ψ b') * D b := by
    intro b b'
    rw [hD, hD, hD]; apply uniq
    rw [map_mul ψ, map_mul φ]
    linear_combination b * hd b' + φ (ψ b') * hd b
  obtain ⟨c, hc⟩ : ∃ c : ℕ → B →+ R, ∀ i b, c i b = ψ ((⇑D)^[i] b) :=
    ⟨fun i => AddMonoidHom.mk' (fun b => ψ ((⇑D)^[i] b))
      (fun x y => by simp only [iterate_map_add, map_add]), fun _ _ => rfl⟩
  have hcs : ∀ i b, c (i + 1) b = c i (D b) := by
    intro i b
    rw [hc, hc, Function.iterate_succ_apply]
  have Dit : ∀ i r b, (⇑D)^[i] (φ r * b) = φ r * (⇑D)^[i] b := by
    intro i r
    induction i with
    | zero => intro b; rfl
    | succ i ih =>
      intro b
      rw [Function.iterate_succ_apply, Function.iterate_succ_apply, hDφ, ih]
  have h1 : ∀ i r b, c i (φ r * b) = r * c i b := by
    intro i r b
    rw [hc, hc, Dit, map_mul, hψφ']
  have h2 : ∀ b, c 0 (z * b) = 0 := by
    intro b
    rw [hc, Function.iterate_zero_apply, map_mul, hψz, zero_mul]
  have h3 : ∀ i b, c (i + 1) (z * b) = c i b := by
    intro i b
    rw [hcs, hDz]
  have h4 : ∀ r, c 0 (φ r) = r := by
    intro r
    rw [hc, Function.iterate_zero_apply, hψφ']
  have h5 : ∀ i r, c (i + 1) (φ r) = 0 := by
    intro i r
    rw [hcs, hDφ0, map_zero]
  have h6 : ∀ k b b', c k (b * b') = ∑ p ∈ Finset.range (k + 1), c p b * c (k - p) b' := by
    intro k
    induction k with
    | zero =>
      intro b b'
      rw [Finset.sum_range_one, Nat.sub_self]
      simp only [hc, Function.iterate_zero_apply, map_mul]
    | succ k ih =>
      intro b b'
      rw [hcs, hDmul, map_add, ih b (D b'), Finset.sum_range_succ _ (k + 1), Nat.sub_self]
      have e1 : c k (φ (ψ b') * D b) = c (k + 1) b * c 0 b' := by
        rw [h1, hcs, hc 0 b', Function.iterate_zero_apply, mul_comm]
      rw [e1]
      congr 1
      apply Finset.sum_congr rfl
      intro p hp
      rw [Finset.mem_range] at hp
      have e2 : k + 1 - p = (k - p) + 1 := by omega
      rw [e2, hcs]
  have rem : ∀ k b, b - ∑ i ∈ Finset.range k, φ (c i b) * z ^ i = z ^ k * (⇑D)^[k] b := by
    intro k
    induction k with
    | zero => intro b; simp
    | succ k ih =>
      intro b
      rw [Finset.sum_range_succ']
      have e : ∑ i ∈ Finset.range k, φ (c (i + 1) b) * z ^ (i + 1)
          = z * ∑ i ∈ Finset.range k, φ (c i (D b)) * z ^ i := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        rw [hcs, pow_succ]
        ring
      have h0 : c 0 b = ψ b := by rw [hc, Function.iterate_zero_apply]
      rw [e, Function.iterate_succ_apply, h0, pow_zero, mul_one]
      linear_combination hE b + z * ih (D b)
  have h7 : ∀ (k : ℕ) (b : B), b - ∑ i ∈ Finset.range k, φ (c i b) * z ^ i ∈ Ideal.span {z ^ k} := by
    intro k b
    rw [rem k b]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  exact ⟨c, h1, h2, h3, h4, h5, h6, h7⟩

theorem wcpa_dj_stc_kms_completion_iso : ∀ (R B : Type u) [CommRing R] [CommRing B] [IsLocalRing R] [IsLocalRing B]
    [IsNoetherianRing R] [IsNoetherianRing B]
    (φ : R →+* B) (ψ : B →+* R) (z : B) (c : ℕ → B →+ R),
    ψ.comp φ = RingHom.id R → RingHom.ker ψ = Ideal.span {z} →
    (∀ i r b, c i (φ r * b) = r * c i b) → (∀ b, c 0 (z * b) = 0) →
    (∀ i b, c (i + 1) (z * b) = c i b) → (∀ r, c 0 (φ r) = r) → (∀ i r, c (i + 1) (φ r) = 0) →
    (∀ k b b', c k (b * b') = ∑ p ∈ Finset.range (k + 1), c p b * c (k - p) b') →
    (∀ (k : ℕ) (b : B), b - ∑ i ∈ Finset.range k, φ (c i b) * z ^ i ∈ Ideal.span {z ^ k}) →
    ∃ e : AdicCompletion (IsLocalRing.maximalIdeal B) B ≃+*
        PowerSeries (AdicCompletion (IsLocalRing.maximalIdeal R) R),
      e.toRingHom.comp ((algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp φ) =
        PowerSeries.C.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) ∧
      e (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) z) = PowerSeries.X :=
by
  intro R B _ _ _ _ _ _ φ ψ z c hψφ hker H1 H2 H3 H4 H5 H6 H7
  classical

  have lvl : ∀ {A : Type u} [CommRing A] (J : Ideal A) (x : AdicCompletion J A) (b : A) (n m : ℕ),
      n ≤ m → Ideal.Quotient.mk (J ^ m) b = AdicCompletion.evalₐ J m x →
      Ideal.Quotient.mk (J ^ n) b = AdicCompletion.evalₐ J n x := by
    intro A _ J x b n m h hb
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective J A x
    rw [AdicCompletion.evalₐ_mk] at hb ⊢
    rw [Ideal.Quotient.eq] at hb ⊢
    have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk h s
    rw [Submodule.Quotient.eq] at h1
    have h2 : (s m - s n) ∈ J ^ n := by simpa using h1
    have h3 : b - s m ∈ J ^ n := Ideal.pow_le_pow_right h hb
    have h4 := Ideal.add_mem _ h3 h2
    simpa using h4
  have quot0 : ∀ {A : Type u} [CommRing A] (J : Ideal A) (p q : A ⧸ J ^ 0), p = q := by
    intro A _ J p q
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective p
    obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective q
    rw [Ideal.Quotient.eq, pow_zero, Ideal.one_eq_top]
    exact Submodule.mem_top
  have hψφ' : ∀ r, ψ (φ r) = r := fun r => by
    have := RingHom.congr_fun hψφ r
    simpa using this
  have hzker : ψ z = 0 := by
    have : z ∈ RingHom.ker ψ := by rw [hker]; exact Ideal.mem_span_singleton_self z
    exact this
  have P1 : z ∈ IsLocalRing.maximalIdeal B := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have := hu.map ψ
    rw [hzker] at this
    exact not_isUnit_zero this
  have P2 : ∀ r, r ∈ IsLocalRing.maximalIdeal R → φ r ∈ IsLocalRing.maximalIdeal B := by
    intro r hr
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have := hu.map ψ
    rw [hψφ'] at this
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hr
    exact hr this
  have P2' : ∀ j r, r ∈ IsLocalRing.maximalIdeal R ^ j → φ r ∈ IsLocalRing.maximalIdeal B ^ j := by
    intro j r hr
    have h1 : IsLocalRing.maximalIdeal R ≤ Ideal.comap φ (IsLocalRing.maximalIdeal B) :=
      fun r hr => P2 r hr
    have h2 : IsLocalRing.maximalIdeal R ^ j ≤ Ideal.comap φ (IsLocalRing.maximalIdeal B ^ j) :=
      (Ideal.pow_right_mono h1 j).trans (Ideal.le_comap_pow φ j)
    exact h2 hr
  have hspz : Ideal.span {z} ≤ IsLocalRing.maximalIdeal B :=
    (Ideal.span_singleton_le_iff_mem _).mpr P1
  have hc1 : ∀ b, b - φ (c 0 b) ∈ Ideal.span {z} := by
    intro b
    have := H7 1 b
    simpa using this
  have hc01 : c 0 1 = 1 := by
    have := H4 1
    rwa [map_one] at this
  have hc1s : ∀ i, c (i + 1) 1 = 0 := by
    intro i
    have := H5 i 1
    rwa [map_one] at this
  have P3 : ∀ b, b ∈ IsLocalRing.maximalIdeal B → c 0 b ∈ IsLocalRing.maximalIdeal R := by
    intro b hb
    have h1 : φ (c 0 b) ∈ IsLocalRing.maximalIdeal B := by
      have : φ (c 0 b) = b - (b - φ (c 0 b)) := by ring
      rw [this]
      exact Ideal.sub_mem _ hb (hspz (hc1 b))
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h1
    exact h1 (hu.map φ)

  have cont : ∀ k b, b ∈ IsLocalRing.maximalIdeal B ^ k →
      ∀ i, c i b ∈ IsLocalRing.maximalIdeal R ^ (k - i) := by
    intro k
    induction k with
    | zero => intro b _ i; simp
    | succ k ih =>
      intro b hb
      rw [pow_succ'] at hb
      refine Submodule.mul_induction_on
        (C := fun b => ∀ i, c i b ∈ IsLocalRing.maximalIdeal R ^ (k + 1 - i)) hb ?_ ?_
      · intro x hx y hy i
        obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (hc1 x)
        have hxy : x * y = φ (c 0 x) * y + z * (a * y) := by
          linear_combination (-y) * ha
        rw [hxy, map_add, H1]
        refine Ideal.add_mem _ ?_ ?_
        · have h1 : c 0 x * c i y ∈ IsLocalRing.maximalIdeal R * IsLocalRing.maximalIdeal R ^ (k - i) :=
            Ideal.mul_mem_mul (P3 x hx) (ih y hy i)
          rw [← pow_succ'] at h1
          exact Ideal.pow_le_pow_right (by omega) h1
        · cases i with
          | zero => rw [H2]; exact Ideal.zero_mem _
          | succ i' =>
            rw [H3]
            have := ih (a * y) (Ideal.mul_mem_left _ _ hy) i'
            simpa [Nat.add_sub_add_right] using this
      · intro x y hx hy i
        rw [map_add]
        exact Ideal.add_mem _ (hx i) (hy i)
  have term : ∀ k i r, i ≤ k → r ∈ IsLocalRing.maximalIdeal R ^ (k - i) →
      φ r * z ^ i ∈ IsLocalRing.maximalIdeal B ^ k := by
    intro k i r hi hr
    have h1 := Ideal.mul_mem_mul (P2' _ r hr) (Ideal.pow_mem_pow P1 i)
    rw [← pow_add, Nat.sub_add_cancel hi] at h1
    exact h1

  have detect : ∀ k b, (∀ i < k, c i b ∈ IsLocalRing.maximalIdeal R ^ (k - i)) →
      b ∈ IsLocalRing.maximalIdeal B ^ k := by
    intro k b hb
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp (H7 k b)
    have hb' : b = ∑ i ∈ Finset.range k, φ (c i b) * z ^ i + w * z ^ k := by rw [hw]; ring
    rw [hb']
    refine Ideal.add_mem _ (Ideal.sum_mem _ fun i hi => ?_)
      (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow P1 k))
    have hi' := Finset.mem_range.mp hi
    exact term k i _ hi'.le (hb i hi')

  have P4 : ∀ j i r, c i (φ r * z ^ j) = if i = j then r else 0 := by
    intro j
    induction j with
    | zero =>
      intro i r
      rcases i with _ | i
      · simp [H4]
      · simp [H5]
    | succ j ih =>
      intro i r
      have : φ r * z ^ (j + 1) = z * (φ r * z ^ j) := by ring
      rw [this]
      rcases i with _ | i
      · rw [H2, if_neg (by omega)]
      · rw [H3, ih]; simp

  choose L hL using fun (x : AdicCompletion (IsLocalRing.maximalIdeal B) B) (m : ℕ) =>
    Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) m x)
  have star : ∀ i n m m' (x : AdicCompletion (IsLocalRing.maximalIdeal B) B) b b', n + i ≤ m →
      n + i ≤ m' →
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ m) b =
        AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) m x →
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ m') b' =
        AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) m' x →
      c i b - c i b' ∈ IsLocalRing.maximalIdeal R ^ n := by
    intro i n m m' x b b' h h' hb hb'
    have e1 := lvl (IsLocalRing.maximalIdeal B) x b (n + i) m h hb
    have e2 := lvl (IsLocalRing.maximalIdeal B) x b' (n + i) m' h' hb'
    have e3 : b - b' ∈ IsLocalRing.maximalIdeal B ^ (n + i) := Ideal.Quotient.eq.mp (e1.trans e2.symm)
    have := cont (n + i) (b - b') e3 i
    rwa [map_sub, Nat.add_sub_cancel] at this
  let seq : ℕ → AdicCompletion (IsLocalRing.maximalIdeal B) B →
      AdicCompletion.AdicCauchySequence (IsLocalRing.maximalIdeal R) R := fun i x =>
    AdicCompletion.AdicCauchySequence.mk (IsLocalRing.maximalIdeal R) R
      (fun n => c i (L x (n + i))) (fun n => by
        rw [SModEq.sub_mem]
        have := star i n (n + i) (n + 1 + i) x _ _ le_rfl (by omega) (hL x _) (hL x _)
        simpa using this)
  let C : ℕ → AdicCompletion (IsLocalRing.maximalIdeal B) B →
      AdicCompletion (IsLocalRing.maximalIdeal R) R := fun i x =>
    AdicCompletion.mk (IsLocalRing.maximalIdeal R) R (seq i x)
  have hC : ∀ i n m (x : AdicCompletion (IsLocalRing.maximalIdeal B) B) b, n + i ≤ m →
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ m) b =
        AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) m x →
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) n (C i x) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n) (c i b) := by
    intro i n m x b h hb
    show AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) n
      (AdicCompletion.mk (IsLocalRing.maximalIdeal R) R (seq i x)) = _
    rw [AdicCompletion.evalₐ_mk]
    show Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n) (c i (L x (n + i))) = _
    rw [Ideal.Quotient.eq]
    exact star i n (n + i) m x _ _ le_rfl h (hL x _) hb
  have Cadd : ∀ i x y, C i (x + y) = C i x + C i y := by
    intro i x y
    apply AdicCompletion.ext_evalₐ
    intro n
    have hxy : Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + i)) (L x (n + i) + L y (n + i)) =
        AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) (n + i) (x + y) := by
      rw [map_add, map_add, hL, hL]
    rw [map_add, hC i n (n + i) x (L x (n + i)) le_rfl (hL x _),
      hC i n (n + i) y (L y (n + i)) le_rfl (hL y _),
      hC i n (n + i) (x + y) _ le_rfl hxy, map_add, map_add]
  have Czero : ∀ i, C i 0 = 0 := by
    intro i
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [map_zero, hC i n (n + i) 0 0 le_rfl (by rw [map_zero, map_zero]), map_zero, map_zero]
  have C1 : ∀ i, C i 1 = if i = 0 then 1 else 0 := by
    intro i
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hC i n (n + i) 1 1 le_rfl (by rw [map_one, map_one])]
    rcases i with _ | i
    · rw [if_pos rfl, hc01, map_one, map_one]
    · rw [if_neg (by omega), hc1s, map_zero, map_zero]
  let Θ : AdicCompletion (IsLocalRing.maximalIdeal B) B →+*
      PowerSeries (AdicCompletion (IsLocalRing.maximalIdeal R) R) :=
    { toFun := fun x => PowerSeries.mk (fun i => C i x)
      map_one' := by
        refine PowerSeries.ext fun i => ?_
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_one, C1]
      map_mul' := fun x y => by
        refine PowerSeries.ext fun k => ?_
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_mul]
        simp only [PowerSeries.coeff_mk]
        apply AdicCompletion.ext_evalₐ
        intro n
        have hxy : Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ (n + k))
            (L x (n + k) * L y (n + k)) =
            AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) (n + k) (x * y) := by
          rw [map_mul, map_mul, hL, hL]
        rw [hC k n (n + k) (x * y) _ le_rfl hxy, H6, map_sum, map_sum,
          Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
        refine Finset.sum_congr rfl (fun p hp => ?_)
        have hp' := Finset.mem_range.mp hp
        dsimp only
        rw [map_mul, map_mul, hC p n (n + k) x _ (by omega) (hL x _),
          hC (k - p) n (n + k) y _ (by omega) (hL y _)]
      map_zero' := by
        refine PowerSeries.ext fun i => ?_
        rw [PowerSeries.coeff_mk, Czero, map_zero]
      map_add' := fun x y => by
        refine PowerSeries.ext fun i => ?_
        rw [PowerSeries.coeff_mk, Cadd, map_add, PowerSeries.coeff_mk, PowerSeries.coeff_mk] }
  have Θapply : ∀ x i, PowerSeries.coeff i (Θ x) = C i x := fun x i => PowerSeries.coeff_mk i (fun i => C i x)
  have inj : Function.Injective Θ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    have hCx : ∀ i, C i x = 0 := fun i => by rw [← Θapply, hx, map_zero]
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_zero, ← hL x k, Ideal.Quotient.eq_zero_iff_mem]
    apply detect
    intro i hi
    have := hC i (k - i) k x (L x k) (by omega) (hL x k)
    rw [hCx, map_zero] at this
    exact Ideal.Quotient.eq_zero_iff_mem.mp this.symm
  have surj : Function.Surjective Θ := by
    intro F
    choose a ha using fun (i j : ℕ) => Ideal.Quotient.mk_surjective
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) j (PowerSeries.coeff i F))
    have compat : ∀ i j j', j ≤ j' → a i j' - a i j ∈ IsLocalRing.maximalIdeal R ^ j := by
      intro i j j' h
      exact Ideal.Quotient.eq.mp ((lvl _ _ _ j j' h (ha i j')).trans (ha i j).symm)
    let s : ℕ → B := fun k => ∑ i ∈ Finset.range k, φ (a i (k - i)) * z ^ i
    have hs : ∀ k, s k ≡ s (k + 1) [SMOD (IsLocalRing.maximalIdeal B ^ k • (⊤ : Submodule B B))] := by
      intro k
      rw [SModEq.sub_mem]
      have hsk : s k - s (k + 1) = ∑ i ∈ Finset.range k, φ (a i (k - i) - a i (k + 1 - i)) * z ^ i -
          φ (a k (k + 1 - k)) * z ^ k := by
        simp only [s, Finset.sum_range_succ, map_sub, sub_mul, Finset.sum_sub_distrib]
        ring
      have hmem : s k - s (k + 1) ∈ IsLocalRing.maximalIdeal B ^ k := by
        rw [hsk]
        refine Ideal.sub_mem _ (Ideal.sum_mem _ fun i hi => ?_)
          (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow P1 k))
        have hi' := Finset.mem_range.mp hi
        apply term k i _ hi'.le
        have := compat i (k - i) (k + 1 - i) (by omega)
        rw [← neg_sub]
        exact (Ideal.neg_mem_iff _).mpr this
      simpa using hmem
    let x : AdicCompletion (IsLocalRing.maximalIdeal B) B :=
      AdicCompletion.mk (IsLocalRing.maximalIdeal B) B
        (AdicCompletion.AdicCauchySequence.mk (IsLocalRing.maximalIdeal B) B s hs)
    have hx : ∀ k, Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ k) (s k) =
        AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) k x := by
      intro k
      rw [AdicCompletion.evalₐ_mk]; rfl
    refine ⟨x, ?_⟩
    refine PowerSeries.ext fun i => ?_
    rw [Θapply]
    apply AdicCompletion.ext_evalₐ
    intro n
    rcases n with _ | n
    · exact quot0 _ _ _
    · rw [hC i (n + 1) (n + 1 + i) x (s (n + 1 + i)) le_rfl (hx _), ← ha i (n + 1)]
      congr 1
      simp only [s, map_sum, P4]
      rw [Finset.sum_ite_eq, if_pos (Finset.mem_range.mpr (by omega)), Nat.add_sub_cancel]
  have algB : ∀ m b, Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ m) b =
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) m
        (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) b) := by
    intro m b
    rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]; rfl
  have algR : ∀ n r, AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) n
      (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) r) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ n) r := by
    intro n r
    rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]; rfl
  refine ⟨RingEquiv.ofBijective Θ ⟨inj, surj⟩, ?_, ?_⟩
  · apply RingHom.ext
    intro r
    show Θ (algebraMap B _ (φ r)) = PowerSeries.C (algebraMap R _ r)
    refine PowerSeries.ext fun i => ?_
    rw [Θapply, PowerSeries.coeff_C]
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hC i n (n + i) _ (φ r) le_rfl (algB _ _)]
    rcases i with _ | i
    · rw [if_pos rfl, H4, algR]
    · rw [if_neg (by omega), H5, map_zero, map_zero]
  · show Θ (algebraMap B _ z) = PowerSeries.X
    refine PowerSeries.ext fun i => ?_
    rw [Θapply, PowerSeries.coeff_X]
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hC i n (n + i) _ z le_rfl (algB _ _)]
    rcases i with _ | _ | i
    · rw [if_neg (by omega), ← mul_one z, H2, map_zero, map_zero]
    · rw [if_pos rfl, ← mul_one z, H3, hc01, map_one, map_one]
    · rw [if_neg (by omega), ← mul_one z, H3, hc1s, map_zero, map_zero]

theorem wcpa_dj_ldx_ncs_smooth_completion : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (σ : Spec (.of R) ⟶ Z), IsSeparated u → σ ≫ u = 𝟙 _ → (∃ W : Z.Opens, σ (IsLocalRing.closedPoint R) ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ u)) → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (σ (IsLocalRing.closedPoint R)))) (Z.presheaf.stalk (σ (IsLocalRing.closedPoint R))) ≃+* PowerSeries R, e.toRingHom.comp ((algebraMap (Z.presheaf.stalk (σ (IsLocalRing.closedPoint R))) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (σ (IsLocalRing.closedPoint R)))) (Z.presheaf.stalk (σ (IsLocalRing.closedPoint R))))).comp ((Z.presheaf.germ ⊤ (σ (IsLocalRing.closedPoint R)) trivial).hom.comp (wcCnSigma u ⊤))) = PowerSeries.C :=
by
  intro R _ _ _ hcomp Z u σ hsep hσu hsm
  classical

  have s7 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (φ : A →+* B) (ρ : R →+* A)
      (e₀ : AdicCompletion (IsLocalRing.maximalIdeal B) B ≃+*
        PowerSeries (AdicCompletion (IsLocalRing.maximalIdeal A) A))
      (θ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* R),
      e₀.toRingHom.comp ((algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp φ) =
        PowerSeries.C.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) →
      (∀ r : R, θ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (ρ r)) = r) →
      ∃ e : AdicCompletion (IsLocalRing.maximalIdeal B) B ≃+* PowerSeries R,
        e.toRingHom.comp ((algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp
          (φ.comp ρ)) = PowerSeries.C := by
    intro A B _ _ _ _ φ ρ e₀ θ he₀ hθ
    have h1 : (PowerSeries.map θ.toRingHom).comp (PowerSeries.map θ.symm.toRingHom) =
        RingHom.id _ := by
      apply RingHom.ext
      intro f
      ext n
      simp [PowerSeries.coeff_map]
    have h2 : (PowerSeries.map θ.symm.toRingHom).comp (PowerSeries.map θ.toRingHom) =
        RingHom.id _ := by
      apply RingHom.ext
      intro f
      ext n
      simp [PowerSeries.coeff_map]
    let Θ := RingEquiv.ofRingHom (PowerSeries.map θ.toRingHom) (PowerSeries.map θ.symm.toRingHom)
      h1 h2
    refine ⟨e₀.trans Θ, ?_⟩
    refine RingHom.ext fun r => ?_
    show Θ (e₀ (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ (ρ r)))) =
      PowerSeries.C r
    have h3 : e₀ (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ (ρ r))) =
        PowerSeries.C (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (ρ r)) :=
      RingHom.congr_fun he₀ (ρ r)
    rw [h3]
    show PowerSeries.map θ.toRingHom
      (PowerSeries.C (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (ρ r))) =
      PowerSeries.C r
    rw [PowerSeries.map_C]
    congr 1
    exact hθ r

  have s8 : ∀ (A B : Type u) [CommRing A] [CommRing B] (φ : A →+* B) (ψ : B →+* A) (z : B),
      ψ.comp φ = RingHom.id A → RingHom.ker ψ = Ideal.span {z} →
      ringKrullDim B ≠ ringKrullDim A → z ≠ 0 := by
    intro A B _ _ φ ψ z hψφ hker hne h0
    rw [h0, Ideal.span_singleton_eq_bot.mpr rfl] at hker
    have hinj : Function.Injective ψ := (RingHom.injective_iff_ker_eq_bot ψ).mpr hker
    have hsurj : Function.Surjective ψ := fun a =>
      ⟨φ a, by rw [← RingHom.comp_apply, hψφ]; rfl⟩
    exact hne (ringKrullDim_eq_of_ringEquiv (RingEquiv.ofBijective ψ ⟨hinj, hsurj⟩))

  have hsmod : ∀ {T : Type u} [CommRing T] (I : Ideal T) (n : ℕ) (x y : T),
      (x ≡ y [SMOD I ^ n • (⊤ : Submodule T T)]) ↔ x - y ∈ I ^ n := by
    intro T _ I n x y
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
  have s2 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (ρ : R →+* A), Function.Bijective ρ →
      ringKrullDim A = 1 ∧
      (∀ ϖ : R, Irreducible ϖ → Ideal.span {ρ ϖ} = IsLocalRing.maximalIdeal A) ∧
      ∃ θ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* R,
        ∀ r : R, θ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (ρ r)) = r := by
    intro A _ _ ρ hbij
    let E : R ≃+* A := RingEquiv.ofBijective ρ hbij
    have hmax : Ideal.map E (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv E)
    have hmem : ∀ (n : ℕ) (y : A),
        y ∈ IsLocalRing.maximalIdeal A ^ n ↔ E.symm y ∈ IsLocalRing.maximalIdeal R ^ n := by
      intro n y
      rw [← hmax, ← Ideal.map_pow, Ideal.symm_apply_mem_of_equiv_iff]
    refine ⟨(ringKrullDim_eq_of_ringEquiv E).symm.trans
      (IsDiscreteValuationRing.ringKrullDim_eq_one R), ?_, ?_⟩
    · intro ϖ hϖ
      rw [← hmax, hϖ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
      rfl
    · have h1 : IsHausdorff (IsLocalRing.maximalIdeal A) A := ⟨fun y hy => by
        have h0 : E.symm y = 0 := by
          refine IsHausdorff.haus' (I := IsLocalRing.maximalIdeal R) (E.symm y) (fun n => ?_)
          apply (hsmod _ _ _ _).mpr
          rw [sub_zero]
          have h := (hsmod _ _ _ _).mp (hy n)
          rw [sub_zero] at h
          exact (hmem n y).mp h
        have h2 := congrArg E h0
        rwa [RingEquiv.apply_symm_apply, map_zero] at h2⟩
      have h2 : IsPrecomplete (IsLocalRing.maximalIdeal A) A := ⟨fun f hf => by
        obtain ⟨L, hL⟩ := IsPrecomplete.prec' (I := IsLocalRing.maximalIdeal R)
          (fun n => E.symm (f n)) (fun {m n} hmn => by
            have h := (hsmod _ _ _ _).mp (hf hmn)
            apply (hsmod _ _ _ _).mpr
            rw [← map_sub]
            exact (hmem m _).mp h)
        refine ⟨E L, fun n => ?_⟩
        apply (hsmod _ _ _ _).mpr
        rw [hmem, map_sub, RingEquiv.symm_apply_apply]
        exact (hsmod _ _ _ _).mp (hL n)⟩
      haveI hc : IsAdicComplete (IsLocalRing.maximalIdeal A) A :=
        { toIsHausdorff := h1, toIsPrecomplete := h2 }
      have hω : ∀ a : A, (AdicCompletion.ofAlgEquiv (IsLocalRing.maximalIdeal A)).symm
          (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) = a := by
        intro a
        rw [← (AdicCompletion.ofAlgEquiv (IsLocalRing.maximalIdeal A)).commutes a,
          AlgEquiv.symm_apply_apply]
        rfl
      refine ⟨(AdicCompletion.ofAlgEquiv (IsLocalRing.maximalIdeal A)).symm.toRingEquiv.trans
        E.symm, fun r => ?_⟩
      show E.symm ((AdicCompletion.ofAlgEquiv (IsLocalRing.maximalIdeal A)).symm
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (ρ r))) = r
      rw [hω]
      exact E.symm_apply_apply r

  have hxg : ∀ p : Spec (.of R), u (σ p) = p := by
    intro p
    have h := Scheme.Hom.comp_apply σ u p
    rw [hσu] at h
    rw [← h]
    rfl
  have hx : u (σ (IsLocalRing.closedPoint R)) = IsLocalRing.closedPoint R := hxg _

  have hbij : Function.Bijective
      (((Spec (.of R)).presheaf.germ ⊤ (u (σ (IsLocalRing.closedPoint R))) trivial).hom.comp
        (Scheme.ΓSpecIso (.of R)).inv.hom) := by
    have key : ∀ x : Spec (.of R), x = IsLocalRing.closedPoint R → Function.Bijective
        (((Spec (.of R)).presheaf.germ ⊤ x trivial).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom) := by
      rintro x rfl
      have h1 : (Spec (.of R)).presheaf.germ ⊤ (IsLocalRing.closedPoint R) trivial =
          (Scheme.ΓSpecIso (.of R)).hom ≫ (stalkClosedPointIso (.of R)).inv := by
        rw [← germ_stalkClosedPointIso_hom, Category.assoc, Iso.hom_inv_id, Category.comp_id]
      rw [← CommRingCat.hom_comp, h1, Iso.inv_hom_id_assoc]
      exact ConcreteCategory.bijective_of_isIso _
    exact key _ hx
  obtain ⟨hdimA, hunif, θ, hθ⟩ := s2 _ _ hbij

  have hs0 : ∀ z : Z, (Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤) =
      (u.stalkMap z).hom.comp
        (((Spec (.of R)).presheaf.germ ⊤ (u z) trivial).hom.comp
          (Scheme.ΓSpecIso (.of R)).inv.hom) := by
    intro z
    ext r
    simp only [wcCnSigma, RingHom.comp_apply]
    have e1 := TopCat.Presheaf.germ_res_apply Z.presheaf
      (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)) z trivial
      (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r))
    have e2 := Scheme.Hom.germ_stalkMap_apply u ⊤ z trivial
      ((Scheme.ΓSpecIso (.of R)).inv.hom r)
    exact e1.trans e2.symm

  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hspan : Ideal.span (Set.range (fun _ : Fin 1 =>
      (((Spec (.of R)).presheaf.germ ⊤ (u (σ (IsLocalRing.closedPoint R))) trivial).hom.comp
        (Scheme.ΓSpecIso (.of R)).inv.hom) ϖ)) =
      IsLocalRing.maximalIdeal ((Spec (.of R)).presheaf.stalk (u (σ (IsLocalRing.closedPoint R)))) := by
    rw [Set.range_const]
    exact hunif ϖ hϖ
  have hdim1 : ((1 : ℕ) : WithBot ℕ∞) =
      ringKrullDim ((Spec (.of R)).presheaf.stalk (u (σ (IsLocalRing.closedPoint R)))) := by
    rw [hdimA]
    exact Nat.cast_one

  obtain ⟨hreg, ψ, zz, hψφ, hker, -, hdimB, -⟩ :=
    wcpa_dj_stc_kms_section_local (Spec (.of R)) Z u σ (IsLocalRing.closedPoint R) 1 _ hsep hσu
      hsm inferInstance hdim1 hspan
  haveI := hreg
  haveI : IsDomain (Z.presheaf.stalk (σ (IsLocalRing.closedPoint R))) :=
    wcpa_regular_isDomain _ wcpa_rs_quotient_regular hreg
  have hne : ringKrullDim (Z.presheaf.stalk (σ (IsLocalRing.closedPoint R))) ≠
      ringKrullDim ((Spec (.of R)).presheaf.stalk (u (σ (IsLocalRing.closedPoint R)))) := by
    rw [← hdimB, hdimA]
    exact_mod_cast (by decide : (1 + 1 : ℕ) ≠ 1)
  have hzz := s8 _ _ _ ψ zz hψφ hker hne
  obtain ⟨c, h1, h2, h3, h4, h5, h6, h7⟩ := wcpa_dj_stc_kms_coeff_maps _ _ _ ψ zz hψφ hker hzz
  obtain ⟨e₀, he₀, -⟩ := wcpa_dj_stc_kms_completion_iso _ _ _ ψ zz c hψφ hker h1 h2 h3 h4 h5 h6 h7
  obtain ⟨e, he⟩ := s7 _ _ _ _ e₀ θ he₀ hθ
  refine ⟨e, ?_⟩
  exact (congrArg (fun f => e.toRingHom.comp
    ((algebraMap (Z.presheaf.stalk (σ (IsLocalRing.closedPoint R)))
      (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (σ (IsLocalRing.closedPoint R))))
        (Z.presheaf.stalk (σ (IsLocalRing.closedPoint R))))).comp f)) (hs0 _)).trans he

theorem wcpa_dj_nd_fibre_completion_bridge : ∀ (A R : Type u) [CommRing A] [CommRing R] [IsLocalRing A] [IsLocalRing R] [IsNoetherianRing R] (φ : A →+* R), (∃ ε : AdicCompletion ((IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map φ))) (R ⧸ (IsLocalRing.maximalIdeal A).map φ) ≃+* (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField A) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), ε.toRingHom.comp ((algebraMap (R ⧸ (IsLocalRing.maximalIdeal A).map φ) (AdicCompletion ((IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map φ))) (R ⧸ (IsLocalRing.maximalIdeal A).map φ))).comp ((Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map φ)).comp φ)) = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (IsLocalRing.residue A))) → ∃ π : AdicCompletion (IsLocalRing.maximalIdeal R) R →+* (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField A) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), Function.Surjective π ∧ RingHom.ker π = (IsLocalRing.maximalIdeal A).map ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) ∧ π.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (IsLocalRing.residue A)) :=
by
  intro A R _ _ _ _ _ φ hεex
  classical
  obtain ⟨ε, hε⟩ := hεex

  have hbne : (IsLocalRing.maximalIdeal A).map φ ≠ ⊤ := by
    intro htop
    have h1 : (1 : R ⧸ (IsLocalRing.maximalIdeal A).map φ) = 0 := by
      rw [← map_one (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map φ)),
        Ideal.Quotient.eq_zero_iff_mem, htop]
      trivial
    have h2 := congrArg (fun x => ε (algebraMap (R ⧸ (IsLocalRing.maximalIdeal A).map φ)
      (AdicCompletion ((IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk
        ((IsLocalRing.maximalIdeal A).map φ))) (R ⧸ (IsLocalRing.maximalIdeal A).map φ)) x)) h1
    simp only [map_one, map_zero] at h2
    rw [← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq_zero_iff_mem] at h2
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h2
    have hcc := congrArg MvPowerSeries.constantCoeff hc
    simp at hcc

  haveI : Nontrivial (R ⧸ (IsLocalRing.maximalIdeal A).map φ) := Ideal.Quotient.nontrivial_iff.mpr hbne
  haveI : IsLocalRing (R ⧸ (IsLocalRing.maximalIdeal A).map φ) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have hble : (IsLocalRing.maximalIdeal A).map φ ≤ IsLocalRing.maximalIdeal R :=
    IsLocalRing.le_maximalIdeal hbne
  have hI : (IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map φ)) =
      IsLocalRing.maximalIdeal (R ⧸ (IsLocalRing.maximalIdeal A).map φ) := by
    haveI := IsLocalRing.maximalIdeal.isMaximal R
    have hmax : ((IsLocalRing.maximalIdeal R).map
        (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map φ))).IsMaximal :=
      Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hble)
    exact IsLocalRing.eq_maximalIdeal hmax

  have htrans : ∀ (I J : Ideal (R ⧸ (IsLocalRing.maximalIdeal A).map φ)), I = J →
      ∃ τ : AdicCompletion J (R ⧸ (IsLocalRing.maximalIdeal A).map φ) ≃+*
        AdicCompletion I (R ⧸ (IsLocalRing.maximalIdeal A).map φ),
      ∀ s : R ⧸ (IsLocalRing.maximalIdeal A).map φ, τ (algebraMap _ _ s) = algebraMap _ _ s := by
    rintro I J rfl
    exact ⟨RingEquiv.refl _, fun _ => rfl⟩
  obtain ⟨τ, hτ⟩ := htrans _ _ hI

  obtain ⟨Ψ₀⟩ := wc_hnas_pfc_completion_surj_base_change R (R ⧸ (IsLocalRing.maximalIdeal A).map φ)
    (by rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective)

  let q := Algebra.TensorProduct.quotIdealMapEquivTensorQuot
    (AdicCompletion (IsLocalRing.maximalIdeal R) R) ((IsLocalRing.maximalIdeal A).map φ)
  let c := Algebra.TensorProduct.comm R (AdicCompletion (IsLocalRing.maximalIdeal R) R)
    (R ⧸ (IsLocalRing.maximalIdeal A).map φ)
  let θ : AdicCompletion (IsLocalRing.maximalIdeal R) R →+*
      TensorProduct R (R ⧸ (IsLocalRing.maximalIdeal A).map φ)
        (AdicCompletion (IsLocalRing.maximalIdeal R) R) :=
    (c.toRingEquiv.toRingHom.comp q.toRingEquiv.toRingHom).comp (Ideal.Quotient.mk _)
  have hθ : ∀ x, θ x = (1 : R ⧸ (IsLocalRing.maximalIdeal A).map φ) ⊗ₜ x := by
    intro x
    show c (q (Ideal.Quotient.mk _ x)) = _
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk, Algebra.TensorProduct.comm_tmul]
  have hθs : Function.Surjective θ :=
    c.surjective.comp (q.surjective.comp Ideal.Quotient.mk_surjective)
  refine ⟨ε.toRingHom.comp (τ.toRingHom.comp (Ψ₀.toRingEquiv.toRingHom.comp θ)),
    ε.surjective.comp (τ.surjective.comp (Ψ₀.surjective.comp hθs)), ?_, ?_⟩
  · ext x
    rw [RingHom.mem_ker, ← Ideal.map_map]
    show ε (τ (Ψ₀ (c (q (Ideal.Quotient.mk _ x))))) = 0 ↔ _
    simp only [EmbeddingLike.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]
  · ext a
    show ε (τ (Ψ₀ (θ (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) (φ a))))) = _
    rw [hθ, ← Algebra.TensorProduct.tmul_one_eq_one_tmul]
    have e1 : (algebraMap R (R ⧸ (IsLocalRing.maximalIdeal A).map φ) (φ a)) ⊗ₜ[R]
        (1 : AdicCompletion (IsLocalRing.maximalIdeal R) R) =
        algebraMap (R ⧸ (IsLocalRing.maximalIdeal A).map φ)
          (TensorProduct R (R ⧸ (IsLocalRing.maximalIdeal A).map φ)
            (AdicCompletion (IsLocalRing.maximalIdeal R) R))
          (Ideal.Quotient.mk _ (φ a)) := by
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self_apply,
        Ideal.Quotient.algebraMap_eq]
    rw [e1, AlgEquiv.commutes, hτ]
    exact RingHom.congr_fun hε a

theorem wcpa_dj_nd_lift_node : ∀ (S B T : Type u) [CommRing S] [CommRing B] [CommRing T] [IsLocalRing B] [IsNoetherianRing B] [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (I : Ideal S) [IsAdicComplete I S] (ι : S →+* B) (π : B →+* T) (x y : T), Function.Surjective π → RingHom.ker π = I.map ι → I.map ι ≤ IsLocalRing.maximalIdeal B → x * y = 0 → (∀ t : T, ∃ (s : S) (t₁ t₂ : T), t = π (ι s) + x * t₁ + y * t₂) → ∃ (u v : B) (h : S), u * v = ι h ∧ π u = x ∧ π v = y :=
by
  intro S B T _ _ _ _ _ _ I _ ι π x y hsurj hker hle hxy hD
  classical

  have F1 : ∀ n : ℕ, (I ^ n).map ι ≤ IsLocalRing.maximalIdeal B ^ n := by
    intro n
    rw [Ideal.map_pow]
    exact Ideal.pow_right_mono hle n

  have F3 : ∀ k : ℕ, (I ^ (k + 1)).map ι ≤ RingHom.ker π := by
    intro k
    rw [hker]
    apply Ideal.map_mono
    calc I ^ (k + 1) ≤ I ^ 1 := Ideal.pow_le_pow_right (by omega)
      _ = I := pow_one I

  have F4 : ∀ k : ℕ, (I ^ (k + 1)).map ι * (I ^ (k + 1)).map ι ≤ (I ^ (k + 1 + 1)).map ι := by
    intro k
    rw [← Ideal.map_mul, ← pow_add]
    exact Ideal.map_mono (Ideal.pow_le_pow_right (by omega))

  have absorb : ∀ (u v : B), π u = x → π v = y → ∀ n : ℕ, ∀ δ ∈ (I ^ n).map ι,
      ∃ (a : S) (p q : B), a ∈ I ^ n ∧ p ∈ (I ^ n).map ι ∧ q ∈ (I ^ n).map ι ∧
        δ - ι a - u * p - v * q ∈ (I ^ (n + 1)).map ι := by
    intro u v hu hv n δ hδ
    change δ ∈ Submodule.span B (ι '' ((I ^ n : Ideal S) : Set S)) at hδ
    induction hδ using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨f, hf, rfl⟩ := hz
      exact ⟨f, 0, 0, hf, zero_mem _, zero_mem _, by simp⟩
    | zero => exact ⟨0, 0, 0, zero_mem _, zero_mem _, zero_mem _, by simp⟩
    | add z w _ _ hz hw =>
      obtain ⟨a₁, p₁, q₁, ha₁, hp₁, hq₁, hr₁⟩ := hz
      obtain ⟨a₂, p₂, q₂, ha₂, hp₂, hq₂, hr₂⟩ := hw
      refine ⟨a₁ + a₂, p₁ + p₂, q₁ + q₂, add_mem ha₁ ha₂, add_mem hp₁ hp₂, add_mem hq₁ hq₂, ?_⟩
      have hsum := add_mem hr₁ hr₂
      convert hsum using 1
      rw [map_add]; ring
    | smul b z _ hz =>
      obtain ⟨a, p, q, ha, hp, hq, hr⟩ := hz
      obtain ⟨s, t₁, t₂, hst⟩ := hD (π b)
      obtain ⟨b₁, rfl⟩ := hsurj t₁
      obtain ⟨b₂, rfl⟩ := hsurj t₂
      have he : b - ι s - u * b₁ - v * b₂ ∈ I.map ι := by
        rw [← hker, RingHom.mem_ker, map_sub, map_sub, map_sub, map_mul, map_mul, hu, hv, hst]
        ring
      have hιa : ι a ∈ (I ^ n).map ι := Ideal.mem_map_of_mem ι ha
      refine ⟨s * a, b * p + b₁ * ι a, b * q + b₂ * ι a, Ideal.mul_mem_left _ _ ha,
        add_mem (Ideal.mul_mem_left _ _ hp) (Ideal.mul_mem_left _ _ hιa),
        add_mem (Ideal.mul_mem_left _ _ hq) (Ideal.mul_mem_left _ _ hιa), ?_⟩
      have h2 : (b - ι s - u * b₁ - v * b₂) * ι a ∈ (I ^ (n + 1)).map ι := by
        rw [pow_succ', Ideal.map_mul]
        exact Ideal.mul_mem_mul he hιa
      have hsum := add_mem (Ideal.mul_mem_left _ b hr) h2
      convert hsum using 1
      rw [smul_eq_mul, map_mul]; ring

  have step : ∀ (k : ℕ) (w : B × B × S),
      (π w.1 = x ∧ π w.2.1 = y ∧ w.1 * w.2.1 - ι w.2.2 ∈ (I ^ (k + 1)).map ι) →
      ∃ w' : B × B × S,
        (π w'.1 = x ∧ π w'.2.1 = y ∧ w'.1 * w'.2.1 - ι w'.2.2 ∈ (I ^ (k + 1 + 1)).map ι) ∧
        (w'.1 - w.1 ∈ (I ^ (k + 1)).map ι ∧ w'.2.1 - w.2.1 ∈ (I ^ (k + 1)).map ι ∧
          w'.2.2 - w.2.2 ∈ I ^ (k + 1)) := by
    rintro k ⟨u, v, h⟩ ⟨hu, hv, hδ⟩
    obtain ⟨a, p, q, ha, hp, hq, hr⟩ := absorb u v hu hv (k + 1) _ hδ
    refine ⟨(u - q, v - p, h + a), ⟨?_, ?_, ?_⟩, ?_, ?_, ?_⟩
    · show π (u - q) = x
      rw [map_sub, hu, (RingHom.mem_ker).mp (F3 k hq), sub_zero]
    · show π (v - p) = y
      rw [map_sub, hv, (RingHom.mem_ker).mp (F3 k hp), sub_zero]
    · show (u - q) * (v - p) - ι (h + a) ∈ (I ^ (k + 1 + 1)).map ι
      have h1 : p * q ∈ (I ^ (k + 1 + 1)).map ι := F4 k (Ideal.mul_mem_mul hp hq)
      have hsum := add_mem hr h1
      convert hsum using 1
      rw [map_add]; ring
    · show u - q - u ∈ (I ^ (k + 1)).map ι
      have hn := neg_mem hq
      convert hn using 1; ring
    · show v - p - v ∈ (I ^ (k + 1)).map ι
      have hn := neg_mem hp
      convert hn using 1; ring
    · show h + a - h ∈ I ^ (k + 1)
      convert ha using 1; ring

  obtain ⟨u₀, hu₀⟩ := hsurj x
  obtain ⟨v₀, hv₀⟩ := hsurj y
  have hbase : π u₀ = x ∧ π v₀ = y ∧ u₀ * v₀ - ι 0 ∈ (I ^ (0 + 1)).map ι := by
    refine ⟨hu₀, hv₀, ?_⟩
    rw [zero_add, pow_one, ← hker, RingHom.mem_ker, map_sub, map_mul, hu₀, hv₀, hxy, map_zero,
      map_zero, sub_zero]
  choose! nxt hnxtP hnxtQ using step
  let f : ℕ → B × B × S := fun k => Nat.rec (u₀, v₀, (0 : S)) (fun k w => nxt k w) k
  have hf0 : f 0 = (u₀, v₀, 0) := rfl
  have hfs : ∀ k, f (k + 1) = nxt k (f k) := fun k => rfl
  have hfP : ∀ k : ℕ, π (f k).1 = x ∧ π (f k).2.1 = y ∧
      (f k).1 * (f k).2.1 - ι (f k).2.2 ∈ (I ^ (k + 1)).map ι := by
    intro k
    induction k with
    | zero => rw [hf0]; exact hbase
    | succ k ih => rw [hfs]; exact hnxtP k (f k) ih
  have hfQ : ∀ k : ℕ, (f (k + 1)).1 - (f k).1 ∈ (I ^ (k + 1)).map ι ∧
      (f (k + 1)).2.1 - (f k).2.1 ∈ (I ^ (k + 1)).map ι ∧
      (f (k + 1)).2.2 - (f k).2.2 ∈ I ^ (k + 1) := by
    intro k
    rw [hfs]
    exact hnxtQ k (f k) (hfP k)

  have cauchy : ∀ (R : Type u) [CommRing R] (J : Ideal R) [IsPrecomplete J R] (g : ℕ → R),
      (∀ k, g (k + 1) - g k ∈ J ^ k) → ∃ L : R, ∀ k, g k - L ∈ J ^ k := by
    intro R _ J hJ g hg
    have tele : ∀ m n : ℕ, m ≤ n → g n - g m ∈ J ^ m := by
      intro m n hmn
      induction n, hmn using Nat.le_induction with
      | base => simp
      | succ n hmn ih =>
        have h1 : g (n + 1) - g n ∈ J ^ m := Ideal.pow_le_pow_right hmn (hg n)
        have hsum := add_mem h1 ih
        convert hsum using 1; ring
    have conv : ∀ (n : ℕ) (a b : R), a ≡ b [SMOD (J ^ n • ⊤ : Submodule R R)] ↔ a - b ∈ J ^ n := by
      intro n a b
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
    obtain ⟨L, hL⟩ := IsPrecomplete.prec hJ (f := g) (fun {m n} hmn => by
      rw [conv]
      have hn := neg_mem (tele m n hmn)
      convert hn using 1; ring)
    exact ⟨L, fun k => (conv k _ _).mp (hL k)⟩

  have hBc1 : ∀ k, (f (k + 1)).1 - (f k).1 ∈ IsLocalRing.maximalIdeal B ^ k := fun k =>
    Ideal.pow_le_pow_right (Nat.le_succ k) (F1 (k + 1) (hfQ k).1)
  have hBc2 : ∀ k, (f (k + 1)).2.1 - (f k).2.1 ∈ IsLocalRing.maximalIdeal B ^ k := fun k =>
    Ideal.pow_le_pow_right (Nat.le_succ k) (F1 (k + 1) (hfQ k).2.1)
  have hSc : ∀ k, (f (k + 1)).2.2 - (f k).2.2 ∈ I ^ k := fun k =>
    Ideal.pow_le_pow_right (Nat.le_succ k) (hfQ k).2.2
  obtain ⟨uL, huL⟩ := cauchy B (IsLocalRing.maximalIdeal B) (fun k => (f k).1) hBc1
  obtain ⟨vL, hvL⟩ := cauchy B (IsLocalRing.maximalIdeal B) (fun k => (f k).2.1) hBc2
  obtain ⟨hL, hhL⟩ := cauchy S I (fun k => (f k).2.2) hSc

  have hrel : uL * vL - ι hL = 0 := by
    apply IsHausdorff.haus (inferInstance : IsHausdorff (IsLocalRing.maximalIdeal B) B)
    intro n
    rw [SModEq.sub_mem, sub_zero, Ideal.smul_eq_mul, Ideal.mul_top]
    have e1 : (f n).1 - uL ∈ IsLocalRing.maximalIdeal B ^ n := huL n
    have e2 : (f n).2.1 - vL ∈ IsLocalRing.maximalIdeal B ^ n := hvL n
    have e3 : (f n).1 * (f n).2.1 - ι (f n).2.2 ∈ IsLocalRing.maximalIdeal B ^ n :=
      Ideal.pow_le_pow_right (Nat.le_succ n) (F1 (n + 1) (hfP n).2.2)
    have e4 : ι ((f n).2.2 - hL) ∈ IsLocalRing.maximalIdeal B ^ n :=
      F1 n (Ideal.mem_map_of_mem ι (hhL n))
    have hsum := add_mem (add_mem (add_mem (neg_mem (Ideal.mul_mem_right vL _ e1))
      (neg_mem (Ideal.mul_mem_left _ (f n).1 e2))) e3) e4
    convert hsum using 1
    rw [map_sub]; ring

  have krull : ∀ z : B, (∀ n : ℕ, ∃ w ∈ IsLocalRing.maximalIdeal B ^ n, z - w ∈ I.map ι) →
      z ∈ I.map ι := by
    intro z hz
    have hKne : I.map ι ≠ ⊤ := fun h =>
      (IsLocalRing.maximalIdeal.isMaximal B).ne_top (top_le_iff.mp (h ▸ hle))
    haveI : Nontrivial (B ⧸ I.map ι) := Ideal.Quotient.nontrivial_iff.mpr hKne
    haveI : IsLocalRing (B ⧸ I.map ι) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk (I.map ι)) Ideal.Quotient.mk_surjective
    have hne : (IsLocalRing.maximalIdeal B).map (Ideal.Quotient.mk (I.map ι)) ≠ ⊤ := by
      intro h
      have h1 : (1 : B ⧸ I.map ι) ∈ (IsLocalRing.maximalIdeal B).map (Ideal.Quotient.mk (I.map ι)) :=
        h ▸ Submodule.mem_top
      obtain ⟨z', hz', hz'1⟩ :=
        (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp h1
      have h2 : z' - 1 ∈ I.map ι := Ideal.Quotient.eq.mp (hz'1.trans (map_one _).symm)
      have h3 : (1 : B) ∈ IsLocalRing.maximalIdeal B := by
        have h4 := Ideal.sub_mem _ hz' (hle h2)
        simpa using h4
      exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
    have hbot := Ideal.iInf_pow_eq_bot_of_isLocalRing _ hne
    have hmem : Ideal.Quotient.mk (I.map ι) z ∈
        ⨅ n : ℕ, ((IsLocalRing.maximalIdeal B).map (Ideal.Quotient.mk (I.map ι))) ^ n := by
      rw [Ideal.mem_iInf]
      intro n
      obtain ⟨w, hw, hzw⟩ := hz n
      have e : Ideal.Quotient.mk (I.map ι) z = Ideal.Quotient.mk (I.map ι) w :=
        Ideal.Quotient.eq.mpr hzw
      rw [e, ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hw
    rw [hbot, Ideal.mem_bot] at hmem
    exact Ideal.Quotient.eq_zero_iff_mem.mp hmem

  have hres : ∀ (W : ℕ → B) (L : B), (∀ k, W k - L ∈ IsLocalRing.maximalIdeal B ^ k) →
      (∀ k, π (W k) = π (W 0)) → π L = π (W 0) := by
    intro W L hWL hW
    have hmem : L - W 0 ∈ I.map ι := krull _ (fun n => ⟨L - W n, by
        have hn := neg_mem (hWL n)
        convert hn using 1; ring, by
        rw [← hker, RingHom.mem_ker, map_sub, map_sub, map_sub, hW n]; ring⟩)
    rw [← hker, RingHom.mem_ker, map_sub, sub_eq_zero] at hmem
    exact hmem
  have hπu : π uL = x := by
    rw [hres (fun k => (f k).1) uL huL (fun k => by rw [(hfP k).1, (hfP 0).1])]
    exact (hfP 0).1
  have hπv : π vL = y := by
    rw [hres (fun k => (f k).2.1) vL hvL (fun k => by rw [(hfP k).2.1, (hfP 0).2.1])]
    exact (hfP 0).2.1
  exact ⟨uL, vL, hL, sub_eq_zero.mp hrel, hπu, hπv⟩

theorem wcpa_dj_nd_mvpowerseries_two_noetherian : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R], IsNoetherianRing (MvPowerSeries (Fin 2) R) :=
by
  intro R _ _
  exact MvPowerSeries.isNoetherianRing R

theorem wcpa_dj_nd_surjective_eval : ∀ (S B : Type u) [CommRing S] [CommRing B] (I : Ideal S) (J : Ideal B) [IsAdicComplete I S] [IsAdicComplete J B] (ι : S →+* B) (Ψ : MvPowerSeries (Fin 2) S →+* B), Ψ.comp MvPowerSeries.C = ι → I.map ι ≤ J → (∀ i, Ψ (MvPowerSeries.X i) ∈ J) → (∀ b : B, ∃ (s : S) (b₁ b₂ : B), b - ι s - Ψ (MvPowerSeries.X 0) * b₁ - Ψ (MvPowerSeries.X 1) * b₂ ∈ I.map ι) → Function.Surjective Ψ :=
by
  intro S B _ _ I J _ _ ι Ψ hΨC hIJ hXJ hdec
  classical
  let M : Ideal (MvPowerSeries (Fin 2) S) :=
    I.map (MvPowerSeries.C : S →+* MvPowerSeries (Fin 2) S) ⊔
      Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1}
  let 𝔞 : Ideal B := M.map Ψ
  let P : ℕ → MvPowerSeries (Fin 2) S → Prop := fun n f =>
    ∀ e : Fin 2 →₀ ℕ, MvPowerSeries.coeff e f ∈ I ^ (n - (e 0 + e 1))
  have hΨCs : ∀ s : S, Ψ (MvPowerSeries.C s) = ι s := fun s => RingHom.congr_fun hΨC s
  have hM_X : ∀ i : Fin 2, (MvPowerSeries.X i : MvPowerSeries (Fin 2) S) ∈ M := by
    intro i
    apply Ideal.mem_sup_right
    apply Ideal.subset_span
    fin_cases i <;> simp
  have h𝔞X : ∀ i : Fin 2, Ψ (MvPowerSeries.X i) ∈ 𝔞 := fun i => Ideal.mem_map_of_mem Ψ (hM_X i)

  have h𝔞J : 𝔞 ≤ J := by
    rw [Ideal.map_le_iff_le_comap]
    apply sup_le
    · rw [Ideal.map_le_iff_le_comap]
      intro s hs
      rw [Ideal.mem_comap, Ideal.mem_comap, hΨCs]
      exact hIJ (Ideal.mem_map_of_mem ι hs)
    · rw [Ideal.span_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact Ideal.mem_comap.mpr (hXJ 0)
      · exact Ideal.mem_comap.mpr (hXJ 1)

  have hI𝔞 : I.map ι ≤ 𝔞 := by
    rw [← hΨC, ← Ideal.map_map]
    exact Ideal.map_mono le_sup_left
  have hs1 : ∀ c : B, ∃ r, c - Ψ r ∈ 𝔞 := by
    intro c
    obtain ⟨s, b₁, b₂, h⟩ := hdec c
    refine ⟨MvPowerSeries.C s, ?_⟩
    rw [hΨCs]
    have e : c - ι s = (c - ι s - Ψ (MvPowerSeries.X 0) * b₁ - Ψ (MvPowerSeries.X 1) * b₂)
        + Ψ (MvPowerSeries.X 0) * b₁ + Ψ (MvPowerSeries.X 1) * b₂ := by ring
    rw [e]
    refine Ideal.add_mem _ (Ideal.add_mem _ (hI𝔞 h) ?_) ?_
    · exact Ideal.mul_mem_right _ _ (h𝔞X 0)
    · exact Ideal.mul_mem_right _ _ (h𝔞X 1)

  have hgr : ∀ n : ℕ, ∀ b ∈ 𝔞 ^ n, ∃ f ∈ M ^ n, b - Ψ f ∈ 𝔞 ^ (n + 1) := by
    intro n
    let T : Ideal B :=
      { carrier := {b | b ∈ 𝔞 ^ n ∧ ∃ f ∈ M ^ n, b - Ψ f ∈ 𝔞 ^ (n + 1)}
        add_mem' := by
          rintro x y ⟨hx, f₁, hf₁, h₁⟩ ⟨hy, f₂, hf₂, h₂⟩
          refine ⟨Ideal.add_mem _ hx hy, f₁ + f₂, Ideal.add_mem _ hf₁ hf₂, ?_⟩
          have e : x + y - Ψ (f₁ + f₂) = (x - Ψ f₁) + (y - Ψ f₂) := by rw [map_add]; ring
          rw [e]
          exact Ideal.add_mem _ h₁ h₂
        zero_mem' := ⟨Ideal.zero_mem _, 0, Ideal.zero_mem _, by simp⟩
        smul_mem' := by
          rintro c x ⟨hx, f, hf, h⟩
          obtain ⟨r, hr⟩ := hs1 c
          refine ⟨Ideal.mul_mem_left _ c hx, r * f, Ideal.mul_mem_left _ r hf, ?_⟩
          have e : c • x - Ψ (r * f) = Ψ r * (x - Ψ f) + (c - Ψ r) * x := by
            rw [smul_eq_mul, map_mul]; ring
          rw [e]
          refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ h) ?_
          rw [pow_succ']
          exact Ideal.mul_mem_mul hr hx }
    have hle : (M ^ n).map Ψ ≤ T := by
      rw [Ideal.map_le_iff_le_comap]
      intro m hm
      refine ⟨?_, m, hm, by simp⟩
      have := Ideal.mem_map_of_mem Ψ hm
      rwa [Ideal.map_pow] at this
    intro b hb
    have hb' : b ∈ (M ^ n).map Ψ := by rw [Ideal.map_pow]; exact hb
    exact (hle hb').2

  have happrox : ∀ b : B, ∃ g : ℕ → MvPowerSeries (Fin 2) S, (∀ k, g k ∈ M ^ k) ∧
      ∀ n, b - Ψ (∑ k ∈ Finset.range n, g k) ∈ 𝔞 ^ n := by
    intro b
    have hF : ∀ (n : ℕ) (x : B), ∃ f : MvPowerSeries (Fin 2) S,
        x ∈ 𝔞 ^ n → f ∈ M ^ n ∧ x - Ψ f ∈ 𝔞 ^ (n + 1) := by
      intro n x
      by_cases hx : x ∈ 𝔞 ^ n
      · obtain ⟨f, hf, h⟩ := hgr n x hx
        exact ⟨f, fun _ => ⟨hf, h⟩⟩
      · exact ⟨0, fun h => absurd h hx⟩
    choose F hF using hF
    let ρ : ℕ → B := fun n => Nat.rec (motive := fun _ => B) b (fun k x => x - Ψ (F k x)) n
    have hρs : ∀ n, ρ (n + 1) = ρ n - Ψ (F n (ρ n)) := fun n => rfl
    have hρmem : ∀ n, ρ n ∈ 𝔞 ^ n := by
      intro n
      induction n with
      | zero => rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      | succ k ih => rw [hρs]; exact (hF k (ρ k) ih).2
    refine ⟨fun k => F k (ρ k), fun k => (hF k (ρ k) (hρmem k)).1, ?_⟩
    have hρsum : ∀ n, ρ n = b - Ψ (∑ k ∈ Finset.range n, F k (ρ k)) := by
      intro n
      induction n with
      | zero => simp [ρ]
      | succ k ih =>
        rw [hρs, Finset.sum_range_succ, map_add, ← sub_sub, ← ih]
    intro n
    rw [← hρsum]
    exact hρmem n

  have hmul : ∀ (a c : ℕ) (f g : MvPowerSeries (Fin 2) S), P a f → P c g → P (a + c) (f * g) := by
    intro a c f g hf hg e
    rw [MvPowerSeries.coeff_mul]
    apply Ideal.sum_mem
    intro p hp
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
    have h1 := Ideal.mul_mem_mul (hf p.1) (hg p.2)
    rw [← pow_add] at h1
    have h0 : p.1 0 + p.2 0 = e 0 := by rw [← hp, Finsupp.add_apply]
    have h1' : p.1 1 + p.2 1 = e 1 := by rw [← hp, Finsupp.add_apply]
    exact Ideal.pow_le_pow_right (by omega) h1
  have hP0 : ∀ f, P 0 f := by
    intro f e
    rw [Nat.zero_sub, pow_zero, Ideal.one_eq_top]
    exact Submodule.mem_top
  let Q : ℕ → Ideal (MvPowerSeries (Fin 2) S) := fun n =>
    { carrier := {f | P n f}
      add_mem' := by
        intro x y hx hy e
        rw [(MvPowerSeries.coeff e).map_add]
        exact Ideal.add_mem _ (hx e) (hy e)
      zero_mem' := by
        intro e
        rw [(MvPowerSeries.coeff e).map_zero]
        exact Ideal.zero_mem _
      smul_mem' := by
        intro c x hx
        have := hmul 0 n c x (hP0 c) hx
        rw [zero_add] at this
        exact this }
  have hMQ1 : M ≤ Q 1 := by
    apply sup_le
    · rw [Ideal.map_le_iff_le_comap]
      intro s hs e
      rw [MvPowerSeries.coeff_C]
      split_ifs with h
      · subst h
        simpa using hs
      · exact Ideal.zero_mem _
    · rw [Ideal.span_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · intro e
        rw [MvPowerSeries.coeff_X]
        split_ifs with h
        · subst h
          simp
        · exact Ideal.zero_mem _
      · intro e
        rw [MvPowerSeries.coeff_X]
        split_ifs with h
        · subst h
          simp
        · exact Ideal.zero_mem _
  have hMnQ : ∀ n, M ^ n ≤ Q n := by
    intro n
    induction n with
    | zero =>
      intro f _
      exact hP0 f
    | succ n ih =>
      rw [pow_succ, Ideal.mul_le]
      intro f hf g hg
      exact hmul n 1 f g (ih hf) (hMQ1 hg)

  have hscal : ∀ (c : ℕ → S) (d : ℕ), (∀ k, c k ∈ I ^ (k - d)) →
      ∃ L : S, ∀ n, L - ∑ k ∈ Finset.range n, c k ∈ I ^ (n - d) := by
    intro c d hc
    obtain ⟨L, hL⟩ := IsPrecomplete.prec' (I := I) (fun m => ∑ k ∈ Finset.range (m + d), c k) (by
      intro m m' hmm'
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top, ← neg_sub, neg_mem_iff,
        ← Finset.sum_Ico_eq_sub _ (by omega)]
      apply Ideal.sum_mem
      intro k hk
      rw [Finset.mem_Ico] at hk
      exact Ideal.pow_le_pow_right (by omega) (hc k))
    refine ⟨L, fun n => ?_⟩
    by_cases hn : d ≤ n
    · have := hL (n - d)
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top, Nat.sub_add_cancel hn] at this
      rw [← neg_sub]
      exact neg_mem this
    · rw [Nat.sub_eq_zero_of_le (by omega), pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
  have hseries : ∀ g : ℕ → MvPowerSeries (Fin 2) S, (∀ k, P k (g k)) →
      ∃ G : MvPowerSeries (Fin 2) S, ∀ n, P n (G - ∑ k ∈ Finset.range n, g k) := by
    intro g hg
    choose L hL using fun e : Fin 2 →₀ ℕ =>
      hscal (fun k => MvPowerSeries.coeff e (g k)) (e 0 + e 1) (fun k => hg k e)
    let G : MvPowerSeries (Fin 2) S := L
    refine ⟨G, fun n e => ?_⟩
    have hc : MvPowerSeries.coeff e G = L e := rfl
    rw [map_sub, map_sum, hc]
    exact hL e n

  have hLD : ∀ (n : ℕ) (f : MvPowerSeries (Fin 2) S), P n f → Ψ f ∈ 𝔞 ^ n := by
    intro n
    induction n with
    | zero =>
      intro f _
      rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    | succ n ih =>
      intro f hf
      let g₀ : MvPowerSeries (Fin 2) S := fun e =>
        MvPowerSeries.coeff (e + Finsupp.single 0 1) f
      let g₁ : MvPowerSeries (Fin 2) S := fun e =>
        if e 0 = 0 then MvPowerSeries.coeff (e + Finsupp.single 1 1) f else 0
      have hs00 : Finsupp.single (0 : Fin 2) (1 : ℕ) 0 = 1 := Finsupp.single_eq_same
      have hs01 : Finsupp.single (0 : Fin 2) (1 : ℕ) 1 = 0 := Finsupp.single_eq_of_ne (by decide)
      have hs10 : Finsupp.single (1 : Fin 2) (1 : ℕ) 0 = 0 := Finsupp.single_eq_of_ne (by decide)
      have hs11 : Finsupp.single (1 : Fin 2) (1 : ℕ) 1 = 1 := Finsupp.single_eq_same
      have hid : f = MvPowerSeries.C (MvPowerSeries.coeff 0 f) + MvPowerSeries.X 0 * g₀ +
          MvPowerSeries.X 1 * g₁ := by
        ext e
        rw [map_add, map_add, MvPowerSeries.coeff_C, MvPowerSeries.X_def, MvPowerSeries.X_def,
          MvPowerSeries.coeff_monomial_mul, MvPowerSeries.coeff_monomial_mul, one_mul, one_mul]
        have c0 : MvPowerSeries.coeff (e - Finsupp.single 0 1) g₀ =
            MvPowerSeries.coeff (e - Finsupp.single 0 1 + Finsupp.single 0 1) f := rfl
        have c1 : MvPowerSeries.coeff (e - Finsupp.single 1 1) g₁ =
            if (e - Finsupp.single 1 1 : Fin 2 →₀ ℕ) 0 = 0 then
              MvPowerSeries.coeff (e - Finsupp.single 1 1 + Finsupp.single 1 1) f else 0 := rfl
        have hsub0 : (e - Finsupp.single 1 1 : Fin 2 →₀ ℕ) 0 = e 0 := by
          rw [Finsupp.tsub_apply, hs10, Nat.sub_zero]
        rw [c0, c1, hsub0]
        by_cases h0 : e 0 = 0
        · by_cases h1 : e 1 = 0
          · have he : e = 0 := by
              ext i
              fin_cases i
              · simpa using h0
              · simpa using h1
            subst he
            have n0 : ¬ (Finsupp.single (0 : Fin 2) (1 : ℕ) ≤ 0) := fun h => by
              have := Finsupp.single_le_iff.mp h
              simp at this
            have n1 : ¬ (Finsupp.single (1 : Fin 2) (1 : ℕ) ≤ 0) := fun h => by
              have := Finsupp.single_le_iff.mp h
              simp at this
            rw [if_pos rfl, if_neg n0, if_neg n1, add_zero, add_zero]
          · have hne : e ≠ 0 := fun h => h1 (by rw [h]; rfl)
            have heq : e - Finsupp.single 1 1 + Finsupp.single 1 1 = e :=
              tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr (by omega))
            have n0 : ¬ (Finsupp.single (0 : Fin 2) (1 : ℕ) ≤ e) := fun h => by
              have := Finsupp.single_le_iff.mp h
              omega
            rw [if_neg hne, if_neg n0, if_pos (Finsupp.single_le_iff.mpr (by omega)), if_pos h0,
              heq, zero_add, zero_add]
        · have hne : e ≠ 0 := fun h => h0 (by rw [h]; rfl)
          have heq : e - Finsupp.single 0 1 + Finsupp.single 0 1 = e :=
            tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr (by omega))
          rw [if_neg hne, if_pos (Finsupp.single_le_iff.mpr (by omega)), heq, if_neg h0, ite_self,
            zero_add, add_zero]
      have hg0 : P n g₀ := by
        intro e
        have h := hf (e + Finsupp.single 0 1)
        rw [Finsupp.add_apply, Finsupp.add_apply, hs00, hs01] at h
        have hh : n + 1 - (e 0 + 1 + (e 1 + 0)) = n - (e 0 + e 1) := by omega
        rw [hh] at h
        exact h
      have hg1 : P n g₁ := by
        intro e
        show (if e 0 = 0 then MvPowerSeries.coeff (e + Finsupp.single 1 1) f else 0) ∈ _
        split_ifs with he0
        · have h := hf (e + Finsupp.single 1 1)
          rw [Finsupp.add_apply, Finsupp.add_apply, hs10, hs11] at h
          have hh : n + 1 - (e 0 + 0 + (e 1 + 1)) = n - (e 0 + e 1) := by omega
          rw [hh] at h
          exact h
        · exact Ideal.zero_mem _
      have hf0 : MvPowerSeries.coeff 0 f ∈ I ^ (n + 1) := by
        have h := hf 0
        simpa using h
      rw [hid, map_add, map_add, map_mul, map_mul]
      refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_
      · have h1 : (MvPowerSeries.C (MvPowerSeries.coeff 0 f) : MvPowerSeries (Fin 2) S) ∈
            (I ^ (n + 1)).map (MvPowerSeries.C : S →+* MvPowerSeries (Fin 2) S) :=
          Ideal.mem_map_of_mem _ hf0
        rw [Ideal.map_pow] at h1
        have h2 := Ideal.pow_right_mono (le_sup_left : I.map
          (MvPowerSeries.C : S →+* MvPowerSeries (Fin 2) S) ≤ M) (n + 1) h1
        have h3 := Ideal.mem_map_of_mem Ψ h2
        rw [Ideal.map_pow] at h3
        exact h3
      · rw [pow_succ']
        exact Ideal.mul_mem_mul (h𝔞X 0) (ih g₀ hg0)
      · rw [pow_succ']
        exact Ideal.mul_mem_mul (h𝔞X 1) (ih g₁ hg1)

  intro b
  obtain ⟨g, hg, hgb⟩ := happrox b
  have hgP : ∀ k, P k (g k) := fun k => hMnQ k (hg k)
  obtain ⟨G, hG⟩ := hseries g hgP
  refine ⟨G, ?_⟩
  have hmem : ∀ n, b - Ψ G ∈ J ^ n := by
    intro n
    have h1 := hgb n
    have h2 := hLD n _ (hG n)
    have e : b - Ψ G = (b - Ψ (∑ k ∈ Finset.range n, g k)) -
        Ψ (G - ∑ k ∈ Finset.range n, g k) := by rw [map_sub]; ring
    rw [e]
    exact Ideal.pow_right_mono h𝔞J n (Ideal.sub_mem _ h1 h2)
  have h0 := IsHausdorff.haus' (I := J) (b - Ψ G) (fun n => by
    rw [SModEq.sub_mem, sub_zero, Ideal.smul_eq_mul, Ideal.mul_top]
    exact hmem n)
  exact (sub_eq_zero.mp h0).symm

theorem wcpa_dj_nd_injective_flat_nakayama : ∀ (A Q B : Type u) [CommRing A] [CommRing Q] [CommRing B] [Algebra A Q] [Algebra A B] [IsNoetherianRing Q] [Module.Flat A B] (I : Ideal A) (Ψ : Q →ₐ[A] B), I.map (algebraMap A Q) ≤ Ideal.jacobson ⊥ → Function.Surjective Ψ → (∀ q : Q, Ψ q ∈ I.map (algebraMap A B) → q ∈ I.map (algebraMap A Q)) → Function.Injective Ψ :=
by
  intro A Q B _ _ _ _ _ _ _ I Ψ hjac hsurj hkey
  classical
  have hle : RingHom.ker Ψ ≤ I.map (algebraMap A Q) • RingHom.ker Ψ := by
    intro k hk
    have hk0 : Ψ k = 0 := RingHom.mem_ker.mp hk
    have hkI : k ∈ I.map (algebraMap A Q) := hkey k (by rw [hk0]; exact zero_mem _)
    have hspan : k ∈ Submodule.span Q (⇑(algebraMap A Q) '' (I : Set A)) := hkI
    obtain ⟨t, ht, c, hc⟩ := (Submodule.mem_span_image_iff_exists_fun Q).mp hspan
    have hrel : ∑ i : t, (i : A) • Ψ (c i) = 0 := by
      have h0 := hk0
      rw [← hc, map_sum] at h0
      refine Eq.trans ?_ h0
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_eq_mul, map_mul, AlgHom.commutes, Algebra.smul_def, mul_comm]
    obtain ⟨m, a, y, hy, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (f := fun i : t => (i : A)) (x := fun i : t => Ψ (c i)) hrel
    have hy' : ∀ i : t, Ψ (c i) = ∑ j, a i j • y j := fun i => hy i
    have ha' : ∀ j, ∑ i : t, (i : A) * a i j = 0 := fun j => ha j
    choose p hp using fun j => hsurj (y j)
    have hr : ∀ i : t, c i - ∑ j, a i j • p j ∈ RingHom.ker Ψ := by
      intro i
      rw [RingHom.mem_ker, map_sub, map_sum]
      simp only [map_smul, hp]
      rw [hy' i, sub_self]
    have h2 : ∑ i : t, algebraMap A Q (i : A) * ∑ j, a i j • p j = 0 := by
      calc ∑ i : t, algebraMap A Q (i : A) * ∑ j, a i j • p j
          = ∑ i : t, ∑ j, algebraMap A Q ((i : A) * a i j) * p j := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [Algebra.smul_def, map_mul, mul_assoc]
        _ = ∑ j, ∑ i : t, algebraMap A Q ((i : A) * a i j) * p j := Finset.sum_comm
        _ = ∑ j, algebraMap A Q (∑ i : t, (i : A) * a i j) * p j := by
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_sum, Finset.sum_mul]
        _ = 0 := by
            refine Finset.sum_eq_zero fun j _ => ?_
            rw [ha' j, map_zero, zero_mul]
    have hsum : ∑ i : t, algebraMap A Q (i : A) * (c i - ∑ j, a i j • p j) = k := by
      simp only [mul_sub, Finset.sum_sub_distrib, h2, sub_zero]
      rw [← hc]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_eq_mul, mul_comm]
    rw [← hsum]
    refine Submodule.sum_mem _ fun i _ => ?_
    exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ (ht i.2)) (hr i)
  have hfg : (RingHom.ker Ψ).FG := (isNoetherianRing_iff_ideal_fg Q).mp inferInstance _
  have hbot := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (I.map (algebraMap A Q))
    (RingHom.ker Ψ) hfg hle hjac
  exact (RingHom.injective_iff_ker_eq_bot Ψ).mpr hbot

theorem wcpa_dj_nd_node_mod_injective : ∀ (S B k : Type u) [CommRing S] [CommRing B] [Field k] (I : Ideal S) (r : S →+* k) (ι : S →+* B) (π : B →+* (MvPowerSeries (Fin 2) k ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (Ψ : MvPowerSeries (Fin 2) S →+* B) (h : S), I.FG → Function.Surjective r → RingHom.ker r = I → RingHom.ker π = I.map ι → π.comp ι = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp r) → Ψ.comp MvPowerSeries.C = ι → π (Ψ (MvPowerSeries.X 0)) = Ideal.Quotient.mk _ (MvPowerSeries.X 0) → π (Ψ (MvPowerSeries.X 1)) = Ideal.Quotient.mk _ (MvPowerSeries.X 1) → h ∈ I → ∀ G : MvPowerSeries (Fin 2) S, Ψ G ∈ I.map ι → Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h} : Ideal (MvPowerSeries (Fin 2) S)) G ∈ I.map (algebraMap S (MvPowerSeries (Fin 2) S ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h} : Ideal (MvPowerSeries (Fin 2) S)))) :=
by
  intro S B k _ _ _ I r ι π Ψ h hI _hr hker hπker hπι hΨC hX0 hX1 hh G hG
  classical

  have t_s3 : ∀ (R : Type u) [CommRing R] (g : MvPowerSeries (Fin 2) R) (d : Fin 2 →₀ ℕ),
      (d 0 = 0 ∨ d 1 = 0) →
      MvPowerSeries.coeff d (MvPowerSeries.X 0 * MvPowerSeries.X 1 * g) = 0 := by
    intro R _ g d hd
    have hXY : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) R) =
        MvPowerSeries.monomial (Finsupp.single 0 1 + Finsupp.single 1 1) 1 := by
      rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, mul_one]
    rw [hXY, MvPowerSeries.coeff_monomial_mul, if_neg]
    intro hle
    have h0 := Finsupp.le_def.mp hle 0
    have h1 := Finsupp.le_def.mp hle 1
    simp at h0 h1
    omega

  have t_s2 : ∀ (R : Type u) [CommRing R] (f : MvPowerSeries (Fin 2) R),
      ∃ P : MvPowerSeries (Fin 2) R, ∀ d : Fin 2 →₀ ℕ,
        MvPowerSeries.coeff d (f - MvPowerSeries.X 0 * MvPowerSeries.X 1 * P) =
          if (d 0 = 0 ∨ d 1 = 0) then MvPowerSeries.coeff d f else 0 := by
    intro R _ f
    obtain ⟨P, hPdef⟩ : ∃ P : MvPowerSeries (Fin 2) R, ∀ d, MvPowerSeries.coeff d P =
        MvPowerSeries.coeff (d + (Finsupp.single 0 1 + Finsupp.single 1 1)) f :=
      ⟨fun d => MvPowerSeries.coeff (d + (Finsupp.single 0 1 + Finsupp.single 1 1)) f,
        fun d => rfl⟩
    refine ⟨P, fun d => ?_⟩
    have hXY : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) R) =
        MvPowerSeries.monomial (Finsupp.single 0 1 + Finsupp.single 1 1) 1 := by
      rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, mul_one]
    rw [map_sub, hXY, MvPowerSeries.coeff_monomial_mul]
    by_cases hle : (Finsupp.single 0 1 + Finsupp.single 1 1 : Fin 2 →₀ ℕ) ≤ d
    · have h0 := Finsupp.le_def.mp hle 0
      have h1 := Finsupp.le_def.mp hle 1
      simp at h0 h1
      have hna : ¬ (d 0 = 0 ∨ d 1 = 0) := by omega
      rw [if_pos hle, if_neg hna, one_mul, hPdef, tsub_add_cancel_of_le hle, sub_self]
    · have ha : d 0 = 0 ∨ d 1 = 0 := by
        by_contra hc
        apply hle
        rw [Finsupp.le_def]
        intro i
        fin_cases i <;> simp <;> omega
      rw [if_neg hle, if_pos ha, sub_zero]

  have t_s4 : ∀ (R : Type u) [CommRing R] (n : ℕ) (F : MvPowerSeries (Fin 2) R),
      F ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) R)) ^ n →
      ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < n → MvPowerSeries.coeff d F = 0 := by
    intro R _
    have hmul : ∀ (a b : ℕ) (F G : MvPowerSeries (Fin 2) R),
        (∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < a → MvPowerSeries.coeff d F = 0) →
        (∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < b → MvPowerSeries.coeff d G = 0) →
        ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < a + b → MvPowerSeries.coeff d (F * G) = 0 := by
      intro a b F G hF hG d hd
      rw [MvPowerSeries.coeff_mul]
      apply Finset.sum_eq_zero
      intro p hp
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      have h0 : p.1 0 + p.2 0 = d 0 := by rw [← hp]; rfl
      have h1 : p.1 1 + p.2 1 = d 1 := by rw [← hp]; rfl
      by_cases hpa : p.1 0 + p.1 1 < a
      · rw [hF _ hpa, zero_mul]
      · rw [hG p.2 (by omega), mul_zero]
    have hX : ∀ i : Fin 2, ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < 1 →
        MvPowerSeries.coeff d (MvPowerSeries.X i : MvPowerSeries (Fin 2) R) = 0 := by
      intro i d hd
      have hd0 : d = 0 := Finsupp.ext (Fin.forall_fin_two.mpr ⟨by simp; omega, by simp; omega⟩)
      subst hd0
      simp
    have hany : ∀ (G : MvPowerSeries (Fin 2) R) (d : Fin 2 →₀ ℕ), d 0 + d 1 < 0 →
        MvPowerSeries.coeff d G = 0 := fun _ _ hd => absurd hd (Nat.not_lt_zero _)
    intro n
    induction n with
    | zero => intro F _ d hd; omega
    | succ n ih =>
      intro F hF
      rw [pow_succ'] at hF
      refine Submodule.mul_induction_on hF ?_ ?_
      · intro m hm y hy
        obtain ⟨a, b, rfl⟩ := Ideal.mem_span_pair.mp hm
        have hm1 : ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < 1 → MvPowerSeries.coeff d
            (a * MvPowerSeries.X 0 + b * MvPowerSeries.X 1) = 0 := by
          intro d hd
          rw [map_add, hmul 0 1 a _ (hany a) (hX 0) d (by omega),
            hmul 0 1 b _ (hany b) (hX 1) d (by omega), add_zero]
        intro d hd
        exact hmul 1 n _ _ hm1 (ih y hy) d (by omega)
      · intro x y hx hy d hd
        rw [map_add, hx d hd, hy d hd, add_zero]

  have t_s5 : ∀ (t : MvPowerSeries (Fin 2) k ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} :
        Ideal (MvPowerSeries (Fin 2) k))),
      (∀ n : ℕ, t ∈ (Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) k)) (MvPowerSeries.X 0), Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) k)) (MvPowerSeries.X 1)}) ^ n) →
      t = 0 := by
    intro t ht
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective t
    have hspan : (Ideal.span {Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) k)) (MvPowerSeries.X 0), Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) k)) (MvPowerSeries.X 1)}) =
        (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) k)).map
          (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) k))) := by
      rw [Ideal.map_span, Set.image_pair]
    have hax : ∀ d : Fin 2 →₀ ℕ, (d 0 = 0 ∨ d 1 = 0) → MvPowerSeries.coeff d f = 0 := by
      intro d hd
      have h1 := ht (d 0 + d 1 + 1)
      rw [hspan, ← Ideal.map_pow,
        Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective] at h1
      obtain ⟨g, hg, hgf⟩ := h1
      rw [Ideal.Quotient.eq] at hgf
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hgf
      have hf : f = g - MvPowerSeries.X 0 * MvPowerSeries.X 1 * c := by
        rw [mul_comm (MvPowerSeries.X 0 * MvPowerSeries.X 1) c, hc]; ring
      rw [hf, map_sub, t_s4 k _ g hg d (by omega), t_s3 k c d hd, sub_zero]
    obtain ⟨P, hP⟩ := t_s2 k f
    have hfP : f = MvPowerSeries.X 0 * MvPowerSeries.X 1 * P := by
      rw [← sub_eq_zero]
      ext d
      rw [hP d]
      split_ifs with h
      · rw [hax d h]; simp
      · simp
    rw [Ideal.Quotient.eq_zero_iff_mem, hfP]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

  have low : ∀ (n : ℕ) (F : MvPowerSeries (Fin 2) S), (∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < n → MvPowerSeries.coeff d F = 0) → F ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) S)) ^ n := by
    have le0 : ∀ d : Fin 2 →₀ ℕ, Finsupp.single (0 : Fin 2) 1 ≤ d ↔ 1 ≤ d 0 := by
      intro d; constructor
      · intro h; have := Finsupp.le_def.mp h 0; simpa using this
      · intro h; rw [Finsupp.le_def]; intro i; fin_cases i <;> simp <;> omega
    have le1 : ∀ d : Fin 2 →₀ ℕ, Finsupp.single (1 : Fin 2) 1 ≤ d ↔ 1 ≤ d 1 := by
      intro d; constructor
      · intro h; have := Finsupp.le_def.mp h 1; simpa using this
      · intro h; rw [Finsupp.le_def]; intro i; fin_cases i <;> simp <;> omega
    intro n
    induction n with
    | zero => intro F _; rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
    | succ n ih =>
      intro F hF
      obtain ⟨A, hA⟩ : ∃ A : MvPowerSeries (Fin 2) S, ∀ d, MvPowerSeries.coeff d A =
          MvPowerSeries.coeff (d + Finsupp.single 0 1) F :=
        ⟨fun d => MvPowerSeries.coeff (d + Finsupp.single 0 1) F, fun d => rfl⟩
      obtain ⟨B, hB⟩ : ∃ B : MvPowerSeries (Fin 2) S, ∀ d, MvPowerSeries.coeff d B =
          if d 0 = 0 then MvPowerSeries.coeff (d + Finsupp.single 1 1) F else 0 :=
        ⟨fun d => if d 0 = 0 then MvPowerSeries.coeff (d + Finsupp.single 1 1) F else 0,
          fun d => rfl⟩
      have hAn := ih A (fun d hd => by
        rw [hA]
        apply hF
        have e0 : (d + Finsupp.single (0 : Fin 2) 1 : Fin 2 →₀ ℕ) 0 = d 0 + 1 := by simp
        have e1 : (d + Finsupp.single (0 : Fin 2) 1 : Fin 2 →₀ ℕ) 1 = d 1 := by simp
        omega)
      have hBn := ih B (fun d hd => by
        rw [hB]
        split_ifs
        · apply hF
          have e0 : (d + Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 0 = d 0 := by simp
          have e1 : (d + Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 1 = d 1 + 1 := by simp
          omega
        · rfl)
      have hFeq : F = MvPowerSeries.X 0 * A + MvPowerSeries.X 1 * B := by
        ext d
        rw [map_add, MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul,
          MvPowerSeries.coeff_monomial_mul]
        by_cases h0 : 1 ≤ d 0
        · rw [if_pos ((le0 d).mpr h0), one_mul, hA, tsub_add_cancel_of_le ((le0 d).mpr h0)]
          have hz : (if Finsupp.single (1 : Fin 2) 1 ≤ d then
              1 * MvPowerSeries.coeff (d - Finsupp.single 1 1) B else 0) = 0 := by
            split_ifs with h1
            · have e : (d - Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 0 = d 0 := by simp
              rw [hB, if_neg (by rw [e]; omega), mul_zero]
            · rfl
          rw [hz, add_zero]
        · have hd0 : d 0 = 0 := by omega
          rw [if_neg (fun h => h0 ((le0 d).mp h)), zero_add]
          split_ifs with h1
          · have e : (d - Finsupp.single (1 : Fin 2) 1 : Fin 2 →₀ ℕ) 0 = d 0 := by simp
            rw [one_mul, hB, if_pos (by rw [e]; exact hd0), tsub_add_cancel_of_le h1]
          · have hd1 : d 1 = 0 := by
              by_contra hc
              exact h1 ((le1 d).mpr (by omega))
            exact hF d (by omega)
      rw [hFeq, pow_succ']
      exact Ideal.add_mem _
        (Ideal.mul_mem_mul (Ideal.subset_span (Set.mem_insert _ _)) hAn)
        (Ideal.mul_mem_mul (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)) hBn)

  have t_s6 : ∀ (T : Type u) [CommRing T] (Θ₁ Θ₂ : MvPowerSeries (Fin 2) S →+* T),
      Θ₁.comp MvPowerSeries.C = Θ₂.comp MvPowerSeries.C →
      (∀ i : Fin 2, Θ₁ (MvPowerSeries.X i) = Θ₂ (MvPowerSeries.X i)) →
      (∀ t : T, (∀ n : ℕ, t ∈ (Ideal.span {Θ₁ (MvPowerSeries.X 0), Θ₁ (MvPowerSeries.X 1)} : Ideal T) ^ n) → t = 0) →
      Θ₁ = Θ₂ := by
    intro T _ Θ₁ Θ₂ hC hX hsep
    have hpoly : Θ₁.comp (MvPolynomial.coeToMvPowerSeries.ringHom) =
        Θ₂.comp (MvPolynomial.coeToMvPowerSeries.ringHom) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, MvPolynomial.coeToMvPowerSeries.ringHom_apply,
          MvPolynomial.coe_C]
        exact RingHom.congr_fun hC a
      · intro i
        simp only [RingHom.comp_apply, MvPolynomial.coeToMvPowerSeries.ringHom_apply,
          MvPolynomial.coe_X]
        exact hX i
    refine RingHom.ext fun F => ?_
    rw [← sub_eq_zero]
    apply hsep
    intro n
    have hR : F - ((MvPowerSeries.trunc S (Finsupp.single 0 n + Finsupp.single 1 n) F :
        MvPolynomial (Fin 2) S) : MvPowerSeries (Fin 2) S) ∈
        (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) S)) ^ n := by
      apply low
      intro d hd
      have hlt : d < Finsupp.single 0 n + Finsupp.single 1 n := by
        refine lt_of_le_of_ne ?_ ?_
        · rw [Finsupp.le_def]
          intro i
          fin_cases i <;> simp <;> omega
        · intro heq
          have := congrArg (fun x : Fin 2 →₀ ℕ => x 0) heq
          simp at this
          omega
      rw [map_sub, MvPolynomial.coeff_coe, MvPowerSeries.coeff_trunc, if_pos hlt, sub_self]
    have hPe := RingHom.congr_fun hpoly
      (MvPowerSeries.trunc S (Finsupp.single 0 n + Finsupp.single 1 n) F)
    simp only [RingHom.comp_apply, MvPolynomial.coeToMvPowerSeries.ringHom_apply] at hPe
    have h1 := Ideal.mem_map_of_mem Θ₁ hR
    have h2 := Ideal.mem_map_of_mem Θ₂ hR
    rw [Ideal.map_pow, Ideal.map_span, Set.image_pair] at h1 h2
    rw [← hX 0, ← hX 1] at h2
    have e : Θ₁ F - Θ₂ F = Θ₁ (F - ((MvPowerSeries.trunc S (Finsupp.single 0 n + Finsupp.single 1 n) F :
        MvPolynomial (Fin 2) S) : MvPowerSeries (Fin 2) S)) - Θ₂ (F - ((MvPowerSeries.trunc S
        (Finsupp.single 0 n + Finsupp.single 1 n) F : MvPolynomial (Fin 2) S) : MvPowerSeries (Fin 2) S)) := by
      rw [map_sub, map_sub, hPe]; ring
    rw [e]
    exact Ideal.sub_mem _ h1 h2

  have t_s1 : ∀ (F : MvPowerSeries (Fin 2) S),
      (∀ d : Fin 2 →₀ ℕ, MvPowerSeries.coeff d F ∈ I) →
      F ∈ I.map (MvPowerSeries.C : S →+* MvPowerSeries (Fin 2) S) := by
    intro F hF
    obtain ⟨m, s, hs⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hI
    have hc : ∀ d : Fin 2 →₀ ℕ, ∃ c : Fin m → S, ∑ j, c j • s j = MvPowerSeries.coeff d F := by
      intro d
      have := hF d
      rw [← hs] at this
      exact (Submodule.mem_span_range_iff_exists_fun S).mp this
    choose c hc using hc
    have hsI : ∀ j, s j ∈ I := fun j => hs ▸ Submodule.subset_span ⟨j, rfl⟩
    let H : Fin m → MvPowerSeries (Fin 2) S := fun j d => c d j
    have hH : ∀ j d, MvPowerSeries.coeff d (H j) = c d j := fun _ _ => rfl
    have hFeq : F = ∑ j, MvPowerSeries.C (s j) * H j := by
      ext d
      rw [map_sum]
      simp only [MvPowerSeries.coeff_C_mul, hH]
      rw [← hc d]
      simp only [smul_eq_mul]
      exact Finset.sum_congr rfl fun j _ => mul_comm _ _
    rw [hFeq]
    exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hsI j))

  have s8 : π.comp Ψ = (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} :
      Ideal (MvPowerSeries (Fin 2) k))).comp (MvPowerSeries.map r) := by
    apply t_s6 _ (π.comp Ψ)
    · refine RingHom.ext fun s => ?_
      simp only [RingHom.comp_apply, MvPowerSeries.map_C]
      rw [← RingHom.comp_apply Ψ MvPowerSeries.C, hΨC]
      have := RingHom.congr_fun hπι s
      simp only [RingHom.comp_apply] at this
      exact this
    · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
      · simp only [RingHom.comp_apply, MvPowerSeries.map_X]
        exact hX0
      · simp only [RingHom.comp_apply, MvPowerSeries.map_X]
        exact hX1
    · intro t ht
      apply t_s5 t
      intro n
      have := ht n
      simp only [RingHom.comp_apply] at this
      rw [hX0, hX1] at this
      exact this

  have hax : ∀ d : Fin 2 →₀ ℕ, (d 0 = 0 ∨ d 1 = 0) → MvPowerSeries.coeff d G ∈ I := by
    have h0 : π (Ψ G) = 0 := by rw [← RingHom.mem_ker, hπker]; exact hG
    have h1 : Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} :
        Ideal (MvPowerSeries (Fin 2) k)) (MvPowerSeries.map r G) = 0 := by
      have := RingHom.congr_fun s8 G
      simp only [RingHom.comp_apply] at this
      rw [← this]; exact h0
    rw [Ideal.Quotient.eq_zero_iff_mem] at h1
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h1
    intro d hd
    rw [← hker, RingHom.mem_ker, ← MvPowerSeries.coeff_map, ← hc, mul_comm, t_s3 k c d hd]

  obtain ⟨P, hP⟩ := t_s2 S G
  have hax' : G - MvPowerSeries.X 0 * MvPowerSeries.X 1 * P ∈
      I.map (MvPowerSeries.C : S →+* MvPowerSeries (Fin 2) S) := by
    apply t_s1
    intro d
    rw [hP d]
    split_ifs with hd
    · exact hax d hd
    · exact I.zero_mem
  have hW : G - MvPowerSeries.X 0 * MvPowerSeries.X 1 * P + MvPowerSeries.C h * P ∈
      I.map (MvPowerSeries.C : S →+* MvPowerSeries (Fin 2) S) :=
    Ideal.add_mem _ hax' (Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hh))
  have hGW : Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h} :
      Ideal (MvPowerSeries (Fin 2) S)) G =
      Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h} :
      Ideal (MvPowerSeries (Fin 2) S)) (G - MvPowerSeries.X 0 * MvPowerSeries.X 1 * P + MvPowerSeries.C h * P) := by
    rw [Ideal.Quotient.eq]
    have e : G - (G - MvPowerSeries.X 0 * MvPowerSeries.X 1 * P + MvPowerSeries.C h * P) =
        P * (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h) := by ring
    rw [e]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  have hCalg : ∀ s : S, algebraMap S (MvPowerSeries (Fin 2) S) s = MvPowerSeries.C s := by
    intro s
    first
      | rfl
      | simp [MvPowerSeries.algebraMap_apply]
  have halg : algebraMap S (MvPowerSeries (Fin 2) S ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h} : Ideal (MvPowerSeries (Fin 2) S))) =
      (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h} :
        Ideal (MvPowerSeries (Fin 2) S))).comp MvPowerSeries.C := by
    refine RingHom.ext fun s => ?_
    rw [RingHom.comp_apply, ← Ideal.Quotient.mk_algebraMap, hCalg]
  rw [hGW, halg, ← Ideal.map_map]
  exact Ideal.mem_map_of_mem _ hW

theorem wcpa_dj_mn_node_deform : ∀ (A R : Type u) [CommRing A] [CommRing R] [IsLocalRing A] [IsLocalRing R] [IsNoetherianRing A] [IsNoetherianRing R] (φ : A →+* R), IsLocalHom φ → φ.Flat → (∃ ε : AdicCompletion ((IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map φ))) (R ⧸ (IsLocalRing.maximalIdeal A).map φ) ≃+* (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField A) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), ε.toRingHom.comp ((algebraMap (R ⧸ (IsLocalRing.maximalIdeal A).map φ) (AdicCompletion ((IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map φ))) (R ⧸ (IsLocalRing.maximalIdeal A).map φ))).comp ((Ideal.Quotient.mk ((IsLocalRing.maximalIdeal A).map φ)).comp φ)) = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (IsLocalRing.residue A))) → ∃ (h : AdicCompletion (IsLocalRing.maximalIdeal A) A) (e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) (AdicCompletion (IsLocalRing.maximalIdeal A) A) ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h})), e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) :=
by
  intro A R _ _ _ _ _ _ φ hφloc hφflat hε
  classical

  have hloc : ∀ {X Y : Type u} [CommRing X] [CommRing Y] [IsLocalRing X] [IsLocalRing Y]
      (f : X →+* Y) [IsLocalHom f],
      (IsLocalRing.maximalIdeal X).map f ≤ IsLocalRing.maximalIdeal Y := by
    intro X Y _ _ _ _ f _
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hx) (isUnit_of_map_unit f x hu)



  have core : ∀ (S B : Type u) [CommRing S] [CommRing B] [IsLocalRing S] [IsLocalRing B]
      [IsNoetherianRing S] [IsNoetherianRing B] [IsAdicComplete (IsLocalRing.maximalIdeal S) S]
      [IsAdicComplete (IsLocalRing.maximalIdeal B) B] (ι : S →+* B) [IsLocalHom ι], ι.Flat →
      ∀ (r : S →+* IsLocalRing.ResidueField A)
        (π : B →+* (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField A) ⧸
          Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})),
      Function.Surjective r → RingHom.ker r = IsLocalRing.maximalIdeal S →
      Function.Surjective π → RingHom.ker π = (IsLocalRing.maximalIdeal S).map ι →
      π.comp ι = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp r) →
      ∃ (h : S) (e : B ≃+* (MvPowerSeries (Fin 2) S ⧸
          Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h})),
        ∀ s, e (ι s) = Ideal.Quotient.mk _ (MvPowerSeries.C s) := by
    intro S B _ _ _ _ _ _ _ _ ι _ hιflat r π hr_surj hr_ker hπsurj hker' hπι
    have hle : (IsLocalRing.maximalIdeal S).map ι ≤ IsLocalRing.maximalIdeal B := hloc ι
    obtain ⟨xb, hxb⟩ : ∃ x : (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField A) ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
