    haveI : IsNoetherianRing (MvPowerSeries (Fin 2) S) :=
      wcpa_dj_nd_mvpowerseries_two_noetherian S
    have hinj := wcpa_dj_nd_injective_flat_nakayama S _ B (IsLocalRing.maximalIdeal S) Ψb hjac
