    have h := congrArg (X.presheaf.map (homOfLE (inf_le_left :
      L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b)).op).hom (hβ' a b)
    rw [map_sub] at h
    simp only [hres, hid] at h
    simp only [hres]
    rw [← h]
  unfold wcpaDjTwH1
  intro c hc
  simp only [pow_zero, one_smul] at hc ⊢
  obtain ⟨β0, hβ0⟩ := key c hc
  exact ⟨β0, hβ0⟩

theorem fexr_point_blowup_local : ∀ (Y : Scheme.{u}) [IsNoetherian Y], AlgebraicGeometry.IsIntegral Y → (∀ U V : Y.Opens, IsAffineOpen U → IsAffineOpen V → IsAffineOpen (U ⊓ V)) → ∀ (y : Y) (hy : IsClosed ({y} : Set Y)), IsRegularLocalRing (Y.presheaf.stalk y) → ringKrullDim (Y.presheaf.stalk y) = 2 → ∀ (Y' : Scheme.{u}) [IsNoetherian Y'] (r : Y' ⟶ Y), wcCsdIsBlowup (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)) r → (∀ U V : Y'.Opens, IsAffineOpen U → IsAffineOpen V → IsAffineOpen (U ⊓ V)) → (∃ V : Y.Opens, V ≠ ⊥ ∧ IsIso (r ∣_ V)) ∧ ∃ (k : ℕ) (V : Fin k → Y.Opens), (∀ a, IsAffineOpen (V a)) ∧ (⨆ a, V a) = ⊤ ∧ ∀ a, wcpaDjFexH1 (r ⁻¹ᵁ V a).toScheme :=
by
  intro Y _ hYint hAff y hy hreg hdim Y' _ r hbl hAff'
  haveI := hYint
  haveI := hreg

  have hres : ∀ {X : Scheme.{u}} {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X A B C h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hid : ∀ {X : Scheme.{u}} {A : X.Opens} (h : A ≤ A) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro X A h x
    have e0 : X.presheaf.map (homOfLE h).op = 𝟙 _ := by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op A) from rfl, X.presheaf.map_id]
    rw [e0]
    rfl

  have hinj : ∀ {X : Scheme.{u}} {A B : X.Opens} (h1 : B ≤ A) (h2 : A ≤ B) (x x' : Γ(X, A)),
      (X.presheaf.map (homOfLE h1).op).hom x = (X.presheaf.map (homOfLE h1).op).hom x' → x = x' := by
    intro X A B h1 h2 x x' hxx
    have h := congrArg (X.presheaf.map (homOfLE h2).op).hom hxx
    simp only [hres, hid] at h
    exact h

  have htop : ∀ {X X' : Scheme.{u}} (r : X' ⟶ X) (V : X'.Opens), V ≤ r ⁻¹ᵁ ⊤ :=
    fun _ _ => by simp

  have hcompat : ∀ {X X' : Scheme.{u}} (r : X' ⟶ X) {V V' : X'.Opens} (hl : V' ≤ V) (x : Γ(X, ⊤)),
      (X'.presheaf.map (homOfLE hl).op).hom ((r.appLE ⊤ V (htop r V)).hom x) =
        (r.appLE ⊤ V' (htop r V')).hom x := by
    intro X X' r V V' hl x
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]


  have hs2 : ∃ z : Y, z ≠ y := by
    refine ⟨genericPoint Y, fun he => ?_⟩
    have hdim' := hdim
    subst he
    have h0 : ringKrullDim (Y.presheaf.stalk (genericPoint Y)) = 0 :=
      ringKrullDim_eq_zero_of_field Y.functionField
    exact absurd (h0.symm.trans hdim') (by decide)

  have hs3 : ∃ gh : Fin 2 → Y.presheaf.stalk y,
      Ideal.span (Set.range gh) = IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := Y.presheaf.stalk y)
    rw [hdim] at h1
    have h2 : Submodule.spanFinrank (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) = 2 := by
      exact_mod_cast h1
    obtain ⟨s, hs, hspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank
      (_root_.IsNoetherian.noetherian (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)))
    rw [h2] at hs
    obtain ⟨a, b, -, rfl⟩ := Set.encard_eq_two.mp (by exact_mod_cast hs)
    refine ⟨![a, b], ?_⟩
    rw [Matrix.range_cons_cons_empty]
    exact hspan

  have hs4 : ∀ (X : Scheme.{u}) [IsNoetherian X] (O : X.Opens), ∃ (n : ℕ) (P : Fin n → X.Opens),
      (∀ κ, IsAffineOpen (P κ)) ∧ (∀ κ, P κ ≤ O) ∧ (⨆ κ, P κ) = O := by
    intro X _ O
    have hc : IsCompact (O : Set X) := TopologicalSpace.NoetherianSpace.isCompact _
    obtain ⟨s, hs, hO⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hc
    refine ⟨hs.toFinset.card, fun κ => ((hs.toFinset.equivFin.symm κ).1 : X.Opens),
      fun κ => (hs.toFinset.equivFin.symm κ).1.2, ?_, ?_⟩
    · intro κ
      rw [hO]
      exact le_iSup₂_of_le (hs.toFinset.equivFin.symm κ).1
        (hs.mem_toFinset.1 (hs.toFinset.equivFin.symm κ).2) le_rfl
    · rw [hO]
      apply le_antisymm
      · exact iSup_le fun κ => le_iSup₂_of_le (hs.toFinset.equivFin.symm κ).1
          (hs.mem_toFinset.1 (hs.toFinset.equivFin.symm κ).2) le_rfl
      · refine iSup₂_le fun i hi => le_iSup_of_le (hs.toFinset.equivFin ⟨i, hs.mem_toFinset.2 hi⟩) ?_
        simp only [Equiv.symm_apply_apply]
        exact le_rfl

  have hs5 : ∀ (Z : Scheme.{u}) [IsNoetherian Z],
      (∀ U V : Z.Opens, IsAffineOpen U → IsAffineOpen V → IsAffineOpen (U ⊓ V)) →
      ∀ W : Z.Opens, IsNoetherian W.toScheme ∧
        ∀ U V : W.toScheme.Opens, IsAffineOpen U → IsAffineOpen V → IsAffineOpen (U ⊓ V) := by
    intro Z _ hAffZ W
    refine ⟨?_, ?_⟩
    · haveI : CompactSpace W.toScheme :=
        isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (W : Set Z))
      exact AlgebraicGeometry.IsNoetherian.mk
    · intro U V hU hV
      have e : U ⊓ V = W.ι ⁻¹ᵁ (W.ι ''ᵁ U ⊓ W.ι ''ᵁ V) := by
        rw [Scheme.Hom.preimage_inf, Scheme.Hom.preimage_image_eq, Scheme.Hom.preimage_image_eq]
      rw [e]
      exact (hAffZ _ _ (hU.image_of_isOpenImmersion W.ι)
        (hV.image_of_isOpenImmersion W.ι)).preimage_of_isOpenImmersion
        W.ι (inf_le_left.trans (Scheme.Hom.image_le_opensRange _ _))

  have hs7 : ∀ (X X' : Scheme.{u}) (J : X.IdealSheafData) (q : X' ⟶ X) (V : X.Opens),
      wcCsdIsBlowup J q → wcCsdIsBlowup (J.comap V.ι) (q ∣_ V) := by
    intro X X' J q V hq0
    have hq := wcpa_dj_nc_blowup_flat_basechange X X' V.toScheme J q V.ι inferInstance hq0
    set e := (isPullback_morphismRestrict q V).flip.isoPullback with he_def
    have he : e.hom ≫ Limits.pullback.snd q V.ι = q ∣_ V := IsPullback.isoPullback_hom_snd _
    refine ⟨?_, ?_⟩
    · rw [← he]
      exact wcpa_dj_lr1k_ebd_invpull_flat_pre _ _ _ _ _ e.hom inferInstance hq.1
    · intro T h hh
      obtain ⟨h', hh', huniq⟩ := hq.2 T h hh
      refine ⟨h' ≫ e.inv, ?_, fun c hc => ?_⟩
      · show (h' ≫ e.inv) ≫ q ∣_ V = h
        rw [← he, Category.assoc, e.inv_hom_id_assoc, hh']
      · have hc' : c ≫ q ∣_ V = h := hc
        have h1 : c ≫ e.hom = h' := huniq _ (by
          show (c ≫ e.hom) ≫ Limits.pullback.snd q V.ι = h
          rw [Category.assoc, he]
          exact hc')
        rw [← h1, Category.assoc, e.hom_inv_id, Category.comp_id]

  have hs8 : ∀ {X X' : Scheme.{u}} (g : Fin 2 → Γ(X, ⊤)) (r : X' ⟶ X) (U : Fin 2 → X'.Opens)
      (t : ∀ l : Fin 2, Fin 2 → Γ(X', U l)), wcBpChartHyp r g U t →
      U 0 ⊓ U 1 = X'.basicOpen (t 0 1) ∧
        (X'.presheaf.map (homOfLE (inf_le_left : U 0 ⊓ U 1 ≤ U 0)).op).hom (t 0 1) *
          (X'.presheaf.map (homOfLE (inf_le_right : U 0 ⊓ U 1 ≤ U 1)).op).hom (t 1 0) = 1 := by
    intro X X' g r U t hC
    obtain ⟨-, haff, h3, h4, -, h6⟩ := hC
    have h3' : ∀ l j, (r.appLE ⊤ (U l) (htop r (U l))).hom (g j) =
        t l j * (r.appLE ⊤ (U l) (htop r (U l))).hom (g l) := h3
    have h4' : ∀ l, (r.appLE ⊤ (U l) (htop r (U l))).hom (g l) ∈ nonZeroDivisors Γ(X', U l) := h4
    have e1 := congrArg (X'.presheaf.map (homOfLE (inf_le_left : U 0 ⊓ U 1 ≤ U 0)).op).hom (h3' 0 1)
    have e2 := congrArg (X'.presheaf.map (homOfLE (inf_le_right : U 0 ⊓ U 1 ≤ U 1)).op).hom (h3' 1 0)
    rw [map_mul, hcompat, hcompat] at e1 e2
    have hnz : (r.appLE ⊤ (U 0 ⊓ U 1) (htop r _)).hom (g 1) ∈ nonZeroDivisors Γ(X', U 0 ⊓ U 1) := by
      have := wc_csd_nzd_restrict X' (U 1) (U 0 ⊓ U 1) inf_le_right (haff 1) _ (h4' 1)
      rw [← hcompat r (inf_le_right : U 0 ⊓ U 1 ≤ U 1)]
      exact this
    have hTS : (X'.presheaf.map (homOfLE (inf_le_left : U 0 ⊓ U 1 ≤ U 0)).op).hom (t 0 1) *
          (X'.presheaf.map (homOfLE (inf_le_right : U 0 ⊓ U 1 ≤ U 1)).op).hom (t 1 0) = 1 := by
      have h0 : ((X'.presheaf.map (homOfLE (inf_le_left : U 0 ⊓ U 1 ≤ U 0)).op).hom (t 0 1) *
          (X'.presheaf.map (homOfLE (inf_le_right : U 0 ⊓ U 1 ≤ U 1)).op).hom (t 1 0) - 1) *
          (r.appLE ⊤ (U 0 ⊓ U 1) (htop r _)).hom (g 1) = 0 := by
        linear_combination
          -(X'.presheaf.map (homOfLE (inf_le_left : U 0 ⊓ U 1 ≤ U 0)).op).hom (t 0 1) * e2 - e1
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hnz).mp h0)
    refine ⟨?_, hTS⟩
    have hunit : IsUnit ((X'.presheaf.map (homOfLE (inf_le_left : U 0 ⊓ U 1 ≤ U 0)).op).hom (t 0 1)) :=
      ⟨⟨_, _, hTS, by rw [mul_comm]; exact hTS⟩, rfl⟩
    have hb := X'.basicOpen_res (t 0 1) (homOfLE (inf_le_left : U 0 ⊓ U 1 ≤ U 0)).op
    rw [X'.basicOpen_of_isUnit hunit] at hb
    apply le_antisymm
    · rw [hb]; exact inf_le_right
    · exact le_inf (X'.basicOpen_le _) (h6 0 1)

  have hs9 : ∀ {X X' : Scheme.{u}} (g : Fin 2 → Γ(X, ⊤)) (r : X' ⟶ X) (U : Fin 2 → X'.Opens)
      (t : ∀ l : Fin 2, Fin 2 → Γ(X', U l)), wcBpChartHyp r g U t →
      ∀ s : Γ(X', U 0), ∃ p : Polynomial Γ(X, ⊤),
        s = p.eval₂ (r.appLE ⊤ (U 0) (htop r (U 0))).hom (t 0 1) := by
    intro X X' g r U t hC
    obtain ⟨-, -, h3, h4, h5, -⟩ := hC
    have h3' : ∀ l j, (r.appLE ⊤ (U l) (htop r (U l))).hom (g j) =
        t l j * (r.appLE ⊤ (U l) (htop r (U l))).hom (g l) := h3
    have h4' : ∀ l, (r.appLE ⊤ (U l) (htop r (U l))).hom (g l) ∈ nonZeroDivisors Γ(X', U l) := h4
    have h5' : ∀ l (s : Γ(X', U l)), s ∈ Subring.closure
        (Set.range (r.appLE ⊤ (U l) (htop r (U l))).hom ∪ Set.range (t l)) := h5
    have ht00 : t 0 0 = 1 := by
      have h0 : (t 0 0 - 1) * (r.appLE ⊤ (U 0) (htop r (U 0))).hom (g 0) = 0 := by
        linear_combination -(h3' 0 0)
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff (h4' 0)).mp h0)
    intro s
    have hle : Subring.closure (Set.range (r.appLE ⊤ (U 0) (htop r (U 0))).hom ∪ Set.range (t 0)) ≤
        (Polynomial.eval₂RingHom (r.appLE ⊤ (U 0) (htop r (U 0))).hom (t 0 1)).range := by
      rw [Subring.closure_le]
      rintro _ (⟨a, rfl⟩ | ⟨j, rfl⟩)
      · exact ⟨Polynomial.C a, by simp⟩
      · fin_cases j
        · exact ⟨1, by simp [ht00]⟩
        · exact ⟨Polynomial.X, by simp⟩
    obtain ⟨p, hp⟩ := RingHom.mem_range.mp (hle (h5' 0 s))
    exact ⟨p, by rw [← hp, Polynomial.coe_eval₂RingHom]⟩

  have laurent : ∀ (A R0 R1 RW : Type u) [CommRing A] [CommRing R0] [CommRing R1] [CommRing RW]
      (φ0 : A →+* R0) (φ1 : A →+* R1) (ρ0 : R0 →+* RW) (ρ1 : R1 →+* RW),
      (∀ a, ρ0 (φ0 a) = ρ1 (φ1 a)) → ∀ (τ : R0) (σ : R1), ρ0 τ * ρ1 σ = 1 →
      (∀ s : R0, ∃ p : Polynomial A, s = p.eval₂ φ0 τ) →
      ∀ f : RW, (∃ (N : ℕ) (s : R0), f * ρ0 τ ^ N = ρ0 s) →
      ∃ (β0 : R0) (β1 : R1), f = ρ1 β1 - ρ0 β0 := by
    intro A R0 R1 RW _ _ _ _ φ0 φ1 ρ0 ρ1 hcomp τ σ hTS hpoly f ⟨N, s, hfs⟩
    obtain ⟨p, rfl⟩ := hpoly s
    set K := p.natDegree + 1 with hK
    have hsN : p.eval₂ φ0 τ = ∑ i ∈ Finset.range (N + K), φ0 (p.coeff i) * τ ^ i :=
      Polynomial.eval₂_eq_sum_range' φ0 (by omega) τ
    refine ⟨-∑ j ∈ Finset.range K, φ0 (p.coeff (N + j)) * τ ^ j,
      ∑ i ∈ Finset.range N, φ1 (p.coeff i) * σ ^ (N - i), ?_⟩
    have hunit : IsUnit (ρ0 τ ^ N) := (isUnit_iff_exists_inv.mpr ⟨_, hTS⟩).pow N
    apply (hunit.mul_left_inj).mp
    rw [hfs, hsN, Finset.sum_range_add, map_add, map_neg, map_sum, map_sum, map_sum, map_sum,
      sub_neg_eq_add, add_mul, Finset.sum_mul, Finset.sum_mul]
    congr 1
    · refine Finset.sum_congr rfl (fun i hi => ?_)
      have hiN : i ≤ N := (Finset.mem_range.mp hi).le
      obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le hiN
      have hk1 : (ρ0 τ * ρ1 σ) ^ k = 1 := by rw [hTS, one_pow]
      rw [map_mul, map_mul, map_pow, map_pow, ← hcomp, hk, Nat.add_sub_cancel_left]
      linear_combination (-(ρ0 (φ0 (p.coeff i)) * ρ0 τ ^ i)) * hk1
    · refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, map_mul, map_pow, map_pow, pow_add]
      ring

  have hs11 : ∀ (X : Scheme.{u}) (V : Fin 2 → X.Opens),
      (∀ f : Γ(X, V 0 ⊓ V 1), ∃ (β0 : Γ(X, V 0)) (β1 : Γ(X, V 1)),
        f = (X.presheaf.map (homOfLE (inf_le_right : V 0 ⊓ V 1 ≤ V 1)).op).hom β1 -
          (X.presheaf.map (homOfLE (inf_le_left : V 0 ⊓ V 1 ≤ V 0)).op).hom β0) →
      wcpaDjTwH1 (⟨2, V, fun _ _ => 1⟩ : wcpaDjCoc X) ⊤ (wcStructMod X) 0 := by
    intro X V hsplit

    have R : wcpaP1rRawH1 V := by
      intro c hc
      have hdiag : ∀ a, c a a = 0 := by
        intro a
        have h := hc a a a
        have h' : (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right :
            V a ⊓ V a ⊓ V a ≤ V a ⊓ V a)).op).hom (c a a) = 0 := by
          have e := h
          rw [show (homOfLE (le_inf (inf_le_left.trans inf_le_right) inf_le_right :
              V a ⊓ V a ⊓ V a ≤ V a ⊓ V a)) = homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
              from rfl, show (homOfLE (inf_le_left : V a ⊓ V a ⊓ V a ≤ V a ⊓ V a)) =
              homOfLE (le_inf (inf_le_left.trans inf_le_left) inf_le_right) from rfl] at e
          linear_combination -e
        apply hinj (le_inf (inf_le_left.trans inf_le_left) inf_le_right : V a ⊓ V a ⊓ V a ≤ V a ⊓ V a)
          (le_inf le_rfl inf_le_left)
        rw [h', map_zero]
      have h010 := hc 0 1 0
      rw [hdiag 0, map_zero] at h010
      obtain ⟨β0, β1, hβ⟩ := hsplit (c 0 1)
      refine ⟨@Fin.cons 1 (fun a => Γ(X, V a)) β0 (@Fin.cons 0 (fun j => Γ(X, V j.succ)) β1 finZeroElim),
        Fin.forall_fin_two.mpr ⟨Fin.forall_fin_two.mpr ⟨?_, ?_⟩, Fin.forall_fin_two.mpr ⟨?_, ?_⟩⟩⟩
      · show c 0 0 = _ - _
        rw [hdiag 0, sub_self]
      · exact hβ
      · show c 1 0 = (X.presheaf.map (homOfLE (inf_le_right : V 1 ⊓ V 0 ≤ V 0)).op).hom β0 -
          (X.presheaf.map (homOfLE (inf_le_left : V 1 ⊓ V 0 ≤ V 1)).op).hom β1
        apply hinj (le_inf (inf_le_left.trans inf_le_right) inf_le_right : V 0 ⊓ V 1 ⊓ V 0 ≤ V 1 ⊓ V 0)
          (le_inf (le_inf inf_le_right inf_le_left) inf_le_right)
        have e2 := congrArg (X.presheaf.map (homOfLE (inf_le_left : V 0 ⊓ V 1 ⊓ V 0 ≤ V 0 ⊓ V 1)).op).hom hβ
        rw [map_sub, hres, hres] at e2
        rw [map_sub, hres, hres]
        linear_combination -h010 - e2
      · show c 1 1 = _ - _
        rw [hdiag 1, sub_self]

    have key : ∀ c0 : ∀ a b : Fin 2, Γ(X, V a ⊓ V b ⊓ ⊤),
        (∀ a b d,
          (X.presheaf.map (homOfLE (show V a ⊓ V b ⊓ V d ⊓ ⊤ ≤ V a ⊓ V d ⊓ ⊤ from
            inf_le_inf_right ⊤ (inf_le_inf_right (V d) inf_le_left))).op).hom (c0 a d) =
          (X.presheaf.map (homOfLE (show V a ⊓ V b ⊓ V d ⊓ ⊤ ≤ V b ⊓ V d ⊓ ⊤ from
            inf_le_inf_right ⊤ (inf_le_inf_right (V d) inf_le_right))).op).hom (c0 b d) +
          (X.presheaf.map (homOfLE (show V a ⊓ V b ⊓ V d ⊓ ⊤ ≤ V a ⊓ V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c0 a b)) →
        ∃ β0 : ∀ a : Fin 2, Γ(X, V a ⊓ ⊤), ∀ a b,
          c0 a b = (X.presheaf.map (homOfLE (show V a ⊓ V b ⊓ ⊤ ≤ V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β0 b) -
          (X.presheaf.map (homOfLE (show V a ⊓ V b ⊓ ⊤ ≤ V a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β0 a) := by
      intro c0 hc0
      obtain ⟨β', hβ'⟩ := R (fun a b =>
        (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
          V a ⊓ V b ≤ V a ⊓ V b ⊓ ⊤)).op).hom (c0 a b)) (by
        intro a b d
        have h := congrArg (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
          V a ⊓ V b ⊓ V d ≤ V a ⊓ V b ⊓ V d ⊓ ⊤)).op).hom (hc0 a b d)
        rw [map_add] at h
        simp only [hres] at h ⊢
        exact h)
      refine ⟨fun a => (X.presheaf.map (homOfLE (inf_le_left : V a ⊓ ⊤ ≤ V a)).op).hom (β' a),
        fun a b => ?_⟩
      have h := congrArg (X.presheaf.map (homOfLE (inf_le_left :
        V a ⊓ V b ⊓ ⊤ ≤ V a ⊓ V b)).op).hom (hβ' a b)
      rw [map_sub] at h
      simp only [hres, hid] at h
      simp only [hres]
      rw [← h]
    unfold wcpaDjTwH1
    intro c hc
    simp only [pow_zero, one_smul] at hc ⊢
    obtain ⟨β0, hβ0⟩ := key c hc
    exact ⟨β0, hβ0⟩


  set I := Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y) with hI
  have hsupp : (I.support : Set Y) = {y} := Scheme.IdealSheafData.coe_support_vanishingIdeal _
  let Yc : Y.Opens := ⟨{y}ᶜ, hy.isOpen_compl⟩
  have hoff : ∀ W : Y.Opens, W ≤ Yc → IsIso (r ∣_ W) := by
    intro W hW
    apply wc_csd_blowup_iso_off_center Y Y' I r W hbl
    rw [hsupp]
    apply Set.eq_empty_iff_forall_notMem.mpr
    rintro x ⟨hx, hxW⟩
    exact hW hxW hx
  obtain ⟨z, hz⟩ := hs2
  refine ⟨⟨Yc, ?_, hoff Yc le_rfl⟩, ?_⟩
  · rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    exact ⟨z, hz⟩
  obtain ⟨gh, hgh⟩ := hs3
  obtain ⟨U, hp, g, -, hIU⟩ := wc_beq_point_generators Y inferInstance y ⟨{y}, hy⟩ rfl 2 gh hgh
  obtain ⟨n, P, hPaff, hPle, hPsup⟩ := hs4 Y Yc
  refine ⟨n + 1, Fin.cons U.1 P, ?_, ?_, ?_⟩
  · intro a
    induction a using Fin.cases with
    | zero => rw [Fin.cons_zero]; exact U.2
    | succ i => rw [Fin.cons_succ]; exact hPaff i
  · apply eq_top_iff.mpr
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    by_cases hx : x = y
    · refine ⟨0, ?_⟩
      rw [Fin.cons_zero, hx]
      exact hp
    · have hx' : x ∈ ⨆ i, P i := by rw [hPsup]; exact hx
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx'
      refine ⟨i.succ, ?_⟩
      rw [Fin.cons_succ]
      exact hi
  intro a
  induction a using Fin.cases with
  | succ i =>
    rw [Fin.cons_succ]
    haveI := hoff (P i) (hPle i)
    haveI : IsAffine (P i).toScheme := hPaff i
    exact fexr_affine_h1 _ (IsAffine.of_isIso (r ∣_ P i))
  | zero =>
    rw [Fin.cons_zero]
    haveI hUa : IsAffine U.1.toScheme := U.2

    have hA : IsAffineOpen (U.1.ι ''ᵁ ⊤) := by rw [Scheme.Opens.ι_image_top]; exact U.2
    have hle : (⟨U.1.ι ''ᵁ ⊤, hA⟩ : Y.affineOpens) ≤ U := (Scheme.Opens.ι_image_top U.1).le
    let g' : Fin 2 → Γ(U.1.toScheme, ⊤) := fun j =>
      (U.1.ι.appIso ⊤).hom.hom ((Y.presheaf.map (homOfLE hle).op).hom (g j))
    have hK : I.ideal ⟨U.1.ι ''ᵁ ⊤, hA⟩ =
        Ideal.span (Set.range (fun j => (Y.presheaf.map (homOfLE hle).op).hom (g j))) := by
      rw [← I.map_ideal hle, hIU, Ideal.map_span, ← Set.range_comp]
      rfl
    have hfinal : Ideal.comap (U.1.ι.appIso ⊤).inv.hom (I.ideal ⟨U.1.ι ''ᵁ ⊤, hA⟩) =
        Ideal.span (Set.range g') := by
      rw [hK]
      ext x
      rw [Ideal.mem_comap]
      constructor
      · intro hx
        have := Ideal.mem_map_of_mem (U.1.ι.appIso ⊤).hom.hom hx
        rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply, Ideal.map_span,
          ← Set.range_comp] at this
        exact this
      · intro hx
        have h2 : Ideal.span (Set.range g') ≤ Ideal.comap (U.1.ι.appIso ⊤).inv.hom
            (Ideal.span (Set.range (fun j => (Y.presheaf.map (homOfLE hle).op).hom (g j)))) := by
          rw [Ideal.span_le]
          rintro _ ⟨j, rfl⟩
          rw [SetLike.mem_coe, Ideal.mem_comap]
          show (U.1.ι.appIso ⊤).inv.hom ((U.1.ι.appIso ⊤).hom.hom
            ((Y.presheaf.map (homOfLE hle).op).hom (g j))) ∈ _
          rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
          exact Ideal.subset_span ⟨j, rfl⟩
        exact h2 hx
    have e0 : ∀ (h : (⊤ : U.1.toScheme.Opens) ≤ ⊤),
        U.1.toScheme.presheaf.map (homOfLE h).op = 𝟙 _ := fun h => by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op (⊤ : U.1.toScheme.Opens)) from rfl,
        U.1.toScheme.presheaf.map_id]
    have hcomap : I.comap U.1.ι = Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g')) := by
      apply (EquivLike.injective (Scheme.IdealSheafData.equivOfIsAffine (X := U.1.toScheme)))
      simp only [Scheme.IdealSheafData.equivOfIsAffine_apply]
      rw [Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
        e0, CommRingCat.hom_id, Ideal.map_id]
      exact hfinal
    have hbl0 : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g')))
        (r ∣_ U.1) := by
      rw [← hcomap]
      exact hs7 Y Y' I r U.1 hbl

    obtain ⟨U', t, hC⟩ := wc_bp_blowup_charts g' (r ∣_ U.1) hbl0
    obtain ⟨hov, hTS⟩ := hs8 g' (r ∣_ U.1) U' t hC
    have hpoly := hs9 g' (r ∣_ U.1) U' t hC
    have hU'aff : ∀ l, IsAffineOpen (U' l) := hC.2.1

    have hloc : ∀ f : Γ((r ⁻¹ᵁ U.1).toScheme, U' 0 ⊓ U' 1), ∃ (N : ℕ) (s : Γ((r ⁻¹ᵁ U.1).toScheme, U' 0)),
        f * (((r ⁻¹ᵁ U.1).toScheme.presheaf.map (homOfLE (inf_le_left : U' 0 ⊓ U' 1 ≤ U' 0)).op).hom
          (t 0 1)) ^ N =
        ((r ⁻¹ᵁ U.1).toScheme.presheaf.map (homOfLE (inf_le_left : U' 0 ⊓ U' 1 ≤ U' 0)).op).hom s := by
      intro f
      obtain ⟨N, s, hs⟩ := @IsLocalization.Away.surj _ _ _ _ _ (t 0 1)
        ((hU'aff 0).isLocalization_basicOpen (t 0 1))
        (((r ⁻¹ᵁ U.1).toScheme.presheaf.map (homOfLE hov.ge).op).hom f)
      refine ⟨N, s, ?_⟩
      have hs' := congrArg ((r ⁻¹ᵁ U.1).toScheme.presheaf.map (homOfLE hov.le).op).hom hs
      have halg : ∀ x, algebraMap Γ((r ⁻¹ᵁ U.1).toScheme, U' 0)
          Γ((r ⁻¹ᵁ U.1).toScheme, (r ⁻¹ᵁ U.1).toScheme.basicOpen (t 0 1)) x =
          ((r ⁻¹ᵁ U.1).toScheme.presheaf.map
            (homOfLE ((r ⁻¹ᵁ U.1).toScheme.basicOpen_le (t 0 1))).op).hom x := fun _ => rfl
      rw [halg, halg, map_mul, map_pow] at hs'
      simp only [hres, hid] at hs'
      exact hs'
    have hsplit := fun f => laurent _ _ _ _
      ((r ∣_ U.1).appLE ⊤ (U' 0) (htop _ _)).hom ((r ∣_ U.1).appLE ⊤ (U' 1) (htop _ _)).hom
      ((r ⁻¹ᵁ U.1).toScheme.presheaf.map (homOfLE (inf_le_left : U' 0 ⊓ U' 1 ≤ U' 0)).op).hom
      ((r ⁻¹ᵁ U.1).toScheme.presheaf.map (homOfLE (inf_le_right : U' 0 ⊓ U' 1 ≤ U' 1)).op).hom
      (fun a => by rw [hcompat, hcompat]) (t 0 1) (t 1 0) hTS hpoly f (hloc f)
    have htw := hs11 _ U' hsplit
    obtain ⟨hZn, hZaff⟩ := hs5 Y' hAff' (r ⁻¹ᵁ U.1)
    haveI := hZn
    refine fexr_leray _ _ (𝟙 _) hZaff ?_ 2 U' hC.1 ?_ htw
    · intro V
      rw [Scheme.Hom.id_app]
      exact ⟨fun _ _ h => h, fun x => ⟨x, rfl⟩⟩
    · intro a
      rw [Scheme.Hom.id_preimage]
      exact fexr_affine_h1 _ (hU'aff a)

theorem fexr_leray_inj : ∀ (Z Y : Scheme.{u}) [IsNoetherian Z] (g : Z ⟶ Y), wcpaLccP1 g → wcpaDjFexH1 Z → wcpaDjFexH1 Y :=
by
  intro Z Y _ g hP1 hZ
  classical

  have hres : ∀ {X : Scheme.{u}} {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X A B C h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hid : ∀ {X : Scheme.{u}} {A : X.Opens} (h : A ≤ A) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro X A h x
    have e0 : X.presheaf.map (homOfLE h).op = 𝟙 _ := by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op A) from rfl, X.presheaf.map_id]
    rw [e0]
    rfl

  have hdom : ∀ (X : Scheme.{u}) {n : ℕ} (W : Fin n → X.Opens) (a₀ : Fin n), (∀ a, W a ≤ W a₀) →
      wcpaP1rRawH1 W := by
    intro X n W a₀ hW c hc
    refine ⟨fun a => (X.presheaf.map (homOfLE (le_inf (hW a) le_rfl : W a ≤ W a₀ ⊓ W a)).op).hom
      (c a₀ a), fun a b => ?_⟩
    have hT : W a ⊓ W b ≤ W a₀ ⊓ W a ⊓ W b :=
      le_inf (le_inf (inf_le_left.trans (hW a)) inf_le_left) inf_le_right
    have h := congrArg (X.presheaf.map (homOfLE hT).op).hom (hc a₀ a b)
    rw [map_add] at h
    simp only [hres, hid] at h
    simp only [hres]
    linear_combination -h

  have cover_change : ∀ (X : Scheme.{u}) {m n : ℕ} (U : Fin m → X.Opens) (D : Fin n → X.Opens),
      (⨆ a, U a) = (⨆ k, D k) → wcpaP1rRawH1 D → (∀ k, wcpaP1rRawH1 (fun a => U a ⊓ D k)) →
      wcpaP1rRawH1 U := by
    intro X m n U D hUD hD hloc c hc
    have glue : ∀ {N : ℕ} (W : Fin N → X.Opens) (V : X.Opens) (hWV : ∀ k, W k ≤ V),
        (∀ x ∈ V, ∃ k, x ∈ W k) → ∀ t : ∀ k, Γ(X, W k),
        (∀ k l, (X.presheaf.map (homOfLE (inf_le_left : W k ⊓ W l ≤ W k)).op).hom (t k) =
          (X.presheaf.map (homOfLE (inf_le_right : W k ⊓ W l ≤ W l)).op).hom (t l)) →
        ∃ s : Γ(X, V), ∀ k, (X.presheaf.map (homOfLE (hWV k)).op).hom s = t k := by
      intro N W V hWV hV t ht
      obtain ⟨s, hs, -⟩ := X.sheaf.existsUnique_gluing' (fun i : ULift.{u} (Fin N) => W i.down) V
        (fun i => homOfLE (hWV i.down)) (by
          intro x hx
          obtain ⟨k, hk⟩ := hV x hx
          exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨k⟩, hk⟩) (fun i => t i.down) (by
          intro i j
          exact ht i.down j.down)
      exact ⟨s, fun k => hs ⟨k⟩⟩
    have sep : ∀ {N : ℕ} (W : Fin N → X.Opens) (V : X.Opens) (hWV : ∀ k, W k ≤ V),
        (∀ x ∈ V, ∃ k, x ∈ W k) → ∀ s t : Γ(X, V),
        (∀ k, (X.presheaf.map (homOfLE (hWV k)).op).hom s =
          (X.presheaf.map (homOfLE (hWV k)).op).hom t) → s = t := by
      intro N W V hWV hV s t hst
      exact X.sheaf.eq_of_locally_eq' (fun i : ULift.{u} (Fin N) => W i.down) V
        (fun i => homOfLE (hWV i.down)) (by
          intro x hx
          obtain ⟨k, hk⟩ := hV x hx
          exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨k⟩, hk⟩) s t (fun i => hst i.down)
    have memU : ∀ x, x ∈ (⨆ a, U a) → ∃ k, x ∈ D k := by
      intro x hx
      rw [hUD] at hx
      exact TopologicalSpace.Opens.mem_iSup.mp hx
    have memD : ∀ x k, x ∈ D k → ∃ a, x ∈ U a := by
      intro x k hx
      have hx' : x ∈ (⨆ k, D k) := TopologicalSpace.Opens.mem_iSup.mpr ⟨k, hx⟩
      rw [← hUD] at hx'
      exact TopologicalSpace.Opens.mem_iSup.mp hx'
    have hk : ∀ k, ∃ h : ∀ a, Γ(X, U a ⊓ D k), ∀ a b,
        (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left)
          (inf_le_right.trans inf_le_left) : (U a ⊓ D k) ⊓ (U b ⊓ D k) ≤ U a ⊓ U b)).op).hom (c a b) =
        (X.presheaf.map (homOfLE (inf_le_right : (U a ⊓ D k) ⊓ (U b ⊓ D k) ≤ U b ⊓ D k)).op).hom
          (h b) -
        (X.presheaf.map (homOfLE (inf_le_left : (U a ⊓ D k) ⊓ (U b ⊓ D k) ≤ U a ⊓ D k)).op).hom
          (h a) := by
      intro k
      refine hloc k (fun a b => (X.presheaf.map (homOfLE (le_inf (inf_le_left.trans inf_le_left)
        (inf_le_right.trans inf_le_left) : (U a ⊓ D k) ⊓ (U b ⊓ D k) ≤ U a ⊓ U b)).op).hom
          (c a b)) ?_
      intro a b d
      try dsimp only
      rw [hres, hres, hres]
      have e := congrArg (X.presheaf.map (homOfLE (show (U a ⊓ D k) ⊓ (U b ⊓ D k) ⊓ (U d ⊓ D k) ≤
        U a ⊓ U b ⊓ U d from fun x hx => ⟨⟨hx.1.1.1, hx.1.2.1⟩, hx.2.1⟩)).op).hom (hc a b d)
      rw [map_add, hres, hres, hres] at e
      exact e
    choose h hh using hk
    have hg : ∀ k l, ∃ g : Γ(X, D k ⊓ D l), ∀ a,
        (X.presheaf.map (homOfLE (inf_le_right : U a ⊓ (D k ⊓ D l) ≤ D k ⊓ D l)).op).hom g =
        (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_left) :
          U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D k)).op).hom (h k a) -
        (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_right) :
          U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D l)).op).hom (h l a) := by
      intro k l
      refine glue (fun a => U a ⊓ (D k ⊓ D l)) (D k ⊓ D l) (fun a => inf_le_right) ?_
        (fun a => (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_left) :
          U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D k)).op).hom (h k a) -
        (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_right) :
          U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D l)).op).hom (h l a)) ?_
      · intro x hx
        obtain ⟨a, ha⟩ := memD x k hx.1
        exact ⟨a, ha, hx⟩
      · intro a b
        try dsimp only
        rw [map_sub, map_sub, hres, hres, hres, hres]
        have e1 := congrArg (X.presheaf.map (homOfLE (show (U a ⊓ (D k ⊓ D l)) ⊓ (U b ⊓ (D k ⊓ D l)) ≤
          (U a ⊓ D k) ⊓ (U b ⊓ D k) from
            fun x hx => ⟨⟨hx.1.1, hx.1.2.1⟩, ⟨hx.2.1, hx.2.2.1⟩⟩)).op).hom (hh k a b)
        have e2 := congrArg (X.presheaf.map (homOfLE (show (U a ⊓ (D k ⊓ D l)) ⊓ (U b ⊓ (D k ⊓ D l)) ≤
          (U a ⊓ D l) ⊓ (U b ⊓ D l) from
            fun x hx => ⟨⟨hx.1.1, hx.1.2.2⟩, ⟨hx.2.1, hx.2.2.2⟩⟩)).op).hom (hh l a b)
        rw [map_sub, hres, hres, hres] at e1 e2
        have e3 := e1.symm.trans e2
        linear_combination (-1 : _) * e3
    choose g hgG using hg
    have hG' : ∀ k l a (O : X.Opens) (hO : O ≤ U a ⊓ (D k ⊓ D l)),
        (X.presheaf.map (homOfLE (hO.trans (inf_le_right : U a ⊓ (D k ⊓ D l) ≤ D k ⊓ D l))).op).hom
          (g k l) =
        (X.presheaf.map (homOfLE (hO.trans (le_inf inf_le_left (inf_le_right.trans inf_le_left) :
          U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D k))).op).hom (h k a) -
        (X.presheaf.map (homOfLE (hO.trans (le_inf inf_le_left (inf_le_right.trans inf_le_right) :
          U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D l))).op).hom (h l a) := by
      intro k l a O hO
      have e := congrArg (X.presheaf.map (homOfLE hO).op).hom (hgG k l a)
      rw [map_sub, hres, hres, hres] at e
      exact e
    obtain ⟨e, he⟩ := hD g (by
      intro k l j
      refine sep (fun a => U a ⊓ (D k ⊓ D l ⊓ D j)) (D k ⊓ D l ⊓ D j) (fun a => inf_le_right) ?_
        _ _ ?_
      · intro x hx
        obtain ⟨a, ha⟩ := memD x k hx.1.1
        exact ⟨a, ha, hx⟩
      · intro a
        try dsimp only
        rw [map_add, hres, hres, hres]
        rw [hG' k j a (U a ⊓ (D k ⊓ D l ⊓ D j)) (fun x hx => ⟨hx.1, hx.2.1.1, hx.2.2⟩),
          hG' l j a (U a ⊓ (D k ⊓ D l ⊓ D j)) (fun x hx => ⟨hx.1, hx.2.1.2, hx.2.2⟩),
          hG' k l a (U a ⊓ (D k ⊓ D l ⊓ D j)) (fun x hx => ⟨hx.1, hx.2.1.1, hx.2.1.2⟩)]
        ring)
    have h2 : ∀ k l a,
        (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_left) :
          U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D k)).op).hom (h k a) +
        (X.presheaf.map (homOfLE (inf_le_right.trans inf_le_left :
          U a ⊓ (D k ⊓ D l) ≤ D k)).op).hom (e k) =
        (X.presheaf.map (homOfLE (le_inf inf_le_left (inf_le_right.trans inf_le_right) :
          U a ⊓ (D k ⊓ D l) ≤ U a ⊓ D l)).op).hom (h l a) +
        (X.presheaf.map (homOfLE (inf_le_right.trans inf_le_right :
          U a ⊓ (D k ⊓ D l) ≤ D l)).op).hom (e l) := by
      intro k l a
      have e1 := hgG k l a
      have e2 := congrArg (X.presheaf.map (homOfLE (inf_le_right :
        U a ⊓ (D k ⊓ D l) ≤ D k ⊓ D l)).op).hom (he k l)
      rw [map_sub, hres, hres] at e2
      have e3 := e1.symm.trans e2
      linear_combination e3
    have hβ : ∀ a, ∃ β : Γ(X, U a), ∀ k,
        (X.presheaf.map (homOfLE (inf_le_left : U a ⊓ D k ≤ U a)).op).hom β =
        h k a + (X.presheaf.map (homOfLE (inf_le_right : U a ⊓ D k ≤ D k)).op).hom (e k) := by
      intro a
      refine glue (fun k => U a ⊓ D k) (U a) (fun k => inf_le_left) ?_
        (fun k => h k a + (X.presheaf.map (homOfLE (inf_le_right : U a ⊓ D k ≤ D k)).op).hom (e k))
        ?_
      · intro x hx
        obtain ⟨k, hk⟩ := memU x (TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hx⟩)
        exact ⟨k, hx, hk⟩
      · intro k l
        try dsimp only
        rw [map_add, map_add, hres, hres]
        have e := congrArg (X.presheaf.map (homOfLE (show (U a ⊓ D k) ⊓ (U a ⊓ D l) ≤
          U a ⊓ (D k ⊓ D l) from fun x hx => ⟨hx.1.1, hx.1.2, hx.2.2⟩)).op).hom (h2 k l a)
        rw [map_add, map_add, hres, hres, hres, hres] at e
        exact e
    choose β hβ using hβ
    have hβ' : ∀ a k (O : X.Opens) (hO : O ≤ U a ⊓ D k),
        (X.presheaf.map (homOfLE (hO.trans (inf_le_left : U a ⊓ D k ≤ U a))).op).hom (β a) =
        (X.presheaf.map (homOfLE hO).op).hom (h k a) +
        (X.presheaf.map (homOfLE (hO.trans (inf_le_right : U a ⊓ D k ≤ D k))).op).hom (e k) := by
      intro a k O hO
      have e := congrArg (X.presheaf.map (homOfLE hO).op).hom (hβ a k)
      rw [map_add, hres, hres] at e
      exact e
    refine ⟨β, fun a b => ?_⟩
    refine sep (fun k => U a ⊓ U b ⊓ D k) (U a ⊓ U b) (fun k => inf_le_left) ?_ _ _ ?_
    · intro x hx
      obtain ⟨k, hk⟩ := memU x (TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hx.1⟩)
      exact ⟨k, hx, hk⟩
    · intro k
      try dsimp only
      rw [map_sub, hres, hres]
      rw [hβ' b k (U a ⊓ U b ⊓ D k) (fun x hx => ⟨hx.1.2, hx.2⟩),
        hβ' a k (U a ⊓ U b ⊓ D k) (fun x hx => ⟨hx.1.1, hx.2⟩)]
      have e := congrArg (X.presheaf.map (homOfLE (show U a ⊓ U b ⊓ D k ≤
        (U a ⊓ D k) ⊓ (U b ⊓ D k) from
          fun x hx => ⟨⟨hx.1.1, hx.2⟩, ⟨hx.1.2, hx.2⟩⟩)).op).hom (hh k a b)
      rw [map_sub, hres, hres, hres] at e
      linear_combination e

  have tw_to_raw : ∀ (X : Scheme.{u}) (L : wcpaDjCoc X), wcpaDjTwH1 L ⊤ (wcStructMod X) 0 →
      wcpaP1rRawH1 L.V := by
    intro X L hT
    unfold wcpaDjTwH1 at hT
    simp only [pow_zero, one_smul] at hT
    have key : ∀ c0 : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b ⊓ ⊤),
        (∀ a b d,
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V d ⊓ ⊤ from
            inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_left))).op).hom (c0 a d) =
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d ⊓ ⊤ from
            inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_right))).op).hom (c0 b d) +
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c0 a b)) →
        ∃ β0 : ∀ a : Fin L.m, Γ(X, L.V a ⊓ ⊤), ∀ a b,
          c0 a b = (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β0 b) -
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β0 a) := by
      intro c0 hc0
      exact hT c0 hc0
    intro c hc
    obtain ⟨β0, hβ0⟩ := key (fun a b =>
      (X.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b)).op).hom (c a b))
      (by
        intro a b d
        have h := congrArg (X.presheaf.map (homOfLE (inf_le_left :
          L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ L.V d)).op).hom (hc a b d)
        rw [map_add] at h
        simp only [hres] at h ⊢
        exact h)
    refine ⟨fun a => (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
      L.V a ≤ L.V a ⊓ ⊤)).op).hom (β0 a), fun a b => ?_⟩
    have h := congrArg (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
      L.V a ⊓ L.V b ≤ L.V a ⊓ L.V b ⊓ ⊤)).op).hom (hβ0 a b)
    rw [map_sub] at h
    simp only [hres, hid] at h
    simp only [hres]
    exact h

  have raw_to_tw : ∀ (X : Scheme.{u}) (L : wcpaDjCoc X), wcpaP1rRawH1 L.V →
      wcpaDjTwH1 L ⊤ (wcStructMod X) 0 := by
    intro X L R
    have key : ∀ c0 : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b ⊓ ⊤),
        (∀ a b d,
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V d ⊓ ⊤ from
            inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_left))).op).hom (c0 a d) =
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d ⊓ ⊤ from
            inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_right))).op).hom (c0 b d) +
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c0 a b)) →
        ∃ β0 : ∀ a : Fin L.m, Γ(X, L.V a ⊓ ⊤), ∀ a b,
          c0 a b = (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β0 b) -
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β0 a) := by
      intro c0 hc0
      obtain ⟨β', hβ'⟩ := R (fun a b =>
        (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
          L.V a ⊓ L.V b ≤ L.V a ⊓ L.V b ⊓ ⊤)).op).hom (c0 a b)) (by
        intro a b d
        have h := congrArg (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
          L.V a ⊓ L.V b ⊓ L.V d ≤ L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤)).op).hom (hc0 a b d)
        rw [map_add] at h
        simp only [hres] at h ⊢
        exact h)
      refine ⟨fun a => (X.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ ⊤ ≤ L.V a)).op).hom (β' a),
        fun a b => ?_⟩
      have h := congrArg (X.presheaf.map (homOfLE (inf_le_left :
        L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b)).op).hom (hβ' a b)
      rw [map_sub] at h
      simp only [hres, hid] at h
      simp only [hres]
      rw [← h]
    unfold wcpaDjTwH1
    intro c hc
    simp only [pow_zero, one_smul] at hc ⊢
    obtain ⟨β0, hβ0⟩ := key c hc
    exact ⟨β0, hβ0⟩

  have refine_aff : ∀ {m : ℕ} (O : Fin m → Z.Opens), ∃ (M : ℕ) (α : Fin M → Fin m)
      (P : Fin M → Z.Opens), (∀ s, IsAffineOpen (P s)) ∧ (∀ s, P s ≤ O (α s)) ∧
        (⨆ s, P s) = ⨆ a, O a := by
    intro m O
    have hsub : ((⨆ a, O a : Z.Opens) : Set Z) ⊆
        ⋃ i : {p : Z.affineOpens × Fin m // (p.1 : Z.Opens) ≤ O p.2}, ((i.1.1 : Z.Opens) : Set Z) := by
      intro x hx
      obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      obtain ⟨U', hU', hxU', hU'le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Z)) hxa
      exact Set.mem_iUnion.mpr ⟨⟨(⟨U', hU'⟩, a), hU'le⟩, hxU'⟩
    obtain ⟨t, ht⟩ := (TopologicalSpace.NoetherianSpace.isCompact _).elim_finite_subcover
      (fun i : {p : Z.affineOpens × Fin m // (p.1 : Z.Opens) ≤ O p.2} => ((i.1.1 : Z.Opens) : Set Z))
      (fun i => (i.1.1 : Z.Opens).isOpen) hsub
    refine ⟨t.card, fun k => (t.equivFin.symm k).1.1.2,
      fun k => ((t.equivFin.symm k).1.1.1 : Z.Opens),
      fun k => (t.equivFin.symm k).1.1.1.2, fun k => (t.equivFin.symm k).1.2, ?_⟩
    apply le_antisymm
    · exact iSup_le fun k => ((t.equivFin.symm k).1.2).trans (le_iSup O _)
    · intro x hx
      obtain ⟨i, hi, hxi⟩ := Set.mem_iUnion₂.mp (ht hx)
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨t.equivFin ⟨i, hi⟩, ?_⟩
      simp only [Equiv.symm_apply_apply]
      exact hxi

  have pushdown : ∀ {m : ℕ} (V : Fin m → Y.Opens), wcpaP1rRawH1 (fun a => g ⁻¹ᵁ V a) →
      wcpaP1rRawH1 V := by
    intro m V hR c hc
    have hnat : ∀ {A B : Y.Opens} (h : B ≤ A) (x : Γ(Y, A)),
        (g.app B).hom ((Y.presheaf.map (homOfLE h).op).hom x) =
          (Z.presheaf.map (homOfLE (g.preimage_mono h)).op).hom ((g.app A).hom x) := by
      intro A B h x
      rw [← CommRingCat.comp_apply, g.naturality, CommRingCat.comp_apply]
      rfl
    obtain ⟨β', hβ'⟩ := hR (fun a b => (g.app (V a ⊓ V b)).hom (c a b)) (by
      intro a b d
      have h := congrArg (g.app (V a ⊓ V b ⊓ V d)).hom (hc a b d)
      rw [map_add, hnat, hnat, hnat] at h
      exact h)
    have hsurj : ∀ a, ∃ β : Γ(Y, V a), (g.app (V a)).hom β = β' a :=
      fun a => (hP1 (V a)).2 (β' a)
    choose β hβ using hsurj
    refine ⟨β, fun a b => ?_⟩
    apply (hP1 (V a ⊓ V b)).1
    rw [map_sub, hnat, hnat, hβ, hβ]
    exact hβ' a b

  intro L hL
  obtain ⟨-, hcov, -, -⟩ := hL
  apply raw_to_tw Y L
  apply pushdown L.V
  obtain ⟨M, α, P, hPa, hPle, hPsup⟩ := refine_aff (fun a => g ⁻¹ᵁ L.V a)
  have htopZ : (⨆ a, g ⁻¹ᵁ L.V a) = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]
  have hOKP : wcpaDjCocOK (⟨M, P, fun _ _ => 1⟩ : wcpaDjCoc Z) :=
    ⟨hPa, hPsup.trans htopZ, fun _ => rfl, fun _ _ _ => by simp⟩
  have hRawP : wcpaP1rRawH1 P := tw_to_raw Z ⟨M, P, fun _ _ => 1⟩ (hZ _ hOKP)
  exact cover_change Z (fun a => g ⁻¹ᵁ L.V a) P hPsup.symm hRawP
    (fun k => hdom Z (fun a => g ⁻¹ᵁ L.V a ⊓ P k) (α k)
      (fun a => le_inf (inf_le_right.trans (hPle k)) inf_le_right))

theorem fexr_proper_birational_P1 : ∀ (Z X : Scheme.{u}) (h : Z ⟶ X), IsProper h → AlgebraicGeometry.IsIntegral Z → AlgebraicGeometry.IsIntegral X → (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) → (∃ V : X.Opens, V ≠ ⊥ ∧ IsIso (h ∣_ V)) → wcpaLccP1 h :=
by
  have s1 : ∀ (Z X : Scheme.{u}) (h : Z ⟶ X) (V : X.Opens) (hV : IsIso (h ∣_ V)), (∀ W : X.Opens, W ≤ V → Function.Bijective (h.app W).hom) ∧ (V : Set X) ⊆ Set.range ⇑h := by
    intro Z X h V hV
    constructor
    · intro W hle
      have h1 : IsIso ((h ∣_ V).app (V.ι ⁻¹ᵁ W)) := inferInstance
      rw [morphismRestrict_app, eqToHom_op, eqToHom_map] at h1
      have hE : ∀ {A B : CommRingCat.{u}} (e : A = B), IsIso (eqToHom e) :=
        fun e => ⟨⟨eqToHom e.symm, by simp, by simp⟩⟩
      have h2 : IsIso (h.app (V.ι ''ᵁ (V.ι ⁻¹ᵁ W))) := by
        have := hE (congrArg (fun U => Z.presheaf.obj U) (Eq.refl (Opposite.op (h ⁻¹ᵁ (V.ι ''ᵁ (V.ι ⁻¹ᵁ W))))))
        exact @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (hE _) h1
      have h3 := ConcreteCategory.bijective_of_isIso (h.app (V.ι ''ᵁ (V.ι ⁻¹ᵁ W)))
      have heq : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr hle
      have tr : ∀ U' : X.Opens, U' = W → Function.Bijective (h.app U').hom →
          Function.Bijective (h.app W).hom := by
        rintro _ rfl hh; exact hh
      exact tr _ heq h3
    · intro x hx
      obtain ⟨z, hz⟩ := (h ∣_ V).surjective ⟨x, hx⟩
      refine ⟨z.1, ?_⟩
      rw [← morphismRestrict_base_coe, hz]
  have s2 : ∀ (Z X : Scheme.{u}) (h : Z ⟶ X) (hX : AlgebraicGeometry.IsIntegral X) (V : X.Opens) (hV0 : V ≠ ⊥) (hbij : ∀ W : X.Opens, W ≤ V → Function.Bijective (h.app W).hom) (W : X.Opens), Function.Injective (h.app W).hom := by
    intro Z X h hX V hV0 hbij W
    by_cases hW : W = ⊥
    · subst hW
      exact Function.injective_of_subsingleton _
    · have hne : ((W ⊓ V : X.Opens) : Set X).Nonempty := by
        rw [← ne_eq, TopologicalSpace.Opens.ne_bot_iff_nonempty] at hW
        rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hV0
        obtain ⟨x, hx1, hx2⟩ := nonempty_preirreducible_inter W.isOpen V.isOpen hW hV0
        exact ⟨x, hx1, hx2⟩
      have : Nonempty (W ⊓ V : X.Opens) := hne.to_subtype
      have hρ := map_injective_of_isIntegral X (homOfLE (inf_le_left : W ⊓ V ≤ W))
      have hc := (hbij _ inf_le_right).1.comp hρ
      have hnat := h.naturality (homOfLE (inf_le_left : W ⊓ V ≤ W)).op
      rw [← RingHom.coe_comp, ← CommRingCat.hom_comp, hnat, CommRingCat.hom_comp,
        RingHom.coe_comp] at hc
      exact hc.of_comp
  have s3 : ∀ (Z X : Scheme.{u}) (h : Z ⟶ X) (hp : IsProper h) (W : X.Opens) (hW : IsAffineOpen W), (h.app W).hom.IsIntegral := by
    intro Z X h hp W hW
    have gen : ∀ {R S T : CommRingCat.{u}} (f : R ⟶ S) (g : S ⟶ T) [IsIso g],
        (f ≫ g).hom.IsIntegral → f.hom.IsIntegral := by
      intro R S T f g _ hfg
      have e : f = (f ≫ g) ≫ inv g := by simp
      rw [e, CommRingCat.hom_comp]
      exact RingHom.IsIntegral.trans _ _ hfg
        (RingHom.isIntegral_of_surjective _ (ConcreteCategory.bijective_of_isIso (inv g)).2)
    have : IsAffine W := hW
    have h1 := isIntegral_appTop_of_universallyClosed (h ∣_ W)
    rw [morphismRestrict_appTop, eqToHom_op, eqToHom_map] at h1
    have hE : ∀ {A B : CommRingCat.{u}} (e : A = B), IsIso (eqToHom e) :=
      fun e => ⟨⟨eqToHom e.symm, by simp, by simp⟩⟩
    have h2 := @gen _ _ _ _ _ (hE _) h1
    have tr : ∀ U' : X.Opens, U' = W → (h.app U').hom.IsIntegral → (h.app W).hom.IsIntegral := by
      rintro _ rfl hh; exact hh
    exact tr _ (Scheme.Opens.ι_image_top W) h2
  have s4 : ∀ (X : Scheme.{u}) (hX : AlgebraicGeometry.IsIntegral X) (hnorm : ∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) (U : X.Opens) (hU : IsAffineOpen U) (hne : (U : Set X).Nonempty), IsIntegrallyClosed Γ(X, U) := by
    intro X hX hnorm U hU hne
    have : Nonempty U := hne.to_subtype
    apply IsIntegrallyClosed.of_localization_maximal
    intro p hp0 hpm
    let y : PrimeSpectrum Γ(X, U) := ⟨p, hpm.isPrime⟩
    have hy : hU.fromSpec y ∈ U := by
      have : hU.fromSpec y ∈ Set.range hU.fromSpec := ⟨_, rfl⟩
      rwa [hU.range_fromSpec] at this
    letI := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨hU.fromSpec y, hy⟩
    have hloc : IsLocalization.AtPrime (X.presheaf.stalk (hU.fromSpec y)) p :=
      hU.isLocalization_stalk' y hy
    have e := IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p)
      (X.presheaf.stalk (hU.fromSpec y))
    have := hnorm (hU.fromSpec y)
    exact IsIntegrallyClosed.of_equiv e.symm.toRingEquiv
  have s5 : ∀ (Z X : Scheme.{u}) (h : Z ⟶ X) (hZ : AlgebraicGeometry.IsIntegral Z) (hX : AlgebraicGeometry.IsIntegral X) (V : X.Opens) (hV0 : V ≠ ⊥) (hbij : ∀ W : X.Opens, W ≤ V → Function.Bijective (h.app W).hom) (hrange : (V : Set X) ⊆ Set.range ⇑h) (W : X.Opens) (hW : IsAffineOpen W) (hWne : (W : Set X).Nonempty) (hic : IsIntegrallyClosed Γ(X, W)) (hinj : Function.Injective (h.app W).hom) (hint : (h.app W).hom.IsIntegral), Function.Surjective (h.app W).hom := by
    intro Z X h hZ hX V hV0 hbij hrange W hW hWne hic hinj hint
    intro b
    have hne : ((W ⊓ V : X.Opens) : Set X).Nonempty := by
      rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hV0
      obtain ⟨x, hx1, hx2⟩ := nonempty_preirreducible_inter W.isOpen V.isOpen hWne hV0
      exact ⟨x, hx1, hx2⟩
    obtain ⟨x, hxW, hxV⟩ := hne
    obtain ⟨s, hsle, hxs⟩ := hW.exists_basicOpen_le (V := W ⊓ V) ⟨x, hxW, hxV⟩ hxW
    have : Nonempty W := ⟨⟨x, hxW⟩⟩
    have hAdom : IsDomain Γ(X, W) := IsIntegral.component_integral W
    obtain ⟨z, rfl⟩ := hrange hxV
    have hzs : z ∈ h ⁻¹ᵁ X.basicOpen s := hxs
    have : Nonempty (h ⁻¹ᵁ X.basicOpen s) := ⟨⟨z, hzs⟩⟩
    have : Nonempty (h ⁻¹ᵁ W) := ⟨⟨z, hxW⟩⟩
    have hBdom : IsDomain Γ(Z, h ⁻¹ᵁ W) := IsIntegral.component_integral _
    have hs0 : s ≠ 0 := by
      rintro rfl
      rw [Scheme.basicOpen_zero] at hxs
      exact hxs
    have hloc := hW.isLocalization_basicOpen s
    have hψ := hbij _ (hsle.trans inf_le_right)
    let i : X.basicOpen s ⟶ W := homOfLE (X.basicOpen_le s)
    have halg : algebraMap Γ(X, W) Γ(X, X.basicOpen s) = (X.presheaf.map i.op).hom := rfl
    have key : ∀ a : Γ(X, W), (h.app (X.basicOpen s)).hom (algebraMap Γ(X, W) Γ(X, X.basicOpen s) a)
        = (Z.presheaf.map ((TopologicalSpace.Opens.map h.base).map i).op).hom ((h.app W).hom a) := by
      intro a
      have := congrArg (fun f => f.hom a) (h.naturality i.op)
      exact this
    have hρZinj : Function.Injective
        (Z.presheaf.map ((TopologicalSpace.Opens.map h.base).map i).op).hom :=
      map_injective_of_isIntegral Z _
    obtain ⟨c, hc⟩ := hψ.2
      ((Z.presheaf.map ((TopologicalSpace.Opens.map h.base).map i).op).hom b)
    obtain ⟨⟨a, ⟨t, ht⟩⟩, hat⟩ := IsLocalization.surj (Submonoid.powers s) c
    simp only at hat
    obtain ⟨n, rfl⟩ := ht
    have ht0 : s ^ n ≠ 0 := pow_ne_zero n hs0
    have star : (h.app W).hom (s ^ n) * b = (h.app W).hom a := by
      apply hρZinj
      rw [map_mul, ← key, ← hc, ← map_mul, mul_comm, hat, key]
    obtain ⟨p, hpm, hpb⟩ := hint b
    have hq : Polynomial.eval a (p.scaleRoots (s ^ n)) = 0 := by
      apply hinj
      rw [← Polynomial.eval₂_at_apply, ← star, Polynomial.scaleRoots_eval₂_mul, hpb, mul_zero,
        map_zero]
    let K := FractionRing Γ(X, W)
    let xK : K := IsLocalization.mk' K a ⟨s ^ n, mem_nonZeroDivisors_of_ne_zero ht0⟩
    have hx : xK * algebraMap _ K (s ^ n) = algebraMap _ K a := IsLocalization.mk'_spec _ _ _
    have hft : algebraMap _ K (s ^ n) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective Γ(X, W) K)).mpr ht0
    have hxint : IsIntegral Γ(X, W) xK := by
      refine ⟨p, hpm, ?_⟩
      have e1 := Polynomial.scaleRoots_eval₂_mul (p := p) (algebraMap Γ(X, W) K) xK (s ^ n)
      rw [mul_comm, hx, Polynomial.eval₂_at_apply, hq, map_zero] at e1
      exact (mul_eq_zero.mp e1.symm).resolve_left (pow_ne_zero _ hft)
    obtain ⟨a', ha'⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hxint
    have haa : a = s ^ n * a' := by
      apply IsFractionRing.injective Γ(X, W) K
      rw [map_mul, ha', ← hx, mul_comm]
    refine ⟨a', ?_⟩
    have hφt : (h.app W).hom (s ^ n) ≠ 0 := by
      intro h0
      apply ht0
      apply hinj
      rw [h0, map_zero]
    apply mul_left_cancel₀ hφt
    rw [star, haa, map_mul]
  have s6 : ∀ (Z X : Scheme.{u}) (h : Z ⟶ X) (hinj : ∀ W : X.Opens, Function.Injective (h.app W).hom) (hsurj : ∀ W : X.Opens, IsAffineOpen W → (W : Set X).Nonempty → Function.Surjective (h.app W).hom) (W : X.Opens), Function.Bijective (h.app W).hom := by
    intro Z X h hinj hsurj W
    refine ⟨hinj W, fun b => ?_⟩
    let ι := {U : X.Opens // IsAffineOpen U ∧ U ≤ W ∧ (U : Set X).Nonempty}
    let U : ι → X.Opens := fun i => i.1
    let iUW : ∀ i, U i ⟶ W := fun i => homOfLE i.2.2.1
    have hcov : W ≤ iSup U := by
      intro x hx
      obtain ⟨U', hU', hxU', hle⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens) hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U', hU', hle, ⟨x, hxU'⟩⟩, hxU'⟩
    have nat : ∀ {U₁ U₂ : X.Opens} (i : U₁ ⟶ U₂) (a : Γ(X, U₂)),
        (h.app U₁).hom ((X.presheaf.map i.op).hom a) =
          (Z.presheaf.map ((TopologicalSpace.Opens.map h.base).map i).op).hom ((h.app U₂).hom a) := by
      intro U₁ U₂ i a
      have := congrArg (fun f => f.hom a) (h.naturality i.op)
      exact this
    have hpiece : ∀ i : ι, ∃ a : Γ(X, U i), (h.app (U i)).hom a =
        (Z.presheaf.map ((TopologicalSpace.Opens.map h.base).map (iUW i)).op).hom b :=
      fun i => hsurj _ i.2.1 i.2.2.2 _
    choose a ha using hpiece
    have hcompat : TopCat.Presheaf.IsCompatible X.presheaf U a := by
      intro i j
      apply hinj
      change (h.app _).hom ((X.presheaf.map _).hom _) = (h.app _).hom ((X.presheaf.map _).hom _)
      rw [nat, nat, ha, ha, ← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
        ← Functor.map_comp, ← Functor.map_comp]
      rfl
    obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf U W iUW hcov a hcompat
    let s' : Γ(X, W) := s
    have hs' : ∀ i, (X.presheaf.map (iUW i).op).hom s' = a i := hs
    refine ⟨s', ?_⟩
    apply TopCat.Sheaf.eq_of_locally_eq' Z.sheaf (fun i => h ⁻¹ᵁ U i) (h ⁻¹ᵁ W)
      (fun i => (TopologicalSpace.Opens.map h.base).map (iUW i))
    · rw [← Scheme.Hom.preimage_iSup]
      exact fun z hz => hcov hz
    · intro i
      change (Z.presheaf.map ((TopologicalSpace.Opens.map h.base).map (iUW i)).op).hom
          ((h.app W).hom s') =
        (Z.presheaf.map ((TopologicalSpace.Opens.map h.base).map (iUW i)).op).hom b
      rw [← nat (iUW i) s', hs' i, ha i]
  intro Z X h hprop hZ hX hnorm ⟨V, hV0, hVi⟩
  obtain ⟨hbij, hrange⟩ := s1 Z X h V hVi
  have hinj := s2 Z X h hX V hV0 hbij
  have hsurj : ∀ W : X.Opens, IsAffineOpen W → (W : Set X).Nonempty →
      Function.Surjective (h.app W).hom := fun W hW hWne =>
    s5 Z X h hZ hX V hV0 hbij hrange W hW hWne (s4 X hX hnorm W hW hWne) (hinj W)
      (s3 Z X h hprop W hW)
  intro W
  exact s6 Z X h hinj hsurj W

theorem fex_h1_regular : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B],
    IsRegularLocalRing B → ringKrullDim B = 2 →
    ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of B)), IsProper f → AlgebraicGeometry.IsIntegral X →
      (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
      (∃ U : (Spec (.of B)).Opens, U ≠ ⊥ ∧ IsIso (f ∣_ U)) → wcpaDjFexH1 X :=
by
  intro B _ _ _ hreg hdim X f hf hX hnorm hU
  haveI := hreg
  obtain ⟨hdomB, hufd⟩ := wc_fco_regular_local_ufd B
  haveI := hdomB
  haveI := hufd

  have htow : ∀ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of B)), fexPtTower B Y g → wcpaDjFexH1 Y := by
    intro Y g hT
    induction hT with
    | base => exact fexr_affine_h1 _ inferInstance
    | @step Y0 Y1 g0 y hy r hT0 hgy hbl ih =>
      obtain ⟨hint0, hnoeth0, hprop0, -, -, haff0, hreg0, hnorm0, hdim0⟩ :=
        fexr_tower_props B hreg hdim Y0 g0 hT0
      obtain ⟨hint1, hnoeth1, hprop1, -, -, haff1, -, -, -⟩ :=
        fexr_tower_props B hreg hdim Y1 (r ≫ g0) (fexPtTower.step g0 y hy r hT0 hgy hbl)
      haveI := hnoeth0
      haveI := hnoeth1
      haveI := hprop0
      haveI := hprop1
      obtain ⟨hiso, k, V, hVaff, hVsup, hVH1⟩ :=
        fexr_point_blowup_local Y0 hint0 haff0 y hy (hreg0 y) (hdim0 y hy) Y1 r hbl haff1
      have hrprop : IsProper r := IsProper.of_comp r g0
      have hP1 : wcpaLccP1 r := fexr_proper_birational_P1 Y1 Y0 r hrprop hint1 hint0 hnorm0 hiso
      have hok : wcpaDjCocOK (⟨k, V, fun _ _ => 1⟩ : wcpaDjCoc Y0) := by
        unfold wcpaDjCocOK
        refine ⟨hVaff, hVsup, fun _ => rfl, fun _ _ _ => ?_⟩
        simp
      exact fexr_leray Y1 Y0 r haff1 hP1 k V hVsup hVH1 (ih _ hok)

  obtain ⟨m, a, b, hb, hcop, hdomin⟩ := fexr_dom_charts B X f hf hX hU
  have hJ : ∀ l, ∃ N : ℕ, IsLocalRing.maximalIdeal B ^ N ≤ Ideal.span {a l, b l} :=
    fun l => fexr_coprime_primary B hdim (a l) (b l) (hb l) (hcop l)
  obtain ⟨Y, g, hT, hprin⟩ :=
    fexr_tower_principalize B hreg hdim m (fun l => Ideal.span {a l, b l}) hJ
  obtain ⟨hYint, hYnoeth, hgprop, hgdom, hgU, -, -, -, -⟩ := fexr_tower_props B hreg hdim Y g hT
  haveI := hYnoeth
  haveI := hf
  obtain ⟨h, hh⟩ := hdomin Y g hYint hgdom hprin
  have hHY : wcpaDjFexH1 Y := htow Y g hT
  haveI : IsProper (h ≫ f) := by rw [hh]; exact hgprop
  have hhprop : IsProper h := IsProper.of_comp h f
  have hiso : ∃ V : X.Opens, V ≠ ⊥ ∧ IsIso (h ∣_ V) := by

    have hres : ∀ {A C : Scheme.{u}} (q : A ⟶ C) (U₁ W₁ : C.Opens), W₁ ≤ U₁ →
        IsIso (q ∣_ U₁) → IsIso (q ∣_ W₁) := by
      intro A C q U₁ W₁ hle hq
      have h1 : IsIso ((q ∣_ U₁) ∣_ (U₁.ι ⁻¹ᵁ W₁)) := inferInstance
      have h2 : IsIso (q ∣_ (U₁.ι ''ᵁ (U₁.ι ⁻¹ᵁ W₁))) :=
        ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
          (morphismRestrictRestrict q U₁ (U₁.ι ⁻¹ᵁ W₁))).mp h1
      have heq : U₁.ι ''ᵁ (U₁.ι ⁻¹ᵁ W₁) = W₁ := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr hle
      rw [heq] at h2
      exact h2
    obtain ⟨U, hU0, hUi⟩ := hU
    obtain ⟨U', hU'0, hU'i⟩ := hgU
    rw [← hh] at hU'i
    have hW0 : U ⊓ U' ≠ ⊥ := by
      rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hU0 hU'0 ⊢
      obtain ⟨x, hx1, hx2⟩ := nonempty_preirreducible_inter U.isOpen U'.isOpen hU0 hU'0
      exact ⟨x, hx1, hx2⟩
    have hfW : IsIso (f ∣_ (U ⊓ U')) := hres f U (U ⊓ U') inf_le_left hUi
    have hhfW : IsIso ((h ≫ f) ∣_ (U ⊓ U')) := hres (h ≫ f) U' (U ⊓ U') inf_le_right hU'i
    rw [morphismRestrict_comp] at hhfW
    haveI := hfW
    haveI := hhfW
    refine ⟨f ⁻¹ᵁ (U ⊓ U'), ?_, @IsIso.of_isIso_comp_right _ _ _ _ _
      (h ∣_ (f ⁻¹ᵁ (U ⊓ U'))) (f ∣_ (U ⊓ U')) hfW hhfW⟩
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hW0 ⊢
    obtain ⟨w, hw⟩ := hW0
    let p : (U ⊓ U').toScheme := ⟨w, hw⟩
    let q := (inv (f ∣_ (U ⊓ U'))) p
    exact ⟨q.1, q.2⟩
  have hP1 : wcpaLccP1 h := fexr_proper_birational_P1 Y X h hhprop hYint hX hnorm hiso
  exact fexr_leray_inj Y X h hP1 hHY

theorem wcpa_dj_mn_rescale : ∀ (B : Type u) [CommRing B] (v : Bˣ) (m : B), ∃ Φ : (MvPowerSeries (Fin 2) B ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (↑v * m)}) ≃+* (MvPowerSeries (Fin 2) B ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C m}), Φ.toRingHom.comp ((Ideal.Quotient.mk _).comp MvPowerSeries.C) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro B _ v m
  classical
  set a : Fin 2 → B := ![(v : B), 1] with ha
  set a' : Fin 2 → B := ![((v⁻¹ : Bˣ) : B), 1] with ha'
  have hX : ∀ s : Fin 2, MvPowerSeries.rescale a (MvPowerSeries.X s) =
      MvPowerSeries.C (a s) * MvPowerSeries.X s := by
    intro s
    ext n
    rw [MvPowerSeries.coeff_rescale, MvPowerSeries.coeff_C_mul, MvPowerSeries.coeff_X]
    split_ifs with h
    · subst h
      simp [Finsupp.prod_single_index]
    · simp
  have hC : ∀ b : B, MvPowerSeries.rescale a (MvPowerSeries.C b) = MvPowerSeries.C b := by
    intro b
    ext n
    rw [MvPowerSeries.coeff_rescale, MvPowerSeries.coeff_C]
    split_ifs with h
    · subst h
      simp
    · simp
  have h1 : a * a' = 1 := by
    funext i
    fin_cases i <;> simp [ha, ha']
  have h2 : a' * a = 1 := by
    rw [mul_comm]; exact h1
  have hc1 : (MvPowerSeries.rescale a').comp (MvPowerSeries.rescale a) = RingHom.id _ := by
    rw [← MvPowerSeries.rescale_mul, h1, MvPowerSeries.rescale_one]
  have hc2 : (MvPowerSeries.rescale a).comp (MvPowerSeries.rescale a') = RingHom.id _ := by
    rw [← MvPowerSeries.rescale_mul, h2, MvPowerSeries.rescale_one]
  let e : MvPowerSeries (Fin 2) B ≃+* MvPowerSeries (Fin 2) B :=
    { toFun := MvPowerSeries.rescale a
      invFun := MvPowerSeries.rescale a'
      left_inv := fun x => RingHom.congr_fun hc1 x
      right_inv := fun x => RingHom.congr_fun hc2 x
      map_mul' := fun x y => map_mul (MvPowerSeries.rescale a) x y
      map_add' := fun x y => map_add (MvPowerSeries.rescale a) x y }
  have ha0 : a 0 = (v : B) := by simp [ha]
  have ha1 : a 1 = 1 := by simp [ha]
  have hkey : MvPowerSeries.rescale a
      (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (↑v * m)) =
      MvPowerSeries.C (v : B) * (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C m) := by
    rw [map_sub, map_mul, hX, hX, hC, ha0, ha1, map_one, one_mul, map_mul]
    ring
  have hunit : IsUnit (MvPowerSeries.C (v : B) : MvPowerSeries (Fin 2) B) :=
    v.isUnit.map (MvPowerSeries.C : B →+* MvPowerSeries (Fin 2) B)
  have hIJ : Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C m} =
      Ideal.map (e : MvPowerSeries (Fin 2) B →+* MvPowerSeries (Fin 2) B)
        (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (↑v * m)}) := by
    rw [Ideal.map_span, Set.image_singleton]
    have hk' : (e : MvPowerSeries (Fin 2) B →+* MvPowerSeries (Fin 2) B)
        (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (↑v * m)) =
        MvPowerSeries.C (v : B) * (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C m) :=
      hkey
    rw [hk', Ideal.span_singleton_mul_left_unit hunit]
  refine ⟨Ideal.quotientEquiv _ _ e hIJ, ?_⟩
  apply RingHom.ext
  intro b
  simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
  exact congrArg (Ideal.Quotient.mk _) (hC b)

theorem wcpa_dj_stc_tu_const_inj : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (h : A), h ∈ IsLocalRing.maximalIdeal A → (∀ a : A, Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) (MvPowerSeries.C a) = 0 → a = 0) ∧ Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X (0 : Fin 2) * MvPowerSeries.X (1 : Fin 2) - MvPowerSeries.C h}) (MvPowerSeries.X (0 : Fin 2)) ≠ 0 :=
by
  intro A _ _ _ h hh
  classical
  let e1 : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1
  have hXY : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) A) =
      MvPowerSeries.monomial e1 1 := by
    rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, mul_one]
  have hcoeff : ∀ (f : MvPowerSeries (Fin 2) A) (n : Fin 2 →₀ ℕ),
      MvPowerSeries.coeff n (f * (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h)) =
        (if e1 ≤ n then MvPowerSeries.coeff (n - e1) f else 0) - MvPowerSeries.coeff n f * h := by
    intro f n
    rw [mul_sub, map_sub, hXY, MvPowerSeries.coeff_mul_monomial, MvPowerSeries.coeff_mul_C]
    simp only [mul_one]
  have hnu : ¬ IsUnit h := (IsLocalRing.mem_maximalIdeal h).mp hh
  refine ⟨?_, ?_⟩
  · intro a ha
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at ha
    obtain ⟨f, hf⟩ := ha
    let E : ℕ → (Fin 2 →₀ ℕ) := fun k => Finsupp.single 0 k + Finsupp.single 1 k
    have hE0 : E 0 = 0 := by simp [E]
    have hle : ∀ k, e1 ≤ E (k + 1) := by
      intro k i
      fin_cases i <;> simp [E, e1]
    have hsub : ∀ k, E (k + 1) - e1 = E k := by
      intro k
      ext i
      fin_cases i <;> simp [E, e1]
    have hne : ∀ k, E (k + 1) ≠ 0 := by
      intro k hk
      have := congrArg (fun g => g 0) hk
      simp [E] at this
    have hnle : ¬ e1 ≤ 0 := by
      intro h'
      have := h' 0
      simp [e1] at this
    have hα : a = -(MvPowerSeries.coeff 0 f * h) := by
      have := hcoeff f 0
      rw [hf, if_neg hnle, MvPowerSeries.coeff_zero_C] at this
      rw [this]
      ring
    have hβ : ∀ k, MvPowerSeries.coeff (E k) f = MvPowerSeries.coeff (E (k + 1)) f * h := by
      intro k
      have := hcoeff f (E (k + 1))
      rw [hf, if_pos (hle k), hsub k, MvPowerSeries.coeff_C, if_neg (hne k)] at this
      exact sub_eq_zero.mp this.symm
    have hpow : ∀ k : ℕ, MvPowerSeries.coeff 0 f = h ^ k * MvPowerSeries.coeff (E k) f := by
      intro k
      induction k with
      | zero => rw [hE0]; ring
      | succ k ih => rw [ih, hβ k]; ring
    have hmem : MvPowerSeries.coeff 0 f ∈ ⨅ k : ℕ, (IsLocalRing.maximalIdeal A) ^ k := by
      rw [Ideal.mem_iInf]
      intro k
      rw [hpow k]
      exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow hh k)
    rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal A).ne_top,
      Ideal.mem_bot] at hmem
    rw [hα, hmem]
    ring
  · intro hx
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hx
    obtain ⟨f, hf⟩ := hx
    have hnle : ¬ e1 ≤ Finsupp.single 0 1 := by
      intro h'
      have := h' 1
      simp [e1] at this
    have key := hcoeff f (Finsupp.single 0 1)
    rw [hf, if_neg hnle, MvPowerSeries.coeff_X, if_pos rfl] at key
    apply hnu
    exact isUnit_iff_exists_inv.mpr ⟨-(MvPowerSeries.coeff (Finsupp.single 0 1) f),
      by linear_combination -key⟩

theorem fexa_AA_basic (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (ϖ : R)
    (hϖ : Irreducible ϖ) (n : ℕ) (hn : 1 ≤ n) :
    IsDomain (fexaAA R ϖ n) ∧ IsNoetherianRing (fexaAA R ϖ n) ∧
    (∀ z : fexaAA R ϖ n, IsUnit z ∨
      z ∈ Ideal.span {fexaW R ϖ n, fexaX R ϖ n, fexaY R ϖ n}) ∧
    Ideal.span {fexaW R ϖ n, fexaX R ϖ n, fexaY R ϖ n} ≠ ⊤ ∧
    fexaW R ϖ n ≠ 0 ∧ fexaX R ϖ n ≠ 0 ∧ fexaY R ϖ n ≠ 0 ∧
    fexaX R ϖ n * fexaY R ϖ n = fexaW R ϖ n ^ n :=
by
  classical

  have s1 : ∀ (p : R), Prime p → ∀ (k : ℕ) (u v : PowerSeries R) (ε : Rˣ),
      u * v = PowerSeries.C (↑ε * p ^ k) → p ∣ PowerSeries.constantCoeff u →
      ∀ j : ℕ, p ∣ PowerSeries.coeff j u := by
    intro p hp k
    induction k with
    | zero =>
      intro u v ε huv hu0
      exfalso
      have h := congrArg PowerSeries.constantCoeff huv
      rw [map_mul, PowerSeries.constantCoeff_C, pow_zero, mul_one] at h
      have hu : IsUnit (PowerSeries.constantCoeff u) :=
        isUnit_of_mul_isUnit_left (h ▸ ε.isUnit)
      exact hp.not_isUnit (isUnit_of_dvd_unit hu0 hu)
    | succ k ih =>
      intro u v ε huv hu0
      by_contra hall
      push_neg at hall
      have hm : ¬ p ∣ PowerSeries.coeff (Nat.find hall) u := Nat.find_spec hall
      have hmin : ∀ i < Nat.find hall, p ∣ PowerSeries.coeff i u := fun i hi => by
        have := Nat.find_min hall hi
        push_neg at this
        exact this
      have hm0 : Nat.find hall ≠ 0 := by
        intro h0
        apply hm
        rw [h0, PowerSeries.coeff_zero_eq_constantCoeff_apply]
        exact hu0
      have hv : ∀ j, p ∣ PowerSeries.coeff j v := by
        by_contra hallv
        push_neg at hallv
        have hr : ¬ p ∣ PowerSeries.coeff (Nat.find hallv) v := Nat.find_spec hallv
        have hrmin : ∀ i < Nat.find hallv, p ∣ PowerSeries.coeff i v := fun i hi => by
          have := Nat.find_min hallv hi
          push_neg at this
          exact this
        have hc := congrArg (PowerSeries.coeff (Nat.find hall + Nat.find hallv)) huv
        rw [PowerSeries.coeff_C, if_neg (by omega), PowerSeries.coeff_mul] at hc
        have hmem : (Nat.find hall, Nat.find hallv) ∈
            Finset.HasAntidiagonal.antidiagonal (Nat.find hall + Nat.find hallv) :=
          Finset.HasAntidiagonal.mem_antidiagonal.mpr rfl
        rw [← Finset.add_sum_erase _ _ hmem] at hc
        have hrest : p ∣ ∑ x ∈ (Finset.HasAntidiagonal.antidiagonal
            (Nat.find hall + Nat.find hallv)).erase
            (Nat.find hall, Nat.find hallv), PowerSeries.coeff x.1 u * PowerSeries.coeff x.2 v := by
          apply Finset.dvd_sum
          intro x hx
          rw [Finset.mem_erase, Finset.HasAntidiagonal.mem_antidiagonal] at hx
          obtain ⟨hne, hsum⟩ := hx
          rcases lt_trichotomy x.1 (Nat.find hall) with h | h | h
          · exact (hmin _ h).mul_right _
          · exfalso
            apply hne
            ext
            · exact h
            · simp only
              omega
          · exact (hrmin _ (by omega)).mul_left _
        have hprod : p ∣ PowerSeries.coeff (Nat.find hall) u *
            PowerSeries.coeff (Nat.find hallv) v := by
          have e : PowerSeries.coeff (Nat.find hall) u * PowerSeries.coeff (Nat.find hallv) v =
              -(∑ x ∈ (Finset.HasAntidiagonal.antidiagonal
                (Nat.find hall + Nat.find hallv)).erase
                (Nat.find hall, Nat.find hallv),
                PowerSeries.coeff x.1 u * PowerSeries.coeff x.2 v) := by
            linear_combination hc
          rw [e]
          exact (dvd_neg).mpr hrest
        rcases hp.dvd_or_dvd hprod with h | h
        · exact hm h
        · exact hr h
      choose v' hv' using hv
      have hvC : v = PowerSeries.C p * PowerSeries.mk v' := by
        ext j
        rw [PowerSeries.coeff_C_mul, PowerSeries.coeff_mk]
        exact hv' j
      have hCp : (PowerSeries.C p : PowerSeries R) ≠ 0 := by
        intro h
        apply hp.ne_zero
        have := congrArg (PowerSeries.coeff 0) h
        rw [PowerSeries.coeff_C, if_pos rfl, map_zero] at this
        exact this
      have huv' : u * PowerSeries.mk v' = PowerSeries.C (↑ε * p ^ k) := by
        apply mul_left_cancel₀ hCp
        rw [← mul_assoc, mul_comm (PowerSeries.C p) u, mul_assoc, ← hvC, huv, ← map_mul]
        congr 1
        ring
      exact hm (ih u (PowerSeries.mk v') ε huv' hu0 _)

  have s2 : ∀ F G : MvPowerSeries (Fin 2) R,
      PowerSeries.mk (fun j => MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j) (F * G)) =
        PowerSeries.mk (fun j => MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j) F) *
          PowerSeries.mk (fun j => MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j) G) := by
    intro F G
    ext j
    rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_mul, PowerSeries.coeff_mul,
      Finsupp.antidiagonal_single, Finset.sum_map]
    apply Finset.sum_congr rfl
    intro x _
    simp only [PowerSeries.coeff_mk]
    rfl

  have key1 : ∀ a : Fin 2 →₀ ℕ, a 0 = 0 → a = Finsupp.single 1 (a 1) := by
    intro a ha
    ext i
    fin_cases i
    · simp [ha]
    · simp
  have s3 : ∀ (I : Ideal R) (F G : MvPowerSeries (Fin 2) R),
      (∀ j : ℕ, MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j) F ∈ I) →
      (∀ j : ℕ, MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j) G ∈ I) →
      MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) (F * G) ∈ I := by
    intro I F G hF hG
    rw [MvPowerSeries.coeff_mul]
    apply Ideal.sum_mem
    intro x hx
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
    have h0 := DFunLike.congr_fun hx 0
    simp at h0
    rcases (by omega : x.1 0 = 0 ∨ x.2 0 = 0) with h | h
    · rw [key1 x.1 h]
      exact I.mul_mem_right _ (hF _)
    · rw [key1 x.2 h]
      exact I.mul_mem_left _ (hG _)

  have hmax : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
  have hp : Prime ϖ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hϖ
  have hdvd : ∀ a : R, ¬ IsUnit a → ϖ ∣ a := by
    intro a ha
    have h1 : a ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal a).mpr ha
    rw [hmax, Ideal.mem_span_singleton] at h1
    exact h1
  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal R := by
    rw [hmax]
    exact Ideal.mem_span_singleton_self ϖ
  have hϖn : ϖ ^ n ∈ IsLocalRing.maximalIdeal R := Ideal.pow_mem_of_mem _ hϖm n (by omega)

  have he0 : (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) ≠ 0 := by
    intro h
    have := DFunLike.congr_fun h 0
    simp at this
  have hX01 : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) R) =
      MvPowerSeries.monomial (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1) 1 := by
    rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, one_mul]
  have hF3 : MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1)
      (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n) :
        MvPowerSeries (Fin 2) R) = 1 := by
    rw [hX01, map_sub, MvPowerSeries.coeff_monomial, if_pos rfl, MvPowerSeries.coeff_C,
      if_neg he0, sub_zero]
  have hF4 : PowerSeries.mk (fun j => MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j)
      (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n) :
        MvPowerSeries (Fin 2) R)) = PowerSeries.C (↑(-1 : Rˣ) * ϖ ^ n) := by
    ext j
    rw [PowerSeries.coeff_mk, PowerSeries.coeff_C, hX01, map_sub, MvPowerSeries.coeff_monomial,
      MvPowerSeries.coeff_C]
    have hne : Finsupp.single (1 : Fin 2) j ≠
        Finsupp.single (0 : Fin 2) 1 + Finsupp.single (1 : Fin 2) 1 := by
      intro h
      have := DFunLike.congr_fun h 0
      simp at this
    rw [if_neg hne]
    by_cases hj : j = 0
    · subst hj
      simp
    · rw [if_neg (by simpa using hj), if_neg hj]
      simp

  obtain ⟨hSdom, hSreg, hSmax, -, -⟩ := wc_hnas_pfc_gcl_cf_power_series_regular R ϖ hmax 2
  haveI := hSdom
  haveI := hSreg
  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd (MvPowerSeries (Fin 2) R)
  haveI := hufd

  have hirr : Irreducible (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n) :
      MvPowerSeries (Fin 2) R) := by
    refine ⟨?_, fun F G hfg => ?_⟩
    · rw [MvPowerSeries.isUnit_iff_constantCoeff, map_sub, map_mul, MvPowerSeries.constantCoeff_X,
        MvPowerSeries.constantCoeff_C, zero_mul, zero_sub, IsUnit.neg_iff, isUnit_pow_iff (by omega)]
      exact hϖ.not_isUnit
    · by_contra hcon
      push_neg at hcon
      obtain ⟨hF, hG⟩ := hcon
      rw [MvPowerSeries.isUnit_iff_constantCoeff] at hF hG
      have hF0 := hdvd _ hF
      have hG0 := hdvd _ hG
      have hax : PowerSeries.mk (fun j => MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j) F) *
          PowerSeries.mk (fun j => MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j) G) =
          PowerSeries.C (↑(-1 : Rˣ) * ϖ ^ n) := by
        rw [← s2, ← hfg, hF4]
      have hu0 : ϖ ∣ PowerSeries.constantCoeff
          (PowerSeries.mk (fun j => MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j) F)) := by
        rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_mk,
          Finsupp.single_zero, MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
        exact hF0
      have hv0 : ϖ ∣ PowerSeries.constantCoeff
          (PowerSeries.mk (fun j => MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) j) G)) := by
        rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_mk,
          Finsupp.single_zero, MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
        exact hG0
      have hFa := s1 ϖ hp n _ _ (-1) hax hu0
      have hGa := s1 ϖ hp n _ _ (-1) (by rw [mul_comm]; exact hax) hv0
      have h1 := s3 (Ideal.span {ϖ}) F G
        (fun j => Ideal.mem_span_singleton.mpr (by simpa only [PowerSeries.coeff_mk] using hFa j))
        (fun j => Ideal.mem_span_singleton.mpr (by simpa only [PowerSeries.coeff_mk] using hGa j))
      rw [← hfg, hF3] at h1
      exact hϖ.not_isUnit (isUnit_of_dvd_one (Ideal.mem_span_singleton.mp h1))

  have hprime := UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr
  have hdomAA : IsDomain (fexaAA R ϖ n) :=
    (Ideal.Quotient.isDomain_iff_prime _).mpr ((Ideal.span_singleton_prime hprime.ne_zero).mpr hprime)
  haveI := hdomAA

  have hxy : fexaX R ϖ n * fexaY R ϖ n = fexaW R ϖ n ^ n := by
    show Ideal.Quotient.mk _ (MvPowerSeries.X 0) * Ideal.Quotient.mk _ (MvPowerSeries.X 1) =
      Ideal.Quotient.mk _ (MvPowerSeries.C ϖ) ^ n
    rw [← map_mul, ← map_pow, ← map_pow MvPowerSeries.C, Ideal.Quotient.eq]
    exact Ideal.mem_span_singleton_self _

  obtain ⟨hinj, hx0⟩ := wcpa_dj_stc_tu_const_inj R (ϖ ^ n) hϖn
  have hw : fexaW R ϖ n ≠ 0 := fun h => hϖ.ne_zero (hinj ϖ h)
  have hy : fexaY R ϖ n ≠ 0 := by
    intro h
    have h2 := hxy
    rw [h, mul_zero] at h2
    exact pow_ne_zero n hw h2.symm

  have hloc : ∀ z : fexaAA R ϖ n, IsUnit z ∨
      z ∈ Ideal.span {fexaW R ϖ n, fexaX R ϖ n, fexaY R ϖ n} := by
    intro z
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
    by_cases hF : IsUnit F
    · left
      exact hF.map _
    · right
      have hFm : F ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) R) :=
        (IsLocalRing.mem_maximalIdeal F).mpr hF
      rw [hSmax] at hFm
      have hle : Ideal.span (insert (MvPowerSeries.C ϖ) (Set.range MvPowerSeries.X)) ≤
          (Ideal.span {fexaW R ϖ n, fexaX R ϖ n, fexaY R ϖ n}).comap (Ideal.Quotient.mk _) := by
        rw [Ideal.span_le]
        intro g hg
        rcases hg with rfl | ⟨i, rfl⟩
        · exact Ideal.subset_span (Or.inl rfl)
        · fin_cases i
          · exact Ideal.subset_span (Or.inr (Or.inl rfl))
          · exact Ideal.subset_span (Or.inr (Or.inr rfl))
      exact hle hFm

  have hne : Ideal.span {fexaW R ϖ n, fexaX R ϖ n, fexaY R ϖ n} ≠ ⊤ := by
    let φ : MvPowerSeries (Fin 2) R →+* IsLocalRing.ResidueField R :=
      (IsLocalRing.residue R).comp MvPowerSeries.constantCoeff
    have hφf : ∀ a ∈ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C (ϖ ^ n) : MvPowerSeries (Fin 2) R)}, φ a = 0 := by
      intro a ha
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul]
      have : φ (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n)) = 0 := by
        show IsLocalRing.residue R (MvPowerSeries.constantCoeff
          (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n) :
            MvPowerSeries (Fin 2) R)) = 0
        rw [map_sub, map_mul, MvPowerSeries.constantCoeff_X, MvPowerSeries.constantCoeff_X,
          MvPowerSeries.constantCoeff_C, zero_mul, zero_sub, map_neg, neg_eq_zero]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr hϖn
      rw [this, mul_zero]
    let ψ := Ideal.Quotient.lift _ φ hφf
    have hJ : Ideal.span {fexaW R ϖ n, fexaX R ϖ n, fexaY R ϖ n} ≤ RingHom.ker ψ := by
      rw [Ideal.span_le]
      intro g hg
      rcases hg with rfl | rfl | rfl
      · show ψ (Ideal.Quotient.mk _ (MvPowerSeries.C ϖ)) = 0
        rw [Ideal.Quotient.lift_mk]
        simp only [φ, RingHom.comp_apply, MvPowerSeries.constantCoeff_C]
        exact (IsLocalRing.residue_eq_zero_iff _).mpr hϖm
      · show ψ (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) = 0
        rw [Ideal.Quotient.lift_mk]
        simp only [φ, RingHom.comp_apply, MvPowerSeries.constantCoeff_X, map_zero]
      · show ψ (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = 0
        rw [Ideal.Quotient.lift_mk]
        simp only [φ, RingHom.comp_apply, MvPowerSeries.constantCoeff_X, map_zero]
    intro hJtop
    rw [hJtop, top_le_iff] at hJ
    exact RingHom.ker_ne_top ψ hJ
  exact ⟨hdomAA, inferInstance, hloc, hne, hw, hx0, hy, hxy⟩

theorem fexa_offcenter_regular (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (ϖ : R) (hϖ : Irreducible ϖ) (n : ℕ) (hn : 1 ≤ n) [IsDomain (fexaAA R ϖ n)]
    (hloc : ∀ z : fexaAA R ϖ n, IsUnit z ∨
      z ∈ Ideal.span {fexaW R ϖ n, fexaX R ϖ n, fexaY R ϖ n})
    (q : Ideal (fexaAA R ϖ n)) [q.IsPrime] (hq : fexaW R ϖ n ∉ q) :
    IsRegularLocalRing (Localization.AtPrime q) :=
by
  classical

  have s6 : ∀ (S : Type u) [CommRing S] (I : Ideal S) (q : Ideal (S ⧸ I)) [q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime (q.comap (Ideal.Quotient.mk I)) ⧸
        I.map (algebraMap S (Localization.AtPrime (q.comap (Ideal.Quotient.mk I))))) →
      IsRegularLocalRing (Localization.AtPrime q) := by
    intro S _ I q _ hyp
    have hM : Algebra.algebraMapSubmonoid (S ⧸ I) (q.comap (Ideal.Quotient.mk I)).primeCompl
        = q.primeCompl :=
      Ideal.map_primeCompl_comap_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective q
    have hloc0 : IsLocalization
        (Algebra.algebraMapSubmonoid (S ⧸ I) (q.comap (Ideal.Quotient.mk I)).primeCompl)
        (Localization.AtPrime (q.comap (Ideal.Quotient.mk I)) ⧸
          I.map (algebraMap S (Localization.AtPrime (q.comap (Ideal.Quotient.mk I))))) :=
      inferInstance
    rw [hM] at hloc0
    let e := @IsLocalization.algEquiv _ _ q.primeCompl (Localization.AtPrime q) _ _ _
      (Localization.AtPrime (q.comap (Ideal.Quotient.mk I)) ⧸
          I.map (algebraMap S (Localization.AtPrime (q.comap (Ideal.Quotient.mk I))))) _ _ hloc0
    haveI := hyp
    exact IsRegularLocalRing.of_ringEquiv e.symm.toRingEquiv

  let f : MvPowerSeries (Fin 2) R := MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n)
  let I : Ideal (MvPowerSeries (Fin 2) R) := Ideal.span {f}
  let Q : Ideal (MvPowerSeries (Fin 2) R) := q.comap (Ideal.Quotient.mk I)
  haveI hQ : Q.IsPrime := Ideal.comap_isPrime _ _
  have hmkf : Ideal.Quotient.mk I f = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f)
  have hfQ : f ∈ Q := by
    show Ideal.Quotient.mk I f ∈ q
    rw [hmkf]; exact q.zero_mem
  have hrel : fexaX R ϖ n * fexaY R ϖ n = fexaW R ϖ n ^ n := by
    have h1 : Ideal.Quotient.mk I f = fexaX R ϖ n * fexaY R ϖ n - fexaW R ϖ n ^ n := by
      simp only [f, map_sub, map_mul, map_pow, fexaX, fexaY, fexaW]
      rfl
    rw [h1, sub_eq_zero] at hmkf
    exact hmkf

  have hxq : fexaX R ϖ n ∉ q := by
    intro hx
    apply hq
    apply (inferInstance : q.IsPrime).mem_of_pow_mem n
    rw [← hrel]
    exact q.mul_mem_right _ hx
  have hXQ : (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) R) ∉ Q := hxq

  have hmax : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
  have hS : IsRegularLocalRing (MvPowerSeries (Fin 2) R) :=
    (wc_hnas_pfc_gcl_cf_power_series_regular R ϖ hmax 2).2.1
  haveI := hS
  have hSQ : IsRegularLocalRing (Localization.AtPrime Q) :=
    wc_hnas_pfc_regular_localization _ hS Q
  haveI := hSQ
  have hfm : algebraMap _ (Localization.AtPrime Q) f ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff _ Q f).mpr hfQ

  have mkDer : ∀ (T : Type u) [CommRing T] (g : T →+ T), g 1 = 0 →
      (∀ a b : T, g (a * b) = a * g b + b * g a) →
      ∃ D : Derivation ℤ T T, ∀ t, D t = g t := by
    intro T _ g h1 hl
    exact ⟨{ toLinearMap := g.toIntLinearMap
             map_one_eq_zero' := h1
             leibniz' := fun a b => by
               simp only [AddMonoidHom.coe_toIntLinearMap, smul_eq_mul]
               exact hl a b }, fun t => rfl⟩
  obtain ⟨D, hD⟩ := mkDer (MvPowerSeries (Fin 2) R)
    (MvPowerSeries.pderiv (σ := Fin 2) (R := R) 1).toLinearMap.toAddMonoidHom
    (MvPowerSeries.pderiv (σ := Fin 2) (R := R) 1).map_one_eq_zero
    (fun a b => by
      simp only [LinearMap.toAddMonoidHom_coe, Derivation.coeFn_coe, Derivation.leibniz,
        smul_eq_mul])
  have hDf : D f = MvPowerSeries.X 0 := by
    rw [hD]
    simp only [LinearMap.toAddMonoidHom_coe, Derivation.coeFn_coe]
    simp only [f, Derivation.map_sub, Derivation.leibniz, MvPowerSeries.pderiv_X,
      MvPowerSeries.pderiv_C, smul_eq_mul]
    simp
  obtain ⟨D', hD'⟩ := (wc_hnas_pfc_gcl_derivation_extend (MvPowerSeries (Fin 2) R)).2 Q.primeCompl D
  have hunit : IsUnit (D' (algebraMap _ (Localization.AtPrime Q) f)) := by
    rw [hD', hDf]
    exact (IsLocalization.AtPrime.isUnit_to_map_iff _ Q _).mpr hXQ
  have s5 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] {_ : Algebra ℤ B} (D : Derivation ℤ B B)
      (z : B), IsUnit (D z) → z ∉ IsLocalRing.maximalIdeal B ^ 2 := by
    intro B _ _ _ D z hz hz2
    have key : ∀ t ∈ IsLocalRing.maximalIdeal B ^ 2, D t ∈ IsLocalRing.maximalIdeal B := by
      intro t ht
      rw [pow_two] at ht
      refine Submodule.mul_induction_on ht ?_ ?_
      · intro a ha b hb
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_right _ _ hb)
      · intro x y hx hy
        rw [Derivation.map_add]
        exact Ideal.add_mem _ hx hy
    exact (IsLocalRing.mem_maximalIdeal _).mp (key z hz2) hz
  have hf2 : algebraMap _ (Localization.AtPrime Q) f ∉
      IsLocalRing.maximalIdeal (Localization.AtPrime Q) ^ 2 :=
    s5 (Localization.AtPrime Q) D' _ hunit

  have hquot := (wc_rl_quot_regular wc_rl_quot_embdim (Localization.AtPrime Q) hSQ _ hfm hf2).1

  have hIeq : I.map (algebraMap _ (Localization.AtPrime Q)) =
      Ideal.span {algebraMap _ (Localization.AtPrime Q) f} := by
    simp only [I, Ideal.map_span, Set.image_singleton]
  have hreg2 : IsRegularLocalRing (Localization.AtPrime Q ⧸
      I.map (algebraMap _ (Localization.AtPrime Q))) := by
    haveI := hquot
    rw [hIeq]
    exact hquot
  exact s6 _ I q hreg2

theorem fexa_chart_quotient_pid (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (ϖ : R) (hϖ : Irreducible ϖ) (n : ℕ) (hn : 1 ≤ n) [IsDomain (fexaAA R ϖ n)]
    [IsDomain (fexaAA R ϖ 1)] (hw : fexaW R ϖ n ≠ 0) (i : Fin n) :
    IsDomain (↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) ⧸
      Ideal.span {fexaAlphaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i}) ∧
    IsPrincipalIdealRing (↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) ⧸
      Ideal.span {fexaAlphaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i}) ∧
    IsDomain (↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) ⧸
      Ideal.span {fexaBetaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i}) ∧
    IsPrincipalIdealRing (↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) ⧸
      Ideal.span {fexaBetaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i}) :=
have fcqpH_L (A : Type u) [CommRing A] (σ : Fin 2) (F : MvPowerSeries (Fin 2) A) :
    ∃ G L : MvPowerSeries (Fin 2) A, F = MvPowerSeries.X σ * G + L ∧
      ∀ e, MvPowerSeries.coeff e L = if e σ = 0 then MvPowerSeries.coeff e F else 0 := by
  classical
  obtain ⟨G, hG⟩ : ∃ G : MvPowerSeries (Fin 2) A, ∀ e, MvPowerSeries.coeff e G =
      MvPowerSeries.coeff (e + Finsupp.single σ 1) F :=
    ⟨fun e => MvPowerSeries.coeff (e + Finsupp.single σ 1) F, fun e => rfl⟩
  obtain ⟨L, hL⟩ : ∃ L : MvPowerSeries (Fin 2) A, ∀ e, MvPowerSeries.coeff e L =
      if e σ = 0 then MvPowerSeries.coeff e F else 0 :=
    ⟨fun e => if e σ = 0 then MvPowerSeries.coeff e F else 0, fun e => rfl⟩
  refine ⟨G, L, ?_, hL⟩
  ext e
  rw [map_add, MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul, hL]
  by_cases h : e σ = 0
  · have : ¬ Finsupp.single σ 1 ≤ e := by
      rw [Finsupp.single_le_iff]; omega
    rw [if_neg this, if_pos h, zero_add]
  · have : Finsupp.single σ 1 ≤ e := by
      rw [Finsupp.single_le_iff]; omega
    rw [if_pos this, if_neg h, add_zero, one_mul, hG, tsub_add_cancel_of_le this]

have fcqpH_axis (A : Type u) [CommRing A] (b h : A) (hbh : b ∣ h) (τ : Fin 2) :
    ∃ ρ : (MvPowerSeries (Fin 2) A ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C h}) →+* PowerSeries (A ⧸ Ideal.span {b}),
      ∀ F : MvPowerSeries (Fin 2) A, ρ (Ideal.Quotient.mk _ F) = PowerSeries.mk
        (fun m => Ideal.Quotient.mk (Ideal.span {b}) (MvPowerSeries.coeff (Finsupp.single τ m) F)) := by
  classical
  let ax : MvPowerSeries (Fin 2) A →+* PowerSeries A :=
    { toFun := fun F => PowerSeries.mk (fun m => MvPowerSeries.coeff (Finsupp.single τ m) F)
      map_one' := by
        ext m
        simp [PowerSeries.coeff_mk, MvPowerSeries.coeff_one, PowerSeries.coeff_one]
      map_mul' := by
        intro F G
        ext m
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_mul, MvPowerSeries.coeff_mul,
          Finsupp.antidiagonal_single, Finset.sum_map]
        simp
      map_zero' := by ext m; simp
      map_add' := by intro F G; ext m; simp }
  have hker : ∀ m : ℕ, MvPowerSeries.coeff (Finsupp.single τ m)
      (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h : MvPowerSeries (Fin 2) A) ∈
        Ideal.span {b} := by
    intro m
    have h1 : MvPowerSeries.coeff (Finsupp.single τ m)
        (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) A) = 0 := by
      rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial,
        MvPowerSeries.coeff_monomial, if_neg]
      intro heq
      fin_cases τ
      · have := DFunLike.congr_fun heq 1; simp at this
      · have := DFunLike.congr_fun heq 0; simp at this
    rw [map_sub, h1, zero_sub, MvPowerSeries.coeff_C]
    apply Submodule.neg_mem
    split_ifs
    · exact Ideal.mem_span_singleton.mpr hbh
    · exact Ideal.zero_mem _
  let ρt : MvPowerSeries (Fin 2) A →+* PowerSeries (A ⧸ Ideal.span {b}) :=
    (PowerSeries.map (Ideal.Quotient.mk (Ideal.span {b}))).comp ax
  have hρt : ∀ F, ρt F = PowerSeries.mk
      (fun m => Ideal.Quotient.mk (Ideal.span {b}) (MvPowerSeries.coeff (Finsupp.single τ m) F)) := by
    intro F; ext m
    simp only [ρt, ax, RingHom.coe_comp, Function.comp_apply, RingHom.coe_mk, MonoidHom.coe_mk,
      OneHom.coe_mk, PowerSeries.coeff_map, PowerSeries.coeff_mk]
  refine ⟨Ideal.Quotient.lift _ ρt ?_, fun F => by rw [Ideal.Quotient.lift_mk, hρt]⟩
  intro z hz
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
  rw [map_mul]
  have : ρt (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h) = 0 := by
    rw [hρt]; ext m
    rw [PowerSeries.coeff_mk, map_zero, Ideal.Quotient.eq_zero_iff_mem]; exact hker m
  rw [this, mul_zero]

have fcqpH_w1 (R : Type u) [CommRing R] [IsDomain R] (ϖ : R) (h0 : ϖ ≠ 0) (hu : ¬ IsUnit ϖ) :
    fexaW R ϖ 1 ≠ 0 := by
  classical
  intro hw
  rw [fexaW, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hw
  obtain ⟨G, hG⟩ := hw
  have hc := congrArg MvPowerSeries.constantCoeff hG
  simp only [map_mul, map_sub, MvPowerSeries.constantCoeff_X, MvPowerSeries.constantCoeff_C,
    mul_zero, zero_sub, pow_one] at hc
  have hG0 : MvPowerSeries.constantCoeff G = -1 := by
    have : ϖ * (MvPowerSeries.constantCoeff G + 1) = 0 := by linear_combination -hc
    have := (mul_eq_zero.mp this).resolve_left h0
    linear_combination this
  set e11 : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1 with he11
  have hne : e11 ≠ 0 := by
    intro h; have := DFunLike.congr_fun h 0; simp [e11] at this
  have h1 := congrArg (MvPowerSeries.coeff e11) hG
  rw [MvPowerSeries.coeff_C, if_neg hne, mul_sub, map_sub, MvPowerSeries.X_def,
    MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, ← he11, one_mul,
    MvPowerSeries.coeff_mul_monomial, if_pos le_rfl, tsub_self, mul_comm G,
    MvPowerSeries.coeff_C_mul, mul_one, pow_one] at h1
  rw [MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hG0] at h1
  apply hu
  exact isUnit_iff_exists_inv.mpr ⟨-(MvPowerSeries.coeff e11 G), by linear_combination h1⟩

have fcqpH_rec (Q : Type u) [CommRing Q] (K : Type u) [Field K] (τ : Q →+* PowerSeries K)
    (j : K →+* Q) (t : Q) (hj : ∀ c, τ (j c) = PowerSeries.C c) (ht : τ t = PowerSeries.X)
    (he : Function.Surjective (Polynomial.eval₂RingHom j t)) :
    IsDomain Q ∧ IsPrincipalIdealRing Q := by
  set e := Polynomial.eval₂RingHom j t with hedef
  have hcomp : τ.comp e = Polynomial.coeToPowerSeries.ringHom := by
    apply Polynomial.ringHom_ext
    · intro c
      simp [e, hj]
    · simp [e, ht]
  have hinj : Function.Injective e := by
    intro p q hpq
    apply Polynomial.coe_injective K
    have h1 := DFunLike.congr_fun hcomp p
    have h2 := DFunLike.congr_fun hcomp q
    simp only [RingHom.coe_comp, Function.comp_apply] at h1 h2
    rw [← Polynomial.coeToPowerSeries.ringHom_apply, ← Polynomial.coeToPowerSeries.ringHom_apply,
      ← h1, ← h2, hpq]
  let E := RingEquiv.ofBijective e ⟨hinj, he⟩
  exact ⟨MulEquiv.isDomain (Polynomial K) E.symm.toMulEquiv, IsPrincipalIdealRing.of_surjective e he⟩

have fcqpH_bij (Q : Type u) [CommRing Q] (K : Type u) [Field K] (τ : Q →+* PowerSeries K)
    (hb : Function.Bijective τ) : IsDomain Q ∧ IsPrincipalIdealRing Q := by
  let E := RingEquiv.ofBijective τ hb
  exact ⟨MulEquiv.isDomain (PowerSeries K) E.toMulEquiv,
    IsPrincipalIdealRing.of_surjective E.symm E.symm.surjective⟩

have fcqpH_ident (A : Type u) [CommRing A] (x y w : A) (n : ℕ) (hn : 1 ≤ n) (hxy : x * y = w ^ n)
    (i : Fin n) :
    algebraMap A ↥(fexaP x y w n {i}) w = fexaAlphaP x y w n i * fexaBetaP x y w n i ∧
    algebraMap A ↥(fexaP x y w n {i}) x =
      fexaAlphaP x y w n i * algebraMap A ↥(fexaP x y w n {i}) w ^ (i : ℕ) ∧
    algebraMap A ↥(fexaP x y w n {i}) y =
      fexaBetaP x y w n i * algebraMap A ↥(fexaP x y w n {i}) w ^ (n - 1 - (i : ℕ)) ∧
    ((i : ℕ) = 0 → fexaAlphaP x y w n i = algebraMap A ↥(fexaP x y w n {i}) x) ∧
    ((i : ℕ) = n - 1 → fexaBetaP x y w n i = algebraMap A ↥(fexaP x y w n {i}) y) := by
  have hWι : algebraMap A (Localization.Away w) w * Localization.Away.invSelf w = 1 := by
    rw [Localization.Away.invSelf, ← Localization.mk_one_eq_algebraMap, Localization.mk_mul,
      mul_one, one_mul]
    exact Localization.mk_self (⟨w, Submonoid.mem_powers w⟩ : Submonoid.powers w)
  have hi := i.2
  have hxyL : algebraMap A (Localization.Away w) x * algebraMap A (Localization.Away w) y =
      algebraMap A (Localization.Away w) w ^ n := by rw [← map_mul, hxy, map_pow]
  set W := algebraMap A (Localization.Away w) w
  set ι := Localization.Away.invSelf w
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · apply Subtype.ext
    show W = (algebraMap A _ x * ι ^ (i : ℕ)) * (algebraMap A _ y * ι ^ (n - 1 - (i : ℕ)))
    have e1 : (i : ℕ) + (n - 1 - (i : ℕ)) = n - 1 := by omega
    have e2 : W ^ n = W * W ^ (n - 1) := by rw [← pow_succ']; congr 1; omega
    calc W = W * (W * ι) ^ (n - 1) := by rw [hWι, one_pow, mul_one]
      _ = (algebraMap A _ x * algebraMap A _ y) * ι ^ ((i : ℕ) + (n - 1 - (i : ℕ))) := by
          rw [hxyL, e1, mul_pow, e2]; ring
      _ = _ := by rw [pow_add]; ring
  · apply Subtype.ext
    show algebraMap A _ x = (algebraMap A _ x * ι ^ (i : ℕ)) * W ^ (i : ℕ)
    rw [mul_assoc, ← mul_pow, mul_comm ι, hWι, one_pow, mul_one]
  · apply Subtype.ext
    show algebraMap A _ y = (algebraMap A _ y * ι ^ (n - 1 - (i : ℕ))) * W ^ (n - 1 - (i : ℕ))
    rw [mul_assoc, ← mul_pow, mul_comm ι, hWι, one_pow, mul_one]
  · intro h0
    apply Subtype.ext
    show algebraMap A _ x * ι ^ (i : ℕ) = algebraMap A _ x
    rw [h0, pow_zero, mul_one]
  · intro h0
    apply Subtype.ext
    show algebraMap A _ y * ι ^ (n - 1 - (i : ℕ)) = algebraMap A _ y
    rw [← h0, Nat.sub_self, pow_zero, mul_one]

have fcqpH_ind (A : Type u) [CommRing A] (x y w : A) (n : ℕ) (i : Fin n) (B : Type u) [CommRing B]
    (f : ↥(fexaP x y w n {i}) →+* B) (S : Subring B)
    (ha : ∀ a : A, f (algebraMap A ↥(fexaP x y w n {i}) a) ∈ S)
    (hα : f (fexaAlphaP x y w n i) ∈ S) (hβ : f (fexaBetaP x y w n i) ∈ S) :
    ∀ z : ↥(fexaP x y w n {i}), f z ∈ S := by
  rintro ⟨v, hv⟩
  induction hv using Algebra.adjoin_induction with
  | mem v hv' =>
    obtain ⟨j, hj, hv''⟩ := Set.mem_iUnion₂.mp hv'
    rw [Finset.mem_singleton] at hj
    subst hj
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hv''
    rcases hv'' with rfl | rfl
    · exact hα
    · exact hβ
  | algebraMap r => exact ha r
  | add v₁ v₂ h₁ h₂ ih₁ ih₂ =>
    have : (⟨v₁ + v₂, Subalgebra.add_mem _ h₁ h₂⟩ : ↥(fexaP x y w n {i})) = ⟨v₁, h₁⟩ + ⟨v₂, h₂⟩ := rfl
    rw [this, map_add]; exact S.add_mem ih₁ ih₂
  | mul v₁ v₂ h₁ h₂ ih₁ ih₂ =>
    have : (⟨v₁ * v₂, Subalgebra.mul_mem _ h₁ h₂⟩ : ↥(fexaP x y w n {i})) = ⟨v₁, h₁⟩ * ⟨v₂, h₂⟩ := rfl
    rw [this, map_mul]; exact S.mul_mem ih₁ ih₂

have fcqpH_split3 (A : Type u) [CommRing A] (F : MvPowerSeries (Fin 2) A) :
    ∃ G H : MvPowerSeries (Fin 2) A, F = MvPowerSeries.C (MvPowerSeries.coeff 0 F) +
      MvPowerSeries.X 0 * G + MvPowerSeries.X 1 * H := by
  classical
  obtain ⟨G, L, hF, hL⟩ := fcqpH_L A 0 F
  obtain ⟨H, L', hL', hL''⟩ := fcqpH_L A 1 L
  refine ⟨G, H, ?_⟩
  have hC : L' = MvPowerSeries.C (MvPowerSeries.coeff 0 F) := by
    ext e
    rw [hL'', hL, MvPowerSeries.coeff_C]
    by_cases h : e = 0
    · subst h; simp
    · have hne : ¬ (e 1 = 0 ∧ e 0 = 0) := by
        rintro ⟨h1, h0⟩; apply h; ext j; fin_cases j <;> simp [h0, h1]
      by_cases h1 : e 1 = 0
      · rw [if_pos h1, if_neg (fun h0 => hne ⟨h1, h0⟩), if_neg h]
      · rw [if_neg h1, if_neg h]
  calc F = MvPowerSeries.X 0 * G + L := hF
    _ = _ := by rw [hL', hC]; ring

have fcqpH_fin2 : ∀ σ τ j : Fin 2, σ ≠ τ → j ≠ σ → j = τ := by decide

have fcqpH_split_axis (A : Type u) [CommRing A] (b : A) (σ τ : Fin 2) (hστ : σ ≠ τ)
    (F : MvPowerSeries (Fin 2) A)
    (hF : ∀ m : ℕ, MvPowerSeries.coeff (Finsupp.single τ m) F ∈ Ideal.span {b}) :
    ∃ G H : MvPowerSeries (Fin 2) A, F = MvPowerSeries.X σ * G + MvPowerSeries.C b * H := by
  classical
  choose c hc using fun m => Ideal.mem_span_singleton'.mp (hF m)
  obtain ⟨G, L, hFL, hL⟩ := fcqpH_L A σ F
  obtain ⟨H, hH⟩ : ∃ H : MvPowerSeries (Fin 2) A, ∀ e, MvPowerSeries.coeff e H =
      if e σ = 0 then c (e τ) else 0 :=
    ⟨fun e => if e σ = 0 then c (e τ) else 0, fun e => rfl⟩
  refine ⟨G, H, ?_⟩
  rw [hFL]; congr 1
  ext e
  rw [hL, MvPowerSeries.coeff_C_mul, hH]
  by_cases h : e σ = 0
  · rw [if_pos h, if_pos h, mul_comm, hc]
    have he : Finsupp.single τ (e τ) = e := by
      ext j
      by_cases hj : j = σ
      · rw [hj, Finsupp.single_apply, if_neg hστ.symm, h]
      · have hjt : j = τ := fcqpH_fin2 σ τ j hστ hj
        rw [hjt, Finsupp.single_eq_same]
    rw [he]
  · rw [if_neg h, if_neg h, mul_zero]

have fcqpH_coeff_X_single (A : Type u) [CommRing A] (s t : Fin 2) (m : ℕ) :
    MvPowerSeries.coeff (Finsupp.single s m) (MvPowerSeries.X t : MvPowerSeries (Fin 2) A) =
      if s = t ∧ m = 1 then 1 else 0 := by
  classical
  rw [MvPowerSeries.coeff_X]
  by_cases h : s = t ∧ m = 1
  · obtain ⟨rfl, rfl⟩ := h; simp
  · rw [if_neg h, if_neg]
    intro h'
    rw [Finsupp.single_eq_single_iff] at h'
    rcases h' with h' | ⟨_, h'⟩
    · exact h h'
    · exact absurd h' one_ne_zero

have fcqpH_coeff_rescale_single (A : Type u) [CommRing A] (a : Fin 2 → A) (s : Fin 2) (m : ℕ)
    (F : MvPowerSeries (Fin 2) A) :
    MvPowerSeries.coeff (Finsupp.single s m) (MvPowerSeries.rescale a F) =
      a s ^ m * MvPowerSeries.coeff (Finsupp.single s m) F := by
  rw [MvPowerSeries.coeff_rescale, Finsupp.prod_single_index]
  exact pow_zero _

have fcqpH_chart (R : Type u) [CommRing R] (ϖ : R) (n : ℕ) (hn : 1 ≤ n)
    [IsDomain (fexaAA R ϖ 1)] (hw1 : fexaW R ϖ 1 ≠ 0) (i : Fin n) :
    ∃ ψ : ↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) →+* fexaAA R ϖ 1,
      ψ (fexaAlphaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i) = fexaX R ϖ 1 ∧
      ψ (fexaBetaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i) = fexaY R ϖ 1 ∧
      ∀ F : MvPowerSeries (Fin 2) R,
        ψ (algebraMap (fexaAA R ϖ n) ↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i})
          (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
            MvPowerSeries.C (ϖ ^ n) : MvPowerSeries (Fin 2) R)}) F)) =
        Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
            MvPowerSeries.C (ϖ ^ 1) : MvPowerSeries (Fin 2) R)})
          (MvPowerSeries.rescale ![ϖ ^ (i : ℕ), ϖ ^ (n - 1 - (i : ℕ))] F) := by
  classical
  have hi := i.2
  generalize ha : (![ϖ ^ (i : ℕ), ϖ ^ (n - 1 - (i : ℕ))] : Fin 2 → R) = a
  have ha0 : a 0 = ϖ ^ (i : ℕ) := by rw [← ha]; rfl
  have ha1 : a 1 = ϖ ^ (n - 1 - (i : ℕ)) := by rw [← ha]; rfl
  set In : Ideal (MvPowerSeries (Fin 2) R) := Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
            MvPowerSeries.C (ϖ ^ n) : MvPowerSeries (Fin 2) R)} with hIn
  set I1 : Ideal (MvPowerSeries (Fin 2) R) := Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
            MvPowerSeries.C (ϖ ^ 1) : MvPowerSeries (Fin 2) R)} with hI1
  have hrC : ∀ c : R, MvPowerSeries.rescale a (MvPowerSeries.C c) = MvPowerSeries.C c := by
    intro c; ext e
    rw [MvPowerSeries.coeff_rescale, MvPowerSeries.coeff_C]
    split_ifs with h
    · rw [h, Finsupp.prod_zero_index, one_mul]
    · rw [mul_zero]
  have hrX : ∀ s : Fin 2, MvPowerSeries.rescale a (MvPowerSeries.X s) =
      MvPowerSeries.C (a s) * MvPowerSeries.X s := by
    intro s; ext e
    rw [MvPowerSeries.coeff_rescale, MvPowerSeries.coeff_C_mul, MvPowerSeries.coeff_X]
    split_ifs with h
    · rw [h, Finsupp.prod_single_index, pow_one]
      exact pow_zero _
    · rw [mul_zero, mul_zero]
  have hkey : MvPowerSeries.rescale a
      (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ n)) =
      MvPowerSeries.C (ϖ ^ (n - 1)) *
        (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (ϖ ^ 1)) := by
    rw [map_sub, map_mul, hrX, hrX, hrC, ha0, ha1]
    have e1 : ϖ ^ (n - 1) = ϖ ^ (i : ℕ) * ϖ ^ (n - 1 - (i : ℕ)) := by
      rw [← pow_add]; congr 1; omega
    have e2 : ϖ ^ n = ϖ ^ (n - 1) * ϖ ^ 1 := by rw [← pow_add]; congr 1; omega
    rw [e2, e1]
    simp only [map_mul]
    ring
  have hI1z : Ideal.Quotient.mk I1 (MvPowerSeries.X 0 * MvPowerSeries.X 1 -
      MvPowerSeries.C (ϖ ^ 1)) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  let Θ0 : MvPowerSeries (Fin 2) R →+* fexaAA R ϖ 1 :=
    (Ideal.Quotient.mk I1).comp (MvPowerSeries.rescale a)
  have hΘ0 : ∀ z ∈ In, Θ0 z = 0 := by
    intro z hz
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    show Ideal.Quotient.mk I1 (MvPowerSeries.rescale a (c * _)) = 0
    rw [map_mul, hkey, map_mul, map_mul, hI1z, mul_zero, mul_zero]
  let Θ : fexaAA R ϖ n →+* fexaAA R ϖ 1 := Ideal.Quotient.lift In Θ0 hΘ0
  have hΘ : ∀ F, Θ (Ideal.Quotient.mk In F) = Ideal.Quotient.mk I1 (MvPowerSeries.rescale a F) :=
    fun F => Ideal.Quotient.lift_mk _ _ _
  have hΘw : Θ (fexaW R ϖ n) = fexaW R ϖ 1 := by
    show Θ (Ideal.Quotient.mk In (MvPowerSeries.C ϖ)) = Ideal.Quotient.mk I1 (MvPowerSeries.C ϖ)
    rw [hΘ, hrC]
  have hΘx : Θ (fexaX R ϖ n) = fexaW R ϖ 1 ^ (i : ℕ) * fexaX R ϖ 1 := by
    show Θ (Ideal.Quotient.mk In (MvPowerSeries.X 0)) =
      Ideal.Quotient.mk I1 (MvPowerSeries.C ϖ) ^ (i : ℕ) * Ideal.Quotient.mk I1 (MvPowerSeries.X 0)
    rw [hΘ, hrX, map_mul, ha0, map_pow, map_pow]
  have hΘy : Θ (fexaY R ϖ n) = fexaW R ϖ 1 ^ (n - 1 - (i : ℕ)) * fexaY R ϖ 1 := by
    show Θ (Ideal.Quotient.mk In (MvPowerSeries.X 1)) =
      Ideal.Quotient.mk I1 (MvPowerSeries.C ϖ) ^ (n - 1 - (i : ℕ)) *
        Ideal.Quotient.mk I1 (MvPowerSeries.X 1)
    rw [hΘ, hrX, map_mul, ha1, map_pow, map_pow]
  have hinj : Function.Injective
      (algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1))) :=
    IsLocalization.injective (Localization.Away (fexaW R ϖ 1))
      (powers_le_nonZeroDivisors_of_noZeroDivisors hw1)
  have hunit : IsUnit ((algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1))).comp Θ
      (fexaW R ϖ n)) := by
    rw [RingHom.comp_apply, hΘw]; exact IsLocalization.Away.algebraMap_isUnit _
  let ΘL : Localization.Away (fexaW R ϖ n) →+* Localization.Away (fexaW R ϖ 1) :=
    IsLocalization.Away.lift (fexaW R ϖ n) hunit
  have hΘL : ∀ z, ΘL (algebraMap (fexaAA R ϖ n) (Localization.Away (fexaW R ϖ n)) z) =
      algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)) (Θ z) :=
    fun z => IsLocalization.Away.lift_eq _ hunit z
  have hWι : algebraMap (fexaAA R ϖ n) (Localization.Away (fexaW R ϖ n)) (fexaW R ϖ n) *
      Localization.Away.invSelf (fexaW R ϖ n) = 1 := by
    rw [Localization.Away.invSelf, ← Localization.mk_one_eq_algebraMap, Localization.mk_mul,
      mul_one, one_mul]
    exact Localization.mk_self (⟨fexaW R ϖ n, Submonoid.mem_powers _⟩ :
      Submonoid.powers (fexaW R ϖ n))
  have hinv : algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)) (fexaW R ϖ 1) *
      ΘL (Localization.Away.invSelf (fexaW R ϖ n)) = 1 := by
    have h1 := congrArg ΘL hWι
    rwa [map_mul, map_one, hΘL, hΘw] at h1
  have hLα : ΘL (fexaAlpha (fexaX R ϖ n) (fexaW R ϖ n) (i : ℕ)) =
      algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)) (fexaX R ϖ 1) := by
    rw [fexaAlpha, map_mul ΘL, map_pow ΘL, hΘL, hΘx,
      map_mul (algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1))),
      map_pow (algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)))]
    calc _ = algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)) (fexaX R ϖ 1) *
          (algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)) (fexaW R ϖ 1) *
            ΘL (Localization.Away.invSelf (fexaW R ϖ n))) ^ (i : ℕ) := by ring
      _ = _ := by rw [hinv, one_pow, mul_one]
  have hLβ : ΘL (fexaBeta (fexaY R ϖ n) (fexaW R ϖ n) n (i : ℕ)) =
      algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)) (fexaY R ϖ 1) := by
    rw [fexaBeta, map_mul ΘL, map_pow ΘL, hΘL, hΘy,
      map_mul (algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1))),
      map_pow (algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)))]
    calc _ = algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)) (fexaY R ϖ 1) *
          (algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)) (fexaW R ϖ 1) *
            ΘL (Localization.Away.invSelf (fexaW R ϖ n))) ^ (n - 1 - (i : ℕ)) := by ring
      _ = _ := by rw [hinv, one_pow, mul_one]
  have hmem : ∀ z : ↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}),
      (ΘL.comp (fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}).val.toRingHom) z ∈
        (algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1))).range :=
    fcqpH_ind (fexaAA R ϖ n) _ _ _ n i _ _ _
      (fun a => RingHom.mem_range.mpr ⟨Θ a, (hΘL a).symm⟩)
      (RingHom.mem_range.mpr ⟨_, hLα.symm⟩) (RingHom.mem_range.mpr ⟨_, hLβ.symm⟩)
  let ψ0 := (ΘL.comp (fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}).val.toRingHom).codRestrict
    _ hmem
  let eT : fexaAA R ϖ 1 ≃+* (algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1))).range :=
    RingEquiv.ofBijective (algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1))).rangeRestrict
      ⟨fun a b h => hinj (congrArg Subtype.val h), RingHom.rangeRestrict_surjective _⟩
  have hψ : ∀ z, algebraMap (fexaAA R ϖ 1) (Localization.Away (fexaW R ϖ 1)) (eT.symm (ψ0 z)) =
      ΘL z.1 := fun z => congrArg Subtype.val (eT.apply_symm_apply (ψ0 z))
  refine ⟨eT.symm.toRingHom.comp ψ0, ?_, ?_, ?_⟩
  · apply hinj; exact (hψ _).trans hLα
  · apply hinj; exact (hψ _).trans hLβ
  · intro F
    apply hinj
    refine (hψ _).trans ?_
    show ΘL (algebraMap (fexaAA R ϖ n) (Localization.Away (fexaW R ϖ n))
      (Ideal.Quotient.mk In F)) = _
    rw [hΘL, hΘ]

have fcqpH_side (R : Type u) [CommRing R] (ϖ : R) [hmax : (Ideal.span {ϖ}).IsMaximal]
    (P : Type u) [CommRing P] (c : MvPowerSeries (Fin 2) R →+* P) (u v : P) (σ τ : Fin 2)
    (hστ : σ ≠ τ) (b : R) (T : P →+* PowerSeries (R ⧸ Ideal.span {ϖ}))
    (hgen : ∀ (B : Type u) [CommRing B] (f : P →+* B) (S : Subring B),
      (∀ F, f (c F) ∈ S) → f u ∈ S → f v ∈ S → ∀ z, f z ∈ S)
    (hu : T u = 0) (hv : T v = PowerSeries.X)
    (hT : ∀ F, T (c F) = PowerSeries.mk (fun m => Ideal.Quotient.mk (Ideal.span {ϖ})
      (b ^ m * MvPowerSeries.coeff (Finsupp.single τ m) F)))
    (hw : c (MvPowerSeries.C ϖ) ∈ Ideal.span {u}) (hxσ : c (MvPowerSeries.X σ) ∈ Ideal.span {u})
    (hcase : c (MvPowerSeries.X τ) ∈ Ideal.span {u} ∨ (b = 1 ∧ v = c (MvPowerSeries.X τ))) :
    IsDomain (P ⧸ Ideal.span {u}) ∧ IsPrincipalIdealRing (P ⧸ Ideal.span {u}) := by
  classical
  letI : Field (R ⧸ Ideal.span {ϖ}) := Ideal.Quotient.field _
  have hTI : ∀ z ∈ Ideal.span {u}, T z = 0 := by
    intro z hz
    obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    rw [map_mul, hu, mul_zero]
  set q := Ideal.Quotient.mk (Ideal.span {u}) with hq
  set Tb := Ideal.Quotient.lift (Ideal.span {u}) T hTI with hTb
  have hTbq : ∀ z, Tb (q z) = T z := fun z => Ideal.Quotient.lift_mk _ _ _
  have hqw : q (c (MvPowerSeries.C ϖ)) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hw
  have hqσ : q (c (MvPowerSeries.X σ)) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hxσ
  have hqu : q u = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self u)
  have hTC : ∀ r : R, T (c (MvPowerSeries.C r)) = PowerSeries.C (Ideal.Quotient.mk _ r) := by
    intro r
    rw [hT]
    ext m
    rw [PowerSeries.coeff_mk, PowerSeries.coeff_C, MvPowerSeries.coeff_C]
    rcases m with _ | m
    · simp
    · have : Finsupp.single τ (m + 1) ≠ 0 := by
        rw [Ne, Finsupp.single_eq_zero]; omega
      rw [if_neg this, if_neg (Nat.succ_ne_zero m), mul_zero, map_zero]
  rcases hcase with hτ | ⟨hb, hvτ⟩
  · have hqτ : q (c (MvPowerSeries.X τ)) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hτ
    have hqX : ∀ s : Fin 2, q (c (MvPowerSeries.X s)) = 0 := by
      intro s
      by_cases hs : s = σ
      · rw [hs]; exact hqσ
      · rw [fcqpH_fin2 σ τ s hστ hs]; exact hqτ
    let c0 : R →+* P ⧸ Ideal.span {u} := q.comp (c.comp MvPowerSeries.C)
    have hc0 : ∀ r ∈ Ideal.span {ϖ}, c0 r = 0 := by
      intro r hr
      obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.mp hr
      show q (c (MvPowerSeries.C (d * ϖ))) = 0
      rw [map_mul, map_mul, map_mul, hqw, mul_zero]
    let j : R ⧸ Ideal.span {ϖ} →+* P ⧸ Ideal.span {u} := Ideal.Quotient.lift _ c0 hc0
    have hj : ∀ r, j (Ideal.Quotient.mk _ r) = q (c (MvPowerSeries.C r)) :=
      fun r => Ideal.Quotient.lift_mk _ _ _
    have h1 : ∀ F, q (c F) ∈ (Polynomial.eval₂RingHom j (q v)).range := by
      intro F
      obtain ⟨G, H, hF⟩ := fcqpH_split3 R F
      refine RingHom.mem_range.mpr ⟨Polynomial.C (Ideal.Quotient.mk _ (MvPowerSeries.coeff 0 F)), ?_⟩
      show Polynomial.eval₂ j (q v) _ = _
      rw [Polynomial.eval₂_C, hj]
      conv_rhs => rw [hF]
      rw [map_add c, map_add c, map_mul c, map_mul c, map_add q, map_add q, map_mul q, map_mul q,
        hqX 0, hqX 1, zero_mul, zero_mul, add_zero, add_zero]
    have h2 : q u ∈ (Polynomial.eval₂RingHom j (q v)).range := by
      rw [hqu]; exact Subring.zero_mem _
    have h3 : q v ∈ (Polynomial.eval₂RingHom j (q v)).range :=
      RingHom.mem_range.mpr ⟨Polynomial.X, by
        show Polynomial.eval₂ j (q v) Polynomial.X = q v
        rw [Polynomial.eval₂_X]⟩
    have hall := hgen (P ⧸ Ideal.span {u}) q (Polynomial.eval₂RingHom j (q v)).range h1 h2 h3
    refine fcqpH_rec (P ⧸ Ideal.span {u}) (R ⧸ Ideal.span {ϖ}) Tb j (q v) ?_ ?_ ?_
    · intro k0
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective k0
      rw [hj, hTbq, hTC]
    · rw [hTbq, hv]
    · intro zb
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective zb
      exact RingHom.mem_range.mp (hall z)
  · apply fcqpH_bij (P ⧸ Ideal.span {u}) (R ⧸ Ideal.span {ϖ}) Tb
    have hT1 : ∀ F, T (c F) = PowerSeries.mk (fun m => Ideal.Quotient.mk (Ideal.span {ϖ})
        (MvPowerSeries.coeff (Finsupp.single τ m) F)) := by
      intro F; rw [hT, hb]; simp only [one_pow, one_mul]
    have hrep : ∀ z : P, q z ∈ (q.comp c).range :=
      hgen (P ⧸ Ideal.span {u}) q (q.comp c).range (fun F => RingHom.mem_range.mpr ⟨F, rfl⟩)
        (RingHom.mem_range.mpr ⟨0, by rw [RingHom.comp_apply, map_zero, map_zero, hqu]⟩)
        (RingHom.mem_range.mpr ⟨MvPowerSeries.X τ, by rw [RingHom.comp_apply, hvτ]⟩)
    constructor
    · rw [injective_iff_map_eq_zero]
      intro zb hzb
      obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective zb
      obtain ⟨F, hF⟩ := RingHom.mem_range.mp (hrep z)
      rw [RingHom.comp_apply] at hF
      rw [← hF] at hzb ⊢
      rw [hTbq, hT1] at hzb
      have hcoef : ∀ m, MvPowerSeries.coeff (Finsupp.single τ m) F ∈ Ideal.span {ϖ} := by
        intro m
        have := congrArg (PowerSeries.coeff m) hzb
        rw [PowerSeries.coeff_mk, map_zero] at this
        exact Ideal.Quotient.eq_zero_iff_mem.mp this
      obtain ⟨G, H, hGH⟩ := fcqpH_split_axis R ϖ σ τ hστ F hcoef
      rw [hGH, map_add c, map_mul c, map_mul c, map_add q, map_mul q, map_mul q, hqσ, hqw,
        zero_mul, zero_mul, add_zero]
    · intro g
      choose r hr using fun m => Ideal.Quotient.mk_surjective (I := Ideal.span {ϖ})
        (PowerSeries.coeff m g)
      obtain ⟨F, hF⟩ : ∃ F : MvPowerSeries (Fin 2) R, ∀ e, MvPowerSeries.coeff e F =
          if e σ = 0 then r (e τ) else 0 :=
        ⟨fun e => if e σ = 0 then r (e τ) else 0, fun e => rfl⟩
      refine ⟨q (c F), ?_⟩
      rw [hTbq, hT1]
      ext m
      have hs : (Finsupp.single τ m) σ = 0 := by rw [Finsupp.single_apply, if_neg hστ.symm]
      rw [PowerSeries.coeff_mk, hF, if_pos hs, Finsupp.single_eq_same, hr]

have fcqpH_main (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (ϖ : R) (hϖ : Irreducible ϖ) (n : ℕ) (hn : 1 ≤ n) [IsDomain (fexaAA R ϖ n)]
    [IsDomain (fexaAA R ϖ 1)] (hw : fexaW R ϖ n ≠ 0) (i : Fin n) :
    IsDomain (↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) ⧸
      Ideal.span {fexaAlphaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i}) ∧
    IsPrincipalIdealRing (↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) ⧸
      Ideal.span {fexaAlphaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i}) ∧
    IsDomain (↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) ⧸
      Ideal.span {fexaBetaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i}) ∧
    IsPrincipalIdealRing (↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) ⧸
      Ideal.span {fexaBetaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i}) := by
  classical
  haveI hmax : (Ideal.span {ϖ}).IsMaximal := by
    rw [← (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ]
    exact IsLocalRing.maximalIdeal.isMaximal R
  have hw1 := fcqpH_w1 R ϖ hϖ.ne_zero hϖ.not_isUnit
  have hi := i.2
  obtain ⟨ψ, hψα, hψβ, hψF⟩ := fcqpH_chart R ϖ n hn hw1 i
  obtain ⟨ρ0, hρ0⟩ := fcqpH_axis R ϖ (ϖ ^ 1) (dvd_pow_self ϖ one_ne_zero) 1
  obtain ⟨ρ1, hρ1⟩ := fcqpH_axis R ϖ (ϖ ^ 1) (dvd_pow_self ϖ one_ne_zero) 0
  let c : MvPowerSeries (Fin 2) R →+* ↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) :=
    (algebraMap (fexaAA R ϖ n) ↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i})).comp
      (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C (ϖ ^ n) : MvPowerSeries (Fin 2) R)}))
  have hxy : fexaX R ϖ n * fexaY R ϖ n = fexaW R ϖ n ^ n := by
    show Ideal.Quotient.mk _ (MvPowerSeries.X 0) * Ideal.Quotient.mk _ (MvPowerSeries.X 1) =
      (Ideal.Quotient.mk _ (MvPowerSeries.C ϖ)) ^ n
    rw [← map_mul, ← map_pow, ← map_pow MvPowerSeries.C, ← sub_eq_zero, ← map_sub,
      Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton_self _
  obtain ⟨I1, I2, I3, I4, I5⟩ := fcqpH_ident (fexaAA R ϖ n) _ _ _ n hn hxy i
  have cw : c (MvPowerSeries.C ϖ) = algebraMap (fexaAA R ϖ n) _ (fexaW R ϖ n) := rfl
  have cx : c (MvPowerSeries.X 0) = algebraMap (fexaAA R ϖ n) _ (fexaX R ϖ n) := rfl
  have cy : c (MvPowerSeries.X 1) = algebraMap (fexaAA R ϖ n) _ (fexaY R ϖ n) := rfl
  have hgen : ∀ (B : Type u) [CommRing B]
      (f : ↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) →+* B) (S : Subring B),
      (∀ F, f (c F) ∈ S) → f (fexaAlphaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i) ∈ S →
      f (fexaBetaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i) ∈ S → ∀ z, f z ∈ S := by
    intro B _ f S hc hu hv
    refine fcqpH_ind (fexaAA R ϖ n) _ _ _ n i B f S ?_ hu hv
    intro a
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective a
    exact hc F
  have hgen' : ∀ (B : Type u) [CommRing B]
      (f : ↥(fexaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n {i}) →+* B) (S : Subring B),
      (∀ F, f (c F) ∈ S) → f (fexaBetaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i) ∈ S →
      f (fexaAlphaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i) ∈ S → ∀ z, f z ∈ S :=
    fun B _ f S hc hu hv => hgen B f S hc hv hu
  have hX0 : ∀ (ρ : fexaAA R ϖ 1 →+* PowerSeries (R ⧸ Ideal.span {ϖ})) (s t : Fin 2),
      (∀ F : MvPowerSeries (Fin 2) R, ρ (Ideal.Quotient.mk _ F) = PowerSeries.mk
        (fun m => Ideal.Quotient.mk (Ideal.span {ϖ}) (MvPowerSeries.coeff (Finsupp.single s m) F))) →
      ρ (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 -
        MvPowerSeries.C (ϖ ^ 1) : MvPowerSeries (Fin 2) R)}) (MvPowerSeries.X t)) =
        if s = t then PowerSeries.X else 0 := by
    intro ρ s t hρ
    rw [hρ]
    ext m
    rw [PowerSeries.coeff_mk, fcqpH_coeff_X_single]
    by_cases hst : s = t
    · rw [if_pos hst, PowerSeries.coeff_X]
      by_cases hm : m = 1
      · rw [if_pos ⟨hst, hm⟩, if_pos hm, map_one]
      · rw [if_neg (fun h => hm h.2), if_neg hm, map_zero]
    · rw [if_neg (fun h => hst h.1), if_neg hst, map_zero, map_zero]
  have hρF : ∀ (ρ : fexaAA R ϖ 1 →+* PowerSeries (R ⧸ Ideal.span {ϖ})) (s : Fin 2),
      (∀ F : MvPowerSeries (Fin 2) R, ρ (Ideal.Quotient.mk _ F) = PowerSeries.mk
        (fun m => Ideal.Quotient.mk (Ideal.span {ϖ}) (MvPowerSeries.coeff (Finsupp.single s m) F))) →
      ∀ F, (ρ.comp ψ) (c F) = PowerSeries.mk (fun m => Ideal.Quotient.mk (Ideal.span {ϖ})
        ((![ϖ ^ (i : ℕ), ϖ ^ (n - 1 - (i : ℕ))] s) ^ m *
          MvPowerSeries.coeff (Finsupp.single s m) F)) := by
    intro ρ s hρ F
    rw [RingHom.comp_apply]
    show ρ (ψ (algebraMap (fexaAA R ϖ n) _ (Ideal.Quotient.mk _ F))) = _
    rw [hψF, hρ]
    ext m
    rw [PowerSeries.coeff_mk, PowerSeries.coeff_mk, fcqpH_coeff_rescale_single]
  have k0 : (![ϖ ^ (i : ℕ), ϖ ^ (n - 1 - (i : ℕ))] : Fin 2 → R) 0 = ϖ ^ (i : ℕ) := rfl
  have k1 : (![ϖ ^ (i : ℕ), ϖ ^ (n - 1 - (i : ℕ))] : Fin 2 → R) 1 = ϖ ^ (n - 1 - (i : ℕ)) := rfl
  set α := fexaAlphaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i with hαdef
  set β := fexaBetaP (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n i with hβdef
  have wα : c (MvPowerSeries.C ϖ) ∈ Ideal.span {α} := by
    rw [cw, I1]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  have wβ : c (MvPowerSeries.C ϖ) ∈ Ideal.span {β} := by
    rw [cw, I1]; exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  have xα : c (MvPowerSeries.X 0) ∈ Ideal.span {α} := by
    rw [cx, I2]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  have yβ : c (MvPowerSeries.X 1) ∈ Ideal.span {β} := by
    rw [cy, I3]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  have sα := fcqpH_side R ϖ _ c α β 0 1 (by decide) (ϖ ^ (n - 1 - (i : ℕ))) (ρ0.comp ψ) hgen
    (by rw [RingHom.comp_apply, hψα]; exact (hX0 ρ0 1 0 hρ0).trans (if_neg (by decide)))
    (by rw [RingHom.comp_apply, hψβ]; exact (hX0 ρ0 1 1 hρ0).trans (if_pos rfl))
    (fun F => by rw [hρF ρ0 1 hρ0 F, k1]) wα xα (by
      by_cases hc : (i : ℕ) + 1 < n
      · left
        obtain ⟨k, hk⟩ : ∃ k, n - 1 - (i : ℕ) = k + 1 := ⟨n - 2 - (i : ℕ), by omega⟩
        rw [cy, I3, hk, pow_succ, ← cw]
        exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ wα)
      · right
        have h0 : n - 1 - (i : ℕ) = 0 := by omega
        refine ⟨by rw [h0, pow_zero], ?_⟩
        rw [cy]; exact I5 (by omega))
  have sβ := fcqpH_side R ϖ _ c β α 1 0 (by decide) (ϖ ^ (i : ℕ)) (ρ1.comp ψ) hgen'
    (by rw [RingHom.comp_apply, hψβ]; exact (hX0 ρ1 0 1 hρ1).trans (if_neg (by decide)))
    (by rw [RingHom.comp_apply, hψα]; exact (hX0 ρ1 0 0 hρ1).trans (if_pos rfl))
    (fun F => by rw [hρF ρ1 0 hρ1 F, k0]) wβ yβ (by
      by_cases hc : 1 ≤ (i : ℕ)
      · left
        obtain ⟨k, hk⟩ : ∃ k, (i : ℕ) = k + 1 := ⟨(i : ℕ) - 1, by omega⟩
        rw [cx, I2, hk, pow_succ, ← cw]
        exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ wβ)
      · right
        have h0 : (i : ℕ) = 0 := by omega
        refine ⟨by rw [h0, pow_zero], ?_⟩
        rw [cx]; exact I4 h0)
  exact ⟨sα.1, sα.2, sβ.1, sβ.2⟩
fcqpH_main R ϖ hϖ n hn hw i

theorem fexa_glue_exists (A : Type u) [CommRing A] (x y w : A) (n : ℕ) (hn : 1 ≤ n)
    (hxy : x * y = w ^ n) :
    ∃ (Y : Scheme.{u})
      (ι : ∀ T : Finset (Fin n), T.Nonempty → (Spec (CommRingCat.of ↥(fexaP x y w n T)) ⟶ Y))
      (ρ : Y ⟶ Spec (CommRingCat.of A)), fexaGlued x y w n Y ι ρ :=
by

  have E0 : algebraMap A (Localization.Away w) w * Localization.Away.invSelf w = 1 := by
    rw [Localization.Away.invSelf, ← Localization.mk_one_eq_algebraMap, Localization.mk_mul,
      mul_one, one_mul]
    exact Localization.mk_self (⟨w, Submonoid.mem_powers w⟩ : Submonoid.powers w)

  have E1 : ∀ k : ℕ, k + 1 < n → fexaAlpha x w (k + 1) * fexaBeta y w n k = 1 := by
    intro k hk
    have he : (k + 1) + (n - 1 - k) = n := by omega
    unfold fexaAlpha fexaBeta
    calc algebraMap A (Localization.Away w) x * Localization.Away.invSelf w ^ (k + 1) *
          (algebraMap A (Localization.Away w) y * Localization.Away.invSelf w ^ (n - 1 - k))
        = algebraMap A (Localization.Away w) (x * y) *
            Localization.Away.invSelf w ^ ((k + 1) + (n - 1 - k)) := by
          rw [map_mul, pow_add]; ring
      _ = 1 := by rw [he, hxy, map_pow, ← mul_pow, E0, one_pow]

  have E2 : ∀ k i : ℕ, k ≤ i → fexaAlpha x w k =
      algebraMap A (Localization.Away w) w ^ (i - k) * fexaAlpha x w i := by
    intro k i hki
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hki
    rw [Nat.add_sub_cancel_left]
    unfold fexaAlpha
    calc algebraMap A (Localization.Away w) x * Localization.Away.invSelf w ^ k
        = algebraMap A (Localization.Away w) x * Localization.Away.invSelf w ^ k *
            (algebraMap A (Localization.Away w) w * Localization.Away.invSelf w) ^ d := by
          rw [E0, one_pow, mul_one]
      _ = _ := by rw [pow_add, mul_pow]; ring

  have E3 : ∀ i k : ℕ, i ≤ k → k < n → fexaBeta y w n k =
      algebraMap A (Localization.Away w) w ^ (k - i) * fexaBeta y w n i := by
    intro i k hik hkn
    have he : n - 1 - i = (n - 1 - k) + (k - i) := by omega
    unfold fexaBeta
    rw [he]
    calc algebraMap A (Localization.Away w) y * Localization.Away.invSelf w ^ (n - 1 - k)
        = algebraMap A (Localization.Away w) y * Localization.Away.invSelf w ^ (n - 1 - k) *
            (algebraMap A (Localization.Away w) w * Localization.Away.invSelf w) ^ (k - i) := by
          rw [E0, one_pow, mul_one]
      _ = _ := by rw [pow_add, mul_pow]; ring

  have hmono : ∀ {T T' : Finset (Fin n)}, T ⊆ T' → fexaP x y w n T ≤ fexaP x y w n T' := by
    intro T T' h
    exact Algebra.adjoin_mono (fun z hz => by
      obtain ⟨i, hi, hz⟩ := Set.mem_iUnion₂.mp hz
      exact Set.mem_iUnion₂.mpr ⟨i, h hi, hz⟩)
  have memα : ∀ (i : Fin n) (k : ℕ), k ≤ (i : ℕ) → fexaAlpha x w k ∈ fexaP x y w n {i} := by
    intro i k hk
    rw [E2 k i hk]
    exact Subalgebra.mul_mem _ (Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ w) _)
      (fexaAlphaP x y w n i).2
  have memβ : ∀ (i : Fin n) (k : ℕ), (i : ℕ) ≤ k → k < n →
      fexaBeta y w n k ∈ fexaP x y w n {i} := by
    intro i k hk hkn
    rw [E3 i k hk hkn]
    exact Subalgebra.mul_mem _ (Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ w) _)
      (fexaBetaP x y w n i).2

  have ratio_mem : ∀ (i : Fin n) (j : ℕ), j < n →
      fexaT x y w n i j ∈ fexaP x y w n {i} ∧
      fexaAlpha x w j * fexaT x y w n i j ∈ fexaP x y w n {i} ∧
      fexaBeta y w n j * fexaT x y w n i j ∈ fexaP x y w n {i} := by
    intro i j hj
    have hi := i.2
    unfold fexaT
    split_ifs with hij
    · have tmem : ∀ a b : ℕ, (i : ℕ) ≤ a → b ≤ n →
          ∏ k ∈ Finset.Ico a b, fexaBeta y w n k ∈ fexaP x y w n {i} := by
        intro a b ha hb
        refine Subalgebra.prod_mem _ (fun k hk => ?_)
        have hk' := Finset.mem_Ico.mp hk
        exact memβ i k (by omega) (by omega)
      refine ⟨tmem _ _ le_rfl (by omega), ?_, Subalgebra.mul_mem _ (memβ i j hij hj)
        (tmem _ _ le_rfl (by omega))⟩
      rcases Nat.eq_or_lt_of_le hij with h | h
      · exact Subalgebra.mul_mem _ (memα i j (by omega)) (tmem _ _ le_rfl (by omega))
      · obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
        rw [Finset.prod_Ico_succ_top (by omega : (i : ℕ) ≤ j')]
        have e : fexaAlpha x w (j' + 1) *
            ((∏ k ∈ Finset.Ico (i : ℕ) j', fexaBeta y w n k) * fexaBeta y w n j') =
            (∏ k ∈ Finset.Ico (i : ℕ) j', fexaBeta y w n k) *
              (fexaAlpha x w (j' + 1) * fexaBeta y w n j') := by ring
        rw [e, E1 j' hj, mul_one]
        exact tmem _ _ le_rfl (by omega)
    · have tmem : ∀ a b : ℕ, b ≤ (i : ℕ) →
          ∏ k ∈ Finset.Ioc a b, fexaAlpha x w k ∈ fexaP x y w n {i} := by
        intro a b hb
        refine Subalgebra.prod_mem _ (fun k hk => ?_)
        have hk' := Finset.mem_Ioc.mp hk
        exact memα i k (by omega)
      refine ⟨tmem _ _ le_rfl, Subalgebra.mul_mem _ (memα i j (by omega)) (tmem _ _ le_rfl), ?_⟩
      rw [← Finset.prod_Ioc_consecutive _ (Nat.le_succ j) (by omega : j + 1 ≤ (i : ℕ)),
        Nat.Ioc_succ_singleton, Finset.prod_singleton]
      have e : fexaBeta y w n j * (fexaAlpha x w (j + 1) *
            ∏ k ∈ Finset.Ioc (j + 1) (i : ℕ), fexaAlpha x w k) =
          (fexaAlpha x w (j + 1) * fexaBeta y w n j) *
            ∏ k ∈ Finset.Ioc (j + 1) (i : ℕ), fexaAlpha x w k := by ring
      rw [e, E1 j (by omega), one_mul]
      exact tmem _ _ le_rfl

  have claim : ∀ i m : ℕ, i ≤ m → m < n →
      (∏ k ∈ Finset.Ico i m, fexaBeta y w n k) * (∏ k ∈ Finset.Ioc i m, fexaAlpha x w k) = 1 := by
    intro i m him
    induction m, him using Nat.le_induction with
    | base => intro _; simp
    | succ m hm ih =>
      intro hm1
      rw [Finset.prod_Ico_succ_top hm, Finset.prod_Ioc_succ_top hm]
      have e : (∏ k ∈ Finset.Ico i m, fexaBeta y w n k) * fexaBeta y w n m *
          ((∏ k ∈ Finset.Ioc i m, fexaAlpha x w k) * fexaAlpha x w (m + 1)) =
          ((∏ k ∈ Finset.Ico i m, fexaBeta y w n k) * (∏ k ∈ Finset.Ioc i m, fexaAlpha x w k)) *
            (fexaAlpha x w (m + 1) * fexaBeta y w n m) := by ring
      rw [e, ih (by omega), E1 m hm1, one_mul]
  have ratio_inv : ∀ i j : ℕ, i < n → j < n → fexaT x y w n i j * fexaT x y w n j i = 1 := by
    intro i j hi hj
    unfold fexaT
    split_ifs with h1 h2 h2
    · have : i = j := le_antisymm h1 h2
      subst this
      simp
    · exact claim i j h1 hj
    · rw [mul_comm]; exact claim j i h2 hi
    · omega

  have away : ∀ (S S' : Subalgebra A (Localization.Away w)) (f : S →+* S')
      (hf : ∀ a, ((f a : S') : Localization.Away w) = (a : Localization.Away w)) (s : S),
      (∃ v ∈ S', (s : Localization.Away w) * v = 1) →
      (∀ z ∈ S', ∃ N : ℕ, z * (s : Localization.Away w) ^ N ∈ S) →
      @IsLocalization.Away S _ s S' _ f.toAlgebra := by
    intro S S' f hf s ⟨v, hv, hsv⟩ hsurj
    letI := f.toAlgebra
    refine IsLocalization.Away.mk s ?_ ?_ ?_
    · refine isUnit_iff_exists_inv.mpr ⟨⟨v, hv⟩, Subtype.ext ?_⟩
      rw [RingHom.algebraMap_toAlgebra, Subalgebra.coe_mul, hf]
      simpa using hsv
    · intro z
      obtain ⟨N, hN⟩ := hsurj z.1 z.2
      refine ⟨N, ⟨_, hN⟩, Subtype.ext ?_⟩
      rw [RingHom.algebraMap_toAlgebra, Subalgebra.coe_mul, Subalgebra.coe_pow, hf, hf]
    · intro a b hab
      refine ⟨0, ?_⟩
      rw [RingHom.algebraMap_toAlgebra] at hab
      have : a = b := Subtype.ext (by rw [← hf a, ← hf b, hab])
      rw [this]
  have surj_of_gen : ∀ (S : Subalgebra A (Localization.Away w)) (G : Set (Localization.Away w))
      (s : Localization.Away w), s ∈ S → (∀ g ∈ G, ∃ N : ℕ, g * s ^ N ∈ S) →
      ∀ z ∈ Algebra.adjoin A G, ∃ N : ℕ, z * s ^ N ∈ S := by
    intro S G s hs hG z hz
    induction hz using Algebra.adjoin_induction with
    | mem g hg => exact hG g hg
    | algebraMap r => exact ⟨0, by simpa using S.algebraMap_mem r⟩
    | add a b _ _ ha hb =>
      obtain ⟨N1, h1⟩ := ha
      obtain ⟨N2, h2⟩ := hb
      refine ⟨N1 + N2, ?_⟩
      have e : (a + b) * s ^ (N1 + N2) = (a * s ^ N1) * s ^ N2 + (b * s ^ N2) * s ^ N1 := by ring
      rw [e]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ h1 (Subalgebra.pow_mem _ hs _))
        (Subalgebra.mul_mem _ h2 (Subalgebra.pow_mem _ hs _))
    | mul a b _ _ ha hb =>
      obtain ⟨N1, h1⟩ := ha
      obtain ⟨N2, h2⟩ := hb
      refine ⟨N1 + N2, ?_⟩
      have e : (a * b) * s ^ (N1 + N2) = (a * s ^ N1) * (b * s ^ N2) := by ring
      rw [e]
      exact Subalgebra.mul_mem _ h1 h2

  have loc : ∀ (T T' : Finset (Fin n)) (h : T ⊆ T') (i0 : Fin n), i0 ∈ T →
      ∃ s : fexaP x y w n T,
        (s : Localization.Away w) = ∏ j ∈ T' \ T, fexaT x y w n i0 j ∧
        IsOpenImmersion (Spec.map (fexaIncl x y w n h)) ∧
        Set.range (Spec.map (fexaIncl x y w n h)) = SetLike.coe (PrimeSpectrum.basicOpen s) := by
    intro T T' h i0 hi0
    have hi0T : ({i0} : Finset (Fin n)) ⊆ T := Finset.singleton_subset_iff.mpr hi0
    have hsP : ∏ j ∈ T' \ T, fexaT x y w n i0 j ∈ fexaP x y w n T :=
      Subalgebra.prod_mem _ (fun j _ => hmono hi0T (ratio_mem i0 j j.2).1)
    let s : fexaP x y w n T := ⟨_, hsP⟩
    letI : Algebra (fexaP x y w n T) (fexaP x y w n T') := (fexaIncl x y w n h).hom.toAlgebra
    haveI hloc : IsLocalization.Away s (fexaP x y w n T') := by
      refine away _ _ (fexaIncl x y w n h).hom (fun a => rfl) s ?_ ?_
      · refine ⟨∏ j ∈ T' \ T, fexaT x y w n j i0, ?_, ?_⟩
        · refine Subalgebra.prod_mem _ (fun j hj => ?_)
          have hjT' : ({j} : Finset (Fin n)) ⊆ T' :=
            Finset.singleton_subset_iff.mpr (Finset.mem_sdiff.mp hj).1
          exact hmono hjT' (ratio_mem j i0 i0.2).1
        · show (∏ j ∈ T' \ T, fexaT x y w n i0 j) * ∏ j ∈ T' \ T, fexaT x y w n j i0 = 1
          rw [← Finset.prod_mul_distrib]
          exact Finset.prod_eq_one (fun j _ => ratio_inv i0 j i0.2 j.2)
      · apply surj_of_gen _ _ _ hsP
        intro g hg
        obtain ⟨i, hi, hg⟩ := Set.mem_iUnion₂.mp hg
        by_cases hiT : i ∈ T
        · refine ⟨0, ?_⟩
          rw [pow_zero, mul_one]
          exact Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨i, hiT, hg⟩)
        · have hiD : i ∈ T' \ T := Finset.mem_sdiff.mpr ⟨hi, hiT⟩
          refine ⟨1, ?_⟩
          rw [pow_one, ← Finset.mul_prod_erase _ _ hiD, ← mul_assoc]
          refine hmono hi0T (Subalgebra.mul_mem _ ?_
            (Subalgebra.prod_mem _ (fun l _ => (ratio_mem i0 l l.2).1)))
          rcases hg with rfl | hg
          · exact (ratio_mem i0 i i.2).2.1
          · rw [Set.mem_singleton_iff.mp hg]
            exact (ratio_mem i0 i i.2).2.2
    refine ⟨s, rfl, ?_, ?_⟩
    · exact IsOpenImmersion.of_isLocalization (R := fexaP x y w n T) (S := fexaP x y w n T') s
    · ext p
      rw [← PrimeSpectrum.localization_away_comap_range (fexaP x y w n T') s]
      constructor
      · rintro ⟨q, rfl⟩
        exact ⟨q, (Spec.map_apply (fexaIncl x y w n h) q).symm⟩
      · rintro ⟨q, rfl⟩
        exact ⟨q, Spec.map_apply (fexaIncl x y w n h) q⟩

  have gen : ∀ (S S' S'' : Subalgebra A (Localization.Away w)) (e1 : S ≤ S') (e2 : S' ≤ S'')
      (e3 : S ≤ S''),
      CommRingCat.ofHom (Subalgebra.inclusion e1).toRingHom ≫
        CommRingCat.ofHom (Subalgebra.inclusion e2).toRingHom =
      CommRingCat.ofHom (Subalgebra.inclusion e3).toRingHom := by
    intro S S' S'' e1 e2 e3
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro a
    apply Subtype.ext
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
      AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_inclusion]
  obtain ⟨Z, ι, G1, G2, G3, G4, UP⟩ := wcpa_dj_lmfg_affine_glue n
    (fun T => CommRingCat.of ↥(fexaP x y w n T)) (fun T T' h => fexaIncl x y w n h)
    (fun T => by ext a; rfl)
    (fun T T' T'' h h' => gen _ _ _ _ _ _)
    (fun T T' h hT => by
      obtain ⟨i0, hi0⟩ := hT
      obtain ⟨s, -, hs, -⟩ := loc T T' h i0 hi0
      exact hs)
    (fun T T1 T2 h1 h2 hT => by
      obtain ⟨i0, hi0⟩ := hT
      obtain ⟨s1, hs1, -, hr1⟩ := loc T T1 h1 i0 hi0
      obtain ⟨s2, hs2, -, hr2⟩ := loc T T2 h2 i0 hi0
      obtain ⟨s12, hs12, -, hr12⟩ := loc T (T1 ∪ T2) (h1.trans Finset.subset_union_left) i0 hi0
      have hcP : ∏ j ∈ (T1 \ T) ∩ (T2 \ T), fexaT x y w n i0 j ∈ fexaP x y w n T :=
        Subalgebra.prod_mem _ (fun j _ =>
          hmono (Finset.singleton_subset_iff.mpr hi0) (ratio_mem i0 j j.2).1)
      have heq : s12 * ⟨_, hcP⟩ = s1 * s2 := by
        apply Subtype.ext
        rw [Subalgebra.coe_mul, Subalgebra.coe_mul, hs1, hs2, hs12, Finset.union_sdiff_distrib]
        exact Finset.prod_union_inter
      rintro p ⟨hp1, hp2⟩
      show p ∈ Set.range (Spec.map (fexaIncl x y w n (h1.trans Finset.subset_union_left)))
      rw [hr1] at hp1
      rw [hr2] at hp2
      rw [hr12]
      have hp1' : s1 ∉ p.asIdeal := hp1
      have hp2' : s2 ∉ p.asIdeal := hp2
      show s12 ∉ p.asIdeal
      intro h12
      have : s1 * s2 ∈ p.asIdeal := by
        rw [← heq]
        exact Ideal.mul_mem_right _ _ h12
      rcases p.isPrime.mem_or_mem this with h | h
      · exact hp1' h
      · exact hp2' h)
  obtain ⟨ρ, hρ⟩ := UP (Spec (CommRingCat.of A))
    (fun T _ => Spec.map (CommRingCat.ofHom (algebraMap A ↥(fexaP x y w n T))))
    (fun T T' h hT => by
      show Spec.map (fexaIncl x y w n h) ≫
          Spec.map (CommRingCat.ofHom (algebraMap A ↥(fexaP x y w n T))) =
        Spec.map (CommRingCat.ofHom (algebraMap A ↥(fexaP x y w n T')))
      rw [← Spec.map_comp]
      congr 1)
  exact ⟨Z, ι, ρ, G1, G2, G3, G4, hρ⟩

theorem fexgp_chart_ratios {A : Type u} [CommRing A] (x y w : A) (n : ℕ) (hxy : x * y = w ^ n) :
    (∀ l j : Fin n, fexaT x y w n l j ∈ fexaP x y w n {l}) ∧
    (∀ l j : Fin n, algebraMap A (Localization.Away w) (fexaG x w n j) =
      fexaT x y w n l j * algebraMap A (Localization.Away w) (fexaG x w n l)) ∧
    (∀ l j : Fin n, fexaT x y w n l j * fexaT x y w n j l = 1) ∧
    (∀ (l : Fin n), ∀ z ∈ fexaP x y w n {l}, z ∈ Subring.closure
      (Set.range (algebraMap A (Localization.Away w)) ∪
        Set.range (fun k : Fin n => fexaT x y w n l k))) :=
by
  classical
  have hU : algebraMap A (Localization.Away w) w * Localization.Away.invSelf w = 1 := by
    rw [Localization.Away.invSelf, Localization.mk_eq_mk']
    exact IsLocalization.Away.mul_invSelf w
  have hUp : ∀ a : ℕ, algebraMap A (Localization.Away w) w ^ a *
      Localization.Away.invSelf w ^ a = 1 := fun a => by rw [← mul_pow, hU, one_pow]
  have hR : algebraMap A (Localization.Away w) x * algebraMap A (Localization.Away w) y =
      algebraMap A (Localization.Away w) w ^ n := by
    rw [← map_mul, hxy, map_pow]

  have E1 : ∀ l k : ℕ, l ≤ k → k < n →
      fexaBeta y w n k = fexaBeta y w n l * algebraMap A (Localization.Away w) w ^ (k - l) := by
    intro l k hlk hkn
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hlk
    unfold fexaBeta
    rw [Nat.add_sub_cancel_left, show n - 1 - l = (n - 1 - (l + d)) + d by omega, pow_add]
    linear_combination (-(algebraMap A (Localization.Away w) y *
      Localization.Away.invSelf w ^ (n - 1 - (l + d)))) * hUp d

  have E2 : ∀ l k : ℕ, k ≤ l →
      fexaAlpha x w k = fexaAlpha x w l * algebraMap A (Localization.Away w) w ^ (l - k) := by
    intro l k hkl
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hkl
    unfold fexaAlpha
    rw [Nat.add_sub_cancel_left, pow_add]
    linear_combination (-(algebraMap A (Localization.Away w) x *
      Localization.Away.invSelf w ^ k)) * hUp d

  have E3 : ∀ m : ℕ, m + 1 < n → fexaAlpha x w (m + 1) * fexaBeta y w n m = 1 := by
    intro m hm
    unfold fexaAlpha fexaBeta
    have h : Localization.Away.invSelf w ^ (m + 1) * Localization.Away.invSelf w ^ (n - 1 - m) =
        Localization.Away.invSelf w ^ n := by
      rw [← pow_add]; congr 1; omega
    linear_combination (Localization.Away.invSelf w ^ (m + 1) *
      Localization.Away.invSelf w ^ (n - 1 - m)) * hR +
      algebraMap A (Localization.Away w) w ^ n * h + hUp n

  have E4 : ∀ m : ℕ, m + 1 < n → fexaBeta y w n m *
      algebraMap A (Localization.Away w) (fexaG x w n m) =
      algebraMap A (Localization.Away w) (fexaG x w n (m + 1)) := by
    intro m hm
    unfold fexaBeta fexaG
    rw [map_mul, map_mul, map_pow, map_pow, map_pow, map_pow]
    obtain ⟨e, he⟩ : ∃ e, n - 1 - (m + 1) = e := ⟨_, rfl⟩
    obtain ⟨t, ht⟩ : ∃ t, m * (m + 1) / 2 = t := ⟨_, rfl⟩
    have h1 : n - 1 - m = e + 1 := by omega
    have h2 : (m + 1) * (m + 1 + 1) / 2 = t + (m + 1) := by
      rw [← ht, show (m + 1) * (m + 1 + 1) = m * (m + 1) + 2 * (m + 1) by ring,
        Nat.add_mul_div_left _ _ (by norm_num : 0 < 2)]
    have hR' : algebraMap A (Localization.Away w) x * algebraMap A (Localization.Away w) y =
        algebraMap A (Localization.Away w) w ^ (e + 1) *
          algebraMap A (Localization.Away w) w ^ (m + 1) := by
      rw [hR, ← pow_add]; congr 1; omega
    rw [h1, he, h2, ht]
    linear_combination (algebraMap A (Localization.Away w) x ^ e *
      Localization.Away.invSelf w ^ (e + 1) * algebraMap A (Localization.Away w) w ^ t) * hR' +
      (algebraMap A (Localization.Away w) x ^ e * algebraMap A (Localization.Away w) w ^ t *
        algebraMap A (Localization.Away w) w ^ (m + 1)) * hUp (e + 1)

  have E5 : ∀ m : ℕ, m + 1 < n → algebraMap A (Localization.Away w) (fexaG x w n m) =
      fexaAlpha x w (m + 1) * algebraMap A (Localization.Away w) (fexaG x w n (m + 1)) := by
    intro m hm
    rw [← E4 m hm]
    linear_combination (-algebraMap A (Localization.Away w) (fexaG x w n m)) * E3 m hm

  have ClaimB : ∀ l d : ℕ, l + d < n → algebraMap A (Localization.Away w) (fexaG x w n (l + d)) =
      (∏ k ∈ Finset.Ico l (l + d), fexaBeta y w n k) *
        algebraMap A (Localization.Away w) (fexaG x w n l) := by
    intro l d
    induction d with
    | zero => intro _; simp
    | succ d ih =>
      intro h
      rw [← add_assoc, Finset.prod_Ico_succ_top (by omega : l ≤ l + d), ← E4 (l + d) (by omega),
        ih (by omega)]
      ring

  have ClaimA : ∀ j d : ℕ, j + d < n → algebraMap A (Localization.Away w) (fexaG x w n j) =
      (∏ k ∈ Finset.Ioc j (j + d), fexaAlpha x w k) *
        algebraMap A (Localization.Away w) (fexaG x w n (j + d)) := by
    intro j d
    induction d with
    | zero => intro _; simp
    | succ d ih =>
      intro h
      rw [← add_assoc, Finset.prod_Ioc_succ_top (by omega : j ≤ j + d), ih (by omega),
        E5 (j + d) (by omega)]
      ring

  have hαmem : ∀ l : Fin n, fexaAlpha x w l ∈ fexaP x y w n {l} := fun l =>
    Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨l, Finset.mem_singleton_self l,
      Set.mem_insert _ _⟩)
  have hβmem : ∀ l : Fin n, fexaBeta y w n l ∈ fexaP x y w n {l} := fun l =>
    Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨l, Finset.mem_singleton_self l,
      Set.mem_insert_of_mem _ (Set.mem_singleton _)⟩)
  have hWmem : ∀ (l : Fin n) (a : ℕ),
      algebraMap A (Localization.Away w) w ^ a ∈ fexaP x y w n {l} := fun l a =>
    Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ w) a

  have hb : ∀ l j : Fin n, algebraMap A (Localization.Away w) (fexaG x w n j) =
      fexaT x y w n l j * algebraMap A (Localization.Away w) (fexaG x w n l) := by
    intro l j
    have hl := l.isLt
    have hj := j.isLt
    unfold fexaT
    split_ifs with h
    · obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le h
      rw [hd]
      exact ClaimB l d (by omega)
    · obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le (le_of_lt (not_le.mp h))
      rw [hd]
      exact ClaimA j d (by omega)
  refine ⟨?_, hb, ?_, ?_⟩
  ·
    intro l j
    have hl := l.isLt
    have hj := j.isLt
    unfold fexaT
    split_ifs with h
    · apply Subalgebra.prod_mem
      intro k hk
      rw [Finset.mem_Ico] at hk
      rw [E1 l k hk.1 (by omega)]
      exact Subalgebra.mul_mem _ (hβmem l) (hWmem l _)
    · apply Subalgebra.prod_mem
      intro k hk
      rw [Finset.mem_Ioc] at hk
      rw [E2 l k hk.2]
      exact Subalgebra.mul_mem _ (hαmem l) (hWmem l _)
  ·
    have hW : IsUnit (algebraMap A (Localization.Away w) w) :=
      IsLocalization.Away.algebraMap_isUnit w
    have hWn : IsUnit (algebraMap A (Localization.Away w) x *
        algebraMap A (Localization.Away w) y) := by
      rw [hR]; exact hW.pow n
    have hX : IsUnit (algebraMap A (Localization.Away w) x) := isUnit_of_mul_isUnit_left hWn
    have hGu : ∀ l : ℕ, IsUnit (algebraMap A (Localization.Away w) (fexaG x w n l)) := by
      intro l
      unfold fexaG
      rw [map_mul, map_pow, map_pow]
      exact (hX.pow _).mul (hW.pow _)
    intro l j
    have h1 := hb l j
    have h2 := hb j l
    apply (hGu l).mul_right_cancel
    rw [one_mul]
    calc fexaT x y w n l j * fexaT x y w n j l *
          algebraMap A (Localization.Away w) (fexaG x w n l)
        = fexaT x y w n j l * (fexaT x y w n l j *
          algebraMap A (Localization.Away w) (fexaG x w n l)) := by ring
      _ = fexaT x y w n j l * algebraMap A (Localization.Away w) (fexaG x w n j) := by rw [← h1]
      _ = algebraMap A (Localization.Away w) (fexaG x w n l) := h2.symm
  ·
    intro i z hz
    have hz' : z ∈ Subring.closure (Set.range (algebraMap A (Localization.Away w)) ∪
        (⋃ i' ∈ ({i} : Finset (Fin n)),
          ({fexaAlpha x w i', fexaBeta y w n i'} : Set (Localization.Away w)))) := by
      rw [← Algebra.adjoin_eq_ring_closure]
      exact hz
    refine (Subring.closure_le.mpr ?_) hz'
    rintro s (⟨a, rfl⟩ | hs)
    · exact Subring.subset_closure (Or.inl ⟨a, rfl⟩)
    · have hs' : s ∈ ({fexaAlpha x w i, fexaBeta y w n i} : Set (Localization.Away w)) := by
        simpa only [Finset.mem_singleton, Set.iUnion_iUnion_eq_left] using hs
      clear hs
      have hi := i.isLt
      rcases Set.mem_insert_iff.mp hs' with rfl | hs
      · by_cases h0 : (i : ℕ) = 0
        · have e : fexaAlpha x w (i : ℕ) = algebraMap A (Localization.Away w) x := by
            unfold fexaAlpha; rw [h0, pow_zero, mul_one]
          rw [e]
          exact Subring.subset_closure (Or.inl ⟨x, rfl⟩)
        · have e : fexaT x y w n (i : ℕ) ((i : ℕ) - 1) = fexaAlpha x w (i : ℕ) := by
            unfold fexaT
            rw [if_neg (by omega)]
            have hI : Finset.Ioc ((i : ℕ) - 1) (i : ℕ) = {(i : ℕ)} := by
              ext k; simp only [Finset.mem_Ioc, Finset.mem_singleton]; omega
            rw [hI, Finset.prod_singleton]
          exact Subring.subset_closure (Or.inr ⟨⟨(i : ℕ) - 1, by omega⟩, e⟩)
      · rw [Set.mem_singleton_iff] at hs
        subst hs
        by_cases h1 : (i : ℕ) + 1 < n
        · have e : fexaT x y w n (i : ℕ) ((i : ℕ) + 1) = fexaBeta y w n (i : ℕ) := by
            unfold fexaT
            rw [if_pos (by omega)]
            have hI : Finset.Ico (i : ℕ) ((i : ℕ) + 1) = {(i : ℕ)} := by
              ext k; simp only [Finset.mem_Ico, Finset.mem_singleton]; omega
            rw [hI, Finset.prod_singleton]
          exact Subring.subset_closure (Or.inr ⟨⟨(i : ℕ) + 1, h1⟩, e⟩)
        · have e : fexaBeta y w n (i : ℕ) = algebraMap A (Localization.Away w) y := by
            unfold fexaBeta; rw [show n - 1 - (i : ℕ) = 0 by omega, pow_zero, mul_one]
          rw [e]
          exact Subring.subset_closure (Or.inl ⟨y, rfl⟩)

theorem fexgp_chart_lift {A : Type u} [CommRing A] (x y w : A) (n : ℕ) (hxy : x * y = w ^ n)
    (hT : ∀ i j : Fin n, fexaT x y w n i j ∈ fexaP x y w n {i}) (l k : Fin n)
    (hunit : fexaT x y w n l k * fexaT x y w n k l = 1)
    (p : PrimeSpectrum ↥(fexaP x y w n {l}))
    (hp : (⟨fexaT x y w n l k, hT l k⟩ : ↥(fexaP x y w n {l})) ∉ p.asIdeal) :
    ∃ q : PrimeSpectrum ↥(fexaP x y w n ({l} ∪ {k})),
      PrimeSpectrum.comap (fexaIncl x y w n
        (Finset.subset_union_left : ({l} : Finset (Fin n)) ⊆ {l} ∪ {k})).hom q = p :=
by
  classical
  have hln := l.isLt
  have hkn := k.isLt

  have hU : algebraMap A (Localization.Away w) w * Localization.Away.invSelf w = 1 := by
    rw [Localization.Away.invSelf, ← Localization.mk_one_eq_algebraMap, Localization.mk_mul,
      one_mul, mul_one]
    exact Localization.mk_self (⟨w, Submonoid.mem_powers w⟩ : Submonoid.powers w)

  have hR : algebraMap A (Localization.Away w) x * algebraMap A (Localization.Away w) y =
      algebraMap A (Localization.Away w) w ^ n := by
    rw [← map_mul, hxy, map_pow]
  have hcancel : ∀ i j : ℕ, i + (n - 1 - j) = n →
      fexaAlpha x w i * fexaBeta y w n j = 1 := by
    intro i j hij
    unfold fexaAlpha fexaBeta
    calc _ = (algebraMap A (Localization.Away w) x * algebraMap A (Localization.Away w) y) *
          Localization.Away.invSelf w ^ (i + (n - 1 - j)) := by rw [pow_add]; ring
      _ = 1 := by rw [hR, hij, ← mul_pow, hU, one_pow]
  have hshiftα : ∀ i j : ℕ, i ≤ j →
      fexaAlpha x w i = fexaAlpha x w j * algebraMap A (Localization.Away w) (w ^ (j - i)) := by
    intro i j hij
    unfold fexaAlpha
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hij
    rw [Nat.add_sub_cancel_left, map_pow, pow_add]
    calc _ = algebraMap A (Localization.Away w) x * Localization.Away.invSelf w ^ i *
          (algebraMap A (Localization.Away w) w * Localization.Away.invSelf w) ^ d := by
          rw [hU, one_pow, mul_one]
      _ = _ := by ring
  have hshiftβ : ∀ i j : ℕ, i ≤ j → j < n →
      fexaBeta y w n j = fexaBeta y w n i * algebraMap A (Localization.Away w) (w ^ (j - i)) := by
    intro i j hij hjn
    unfold fexaBeta
    have e : n - 1 - i = (n - 1 - j) + (j - i) := by omega
    rw [e, map_pow, pow_add]
    calc _ = algebraMap A (Localization.Away w) y * Localization.Away.invSelf w ^ (n - 1 - j) *
          (algebraMap A (Localization.Away w) w * Localization.Away.invSelf w) ^ (j - i) := by
          rw [hU, one_pow, mul_one]
      _ = _ := by ring
  have hαl : fexaAlpha x w l ∈ fexaP x y w n {l} := (fexaAlphaP x y w n l).2
  have hβl : fexaBeta y w n l ∈ fexaP x y w n {l} := (fexaBetaP x y w n l).2
  have hs : fexaT x y w n l k ∈ fexaP x y w n {l} := hT l k

  have hgen : ∀ g ∈ (⋃ i ∈ ({l} ∪ {k} : Finset (Fin n)),
      ({fexaAlpha x w i, fexaBeta y w n i} : Set (Localization.Away w))),
      ∃ N : ℕ, g * fexaT x y w n l k ^ N ∈ fexaP x y w n {l} := by
    intro g hg0
    obtain ⟨i, hi, hg⟩ := Set.mem_iUnion₂.mp hg0
    clear hg0
    have hbase : ∀ g ∈ ({fexaAlpha x w l, fexaBeta y w n l} : Set (Localization.Away w)),
        ∃ N : ℕ, g * fexaT x y w n l k ^ N ∈ fexaP x y w n {l} := by
      intro g hg
      refine ⟨0, ?_⟩
      rw [pow_zero, mul_one]
      exact Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨l, Finset.mem_singleton_self l, hg⟩)
    rcases Finset.mem_union.mp hi with hi | hi
    · rw [Finset.mem_singleton] at hi
      subst hi
      exact hbase g hg
    · rw [Finset.mem_singleton] at hi
      subst hi
      rcases lt_trichotomy (i : ℕ) (l : ℕ) with hlt | heq | hgt
      ·
        rcases Set.mem_insert_iff.mp hg with hg | hg
        · subst hg
          refine ⟨0, ?_⟩
          rw [pow_zero, mul_one, hshiftα i l hlt.le]
          exact Subalgebra.mul_mem _ hαl (Subalgebra.algebraMap_mem _ _)
        · rw [Set.mem_singleton_iff] at hg
          subst hg
          refine ⟨1, ?_⟩
          have hmem := hT l ⟨(i : ℕ) + 1, by omega⟩
          have hTe : fexaT x y w n l i =
              fexaAlpha x w ((i : ℕ) + 1) * fexaT x y w n l ((i : ℕ) + 1) := by
            unfold fexaT
            rw [if_neg (by omega)]
            have key := Finset.prod_Ioc_consecutive (fexaAlpha x w) (Nat.le_succ (i : ℕ))
              (show (i : ℕ) + 1 ≤ l by omega)
            rw [Nat.Ioc_succ_singleton, Finset.prod_singleton] at key
            rw [← key]
            congr 1
            by_cases h : (l : ℕ) = (i : ℕ) + 1
            · rw [if_pos (by omega), h, Finset.Ico_self, Finset.Ioc_self, Finset.prod_empty,
                Finset.prod_empty]
            · rw [if_neg (by omega)]
          have hc := hcancel ((i : ℕ) + 1) i (by omega)
          rw [pow_one, hTe]
          have e : fexaBeta y w n i * (fexaAlpha x w ((i : ℕ) + 1) * fexaT x y w n l ((i : ℕ) + 1))
              = fexaT x y w n l ((i : ℕ) + 1) := by
            linear_combination (fexaT x y w n l ((i : ℕ) + 1)) * hc
          rw [e]
          exact hmem
      · have : i = l := Fin.ext heq
        subst this
        exact hbase g hg
      ·
        rcases Set.mem_insert_iff.mp hg with hg | hg
        · subst hg
          refine ⟨1, ?_⟩
          have hmem := hT l ⟨(i : ℕ) - 1, by omega⟩
          have hTe : fexaT x y w n l i =
              fexaT x y w n l ((i : ℕ) - 1) * fexaBeta y w n ((i : ℕ) - 1) := by
            unfold fexaT
            rw [if_pos hgt.le, if_pos (by omega)]
            have key := Finset.prod_Ico_succ_top (show (l : ℕ) ≤ (i : ℕ) - 1 by omega)
              (fexaBeta y w n)
            rw [show (i : ℕ) - 1 + 1 = i by omega] at key
            exact key
          have hc := hcancel i ((i : ℕ) - 1) (by omega)
          rw [pow_one, hTe]
          have e : fexaAlpha x w i * (fexaT x y w n l ((i : ℕ) - 1) * fexaBeta y w n ((i : ℕ) - 1))
              = fexaT x y w n l ((i : ℕ) - 1) := by
            linear_combination (fexaT x y w n l ((i : ℕ) - 1)) * hc
          rw [e]
          exact hmem
        · rw [Set.mem_singleton_iff] at hg
          subst hg
          refine ⟨0, ?_⟩
          rw [pow_zero, mul_one, hshiftβ l i hgt.le i.isLt]
          exact Subalgebra.mul_mem _ hβl (Subalgebra.algebraMap_mem _ _)

  have hsat : ∀ z ∈ Algebra.adjoin A (⋃ i ∈ ({l} ∪ {k} : Finset (Fin n)),
      ({fexaAlpha x w i, fexaBeta y w n i} : Set (Localization.Away w))),
      ∃ N : ℕ, z * fexaT x y w n l k ^ N ∈ fexaP x y w n {l} := by
    intro z hz
    induction hz using Algebra.adjoin_induction with
    | mem g hg => exact hgen g hg
    | algebraMap r =>
      exact ⟨0, by rw [pow_zero, mul_one]; exact Subalgebra.algebraMap_mem _ r⟩
    | add a b _ _ ha hb =>
      obtain ⟨N1, h1⟩ := ha
      obtain ⟨N2, h2⟩ := hb
      refine ⟨N1 + N2, ?_⟩
      have e : (a + b) * fexaT x y w n l k ^ (N1 + N2) =
          (a * fexaT x y w n l k ^ N1) * fexaT x y w n l k ^ N2 +
            (b * fexaT x y w n l k ^ N2) * fexaT x y w n l k ^ N1 := by ring
      rw [e]
      exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ h1 (Subalgebra.pow_mem _ hs _))
        (Subalgebra.mul_mem _ h2 (Subalgebra.pow_mem _ hs _))
    | mul a b _ _ ha hb =>
      obtain ⟨N1, h1⟩ := ha
      obtain ⟨N2, h2⟩ := hb
      refine ⟨N1 + N2, ?_⟩
      have e : (a * b) * fexaT x y w n l k ^ (N1 + N2) =
          (a * fexaT x y w n l k ^ N1) * (b * fexaT x y w n l k ^ N2) := by ring
      rw [e]
      exact Subalgebra.mul_mem _ h1 h2

  have hkB : fexaP x y w n {k} ≤ fexaP x y w n ({l} ∪ {k}) :=
    Algebra.adjoin_mono (fun z hz => by
      obtain ⟨i, hi, hz⟩ := Set.mem_iUnion₂.mp hz
      exact Set.mem_iUnion₂.mpr ⟨i, Finset.subset_union_right hi, hz⟩)
  have ht : fexaT x y w n k l ∈ fexaP x y w n ({l} ∪ {k}) := hkB (hT k l)
  let f : ↥(fexaP x y w n {l}) →+* ↥(fexaP x y w n ({l} ∪ {k})) :=
    (fexaIncl x y w n (Finset.subset_union_left : ({l} : Finset (Fin n)) ⊆ {l} ∪ {k})).hom
  letI : Algebra ↥(fexaP x y w n {l}) ↥(fexaP x y w n ({l} ∪ {k})) := f.toAlgebra
  have hf : ∀ c : ↥(fexaP x y w n {l}),
      ((algebraMap ↥(fexaP x y w n {l}) ↥(fexaP x y w n ({l} ∪ {k})) c :
        ↥(fexaP x y w n ({l} ∪ {k}))) : Localization.Away w) = (c : Localization.Away w) :=
    fun c => rfl
  let s' : ↥(fexaP x y w n {l}) := ⟨fexaT x y w n l k, hT l k⟩
  haveI : IsLocalization.Away s' ↥(fexaP x y w n ({l} ∪ {k})) := by
    apply IsLocalization.Away.mk
    · refine IsUnit.of_mul_eq_one (⟨fexaT x y w n k l, ht⟩ : ↥(fexaP x y w n ({l} ∪ {k}))) ?_
      apply Subtype.ext
      rw [Subalgebra.coe_mul, hf]
      exact hunit
    · intro z
      obtain ⟨N, hN⟩ := hsat (z : Localization.Away w) z.2
      refine ⟨N, ⟨(z : Localization.Away w) * fexaT x y w n l k ^ N, hN⟩, ?_⟩
      apply Subtype.ext
      rw [Subalgebra.coe_mul, Subalgebra.coe_pow, hf, hf]
    · intro a b hab
      refine ⟨0, ?_⟩
      have : a = b := by
        apply Subtype.ext
        rw [← hf a, ← hf b, hab]
      rw [this]
  have hrange := PrimeSpectrum.localization_away_comap_range
    (↥(fexaP x y w n ({l} ∪ {k}))) s'
  have hpmem : p ∈ (PrimeSpectrum.basicOpen s' : Set (PrimeSpectrum ↥(fexaP x y w n {l}))) := hp
  rw [← hrange] at hpmem
  obtain ⟨q, hq⟩ := hpmem
  exact ⟨q, hq⟩

theorem fexgp_openImm_sections {A R : CommRingCat.{u}} {Y : Scheme.{u}} (j : Spec R ⟶ Y)
    [IsOpenImmersion j] (ρ : Y ⟶ Spec A) (φ : A ⟶ R) (h : j ≫ ρ = Spec.map φ) :
    ∃ Θ : Γ(Y, j ''ᵁ ⊤) ≃+* R,
      (∀ a : A, Θ ((ρ.appLE ⊤ (j ''ᵁ ⊤) (by simp)).hom ((Scheme.ΓSpecIso A).inv.hom a)) =
        φ.hom a) ∧
      ∀ (s : R) (z : Y), z ∈ Y.basicOpen (Θ.symm s) →
        ∃ p : Spec R, s ∉ (p : PrimeSpectrum R).asIdeal ∧ j p = z :=
by
  refine ⟨((j.appIso ⊤) ≪≫ Scheme.ΓSpecIso R).commRingCatIsoToRingEquiv, ?_, ?_⟩
  · intro a
    have hΘ : ∀ y, ((j.appIso ⊤) ≪≫ Scheme.ΓSpecIso R).commRingCatIsoToRingEquiv y =
        (Scheme.ΓSpecIso R).hom.hom ((j.appIso ⊤).hom.hom y) := fun y => rfl
    rw [hΘ, Scheme.Hom.appIso_hom']
    have h2 : ∀ (ψ : Spec R ⟶ Spec A) (_ : ψ = Spec.map φ)
        (e : (⊤ : (Spec R).Opens) ≤ ψ ⁻¹ᵁ ⊤), ψ.appLE ⊤ ⊤ e = (Spec.map φ).appTop := by
      rintro ψ rfl e
      show (Spec.map φ).appLE ⊤ ((Spec.map φ) ⁻¹ᵁ ⊤) e = _
      rw [Scheme.Hom.appLE_eq_app]
    have h3 : (Spec.map φ).appTop.hom ((Scheme.ΓSpecIso A).inv.hom a) =
        (Scheme.ΓSpecIso R).inv.hom (φ.hom a) := by
      rw [← CommRingCat.comp_apply, ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply]
    have key2 : ∀ (e1 : (j ''ᵁ ⊤) ≤ ρ ⁻¹ᵁ ⊤) (e2 : (⊤ : (Spec R).Opens) ≤ j ⁻¹ᵁ (j ''ᵁ ⊤)),
        (Scheme.ΓSpecIso R).hom.hom ((j.appLE (j ''ᵁ ⊤) ⊤ e2).hom
          ((ρ.appLE ⊤ (j ''ᵁ ⊤) e1).hom ((Scheme.ΓSpecIso A).inv.hom a))) = φ.hom a := by
      intro e1 e2
      rw [← CommRingCat.comp_apply (ρ.appLE ⊤ (j ''ᵁ ⊤) e1), Scheme.Hom.appLE_comp_appLE,
        h2 _ h, h3, ← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]
    exact key2 _ _
  · intro s z hz
    have hs : ((j.appIso ⊤) ≪≫ Scheme.ΓSpecIso R).commRingCatIsoToRingEquiv.symm s =
        (j.appIso ⊤).inv.hom ((Scheme.ΓSpecIso R).inv.hom s) := rfl
    rw [hs, ← Scheme.image_basicOpen] at hz
    have hz' : z ∈ ((j ''ᵁ (Spec R).basicOpen ((Scheme.ΓSpecIso R).inv.hom s) : Y.Opens) :
        Set Y) := hz
    rw [Scheme.Hom.coe_image] at hz'
    obtain ⟨p, hp, hpz⟩ := hz'
    refine ⟨p, ?_, hpz⟩
    have hp' : p ∈ ((Spec R).basicOpen ((Scheme.ΓSpecIso R).inv.hom s) : Set (Spec R)) := hp
    rw [basicOpen_eq_of_affine] at hp'
    exact (PrimeSpectrum.mem_basicOpen _ _).mp hp'

theorem fexa_glued_proper (A : Type u) [CommRing A] [IsDomain A] (x y w : A) (n : ℕ) (hn : 1 ≤ n)
    (hxy : x * y = w ^ n) (hw : w ≠ 0) (Y : Scheme.{u})
    (ι : ∀ T : Finset (Fin n), T.Nonempty → (Spec (CommRingCat.of ↥(fexaP x y w n T)) ⟶ Y))
    (ρ : Y ⟶ Spec (CommRingCat.of A)) (hG : fexaGlued x y w n Y ι ρ) :
    IsProper ρ :=
by
  classical
  obtain ⟨hG1, hG2, hG3, hG4, hG5⟩ := hG
  haveI : ∀ (T : Finset (Fin n)) (hT : T.Nonempty), IsOpenImmersion (ι T hT) := hG2
  obtain ⟨hTmem, hTG, hTT, hgen⟩ := fexgp_chart_ratios x y w n hxy
  have hpow : Submonoid.powers w ≤ nonZeroDivisors A :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hw
  haveI : IsDomain (Localization.Away w) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away w) hpow
  have hinjA : Function.Injective (algebraMap A (Localization.Away w)) :=
    IsLocalization.injective (Localization.Away w) hpow
  have hx : x ≠ 0 := by
    rintro rfl
    rw [zero_mul] at hxy
    exact pow_ne_zero n hw hxy.symm
  have hG0 : ∀ l : ℕ, fexaG x w n l ≠ 0 := fun l => by
    unfold fexaG
    exact mul_ne_zero (pow_ne_zero _ hx) (pow_ne_zero _ hw)

  have pt : ∀ {A' B' C' : Scheme.{u}} {a : A' ⟶ B'} {b : B' ⟶ C'} {c : A' ⟶ C'}, a ≫ b = c →
      ∀ z, b (a z) = c z := by
    intro A' B' C' a b c h z
    rw [← Scheme.Hom.comp_apply, h]
  have memU : ∀ (T : Finset (Fin n)) (hT : T.Nonempty) (z : Y),
      z ∈ ι T hT ''ᵁ ⊤ ↔ ∃ p, ι T hT p = z := by
    intro T hT z
    show z ∈ ((ι T hT ''ᵁ ⊤ : Y.Opens) : Set Y) ↔ _
    rw [Scheme.Hom.coe_image]
    constructor
    · rintro ⟨p, -, hp⟩; exact ⟨p, hp⟩
    · rintro ⟨p, hp⟩; exact ⟨p, trivial, hp⟩

  have hchart := fun l : Fin n => fexgp_openImm_sections
    (A := CommRingCat.of A) (R := CommRingCat.of ↥(fexaP x y w n {l}))
    (ι {l} (Finset.singleton_nonempty l)) ρ (CommRingCat.ofHom (algebraMap A _))
    (hG5 _ _)
  choose Θ hΘc hΘb using hchart
  set U : Fin n → Y.Opens := fun l => ι {l} (Finset.singleton_nonempty l) ''ᵁ ⊤ with hU
  set g : Fin n → Γ(Spec (CommRingCat.of A), ⊤) :=
    fun j => (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (fexaG x w n j) with hg
  set t : ∀ l : Fin n, Fin n → Γ(Y, U l) :=
    fun l k => (Θ l).symm ⟨fexaT x y w n l k, hTmem l k⟩ with ht
  have hcover : (⨆ l, U l) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    obtain ⟨a, p, hp⟩ := hG3 z
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨a, (memU _ _ z).mpr ⟨p, hp⟩⟩
  have haff : ∀ l, IsAffineOpen (U l) := fun l =>
    IsAffineOpen.image_of_isOpenImmersion (isAffineOpen_top _) _
  have hΘa : ∀ (l : Fin n) (a : A),
      ((Θ l) ((ρ.appLE ⊤ (U l) (by simp)).hom
        ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom a)) : Localization.Away w) =
        algebraMap A (Localization.Away w) a := by
    intro l a
    rw [hΘc l a]
    rfl
  have hΘt : ∀ l k : Fin n, ((Θ l) (t l k) : Localization.Away w) = fexaT x y w n l k := by
    intro l k
    simp only [ht, RingEquiv.apply_symm_apply]
  have hCH : wcBpChartHyp ρ g U t := by
    refine ⟨hcover, haff, ?_, ?_, ?_, ?_⟩
    ·
      intro l j
      apply (Θ l).injective
      apply Subtype.ext
      rw [map_mul, Subalgebra.coe_mul, hΘa, hΘa, hΘt]
      exact hTG l j
    ·
      intro l
      apply mem_nonZeroDivisors_of_injective (f := Θ l) (Θ l).injective
      apply mem_nonZeroDivisors_of_ne_zero
      intro h0
      have h1 := congrArg (fun z : ↥(fexaP x y w n {l}) => (z : Localization.Away w)) h0
      simp only [ZeroMemClass.coe_zero] at h1
      have h2 := hΘa l (fexaG x w n l)
      exact hG0 l (hinjA ((h2.symm.trans h1).trans (map_zero _).symm))
    ·
      intro l s
      let ψ : Γ(Y, U l) →+* Localization.Away w :=
        (Subalgebra.val (fexaP x y w n {l})).toRingHom.comp (Θ l).toRingHom
      have hψ : ∀ s, ψ s = ((Θ l) s : Localization.Away w) := fun s => rfl
      have hψinj : Function.Injective ψ := fun a b hab =>
        (Θ l).injective (Subtype.ext hab)
      have hsub : Set.range (algebraMap A (Localization.Away w)) ∪
          Set.range (fun k : Fin n => fexaT x y w n l k) ⊆
          ψ '' (Set.range (ρ.appLE ⊤ (U l) (by simp)).hom ∪ Set.range (t l)) := by
        rintro _ (⟨a, rfl⟩ | ⟨k, rfl⟩)
        · exact ⟨_, Or.inl ⟨_, rfl⟩, by rw [hψ, hΘa]⟩
        · exact ⟨_, Or.inr ⟨k, rfl⟩, by rw [hψ, hΘt]⟩
      have h1 : ψ s ∈ Subring.map ψ (Subring.closure
          (Set.range (ρ.appLE ⊤ (U l) (by simp)).hom ∪ Set.range (t l))) := by
        rw [RingHom.map_closure]
        exact Subring.closure_mono hsub (hgen l _ ((Θ l) s).2)
      obtain ⟨s', hs', hss'⟩ := Subring.mem_map.mp h1
      rw [← hψinj hss']
      exact hs'
    ·
      intro l k z hz
      obtain ⟨p, hp, hpz⟩ := hΘb l ⟨fexaT x y w n l k, hTmem l k⟩ z hz
      obtain ⟨q, hq⟩ := fexgp_chart_lift x y w n hxy hTmem l k (hTT l k) p hp
      let q' : Spec (CommRingCat.of ↥(fexaP x y w n ({l} ∪ {k}))) := q
      have hq' : Spec.map (fexaIncl x y w n
          (Finset.subset_union_left : ({l} : Finset (Fin n)) ⊆ {l} ∪ {k})) q' = p := hq
      refine (memU _ _ z).mpr ⟨Spec.map (fexaIncl x y w n
          (Finset.subset_union_right : ({k} : Finset (Fin n)) ⊆ {l} ∪ {k})) q', ?_⟩
      rw [pt (hG1 {k} ({l} ∪ {k}) Finset.subset_union_right (Finset.singleton_nonempty k)),
        ← hpz, ← hq',
        pt (hG1 {l} ({l} ∪ {k}) Finset.subset_union_left (Finset.singleton_nonempty l))]
  have hVC : ValuativeCriterion ρ := ValuativeCriterion.iff.mpr
    ⟨wc_bp_charts_val_exist g ρ U t hCH, wc_bp_charts_val_unique g ρ U t hCH⟩

  have hrange : ∀ (T : Finset (Fin n)) (hT : T.Nonempty), IsCompact (Set.range ⇑(ι T hT)) :=
    fun T hT => isCompact_range (ι T hT).continuous
  haveI hqc : QuasiCompact ρ := by
    rw [quasiCompact_iff_compactSpace]
    apply isCompact_univ_iff.mp
    have : (Set.univ : Set Y) = ⋃ a : Fin n, Set.range ⇑(ι {a} (Finset.singleton_nonempty a)) := by
      ext z
      simp only [Set.mem_univ, Set.mem_iUnion, Set.mem_range, true_iff]
      obtain ⟨a, p, hp⟩ := hG3 z
      exact ⟨a, p, hp⟩
    rw [this]
    exact isCompact_iUnion (fun a => hrange _ _)
  haveI hqs : QuasiSeparated ρ := by
    rw [quasiSeparated_iff_quasiSeparatedSpace]
    refine Scheme.quasiSeparatedSpace_of_isOpenCover U (TopologicalSpace.IsOpenCover.mk hcover)
      haff (fun a b => ?_)
    have : (U a : Set Y) ∩ (U b : Set Y) =
        Set.range ⇑(ι ({a} ∪ {b}) ((Finset.singleton_nonempty a).mono Finset.subset_union_left)) := by
      ext z
      constructor
      · rintro ⟨hza, hzb⟩
        obtain ⟨p, hp⟩ := (memU _ _ z).mp hza
        obtain ⟨q, hq⟩ := (memU _ _ z).mp hzb
        obtain ⟨r, hr1, -⟩ := hG4 {a} {b} _ _ p q (hp.trans hq.symm)
        refine ⟨r, ?_⟩
        rw [← pt (hG1 _ _ (Finset.subset_union_left) (Finset.singleton_nonempty a)), hr1, hp]
      · rintro ⟨r, rfl⟩
        refine ⟨(memU _ _ _).mpr ⟨_, pt (hG1 _ _ (Finset.subset_union_left) _) r⟩,
          (memU _ _ _).mpr ⟨_, pt (hG1 _ _ (Finset.subset_union_right) _) r⟩⟩
    rw [this]
    exact hrange _ _
  haveI hlft : LocallyOfFiniteType ρ := by
    refine HasRingHomProperty.of_iSup_eq_top (P := @LocallyOfFiniteType)
      (fun l => (⟨U l, haff l⟩ : Y.affineOpens)) hcover (fun l => ?_)
    have hFT : Algebra.FiniteType A ↥(fexaP x y w n {l}) := by
      unfold fexaP
      exact Algebra.FiniteType.adjoin_of_finite
        (Set.Finite.biUnion (Finset.finite_toSet _) (fun i _ => Set.toFinite _))
    have heq : (ρ.appLE ⊤ (U l) (by simp)).hom = (Θ l).symm.toRingHom.comp
        ((algebraMap A ↥(fexaP x y w n {l})).comp
          (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom) := by
      ext b
      apply (Θ l).injective
      have hb : (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom b) = b := by
        rw [← CommRingCat.comp_apply, Iso.hom_inv_id]
        rfl
      conv_lhs => rw [← hb]
      rw [hΘc l]
      simp
    show (ρ.appLE ⊤ (U l) _).hom.FiniteType
    rw [heq]
    exact RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _ (Θ l).symm.surjective)
      (RingHom.FiniteType.comp (RingHom.finiteType_algebraMap.mpr hFT)
        (RingHom.FiniteType.of_surjective _
          (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of A)).hom).2))
  exact IsProper.of_valuativeCriterion ρ hVC

theorem fexa_glued_fexH1 (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] (x y w : A)
    (n : ℕ) (hn : 1 ≤ n) (hxy : x * y = w ^ n) (hw : w ≠ 0) (Y : Scheme.{u})
    (ι : ∀ T : Finset (Fin n), T.Nonempty → (Spec (CommRingCat.of ↥(fexaP x y w n T)) ⟶ Y))
    (ρ : Y ⟶ Spec (CommRingCat.of A)) (hG : fexaGlued x y w n Y ι ρ) (hρ : IsSeparated ρ) :
    wcpaDjFexH1 Y :=
by
  classical
  have hu : algebraMap A (Localization.Away w) w * Localization.Away.invSelf w = 1 := by
    simp [Localization.Away.invSelf, ← Localization.mk_one_eq_algebraMap, Localization.mk_mul]
  have hxyL : algebraMap A (Localization.Away w) x * algebraMap A (Localization.Away w) y =
      algebraMap A (Localization.Away w) w ^ n := by
    rw [← map_mul, hxy, map_pow]
  have memα : ∀ (T : Finset (Fin n)) (i : Fin n), i ∈ T → fexaAlpha x w i ∈ fexaP x y w n T :=
    fun T i hi => Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨i, hi, Set.mem_insert _ _⟩)
  have memβ : ∀ (T : Finset (Fin n)) (i : Fin n), i ∈ T → fexaBeta y w n i ∈ fexaP x y w n T :=
    fun T i hi => Algebra.subset_adjoin
      (Set.mem_iUnion₂.mpr ⟨i, hi, Set.mem_insert_of_mem _ (Set.mem_singleton _)⟩)
  have memA : ∀ (T : Finset (Fin n)) (r : A),
      algebraMap A (Localization.Away w) r ∈ fexaP x y w n T :=
    fun T r => Subalgebra.algebraMap_mem _ r
  have I2 : ∀ k : ℕ, k + 1 < n → fexaAlpha x w (k + 1) * fexaBeta y w n k = 1 := by
    intro k hk
    unfold fexaAlpha fexaBeta
    have e : (k + 1) + (n - 1 - k) = n := by omega
    calc algebraMap A (Localization.Away w) x * Localization.Away.invSelf w ^ (k + 1) *
          (algebraMap A (Localization.Away w) y * Localization.Away.invSelf w ^ (n - 1 - k))
        = (algebraMap A (Localization.Away w) x * algebraMap A (Localization.Away w) y) *
          Localization.Away.invSelf w ^ ((k + 1) + (n - 1 - k)) := by rw [pow_add]; ring
      _ = (algebraMap A (Localization.Away w) w * Localization.Away.invSelf w) ^ n := by
          rw [hxyL, e, mul_pow]
      _ = 1 := by rw [hu, one_pow]
  have I3 : ∀ j k : ℕ, j ≤ k → k ≤ n - 1 →
      fexaBeta y w n k = algebraMap A (Localization.Away w) (w ^ (k - j)) * fexaBeta y w n j := by
    intro j k hjk hkn
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hjk
    unfold fexaBeta
    rw [show n - 1 - j = (n - 1 - (j + d)) + d by omega, pow_add, Nat.add_sub_cancel_left,
      map_pow]
    rw [show algebraMap A (Localization.Away w) w ^ d * (algebraMap A (Localization.Away w) y *
        (Localization.Away.invSelf w ^ (n - 1 - (j + d)) * Localization.Away.invSelf w ^ d)) =
        algebraMap A (Localization.Away w) y * Localization.Away.invSelf w ^ (n - 1 - (j + d)) *
        (algebraMap A (Localization.Away w) w * Localization.Away.invSelf w) ^ d by ring,
      hu, one_pow, mul_one]
  have I4 : ∀ j k : ℕ, j ≤ k →
      fexaAlpha x w j = algebraMap A (Localization.Away w) (w ^ (k - j)) * fexaAlpha x w k := by
    intro j k hjk
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hjk
    unfold fexaAlpha
    rw [pow_add, Nat.add_sub_cancel_left, map_pow]
    rw [show algebraMap A (Localization.Away w) w ^ d * (algebraMap A (Localization.Away w) x *
        (Localization.Away.invSelf w ^ j * Localization.Away.invSelf w ^ d)) =
        algebraMap A (Localization.Away w) x * Localization.Away.invSelf w ^ j *
        (algebraMap A (Localization.Away w) w * Localization.Away.invSelf w) ^ d by ring,
      hu, one_pow, mul_one]

  have chain : ∀ c : Fin n → Fin n → Localization.Away w,
      (∀ a b : Fin n, c a b ∈ fexaP x y w n ({a} ∪ {b})) →
      (∀ a b d : Fin n, c a d = c b d + c a b) →
      ∃ β : Fin n → Localization.Away w, (∀ a : Fin n, β a ∈ fexaP x y w n {a}) ∧
        ∀ a b : Fin n, c a b = β b - β a := by
    intro c hcm hcc
    have hdec : ∀ k : ℕ, ∃ U V : Localization.Away w,
        (∀ hk : k + 1 < n, c ⟨k, by omega⟩ ⟨k + 1, hk⟩ = U + V) ∧
        (∀ j : Fin n, j.val ≤ k → U ∈ fexaP x y w n {j}) ∧
        (∀ j : Fin n, k + 1 ≤ j.val → V ∈ fexaP x y w n {j}) := by
      intro k
      by_cases hk : k + 1 < n
      · have hab : fexaAlpha x w (k + 1) * fexaBeta y w n k = 1 := I2 k hk
        have hmix : ∀ i j : ℕ, fexaBeta y w n k ^ i * fexaAlpha x w (k + 1) ^ j ∈
            Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i) := by
          intro i j
          rcases le_total j i with h | h
          · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
            refine Set.mem_union_left _ ⟨d, ?_⟩
            show fexaBeta y w n k ^ d = fexaBeta y w n k ^ (j + d) * fexaAlpha x w (k + 1) ^ j
            rw [pow_add, show fexaBeta y w n k ^ j * fexaBeta y w n k ^ d *
              fexaAlpha x w (k + 1) ^ j = fexaBeta y w n k ^ d *
              (fexaAlpha x w (k + 1) * fexaBeta y w n k) ^ j by ring, hab, one_pow, mul_one]
          · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
            refine Set.mem_union_right _ ⟨d, ?_⟩
            show fexaAlpha x w (k + 1) ^ d = fexaBeta y w n k ^ i * fexaAlpha x w (k + 1) ^ (i + d)
            rw [pow_add, show fexaBeta y w n k ^ i * (fexaAlpha x w (k + 1) ^ i *
              fexaAlpha x w (k + 1) ^ d) = fexaAlpha x w (k + 1) ^ d *
              (fexaAlpha x w (k + 1) * fexaBeta y w n k) ^ i by ring, hab, one_pow, mul_one]
        have hSS : ∀ s ∈ Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i),
            ∀ t ∈ Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i),
            s * t ∈ Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i) := by
          rintro s (⟨i, rfl⟩ | ⟨i, rfl⟩) t (⟨j, rfl⟩ | ⟨j, rfl⟩)
          · exact Set.mem_union_left _ ⟨i + j, pow_add _ i j⟩
          · exact hmix i j
          · rw [mul_comm]; exact hmix j i
          · exact Set.mem_union_right _ ⟨i + j, pow_add _ i j⟩
        have hMmul : ∀ s t : Localization.Away w,
            s ∈ Submodule.span A (Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i)) →
            t ∈ Submodule.span A (Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i)) →
            s * t ∈ Submodule.span A (Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i)) := by
          intro s t hs ht
          have h := Submodule.mul_mem_mul hs ht
          rw [Submodule.span_mul_span] at h
          refine Submodule.span_mono (fun z hz => ?_) h
          obtain ⟨p, hp, q, hq, rfl⟩ := Set.mem_mul.mp hz
          exact hSS p hp q hq
        have h1M : (1 : Localization.Away w) ∈ Submodule.span A
            (Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i)) :=
          Submodule.subset_span (Set.mem_union_left _ ⟨0, pow_zero _⟩)
        have hbM : fexaBeta y w n k ∈ Submodule.span A
            (Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i)) :=
          Submodule.subset_span (Set.mem_union_left _ ⟨1, pow_one _⟩)
        have haM : fexaAlpha x w (k + 1) ∈ Submodule.span A
            (Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i)) :=
          Submodule.subset_span (Set.mem_union_right _ ⟨1, pow_one _⟩)
        have hsmul : ∀ (r : A) (z : Localization.Away w), z ∈ Submodule.span A
            (Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i)) →
            algebraMap A (Localization.Away w) r * z ∈ Submodule.span A
            (Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i)) := by
          intro r z hz
          rw [← Algebra.smul_def]
          exact Submodule.smul_mem _ r hz
        have hP : fexaP x y w n ({⟨k, by omega⟩} ∪ {⟨k + 1, hk⟩}) ≤
            (Submodule.span A (Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ∪
              Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i))).toSubalgebra h1M hMmul := by
          apply Algebra.adjoin_le
          intro z hz
          obtain ⟨i, hi, hz⟩ := Set.mem_iUnion₂.mp hz
          rw [SetLike.mem_coe, Submodule.mem_toSubalgebra]
          rw [Finset.mem_union, Finset.mem_singleton, Finset.mem_singleton] at hi
          rcases hi with rfl | rfl <;> rcases hz with rfl | hz
          · show fexaAlpha x w k ∈ _
            rw [I4 k (k + 1) (by omega)]
            exact hsmul _ _ haM
          · rw [Set.mem_singleton_iff] at hz
            subst hz
            exact hbM
          · exact haM
          · rw [Set.mem_singleton_iff] at hz
            subst hz
            show fexaBeta y w n (k + 1) ∈ _
            rw [I3 k (k + 1) (by omega) (by omega)]
            exact hsmul _ _ hbM
        have hcM := hP (hcm ⟨k, by omega⟩ ⟨k + 1, hk⟩)
        rw [Submodule.mem_toSubalgebra, Submodule.span_union, Submodule.mem_sup] at hcM
        obtain ⟨U, hU, V, hV, hUV⟩ := hcM
        refine ⟨U, V, fun _ => hUV.symm, fun j hj => ?_, fun j hj => ?_⟩
        · have hsub : Set.range (fun i : ℕ => fexaBeta y w n k ^ i) ⊆
              ↑(Subalgebra.toSubmodule (fexaP x y w n {j})) := by
            rintro _ ⟨i, rfl⟩
            apply Subalgebra.pow_mem
            rw [I3 j.val k hj (by omega)]
            exact Subalgebra.mul_mem _ (memA _ _) (memβ _ j (Finset.mem_singleton_self j))
          exact Submodule.span_le.mpr hsub hU
        · have hsub : Set.range (fun i : ℕ => fexaAlpha x w (k + 1) ^ i) ⊆
              ↑(Subalgebra.toSubmodule (fexaP x y w n {j})) := by
            rintro _ ⟨i, rfl⟩
            apply Subalgebra.pow_mem
            rw [I4 (k + 1) j.val hj]
            exact Subalgebra.mul_mem _ (memA _ _) (memα _ j (Finset.mem_singleton_self j))
          exact Submodule.span_le.mpr hsub hV
      · exact ⟨0, 0, fun h => absurd h hk, fun j _ => Subalgebra.zero_mem _,
          fun j _ => Subalgebra.zero_mem _⟩
    choose U V hUV hU hV using hdec
    let β : ℕ → Localization.Away w := fun j =>
      (∑ k ∈ Finset.range j, V k) - ∑ k ∈ Finset.Ico j (n - 1), U k
    have hβmem : ∀ a : Fin n, β a ∈ fexaP x y w n {a} := by
      intro a
      refine Subalgebra.sub_mem _ (Subalgebra.sum_mem _ fun k hk => ?_)
        (Subalgebra.sum_mem _ fun k hk => ?_)
      · rw [Finset.mem_range] at hk
        exact hV k a (by omega)
      · rw [Finset.mem_Ico] at hk
        exact hU k a (by omega)
    have hstep : ∀ k (hk : k + 1 < n), c ⟨k, by omega⟩ ⟨k + 1, hk⟩ = β (k + 1) - β k := by
      intro k hk
      rw [hUV k hk]
      simp only [β]
      rw [Finset.sum_range_succ, Finset.sum_eq_sum_Ico_succ_bot (show k < n - 1 by omega)]
      ring
    have hstep' : ∀ i j : Fin n, j.val = i.val + 1 → c i j = β j - β i := by
      intro i j hij
      obtain ⟨i, hi⟩ := i
      obtain ⟨j, hj⟩ := j
      simp only at hij
      subst hij
      exact hstep i hj
    have hc0 : ∀ a, c a a = 0 := by
      intro a
      linear_combination -(hcc a a a)
    have hanti : ∀ a b, c b a = - c a b := by
      intro a b
      linear_combination hc0 a - hcc a b a
    have hup : ∀ m : ℕ, ∀ a b : Fin n, b.val = a.val + m → c a b = β b - β a := by
      intro m
      induction m with
      | zero =>
        intro a b hb
        have hab : b = a := Fin.ext hb
        subst hab
        rw [hc0, sub_self]
      | succ m ih =>
        intro a b hb
        rw [hcc a ⟨a.val + m, by omega⟩ b, hstep' ⟨a.val + m, by omega⟩ b (by simp only; omega),
          ih a ⟨a.val + m, by omega⟩ rfl]
        ring
    refine ⟨fun a => β a, hβmem, fun a b => ?_⟩
    rcases le_total a.val b.val with h | h
    · exact hup (b.val - a.val) a b (by omega)
    · rw [hanti b a, hup (a.val - b.val) b a (by omega)]
      ring

  haveI hOI : ∀ (T : Finset (Fin n)) (hT : T.Nonempty), IsOpenImmersion (ι T hT) := hG.2.1
  have rinter : ∀ (T1 T2 : Finset (Fin n)) (h1 : T1.Nonempty) (h2 : T2.Nonempty),
      Set.range ⇑(ι T1 h1) ∩ Set.range ⇑(ι T2 h2) =
        Set.range ⇑(ι (T1 ∪ T2) (h1.mono Finset.subset_union_left)) := by
    intro T1 T2 h1 h2
    apply Set.Subset.antisymm
    · rintro z ⟨⟨p1, rfl⟩, ⟨p2, hp2⟩⟩
      obtain ⟨p, hp1, -⟩ := hG.2.2.2.1 T1 T2 h1 h2 p1 p2 hp2.symm
      refine ⟨p, ?_⟩
      rw [← hG.1 T1 (T1 ∪ T2) Finset.subset_union_left h1, Scheme.Hom.comp_apply, hp1]
    · rintro z ⟨p, rfl⟩
      refine ⟨⟨Spec.map (fexaIncl x y w n Finset.subset_union_left) p, ?_⟩,
        ⟨Spec.map (fexaIncl x y w n Finset.subset_union_right) p, ?_⟩⟩
      · rw [← Scheme.Hom.comp_apply, hG.1 T1 (T1 ∪ T2) Finset.subset_union_left h1]
      · rw [← Scheme.Hom.comp_apply, hG.1 T2 (T1 ∪ T2) Finset.subset_union_right h2]
  have toE : ∀ (T : Finset (Fin n)) (hT : T.Nonempty) (W : Y.Opens),
      Set.range (ι T hT) ⊆ (W : Set Y) →
        (⊤ : (Spec (CommRingCat.of ↥(fexaP x y w n T))).Opens) ≤ ι T hT ⁻¹ᵁ W :=
    fun T hT W hs p _ => hs ⟨p, rfl⟩
  obtain ⟨θ, hθ⟩ : ∃ θ : ∀ (T : Finset (Fin n)) (hT : T.Nonempty) (W : Y.Opens),
      Set.range (ι T hT) ⊆ (W : Set Y) → Γ(Y, W) → Localization.Away w,
      ∀ T hT W hs s, θ T hT W hs s = ((((ι T hT).appLE W ⊤ (toE T hT W hs) ≫
        (Scheme.ΓSpecIso (CommRingCat.of ↥(fexaP x y w n T))).hom).hom s :
          ↥(fexaP x y w n T)) : Localization.Away w) :=
    ⟨fun T hT W hs s => ((((ι T hT).appLE W ⊤ (toE T hT W hs) ≫
        (Scheme.ΓSpecIso (CommRingCat.of ↥(fexaP x y w n T))).hom).hom s :
          ↥(fexaP x y w n T)) : Localization.Away w), fun _ _ _ _ _ => rfl⟩
  have θmem : ∀ T hT W hs s, θ T hT W hs s ∈ fexaP x y w n T := by
    intro T hT W hs s
    rw [hθ]
    exact SetLike.coe_mem _
  have θadd : ∀ T hT W hs (s t : Γ(Y, W)), θ T hT W hs (s + t) = θ T hT W hs s + θ T hT W hs t := by
    intro T hT W hs s t
    rw [hθ, hθ, hθ, map_add, Subalgebra.coe_add]
  have θsub : ∀ T hT W hs (s t : Γ(Y, W)), θ T hT W hs (s - t) = θ T hT W hs s - θ T hT W hs t := by
    intro T hT W hs s t
    rw [hθ, hθ, hθ, map_sub, Subalgebra.coe_sub]
  have θres : ∀ T hT (W W' : Y.Opens) (hs' : Set.range (ι T hT) ⊆ (W' : Set Y)) (hle : W' ≤ W)
      (s : Γ(Y, W)), θ T hT W' hs' ((Y.presheaf.map (homOfLE hle).op).hom s) =
        θ T hT W (hs'.trans (SetLike.coe_subset_coe.mpr hle)) s := by
    intro T hT W W' hs' hle s
    have hm : Y.presheaf.map (homOfLE hle).op ≫ (ι T hT).appLE W' ⊤ (toE T hT W' hs') =
        (ι T hT).appLE W ⊤ (toE T hT W (hs'.trans (SetLike.coe_subset_coe.mpr hle))) :=
      Scheme.Hom.map_appLE _ _ _
    rw [hθ, hθ, ← hm, CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_comp,
      RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply]
  have appLE_congr : ∀ {X : Scheme.{u}} (f g : X ⟶ Y), f = g → ∀ (W : Y.Opens) (V : X.Opens)
      (e : V ≤ f ⁻¹ᵁ W) (e' : V ≤ g ⁻¹ᵁ W), f.appLE W V e = g.appLE W V e' := by
    intro X f g hfg W V e e'
    subst hfg
    rfl
  have happ : ∀ {R S : CommRingCat.{u}} (g : R ⟶ S) (e : (⊤ : (Spec S).Opens) ≤ (Spec.map g) ⁻¹ᵁ ⊤),
      (Spec.map g).appLE ⊤ ⊤ e = (Spec.map g).appTop := by
    intro R S g e
    show (Spec.map g).appLE ⊤ ((Spec.map g) ⁻¹ᵁ ⊤) e = _
    exact Scheme.Hom.appLE_eq_app _
  have θmono : ∀ (T T' : Finset (Fin n)) (hT : T.Nonempty) (hT' : T'.Nonempty) (h : T ⊆ T')
      (W : Y.Opens) (hs : Set.range (ι T hT) ⊆ (W : Set Y))
      (hs' : Set.range (ι T' hT') ⊆ (W : Set Y)) (s : Γ(Y, W)),
      θ T' hT' W hs' s = θ T hT W hs s := by
    intro T T' hT hT' h W hs hs' s
    have hg : Spec.map (fexaIncl x y w n h) ≫ ι T hT = ι T' hT' := hG.1 T T' h hT
    have hm : (ι T' hT').appLE W ⊤ (toE T' hT' W hs') ≫
          (Scheme.ΓSpecIso (CommRingCat.of ↥(fexaP x y w n T'))).hom =
        (ι T hT).appLE W ⊤ (toE T hT W hs) ≫
          (Scheme.ΓSpecIso (CommRingCat.of ↥(fexaP x y w n T))).hom ≫ fexaIncl x y w n h := by
      rw [appLE_congr _ _ hg.symm W ⊤ (toE T' hT' W hs') (by rw [hg]; exact toE T' hT' W hs'),
        ← Scheme.Hom.appLE_comp_appLE (Spec.map (fexaIncl x y w n h)) (ι T hT) W ⊤ ⊤
          (toE T hT W hs) (fun _ _ => trivial), Category.assoc]
      congr 1
      exact (congrArg (fun f => f ≫ (Scheme.ΓSpecIso (CommRingCat.of ↥(fexaP x y w n T'))).hom)
        (happ (fexaIncl x y w n h) _)).trans (Scheme.ΓSpecIso_naturality (fexaIncl x y w n h))
    rw [hθ, hθ, hm, ← Category.assoc, CommRingCat.hom_comp, RingHom.comp_apply]
    generalize (CommRingCat.Hom.hom ((ι T hT).appLE W ⊤ (toE T hT W hs) ≫
      (Scheme.ΓSpecIso (CommRingCat.of ↥(fexaP x y w n T))).hom)) s = z
    exact Subalgebra.coe_inclusion _ z
  have θbij : ∀ T hT (W : Y.Opens) (hs : Set.range (ι T hT) ⊆ (W : Set Y)),
      (W : Set Y) = Set.range (ι T hT) →
      Function.Bijective ((((ι T hT).appLE W ⊤ (toE T hT W hs) ≫
        (Scheme.ΓSpecIso (CommRingCat.of ↥(fexaP x y w n T))).hom).hom)) := by
    intro T hT W hs hW
    have hW' : W = (ι T hT) ''ᵁ ⊤ := by
      rw [Scheme.Hom.image_top_eq_opensRange]
      ext1
      rw [hW, Scheme.Hom.coe_opensRange]
    subst hW'
    rw [← Scheme.Hom.appIso_hom']
    exact ConcreteCategory.bijective_of_isIso _
  have θinj : ∀ T hT (W : Y.Opens) hs, (W : Set Y) = Set.range (ι T hT) →
      Function.Injective (θ T hT W hs) := by
    intro T hT W hs hW s t hst
    rw [hθ, hθ] at hst
    exact (θbij T hT W hs hW).1 (Subtype.val_injective hst)
  have θsurj : ∀ T hT (W : Y.Opens) hs, (W : Set Y) = Set.range (ι T hT) →
      ∀ p ∈ fexaP x y w n T, ∃ s, θ T hT W hs s = p := by
    intro T hT W hs hW p hp
    obtain ⟨s, hs'⟩ := (θbij T hT W hs hW).2 (⟨p, hp⟩ : ↥(fexaP x y w n T))
    exact ⟨s, by rw [hθ, hs']⟩

  obtain ⟨U, hU⟩ : ∃ U : Fin n → Y.Opens,
      ∀ a, U a = (ι {a} (Finset.singleton_nonempty a)).opensRange := ⟨_, fun _ => rfl⟩
  have hUc : ∀ a, (U a : Set Y) = Set.range (ι {a} (Finset.singleton_nonempty a)) := by
    intro a; rw [hU, Scheme.Hom.coe_opensRange]
  have ne2 : ∀ a b : Fin n, ({a} ∪ {b} : Finset (Fin n)).Nonempty :=
    fun a b => (Finset.singleton_nonempty a).mono Finset.subset_union_left
  have ne3 : ∀ a b d : Fin n, ({a} ∪ {b} ∪ {d} : Finset (Fin n)).Nonempty :=
    fun a b d => (ne2 a b).mono Finset.subset_union_left
  have R1 : ∀ a : Fin n, ((U a ⊓ ⊤ : Y.Opens) : Set Y) = Set.range (ι {a} (Finset.singleton_nonempty a)) := by
    intro a
    rw [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_top, Set.inter_univ, hUc]
  have R2 : ∀ a b : Fin n, ((U a ⊓ U b ⊓ ⊤ : Y.Opens) : Set Y) =
      Set.range (ι ({a} ∪ {b}) (ne2 a b)) := by
    intro a b
    rw [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_top, Set.inter_univ,
      TopologicalSpace.Opens.coe_inf, hUc, hUc, rinter]
  have R3 : ∀ a b d : Fin n, ((U a ⊓ U b ⊓ U d ⊓ ⊤ : Y.Opens) : Set Y) =
      Set.range (ι ({a} ∪ {b} ∪ {d}) (ne3 a b d)) := by
    intro a b d
    rw [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_top, Set.inter_univ,
      TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_inf, hUc, hUc, hUc, rinter,
      rinter]
  have key : ∀ c0 : ∀ a b : Fin n, Γ(Y, U a ⊓ U b ⊓ ⊤),
      (∀ a b d,
        (Y.presheaf.map (homOfLE (show U a ⊓ U b ⊓ U d ⊓ ⊤ ≤ U a ⊓ U d ⊓ ⊤ from
          inf_le_inf_right ⊤ (inf_le_inf_right (U d) inf_le_left))).op).hom (c0 a d) =
        (Y.presheaf.map (homOfLE (show U a ⊓ U b ⊓ U d ⊓ ⊤ ≤ U b ⊓ U d ⊓ ⊤ from
          inf_le_inf_right ⊤ (inf_le_inf_right (U d) inf_le_right))).op).hom (c0 b d) +
        (Y.presheaf.map (homOfLE (show U a ⊓ U b ⊓ U d ⊓ ⊤ ≤ U a ⊓ U b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c0 a b)) →
      ∃ β0 : ∀ a : Fin n, Γ(Y, U a ⊓ ⊤), ∀ a b,
        c0 a b = (Y.presheaf.map (homOfLE (show U a ⊓ U b ⊓ ⊤ ≤ U b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β0 b) -
        (Y.presheaf.map (homOfLE (show U a ⊓ U b ⊓ ⊤ ≤ U a ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β0 a) := by
    intro c0 hc0
    obtain ⟨c', hc'⟩ : ∃ c' : Fin n → Fin n → Localization.Away w, ∀ a b,
        c' a b = θ ({a} ∪ {b}) (ne2 a b) (U a ⊓ U b ⊓ ⊤) (R2 a b).ge (c0 a b) :=
      ⟨_, fun _ _ => rfl⟩
    have hcoc : ∀ a b d, c' a d = c' b d + c' a b := by
      intro a b d
      have h := congrArg (θ ({a} ∪ {b} ∪ {d}) (ne3 a b d) (U a ⊓ U b ⊓ U d ⊓ ⊤) (R3 a b d).ge)
        (hc0 a b d)
      replace h := h.trans (θadd _ _ _ _ _ _)
      rw [θres, θres, θres,
        θmono ({a} ∪ {d}) ({a} ∪ {b} ∪ {d}) (ne2 a d) (ne3 a b d)
          (by intro z hz; simp only [Finset.mem_union, Finset.mem_singleton] at hz ⊢; tauto)
          _ (R2 a d).ge,
        θmono ({b} ∪ {d}) ({a} ∪ {b} ∪ {d}) (ne2 b d) (ne3 a b d)
          (by intro z hz; simp only [Finset.mem_union, Finset.mem_singleton] at hz ⊢; tauto)
          _ (R2 b d).ge,
        θmono ({a} ∪ {b}) ({a} ∪ {b} ∪ {d}) (ne2 a b) (ne3 a b d)
          (by intro z hz; simp only [Finset.mem_union, Finset.mem_singleton] at hz ⊢; tauto)
          _ (R2 a b).ge] at h
      rw [hc', hc', hc']
      exact h
    obtain ⟨β', hβ'mem, hβ'⟩ := chain c' (fun a b => by rw [hc']; exact θmem _ _ _ _ _) hcoc
    have hlift : ∀ a : Fin n, ∃ s : Γ(Y, U a ⊓ ⊤),
        θ {a} (Finset.singleton_nonempty a) (U a ⊓ ⊤) (R1 a).ge s = β' a :=
      fun a => θsurj {a} (Finset.singleton_nonempty a) (U a ⊓ ⊤) (R1 a).ge (R1 a) (β' a) (hβ'mem a)
    choose s hs using hlift
    refine ⟨s, fun a b => ?_⟩
    apply θinj ({a} ∪ {b}) (ne2 a b) (U a ⊓ U b ⊓ ⊤) (R2 a b).ge (R2 a b)
    refine (?_ : _ = _).trans (θsub _ _ _ _ _ _).symm
    rw [θres, θres,
      θmono {b} ({a} ∪ {b}) (Finset.singleton_nonempty b) (ne2 a b) Finset.subset_union_right _
        (R1 b).ge,
      θmono {a} ({a} ∪ {b}) (Finset.singleton_nonempty a) (ne2 a b) Finset.subset_union_left _
        (R1 a).ge,
      hs b, hs a, ← hβ' a b, hc']
  have hTw : wcpaDjTwH1 (⟨n, U, fun _ _ => 1⟩ : wcpaDjCoc Y) ⊤ (wcStructMod Y) 0 := by
    unfold wcpaDjTwH1
    intro c hc
    simp only [pow_zero, one_smul] at hc ⊢
    exact key c hc

  have hcovU : (⨆ a, U a) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    obtain ⟨a, p, hp⟩ := hG.2.2.1 z
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨a, ?_⟩
    rw [← SetLike.mem_coe, hUc]
    exact ⟨p, hp⟩
  haveI : CompactSpace Y := by
    refine ⟨?_⟩
    have huniv : (Set.univ : Set Y) = ⋃ a : Fin n, Set.range (ι {a} (Finset.singleton_nonempty a)) := by
      ext z
      simp only [Set.mem_univ, Set.mem_iUnion, true_iff]
      obtain ⟨a, p, hp⟩ := hG.2.2.1 z
      exact ⟨a, p, hp⟩
    rw [huniv]
    exact isCompact_iUnion fun a => isCompact_range (Scheme.Hom.continuous _)
  haveI : IsLocallyNoetherian Y := by
    refine isLocallyNoetherian_of_affine_cover
      (S := fun a : Fin n => ⟨U a, by rw [hU]; exact isAffineOpen_opensRange _⟩) hcovU ?_
    intro a
    show IsNoetherianRing Γ(Y, U a)
    rw [hU, ← Scheme.Hom.image_top_eq_opensRange]
    haveI : Algebra.FiniteType A ↥(fexaP x y w n {a}) := by
      unfold fexaP
      exact Algebra.FiniteType.adjoin_of_finite
        (Set.Finite.biUnion (Finset.finite_toSet _) fun i _ => Set.toFinite _)
    haveI : IsNoetherianRing ↥(fexaP x y w n {a}) := Algebra.FiniteType.isNoetherianRing A _
    exact isNoetherianRing_of_ringEquiv (CommRingCat.of ↥(fexaP x y w n {a}))
      ((Scheme.Hom.appIso (ι {a} (Finset.singleton_nonempty a)) ⊤) ≪≫
        Scheme.ΓSpecIso (CommRingCat.of ↥(fexaP x y w n {a}))).symm.commRingCatIsoToRingEquiv
  haveI : IsNoetherian Y := ⟨⟩
  haveI := hρ
  haveI : IsSeparated (Limits.terminal.from Y) := by
    rw [Subsingleton.elim (Limits.terminal.from Y) (ρ ≫ Limits.terminal.from _)]
    infer_instance
  have hYaff : ∀ U V : Y.Opens, IsAffineOpen U → IsAffineOpen V → IsAffineOpen (U ⊓ V) :=
    fun U V hU hV => hU.inf hV
  have hP1 : wcpaLccP1 (𝟙 Y) := by
    intro V
    rw [Scheme.Hom.id_app]
    exact Function.bijective_id
  exact fexr_leray Y Y (𝟙 Y) hYaff hP1 n U hcovU
    (fun a => fexr_affine_h1 _ (by
      show IsAffineOpen (U a)
      rw [hU]; exact isAffineOpen_opensRange _)) hTw

theorem fexa_glued_stalks (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] (x y w : A)
    (n : ℕ) (hn : 1 ≤ n) (hxy : x * y = w ^ n) (hw : w ≠ 0) (hdim : ringKrullDim A = 2)
    (hreg : ∀ (q : Ideal A) [q.IsPrime], w ∉ q → IsRegularLocalRing (Localization.AtPrime q))
    (hpid : ∀ i : Fin n,
      IsDomain (↥(fexaP x y w n {i}) ⧸ Ideal.span {fexaAlphaP x y w n i}) ∧
      IsPrincipalIdealRing (↥(fexaP x y w n {i}) ⧸ Ideal.span {fexaAlphaP x y w n i}) ∧
      IsDomain (↥(fexaP x y w n {i}) ⧸ Ideal.span {fexaBetaP x y w n i}) ∧
      IsPrincipalIdealRing (↥(fexaP x y w n {i}) ⧸ Ideal.span {fexaBetaP x y w n i}))
    (Y : Scheme.{u})
    (ι : ∀ T : Finset (Fin n), T.Nonempty → (Spec (CommRingCat.of ↥(fexaP x y w n T)) ⟶ Y))
    (ρ : Y ⟶ Spec (CommRingCat.of A)) (hG : fexaGlued x y w n Y ι ρ) :
    AlgebraicGeometry.IsIntegral Y ∧
      ∀ z : Y, IsNoetherianRing (Y.presheaf.stalk z) ∧ IsRegularLocalRing (Y.presheaf.stalk z) ∧
        IsIntegrallyClosed (Y.presheaf.stalk z) ∧ ringKrullDim (Y.presheaf.stalk z) ≤ 2 :=
by

  have s1 : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsPrincipalIdealRing D] (q : Ideal D)
      [q.IsPrime], IsRegularLocalRing (Localization.AtPrime q) ∧
        (ringKrullDim (Localization.AtPrime q) = 0 ∨ ringKrullDim (Localization.AtPrime q) = 1) := by
    intro D _ _ _ q hq
    haveI : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl _ inferInstance
    haveI : IsDomain (Localization.AtPrime q) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors q)
    by_cases h0 : q = ⊥
    · subst h0
      have hm : IsLocalRing.maximalIdeal (Localization.AtPrime (⊥ : Ideal D)) = ⊥ := by
        rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_bot]
      have hdim : ringKrullDim (Localization.AtPrime (⊥ : Ideal D)) = 0 :=
        ringKrullDim_eq_zero_of_isField (IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm)
      refine ⟨IsRegularLocalRing.mk ?_, Or.inl hdim⟩
      rw [hdim, hm, Submodule.spanFinrank_bot]
      rfl
    · haveI : IsDedekindDomain D := IsPrincipalIdealRing.isDedekindDomain D
      haveI : IsDiscreteValuationRing (Localization.AtPrime q) :=
        IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain D h0 _
      have hdim := IsDiscreteValuationRing.ringKrullDim_eq_one (Localization.AtPrime q)
      obtain ⟨g, hg⟩ := (IsPrincipalIdealRing.principal
        (IsLocalRing.maximalIdeal (Localization.AtPrime q)))
      have hle : (IsLocalRing.maximalIdeal (Localization.AtPrime q)).spanFinrank ≤ 1 := by
        rw [hg]
        have := Submodule.spanFinrank_span_le_ncard_of_finite (R := Localization.AtPrime q)
          (Set.finite_singleton g)
        rwa [Set.ncard_singleton] at this
      have hne : (IsLocalRing.maximalIdeal (Localization.AtPrime q)).spanFinrank ≠ 0 := by
        rw [Ne, Submodule.spanFinrank_eq_zero_iff_eq_bot (IsNoetherian.noetherian _)]
        exact IsDiscreteValuationRing.not_a_field _
      have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime q)).spanFinrank = 1 := by omega
      refine ⟨IsRegularLocalRing.mk ?_, Or.inr hdim⟩
      rw [hdim, h1]
      rfl

  have s2 : ∀ (P : Type u) [CommRing P] (a : P) (Q : Ideal P) [Q.IsPrime]
      (Qb : Ideal (P ⧸ Ideal.span {a})) [Qb.IsPrime],
      Qb.comap (Ideal.Quotient.mk (Ideal.span {a})) = Q →
      Nonempty ((Localization.AtPrime Q ⧸ Ideal.span {algebraMap P (Localization.AtPrime Q) a}) ≃+*
        Localization.AtPrime Qb) := by
    intro P _ a Q hQ Qb hQb hcomap
    set a' := algebraMap P (Localization.AtPrime Q) a with ha'
    have hle : Ideal.span {a} ≤
        (Ideal.span {a'}).comap (algebraMap P (Localization.AtPrime Q)) := by
      rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
      exact Ideal.subset_span rfl
    letI : Algebra (P ⧸ Ideal.span {a}) (Localization.AtPrime Q ⧸ Ideal.span {a'}) :=
      (Ideal.quotientMap (Ideal.span {a'}) (algebraMap P (Localization.AtPrime Q)) hle).toAlgebra
    have hcomm : (Ideal.Quotient.mk (Ideal.span {a'})).comp (algebraMap P (Localization.AtPrime Q)) =
        (algebraMap (P ⧸ Ideal.span {a}) (Localization.AtPrime Q ⧸ Ideal.span {a'})).comp
          (Ideal.Quotient.mk (Ideal.span {a})) := RingHom.ext fun p => rfl
    have hker : RingHom.ker (Ideal.Quotient.mk (Ideal.span {a'})) ≤
        Ideal.map (algebraMap P (Localization.AtPrime Q))
          (RingHom.ker (Ideal.Quotient.mk (Ideal.span {a}))) := by
      rw [Ideal.mk_ker, Ideal.mk_ker, Ideal.map_span, Set.image_singleton]
    have hL := IsLocalization.of_surjective Q.primeCompl (Localization.AtPrime Q)
      (Ideal.Quotient.mk (Ideal.span {a})) Ideal.Quotient.mk_surjective
      (Ideal.Quotient.mk (Ideal.span {a'})) Ideal.Quotient.mk_surjective hcomm hker
    have hM : Submonoid.map (Ideal.Quotient.mk (Ideal.span {a})) Q.primeCompl = Qb.primeCompl := by
      ext t
      constructor
      · rintro ⟨s, hs, rfl⟩ h
        apply hs
        rw [← hcomap]
        exact h
      · intro ht
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective t
        refine ⟨s, fun hs => ht ?_, rfl⟩
        rw [← hcomap] at hs
        exact hs
    have hL' : IsLocalization Qb.primeCompl (Localization.AtPrime Q ⧸ Ideal.span {a'}) := hM ▸ hL
    exact ⟨(IsLocalization.algEquiv Qb.primeCompl (Localization.AtPrime Q ⧸ Ideal.span {a'})
      (Localization.AtPrime Qb)).toRingEquiv⟩

  have s3 : ∀ (P : Type u) [CommRing P] [IsDomain P] [IsNoetherianRing P] (a : P), a ≠ 0 →
      IsDomain (P ⧸ Ideal.span {a}) → IsPrincipalIdealRing (P ⧸ Ideal.span {a}) →
      ∀ (Q : Ideal P) [Q.IsPrime], a ∈ Q →
      IsRegularLocalRing (Localization.AtPrime Q) ∧ ringKrullDim (Localization.AtPrime Q) ≤ 2 := by
    intro P _ _ _ a ha0 hdomq hpidq Q hQ haQ
    haveI : IsNoetherianRing (Localization.AtPrime Q) :=
      IsLocalization.isNoetherianRing Q.primeCompl _ inferInstance
    haveI : IsDomain (Localization.AtPrime Q) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors Q)
    have hinj : Function.Injective (algebraMap P (Localization.AtPrime Q)) :=
      IsLocalization.injective (Localization.AtPrime Q) (Ideal.primeCompl_le_nonZeroDivisors Q)
    have ham : algebraMap P (Localization.AtPrime Q) a ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q a).mpr haQ
    have hanzd : algebraMap P (Localization.AtPrime Q) a ∈ nonZeroDivisors (Localization.AtPrime Q) :=
      mem_nonZeroDivisors_of_ne_zero (fun h => ha0 (hinj (h.trans (map_zero _).symm)))
    have hspan : Ideal.span {a} ≤ Q := (Ideal.span_singleton_le_iff_mem Q).mpr haQ
    have hkerQ : RingHom.ker (Ideal.Quotient.mk (Ideal.span {a})) ≤ Q := by
      rw [Ideal.mk_ker]; exact hspan
    haveI hQb : (Q.map (Ideal.Quotient.mk (Ideal.span {a}))).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hkerQ
    have hcomap : (Q.map (Ideal.Quotient.mk (Ideal.span {a}))).comap
        (Ideal.Quotient.mk (Ideal.span {a})) = Q := by
      rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective, ← RingHom.ker_eq_comap_bot,
        Ideal.mk_ker]
      exact sup_eq_left.mpr hspan
    obtain ⟨e⟩ := s2 P a Q (Q.map (Ideal.Quotient.mk (Ideal.span {a}))) hcomap
    haveI := hdomq
    haveI := hpidq
    obtain ⟨hr, hd⟩ := s1 (P ⧸ Ideal.span {a}) (Q.map (Ideal.Quotient.mk (Ideal.span {a})))
    haveI := hr
    haveI hrq : IsRegularLocalRing (Localization.AtPrime Q ⧸
        Ideal.span {algebraMap P (Localization.AtPrime Q) a}) :=
      IsRegularLocalRing.of_ringEquiv
        (R := Localization.AtPrime (Q.map (Ideal.Quotient.mk (Ideal.span {a})))) e.symm
    have hdq := ringKrullDim_eq_of_ringEquiv e
    rcases hd with hd | hd
    · have hd' : ringKrullDim (Localization.AtPrime Q ⧸
          Ideal.span {algebraMap P (Localization.AtPrime Q) a}) = ((0 : ℕ) : WithBot ℕ∞) := by
        rw [hdq, hd]; rfl
      obtain ⟨hR, hD⟩ := wc_odp_regular_lift_nzd (Localization.AtPrime Q)
        (algebraMap P (Localization.AtPrime Q) a) 0 ham hanzd hrq hd'
      refine ⟨hR, ?_⟩
      rw [hD]
      exact_mod_cast (show (0 + 1 : ℕ) ≤ 2 by norm_num)
    · have hd' : ringKrullDim (Localization.AtPrime Q ⧸
          Ideal.span {algebraMap P (Localization.AtPrime Q) a}) = ((1 : ℕ) : WithBot ℕ∞) := by
        rw [hdq, hd]; rfl
      obtain ⟨hR, hD⟩ := wc_odp_regular_lift_nzd (Localization.AtPrime Q)
        (algebraMap P (Localization.AtPrime Q) a) 1 ham hanzd hrq hd'
      refine ⟨hR, ?_⟩
      rw [hD]
      exact_mod_cast (show (1 + 1 : ℕ) ≤ 2 by norm_num)

  have s4 : ∀ (P : Subalgebra A (Localization.Away w)) (Q : Ideal ↥P) [Q.IsPrime],
      algebraMap A ↥P w ∉ Q →
      Nonempty (Localization.AtPrime Q ≃+* Localization.AtPrime (Q.comap (algebraMap A ↥P))) := by
    intro P Q hQ hwQ
    have hpow : Submonoid.powers w ≤ nonZeroDivisors A :=
      powers_le_nonZeroDivisors_of_noZeroDivisors hw
    haveI hLdom : IsDomain (Localization.Away w) := IsLocalization.isDomain_localization hpow
    have hinj : Function.Injective (algebraMap A (Localization.Away w)) :=
      IsLocalization.injective (Localization.Away w) hpow
    haveI : IsDomain ↥P := inferInstance
    set q := Q.comap (algebraMap A ↥P) with hq
    have hpowQ : ∀ s ∈ Submonoid.powers w, algebraMap A ↥P s ∉ Q := by
      rintro s ⟨N, rfl⟩
      rw [map_pow]
      exact fun h => hwQ (hQ.mem_of_pow_mem N h)
    have hrep : ∀ p : ↥P, ∃ (a₁ s : A), s ∈ Submonoid.powers w ∧
        p * algebraMap A ↥P s = algebraMap A ↥P a₁ := by
      intro p
      obtain ⟨⟨a₁, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers w) (p : Localization.Away w)
      exact ⟨a₁, s, s.2, Subtype.ext hs⟩
    have hloc : IsLocalization q.primeCompl (Localization.AtPrime Q) := by
      refine ⟨?_, ?_, ?_⟩
      · intro y
        rw [IsScalarTower.algebraMap_apply A ↥P (Localization.AtPrime Q)]
        exact IsLocalization.map_units (Localization.AtPrime Q)
          (⟨algebraMap A ↥P y, y.2⟩ : Q.primeCompl)
      · intro z
        obtain ⟨⟨p, t⟩, hz⟩ := IsLocalization.surj Q.primeCompl z
        obtain ⟨a₁, s₁, hs₁, ha⟩ := hrep p
        obtain ⟨c, s₂, hs₂, hc⟩ := hrep t
        have hcq : algebraMap A ↥P c ∉ Q := by
          rw [← hc]
          intro h
          rcases hQ.mem_or_mem h with h | h
          · exact t.2 h
          · exact hpowQ s₂ hs₂ h
        have hden : c * s₁ ∈ q.primeCompl := by
          show algebraMap A ↥P (c * s₁) ∉ Q
          rw [map_mul]
          intro h
          rcases hQ.mem_or_mem h with h | h
          · exact hcq h
          · exact hpowQ s₁ hs₁ h
        refine ⟨⟨a₁ * s₂, ⟨c * s₁, hden⟩⟩, ?_⟩
        set g := algebraMap ↥P (Localization.AtPrime Q) with hg
        have hz' : z * g t = g p := hz
        have key : z * (g (algebraMap A ↥P c) * g (algebraMap A ↥P s₁)) =
            g (algebraMap A ↥P a₁) * g (algebraMap A ↥P s₂) := by
          rw [← ha, ← hc, map_mul, map_mul]
          calc z * (g ↑t * g (algebraMap A ↥P s₂) * g (algebraMap A ↥P s₁))
              = (z * g ↑t) * (g (algebraMap A ↥P s₂) * g (algebraMap A ↥P s₁)) := by ring
            _ = g p * (g (algebraMap A ↥P s₂) * g (algebraMap A ↥P s₁)) := by rw [hz']
            _ = g p * g (algebraMap A ↥P s₁) * g (algebraMap A ↥P s₂) := by ring
        show z * algebraMap A (Localization.AtPrime Q) (c * s₁) =
          algebraMap A (Localization.AtPrime Q) (a₁ * s₂)
        rw [IsScalarTower.algebraMap_apply A ↥P (Localization.AtPrime Q),
          IsScalarTower.algebraMap_apply A ↥P (Localization.AtPrime Q), map_mul, map_mul,
          map_mul, map_mul]
        exact key
      · intro a b hab
        rw [IsScalarTower.algebraMap_apply A ↥P (Localization.AtPrime Q),
          IsScalarTower.algebraMap_apply A ↥P (Localization.AtPrime Q)] at hab
        obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := Q.primeCompl) hab
        have hc0 : (c : ↥P) ≠ 0 := fun h => c.2 (h ▸ Q.zero_mem)
        have h1 : algebraMap A ↥P a = algebraMap A ↥P b := mul_left_cancel₀ hc0 hc
        have h2 : a = b := hinj (congrArg Subtype.val h1)
        exact ⟨1, by rw [h2]⟩
    exact ⟨(IsLocalization.algEquiv q.primeCompl (Localization.AtPrime Q)
      (Localization.AtPrime q)).toRingEquiv⟩

  have s6 : (∀ T : Finset (Fin n), IsDomain ↥(fexaP x y w n T) ∧
      IsNoetherianRing ↥(fexaP x y w n T)) ∧ ∀ i : Fin n,
      fexaAlphaP x y w n i * fexaBetaP x y w n i = algebraMap A ↥(fexaP x y w n {i}) w ∧
      fexaAlphaP x y w n i ≠ 0 ∧ fexaBetaP x y w n i ≠ 0 := by
    have hpow : Submonoid.powers w ≤ nonZeroDivisors A :=
      powers_le_nonZeroDivisors_of_noZeroDivisors hw
    haveI hLdom : IsDomain (Localization.Away w) := IsLocalization.isDomain_localization hpow
    have hinj : Function.Injective (algebraMap A (Localization.Away w)) :=
      IsLocalization.injective (Localization.Away w) hpow
    have hu : algebraMap A (Localization.Away w) w * Localization.Away.invSelf w = 1 := by
      rw [Localization.Away.invSelf, Localization.mk_eq_mk']
      exact IsLocalization.Away.mul_invSelf w
    refine ⟨fun T => ⟨inferInstance, ?_⟩, fun i => ?_⟩
    · have hfin : (⋃ i ∈ T, ({fexaAlpha x w i, fexaBeta y w n i} :
          Set (Localization.Away w))).Finite :=
        Set.Finite.biUnion (Finset.finite_toSet T) (fun i _ => Set.toFinite _)
      haveI : Algebra.FiniteType A ↥(fexaP x y w n T) := Algebra.FiniteType.adjoin_of_finite hfin
      exact Algebra.FiniteType.isNoetherianRing A _
    · have hik : (i : ℕ) + (n - 1 - i) = n - 1 := by have := i.2; omega
      have hn1 : n = (n - 1) + 1 := by have := i.2; omega
      have hprod : fexaAlphaP x y w n i * fexaBetaP x y w n i =
          algebraMap A ↥(fexaP x y w n {i}) w := by
        apply Subtype.ext
        show fexaAlpha x w i * fexaBeta y w n i = algebraMap A (Localization.Away w) w
        unfold fexaAlpha fexaBeta
        calc algebraMap A (Localization.Away w) x * Localization.Away.invSelf w ^ (i : ℕ) *
              (algebraMap A (Localization.Away w) y * Localization.Away.invSelf w ^ (n - 1 - i))
            = algebraMap A (Localization.Away w) (x * y) *
                Localization.Away.invSelf w ^ ((i : ℕ) + (n - 1 - i)) := by
              rw [map_mul, pow_add]; ring
          _ = algebraMap A (Localization.Away w) (w ^ ((n - 1) + 1)) *
                Localization.Away.invSelf w ^ (n - 1) := by
              rw [hxy, hik, ← hn1]
          _ = algebraMap A (Localization.Away w) w *
                (algebraMap A (Localization.Away w) w * Localization.Away.invSelf w) ^ (n - 1) := by
              rw [map_pow, mul_pow]; ring
          _ = algebraMap A (Localization.Away w) w := by rw [hu, one_pow, mul_one]
      have hw' : algebraMap A ↥(fexaP x y w n {i}) w ≠ 0 := by
        intro h
        apply hw
        apply hinj
        rw [map_zero]
        exact congrArg Subtype.val h
      refine ⟨hprod, fun h => hw' ?_, fun h => hw' ?_⟩
      · rw [← hprod, h, zero_mul]
      · rw [← hprod, h, mul_zero]
  obtain ⟨hPT, hab⟩ := s6

  have loc : ∀ (a : Fin n) (Q : Ideal ↥(fexaP x y w n {a})) [Q.IsPrime],
      IsRegularLocalRing (Localization.AtPrime Q) ∧ ringKrullDim (Localization.AtPrime Q) ≤ 2 := by
    intro a Q hQ
    haveI := (hPT {a}).1
    haveI := (hPT {a}).2
    obtain ⟨hprod, hα0, hβ0⟩ := hab a
    obtain ⟨hd1, hp1, hd2, hp2⟩ := hpid a
    by_cases hα : fexaAlphaP x y w n a ∈ Q
    · exact s3 _ _ hα0 hd1 hp1 Q hα
    by_cases hβ : fexaBetaP x y w n a ∈ Q
    · exact s3 _ _ hβ0 hd2 hp2 Q hβ
    have hwQ : algebraMap A ↥(fexaP x y w n {a}) w ∉ Q := by
      rw [← hprod]
      intro h
      rcases hQ.mem_or_mem h with h | h
      · exact hα h
      · exact hβ h
    obtain ⟨e⟩ := s4 (fexaP x y w n {a}) Q hwQ
    have hwq : w ∉ Q.comap (algebraMap A ↥(fexaP x y w n {a})) := hwQ
    haveI := hreg (Q.comap (algebraMap A ↥(fexaP x y w n {a}))) hwq
    refine ⟨IsRegularLocalRing.of_ringEquiv
      (R := Localization.AtPrime (Q.comap (algebraMap A ↥(fexaP x y w n {a})))) e.symm, ?_⟩
    rw [ringKrullDim_eq_of_ringEquiv e, IsLocalization.AtPrime.ringKrullDim_eq_height
      (Q.comap (algebraMap A ↥(fexaP x y w n {a}))) (Localization.AtPrime _), ← hdim]
    exact Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsPrime.ne_top inferInstance)

  have stalk : ∀ z : Y, ∃ (a : Fin n) (Q : Ideal ↥(fexaP x y w n {a})) (_ : Q.IsPrime),
      Nonempty (Y.presheaf.stalk z ≃+* Localization.AtPrime Q) := by
    intro z
    obtain ⟨a, p, rfl⟩ := hG.2.2.1 z
    haveI := hG.2.1 {a} (Finset.singleton_nonempty a)
    exact ⟨a, p.asIdeal, p.isPrime, ⟨(asIso ((ι {a} (Finset.singleton_nonempty a)).stalkMap p) ≪≫
      AlgebraicGeometry.Spec.stalkIso (CommRingCat.of ↥(fexaP x y w n {a})) p).commRingCatIsoToRingEquiv⟩⟩
  have hst : ∀ z : Y, IsNoetherianRing (Y.presheaf.stalk z) ∧
      IsRegularLocalRing (Y.presheaf.stalk z) ∧
      IsIntegrallyClosed (Y.presheaf.stalk z) ∧ ringKrullDim (Y.presheaf.stalk z) ≤ 2 ∧
      _root_.IsReduced (Y.presheaf.stalk z) := by
    intro z
    obtain ⟨a, Q, hQ, ⟨e⟩⟩ := stalk z
    haveI := (hPT {a}).1
    haveI := (hPT {a}).2
    obtain ⟨hr, hd⟩ := loc a Q
    haveI := hr
    obtain ⟨hdom, hufd⟩ := wc_fco_regular_local_ufd (Localization.AtPrime Q)
    haveI := hdom
    haveI := hufd
    haveI : IsNoetherianRing (Localization.AtPrime Q) :=
      IsLocalization.isNoetherianRing Q.primeCompl _ inferInstance
    haveI hic : IsIntegrallyClosed (Localization.AtPrime Q) :=
      UniqueFactorizationMonoid.instIsIntegrallyClosed
    refine ⟨isNoetherianRing_of_ringEquiv (Localization.AtPrime Q) e.symm,
      IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime Q) e.symm,
      @IsIntegrallyClosed.of_equiv (Localization.AtPrime Q) _ _ _ e.symm hic, ?_,
      isReduced_of_injective e e.injective⟩
    rw [ringKrullDim_eq_of_ringEquiv e]
    exact hd

  haveI : ∀ z : Y, _root_.IsReduced (Y.presheaf.stalk z) := fun z => (hst z).2.2.2.2
  haveI : AlgebraicGeometry.IsReduced Y := isReduced_of_isReduced_stalk Y
  haveI : IrreducibleSpace Y := by
    have a0 : Fin n := ⟨0, hn⟩
    let U : Fin n → Set Y := fun a => Set.range (ι {a} (Finset.singleton_nonempty a))
    have hUo : ∀ a, IsOpen (U a) := fun a => by
      haveI := hG.2.1 {a} (Finset.singleton_nonempty a)
      exact (ι {a} (Finset.singleton_nonempty a)).isOpenEmbedding.isOpen_range
    have hUi : ∀ a, IsIrreducible (U a) := fun a => by
      haveI := (hPT {a}).1
      have h := (IrreducibleSpace.isIrreducible_univ
        (Spec (CommRingCat.of ↥(fexaP x y w n {a})))).image
        (ι {a} (Finset.singleton_nonempty a)) (ι {a} _).continuous.continuousOn
      rw [Set.image_univ] at h
      exact h
    have hUm : ∀ a b, (U a ∩ U b).Nonempty := fun a b => by
      haveI := (hPT {a, b}).1
      obtain ⟨p⟩ := (inferInstance : Nonempty (Spec (CommRingCat.of ↥(fexaP x y w n {a, b}))))
      have hsa : ({a} : Finset (Fin n)) ⊆ {a, b} := by simp
      have hsb : ({b} : Finset (Fin n)) ⊆ {a, b} := by simp
      have e1 := hG.1 {a} {a, b} hsa (Finset.singleton_nonempty a)
      have e2 := hG.1 {b} {a, b} hsb (Finset.singleton_nonempty b)
      refine ⟨ι {a, b} (Finset.Nonempty.mono hsa (Finset.singleton_nonempty a)) p,
        ⟨Spec.map (fexaIncl x y w n hsa) p, ?_⟩, ⟨Spec.map (fexaIncl x y w n hsb) p, ?_⟩⟩
      · rw [← Scheme.Hom.comp_apply, e1]
      · rw [← Scheme.Hom.comp_apply, e2]
    have hcl : closure (U a0) = Set.univ := by
      apply Set.eq_univ_of_forall
      intro z
      obtain ⟨a, p, hp⟩ := hG.2.2.1 z
      have h1 := subset_closure_inter_of_isPreirreducible_of_isOpen (hUi a).isPreirreducible
        (hUo a0) (hUm a a0)
      exact closure_mono Set.inter_subset_right (h1 ⟨p, hp⟩)
    rw [irreducibleSpace_def]
    have h := (hUi a0).closure
    rw [hcl] at h
    exact h
  exact ⟨isIntegral_of_irreducibleSpace_of_isReduced Y,
    fun z => ⟨(hst z).1, (hst z).2.1, (hst z).2.2.1, (hst z).2.2.2.1⟩⟩

theorem fexa_glued_iso_offcenter (A : Type u) [CommRing A] [IsDomain A] [IsLocalRing A] (x y w : A)
    (n : ℕ) (hn : 1 ≤ n) (hxy : x * y = w ^ n) (hw : w ≠ 0)
    (hm : IsLocalRing.maximalIdeal A = Ideal.span {w, x, y}) (Y : Scheme.{u})
    (ι : ∀ T : Finset (Fin n), T.Nonempty → (Spec (CommRingCat.of ↥(fexaP x y w n T)) ⟶ Y))
    (ρ : Y ⟶ Spec (CommRingCat.of A)) (hG : fexaGlued x y w n Y ι ρ) :
    ∃ U₀ : (Spec (CommRingCat.of A)).Opens, (∀ p, p ∈ U₀ ↔ p ≠ IsLocalRing.closedPoint A) ∧
      IsIso (ρ ∣_ U₀) :=
by
  classical

  have s5 : ∀ (A P : Type u) [CommRing A] [CommRing P] [IsDomain P] (φ : A →+* P) (s : A),
      Function.Injective φ → s ≠ 0 → (∀ p : P, ∃ (m : ℕ) (a : A), p * φ s ^ m = φ a) →
      Function.Bijective (Localization.awayMap φ s) := by
    intro A P _ _ _ φ s hφ hs hgen
    have hφs : φ s ≠ 0 := fun h => hs (hφ (by rw [h, map_zero]))
    constructor
    · rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨a, t⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers s) z
      simp only at hz ⊢
      rw [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_mk',
        IsLocalization.mk'_eq_zero_iff] at hz
      obtain ⟨⟨m, hm⟩, hm0⟩ := hz
      obtain ⟨k, rfl⟩ := hm
      have h1 : φ a = 0 := by
        have h2 : (φ s) ^ k * φ a = 0 := hm0
        rcases mul_eq_zero.mp h2 with h | h
        · exact absurd h (pow_ne_zero k hφs)
        · exact h
      have ha : a = 0 := hφ (by rw [h1, map_zero])
      rw [ha, IsLocalization.mk'_zero]
    · intro z
      obtain ⟨⟨p, t⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers (φ s)) z
      obtain ⟨k, hk⟩ := t.2
      obtain ⟨m, a, hma⟩ := hgen p
      refine ⟨IsLocalization.mk' (Localization.Away s) a
        (⟨s ^ (k + m), k + m, rfl⟩ : Submonoid.powers s), ?_⟩
      simp only
      rw [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_mk',
        IsLocalization.mk'_eq_iff_eq]
      congr 1
      simp only [map_pow]
      rw [← hk, ← hma]
      ring

  have s6 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (P Q : Subalgebra A B)
      (hPQ : P ≤ Q) (d e : B) (hd : d ∈ P), e ∈ Q → d * e = 1 →
      Q ≤ Algebra.adjoin A ((P : Set B) ∪ {e}) → ∀ (p : PrimeSpectrum P),
      (⟨d, hd⟩ : P) ∉ p.asIdeal →
      ∃ q : PrimeSpectrum Q, PrimeSpectrum.comap (Subalgebra.inclusion hPQ).toRingHom q = p := by
    intro A B _ _ _ P Q hPQ d e hd he hde hQ p hdp
    letI : Algebra P Q := (Subalgebra.inclusion hPQ).toRingHom.toAlgebra
    have hloc : IsLocalization.Away (⟨d, hd⟩ : P) Q := by
      apply IsLocalization.Away.mk
      · refine IsUnit.of_mul_eq_one (⟨e, he⟩ : Q) ?_
        apply Subtype.ext
        exact hde
      · intro q
        have key : ∀ b (hb : b ∈ Algebra.adjoin A ((P : Set B) ∪ {e})),
            ∃ k : ℕ, ∃ c ∈ P, b * d ^ k = c := by
          intro b hb
          induction hb using Algebra.adjoin_induction with
          | mem x hx =>
            rcases hx with hx | hx
            · exact ⟨0, x, hx, by simp⟩
            · rw [Set.mem_singleton_iff] at hx
              subst hx
              exact ⟨1, 1, P.one_mem, by rw [pow_one, mul_comm, hde]⟩
          | algebraMap r => exact ⟨0, algebraMap A B r, P.algebraMap_mem r, by simp⟩
          | add x y _ _ hx hy =>
            obtain ⟨k1, c1, hc1, h1⟩ := hx
            obtain ⟨k2, c2, hc2, h2⟩ := hy
            refine ⟨k1 + k2, c1 * d ^ k2 + c2 * d ^ k1,
              P.add_mem (P.mul_mem hc1 (P.pow_mem hd _)) (P.mul_mem hc2 (P.pow_mem hd _)), ?_⟩
            rw [← h1, ← h2]; ring
          | mul x y _ _ hx hy =>
            obtain ⟨k1, c1, hc1, h1⟩ := hx
            obtain ⟨k2, c2, hc2, h2⟩ := hy
            refine ⟨k1 + k2, c1 * c2, P.mul_mem hc1 hc2, ?_⟩
            rw [← h1, ← h2]; ring
        obtain ⟨k, c, hc, hkc⟩ := key q.1 (hQ q.2)
        refine ⟨k, ⟨c, hc⟩, ?_⟩
        apply Subtype.ext
        exact hkc
      · intro a b hab
        exact ⟨0, by rw [Subalgebra.inclusion_injective hPQ hab]⟩
    have hr := PrimeSpectrum.localization_away_comap_range Q (⟨d, hd⟩ : P)
    have hp : p ∈ Set.range (PrimeSpectrum.comap (algebraMap P Q)) := by
      rw [hr]; exact hdp
    exact hp

  have s7 : ∀ (R P : Type u) [CommRing R] [CommRing P] (φ : R →+* P) (Y : Scheme.{u})
      (ρ : Y ⟶ Spec (CommRingCat.of R)) (j : Spec (CommRingCat.of P) ⟶ Y) [IsOpenImmersion j],
      j ≫ ρ = Spec.map (CommRingCat.ofHom φ) → ∀ (s : R),
      (∀ z : Y, ρ z ∈ PrimeSpectrum.basicOpen s → z ∈ Set.range j) →
      Function.Bijective (Localization.awayMap φ s) →
      IsIso (ρ ∣_ PrimeSpectrum.basicOpen s) := by
    intro R P _ _ φ Y ρ j _ hj s hrange hbij
    have h1 : IsIso ((j ≫ ρ) ∣_ PrimeSpectrum.basicOpen s) := by
      rw [hj]
      have e := SpecMapRestrictBasicOpenIso (CommRingCat.ofHom φ) s
      haveI : IsIso (CommRingCat.ofHom (Localization.awayMap (CommRingCat.ofHom φ).hom s)) :=
        (ConcreteCategory.isIso_iff_bijective _).mpr hbij
      have h3 : (MorphismProperty.isomorphisms Scheme)
          (Spec.map (CommRingCat.ofHom (Localization.awayMap (CommRingCat.ofHom φ).hom s))) := by
        rw [MorphismProperty.isomorphisms.iff]; infer_instance
      exact (MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme) e).mpr h3
    have gen : ∀ D : (Spec (CommRingCat.of R)).Opens, IsIso ((j ≫ ρ) ∣_ D) →
        (∀ z : Y, ρ z ∈ D → z ∈ Set.range j) → IsIso (ρ ∣_ D) := by
      intro D hD hrD
      have h2 : IsIso (j ∣_ (ρ ⁻¹ᵁ D)) := by
        rw [isIso_iff_isOpenImmersion_and_surjective]
        refine ⟨inferInstance, ⟨fun v => ?_⟩⟩
        have hmemι : ∀ {B : Scheme.{u}} (U : B.Opens) (x : U.toScheme), U.ι x ∈ U := by
          intro B U x
          show U.ι x ∈ (U : Set B)
          rw [← Scheme.Opens.range_ι U]
          exact ⟨x, rfl⟩
        have hv : ρ ((ρ ⁻¹ᵁ D).ι v) ∈ D := hmemι (ρ ⁻¹ᵁ D) v
        obtain ⟨t, ht⟩ := hrD _ hv
        have ht' : t ∈ ((j ⁻¹ᵁ (ρ ⁻¹ᵁ D) : (Spec (CommRingCat.of P)).Opens) : Set _) := by
          show j t ∈ ρ ⁻¹ᵁ D
          rw [ht]; exact hmemι _ v
        rw [← Scheme.Opens.range_ι] at ht'
        obtain ⟨t', rfl⟩ := ht'
        refine ⟨t', ?_⟩
        apply (ρ ⁻¹ᵁ D).ι.isOpenEmbedding.injective
        have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
            ∀ x, b (a x) = c x := by
          intro A B C a b c h x
          rw [← Scheme.Hom.comp_apply, h]
        rw [pt (morphismRestrict_ι j (ρ ⁻¹ᵁ D)) t', Scheme.Hom.comp_apply]
        exact ht
      rw [morphismRestrict_comp] at hD
      exact @IsIso.of_isIso_comp_left _ _ _ _ _ _ (ρ ∣_ D) h2 hD
    exact gen _ h1 hrange

  have s8 : ∀ (Y S : Scheme.{u}) (ρ : Y ⟶ S) (U₁ U₂ : S.Opens), IsIso (ρ ∣_ U₁) →
      IsIso (ρ ∣_ U₂) → IsIso (ρ ∣_ (U₁ ⊔ U₂)) := by
    intro Y S ρ U₁ U₂ h₁ h₂
    let V : Bool → (U₁ ⊔ U₂).toScheme.Opens := fun b => (U₁ ⊔ U₂).ι ⁻¹ᵁ (cond b U₁ U₂)
    have hV : iSup V = ⊤ := by
      rw [eq_top_iff]
      rintro u -
      rw [TopologicalSpace.Opens.mem_iSup]
      have hu : (U₁ ⊔ U₂).ι u ∈ U₁ ⊔ U₂ := by
        show (U₁ ⊔ U₂).ι u ∈ ((U₁ ⊔ U₂ : S.Opens) : Set S)
        rw [← Scheme.Opens.range_ι (U₁ ⊔ U₂)]
        exact ⟨u, rfl⟩
      rcases (TopologicalSpace.Opens.mem_sup.mp hu) with h | h
      · exact ⟨true, h⟩
      · exact ⟨false, h⟩
    have key := (IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := MorphismProperty.isomorphisms Scheme) (f := ρ ∣_ (U₁ ⊔ U₂)) V hV).mpr
    show MorphismProperty.isomorphisms Scheme (ρ ∣_ (U₁ ⊔ U₂))
    apply key
    intro b
    refine (MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
      (morphismRestrictRestrict ρ (U₁ ⊔ U₂) (V b))).mpr ?_
    have heq : (U₁ ⊔ U₂).ι ''ᵁ V b = cond b U₁ U₂ := by
      simp only [V]
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      cases b
      · exact inf_eq_right.mpr le_sup_right
      · exact inf_eq_right.mpr le_sup_left
    refine (MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
      (morphismRestrictEq ρ heq)).mpr ?_
    cases b
    · exact h₂
    · exact h₁
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have hmem : ∀ p : Spec (CommRingCat.of A),
      p ∈ (PrimeSpectrum.basicOpen x ⊔ PrimeSpectrum.basicOpen y :
        (Spec (CommRingCat.of A)).Opens) ↔ p ≠ IsLocalRing.closedPoint A := by
    intro p
    have hxm : x ∈ IsLocalRing.maximalIdeal A := by rw [hm]; exact Ideal.subset_span (by simp)
    have hym : y ∈ IsLocalRing.maximalIdeal A := by rw [hm]; exact Ideal.subset_span (by simp)
    constructor
    · intro hp hpc
      rcases TopologicalSpace.Opens.mem_sup.mp hp with h | h
      · apply (PrimeSpectrum.mem_basicOpen _ _).mp h
        rw [hpc]; exact hxm
      · apply (PrimeSpectrum.mem_basicOpen _ _).mp h
        rw [hpc]; exact hym
    · intro hpc
      by_contra hcon
      apply hpc
      have hx' : x ∈ p.asIdeal := by
        by_contra h
        exact hcon (TopologicalSpace.Opens.mem_sup.mpr
          (Or.inl ((PrimeSpectrum.mem_basicOpen _ _).mpr h)))
      have hy' : y ∈ p.asIdeal := by
        by_contra h
        exact hcon (TopologicalSpace.Opens.mem_sup.mpr
          (Or.inr ((PrimeSpectrum.mem_basicOpen _ _).mpr h)))
      have hw' : w ∈ p.asIdeal :=
        p.isPrime.mem_of_pow_mem n (by rw [← hxy]; exact Ideal.mul_mem_right _ _ hx')
      have hle : IsLocalRing.maximalIdeal A ≤ p.asIdeal := by
        rw [hm, Ideal.span_le]
        intro z hz
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
        rcases hz with rfl | rfl | rfl
        · exact hw'
        · exact hx'
        · exact hy'
      have heq := (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le p.isPrime.ne_top hle
      exact PrimeSpectrum.ext heq.symm

  have hx0 : x ≠ 0 := by
    intro h; apply pow_ne_zero n hw; rw [← hxy, h, zero_mul]
  have hy0 : y ≠ 0 := by
    intro h; apply pow_ne_zero n hw; rw [← hxy, h, mul_zero]
  have hpow : Submonoid.powers w ≤ nonZeroDivisors A :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hw
  haveI hdomL : IsDomain (Localization.Away w) := IsLocalization.isDomain_localization hpow
  have hinj : Function.Injective (algebraMap A (Localization.Away w)) :=
    IsLocalization.injective (Localization.Away w) hpow
  have hinjP : ∀ T, Function.Injective (algebraMap A ↥(fexaP x y w n T)) := by
    intro T a b hab
    apply hinj
    exact congrArg Subtype.val hab
  have hW : algebraMap A (Localization.Away w) w * Localization.Away.invSelf w = 1 := by
    rw [Localization.Away.invSelf, ← Localization.mk_one_eq_algebraMap, Localization.mk_mul,
      one_mul, mul_one]
    exact Localization.mk_self (⟨w, Submonoid.mem_powers w⟩ : Submonoid.powers w)
  have hWN : ∀ N : ℕ, algebraMap A (Localization.Away w) w ^ N *
      Localization.Away.invSelf w ^ N = 1 := by
    intro N; rw [← mul_pow, hW, one_pow]
  have hXY : algebraMap A (Localization.Away w) x * algebraMap A (Localization.Away w) y =
      algebraMap A (Localization.Away w) w ^ n := by
    rw [← map_mul, hxy, map_pow]
  have hcl : ∀ (s : A) (S : Set (Localization.Away w)),
      (∀ z ∈ S, ∃ (m : ℕ) (a : A), z * algebraMap A _ s ^ m = algebraMap A _ a) →
      ∀ p ∈ Algebra.adjoin A S, ∃ (m : ℕ) (a : A), p * algebraMap A _ s ^ m = algebraMap A _ a := by
    intro s S hS p hp
    induction hp using Algebra.adjoin_induction with
    | mem z hz => exact hS z hz
    | algebraMap r => exact ⟨0, r, by simp⟩
    | add p q _ _ hp hq =>
      obtain ⟨m1, a1, h1⟩ := hp
      obtain ⟨m2, a2, h2⟩ := hq
      refine ⟨m1 + m2, a1 * s ^ m2 + a2 * s ^ m1, ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, ← h1, ← h2]; ring
    | mul p q _ _ hp hq =>
      obtain ⟨m1, a1, h1⟩ := hp
      obtain ⟨m2, a2, h2⟩ := hq
      refine ⟨m1 + m2, a1 * a2, ?_⟩
      rw [map_mul, ← h1, ← h2]; ring
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  obtain ⟨hG1, hG2, hG3, -, hG5⟩ := hG
  have hα0 : fexaAlpha x w ((0 : Fin (k + 1)) : ℕ) = algebraMap A (Localization.Away w) x := by
    simp [fexaAlpha]
  have hβ0 : fexaBeta y w (k + 1) ((0 : Fin (k + 1)) : ℕ) =
      algebraMap A (Localization.Away w) y * Localization.Away.invSelf w ^ k := by
    simp [fexaBeta]
  have hαT : fexaAlpha x w ((Fin.last k : Fin (k + 1)) : ℕ) =
      algebraMap A (Localization.Away w) x * Localization.Away.invSelf w ^ k := by
    simp [fexaAlpha]
  have hβT : fexaBeta y w (k + 1) ((Fin.last k : Fin (k + 1)) : ℕ) =
      algebraMap A (Localization.Away w) y := by
    simp [fexaBeta]

  have hsubI : ∀ {T T' : Finset (Fin (k + 1))}, T ⊆ T' →
      fexaP x y w (k + 1) T ≤ fexaP x y w (k + 1) T' := fun h =>
    Algebra.adjoin_mono (fun z hz => by
      obtain ⟨i, hi, hz⟩ := Set.mem_iUnion₂.mp hz
      exact Set.mem_iUnion₂.mpr ⟨i, h hi, hz⟩)
  have hgenmem : ∀ (T : Finset (Fin (k + 1))) (i : Fin (k + 1)), i ∈ T →
      fexaAlpha x w i ∈ fexaP x y w (k + 1) T ∧ fexaBeta y w (k + 1) i ∈ fexaP x y w (k + 1) T :=
    fun T i hi => ⟨Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨i, hi, Set.mem_insert _ _⟩),
      Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨i, hi,
        Set.mem_insert_of_mem _ (Set.mem_singleton _)⟩)⟩

  have hrangeG : ∀ (c0 : Fin (k + 1)) (s : A) (e0 : Localization.Away w),
      e0 ∈ fexaP x y w (k + 1) {c0} → fexaP x y w (k + 1) {c0} ≤ Algebra.adjoin A {e0} →
      (∀ a : Fin (k + 1), a ≠ c0 → ∃ d ∈ fexaP x y w (k + 1) {a}, d * e0 = 1 ∧
        algebraMap A (Localization.Away w) s = d * algebraMap A (Localization.Away w) w) →
      ∀ z : Y, ρ z ∈ PrimeSpectrum.basicOpen s →
        z ∈ Set.range (ι {c0} (Finset.singleton_nonempty c0)) := by
    intro c0 s e0 he0 hc0 hd z hz
    obtain ⟨a, p, rfl⟩ := hG3 z
    by_cases hac : a = c0
    · subst hac; exact ⟨p, rfl⟩
    obtain ⟨d, hdP, hde, hsd⟩ := hd a hac
    rw [pt (hG5 {a} (Finset.singleton_nonempty a)) p] at hz
    have hzp : algebraMap A ↥(fexaP x y w (k + 1) {a}) s ∉ p.asIdeal := hz
    have hdp : (⟨d, hdP⟩ : ↥(fexaP x y w (k + 1) {a})) ∉ p.asIdeal := by
      intro hmem'
      apply hzp
      have e1 : algebraMap A ↥(fexaP x y w (k + 1) {a}) s =
          ⟨d, hdP⟩ * algebraMap A ↥(fexaP x y w (k + 1) {a}) w := by
        apply Subtype.ext
        simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
        exact hsd
      rw [e1]; exact Ideal.mul_mem_right _ _ hmem'
    have haT : ({a} : Finset (Fin (k + 1))) ⊆ insert c0 {a} := Finset.subset_insert _ _
    have hcT : ({c0} : Finset (Fin (k + 1))) ⊆ insert c0 {a} :=
      Finset.singleton_subset_iff.mpr (Finset.mem_insert_self _ _)
    have he0T : e0 ∈ fexaP x y w (k + 1) (insert c0 {a}) := hsubI hcT he0
    have hle : fexaP x y w (k + 1) (insert c0 {a}) ≤
        Algebra.adjoin A ((fexaP x y w (k + 1) {a} : Set (Localization.Away w)) ∪ {e0}) := by
      apply Algebra.adjoin_le
      intro z hz
      obtain ⟨i, hi, hz⟩ := Set.mem_iUnion₂.mp hz
      rcases Finset.mem_insert.mp hi with hi | hi
      · rw [hi] at hz
        have hzc : z ∈ fexaP x y w (k + 1) {c0} :=
          Algebra.subset_adjoin (Set.mem_iUnion₂.mpr ⟨c0, Finset.mem_singleton_self c0, hz⟩)
        exact Algebra.adjoin_mono Set.subset_union_right (hc0 hzc)
      · rw [Finset.mem_singleton] at hi
        rw [hi] at hz
        exact Algebra.subset_adjoin (Or.inl (Algebra.subset_adjoin
          (Set.mem_iUnion₂.mpr ⟨a, Finset.mem_singleton_self a, hz⟩)))
    obtain ⟨q0, hq⟩ := s6 A (Localization.Away w) _ _ (hsubI haT) d e0 hdP he0T hde hle p hdp
    let q : Spec (CommRingCat.of ↥(fexaP x y w (k + 1) (insert c0 {a}))) := q0
    have hqp : Spec.map (fexaIncl x y w (k + 1) haT) q = p := by
      rw [Spec.map_apply]; exact hq
    refine ⟨Spec.map (fexaIncl x y w (k + 1) hcT) q, ?_⟩
    rw [pt (hG1 {c0} (insert c0 {a}) hcT (Finset.singleton_nonempty c0)) q,
      ← pt (hG1 {a} (insert c0 {a}) haT (Finset.singleton_nonempty a)) q, hqp]

  have hbijG : ∀ (c0 : Fin (k + 1)) (s : A) (e0 : Localization.Away w), s ≠ 0 →
      fexaP x y w (k + 1) {c0} ≤ Algebra.adjoin A {e0} →
      e0 * algebraMap A (Localization.Away w) s = algebraMap A (Localization.Away w) w →
      Function.Bijective (Localization.awayMap (algebraMap A ↥(fexaP x y w (k + 1) {c0})) s) := by
    intro c0 s e0 hs hc0 he
    apply s5 A _ _ s (hinjP _) hs
    intro p
    obtain ⟨m, a, hma⟩ := hcl s {e0} (by
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      subst hz
      exact ⟨1, w, by rw [pow_one, he]⟩) p.1 (hc0 p.2)
    refine ⟨m, a, ?_⟩
    apply Subtype.ext
    simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, Subalgebra.coe_algebraMap]
    exact hma

  have he0x : fexaBeta y w (k + 1) ((0 : Fin (k + 1)) : ℕ) ∈ fexaP x y w (k + 1) {0} :=
    (hgenmem {0} 0 (Finset.mem_singleton_self _)).2
  have hc0x : fexaP x y w (k + 1) {0} ≤
      Algebra.adjoin A {fexaBeta y w (k + 1) ((0 : Fin (k + 1)) : ℕ)} := by
    apply Algebra.adjoin_le
    intro z hz
    obtain ⟨i, hi, hz⟩ := Set.mem_iUnion₂.mp hz
    rw [Finset.mem_singleton] at hi
    subst hi
    rcases hz with rfl | hz
    · rw [hα0]; exact Subalgebra.algebraMap_mem _ x
    · rw [Set.mem_singleton_iff] at hz
      rw [hz]; exact Algebra.subset_adjoin rfl
  have hdx : ∀ a : Fin (k + 1), a ≠ 0 → ∃ d ∈ fexaP x y w (k + 1) {a},
      d * fexaBeta y w (k + 1) ((0 : Fin (k + 1)) : ℕ) = 1 ∧
      algebraMap A (Localization.Away w) x = d * algebraMap A (Localization.Away w) w := by
    intro a ha
    have ha' : (a : ℕ) ≠ 0 := fun h => ha (Fin.ext (by simp [h]))
    obtain ⟨b, hb⟩ : ∃ b, (a : ℕ) = b + 1 := ⟨(a : ℕ) - 1, by omega⟩
    refine ⟨fexaAlpha x w a * algebraMap A (Localization.Away w) w ^ b,
      Subalgebra.mul_mem _ (hgenmem {a} a (Finset.mem_singleton_self a)).1
        (Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ w) b), ?_, ?_⟩
    · rw [hβ0]
      simp only [fexaAlpha, hb]
      linear_combination (Localization.Away.invSelf w ^ (b + 1 + k) *
        algebraMap A (Localization.Away w) w ^ b) * hXY + hWN (k + 1 + b)
    · simp only [fexaAlpha, hb]
      linear_combination (-algebraMap A (Localization.Away w) x) * hWN (b + 1)
  have hex : fexaBeta y w (k + 1) ((0 : Fin (k + 1)) : ℕ) * algebraMap A (Localization.Away w) x =
      algebraMap A (Localization.Away w) w := by
    rw [hβ0]
    linear_combination (Localization.Away.invSelf w ^ k) * hXY +
      algebraMap A (Localization.Away w) w * hWN k

  have he0y : fexaAlpha x w ((Fin.last k : Fin (k + 1)) : ℕ) ∈ fexaP x y w (k + 1) {Fin.last k} :=
    (hgenmem {Fin.last k} (Fin.last k) (Finset.mem_singleton_self _)).1
  have hc0y : fexaP x y w (k + 1) {Fin.last k} ≤
      Algebra.adjoin A {fexaAlpha x w ((Fin.last k : Fin (k + 1)) : ℕ)} := by
    apply Algebra.adjoin_le
    intro z hz
    obtain ⟨i, hi, hz⟩ := Set.mem_iUnion₂.mp hz
    rw [Finset.mem_singleton] at hi
    subst hi
    rcases hz with rfl | hz
    · exact Algebra.subset_adjoin rfl
    · rw [Set.mem_singleton_iff] at hz
      rw [hz, hβT]; exact Subalgebra.algebraMap_mem _ y
  have hdy : ∀ a : Fin (k + 1), a ≠ Fin.last k → ∃ d ∈ fexaP x y w (k + 1) {a},
      d * fexaAlpha x w ((Fin.last k : Fin (k + 1)) : ℕ) = 1 ∧
      algebraMap A (Localization.Away w) y = d * algebraMap A (Localization.Away w) w := by
    intro a ha
    have ha' : (a : ℕ) < k := by
      have h1 := a.isLt
      have h2 : (a : ℕ) ≠ k := fun h => ha (Fin.ext (by simp [h]))
      omega
    obtain ⟨c, hc⟩ : ∃ c, k + 1 - 1 - (a : ℕ) = c + 1 := ⟨k - (a : ℕ) - 1, by omega⟩
    refine ⟨fexaBeta y w (k + 1) a * algebraMap A (Localization.Away w) w ^ c,
      Subalgebra.mul_mem _ (hgenmem {a} a (Finset.mem_singleton_self a)).2
        (Subalgebra.pow_mem _ (Subalgebra.algebraMap_mem _ w) c), ?_, ?_⟩
    · rw [hαT]
      simp only [fexaBeta, hc]
      linear_combination (Localization.Away.invSelf w ^ (c + 1 + k) *
        algebraMap A (Localization.Away w) w ^ c) * hXY + hWN (k + 1 + c)
    · simp only [fexaBeta, hc]
      linear_combination (-algebraMap A (Localization.Away w) y) * hWN (c + 1)
  have hey : fexaAlpha x w ((Fin.last k : Fin (k + 1)) : ℕ) * algebraMap A (Localization.Away w) y =
      algebraMap A (Localization.Away w) w := by
    rw [hαT]
    linear_combination (Localization.Away.invSelf w ^ k) * hXY +
      algebraMap A (Localization.Away w) w * hWN k

  have hIx : IsIso (ρ ∣_ PrimeSpectrum.basicOpen x) := by
    haveI := hG2 {0} (Finset.singleton_nonempty 0)
    exact s7 A _ (algebraMap A _) Y ρ (ι {0} (Finset.singleton_nonempty 0)) (hG5 _ _) x
      (hrangeG 0 x _ he0x hc0x hdx) (hbijG 0 x _ hx0 hc0x hex)
  have hIy : IsIso (ρ ∣_ PrimeSpectrum.basicOpen y) := by
    haveI := hG2 {Fin.last k} (Finset.singleton_nonempty (Fin.last k))
    exact s7 A _ (algebraMap A _) Y ρ (ι {Fin.last k} (Finset.singleton_nonempty (Fin.last k)))
      (hG5 _ _) y (hrangeG (Fin.last k) y _ he0y hc0y hdy) (hbijG (Fin.last k) y _ hy0 hc0y hey)
  exact ⟨_, hmem, s8 Y _ ρ _ _ hIx hIy⟩

theorem fex_An_resolution : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
    IsAdicComplete (IsLocalRing.maximalIdeal A) A → ringKrullDim A = 2 →
    (∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : IsDiscreteValuationRing R) (c : R),
        c ≠ 0 ∧ c ∈ IsLocalRing.maximalIdeal R ∧ IsAdicComplete (IsLocalRing.maximalIdeal R) R ∧
        Nonempty (A ≃+* (MvPowerSeries (Fin 2) R ⧸
          Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}))) →
    ∃ (Y : Scheme.{u}) (ρ : Y ⟶ Spec (.of A)), IsProper ρ ∧ AlgebraicGeometry.IsIntegral Y ∧
      (∀ y : Y, IsNoetherianRing (Y.presheaf.stalk y) ∧ IsRegularLocalRing (Y.presheaf.stalk y) ∧
        IsIntegrallyClosed (Y.presheaf.stalk y) ∧ ringKrullDim (Y.presheaf.stalk y) ≤ 2) ∧
      (∃ U₀ : (Spec (.of A)).Opens, (∀ p, p ∈ U₀ ↔ p ≠ IsLocalRing.closedPoint A) ∧
        IsIso (ρ ∣_ U₀)) ∧
      wcpaDjFexH1 Y :=
by
  intro A _ _ _ _ hdim hAn
  obtain ⟨R, _, _, _, c, hc0, hcm, _, ⟨φ₀⟩⟩ := hAn
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨n, u, hcu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc0 hϖ
  have hn : 1 ≤ n := by
    rcases Nat.eq_zero_or_pos n with h | h
    · exfalso
      subst h
      rw [pow_zero, mul_one] at hcu
      exact (IsLocalRing.mem_maximalIdeal c).mp hcm (by rw [hcu]; exact u.isUnit)
    · exact h
  obtain ⟨Φ, -⟩ := wcpa_dj_mn_rescale R u (ϖ ^ n)
  subst hcu
  let φ : A ≃+* fexaAA R ϖ n := φ₀.trans Φ
  obtain ⟨hdom, hnoeth, hunit, hne, hw, -, -, hxy⟩ := fexa_AA_basic R ϖ hϖ n hn
  obtain ⟨hdom1, -⟩ := fexa_AA_basic R ϖ hϖ 1 le_rfl
  haveI := hdom
  haveI := hdom1
  haveI := hnoeth
  haveI : IsLocalRing (fexaAA R ϖ n) :=
    IsLocalRing.of_surjective' (φ : A →+* fexaAA R ϖ n) φ.surjective
  have hm : IsLocalRing.maximalIdeal (fexaAA R ϖ n) =
      Ideal.span {fexaW R ϖ n, fexaX R ϖ n, fexaY R ϖ n} := by
    apply le_antisymm
    · intro z hz
      rcases hunit z with h | h
      · exact absurd h ((IsLocalRing.mem_maximalIdeal z).mp hz)
      · exact h
    · exact IsLocalRing.le_maximalIdeal hne
  have hdimAA : ringKrullDim (fexaAA R ϖ n) = 2 := (ringKrullDim_eq_of_ringEquiv φ).symm.trans hdim
  obtain ⟨Y, ι, ρ', hG⟩ :=
    fexa_glue_exists (fexaAA R ϖ n) (fexaX R ϖ n) (fexaY R ϖ n) (fexaW R ϖ n) n hn hxy
  haveI hprop : IsProper ρ' := fexa_glued_proper (fexaAA R ϖ n) _ _ _ n hn hxy hw Y ι ρ' hG
  have hH1 := fexa_glued_fexH1 (fexaAA R ϖ n) _ _ _ n hn hxy hw Y ι ρ' hG inferInstance
  obtain ⟨hYint, hst⟩ := fexa_glued_stalks (fexaAA R ϖ n) _ _ _ n hn hxy hw hdimAA
    (fun q _ hq => fexa_offcenter_regular R ϖ hϖ n hn hunit q hq)
    (fun i => fexa_chart_quotient_pid R ϖ hϖ n hn hw i) Y ι ρ' hG
  obtain ⟨U₀', hU₀', hiso'⟩ := fexa_glued_iso_offcenter (fexaAA R ϖ n) _ _ _ n hn hxy hw hm Y ι ρ' hG

  let e : Spec (CommRingCat.of (fexaAA R ϖ n)) ⟶ Spec (CommRingCat.of A) :=
    Spec.map φ.toCommRingCatIso.hom
  haveI : IsIso e := inferInstance
  have hei : ∀ p, e ((inv e) p) = p := fun p => by
    rw [← Scheme.Hom.comp_apply, IsIso.inv_hom_id]; simp
  have hie : ∀ p, (inv e) (e p) = p := fun p => by
    rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]; simp
  have hcp : e (IsLocalRing.closedPoint (fexaAA R ϖ n)) = IsLocalRing.closedPoint A := by
    have hmax : (Ideal.comap (φ : A →+* fexaAA R ϖ n)
        (IsLocalRing.maximalIdeal (fexaAA R ϖ n))).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective _ φ.surjective
    have h2 := IsLocalRing.eq_maximalIdeal hmax
    apply PrimeSpectrum.ext
    exact h2
  have hpre : e ⁻¹ᵁ ((inv e) ⁻¹ᵁ U₀') = U₀' := by
    apply le_antisymm
    · intro p hp
      have h3 : (inv e) (e p) ∈ U₀' := hp
      rwa [hie] at h3
    · intro p hp
      show (inv e) (e p) ∈ U₀'
      rwa [hie]
  refine ⟨Y, ρ' ≫ e, inferInstance, hYint, hst, ⟨(inv e) ⁻¹ᵁ U₀', ?_, ?_⟩, hH1⟩
  · intro p
    rw [Scheme.Hom.mem_preimage, hU₀']
    constructor
    · intro h hp
      apply h
      rw [hp, ← hcp]
      exact hie _
    · intro h hp
      apply h
      rw [← hei p, hp, hcp]
  · rw [morphismRestrict_comp]
    have h1 : IsIso (ρ' ∣_ (e ⁻¹ᵁ ((inv e) ⁻¹ᵁ U₀'))) := by
      rw [hpre]; exact hiso'
    have h2 : IsIso (e ∣_ ((inv e) ⁻¹ᵁ U₀')) := inferInstance
    exact @IsIso.comp_isIso _ _ _ _ _ _ _ h1 h2

theorem fgm_norm_field_stalk_normal : ∀ (W : Scheme.{u}) (K : Type u) [Field K] (ε : Spec (.of K) ⟶ W) [QuasiCompact ε] [QuasiSeparated ε] (z : ε.normalization), IsIntegrallyClosed (ε.normalization.presheaf.stalk z) :=
by
  intro W K _ ε _ _ z

  have s1 : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L], IsField L →
      IsDomain (integralClosure A L) ∧ IsIntegrallyClosed (integralClosure A L) := by
    intro A L _ _ _ h
    letI : Field L := h.toField
    haveI : IsDomain L := h.isDomain
    exact ⟨Subalgebra.isDomain _, IsIntegrallyClosed.of_isIntegrallyClosedIn (integralClosure A L) L⟩

  have s2 : ∀ (Y : Scheme.{u}) (V : Y.Opens), IsAffineOpen V → IsDomain Γ(Y, V) →
      IsIntegrallyClosed Γ(Y, V) → ∀ y : V, IsIntegrallyClosed (Y.presheaf.stalk (y : Y)) := by
    intro Y V hV hd hi y
    haveI := hV.isLocalization_stalk y
    exact isIntegrallyClosed_of_isLocalization (Y.presheaf.stalk (y : Y))
      (hV.primeIdealOf y).asIdeal.primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors _)

  obtain ⟨W₀, hW₀, hzW, -⟩ := exists_isAffineOpen_mem_and_subset
    (show ε.fromNormalization z ∈ (⊤ : W.Opens) from trivial)
  have hV : IsAffineOpen (ε.fromNormalization ⁻¹ᵁ W₀) := hW₀.preimage ε.fromNormalization
  have hzV : z ∈ ε.fromNormalization ⁻¹ᵁ W₀ := hzW

  obtain ⟨a, ha⟩ := DenseRange.exists_mem_open (Scheme.Hom.denseRange ε.toNormalization)
    (ε.fromNormalization ⁻¹ᵁ W₀).isOpen ⟨z, hzV⟩
  have hεa : ε a ∈ W₀ := by
    have h := Scheme.Hom.comp_apply ε.toNormalization ε.fromNormalization a
    rw [Scheme.Hom.toNormalization_fromNormalization] at h
    rw [h]
    exact ha
  have hc : ε ⁻¹ᵁ W₀ = ⊤ := by
    rw [eq_top_iff]
    intro p _
    rw [Scheme.Hom.mem_preimage]
    have hp : p = a := by
      apply PrimeSpectrum.ext
      haveI := p.isPrime
      haveI := a.isPrime
      rw [Ideal.eq_bot_of_prime p.asIdeal, Ideal.eq_bot_of_prime a.asIdeal]
    rw [hp]
    exact hεa

  have s5 : IsField Γ(Spec (.of K), ε ⁻¹ᵁ W₀) := by
    rw [hc]
    exact MulEquiv.isField (Field.toIsField K)
      (Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv.toMulEquiv

  letI : Algebra Γ(W, W₀) Γ(Spec (.of K), ε ⁻¹ᵁ W₀) := (ε.app W₀).hom.toAlgebra
  obtain ⟨hdom, hic⟩ := s1 Γ(W, W₀) Γ(Spec (.of K), ε ⁻¹ᵁ W₀) s5
  let e := (Scheme.Hom.normalizationObjIso ε hW₀).commRingCatIsoToRingEquiv
  haveI : IsDomain Γ(ε.normalization, ε.fromNormalization ⁻¹ᵁ W₀) :=
    MulEquiv.isDomain _ e.toMulEquiv
  haveI : IsIntegrallyClosed Γ(ε.normalization, ε.fromNormalization ⁻¹ᵁ W₀) :=
    IsIntegrallyClosed.of_equiv e.symm
  exact s2 _ _ hV inferInstance inferInstance ⟨z, hzV⟩

theorem fgm_generic_ratio : ∀ (W : Scheme.{u}) (O : W.Opens) [AlgebraicGeometry.IsIntegral O.toScheme] (W₀ : W.Opens), IsAffineOpen W₀ → (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀ ≠ ⊥ → ∀ x : Γ(Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme)), (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀), ∃ a b : Γ(W, W₀), ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).app W₀).hom b ≠ 0 ∧ x * ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).app W₀).hom b = ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).app W₀).hom a :=
by
  intro W O _ W₀ hW₀ hne x
  obtain ⟨p, hp⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
  haveI hsub : Subsingleton (PrimeSpectrum (O.toScheme.presheaf.stalk (genericPoint O.toScheme))) :=
    inferInstance
  have htop : (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀ = ⊤ := by
    rw [eq_top_iff]
    intro q _
    rw [@Subsingleton.elim _ hsub q p]
    exact hp
  have hw : O.ι (genericPoint O.toScheme) ∈ W₀ := by
    have hp' : O.ι ((O.toScheme.fromSpecStalk (genericPoint O.toScheme)) p) ∈ W₀ := hp
    have h2 := Scheme.fromSpecStalk_closedPoint (X := O.toScheme) (x := genericPoint O.toScheme)
    have hpc : (IsLocalRing.closedPoint (O.toScheme.presheaf.stalk (genericPoint O.toScheme)) :
        Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme))) = p :=
      @Subsingleton.elim _ hsub _ _
    rw [hpc] at h2
    rw [h2] at hp'
    exact hp'
  have hξ : genericPoint O.toScheme ∈ O.ι ⁻¹ᵁ W₀ := hw
  have happ := Scheme.fromSpecStalk_app (X := O.toScheme) hξ
  have hρ : ∀ h : (O.toScheme.fromSpecStalk (genericPoint O.toScheme)) ⁻¹ᵁ (O.ι ⁻¹ᵁ W₀) ≤ ⊤,
      IsIso ((Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme))).presheaf.map
        (homOfLE h).op) := by
    intro h
    have h' : (⊤ : (Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme))).Opens) ≤
        (O.toScheme.fromSpecStalk (genericPoint O.toScheme)) ⁻¹ᵁ (O.ι ⁻¹ᵁ W₀) := by
      rw [← htop]; rfl
    haveI : IsIso (homOfLE h) := ⟨⟨homOfLE h', Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
    infer_instance
  let Θ : W.presheaf.stalk (O.ι (genericPoint O.toScheme)) ⟶
      Γ(Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme)),
        (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀) :=
    O.ι.stalkMap (genericPoint O.toScheme) ≫
    (Scheme.ΓSpecIso (O.toScheme.presheaf.stalk (genericPoint O.toScheme))).inv ≫
    (Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme))).presheaf.map
      (homOfLE (le_top : (O.toScheme.fromSpecStalk (genericPoint O.toScheme)) ⁻¹ᵁ (O.ι ⁻¹ᵁ W₀) ≤ ⊤)).op
  haveI : IsIso Θ :=
    @IsIso.comp_isIso _ _ _ _ _ _ _ inferInstance
      (@IsIso.comp_isIso _ _ _ _ _ _ _ inferInstance (hρ le_top))
  have hfac : (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).app W₀ =
      W.presheaf.germ W₀ (O.ι (genericPoint O.toScheme)) hw ≫ Θ := by
    rw [Scheme.Hom.comp_app, happ]
    simp only [Θ]
    rw [Scheme.Hom.germ_stalkMap_assoc]
    rfl
  have hbij : Function.Bijective Θ.hom := ConcreteCategory.bijective_of_isIso Θ
  letI : Algebra Γ(W, W₀) (W.presheaf.stalk (O.ι (genericPoint O.toScheme))) :=
    TopCat.Presheaf.algebra_section_stalk W.presheaf ⟨O.ι (genericPoint O.toScheme), hw⟩
  haveI hloc := hW₀.isLocalization_stalk ⟨O.ι (genericPoint O.toScheme), hw⟩
  obtain ⟨s, rfl⟩ := hbij.2 x
  obtain ⟨⟨a, m⟩, rfl⟩ := IsLocalization.mk'_surjective
    (hW₀.primeIdealOf ⟨O.ι (genericPoint O.toScheme), hw⟩).asIdeal.primeCompl s
  have hu : IsUnit (algebraMap Γ(W, W₀) (W.presheaf.stalk (O.ι (genericPoint O.toScheme)))
      (m : Γ(W, W₀))) := IsLocalization.map_units _ m
  have hel : ∀ c : Γ(W, W₀), ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).app W₀).hom c
      = Θ.hom ((W.presheaf.germ W₀ (O.ι (genericPoint O.toScheme)) hw).hom c) := by
    intro c
    rw [hfac]
    rfl
  refine ⟨a, m, ?_, ?_⟩
  · intro h0
    rw [hel] at h0
    have h1 : (W.presheaf.germ W₀ (O.ι (genericPoint O.toScheme)) hw).hom (m : Γ(W, W₀)) = 0 :=
      hbij.1 (h0.trans (map_zero _).symm)
    exact hu.ne_zero h1
  · rw [hel, hel, ← map_mul]
    congr 1
    exact IsLocalization.mk'_spec _ a m

theorem fgm_norm_iso_normal_open : ∀ (W : Scheme.{u}) (O : W.Opens) [AlgebraicGeometry.IsIntegral O.toScheme], (∀ U : O.toScheme.Opens, IsAffineOpen U → Nonempty U → IsIntegrallyClosed Γ(O.toScheme, U)) → ∀ [QuasiCompact (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι)] [QuasiSeparated (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι)], (∀ W₀ : W.Opens, IsAffineOpen W₀ → (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀ ≠ ⊥ → ∀ x : Γ(Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme)), (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀), ∃ a b : Γ(W, W₀), ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).app W₀).hom b ≠ 0 ∧ x * ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).app W₀).hom b = ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).app W₀).hom a) → IsIso ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).fromNormalization ∣_ O) :=
by
  intro W O _ hsec _ _ hratio
  classical

  have L1 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], IsIntegrallyClosed R →
      Function.Injective (algebraMap R S) → IsField S →
      (∀ x : S, ∃ a b : R, algebraMap R S b ≠ 0 ∧ x * algebraMap R S b = algebraMap R S a) →
      Function.Bijective (algebraMap R (integralClosure R S)) := by
    intro R S _ _ _ hR hinj hS hrat
    have hnzd : ∀ u v : S, u * v = 0 → v ≠ 0 → u = 0 := by
      intro u v huv hv
      obtain ⟨v', hv'⟩ := hS.mul_inv_cancel hv
      calc u = u * (v * v') := by rw [hv', mul_one]
        _ = (u * v) * v' := by ring
        _ = 0 := by rw [huv, zero_mul]
    haveI : Nontrivial S := hS.nontrivial
    haveI : Nontrivial R := RingHom.domain_nontrivial (algebraMap R S)
    haveI : NoZeroDivisors S := ⟨fun {a b} h => by
      by_cases hb : b = 0
      · exact Or.inr hb
      · exact Or.inl (hnzd a b h hb)⟩
    haveI : NoZeroDivisors R := Function.Injective.noZeroDivisors (algebraMap R S) hinj
      (map_zero _) (map_mul _)
    haveI : IsFractionRing R S := by
      show IsLocalization (nonZeroDivisors R) S
      rw [isLocalization_iff]
      refine ⟨?_, ?_, ?_⟩
      · rintro ⟨y, hy⟩
        have hy0 : algebraMap R S y ≠ 0 :=
          (map_ne_zero_iff _ hinj).mpr (nonZeroDivisors.ne_zero hy)
        obtain ⟨c, hc⟩ := hS.mul_inv_cancel hy0
        exact ⟨⟨_, c, hc, by rw [mul_comm]; exact hc⟩, rfl⟩
      · intro z
        obtain ⟨a, b, hb, hz⟩ := hrat z
        have hb0 : b ≠ 0 := fun h => hb (by rw [h, map_zero])
        exact ⟨(a, ⟨b, mem_nonZeroDivisors_of_ne_zero hb0⟩), hz⟩
      · intro x y hxy
        exact ⟨1, by rw [hinj hxy]⟩
    have hbot : integralClosure R S = ⊥ := IsIntegrallyClosed.integralClosure_eq_bot R S
    refine ⟨?_, ?_⟩
    · intro r r' h
      apply hinj
      have := congrArg Subtype.val h
      exact this
    · intro t
      have ht : t.1 ∈ (⊥ : Subalgebra R S) := by rw [← hbot]; exact t.2
      obtain ⟨r, hr⟩ := Algebra.mem_bot.mp ht
      exact ⟨r, Subtype.ext hr⟩

  have key : ∀ W₀ : W.Opens, IsAffineOpen W₀ → W₀ ≤ O → (W₀ : Set W).Nonempty →
      IsIso ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).fromNormalization.app
        W₀) := by
    intro W₀ hW₀ hle hne
    obtain ⟨w, hw⟩ := hne
    have hwO : w ∈ O := hle hw
    have h1 : (⟨w, hwO⟩ : O.toScheme) ∈ O.ι ⁻¹ᵁ W₀ := by
      show O.ι ⟨w, hwO⟩ ∈ W₀
      simpa using hw
    have hξ : genericPoint O.toScheme ∈ O.ι ⁻¹ᵁ W₀ :=
      ((genericPoint_spec O.toScheme).mem_open_set_iff (O.ι ⁻¹ᵁ W₀).isOpen).mpr
        ⟨_, trivial, h1⟩
    have htop : (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀ = ⊤ := by
      rw [eq_top_iff]
      intro p _
      have hsp : O.toScheme.fromSpecStalk (genericPoint O.toScheme) p ⤳
          genericPoint O.toScheme := by
        have hr : O.toScheme.fromSpecStalk (genericPoint O.toScheme) p ∈
            Set.range (O.toScheme.fromSpecStalk (genericPoint O.toScheme)) := ⟨p, rfl⟩
        rw [Scheme.range_fromSpecStalk] at hr
        exact hr
      have hm := hsp.mem_open (O.ι ⁻¹ᵁ W₀).isOpen hξ
      show (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) p ∈ W₀
      rw [Scheme.Hom.comp_apply]
      exact hm
    have hc : IsLocalRing.closedPoint (O.toScheme.presheaf.stalk (genericPoint O.toScheme)) ∈
        (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀ := by
      rw [htop]; trivial
    have hne' : (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀ ≠ ⊥ := by
      intro h
      have hc' := hc
      rw [h] at hc'
      exact hc'
    have hfield : IsField Γ(Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme)),
        (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀) := by
      rw [htop]
      exact MulEquiv.isField (Field.toIsField _)
        (Scheme.ΓSpecIso (O.toScheme.presheaf.stalk (genericPoint O.toScheme))).commRingCatIsoToRingEquiv.toMulEquiv
    have hιiso : IsIso (O.ι.app W₀) :=
      Scheme.Hom.isIso_app O.ι W₀ (by rw [Scheme.Opens.opensRange_ι]; exact hle)
    have hc0 : IsLocalRing.closedPoint (O.toScheme.presheaf.stalk (genericPoint O.toScheme)) ∈
        O.toScheme.fromSpecStalk (genericPoint O.toScheme) ⁻¹ᵁ (O.ι ⁻¹ᵁ W₀) := hc
    have hρ : Function.Injective ((Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme))).presheaf.map
        (homOfLE (le_top : O.toScheme.fromSpecStalk (genericPoint O.toScheme) ⁻¹ᵁ (O.ι ⁻¹ᵁ W₀) ≤ ⊤)).op).hom := by
      intro a b hab
      apply germ_injective_of_isIntegral
        (Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme)))
        (U := ⊤)
        (IsLocalRing.closedPoint (O.toScheme.presheaf.stalk (genericPoint O.toScheme))) trivial
      have h2 := congrArg (ConcreteCategory.hom
        ((Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme))).presheaf.germ _ _ hc0)) hab
      exact (TopCat.Presheaf.germ_res_apply _ (homOfLE le_top) _ hc0 a).symm.trans
        (h2.trans (TopCat.Presheaf.germ_res_apply _ (homOfLE le_top) _ hc0 b))
    have hε₀ : Function.Injective
        ((O.toScheme.fromSpecStalk (genericPoint O.toScheme)).app (O.ι ⁻¹ᵁ W₀)).hom := by
      rw [Scheme.fromSpecStalk_app hξ]
      simp only [CommRingCat.hom_comp, RingHom.coe_comp]
      exact hρ.comp ((ConcreteCategory.bijective_of_isIso
        (Scheme.ΓSpecIso (O.toScheme.presheaf.stalk (genericPoint O.toScheme))).inv).1.comp
        (germ_injective_of_isIntegral O.toScheme _ hξ))
    have hinj : Function.Injective
        ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).app W₀).hom := by
      rw [Scheme.Hom.comp_app]
      exact hε₀.comp (ConcreteCategory.bijective_of_isIso (O.ι.app W₀)).1
    have hR : IsIntegrallyClosed Γ(W, W₀) := by
      have heq : O.ι ''ᵁ (O.ι ⁻¹ᵁ W₀) = W₀ := by
        rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
        exact inf_eq_right.mpr hle
      have haff : IsAffineOpen (O.ι ⁻¹ᵁ W₀) := by
        rw [← Scheme.Hom.isAffineOpen_iff_of_isOpenImmersion O.ι, heq]; exact hW₀
      haveI := hsec _ haff ⟨⟨_, h1⟩⟩
      exact IsIntegrallyClosed.of_equiv (asIso (O.ι.app W₀)).commRingCatIsoToRingEquiv.symm
    letI : Algebra Γ(W, W₀) Γ(Spec (O.toScheme.presheaf.stalk (genericPoint O.toScheme)),
        (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ⁻¹ᵁ W₀) :=
      ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).app W₀).hom.toAlgebra
    have hbij := L1 _ _ hR hinj hfield (hratio W₀ hW₀ hne')
    rw [Scheme.Hom.fromNormalization_app _ hW₀]
    refine @IsIso.comp_isIso _ _ _ _ _ _ _ ?_ inferInstance
    rw [ConcreteCategory.isIso_iff_bijective]
    exact hbij

  have hcov : ∀ o : O.toScheme, ∃ Wo : W.Opens, IsAffineOpen Wo ∧ o.1 ∈ Wo ∧ Wo ≤ O := by
    intro o
    obtain ⟨Wo, hWo, ho, hsub⟩ := exists_isAffineOpen_mem_and_subset (x := o.1) (U := O) o.2
    exact ⟨Wo, hWo, ho, hsub⟩
  choose Wo hWoa hWom hWole using hcov
  have hmem : ∀ o : O.toScheme, o ∈ O.ι ⁻¹ᵁ Wo o := by
    intro o
    show O.ι o ∈ Wo o
    exact hWom o
  have hV : (⨆ o, O.ι ⁻¹ᵁ Wo o) = ⊤ := by
    rw [eq_top_iff]
    intro o _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨o, hmem o⟩
  refine (IsZariskiLocalAtTarget.iff_of_iSup_eq_top
    (P := MorphismProperty.isomorphisms Scheme) _ hV).mpr ?_
  intro o
  have heq : O.ι ''ᵁ (O.ι ⁻¹ᵁ Wo o) = Wo o := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    exact inf_eq_right.mpr (hWole o)
  refine (MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
    (morphismRestrictRestrict _ O (O.ι ⁻¹ᵁ Wo o) ≪≫ morphismRestrictEq _ heq)).mpr ?_
  exact (isIso_morphismRestrict_iff_isIso_app _ (hWoa o)).mpr
    (key _ (hWoa o) (hWole o) ⟨o.1, hWom o⟩)

theorem fgm_norm_local_finite : ∀ (A : Type u) [CommRing A], (∀ (B : Type u) [CommRing B] [Algebra A B], Algebra.FiniteType A B → ∀ (S : Type u) [CommRing S] [Algebra B S], IsField S → (∀ x : S, ∃ a b : B, algebraMap B S b ≠ 0 ∧ x * algebraMap B S b = algebraMap B S a) → Module.Finite B (integralClosure B S)) → ∀ (W : Scheme.{u}) (q : W ⟶ Spec (.of A)), LocallyOfFiniteType q → ∀ (K : Type u) [Field K] (ε : Spec (.of K) ⟶ W), (∀ W₀ : W.Opens, IsAffineOpen W₀ → ε ⁻¹ᵁ W₀ ≠ ⊥ → ∀ x : Γ(Spec (.of K), ε ⁻¹ᵁ W₀), ∃ a b : Γ(W, W₀), (ε.app W₀).hom b ≠ 0 ∧ x * (ε.app W₀).hom b = (ε.app W₀).hom a) → ∀ w : W, ∃ W₀ : W.Opens, IsAffineOpen W₀ ∧ w ∈ W₀ ∧ (letI : Algebra Γ(W, W₀) Γ(Spec (.of K), ε ⁻¹ᵁ W₀) := (Scheme.Hom.app ε W₀).hom.toAlgebra; Module.Finite Γ(W, W₀) (integralClosure Γ(W, W₀) Γ(Spec (.of K), ε ⁻¹ᵁ W₀))) :=
by
  intro A _ hAlg W q hq K _ ε hRatio w
  obtain ⟨W₀, hW₀, hw, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := w) trivial
  refine ⟨W₀, hW₀, hw, ?_⟩
  letI instBS : Algebra Γ(W, W₀) Γ(Spec (.of K), ε ⁻¹ᵁ W₀) := (Scheme.Hom.app ε W₀).hom.toAlgebra
  show Module.Finite Γ(W, W₀) (integralClosure Γ(W, W₀) Γ(Spec (.of K), ε ⁻¹ᵁ W₀))
  by_cases h0 : ε ⁻¹ᵁ W₀ = ⊥
  · haveI : Subsingleton Γ(Spec (.of K), ε ⁻¹ᵁ W₀) :=
      CommRingCat.subsingleton_of_isTerminal ((Spec (.of K)).sheaf.isTerminalOfEqEmpty h0)
    exact Module.Finite.of_finite
  · have hT : ε ⁻¹ᵁ W₀ = ⊤ := by
      apply TopologicalSpace.Opens.coe_eq_univ.mp
      exact Subsingleton.eq_univ_of_nonempty ((TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp h0)
    have hK : IsField Γ(Spec (.of K), ⊤) :=
      MulEquiv.isField (Field.toIsField K)
        (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv.toMulEquiv
    have hField : IsField Γ(Spec (.of K), ε ⁻¹ᵁ W₀) := hT ▸ hK
    letI instAB : Algebra A Γ(W, W₀) :=
      ((q.appLE ⊤ W₀ le_top).hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom).toAlgebra
    have h1 : RingHom.FiniteType (q.appLE ⊤ W₀ le_top).hom :=
      HasRingHomProperty.appLE @LocallyOfFiniteType q hq ⟨⊤, isAffineOpen_top _⟩ ⟨W₀, hW₀⟩ le_top
    have hsurj : Function.Surjective (Scheme.ΓSpecIso (.of A)).inv.hom :=
      fun x => ⟨(Scheme.ΓSpecIso (.of A)).hom.hom x, by simp⟩
    have h2 : RingHom.FiniteType
        ((q.appLE ⊤ W₀ le_top).hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) :=
      RingHom.FiniteType.comp h1 (RingHom.FiniteType.of_surjective _ hsurj)
    have hFT : Algebra.FiniteType A Γ(W, W₀) := RingHom.finiteType_algebraMap.mp h2
    have hR : ∀ x : Γ(Spec (.of K), ε ⁻¹ᵁ W₀), ∃ a b : Γ(W, W₀),
        algebraMap Γ(W, W₀) Γ(Spec (.of K), ε ⁻¹ᵁ W₀) b ≠ 0 ∧
        x * algebraMap Γ(W, W₀) Γ(Spec (.of K), ε ⁻¹ᵁ W₀) b =
          algebraMap Γ(W, W₀) Γ(Spec (.of K), ε ⁻¹ᵁ W₀) a :=
      hRatio W₀ hW₀ h0
    exact hAlg Γ(W, W₀) hFT Γ(Spec (.of K), ε ⁻¹ᵁ W₀) hField hR

theorem fgm_cln_n2_of_purely_inseparable : (∀ (K M : Type u) [Field K] [Field M] [Algebra K M] [FiniteDimensional K M] [Normal K M] (x : M), (∀ σ : M ≃ₐ[K] M, σ x = x) → IsSeparable K x → x ∈ (algebraMap K M).range) → ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] [IsIntegrallyClosed R], (∀ (L : Type u) [Field L] [Algebra R L] [Algebra (FractionRing R) L] [IsScalarTower R (FractionRing R) L], Module.Finite (FractionRing R) L → IsPurelyInseparable (FractionRing R) L → Module.Finite R (integralClosure R L)) → ∀ (L : Type u) [Field L] [Algebra R L] [Algebra (FractionRing R) L] [IsScalarTower R (FractionRing R) L], Module.Finite (FractionRing R) L → Module.Finite R (integralClosure R L) :=
by
  classical
  intro H8 R _ _ _ _ hPI

  have sAscent : ∀ (D F M : Type u) [CommRing D] [IsDomain D] [IsNoetherianRing D]
      [IsIntegrallyClosed D] [Field F] [Field M] [Algebra R D] [Algebra D F] [IsFractionRing D F]
      [Algebra F M] [Algebra D M] [IsScalarTower D F M] [Algebra R M] [IsScalarTower R D M]
      [FiniteDimensional F M] [Algebra.IsSeparable F M],
      Module.Finite R D → Module.Finite R (integralClosure R M) := by
    intro D F M _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hD
    haveI := hD
    haveI : Module.Finite D (integralClosure D M) :=
      IsIntegralClosure.finite D F M (integralClosure D M)
    haveI : Algebra.IsIntegral R D := Algebra.IsIntegral.of_finite R D
    have hfg : (Subalgebra.toSubmodule (integralClosure D M)).FG :=
      Module.Finite.iff_fg.mp inferInstance
    have heq : (Subalgebra.toSubmodule (integralClosure D M)).restrictScalars R =
        Subalgebra.toSubmodule (integralClosure R M) := by
      ext x
      simp only [Submodule.restrictScalars_mem, Subalgebra.mem_toSubmodule,
        mem_integralClosure_iff]
      exact ⟨fun hx => isIntegral_trans x hx, fun hx => hx.tower_top⟩
    have hfgR : (Subalgebra.toSubmodule (integralClosure R M)).FG := by
      rw [← heq]
      exact Submodule.FG.restrictScalars hfg
    exact Module.Finite.iff_fg.mpr hfgR

  have hNormal : ∀ (M : Type u) [Field M] [Algebra R M] [Algebra (FractionRing R) M]
      [IsScalarTower R (FractionRing R) M] [FiniteDimensional (FractionRing R) M]
      [Normal (FractionRing R) M], Module.Finite R (integralClosure R M) := by
    intro M _ _ _ _ _ _
    let F : IntermediateField (FractionRing R) M :=
      IntermediateField.fixedField (⊤ : Subgroup (M ≃ₐ[FractionRing R] M))
    have hPIF : IsPurelyInseparable (FractionRing R) F := by
      rw [isPurelyInseparable_iff]
      intro x
      refine ⟨Algebra.IsIntegral.isIntegral x, fun hsep => ?_⟩
      have hsepM : IsSeparable (FractionRing R) (x : M) := by
        unfold IsSeparable at hsep ⊢
        rwa [IntermediateField.minpoly_eq] at hsep
      have hfix : ∀ σ : M ≃ₐ[FractionRing R] M, σ x = x := fun σ =>
        (IntermediateField.mem_fixedField_iff _ _).mp x.2 σ (Subgroup.mem_top σ)
      obtain ⟨k, hk⟩ := H8 (FractionRing R) M (x : M) hfix hsepM
      exact ⟨k, Subtype.ext (by rw [IntermediateField.coe_algebraMap_apply]; exact hk)⟩
    have hDfin : Module.Finite R (integralClosure R F) := hPI F inferInstance hPIF
    haveI : IsNoetherianRing (integralClosure R F) :=
      IsNoetherianRing.of_finite R (integralClosure R F)
    haveI : IsIntegrallyClosed (integralClosure R F) :=
      integralClosure.isIntegrallyClosedOfFiniteExtension (R := R) (FractionRing R) (L := F)
    haveI : IsFractionRing (integralClosure R F) F :=
      integralClosure.isFractionRing_of_finite_extension (FractionRing R) F
    haveI : Algebra.IsSeparable F M :=
      FixedPoints.isSeparable (↥(⊤ : Subgroup (M ≃ₐ[FractionRing R] M))) M
    haveI : IsScalarTower (integralClosure R F) F M := inferInstance
    haveI : IsScalarTower R (integralClosure R F) M := by
      apply IsScalarTower.of_algebraMap_eq
      intro r
      rw [IsScalarTower.algebraMap_apply (integralClosure R F) F M]
      rw [IsScalarTower.algebraMap_apply R (FractionRing R) M]
      rw [← IsScalarTower.algebraMap_apply R (integralClosure R F) F,
        IsScalarTower.algebraMap_apply R (FractionRing R) F,
        ← IsScalarTower.algebraMap_apply (FractionRing R) F M]
    exact sAscent (integralClosure R F) F M hDfin
  intro L _ _ _ _ hL
  haveI := hL

  have hred : ∀ (M : Type u) [Field M] [Algebra (FractionRing R) M]
      [FiniteDimensional (FractionRing R) M] [Normal (FractionRing R) M],
      Nonempty (L →ₐ[FractionRing R] M) → Module.Finite R (integralClosure R L) := by
    intro M _ _ _ _ ⟨f⟩
    letI : Algebra R M := ((algebraMap (FractionRing R) M).comp (algebraMap R (FractionRing R))).toAlgebra
    haveI : IsScalarTower R (FractionRing R) M := IsScalarTower.of_algebraMap_eq' rfl
    haveI hM : Module.Finite R (integralClosure R M) := hNormal M
    let f' : L →ₐ[R] M := f.restrictScalars R
    have hf' : Function.Injective f' := f.toRingHom.injective
    let g : integralClosure R L →ₐ[R] integralClosure R M :=
      (f'.comp (integralClosure R L).val).codRestrict (integralClosure R M)
        (fun x => x.2.map f')
    have hg : Function.Injective g := by
      intro x y hxy
      apply Subtype.ext
      apply hf'
      have := congrArg Subtype.val hxy
      exact this
    exact Module.Finite.of_injective g.toLinearMap hg
  exact hred (IntermediateField.normalClosure (FractionRing R) L (AlgebraicClosure L))
    ⟨IsScalarTower.toAlgHom (FractionRing R) L _⟩

theorem fgm_cln_frobenius_subring_finite : ∀ (p e : ℕ) (R' : Type u) [CommRing R'] [IsDomain R'] [IsNoetherianRing R'] [ExpChar R' p], p.Prime → (∀ (L : Type u) [Field L] [Algebra R' L] [Algebra (FractionRing R') L] [IsScalarTower R' (FractionRing R') L], Module.Finite (FractionRing R') L → IsPurelyInseparable (FractionRing R') L → Module.Finite R' (integralClosure R' L)) → ∀ (T : Subring R') (d : ℕ), (∀ r : R', r ^ (p ^ e) ∈ T) → (∀ (m : ℕ) (t : Fin m → R'), (∀ i, t i ∈ T) → (∀ c : Fin m → R', ∑ i, c i ^ (p ^ e) * t i = 0 → ∀ i, c i = 0) → m ≤ d) → ∃ s : Finset R', (∀ j ∈ s, j ∈ T) ∧ ∀ t ∈ T, ∃ c : R' → R', t = ∑ j ∈ s, c j ^ (p ^ e) * j :=
by
  intro p e R' _ _ _ _ hp hPI T d _ hd
  classical
  have hq0 : p ^ e ≠ 0 := pow_ne_zero _ hp.ne_zero
  have hqpos : 0 < p ^ e := Nat.pos_of_ne_zero hq0

  obtain ⟨m, tf, -, hrel⟩ : ∃ (m : ℕ) (tf : Fin m → R'), (∀ i, tf i ∈ T) ∧
      ∀ t ∈ T, ∃ c₀ : R', c₀ ≠ 0 ∧ ∃ c : Fin m → R',
        c₀ ^ (p ^ e) * t + ∑ i, c i ^ (p ^ e) * tf i = 0 := by
    let P : ℕ → Prop := fun m => ∃ tf : Fin m → R', (∀ i, tf i ∈ T) ∧
      ∀ c : Fin m → R', ∑ i, c i ^ (p ^ e) * tf i = 0 → ∀ i, c i = 0
    have hP0 : P 0 := ⟨Fin.elim0, fun i => i.elim0, fun _ _ i => i.elim0⟩
    obtain ⟨tf, htfT, hind⟩ := Nat.findGreatest_spec (P := P) (Nat.zero_le d) hP0
    refine ⟨_, tf, htfT, ?_⟩
    intro t ht
    have hmem : ∀ i, (Fin.cons t tf : Fin (Nat.findGreatest P d + 1) → R') i ∈ T := by
      intro i
      cases i using Fin.cases with
      | zero => simpa using ht
      | succ j => simpa using htfT j
    have hnot : ¬ ∀ c : Fin (Nat.findGreatest P d + 1) → R',
        ∑ i, c i ^ (p ^ e) * (Fin.cons t tf : Fin (Nat.findGreatest P d + 1) → R') i = 0 →
          ∀ i, c i = 0 := by
      intro hind'
      have hle := hd _ _ hmem hind'
      exact Nat.findGreatest_is_greatest (Nat.lt_succ_self _) hle ⟨_, hmem, hind'⟩
    push_neg at hnot
    obtain ⟨c, hc, i, hi⟩ := hnot
    rw [Fin.sum_univ_succ] at hc
    simp only [Fin.cons_zero, Fin.cons_succ] at hc
    refine ⟨c 0, ?_, fun i => c i.succ, hc⟩
    intro h0
    rw [h0, zero_pow hq0, zero_mul, zero_add] at hc
    have hall := hind _ hc
    apply hi
    cases i using Fin.cases with
    | zero => exact h0
    | succ j => exact hall j

  haveI : ExpChar (FractionRing R') p :=
    expChar_of_injective_algebraMap (IsFractionRing.injective R' (FractionRing R')) p
  haveI : ExpChar (AlgebraicClosure (FractionRing R')) p :=
    expChar_of_injective_algebraMap
      (algebraMap (FractionRing R') (AlgebraicClosure (FractionRing R'))).injective p
  have hφinj : Function.Injective (algebraMap R' (AlgebraicClosure (FractionRing R'))) := by
    rw [IsScalarTower.algebraMap_eq R' (FractionRing R') (AlgebraicClosure (FractionRing R'))]
    exact (algebraMap (FractionRing R') (AlgebraicClosure (FractionRing R'))).injective.comp
      (IsFractionRing.injective R' (FractionRing R'))
  choose y hy using fun r : R' =>
    IsAlgClosed.exists_pow_nat_eq (algebraMap R' (AlgebraicClosure (FractionRing R')) r) hqpos
  have frob : ∀ x : AlgebraicClosure (FractionRing R'),
      x ^ (p ^ e) = iterateFrobenius (AlgebraicClosure (FractionRing R')) p e x :=
    fun x => (iterateFrobenius_def p e x).symm
  let S : Set (AlgebraicClosure (FractionRing R')) := Set.range (fun i => y (tf i))
  let L := IntermediateField.adjoin (FractionRing R') S
  have hint : ∀ x ∈ S, _root_.IsIntegral (FractionRing R') x := by
    rintro x ⟨i, rfl⟩
    refine ⟨Polynomial.X ^ (p ^ e) - Polynomial.C (algebraMap R' (FractionRing R') (tf i)),
      Polynomial.monic_X_pow_sub_C _ hq0, ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hy,
      ← IsScalarTower.algebraMap_apply, sub_self]
  haveI hfin : FiniteDimensional (FractionRing R') L :=
    IntermediateField.finiteDimensional_adjoin hint
  haveI hpi : IsPurelyInseparable (FractionRing R') L := by
    rw [IntermediateField.isPurelyInseparable_adjoin_iff_pow_mem (FractionRing R')
      (AlgebraicClosure (FractionRing R')) p]
    rintro x ⟨i, rfl⟩
    refine ⟨e, algebraMap R' (FractionRing R') (tf i), ?_⟩
    rw [hy, ← IsScalarTower.algebraMap_apply]
  have hφL : ∀ r : R', algebraMap R' (AlgebraicClosure (FractionRing R')) r ∈ L := fun r => by
    rw [IsScalarTower.algebraMap_apply R' (FractionRing R') (AlgebraicClosure (FractionRing R'))]
    exact IntermediateField.algebraMap_mem L _
  have hmemL : ∀ t ∈ T, y t ∈ L := by
    intro t ht
    obtain ⟨c₀, hc₀, c, hc⟩ := hrel t ht
    have h1 : (algebraMap R' (AlgebraicClosure (FractionRing R')) c₀ * y t +
        ∑ i, algebraMap R' (AlgebraicClosure (FractionRing R')) (c i) * y (tf i)) ^ (p ^ e) =
        algebraMap R' (AlgebraicClosure (FractionRing R'))
          (c₀ ^ (p ^ e) * t + ∑ i, c i ^ (p ^ e) * tf i) := by
      rw [frob, map_add, map_sum, map_mul]
      simp only [map_mul, ← frob, hy, map_add, map_sum, map_pow, mul_pow]
    rw [hc, map_zero, pow_eq_zero_iff hq0] at h1
    have hc0' : algebraMap R' (AlgebraicClosure (FractionRing R')) c₀ ≠ 0 := by
      rwa [map_ne_zero_iff _ hφinj]
    have hyt : y t = (algebraMap R' (AlgebraicClosure (FractionRing R')) c₀)⁻¹ *
        (-∑ i, algebraMap R' (AlgebraicClosure (FractionRing R')) (c i) * y (tf i)) := by
      rw [eq_inv_mul_iff_mul_eq₀ hc0', ← add_eq_zero_iff_eq_neg]
      exact h1
    rw [hyt]
    exact L.mul_mem (L.inv_mem (hφL c₀)) (L.neg_mem (L.sum_mem fun i _ =>
      L.mul_mem (hφL _) (IntermediateField.subset_adjoin (FractionRing R') S ⟨i, rfl⟩)))

  have hI : Module.Finite R' (integralClosure R' L) := hPI L hfin hpi
  let ι : integralClosure R' L →ₗ[R'] AlgebraicClosure (FractionRing R') :=
    ((L.val.restrictScalars R').comp (integralClosure R' L).val).toLinearMap
  have hN : (Submodule.map ι ⊤).FG := Submodule.FG.map ι Module.Finite.fg_top
  have hsub : y '' (T : Set R') ⊆ Submodule.map ι ⊤ := by
    rintro _ ⟨t, ht, rfl⟩
    have hw : _root_.IsIntegral R' (⟨y t, hmemL t ht⟩ : L) := by
      refine ⟨Polynomial.X ^ (p ^ e) - Polynomial.C t, Polynomial.monic_X_pow_sub_C _ hq0, ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero]
      apply Subtype.ext
      exact hy t
    exact ⟨⟨_, hw⟩, Submodule.mem_top, rfl⟩
  have hfg : (Submodule.span R' (y '' (T : Set R'))).FG :=
    Submodule.FG.of_le hN (Submodule.span_le.mpr hsub)
  obtain ⟨s', hs'sub, hs'span⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp hfg
  obtain ⟨s, hsT, rfl⟩ := Finset.subset_set_image_iff.mp hs'sub
  refine ⟨s, fun j hj => hsT hj, ?_⟩
  intro t ht
  have hyt : y t ∈ Submodule.span R' (y '' (s : Set R')) := by
    rw [← Finset.coe_image, ← hs'span]
    exact Submodule.subset_span ⟨t, ht, rfl⟩
  obtain ⟨l, hl, hlt⟩ := (Finsupp.mem_span_image_iff_linearCombination R').mp hyt
  have hsupp : l.support ⊆ s := Finset.coe_subset.mp ((Finsupp.mem_supported R' l).mp hl)
  rw [Finsupp.linearCombination_apply,
    Finsupp.sum_of_support_subset l hsupp (fun i a => a • y i) (fun i _ => zero_smul _ _)] at hlt
  refine ⟨⇑l, hφinj ?_⟩
  rw [← hy t, ← hlt, frob, map_sum, map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Algebra.smul_def, map_mul, ← frob, ← frob, hy j, map_mul, map_pow]

theorem fgm_cln_tate_descent : (∀ (A : Type u) [CommRing A] (I : Ideal A), IsAdicComplete I A → ∀ (M : Type u) [AddCommGroup M] [Module A M], IsHausdorff I M → ∀ (T : Finset M), Submodule.span A (T : Set M) ⊔ I • (⊤ : Submodule A M) = ⊤ → Submodule.span A (T : Set M) = ⊤) → ∀ (p e : ℕ) (R R' : Type u) [CommRing R] [IsDomain R] [ExpChar R p] [CommRing R'] [IsDomain R'] (x : R) (ψ : R →+* R'), p.Prime → Function.Surjective ψ → RingHom.ker ψ = Ideal.span {x} → IsAdicComplete (Ideal.span {x}) R → (∀ (T : Subring R') (d : ℕ), (∀ r : R', r ^ (p ^ e) ∈ T) → (∀ (m : ℕ) (t : Fin m → R'), (∀ i, t i ∈ T) → (∀ c : Fin m → R', ∑ i, c i ^ (p ^ e) * t i = 0 → ∀ i, c i = 0) → m ≤ d) → ∃ s : Finset R', (∀ j ∈ s, j ∈ T) ∧ ∀ t ∈ T, ∃ c : R' → R', t = ∑ j ∈ s, c j ^ (p ^ e) * j) → ∀ (T : Subring R) (d : ℕ), (∀ r : R, r ^ (p ^ e) ∈ T) → x ∈ T → (∀ r : R, x * r ∈ T → r ∈ T) → (∀ (m : ℕ) (t : Fin m → R), (∀ i, t i ∈ T) → (∀ c : Fin m → R, ∑ i, c i ^ (p ^ e) * t i = 0 → ∀ i, c i = 0) → m ≤ d) → ∃ s : Finset R, (∀ j ∈ s, j ∈ T) ∧ ∀ t ∈ T, ∃ c : R → R, t = ∑ j ∈ s, c j ^ (p ^ e) * j :=
by
  intro NAK p e R R' _ _ _ _ _ x ψ hp hsurj hker hcomp hFF T d hTq hxT hsat hrank
  classical
  have hq : p ^ e ≠ 0 := pow_ne_zero e hp.ne_zero
  have hH : IsHausdorff (Ideal.span {x}) R := hcomp.toIsHausdorff

  have hSep : ∀ y : R, (∀ N : ℕ, x ^ N ∣ y) → y = 0 := by
    intro y hy
    apply hH.haus y
    intro N
    obtain ⟨z, hz⟩ := hy N
    rw [SModEq.sub_mem, sub_zero, hz]
    have h1 : x ^ N • z ∈ (Ideal.span {x}) ^ N • (⊤ : Submodule R R) :=
      Submodule.smul_mem_smul (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self x) N) trivial
    simpa [smul_eq_mul] using h1

  have hlift : ∀ (m : ℕ) (t : Fin m → R),
      (∀ c : Fin m → R', ∑ i, c i ^ (p ^ e) * ψ (t i) = 0 → ∀ i, c i = 0) →
      ∀ c : Fin m → R, ∑ i, c i ^ (p ^ e) * t i = 0 → ∀ i, c i = 0 := by
    intro m t hind c hc
    have hψ0 : ∀ c : Fin m → R, ∑ i, c i ^ (p ^ e) * t i = 0 → ∀ i, x ∣ c i := by
      intro c hc i
      have h1 : ∑ i, ψ (c i) ^ (p ^ e) * ψ (t i) = 0 := by
        have h2 := congrArg ψ hc
        simpa [map_sum, map_mul, map_pow] using h2
      have h2 := hind (fun i => ψ (c i)) h1 i
      have h3 : c i ∈ RingHom.ker ψ := h2
      rw [hker, Ideal.mem_span_singleton] at h3
      exact h3
    have hall : ∀ n : ℕ, ∀ i, x ^ n ∣ c i := by
      intro n
      induction n with
      | zero => intro i; simp
      | succ n ih =>
        by_cases hx : x = 0
        · intro i
          have h4 := hψ0 c hc i
          rw [hx, zero_dvd_iff] at h4
          rw [h4]; exact dvd_zero _
        · have ih' : ∀ i, ∃ w, c i = x ^ n * w := fun i => ih i
          choose c' hc' using ih'
          have hsum : x ^ (n * p ^ e) * ∑ i, c' i ^ (p ^ e) * t i = 0 := by
            have h5 : x ^ (n * p ^ e) * ∑ i, c' i ^ (p ^ e) * t i
                = ∑ i, c i ^ (p ^ e) * t i := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun i _ => ?_)
              rw [hc' i, mul_pow, pow_mul]; ring
            rw [h5, hc]
          have hsum' : ∑ i, c' i ^ (p ^ e) * t i = 0 :=
            (mul_eq_zero.mp hsum).resolve_left (pow_ne_zero _ hx)
          intro i
          obtain ⟨w, hw⟩ := hψ0 c' hsum' i
          exact ⟨w, by rw [hc' i, hw, pow_succ]; ring⟩
    intro i
    exact hSep (c i) (fun N => hall N i)

  have hT'q : ∀ r : R', r ^ (p ^ e) ∈ T.map ψ := by
    intro r
    obtain ⟨r0, rfl⟩ := hsurj r
    exact Subring.mem_map.2 ⟨r0 ^ (p ^ e), hTq r0, by rw [map_pow]⟩
  have hT'rank : ∀ (m : ℕ) (t : Fin m → R'), (∀ i, t i ∈ T.map ψ) →
      (∀ c : Fin m → R', ∑ i, c i ^ (p ^ e) * t i = 0 → ∀ i, c i = 0) → m ≤ d := by
    intro m t ht hind
    choose tt htt using fun i => Subring.mem_map.1 (ht i)
    have e1 : ∀ i, ψ (tt i) = t i := fun i => (htt i).2
    apply hrank m tt (fun i => (htt i).1)
    apply hlift m tt
    intro c hc
    apply hind c
    simpa only [e1] using hc
  obtain ⟨s', hs'T, hs'span⟩ := hFF (T.map ψ) d hT'q hT'rank
  have hg : ∀ j : R', ∃ g : R, g ∈ T ∧ (j ∈ T.map ψ → ψ g = j) := by
    intro j
    by_cases hj : j ∈ T.map ψ
    · obtain ⟨g, hgT, hgj⟩ := Subring.mem_map.1 hj
      exact ⟨g, hgT, fun _ => hgj⟩
    · exact ⟨0, T.zero_mem, fun h => absurd h hj⟩
  choose g hgT hgψ using hg

  have hstep : ∀ t ∈ T, ∃ b : R' → R, ∃ r ∈ T,
      t = ∑ j ∈ s', b j ^ (p ^ e) * g j + x * r := by
    intro t ht
    obtain ⟨c', hc'⟩ := hs'span (ψ t) (Subring.mem_map.2 ⟨t, ht, rfl⟩)
    choose b hbψ using fun j => hsurj (c' j)
    have hu : t - ∑ j ∈ s', b j ^ (p ^ e) * g j ∈ RingHom.ker ψ := by
      rw [RingHom.mem_ker, map_sub, map_sum, hc', sub_eq_zero]
      refine Finset.sum_congr rfl (fun j hj => ?_)
      rw [map_mul, map_pow, hbψ, hgψ j (hs'T j hj)]
    rw [hker, Ideal.mem_span_singleton'] at hu
    obtain ⟨a, ha⟩ := hu
    have haT : a ∈ T := by
      apply hsat
      rw [mul_comm x a, ha]
      exact T.sub_mem ht (T.sum_mem (fun j _ => T.mul_mem (hTq _) (hgT j)))
    exact ⟨b, a, haT, by rw [mul_comm x a, ha]; ring⟩

  have hit : ∀ k : ℕ, ∀ t ∈ T, ∃ c : R' → ℕ → R, ∃ r ∈ T,
      t = ∑ j ∈ s', ∑ l ∈ Finset.range k, c j l ^ (p ^ e) * (x ^ l * g j) + x ^ k * r := by
    intro k
    induction k with
    | zero => intro t ht; exact ⟨fun _ _ => 0, t, ht, by simp⟩
    | succ k ih =>
      intro t ht
      obtain ⟨c, r, hr, htr⟩ := ih t ht
      obtain ⟨b, r', hr', hrr⟩ := hstep r hr
      refine ⟨fun j l => if l = k then b j else c j l, r', hr', ?_⟩
      beta_reduce
      have e1 : ∀ j, ∑ l ∈ Finset.range (k + 1),
          (if l = k then b j else c j l) ^ (p ^ e) * (x ^ l * g j)
          = ∑ l ∈ Finset.range k, c j l ^ (p ^ e) * (x ^ l * g j)
            + b j ^ (p ^ e) * (x ^ k * g j) := by
        intro j
        rw [Finset.sum_range_succ, if_pos rfl]
        congr 1
        refine Finset.sum_congr rfl (fun l hl => ?_)
        rw [if_neg (Finset.mem_range.mp hl).ne]
      have e2 : x ^ k * ∑ j ∈ s', b j ^ (p ^ e) * g j
          = ∑ j ∈ s', b j ^ (p ^ e) * (x ^ k * g j) := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun j _ => by ring)
      rw [htr, hrr, Finset.sum_congr rfl (fun j _ => e1 j), Finset.sum_add_distrib, mul_add, e2,
        pow_succ]
      ring

  let Fr : R →+* T := (iterateFrobenius R p e).codRestrict T
    (fun r => by rw [iterateFrobenius_def]; exact hTq r)
  letI : Module R T := Fr.toModule
  have hsmul : ∀ (r : R) (m : T), ((r • m : T) : R) = r ^ (p ^ e) * (m : R) := by
    intro r m
    rfl
  have hdivI : ∀ n : ℕ, ∀ y ∈ (Ideal.span {x}) ^ n • (⊤ : Submodule R T), x ^ n ∣ (y : R) := by
    intro n y hy
    refine Submodule.smul_induction_on (p := fun y : T => x ^ n ∣ (y : R)) hy ?_ ?_
    · intro a ha z _
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at ha
      show x ^ n ∣ ((a • z : T) : R)
      rw [hsmul]
      exact Dvd.dvd.mul_right (ha.trans (dvd_pow_self a hq)) _
    · intro y z hy hz
      show x ^ n ∣ ((y : R) + (z : R))
      exact dvd_add hy hz
  have hMH : IsHausdorff (Ideal.span {x}) T := by
    refine ⟨fun m hm => ?_⟩
    apply Subtype.ext
    show (m : R) = 0
    apply hSep
    intro N
    have h1 := hm N
    rw [SModEq.sub_mem, sub_zero] at h1
    exact hdivI N _ h1
  let G : R' × ℕ → T := fun jl => ⟨x ^ jl.2 * g jl.1, T.mul_mem (T.pow_mem hxT _) (hgT _)⟩
  let T₀ : Finset T := (s' ×ˢ Finset.range (p ^ e)).image G
  have hspan : Submodule.span R (T₀ : Set T) ⊔ (Ideal.span {x}) • (⊤ : Submodule R T) = ⊤ := by
    rw [eq_top_iff]
    rintro m -
    obtain ⟨c, r, hr, hmr⟩ := hit (p ^ e) m m.2
    have hm : m = (∑ jl ∈ s' ×ˢ Finset.range (p ^ e), c jl.1 jl.2 • G jl)
        + x • (⟨r, hr⟩ : T) := by
      apply Subtype.ext
      rw [hmr, AddMemClass.coe_add, AddSubmonoidClass.coe_finset_sum, Finset.sum_product]
      simp [hsmul, G]
    rw [hm]
    apply Submodule.add_mem_sup
    · apply Submodule.sum_mem
      intro jl hjl
      apply Submodule.smul_mem
      apply Submodule.subset_span
      exact Finset.mem_coe.2 (Finset.mem_image_of_mem G hjl)
    · exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self x) trivial
  have hNAK := NAK R (Ideal.span {x}) hcomp T hMH T₀ hspan
  refine ⟨T₀.map (Function.Embedding.subtype _), ?_, ?_⟩
  · intro j hj
    obtain ⟨a, _, rfl⟩ := Finset.mem_map.1 hj
    exact a.2
  · intro t ht
    have hmem : (⟨t, ht⟩ : T) ∈ Submodule.span R (T₀ : Set T) := by rw [hNAK]; trivial
    obtain ⟨f, -, hf⟩ := (Submodule.mem_span_finset).1 hmem
    refine ⟨fun j => if h : j ∈ T then f ⟨j, h⟩ else 0, ?_⟩
    rw [Finset.sum_map]
    have h1 : t = ((∑ a ∈ T₀, f a • a : T) : R) := by rw [hf]
    rw [h1, AddSubmonoidClass.coe_finset_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hsmul]
    simp [a.2]

theorem fgm_cln_tate_char_p : ((∀ (A : Type u) [CommRing A] (I : Ideal A), IsAdicComplete I A → ∀ (M : Type u) [AddCommGroup M] [Module A M], IsHausdorff I M → ∀ (T : Finset M), Submodule.span A (T : Set M) ⊔ I • (⊤ : Submodule A M) = ⊤ → Submodule.span A (T : Set M) = ⊤) → ∀ (p e : ℕ) (R R' : Type u) [CommRing R] [IsDomain R] [ExpChar R p] [CommRing R'] [IsDomain R'] (x : R) (ψ : R →+* R'), p.Prime → Function.Surjective ψ → RingHom.ker ψ = Ideal.span {x} → IsAdicComplete (Ideal.span {x}) R → (∀ (T : Subring R') (d : ℕ), (∀ r : R', r ^ (p ^ e) ∈ T) → (∀ (m : ℕ) (t : Fin m → R'), (∀ i, t i ∈ T) → (∀ c : Fin m → R', ∑ i, c i ^ (p ^ e) * t i = 0 → ∀ i, c i = 0) → m ≤ d) → ∃ s : Finset R', (∀ j ∈ s, j ∈ T) ∧ ∀ t ∈ T, ∃ c : R' → R', t = ∑ j ∈ s, c j ^ (p ^ e) * j) → ∀ (T : Subring R) (d : ℕ), (∀ r : R, r ^ (p ^ e) ∈ T) → x ∈ T → (∀ r : R, x * r ∈ T → r ∈ T) → (∀ (m : ℕ) (t : Fin m → R), (∀ i, t i ∈ T) → (∀ c : Fin m → R, ∑ i, c i ^ (p ^ e) * t i = 0 → ∀ i, c i = 0) → m ≤ d) → ∃ s : Finset R, (∀ j ∈ s, j ∈ T) ∧ ∀ t ∈ T, ∃ c : R → R, t = ∑ j ∈ s, c j ^ (p ^ e) * j) → (∀ (A : Type u) [CommRing A] (I : Ideal A), IsAdicComplete I A → ∀ (M : Type u) [AddCommGroup M] [Module A M], IsHausdorff I M → ∀ (T : Finset M), Submodule.span A (T : Set M) ⊔ I • (⊤ : Submodule A M) = ⊤ → Submodule.span A (T : Set M) = ⊤) → ∀ (p : ℕ) (R R' : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] [IsIntegrallyClosed R] [ExpChar R p] [CommRing R'] [IsDomain R'] (x : R) (ψ : R →+* R'), p.Prime → x ≠ 0 → Function.Surjective ψ → RingHom.ker ψ = Ideal.span {x} → IsAdicComplete (Ideal.span {x}) R → (∀ (e : ℕ), ∀ (T : Subring R') (d : ℕ), (∀ r : R', r ^ (p ^ e) ∈ T) → (∀ (m : ℕ) (t : Fin m → R'), (∀ i, t i ∈ T) → (∀ c : Fin m → R', ∑ i, c i ^ (p ^ e) * t i = 0 → ∀ i, c i = 0) → m ≤ d) → ∃ s : Finset R', (∀ j ∈ s, j ∈ T) ∧ ∀ t ∈ T, ∃ c : R' → R', t = ∑ j ∈ s, c j ^ (p ^ e) * j) → ∀ (L : Type u) [Field L] [Algebra R L] [Algebra (FractionRing R) L] [IsScalarTower R (FractionRing R) L], Module.Finite (FractionRing R) L → IsPurelyInseparable (FractionRing R) L → Module.Finite R (integralClosure R L) :=
by
  intro TD NAK p R R' _ _ _ _ _ _ _ x ψ hp hx0 hsurj hker hcomp hFF L _ _ _ _ hLfin hPI
  classical

  have enlarge : ∀ (e : ℕ) (L : Type u) [Field L] [Algebra R L] [Algebra (FractionRing R) L]
      [IsScalarTower R (FractionRing R) L], Module.Finite (FractionRing R) L →
      (∀ a : L, a ^ (p ^ e) ∈ (algebraMap (FractionRing R) L).range) →
      ∃ (L₁ : Type u) (_ : Field L₁) (_ : Algebra R L₁) (_ : Algebra (FractionRing R) L₁)
        (_ : IsScalarTower R (FractionRing R) L₁), Module.Finite (FractionRing R) L₁ ∧
        (∀ a : L₁, a ^ (p ^ e) ∈ (algebraMap (FractionRing R) L₁).range) ∧
        (∃ y : L₁, y ^ (p ^ e) = algebraMap R L₁ x) ∧ Nonempty (L →ₐ[R] L₁) := by
    intro e L _ _ _ _ hfin hexp
    have hq : 0 < p ^ e := pow_pos hp.pos e
    have hinj : Function.Injective (algebraMap R L) := by
      rw [IsScalarTower.algebraMap_eq R (FractionRing R) L]
      exact (algebraMap (FractionRing R) L).injective.comp
        (IsFractionRing.injective R (FractionRing R))
    haveI : ExpChar L p := expChar_of_injective_algebraMap hinj p
    haveI : ExpChar (AlgebraicClosure L) p :=
      expChar_of_injective_algebraMap (algebraMap L (AlgebraicClosure L)).injective p
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_pow_nat_eq
      (algebraMap L (AlgebraicClosure L) (algebraMap R L x)) hq
    have hyR : y ^ (p ^ e) = algebraMap R (AlgebraicClosure L) x := by
      rw [hy, ← IsScalarTower.algebraMap_apply]
    have hyK : y ^ (p ^ e) = algebraMap (FractionRing R) (AlgebraicClosure L)
        (algebraMap R (FractionRing R) x) := by
      rw [hyR, ← IsScalarTower.algebraMap_apply]
    have hyint : _root_.IsIntegral L y := by
      refine ⟨Polynomial.X ^ (p ^ e) - Polynomial.C (algebraMap R L x),
        Polynomial.monic_X_pow_sub_C _ hq.ne', ?_⟩
      simp [Polynomial.eval₂_sub, hy]
    let L₁ := IntermediateField.adjoin L ({y} : Set (AlgebraicClosure L))
    have htower : IsScalarTower R (FractionRing R) L₁ :=
      IsScalarTower.of_algebraMap_eq (fun r => Subtype.ext
        (IsScalarTower.algebraMap_apply R (FractionRing R) (AlgebraicClosure L) r))
    haveI : FiniteDimensional L L₁ := IntermediateField.adjoin.finiteDimensional hyint
    let E : Subfield (AlgebraicClosure L) :=
      Subfield.comap (iterateFrobenius (AlgebraicClosure L) p e)
        (algebraMap (FractionRing R) (AlgebraicClosure L)).fieldRange
    have hE : ∀ z, z ∈ E ↔
        ∃ k, algebraMap (FractionRing R) (AlgebraicClosure L) k = z ^ (p ^ e) := by
      intro z
      simp only [E, Subfield.mem_comap, RingHom.mem_fieldRange, iterateFrobenius_def]
    have hLE : ∀ b : L, algebraMap L (AlgebraicClosure L) b ∈ E := by
      intro b
      rw [hE]
      obtain ⟨k, hk⟩ := hexp b
      refine ⟨k, ?_⟩
      rw [IsScalarTower.algebraMap_apply (FractionRing R) L (AlgebraicClosure L), hk, map_pow]
    let E' : IntermediateField L (AlgebraicClosure L) := E.toIntermediateField hLE
    have hle : L₁ ≤ E' := by
      rw [IntermediateField.adjoin_simple_le_iff]
      show y ∈ E
      rw [hE]
      exact ⟨_, hyK.symm⟩
    refine ⟨L₁, inferInstance, inferInstance, inferInstance, htower, ?_, ?_, ?_, ?_⟩
    · exact Module.Finite.trans L L₁
    · intro a
      have ha : (a : AlgebraicClosure L) ∈ E := hle a.2
      rw [hE] at ha
      obtain ⟨k, hk⟩ := ha
      exact ⟨k, Subtype.ext hk⟩
    · refine ⟨⟨y, IntermediateField.mem_adjoin_simple_self L y⟩, Subtype.ext ?_⟩
      exact hyR
    · exact ⟨{ (algebraMap L L₁) with
        commutes' := fun r => Subtype.ext
          (IsScalarTower.algebraMap_apply R L (AlgebraicClosure L) r).symm }⟩

  have descend : ∀ (L L₁ : Type u) [Field L] [Field L₁] [Algebra R L] [Algebra R L₁],
      (L →ₐ[R] L₁) → Module.Finite R (integralClosure R L₁) →
      Module.Finite R (integralClosure R L) := by
    intro L L₁ _ _ _ _ f h
    let g := f.mapIntegralClosure
    have hinj : Function.Injective g.toLinearMap := by
      intro a b hab
      apply Subtype.ext
      apply f.toRingHom.injective
      exact congrArg Subtype.val hab
    haveI : IsNoetherian R (integralClosure R L₁) :=
      isNoetherian_of_isNoetherianRing_of_finite R _
    exact Module.Finite.of_injective g.toLinearMap hinj

  have frob : ∀ (e : ℕ) (L : Type u) [Field L] [Algebra R L] [Algebra (FractionRing R) L]
      [IsScalarTower R (FractionRing R) L],
      (∀ a : L, a ^ (p ^ e) ∈ (algebraMap (FractionRing R) L).range) →
      ∀ σ ∈ integralClosure R L, ∃ r : R, algebraMap R L r = σ ^ (p ^ e) := by
    intro e L _ _ _ _ hexp σ hσ
    obtain ⟨k, hk⟩ := hexp σ
    have h1 : _root_.IsIntegral R (σ ^ (p ^ e)) := (show _root_.IsIntegral R σ from hσ).pow _
    rw [← hk] at h1
    have h1' : _root_.IsIntegral R ((IsScalarTower.toAlgHom R (FractionRing R) L) k) := h1
    have h2 : _root_.IsIntegral R k :=
      (isIntegral_algHom_iff _ (algebraMap (FractionRing R) L).injective).mp h1'
    obtain ⟨r, hr⟩ := IsIntegrallyClosed.isIntegral_iff.mp h2
    refine ⟨r, ?_⟩
    rw [IsScalarTower.algebraMap_apply R (FractionRing R) L, hr, hk]

  have Tbasic : ∀ (e : ℕ) (L : Type u) [Field L] [Algebra R L] [Algebra (FractionRing R) L]
      [IsScalarTower R (FractionRing R) L] (y : L), y ^ (p ^ e) = algebraMap R L x →
      ∃ T : Subring R,
        (∀ r : R, r ∈ T ↔ ∃ s ∈ integralClosure R L, s ^ (p ^ e) = algebraMap R L r) ∧
        (∀ r : R, r ^ (p ^ e) ∈ T) ∧ x ∈ T ∧ (∀ r : R, x * r ∈ T → r ∈ T) := by
    intro e L _ _ _ _ y hy
    have hinj : Function.Injective (algebraMap R L) := by
      rw [IsScalarTower.algebraMap_eq R (FractionRing R) L]
      exact (algebraMap (FractionRing R) L).injective.comp
        (IsFractionRing.injective R (FractionRing R))
    haveI : ExpChar L p := expChar_of_injective_algebraMap hinj p
    have hq0 : p ^ e ≠ 0 := pow_ne_zero e hp.ne_zero
    have hroot : ∀ (z : L) (r : R), z ^ (p ^ e) = algebraMap R L r →
        z ∈ integralClosure R L := by
      intro z r hz
      refine ⟨Polynomial.X ^ (p ^ e) - Polynomial.C r, Polynomial.monic_X_pow_sub_C r hq0, ?_⟩
      simp [Polynomial.eval₂_sub, hz]
    let T : Subring R := Subring.comap (algebraMap R L)
      (Subring.map (iterateFrobenius L p e) (integralClosure R L).toSubring)
    have hT : ∀ r : R, r ∈ T ↔ ∃ s ∈ integralClosure R L, s ^ (p ^ e) = algebraMap R L r := by
      intro r
      simp only [T, Subring.mem_comap, Subring.mem_map, iterateFrobenius_def,
        Subalgebra.mem_toSubring]
    refine ⟨T, hT, ?_, ?_, ?_⟩
    · intro r
      rw [hT]
      exact ⟨algebraMap R L r, Subalgebra.algebraMap_mem _ r, by rw [map_pow]⟩
    · rw [hT]
      exact ⟨y, hroot y x hy, hy⟩
    · intro r hr
      rw [hT] at hr ⊢
      obtain ⟨s, _, hs⟩ := hr
      have hy0 : y ≠ 0 := by
        intro h
        rw [h, zero_pow hq0] at hy
        exact hx0 (hinj (hy.symm.trans (map_zero _).symm))
      have hyq : y ^ (p ^ e) ≠ 0 := pow_ne_zero _ hy0
      have hu : (s / y) ^ (p ^ e) = algebraMap R L r := by
        rw [div_pow, hs, map_mul, ← hy, mul_div_cancel_left₀ _ hyq]
      exact ⟨s / y, hroot _ r hu, hu⟩

  have rank : ∀ (e : ℕ) (L : Type u) [Field L] [Algebra R L] [Algebra (FractionRing R) L]
      [IsScalarTower R (FractionRing R) L], Module.Finite (FractionRing R) L →
      ∀ (T : Subring R),
      (∀ r : R, r ∈ T ↔ ∃ s ∈ integralClosure R L, s ^ (p ^ e) = algebraMap R L r) →
      ∀ (m : ℕ) (t : Fin m → R), (∀ i, t i ∈ T) →
      (∀ c : Fin m → R, ∑ i, c i ^ (p ^ e) * t i = 0 → ∀ i, c i = 0) →
      m ≤ Module.finrank (FractionRing R) L := by
    intro e L _ _ _ _ hfin T hT
    have hinj : Function.Injective (algebraMap R L) := by
      rw [IsScalarTower.algebraMap_eq R (FractionRing R) L]
      exact (algebraMap (FractionRing R) L).injective.comp
        (IsFractionRing.injective R (FractionRing R))
    haveI : ExpChar L p := expChar_of_injective_algebraMap hinj p
    have hq0 : p ^ e ≠ 0 := by
      have := expChar_pow_pos L p e
      omega
    intro m t ht hlin
    choose s _ hs using fun i => (hT (t i)).mp (ht i)
    have hli : LinearIndependent R s := by
      rw [Fintype.linearIndependent_iff]
      intro g hg i
      apply hlin g _ i
      apply hinj
      have h0 : (∑ i, g i • s i) ^ (p ^ e) = 0 := by rw [hg]; exact zero_pow hq0
      rw [sum_pow_char_pow] at h0
      rw [map_sum, map_zero, ← h0]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def, mul_pow, hs i, map_mul, map_pow]
    have hliK : LinearIndependent (FractionRing R) s :=
      (LinearIndependent.iff_fractionRing R (FractionRing R)).mp hli
    have := hliK.fintype_card_le_finrank
    simpa using this

  have translate : ∀ (e : ℕ) (L : Type u) [Field L] [Algebra R L] [Algebra (FractionRing R) L]
      [IsScalarTower R (FractionRing R) L] (T : Subring R),
      (∀ r : R, r ∈ T ↔ ∃ s ∈ integralClosure R L, s ^ (p ^ e) = algebraMap R L r) →
      (∀ σ ∈ integralClosure R L, ∃ r : R, algebraMap R L r = σ ^ (p ^ e)) →
      ∀ (s₀ : Finset R), (∀ j ∈ s₀, j ∈ T) →
      (∀ t ∈ T, ∃ c : R → R, t = ∑ j ∈ s₀, c j ^ (p ^ e) * j) →
      Module.Finite R (integralClosure R L) := by
    intro e L _ _ _ _ T hT hfrob s₀ hs₀T hspan
    have hinj : Function.Injective (algebraMap R L) := by
      rw [IsScalarTower.algebraMap_eq R (FractionRing R) L]
      exact (algebraMap (FractionRing R) L).injective.comp
        (IsFractionRing.injective R (FractionRing R))
    haveI : ExpChar L p := expChar_of_injective_algebraMap hinj p
    have hσ : ∀ j : R, ∃ σ : integralClosure R L,
        j ∈ T → (σ : L) ^ (p ^ e) = algebraMap R L j := by
      intro j
      by_cases hj : j ∈ T
      · obtain ⟨s, hs, hsq⟩ := (hT j).mp hj
        exact ⟨⟨s, hs⟩, fun _ => hsq⟩
      · exact ⟨0, fun h => absurd h hj⟩
    choose σ hσ using hσ
    refine ⟨⟨s₀.image σ, ?_⟩⟩
    rw [eq_top_iff]
    rintro ⟨z, hz⟩ -
    obtain ⟨t, ht⟩ := hfrob z hz
    have htT : t ∈ T := (hT t).mpr ⟨z, hz, ht.symm⟩
    obtain ⟨c, hc⟩ := hspan t htT
    have hmem : (∑ j ∈ s₀, c j • σ j) ∈
        Submodule.span R (↑(s₀.image σ) : Set (integralClosure R L)) := by
      refine Submodule.sum_mem _ (fun j hj => Submodule.smul_mem _ _ (Submodule.subset_span ?_))
      exact Finset.mem_coe.mpr (Finset.mem_image_of_mem σ hj)
    have heq : (⟨z, hz⟩ : integralClosure R L) = ∑ j ∈ s₀, c j • σ j := by
      apply Subtype.ext
      apply iterateFrobenius_inj L p e
      simp only [iterateFrobenius_def]
      have hcoe : ((∑ j ∈ s₀, c j • σ j : integralClosure R L) : L) =
          ∑ j ∈ s₀, c j • (σ j : L) := by
        push_cast
        rfl
      rw [hcoe, sum_pow_char_pow, ← ht, hc, map_sum]
      refine Finset.sum_congr rfl (fun j hj => ?_)
      rw [Algebra.smul_def, mul_pow, hσ j (hs₀T j hj), map_mul, map_pow]
    rw [heq]
    exact hmem

  haveI : ExpChar (FractionRing R) p :=
    expChar_of_injective_algebraMap (IsFractionRing.injective R (FractionRing R)) p
  haveI := hLfin
  haveI := hPI
  haveI : IsPurelyInseparable.HasExponent (FractionRing R) L :=
    IsPurelyInseparable.hasExponent_of_finiteDimensional
  have hexp : ∀ a : L, a ^ (p ^ IsPurelyInseparable.exponent (FractionRing R) L) ∈
      (algebraMap (FractionRing R) L).range :=
    fun a => IsPurelyInseparable.exponent_def' (FractionRing R) p a

  obtain ⟨L₁, _, _, _, _, hfin₁, hexp₁, ⟨y, hy⟩, ⟨f⟩⟩ := enlarge _ L hLfin hexp
  refine descend L L₁ f ?_
  obtain ⟨T, hT, hpow, hxT, hsat⟩ := Tbasic _ L₁ y hy
  have hrank := rank _ L₁ hfin₁ T hT
  obtain ⟨s₀, hs₀T, hs₀⟩ := TD NAK p _ R R' x ψ hp hsurj hker hcomp (hFF _) T _ hpow hxT hsat hrank
  exact translate _ L₁ T hT (frob _ L₁ hexp₁) s₀ hs₀T hs₀

theorem fgm_cln_power_series_slice : ∀ (k : Type u) [Field k], IsField (MvPowerSeries (Fin 0) k) ∧ ∀ n : ℕ, MvPowerSeries.X (0 : Fin (n + 1)) ≠ (0 : MvPowerSeries (Fin (n + 1)) k) ∧ IsAdicComplete (Ideal.span {(MvPowerSeries.X (0 : Fin (n + 1)) : MvPowerSeries (Fin (n + 1)) k)}) (MvPowerSeries (Fin (n + 1)) k) ∧ ∃ ψ : MvPowerSeries (Fin (n + 1)) k →+* MvPowerSeries (Fin n) k, Function.Surjective ψ ∧ RingHom.ker ψ = Ideal.span {MvPowerSeries.X 0} :=
by
  intro k _
  classical

  have hA : IsField (MvPowerSeries (Fin 0) k) := by
    refine ⟨⟨0, 1, zero_ne_one⟩, fun a b => mul_comm a b, ?_⟩
    intro a ha
    refine ⟨a⁻¹, MvPowerSeries.mul_inv_cancel a ?_⟩
    intro h
    apply ha
    ext m
    rw [Subsingleton.elim m 0, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, h, map_zero]
  refine ⟨hA, fun n => ?_⟩

  have cons_tail0 : ∀ a : Fin (n + 1) →₀ ℕ, a 0 = 0 → Finsupp.cons 0 (Finsupp.tail a) = a := by
    intro a ha
    conv_rhs => rw [← Finsupp.cons_tail a]
    rw [ha]
  have cons_add : ∀ c d : Fin n →₀ ℕ,
      Finsupp.cons 0 c + Finsupp.cons 0 d = Finsupp.cons 0 (c + d) := by
    intro c d
    ext i
    cases i using Fin.cases with
    | zero => simp
    | succ i => simp
  have tail_add : ∀ a b : Fin (n + 1) →₀ ℕ,
      Finsupp.tail (a + b) = Finsupp.tail a + Finsupp.tail b := by
    intro a b
    ext i
    simp [Finsupp.tail_apply]
  have key : ∀ (m : Fin n →₀ ℕ) (p : (Fin (n + 1) →₀ ℕ) × (Fin (n + 1) →₀ ℕ)),
      p.1 + p.2 = Finsupp.cons 0 m → p.1 0 = 0 ∧ p.2 0 = 0 := by
    intro m p hp
    have := congrArg (fun t => t 0) hp
    simp only [Finsupp.add_apply, Finsupp.cons_zero] at this
    omega
  have hcons0 : ∀ m : Fin n →₀ ℕ, (Finsupp.cons 0 m = 0 ↔ m = 0) := by
    intro m
    constructor
    · intro h
      by_contra hm
      exact (Finsupp.cons_ne_zero_iff.mpr (Or.inr hm)) h
    · rintro rfl
      exact Finsupp.cons_zero_zero

  have hB : MvPowerSeries.X (0 : Fin (n + 1)) ≠ (0 : MvPowerSeries (Fin (n + 1)) k) := by
    intro h
    have := congrArg (MvPowerSeries.coeff (Finsupp.single (0 : Fin (n + 1)) 1)) h
    rw [MvPowerSeries.coeff_X, if_pos rfl, map_zero] at this
    exact one_ne_zero this

  have hC : IsAdicComplete (Ideal.span {(MvPowerSeries.X (0 : Fin (n + 1)) :
      MvPowerSeries (Fin (n + 1)) k)}) (MvPowerSeries (Fin (n + 1)) k) := by
    have T : ∀ (x y : MvPowerSeries (Fin (n + 1)) k) (N : ℕ),
        x ≡ y [SMOD (Ideal.span {(MvPowerSeries.X (0 : Fin (n + 1)) :
          MvPowerSeries (Fin (n + 1)) k)} ^ N •
          (⊤ : Submodule (MvPowerSeries (Fin (n + 1)) k) (MvPowerSeries (Fin (n + 1)) k)))] ↔
        ∀ m : Fin (n + 1) →₀ ℕ, m 0 < N → MvPowerSeries.coeff m x = MvPowerSeries.coeff m y := by
      intro x y N
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top, Ideal.span_singleton_pow,
        Ideal.mem_span_singleton, MvPowerSeries.X_pow_dvd_iff]
      simp only [map_sub, sub_eq_zero]
    have hH : IsHausdorff (Ideal.span {(MvPowerSeries.X (0 : Fin (n + 1)) :
        MvPowerSeries (Fin (n + 1)) k)}) (MvPowerSeries (Fin (n + 1)) k) := by
      refine ⟨fun x hx => ?_⟩
      ext m
      have := (T x 0 (m 0 + 1)).mp (hx (m 0 + 1)) m (Nat.lt_succ_self _)
      rw [this]
    have hP : IsPrecomplete (Ideal.span {(MvPowerSeries.X (0 : Fin (n + 1)) :
        MvPowerSeries (Fin (n + 1)) k)}) (MvPowerSeries (Fin (n + 1)) k) := by
      refine ⟨fun f hf => ?_⟩
      obtain ⟨L, hL⟩ : ∃ L : MvPowerSeries (Fin (n + 1)) k, ∀ m,
          MvPowerSeries.coeff m L = MvPowerSeries.coeff m (f (m 0 + 1)) :=
        ⟨fun m => MvPowerSeries.coeff m (f (m 0 + 1)), fun _ => rfl⟩
      refine ⟨L, fun N => ?_⟩
      rw [T]
      intro m hm
      have := (T _ _ _).mp (hf (Nat.succ_le_of_lt hm)) m (Nat.lt_succ_self _)
      rw [← this, hL]
    exact IsAdicComplete.mk
  refine ⟨hB, hC, ?_⟩

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : MvPowerSeries (Fin (n + 1)) k → MvPowerSeries (Fin n) k,
      ∀ f m, MvPowerSeries.coeff m (Φ f) = MvPowerSeries.coeff (Finsupp.cons 0 m) f :=
    ⟨fun f m => MvPowerSeries.coeff (Finsupp.cons 0 m) f, fun _ _ => rfl⟩
  let ψ : MvPowerSeries (Fin (n + 1)) k →+* MvPowerSeries (Fin n) k :=
    { toFun := Φ
      map_one' := by
        ext m
        rw [hΦ, MvPowerSeries.coeff_one, MvPowerSeries.coeff_one]
        simp only [hcons0]
      map_mul' := by
        intro f g
        ext m
        rw [hΦ, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
        refine Finset.sum_nbij' (fun p => (Finsupp.tail p.1, Finsupp.tail p.2))
          (fun p => (Finsupp.cons 0 p.1, Finsupp.cons 0 p.2)) ?_ ?_ ?_ ?_ ?_
        · intro p hp
          simp only [Finset.HasAntidiagonal.mem_antidiagonal] at hp ⊢
          rw [← tail_add, hp, Finsupp.tail_cons]
        · intro p hp
          simp only [Finset.HasAntidiagonal.mem_antidiagonal] at hp ⊢
          rw [cons_add, hp]
        · intro p hp
          simp only [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          obtain ⟨h1, h2⟩ := key m p hp
          exact Prod.ext (cons_tail0 _ h1) (cons_tail0 _ h2)
        · intro p _
          exact Prod.ext (Finsupp.tail_cons _ _) (Finsupp.tail_cons _ _)
        · intro p hp
          simp only [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          obtain ⟨h1, h2⟩ := key m p hp
          show MvPowerSeries.coeff p.1 f * MvPowerSeries.coeff p.2 g =
            MvPowerSeries.coeff (Finsupp.tail p.1) (Φ f) *
              MvPowerSeries.coeff (Finsupp.tail p.2) (Φ g)
          rw [hΦ, hΦ, cons_tail0 _ h1, cons_tail0 _ h2]
      map_zero' := by
        ext m
        rw [hΦ, map_zero, map_zero]
      map_add' := by
        intro f g
        ext m
        rw [hΦ, map_add, map_add, hΦ, hΦ] }
  have hψ : ∀ (f : MvPowerSeries (Fin (n + 1)) k) (m : Fin n →₀ ℕ),
      MvPowerSeries.coeff m (ψ f) = MvPowerSeries.coeff (Finsupp.cons 0 m) f := fun f m => hΦ f m
  refine ⟨ψ, ?_, ?_⟩
  · intro g
    obtain ⟨s, hs⟩ : ∃ s : MvPowerSeries (Fin (n + 1)) k, ∀ m',
        MvPowerSeries.coeff m' s =
          if m' 0 = 0 then MvPowerSeries.coeff (Finsupp.tail m') g else 0 :=
      ⟨fun m' => if m' 0 = 0 then MvPowerSeries.coeff (Finsupp.tail m') g else 0, fun _ => rfl⟩
    refine ⟨s, ?_⟩
    ext m
    rw [hψ, hs, Finsupp.cons_zero, if_pos rfl, Finsupp.tail_cons]
  · ext f
    rw [RingHom.mem_ker, Ideal.mem_span_singleton, MvPowerSeries.X_dvd_iff]
    constructor
    · intro h m' hm'
      have := hψ f (Finsupp.tail m')
      rw [h, map_zero, cons_tail0 m' hm'] at this
      exact this.symm
    · intro h
      ext m
      rw [hψ, map_zero]
      exact h _ (Finsupp.cons_zero _ _)

theorem fgm_complete_local_nagata : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A], IsAdicComplete (IsLocalRing.maximalIdeal A) A → ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra A D], Function.Surjective (algebraMap A D) → ∀ (L : Type u) [Field L] [Algebra D L] [Algebra (FractionRing D) L] [IsScalarTower D (FractionRing D) L], Module.Finite (FractionRing D) L → Module.Finite D (integralClosure D L) :=
by
  classical

  have s8 : ∀ (K M : Type u) [Field K] [Field M] [Algebra K M] [FiniteDimensional K M] [Normal K M] (x : M), (∀ σ : M ≃ₐ[K] M, σ x = x) → IsSeparable K x → x ∈ (algebraMap K M).range := by
    intro K M _ _ _ _ _ x hfix hsep
    have hint : IsIntegral K x := Algebra.IsIntegral.isIntegral x
    have hroots : (minpoly K x).rootSet M = {x} := by
      ext y
      simp only [Set.mem_singleton_iff]
      constructor
      · intro hy
        have hy' : Polynomial.aeval y (minpoly K x) = 0 := (Polynomial.mem_rootSet.mp hy).2
        have hmin : minpoly K x = minpoly K y :=
          minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hint) hy' (minpoly.monic hint)
        obtain ⟨σ, hσ⟩ :=
          (Normal.minpoly_eq_iff_mem_orbit (F := K) (E := M) (x := x) (y := y)).mp hmin
        have h2 : σ • y = x := hσ
        have h3 : σ y = x := h2
        have h4 := hfix σ.symm
        rw [← h3, AlgEquiv.symm_apply_apply] at h4
        exact h4.trans h3
      · intro hy
        rw [hy]
        exact Polynomial.mem_rootSet.mpr ⟨minpoly.ne_zero hint, minpoly.aeval K x⟩
    have hsplit := Normal.splits (F := K) (K := M) inferInstance x
    have hcard := Polynomial.card_rootSet_eq_natDegree hsep hsplit
    have hx : x ∈ (minpoly K x).rootSet M := by rw [hroots]; rfl
    have h1 : Fintype.card ((minpoly K x).rootSet M) = 1 := by
      rw [Fintype.card_eq_one_iff]
      refine ⟨⟨x, hx⟩, fun y => Subtype.ext ?_⟩
      exact (Set.ext_iff.mp hroots y).mp y.2
    rw [h1] at hcard
    exact minpoly.natDegree_eq_one_iff.mp hcard.symm

  have s7 : ∀ (R : Type u) [CommRing R] [IsDomain R], IsField R → ∀ (L : Type u) [Field L] [Algebra R L] [Algebra (FractionRing R) L] [IsScalarTower R (FractionRing R) L], Module.Finite (FractionRing R) L → Module.Finite R (integralClosure R L) := by
    intro R _ _ hR L _ _ _ _ hL
    haveI := hL
    have hsurj : Function.Surjective (algebraMap R (FractionRing R)) :=
      (IsFractionRing.surjective_iff_isField (R := R) (K := FractionRing R)).mpr hR
    haveI : Module.Finite R (FractionRing R) :=
      Module.Finite.of_surjective (Algebra.linearMap R (FractionRing R)) hsurj
    haveI : Module.Finite R L := Module.Finite.trans (FractionRing R) L
    have htop : integralClosure R L = ⊤ :=
      integralClosure_eq_top_iff.mpr (Algebra.IsIntegral.of_finite R L)
    rw [htop]
    exact Module.Finite.equiv (Subalgebra.topEquiv (R := R) (A := L)).toLinearEquiv.symm

  have s5 : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsIntegrallyClosed A], CharZero A → ∀ (L : Type u) [Field L] [Algebra A L] [Algebra (FractionRing A) L] [IsScalarTower A (FractionRing A) L], Module.Finite (FractionRing A) L → Module.Finite A (integralClosure A L) := by
    intro A _ _ _ _ hc L _ _ _ _ hL
    haveI := hc
    haveI := hL
    haveI : CharZero (FractionRing A) := IsFractionRing.charZero_of_isFractionRing A
    haveI : Algebra.IsIntegral (FractionRing A) L := Algebra.IsIntegral.of_finite _ _
    haveI : Algebra.IsSeparable (FractionRing A) L := Algebra.IsSeparable.of_integral _ _
    exact IsIntegralClosure.finite A (FractionRing A) L (integralClosure A L)

  have s3 : ∀ (A₀ D L : Type u) [CommRing A₀] [CommRing D] [CommRing L] [Algebra A₀ D]
      [Algebra D L] [Algebra A₀ L] [IsScalarTower A₀ D L], Module.Finite A₀ D →
      Module.Finite A₀ (integralClosure A₀ L) → Module.Finite D (integralClosure D L) := by
    intro A₀ D L _ _ _ _ _ _ _ hD hI
    haveI := hD
    haveI : Algebra.IsIntegral A₀ D := Algebra.IsIntegral.of_finite A₀ D
    have heq : ∀ x : L, x ∈ integralClosure D L ↔ x ∈ integralClosure A₀ L := by
      intro x
      simp only [mem_integralClosure_iff]
      exact ⟨fun hx => isIntegral_trans x hx, fun hx => hx.tower_top⟩
    have hI' : (Subalgebra.toSubmodule (integralClosure A₀ L)).FG := Module.Finite.iff_fg.mp hI
    suffices hG : (Subalgebra.toSubmodule (integralClosure D L)).FG from
      Module.Finite.iff_fg.mpr hG
    obtain ⟨s, hs⟩ := hI'
    refine ⟨s, le_antisymm ?_ ?_⟩
    · rw [Submodule.span_le]
      intro x hx
      have : x ∈ Subalgebra.toSubmodule (integralClosure A₀ L) := hs ▸ Submodule.subset_span hx
      exact (heq x).mpr this
    · intro x hx
      have h1 : x ∈ Subalgebra.toSubmodule (integralClosure A₀ L) := (heq x).mp hx
      rw [← hs] at h1
      exact Submodule.span_le_restrictScalars A₀ D (s : Set L) h1
  have s4 : ∀ (A₀ D L : Type u) [CommRing A₀] [IsDomain A₀] [CommRing D] [IsDomain D]
      [Algebra A₀ D] [Field L] [Algebra D L] [Algebra A₀ L] [IsScalarTower A₀ D L]
      [Algebra (FractionRing D) L] [IsScalarTower D (FractionRing D) L]
      [Algebra (FractionRing A₀) L] [IsScalarTower A₀ (FractionRing A₀) L],
      Function.Injective (algebraMap A₀ D) → Module.Finite A₀ D →
      Module.Finite (FractionRing D) L → Module.Finite (FractionRing A₀) L := by
    intro A₀ D L _ _ _ _ _ _ _ _ _ _ _ _ _ hinj hD hL
    haveI := hD
    haveI := hL
    haveI : FaithfulSMul A₀ D := (faithfulSMul_iff_algebraMap_injective A₀ D).mpr hinj
    letI : Algebra (FractionRing A₀) (FractionRing D) := Ring.instAlgebraFractionRing A₀ D
    haveI : IsScalarTower A₀ (FractionRing A₀) (FractionRing D) :=
      FractionRing.isScalarTower_liftAlgebra A₀ (FractionRing D)
    haveI : Module.Finite (FractionRing A₀) (FractionRing D) := inferInstance
    haveI : IsScalarTower (FractionRing A₀) (FractionRing D) L := by
      apply IsScalarTower.of_algebraMap_eq'
      apply IsLocalization.ringHom_ext (nonZeroDivisors A₀)
      rw [← IsScalarTower.algebraMap_eq, RingHom.comp_assoc,
        ← IsScalarTower.algebraMap_eq A₀ (FractionRing A₀) (FractionRing D),
        IsScalarTower.algebraMap_eq A₀ D (FractionRing D), ← RingHom.comp_assoc,
        ← IsScalarTower.algebraMap_eq D (FractionRing D) L, ← IsScalarTower.algebraMap_eq]
    exact Module.Finite.trans (FractionRing D) L
  have s6 : ∀ (A₀ D : Type u) [CommRing A₀] [IsDomain A₀] [CommRing D] [IsDomain D] [Algebra A₀ D], Function.Injective (algebraMap A₀ D) → Module.Finite A₀ D → (∀ (L : Type u) [Field L] [Algebra A₀ L] [Algebra (FractionRing A₀) L] [IsScalarTower A₀ (FractionRing A₀) L], Module.Finite (FractionRing A₀) L → Module.Finite A₀ (integralClosure A₀ L)) → ∀ (L : Type u) [Field L] [Algebra D L] [Algebra (FractionRing D) L] [IsScalarTower D (FractionRing D) L], Module.Finite (FractionRing D) L → Module.Finite D (integralClosure D L) := by
    intro A₀ D _ _ _ _ _ hinj₀ hfin hN2 L _ _ _ _ hL
    haveI := hfin
    letI : Algebra A₀ L := ((algebraMap D L).comp (algebraMap A₀ D)).toAlgebra
    haveI : IsScalarTower A₀ D L := IsScalarTower.of_algebraMap_eq' rfl
    have hinjD : Function.Injective (algebraMap D L) := by
      rw [IsScalarTower.algebraMap_eq D (FractionRing D) L]
      exact (algebraMap (FractionRing D) L).injective.comp
        (IsFractionRing.injective D (FractionRing D))
    have hinjL : Function.Injective (algebraMap A₀ L) := by
      rw [IsScalarTower.algebraMap_eq A₀ D L]
      exact hinjD.comp hinj₀
    haveI : FaithfulSMul A₀ L := (faithfulSMul_iff_algebraMap_injective _ _).mpr hinjL
    letI : Algebra (FractionRing A₀) L := FractionRing.liftAlgebra _ L
    haveI := FractionRing.isScalarTower_liftAlgebra A₀ L
    have hFin := s4 A₀ D L hinj₀ hfin hL
    exact s3 A₀ D L hfin (hN2 L hFin)

  have s13 : ∀ (p : ℕ) (k : Type u) [Field k] [CharP k p], p.Prime → ∀ n : ℕ, ∀ (L : Type u) [Field L] [Algebra (MvPowerSeries (Fin n) k) L] [Algebra (FractionRing (MvPowerSeries (Fin n) k)) L] [IsScalarTower (MvPowerSeries (Fin n) k) (FractionRing (MvPowerSeries (Fin n) k)) L], Module.Finite (FractionRing (MvPowerSeries (Fin n) k)) L → Module.Finite (MvPowerSeries (Fin n) k) (integralClosure (MvPowerSeries (Fin n) k) L) := by
    intro p k _ _ hp n
    have hmax : IsLocalRing.maximalIdeal k = Ideal.span {(0 : k)} := by
      rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.span_singleton_eq_bot.mpr rfl]
    have hreg := wc_hnas_pfc_gcl_cf_power_series_regular k 0 hmax
    have hslice := fgm_cln_power_series_slice k
    induction n with
    | zero =>
      haveI := (hreg 0).1
      exact s7 _ hslice.1
    | succ n ih =>
      haveI : IsDomain (MvPowerSeries (Fin (n + 1)) k) := (hreg (n + 1)).1
      haveI : IsDomain (MvPowerSeries (Fin n) k) := (hreg n).1
      haveI : IsRegularLocalRing (MvPowerSeries (Fin (n + 1)) k) := (hreg (n + 1)).2.1
      haveI : UniqueFactorizationMonoid (MvPowerSeries (Fin (n + 1)) k) :=
        (wc_fco_regular_local_ufd _).2
      haveI : CharP (MvPowerSeries (Fin (n + 1)) k) p :=
        charP_of_injective_algebraMap (algebraMap k (MvPowerSeries (Fin (n + 1)) k)).injective p
      haveI : CharP (MvPowerSeries (Fin n) k) p :=
        charP_of_injective_algebraMap (algebraMap k (MvPowerSeries (Fin n) k)).injective p
      haveI : ExpChar (MvPowerSeries (Fin (n + 1)) k) p := ExpChar.prime hp
      haveI : ExpChar (MvPowerSeries (Fin n) k) p := ExpChar.prime hp
      obtain ⟨hx0, hxc, ψ, hψs, hψk⟩ := hslice.2 n
      have hPI' : ∀ (L : Type u) [Field L] [Algebra (MvPowerSeries (Fin n) k) L] [Algebra (FractionRing (MvPowerSeries (Fin n) k)) L] [IsScalarTower (MvPowerSeries (Fin n) k) (FractionRing (MvPowerSeries (Fin n) k)) L], Module.Finite (FractionRing (MvPowerSeries (Fin n) k)) L → IsPurelyInseparable (FractionRing (MvPowerSeries (Fin n) k)) L → Module.Finite (MvPowerSeries (Fin n) k) (integralClosure (MvPowerSeries (Fin n) k) L) := by
        intro L _ _ _ _ hL _
        exact ih L hL
      have hFF := fun e => fgm_cln_frobenius_subring_finite p e (MvPowerSeries (Fin n) k) hp hPI'
      have hPI := fgm_cln_tate_char_p fgm_cln_tate_descent wc_hnas_pfc_gcl_cf_complete_nakayama p
        (MvPowerSeries (Fin (n + 1)) k) (MvPowerSeries (Fin n) k) _ ψ hp hx0 hψs hψk hxc hFF
      exact fgm_cln_n2_of_purely_inseparable s8 _ hPI

  intro A _ _ _ hA D _ _ _ hsurj L _ _ _ _ hL
  haveI : IsLocalRing D := IsLocalRing.of_surjective' (algebraMap A D) hsurj
  haveI : IsLocalHom (algebraMap A D) := Function.Surjective.isLocalHom (algebraMap A D) hsurj
  haveI : Module.Finite A D := Module.Finite.of_surjective (Algebra.linearMap A D) hsurj
  haveI : IsNoetherianRing D := IsNoetherianRing.of_finite A D
  have hD := wc_plt_hlc_finite_complete A D hA
  rcases wc_hnas_pfc_gcl_cohen_finite D hD with
    ⟨A₀, _, _, _, _, hdom, hreg, hinj, hfin, hchar⟩ |
    ⟨p, n, k, _, _, _, hp, _, hdom, _, hinj, hfin⟩
  · haveI := hdom
    haveI := hreg
    haveI : UniqueFactorizationMonoid A₀ := (wc_fco_regular_local_ufd A₀).2
    have hcz : CharZero A₀ := charZero_of_inj_zero (fun m hm => by
      by_contra hne
      apply hchar m hne
      rw [← map_natCast (algebraMap A₀ D), hm, map_zero])
    exact s6 A₀ D hinj hfin (s5 A₀ hcz) L hL
  · haveI := hdom
    exact s6 _ D hinj hfin (s13 p k hp n) L hL

theorem wcpa_dj_ncc_nag_fin : wcpaDjNccNagFin.{u} :=
by
  intro A C _ _ _ hfin hA
  have s3 : ∀ (A₀ D L : Type u) [CommRing A₀] [CommRing D] [CommRing L] [Algebra A₀ D]
      [Algebra D L] [Algebra A₀ L] [IsScalarTower A₀ D L], Module.Finite A₀ D →
      Module.Finite A₀ (integralClosure A₀ L) → Module.Finite D (integralClosure D L) := by
    intro A₀ D L _ _ _ _ _ _ _ hD hI
    haveI := hD
    haveI : Algebra.IsIntegral A₀ D := Algebra.IsIntegral.of_finite A₀ D
    have heq : ∀ x : L, x ∈ integralClosure D L ↔ x ∈ integralClosure A₀ L := by
      intro x
      simp only [mem_integralClosure_iff]
      exact ⟨fun hx => isIntegral_trans x hx, fun hx => hx.tower_top⟩
    have hI' : (Subalgebra.toSubmodule (integralClosure A₀ L)).FG := Module.Finite.iff_fg.mp hI
    suffices hG : (Subalgebra.toSubmodule (integralClosure D L)).FG from
      Module.Finite.iff_fg.mpr hG
    obtain ⟨s, hs⟩ := hI'
    refine ⟨s, le_antisymm ?_ ?_⟩
    · rw [Submodule.span_le]
      intro x hx
      have : x ∈ Subalgebra.toSubmodule (integralClosure A₀ L) := hs ▸ Submodule.subset_span hx
      exact (heq x).mpr this
    · intro x hx
      have h1 : x ∈ Subalgebra.toSubmodule (integralClosure A₀ L) := (heq x).mp hx
      rw [← hs] at h1
      exact Submodule.span_le_restrictScalars A₀ D (s : Set L) h1
  have s4 : ∀ (A₀ D L : Type u) [CommRing A₀] [IsDomain A₀] [CommRing D] [IsDomain D]
      [Algebra A₀ D] [Field L] [Algebra D L] [Algebra A₀ L] [IsScalarTower A₀ D L]
      [Algebra (FractionRing D) L] [IsScalarTower D (FractionRing D) L]
      [Algebra (FractionRing A₀) L] [IsScalarTower A₀ (FractionRing A₀) L],
      Function.Injective (algebraMap A₀ D) → Module.Finite A₀ D →
      Module.Finite (FractionRing D) L → Module.Finite (FractionRing A₀) L := by
    intro A₀ D L _ _ _ _ _ _ _ _ _ _ _ _ _ hinj hD hL
    haveI := hD
    haveI := hL
    haveI : FaithfulSMul A₀ D := (faithfulSMul_iff_algebraMap_injective A₀ D).mpr hinj
    letI : Algebra (FractionRing A₀) (FractionRing D) := Ring.instAlgebraFractionRing A₀ D
    haveI : IsScalarTower A₀ (FractionRing A₀) (FractionRing D) :=
      FractionRing.isScalarTower_liftAlgebra A₀ (FractionRing D)
    haveI : Module.Finite (FractionRing A₀) (FractionRing D) := inferInstance
    haveI : IsScalarTower (FractionRing A₀) (FractionRing D) L := by
      apply IsScalarTower.of_algebraMap_eq'
      apply IsLocalization.ringHom_ext (nonZeroDivisors A₀)
      rw [← IsScalarTower.algebraMap_eq, RingHom.comp_assoc,
        ← IsScalarTower.algebraMap_eq A₀ (FractionRing A₀) (FractionRing D),
        IsScalarTower.algebraMap_eq A₀ D (FractionRing D), ← RingHom.comp_assoc,
        ← IsScalarTower.algebraMap_eq D (FractionRing D) L, ← IsScalarTower.algebraMap_eq]
    exact Module.Finite.trans (FractionRing D) L
  haveI := hA.1
  haveI := hfin
  refine ⟨IsNoetherianRing.of_finite A C, ?_⟩
  intro D _ _ _ hsurj
  letI : Algebra A D := ((algebraMap C D).comp (algebraMap A C)).toAlgebra
  haveI : IsScalarTower A C D := IsScalarTower.of_algebraMap_eq' rfl
  haveI : Module.Finite C D := Module.Finite.of_surjective (Algebra.linearMap C D) hsurj
  haveI : Module.Finite A D := Module.Finite.trans C D
  have hsurj₀ : Function.Surjective (algebraMap A (⊥ : Subalgebra A D)) := by
    intro y
    obtain ⟨a, ha⟩ := Algebra.mem_bot.mp y.2
    exact ⟨a, Subtype.ext ha⟩
  have hN2₀ : wcpaDjNccN2 (⊥ : Subalgebra A D) := hA.2 _ hsurj₀
  haveI : Module.Finite (⊥ : Subalgebra A D) D :=
    Module.Finite.of_restrictScalars_finite A (⊥ : Subalgebra A D) D
  have hinj₀ : Function.Injective (algebraMap (⊥ : Subalgebra A D) D) := Subtype.val_injective
  intro L _ _ _ _ hL
  have hinjD : Function.Injective (algebraMap D L) := by
    rw [IsScalarTower.algebraMap_eq D (FractionRing D) L]
    exact (algebraMap (FractionRing D) L).injective.comp (IsFractionRing.injective D (FractionRing D))
  have hinjL : Function.Injective (algebraMap (⊥ : Subalgebra A D) L) := by
    rw [IsScalarTower.algebraMap_eq (⊥ : Subalgebra A D) D L]
    exact hinjD.comp hinj₀
  haveI : FaithfulSMul (⊥ : Subalgebra A D) L :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinjL
  letI : Algebra (FractionRing (⊥ : Subalgebra A D)) L := FractionRing.liftAlgebra _ L
  haveI := FractionRing.isScalarTower_liftAlgebra (⊥ : Subalgebra A D) L
  have hFin := s4 (⊥ : Subalgebra A D) D L hinj₀ inferInstance hL
  exact s3 (⊥ : Subalgebra A D) D L inferInstance (hN2₀ L hFin)

theorem wcpa_dj_ncc_nag_poly : wcpaDjNccNagPoly.{u} :=
by
  have t_frob_span : ∀ (F L : Type u) [Field F] [Field L] [Algebra F L] [FiniteDimensional F L], ∃ (e n : ℕ) (v : Fin n → L), (∀ i, IsSeparable F (v i)) ∧ ∀ ℓ : L, ∃ c : Fin n → F, ℓ ^ (ringExpChar F ^ e) = ∑ i, algebraMap F L (c i) * v i ^ (ringExpChar F ^ e) := by
    intro F L _ _ _ _
    haveI : Algebra.IsAlgebraic F L := Algebra.IsAlgebraic.of_finite F L
    haveI : IsPurelyInseparable (separableClosure F L) L := separableClosure.isPurelyInseparable F L
    haveI : FiniteDimensional (separableClosure F L) L :=
      IntermediateField.finiteDimensional_right (separableClosure F L)
    haveI hexp : IsPurelyInseparable.HasExponent (separableClosure F L) L :=
      IsPurelyInseparable.hasExponent_of_finiteDimensional
    obtain ⟨e, he⟩ := hexp.has_exponent
    haveI : ExpChar F (ringExpChar F) := ringExpChar.expChar F
    haveI : ExpChar (separableClosure F L) (ringExpChar F) :=
      expChar_of_injective_algebraMap (algebraMap F (separableClosure F L)).injective _
    have hEq : ringExpChar (separableClosure F L) = ringExpChar F := ringExpChar.eq _ _
    rw [hEq] at he
    haveI : FiniteDimensional F (separableClosure F L) :=
      IntermediateField.finiteDimensional_left (separableClosure F L)
    haveI : Algebra.IsSeparable F (separableClosure F L) := separableClosure.isSeparable F L
    have hsp := Field.span_map_pow_expChar_pow_eq_top_of_isSeparable (ringExpChar F) e
      (Module.finBasis F (separableClosure F L)).span_eq
    refine ⟨e, _, fun i => ((Module.finBasis F (separableClosure F L) i : separableClosure F L) : L),
      fun i => mem_separableClosure_iff.mp (Module.finBasis F (separableClosure F L) i).2, fun ℓ => ?_⟩
    obtain ⟨ε, hε⟩ := he ℓ
    have hmem : ε ∈ Submodule.span F (Set.range fun x =>
        (Module.finBasis F (separableClosure F L)) x ^ ringExpChar F ^ e) := by
      rw [hsp]; trivial
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun F).mp hmem
    refine ⟨c, ?_⟩
    rw [← hε, ← hc, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Algebra.smul_def, map_mul, map_pow, ← IsScalarTower.algebraMap_apply]
    rfl
  have t_poly_span : ∀ (A Ω : Type u) [CommRing A] [CommRing Ω] (κ : A →+* Ω) (C : Subring Ω) (k : ℕ) (h : Fin k → Ω), (∀ c ∈ C, ∃ r : Fin k → A, c = ∑ i, κ (r i) * h i) → ∀ (y : Ω) (q : ℕ), 0 < q → ∀ b ∈ (Polynomial.eval₂RingHom C.subtype y).range, ∃ s : Fin k × Fin q → Polynomial A, b = ∑ l, (s l).eval₂ κ (y ^ q) * (h l.1 * y ^ (l.2 : ℕ)) := by
    intro A Ω _ _ κ C k h hgen y q hq b hb
    classical
    obtain ⟨H, rfl⟩ := RingHom.mem_range.mp hb
    choose R hR using fun m => hgen _ (H.coeff m).2
    refine ⟨fun l => ∑ m ∈ Finset.range (H.natDegree + 1) with
      (⟨m % q, Nat.mod_lt _ hq⟩ : Fin q) = l.2, Polynomial.C (R m l.1) * Polynomial.X ^ (m / q), ?_⟩
    rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_eq_sum_range, Fintype.sum_prod_type]
    have e1 : ∀ m, C.subtype (H.coeff m) * y ^ m = ∑ i, κ (R m i) * h i * y ^ m := by
      intro m
      show (H.coeff m : Ω) * y ^ m = _
      rw [hR m, Finset.sum_mul]
    have key : ∀ i, ∑ m ∈ Finset.range (H.natDegree + 1), κ (R m i) * h i * y ^ m =
        ∑ t : Fin q, Polynomial.eval₂ κ (y ^ q) (∑ m ∈ Finset.range (H.natDegree + 1) with
          (⟨m % q, Nat.mod_lt _ hq⟩ : Fin q) = t, Polynomial.C (R m i) * Polynomial.X ^ (m / q)) *
          (h i * y ^ (t : ℕ)) := by
      intro i
      rw [← Finset.sum_fiberwise (Finset.range (H.natDegree + 1))
        (fun m => (⟨m % q, Nat.mod_lt _ hq⟩ : Fin q))]
      refine Finset.sum_congr rfl (fun t _ => ?_)
      rw [Polynomial.eval₂_finset_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun m hm => ?_)
      have hmt : (t : ℕ) = m % q := (congrArg Fin.val (Finset.mem_filter.mp hm).2).symm
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow, hmt, ← pow_mul]
      calc κ (R m i) * h i * y ^ m = κ (R m i) * h i * y ^ (q * (m / q) + m % q) := by
            rw [Nat.div_add_mod]
        _ = _ := by rw [pow_add]; ring
    calc ∑ m ∈ Finset.range (H.natDegree + 1), C.subtype (H.coeff m) * y ^ m
        = ∑ m ∈ Finset.range (H.natDegree + 1), ∑ i, κ (R m i) * h i * y ^ m :=
          Finset.sum_congr rfl (fun m _ => e1 m)
      _ = ∑ i, ∑ m ∈ Finset.range (H.natDegree + 1), κ (R m i) * h i * y ^ m := Finset.sum_comm
      _ = _ := Finset.sum_congr rfl (fun i _ => key i)
  have t_sep_span : ∀ (Ω : Type u) [Field Ω] (B : Subring Ω) [IsIntegrallyClosed B] [IsNoetherianRing B] (n : ℕ) (u : Fin n → Ω) (hp : Fin n → Polynomial B), (∀ i, ((hp i).map B.subtype).Separable) → (∀ i, (hp i).eval₂ B.subtype (u i) = 0) → ∃ (k : ℕ) (g : Fin k → Ω), ∀ z ∈ Subfield.closure ((B : Set Ω) ∪ Set.range u), IsIntegral B z → ∃ r : Fin k → B, z = ∑ i, (r i : Ω) * g i := by
    intro Ω _ B _ _ n u hp hsep hroot
    classical
    letI : Algebra (FractionRing B) Ω :=
      (IsFractionRing.lift (A := B) (K := FractionRing B) (g := B.subtype) Subtype.val_injective).toAlgebra
    have hlift : ∀ b : B, algebraMap (FractionRing B) Ω (algebraMap B (FractionRing B) b) = (b : Ω) :=
      fun b => IsFractionRing.lift_algebraMap _ b
    haveI : IsScalarTower B (FractionRing B) Ω :=
      IsScalarTower.of_algebraMap_eq (fun b => (hlift b).symm)
    have hui : ∀ i, IsSeparable (FractionRing B) (u i) := by
      intro i
      have hH : ((hp i).map (algebraMap B (FractionRing B))).map (algebraMap (FractionRing B) Ω) =
          (hp i).map B.subtype := by
        rw [Polynomial.map_map]
        congr 1
        exact RingHom.ext hlift
      have hs : ((hp i).map (algebraMap B (FractionRing B))).Separable :=
        (Polynomial.separable_map (algebraMap (FractionRing B) Ω)).mp (by rw [hH]; exact hsep i)
      have hroot' : Polynomial.aeval (u i) ((hp i).map (algebraMap B (FractionRing B))) = 0 := by
        rw [Polynomial.aeval_map_algebraMap, Polynomial.aeval_def]
        exact hroot i
      exact hs.of_dvd (minpoly.dvd (FractionRing B) (u i) hroot')
    haveI : FiniteDimensional (FractionRing B)
        (IntermediateField.adjoin (FractionRing B) (Set.range u)) :=
      IntermediateField.finiteDimensional_adjoin (by
        rintro x ⟨i, rfl⟩; exact (hui i).isIntegral)
    haveI : Algebra.IsSeparable (FractionRing B)
        (IntermediateField.adjoin (FractionRing B) (Set.range u)) :=
      (IntermediateField.isSeparable_adjoin_iff_isSeparable (FractionRing B) Ω).mpr (by
        rintro x ⟨i, rfl⟩; exact hui i)
    haveI : Module.Finite B (integralClosure B
        (IntermediateField.adjoin (FractionRing B) (Set.range u))) :=
      IsIntegralClosure.finite B (FractionRing B)
        (IntermediateField.adjoin (FractionRing B) (Set.range u)) _
    obtain ⟨k, g', hg'⟩ := Module.Finite.exists_fin (R := B) (M := integralClosure B
        (IntermediateField.adjoin (FractionRing B) (Set.range u)))
    refine ⟨k, fun i => ((g' i : IntermediateField.adjoin (FractionRing B) (Set.range u)) : Ω), ?_⟩
    intro z hz hzint
    have hzM : z ∈ IntermediateField.adjoin (FractionRing B) (Set.range u) := by
      have hle : Subfield.closure ((B : Set Ω) ∪ Set.range u) ≤
          (IntermediateField.adjoin (FractionRing B) (Set.range u)).toSubfield := by
        rw [Subfield.closure_le]
        rintro x (hx | ⟨i, rfl⟩)
        · have hx' : x = algebraMap (FractionRing B) Ω (algebraMap B (FractionRing B) ⟨x, hx⟩) :=
            (hlift ⟨x, hx⟩).symm
          rw [hx']
          exact IntermediateField.algebraMap_mem _ _
        · exact IntermediateField.subset_adjoin (FractionRing B) _ ⟨i, rfl⟩
      exact hle hz
    let jM := (IntermediateField.adjoin (FractionRing B) (Set.range u)).val.restrictScalars B
    have hzint' : IsIntegral B
        (⟨z, hzM⟩ : IntermediateField.adjoin (FractionRing B) (Set.range u)) :=
      (isIntegral_algHom_iff jM Subtype.val_injective).mp hzint
    have hmem : (⟨⟨z, hzM⟩, hzint'⟩ : integralClosure B
        (IntermediateField.adjoin (FractionRing B) (Set.range u))) ∈
        Submodule.span B (Set.range g') := by
      rw [hg']; trivial
    obtain ⟨r, hr⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp hmem
    refine ⟨r, ?_⟩
    let Lm := jM.comp (integralClosure B
        (IntermediateField.adjoin (FractionRing B) (Set.range u))).val
    have h2 : z = Lm (∑ i, r i • g' i) := by rw [hr]; rfl
    rw [h2, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_smul, Algebra.smul_def]
    rfl
  have t_normal_model : ∀ (A : Type u) [CommRing A] [IsDomain A], IsNoetherianRing A → wcpaDjNccN2 A → ∀ (Ω : Type u) [Field Ω] (κ : A →+* Ω), Function.Injective κ → ∀ T : Finset Ω, (∀ t ∈ T, ∃ g : Polynomial A, g.Monic ∧ g.eval₂ κ t = 0) → ∃ C : Subring Ω, (∀ a, κ a ∈ C) ∧ (∀ t ∈ T, t ∈ C) ∧ IsIntegrallyClosed C ∧ IsNoetherianRing C ∧ (∃ (k : ℕ) (h : Fin k → Ω), ∀ c ∈ C, ∃ r : Fin k → A, c = ∑ i, κ (r i) * h i) ∧ (∀ c ∈ C, ∃ g : Polynomial A, g.Monic ∧ g.eval₂ κ c = 0) := by
    intro A _ _ hAN hN2 Ω _ κ hκ T hT
    classical
    letI : Algebra A Ω := κ.toAlgebra
    haveI : FaithfulSMul A Ω := (faithfulSMul_iff_algebraMap_injective A Ω).mpr hκ
    letI : Algebra (FractionRing A) Ω := FractionRing.liftAlgebra A Ω
    haveI : IsScalarTower A (FractionRing A) Ω := FractionRing.isScalarTower_liftAlgebra A Ω
    have hTint : ∀ t ∈ (T : Set Ω), IsIntegral (FractionRing A) t := by
      intro t ht
      obtain ⟨g, hgm, hg⟩ := hT t ht
      have hti : IsIntegral A t := ⟨g, hgm, hg⟩
      exact hti.tower_top
    haveI hfd : FiniteDimensional (FractionRing A)
        (IntermediateField.adjoin (FractionRing A) (T : Set Ω)) :=
      IntermediateField.finiteDimensional_adjoin hTint
    have hJ := hN2 (IntermediateField.adjoin (FractionRing A) (T : Set Ω)) hfd
    haveI := hJ
    let j := (IntermediateField.adjoin (FractionRing A) (T : Set Ω)).val.restrictScalars A
    have hj : Function.Injective j := Subtype.val_injective
    let J := integralClosure A (IntermediateField.adjoin (FractionRing A) (T : Set Ω))
    haveI hJint : IsIntegrallyClosed J :=
      integralClosure.isIntegrallyClosedOfFiniteExtension (FractionRing A)
    haveI hJnoeth : IsNoetherianRing J := IsNoetherianRing.of_finite A J
    let e := Subalgebra.equivMapOfInjective J j hj
    refine ⟨(J.map j).toSubring, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro a
      show κ a ∈ J.map j
      exact Subalgebra.mem_map.mpr ⟨_, J.algebraMap_mem a, j.commutes a⟩
    · intro t ht
      show t ∈ J.map j
      refine Subalgebra.mem_map.mpr ⟨⟨t, IntermediateField.subset_adjoin _ _ ht⟩, ?_, rfl⟩
      obtain ⟨g, hgm, hg⟩ := hT t ht
      have hti : IsIntegral A t := ⟨g, hgm, hg⟩
      exact (mem_integralClosure_iff A _).mpr ((isIntegral_algHom_iff j hj).mp hti)
    · show IsIntegrallyClosed (J.map j)
      exact IsIntegrallyClosed.of_equiv e.toRingEquiv
    · show IsNoetherianRing (J.map j)
      exact isNoetherianRing_of_ringEquiv J e.toRingEquiv
    · obtain ⟨k, s, hs⟩ := Module.Finite.exists_fin (R := A) (M := J)
      refine ⟨k, fun i => j (s i), ?_⟩
      intro c hc
      obtain ⟨ξ, hξ, rfl⟩ := Subalgebra.mem_map.mp hc
      have hmem : (⟨ξ, hξ⟩ : J) ∈ Submodule.span A (Set.range s) := by rw [hs]; trivial
      obtain ⟨r, hr⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hmem
      refine ⟨r, ?_⟩
      have h2 : j ξ = (j.comp J.val) (∑ i, r i • s i) := by rw [hr]; rfl
      rw [h2, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_smul, Algebra.smul_def]
      rfl
    · intro c hc
      obtain ⟨ξ, hξ, rfl⟩ := Subalgebra.mem_map.mp hc
      obtain ⟨g, hgm, hg⟩ := ((mem_integralClosure_iff A _).mp hξ).map j
      exact ⟨g, hgm, hg⟩
  have t_adjoin_normal : ∀ (A Ω : Type u) [CommRing A] [IsDomain A] [Field Ω] (κ : A →+* Ω) (C : Subring Ω), IsIntegrallyClosed C → IsNoetherianRing C → (∀ a, κ a ∈ C) → (∀ c ∈ C, ∃ g : Polynomial A, g.Monic ∧ g.eval₂ κ c = 0) → ∀ (y : Ω) (q : ℕ), 0 < q → (∀ g : Polynomial A, g.eval₂ κ (y ^ q) = 0 → g = 0) → IsIntegrallyClosed (Polynomial.eval₂RingHom C.subtype y).range ∧ IsNoetherianRing (Polynomial.eval₂RingHom C.subtype y).range := by
    intro A Ω _ _ _ κ C hCn hCN hκC hCint y q hq htr
    letI : Algebra A Ω := κ.toAlgebra
    letI : Algebra A C := (κ.codRestrict C hκC).toAlgebra
    haveI : IsScalarTower A C Ω := IsScalarTower.of_algebraMap_eq (fun a => rfl)
    haveI : Algebra.IsIntegral A C := ⟨fun c => by
      obtain ⟨g, hgm, hg⟩ := hCint c c.2
      have hci : IsIntegral A (c : Ω) := ⟨g, hgm, hg⟩
      exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom A C Ω) Subtype.val_injective).mp hci⟩
    haveI : Algebra.IsAlgebraic A C := Algebra.IsIntegral.isAlgebraic
    have hinj : Function.Injective (Polynomial.eval₂RingHom C.subtype y) := by
      rw [injective_iff_map_eq_zero]
      intro H hH
      by_contra hne
      have h1 : IsAlgebraic C y := ⟨H, hne, hH⟩
      have h2 : IsAlgebraic A y := h1.restrictScalars A
      obtain ⟨g, hg0, hg⟩ := h2.pow q
      exact hg0 (htr g hg)
    let e : Polynomial C ≃+* (Polynomial.eval₂RingHom C.subtype y).range :=
      RingEquiv.ofBijective (Polynomial.eval₂RingHom C.subtype y).rangeRestrict
        ⟨fun a b hab => hinj (congrArg Subtype.val hab),
          (Polynomial.eval₂RingHom C.subtype y).rangeRestrict_surjective⟩
    haveI := hCn
    haveI := hCN
    exact ⟨IsIntegrallyClosed.of_equiv e, isNoetherianRing_of_ringEquiv _ e⟩
  have t_root_descent : ∀ (A Ω : Type u) [CommRing A] [Field Ω] (p e : ℕ) [ExpChar Ω p] (κ : A →+* Ω) (β : A → Ω), (∀ a, β a ^ (p ^ e) = κ a) → ∀ (y : Ω) (f : Polynomial A), f.eval₂ κ (y ^ (p ^ e)) = (∑ k ∈ f.support, β (f.coeff k) * y ^ k) ^ (p ^ e) := by
    intro A Ω _ _ p e _ κ β hβ y f
    rw [sum_pow_char_pow, Polynomial.eval₂_eq_sum, Polynomial.sum_def]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [mul_pow, hβ, ← pow_mul, ← pow_mul, mul_comm (p ^ e) k]
  have t_sep_poly : ∀ (R L Ω : Type u) [CommRing R] [IsDomain R] [Field L] [Algebra R L] [Algebra (FractionRing R) L] [IsScalarTower R (FractionRing R) L] [Field Ω] (ι : L →+* Ω) (v : L), IsSeparable (FractionRing R) v → ∃ h : Polynomial R, (h.map (ι.comp (algebraMap R L))).Separable ∧ h.eval₂ (ι.comp (algebraMap R L)) (ι v) = 0 := by
    intro R L Ω _ _ _ _ _ _ _ ι v hv
    obtain ⟨b, hb, hbh⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R)
      (minpoly (FractionRing R) v)
    refine ⟨IsLocalization.integerNormalization (nonZeroDivisors R) (minpoly (FractionRing R) v),
      ?_, ?_⟩
    · have hb0 : algebraMap R (FractionRing R) b ≠ 0 :=
        IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
      have hS : (Polynomial.map (algebraMap R (FractionRing R))
          (IsLocalization.integerNormalization (nonZeroDivisors R)
            (minpoly (FractionRing R) v))).Separable := by
        rw [hbh, ← algebraMap_smul (FractionRing R) b, Polynomial.smul_eq_C_mul]
        exact Polynomial.Separable.unit_mul (Polynomial.isUnit_C.mpr (IsUnit.mk0 _ hb0)) hv
      have hmap := hS.map (f := ι.comp (algebraMap (FractionRing R) L))
      rwa [Polynomial.map_map, RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq] at hmap
    · have h0 := IsLocalization.integerNormalization_aeval_eq_zero (nonZeroDivisors R)
        (minpoly (FractionRing R) v) (R' := L) (minpoly.aeval (FractionRing R) v)
      rw [← Polynomial.hom_eval₂, ← Polynomial.aeval_def, h0, map_zero]
  have t_frob_mem : ∀ (Ω : Type u) [Field Ω] (p e : ℕ) [ExpChar Ω p] (M : Subfield Ω) (n : ℕ) (u γ : Fin n → Ω) (z : Ω), (∀ i, u i ∈ M) → (∀ i, γ i ∈ M) → z ^ (p ^ e) = ∑ i, γ i ^ (p ^ e) * u i ^ (p ^ e) → z ∈ M := by
    intro Ω _ p e _ M n u γ z hu hγ hz
    have h1 : z ^ (p ^ e) = (∑ i, γ i * u i) ^ (p ^ e) := by
      rw [hz, sum_pow_char_pow]
      exact Finset.sum_congr rfl (fun i _ => (mul_pow _ _ _).symm)
    have h2 : z = ∑ i, γ i * u i := by
      apply iterateFrobenius_inj Ω p e
      simp only [iterateFrobenius_def]
      exact h1
    rw [h2]
    exact M.sum_mem (fun i _ => M.mul_mem (hγ i) (hu i))
  have t_finite_embed : ∀ (P L Ω : Type u) [CommRing P] [IsNoetherianRing P] [CommRing L] [Algebra P L] [CommRing Ω] (ι : L →+* Ω), Function.Injective ι → ∀ (S : Subalgebra P L) (I : Type) [Fintype I] (G : I → Ω), (∀ ℓ ∈ S, ∃ s : I → P, ι ℓ = ∑ i, ι (algebraMap P L (s i)) * G i) → Module.Finite P S := by
    intro P L Ω _ _ _ _ _ ι hι S I _ G hrep
    letI : Algebra P Ω := (ι.comp (algebraMap P L)).toAlgebra
    haveI : IsNoetherian P (Submodule.span P (Set.range G)) :=
      isNoetherian_of_fg_of_noetherian _ (Submodule.fg_span (Set.finite_range G))
    let Φ : S →ₗ[P] Submodule.span P (Set.range G) :=
      { toFun := fun s => ⟨ι s, by
          obtain ⟨c, hc⟩ := hrep s s.2
          rw [hc]
          refine Submodule.sum_mem _ (fun i _ => ?_)
          have hm := Submodule.smul_mem (Submodule.span P (Set.range G)) (c i)
            (Submodule.subset_span (⟨i, rfl⟩ : G i ∈ Set.range G))
          exact hm⟩
        map_add' := fun x y => by
          apply Subtype.ext
          show ι ((x : L) + y) = ι x + ι y
          exact map_add ι _ _
        map_smul' := fun c x => by
          apply Subtype.ext
          show ι (c • (x : L)) = (ι.comp (algebraMap P L)) c * ι x
          rw [Algebra.smul_def, map_mul]
          rfl }
    exact Module.Finite.of_injective Φ (fun a b hab => Subtype.ext (hι (congrArg Subtype.val hab)))
  unfold wcpaDjNccNagPoly wcpaDjNccN2
  intro A _ _ hNoeth hN2 L _ _ _ _ hfin
  classical

  have hPL : Function.Injective (algebraMap (Polynomial A) L) := by
    rw [IsScalarTower.algebraMap_eq (Polynomial A) (FractionRing (Polynomial A)) L,
      RingHom.coe_comp]
    exact (algebraMap (FractionRing (Polynomial A)) L).injective.comp
      (IsFractionRing.injective _ _)

  obtain ⟨θ, hθdef⟩ : ∃ θ : Polynomial A →+* AlgebraicClosure L,
      θ = (algebraMap L (AlgebraicClosure L)).comp (algebraMap (Polynomial A) L) := ⟨_, rfl⟩
  have hι : Function.Injective (algebraMap L (AlgebraicClosure L)) :=
    (algebraMap L (AlgebraicClosure L)).injective
  have hθ : Function.Injective θ := by
    rw [hθdef, RingHom.coe_comp]; exact hι.comp hPL
  have hθapp : ∀ f, θ f = algebraMap L (AlgebraicClosure L) (algebraMap (Polynomial A) L f) := by
    intro f; rw [hθdef, RingHom.comp_apply]
  obtain ⟨κ, hκdef⟩ : ∃ κ : A →+* AlgebraicClosure L, κ = θ.comp Polynomial.C := ⟨_, rfl⟩
  have hκ : Function.Injective κ := by
    rw [hκdef, RingHom.coe_comp]; exact hθ.comp Polynomial.C_injective
  have hstar : ∀ f : Polynomial A, θ f = f.eval₂ κ (θ Polynomial.X) := by
    intro f
    have h1 : θ = Polynomial.eval₂RingHom κ (θ Polynomial.X) :=
      Polynomial.ringHom_ext (fun a => by simp [hκdef]) (by simp)
    conv_lhs => rw [h1]
    rfl

  haveI : FiniteDimensional (FractionRing (Polynomial A)) L := hfin
  obtain ⟨e, n, v, hsep, hspan⟩ := t_frob_span (FractionRing (Polynomial A)) L
  obtain ⟨p, hpdef⟩ : ∃ p, p = ringExpChar (FractionRing (Polynomial A)) := ⟨_, rfl⟩
  rw [← hpdef] at hspan
  haveI hpF : ExpChar (FractionRing (Polynomial A)) p := by
    rw [hpdef]; exact ringExpChar.expChar _
  haveI hpΩ : ExpChar (AlgebraicClosure L) p :=
    expChar_of_injective_ringHom (f := (algebraMap L (AlgebraicClosure L)).comp
      (algebraMap (FractionRing (Polynomial A)) L))
      (by rw [RingHom.coe_comp]; exact hι.comp (algebraMap (FractionRing (Polynomial A)) L).injective) p
  have hq : 0 < p ^ e := pow_pos (expChar_pos (FractionRing (Polynomial A)) p) e

  let w := Module.finBasis (FractionRing (Polynomial A)) L
  choose c hc using fun j => hspan (w j)
  choose f g hg hfg using fun j i => IsFractionRing.div_surjective (A := Polynomial A) (c j i)

  choose β hβ using fun a : A => IsAlgClosed.exists_pow_nat_eq (κ a) hq
  obtain ⟨y, hy⟩ := IsAlgClosed.exists_pow_nat_eq (θ Polynomial.X) hq
  let T : Finset (AlgebraicClosure L) := Finset.univ.biUnion (fun ji : Fin _ × Fin n =>
     (f ji.1 ji.2).support.image (fun k => β ((f ji.1 ji.2).coeff k)) ∪
     (g ji.1 ji.2).support.image (fun k => β ((g ji.1 ji.2).coeff k)))
  have hT : ∀ t ∈ T, ∃ g : Polynomial A, g.Monic ∧ g.eval₂ κ t = 0 := by
    intro t ht
    have : ∃ a, t = β a := by
      simp only [T, Finset.mem_biUnion, Finset.mem_union, Finset.mem_image] at ht
      obtain ⟨ji, _, ⟨k, _, rfl⟩ | ⟨k, _, rfl⟩⟩ := ht
      exacts [⟨_, rfl⟩, ⟨_, rfl⟩]
    obtain ⟨a, rfl⟩ := this
    exact ⟨Polynomial.X ^ (p ^ e) - Polynomial.C a, Polynomial.monic_X_pow_sub_C a hq.ne',
      by simp [hβ a]⟩

  obtain ⟨C, hκC, hTC, hCnorm, hCnoeth, ⟨k₁, h, hgen⟩, hCint⟩ :=
    t_normal_model A hNoeth hN2 (AlgebraicClosure L) κ hκ T hT

  have htr : ∀ g : Polynomial A, g.eval₂ κ (y ^ (p ^ e)) = 0 → g = 0 := by
    intro g hg0
    apply hθ
    rw [map_zero, hstar, ← hy, hg0]

  obtain ⟨hBnorm, hBnoeth⟩ :=
    t_adjoin_normal A (AlgebraicClosure L) κ C hCnorm hCnoeth hκC hCint y (p ^ e) hq htr
  have hBspan := t_poly_span A (AlgebraicClosure L) κ C k₁ h hgen y (p ^ e) hq
  obtain ⟨B, hBdef⟩ : ∃ B : Subring (AlgebraicClosure L),
      B = (Polynomial.eval₂RingHom C.subtype y).range := ⟨_, rfl⟩
  rw [← hBdef] at hBnorm hBnoeth hBspan
  haveI := hBnorm
  haveI := hBnoeth
  have hCB : ∀ c ∈ C, c ∈ B := fun c hc => by
    rw [hBdef]; exact RingHom.mem_range.mpr ⟨Polynomial.C ⟨c, hc⟩, by simp⟩
  have hyB : y ∈ B := by
    rw [hBdef]; exact RingHom.mem_range.mpr ⟨Polynomial.X, by simp⟩
  have hθB : ∀ f : Polynomial A, θ f ∈ B := by
    intro f
    rw [hstar, ← hy, Polynomial.eval₂_eq_sum_range]
    exact B.sum_mem (fun i _ => B.mul_mem (hCB _ (hκC _)) (B.pow_mem (B.pow_mem hyB _) _))
  let θB : Polynomial A →+* B := θ.codRestrict B hθB
  have hθB' : B.subtype.comp θB = θ := RingHom.ext fun _ => rfl

  choose hP hPsep hProot using fun i => t_sep_poly (Polynomial A) L
    (AlgebraicClosure L) (algebraMap L (AlgebraicClosure L)) (v i) (hsep i)
  rw [← hθdef] at hPsep hProot
  let hp : Fin n → Polynomial B := fun i => (hP i).map θB
  have hp1 : ∀ i, ((hp i).map B.subtype).Separable := by
    intro i; simp only [hp, Polynomial.map_map, hθB']; exact hPsep i
  have hp2 : ∀ i, (hp i).eval₂ B.subtype (algebraMap L (AlgebraicClosure L) (v i)) = 0 := by
    intro i; simp only [hp, Polynomial.eval₂_map, hθB']; exact hProot i

  obtain ⟨k, gg, hint⟩ := t_sep_span (AlgebraicClosure L) B n
    (fun i => algebraMap L (AlgebraicClosure L) (v i)) hp hp1 hp2

  obtain ⟨M, hMdef⟩ : ∃ M : Subfield (AlgebraicClosure L), M = Subfield.closure
      ((B : Set (AlgebraicClosure L)) ∪ Set.range (fun i => algebraMap L (AlgebraicClosure L) (v i))) :=
    ⟨_, rfl⟩
  rw [← hMdef] at hint
  have hBM : ∀ b ∈ B, b ∈ M := fun b hb => by
    rw [hMdef]; exact Subfield.subset_closure (Or.inl hb)
  have huM : ∀ i, algebraMap L (AlgebraicClosure L) (v i) ∈ M := fun i => by
    rw [hMdef]; exact Subfield.subset_closure (Or.inr ⟨i, rfl⟩)
  have hFdiv : ∀ f g : Polynomial A, algebraMap L (AlgebraicClosure L)
      (algebraMap (FractionRing (Polynomial A)) L
        (algebraMap (Polynomial A) (FractionRing (Polynomial A)) f /
          algebraMap (Polynomial A) (FractionRing (Polynomial A)) g)) = θ f / θ g := by
    intro f g
    rw [map_div₀ (algebraMap (FractionRing (Polynomial A)) L), ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply, map_div₀, hθapp, hθapp]
  have hFM : ∀ d : FractionRing (Polynomial A),
      algebraMap L (AlgebraicClosure L) (algebraMap (FractionRing (Polynomial A)) L d) ∈ M := by
    intro d
    obtain ⟨f, g, _, rfl⟩ := IsFractionRing.div_surjective (A := Polynomial A) d
    rw [hFdiv]; exact M.div_mem (hBM _ (hθB f)) (hBM _ (hθB g))
  have hroot : ∀ f : Polynomial A, θ f = (∑ k ∈ f.support, β (f.coeff k) * y ^ k) ^ (p ^ e) := by
    intro f
    rw [hstar, ← hy]
    exact t_root_descent A (AlgebraicClosure L) p e κ β hβ y f
  have hfB : ∀ j i, (∑ k ∈ (f j i).support, β ((f j i).coeff k) * y ^ k) ∈ B := by
    intro j i
    refine B.sum_mem (fun k hk => B.mul_mem (hCB _ (hTC _ ?_)) (B.pow_mem hyB _))
    exact Finset.mem_biUnion.mpr ⟨(j, i), Finset.mem_univ _,
      Finset.mem_union_left _ (Finset.mem_image_of_mem _ hk)⟩
  have hgB : ∀ j i, (∑ k ∈ (g j i).support, β ((g j i).coeff k) * y ^ k) ∈ B := by
    intro j i
    refine B.sum_mem (fun k hk => B.mul_mem (hCB _ (hTC _ ?_)) (B.pow_mem hyB _))
    exact Finset.mem_biUnion.mpr ⟨(j, i), Finset.mem_univ _,
      Finset.mem_union_right _ (Finset.mem_image_of_mem _ hk)⟩
  have hwM : ∀ j, algebraMap L (AlgebraicClosure L) (w j) ∈ M := by
    intro j
    apply t_frob_mem (AlgebraicClosure L) p e M n
      (fun i => algebraMap L (AlgebraicClosure L) (v i))
      (fun i => (∑ k ∈ (f j i).support, β ((f j i).coeff k) * y ^ k) /
        (∑ k ∈ (g j i).support, β ((g j i).coeff k) * y ^ k))
      (algebraMap L (AlgebraicClosure L) (w j)) huM
      (fun i => M.div_mem (hBM _ (hfB j i)) (hBM _ (hgB j i)))
    rw [← map_pow, hc j, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, map_pow, ← hfg j i, hFdiv, hroot, hroot, div_pow]
  have hLM : ∀ ℓ : L, algebraMap L (AlgebraicClosure L) ℓ ∈ M := by
    intro ℓ
    rw [← w.sum_repr ℓ, map_sum]
    exact M.sum_mem (fun j _ => by
      rw [Algebra.smul_def, map_mul]; exact M.mul_mem (hFM _) (hwM j))

  haveI : IsNoetherianRing (Polynomial A) := Polynomial.isNoetherianRing
  apply t_finite_embed (Polynomial A) L (AlgebraicClosure L)
    (algebraMap L (AlgebraicClosure L)) hι (integralClosure (Polynomial A) L)
    (Fin k × (Fin k₁ × Fin (p ^ e))) (fun al => (h al.2.1 * y ^ (al.2.2 : ℕ)) * gg al.1)
  intro ℓ hℓ
  have hintB : IsIntegral B (algebraMap L (AlgebraicClosure L) ℓ) :=
    IsIntegral.map_of_comp_eq θB (algebraMap L (AlgebraicClosure L))
      (RingHom.ext fun z => by rw [RingHom.comp_apply, RingHom.comp_apply, ← hθapp]; rfl) hℓ
  obtain ⟨r, hr⟩ := hint _ (hLM ℓ) hintB
  choose s hs using fun a => hBspan (r a) (r a).2
  refine ⟨fun al => s al.1 al.2, ?_⟩
  rw [hr, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl (fun a _ => ?_)
  rw [hs a, Finset.sum_mul]
  refine Finset.sum_congr rfl (fun l _ => ?_)
  rw [hy, ← hstar, hθapp]
  ring

theorem wcpa_dj_ncc_ns_local_global (T : Type u) [CommRing T] [IsDomain T] [IsNoetherianRing T]
    (f : T) (hf : f ≠ 0)
    (hden : ∀ z : integralClosure T (FractionRing T), ∃ (k : ℕ) (t : T),
      algebraMap T (integralClosure T (FractionRing T)) t =
        algebraMap T (integralClosure T (FractionRing T)) (f ^ k) * z)
    (hloc : ∀ (m : Ideal T) [m.IsMaximal], wcpaDjNccN1 (Localization.AtPrime m)) :
    wcpaDjNccN1 T :=
by
  classical

  have s1 : ∀ (R : Type u) [CommRing R] (L : Type u) [CommRing L] [Algebra R L]
      [IsFractionRing R L], wcpaDjNccN1 R → Module.Finite R (integralClosure R L) := by
    intro R _ L _ _ _ h
    unfold wcpaDjNccN1 at h
    exact Module.Finite.equiv
      (AlgEquiv.mapIntegralClosure (FractionRing.algEquiv R L)).toLinearEquiv

  have s2 : ∀ (m : Ideal T) [m.IsPrime],
      Module.Finite (Localization.AtPrime m)
        (integralClosure (Localization.AtPrime m) (FractionRing T)) →
      ∃ N : Submodule T (integralClosure T (FractionRing T)), N.FG ∧ (1 ∈ N) ∧
        ∀ z : integralClosure T (FractionRing T), ∃ s : T, s ∉ m ∧ s • z ∈ N := by
    intro m hmp hfin
    obtain ⟨n, c, hc⟩ := Module.Finite.exists_fin (R := Localization.AtPrime m)
      (M := integralClosure (Localization.AtPrime m) (FractionRing T))
    have hci : ∀ i, ∃ s : m.primeCompl, IsIntegral T (s • (c i : FractionRing T)) := fun i =>
      IsIntegral.exists_multiple_integral_of_isLocalization m.primeCompl (c i : FractionRing T)
        ((mem_integralClosure_iff _ _).mp (c i).2)
    choose s hs using hci
    let y : Fin n → integralClosure T (FractionRing T) := fun i =>
      ⟨(s i : T) • (c i : FractionRing T), (mem_integralClosure_iff _ _).mpr (hs i)⟩
    refine ⟨Submodule.span T (insert 1 (Set.range y)), ?_,
      Submodule.subset_span (Set.mem_insert _ _), ?_⟩
    · exact Submodule.fg_span ((Set.finite_range y).insert 1)
    · intro z
      have hzC : (z : FractionRing T) ∈ integralClosure (Localization.AtPrime m) (FractionRing T) :=
        (mem_integralClosure_iff _ _).mpr
          (IsIntegral.tower_top ((mem_integralClosure_iff _ _).mp z.2))
      have hmem : (⟨(z : FractionRing T), hzC⟩ :
          integralClosure (Localization.AtPrime m) (FractionRing T)) ∈
          Submodule.span (Localization.AtPrime m) (Set.range c) := by
        rw [hc]; trivial
      obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hmem
      obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples m.primeCompl Finset.univ a
      choose r hr using fun i => hb i (Finset.mem_univ i)
      have hzK : (z : FractionRing T) = ∑ i, a i • (c i : FractionRing T) := by
        have h := congrArg
          (fun w : integralClosure (Localization.AtPrime m) (FractionRing T) =>
            (w : FractionRing T)) ha
        simp only [AddSubmonoidClass.coe_finsetSum] at h
        exact h.symm
      have hterm : ∀ i, (r i * ∏ j ∈ Finset.univ.erase i, (s j : T)) •
          ((s i : T) • (c i : FractionRing T)) =
          (∏ j, (s j : T)) • (r i • (c i : FractionRing T)) := by
        intro i
        rw [smul_smul, smul_smul, mul_assoc, Finset.prod_erase_mul _ _ (Finset.mem_univ i),
          mul_comm]
      have hbr : ∀ i, (b : T) • (a i • (c i : FractionRing T)) = r i • (c i : FractionRing T) := by
        intro i
        rw [← smul_assoc, ← hr i, algebraMap_smul]
      have hR : ((∑ i, (r i * ∏ j ∈ Finset.univ.erase i, (s j : T)) • y i :
          integralClosure T (FractionRing T)) : FractionRing T) =
          ∑ i, (r i * ∏ j ∈ Finset.univ.erase i, (s j : T)) •
            ((s i : T) • (c i : FractionRing T)) := by
        rw [AddSubmonoidClass.coe_finsetSum]
        rfl
      refine ⟨(∏ i, (s i : T)) * (b : T), ?_, ?_⟩
      · intro hmem'
        rcases hmp.mem_or_mem hmem' with h | h
        · obtain ⟨i, _, hi⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hmp)).mp h
          exact (s i).2 hi
        · exact b.2 h
      · have key : ((∏ i, (s i : T)) * (b : T)) • z =
            ∑ i, (r i * ∏ j ∈ Finset.univ.erase i, (s j : T)) • y i := by
          apply Subtype.ext
          rw [hR]
          show ((∏ i, (s i : T)) * (b : T)) • (z : FractionRing T) = _
          rw [hzK, mul_smul, Finset.smul_sum, Finset.smul_sum]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [hbr i, hterm i]
        rw [key]
        exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _
          (Submodule.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)))

  have s3 : ∀ (B : Type u) [AddCommGroup B] [Module T B], (∀ z : B, f • z = 0 → z = 0) →
      ∀ (N : Submodule T B), N.FG → ∀ (m : Ideal T), m.IsPrime →
      (∀ z : B, ∃ s : T, s ∉ m ∧ s • z ∈ N) →
      ∃ t : T, t ∉ m ∧ ∀ (z : B) (k : ℕ), f ^ k • z ∈ N → t ^ k • z ∈ N := by
    intro B _ _ hfB N hN m hm hl
    let φ : B →ₗ[T] B := LinearMap.lsmul T B f
    have hinj : Function.Injective φ := by
      intro x y hxy
      have hxy' : f • x = f • y := hxy
      have h0 : f • (x - y) = 0 := by
        rw [smul_sub]; exact sub_eq_zero.mpr hxy'
      exact sub_eq_zero.mp (hfB _ h0)
    let P := N.comap φ
    have hPfg : P.FG := by
      apply Submodule.fg_of_fg_map_injective φ hinj
      exact Submodule.FG.of_le hN (Submodule.map_comap_le φ N)
    obtain ⟨g, hg⟩ := hPfg
    have hgl : ∀ p ∈ g, ∃ s : T, s ∉ m ∧ s • p ∈ N := fun p _ => hl p
    choose! sf hsf1 hsf2 using hgl
    refine ⟨∏ p ∈ g, sf p, ?_, ?_⟩
    · intro hmem
      obtain ⟨p, hp, hpm⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hm)).mp hmem
      exact hsf1 p hp hpm
    · have hle : Submodule.span T (g : Set B) ≤
          N.comap (LinearMap.lsmul T B (∏ p ∈ g, sf p)) := by
        rw [Submodule.span_le]
        intro x hx
        show (∏ p ∈ g, sf p) • x ∈ N
        rw [← Finset.prod_erase_mul g sf hx, mul_smul]
        exact N.smul_mem _ (hsf2 x hx)
      have hPt : ∀ p ∈ P, (∏ q ∈ g, sf q) • p ∈ N := by
        intro p hp
        rw [← hg] at hp
        exact hle hp
      intro z k
      induction k generalizing z with
      | zero => simp
      | succ k ih =>
        intro hz
        have h1 : f ^ k • z ∈ P := by
          show f • (f ^ k • z) ∈ N
          rw [smul_smul, ← pow_succ']
          exact hz
        have h2 := hPt _ h1
        rw [smul_comm] at h2
        have h3 := ih _ h2
        rw [smul_smul, ← pow_succ] at h3
        exact h3

  have s4 : ∀ (B : Type u) [AddCommGroup B] [Module T B],
      (∀ m : Ideal T, m.IsMaximal → ∃ t : T, t ∉ m ∧ ∃ N : Submodule T B, N.FG ∧
          ∀ z : B, ∃ k : ℕ, t ^ k • z ∈ N) → Module.Finite T B := by
    intro B _ _ H
    let S : Set T := {t | ∃ N : Submodule T B, N.FG ∧ ∀ z : B, ∃ k : ℕ, t ^ k • z ∈ N}
    have hS : Ideal.span S = ⊤ := by
      by_contra hne
      obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
      obtain ⟨t, ht, N, hN, hz⟩ := H m hm
      exact ht (hle (Ideal.subset_span ⟨N, hN, hz⟩))
    obtain ⟨s', hs'S, hs'⟩ := (Ideal.span_eq_top_iff_finite S).mp hS
    have hSc : ∀ t ∈ S, ∃ N : Submodule T B, N.FG ∧ ∀ z : B, ∃ k : ℕ, t ^ k • z ∈ N :=
      fun t ht => ht
    choose! Nf hNfg kf hkf using hSc
    let M := s'.sup Nf
    have hMfg : M.FG := Submodule.fg_finset_sup s' Nf (fun t ht => hNfg t (hs'S ht))
    have htop : M = ⊤ := by
      rw [eq_top_iff]
      intro z _
      let K := s'.sup (fun t => kf t z)
      have hK : ∀ t ∈ s', t ^ K • z ∈ M := by
        intro t ht
        have hk : kf t z ≤ K := Finset.le_sup (f := fun t => kf t z) ht
        have h1 : t ^ K • z = t ^ (K - kf t z) • (t ^ (kf t z) • z) := by
          rw [smul_smul, ← pow_add, Nat.sub_add_cancel hk]
        rw [h1]
        exact Submodule.smul_mem _ _ (Finset.le_sup (f := Nf) ht (hkf t (hs'S ht) z))
      have hspan := Ideal.span_pow_eq_top (s' : Set T) hs' K
      have hJ : Ideal.span ((fun x => x ^ K) '' (s' : Set T)) ≤
          M.comap (LinearMap.toSpanSingleton T B z) := by
        rw [Ideal.span_le]
        rintro _ ⟨t, ht, rfl⟩
        show (LinearMap.toSpanSingleton T B z) (t ^ K) ∈ M
        rw [LinearMap.toSpanSingleton_apply]
        exact hK t ht
      rw [hspan] at hJ
      have h1 : (LinearMap.toSpanSingleton T B z) 1 ∈ M := hJ Submodule.mem_top
      rwa [LinearMap.toSpanSingleton_apply, one_smul] at h1
    exact ⟨htop ▸ hMfg⟩

  unfold wcpaDjNccN1
  apply s4
  intro m hm
  have := hm
  have h1 : Module.Finite (Localization.AtPrime m)
      (integralClosure (Localization.AtPrime m) (FractionRing T)) :=
    s1 (Localization.AtPrime m) (FractionRing T) (hloc m)
  obtain ⟨N, hNfg, h1N, hNl⟩ := s2 m h1
  have hfB : ∀ z : integralClosure T (FractionRing T), f • z = 0 → z = 0 := by
    intro z hz
    rw [Algebra.smul_def] at hz
    rcases mul_eq_zero.mp hz with h | h
    · exfalso
      apply hf
      have h' := congrArg Subtype.val h
      apply IsFractionRing.injective T (FractionRing T)
      rw [map_zero]
      exact h'
    · exact h
  obtain ⟨t, ht, htk⟩ := s3 _ hfB N hNfg m hm.isPrime hNl
  refine ⟨t, ht, N, hNfg, fun z => ?_⟩
  obtain ⟨k, t₀, hk⟩ := hden z
  refine ⟨k, htk z k ?_⟩
  rw [Algebra.smul_def, ← hk, Algebra.algebraMap_eq_smul_one]
  exact N.smul_mem t₀ h1N

theorem wcpa_dj_ncc_ns_denominator (A K : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [Field K] [Algebra A K] [IsFractionRing A K] (a b : A) (ha : a ≠ 0) (x : K)
    (hx : algebraMap A K a * x = algebraMap A K b) :
    ∀ z : integralClosure (Algebra.adjoin A ({x} : Set K))
        (FractionRing (Algebra.adjoin A ({x} : Set K))),
      ∃ (k : ℕ) (t : Algebra.adjoin A ({x} : Set K)),
        algebraMap (Algebra.adjoin A ({x} : Set K))
          (integralClosure (Algebra.adjoin A ({x} : Set K))
            (FractionRing (Algebra.adjoin A ({x} : Set K)))) t =
          algebraMap (Algebra.adjoin A ({x} : Set K))
            (integralClosure (Algebra.adjoin A ({x} : Set K))
              (FractionRing (Algebra.adjoin A ({x} : Set K))))
            ((algebraMap A (Algebra.adjoin A ({x} : Set K)) a) ^ k) * z :=
by
  classical
  intro z
  set S := Algebra.adjoin A ({x} : Set K) with hSdef

  have hden : ∀ s ∈ S, ∃ N : ℕ, ∃ c : A, algebraMap A K a ^ N * s = algebraMap A K c := by
    intro s hs
    induction hs using Algebra.adjoin_induction with
    | mem y hy =>
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact ⟨1, b, by rw [pow_one]; exact hx⟩
    | algebraMap r => exact ⟨0, r, by rw [pow_zero, one_mul]⟩
    | add y y' _ _ h h' =>
      obtain ⟨N, c, hc⟩ := h
      obtain ⟨N', c', hc'⟩ := h'
      refine ⟨N + N', a ^ N' * c + a ^ N * c', ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, ← hc, ← hc']
      ring
    | mul y y' _ _ h h' =>
      obtain ⟨N, c, hc⟩ := h
      obtain ⟨N', c', hc'⟩ := h'
      refine ⟨N + N', c * c', ?_⟩
      rw [map_mul, ← hc, ← hc']
      ring
  have hup : ∀ (s : K) (N M : ℕ) (c : A), N ≤ M → algebraMap A K a ^ N * s = algebraMap A K c →
      ∃ c' : A, algebraMap A K a ^ M * s = algebraMap A K c' := by
    intro s N M c hNM h
    refine ⟨a ^ (M - N) * c, ?_⟩
    rw [map_mul, map_pow, ← h, ← mul_assoc, ← pow_add, Nat.sub_add_cancel hNM]

  have hinj : Function.Injective (algebraMap S K) := Subtype.val_injective
  let φ : FractionRing S →+* K := IsFractionRing.lift hinj
  have hφ : ∀ s : S, φ (algebraMap S (FractionRing S) s) = (s : K) := fun s =>
    IsFractionRing.lift_algebraMap hinj s
  have hφinj : Function.Injective φ := φ.injective

  have hz : IsIntegral S (z : FractionRing S) := z.2
  obtain ⟨p, hpm, hpz⟩ := hz
  set w := φ (z : FractionRing S) with hw
  have hpw : Polynomial.eval₂ (algebraMap S K) w p = 0 := by
    have h1 := Polynomial.hom_eval₂ p (algebraMap S (FractionRing S)) φ (z : FractionRing S)
    rw [hpz, map_zero] at h1
    have e : φ.comp (algebraMap S (FractionRing S)) = algebraMap S K := by
      ext s; exact hφ s
    rw [e] at h1
    exact h1.symm
  set n := p.natDegree with hn
  choose Nf cf hNf using fun i : ℕ => hden ((p.coeff i : S) : K) (p.coeff i).2
  set N := ∑ i ∈ Finset.range (n + 1), Nf i with hN
  have hcoef : ∀ i : ℕ, ∃ c : A,
      (algebraMap A K a ^ N) ^ (n - i) * ((p.coeff i : S) : K) = algebraMap A K c := by
    intro i
    by_cases hi : i < n
    · have h1 : Nf i ≤ N :=
        Finset.single_le_sum (fun j _ => Nat.zero_le (Nf j)) (Finset.mem_range.mpr (by omega))
      have h2 : N ≤ N * (n - i) := Nat.le_mul_of_pos_right N (by omega)
      rw [← pow_mul]
      exact hup _ _ _ _ (h1.trans h2) (hNf i)
    · have h0 : n - i = 0 := by omega
      rw [h0, pow_zero, one_mul]
      rcases Nat.lt_or_ge n i with h | h
      · refine ⟨0, ?_⟩
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt h]
        simp
      · have hin : i = n := by omega
        refine ⟨1, ?_⟩
        rw [hin, hn, hpm.coeff_natDegree]
        simp

  set rS : S := algebraMap A S (a ^ N) with hrS
  have hrSK : ((rS : S) : K) = algebraMap A K a ^ N := by
    rw [hrS, Subalgebra.coe_algebraMap, map_pow]
  have hlift : p.scaleRoots rS ∈ Polynomial.lifts (algebraMap A S) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i
    obtain ⟨c, hc⟩ := hcoef i
    refine ⟨c, ?_⟩
    rw [Polynomial.coeff_scaleRoots]
    apply Subtype.ext
    rw [Subalgebra.coe_mul, Subalgebra.coe_pow, hrSK, Subalgebra.coe_algebraMap, mul_comm]
    exact hc.symm
  obtain ⟨q', hq'map, -, hq'm⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic hlift (Polynomial.monic_scaleRoots_iff rS |>.mpr hpm)
  have hint : IsIntegral A (algebraMap A K a ^ N * w) := by
    refine ⟨q', hq'm, ?_⟩
    have hfr : algebraMap A K a ^ N = algebraMap S K rS := by rw [← hrSK]; rfl
    have hcomp : (algebraMap S K).comp (algebraMap A S) = algebraMap A K :=
      (IsScalarTower.algebraMap_eq A S K).symm
    have h1 := Polynomial.eval₂_map (p := q') (algebraMap A S) (algebraMap S K)
      (algebraMap A K a ^ N * w)
    rw [hcomp, hq'map] at h1
    rw [← h1, hfr]
    exact (Polynomial.scaleRoots_eval₂_mul (algebraMap S K) w rS).trans (by rw [hpw, mul_zero])

  obtain ⟨c, hc⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint

  refine ⟨N, algebraMap A S c, ?_⟩
  apply Subtype.ext
  apply hφinj
  rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap, map_mul, hφ, hφ,
    Subalgebra.coe_algebraMap, ← map_pow, Subalgebra.coe_algebraMap, map_pow, hc]

theorem wcpa_dj_ncc_ns_reduce_local : wcpaDjNccNsLoc.{u} →
    ∀ (A K : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [Field K] [Algebra A K]
      [IsFractionRing A K], wcpaDjNccNag A →
      ∀ (x : K) (m : Ideal (Algebra.adjoin A ({x} : Set K))) [m.IsMaximal],
        wcpaDjNccN1 (Localization.AtPrime m) :=
by
  intro hLoc A K _ _ _ _ _ _ hNag x m hm
  have s1 : ∀ (D₀ D : Type u) [CommRing D₀] [IsDomain D₀] [CommRing D] [IsDomain D]
      [Algebra D₀ D] (M₀ : Submonoid D₀) (hM₀ : M₀ ≤ nonZeroDivisors D₀) [IsLocalization M₀ D],
      wcpaDjNccN2 D₀ → wcpaDjNccN2 D := by
    intro D₀ D _ _ _ _ _ M₀ hM₀ _ h L _ _ _ _ hfin
    letI : Algebra D₀ L := ((algebraMap D L).comp (algebraMap D₀ D)).toAlgebra
    haveI : IsScalarTower D₀ D L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hinjD : Function.Injective (algebraMap D L) := by
      rw [IsScalarTower.algebraMap_eq D (FractionRing D) L]
      exact (algebraMap (FractionRing D) L).injective.comp
        (IsFractionRing.injective D (FractionRing D))
    have hinj : Function.Injective (algebraMap D₀ L) := by
      rw [IsScalarTower.algebraMap_eq D₀ D L]
      exact hinjD.comp (IsLocalization.injective D hM₀)
    haveI : FaithfulSMul D₀ L := (faithfulSMul_iff_algebraMap_injective D₀ L).mpr hinj
    letI : Algebra (FractionRing D₀) L := FractionRing.liftAlgebra D₀ L
    haveI : IsScalarTower D₀ (FractionRing D₀) L := FractionRing.isScalarTower_liftAlgebra D₀ L
    have key1 : ∀ t : D₀, algebraMap (FractionRing D₀) L (algebraMap D₀ (FractionRing D₀) t) =
        algebraMap D L (algebraMap D₀ D t) := fun t =>
      (IsScalarTower.algebraMap_apply D₀ (FractionRing D₀) L t).symm.trans
        (IsScalarTower.algebraMap_apply D₀ D L t)
    have key2 : ∀ t : D, algebraMap (FractionRing D) L (algebraMap D (FractionRing D) t) =
        algebraMap D L t := fun t => (IsScalarTower.algebraMap_apply D (FractionRing D) L t).symm
    have hμ : ∀ μ : M₀, algebraMap D L (algebraMap D₀ D μ) ≠ 0 := fun μ =>
      ((IsLocalization.map_units D μ).map (algebraMap D L)).ne_zero
    have claim : ∀ c : FractionRing D, ∃ c' : FractionRing D₀,
        algebraMap (FractionRing D) L c = algebraMap (FractionRing D₀) L c' := by
      intro c
      obtain ⟨d, d', hd', rfl⟩ := IsFractionRing.div_surjective (A := D) c
      obtain ⟨⟨e, μ⟩, he⟩ := IsLocalization.surj M₀ d
      obtain ⟨⟨e', μ'⟩, he'⟩ := IsLocalization.surj M₀ d'
      simp only at he he'
      refine ⟨algebraMap D₀ (FractionRing D₀) (e * μ') /
        algebraMap D₀ (FractionRing D₀) (e' * μ), ?_⟩
      have hd'0 : algebraMap D L d' ≠ 0 := fun h0 =>
        nonZeroDivisors.ne_zero hd' (hinjD (h0.trans (map_zero _).symm))
      have h1 := hμ μ
      have h2 := hμ μ'
      rw [map_div₀, map_div₀, key1, key1, key2, key2]
      simp only [map_mul]
      rw [← he, ← he']
      simp only [map_mul]
      field_simp
    have hfin0 : Module.Finite (FractionRing D₀) L := by
      obtain ⟨B, hB⟩ := Module.Finite.fg_top (R := FractionRing D) (M := L)
      refine ⟨⟨B, ?_⟩⟩
      rw [eq_top_iff]
      rintro l -
      have hl : l ∈ Submodule.span (FractionRing D) (B : Set L) := by rw [hB]; trivial
      induction hl using Submodule.span_induction with
      | mem y hy => exact Submodule.subset_span hy
      | zero => exact zero_mem _
      | add y z _ _ hy hz => exact add_mem hy hz
      | smul c y _ hy =>
        obtain ⟨c', hc'⟩ := claim c
        rw [Algebra.smul_def, hc', ← Algebra.smul_def]
        exact Submodule.smul_mem _ _ hy
    have hI0 : Module.Finite D₀ (integralClosure D₀ L) := h L hfin0
    obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := D₀) (M := integralClosure D₀ L)
    let G : Set L := Subtype.val '' (s : Set (integralClosure D₀ L))
    have hspan0 : ∀ w : integralClosure D₀ L, (w : L) ∈ Submodule.span D₀ G := by
      intro w
      have hw : w ∈ Submodule.span D₀ (s : Set (integralClosure D₀ L)) := by rw [hs]; trivial
      exact Submodule.apply_mem_span_image_of_mem_span (integralClosure D₀ L).val.toLinearMap hw
    have heq : (integralClosure D L).toSubmodule = Submodule.span D G := by
      apply le_antisymm
      · intro z hz
        obtain ⟨μ, hμz⟩ := IsIntegral.exists_multiple_integral_of_isLocalization M₀ z hz
        have h1 : (μ : D₀) • z ∈ (Submodule.span D G).restrictScalars D₀ :=
          Submodule.span_le_restrictScalars D₀ D G (hspan0 ⟨_, hμz⟩)
        have h2 : algebraMap D₀ D μ • z ∈ Submodule.span D G := by
          rw [algebraMap_smul]; exact h1
        obtain ⟨v, hv⟩ := IsLocalization.map_units D μ
        have h3 : z = (↑v⁻¹ : D) • (algebraMap D₀ D μ • z) := by
          rw [← hv, smul_smul, Units.inv_mul, one_smul]
        rw [h3]
        exact Submodule.smul_mem _ _ h2
      · rw [Submodule.span_le]
        rintro _ ⟨w, _, rfl⟩
        exact IsIntegral.tower_top w.2
    have hFG : (integralClosure D L).toSubmodule.FG := by
      rw [heq]
      exact Submodule.fg_span (s.finite_toSet.image _)
    exact Module.Finite.iff_fg.mpr hFG
  have s2 : ∀ (A Aₘ D : Type u) [CommRing A] [CommRing Aₘ] [Algebra A Aₘ] (M : Submonoid A)
      [IsLocalization M Aₘ] [CommRing D] [IsDomain D] [Algebra Aₘ D],
      Function.Surjective (algebraMap Aₘ D) →
      ∃ (D₀ : Type u) (_ : CommRing D₀) (_ : IsDomain D₀) (_ : Algebra A D₀) (_ : Algebra D₀ D)
        (M₀ : Submonoid D₀), Function.Surjective (algebraMap A D₀) ∧ M₀ ≤ nonZeroDivisors D₀ ∧
          IsLocalization M₀ D := by
    intro A Aₘ D _ _ _ M _ _ _ _ hD
    let g : A →+* D := (algebraMap Aₘ D).comp (algebraMap A Aₘ)
    have hu : ∀ a ∈ M, IsUnit (g a) := fun a ha =>
      (IsLocalization.map_units Aₘ (⟨a, ha⟩ : M)).map (algebraMap Aₘ D)
    letI : Algebra A g.range := g.rangeRestrict.toAlgebra
    letI : Algebra g.range D := g.range.subtype.toAlgebra
    refine ⟨g.range, inferInstance, inferInstance, inferInstance, inferInstance,
      M.map g.rangeRestrict, g.rangeRestrict_surjective, ?_, ?_⟩
    · rintro _ ⟨a, ha, rfl⟩
      apply mem_nonZeroDivisors_of_ne_zero
      intro h
      have : g a = 0 := congrArg Subtype.val h
      exact (hu a ha).ne_zero this
    · refine ⟨?_, ?_, ?_⟩
      · rintro ⟨_, a, ha, rfl⟩
        exact hu a ha
      · intro z
        obtain ⟨y, rfl⟩ := hD z
        obtain ⟨⟨b, a⟩, hy⟩ := IsLocalization.surj M y
        refine ⟨⟨g.rangeRestrict b, ⟨g.rangeRestrict a, a, a.2, rfl⟩⟩, ?_⟩
        show algebraMap Aₘ D y * g a = g b
        simp only [g, RingHom.comp_apply, ← map_mul, hy]
      · intro s s' h
        exact ⟨1, by simpa using Subtype.ext h⟩
  have s3pre : ∀ (A K Aₘ : Type u) [CommRing A] [Field K] [Algebra A K] [CommRing Aₘ]
      [Algebra A Aₘ] [Algebra Aₘ K] [IsScalarTower A Aₘ K] (M : Submonoid A) [IsLocalization M Aₘ]
      (x : K) (φ : Algebra.adjoin A ({x} : Set K) →+* Algebra.adjoin Aₘ ({x} : Set K)),
      (∀ s, ((φ s : Algebra.adjoin Aₘ ({x} : Set K)) : K) = (s : K)) →
      (∀ y ∈ Algebra.adjoin Aₘ ({x} : Set K), ∃ a ∈ M,
        algebraMap A K a * y ∈ Algebra.adjoin A ({x} : Set K)) →
        @IsLocalization (Algebra.adjoin A ({x} : Set K)) _
          (Algebra.algebraMapSubmonoid (Algebra.adjoin A ({x} : Set K)) M)
          (Algebra.adjoin Aₘ ({x} : Set K)) _ φ.toAlgebra := by
    intro A K Aₘ _ _ _ _ _ _ _ M _ x φ hφv hkey
    have hφinj : Function.Injective φ := by
      intro s s' h
      apply Subtype.ext
      rw [← hφv s, ← hφv s', h]
    have hφa : ∀ a : A, φ (algebraMap A (Algebra.adjoin A ({x} : Set K)) a) =
        algebraMap Aₘ (Algebra.adjoin Aₘ ({x} : Set K)) (algebraMap A Aₘ a) := by
      intro a
      apply Subtype.ext
      rw [hφv, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap,
        ← IsScalarTower.algebraMap_apply]
    letI := φ.toAlgebra
    have halg : algebraMap (Algebra.adjoin A ({x} : Set K)) (Algebra.adjoin Aₘ ({x} : Set K)) =
        φ := RingHom.algebraMap_toAlgebra φ
    refine ⟨?_, ?_, ?_⟩
    · intro y
      obtain ⟨_, ⟨a, ha, rfl⟩⟩ := y
      rw [halg]
      have e : φ (algebraMap A (Algebra.adjoin A ({x} : Set K)) a) =
          algebraMap Aₘ (Algebra.adjoin Aₘ ({x} : Set K)) (algebraMap A Aₘ a) := hφa a
      exact e ▸ (IsLocalization.map_units Aₘ (⟨a, ha⟩ : M)).map _
    · intro z
      obtain ⟨a, ha, h⟩ := hkey z z.2
      refine ⟨⟨⟨_, h⟩, ⟨algebraMap A _ a, a, ha, rfl⟩⟩, ?_⟩
      rw [halg]
      apply Subtype.ext
      rw [Subalgebra.coe_mul, hφv, hφv, Subalgebra.coe_algebraMap, mul_comm]
    · intro s s' h
      rw [halg] at h
      exact ⟨1, by rw [hφinj h]⟩
  have s3key : ∀ (A K Aₘ : Type u) [CommRing A] [Field K] [Algebra A K] [CommRing Aₘ]
      [Algebra A Aₘ] [Algebra Aₘ K] [IsScalarTower A Aₘ K] (M : Submonoid A) [IsLocalization M Aₘ]
      (x : K), ∀ y ∈ Algebra.adjoin Aₘ ({x} : Set K), ∃ a ∈ M,
        algebraMap A K a * y ∈ Algebra.adjoin A ({x} : Set K) := by
    intro A K Aₘ _ _ _ _ _ _ _ M _ x y hy
    induction hy using Algebra.adjoin_induction with
    | mem y hy =>
      rw [Set.mem_singleton_iff] at hy
      subst hy
      refine ⟨1, M.one_mem, ?_⟩
      rw [map_one, one_mul]
      exact Algebra.self_mem_adjoin_singleton A y
    | algebraMap c =>
      obtain ⟨⟨b, a⟩, h⟩ := IsLocalization.surj M c
      refine ⟨a, a.2, ?_⟩
      have : algebraMap A K a * algebraMap Aₘ K c = algebraMap A K b := by
        rw [IsScalarTower.algebraMap_apply A Aₘ K, IsScalarTower.algebraMap_apply A Aₘ K b, ← h,
          map_mul, mul_comm]
      rw [this]
      exact Subalgebra.algebraMap_mem _ b
    | add y z _ _ hy hz =>
      obtain ⟨a, ha, hya⟩ := hy
      obtain ⟨b, hb, hzb⟩ := hz
      refine ⟨a * b, M.mul_mem ha hb, ?_⟩
      have : algebraMap A K (a * b) * (y + z) = algebraMap A K b * (algebraMap A K a * y) +
          algebraMap A K a * (algebraMap A K b * z) := by rw [map_mul]; ring
      rw [this]
      exact add_mem (mul_mem (Subalgebra.algebraMap_mem _ b) hya)
        (mul_mem (Subalgebra.algebraMap_mem _ a) hzb)
    | mul y z _ _ hy hz =>
      obtain ⟨a, ha, hya⟩ := hy
      obtain ⟨b, hb, hzb⟩ := hz
      refine ⟨a * b, M.mul_mem ha hb, ?_⟩
      have : algebraMap A K (a * b) * (y * z) =
          (algebraMap A K a * y) * (algebraMap A K b * z) := by
        rw [map_mul]; ring
      rw [this]
      exact mul_mem hya hzb
  have s3 : ∀ (A K Aₘ : Type u) [CommRing A] [Field K] [Algebra A K] [CommRing Aₘ]
      [Algebra A Aₘ] [Algebra Aₘ K] [IsScalarTower A Aₘ K] (M : Submonoid A) [IsLocalization M Aₘ]
      (x : K), ∃ φ : Algebra.adjoin A ({x} : Set K) →+* Algebra.adjoin Aₘ ({x} : Set K),
        (∀ s : Algebra.adjoin A ({x} : Set K),
          ((φ s : Algebra.adjoin Aₘ ({x} : Set K)) : K) = (s : K)) ∧
        @IsLocalization (Algebra.adjoin A ({x} : Set K)) _
          (Algebra.algebraMapSubmonoid (Algebra.adjoin A ({x} : Set K)) M)
          (Algebra.adjoin Aₘ ({x} : Set K)) _ φ.toAlgebra := by
    intro A K Aₘ _ _ _ _ _ _ _ M _ x
    have hle : Algebra.adjoin A ({x} : Set K) ≤
        (Algebra.adjoin Aₘ ({x} : Set K)).restrictScalars A := by
      apply Algebra.adjoin_le
      rw [Set.singleton_subset_iff]
      exact Algebra.self_mem_adjoin_singleton Aₘ x
    exact ⟨(Subalgebra.inclusion hle).toRingHom, fun s => rfl,
      s3pre A K Aₘ M x _ (fun s => rfl) (s3key A K Aₘ M x)⟩
  have s4 : ∀ (S S₁ : Type u) [CommRing S] [CommRing S₁] [Algebra S S₁]
      (M : Submonoid S) [IsLocalization M S₁] (m : Ideal S) [m.IsPrime] (m₁ : Ideal S₁)
      [m₁.IsPrime], m₁.comap (algebraMap S S₁) = m →
      Nonempty (Localization.AtPrime m ≃+* Localization.AtPrime m₁) := by
    intro S S₁ _ _ _ M _ m _ m₁ _ hm
    have h := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M
      (Localization.AtPrime m₁) m₁
    subst hm
    exact ⟨(IsLocalization.algEquiv (m₁.comap (algebraMap S S₁)).primeCompl
      (Localization.AtPrime _) (Localization.AtPrime m₁)).toRingEquiv⟩
  have s5 : ∀ (T T' : Type u) [CommRing T] [CommRing T'] (e : T ≃+* T'),
      wcpaDjNccN1 T → wcpaDjNccN1 T' := by
    intro T T' _ _ e h
    unfold wcpaDjNccN1 at *
    let E : FractionRing T ≃+* FractionRing T' := IsFractionRing.ringEquivOfRingEquiv e
    have hE : ∀ t, E (algebraMap T (FractionRing T) t) =
        algebraMap T' (FractionRing T') (e t) :=
      fun t => IsFractionRing.ringEquivOfRingEquiv_algebraMap e t
    have hEs : ∀ t, E.symm (algebraMap T' (FractionRing T') t) =
        algebraMap T (FractionRing T) (e.symm t) := by
      intro t
      apply E.injective
      rw [RingEquiv.apply_symm_apply, hE, RingEquiv.apply_symm_apply]
    have hc1 : (algebraMap T' (FractionRing T')).comp e.toRingHom =
        E.toRingHom.comp (algebraMap T (FractionRing T)) := by
      ext t; exact (hE t).symm
    have hc2 : (algebraMap T (FractionRing T)).comp e.symm.toRingHom =
        E.symm.toRingHom.comp (algebraMap T' (FractionRing T')) := by
      ext t; exact (hEs t).symm
    let e₂ : integralClosure T (FractionRing T) ≃+* integralClosure T' (FractionRing T') :=
      { toFun := fun z => ⟨E z, IsIntegral.map_of_comp_eq e.toRingHom E.toRingHom hc1 z.2⟩
        invFun := fun z => ⟨E.symm z,
          IsIntegral.map_of_comp_eq e.symm.toRingHom E.symm.toRingHom hc2 z.2⟩
        left_inv := fun z => Subtype.ext (E.symm_apply_apply z)
        right_inv := fun z => Subtype.ext (E.apply_symm_apply z)
        map_mul' := fun z w => Subtype.ext (map_mul E (z : FractionRing T) w)
        map_add' := fun z w => Subtype.ext (map_add E (z : FractionRing T) w) }
    refine Module.Finite.of_equiv_equiv e e₂ ?_
    ext t
    exact (hE t).symm

  let n : Ideal A := m.comap (algebraMap A (Algebra.adjoin A ({x} : Set K)))
  haveI hn : n.IsPrime := Ideal.IsPrime.comap _
  haveI : IsNoetherianRing A := hNag.1
  haveI : IsIntegrallyClosed (Localization.AtPrime n) :=
    isIntegrallyClosed_of_isLocalization (Localization.AtPrime n) n.primeCompl
      (Ideal.primeCompl_le_nonZeroDivisors n)
  have hunit : ∀ y : n.primeCompl, IsUnit (algebraMap A K y) := by
    intro y
    apply IsUnit.mk0
    intro h
    apply y.2
    have : (y : A) = 0 := IsFractionRing.injective A K (h.trans (map_zero _).symm)
    rw [this]; exact n.zero_mem
  letI : Algebra (Localization.AtPrime n) K := (IsLocalization.lift hunit).toAlgebra
  haveI : IsScalarTower A (Localization.AtPrime n) K :=
    IsScalarTower.of_algebraMap_eq (fun a => (IsLocalization.lift_eq hunit a).symm)
  haveI : IsFractionRing (Localization.AtPrime n) K :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization n.primeCompl
      (Localization.AtPrime n) K
  have hNag₁ : wcpaDjNccNag (Localization.AtPrime n) := by
    refine ⟨IsLocalization.isNoetherianRing n.primeCompl _ hNag.1, ?_⟩
    intro D _ _ _ hD
    obtain ⟨D₀, _, _, _, _, M₀, hsurj, hM₀, hloc⟩ :=
      s2 A (Localization.AtPrime n) D n.primeCompl hD
    exact s1 D₀ D M₀ hM₀ (hNag.2 D₀ hsurj)
  obtain ⟨φ, hφv, hφloc⟩ := s3 A K (Localization.AtPrime n) n.primeCompl x
  letI : Algebra (Algebra.adjoin A ({x} : Set K))
      (Algebra.adjoin (Localization.AtPrime n) ({x} : Set K)) := φ.toAlgebra
  haveI := hφloc
  have halg : algebraMap (Algebra.adjoin A ({x} : Set K))
      (Algebra.adjoin (Localization.AtPrime n) ({x} : Set K)) = φ := RingHom.algebraMap_toAlgebra φ
  have hdisj : Disjoint
      ((Algebra.algebraMapSubmonoid (Algebra.adjoin A ({x} : Set K)) n.primeCompl :
        Submonoid (Algebra.adjoin A ({x} : Set K))) : Set (Algebra.adjoin A ({x} : Set K)))
      (m : Set (Algebra.adjoin A ({x} : Set K))) := by
    rw [Set.disjoint_left]
    intro y hy hym
    obtain ⟨a, ha, rfl⟩ := Submonoid.mem_map.mp hy
    exact ha hym
  haveI hm₁ : (m.map (algebraMap (Algebra.adjoin A ({x} : Set K))
      (Algebra.adjoin (Localization.AtPrime n) ({x} : Set K)))).IsMaximal :=
    IsLocalization.isMaximal_of_isMaximal_disjoint
      (Algebra.algebraMapSubmonoid (Algebra.adjoin A ({x} : Set K)) n.primeCompl) _ m hdisj
  have hcomap : (m.map (algebraMap (Algebra.adjoin A ({x} : Set K))
      (Algebra.adjoin (Localization.AtPrime n) ({x} : Set K)))).comap
      (algebraMap (Algebra.adjoin A ({x} : Set K))
        (Algebra.adjoin (Localization.AtPrime n) ({x} : Set K))) = m :=
    IsLocalization.under_map_of_isPrime_disjoint
      (Algebra.algebraMapSubmonoid (Algebra.adjoin A ({x} : Set K)) n.primeCompl) _
      inferInstance hdisj
  have hcomp : (algebraMap (Localization.AtPrime n)
      (Algebra.adjoin (Localization.AtPrime n) ({x} : Set K))).comp
        (algebraMap A (Localization.AtPrime n)) =
      (algebraMap (Algebra.adjoin A ({x} : Set K))
        (Algebra.adjoin (Localization.AtPrime n) ({x} : Set K))).comp
        (algebraMap A (Algebra.adjoin A ({x} : Set K))) := by
    ext a
    rw [RingHom.comp_apply, RingHom.comp_apply, halg]
    rw [hφv, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap,
      ← IsScalarTower.algebraMap_apply]
  have hg6 : (m.map (algebraMap (Algebra.adjoin A ({x} : Set K))
      (Algebra.adjoin (Localization.AtPrime n) ({x} : Set K)))).comap
      (algebraMap (Localization.AtPrime n)
        (Algebra.adjoin (Localization.AtPrime n) ({x} : Set K))) =
      IsLocalRing.maximalIdeal (Localization.AtPrime n) := by
    apply le_antisymm
    · apply IsLocalRing.le_maximalIdeal
      exact (Ideal.IsPrime.comap _ : Ideal.IsPrime _).ne_top
    · rw [← Localization.AtPrime.map_eq_maximalIdeal (I := n), Ideal.map_le_iff_le_comap,
        Ideal.comap_comap, hcomp, ← Ideal.comap_comap, hcomap]
  have hN1 := hLoc (Localization.AtPrime n) K hNag₁ x _ hg6
  obtain ⟨e⟩ := s4 _ _
    (Algebra.algebraMapSubmonoid (Algebra.adjoin A ({x} : Set K)) n.primeCompl) m _ hcomap
  exact s5 _ _ e.symm hN1

theorem wcpa_dj_ncc_ns_local : wcpaDjNccNsCore.{u} → wcpaDjNccNsLoc.{u} :=
by

  have s1 : ∀ (A K : Type u) [CommRing A] [IsLocalRing A] [Field K] [Algebra A K] (x : K)
      (m : Ideal (Algebra.adjoin A ({x} : Set K))) [m.IsMaximal],
      m.comap (algebraMap A (Algebra.adjoin A ({x} : Set K))) = IsLocalRing.maximalIdeal A →
      ∃ f : Polynomial A, f.Monic ∧
        Polynomial.aeval (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
          Algebra.adjoin A ({x} : Set K)) f ∈ m := by
    intro A K _ _ _ _ x m _ hm
    classical
    have hZ : ∀ q : Polynomial A, (∀ k, q.coeff k ∈ IsLocalRing.maximalIdeal A) →
        Polynomial.aeval (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
          Algebra.adjoin A ({x} : Set K)) q ∈ m := by
      intro q hq
      rw [Polynomial.aeval_eq_sum_range]
      refine Ideal.sum_mem _ (fun k _ => ?_)
      rw [Algebra.smul_def]
      refine Ideal.mul_mem_right _ _ ?_
      have := hq k
      rw [← hm, Ideal.mem_comap] at this
      exact this
    by_cases hX : (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
          Algebra.adjoin A ({x} : Set K)) ∈ m
    · exact ⟨Polynomial.X, Polynomial.monic_X, by rw [Polynomial.aeval_X]; exact hX⟩
    obtain ⟨y, i, hi, hyi⟩ := Ideal.IsMaximal.exists_inv ‹m.IsMaximal› hX
    have hy : (y : K) ∈ (Polynomial.aeval (R := A) x).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval]; exact y.2
    obtain ⟨h, hh⟩ := hy
    have hhS : Polynomial.aeval (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
          Algebra.adjoin A ({x} : Set K)) h = y :=
      Subtype.ext (by rw [Polynomial.aeval_subalgebra_coe]; exact hh)
    set g : Polynomial A := Polynomial.X * h - 1 with hgdef
    have hg : Polynomial.aeval (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
          Algebra.adjoin A ({x} : Set K)) g = -i := by
      simp only [g, map_sub, map_mul, Polynomial.aeval_X, hhS, map_one]
      rw [← hyi]; ring
    have hgm : Polynomial.aeval (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
          Algebra.adjoin A ({x} : Set K)) g ∈ m := by rw [hg]; exact m.neg_mem_iff.mpr hi
    set π := IsLocalRing.residue A
    set gb := g.map π with hgb
    have hgb0 : gb ≠ 0 := by
      intro h0
      have h1 := congrArg (fun p => p.coeff 0) h0
      simp only [gb, g, Polynomial.coeff_map, Polynomial.coeff_sub, Polynomial.mul_coeff_zero,
        Polynomial.coeff_X_zero, zero_mul, Polynomial.coeff_one_zero, zero_sub, map_neg, map_one,
        Polynomial.coeff_zero] at h1
      exact one_ne_zero (neg_eq_zero.mp h1)
    set v := gb.leadingCoeff with hv
    have hv0 : v ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hgb0
    set p := Polynomial.C v⁻¹ * gb with hp
    have hpm : p.Monic := Polynomial.monic_C_mul_of_mul_leadingCoeff_eq_one (inv_mul_cancel₀ hv0)
    have hpl : p ∈ Polynomial.lifts π :=
      (Polynomial.lifts_iff_coeff_lifts p).mpr (fun n => IsLocalRing.residue_surjective _)
    obtain ⟨f, hfmap, _, hfmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hpl hpm
    obtain ⟨w, hw⟩ := IsLocalRing.residue_surjective v⁻¹
    have hdiff : ∀ k, (f - Polynomial.C w * g).coeff k ∈ IsLocalRing.maximalIdeal A := by
      intro k
      rw [← IsLocalRing.residue_eq_zero_iff]
      have h2 : (f - Polynomial.C w * g).map π = 0 := by
        rw [Polynomial.map_sub, hfmap, Polynomial.map_mul, Polynomial.map_C, ← hgb]
        change p - Polynomial.C (π w) * gb = 0
        rw [hw, sub_self]
      have h3 := congrArg (fun q => q.coeff k) h2
      simpa only [Polynomial.coeff_map, Polynomial.coeff_zero] using h3
    refine ⟨f, hfmon, ?_⟩
    have e : Polynomial.aeval (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
          Algebra.adjoin A ({x} : Set K)) f =
        Polynomial.aeval (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
          Algebra.adjoin A ({x} : Set K)) (f - Polynomial.C w * g) +
        algebraMap A (Algebra.adjoin A ({x} : Set K)) w *
          Polynomial.aeval (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
            Algebra.adjoin A ({x} : Set K)) g := by
      rw [map_sub, map_mul, Polynomial.aeval_C]; ring
    rw [e]
    exact m.add_mem (hZ _ hdiff) (m.mul_mem_left _ hgm)

  have s2 : ∀ (A K L : Type u) [CommRing A] [IsDomain A] [Field K] [Algebra A K]
      [IsFractionRing A K] [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L], wcpaDjNccNag A → Module.Finite A (integralClosure A L) := by
    intro A K L _ _ _ _ _ _ _ _ _ _ hNag
    have hN2 : wcpaDjNccN2 A := hNag.2 A (fun a => ⟨a, rfl⟩)
    let e := FractionRing.algEquiv A K
    letI : Algebra (FractionRing A) L := ((algebraMap K L).comp e.toRingHom).toAlgebra
    haveI : IsScalarTower A (FractionRing A) L := IsScalarTower.of_algebraMap_eq (fun a => by
      show algebraMap A L a = algebraMap K L (e (algebraMap A (FractionRing A) a))
      rw [AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply])
    have hfin : Module.Finite (FractionRing A) L :=
      Module.Finite.of_equiv_equiv e.symm.toRingEquiv (RingEquiv.refl L) (by
        ext k
        show algebraMap K L (e (e.symm k)) = algebraMap K L k
        rw [AlgEquiv.apply_symm_apply])
    exact hN2 L hfin

  have s3 : ∀ (A L : Type u) [CommRing A] [Field L] [Algebra A L] (f : Polynomial A),
      f.Monic → (f.map (algebraMap A L)).Splits →
      ∃ s : Multiset (integralClosure A L), f.map (algebraMap A (integralClosure A L)) =
        (s.map (fun r => Polynomial.X - Polynomial.C r)).prod := by
    intro A L _ _ _ f hf hs
    classical
    set F := f.map (algebraMap A L) with hFdef
    have hFm : F.Monic := hf.map _
    have hF := hs.eq_prod_roots_of_monic hFm
    have hint : ∀ α ∈ F.roots, α ∈ integralClosure A L := by
      intro α hα
      refine ⟨f, hf, ?_⟩
      have := (Polynomial.mem_roots hFm.ne_zero).mp hα
      rw [Polynomial.IsRoot, Polynomial.eval_map] at this
      exact this
    set s := F.roots.pmap (fun α h => (⟨α, h⟩ : integralClosure A L)) hint with hsdef
    have hsv : s.map Subtype.val = F.roots := by
      rw [hsdef, Multiset.map_pmap, Multiset.pmap_eq_map, Multiset.map_id']
    refine ⟨s, ?_⟩
    apply Polynomial.map_injective (integralClosure A L).val.toRingHom Subtype.val_injective
    rw [Polynomial.map_map, Polynomial.map_multiset_prod, Multiset.map_map]
    have e1 : ((integralClosure A L).val.toRingHom.comp (algebraMap A (integralClosure A L))) =
        algebraMap A L := RingHom.ext fun a => rfl
    rw [e1]
    have e2 : (Polynomial.map (integralClosure A L).val.toRingHom ∘
          fun r : integralClosure A L => Polynomial.X - Polynomial.C r) =
        (fun a : L => Polynomial.X - Polynomial.C a) ∘ Subtype.val := by
      funext r
      simp
    rw [e2, ← Multiset.map_map, hsv]
    exact hF

  have s4 : ∀ (A K L : Type u) [CommRing A] [Field K] [Field L] [Algebra A K] [Algebra K L]
      [Algebra A L] [IsScalarTower A K L] (A'' : Subalgebra A L) [Module.Finite A A''] (x : K),
      ∃ φ : Algebra.adjoin A ({x} : Set K) →+* Algebra.adjoin A'' ({algebraMap K L x} : Set L),
        (∀ s : Algebra.adjoin A ({x} : Set K),
          ((φ s : Algebra.adjoin A'' ({algebraMap K L x} : Set L)) : L) =
            algebraMap K L (s : K)) ∧
        Function.Injective φ ∧ φ.Finite := by
    intro A K L _ _ _ _ _ _ _ A'' _ x
    classical
    set S := Algebra.adjoin A ({x} : Set K) with hS
    set S'' := Algebra.adjoin A'' ({algebraMap K L x} : Set L) with hS''
    have hA : ∀ a : A, algebraMap A L a ∈ S'' := fun a =>
      Subalgebra.algebraMap_mem S'' (algebraMap A A'' a)
    have hmem : ∀ y ∈ S, algebraMap K L y ∈ S'' := by
      intro y hy
      induction hy using Algebra.adjoin_induction with
      | mem y hy =>
        rw [Set.mem_singleton_iff] at hy
        rw [hy]; exact Algebra.subset_adjoin rfl
      | algebraMap a =>
        rw [← IsScalarTower.algebraMap_apply]; exact hA a
      | add y z _ _ h1 h2 => rw [map_add]; exact S''.add_mem h1 h2
      | mul y z _ _ h1 h2 => rw [map_mul]; exact S''.mul_mem h1 h2
    let φ : S →+* S'' := ((algebraMap K L).comp (S.val : S →+* K)).codRestrict S''
      (fun s => hmem s s.2)
    have hφ : ∀ s : S, ((φ s : S'') : L) = algebraMap K L (s : K) := fun s => rfl
    refine ⟨φ, hφ, ?_, ?_⟩
    · intro s t hst
      have h1 := congrArg (fun z : S'' => (z : L)) hst
      simp only [hφ] at h1
      exact Subtype.ext ((algebraMap K L).injective h1)
    · letI : Algebra S S'' := φ.toAlgebra
      have hsmul : ∀ (s : S) (z : S''), s • z = φ s * z := fun s z => rfl
      obtain ⟨t, ht⟩ := Module.Finite.fg_top (R := A) (M := A'')
      set ι : A'' →+* S'' := algebraMap A'' S'' with hι
      set N : Submodule S S'' := Submodule.span S (ι '' (t : Set A'')) with hN
      have h1 : ∀ c : A'', ι c ∈ N := by
        intro c
        have hc : c ∈ Submodule.span A (t : Set A'') := by rw [ht]; trivial
        induction hc using Submodule.span_induction with
        | mem c hc => exact Submodule.subset_span ⟨c, hc, rfl⟩
        | zero => rw [map_zero]; exact N.zero_mem
        | add c d _ _ hc hd => rw [map_add]; exact N.add_mem hc hd
        | smul a c _ hc =>
          have e : ι (a • c) = algebraMap A S a • ι c := by
            rw [hsmul]
            apply Subtype.ext
            show ((a • c : A'') : L) = algebraMap K L (algebraMap A K a) * (c : L)
            rw [← IsScalarTower.algebraMap_apply, Subalgebra.coe_smul, Algebra.smul_def]
          rw [e]; exact N.smul_mem _ hc
      have h2 : ∀ b : A'', ∀ z ∈ N, ι b * z ∈ N := by
        intro b z hz
        induction hz using Submodule.span_induction with
        | mem z hz =>
          obtain ⟨b', _, rfl⟩ := hz
          rw [← map_mul]; exact h1 _
        | zero => rw [mul_zero]; exact N.zero_mem
        | add z w _ _ hz hw => rw [mul_add]; exact N.add_mem hz hw
        | smul s z _ hz =>
          rw [hsmul, mul_left_comm, ← hsmul]; exact N.smul_mem _ hz
      have h3 : ∀ y ∈ N, ∀ z ∈ N, y * z ∈ N := by
        intro y hy z hz
        induction hy using Submodule.span_induction with
        | mem y hy =>
          obtain ⟨b, _, rfl⟩ := hy
          exact h2 b z hz
        | zero => rw [zero_mul]; exact N.zero_mem
        | add y w _ _ hy hw => rw [add_mul]; exact N.add_mem hy hw
        | smul s y _ hy =>
          rw [hsmul, mul_assoc, ← hsmul]; exact N.smul_mem _ hy
      have h4 : ∀ v (hv : v ∈ S''), (⟨v, hv⟩ : S'') ∈ N := by
        intro v hv
        induction hv using Algebra.adjoin_induction with
        | mem v hv =>
          rw [Set.mem_singleton_iff] at hv
          subst hv
          have e : (⟨algebraMap K L x, Algebra.subset_adjoin rfl⟩ : S'') =
              (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ : S) • ι 1 := by
            rw [hsmul, map_one, mul_one]; rfl
          rw [e]; exact N.smul_mem _ (h1 1)
        | algebraMap c => exact h1 c
        | add v w hv hw h5 h6 => exact N.add_mem h5 h6
        | mul v w hv hw h5 h6 => exact h3 _ h5 _ h6
      refine ⟨⟨(t.image ι), ?_⟩⟩
      rw [Finset.coe_image, ← hN]
      refine eq_top_iff.mpr (fun y _ => h4 y.1 y.2)

  have n1_equiv : ∀ (A B : Type u) [CommRing A] [CommRing B], (A ≃+* B) →
      wcpaDjNccN1 A → wcpaDjNccN1 B := by
    intro A B _ _ e h
    unfold wcpaDjNccN1 at h ⊢
    set E : FractionRing A ≃+* FractionRing B := IsFractionRing.ringEquivOfRingEquiv e with hE
    have hc1 : (algebraMap B (FractionRing B)).comp (e : A →+* B) =
        (E : FractionRing A →+* FractionRing B).comp (algebraMap A (FractionRing A)) := by
      ext a
      simp [E]
    have hc2 : (algebraMap A (FractionRing A)).comp (e.symm : B →+* A) =
        (E.symm : FractionRing B →+* FractionRing A).comp (algebraMap B (FractionRing B)) := by
      ext b
      apply E.injective
      simp only [RingHom.coe_comp, RingHom.coe_coe, Function.comp_apply,
        RingEquiv.apply_symm_apply]
      rw [hE, IsFractionRing.ringEquivOfRingEquiv_algebraMap, RingEquiv.apply_symm_apply]
    let e' : integralClosure A (FractionRing A) ≃+* integralClosure B (FractionRing B) :=
      { toFun := fun x => ⟨E x, IsIntegral.map_of_comp_eq (e : A →+* B)
          (E : FractionRing A →+* FractionRing B) hc1 x.2⟩
        invFun := fun y => ⟨E.symm y, IsIntegral.map_of_comp_eq (e.symm : B →+* A)
          (E.symm : FractionRing B →+* FractionRing A) hc2 y.2⟩
        left_inv := fun x => Subtype.ext (E.symm_apply_apply _)
        right_inv := fun y => Subtype.ext (E.apply_symm_apply _)
        map_mul' := fun x y => Subtype.ext (map_mul E _ _)
        map_add' := fun x y => Subtype.ext (map_add E _ _) }
    exact Module.Finite.of_equiv_equiv e e' (by
      ext a
      show algebraMap B (FractionRing B) (e a) = E (algebraMap A (FractionRing A) a)
      exact congrArg (fun g => g a) hc1)

  have descent : ∀ (R T : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]
      [CommRing T] [IsDomain T] [Algebra R T] [Module.Finite R T],
      Function.Injective (algebraMap R T) → wcpaDjNccN1 T → wcpaDjNccN1 R := by
    intro R T _ _ _ _ _ _ _ hRTi hN1T
    unfold wcpaDjNccN1 at hN1T ⊢
    set FT := FractionRing T
    have hRFT : Function.Injective (algebraMap R FT) := by
      rw [IsScalarTower.algebraMap_eq R T FT]
      exact (IsFractionRing.injective T FT).comp hRTi
    set ψ : FractionRing R →+* FT := IsFractionRing.lift hRFT
    have hψ : ∀ r : R, ψ (algebraMap R (FractionRing R) r) = algebraMap R FT r :=
      IsFractionRing.lift_algebraMap (K := FractionRing R) hRFT
    have hint : ∀ x : integralClosure R (FractionRing R), _root_.IsIntegral T (ψ x) := by
      intro x
      have h1 : _root_.IsIntegral R (ψ x) := IsIntegral.map_of_comp_eq (RingHom.id R) ψ
        (RingHom.ext fun r => (hψ r).symm) x.2
      exact h1.tower_top
    let L : integralClosure R (FractionRing R) →ₗ[R] integralClosure T FT :=
      { toFun := fun x => ⟨ψ x, hint x⟩
        map_add' := fun x y => Subtype.ext (map_add ψ _ _)
        map_smul' := fun r x => by
          apply Subtype.ext
          rw [RingHom.id_apply]
          have e1 : ((r • x : integralClosure R (FractionRing R)) : FractionRing R) =
              algebraMap R (FractionRing R) r * x := Algebra.smul_def r (x : FractionRing R)
          have e2 : ((r • (⟨ψ x, hint x⟩ : integralClosure T FT)) : FT) =
              algebraMap R FT r * ψ x := Algebra.smul_def r (ψ x : FT)
          show ψ ((r • x : integralClosure R (FractionRing R)) : FractionRing R) =
            ((r • (⟨ψ x, hint x⟩ : integralClosure T FT)) : FT)
          rw [e1, e2, map_mul, hψ] }
    have hLi : Function.Injective L := by
      intro x y hxy
      exact Subtype.ext (ψ.injective (congrArg Subtype.val hxy))
    haveI : Module.Finite R (integralClosure T FT) := Module.Finite.trans T _
    haveI : IsNoetherian R (integralClosure T FT) :=
      isNoetherian_of_isNoetherianRing_of_finite R _
    exact Module.Finite.of_injective L hLi

  have s5 : ∀ (S S'' : Type u) [CommRing S] [IsDomain S] [IsNoetherianRing S]
      [CommRing S''] [IsDomain S''] (φ : S →+* S''), Function.Injective φ → φ.Finite →
      ∀ (m : Ideal S) [m.IsMaximal] (f : S''), f ≠ 0 →
      (∀ z : integralClosure S'' (FractionRing S''), ∃ (k : ℕ) (t : S''),
        algebraMap S'' (integralClosure S'' (FractionRing S'')) t =
          algebraMap S'' (integralClosure S'' (FractionRing S'')) (f ^ k) * z) →
      (∀ (m'' : Ideal S'') [m''.IsMaximal], Ideal.comap φ m'' = m →
        wcpaDjNccN1 (Localization.AtPrime m'')) →
      wcpaDjNccN1 (Localization.AtPrime m) := by
    intro S S'' _ _ _ _ _ φ hφi hφf m _ f hf hden hloc
    classical
    letI : Algebra S S'' := φ.toAlgebra
    haveI : Module.Finite S S'' := hφf
    haveI : IsNoetherianRing S'' := IsNoetherianRing.of_finite S S''
    set M' := Algebra.algebraMapSubmonoid S'' m.primeCompl with hM'
    set T := Localization M'
    set R := Localization.AtPrime m
    letI : Algebra R T := localizationAlgebra m.primeCompl S''
    have hM'le : M' ≤ nonZeroDivisors S'' := by
      rintro _ ⟨s, hs, rfl⟩
      apply mem_nonZeroDivisors_of_ne_zero
      intro h0
      apply hs
      have : s = 0 := hφi (h0.trans (map_zero φ).symm)
      rw [this]; exact m.zero_mem
    haveI hTdom : IsDomain T := IsLocalization.isDomain_of_le_nonZeroDivisors T hM'le
    haveI hTnoeth : IsNoetherianRing T := IsLocalization.isNoetherianRing M' T inferInstance
    haveI hRT : Module.Finite R T := Module.Finite.of_isLocalization S S'' m.primeCompl
    have hRTi : Function.Injective (algebraMap R T) := localizationAlgebra_injective R T hφi
    haveI hRTint : Algebra.IsIntegral R T := Algebra.IsIntegral.of_finite R T
    haveI hRnoeth : IsNoetherianRing R :=
      IsLocalization.isNoetherianRing m.primeCompl R inferInstance
    haveI hRdom : IsDomain R :=
      IsLocalization.isDomain_of_le_nonZeroDivisors R (Ideal.primeCompl_le_nonZeroDivisors m)
    have hST : algebraMap S T = (algebraMap S'' T).comp φ := IsScalarTower.algebraMap_eq S S'' T
    have hSRT : algebraMap S T = (algebraMap R T).comp (algebraMap S R) :=
      IsScalarTower.algebraMap_eq S R T
    have hc : ∀ (𝔐 : Ideal T) [𝔐.IsMaximal], (𝔐.comap (algebraMap S'' T)).IsMaximal ∧
        (𝔐.comap (algebraMap S'' T)).comap φ = m := by
      intro 𝔐 _
      have h1 : (𝔐.comap (algebraMap R T)).IsMaximal :=
        Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap R T)
          (fun x => Algebra.IsIntegral.isIntegral x) 𝔐
      have h2 : 𝔐.comap (algebraMap R T) = IsLocalRing.maximalIdeal R :=
        IsLocalRing.eq_maximalIdeal h1
      have h3 : (𝔐.comap (algebraMap S'' T)).comap φ = m := by
        rw [Ideal.comap_comap, ← hST, hSRT, ← Ideal.comap_comap, h2]
        exact Localization.AtPrime.under_maximalIdeal
      refine ⟨?_, h3⟩
      haveI : (𝔐.comap (algebraMap S'' T)).IsPrime := Ideal.comap_isPrime _ _
      apply Ideal.isMaximal_of_isIntegral_of_isMaximal_comap φ
        (fun x => Algebra.IsIntegral.isIntegral (R := S) x)
      rw [h3]; infer_instance
    have hlocT : ∀ (𝔐 : Ideal T) [𝔐.IsMaximal], wcpaDjNccN1 (Localization.AtPrime 𝔐) := by
      intro 𝔐 _
      obtain ⟨hP, hPm⟩ := hc 𝔐
      haveI := hP
      haveI : IsLocalization.AtPrime (Localization.AtPrime 𝔐) (𝔐.comap (algebraMap S'' T)) :=
        IsLocalization.isLocalization_isLocalization_atPrime_isLocalization M'
          (Localization.AtPrime 𝔐) 𝔐
      have e := IsLocalization.algEquiv (𝔐.comap (algebraMap S'' T)).primeCompl
        (Localization.AtPrime (𝔐.comap (algebraMap S'' T))) (Localization.AtPrime 𝔐)
      exact n1_equiv _ _ e.toRingEquiv (hloc _ hPm)
    set FT := FractionRing T
    haveI hFS : IsFractionRing S'' FT := by
      have h := IsLocalization.localization_localization_isLocalization_of_has_all_units
        (R := S'') M' (S := T) (nonZeroDivisors T) FT
        (fun x hx => mem_nonZeroDivisors_of_ne_zero hx.ne_zero)
      have heq : (nonZeroDivisors T).comap (algebraMap S'' T) = nonZeroDivisors S'' := by
        ext s
        simp only [Submonoid.mem_comap, mem_nonZeroDivisors_iff_ne_zero]
        constructor
        · intro h h0; apply h; rw [h0, map_zero]
        · intro h h0; apply h
          exact IsLocalization.injective T hM'le (h0.trans (map_zero _).symm)
      rw [heq] at h
      exact h
    have hdenT : ∀ z : integralClosure T FT, ∃ (k : ℕ) (t : T),
        algebraMap T (integralClosure T FT) t =
          algebraMap T (integralClosure T FT) ((algebraMap S'' T f) ^ k) * z := by
      intro z
      obtain ⟨μ, hμ⟩ := IsIntegral.exists_multiple_integral_of_isLocalization M' (z : FT) z.2
      set E := FractionRing.algEquiv S'' FT
      have hw : _root_.IsIntegral S'' (E.symm (μ • (z : FT))) := hμ.map E.symm
      obtain ⟨k, t, ht⟩ := hden ⟨_, hw⟩
      have ht' : algebraMap S'' (FractionRing S'') t =
          algebraMap S'' (FractionRing S'') (f ^ k) * E.symm (μ • (z : FT)) :=
        congrArg Subtype.val ht
      have ht'' : algebraMap S'' FT t = algebraMap S'' FT (f ^ k) * (μ • (z : FT)) := by
        have := congrArg E ht'
        rwa [map_mul, AlgEquiv.commutes, AlgEquiv.commutes, AlgEquiv.apply_symm_apply] at this
      refine ⟨k, IsLocalization.mk' T t μ, ?_⟩
      apply Subtype.ext
      show algebraMap T FT (IsLocalization.mk' T t μ) =
        algebraMap T FT ((algebraMap S'' T f) ^ k) * (z : FT)
      have hμ0 : algebraMap S'' FT (μ : S'') ≠ 0 := by
        rw [IsScalarTower.algebraMap_apply S'' T FT]
        intro h0
        have h1 := IsFractionRing.injective T FT (h0.trans (map_zero _).symm)
        exact (IsLocalization.map_units T μ).ne_zero h1
      apply mul_right_cancel₀ hμ0
      rw [IsScalarTower.algebraMap_apply S'' T FT (μ : S''), ← map_mul,
        IsLocalization.mk'_spec, ← IsScalarTower.algebraMap_apply, ht'', Submonoid.smul_def,
        Algebra.smul_def, map_pow, map_pow, ← IsScalarTower.algebraMap_apply,
        ← IsScalarTower.algebraMap_apply]
      ring
    have hfT : algebraMap S'' T f ≠ 0 := by
      intro h0
      exact hf (IsLocalization.injective T hM'le (h0.trans (map_zero _).symm))
    have hN1T : wcpaDjNccN1 T := wcpa_dj_ncc_ns_local_global T _ hfT hdenT hlocT
    exact descent R T hRTi hN1T

  intro hCore A K _ _ _ _ _ _ _ hNag x m _ hm
  classical
  obtain ⟨f, hfmon, hfm⟩ := s1 A K x m hm
  let K'' := Polynomial.SplittingField (f.map (algebraMap A K))
  let A'' := integralClosure A K''
  haveI : IsFractionRing A'' K'' := integralClosure.isFractionRing_of_finite_extension K K''
  haveI : IsIntegrallyClosed A'' := integralClosure.isIntegrallyClosedOfFiniteExtension K
  haveI hfinA : Module.Finite A A'' := s2 A K K'' hNag
  have hNag'' : wcpaDjNccNag A'' := wcpa_dj_ncc_nag_fin A A'' hfinA hNag
  have hspl : (f.map (algebraMap A K'')).Splits := by
    rw [IsScalarTower.algebraMap_eq A K K'', ← Polynomial.map_map]
    exact Polynomial.SplittingField.splits _
  obtain ⟨s, hs⟩ := s3 A K'' f hfmon hspl
  obtain ⟨φ, hφc, hφi, hφf⟩ := s4 A K K'' A'' x
  haveI hSnoeth : IsNoetherianRing (Algebra.adjoin A ({x} : Set K)) := by
    haveI : IsNoetherianRing A := hNag.1
    have h : (Algebra.adjoin A ({x} : Set K)).FG := by
      have := Subalgebra.fg_adjoin_finset (R := A) ({x} : Finset K)
      simpa using this
    haveI : Algebra.FiniteType A (Algebra.adjoin A ({x} : Set K)) :=
      (Subalgebra.fg_iff_finiteType _).mp h
    exact Algebra.FiniteType.isNoetherianRing A _
  obtain ⟨b, a, ha, hxab⟩ := IsFractionRing.div_surjective (A := A) x
  have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
  have hak : algebraMap A K a ≠ 0 := by
    intro h; apply ha0; apply IsFractionRing.injective A K; rw [h, map_zero]
  have hxa : algebraMap A K a * x = algebraMap A K b := by
    rw [← hxab]; field_simp
  have hak'' : algebraMap A K'' a ≠ 0 := by
    rw [IsScalarTower.algebraMap_apply A K K'']
    exact (map_ne_zero _).mpr hak
  have ha''0 : algebraMap A A'' a ≠ 0 := by
    intro h; apply hak''
    rw [IsScalarTower.algebraMap_apply A A'' K'', h, map_zero]
  have hxa'' : algebraMap A'' K'' (algebraMap A A'' a) * algebraMap K K'' x =
      algebraMap A'' K'' (algebraMap A A'' b) := by
    rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply,
      IsScalarTower.algebraMap_apply A K K'', IsScalarTower.algebraMap_apply A K K'' b,
      ← map_mul, hxa]
  have hden := wcpa_dj_ncc_ns_denominator A'' K'' (algebraMap A A'' a) (algebraMap A A'' b)
    ha''0 (algebraMap K K'' x) hxa''
  have hf''0 : algebraMap A'' (Algebra.adjoin A'' ({algebraMap K K'' x} : Set K''))
      (algebraMap A A'' a) ≠ 0 := by
    intro h
    apply hak''
    have := congrArg (fun z : Algebra.adjoin A'' ({algebraMap K K'' x} : Set K'') => (z : K'')) h
    simpa using this
  refine s5 _ _ φ hφi hφf m _ hf''0 hden ?_
  intro m'' _ hm''
  have h1 : φ (Polynomial.aeval (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
      Algebra.adjoin A ({x} : Set K)) f) ∈ m'' := by
    rw [← hm''] at hfm; exact hfm
  have h2 : φ (Polynomial.aeval (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ :
      Algebra.adjoin A ({x} : Set K)) f) =
      (s.map (fun r => (⟨algebraMap K K'' x, Algebra.self_mem_adjoin_singleton A'' _⟩ :
        Algebra.adjoin A'' ({algebraMap K K'' x} : Set K'')) -
        algebraMap A'' (Algebra.adjoin A'' ({algebraMap K K'' x} : Set K'')) r)).prod := by
    apply Subtype.ext
    rw [hφc, Polynomial.aeval_subalgebra_coe, ← Polynomial.aeval_algebraMap_apply,
      ← Polynomial.aeval_map_algebraMap (integralClosure A K''), hs, map_multiset_prod,
      Multiset.map_map]
    rw [show ∀ p : Algebra.adjoin A'' ({algebraMap K K'' x} : Set K''), (p : K'') =
      (Algebra.adjoin A'' ({algebraMap K K'' x} : Set K'')).val p from fun p => rfl,
      map_multiset_prod, Multiset.map_map]
    apply congrArg
    apply Multiset.map_congr rfl
    intro r _
    simp
  rw [h2] at h1
  obtain ⟨p, hp, hpm⟩ := (Ideal.IsPrime.multiset_prod_mem_iff_exists_mem
    (Ideal.IsMaximal.isPrime ‹_›) _).mp h1
  obtain ⟨r, _, rfl⟩ := Multiset.mem_map.mp hp
  exact hCore A'' K'' hNag'' (algebraMap K K'' x) r m'' hpm

theorem wcpa_dj_nsc_au_n1 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
    [IsNoetherianRing R], _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal R) R) →
    wcpaDjNccN1 R :=
by
  intro R _ _ _ _ hred
  classical

  have s3 : ∀ (B : Type u) [CommRing B] [_root_.IsReduced B],
      Function.Injective (algebraMap B ((P : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B}) →
        Localization.AtPrime P.1.asIdeal)) := by
    intro B _ _
    rw [injective_iff_map_eq_zero]
    intro b hb
    have hmem : ∀ P ∈ (⊥ : Ideal B).minimalPrimes, b ∈ P := by
      intro P hP
      haveI hPp : P.IsPrime := Ideal.minimalPrimes_isPrime hP
      have h1 : algebraMap B (Localization.AtPrime P) b = 0 := by
        have := congrFun hb ⟨⟨P, hPp⟩, hP⟩
        simpa only [Pi.algebraMap_apply, Pi.zero_apply] using this
      obtain ⟨⟨s, hs⟩, hsb⟩ := (IsLocalization.map_eq_zero_iff P.primeCompl _ b).mp h1
      exact (hPp.mem_or_mem (by rw [hsb]; exact P.zero_mem)).resolve_left hs
    have hrad : b ∈ (⊥ : Ideal B).radical := by
      rw [← Ideal.sInf_minimalPrimes]
      exact Ideal.mem_sInf.mpr (fun {P} hP => hmem P hP)
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hrad
    exact IsNilpotent.eq_zero ⟨n, by simpa using hn⟩

  have s4 : ∀ (B : Type u) [CommRing B] [Algebra R B] [Module.Flat R B],
      ∃ ψ : FractionRing R →+* ((P : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B}) →
        Localization.AtPrime P.1.asIdeal),
      ψ.comp (algebraMap R (FractionRing R)) =
        (algebraMap B ((P : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B}) →
          Localization.AtPrime P.1.asIdeal)).comp (algebraMap R B) := by
    intro B _ _ _
    have hg : ∀ r : nonZeroDivisors R, IsUnit ((algebraMap B ((P : {P : PrimeSpectrum B //
        P.asIdeal ∈ minimalPrimes B}) → Localization.AtPrime P.1.asIdeal)).comp
          (algebraMap R B) r) := by
      rintro ⟨r, hr⟩
      have hreg : IsSMulRegular B r := Module.Flat.isSMulRegular_of_nonZeroDivisors hr
      have hβ : algebraMap R B r ∈ nonZeroDivisors B := by
        rw [mem_nonZeroDivisors_iff_right]
        intro x hx
        apply hreg
        simp only [Algebra.smul_def]
        rw [mul_comm]
        simpa using hx
      rw [Pi.isUnit_iff]
      intro P
      have hP : algebraMap R B r ∉ P.1.asIdeal := fun h =>
        (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes P.2).le_bot ⟨h, hβ⟩
      simp only [RingHom.comp_apply, Pi.algebraMap_apply]
      exact IsLocalization.map_units (Localization.AtPrime P.1.asIdeal)
        (⟨algebraMap R B r, hP⟩ : P.1.asIdeal.primeCompl)
    exact ⟨IsLocalization.lift hg, IsLocalization.lift_comp hg⟩

  set B := AdicCompletion (IsLocalRing.maximalIdeal R) R with hB
  haveI : IsNoetherianRing B := wc_hnas_completion_noetherian R
  obtain ⟨hloc, hcomp, hlh, -⟩ := wc_hnas_completion_local_complete R
  haveI := hloc
  haveI := hlh
  haveI : Module.Flat R B := AdicCompletion.flat_of_isNoetherian _
  haveI : Module.FaithfullyFlat R B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  haveI := hred

  have hT : Module.Finite B (integralClosure B ((P : {P : PrimeSpectrum B //
      P.asIdeal ∈ minimalPrimes B}) → Localization.AtPrime P.1.asIdeal)) := by
    refine integralClosure_prod_minimal_finite B _ ⟨AlgEquiv.refl⟩ ?_
    intro P hP
    haveI : P.IsPrime := Ideal.minimalPrimes_isPrime hP
    exact fgm_complete_local_nagata B hcomp (B ⧸ P)
      (by rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective)
      (FractionRing (B ⧸ P)) (Module.Finite.self _)
  obtain ⟨ψ, hψ⟩ := s4 B
  have hinj := s3 B
  set j := algebraMap B ((P : {P : PrimeSpectrum B // P.asIdeal ∈ minimalPrimes B}) →
    Localization.AtPrime P.1.asIdeal) with hj
  have hψι : ∀ r : R, ψ (algebraMap R (FractionRing R) r) = j (algebraMap R B r) := fun r => by
    have := congrArg (fun f => f r) hψ
    simpa only [RingHom.comp_apply] using this

  have s5 : ∀ (M : Submodule R (FractionRing R)),
      (Submodule.span B (⇑ψ '' (M : Set (FractionRing R)))).FG → M.FG := by
    intro M hM
    obtain ⟨s', hs'M, hs'⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp hM
    obtain ⟨t, htM, hts⟩ := Finset.subset_set_image_iff.mp hs'M
    refine ⟨t, le_antisymm (Submodule.span_le.mpr htM) ?_⟩
    intro m hm
    have hψm : ψ m ∈ Submodule.span B (⇑ψ '' (t : Set (FractionRing R))) := by
      have : ψ m ∈ Submodule.span B (⇑ψ '' (M : Set (FractionRing R))) :=
        Submodule.subset_span ⟨m, hm, rfl⟩
      rw [hs', ← hts, Finset.coe_image] at this
      exact this
    obtain ⟨l, hlt, hl⟩ := (Finsupp.mem_span_image_iff_linearCombination B).mp hψm
    obtain ⟨⟨d, hd⟩, hdint⟩ :=
      IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors R) (insert m t)
    have hdint' : ∀ x ∈ insert m t, ∃ y : R, algebraMap R (FractionRing R) y = d • x := by
      intro x hx
      obtain ⟨y, hy⟩ := hdint x hx
      exact ⟨y, hy⟩
    choose! a ha using hdint'
    have hdx : ∀ x ∈ insert m t, algebraMap R (FractionRing R) (a x) =
        algebraMap R (FractionRing R) d * x := fun x hx => by
      rw [ha x hx, Algebra.smul_def]
    have key : algebraMap R B (a m) = l.sum (fun i c => c * algebraMap R B (a i)) := by
      apply hinj
      rw [← hψι, hdx m (Finset.mem_insert_self _ _), map_mul, ← hl]
      simp only [Finsupp.linearCombination_apply, Finsupp.sum, map_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      have hit : i ∈ t := hlt hi
      rw [map_mul, Algebra.smul_def, ← hψι, hdx i (Finset.mem_insert_of_mem hit), map_mul]
      ring
    have hmem : algebraMap R B (a m) ∈
        Ideal.map (algebraMap R B) (Ideal.span (a '' (t : Set (FractionRing R)))) := by
      rw [key]
      apply Ideal.sum_mem
      intro i hi
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, hlt hi, rfl⟩))
    have hmem' : a m ∈ Ideal.span (a '' (t : Set (FractionRing R))) := by
      rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := B) (Ideal.span _)]
      exact hmem
    obtain ⟨l', hl't, hl'⟩ := (Finsupp.mem_span_image_iff_linearCombination R).mp hmem'
    have hm_eq : m = Finsupp.linearCombination R (fun x : FractionRing R => x) l' := by
      have hd0 : algebraMap R (FractionRing R) d ≠ 0 :=
        IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hd
      apply mul_left_cancel₀ hd0
      rw [← hdx m (Finset.mem_insert_self _ _), ← hl']
      simp only [Finsupp.linearCombination_apply, Finsupp.sum, map_sum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      rw [smul_eq_mul, map_mul, Algebra.smul_def, hdx i (Finset.mem_insert_of_mem (hl't hi))]
      ring
    rw [hm_eq, Finsupp.linearCombination_apply]
    unfold Finsupp.sum
    exact Submodule.sum_mem _ (fun i hi => Submodule.smul_mem _ _
      (Submodule.subset_span (hl't hi)))

  have hsub : Submodule.span B (⇑ψ '' (Subalgebra.toSubmodule
      (integralClosure R (FractionRing R)) : Set (FractionRing R))) ≤
      Subalgebra.toSubmodule (integralClosure B ((P : {P : PrimeSpectrum B //
        P.asIdeal ∈ minimalPrimes B}) → Localization.AtPrime P.1.asIdeal)) := by
    rw [Submodule.span_le]
    rintro _ ⟨z, hz, rfl⟩
    exact IsIntegral.map_of_comp_eq (algebraMap R B) ψ hψ.symm hz
  have hTfg : (Subalgebra.toSubmodule (integralClosure B ((P : {P : PrimeSpectrum B //
      P.asIdeal ∈ minimalPrimes B}) → Localization.AtPrime P.1.asIdeal))).FG :=
    Module.Finite.iff_fg.mp (Module.Finite.equiv (Subalgebra.toSubmoduleEquiv _).symm)
  have hR'fg := s5 _ (Submodule.FG.of_le hTfg hsub)
  show Module.Finite R (integralClosure R (FractionRing R))
  haveI := Module.Finite.iff_fg.mpr hR'fg
  exact Module.Finite.equiv (Subalgebra.toSubmoduleEquiv _)

theorem wcpa_dj_nsc_tate : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
    [IsNoetherianRing R] (x : R), x ∈ IsLocalRing.maximalIdeal R → x ≠ 0 →
    (∀ (Q : Ideal R) [Q.IsPrime], Q ∈ associatedPrimes R (R ⧸ Ideal.span {x}) →
      Q ∈ (Ideal.span {x}).minimalPrimes ∧ IsDiscreteValuationRing (Localization.AtPrime Q) ∧
      _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal R) R ⧸
        Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) Q)) →
    _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal R) R) :=
by
  intro R _ _ _ _ x hxm hx0 hyp
  classical

  have s1 : ∀ (B : Type u) [CommRing B] [Algebra R B] [Module.Flat R B] (c : R),
      (∀ y : R, c * y ∈ Ideal.span {x} → y ∈ Ideal.span {x}) →
      ∀ b : B, algebraMap R B c * b ∈ Ideal.span {algebraMap R B x} →
        b ∈ Ideal.span {algebraMap R B x} := by
    intro B _ _ _ c hc b hb
    obtain ⟨b', hb'⟩ := Ideal.mem_span_singleton'.mp hb
    have hsum : ∑ i : Fin 2, (![c, -x] : Fin 2 → R) i • (![b, b'] : Fin 2 → B) i = 0 := by
      rw [Fin.sum_univ_two]
      show c • b + (-x) • b' = 0
      rw [Algebra.smul_def, Algebra.smul_def, map_neg, ← hb']
      ring
    obtain ⟨k, a, y, hv, hrel⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := R)
      (M := B) (f := ![c, -x]) (x := ![b, b']) hsum
    have h0 : b = ∑ j, a 0 j • y j := hv 0
    rw [h0]
    refine Ideal.sum_mem _ (fun j _ => ?_)
    have hj : c * a 0 j + (-x) * a 1 j = 0 := by
      have := hrel j
      rw [Fin.sum_univ_two] at this
      exact this
    have hmem : c * a 0 j ∈ Ideal.span {x} := by
      rw [Ideal.mem_span_singleton']
      exact ⟨a 1 j, by linear_combination -hj⟩
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp (hc _ hmem)
    rw [← hr, Algebra.smul_def, map_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))

  have s2 : ∀ (Q : Ideal R) [Q.IsPrime], x ∈ Q →
      IsDiscreteValuationRing (Localization.AtPrime Q) →
      ∃ (t s a b : R) (e : ℕ), t ≠ 0 ∧ s ∉ Q ∧ a ∉ Q ∧ (∀ q ∈ Q, ∃ r : R, s * q = t * r) ∧
        b * x = a * t ^ e := by
    intro Q _ hxQ hdvr
    have hinj : Function.Injective (algebraMap R (Localization.AtPrime Q)) :=
      IsLocalization.injective (Localization.AtPrime Q) (Ideal.primeCompl_le_nonZeroDivisors Q)
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (Localization.AtPrime Q)
    obtain ⟨⟨t, u0⟩, ht⟩ := IsLocalization.surj Q.primeCompl ϖ
    have hu0 : IsUnit (algebraMap R (Localization.AtPrime Q) (u0 : R)) :=
      IsLocalization.map_units _ u0
    have htirr : Irreducible (algebraMap R (Localization.AtPrime Q) t) := by
      rw [← ht]
      exact (irreducible_mul_isUnit hu0).mpr hϖ
    have ht0 : t ≠ 0 := by
      rintro rfl
      rw [map_zero] at htirr
      exact htirr.ne_zero rfl
    have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime Q) =
        Ideal.span {algebraMap R (Localization.AtPrime Q) t} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp htirr
    have hq : ∀ q ∈ Q, ∃ u : R, u ∉ Q ∧ ∃ r : R, u * q = t * r := by
      intro q hqQ
      have h1 : algebraMap R (Localization.AtPrime Q) q ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q q).mpr hqQ
      rw [hmax] at h1
      obtain ⟨ℓ, hℓ⟩ := Ideal.mem_span_singleton'.mp h1
      obtain ⟨⟨r, u⟩, hr⟩ := IsLocalization.surj Q.primeCompl ℓ
      refine ⟨u, u.2, r, hinj ?_⟩
      simp only [map_mul]
      rw [← hℓ, ← hr]
      ring
    have hunif : ∀ N : Ideal R, N.FG → N ≤ Q →
        ∃ s : R, s ∉ Q ∧ ∀ q ∈ N, ∃ r : R, s * q = t * r := by
      intro N hN
      refine Submodule.fg_induction
        (motive := fun N _ => N ≤ Q → ∃ s : R, s ∉ Q ∧ ∀ q ∈ N, ∃ r : R, s * q = t * r)
        ?_ ?_ N hN
      · intro y hy
        have hyQ : y ∈ Q := hy (Submodule.mem_span_singleton_self y)
        obtain ⟨u, hu, r, hr⟩ := hq y hyQ
        refine ⟨u, hu, fun q hqy => ?_⟩
        obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hqy
        exact ⟨c * r, by rw [smul_eq_mul]; linear_combination c * hr⟩
      · intro M1 M2 _ _ h1 h2 hle
        obtain ⟨s1, hs1, H1⟩ := h1 (le_trans le_sup_left hle)
        obtain ⟨s2, hs2, H2⟩ := h2 (le_trans le_sup_right hle)
        refine ⟨s1 * s2, fun h => ?_, fun q hqM => ?_⟩
        · rcases Ideal.IsPrime.mem_or_mem ‹Q.IsPrime› h with h | h
          · exact hs1 h
          · exact hs2 h
        · obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hqM
          obtain ⟨r1, hr1⟩ := H1 y hy
          obtain ⟨r2, hr2⟩ := H2 z hz
          exact ⟨s2 * r1 + s1 * r2, by linear_combination s2 * hr1 + s1 * hr2⟩
    obtain ⟨s, hs, Hs⟩ := hunif Q (IsNoetherian.noetherian Q) le_rfl
    have hx0' : algebraMap R (Localization.AtPrime Q) x ≠ 0 := by
      intro h
      apply hx0
      apply hinj
      rw [h, map_zero]
    obtain ⟨e, w, hw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx0' htirr
    obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj Q.primeCompl (w : Localization.AtPrime Q)
    have ha : a ∉ Q := by
      intro haQ
      have h1 :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q a).mpr haQ
      rw [← hab] at h1
      exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1))
        (w.isUnit.mul (IsLocalization.map_units _ b))
    refine ⟨t, s, a, b, e, ht0, hs, ha, Hs, hinj ?_⟩
    simp only [map_mul, map_pow]
    rw [hw, ← hab]
    ring

  have s3 : ∀ (B : Type u) [CommRing B] [Algebra R B] (Q : Ideal R) (t s a b : R) (e : ℕ),
      (∀ q ∈ Q, ∃ r : R, s * q = t * r) → b * x = a * t ^ e →
      (∀ y : B, algebraMap R B t * y = 0 → y = 0) →
      _root_.IsReduced (B ⧸ Ideal.map (algebraMap R B) Q) →
      ∀ z : B, z * z = 0 → algebraMap R B (a * s ^ e) * z ∈ Ideal.span {algebraMap R B x} := by
    intro B _ _ Q t s a b e hsQ hbx ht hred
    have := hred
    have hstep : ∀ z : B, z * z = 0 → ∃ y : B, y * y = 0 ∧
        algebraMap R B s * z = algebraMap R B t * y := by
      intro z hz
      have hzQ : z ∈ Ideal.map (algebraMap R B) Q := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        apply IsNilpotent.eq_zero
        exact ⟨2, by rw [← map_pow, pow_two, hz, map_zero]⟩
      have hle : Ideal.map (algebraMap R B) Q ≤
          (Ideal.span {algebraMap R B t}).colon {algebraMap R B s} := by
        rw [Ideal.map_le_iff_le_comap]
        intro q hq
        obtain ⟨r, hr⟩ := hsQ q hq
        rw [Ideal.mem_comap, Submodule.mem_colon_singleton, smul_eq_mul]
        refine Ideal.mem_span_singleton'.mpr ⟨algebraMap R B r, ?_⟩
        rw [← map_mul, ← map_mul]
        congr 1
        linear_combination -hr
      have h1 := hle hzQ
      rw [Submodule.mem_colon_singleton, smul_eq_mul] at h1
      obtain ⟨y0, hy0⟩ := Ideal.mem_span_singleton'.mp h1
      refine ⟨y0, ?_, by linear_combination -hy0⟩
      apply ht
      apply ht
      calc algebraMap R B t * (algebraMap R B t * (y0 * y0))
          = (y0 * algebraMap R B t) * (y0 * algebraMap R B t) := by ring
        _ = (z * algebraMap R B s) * (z * algebraMap R B s) := by rw [hy0]
        _ = (z * z) * (algebraMap R B s * algebraMap R B s) := by ring
        _ = 0 := by rw [hz, zero_mul]
    have hiter : ∀ k : ℕ, ∀ z : B, z * z = 0 → ∃ y : B,
        algebraMap R B s ^ k * z = algebraMap R B t ^ k * y := by
      intro k
      induction k with
      | zero => intro z _; exact ⟨z, by simp⟩
      | succ k ih =>
        intro z hz
        obtain ⟨y0, hy0sq, hy0⟩ := hstep z hz
        obtain ⟨y1, hy1⟩ := ih y0 hy0sq
        refine ⟨y1, ?_⟩
        calc algebraMap R B s ^ (k + 1) * z = algebraMap R B s ^ k * (algebraMap R B s * z) := by
              ring
          _ = algebraMap R B s ^ k * (algebraMap R B t * y0) := by rw [hy0]
          _ = algebraMap R B t * (algebraMap R B s ^ k * y0) := by ring
          _ = algebraMap R B t * (algebraMap R B t ^ k * y1) := by rw [hy1]
          _ = algebraMap R B t ^ (k + 1) * y1 := by ring
    intro z hz
    obtain ⟨y, hy⟩ := hiter e z hz
    refine Ideal.mem_span_singleton'.mpr ⟨algebraMap R B b * y, ?_⟩
    calc algebraMap R B b * y * algebraMap R B x = algebraMap R B (b * x) * y := by
          rw [map_mul]; ring
      _ = algebraMap R B (a * t ^ e) * y := by rw [hbx]
      _ = algebraMap R B a * (algebraMap R B t ^ e * y) := by rw [map_mul, map_pow]; ring
      _ = algebraMap R B a * (algebraMap R B s ^ e * z) := by rw [hy]
      _ = algebraMap R B (a * s ^ e) * z := by rw [map_mul, map_pow]; ring

  have s4 : ∀ (I : Ideal R), (∀ Q ∈ associatedPrimes R (R ⧸ Ideal.span {x}), ¬ I ≤ Q) →
      ∃ c ∈ I, ∀ y : R, c * y ∈ Ideal.span {x} → y ∈ Ideal.span {x} := by
    intro I hI
    have hfin := associatedPrimes.finite R (R ⧸ Ideal.span {x})
    have hprime : ∀ i ∈ hfin.toFinset, i ≠ ⊥ → i ≠ ⊥ → (id i : Ideal R).IsPrime := by
      intro P hP _ _
      exact IsAssociatedPrime.isPrime ((Set.Finite.mem_toFinset hfin).mp hP)
    have hnot : ¬ ((I : Set R) ⊆
        ⋃ i ∈ (hfin.toFinset : Set (Ideal R)), ((id i : Ideal R) : Set R)) := by
      intro hsub
      obtain ⟨P, hP, hle⟩ :=
        (Ideal.subset_union_prime (s := hfin.toFinset) (f := id) ⊥ ⊥ hprime).mp hsub
      exact hI P ((Set.Finite.mem_toFinset hfin).mp hP) hle
    rw [Set.not_subset] at hnot
    obtain ⟨c, hcI, hc⟩ := hnot
    refine ⟨c, hcI, ?_⟩
    have hreg : IsSMulRegular (R ⧸ Ideal.span {x}) c := by
      have h := biUnion_associatedPrimes_eq_compl_regular R (R ⧸ Ideal.span {x})
      by_contra hcon
      apply hc
      have : c ∈ ⋃ p ∈ associatedPrimes R (R ⧸ Ideal.span {x}), (p : Set R) := by
        rw [h]; exact hcon
      simp only [Set.mem_iUnion, exists_prop, Set.Finite.mem_toFinset, id,
        SetLike.mem_coe] at this ⊢
      exact this
    intro y hy
    rw [← Ideal.Quotient.eq_zero_iff_mem] at hy ⊢
    refine hreg (show c • (Ideal.Quotient.mk (Ideal.span {x}) y) =
      c • (0 : R ⧸ Ideal.span {x}) from ?_)
    rw [smul_zero]
    have e1 : c • (Ideal.Quotient.mk (Ideal.span {x}) y) =
        Ideal.Quotient.mk (Ideal.span {x}) (c * y) := by
      rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, map_mul]
    rw [e1]
    exact hy

  have s5 : ∀ (B : Type u) [CommRing B] (w : B), (∀ y : B, w * y = 0 → y = 0) →
      (∀ z : B, (∀ n : ℕ, z ∈ Ideal.span {w ^ n}) → z = 0) →
      (∀ z : B, z * z = 0 → z ∈ Ideal.span {w}) → _root_.IsReduced B := by
    intro B _ w hw hk hsq
    have hn : ∀ n : ℕ, ∀ z : B, z * z = 0 → z ∈ Ideal.span {w ^ n} := by
      intro n
      induction n with
      | zero => intro z _; simp
      | succ n ih =>
        intro z hz
        obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp (hsq z hz)
        have hvv : v * v = 0 := by
          apply hw
          apply hw
          calc w * (w * (v * v)) = (v * w) * (v * w) := by ring
            _ = 0 := by rw [hv]; exact hz
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (ih v hvv)
        refine Ideal.mem_span_singleton'.mpr ⟨c, ?_⟩
        rw [← hv, ← hc]
        ring
    rw [isReduced_iff_pow_one_lt 2 (by norm_num)]
    intro z hz
    apply hk
    intro n
    apply hn
    rw [← pow_two]
    exact hz

  have s6 : ∀ z : AdicCompletion (IsLocalRing.maximalIdeal R) R,
      (∀ n : ℕ, z ∈ Ideal.span
        {algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R) x ^ n}) → z = 0 := by
    intro z hz
    apply AdicCompletion.ext_evalₐ
    intro n
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp (hz n)
    rw [← hw, map_mul, map_zero, ← map_pow, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow hxm n), mul_zero]

  have main : ∀ (B : Type u) [CommRing B] [Algebra R B] [Module.Flat R B],
      (∀ z : B, (∀ n : ℕ, z ∈ Ideal.span {algebraMap R B x ^ n}) → z = 0) →
      (∀ (Q : Ideal R) [Q.IsPrime], Q ∈ associatedPrimes R (R ⧸ Ideal.span {x}) →
        x ∈ Q ∧ IsDiscreteValuationRing (Localization.AtPrime Q) ∧
        _root_.IsReduced (B ⧸ Ideal.map (algebraMap R B) Q)) → _root_.IsReduced B := by
    intro B _ _ _ hkrull hloc
    have hreg : ∀ r : R, r ≠ 0 → ∀ y : B, algebraMap R B r * y = 0 → y = 0 := by
      intro r hr y hy
      have h1 : IsSMulRegular B (algebraMap R B r) :=
        IsSMulRegular.of_flat (IsSMulRegular.of_ne_zero hr)
      exact h1 (show algebraMap R B r • y = algebraMap R B r • (0 : B) by
        rw [smul_eq_mul, smul_eq_mul, mul_zero]; exact hy)
    refine s5 B (algebraMap R B x) (hreg x hx0) hkrull ?_
    intro z hz
    have hIz : ∀ c : R, c ∈ Ideal.comap (algebraMap R B)
        ((Ideal.span {algebraMap R B x}).colon {z}) ↔
        algebraMap R B c * z ∈ Ideal.span {algebraMap R B x} := by
      intro c
      rw [Ideal.mem_comap, Submodule.mem_colon_singleton, smul_eq_mul]
    obtain ⟨c, hcI, hc⟩ := s4 (Ideal.comap (algebraMap R B)
        ((Ideal.span {algebraMap R B x}).colon {z})) (by
      intro Q hQ hle
      have : Q.IsPrime := IsAssociatedPrime.isPrime hQ
      obtain ⟨hxQ, hdvr, hred⟩ := hloc Q hQ
      obtain ⟨t, s, a, b, e, ht0, hs, ha, hsQ, hbx⟩ := s2 Q hxQ hdvr
      have h1 := s3 B Q t s a b e hsQ hbx (hreg t ht0) hred z hz
      have h2 : a * s ^ e ∈ Q := hle ((hIz _).mpr h1)
      rcases Ideal.IsPrime.mem_or_mem ‹Q.IsPrime› h2 with h | h
      · exact ha h
      · exact hs (Ideal.IsPrime.mem_of_pow_mem ‹Q.IsPrime› e h))
    exact s1 B c hc z ((hIz c).mp hcI)
  exact main (AdicCompletion (IsLocalRing.maximalIdeal R) R) s6 (fun Q _ hQ => by
    obtain ⟨hmin, hdvr, hred⟩ := hyp Q hQ
    exact ⟨hmin.1.2 (Ideal.subset_span rfl), hdvr, hred⟩)

theorem wcpa_dj_nla_nag_localization : ∀ (A : Type u) [CommRing A] (M : Submonoid A),
    wcpaDjNccNag A → wcpaDjNccNag (Localization M) :=
by
  intro A _ M hA
  classical

  have s1 : ∀ (D₀ D : Type u) [CommRing D₀] [IsDomain D₀] [CommRing D] [IsDomain D]
      [Algebra D₀ D] (M₀ : Submonoid D₀) (hM₀ : M₀ ≤ nonZeroDivisors D₀) [IsLocalization M₀ D],
      wcpaDjNccN2 D₀ → wcpaDjNccN2 D := by
    intro D₀ D _ _ _ _ _ M₀ hM₀ _ h L _ _ _ _ hfin
    letI : Algebra D₀ L := ((algebraMap D L).comp (algebraMap D₀ D)).toAlgebra
    haveI : IsScalarTower D₀ D L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hinjD : Function.Injective (algebraMap D L) := by
      rw [IsScalarTower.algebraMap_eq D (FractionRing D) L]
      exact (algebraMap (FractionRing D) L).injective.comp
        (IsFractionRing.injective D (FractionRing D))
    have hinj : Function.Injective (algebraMap D₀ L) := by
      rw [IsScalarTower.algebraMap_eq D₀ D L]
      exact hinjD.comp (IsLocalization.injective D hM₀)
    haveI : FaithfulSMul D₀ L := (faithfulSMul_iff_algebraMap_injective D₀ L).mpr hinj
    letI : Algebra (FractionRing D₀) L := FractionRing.liftAlgebra D₀ L
    haveI : IsScalarTower D₀ (FractionRing D₀) L := FractionRing.isScalarTower_liftAlgebra D₀ L
    have key1 : ∀ t : D₀, algebraMap (FractionRing D₀) L (algebraMap D₀ (FractionRing D₀) t) =
        algebraMap D L (algebraMap D₀ D t) := fun t =>
      (IsScalarTower.algebraMap_apply D₀ (FractionRing D₀) L t).symm.trans
        (IsScalarTower.algebraMap_apply D₀ D L t)
    have key2 : ∀ t : D, algebraMap (FractionRing D) L (algebraMap D (FractionRing D) t) =
        algebraMap D L t := fun t => (IsScalarTower.algebraMap_apply D (FractionRing D) L t).symm
    have hμ : ∀ μ : M₀, algebraMap D L (algebraMap D₀ D μ) ≠ 0 := fun μ =>
      ((IsLocalization.map_units D μ).map (algebraMap D L)).ne_zero
    have claim : ∀ c : FractionRing D, ∃ c' : FractionRing D₀,
        algebraMap (FractionRing D) L c = algebraMap (FractionRing D₀) L c' := by
      intro c
      obtain ⟨d, d', hd', rfl⟩ := IsFractionRing.div_surjective (A := D) c
      obtain ⟨⟨e, μ⟩, he⟩ := IsLocalization.surj M₀ d
      obtain ⟨⟨e', μ'⟩, he'⟩ := IsLocalization.surj M₀ d'
      simp only at he he'
      refine ⟨algebraMap D₀ (FractionRing D₀) (e * μ') /
        algebraMap D₀ (FractionRing D₀) (e' * μ), ?_⟩
      have hd'0 : algebraMap D L d' ≠ 0 := fun h0 =>
        nonZeroDivisors.ne_zero hd' (hinjD (h0.trans (map_zero _).symm))
      have h1 := hμ μ
      have h2 := hμ μ'
      rw [map_div₀, map_div₀, key1, key1, key2, key2]
      simp only [map_mul]
      rw [← he, ← he']
      simp only [map_mul]
      field_simp
    have hfin0 : Module.Finite (FractionRing D₀) L := by
      obtain ⟨B, hB⟩ := Module.Finite.fg_top (R := FractionRing D) (M := L)
      refine ⟨⟨B, ?_⟩⟩
      rw [eq_top_iff]
      rintro l -
      have hl : l ∈ Submodule.span (FractionRing D) (B : Set L) := by rw [hB]; trivial
      induction hl using Submodule.span_induction with
      | mem y hy => exact Submodule.subset_span hy
      | zero => exact zero_mem _
      | add y z _ _ hy hz => exact add_mem hy hz
      | smul c y _ hy =>
        obtain ⟨c', hc'⟩ := claim c
        rw [Algebra.smul_def, hc', ← Algebra.smul_def]
        exact Submodule.smul_mem _ _ hy
    have hI0 : Module.Finite D₀ (integralClosure D₀ L) := h L hfin0
    obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := D₀) (M := integralClosure D₀ L)
    let G : Set L := Subtype.val '' (s : Set (integralClosure D₀ L))
    have hspan0 : ∀ w : integralClosure D₀ L, (w : L) ∈ Submodule.span D₀ G := by
      intro w
      have hw : w ∈ Submodule.span D₀ (s : Set (integralClosure D₀ L)) := by rw [hs]; trivial
      exact Submodule.apply_mem_span_image_of_mem_span (integralClosure D₀ L).val.toLinearMap hw
    have heq : (integralClosure D L).toSubmodule = Submodule.span D G := by
      apply le_antisymm
      · intro z hz
        obtain ⟨μ, hμz⟩ := IsIntegral.exists_multiple_integral_of_isLocalization M₀ z hz
        have h1 : (μ : D₀) • z ∈ (Submodule.span D G).restrictScalars D₀ :=
          Submodule.span_le_restrictScalars D₀ D G (hspan0 ⟨_, hμz⟩)
        have h2 : algebraMap D₀ D μ • z ∈ Submodule.span D G := by
          rw [algebraMap_smul]; exact h1
        obtain ⟨v, hv⟩ := IsLocalization.map_units D μ
        have h3 : z = (↑v⁻¹ : D) • (algebraMap D₀ D μ • z) := by
          rw [← hv, smul_smul, Units.inv_mul, one_smul]
        rw [h3]
        exact Submodule.smul_mem _ _ h2
      · rw [Submodule.span_le]
        rintro _ ⟨w, _, rfl⟩
        exact IsIntegral.tower_top w.2
    have hFG : (integralClosure D L).toSubmodule.FG := by
      rw [heq]
      exact Submodule.fg_span (s.finite_toSet.image _)
    exact Module.Finite.iff_fg.mpr hFG

  have s3 : ∀ (A' D : Type u) [CommRing A'] [CommRing D] (φ : A' →+* D),
      (∀ t : D, ∃ a b : A', IsUnit (φ b) ∧ t * φ b = φ a) →
      IsLocalization ((IsUnit.submonoid D).comap (algebraMap φ.range D)) D := by
    intro A' D _ _ φ hfr
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨μ, hμ⟩
      exact hμ
    · intro t
      obtain ⟨a, b, hb, he⟩ := hfr t
      exact ⟨(⟨φ a, a, rfl⟩, ⟨⟨φ b, b, rfl⟩, hb⟩), he⟩
    · intro x x' hxx
      refine ⟨1, ?_⟩
      rw [Subtype.val_injective hxx]
  have hNoeth : IsNoetherianRing A := hA.1
  refine ⟨IsLocalization.isNoetherianRing M (Localization M) hNoeth, ?_⟩
  intro D _ _ _ hsurj
  obtain ⟨ψ, hψ⟩ : ∃ ψ : A →+* D,
      ψ = (algebraMap (Localization M) D).comp (algebraMap A (Localization M)) := ⟨_, rfl⟩
  have J1 : ∀ t : D, ∃ a b : A, IsUnit (ψ b) ∧ t * ψ b = ψ a := by
    intro t
    obtain ⟨z, rfl⟩ := hsurj t
    obtain ⟨⟨a, m⟩, hz⟩ := IsLocalization.surj M z
    simp only at hz
    refine ⟨a, (m : A), ?_, ?_⟩
    · rw [hψ, RingHom.comp_apply]
      exact (IsLocalization.map_units (Localization M) m).map _
    · rw [hψ, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, hz]
  letI : Algebra A ψ.range := ψ.rangeRestrict.toAlgebra
  have hsurj0 : Function.Surjective (algebraMap A ψ.range) := ψ.rangeRestrict_surjective
  have hN2 : wcpaDjNccN2 ψ.range := hA.2 ψ.range hsurj0
  haveI hloc := s3 A D ψ J1
  have hle : (IsUnit.submonoid D).comap (algebraMap ψ.range D) ≤
      nonZeroDivisors ψ.range := by
    intro μ hμ
    apply mem_nonZeroDivisors_of_ne_zero
    intro h0
    have hu : IsUnit (algebraMap ψ.range D μ) := hμ
    rw [h0, map_zero] at hu
    exact not_isUnit_zero hu
  exact s1 ψ.range D _ hle hN2

theorem wcpa_dj_nsc_au_quot_transfer : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (Q : Ideal R) [Q.IsPrime] [IsLocalRing (R ⧸ Q)],
    _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal (R ⧸ Q)) (R ⧸ Q)) →
    _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal R) R ⧸
      Ideal.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) Q) :=
by
  intro R _ _ _ Q _ _ hred
  set I := IsLocalRing.maximalIdeal R with hI
  set J : Ideal (R ⧸ Q) := Ideal.map (Ideal.Quotient.mk Q) I with hJ

  have hm : IsLocalRing.maximalIdeal (R ⧸ Q) = J := by
    have hQI : RingHom.ker (Ideal.Quotient.mk Q) ≤ I := by
      rw [Ideal.mk_ker]
      exact IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
    have hmax : J.IsMaximal :=
      Ideal.IsMaximal.map_of_surjective_of_ker_le Ideal.Quotient.mk_surjective hQI
    exact (IsLocalRing.eq_maximalIdeal hmax).symm
  rw [hm] at hred
  have := hred

  have hpow : ∀ k : ℕ, J ^ k = Ideal.map (Ideal.Quotient.mk Q) (I ^ k) :=
    fun k => (Ideal.map_pow _ _ _).symm
  have hle : ∀ k : ℕ, I ^ k ≤ Ideal.comap (Ideal.Quotient.mk Q) (J ^ k) := fun k => by
    rw [hpow]; exact Ideal.le_comap_map
  let g : ∀ k : ℕ, R ⧸ I ^ k →+* (R ⧸ Q) ⧸ J ^ k := fun k =>
    Ideal.quotientMap (J ^ k) (Ideal.Quotient.mk Q) (hle k)
  let f : ∀ k : ℕ, AdicCompletion I R →+* (R ⧸ Q) ⧸ J ^ k := fun k =>
    (g k).comp (AdicCompletion.evalₐ I k : AdicCompletion I R →+* R ⧸ I ^ k)
  have hfmk : ∀ k (c : AdicCompletion.AdicCauchySequence I R),
      f k (AdicCompletion.mk I R c) = Ideal.Quotient.mk (J ^ k) (Ideal.Quotient.mk Q (c k)) := by
    intro k c
    show g k (AdicCompletion.evalₐ I k (AdicCompletion.mk I R c)) = _
    rw [AdicCompletion.evalₐ_mk]
    exact Ideal.quotientMap_mk
  have hf : ∀ {a b : ℕ} (hab : a ≤ b), (Ideal.Quotient.factorPow J hab).comp (f b) = f a := by
    intro a b hab
    ext x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I R x
    rw [RingHom.comp_apply, hfmk, hfmk]
    rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk hab c
    rw [Submodule.Quotient.eq, smul_eq_mul, Ideal.mul_top] at h1
    rw [← map_sub, hpow]
    exact Ideal.mem_map_of_mem _ h1
  let Φ := AdicCompletion.liftRingHom J f hf
  have hΦQ : ∀ q ∈ Q, Φ (algebraMap R (AdicCompletion I R) q) = 0 := by
    intro q hq
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [AdicCompletion.evalₐ_liftRingHom, map_zero]
    show g k (AdicCompletion.evalₐ I k (algebraMap R _ q)) = 0
    rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq, Ideal.quotientMap_mk,
      Ideal.Quotient.eq_zero_iff_mem.mpr hq, map_zero]
  have hΦker : ∀ x, Φ x = 0 → AdicCompletion.map I (Submodule.mkQ Q) x = 0 := by
    intro x hx
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I R x
    apply AdicCompletion.ext
    intro k
    rw [AdicCompletion.map_val_apply, AdicCompletion.mk_apply_coe, Submodule.mkQ_apply,
      LinearMap.reduceModIdeal_apply]
    show _ = (0 : (R ⧸ Q) ⧸ (I ^ k • (⊤ : Submodule R (R ⧸ Q))))
    rw [Submodule.Quotient.mk_eq_zero, Ideal.smul_top_eq_map, Submodule.restrictScalars_mem,
      Ideal.Quotient.algebraMap_eq]
    have h1 := congrArg (AdicCompletion.evalₐ J k) hx
    rw [AdicCompletion.evalₐ_liftRingHom, map_zero, hfmk, Ideal.Quotient.eq_zero_iff_mem,
      hpow] at h1
    exact h1

  have hker3 : ∀ x : AdicCompletion I R, AdicCompletion.map I (Submodule.mkQ Q) x = 0 →
      x ∈ Ideal.map (algebraMap R (AdicCompletion I R)) Q := by
    intro x hx
    have hex := AdicCompletion.map_exact (I := I) (Submodule.injective_subtype Q)
      (LinearMap.exact_subtype_mkQ Q) (Submodule.mkQ_surjective Q)
    obtain ⟨z, rfl⟩ := (hex x).mp hx
    obtain ⟨w, rfl⟩ := (AdicCompletion.ofTensorProductEquivOfFiniteNoetherian I Q).surjective z
    rw [AdicCompletion.ofTensorProductEquivOfFiniteNoetherian_apply, ← LinearMap.comp_apply,
      AdicCompletion.ofTensorProduct_naturality, LinearMap.comp_apply]
    clear hx
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul r q =>
      rw [TensorProduct.AlgebraTensorModule.map_tmul, LinearMap.id_apply,
        AdicCompletion.ofTensorProduct_tmul, Submodule.subtype_apply]
      have e : AdicCompletion.of I R (q : R) = algebraMap R (AdicCompletion I R) q := by
        rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
      rw [e]
      exact Submodule.smul_mem _ r (Ideal.mem_map_of_mem _ q.2)
    | add a b ha hb =>
      rw [map_add, map_add]
      exact Ideal.add_mem _ ha hb

  have H : ∀ a ∈ Ideal.map (algebraMap R (AdicCompletion I R)) Q, Φ a = 0 := by
    intro a ha
    have hle' : Ideal.map (algebraMap R (AdicCompletion I R)) Q ≤ RingHom.ker Φ := by
      rw [Ideal.map_le_iff_le_comap]
      intro q hq
      rw [Ideal.mem_comap, RingHom.mem_ker]
      exact hΦQ q hq
    exact RingHom.mem_ker.mp (hle' ha)
  have hker : RingHom.ker Φ ≤ Ideal.map (algebraMap R (AdicCompletion I R)) Q :=
    fun x hx => hker3 x (hΦker x (RingHom.mem_ker.mp hx))
  have hinj := RingHom.lift_injective_of_ker_le_ideal _ H hker
  exact isReduced_of_injective _ hinj

theorem wcpa_dj_nla_normal_case : ∀ (T : Type u) [CommRing T] [IsDomain T] [IsLocalRing T]
    [IsNoetherianRing T] [IsIntegrallyClosed T],
    (∀ (Q : Ideal T) [Q.IsPrime] [IsLocalRing (T ⧸ Q)], Q ≠ ⊥ →
      _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal (T ⧸ Q)) (T ⧸ Q))) →
    _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal T) T) :=
by
  intro T _ _ _ _ _ hyp
  classical

  have K7 : ∀ (Q : Ideal T) [Q.IsPrime] (x : T),
      x ≠ 0 → x ∈ Q → IsDiscreteValuationRing (Localization.AtPrime Q) →
      Q ∈ (Ideal.span {x}).minimalPrimes := by
    intro Q _ x hx0 hxQ hdvr
    refine ⟨⟨inferInstance, (Ideal.span_singleton_le_iff_mem _).mpr hxQ⟩, ?_⟩
    rintro Q' ⟨hQ'p, hxQ'⟩ hQ'Q
    have hdisj : Disjoint (Q.primeCompl : Set T) Q' := by
      rw [Set.disjoint_left]; intro a ha haQ'; exact ha (hQ'Q haQ')
    have hP : (Q'.map (algebraMap T (Localization.AtPrime Q))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint Q.primeCompl _ Q' hQ'p hdisj
    have hPc : (Q'.map (algebraMap T (Localization.AtPrime Q))).comap
        (algebraMap T (Localization.AtPrime Q)) = Q' :=
      IsLocalization.under_map_of_isPrime_disjoint Q.primeCompl _ hQ'p hdisj
    have hPne : Q'.map (algebraMap T (Localization.AtPrime Q)) ≠ ⊥ := by
      intro h
      have hm : algebraMap T (Localization.AtPrime Q) x ∈
          Q'.map (algebraMap T (Localization.AtPrime Q)) :=
        Ideal.mem_map_of_mem _ (hxQ' (Ideal.mem_span_singleton_self x))
      rw [h, Ideal.mem_bot] at hm
      exact hx0 (IsLocalization.injective _ (Ideal.primeCompl_le_nonZeroDivisors Q)
        (by rw [hm, map_zero]))
    have hPm := hP.isMaximal hPne
    have hPeq := IsLocalRing.eq_maximalIdeal hPm
    have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap
        (algebraMap T (Localization.AtPrime Q)) = Q := Localization.AtPrime.under_maximalIdeal
    intro a haQ
    rw [← hPc, hPeq, h2]
    exact haQ

  have K4b : ∀ (p : Ideal T) [p.IsPrime] (b₀ c₀ : T), b₀ ∈ p → b₀ ≠ 0 → c₀ ∉ p →
      (∀ b ∈ p, ∃ c : T, c₀ * b = b₀ * c) →
      IsDiscreteValuationRing (Localization.AtPrime p) := by
    intro p _ b₀ c₀ hb hb0 hc H
    have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime p) =
        Ideal.span {algebraMap T (Localization.AtPrime p) b₀} := by
      apply le_antisymm
      · rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
        intro b hbp
        obtain ⟨c, hcb⟩ := H b hbp
        have hunit : IsUnit (algebraMap T (Localization.AtPrime p) c₀) :=
          (IsLocalization.AtPrime.isUnit_to_map_iff _ p _).mpr hc
        rw [Ideal.mem_comap, Ideal.mem_span_singleton']
        refine ⟨(hunit.unit⁻¹ : (Localization.AtPrime p)ˣ) * algebraMap T _ c, ?_⟩
        have e : algebraMap T (Localization.AtPrime p) c * algebraMap T _ b₀ =
            algebraMap T _ c₀ * algebraMap T _ b := by
          rw [← map_mul, ← map_mul, hcb, mul_comm]
        rw [mul_assoc, e, ← mul_assoc]
        have : ((hunit.unit⁻¹ : (Localization.AtPrime p)ˣ) : Localization.AtPrime p) *
            algebraMap T _ c₀ = 1 := hunit.val_inv_mul
        rw [this, one_mul]
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ p b₀).mpr hb
    have hnf : ¬ IsField (Localization.AtPrime p) := by
      rw [IsLocalRing.isField_iff_maximalIdeal_eq, hmax]
      intro h
      have : algebraMap T (Localization.AtPrime p) b₀ = 0 := by
        rw [← Ideal.mem_bot, ← h]; exact Ideal.mem_span_singleton_self _
      exact hb0 (IsLocalization.injective _ (Ideal.primeCompl_le_nonZeroDivisors p)
        (by rw [this, map_zero]))
    have hpr : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).IsPrincipal := ⟨⟨_, hmax⟩⟩
    exact ((IsDiscreteValuationRing.TFAE (Localization.AtPrime p) hnf).out 5 1).mp hpr

  have K4a : ∀ (x t : T) (Q : Ideal T) [Q.IsPrime], x ≠ 0 →
      (∀ z : T, z ∈ Q ↔ z * t ∈ Ideal.span {x}) →
      ∃ b₀ ∈ Q, ∃ c₀ : T, c₀ ∉ Q ∧ b₀ * t = x * c₀ := by
    intro x t Q _ hx0 ht
    by_contra hcon
    have hcp : ∀ b ∈ Q, ∀ c : T, b * t = x * c → c ∈ Q := by
      intro b hb c he
      by_contra hc
      exact hcon ⟨b, hb, c, hc, he⟩
    have hxK : algebraMap T (FractionRing T) x ≠ 0 := fun h =>
      hx0 (IsFractionRing.injective T (FractionRing T) (by rw [h, map_zero]))
    have hxQ : x ∈ Q := (ht x).mpr (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self x))
    have hNfg : (Submodule.map (Algebra.linearMap T (FractionRing T)) Q).FG :=
      Submodule.FG.map _ (Ideal.fg_of_isNoetherianRing Q)
    have hNne : Submodule.map (Algebra.linearMap T (FractionRing T)) Q ≠ ⊥ := by
      intro h
      have : algebraMap T (FractionRing T) x ∈
          Submodule.map (Algebra.linearMap T (FractionRing T)) Q := ⟨x, hxQ, rfl⟩
      rw [h, Submodule.mem_bot] at this
      exact hxK this
    have hint : _root_.IsIntegral T
        (algebraMap T (FractionRing T) t / algebraMap T (FractionRing T) x) := by
      apply isIntegral_of_smul_mem_submodule _ hNne hNfg
      rintro n ⟨b, hb, rfl⟩
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp ((ht b).mp hb)
      refine ⟨c, hcp b hb c (by rw [← hc, mul_comm]), ?_⟩
      simp only [Algebra.linearMap_apply, smul_eq_mul]
      rw [div_mul_eq_mul_div, eq_div_iff hxK, ← map_mul, ← map_mul, hc, mul_comm]
    obtain ⟨c, hc⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have htx : t = x * c := by
      apply IsFractionRing.injective T (FractionRing T)
      rw [map_mul, hc, mul_comm, div_mul_cancel₀ _ hxK]
    have h1 : (1 : T) ∈ Q := (ht 1).mpr (by
      rw [one_mul, htx]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self x))
    exact (inferInstance : Q.IsPrime).ne_top ((Ideal.eq_top_iff_one Q).mpr h1)

  by_cases hm : IsLocalRing.maximalIdeal T = ⊥
  · rw [hm]
    haveI : IsAdicComplete (⊥ : Ideal T) T := IsAdicComplete.bot T
    exact isReduced_of_injective (AdicCompletion.ofAlgEquiv (⊥ : Ideal T)).symm
      (AdicCompletion.ofAlgEquiv (⊥ : Ideal T)).symm.injective

  obtain ⟨x, hxm, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hm
  refine wcpa_dj_nsc_tate T x hxm hx0 ?_
  intro Q _ hQ

  obtain ⟨_, q, hq⟩ := isAssociatedPrime_iff.mp hQ
  obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective q
  have ht : ∀ z : T, z ∈ Q ↔ z * t ∈ Ideal.span {x} := by
    intro z
    rw [hq, Submodule.mem_colon_singleton, Submodule.mem_bot, ← Ideal.Quotient.eq_zero_iff_mem]
    have e : z • (Ideal.Quotient.mk (Ideal.span {x}) t) =
        Ideal.Quotient.mk (Ideal.span {x}) (z * t) := by
      rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul]
    rw [e]
  have hxQ : x ∈ Q := (ht x).mpr (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self x))
  have hQne : Q ≠ ⊥ := by
    intro h
    rw [h, Ideal.mem_bot] at hxQ
    exact hx0 hxQ

  obtain ⟨b₀, hb₀Q, c₀, hc₀, hbt⟩ := K4a x t Q hx0 ht
  have hb₀0 : b₀ ≠ 0 := by
    rintro rfl
    rw [zero_mul] at hbt
    have hc0 : c₀ = 0 := (mul_eq_zero.mp hbt.symm).resolve_left hx0
    exact hc₀ (hc0 ▸ Q.zero_mem)
  have hgen : ∀ b ∈ Q, ∃ c : T, c₀ * b = b₀ * c := by
    intro b hb
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp ((ht b).mp hb)
    refine ⟨c, mul_left_cancel₀ hx0 ?_⟩
    linear_combination (-b) * hbt - b₀ * hc
  have hdvr := K4b Q b₀ c₀ hb₀Q hb₀0 hc₀ hgen
  haveI : IsLocalRing (T ⧸ Q) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk Q) Ideal.Quotient.mk_surjective
  exact ⟨K7 Q x hx0 hxQ hdvr, hdvr, wcpa_dj_nsc_au_quot_transfer T Q (hyp Q hQne)⟩

theorem wcpa_dj_nla_finite_separation : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
    [IsNoetherianRing R] (S : Type u) [CommRing S] [Algebra R S], Module.Finite R S →
    Function.Injective (algebraMap R S) →
    (∀ (𝔫 : Ideal S) [𝔫.IsMaximal],
      Ideal.comap (algebraMap R S) 𝔫 = IsLocalRing.maximalIdeal R) ∧
    ∀ j : ℕ, ∃ m : ℕ, ∀ r : R,
      (∀ (𝔫 : Ideal S) [𝔫.IsMaximal], algebraMap R (Localization.AtPrime 𝔫) r ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ m) →
      r ∈ IsLocalRing.maximalIdeal R ^ j :=
by
  intro R _ _ _ S _ _ hfin hinj
  have : Algebra.IsIntegral R S := Algebra.IsIntegral.of_finite R S
  have hφint : (algebraMap R S).IsIntegral := fun x => Algebra.IsIntegral.isIntegral x
  have : IsNoetherianRing S := IsNoetherianRing.of_finite R S

  have s2 : ∀ (𝔞 : Ideal R) (j : ℕ), ∃ k : ℕ, ∀ r : R,
      algebraMap R S r ∈ Ideal.map (algebraMap R S) 𝔞 ^ k → r ∈ 𝔞 ^ j := by
    intro 𝔞 j
    obtain ⟨c, hc⟩ := Ideal.exists_pow_inf_eq_pow_smul 𝔞 (LinearMap.range (Algebra.linearMap R S))
    refine ⟨j + c, fun r hr => ?_⟩
    rw [← Ideal.map_pow] at hr
    have h1 : algebraMap R S r ∈ (𝔞 ^ (j + c) • (⊤ : Submodule R S)) := by
      rw [Ideal.smul_top_eq_map]; exact hr
    have h2 : algebraMap R S r ∈ LinearMap.range (Algebra.linearMap R S) := ⟨r, rfl⟩
    have h3 : algebraMap R S r ∈ 𝔞 ^ (j + c) • (⊤ : Submodule R S) ⊓
        LinearMap.range (Algebra.linearMap R S) := ⟨h1, h2⟩
    rw [hc (j + c) (by omega), Nat.add_sub_cancel] at h3
    have h4 : algebraMap R S r ∈ 𝔞 ^ j • LinearMap.range (Algebra.linearMap R S) :=
      Submodule.smul_mono le_rfl inf_le_right h3
    rw [LinearMap.range_eq_map, ← Submodule.map_smul''] at h4
    obtain ⟨r', hr', hfr'⟩ := (Submodule.mem_map).mp h4
    have hr'' : r' ∈ 𝔞 ^ j := by
      rw [Ideal.smul_eq_mul, Ideal.mul_top] at hr'; exact hr'
    have hrr : r = r' := hinj (by rw [← hfr']; rfl)
    rw [hrr]; exact hr''

  have s3 : ∀ (I : Ideal S), (∀ (𝔮 : Ideal S), 𝔮.IsPrime → I ≤ 𝔮 → 𝔮.IsMaximal) →
      ∃ N : ℕ, ∀ (s : S) (k : ℕ), (∀ (𝔫 : Ideal S) [𝔫.IsMaximal],
        algebraMap S (Localization.AtPrime 𝔫) s ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ (N * k)) → s ∈ I ^ k := by
    intro I hI
    obtain ⟨N, hN⟩ := Ideal.exists_radical_pow_le_of_fg I (IsNoetherian.noetherian I.radical)
    refine ⟨N, fun s k H => ?_⟩
    apply Ideal.mem_of_localization_maximal
    intro 𝔫 h𝔫
    set ψ := algebraMap S (Localization.AtPrime 𝔫) with hψ
    have hcm : Ideal.comap ψ (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫)) = 𝔫 :=
      IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime 𝔫) 𝔫
    have key : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ (N * k) ≤
        Ideal.map ψ (I ^ k) := by
      rw [Ideal.map_pow]
      by_cases hI𝔫 : I ≤ 𝔫
      · have hrad : Ideal.map ψ I.radical =
            IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) := by
          rw [IsLocalization.map_radical 𝔫.primeCompl]
          apply le_antisymm
          · calc (Ideal.map ψ I).radical ≤ (Ideal.map ψ 𝔫).radical :=
                  Ideal.radical_mono (Ideal.map_mono hI𝔫)
              _ = _ := by
                rw [Localization.AtPrime.map_eq_maximalIdeal]
                exact (IsLocalRing.maximalIdeal.isMaximal _).isPrime.radical
          · rw [Ideal.radical_eq_sInf]
            refine le_sInf ?_
            rintro P ⟨hIP, hP⟩
            have hq : (Ideal.comap ψ P).IsMaximal :=
              hI _ (Ideal.IsPrime.comap (hK := hP) ψ) (Ideal.map_le_iff_le_comap.mp hIP)
            have hle : Ideal.comap ψ P ≤ 𝔫 := by
              have := Ideal.comap_mono (f := ψ) (IsLocalRing.le_maximalIdeal hP.ne_top)
              rwa [hcm] at this
            have heq := hq.eq_of_le h𝔫.ne_top hle
            have hPe : Ideal.map ψ (Ideal.comap ψ P) = P :=
              IsLocalization.map_under 𝔫.primeCompl _ P
            rw [← hPe, heq, hψ, Localization.AtPrime.map_eq_maximalIdeal]
        calc IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ (N * k)
            = (Ideal.map ψ (I.radical ^ N)) ^ k := by rw [Ideal.map_pow, hrad, pow_mul]
          _ ≤ (Ideal.map ψ I) ^ k := Ideal.pow_right_mono (Ideal.map_mono hN) k
      · have htop : Ideal.map ψ I = ⊤ := by
          by_contra hne
          apply hI𝔫
          have h1 := IsLocalRing.le_maximalIdeal hne
          rw [Ideal.map_le_iff_le_comap, hcm] at h1
          exact h1
        rw [htop, Ideal.top_pow]; exact le_top
    exact key (H 𝔫)

  have s4 : ∀ 𝔮 : Ideal S, 𝔮.IsPrime →
      Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) ≤ 𝔮 → 𝔮.IsMaximal := by
    intro 𝔮 h𝔮 hle
    have h1 : IsLocalRing.maximalIdeal R ≤ Ideal.comap (algebraMap R S) 𝔮 :=
      Ideal.map_le_iff_le_comap.mp hle
    have h2 : Ideal.comap (algebraMap R S) 𝔮 ≠ ⊤ :=
      (Ideal.IsPrime.comap (hK := h𝔮) (algebraMap R S)).ne_top
    have h3 := (IsLocalRing.maximalIdeal.isMaximal R).eq_of_le h2 h1
    have h4 : (Ideal.comap (algebraMap R S) 𝔮).IsMaximal :=
      h3 ▸ IsLocalRing.maximalIdeal.isMaximal R
    exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap R S) hφint 𝔮 h4
  refine ⟨fun 𝔫 h𝔫 => ?_, fun j => ?_⟩
  · exact IsLocalRing.eq_maximalIdeal
      (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap R S) hφint 𝔫)
  · obtain ⟨k, hk⟩ := s2 (IsLocalRing.maximalIdeal R) j
    obtain ⟨N, hN⟩ := s3 _ s4
    refine ⟨N * k, fun r hr => hk r (hN (algebraMap R S r) k fun 𝔫 h𝔫 => ?_)⟩
    have := hr 𝔫
    rwa [IsScalarTower.algebraMap_apply R S (Localization.AtPrime 𝔫) r] at this

theorem wcpa_dj_nla_reduced_descent : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (S : Type u)
    [CommRing S] [Algebra R S],
    (∀ (𝔫 : Ideal S) [𝔫.IsMaximal],
      Ideal.comap (algebraMap R S) 𝔫 = IsLocalRing.maximalIdeal R) →
    (∀ j : ℕ, ∃ m : ℕ, ∀ r : R,
      (∀ (𝔫 : Ideal S) [𝔫.IsMaximal], algebraMap R (Localization.AtPrime 𝔫) r ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ m) →
      r ∈ IsLocalRing.maximalIdeal R ^ j) →
    (∀ (𝔫 : Ideal S) [𝔫.IsMaximal], _root_.IsReduced
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫))
        (Localization.AtPrime 𝔫))) →
    _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal R) R) :=
by
  intro R _ _ S _ _ hcomap hsep hred
  have T_trunc : ∀ {X : Type u} [CommRing X] (I : Ideal X) {m k : ℕ} (hle : m ≤ k)
      (x : AdicCompletion I X),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I k x) =
        AdicCompletion.evalₐ I m x := by
    intro X _ I m k hle x
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I X x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := I) (M := X) hle f
    have h2 := (Submodule.Quotient.eq _).mp h1
    change Ideal.Quotient.mk (I ^ m) (f k) = Ideal.Quotient.mk (I ^ m) (f m)
    rw [Ideal.Quotient.eq]
    simpa [smul_eq_mul, Ideal.mul_top] using h2
  have T_fp : ∀ {X : Type u} [CommRing X] (I : Ideal X) {m k : ℕ} (hle : m ≤ k) (c : X),
      Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ k) c) =
        Ideal.Quotient.mk (I ^ m) c := by
    intro X _ I m k hle c
    rfl
  have adic_map : ∀ (T : Type u) [CommRing T] (f : R →+* T) (I : Ideal R) (J : Ideal T),
      Ideal.map f I ≤ J → ∃ φ : AdicCompletion I R →+* AdicCompletion J T,
        ∀ (k : ℕ) (x : AdicCompletion I R) (r : R),
          AdicCompletion.evalₐ I k x = Ideal.Quotient.mk (I ^ k) r →
          AdicCompletion.evalₐ J k (φ x) = Ideal.Quotient.mk (J ^ k) (f r) := by
    intro T _ f I J hIJ
    have hle : ∀ k, I ^ k ≤ Ideal.comap f (J ^ k) := by
      intro k
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      exact Ideal.pow_right_mono hIJ k
    let gb : ∀ k, R ⧸ I ^ k →+* T ⧸ J ^ k := fun k =>
      Ideal.quotientMap (J ^ k) f (hle k)
    have hgb : ∀ k (c : R), gb k (Ideal.Quotient.mk _ c) = Ideal.Quotient.mk _ (f c) := by
      intro k c; exact Ideal.quotientMap_mk
    let Φ := AdicCompletion.liftRingHom J
      (fun k => (gb k).comp (AdicCompletion.evalₐ I k).toRingHom) (by
        intro m k hmk
        refine RingHom.ext fun x => ?_
        change Ideal.Quotient.factorPow J hmk (gb k (AdicCompletion.evalₐ I k x)) =
          gb m (AdicCompletion.evalₐ I m x)
        obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I k x)
        rw [← T_trunc I hmk x, ← ha, hgb, T_fp, T_fp, hgb])
    have hΦev : ∀ k x, AdicCompletion.evalₐ J k (Φ x) = gb k (AdicCompletion.evalₐ I k x) := by
      intro k x
      exact AdicCompletion.evalₐ_liftRingHom _ _ _ k x
    refine ⟨Φ, ?_⟩
    intro k x r hx
    rw [hΦev, hx, hgb]
  constructor
  intro z hz
  apply AdicCompletion.ext_evalₐ
  intro j
  obtain ⟨m, hm⟩ := hsep j
  obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective
    (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal R) (max m j) z)
  have hloc : ∀ (𝔫 : Ideal S) [𝔫.IsMaximal], algebraMap R (Localization.AtPrime 𝔫) r ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) ^ m := by
    intro 𝔫 _
    have hmap : Ideal.map (algebraMap R (Localization.AtPrime 𝔫)) (IsLocalRing.maximalIdeal R) ≤
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔫) := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, IsScalarTower.algebraMap_apply R S (Localization.AtPrime 𝔫) x,
        IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime 𝔫) 𝔫,
        ← Ideal.mem_comap, hcomap 𝔫]
      exact hx
    obtain ⟨φ, hφ⟩ := adic_map _ (algebraMap R (Localization.AtPrime 𝔫)) _ _ hmap
    haveI := hred 𝔫
    have h0 : φ z = 0 := IsReduced.eq_zero _ (hz.map φ)
    have h1 := hφ (max m j) z r hr.symm
    rw [h0, map_zero] at h1
    have h2 := (Ideal.Quotient.eq_zero_iff_mem).mp h1.symm
    exact Ideal.pow_le_pow_right (le_max_left m j) h2
  have hrj := hm r hloc
  rw [map_zero, ← T_trunc (IsLocalRing.maximalIdeal R) (le_max_right m j) z, ← hr, T_fp,
    Ideal.Quotient.eq_zero_iff_mem]
  exact hrj

theorem wcpa_dj_nsc_local_nagata_au : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
    [IsNoetherianRing R], wcpaDjNccNag R →
    _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal R) R) :=
by

  have s1 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S],
      ringKrullDim S ≤ ringKrullDim R := by
    intro R S _ _ _ _
    show Order.krullDim (PrimeSpectrum S) ≤ Order.krullDim (PrimeSpectrum R)
    apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap R S))
    intro P P' hPP'
    have hlt : P.asIdeal < P'.asIdeal := hPP'
    obtain ⟨x, hx1, hx2⟩ := SetLike.exists_of_lt hlt
    have h := Ideal.under_lt_under_of_integral_mem_sdiff (R := R) (I := P.asIdeal)
      (J := P'.asIdeal) hlt.le ⟨hx1, hx2⟩ (Algebra.IsIntegral.isIntegral x)
    exact h

  have s2 : ∀ (T : Type u) [CommRing T] [IsDomain T] (Q : Ideal T) [Q.IsPrime], Q ≠ ⊥ →
      ∀ n : ℕ, ringKrullDim T ≤ (n : WithBot ℕ∞) →
      ∃ m : ℕ, m < n ∧ ringKrullDim (T ⧸ Q) ≤ (m : WithBot ℕ∞) := by
    intro T _ _ Q hQp hQ n hn
    obtain ⟨r, hrQ, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hQ
    have hr : r ∈ nonZeroDivisors T := mem_nonZeroDivisors_of_ne_zero hr0
    have h1 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor hr
    have hle : Ideal.span {r} ≤ Q := (Ideal.span_singleton_le_iff_mem Q).mpr hrQ
    have h2 : ringKrullDim (T ⧸ Q) ≤ ringKrullDim (T ⧸ Ideal.span {r}) :=
      ringKrullDim_le_of_surjective (Ideal.Quotient.factor hle)
        (Ideal.Quotient.factor_surjective hle)
    have h3 : ringKrullDim (T ⧸ Q) + 1 ≤ (n : WithBot ℕ∞) :=
      (add_le_add h2 le_rfl).trans (h1.trans hn)
    have : IsDomain (T ⧸ Q) := Ideal.Quotient.isDomain Q
    have h0 : 0 ≤ ringKrullDim (T ⧸ Q) := ringKrullDim_nonneg_of_nontrivial
    generalize ringKrullDim (T ⧸ Q) = d at h0 h3 ⊢
    induction d using WithBot.recBotCoe with
    | bot => exact absurd h0 (by simp)
    | coe e =>
      have h4 : e + 1 ≤ (n : ℕ∞) := by exact_mod_cast h3
      induction e using ENat.recTopCoe with
      | top => simp at h4
      | coe e0 =>
        have h5 : e0 + 1 ≤ n := by exact_mod_cast h4
        exact ⟨e0, by omega, le_of_eq rfl⟩

  have s4 : ∀ (A : Type u) [CommRing A] (I : Ideal A), wcpaDjNccNag A →
      wcpaDjNccNag (A ⧸ I) := by
    intro A _ I hA
    have : IsNoetherianRing A := hA.1
    refine ⟨Ideal.Quotient.isNoetherianRing I, ?_⟩
    · intro D _ _ _ hsurj
      letI : Algebra A D := ((algebraMap (A ⧸ I) D).comp (Ideal.Quotient.mk I)).toAlgebra
      exact hA.2 D (hsurj.comp Ideal.Quotient.mk_surjective)

  have P : ∀ n : ℕ, ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
      [IsNoetherianRing R], wcpaDjNccNag R → ringKrullDim R ≤ (n : WithBot ℕ∞) →
      _root_.IsReduced (AdicCompletion (IsLocalRing.maximalIdeal R) R) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
    intro R _ _ _ _ hNag hdim
    have hN2 : wcpaDjNccN2 R := hNag.2 R (fun x => ⟨x, rfl⟩)
    have hfin : Module.Finite R (integralClosure R (FractionRing R)) :=
      hN2 (FractionRing R) (Module.Finite.self _)
    have hNagS : wcpaDjNccNag (integralClosure R (FractionRing R)) :=
      wcpa_dj_ncc_nag_fin R _ hfin hNag
    haveI : IsNoetherianRing (integralClosure R (FractionRing R)) := hNagS.1
    haveI : IsIntegrallyClosed (integralClosure R (FractionRing R)) :=
      integralClosure.isIntegrallyClosedOfFiniteExtension (FractionRing R) (L := FractionRing R)
    have hinj : Function.Injective (algebraMap R (integralClosure R (FractionRing R))) := by
      intro a b hab
      apply IsFractionRing.injective R (FractionRing R)
      have := congrArg Subtype.val hab
      simpa using this
    obtain ⟨hcomap, hsep⟩ := wcpa_dj_nla_finite_separation R _ hfin hinj
    refine wcpa_dj_nla_reduced_descent R _ hcomap hsep ?_
    intro 𝔫 _
    haveI : IsDomain (Localization.AtPrime 𝔫) :=
      IsLocalization.isDomain_localization (Ideal.primeCompl_le_nonZeroDivisors 𝔫)
    haveI : IsNoetherianRing (Localization.AtPrime 𝔫) :=
      IsLocalization.isNoetherianRing 𝔫.primeCompl _ inferInstance
    haveI : IsIntegrallyClosed (Localization.AtPrime 𝔫) :=
      isIntegrallyClosed_of_isLocalization _ 𝔫.primeCompl (Ideal.primeCompl_le_nonZeroDivisors 𝔫)
    have hNagT : wcpaDjNccNag (Localization.AtPrime 𝔫) :=
      wcpa_dj_nla_nag_localization _ 𝔫.primeCompl hNagS
    have hdimT : ringKrullDim (Localization.AtPrime 𝔫) ≤ (n : WithBot ℕ∞) := by
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height 𝔫 (Localization.AtPrime 𝔫)]
      exact (Ideal.height_le_ringKrullDim_of_ne_top (Ideal.IsPrime.ne_top inferInstance)).trans
        ((s1 R (integralClosure R (FractionRing R))).trans hdim)
    refine wcpa_dj_nla_normal_case (Localization.AtPrime 𝔫) ?_
    intro Q _ _ hQ
    haveI : IsNoetherianRing (Localization.AtPrime 𝔫 ⧸ Q) := Ideal.Quotient.isNoetherianRing Q
    have hNagQ := s4 _ Q hNagT
    obtain ⟨m, hm, hdimQ⟩ := s2 _ Q hQ n hdimT
    exact IH m hm (Localization.AtPrime 𝔫 ⧸ Q) hNagQ hdimQ

  intro R _ _ _ _ hNag
  have hfd : ringKrullDim R ≠ ⊤ := ringKrullDim_ne_top
  have hh : (IsLocalRing.maximalIdeal R).height ≠ ⊤ := by
    intro e
    apply hfd
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, e]
    rfl
  apply P (IsLocalRing.maximalIdeal R).height.toNat R hNag
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim]
  have hc : (((IsLocalRing.maximalIdeal R).height.toNat : ℕ) : ℕ∞) =
      (IsLocalRing.maximalIdeal R).height := ENat.coe_toNat hh
  rw [← hc]
  exact le_of_eq rfl

theorem wcpa_dj_nsc_ass_dvr : ∀ (A K : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [Field K] [Algebra A K] [IsFractionRing A K], wcpaDjNccNag A → ∀ (y : K), y ≠ 0 →
    ∀ (m : Ideal (Algebra.adjoin A ({y} : Set K))) [m.IsMaximal],
    (⟨y, Algebra.self_mem_adjoin_singleton A y⟩ : Algebra.adjoin A ({y} : Set K)) ∈ m →
    ∀ (Q : Ideal (Localization.AtPrime m)) [Q.IsPrime],
    Q ∈ associatedPrimes (Localization.AtPrime m) (Localization.AtPrime m ⧸ Ideal.span
      {algebraMap (Algebra.adjoin A ({y} : Set K)) (Localization.AtPrime m)
        ⟨y, Algebra.self_mem_adjoin_singleton A y⟩}) →
    Q ∈ (Ideal.span {algebraMap (Algebra.adjoin A ({y} : Set K)) (Localization.AtPrime m)
        ⟨y, Algebra.self_mem_adjoin_singleton A y⟩}).minimalPrimes ∧
      IsDiscreteValuationRing (Localization.AtPrime Q) :=
by
  intro A K _ _ _ _ _ _ hNag y hy0 m _ hYm Q _ hQ
  classical
  haveI hntA : Nontrivial A := IsDomain.toNontrivial
  haveI : IsNoetherianRing A := hNag.1

  have K7 : ∀ (R : Type u) [CommRing R] [IsDomain R] (Q : Ideal R) [Q.IsPrime] (x : R),
      x ≠ 0 → x ∈ Q → IsDiscreteValuationRing (Localization.AtPrime Q) →
      Q ∈ (Ideal.span {x}).minimalPrimes := by
    intro R _ _ Q _ x hx0 hxQ hdvr
    refine ⟨⟨inferInstance, (Ideal.span_singleton_le_iff_mem _).mpr hxQ⟩, ?_⟩
    rintro Q' ⟨hQ'p, hxQ'⟩ hQ'Q
    have hdisj : Disjoint (Q.primeCompl : Set R) Q' := by
      rw [Set.disjoint_left]; intro a ha haQ'; exact ha (hQ'Q haQ')
    have hP : (Q'.map (algebraMap R (Localization.AtPrime Q))).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint Q.primeCompl _ Q' hQ'p hdisj
    have hPc : (Q'.map (algebraMap R (Localization.AtPrime Q))).comap
        (algebraMap R (Localization.AtPrime Q)) = Q' :=
      IsLocalization.under_map_of_isPrime_disjoint Q.primeCompl _ hQ'p hdisj
    have hPne : Q'.map (algebraMap R (Localization.AtPrime Q)) ≠ ⊥ := by
      intro h
      have hm : algebraMap R (Localization.AtPrime Q) x ∈
          Q'.map (algebraMap R (Localization.AtPrime Q)) :=
        Ideal.mem_map_of_mem _ (hxQ' (Ideal.mem_span_singleton_self x))
      rw [h, Ideal.mem_bot] at hm
      exact hx0 (IsLocalization.injective _ (Ideal.primeCompl_le_nonZeroDivisors Q)
        (by rw [hm, map_zero]))
    have hPm := hP.isMaximal hPne
    have hPeq := IsLocalRing.eq_maximalIdeal hPm
    have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap
        (algebraMap R (Localization.AtPrime Q)) = Q := Localization.AtPrime.under_maximalIdeal
    intro a haQ
    rw [← hPc, hPeq, h2]
    exact haQ

  have K6 : ∀ (A S T : Type u) [CommRing A] [IsDomain A] [CommRing S] [IsDomain S] [CommRing T]
      [Algebra A S] [Algebra S T] [Algebra A T] [IsScalarTower A S T] (M : Submonoid S)
      [IsLocalization M T], M ≤ nonZeroDivisors S → Function.Injective (algebraMap A S) →
      (∀ s : S, ∃ a₁ a₂ : A, a₁ ≠ 0 ∧ algebraMap A S a₁ * s = algebraMap A S a₂) →
      Function.Injective (algebraMap A T) ∧
        ∀ t : T, ∃ a₁ a₂ : A, a₁ ≠ 0 ∧ algebraMap A T a₁ * t = algebraMap A T a₂ := by
    intro A S T _ _ _ _ _ _ _ _ _ M _ hM hinj hfr
    have hST := IsLocalization.injective T hM
    refine ⟨?_, ?_⟩
    · rw [IsScalarTower.algebraMap_eq A S T]; exact hST.comp hinj
    · intro t
      obtain ⟨⟨s, μ⟩, rfl⟩ := IsLocalization.mk'_surjective M t
      obtain ⟨a₁, a₂, ha₁, h1⟩ := hfr s
      obtain ⟨b₁, b₂, hb₁, h2⟩ := hfr μ
      have hμ0 : (μ : S) ≠ 0 := nonZeroDivisors.ne_zero (hM μ.2)
      have hb₂ : b₂ ≠ 0 := by
        intro h; rw [h, map_zero] at h2
        rcases mul_eq_zero.mp h2 with h | h
        · exact hb₁ (hinj (by rw [h, map_zero]))
        · exact hμ0 h
      refine ⟨a₁ * b₂, a₂ * b₁, mul_ne_zero ha₁ hb₂, ?_⟩
      have hs := IsLocalization.mk'_spec T s μ
      have e1 := congrArg (algebraMap S T) h1
      have e2 := congrArg (algebraMap S T) h2
      simp only [map_mul] at e1 e2
      rw [IsScalarTower.algebraMap_apply A S T, IsScalarTower.algebraMap_apply A S T, map_mul,
        map_mul, map_mul, map_mul, ← e1, ← e2]
      linear_combination
        (algebraMap S T (algebraMap A S a₁) * algebraMap S T (algebraMap A S b₁)) * hs

  have K4b : ∀ (p : Ideal A) [p.IsPrime] (b₀ u₀ c₀ : A), b₀ ∈ p → b₀ ≠ 0 → u₀ ∉ p → c₀ ∉ p →
      (∀ b ∈ p, ∃ u c : A, u ∉ p ∧ c * u₀ * b₀ = u * c₀ * b) →
      IsDiscreteValuationRing (Localization.AtPrime p) := by
    intro p _ b₀ u₀ c₀ hb hb0 _ hc H
    have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime p) =
        Ideal.span {algebraMap A (Localization.AtPrime p) b₀} := by
      apply le_antisymm
      · rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
        intro b hbp
        obtain ⟨u, c, hu', hcb⟩ := H b hbp
        have huc : u * c₀ ∉ p := fun h =>
          ((inferInstance : p.IsPrime).mem_or_mem h).elim hu' hc
        have hunit : IsUnit (algebraMap A (Localization.AtPrime p) (u * c₀)) :=
          (IsLocalization.AtPrime.isUnit_to_map_iff _ p _).mpr huc
        rw [Ideal.mem_comap, Ideal.mem_span_singleton']
        refine ⟨(hunit.unit⁻¹ : (Localization.AtPrime p)ˣ) * algebraMap A _ (c * u₀), ?_⟩
        have e : algebraMap A (Localization.AtPrime p) (c * u₀) * algebraMap A _ b₀ =
            algebraMap A _ (u * c₀) * algebraMap A _ b := by
          rw [← map_mul, ← map_mul, hcb]
        rw [mul_assoc, e, ← mul_assoc]
        have : ((hunit.unit⁻¹ : (Localization.AtPrime p)ˣ) : Localization.AtPrime p) *
            algebraMap A _ (u * c₀) = 1 := hunit.val_inv_mul
        rw [this, one_mul]
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ p b₀).mpr hb
    have hnf : ¬ IsField (Localization.AtPrime p) := by
      rw [IsLocalRing.isField_iff_maximalIdeal_eq, hmax]
      intro h
      have : algebraMap A (Localization.AtPrime p) b₀ = 0 := by
        rw [← Ideal.mem_bot, ← h]; exact Ideal.mem_span_singleton_self _
      exact hb0 (IsLocalization.injective _ (Ideal.primeCompl_le_nonZeroDivisors p)
        (by rw [this, map_zero]))
    have hpr : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).IsPrincipal := ⟨⟨_, hmax⟩⟩
    exact ((IsDiscreteValuationRing.TFAE (Localization.AtPrime p) hnf).out 5 1).mp hpr

  have K2 : ∀ (A R : Type u) [CommRing A] [CommRing R] [IsNoetherianRing R] [Algebra A R] (x : R),
      (∀ r : R, ∃ (a : A) (v : R), IsUnit v ∧ r * v - algebraMap A R a ∈ Ideal.span {x}) →
      ∀ Q ∈ associatedPrimes R (R ⧸ Ideal.span {x}), ∃ a : A, ∀ z : R,
        z ∈ Q ↔ z * algebraMap A R a ∈ Ideal.span {x} := by
    intro A R _ _ _ _ x hx Q hQ
    obtain ⟨_, q, hq⟩ := isAssociatedPrime_iff.mp hQ
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
    obtain ⟨a, v, hv, hrv⟩ := hx r
    refine ⟨a, fun z => ?_⟩
    have hzr : z ∈ Q ↔ z * r ∈ Ideal.span {x} := by
      rw [hq, Submodule.mem_colon_singleton, Submodule.mem_bot, ← Ideal.Quotient.eq_zero_iff_mem]
      have e : z • (Ideal.Quotient.mk (Ideal.span {x}) r) =
          Ideal.Quotient.mk (Ideal.span {x}) (z * r) := by
        rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul]
      rw [e]
    rw [hzr]
    constructor
    · intro h
      have : z * algebraMap A R a = (z * r) * v - z * (r * v - algebraMap A R a) := by ring
      rw [this]
      exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ h) (Ideal.mul_mem_left _ _ hrv)
    · intro h
      obtain ⟨w, hw⟩ := hv.exists_right_inv
      have : z * r = (z * algebraMap A R a + z * (r * v - algebraMap A R a)) * w := by
        linear_combination (-(z * r)) * hw
      rw [this]
      exact Ideal.mul_mem_right _ _ (Ideal.add_mem _ h (Ideal.mul_mem_left _ _ hrv))

  have K3 : ∀ (A S : Type u) [CommRing A] [CommRing S] [IsDomain S] [Algebra A S] (Y : S),
      (∀ s : S, ∃ a : A, s - algebraMap A S a ∈ Ideal.span {Y}) →
      ∀ (m : Ideal S) [m.IsMaximal], Y ∈ m → ∀ (c : A),
      algebraMap A (Localization.AtPrime m) c ∈
        Ideal.span {algebraMap S (Localization.AtPrime m) Y} →
      ∃ u : A, algebraMap A S u ∉ m ∧ algebraMap A S (u * c) ∈ Ideal.span {Y} := by
    intro A S _ _ _ _ Y hi m _ hYm c hc
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hc
    obtain ⟨⟨s, t⟩, rfl⟩ := IsLocalization.mk'_surjective m.primeCompl r
    have hinj := IsLocalization.injective (Localization.AtPrime m)
      (Ideal.primeCompl_le_nonZeroDivisors m)
    have hs := IsLocalization.mk'_spec (Localization.AtPrime m) s t
    have e : (t : S) * algebraMap A S c = s * Y := by
      apply hinj
      rw [map_mul, map_mul, ← IsScalarTower.algebraMap_apply A S (Localization.AtPrime m) c]
      linear_combination (-(algebraMap S (Localization.AtPrime m) t)) * hr +
        (algebraMap S (Localization.AtPrime m) Y) * hs
    obtain ⟨u, hu⟩ := hi t
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp hu
    refine ⟨u, ?_, ?_⟩
    · intro hum
      apply t.2
      have : (t : S) = algebraMap A S u + g * Y := by rw [hg]; ring
      rw [this]
      exact m.add_mem hum (m.mul_mem_left g hYm)
    · rw [Ideal.mem_span_singleton']
      refine ⟨s - g * algebraMap A S c, ?_⟩
      rw [map_mul]
      linear_combination -e - algebraMap A S c * hg

  have K5 : ∀ (A C : Type u) [CommRing A] [IsDomain A] [CommRing C] [IsDomain C] [IsLocalRing C]
      [Algebra A C], Function.Injective (algebraMap A C) →
      (∀ c : C, ∃ a₁ a₂ : A, a₁ ≠ 0 ∧ algebraMap A C a₁ * c = algebraMap A C a₂) →
      ∀ (p : Ideal A) [p.IsPrime], p = Ideal.comap (algebraMap A C) (IsLocalRing.maximalIdeal C) →
      IsDiscreteValuationRing (Localization.AtPrime p) → IsDiscreteValuationRing C := by
    intro A C _ _ _ _ _ _ hinj hfr p _ hp hdvr
    have hunit : ∀ y : p.primeCompl, IsUnit (algebraMap A C y) := by
      intro y
      by_contra h
      have hy : (y : A) ∈ Ideal.comap (algebraMap A C) (IsLocalRing.maximalIdeal C) :=
        (IsLocalRing.mem_maximalIdeal _).mpr h
      rw [← hp] at hy
      exact y.2 hy
    let φ : Localization.AtPrime p →+* C := IsLocalization.lift hunit
    have hφ : ∀ a, φ (algebraMap A _ a) = algebraMap A C a := IsLocalization.lift_eq hunit
    have hinjL := IsLocalization.injective (Localization.AtPrime p)
      (Ideal.primeCompl_le_nonZeroDivisors p)
    have hφinj : Function.Injective φ := by
      rw [IsLocalization.lift_injective_iff]
      intro x y
      constructor
      · intro h; rw [hinjL h]
      · intro h; rw [hinj h]
    have hφsurj : Function.Surjective φ := by
      intro c
      obtain ⟨a₁, a₂, ha₁, hc⟩ := hfr c
      have ha₁C : algebraMap A C a₁ ≠ 0 := fun h => ha₁ (hinj (by rw [h, map_zero]))
      have key : ∀ k : Localization.AtPrime p,
          algebraMap A _ a₂ = algebraMap A _ a₁ * k → φ k = c := by
        intro k hk
        have := congrArg φ hk
        rw [map_mul, hφ, hφ, ← hc] at this
        exact (mul_left_cancel₀ ha₁C this).symm
      rcases ValuationRing.dvd_total (algebraMap A (Localization.AtPrime p) a₁)
          (algebraMap A _ a₂) with ⟨k, hk⟩ | ⟨e, he⟩
      · exact ⟨k, key k hk⟩
      · have ha₂ : a₂ ≠ 0 := by
          rintro rfl
          rw [map_zero, zero_mul] at he
          exact ha₁ (hinjL (by rw [he, map_zero]))
        have ha₂C : algebraMap A C a₂ ≠ 0 := fun h => ha₂ (hinj (by rw [h, map_zero]))
        have hφe : φ e * c = 1 := by
          have := congrArg φ he
          rw [map_mul, hφ, hφ] at this
          apply mul_left_cancel₀ ha₂C
          rw [mul_one, ← mul_assoc, ← this, hc]
        have heu : IsUnit e := by
          by_contra hne
          have hem : e ∈ IsLocalRing.maximalIdeal _ := (IsLocalRing.mem_maximalIdeal _).mpr hne
          rw [← Localization.AtPrime.map_eq_maximalIdeal] at hem
          have hle : Ideal.map (algebraMap A (Localization.AtPrime p)) p ≤
              (IsLocalRing.maximalIdeal C).comap φ := by
            rw [Ideal.map_le_iff_le_comap]
            intro a ha
            rw [Ideal.mem_comap, Ideal.mem_comap, hφ]
            rw [hp, Ideal.mem_comap] at ha
            exact ha
          have h1 := hle hem
          rw [Ideal.mem_comap] at h1
          exact (IsLocalRing.mem_maximalIdeal _).mp h1
            ⟨⟨φ e, c, hφe, by rw [mul_comm]; exact hφe⟩, rfl⟩
        exact ⟨_, key (↑heu.unit⁻¹) (by rw [he, mul_assoc, heu.mul_val_inv, mul_one])⟩
    exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing
      (RingEquiv.ofBijective φ ⟨hφinj, hφsurj⟩)

  have K4a : ∀ (p : Ideal A) [p.IsPrime] (w : K),
      (∀ s c : A, s ∉ p → algebraMap A K s * w ≠ algebraMap A K c) →
      (∀ b ∈ p, ∃ u c : A, u ∉ p ∧ algebraMap A K u * w * algebraMap A K b = algebraMap A K c) →
      ∃ b₀ ∈ p, ∃ u₀ c₀ : A, u₀ ∉ p ∧ c₀ ∉ p ∧
        algebraMap A K u₀ * w * algebraMap A K b₀ = algebraMap A K c₀ := by
    intro p _ w H1 H2
    by_contra hcon
    have hcp : ∀ b ∈ p, ∀ u c : A, u ∉ p →
        algebraMap A K u * w * algebraMap A K b = algebraMap A K c → c ∈ p := by
      intro b hb u c hu he
      by_contra hc
      exact hcon ⟨b, hb, u, c, hu, hc, he⟩
    obtain ⟨c', s', hs', hw⟩ := IsFractionRing.div_surjective (A := A) w
    have hs'0 : s' ≠ 0 := nonZeroDivisors.ne_zero hs'
    have hs'K : algebraMap A K s' ≠ 0 := fun h =>
      hs'0 (IsFractionRing.injective A K (by rw [h, map_zero]))
    have hs'p : s' ∈ p := by
      by_contra h
      apply H1 s' c' h
      rw [← hw, mul_comm]
      exact div_mul_cancel₀ _ hs'K
    obtain ⟨T, hT⟩ := Ideal.fg_of_isNoetherianRing p
    have hTp : ∀ t ∈ T, t ∈ p := fun t ht => hT ▸ Submodule.subset_span ht
    choose! uf cf huf hcf using H2
    have hU : (∏ t ∈ T, uf t) ∉ p := by
      intro h
      obtain ⟨t, ht, h'⟩ := Ideal.IsPrime.prod_mem_iff.mp h
      exact huf t (hTp t ht) h'
    have hstab : ∀ b ∈ p, ∃ e ∈ p,
        algebraMap A K (∏ t ∈ T, uf t) * w * algebraMap A K b = algebraMap A K e := by
      intro b hb
      rw [← hT] at hb
      induction hb using Submodule.span_induction with
      | mem t ht =>
        refine ⟨(∏ t' ∈ T.erase t, uf t') * cf t,
          p.mul_mem_left _ (hcp t (hTp t ht) _ _ (huf t (hTp t ht)) (hcf t (hTp t ht))), ?_⟩
        rw [← Finset.mul_prod_erase T uf ht]
        simp only [map_mul]
        rw [← hcf t (hTp t ht)]
        ring
      | zero => exact ⟨0, p.zero_mem, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨e1, he1, h1⟩ := hx
        obtain ⟨e2, he2, h2⟩ := hy
        exact ⟨e1 + e2, p.add_mem he1 he2, by rw [map_add, map_add, mul_add, h1, h2]⟩
      | smul r x _ hx =>
        obtain ⟨e, he, h⟩ := hx
        refine ⟨r * e, p.mul_mem_left r he, ?_⟩
        rw [smul_eq_mul, map_mul, map_mul, ← h]
        ring
    have hNfg : (Submodule.map (Algebra.linearMap A K) p).FG :=
      Submodule.FG.map (Algebra.linearMap A K) (Ideal.fg_of_isNoetherianRing p)
    have hNne : Submodule.map (Algebra.linearMap A K) p ≠ ⊥ := by
      intro h
      have : algebraMap A K s' ∈ Submodule.map (Algebra.linearMap A K) p := ⟨s', hs'p, rfl⟩
      rw [h, Submodule.mem_bot] at this
      exact hs'K this
    have hint : _root_.IsIntegral A (algebraMap A K (∏ t ∈ T, uf t) * w) := by
      apply isIntegral_of_smul_mem_submodule _ hNne hNfg
      rintro n ⟨b, hb, rfl⟩
      obtain ⟨e, he, h⟩ := hstab b hb
      exact ⟨e, he, by simp only [Algebra.linearMap_apply, smul_eq_mul]; exact h.symm⟩
    obtain ⟨c, hc⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    exact H1 _ c hU hc.symm

  have C5i : ∀ s : Algebra.adjoin A ({y} : Set K), ∃ a : A,
      s - algebraMap A (Algebra.adjoin A ({y} : Set K)) a ∈
      Ideal.span {(⟨y, Algebra.self_mem_adjoin_singleton A y⟩ : Algebra.adjoin A ({y} : Set K))} := by
    intro s
    have hmem : (s : K) ∈ (Polynomial.aeval (R := A) y).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval A y]; exact s.2
    obtain ⟨g, hg⟩ := hmem
    change Polynomial.aeval y g = (s : K) at hg
    refine ⟨g.coeff 0, Ideal.mem_span_singleton'.mpr
      ⟨⟨Polynomial.aeval y g.divX, Polynomial.aeval_mem_adjoin_singleton A y⟩, ?_⟩⟩
    apply Subtype.ext
    have h1 := congrArg (Polynomial.aeval y) (Polynomial.divX_mul_X_add g)
    rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, hg] at h1
    simp only [Subalgebra.coe_mul, Subalgebra.coe_sub, Subalgebra.coe_algebraMap]
    rw [← h1]
    ring

  have C5ii : ∀ a : A, algebraMap A (Algebra.adjoin A ({y} : Set K)) a ∈
      Ideal.span {(⟨y, Algebra.self_mem_adjoin_singleton A y⟩ : Algebra.adjoin A ({y} : Set K))} →
      ∃ c : A, algebraMap A K c * y = algebraMap A K a := by
    intro a ha
    obtain ⟨e, he⟩ := Ideal.mem_span_singleton'.mp ha
    have heK : (e : K) * y = algebraMap A K a := by
      have := congrArg Subtype.val he
      simpa using this
    by_cases ha0 : a = 0
    · exact ⟨0, by simp [ha0]⟩
    have hmem : (e : K) ∈ (Polynomial.aeval (R := A) y).range := by
      rw [← Algebra.adjoin_singleton_eq_range_aeval A y]; exact e.2
    obtain ⟨g, hg⟩ := hmem
    change Polynomial.aeval y g = (e : K) at hg
    have hh : Polynomial.aeval y (Polynomial.X * g - Polynomial.C a) = 0 := by
      rw [map_sub, map_mul, Polynomial.aeval_X, Polynomial.aeval_C, hg, mul_comm, heK, sub_self]
    have hh0 : (Polynomial.X * g - Polynomial.C a).coeff 0 = -a := by simp
    letI : Invertible y := invertibleOfNonzero hy0
    have hrev : Polynomial.aeval y⁻¹ (Polynomial.X * g - Polynomial.C a).reverse = 0 := by
      rw [Polynomial.aeval_def, ← invOf_eq_inv, Polynomial.eval₂_reverse_eq_zero_iff,
        ← Polynomial.aeval_def]
      exact hh
    have hint := isIntegral_leadingCoeff_smul _ _ hrev
    have htr : (Polynomial.X * g - Polynomial.C a).trailingCoeff = -a := by
      have h0 : (Polynomial.X * g - Polynomial.C a).natTrailingDegree = 0 :=
        Polynomial.natTrailingDegree_eq_zero.mpr (Or.inr (by rw [hh0]; exact neg_ne_zero.mpr ha0))
      rw [Polynomial.trailingCoeff, h0, hh0]
    rw [Polynomial.reverse_leadingCoeff, htr] at hint
    obtain ⟨d, hd⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    refine ⟨-d, ?_⟩
    rw [map_neg, hd, Algebra.smul_def, map_neg]
    field_simp

  haveI : Algebra.FiniteType A (Algebra.adjoin A ({y} : Set K)) := by
    have h : (Algebra.adjoin A ({y} : Set K)).FG := by
      have := Subalgebra.fg_adjoin_finset (R := A) ({y} : Finset K)
      simpa using this
    exact (Subalgebra.fg_iff_finiteType _).mp h
  haveI : IsNoetherianRing (Algebra.adjoin A ({y} : Set K)) :=
    Algebra.FiniteType.isNoetherianRing A _
  have hinjSR : Function.Injective (algebraMap (Algebra.adjoin A ({y} : Set K))
      (Localization.AtPrime m)) :=
    IsLocalization.injective (Localization.AtPrime m) (Ideal.primeCompl_le_nonZeroDivisors m)
  have hbr : ∀ a' : A, algebraMap A (Localization.AtPrime m) a' =
      algebraMap (Algebra.adjoin A ({y} : Set K)) (Localization.AtPrime m)
        (algebraMap A (Algebra.adjoin A ({y} : Set K)) a') :=
    fun a' => IsScalarTower.algebraMap_apply A _ _ a'
  have hx0ne : algebraMap (Algebra.adjoin A ({y} : Set K)) (Localization.AtPrime m)
      ⟨y, Algebra.self_mem_adjoin_singleton A y⟩ ≠ 0 := by
    intro h0
    apply hy0
    have h1 : (⟨y, Algebra.self_mem_adjoin_singleton A y⟩ :
        Algebra.adjoin A ({y} : Set K)) = 0 := hinjSR (by rw [map_zero]; exact h0)
    exact congrArg Subtype.val h1
  obtain ⟨a, hQa⟩ := K2 A (Localization.AtPrime m) _ (by
    intro r
    obtain ⟨⟨s, t⟩, rfl⟩ := IsLocalization.mk'_surjective m.primeCompl r
    obtain ⟨a, ha⟩ := C5i s
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp ha
    refine ⟨a, algebraMap _ (Localization.AtPrime m) (t : Algebra.adjoin A ({y} : Set K)),
      IsLocalization.map_units _ t, ?_⟩
    rw [IsLocalization.mk'_spec, hbr, ← map_sub, ← hg, map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)) Q hQ
  have hx0Q : algebraMap (Algebra.adjoin A ({y} : Set K)) (Localization.AtPrime m)
      ⟨y, Algebra.self_mem_adjoin_singleton A y⟩ ∈ Q :=
    (hQa _).mpr (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))
  haveI hpP : (Q.comap (algebraMap A (Localization.AtPrime m))).IsPrime :=
    Ideal.comap_isPrime _ _
  have H1 : ∀ s c : A, s ∉ Q.comap (algebraMap A (Localization.AtPrime m)) →
      algebraMap A K s * (algebraMap A K a / y) ≠ algebraMap A K c := by
    intro s c hs he
    apply hs
    rw [Ideal.mem_comap]
    apply (hQa _).mpr
    have hK : algebraMap A K (s * a) = algebraMap A K c * y := by
      rw [map_mul, ← he, mul_assoc, div_mul_cancel₀ _ hy0]
    have hS : algebraMap A (Algebra.adjoin A ({y} : Set K)) (s * a) =
        algebraMap A (Algebra.adjoin A ({y} : Set K)) c *
          ⟨y, Algebra.self_mem_adjoin_singleton A y⟩ := by
      apply Subtype.ext
      rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap]
      exact hK
    rw [← (map_mul (algebraMap A (Localization.AtPrime m)) s a), hbr (s * a), hS,
      map_mul]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  have H2 : ∀ b ∈ Q.comap (algebraMap A (Localization.AtPrime m)), ∃ u c : A,
      u ∉ Q.comap (algebraMap A (Localization.AtPrime m)) ∧
      algebraMap A K u * (algebraMap A K a / y) * algebraMap A K b = algebraMap A K c := by
    intro b hb
    rw [Ideal.mem_comap] at hb
    have h1 := (hQa _).mp hb
    rw [← map_mul] at h1
    obtain ⟨u, hu, hu2⟩ := K3 A _ _ C5i m hYm (b * a) h1
    obtain ⟨c, hc⟩ := C5ii _ hu2
    refine ⟨u, c, ?_, ?_⟩
    · intro huQ
      rw [Ideal.mem_comap, hbr] at huQ
      exact (inferInstance : Q.IsPrime).ne_top
        (Ideal.eq_top_of_isUnit_mem _ huQ (IsLocalization.map_units _ (⟨_, hu⟩ : m.primeCompl)))
    · rw [map_mul, map_mul] at hc
      have hc' : algebraMap A K c =
          algebraMap A K u * (algebraMap A K b * algebraMap A K a) / y := by
        rw [← hc, mul_div_cancel_right₀ _ hy0]
      rw [hc']
      ring
  obtain ⟨b₀, hb₀, u₀, c₀, hu₀, hc₀, he₀⟩ := K4a _ _ H1 H2
  have hb₀0 : b₀ ≠ 0 := by
    rintro rfl
    apply hc₀
    have : algebraMap A K c₀ = 0 := by rw [← he₀, map_zero, mul_zero]
    rw [IsFractionRing.injective A K (this.trans (map_zero _).symm)]
    exact Ideal.zero_mem _
  have hdvrA := K4b _ b₀ u₀ c₀ hb₀ hb₀0 hu₀ hc₀ (by
    intro b hb
    obtain ⟨u, c, hu, he⟩ := H2 b hb
    refine ⟨u, c, hu, IsFractionRing.injective A K ?_⟩
    simp only [map_mul]
    linear_combination (-(algebraMap A K u₀ * algebraMap A K b₀)) * he +
      (algebraMap A K u * algebraMap A K b) * he₀)
  have hinjAS : Function.Injective (algebraMap A (Algebra.adjoin A ({y} : Set K))) := by
    intro x1 x2 h
    apply IsFractionRing.injective A K
    have := congrArg Subtype.val h
    rw [Subalgebra.coe_algebraMap, Subalgebra.coe_algebraMap] at this
    exact this
  have hfrS : ∀ s : Algebra.adjoin A ({y} : Set K), ∃ a₁ a₂ : A, a₁ ≠ 0 ∧
      algebraMap A (Algebra.adjoin A ({y} : Set K)) a₁ * s =
        algebraMap A (Algebra.adjoin A ({y} : Set K)) a₂ := by
    intro s
    obtain ⟨a₂, a₁, ha₁, hx⟩ := IsFractionRing.div_surjective (A := A) (s : K)
    have ha₁0 : a₁ ≠ 0 := nonZeroDivisors.ne_zero ha₁
    have ha₁K : algebraMap A K a₁ ≠ 0 := fun h =>
      ha₁0 (IsFractionRing.injective A K (by rw [h, map_zero]))
    refine ⟨a₁, a₂, ha₁0, Subtype.ext ?_⟩
    simp only [Subalgebra.coe_mul, Subalgebra.coe_algebraMap]
    rw [← hx, mul_comm]
    exact div_mul_cancel₀ _ ha₁K
  obtain ⟨hinjR, hfrR⟩ := K6 A _ (Localization.AtPrime m) m.primeCompl
    (Ideal.primeCompl_le_nonZeroDivisors m) hinjAS hfrS
  obtain ⟨hinjRQ, hfrRQ⟩ := K6 A (Localization.AtPrime m) (Localization.AtPrime Q) Q.primeCompl
    (Ideal.primeCompl_le_nonZeroDivisors Q) hinjR hfrR
  have hpeq : Q.comap (algebraMap A (Localization.AtPrime m)) =
      Ideal.comap (algebraMap A (Localization.AtPrime Q))
        (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) := by
    rw [IsScalarTower.algebraMap_eq A (Localization.AtPrime m) (Localization.AtPrime Q),
      ← Ideal.comap_comap]
    have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).comap
        (algebraMap (Localization.AtPrime m) (Localization.AtPrime Q)) = Q :=
      Localization.AtPrime.under_maximalIdeal
    rw [h2]
  have hdvrQ := K5 A (Localization.AtPrime Q) hinjRQ hfrRQ _ hpeq hdvrA
  exact ⟨K7 _ Q _ hx0ne hx0Q hdvrQ, hdvrQ⟩

theorem wcpa_dj_nsc_quot_nagata : ∀ (A K : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    [Field K] [Algebra A K] [IsFractionRing A K], wcpaDjNccNag A → ∀ (y : K)
    (m : Ideal (Algebra.adjoin A ({y} : Set K))) [m.IsMaximal]
    (Q : Ideal (Localization.AtPrime m)) [Q.IsPrime],
    algebraMap (Algebra.adjoin A ({y} : Set K)) (Localization.AtPrime m)
      ⟨y, Algebra.self_mem_adjoin_singleton A y⟩ ∈ Q →
    wcpaDjNccNag (Localization.AtPrime m ⧸ Q) :=
by
  intro A K _ _ _ _ _ _ hNag y m _ Q _ hYQ
  classical

  have s1 : ∀ (D₀ D : Type u) [CommRing D₀] [IsDomain D₀] [CommRing D] [IsDomain D]
      [Algebra D₀ D] (M₀ : Submonoid D₀) (hM₀ : M₀ ≤ nonZeroDivisors D₀) [IsLocalization M₀ D],
      wcpaDjNccN2 D₀ → wcpaDjNccN2 D := by
    intro D₀ D _ _ _ _ _ M₀ hM₀ _ h L _ _ _ _ hfin
    letI : Algebra D₀ L := ((algebraMap D L).comp (algebraMap D₀ D)).toAlgebra
    haveI : IsScalarTower D₀ D L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hinjD : Function.Injective (algebraMap D L) := by
      rw [IsScalarTower.algebraMap_eq D (FractionRing D) L]
      exact (algebraMap (FractionRing D) L).injective.comp
        (IsFractionRing.injective D (FractionRing D))
    have hinj : Function.Injective (algebraMap D₀ L) := by
      rw [IsScalarTower.algebraMap_eq D₀ D L]
      exact hinjD.comp (IsLocalization.injective D hM₀)
    haveI : FaithfulSMul D₀ L := (faithfulSMul_iff_algebraMap_injective D₀ L).mpr hinj
    letI : Algebra (FractionRing D₀) L := FractionRing.liftAlgebra D₀ L
    haveI : IsScalarTower D₀ (FractionRing D₀) L := FractionRing.isScalarTower_liftAlgebra D₀ L
    have key1 : ∀ t : D₀, algebraMap (FractionRing D₀) L (algebraMap D₀ (FractionRing D₀) t) =
        algebraMap D L (algebraMap D₀ D t) := fun t =>
      (IsScalarTower.algebraMap_apply D₀ (FractionRing D₀) L t).symm.trans
        (IsScalarTower.algebraMap_apply D₀ D L t)
    have key2 : ∀ t : D, algebraMap (FractionRing D) L (algebraMap D (FractionRing D) t) =
        algebraMap D L t := fun t => (IsScalarTower.algebraMap_apply D (FractionRing D) L t).symm
    have hμ : ∀ μ : M₀, algebraMap D L (algebraMap D₀ D μ) ≠ 0 := fun μ =>
      ((IsLocalization.map_units D μ).map (algebraMap D L)).ne_zero
    have claim : ∀ c : FractionRing D, ∃ c' : FractionRing D₀,
        algebraMap (FractionRing D) L c = algebraMap (FractionRing D₀) L c' := by
      intro c
      obtain ⟨d, d', hd', rfl⟩ := IsFractionRing.div_surjective (A := D) c
      obtain ⟨⟨e, μ⟩, he⟩ := IsLocalization.surj M₀ d
      obtain ⟨⟨e', μ'⟩, he'⟩ := IsLocalization.surj M₀ d'
      simp only at he he'
      refine ⟨algebraMap D₀ (FractionRing D₀) (e * μ') /
        algebraMap D₀ (FractionRing D₀) (e' * μ), ?_⟩
      have hd'0 : algebraMap D L d' ≠ 0 := fun h0 =>
        nonZeroDivisors.ne_zero hd' (hinjD (h0.trans (map_zero _).symm))
      have h1 := hμ μ
      have h2 := hμ μ'
      rw [map_div₀, map_div₀, key1, key1, key2, key2]
      simp only [map_mul]
      rw [← he, ← he']
      simp only [map_mul]
      field_simp
    have hfin0 : Module.Finite (FractionRing D₀) L := by
      obtain ⟨B, hB⟩ := Module.Finite.fg_top (R := FractionRing D) (M := L)
      refine ⟨⟨B, ?_⟩⟩
      rw [eq_top_iff]
      rintro l -
      have hl : l ∈ Submodule.span (FractionRing D) (B : Set L) := by rw [hB]; trivial
      induction hl using Submodule.span_induction with
      | mem y hy => exact Submodule.subset_span hy
      | zero => exact zero_mem _
      | add y z _ _ hy hz => exact add_mem hy hz
      | smul c y _ hy =>
        obtain ⟨c', hc'⟩ := claim c
        rw [Algebra.smul_def, hc', ← Algebra.smul_def]
        exact Submodule.smul_mem _ _ hy
    have hI0 : Module.Finite D₀ (integralClosure D₀ L) := h L hfin0
    obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := D₀) (M := integralClosure D₀ L)
    let G : Set L := Subtype.val '' (s : Set (integralClosure D₀ L))
    have hspan0 : ∀ w : integralClosure D₀ L, (w : L) ∈ Submodule.span D₀ G := by
      intro w
      have hw : w ∈ Submodule.span D₀ (s : Set (integralClosure D₀ L)) := by rw [hs]; trivial
      exact Submodule.apply_mem_span_image_of_mem_span (integralClosure D₀ L).val.toLinearMap hw
    have heq : (integralClosure D L).toSubmodule = Submodule.span D G := by
      apply le_antisymm
      · intro z hz
        obtain ⟨μ, hμz⟩ := IsIntegral.exists_multiple_integral_of_isLocalization M₀ z hz
        have h1 : (μ : D₀) • z ∈ (Submodule.span D G).restrictScalars D₀ :=
          Submodule.span_le_restrictScalars D₀ D G (hspan0 ⟨_, hμz⟩)
        have h2 : algebraMap D₀ D μ • z ∈ Submodule.span D G := by
          rw [algebraMap_smul]; exact h1
        obtain ⟨v, hv⟩ := IsLocalization.map_units D μ
        have h3 : z = (↑v⁻¹ : D) • (algebraMap D₀ D μ • z) := by
          rw [← hv, smul_smul, Units.inv_mul, one_smul]
        rw [h3]
        exact Submodule.smul_mem _ _ h2
      · rw [Submodule.span_le]
        rintro _ ⟨w, _, rfl⟩
        exact IsIntegral.tower_top w.2
    have hFG : (integralClosure D L).toSubmodule.FG := by
      rw [heq]
      exact Submodule.fg_span (s.finite_toSet.image _)
    exact Module.Finite.iff_fg.mpr hFG

  have s3 : ∀ (A' D : Type u) [CommRing A'] [CommRing D] (φ : A' →+* D),
      (∀ t : D, ∃ a b : A', IsUnit (φ b) ∧ t * φ b = φ a) →
      IsLocalization ((IsUnit.submonoid D).comap (algebraMap φ.range D)) D := by
    intro A' D _ _ φ hfr
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨μ, hμ⟩
      exact hμ
    · intro t
      obtain ⟨a, b, hb, he⟩ := hfr t
      exact ⟨(⟨φ a, a, rfl⟩, ⟨⟨φ b, b, rfl⟩, hb⟩), he⟩
    · intro x x' hxx
      refine ⟨1, ?_⟩
      rw [Subtype.val_injective hxx]

  have s5 : ∀ (A' R : Type u) [CommRing A'] [CommRing R] (Q : Ideal R) (φ : A' →+* R),
      wcpaDjNccNag A' → IsNoetherianRing R →
      (∀ r : R, ∃ a b : A', IsUnit (Ideal.Quotient.mk Q (φ b)) ∧
        Ideal.Quotient.mk Q r * Ideal.Quotient.mk Q (φ b) = Ideal.Quotient.mk Q (φ a)) →
      wcpaDjNccNag (R ⧸ Q) := by
    intro A' R _ _ Q φ hNag' hR hfr
    refine ⟨?_, ?_⟩
    · haveI := hR; exact Ideal.Quotient.isNoetherianRing Q
    · intro D _ _ _ hsurj
      obtain ⟨ψ, hψ⟩ : ∃ ψ : A' →+* D,
          ψ = (algebraMap (R ⧸ Q) D).comp ((Ideal.Quotient.mk Q).comp φ) := ⟨_, rfl⟩
      have J1 : ∀ t : D, ∃ a b : A', IsUnit (ψ b) ∧ t * ψ b = ψ a := by
        intro t
        obtain ⟨q, rfl⟩ := hsurj t
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
        obtain ⟨a, b, hu, he⟩ := hfr r
        refine ⟨a, b, ?_, ?_⟩
        · rw [hψ, RingHom.comp_apply, RingHom.comp_apply]
          exact hu.map _
        · rw [hψ, RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply,
            RingHom.comp_apply, ← map_mul, he]
      letI : Algebra A' ψ.range := ψ.rangeRestrict.toAlgebra
      have hsurj0 : Function.Surjective (algebraMap A' ψ.range) := ψ.rangeRestrict_surjective
      have hN2 : wcpaDjNccN2 ψ.range := hNag'.2 ψ.range hsurj0
      haveI hloc := s3 A' D ψ J1
      have hle : (IsUnit.submonoid D).comap (algebraMap ψ.range D) ≤
          nonZeroDivisors ψ.range := by
        intro μ hμ
        apply mem_nonZeroDivisors_of_ne_zero
        intro h0
        have hu : IsUnit (algebraMap ψ.range D μ) := hμ
        rw [h0, map_zero] at hu
        exact not_isUnit_zero hu
      exact s1 ψ.range D _ hle hN2

  have s2 : ∀ s : Algebra.adjoin A ({y} : Set K), ∃ (a : A) (w : Algebra.adjoin A ({y} : Set K)),
      s = algebraMap A (Algebra.adjoin A ({y} : Set K)) a +
        ⟨y, Algebra.self_mem_adjoin_singleton A y⟩ * w := by
    have P : ∀ z ∈ Algebra.adjoin A ({y} : Set K), ∃ a : A,
        ∃ w ∈ Algebra.adjoin A ({y} : Set K), z = algebraMap A K a + y * w := by
      intro z hz
      induction hz using Algebra.adjoin_induction with
      | mem x hx =>
        rw [Set.mem_singleton_iff] at hx
        rw [hx]
        exact ⟨0, 1, Subalgebra.one_mem _, by simp⟩
      | algebraMap c => exact ⟨c, 0, Subalgebra.zero_mem _, by simp⟩
      | add x z _ _ hx hz =>
        obtain ⟨a₁, w₁, hw₁, rfl⟩ := hx
        obtain ⟨a₂, w₂, hw₂, rfl⟩ := hz
        exact ⟨a₁ + a₂, w₁ + w₂, Subalgebra.add_mem _ hw₁ hw₂, by rw [map_add]; ring⟩
      | mul x z _ _ hx hz =>
        obtain ⟨a₁, w₁, hw₁, rfl⟩ := hx
        obtain ⟨a₂, w₂, hw₂, rfl⟩ := hz
        refine ⟨a₁ * a₂, algebraMap A K a₁ * w₂ + w₁ * algebraMap A K a₂ + y * w₁ * w₂, ?_,
          by rw [map_mul]; ring⟩
        have hyS := Algebra.self_mem_adjoin_singleton A y
        exact Subalgebra.add_mem _ (Subalgebra.add_mem _
          (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) hw₂)
          (Subalgebra.mul_mem _ hw₁ (Subalgebra.algebraMap_mem _ _)))
          (Subalgebra.mul_mem _ (Subalgebra.mul_mem _ hyS hw₁) hw₂)
    intro s
    obtain ⟨a, w, hw, h⟩ := P s.1 s.2
    exact ⟨a, ⟨w, hw⟩, Subtype.ext (by simpa using h)⟩


  have s4g : ∀ (A' S R : Type u) [CommRing A'] [CommRing S] [CommRing R] [Algebra A' S]
      [Algebra S R] (M : Submonoid S) [IsLocalization M R] (Q : Ideal R) (Y : S),
      algebraMap S R Y ∈ Q →
      (∀ s : S, ∃ (a : A') (w : S), s = algebraMap A' S a + Y * w) →
      ∀ r : R, ∃ a b : A',
        IsUnit (Ideal.Quotient.mk Q (((algebraMap S R).comp (algebraMap A' S)) b)) ∧
        Ideal.Quotient.mk Q r * Ideal.Quotient.mk Q (((algebraMap S R).comp (algebraMap A' S)) b) =
        Ideal.Quotient.mk Q (((algebraMap S R).comp (algebraMap A' S)) a) := by
    intro A' S R _ _ _ _ _ M _ Q Y hYQ' hdec
    have hY0 : Ideal.Quotient.mk Q (algebraMap S R Y) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hYQ'
    have hconst : ∀ s : S, ∃ a : A',
        Ideal.Quotient.mk Q (algebraMap S R s) =
        Ideal.Quotient.mk Q (((algebraMap S R).comp (algebraMap A' S)) a) := by
      intro s
      obtain ⟨a, w, rfl⟩ := hdec s
      refine ⟨a, ?_⟩
      rw [map_add, map_mul, map_add, map_mul, hY0, zero_mul, add_zero, RingHom.comp_apply]
    intro r
    obtain ⟨⟨s, u⟩, hsu⟩ := IsLocalization.surj M r
    obtain ⟨a, ha⟩ := hconst s
    obtain ⟨b, hb⟩ := hconst u
    refine ⟨a, b, ?_, ?_⟩
    · rw [← hb]
      exact (IsLocalization.map_units R u).map _
    · rw [← hb, ← ha, ← map_mul, hsu]
  have s4 := s4g A (Algebra.adjoin A ({y} : Set K)) (Localization.AtPrime m) m.primeCompl Q
    ⟨y, Algebra.self_mem_adjoin_singleton A y⟩ hYQ s2

  haveI : IsNoetherianRing A := hNag.1
  have hfg : (Algebra.adjoin A ({y} : Set K)).FG := by
    simpa using Subalgebra.fg_adjoin_finset (R := A) ({y} : Finset K)
  haveI : Algebra.FiniteType A (Algebra.adjoin A ({y} : Set K)) :=
    (Subalgebra.fg_iff_finiteType _).mp hfg
  haveI : IsNoetherianRing (Algebra.adjoin A ({y} : Set K)) :=
    Algebra.FiniteType.isNoetherianRing A _
  have hR : IsNoetherianRing (Localization.AtPrime m) :=
    IsLocalization.isNoetherianRing m.primeCompl _ inferInstance

  exact s5 A (Localization.AtPrime m) Q ((algebraMap (Algebra.adjoin A ({y} : Set K))
    (Localization.AtPrime m)).comp (algebraMap A (Algebra.adjoin A ({y} : Set K)))) hNag hR s4

theorem wcpa_dj_ncc_ns_core : wcpaDjNccNsCore.{u} :=
by
  intro A K _ _ _ _ _ _ hNag x r m _ hm
  classical

  have key : ∀ (y : K) (T : Subalgebra A K), T = Algebra.adjoin A ({y} : Set K) →
      ∀ (hy : y ∈ T) (n : Ideal T) [n.IsMaximal], (⟨y, hy⟩ : T) ∈ n →
      wcpaDjNccN1 (Localization.AtPrime n) := by
    intro y T hT hy n _ hn
    subst hT
    by_cases hy0 : y = 0
    ·
      subst hy0
      have hbij : Function.Bijective
          (algebraMap A (Algebra.adjoin A ({(0 : K)} : Set K))) := by
        refine ⟨fun a b hab => ?_, fun s => ?_⟩
        · apply IsFractionRing.injective A K
          have := congrArg Subtype.val hab
          simpa using this
        · have hle : Algebra.adjoin A ({(0 : K)} : Set K) ≤ ⊥ :=
            Algebra.adjoin_le (by
              intro z hz
              rw [Set.mem_singleton_iff] at hz
              rw [hz]
              exact Subalgebra.zero_mem _)
          obtain ⟨a, ha⟩ := Algebra.mem_bot.mp (hle s.2)
          exact ⟨a, Subtype.ext (by simpa using ha)⟩
      haveI : IsIntegrallyClosed (Algebra.adjoin A ({(0 : K)} : Set K)) :=
        IsIntegrallyClosed.of_equiv (RingEquiv.ofBijective _ hbij)
      haveI : IsIntegrallyClosed (Localization.AtPrime n) :=
        isIntegrallyClosed_of_isLocalization (Localization.AtPrime n) n.primeCompl
          (Ideal.primeCompl_le_nonZeroDivisors n)
      have hgen : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsIntegrallyClosed B],
          wcpaDjNccN1 B := by
        intro B _ _ _
        unfold wcpaDjNccN1
        rw [IsIntegrallyClosed.integralClosure_eq_bot]
        exact Subalgebra.finite_bot
      exact hgen _
    · haveI : IsNoetherianRing A := hNag.1
      haveI : Algebra.FiniteType A (Algebra.adjoin A ({y} : Set K)) := by
        have h : (Algebra.adjoin A ({y} : Set K)).FG := by
          have := Subalgebra.fg_adjoin_finset (R := A) ({y} : Finset K)
          simpa using this
        exact (Subalgebra.fg_iff_finiteType _).mp h
      haveI : IsNoetherianRing (Algebra.adjoin A ({y} : Set K)) :=
        Algebra.FiniteType.isNoetherianRing A _
      set R := Localization.AtPrime n with hRdef
      set x0 : R := algebraMap (Algebra.adjoin A ({y} : Set K)) R
        ⟨y, Algebra.self_mem_adjoin_singleton A y⟩ with hx0
      have hx0m : x0 ∈ IsLocalRing.maximalIdeal R :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff R n _).mpr hn
      have hx0ne : x0 ≠ 0 := by
        intro h0
        apply hy0
        have hinj := IsLocalization.injective R (Ideal.primeCompl_le_nonZeroDivisors n)
        have h1 : (⟨y, Algebra.self_mem_adjoin_singleton A y⟩ :
            Algebra.adjoin A ({y} : Set K)) = 0 := hinj (by rw [map_zero]; exact h0)
        exact congrArg Subtype.val h1
      apply wcpa_dj_nsc_au_n1 R
      refine wcpa_dj_nsc_tate R x0 hx0m hx0ne ?_
      intro Q _ hQ
      obtain ⟨hmin, hdvr⟩ := wcpa_dj_nsc_ass_dvr A K hNag y hy0 n hn Q hQ
      have hx0Q : x0 ∈ Q := hmin.1.2 (Ideal.subset_span rfl)
      haveI : IsLocalRing (R ⧸ Q) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk Q) Ideal.Quotient.mk_surjective
      have hNagQ : wcpaDjNccNag (R ⧸ Q) := wcpa_dj_nsc_quot_nagata A K hNag y n Q hx0Q
      exact ⟨hmin, hdvr, wcpa_dj_nsc_au_quot_transfer R Q
        (wcpa_dj_nsc_local_nagata_au (R ⧸ Q) hNagQ)⟩
  have hy : x - algebraMap A K r ∈ Algebra.adjoin A ({x} : Set K) :=
    Subalgebra.sub_mem _ (Algebra.self_mem_adjoin_singleton A x) (Subalgebra.algebraMap_mem _ r)
  have hT : Algebra.adjoin A ({x} : Set K) = Algebra.adjoin A ({x - algebraMap A K r} : Set K) := by
    apply le_antisymm
    · apply Algebra.adjoin_le
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      have h2 := Subalgebra.add_mem _
        (Algebra.self_mem_adjoin_singleton A (x - algebraMap A K r))
        (Subalgebra.algebraMap_mem (Algebra.adjoin A ({x - algebraMap A K r} : Set K)) r)
      rwa [sub_add_cancel] at h2
    · apply Algebra.adjoin_le
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact hy
  refine key (x - algebraMap A K r) _ hT hy m ?_
  have heq : (⟨x - algebraMap A K r, hy⟩ : Algebra.adjoin A ({x} : Set K)) =
      (⟨x, Algebra.self_mem_adjoin_singleton A x⟩ : Algebra.adjoin A ({x} : Set K)) -
        algebraMap A (Algebra.adjoin A ({x} : Set K)) r := by
    apply Subtype.ext
    simp
  rw [heq]
  exact hm

theorem wcpa_dj_ncc_nag_star : wcpaDjNccNagStar.{u} :=
by
  unfold wcpaDjNccNagStar
  intro A K _ _ _ _ _ _ hNag x
  haveI : IsNoetherianRing A := hNag.1
  obtain ⟨b, a, ha, hx⟩ := IsFractionRing.div_surjective (A := A) x
  have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
  have hak : algebraMap A K a ≠ 0 := by
    intro h
    apply ha0
    apply IsFractionRing.injective A K
    rw [h, map_zero]
  have hS : IsNoetherianRing (Algebra.adjoin A ({x} : Set K)) := by
    have h : (Algebra.adjoin A ({x} : Set K)).FG := by
      have := Subalgebra.fg_adjoin_finset (R := A) ({x} : Finset K)
      simpa using this
    haveI : Algebra.FiniteType A (Algebra.adjoin A ({x} : Set K)) :=
      (Subalgebra.fg_iff_finiteType _).mp h
    exact Algebra.FiniteType.isNoetherianRing A _
  have hf : algebraMap A (Algebra.adjoin A ({x} : Set K)) a ≠ 0 := by
    intro h
    apply hak
    have h2 := congrArg (fun s : Algebra.adjoin A ({x} : Set K) => (s : K)) h
    simpa using h2
  have hxa : algebraMap A K a * x = algebraMap A K b := by
    rw [← hx]
    field_simp
  exact wcpa_dj_ncc_ns_local_global (Algebra.adjoin A ({x} : Set K)) _ hf
    (wcpa_dj_ncc_ns_denominator A K a b ha0 x hxa)
    (wcpa_dj_ncc_ns_reduce_local (wcpa_dj_ncc_ns_local wcpa_dj_ncc_ns_core) A K hNag x)

theorem wcpa_dj_ncc_nag_monogenic : wcpaDjNccNagFin.{u} → wcpaDjNccNagPoly.{u} →
    wcpaDjNccNagStar.{u} → ∀ (A : Type u) [CommRing A], wcpaDjNccNag A →
    wcpaDjNccNag (Polynomial A) :=
by
  intro hFin hPoly hStar A _ hA

  have s3 : ∀ (A₀ D L : Type u) [CommRing A₀] [CommRing D] [CommRing L] [Algebra A₀ D]
      [Algebra D L] [Algebra A₀ L] [IsScalarTower A₀ D L], Module.Finite A₀ D →
      Module.Finite A₀ (integralClosure A₀ L) → Module.Finite D (integralClosure D L) := by
    intro A₀ D L _ _ _ _ _ _ _ hD hI
    haveI := hD
    haveI : Algebra.IsIntegral A₀ D := Algebra.IsIntegral.of_finite A₀ D
    have heq : ∀ x : L, x ∈ integralClosure D L ↔ x ∈ integralClosure A₀ L := by
      intro x
      simp only [mem_integralClosure_iff]
      exact ⟨fun hx => isIntegral_trans x hx, fun hx => hx.tower_top⟩
    have hI' : (Subalgebra.toSubmodule (integralClosure A₀ L)).FG := Module.Finite.iff_fg.mp hI
    suffices hG : (Subalgebra.toSubmodule (integralClosure D L)).FG from
      Module.Finite.iff_fg.mpr hG
    obtain ⟨s, hs⟩ := hI'
    refine ⟨s, le_antisymm ?_ ?_⟩
    · rw [Submodule.span_le]
      intro x hx
      have : x ∈ Subalgebra.toSubmodule (integralClosure A₀ L) := hs ▸ Submodule.subset_span hx
      exact (heq x).mpr this
    · intro x hx
      have h1 : x ∈ Subalgebra.toSubmodule (integralClosure A₀ L) := (heq x).mp hx
      rw [← hs] at h1
      exact Submodule.span_le_restrictScalars A₀ D (s : Set L) h1
  have s4 : ∀ (A₀ D L : Type u) [CommRing A₀] [IsDomain A₀] [CommRing D] [IsDomain D]
      [Algebra A₀ D] [Field L] [Algebra D L] [Algebra A₀ L] [IsScalarTower A₀ D L]
      [Algebra (FractionRing D) L] [IsScalarTower D (FractionRing D) L]
      [Algebra (FractionRing A₀) L] [IsScalarTower A₀ (FractionRing A₀) L],
      Function.Injective (algebraMap A₀ D) → Module.Finite A₀ D →
      Module.Finite (FractionRing D) L → Module.Finite (FractionRing A₀) L := by
    intro A₀ D L _ _ _ _ _ _ _ _ _ _ _ _ _ hinj hD hL
    haveI := hD
    haveI := hL
    haveI : FaithfulSMul A₀ D := (faithfulSMul_iff_algebraMap_injective A₀ D).mpr hinj
    letI : Algebra (FractionRing A₀) (FractionRing D) := Ring.instAlgebraFractionRing A₀ D
    haveI : IsScalarTower A₀ (FractionRing A₀) (FractionRing D) :=
      FractionRing.isScalarTower_liftAlgebra A₀ (FractionRing D)
    haveI : Module.Finite (FractionRing A₀) (FractionRing D) := inferInstance
    haveI : IsScalarTower (FractionRing A₀) (FractionRing D) L := by
      apply IsScalarTower.of_algebraMap_eq'
      apply IsLocalization.ringHom_ext (nonZeroDivisors A₀)
      rw [← IsScalarTower.algebraMap_eq, RingHom.comp_assoc,
        ← IsScalarTower.algebraMap_eq A₀ (FractionRing A₀) (FractionRing D),
        IsScalarTower.algebraMap_eq A₀ D (FractionRing D), ← RingHom.comp_assoc,
        ← IsScalarTower.algebraMap_eq D (FractionRing D) L, ← IsScalarTower.algebraMap_eq]
    exact Module.Finite.trans (FractionRing D) L

  have L1 : ∀ (A₀ D : Type u) [CommRing A₀] [IsDomain A₀] [CommRing D] [IsDomain D]
      [Algebra A₀ D], Function.Injective (algebraMap A₀ D) → Module.Finite A₀ D →
      wcpaDjNccN2 A₀ → wcpaDjNccN2 D := by
    intro A₀ D _ _ _ _ _ hinj hD hN2 L _ _ _ _ hL
    letI : Algebra A₀ L := ((algebraMap D L).comp (algebraMap A₀ D)).toAlgebra
    haveI : IsScalarTower A₀ D L := IsScalarTower.of_algebraMap_eq' rfl
    have hinjD : Function.Injective (algebraMap D L) := by
      rw [IsScalarTower.algebraMap_eq D (FractionRing D) L]
      exact (algebraMap (FractionRing D) L).injective.comp
        (IsFractionRing.injective D (FractionRing D))
    have hinjL : Function.Injective (algebraMap A₀ L) := by
      rw [IsScalarTower.algebraMap_eq A₀ D L]
      exact hinjD.comp hinj
    haveI : FaithfulSMul A₀ L := (faithfulSMul_iff_algebraMap_injective _ _).mpr hinjL
    letI : Algebra (FractionRing A₀) L := FractionRing.liftAlgebra _ L
    haveI := FractionRing.isScalarTower_liftAlgebra A₀ L
    exact s3 A₀ D L hD (hN2 L (s4 A₀ D L hinj hD hL))

  have hNagImg : ∀ (D₀ : Type u) [CommRing D₀] [Algebra A D₀],
      Function.Surjective (algebraMap A D₀) → wcpaDjNccNag D₀ := by
    intro D₀ _ _ hs
    haveI := hA.1
    refine ⟨isNoetherianRing_of_surjective A D₀ (algebraMap A D₀) hs, ?_⟩
    intro E _ _ _ hE
    letI : Algebra A E := ((algebraMap D₀ E).comp (algebraMap A D₀)).toAlgebra
    exact hA.2 E (hE.comp hs)

  have L2 : ∀ (D₀ D L : Type u) [CommRing D₀] [IsDomain D₀] [CommRing D] [IsDomain D]
      [Algebra D₀ D] [Field L] [Algebra D L] [Algebra D₀ L] [IsScalarTower D₀ D L]
      [Algebra (FractionRing D) L] [IsScalarTower D (FractionRing D) L]
      [Algebra (FractionRing D₀) L] [IsScalarTower D₀ (FractionRing D₀) L] (x : D),
      Algebra.adjoin D₀ {x} = ⊤ → IsAlgebraic D₀ x → Module.Finite (FractionRing D) L →
      Module.Finite (FractionRing D₀) L := by
    intro D₀ D L _ _ _ _ _ _ _ _ _ _ _ _ _ x hgen halg hL
    have hy1 : IsAlgebraic D₀ (algebraMap D L x) := halg.algebraMap
    have hy2 : IsAlgebraic (FractionRing D₀) (algebraMap D L x) :=
      hy1.extendScalars (IsFractionRing.injective D₀ (FractionRing D₀))
    have hy3 : _root_.IsIntegral (FractionRing D₀) (algebraMap D L x) := hy2.isIntegral
    haveI : FiniteDimensional (FractionRing D₀)
        (IntermediateField.adjoin (FractionRing D₀) {algebraMap D L x}) :=
      IntermediateField.adjoin.finiteDimensional hy3
    have hD : ∀ d : D, algebraMap D L d ∈
        IntermediateField.adjoin (FractionRing D₀) {algebraMap D L x} := by
      intro d
      have hd : d ∈ Algebra.adjoin D₀ {x} := by rw [hgen]; exact Algebra.mem_top
      induction hd using Algebra.adjoin_induction with
      | mem z hz =>
        rw [Set.mem_singleton_iff.mp hz]
        exact IntermediateField.mem_adjoin_simple_self _ _
      | algebraMap r =>
        rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply D₀ (FractionRing D₀) L]
        exact IntermediateField.algebraMap_mem _ _
      | add a b _ _ ha hb => rw [map_add]; exact add_mem ha hb
      | mul a b _ _ ha hb => rw [map_mul]; exact mul_mem ha hb
    have hF : ∀ f : FractionRing D, algebraMap (FractionRing D) L f ∈
        IntermediateField.adjoin (FractionRing D₀) {algebraMap D L x} := by
      intro f
      obtain ⟨a, b, _, rfl⟩ := IsFractionRing.div_surjective (A := D) f
      rw [map_div₀, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
      exact div_mem (hD a) (hD b)
    haveI : Module.Finite (IntermediateField.adjoin (FractionRing D₀) {algebraMap D L x}) L := by
      obtain ⟨s, hs⟩ := hL.fg_top
      refine ⟨⟨s, ?_⟩⟩
      rw [eq_top_iff]
      rintro z -
      have hz : z ∈ Submodule.span (FractionRing D) (s : Set L) := by
        rw [hs]; exact Submodule.mem_top
      induction hz using Submodule.span_induction with
      | mem w hw => exact Submodule.subset_span hw
      | zero => exact zero_mem _
      | add a b _ _ ha hb => exact add_mem ha hb
      | smul f w _ hw =>
        have : f • w = (⟨algebraMap (FractionRing D) L f, hF f⟩ :
            IntermediateField.adjoin (FractionRing D₀) {algebraMap D L x}) • w := by
          rw [Algebra.smul_def, Algebra.smul_def]
          rfl
        rw [this]
        exact Submodule.smul_mem _ _ hw
    exact Module.Finite.trans (IntermediateField.adjoin (FractionRing D₀) {algebraMap D L x}) L

  have s3' : ∀ (D S L : Type u) [CommRing D] [CommRing S] [CommRing L] [Algebra D S]
      [Algebra S L] [Algebra D L] [IsScalarTower D S L], Module.Finite D S →
      Module.Finite S (integralClosure S L) → Module.Finite D (integralClosure D L) := by
    intro D S L _ _ _ _ _ _ _ hDS hI
    haveI := hDS
    haveI : Algebra.IsIntegral D S := Algebra.IsIntegral.of_finite D S
    have hI' : (Subalgebra.toSubmodule (integralClosure S L)).FG := Module.Finite.iff_fg.mp hI
    have hfg := hI'.restrictScalars (R := D)
    suffices hG : (Subalgebra.toSubmodule (integralClosure D L)).FG from
      Module.Finite.iff_fg.mpr hG
    have heq : Subalgebra.toSubmodule (integralClosure D L) =
        Submodule.restrictScalars D (Subalgebra.toSubmodule (integralClosure S L)) := by
      ext z
      simp only [Subalgebra.mem_toSubmodule, Submodule.restrictScalars_mem,
        mem_integralClosure_iff]
      exact ⟨fun hz => hz.tower_top, fun hz => isIntegral_trans z hz⟩
    rw [heq]
    exact hfg

  have L3gen : ∀ (S L : Type u) [CommRing S] [IsDomain S] [Field L] [Algebra S L]
      [IsFractionRing S L], Module.Finite S (integralClosure S (FractionRing S)) →
      Module.Finite S (integralClosure S L) := by
    intro S L _ _ _ _ _ hN1
    let e : FractionRing S ≃ₐ[S] L := IsLocalization.algEquiv (nonZeroDivisors S) _ L
    have h1 : Subalgebra.map (e : FractionRing S →ₐ[S] L) (integralClosure S (FractionRing S)) =
        integralClosure S L := integralClosure_map_algEquiv e
    let e1 : integralClosure S (FractionRing S) ≃ₐ[S]
        Subalgebra.map (e : FractionRing S →ₐ[S] L) (integralClosure S (FractionRing S)) :=
      e.subalgebraMap _
    let e2 : integralClosure S (FractionRing S) ≃ₐ[S] integralClosure S L :=
      e1.trans (Subalgebra.equivOfEq _ _ h1)
    exact Module.Finite.equiv e2.toLinearEquiv
  have L3 : ∀ (B L : Type u) [CommRing B] [IsDomain B] [Field L] [Algebra B L]
      [IsFractionRing B L] (y : L), wcpaDjNccN1 (Algebra.adjoin B {y}) →
      Module.Finite (Algebra.adjoin B {y}) (integralClosure (Algebra.adjoin B {y}) L) := by
    intro B L _ _ _ _ _ y hN1
    haveI : IsFractionRing (Algebra.adjoin B {y}) L := by
      apply IsFractionRing.of_field
      intro z
      obtain ⟨a, b, _, rfl⟩ := IsFractionRing.div_surjective (A := B) z
      exact ⟨algebraMap B _ a, algebraMap B _ b, by
        rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]⟩
    exact L3gen (Algebra.adjoin B {y}) L hN1

  have L4 : ∀ (D₀ D L B : Type u) [CommRing D₀] [CommRing D] [CommRing L] [CommRing B]
      [Algebra D₀ D] [Algebra D L] [Algebra D₀ L] [IsScalarTower D₀ D L] [Algebra D₀ B]
      [Algebra B L] [IsScalarTower D₀ B L] (x : D),
      Algebra.adjoin D₀ {x} = ⊤ → Module.Finite D₀ B →
      Module.Finite (Algebra.adjoin B {algebraMap D L x})
        (integralClosure (Algebra.adjoin B {algebraMap D L x}) L) →
      Module.Finite D (integralClosure D L) := by
    intro D₀ D L B _ _ _ _ _ _ _ _ _ _ _ x hgen hB hS
    have hDS : ∀ d : D, algebraMap D L d ∈ Algebra.adjoin B {algebraMap D L x} := by
      intro d
      have hd : d ∈ Algebra.adjoin D₀ {x} := by rw [hgen]; exact Algebra.mem_top
      induction hd using Algebra.adjoin_induction with
      | mem z hz => rw [Set.mem_singleton_iff.mp hz]; exact Algebra.subset_adjoin rfl
      | algebraMap r =>
        rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply D₀ B L]
        exact Subalgebra.algebraMap_mem _ _
      | add a b _ _ ha hb => rw [map_add]; exact add_mem ha hb
      | mul a b _ _ ha hb => rw [map_mul]; exact mul_mem ha hb
    letI : Algebra D (Algebra.adjoin B {algebraMap D L x}) :=
      (RingHom.codRestrict (algebraMap D L) (Algebra.adjoin B {algebraMap D L x}) hDS).toAlgebra
    haveI : IsScalarTower D (Algebra.adjoin B {algebraMap D L x}) L :=
      IsScalarTower.of_algebraMap_eq' rfl
    obtain ⟨k, g, hg⟩ := Module.Finite.exists_fin (R := D₀) (M := B)
    have hBN : ∀ b : B, algebraMap B L b ∈
        Submodule.span D (Set.range (fun j => algebraMap B L (g j))) := by
      intro b
      have hb : b ∈ Submodule.span D₀ (Set.range g) := by rw [hg]; exact Submodule.mem_top
      induction hb using Submodule.span_induction with
      | mem w hw =>
        obtain ⟨j, rfl⟩ := hw
        exact Submodule.subset_span ⟨j, rfl⟩
      | zero => rw [map_zero]; exact zero_mem _
      | add a b _ _ ha hb =>
        rw [map_add]
        exact add_mem ha hb
      | smul r w _ hw =>
        have : algebraMap B L (r • w) = algebraMap D₀ D r • algebraMap B L w := by
          rw [Algebra.smul_def, Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply,
            ← IsScalarTower.algebraMap_apply]
        rw [this]
        exact Submodule.smul_mem _ _ hw
    have hSN : ∀ z ∈ Algebra.adjoin B {algebraMap D L x},
        z ∈ Submodule.span D (Set.range (fun j => algebraMap B L (g j))) := by
      intro z hz
      rw [Algebra.adjoin_singleton_eq_range_aeval] at hz
      obtain ⟨p, rfl⟩ := (AlgHom.mem_range _).mp hz
      refine Polynomial.induction_on
        (motive := fun q => Polynomial.aeval (algebraMap D L x) q ∈
          Submodule.span D (Set.range (fun j => algebraMap B L (g j)))) p ?_ ?_ ?_
      · intro b
        rw [Polynomial.aeval_C]
        exact hBN b
      · intro p q hp hq
        rw [map_add]
        exact add_mem hp hq
      · intro n b ih
        have : Polynomial.aeval (algebraMap D L x) (Polynomial.C b * Polynomial.X ^ (n + 1)) =
            x • Polynomial.aeval (algebraMap D L x) (Polynomial.C b * Polynomial.X ^ n) := by
          rw [Algebra.smul_def, pow_succ, ← mul_assoc, map_mul, Polynomial.aeval_X, mul_comm]
        rw [this]
        exact Submodule.smul_mem _ _ ih
    have hgS : ∀ j, algebraMap B L (g j) ∈ Algebra.adjoin B {algebraMap D L x} :=
      fun j => Subalgebra.algebraMap_mem _ (g j)
    haveI hSfin : Module.Finite D (Algebra.adjoin B {algebraMap D L x}) := by
      refine Module.finite_def.mpr (Submodule.fg_def.mpr ⟨Set.range (fun j =>
        (⟨algebraMap B L (g j), hgS j⟩ : Algebra.adjoin B {algebraMap D L x})),
        Set.finite_range _, ?_⟩)
      rw [eq_top_iff]
      rintro z -
      let f : Algebra.adjoin B {algebraMap D L x} →ₗ[D] L :=
        (IsScalarTower.toAlgHom D (Algebra.adjoin B {algebraMap D L x}) L).toLinearMap
      have hf : Function.Injective f := fun a b h => Subtype.ext h
      have hz : f z ∈ Submodule.map f (Submodule.span D (Set.range (fun j =>
          (⟨algebraMap B L (g j), hgS j⟩ : Algebra.adjoin B {algebraMap D L x})))) := by
        rw [Submodule.map_span, ← Set.range_comp]
        exact hSN z z.2
      obtain ⟨w, hw, hwz⟩ := hz
      rwa [← hf hwz]
    exact s3' D (Algebra.adjoin B {algebraMap D L x}) L hSfin hS

  haveI := hA.1
  refine ⟨inferInstance, ?_⟩
  intro D _ _ _ hsurj
  letI : Algebra A D := ((algebraMap (Polynomial A) D).comp Polynomial.C).toAlgebra
  have hsurj₀ : Function.Surjective (algebraMap A (⊥ : Subalgebra A D)) := by
    intro y
    obtain ⟨a, ha⟩ := Algebra.mem_bot.mp y.2
    exact ⟨a, Subtype.ext ha⟩
  have hNag₀ := hNagImg (⊥ : Subalgebra A D) hsurj₀
  have hN2₀ : wcpaDjNccN2 (⊥ : Subalgebra A D) := hA.2 _ hsurj₀
  haveI hNoeth₀ : IsNoetherianRing (⊥ : Subalgebra A D) := hNag₀.1
  have hgen : Algebra.adjoin (⊥ : Subalgebra A D)
      {algebraMap (Polynomial A) D Polynomial.X} = ⊤ := by
    rw [eq_top_iff]
    intro d _
    obtain ⟨p, rfl⟩ := hsurj d
    refine Polynomial.induction_on (motive := fun q => algebraMap (Polynomial A) D q ∈
      Algebra.adjoin (⊥ : Subalgebra A D) {algebraMap (Polynomial A) D Polynomial.X}) p ?_ ?_ ?_
    · intro a
      have : algebraMap (Polynomial A) D (Polynomial.C a) =
          algebraMap (⊥ : Subalgebra A D) D (algebraMap A _ a) := rfl
      rw [this]
      exact Subalgebra.algebraMap_mem _ _
    · intro p q hp hq
      rw [map_add]
      exact add_mem hp hq
    · intro n a ih
      rw [pow_succ, ← mul_assoc, map_mul]
      exact mul_mem ih (Algebra.subset_adjoin rfl)
  by_cases ht : Transcendental (⊥ : Subalgebra A D) (algebraMap (Polynomial A) D Polynomial.X)
  · letI : Algebra (Polynomial (⊥ : Subalgebra A D)) D :=
      (Polynomial.aeval (algebraMap (Polynomial A) D Polynomial.X)).toRingHom.toAlgebra
    have hinjP : Function.Injective (algebraMap (Polynomial (⊥ : Subalgebra A D)) D) :=
      transcendental_iff_injective.mp ht
    have hsurjP : Function.Surjective (algebraMap (Polynomial (⊥ : Subalgebra A D)) D) := by
      intro d
      have hd : d ∈ Algebra.adjoin (⊥ : Subalgebra A D)
          {algebraMap (Polynomial A) D Polynomial.X} := by rw [hgen]; exact Algebra.mem_top
      rw [Algebra.adjoin_singleton_eq_range_aeval] at hd
      obtain ⟨p, hp⟩ := (AlgHom.mem_range _).mp hd
      exact ⟨p, hp⟩
    haveI : Module.Finite (Polynomial (⊥ : Subalgebra A D)) D :=
      Module.Finite.of_surjective (Algebra.linearMap _ D) hsurjP
    exact L1 _ D hinjP inferInstance (hPoly _ hNoeth₀ hN2₀)
  · have halg : IsAlgebraic (⊥ : Subalgebra A D) (algebraMap (Polynomial A) D Polynomial.X) :=
      not_not.mp ht
    intro L _ _ _ _ hL
    have hinjD : Function.Injective (algebraMap D L) := by
      rw [IsScalarTower.algebraMap_eq D (FractionRing D) L]
      exact (algebraMap (FractionRing D) L).injective.comp
        (IsFractionRing.injective D (FractionRing D))
    have hinjL : Function.Injective (algebraMap (⊥ : Subalgebra A D) L) := by
      rw [IsScalarTower.algebraMap_eq (⊥ : Subalgebra A D) D L]
      exact hinjD.comp Subtype.val_injective
    haveI : FaithfulSMul (⊥ : Subalgebra A D) L :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hinjL
    letI : Algebra (FractionRing (⊥ : Subalgebra A D)) L := FractionRing.liftAlgebra _ L
    haveI := FractionRing.isScalarTower_liftAlgebra (⊥ : Subalgebra A D) L
    have hLfin := L2 (⊥ : Subalgebra A D) D L _ hgen halg hL
    haveI := hLfin
    have hB : Module.Finite (⊥ : Subalgebra A D) (integralClosure (⊥ : Subalgebra A D) L) :=
      hN2₀ L hLfin
    haveI : IsIntegrallyClosed (integralClosure (⊥ : Subalgebra A D) L) :=
      integralClosure.isIntegrallyClosedOfFiniteExtension (FractionRing (⊥ : Subalgebra A D))
    haveI : IsFractionRing (integralClosure (⊥ : Subalgebra A D) L) L :=
      integralClosure.isFractionRing_of_finite_extension (FractionRing (⊥ : Subalgebra A D)) L
    have hNagB := hFin _ _ hB hNag₀
    have hN1 := hStar (integralClosure (⊥ : Subalgebra A D) L) L hNagB
      (algebraMap D L (algebraMap (Polynomial A) D Polynomial.X))
    have hS := L3 _ L _ hN1
    exact L4 (⊥ : Subalgebra A D) D L (integralClosure (⊥ : Subalgebra A D) L) _ hgen hB hS

theorem fgm_nagata_ascent : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A], (∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra A D], Function.Surjective (algebraMap A D) → ∀ (L : Type u) [Field L] [Algebra D L] [Algebra (FractionRing D) L] [IsScalarTower D (FractionRing D) L], Module.Finite (FractionRing D) L → Module.Finite D (integralClosure D L)) → ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra A B], Algebra.FiniteType A B → Module.Finite B (integralClosure B (FractionRing B)) :=
by
  intro A _ _ H B _ _ _ hB
  have hA : wcpaDjNccNag A := ⟨inferInstance, fun D _ _ _ hD => H D hD⟩
  have htrans : ∀ (A₁ A₂ : Type u) [CommRing A₁] [CommRing A₂], (A₁ ≃+* A₂) →
      wcpaDjNccNag A₁ → wcpaDjNccNag A₂ := by
    intro A₁ A₂ _ _ e h
    refine ⟨?_, ?_⟩
    · haveI := h.1
      exact isNoetherianRing_of_ringEquiv A₁ e
    · intro D _ _ _ hD
      letI : Algebra A₁ D := ((algebraMap A₂ D).comp e.toRingHom).toAlgebra
      exact h.2 D (hD.comp e.surjective)
  have hpoly : ∀ n : ℕ, wcpaDjNccNag (MvPolynomial (Fin n) A) := by
    intro n
    induction n with
    | zero =>
      exact htrans A _ (MvPolynomial.isEmptyAlgEquiv A (Fin 0)).symm.toRingEquiv hA
    | succ n ih =>
      exact htrans _ _ (MvPolynomial.finSuccEquiv A n).symm.toRingEquiv
        (wcpa_dj_ncc_nag_monogenic wcpa_dj_ncc_nag_fin wcpa_dj_ncc_nag_poly
          wcpa_dj_ncc_nag_star _ ih)
  obtain ⟨n, f, hf⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hB
  letI : Algebra (MvPolynomial (Fin n) A) B := f.toRingHom.toAlgebra
  have h2 : wcpaDjNccN2 B := (hpoly n).2 B hf
  exact h2 (FractionRing B) (Module.Finite.self _)

theorem fgm_image_closure_finite : ∀ (A : Type u) [CommRing A], (∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra A B], Algebra.FiniteType A B → Module.Finite B (integralClosure B (FractionRing B))) → ∀ (B : Type u) [CommRing B] [Algebra A B], Algebra.FiniteType A B → ∀ (S : Type u) [CommRing S] [Algebra B S], IsField S → (∀ x : S, ∃ a b : B, algebraMap B S b ≠ 0 ∧ x * algebraMap B S b = algebraMap B S a) → Module.Finite B (integralClosure B S) :=
by
  intro A _ hN B _ _ hB S _ _ hS hfrac
  classical
  letI : IsDomain S := hS.isDomain
  let B' := ↥(algebraMap B S).range
  letI : Algebra B B' := (algebraMap B S).rangeRestrict.toAlgebra
  haveI : IsScalarTower B B' S := IsScalarTower.of_algebraMap_eq (fun x => rfl)
  have hsurj : Function.Surjective (algebraMap B B') := (algebraMap B S).rangeRestrict_surjective
  letI : Algebra A B' := ((algebraMap B B').comp (algebraMap A B)).toAlgebra
  let f : B →ₐ[A] B' := { (algebraMap B B') with commutes' := fun a => rfl }
  have hB' : Algebra.FiniteType A B' := Algebra.FiniteType.of_surjective f hsurj
  have hN1 := hN B' hB'
  haveI hfr : IsFractionRing B' S := by
    rw [IsFractionRing, isLocalization_iff]
    refine ⟨?_, ?_, ?_⟩
    · intro y
      have hy : (y : B') ≠ 0 := nonZeroDivisors.ne_zero y.2
      have hy' : algebraMap B' S y ≠ 0 := by
        intro h; apply hy; exact Subtype.ext h
      obtain ⟨w, hw⟩ := hS.mul_inv_cancel hy'
      exact IsUnit.of_mul_eq_one w hw
    · intro z
      obtain ⟨a, b, hb, hab⟩ := hfrac z
      have hb' : (algebraMap B S).rangeRestrict b ≠ 0 := by
        intro h; apply hb; exact congrArg Subtype.val h
      exact ⟨⟨(algebraMap B S).rangeRestrict a,
        ⟨(algebraMap B S).rangeRestrict b, mem_nonZeroDivisors_of_ne_zero hb'⟩⟩, hab⟩
    · intro x y h
      exact ⟨1, by rw [Subtype.ext h]⟩
  have hfin' : Module.Finite B' (integralClosure B' S) := by
    let e := IsLocalization.algEquiv (nonZeroDivisors B') (FractionRing B') S
    exact Module.Finite.equiv (e.mapIntegralClosure).toLinearEquiv
  haveI : Module.Finite B B' := Module.Finite.of_surjective (Algebra.linearMap B B') hsurj
  haveI : Algebra.IsIntegral B B' := Algebra.IsIntegral.of_finite B B'
  haveI : Module.Finite B (integralClosure B' S) := Module.Finite.trans B' (integralClosure B' S)
  let g : integralClosure B' S →ₗ[B] integralClosure B S :=
    { toFun := fun t => ⟨t.1, isIntegral_trans (R := B) (A := B') t.1 t.2⟩
      map_add' := fun s t => rfl
      map_smul' := fun b t => rfl }
  refine Module.Finite.of_surjective g ?_
  intro t
  exact ⟨⟨t.1, IsIntegral.tower_top t.2⟩, rfl⟩

theorem fex_graph_model : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
    IsAdicComplete (IsLocalRing.maximalIdeal A) A → ringKrullDim A = 2 →
    ∀ (X Y : Scheme.{u}) (fX : X ⟶ Spec (.of A)) (fY : Y ⟶ Spec (.of A)), IsProper fX → IsProper fY →
      AlgebraicGeometry.IsIntegral X → AlgebraicGeometry.IsIntegral Y →
      (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
      (∀ y : Y, IsIntegrallyClosed (Y.presheaf.stalk y)) →
      (∃ U : (Spec (.of A)).Opens, U ≠ ⊥ ∧ IsIso (fX ∣_ U)) →
      (∃ U₀ : (Spec (.of A)).Opens, (∀ p, p ∈ U₀ ↔ p ≠ IsLocalRing.closedPoint A) ∧
        IsIso (fY ∣_ U₀)) →
      ∃ (Z : Scheme.{u}) (g : Z ⟶ X) (h : Z ⟶ Y), AlgebraicGeometry.IsIntegral Z ∧
        (∀ z : Z, IsIntegrallyClosed (Z.presheaf.stalk z)) ∧ IsProper g ∧ IsProper h ∧
        (∃ V : X.Opens, V ≠ ⊥ ∧ IsIso (g ∣_ V)) ∧ (∃ V' : Y.Opens, V' ≠ ⊥ ∧ IsIso (h ∣_ V')) :=
by
  intro A _ _ _ hAc hdim X Y fX fY hfX hfY hX hY hXn hYn hUex hU₀ex
  obtain ⟨U, hU, hUiso⟩ := hUex
  obtain ⟨U₀, hU₀, hU₀iso⟩ := hU₀ex
  classical

  have s1 : ∀ {X S : Scheme.{u}} (f : X ⟶ S) (U U' : S.Opens), U' ≤ U → IsIso (f ∣_ U) →
      IsIso (f ∣_ U') := by
    intro X S f U U' hle hiso
    have h1 : IsIso ((f ∣_ U) ∣_ (U.ι ⁻¹ᵁ U')) :=
      IsZariskiLocalAtTarget.restrict (P := MorphismProperty.isomorphisms Scheme) hiso _
    have heq : U.ι ''ᵁ (U.ι ⁻¹ᵁ U') = U' := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hle
    exact (MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
      (morphismRestrictRestrict f U (U.ι ⁻¹ᵁ U') ≪≫ morphismRestrictEq f heq)).mp h1

  have s2 : ∀ {P X Y S : Scheme.{u}} (a : P ⟶ X) (b : P ⟶ Y) (fX : X ⟶ S) (fY : Y ⟶ S)
      (U' : S.Opens), IsPullback a b fX fY → IsIso (fY ∣_ U') → IsIso (a ∣_ (fX ⁻¹ᵁ U')) := by
    intro P X Y S a b fX fY U' hpb hiso
    haveI := hiso
    have hbig := (isPullback_morphismRestrict a (fX ⁻¹ᵁ U')).paste_vert hpb
    have hrange : Set.range ⇑((a ⁻¹ᵁ (fX ⁻¹ᵁ U')).ι ≫ b) ⊆ Set.range ⇑(fY ⁻¹ᵁ U').ι := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι]
      have e : ((a ⁻¹ᵁ (fX ⁻¹ᵁ U')).ι ≫ b ≫ fY) x = ((a ⁻¹ᵁ (fX ⁻¹ᵁ U')).ι ≫ a ≫ fX) x := by
        rw [hpb.w]
      have hx : fX (a x.1) ∈ U' := x.2
      show fY (((a ⁻¹ᵁ (fX ⁻¹ᵁ U')).ι ≫ b) x) ∈ U'
      rw [← Scheme.Hom.comp_apply, Category.assoc, e, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact hx
    obtain ⟨k, hk⟩ : ∃ k : (a ⁻¹ᵁ (fX ⁻¹ᵁ U')).toScheme ⟶ (fY ⁻¹ᵁ U').toScheme,
        k ≫ (fY ⁻¹ᵁ U').ι = (a ⁻¹ᵁ (fX ⁻¹ᵁ U')).ι ≫ b :=
      ⟨IsOpenImmersion.lift _ _ hrange, IsOpenImmersion.lift_fac _ _ _⟩
    have hbig' : IsPullback (k ≫ (fY ⁻¹ᵁ U').ι) (a ∣_ (fX ⁻¹ᵁ U')) fY ((fX ∣_ U') ≫ U'.ι) := by
      rw [hk, morphismRestrict_ι]; exact hbig.flip
    have hcomm : k ≫ (fY ∣_ U') = (a ∣_ (fX ⁻¹ᵁ U')) ≫ (fX ∣_ U') := by
      rw [← cancel_mono U'.ι]
      have h1 : (k ≫ fY ∣_ U') ≫ U'.ι = (a ⁻¹ᵁ (fX ⁻¹ᵁ U')).ι ≫ b ≫ fY := by
        rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, hk, Category.assoc]
      have h2 : ((a ∣_ (fX ⁻¹ᵁ U')) ≫ fX ∣_ U') ≫ U'.ι = (a ⁻¹ᵁ (fX ⁻¹ᵁ U')).ι ≫ a ≫ fX := by
        rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, morphismRestrict_ι,
          Category.assoc]
      rw [h1, h2, hpb.w]
    have hsq := IsPullback.of_right hbig' hcomm (isPullback_morphismRestrict fY U').flip
    exact hsq.flip.isIso_fst_of_isIso

  obtain ⟨U', hU'def⟩ : ∃ U' : (Spec (.of A)).Opens, U' = U ⊓ U₀ := ⟨_, rfl⟩
  have hU'ne : U' ≠ ⊥ := by
    have hex : ∃ p : Spec (.of A), p ≠ IsLocalRing.closedPoint A := by
      by_contra hcon
      push_neg at hcon
      haveI : Unique (PrimeSpectrum A) := ⟨⟨IsLocalRing.closedPoint A⟩, fun p => hcon p⟩
      have h0 : ringKrullDim A = 0 := Order.krullDim_eq_zero_of_unique
      rw [h0] at hdim
      norm_num at hdim
    obtain ⟨p, hp⟩ := hex
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty, hU'def]
    by_cases hc : IsLocalRing.closedPoint A ∈ U
    · refine ⟨p, ?_, (hU₀ p).mpr hp⟩
      exact (IsLocalRing.specializes_closedPoint p).mem_open U.isOpen hc
    · obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
      refine ⟨x, hx, (hU₀ x).mpr ?_⟩
      rintro rfl
      exact hc hx
  have hfXU' : IsIso (fX ∣_ U') := s1 fX U U' (by rw [hU'def]; exact inf_le_left) hUiso
  have hfYU' : IsIso (fY ∣_ U') := s1 fY U₀ U' (by rw [hU'def]; exact inf_le_right) hU₀iso
  haveI := hfXU'
  haveI := hfYU'
  have he₁ : IsIso (Limits.pullback.fst fX fY ∣_ (fX ⁻¹ᵁ U')) :=
    s2 _ _ fX fY U' (IsPullback.of_hasPullback fX fY) hfYU'
  have he₂ : IsIso (Limits.pullback.snd fX fY ∣_ (fY ⁻¹ᵁ U')) :=
    s2 _ _ fY fX U' (IsPullback.of_hasPullback fX fY).flip hfXU'
  haveI := he₁
  haveI := he₂

  obtain ⟨O, hOdef⟩ : ∃ O : (Limits.pullback fX fY).Opens,
      O = Limits.pullback.fst fX fY ⁻¹ᵁ (fX ⁻¹ᵁ U') := ⟨_, rfl⟩
  have hO' : Limits.pullback.snd fX fY ⁻¹ᵁ (fY ⁻¹ᵁ U') = O := by
    rw [hOdef]
    ext x
    show fY (Limits.pullback.snd fX fY x) ∈ U' ↔ fX (Limits.pullback.fst fX fY x) ∈ U'
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U').mp hU'ne
  obtain ⟨v, -⟩ := (fX ∣_ U').surjective ⟨u, hu⟩
  obtain ⟨v', -⟩ := (fY ∣_ U').surjective ⟨u, hu⟩
  have hV : fX ⁻¹ᵁ U' ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨v.1, v.2⟩
  have hV' : fY ⁻¹ᵁ U' ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨v'.1, v'.2⟩
  have hOne : Nonempty O.toScheme := by
    obtain ⟨o, -⟩ := (Limits.pullback.fst fX fY ∣_ (fX ⁻¹ᵁ U')).surjective v
    rw [hOdef]; exact ⟨o⟩
  have hOint : AlgebraicGeometry.IsIntegral O.toScheme := by
    subst hOdef
    exact isIntegral_of_isOpenImmersion
      ((Limits.pullback.fst fX fY ∣_ (fX ⁻¹ᵁ U')) ≫ (fX ⁻¹ᵁ U').ι)
  have hOn : ∀ o : O.toScheme, IsIntegrallyClosed (O.toScheme.presheaf.stalk o) := by
    subst hOdef
    intro o
    haveI := hXn (((Limits.pullback.fst fX fY ∣_ (fX ⁻¹ᵁ U')) ≫ (fX ⁻¹ᵁ U').ι) o)
    exact IsIntegrallyClosed.of_equiv (asIso (Scheme.Hom.stalkMap
      ((Limits.pullback.fst fX fY ∣_ (fX ⁻¹ᵁ U')) ≫ (fX ⁻¹ᵁ U').ι) o)).commRingCatIsoToRingEquiv
  haveI := hOint
  have hOsec := wc_fsus_affine_sections_intclosed O.toScheme hOn

  haveI := quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst fX fY ≫ fX)
  haveI hqc : QuasiCompact (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) :=
    quasiCompact_of_compactSpace _
  haveI hqs : QuasiSeparated (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) := by
    haveI : IsAffineHom ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ≫
        Limits.pullback.fst fX fY ≫ fX) := isAffineHom_of_isAffine _
    haveI : IsSeparated ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) ≫
        Limits.pullback.fst fX fY ≫ fX) := IsSeparated.of_isAffineHom _
    exact QuasiSeparated.of_comp _ (Limits.pullback.fst fX fY ≫ fX)
  have hRatio := fgm_generic_ratio (Limits.pullback fX fY) O

  have hN : ∀ (B : Type u) [CommRing B] [IsDomain B] [Algebra A B], Algebra.FiniteType A B →
      Module.Finite B (integralClosure B (FractionRing B)) :=
    fun B _ _ _ hB => fgm_nagata_ascent A (fgm_complete_local_nagata A hAc) B hB
  have hAlg := fgm_image_closure_finite A hN
  have hloc := @fgm_norm_local_finite A _ hAlg (Limits.pullback fX fY)
    (Limits.pullback.fst fX fY ≫ fX) inferInstance O.toScheme.functionField _
    (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) hRatio
  haveI hfin : IsFinite (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).fromNormalization :=
    wc_fnf_fromNormalization_finite_of_local _ hloc
  have hπO := fgm_norm_iso_normal_open (Limits.pullback fX fY) O hOsec hRatio
  refine ⟨(O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).normalization,
    (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).fromNormalization ≫
      Limits.pullback.fst fX fY,
    (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).fromNormalization ≫
      Limits.pullback.snd fX fY,
    inferInstance,
    @fgm_norm_field_stalk_normal (Limits.pullback fX fY) O.toScheme.functionField _
      (O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι) hqc hqs,
    inferInstance, inferInstance, ⟨fX ⁻¹ᵁ U', hV, ?_⟩, ⟨fY ⁻¹ᵁ U', hV', ?_⟩⟩
  · rw [morphismRestrict_comp]
    have h1 : IsIso ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).fromNormalization ∣_
        (Limits.pullback.fst fX fY ⁻¹ᵁ (fX ⁻¹ᵁ U'))) := by
      rw [← hOdef]; exact hπO
    refine @IsIso.comp_isIso _ _ _ _ _ _ _ ?_ ?_
    · exact h1
    · exact he₁
  · rw [morphismRestrict_comp]
    have h1 : IsIso ((O.toScheme.fromSpecStalk (genericPoint O.toScheme) ≫ O.ι).fromNormalization ∣_
        (Limits.pullback.snd fX fY ⁻¹ᵁ (fY ⁻¹ᵁ U'))) := by
      rw [hO']; exact hπO
    refine @IsIso.comp_isIso _ _ _ _ _ _ _ ?_ ?_
    · exact h1
    · exact he₂

theorem fex_local_base_change : ∀ (Y Z : Scheme.{u}) (h : Z ⟶ Y), IsProper h →
    AlgebraicGeometry.IsIntegral Y → AlgebraicGeometry.IsIntegral Z →
    (∀ z : Z, IsIntegrallyClosed (Z.presheaf.stalk z)) → (∃ V : Y.Opens, V ≠ ⊥ ∧ IsIso (h ∣_ V)) →
    ∀ y : Y, AlgebraicGeometry.IsIntegral (Limits.pullback h (Y.fromSpecStalk y)) ∧
      (∀ p : ↥(Limits.pullback h (Y.fromSpecStalk y)),
        IsIntegrallyClosed ((Limits.pullback h (Y.fromSpecStalk y)).presheaf.stalk p)) ∧
      ∃ U : (Spec (Y.presheaf.stalk y)).Opens, U ≠ ⊥ ∧
        IsIso (Limits.pullback.snd h (Y.fromSpecStalk y) ∣_ U) :=
by

  have s1 : ∀ (X : Scheme.{u}) (x : X), Flat (X.fromSpecStalk x) := by
    intro X x
    obtain ⟨U, hU, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X)) (show x ∈ (⊤ : X.Opens) from trivial)
    have hEq : X.fromSpecStalk x = Spec.map (X.presheaf.germ U x hxU) ≫ hU.fromSpec := by
      rw [← IsAffineOpen.fromSpecStalk_eq_fromSpecStalk hU hxU]
      rfl
    rw [hEq]
    have hfl : Flat (Spec.map (X.presheaf.germ U x hxU)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      letI := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxU⟩
      haveI := hU.isLocalization_stalk ⟨x, hxU⟩
      have hM : Module.Flat Γ(X, U) (X.presheaf.stalk x) :=
        IsLocalization.flat _ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl
      have := RingHom.flat_algebraMap_iff.mpr hM
      exact this
    have hfs : Flat hU.fromSpec := by
      haveI := hU.isOpenImmersion_fromSpec
      infer_instance
    exact MorphismProperty.comp_mem @Flat _ _ hfl hfs

  have s2 : ∀ (X W : Scheme.{u}) (f : X ⟶ W), Flat f → SurjectiveOnStalks f → ∀ x : X,
      Function.Bijective (f.stalkMap x).hom := by
    intro X W f hf hs x
    refine ⟨?_, SurjectiveOnStalks.stalkMap_surjective f x⟩
    letI := (f.stalkMap x).hom.toAlgebra
    haveI : Module.Flat (W.presheaf.stalk (f x)) (X.presheaf.stalk x) := Flat.stalkMap f x
    haveI : IsLocalHom (algebraMap (W.presheaf.stalk (f x)) (X.presheaf.stalk x)) :=
      inferInstanceAs (IsLocalHom (f.stalkMap x).hom)
    haveI : Module.FaithfullyFlat (W.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    exact FaithfulSMul.algebraMap_injective (W.presheaf.stalk (f x)) (X.presheaf.stalk x)

  have s3 : ∀ (W Y Z : Scheme.{u}) (h : Z ⟶ Y) (g : W ⟶ Y) (V : Y.Opens), IsIso (h ∣_ V) →
      IsIso (Limits.pullback.snd h g ∣_ (g ⁻¹ᵁ V)) := by
    intro W Y Z h g V hV
    have ha : IsPullback (Limits.pullback.snd h g ⁻¹ᵁ (g ⁻¹ᵁ V)).ι
        (Limits.pullback.snd h g ∣_ (g ⁻¹ᵁ V)) (Limits.pullback.snd h g) (g ⁻¹ᵁ V).ι :=
      (isPullback_morphismRestrict (Limits.pullback.snd h g) (g ⁻¹ᵁ V)).flip
    have hb : IsPullback (Limits.pullback.fst h g) (Limits.pullback.snd h g) h g :=
      IsPullback.of_hasPullback h g
    have hc := ha.paste_horiz hb
    have hd : IsPullback (h ⁻¹ᵁ V).ι (h ∣_ V) h V.ι := (isPullback_morphismRestrict h V).flip
    have hgV : (g ⁻¹ᵁ V).ι ≫ g = g ∣_ V ≫ V.ι := (morphismRestrict_ι g V).symm
    have w : ((Limits.pullback.snd h g ⁻¹ᵁ (g ⁻¹ᵁ V)).ι ≫ Limits.pullback.fst h g) ≫ h =
        (Limits.pullback.snd h g ∣_ (g ⁻¹ᵁ V) ≫ g ∣_ V) ≫ V.ι := by
      rw [hc.w, Category.assoc, hgV]
    let a := hd.lift _ _ w
    have ha1 : a ≫ (h ⁻¹ᵁ V).ι =
        (Limits.pullback.snd h g ⁻¹ᵁ (g ⁻¹ᵁ V)).ι ≫ Limits.pullback.fst h g := hd.lift_fst _ _ w
    have ha2 : a ≫ h ∣_ V = Limits.pullback.snd h g ∣_ (g ⁻¹ᵁ V) ≫ g ∣_ V := hd.lift_snd _ _ w
    rw [← ha1, hgV] at hc
    have hl := IsPullback.of_right hc ha2 hd
    exact hl.flip.isIso_fst_of_isIso
  intro Y Z h _ hY hZ hnorm ⟨V, hV0, hVi⟩ y
  haveI := hY
  haveI := hZ
  haveI : Flat (Y.fromSpecStalk y) := s1 Y y
  have hbij : ∀ p : ↥(Limits.pullback h (Y.fromSpecStalk y)),
      Function.Bijective ((Limits.pullback.fst h (Y.fromSpecStalk y)).stalkMap p).hom :=
    s2 _ _ _ inferInstance inferInstance

  have hsurjV : ∀ v ∈ V, ∃ z : Z, z ∈ h ⁻¹ᵁ V ∧ h z = v := by
    intro v hv
    obtain ⟨w, hw⟩ := (h ∣_ V).surjective ⟨v, hv⟩
    refine ⟨(h ⁻¹ᵁ V).ι w, ?_, ?_⟩
    · have hm : (h ⁻¹ᵁ V).ι w ∈ ((h ⁻¹ᵁ V : Z.Opens) : Set Z) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨w, rfl⟩
      exact hm
    · have e := congrArg (fun φ : (h ⁻¹ᵁ V : Scheme) ⟶ Y => φ w) (morphismRestrict_ι h V)
      simp only [Scheme.Hom.comp_apply] at e
      rw [← e, hw]
      simp

  have hξ : ∀ z : Z, genericPoint Z ⤳ z := fun z => genericPoint_specializes z
  have hη : ∀ y' : Y, genericPoint Y ⤳ y' := fun z => genericPoint_specializes z
  obtain ⟨v, hv⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV0
  obtain ⟨z₀, hz₀, -⟩ := hsurjV v hv
  have hξV : h (genericPoint Z) ∈ V := by
    have : genericPoint Z ∈ h ⁻¹ᵁ V :=
      ((genericPoint_spec Z).mem_open_set_iff (h ⁻¹ᵁ V).isOpen).mpr ⟨z₀, trivial, hz₀⟩
    exact this
  have hηV : genericPoint Y ∈ V :=
    ((genericPoint_spec Y).mem_open_set_iff V.isOpen).mpr ⟨v, trivial, hv⟩
  obtain ⟨w', -, hw'⟩ := hsurjV _ hηV
  have hξy : ∀ y' : Y, h (genericPoint Z) ⤳ y' := by
    intro y'
    have h1 : h (genericPoint Z) ⤳ h w' := (hξ w').map h.continuous
    rw [hw'] at h1
    exact h1.trans (hη y')
  have hrg : h (genericPoint Z) ∈ Set.range (Y.fromSpecStalk y) := by
    rw [Scheme.range_fromSpecStalk]
    exact hξy y

  haveI hirr : IrreducibleSpace ↥(Limits.pullback h (Y.fromSpecStalk y)) := by
    have hr : genericPoint Z ∈ Set.range (Limits.pullback.fst h (Y.fromSpecStalk y)) := by
      rw [Scheme.Pullback.range_fst]
      exact hrg
    obtain ⟨ξ', hξ'⟩ := hr
    have hall : ∀ p, ξ' ⤳ p := fun p =>
      ((Limits.pullback.fst h (Y.fromSpecStalk y)).isEmbedding.isInducing.specializes_iff).mp
        (by rw [hξ']; exact hξ _)
    have hcl : closure ({ξ'} : Set ↥(Limits.pullback h (Y.fromSpecStalk y))) = Set.univ :=
      Set.eq_univ_of_forall (fun p => specializes_iff_mem_closure.mp (hall p))
    rw [irreducibleSpace_def]
    have := (isIrreducible_singleton (x := ξ')).closure
    rw [hcl] at this
    exact this

  haveI hred : IsReduced (Limits.pullback h (Y.fromSpecStalk y)) := by
    have : ∀ p : ↥(Limits.pullback h (Y.fromSpecStalk y)),
        _root_.IsReduced ((Limits.pullback h (Y.fromSpecStalk y)).presheaf.stalk p) := fun p =>
      isReduced_of_injective (RingEquiv.ofBijective _ (hbij p)).symm.toMonoidWithZeroHom
        (RingEquiv.injective _)
    exact isReduced_of_isReduced_stalk _
  refine ⟨isIntegral_of_irreducibleSpace_of_isReduced _, ?_, ?_⟩
  · intro p
    haveI := hnorm ((Limits.pullback.fst h (Y.fromSpecStalk y)) p)
    exact IsIntegrallyClosed.of_equiv (RingEquiv.ofBijective _ (hbij p))
  · obtain ⟨s, hs⟩ := hrg
    refine ⟨Y.fromSpecStalk y ⁻¹ᵁ V, ?_, s3 _ _ _ h _ V hVi⟩
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    refine ⟨s, ?_⟩
    show Y.fromSpecStalk y s ∈ V
    rw [hs]
    exact hξV

theorem fex_h1_low_dim : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B],
    IsRegularLocalRing B → ringKrullDim B ≤ 1 →
    ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of B)), IsProper f → AlgebraicGeometry.IsIntegral X →
      (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
      (∃ U : (Spec (.of B)).Opens, U ≠ ⊥ ∧ IsIso (f ∣_ U)) → wcpaDjFexH1 X :=
by
  intro B _ _ _ hreg hdim X f hf hX _hnorm hU
  classical
  obtain ⟨U, hU0, hUiso⟩ := hU
  haveI := hf
  haveI := hX
  haveI := hUiso
  haveI := hreg
  haveI : IsDomain B := (wc_fco_regular_local_ufd B).1

  haveI hval : ValuationRing B := by
    have hfield : IsField B → ValuationRing B := by
      intro hF
      rw [ValuationRing.iff_dvd_total]
      refine ⟨fun a b => ?_⟩
      by_cases ha : a = 0
      · right; rw [ha]; exact dvd_zero b
      · left
        obtain ⟨c, hc⟩ := hF.mul_inv_cancel ha
        exact ⟨c * b, by rw [← mul_assoc, hc, one_mul]⟩
    have h1 : (Submodule.spanFinrank (IsLocalRing.maximalIdeal B) : WithBot ℕ∞) ≤ 1 := by
      rw [hreg.spanFinrank_maximalIdeal]; exact hdim
    have h2 : Submodule.spanFinrank (IsLocalRing.maximalIdeal B) ≤ 1 := by exact_mod_cast h1
    obtain ⟨s, hs, hspan⟩ :=
      (IsNoetherian.noetherian (IsLocalRing.maximalIdeal B)).exists_span_set_encard_eq_spanFinrank
    have h3 : s.encard ≤ 1 := by rw [hs]; exact_mod_cast h2
    rcases Set.encard_le_one_iff_eq.mp h3 with h | ⟨x, hx⟩
    · apply hfield
      rw [IsLocalRing.isField_iff_maximalIdeal_eq, ← hspan, h, Submodule.span_empty]
    · by_cases hF : IsField B
      · exact hfield hF
      · have hp : Submodule.IsPrincipal (IsLocalRing.maximalIdeal B) := ⟨⟨x, by rw [← hspan, hx]⟩⟩
        exact ((IsDiscreteValuationRing.TFAE B hF).out 5 2).mp hp

  have hrange : Set.range (Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B)))) ⊆
      Set.range U.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨p, rfl⟩
    obtain ⟨q, hq⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU0
    have h1 : (Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B))) p).asIdeal = ⊥ := by
      have hp0 : (p : PrimeSpectrum (FractionRing B)).asIdeal = ⊥ := by
        haveI := (p : PrimeSpectrum (FractionRing B)).isPrime
        exact Ideal.eq_bot_of_prime _
      rw [Spec.map_apply]
      change Ideal.comap (algebraMap B (FractionRing B))
        (p : PrimeSpectrum (FractionRing B)).asIdeal = ⊥
      rw [hp0]
      exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective B (FractionRing B))
    have hsp : Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B))) p ⤳ q := by
      have hle : (Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B))) p).asIdeal ≤
          (q : PrimeSpectrum B).asIdeal := by
        rw [h1]
        exact bot_le
      exact (PrimeSpectrum.le_iff_specializes (R := B) _ _).mp hle
    exact hsp.mem_open U.isOpen hq
  obtain ⟨j, hj⟩ : ∃ j : Spec (.of (FractionRing B)) ⟶ U.toScheme,
      j ≫ U.ι = Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B))) :=
    ⟨IsOpenImmersion.lift U.ι _ hrange, IsOpenImmersion.lift_fac _ _ _⟩
  haveI hKdom : IsDominant (Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B)))) := by
    apply isDominant_of_of_appTop_injective
    have e := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap B (FractionRing B)))
    intro x y hxy
    have h3 : ((Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B)))).appTop ≫
        (Scheme.ΓSpecIso (CommRingCat.of (FractionRing B))).hom).hom x =
        ((Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B)))).appTop ≫
        (Scheme.ΓSpecIso (CommRingCat.of (FractionRing B))).hom).hom y := by
      rw [CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply]
      exact congrArg _ hxy
    rw [e, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply,
      CommRingCat.hom_ofHom] at h3
    have h4 := IsFractionRing.injective B (FractionRing B) h3
    exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of B)).hom).1 h4
  haveI : IsDominant (j ≫ U.ι) := by rw [hj]; exact hKdom
  haveI hjdom : IsDominant j := IsDominant.of_comp_of_isOpenImmersion j U.ι

  obtain ⟨i₁, hi₁def⟩ : ∃ i : Spec (.of (FractionRing B)) ⟶ X,
      i = j ≫ inv (f ∣_ U) ≫ (f ⁻¹ᵁ U).ι := ⟨_, rfl⟩
  have hi₁ : i₁ ≫ f = Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B))) ≫ 𝟙 _ := by
    rw [hi₁def, Category.assoc, Category.assoc, ← morphismRestrict_ι, IsIso.inv_hom_id_assoc, hj,
      Category.comp_id]
  have hex : ValuativeCriterion.Existence f := by
    have h : UniversallyClosed f := inferInstance
    rw [UniversallyClosed.eq_valuativeCriterion] at h
    exact h.1
  let S : ValuativeCommSq f := ValuativeCommSq.mk B (FractionRing B) i₁ (𝟙 _) ⟨hi₁⟩
  haveI := hex S
  obtain ⟨⟨σ, hl, hr⟩⟩ := (CommSq.HasLift.exists_lift : Nonempty S.commSq.LiftStruct)
  have hl' : Spec.map (CommRingCat.ofHom (algebraMap B (FractionRing B))) ≫ σ = i₁ := hl
  have hr' : σ ≫ f = 𝟙 _ := hr
  have h3 : U.ι ≫ σ = inv (f ∣_ U) ≫ (f ⁻¹ᵁ U).ι := by
    refine ext_of_isDominant_of_isSeparated f ?_ j ?_
    · rw [Category.assoc, hr', Category.comp_id, Category.assoc, ← morphismRestrict_ι,
        IsIso.inv_hom_id_assoc]
    · rw [← Category.assoc, hj, hl', hi₁def]
  have hne : Nonempty (f ⁻¹ᵁ U).toScheme := by
    obtain ⟨p⟩ : Nonempty (PrimeSpectrum (FractionRing B)) := inferInstance
    exact ⟨inv (f ∣_ U) (j p)⟩
  obtain ⟨x0⟩ := hne
  haveI : IsDominant (f ⁻¹ᵁ U).ι := by
    rw [isDominant_iff, DenseRange, Scheme.Opens.range_ι]
    exact (f ⁻¹ᵁ U).isOpen.dense ⟨(f ⁻¹ᵁ U).ι x0, by
      rw [← Scheme.Opens.range_ι]; exact ⟨x0, rfl⟩⟩
  have h5 : f ≫ σ = 𝟙 X := by
    refine ext_of_isDominant_of_isSeparated f ?_ (f ⁻¹ᵁ U).ι ?_
    · rw [Category.assoc, hr', Category.comp_id, Category.id_comp]
    · rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc, h3, IsIso.hom_inv_id_assoc,
        Category.comp_id]
  haveI : IsIso f := ⟨⟨σ, h5, hr'⟩⟩
  haveI : IsAffine X := IsAffine.of_isIso f
  exact fexr_affine_h1 X inferInstance

theorem fex_leray_local_affine : ∀ (Z Y : Scheme.{u}) (h : Z ⟶ Y), QuasiCompact h → IsSeparated h →
    ∀ V : Y.Opens, IsAffineOpen V →
    (∀ y : Y, y ∈ V → wcpaDjFexH1 (Limits.pullback h (Y.fromSpecStalk y))) →
    wcpaDjFexH1 (h ⁻¹ᵁ V).toScheme :=
by
  classical



  have s1 : ∀ (X : Scheme.{u}) (L : wcpaDjCoc X), wcpaDjCocOK L →
      (∀ c : wcCbcmC L ⊤ 1, wcCbcmD L ⊤ 0 1 c = 0 → ∃ x : wcCbcmC L ⊤ 0, c = wcCbcmD L ⊤ 0 0 x) →
      wcpaDjTwH1 L ⊤ (wcStructMod X) 0 := by
    intro X L _hL hcx c hc
    have rr : ∀ {U V W : X.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(X, U)),
        (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
      intro U V W h1 h2 x
      show (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
      rw [← CategoryTheory.Functor.map_comp]
      rfl
    have rid : ∀ {U : X.Opens} (h : U ≤ U) (x : Γ(X, U)),
        (X.presheaf.map (homOfLE h).op).hom x = x := by
      intro U h x
      show (X.presheaf.map (𝟙 _)).hom x = x
      rw [CategoryTheory.Functor.map_id]
      rfl
    have hcX : ∀ a b d : Fin L.m,
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V d ⊓ ⊤ from
          inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_left))).op).hom (c a d) =
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d ⊓ ⊤ from
          inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_right))).op).hom (c b d) +
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c a b) := by
      intro a b d
      have e := hc a b d
      rw [pow_zero, one_smul] at e
      exact e
    suffices core : ∀ c : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b ⊓ ⊤), (∀ a b d : Fin L.m,
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V d ⊓ ⊤ from
          inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_left))).op).hom (c a d) =
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d ⊓ ⊤ from
          inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_right))).op).hom (c b d) +
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c a b)) →
        ∃ β : ∀ a : Fin L.m, Γ(X, L.V a ⊓ ⊤), ∀ a b : Fin L.m, c a b =
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β b) -
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β a) by
      obtain ⟨β, hβ⟩ := core c hcX
      refine ⟨β, fun a b => ?_⟩
      rw [pow_zero, one_smul]
      exact hβ a b
    clear hcX hc
    intro c hcX
    obtain ⟨CW, hCW⟩ : ∃ CW : ∀ W : X.Opens, Fin L.m → Fin L.m → Γ(X, W),
        ∀ W a b (hW : W ≤ L.V a ⊓ L.V b ⊓ ⊤),
          (X.presheaf.map (homOfLE hW).op).hom (c a b) = CW W a b :=
      ⟨fun W a b => if hW : W ≤ L.V a ⊓ L.V b ⊓ ⊤ then
          (X.presheaf.map (homOfLE hW).op).hom (c a b) else 0,
        fun W a b hW => by simp only [dif_pos hW]⟩
    have K1 : ∀ (W : X.Opens) (a b d : Fin L.m), W ≤ L.V a → W ≤ L.V b → W ≤ L.V d →
        CW W a d = CW W b d + CW W a b := by
      intro W a b d ha hb hd
      have hW : W ≤ L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ := le_inf (le_inf (le_inf ha hb) hd) le_top
      have e := congrArg (X.presheaf.map (homOfLE hW).op).hom (hcX a b d)
      rw [map_add, rr, rr, rr] at e
      rw [← hCW W a d (le_inf (le_inf ha hd) le_top), ← hCW W b d (le_inf (le_inf hb hd) le_top),
        ← hCW W a b (le_inf (le_inf ha hb) le_top)]
      exact e
    have hVq : ∀ (q : Fin (1 + 1) ↪o Fin L.m), wcCbcmV L ⊤ q ≤ L.V (q 0) ⊓ L.V (q 1) ⊓ ⊤ :=
      fun q => le_inf (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1)))
        le_top
    obtain ⟨z, hzdef⟩ : ∃ z : wcCbcmC L ⊤ 1, ∀ q, z q = CW (wcCbcmV L ⊤ q) (q 0) (q 1) :=
      ⟨fun q => CW (wcCbcmV L ⊤ q) (q 0) (q 1), fun _ => rfl⟩
    have hz : ∀ (W : X.Opens) (q : Fin (1 + 1) ↪o Fin L.m) (hW : W ≤ wcCbcmV L ⊤ q),
        (X.presheaf.map (homOfLE hW).op).hom (z q) = CW W (q 0) (q 1) := by
      intro W q hW
      rw [hzdef, ← hCW _ _ _ (hVq q), rr, hCW]
    have hzc : wcCbcmD L ⊤ 0 1 z = 0 := by
      funext t
      have hWk : ∀ k, wcCbcmV L ⊤ t ≤ L.V (t k) := fun k => inf_le_left.trans (iInf_le _ k)
      have key := K1 (wcCbcmV L ⊤ t) (t 0) (t 1) (t 2) (hWk 0) (hWk 1) (hWk 2)
      have Fk : ∀ k : Fin (1 + 1),
          CW (wcCbcmV L ⊤ t) (((Fin.succAboveOrderEmb (Fin.castSucc k)).trans t) 0)
            (((Fin.succAboveOrderEmb (Fin.castSucc k)).trans t) 1) =
          ![CW (wcCbcmV L ⊤ t) (t 1) (t 2), CW (wcCbcmV L ⊤ t) (t 0) (t 2)] k := by
        intro k
        fin_cases k <;> rfl
      have Fl : CW (wcCbcmV L ⊤ t) (((Fin.succAboveOrderEmb (Fin.last (1 + 1))).trans t) 0)
          (((Fin.succAboveOrderEmb (Fin.last (1 + 1))).trans t) 1) =
          CW (wcCbcmV L ⊤ t) (t 0) (t 1) := rfl
      simp only [wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, hz, Fk, Fl, pow_zero, map_one,
        one_mul, Pi.zero_apply]
      simp [Fin.sum_univ_succ]
      linear_combination -key
    obtain ⟨x, hx⟩ := hcx z hzc
    obtain ⟨β, hβ⟩ : ∃ β : ∀ a : Fin L.m, Γ(X, L.V a ⊓ ⊤), ∀ a, β a =
        (X.presheaf.map (homOfLE (show L.V a ⊓ ⊤ ≤ wcCbcmV L ⊤ (wcCbcmSingle a) from
          le_inf (le_iInf fun _ => inf_le_left) inf_le_right)).op).hom (x (wcCbcmSingle a)) :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨BW, hBW⟩ : ∃ BW : ∀ W : X.Opens, Fin L.m → Γ(X, W), ∀ W a (hW : W ≤ L.V a ⊓ ⊤),
        (X.presheaf.map (homOfLE hW).op).hom (β a) = BW W a :=
      ⟨fun W a => if hW : W ≤ L.V a ⊓ ⊤ then (X.presheaf.map (homOfLE hW).op).hom (β a) else 0,
        fun W a hW => by simp only [dif_pos hW]⟩
    have ctr : ∀ (s s' : Fin (0 + 1) ↪o Fin L.m), s = s' → ∀ (W : X.Opens)
        (h : W ≤ wcCbcmV L ⊤ s) (h' : W ≤ wcCbcmV L ⊤ s'),
        (X.presheaf.map (homOfLE h).op).hom (x s) = (X.presheaf.map (homOfLE h').op).hom (x s') := by
      intro s s' hs W h h'
      subst hs
      rfl
    have hx1 : ∀ (W : X.Opens) (s : Fin (0 + 1) ↪o Fin L.m) (hW : W ≤ wcCbcmV L ⊤ s),
        (X.presheaf.map (homOfLE hW).op).hom (x s) = BW W (s 0) := by
      intro W s hW
      have hW' : W ≤ L.V (s 0) ⊓ ⊤ := le_inf (hW.trans (inf_le_left.trans (iInf_le _ 0))) le_top
      rw [← hBW W (s 0) hW', hβ, rr]
      exact ctr s (wcCbcmSingle (s 0)) (DFunLike.ext _ _ (fun i => by fin_cases i; rfl)) W hW _
    have hpr : ∀ a b : Fin L.m, a < b → StrictMono (![a, b] : Fin 2 → Fin L.m) := fun a b h =>
      Fin.strictMono_iff_lt_succ.mpr (fun i => by fin_cases i; exact h)
    have K2 : ∀ (a b : Fin L.m) (hab : a < b) (W : X.Opens), W ≤ L.V a → W ≤ L.V b →
        CW W a b = BW W b - BW W a := by
      intro a b hab W ha hb
      obtain ⟨q, hq⟩ : ∃ q : Fin (1 + 1) ↪o Fin L.m,
          q = OrderEmbedding.ofStrictMono _ (hpr a b hab) := ⟨_, rfl⟩
      have hWq : W ≤ wcCbcmV L ⊤ q :=
        le_inf (le_iInf fun k => by subst hq; fin_cases k; exacts [ha, hb]) le_top
      have e := congrArg (X.presheaf.map (homOfLE hWq).op).hom (congrFun hx q)
      have Q0 : q 0 = a := by subst hq; rfl
      have Q1 : q 1 = b := by subst hq; rfl
      have G0 : ∀ k : Fin (0 + 1), ((Fin.succAboveOrderEmb (Fin.castSucc k)).trans q) 0 = b := by
        intro k; fin_cases k; subst hq; rfl
      have G1 : ((Fin.succAboveOrderEmb (Fin.last (0 + 1))).trans q) 0 = a := by subst hq; rfl
      rw [hz W q hWq, Q0, Q1] at e
      simp only [wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, map_sum, map_add, map_mul, map_pow,
        map_neg, map_one, pow_zero, one_mul] at e
      simp only [rr] at e
      simp only [hx1, G0, G1] at e
      simp at e
      rw [e]
      ring
    refine ⟨β, fun a b => ?_⟩
    have ha : L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a := inf_le_left.trans inf_le_left
    have hb : L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b := inf_le_left.trans inf_le_right
    have fin : c a b =
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β b) -
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β a) := by
      have hcab : c a b = CW (L.V a ⊓ L.V b ⊓ ⊤) a b := by
        rw [← hCW _ a b le_rfl, rid]
      rw [hBW, hBW, hcab]
      rcases lt_trichotomy a b with hab | hab | hab
      · exact K2 a b hab _ ha hb
      · subst hab
        have e3 := K1 _ a a a ha ha ha
        linear_combination -e3
      · have e1 := K2 b a hab _ hb ha
        have e2 := K1 _ a b a ha hb ha
        have e3 := K1 _ a a a ha ha ha
        linear_combination -e1 - e2 - e3
    exact fin



  have s2 : ∀ (Z Y : Scheme.{u}) (h : Z ⟶ Y) (V : Y.Opens) (hV : IsAffineOpen V) (y : Y)
      (hy : y ∈ V), ∃ φ' : Limits.pullback h (Y.fromSpecStalk y) ⟶ (h ⁻¹ᵁ V).toScheme,
      IsPullback φ' (Limits.pullback.snd h (Y.fromSpecStalk y)) ((h ∣_ V) ≫ hV.isoSpec.hom)
        (Spec.map (CommRingCat.ofHom (Y.presheaf.germ V y hy).hom)) := by
    intro Z Y h V hV y hy
    have ha : Y.fromSpecStalk y = Spec.map (CommRingCat.ofHom (Y.presheaf.germ V y hy).hom) ≫
        hV.isoSpec.inv ≫ V.ι := by
      rw [← hV.fromSpecStalk_eq_fromSpecStalk hy, hV.isoSpec_inv_ι]
      rfl
    have s : IsPullback (h ⁻¹ᵁ V).ι ((h ∣_ V) ≫ hV.isoSpec.hom) h (hV.isoSpec.inv ≫ V.ι) := by
      refine IsPullback.of_iso (isPullback_morphismRestrict h V).flip (Iso.refl _) (Iso.refl _)
        hV.isoSpec (Iso.refl _) ?_ ?_ ?_ ?_ <;> simp
    have w : (Limits.pullback.snd h (Y.fromSpecStalk y) ≫
        Spec.map (CommRingCat.ofHom (Y.presheaf.germ V y hy).hom) ≫ hV.isoSpec.inv) ≫ V.ι =
        Limits.pullback.fst h (Y.fromSpecStalk y) ≫ h := by
      simp only [Category.assoc]
      exact (Limits.pullback.condition.trans
        (congrArg (Limits.pullback.snd h (Y.fromSpecStalk y) ≫ ·) ha)).symm
    obtain ⟨φ', h1, h2⟩ : ∃ φ' : Limits.pullback h (Y.fromSpecStalk y) ⟶ (h ⁻¹ᵁ V).toScheme,
        φ' ≫ (h ∣_ V) = Limits.pullback.snd h (Y.fromSpecStalk y) ≫
          Spec.map (CommRingCat.ofHom (Y.presheaf.germ V y hy).hom) ≫ hV.isoSpec.inv ∧
        φ' ≫ (h ⁻¹ᵁ V).ι = Limits.pullback.fst h (Y.fromSpecStalk y) :=
      ⟨(isPullback_morphismRestrict h V).lift _ _ w, IsPullback.lift_fst _ _ _ _,
        IsPullback.lift_snd _ _ _ _⟩
    refine ⟨φ', IsPullback.of_right ?_ ?_ s⟩
    · rw [h2]
      have t := IsPullback.of_hasPullback h (Y.fromSpecStalk y)
      convert t using 1
      exact ha.symm
    · rw [← Category.assoc, h1]
      simp



  have s3 : ∀ (B R A0 A1 N0 N1 : Type u) [CommRing B] [CommRing R] [Algebra B R] [CommRing A0]
      [CommRing A1] [CommRing N0] [CommRing N1] (σ0 : B →+* A0) (σ1 : B →+* A1) (τ0 : R →+* N0)
      (τ1 : R →+* N1) (𝔭 : Ideal B) [𝔭.IsPrime] [IsLocalization.AtPrime R 𝔭] (d : A0 →+ A1)
      (d' : N0 →+ N1), (∀ (b : B) (x : A0), d (σ0 b * x) = σ1 b * d x) →
      (∀ (r : R) (n : N0), d' (τ0 r * n) = τ1 r * d' n) →
      letI := Module.compHom A0 σ0; letI := Module.compHom A1 σ1;
      ∀ (Θ0 : TensorProduct B A0 R ≃+ N0) (Θ1 : TensorProduct B A1 R ≃+ N1),
      (∀ (x : A0) (r : R), Θ0 (x ⊗ₜ[B] r) = Θ0 (x ⊗ₜ[B] (1 : R)) * τ0 r) →
      (∀ (x : A1) (r : R), Θ1 (x ⊗ₜ[B] r) = Θ1 (x ⊗ₜ[B] (1 : R)) * τ1 r) →
      (∀ x : A0, Θ1 (d x ⊗ₜ[B] (1 : R)) = d' (Θ0 (x ⊗ₜ[B] (1 : R)))) →
      ∀ z : A1, (∃ n : N0, Θ1 (z ⊗ₜ[B] (1 : R)) = d' n) →
      ∃ s : B, s ∉ 𝔭 ∧ ∃ x : A0, σ1 s * z = d x := by
    intro B R A0 A1 N0 N1 _ _ _ _ _ _ _ σ0 σ1 τ0 τ1 𝔭 _ _ d d' hd hd'
    letI : Module B A0 := Module.compHom A0 σ0
    letI : Module B A1 := Module.compHom A1 σ1
    intro Θ0 Θ1 hΘ0 hΘ1 hcomm z hzn
    obtain ⟨n, hn⟩ := hzn
    have hfA : ∀ (M : Type u) [AddCommMonoid M] [Module B M], IsLocalizedModule 𝔭.primeCompl
        ((TensorProduct.comm B R M).toLinearMap ∘ₗ TensorProduct.mk B R M 1) :=
