import WeilR2_Part39
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcpa_dj_lus_generic_iso_finite : ∀ (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P] [IsLocallyNoetherian P] (f : X ⟶ P) (n : ℕ) (σ : Fin n → (P ⟶ X)) (A : Type u) [CommRing A] (Z₀ : Scheme.{u}) (u₀ : Z₀ ⟶ Spec (.of A)) (τ₀ : Fin n → (Spec (.of A) ⟶ Z₀)) (ιΩ : A →+* AlgebraicClosure P.functionField) (E₀ : IntermediateField P.functionField (AlgebraicClosure P.functionField)), FiniteDimensional P.functionField E₀ → (∀ a, ιΩ a ∈ E₀) → IsProper f → IsProper u₀ → LocallyOfFinitePresentation u₀ → (∀ i, τ₀ i ≫ u₀ = 𝟙 _) → ∀ (Y : Scheme.{u}) (π : Y ⟶ Spec (.of (AlgebraicClosure P.functionField))) (χ : Y ⟶ X) (ψ : Y ⟶ Z₀) (t : Fin n → (Spec (.of (AlgebraicClosure P.functionField)) ⟶ Y)), IsPullback χ π f (Spec.map (CommRingCat.ofHom (algebraMap P.functionField (AlgebraicClosure P.functionField))) ≫ P.fromSpecStalk (genericPoint P)) → IsPullback ψ π u₀ (Spec.map (CommRingCat.ofHom ιΩ)) → (∀ i, t i ≫ π = 𝟙 _) → (∀ i, t i ≫ χ = (Spec.map (CommRingCat.ofHom (algebraMap P.functionField (AlgebraicClosure P.functionField))) ≫ P.fromSpecStalk (genericPoint P)) ≫ σ i) → (∀ i, t i ≫ ψ = Spec.map (CommRingCat.ofHom ιΩ) ≫ τ₀ i) → ∃ (E : IntermediateField P.functionField (AlgebraicClosure P.functionField)) (_ : FiniteDimensional P.functionField E) (hE : ∀ a, ιΩ a ∈ E) (YE : Scheme.{u}) (πE : YE ⟶ Spec (CommRingCat.of ↥E)) (χE : YE ⟶ X) (ψE : YE ⟶ Z₀) (tE : Fin n → (Spec (CommRingCat.of ↥E) ⟶ YE)), E₀ ≤ E ∧ IsPullback χE πE f (Spec.map (CommRingCat.ofHom (algebraMap P.functionField ↥E)) ≫ P.fromSpecStalk (genericPoint P)) ∧ IsPullback ψE πE u₀ (Spec.map (CommRingCat.ofHom (ιΩ.codRestrict E hE))) ∧ (∀ i, tE i ≫ πE = 𝟙 _) ∧ (∀ i, tE i ≫ χE = (Spec.map (CommRingCat.ofHom (algebraMap P.functionField ↥E)) ≫ P.fromSpecStalk (genericPoint P)) ≫ σ i) ∧ (∀ i, tE i ≫ ψE = Spec.map (CommRingCat.ofHom (ιΩ.codRestrict E hE)) ≫ τ₀ i) :=
by
  intro X P _ _ f n σ A _ Z₀ u₀ τ₀ ιΩ E₀ hE₀fd hE₀ hf hu₀ hu₀fp hτ₀ Y π χ ψ t hχ hψ htπ htχ htψ
  classical

  have hSpec : ∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T] (φ : R →+* S)
      (φ' : S →+* T) (φ'' : R →+* T), φ'.comp φ = φ'' →
      Spec.map (CommRingCat.ofHom φ') ≫ Spec.map (CommRingCat.ofHom φ) =
        Spec.map (CommRingCat.ofHom φ'') := by
    intro R S T _ _ _ φ φ' φ'' h
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]



  have s2 : ∀ (K Ω : Type u) [Field K] [Field Ω] [Algebra K Ω] (ι : Type u) [Preorder ι]
      [IsDirectedOrder ι] (L : ι → IntermediateField K Ω) (hmono : Monotone L),
      (∀ y : Ω, ∃ i, y ∈ L i) → ∀ (T : Scheme.{u}) (w : ∀ i, T ⟶ Spec (CommRingCat.of ↥(L i))),
      (∀ i j (h : i ≤ j), w j ≫ Spec.map (CommRingCat.ofHom
        (IntermediateField.inclusion (hmono h)).toRingHom) = w i) →
      ∃! w₀ : T ⟶ Spec (CommRingCat.of Ω),
        ∀ i, w₀ ≫ Spec.map (CommRingCat.ofHom (L i).val.toRingHom) = w i := by
    intro K Ω _ _ _ ι _ _ L hmono hcov T w hw
    have s1 : ∀ (R : CommRingCat.{u}) (v : T ⟶ Spec R),
        T.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso R).inv ≫ Scheme.Hom.appTop v) = v := by
      intro R v
      rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
        toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
    have s2' : ∀ {R S : CommRingCat.{u}} (f : S ⟶ R) (v : T ⟶ Spec R),
        (Scheme.ΓSpecIso S).inv ≫ Scheme.Hom.appTop (v ≫ Spec.map f) =
          f ≫ (Scheme.ΓSpecIso R).inv ≫ Scheme.Hom.appTop v := by
      intro R S f v
      have e : (Scheme.ΓSpecIso S).inv ≫ Scheme.Hom.appTop (Spec.map f) =
          f ≫ (Scheme.ΓSpecIso R).inv := by
        rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv, Scheme.ΓSpecIso_naturality]
      rw [Scheme.Hom.comp_appTop, ← Category.assoc, e, Category.assoc]
    let ψ : ∀ k, L k →+* Γ(T, ⊤) := fun k =>
      ((Scheme.ΓSpecIso (CommRingCat.of (L k))).inv ≫ Scheme.Hom.appTop (w k)).hom
    have hψ : ∀ k j (h : k ≤ j),
        (ψ j).comp (IntermediateField.inclusion (hmono h)).toRingHom = ψ k := by
      intro k j h
      have h' := s2' (CommRingCat.ofHom (IntermediateField.inclusion (hmono h)).toRingHom) (w j)
      rw [hw k j h] at h'
      show _ = CommRingCat.Hom.hom ((Scheme.ΓSpecIso (CommRingCat.of (L k))).inv ≫
        Scheme.Hom.appTop (w k))
      rw [h']
      simp only [ψ, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    have step : ∀ k j (h : k ≤ j) (y : Ω) (hy : y ∈ L k) (hy' : y ∈ L j),
        ψ j ⟨y, hy'⟩ = ψ k ⟨y, hy⟩ := by
      intro k j h y hy hy'
      exact RingHom.congr_fun (hψ k j h) ⟨y, hy⟩
    have agree : ∀ k k' (y : Ω) (hy : y ∈ L k) (hy' : y ∈ L k'),
        ψ k ⟨y, hy⟩ = ψ k' ⟨y, hy'⟩ := by
      intro k k' y hy hy'
      obtain ⟨m, hkm, hk'm⟩ := directed_of (· ≤ ·) k k'
      rw [← step k m hkm y hy (hmono hkm hy), step k' m hk'm y hy' (hmono hk'm hy')]
    choose κ hκ using hcov
    let f : Ω → Γ(T, ⊤) := fun y => ψ (κ y) ⟨y, hκ y⟩
    have hf : ∀ k (y : Ω) (hy : y ∈ L k), f y = ψ k ⟨y, hy⟩ := fun k y hy => agree _ _ _ _ _
    have hub : ∀ x y : Ω, ∃ m, x ∈ L m ∧ y ∈ L m := by
      intro x y
      obtain ⟨m, h1, h2⟩ := directed_of (· ≤ ·) (κ x) (κ y)
      exact ⟨m, hmono h1 (hκ x), hmono h2 (hκ y)⟩
    let χ : Ω →+* Γ(T, ⊤) :=
      { toFun := f
        map_one' := by
          show f 1 = 1
          rw [hf (κ 0) 1 (L (κ 0)).one_mem]
          exact map_one (ψ _)
        map_mul' := by
          intro x y
          show f (x * y) = f x * f y
          obtain ⟨m, hx, hy⟩ := hub x y
          rw [hf m (x * y) (mul_mem hx hy), hf m x hx, hf m y hy]
          exact map_mul (ψ m) ⟨x, hx⟩ ⟨y, hy⟩
        map_zero' := by
          show f 0 = 0
          rw [hf (κ 0) 0 (L (κ 0)).zero_mem]
          exact map_zero (ψ _)
        map_add' := by
          intro x y
          show f (x + y) = f x + f y
          obtain ⟨m, hx, hy⟩ := hub x y
          rw [hf m (x + y) (add_mem hx hy), hf m x hx, hf m y hy]
          exact map_add (ψ m) ⟨x, hx⟩ ⟨y, hy⟩ }
    have hχ : ∀ k, χ.comp (L k).val.toRingHom = ψ k := by
      intro k
      ext ⟨y, hy⟩
      exact hf k y hy
    have huniq : ∀ χ' : Ω →+* Γ(T, ⊤), (∀ k, χ'.comp (L k).val.toRingHom = ψ k) → χ' = χ := by
      intro χ' h
      ext y
      exact RingHom.congr_fun (h (κ y)) ⟨y, hκ y⟩
    refine ⟨T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom χ), fun k => ?_, fun w₁ hw₁ => ?_⟩
    · rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hχ k]
      exact s1 _ (w k)
    · have hall : ∀ k, ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
          Scheme.Hom.appTop w₁).hom.comp (L k).val.toRingHom = ψ k := by
        intro k
        have h := s2' (CommRingCat.ofHom (L k).val.toRingHom) w₁
        rw [hw₁ k] at h
        show _ = CommRingCat.Hom.hom ((Scheme.ΓSpecIso (CommRingCat.of (L k))).inv ≫
          Scheme.Hom.appTop (w k))
        rw [h]
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      have hE : (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ Scheme.Hom.appTop w₁ =
          CommRingCat.ofHom χ := by
        ext1
        rw [CommRingCat.hom_ofHom]
        exact huniq _ hall
      calc w₁ = T.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            Scheme.Hom.appTop w₁) := (s1 _ w₁).symm
        _ = T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom χ) := by rw [hE]




  have s3 : ∀ (K Ω : Type u) [Field K] [Field Ω] [Algebra K Ω] (ι : Type u) [Preorder ι]
      [IsDirectedOrder ι] [Nonempty ι] (L : ι → IntermediateField K Ω) (hmono : Monotone L),
      (∀ (T : Scheme.{u}) (w : ∀ i, T ⟶ Spec (CommRingCat.of ↥(L i))),
        (∀ i j (h : i ≤ j), w j ≫ Spec.map (CommRingCat.ofHom
          (IntermediateField.inclusion (hmono h)).toRingHom) = w i) →
        ∃! w₀ : T ⟶ Spec (CommRingCat.of Ω),
          ∀ i, w₀ ≫ Spec.map (CommRingCat.ofHom (L i).val.toRingHom) = w i) →
      ∀ (S : Scheme.{u}) (b : ∀ i, Spec (CommRingCat.of ↥(L i)) ⟶ S)
        (bΩ : Spec (CommRingCat.of Ω) ⟶ S),
      (∀ i, Spec.map (CommRingCat.ofHom (L i).val.toRingHom) ≫ b i = bΩ) →
      ∀ (X : Scheme.{u}) (f : X ⟶ S), QuasiCompact f → QuasiSeparated f →
      ∀ (B Z : Scheme.{u}) (u : Z ⟶ B), LocallyOfFinitePresentation u →
      ∀ (c : ∀ i, Spec (CommRingCat.of ↥(L i)) ⟶ B) (cΩ : Spec (CommRingCat.of Ω) ⟶ B),
      (∀ i, Spec.map (CommRingCat.ofHom (L i).val.toRingHom) ≫ c i = cΩ) →
      ∀ (Y : Scheme.{u}) (χ : Y ⟶ X) (π : Y ⟶ Spec (CommRingCat.of Ω)) (ψ : Y ⟶ Z),
      IsPullback χ π f bΩ → ψ ≫ u = π ≫ cΩ →
      ∃ (i : ι) (κ : Y ⟶ Limits.pullback f (b i)) (g : Limits.pullback f (b i) ⟶ Z),
        κ ≫ Limits.pullback.fst f (b i) = χ ∧
        κ ≫ Limits.pullback.snd f (b i) = π ≫ Spec.map (CommRingCat.ofHom (L i).val.toRingHom) ∧
        κ ≫ g = ψ ∧ g ≫ u = Limits.pullback.snd f (b i) ≫ c i := by
    intro K Ω _ _ _ ι _ _ _ L hmono H S b bΩ hb X f hqc hqs B Z u hu c cΩ hc Y χ π ψ hχ hψu

    have he : ∀ {i j : ι} (h : i ≤ j),
        Spec.map (CommRingCat.ofHom (L j).val.toRingHom) ≫
          Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono h)).toRingHom) =
        Spec.map (CommRingCat.ofHom (L i).val.toRingHom) := fun h =>
      hSpec _ _ _ (RingHom.ext fun _ => rfl)
    have hincl_comp : ∀ {a b' c' : ι} (h1 : b' ≤ a) (h2 : c' ≤ b') (h3 : c' ≤ a),
        Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono h1)).toRingHom) ≫
          Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono h2)).toRingHom) =
        Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono h3)).toRingHom) :=
      fun _ _ _ => hSpec _ _ _ (RingHom.ext fun _ => rfl)
    have hincl_id : ∀ {a : ι} (h : a ≤ a),
        Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono h)).toRingHom) =
          𝟙 _ := by
      intro a h
      have e1 : (IntermediateField.inclusion (hmono h)).toRingHom = RingHom.id _ :=
        RingHom.ext fun _ => rfl
      rw [e1, CommRingCat.ofHom_id, Spec.map_id]
    have hbc : ∀ {i j : ι} (h : i ≤ j),
        Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono h)).toRingHom) ≫ b i =
          b j := by
      intro i j h
      apply (cancel_epi (Spec.map (CommRingCat.ofHom (L j).val.toRingHom))).1
      rw [← Category.assoc, he h, hb i, hb j]
    have hcc : ∀ {i j : ι} (h : i ≤ j),
        Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono h)).toRingHom) ≫ c i =
          c j := by
      intro i j h
      apply (cancel_epi (Spec.map (CommRingCat.ofHom (L j).val.toRingHom))).1
      rw [← Category.assoc, he h, hc i, hc j]

    haveI : IsFiltered ι := isFiltered_of_directed_le_nonempty ι
    haveI : IsCofiltered ιᵒᵖ := isCofiltered_op_of_isFiltered ι

    obtain ⟨Dmap, hDfst, hDsnd⟩ : ∃ Dmap : ∀ {i j : ι} (h : i ≤ j),
        Limits.pullback f (b j) ⟶ Limits.pullback f (b i),
        (∀ {i j : ι} (h : i ≤ j), Dmap h ≫ Limits.pullback.fst f (b i) =
          Limits.pullback.fst f (b j)) ∧
        (∀ {i j : ι} (h : i ≤ j), Dmap h ≫ Limits.pullback.snd f (b i) =
          Limits.pullback.snd f (b j) ≫
            Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono h)).toRingHom)) :=
      ⟨fun {i j} h => Limits.pullback.lift (Limits.pullback.fst f (b j))
        (Limits.pullback.snd f (b j) ≫
          Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono h)).toRingHom))
        (by rw [Limits.pullback.condition, Category.assoc, hbc h]),
        fun h => Limits.pullback.lift_fst _ _ _, fun h => Limits.pullback.lift_snd _ _ _⟩
    let D : ιᵒᵖ ⥤ Scheme.{u} :=
      { obj := fun i => Limits.pullback f (b i.unop)
        map := fun {i j} φ => Dmap (leOfHom φ.unop)
        map_id := by
          intro i
          show Dmap (leOfHom (𝟙 i).unop) = 𝟙 _
          apply Limits.pullback.hom_ext
          · rw [hDfst (leOfHom (𝟙 i).unop), Category.id_comp]
          · rw [hDsnd (leOfHom (𝟙 i).unop), hincl_id (leOfHom (𝟙 i).unop), Category.comp_id,
              Category.id_comp]
        map_comp := by
          intro i j k φ φ'
          show Dmap (leOfHom (φ ≫ φ').unop) = Dmap (leOfHom φ.unop) ≫ Dmap (leOfHom φ'.unop)
          apply Limits.pullback.hom_ext
          · rw [hDfst (leOfHom (φ ≫ φ').unop), Category.assoc, hDfst (leOfHom φ'.unop),
              hDfst (leOfHom φ.unop)]
          · rw [hDsnd (leOfHom (φ ≫ φ').unop), Category.assoc, hDsnd (leOfHom φ'.unop),
              ← Category.assoc, hDsnd (leOfHom φ.unop), Category.assoc,
              hincl_comp (leOfHom φ.unop) (leOfHom φ'.unop) (leOfHom (φ ≫ φ').unop)] }

    haveI : ∀ {i j : ιᵒᵖ} (φ : i ⟶ j), IsAffineHom (D.map φ) := by
      intro i j φ
      have hpb : IsPullback (Dmap (leOfHom φ.unop)) (Limits.pullback.snd f (b i.unop))
          (Limits.pullback.snd f (b j.unop))
          (Spec.map (CommRingCat.ofHom
            (IntermediateField.inclusion (hmono (leOfHom φ.unop))).toRingHom)) := by
        refine IsPullback.of_right ?_ (hDsnd (leOfHom φ.unop))
          (IsPullback.of_hasPullback f (b j.unop))
        rw [hDfst (leOfHom φ.unop), hbc (leOfHom φ.unop)]
        exact IsPullback.of_hasPullback f (b i.unop)
      exact MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip
        (isAffineHom_of_isAffine _)
    haveI : ∀ i : ιᵒᵖ, CompactSpace (D.obj i) := fun i =>
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd f (b i.unop))
    haveI : ∀ i : ιᵒᵖ, QuasiSeparatedSpace (D.obj i) := fun i =>
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd f (b i.unop))

    let κ : ∀ i, Y ⟶ Limits.pullback f (b i) := fun i =>
      Limits.pullback.lift χ (π ≫ Spec.map (CommRingCat.ofHom (L i).val.toRingHom))
        (by rw [hχ.w, Category.assoc, hb i])
    have hκ1 : ∀ i, κ i ≫ Limits.pullback.fst f (b i) = χ := fun i =>
      Limits.pullback.lift_fst _ _ _
    have hκ2 : ∀ i, κ i ≫ Limits.pullback.snd f (b i) =
        π ≫ Spec.map (CommRingCat.ofHom (L i).val.toRingHom) := fun i =>
      Limits.pullback.lift_snd _ _ _
    let cn : Limits.Cone D :=
      { pt := Y
        π :=
          { app := fun i => κ i.unop
            naturality := by
              intro i j φ
              show 𝟙 Y ≫ κ j.unop = κ i.unop ≫ Dmap (leOfHom φ.unop)
              rw [Category.id_comp]
              apply Limits.pullback.hom_ext
              · rw [Category.assoc, hDfst (leOfHom φ.unop), hκ1, hκ1]
              · rw [Category.assoc, hDsnd (leOfHom φ.unop), ← Category.assoc, hκ2, hκ2,
                  Category.assoc, he (leOfHom φ.unop)] } }

    have hcn : Limits.IsLimit cn := by
      refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
      let sl : ∀ i : ι, s.pt ⟶ Limits.pullback f (b i) := fun i => s.π.app (Opposite.op i)
      have hnat : ∀ i j (h : i ≤ j), sl j ≫ Dmap h = sl i := by
        intro i j h
        have := s.π.naturality (homOfLE h).op
        exact ((Category.id_comp (s.π.app (Opposite.op i))).symm.trans this).symm
      let w : ∀ i, s.pt ⟶ Spec (CommRingCat.of ↥(L i)) := fun i =>
        sl i ≫ Limits.pullback.snd f (b i)
      have hw : ∀ i j (h : i ≤ j), w j ≫
          Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono h)).toRingHom) =
            w i := by
        intro i j h
        show (sl j ≫ Limits.pullback.snd f (b j)) ≫ _ = sl i ≫ Limits.pullback.snd f (b i)
        rw [Category.assoc, ← hDsnd h, ← Category.assoc, hnat i j h]
      obtain ⟨w₀, hw₀, hw₀u⟩ := H s.pt w hw
      let i₀ : ι := Classical.arbitrary ι
      let x : s.pt ⟶ X := sl i₀ ≫ Limits.pullback.fst f (b i₀)
      have hx : ∀ i, sl i ≫ Limits.pullback.fst f (b i) = x := by
        intro i
        obtain ⟨k, hik, hi₀k⟩ := directed_of (· ≤ ·) i i₀
        show _ = sl i₀ ≫ Limits.pullback.fst f (b i₀)
        rw [← hnat i k hik, ← hnat i₀ k hi₀k, Category.assoc, Category.assoc, hDfst hik,
          hDfst hi₀k]
      have hxf : x ≫ f = w₀ ≫ bΩ := by
        show (sl i₀ ≫ Limits.pullback.fst f (b i₀)) ≫ f = _
        rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, ← hb i₀,
          ← Category.assoc, hw₀ i₀]
      let l : s.pt ⟶ Y := hχ.lift x w₀ hxf
      have hl1 : l ≫ χ = x := hχ.lift_fst _ _ _
      have hl2 : l ≫ π = w₀ := hχ.lift_snd _ _ _
      refine ⟨l, fun j => ?_, fun l' hl' => ?_⟩
      · obtain ⟨j⟩ := j
        show l ≫ κ j = sl j
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hκ1, hl1, hx]
        · rw [Category.assoc, hκ2, ← Category.assoc, hl2, hw₀ j]
      · have hl'i : ∀ i, l' ≫ κ i = sl i := fun i => hl' (Opposite.op i)
        apply hχ.hom_ext
        · rw [hl1, ← hκ1 i₀, ← Category.assoc, hl'i i₀]
        · rw [hl2]
          apply hw₀u
          intro i
          show _ = sl i ≫ Limits.pullback.snd f (b i)
          rw [Category.assoc, ← hκ2 i, ← Category.assoc, hl'i i]

    let tt : D ⟶ (Functor.const ιᵒᵖ).obj B :=
      { app := fun i => Limits.pullback.snd f (b i.unop) ≫ c i.unop
        naturality := by
          intro i j φ
          show Dmap (leOfHom φ.unop) ≫ Limits.pullback.snd f (b j.unop) ≫ c j.unop =
            (Limits.pullback.snd f (b i.unop) ≫ c i.unop) ≫ 𝟙 B
          rw [Category.comp_id, ← Category.assoc, hDsnd (leOfHom φ.unop), Category.assoc,
            hcc (leOfHom φ.unop)] }
    have hcomm : cn.π ≫ tt = (Functor.const ιᵒᵖ).map (ψ ≫ u) := by
      ext i
      show κ i.unop ≫ Limits.pullback.snd f (b i.unop) ≫ c i.unop = ψ ≫ u
      rw [← Category.assoc, hκ2, Category.assoc, hc, hψu]
    obtain ⟨i, g, hg1, hg2⟩ :=
      Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation D tt u cn hcn ψ hcomm
    exact ⟨i.unop, κ i.unop, g, hκ1 _, hκ2 _, hg1, hg2⟩



  have s4 : ∀ (E Ω : Type u) [Field E] [Field Ω] (j : E →+* Ω) (A : Type u) [CommRing A]
      (ιE : A →+* E) (Z₀ : Scheme.{u}) (u₀ : Z₀ ⟶ Spec (.of A)) (XE : Scheme.{u})
      (πE : XE ⟶ Spec (.of E)) (g : XE ⟶ Z₀) (Y : Scheme.{u}) (π : Y ⟶ Spec (.of Ω))
