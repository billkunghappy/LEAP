theorem wcpa_dj_lqu_sp_fibre_chart : ∀ (C P' : Scheme.{u}) (g : C ⟶ P') (U : P'.Opens) (hU : IsAffineOpen U) (V₀ : C.Opens) (hV₀ : IsAffineOpen V₀) (e : V₀ ≤ g ⁻¹ᵁ U) (L : Type u) [Field L] (ψ : Γ(P', U) →+* L), letI := (g.appLE U V₀ e).hom.toAlgebra; letI := ψ.toAlgebra; ∃ ι : Spec (.of (TensorProduct Γ(P', U) L Γ(C, V₀))) ⟶ Limits.pullback g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec), IsOpenImmersion ι ∧ ι ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) = Spec.map (CommRingCat.ofHom (algebraMap L (TensorProduct Γ(P', U) L Γ(C, V₀)))) ∧ ι ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) = Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : Γ(C, V₀) →ₐ[Γ(P', U)] TensorProduct Γ(P', U) L Γ(C, V₀)).toRingHom) ≫ hV₀.fromSpec :=
by
  intro C P' g U hU V₀ hV₀ e L _ ψ
  letI := (g.appLE U V₀ e).hom.toAlgebra
  letI := ψ.toAlgebra

  have s2 : ∀ {W X Y Z S : Scheme.{u}} {fst : W ⟶ X} {snd : W ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
      (i : Z ⟶ S) [Mono i] {f' : X ⟶ S} {g' : Y ⟶ S},
      IsPullback fst snd f g → f ≫ i = f' → g ≫ i = g' → IsPullback fst snd f' g' := by
    intro W X Y Z S fst snd f g i _ f' g' H hf hg
    subst hf hg
    refine IsPullback.mk' ?_ ?_ ?_
    · rw [← Category.assoc, H.w, Category.assoc]
    · intro T φ φ' h1 h2
      exact H.hom_ext h1 h2
    · intro T a b hab
      have w : a ≫ f = b ≫ g := by
        rw [← cancel_mono i]
        simpa only [Category.assoc] using hab
      exact ⟨H.lift a b w, H.lift_fst a b w, H.lift_snd a b w⟩

  have H1 := isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_tensorProduct Γ(P', U) L Γ(C, V₀))
  haveI : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
  haveI : IsOpenImmersion hV₀.fromSpec := hV₀.isOpenImmersion_fromSpec
  have e1 : Spec.map (CommRingCat.ofHom (algebraMap Γ(P', U) L))
      ≫ hU.fromSpec = Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec := rfl
  have e2 : Spec.map (CommRingCat.ofHom (algebraMap Γ(P', U) Γ(C, V₀))) ≫ hU.fromSpec
      = hV₀.fromSpec ≫ g := IsAffineOpen.SpecMap_appLE_fromSpec g hU hV₀ e
  have H2 := s2 hU.fromSpec H1 e1 e2
  have H : IsPullback
      (Spec.map (CommRingCat.ofHom (algebraMap L (TensorProduct Γ(P', U) L Γ(C, V₀)))))
      (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : Γ(C, V₀) →ₐ[Γ(P', U)]
        TensorProduct Γ(P', U) L Γ(C, V₀)).toRingHom))
      (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) (hV₀.fromSpec ≫ g) := H2

  have w : ((Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(C, V₀) →ₐ[Γ(P', U)] TensorProduct Γ(P', U) L Γ(C, V₀)).toRingHom))
        ≫ hV₀.fromSpec) ≫ g =
      Spec.map (CommRingCat.ofHom (algebraMap L (TensorProduct Γ(P', U) L Γ(C, V₀)))) ≫
        (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) := by
    rw [Category.assoc]; exact H.w.symm
  let ι := Limits.pullback.lift _ _ w
  have hιsnd : ι ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) = _ :=
    Limits.pullback.lift_snd _ _ w
  have hιfst : ι ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) = _ :=
    Limits.pullback.lift_fst _ _ w
  have H' : IsPullback (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(C, V₀) →ₐ[Γ(P', U)] TensorProduct Γ(P', U) L Γ(C, V₀)).toRingHom))
      ι hV₀.fromSpec (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)) := by
    refine IsPullback.of_bot ?_ hιfst.symm (IsPullback.of_hasPullback g _)
    rw [hιsnd]
    exact H.flip
  have hιo : IsOpenImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) H' inferInstance
  exact ⟨ι, hιo, hιsnd, hιfst⟩

theorem wcpa_dj_lcf_saj_fibre_minimal_smooth : ∀ (C P' : Scheme.{u}) (g : C ⟶ P'), wcpaDjSemistable g → IsLocallyNoetherian P' → ∀ (V : C.Opens) (W : P'.Opens) (hle : V ≤ g ⁻¹ᵁ W) (hV : IsAffineOpen V) (hW : IsAffineOpen W) (𝔭 : PrimeSpectrum Γ(C, V)), 𝔭.asIdeal ∈ (Ideal.map (g.appLE W V hle).hom (𝔭.asIdeal.comap (g.appLE W V hle).hom)).minimalPrimes → ∃ W' : C.Opens, hV.fromSpec 𝔭 ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ g) :=
by
  intro C P' g hss hP' V W hle hV hW 𝔭 hmin
  classical

  have s2 : ∀ (T : Type u) [CommRing T] (w : Ideal T), w ∈ minimalPrimes T →
      ∀ t ∈ w, ∃ u ∉ w, ∃ k : ℕ, u * t ^ k = 0 := by
    intro T _ w hw
    have hwp : w.IsPrime := Ideal.minimalPrimes_isPrime hw
    have h1 : (1 : T) ∉ w := (Ideal.ne_top_iff_one w).mp hwp.ne_top
    intro t ht
    by_contra hcon
    push_neg at hcon
    let S : Submonoid T :=
      { carrier := {a | ∃ u ∉ w, ∃ k : ℕ, a = u * t ^ k}
        one_mem' := ⟨1, h1, 0, by simp⟩
        mul_mem' := by
          rintro a b ⟨u, hu, k, rfl⟩ ⟨u', hu', k', rfl⟩
          exact ⟨u * u', fun h => (hwp.mem_or_mem h).elim hu hu', k + k', by ring⟩ }
    have hdisj : Disjoint ((⊥ : Ideal T) : Set T) S := by
      rw [Set.disjoint_left]
      rintro a ha ⟨u, hu, k, rfl⟩
      exact hcon u hu k ha
    obtain ⟨P, hP, -, hPdisj⟩ := Ideal.exists_le_prime_disjoint ⊥ S hdisj
    have hPw : P ≤ w := by
      intro a ha
      by_contra haw
      exact Set.disjoint_left.mp hPdisj ha ⟨a, haw, 0, by simp⟩
    have hwP : w ≤ P := hw.2 ⟨hP, bot_le⟩ hPw
    exact Set.disjoint_left.mp hPdisj (hwP ht) ⟨1, h1, 1, by simp⟩

  have s3 : ∀ (T O : Type u) [CommRing T] [CommRing O] [IsLocalRing O] (σ : T →+* O) (w : Ideal T),
      (∀ t ∈ w, ∃ u ∉ w, ∃ k : ℕ, u * t ^ k = 0) → (∀ t, t ∉ w → IsUnit (σ t)) →
      (∀ y : O, ∃ t s, s ∉ w ∧ y * σ s = σ t) →
      ∀ y ∈ IsLocalRing.maximalIdeal O, IsNilpotent y := by
    intro T O _ _ _ σ w hann hunit hfrac y hy
    obtain ⟨t, s, hs, hys⟩ := hfrac y
    have ht : t ∈ w := by
      by_contra ht
      have h1 : IsUnit (y * σ s) := hys ▸ hunit t ht
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hy)
        (isUnit_of_mul_isUnit_left h1)
    obtain ⟨u, hu, k, huk⟩ := hann t ht
    have h2 : σ t ^ k = 0 := by
      have : σ u * σ t ^ k = 0 := by rw [← map_pow, ← map_mul, huk, map_zero]
      exact (hunit u hu).mul_right_eq_zero.mp this
    refine ⟨k, ?_⟩
    have h3 : y ^ k * σ s ^ k = 0 := by rw [← mul_pow, hys, h2]
    exact ((hunit s hs).pow k).mul_left_eq_zero.mp h3

  have s4 : ∀ (R B L : Type u) [CommRing R] [CommRing B] [Field L] (φ : R →+* B) (χ : B →+* L),
      RingHom.ker χ ∈ (Ideal.map φ ((RingHom.ker χ).comap φ)).minimalPrimes →
      letI := φ.toAlgebra; letI := (χ.comp φ).toAlgebra;
      ∃ w : Ideal (TensorProduct R L B), w ∈ minimalPrimes (TensorProduct R L B) ∧
        w.comap (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R L B).toRingHom =
          RingHom.ker χ := by
    intro R B L _ _ _ φ χ hmin
    letI := φ.toAlgebra
    letI := (χ.comp φ).toAlgebra
    let gχ : B →ₐ[R] L := { χ with commutes' := fun r => rfl }
    let μ : TensorProduct R L B →ₐ[L] L :=
      Algebra.TensorProduct.lift (Algebra.ofId L L) gχ (fun _ _ => Commute.all _ _)
    have hμ : ∀ b, μ (Algebra.TensorProduct.includeRight b) = χ b := by
      intro b
      rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.lift_tmul, map_one,
        one_mul]
      rfl
    have hQ : (RingHom.ker (μ : TensorProduct R L B →+* L)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨w, hw, hwQ⟩ := Ideal.exists_minimalPrimes_le
      (bot_le : (⊥ : Ideal (TensorProduct R L B)) ≤ RingHom.ker (μ : TensorProduct R L B →+* L))
    refine ⟨w, hw, ?_⟩
    have hle1 : w.comap
        (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R L B).toRingHom ≤
        RingHom.ker χ := by
      intro b hb
      have := hwQ hb
      rw [RingHom.mem_ker] at this ⊢
      rw [← hμ b]
      exact this
    have hle2 : Ideal.map φ ((RingHom.ker χ).comap φ) ≤
        w.comap (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R L B).toRingHom := by
      rw [Ideal.map_le_iff_le_comap]
      intro q hq
      rw [Ideal.mem_comap, RingHom.mem_ker] at hq
      rw [Ideal.mem_comap, Ideal.mem_comap]
      have e1 : (Algebra.TensorProduct.includeRight : B →ₐ[R] TensorProduct R L B).toRingHom (φ q) =
          (algebraMap R L q) ⊗ₜ[R] (1 : B) := by
        show (1 : L) ⊗ₜ[R] (algebraMap R B q) = _
        rw [Algebra.TensorProduct.tmul_one_eq_one_tmul]
      rw [e1]
      have e2 : algebraMap R L q = 0 := hq
      rw [e2, TensorProduct.zero_tmul]
      exact w.zero_mem
    have hwp : w.IsPrime := Ideal.minimalPrimes_isPrime hw
    have hge := hmin.2 ⟨Ideal.IsPrime.comap _, hle2⟩ hle1
    exact le_antisymm hle1 hge

  have s1 : ∀ (L : Type u) [Field L] (Rr : Type u) [CommRing Rr] [IsLocalRing Rr]
      [IsNoetherianRing Rr] (φ : L →+* Rr)
      (e : AdicCompletion (IsLocalRing.maximalIdeal Rr) Rr ≃+*
        (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})),
      e.toRingHom.comp ((algebraMap Rr (AdicCompletion (IsLocalRing.maximalIdeal Rr) Rr)).comp φ) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C →
      (∀ y ∈ IsLocalRing.maximalIdeal Rr, IsNilpotent y) → False := by
    intro L _ Rr _ _ _ φ e he hnil
    obtain ⟨hdens, hstrict⟩ := wcpa_dj_lqr_completion_bridge L Rr e
    have hcomp : (e.toRingHom.comp
        (algebraMap Rr (AdicCompletion (IsLocalRing.maximalIdeal Rr) Rr))).comp φ =
        (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})).comp
          MvPowerSeries.C := by
      rw [RingHom.comp_assoc]; exact he
    have H := wcpa_dj_lqr_quot_hilb L Rr φ
      (e.toRingHom.comp (algebraMap Rr (AdicCompletion (IsLocalRing.maximalIdeal Rr) Rr)))
      hcomp hdens hstrict
    letI : Algebra L Rr := φ.toAlgebra
    have H2 : ∀ n, 1 ≤ n →
        Module.finrank L (Rr ⧸ IsLocalRing.maximalIdeal Rr ^ n) = 2 * n - 1 := by
      intro n hn
      rw [H n]
      exact wcpa_dj_lqr_node_trunc_dim L n hn
    obtain ⟨N, hN⟩ := IsNoetherianRing.isNilpotent_nilradical Rr
    have hmle : IsLocalRing.maximalIdeal Rr ≤ nilradical Rr := fun y hy =>
      (mem_nilradical).mpr (hnil y hy)
    have h0 : ∀ k, N ≤ k → IsLocalRing.maximalIdeal Rr ^ k = ⊥ := by
      intro k hk
      rw [eq_bot_iff, ← Ideal.zero_eq_bot, ← hN]
      exact (Ideal.pow_le_pow_right hk).trans (Ideal.pow_right_mono hmle N)
    have e1 := H2 (N + 1) (by omega)
    have e2 := H2 (N + 2) (by omega)
    rw [h0 (N + 1) (by omega)] at e1
    rw [h0 (N + 2) (by omega)] at e2
    omega

  have key : ∀ (L : Type u) [Field L] [IsAlgClosed L] (χ : Γ(C, V) →+* L),
      RingHom.ker χ = 𝔭.asIdeal →
      ∃ W' : C.Opens, hV.fromSpec 𝔭 ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ g) := by
    intro L _ _ χ hχ
    have hmin' : RingHom.ker χ ∈ (Ideal.map (g.appLE W V hle).hom
        ((RingHom.ker χ).comap (g.appLE W V hle).hom)).minimalPrimes := by
      rw [hχ]; exact hmin
    obtain ⟨ι, hιo, hι2, hι1⟩ :=
      wcpa_dj_lqu_sp_fibre_chart C P' g W hW V hV hle L (χ.comp (g.appLE W V hle).hom)
    obtain ⟨w, hw, hwc⟩ := s4 _ _ L (g.appLE W V hle).hom χ hmin'
    letI : Algebra Γ(P', W) Γ(C, V) := (g.appLE W V hle).hom.toAlgebra
    letI : Algebra Γ(P', W) L := (χ.comp (g.appLE W V hle).hom).toAlgebra
    have hwp : w.IsPrime := Ideal.minimalPrimes_isPrime hw
    let x : Spec (.of (TensorProduct Γ(P', W) L Γ(C, V))) := ⟨w, hwp⟩
    have hfst : Limits.pullback.fst g
        (Spec.map (CommRingCat.ofHom (χ.comp (g.appLE W V hle).hom)) ≫ hW.fromSpec) (ι x) =
        hV.fromSpec 𝔭 := by
      rw [← Scheme.Hom.comp_apply, hι1, Scheme.Hom.comp_apply]
      refine congrArg _ (PrimeSpectrum.ext ?_)
      show Ideal.comap _ w = 𝔭.asIdeal
      rw [← hχ]
      exact hwc
    obtain ⟨σ, -, hunit, hfrac, -⟩ := wcpa_dj_lqu_sp_stalk_loc L
      (TensorProduct Γ(P', W) L Γ(C, V)) _ _ ι hιo hι2 x
    have hnil := s3 _ _ σ w (s2 _ w hw) hunit hfrac
    haveI : IsProper g := hss.2.1
    haveI : LocallyOfFiniteType (Limits.pullback.snd g
        (Spec.map (CommRingCat.ofHom (χ.comp (g.appLE W V hle).hom)) ≫ hW.fromSpec)) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
        (IsPullback.of_hasPullback _ _) (inferInstance : LocallyOfFiniteType g)
    haveI : IsLocallyNoetherian (Limits.pullback g
        (Spec.map (CommRingCat.ofHom (χ.comp (g.appLE W V hle).hom)) ≫ hW.fromSpec)) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g
        (Spec.map (CommRingCat.ofHom (χ.comp (g.appLE W V hle).hom)) ≫ hW.fromSpec))
    rcases hss.2.2 L (Spec.map (CommRingCat.ofHom (χ.comp (g.appLE W V hle).hom)) ≫ hW.fromSpec)
        (ι x) with ⟨W₀, hW₀, hsm⟩ | ⟨e, he⟩
    · haveI := hP'
      obtain ⟨W', hW', hsm'⟩ := wcpa_dj_bsc_smooth_descend P' C g L
        (Spec.map (CommRingCat.ofHom (χ.comp (g.appLE W V hle).hom)) ≫ hW.fromSpec) (ι x) hss.1
        inferInstance ⟨W₀, hW₀, hsm⟩
      exact ⟨W', hfst ▸ hW', hsm'⟩
    · exact (s1 L _ _ e he hnil).elim
  refine key (AlgebraicClosure 𝔭.asIdeal.ResidueField)
    ((algebraMap 𝔭.asIdeal.ResidueField (AlgebraicClosure 𝔭.asIdeal.ResidueField)).comp
      (algebraMap Γ(C, V) 𝔭.asIdeal.ResidueField)) ?_
  rw [RingHom.ker_comp_of_injective _ (algebraMap 𝔭.asIdeal.ResidueField
    (AlgebraicClosure 𝔭.asIdeal.ResidueField)).injective, Ideal.ker_algebraMap_residueField]

theorem wcpa_dj_nccw_ebbi_horizontal_closed : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ∀ y : N, (q ≫ ν ≫ u) y ≠ IsLocalRing.closedPoint R → ¬ nccwSm u (ν (q y)) → ∀ x ∈ closure ({y} : Set N), (q ≫ ν ≫ u) x = IsLocalRing.closedPoint R → IsClosed ({x} : Set N) :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA y hy hsm
    x hx hx0
  classical

  have s1 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (t : A) (P₀ P₁ P₂ : Ideal A),
      P₀.IsPrime → P₁.IsPrime → P₂.IsPrime → P₀ < P₁ → P₁ < P₂ →
      (∀ Q : Ideal A, Q.IsPrime → P₀ < Q → Q ≤ P₂ → t ∈ Q) →
      (∀ Q₁ Q₂ : Ideal A, Q₁.IsPrime → Q₂.IsPrime → t ∈ Q₁ → Q₁ < Q₂ → Q₂ < P₂ → False) →
      False := by
    intro A _ _ t P₀ P₁ P₂ h0 h1 h2 h01 h12 ha hb
    classical
    set I : Ideal A := P₀ ⊔ Ideal.span {t} with hI
    have hM : I.minimalPrimes.Finite := Ideal.finite_minimalPrimes_of_isNoetherianRing A I

    have hii : ∀ Q : Ideal A, Q.IsPrime → P₀ < Q → Q < P₂ → Q ∈ I.minimalPrimes := by
      intro Q hQ hPQ hQP
      have htQ : t ∈ Q := ha Q hQ hPQ hQP.le
      have hIQ : I ≤ Q := sup_le hPQ.le ((Ideal.span_singleton_le_iff_mem _).mpr htQ)
      obtain ⟨Q', hQ', hQ'Q⟩ := Ideal.exists_minimalPrimes_le hIQ
      have hQ'p : Q'.IsPrime := hQ'.1.1
      have hIQ' : I ≤ Q' := hQ'.1.2
      by_cases he : Q' = Q
      · rw [← he]; exact hQ'
      · exfalso
        have htQ' : t ∈ Q' := hIQ' (le_sup_right (a := P₀) (Ideal.subset_span rfl))
        exact hb Q' Q hQ'p hQ htQ' (lt_of_le_of_ne hQ'Q he) hQP

    set s : Set (Ideal A) := {Q | Q ∈ I.minimalPrimes ∧ ¬ P₂ ≤ Q} with hs
    have hsfin : s.Finite := hM.subset (fun Q hQ => hQ.1)
    have hnot : ¬ ((P₂ : Set A) ⊆ ⋃ i ∈ s, ((id i : Ideal A) : Set A)) := by
      intro hsub
      rw [Ideal.subset_union_prime_finite hsfin (f := id) ⊥ ⊥
        (fun i hi _ _ => hi.1.1.1)] at hsub
      obtain ⟨Q, hQ, hle⟩ := hsub
      exact hQ.2 hle
    obtain ⟨a, haP2, haQ⟩ : ∃ a ∈ P₂, ∀ Q ∈ s, a ∉ Q := by
      by_contra hc
      push Not at hc
      apply hnot
      intro x hx
      obtain ⟨Q, hQ, hxQ⟩ := hc x hx
      exact Set.mem_biUnion hQ hxQ

    have hP1s : P₁ ∈ s := ⟨hii P₁ h1 h01 h12, fun hle => (lt_irrefl _ (lt_of_lt_of_le h12 hle))⟩
    have haP1 : a ∉ P₁ := haQ P₁ hP1s
    have haP0 : a ∉ P₀ := fun h => haP1 (h01.le h)

    have hP2min : P₂ ∈ (P₀ ⊔ Ideal.span {a}).minimalPrimes := by
      have hJ : P₀ ⊔ Ideal.span {a} ≤ P₂ :=
        sup_le (h01.le.trans h12.le) ((Ideal.span_singleton_le_iff_mem _).mpr haP2)
      obtain ⟨R', hR', hR'P⟩ := Ideal.exists_minimalPrimes_le hJ
      have haR' : a ∈ R' := hR'.1.2 (le_sup_right (a := P₀) (Ideal.subset_span rfl))
      by_cases he : R' = P₂
      · rw [← he]; exact hR'
      · exfalso
        have hP0R : P₀ < R' := lt_of_le_of_ne (le_sup_left.trans hR'.1.2)
          (fun e => haP0 (e ▸ haR'))
        have hRs : R' ∈ s := ⟨hii R' hR'.1.1 hP0R (lt_of_le_of_ne hR'P he),
          fun hle => he (le_antisymm hR'P hle)⟩
        exact haQ R' hRs haR'

    have hht := Ideal.map_height_le_one_of_mem_minimalPrimes hP2min

    set mk := Ideal.Quotient.mk P₀ with hmk
    have hsurj : Function.Surjective mk := Ideal.Quotient.mk_surjective
    have hker : RingHom.ker mk = P₀ := Ideal.mk_ker
    have hcm : ∀ P : Ideal A, P₀ ≤ P → Ideal.comap mk (Ideal.map mk P) = P := by
      intro P hP
      rw [Ideal.comap_map_of_surjective _ hsurj, ← RingHom.ker_eq_comap_bot, hker]
      exact sup_eq_left.mpr hP
    have hp1 : (Ideal.map mk P₁).IsPrime :=
      Ideal.map_isPrime_of_surjective hsurj (by rw [hker]; exact h01.le)
    have hp2 : (Ideal.map mk P₂).IsPrime :=
      Ideal.map_isPrime_of_surjective hsurj (by rw [hker]; exact (h01.trans h12).le)
    have hlt12 : Ideal.map mk P₁ < Ideal.map mk P₂ := by
      refine lt_of_le_of_ne (Ideal.map_mono h12.le) ?_
      intro e
      have := congrArg (Ideal.comap mk) e
      rw [hcm P₁ h01.le, hcm P₂ (h01.trans h12).le] at this
      exact h12.ne this
    have hlt01 : (⊥ : Ideal (A ⧸ P₀)) < Ideal.map mk P₁ := by
      refine lt_of_le_of_ne bot_le ?_
      intro e
      have := congrArg (Ideal.comap mk) e
      rw [hcm P₁ h01.le, ← RingHom.ker_eq_comap_bot, hker] at this
      exact h01.ne this
    haveI : IsDomain (A ⧸ P₀) := (Ideal.Quotient.isDomain_iff_prime P₀).mpr h0
    have hbotp : (⊥ : Ideal (A ⧸ P₀)).IsPrime := inferInstance
    have e1 := (Ideal.height_le_iff (p := Ideal.map mk P₂) (n := 1)).mp hht _ hp1 hlt12
    have e2 : (Ideal.map mk P₁).height = 0 := Order.lt_one_iff.mp e1
    have e3 := (Ideal.height_le_iff (p := Ideal.map mk P₁) (n := 0)).mp (le_of_eq e2) ⊥ hbotp hlt01
    exact (not_lt_zero e3)

  have s3 : ∀ (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), wcpaDjSemistable u → ∀ z₁ z₂ z₃ : Z,
      u z₃ ≠ IsLocalRing.closedPoint R → z₁ ⤳ z₂ → z₂ ⤳ z₃ → z₁ = z₂ ∨ z₂ = z₃ := by
    intro Z u hss z₁ z₂ z₃ hz3 h12 h23
    haveI := wcpa_dj_ldx_gen_open_immersion R
    have hoe : Topology.IsOpenEmbedding (Limits.pullback.fst u
        (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))))) :=
      (Limits.pullback.fst u (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))))).isOpenEmbedding
    have hrange := Scheme.Pullback.range_fst u
      (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))))
    have hjK : ∀ p : Spec (.of R), p ≠ IsLocalRing.closedPoint R →
        p ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := by
      intro p hp
      have hbot : p.asIdeal = ⊥ := by
        by_contra hne
        apply hp
        have hmax : p.asIdeal.IsMaximal := Ideal.IsPrime.isMaximal p.2 hne
        exact PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)
      obtain ⟨P, hP⟩ : ∃ P : Spec (.of (FractionRing R)), P.asIdeal = ⊥ :=
        ⟨(⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (FractionRing R)), rfl⟩
      refine ⟨P, ?_⟩
      apply PrimeSpectrum.ext
      rw [Spec.map_apply]
      change Ideal.comap _ P.asIdeal = p.asIdeal
      rw [hP, hbot]
      exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective R (FractionRing R))
    have h3 : z₃ ∈ Set.range (Limits.pullback.fst u
        (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))))) := by
      rw [hrange]; exact hjK _ hz3
    have h2 := h23.mem_open hoe.isOpen_range h3
    have h1 := h12.mem_open hoe.isOpen_range h2
    obtain ⟨w₁, rfl⟩ := h1
    obtain ⟨w₂, rfl⟩ := h2
    obtain ⟨w₃, rfl⟩ := h3
    have h12' := hoe.isInducing.specializes_iff.mp h12
    have h23' := hoe.isInducing.specializes_iff.mp h23
    have hss' := wcpa_dj_mm_semistable_basechange _ _ _
      (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) u hss
    rcases wcpa_dj_ldx_ncds_chain_short_special (FractionRing R) _ _ hss' w₁ w₂ w₃
      (Subsingleton.elim (α := PrimeSpectrum (FractionRing R)) _ _) h12' h23' with e | e
    · exact Or.inl (congrArg _ e)
    · exact Or.inr (congrArg _ e)

  have s4 : ∀ (C P' : Scheme.{u}) (g : C ⟶ P'), wcpaDjSemistable g → IsLocallyNoetherian P' →
      ∀ c : C, (∀ c' : C, c' ⤳ c → g c' = g c → c' = c) →
      ∃ W : C.Opens, c ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g) := by
    intro C P' g hss hP c hmin
    obtain ⟨W, hW, hgcW, -⟩ := exists_isAffineOpen_mem_and_subset (x := g c) (U := ⊤) trivial
    obtain ⟨V, hV, hcV, hVsub⟩ := exists_isAffineOpen_mem_and_subset (x := c) (U := g ⁻¹ᵁ W) hgcW
    have hle : V ≤ g ⁻¹ᵁ W := hVsub
    obtain ⟨Pc, hPc⟩ : ∃ P : Spec Γ(C, V), hV.fromSpec P = c :=
      ⟨_, hV.fromSpec_primeIdealOf ⟨c, hcV⟩⟩
    have hgf : ∀ P : Spec Γ(C, V), g (hV.fromSpec P) =
        hW.fromSpec (Spec.map (g.appLE W V hle) P) := by
      intro P
      rw [← Scheme.Hom.comp_apply, ← IsAffineOpen.SpecMap_appLE_fromSpec g hW hV hle,
        Scheme.Hom.comp_apply]
    have hinj : Function.Injective hV.fromSpec := by
      haveI := hV.isOpenImmersion_fromSpec
      exact hV.fromSpec.isOpenEmbedding.injective
    have hmin' : Pc.asIdeal ∈ (Ideal.map (g.appLE W V hle).hom
        (Pc.asIdeal.comap (g.appLE W V hle).hom)).minimalPrimes := by
      refine ⟨⟨Pc.2, Ideal.map_comap_le⟩, ?_⟩
      rintro Q ⟨hQ, hIQ⟩ hQ𝔭
      obtain ⟨PQ, rfl⟩ : ∃ P : Spec Γ(C, V), P.asIdeal = Q := ⟨⟨Q, hQ⟩, rfl⟩
      have hcomap : Ideal.comap (g.appLE W V hle).hom PQ.asIdeal =
          Ideal.comap (g.appLE W V hle).hom Pc.asIdeal :=
        le_antisymm (Ideal.comap_mono hQ𝔭) (Ideal.le_comap_map.trans (Ideal.comap_mono hIQ))
      have hspec : hV.fromSpec PQ ⤳ hV.fromSpec Pc :=
        ((PrimeSpectrum.le_iff_specializes PQ Pc).mp hQ𝔭).map hV.fromSpec.continuous
      have hg : g (hV.fromSpec PQ) = g (hV.fromSpec Pc) := by
        rw [hgf, hgf, Spec.map_apply, Spec.map_apply]
        congr 1
        apply PrimeSpectrum.ext
        exact hcomap
      rw [hPc] at hspec hg
      have e1 := hmin _ hspec hg
      rw [← hPc] at e1
      exact (congrArg PrimeSpectrum.asIdeal (hinj e1)).ge
    obtain ⟨W', hW', hsm⟩ := wcpa_dj_lcf_saj_fibre_minimal_smooth C P' g hss hP V W hle hV hW Pc hmin'
    rw [hPc] at hW'
    exact ⟨W', hW', hsm⟩

  have s2 : ∀ [IsLocallyNoetherian N] (uN : N ⟶ Spec (.of R)) (y x x₀ : N), y ⤳ x → x ⤳ x₀ →
      x ≠ x₀ → uN y ≠ IsLocalRing.closedPoint R → uN x = IsLocalRing.closedPoint R →
      (∀ w : N, y ⤳ w → w ⤳ x₀ → uN w ≠ IsLocalRing.closedPoint R → w = y) →
      (∀ w₁ w₂ : N, w₁ ⤳ w₂ → w₂ ⤳ x₀ → uN w₁ = IsLocalRing.closedPoint R → w₁ ≠ w₂ →
        w₂ ≠ x₀ → False) → False := by
    intro _ uN y x x₀ hyx hxx₀ hne hy hx ha hb
    classical
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hmϖ := (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have htest : ∀ p : PrimeSpectrum R, ϖ ∈ p.asIdeal ↔ p = IsLocalRing.closedPoint R := by
      intro p
      constructor
      · intro h
        apply PrimeSpectrum.ext
        apply le_antisymm (IsLocalRing.le_maximalIdeal p.2.ne_top)
        show IsLocalRing.maximalIdeal R ≤ p.asIdeal
        rw [hmϖ]; exact (Ideal.span_singleton_le_iff_mem _).mpr h
      · rintro rfl
        show ϖ ∈ IsLocalRing.maximalIdeal R
        rw [hmϖ]; exact Ideal.subset_span rfl
    have hgen3 : ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of R)) (x : X),
        X.fromSpecStalk x ≫ f =
          Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x trivial) := by
      intro X f x
      have h1 : f = X.toSpecΓ ≫ Spec.map f.appTop ≫ Spec.map (Scheme.ΓSpecIso (.of R)).inv := by
        have := Scheme.toSpecΓ_naturality f
        rw [← SpecMap_ΓSpecIso_hom] at this
        rw [← Category.assoc, ← this, Category.assoc, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
          Category.comp_id]
      conv_lhs => rw [h1]
      rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ, ← Spec.map_comp, ← Spec.map_comp,
        Category.assoc]
    have hT : ∀ P : Spec (N.presheaf.stalk x₀),
        ((Scheme.ΓSpecIso (.of R)).inv ≫ uN.appTop ≫ N.presheaf.germ ⊤ x₀ trivial).hom ϖ ∈
          P.asIdeal ↔ uN (N.fromSpecStalk x₀ P) = IsLocalRing.closedPoint R := by
      intro P
      have h1 : uN (N.fromSpecStalk x₀ P) = PrimeSpectrum.comap
          ((Scheme.ΓSpecIso (.of R)).inv ≫ uN.appTop ≫ N.presheaf.germ ⊤ x₀ trivial).hom P := by
        rw [← Scheme.Hom.comp_apply, hgen3 N uN x₀, Spec.map_apply]
      rw [h1]
      exact htest (PrimeSpectrum.comap
        ((Scheme.ΓSpecIso (.of R)).inv ≫ uN.appTop ≫ N.presheaf.germ ⊤ x₀ trivial).hom P)
    have hemb : Topology.IsEmbedding (N.fromSpecStalk x₀) := (N.fromSpecStalk x₀).isEmbedding
    have hsp : ∀ P P' : Spec (N.presheaf.stalk x₀),
        N.fromSpecStalk x₀ P ⤳ N.fromSpecStalk x₀ P' ↔ P.asIdeal ≤ P'.asIdeal := by
      intro P P'
      rw [hemb.isInducing.specializes_iff]
      exact (PrimeSpectrum.le_iff_specializes P P').symm
    have hcl : N.fromSpecStalk x₀ (IsLocalRing.closedPoint (N.presheaf.stalk x₀)) = x₀ :=
      Scheme.fromSpecStalk_closedPoint
    have hrng : ∀ w : N, w ⤳ x₀ → w ∈ Set.range (N.fromSpecStalk x₀) := by
      intro w hw
      rw [Scheme.range_fromSpecStalk]
      exact hw
    obtain ⟨Py, hPy⟩ := hrng y (hyx.trans hxx₀)
    obtain ⟨Px, hPx⟩ := hrng x hxx₀
    have hPxle : Px.asIdeal ≤ IsLocalRing.maximalIdeal (N.presheaf.stalk x₀) :=
      IsLocalRing.le_maximalIdeal Px.2.ne_top
    refine s1 (N.presheaf.stalk x₀)
      (((Scheme.ΓSpecIso (.of R)).inv ≫ uN.appTop ≫ N.presheaf.germ ⊤ x₀ trivial).hom ϖ)
      Py.asIdeal Px.asIdeal (IsLocalRing.maximalIdeal (N.presheaf.stalk x₀)) Py.2 Px.2
      inferInstance ?_ ?_ ?_ ?_
    · refine lt_of_le_of_ne ((hsp Py Px).mp (by rw [hPy, hPx]; exact hyx)) ?_
      intro e
      have e2 : Py = Px := PrimeSpectrum.ext e
      apply hy
      rw [← hPy, e2, hPx, hx]
    · refine lt_of_le_of_ne hPxle ?_
      intro e
      apply hne
      have e2 : Px = IsLocalRing.closedPoint (N.presheaf.stalk x₀) := PrimeSpectrum.ext e
      rw [← hPx, e2, hcl]
    · intro Q hQ hlt hle
      obtain ⟨PQ, rfl⟩ : ∃ P : Spec (N.presheaf.stalk x₀), P.asIdeal = Q := ⟨⟨Q, hQ⟩, rfl⟩
      by_contra htQ
      have hw := (hT PQ).not.mp htQ
      have h1 : y ⤳ N.fromSpecStalk x₀ PQ := by
        rw [← hPy]; exact (hsp Py PQ).mpr hlt.le
      have h2 : N.fromSpecStalk x₀ PQ ⤳ x₀ := by
        have h := (hsp PQ (IsLocalRing.closedPoint _)).mpr hle
        rw [hcl] at h; exact h
      have e := ha _ h1 h2 hw
      rw [← hPy] at e
      have e2 := congrArg PrimeSpectrum.asIdeal (hemb.injective e)
      exact hlt.ne e2.symm
    · intro Q₁ Q₂ hQ₁ hQ₂ ht hlt hlt2
      obtain ⟨P₁, rfl⟩ : ∃ P : Spec (N.presheaf.stalk x₀), P.asIdeal = Q₁ := ⟨⟨Q₁, hQ₁⟩, rfl⟩
      obtain ⟨P₂, rfl⟩ : ∃ P : Spec (N.presheaf.stalk x₀), P.asIdeal = Q₂ := ⟨⟨Q₂, hQ₂⟩, rfl⟩
      refine hb (N.fromSpecStalk x₀ P₁) (N.fromSpecStalk x₀ P₂) ((hsp P₁ P₂).mpr hlt.le) ?_
        ((hT P₁).mp ht) ?_ ?_
      · have h := (hsp P₂ (IsLocalRing.closedPoint _)).mpr hlt2.le
        rw [hcl] at h; exact h
      · intro e
        exact hlt.ne (congrArg PrimeSpectrum.asIdeal (hemb.injective e))
      · intro e
        have e' := e.trans hcl.symm
        exact hlt2.ne (congrArg PrimeSpectrum.asIdeal (hemb.injective e'))

  obtain ⟨-, -, -, hH, hS⟩ := hA
  obtain ⟨-, hst, -⟩ := hH
  have hss : wcpaDjSemistable u := hst.1
  obtain ⟨-, ⟨hνfin, -⟩, -, ⟨-, -, -, -, -, hlftN⟩, -, ⟨⟨V, hV, hVi⟩, -⟩, -, -, -, -,
    ⟨-, -, -, hmax, -⟩, -⟩ := hS
  haveI : IsFinite ν := hνfin
  haveI : LocallyOfFiniteType (q ≫ ν ≫ u) := hlftN
  haveI hNln : IsLocallyNoetherian N := LocallyOfFiniteType.isLocallyNoetherian (q ≫ ν ≫ u)
  have hdisc : ∀ a1 b1 : S, a1 ⤳ b1 → ν a1 = ν b1 → a1 = b1 := by
    intro a1 b1 hab he
    have hd := ν.isDiscrete_preimage_singleton (ν b1)
    haveI : DiscreteTopology ↥(⇑ν ⁻¹' {ν b1}) := hd.to_subtype
    have h1 : (⟨a1, he⟩ : ↥(⇑ν ⁻¹' {ν b1})) ⤳ ⟨b1, rfl⟩ :=
      Topology.IsInducing.subtypeVal.specializes_iff.mp hab
    exact congrArg Subtype.val h1.eq
  have hqinj : ∀ a1 b1 : N, q a1 ∈ V → q b1 ∈ V → q a1 = q b1 → a1 = b1 := by
    intro a1 b1 ha hb hab
    have key : ∀ c : (q ⁻¹ᵁ V).toScheme, V.ι ((q ∣_ V) c) = q ((q ⁻¹ᵁ V).ι c) := fun c => by
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
    obtain ⟨a', rfl⟩ : a1 ∈ Set.range (q ⁻¹ᵁ V).ι := by rw [Scheme.Opens.range_ι]; exact ha
    obtain ⟨b', rfl⟩ : b1 ∈ Set.range (q ⁻¹ᵁ V).ι := by rw [Scheme.Opens.range_ι]; exact hb
    have h1 : (q ∣_ V) a' = (q ∣_ V) b' := V.ι.isOpenEmbedding.injective (by rw [key, key, hab])
    have e : ∀ c, (inv (q ∣_ V)) ((q ∣_ V) c) = c := fun c => by
      rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]; rfl
    rw [← e a', ← e b', h1]

  have s5 : ∀ w : N, y ⤳ w → (q ≫ ν ≫ u) w ≠ IsLocalRing.closedPoint R → w = y := by
    intro w hyw hw
    by_contra hwy
    have hy' : (ν ≫ u) (q y) ≠ IsLocalRing.closedPoint R := by
      rwa [Scheme.Hom.comp_apply] at hy
    have hw' : (ν ≫ u) (q w) ≠ IsLocalRing.closedPoint R := by
      rwa [Scheme.Hom.comp_apply] at hw
    have hw'' : u (ν (q w)) ≠ IsLocalRing.closedPoint R := by
      rwa [Scheme.Hom.comp_apply] at hw'
    have hqne : q y ≠ q w := fun e => hwy (hqinj y w (hV _ hy') (hV _ hw') e).symm
    have hqs : q y ⤳ q w := hyw.map q.continuous
    have hνne : ν (q y) ≠ ν (q w) := fun e => hqne (hdisc _ _ hqs e)
    have hνs : ν (q y) ⤳ ν (q w) := hqs.map ν.continuous
    have hmin : ∀ c' : Z, c' ⤳ ν (q y) → u c' = u (ν (q y)) → c' = ν (q y) := by
      intro c' hc' _
      rcases s3 Z u hss c' (ν (q y)) (ν (q w)) hw'' hc' hνs with e | e
      · exact e
      · exact absurd e hνne
    obtain ⟨W, hW, hWsm⟩ := s4 Z (Spec (.of R)) u hss inferInstance (ν (q y)) hmin
    exact hsm ⟨W, hW, hWsm⟩

  by_contra hxc
  obtain ⟨x₀, hx₀, hx₀ne⟩ : ∃ x₀ ∈ closure ({x} : Set N), x₀ ≠ x := by
    by_contra hcon
    push Not at hcon
    exact hxc (isClosed_of_closure_subset (fun z hz => hcon z hz))
  have hxx₀ : x ⤳ x₀ := specializes_iff_mem_closure.mpr hx₀
  have hyx : y ⤳ x := specializes_iff_mem_closure.mpr hx
  have hNsc : IsClosed (⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R}) :=
    (IsLocalRing.isClosed_singleton_closedPoint R).preimage (q ≫ ν ≫ u).continuous
  refine s2 (q ≫ ν ≫ u) y x x₀ hyx hxx₀ (fun e => hx₀ne e.symm) hy hx0
    (fun w hyw _ hw => s5 w hyw hw) ?_
  intro w₁ w₂ h12 h2x hw₁ hne12 hne2
  have hL' : closure ({w₁} : Set N) ⊆ ⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R} :=
    closure_minimal (Set.singleton_subset_iff.mpr hw₁) hNsc
  have hLL' : closure ({w₂} : Set N) ⊆ closure {w₁} :=
    closure_minimal (Set.singleton_subset_iff.mpr (specializes_iff_mem_closure.mp h12))
      isClosed_closure
  have hnt : (closure ({w₂} : Set N)).Nontrivial :=
    ⟨w₂, subset_closure (Set.mem_singleton w₂), x₀, specializes_iff_mem_closure.mp h2x, hne2⟩
  have e := hmax (closure {w₂}) isClosed_closure isIrreducible_singleton.closure
    (hLL'.trans hL') hnt (closure {w₁}) isIrreducible_singleton.closure hLL' hL'
  exact hne12 (inseparable_iff_closure_eq.mpr e).eq

theorem wcpa_dj_nccw_eb_branch_injection : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ∃ f : Set N × N → PrimeSpectrum (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)), (∀ p ∈ nccwEbExV u ν q st zk, f p ∈ nccwEbBv R u ν zk) ∧ (∀ p ∈ nccwEbExH u ν q st zk, f p ∈ nccwEbBh R u ν zk) ∧ Set.InjOn f (nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk) :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA
  classical
  have hA' := hA
  obtain ⟨-, -, -, hH, hS⟩ := hA'
  obtain ⟨-, hst, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hp, hu, hz, -⟩ := hH
  obtain ⟨-, ⟨hνfin, -⟩, -, ⟨-, hlft, -⟩, ⟨hqp, -⟩, ⟨⟨V, hV, hVi⟩, -⟩, ⟨hνzk, -⟩, -, hZc, -,
    ⟨hNs, -, -, hmax, -⟩, -⟩ := hS
  have hss : wcpaDjSemistable u := hst.1
  have hzeq : ν zk = (ι ≫ Limits.pullback.fst u u') γ := hνzk.trans hp
  have hz' : IsClosed ({ν zk} : Set Z) := by rw [hzeq]; exact hz
  have huz : u (ν zk) = IsLocalRing.closedPoint R := by rw [hzeq]; exact hu
  haveI : IsFinite ν := hνfin
  haveI : LocallyOfFiniteType (ν ≫ u) := hlft
  haveI hSln : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian (ν ≫ u)

  have hdisc : ∀ a1 b1 : S, a1 ⤳ b1 → ν a1 = ν b1 → a1 = b1 := by
    intro a1 b1 hab he
    have hd := ν.isDiscrete_preimage_singleton (ν b1)
    haveI : DiscreteTopology ↥(⇑ν ⁻¹' {ν b1}) := hd.to_subtype
    have h1 : (⟨a1, he⟩ : ↥(⇑ν ⁻¹' {ν b1})) ⤳ ⟨b1, rfl⟩ :=
      Topology.IsInducing.subtypeVal.specializes_iff.mp hab
    exact congrArg Subtype.val h1.eq

  have hzkc : IsClosed ({zk} : Set S) := by
    apply isClosed_of_closure_subset
    intro w hw
    have hzw : zk ⤳ w := specializes_iff_mem_closure.mpr hw
    have h1 : ν w ∈ closure ({ν zk} : Set Z) :=
      specializes_iff_mem_closure.mp (hzw.map ν.continuous)
    rw [hz'.closure_eq] at h1
    exact (hdisc zk w hzw (Set.mem_singleton_iff.mp h1).symm).symm
  have hFc : IsClosed (⇑q ⁻¹' {zk}) := hzkc.preimage q.continuous

  have s1 : ∀ s : S, s ⤳ zk → s ≠ zk → ∃ W : S.Opens, s ∈ W ∧ IsIso (q ∣_ W) := by
    intro s hs hne
    by_cases hc : (ν ≫ u) s = IsLocalRing.closedPoint R
    · have huξ : u (ν s) = IsLocalRing.closedPoint R := by
        have := hc
        rwa [Scheme.Hom.comp_apply] at this
      have hξz : ν s ⤳ ν zk := hs.map ν.continuous
      have hmaxξ : ∀ x : Z, u x = IsLocalRing.closedPoint R → x ⤳ ν s → x = ν s := by
        intro x hx hxξ
        rcases wcpa_dj_ldx_ncds_chain_short_special R Z u hss x (ν s) (ν zk) hx hxξ hξz with e | e
        · exact e
        · exact absurd (hdisc s zk hs e) hne
      obtain ⟨-, -, -, -, hw, ⟨W, hW, hWi⟩, -⟩ := hZc (ν s) huξ hmaxξ
      refine ⟨W, ?_, hWi⟩
      rw [hw s rfl]
      exact hW
    · exact ⟨V, hV s hc, hVi⟩

  have hqinj : ∀ (W : S.Opens), IsIso (q ∣_ W) → ∀ a1 b1 : N, q a1 ∈ W → q b1 ∈ W →
      q a1 = q b1 → a1 = b1 := by
    intro W hW a1 b1 ha hb hab
    have key : ∀ c : (q ⁻¹ᵁ W).toScheme, W.ι ((q ∣_ W) c) = q ((q ⁻¹ᵁ W).ι c) := fun c => by
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
    obtain ⟨a', rfl⟩ : a1 ∈ Set.range (q ⁻¹ᵁ W).ι := by rw [Scheme.Opens.range_ι]; exact ha
    obtain ⟨b', rfl⟩ : b1 ∈ Set.range (q ⁻¹ᵁ W).ι := by rw [Scheme.Opens.range_ι]; exact hb
    have h1 : (q ∣_ W) a' = (q ∣_ W) b' := W.ι.isOpenEmbedding.injective (by rw [key, key, hab])
    have e : ∀ c, (inv (q ∣_ W)) ((q ∣_ W) c) = c := fun c => by
      rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]; rfl
    rw [← e a', ← e b', h1]

  have hgen3 : ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of R)) (x : X),
      X.fromSpecStalk x ≫ f =
        Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x trivial) := by
    intro X f x
    have h1 : f = X.toSpecΓ ≫ Spec.map f.appTop ≫ Spec.map (Scheme.ΓSpecIso (.of R)).inv := by
      have := Scheme.toSpecΓ_naturality f
      rw [← SpecMap_ΓSpecIso_hom] at this
      rw [← Category.assoc, ← this, Category.assoc, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
        Category.comp_id]
    conv_lhs => rw [h1]
    rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ, ← Spec.map_comp, ← Spec.map_comp,
      Category.assoc]
  have s3key : ∀ (φ : CommRingCat.of R ⟶ S.presheaf.stalk zk),
      S.fromSpecStalk zk ≫ (ν ≫ u) = Spec.map φ →
      ∀ (P : PrimeSpectrum (S.presheaf.stalk zk)) (r : R),
      φ.hom r ∈ P.asIdeal ↔ r ∈ ((ν ≫ u) (S.fromSpecStalk zk P)).asIdeal := by
    intro φ hφ P r
    have h1 : ∀ x : Spec (S.presheaf.stalk zk),
        (ν ≫ u) (S.fromSpecStalk zk x) = PrimeSpectrum.comap φ.hom x := by
      intro x
      rw [← Scheme.Hom.comp_apply, hφ, Spec.map_apply]
    rw [h1 P]
    exact Iff.rfl
  have s3 : ∀ (P : PrimeSpectrum (S.presheaf.stalk zk)) (r : R),
      ((Scheme.ΓSpecIso (.of R)).inv ≫ (ν ≫ u).appTop ≫ S.presheaf.germ ⊤ zk trivial).hom r ∈
        P.asIdeal ↔ r ∈ ((ν ≫ u) (S.fromSpecStalk zk P)).asIdeal :=
    s3key _ (hgen3 S (ν ≫ u) zk)
  have hsig : ∀ (β : PrimeSpectrum (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk))
      (S.presheaf.stalk zk))) (r : R), nccwEbSig R u ν zk r ∈ β.asIdeal ↔
      r ∈ ((ν ≫ u) (S.fromSpecStalk zk (PrimeSpectrum.comap (algebraMap (S.presheaf.stalk zk)
        (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)))
        β))).asIdeal := by
    intro β r
    have := s3 (PrimeSpectrum.comap (algebraMap (S.presheaf.stalk zk)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk))) β) r
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] at this
    unfold nccwEbSig
    rw [RingHom.comp_apply]
    exact this

  have hfirst : ∀ (β : PrimeSpectrum (AdicCompletion (IsLocalRing.maximalIdeal
      (S.presheaf.stalk zk)) (S.presheaf.stalk zk))),
      S.fromSpecStalk zk (PrimeSpectrum.comap (algebraMap (S.presheaf.stalk zk)
        (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)))
        β) ≠ zk →
      ∃ a ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk zk),
        algebraMap (S.presheaf.stalk zk)
          (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)) a ∉
          β.asIdeal := by
    intro β hβ
    by_contra hcon
    push_neg at hcon
    apply hβ
    have e : PrimeSpectrum.comap (algebraMap (S.presheaf.stalk zk)
        (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)))
        β = IsLocalRing.closedPoint _ := by
      ext1
      apply le_antisymm (IsLocalRing.le_maximalIdeal (PrimeSpectrum.comap _ β).2.ne_top)
      intro x hx
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
      exact hcon x hx
    rw [e, Scheme.fromSpecStalk_closedPoint]

  have s6 : ∀ (M T : Set N), TopologicalSpace.NoetherianSpace ↥M → T ⊆ M → IsClosed T →
      (∀ x ∈ T, IsClosed ({x} : Set N)) → T.Finite := by
    intro M T hM hTM hTc hcl
    haveI := hM
    haveI : TopologicalSpace.NoetherianSpace T :=
      (Topology.IsEmbedding.inclusion hTM).isInducing.noetherianSpace
    haveI : QuasiSober T := hTc.isClosedEmbedding_subtypeVal.quasiSober
    have hfin : (irreducibleComponents T).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    have hsub : ∀ C ∈ irreducibleComponents T, C.Subsingleton := by
      intro C hC
      obtain ⟨x, hx⟩ := QuasiSober.sober hC.1 (isClosed_of_mem_irreducibleComponents C hC)
      have e : closure ({x} : Set T) = C := hx
      have hxc : IsClosed ({x} : Set T) := by
        have h := (hcl x.1 x.2).preimage (continuous_subtype_val : Continuous (Subtype.val : T → N))
        convert h using 1
        ext y
        simp [Subtype.ext_iff]
      rw [← e, hxc.closure_eq]
      exact Set.subsingleton_singleton
    have h2 : (Set.univ : Set T).Finite := by
      rw [← sUnion_irreducibleComponents]
      exact hfin.sUnion (fun C hC => (hsub C hC).finite)
    have : Finite T := Set.finite_univ_iff.mp h2
    exact Set.toFinite T

  have hgex : ∀ p : Set N × N, ∃ y : N, IsIrreducible p.1 → IsClosed p.1 → closure {y} = p.1 :=
    fun p => by
      by_cases hc : IsIrreducible p.1 ∧ IsClosed p.1
      · obtain ⟨x, hx⟩ := QuasiSober.sober hc.1 hc.2
        exact ⟨x, fun _ _ => hx⟩
      · exact ⟨η₀, fun h1 h2 => absurd ⟨h1, h2⟩ hc⟩
  choose gen hgen using hgex

  have s7 : ∀ p ∈ nccwEbExV u ν q st zk ∪ nccwEbExH u ν q st zk,
      closure {gen p} = p.1 ∧ q (gen p) ⤳ zk ∧ q (gen p) ≠ zk ∧
      (closure {gen p} ∩ ⇑q ⁻¹' {zk}).Finite ∧
      (∀ g ∈ closure {gen p} ∩ ⇑q ⁻¹' {zk}, IsClosed ({g} : Set N)) ∧
      p.2 ∈ closure {gen p} ∩ ⇑q ⁻¹' {zk} := by
    intro p hp
    have hpEx : p ∈ nccwEx u ν q st zk := by
      rcases hp with hp | hp
      · exact hp.1
      · exact hp.1
    obtain ⟨⟨hJc, hJi, hJF, -⟩, hgJ, hgF⟩ := hpEx
    have hg' : closure {gen p} = p.1 := hgen p hJi hJc
    have hyF : gen p ∉ ⇑q ⁻¹' {zk} := by
      intro hy
      apply hJF
      rw [← hg']
      exact closure_minimal (Set.singleton_subset_iff.mpr hy) hFc
    have hyg : gen p ⤳ p.2 := by rw [specializes_iff_mem_closure, hg']; exact hgJ
    have hqs : q (gen p) ⤳ zk := by
      have := hyg.map q.continuous
      rwa [show q p.2 = zk from hgF] at this
    have hqne : q (gen p) ≠ zk := fun e => hyF e
    have hcl : ∀ g ∈ closure {gen p} ∩ ⇑q ⁻¹' {zk}, IsClosed ({g} : Set N) := by
      rintro x ⟨hx1, hx2⟩
      rcases hp with hV' | hH'
      · have hJs := hV'.2
        by_cases hnt : (closure ({x} : Set N)).Nontrivial
        · exfalso
          have hxJ : closure {x} ⊆ p.1 := by
            rw [← hg']
            exact closure_minimal (Set.singleton_subset_iff.mpr hx1) isClosed_closure
          have e := hmax (closure {x}) isClosed_closure isIrreducible_singleton.closure
            (hxJ.trans hJs) hnt p.1 hJi hxJ hJs
          have e3 : gen p = x := (inseparable_iff_closure_eq.mpr (hg'.trans e)).eq
          exact hyF (e3 ▸ hx2)
        · have hsub := Set.not_nontrivial_iff.mp hnt
          have e : closure ({x} : Set N) = {x} :=
            hsub.eq_singleton_of_mem (subset_closure (Set.mem_singleton x))
          rw [← e]
          exact isClosed_closure
      · obtain ⟨-, y', hy'1, hy'2, hJ'⟩ := hH'
        have e : gen p = y' := (inseparable_iff_closure_eq.mpr (hg'.trans hJ')).eq
        apply wcpa_dj_nccw_ebbi_horizontal_closed R Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ'
          ν ν' μ q q' st zk η₀ η ηZ hA y' hy'1 hy'2 x (by rw [← e]; exact hx1)
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, show q x = zk from hx2]
        exact huz
    have hfin : (closure {gen p} ∩ ⇑q ⁻¹' {zk}).Finite := by
      refine s6 (⇑(q ≫ ν ≫ u) ⁻¹' {IsLocalRing.closedPoint R}) _ hNs ?_
        (isClosed_closure.inter hFc) hcl
      intro x hx
      show (q ≫ ν ≫ u) x = IsLocalRing.closedPoint R
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, show q x = zk from hx.2]
      exact huz
    exact ⟨hg', hqs, hqne, hfin, hcl, ⟨by rw [hg']; exact hgJ, hgF⟩⟩

  have hB : ∀ y : N, ∃ β : N → PrimeSpectrum (AdicCompletion (IsLocalRing.maximalIdeal
      (S.presheaf.stalk zk)) (S.presheaf.stalk zk)),
      q y ⤳ zk → q y ≠ zk → (closure {y} ∩ ⇑q ⁻¹' {zk}).Finite →
      (∀ g ∈ closure {y} ∩ ⇑q ⁻¹' {zk}, IsClosed ({g} : Set N)) →
      (∀ g ∈ closure {y} ∩ ⇑q ⁻¹' {zk}, S.fromSpecStalk zk (PrimeSpectrum.comap
        (algebraMap (S.presheaf.stalk zk) (AdicCompletion (IsLocalRing.maximalIdeal
          (S.presheaf.stalk zk)) (S.presheaf.stalk zk))) (β g)) = q y) ∧
      Set.InjOn β (closure {y} ∩ ⇑q ⁻¹' {zk}) := by
    intro y
    by_cases hy : q y ⤳ zk ∧ q y ≠ zk ∧ (closure {y} ∩ ⇑q ⁻¹' {zk}).Finite ∧
        (∀ g ∈ closure {y} ∩ ⇑q ⁻¹' {zk}, IsClosed ({g} : Set N))
    · obtain ⟨β, hβ⟩ := wcpa_dj_nccw_ebbi_local_branches S N q hqp hSln zk s1 y hy.1 hy.2.1
        hy.2.2.1 hy.2.2.2
      exact ⟨β, fun _ _ _ _ => hβ⟩
    · exact ⟨fun _ => IsLocalRing.closedPoint _, fun h1 h2 h3 h4 => absurd ⟨h1, h2, h3, h4⟩ hy⟩
  choose Bf hBf using hB
  refine ⟨fun p => Bf (gen p) p.2, ?_, ?_, ?_⟩
  ·
    intro p hp
    obtain ⟨hg', hqs, hqne, hfin, hcl, hpT⟩ := s7 p (Or.inl hp)
    have hpt := (hBf (gen p) hqs hqne hfin hcl).1 p.2 hpT
    have hy0 : (q ≫ ν ≫ u) (gen p) = IsLocalRing.closedPoint R :=
      hp.2 (hg' ▸ subset_closure (Set.mem_singleton _))
    refine ⟨hfirst _ (by rw [hpt]; exact hqne), fun r hr => (hsig _ r).mpr ?_⟩
    rw [hpt, ← Scheme.Hom.comp_apply, hy0]
    exact hr
  ·
    intro p hp
    obtain ⟨hg', hqs, hqne, hfin, hcl, hpT⟩ := s7 p (Or.inr hp)
    have hpt := (hBf (gen p) hqs hqne hfin hcl).1 p.2 hpT
    obtain ⟨-, y', hy'1, hy'2, hJ'⟩ := hp
    have e : gen p = y' := (inseparable_iff_closure_eq.mpr (hg'.trans hJ')).eq
    have hne' : ¬ (IsLocalRing.maximalIdeal R ≤ ((ν ≫ u) (q (gen p))).asIdeal) := by
      intro hle
      apply hy'1
      rw [← e, Scheme.Hom.comp_apply q (ν ≫ u)]
      exact PrimeSpectrum.ext
        (le_antisymm (IsLocalRing.le_maximalIdeal ((ν ≫ u) (q (gen p))).2.ne_top) hle)
    obtain ⟨r, hr, hrn⟩ := Set.not_subset.mp hne'
    refine ⟨hfirst _ (by rw [hpt]; exact hqne), ⟨r, hr, fun hmem => ?_⟩, ?_⟩
    · have := (hsig _ r).mp hmem
      rw [hpt] at this
      exact hrn this
    · show ¬ nccwSm u (ν (S.fromSpecStalk zk (PrimeSpectrum.comap (algebraMap (S.presheaf.stalk zk)
        (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk zk)) (S.presheaf.stalk zk)))
        (Bf (gen p) p.2))))
      rw [hpt, e]
      exact hy'2
  ·
    intro p hp p' hp' hpp
    have hpp' : Bf (gen p) p.2 = Bf (gen p') p'.2 := hpp
    obtain ⟨hg, hqs, hqne, hfin, hcl, hpT⟩ := s7 p hp
    obtain ⟨hg', hqs', hqne', hfin', hcl', hpT'⟩ := s7 p' hp'
    have hB1 := hBf (gen p) hqs hqne hfin hcl
    have hB2 := hBf (gen p') hqs' hqne' hfin' hcl'
    have e1 : q (gen p) = q (gen p') := by
      rw [← hB1.1 p.2 hpT, ← hB2.1 p'.2 hpT', hpp']
    obtain ⟨W, hW, hWi⟩ := s1 _ hqs hqne
    have egen : gen p = gen p' := hqinj W hWi _ _ hW (by rw [← e1]; exact hW) e1
    have e2 : p.1 = p'.1 := by rw [← hg, ← hg', egen]
    have hpT'' : p'.2 ∈ closure {gen p} ∩ ⇑q ⁻¹' {zk} := by rw [egen]; exact hpT'
    have e3 : p.2 = p'.2 := hB1.2 hpT hpT'' (by rw [hpp', ← egen])
    exact Prod.ext e2 e3

theorem wcpa_dj_nccw_eb_count_smooth : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → nccwSm u (ν zk) → (nccwEbBv R u ν zk).Finite ∧ (nccwEbBv R u ν zk).ncard ≤ 1 :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA hsm
  classical

  have L3 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (A : Type u)
      [CommRing A] [IsLocalRing A] (σ : R →+* AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* PowerSeries R),
      e.toRingHom.comp σ = PowerSeries.C →
      {β : PrimeSpectrum (AdicCompletion (IsLocalRing.maximalIdeal A) A) |
        (∃ a ∈ IsLocalRing.maximalIdeal A,
          algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a ∉ β.asIdeal) ∧
        ∀ r ∈ IsLocalRing.maximalIdeal R, σ r ∈ β.asIdeal}.Subsingleton := by
    intro R _ _ _ A _ _ σ e he
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hm : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have hϖm : ϖ ∈ IsLocalRing.maximalIdeal R := by rw [hm]; exact Ideal.mem_span_singleton_self ϖ
    have hπs : Function.Surjective (PowerSeries.map (IsLocalRing.residue R)) :=
      PowerSeries.map_surjective _ IsLocalRing.residue_surjective
    have key : ∀ β : PrimeSpectrum (AdicCompletion (IsLocalRing.maximalIdeal A) A),
        (∃ a ∈ IsLocalRing.maximalIdeal A,
          algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a ∉ β.asIdeal) →
        (∀ r ∈ IsLocalRing.maximalIdeal R, σ r ∈ β.asIdeal) →
        Ideal.comap e.symm β.asIdeal = RingHom.ker (PowerSeries.map (IsLocalRing.residue R)) := by
      rintro β ⟨a, ha, haβ⟩ hσ
      have hP : (Ideal.comap e.symm β.asIdeal).IsPrime := Ideal.comap_isPrime _ _
      have hC : ∀ r ∈ IsLocalRing.maximalIdeal R,
          PowerSeries.C r ∈ Ideal.comap e.symm β.asIdeal := by
        intro r hr
        rw [Ideal.mem_comap]
        have h1 : e (σ r) = PowerSeries.C r := RingHom.congr_fun he r
        rw [← h1, RingEquiv.symm_apply_apply]
        exact hσ r hr
      have hK : RingHom.ker (PowerSeries.map (IsLocalRing.residue R)) ≤
          Ideal.comap e.symm β.asIdeal := by
        intro f hf
        have hcoef : ∀ n, PowerSeries.coeff n f ∈ Ideal.span {ϖ} := by
          intro n
          rw [← hm, ← IsLocalRing.residue_eq_zero_iff]
          have := congrArg (PowerSeries.coeff n) (RingHom.mem_ker.mp hf)
          simpa [PowerSeries.coeff_map] using this
        choose c hc using fun n => Ideal.mem_span_singleton'.mp (hcoef n)
        have hf' : f = PowerSeries.C ϖ * PowerSeries.mk c := by
          ext n
          rw [PowerSeries.coeff_C_mul, PowerSeries.coeff_mk, ← hc n, mul_comm]
        rw [hf']
        exact Ideal.mul_mem_right _ _ (hC ϖ hϖm)
      have hPne : Ideal.comap e.symm β.asIdeal ≠ IsLocalRing.maximalIdeal (PowerSeries R) := by
        intro hPM
        apply haβ
        have hnu : ¬ IsUnit (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) := by
          intro hu
          have h1 := hu.map (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1)
          have h2 : AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1
              (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) = 0 := by
            rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
              AdicCompletion.evalₐ_of, Ideal.Quotient.eq_zero_iff_mem, pow_one]
            exact ha
          rw [h2] at h1
          have h3 : (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ 1)) 1 = 0 := by
            rw [map_one]; exact (isUnit_zero_iff.mp h1).symm
          rw [Ideal.Quotient.eq_zero_iff_mem, pow_one] at h3
          exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h3)
        have hm' : e (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) ∈
            IsLocalRing.maximalIdeal (PowerSeries R) := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          apply hnu
          have := hu.map e.symm
          rwa [RingEquiv.symm_apply_apply] at this
        rw [← hPM, Ideal.mem_comap, RingEquiv.symm_apply_apply] at hm'
        exact hm'
      have hPb : (Ideal.map (PowerSeries.map (IsLocalRing.residue R))
          (Ideal.comap e.symm β.asIdeal)).IsPrime :=
        Ideal.map_isPrime_of_surjective hπs hK
      have hcm : Ideal.comap (PowerSeries.map (IsLocalRing.residue R))
          (Ideal.map (PowerSeries.map (IsLocalRing.residue R)) (Ideal.comap e.symm β.asIdeal)) =
          Ideal.comap e.symm β.asIdeal := by
        rw [Ideal.comap_map_of_surjective _ hπs, ← RingHom.ker_eq_comap_bot]
        exact sup_eq_left.mpr hK
      by_cases hb : Ideal.map (PowerSeries.map (IsLocalRing.residue R))
          (Ideal.comap e.symm β.asIdeal) = ⊥
      · rw [hb, ← RingHom.ker_eq_comap_bot] at hcm
        exact hcm.symm
      · haveI := hPb.isMaximal hb
        have hmax := Ideal.comap_isMaximal_of_surjective (PowerSeries.map (IsLocalRing.residue R)) hπs
          (K := Ideal.map (PowerSeries.map (IsLocalRing.residue R)) (Ideal.comap e.symm β.asIdeal))
        rw [hcm] at hmax
        exact absurd (IsLocalRing.eq_maximalIdeal hmax) hPne
    rintro β1 ⟨h1a, h1b⟩ β2 ⟨h2a, h2b⟩
    have e1 := key β1 h1a h1b
    have e2 := key β2 h2a h2b
    apply PrimeSpectrum.ext
    ext x
    have hx1 : x ∈ β1.asIdeal ↔ e x ∈ Ideal.comap e.symm β1.asIdeal := by
      rw [Ideal.mem_comap, RingEquiv.symm_apply_apply]
    have hx2 : x ∈ β2.asIdeal ↔ e x ∈ Ideal.comap e.symm β2.asIdeal := by
      rw [Ideal.mem_comap, RingEquiv.symm_apply_apply]
    rw [hx1, hx2, e1, e2]

  have evcompat : ∀ {A : Type u} [CommRing A] (I : Ideal A) {m n : ℕ} (hle : m ≤ n)
      (x : AdicCompletion I A),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I n x) =
        AdicCompletion.evalₐ I m x := by
    intro A _ I m n hle x
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    rw [show Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ n) (s.1 n)) =
      Ideal.Quotient.mk (I ^ m) (s.1 n) from Ideal.Quotient.factor_mk _ _]
    rw [Ideal.Quotient.eq]
    have h := AdicCompletion.AdicCauchySequence.mk_eq_mk hle s
    rw [Submodule.Quotient.eq] at h
    have h' : (I ^ m • ⊤ : Submodule A A) = I ^ m := by
      rw [smul_eq_mul, Ideal.mul_top]
    rw [h'] at h
    exact h

  have L2 : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      (φ : A ≃+* B), ∃ ψ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
        ψ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
          algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ a) := by
    intro A B _ _ _ _ φ
    have fp : ∀ (C : Type u) [CommRing C] (I : Ideal C) {m n : ℕ} (hle : m ≤ n) (y : C),
        Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ n) y) =
          Ideal.Quotient.mk (I ^ m) y :=
      fun C _ I m n hle y => Ideal.Quotient.factor_mk _ _
    have build : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
        (f : A →+* B) (hf : IsLocalRing.maximalIdeal A ≤
          Ideal.comap f (IsLocalRing.maximalIdeal B)),
        ∃ F : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B,
          ∀ n x, AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) n (F x) =
            Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) f
              ((Ideal.pow_right_mono hf n).trans (Ideal.le_comap_pow f n))
              (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x) := by
      intro A B _ _ _ _ f hf
      refine ⟨AdicCompletion.liftRingHom (IsLocalRing.maximalIdeal B)
        (fun n => (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) f
          ((Ideal.pow_right_mono hf n).trans (Ideal.le_comap_pow f n))).comp
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom) ?_, ?_⟩
      · intro m n hle
        ext x
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
        rw [← evcompat (IsLocalRing.maximalIdeal A) hle x]
        obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x)
        rw [← hy, Ideal.quotientMap_mk, fp, fp, Ideal.quotientMap_mk]
      · intro n x
        rw [AdicCompletion.evalₐ_liftRingHom]
        rfl
    have hle1 : IsLocalRing.maximalIdeal A ≤
        Ideal.comap (φ : A →+* B) (IsLocalRing.maximalIdeal B) := by
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
      intro hu; apply hx
      have := hu.map φ.symm
      simpa using this
    have hle2 : IsLocalRing.maximalIdeal B ≤
        Ideal.comap (φ.symm : B →+* A) (IsLocalRing.maximalIdeal A) := by
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
      intro hu; apply hx
      have := hu.map φ
      simpa using this
    obtain ⟨F, hF⟩ := build A B (φ : A →+* B) hle1
    obtain ⟨G, hG⟩ := build B A (φ.symm : B →+* A) hle2
    have hGF : ∀ x, G (F x) = x := by
      intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [hG, hF]
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x)
      rw [← hy, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      simp
    have hFG : ∀ x, F (G x) = x := by
      intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [hF, hG]
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) n x)
      rw [← hy, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      simp
    refine ⟨{ F with
      invFun := G
      left_inv := hGF
      right_inv := hFG }, ?_⟩
    intro a
    show F _ = _
    apply AdicCompletion.ext_evalₐ
    intro n
    rw [hF]
    simp [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Ideal.quotientMap_mk]

  have L1 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u)
      [CommRing B] [IsDomain B] [IsIntegrallyClosed B],
      (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* B) → IsDomain A ∧ IsIntegrallyClosed A := by
    intro A _ _ _ B _ _ _ g
    have hinj : Function.Injective
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) := by
      intro x y hxy
      apply AdicCompletion.of_injective (IsLocalRing.maximalIdeal A) A
      simpa [AdicCompletion.algebraMap_apply] using hxy
    haveI : IsDomain (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      Function.Injective.isDomain (g : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* B)
        g.injective
    haveI hAd : IsDomain A := Function.Injective.isDomain _ hinj
    haveI : IsIntegrallyClosed (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      IsIntegrallyClosed.of_equiv g.symm
    refine ⟨hAd, ?_⟩
    rw [isIntegrallyClosed_iff (FractionRing A)]
    intro x hx
    obtain ⟨⟨a, ⟨b, hb⟩⟩, rfl⟩ := IsLocalization.mk'_surjective (nonZeroDivisors A) x
    let ψ : FractionRing A →+*
        FractionRing (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      IsFractionRing.map hinj
    have e1 : ∀ y, ψ (algebraMap A (FractionRing A) y) =
        algebraMap _ (FractionRing (AdicCompletion (IsLocalRing.maximalIdeal A) A))
          (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) y) := fun y =>
      IsLocalization.map_eq _ _
    have hcomp : (algebraMap (AdicCompletion (IsLocalRing.maximalIdeal A) A)
        (FractionRing (AdicCompletion (IsLocalRing.maximalIdeal A) A))).comp
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) =
          ψ.comp (algebraMap A (FractionRing A)) := by
      ext y; simp only [RingHom.comp_apply]; rw [e1]
    have hψx := IsIntegral.map_of_comp_eq
      (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) ψ hcomp hx
    obtain ⟨c, hc⟩ := (isIntegrallyClosed_iff
      (FractionRing (AdicCompletion (IsLocalRing.maximalIdeal A) A))).mp inferInstance hψx
    have hspec := IsLocalization.mk'_spec (FractionRing A) a ⟨b, hb⟩
    have h2 : algebraMap _ (FractionRing (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (c * algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) b) =
        algebraMap _ (FractionRing (AdicCompletion (IsLocalRing.maximalIdeal A) A))
          (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) := by
      rw [map_mul, hc]
      have := congrArg ψ hspec
      rw [map_mul, e1, e1] at this
      exact this
    have h3 := IsFractionRing.injective (AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (FractionRing (AdicCompletion (IsLocalRing.maximalIdeal A) A)) h2
    have hmem : ∀ n : ℕ, ∃ cn : A, a - cn * b ∈ (IsLocalRing.maximalIdeal A) ^ n := by
      intro n
      obtain ⟨cn, hcn⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n c)
      refine ⟨cn, ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, hcn]
      have := congrArg (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n) h3
      rw [map_mul, AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply,
        Algebra.algebraMap_self, RingHom.id_apply, RingHom.id_apply, AdicCompletion.evalₐ_of,
        AdicCompletion.evalₐ_of] at this
      rw [this, sub_self]
    have hbot := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := A ⧸ Ideal.span {b})
      (IsLocalRing.maximalIdeal A) (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    have hamem : Ideal.Quotient.mk (Ideal.span {b}) a ∈
        (⨅ i : ℕ, (IsLocalRing.maximalIdeal A) ^ i •
          (⊤ : Submodule A (A ⧸ Ideal.span {b}))) := by
      rw [Submodule.mem_iInf]
      intro i
      obtain ⟨cn, hcn⟩ := hmem i
      have : Ideal.Quotient.mk (Ideal.span {b}) a =
          (a - cn * b) • (1 : A ⧸ Ideal.span {b}) := by
        rw [Algebra.smul_def, mul_one, Ideal.Quotient.algebraMap_eq, map_sub, map_mul,
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self b), mul_zero,
          sub_zero]
      rw [this]
      exact Submodule.smul_mem_smul hcn Submodule.mem_top
    rw [hbot, Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem] at hamem
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hamem
    refine ⟨d, IsLocalization.eq_mk'_iff_mul_eq.mpr ?_⟩
    rw [← map_mul, hd]

  obtain ⟨hcomp, halg, hPr, hH, hS⟩ := hA
  obtain ⟨-, hL, -⟩ := hPr
  obtain ⟨-, hst, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hp, hu, hz, -⟩ := hH
  obtain ⟨-, -, -, -, -, -, ⟨hQ7a, -⟩, -, -, -, -, -, ⟨-, hP12Z⟩⟩ := hS
  have hss : wcpaDjSemistable u := by unfold wcpaDjStablePtd at hst; exact hst.1
  have hprop : IsProper u := by unfold wcpaDjSemistable at hss; exact hss.2.1
  have hzeq := hQ7a.trans hp
  have hzu : u (ν zk) = IsLocalRing.closedPoint R := by rw [hzeq]; exact hu
  have hzc : IsClosed ({ν zk} : Set Z) := by rw [hzeq]; exact hz

  have hLs := hL R hcomp halg Z u hss (ν zk) hzu hzc
  obtain ⟨-, e, he⟩ := hLs.resolve_right (fun h2 => h2.1 hsm)

  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian u

  obtain ⟨hd, hic⟩ := L1 (Z.presheaf.stalk (ν zk)) (PowerSeries R) e
  obtain ⟨w, hw, hiso⟩ := hP12Z (ν zk) hd hic
  have hzw : zk = w := (hw zk).mp rfl
  subst hzw
  let φ : Z.presheaf.stalk (ν zk) ≃+* S.presheaf.stalk zk :=
    (asIso (ν.stalkMap zk)).commRingCatIsoToRingEquiv
  obtain ⟨Ψ, hΨ⟩ := L2 _ _ φ

  have key : ν.appTop ≫ S.presheaf.germ ⊤ zk trivial =
      Z.presheaf.germ ⊤ (ν zk) trivial ≫ ν.stalkMap zk :=
    (Scheme.Hom.germ_stalkMap ν ⊤ zk trivial).symm
  have L4cat : (Scheme.ΓSpecIso (.of R)).inv ≫ (ν ≫ u).appTop ≫ S.presheaf.germ ⊤ zk trivial =
      (Scheme.ΓSpecIso (.of R)).inv ≫ u.appTop ≫
        Z.presheaf.germ ⊤ (ν zk) trivial ≫ ν.stalkMap zk := by
    rw [← key, Scheme.Hom.comp_appTop, Category.assoc]
  have hres : ∀ r : R, (Z.presheaf.germ ⊤ (ν zk) trivial).hom (wcCnSigma u ⊤ r) =
      (Z.presheaf.germ ⊤ (ν zk) trivial).hom (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r)) := by
    intro r
    unfold wcCnSigma
    exact TopCat.Presheaf.germ_res_apply Z.presheaf
      (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)) (ν zk) (show ν zk ∈ (⊤ : Z.Opens) from trivial) _
  have L4 : ∀ r : R,
      ((Scheme.ΓSpecIso (.of R)).inv ≫ (ν ≫ u).appTop ≫ S.presheaf.germ ⊤ zk trivial).hom r =
        φ ((Z.presheaf.germ ⊤ (ν zk) trivial).hom (wcCnSigma u ⊤ r)) := by
    intro r
    rw [L4cat, hres r]
    rfl
  have hE : (Ψ.symm.trans e).toRingHom.comp (nccwEbSig R u ν zk) = PowerSeries.C := by
    refine RingHom.ext fun r => ?_
    have h1 : nccwEbSig R u ν zk r = algebraMap _ _
        (φ ((Z.presheaf.germ ⊤ (ν zk) trivial).hom (wcCnSigma u ⊤ r))) := by
      unfold nccwEbSig
      rw [RingHom.comp_apply, L4 r]
    show e (Ψ.symm (nccwEbSig R u ν zk r)) = PowerSeries.C r
    rw [h1, ← hΨ, RingEquiv.symm_apply_apply]
    exact RingHom.congr_fun he r
  have hsub : (nccwEbBv R u ν zk).Subsingleton :=
    L3 R (S.presheaf.stalk zk) (nccwEbSig R u ν zk) (Ψ.symm.trans e) hE
  exact ⟨hsub.finite, (Set.ncard_le_one hsub.finite).mpr (fun _ ha _ hb => hsub ha hb)⟩

theorem wcpa_dj_nccw_ebn_vertical_primes : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (c : R), c ∈ IsLocalRing.maximalIdeal R → ∃ Px Py : Ideal (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}), ∀ P : Ideal (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c}), P.IsPrime → (∀ r ∈ IsLocalRing.maximalIdeal R, Ideal.Quotient.mk _ (MvPowerSeries.C r) ∈ P) → (∃ t, t ∉ P ∧ ¬ IsUnit t) → P = Px ∨ P = Py :=
by
  intro R _ _ _ c hc
  classical
  obtain ⟨ϖ, hϖirr⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hm : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} := hϖirr.maximalIdeal_eq
  have hmem : ∀ r : R, r ∈ IsLocalRing.maximalIdeal R ↔ ϖ ∣ r := by
    intro r; rw [hm, Ideal.mem_span_singleton]
  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal R := (hmem ϖ).mpr dvd_rfl
  have hk : ∀ i j : Fin 2, i ≠ j → ∀ k : Fin 2, k = i ∨ k = j := by
    intro i j hij k
    have h1 := k.isLt
    have h2 := i.isLt
    have h3 := j.isLt
    have h4 : i.val ≠ j.val := fun h => hij (Fin.ext h)
    by_cases h : k.val = i.val
    · exact Or.inl (Fin.ext h)
    · exact Or.inr (Fin.ext (by omega))

  have s2 : ∀ (i j : Fin 2), i ≠ j → ∀ (g : MvPowerSeries (Fin 2) R),
      (∀ n : ℕ, ϖ ∣ MvPowerSeries.coeff (Finsupp.single j n) g) →
      ∃ a b : MvPowerSeries (Fin 2) R, g = MvPowerSeries.C ϖ * a + MvPowerSeries.X i * b := by
    intro i j hij g hg
    choose d hd using hg
    let a : MvPowerSeries (Fin 2) R := fun m => if m i = 0 then d (m j) else 0
    have hdiv : MvPowerSeries.X i ∣ g - MvPowerSeries.C ϖ * a := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hmi
      rw [map_sub, MvPowerSeries.coeff_C_mul]
      have hma : MvPowerSeries.coeff m a = d (m j) := by
        show (if m i = 0 then d (m j) else 0) = _
        rw [if_pos hmi]
      have hm' : Finsupp.single j (m j) = m := by
        ext k
        rcases hk i j hij k with rfl | rfl
        · simp [hij.symm, hmi]
        · simp
      have := hd (m j)
      rw [hm'] at this
      rw [hma, this, sub_self]
    obtain ⟨b, hb⟩ := hdiv
    exact ⟨a, b, by rw [← hb]; ring⟩

  have s3 : ∀ (j : Fin 2) (n₀ : ℕ) (g : MvPowerSeries (Fin 2) R), ∃ v : MvPowerSeries (Fin 2) R,
      MvPowerSeries.constantCoeff v = MvPowerSeries.coeff (Finsupp.single j n₀) g ∧
      ∀ n : ℕ, MvPowerSeries.coeff (Finsupp.single j n) (g - MvPowerSeries.X j ^ n₀ * v) =
        if n < n₀ then MvPowerSeries.coeff (Finsupp.single j n) g else 0 := by
    intro j n₀ g
    let v : MvPowerSeries (Fin 2) R := fun m => MvPowerSeries.coeff (m + Finsupp.single j n₀) g
    refine ⟨v, ?_, ?_⟩
    · rw [← MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
      show MvPowerSeries.coeff (0 + Finsupp.single j n₀) g = _
      rw [zero_add]
    · intro n
      have hle : Finsupp.single j n₀ ≤ Finsupp.single j n ↔ n₀ ≤ n := by
        rw [Finsupp.single_le_iff, Finsupp.single_eq_same]
      rw [map_sub, MvPowerSeries.X_pow_eq, MvPowerSeries.coeff_monomial_mul]
      by_cases hn : n < n₀
      · rw [if_neg (by rw [hle]; omega), if_pos hn, sub_zero]
      · rw [if_pos (by rw [hle]; omega), if_neg hn]
        show _ - 1 * MvPowerSeries.coeff (Finsupp.single j n - Finsupp.single j n₀ + Finsupp.single j n₀) g = 0
        rw [tsub_add_cancel_of_le (hle.mpr (by omega)), one_mul, sub_self]
  set I := Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c : MvPowerSeries (Fin 2) R)} with hI
  set mk := Ideal.Quotient.mk I with hmk
  refine ⟨Ideal.span {mk (MvPowerSeries.C ϖ), mk (MvPowerSeries.X 0)},
    Ideal.span {mk (MvPowerSeries.C ϖ), mk (MvPowerSeries.X 1)}, ?_⟩
  intro P hP hC ht
  have core : ∀ i j : Fin 2, i ≠ j → mk (MvPowerSeries.X i) ∈ P →
      P = Ideal.span {mk (MvPowerSeries.C ϖ), mk (MvPowerSeries.X i)} := by
    intro i j hij hxi
    have ha : Ideal.span {mk (MvPowerSeries.C ϖ), mk (MvPowerSeries.X i)} ≤ P := by
      rw [Ideal.span_le]
      intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact hC ϖ hϖm
      · exact hxi
    have hb : ∀ g : MvPowerSeries (Fin 2) R,
        (∀ n : ℕ, ϖ ∣ MvPowerSeries.coeff (Finsupp.single j n) g) →
        mk g ∈ Ideal.span {mk (MvPowerSeries.C ϖ), mk (MvPowerSeries.X i)} := by
      intro g hg
      obtain ⟨a, b, hab⟩ := s2 i j hij g hg
      rw [Ideal.mem_span_pair]
      exact ⟨mk a, mk b, by rw [hab, map_add, map_mul, map_mul]; ring⟩
    have hyP : mk (MvPowerSeries.X j) ∉ P := by
      intro hy
      obtain ⟨t, htP, htu⟩ := ht
      obtain ⟨g, rfl⟩ : ∃ g, mk g = t := Ideal.Quotient.mk_surjective t
      have h0 : ϖ ∣ MvPowerSeries.constantCoeff g := by
        rw [← hmem]
        by_contra hn
        apply htu
        exact (MvPowerSeries.isUnit_iff_constantCoeff.mpr
          (IsLocalRing.notMem_maximalIdeal.mp hn)).map _
      obtain ⟨v, -, hv⟩ := s3 j 1 g
      have hr : mk (g - MvPowerSeries.X j ^ 1 * v) ∈ P := by
        apply ha
        apply hb
        intro n
        rw [hv n]
        split_ifs with hn
        · have hn0 : n = 0 := by omega
          subst hn0
          rw [Finsupp.single_zero, MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
          exact h0
        · exact dvd_zero _
      apply htP
      have e : g = (g - MvPowerSeries.X j ^ 1 * v) + MvPowerSeries.X j ^ 1 * v := by ring
      rw [e, map_add, map_mul, map_pow]
      exact P.add_mem hr (P.mul_mem_right _ (by rw [pow_one]; exact hy))
    have hd : P ≤ Ideal.span {mk (MvPowerSeries.C ϖ), mk (MvPowerSeries.X i)} := by
      intro p hp
      obtain ⟨g, rfl⟩ : ∃ g, mk g = p := Ideal.Quotient.mk_surjective p
      apply hb
      by_contra hne
      have H : ∃ n, ¬ ϖ ∣ MvPowerSeries.coeff (Finsupp.single j n) g := not_forall.mp hne
      have hn₀ : ¬ ϖ ∣ MvPowerSeries.coeff (Finsupp.single j (Nat.find H)) g := Nat.find_spec H
      have hlt : ∀ n < Nat.find H, ϖ ∣ MvPowerSeries.coeff (Finsupp.single j n) g :=
        fun n hn => not_not.mp (Nat.find_min H hn)
      obtain ⟨v, hv0, hv⟩ := s3 j (Nat.find H) g
      have hr : mk (g - MvPowerSeries.X j ^ Nat.find H * v) ∈ P := by
        apply ha
        apply hb
        intro n
        rw [hv n]
        split_ifs with hn
        · exact hlt n hn
        · exact dvd_zero _
      have hxv : mk (MvPowerSeries.X j) ^ Nat.find H * mk v ∈ P := by
        have e : mk (MvPowerSeries.X j) ^ Nat.find H * mk v =
            mk g - mk (g - MvPowerSeries.X j ^ Nat.find H * v) := by
          rw [map_sub, map_mul, map_pow]; ring
        rw [e]
        exact P.sub_mem hp hr
      have hvu : IsUnit (mk v) := by
        apply IsUnit.map
        rw [MvPowerSeries.isUnit_iff_constantCoeff, hv0]
        apply IsLocalRing.notMem_maximalIdeal.mp
        rw [hmem]
        exact hn₀
      rw [Ideal.mul_unit_mem_iff_mem P hvu] at hxv
      exact hyP (hP.mem_of_pow_mem _ hxv)
    exact le_antisymm hd ha
  have hxy : mk (MvPowerSeries.X 0) * mk (MvPowerSeries.X 1) ∈ P := by
    have e : mk (MvPowerSeries.X 0) * mk (MvPowerSeries.X 1) = mk (MvPowerSeries.C c) := by
      rw [← map_mul, hmk, Ideal.Quotient.eq, hI]
      exact Ideal.mem_span_singleton_self _
    rw [e]
    exact hC c hc
  rcases hP.mem_or_mem hxy with h | h
  · exact Or.inl (core 0 1 (by decide) h)
  · exact Or.inr (core 1 0 (by decide) h)

theorem wcpa_dj_nccw_ebn_completion_domain : wcpaDjNccExcellent.{u} → ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), LocallyOfFiniteType u → ∀ z : Z, IsClosed ({z} : Set Z) → IsDomain (Z.presheaf.stalk z) → IsIntegrallyClosed (Z.presheaf.stalk z) → IsDomain (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) :=
by
  intro hE R _ _ _ hcomp Z u hu z hz hdom hic
  classical
  unfold wcpaDjNccExcellent at hE

  have fp : ∀ (C : Type u) [CommRing C] (I : Ideal C) {m n : ℕ} (hle : m ≤ n) (y : C),
      Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ n) y) =
        Ideal.Quotient.mk (I ^ m) y :=
    fun C _ I m n hle y => Ideal.Quotient.factor_mk _ _
  have evcompat : ∀ {A : Type u} [CommRing A] (I : Ideal A) {m n : ℕ} (hle : m ≤ n)
      (x : AdicCompletion I A),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I n x) =
        AdicCompletion.evalₐ I m x := by
    intro A _ I m n hle x
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    rw [show Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ n) (s.1 n)) =
      Ideal.Quotient.mk (I ^ m) (s.1 n) from Ideal.Quotient.factor_mk _ _]
    rw [Ideal.Quotient.eq]
    have h := AdicCompletion.AdicCauchySequence.mk_eq_mk hle s
    rw [Submodule.Quotient.eq] at h
    have h' : (I ^ m • ⊤ : Submodule A A) = I ^ m := by
      rw [smul_eq_mul, Ideal.mul_top]
    rw [h'] at h
    exact h

  have hU : ∀ {A : Type u} [CommRing A] (I : Ideal A) (a : AdicCompletion I A),
      (∀ n, IsUnit (AdicCompletion.evalₐ I n a)) → IsUnit a := by
    intro A _ I a ha
    let f : ∀ n, Localization.Away a →+* A ⧸ I ^ n := fun n =>
      IsLocalization.Away.lift (S := Localization.Away a) a
        (g := (AdicCompletion.evalₐ I n).toRingHom) (ha n)
    have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (f n) = f m := by
      intro m n hle
      apply IsLocalization.ringHom_ext (Submonoid.powers a)
      refine RingHom.ext fun x => ?_
      simp only [f, RingHom.comp_apply, IsLocalization.Away.lift_eq]
      exact evcompat I hle x
    let F := AdicCompletion.liftRingHom I f hf
    have hF : ∀ x, F (algebraMap _ (Localization.Away a) x) = x := by
      intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [AdicCompletion.evalₐ_liftRingHom]
      simp only [f, IsLocalization.Away.lift_eq]
      rfl
    have hunit : IsUnit (algebraMap _ (Localization.Away a) a) :=
      IsLocalization.Away.algebraMap_isUnit a
    have := hunit.map F
    rwa [hF] at this

  have hU' : ∀ {A : Type u} [CommRing A] [IsLocalRing A]
      (b : AdicCompletion (IsLocalRing.maximalIdeal A) A) (y : A),
      AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1 b = Ideal.Quotient.mk _ y →
      IsUnit y → IsUnit b := by
    intro A _ _ b y hb hy
    apply hU
    intro n
    obtain ⟨yn, hyn⟩ :=
      Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n b)
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [← hyn]
      have h0 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ 0) yn =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ 0) 1 := by
        rw [Ideal.Quotient.eq, pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      rw [h0, map_one]
      exact isUnit_one
    · have h1 := evcompat (IsLocalRing.maximalIdeal A) (show 1 ≤ n from hn) b
      rw [← hyn, hb, fp] at h1
      rw [Ideal.Quotient.eq, pow_one] at h1
      have hyn_unit : IsUnit yn := by
        apply IsLocalRing.notMem_maximalIdeal.mp
        intro hmem
        have h2 : yn - (yn - y) ∈ IsLocalRing.maximalIdeal A := Ideal.sub_mem _ hmem h1
        rw [sub_sub_cancel] at h2
        exact IsLocalRing.notMem_maximalIdeal.mpr hy h2
      rw [← hyn]
      exact hyn_unit.map _

  have hloc : ∀ (A : Type u) [CommRing A] [IsLocalRing A],
      IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
    intro A _ _
    haveI : Nontrivial (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
      refine ⟨⟨0, 1, fun h => ?_⟩⟩
      have h1 := congrArg (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1) h
      rw [map_zero, map_one] at h1
      have h2 : (1 : A) ∈ IsLocalRing.maximalIdeal A ^ 1 := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_one]
        exact h1.symm
      rw [pow_one] at h2
      exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
    apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
    intro a
    obtain ⟨y, hy⟩ :=
      Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1 a)
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self y with h | h
    · exact Or.inl (hU' a y hy.symm h)
    · refine Or.inr (hU' (1 - a) (1 - y) ?_ h)
      rw [map_sub, map_one, ← hy, map_sub, map_one]

  have L2 : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      (φ : A ≃+* B), Nonempty (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B) := by
    intro A B _ _ _ _ φ
    have build : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
        (f : A →+* B) (hf : IsLocalRing.maximalIdeal A ≤
          Ideal.comap f (IsLocalRing.maximalIdeal B)),
        ∃ F : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B,
          ∀ n x, AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) n (F x) =
            Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) f
              ((Ideal.pow_right_mono hf n).trans (Ideal.le_comap_pow f n))
              (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x) := by
      intro A B _ _ _ _ f hf
      refine ⟨AdicCompletion.liftRingHom (IsLocalRing.maximalIdeal B)
        (fun n => (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) f
          ((Ideal.pow_right_mono hf n).trans (Ideal.le_comap_pow f n))).comp
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom) ?_, ?_⟩
      · intro m n hle
        ext x
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
        rw [← evcompat (IsLocalRing.maximalIdeal A) hle x]
        obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x)
        rw [← hy, Ideal.quotientMap_mk, fp, fp, Ideal.quotientMap_mk]
      · intro n x
        rw [AdicCompletion.evalₐ_liftRingHom]
        rfl
    have hle1 : IsLocalRing.maximalIdeal A ≤
        Ideal.comap (φ : A →+* B) (IsLocalRing.maximalIdeal B) := by
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
      intro hu; apply hx
      have := hu.map φ.symm
      simpa using this
    have hle2 : IsLocalRing.maximalIdeal B ≤
        Ideal.comap (φ.symm : B →+* A) (IsLocalRing.maximalIdeal A) := by
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx
      intro hu; apply hx
      have := hu.map φ
      simpa using this
    obtain ⟨F, hF⟩ := build A B (φ : A →+* B) hle1
    obtain ⟨G, hG⟩ := build B A (φ.symm : B →+* A) hle2
    have hGF : ∀ x, G (F x) = x := by
      intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [hG, hF]
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n x)
      rw [← hy, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      simp
    have hFG : ∀ x, F (G x) = x := by
      intro x
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [hF, hG]
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal B) n x)
      rw [← hy, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      simp
    exact ⟨{ F with
      invFun := G
      left_inv := hGF
      right_inv := hFG }⟩

  have core : ∀ (B : Type u) [CommRing B] [Algebra R B], Algebra.FiniteType R B →
      ∀ (𝔪 : Ideal B) [𝔪.IsMaximal], IsDomain (Localization.AtPrime 𝔪) →
      IsIntegrallyClosed (Localization.AtPrime 𝔪) →
      IsDomain (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
        (Localization.AtPrime 𝔪)) := by
    intro B _ _ hft 𝔪 _ hLdom hLic
    haveI hLhloc := hloc (Localization.AtPrime 𝔪)
    have hprim : ∀ (P : Ideal (Localization.AtPrime 𝔪)) [P.IsPrime],
