    have h3 := Ideal.add_mem _ hp (Ideal.mem_map_of_mem (algebraMap A _) hpm)
    rwa [sub_add_cancel] at h3
  have hker' : RingHom.ker π = (IsLocalRing.maximalIdeal _).map ι := by
    rw [hπker, hmaxÂ, Ideal.map_map, hι]
  have hπι : π.comp ι = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp r) := by
    refine RingHom.ext fun b => ?_
    obtain ⟨a, ha⟩ := hÂres b
    have h1 : π (ι (b - algebraMap A _ a)) = 0 := by
      rw [← RingHom.mem_ker, hker']; exact Ideal.mem_map_of_mem ι ha
    have h2 : r (b - algebraMap A _ a) = 0 := by
      rw [← RingHom.mem_ker, hr_ker]; exact ha
    have h4 : ι (algebraMap A _ a) = algebraMap R _ (φ a) := RingHom.congr_fun hι a
    have h5 : π (algebraMap R _ (φ a)) =
        Ideal.Quotient.mk _ (MvPowerSeries.C (IsLocalRing.residue A a)) :=
      RingHom.congr_fun hπcomp a
    rw [map_sub, map_sub, sub_eq_zero] at h1
    rw [map_sub, sub_eq_zero] at h2
    show π (ι b) = Ideal.Quotient.mk _ (MvPowerSeries.C (r b))
    rw [h1, h2, h4, h5, hr_alg]
  obtain ⟨h, e, he⟩ := core _ _ ι hιflat r π hr_surj hr_ker hπsurj hker' hπι
  refine ⟨h, e, RingHom.ext fun a => ?_⟩
  have h4 : ι (algebraMap A _ a) = algebraMap R _ (φ a) := RingHom.congr_fun hι a
  show e (algebraMap R _ (φ a)) = Ideal.Quotient.mk _ (MvPowerSeries.C (algebraMap A _ a))
  rw [← h4]
  exact he _

theorem wcpa_dj_ldx_ncs_node_completion : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAdicComplete (IsLocalRing.maximalIdeal R) R → IsAlgClosed (IsLocalRing.ResidueField R) → ∀ (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), wcpaDjSemistable u → ∀ z : Z, u z = IsLocalRing.closedPoint R → (¬ ∃ W : Z.Opens, z ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ u)) → ∃ (c : R) (e : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z) ≃+* (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c})), c ∈ IsLocalRing.maximalIdeal R ∧ e.toRingHom.comp ((algebraMap (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))).comp ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤))) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro R _ _ _ hcomp halg Z u hss z hz hsm
  classical
  haveI : Flat u := hss.1
  haveI : IsProper u := hss.2.1
  haveI hlofp : LocallyOfFinitePresentation u := inferInstance
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian u

  have s7 : ∀ (T B : Type u) [CommRing T] [CommRing B] [Nontrivial B] (h : T)
      (e₀ : B ≃+* (MvPowerSeries (Fin 2) T ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h}))
      (θ : T ≃+* R) (ι : R →+* B) (κ : R →+* T),
      e₀.toRingHom.comp ι = (Ideal.Quotient.mk _).comp (MvPowerSeries.C.comp κ) →
      (∀ r, θ (κ r) = r) →
      ∃ (c : R) (e : B ≃+* (MvPowerSeries (Fin 2) R ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C c})),
        c ∈ IsLocalRing.maximalIdeal R ∧
          e.toRingHom.comp ι = (Ideal.Quotient.mk _).comp MvPowerSeries.C := by
    intro T B _ _ _ h e₀ θ ι κ he₀ hθ
    have hnu : ¬ IsUnit h := by
      intro hu
      have hu' : IsUnit (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h :
          MvPowerSeries (Fin 2) T) := by
        rw [MvPowerSeries.isUnit_iff_constantCoeff]
        simp only [map_sub, map_mul, MvPowerSeries.constantCoeff_X, MvPowerSeries.constantCoeff_C,
          mul_zero, zero_sub]
        exact hu.neg
      have htop := Ideal.span_singleton_eq_top.mpr hu'
      haveI : Subsingleton (MvPowerSeries (Fin 2) T ⧸
          Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h}) :=
        Ideal.Quotient.subsingleton_iff.mpr htop
      haveI : Subsingleton B := e₀.injective.subsingleton
      exact not_subsingleton B ‹_›
    have hc : θ h ∈ IsLocalRing.maximalIdeal R :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr
        (fun hu => hnu ((MulEquiv.isUnit_map θ).mp hu)))
    have h1 : (MvPowerSeries.map θ.toRingHom).comp (MvPowerSeries.map θ.symm.toRingHom) =
        RingHom.id (MvPowerSeries (Fin 2) R) := by
      rw [← MvPowerSeries.map_comp, RingEquiv.toRingHom_comp_symm_toRingHom, MvPowerSeries.map_id]
    have h2 : (MvPowerSeries.map θ.symm.toRingHom).comp (MvPowerSeries.map θ.toRingHom) =
        RingHom.id (MvPowerSeries (Fin 2) T) := by
      rw [← MvPowerSeries.map_comp, RingEquiv.symm_toRingHom_comp_toRingHom, MvPowerSeries.map_id]
    let Θ : MvPowerSeries (Fin 2) T ≃+* MvPowerSeries (Fin 2) R :=
      RingEquiv.ofRingHom (MvPowerSeries.map θ.toRingHom) (MvPowerSeries.map θ.symm.toRingHom) h1 h2
    have hΘ : ∀ f, Θ f = MvPowerSeries.map θ.toRingHom f := fun f => rfl
    have hΘgen : Θ (MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h) =
        MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (θ h) := by
      rw [hΘ, map_sub, map_mul, MvPowerSeries.map_X, MvPowerSeries.map_X, MvPowerSeries.map_C]
      rfl
    have hIJ : Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (θ h)} =
        Ideal.map Θ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h}) := by
      rw [Ideal.map_span, Set.image_singleton, hΘgen]
    let qE := Ideal.quotientEquiv
      (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h})
      (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (θ h)}) Θ hIJ
    refine ⟨θ h, e₀.trans qE, hc, ?_⟩
    have hq : ∀ x, qE (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (Θ x) := fun x => rfl
    refine RingHom.ext fun r => ?_
    have h3 : e₀ (ι r) = Ideal.Quotient.mk _ (MvPowerSeries.C (κ r)) := RingHom.congr_fun he₀ r
    show qE (e₀ (ι r)) = Ideal.Quotient.mk _ (MvPowerSeries.C r)
    rw [h3, hq, hΘ, MvPowerSeries.map_C]
    congr 2
    exact hθ r

  have hsmod : ∀ {T : Type u} [CommRing T] (I : Ideal T) (n : ℕ) (x y : T),
      (x ≡ y [SMOD I ^ n • (⊤ : Submodule T T)]) ↔ x - y ∈ I ^ n := by
    intro T _ I n x y
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
  have s2 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (E : R ≃+* A),
      ∃ θ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* R,
        ∀ r : R, θ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (E r)) = r := by
    intro A _ _ E
    have hmax : Ideal.map E (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv E)
    have hmem : ∀ (n : ℕ) (y : A),
        y ∈ IsLocalRing.maximalIdeal A ^ n ↔ E.symm y ∈ IsLocalRing.maximalIdeal R ^ n := by
      intro n y
      rw [← hmax, ← Ideal.map_pow, Ideal.symm_apply_mem_of_equiv_iff]
    have h1 : IsHausdorff (IsLocalRing.maximalIdeal A) A := ⟨fun y hy => by
      have h0 : E.symm y = 0 := by
        refine IsHausdorff.haus' (I := IsLocalRing.maximalIdeal R) (E.symm y) (fun n => ?_)
        apply (hsmod _ _ _ _).mpr
        rw [sub_zero]
        have h := (hsmod _ _ _ _).mp (hy n)
        rw [sub_zero] at h
        exact (hmem n y).mp h
      have h2 := congrArg E h0
      rwa [RingEquiv.apply_symm_apply, map_zero] at h2⟩
    have h2 : IsPrecomplete (IsLocalRing.maximalIdeal A) A := ⟨fun f hf => by
      obtain ⟨L, hL⟩ := IsPrecomplete.prec' (I := IsLocalRing.maximalIdeal R)
        (fun n => E.symm (f n)) (fun {m n} hmn => by
          have h := (hsmod _ _ _ _).mp (hf hmn)
          apply (hsmod _ _ _ _).mpr
          rw [← map_sub]
          exact (hmem m _).mp h)
      refine ⟨E L, fun n => ?_⟩
      apply (hsmod _ _ _ _).mpr
      rw [hmem, map_sub, RingEquiv.symm_apply_apply]
      exact (hsmod _ _ _ _).mp (hL n)⟩
    haveI hc : IsAdicComplete (IsLocalRing.maximalIdeal A) A :=
      { toIsHausdorff := h1, toIsPrecomplete := h2 }
    have hω : ∀ a : A, (AdicCompletion.ofAlgEquiv (IsLocalRing.maximalIdeal A)).symm
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) = a := by
      intro a
      rw [← (AdicCompletion.ofAlgEquiv (IsLocalRing.maximalIdeal A)).commutes a,
        AlgEquiv.symm_apply_apply]
      rfl
    refine ⟨(AdicCompletion.ofAlgEquiv (IsLocalRing.maximalIdeal A)).symm.toRingEquiv.trans
      E.symm, fun r => ?_⟩
    show E.symm ((AdicCompletion.ofAlgEquiv (IsLocalRing.maximalIdeal A)).symm
      (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (E r))) = r
    rw [hω]
    exact E.symm_apply_apply r

  have hbij : Function.Bijective
      (((Spec (.of R)).presheaf.germ ⊤ (u z) trivial).hom.comp
        (Scheme.ΓSpecIso (.of R)).inv.hom) := by
    have key : ∀ x : Spec (.of R), x = IsLocalRing.closedPoint R → Function.Bijective
        (((Spec (.of R)).presheaf.germ ⊤ x trivial).hom.comp
          (Scheme.ΓSpecIso (.of R)).inv.hom) := by
      rintro x rfl
      have h1 : (Spec (.of R)).presheaf.germ ⊤ (IsLocalRing.closedPoint R) trivial =
          (Scheme.ΓSpecIso (.of R)).hom ≫ (stalkClosedPointIso (.of R)).inv := by
        rw [← germ_stalkClosedPointIso_hom, Category.assoc, Iso.hom_inv_id, Category.comp_id]
      rw [← CommRingCat.hom_comp, h1, Iso.inv_hom_id_assoc]
      exact ConcreteCategory.bijective_of_isIso _
    exact key _ hz
  set ρ := ((Spec (.of R)).presheaf.germ ⊤ (u z) trivial).hom.comp
    (Scheme.ΓSpecIso (.of R)).inv.hom with hρ
  let E : R ≃+* (Spec (.of R)).presheaf.stalk (u z) := RingEquiv.ofBijective ρ hbij
  obtain ⟨θ, hθ⟩ := s2 _ E

  have hs0 : (Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤) =
      (u.stalkMap z).hom.comp ρ := by
    have h : u.appTop ≫ Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op ≫
        Z.presheaf.germ ⊤ z trivial =
        (Spec (.of R)).presheaf.germ ⊤ (u z) trivial ≫ u.stalkMap z := by
      have hres : Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op ≫
          Z.presheaf.germ ⊤ z trivial = Z.presheaf.germ ⊤ z trivial :=
        TopCat.Presheaf.germ_res Z.presheaf (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)) z
          (trivial : z ∈ (⊤ : Z.Opens))
      rw [hres]
      exact (Scheme.Hom.germ_stalkMap u ⊤ z trivial).symm
    have e := congrArg (fun f => ((Scheme.ΓSpecIso (.of R)).inv ≫ f).hom) h
    simp only [CommRingCat.hom_comp] at e
    exact e

  haveI := halg
  haveI hK : IsAlgClosed ((Spec (.of R)).residueField (u z)) :=
    IsAlgClosed.of_ringEquiv (IsLocalRing.ResidueField R) _ (IsLocalRing.ResidueField.mapEquiv E)

  have hpt : (Spec (.of R)).fromSpecResidueField (u z)
      (IsLocalRing.closedPoint ((Spec (.of R)).residueField (u z))) = u z :=
    Scheme.fromSpecResidueField_apply _ _
  obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := u)
    (g := (Spec (.of R)).fromSpecResidueField (u z)) z
    (IsLocalRing.closedPoint ((Spec (.of R)).residueField (u z))) hpt.symm
  haveI hK' : IsAlgClosed (IsLocalRing.ResidueField ((Spec (.of R)).presheaf.stalk (u z))) := hK
  rcases hss.2.2 ((Spec (.of R)).residueField (u z)) ((Spec (.of R)).fromSpecResidueField (u z)) w
    with hl | hr
  · exact absurd (wcpa_dj_mn_fibre_smooth _ Z u z w hss.1 hlofp hw hl) hsm
  obtain ⟨ε, hε⟩ := wcpa_dj_mn_fibre_bridge _ Z u z w hw hr

  obtain ⟨h, e₀, he₀⟩ := wcpa_dj_mn_node_deform _ _ (u.stalkMap z).hom inferInstance
    (Flat.stalkMap u z) ⟨ε, hε⟩

  obtain ⟨c, e, hc, he⟩ := s7 _ _ h e₀ θ
    ((algebraMap (Z.presheaf.stalk z)
      (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))).comp
      ((u.stalkMap z).hom.comp ρ))
    ((algebraMap ((Spec (.of R)).presheaf.stalk (u z))
      (AdicCompletion (IsLocalRing.maximalIdeal ((Spec (.of R)).presheaf.stalk (u z)))
        ((Spec (.of R)).presheaf.stalk (u z)))).comp ρ)
    (RingHom.ext fun r => RingHom.congr_fun he₀ (ρ r)) (fun r => hθ r)
  refine ⟨c, e, hc, ?_⟩
  rw [hs0]
  exact he

theorem wcpa_dj_ldx_nc_slots : wcpaDjNcLocStr.{u} :=
by
  intro R _ _ _ hcomp halg Z u hss z hz hzc
