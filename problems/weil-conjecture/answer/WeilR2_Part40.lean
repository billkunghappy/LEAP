        rw [hbot] at this
        exact hϖ0 this
      have hu : u' (Z'.fromSpecStalk ξ P) = IsLocalRing.closedPoint R := by
        rw [hKpt]
        exact PrimeSpectrum.ext hcm
      have hsp : Z'.fromSpecStalk ξ P ⤳ ξ := by
        have : Z'.fromSpecStalk ξ P ∈ Set.range ⇑(Z'.fromSpecStalk ξ) := ⟨P, rfl⟩
        rw [Scheme.range_fromSpecStalk] at this
        exact this
      have hy := (hmax _ hu hsp).trans (Scheme.fromSpecStalk_closedPoint (x := ξ)).symm
      have hP := (Z'.fromSpecStalk ξ).isEmbedding.injective hy
      exact congrArg PrimeSpectrum.asIdeal hP
    have hd : (Ideal.span {φ ϖ}).IsRadical := by
      have h1 : (Ideal.span {wcCnSigma u' W ϖ}).IsRadical :=
        (Ideal.isRadical_iff_quotient_reduced _).mpr
          (wcpa_dj_ldx_special_fibre_reduced R Z' u' hss' W hW' ϖ hϖ)
      have h2 := IsLocalization.map_radical (hW'.primeIdealOf ⟨ξ, hξW⟩).asIdeal.primeCompl
        (Z'.presheaf.stalk ξ) (Ideal.span {wcCnSigma u' W ϖ})
      rw [h1.radical, Ideal.map_span, Set.image_singleton, hσt] at h2
      rw [Ideal.IsRadical, ← h2]
    refine ⟨φ ϖ, hta, le_antisymm ?_ ?_⟩
    · intro x hx
      rw [← hd.radical, Ideal.radical_eq_sInf, Submodule.mem_sInf]
      rintro J ⟨hJ1, hJ2⟩
      rw [hc J hJ2 (hJ1 (Ideal.subset_span rfl))]
      exact hx
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact htb

  haveI hup : IsProper u := hss.2.1
  haveI hup' : IsProper u' := hss'.2.1
  haveI hZ'n : IsLocallyNoetherian Z' := LocallyOfFiniteType.isLocallyNoetherian u'
  obtain ⟨t, ht, hm⟩ := s2
  obtain ⟨hdom, hdvr⟩ := s1 (Z'.presheaf.stalk ξ) t ht hm
  haveI := hdom
  haveI := hdvr
  haveI ha' : IsOpenImmersion a' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb'.flip
