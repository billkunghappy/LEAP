    have hD : ∀ t : (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField A) ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        ∃ (s : S) (t₁ t₂ : (MvPowerSeries (Fin 2) (IsLocalRing.ResidueField A) ⧸
