      rw [Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
      have hc := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn c
      rw [Submodule.Quotient.eq] at hc
      have e0 : I ^ m • (⊤ : Submodule O O) = I ^ m := by
        rw [smul_eq_mul, Ideal.mul_top]
      rw [e0] at hc
      exact hc
    have transport : ∀ (O O' : Type u) [CommRing O] [CommRing O'] (I : Ideal O) (J : Ideal O')
        (φ : O ≃+* O'), J = Ideal.map φ I →
        ∃ Φ : AdicCompletion I O ≃+* AdicCompletion J O',
          ∀ x, Φ (algebraMap O _ x) = algebraMap O' _ (φ x) := by
      intro O O' _ _ I J φ hJ
      have hJn : ∀ n : ℕ, J ^ n = Ideal.map φ (I ^ n) := fun n => by rw [Ideal.map_pow, hJ]
      have hIn : ∀ n : ℕ, I ^ n = Ideal.map φ.symm (J ^ n) := fun n => by
        rw [hJn]
        ext x
        rw [Ideal.map_symm, Ideal.mem_comap, Ideal.mem_map_of_equiv]
        constructor
        · intro hx; exact ⟨x, hx, rfl⟩
        · rintro ⟨y, hy, hxy⟩; rw [← φ.injective hxy]; exact hy
      let qq : ∀ n : ℕ, O ⧸ I ^ n ≃+* O' ⧸ J ^ n := fun n => Ideal.quotientEquiv _ _ φ (hJn n)
      let qq' : ∀ n : ℕ, O' ⧸ J ^ n ≃+* O ⧸ I ^ n := fun n =>
        Ideal.quotientEquiv _ _ φ.symm (hIn n)
      have hq : ∀ n x, qq n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (φ x) := fun n x =>
        Ideal.quotientEquiv_mk _ _ _ _ _
      have hq' : ∀ n x, qq' n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (φ.symm x) :=
        fun n x => Ideal.quotientEquiv_mk _ _ _ _ _
      have hF : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow J hle).comp
          ((qq n).toRingHom.comp (AdicCompletion.evalₐ I n).toRingHom) =
          (qq m).toRingHom.comp (AdicCompletion.evalₐ I m).toRingHom := by
        intro m n hle
        rw [← factorPow_evalₐ O I hle, ← RingHom.comp_assoc, ← RingHom.comp_assoc]
        congr 1
        apply Ideal.Quotient.ringHom_ext
        ext x
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hq,
          Ideal.Quotient.factor_mk]
      have hG : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp
          ((qq' n).toRingHom.comp (AdicCompletion.evalₐ J n).toRingHom) =
          (qq' m).toRingHom.comp (AdicCompletion.evalₐ J m).toRingHom := by
        intro m n hle
        rw [← factorPow_evalₐ O' J hle, ← RingHom.comp_assoc, ← RingHom.comp_assoc]
        congr 1
        apply Ideal.Quotient.ringHom_ext
        ext x
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, hq',
          Ideal.Quotient.factor_mk]
      let F := AdicCompletion.liftRingHom J _ hF
      let G := AdicCompletion.liftRingHom I _ hG
      have hFe : ∀ n x, AdicCompletion.evalₐ J n (F x) = qq n (AdicCompletion.evalₐ I n x) :=
        fun n x => AdicCompletion.evalₐ_liftRingHom J _ hF n x
      have hGe : ∀ n x, AdicCompletion.evalₐ I n (G x) = qq' n (AdicCompletion.evalₐ J n x) :=
        fun n x => AdicCompletion.evalₐ_liftRingHom I _ hG n x
      have hqq : ∀ n y, qq' n (qq n y) = y := by
        intro n y
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
        rw [hq, hq', RingEquiv.symm_apply_apply]
      have hqq' : ∀ n y, qq n (qq' n y) = y := by
        intro n y
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
        rw [hq', hq, RingEquiv.apply_symm_apply]
      refine ⟨RingEquiv.ofRingHom F G ?_ ?_, ?_⟩
      · refine RingHom.ext fun x => ?_
        apply AdicCompletion.ext_evalₐ
        intro n
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hFe, hGe, hqq']
      · refine RingHom.ext fun x => ?_
        apply AdicCompletion.ext_evalₐ
        intro n
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hGe, hFe, hqq]
      · intro x
        apply AdicCompletion.ext_evalₐ
        intro n
        show AdicCompletion.evalₐ J n (F _) = _
        rw [hFe]
        simp [hq]
    set 𝔪 := (hW.primeIdealOf ⟨s, hs⟩).asIdeal with h𝔪
    letI : Algebra Γ(S, W) (S.presheaf.stalk s) := (S.presheaf.germ W s hs).hom.toAlgebra
    haveI : IsLocalization.AtPrime (S.presheaf.stalk s) 𝔪 := hW.isLocalization_stalk ⟨s, hs⟩
    let φ := IsLocalization.algEquiv 𝔪.primeCompl (Localization.AtPrime 𝔪) (S.presheaf.stalk s)
    have hmax : IsLocalRing.maximalIdeal (S.presheaf.stalk s) =
        Ideal.map φ.toRingEquiv (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪)) := by
      haveI : (Ideal.map φ.toRingEquiv (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))).IsMaximal :=
