      (∀ a b, Function.Injective (h.app (W a ⊓ W b)).hom) →
      wcpaP1rRawH1 (fun a => h ⁻¹ᵁ W a) → wcpaP1rRawH1 W := by
    intro X' X h m W hs hi hW c hc
    obtain ⟨β, hβ⟩ := hW (fun a b => (h.app (W a ⊓ W b)).hom (c a b)) (by
      intro a b d
      have e := congrArg (h.app (W a ⊓ W b ⊓ W d)).hom (hc a b d)
      rw [map_add, hnat h, hnat h, hnat h] at e
      exact e)
    choose β' hβ' using fun a => hs a (β a)
    refine ⟨β', fun a b => ?_⟩
    apply hi a b
    rw [map_sub, hnat h, hnat h, hβ', hβ']
    exact hβ a b

  have hbij : ∀ (X : Scheme.{u}) (O W : X.Opens), W ≤ O → Function.Bijective (O.ι.app W).hom := by
    intro X O W hWO
    rw [Scheme.Opens.ι_app]
    have h2 : W ≤ O.ι ''ᵁ (O.ι ⁻¹ᵁ W) := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact le_inf hWO le_rfl
    have h1 : O.ι ''ᵁ (O.ι ⁻¹ᵁ W) ≤ W := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
      exact inf_le_right
    haveI : IsIso (X.presheaf.map (homOfLE h1).op) :=
      ⟨⟨X.presheaf.map (homOfLE h2).op,
        (X.presheaf.map_comp _ _).symm.trans (X.presheaf.map_id _),
        (X.presheaf.map_comp _ _).symm.trans (X.presheaf.map_id _)⟩⟩
    exact ConcreteCategory.bijective_of_isIso (X.presheaf.map (homOfLE h1).op)

  have hcov8 : ∀ (O : Z.Opens), ∃ (n : ℕ) (P : Fin n → Z.Opens),
      (∀ κ, IsAffineOpen (P κ)) ∧ (∀ κ, P κ ≤ O) ∧ (⨆ κ, P κ) = O := by
    intro O
    have hc : IsCompact (O : Set Z) := TopologicalSpace.NoetherianSpace.isCompact _
    obtain ⟨s, hs, hO⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hc
    refine ⟨hs.toFinset.card, fun κ => ((hs.toFinset.equivFin.symm κ).1 : Z.Opens),
      fun κ => (hs.toFinset.equivFin.symm κ).1.2, ?_, ?_⟩
    · intro κ
      rw [hO]
      exact le_iSup₂_of_le (hs.toFinset.equivFin.symm κ).1
        (hs.mem_toFinset.1 (hs.toFinset.equivFin.symm κ).2) le_rfl
    · rw [hO]
      apply le_antisymm
      · exact iSup_le fun κ => le_iSup₂_of_le (hs.toFinset.equivFin.symm κ).1
          (hs.mem_toFinset.1 (hs.toFinset.equivFin.symm κ).2) le_rfl
      · refine iSup₂_le fun i hi => le_iSup_of_le (hs.toFinset.equivFin ⟨i, hs.mem_toFinset.2 hi⟩) ?_
        simp only [Equiv.symm_apply_apply]
        exact le_rfl

  intro L hL
  obtain ⟨-, hcov, -, -⟩ := hL
  apply tw_of_raw Z L
  refine wcpa_dj_p1r_fm_cover_change Z L.V (fun a => g ⁻¹ᵁ V a) ?_ ?_ ?_
  · show (⨆ j, L.V j) = ⨆ a, g ⁻¹ᵁ V a
    rw [hcov, ← Scheme.Hom.preimage_iSup, hV, Scheme.Hom.preimage_top]
  · exact pull Z Y g V (fun a b => (hP1 _).2) (fun a b d => (hP1 _).1) (raw_of_tw Y V hY)
  · intro a
    obtain ⟨n, P, hPaff, hPle, hPsup⟩ := hcov8 (g ⁻¹ᵁ V a)
    refine wcpa_dj_p1r_fm_cover_change Z (fun j => L.V j ⊓ g ⁻¹ᵁ V a) P ?_ ?_ ?_
    · show (⨆ j, L.V j ⊓ g ⁻¹ᵁ V a) = ⨆ κ, P κ
      rw [← iSup_inf_eq, hcov, top_inf_eq, hPsup]
    ·
      have hOK : wcpaDjCocOK (⟨n, fun κ => (g ⁻¹ᵁ V a).ι ⁻¹ᵁ P κ, fun _ _ => 1⟩ :
          wcpaDjCoc (g ⁻¹ᵁ V a).toScheme) := by
        refine ⟨fun κ => ?_, ?_, fun _ => rfl, fun _ _ _ => by simp⟩
        · have e : (g ⁻¹ᵁ V a).ι ''ᵁ ((g ⁻¹ᵁ V a).ι ⁻¹ᵁ P κ) = P κ := by
            rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
            exact inf_eq_right.mpr (hPle κ)
          have hA := hPaff κ
          rw [← e] at hA
          exact (Scheme.Hom.isAffineOpen_iff_of_isOpenImmersion (g ⁻¹ᵁ V a).ι).mp hA
        · show (⨆ κ, (g ⁻¹ᵁ V a).ι ⁻¹ᵁ P κ) = ⊤
          rw [← Scheme.Hom.preimage_iSup, hPsup, Scheme.Opens.ι_preimage_self]
      have H := raw_of_tw _ (fun κ => (g ⁻¹ᵁ V a).ι ⁻¹ᵁ P κ) (hloc a _ hOK)
      exact push _ Z (g ⁻¹ᵁ V a).ι P (fun κ => (hbij Z _ (P κ) (hPle κ)).2)
        (fun κ κ' => (hbij Z _ (P κ ⊓ P κ') (inf_le_left.trans (hPle κ))).1) H
    · intro κ
      refine wcpa_dj_p1r_fm_affine_cover Z (P κ) (hPaff κ)
        (fun j => L.V j ⊓ g ⁻¹ᵁ V a ⊓ P κ) (fun j => inf_le_right) ?_
      show (⨆ j, L.V j ⊓ g ⁻¹ᵁ V a ⊓ P κ) = P κ
      rw [← iSup_inf_eq, ← iSup_inf_eq, hcov, top_inf_eq]
      exact inf_eq_right.mpr (hPle κ)

theorem fexr_affine_h1 : ∀ (X : Scheme.{u}), IsAffine X → wcpaDjFexH1 X :=
by
  intro X hX L hL
  haveI := hX
  obtain ⟨_, hcov, _, _⟩ := hL
  have R : wcpaP1rRawH1 L.V :=
    wcpa_dj_p1r_fm_affine_cover X ⊤ (isAffineOpen_top X) L.V (fun _ => le_top) hcov
  have hres : ∀ {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hid : ∀ {A : X.Opens} (h : A ≤ A) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro A h x
    have e0 : X.presheaf.map (homOfLE h).op = 𝟙 _ := by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op A) from rfl, X.presheaf.map_id]
    rw [e0]
    rfl
  have hM : ∀ {A B : X.Opens} (h : B ≤ A) (x : Γ(X, A)),
      ((wcStructMod X).presheaf.map (homOfLE h).op).hom x =
        (X.presheaf.map (homOfLE h).op).hom x :=
    fun _ _ => rfl
  have key : ∀ c0 : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b ⊓ ⊤),
      (∀ a b d,
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V d ⊓ ⊤ from
          inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_left))).op).hom (c0 a d) =
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d ⊓ ⊤ from
          inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_right))).op).hom (c0 b d) +
        (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c0 a b)) →
