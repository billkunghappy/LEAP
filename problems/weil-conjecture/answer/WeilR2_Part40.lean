    obtain ⟨Ψb, hΨb⟩ : ∃ Ψb : (MvPowerSeries (Fin 2) S ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h}) →ₐ[S] B,
