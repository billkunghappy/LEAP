    haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback u' ρ) :=
      AlgebraicGeometry.IsNoetherian.mk
    infer_instance
  have hmem : ∀ x' : Z', u' x' = IsLocalRing.closedPoint R ↔ x' ∈ Set.range ⇑f := by
    intro x'
    rw [C2]
    exact Iff.rfl
  have hi := C1.isInducing
  have hinj := C1.isEmbedding.injective
  refine ⟨C1, C2, C3, ?_, ?_⟩
  · intro X hX
    have hXc : IsClosed X := isClosed_of_mem_irreducibleComponents X hX
    obtain ⟨x, hx⟩ := QuasiSober.sober hX.1 hXc
    have hcx : closure {x} = X := hx.def
    refine ⟨x, hcx, ?_⟩
    intro x' hx' hsp
    obtain ⟨y, rfl⟩ := (hmem x').mp hx'
    have hyx : y ⤳ x := hi.specializes_iff.mp hsp
    have h1 : X ⊆ closure {y} := by
      rw [← hcx]
