theorem wcpa_dj_lsi_generic_lfp : ∀ (T Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral T] (g : Z ⟶ T), QuasiCompact g → LocallyOfFiniteType g → ∃ U : T.Opens, U ≠ ⊥ ∧ LocallyOfFinitePresentation (g ∣_ U) :=
by
  classical

  have s1 : ∀ (A : Type u) [CommRing A] (n : ℕ) (I : Ideal (MvPolynomial (Fin n) A)),
      ∃ (m : ℕ) (h : Fin m → MvPolynomial (Fin n) A), (∀ j, h j ∈ I) ∧ (∀ j, h j ≠ 0) ∧
        ∀ q ∈ I, q ≠ 0 → ∃ j, (MonomialOrder.lex : MonomialOrder (Fin n)).degree (h j) ≤
          (MonomialOrder.lex : MonomialOrder (Fin n)).degree q := by
    intro A _ n I
    set o := (MonomialOrder.lex : MonomialOrder (Fin n)) with ho
    let E : Set (Fin n →₀ ℕ) := {e | ∃ q ∈ I, q ≠ 0 ∧ o.degree q = e}
    have hpwo : E.IsPWO := Set.isPWO_of_wellQuasiOrderedLE E
    have hMfin : {e | Minimal (· ∈ E) e}.Finite :=
      (setOfPred_minimal_antichain _).finite_of_partiallyWellOrderedOn
        (hpwo.mono (fun e he => he.1))
    obtain ⟨m, f, -, hf⟩ := hMfin.fin_param
    have hfE : ∀ j, f j ∈ E := fun j => by
      have : f j ∈ {e | Minimal (· ∈ E) e} := hf ▸ ⟨j, rfl⟩
      exact this.1
    choose q hqI hq0 hqd using hfE
    refine ⟨m, q, hqI, hq0, ?_⟩
    intro p hp hp0
    obtain ⟨b, hb, hbmin⟩ := hpwo.exists_le_minimal (a := o.degree p) ⟨p, hp, hp0, rfl⟩
    have hbr : b ∈ Set.range f := hf ▸ hbmin
    obtain ⟨j, rfl⟩ := hbr
    exact ⟨j, (hqd j).symm ▸ hb⟩

  have s2 : ∀ (A : Type u) [CommRing A] (n : ℕ) (I : Ideal (MvPolynomial (Fin n) A)) (m : ℕ)
      (h : Fin m → MvPolynomial (Fin n) A), (∀ j, h j ∈ I) →
      (∀ q ∈ I, q ≠ 0 → ∃ j, (MonomialOrder.lex : MonomialOrder (Fin n)).degree (h j) ≤
          (MonomialOrder.lex : MonomialOrder (Fin n)).degree q) →
      ∀ q ∈ I, ∃ k : ℕ, MvPolynomial.C
        ((∏ j, (MonomialOrder.lex : MonomialOrder (Fin n)).leadingCoeff (h j)) ^ k) * q ∈
        Ideal.span (Set.range h) := by
    intro A _ n I m h hI hcov
    set o := (MonomialOrder.lex : MonomialOrder (Fin n)) with ho
    suffices H : ∀ s : o.syn, ∀ q ∈ I, o.toSyn (o.degree q) = s → q ≠ 0 →
        ∃ k : ℕ, MvPolynomial.C ((∏ j, o.leadingCoeff (h j)) ^ k) * q ∈
          Ideal.span (Set.range h) by
      intro q hq
      by_cases hq0 : q = 0
      · exact ⟨0, by rw [hq0, mul_zero]; exact Ideal.zero_mem _⟩
      · exact H _ q hq rfl hq0
    intro s
    refine WellFoundedLT.induction (motive := fun s => ∀ q ∈ I, o.toSyn (o.degree q) = s →
        q ≠ 0 → ∃ k : ℕ, MvPolynomial.C ((∏ j, o.leadingCoeff (h j)) ^ k) * q ∈
          Ideal.span (Set.range h)) s ?_
    intro s ih q hq hqs hq0
    obtain ⟨j, hj⟩ := hcov q hq hq0
    set D := o.degree q with hD
    set d := o.degree (h j) with hd
    set c := o.leadingCoeff (h j) with hc
    set lam := o.leadingCoeff q with hlam
    set q' := MvPolynomial.C c * q - MvPolynomial.monomial (D - d) lam * h j with hq'
    have hq'I : q' ∈ I := I.sub_mem (I.mul_mem_left _ hq) (I.mul_mem_left _ (hI j))
    have hle1 : o.toSyn (o.degree (MvPolynomial.C c * q)) ≤ o.toSyn D := by
      rw [MvPolynomial.C_mul']; exact MonomialOrder.degree_smul_le
    have hle2 : o.toSyn (o.degree (MvPolynomial.monomial (D - d) lam * h j)) ≤ o.toSyn D := by
      refine MonomialOrder.degree_mul_le.trans ?_
      rw [map_add]
      calc o.toSyn (o.degree (MvPolynomial.monomial (D - d) lam)) + o.toSyn d
          ≤ o.toSyn (D - d) + o.toSyn d := by
            gcongr; exact MonomialOrder.degree_monomial_le lam
        _ = o.toSyn D := by rw [← map_add, tsub_add_cancel_of_le hj]
    have hcoeffD : q'.coeff D = 0 := by
      rw [hq', MvPolynomial.coeff_sub, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_monomial_mul',
        if_pos tsub_le_self, tsub_tsub_cancel_of_le hj]
      show c * q.coeff (o.degree q) - lam * (h j).coeff (o.degree (h j)) = 0
      rw [hc, hlam]
      simp only [MonomialOrder.leadingCoeff]
      ring
    have hlt : q' = 0 ∨ o.toSyn (o.degree q') < s := by
      by_cases h0 : q' = 0
      · exact Or.inl h0
      · right
        rw [← hqs]
        have hle : o.toSyn (o.degree q') ≤ o.toSyn D := by
          rw [hq', sub_eq_add_neg]
          refine MonomialOrder.degree_add_le.trans (max_le hle1 ?_)
          rw [MonomialOrder.degree_neg]; exact hle2
        refine lt_of_le_of_ne hle ?_
        intro heq
        have h1 : o.degree q' = D := o.toSyn.injective heq
        have h2 := MonomialOrder.degree_mem_support (m := o) h0
        rw [h1, MvPolynomial.mem_support_iff] at h2
        exact h2 hcoeffD
    obtain ⟨k', hk'⟩ : ∃ k' : ℕ, MvPolynomial.C ((∏ j, o.leadingCoeff (h j)) ^ k') * q' ∈
        Ideal.span (Set.range h) := by
      rcases hlt with h0 | h0
      · exact ⟨0, by rw [h0, mul_zero]; exact Ideal.zero_mem _⟩
      · by_cases h00 : q' = 0
        · exact ⟨0, by rw [h00, mul_zero]; exact Ideal.zero_mem _⟩
        · exact ih _ h0 q' hq'I rfl h00
    obtain ⟨a', ha'⟩ : ∃ a', c * a' = ∏ j, o.leadingCoeff (h j) :=
      ⟨_, Finset.mul_prod_erase Finset.univ (fun j => o.leadingCoeff (h j)) (Finset.mem_univ j)⟩
    refine ⟨k' + 1, ?_⟩
    have hdecomp : MvPolynomial.C ((∏ j, o.leadingCoeff (h j)) ^ (k' + 1)) * q =
        MvPolynomial.C a' * (MvPolynomial.C ((∏ j, o.leadingCoeff (h j)) ^ k') * q' +
          (MvPolynomial.C ((∏ j, o.leadingCoeff (h j)) ^ k') *
            MvPolynomial.monomial (D - d) lam) * h j) := by
      rw [hq', ← ha']
      simp only [map_mul, map_pow]
      ring
    rw [hdecomp]
    refine Ideal.mul_mem_left _ _ (Ideal.add_mem _ hk' (Ideal.mul_mem_left _ _ ?_))
    exact Ideal.subset_span ⟨j, rfl⟩

  have s3 : ∀ (A B : Type u) [CommRing A] [CommRing B] (φ : A →+* B) (n : ℕ)
      (π : MvPolynomial (Fin n) A →+* B), Function.Surjective π →
      (∀ r : A, π (MvPolynomial.C r) = φ r) → ∀ (m : ℕ) (p : Fin m → MvPolynomial (Fin n) A),
      (∀ j, π (p j) = 0) → ∀ (b : A),
      (∀ q : MvPolynomial (Fin n) A, π q = 0 →
        ∃ k : ℕ, MvPolynomial.C (b ^ k) * q ∈ Ideal.span (Set.range p)) →
      ∀ (A' B' : Type u) [CommRing A'] [CommRing B'] [Algebra A A'] [Algebra B B']
      [IsLocalization.Away b A'] [IsLocalization.Away (φ b) B'],
      (IsLocalization.Away.map A' B' φ b).FinitePresentation := by
    intro A B _ _ φ n π hπ hπC m p hp b hker A' B' _ _ _ _ _ _
    set ψ := IsLocalization.Away.map A' B' φ b with hψ
    let ι := algebraMap A A'
    let μ : MvPolynomial (Fin n) A →+* MvPolynomial (Fin n) A' := MvPolynomial.map ι
    let Ψ : MvPolynomial (Fin n) A' →+* B' :=
      MvPolynomial.eval₂Hom ψ (fun i => algebraMap B B' (π (MvPolynomial.X i)))
    have hΨC : Ψ.comp MvPolynomial.C = ψ := by
      ext r; simp [Ψ]
    have hψι : ∀ r : A, ψ (ι r) = algebraMap B B' (φ r) := fun r => IsLocalization.map_eq _ _
    have hK : Ψ.comp μ = (algebraMap B B').comp π := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, μ, Ψ, MvPolynomial.map_C, MvPolynomial.coe_eval₂Hom,
          MvPolynomial.eval₂_C, hψι, hπC]
      · intro i
        simp only [RingHom.comp_apply, μ, Ψ, MvPolynomial.map_X, MvPolynomial.coe_eval₂Hom,
          MvPolynomial.eval₂_X]
    have hK' : ∀ q, Ψ (μ q) = algebraMap B B' (π q) := fun q => by
      rw [← RingHom.comp_apply, hK, RingHom.comp_apply]
    have hιb : IsUnit (ι b) := IsLocalization.Away.algebraMap_isUnit b
    have hsurj : Function.Surjective Ψ := by
      intro y
      obtain ⟨⟨x1, x2⟩, hx⟩ := IsLocalization.surj (Submonoid.powers (φ b)) y
      obtain ⟨N, hN⟩ := x2.2
      obtain ⟨Q, rfl⟩ := hπ x1
      obtain ⟨v, hv⟩ := hιb.exists_right_inv
      refine ⟨MvPolynomial.C (v ^ N) * μ Q, ?_⟩
      rw [map_mul, hK', ← hx]
      simp only [Ψ, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C]
      simp only at hN
      rw [← hN, map_pow, map_pow, mul_left_comm, ← mul_pow, ← hψι, ← map_mul, mul_comm v, hv,
        map_one, one_pow, mul_one]
    let J : Ideal (MvPolynomial (Fin n) A') := Ideal.span (Set.range (fun j => μ (p j)))
    have hkerJ : RingHom.ker Ψ = J := by
      apply le_antisymm
      · intro z hz
        rw [RingHom.mem_ker] at hz
        letI : Algebra (MvPolynomial (Fin n) A) (MvPolynomial (Fin n) A') :=
          MvPolynomial.algebraMvPolynomial
        have hloc : IsLocalization (Submonoid.map MvPolynomial.C (Submonoid.powers b))
            (MvPolynomial (Fin n) A') := MvPolynomial.isLocalization _ _
        obtain ⟨⟨Q, s⟩, hQ⟩ := @IsLocalization.surj _ _
          (Submonoid.map MvPolynomial.C (Submonoid.powers b)) _ _ _ hloc z
        obtain ⟨t, ⟨N, rfl⟩, hs⟩ := s.2
        have hQ' : z * μ s = μ Q := by
          have := hQ
          rw [MvPolynomial.algebraMap_def] at this
          exact this
        have h1 : algebraMap B B' (π Q) = 0 := by
          rw [← hK', ← hQ', map_mul, hz, zero_mul]
        obtain ⟨⟨_, ⟨k1, rfl⟩⟩, hk1⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers (φ b)) B' (π Q)).mp h1
        simp only at hk1
        have h2 : π (MvPolynomial.C (b ^ k1) * Q) = 0 := by
          rw [map_mul, hπC, map_pow, hk1]
        obtain ⟨k, hk⟩ := hker _ h2
        have h3 := Ideal.mem_map_of_mem μ hk
        rw [Ideal.map_span, ← Set.range_comp] at h3
        have h4 : μ (MvPolynomial.C (b ^ k) * (MvPolynomial.C (b ^ k1) * Q)) =
            MvPolynomial.C (ι b ^ (k + k1 + N)) * z := by
          rw [map_mul, map_mul, ← hQ', ← hs]
          simp only [μ, MvPolynomial.map_C, map_pow]
          ring
        rw [h4] at h3
        have hu : IsUnit (MvPolynomial.C (ι b ^ (k + k1 + N)) : MvPolynomial (Fin n) A') :=
          (hιb.pow _).map MvPolynomial.C
        exact (Ideal.unit_mul_mem_iff_mem _ hu).mp h3
      · rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, hK', hp, map_zero]
    have hΨfp : Ψ.FinitePresentation := by
      refine RingHom.FinitePresentation.of_surjective Ψ hsurj ?_
      rw [hkerJ]
      exact Submodule.fg_span (Set.finite_range _)
    have hCfp : (MvPolynomial.C : A' →+* MvPolynomial (Fin n) A').FinitePresentation := by
      rw [← MvPolynomial.algebraMap_eq]
      exact RingHom.finitePresentation_algebraMap.mpr inferInstance
    rw [← hΨC]
    exact hΨfp.comp hCfp

  have s4 : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] (φ : A →+* B),
      φ.FiniteType → ∃ a : A, a ≠ 0 ∧ ∀ (b : A), a ∣ b → ∀ (A' B' : Type u) [CommRing A']
        [CommRing B'] [Algebra A A'] [Algebra B B'] [IsLocalization.Away b A']
        [IsLocalization.Away (φ b) B'], (IsLocalization.Away.map A' B' φ b).FinitePresentation := by
    intro A B _ _ _ φ hφ
    letI := φ.toAlgebra
    have hft : Algebra.FiniteType A B := hφ
    obtain ⟨n, π₀, hπ₀⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
    let π : MvPolynomial (Fin n) A →+* B := π₀.toRingHom
    have hπC : ∀ r : A, π (MvPolynomial.C r) = φ r := fun r => by
      have := π₀.commutes r
      rw [MvPolynomial.algebraMap_eq] at this
      exact this
    obtain ⟨m, h, hI, h0, hcov⟩ := s1 A n (RingHom.ker π)
    refine ⟨∏ j, (MonomialOrder.lex : MonomialOrder (Fin n)).leadingCoeff (h j), ?_, ?_⟩
    · exact Finset.prod_ne_zero_iff.mpr fun j _ =>
        MonomialOrder.leadingCoeff_ne_zero_iff.mpr (h0 j)
    · rintro b ⟨c, rfl⟩ A' B' _ _ _ _ _ _
      refine s3 A B φ n π hπ₀ hπC m h (fun j => hI j) _ ?_ A' B'
      intro q hq
      obtain ⟨k, hk⟩ := s2 A n (RingHom.ker π) m h hI hcov q hq
      refine ⟨k, ?_⟩
      rw [mul_pow, map_mul, mul_comm (MvPolynomial.C _), mul_assoc]
      exact Ideal.mul_mem_left _ _ hk

  intro T Z _ g hqc hlft
  haveI := hqc
  haveI := hlft
  obtain ⟨x⟩ := (inferInstance : Nonempty T)
  obtain ⟨U₀, hU₀, hxU₀, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
  have hcpt : IsCompact (g ⁻¹ᵁ U₀ : Set Z) := g.isCompact_preimage hU₀.isCompact
  obtain ⟨s, hs, hseq⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hcpt
  obtain ⟨m, f, -, hf⟩ := hs.fin_param
  let V : Fin m → Z.Opens := fun i => (f i : Z.Opens)
  have hV : ∀ i, IsAffineOpen (V i) := fun i => (f i).2
  have hcov : ∀ z ∈ g ⁻¹ᵁ U₀, ∃ i, z ∈ V i := by
    intro z hz
    rw [hseq] at hz
    simp only [TopologicalSpace.Opens.mem_iSup] at hz
    obtain ⟨w, hw, hzw⟩ := hz
    rw [← hf] at hw
    obtain ⟨i, rfl⟩ := hw
    exact ⟨i, hzw⟩
  have e : ∀ i, V i ≤ g ⁻¹ᵁ U₀ := by
    intro i
    rw [hseq]
    exact le_iSup₂ (f := fun (w : Z.affineOpens) (_ : w ∈ s) => (w : Z.Opens)) (f i)
      (by rw [← hf]; exact ⟨i, rfl⟩)
  haveI : Nonempty U₀ := ⟨⟨x, hxU₀⟩⟩
  haveI : IsDomain Γ(T, U₀) := IsIntegral.component_integral (X := T) U₀
  have hft : ∀ i, (g.appLE U₀ (V i) (e i)).hom.FiniteType := fun i =>
    g.finiteType_appLE hU₀ (hV i) (e i)
  choose a ha0 hloc using fun i => s4 Γ(T, U₀) Γ(Z, V i) (g.appLE U₀ (V i) (e i)).hom (hft i)
  set A : Γ(T, U₀) := ∏ i, a i with hAdef
  have hA0 : A ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => ha0 i
  have hdvd : ∀ i, a i ∣ A := fun i => Finset.dvd_prod_of_mem _ (Finset.mem_univ i)
  have hUne : T.basicOpen A ≠ ⊥ := by
    rw [Ne, basicOpen_eq_bot_iff]; exact hA0
  have hfpW : ∀ i h, (g.appLE (T.basicOpen A)
      (Z.basicOpen ((g.appLE U₀ (V i) (e i)) A)) h).hom.FinitePresentation := by
    intro i h
    rw [IsAffineOpen.appLE_eq_away_map g hU₀ (hV i) (e i) A, CommRingCat.hom_ofHom]
    exact @hloc i A (hdvd i) _ _ _ _ _ _ (hU₀.isLocalization_basicOpen A)
      ((hV i).isLocalization_basicOpen _)
  have hWle : ∀ i, Z.basicOpen ((g.appLE U₀ (V i) (e i)) A) ≤ g ⁻¹ᵁ T.basicOpen A := by
    intro i
    rw [Scheme.basicOpen_appLE]
    exact inf_le_right
  have key : ∀ (i : Fin m) (f' : (g ⁻¹ᵁ T.basicOpen A).toScheme ⟶ (T.basicOpen A).toScheme),
      f' = g.resLE (T.basicOpen A) (g ⁻¹ᵁ T.basicOpen A) le_rfl →
      ∀ e' : (g ⁻¹ᵁ T.basicOpen A).ι ⁻¹ᵁ Z.basicOpen ((g.appLE U₀ (V i) (e i)) A) ≤ f' ⁻¹ᵁ ⊤,
      (f'.appLE ⊤ _ e').hom.FinitePresentation := by
    intro i f' hf' e'
    subst hf'
    rw [Scheme.Hom.resLE_appLE]
    refine (Scheme.Hom.appLE_congr g _ (Scheme.Opens.ι_image_top _) ?_
      (fun f => f.hom.FinitePresentation)).mpr (hfpW i _)
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
    exact inf_eq_right.mpr (hWle i)
  have hstab : RingHom.StableUnderCompositionWithLocalizationAwaySource
      (fun {R S} [CommRing R] [CommRing S] => @RingHom.FinitePresentation R S _ _) :=
    (RingHom.finitePresentation_stableUnderComposition.stableUnderCompositionWithLocalizationAway
      RingHom.finitePresentation_holdsForLocalizationAway).left
  refine ⟨T.basicOpen A, hUne, ?_⟩
  rw [HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFinitePresentation) hstab]
  intro y
  have hy : y.1 ∈ g ⁻¹ᵁ T.basicOpen A := y.2
  have hy0 : y.1 ∈ g ⁻¹ᵁ U₀ := g.preimage_mono (T.basicOpen_le A) hy
  obtain ⟨i, hi⟩ := hcov _ hy0
  have hyW : y.1 ∈ Z.basicOpen ((g.appLE U₀ (V i) (e i)) A) := by
    rw [Scheme.basicOpen_appLE]; exact ⟨hi, hy⟩
  haveI : IsAffine (T.basicOpen A).toScheme := hU₀.basicOpen A
  refine ⟨⟨⊤, isAffineOpen_top _⟩,
    ⟨(g ⁻¹ᵁ T.basicOpen A).ι ⁻¹ᵁ Z.basicOpen ((g.appLE U₀ (V i) (e i)) A),
      ((hV i).basicOpen _).preimage_of_isOpenImmersion _
        (by rw [Scheme.Opens.opensRange_ι]; exact hWle i)⟩,
      hyW, fun _ _ => trivial, ?_⟩
  exact key i _ (Scheme.Hom.resLE_eq_morphismRestrict g).symm _

theorem wcpa_dj_lsi_spread_iso : ∀ (T A B : Scheme.{u}) [AlgebraicGeometry.IsIntegral T] (pa : A ⟶ T) (pb : B ⟶ T) (n : ℕ) (sA : Fin n → (T ⟶ A)) (sB : Fin n → (T ⟶ B)), QuasiCompact pa → QuasiSeparated pa → QuasiCompact pb → QuasiSeparated pb → ∀ (Ua Ub : T.Opens), Ua ≠ ⊥ → Ub ≠ ⊥ → LocallyOfFinitePresentation (pa ∣_ Ua) → LocallyOfFinitePresentation (pb ∣_ Ub) → (∀ i, sA i ≫ pa = 𝟙 T) → (∀ i, sB i ≫ pb = 𝟙 T) → ∀ (L : Type u) [Field L] (εT : T.functionField ≃+* L) (AL : Scheme.{u}) (qA : AL ⟶ A) (pA : AL ⟶ Spec (.of L)) (qB : AL ⟶ B) (t : Fin n → (Spec (.of L) ⟶ AL)), IsPullback qA pA pa (Spec.map (CommRingCat.ofHom (εT : T.functionField →+* L)) ≫ T.fromSpecStalk (genericPoint T)) → IsPullback qB pA pb (Spec.map (CommRingCat.ofHom (εT : T.functionField →+* L)) ≫ T.fromSpecStalk (genericPoint T)) → (∀ i, t i ≫ pA = 𝟙 _) → (∀ i, t i ≫ qA = (Spec.map (CommRingCat.ofHom (εT : T.functionField →+* L)) ≫ T.fromSpecStalk (genericPoint T)) ≫ sA i) → (∀ i, t i ≫ qB = (Spec.map (CommRingCat.ofHom (εT : T.functionField →+* L)) ≫ T.fromSpecStalk (genericPoint T)) ≫ sB i) → ∃ (W : T.Opens) (Φ : (pa ⁻¹ᵁ W).toScheme ⟶ B), W ≠ ⊥ ∧ IsPullback Φ (pa ∣_ W) pb W.ι ∧ ∀ i (x : W.toScheme ⟶ (pa ⁻¹ᵁ W).toScheme), x ≫ (pa ⁻¹ᵁ W).ι = W.ι ≫ sA i → x ≫ Φ = W.ι ≫ sB i :=
by
  open CategoryTheory.Limits in
  classical

  have s8 : ∀ (T A B : Scheme.{u}) (pa : A ⟶ T) (pb : B ⟶ T) (W : T.Opens)
      (φ : (pa ⁻¹ᵁ W).toScheme ⟶ B) (ψ : (pb ⁻¹ᵁ W).toScheme ⟶ A),
      φ ≫ pb = (pa ⁻¹ᵁ W).ι ≫ pa → ψ ≫ pa = (pb ⁻¹ᵁ W).ι ≫ pb →
      (∀ k : (pa ⁻¹ᵁ W).toScheme ⟶ (pb ⁻¹ᵁ W).toScheme, k ≫ (pb ⁻¹ᵁ W).ι = φ →
        k ≫ ψ = (pa ⁻¹ᵁ W).ι) →
      (∀ k : (pb ⁻¹ᵁ W).toScheme ⟶ (pa ⁻¹ᵁ W).toScheme, k ≫ (pa ⁻¹ᵁ W).ι = ψ →
        k ≫ φ = (pb ⁻¹ᵁ W).ι) →
      IsPullback φ (pa ∣_ W) pb W.ι := by
    intro T A B pa pb W φ ψ h1 h2 h3 h4
    have hRa := isPullback_morphismRestrict pa W
    have hRb := isPullback_morphismRestrict pb W
    let φ' := hRb.lift (pa ∣_ W) φ (by rw [morphismRestrict_ι, h1])
    let ψ' := hRa.lift (pb ∣_ W) ψ (by rw [morphismRestrict_ι, h2])
    have hφ'2 : φ' ≫ (pb ⁻¹ᵁ W).ι = φ := hRb.lift_snd _ _ _
    have hψ'1 : ψ' ≫ (pa ∣_ W) = pb ∣_ W := hRa.lift_fst _ _ _
    have hψ'2 : ψ' ≫ (pa ⁻¹ᵁ W).ι = ψ := hRa.lift_snd _ _ _
    have e1 : φ' ≫ ψ' = 𝟙 _ := by
      rw [← cancel_mono (pa ⁻¹ᵁ W).ι, Category.assoc, hψ'2, Category.id_comp]
      exact h3 φ' hφ'2
    have e2 : ψ' ≫ φ' = 𝟙 _ := by
      rw [← cancel_mono (pb ⁻¹ᵁ W).ι, Category.assoc, hφ'2, Category.id_comp]
      exact h4 ψ' hψ'2
    refine IsPullback.of_iso hRb.flip ⟨ψ', φ', e2, e1⟩ (Iso.refl _) (Iso.refl _) (Iso.refl _)
      ?_ ?_ ?_ ?_
    · simp only [Iso.refl_hom, Category.comp_id]
      rw [← hφ'2, ← Category.assoc, e2, Category.id_comp]
    · simp only [Iso.refl_hom, Category.comp_id]
      exact hψ'1.symm
    · simp
    · simp

  have s7 : ∀ (T X : Scheme.{u}) [AlgebraicGeometry.IsIntegral T] (L : Type u) [Field L]
      (εT : T.functionField ≃+* L) (V : T.Opens) (α β : V.toScheme ⟶ X)
      (k : Spec (.of L) ⟶ V.toScheme),
      k ≫ V.ι = Spec.map (CommRingCat.ofHom (εT : T.functionField →+* L)) ≫
        T.fromSpecStalk (genericPoint T) →
      k ≫ α = k ≫ β → ∃ (V' : T.Opens) (h : V' ≤ V), V' ≠ ⊥ ∧ T.homOfLE h ≫ α = T.homOfLE h ≫ β := by
    intro T X _ L _ εT V α β k hk hab
    have hηV : genericPoint T ∈ V :=
      ((genericPoint_spec T).mem_open_set_iff V.isOpen).mpr
        ⟨V.ι (k (IsLocalRing.closedPoint L)), trivial, (k (IsLocalRing.closedPoint L)).2⟩
    let η : V.toScheme := ⟨genericPoint T, hηV⟩
    haveI : Nonempty V.toScheme := ⟨η⟩
    haveI : AlgebraicGeometry.IsIntegral V.toScheme := isIntegral_of_isOpenImmersion V.ι
    haveI : IsIso (CommRingCat.ofHom (εT : T.functionField →+* L)) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr εT.bijective
    have hk' : k = Spec.map (CommRingCat.ofHom (εT : T.functionField →+* L)) ≫
        V.fromSpecStalkOfMem _ hηV := by
      rw [← cancel_mono V.ι, hk, Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι]
    rw [hk', Category.assoc, Category.assoc] at hab
    have hab1 := (cancel_epi _).mp hab
    simp only [Scheme.Opens.fromSpecStalkOfMem, Category.assoc] at hab1
    haveI : IsIso (Scheme.Hom.stalkMap V.ι ⟨genericPoint T, hηV⟩) :=
      IsOpenImmersion.instIsIsoCommRingCatStalkMap V.ι _
    have hab' := (cancel_epi (Spec.map (inv (Scheme.Hom.stalkMap V.ι ⟨genericPoint T, hηV⟩)))).mp hab1
    haveI : V.toScheme.IsGermInjectiveAt η := inferInstance
    obtain ⟨U, hU, hUe⟩ := spread_out_unique_of_isGermInjective' (x := η) α β hab'
    refine ⟨V.ι ''ᵁ U, Scheme.Opens.ι_image_le V U, ?_, ?_⟩
    · rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
      exact ⟨V.ι ⟨_, hηV⟩, ⟨_, hηV⟩, hU, rfl⟩
    · have e : T.homOfLE (Scheme.Opens.ι_image_le V U) = (V.ι.isoImage U).inv ≫ U.ι := by
        rw [← cancel_mono V.ι, Scheme.homOfLE_ι, Category.assoc, Scheme.Hom.isoImage_inv_ι]
      rw [e, Category.assoc, Category.assoc, hUe]

  have s1 : ∀ (T : Scheme.{u}) [AlgebraicGeometry.IsIntegral T] (U0 : T.Opens), U0 ≠ ⊥ →
      IsCofiltered {V : T.Opens // IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0} := by
    intro T _ U0 hU0
    have F1 : ∀ O : T.Opens, O ≠ ⊥ ↔ genericPoint T ∈ O := by
      intro O
      rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
      exact ⟨fun h => ((genericPoint_spec T).mem_open_set_iff O.isOpen).mpr (by simpa using h),
        fun h => ⟨_, h⟩⟩
    have key : ∀ O : T.Opens, O ≠ ⊥ → O ≤ U0 →
        ∃ V : {V : T.Opens // IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0}, V.1 ≤ O := by
      intro O hO hOU
      obtain ⟨W, hW, hηW, hWO⟩ := exists_isAffineOpen_mem_and_subset ((F1 O).mp hO)
      exact ⟨⟨W, hW, (F1 W).mpr hηW, fun x hx => hOU (hWO hx)⟩, fun x hx => hWO hx⟩
    haveI : Nonempty {V : T.Opens // IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0} :=
      ⟨(key U0 hU0 le_rfl).choose⟩
    haveI : IsCodirectedOrder {V : T.Opens // IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0} := by
      refine ⟨fun a b => ?_⟩
      have hab : a.1 ⊓ b.1 ≠ ⊥ := by
        rw [F1]
        exact ⟨(F1 a.1).mp a.2.2.1, (F1 b.1).mp b.2.2.1⟩
      obtain ⟨c, hc⟩ := key (a.1 ⊓ b.1) hab (inf_le_left.trans a.2.2.2)
      exact ⟨c, hc.trans inf_le_left, hc.trans inf_le_right⟩
    exact isCofiltered_of_directed_ge_nonempty _

  have s4 : ∀ (T A : Scheme.{u}) (a : A ⟶ T), QuasiCompact a → QuasiSeparated a → ∀ (U0 : T.Opens), (∀ {i j : {V : T.Opens // IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0}} (f : i ⟶ j), IsAffineHom (((Subtype.mono_coe fun V : T.Opens => IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0).functor ⋙ TopologicalSpace.Opens.map a.base ⋙ A.restrictFunctor ⋙ Over.forget A).map f)) ∧ (∀ i, CompactSpace ↥(((Subtype.mono_coe fun V : T.Opens => IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0).functor ⋙ TopologicalSpace.Opens.map a.base ⋙ A.restrictFunctor ⋙ Over.forget A).obj i)) ∧ (∀ i, QuasiSeparatedSpace ↥(((Subtype.mono_coe fun V : T.Opens => IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0).functor ⋙ TopologicalSpace.Opens.map a.base ⋙ A.restrictFunctor ⋙ Over.forget A).obj i)) := by
    intro T A a hqc hqs U0
    refine ⟨fun {i j} f => ?_, fun i => ?_, fun i => ?_⟩
    · show IsAffineHom (A.homOfLE (a.preimage_mono f.le))
      haveI : IsAffine i.1.toScheme := i.2.1
      haveI : IsAffine j.1.toScheme := j.2.1
      have hR' := isPullback_morphismRestrict a i.1
      have hR := isPullback_morphismRestrict a j.1
      have s : IsPullback (A.homOfLE (a.preimage_mono f.le) ≫ (a ⁻¹ᵁ j.1).ι) (a ∣_ i.1) a
          (T.homOfLE f.le ≫ j.1.ι) := by
        rw [Scheme.homOfLE_ι, Scheme.homOfLE_ι]; exact hR'.flip
      have hsq := IsPullback.of_right s (by
        rw [← cancel_mono j.1.ι, Category.assoc, Category.assoc, morphismRestrict_ι,
          Scheme.homOfLE_ι, ← Category.assoc, Scheme.homOfLE_ι, morphismRestrict_ι]) hR.flip
      exact MorphismProperty.of_isPullback (P := @IsAffineHom) hsq.flip
        (isAffineHom_of_isAffine (T.homOfLE f.le))
    · show CompactSpace (a ⁻¹ᵁ i.1)
      exact isCompact_iff_compactSpace.mp
        (QuasiCompact.isCompact_preimage _ i.1.isOpen i.2.1.isCompact)
    · show QuasiSeparatedSpace (a ⁻¹ᵁ i.1).toScheme
      haveI : IsAffine i.1.toScheme := i.2.1
      exact quasiSeparatedSpace_of_quasiSeparated (a ∣_ i.1)

  have s2 : ∀ (T : Scheme.{u}) [AlgebraicGeometry.IsIntegral T] (U0 : T.Opens), U0 ≠ ⊥ →
      ∀ (L : Type u) [Field L] (εT : T.functionField ≃+* L)
      [IsCofiltered {V : T.Opens // IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0}],
      ∃ π : (Functor.const {V : T.Opens // IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0}).obj (Spec (.of L)) ⟶ (Subtype.mono_coe fun V : T.Opens => IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0).functor ⋙ T.restrictFunctor ⋙ Over.forget T, Nonempty (IsLimit (Cone.mk _ π)) ∧ ∀ V, π.app V ≫ V.1.ι = Spec.map (CommRingCat.ofHom (εT : T.functionField →+* L)) ≫ T.fromSpecStalk (genericPoint T) := by
    intro T _ U0 hU0 L _ εT _
    have F1 : ∀ O : T.Opens, O ≠ ⊥ ↔ genericPoint T ∈ O := by
      intro O
      rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
      exact ⟨fun h => ((genericPoint_spec T).mem_open_set_iff O.isOpen).mpr (by simpa using h),
        fun h => ⟨_, h⟩⟩
    let J := {V : T.Opens // IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0}
    have hη : ∀ V : J, genericPoint T ∈ V.1 := fun V => (F1 V.1).mp V.2.2.1
    let ιJ : J ⥤ TopologicalSpace.OpenNhds (genericPoint T) :=
      { obj := fun V => ⟨V.1, hη V⟩
        map := fun {V W} f => homOfLE f.le }
    haveI : ιJ.Initial := by
      apply Functor.initial_of_exists_of_isCofiltered
      · intro d
        have hd : genericPoint T ∈ d.1 ⊓ U0 := ⟨d.2, (F1 U0).mp hU0⟩
        obtain ⟨W, hW, hηW, hWO⟩ := exists_isAffineOpen_mem_and_subset hd
        exact ⟨⟨W, hW, (F1 W).mpr hηW, fun x hx => (hWO hx).2⟩,
          ⟨homOfLE (fun x hx => (hWO hx).1)⟩⟩
      · intro d c s s'
        exact ⟨c, 𝟙 c, Subsingleton.elim _ _⟩
    haveI : ιJ.op.Final := inferInstance
    let c0 := colimit.cocone ((TopologicalSpace.OpenNhds.inclusion (genericPoint T)).op ⋙ T.presheaf)
    have hcw : IsColimit (c0.whisker ιJ.op) :=
      (Functor.Final.isColimitWhiskerEquiv ιJ.op c0).symm (colimit.isColimit _)
    let G := ιJ.op ⋙ (TopologicalSpace.OpenNhds.inclusion (genericPoint T)).op ⋙ T.presheaf
    have hlim1 := isLimitConeRightOpOfCocone G hcw
    have hlim2 := isLimitOfPreserves Scheme.Spec hlim1
    let α : G.rightOp ⋙ Scheme.Spec ≅
        (Subtype.mono_coe fun V : T.Opens => IsAffineOpen V ∧ V ≠ ⊥ ∧ V ≤ U0).functor ⋙
          T.restrictFunctor ⋙ Over.forget T :=
      NatIso.ofComponents (fun V => V.2.1.isoSpec.symm) (by
        intro V W f
        show Spec.map (T.presheaf.map (homOfLE f.le).op) ≫ W.2.1.isoSpec.inv =
          V.2.1.isoSpec.inv ≫ T.homOfLE f.le
        have h := Scheme.Opens.toSpecΓ_SpecMap_presheaf_map V.1 W.1 f.le
        rw [Iso.comp_inv_eq, Category.assoc, IsAffineOpen.isoSpec_hom, ← h, ← Category.assoc,
          ← IsAffineOpen.isoSpec_hom V.2.1, Iso.inv_hom_id, Category.id_comp]
        rfl)
    have hlim3 := (IsLimit.postcomposeHomEquiv α _).symm hlim2
