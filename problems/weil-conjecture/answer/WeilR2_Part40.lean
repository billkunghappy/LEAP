    have hkeyG := wcpa_dj_nd_node_mod_injective S B (IsLocalRing.ResidueField A)
      (IsLocalRing.maximalIdeal S) r ι π (Ψ₀ : MvPowerSeries (Fin 2) S →+* B) h hFG hr_surj
      hr_ker hker' hπι hΨCring hπX0 hπX1 hh
    have hkey : ∀ q, Ψb q ∈ (IsLocalRing.maximalIdeal S).map (algebraMap S B) →
        q ∈ (IsLocalRing.maximalIdeal S).map (algebraMap S (MvPowerSeries (Fin 2) S ⧸
          Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C h})) := by
      intro q hq
