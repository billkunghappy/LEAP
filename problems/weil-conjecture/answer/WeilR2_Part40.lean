  have hp2j : ∀ y : Y, (ι ≫ Limits.pullback.snd u u') (j y) = a' y := by
    intro y
    rw [← Scheme.Hom.comp_apply, ← Category.assoc, hjι, Limits.pullback.lift_snd]
  have he1 : (e ≫ j) ≫ (ι ≫ Limits.pullback.snd u u') =
      Spec.map (CommRingCat.ofHom (algebraMap ↑(Z'.presheaf.stalk ξ)
        (FractionRing ↑(Z'.presheaf.stalk ξ)))) ≫ Z'.fromSpecStalk ξ := by
    rw [Category.assoc, ← Category.assoc j, hjι, Limits.pullback.lift_snd, he]
  obtain ⟨σ, hσ⟩ := s3 G Z' (ι ≫ Limits.pullback.snd u u') hp2 ξ (e ≫ j) he1
  have hinj : ∀ g ∈ Set.range ⇑j, ∀ g' : G,
