  refine ⟨W, Φ, hWne, s8 T A B pa pb W Φ Ψ hΦ hΨ hinv1 hinv2, ?_⟩
  intro i x hx
  have ex : x ≫ A.homOfLE (pa.preimage_mono hW3) = T.homOfLE hW3 ≫ σA i := by
