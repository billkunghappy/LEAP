        ∀ (Q₁ : Ideal T₁) [Q₁.IsPrime], IsDomain (Localization.AtPrime Q₁) ∧
          IsIntegrallyClosed (Localization.AtPrime Q₁) := by
      intro D₁ T₁ _ _ Θ₁ hD₁ Q₁ _
      haveI hQ' : (Ideal.comap Θ₁ Q₁).IsPrime := Ideal.comap_isPrime _ _
      have H : Submonoid.map Θ₁.toMonoidHom (Ideal.comap Θ₁ Q₁).primeCompl = Q₁.primeCompl := by
        ext z
        constructor
        · rintro ⟨w, hw, rfl⟩
          exact hw
        · intro hz
          refine ⟨Θ₁.symm z, ?_, ?_⟩
          · show Θ₁ (Θ₁.symm z) ∉ Q₁
            rw [RingEquiv.apply_symm_apply]; exact hz
          · show Θ₁ (Θ₁.symm z) = z
            exact RingEquiv.apply_symm_apply _ _
      let ε : Localization.AtPrime (Ideal.comap Θ₁ Q₁) ≃+* Localization.AtPrime Q₁ :=
        IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime (Ideal.comap Θ₁ Q₁))
          (Localization.AtPrime Q₁) Θ₁ H
      obtain ⟨h1, h2⟩ := hD₁ (Ideal.comap Θ₁ Q₁)
      exact ⟨MulEquiv.isDomain _ ε.symm.toMulEquiv, IsIntegrallyClosed.of_equiv ε⟩
    exact transfer _ _ Θ (fun Q' _ => hD Q') Q
