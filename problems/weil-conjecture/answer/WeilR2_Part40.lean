    obtain ⟨p, hp⟩ := (wc_hnas_hs_completion_levels A).1 1 c
    rw [pow_one] at hp
    have hpm : p ∈ IsLocalRing.maximalIdeal A := by
      by_contra hpn
      have hu : IsUnit p := by
