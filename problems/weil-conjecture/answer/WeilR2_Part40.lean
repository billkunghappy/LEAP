      IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P) := by
    let y : PrimeSpectrum Γ(N, V) := ⟨P, inferInstance⟩
    have hy : hV.fromSpec y ∈ V := by
      have h0 : hV.fromSpec y ∈ Set.range hV.fromSpec := ⟨y, rfl⟩
      rw [hV.range_fromSpec] at h0
      exact h0
    letI := TopCat.Presheaf.algebra_section_stalk N.presheaf ⟨hV.fromSpec y, hy⟩
    haveI hl : IsLocalization.AtPrime (N.presheaf.stalk (hV.fromSpec y)) P :=
      hV.isLocalization_stalk' y hy
    let ψ := IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P)
      (N.presheaf.stalk (hV.fromSpec y))
    obtain ⟨h1, h2⟩ := hN (hV.fromSpec y)
    exact ⟨MulEquiv.isDomain _ ψ.toMulEquiv, IsIntegrallyClosed.of_equiv ψ.symm.toRingEquiv⟩
  have s3 (S N : Scheme.{u}) (q : N ⟶ S) (W : S.Opens) (hW : IsAffineOpen W) (V : N.Opens)
      (hV : IsAffineOpen V) (hVW : V ≤ q ⁻¹ᵁ W) (A : Type u) [CommRing A] (γ : Γ(S, W) →+* A)
      (g : Spec (.of A) ⟶ S) (hg : g = Spec.map (CommRingCat.ofHom γ) ≫ hW.fromSpec)
