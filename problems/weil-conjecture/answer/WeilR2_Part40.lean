    rintro _ ⟨y, rfl⟩ g' hg'
    have hgen : u' (a' y) ≠ IsLocalRing.closedPoint R :=
      (wcpa_dj_ldx_range_generic R Z' Y u' π a' hpb' _).mp ⟨y, rfl⟩
    have hcond : u ((ι ≫ Limits.pullback.fst u u') g') =
        u' ((ι ≫ Limits.pullback.snd u u') g') := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Category.assoc, Category.assoc,
        Limits.pullback.condition]
    have hr : (ι ≫ Limits.pullback.fst u u') g' ∈ Set.range ⇑a :=
      (wcpa_dj_ldx_range_generic R Z Y u π a hpb _).mpr (by rw [hcond, hg', hp2j]; exact hgen)
    obtain ⟨y', rfl⟩ := hjr g' hr
    rw [hp2j, hp2j] at hg'
    rw [a'.isOpenEmbedding.injective hg']
  exact s4 G Z' (ι ≫ Limits.pullback.snd u u') inferInstance inferInstance hG hZ'n ξ σ hσ
    (Set.range ⇑j) hjd hinj

theorem wcpa_dj_ldx_nc_dimension_setup : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)), wcpaDjSemistable u → wcpaDjSemistable u' → ∀ (Y : Scheme.{u}) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u'), IsPullback a π u (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) → IsPullback a' π u' (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) → ∀ (G : Scheme.{u}) (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G), IsClosedImmersion ι → AlgebraicGeometry.IsReduced G → IsOpenImmersion j → Dense (Set.range ⇑j) → j ≫ ι = Limits.pullback.lift a a' h → ∀ γ γ' : G, γ' ⤳ γ → γ' ≠ γ → (ι ≫ Limits.pullback.fst u u') γ' = (ι ≫ Limits.pullback.fst u u') γ → u ((ι ≫ Limits.pullback.fst u u') γ) = IsLocalRing.closedPoint R → IsClosed ({(ι ≫ Limits.pullback.fst u u') γ} : Set Z) ∧ ∀ x : Z', u' x = IsLocalRing.closedPoint R → x ⤳ (ι ≫ Limits.pullback.snd u u') γ' → x = (ι ≫ Limits.pullback.snd u u') γ' :=
by
  intro R _ _ _ Z Z' u u' hss hss' Y π a a' h hpb hpb' G ι j hι hG hj hjd hjι γ γ' hγ hne hp hu
  haveI := hι
  haveI hup : IsProper u := hss.2.1
  haveI hup' : IsProper u' := hss'.2.1

  have P2 : ∀ g : G, u ((ι ≫ Limits.pullback.fst u u') g) =
      u' ((ι ≫ Limits.pullback.snd u u') g) := by
    intro g
    have e : (ι ≫ Limits.pullback.fst u u') ≫ u = (ι ≫ Limits.pullback.snd u u') ≫ u' := by
      rw [Category.assoc, Category.assoc, Limits.pullback.condition]
    have := congrArg (fun f : G ⟶ Spec (.of R) => f g) e
    simpa only [Scheme.Hom.comp_apply] using this
  have hιinj : Function.Injective ι := ι.isClosedEmbedding.injective

  have hii : ∀ x : Z', u' x = IsLocalRing.closedPoint R →
      x ⤳ (ι ≫ Limits.pullback.snd u u') γ' → x = (ι ≫ Limits.pullback.snd u u') γ' := by
    intro x'' hx''u hx''
    by_contra hne''
    have hx'x : (ι ≫ Limits.pullback.snd u u') γ' ⤳ (ι ≫ Limits.pullback.snd u u') γ :=
      hγ.map (ι ≫ Limits.pullback.snd u u').continuous
    have hxu : u' ((ι ≫ Limits.pullback.snd u u') γ) = IsLocalRing.closedPoint R := by
      rw [← P2]; exact hu
    have e1 : (ι ≫ Limits.pullback.snd u u') γ' = (ι ≫ Limits.pullback.snd u u') γ :=
      (wcpa_dj_ldx_ncds_chain_short_special R Z' u' hss' x'' _ _ hx''u hx'' hx'x).resolve_left
        hne''
    have hcl : IsClosed ({(ι ≫ Limits.pullback.snd u u') γ} : Set Z') := by
      rw [← closure_subset_iff_isClosed]
      intro y hy
      have hxy : (ι ≫ Limits.pullback.snd u u') γ ⤳ y := specializes_iff_mem_closure.mpr hy
      rw [← e1] at hxy
      have e2 := (wcpa_dj_ldx_ncds_chain_short_special R Z' u' hss' x'' _ y hx''u hx''
        hxy).resolve_left hne''
      rw [Set.mem_singleton_iff, ← e2, e1]
    rw [Scheme.Hom.comp_apply] at hp e1 hcl hxu
    have hq := wcpa_dj_ldx_ncds_closed_fibre_rigid R Z Z' u u' inferInstance (ι γ) (ι γ')
      (hγ.map ι.continuous) hp e1 hcl hxu
    exact hne (hιinj hq)

  have hi : IsClosed ({(ι ≫ Limits.pullback.fst u u') γ} : Set Z) := by
    by_contra hncl
    obtain ⟨z₁, hz₁, hz₁ne⟩ : ∃ z₁ ∈ closure ({(ι ≫ Limits.pullback.fst u u') γ} : Set Z),
        z₁ ≠ (ι ≫ Limits.pullback.fst u u') γ := by
      by_contra hcon
      push_neg at hcon
      exact hncl (closure_subset_iff_isClosed.mp (fun y hy => hcon y hy))
    have hzz₁ : (ι ≫ Limits.pullback.fst u u') γ ⤳ z₁ := specializes_iff_mem_closure.mpr hz₁
    have hmax : ∀ w : Z, u w = IsLocalRing.closedPoint R →
        w ⤳ (ι ≫ Limits.pullback.fst u u') γ → w = (ι ≫ Limits.pullback.fst u u') γ := by
      intro w hw hwz
      exact (wcpa_dj_ldx_ncds_chain_short_special R Z u hss w _ z₁ hw hwz hzz₁).resolve_right
        (fun e => hz₁ne e.symm)
    have efst : (ι ≫ (Limits.pullbackSymmetry u u').hom) ≫ Limits.pullback.fst u' u =
        ι ≫ Limits.pullback.snd u u' := by
      rw [Category.assoc, Limits.pullbackSymmetry_hom_comp_fst]
    have esnd : (ι ≫ (Limits.pullbackSymmetry u u').hom) ≫ Limits.pullback.snd u' u =
        ι ≫ Limits.pullback.fst u u' := by
      rw [Category.assoc, Limits.pullbackSymmetry_hom_comp_snd]
    have hjι' : j ≫ (ι ≫ (Limits.pullbackSymmetry u u').hom) =
        Limits.pullback.lift a' a h.symm := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, efst, ← Category.assoc, hjι, Limits.pullback.lift_snd,
          Limits.pullback.lift_fst]
      · rw [Category.assoc, esnd, ← Category.assoc, hjι, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd]
    have hjr' : ∀ γ₀ : G, ((ι ≫ (Limits.pullbackSymmetry u u').hom) ≫
        Limits.pullback.fst u' u) γ₀ ∈ Set.range ⇑a' → γ₀ ∈ Set.range ⇑j := by
      intro γ₀ hγ₀
      rw [efst] at hγ₀
      obtain ⟨y, hy⟩ := hγ₀
      have h1 : u' ((ι ≫ Limits.pullback.snd u u') γ₀) ≠ IsLocalRing.closedPoint R := by
        rw [← hy]
        have e : u' (a' y) =
            Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) (π y) := by
          have := congrArg (fun f : Y ⟶ Spec (.of R) => f y) hpb'.w
          simpa only [Scheme.Hom.comp_apply] using this
        rw [e]
        intro hp0
        have h1 : (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) (π y)).asIdeal
            = ⊥ := by
          have hq0 : ((π y : Spec (.of (FractionRing R))) :
              PrimeSpectrum (FractionRing R)).asIdeal = ⊥ := by
            haveI := ((π y : Spec (.of (FractionRing R))) : PrimeSpectrum (FractionRing R)).isPrime
            exact Ideal.eq_bot_of_prime _
          rw [Spec.map_apply]
          change Ideal.comap (algebraMap R (FractionRing R))
            ((π y : Spec (.of (FractionRing R))) : PrimeSpectrum (FractionRing R)).asIdeal = ⊥
          rw [hq0]
          exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective R (FractionRing R))
        apply IsDiscreteValuationRing.not_a_field R
        have h2 : (IsLocalRing.closedPoint R).asIdeal = IsLocalRing.maximalIdeal R := rfl
        rw [← h2, ← h1, hp0]
      apply wcpa_dj_ldx_ncds_generic_in_range R Z Z' u u' inferInstance Y π a a' h hpb G ι j hι
        hjd hjι γ₀
      rw [P2]; exact h1
    obtain ⟨W, hzW, hiso⟩ := wcpa_dj_ldx_nc_generic_local_iso R Z' Z u' u hss' hss Y π a' a
      h.symm hpb' hpb G (ι ≫ (Limits.pullbackSymmetry u u').hom) j inferInstance hG hj hjd hjι'
      hjr' ((ι ≫ Limits.pullback.fst u u') γ) hu hmax
    rw [esnd] at hiso
    have hγW : γ ∈ (ι ≫ Limits.pullback.fst u u') ⁻¹ᵁ W := hzW
    have hγ'W : γ' ∈ (ι ≫ Limits.pullback.fst u u') ⁻¹ᵁ W := by
      show (ι ≫ Limits.pullback.fst u u') γ' ∈ W
      rw [hp]; exact hzW
    have e1 := morphismRestrict_base_coe (ι ≫ Limits.pullback.fst u u') W ⟨γ', hγ'W⟩
    have e2 := morphismRestrict_base_coe (ι ≫ Limits.pullback.fst u u') W ⟨γ, hγW⟩
    have heq : ((ι ≫ Limits.pullback.fst u u') ∣_ W) ⟨γ', hγ'W⟩ =
        ((ι ≫ Limits.pullback.fst u u') ∣_ W) ⟨γ, hγW⟩ :=
      Subtype.ext (e1.trans (hp.trans e2.symm))
    have hinj : Function.Injective ((ι ≫ Limits.pullback.fst u u') ∣_ W) :=
      ((ι ≫ Limits.pullback.fst u u') ∣_ W).homeomorph.injective
    exact hne (congrArg Subtype.val (hinj heq))
  exact ⟨hi, hii⟩

theorem fexr_coprime_primary : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [IsDomain B] [UniqueFactorizationMonoid B], ringKrullDim B = 2 → ∀ a b : B, b ≠ 0 → (∀ p : B, Irreducible p → ¬ (p ∣ a ∧ p ∣ b)) → ∃ N : ℕ, IsLocalRing.maximalIdeal B ^ N ≤ Ideal.span {a, b} :=
by
  intro B _ _ _ _ _ hdim a b hb hcop
  have chain : ∀ (Q0 Q1 Q2 Q3 : Ideal B), Q0.IsPrime → Q1.IsPrime → Q2.IsPrime → Q3.IsPrime →
      Q0 < Q1 → Q1 < Q2 → Q2 < Q3 → False := by
    intro Q0 Q1 Q2 Q3 h0 h1 h2 h3 h01 h12 h23
    let x0 : PrimeSpectrum B := ⟨Q0, h0⟩
    let x1 : PrimeSpectrum B := ⟨Q1, h1⟩
    let x2 : PrimeSpectrum B := ⟨Q2, h2⟩
    let x3 : PrimeSpectrum B := ⟨Q3, h3⟩
    have e01 : x0 < x1 := h01
    have e12 : x1 < x2 := h12
    have e23 : x2 < x3 := h23
    let s1 : LTSeries (PrimeSpectrum B) := (RelSeries.singleton _ x0).snoc x1 (by simpa using e01)
    let s2 : LTSeries (PrimeSpectrum B) := s1.snoc x2 (by simpa [s1] using e12)
    let s : LTSeries (PrimeSpectrum B) := s2.snoc x3 (by simpa [s2] using e23)
    have hlen := Order.LTSeries.length_le_krullDim s
    have hs : s.length = 3 := rfl
    rw [hs] at hlen
    have hk : Order.krullDim (PrimeSpectrum B) = 2 := by
      rw [← hdim]; rfl
    rw [hk] at hlen
    exact absurd hlen (by decide)
  have key : ∀ P : Ideal B, P.IsPrime → a ∈ P → b ∈ P → P = IsLocalRing.maximalIdeal B := by
    intro P hP haP hbP
    have hPne : P ≠ ⊥ := by
      intro h
      rw [h, Ideal.mem_bot] at hbP
      exact hb hbP
    obtain ⟨p, hpP, hp⟩ := hP.exists_mem_prime_of_ne_bot hPne
    have hp0 : p ≠ 0 := hp.ne_zero
    have hQ1 : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hp0).mpr hp
    have h01 : (⊥ : Ideal B) < Ideal.span {p} := by
      refine lt_of_le_of_ne bot_le ?_
      intro h
      exact hp0 (Ideal.span_singleton_eq_bot.mp h.symm)
    have h12 : Ideal.span {p} < P := by
      refine lt_of_le_of_ne ((Ideal.span_singleton_le_iff_mem P).mpr hpP) ?_
      intro h
      apply hcop p hp.irreducible
      rw [← h] at haP hbP
      exact ⟨Ideal.mem_span_singleton.mp haP, Ideal.mem_span_singleton.mp hbP⟩
    have hPm : P ≤ IsLocalRing.maximalIdeal B := IsLocalRing.le_maximalIdeal hP.ne_top
    by_contra hne
    exact chain ⊥ (Ideal.span {p}) P (IsLocalRing.maximalIdeal B) Ideal.isPrime_bot hQ1 hP
      (IsLocalRing.maximalIdeal.isMaximal B).isPrime h01 h12 (lt_of_le_of_ne hPm hne)
  have hrad : IsLocalRing.maximalIdeal B ≤ (Ideal.span {a, b}).radical := by
    rw [Ideal.radical_eq_sInf]
    apply le_sInf
    rintro J ⟨hJ, hJp⟩
    have haJ : a ∈ J := hJ (Ideal.subset_span (by simp))
    have hbJ : b ∈ J := hJ (Ideal.subset_span (by simp))
    rw [key J hJp haJ hbJ]
  exact Ideal.exists_pow_le_of_le_radical_of_fg hrad (IsNoetherian.noetherian _)

theorem fexr_dom_charts : ∀ (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B] [UniqueFactorizationMonoid B] (X : Scheme.{u}) (f : X ⟶ Spec (.of B)), IsProper f → AlgebraicGeometry.IsIntegral X → (∃ U : (Spec (.of B)).Opens, U ≠ ⊥ ∧ IsIso (f ∣_ U)) → ∃ (m : ℕ) (a b : Fin m → B), (∀ l, b l ≠ 0) ∧ (∀ l (p : B), Irreducible p → ¬ (p ∣ a l ∧ p ∣ b l)) ∧ ∀ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of B)), AlgebraicGeometry.IsIntegral Y → IsDominant g → (∀ (y : Y) (l : Fin m), (Ideal.map (wcNdSig g y) (Ideal.span {a l, b l})).IsPrincipal) → ∃ h : Y ⟶ X, h ≫ f = g :=
by
  intro B _ _ _ _ X f hf hX hU
  haveI := hX
  haveI := hf
  classical


  have s4 : ∀ (S : Type u) [CommRing S] [IsLocalRing S] [IsDomain S] (L : Type u) [Field L]
      (j : S →+* L), Function.Injective j → ∀ (W : ValuationSubring L), (∀ s, j s ∈ W) →
      (∀ s ∈ IsLocalRing.maximalIdeal S, ∀ w ∈ W, j s * w ≠ 1) → ∀ (a b : S), b ≠ 0 →
      (Ideal.span {a, b}).IsPrincipal → ∀ φ : L, φ * j b = j a → φ ∈ W → ∃ s : S, j s = φ := by
    intro S _ _ _ L _ j hj W hWS hdom a b hb hprin φ hφ hφW
    obtain ⟨t, ht⟩ := hprin.principal
    have hbt : b ∈ Ideal.span {t} := by
      rw [Ideal.submodule_span_eq] at ht
      rw [← ht]; exact Ideal.subset_span (by simp)
    have hat : a ∈ Ideal.span {t} := by
      rw [Ideal.submodule_span_eq] at ht
      rw [← ht]; exact Ideal.subset_span (by simp)
    have htm : t ∈ Ideal.span {a, b} := by
      rw [ht]; exact Submodule.mem_span_singleton_self t
    obtain ⟨b', hb'⟩ := Ideal.mem_span_singleton'.mp hbt
    obtain ⟨a', ha'⟩ := Ideal.mem_span_singleton'.mp hat
    obtain ⟨r, s, hrs⟩ := Ideal.mem_span_pair.mp htm
    have ht0 : t ≠ 0 := by
      rintro rfl; apply hb; rw [← hb', mul_zero]
    have h1 : r * a' + s * b' = 1 := by
      apply mul_right_cancel₀ ht0
      rw [one_mul, add_mul, mul_assoc, mul_assoc, ha', hb', hrs]
    have hjt : j t ≠ 0 := by
      intro h; apply ht0; apply hj; rw [h, map_zero]
    have h2 : φ * j b' = j a' := by
      apply mul_right_cancel₀ hjt
      rw [mul_assoc, ← map_mul, ← map_mul, hb', ha', hφ]
    rcases IsLocalRing.isUnit_or_isUnit_of_add_one h1 with hu | hu
    · have ha'u : IsUnit a' := isUnit_of_mul_isUnit_right hu
      by_cases hb'u : IsUnit b'
      · obtain ⟨u, hu'⟩ := hb'u
        refine ⟨a' * ↑u⁻¹, ?_⟩
        have : j b' * j (↑u⁻¹ : S) = 1 := by
          rw [← map_mul, ← hu', Units.mul_inv, map_one]
        calc j (a' * ↑u⁻¹) = φ * j b' * j (↑u⁻¹ : S) := by rw [map_mul, h2]
          _ = φ := by rw [mul_assoc, this, mul_one]
      · exfalso
        obtain ⟨v, hv⟩ := ha'u
        have hbm : b' ∈ IsLocalRing.maximalIdeal S := (IsLocalRing.mem_maximalIdeal _).mpr hb'u
        apply hdom b' hbm (φ * j (↑v⁻¹ : S)) (W.mul_mem _ _ hφW (hWS _))
        calc j b' * (φ * j (↑v⁻¹ : S)) = (φ * j b') * j (↑v⁻¹ : S) := by ring
          _ = 1 := by rw [h2, ← map_mul, ← hv, Units.mul_inv, map_one]
    · have hb'u : IsUnit b' := isUnit_of_mul_isUnit_right hu
      obtain ⟨u, hu'⟩ := hb'u
      refine ⟨a' * ↑u⁻¹, ?_⟩
      have : j b' * j (↑u⁻¹ : S) = 1 := by
        rw [← map_mul, ← hu', Units.mul_inv, map_one]
      calc j (a' * ↑u⁻¹) = φ * j b' * j (↑u⁻¹ : S) := by rw [map_mul, h2]
        _ = φ := by rw [mul_assoc, this, mul_one]

  have s7 : ∀ (S : Type u) [CommRing S] [IsLocalRing S] (L : Type u) [Field L] (j : S →+* L),
      Function.Injective j → ∃ W : ValuationSubring L, (∀ s, j s ∈ W) ∧
        ∀ s ∈ IsLocalRing.maximalIdeal S, ∀ w ∈ W, j s * w ≠ 1 := by
    intro S _ _ L _ j hj
    obtain ⟨W, hW⟩ := LocalSubring.exists_le_valuationSubring (LocalSubring.range j)
    obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hW
    have hmem : ∀ s, j s ∈ W := fun s => hle ⟨s, rfl⟩
    refine ⟨W, hmem, ?_⟩
    intro s hs w hw hsw
    have hunit : IsUnit (Subring.inclusion hle ⟨j s, ⟨s, rfl⟩⟩) := by
      refine isUnit_iff_exists_inv.mpr ⟨(⟨w, hw⟩ : W), ?_⟩
      apply Subtype.ext
      exact hsw
    have hu2 := hloc.map_nonunit _ hunit
    obtain ⟨⟨x, hx⟩, hxi⟩ := hu2.exists_right_inv
    obtain ⟨r, rfl⟩ := hx
    have : j (s * r) = j 1 := by
      rw [map_mul, map_one]
      exact congrArg Subtype.val hxi
    have hsr := hj this
    exact (IsLocalRing.mem_maximalIdeal _).mp hs (isUnit_iff_exists_inv.mpr ⟨r, hsr⟩)

  have s8 : ∀ (C S L : Type u) [CommRing C] [CommRing S] [Field L] (σC : B →+* C) (σS : B →+* S)
      (j : S →+* L) (e : C →+* L) (m : ℕ) (c : Fin m → C), Function.Injective j →
      (∀ x : C, x ∈ Subring.closure (Set.range σC ∪ Set.range c)) → e.comp σC = j.comp σS →
      (∀ l, ∃ s, j s = e (c l)) → ∃ ψ : C →+* S, j.comp ψ = e ∧ ψ.comp σC = σS := by
    intro C S L _ _ _ σC σS j e m c hj hcl he hc
    have hrange : ∀ x : C, e x ∈ j.range := by
      intro x
      have : Subring.closure (Set.range σC ∪ Set.range c) ≤ (j.range).comap e := by
        rw [Subring.closure_le]
        rintro _ (⟨b, rfl⟩ | ⟨l, rfl⟩)
        · show e (σC b) ∈ j.range
          exact ⟨σS b, by rw [← RingHom.comp_apply, ← he, RingHom.comp_apply]⟩
        · obtain ⟨s, hs⟩ := hc l
          exact ⟨s, hs⟩
      exact this (hcl x)
    let ρ : S ≃+* j.range := RingEquiv.ofBijective j.rangeRestrict
      ⟨fun x y h => hj (congrArg Subtype.val h), j.rangeRestrict_surjective⟩
    let ψ : C →+* S := (ρ.symm : j.range →+* S).comp (e.codRestrict j.range hrange)
    have hψ : ∀ x, j (ψ x) = e x := by
      intro x
      have h1 : ρ (ψ x) = e.codRestrict j.range hrange x := by
        simp [ψ]
      exact congrArg Subtype.val h1
    refine ⟨ψ, RingHom.ext hψ, RingHom.ext fun b => hj ?_⟩
    rw [RingHom.comp_apply, hψ, ← RingHom.comp_apply, he, RingHom.comp_apply]

  have s10 : ∀ (K : Type u) [Field K] (σ : B →+* K), Function.Injective σ → ∀ (z : K) (a₀ b₀ : B),
      b₀ ≠ 0 → z * σ b₀ = σ a₀ → ∃ a b : B, b ≠ 0 ∧ (∀ p : B, Irreducible p → ¬ (p ∣ a ∧ p ∣ b)) ∧
        z * σ b = σ a := by
    intro K _ σ hσ z a₀ b₀ hb₀ hz
    obtain ⟨a', b', c, hrel, hca, hcb⟩ := UniqueFactorizationMonoid.exists_reduced_factors' a₀ b₀ hb₀
    have hc0 : c ≠ 0 := by rintro rfl; apply hb₀; rw [← hcb, zero_mul]
    have hb'0 : b' ≠ 0 := by rintro rfl; apply hb₀; rw [← hcb, mul_zero]
    have hσc : σ c ≠ 0 := by
      intro h; apply hc0; apply hσ; rw [h, map_zero]
    refine ⟨a', b', hb'0, fun p hp ⟨h1, h2⟩ => hp.not_isUnit (hrel h1 h2), ?_⟩
    apply mul_left_cancel₀ hσc
    rw [← map_mul, hca, ← hz, ← hcb, map_mul]; ring

  have s11 : ∀ (K L : Type u) [Field K] [Field L] (σ : B →+* K) (τ : B →+* L), Function.Injective σ →
      Function.Injective τ → (∀ z : K, ∃ a b : B, b ≠ 0 ∧ z * σ b = σ a) →
      ∃ ε : K →+* L, ε.comp σ = τ := by
    intro K L _ _ σ τ hσ hτ hfrac
    letI := σ.toAlgebra
    haveI : FaithfulSMul B K := (faithfulSMul_iff_algebraMap_injective B K).mpr hσ
    haveI : IsFractionRing B K := by
      apply IsFractionRing.of_field
      intro z
      obtain ⟨a, b, hb, h⟩ := hfrac z
      refine ⟨a, b, ?_⟩
      have hσb : σ b ≠ 0 := by intro h'; apply hb; apply hσ; rw [h', map_zero]
      show z = σ a / σ b
      rw [eq_div_iff hσb, h]
    exact ⟨IsFractionRing.lift hτ, RingHom.ext fun b => IsFractionRing.lift_algebraMap hτ b⟩

  have sigTop : ∀ {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B)) (z : Z) (b : B),
      wcNdSig h z b = (Z.presheaf.germ ⊤ z trivial).hom
        (h.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b)) := by
    intro Z h z b
    simp only [wcNdSig, wcCnSigma, RingHom.comp_apply]
    erw [TopCat.Presheaf.germ_res_apply]
  have sigStalk : ∀ {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B)) (z : Z) (b : B),
      wcNdSig h z b = (h.stalkMap z).hom (((Scheme.ΓSpecIso (.of B)).inv ≫
        (Spec (.of B)).presheaf.germ ⊤ (h z) trivial).hom b) := by
    intro Z h z b
    have e1 := Scheme.Hom.germ_stalkMap h ⊤ z trivial
    have e2 : (Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop ≫ Z.presheaf.germ ⊤ z trivial =
        ((Scheme.ΓSpecIso (.of B)).inv ≫ (Spec (.of B)).presheaf.germ ⊤ (h z) trivial) ≫
          h.stalkMap z := by
      rw [Category.assoc, e1]; rfl
    rw [sigTop]
    show ((Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop ≫ Z.presheaf.germ ⊤ z trivial).hom b = _
    rw [e2]; rfl
  have sigUnit : ∀ {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B)) (z : Z) (b : B),
      IsUnit (wcNdSig h z b) ↔ b ∉ (h z).asIdeal := by
    intro Z h z b
    rw [sigTop, ← Scheme.mem_basicOpen Z _ z (show z ∈ (⊤ : Z.Opens) from trivial),
      ← Scheme.preimage_basicOpen_top]
    erw [basicOpen_eq_of_affine]
    rfl
  have sigSpec : ∀ {Y : Scheme.{u}} [AlgebraicGeometry.IsIntegral Y] (g : Y ⟶ Spec (.of B)) (y : Y)
      (b : B), wcNdSig g (genericPoint Y) b =
        (Y.presheaf.stalkSpecializes (genericPoint_specializes y)).hom (wcNdSig g y b) := by
    intro Y _ g y b
    simp only [wcNdSig, RingHom.comp_apply]
    erw [TopCat.Presheaf.germ_stalkSpecializes_apply]
  have keyFrom : ∀ {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B)) (z : Z),
      Z.fromSpecStalk z ≫ h = Spec.map (CommRingCat.ofHom (wcNdSig h z)) := by
    intro Z h z
    rw [← Scheme.SpecMap_stalkMap_fromSpecStalk, Spec.fromSpecStalk_eq, ← Spec.map_comp]
    congr 1
    ext b
    have e1 := Scheme.Hom.germ_stalkMap h ⊤ z trivial
    rw [CommRingCat.hom_comp, RingHom.comp_apply, ← CommRingCat.comp_apply, Category.assoc, e1]
    show _ = (Z.presheaf.germ ⊤ z trivial).hom ((Z.presheaf.map (homOfLE (le_top :
      (⊤ : Z.Opens) ≤ ⊤)).op).hom (h.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b)))
    erw [TopCat.Presheaf.germ_res_apply]
    rfl

  have s9gen : ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (g : Y ⟶ Spec (.of B)),
      (∀ b : B, b ≠ 0 → ∃ y : Y, b ∉ (g y).asIdeal) → ∀ y : Y, Function.Injective (wcNdSig g y) := by
    intro Y _ g hd y
    rw [injective_iff_map_eq_zero]
    intro b hb
    by_contra hb0
    obtain ⟨y₀, hy₀⟩ := hd b hb0
    have hη : genericPoint Y ∈ g ⁻¹ᵁ (PrimeSpectrum.basicOpen b) :=
      ((genericPoint_spec Y).mem_open_set_iff (g ⁻¹ᵁ (PrimeSpectrum.basicOpen b)).isOpen).mpr
        ⟨y₀, trivial, hy₀⟩
    have hu : IsUnit (wcNdSig g (genericPoint Y) b) := (sigUnit g _ b).mpr hη
    rw [sigSpec g y, hb, map_zero] at hu
    exact not_isUnit_zero hu
  have domHd : ∀ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of B)), IsDominant g →
      ∀ b : B, b ≠ 0 → ∃ y : Y, b ∉ (g y).asIdeal := by
    intro Y g hg b hb
    have hne : (PrimeSpectrum.basicOpen b : Set (PrimeSpectrum B)).Nonempty :=
      ⟨⟨⊥, inferInstance⟩, (PrimeSpectrum.mem_basicOpen b _).mpr (by simpa using hb)⟩
    obtain ⟨y, hy⟩ := ((isDominant_iff g).mp hg).exists_mem_open
      (PrimeSpectrum.basicOpen b).isOpen hne
    exact ⟨y, hy⟩
  have isoHd : ∀ b : B, b ≠ 0 → ∃ x : X, b ∉ (f x).asIdeal := by
    intro b hb
    obtain ⟨U, hU0, hiso⟩ := hU
    have hne : (PrimeSpectrum.basicOpen b : Set (PrimeSpectrum B)).Nonempty :=
      ⟨⟨⊥, inferInstance⟩, (PrimeSpectrum.mem_basicOpen b _).mpr (by simpa using hb)⟩
    obtain ⟨p, hpb, hpU⟩ := nonempty_preirreducible_inter (PrimeSpectrum.basicOpen b).isOpen
      U.isOpen hne ((TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU0)
    let q : U.toScheme := ⟨p, hpU⟩
    let x := (inv (f ∣_ U)) q
    have hx : (f ∣_ U) x = q := by
      rw [← Scheme.Hom.comp_apply, IsIso.inv_hom_id]; rfl
    refine ⟨x.1, ?_⟩
    rw [← morphismRestrict_base_coe, hx]
    exact hpb

  have s1frac : ∀ z : X.presheaf.stalk (genericPoint X), ∃ a b : B, b ≠ 0 ∧
      z * wcNdSig f (genericPoint X) b = wcNdSig f (genericPoint X) a := by
    obtain ⟨U, hU0, hiso⟩ := hU
    have hηU : genericPoint X ∈ f ⁻¹ᵁ U := by
      obtain ⟨p, hp⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU0
      let q : U.toScheme := ⟨p, hp⟩
      let x := (inv (f ∣_ U)) q
      exact ((genericPoint_spec X).mem_open_set_iff (f ⁻¹ᵁ U).isOpen).mpr ⟨x.1, trivial, x.2⟩
    have hst : IsIso (f.stalkMap (genericPoint X)) := by
      let x0 : (f ⁻¹ᵁ U).toScheme := ⟨genericPoint X, hηU⟩
      have e := morphismRestrictStalkMap f U x0
      haveI : IsIso ((f ∣_ U).stalkMap x0) := inferInstance
      exact ((MorphismProperty.isomorphisms CommRingCat).arrow_mk_iso_iff e).mp this
    intro z
    let p : PrimeSpectrum B := f (genericPoint X)
    obtain ⟨⟨a, s⟩, hs⟩ := @IsLocalization.surj B _ p.asIdeal.primeCompl
      ((Spec.structureSheaf B).presheaf.stalk p) _ (StructureSheaf.stalkAlgebra B p)
      (StructureSheaf.IsLocalization.to_stalk B p) ((inv (f.stalkMap (genericPoint X))).hom z)
    refine ⟨a, s, ?_, ?_⟩
    · intro h0; apply s.2; rw [h0]; exact Ideal.zero_mem _
    · rw [sigStalk, sigStalk]
      have h2 := congrArg (f.stalkMap (genericPoint X)).hom hs
      erw [map_mul] at h2
      have h3 : (f.stalkMap (genericPoint X)).hom
          ((inv (f.stalkMap (genericPoint X))).hom z) = z := by
        rw [← CommRingCat.comp_apply, IsIso.inv_hom_id]; rfl
      rw [h3] at h2
      exact h2

  have s2 : ∃ (n : ℕ) (V : Fin n → X.Opens) (k : Fin n → ℕ) (c : ∀ i, Fin (k i) → Γ(X, V i)),
      (∀ i, IsAffineOpen (V i)) ∧ (∀ i, genericPoint X ∈ V i) ∧ (∀ x : X, ∃ i, x ∈ V i) ∧
      ∀ i (s : Γ(X, V i)), s ∈ Subring.closure (Set.range (wcCnSigma f (V i)) ∪ Set.range (c i)) := by
    haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
    have hb : ∀ x : X, ∃ U ∈ X.affineOpens, x ∈ U ∧ U ≤ ⊤ := fun x =>
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
        (show x ∈ (⊤ : X.Opens) from trivial)
    choose Vx hVx hxV _ using hb
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (Vx x : Set X))
      (fun x => (Vx x).isOpen) (fun x _ => Set.mem_iUnion.mpr ⟨x, hxV x⟩)
    let V : Fin t.card → X.Opens := fun i => Vx (t.equivFin.symm i).1
    have hVaff : ∀ i, IsAffineOpen (V i) := fun i => hVx _
    have hfin : ∀ i, (wcCnSigma f (V i)).FiniteType := by
      intro i
      have hcn : wcCnSigma f (V i) =
          (f.appLE ⊤ (V i) le_top).hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom := rfl
      rw [hcn]
      have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType f inferInstance
        ⟨⊤, isAffineOpen_top _⟩ ⟨V i, hVaff i⟩ le_top
      exact RingHom.FiniteType.comp h1 (RingHom.FiniteType.of_surjective _
        (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of B)).inv).2)
    have hgen : ∀ i, ∃ s : Finset Γ(X, V i), ∀ x : Γ(X, V i),
        x ∈ Subring.closure (Set.range (wcCnSigma f (V i)) ∪ (s : Set Γ(X, V i))) := by
      intro i
      letI := (wcCnSigma f (V i)).toAlgebra
      have hft : Algebra.FiniteType B Γ(X, V i) := hfin i
      obtain ⟨s, hs⟩ := hft.out
      refine ⟨s, fun x => ?_⟩
      have h2 := Algebra.adjoin_eq_ring_closure (R := B) (A := Γ(X, V i)) (s : Set Γ(X, V i))
      rw [hs] at h2
      have h3 : x ∈ (⊤ : Subalgebra B Γ(X, V i)).toSubring := trivial
      rw [h2] at h3
      exact h3
    choose s hs using hgen
    refine ⟨t.card, V, fun i => (s i).card, fun i j => ((s i).equivFin.symm j).1, hVaff, ?_, ?_, ?_⟩
    · intro i
      exact ((genericPoint_spec X).mem_open_set_iff (V i).isOpen).mpr
        ⟨(t.equivFin.symm i).1, trivial, hxV _⟩
    · intro x
      have := ht (Set.mem_univ x)
      simp only [Set.mem_iUnion] at this
      obtain ⟨y, hy, hxy⟩ := this
      exact ⟨t.equivFin ⟨y, hy⟩, by simpa [V] using hxy⟩
    · intro i x
      refine Subring.closure_mono ?_ (hs i x)
      apply Set.union_subset_union_right
      intro z hz
      exact ⟨(s i).equivFin ⟨z, hz⟩, by simp⟩

  have s3 : ∀ (L : Type u) [Field L] (ε : X.functionField →+* L) (W : ValuationSubring L),
      (∀ b : B, ε (wcNdSig f (genericPoint X) b) ∈ W) → ∃ x : X, ∀ (V : X.Opens) (hx : x ∈ V)
        (t : Γ(X, V)), ε ((X.presheaf.germ V (genericPoint X)
          ((genericPoint_specializes x).mem_open V.isOpen hx)).hom t) ∈ W := by
    intro L _ ε W hW
    let W' : ValuationSubring X.functionField := W.comap ε
    have hW' : ∀ b, wcNdSig f (genericPoint X) b ∈ W' := hW
    let β : B →+* W' :=
      { toFun := fun b => ⟨wcNdSig f (genericPoint X) b, hW' b⟩
        map_one' := Subtype.ext (map_one _)
        map_mul' := fun a b => Subtype.ext (map_mul _ a b)
        map_zero' := Subtype.ext (map_zero _)
        map_add' := fun a b => Subtype.ext (map_add _ a b) }
    have hsq : CommSq (X.fromSpecStalk (genericPoint X))
        (Spec.map (CommRingCat.ofHom (algebraMap W' X.functionField))) f
        (Spec.map (CommRingCat.ofHom β)) := by
      constructor
      rw [keyFrom]
      refine Eq.trans ?_ (Spec.map_comp _ _)
      rfl
    have hVC : ValuativeCriterion f := by
      have h := hf
      rw [IsProper.eq_valuativeCriterion] at h
      exact h.1.1.1
    let S : ValuativeCommSq f := ⟨W', X.functionField, _, _, hsq⟩
    obtain ⟨⟨l, hl1, -⟩⟩ := ValuativeCriterion.existence hVC S
    refine ⟨l (IsLocalRing.closedPoint W'), ?_⟩
    intro V hx t
    have e1 := Scheme.Spec_stalkClosedPointTo_fromSpecStalk l
    have e2 := Scheme.SpecMap_stalkSpecializes_fromSpecStalk
      (genericPoint_specializes (l (IsLocalRing.closedPoint W')))
    have e3 : Spec.map (Scheme.stalkClosedPointTo l ≫
        CommRingCat.ofHom (algebraMap W' X.functionField)) ≫
        X.fromSpecStalk (l (IsLocalRing.closedPoint W')) =
        Spec.map (X.presheaf.stalkSpecializes
          (genericPoint_specializes (l (IsLocalRing.closedPoint W')))) ≫
        X.fromSpecStalk (l (IsLocalRing.closedPoint W')) := by
      rw [e2, Spec.map_comp, Category.assoc, e1]
      exact hl1
    have e4 := Spec.map_injective (cancel_mono _ |>.mp e3)
    have e5 := TopCat.Presheaf.germ_stalkSpecializes X.presheaf hx
      (genericPoint_specializes (l (IsLocalRing.closedPoint W')))
    show ε ((X.presheaf.germ V (genericPoint X) _).hom t) ∈ W
    rw [← e5, CommRingCat.hom_comp, RingHom.comp_apply, ← e4]
    exact ((Scheme.stalkClosedPointTo l).hom ((X.presheaf.germ V _ hx).hom t)).2

  have s5 : ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (g : Y ⟶ Spec (.of B))
      (ε : X.functionField ⟶ Y.functionField) (V : X.Opens), IsAffineOpen V →
      ∀ (hηV : genericPoint X ∈ V) (y : Y) (ψ : Γ(X, V) ⟶ Y.presheaf.stalk y),
      ψ.hom.comp (wcCnSigma f V) = wcNdSig g y →
      ψ ≫ Y.presheaf.stalkSpecializes (genericPoint_specializes y) =
        X.presheaf.germ V (genericPoint X) hηV ≫ ε →
      ∃ (O : Y.Opens) (_ : y ∈ O) (h : O.toScheme ⟶ X), h ≫ f = O.ι ≫ g ∧
        ∀ hηO : genericPoint Y ∈ O, O.fromSpecStalkOfMem (genericPoint Y) hηO ≫ h =
          Spec.map ε ≫ X.fromSpecStalk (genericPoint X) := by
    intro Y _ g ε V hV hηV y ψ h1 h2
    have hφ : (Spec.map ψ ≫ hV.fromSpec) ≫ f = Y.fromSpecStalk y ≫ g := by
      rw [keyFrom, Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec f (isAffineOpen_top _) hV
        le_top, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp,
        ← Spec.map_comp, ← h1]
      rfl
    obtain ⟨O, hyO, h, hφh, hhf⟩ := spread_out_of_isGermInjective' g f (Spec.map ψ ≫ hV.fromSpec) hφ
    refine ⟨O, hyO, h, hhf, fun hηO => ?_⟩
    have e1 : O.fromSpecStalkOfMem (genericPoint Y) hηO =
        Spec.map (Y.presheaf.stalkSpecializes (genericPoint_specializes y)) ≫
          O.fromSpecStalkOfMem y hyO := by
      rw [← cancel_mono O.ι, Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι,
        Scheme.Opens.fromSpecStalkOfMem_ι, Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
    rw [e1, Category.assoc, ← hφh, ← Category.assoc, ← Spec.map_comp, h2, Spec.map_comp,
      Category.assoc, ← IsAffineOpen.fromSpecStalk.eq_1, IsAffineOpen.fromSpecStalk_eq_fromSpecStalk]

  have s6 : ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (g : Y ⟶ Spec (.of B))
      (γ : Spec Y.functionField ⟶ X), (∀ y : Y, ∃ (O : Y.Opens) (_ : y ∈ O) (h : O.toScheme ⟶ X),
        h ≫ f = O.ι ≫ g ∧ ∀ hηO : genericPoint Y ∈ O,
          O.fromSpecStalkOfMem (genericPoint Y) hηO ≫ h = γ) → ∃ h : Y ⟶ X, h ≫ f = g := by
    intro Y _ g γ H
    choose O hyO h hf' hgen using H
    have hcov : TopologicalSpace.IsOpenCover O := by
      rw [TopologicalSpace.IsOpenCover, eq_top_iff]
      intro y _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨y, hyO y⟩
    have hη : ∀ y, genericPoint Y ∈ O y := fun y =>
      ((genericPoint_spec Y).mem_open_set_iff (O y).isOpen).mpr ⟨y, trivial, hyO y⟩
    let 𝒰 := Y.openCoverOfIsOpenCover O hcov
    have hglue' : ∀ x y : Y, Limits.pullback.fst (O x).ι (O y).ι ≫ h x =
        Limits.pullback.snd (O x).ι (O y).ι ≫ h y := by
      intro x y
      haveI : AlgebraicGeometry.IsReduced (O x).toScheme := isReduced_of_isOpenImmersion (O x).ι
      haveI : AlgebraicGeometry.IsReduced (Limits.pullback (O x).ι (O y).ι) :=
        isReduced_of_isOpenImmersion (Limits.pullback.fst (O x).ι (O y).ι)
      let ι : Spec Y.functionField ⟶ Limits.pullback (O x).ι (O y).ι :=
        Limits.pullback.lift ((O x).fromSpecStalkOfMem _ (hη x)) ((O y).fromSpecStalkOfMem _ (hη y))
          (by rw [Scheme.Opens.fromSpecStalkOfMem_ι, Scheme.Opens.fromSpecStalkOfMem_ι])
      haveI : IsDominant ι := by
        haveI : IsDominant (ι ≫ Limits.pullback.fst (O x).ι (O y).ι ≫ (O x).ι) := by
          rw [Limits.pullback.lift_fst_assoc, Scheme.Opens.fromSpecStalkOfMem_ι, isDominant_iff]
          apply Dense.mono (s₁ := {genericPoint Y})
          · rintro _ rfl
            exact ⟨_, Scheme.fromSpecStalk_closedPoint⟩
          · rw [dense_iff_closure_eq]
            exact (genericPoint_spec Y)
        exact IsDominant.of_comp_of_isOpenImmersion ι (Limits.pullback.fst (O x).ι (O y).ι ≫ (O x).ι)
      refine ext_of_isDominant_of_isSeparated f ?_ ι ?_
      · rw [Category.assoc, Category.assoc, hf', hf', ← Category.assoc, Limits.pullback.condition,
          Category.assoc]
      · rw [Limits.pullback.lift_fst_assoc, Limits.pullback.lift_snd_assoc, hgen, hgen]
    have hglue : ∀ x y : 𝒰.I₀, Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ (h x : 𝒰.X x ⟶ X) =
        Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ (h y : 𝒰.X y ⟶ X) := fun x y => hglue' x y
    refine ⟨𝒰.glueMorphisms (fun x => (h x : 𝒰.X x ⟶ X)) hglue, 𝒰.hom_ext _ _ (fun x => ?_)⟩
    have e := 𝒰.ι_glueMorphisms (fun x => (h x : 𝒰.X x ⟶ X)) hglue x
    rw [← Category.assoc, e]
    exact hf' x

  obtain ⟨n, V, k, c, hVaff, hηV, hcov, hgen⟩ := s2
  have hσinj : Function.Injective (wcNdSig f (genericPoint X)) := s9gen X f isoHd (genericPoint X)
  have hred : ∀ i (l : Fin (k i)), ∃ a b : B, b ≠ 0 ∧ (∀ p : B, Irreducible p → ¬ (p ∣ a ∧ p ∣ b)) ∧
      (X.presheaf.germ (V i) (genericPoint X) (hηV i)).hom (c i l) * wcNdSig f (genericPoint X) b =
        wcNdSig f (genericPoint X) a := by
    intro i l
    obtain ⟨a₀, b₀, hb₀, h⟩ := s1frac ((X.presheaf.germ (V i) (genericPoint X) (hηV i)).hom (c i l))
    exact s10 X.functionField (wcNdSig f (genericPoint X)) hσinj _ a₀ b₀ hb₀ h
  choose A Bd hBd hcop hAB using hred
  let e : (i : Fin n) × Fin (k i) ≃ Fin (∑ i, k i) := finSigmaFinEquiv
  refine ⟨∑ i, k i, fun l => A (e.symm l).1 (e.symm l).2, fun l => Bd (e.symm l).1 (e.symm l).2,
    fun l => hBd _ _, fun l => hcop _ _, ?_⟩
  intro Y g hY hg hprin
  haveI := hY
  have hinj : ∀ y, Function.Injective (wcNdSig g y) := s9gen Y g (domHd Y g hg)
  obtain ⟨ε, hε⟩ := s11 X.functionField Y.functionField (wcNdSig f (genericPoint X))
    (wcNdSig g (genericPoint Y)) hσinj (hinj _) s1frac
  have hloc : ∀ y : Y, ∃ (O : Y.Opens) (_ : y ∈ O) (h : O.toScheme ⟶ X), h ≫ f = O.ι ≫ g ∧
      ∀ hηO : genericPoint Y ∈ O, O.fromSpecStalkOfMem (genericPoint Y) hηO ≫ h =
        Spec.map (CommRingCat.ofHom ε) ≫ X.fromSpecStalk (genericPoint X) := by
    intro y
    obtain ⟨j, hjdef⟩ : ∃ j : Y.presheaf.stalk y →+* Y.functionField,
        j = (Y.presheaf.stalkSpecializes (genericPoint_specializes y)).hom := ⟨_, rfl⟩
    have hcomp : ∀ b, wcNdSig g (genericPoint Y) b = j (wcNdSig g y b) := fun b => by
      rw [hjdef]; exact sigSpec g y b
    have hj : Function.Injective j := by
      rw [hjdef]; exact IsFractionRing.injective (Y.presheaf.stalk y) Y.functionField
    obtain ⟨W, hWS, hWdom⟩ := s7 (Y.presheaf.stalk y) Y.functionField j hj
    obtain ⟨x, hx⟩ := s3 Y.functionField ε W (fun b => by
      rw [← RingHom.comp_apply, hε, hcomp]; exact hWS _)
    obtain ⟨i, hi⟩ := hcov x
    have hzW : ∀ l, ε ((X.presheaf.germ (V i) (genericPoint X) (hηV i)).hom (c i l)) ∈ W :=
      fun l => hx (V i) hi (c i l)
    have hlift : ∀ l, ∃ s, j s = ε ((X.presheaf.germ (V i) (genericPoint X) (hηV i)).hom (c i l)) := by
      intro l
      have hp0 : ∀ σ : (i : Fin n) × Fin (k i), σ = e.symm (e ⟨i, l⟩) →
          (Ideal.span {wcNdSig g y (A σ.1 σ.2), wcNdSig g y (Bd σ.1 σ.2)}).IsPrincipal := by
        intro σ hσ
        subst hσ
        have h0 := hprin y (e ⟨i, l⟩)
        rw [Ideal.map_span, Set.image_pair] at h0
        exact h0
      have hp := hp0 ⟨i, l⟩ (e.symm_apply_apply _).symm
      refine s4 (Y.presheaf.stalk y) Y.functionField j hj W hWS hWdom (wcNdSig g y (A i l))
        (wcNdSig g y (Bd i l)) ?_ hp _ ?_ (hzW l)
      · intro h0; apply hBd i l; apply hinj y; rw [h0, map_zero]
      · rw [← hcomp, ← hcomp, ← hε, RingHom.comp_apply, RingHom.comp_apply, ← map_mul, hAB]
    choose sl hsl using hlift
    have hcompat : (ε.comp (X.presheaf.germ (V i) (genericPoint X) (hηV i)).hom).comp
        (wcCnSigma f (V i)) = j.comp (wcNdSig g y) := by
      ext b
      rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, ← hcomp, ← hε,
        RingHom.comp_apply, sigTop]
      congr 1
      simp only [wcCnSigma, RingHom.comp_apply]
      erw [TopCat.Presheaf.germ_res_apply]
    obtain ⟨ψ, hψ1, hψ2⟩ := s8 Γ(X, V i) (Y.presheaf.stalk y) Y.functionField (wcCnSigma f (V i))
      (wcNdSig g y) j (ε.comp (X.presheaf.germ (V i) (genericPoint X) (hηV i)).hom) (k i) (c i) hj
      (hgen i) hcompat (fun l => ⟨sl l, hsl l⟩)
    refine s5 Y g (CommRingCat.ofHom ε) (V i) (hVaff i) (hηV i) y (CommRingCat.ofHom ψ) hψ2 ?_
    ext t
    have h0 := RingHom.congr_fun hψ1 t
    rw [hjdef] at h0
    exact h0
  exact s6 Y g _ hloc

theorem fexr_blowup_isProper : ∀ (X X' : Scheme.{u}) [IsLocallyNoetherian X] (I : X.IdealSheafData) (r : X' ⟶ X), wcCsdIsBlowup I r → IsProper r :=
by
  intro X X' _ I r hbl
  refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsProper)
    (fun W : X.affineOpens => (W : X.Opens)) (iSup_affineOpens_eq_top X) ?_
  intro W
  haveI hWa : IsAffine W.1.toScheme := W.2
  have hK := wcpa_dj_nc_blowup_flat_basechange X X' W.1.toScheme I r W.1.ι inferInstance hbl
  set K := I.comap W.1.ι with hKdef
  have hKeq : K = Scheme.IdealSheafData.ofIdealTop (K.ideal ⟨⊤, isAffineOpen_top _⟩) := by
    have h1 := (Scheme.IdealSheafData.equivOfIsAffine (X := W.1.toScheme)).symm_apply_apply K
    rw [Scheme.IdealSheafData.equivOfIsAffine_apply,
      Scheme.IdealSheafData.equivOfIsAffine_symm_apply] at h1
    exact h1.symm
  haveI hnoeth : IsNoetherianRing Γ(W.1.toScheme, ⊤) :=
    IsLocallyNoetherian.component_noetherian (X := W.1.toScheme) ⟨⊤, isAffineOpen_top _⟩
  have hfg : (K.ideal ⟨⊤, isAffineOpen_top _⟩).FG := IsNoetherian.noetherian _
  obtain ⟨n, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hK' : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g)))
      (Limits.pullback.snd r W.1.ι) := by
    have e : Ideal.span (Set.range g) = K.ideal ⟨⊤, isAffineOpen_top _⟩ := hg
    rw [e, ← hKeq]
    exact hK
  obtain ⟨U, t, hCH⟩ := wc_bp_blowup_charts g _ hK'
  obtain ⟨hqc, hqs, hlft⟩ := wc_bp_charts_finiteness g _ U t hCH
  have hV : ValuativeCriterion (Limits.pullback.snd r W.1.ι) := by
    rw [ValuativeCriterion.eq]
    exact ⟨wc_bp_charts_val_exist g _ U t hCH, wc_bp_charts_val_unique g _ U t hCH⟩
  haveI : IsProper (Limits.pullback.snd r W.1.ι) := IsProper.of_valuativeCriterion _ hV
  have he := (isPullback_morphismRestrict r W.1).flip.isoPullback_hom_snd
  rw [← he]
  infer_instance

theorem fexr_blowup_isIntegral : ∀ (X X' : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] (I : X.IdealSheafData) (r : X' ⟶ X), wcCsdIsBlowup I r → (I.support : Set X) ≠ Set.univ → AlgebraicGeometry.IsIntegral X' :=
by

  have isoOff : ∀ (X X' : Scheme.{u}) (I : X.IdealSheafData) (r : X' ⟶ X) (W : X.Opens), wcCsdIsBlowup I r → (I.support : Set X) ∩ (W : Set X) = ∅ → IsIso (r ∣_ W) := by
    intro X X' I r W hb hW
    obtain ⟨-, hUniq⟩ := hb

    have H : ∀ (T : Scheme.{u}) (h : T ⟶ X), (∀ t : T, h t ∉ (I.support : Set X)) →
        wcCsdInvPull I h := by
      intro T h hh t
      obtain ⟨U₀, hU₀, hxU₀, -⟩ :=
        exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := h t) trivial
      have hns : h t ∉ X.zeroLocus (U := U₀) (I.ideal ⟨U₀, hU₀⟩ : Set Γ(X, U₀)) := by
        rw [← Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U₀, hU₀⟩) hxU₀]
        exact hh t
      rw [Scheme.mem_zeroLocus_iff] at hns
      push_neg at hns
      obtain ⟨a, haI, hxa⟩ := hns
      have htD : t ∈ h ⁻¹ᵁ X.basicOpen a := (Scheme.Hom.mem_preimage h).mpr hxa
      obtain ⟨V₀, hV₀, htV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset htD
      have hVD : V₀ ≤ h ⁻¹ᵁ X.basicOpen a := hV₀sub
      have hVU : V₀ ≤ h ⁻¹ᵁ U₀ := hVD.trans (Scheme.Hom.preimage_mono h (X.basicOpen_le a))
      refine ⟨⟨U₀, hU₀⟩, ⟨V₀, hV₀⟩, hVU, a, htV₀, haI, ?_⟩
      have hbo : T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) = V₀ := by
        rw [Scheme.basicOpen_appLE]
        exact inf_eq_left.mpr hVD
      have hunit : IsUnit ((h.appLE U₀ V₀ hVU).hom a) := by
        apply RingedSpace.isUnit_of_isUnit_germ T.toRingedSpace V₀
        intro y hy
        have hy' : y ∈ T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) := by rw [hbo]; exact hy
        exact (T.mem_basicOpen _ y hy).mp hy'
      refine ⟨hunit.mem_nonZeroDivisors, ?_⟩
      rw [Ideal.span_singleton_eq_top.mpr hunit]
      exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ haI) hunit
    have memι : ∀ (V : X'.Opens) (z : V.toScheme), V.ι z ∈ V := by
      intro V z
      have hz : V.ι z ∈ Set.range V.ι := ⟨z, rfl⟩
      rwa [Scheme.Opens.range_ι] at hz
    have memW : ∀ y : W.toScheme, W.ι y ∈ W := by
      intro y
      have hy : W.ι y ∈ Set.range W.ι := ⟨y, rfl⟩
      rwa [Scheme.Opens.range_ι] at hy
    have hWav : ∀ y : W.toScheme, W.ι y ∉ (I.support : Set X) := by
      intro y hy
      have hmem : W.ι y ∈ (I.support : Set X) ∩ (W : Set X) := ⟨hy, memW y⟩
      rw [hW] at hmem
      exact hmem
    obtain ⟨s, hs, -⟩ := hUniq W.toScheme W.ι (H _ _ hWav)
    have hrange : Set.range s ⊆ Set.range (r ⁻¹ᵁ W).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      show s y ∈ r ⁻¹ᵁ W
      rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hs]
      exact memW y
    haveI : Mono W.ι := IsOpenImmersion.mono W.ι
    haveI : Mono (r ⁻¹ᵁ W).ι := IsOpenImmersion.mono (r ⁻¹ᵁ W).ι
    let s' := IsOpenImmersion.lift (r ⁻¹ᵁ W).ι s hrange
    have hs' : s' ≫ (r ⁻¹ᵁ W).ι = s := IsOpenImmersion.lift_fac _ _ _
    have h4 : s' ≫ (r ∣_ W) = 𝟙 _ := by
      rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, reassoc_of% hs', hs,
        Category.id_comp]
    have hιav : ∀ z : (r ⁻¹ᵁ W).toScheme, ((r ⁻¹ᵁ W).ι ≫ r) z ∉ (I.support : Set X) := by
      intro z hz
      have hz1 : (r ⁻¹ᵁ W).ι z ∈ r ⁻¹ᵁ W := memι (r ⁻¹ᵁ W) z
      rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply] at hz1
      have hmem : ((r ⁻¹ᵁ W).ι ≫ r) z ∈ (I.support : Set X) ∩ (W : Set X) := ⟨hz, hz1⟩
      rw [hW] at hmem
      exact hmem
    have hh := H _ _ hιav
    have h5 : (r ∣_ W) ≫ s' = 𝟙 _ := by
      rw [← cancel_mono (r ⁻¹ᵁ W).ι, Category.id_comp]
      apply (hUniq _ _ hh).unique
      · simp only [Category.assoc]
        rw [reassoc_of% hs', hs, morphismRestrict_ι]
      · rfl
    exact IsIso.mk ⟨s', h5, h4⟩

  have schemDense : ∀ (X X' : Scheme.{u}) (I : X.IdealSheafData) (r : X' ⟶ X) (W : X.Opens), wcCsdInvPull I r → (W : Set X) = (I.support : Set X)ᶜ → (∀ O : X'.Opens, Function.Injective (X'.presheaf.map (homOfLE (inf_le_left : O ⊓ r ⁻¹ᵁ W ≤ O)).op)) ∧ Dense ((r ⁻¹ᵁ W : X'.Opens) : Set X') := by
    intro X X' I r W hinv hW

    have hloc : ∀ y : X', ∃ (V : X'.affineOpens) (c : Γ(X', V.1)), y ∈ V.1 ∧
        c ∈ nonZeroDivisors Γ(X', V.1) ∧ X'.basicOpen c ≤ r ⁻¹ᵁ W := by
      intro y
      obtain ⟨U, V, hVU, a, hyV, haI, hnzd, -⟩ := hinv y
      refine ⟨V, _, hyV, hnzd, ?_⟩
      rw [Scheme.basicOpen_appLE]
      intro x hx
      have hx2 : r x ∈ X.basicOpen a := hx.2
      show r x ∈ (W : Set X)
      rw [hW]
      intro hsupp
      have hU : r x ∈ (U.1 : Set X) := X.basicOpen_le a hx2
      have hz := (Scheme.IdealSheafData.mem_support_iff_of_mem hU).mp hsupp
      exact (X.mem_zeroLocus_iff _ _).mp hz a haI hx2

    have hcomp : ∀ {A B C : X'.Opens} (i : Opposite.op A ⟶ Opposite.op B)
        (j : Opposite.op B ⟶ Opposite.op C) (z : Γ(X', A)),
        (X'.presheaf.map j).hom ((X'.presheaf.map i).hom z) = (X'.presheaf.map (i ≫ j)).hom z := by
      intro A B C i j z
      rw [Functor.map_comp]
      rfl

    have hinj : ∀ O : X'.Opens,
        Function.Injective (X'.presheaf.map (homOfLE (inf_le_left : O ⊓ r ⁻¹ᵁ W ≤ O)).op) := by
      intro O
      have key : ∀ s : Γ(X', O),
          (X'.presheaf.map (homOfLE (inf_le_left : O ⊓ r ⁻¹ᵁ W ≤ O)).op).hom s = 0 → s = 0 := by
        intro s hs
        apply TopCat.Presheaf.section_ext X'.sheaf O s 0
        intro x hxO
        obtain ⟨V, c, hxV, hc, hcW⟩ := hloc x
        obtain ⟨f, hfO, hxf⟩ := V.2.exists_basicOpen_le (V := O) ⟨x, hxO⟩ hxV
        have hDV : X'.basicOpen f ≤ V.1 := X'.basicOpen_le f
        have hDaff : IsAffineOpen (X'.basicOpen f) := V.2.basicOpen f
        obtain ⟨c', hc'def⟩ : ∃ c' : Γ(X', X'.basicOpen f),
            c' = (X'.presheaf.map (homOfLE hDV).op).hom c := ⟨_, rfl⟩
        have hc' : c' ∈ nonZeroDivisors Γ(X', X'.basicOpen f) := by
          have := V.2.isLocalization_basicOpen f
          rw [hc'def]
          exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers f) Γ(X', X'.basicOpen f)
            ⟨c, hc, rfl⟩
        have hc'eq : X'.basicOpen c' = X'.basicOpen f ⊓ X'.basicOpen c := by
          rw [hc'def]
          exact X'.basicOpen_res c (homOfLE hDV).op
        have hle : X'.basicOpen c' ≤ O ⊓ r ⁻¹ᵁ W := by
          rw [hc'eq]
          exact le_inf (inf_le_left.trans hfO) (inf_le_right.trans hcW)
        obtain ⟨t, ht_def⟩ : ∃ t : Γ(X', X'.basicOpen f),
            t = (X'.presheaf.map (homOfLE hfO).op).hom s := ⟨_, rfl⟩
        have ht : (X'.presheaf.map (homOfLE (X'.basicOpen_le c')).op).hom t = 0 := by
          have e : (X'.presheaf.map (homOfLE (X'.basicOpen_le c')).op).hom t =
              (X'.presheaf.map (homOfLE hle).op).hom
                ((X'.presheaf.map (homOfLE (inf_le_left : O ⊓ r ⁻¹ᵁ W ≤ O)).op).hom s) := by
            rw [ht_def, hcomp, hcomp]
            rfl
          rw [e, hs, map_zero]
        obtain ⟨n, hn⟩ :=
          exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen X' hDaff t c' ht
        have ht0 : t = 0 := (mul_left_mem_nonZeroDivisors_eq_zero_iff (pow_mem hc' n)).mp hn
        have hg := TopCat.Presheaf.germ_res_apply X'.presheaf (homOfLE hfO) x hxf s
        show (X'.presheaf.germ O x hxO).hom s = (X'.presheaf.germ O x hxO).hom 0
        rw [map_zero]
        erw [← hg]
        rw [← ht_def, ht0, map_zero]
      intro a b hab
      have h0 := key (a - b) (by
        rw [map_sub]
        exact sub_eq_zero.mpr hab)
      exact sub_eq_zero.mp h0

    refine ⟨hinj, ?_⟩
    rw [dense_iff_inter_open]
    intro U hU hne
    by_contra hempty
    rw [Set.not_nonempty_iff_eq_empty] at hempty
    let O : X'.Opens := ⟨U, hU⟩
    have hbot : O ⊓ r ⁻¹ᵁ W = ⊥ := TopologicalSpace.Opens.ext hempty
    have : Nonempty O := (Scheme.Opens.nonempty_iff O).mpr hne
    have hnt : Nontrivial Γ(X', O) := X'.component_nontrivial O
    have hsub : Subsingleton Γ(X', O ⊓ r ⁻¹ᵁ W) := by
      rw [hbot]; infer_instance
    apply (one_ne_zero : (1 : Γ(X', O)) ≠ 0)
    apply hinj O
    exact Subsingleton.elim _ _
  intro X X' _ I r hbl hne

  let W : X.Opens := ⟨(I.support : Set X)ᶜ, I.support.isClosed.isOpen_compl⟩
  obtain ⟨x₀, hx₀⟩ : ∃ x, x ∉ (I.support : Set X) := by
    by_contra h
    push_neg at h
    exact hne (Set.eq_univ_of_forall h)
  haveI hWne : Nonempty W.toScheme := ⟨⟨x₀, hx₀⟩⟩

  haveI hiso : IsIso (r ∣_ W) := isoOff X X' I r W hbl (Set.inter_compl_self _)

  obtain ⟨hinj, hdense⟩ := schemDense X X' I r W hbl.1 rfl

  haveI hWint : AlgebraicGeometry.IsIntegral W.toScheme := isIntegral_of_isOpenImmersion W.ι
  haveI hU0int : AlgebraicGeometry.IsIntegral (r ⁻¹ᵁ W).toScheme :=
    AlgebraicGeometry.IsIntegral.of_isIso (inv (r ∣_ W))

  obtain ⟨p⟩ := (AlgebraicGeometry.IsIntegral.nonempty : Nonempty (r ⁻¹ᵁ W).toScheme)
  haveI : Nonempty X' := ⟨p.1⟩

  refine ⟨inferInstance, ?_⟩
  intro U hU
  obtain ⟨pt⟩ := hU
  obtain ⟨x, hxU, hxU0⟩ := hdense.inter_open_nonempty (U : Set X') U.isOpen ⟨pt.1, pt.2⟩
  let O' : X'.Opens := U ⊓ r ⁻¹ᵁ W
  have hO'le : O' ≤ (r ⁻¹ᵁ W).ι.opensRange := by
    rw [Scheme.Opens.opensRange_ι]
    exact inf_le_right
  haveI hiso2 : IsIso ((r ⁻¹ᵁ W).ι.app O') := Scheme.Hom.isIso_app _ O' hO'le
  obtain ⟨y, hy⟩ : x ∈ Set.range (r ⁻¹ᵁ W).ι := by
    rw [Scheme.Opens.range_ι]
    exact hxU0
  have hmem : y ∈ (r ⁻¹ᵁ W).ι ⁻¹ᵁ O' := by
    rw [Scheme.Hom.mem_preimage, hy]
    exact ⟨hxU, hxU0⟩
  haveI : Nonempty ((r ⁻¹ᵁ W).ι ⁻¹ᵁ O') := ⟨⟨y, hmem⟩⟩
  haveI hdom : IsDomain Γ((r ⁻¹ᵁ W).toScheme, (r ⁻¹ᵁ W).ι ⁻¹ᵁ O') :=
    AlgebraicGeometry.IsIntegral.component_integral _
  have h2 : Function.Injective ((r ⁻¹ᵁ W).ι.app O').hom :=
    (asIso ((r ⁻¹ᵁ W).ι.app O')).commRingCatIsoToRingEquiv.injective
  have hg : Function.Injective (((r ⁻¹ᵁ W).ι.app O').hom.comp
      (X'.presheaf.map (homOfLE (inf_le_left : U ⊓ r ⁻¹ᵁ W ≤ U)).op).hom) :=
    h2.comp (hinj U)
  exact hg.isDomain _

theorem fexr_chart_regular : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (𝔭 : Ideal A) [𝔭.IsMaximal], IsRegularLocalRing (Localization.AtPrime 𝔭) → ringKrullDim (Localization.AtPrime 𝔭) = 2 → ∀ (u v : A), 𝔭 = Ideal.span {u, v} → ∀ (C : Type u) [CommRing C] [IsDomain C] (φ : A →+* C), Function.Injective φ → ∀ (t : C), φ u * t = φ v → (∀ c : C, c ∈ Subring.closure (Set.range φ ∪ {t})) → ∀ (P : Ideal C) [P.IsPrime], Ideal.comap φ P = 𝔭 → IsRegularLocalRing (Localization.AtPrime P) ∧ (P.IsMaximal → ringKrullDim (Localization.AtPrime P) = 2) :=
by
  have t_s2 : ∀ (R : Type u) [CommRing R] (u v : R), (∀ b : R, u * b = 0 → b = 0) → (∀ b : R, u ∣ v * b → u ∣ b) → ∀ (K : ℕ) (a : ℕ → R), (∑ i ∈ Finset.range (K + 1), a i * u ^ (K - i) * v ^ i) = 0 → ∀ i ≤ K, a i ∈ Ideal.span {u, v} := by
    intro R _ u v hnzd hcop
    have hit : ∀ m : ℕ, ∀ b : R, u ∣ v ^ m * b → u ∣ b := by
      intro m
      induction m with
      | zero => intro b h; simpa using h
      | succ m ih =>
        intro b h
        apply ih
        apply hcop
        have e : v * (v ^ m * b) = v ^ (m + 1) * b := by ring
        rw [e]; exact h
    have hu : u ∈ Ideal.span {u, v} := Ideal.subset_span (by simp)
    have hv : v ∈ Ideal.span {u, v} := Ideal.subset_span (by simp)
    intro K
    induction K with
    | zero =>
      intro a h i hi
      have hi0 : i = 0 := by omega
      rw [hi0]
      simp at h
      rw [h]; exact Ideal.zero_mem _
    | succ K ih =>
      intro a h i hi
      rw [Finset.sum_range_succ] at h
      have hsplit : ∑ j ∈ Finset.range (K + 1), a j * u ^ (K + 1 - j) * v ^ j
          = u * ∑ j ∈ Finset.range (K + 1), a j * u ^ (K - j) * v ^ j := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j hj
        have hj' : j ≤ K := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
        rw [show K + 1 - j = (K - j) + 1 by omega, pow_succ]
        ring
      rw [hsplit, Nat.sub_self, pow_zero, mul_one] at h
      have hdvd : u ∣ v ^ (K + 1) * a (K + 1) :=
        ⟨-(∑ j ∈ Finset.range (K + 1), a j * u ^ (K - j) * v ^ j), by linear_combination h⟩
      obtain ⟨b, hb⟩ := hit (K + 1) _ hdvd
      have h2 : (∑ j ∈ Finset.range (K + 1), a j * u ^ (K - j) * v ^ j) + b * v ^ (K + 1) = 0 := by
        apply hnzd
        linear_combination h - v ^ (K + 1) * hb
      have h3 : ∑ j ∈ Finset.range (K + 1), (Function.update a K (a K + b * v)) j * u ^ (K - j) * v ^ j = 0 := by
        rw [Finset.sum_range_succ] at h2 ⊢
        have e : ∑ j ∈ Finset.range K, (Function.update a K (a K + b * v)) j * u ^ (K - j) * v ^ j
            = ∑ j ∈ Finset.range K, a j * u ^ (K - j) * v ^ j := by
          apply Finset.sum_congr rfl
          intro j hj
          have hj' : j ≠ K := by have := Finset.mem_range.mp hj; omega
          rw [Function.update_of_ne hj']
        rw [e, Function.update_self]
        rw [Nat.sub_self, pow_zero, mul_one] at h2 ⊢
        linear_combination h2
      have hI := ih _ h3
      rcases Nat.lt_or_ge i (K + 1) with hlt | hge
      · by_cases hiK : i = K
        · rw [hiK]
          have h4 := hI K le_rfl
          rw [Function.update_self] at h4
          have e : a K = (a K + b * v) - b * v := by ring
          rw [e]
          exact Ideal.sub_mem _ h4 (Ideal.mul_mem_left _ b hv)
        · have h4 := hI i (by omega)
          rwa [Function.update_of_ne hiK] at h4
      · have hi' : i = K + 1 := by omega
        rw [hi', hb]
        exact Ideal.mul_mem_right b _ hu

  have t_s1 : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R], ringKrullDim R = 2 → ∀ (u v : R), IsLocalRing.maximalIdeal R = Ideal.span {u, v} → (∀ b : R, u * b = 0 → b = 0) ∧ (∀ b : R, u ∣ v * b → u ∣ b) := by
    intro R _ _ hdim u v hm
    obtain ⟨hdom, hufd⟩ := wc_fco_regular_local_ufd R
    haveI := hdom
    haveI := hufd
    have hnp : ∀ x ∈ IsLocalRing.maximalIdeal R, ¬ (IsLocalRing.maximalIdeal R ≤ Ideal.span {x}) := by
      intro x hx hle
      have heq : IsLocalRing.maximalIdeal R = Ideal.span {x} :=
        le_antisymm hle ((Ideal.span_singleton_le_iff_mem _).mpr hx)
      have h1 : (IsLocalRing.maximalIdeal R).spanFinrank ≤ 1 := by
        rw [heq]
        exact (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton x)).trans
          (by rw [Set.ncard_singleton])
      have h2 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
      rw [hdim] at h2
      have h3 : (IsLocalRing.maximalIdeal R).spanFinrank = 2 := by exact_mod_cast h2
      omega
    have hu𝔪 : u ∈ IsLocalRing.maximalIdeal R := by rw [hm]; exact Ideal.subset_span (by simp)
    have hv𝔪 : v ∈ IsLocalRing.maximalIdeal R := by rw [hm]; exact Ideal.subset_span (by simp)
    have hu2 : u ∉ IsLocalRing.maximalIdeal R ^ 2 := by
      intro hu
      apply hnp v hv𝔪
      apply Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
        (IsLocalRing.maximalIdeal_le_jacobson ⊥)
      have hs : Ideal.span {u, v} ≤ Ideal.span {v} ⊔ IsLocalRing.maximalIdeal R • IsLocalRing.maximalIdeal R := by
        rw [Ideal.span_le]
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with hx | hx
        · rw [hx]
          apply Submodule.mem_sup_right
          rw [Ideal.smul_eq_mul, ← pow_two]
          exact hu
        · rw [hx]
          exact Submodule.mem_sup_left (Ideal.subset_span rfl)
      calc IsLocalRing.maximalIdeal R = Ideal.span {u, v} := hm
        _ ≤ _ := hs
    have hu0 : u ≠ 0 := by
      intro h
      apply hu2
      rw [h]
      exact Ideal.zero_mem _
    refine ⟨fun b hb => (mul_eq_zero.mp hb).resolve_left hu0, ?_⟩
    have hirr : Irreducible u := by
      refine ⟨fun hunit => (IsLocalRing.mem_maximalIdeal _).mp hu𝔪 hunit, ?_⟩
      intro a b hab
      by_contra hcon
      push_neg at hcon
      apply hu2
      rw [hab, pow_two]
      exact Ideal.mul_mem_mul ((IsLocalRing.mem_maximalIdeal _).mpr hcon.1)
        ((IsLocalRing.mem_maximalIdeal _).mpr hcon.2)
    have hprime : Prime u := UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr
    have hndvd : ¬ u ∣ v := by
      rintro ⟨c, hc⟩
      apply hnp u hu𝔪
      rw [hm, Ideal.span_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with hx | hx
      · rw [hx]; exact Ideal.subset_span rfl
      · rw [hx, hc]; exact Ideal.mul_mem_right c _ (Ideal.subset_span rfl)
    intro b hb
    rcases hprime.dvd_or_dvd hb with h | h
    · exact absurd h hndvd
    · exact h

  have t_s3 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (𝔭 : Ideal A) (u v : A), 𝔭 = Ideal.span {u, v} → (∀ (K : ℕ) (a : ℕ → A), (∑ i ∈ Finset.range (K + 1), a i * u ^ (K - i) * v ^ i) = 0 → ∀ i ≤ K, a i ∈ 𝔭) → ∀ (C : Type u) [CommRing C] (φ : A →+* C), Function.Injective φ → ∀ (t : C), φ u * t = φ v → (∀ c : C, c ∈ Subring.closure (Set.range φ ∪ {t})) → IsNoetherianRing C ∧ Nonempty (C ⧸ Ideal.span {φ u} ≃+* Polynomial (A ⧸ 𝔭)) := by
    intro A _ _ 𝔭 u v h𝔭 hsyz C _ φ hinj t hrel hgen
    have hΘapp : ∀ H, Polynomial.eval₂RingHom φ t H = Polynomial.eval₂ φ t H := fun H => rfl
    have hsurj : Function.Surjective (Polynomial.eval₂RingHom φ t) := by
      intro c
      have hle : Subring.closure (Set.range φ ∪ {t}) ≤ (Polynomial.eval₂RingHom φ t).range := by
        rw [Subring.closure_le]
        rintro x (⟨a, rfl⟩ | hx)
        · exact ⟨Polynomial.C a, by rw [hΘapp, Polynomial.eval₂_C]⟩
        · rw [Set.mem_singleton_iff] at hx
          exact ⟨Polynomial.X, by rw [hΘapp, Polynomial.eval₂_X, hx]⟩
      exact RingHom.mem_range.mp (hle (hgen c))
    haveI : IsNoetherianRing C := isNoetherianRing_of_surjective _ _ _ hsurj
    refine ⟨inferInstance, ?_⟩
    have hhom : ∀ (H : Polynomial A) (n : ℕ), H.natDegree ≤ n →
        φ u ^ n * Polynomial.eval₂RingHom φ t H
          = φ (∑ i ∈ Finset.range (n + 1), H.coeff i * u ^ (n - i) * v ^ i) := by
      intro H n hn
      rw [hΘapp, Polynomial.eval₂_eq_sum_range' φ (Nat.lt_succ_of_le hn), Finset.mul_sum, map_sum]
      apply Finset.sum_congr rfl
      intro i hi
      have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      rw [map_mul, map_mul, map_pow, map_pow, ← hrel, mul_pow]
      have e : φ u ^ n = φ u ^ (n - i) * φ u ^ i := by rw [← pow_add, Nat.sub_add_cancel hi']
      rw [e]
      ring
    have hπs : Function.Surjective
        ((Ideal.Quotient.mk (Ideal.span {φ u})).comp (Polynomial.eval₂RingHom φ t)) :=
      Ideal.Quotient.mk_surjective.comp hsurj
    have hu𝔭 : u ∈ 𝔭 := by rw [h𝔭]; exact Ideal.subset_span (by simp)
    have hker : RingHom.ker ((Ideal.Quotient.mk (Ideal.span {φ u})).comp (Polynomial.eval₂RingHom φ t))
        = Ideal.map Polynomial.C 𝔭 := by
      apply le_antisymm
      · intro F hF
        rw [RingHom.mem_ker, RingHom.comp_apply] at hF
        have hF' := Ideal.Quotient.eq_zero_iff_mem.mp hF
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hF'
        obtain ⟨G, rfl⟩ := hsurj c
        rw [Ideal.mem_map_C_iff]
        intro i
        have e1 := hhom F (F.natDegree + G.natDegree + 1) (by omega)
        have e2 := hhom G (F.natDegree + G.natDegree + 1) (by omega)
        have key : φ (∑ j ∈ Finset.range (F.natDegree + G.natDegree + 1 + 1),
            (F.coeff j - u * G.coeff j) * u ^ (F.natDegree + G.natDegree + 1 - j) * v ^ j) = 0 := by
          have e3 : ∑ j ∈ Finset.range (F.natDegree + G.natDegree + 1 + 1),
              (F.coeff j - u * G.coeff j) * u ^ (F.natDegree + G.natDegree + 1 - j) * v ^ j
              = ∑ j ∈ Finset.range (F.natDegree + G.natDegree + 1 + 1),
                  F.coeff j * u ^ (F.natDegree + G.natDegree + 1 - j) * v ^ j
                - u * ∑ j ∈ Finset.range (F.natDegree + G.natDegree + 1 + 1),
                  G.coeff j * u ^ (F.natDegree + G.natDegree + 1 - j) * v ^ j := by
            rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
            apply Finset.sum_congr rfl
            intro j _
            ring
          rw [e3, map_sub, map_mul, ← e1, ← e2, ← hc]
          ring
        have key2 := hinj (key.trans (map_zero φ).symm)
        by_cases hin : i ≤ F.natDegree + G.natDegree + 1
        · have h5 := hsyz _ _ key2 i hin
          have e : F.coeff i = (F.coeff i - u * G.coeff i) + u * G.coeff i := by ring
          rw [e]
          exact Ideal.add_mem _ h5 (Ideal.mul_mem_right _ _ hu𝔭)
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
          exact Ideal.zero_mem _
      · rw [h𝔭, Ideal.map_span, Set.image_pair, Ideal.span_le]
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply]
        rcases hx with hx | hx
        · rw [hx, hΘapp, Polynomial.eval₂_C]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        · rw [hx, hΘapp, Polynomial.eval₂_C, ← hrel]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton'.mpr ⟨t, mul_comm _ _⟩)
    exact ⟨((RingHom.quotientKerEquivOfSurjective hπs).symm.trans (Ideal.quotEquivOfEq hker)).trans
      (Ideal.polynomialQuotientEquivQuotientPolynomial 𝔭).symm⟩

  have t_s4 : ∀ (C : Type u) [CommRing C] [IsDomain C] [IsNoetherianRing C] (w : C), w ≠ 0 → IsDomain (C ⧸ Ideal.span {w}) → IsPrincipalIdealRing (C ⧸ Ideal.span {w}) → ¬ IsField (C ⧸ Ideal.span {w}) → ∀ (P : Ideal C) [P.IsPrime], w ∈ P → IsRegularLocalRing (Localization.AtPrime P) ∧ (P.IsMaximal → ringKrullDim (Localization.AtPrime P) = 2) := by
    intro C _ _ _ w hw hD hPID hnf P _ hwP
    haveI : IsNoetherianRing (Localization.AtPrime P) :=
      IsLocalization.isNoetherianRing P.primeCompl _ inferInstance
    have hdimL : ringKrullDim (Localization.AtPrime P) = P.height :=
      IsLocalization.AtPrime.ringKrullDim_eq_height P _
    have hmL : IsLocalRing.maximalIdeal (Localization.AtPrime P)
        = Ideal.map (algebraMap C (Localization.AtPrime P)) P :=
      Localization.AtPrime.map_eq_maximalIdeal.symm
    have h0 : ∀ Q : Ideal C, Q.IsPrime → Q ≠ ⊥ → 1 ≤ Q.height := by
      intro Q hQ hQb
      rcases le_or_gt Q.height ((0 : ℕ) : ℕ∞) with h' | h'
      · exfalso
        haveI := hQ
        have h6 := Ideal.height_le_iff.mp h' ⊥ Ideal.isPrime_bot (bot_lt_iff_ne_bot.mpr hQb)
        simp at h6
      · have h3 := Order.add_one_le_of_lt h'
        simpa using h3
    have hwprime : (Ideal.span {w}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hD
    have h1 : 1 ≤ (Ideal.span {w}).height :=
      h0 _ hwprime (fun h => hw (Ideal.span_singleton_eq_bot.mp h))
    have h2 : ∀ Q : Ideal C, Q.IsPrime → Ideal.span {w} < Q → 2 ≤ Q.height := by
      intro Q hQ hlt
      haveI := hQ
      by_contra hcon
      have hle : Q.height ≤ ((1 : ℕ) : ℕ∞) := by
        rcases le_or_gt Q.height ((1 : ℕ) : ℕ∞) with h' | h'
        · exact h'
        · have h3 := Order.add_one_le_of_lt h'
          rw [Nat.cast_one, one_add_one_eq_two] at h3
          exact absurd h3 hcon
      have h4 := Ideal.height_le_iff.mp hle _ hwprime hlt
      rw [Nat.cast_one] at h4
      exact absurd h1 (not_le.mpr h4)
    have hker : RingHom.ker (Ideal.Quotient.mk (Ideal.span {w})) = Ideal.span {w} := Ideal.mk_ker
    have hle : Ideal.span {w} ≤ P := (Ideal.span_singleton_le_iff_mem _).mpr hwP
    haveI hPb : (Ideal.map (Ideal.Quotient.mk (Ideal.span {w})) P).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [hker]; exact hle)
    haveI := hPID
    haveI hpr := IsPrincipalIdealRing.principal (Ideal.map (Ideal.Quotient.mk (Ideal.span {w})) P)
    obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective
      (Submodule.IsPrincipal.generator (Ideal.map (Ideal.Quotient.mk (Ideal.span {w})) P))
    have hd : Ideal.map (Ideal.Quotient.mk (Ideal.span {w})) P
        = Ideal.span {Ideal.Quotient.mk (Ideal.span {w}) q} := by
      rw [hq]
      exact (Submodule.IsPrincipal.span_singleton_generator _).symm
    have hPeq : P = Ideal.span {w, q} := by
      apply le_antisymm
      · intro x hx
        have hx' : Ideal.Quotient.mk (Ideal.span {w}) x
            ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {w})) P := Ideal.mem_map_of_mem _ hx
        rw [hd] at hx'
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hx'
        obtain ⟨c0, rfl⟩ := Ideal.Quotient.mk_surjective c
        have h7 : x - c0 * q ∈ Ideal.span {w} := by
          rw [← Ideal.Quotient.eq, map_mul]
          exact hc.symm
        obtain ⟨c', hc'⟩ := Ideal.mem_span_singleton'.mp h7
        rw [Ideal.mem_span_pair]
        exact ⟨c', c0, by rw [hc']; ring⟩
      · rw [Ideal.span_le]
        intro x hx
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with hx | hx
        · rw [hx]; exact hwP
        · rw [hx]
          have h8 : q ∈ Ideal.comap (Ideal.Quotient.mk (Ideal.span {w}))
              (Ideal.map (Ideal.Quotient.mk (Ideal.span {w})) P) := by
            rw [hd, Ideal.mem_comap]
            exact Submodule.mem_span_singleton_self _
          rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, hker,
            sup_eq_left.mpr hle] at h8
          exact h8
    by_cases hPw : P = Ideal.span {w}
    · have hfr : (IsLocalRing.maximalIdeal (Localization.AtPrime P)).spanFinrank ≤ 1 := by
        rw [hmL, (congrArg (Ideal.map (algebraMap C (Localization.AtPrime P))) hPw).trans
          (Ideal.map_span _ _), Set.image_singleton]
        exact (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton _)).trans
          (by rw [Set.ncard_singleton])
      have hht : 1 ≤ P.height := by rw [hPw]; exact h1
      refine ⟨IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_, fun hmax => ?_⟩
      · rw [hdimL]
        have h9 : ((IsLocalRing.maximalIdeal (Localization.AtPrime P)).spanFinrank : ℕ∞) ≤ P.height :=
          le_trans (by exact_mod_cast hfr) hht
        exact_mod_cast h9
      · exfalso
        apply hnf
        have h10 := (Ideal.Quotient.maximal_ideal_iff_isField_quotient P).mp hmax
        rw [hPw] at h10
        exact h10
    · have hlt : Ideal.span {w} < P := lt_of_le_of_ne hle (Ne.symm hPw)
      have hht : 2 ≤ P.height := h2 P inferInstance hlt
      have hfr : (IsLocalRing.maximalIdeal (Localization.AtPrime P)).spanFinrank ≤ 2 := by
        rw [hmL, (congrArg (Ideal.map (algebraMap C (Localization.AtPrime P))) hPeq).trans
          (Ideal.map_span _ _), Set.image_pair]
        exact (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans
          ((Set.ncard_insert_le _ _).trans (by simp))
      have hdim2 : ringKrullDim (Localization.AtPrime P) = 2 := by
        apply le_antisymm
        · calc ringKrullDim (Localization.AtPrime P)
              ≤ ((IsLocalRing.maximalIdeal (Localization.AtPrime P)).spanFinrank : WithBot ℕ∞) :=
                ringKrullDim_le_spanFinrank_maximalIdeal _
            _ ≤ 2 := by exact_mod_cast hfr
        · rw [hdimL]
          have h11 : ((2 : ℕ∞) : WithBot ℕ∞) ≤ (P.height : WithBot ℕ∞) := WithBot.coe_le_coe.mpr hht
          exact h11
      refine ⟨IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_, fun _ => hdim2⟩
      rw [hdim2]
      exact_mod_cast hfr
  intro A _ _ 𝔭 _ hreg hdim u v h𝔭 C _ _ φ hinj t hrel hgen P _ hcom
  haveI := hreg
  have hmR : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)
      = Ideal.span {algebraMap A (Localization.AtPrime 𝔭) u,
          algebraMap A (Localization.AtPrime 𝔭) v} := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    rw [(congrArg (Ideal.map (algebraMap A (Localization.AtPrime 𝔭))) h𝔭).trans
      (Ideal.map_span _ _), Set.image_pair]
  obtain ⟨hnzd, hcop⟩ := t_s1 (Localization.AtPrime 𝔭) hdim _ _ hmR
  have hsyzA : ∀ (K : ℕ) (a : ℕ → A),
      (∑ i ∈ Finset.range (K + 1), a i * u ^ (K - i) * v ^ i) = 0 → ∀ i ≤ K, a i ∈ 𝔭 := by
    intro K a ha i hi
    have h1 : (∑ j ∈ Finset.range (K + 1),
        (fun j => algebraMap A (Localization.AtPrime 𝔭) (a j)) j
          * algebraMap A (Localization.AtPrime 𝔭) u ^ (K - j)
          * algebraMap A (Localization.AtPrime 𝔭) v ^ j) = 0 := by
      have h0 := congrArg (algebraMap A (Localization.AtPrime 𝔭)) ha
      rw [map_sum, map_zero] at h0
      rw [← h0]
      apply Finset.sum_congr rfl
      intro j _
      rw [map_mul, map_mul, map_pow, map_pow]
    have h2 := t_s2 _ _ _ hnzd hcop K _ h1 i hi
    rw [← hmR] at h2
    have h4 := Localization.AtPrime.under_maximalIdeal (I := 𝔭)
    rw [Ideal.under_def] at h4
    rw [← h4, Ideal.mem_comap]
    exact h2
  obtain ⟨hnC, ⟨e⟩⟩ := t_s3 A 𝔭 u v h𝔭 hsyzA C φ hinj t hrel hgen
  letI := Ideal.Quotient.field 𝔭
  have hD : IsDomain (C ⧸ Ideal.span {φ u}) := MulEquiv.isDomain _ e.toMulEquiv
  have hPID : IsPrincipalIdealRing (C ⧸ Ideal.span {φ u}) :=
    IsPrincipalIdealRing.of_surjective e.symm e.symm.surjective
  have hnf : ¬ IsField (C ⧸ Ideal.span {φ u}) := fun h =>
    Polynomial.not_isField _ (MulEquiv.isField h e.symm.toMulEquiv)
  have hu0 : φ u ≠ 0 := by
    intro h
    have hu : u = 0 := hinj (h.trans (map_zero φ).symm)
    have h1 := hnzd 1 (by rw [hu, map_zero, zero_mul])
    exact one_ne_zero h1
  have hwP : φ u ∈ P := by
    have h1 : u ∈ Ideal.comap φ P := by rw [hcom, h𝔭]; exact Ideal.subset_span (by simp)
    exact h1
  haveI := hnC
  exact t_s4 C (φ u) hu0 hD hPID hnf P hwP

theorem fexr_pt_blowup_chart : ∀ (Y Y' : Scheme.{u}) [IsLocallyNoetherian Y] [AlgebraicGeometry.IsIntegral Y] [AlgebraicGeometry.IsIntegral Y'] (y : Y) (hy : IsClosed ({y} : Set Y)), IsRegularLocalRing (Y.presheaf.stalk y) → ringKrullDim (Y.presheaf.stalk y) = 2 → ∀ (r : Y' ⟶ Y), wcCsdIsBlowup (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)) r → ∀ y' : Y', r y' = y → ∃ (A C : Type u) (_ : CommRing A) (_ : CommRing C) (_ : IsNoetherianRing A) (_ : IsDomain C) (𝔭 : Ideal A) (_ : 𝔭.IsMaximal) (u v : A) (φ : A →+* C) (t : C) (P : Ideal C) (_ : P.IsPrime), IsRegularLocalRing (Localization.AtPrime 𝔭) ∧ ringKrullDim (Localization.AtPrime 𝔭) = 2 ∧ 𝔭 = Ideal.span {u, v} ∧ Function.Injective φ ∧ φ u * t = φ v ∧ (∀ c : C, c ∈ Subring.closure (Set.range φ ∪ {t})) ∧ Ideal.comap φ P = 𝔭 ∧ Nonempty (Y'.presheaf.stalk y' ≃+* Localization.AtPrime P) ∧ (IsClosed ({y'} : Set Y') → P.IsMaximal) :=
by
  intro Y Y' _ _ _ y hy hreg hdim r hbl y' hry
  haveI := hreg


  have hres : ∀ {X : Scheme.{u}} {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X A B C h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hid : ∀ {X : Scheme.{u}} {A : X.Opens} (h : A ≤ A) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro X A h x
    have e0 : X.presheaf.map (homOfLE h).op = 𝟙 _ := by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op A) from rfl, X.presheaf.map_id]
    rw [e0]
    rfl
  have htop : ∀ {X X' : Scheme.{u}} (r : X' ⟶ X) (V : X'.Opens), V ≤ r ⁻¹ᵁ ⊤ :=
    fun _ _ => by simp

  have s10 : genericPoint Y ≠ y := by
    intro he
    have hdim' := hdim
    subst he
    have h0 : ringKrullDim (Y.presheaf.stalk (genericPoint Y)) = 0 :=
      ringKrullDim_eq_zero_of_field Y.functionField
    exact absurd (h0.symm.trans hdim') (by decide)

  have s1 : ∃ gh : Fin 2 → Y.presheaf.stalk y,
      Ideal.span (Set.range gh) = IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := Y.presheaf.stalk y)
    rw [hdim] at h1
    have h2 : Submodule.spanFinrank (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) = 2 := by
      exact_mod_cast h1
    obtain ⟨s, hs, hspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank
      (_root_.IsNoetherian.noetherian (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)))
    rw [h2] at hs
    obtain ⟨a, b, -, rfl⟩ := Set.encard_eq_two.mp (by exact_mod_cast hs)
    refine ⟨![a, b], ?_⟩
    rw [Matrix.range_cons_cons_empty]
    exact hspan

  have s2 : ∀ (X S : Scheme.{u}) (f : X ⟶ S) (V : S.Opens) (hV : IsAffineOpen V) (W : X.Opens)
      (hW : IsAffineOpen W) (e : W ≤ f ⁻¹ᵁ V) (x : X) (hx : x ∈ W),
      Ideal.comap (f.appLE V W e).hom (hW.primeIdealOf ⟨x, hx⟩).asIdeal =
        (hV.primeIdealOf ⟨f x, e hx⟩).asIdeal := by
    intro X S f V hV W hW e x hx
    have h1 : (hW.primeIdealOf ⟨x, hx⟩).asIdeal = Ideal.comap (X.presheaf.germ W x hx).hom
        (IsLocalRing.closedPoint (X.presheaf.stalk x)).asIdeal := by
      rw [hW.primeIdealOf_eq_map_closedPoint ⟨x, hx⟩]
      rfl
    have h2 : (hV.primeIdealOf ⟨f x, e hx⟩).asIdeal = Ideal.comap (S.presheaf.germ V (f x) (e hx)).hom
        (IsLocalRing.closedPoint (S.presheaf.stalk (f x))).asIdeal := by
      rw [hV.primeIdealOf_eq_map_closedPoint ⟨f x, e hx⟩]
      rfl
    have hcomp : f.appLE V W e ≫ X.presheaf.germ W x hx =
        S.presheaf.germ V (f x) (e hx) ≫ f.stalkMap x := by
      rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
      exact (Scheme.Hom.germ_stalkMap f V x (e hx)).symm
    have hcomp' := congrArg CommRingCat.Hom.hom hcomp
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp] at hcomp'
    rw [h1, h2, Ideal.comap_comap, hcomp', ← Ideal.comap_comap]
    congr 1
    rw [← PrimeSpectrum.comap_asIdeal, IsLocalRing.comap_closedPoint]

  have s3 : ∀ (X : Scheme.{u}) (x : X) (hc : IsClosed ({x} : Set X)) (W : X.Opens)
      (hW : IsAffineOpen W) (hx : x ∈ W),
      (hW.primeIdealOf ⟨x, hx⟩).asIdeal.IsMaximal ∧
      (Scheme.IdealSheafData.vanishingIdeal (⟨{x}, hc⟩ : TopologicalSpace.Closeds X)).ideal
        ⟨W, hW⟩ = (hW.primeIdealOf ⟨x, hx⟩).asIdeal := by
    intro X x hc W hW hx
    haveI := hW.isOpenImmersion_fromSpec
    have hinj : Function.Injective hW.fromSpec := hW.fromSpec.isOpenEmbedding.isEmbedding.injective
    have hpre : ⇑hW.fromSpec ⁻¹' {x} = {hW.primeIdealOf ⟨x, hx⟩} := by
      ext q
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hq
        apply hinj
        rw [hW.fromSpec_primeIdealOf]
        exact hq
      · intro hq
        rw [hq]
        exact hW.fromSpec_primeIdealOf _
    refine ⟨?_, ?_⟩
    · have hcl : IsClosed (⇑hW.fromSpec ⁻¹' {x}) := hc.preimage hW.fromSpec.continuous
      rw [hpre] at hcl
      exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hcl
    · rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
      exact (congrArg PrimeSpectrum.vanishingIdeal hpre).trans
        (PrimeSpectrum.vanishingIdeal_singleton _)

  have s4 : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U) (x : X) (hx : x ∈ U),
      Nonempty (X.presheaf.stalk x ≃+* Localization.AtPrime (hU.primeIdealOf ⟨x, hx⟩).asIdeal) := by
    intro X U hU x hx
    have key : ∀ x' : U, Nonempty (X.presheaf.stalk (x' : X) ≃+*
        Localization.AtPrime (hU.primeIdealOf x').asIdeal) := by
      intro x'
      haveI := hU.isLocalization_stalk x'
      exact ⟨(IsLocalization.algEquiv (hU.primeIdealOf x').asIdeal.primeCompl
        (X.presheaf.stalk (x' : X)) (Localization.AtPrime (hU.primeIdealOf x').asIdeal)).toRingEquiv⟩
    exact key ⟨x, hx⟩

  have s7 : ∀ (X X' : Scheme.{u}) (J : X.IdealSheafData) (q : X' ⟶ X) (V : X.Opens),
      wcCsdIsBlowup J q → wcCsdIsBlowup (J.comap V.ι) (q ∣_ V) := by
    intro X X' J q V hq0
    have hq := wcpa_dj_nc_blowup_flat_basechange X X' V.toScheme J q V.ι inferInstance hq0
    set e := (isPullback_morphismRestrict q V).flip.isoPullback with he_def
    have he : e.hom ≫ Limits.pullback.snd q V.ι = q ∣_ V := IsPullback.isoPullback_hom_snd _
    refine ⟨?_, ?_⟩
    · rw [← he]
      exact wcpa_dj_lr1k_ebd_invpull_flat_pre _ _ _ _ _ e.hom inferInstance hq.1
    · intro T h hh
      obtain ⟨h', hh', huniq⟩ := hq.2 T h hh
      refine ⟨h' ≫ e.inv, ?_, fun c hc => ?_⟩
      · show (h' ≫ e.inv) ≫ q ∣_ V = h
        rw [← he, Category.assoc, e.inv_hom_id_assoc, hh']
      · have hc' : c ≫ q ∣_ V = h := hc
        have h1 : c ≫ e.hom = h' := huniq _ (by
          show (c ≫ e.hom) ≫ Limits.pullback.snd q V.ι = h
          rw [Category.assoc, he]
          exact hc')
        rw [← h1, Category.assoc, e.hom_inv_id, Category.comp_id]

  have s9 : ∀ (A0 A1 C : Type u) [CommRing A0] [CommRing A1] [CommRing C] (κ : A0 →+* A1)
      (ψ : A1 →+* C), Function.Surjective κ → ∀ (g : Fin 2 → A0) (l : Fin 2) (τ : Fin 2 → C),
      (∀ j, ψ (κ (g j)) = τ j * ψ (κ (g l))) → ψ (κ (g l)) ∈ nonZeroDivisors C →
      (∀ s : C, s ∈ Subring.closure (Set.range ψ ∪ Set.range τ)) →
      ∃ (u v : A0) (t : C), Ideal.span {u, v} = Ideal.span (Set.range g) ∧
        ψ (κ u) * t = ψ (κ v) ∧ ∀ c : C, c ∈ Subring.closure (Set.range (ψ.comp κ) ∪ {t}) := by
    intro A0 A1 C _ _ _ κ ψ hκ g l τ h3 h4 h5
    have hτl : τ l = 1 := by
      have h0 : (τ l - 1) * ψ (κ (g l)) = 0 := by linear_combination -(h3 l)
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff h4).mp h0)
    have hrg : Set.range g = {g 0, g 1} := by
      ext a
      simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
      constructor
      · rintro ⟨i, rfl⟩
        fin_cases i
        · exact Or.inl rfl
        · exact Or.inr rfl
      · rintro (rfl | rfl)
        · exact ⟨0, rfl⟩
        · exact ⟨1, rfl⟩
    have key : ∀ (u v : A0) (t : C), Ideal.span {u, v} = Ideal.span (Set.range g) →
        ψ (κ u) * t = ψ (κ v) → (∀ j, τ j = 1 ∨ τ j = t) →
        ∃ (u v : A0) (t : C), Ideal.span {u, v} = Ideal.span (Set.range g) ∧
          ψ (κ u) * t = ψ (κ v) ∧ ∀ c : C, c ∈ Subring.closure (Set.range (ψ.comp κ) ∪ {t}) := by
      intro u v t hs hr hτ
      refine ⟨u, v, t, hs, hr, fun c => ?_⟩
      have hle : Subring.closure (Set.range ψ ∪ Set.range τ) ≤
          Subring.closure (Set.range (ψ.comp κ) ∪ {t}) := by
        rw [Subring.closure_le]
        rintro _ (⟨a, rfl⟩ | ⟨j, rfl⟩)
        · obtain ⟨a', rfl⟩ := hκ a
          exact Subring.subset_closure (Or.inl ⟨a', rfl⟩)
        · rcases hτ j with h | h
          · rw [h]; exact Subring.one_mem _
          · rw [h]; exact Subring.subset_closure (Or.inr rfl)
      exact hle (h5 c)
    have hl : l = 0 ∨ l = 1 := by fin_cases l <;> simp
    have hj : ∀ j : Fin 2, j = 0 ∨ j = 1 := by intro j; fin_cases j <;> simp
    rcases hl with rfl | rfl
    · refine key (g 0) (g 1) (τ 1) (by rw [hrg]) (by rw [h3 1, mul_comm]) (fun j => ?_)
      rcases hj j with rfl | rfl
      · exact Or.inl hτl
      · exact Or.inr rfl
    · refine key (g 1) (g 0) (τ 0) (by rw [hrg, Set.pair_comm]) (by rw [h3 0, mul_comm])
        (fun j => ?_)
      rcases hj j with rfl | rfl
      · exact Or.inr rfl
      · exact Or.inl hτl


  have hsupp : ((Scheme.IdealSheafData.vanishingIdeal
      (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)).support : Set Y) = {y} :=
    Scheme.IdealSheafData.coe_support_vanishingIdeal _
  have s5 : r (genericPoint Y') = genericPoint Y := by
    let V : Y.Opens := ⟨{y}ᶜ, hy.isOpen_compl⟩
    haveI hV : IsIso (r ∣_ V) := wc_csd_blowup_iso_off_center Y Y' _ r V hbl
      (by rw [hsupp]; exact Set.inter_compl_self _)
    have hηV : genericPoint Y ∈ V := s10
    obtain ⟨q, hq⟩ := (r ∣_ V).surjective ⟨genericPoint Y, hηV⟩
    have hrq : r q.1 = genericPoint Y := by
      rw [← morphismRestrict_base_coe, hq]
    have h1 : r (genericPoint Y') ⤳ genericPoint Y := by
      rw [← hrq]
      exact ((genericPoint_spec Y').specializes trivial).map r.continuous
    have h2 : genericPoint Y ⤳ r (genericPoint Y') := (genericPoint_spec Y).specializes trivial
    exact (h1.antisymm h2).eq


  obtain ⟨gh, hgh⟩ := s1
  obtain ⟨U, hp, g, -, hIU⟩ := wc_beq_point_generators Y inferInstance y ⟨{y}, hy⟩ rfl 2 gh hgh
  haveI hAnoeth : IsNoetherianRing Γ(Y, U.1) := IsLocallyNoetherian.component_noetherian U

  obtain ⟨h𝔭max, h𝔭I⟩ := s3 Y y hy U.1 U.2 hp
  obtain ⟨e𝔭⟩ := s4 Y U.1 U.2 y hp
  have hreg𝔭 : IsRegularLocalRing (Localization.AtPrime (U.2.primeIdealOf ⟨y, hp⟩).asIdeal) :=
    IsRegularLocalRing.of_ringEquiv e𝔭
  have hdim𝔭 : ringKrullDim (Localization.AtPrime (U.2.primeIdealOf ⟨y, hp⟩).asIdeal) = 2 :=
    (ringKrullDim_eq_of_ringEquiv e𝔭).symm.trans hdim
  have h𝔭g : (U.2.primeIdealOf ⟨y, hp⟩).asIdeal = Ideal.span (Set.range g) := h𝔭I.symm.trans hIU

  haveI hUa : IsAffine U.1.toScheme := U.2
  have e0 : (⊤ : U.1.toScheme.Opens) ≤ U.1.ι ⁻¹ᵁ U.1 := (Scheme.Opens.ι_preimage_self U.1).ge
  let g' : Fin 2 → Γ(U.1.toScheme, ⊤) := fun j => (U.1.ι.appLE U.1 ⊤ e0).hom (g j)
  have e0' : ∀ (h : (⊤ : U.1.toScheme.Opens) ≤ ⊤),
      U.1.toScheme.presheaf.map (homOfLE h).op = 𝟙 _ := fun h => by
    rw [show (homOfLE h).op = 𝟙 (Opposite.op (⊤ : U.1.toScheme.Opens)) from rfl,
      U.1.toScheme.presheaf.map_id]
  have hcomap : (Scheme.IdealSheafData.vanishingIdeal
      (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)).comap U.1.ι =
      Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g')) := by
    apply (EquivLike.injective (Scheme.IdealSheafData.equivOfIsAffine (X := U.1.toScheme)))
    simp only [Scheme.IdealSheafData.equivOfIsAffine_apply]
    rw [Scheme.IdealSheafData.ofIdealTop_ideal, e0', CommRingCat.hom_id, Ideal.map_id,
      wc_csd_comap_ideal_affine U.1.toScheme Y _ U.1.ι U ⟨⊤, isAffineOpen_top _⟩ e0, hIU,
      Ideal.map_span, ← Set.range_comp]
    rfl
  have hbl0 : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g')))
      (r ∣_ U.1) := by
    rw [← hcomap]
    exact s7 Y Y' _ r U.1 hbl

  obtain ⟨U', t', hC⟩ := wc_bp_blowup_charts g' (r ∣_ U.1) hbl0
  obtain ⟨hcov, haff, h3, h4, h5, -⟩ := hC
  have h3' : ∀ l j, ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ (U' l))).hom (g' j) =
      t' l j * ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ (U' l))).hom (g' l) := h3
  have h4' : ∀ l, ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ (U' l))).hom (g' l) ∈
      nonZeroDivisors Γ((r ⁻¹ᵁ U.1).toScheme, U' l) := h4
  have h5' : ∀ l (s : Γ((r ⁻¹ᵁ U.1).toScheme, U' l)), s ∈ Subring.closure
      (Set.range ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ (U' l))).hom ∪ Set.range (t' l)) := h5

  have hy'U : y' ∈ r ⁻¹ᵁ U.1 := by
    rw [Scheme.Hom.mem_preimage, hry]
    exact hp
  let p : (r ⁻¹ᵁ U.1).toScheme := ⟨y', hy'U⟩
  have hpU : p ∈ ⨆ l, U' l := by
    rw [hcov]
    trivial
  obtain ⟨l, hpl⟩ := TopologicalSpace.Opens.mem_iSup.mp hpU
  haveI : Nonempty (r ⁻¹ᵁ U.1).toScheme := ⟨p⟩
  haveI : AlgebraicGeometry.IsIntegral (r ⁻¹ᵁ U.1).toScheme :=
    isIntegral_of_isOpenImmersion (r ⁻¹ᵁ U.1).ι
  haveI : Nonempty (U' l) := ⟨⟨p, hpl⟩⟩
  haveI hCdom : IsDomain Γ((r ⁻¹ᵁ U.1).toScheme, U' l) := IsIntegral.component_integral (U' l)

  have hsurjκ : Function.Surjective (U.1.ι.appLE U.1 ⊤ e0).hom := by
    rw [Scheme.Opens.ι_appLE]
    intro s
    refine ⟨(Y.presheaf.map (homOfLE (Scheme.Opens.ι_image_top U.1).ge).op).hom s, ?_⟩
    have h := (hres (A := U.1.ι ''ᵁ ⊤) (B := U.1) (C := U.1.ι ''ᵁ ⊤)
      (Scheme.Opens.ι_image_top U.1).ge (Scheme.Opens.ι_image_top U.1).le s).trans
      (hid (A := U.1.ι ''ᵁ ⊤) le_rfl s)
    exact h
  obtain ⟨u, v, t, hspan, hrel, hgen⟩ := s9 _ _ _ (U.1.ι.appLE U.1 ⊤ e0).hom
    ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ (U' l))).hom hsurjκ g l (t' l)
    (fun j => h3' l j) (h4' l) (h5' l)

  have e2 : U' l ≤ (r ∣_ U.1 ≫ U.1.ι) ⁻¹ᵁ U.1 := by
    intro x _
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply]
    exact ((r ∣_ U.1) x).2
  have hφ : ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ (U' l))).hom.comp (U.1.ι.appLE U.1 ⊤ e0).hom =
      ((r ∣_ U.1 ≫ U.1.ι).appLE U.1 (U' l) e2).hom := by
    rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
  have hfp : ∀ z : (r ⁻¹ᵁ U.1).toScheme, (r ∣_ U.1 ≫ U.1.ι) z = r z.1 := fun z => by
    rw [Scheme.Hom.comp_apply]
    exact morphismRestrict_base_coe r U.1 z
  have hfgen : (r ∣_ U.1 ≫ U.1.ι) (genericPoint (r ⁻¹ᵁ U.1).toScheme) = genericPoint Y := by
    rw [hfp]
    have h := genericPoint_eq_of_isOpenImmersion (r ⁻¹ᵁ U.1).ι
    have h' : (genericPoint (r ⁻¹ᵁ U.1).toScheme).1 = genericPoint Y' := h
    rw [h', s5]

  have hinj : Function.Injective
      (((r ∣_ U.1).appLE ⊤ (U' l) (htop _ (U' l))).hom.comp (U.1.ι.appLE U.1 ⊤ e0).hom) := by
    rw [hφ]
    exact wcpa_dj_sgs_appLE_injective _ _ _ hfgen _ _ e2 ⟨p, hpl⟩

  have hc2 := s2 _ _ (r ∣_ U.1 ≫ U.1.ι) U.1 U.2 (U' l) (haff l) e2 p hpl
  have hpt : (⟨(r ∣_ U.1 ≫ U.1.ι) p, e2 hpl⟩ : U.1) = ⟨y, hp⟩ := by
    apply Subtype.ext
    show (r ∣_ U.1 ≫ U.1.ι) p = y
    rw [hfp]
    exact hry
  rw [hpt] at hc2

  obtain ⟨eP⟩ := s4 _ (U' l) (haff l) p hpl
  have hstalk : Nonempty (Y'.presheaf.stalk y' ≃+*
      Localization.AtPrime ((haff l).primeIdealOf ⟨p, hpl⟩).asIdeal) :=
    ⟨(Scheme.Opens.stalkIso (r ⁻¹ᵁ U.1) p).symm.commRingCatIsoToRingEquiv.trans eP⟩
  have hmax : IsClosed ({y'} : Set Y') → ((haff l).primeIdealOf ⟨p, hpl⟩).asIdeal.IsMaximal := by
    intro hc
    have hcp : IsClosed ({p} : Set (r ⁻¹ᵁ U.1).toScheme) := by
      have h := hc.preimage (r ⁻¹ᵁ U.1).ι.continuous
      have heq : ⇑(r ⁻¹ᵁ U.1).ι ⁻¹' {y'} = {p} := by
        ext z
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hz
          exact Subtype.ext hz
        · intro hz
          rw [hz]
          rfl
      rwa [heq] at h
    exact (s3 _ p hcp (U' l) (haff l) hpl).1
  refine ⟨Γ(Y, U.1), Γ((r ⁻¹ᵁ U.1).toScheme, U' l), inferInstance, inferInstance, hAnoeth, hCdom,
    (U.2.primeIdealOf ⟨y, hp⟩).asIdeal, h𝔭max, u, v,
    ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ (U' l))).hom.comp (U.1.ι.appLE U.1 ⊤ e0).hom, t,
    ((haff l).primeIdealOf ⟨p, hpl⟩).asIdeal, inferInstance, hreg𝔭, hdim𝔭, ?_, hinj, hrel, hgen,
    ?_, hstalk, hmax⟩
  · rw [h𝔭g, hspan]
  · rw [hφ]
    exact hc2

theorem fexr_tower_props : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B], IsRegularLocalRing B → ringKrullDim B = 2 → ∀ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of B)), fexPtTower B Y g → AlgebraicGeometry.IsIntegral Y ∧ IsNoetherian Y ∧ IsProper g ∧ IsDominant g ∧ (∃ U : (Spec (.of B)).Opens, U ≠ ⊥ ∧ IsIso (g ∣_ U)) ∧ (∀ U V : Y.Opens, IsAffineOpen U → IsAffineOpen V → IsAffineOpen (U ⊓ V)) ∧ (∀ y : Y, IsRegularLocalRing (Y.presheaf.stalk y)) ∧ (∀ y : Y, IsIntegrallyClosed (Y.presheaf.stalk y)) ∧ (∀ y : Y, IsClosed ({y} : Set Y) → ringKrullDim (Y.presheaf.stalk y) = 2) :=
by
  intro B _ _ _ hreg hdim Y g hT
  haveI := hreg
  obtain ⟨hdomB, hufdB⟩ := wc_fco_regular_local_ufd B
  haveI := hdomB
  haveI := hufdB
  have h02 : (2 : WithBot ℕ∞) ≠ 0 := by norm_num

  have hP8 : ∀ (R : Type u) [CommRing R], IsRegularLocalRing R → IsIntegrallyClosed R := by
    intro R _ hR
    obtain ⟨h1, h2⟩ := wc_fco_regular_local_ufd R
    exact @UniqueFactorizationMonoid.instIsIntegrallyClosed R _ h1 h2

  have hres : ∀ {A C : Scheme.{u}} (q : A ⟶ C) (U₁ W₁ : C.Opens), W₁ ≤ U₁ →
      IsIso (q ∣_ U₁) → IsIso (q ∣_ W₁) := by
    intro A C q U₁ W₁ hle hq
    have h1 : IsIso ((q ∣_ U₁) ∣_ (U₁.ι ⁻¹ᵁ W₁)) := inferInstance
    have h2 : IsIso (q ∣_ (U₁.ι ''ᵁ (U₁.ι ⁻¹ᵁ W₁))) :=
      ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
        (morphismRestrictRestrict q U₁ (U₁.ι ⁻¹ᵁ W₁))).mp h1
    have heq : U₁.ι ''ᵁ (U₁.ι ⁻¹ᵁ W₁) = W₁ := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hle
    rw [heq] at h2
    exact h2

  have hp0 : (⟨⊥, inferInstance⟩ : PrimeSpectrum B) ≠ IsLocalRing.closedPoint B := by
    intro h
    have hm : IsLocalRing.maximalIdeal B = ⊥ := (congrArg PrimeSpectrum.asIdeal h).symm
    have hF : IsField B := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm
    have h0 := ringKrullDim_eq_zero_of_isField hF
    rw [hdim] at h0
    exact h02 h0
  induction hT with
  | base =>
    have hst : ∀ (x : Spec (.of B)) [(x : PrimeSpectrum B).asIdeal.IsPrime],
        Nonempty (Localization.AtPrime (x : PrimeSpectrum B).asIdeal ≃+*
        (Spec (.of B)).presheaf.stalk x) := by
      intro x _
      letI : Algebra B ((structurePresheafInCommRingCat B).stalk x) := StructureSheaf.stalkAlgebra B x
      exact ⟨(StructureSheaf.stalkIso B x).toRingEquiv⟩
    have hregst : ∀ x : Spec (.of B), IsRegularLocalRing ((Spec (.of B)).presheaf.stalk x) := by
      intro x
      haveI hxp : (x : PrimeSpectrum B).asIdeal.IsPrime := (x : PrimeSpectrum B).isPrime
      haveI := wc_hnas_pfc_regular_localization B hreg (x : PrimeSpectrum B).asIdeal
      obtain ⟨e⟩ := hst x
      exact IsRegularLocalRing.of_ringEquiv e
    refine ⟨inferInstance, inferInstance, inferInstance, inferInstance, ⟨⊤, ?_, inferInstance⟩,
      fun U V hU hV => hU.inf hV, hregst, fun x => hP8 _ (hregst x), ?_⟩
    · rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
      exact ⟨IsLocalRing.closedPoint B, trivial⟩
    · intro x hx
      haveI hxp : (x : PrimeSpectrum B).asIdeal.IsPrime := (x : PrimeSpectrum B).isPrime
      have hmax : (x : PrimeSpectrum B).asIdeal.IsMaximal :=
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal (x : PrimeSpectrum B)).mp hx
      have hxm : (x : PrimeSpectrum B).asIdeal = IsLocalRing.maximalIdeal B :=
        IsLocalRing.eq_maximalIdeal hmax
      obtain ⟨e⟩ := hst x
      refine (ringKrullDim_eq_of_ringEquiv e).symm.trans ?_
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height (x : PrimeSpectrum B).asIdeal
        (Localization.AtPrime (x : PrimeSpectrum B).asIdeal), hxm,
        IsLocalRing.maximalIdeal_height_eq_ringKrullDim, hdim]
  | @step Y0 Y1 g0 y hy r hT0 hgy hbl ih =>
    obtain ⟨hint0, hnoeth0, hprop0, hdom0, ⟨U0, hU0, hU0iso⟩, haff0, hreg0, hnorm0, hdim0⟩ := ih
    haveI := hint0
    haveI := hnoeth0
    haveI := hprop0

    have hyg : genericPoint Y0 ≠ y := by
      intro h
      have h1 := hdim0 y hy
      rw [← h] at h1
      have h2 : ringKrullDim (Y0.presheaf.stalk (genericPoint Y0)) = 0 :=
        ringKrullDim_eq_zero_of_field Y0.functionField
      rw [h2] at h1
      exact h02 h1.symm
    have hsupp : ((Scheme.IdealSheafData.vanishingIdeal
        (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y0)).support : Set Y0) = {y} := by
      rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    obtain ⟨V, hVdef⟩ : ∃ V : Y0.Opens, (V : Set Y0) = {y}ᶜ := ⟨⟨{y}ᶜ, hy.isOpen_compl⟩, rfl⟩
    haveI hrV : IsIso (r ∣_ V) := wc_csd_blowup_iso_off_center Y0 Y1 _ r V hbl
      (by rw [hsupp, hVdef]; exact Set.inter_compl_self _)

    haveI hrprop : IsProper r := fexr_blowup_isProper Y0 Y1 _ r hbl
    haveI : CompactSpace Y1 := QuasiCompact.compactSpace_of_compactSpace r
    haveI : IsLocallyNoetherian Y1 := LocallyOfFiniteType.isLocallyNoetherian r
    have hnoeth1 : IsNoetherian Y1 := ⟨⟩

    have hint1 : AlgebraicGeometry.IsIntegral Y1 := fexr_blowup_isIntegral Y0 Y1 _ r hbl (by
      rw [hsupp]
      intro h
      apply hyg
      have : genericPoint Y0 ∈ ({y} : Set Y0) := by rw [h]; exact Set.mem_univ _
      exact this)
    haveI := hint1

    obtain ⟨D, hDdef⟩ : ∃ D : (Spec (.of B)).Opens,
        (D : Set (Spec (.of B))) = {IsLocalRing.closedPoint B}ᶜ :=
      ⟨⟨{IsLocalRing.closedPoint B}ᶜ, (IsLocalRing.isClosed_singleton_closedPoint B).isOpen_compl⟩,
        rfl⟩
    have hD0 : D ≠ ⊥ := by
      rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
      let x0 : Spec (.of B) := (⟨⊥, inferInstance⟩ : PrimeSpectrum B)
      refine ⟨x0, ?_⟩
      change x0 ∈ (D : Set (Spec (.of B)))
      rw [hDdef]
      exact hp0
    have hU'0 : U0 ⊓ D ≠ ⊥ := by
      rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hU0 hD0 ⊢
      obtain ⟨x, hx1, hx2⟩ := nonempty_preirreducible_inter U0.isOpen D.isOpen hU0 hD0
      exact ⟨x, hx1, hx2⟩
    haveI hgU' : IsIso (g0 ∣_ (U0 ⊓ D)) := hres g0 U0 (U0 ⊓ D) inf_le_left hU0iso
    haveI hrU' : IsIso (r ∣_ (g0 ⁻¹ᵁ (U0 ⊓ D))) := by
      apply wc_csd_blowup_iso_off_center Y0 Y1 _ r _ hbl
      rw [hsupp]
      apply Set.singleton_inter_eq_empty.mpr
      intro h
      have h' : g0 y ∈ U0 ⊓ D := h
      have h2 : g0 y ∈ (D : Set (Spec (.of B))) := (TopologicalSpace.Opens.mem_inf.mp h').2
      rw [hDdef, hgy] at h2
      exact h2 rfl
    haveI hU'iso : IsIso ((r ≫ g0) ∣_ (U0 ⊓ D)) := by
      rw [morphismRestrict_comp]
      exact @IsIso.comp_isIso _ _ _ _ _ _ _ hrU' hgU'

    have hdom1 : IsDominant (r ≫ g0) := by
      rw [isDominant_iff]
      have hsub : ((U0 ⊓ D : (Spec (.of B)).Opens) : Set (Spec (.of B))) ⊆
          Set.range ⇑(r ≫ g0) := by
        intro x hx
        obtain ⟨q, hq⟩ := ((r ≫ g0) ∣_ (U0 ⊓ D)).surjective ⟨x, hx⟩
        refine ⟨q.1, ?_⟩
        rw [← morphismRestrict_base_coe, hq]
      have hne : ((U0 ⊓ D : (Spec (.of B)).Opens) : Set (Spec (.of B))).Nonempty :=
        (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hU'0
      exact Dense.mono hsub ((U0 ⊓ D).isOpen.dense hne)

    haveI hsep : IsSeparated (Limits.terminal.from Y1) := by
      rw [Limits.terminal.hom_ext (Limits.terminal.from Y1) ((r ≫ g0) ≫ Limits.terminal.from _)]
      infer_instance

    have hcases : ∀ y' : Y1, IsRegularLocalRing (Y1.presheaf.stalk y') ∧
        (IsClosed ({y'} : Set Y1) → ringKrullDim (Y1.presheaf.stalk y') = 2) := by
      intro y'
      by_cases hry : r y' = y
      · obtain ⟨A, C, _, _, _, _, 𝔭, _, u, v, φ, t, P, _, hregA, hdimA, h𝔭, hinj, hrel, hgen, hcom,
          ⟨eS⟩, hmax⟩ := fexr_pt_blowup_chart Y0 Y1 y hy (hreg0 y) (hdim0 y hy) r hbl y' hry
        obtain ⟨hr1, hr2⟩ := fexr_chart_regular A 𝔭 hregA hdimA u v h𝔭 C φ hinj t hrel hgen P hcom
        haveI := hr1
        refine ⟨IsRegularLocalRing.of_ringEquiv eS.symm, fun hc => ?_⟩
        exact (ringKrullDim_eq_of_ringEquiv eS).trans (hr2 (hmax hc))
      · have hmem : y' ∈ r ⁻¹ᵁ V := by
          rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, hVdef]
          exact hry
        have h1 : IsIso ((r ∣_ V).stalkMap ⟨y', hmem⟩) :=
          ((isIso_iff_isIso_stalkMap (r ∣_ V)).mp hrV).2 _
        haveI hiso : IsIso (r.stalkMap y') :=
          ((MorphismProperty.isomorphisms CommRingCat).arrow_mk_iso_iff
            (morphismRestrictStalkMap r V ⟨y', hmem⟩)).mp h1
        haveI := hreg0 (r y')
        refine ⟨IsRegularLocalRing.of_ringEquiv
          (asIso (r.stalkMap y')).symm.commRingCatIsoToRingEquiv.symm, fun hc => ?_⟩
        have hc' : IsClosed ({r y'} : Set Y0) := by
          have := r.isClosedMap _ hc
          rwa [Set.image_singleton] at this
        exact (ringKrullDim_eq_of_ringEquiv
          (asIso (r.stalkMap y')).symm.commRingCatIsoToRingEquiv).trans (hdim0 (r y') hc')
    refine ⟨hint1, hnoeth1, inferInstance, hdom1, ⟨U0 ⊓ D, hU'0, hU'iso⟩,
      fun U W hU hW => hU.inf hW, fun y' => (hcases y').1, fun y' => hP8 _ (hcases y').1,
      fun y' hy' => (hcases y').2 hy'⟩

theorem fexr_lam_basic : ∀ (S : Type u) [CommRing S] (I : Ideal S), (fexrLam S I = 0 ↔ I.IsPrincipal) ∧ (∀ (c : S) (J' : Ideal S), I = Ideal.span {c} * J' → fexrLam S I ≤ Module.length S (S ⧸ J')) ∧ (∃ (c : S) (J' : Ideal S), I = Ideal.span {c} * J' ∧ Module.length S (S ⧸ J') = fexrLam S I) ∧ ∀ (S' : Type u) [CommRing S'] (e : S ≃+* S'), fexrLam S' (Ideal.map e I) = fexrLam S I :=
by
  intro S _ I
  have hlen : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (e : R ≃+* R') (J : Ideal R),
      Module.length R' (R' ⧸ Ideal.map e J) = Module.length R (R ⧸ J) := by
    intro R R' _ _ e J
    let q : R ⧸ J ≃+* R' ⧸ Ideal.map e J := Ideal.quotientEquiv J (Ideal.map e J) e rfl
    let f : (R ⧸ J) →ₛₗ[(e : R →+* R')] (R' ⧸ Ideal.map e J) :=
      { toFun := q
        map_add' := map_add q
        map_smul' := by
          intro s x
          rw [Algebra.smul_def, Algebra.smul_def, Ideal.Quotient.algebraMap_eq,
            Ideal.Quotient.algebraMap_eq, map_mul]
          congr 1 }
    have hf : Function.Bijective f := q.bijective
    have hO := Order.krullDim_eq_of_orderIso (Submodule.orderIsoMapComapOfBijective f hf)
    rw [← Module.coe_length, ← Module.coe_length] at hO
    exact (WithBot.coe_injective hO).symm
  have hmem : ∀ (R : Type u) [CommRing R] (K : Ideal R), ∃ (c : R) (J' : Ideal R),
      K = Ideal.span {c} * J' ∧ Module.length R (R ⧸ J') = fexrLam R K := by
    intro R _ K
    have hne : {n : ℕ∞ | ∃ (c : R) (J' : Ideal R), K = Ideal.span {c} * J' ∧
        Module.length R (R ⧸ J') = n}.Nonempty :=
      ⟨_, 1, K, by rw [Ideal.span_singleton_one, Ideal.top_mul], rfl⟩
    exact csInf_mem hne
  have hle : ∀ (R : Type u) [CommRing R] (K : Ideal R) (c : R) (J' : Ideal R),
      K = Ideal.span {c} * J' → fexrLam R K ≤ Module.length R (R ⧸ J') :=
    fun R _ K c J' h => sInf_le ⟨c, J', h, rfl⟩
  have htrans : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (e : R ≃+* R') (K : Ideal R),
      fexrLam R' (Ideal.map e K) ≤ fexrLam R K := by
    intro R R' _ _ e K
    obtain ⟨c, J', hK, hl⟩ := hmem R K
    rw [← hl, ← hlen R R' e J']
    apply hle R' _ (e c)
    rw [hK, Ideal.map_mul, Ideal.map_span, Set.image_singleton]
  refine ⟨⟨fun h0 => ?_, fun hp => ?_⟩, hle S I, hmem S I, fun S' _ e =>
    le_antisymm (htrans S S' e I) ?_⟩
  · obtain ⟨c, J', hI, hl⟩ := hmem S I
    rw [h0, Module.length_eq_zero_iff, Ideal.Quotient.subsingleton_iff] at hl
    rw [hI, hl, Ideal.mul_top]
    exact ⟨⟨c, rfl⟩⟩
  · obtain ⟨c, hc⟩ := hp.principal
    have h1 : I = Ideal.span {c} * ⊤ := by rw [Ideal.mul_top]; exact hc
    have h2 := hle S I c ⊤ h1
    rw [Module.length_eq_zero_iff.mpr (Ideal.Quotient.subsingleton_iff.mpr rfl)] at h2
    exact nonpos_iff_eq_zero.mp h2
  · have h3 := htrans S' S e.symm (Ideal.map e I)
    have hI : Ideal.map e.symm (Ideal.map e I) = I := by
      rw [Ideal.map_symm, Ideal.comap_map_of_bijective _ e.bijective]
    rwa [hI] at h3

theorem fexr_base_lam_finite : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (J : Ideal B), (∃ N : ℕ, IsLocalRing.maximalIdeal B ^ N ≤ J) → ∀ p : Spec (.of B), fexrLam ((Spec (.of B)).presheaf.stalk p) (Ideal.map (wcNdSig (𝟙 (Spec (.of B))) p) J) ≠ ⊤ :=
by
  intro B _ _ _ J hJ p
  obtain ⟨N, hN⟩ := hJ

  have s1 : ∀ (S : Type u) [CommRing S] [IsLocalRing S] [IsNoetherianRing S] (I : Ideal S),
      IsLocalRing.maximalIdeal S ^ N ≤ I → Module.length S (S ⧸ I) ≠ ⊤ := by
    intro S _ _ _ I hI
    haveI : IsNoetherian S (S ⧸ I) := isNoetherian_quotient (R := S) (A := S) (M := S) I
    by_cases hItop : I = ⊤
    · subst hItop
      haveI : Subsingleton (S ⧸ (⊤ : Ideal S)) := Ideal.Quotient.subsingleton_iff.mpr rfl
      rw [Module.length_eq_zero]
      exact ENat.zero_ne_top
    · haveI : Nontrivial (S ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hItop
      haveI : IsLocalRing (S ⧸ I) :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
      have hmax : IsLocalRing.maximalIdeal (S ⧸ I) ≤
          Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal S) := by
        intro z hz
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
        apply Ideal.mem_map_of_mem
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hz
        exact hz (hu.map _)
      have hnil : IsNilpotent (IsLocalRing.maximalIdeal (S ⧸ I)) := by
        refine ⟨N, ?_⟩
        rw [Ideal.zero_eq_bot, eq_bot_iff]
        calc IsLocalRing.maximalIdeal (S ⧸ I) ^ N
            ≤ (Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal S)) ^ N :=
              Ideal.pow_right_mono hmax N
          _ = Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal S ^ N) :=
              (Ideal.map_pow _ _ _).symm
          _ ≤ Ideal.map (Ideal.Quotient.mk I) I := Ideal.map_mono hI
          _ = ⊥ := Ideal.map_quotient_self I
      haveI : IsArtinianRing (S ⧸ I) :=
        (isArtinianRing_iff_isNilpotent_maximalIdeal (S ⧸ I)).mpr hnil
      haveI : IsArtinian S (S ⧸ I) :=
        isArtinian_of_surjective_algebraMap (R := S ⧸ I) (S := S) (M := S ⧸ I)
          (Ideal.Quotient.mk_surjective (I := I))
      exact Module.length_ne_top

  letI alg : Algebra B ((Spec (.of B)).presheaf.stalk p) := StructureSheaf.stalkAlgebra B p
  haveI hpr : p.asIdeal.IsPrime := p.isPrime
  haveI hloc : IsLocalization.AtPrime ((Spec (.of B)).presheaf.stalk p) p.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk B p
  have hσ : wcNdSig (𝟙 (Spec (.of B))) p = algebraMap B ((Spec (.of B)).presheaf.stalk p) := by
    ext x
    have e1 : wcNdSig (𝟙 (Spec (.of B))) p x
        = ((Spec (.of B)).presheaf.germ ⊤ p trivial).hom ((Scheme.ΓSpecIso (.of B)).inv.hom x) := by
      unfold wcNdSig wcCnSigma
      simp only [RingHom.comp_apply, homOfLE_refl, op_id, CategoryTheory.Functor.map_id,
        Scheme.Hom.id_appTop, CommRingCat.hom_id, RingHom.id_apply]
    rw [e1]
    rfl
  have hmaxS : IsLocalRing.maximalIdeal ((Spec (.of B)).presheaf.stalk p) =
      Ideal.map (wcNdSig (𝟙 (Spec (.of B))) p) p.asIdeal := by
    rw [hσ]
    exact (IsLocalization.AtPrime.map_eq_maximalIdeal p.asIdeal _).symm
  have hp : p.asIdeal ≤ IsLocalRing.maximalIdeal B :=
    IsLocalRing.le_maximalIdeal p.isPrime.ne_top
  have hpow : IsLocalRing.maximalIdeal ((Spec (.of B)).presheaf.stalk p) ^ N ≤
      Ideal.map (wcNdSig (𝟙 (Spec (.of B))) p) J := by
    rw [hmaxS]
    calc Ideal.map (wcNdSig (𝟙 (Spec (.of B))) p) p.asIdeal ^ N
        ≤ Ideal.map (wcNdSig (𝟙 (Spec (.of B))) p) (IsLocalRing.maximalIdeal B) ^ N :=
          Ideal.pow_right_mono (Ideal.map_mono hp) N
      _ = Ideal.map (wcNdSig (𝟙 (Spec (.of B))) p) (IsLocalRing.maximalIdeal B ^ N) :=
          (Ideal.map_pow _ _ _).symm
      _ ≤ Ideal.map (wcNdSig (𝟙 (Spec (.of B))) p) J := Ideal.map_mono hN
  have hlen := s1 _ _ hpow
  refine ne_top_of_le_ne_top hlen ?_
  unfold fexrLam
  apply sInf_le
  refine ⟨1, Ideal.map (wcNdSig (𝟙 (Spec (.of B))) p) J, ?_, rfl⟩
  rw [Ideal.span_singleton_one, Ideal.top_mul]

theorem fexr_nonprincipal_locus_finite : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Y : Scheme.{u}) [IsNoetherian Y] (g : Y ⟶ Spec (.of B)), (∀ y : Y, IsRegularLocalRing (Y.presheaf.stalk y)) → (∀ y : Y, IsClosed ({y} : Set Y) → ringKrullDim (Y.presheaf.stalk y) = 2) → ∀ (J : Ideal B), (∃ N : ℕ, IsLocalRing.maximalIdeal B ^ N ≤ J) → Set.Finite {y : Y | ¬ (Ideal.map (wcNdSig g y) J).IsPrincipal} ∧ ∀ y : Y, ¬ (Ideal.map (wcNdSig g y) J).IsPrincipal → IsClosed ({y} : Set Y) ∧ g y = IsLocalRing.closedPoint B :=
by
  intro B _ _ Y _ g hreg hdim J hJ
  classical

  have hres : ∀ (U V : Y.Opens) (h : V ≤ U) (y : Y) (hy : y ∈ V) (s : Γ(Y, U)),
      (Y.presheaf.germ V y hy).hom ((Y.presheaf.map (homOfLE h).op).hom s) =
        (Y.presheaf.germ U y (h hy)).hom s := by
    intro U V h y hy s
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, TopCat.Presheaf.germ_res]

  have s1 : ∀ (U : Y.Opens) (y : Y) (hy : y ∈ U),
      wcNdSig g y = (Y.presheaf.germ U y hy).hom.comp (wcCnSigma g U) := by
    intro U y hy
    ext b
    exact (hres ⊤ ⊤ le_rfl y trivial _).trans (hres ⊤ U le_top y hy _).symm

  have s2 : ∀ (y : Y) (b : B), IsUnit (wcNdSig g y b) ↔ b ∉ (g y).asIdeal := by
    intro y b
    have e : wcNdSig g y b =
        Y.presheaf.germ ⊤ y trivial (g.appTop ((Scheme.ΓSpecIso (.of B)).inv b)) :=
      hres ⊤ ⊤ le_rfl y trivial _
    rw [e, ← Scheme.mem_basicOpen_top, ← Scheme.preimage_basicOpen_top, Scheme.Hom.mem_preimage,
      basicOpen_eq_of_affine]
    exact PrimeSpectrum.mem_basicOpen _ _

  have s3 : ∀ y : Y, g y ≠ IsLocalRing.closedPoint B → Ideal.map (wcNdSig g y) J = ⊤ := by
    intro y hy
    obtain ⟨N, hN⟩ := hJ
    haveI := (g y).isPrime
    have hle : (g y).asIdeal ≤ IsLocalRing.maximalIdeal B :=
      IsLocalRing.le_maximalIdeal_of_isPrime _
    have hne : (g y).asIdeal ≠ IsLocalRing.maximalIdeal B := fun h => hy (PrimeSpectrum.ext h)
    obtain ⟨x, hxm, hxq⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hle hne)
    have hxJ : x ^ N ∈ J := hN (Ideal.pow_mem_pow hxm N)
    have hxN : x ^ N ∉ (g y).asIdeal := fun h => hxq ((g y).isPrime.mem_of_pow_mem N h)
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hxJ) ((s2 y _).mpr hxN)

  have s4 : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R], ringKrullDim R ≤ 1 →
      ∀ I : Ideal R, I.IsPrincipal := by
    intro R _ _ hR I
    have h1 : Submodule.spanFinrank (IsLocalRing.maximalIdeal R) ≤ 1 := by
      have := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
      rw [← this] at hR
      exact_mod_cast hR
    have hfg : (IsLocalRing.maximalIdeal R).FG := IsNoetherian.noetherian _
    obtain ⟨s, hs1, hs2⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hfg
    obtain ⟨x, hx⟩ : ∃ x : R, IsLocalRing.maximalIdeal R = Ideal.span {x} := by
      have hle : s.encard ≤ 1 := by rw [hs1]; exact_mod_cast h1
      rcases Set.encard_le_one_iff_eq.mp hle with h | ⟨x, hx⟩
      · refine ⟨0, ?_⟩
        rw [← hs2, h, Submodule.span_empty, Ideal.span_singleton_eq_bot.mpr rfl]
      · exact ⟨x, by rw [← hs2, hx, Ideal.submodule_span_eq]⟩
    by_cases hI : I = ⊥
    · rw [hI]; exact ⟨⟨0, by rw [Ideal.submodule_span_eq, Ideal.span_singleton_eq_bot.mpr rfl]⟩⟩
    have hInf := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have hex : ∃ n, ¬ I ≤ IsLocalRing.maximalIdeal R ^ n := by
      by_contra hcon
      push_neg at hcon
      have := le_iInf hcon
      rw [hInf] at this
      exact hI (le_bot_iff.mp this)
    obtain ⟨n, hn, hmin⟩ : ∃ n, ¬ I ≤ IsLocalRing.maximalIdeal R ^ n ∧
        ∀ m, ¬ I ≤ IsLocalRing.maximalIdeal R ^ m → n ≤ m :=
      ⟨Nat.find hex, Nat.find_spec hex, fun m h => Nat.find_min' hex h⟩
    have hn0 : n ≠ 0 := by intro h; apply hn; rw [h, pow_zero, Ideal.one_eq_top]; exact le_top
    obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hn0
    have hkle : I ≤ IsLocalRing.maximalIdeal R ^ k := by
      by_contra h; have := hmin k h; omega
    rw [hk] at hn
    obtain ⟨a, haI, ha⟩ := SetLike.not_le_iff_exists.mp hn
    have hpow : ∀ m, IsLocalRing.maximalIdeal R ^ m = Ideal.span {x ^ m} := fun m => by
      rw [hx, Ideal.span_singleton_pow]
    have haK := hkle haI
    rw [hpow, Ideal.mem_span_singleton'] at haK
    obtain ⟨c, hc⟩ := haK
    have hcu : IsUnit c := by
      by_contra hcu
      apply ha
      have hcm : c ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal c).mpr hcu
      rw [hx, Ideal.mem_span_singleton'] at hcm
      obtain ⟨d, hd⟩ := hcm
      rw [hpow, Ideal.mem_span_singleton']
      exact ⟨d, by rw [← hc, ← hd, Nat.succ_eq_add_one, pow_succ]; ring⟩
    have hxk : x ^ k ∈ I := by
      have : x ^ k = (hcu.unit⁻¹ : Rˣ) * a := by
        rw [← hc, ← mul_assoc, hcu.val_inv_mul, one_mul]
      rw [this]; exact I.mul_mem_left _ haI
    refine ⟨⟨x ^ k, ?_⟩⟩
    rw [Ideal.submodule_span_eq]
    apply le_antisymm
    · rw [← hpow]; exact hkle
    · rw [Ideal.span_singleton_le_iff_mem]; exact hxk

  have s5 : ∀ z : Y, ¬ IsClosed ({z} : Set Y) → ringKrullDim (Y.presheaf.stalk z) ≤ 1 := by
    intro z hz
    obtain ⟨z', hz'S, hz'c⟩ :=
      IsClosed.exists_closed_singleton (isClosed_closure (s := ({z} : Set Y))) ⟨z, subset_closure rfl⟩
    have hsp : z ⤳ z' := specializes_iff_mem_closure.mpr hz'S
    have hne : z' ≠ z := fun h => hz (h ▸ hz'c)
    obtain ⟨U, hU, hz'U, -⟩ := exists_isAffineOpen_mem_and_subset (x := z') (U := ⊤) trivial
    have hzU : z ∈ U := hsp.mem_open U.isOpen hz'U
    let x : U := ⟨z, hzU⟩
    let x' : U := ⟨z', hz'U⟩
    have hind := hU.fromSpec.isOpenEmbedding.isInducing
    have hfx : hU.fromSpec (hU.primeIdealOf x) = z := hU.fromSpec_primeIdealOf x
    have hfx' : hU.fromSpec (hU.primeIdealOf x') = z' := hU.fromSpec_primeIdealOf x'
    have hspP : hU.primeIdealOf x ⤳ hU.primeIdealOf x' := by
      have h0 : hU.fromSpec (hU.primeIdealOf x) ⤳ hU.fromSpec (hU.primeIdealOf x') := by
        rw [hfx, hfx']; exact hsp
      exact hind.specializes_iff.mp h0
    have hle : (hU.primeIdealOf x).asIdeal ≤ (hU.primeIdealOf x').asIdeal :=
      (PrimeSpectrum.le_iff_specializes _ _).mpr hspP
    have hneP : (hU.primeIdealOf x).asIdeal ≠ (hU.primeIdealOf x').asIdeal := by
      intro h
      apply hne
      rw [← hfx, ← hfx', PrimeSpectrum.ext h]
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk z) := (Y.presheaf.germ U z hzU).hom.toAlgebra
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk z') := (Y.presheaf.germ U z' hz'U).hom.toAlgebra
    haveI : IsLocalization.AtPrime (Y.presheaf.stalk z) (hU.primeIdealOf x).asIdeal :=
      hU.isLocalization_stalk x
    haveI : IsLocalization.AtPrime (Y.presheaf.stalk z') (hU.primeIdealOf x').asIdeal :=
      hU.isLocalization_stalk x'
    have e1 := IsLocalization.AtPrime.ringKrullDim_eq_height (hU.primeIdealOf x).asIdeal
      (Y.presheaf.stalk z)
    have e2 := IsLocalization.AtPrime.ringKrullDim_eq_height (hU.primeIdealOf x').asIdeal
      (Y.presheaf.stalk z')
    have h2 := hdim z' hz'c
    rw [e2] at h2
    have h2' : (hU.primeIdealOf x').asIdeal.height ≤ ((2 : ℕ) : ℕ∞) := by
      have : (hU.primeIdealOf x').asIdeal.height = 2 := WithBot.coe_inj.mp h2
      rw [this]; rfl
    have h3 := (Ideal.height_le_iff.mp h2') _ inferInstance (lt_of_le_of_ne hle hneP)
    have h4 : (hU.primeIdealOf x).asIdeal.height < 2 := by exact_mod_cast h3
    rw [e1]
    have h5 : (hU.primeIdealOf x).asIdeal.height ≤ 1 := Order.le_of_lt_succ h4
    exact_mod_cast h5

  have s6 : IsOpen {y : Y | (Ideal.map (wcNdSig g y) J).IsPrincipal} := by
    rw [isOpen_iff_forall_mem_open]
    intro y hy
    have hy' : (Ideal.map (wcNdSig g y) J).IsPrincipal := hy
    obtain ⟨U, hU, hyU, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    haveI : IsNoetherianRing Γ(Y, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
    set I : Ideal Γ(Y, U) := Ideal.map (wcCnSigma g U) J with hI
    have hloc : ∀ w (hw : w ∈ U), Ideal.map (wcNdSig g w) J =
        Ideal.map (Y.presheaf.germ U w hw).hom I := by
      intro w hw; rw [hI, Ideal.map_map, ← s1 U w hw]
    obtain ⟨n, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
      (IsNoetherian.noetherian I)
    let x0 : U := ⟨y, hyU⟩
    set p := (hU.primeIdealOf x0).asIdeal with hp
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk y) := (Y.presheaf.germ U y hyU).hom.toAlgebra
    haveI hL : IsLocalization.AtPrime (Y.presheaf.stalk y) p := hU.isLocalization_stalk x0
    have halg : algebraMap Γ(Y, U) (Y.presheaf.stalk y) = (Y.presheaf.germ U y hyU).hom := rfl
    obtain ⟨⟨x, hx⟩⟩ := hy'
    have hxmem : x ∈ Ideal.map (algebraMap Γ(Y, U) (Y.presheaf.stalk y)) I := by
      rw [halg, ← hloc y hyU, hx]; exact Submodule.mem_span_singleton_self x
    obtain ⟨⟨⟨a, haI⟩, ⟨t, ht⟩⟩, hat⟩ :=
      (IsLocalization.mem_map_algebraMap_iff p.primeCompl (Y.presheaf.stalk y)).mp hxmem
    simp only at hat
    have hspan : Ideal.map (wcNdSig g y) J =
        Ideal.span {algebraMap Γ(Y, U) (Y.presheaf.stalk y) a} := by
      rw [← hat, Ideal.span_singleton_mul_right_unit
        (IsLocalization.map_units (Y.presheaf.stalk y) (⟨t, ht⟩ : p.primeCompl)), hx,
        Ideal.submodule_span_eq]
    have rel : ∀ i, ∃ b t u : Γ(Y, U), t ∈ p.primeCompl ∧ u ∈ p.primeCompl ∧
        u * (f i * t) = u * (a * b) := by
      intro i
      have hfi : algebraMap Γ(Y, U) (Y.presheaf.stalk y) (f i) ∈ Ideal.map (wcNdSig g y) J := by
        rw [hloc y hyU, ← halg, ← hf]
        exact Ideal.mem_map_of_mem _ (Submodule.subset_span ⟨i, rfl⟩)
      rw [hspan, Ideal.mem_span_singleton'] at hfi
      obtain ⟨zi, hzi⟩ := hfi
      obtain ⟨⟨bi, ti⟩, hbt⟩ := IsLocalization.mk'_surjective p.primeCompl zi
      try simp only at hbt
      have hspec := IsLocalization.mk'_spec (Y.presheaf.stalk y) bi ti
      rw [hbt] at hspec
      have heq : algebraMap Γ(Y, U) (Y.presheaf.stalk y) (f i * ti) =
          algebraMap Γ(Y, U) (Y.presheaf.stalk y) (a * bi) := by
        rw [map_mul, map_mul, ← hzi, ← hspec]; ring
      obtain ⟨⟨ui, hui⟩, hu⟩ := (IsLocalization.eq_iff_exists p.primeCompl _).mp heq
      exact ⟨bi, ti, ui, ti.2, hui, hu⟩
    choose b t' u ht' hu hrel using rel
    set s : Γ(Y, U) := ∏ i, u i * t' i with hsdef
    have hs : s ∈ p.primeCompl := p.primeCompl.prod_mem (fun i _ => mul_mem (hu i) (ht' i))
    refine ⟨Y.basicOpen s, fun w hw => ?_, (Y.basicOpen s).isOpen, ?_⟩
    · have hwU : w ∈ U := Y.basicOpen_le s hw
      have hunit : IsUnit ((Y.presheaf.germ U w hwU).hom s) :=
        (Scheme.mem_basicOpen Y s w hwU).mp hw
      have hrel' : ∀ i, ∃ c, c * (Y.presheaf.germ U w hwU).hom a =
          (Y.presheaf.germ U w hwU).hom (f i) := by
        intro i
        have hdvd : u i * t' i ∣ s := Finset.dvd_prod_of_mem (fun i => u i * t' i) (Finset.mem_univ i)
        have hui : IsUnit ((Y.presheaf.germ U w hwU).hom (u i * t' i)) :=
          isUnit_of_dvd_unit (map_dvd _ hdvd) hunit
        obtain ⟨v, hv⟩ := hui.exists_right_inv
        have hab : f i * (u i * t' i) = a * (b i * u i) := by linear_combination hrel i
        refine ⟨(Y.presheaf.germ U w hwU).hom (b i * u i) * v, ?_⟩
        calc (Y.presheaf.germ U w hwU).hom (b i * u i) * v * (Y.presheaf.germ U w hwU).hom a
            = (Y.presheaf.germ U w hwU).hom (a * (b i * u i)) * v := by simp only [map_mul]; ring
          _ = (Y.presheaf.germ U w hwU).hom (f i * (u i * t' i)) * v := by rw [hab]
          _ = (Y.presheaf.germ U w hwU).hom (f i) *
                ((Y.presheaf.germ U w hwU).hom (u i * t' i) * v) := by simp only [map_mul]; ring
          _ = _ := by rw [hv, mul_one]
      show (Ideal.map (wcNdSig g w) J).IsPrincipal
      refine ⟨⟨(Y.presheaf.germ U w hwU).hom a, ?_⟩⟩
      rw [Ideal.submodule_span_eq, hloc w hwU]
      apply le_antisymm
      · rw [← hf, Ideal.submodule_span_eq, Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
        rw [SetLike.mem_coe, Ideal.mem_span_singleton']
        exact hrel' i
      · rw [Ideal.span_singleton_le_iff_mem]
        exact Ideal.mem_map_of_mem _ haI
    · refine (Scheme.mem_basicOpen Y s y hyU).mpr ?_
      have hu0 := IsLocalization.map_units (M := p.primeCompl) (Y.presheaf.stalk y)
        (⟨s, hs⟩ : p.primeCompl)
      exact hu0

  have s7 : ∀ (Z : Set Y), IsClosed Z → (∀ z ∈ Z, IsClosed ({z} : Set Y)) → Z.Finite := by
    intro Z hZ hpts
    obtain ⟨S, hSfin, hSc, hSi, hZS⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hZ
    have hfin : (⋃₀ S).Finite := by
      refine hSfin.sUnion ?_
      intro t ht
      obtain ⟨η, hg⟩ : ∃ η, IsGenericPoint η t :=
        ⟨_, (hSi t ht).isGenericPoint_genericPoint (hSc t ht)⟩
      have hη : η ∈ Z := by rw [hZS]; exact Set.mem_sUnion_of_mem hg.mem ht
      have htη : t = {η} := by rw [← hg.def, (hpts _ hη).closure_eq]
      rw [htη]; exact Set.finite_singleton _
    rw [hZS]; exact hfin

  have K : ∀ y : Y, ¬ (Ideal.map (wcNdSig g y) J).IsPrincipal →
      IsClosed ({y} : Set Y) ∧ g y = IsLocalRing.closedPoint B := by
    intro y hy
    refine ⟨?_, ?_⟩
    · by_contra hc
      haveI := hreg y
      exact hy (s4 _ (s5 y hc) _)
    · by_contra hc
      apply hy
      rw [s3 y hc]
      exact ⟨⟨1, by rw [Ideal.submodule_span_eq, Ideal.span_singleton_one]⟩⟩
  refine ⟨?_, K⟩
  apply s7
  · have : {y : Y | ¬ (Ideal.map (wcNdSig g y) J).IsPrincipal} =
        {y : Y | (Ideal.map (wcNdSig g y) J).IsPrincipal}ᶜ := rfl
    rw [this, isClosed_compl_iff]; exact s6
  · intro z hz; exact (K z hz).1

theorem fexr_offcenter_transport : ∀ (Y Y' : Scheme.{u}) (y : Y) (hy : IsClosed ({y} : Set Y)) (r : Y' ⟶ Y), wcCsdIsBlowup (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)) r → (∀ z : Y, z ≠ y → ∃! z' : Y', r z' = z) ∧ ∀ z' : Y', r z' ≠ y → Function.Bijective (r.stalkMap z').hom :=
by
  intro Y Y' y hy r hbl
  let W : Y.Opens := ⟨({y} : Set Y)ᶜ, hy.isOpen_compl⟩
  have hmemW : ∀ z : Y, z ∈ W ↔ z ≠ y := fun z => Iff.rfl
  have hsupp : ((Scheme.IdealSheafData.vanishingIdeal
      (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)).support : Set Y) ∩ (W : Set Y) = ∅ := by
    rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]
    exact Set.inter_compl_self _
  haveI hiso : IsIso (r ∣_ W) := wc_csd_blowup_iso_off_center Y Y' _ r W hbl hsupp
  have hcomm : ∀ x : (r ⁻¹ᵁ W).toScheme, W.ι ((r ∣_ W) x) = r ((r ⁻¹ᵁ W).ι x) := by
    intro x
    rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
  refine ⟨fun z hz => ?_, fun z' hz' => ?_⟩
  · have hzW : z ∈ W := (hmemW z).mpr hz
    obtain ⟨w, hw⟩ : z ∈ Set.range W.ι.base := by
      rw [Scheme.Opens.range_ι]; exact hzW
    have hw' : W.ι w = z := hw
    obtain ⟨x, hx⟩ := (r ∣_ W).homeomorph.surjective w
    rw [Scheme.Hom.homeomorph_apply] at hx
    have hx' : r ((r ⁻¹ᵁ W).ι x) = z := by rw [← hcomm, hx, hw']
    refine ⟨(r ⁻¹ᵁ W).ι x, hx', fun z2 h2 => ?_⟩
    have h2' : r z2 = z := h2
    have h2W : z2 ∈ r ⁻¹ᵁ W := by
      rw [Scheme.Hom.mem_preimage, h2']; exact hzW
    obtain ⟨x2, hx2⟩ : z2 ∈ Set.range (r ⁻¹ᵁ W).ι.base := by
      rw [Scheme.Opens.range_ι]; exact h2W
    have hx2' : (r ⁻¹ᵁ W).ι x2 = z2 := hx2
    have e : W.ι ((r ∣_ W) x2) = W.ι ((r ∣_ W) x) := by
      rw [hcomm, hcomm, hx2', h2', hx']
    have e2 : (r ∣_ W) x2 = (r ∣_ W) x := W.ι.isOpenEmbedding.injective e
    have e3 : x2 = x := (r ∣_ W).isOpenEmbedding.injective e2
    rw [← hx2', e3]
  · have hW : z' ∈ r ⁻¹ᵁ W := by
      rw [Scheme.Hom.mem_preimage]; exact (hmemW _).mpr hz'
    let x : (r ⁻¹ᵁ W) := ⟨z', hW⟩
    have h1 : IsIso ((r ∣_ W).stalkMap x) := ((isIso_iff_isIso_stalkMap _).mp hiso).2 x
    have h2 : IsIso (r.stalkMap z') :=
      ((MorphismProperty.isomorphisms CommRingCat).arrow_mk_iso_iff
        (morphismRestrictStalkMap r W x)).mp h1
    exact ConcreteCategory.bijective_of_isIso _

theorem fexr_wcNdSig_comp : ∀ (B : Type u) [CommRing B] (Y Y' : Scheme.{u}) (g : Y ⟶ Spec (.of B)) (r : Y' ⟶ Y) (y' : Y'), wcNdSig (r ≫ g) y' = (r.stalkMap y').hom.comp (wcNdSig g (r y')) :=
by
  intro B _ Y Y' g r y'
  ext b
  simp only [wcNdSig, wcCnSigma, RingHom.comp_apply]
  have e : ∀ X : Scheme.{u}, (homOfLE (le_top : (⊤ : X.Opens) ≤ ⊤)) = 𝟙 ⊤ :=
    fun X => Subsingleton.elim _ _
  simp only [e, op_id, CategoryTheory.Functor.map_id, CommRingCat.id_apply,
    Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
  exact (Scheme.Hom.germ_stalkMap_apply r ⊤ y' trivial _).symm

theorem fexr_blowup_stalk_chart : ∀ (Y Y' : Scheme.{u}) [IsNoetherian Y] (y : Y) (hy : IsClosed ({y} : Set Y)) (r : Y' ⟶ Y), AlgebraicGeometry.IsIntegral Y → AlgebraicGeometry.IsIntegral Y' → IsRegularLocalRing (Y.presheaf.stalk y) → ringKrullDim (Y.presheaf.stalk y) = 2 → wcCsdIsBlowup (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)) r → ∀ y' : Y', r y' = y → ∃ (a b : Y.presheaf.stalk (r y')) (c : Y'.presheaf.stalk y'), IsLocalRing.maximalIdeal (Y.presheaf.stalk (r y')) = Ideal.span {a, b} ∧ b ∉ Ideal.span {a} ∧ a ∉ Ideal.span {b} ∧ (r.stalkMap y').hom b = (r.stalkMap y').hom a * c ∧ Function.Injective (r.stalkMap y').hom ∧ ∀ s : Y'.presheaf.stalk y', ∃ p q : Polynomial (Y.presheaf.stalk (r y')), q.eval₂ (r.stalkMap y').hom c ∉ IsLocalRing.maximalIdeal (Y'.presheaf.stalk y') ∧ s * q.eval₂ (r.stalkMap y').hom c = p.eval₂ (r.stalkMap y').hom c :=
by
  intro Y Y' _ y hy r hY hY' hreg hdim hbl y' hry
  haveI := hY
  haveI := hY'


  have htop : ∀ {X X' : Scheme.{u}} (q : X' ⟶ X) (V : X'.Opens), V ≤ q ⁻¹ᵁ ⊤ :=
    fun _ _ => by simp

  have hgerm : ∀ (X Z : Scheme.{u}) (f : X ⟶ Z) (U : Z.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U)
      (x : X) (hx : x ∈ V) (hfx : f x ∈ U) (s : Γ(Z, U)),
      (X.presheaf.germ V x hx).hom ((f.appLE U V e).hom s) =
        (f.stalkMap x).hom ((Z.presheaf.germ U (f x) hfx).hom s) := by
    intro X Z f U V e x hx hfx s
    rw [Scheme.Hom.germ_stalkMap_apply]
    rw [Scheme.Hom.appLE, CommRingCat.comp_apply, TopCat.Presheaf.germ_res_apply]

  have hfrac : ∀ (X : Scheme.{u}) (W : X.Opens), IsAffineOpen W → ∀ (x : X) (hx : x ∈ W)
      (s : X.presheaf.stalk x), ∃ a w : Γ(X, W), IsUnit ((X.presheaf.germ W x hx).hom w) ∧
        s * (X.presheaf.germ W x hx).hom w = (X.presheaf.germ W x hx).hom a := by
    intro X W hW x hx s
    letI := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hx⟩
    haveI := hW.isLocalization_stalk ⟨x, hx⟩
    obtain ⟨⟨a, w⟩, haw⟩ := IsLocalization.surj (hW.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl s
    exact ⟨a, w, IsLocalization.map_units (X.presheaf.stalk x) w, haw⟩

  have hbij : ∀ (X Z : Scheme.{u}) (f : X ⟶ Z) [IsOpenImmersion f] (U : Z.Opens) (V : X.Opens)
      (e : V ≤ f ⁻¹ᵁ U), f ''ᵁ V = U → Function.Bijective (f.appLE U V e).hom := by
    intro X Z f _ U V e h
    subst h
    have h1 : f.appLE (f ''ᵁ V) V e = (f.appIso V).hom := by rw [Scheme.Hom.appIso_hom]; rfl
    rw [h1]
    exact ConcreteCategory.bijective_of_isIso _

  have hs7 : ∀ (X X' : Scheme.{u}) (J : X.IdealSheafData) (q : X' ⟶ X) (V : X.Opens),
      wcCsdIsBlowup J q → wcCsdIsBlowup (J.comap V.ι) (q ∣_ V) := by
    intro X X' J q V hq0
    have hq := wcpa_dj_nc_blowup_flat_basechange X X' V.toScheme J q V.ι inferInstance hq0
    set e := (isPullback_morphismRestrict q V).flip.isoPullback with he_def
    have he : e.hom ≫ Limits.pullback.snd q V.ι = q ∣_ V := IsPullback.isoPullback_hom_snd _
    refine ⟨?_, ?_⟩
    · rw [← he]
      exact wcpa_dj_lr1k_ebd_invpull_flat_pre _ _ _ _ _ e.hom inferInstance hq.1
    · intro T h hh
      obtain ⟨h', hh', huniq⟩ := hq.2 T h hh
      refine ⟨h' ≫ e.inv, ?_, fun c hc => ?_⟩
      · show (h' ≫ e.inv) ≫ q ∣_ V = h
        rw [← he, Category.assoc, e.inv_hom_id_assoc, hh']
      · have hc' : c ≫ q ∣_ V = h := hc
        have h1 : c ≫ e.hom = h' := huniq _ (by
          show (c ≫ e.hom) ≫ Limits.pullback.snd q V.ι = h
          rw [Category.assoc, he]
          exact hc')
        rw [← h1, Category.assoc, e.hom_inv_id, Category.comp_id]


  have hgen : r (genericPoint Y') = genericPoint Y := by
    have hne : genericPoint Y ≠ y := by
      intro he
      have hdim' := hdim
      subst he
      have h0 : ringKrullDim (Y.presheaf.stalk (genericPoint Y)) = 0 :=
        ringKrullDim_eq_zero_of_field Y.functionField
      exact absurd (h0.symm.trans hdim') (by decide)
    have hsupp : ((Scheme.IdealSheafData.vanishingIdeal
        (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)).support : Set Y) = {y} :=
      Scheme.IdealSheafData.coe_support_vanishingIdeal _
    let Yc : Y.Opens := ⟨{y}ᶜ, hy.isOpen_compl⟩
    haveI hiso : IsIso (r ∣_ Yc) := by
      apply wc_csd_blowup_iso_off_center Y Y' _ r Yc hbl
      rw [hsupp]
      exact Set.inter_compl_self _
    let p : Yc.toScheme := ⟨genericPoint Y, hne⟩
    obtain ⟨q, hq⟩ := (r ∣_ Yc).surjective p
    have hrq : r q.1 = genericPoint Y := by
      have h1 := morphismRestrict_base_coe r Yc q
      rw [hq] at h1
      exact h1.symm
    have h1 : r (genericPoint Y') ⤳ genericPoint Y := by
      rw [← hrq]
      exact ((genericPoint_spec Y').specializes (Set.mem_univ _)).map r.continuous
    have h2 : genericPoint Y ⤳ r (genericPoint Y') :=
      (genericPoint_spec Y).specializes (Set.mem_univ _)
    exact (h1.antisymm h2).eq

  subst hry
  haveI := hreg

  have hfr : Submodule.spanFinrank (IsLocalRing.maximalIdeal (Y.presheaf.stalk (r y'))) = 2 := by
    have h1 := IsRegularLocalRing.spanFinrank_maximalIdeal (R := Y.presheaf.stalk (r y'))
    rw [hdim] at h1
    exact_mod_cast h1
  have hs3 : ∃ gh : Fin 2 → Y.presheaf.stalk (r y'),
      Ideal.span (Set.range gh) = IsLocalRing.maximalIdeal (Y.presheaf.stalk (r y')) := by
    obtain ⟨s, hs, hspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank
      (_root_.IsNoetherian.noetherian (IsLocalRing.maximalIdeal (Y.presheaf.stalk (r y'))))
    rw [hfr] at hs
    obtain ⟨a, b, -, rfl⟩ := Set.encard_eq_two.mp (by exact_mod_cast hs)
    refine ⟨![a, b], ?_⟩
    rw [Matrix.range_cons_cons_empty]
    exact hspan

  have hnp : ∀ a b : Y.presheaf.stalk (r y'),
      IsLocalRing.maximalIdeal (Y.presheaf.stalk (r y')) = Ideal.span {a, b} →
      b ∉ Ideal.span {a} := by
    intro a b hm hb
    have h1 : IsLocalRing.maximalIdeal (Y.presheaf.stalk (r y')) = Ideal.span {a} := by
      rw [hm]
      apply le_antisymm
      · rw [Ideal.span_le]
        intro x hx
        rcases hx with rfl | rfl
        · exact Ideal.subset_span rfl
        · exact hb
      · exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))
    have h2 := Submodule.spanFinrank_span_le_ncard_of_finite (R := Y.presheaf.stalk (r y'))
      (Set.finite_singleton a)
    rw [Set.ncard_singleton] at h2
    have h3 : Submodule.spanFinrank (IsLocalRing.maximalIdeal (Y.presheaf.stalk (r y'))) ≤ 1 := by
      rw [h1]; exact h2
    omega


  obtain ⟨gh, hgh⟩ := hs3
  obtain ⟨U, hp, g, hgg, hIU⟩ :=
    wc_beq_point_generators Y inferInstance (r y') ⟨{r y'}, hy⟩ rfl 2 gh hgh
  have hinjS : Function.Injective (r.stalkMap y').hom := by
    rw [injective_iff_map_eq_zero]
    intro s hs
    obtain ⟨a0, w0, hw0, haw⟩ := hfrac Y U.1 U.2 (r y') hp s
    have h1 : (r.stalkMap y').hom ((Y.presheaf.germ U.1 (r y') hp).hom a0) = 0 := by
      rw [← haw, map_mul, hs, zero_mul]
    have h2 : (Y'.presheaf.germ (r ⁻¹ᵁ U.1) y' hp).hom
        ((r.appLE U.1 (r ⁻¹ᵁ U.1) le_rfl).hom a0) = 0 := by
      exact (hgerm Y' Y r U.1 (r ⁻¹ᵁ U.1) le_rfl y' hp hp a0).trans h1
    have h3 : (r.appLE U.1 (r ⁻¹ᵁ U.1) le_rfl).hom a0 = 0 :=
      germ_injective_of_isIntegral Y' y' hp (h2.trans (map_zero _).symm)
    have h4 : a0 = 0 := wcpa_dj_sgs_appLE_injective Y' Y r hgen U.1 (r ⁻¹ᵁ U.1) le_rfl
      ⟨y', hp⟩ (h3.trans (map_zero _).symm)
    rw [h4, map_zero] at haw
    exact hw0.mul_left_eq_zero.mp haw


  set I := Scheme.IdealSheafData.vanishingIdeal (⟨{r y'}, hy⟩ : TopologicalSpace.Closeds Y) with hI
  haveI hUa : IsAffine U.1.toScheme := U.2
  have e0 : (⊤ : U.1.toScheme.Opens) ≤ U.1.ι ⁻¹ᵁ U.1 := (Scheme.Opens.ι_preimage_self U.1).ge
  have e0id : ∀ (h : (⊤ : U.1.toScheme.Opens) ≤ ⊤),
      U.1.toScheme.presheaf.map (homOfLE h).op = 𝟙 _ := fun h => by
    rw [show (homOfLE h).op = 𝟙 (Opposite.op (⊤ : U.1.toScheme.Opens)) from rfl,
      U.1.toScheme.presheaf.map_id]
  have hcomap : I.comap U.1.ι = Scheme.IdealSheafData.ofIdealTop
      (Ideal.span (Set.range (fun j => (U.1.ι.appLE U.1 ⊤ e0).hom (g j)))) := by
    apply (EquivLike.injective (Scheme.IdealSheafData.equivOfIsAffine (X := U.1.toScheme)))
    simp only [Scheme.IdealSheafData.equivOfIsAffine_apply]
    rw [Scheme.IdealSheafData.ofIdealTop_ideal, e0id, CommRingCat.hom_id, Ideal.map_id,
      wc_csd_comap_ideal_affine U.1.toScheme Y I U.1.ι U ⟨⊤, isAffineOpen_top _⟩ e0, hIU,
      Ideal.map_span, ← Set.range_comp]
    rfl
  have hbl0 : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop
      (Ideal.span (Set.range (fun j => (U.1.ι.appLE U.1 ⊤ e0).hom (g j))))) (r ∣_ U.1) := by
    rw [← hcomap]
    exact hs7 Y Y' I r U.1 hbl
  obtain ⟨U', t', hC⟩ := wc_bp_blowup_charts _ (r ∣_ U.1) hbl0
  obtain ⟨hcov, haff, h3, h4, h5, -⟩ := hC
  have h3' : ∀ l j, ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ _)).hom ((U.1.ι.appLE U.1 ⊤ e0).hom (g j)) =
      t' l j * ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ _)).hom ((U.1.ι.appLE U.1 ⊤ e0).hom (g l)) := h3
  have h4' : ∀ l, ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ _)).hom ((U.1.ι.appLE U.1 ⊤ e0).hom (g l)) ∈
      nonZeroDivisors Γ((r ⁻¹ᵁ U.1).toScheme, U' l) := h4
  have h5' : ∀ l (s : Γ((r ⁻¹ᵁ U.1).toScheme, U' l)), s ∈ Subring.closure
      (Set.range ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ _)).hom ∪ Set.range (t' l)) := h5


  obtain ⟨W, hWaff, e, u, v, t, hy'W, hor, hrel, hgenW⟩ : ∃ (W : Y'.Opens) (_ : IsAffineOpen W)
      (e : W ≤ r ⁻¹ᵁ U.1) (u v : Γ(Y, U.1)) (t : Γ(Y', W)), y' ∈ W ∧
      ((u = g 0 ∧ v = g 1) ∨ (u = g 1 ∧ v = g 0)) ∧
      (r.appLE U.1 W e).hom v = (r.appLE U.1 W e).hom u * t ∧
      ∀ x : Γ(Y', W), x ∈ Subring.closure (Set.range (r.appLE U.1 W e).hom ∪ {t}) := by
    have hy'U : y' ∈ r ⁻¹ᵁ U.1 := hp
    let pt : (r ⁻¹ᵁ U.1).toScheme := ⟨y', hy'U⟩
    have hpt : pt ∈ ⨆ l, U' l := by rw [hcov]; trivial
    obtain ⟨l, hl⟩ := TopologicalSpace.Opens.mem_iSup.mp hpt
    have hWaff : IsAffineOpen ((r ⁻¹ᵁ U.1).ι ''ᵁ U' l) :=
      (haff l).image_of_isOpenImmersion (r ⁻¹ᵁ U.1).ι
    have hy'W : y' ∈ (r ⁻¹ᵁ U.1).ι ''ᵁ U' l := ⟨pt, hl, rfl⟩
    have e : (r ⁻¹ᵁ U.1).ι ''ᵁ U' l ≤ r ⁻¹ᵁ U.1 :=
      (Scheme.Hom.image_le_opensRange _ _).trans (Scheme.Opens.opensRange_ι _).le
    have e' : U' l ≤ (r ⁻¹ᵁ U.1).ι ⁻¹ᵁ ((r ⁻¹ᵁ U.1).ι ''ᵁ U' l) :=
      (Scheme.Hom.preimage_image_eq _ _).ge
    have hθ := hbij _ _ (r ⁻¹ᵁ U.1).ι _ _ e' rfl
    have hκ := (hbij _ _ U.1.ι U.1 ⊤ e0 (Scheme.Opens.ι_image_top U.1)).2

    have key : ∀ (h h' : (r ⁻¹ᵁ U.1).toScheme ⟶ Y) (hh : h = h') e1 e2 x,
        (h.appLE U.1 (U' l) e1).hom x = (h'.appLE U.1 (U' l) e2).hom x := by
      rintro h _ rfl e1 e2 x; rfl
    have hcompat : ∀ x, ((r ⁻¹ᵁ U.1).ι.appLE _ (U' l) e').hom ((r.appLE U.1 _ e).hom x) =
        ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ _)).hom ((U.1.ι.appLE U.1 ⊤ e0).hom x) := by
      intro x
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
        Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE]
      exact key _ _ (morphismRestrict_ι r U.1).symm _ _ x
    set θ := ((r ⁻¹ᵁ U.1).ι.appLE _ (U' l) e').hom with hθdef
    set ρ := (r.appLE U.1 _ e).hom with hρdef
    set ψ := ((r ∣_ U.1).appLE ⊤ (U' l) (htop _ _)).hom with hψdef
    set κ := (U.1.ι.appLE U.1 ⊤ e0).hom with hκdef

    have hτ : t' l l = 1 := by
      have h0 : (t' l l - 1) * ψ (κ (g l)) = 0 := by
        linear_combination -(h3' l l)
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff (h4' l)).mp h0)
    obtain ⟨t, ht⟩ := hθ.2 (t' l (l + 1))
    refine ⟨_, hWaff, e, g l, g (l + 1), t, hy'W, ?_, ?_, ?_⟩
    · fin_cases l
      · exact Or.inl ⟨rfl, rfl⟩
      · exact Or.inr ⟨rfl, rfl⟩
    · apply hθ.1
      rw [map_mul, hcompat, hcompat, ht, h3' l (l + 1), mul_comm]
    · intro x
      have hS : Subring.closure (Set.range ψ ∪ Set.range (t' l)) ≤
          (Subring.closure (Set.range ρ ∪ {t})).map θ := by
        rw [Subring.closure_le]
        rintro _ (⟨a, rfl⟩ | ⟨j, rfl⟩)
        · obtain ⟨a0, rfl⟩ := hκ a
          exact ⟨ρ a0, Subring.subset_closure (Or.inl ⟨a0, rfl⟩), hcompat a0⟩
        · have hj : ∀ j l : Fin 2, j = l ∨ j = l + 1 := by decide
          rcases hj j l with rfl | rfl
          · rw [hτ]; exact Subring.one_mem _
          · exact ⟨t, Subring.subset_closure (Or.inr rfl), ht⟩
      obtain ⟨z, hz, hzx⟩ := hS (h5' l (θ x))
      rw [← hθ.1 hzx]
      exact hz


  set α := (Y.presheaf.germ U.1 (r y') hp).hom with hα
  set γ := (Y'.presheaf.germ W y' hy'W).hom with hγ
  set ρ := (r.appLE U.1 W e).hom with hρ
  set φ := (r.stalkMap y').hom with hφ
  have hcomp : ∀ x, φ (α x) = γ (ρ x) := fun x => (hgerm Y' Y r U.1 W e y' hy'W hp x).symm
  have hfg : φ.comp α = γ.comp ρ := RingHom.ext hcomp
  have hpoly : ∀ x : Γ(Y', W), ∃ p : Polynomial Γ(Y, U.1), x = p.eval₂ ρ t := by
    intro x
    have hle : Subring.closure (Set.range ρ ∪ {t}) ≤ (Polynomial.eval₂RingHom ρ t).range := by
      rw [Subring.closure_le]
      rintro _ (⟨a, rfl⟩ | h)
      · exact ⟨Polynomial.C a, by simp⟩
      · rw [Set.mem_singleton_iff] at h
        subst h
        exact ⟨Polynomial.X, by simp⟩
    obtain ⟨p, hp'⟩ := RingHom.mem_range.mp (hle (hgenW x))
    exact ⟨p, by rw [← hp', Polynomial.coe_eval₂RingHom]⟩
  have hpush : ∀ p : Polynomial Γ(Y, U.1), (p.map α).eval₂ φ (γ t) = γ (p.eval₂ ρ t) := by
    intro p
    rw [Polynomial.eval₂_map, Polynomial.hom_eval₂, hfg]
  have hm : IsLocalRing.maximalIdeal (Y.presheaf.stalk (r y')) = Ideal.span {α u, α v} := by
    have hrange : Set.range gh = {gh 0, gh 1} := by
      ext x
      simp only [Set.mem_range, Fin.exists_fin_two, Set.mem_insert_iff, Set.mem_singleton_iff]
      exact ⟨fun h => h.imp Eq.symm Eq.symm, fun h => h.imp Eq.symm Eq.symm⟩
    rw [← hgh, hrange]
    rcases hor with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · rw [hgg, hgg]
    · rw [hgg, hgg, Set.pair_comm]
  refine ⟨α u, α v, γ t, hm, hnp _ _ hm, hnp _ _ (hm.trans (by rw [Set.pair_comm])), ?_, hinjS, ?_⟩
  · rw [hcomp, hcomp, hrel, map_mul]
  · intro s
    obtain ⟨x, w, hw, hsw⟩ := hfrac Y' W hWaff y' hy'W s
    obtain ⟨px, rfl⟩ := hpoly x
    obtain ⟨pw, rfl⟩ := hpoly w
    refine ⟨px.map α, pw.map α, ?_, ?_⟩
    · rw [hpush]
      exact IsLocalRing.notMem_maximalIdeal.mpr hw
    · rw [hpush, hpush]
      exact hsw

theorem fexr_lam_drop_at_chart : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsRegularLocalRing R], ringKrullDim R = 2 → ∀ (a b : R), IsLocalRing.maximalIdeal R = Ideal.span {a, b} → b ∉ Ideal.span {a} → a ∉ Ideal.span {b} → ∀ (S : Type u) [CommRing S] [IsLocalRing S] [IsDomain S] (φ : R →+* S) (c : S), Function.Injective φ → φ b = φ a * c → (∀ s : S, ∃ p q : Polynomial R, q.eval₂ φ c ∉ IsLocalRing.maximalIdeal S ∧ s * q.eval₂ φ c = p.eval₂ φ c) → ∀ J : Ideal R, fexrLam R J ≠ ⊤ → fexrLam S (Ideal.map φ J) < fexrLam R J ∨ fexrLam S (Ideal.map φ J) = 0 :=
by
  intro R _ _ _ hdim a b hm hba hab S _ _ _ φ c hinj hc hsurj J hJ
  classical
  haveI hRloc : IsLocalRing R := inferInstance
  haveI hRnoeth : IsNoetherianRing R := inferInstance
  have ha𝔪 : a ∈ IsLocalRing.maximalIdeal R := by
    rw [hm]; exact Ideal.subset_span (Set.mem_insert _ _)
  have hb𝔪 : b ∈ IsLocalRing.maximalIdeal R := by
    rw [hm]; exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))

  have s1 : ∀ (I : Ideal R), Module.length R (R ⧸ I) ≠ ⊤ →
      ∃ N : ℕ, IsLocalRing.maximalIdeal R ^ N ≤ I := by
    intro I h
    have hfl := Module.length_ne_top_iff.mp h
    have hA : IsArtinian R (R ⧸ I) := (isFiniteLength_iff_isNoetherian_isArtinian.mp hfl).2
    let f : ℕ →o (Submodule R (R ⧸ I))ᵒᵈ :=
      ⟨fun k => OrderDual.toDual (Submodule.map I.mkQ (IsLocalRing.maximalIdeal R ^ k)),
        fun i j hij => OrderDual.toDual_le_toDual.mpr
          (Submodule.map_mono (Ideal.pow_le_pow_right hij))⟩
    obtain ⟨n, hn⟩ := IsArtinian.monotone_stabilizes f
    have e := hn (n + 1) (Nat.le_succ n)
    have e2 : I ⊔ IsLocalRing.maximalIdeal R ^ n = I ⊔ IsLocalRing.maximalIdeal R ^ (n + 1) := by
      have e' : Submodule.map I.mkQ (IsLocalRing.maximalIdeal R ^ n) =
          Submodule.map I.mkQ (IsLocalRing.maximalIdeal R ^ (n + 1)) := e
      have := congrArg (Submodule.comap I.mkQ) e'
      rwa [Submodule.comap_map_mkQ, Submodule.comap_map_mkQ] at this
    refine ⟨n, ?_⟩
    apply Submodule.le_of_le_smul_of_le_jacobson_bot (I := IsLocalRing.maximalIdeal R)
      (_root_.IsNoetherian.noetherian _)
    · rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
    · calc IsLocalRing.maximalIdeal R ^ n ≤ I ⊔ IsLocalRing.maximalIdeal R ^ n := le_sup_right
        _ = I ⊔ IsLocalRing.maximalIdeal R ^ (n + 1) := e2
        _ = I ⊔ IsLocalRing.maximalIdeal R • IsLocalRing.maximalIdeal R ^ n := by
          rw [pow_succ', smul_eq_mul]

  have s2 : ∀ (I : Ideal R), I ≠ ⊥ → I ≠ ⊤ →
      ∃ d : ℕ, 1 ≤ d ∧ I ≤ IsLocalRing.maximalIdeal R ^ d ∧
        ¬ I ≤ IsLocalRing.maximalIdeal R ^ (d + 1) := by
    intro I h0 h1
    have hk : ∃ k, ¬ I ≤ IsLocalRing.maximalIdeal R ^ k := by
      by_contra hcon
      push_neg at hcon
      apply h0
      rw [eq_bot_iff, ← Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
        (IsLocalRing.maximalIdeal.isMaximal R).ne_top]
      exact le_iInf hcon
    obtain ⟨k, hk⟩ := hk
    have hI1 : I ≤ IsLocalRing.maximalIdeal R ^ 1 := by
      rw [pow_one]; exact IsLocalRing.le_maximalIdeal h1
    have hk1 : 1 ≤ k := by
      rcases Nat.eq_zero_or_pos k with h | h
      · subst h; simp at hk
      · exact h
    refine ⟨Nat.findGreatest (fun j => I ≤ IsLocalRing.maximalIdeal R ^ j) k,
      Nat.le_findGreatest hk1 hI1,
      Nat.findGreatest_spec (P := fun j => I ≤ IsLocalRing.maximalIdeal R ^ j) hk1 hI1, ?_⟩
    intro hcon
    by_cases hle : Nat.findGreatest (fun j => I ≤ IsLocalRing.maximalIdeal R ^ j) k + 1 ≤ k
    · exact Nat.findGreatest_is_greatest (Nat.lt_succ_self _) hle hcon
    · have := Nat.findGreatest_le (P := fun j => I ≤ IsLocalRing.maximalIdeal R ^ j) k
      have heq : Nat.findGreatest (fun j => I ≤ IsLocalRing.maximalIdeal R ^ j) k = k := by omega
      exact hk (heq ▸ Nat.findGreatest_spec (P := fun j => I ≤ IsLocalRing.maximalIdeal R ^ j)
        hk1 hI1)

  have s3 : ∀ (d : ℕ) (F : Polynomial R), F.natDegree ≤ d →
      Polynomial.C a ^ d * F -
        Polynomial.C (∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i)
        ∈ Ideal.span {Polynomial.C a * Polynomial.X - Polynomial.C b} := by
    intro d F hF
    have e1 : Polynomial.C a ^ d * F = ∑ i ∈ Finset.range (d + 1),
        Polynomial.C a ^ d * (Polynomial.C (F.coeff i) * Polynomial.X ^ i) := by
      conv_lhs => rw [F.as_sum_range' (d + 1) (by omega)]
      rw [Finset.mul_sum]
      simp only [Polynomial.C_mul_X_pow_eq_monomial]
    rw [e1, map_sum, ← Finset.sum_sub_distrib]
    refine Ideal.sum_mem _ (fun i hi => ?_)
    have hi' : i ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    obtain ⟨j, rfl⟩ : ∃ j, d = j + i := ⟨d - i, by omega⟩
    have hj : j + i - i = j := by omega
    rw [hj]
    have : Polynomial.C a ^ (j + i) * (Polynomial.C (F.coeff i) * Polynomial.X ^ i) -
        Polynomial.C (F.coeff i * a ^ j * b ^ i) =
        Polynomial.C (F.coeff i) * Polynomial.C a ^ j *
          ((Polynomial.C a * Polynomial.X) ^ i - (Polynomial.C b) ^ i) := by
      simp only [map_mul, map_pow]; ring
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton.mpr (sub_dvd_pow_sub_pow _ _ _))

  have s4 : ∀ (d : ℕ), ∀ x ∈ Ideal.span {a, b} ^ d, ∃ F : Polynomial R, F.natDegree ≤ d ∧
      x = ∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i := by
    intro d
    induction d with
    | zero => intro x _; exact ⟨Polynomial.C x, by simp, by simp⟩
    | succ d ih =>
      intro x hx
      rw [pow_succ] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro y hy z hz
        obtain ⟨F, hF, rfl⟩ := ih y hy
        obtain ⟨r, s, rfl⟩ := Ideal.mem_span_pair.mp hz
        refine ⟨Polynomial.C r * F + Polynomial.C s * (Polynomial.X * F), ?_, ?_⟩
        · have h1 : (Polynomial.X * F).natDegree ≤ d + 1 :=
            (Polynomial.natDegree_mul_le).trans (by
              have := Polynomial.natDegree_X_le (R := R); omega)
          exact (Polynomial.natDegree_add_le _ _).trans (max_le
            ((Polynomial.natDegree_C_mul_le _ _).trans (by omega))
            ((Polynomial.natDegree_C_mul_le _ _).trans h1))
        · rw [mul_add, Finset.sum_mul, Finset.sum_mul]
          simp only [Polynomial.coeff_add, Polynomial.coeff_C_mul, add_mul, Finset.sum_add_distrib]
          congr 1
          · symm
            rw [Finset.sum_range_succ _ (d + 1),
              Polynomial.coeff_eq_zero_of_natDegree_lt (by omega : F.natDegree < d + 1)]
            simp only [mul_zero, zero_mul, add_zero]
            refine Finset.sum_congr rfl (fun i hi => ?_)
            have hi' : i ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
            rw [show d + 1 - i = d - i + 1 by omega, pow_succ]; ring
          · symm
            rw [Finset.sum_range_succ' _ (d + 1)]
            simp only [Polynomial.coeff_X_mul_zero, mul_zero, zero_mul, add_zero,
              Polynomial.coeff_X_mul]
            refine Finset.sum_congr rfl (fun i hi => ?_)
            rw [show d + 1 - (i + 1) = d - i by omega, pow_succ]; ring
      · rintro x y ⟨F, hF, rfl⟩ ⟨G, hG, rfl⟩
        exact ⟨F + G, (Polynomial.natDegree_add_le _ _).trans (max_le hF hG),
          by simp [add_mul, Finset.sum_add_distrib]⟩

  have s5 : ∀ (d : ℕ) (F : Polynomial R), (∀ i ≤ d, F.coeff i ∈ IsLocalRing.maximalIdeal R) →
      ∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i ∈
        IsLocalRing.maximalIdeal R ^ (d + 1) := by
    intro d F hF
    refine Ideal.sum_mem _ (fun i hi => ?_)
    have hi' : i ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    have : IsLocalRing.maximalIdeal R ^ (d + 1) = IsLocalRing.maximalIdeal R *
        IsLocalRing.maximalIdeal R ^ (d - i) * IsLocalRing.maximalIdeal R ^ i := by
      rw [← pow_succ', ← pow_add]; congr 1; omega
    rw [this]
    exact Ideal.mul_mem_mul (Ideal.mul_mem_mul (hF i hi') (Ideal.pow_mem_pow ha𝔪 _))
      (Ideal.pow_mem_pow hb𝔪 _)

  have s6 : ∀ (K : Ideal (Polynomial R)) (d n : ℕ) (G : Polynomial R), G ∈ K →
      G.natDegree ≤ d → (∃ i ≤ d, G.coeff i ∉ IsLocalRing.maximalIdeal R) →
      IsLocalRing.maximalIdeal R ^ n ≤ Ideal.comap Polynomial.C K →
      ∀ p : Polynomial R, ∃ F : Polynomial R, F.natDegree ≤ d ∧ p - F ∈ K := by
    intro K d n G hGK hGd hGu hn
    set 𝔪 := IsLocalRing.maximalIdeal R with h𝔪
    obtain ⟨i₀, hi₀, hu₀⟩ := hGu
    set e := Nat.findGreatest (fun i => G.coeff i ∉ 𝔪) d with he
    have hed : e ≤ d := Nat.findGreatest_le d
    have hue : G.coeff e ∉ 𝔪 := Nat.findGreatest_spec (P := fun i => G.coeff i ∉ 𝔪) hi₀ hu₀
    have hgt : ∀ k, e < k → G.coeff k ∈ 𝔪 := by
      intro k hk
      by_cases hkd : k ≤ d
      · by_contra h
        exact Nat.findGreatest_is_greatest (P := fun i => G.coeff i ∉ 𝔪) hk hkd h
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]; exact zero_mem _
    obtain ⟨v, hv⟩ : ∃ v, v * G.coeff e = 1 :=
      (IsLocalRing.notMem_maximalIdeal.mp hue).exists_left_inv
    set T : Polynomial R :=
      ∑ i ∈ Finset.range e, Polynomial.C (v * G.coeff i) * Polynomial.X ^ i with hT
    have hTdeg : T.degree < e := by
      have : T ∈ Polynomial.degreeLT R e := by
        refine Submodule.sum_mem _ (fun i hi => ?_)
        rw [Polynomial.mem_degreeLT]
        refine lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le _ _) ?_
        exact_mod_cast Finset.mem_range.mp hi
      exact Polynomial.mem_degreeLT.mp this
    set H := Polynomial.X ^ e + T with hH
    have hHm : H.Monic := Polynomial.monic_X_pow_add hTdeg
    have hHdeg : H.natDegree ≤ e :=
      (Polynomial.natDegree_add_le _ _).trans (max_le (Polynomial.natDegree_X_pow_le _)
        (Polynomial.natDegree_le_of_degree_le hTdeg.le))
    have hTcoeff : ∀ k, T.coeff k = if k < e then v * G.coeff k else 0 := by
      intro k
      simp only [hT, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_ite_eq]
      simp [Finset.mem_range]
    have hE : Polynomial.C v * G - H ∈ Ideal.map Polynomial.C 𝔪 := by
      rw [Ideal.mem_map_C_iff]
      intro k
      simp only [hH, Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_add,
        Polynomial.coeff_X_pow, hTcoeff]
      rcases lt_trichotomy k e with h | h | h
      · simp [h, h.ne]
      · subst h; simp [hv]
      · have h1 : ¬ k < e := by omega
        simp only [h1, h.ne', if_false, add_zero, sub_zero]
        exact Ideal.mul_mem_left _ _ (hgt k h)
    let Kr : Submodule R (Polynomial R) := K.restrictScalars R
    let N : Submodule R (Polynomial R) := Polynomial.degreeLE R d ⊔ Kr
    have hmapC : ∀ f ∈ Ideal.map Polynomial.C 𝔪,
        f ∈ 𝔪 • (⊤ : Submodule R (Polynomial R)) := by
      intro f hf
      rw [Ideal.mem_map_C_iff] at hf
      rw [f.as_sum_range_C_mul_X_pow]
      refine Submodule.sum_mem _ (fun i _ => ?_)
      rw [← Polynomial.smul_eq_C_mul]
      exact Submodule.smul_mem_smul (hf i) Submodule.mem_top
    have hstep1 : (⊤ : Submodule R (Polynomial R)) ≤ N ⊔ 𝔪 • ⊤ := by
      intro p _
      have hdecomp : p = p %ₘ H + (Polynomial.C v * G * (p /ₘ H) -
          (Polynomial.C v * G - H) * (p /ₘ H)) := by
        conv_lhs => rw [← Polynomial.modByMonic_add_div p H]
        ring
      rw [hdecomp]
      refine Submodule.add_mem _ ?_ (Submodule.sub_mem _ ?_ ?_)
      · apply Submodule.mem_sup_left; apply Submodule.mem_sup_left
        rw [Polynomial.mem_degreeLE]
        refine (Polynomial.degree_le_natDegree).trans ?_
        exact_mod_cast (Polynomial.natDegree_modByMonic_le p hHm).trans (hHdeg.trans hed)
      · apply Submodule.mem_sup_left; apply Submodule.mem_sup_right
        show _ ∈ K
        exact K.mul_mem_right _ (K.mul_mem_left _ hGK)
      · apply Submodule.mem_sup_right
        exact hmapC _ (Ideal.mul_mem_right _ _ hE)
    have hind : ∀ k : ℕ, (⊤ : Submodule R (Polynomial R)) ≤ N ⊔ 𝔪 ^ k • ⊤ := by
      intro k
      induction k with
      | zero => rw [pow_zero, Ideal.one_eq_top, Submodule.top_smul]; exact le_sup_right
      | succ k ih =>
        calc (⊤ : Submodule R (Polynomial R)) ≤ N ⊔ 𝔪 ^ k • ⊤ := ih
          _ ≤ N ⊔ 𝔪 ^ k • (N ⊔ 𝔪 • ⊤) :=
            sup_le_sup_left (Submodule.smul_mono le_rfl hstep1) _
          _ = N ⊔ (𝔪 ^ k • N ⊔ 𝔪 ^ (k + 1) • ⊤) := by
            rw [Submodule.smul_sup, pow_succ, Submodule.mul_smul]
          _ ≤ N ⊔ 𝔪 ^ (k + 1) • ⊤ := by
            rw [← sup_assoc]; exact sup_le_sup_right (sup_le le_rfl Submodule.smul_le_right) _
    have hnil : 𝔪 ^ n • (⊤ : Submodule R (Polynomial R)) ≤ Kr := by
      rw [Submodule.smul_le]
      intro r hr q _
      show r • q ∈ K
      rw [Polynomial.smul_eq_C_mul]
      exact K.mul_mem_right _ (hn hr)
    intro p
    have hp : p ∈ N := by
      have h1 := hind n (Submodule.mem_top (x := p))
      have h2 : N ⊔ 𝔪 ^ n • ⊤ ≤ N := sup_le le_rfl (hnil.trans le_sup_right)
      exact h2 h1
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hp
    refine ⟨y, ?_, ?_⟩
    · rw [Polynomial.mem_degreeLE] at hy; exact Polynomial.natDegree_le_of_degree_le hy
    · have : y + z - y = z := by ring
      rw [this]; exact hz

  have s7 : ∀ (d : ℕ) (I : Ideal R) (K : Ideal (Polynomial R)), 1 ≤ d → I ≠ ⊤ →
      Module.length R (R ⧸ I) ≠ ⊤ →
      (∀ p : Polynomial R, ∃ F : Polynomial R, F.natDegree ≤ d ∧ p - F ∈ K) →
      (∀ F : Polynomial R, F.natDegree ≤ d →
        ∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i ∈ I → F ∈ K) →
      Module.length R (Polynomial R ⧸ K) < Module.length R (R ⧸ I) := by
    intro d I K hd hI hlen hA hB
    have hfl := Module.length_ne_top_iff.mp hlen
    haveI : IsArtinian R (R ⧸ I) := (isFiniteLength_iff_isNoetherian_isArtinian.mp hfl).2
    haveI : _root_.IsNoetherian R (R ⧸ I) := (isFiniteLength_iff_isNoetherian_isArtinian.mp hfl).1
    set D := Polynomial.degreeLE R d
    let θL : D →ₗ[R] R :=
      { toFun := fun F =>
          ∑ i ∈ Finset.range (d + 1), (F : Polynomial R).coeff i * a ^ (d - i) * b ^ i
        map_add' := fun F G => by
          simp only [Submodule.coe_add, Polynomial.coeff_add, add_mul, Finset.sum_add_distrib]
        map_smul' := fun r F => by
          simp only [Submodule.coe_smul, Polynomial.coeff_smul, smul_eq_mul, RingHom.id_apply,
            Finset.mul_sum, mul_assoc] }
    have hθL : ∀ F : D, θL F =
        ∑ i ∈ Finset.range (d + 1), (F : Polynomial R).coeff i * a ^ (d - i) * b ^ i :=
      fun F => rfl
    let θb : D →ₗ[R] R ⧸ I := I.mkQ ∘ₗ θL
    let π : D →ₗ[R] Polynomial R ⧸ K := (Ideal.Quotient.mkₐ R K).toLinearMap ∘ₗ D.subtype
    have hπ : Function.Surjective π := by
      intro x
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨F, hF, hpF⟩ := hA p
      have hFD : F ∈ D := by
        rw [Polynomial.mem_degreeLE]
        exact (Polynomial.degree_le_natDegree).trans (by exact_mod_cast hF)
      refine ⟨⟨F, hFD⟩, ?_⟩
      show Ideal.Quotient.mk K F = Ideal.Quotient.mk K p
      rw [Ideal.Quotient.eq]
      rw [← neg_sub]; exact K.neg_mem hpF
    have hker : LinearMap.ker θb ≤ LinearMap.ker π := by
      intro F hF
      rw [LinearMap.mem_ker] at hF ⊢
      have h1 : θL F ∈ I := by
        have h0 : Ideal.Quotient.mk I (θL F) = 0 := hF
        exact Ideal.Quotient.eq_zero_iff_mem.mp h0
      rw [hθL] at h1
      have hFd : (F : Polynomial R).natDegree ≤ d := by
        have := F.2
        rw [Polynomial.mem_degreeLE] at this
        exact Polynomial.natDegree_le_of_degree_le this
      have h2 := hB F hFd h1
      show Ideal.Quotient.mk K (F : Polynomial R) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr h2
    let π' := (LinearMap.ker θb).liftQ π hker
    have hπ' : Function.Surjective π' := by
      intro x
      obtain ⟨F, rfl⟩ := hπ x
      exact ⟨Submodule.Quotient.mk F, rfl⟩
    have h1 : Module.length R (Polynomial R ⧸ K) ≤ Module.length R (D ⧸ LinearMap.ker θb) :=
      Module.length_le_of_surjective π' hπ'
    have h2 : Module.length R (D ⧸ LinearMap.ker θb) = Module.length R (LinearMap.range θb) :=
      (θb.quotKerEquivRange).length_eq
    have hne : LinearMap.range θb ≠ ⊤ := by
      intro htop
      have h1mem : (Ideal.Quotient.mk I 1 : R ⧸ I) ∈ LinearMap.range θb :=
        htop ▸ Submodule.mem_top
      obtain ⟨F, hF⟩ := h1mem
      have hF' : Ideal.Quotient.mk I (θL F) = Ideal.Quotient.mk I 1 := hF
      rw [Ideal.Quotient.eq] at hF'
      have hθ𝔪 : θL F ∈ IsLocalRing.maximalIdeal R := by
        rw [hθL]
        refine Ideal.sum_mem _ (fun i hi => ?_)
        have hi' : i ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rcases Nat.lt_or_ge i d with h | h
        · rw [mul_comm _ (b ^ i), ← mul_assoc]
          exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ ha𝔪 _ (by omega))
        · exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hb𝔪 _ (by omega))
      have : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
        have h3 := IsLocalRing.le_maximalIdeal hI hF'
        have h4 := Ideal.sub_mem _ hθ𝔪 h3
        simpa using h4
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
        ((Ideal.eq_top_iff_one _).mpr this)
    have h3 := Submodule.length_lt hne
    calc Module.length R (Polynomial R ⧸ K) ≤ _ := h1
      _ = _ := h2
      _ < _ := h3

  have s8 : ∀ (d : ℕ) (I : Ideal R) (K : Ideal (Polynomial R)),
      (∀ p : Polynomial R, p ∈ K ↔ Polynomial.C a ^ d * p ∈ Ideal.map Polynomial.C I ⊔
        Ideal.span {Polynomial.C a * Polynomial.X - Polynomial.C b}) →
      (∀ x ∈ I, ∃ F : Polynomial R, F.natDegree ≤ d ∧
        x = ∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i) →
      (∀ F : Polynomial R, F.natDegree ≤ d → Polynomial.C a ^ d * F -
        Polynomial.C (∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i) ∈
          Ideal.span {Polynomial.C a * Polynomial.X - Polynomial.C b}) →
      Ideal.map φ I = Ideal.span {φ a ^ d} * Ideal.map (Polynomial.eval₂RingHom φ c) K := by
    intro d I K hK hrep hid
    set ev := Polynomial.eval₂RingHom φ c with hev
    have hevC : ∀ r, ev (Polynomial.C r) = φ r := fun r => Polynomial.eval₂_C _ _
    have hspan : ∀ z ∈ Ideal.span {Polynomial.C a * Polynomial.X - Polynomial.C b},
        ev z = 0 := by
      intro z hz
      obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      rw [map_mul, map_sub, map_mul, hevC, hevC]
      simp [ev, hc]
    have hkey : ∀ f ∈ Ideal.map Polynomial.C I ⊔
        Ideal.span {Polynomial.C a * Polynomial.X - Polynomial.C b}, ev f ∈ Ideal.map φ I := by
      intro f hf
      obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hf
      rw [map_add, hspan z hz, add_zero]
      have := Ideal.mem_map_of_mem ev hy
      rwa [Ideal.map_map, hev, Polynomial.eval₂RingHom_comp_C] at this
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      obtain ⟨F, hF, rfl⟩ := hrep x hx
      rw [Ideal.mem_comap]
      have hFK : F ∈ K := by
        rw [hK]
        have e : Polynomial.C a ^ d * F = (Polynomial.C a ^ d * F -
            Polynomial.C (∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i)) +
            Polynomial.C (∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i) := by
          ring
        rw [e]
        exact Submodule.add_mem _ (Submodule.mem_sup_right (hid F hF))
          (Submodule.mem_sup_left (Ideal.mem_map_of_mem _ hx))
      have h0 := hspan _ (hid F hF)
      rw [map_sub, hevC, map_mul, map_pow, hevC, sub_eq_zero] at h0
      rw [← h0]
      exact Ideal.mem_span_singleton_mul.mpr ⟨ev F, Ideal.mem_map_of_mem _ hFK, rfl⟩
    · rw [Ideal.mul_le]
      intro r hr s hs
      obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.mp hr
      have hsub : Ideal.map ev K ≤ (Ideal.map φ I).colon {φ a ^ d} := by
        rw [Ideal.map_le_iff_le_comap]
        intro p hp
        rw [Ideal.mem_comap, Submodule.mem_colon_singleton, smul_eq_mul]
        have := hkey _ ((hK p).mp hp)
        rwa [map_mul, map_pow, hevC, mul_comm] at this
      have h1 := hsub hs
      rw [Submodule.mem_colon_singleton, smul_eq_mul] at h1
      have : w * φ a ^ d * s = w * (s * φ a ^ d) := by ring
      rw [this]
      exact Ideal.mul_mem_left _ _ h1

  have s9 : ∀ (K : Ideal (Polynomial R)), Module.length R (Polynomial R ⧸ K) ≠ ⊤ →
      Module.length S (S ⧸ Ideal.map (Polynomial.eval₂RingHom φ c) K) ≤
        Module.length R (Polynomial R ⧸ K) := by
    intro K hK
    letI : Algebra R S := φ.toAlgebra
    set KS := Ideal.map (Polynomial.eval₂RingHom φ c) K with hKS
    have haeval : ∀ p : Polynomial R, Polynomial.aeval c p = p.eval₂ φ c := by
      intro p; rw [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra]
    let ψ : Polynomial R →ₐ[R] S ⧸ KS := (Ideal.Quotient.mkₐ R KS).comp (Polynomial.aeval c)
    have hψ : ∀ p, ψ p = Ideal.Quotient.mk KS (p.eval₂ φ c) := by
      intro p
      show Ideal.Quotient.mk KS (Polynomial.aeval c p) = _
      rw [haeval]
    have hψK : ∀ p ∈ K, ψ p = 0 := by
      intro p hp
      rw [hψ, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem (Polynomial.eval₂RingHom φ c) hp
    let ψb : (Polynomial R ⧸ K) →ₐ[R] S ⧸ KS := Ideal.Quotient.liftₐ K ψ hψK
    have hψb : ∀ p, ψb (Ideal.Quotient.mk K p) = Ideal.Quotient.mk KS (p.eval₂ φ c) := by
      intro p
      rw [← hψ]
      rfl
    have hfl := Module.length_ne_top_iff.mp hK
    haveI : IsArtinian R (Polynomial R ⧸ K) :=
      (isFiniteLength_iff_isNoetherian_isArtinian.mp hfl).2
    set B := LinearMap.range ψb.toLinearMap with hB
    haveI : IsArtinian R B := isArtinian_of_surjective _ ψb.toLinearMap.rangeRestrict
      (LinearMap.surjective_rangeRestrict _)
    have hsurjψ : Function.Surjective ψb := by
      intro t
      obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective t
      obtain ⟨p, q, hq, hspq⟩ := hsurj s
      set u : S ⧸ KS := Ideal.Quotient.mk KS (q.eval₂ φ c) with hu
      have hunit : IsUnit u := (IsLocalRing.notMem_maximalIdeal.mp hq).map _
      have hmulB : ∀ x ∈ B, u * x ∈ B := by
        rintro x ⟨y, rfl⟩
        refine ⟨Ideal.Quotient.mk K q * y, ?_⟩
        show ψb (Ideal.Quotient.mk K q * y) = u * ψb y
        rw [map_mul, hψb]
      let μ : B →ₗ[R] B := (LinearMap.mulLeft R u).restrict hmulB
      have hμinj : Function.Injective μ := by
        intro x y hxy
        apply Subtype.ext
        have : u * (x : S ⧸ KS) = u * (y : S ⧸ KS) := congrArg Subtype.val hxy
        exact hunit.mul_left_cancel this
      have hμsurj := IsArtinian.surjective_of_injective_endomorphism μ hμinj
      have hpB : ψb (Ideal.Quotient.mk K p) ∈ B := ⟨Ideal.Quotient.mk K p, rfl⟩
      obtain ⟨β, hβ⟩ := hμsurj ⟨_, hpB⟩
      have hβ' : u * (β : S ⧸ KS) = ψb (Ideal.Quotient.mk K p) := congrArg Subtype.val hβ
      have hs : u * Ideal.Quotient.mk KS s = ψb (Ideal.Quotient.mk K p) := by
        rw [hψb, hu, ← map_mul, mul_comm, hspq]
      have : Ideal.Quotient.mk KS s = (β : S ⧸ KS) :=
        hunit.mul_left_cancel (hs.trans hβ'.symm)
      obtain ⟨y, hy⟩ := β.2
      exact ⟨y, by rw [this]; exact hy⟩
    have hle1 : Module.length R (S ⧸ KS) ≤ Module.length R (Polynomial R ⧸ K) :=
      Module.length_le_of_surjective ψb.toLinearMap hsurjψ
    have hle2 : Module.length S (S ⧸ KS) ≤ Module.length R (S ⧸ KS) := by
      rw [Module.length_eq_height, Module.length_eq_height]
      have := Order.height_le_height_apply_of_strictMono
        (Submodule.restrictScalarsEmbedding R S (S ⧸ KS)) (OrderEmbedding.strictMono _) ⊤
      simpa [Submodule.restrictScalarsEmbedding, Submodule.restrictScalars_top] using this
    exact hle2.trans hle1

  have hmem : ∀ (T : Type u) [CommRing T] (K : Ideal T), ∃ (c : T) (J' : Ideal T),
      K = Ideal.span {c} * J' ∧ Module.length T (T ⧸ J') = fexrLam T K := by
    intro T _ K
    have hne : {n : ℕ∞ | ∃ (c : T) (J' : Ideal T), K = Ideal.span {c} * J' ∧
        Module.length T (T ⧸ J') = n}.Nonempty :=
      ⟨_, 1, K, by rw [Ideal.span_singleton_one, Ideal.top_mul], rfl⟩
    exact csInf_mem hne
  have hle : ∀ (T : Type u) [CommRing T] (K : Ideal T) (c : T) (J' : Ideal T),
      K = Ideal.span {c} * J' → fexrLam T K ≤ Module.length T (T ⧸ J') :=
    fun T _ K c J' h => sInf_le ⟨c, J', h, rfl⟩

  by_cases h0 : fexrLam R J = 0
  · right
    obtain ⟨t, J', hJfac, hl⟩ := hmem R J
    rw [h0, Module.length_eq_zero_iff, Ideal.Quotient.subsingleton_iff] at hl
    have h1 : Ideal.map φ J = Ideal.span {φ t} * ⊤ := by
      rw [hJfac, hl, Ideal.mul_top, Ideal.mul_top, Ideal.map_span, Set.image_singleton]
    have h2 := hle S _ _ _ h1
    rw [Module.length_eq_zero_iff.mpr (Ideal.Quotient.subsingleton_iff.mpr rfl)] at h2
    exact nonpos_iff_eq_zero.mp h2
  · left
    obtain ⟨t, J'', hJfac, hlenJ''⟩ := hmem R J
    have hlen_ne_top : Module.length R (R ⧸ J'') ≠ ⊤ := by rw [hlenJ'']; exact hJ
    have hJ''top : J'' ≠ ⊤ := by
      intro htop
      apply h0
      rw [← hlenJ'', htop]
      exact Module.length_eq_zero_iff.mpr inferInstance
    obtain ⟨N, hN⟩ := s1 J'' hlen_ne_top
    have hb0 : b ≠ 0 := fun h => hba (h ▸ zero_mem _)
    have hJ''bot : J'' ≠ ⊥ := by
      intro hbot
      have : b ^ N ∈ J'' := hN (Ideal.pow_mem_pow hb𝔪 N)
      rw [hbot, Ideal.mem_bot] at this
      exact pow_ne_zero N hb0 this
    obtain ⟨d, hd1, hdle, hdnot⟩ := s2 J'' hJ''bot hJ''top
    set K : Ideal (Polynomial R) := Submodule.colon (Ideal.map Polynomial.C J'' ⊔
      Ideal.span {Polynomial.C a * Polynomial.X - Polynomial.C b}) {Polynomial.C a ^ d} with hKdef
    have hK : ∀ p : Polynomial R, p ∈ K ↔ Polynomial.C a ^ d * p ∈ Ideal.map Polynomial.C J'' ⊔
        Ideal.span {Polynomial.C a * Polynomial.X - Polynomial.C b} := by
      intro p
      rw [hKdef, Submodule.mem_colon_singleton, smul_eq_mul, mul_comm p]
    have hB : ∀ F : Polynomial R, F.natDegree ≤ d →
        ∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i ∈ J'' → F ∈ K := by
      intro F hF hθ
      rw [hK]
      have e : Polynomial.C a ^ d * F = (Polynomial.C a ^ d * F -
          Polynomial.C (∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i)) +
          Polynomial.C (∑ i ∈ Finset.range (d + 1), F.coeff i * a ^ (d - i) * b ^ i) := by ring
      rw [e]
      exact Submodule.add_mem _ (Submodule.mem_sup_right (s3 d F hF))
        (Submodule.mem_sup_left (Ideal.mem_map_of_mem _ hθ))
    obtain ⟨g, hgJ, hg⟩ := SetLike.not_le_iff_exists.mp hdnot
    have hg𝔪d : g ∈ Ideal.span {a, b} ^ d := by rw [← hm]; exact hdle hgJ
    obtain ⟨G, hGd, hGθ⟩ := s4 d g hg𝔪d
    have hGu : ∃ i ≤ d, G.coeff i ∉ IsLocalRing.maximalIdeal R := by
      by_contra hcon
      push_neg at hcon
      exact hg (hGθ ▸ s5 d G hcon)
    have hGK : G ∈ K := hB G hGd (hGθ ▸ hgJ)
    have hnK : IsLocalRing.maximalIdeal R ^ N ≤ Ideal.comap Polynomial.C K := by
      intro r hr
      rw [Ideal.mem_comap, hK]
      apply Submodule.mem_sup_left
      rw [← map_pow, ← map_mul]
      exact Ideal.mem_map_of_mem _ (Ideal.mul_mem_left _ _ (hN hr))
    have hA := s6 K d N G hGK hGd hGu hnK
    have hlt := s7 d J'' K hd1 hJ''top hlen_ne_top hA hB
    have hPKtop : Module.length R (Polynomial R ⧸ K) ≠ ⊤ := ne_top_of_lt hlt
    have htr := s9 K hPKtop
    have hfac := s8 d J'' K hK (fun x hx => s4 d x (by rw [← hm]; exact hdle hx))
      (fun F hF => s3 d F hF)
    have hJS : Ideal.map φ J = Ideal.span {φ t * φ a ^ d} *
        Ideal.map (Polynomial.eval₂RingHom φ c) K := by
      rw [hJfac, Ideal.map_mul, Ideal.map_span, Set.image_singleton, hfac, ← mul_assoc,
        Ideal.span_singleton_mul_span_singleton]
    have hle' := hle S (Ideal.map φ J) _ _ hJS
    calc fexrLam S (Ideal.map φ J) ≤ _ := hle'
      _ ≤ _ := htr
      _ < _ := hlt
      _ = fexrLam R J := hlenJ''

theorem fexr_count_drop : ∀ {Y Y' : Type u} (m : ℕ) (r : Y' → Y) (y : Y) (L : Fin m → Y → ℕ) (L' : Fin m → Y' → ℕ) (M : ℕ), 0 < M → (∀ l z, L l z ≤ M) → (∃ l, L l y = M) → {p : Fin m × Y | L p.1 p.2 = M}.Finite → (∀ z, z ≠ y → ∃! z', r z' = z) → (∀ l z', r z' ≠ y → L' l z' = L l (r z')) → (∀ l z', r z' = y → L' l z' < L l y ∨ L' l z' = 0) → (∀ l z', L' l z' ≤ M) ∧ {p : Fin m × Y' | L' p.1 p.2 = M}.Finite ∧ {p : Fin m × Y' | L' p.1 p.2 = M}.ncard < {p : Fin m × Y | L p.1 p.2 = M}.ncard :=
by
  intro Y Y' m r y L L' M hM hle hex hfin huniq hoff hover
  obtain ⟨l0, hl0⟩ := hex
  have hA : ∀ l z', L' l z' ≤ M := by
    intro l z'
    by_cases hz : r z' = y
    · have h1 := hle l y
      rcases hover l z' hz with h | h <;> omega
    · rw [hoff l z' hz]; exact hle _ _
  have hkey : ∀ p ∈ {p : Fin m × Y' | L' p.1 p.2 = M}, r p.2 ≠ y := by
    rintro ⟨l, z'⟩ hp hz
    simp only [Set.mem_setOf_eq] at hp
    have h1 := hle l y
    rcases hover l z' hz with h | h <;> omega
  set S := {p : Fin m × Y | L p.1 p.2 = M} with hS
  set S' := {p : Fin m × Y' | L' p.1 p.2 = M} with hS'
  set T := S \ {((l0, y) : Fin m × Y)} with hT
  let f : Fin m × Y' → Fin m × Y := fun p => (p.1, r p.2)
  have hmaps : ∀ p ∈ S', f p ∈ T := by
    rintro ⟨l, z'⟩ hp
    have hz := hkey _ hp
    simp only [hS', Set.mem_setOf_eq] at hp
    simp only at hz
    refine ⟨?_, ?_⟩
    · show L l (r z') = M
      rw [← hoff l z' hz]; exact hp
    · intro h
      simp only [Set.mem_singleton_iff, Prod.mk.injEq, f] at h
      exact hz h.2
  have hinj : Set.InjOn f S' := by
    rintro ⟨l1, z1⟩ hp1 ⟨l2, z2⟩ hp2 h
    have hz := hkey _ hp1
    simp only at hz
    simp only [Prod.mk.injEq, f] at h
    obtain ⟨h1, h2⟩ := h
    have : z1 = z2 := (huniq (r z1) hz).unique rfl h2.symm
    rw [h1, this]
  have hTfin : T.Finite := hfin.diff
  have hS'fin : S'.Finite := Set.Finite.of_injOn hmaps hinj hTfin
  have hle1 : S'.ncard ≤ T.ncard := Set.ncard_le_ncard_of_injOn f hmaps hinj hTfin
  have hlt : T.ncard < S.ncard := Set.ncard_diff_singleton_lt_of_mem (show (l0, y) ∈ S from hl0) hfin
  exact ⟨hA, hS'fin, lt_of_le_of_lt hle1 hlt⟩

theorem fexr_tower_principalize : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B], IsRegularLocalRing B → ringKrullDim B = 2 → ∀ (m : ℕ) (J : Fin m → Ideal B), (∀ l, ∃ N : ℕ, IsLocalRing.maximalIdeal B ^ N ≤ J l) → ∃ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of B)), fexPtTower B Y g ∧ ∀ (y : Y) (l : Fin m), (Ideal.map (wcNdSig g y) (J l)).IsPrincipal :=
by
  intro B _ _ _ hreg hdim m J hJ
  classical

  have hfinF : ∀ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of B)), fexPtTower B Y g →
      {p : Fin m × Y | fexrLamAt J g p.1 p.2 ≠ 0}.Finite := by
    intro Y g hT
    obtain ⟨-, hnoeth, -, -, -, -, hregY, -, hdimY⟩ := fexr_tower_props B hreg hdim Y g hT
    haveI := hnoeth
    refine Set.Finite.subset (Set.finite_iUnion fun l : Fin m => (Set.finite_singleton l).prod
      (fexr_nonprincipal_locus_finite B Y g hregY hdimY (J l) (hJ l)).1) ?_
    rintro ⟨l, y⟩ hp
    exact Set.mem_iUnion.mpr ⟨l, Set.mem_singleton l,
      fun hprin => hp ((fexr_lam_basic _ _).1.2 hprin)⟩
  have hlt : ∀ a b : ℕ∞, a < b → b ≠ ⊤ → a ≠ ⊤ ∧ a.toNat < b.toNat := by
    intro a b hab hb
    have ha : a ≠ ⊤ := ne_top_of_lt hab
    refine ⟨ha, ?_⟩
    rw [← ENat.coe_toNat ha, ← ENat.coe_toNat hb] at hab
    exact_mod_cast hab

  have step : ∀ (M : ℕ) (Y : Scheme.{u}) (g : Y ⟶ Spec (.of B)), fexPtTower B Y g → 0 < M →
      (∀ l y, fexrLamAt J g l y ≠ ⊤) → (∀ l y, (fexrLamAt J g l y).toNat ≤ M) →
      (∃ l y, (fexrLamAt J g l y).toNat = M) →
      ∃ (Y' : Scheme.{u}) (g' : Y' ⟶ Spec (.of B)), fexPtTower B Y' g' ∧
        (∀ l y, fexrLamAt J g' l y ≠ ⊤) ∧ (∀ l y, (fexrLamAt J g' l y).toNat ≤ M) ∧
        {p : Fin m × Y' | (fexrLamAt J g' p.1 p.2).toNat = M}.ncard <
          {p : Fin m × Y | (fexrLamAt J g p.1 p.2).toNat = M}.ncard := by
    intro M Y g hT hM htop hle hex
    obtain ⟨l0, y, hy0⟩ := hex
    obtain ⟨hint, hnoeth, -, -, -, -, hregY, -, hdimY⟩ := fexr_tower_props B hreg hdim Y g hT
    haveI := hnoeth
    have hΛ0 : fexrLamAt J g l0 y ≠ 0 := by
      intro h
      rw [h] at hy0
      simp at hy0
      omega
    have hnp : ¬ (Ideal.map (wcNdSig g y) (J l0)).IsPrincipal :=
      fun hp => hΛ0 ((fexr_lam_basic _ _).1.2 hp)
    obtain ⟨hycl, hgy⟩ :=
      (fexr_nonprincipal_locus_finite B Y g hregY hdimY (J l0) (hJ l0)).2 y hnp
    obtain ⟨Y', r, hbl, hnoeth'⟩ := wc_csd_blowup_exists_noeth Y
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hycl⟩ : TopologicalSpace.Closeds Y))
    have hT' : fexPtTower B Y' (r ≫ g) := fexPtTower.step g y hycl r hT hgy hbl
    obtain ⟨hint', -, -, -, -, -, hregY', -, -⟩ := fexr_tower_props B hreg hdim Y' (r ≫ g) hT'
    obtain ⟨huniq, hbij⟩ := fexr_offcenter_transport Y Y' y hycl r hbl
    have hoff : ∀ l (z' : Y'), r z' ≠ y →
        fexrLamAt J (r ≫ g) l z' = fexrLamAt J g l (r z') := by
      intro l z' hz
      unfold fexrLamAt
      rw [fexr_wcNdSig_comp, ← Ideal.map_map]
      exact (fexr_lam_basic _ _).2.2.2 _ (RingEquiv.ofBijective (r.stalkMap z').hom (hbij z' hz))
    have hover : ∀ l (z' : Y'), r z' = y →
        fexrLamAt J (r ≫ g) l z' < fexrLamAt J g l (r z') ∨ fexrLamAt J (r ≫ g) l z' = 0 := by
      intro l z' hz
      obtain ⟨a, b, c, hm, hba, hab, hc, hinj, hsurj⟩ :=
        fexr_blowup_stalk_chart Y Y' y hycl r hint hint' (hregY y) (hdimY y hycl) hbl z' hz
      haveI := hregY (r z')
      haveI := hregY' z'
      haveI := (wc_fco_regular_local_ufd (Y.presheaf.stalk (r z'))).1
      haveI := (wc_fco_regular_local_ufd (Y'.presheaf.stalk z')).1
      have hdimR : ringKrullDim (Y.presheaf.stalk (r z')) = 2 :=
        hdimY (r z') (by rw [hz]; exact hycl)
      have key := fexr_lam_drop_at_chart _ hdimR a b hm hba hab _ _ c hinj hc hsurj
        (Ideal.map (wcNdSig g (r z')) (J l)) (htop l (r z'))
      unfold fexrLamAt
      rw [fexr_wcNdSig_comp, ← Ideal.map_map]
      exact key
    have htop' : ∀ l z', fexrLamAt J (r ≫ g) l z' ≠ ⊤ := by
      intro l z'
      by_cases hz : r z' = y
      · rcases hover l z' hz with h | h
        · exact (hlt _ _ h (htop l (r z'))).1
        · rw [h]; exact ENat.zero_ne_top
      · rw [hoff l z' hz]; exact htop l (r z')
    have hfinM : {p : Fin m × Y | (fexrLamAt J g p.1 p.2).toNat = M}.Finite := by
      refine (hfinF Y g hT).subset ?_
      rintro ⟨l, z⟩ hp
      simp only [Set.mem_setOf_eq] at hp ⊢
      intro h0
      rw [h0] at hp
      simp at hp
      omega
    obtain ⟨hle', -, hlt'⟩ := fexr_count_drop m (fun z' => r z') y
      (fun l z => (fexrLamAt J g l z).toNat) (fun l z' => (fexrLamAt J (r ≫ g) l z').toNat) M hM
      hle ⟨l0, hy0⟩ hfinM huniq
      (fun l z' hz => by simp only [hoff l z' hz])
      (fun l z' hz => by
        beta_reduce
        rw [← hz]
        rcases hover l z' hz with h | h
        · exact Or.inl (hlt _ _ h (htop l (r z'))).2
        · exact Or.inr (by rw [h]; simp))
    exact ⟨Y', r ≫ g, hT', htop', hle', hlt'⟩

  have key : ∀ (M n : ℕ) (Y : Scheme.{u}) (g : Y ⟶ Spec (.of B)), fexPtTower B Y g →
      (∀ l y, fexrLamAt J g l y ≠ ⊤) → (∀ l y, (fexrLamAt J g l y).toNat ≤ M) →
      {p : Fin m × Y | (fexrLamAt J g p.1 p.2).toNat = M}.ncard ≤ n →
      ∃ (Y : Scheme.{u}) (g : Y ⟶ Spec (.of B)), fexPtTower B Y g ∧
        ∀ (y : Y) (l : Fin m), (Ideal.map (wcNdSig g y) (J l)).IsPrincipal := by
    intro M
    induction M with
    | zero =>
      intro n Y g hT htop hle _
      refine ⟨Y, g, hT, fun y l => ?_⟩
      have h0 : (fexrLamAt J g l y).toNat = 0 := Nat.le_zero.mp (hle l y)
      rcases ENat.toNat_eq_zero.mp h0 with h | h
      · exact (fexr_lam_basic _ _).1.1 h
      · exact absurd h (htop l y)
    | succ k ihk =>
      intro n
      induction n using Nat.strong_induction_on with
      | _ n ihn =>
        intro Y g hT htop hle hcard
        by_cases hex : ∃ l y, (fexrLamAt J g l y).toNat = k + 1
        · obtain ⟨Y', g', hT', htop', hle', hlt'⟩ :=
            step (k + 1) Y g hT (Nat.succ_pos k) htop hle hex
          exact ihn _ (lt_of_lt_of_le hlt' hcard) Y' g' hT' htop' hle' le_rfl
        · have hle2 : ∀ l y, (fexrLamAt J g l y).toNat ≤ k := by
            intro l y
            have h1 := hle l y
            have hne : (fexrLamAt J g l y).toNat ≠ k + 1 := fun h => hex ⟨l, y, h⟩
            omega
          exact ihk _ Y g hT htop hle2 le_rfl

  have hT0 : fexPtTower B (Spec (.of B)) (𝟙 _) := fexPtTower.base
  have htop0 : ∀ l y, fexrLamAt J (𝟙 (Spec (.of B))) l y ≠ ⊤ :=
    fun l y => fexr_base_lam_finite B (J l) (hJ l) y
  have hF := hfinF _ _ hT0
  obtain ⟨M, hle0⟩ : ∃ M : ℕ, ∀ l y, (fexrLamAt J (𝟙 (Spec (.of B))) l y).toNat ≤ M := by
    refine ⟨hF.toFinset.sup (fun p => (fexrLamAt J (𝟙 (Spec (.of B))) p.1 p.2).toNat), ?_⟩
    intro l y
    by_cases h : fexrLamAt J (𝟙 (Spec (.of B))) l y = 0
    · rw [h]; simp
    · exact Finset.le_sup (f := fun p => (fexrLamAt J (𝟙 (Spec (.of B))) p.1 p.2).toNat)
        (hF.mem_toFinset.mpr (show (l, y) ∈ {p : Fin m × Spec (.of B) |
          fexrLamAt J (𝟙 (Spec (.of B))) p.1 p.2 ≠ 0} from h))
  exact key M _ _ _ hT0 htop0 hle0 le_rfl

theorem fexr_leray : ∀ (Z Y : Scheme.{u}) [IsNoetherian Z] (g : Z ⟶ Y), (∀ U V : Z.Opens, IsAffineOpen U → IsAffineOpen V → IsAffineOpen (U ⊓ V)) → wcpaLccP1 g → ∀ (k : ℕ) (V : Fin k → Y.Opens), (⨆ a, V a) = ⊤ → (∀ a, wcpaDjFexH1 (g ⁻¹ᵁ V a).toScheme) → wcpaDjTwH1 (⟨k, V, fun _ _ => 1⟩ : wcpaDjCoc Y) ⊤ (wcStructMod Y) 0 → wcpaDjFexH1 Z :=
by
  intro Z Y _ g _hAff hP1 k V hV hloc hY

  have hres : ∀ {X : Scheme.{u}} {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro X A B C h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hid : ∀ {X : Scheme.{u}} {A : X.Opens} (h : A ≤ A) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h).op).hom x = x := by
    intro X A h x
    have e0 : X.presheaf.map (homOfLE h).op = 𝟙 _ := by
      rw [show (homOfLE h).op = 𝟙 (Opposite.op A) from rfl, X.presheaf.map_id]
    rw [e0]
    rfl

  have hnat : ∀ {X' X : Scheme.{u}} (h : X' ⟶ X) {A B : X.Opens} (hle : B ≤ A) (x : Γ(X, A)),
      (h.app B).hom ((X.presheaf.map (homOfLE hle).op).hom x) =
        (X'.presheaf.map (homOfLE (show h ⁻¹ᵁ B ≤ h ⁻¹ᵁ A from fun _ hx => hle hx)).op).hom
          ((h.app A).hom x) := by
    intro X' X h A B hle x
    show ((X.presheaf.map (homOfLE hle).op ≫ h.app B).hom x) = _
    rw [h.naturality]
    rfl

  have tw_of_raw : ∀ (X : Scheme.{u}) (L : wcpaDjCoc X), wcpaP1rRawH1 L.V →
      wcpaDjTwH1 L ⊤ (wcStructMod X) 0 := by
    intro X L R
    have key : ∀ c0 : ∀ a b : Fin L.m, Γ(X, L.V a ⊓ L.V b ⊓ ⊤),
        (∀ a b d,
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V d ⊓ ⊤ from
            inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_left))).op).hom (c0 a d) =
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V b ⊓ L.V d ⊓ ⊤ from
            inf_le_inf_right ⊤ (inf_le_inf_right (L.V d) inf_le_right))).op).hom (c0 b d) +
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤ L.V a ⊓ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c0 a b)) →
        ∃ β0 : ∀ a : Fin L.m, Γ(X, L.V a ⊓ ⊤), ∀ a b,
          c0 a b = (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β0 b) -
          (X.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β0 a) := by
      intro c0 hc0
      obtain ⟨β', hβ'⟩ := R (fun a b =>
        (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
          L.V a ⊓ L.V b ≤ L.V a ⊓ L.V b ⊓ ⊤)).op).hom (c0 a b)) (by
        intro a b d
        have h := congrArg (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
          L.V a ⊓ L.V b ⊓ L.V d ≤ L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤)).op).hom (hc0 a b d)
        rw [map_add] at h
        simp only [hres] at h ⊢
        exact h)
      refine ⟨fun a => (X.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ ⊤ ≤ L.V a)).op).hom (β' a),
        fun a b => ?_⟩
      have h := congrArg (X.presheaf.map (homOfLE (inf_le_left :
        L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b)).op).hom (hβ' a b)
      rw [map_sub] at h
      simp only [hres, hid] at h
      simp only [hres]
      rw [← h]
    unfold wcpaDjTwH1
    intro c hc
    simp only [pow_zero, one_smul] at hc ⊢
    obtain ⟨β0, hβ0⟩ := key c hc
    exact ⟨β0, hβ0⟩

  have raw_of_tw : ∀ (X : Scheme.{u}) {m : ℕ} (W : Fin m → X.Opens),
      wcpaDjTwH1 (⟨m, W, fun _ _ => 1⟩ : wcpaDjCoc X) ⊤ (wcStructMod X) 0 → wcpaP1rRawH1 W := by
    intro X m W hT
    unfold wcpaDjTwH1 at hT
    simp only [pow_zero, one_smul] at hT
    have hT' : ∀ c0 : ∀ a b : Fin m, Γ(X, W a ⊓ W b ⊓ ⊤),
        (∀ a b d,
          (X.presheaf.map (homOfLE (show W a ⊓ W b ⊓ W d ⊓ ⊤ ≤ W a ⊓ W d ⊓ ⊤ from
            inf_le_inf_right ⊤ (inf_le_inf_right (W d) inf_le_left))).op).hom (c0 a d) =
          (X.presheaf.map (homOfLE (show W a ⊓ W b ⊓ W d ⊓ ⊤ ≤ W b ⊓ W d ⊓ ⊤ from
            inf_le_inf_right ⊤ (inf_le_inf_right (W d) inf_le_right))).op).hom (c0 b d) +
          (X.presheaf.map (homOfLE (show W a ⊓ W b ⊓ W d ⊓ ⊤ ≤ W a ⊓ W b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c0 a b)) →
        ∃ β0 : ∀ a : Fin m, Γ(X, W a ⊓ ⊤), ∀ a b,
          c0 a b = (X.presheaf.map (homOfLE (show W a ⊓ W b ⊓ ⊤ ≤ W b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β0 b) -
          (X.presheaf.map (homOfLE (show W a ⊓ W b ⊓ ⊤ ≤ W a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β0 a) :=
      fun c0 hc0 => hT c0 hc0
    intro c hc
    obtain ⟨β, hβ⟩ := hT' (fun a b =>
      (X.presheaf.map (homOfLE (inf_le_left : W a ⊓ W b ⊓ ⊤ ≤ W a ⊓ W b)).op).hom (c a b)) (by
      intro a b d
      have h := congrArg (X.presheaf.map (homOfLE (inf_le_left :
        W a ⊓ W b ⊓ W d ⊓ ⊤ ≤ W a ⊓ W b ⊓ W d)).op).hom (hc a b d)
      rw [map_add] at h
      simp only [hres] at h ⊢
      exact h)
    refine ⟨fun a => (X.presheaf.map (homOfLE (le_inf le_rfl le_top : W a ≤ W a ⊓ ⊤)).op).hom (β a),
      fun a b => ?_⟩
    have h := congrArg (X.presheaf.map (homOfLE (le_inf le_rfl le_top :
      W a ⊓ W b ≤ W a ⊓ W b ⊓ ⊤)).op).hom (hβ a b)
    rw [map_sub] at h
    simp only [hres, hid] at h
    simp only [hres]
