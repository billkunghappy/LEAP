theorem wcpa_dj_nccw_geniso_swap : nccwProps.{u} → ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G), nccwH R u u' τ τ' π a a' h ι j γ γ' → ∀ ξ : Z, nccwsuMaxS u ξ → ∃ W : Z.Opens, ξ ∈ W ∧ IsIso ((ι ≫ Limits.pullback.fst u u') ∣_ W) :=
