    have hFG : (IsLocalRing.maximalIdeal S).FG := (isNoetherianRing_iff_ideal_fg S).mp inferInstance _
    have hπX0 : π ((Ψ₀ : MvPowerSeries (Fin 2) S →+* B) (MvPowerSeries.X 0)) =
        Ideal.Quotient.mk _ (MvPowerSeries.X 0) := by
      have e0 : (Ψ₀ : MvPowerSeries (Fin 2) S →+* B) (MvPowerSeries.X 0) = uB := hΨ0
