      obtain ⟨G, rfl⟩ := Ideal.Quotient.mk_surjective w
      rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq] at hw
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hw
