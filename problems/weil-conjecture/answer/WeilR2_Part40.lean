  exact wcpa_dj_ncce_serre_local_normal (Localization.AtPrime Q) hSQ

theorem wcpa_dj_ncc_component_chain : wcpaDjNccChain.{u} :=
by
  intro X _ _ hpc x y
  classical
  haveI := hpc
  let Reach : Set X → Prop := fun L => ∃ (r : ℕ) (K : Fin (r + 1) → Set X),
    (∀ t, K t ∈ irreducibleComponents X) ∧ x ∈ K 0 ∧ K (Fin.last r) = L ∧
      ∀ t : Fin r, (K t.castSucc ∩ K t.succ).Nonempty
  have hext : ∀ K L : Set X, Reach K → L ∈ irreducibleComponents X → (K ∩ L).Nonempty →
      Reach L := by
    rintro K L ⟨r, Kc, hmem, hx0, hlast, hcons⟩ hL hKL
    refine ⟨r + 1, Fin.snoc (α := fun _ => Set X) Kc L, ?_, ?_, ?_, ?_⟩
    · intro t
      induction t using Fin.lastCases with
      | last => rw [Fin.snoc_last]; exact hL
      | cast s => rw [Fin.snoc_castSucc]; exact hmem s
    · show x ∈ Fin.snoc (α := fun _ => Set X) Kc L (Fin.castSucc 0)
      rw [Fin.snoc_castSucc]; exact hx0
    · exact Fin.snoc_last (α := fun _ => Set X) _ _
    · intro t
      induction t using Fin.lastCases with
      | last =>
        rw [Fin.succ_last, Fin.snoc_last, Fin.snoc_castSucc, hlast]; exact hKL
      | cast s =>
        rw [Fin.succ_castSucc, Fin.snoc_castSucc, Fin.snoc_castSucc]; exact hcons s
  have hfin : (irreducibleComponents X).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have hcl : ∀ P : Set X → Prop,
      IsClosed (⋃₀ {L | L ∈ irreducibleComponents X ∧ P L}) := fun P =>
    (hfin.subset (fun L hL => hL.1)).isClosed_sUnion
      (fun L hL => isClosed_of_mem_irreducibleComponents L hL.1)
  set A : Set X := ⋃₀ {L | L ∈ irreducibleComponents X ∧ Reach L} with hAdef
  set B : Set X := ⋃₀ {L | L ∈ irreducibleComponents X ∧ ¬ Reach L} with hBdef
  have hxA : x ∈ A :=
    ⟨irreducibleComponent x, ⟨irreducibleComponent_mem_irreducibleComponents x,
      0, fun _ => irreducibleComponent x, fun _ => irreducibleComponent_mem_irreducibleComponents x,
      mem_irreducibleComponent, rfl, fun t => t.elim0⟩, mem_irreducibleComponent⟩
  have hAc : Aᶜ = B := by
    ext p
    constructor
    · intro hp
      exact ⟨irreducibleComponent p, ⟨irreducibleComponent_mem_irreducibleComponents p,
        fun hR => hp ⟨_, ⟨irreducibleComponent_mem_irreducibleComponents p, hR⟩,
          mem_irreducibleComponent⟩⟩, mem_irreducibleComponent⟩
    · rintro ⟨L, ⟨hL, hnR⟩, hpL⟩ ⟨K, ⟨_, hR⟩, hpK⟩
      exact hnR (hext K L hR hL ⟨p, hpK, hpL⟩)
  have hAcl : IsClosed A := hcl Reach
  have hAop : IsOpen A := by
    rw [← isClosed_compl_iff, hAc]
    exact hcl (fun L => ¬ Reach L)
  have hA : A = Set.univ := by
    rcases isClopen_iff.mp ⟨hAcl, hAop⟩ with h | h
    · exfalso
      rw [h] at hxA
      exact hxA
    · exact h
  have hyA : y ∈ A := by rw [hA]; trivial
  obtain ⟨L, ⟨_, r, K, hmem, hx0, hlast, hcons⟩, hyL⟩ := hyA
  exact ⟨r, K, hmem, hx0, by rw [hlast]; exact hyL, hcons⟩

theorem wcpa_dj_ncc_stability_count : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAlgClosed (IsLocalRing.ResidueField R) → ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ' : Fin n → (Spec (.of R) ⟶ Z')), 3 ≤ n → wcpaDjStablePtd u' n τ' → GeometricallyConnected u' → wcpaDjNccCert R u' n τ' → False :=
by
  classical
  intro R _ _ _ halg Z' u' n τ' hn hst hgc hcert
  obtain ⟨T, Eint, hTne, hTc, hTfin, hD, hE, hF⟩ := hcert
  haveI hconn : ConnectedSpace ↥(Limits.pullback u'
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) :=
    hgc.geometrically_connectedSpace (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))
      (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
  have hlow : 3 * T.card ≤ 2 + ∑ X ∈ T, (((Eint : Set ↥(Limits.pullback u'
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) ∩ X).ncard) := by
    refine le_trans ?_ hF
    rw [mul_comm, ← smul_eq_mul]
    apply Finset.card_nsmul_le_sum
    intro X hX
    beta_reduce
    split_ifs with hP
    · have := hst.2.2 (IsLocalRing.ResidueField R)
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) X (hTc X hX) hP
      omega
    · by_cases hb : (X ∩ closure Xᶜ).ncard = 0
      · have hempty : X ∩ closure Xᶜ = ∅ := (Set.ncard_eq_zero (hTfin X hX)).mp hb
        have hcl : IsClosed X := isClosed_of_mem_irreducibleComponents X (hTc X hX)
        have hne : X.Nonempty := (show Maximal IsIrreducible X from hTc X hX).prop.nonempty
        have hcompl : IsClosed Xᶜ := by
          apply closure_subset_iff_isClosed.mp
          intro y hy hyX
          have hmem : y ∈ X ∩ closure Xᶜ := ⟨hyX, hy⟩
          rw [hempty] at hmem
          exact hmem
        have hclopen : IsClopen X := ⟨hcl, isClosed_compl_iff.mp hcompl⟩
        have huniv : X = Set.univ := (isClopen_iff.mp hclopen).resolve_left hne.ne_empty
        have hm : 0 < Nat.card {i : Fin n // ∃ x ∈ X,
            ∃ p : ↥(Spec (.of (IsLocalRing.ResidueField R))),
            Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x =
              τ' i (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) p)} := by
          have i0 : Fin n := ⟨0, by omega⟩
          have p : ↥(Spec (.of (IsLocalRing.ResidueField R))) :=
            IsLocalRing.closedPoint (IsLocalRing.ResidueField R)
          have hτ := hst.2.1.1 i0
          have hy : u' (τ' i0 (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) p)) =
              Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) p := by
            rw [← Scheme.Hom.comp_apply, hτ]
            rfl
          obtain ⟨x, hx, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hy
          haveI : Nonempty {i : Fin n // ∃ x ∈ X,
              ∃ p : ↥(Spec (.of (IsLocalRing.ResidueField R))),
              Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) x =
                τ' i (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) p)} :=
            ⟨⟨i0, x, by rw [huniv]; trivial, p, hx⟩⟩
          exact Nat.card_pos
        omega
      · omega
  have hd : ∑ X ∈ T, (((Eint : Set ↥(Limits.pullback u'
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) ∩ X).ncard) ≤ 2 * Eint.card := by
    have h1 : ∀ X ∈ T, (((Eint : Set ↥(Limits.pullback u'
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) ∩ X).ncard) =
        ∑ x ∈ Eint, if x ∈ X then 1 else 0 := by
      intro X _
      rw [← Finset.card_filter, ← Set.ncard_coe_finset]
      congr 1
      ext x
      simp
    rw [Finset.sum_congr rfl h1, Finset.sum_comm, mul_comm, ← smul_eq_mul]
    apply Finset.sum_le_card_nsmul
    intro x hx
    obtain ⟨X₁, _, X₂, _, -, hiff⟩ := hD x hx
    rw [← Finset.card_filter]
    calc (T.filter (fun X => x ∈ X)).card ≤ ({X₁, X₂} : Finset _).card := by
          apply Finset.card_le_card
          intro X hXf
          rw [Finset.mem_filter] at hXf
          rcases (hiff X (hTc X hXf.1)).mp hXf.2 with h | h <;> simp [h]
      _ ≤ 2 := Finset.card_le_two
  have hpos := hTne.card_pos
  omega

theorem wcpa_dj_ncc_fibre_points : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAlgClosed (IsLocalRing.ResidueField R) → ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of R)), wcpaDjSemistable u' → (∀ X ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))), (X ∩ closure Xᶜ).Finite) ∧ ∀ (x : ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) (X₁ X₂ X₃ : Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))), X₁ ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) → X₂ ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) → X₃ ∈ irreducibleComponents ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) → x ∈ X₁ → x ∈ X₂ → x ∈ X₃ → X₁ = X₂ ∨ X₁ = X₃ ∨ X₂ = X₃ :=
by
  intro R _ _ _ halg Z' u' hss
  classical

  have htop : ∀ (S : Type u) [TopologicalSpace S] [TopologicalSpace.NoetherianSpace S]
      [QuasiSober S], (∀ a b c : S, a ⤳ b → b ⤳ c → a = b ∨ b = c) →
      ∀ X ∈ irreducibleComponents S, (X ∩ closure Xᶜ).Finite := by
    intro S _ _ _ hch X hX
    have hXc : IsClosed X := isClosed_of_mem_irreducibleComponents X hX
    obtain ⟨ξ, hξ⟩ := QuasiSober.sober hX.1 hXc
    have hcl : closure ({ξ} : Set S) = X := hξ
    have hfin : (irreducibleComponents S).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    have hUc : IsClosed (⋃₀ (irreducibleComponents S \ {X})) :=
      (hfin.subset Set.diff_subset).isClosed_sUnion
        (fun Y hY => isClosed_of_mem_irreducibleComponents Y hY.1)
    have hsub : Xᶜ ⊆ ⋃₀ (irreducibleComponents S \ {X}) := by
      intro y hy
      refine ⟨irreducibleComponent y, ⟨irreducibleComponent_mem_irreducibleComponents y, ?_⟩,
        mem_irreducibleComponent⟩
      intro h
      apply hy
      have h' : irreducibleComponent y = X := h
      rw [← h']
      exact mem_irreducibleComponent
    have hξn : ξ ∉ closure Xᶜ := by
      intro hξc
      obtain ⟨Y, ⟨hYc, hYX⟩, hξY⟩ := closure_minimal hsub hUc hξc
      have hXY : X ⊆ Y := by
        rw [← hcl]
        exact closure_minimal (Set.singleton_subset_iff.mpr hξY)
          (isClosed_of_mem_irreducibleComponents Y hYc)
      exact hYX (le_antisymm (hX.2 hYc.1 hXY) hXY)
    have hpt : ∀ b ∈ X ∩ closure Xᶜ, ∀ c, b ⤳ c → c = b := by
      intro b hb c hbc
      have hξb : ξ ⤳ b := specializes_iff_mem_closure.mpr (by rw [hcl]; exact hb.1)
      have hne : ξ ≠ b := fun h => hξn (by rw [h]; exact hb.2)
      rcases hch ξ b c hξb hbc with h | h
      · exact absurd h hne
      · exact h.symm
    have hBc : IsClosed (X ∩ closure Xᶜ) := hXc.inter isClosed_closure
    obtain ⟨𝒮, h𝒮f, h𝒮c, h𝒮i, h𝒮⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hBc
    rw [h𝒮]
    refine h𝒮f.sUnion (fun T hT => ?_)
    obtain ⟨g, hg⟩ := QuasiSober.sober (h𝒮i T hT) (h𝒮c T hT)
    have hgT : closure ({g} : Set S) = T := hg
    have hgB : g ∈ X ∩ closure Xᶜ := by
      rw [h𝒮]
      exact ⟨T, hT, by rw [← hgT]; exact subset_closure (Set.mem_singleton g)⟩
    refine (Set.finite_singleton g).subset (fun t ht => ?_)
    have hgt : g ⤳ t := specializes_iff_mem_closure.mpr (by rw [hgT]; exact ht)
    exact hpt g hgB t hgt

  have hnode : ∀ (Ω A : Type u) [Field Ω] [CommRing A] [IsLocalRing A] [IsNoetherianRing A],
      (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        (MvPowerSeries (Fin 2) Ω ⧸ Ideal.span
          {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) Ω)})) →
      ∃ c₀ c₁ : Ideal A, ∀ p ∈ minimalPrimes A, p = c₀ ∨ p = c₁ := by
    intro K A _ _ _ _ e
    have hflat : Module.Flat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      AdicCompletion.flat_of_isNoetherian (IsLocalRing.maximalIdeal A)
    have hff : Module.FaithfullyFlat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
      rw [Module.faithfullyFlat_iff]
      refine ⟨hflat, fun m hm h => ?_⟩
      rw [IsLocalRing.eq_maximalIdeal hm] at h
      have hev : ∀ x ∈ (IsLocalRing.maximalIdeal A) •
          (⊤ : Submodule A (AdicCompletion (IsLocalRing.maximalIdeal A) A)),
          AdicCompletion.evalOneₐ (IsLocalRing.maximalIdeal A) x = 0 := by
        intro x hx
        refine Submodule.smul_induction_on hx ?_ ?_
        · intro a ha n _
          rw [map_smul, Algebra.smul_def, Ideal.Quotient.algebraMap_eq,
            Ideal.Quotient.eq_zero_iff_mem.mpr ha, zero_mul]
        · intro x y hx hy
          rw [map_add, hx, hy, add_zero]
      have h1 := hev 1 (by rw [h]; exact Submodule.mem_top)
      rw [map_one] at h1
      exact one_ne_zero h1
    let σ : Fin 2 → MvPowerSeries (Fin 2) K →+* PowerSeries K := fun j =>
      { toFun := fun f => PowerSeries.mk (fun n => MvPowerSeries.coeff (Finsupp.single j n) f)
        map_one' := by
          ext n
          rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_one, PowerSeries.coeff_one]
          simp
        map_mul' := by
          intro f g
          ext n
          rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_mul, PowerSeries.coeff_mul,
            Finsupp.antidiagonal_single, Finset.sum_map]
          simp [PowerSeries.coeff_mk]
        map_zero' := by ext n; simp
        map_add' := by intro f g; ext n; simp }
    have hσc : ∀ (j : Fin 2) (f : MvPowerSeries (Fin 2) K) (n : ℕ),
        PowerSeries.coeff n (σ j f) = MvPowerSeries.coeff (Finsupp.single j n) f :=
      fun j f n => PowerSeries.coeff_mk n (fun n => MvPowerSeries.coeff (Finsupp.single j n) f)
    have hσX : ∀ i j : Fin 2, i ≠ j → σ j (MvPowerSeries.X i) = 0 := by
      intro i j hij
      ext n
      rw [hσc, MvPowerSeries.coeff_X, map_zero, if_neg]
      intro h
      have h2 := congrArg (fun m : Fin 2 →₀ ℕ => m i) h
      simp [Finsupp.single_apply, hij, Ne.symm hij] at h2
    have hσXne : ∀ j : Fin 2, σ j (MvPowerSeries.X j) ≠ 0 := by
      intro j h
      have h2 := congrArg (PowerSeries.coeff 1) h
      rw [hσc, MvPowerSeries.coeff_X, if_pos rfl, map_zero] at h2
      exact one_ne_zero h2
    have hσker : ∀ i j : Fin 2, i ≠ j → (∀ k : Fin 2, k ≠ j → k = i) →
        ∀ f, σ j f = 0 → MvPowerSeries.X i ∣ f := by
      intro i j hij hk f hf
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      have hm' : m = Finsupp.single j (m j) := by
        ext k
        by_cases hkj : k = j
        · subst hkj; simp
        · rw [hk k hkj]
          simp [hm, Finsupp.single_apply, hij, Ne.symm hij]
      rw [hm', ← hσc, hf, map_zero]
    have hσspan : ∀ (j : Fin 2), ∀ a ∈ Ideal.span
        {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}, σ j a = 0 := by
      intro j a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, map_mul]
      fin_cases j
      · simp [hσX 1 0 (by decide)]
      · simp [hσX 0 1 (by decide)]
    let φ : Fin 2 → AdicCompletion (IsLocalRing.maximalIdeal A) A →+* PowerSeries K := fun j =>
      (Ideal.Quotient.lift _ (σ j) (hσspan j)).comp e.toRingHom
    have hφ : ∀ (j : Fin 2) (c : AdicCompletion (IsLocalRing.maximalIdeal A) A)
        (f : MvPowerSeries (Fin 2) K), e c = Ideal.Quotient.mk _ f → φ j c = σ j f := by
      intro j c f hf
      show Ideal.Quotient.lift _ (σ j) (hσspan j) (e c) = σ j f
      rw [hf, Ideal.Quotient.lift_mk]
    have hQinf : RingHom.ker (φ 0) ⊓ RingHom.ker (φ 1) = ⊥ := by
      rw [eq_bot_iff]
      intro c hc
      rw [Ideal.mem_inf, RingHom.mem_ker, RingHom.mem_ker] at hc
      obtain ⟨f, hf⟩ := Ideal.Quotient.mk_surjective (e c)
      rw [hφ 0 c f hf.symm] at hc
      rw [hφ 1 c f hf.symm] at hc
      obtain ⟨a, rfl⟩ := hσker 1 0 (by decide) (by decide) f hc.1
      have h2 := hc.2
      rw [map_mul] at h2
      have ha : σ 1 a = 0 := (mul_eq_zero.mp h2).resolve_left (hσXne 1)
      obtain ⟨b, rfl⟩ := hσker 0 1 (by decide) (by decide) a ha
      have hmem : MvPowerSeries.X 1 * (MvPowerSeries.X 0 * b) ∈ Ideal.span
          {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)} :=
        Ideal.mem_span_singleton'.mpr ⟨b, by ring⟩
      have hec : e c = 0 := by
        rw [← hf, Ideal.Quotient.eq_zero_iff_mem]
        exact hmem
      rw [Ideal.mem_bot]
      exact (map_eq_zero_iff e e.injective).mp hec
    have hQprime : ∀ j : Fin 2, (RingHom.ker (φ j)).IsPrime := fun j => RingHom.ker_isPrime _
    have hq : ∀ j : Fin 2,
        (Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
          (RingHom.ker (φ j))).IsPrime := by
      intro j
      haveI := hQprime j
      infer_instance
    have hcover : ∀ p : Ideal A, p.IsPrime →
        Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
          (RingHom.ker (φ 0)) ≤ p ∨
        Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
          (RingHom.ker (φ 1)) ≤ p := by
      intro p hp
      obtain ⟨𝔓, h𝔓, hlo⟩ := Ideal.exists_isPrime_liesOver_of_faithfullyFlat
        (B := AdicCompletion (IsLocalRing.maximalIdeal A) A) p
      have hp𝔓 : p = Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
          𝔓 := hlo.over
      have hmul : RingHom.ker (φ 0) * RingHom.ker (φ 1) ≤ 𝔓 :=
        Ideal.mul_le_inf.trans (by rw [hQinf]; exact bot_le)
      rcases h𝔓.mul_le.mp hmul with h | h
      · left; rw [hp𝔓]; exact Ideal.comap_mono h
      · right; rw [hp𝔓]; exact Ideal.comap_mono h
    refine ⟨Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (RingHom.ker (φ 0)),
      Ideal.comap (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (RingHom.ker (φ 1)), ?_⟩
    intro p hp
    rcases hcover p hp.1.1 with h | h
    · exact Or.inl (le_antisymm (hp.2 ⟨hq 0, bot_le⟩ h) h)
    · exact Or.inr (le_antisymm (hp.2 ⟨hq 1, bot_le⟩ h) h)

  have key : ∀ (k : Type u) [Field k] [IsAlgClosed k] (s : Spec (.of k) ⟶ Spec (.of R)),
      IsClosedImmersion s → (∀ q, s q = IsLocalRing.closedPoint R) →
      (∀ X ∈ irreducibleComponents ↥(Limits.pullback u' s), (X ∩ closure Xᶜ).Finite) ∧
      ∀ (x : ↥(Limits.pullback u' s)) (X₁ X₂ X₃ : Set ↥(Limits.pullback u' s)),
        X₁ ∈ irreducibleComponents ↥(Limits.pullback u' s) →
        X₂ ∈ irreducibleComponents ↥(Limits.pullback u' s) →
        X₃ ∈ irreducibleComponents ↥(Limits.pullback u' s) →
        x ∈ X₁ → x ∈ X₂ → x ∈ X₃ → X₁ = X₂ ∨ X₁ = X₃ ∨ X₂ = X₃ := by
    intro k _ _ s hsci hs
    haveI hup : IsProper u' := hss.2.1
    haveI hsnd : IsProper (Limits.pullback.snd u' s) :=
      MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback u' s) hup
    haveI hfst : IsClosedImmersion (Limits.pullback.fst u' s) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion)
        (IsPullback.of_hasPullback u' s).flip hsci
    haveI hlnP : IsLocallyNoetherian (Limits.pullback u' s) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd u' s)
    haveI hcP : CompactSpace ↥(Limits.pullback u' s) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd u' s)
    haveI hnP : AlgebraicGeometry.IsNoetherian (Limits.pullback u' s) :=
      AlgebraicGeometry.IsNoetherian.mk
    have hchain : ∀ a b c : ↥(Limits.pullback u' s), a ⤳ b → b ⤳ c → a = b ∨ b = c := by
      intro a b c hab hbc
      have hinj : Function.Injective (Limits.pullback.fst u' s) :=
        (Limits.pullback.fst u' s).isClosedEmbedding.injective
      have hu : u' (Limits.pullback.fst u' s a) = IsLocalRing.closedPoint R := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply, hs]
      rcases wcpa_dj_ldx_ncds_chain_short_special R Z' u' hss _ _ _ hu
          (hab.map (Limits.pullback.fst u' s).continuous)
          (hbc.map (Limits.pullback.fst u' s).continuous) with h | h
      · exact Or.inl (hinj h)
      · exact Or.inr (hinj h)
    refine ⟨htop _ hchain, ?_⟩
    intro x X₁ X₂ X₃ h1 h2 h3 hx1 hx2 hx3
    by_contra hcon
    push_neg at hcon
    obtain ⟨h12, h13, h23⟩ := hcon
    have hEinj : Function.Injective ![X₁, X₂, X₃] := by
      intro i j hij
      fin_cases i <;> fin_cases j <;> first
        | rfl
        | (exfalso; simp [h12, h13, h23, Ne.symm h12, Ne.symm h13, Ne.symm h23] at hij)
    obtain ⟨Q, hQinj, hQmin⟩ := wcpa_dj_lr1k_ll_db_components_minimal_primes _ x 3
      ![X₁, X₂, X₃] hEinj (fun i => by fin_cases i <;> assumption)
      (fun i => by fin_cases i <;> assumption)
    have h01 : (0 : Fin 3) ≠ 1 := by decide
    have h02 : (0 : Fin 3) ≠ 2 := by decide
    have h12' : (1 : Fin 3) ≠ 2 := by decide
    rcases hss.2.2 k s x with ⟨W, hxW, hsm⟩ | ⟨e, -⟩
    · haveI := hsm
      haveI hdomW := wcpa_smooth_stalk_isDomain k _ (W.ι ≫ Limits.pullback.snd u' s) 1 ⟨x, hxW⟩
      haveI hdom : IsDomain ((Limits.pullback u' s).presheaf.stalk x) :=
        ((W.stalkIso ⟨x, hxW⟩).symm.commRingCatIsoToRingEquiv).toMulEquiv.isDomain
      have hmin := IsDomain.minimalPrimes_eq_singleton_bot ((Limits.pullback u' s).presheaf.stalk x)
      have e0 := hQmin 0
      have e1 := hQmin 1
      rw [hmin] at e0 e1
      exact h01 (hQinj ((Set.mem_singleton_iff.mp e0).trans (Set.mem_singleton_iff.mp e1).symm))
    · obtain ⟨c₀, c₁, hc⟩ := hnode k _ e
      rcases hc _ (hQmin 0) with a0 | a0 <;> rcases hc _ (hQmin 1) with a1 | a1 <;>
        rcases hc _ (hQmin 2) with a2 | a2
      all_goals first
        | exact h01 (hQinj (a0.trans a1.symm))
        | exact h02 (hQinj (a0.trans a2.symm))
        | exact h12' (hQinj (a1.trans a2.symm))
  have hsci : IsClosedImmersion (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) :=
    IsClosedImmersion.spec_of_surjective _ (by exact IsLocalRing.residue_surjective)
  have hsq : ∀ q : Spec (.of (IsLocalRing.ResidueField R)),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) q = IsLocalRing.closedPoint R := by
    intro q
    apply PrimeSpectrum.ext
    have hq0 : (q : PrimeSpectrum (IsLocalRing.ResidueField R)).asIdeal = ⊥ := by
      haveI := (q : PrimeSpectrum (IsLocalRing.ResidueField R)).isPrime
      exact Ideal.eq_bot_of_prime _
    rw [Spec.map_apply]
    change Ideal.comap (IsLocalRing.residue R) (q : PrimeSpectrum (IsLocalRing.ResidueField R)).asIdeal
      = IsLocalRing.maximalIdeal R
    rw [hq0, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue]
  haveI := halg
  exact key (IsLocalRing.ResidueField R) _ hsci hsq

theorem wcpa_dj_ncc_forest_count : ∀ {α β : Type u} (V : Finset α) (E : Finset β) (inc : β → α → Prop), V.Nonempty → (∀ e ∈ E, ∃ X₁ ∈ V, ∃ X₂ ∈ V, X₁ ≠ X₂ ∧ ∀ X ∈ V, inc e X ↔ X = X₁ ∨ X = X₂) → (∀ (m : ℕ) (X : Fin (m + 2) → α) (p : Fin (m + 2) → β), (∀ i, X i ∈ V) → (∀ i, p i ∈ E) → Function.Injective X → Function.Injective p → (∀ i, inc (p i) (X i) ∧ inc (p i) (X (finRotate (m + 2) i))) → False) → E.card + 1 ≤ V.card :=
by
  intro α β V E inc hV hE hC
  classical

  have hpar : ∀ e ∈ E, ∀ e' ∈ E, ∀ X₁ ∈ V, ∀ X₂ ∈ V, X₁ ≠ X₂ → inc e X₁ → inc e X₂ →
      inc e' X₁ → inc e' X₂ → e = e' := by
    intro e he e' he' X₁ h1 X₂ h2 hne a1 a2 b1 b2
    by_contra hee
    have r0 : finRotate (0 + 2) 0 = 1 := by decide
    have r1 : finRotate (0 + 2) 1 = 0 := by decide
    apply hC 0 ![X₁, X₂] ![e, e']
    · intro i; fin_cases i <;> simp [h1, h2]
    · intro i; fin_cases i <;> simp [he, he']
    · intro i j hij; fin_cases i <;> fin_cases j <;> simp_all
    · intro i j hij; fin_cases i <;> fin_cases j <;> simp_all
    · intro i; fin_cases i
      · simp only [Fin.zero_eta, Fin.isValue, Matrix.cons_val_zero]
        rw [r0]; simp [a1, a2]
      · simp only [Fin.mk_one, Fin.isValue, Matrix.cons_val_one]
        rw [r1]; simp [b1, b2]

  obtain ⟨r, hr⟩ : ∃ r : V → V → Prop, r = fun x y => ∃ e ∈ E, inc e x.1 ∧ inc e y.1 := ⟨_, rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : SimpleGraph V, G = SimpleGraph.fromRel r := ⟨_, rfl⟩
  have hadj : ∀ x y : V, G.Adj x y → ∃ e ∈ E, inc e x.1 ∧ inc e y.1 := by
    intro x y h
    rw [hG, SimpleGraph.fromRel_adj, hr] at h
    rcases h.2 with ⟨e, he, h1, h2⟩ | ⟨e, he, h1, h2⟩
    · exact ⟨e, he, h1, h2⟩
    · exact ⟨e, he, h2, h1⟩

  have h1 : E.card ≤ Nat.card G.edgeSet := by
    choose a ha b hb hab hiff using hE
    have hia : ∀ e (he : e ∈ E), inc e (a e he) := fun e he =>
      (hiff e he _ (ha e he)).2 (Or.inl rfl)
    have hib : ∀ e (he : e ∈ E), inc e (b e he) := fun e he =>
      (hiff e he _ (hb e he)).2 (Or.inr rfl)
    let f : E → G.edgeSet := fun e => ⟨s(⟨a e.1 e.2, ha e.1 e.2⟩, ⟨b e.1 e.2, hb e.1 e.2⟩), by
      rw [SimpleGraph.mem_edgeSet, hG, SimpleGraph.fromRel_adj, hr]
      exact ⟨fun h => hab e.1 e.2 (congrArg Subtype.val h),
        Or.inl ⟨e.1, e.2, hia _ _, hib _ _⟩⟩⟩
    have hf : Function.Injective f := by
      rintro ⟨e, he⟩ ⟨e', he'⟩ h
      simp only [f, Subtype.mk.injEq, Sym2.eq_iff] at h
      apply Subtype.ext
      rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · exact hpar e he e' he' (a e he) (ha e he) (b e he) (hb e he) (hab e he) (hia e he)
          (hib e he) (by rw [h1]; exact hia e' he') (by rw [h2]; exact hib e' he')
      · exact hpar e he e' he' (a e he) (ha e he) (b e he) (hb e he) (hab e he) (hia e he)
          (hib e he) (by rw [h1]; exact hib e' he') (by rw [h2]; exact hia e' he')
    have := Nat.card_le_card_of_injective f hf
    rwa [Nat.card_eq_finsetCard] at this

  have hac : G.IsAcyclic := by
    intro v c hc
    obtain ⟨m, hm, hL⟩ : ∃ m, 1 ≤ m ∧ c.length = m + 2 := by
      have h0 : c.length ≠ 0 := by
        intro h
        exact hc.isCircuit.ne_nil (SimpleGraph.Walk.length_eq_zero_iff.mp h).eq_nil
      have h1' : c.length ≠ 1 := by
        intro h
        have := c.adj_getVert_succ (i := 0) (by omega)
        rw [SimpleGraph.Walk.getVert_zero,
          SimpleGraph.Walk.getVert_of_length_le c (i := 0 + 1) (by omega)] at this
        exact this.ne rfl
      have h2' : c.length ≠ 2 := by
        intro h
        have := hc.getVert_sub_one_ne_getVert_add_one (i := 1) (by omega)
        rw [Nat.sub_self, SimpleGraph.Walk.getVert_zero,
          SimpleGraph.Walk.getVert_of_length_le c (i := 1 + 1) (by omega)] at this
        exact this rfl
      exact ⟨c.length - 2, by omega, by omega⟩
    have hrot : ∀ i : Fin (m + 2), (i.val + 1 < m + 2 → (finRotate (m + 2) i).val = i.val + 1) ∧
        (i.val = m + 1 → (finRotate (m + 2) i).val = 0) := by
      intro i
      have e : (finRotate (m + 2) i).val = (i.val + 1) % (m + 2) := by
        rw [finRotate_apply, Fin.val_add, Fin.val_one]
      refine ⟨fun h => ?_, fun h => ?_⟩
      · rw [e, Nat.mod_eq_of_lt h]
      · rw [e, h, Nat.mod_self]
    obtain ⟨Y, hY⟩ : ∃ Y : Fin (m + 2) → V, ∀ i, Y i = c.getVert i.val := ⟨_, fun _ => rfl⟩
    have hYinj : Function.Injective Y := by
      intro i j h
      have hi := i.isLt
      have hj := j.isLt
      rw [hY, hY] at h
      have hi' : i.val ∈ {k | k ≤ c.length - 1} := by show i.val ≤ c.length - 1; omega
      have hj' : j.val ∈ {k | k ≤ c.length - 1} := by show j.val ≤ c.length - 1; omega
      exact Fin.ext (hc.getVert_injOn' hi' hj' h)
    have hYadj : ∀ i : Fin (m + 2), G.Adj (Y i) (Y (finRotate (m + 2) i)) := by
      intro i
      have hi := i.isLt
      rw [hY, hY]
      rcases Nat.lt_or_ge (i.val + 1) (m + 2) with h | h
      · rw [(hrot i).1 h]
        exact c.adj_getVert_succ (by omega)
      · rw [(hrot i).2 (by omega), SimpleGraph.Walk.getVert_zero]
        have := c.adj_getVert_succ (i := i.val) (by omega)
        rwa [SimpleGraph.Walk.getVert_of_length_le c (i := i.val + 1) (by omega)] at this
    have hex : ∀ i : Fin (m + 2), ∃ e, e ∈ E ∧ inc e (Y i).1 ∧
        inc e (Y (finRotate (m + 2) i)).1 := by
      intro i
      obtain ⟨e, he, h1, h2⟩ := hadj _ _ (hYadj i)
      exact ⟨e, he, h1, h2⟩
    choose p hpE hp1 hp2 using hex
    have F1 : ∀ i : Fin (m + 2), finRotate (m + 2) i ≠ i := by
      intro i h
      have := congrArg Fin.val h
      have hi := i.isLt
      rcases Nat.lt_or_ge (i.val + 1) (m + 2) with h' | h'
      · rw [(hrot i).1 h'] at this; omega
      · rw [(hrot i).2 (by omega)] at this; omega
    have F2 : ∀ i : Fin (m + 2), finRotate (m + 2) (finRotate (m + 2) i) ≠ i := by
      intro i h
      have := congrArg Fin.val h
      have hi := i.isLt
      have hj := (finRotate (m + 2) i).isLt
      rcases Nat.lt_or_ge (i.val + 1) (m + 2) with h' | h'
      · have ej := (hrot i).1 h'
        rcases Nat.lt_or_ge ((finRotate (m + 2) i).val + 1) (m + 2) with h'' | h''
        · rw [(hrot _).1 h''] at this; omega
        · rw [(hrot _).2 (by omega)] at this; omega
      · have ej := (hrot i).2 (by omega)
        rcases Nat.lt_or_ge ((finRotate (m + 2) i).val + 1) (m + 2) with h'' | h''
        · rw [(hrot _).1 h''] at this; omega
        · rw [(hrot _).2 (by omega)] at this; omega
    have hXinj : ∀ i j, (Y i).1 = (Y j).1 → i = j := fun i j h => hYinj (Subtype.ext h)
    have hpinj : Function.Injective p := by
      intro i j hij
      by_contra hne
      obtain ⟨A, hA, B, hB, hAB, hiff⟩ := hE (p i) (hpE i)
      have k1 : ∀ x : V, inc (p i) x.1 → x.1 = A ∨ x.1 = B := fun x hx => (hiff x.1 x.2).1 hx
      have a1 := k1 (Y i) (hp1 i)
      have a2 := k1 (Y (finRotate (m + 2) i)) (hp2 i)
      have a3 := k1 (Y j) (by rw [hij]; exact hp1 j)
      have a4 := k1 (Y (finRotate (m + 2) j)) (by rw [hij]; exact hp2 j)
      have n1 : (Y i).1 ≠ (Y (finRotate (m + 2) i)).1 := fun h => F1 i (hXinj _ _ h).symm
      have n2 : (Y i).1 ≠ (Y j).1 := fun h => hne (hXinj _ _ h)
      have n3 : (Y j).1 ≠ (Y (finRotate (m + 2) j)).1 := fun h => F1 j (hXinj _ _ h).symm
      have n4 : (Y j).1 ≠ (Y i).1 := fun h => n2 h.symm
      have e1 : (Y (finRotate (m + 2) i)).1 = (Y j).1 := by
        rcases a1 with h1 | h1 <;> rcases a2 with h2 | h2 <;> rcases a3 with h3 | h3 <;>
          first
          | exact absurd (h1.trans h2.symm) n1
          | exact absurd (h1.trans h3.symm) n2
          | exact h2.trans h3.symm
      have e2 : (Y (finRotate (m + 2) j)).1 = (Y i).1 := by
        rcases a3 with h1 | h1 <;> rcases a4 with h2 | h2 <;> rcases a1 with h3 | h3 <;>
          first
          | exact absurd (h1.trans h2.symm) n3
          | exact absurd (h1.trans h3.symm) n4
          | exact h2.trans h3.symm
      have g1 := hXinj _ _ e1
      have g2 := hXinj _ _ e2
      apply F2 i
      rw [g1, g2]
    exact hC m (fun i => (Y i).1) p (fun i => (Y i).2) hpE (fun i j h => hXinj i j h) hpinj
      (fun i => ⟨hp1 i, hp2 i⟩)

  have : Nonempty V := hV.coe_sort
  obtain ⟨T, hGT, hT⟩ := Finite.exists_le_maximal (p := SimpleGraph.IsAcyclic) hac
  have hTt := SimpleGraph.maximal_isAcyclic_iff_isTree.mp hT
  have hcard := (SimpleGraph.isTree_iff_connected_and_card.mp hTt).2
  have hmono : Nat.card G.edgeSet ≤ Nat.card T.edgeSet :=
    Nat.card_mono (Set.toFinite _) (SimpleGraph.edgeSet_mono hGT)
  have hV' : Nat.card V = V.card := Nat.card_eq_finsetCard V
  omega

theorem wcpa_dj_nccw_gn_local_normal_conductor : ∀ (A : Type u) [CommRing A] [_root_.IsReduced A] [IsNoetherianRing A] (L : Type u) [CommRing L] [Algebra A L], Nonempty (L ≃ₐ[A] ((P : {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}) → Localization.AtPrime P.1.asIdeal)) → Function.Injective (algebraMap A (integralClosure A L)) ∧ ∀ (p : Ideal A) [p.IsPrime], IsDomain (Localization.AtPrime p) → IsIntegrallyClosed (Localization.AtPrime p) → ∀ b : integralClosure A L, ∃ c s : A, s ∉ p ∧ algebraMap A (integralClosure A L) s * b = algebraMap A (integralClosure A L) c :=
by
  intro A _ _ _ L _ _ ⟨e⟩
  classical

  have s1 : ∀ a : A, (∀ P ∈ minimalPrimes A, a ∈ P) → a = 0 := by
    intro a ha
    apply IsNilpotent.eq_zero
    rw [nilpotent_iff_mem_prime]
    intro J hJ
    obtain ⟨P, hP, hPJ⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal A) ≤ J)
    exact hPJ (ha P hP)

  have s1a : ∀ (P : Ideal A) [P.IsPrime], P ∈ minimalPrimes A → ∀ x ∈ P,
      algebraMap A (Localization.AtPrime P) x = 0 := by
    intro P _ hP x hx
    apply IsNilpotent.eq_zero
    rw [nilpotent_iff_mem_prime]
    intro J hJ
    have hq : (J.comap (algebraMap A (Localization.AtPrime P))).IsPrime := Ideal.comap_isPrime _ _
    have hle : J.comap (algebraMap A (Localization.AtPrime P)) ≤ P := by
      intro z hz
      by_contra hzP
      have hu : IsUnit (algebraMap A (Localization.AtPrime P) z) :=
        IsLocalization.map_units (Localization.AtPrime P) (⟨z, hzP⟩ : P.primeCompl)
      exact hJ.ne_top (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.mp hz) hu)
    have hge : P ≤ J.comap (algebraMap A (Localization.AtPrime P)) := hP.2 ⟨hq, bot_le⟩ hle
    exact Ideal.mem_comap.mp (hge hx)

  have s1z : ∀ (P : Ideal A) [P.IsPrime], P ∈ minimalPrimes A →
      ∀ z : Localization.AtPrime P, z = 0 ∨ IsUnit z := by
    intro P _ hP z
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective P.primeCompl z
    by_cases ha : a ∈ P
    · left
      show IsLocalization.mk' (Localization.AtPrime P) a s = 0
      rw [IsLocalization.mk'_eq_mul_mk'_one, s1a P hP a ha, zero_mul]
    · right
      exact IsUnit.of_mul_eq_one _
        (IsLocalization.mk'_mul_mk'_eq_one' (M := P.primeCompl) (S := Localization.AtPrime P) a s ha)

  have hMfin := minimalPrimes.finite_of_isNoetherianRing A
  have avoid : ∀ (q P₀ : Ideal A) [q.IsPrime], (∀ P ∈ minimalPrimes A, P ≤ q → P = P₀) →
      ∃ f : A, f ∉ q ∧ ∀ P ∈ minimalPrimes A, P ≠ P₀ → f ∈ P := by
    intro q P₀ hq huniq
    have hnle : ¬ ((hMfin.toFinset.erase P₀).inf id ≤ q) := by
      intro hle
      obtain ⟨P, hP, hPq⟩ := (Ideal.IsPrime.inf_le' hq).mp hle
      rw [Finset.mem_erase, Set.Finite.mem_toFinset] at hP
      exact hP.1 (huniq P hP.2 hPq)
    obtain ⟨f, hf, hfq⟩ := SetLike.not_le_iff_exists.mp hnle
    refine ⟨f, hfq, fun P hP hne => ?_⟩
    have hmem : P ∈ hMfin.toFinset.erase P₀ := by
      rw [Finset.mem_erase, Set.Finite.mem_toFinset]
      exact ⟨hne, hP⟩
    exact (Finset.inf_le (f := id) hmem) hf

  have uniq : ∀ (p : Ideal A) [p.IsPrime], IsDomain (Localization.AtPrime p) →
      ∀ P₁ ∈ minimalPrimes A, ∀ P₂ ∈ minimalPrimes A, P₁ ≤ p → P₂ ≤ p → P₁ = P₂ := by
    intro p _ hd P₁ hP₁ P₂ hP₂ h1 h2
    by_contra hne
    have hP₁p : P₁.IsPrime := hP₁.1.1
    have hP₂p : P₂.IsPrime := hP₂.1.1
    obtain ⟨h, hh1, hh2⟩ : ∃ h ∈ P₁, h ∉ P₂ := by
      by_contra hc
      push_neg at hc
      exact hne (le_antisymm hc (hP₂.2 ⟨hP₁p, bot_le⟩ hc))
    obtain ⟨g, hg1, hgP⟩ := avoid P₁ P₁
      (fun P hP hle => le_antisymm hle (hP₁.2 ⟨hP.1.1, bot_le⟩ hle))
    have hgh : g * h = 0 := by
      apply s1
      intro P hP
      by_cases hPP : P = P₁
      · rw [hPP]; exact Ideal.mul_mem_left _ g hh1
      · exact Ideal.mul_mem_right h _ (hgP P hP hPP)
    have hz : algebraMap A (Localization.AtPrime p) g * algebraMap A (Localization.AtPrime p) h = 0 := by
      rw [← map_mul, hgh, map_zero]
    rcases mul_eq_zero.mp hz with hz | hz
    · obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl _ g).mp hz
      have hmem : (t : A) * g ∈ P₁ := by rw [ht]; exact P₁.zero_mem
      rcases hP₁p.mem_or_mem hmem with h' | h'
      · exact t.2 (h1 h')
      · exact hg1 h'
    · obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl _ h).mp hz
      have hmem : (t : A) * h ∈ P₂ := by rw [ht]; exact P₂.zero_mem
      rcases hP₂p.mem_or_mem hmem with h' | h'
      · exact t.2 (h2 h')
      · exact hh2 h'

  have s4 : ∀ (P₀ p : Ideal A) [P₀.IsPrime] [p.IsPrime], P₀ ≤ p →
      (∀ z : Localization.AtPrime P₀, z = 0 ∨ IsUnit z) → IsDomain (Localization.AtPrime p) →
      IsIntegrallyClosed (Localization.AtPrime p) → ∀ β : Localization.AtPrime P₀, IsIntegral A β →
      ∃ c s : A, s ∉ p ∧ β * algebraMap A (Localization.AtPrime P₀) s =
        algebraMap A (Localization.AtPrime P₀) c := by
    intro P₀ p hP₀ _ hle h0u hd hic β hβ
    have h1 : ∀ t : A, t ∉ P₀ → algebraMap A (Localization.AtPrime p) t ≠ 0 := by
      intro t ht h0
      obtain ⟨w, hw⟩ := (IsLocalization.map_eq_zero_iff p.primeCompl _ t).mp h0
      have hmem : (w : A) * t ∈ P₀ := by rw [hw]; exact P₀.zero_mem
      rcases hP₀.mem_or_mem hmem with h' | h'
      · exact w.2 (hle h')
      · exact ht h'
    have hunit : ∀ t : P₀.primeCompl,
        IsUnit (algebraMap A (FractionRing (Localization.AtPrime p)) t) := by
      intro t
      rw [IsScalarTower.algebraMap_apply A (Localization.AtPrime p) (FractionRing (Localization.AtPrime p))]
      apply Ne.isUnit
      intro h0
      apply h1 t.1 t.2
      exact IsFractionRing.injective (Localization.AtPrime p) (FractionRing (Localization.AtPrime p))
        (h0.trans (map_zero _).symm)
    let ψ : Localization.AtPrime P₀ →+* FractionRing (Localization.AtPrime p) :=
      IsLocalization.lift (M := P₀.primeCompl) hunit
    have hψ : ∀ a : A, ψ (algebraMap A (Localization.AtPrime P₀) a) =
        algebraMap A (FractionRing (Localization.AtPrime p)) a := fun a => IsLocalization.lift_eq hunit a
    have hψinj : Function.Injective ψ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      rcases h0u z with h | h
      · exact h
      · exfalso
        have hu := h.map ψ
        rw [hz] at hu
        exact not_isUnit_zero hu
    have hcomp : (algebraMap (Localization.AtPrime p) (FractionRing (Localization.AtPrime p))).comp
        (algebraMap A (Localization.AtPrime p)) = ψ.comp (algebraMap A (Localization.AtPrime P₀)) := by
      apply RingHom.ext
      intro a
      simp only [RingHom.comp_apply]
      rw [hψ, IsScalarTower.algebraMap_apply A (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) a]
    have hint : IsIntegral (Localization.AtPrime p) (ψ β) :=
      IsIntegral.map_of_comp_eq (algebraMap A (Localization.AtPrime p)) ψ hcomp hβ
    obtain ⟨z, hz⟩ := (IsIntegrallyClosed.isIntegral_iff (K := FractionRing (Localization.AtPrime p))).mp hint
    obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl z
    refine ⟨c, s, s.2, ?_⟩
    apply hψinj
    rw [map_mul, hψ, hψ, ← hz,
      IsScalarTower.algebraMap_apply A (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) (s : A),
      IsScalarTower.algebraMap_apply A (Localization.AtPrime p) (FractionRing (Localization.AtPrime p)) c,
      ← map_mul, IsLocalization.mk'_spec]

  let ι := {P : PrimeSpectrum A // P.asIdeal ∈ minimalPrimes A}
  let K := fun i : ι => Localization.AtPrime i.1.asIdeal
  have hGa : ∀ (a : A) (i : ι), e ((algebraMap A (integralClosure A L) a : integralClosure A L) : L) i =
      algebraMap A (Localization.AtPrime i.1.asIdeal) a := by
    intro a i
    have h0 : ((algebraMap A (integralClosure A L) a : integralClosure A L) : L) = algebraMap A L a := rfl
    rw [h0, e.commutes]
    rfl
  refine ⟨?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro a ha
    apply s1
    intro P hP
    let i : ι := ⟨⟨P, hP.1.1⟩, hP⟩
    have h0 := hGa a i
    haveI hip : i.1.asIdeal.IsPrime := i.1.isPrime
    rw [ha, ZeroMemClass.coe_zero, map_zero, Pi.zero_apply] at h0
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff i.1.asIdeal.primeCompl _ a).mp h0.symm
    have hmem : (m : A) * a ∈ i.1.asIdeal := by rw [hm]; exact Ideal.zero_mem _
    rcases i.1.isPrime.mem_or_mem hmem with h | h
    · exact absurd h m.2
    · exact h
  · intro p _ hd hic b
    obtain ⟨P₀, hP₀, hP₀p⟩ := Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal A) ≤ p)
    haveI : P₀.IsPrime := hP₀.1.1
    obtain ⟨f, hfp, hfP⟩ := avoid p P₀ (fun P hP hPp => uniq p hd P hP P₀ hP₀ hPp hP₀p)
    let i₀ : ι := ⟨⟨P₀, hP₀.1.1⟩, hP₀⟩
    have hβ : IsIntegral A (e (b : L) i₀) := by
      have hb : IsIntegral A (b : L) := b.2
      exact hb.map ((Pi.evalAlgHom A K i₀).comp e.toAlgHom)
    obtain ⟨c, s, hs, hcs⟩ := s4 P₀ p hP₀p (s1z P₀ hP₀) hd hic (e (b : L) i₀) hβ
    refine ⟨f * c, f * s, ?_, ?_⟩
    · intro hmem
      rcases (inferInstance : p.IsPrime).mem_or_mem hmem with h | h
      · exact hfp h
      · exact hs h
    · apply Subtype.ext
      apply e.injective
      funext i
      rw [MulMemClass.coe_mul, map_mul, Pi.mul_apply, hGa, hGa]
      by_cases hi : i = i₀
      · subst hi
        rw [map_mul, map_mul, mul_assoc]
        congr 1
        rw [mul_comm]
        exact hcs
      · have hne : i.1.asIdeal ≠ P₀ := fun h => hi (Subtype.ext (PrimeSpectrum.ext h))
        have hf0 : algebraMap A (Localization.AtPrime i.1.asIdeal) f = 0 :=
          s1a i.1.asIdeal i.2 f (hfP _ i.2 hne)
        rw [map_mul, map_mul, hf0]
        simp

theorem wcpa_dj_nccw_gn_unique_prime_over : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Algebra.IsIntegral A B], Function.Injective (algebraMap A B) → ∀ (p : Ideal A) [p.IsPrime], (∀ b : B, ∃ c s : A, s ∉ p ∧ algebraMap A B s * b = algebraMap A B c) → ∃ (Q : Ideal B) (_ : Q.IsPrime) (hQ : p = Q.comap (algebraMap A B)), (∀ Q' : Ideal B, Q'.IsPrime → Q'.comap (algebraMap A B) = p → Q' = Q) ∧ Function.Bijective (Localization.localRingHom p Q (algebraMap A B) hQ) :=
by
  intro A B _ _ _ _ hinj p _ hstar
  classical
  obtain ⟨Q, -, hQprime, hQunder⟩ := Ideal.exists_ideal_over_prime_of_isIntegral p (⊥ : Ideal B)
    (by rw [Ideal.under_def]; exact Ideal.comap_bot_le_of_injective _ hinj)
  have hQc : Q.comap (algebraMap A B) = p := by rw [← Ideal.under_def]; exact hQunder
  have incl : ∀ Q₁ Q₂ : Ideal B, Q₂.IsPrime → Q₁.comap (algebraMap A B) = p →
      Q₂.comap (algebraMap A B) = p → Q₁ ≤ Q₂ := by
    intro Q₁ Q₂ hQ₂ h₁ h₂ b hb
    obtain ⟨c, s, hs, hsb⟩ := hstar b
    have hc1 : algebraMap A B c ∈ Q₁ := hsb ▸ Q₁.mul_mem_left _ hb
    have hcp : c ∈ p := by rw [← h₁]; exact hc1
    have hc2 : algebraMap A B s * b ∈ Q₂ := by
      rw [hsb]; rw [← h₂] at hcp; exact hcp
    rcases hQ₂.mem_or_mem hc2 with h | h
    · exact absurd (show s ∈ p by rw [← h₂]; exact h) hs
    · exact h
  have hK : ∀ s : A, s ∉ p → algebraMap A B s ∉ Q := fun s hs h => hs (by rw [← hQc]; exact h)
  have hden : ∀ (t : B) (c s : A), t ∉ Q → s ∉ p → algebraMap A B s * t = algebraMap A B c →
      c ∉ p := by
    intro t c s ht hs he hc
    have hmem : algebraMap A B s * t ∈ Q := by rw [he]; rw [← hQc] at hc; exact hc
    rcases hQprime.mem_or_mem hmem with h | h
    · exact hK s hs h
    · exact ht h
  refine ⟨Q, hQprime, hQc.symm, fun Q' hQ' hQ'c =>
    le_antisymm (incl Q' Q hQprime hQ'c hQc) (incl Q Q' hQ' hQc hQ'c), ?_, ?_⟩
  · rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl x
    rw [Localization.localRingHom_mk', IsLocalization.mk'_eq_zero_iff] at hx
    obtain ⟨⟨m, hm⟩, hma⟩ := hx
    have hma' : m * algebraMap A B a = 0 := hma
    obtain ⟨c', s', hs', hsm⟩ := hstar m
    have hc' : c' ∉ p := hden m c' s' hm hs' hsm
    rw [IsLocalization.mk'_eq_zero_iff]
    refine ⟨⟨c', hc'⟩, ?_⟩
    apply hinj
    show algebraMap A B (c' * a) = algebraMap A B 0
    rw [map_mul, map_zero, ← hsm, mul_assoc, hma', mul_zero]
  · intro y
    obtain ⟨⟨b, t⟩, rfl⟩ := IsLocalization.mk'_surjective Q.primeCompl y
    obtain ⟨c₁, s₁, hs₁, h₁⟩ := hstar b
    obtain ⟨c₂, s₂, hs₂, h₂⟩ := hstar (t : B)
    have hc₂ : c₂ ∉ p := hden t c₂ s₂ t.2 hs₂ h₂
    have hd : c₂ * s₁ ∈ p.primeCompl :=
      p.primeCompl.mul_mem (show c₂ ∈ p.primeCompl from hc₂) (show s₁ ∈ p.primeCompl from hs₁)
    refine ⟨IsLocalization.mk' (Localization.AtPrime p) (c₁ * s₂) ⟨c₂ * s₁, hd⟩, ?_⟩
    rw [Localization.localRingHom_mk', IsLocalization.mk'_eq_iff_eq]
    congr 1
    show (t : B) * algebraMap A B (c₁ * s₂) = algebraMap A B (c₂ * s₁) * b
    rw [map_mul, map_mul, ← h₁, ← h₂]
    ring

theorem wcpa_dj_nccw_gn_normal_locus : ∀ (X T : Scheme.{u}) (g : X ⟶ T) [QuasiCompact g] [QuasiSeparated g], (∀ V : T.affineOpens, letI := (g.app V).hom.toAlgebra; ∀ (p : Ideal Γ(T, V)) [p.IsPrime], IsDomain (Localization.AtPrime p) → IsIntegrallyClosed (Localization.AtPrime p) → ∃ (Q : Ideal (integralClosure Γ(T, V) Γ(X, g ⁻¹ᵁ V))) (_ : Q.IsPrime) (hQ : p = Q.comap (algebraMap Γ(T, V) (integralClosure Γ(T, V) Γ(X, g ⁻¹ᵁ V)))), (∀ Q' : Ideal (integralClosure Γ(T, V) Γ(X, g ⁻¹ᵁ V)), Q'.IsPrime → Q'.comap (algebraMap Γ(T, V) (integralClosure Γ(T, V) Γ(X, g ⁻¹ᵁ V))) = p → Q' = Q) ∧ Function.Bijective (Localization.localRingHom p Q (algebraMap Γ(T, V) (integralClosure Γ(T, V) Γ(X, g ⁻¹ᵁ V))) hQ)) → ∀ y : T, IsDomain (T.presheaf.stalk y) → IsIntegrallyClosed (T.presheaf.stalk y) → ∃ w : Scheme.Hom.normalization g, (∀ w' : Scheme.Hom.normalization g, Scheme.Hom.fromNormalization g w' = y ↔ w' = w) ∧ IsIso ((Scheme.Hom.fromNormalization g).stalkMap w) :=
by
  intro X T g _ _ hloc y hd hic
  classical
  set b := Scheme.Hom.fromNormalization g with hbdef
  obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
  have hW : IsAffineOpen (b ⁻¹ᵁ V) := hV.preimage b
  letI := (g.app V).hom.toAlgebra
  let θ : Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) ≃+* integralClosure Γ(T, V) Γ(X, g ⁻¹ᵁ V) :=
    (Scheme.Hom.normalizationObjIso g hV).commRingCatIsoToRingEquiv
  let ι := algebraMap Γ(T, V) (integralClosure Γ(T, V) Γ(X, g ⁻¹ᵁ V))

  have hb : (b.app V).hom = θ.symm.toRingHom.comp ι := by
    rw [Scheme.Hom.fromNormalization_app g hV, CommRingCat.hom_comp]
    rfl

  have hpt : ∀ t : Spec Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V),
      b (hW.fromSpec t) =
        hV.fromSpec ⟨(t.asIdeal.comap θ.symm.toRingHom).comap ι,
          by haveI := t.isPrime; exact Ideal.comap_isPrime _ _⟩ := by
    intro t
    have hcomp := IsAffineOpen.SpecMap_appLE_fromSpec b hV hW le_rfl
    have hbx : b (hW.fromSpec t) = hV.fromSpec ((Spec.map (b.appLE V (b ⁻¹ᵁ V) le_rfl)) t) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hcomp]
    rw [hbx]
    have hid : ((Spec.map (b.appLE V (b ⁻¹ᵁ V) le_rfl)) t).asIdeal =
        (t.asIdeal.comap θ.symm.toRingHom).comap ι := by
      show t.asIdeal.comap (b.appLE V (b ⁻¹ᵁ V) le_rfl).hom = _
      rw [← Scheme.Hom.app_eq_appLE, hb]
      exact (Ideal.comap_comap _ _).symm
    exact congrArg (fun z => hV.fromSpec z) (PrimeSpectrum.ext hid)

  set P := hV.primeIdealOf ⟨y, hyV⟩ with hPdef
  have hPy : hV.fromSpec P = y := hV.fromSpec_primeIdealOf ⟨y, hyV⟩

  have hnormP : IsDomain (Localization.AtPrime P.asIdeal) ∧
      IsIntegrallyClosed (Localization.AtPrime P.asIdeal) := by
    letI : Algebra Γ(T, V) (T.presheaf.stalk y) :=
      TopCat.Presheaf.algebra_section_stalk T.presheaf ⟨y, hyV⟩
    haveI : IsLocalization.AtPrime (T.presheaf.stalk y) P.asIdeal := hV.isLocalization_stalk ⟨y, hyV⟩
    let κ := (IsLocalization.algEquiv P.asIdeal.primeCompl (T.presheaf.stalk y)
      (Localization.AtPrime P.asIdeal)).toRingEquiv
    haveI : IsDomain (Localization.AtPrime P.asIdeal) :=
      MulEquiv.isDomain (T.presheaf.stalk y) κ.symm.toMulEquiv
    exact ⟨inferInstance, IsIntegrallyClosed.of_equiv κ⟩
  obtain ⟨hdP, hicP⟩ := hnormP
  obtain ⟨Q, hQp, hQ, huniq, hbij⟩ := hloc ⟨V, hV⟩ P.asIdeal hdP hicP
  haveI := hQp
  let q : Ideal Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) := Q.comap θ.toRingHom
  haveI hq : q.IsPrime := Ideal.comap_isPrime _ _
  let t₀ : Spec Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V) := ⟨q, hq⟩
  have hd1 : q.comap θ.symm.toRingHom = Q := by
    ext z
    show θ (θ.symm z) ∈ Q ↔ z ∈ Q
    rw [RingEquiv.apply_symm_apply]

  have hbw : b (hW.fromSpec t₀) = y := by
    rw [hpt t₀]
    refine Eq.trans ?_ hPy
    have hPt : (t₀.asIdeal.comap θ.symm.toRingHom).comap ι = P.asIdeal := by
      show (q.comap θ.symm.toRingHom).comap ι = P.asIdeal
      rw [hd1]
      exact hQ.symm
    exact congrArg (fun z => hV.fromSpec z) (PrimeSpectrum.ext hPt)
  refine ⟨hW.fromSpec t₀, fun w' => ⟨fun hw' => ?_, fun hw' => by rw [hw']; exact hbw⟩, ?_⟩
  ·
    have hw'W : w' ∈ b ⁻¹ᵁ V := by
      show b w' ∈ V
      rw [hw']
      exact hyV
    set t' := hW.primeIdealOf ⟨w', hw'W⟩ with ht'def
    have ht' : hW.fromSpec t' = w' := hW.fromSpec_primeIdealOf ⟨w', hw'W⟩
    have h1 : hV.fromSpec ⟨(t'.asIdeal.comap θ.symm.toRingHom).comap ι,
          by haveI := t'.isPrime; exact Ideal.comap_isPrime _ _⟩ =
        hV.fromSpec P := by
      rw [← hpt t', ht', hw', hPy]
    have h2 := hV.fromSpec.isOpenEmbedding.injective h1
    have h3 : (t'.asIdeal.comap θ.symm.toRingHom).comap ι = P.asIdeal :=
      congrArg PrimeSpectrum.asIdeal h2
    have h4 : t'.asIdeal.comap θ.symm.toRingHom = Q :=
      huniq _ (by haveI := t'.isPrime; exact Ideal.comap_isPrime _ _) h3
    have h5 : t' = t₀ := by
      apply PrimeSpectrum.ext
      show t'.asIdeal = Q.comap θ.toRingHom
      rw [← h4]
      ext z
      show z ∈ t'.asIdeal ↔ θ.symm (θ z) ∈ t'.asIdeal
      rw [RingEquiv.symm_apply_apply]
    rw [← ht', h5]
  ·
    have hx : hW.fromSpec t₀ ∈ b ⁻¹ᵁ V := by
      show b (hW.fromSpec t₀) ∈ V
      rw [hbw]
      exact hyV
    have hprime : hW.primeIdealOf ⟨hW.fromSpec t₀, hx⟩ = t₀ :=
      hW.fromSpec.isOpenEmbedding.injective (hW.fromSpec_primeIdealOf _)
    set w := hW.fromSpec t₀ with hwdef
    have hz : b w ∈ V := hx
    have hP' : hV.primeIdealOf ⟨b w, hz⟩ = P := congrArg hV.primeIdealOf (Subtype.ext hbw)
    letI algT' : Algebra Γ(T, V) (T.presheaf.stalk (b w)) :=
      TopCat.Presheaf.algebra_section_stalk T.presheaf ⟨b w, hz⟩
    haveI hlocT' : IsLocalization.AtPrime (T.presheaf.stalk (b w)) P.asIdeal := by
      have := hV.isLocalization_stalk ⟨b w, hz⟩
      rw [hP'] at this
      exact this
    letI algN : Algebra Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V)
        ((Scheme.Hom.normalization g).presheaf.stalk w) :=
      TopCat.Presheaf.algebra_section_stalk (Scheme.Hom.normalization g).presheaf ⟨w, hx⟩
    haveI hlocN : IsLocalization.AtPrime ((Scheme.Hom.normalization g).presheaf.stalk w) q := by
      have := hW.isLocalization_stalk ⟨w, hx⟩
      rw [hprime] at this
      exact this
    have hM : q.primeCompl.map θ.toMonoidHom = Q.primeCompl := by
      ext z
      constructor
      · rintro ⟨s, hs, rfl⟩
        exact hs
      · intro hz'
        refine ⟨θ.symm z, ?_, θ.apply_symm_apply z⟩
        show θ (θ.symm z) ∉ Q
        rw [θ.apply_symm_apply]
        exact hz'
    let κx : (Scheme.Hom.normalization g).presheaf.stalk w ≃+* Localization.AtPrime Q :=
      IsLocalization.ringEquivOfRingEquiv (M := q.primeCompl) (T := Q.primeCompl) _ _ θ hM
    let κy : T.presheaf.stalk (b w) ≃+* Localization.AtPrime P.asIdeal :=
      (IsLocalization.algEquiv P.asIdeal.primeCompl (T.presheaf.stalk (b w))
        (Localization.AtPrime P.asIdeal)).toRingEquiv
    have hkey : κx.toRingHom.comp (b.stalkMap w).hom =
        (Localization.localRingHom P.asIdeal Q ι hQ).comp κy.toRingHom := by
      apply IsLocalization.ringHom_ext P.asIdeal.primeCompl (S := T.presheaf.stalk (b w))
      ext a
      have s1 : (b.stalkMap w).hom (algebraMap Γ(T, V) (T.presheaf.stalk (b w)) a) =
          algebraMap Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V)
            ((Scheme.Hom.normalization g).presheaf.stalk w) ((b.app V).hom a) :=
        Scheme.Hom.germ_stalkMap_apply b V w hz a
      have s2 : θ ((b.app V).hom a) = ι a := by
        rw [hb]
        exact θ.apply_symm_apply (ι a)
      have s3 : κy (algebraMap Γ(T, V) (T.presheaf.stalk (b w)) a) =
          algebraMap Γ(T, V) (Localization.AtPrime P.asIdeal) a :=
        (IsLocalization.algEquiv P.asIdeal.primeCompl _ _).commutes a
      calc κx ((b.stalkMap w).hom (algebraMap Γ(T, V) (T.presheaf.stalk (b w)) a))
          = κx (algebraMap Γ(Scheme.Hom.normalization g, b ⁻¹ᵁ V)
            ((Scheme.Hom.normalization g).presheaf.stalk w) ((b.app V).hom a)) := by rw [s1]
        _ = algebraMap _ (Localization.AtPrime Q) (θ ((b.app V).hom a)) :=
          IsLocalization.ringEquivOfRingEquiv_eq _ _
        _ = algebraMap _ (Localization.AtPrime Q) (ι a) := by rw [s2]
        _ = Localization.localRingHom P.asIdeal Q ι hQ
            (algebraMap Γ(T, V) (Localization.AtPrime P.asIdeal) a) :=
          (Localization.localRingHom_to_map _ _ _ _ _).symm
        _ = Localization.localRingHom P.asIdeal Q ι hQ
            (κy (algebraMap Γ(T, V) (T.presheaf.stalk (b w)) a)) := by rw [s3]
    have hfun : ⇑(b.stalkMap w).hom =
        κx.symm ∘ (Localization.localRingHom P.asIdeal Q ι hQ) ∘ κy := by
      funext s
      have := RingHom.congr_fun hkey s
      simp only [RingHom.comp_apply] at this
      show _ = κx.symm (Localization.localRingHom P.asIdeal Q ι hQ (κy s))
      apply κx.injective
      rw [RingEquiv.apply_symm_apply]
      exact this
    have hbij' : Function.Bijective (b.stalkMap w).hom := by
      rw [hfun]
      exact κx.symm.bijective.comp (hbij.comp κy.bijective)
    exact (RingEquiv.ofBijective _ hbij').toCommRingCatIso.isIso_hom

