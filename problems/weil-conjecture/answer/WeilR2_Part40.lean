    IsIntegrallyClosed.of_equiv φ
  haveI hLhat : IsDomain (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime (hV.primeIdealOf xV).asIdeal))
      (Localization.AtPrime (hV.primeIdealOf xV).asIdeal)) :=
    core Γ(Z, V) hft (hV.primeIdealOf xV).asIdeal hLdom hLic
  obtain ⟨ψ⟩ := L2 _ _ φ
