theorem wcpa_dj_lsl_spread_identification : ∀ (S X P Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] (O : S.Opens) (b : S ⟶ P) (f : X ⟶ P) (u : Z ⟶ O.toScheme) (n : ℕ) (σ : Fin n → (P ⟶ X)) (τ : Fin n → (O.toScheme ⟶ Z)), IsProper f → IsProper u → (∀ i, σ i ≫ f = 𝟙 P) → (∀ i, τ i ≫ u = 𝟙 _) → ∀ (L : Type u) [Field L] (e : S.functionField ≃+* L) (γ : Spec (.of L) ⟶ O.toScheme), γ ≫ O.ι = Spec.map (CommRingCat.ofHom (e : S.functionField →+* L)) ≫ S.fromSpecStalk (genericPoint S) → ∀ (Y : Scheme.{u}) (π : Y ⟶ Spec (.of L)) (χ : Y ⟶ X) (ψ : Y ⟶ Z) (t : Fin n → (Spec (.of L) ⟶ Y)), IsPullback χ π f (γ ≫ O.ι ≫ b) → IsPullback ψ π u γ → (∀ i, t i ≫ π = 𝟙 _) → (∀ i, t i ≫ χ = (γ ≫ O.ι ≫ b) ≫ σ i) → (∀ i, t i ≫ ψ = γ ≫ τ i) → ∃ (Oo : S.Opens) (hOo : Oo ≤ O) (Yo : Scheme.{u}) (πo : Yo ⟶ Oo.toScheme) (χo : Yo ⟶ X) (ψo : Yo ⟶ Z) (so : Fin n → (Oo.toScheme ⟶ Yo)), Oo ≠ ⊥ ∧ IsPullback χo πo f (Oo.ι ≫ b) ∧ IsPullback ψo πo u (S.homOfLE hOo) ∧ (∀ i, so i ≫ πo = 𝟙 _) ∧ (∀ i, so i ≫ χo = (Oo.ι ≫ b) ≫ σ i) ∧ (∀ i, so i ≫ ψo = S.homOfLE hOo ≫ τ i) :=
by
  intro S X P Z _ O b f u n σ τ hf hu hσ hτ L _ e γ hγ Y π χ ψ t hχ hψ htπ htχ htψ

  haveI : Nonempty O.toScheme := ⟨γ (IsLocalRing.closedPoint L)⟩
  haveI : AlgebraicGeometry.IsIntegral O.toScheme := isIntegral_of_isOpenImmersion O.ι
  obtain ⟨γ', hγ', εO, hεO⟩ := (wcpa_dj_rzf_gen_transport O.toScheme S O.ι L).2
    (Spec.map (CommRingCat.ofHom (e : S.functionField →+* L)) ≫ S.fromSpecStalk (genericPoint S))
    ⟨e, rfl⟩
  have hγγ : γ' = γ := by rw [← cancel_mono O.ι, hγ', hγ]
  rw [hγγ] at hεO

  obtain ⟨A, pa, fA, hpbA⟩ : ∃ (A : Scheme.{u}) (pa : A ⟶ O.toScheme) (fA : A ⟶ X),
      IsPullback fA pa f (O.ι ≫ b) := ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  haveI : IsProper pa := MorphismProperty.of_isPullback (P := @IsProper) hpbA hf
  haveI := hu
  obtain ⟨sA, hsA1, hsA2⟩ : ∃ sA : Fin n → (O.toScheme ⟶ A), (∀ i, sA i ≫ pa = 𝟙 _) ∧
      (∀ i, sA i ≫ fA = (O.ι ≫ b) ≫ σ i) :=
    ⟨fun i => hpbA.lift ((O.ι ≫ b) ≫ σ i) (𝟙 _) (by simp [hσ]),
      fun i => hpbA.lift_snd _ _ _, fun i => hpbA.lift_fst _ _ _⟩
  obtain ⟨qA, hqA1, hqA2⟩ : ∃ qA : Y ⟶ A, qA ≫ fA = χ ∧ qA ≫ pa = π ≫ γ :=
    ⟨hpbA.lift χ (π ≫ γ) (by rw [hχ.w, Category.assoc]), hpbA.lift_fst _ _ _,
      hpbA.lift_snd _ _ _⟩
  have hqA : IsPullback qA π pa γ := by
    have hout : IsPullback (qA ≫ fA) π f (γ ≫ O.ι ≫ b) := by rw [hqA1]; exact hχ
    exact IsPullback.of_right hout hqA2 hpbA
  have htA : ∀ i, t i ≫ qA = γ ≫ sA i := by
    intro i
    apply hpbA.hom_ext
    · simp only [Category.assoc, hqA1, hsA2, htχ]
    · simp only [Category.assoc, hqA2, hsA1, Category.comp_id]
      rw [← Category.assoc, htπ i, Category.id_comp]

  obtain ⟨Ua, hUa, hUaL⟩ := wcpa_dj_lsi_generic_lfp O.toScheme A pa inferInstance inferInstance
  obtain ⟨Ub, hUb, hUbL⟩ := wcpa_dj_lsi_generic_lfp O.toScheme Z u inferInstance inferInstance

  obtain ⟨W, Φ, hW, hΦ, hΦs⟩ := wcpa_dj_lsi_spread_iso O.toScheme A Z pa u n sA τ
    inferInstance inferInstance inferInstance inferInstance Ua Ub hUa hUb hUaL hUbL hsA1 hτ L εO
    Y qA π ψ t (by rw [hεO]; exact hqA) (by rw [hεO]; exact hψ) htπ
    (by rw [hεO]; exact htA) (by rw [hεO]; exact htψ)

  have hOo : O.ι ''ᵁ W ≤ O := Scheme.Opens.ι_image_le O W
  have hOone : O.ι ''ᵁ W ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hW ⊢
    obtain ⟨x, hx⟩ := hW
    exact ⟨O.ι x, x, hx, rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : W.toScheme ≅ (O.ι ''ᵁ W).toScheme, E.hom ≫ (O.ι ''ᵁ W).ι = W.ι ≫ O.ι :=
    ⟨O.ι.isoImage W, Scheme.Hom.isoImage_hom_ι _ _⟩
  have hE2 : E.hom ≫ S.homOfLE hOo = W.ι := by
    rw [← cancel_mono O.ι, Category.assoc, Scheme.homOfLE_ι, hE]
  have hE' : E.inv ≫ W.ι ≫ O.ι = (O.ι ''ᵁ W).ι := by rw [← hE, Iso.inv_hom_id_assoc]
  have hE2' : E.inv ≫ W.ι = S.homOfLE hOo := by rw [← hE2, Iso.inv_hom_id_assoc]
  have hR : IsPullback (pa ∣_ W) (pa ⁻¹ᵁ W).ι W.ι pa := isPullback_morphismRestrict pa W
  obtain ⟨x, hx1, hx2⟩ : ∃ x : Fin n → (W.toScheme ⟶ (pa ⁻¹ᵁ W).toScheme),
      (∀ i, x i ≫ (pa ∣_ W) = 𝟙 _) ∧ (∀ i, x i ≫ (pa ⁻¹ᵁ W).ι = W.ι ≫ sA i) :=
    ⟨fun i => hR.lift (𝟙 _) (W.ι ≫ sA i)
        (by rw [Category.id_comp, Category.assoc, hsA1 i, Category.comp_id]),
      fun i => hR.lift_fst _ _ _, fun i => hR.lift_snd _ _ _⟩

  have hsq1 : IsPullback ((pa ⁻¹ᵁ W).ι ≫ fA) ((pa ∣_ W) ≫ E.hom) f ((O.ι ''ᵁ W).ι ≫ b) := by
    have h1 : IsPullback ((pa ⁻¹ᵁ W).ι ≫ fA) (pa ∣_ W) f (W.ι ≫ O.ι ≫ b) :=
      hR.flip.paste_horiz hpbA
    have h2 : IsPullback E.hom (W.ι ≫ O.ι ≫ b) ((O.ι ''ᵁ W).ι ≫ b) (𝟙 P) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id, ← Category.assoc, hE, Category.assoc]⟩
    have h3 := h1.flip.paste_horiz h2
    rw [Category.comp_id] at h3
    exact h3.flip

  have hsq2 : IsPullback Φ ((pa ∣_ W) ≫ E.hom) u (S.homOfLE hOo) := by
    have h2 : IsPullback E.hom W.ι (S.homOfLE hOo) (𝟙 O.toScheme) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id, hE2]⟩
    have h3 := hΦ.flip.paste_horiz h2
    rw [Category.comp_id] at h3
    exact h3.flip
  refine ⟨O.ι ''ᵁ W, hOo, (pa ⁻¹ᵁ W).toScheme, (pa ∣_ W) ≫ E.hom, (pa ⁻¹ᵁ W).ι ≫ fA, Φ,
    fun i => E.inv ≫ x i, hOone, hsq1, hsq2, ?_, ?_, ?_⟩
  · intro i
    rw [Category.assoc, ← Category.assoc (x i), hx1 i, Category.id_comp, Iso.inv_hom_id]
  · intro i
    simp only [Category.assoc]
    rw [reassoc_of% (hx2 i), hsA2 i]
    simp only [Category.assoc]
    rw [reassoc_of% hE']
  · intro i
    rw [Category.assoc, hΦs i (x i) (hx2 i), reassoc_of% hE2']

theorem wcpa_dj_lcp_spread_local : ∀ (k : Type u) [Field k] [Finite k] (X P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k))
    (f : X ⟶ P) (U : P.Opens) (n : ℕ) (σ : Fin n → (P ⟶ X)), wcpaDjSmIn k sP f U σ →
    ∀ (L : Type u) [Field L] [Algebra P.functionField L]
      (S₀ : Scheme.{u}) [AlgebraicGeometry.IsIntegral S₀] (sS₀ : S₀ ⟶ Spec (.of k))
      (β₀ : S₀ ⟶ P) (ε : S₀.functionField ≃+* L),
      β₀ ≫ sP = sS₀ → wcpaDjIsProjOver k sS₀ → IsProper β₀ →
      Spec.map (CommRingCat.ofHom (ε : S₀.functionField →+* L)) ≫
          S₀.fromSpecStalk (genericPoint S₀) ≫ β₀ =
        Spec.map (CommRingCat.ofHom (algebraMap P.functionField L)) ≫
          P.fromSpecStalk (genericPoint P) →
      ∀ V : ValuationSubring L, wcpaDjLocStable f σ L V →
    ∃ (SV : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral SV) (dV : SV ⟶ S₀)
      (cV : Spec (CommRingCat.of V) ⟶ SV) (OV : SV.Opens) (ZV : Scheme.{u})
      (uV : ZV ⟶ OV.toScheme) (τV : Fin n → (OV.toScheme ⟶ ZV)) (Oo : SV.Opens) (hOo : Oo ≤ OV)
      (Yo : Scheme.{u}) (πo : Yo ⟶ Oo.toScheme) (χo : Yo ⟶ X) (ψo : Yo ⟶ ZV)
      (so : Fin n → (Oo.toScheme ⟶ Yo)),
      wcpaDjIsProjOver k (dV ≫ sS₀) ∧ IsProper dV ∧
      (∃ V₀ : S₀.Opens, V₀ ≠ ⊥ ∧ IsIso (dV ∣_ V₀)) ∧
      Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ cV ≫ dV =
        Spec.map (CommRingCat.ofHom (ε : S₀.functionField →+* L)) ≫
          S₀.fromSpecStalk (genericPoint S₀) ∧
      Set.range ⇑cV ⊆ (OV : Set SV) ∧
      wcpaDjStablePtd uV n τV ∧ GeometricallyConnected uV ∧ Oo ≠ ⊥ ∧
      IsPullback χo πo f (Oo.ι ≫ dV ≫ β₀) ∧ IsPullback ψo πo uV (SV.homOfLE hOo) ∧
      (∀ i, so i ≫ πo = 𝟙 _) ∧ (∀ i, so i ≫ χo = (Oo.ι ≫ dV ≫ β₀) ≫ σ i) ∧
      (∀ i, so i ≫ ψo = SV.homOfLE hOo ≫ τV i) :=
by
  intro k _ _ X P _ _ sP f U n σ hin L _ _ S₀ _ sS₀ β₀ ε hβ₀ hS₀ hβ₀p hgen V hloc
  classical
  obtain ⟨Zv, uv, τv, Yv, χv, ψv, πv, tv, hst, hproj, hχ, hψ, htπ, htχ, htψ⟩ := hloc
  obtain ⟨hXproj, hPproj, hU, hsm, hgc, hn, hσ, hσd⟩ := hin

  have hpp : ∀ {Y : Scheme.{u}} (s : Y ⟶ Spec (.of k)), wcpaDjIsProjOver k s → IsProper s := by
    intro Y s hs
    obtain ⟨N, j, hj, rfl⟩ := hs
    haveI := hj
    haveI hst : IsScalarTower k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      IsScalarTower.of_algebraMap_eq
        (S := ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) (fun c => by
          rw [SetLike.GradeZero.algebraMap_apply]
          exact (SetLike.GradeZero.coe_algebraMap
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) c).symm)
    haveI : Algebra.FiniteType (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
        (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    haveI : IsProper (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra) := inferInstance
    have hkey : ∀ c : k, ((algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) : MvPolynomial (Fin (N + 1)) k) =
        MvPolynomial.C c := by
      intro c
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have hbij : Function.Bijective
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) := by
      constructor
      · intro a b hab
        have h1 := congrArg (fun x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) =>
          (x : MvPolynomial (Fin (N + 1)) k)) hab
        simp only [hkey] at h1
        exact MvPolynomial.C_injective _ _ h1
      · intro p
        have hp : (p : MvPolynomial (Fin (N + 1)) k).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
        have htd : (p : MvPolynomial (Fin (N + 1)) k).totalDegree = 0 :=
          Nat.le_zero.mp hp.totalDegree_le
        refine ⟨(p : MvPolynomial (Fin (N + 1)) k).coeff 0, Subtype.ext ?_⟩
        rw [hkey]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp htd).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    infer_instance

  obtain ⟨F, Z₀, u₀, τ₀, φ, hfl, hpr, hfp, hτ₀, hφ, hτφ⟩ :=
    wcpa_dj_lsl_descend_flat_model L V Zv uv n τv hst.1.1 hproj hst.2.1.1

  have hηU : genericPoint P ∈ U := by
    have hne := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    exact ((genericPoint_spec P).mem_open_set_iff U.isOpen).mpr (by simpa using hne)
  have ha' : (Spec.map (CommRingCat.ofHom (algebraMap P.functionField L)) ≫
      U.fromSpecStalkOfMem (genericPoint P) hηU) ≫ U.ι =
      Spec.map (CommRingCat.ofHom (algebraMap P.functionField L)) ≫
        P.fromSpecStalk (genericPoint P) := by
    rw [Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι]
  have hR : IsPullback (f ∣_ U) (f ⁻¹ᵁ U).ι U.ι f := isPullback_morphismRestrict f U
  have hwχ : (πv ≫ Spec.map (CommRingCat.ofHom (algebraMap P.functionField L)) ≫
      U.fromSpecStalkOfMem (genericPoint P) hηU) ≫ U.ι = χv ≫ f := by
    rw [Category.assoc, ha', hχ.w]
  have hχ''1 := hR.lift_fst _ _ hwχ
  have hχ''2 := hR.lift_snd _ _ hwχ
  have hD : IsPullback (hR.lift _ _ hwχ) πv (f ∣_ U)
      (Spec.map (CommRingCat.ofHom (algebraMap P.functionField L)) ≫
        U.fromSpecStalkOfMem (genericPoint P) hηU) := by
    have h1 : IsPullback (hR.lift _ _ hwχ ≫ (f ⁻¹ᵁ U).ι) πv f
        ((Spec.map (CommRingCat.ofHom (algebraMap P.functionField L)) ≫
          U.fromSpecStalkOfMem (genericPoint P) hηU) ≫ U.ι) := by
      rw [hχ''2, ha']; exact hχ
    exact IsPullback.of_right h1 hχ''1 hR.flip
  have hgcπ : GeometricallyConnected πv :=
    MorphismProperty.of_isPullback (P := @GeometricallyConnected) hD hgc

  have hfpv : LocallyOfFinitePresentation uv :=
    MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation) hφ hfp
  have hgcv : GeometricallyConnected uv :=
    wcpa_dj_lsl_gc_connected_base _ _ Zv Yv uv _ πv ψv hst.1 hfpv inferInstance inferInstance
      hψ hgcπ

  haveI hAnoeth : IsNoetherianRing (Subring.closure (F : Set V)) := by
    have h1 : (Algebra.adjoin ℤ (F : Set V)).FG := Subalgebra.fg_adjoin_finset F
    haveI : Algebra.FiniteType ℤ (Algebra.adjoin ℤ (F : Set V)) :=
      (Subalgebra.fg_iff_finiteType _).mp h1
    have h2 := Algebra.FiniteType.isNoetherianRing ℤ (Algebra.adjoin ℤ (F : Set V))
    rw [Algebra.adjoin_int] at h2
    exact h2
  obtain ⟨G, τG, hrange, hstG, hgcG, hτG⟩ :=
    wcpa_dj_lsl_stable_locus_open (Spec (.of ↥(Subring.closure (F : Set V)))) _ Z₀ Zv u₀ n τ₀
      _ uv φ τv hfl hpr hfp hτ₀ hφ hst.2.1.1 hτφ hst hgcv

  obtain ⟨SV, iSV, dV, εV, cV, D, cD, ρ, hdVproj, hdVp, hdViso, e1, e2, e3, e4⟩ :=
    wcpa_dj_lsl_centre_model k S₀ sS₀ hS₀ L ε V F
  haveI := iSV

  obtain ⟨OV, j, hj, hOVmem⟩ : ∃ (OV : SV.Opens) (j : OV.toScheme ⟶ (ρ ⁻¹ᵁ G).toScheme),
      j ≫ (ρ ⁻¹ᵁ G).ι ≫ D.ι = OV.ι ∧ ∀ x ∈ ρ ⁻¹ᵁ G, D.ι x ∈ OV :=
    ⟨D.ι ''ᵁ (ρ ⁻¹ᵁ G), (D.ι.isoImage _).inv, Scheme.Hom.isoImage_inv_ι _ _,
      fun x hx => ⟨x, hx, rfl⟩⟩
  obtain ⟨ρO, hρO⟩ : ∃ ρO : OV.toScheme ⟶ G.toScheme, ρO ≫ G.ι = j ≫ (ρ ⁻¹ᵁ G).ι ≫ ρ :=
    ⟨j ≫ (ρ ∣_ G), by rw [Category.assoc, morphismRestrict_ι]⟩
  have hcV : Set.range ⇑cV ⊆ (OV : Set SV) := by
    rintro _ ⟨v, rfl⟩
    have h1 : Spec.map (CommRingCat.ofHom (Subring.closure (F : Set V)).subtype) v ∈ G :=
      hrange ⟨v, rfl⟩
    rw [← e4, Scheme.Hom.comp_apply] at h1
    have h2 := hOVmem (cD v) ((Scheme.Hom.mem_preimage ρ).mpr h1)
    rw [← e3, Scheme.Hom.comp_apply]
    exact h2

  obtain ⟨τV, hstV, hτVs, hτVf⟩ := wcpa_dj_lcp_stableptd_basechange (u₀ ∣_ G) n τG ρO hstG
  have hgcV : GeometricallyConnected (Limits.pullback.snd (u₀ ∣_ G) ρO) :=
    MorphismProperty.of_isPullback (P := @GeometricallyConnected)
      (IsPullback.of_hasPullback _ _) hgcG

  have hγr : Set.range ⇑(Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ cV) ⊆
      Set.range ⇑OV.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact hcV ⟨_, rfl⟩
  have hγ := IsOpenImmersion.lift_fac OV.ι _ hγr
  have hγ' : IsOpenImmersion.lift OV.ι _ hγr ≫ OV.ι =
      Spec.map (CommRingCat.ofHom (εV : SV.functionField →+* L)) ≫
        SV.fromSpecStalk (genericPoint SV) := hγ.trans e2
  have hstar : IsOpenImmersion.lift OV.ι _ hγr ≫ ρO ≫ G.ι =
      Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫
        Spec.map (CommRingCat.ofHom (Subring.closure (F : Set V)).subtype) := by
    have h1 : IsOpenImmersion.lift OV.ι _ hγr ≫ j ≫ (ρ ⁻¹ᵁ G).ι =
        Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ cD := by
      rw [← cancel_mono D.ι]
      simp only [Category.assoc]
      rw [hj, hγ, ← e3]
    rw [hρO, reassoc_of% h1, e4]
  have hRG : IsPullback (u₀ ∣_ G) (u₀ ⁻¹ᵁ G).ι G.ι u₀ := isPullback_morphismRestrict u₀ G
  have hwψ : (πv ≫ IsOpenImmersion.lift OV.ι _ hγr ≫ ρO) ≫ G.ι = (ψv ≫ φ) ≫ u₀ := by
    simp only [Category.assoc]
    rw [hstar, hφ.w, reassoc_of% hψ.w]
  have hψ₁1 := hRG.lift_fst _ _ hwψ
  have hψ₁2 := hRG.lift_snd _ _ hwψ
  have hwψ' : hRG.lift _ _ hwψ ≫ (u₀ ∣_ G) = (πv ≫ IsOpenImmersion.lift OV.ι _ hγr) ≫ ρO :=
    hψ₁1.trans (Category.assoc _ _ _).symm
  have hψ'1 := Limits.pullback.lift_fst _ _ hwψ'
  have hψ'2 := Limits.pullback.lift_snd _ _ hwψ'
  have hψV : IsPullback (Limits.pullback.lift _ _ hwψ') πv (Limits.pullback.snd (u₀ ∣_ G) ρO)
      (IsOpenImmersion.lift OV.ι _ hγr) := by
    have hout : IsPullback (Limits.pullback.lift _ _ hwψ' ≫
        (Limits.pullback.fst (u₀ ∣_ G) ρO ≫ (u₀ ⁻¹ᵁ G).ι)) πv u₀
        (IsOpenImmersion.lift OV.ι _ hγr ≫ (ρO ≫ G.ι)) := by
      rw [hstar, reassoc_of% hψ'1, hψ₁2]
      exact hψ.paste_horiz hφ
    exact IsPullback.of_right hout hψ'2
      ((IsPullback.of_hasPullback (u₀ ∣_ G) ρO).paste_horiz hRG.flip)
  have hga : IsOpenImmersion.lift OV.ι _ hγr ≫ OV.ι ≫ dV ≫ β₀ =
      Spec.map (CommRingCat.ofHom (algebraMap P.functionField L)) ≫
        P.fromSpecStalk (genericPoint P) := by
    rw [reassoc_of% hγ', reassoc_of% e1, hgen]
  have hχV : IsPullback χv πv f (IsOpenImmersion.lift OV.ι _ hγr ≫ OV.ι ≫ dV ≫ β₀) := by
    rw [hga]; exact hχ
  have htχ' : ∀ i, tv i ≫ χv = (IsOpenImmersion.lift OV.ι _ hγr ≫ OV.ι ≫ dV ≫ β₀) ≫ σ i := by
    intro i; rw [hga]; exact htχ i
  have htψ' : ∀ i, tv i ≫ Limits.pullback.lift _ _ hwψ' =
      IsOpenImmersion.lift OV.ι _ hγr ≫ τV i := by
    intro i
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hψ'1, hτVf i, ← cancel_mono (u₀ ⁻¹ᵁ G).ι]
      simp only [Category.assoc]
      rw [hψ₁2, hτG i, reassoc_of% htψ, hτφ i, reassoc_of% hstar]
    · simp only [Category.assoc]
      rw [hψ'2, hτVs i, reassoc_of% htπ, Category.comp_id]

  haveI : IsProper sP := hpp sP hPproj
  haveI : IsProper (f ≫ sP) := hpp (f ≫ sP) hXproj
  have hfprop : IsProper f := IsProper.of_comp f sP
  obtain ⟨Oo, hOo, Yo, πo, χo, ψo, so, hOone, h1, h2, h3, h4, h5⟩ :=
    wcpa_dj_lsl_spread_identification SV X P _ OV (dV ≫ β₀) f
      (Limits.pullback.snd (u₀ ∣_ G) ρO) n σ τV hfprop hstV.1.2.1 hσ hτVs L εV
      (IsOpenImmersion.lift OV.ι _ hγr) hγ' Yv πv χv _ tv hχV hψV htπ htχ' htψ'

  refine ⟨SV, iSV, dV, cV, OV, _, Limits.pullback.snd (u₀ ∣_ G) ρO, τV, Oo, hOo, Yo, πo, χo, ψo,
    so, hdVproj, hdVp, hdViso, ?_, hcV, hstV, hgcV, hOone, h1, h2, h3, h4, h5⟩
  rw [reassoc_of% e2, e1]

theorem wcpa_dj_rzf_valuative_point : ∀ (S : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] (L : Type u) [Field L] (εS : S.functionField ≃+* L) (x : S), ∃ (W : ValuationSubring L) (w : Spec (CommRingCat.of W) ⟶ S), w (IsLocalRing.closedPoint ↑(CommRingCat.of W)) = x ∧ Spec.map (CommRingCat.ofHom (algebraMap W L)) ≫ w = Spec.map (CommRingCat.ofHom (εS : S.functionField →+* L)) ≫ S.fromSpecStalk (genericPoint S) :=
by
  intro S _ L _ εS x
  have dom_val : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (φ : R →+* L),
      ∃ (W : ValuationSubring L) (ψ : R →+* W), IsLocalHom ψ ∧ (algebraMap W L).comp ψ = φ := by
    intro R _ _ φ
    set A : LocalSubring L := LocalSubring.range φ with hA
    have hcar : (A.toSubring : Set L) = Set.range φ := rfl
    have hmem : ∀ r, φ r ∈ A.toSubring := by
      intro r
      rw [← SetLike.mem_coe, hcar]
      exact ⟨r, rfl⟩
    obtain ⟨B, hAB⟩ := LocalSubring.exists_le_valuationSubring A
    obtain ⟨h, hloc⟩ := LocalSubring.le_def.mp hAB
    let φ' : R →+* A.toSubring := φ.codRestrict A.toSubring hmem
    have hsurj : Function.Surjective φ' := by
      rintro ⟨y, hy⟩
      rw [← SetLike.mem_coe, hcar] at hy
      obtain ⟨r, rfl⟩ := hy
      exact ⟨r, rfl⟩
    have : IsLocalHom φ' := IsLocalHom.of_surjective φ' hsurj
    refine ⟨B, (Subring.inclusion h).comp φ', ?_, ?_⟩
    · exact @RingHom.isLocalHom_comp _ _ _ _ _ _ (Subring.inclusion h) φ' hloc this
    · ext r
      rfl
  have hsp : genericPoint S ⤳ x := (genericPoint_spec S).specializes (Set.mem_univ x)
  set sp := S.presheaf.stalkSpecializes hsp with hspdef
  set φ : (S.presheaf.stalk x) →+* L := (εS : S.functionField →+* L).comp sp.hom with hφ
  obtain ⟨W, ψ, hψloc, hψφ⟩ := dom_val (S.presheaf.stalk x) φ
  refine ⟨W, Spec.map (CommRingCat.ofHom ψ) ≫ S.fromSpecStalk x, ?_, ?_⟩
  · have h1 : (Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint ↑(CommRingCat.of W)) =
        IsLocalRing.closedPoint (S.presheaf.stalk x) :=
      IsLocalRing.comap_closedPoint ψ
    exact (congrArg (S.fromSpecStalk x) h1).trans Scheme.fromSpecStalk_closedPoint
  · rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hψφ, hφ,
      CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, CommRingCat.ofHom_hom,
      Scheme.SpecMap_stalkSpecializes_fromSpecStalk]

theorem wcpa_dj_rzf_compactness : ∀ (L : Type u) [Field L] (F : ValuationSubring L → Finset L), (∀ V, ∀ x ∈ F V, x ∈ V) → ∃ (r : ℕ) (Vs : Fin r → ValuationSubring L), ∀ W : ValuationSubring L, ∃ j, ∀ x ∈ F (Vs j), x ∈ W :=
by
  intro L _ F hF
  classical
  let S : Set (L → Bool) := {χ | χ 0 = true ∧ χ 1 = true ∧
    (∀ x y : L, χ x = true → χ y = true → χ (x + y) = true) ∧
    (∀ x y : L, χ x = true → χ y = true → χ (x * y) = true) ∧
    (∀ x : L, χ x = true → χ (-x) = true) ∧ (∀ x : L, χ x = true ∨ χ x⁻¹ = true)}
  have hclosed : IsClosed S := by
    have e : S = ((fun χ : L → Bool => χ 0) ⁻¹' {true}) ∩ ((fun χ : L → Bool => χ 1) ⁻¹' {true}) ∩
        (⋂ x : L, ⋂ y : L, (fun χ : L → Bool => (χ x, χ y, χ (x + y))) ⁻¹'
          {t : Bool × Bool × Bool | t.1 = true → t.2.1 = true → t.2.2 = true}) ∩
        (⋂ x : L, ⋂ y : L, (fun χ : L → Bool => (χ x, χ y, χ (x * y))) ⁻¹'
          {t : Bool × Bool × Bool | t.1 = true → t.2.1 = true → t.2.2 = true}) ∩
        (⋂ x : L, (fun χ : L → Bool => (χ x, χ (-x))) ⁻¹'
          {t : Bool × Bool | t.1 = true → t.2 = true}) ∩
        (⋂ x : L, (fun χ : L → Bool => (χ x, χ x⁻¹)) ⁻¹'
          {t : Bool × Bool | t.1 = true ∨ t.2 = true}) := by
      ext χ
      simp only [S, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff,
        Set.mem_iInter, and_assoc]
    rw [e]
    refine (((((?_ : IsClosed _).inter ?_).inter ?_).inter ?_).inter ?_).inter ?_
    · exact (isClosed_discrete _).preimage (continuous_apply 0)
    · exact (isClosed_discrete _).preimage (continuous_apply 1)
    · exact isClosed_iInter fun x => isClosed_iInter fun y => (isClosed_discrete _).preimage
        ((continuous_apply x).prodMk ((continuous_apply y).prodMk (continuous_apply (x + y))))
    · exact isClosed_iInter fun x => isClosed_iInter fun y => (isClosed_discrete _).preimage
        ((continuous_apply x).prodMk ((continuous_apply y).prodMk (continuous_apply (x * y))))
    · exact isClosed_iInter fun x => (isClosed_discrete _).preimage
        ((continuous_apply x).prodMk (continuous_apply (-x)))
    · exact isClosed_iInter fun x => (isClosed_discrete _).preimage
        ((continuous_apply x).prodMk (continuous_apply x⁻¹))
  let U : ValuationSubring L → Set (L → Bool) := fun V => {χ | ∀ x ∈ F V, χ x = true}
  have hopen : ∀ V, IsOpen (U V) := by
    intro V
    have e : U V = ⋂ x ∈ F V, (fun χ : L → Bool => χ x) ⁻¹' {true} := by
      ext χ
      simp [U]
    rw [e]
    exact isOpen_biInter_finset fun x _ => (isOpen_discrete _).preimage (continuous_apply x)
  have hcov : S ⊆ ⋃ V, U V := by
    rintro χ ⟨h0, h1, hadd, hmul, hneg, hinv⟩
    let R : Subring L :=
      { carrier := {x | χ x = true}
        zero_mem' := h0
        one_mem' := h1
        add_mem' := fun {a b} ha hb => hadd a b ha hb
        mul_mem' := fun {a b} ha hb => hmul a b ha hb
        neg_mem' := fun {a} ha => hneg a ha }
    let W : ValuationSubring L := ValuationSubring.ofSubring R hinv
    exact Set.mem_iUnion.mpr ⟨W, show ∀ x ∈ F W, χ x = true from fun x hx => hF W x hx⟩
  obtain ⟨t, ht⟩ := hclosed.isCompact.elim_finite_subcover U hopen hcov
  refine ⟨t.card, fun j => (t.equivFin.symm j : ValuationSubring L), ?_⟩
  intro W
  have hW : (fun x => decide (x ∈ W)) ∈ S := by
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp only [decide_eq_true_eq]
    · exact W.zero_mem
    · exact W.one_mem
    · intro x y hx hy; exact add_mem hx hy
    · intro x y hx hy; exact mul_mem hx hy
    · intro x hx; exact neg_mem hx
    · intro x; exact W.mem_or_inv_mem x
  obtain ⟨V, hVt, hV⟩ := Set.mem_iUnion₂.mp (ht hW)
  refine ⟨t.equivFin ⟨V, hVt⟩, ?_⟩
  intro x hx
  simp only [Equiv.symm_apply_apply] at hx
  have h := hV x hx
  simpa using h

theorem wcpa_dj_rzf_chart_finset : ∀ (k : Type u) [Field k] [Finite k] (T : Scheme.{u}) (sT : T ⟶ Spec (.of k)), LocallyOfFiniteType sT → ∀ (L : Type u) [Field L] (V : ValuationSubring L) (c : Spec (CommRingCat.of V) ⟶ T) (O : T.Opens), Set.range c ⊆ (O : Set T) → ∃ F : Finset L, (∀ x ∈ F, x ∈ V) ∧ ∀ W : ValuationSubring L, (∀ x ∈ F, x ∈ W) → ∃ cW : Spec (CommRingCat.of W) ⟶ T, Set.range cW ⊆ (O : Set T) ∧ Spec.map (CommRingCat.ofHom (algebraMap W L)) ≫ cW = Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ c :=
by
  intro k _ _ T sT hsT L _ V c O hcO
  classical

  obtain ⟨A, hA, hxA, hAO⟩ :=
    exists_isAffineOpen_mem_and_subset (hcO ⟨IsLocalRing.closedPoint (CommRingCat.of V), rfl⟩)
  have hcA : Set.range c ⊆ Set.range A.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨p, rfl⟩
    have h1 : p ⤳ IsLocalRing.closedPoint (CommRingCat.of V) := IsLocalRing.specializes_closedPoint p
    exact (h1.map c.continuous).mem_open A.isOpen hxA
  let c' : Spec (CommRingCat.of V) ⟶ A.toScheme := IsOpenImmersion.lift A.ι c hcA
  have hc' : c' ≫ A.ι = c := IsOpenImmersion.lift_fac _ _ _
  let φ : Γ(T, A) ⟶ CommRingCat.of V := Spec.preimage (c' ≫ hA.isoSpec.hom)
  have hφ : Spec.map φ ≫ hA.fromSpec = c := by
    rw [Spec.map_preimage, ← IsAffineOpen.isoSpec_inv_ι, Category.assoc, Iso.hom_inv_id_assoc, hc']

  have hft : (sT.appLE ⊤ A le_top).hom.FiniteType :=
    HasRingHomProperty.appLE @LocallyOfFiniteType sT hsT ⟨⊤, isAffineOpen_top _⟩ ⟨A, hA⟩ le_top
  obtain ⟨G, hG⟩ : ∃ G : Finset Γ(T, A), Subring.closure (G : Set Γ(T, A)) = ⊤ := by
    letI := (sT.appLE ⊤ A le_top).hom.toAlgebra
    obtain ⟨s, hs⟩ := hft.out
    haveI : Finite Γ(Spec (CommRingCat.of k), ⊤) :=
      Finite.of_equiv k (Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv.symm.toEquiv
    have hfin : (Set.range (sT.appLE ⊤ A le_top).hom).Finite := Set.finite_range _
    refine ⟨hfin.toFinset ∪ s, ?_⟩
    have h1 := Algebra.adjoin_eq_ring_closure (R := Γ(Spec (CommRingCat.of k), ⊤)) (A := Γ(T, A))
      (s : Set Γ(T, A))
    rw [hs, Algebra.top_toSubring] at h1
    rw [Finset.coe_union, Set.Finite.coe_toFinset]
    exact h1.symm

  let ψ : Γ(T, A) →+* L := (algebraMap V L).comp φ.hom
  refine ⟨G.image ψ, ?_, ?_⟩
  · intro x hx
    obtain ⟨g, _, rfl⟩ := Finset.mem_image.mp hx
    exact (φ.hom g).2
  · intro W hW
    have hψW : ∀ y, ψ y ∈ W := by
      have h1 : Subring.closure (G : Set Γ(T, A)) ≤ W.toSubring.comap ψ := by
        rw [Subring.closure_le]
        intro g hg
        exact hW _ (Finset.mem_image_of_mem ψ hg)
      intro y
      have hy : y ∈ Subring.closure (G : Set Γ(T, A)) := by rw [hG]; trivial
      exact h1 hy
    let ψW : Γ(T, A) →+* W := ψ.codRestrict W hψW
    refine ⟨Spec.map (CommRingCat.ofHom ψW) ≫ hA.fromSpec, ?_, ?_⟩
    · rintro _ ⟨p, rfl⟩
      have hmem : (Spec.map (CommRingCat.ofHom ψW) ≫ hA.fromSpec) p ∈ Set.range hA.fromSpec := by
        rw [Scheme.Hom.comp_apply]; exact ⟨_, rfl⟩
      rw [hA.range_fromSpec] at hmem
      exact hAO hmem
    · rw [← hφ, ← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp]
      congr 1

theorem wcpa_dj_rzf_join : ∀ (k : Type u) [Field k] (S₀ A B : Scheme.{u}) [AlgebraicGeometry.IsIntegral S₀] [AlgebraicGeometry.IsIntegral A] [AlgebraicGeometry.IsIntegral B] (sS₀ : S₀ ⟶ Spec (.of k)) (tA : A ⟶ S₀) (tB : B ⟶ S₀) (L : Type u) [Field L] (gA : Spec (.of L) ⟶ A) (gB : Spec (.of L) ⟶ B), wcpaDjIsProjOver k sS₀ → wcpaDjIsProjOver k (tA ≫ sS₀) → wcpaDjIsProjOver k (tB ≫ sS₀) → (∃ V : S₀.Opens, V ≠ ⊥ ∧ IsIso (tA ∣_ V)) → (∃ V : S₀.Opens, V ≠ ⊥ ∧ IsIso (tB ∣_ V)) → gA ≫ tA = gB ≫ tB → (∃ εA : A.functionField ≃+* L, Spec.map (CommRingCat.ofHom (εA : A.functionField →+* L)) ≫ A.fromSpecStalk (genericPoint A) = gA) → ∃ (C : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral C) (a : C ⟶ A) (b : C ⟶ B) (gC : Spec (.of L) ⟶ C), (∃ εC : C.functionField ≃+* L, Spec.map (CommRingCat.ofHom (εC : C.functionField →+* L)) ≫ C.fromSpecStalk (genericPoint C) = gC) ∧ a ≫ tA = b ≫ tB ∧ wcpaDjIsProjOver k ((a ≫ tA) ≫ sS₀) ∧ (∃ V : S₀.Opens, V ≠ ⊥ ∧ IsIso ((a ≫ tA) ∣_ V)) ∧ gC ≫ a = gA ∧ gC ≫ b = gB :=
by
  intro k _ S₀ A B _ _ _ sS₀ tA tB L _ gA gB hS₀ hA hB hBirA hBirB hg hGenA
  classical
  obtain ⟨VA, hVA, hVAiso⟩ := hBirA
  obtain ⟨VB, hVB, hVBiso⟩ := hBirB

  have shrink : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (V W : Y.Opens), V ≤ W → IsIso (f ∣_ W) →
      IsIso (f ∣_ V) := by
    intro X Y f V W hVW hW
    have hle : f ⁻¹ᵁ V ≤ f ⁻¹ᵁ W := fun x hx => hVW hx
    have h1 : IsPullback (X.homOfLE hle ≫ (f ⁻¹ᵁ W).ι) (f ∣_ V) f (Y.homOfLE hVW ≫ W.ι) := by
      rw [Scheme.homOfLE_ι, Scheme.homOfLE_ι]
      exact (isPullback_morphismRestrict f V).flip
    have h2 : X.homOfLE hle ≫ (f ∣_ W) = (f ∣_ V) ≫ Y.homOfLE hVW := by
      rw [← cancel_mono W.ι, Category.assoc, Category.assoc, morphismRestrict_ι f W,
        Scheme.homOfLE_ι, ← Category.assoc, Scheme.homOfLE_ι, morphismRestrict_ι]
    have hsq : IsPullback (X.homOfLE hle) (f ∣_ V) (f ∣_ W) (Y.homOfLE hVW) :=
      IsPullback.of_right h1 h2 (isPullback_morphismRestrict f W).flip
    exact hsq.isIso_snd_of_isIso

  haveI hsS₀p : IsProper sS₀ := wcpa_dj_proj_proper k sS₀ hS₀
  haveI hAp : IsProper (tA ≫ sS₀) := wcpa_dj_proj_proper k _ hA
  haveI hBp : IsProper (tB ≫ sS₀) := wcpa_dj_proj_proper k _ hB
  haveI htAp : IsProper tA := IsProper.of_comp tA sS₀
  haveI htBp : IsProper tB := IsProper.of_comp tB sS₀

  obtain ⟨V, hVdef⟩ : ∃ V : S₀.Opens, V = VA ⊓ VB := ⟨_, rfl⟩
  have hV : V ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hVA hVB ⊢
    rw [hVdef, TopologicalSpace.Opens.coe_inf]
    exact nonempty_preirreducible_inter VA.isOpen VB.isOpen hVA hVB
  haveI hVAi : IsIso (tA ∣_ V) := shrink tA V VA (hVdef ▸ inf_le_left) hVAiso
  haveI hVBi : IsIso (tB ∣_ V) := shrink tB V VB (hVdef ▸ inf_le_right) hVBiso
  haveI hUAne : Nonempty (tA ⁻¹ᵁ V).toScheme := by
    obtain ⟨v, hv⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV
    obtain ⟨y, -⟩ := (tA ∣_ V).surjective ⟨v, hv⟩
    exact ⟨y⟩
  haveI hUAint : AlgebraicGeometry.IsIntegral (tA ⁻¹ᵁ V).toScheme :=
    isIntegral_of_isOpenImmersion (tA ⁻¹ᵁ V).ι

  obtain ⟨β, hβ⟩ : ∃ β : (tA ⁻¹ᵁ V).toScheme ⟶ B,
      β = (tA ∣_ V) ≫ inv (tB ∣_ V) ≫ (tB ⁻¹ᵁ V).ι := ⟨_, rfl⟩
  have hw : (tA ⁻¹ᵁ V).ι ≫ tA = β ≫ tB := by
    rw [hβ, Category.assoc, Category.assoc, ← morphismRestrict_ι tB V, IsIso.inv_hom_id_assoc,
      morphismRestrict_ι]
  obtain ⟨γ, hγ1, hγ2⟩ : ∃ γ : (tA ⁻¹ᵁ V).toScheme ⟶ Limits.pullback tA tB,
      γ ≫ Limits.pullback.fst tA tB = (tA ⁻¹ᵁ V).ι ∧ γ ≫ Limits.pullback.snd tA tB = β :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  haveI : IsSeparated (Limits.pullback.snd tA tB ≫ tB ≫ sS₀) := inferInstance
  haveI := quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd tA tB ≫ tB ≫ sS₀)
  haveI : CompactSpace A := QuasiCompact.compactSpace_of_compactSpace (tA ≫ sS₀)
  haveI : IsLocallyNoetherian A := LocallyOfFiniteType.isLocallyNoetherian (tA ≫ sS₀)
  haveI : AlgebraicGeometry.IsNoetherian A := AlgebraicGeometry.IsNoetherian.mk
  haveI : CompactSpace (tA ⁻¹ᵁ V).toScheme :=
    isCompact_iff_compactSpace.mp
      (TopologicalSpace.NoetherianSpace.isCompact ((tA ⁻¹ᵁ V : A.Opens) : Set A))
  haveI hQC : QuasiCompact γ := quasiCompact_of_compactSpace γ

  haveI hint : AlgebraicGeometry.IsIntegral (Scheme.Hom.image γ) :=
    wcpa_dj_gc_image_integral _ _ γ hQC
  obtain ⟨a, ha⟩ : ∃ a : Scheme.Hom.image γ ⟶ A,
      a = Scheme.Hom.imageι γ ≫ Limits.pullback.fst tA tB := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b : Scheme.Hom.image γ ⟶ B,
      b = Scheme.Hom.imageι γ ≫ Limits.pullback.snd tA tB := ⟨_, rfl⟩
  have hsq : a ≫ tA = b ≫ tB := by
    rw [ha, hb, Category.assoc, Category.assoc, Limits.pullback.condition]

  have hproj : wcpaDjIsProjOver k ((a ≫ tA) ≫ sS₀) := by
    have := wcpa_dj_ssm_proj_fibre_product k A S₀ B (Scheme.Hom.image γ) sS₀ tA tB
      (Scheme.Hom.imageι γ) inferInstance hA hB inferInstance
    rw [hsq, hb]
    simpa only [Category.assoc] using this

  have hUeq : a ⁻¹ᵁ (tA ⁻¹ᵁ V) =
      (Scheme.Hom.imageι γ ≫ Limits.pullback.fst tA tB) ⁻¹ᵁ (tA ⁻¹ᵁ V) := by rw [ha]
  obtain ⟨t, ht_iso, ht⟩ := wcpa_dj_gc_image_open_iso _ _ _ γ (Limits.pullback.fst tA tB)
    (tA ⁻¹ᵁ V) (a ⁻¹ᵁ (tA ⁻¹ᵁ V)) (𝟙 _) hQC inferInstance inferInstance hUeq
    (by rw [Category.id_comp, hγ1]) inferInstance
  haveI := ht_iso
  have hta : t ≫ (a ∣_ (tA ⁻¹ᵁ V)) = 𝟙 _ := by
    rw [← cancel_mono (tA ⁻¹ᵁ V).ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, ht, ha,
      ← Category.assoc, Scheme.Hom.toImage_imageι, hγ1, Category.id_comp]
  haveI haIso : IsIso (a ∣_ (tA ⁻¹ᵁ V)) := by
    have e : a ∣_ (tA ⁻¹ᵁ V) = inv t := by
      rw [← cancel_epi t, hta, IsIso.hom_inv_id]
    rw [e]; infer_instance

  have hbir : IsIso ((a ≫ tA) ∣_ V) := by
    rw [morphismRestrict_comp]; exact @IsIso.comp_isIso _ _ _ _ _ _ _ haIso hVAi

  obtain ⟨gU, hgU, hgenU⟩ :=
    (wcpa_dj_rzf_gen_transport (tA ⁻¹ᵁ V).toScheme A (tA ⁻¹ᵁ V).ι L).2 gA hGenA
  haveI : IsOpenImmersion (t ≫ (a ⁻¹ᵁ (tA ⁻¹ᵁ V)).ι) := inferInstance
  obtain ⟨εC, hεC⟩ := (wcpa_dj_rzf_gen_transport (tA ⁻¹ᵁ V).toScheme (Scheme.Hom.image γ)
    (t ≫ (a ⁻¹ᵁ (tA ⁻¹ᵁ V)).ι) L).1 gU hgenU
  rw [ht] at hεC
  refine ⟨Scheme.Hom.image γ, hint, a, b, gU ≫ Scheme.Hom.toImage γ, ⟨εC, hεC⟩, hsq, hproj,
    ⟨V, hV, hbir⟩, ?_, ?_⟩
  ·
    rw [ha, Category.assoc, ← Category.assoc (Scheme.Hom.toImage γ), Scheme.Hom.toImage_imageι,
      hγ1, hgU]
  ·
    rw [hb, Category.assoc, ← Category.assoc (Scheme.Hom.toImage γ), Scheme.Hom.toImage_imageι,
      hγ2]
    have hrange : Set.range gB ⊆ Set.range (tB ⁻¹ᵁ V).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have h1 : (tA ⁻¹ᵁ V).ι (gU x) ∈ tA ⁻¹ᵁ V := by
        show _ ∈ ((tA ⁻¹ᵁ V : A.Opens) : Set A)
        rw [← Scheme.Opens.range_ι]; exact Set.mem_range_self _
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, ← hg, ← hgU,
        Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      exact h1
    obtain ⟨gB', hgB'⟩ : ∃ gB' : Spec (.of L) ⟶ (tB ⁻¹ᵁ V).toScheme, gB' ≫ (tB ⁻¹ᵁ V).ι = gB :=
      ⟨IsOpenImmersion.lift (tB ⁻¹ᵁ V).ι gB hrange, IsOpenImmersion.lift_fac _ _ _⟩
    have h3 : gB' ≫ (tB ∣_ V) = gU ≫ (tA ∣_ V) := by
      rw [← cancel_mono V.ι, Category.assoc, Category.assoc, morphismRestrict_ι, morphismRestrict_ι,
        ← Category.assoc, ← Category.assoc, hgB', hgU, hg]
    have h4 : gB' = gU ≫ (tA ∣_ V) ≫ inv (tB ∣_ V) := by
      rw [← Category.assoc, IsIso.eq_comp_inv]; exact h3
    rw [hβ, ← hgB', h4]
    simp only [Category.assoc]

theorem wcpa_dj_rzf_multi_join : ∀ (k : Type u) [Field k] (S₀ : Scheme.{u}) [AlgebraicGeometry.IsIntegral S₀] (sS₀ : S₀ ⟶ Spec (.of k)), wcpaDjIsProjOver k sS₀ → ∀ (L : Type u) [Field L] (g₀ : Spec (.of L) ⟶ S₀), (∃ ε₀ : S₀.functionField ≃+* L, Spec.map (CommRingCat.ofHom (ε₀ : S₀.functionField →+* L)) ≫ S₀.fromSpecStalk (genericPoint S₀) = g₀) → ∀ (r : ℕ) (T : Fin r → Scheme.{u}) [∀ j, AlgebraicGeometry.IsIntegral (T j)] (t : ∀ j, T j ⟶ S₀) (g : ∀ j, Spec (.of L) ⟶ T j), (∀ j, wcpaDjIsProjOver k (t j ≫ sS₀)) → (∀ j, ∃ V : S₀.Opens, V ≠ ⊥ ∧ IsIso (t j ∣_ V)) → (∀ j, g j ≫ t j = g₀) → ∃ (R : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral R) (ρ : R ⟶ S₀) (a : ∀ j, R ⟶ T j) (gR : Spec (.of L) ⟶ R), (∃ εR : R.functionField ≃+* L, Spec.map (CommRingCat.ofHom (εR : R.functionField →+* L)) ≫ R.fromSpecStalk (genericPoint R) = gR) ∧ wcpaDjIsProjOver k (ρ ≫ sS₀) ∧ (∃ V : S₀.Opens, V ≠ ⊥ ∧ IsIso (ρ ∣_ V)) ∧ gR ≫ ρ = g₀ ∧ (∀ j, a j ≫ t j = ρ) ∧ (∀ j, gR ≫ a j = g j) :=
by
  intro k _ S₀ _ sS₀ hS₀ L _ g₀ hg₀ r
  induction r with
  | zero =>
    intro T _ t g _ _ _
    refine ⟨S₀, inferInstance, 𝟙 S₀, fun j => j.elim0, g₀, hg₀,
      by rw [Category.id_comp]; exact hS₀, ⟨⊤, ?_, inferInstance⟩, Category.comp_id _,
      fun j => j.elim0, fun j => j.elim0⟩
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    obtain ⟨x⟩ := (inferInstance : Nonempty S₀)
    exact ⟨x, trivial⟩
  | succ r ih =>
    intro T iT t g hT hB hg
    obtain ⟨R', iR', ρ', a', gR', hGen', hproj', hbir', hgρ', ha', hga'⟩ :=
      @ih (fun i => T i.castSucc) (fun i => iT i.castSucc) (fun i => t i.castSucc)
        (fun i => g i.castSucc) (fun i => hT i.castSucc) (fun i => hB i.castSucc)
        (fun i => hg i.castSucc)
    haveI := iR'
    obtain ⟨C, iC, a, b, gC, hGenC, hsq, hprojC, hbirC, hga, hgb⟩ :=
      wcpa_dj_rzf_join k S₀ R' (T (Fin.last r)) sS₀ ρ' (t (Fin.last r)) L gR' (g (Fin.last r))
        hS₀ hproj' (hT _) hbir' (hB _) (hgρ'.trans (hg _).symm) hGen'
    haveI := iC
    refine ⟨C, iC, a ≫ ρ',
      fun j => Fin.lastCases (motive := fun j => C ⟶ T j) b (fun i => a ≫ a' i) j, gC,
      hGenC, hprojC, hbirC, ?_, ?_, ?_⟩
    · rw [← Category.assoc, hga, hgρ']
    · intro j
      induction j using Fin.lastCases with
      | last => simp only [Fin.lastCases_last]; exact hsq.symm
      | cast i => simp only [Fin.lastCases_castSucc]; rw [Category.assoc, ha' i]
    · intro j
      induction j using Fin.lastCases with
      | last => simp only [Fin.lastCases_last]; exact hgb
      | cast i => simp only [Fin.lastCases_castSucc]; rw [← Category.assoc, hga, hga' i]

theorem wcpa_dj_lcp_rz_finite_model : ∀ (k : Type u) [Field k] [Finite k] (S₀ : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S₀] (sS₀ : S₀ ⟶ Spec (.of k)), wcpaDjIsProjOver k sS₀ →
    ∀ (L : Type u) [Field L] (ε : S₀.functionField ≃+* L)
      (SV : ValuationSubring L → Scheme.{u}) [∀ V, AlgebraicGeometry.IsIntegral (SV V)]
      (dV : ∀ V, SV V ⟶ S₀) (cV : ∀ V : ValuationSubring L, Spec (CommRingCat.of V) ⟶ SV V)
      (OV : ∀ V, (SV V).Opens),
      (∀ V, wcpaDjIsProjOver k (dV V ≫ sS₀)) → (∀ V, IsProper (dV V)) →
      (∀ V, ∃ V₀ : S₀.Opens, V₀ ≠ ⊥ ∧ IsIso (dV V ∣_ V₀)) →
      (∀ V : ValuationSubring L, Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ cV V ≫ dV V =
        Spec.map (CommRingCat.ofHom (ε : S₀.functionField →+* L)) ≫
          S₀.fromSpecStalk (genericPoint S₀)) →
      (∀ V, Set.range ⇑(cV V) ⊆ (OV V : Set (SV V))) →
    ∃ (r : ℕ) (Vs : Fin r → ValuationSubring L) (S : Scheme.{u})
      (_ : AlgebraicGeometry.IsIntegral S) (d : S ⟶ S₀) (e : ∀ j, S ⟶ SV (Vs j)),
      (∀ x : S, IsIntegrallyClosed (S.presheaf.stalk x)) ∧ wcpaDjIsProjOver k (d ≫ sS₀) ∧
      IsProper d ∧ Surjective d ∧ (∃ V₀ : S₀.Opens, V₀ ≠ ⊥ ∧ IsFinite (d ∣_ V₀)) ∧
      (∀ j, e j ≫ dV (Vs j) = d) ∧
      (∀ j (O : (SV (Vs j)).Opens), O ≠ ⊥ → e j ⁻¹ᵁ O ≠ ⊥) ∧
      (⨆ j, e j ⁻¹ᵁ OV (Vs j)) = ⊤ :=
by
  intro k _ _ S₀ _ sS₀ hS₀ L _ ε SV _ dV cV OV hdVproj _hdVp hdViso hcen hrange
  classical

  obtain ⟨pt⟩ : Nonempty ↥(Spec (CommRingCat.of L)) := ⟨IsLocalRing.closedPoint L⟩
  have genpt : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] (εX : X.functionField ≃+* L),
      (Spec.map (CommRingCat.ofHom (εX : X.functionField →+* L)) ≫
        X.fromSpecStalk (genericPoint X)) pt = genericPoint X := by
    intro X _ εX
    have h1 : (Spec.map (CommRingCat.ofHom (εX : X.functionField →+* L))) pt =
        IsLocalRing.closedPoint ↑(X.presheaf.stalk (genericPoint X)) :=
      Subsingleton.elim (α := PrimeSpectrum X.functionField) _ _
    rw [Scheme.Hom.comp_apply]
    exact (congrArg (X.fromSpecStalk (genericPoint X)) h1).trans Scheme.fromSpecStalk_closedPoint

  have s7 : ∀ (X Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral Y]
      (f : X ⟶ Y) (V : Y.Opens), V ≠ ⊥ → IsIso (f ∣_ V) → ∀ x : X, f x = genericPoint Y →
      x = genericPoint X := by
    intro X Y _ _ f V hV hiso x hx
    have hηV : genericPoint Y ∈ V :=
      ((genericPoint_spec Y).mem_open_set_iff V.isOpen).mpr
        (by simpa using (TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV)
    have h1 : f (genericPoint X) ⤳ f x :=
      ((genericPoint_spec X).specializes (Set.mem_univ x)).map f.continuous
    rw [hx] at h1
    have h2 : genericPoint Y ⤳ f (genericPoint X) :=
      (genericPoint_spec Y).specializes (Set.mem_univ _)
    have hfη : f (genericPoint X) = genericPoint Y := (h1.antisymm h2).eq
    have hxV : x ∈ f ⁻¹ᵁ V := by rw [Scheme.Hom.mem_preimage, hx]; exact hηV
    have hηX : genericPoint X ∈ f ⁻¹ᵁ V := by rw [Scheme.Hom.mem_preimage, hfη]; exact hηV
    have e1 : ∀ p : (f ⁻¹ᵁ V).toScheme, V.ι ((f ∣_ V) p) = f ((f ⁻¹ᵁ V).ι p) := fun p => by
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
    obtain ⟨px, hpx⟩ : ∃ p : (f ⁻¹ᵁ V).toScheme, (f ⁻¹ᵁ V).ι p = x := ⟨⟨x, hxV⟩, by simp⟩
    obtain ⟨pη, hpη⟩ : ∃ p : (f ⁻¹ᵁ V).toScheme, (f ⁻¹ᵁ V).ι p = genericPoint X :=
      ⟨⟨genericPoint X, hηX⟩, by simp⟩
    have h3 : V.ι ((f ∣_ V) px) = V.ι ((f ∣_ V) pη) := by
      rw [e1, e1, hpx, hpη, hx, hfη]
    have h4 : px = pη := (f ∣_ V).isOpenEmbedding.injective (V.ι.isOpenEmbedding.injective h3)
    rw [← hpx, ← hpη, h4]

  have s8 : ∀ (T : Scheme.{u}) (sT : T ⟶ Spec (.of k)), IsSeparated sT →
      ∀ (W : ValuationSubring L) (f g : Spec (CommRingCat.of W) ⟶ T),
      Spec.map (CommRingCat.ofHom (algebraMap W L)) ≫ f =
        Spec.map (CommRingCat.ofHom (algebraMap W L)) ≫ g → f = g := by
    intro T sT hsT W f g hfg
    haveI : IsDominant (Spec.map (CommRingCat.ofHom (algebraMap W L))) := by
      rw [isDominant_iff]
      refine (PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical (algebraMap W L)).mpr ?_
      intro y hy
      rw [RingHom.mem_ker] at hy
      have hy' : (y : L) = 0 := hy
      have hy0 : y = 0 := Subtype.ext hy'
      rw [hy0]
      exact zero_mem _
    have h1 : f ≫ sT = g ≫ sT :=
      ext_of_isDominant (Spec.map (CommRingCat.ofHom (algebraMap W L)))
        (by rw [← Category.assoc, hfg, Category.assoc])
    exact ext_of_isDominant_of_isSeparated sT h1 _ hfg

  have hlft : ∀ V, LocallyOfFiniteType (dV V ≫ sS₀) := fun V => by
    haveI := wcpa_dj_proj_proper k _ (hdVproj V)
    infer_instance
  have hch := fun V => wcpa_dj_rzf_chart_finset k (SV V) (dV V ≫ sS₀) (hlft V) L V (cV V) (OV V)
    (hrange V)
  choose F hFV hcW using hch

  obtain ⟨r, Vs, hcov⟩ := wcpa_dj_rzf_compactness L F hFV

  obtain ⟨R, iR, ρ, a, gR, hgenR, hRproj, ⟨V₀, hV₀, hV₀iso⟩, hgRρ, haρ, hgRa⟩ :=
    wcpa_dj_rzf_multi_join k S₀ sS₀ hS₀ L
      (Spec.map (CommRingCat.ofHom (ε : S₀.functionField →+* L)) ≫
        S₀.fromSpecStalk (genericPoint S₀)) ⟨ε, rfl⟩ r (fun j => SV (Vs j))
      (fun j => dV (Vs j))
      (fun j => Spec.map (CommRingCat.ofHom (algebraMap (Vs j) L)) ≫ cV (Vs j))
      (fun j => hdVproj (Vs j)) (fun j => hdViso (Vs j))
      (fun j => by rw [Category.assoc]; exact hcen (Vs j))
  haveI := iR

  haveI hsS₀p : IsProper sS₀ := wcpa_dj_proj_proper k sS₀ hS₀
  haveI hRp : IsProper (ρ ≫ sS₀) := wcpa_dj_proj_proper k _ hRproj
  haveI hρp : IsProper ρ := IsProper.of_comp ρ sS₀
  have hρs : Surjective ρ := by
    refine ⟨fun y => ?_⟩
    have hcl : IsClosed (Set.range ρ) := ρ.isClosedMap.isClosed_range
    have hη : ρ (gR pt) = genericPoint S₀ := by
      rw [← Scheme.Hom.comp_apply, hgRρ]
      exact genpt S₀ ε
    exact ((genericPoint_spec S₀).specializes (Set.mem_univ y)).mem_closed hcl ⟨_, hη⟩
  haveI := hρs

  obtain ⟨S, iS, b, hbfin, hbs, hnorm, U, hU, hbU⟩ := wcpa_dj_sgf_normalization k R (ρ ≫ sS₀)
  haveI := iS
  haveI := hbfin
  haveI := hbs
  haveI := hbU
  haveI := hV₀iso

  haveI hUne : Nonempty U.toScheme := by
    obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    exact ⟨⟨x, hx⟩⟩
  haveI : AlgebraicGeometry.IsIntegral U.toScheme := isIntegral_of_isOpenImmersion U.ι
  obtain ⟨gU, hgU, hgenU⟩ := (wcpa_dj_rzf_gen_transport U.toScheme R U.ι L).2 gR hgenR
  obtain ⟨εS, hεS⟩ :=
    (wcpa_dj_rzf_gen_transport U.toScheme S (inv (b ∣_ U) ≫ (b ⁻¹ᵁ U).ι) L).1 gU hgenU
  have hgSb : (gU ≫ inv (b ∣_ U) ≫ (b ⁻¹ᵁ U).ι) ≫ b = gR := by
    rw [Category.assoc, Category.assoc, ← morphismRestrict_ι, IsIso.inv_hom_id_assoc, hgU]
  have hgSe : ∀ j, (gU ≫ inv (b ∣_ U) ≫ (b ⁻¹ᵁ U).ι) ≫ b ≫ a j =
      Spec.map (CommRingCat.ofHom (algebraMap (Vs j) L)) ≫ cV (Vs j) := fun j => by
    have h := congrArg (· ≫ a j) hgSb
    simp only [Category.assoc] at h ⊢
    rw [h]
    exact hgRa j
  generalize gU ≫ inv (b ∣_ U) ≫ (b ⁻¹ᵁ U).ι = gS at hεS hgSb hgSe

  have hq : ∀ j, (Spec.map (CommRingCat.ofHom (algebraMap (Vs j) L)) ≫ cV (Vs j)) pt =
      genericPoint (SV (Vs j)) := by
    intro j
    obtain ⟨V₁, hV₁, hV₁iso⟩ := hdViso (Vs j)
    apply s7 _ _ (dV (Vs j)) V₁ hV₁ hV₁iso
    rw [← Scheme.Hom.comp_apply, Category.assoc, hcen (Vs j)]
    exact genpt S₀ ε
  refine ⟨r, Vs, S, iS, b ≫ ρ, fun j => b ≫ a j, hnorm, ?_, inferInstance, inferInstance,
    ⟨V₀, hV₀, ?_⟩, ?_, ?_, ?_⟩
  ·
    rw [Category.assoc]
    exact wcpa_dj_gs_finite_proj k b (ρ ≫ sS₀) hbfin hRproj
  ·
    rw [morphismRestrict_comp]
    have h1 : IsFinite (b ∣_ (ρ ⁻¹ᵁ V₀)) := inferInstance
    have h2 : IsFinite (ρ ∣_ V₀) := inferInstance
    exact MorphismProperty.comp_mem _ _ _ h1 h2
  ·
    intro j
    rw [Category.assoc]
    exact congrArg (b ≫ ·) (haρ j)
  ·
    intro j O hO
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    refine ⟨gS pt, ?_⟩
    show gS pt ∈ (b ≫ a j) ⁻¹ᵁ O
    rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hgSe j, hq j]
    exact ((genericPoint_spec _).mem_open_set_iff O.isOpen).mpr
      (by simpa using (TopologicalSpace.Opens.ne_bot_iff_nonempty O).mp hO)
  ·
    rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    obtain ⟨W, w, hwx, hwg⟩ := wcpa_dj_rzf_valuative_point S L εS x
    obtain ⟨j, hj⟩ := hcov W
    obtain ⟨cW, hcWr, hcWe⟩ := hcW (Vs j) W hj
    refine ⟨j, ?_⟩
    have hsep : IsSeparated (dV (Vs j) ≫ sS₀) := by
      haveI := wcpa_dj_proj_proper k _ (hdVproj (Vs j))
      infer_instance
    have heq : w ≫ b ≫ a j = cW := by
      apply s8 (SV (Vs j)) (dV (Vs j) ≫ sS₀) hsep W
      rw [hcWe, ← hgSe j, ← Category.assoc, hwg, hεS]
    have key : ∀ p, (b ≫ a j) (w p) = cW p := fun p => by rw [← Scheme.Hom.comp_apply, heq]
    subst hwx
    show (b ≫ a j) (w _) ∈ OV (Vs j)
    exact (congrArg (· ∈ (OV (Vs j) : Set (SV (Vs j)))) (key _)).mpr (hcWr ⟨_, rfl⟩)

theorem wcpa_dj_lie_graph_closure : ∀ (T Z Z' V Y : Scheme.{u}) (u : Z ⟶ T) (u' : Z' ⟶ T) (v : V ⟶ T) (π : Y ⟶ V) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u'), IsOpenImmersion v → IsSeparated u' → IsLocallyNoetherian Z → AlgebraicGeometry.IsReduced Y → IsPullback a π u v → IsPullback a' π u' v → ∃ (Γ : Scheme.{u}) (ι : Γ ⟶ Limits.pullback u u') (j : Y ⟶ Γ), IsClosedImmersion ι ∧ AlgebraicGeometry.IsReduced Γ ∧ IsOpenImmersion j ∧ Dense (Set.range ⇑j) ∧ j ≫ ι = Limits.pullback.lift a a' h ∧ ∀ γ : Γ, (ι ≫ Limits.pullback.fst u u') γ ∈ Set.range ⇑a → γ ∈ Set.range ⇑j :=
by
  intro T Z Z' V Y u u' v π a a' h hv hu' hZ hY hpb _hpb'
  haveI := hv
  haveI := hu'
  haveI := hZ
  haveI := hY
  haveI ha : IsOpenImmersion a :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip hv
  set g := Limits.pullback.lift a a' h with hgdef
  set fst := Limits.pullback.fst u u' with hfst
  have hg : g ≫ fst = a := Limits.pullback.lift_fst _ _ _
  haveI : IsSeparated fst := inferInstance
  haveI : IsImmersion (g ≫ fst) := by rw [hg]; infer_instance
  haveI : IsImmersion g := IsImmersion.of_comp g fst
  haveI : QuasiCompact (g ≫ fst) := by rw [hg]; infer_instance
  haveI : QuasiCompact g := QuasiCompact.of_comp g fst

  have hred : AlgebraicGeometry.IsReduced g.image := by
    haveI : ∀ x : g.image, _root_.IsReduced (g.image.presheaf.stalk x) := by
      intro x
      obtain ⟨U, hU, hxU, -⟩ :=
        exists_isAffineOpen_mem_and_subset (x := g.imageι x) (U := ⊤) trivial
      have hW : IsAffineOpen (g.imageι ⁻¹ᵁ U) := hU.preimage g.imageι
      have hU' : U ∈ (Limits.pullback u u').affineOpens := hU
      have hinj : Function.Injective (g.toImage.app (g.imageι ⁻¹ᵁ U)).hom := by
        have e := Scheme.Hom.toImage_app g ⟨U, hU'⟩
        have e' : g.toImage.app (g.imageι ⁻¹ᵁ U) = _ := e
        have key : ∀ (A B C : CommRingCat.{u}) (f : A ⟶ B) (g' : B ⟶ C), IsIso f →
            Function.Injective g'.hom → Function.Injective (f ≫ g').hom := by
          intro A B C f g' hf hg'
          rw [CommRingCat.hom_comp]
          exact hg'.comp (ConcreteCategory.bijective_of_isIso f).1
        rw [e']
        exact key _ _ _ _ _ inferInstance
          (RingHom.lift_injective_of_ker_le_ideal _ _ (Scheme.Hom.ker_apply g ⟨U, hU'⟩).ge)
      haveI : _root_.IsReduced Γ(g.image, g.imageι ⁻¹ᵁ U) := isReduced_of_injective _ hinj
      have hxW : x ∈ g.imageι ⁻¹ᵁ U := hxU
      letI := TopCat.Presheaf.algebra_section_stalk g.image.presheaf
        (⟨x, hxW⟩ : (g.imageι ⁻¹ᵁ U : g.image.Opens))
      haveI := hW.isLocalization_stalk ⟨x, hxW⟩
      exact isReduced_localizationPreserves (hW.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl _
        inferInstance
    exact isReduced_of_isReduced_stalk _
  have hrange : Set.range g.imageι = closure (Set.range g) :=
    (Scheme.IdealSheafData.range_subschemeι g.ker).trans (Scheme.Hom.support_ker g)
  have hcomp : g.imageι '' Set.range g.toImage = Set.range g := by
    ext p
    constructor
    · rintro ⟨_, ⟨y, rfl⟩, rfl⟩
      exact ⟨y, by rw [← Scheme.Hom.comp_apply, Scheme.Hom.toImage_imageι]⟩
    · rintro ⟨y, rfl⟩
      exact ⟨_, ⟨y, rfl⟩, by rw [← Scheme.Hom.comp_apply, Scheme.Hom.toImage_imageι]⟩
  refine ⟨g.image, g.imageι, g.toImage, inferInstance, hred, inferInstance, ?_,
    Scheme.Hom.toImage_imageι g, ?_⟩
  · rw [dense_iff_closure_eq,
      g.imageι.isClosedEmbedding.isEmbedding.closure_eq_preimage_closure_image, hcomp, ← hrange]
    exact Set.preimage_range _
  · intro γ hγ
    rw [Scheme.Hom.comp_apply] at hγ
    have hmem : g.imageι γ ∈ closure (Set.range g) := hrange ▸ ⟨γ, rfl⟩
    let N : (Limits.pullback u u').Opens := fst ⁻¹ᵁ a.opensRange
    have hgN' : Set.range g ⊆ (N : Set _) := by
      rintro _ ⟨y, rfl⟩
      show fst (g y) ∈ (a.opensRange : Set Z)
      rw [← Scheme.Hom.comp_apply, hg, Scheme.Hom.coe_opensRange]
      exact ⟨y, rfl⟩
    obtain ⟨gN, hgN⟩ : ∃ gN : Y ⟶ N.toScheme, gN ≫ N.ι = g :=
      ⟨IsOpenImmersion.lift N.ι g (by
        rintro _ ⟨y, rfl⟩
        rw [Scheme.Opens.range_ι]
        exact hgN' ⟨y, rfl⟩), IsOpenImmersion.lift_fac _ _ _⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : N.toScheme ⟶ Y, φ ≫ a = N.ι ≫ fst :=
      ⟨IsOpenImmersion.lift a (N.ι ≫ fst) (by
        rintro _ ⟨q, rfl⟩
        have hq : N.ι q ∈ (N : Set _) := by rw [← Scheme.Opens.range_ι]; exact ⟨q, rfl⟩
        have hq' : fst (N.ι q) ∈ (a.opensRange : Set Z) := hq
        rw [Scheme.Hom.coe_opensRange] at hq'
        rw [Scheme.Hom.comp_apply]
        exact hq'), IsOpenImmersion.lift_fac _ _ _⟩
    have hsec : gN ≫ φ = 𝟙 Y := by
      rw [← cancel_mono a, Category.assoc, hφ, ← Category.assoc, hgN, hg, Category.id_comp]
    haveI : IsSeparated (φ ≫ a) := by rw [hφ]; infer_instance
    haveI : IsSeparated φ := IsSeparated.of_comp φ a
    haveI : IsClosedImmersion (gN ≫ φ) := by rw [hsec]; infer_instance
    haveI : IsClosedImmersion gN := IsClosedImmersion.of_comp gN φ
    have hcl : IsClosed (Set.range gN) := gN.isClosedEmbedding.isClosed_range
    have hpN : g.imageι γ ∈ (N : Set _) := by
      show fst (g.imageι γ) ∈ (a.opensRange : Set Z)
      rw [Scheme.Hom.coe_opensRange]
      exact hγ
    rw [← Scheme.Opens.range_ι N] at hpN
    obtain ⟨q, hq⟩ := hpN
    have himg : N.ι '' Set.range gN = Set.range g := by
      ext p
      constructor
      · rintro ⟨_, ⟨y, rfl⟩, rfl⟩
        exact ⟨y, by rw [← Scheme.Hom.comp_apply, hgN]⟩
      · rintro ⟨y, rfl⟩
        exact ⟨_, ⟨y, rfl⟩, by rw [← Scheme.Hom.comp_apply, hgN]⟩
    have hqcl : q ∈ closure (Set.range gN) := by
      rw [N.ι.isOpenEmbedding.isEmbedding.closure_eq_preimage_closure_image, himg]
      rw [Set.mem_preimage, hq]
      exact hmem
    rw [hcl.closure_eq] at hqcl
    obtain ⟨y, hy⟩ := hqcl
    refine ⟨y, g.imageι.isClosedEmbedding.injective ?_⟩
    rw [← Scheme.Hom.comp_apply, Scheme.Hom.toImage_imageι, ← hq, ← hy, ← Scheme.Hom.comp_apply,
      hgN]

theorem wcpa_dj_ldx_gen_open_immersion : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) :=
by
  intro R _ _ _
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have inj : Function.Injective (algebraMap R (FractionRing R)) :=
    IsFractionRing.injective R (FractionRing R)
  have hϖ0 : algebraMap R (FractionRing R) ϖ ≠ 0 := by
    intro h
    exact hϖ.ne_zero (inj (h.trans (map_zero _).symm))
  haveI : IsLocalization.Away ϖ (FractionRing R) := by
    refine IsLocalization.Away.mk ϖ (IsUnit.mk0 _ hϖ0) ?_ ?_
    · intro s
      obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := R) s
      have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
      obtain ⟨n, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hϖ
      refine ⟨n, a * ↑v⁻¹, ?_⟩
      have hv : algebraMap R (FractionRing R) (↑v) * algebraMap R (FractionRing R) (↑v⁻¹) = 1 := by
        rw [← map_mul, Units.mul_inv, map_one]
      have hv0 : algebraMap R (FractionRing R) (↑v) ≠ 0 := by
        intro h; rw [h, zero_mul] at hv; exact zero_ne_one hv
      have hpn : algebraMap R (FractionRing R) ϖ ^ n ≠ 0 := pow_ne_zero _ hϖ0
      rw [map_mul, map_mul, map_pow]
      field_simp
      linear_combination -(algebraMap R (FractionRing R) a) * hv
    · intro a b h
      exact ⟨0, by rw [pow_zero, one_mul, one_mul]; exact inj h⟩
  exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization ϖ

theorem wcpa_dj_ldx_special_fibre_reduced : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), wcpaDjSemistable u → ∀ (W : Z.Opens), IsAffineOpen W → ∀ ϖ : R, Irreducible ϖ → _root_.IsReduced (Γ(Z, W) ⧸ Ideal.span {wcCnSigma u W ϖ}) :=
by
  intro R _ _ _ Z u hu W hW ϖ hϖ

  have s2 : ∀ (B : Type u) [CommRing B] (Z : Scheme.{u}) (h : Z ⟶ Spec (.of B)) (W : Z.Opens)
      (hW : IsAffineOpen W), hW.fromSpec ≫ h = Spec.map (CommRingCat.ofHom (wcCnSigma h W)) := by
    intro B _ Z h W hW
    have ha := Scheme.toSpecΓ_naturality h
    have hb : (Spec (.of B)).toSpecΓ = Spec.map (Scheme.ΓSpecIso (.of B)).hom := by
      rw [← Scheme.isoSpec_hom, Scheme.isoSpec_Spec_hom]
    have hc : h = Z.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop) := by
      have := congrArg (· ≫ Spec.map (Scheme.ΓSpecIso (.of B)).inv) ha
      simp only [Category.assoc, hb, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
        Category.comp_id] at this
      exact this
    have e : hW.fromSpec ≫ h = Spec.map (((Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop) ≫
        Z.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) := by
      conv_lhs => rw [hc]
      rw [← Category.assoc, IsAffineOpen.fromSpec_toSpecΓ hW, ← Spec.map_comp]
    rw [e]
    rfl

  have s3 : ∀ (R B : Type u) [CommRing R] [CommRing B] (σ : R →+* B) (I : Ideal R),
      AlgebraicGeometry.IsReduced (Limits.pullback (Spec.map (CommRingCat.ofHom σ))
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))) →
      _root_.IsReduced (B ⧸ Ideal.map σ I) := by
    intro R B _ _ σ I H
    letI := σ.toAlgebra
    have H' : AlgebraicGeometry.IsReduced
        (Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R B)))
          (Spec.map (CommRingCat.ofHom (algebraMap R (R ⧸ I))))) := H
    haveI := H'
    haveI : AlgebraicGeometry.IsReduced (Spec (.of (TensorProduct R B (R ⧸ I)))) :=
      isReduced_of_isOpenImmersion (pullbackSpecIso R B (R ⧸ I)).inv
    have h1 : _root_.IsReduced (TensorProduct R B (R ⧸ I)) :=
      (affine_isReduced_iff (CommRingCat.of (TensorProduct R B (R ⧸ I)))).mp inferInstance
    have h2 : _root_.IsReduced (B ⧸ Ideal.map (algebraMap R B) I) :=
      isReduced_of_injective (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).toRingHom
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).injective
    exact h2

  set I : Ideal R := Ideal.span {ϖ} with hI
  have hmax : IsLocalRing.maximalIdeal R = I :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
  haveI : I.IsMaximal := hmax ▸ IsLocalRing.maximalIdeal.isMaximal R
  letI : Field (R ⧸ I) := Ideal.Quotient.field I
  set s₀ := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) with hs₀
  haveI h1 : AlgebraicGeometry.IsReduced (Limits.pullback u s₀) :=
    wcpa_dj_ldx_semistable_fibre_reduced Z _ u hu (R ⧸ I) s₀
  haveI := hW.isOpenImmersion_fromSpec
  haveI h2 : AlgebraicGeometry.IsReduced
      (Limits.pullback hW.fromSpec (Limits.pullback.fst u s₀)) :=
    isReduced_of_isOpenImmersion (Limits.pullback.snd hW.fromSpec (Limits.pullback.fst u s₀))
  haveI h3 : AlgebraicGeometry.IsReduced (Limits.pullback (hW.fromSpec ≫ u) s₀) :=
    isReduced_of_isOpenImmersion (Limits.pullbackRightPullbackFstIso u s₀ hW.fromSpec).inv
  haveI h4 : AlgebraicGeometry.IsReduced
      (Limits.pullback (Spec.map (CommRingCat.ofHom (wcCnSigma u W))) s₀) :=
    isReduced_of_isOpenImmersion (Limits.pullback.congrHom (s2 R Z u W hW) rfl).inv
  have h5 := s3 R Γ(Z, W) (wcCnSigma u W) I h4
  rwa [hI, Ideal.map_span, Set.image_singleton] at h5

theorem wcpa_dj_ldx_range_generic : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Y : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z), IsPullback a π u (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) → ∀ z : Z, z ∈ Set.range ⇑a ↔ u z ≠ IsLocalRing.closedPoint R :=
by
  intro R _ _ _ Z Y u π a hpb z
  have hrange : Set.range ⇑a = ⇑u ⁻¹' Set.range
      ⇑(Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := by
    rw [← Scheme.Pullback.range_fst]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      refine ⟨hpb.isoPullback.hom y, ?_⟩
      rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_hom_fst]
    · rintro ⟨w, rfl⟩
      refine ⟨hpb.isoPullback.inv w, ?_⟩
      rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst]
  rw [hrange, Set.mem_preimage]
  generalize u z = p
  constructor
  · rintro ⟨q, rfl⟩ hp
    have h1 : (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) q).asIdeal = ⊥ := by
      have hq0 : (q : PrimeSpectrum (FractionRing R)).asIdeal = ⊥ := by
        haveI := (q : PrimeSpectrum (FractionRing R)).isPrime
        exact Ideal.eq_bot_of_prime _
      rw [Spec.map_apply]
      change Ideal.comap (algebraMap R (FractionRing R))
        (q : PrimeSpectrum (FractionRing R)).asIdeal = ⊥
      rw [hq0]
      exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective R (FractionRing R))
    apply IsDiscreteValuationRing.not_a_field R
    have h2 : (IsLocalRing.closedPoint R).asIdeal = IsLocalRing.maximalIdeal R := rfl
    rw [← h2, ← h1, hp]
  · intro hp
    have hbot : (p : PrimeSpectrum R).asIdeal = ⊥ := by
      by_contra hne
      apply hp
      obtain ⟨P, _, huniq⟩ :=
        ((IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime R).mp inferInstance).2
      have e1 : (p : PrimeSpectrum R).asIdeal = P :=
        huniq _ ⟨hne, (p : PrimeSpectrum R).isPrime⟩
      have e2 : IsLocalRing.maximalIdeal R = P :=
        huniq _ ⟨IsDiscreteValuationRing.not_a_field R,
          (IsLocalRing.maximalIdeal.isMaximal R).isPrime⟩
      apply PrimeSpectrum.ext
      rw [e1, ← e2]
      rfl
    obtain ⟨q⟩ : Nonempty (Spec (.of (FractionRing R))) :=
      ⟨(⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (FractionRing R))⟩
    refine ⟨q, ?_⟩
    apply PrimeSpectrum.ext
    rw [hbot]
    have hq0 : (q : PrimeSpectrum (FractionRing R)).asIdeal = ⊥ := by
      haveI := (q : PrimeSpectrum (FractionRing R)).isPrime
      exact Ideal.eq_bot_of_prime _
    rw [Spec.map_apply]
    change Ideal.comap (algebraMap R (FractionRing R))
      (q : PrimeSpectrum (FractionRing R)).asIdeal = ⊥
    rw [hq0]
    exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective R (FractionRing R))

theorem wcpa_dj_ldx_finite_birational_iso : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z G Y : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (p : G ⟶ Z) (j : Y ⟶ G), IsLocallyNoetherian Z → Flat u → (∀ (W : Z.Opens), IsAffineOpen W → ∀ ϖ : R, Irreducible ϖ → _root_.IsReduced (Γ(Z, W) ⧸ Ideal.span {wcCnSigma u W ϖ})) → IsPullback a π u (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) → AlgebraicGeometry.IsReduced G → IsFinite p → IsOpenImmersion j → Dense (Set.range ⇑j) → j ≫ p = a → (∀ γ : G, p γ ∈ Set.range ⇑a → γ ∈ Set.range ⇑j) → IsIso p :=
by
  intro R _ _ _ Z G Y u π a p j _hZn hflat hred hpb hG hp hj hjd hjp hjr
  classical

  have hs8 : ∀ {B C : Type u} [CommRing B] [CommRing C] (φ : B →+* C) (f : B), φ.IsIntegral →
      (∀ b : B, f * b = 0 → b = 0) → (∀ c : C, φ f * c = 0 → c = 0) →
      _root_.IsReduced (B ⧸ Ideal.span {f}) → (∀ b : B, φ b = 0 → ∃ m : ℕ, f ^ m * b = 0) →
      (∀ c : C, ∃ (m : ℕ) (b : B), φ f ^ m * c = φ b) → Function.Bijective φ := by
    intro B C _ _ φ f hint htfB htfC hred hD1 hD2
    have htfB' : ∀ m : ℕ, ∀ b : B, f ^ m * b = 0 → b = 0 := by
      intro m
      induction m with
      | zero => intro b h; simpa using h
      | succ k ih =>
        intro b h
        apply htfB
        apply ih
        rw [pow_succ, mul_assoc] at h
        exact h
    have hinj : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro b hb
      obtain ⟨m, hm⟩ := hD1 b hb
      exact htfB' m b hm
    have hK : ∀ (e : ℕ) (b : B) (c : C), 1 ≤ e → φ f ^ e * c = φ b → f ∣ b := by
      intro e b c he hc
      obtain ⟨P, hPm, hP⟩ := hint c
      have h1 : Polynomial.eval₂ φ (φ (f ^ e) * c) (P.scaleRoots (f ^ e)) =
          φ (f ^ e) ^ P.natDegree * Polynomial.eval₂ φ c P :=
        Polynomial.scaleRoots_eval₂_mul φ c (f ^ e)
      rw [hP, mul_zero, map_pow, hc, Polynomial.eval₂_at_apply] at h1
      have h2 : Polynomial.eval b (P.scaleRoots (f ^ e)) = 0 := hinj (by rw [h1, map_zero])
      have hfz : (Ideal.Quotient.mk (Ideal.span {f})) f = 0 :=
        (Ideal.Quotient.eq_zero_iff_dvd f f).mpr dvd_rfl
      have h3 : (P.scaleRoots (f ^ e)).map (Ideal.Quotient.mk (Ideal.span {f})) =
          Polynomial.X ^ P.natDegree := by
        ext i
        rw [Polynomial.coeff_map, Polynomial.coeff_scaleRoots, Polynomial.coeff_X_pow]
        split_ifs with hi
        · subst hi
          rw [hPm.coeff_natDegree, Nat.sub_self, pow_zero, mul_one, map_one]
        · rcases lt_or_gt_of_ne hi with hlt | hgt
          · rw [map_mul, map_pow, map_pow, hfz, zero_pow (by omega), zero_pow (by omega), mul_zero]
          · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hgt, zero_mul, map_zero]
      have h4 := congrArg (Polynomial.eval ((Ideal.Quotient.mk (Ideal.span {f})) b)) h3
      rw [Polynomial.eval_map, Polynomial.eval₂_at_apply, h2, map_zero, Polynomial.eval_pow,
        Polynomial.eval_X] at h4
      have h5 : (Ideal.Quotient.mk (Ideal.span {f})) b = 0 := IsNilpotent.eq_zero ⟨_, h4.symm⟩
      exact (Ideal.Quotient.eq_zero_iff_dvd f b).mp h5
    refine ⟨hinj, ?_⟩
    intro c
    have hex : ∃ m, ∃ b, φ f ^ m * c = φ b := hD2 c
    obtain ⟨b, hb⟩ := Nat.find_spec hex
    rcases Nat.eq_zero_or_pos (Nat.find hex) with h0 | hpos
    · rw [h0, pow_zero, one_mul] at hb
      exact ⟨b, hb.symm⟩
    · exfalso
      obtain ⟨k, hk⟩ : ∃ k, Nat.find hex = k + 1 := ⟨_, (Nat.succ_pred_eq_of_pos hpos).symm⟩
      rw [hk] at hb
      obtain ⟨b', rfl⟩ := hK (k + 1) b c (by omega) hb
      have h6 : φ f ^ k * c = φ b' := by
        have h5 : φ f * (φ f ^ k * c - φ b') = 0 := by
          rw [mul_sub, ← mul_assoc, ← pow_succ', hb, map_mul, sub_self]
        exact sub_eq_zero.mp (htfC _ h5)
      exact Nat.find_min hex (by omega : k < Nat.find hex) ⟨b', h6⟩

  have hs4 : ∀ (V : Z.Opens), IsOpenImmersion a → (V : Set Z) ⊆ Set.range ⇑a →
      Function.Bijective (p.app V) := by
    intro V _ hV
    subst hjp
    have h1 : V ≤ (j ≫ p).opensRange := by
      intro z hz
      show z ∈ ((j ≫ p).opensRange : Set Z)
      rw [Scheme.Hom.coe_opensRange]
      exact hV hz
    have h2 : p ⁻¹ᵁ V ≤ j.opensRange := by
      intro γ hγ
      show γ ∈ (j.opensRange : Set G)
      rw [Scheme.Hom.coe_opensRange]
      exact hjr γ (hV hγ)
    have i1 := Scheme.Hom.isIso_app (j ≫ p) V h1
    have i2 := Scheme.Hom.isIso_app j (p ⁻¹ᵁ V) h2
    have i3 : IsIso (p.app V ≫ j.app (p ⁻¹ᵁ V)) := by rw [← Scheme.Hom.comp_app]; exact i1
    have i4 := IsIso.of_isIso_comp_right (p.app V) (j.app (p ⁻¹ᵁ V))
    exact ConcreteCategory.bijective_of_isIso (p.app V)

  have hs3 : ∀ (W : Z.Opens) (ϖ : R), Irreducible ϖ → ∀ z : Z,
      z ∈ Z.basicOpen (wcCnSigma u W ϖ) ↔ z ∈ W ∧ u z ≠ IsLocalRing.closedPoint R := by
    intro W ϖ hϖ z
    have e1 : Z.basicOpen (wcCnSigma u W ϖ) = W ⊓ Z.basicOpen
        (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom ϖ)) :=
      Scheme.basicOpen_res Z _ (homOfLE (le_top : W ≤ ⊤)).op
    have e2 : Z.basicOpen (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom ϖ)) =
        u ⁻¹ᵁ (Spec (.of R)).basicOpen ((Scheme.ΓSpecIso (.of R)).inv.hom ϖ) :=
      (Scheme.preimage_basicOpen u _).symm
    have e3 : (Spec (.of R)).basicOpen ((Scheme.ΓSpecIso (.of R)).inv.hom ϖ) =
        PrimeSpectrum.basicOpen (R := R) ϖ := basicOpen_eq_of_affine (R := CommRingCat.of R) ϖ
    have e4 : ∀ q : Spec (.of R), q ∈ (Spec (.of R)).basicOpen
        ((Scheme.ΓSpecIso (.of R)).inv.hom ϖ) ↔ ϖ ∉ (q : PrimeSpectrum R).asIdeal := by
      intro q
      exact (SetLike.ext_iff.mp e3 q).trans (PrimeSpectrum.mem_basicOpen ϖ q)
    rw [e1, e2, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage, e4]
    apply and_congr Iff.rfl
    have hmax : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    generalize u z = q
    constructor
    · intro hq hc
      apply hq
      rw [hc]
      show ϖ ∈ IsLocalRing.maximalIdeal R
      rw [hmax]
      exact Ideal.mem_span_singleton_self ϖ
    · intro hq hc
      apply hq
      apply PrimeSpectrum.ext
      have h1 : IsLocalRing.maximalIdeal R ≤ (q : PrimeSpectrum R).asIdeal := by
        rw [hmax, Ideal.span_le, Set.singleton_subset_iff]
        exact hc
      have h2 := (IsLocalRing.maximalIdeal.isMaximal R).eq_of_le
        (q : PrimeSpectrum R).isPrime.ne_top h1
      rw [← h2]
      rfl

  have hs5 : ∀ (W : Z.Opens) (f : Γ(Z, W)), IsAffineOpen W → IsAffineOpen (p ⁻¹ᵁ W) →
      Function.Bijective (p.app (Z.basicOpen f)) →
      (∀ b : Γ(Z, W), (p.app W).hom b = 0 → ∃ m : ℕ, f ^ m * b = 0) ∧
      (∀ c : Γ(G, p ⁻¹ᵁ W), ∃ (m : ℕ) (b : Γ(Z, W)),
        (p.app W).hom f ^ m * c = (p.app W).hom b) := by
    intro W f hW hW' hbij
    set g := (p.app W).hom f with hg
    have h : p ⁻¹ᵁ Z.basicOpen f = G.basicOpen g := Scheme.preimage_basicOpen p f
    have hle : Z.basicOpen f ≤ W := Z.basicOpen_le f
    have hle' : G.basicOpen g ≤ p ⁻¹ᵁ W := G.basicOpen_le g
    let ρZ := Z.presheaf.map (homOfLE hle).op
    let ρG := G.presheaf.map (homOfLE hle').op
    let ι : G.presheaf.obj (Opposite.op (p ⁻¹ᵁ Z.basicOpen f)) ⟶
        G.presheaf.obj (Opposite.op (G.basicOpen g)) := G.presheaf.map (homOfLE h.ge).op
    have hιiso : IsIso ι := by
      have : IsIso (homOfLE h.ge).op :=
        ⟨⟨(homOfLE h.le).op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
      exact Functor.map_isIso _ _
    have hι : Function.Bijective ι := ConcreteCategory.bijective_of_isIso ι
    let ψ := p.app (Z.basicOpen f) ≫ ι
    have hψ : Function.Bijective ψ := by
      have e : (ψ : _ → _) = ι ∘ (p.app (Z.basicOpen f)) := by
        funext x; rfl
      rw [e]; exact hι.comp hbij
    have hstar : ρZ ≫ ψ = p.app W ≫ ρG := by
      show Z.presheaf.map (homOfLE hle).op ≫ p.app (Z.basicOpen f) ≫
          G.presheaf.map (homOfLE h.ge).op = p.app W ≫ G.presheaf.map (homOfLE hle').op
      rw [← Category.assoc, Scheme.Hom.naturality, Category.assoc, ← Functor.map_comp]
      rfl
    have hstar' : ∀ b, ψ (ρZ b) = ρG ((p.app W).hom b) := by
      intro b
      have := congrArg (fun φ => φ.hom b) hstar
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
    constructor
    · intro b hb
      have h1 : ρZ b = 0 := by
        apply hψ.1
        rw [hstar', hb, map_zero, map_zero]
      exact exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen Z hW b f h1
    · intro c
      obtain ⟨x, hx⟩ := hψ.2 (ρG c)
      obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen Z W hW f x
      have hy' : ρZ y = (ρZ f) ^ n * x := hy
      have h2 : ρG ((p.app W).hom y - g ^ n * c) = 0 := by
        have := congrArg ψ hy'
        rw [hstar', map_mul, map_pow, hstar', hx] at this
        rw [map_sub, map_mul, map_pow, this, sub_self]
      obtain ⟨k, hk⟩ :=
        exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen G hW' _ g h2
      refine ⟨k + n, f ^ k * y, ?_⟩
      rw [map_mul, map_pow, ← hg, pow_add, mul_assoc]
      rw [mul_sub, sub_eq_zero] at hk
      exact hk.symm

  have hs6 : ∀ (W : Z.Opens), IsAffineOpen W → ∀ r : R, r ≠ 0 → ∀ b : Γ(Z, W),
      wcCnSigma u W r * b = 0 → b = 0 := by
    intro W hW r hr b h
    have h1 := HasRingHomProperty.appLE (P := @Flat) u hflat ⟨⊤, isAffineOpen_top _⟩ ⟨W, hW⟩
      (fun _ _ => trivial)
    have h2 : (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom.Flat :=
      RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso _)
    have h3 : (wcCnSigma u W).Flat := by
      have e : wcCnSigma u W = (u.appLE ⊤ W (fun _ _ => trivial)).hom.comp
          (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom := rfl
      rw [e]
      exact RingHom.Flat.comp h2 h1
    letI := (wcCnSigma u W).toAlgebra
    haveI : Module.Flat R Γ(Z, W) := RingHom.flat_algebraMap_iff.mp h3
    have h4 := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Γ(Z, W))
      (mem_nonZeroDivisors_of_ne_zero hr)
    apply h4
    show r • b = r • (0 : Γ(Z, W))
    rw [smul_zero, Algebra.smul_def]
    exact h

  have hs7 : ∀ (W : Z.Opens) (f : Γ(Z, W)), (∀ y : Y, p (j y) ∈ W → p (j y) ∈ Z.basicOpen f) →
      ∀ c : Γ(G, p ⁻¹ᵁ W), (p.app W).hom f * c = 0 → c = 0 := by
    intro W f hside c hc
    rw [← basicOpen_eq_bot_iff]
    by_contra hne
    obtain ⟨γ, hγ⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
    obtain ⟨_, hmem, ⟨y, rfl⟩⟩ := hjd.inter_open_nonempty _ (G.basicOpen c).isOpen ⟨γ, hγ⟩
    have h1 : j y ∈ p ⁻¹ᵁ W := G.basicOpen_le c hmem
    have h2 : p (j y) ∈ Z.basicOpen f := hside y h1
    have h3 : j y ∈ G.basicOpen ((p.app W).hom f) := by
      rw [← Scheme.preimage_basicOpen]; exact h2
    have h4 : j y ∈ G.basicOpen ((p.app W).hom f * c) := by
      rw [Scheme.basicOpen_mul]; exact ⟨h3, hmem⟩
    rw [hc, Scheme.basicOpen_zero] at h4
    exact h4

  have hs9 : IsAffineHom p → (∀ W : Z.Opens, IsAffineOpen W → Function.Bijective (p.app W)) →
      IsIso p := by
    intro hpa h
    have : MorphismProperty.isomorphisms Scheme p := by
      rw [@HasAffineProperty.iff_of_iSup_eq_top (MorphismProperty.isomorphisms Scheme) _
        instHasAffinePropertyIsomorphismsSchemeAndIsAffineIsIsoCommRingCatAppTop _ _ p _
        (fun W : Z.affineOpens => W) (iSup_affineOpens_eq_top Z)]
      intro W
      refine ⟨W.2.preimage p, ?_⟩
      rw [morphismRestrict_appTop]
      have hW : IsAffineOpen ((W : Z.Opens).ι ''ᵁ ⊤) := by
        rw [Scheme.Opens.ι_image_top]; exact W.2
      have hiso : IsIso (p.app ((W : Z.Opens).ι ''ᵁ ⊤)) :=
        (ConcreteCategory.isIso_iff_bijective _).mpr (h _ hW)
      refine IsIso.comp_isIso' ?_ ?_
      · exact hiso
      · exact Functor.map_isIso _ _
    exact this

  have hgen : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := by
    obtain ⟨t, ht⟩ := IsDiscreteValuationRing.exists_irreducible R
    have inj : Function.Injective (algebraMap R (FractionRing R)) :=
      IsFractionRing.injective R (FractionRing R)
    have ht0 : algebraMap R (FractionRing R) t ≠ 0 := by
      intro h
      exact ht.ne_zero (inj (h.trans (map_zero _).symm))
    haveI : IsLocalization.Away t (FractionRing R) := by
      refine IsLocalization.Away.mk t (IsUnit.mk0 _ ht0) ?_ ?_
      · intro s
        obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := R) s
        have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
        obtain ⟨n, v, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 ht
        refine ⟨n, a * ↑v⁻¹, ?_⟩
        have hv : algebraMap R (FractionRing R) (↑v) * algebraMap R (FractionRing R) (↑v⁻¹) = 1 := by
          rw [← map_mul, Units.mul_inv, map_one]
        have hv0 : algebraMap R (FractionRing R) (↑v) ≠ 0 := by
          intro h; rw [h, zero_mul] at hv; exact zero_ne_one hv
        have hpn : algebraMap R (FractionRing R) t ^ n ≠ 0 := pow_ne_zero _ ht0
        rw [map_mul, map_mul, map_pow]
        field_simp
        linear_combination -(algebraMap R (FractionRing R) a) * hv
      · intro a b h
        exact ⟨0, by rw [pow_zero, one_mul, one_mul]; exact inj h⟩
    exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization t

  have hrange : ∀ z : Z, z ∈ Set.range ⇑a ↔ u z ≠ IsLocalRing.closedPoint R := by
    intro z
    have hrange : Set.range ⇑a = ⇑u ⁻¹' Set.range
        ⇑(Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) := by
      rw [← Scheme.Pullback.range_fst]
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        refine ⟨hpb.isoPullback.hom y, ?_⟩
        rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_hom_fst]
      · rintro ⟨w, rfl⟩
        refine ⟨hpb.isoPullback.inv w, ?_⟩
        rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst]
    rw [hrange, Set.mem_preimage]
    generalize u z = q
    constructor
    · rintro ⟨q', rfl⟩ hq
      have h1 : (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) q').asIdeal = ⊥ := by
        have hq0 : (q' : PrimeSpectrum (FractionRing R)).asIdeal = ⊥ := by
          haveI := (q' : PrimeSpectrum (FractionRing R)).isPrime
          exact Ideal.eq_bot_of_prime _
        rw [Spec.map_apply]
        change Ideal.comap (algebraMap R (FractionRing R))
          (q' : PrimeSpectrum (FractionRing R)).asIdeal = ⊥
        rw [hq0]
        exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective R (FractionRing R))
      apply IsDiscreteValuationRing.not_a_field R
      have h2 : (IsLocalRing.closedPoint R).asIdeal = IsLocalRing.maximalIdeal R := rfl
      rw [← h2, ← h1, hq]
    · intro hq
      have hbot : (q : PrimeSpectrum R).asIdeal = ⊥ := by
        by_contra hne
        apply hq
        obtain ⟨P, _, huniq⟩ :=
          ((IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime R).mp inferInstance).2
        have e1 : (q : PrimeSpectrum R).asIdeal = P :=
          huniq _ ⟨hne, (q : PrimeSpectrum R).isPrime⟩
        have e2 : IsLocalRing.maximalIdeal R = P :=
          huniq _ ⟨IsDiscreteValuationRing.not_a_field R,
            (IsLocalRing.maximalIdeal.isMaximal R).isPrime⟩
        apply PrimeSpectrum.ext
        rw [e1, ← e2]
        rfl
      obtain ⟨q'⟩ : Nonempty (Spec (.of (FractionRing R))) :=
        ⟨(⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (FractionRing R))⟩
      refine ⟨q', ?_⟩
      apply PrimeSpectrum.ext
      rw [hbot]
      have hq0 : (q' : PrimeSpectrum (FractionRing R)).asIdeal = ⊥ := by
        haveI := (q' : PrimeSpectrum (FractionRing R)).isPrime
        exact Ideal.eq_bot_of_prime _
      rw [Spec.map_apply]
      change Ideal.comap (algebraMap R (FractionRing R))
        (q' : PrimeSpectrum (FractionRing R)).asIdeal = ⊥
      rw [hq0]
      exact Ideal.comap_bot_of_injective _ (IsFractionRing.injective R (FractionRing R))

  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  haveI ha : IsOpenImmersion a :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb.flip hgen
  apply hs9 inferInstance
  intro W hW
  have hV : ∀ z : Z, z ∈ Z.basicOpen (wcCnSigma u W ϖ) ↔ z ∈ W ∧ z ∈ Set.range ⇑a :=
    fun z => (hs3 W ϖ hϖ z).trans (and_congr Iff.rfl (hrange z).symm)
  have hb := hs4 (Z.basicOpen (wcCnSigma u W ϖ)) ha (fun z hz => ((hV z).mp hz).2)
  obtain ⟨hD1, hD2⟩ := hs5 W (wcCnSigma u W ϖ) hW (hW.preimage p) hb
  have htfB : ∀ b : Γ(Z, W), wcCnSigma u W ϖ * b = 0 → b = 0 :=
    fun b h => hs6 W hW ϖ hϖ.ne_zero b h
  have htfC := hs7 W (wcCnSigma u W ϖ)
    (fun y hy => (hV _).mpr ⟨hy, ⟨y, by rw [← hjp, Scheme.Hom.comp_apply]⟩⟩)
  have hint : (p.app W).hom.IsIntegral := (IsFinite.finite_app p W hW).to_isIntegral
  exact hs8 (p.app W).hom (wcCnSigma u W ϖ) hint htfB htfC (hred W hW ϖ hϖ) hD1 hD2

theorem wcpa_dj_ldx_nc_br_integral_algclosed : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], ∃ (S : Type u) (_ : CommRing S) (_ : IsDomain S) (_ : IsDiscreteValuationRing S) (ψ : R →+* S), IsAlgClosed (IsLocalRing.ResidueField S) ∧ Function.Injective ψ ∧ Ideal.map ψ (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal S ∧ ψ.IsIntegral :=
by
  intro R _ _ _
  classical

  have L1 : ∀ (Ω : Type u) [Field Ω] (A : Subring Ω) (ϖ : Ω) (hϖ : ϖ ∈ A), ϖ⁻¹ ∉ A →
      (∀ x ∈ A, x ≠ 0 → ∃ n : ℕ, x * (ϖ ^ n)⁻¹ ∈ A ∧ (x * (ϖ ^ n)⁻¹)⁻¹ ∈ A) →
      IsDiscreteValuationRing ↥A ∧ Irreducible (⟨ϖ, hϖ⟩ : ↥A) := by
    intro Ω _ A ϖ hϖ hinv hfac
    have hϖ0 : ϖ ≠ 0 := by
      rintro rfl; apply hinv; simp [A.zero_mem]
    have hunit : ∀ a : A, IsUnit a ↔ (a : Ω) ≠ 0 ∧ (a : Ω)⁻¹ ∈ A := by
      intro a
      constructor
      · rintro ⟨w, rfl⟩
        have h1 : ((w : A) : Ω) * ((w⁻¹ : Aˣ) : A) = 1 := by
          show (((w : A) * ((w⁻¹ : Aˣ) : A) : A) : Ω) = 1
          rw [Units.mul_inv]; rfl
        have hne : ((w : A) : Ω) ≠ 0 := left_ne_zero_of_mul_eq_one h1
        refine ⟨hne, ?_⟩
        rw [inv_eq_of_mul_eq_one_right h1]; exact ((w⁻¹ : Aˣ) : A).2
      · rintro ⟨hne, hmem⟩
        refine isUnit_iff_exists_inv.mpr ⟨⟨_, hmem⟩, ?_⟩
        apply Subtype.ext
        show (a : Ω) * (a : Ω)⁻¹ = 1
        exact mul_inv_cancel₀ hne
    have key : ∀ x ∈ A, x ≠ 0 → x⁻¹ ∉ A → x * ϖ⁻¹ ∈ A := by
      intro x hx hx0 hxi
      obtain ⟨n, hv, hvi⟩ := hfac x hx hx0
      cases n with
      | zero => exact absurd (by simpa using hvi) hxi
      | succ m =>
        have e : x * ϖ⁻¹ = x * (ϖ ^ (m + 1))⁻¹ * ϖ ^ m := by
          field_simp
          ring
        rw [e]
        exact A.mul_mem hv (A.pow_mem hϖ m)
    have hirr : Irreducible (⟨ϖ, hϖ⟩ : ↥A) := by
      rw [irreducible_iff]
      refine ⟨fun h => hinv ((hunit _).mp h).2, ?_⟩
      intro a b hab
      by_contra hcon
      rw [not_or] at hcon
      obtain ⟨ha, hb⟩ := hcon
      have hab' : ϖ = (a : Ω) * (b : Ω) := congrArg Subtype.val hab
      have ha0 : (a : Ω) ≠ 0 := by
        intro h; rw [h, zero_mul] at hab'; exact hϖ0 hab'
      have hb0 : (b : Ω) ≠ 0 := by
        intro h; rw [h, mul_zero] at hab'; exact hϖ0 hab'
      have hai : (a : Ω)⁻¹ ∉ A := fun h => ha ((hunit a).mpr ⟨ha0, h⟩)
      have hbi : (b : Ω)⁻¹ ∉ A := fun h => hb ((hunit b).mpr ⟨hb0, h⟩)
      have h1 := key a a.2 ha0 hai
      have h2 := key b b.2 hb0 hbi
      apply hinv
      have e : ϖ⁻¹ = ((a : Ω) * ϖ⁻¹) * ((b : Ω) * ϖ⁻¹) := by
        rw [show ((a : Ω) * ϖ⁻¹) * ((b : Ω) * ϖ⁻¹) = ((a : Ω) * (b : Ω)) * ϖ⁻¹ * ϖ⁻¹ by ring,
          ← hab']
        field_simp
      rw [e]
      exact A.mul_mem h1 h2
    refine ⟨IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
      ⟨⟨ϖ, hϖ⟩, hirr, ?_⟩, hirr⟩
    intro x hx
    have hx0 : (x : Ω) ≠ 0 := fun h => hx (Subtype.ext h)
    obtain ⟨n, hv, hvi⟩ := hfac x x.2 hx0
    have hv0 : (x : Ω) * (ϖ ^ n)⁻¹ ≠ 0 := mul_ne_zero hx0 (inv_ne_zero (pow_ne_zero n hϖ0))
    have hV : IsUnit (⟨_, hv⟩ : A) := (hunit _).mpr ⟨hv0, hvi⟩
    refine ⟨n, hV.unit, ?_⟩
    apply Subtype.ext
    show ϖ ^ n * ((x : Ω) * (ϖ ^ n)⁻¹) = x
    field_simp

  have L4 : ∀ (Ω : Type u) [Field Ω] [Algebra R Ω] (A : Subring Ω),
      (∀ a ∈ A, _root_.IsIntegral R a) → ∀ x : Ω, _root_.IsIntegral (↥A) x →
      _root_.IsIntegral R x := by
    intro Ω _ _ A hA x hx
    let C := integralClosure R Ω
    let ι : A →+* C := A.subtype.codRestrict C (fun a => hA a a.2)
    have hι : (algebraMap C Ω).comp ι = algebraMap A Ω := RingHom.ext fun a => rfl
    obtain ⟨g, hgm, hg⟩ := hx
    have hxC : _root_.IsIntegral C x := by
      refine ⟨g.map ι, hgm.map ι, ?_⟩
      rw [Polynomial.eval₂_map, hι]
      exact hg
    exact isIntegral_trans x hxC

  have L2 : ∀ (S : Type u) [CommRing S] [IsLocalRing S] (T : Type u) [CommRing T] [Nontrivial T]
      [Algebra S T] [Algebra.IsIntegral S T] (s : S), s ∈ IsLocalRing.maximalIdeal S →
      ¬ IsUnit (algebraMap S T s) ∧ ∀ x : T, IsUnit (1 + algebraMap S T s * x) := by
    intro S _ _ T _ _ _ _ s hs
    have hM : ∀ M : Ideal T, M.IsMaximal → algebraMap S T s ∈ M := by
      intro M hM
      have h1 : (M.comap (algebraMap S T)).IsMaximal :=
        Ideal.isMaximal_comap_of_isIntegral_of_isMaximal' (algebraMap S T)
          (fun x => Algebra.IsIntegral.isIntegral x) M
      have h2 := IsLocalRing.eq_maximalIdeal h1
      rw [← Ideal.mem_comap, h2]
      exact hs
    constructor
    · intro hu
      obtain ⟨M, hMm⟩ := Ideal.exists_maximal T
      exact hMm.ne_top (Ideal.eq_top_of_isUnit_mem M (hM M hMm) hu)
    · intro x
      by_contra hnu
      obtain ⟨M, hMm, hmem⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hnu)
      have h1 : (1 : T) ∈ M := by
        have := M.sub_mem hmem (M.mul_mem_right x (hM M hMm))
        simpa using this
      exact hMm.ne_top ((Ideal.eq_top_iff_one M).mpr h1)

  have L6 : ∀ (S : Type u) [CommRing S] [IsDomain S] [IsDiscreteValuationRing S] (ϖ : S),
      Irreducible ϖ → ∀ r : Polynomial S, r ≠ 0 →
      ∃ (n : ℕ) (r₁ : Polynomial S), r = Polynomial.C (ϖ ^ n) * r₁ ∧
        r₁.map (IsLocalRing.residue S) ≠ 0 := by
    intro S _ _ _ ϖ hϖ r hr
    have hmax := (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have hϖ0 : ϖ ≠ 0 := hϖ.ne_zero
    have main : ∀ N : ℕ, ∀ r : Polynomial S, r ≠ 0 → ¬ ϖ ^ N ∣ r.leadingCoeff →
        ∃ (n : ℕ) (r₁ : Polynomial S), r = Polynomial.C (ϖ ^ n) * r₁ ∧
          r₁.map (IsLocalRing.residue S) ≠ 0 := by
      intro N
      induction N with
      | zero => intro r _ h; exact absurd (by simp) h
      | succ N ih =>
        intro r hr hN
        by_cases hmap : r.map (IsLocalRing.residue S) = 0
        · have hdvd : Polynomial.C ϖ ∣ r := by
            rw [Polynomial.C_dvd_iff_dvd_coeff]
            intro i
            have h1 : IsLocalRing.residue S (r.coeff i) = 0 := by
              rw [← Polynomial.coeff_map, hmap, Polynomial.coeff_zero]
            rw [IsLocalRing.residue_eq_zero_iff, hmax, Ideal.mem_span_singleton] at h1
            exact h1
          obtain ⟨r', hr'⟩ := hdvd
          have hr'0 : r' ≠ 0 := by rintro rfl; rw [mul_zero] at hr'; exact hr hr'
          have hlc : r.leadingCoeff = ϖ * r'.leadingCoeff := by
            rw [hr', Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C]
          have hN' : ¬ ϖ ^ N ∣ r'.leadingCoeff := by
            intro h
            apply hN
            rw [hlc, pow_succ']
            exact mul_dvd_mul_left ϖ h
          obtain ⟨n, r₁, h1, h2⟩ := ih r' hr'0 hN'
          refine ⟨n + 1, r₁, ?_, h2⟩
          rw [hr', h1, ← mul_assoc, ← Polynomial.C_mul, pow_succ']
        · exact ⟨0, r, by simp, hmap⟩
    have hlc0 : r.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hr
    obtain ⟨n, w, hw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hlc0 hϖ
    refine main (n + 1) r hr ?_
    rintro ⟨c, hc⟩
    rw [hw] at hc
    have hc' : (w : S) = ϖ * c := by
      apply mul_right_cancel₀ (pow_ne_zero n hϖ0)
      rw [hc, pow_succ]; ring
    exact hϖ.not_isUnit (isUnit_of_dvd_unit ⟨c, hc'⟩ w.isUnit)

  have L5 : ∀ (S : Type u) [CommRing S] [IsDomain S] [IsDiscreteValuationRing S] (ϖ : S),
      Irreducible ϖ → ∀ (g r : Polynomial S), g.Monic →
      Irreducible (g.map (IsLocalRing.residue S)) →
      r.map (IsLocalRing.residue S) ≠ 0 → r.natDegree < g.natDegree →
      ∃ u v e : Polynomial S, u * r + v * g = 1 + Polynomial.C ϖ * e := by
    intro S _ _ _ ϖ hϖ g r hg hgi hr hdeg
    have hmax := (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have hndvd : ¬ g.map (IsLocalRing.residue S) ∣ r.map (IsLocalRing.residue S) := by
      intro h
      have h1 := Polynomial.natDegree_le_of_dvd h hr
      rw [hg.natDegree_map] at h1
      have h2 := Polynomial.natDegree_map_le (f := IsLocalRing.residue S) (p := r)
      omega
    obtain ⟨a, b, hab⟩ := (hgi.coprime_iff_not_dvd).mpr hndvd
    obtain ⟨a', rfl⟩ := Polynomial.map_surjective _ IsLocalRing.residue_surjective a
    obtain ⟨b', rfl⟩ := Polynomial.map_surjective _ IsLocalRing.residue_surjective b
    have hD : Polynomial.C ϖ ∣ b' * r + a' * g - 1 := by
      rw [Polynomial.C_dvd_iff_dvd_coeff]
      intro i
      have h1 : IsLocalRing.residue S ((b' * r + a' * g - 1).coeff i) = 0 := by
        rw [← Polynomial.coeff_map]
        simp only [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_one]
        rw [add_comm, hab, sub_self, Polynomial.coeff_zero]
      rw [IsLocalRing.residue_eq_zero_iff, hmax, Ideal.mem_span_singleton] at h1
      exact h1
    obtain ⟨e, he⟩ := hD
    exact ⟨b', a', e, by linear_combination he⟩

  have L7 : ∀ (S : Type u) [CommRing S] [IsDomain S] [IsDiscreteValuationRing S] (T : Type u)
      [CommRing T] [IsDomain T] [Algebra S T] [Algebra.IsIntegral S T] (ϖ : S), Irreducible ϖ →
      ∀ (g : Polynomial S) (θ : T), g.Monic → Irreducible (g.map (IsLocalRing.residue S)) →
      Polynomial.aeval θ g = 0 → (∀ t : T, ∃ h : Polynomial S, Polynomial.aeval θ h = t) →
      ¬ IsUnit (algebraMap S T ϖ) ∧ ∀ t : T, t ≠ 0 → ∃ (n : ℕ) (v : T), IsUnit v ∧
        t = algebraMap S T ϖ ^ n * v := by
    intro S _ _ _ T _ _ _ _ ϖ hϖ g θ hg hgi hθ hgen
    have hmax := (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have hϖm : ϖ ∈ IsLocalRing.maximalIdeal S := by
      rw [hmax]; exact Ideal.subset_span rfl
    obtain ⟨ha, hb⟩ := L2 S T ϖ hϖm
    refine ⟨ha, ?_⟩
    intro t ht
    obtain ⟨h, rfl⟩ := hgen t
    set r := h %ₘ g with hrdef
    have hrt : Polynomial.aeval θ r = Polynomial.aeval θ h := by
      conv_rhs => rw [← Polynomial.modByMonic_add_div h g]
      rw [map_add, map_mul, hθ, zero_mul, add_zero]
    have hr0 : r ≠ 0 := by
      intro h0; apply ht; rw [← hrt, h0, map_zero]
    have hdeg : r.natDegree < g.natDegree :=
      Polynomial.natDegree_lt_natDegree hr0 (Polynomial.degree_modByMonic_lt h hg)
    obtain ⟨n, r₁, hr1, hr1m⟩ := L6 S ϖ hϖ r hr0
    have hdeg1 : r₁.natDegree < g.natDegree := by
      rw [hr1, Polynomial.natDegree_C_mul (pow_ne_zero n hϖ.ne_zero)] at hdeg
      exact hdeg
    obtain ⟨u, v, e, huv⟩ := L5 S ϖ hϖ g r₁ hg hgi hr1m hdeg1
    have hy : Polynomial.aeval θ u * Polynomial.aeval θ r₁ =
        1 + algebraMap S T ϖ * Polynomial.aeval θ e := by
      have := congrArg (Polynomial.aeval θ) huv
      simpa [map_add, map_mul, hθ, Polynomial.aeval_C] using this
    have hyu : IsUnit (Polynomial.aeval θ r₁) := by
      have := hb (Polynomial.aeval θ e)
      rw [← hy] at this
      exact isUnit_of_mul_isUnit_right this
    refine ⟨n, Polynomial.aeval θ r₁, hyu, ?_⟩
    rw [← hrt, hr1, map_mul, Polynomial.aeval_C, map_pow]

  let K := FractionRing R
  let Ω := AlgebraicClosure K
  let f : R →+* Ω := algebraMap R Ω
  have hf : Function.Injective f := by
    have e : f = (algebraMap K Ω).comp (algebraMap R K) := IsScalarTower.algebraMap_eq R K Ω
    rw [e]
    exact (algebraMap K Ω).injective.comp (IsFractionRing.injective R K)
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  set π : Ω := f ϖ with hπ
  have hπ0 : π ≠ 0 := by
    intro h; apply hϖ.ne_zero; apply hf; rw [map_zero]; exact h
  let Q : Subring Ω → Prop := fun A => f.range ≤ A ∧ (∀ x ∈ A, _root_.IsIntegral R x) ∧
    π⁻¹ ∉ A ∧ (∀ x ∈ A, x ≠ 0 → ∃ n : ℕ, x * (π ^ n)⁻¹ ∈ A ∧ (x * (π ^ n)⁻¹)⁻¹ ∈ A)

  have hQ0 : Q f.range := by
    refine ⟨le_rfl, ?_, ?_, ?_⟩
    · intro x hx
      obtain ⟨r, rfl⟩ := RingHom.mem_range.mp hx
      exact isIntegral_algebraMap
    · intro hx
      obtain ⟨r, hr⟩ := RingHom.mem_range.mp hx
      apply hϖ.not_isUnit
      have e : f (ϖ * r) = f 1 := by
        rw [map_mul, hr, map_one]; exact mul_inv_cancel₀ hπ0
      exact isUnit_iff_exists_inv.mpr ⟨r, hf e⟩
    · intro x hx hx0
      obtain ⟨r, rfl⟩ := RingHom.mem_range.mp hx
      have hr0 : r ≠ 0 := by rintro rfl; exact hx0 (map_zero f)
      obtain ⟨n, w, hw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr0 hϖ
      have e : f r * (π ^ n)⁻¹ = f w := by
        rw [hw, map_mul, map_pow]; exact mul_inv_cancel_right₀ (pow_ne_zero n hπ0) _
      refine ⟨n, ?_, ?_⟩
      · rw [e]; exact RingHom.mem_range_self f _
      · rw [e]
        refine RingHom.mem_range.mpr ⟨((w⁻¹ : Rˣ) : R), ?_⟩
        exact (inv_eq_of_mul_eq_one_right (by rw [← map_mul, Units.mul_inv, map_one])).symm

  have hchain : ∀ c ⊆ {A | Q A}, IsChain (· ≤ ·) c → ∀ y ∈ c,
      ∃ ub ∈ {A | Q A}, ∀ z ∈ c, z ≤ ub := by
    intro c hc hch y hy
    have hQc : ∀ s ∈ c, Q s := fun s hs => hc hs
    have hdir : DirectedOn (· ≤ ·) c := hch.directedOn
    have hmem : ∀ x, x ∈ sSup c ↔ ∃ s ∈ c, x ∈ s := fun x =>
      Subring.mem_sSup_of_directedOn ⟨y, hy⟩ hdir
    refine ⟨sSup c, ⟨?_, ?_, ?_, ?_⟩, fun z hz => le_sSup hz⟩
    · exact (hQc y hy).1.trans (le_sSup hy)
    · intro x hx
      obtain ⟨s, hs, hxs⟩ := (hmem x).mp hx
      exact (hQc s hs).2.1 x hxs
    · intro hx
      obtain ⟨s, hs, hxs⟩ := (hmem _).mp hx
      exact (hQc s hs).2.2.1 hxs
    · intro x hx hx0
      obtain ⟨s, hs, hxs⟩ := (hmem x).mp hx
      obtain ⟨n, h1, h2⟩ := (hQc s hs).2.2.2 x hxs hx0
      exact ⟨n, le_sSup hs h1, le_sSup hs h2⟩
  obtain ⟨A, -, hAmax⟩ := zorn_le_nonempty₀ {A | Q A} hchain f.range hQ0
  have hQA : Q A := hAmax.prop
  have hπA : π ∈ A := hQA.1 (RingHom.mem_range_self f ϖ)

  obtain ⟨hdvr, hirrA⟩ := L1 Ω A π hπA hQA.2.2.1 hQA.2.2.2
  haveI := hdvr

  have halg : IsAlgClosed (IsLocalRing.ResidueField A) := by
    apply IsAlgClosed.of_exists_root
    intro p hpm hpi
    obtain ⟨q, hq⟩ := Polynomial.map_surjective _ IsLocalRing.residue_surjective p
    have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue A) :=
      (Polynomial.mem_lifts p).mpr ⟨q, hq⟩
    obtain ⟨g, hgp, hgdeg, hgm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hpm
    have hpdeg : p.natDegree ≠ 0 := by
      intro h0
      exact hpi.not_isUnit
        (by rw [Polynomial.eq_one_of_monic_natDegree_zero hpm h0]; exact isUnit_one)
    have hgΩm : (g.map (algebraMap A Ω)).Monic := hgm.map _
    have hgΩdeg : (g.map (algebraMap A Ω)).degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hgΩm.ne_zero, hgm.natDegree_map, hgdeg]
      exact_mod_cast hpdeg
    obtain ⟨θ, hθ⟩ := IsAlgClosed.exists_root _ hgΩdeg
    have hθ' : Polynomial.aeval θ g = 0 := by
      rw [Polynomial.aeval_def, ← Polynomial.eval_map]; exact hθ
    let T := Algebra.adjoin A ({θ} : Set Ω)
    have hθint : _root_.IsIntegral A θ := ⟨g, hgm, by rw [← Polynomial.aeval_def]; exact hθ'⟩
    haveI : Algebra.IsIntegral A T := Algebra.IsIntegral.adjoin (fun x hx => by
      rw [Set.mem_singleton_iff.mp hx]; exact hθint)
    let θT : T := ⟨θ, Algebra.self_mem_adjoin_singleton A θ⟩
    have hθT : Polynomial.aeval θT g = 0 := by
      have h1 : T.val (Polynomial.aeval θT g) = 0 := by
        rw [← Polynomial.aeval_algHom_apply]; exact hθ'
      exact Subtype.ext h1
    have hgen : ∀ t : T, ∃ h : Polynomial A, Polynomial.aeval θT h = t := by
      intro t
      have ht : (t : Ω) ∈ (Polynomial.aeval (R := A) θ).range := by
        rw [← Algebra.adjoin_singleton_eq_range_aeval]; exact t.2
      obtain ⟨h, hh⟩ := ht
      refine ⟨h, Subtype.ext ?_⟩
      rw [← hh]
      exact (Polynomial.aeval_algHom_apply T.val θT h).symm
    have hgi : Irreducible (g.map (IsLocalRing.residue A)) := by rw [hgp]; exact hpi
    obtain ⟨hna, hfacT⟩ := L7 A T ⟨π, hπA⟩ hirrA g θT hgm hgi hθT hgen
    have hAB : A ≤ T.toSubring := fun a ha => T.algebraMap_mem (⟨a, ha⟩ : A)
    have hQB : Q T.toSubring := by
      refine ⟨hQA.1.trans hAB, ?_, ?_, ?_⟩
      · intro x hx
        have h1 : _root_.IsIntegral A (⟨x, hx⟩ : T) := Algebra.IsIntegral.isIntegral _
        have h2 : _root_.IsIntegral A x := h1.map T.val
        exact L4 Ω A hQA.2.1 x h2
      · intro hx
        apply hna
        refine isUnit_iff_exists_inv.mpr ⟨⟨π⁻¹, hx⟩, Subtype.ext ?_⟩
        show π * π⁻¹ = 1
        exact mul_inv_cancel₀ hπ0
      · intro x hx hx0
        have hxT : (⟨x, hx⟩ : T) ≠ 0 := fun h => hx0 (congrArg Subtype.val h)
        obtain ⟨n, v, hv, hxv⟩ := hfacT ⟨x, hx⟩ hxT
        obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp hv
        have hxv' : x = π ^ n * (v : Ω) := by
          have := congrArg Subtype.val hxv
          simp only [Subalgebra.coe_mul, SubmonoidClass.coe_pow] at this
          exact this
        have hvw : (v : Ω) * (w : Ω) = 1 := congrArg Subtype.val hw
        have e : x * (π ^ n)⁻¹ = v := by
          rw [hxv', mul_comm, ← mul_assoc, inv_mul_cancel₀ (pow_ne_zero n hπ0), one_mul]
        refine ⟨n, ?_, ?_⟩
        · rw [e]; exact v.2
        · rw [e, inv_eq_of_mul_eq_one_right hvw]; exact w.2
    have hBA : T.toSubring = A := hAmax.eq_of_ge hQB hAB
    have hθA : θ ∈ A := by rw [← hBA]; exact Algebra.self_mem_adjoin_singleton A θ
    refine ⟨IsLocalRing.residue A ⟨θ, hθA⟩, ?_⟩
    have h1 : Polynomial.eval (⟨θ, hθA⟩ : A) g = 0 := by
      have e : A.subtype (Polynomial.eval (⟨θ, hθA⟩ : A) g) = 0 := by
        rw [← Polynomial.eval₂_hom]; rw [Polynomial.aeval_def] at hθ'; exact hθ'
      exact Subtype.ext e
    rw [← hgp, Polynomial.eval_map, Polynomial.eval₂_hom, h1, map_zero]

  let ψ : R →+* A := f.codRestrict A (fun r => hQA.1 (RingHom.mem_range_self f r))
  refine ⟨A, inferInstance, inferInstance, hdvr, ψ, halg, ?_, ?_, ?_⟩
  · intro a b hab; apply hf; exact congrArg Subtype.val hab
  · rw [(IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ, Ideal.map_span,
      Set.image_singleton, (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hirrA]
    rfl
  · intro x
    obtain ⟨p, hpm, hp⟩ := hQA.2.1 x x.2
    refine ⟨p, hpm, ?_⟩
    have hcomp : A.subtype.comp ψ = algebraMap R Ω := RingHom.ext fun r => rfl
    apply Subtype.val_injective
    show A.subtype (Polynomial.eval₂ ψ x p) = 0
    rw [Polynomial.hom_eval₂, hcomp]
    exact hp

theorem wcpa_dj_ldx_nc_br_completion : ∀ (S : Type u) [CommRing S] [IsDomain S] [IsDiscreteValuationRing S], ∃ (R' : Type u) (_ : CommRing R') (_ : IsDomain R') (_ : IsDiscreteValuationRing R') (c : S →+* R'), IsAdicComplete (IsLocalRing.maximalIdeal R') R' ∧ Function.Injective c ∧ Ideal.map c (IsLocalRing.maximalIdeal S) = IsLocalRing.maximalIdeal R' ∧ ∀ x : R', ∃ s : S, x - c s ∈ IsLocalRing.maximalIdeal R' :=
by
  intro S _ _ _
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible S
  obtain ⟨I, hI⟩ : ∃ I : Ideal S, I = Ideal.span {ϖ} := ⟨_, rfl⟩
  have hϖ0 : ϖ ≠ 0 := hϖ.ne_zero
  have hϖI : ϖ ∈ I := by rw [hI]; exact Ideal.mem_span_singleton_self ϖ
  have hIpow : ∀ k : ℕ, I ^ k = Ideal.span {ϖ ^ k} := fun k => by
    rw [hI, Ideal.span_singleton_pow]
  have hIsm : ∀ k : ℕ, I ^ k • (⊤ : Submodule S S) = Ideal.span {ϖ ^ k} := fun k => by
    rw [Ideal.smul_eq_mul, Ideal.mul_top, hIpow]
  have hcau : ∀ (f : AdicCompletion.AdicCauchySequence I S) {m n : ℕ}, m ≤ n →
      f n - f m ∈ Ideal.span {ϖ ^ m} := by
    intro f m n hmn
    rw [← hIpow]
    exact Ideal.Quotient.eq.mp (AdicCompletion.Ideal.mk_eq_mk I hmn f)
  have hmax : IsLocalRing.maximalIdeal S = I := by rw [hI]; exact hϖ.maximalIdeal_eq
  have hItop : I ≠ ⊤ := by
    intro h
    rw [hI] at h
    exact hϖ.not_isUnit (Ideal.span_singleton_eq_top.mp h)
  have hsub0 : ∀ (a b : S ⧸ I ^ 0), a = b := by
    intro a b
    haveI : Subsingleton (S ⧸ I ^ 0) :=
      Ideal.Quotient.subsingleton_iff.mpr (by rw [pow_zero, Ideal.one_eq_top])
    exact Subsingleton.elim a b
  have hec : ∀ (k : ℕ) (s : S), AdicCompletion.evalₐ I k (algebraMap S (AdicCompletion I S) s) =
      Ideal.Quotient.mk (I ^ k) s := by
    intro k s
    rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]

  have s1 : ∀ (n : ℕ) (x : AdicCompletion I S), AdicCompletion.evalₐ I n x = 0 →
      ∃ y : AdicCompletion I S, x = (algebraMap S (AdicCompletion I S) ϖ) ^ n * y := by
    intro n x hx
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I S x
    rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq_zero_iff_mem, hIpow] at hx
    have htail : ∀ k, f (k + n) ∈ Ideal.span {ϖ ^ n} := by
      intro k
      have h1 := hcau f (show n ≤ k + n by omega)
      have h2 := Ideal.add_mem _ h1 hx
      rwa [sub_add_cancel] at h2
    choose g hg using fun k => Ideal.mem_span_singleton'.mp (htail k)
    have hgc : ∀ k, g k ≡ g (k + 1) [SMOD I ^ k • (⊤ : Submodule S S)] := by
      intro k
      rw [SModEq.sub_mem, hIsm]
      have h1 := hcau f (show k + n ≤ k + 1 + n by omega)
      rw [← hg k, ← hg (k + 1)] at h1
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp h1
      apply Ideal.mem_span_singleton'.mpr
      refine ⟨-b, ?_⟩
      have hne : ϖ ^ n ≠ 0 := pow_ne_zero n hϖ0
      apply mul_right_cancel₀ hne
      rw [pow_add] at hb
      linear_combination -hb
    refine ⟨AdicCompletion.mk I S (AdicCompletion.AdicCauchySequence.mk I S g hgc), ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_mul, map_pow, hec, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, ← map_pow,
      ← map_mul]
    show Ideal.Quotient.mk (I ^ k) (f k) = Ideal.Quotient.mk (I ^ k) (ϖ ^ n * g k)
    rw [mul_comm, hg k]
    exact (AdicCompletion.Ideal.mk_eq_mk I (show k ≤ k + n by omega) f).symm

  have s2 : ∀ x : AdicCompletion I S, AdicCompletion.evalₐ I 1 x ≠ 0 → IsUnit x := by
    intro x hx
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I S x
    rw [AdicCompletion.evalₐ_mk, Ne, Ideal.Quotient.eq_zero_iff_mem, pow_one] at hx
    have hunit : ∀ k, 1 ≤ k → IsUnit (f k) := by
      intro k hk
      by_contra hnu
      have h1 : f k ∈ I := by
        have h0 : f k ∈ IsLocalRing.maximalIdeal S :=
          (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
        rwa [hmax] at h0
      have h2 := hcau f hk
      rw [pow_one, ← hI] at h2
      apply hx
      have h3 := I.sub_mem h1 h2
      rwa [sub_sub_cancel] at h3
    have hcg : ∀ k, Ring.inverse (f k) ≡ Ring.inverse (f (k + 1))
        [SMOD I ^ k • (⊤ : Submodule S S)] := by
      intro k
      rw [SModEq.sub_mem, hIsm]
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · rw [pow_zero, Ideal.span_singleton_one]; exact Submodule.mem_top
      · have e1 := Ring.mul_inverse_cancel (f k) (hunit k hk)
        have e2 := Ring.mul_inverse_cancel (f (k + 1)) (hunit (k + 1) (by omega))
        have h3 := hcau f (show k ≤ k + 1 by omega)
        have key : Ring.inverse (f k) - Ring.inverse (f (k + 1)) =
            Ring.inverse (f k) * Ring.inverse (f (k + 1)) * (f (k + 1) - f k) := by
          linear_combination (-(Ring.inverse (f k))) * e2 + Ring.inverse (f (k + 1)) * e1
        rw [key]
        exact Ideal.mul_mem_left _ _ h3
    refine isUnit_iff_exists_inv.mpr ⟨AdicCompletion.mk I S
      (AdicCompletion.AdicCauchySequence.mk I S (fun k => Ring.inverse (f k)) hcg), ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [map_mul, map_one, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, ← map_mul]
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · exact hsub0 _ _
    · show Ideal.Quotient.mk (I ^ k) (f k * Ring.inverse (f k)) = 1
      rw [Ring.mul_inverse_cancel _ (hunit k hk), map_one]

  have s3 : ∀ (A : Type u) [CommRing A] [Nontrivial A] (q : A), ¬ IsUnit q →
      (∀ k : ℕ, q ^ k ≠ 0) → (∀ x : A, x ≠ 0 → ∃ (n : ℕ) (w : A), IsUnit w ∧ x = q ^ n * w) →
      ∃ (_ : IsDomain A), IsDiscreteValuationRing A ∧ Irreducible q := by
    intro A _ _ q hq hpow hfac
    have hnzd : NoZeroDivisors A := by
      refine ⟨fun {a b} hab => ?_⟩
      by_contra hne
      push_neg at hne
      obtain ⟨i, u, hu, rfl⟩ := hfac a hne.1
      obtain ⟨j, v, hv, rfl⟩ := hfac b hne.2
      apply hpow (i + j)
      have h1 : q ^ (i + j) * (u * v) = 0 := by rw [← hab]; ring
      exact (hu.mul hv).mul_left_eq_zero.mp h1
    haveI := hnzd
    haveI hdom : IsDomain A := NoZeroDivisors.to_isDomain A
    have hq0 : q ≠ 0 := by simpa using hpow 1
    have hirr : Irreducible q := by
      refine ⟨hq, fun {a b} hab => ?_⟩
      have ha0 : a ≠ 0 := by rintro rfl; apply hq0; rw [hab, zero_mul]
      have hb0 : b ≠ 0 := by rintro rfl; apply hq0; rw [hab, mul_zero]
      obtain ⟨i, u, hu, rfl⟩ := hfac a ha0
      obtain ⟨j, v, hv, rfl⟩ := hfac b hb0
      rcases Nat.eq_zero_or_pos i with rfl | hi
      · left; simpa using hu
      rcases Nat.eq_zero_or_pos j with rfl | hj
      · right; simpa using hv
      exfalso
      apply hq
      obtain ⟨m, hm⟩ : ∃ m, i + j = m + 2 := ⟨i + j - 2, by omega⟩
      have h1 : q * 1 = q * (q * (q ^ m * (u * v))) := by
        calc q * 1 = q ^ i * u * (q ^ j * v) := by rw [mul_one]; exact hab
          _ = q ^ (i + j) * (u * v) := by ring
          _ = q ^ (m + 2) * (u * v) := by rw [hm]
          _ = q * (q * (q ^ m * (u * v))) := by ring
      have h2 := mul_left_cancel₀ hq0 h1
      exact isUnit_iff_exists_inv.mpr ⟨_, h2.symm⟩
    refine ⟨hdom, IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
      ⟨q, hirr, fun {x} hx => ?_⟩, hirr⟩
    obtain ⟨n, w, hw, rfl⟩ := hfac x hx
    exact ⟨n, ⟨hw.unit, by rw [IsUnit.unit_spec]⟩⟩

  haveI : IsHausdorff I S := IsHausdorff.of_isDomain I hItop
  have hcinj : Function.Injective (algebraMap S (AdicCompletion I S)) := by
    intro a b hab
    rw [AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply] at hab
    exact AdicCompletion.of_injective I S hab
  haveI hnt : Nontrivial (AdicCompletion I S) := ⟨⟨0, 1, fun h => by
    have h1 := hcinj (show algebraMap S (AdicCompletion I S) 0 =
      algebraMap S (AdicCompletion I S) 1 by rw [map_zero, map_one]; exact h)
    exact zero_ne_one h1⟩⟩
  have hone : (1 : S ⧸ I ^ 1) ≠ 0 := by
    intro h
    rw [← map_one (Ideal.Quotient.mk (I ^ 1)), Ideal.Quotient.eq_zero_iff_mem, pow_one] at h
    exact hItop ((Ideal.eq_top_iff_one I).mpr h)
  have hpnu : ¬ IsUnit (algebraMap S (AdicCompletion I S) ϖ) := by
    rintro ⟨v, hv⟩
    have hϖ1 : Ideal.Quotient.mk (I ^ 1) ϖ = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem, pow_one]; exact hϖI
    have h1 := congrArg (AdicCompletion.evalₐ I 1) (v.mul_inv)
    rw [hv, map_mul, map_one, hec, hϖ1, zero_mul] at h1
    exact hone h1.symm
  have hppow : ∀ k : ℕ, (algebraMap S (AdicCompletion I S) ϖ) ^ k ≠ 0 := by
    intro k h
    have h1 := congrArg (AdicCompletion.evalₐ I (k + 1)) h
    rw [map_pow, hec, map_zero, ← map_pow, Ideal.Quotient.eq_zero_iff_mem, hIpow] at h1
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp h1
    apply hϖ.not_isUnit
    have h2 : ϖ ^ k * (a * ϖ) = ϖ ^ k * 1 := by linear_combination ha
    exact isUnit_iff_exists_inv.mpr
      ⟨a, by rw [mul_comm]; exact mul_left_cancel₀ (pow_ne_zero k hϖ0) h2⟩
  have hfac : ∀ x : AdicCompletion I S, x ≠ 0 → ∃ (n : ℕ) (w : AdicCompletion I S),
      IsUnit w ∧ x = (algebraMap S (AdicCompletion I S) ϖ) ^ n * w := by
    intro x hx
    have hex : ∃ n, AdicCompletion.evalₐ I (n + 1) x ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hx
      apply AdicCompletion.ext_evalₐ
      intro m
      rw [map_zero]
      rcases m with _ | m
      · exact hsub0 _ _
      · exact hcon m
    obtain ⟨n, hn, hmin⟩ : ∃ n, AdicCompletion.evalₐ I (n + 1) x ≠ 0 ∧
        ∀ j < n, AdicCompletion.evalₐ I (j + 1) x = 0 :=
      ⟨Nat.find hex, Nat.find_spec hex, fun j hj => not_not.mp (Nat.find_min hex hj)⟩
    have hn0 : AdicCompletion.evalₐ I n x = 0 := by
      rcases n with _ | j
      · exact hsub0 _ _
      · exact hmin j (by omega)
    obtain ⟨y, rfl⟩ := s1 n x hn0
    refine ⟨n, y, s2 y ?_, rfl⟩
    intro hy
    obtain ⟨z, rfl⟩ := s1 1 y hy
    apply hn
    have hm : Ideal.Quotient.mk (I ^ (n + 1)) (ϖ ^ (n + 1)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow hϖI _)
    rw [← mul_assoc, ← pow_add, map_mul, map_pow, hec, ← map_pow, hm, zero_mul]
  obtain ⟨hdom, hdvr, hpirr⟩ :=
    s3 (AdicCompletion I S) (algebraMap S (AdicCompletion I S) ϖ) hpnu hppow hfac
  haveI := hdom
  haveI := hdvr
  have hmaxR : IsLocalRing.maximalIdeal (AdicCompletion I S) =
      Ideal.span {algebraMap S (AdicCompletion I S) ϖ} := hpirr.maximalIdeal_eq
  have hmapI : Ideal.map (algebraMap S (AdicCompletion I S)) I =
      Ideal.span {algebraMap S (AdicCompletion I S) ϖ} := by
    calc Ideal.map (algebraMap S (AdicCompletion I S)) I =
        Ideal.map (algebraMap S (AdicCompletion I S)) (Ideal.span {ϖ}) := by rw [← hI]
      _ = _ := by rw [Ideal.map_span, Set.image_singleton]
  have hmapc : Ideal.map (algebraMap S (AdicCompletion I S)) (IsLocalRing.maximalIdeal S) =
      IsLocalRing.maximalIdeal (AdicCompletion I S) := by
    rw [hmax, hmapI, hmaxR]
  have hcomp : IsAdicComplete (IsLocalRing.maximalIdeal (AdicCompletion I S))
      (AdicCompletion I S) := by
    have h1 : IsAdicComplete I (AdicCompletion I S) :=
      AdicCompletion.isAdicComplete (by rw [hI]; exact Submodule.fg_span_singleton ϖ)
    have h2 := (IsAdicComplete.map_algebraMap_iff (S := AdicCompletion I S) I
      (AdicCompletion I S)).mpr h1
    rw [hmapI, ← hmaxR] at h2
    exact h2
  have hres : ∀ x : AdicCompletion I S, ∃ s : S,
      x - algebraMap S (AdicCompletion I S) s ∈ IsLocalRing.maximalIdeal (AdicCompletion I S) := by
    intro x
    obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I 1 x)
    refine ⟨s, ?_⟩
    obtain ⟨y, hy⟩ := s1 1 (x - algebraMap S (AdicCompletion I S) s)
      (by rw [map_sub, hec, hs, sub_self])
    rw [hy, hmaxR, pow_one]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
  exact ⟨AdicCompletion I S, inferInstance, hdom, hdvr, algebraMap S (AdicCompletion I S),
    hcomp, hcinj, hmapc, hres⟩

theorem wcpa_dj_ldx_nc_br_gen_square : ∀ (R R' : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [CommRing R'] [IsDomain R'] [IsDiscreteValuationRing R'] (φ : R →+* R'), Function.Injective φ → Ideal.map φ (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal R' → ∃ ε : Spec (.of (FractionRing R')) ⟶ Spec (.of (FractionRing R)), IsPullback ε (Spec.map (CommRingCat.ofHom (algebraMap R' (FractionRing R')))) (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) (Spec.map (CommRingCat.ofHom φ)) :=
by
  intro R R' _ _ _ _ _ _ φ hinj hmax
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hm : IsLocalRing.maximalIdeal R' = Ideal.span {φ ϖ} := by
    rw [← hmax, hϖ.maximalIdeal_eq, Ideal.map_span, Set.image_singleton]
  have hϖ0 : φ ϖ ≠ 0 := by
    intro h
    exact hϖ.ne_zero (hinj (h.trans (map_zero φ).symm))
  have hϖ' : Irreducible (φ ϖ) :=
    IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal (φ ϖ) hϖ0 hm
  have hy : nonZeroDivisors R ≤ Submonoid.comap φ (nonZeroDivisors R') :=
    nonZeroDivisors_le_comap_nonZeroDivisors_of_injective φ hinj
  have hle : Submonoid.map φ (nonZeroDivisors R) ≤ nonZeroDivisors R' :=
    Submonoid.map_le_iff_le_comap.mpr hy
  have hdvd : ∀ n ∈ nonZeroDivisors R', ∃ m ∈ Submonoid.map φ (nonZeroDivisors R), n ∣ m := by
    intro n hn
    have hn0 : n ≠ 0 := nonZeroDivisors.ne_zero hn
    obtain ⟨k, hk⟩ := IsDiscreteValuationRing.associated_pow_irreducible hn0 hϖ'
    refine ⟨φ (ϖ ^ k), Submonoid.mem_map_of_mem φ
      (mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hϖ.ne_zero)), ?_⟩
    rw [map_pow]
    exact hk.dvd
  have hloc : IsLocalization (Submonoid.map φ (nonZeroDivisors R)) (FractionRing R') :=
    (IsLocalization.iff_of_le_of_exists_dvd _ _ hle hdvd).mpr inferInstance
  let φK : FractionRing R →+* FractionRing R' :=
    IsLocalization.map (M := nonZeroDivisors R) (T := nonZeroDivisors R') (FractionRing R') φ hy
  have hcomm : φK.comp (algebraMap R (FractionRing R)) = (algebraMap R' (FractionRing R')).comp φ :=
    IsLocalization.map_comp hy
  have hpo := CommRingCat.isPushout_of_isLocalization (R := R) (S := R') (Rₘ := FractionRing R)
    (Sₘ := FractionRing R') φ φK hcomm (nonZeroDivisors R)
  exact ⟨Spec.map (CommRingCat.ofHom φK),
    (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hpo).flip⟩

theorem wcpa_dj_ldx_nc_br_fibre_rigid : ∀ (R R' : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [CommRing R'] [IsDomain R'] [IsDiscreteValuationRing R'] (φ : R →+* R'), Function.Injective φ → Ideal.map φ (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal R' → (∀ x : R', ∃ p : Polynomial R, p.Monic ∧ Polynomial.eval₂ φ x p ∈ IsLocalRing.maximalIdeal R') → ∀ (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (w w' : ↥(Limits.pullback u (Spec.map (CommRingCat.ofHom φ)))), w' ⤳ w → Limits.pullback.fst u (Spec.map (CommRingCat.ofHom φ)) w' = Limits.pullback.fst u (Spec.map (CommRingCat.ofHom φ)) w → Limits.pullback.snd u (Spec.map (CommRingCat.ofHom φ)) w = IsLocalRing.closedPoint R' → w' = w :=
by
  intro R R' _ _ _ _ _ _ φ _hinj hmax hint Z u w w' hsp hF hG

  have incomp : ∀ {S T : Type u} [CommRing S] [CommRing T] [IsDomain T] (f : S →+* T)
      (J : Ideal T) (x : T), x ∈ J → x ≠ 0 → f.IsIntegralElem x →
      Ideal.comap f ⊥ < Ideal.comap f J := by
    intro S T _ _ _ f J x hx hx0 hfx
    letI := f.toAlgebra
    have hmem : x ∈ (J : Set T) \ ((⊥ : Ideal T) : Set T) := ⟨hx, by simpa using hx0⟩
    exact Ideal.under_lt_under_of_integral_mem_sdiff (R := S) (I := (⊥ : Ideal T)) bot_le hmem hfx

  have intgen : ∀ {S T : Type u} [CommRing S] [CommRing T] (f : S →+* T) (s : Set T),
      Subring.closure s = ⊤ → (∀ t ∈ s, f.IsIntegralElem t) → ∀ t, f.IsIntegralElem t := by
    intro S T _ _ f s hs h t
    letI := f.toAlgebra
    have hle : Subring.closure s ≤ (integralClosure S T).toSubring := by
      rw [Subring.closure_le]
      intro x hx
      rw [SetLike.mem_coe, Subalgebra.mem_toSubring, mem_integralClosure_iff]
      exact h x hx
    have := hle (hs ▸ Subring.mem_top t)
    rw [Subalgebra.mem_toSubring, mem_integralClosure_iff] at this
    exact this

  obtain ⟨U, hU, hzU, -⟩ := exists_isAffineOpen_mem_and_subset
    (x := Limits.pullback.fst u (Spec.map (CommRingCat.ofHom φ)) w) (U := ⊤) trivial
  haveI hιo : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
  let α : R →+* Γ(Z, U) := (Spec.preimage (hU.fromSpec ≫ u)).hom
  have hα : Spec.map (CommRingCat.ofHom α) = hU.fromSpec ≫ u := Spec.map_preimage _
  letI : Algebra R Γ(Z, U) := α.toAlgebra
  letI : Algebra R R' := φ.toAlgebra
  let iA : Γ(Z, U) →+* TensorProduct R Γ(Z, U) R' := Algebra.TensorProduct.includeLeftRingHom
  let iR : R' →+* TensorProduct R Γ(Z, U) R' := Algebra.TensorProduct.includeRight.toRingHom
  have h1 : iA.comp α = iR.comp φ := Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
  have hcl : Subring.closure (Set.range iA ∪ Set.range iR) = ⊤ := by
    rw [eq_top_iff]
    rintro t -
    induction t using TensorProduct.induction_on with
    | zero => exact zero_mem _
    | tmul a r =>
      have e : a ⊗ₜ[R] r = iA a * iR r := by
        show a ⊗ₜ[R] r = (a ⊗ₜ[R] (1 : R')) * ((1 : Γ(Z, U)) ⊗ₜ[R] r)
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [e]
      exact mul_mem (Subring.subset_closure (Or.inl ⟨a, rfl⟩))
        (Subring.subset_closure (Or.inr ⟨r, rfl⟩))
    | add x y hx hy => exact add_mem hx hy

  have core : ∀ (Q Q' : Ideal (TensorProduct R Γ(Z, U) R')), Q'.IsPrime → Q' ≤ Q →
      Ideal.comap iA Q = Ideal.comap iA Q' → Ideal.comap iR Q = IsLocalRing.maximalIdeal R' →
      Q = Q' := by
    intro Q Q' hQ' hQQ' hQA hQR
    have hle : IsLocalRing.maximalIdeal R' ≤ Ideal.comap iR Q' := by
      rw [← hmax, Ideal.map_le_iff_le_comap]
      have e : Ideal.comap φ (Ideal.comap iR Q') =
          Ideal.comap φ (IsLocalRing.maximalIdeal R') := by
        rw [Ideal.comap_comap, ← h1, ← Ideal.comap_comap, ← hQA, Ideal.comap_comap, h1,
          ← Ideal.comap_comap, hQR]
      rw [e]
      exact (Ideal.map_le_iff_le_comap).mp hmax.le
    have hint' : ∀ t, ((Ideal.Quotient.mk Q').comp iA).IsIntegralElem t := by
      apply intgen _ (Set.range ((Ideal.Quotient.mk Q').comp iA) ∪
        Set.range ((Ideal.Quotient.mk Q').comp iR))
      · rw [eq_top_iff]
        intro d _
        obtain ⟨b0, rfl⟩ := Ideal.Quotient.mk_surjective d
        have hle2 : Subring.closure (Set.range iA ∪ Set.range iR) ≤
            (Subring.closure (Set.range ((Ideal.Quotient.mk Q').comp iA) ∪
              Set.range ((Ideal.Quotient.mk Q').comp iR))).comap (Ideal.Quotient.mk Q') := by
          rw [Subring.closure_le]
          rintro _ (⟨a, rfl⟩ | ⟨r, rfl⟩)
          · exact Subring.subset_closure (Or.inl ⟨a, rfl⟩)
          · exact Subring.subset_closure (Or.inr ⟨r, rfl⟩)
        exact hle2 (hcl ▸ Subring.mem_top b0)
      · rintro _ (⟨a, rfl⟩ | ⟨r, rfl⟩)
        · exact RingHom.isIntegralElem_map _
        · obtain ⟨p, hpm, hp0⟩ := hint r
          refine ⟨p.map α, hpm.map α, ?_⟩
          rw [Polynomial.eval₂_map]
          have e : ((Ideal.Quotient.mk Q').comp iA).comp α =
              ((Ideal.Quotient.mk Q').comp iR).comp φ := by
            rw [RingHom.comp_assoc, h1, ← RingHom.comp_assoc]
          rw [e, ← Polynomial.hom_eval₂, RingHom.comp_apply]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (hle hp0)
    by_contra hne
    have hlt : Q' < Q := lt_of_le_of_ne hQQ' (Ne.symm hne)
    obtain ⟨x, hxQ, hxQ'⟩ := SetLike.exists_of_lt hlt
    have := incomp ((Ideal.Quotient.mk Q').comp iA) (Ideal.map (Ideal.Quotient.mk Q') Q)
      (Ideal.Quotient.mk Q' x) (Ideal.mem_map_of_mem _ hxQ)
      (fun h0 => hxQ' (Ideal.Quotient.eq_zero_iff_mem.mp h0)) (hint' _)
    rw [← Ideal.comap_comap, ← Ideal.comap_comap, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker,
      Ideal.comap_map_mk hQQ', hQA] at this
    exact lt_irrefl _ this

  have hpb := isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_tensorProduct R Γ(Z, U) R')
  have e1 : Spec.map (CommRingCat.ofHom (algebraMap R Γ(Z, U))) = hU.fromSpec ≫ u := hα
  rw [e1] at hpb
  have hw : (Spec.map (CommRingCat.ofHom iA) ≫ hU.fromSpec) ≫ u =
      Spec.map (CommRingCat.ofHom iR) ≫ Spec.map (CommRingCat.ofHom φ) := by
    rw [Category.assoc]; exact hpb.w
  let κ := Limits.pullback.lift _ _ hw
  have hκF : κ ≫ Limits.pullback.fst u (Spec.map (CommRingCat.ofHom φ)) =
      Spec.map (CommRingCat.ofHom iA) ≫ hU.fromSpec := Limits.pullback.lift_fst _ _ _
  have hκG : κ ≫ Limits.pullback.snd u (Spec.map (CommRingCat.ofHom φ)) =
      Spec.map (CommRingCat.ofHom iR) := Limits.pullback.lift_snd _ _ _
  have hbig := hpb.flip
  rw [← hκG] at hbig
  have sq : IsPullback κ (Spec.map (CommRingCat.ofHom iA))
      (Limits.pullback.fst u (Spec.map (CommRingCat.ofHom φ))) hU.fromSpec :=
    IsPullback.of_right hbig hκF (IsPullback.of_hasPullback u _).flip
  haveI hκo : IsOpenImmersion κ :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) sq.flip hιo
  have hzr : Limits.pullback.fst u (Spec.map (CommRingCat.ofHom φ)) w ∈
      Set.range hU.fromSpec := by
    rw [hU.range_fromSpec]; exact hzU
  obtain ⟨y, hy⟩ := hzr
  obtain ⟨q, hq, hqy⟩ := Scheme.exists_preimage_of_isPullback sq w y hy.symm
  obtain ⟨q', hq', hq'y⟩ := Scheme.exists_preimage_of_isPullback sq w' y (hF.trans hy.symm)
  have hsp' : q' ⤳ q :=
    (κ.isOpenEmbedding.isInducing.specializes_iff).mp (by rw [hq, hq']; exact hsp)
  have hle : (q' : PrimeSpectrum (TensorProduct R Γ(Z, U) R')).asIdeal ≤
      (q : PrimeSpectrum (TensorProduct R Γ(Z, U) R')).asIdeal := by
    have := (PrimeSpectrum.le_iff_specializes (R := TensorProduct R Γ(Z, U) R') q' q).mpr hsp'
    exact this
  have hA : Ideal.comap iA (q : PrimeSpectrum (TensorProduct R Γ(Z, U) R')).asIdeal =
      Ideal.comap iA (q' : PrimeSpectrum (TensorProduct R Γ(Z, U) R')).asIdeal := by
    have := congrArg PrimeSpectrum.asIdeal (hqy.trans hq'y.symm)
    rw [Spec.map_apply, Spec.map_apply] at this
    exact this
  have hR : Ideal.comap iR (q : PrimeSpectrum (TensorProduct R Γ(Z, U) R')).asIdeal =
      IsLocalRing.maximalIdeal R' := by
    have h0 : Spec.map (CommRingCat.ofHom iR) q = IsLocalRing.closedPoint R' := by
      rw [← hκG, Scheme.Hom.comp_apply, hq]; exact hG
    have := congrArg PrimeSpectrum.asIdeal h0
    rw [Spec.map_apply] at this
    exact this
  have hQ := core _ _ (q' : PrimeSpectrum (TensorProduct R Γ(Z, U) R')).isPrime hle hA hR
  have hqq : (q : PrimeSpectrum (TensorProduct R Γ(Z, U) R')) = q' := PrimeSpectrum.ext hQ
  rw [← hq, ← hq']
  exact congrArg κ hqq.symm

theorem wcpa_dj_ldx_nc_br_spec_map : ∀ (R R' : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [CommRing R'] [IsDomain R'] [IsDiscreteValuationRing R'] (φ : R →+* R'), Function.Injective φ → Ideal.map φ (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal R' → Flat (Spec.map (CommRingCat.ofHom φ)) ∧ Surjective (Spec.map (CommRingCat.ofHom φ)) ∧ ∀ c : Spec (.of R'), Spec.map (CommRingCat.ofHom φ) c = IsLocalRing.closedPoint R → c = IsLocalRing.closedPoint R' :=
by
  intro R R' _ _ _ _ _ _ φ hinj hmax
  have hasI : ∀ c : Spec (.of R'),
      (Spec.map (CommRingCat.ofHom φ) c).asIdeal = Ideal.comap φ c.asIdeal := by
    intro c
    rw [Spec.map_apply]
    rfl
  have hC : ∀ c : Spec (.of R'), Spec.map (CommRingCat.ofHom φ) c = IsLocalRing.closedPoint R →
      c = IsLocalRing.closedPoint R' := by
    intro c hc
    have h1 : Ideal.comap φ c.asIdeal = IsLocalRing.maximalIdeal R := by
      rw [← hasI c, hc]
      rfl
    have h2 : IsLocalRing.maximalIdeal R' ≤ c.asIdeal := by
      rw [← hmax, Ideal.map_le_iff_le_comap, h1]
    have h3 := (IsLocalRing.maximalIdeal.isMaximal R').eq_of_le c.isPrime.ne_top h2
    exact PrimeSpectrum.ext h3.symm
  refine ⟨?_, ?_, hC⟩
  · rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
    letI := φ.toAlgebra
    have : Module.IsTorsionFree R R' := by
      rw [Module.isTorsionFree_iff_smul_eq_zero]
      intro r x h
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra] at h
      rcases mul_eq_zero.mp h with h | h
      · left; exact hinj (by rw [h, map_zero])
      · right; exact h
    have : Module.Flat R R' := inferInstance
    exact this
  · rw [surjective_iff]
    intro p
    by_cases hp : p.asIdeal = ⊥
    · let c0 : Spec (.of R') := ⟨⊥, Ideal.isPrime_bot⟩
      refine ⟨c0, ?_⟩
      apply PrimeSpectrum.ext
      refine (hasI c0).trans ?_
      rw [hp]
      exact Ideal.comap_bot_of_injective φ hinj
    · haveI := p.isPrime
      have hpm : p.asIdeal.IsMaximal := IsPrime.to_maximal_ideal hp
      have hpeq := IsLocalRing.eq_maximalIdeal hpm
      let c1 : Spec (.of R') := IsLocalRing.closedPoint R'
      refine ⟨c1, ?_⟩
      apply PrimeSpectrum.ext
      refine (hasI c1).trans ?_
      rw [hpeq]
      have h2 : IsLocalRing.maximalIdeal R ≤ Ideal.comap φ (IsLocalRing.maximalIdeal R') := by
        rw [← Ideal.map_le_iff_le_comap, hmax]
      have hpr : (Ideal.comap φ (IsLocalRing.maximalIdeal R')).IsPrime := Ideal.IsPrime.comap φ
      exact ((IsLocalRing.maximalIdeal.isMaximal R).eq_of_le hpr.ne_top h2).symm

theorem wcpa_dj_lqg_bc_config : ∀ (T Z Z' : Scheme.{u}) (u : Z ⟶ T) (u' : Z' ⟶ T) (n : ℕ) (τ : Fin n → (T ⟶ Z)) (τ' : Fin n → (T ⟶ Z')), wcpaDjStablePtd u n τ → wcpaDjStablePtd u' n τ' → GeometricallyConnected u → GeometricallyConnected u' → ∀ (V Y : Scheme.{u}) (v : V ⟶ T) (π : Y ⟶ V) (a : Y ⟶ Z) (a' : Y ⟶ Z'), IsPullback a π u v → IsPullback a' π u' v → (∀ i, ∃ t : V ⟶ Y, t ≫ π = 𝟙 V ∧ t ≫ a = v ≫ τ i ∧ t ≫ a' = v ≫ τ' i) → ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (b : Spec (.of R) ⟶ T) (e : Spec (.of (FractionRing R)) ⟶ Y), Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ b = e ≫ π ≫ v → ∃ (τb : Fin n → (Spec (.of R) ⟶ Limits.pullback u b)) (τb' : Fin n → (Spec (.of R) ⟶ Limits.pullback u' b)) (YK : Scheme.{u}) (πK : YK ⟶ Spec (.of (FractionRing R))) (aK : YK ⟶ Limits.pullback u b) (aK' : YK ⟶ Limits.pullback u' b) (sK : Spec (.of (FractionRing R)) ⟶ YK), wcpaDjStablePtd (Limits.pullback.snd u b) n τb ∧ wcpaDjStablePtd (Limits.pullback.snd u' b) n τb' ∧ GeometricallyConnected (Limits.pullback.snd u b) ∧ GeometricallyConnected (Limits.pullback.snd u' b) ∧ (∀ i, τb i ≫ Limits.pullback.snd u b = 𝟙 _ ∧ τb i ≫ Limits.pullback.fst u b = b ≫ τ i) ∧ (∀ i, τb' i ≫ Limits.pullback.snd u' b = 𝟙 _ ∧ τb' i ≫ Limits.pullback.fst u' b = b ≫ τ' i) ∧ IsPullback aK πK (Limits.pullback.snd u b) (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) ∧ IsPullback aK' πK (Limits.pullback.snd u' b) (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) ∧ (∀ i, ∃ t : Spec (.of (FractionRing R)) ⟶ YK, t ≫ πK = 𝟙 _ ∧ t ≫ aK = Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ τb i ∧ t ≫ aK' = Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ τb' i) ∧ sK ≫ πK = 𝟙 _ ∧ sK ≫ aK ≫ Limits.pullback.fst u b = e ≫ a ∧ sK ≫ aK' ≫ Limits.pullback.fst u' b = e ≫ a' :=
by
  have wcpa_dj_lcp_stableptd_basechange : ∀ {Z T T' : Scheme.{u}} (uu : Z ⟶ T) (n : ℕ)
      (τ : Fin n → (T ⟶ Z)) (b : T' ⟶ T), wcpaDjStablePtd uu n τ →
      ∃ τ' : Fin n → (T' ⟶ Limits.pullback uu b),
        wcpaDjStablePtd (Limits.pullback.snd uu b) n τ' ∧
        (∀ i, τ' i ≫ Limits.pullback.snd uu b = 𝟙 T') ∧
        (∀ i, τ' i ≫ Limits.pullback.fst uu b = b ≫ τ i) := by
    have wcpa_dj_mm_section_point_unique : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
        (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
        τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) ↔ c = τ (g c) := by
      intro X P V C f b ψ g σ τ H1 H2 H3 H4 c
      have hcomp : ∀ x : V, ψ (τ x) = σ (b x) := by
        intro x
        rw [← Scheme.Hom.comp_apply, H4, Scheme.Hom.comp_apply]
      have hgτ : ∀ x : V, g (τ x) = x := by
        intro x
        rw [← Scheme.Hom.comp_apply, H3]
        rfl
      constructor
      · intro h
        have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
          rw [H3, H2]
          exact IsPullback.id_horiz b
        have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
        obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
        have hg : g c = p := by rw [← hp, hgτ]
        rw [hg, hp]
      · intro h
        calc ψ c = ψ (τ (g c)) := congrArg ψ h
          _ = σ (b (g c)) := hcomp (g c)
    have wcpa_dj_mm_semistable_basechange : ∀ (M P'' Z : Scheme.{u}) (φ : P'' ⟶ M) (u : Z ⟶ M),
        wcpaDjSemistable u → wcpaDjSemistable (Limits.pullback.snd u φ) := by
      have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
          (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
            Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
        intro A B _ _ _ _ σ n
        rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
        apply Ideal.pow_right_mono
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
        intro h
        exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
      have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
          (x : AdicCompletion I A),
          Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
        intro A _ I m n h x
        obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
        rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
          Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
        have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
        simpa [smul_eq_mul, Ideal.mul_top] using this
      have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
          (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
            AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
            AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
            AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
        intro A B _ _ _ _ σ
        let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
            B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
          (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
            (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
        have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
            f n x = Ideal.Quotient.mk _ (σ a) := by
          intro n x a ha
          show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
            (AdicCompletion.evalₐ _ n x) = _
          rw [ha, Ideal.quotientMap_mk]
          rfl
        have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
            (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
          intro m n hle
          ext x
          obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
          have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
            rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
          rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
            Ideal.Quotient.factor_mk]
        refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
        intro n x a ha
        rw [AdicCompletion.evalₐ_liftRingHom]
        exact hf n x a ha
      have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
          (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
            AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
            Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
              algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
        intro A B _ _ _ _ σ
        obtain ⟨Φ, hΦ⟩ := hmap A B σ
        obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
        have h1 : Φ.comp Ψ = RingHom.id _ := by
          ext1 y
          apply AdicCompletion.ext_evalₐ
          intro n
          obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
          rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
            RingHom.id_apply, hb]
        have h2 : Ψ.comp Φ = RingHom.id _ := by
          ext1 y
          apply AdicCompletion.ext_evalₐ
          intro n
          obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
          rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
            RingHom.id_apply, hb]
        refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
        intro a
        apply AdicCompletion.ext_evalₐ
        intro n
        have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
            AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
              Ideal.Quotient.mk _ r := by
          intro R _ I r
          rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
            RingHom.id_apply]
        show AdicCompletion.evalₐ _ n (Φ _) = _
        rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]
      have s2 : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
          (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
          ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
            i.stalkMap x =
          (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
        intro K _ X Y i p q hi x
        have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
            i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
        rw [← hi, Scheme.Hom.comp_appTop]
        simp only [Category.assoc]
        exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key
      have s3 : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
          ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
            SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
        intro X Y S i _ p q hi W' hW'
        have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
          rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
        have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
          IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
        rw [hfac']
        exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'
      intro M P'' Z φ u hss
      obtain ⟨hflat, hprop, hfib⟩ := hss
      haveI := hflat
      haveI := hprop
      refine ⟨inferInstance, inferInstance, ?_⟩
      intro K _ _ s w
      set i := (Limits.pullbackLeftPullbackSndIso u φ s).hom with hi_def
      have hi : i ≫ Limits.pullback.snd u (s ≫ φ) =
          Limits.pullback.snd (Limits.pullback.snd u φ) s :=
        Limits.pullbackLeftPullbackSndIso_hom_snd u φ s
      rcases hfib K (s ≫ φ) (i w) with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
      · left
        refine ⟨i ⁻¹ᵁ W', hw', ?_⟩
        exact s3 i _ _ hi W' hsm
      · right
        let τ := Iso.commRingCatIsoToRingEquiv (asIso (i.stalkMap w))
        obtain ⟨Φ, hΦ⟩ := s1 _ _ τ.symm
        refine ⟨Φ.trans e₀, ?_⟩
        have h2 := s2 K i _ _ hi w
        ext1 k
        have hk : τ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫
            (Limits.pullback.snd (Limits.pullback.snd u φ) s).appTop ≫
            (Limits.pullback (Limits.pullback.snd u φ) s).presheaf.germ ⊤ w trivial).hom k) =
            ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u (s ≫ φ)).appTop ≫
            (Limits.pullback u (s ≫ φ)).presheaf.germ ⊤ (i w) trivial).hom k := by
          rw [← h2, RingEquiv.symm_apply_eq]
          rfl
        have := RingHom.congr_fun he₀ k
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
        rw [RingEquiv.trans_apply, hΦ, hk]
        exact this
    intro Z T T' uu n τ b hst
    obtain ⟨hss, hsec, hstab⟩ := hst
    obtain ⟨hS1, hS2, hS3⟩ := hsec
    have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
        ∀ x, b (a x) = c x := by
      intro A B C a b c h x
      rw [← Scheme.Hom.comp_apply, h]
    let τ' : Fin n → (T' ⟶ Limits.pullback uu b) := fun i =>
      Limits.pullback.lift (b ≫ τ i) (𝟙 T')
        (by rw [Category.assoc, hS1 i, Category.comp_id, Category.id_comp])
    have E1 : ∀ i, τ' i ≫ Limits.pullback.snd uu b = 𝟙 T' := fun i =>
      Limits.pullback.lift_snd _ _ _
    have E2 : ∀ i, τ' i ≫ Limits.pullback.fst uu b = b ≫ τ i := fun i =>
      Limits.pullback.lift_fst _ _ _
    have hpb : IsPullback (Limits.pullback.fst uu b) (Limits.pullback.snd uu b) uu b :=
      IsPullback.of_hasPullback uu b

    have hsec' : wcpaDjSections (Limits.pullback.snd uu b) n τ' := by
      refine ⟨E1, ?_, ?_⟩
      · intro i i' p q hii' heq
