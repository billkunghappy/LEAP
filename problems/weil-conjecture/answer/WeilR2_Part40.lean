    have hta : φ ϖ ∈ nonZeroDivisors ↑(Z'.presheaf.stalk ξ) := by
      letI : Algebra R ↑(Z'.presheaf.stalk ξ) := φ.toAlgebra
      haveI : Module.Flat R ↑(Z'.presheaf.stalk ξ) := hφflat
      have hreg : IsSMulRegular ↑(Z'.presheaf.stalk ξ) ϖ :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hϖ0)
      have key : ∀ x : ↑(Z'.presheaf.stalk ξ), φ ϖ * x = 0 → x = 0 := by
        intro x hx
