          (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) =
        Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
          (Submonoid.powers (f (MvPolynomial.X a)))).comp
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := by
      rw [← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [hj, hj']
    exact isPullback_SpecMap_of_isPushout _ _ _ _ P
  have hcov : (⨆ a : Fin (N + 1), (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
      (MvPolynomial.X a) (hX a) Nat.one_pos).opensRange) = ⊤ := by
    simp only [Proj.opensRange_awayι]
    exact Proj.iSup_basicOpen_eq_top _ _ (hspan F)
  have hcomm : ∀ a : Fin (N + 1),
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos ≫ Proj.map f hf =
        Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
          Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
            Nat.one_pos := fun a =>
    Proj.awayι_comp_map f hf Nat.one_pos (MvPolynomial.X a) (hX a)
  have hpre : ∀ a : Fin (N + 1), Proj.map f hf ⁻¹ᵁ
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a) (hX a)
        Nat.one_pos).opensRange =
      (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
          (f.map_mem (hX a)) Nat.one_pos).opensRange := fun a => by
    rw [Proj.opensRange_awayι, Proj.opensRange_awayι, Proj.map_preimage_basicOpen]
  have H := s6 (Proj.map f hf)
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))))
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) ≫ Spec.map
          (CommRingCat.ofHom (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
    (Spec.map (CommRingCat.ofHom (algebraMap F F')))
    (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a))))
    (fun a : Fin (N + 1) => Spec (CommRingCat.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a)))))
    (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (MvPolynomial.X a)
      (hX a) Nat.one_pos)
    (fun a => Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') (f (MvPolynomial.X a))
      (f.map_mem (hX a)) Nat.one_pos)
    (fun a => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))))
    hcov hcomm hpre hchart
  exact ⟨H.isoPullback.inv, inferInstance, H.isoPullback_inv_snd⟩

theorem wcpa_dj_lc_uniform_local_stable_reduction : ∀ (k : Type u) [Field k] [Finite k]
    (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral P]
    (sP : P ⟶ Spec (.of k)) (f : X ⟶ P) (U : P.Opens) (n : ℕ) (σ : Fin n → (P ⟶ X)),
    wcpaDjSmIn k sP f U σ →
    ∃ (L : Type u) (_ : Field L) (_ : Algebra P.functionField L)
      (_ : FiniteDimensional P.functionField L),
      ∀ V : ValuationSubring L, wcpaDjLocStable f σ L V :=
by
  intro k _ _ X P _ _ sP f U n σ hin
  classical

  have s2 : ∀ (L Ω : Type u) [Field L] [Field Ω] (φ : L →+* Ω) (V : ValuationSubring L),
      ∃ W : ValuationSubring Ω, W.comap φ = V := by
    intro L Ω _ _ φ V
    obtain ⟨W, hW⟩ :=
      LocalSubring.exists_le_valuationSubring (LocalSubring.map φ V.toLocalSubring)
    refine ⟨W, ?_⟩
    obtain ⟨hsub, hloc⟩ := LocalSubring.le_def.mp hW
    have hmap : ∀ y : L, y ∈ V → φ y ∈ (LocalSubring.map φ V.toLocalSubring).toSubring := by
      intro y hy
      exact ⟨y, hy, rfl⟩
    have hmap' : ∀ z ∈ (LocalSubring.map φ V.toLocalSubring).toSubring, ∃ y ∈ V, φ y = z := by
      intro z hz
      obtain ⟨y, hy, rfl⟩ := hz
      exact ⟨y, hy, rfl⟩
    ext x
    rw [ValuationSubring.mem_comap]
    constructor
    · intro hx
      by_contra hxV
      have hx0 : x ≠ 0 := fun h => hxV (h ▸ V.zero_mem)
      have hinv : x⁻¹ ∈ V := (V.mem_or_inv_mem x).resolve_left hxV
      let a : (LocalSubring.map φ V.toLocalSubring).toSubring := ⟨φ x⁻¹, hmap _ hinv⟩
      have hu : IsUnit (Subring.inclusion hsub a) := by
        refine isUnit_of_dvd_one ⟨(⟨φ x, hx⟩ : W.toLocalSubring.toSubring), ?_⟩
        apply Subtype.ext
        show (1 : Ω) = φ x⁻¹ * φ x
        rw [← map_mul, inv_mul_cancel₀ hx0, map_one]
      have hua : IsUnit a := hloc.map_nonunit a hu
      obtain ⟨b, hb⟩ := hua.exists_right_inv
      have hb' : (b : Ω) = φ x := by
        have h1 : φ x⁻¹ * (b : Ω) = 1 := congrArg Subtype.val hb
        have h2 : φ x⁻¹ * φ x = 1 := by rw [← map_mul, inv_mul_cancel₀ hx0, map_one]
        have h3 : φ x⁻¹ ≠ 0 := by
          intro h; rw [h, zero_mul] at h2; exact zero_ne_one h2
        exact mul_left_cancel₀ h3 (h1.trans h2.symm)
      obtain ⟨y, hy, hyx⟩ := hmap' b b.2
      rw [hb'] at hyx
      exact hxV (φ.injective hyx ▸ hy)
    · intro hx
      exact hsub (hmap x hx)

  have s1 : ∀ (Ω : Type u) [Field Ω] (N : ValuationSubring Ω → Finset Ω),
      (∀ W : ValuationSubring Ω, ∀ s ∈ N W, s ∈ W) →
      ∃ T : Finset (ValuationSubring Ω), ∀ W' : ValuationSubring Ω,
        ∃ W ∈ T, ∀ s ∈ N W, s ∈ W' := by
    intro Ω _ N hN
    let C : Set (Ω → Bool) := {g | g 0 = true ∧ g 1 = true ∧
      (∀ x y, g x = true → g y = true → g (x + y) = true) ∧
      (∀ x y, g x = true → g y = true → g (x * y) = true) ∧
      (∀ x, g x = true → g (-x) = true) ∧ (∀ x, g x = true ∨ g x⁻¹ = true)}
    have key : ∀ (x y z : Ω) (p : Bool → Bool → Bool → Prop),
        IsClosed {g : Ω → Bool | p (g x) (g y) (g z)} := by
      intro x y z p
      have hc : Continuous (fun g : Ω → Bool => ((g x, g y, g z) : Bool × Bool × Bool)) := by
        fun_prop
      exact IsClosed.preimage hc
        (isClosed_discrete ({t : Bool × Bool × Bool | p t.1 t.2.1 t.2.2}))
    have hC : IsClosed C := by
      have e : C = {g : Ω → Bool | g 0 = true} ∩ ({g : Ω → Bool | g 1 = true} ∩
          ((⋂ x : Ω, ⋂ y : Ω, {g : Ω → Bool | g x = true → g y = true → g (x + y) = true}) ∩
          ((⋂ x : Ω, ⋂ y : Ω, {g : Ω → Bool | g x = true → g y = true → g (x * y) = true}) ∩
          ((⋂ x : Ω, {g : Ω → Bool | g x = true → g (-x) = true}) ∩
          (⋂ x : Ω, {g : Ω → Bool | g x = true ∨ g x⁻¹ = true}))))) := by
        ext g
        simp only [C, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_iInter]
      rw [e]
      refine IsClosed.inter (key 0 0 0 (fun a _ _ => a = true)) (IsClosed.inter
        (key 1 1 1 (fun a _ _ => a = true)) (IsClosed.inter ?_ (IsClosed.inter ?_
        (IsClosed.inter ?_ ?_))))
      · exact isClosed_iInter fun x => isClosed_iInter fun y =>
          key x y (x + y) (fun a b c => a = true → b = true → c = true)
      · exact isClosed_iInter fun x => isClosed_iInter fun y =>
          key x y (x * y) (fun a b c => a = true → b = true → c = true)
      · exact isClosed_iInter fun x => key x x (-x) (fun a _ c => a = true → c = true)
      · exact isClosed_iInter fun x => key x x x⁻¹ (fun a _ c => a = true ∨ c = true)
    let O : ValuationSubring Ω → Set (Ω → Bool) := fun W => ⋂ s ∈ N W, {g | g s = true}
    have hO : ∀ W, IsOpen (O W) := by
      intro W
      refine isOpen_biInter_finset fun s _ => ?_
      have hc : Continuous (fun g : Ω → Bool => g s) := by fun_prop
      exact IsOpen.preimage hc (isOpen_discrete ({true} : Set Bool))
    have hcov : C ⊆ ⋃ W, O W := by
      intro g hg
      let Wg : ValuationSubring Ω :=
        { carrier := {x | g x = true}
          mul_mem' := fun {a b} ha hb => hg.2.2.2.1 a b ha hb
          one_mem' := hg.2.1
          add_mem' := fun {a b} ha hb => hg.2.2.1 a b ha hb
          zero_mem' := hg.1
          neg_mem' := fun {a} ha => hg.2.2.2.2.1 a ha
          mem_or_inv_mem' := fun x => hg.2.2.2.2.2 x }
      refine Set.mem_iUnion.mpr ⟨Wg, ?_⟩
      refine Set.mem_iInter₂.mpr fun s hs => ?_
      exact hN Wg s hs
    obtain ⟨T, hT⟩ := hC.isCompact.elim_finite_subcover O hO hcov
    refine ⟨T, fun W' => ?_⟩
    let χ : Ω → Bool := fun x => decide (x ∈ W')
    have hχ : χ ∈ C := by
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
      · simp [χ, W'.zero_mem]
      · simp [χ, W'.one_mem]
      · intro x y hx hy
        simp only [χ, decide_eq_true_eq] at hx hy ⊢
        exact W'.add_mem _ _ hx hy
      · intro x y hx hy
        simp only [χ, decide_eq_true_eq] at hx hy ⊢
        exact W'.mul_mem _ _ hx hy
      · intro x hx
        simp only [χ, decide_eq_true_eq] at hx ⊢
        exact W'.neg_mem _ hx
      · intro x
        simp only [χ, decide_eq_true_eq]
        exact W'.mem_or_inv_mem x
    have h1 := hT hχ
    simp only [Set.mem_iUnion] at h1
    obtain ⟨W, hWT, hW⟩ := h1
    refine ⟨W, hWT, fun s hs => ?_⟩
    have h2 := Set.mem_iInter₂.mp hW s hs
    simpa [χ] using h2

  have hW : ∀ W : ValuationSubring (AlgebraicClosure P.functionField),
      wcpaDjLocStable f σ (AlgebraicClosure P.functionField) W :=
    wcpa_dj_lus_algclosed_stable_reduction k X P sP f U n σ hin
  choose E hE S hS hloc using fun W => wcpa_dj_lus_spread_nbhd k X P sP f U n σ hin W (hW W)
  let N : ValuationSubring (AlgebraicClosure P.functionField) →
      Finset (AlgebraicClosure P.functionField) :=
    fun W => (S W).image (fun s : ↥(E W) => (s : AlgebraicClosure P.functionField))
  have hN : ∀ W : ValuationSubring (AlgebraicClosure P.functionField), ∀ s ∈ N W, s ∈ W := by
    intro W s hs
    obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hs
    exact hS W t ht
  obtain ⟨T, hT⟩ := s1 (AlgebraicClosure P.functionField) N hN
  let L : IntermediateField P.functionField (AlgebraicClosure P.functionField) := ⨆ W ∈ T, E W
  haveI hLfd : FiniteDimensional P.functionField L :=
    IntermediateField.finiteDimensional_iSup_of_finset' (fun W _ => hE W)
  refine ⟨L, inferInstance, inferInstance, hLfd, ?_⟩
  intro V
  obtain ⟨W', hW'⟩ := s2 L (AlgebraicClosure P.functionField)
    (algebraMap L (AlgebraicClosure P.functionField)) V
  obtain ⟨W, hWT, hNW⟩ := hT W'
  have hle : E W ≤ L := le_iSup₂ (f := fun W _ => E W) W hWT
  letI : Algebra (E W) L := (IntermediateField.inclusion hle).toRingHom.toAlgebra
  haveI : IsScalarTower P.functionField (E W) L :=
    IsScalarTower.of_algebraMap_eq (fun x => Subtype.ext rfl)
  apply wcpa_dj_lus_locstable_basechange X P f n σ (E W) L V
  apply hloc W
  intro s hs
  rw [ValuationSubring.mem_comap, ← hW', ValuationSubring.mem_comap]
  exact hNW (s : AlgebraicClosure P.functionField)
    (Finset.mem_image_of_mem (fun t : ↥(E W) => (t : AlgebraicClosure P.functionField)) hs)

theorem wcpa_dj_gc_image_integral : ∀ (X Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] (f : X ⟶ Y), QuasiCompact f → AlgebraicGeometry.IsIntegral (Scheme.Hom.image f) :=
by
  intro X Y _ f hf
  haveI : QuasiCompact f := hf
  haveI hirr : IrreducibleSpace (Scheme.Hom.image f) := by
    have hX : IsIrreducible (Set.univ : Set X) := IrreducibleSpace.isIrreducible_univ X
    have h1 := (hX.image (Scheme.Hom.toImage f) (Scheme.Hom.continuous _).continuousOn).closure
    rw [Set.image_univ, (Scheme.Hom.denseRange (Scheme.Hom.toImage f)).closure_range] at h1
    exact (irreducibleSpace_def _).mpr h1
  have hsec : ∀ U : Y.affineOpens,
      _root_.IsReduced Γ(Scheme.Hom.image f, Scheme.Hom.imageι f ⁻¹ᵁ (U : Y.Opens)) := by
    intro U
    exact isReduced_of_injective _ (Scheme.Hom.toImage_app_injective f U)
  haveI hst : ∀ z : Scheme.Hom.image f,
      _root_.IsReduced ((Scheme.Hom.image f).presheaf.stalk z) := by
    intro z
    obtain ⟨U, hU, hzU, -⟩ := exists_isAffineOpen_mem_and_subset
      (x := Scheme.Hom.imageι f z) (U := ⊤) trivial
    have hV : IsAffineOpen (Scheme.Hom.imageι f ⁻¹ᵁ U) := hU.preimage _
    have hz : z ∈ Scheme.Hom.imageι f ⁻¹ᵁ U := hzU
    have h1 := hsec ⟨U, hU⟩
    have h2 := hV.isLocalization_stalk ⟨z, hz⟩
    letI := TopCat.Presheaf.algebra_section_stalk (Scheme.Hom.image f).presheaf
      (⟨z, hz⟩ : Scheme.Hom.imageι f ⁻¹ᵁ U)
    haveI := h2
    exact isReduced_localizationPreserves (hV.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl _ h1
  haveI : AlgebraicGeometry.IsReduced (Scheme.Hom.image f) := isReduced_of_isReduced_stalk _
  exact isIntegral_of_irreducibleSpace_of_isReduced _

theorem wcpa_dj_gc_chart_embedding : ∀ (k : Type u) [Field k] (P V : Scheme.{u}) (sP : P ⟶ Spec (.of k)) (W : P.Opens) (ε : V ⟶ W.toScheme), IsAffineOpen W → IsFinite ε → ∃ (r : ℕ) (g : V ⟶ wcProjK k r) (h : V ⟶ (Limits.pullback.fst sP (wcProjKStr k r) ⁻¹ᵁ W).toScheme), g ≫ wcProjKStr k r = ε ≫ W.ι ≫ sP ∧ h ≫ (Limits.pullback.fst sP (wcProjKStr k r) ⁻¹ᵁ W).ι ≫ Limits.pullback.fst sP (wcProjKStr k r) = ε ≫ W.ι ∧ h ≫ (Limits.pullback.fst sP (wcProjKStr k r) ⁻¹ᵁ W).ι ≫ Limits.pullback.snd sP (wcProjKStr k r) = g ∧ IsClosedImmersion h :=
by
  intro k _ P V sP W ε hW hε
  classical
  haveI : IsAffine W.toScheme := hW
  haveI : IsAffine V := isAffine_of_isAffineHom ε

  have s5 : ∀ {X Y Z : Scheme.{u}} (a : X ⟶ Y) (f : Y ⟶ Z) (u : X ⟶ Z) (U : Z.Opens)
      (e₁ : (⊤ : Y.Opens) ≤ f ⁻¹ᵁ U) (hu : (⊤ : X.Opens) ≤ u ⁻¹ᵁ U), a ≫ f = u →
      ∀ y, a.appTop.hom ((f.appLE U ⊤ e₁).hom y) = (u.appLE U ⊤ hu).hom y := by
    intro X Y Z a f u U e₁ hu hau y
    subst hau
    have key := Scheme.Hom.appLE_comp_appLE a f U ⊤ (a ⁻¹ᵁ ⊤) e₁ le_rfl
    have h2 : a.appTop = a.appLE ⊤ (a ⁻¹ᵁ ⊤) le_rfl := Scheme.Hom.app_eq_appLE a
    rw [h2]
    exact congrArg (fun φ => φ.hom y) key

  obtain ⟨n, b, hgen⟩ : ∃ (n : ℕ) (b : Fin n → Γ(V, ⊤)), ∀ x : Γ(V, ⊤),
      ∃ c : Fin n → Γ(W.toScheme, ⊤), ∑ i, ε.appTop.hom (c i) * b i = x := by
    have hfin : (ε.appTop).hom.Finite := IsFinite.finite_app ε ⊤ (isAffineOpen_top W.toScheme)
    letI : Algebra Γ(W.toScheme, ⊤) Γ(V, ⊤) := ε.appTop.hom.toAlgebra
    haveI : Module.Finite Γ(W.toScheme, ⊤) Γ(V, ⊤) := hfin
    obtain ⟨n, b, hb⟩ := Module.Finite.exists_fin (R := Γ(W.toScheme, ⊤)) (M := Γ(V, ⊤))
    refine ⟨n, b, fun x => ?_⟩
    have hx : x ∈ Submodule.span Γ(W.toScheme, ⊤) (Set.range b) := by rw [hb]; trivial
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx
    refine ⟨c, ?_⟩
    rw [← hc]
    simp only [Algebra.smul_def, RingHom.algebraMap_toAlgebra]

  obtain ⟨C, e, hC, -, -, UP⟩ := wcpa_dj_cf_gim_proj_chart k n
  obtain ⟨g, hg, hg1, hg2⟩ := UP V (ε ≫ W.ι ≫ sP) (Fin.cons (1 : Γ(V, ⊤)) b) (by simp)
  have w : (ε ≫ W.ι) ≫ sP = g ≫ wcProjKStr k n := by rw [Category.assoc, hg1]
  obtain ⟨δ, hδ1, hδ2⟩ : ∃ δ : V ⟶ Limits.pullback sP (wcProjKStr k n),
      δ ≫ Limits.pullback.fst sP (wcProjKStr k n) = ε ≫ W.ι ∧
      δ ≫ Limits.pullback.snd sP (wcProjKStr k n) = g :=
    ⟨Limits.pullback.lift _ _ w, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have hO' : IsAffineOpen (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
      Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C) := by
    have := (wc_closed_in_product_chart_gen (Spec (.of k)) P (wcProjK k n)
      (Limits.pullback sP (wcProjKStr k n)) sP (wcProjKStr k n) (𝟙 _) W C hW hC).1
    simpa only [Category.id_comp] using this
  haveI : IsAffine (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
      Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).toScheme := hO'
  have hrange : Set.range δ ⊆ Set.range (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
      Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨v, rfl⟩
    refine ⟨?_, ?_⟩
    · show δ v ∈ Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W
      rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hδ1, Scheme.Hom.comp_apply]
      have hy : W.ι (ε v) ∈ Set.range W.ι := ⟨ε v, rfl⟩
      rwa [Scheme.Opens.range_ι] at hy
    · show δ v ∈ Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C
      rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hδ2]
      exact hg (show v ∈ (⊤ : V.Opens) from trivial)
  obtain ⟨h₀, hh₀⟩ : ∃ h₀ : V ⟶ (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
      Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).toScheme,
      h₀ ≫ (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
        Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).ι = δ :=
    ⟨IsOpenImmersion.lift _ δ hrange, IsOpenImmersion.lift_fac _ _ _⟩

  have hmem : ∀ y, (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
      Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).ι y ∈
      (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
        Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C) := by
    intro y
    have hy : (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
      Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).ι y ∈ Set.range
        (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
          Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).ι := ⟨y, rfl⟩
    rwa [Scheme.Opens.range_ι] at hy
  have hsurj : Function.Surjective h₀.appTop.hom := by
    have hq : Set.range ((Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
        Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).ι ≫
          Limits.pullback.fst sP (wcProjKStr k n)) ⊆ Set.range W.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact (hmem y).1
    obtain ⟨q, hqf⟩ : ∃ q : (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
        Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).toScheme ⟶ W.toScheme,
        q ≫ W.ι = (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
          Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).ι ≫
            Limits.pullback.fst sP (wcProjKStr k n) :=
      ⟨IsOpenImmersion.lift W.ι _ hq, IsOpenImmersion.lift_fac _ _ _⟩
    have hh₀q : h₀ ≫ q = ε := by
      rw [← cancel_mono W.ι, Category.assoc, hqf, ← Category.assoc, hh₀, hδ1]
    have hi : ∀ a, ε.appTop.hom a ∈ h₀.appTop.hom.range := by
      intro a
      refine RingHom.mem_range.mpr ⟨q.appTop.hom a, ?_⟩
      rw [← hh₀q, Scheme.Hom.comp_appTop]
      rfl
    have hii : ∀ i, b i ∈ h₀.appTop.hom.range := by
      intro i
      have e₁ : (⊤ : (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
          Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).toScheme.Opens) ≤
          ((Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
            Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).ι ≫
              Limits.pullback.snd sP (wcProjKStr k n)) ⁻¹ᵁ C := by
        intro y _
        exact (hmem y).2
      have hf' : h₀ ≫ ((Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
          Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C).ι ≫
            Limits.pullback.snd sP (wcProjKStr k n)) = g := by
        rw [← Category.assoc, hh₀, hδ2]
      refine RingHom.mem_range.mpr ⟨(Scheme.Hom.appLE _ C ⊤ e₁).hom (e i.succ), ?_⟩
      rw [s5 h₀ _ g C e₁ hg hf' (e i.succ)]
      have h3 := hg2 i.succ
      simp only [Fin.cons_succ] at h3
      exact h3
    intro x
    obtain ⟨c, hc⟩ := hgen x
    have hx : x ∈ h₀.appTop.hom.range := by
      rw [← hc]
      exact Subring.sum_mem _ (fun i _ => Subring.mul_mem _ (hi (c i)) (hii i))
    exact RingHom.mem_range.mp hx
  haveI hh₀ci : IsClosedImmersion h₀ := IsClosedImmersion.of_surjective_of_isAffine h₀ hsurj

  have hle : Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W ⊓
      Limits.pullback.snd sP (wcProjKStr k n) ⁻¹ᵁ C ≤
      Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W := inf_le_left
  have hh : (h₀ ≫ (Limits.pullback sP (wcProjKStr k n)).homOfLE hle) ≫
      (Limits.pullback.fst sP (wcProjKStr k n) ⁻¹ᵁ W).ι = δ := by
    rw [Category.assoc, Scheme.homOfLE_ι, hh₀]
  haveI : IsSeparated (wcProjKStr k n) := by
    first
    | infer_instance
    | (unfold wcProjKStr; infer_instance)
    | (delta wcProjKStr; infer_instance)
  have hπ : (h₀ ≫ (Limits.pullback sP (wcProjKStr k n)).homOfLE hle) ≫
      (Limits.pullback.fst sP (wcProjKStr k n) ∣_ W) = ε := by
    rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hh, hδ1]
  haveI : UniversallyClosed ((h₀ ≫ (Limits.pullback sP (wcProjKStr k n)).homOfLE hle) ≫
      (Limits.pullback.fst sP (wcProjKStr k n) ∣_ W)) := by
    rw [hπ]; infer_instance
  haveI : UniversallyClosed (h₀ ≫ (Limits.pullback sP (wcProjKStr k n)).homOfLE hle) :=
    UniversallyClosed.of_comp_of_isSeparated _ (Limits.pullback.fst sP (wcProjKStr k n) ∣_ W)
  have hci : IsClosedImmersion (h₀ ≫ (Limits.pullback sP (wcProjKStr k n)).homOfLE hle) :=
    IsClosedImmersion.of_isPreimmersion _
      (Scheme.Hom.isClosedMap (h₀ ≫ (Limits.pullback sP (wcProjKStr k n)).homOfLE hle)).isClosed_range
  refine ⟨n, g, h₀ ≫ (Limits.pullback sP (wcProjKStr k n)).homOfLE hle, hg1, ?_, ?_, hci⟩
  · rw [← Category.assoc, hh, hδ1]
  · rw [← Category.assoc, hh, hδ2]

theorem wcpa_dj_gc_image_open_iso : ∀ (V Q T : Scheme.{u}) (γ : V ⟶ Q) (p : Q ⟶ T) (O : T.Opens) (U' : (Scheme.Hom.image γ).Opens) (h : V ⟶ O.toScheme), QuasiCompact γ → IsSeparated p → AlgebraicGeometry.IsReduced (Scheme.Hom.image γ) → U' = (Scheme.Hom.imageι γ ≫ p) ⁻¹ᵁ O → h ≫ O.ι = γ ≫ p → IsClosedImmersion h → ∃ t : V ⟶ U'.toScheme, IsIso t ∧ t ≫ U'.ι = Scheme.Hom.toImage γ :=
by
  intro V Q T γ p O U' h hqc hsep hred hU' hh hci
  subst hU'
  haveI := hqc
  haveI := hsep
  haveI := hred
  haveI := hci
  set f : Scheme.Hom.image γ ⟶ T := Scheme.Hom.imageι γ ≫ p with hf
  have H : Set.range (Scheme.Hom.toImage γ) ⊆ Set.range (f ⁻¹ᵁ O).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨v, rfl⟩
    rw [SetLike.mem_coe, Scheme.Hom.mem_preimage]
    have e1 : f (Scheme.Hom.toImage γ v) = (γ ≫ p) v := by
      rw [hf, ← Scheme.Hom.comp_apply, ← Category.assoc, Scheme.Hom.toImage_imageι]
    rw [e1, ← hh, Scheme.Hom.comp_apply]
    first
      | exact (h v).2
      | simp
  let t : V ⟶ (f ⁻¹ᵁ O).toScheme := IsOpenImmersion.lift (f ⁻¹ᵁ O).ι (Scheme.Hom.toImage γ) H
  have ht : t ≫ (f ⁻¹ᵁ O).ι = Scheme.Hom.toImage γ := IsOpenImmersion.lift_fac _ _ _
  have hkey : t ≫ (f ∣_ O) = h := by
    rw [← cancel_mono O.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, ht, hh, hf,
      ← Category.assoc, Scheme.Hom.toImage_imageι]
  haveI : IsClosedImmersion (t ≫ (f ∣_ O)) := by rw [hkey]; exact hci
  haveI : IsSeparated (f ∣_ O) := inferInstance
  haveI htci : IsClosedImmersion t := IsClosedImmersion.of_comp t (f ∣_ O)
  have hcl : IsClosed (Set.range t) := t.isClosedEmbedding.isClosed_range
  have hD : Dense (Set.range (Scheme.Hom.toImage γ)) := (Scheme.Hom.toImage γ).denseRange
  have hpre : (f ⁻¹ᵁ O).ι ⁻¹' Set.range (Scheme.Hom.toImage γ) = Set.range t := by
    ext x
    constructor
    · rintro ⟨v, hv⟩
      refine ⟨v, ?_⟩
      apply (f ⁻¹ᵁ O).ι.isOpenEmbedding.injective
      rw [← Scheme.Hom.comp_apply, ht, hv]
    · rintro ⟨v, rfl⟩
      exact ⟨v, by rw [← Scheme.Hom.comp_apply, ht]⟩
  have hD' : Dense (Set.range t) := by
    rw [← hpre]
    exact hD.preimage (f ⁻¹ᵁ O).ι.isOpenEmbedding.isOpenMap
  have huniv : Set.range t = Set.univ := by
    rw [← hcl.closure_eq, hD'.closure_eq]
  haveI : Surjective t := ⟨fun x => by
    have : x ∈ Set.range t := by rw [huniv]; trivial
    exact this⟩
  haveI : IsReduced (f ⁻¹ᵁ O).toScheme := inferInstance
  exact ⟨t, isIso_of_isClosedImmersion_of_surjective t, ht⟩

theorem wcpa_dj_lc_alteration_model : ∀ (k : Type u) [Field k] (P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k)), wcpaDjIsProjOver k sP →
    ∀ (L : Type u) [Field L] [Algebra P.functionField L] [FiniteDimensional P.functionField L],
    ∃ (S₀ : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral S₀) (sS₀ : S₀ ⟶ Spec (.of k))
      (β₀ : S₀ ⟶ P) (ε : S₀.functionField ≃+* L),
      β₀ ≫ sP = sS₀ ∧ wcpaDjIsProjOver k sS₀ ∧ IsProper β₀ ∧ Surjective β₀ ∧
      (∃ V : P.Opens, V ≠ ⊥ ∧ IsFinite (β₀ ∣_ V)) ∧
      Spec.map (CommRingCat.ofHom (ε : S₀.functionField →+* L)) ≫
          S₀.fromSpecStalk (genericPoint S₀) ≫ β₀ =
        Spec.map (CommRingCat.ofHom (algebraMap P.functionField L)) ≫
          P.fromSpecStalk (genericPoint P) :=
by
  intro k _ P _ sP hP L _ _ _
  classical

  have t2 : ∀ (A K L : Type u) [CommRing A] [IsDomain A] [Field K] [Field L]
      [Algebra A K] [IsFractionRing A K] [Algebra K L] [FiniteDimensional K L] [Algebra A L]
      [IsScalarTower A K L], ∃ B : Subalgebra A L, Module.Finite A B ∧ IsFractionRing B L := by
    intro A K L _ _ _ _ _ _ _ _ _ _
    set v := Module.finBasis K L with hv
    have hint : ∀ i, ∃ m : nonZeroDivisors A, IsIntegral A ((m : A) • v i) := by
      intro i
      exact IsIntegral.exists_multiple_integral_of_isLocalization (nonZeroDivisors A) (v i)
        (Algebra.IsIntegral.isIntegral (R := K) (v i))
    choose m hm using hint
    set c : Fin (Module.finrank K L) → L := fun i => (m i : A) • v i with hc
    have hfin : Module.Finite A (Algebra.adjoin A (Set.range c)) :=
      Algebra.finite_adjoin_of_finite_of_isIntegral (Set.finite_range c)
        (by rintro _ ⟨i, rfl⟩; exact hm i)
    refine ⟨Algebra.adjoin A (Set.range c), hfin, ?_⟩
    have hAL : Function.Injective (algebraMap A L) := by
      rw [IsScalarTower.algebraMap_eq A K L]
      exact (algebraMap K L).injective.comp (IsFractionRing.injective A K)
    have hmK : ∀ i, algebraMap A K (m i) ≠ 0 := fun i h =>
      nonZeroDivisors.coe_ne_zero (m i) ((IsFractionRing.injective A K) (h.trans (map_zero _).symm))
    apply IsFractionRing.of_field
    intro z
    set lam : Fin (Module.finrank K L) → K := fun i => v.repr z i / algebraMap A K (m i) with hlam
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors A) Finset.univ lam
    choose a ha using fun i => hb i (Finset.mem_univ i)
    have hb0 : algebraMap A L (b : A) ≠ 0 := fun h =>
      nonZeroDivisors.coe_ne_zero b (hAL (h.trans (map_zero _).symm))
    have hsum : (∑ i, a i • c i) = algebraMap A L b * z := by
      conv_rhs => rw [← v.sum_repr z]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      have h1 : algebraMap A K (a i) * algebraMap A K (m i) = algebraMap A K b * v.repr z i := by
        rw [ha i, Algebra.smul_def, hlam]
        field_simp [hmK i]
      rw [hc]
      simp only [Algebra.smul_def, IsScalarTower.algebraMap_apply A K L]
      rw [← mul_assoc, ← map_mul, h1, map_mul]
      ring
    refine ⟨⟨∑ i, a i • c i, ?_⟩, algebraMap A _ b, ?_⟩
    · exact Subalgebra.sum_mem _ (fun i _ => Subalgebra.smul_mem _
        (Algebra.subset_adjoin (Set.mem_range_self (f := c) i)) _)
    · show z = (∑ i, a i • c i) / algebraMap A L b
      rw [hsum, mul_div_cancel_left₀ _ hb0]

  have t3 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B],
      Module.Finite A B → Function.Injective (algebraMap A B) →
      IsFinite (Spec.map (CommRingCat.ofHom (algebraMap A B))) ∧
        Surjective (Spec.map (CommRingCat.ofHom (algebraMap A B))) := by
    intro A B _ _ _ hf h
    refine ⟨?_, ?_⟩
    · rw [IsFinite.SpecMap_iff]; exact RingHom.finite_algebraMap.mpr hf
    · haveI : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite _ _
      haveI : FaithfulSMul A B := (faithfulSMul_iff_algebraMap_injective _ _).mpr h
      constructor
      exact Algebra.IsIntegral.comap_surjective A B

  have t5R : ∀ (S : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] (R : CommRingCat.{u}) [IsDomain R]
      (L : Type u) [Field L] [Algebra R L] [IsFractionRing R L]
      (g : Spec R ⟶ S) [IsOpenImmersion g],
      ∃ ε : S.functionField ≃+* L,
        Spec.map (CommRingCat.ofHom (ε : S.functionField →+* L)) ≫ S.fromSpecStalk (genericPoint S) =
          Spec.map (CommRingCat.ofHom (algebraMap R L)) ≫ g := by
    intro S _ R _ L _ _ _ g _
    let τ : (Spec R).functionField ≃ₐ[R] L :=
      IsLocalization.algEquiv (nonZeroDivisors R) (Spec R).functionField L
    have key : ∀ x : S, g (genericPoint (Spec R)) = x →
        ∃ ε : S.presheaf.stalk x ≃+* L,
          Spec.map (CommRingCat.ofHom (ε : S.presheaf.stalk x →+* L)) ≫ S.fromSpecStalk x =
            Spec.map (CommRingCat.ofHom (algebraMap R L)) ≫ g := by
      rintro x rfl
      let σ := g.stalkMap (genericPoint (Spec R))
      let ε : S.presheaf.stalk (g (genericPoint (Spec R))) ≃+* L :=
        (asIso σ).commRingCatIsoToRingEquiv.trans τ.toRingEquiv
      let τh : (Spec R).presheaf.stalk (genericPoint (Spec R)) ⟶ CommRingCat.of L :=
        CommRingCat.ofHom (τ : (Spec R).functionField →+* L)
      refine ⟨ε, ?_⟩
      have e1 : CommRingCat.ofHom (ε : S.presheaf.stalk (g (genericPoint (Spec R))) →+* L) =
          σ ≫ τh := by
        ext; rfl
      have e2 : (Scheme.ΓSpecIso R).inv ≫ (Spec R).presheaf.germ ⊤ (genericPoint (Spec R)) trivial ≫ τh
          = CommRingCat.ofHom (algebraMap R L) := by
        ext b
        exact τ.commutes b
      rw [e1, Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkMap_fromSpecStalk,
        Spec.fromSpecStalk_eq, ← Spec.map_comp_assoc]
      congr 2
    exact key _ (genericPoint_eq_of_isOpenImmersion g)

  obtain ⟨W, hW, hη, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := genericPoint P) (U := ⊤) trivial
  haveI : Nonempty W := ⟨⟨_, hη⟩⟩
  haveI : IsAffine W := hW
  haveI : IsDomain Γ(P, W) := IsIntegral.component_integral W
  haveI : IsFractionRing Γ(P, W) P.functionField :=
    functionField_isFractionRing_of_isAffineOpen P W hW
  letI iAL : Algebra Γ(P, W) L :=
    ((algebraMap P.functionField L).comp (algebraMap Γ(P, W) P.functionField)).toAlgebra
  haveI : IsScalarTower Γ(P, W) P.functionField L := IsScalarTower.of_algebraMap_eq' rfl

  obtain ⟨B, hBfin, hBfr⟩ := t2 Γ(P, W) P.functionField L
  have hinj : Function.Injective (algebraMap Γ(P, W) B) := by
    intro a b hab
    have h1 : algebraMap Γ(P, W) L a = algebraMap Γ(P, W) L b := by
      have := congrArg (fun x : B => (x : L)) hab
      simpa using this
    have h2 : Function.Injective (algebraMap Γ(P, W) L) :=
      (algebraMap P.functionField L).injective.comp
        (IsFractionRing.injective Γ(P, W) P.functionField)
    exact h2 h1

  obtain ⟨hfin, hsurj⟩ := t3 Γ(P, W) B hBfin hinj
  set ε : Spec (.of B) ⟶ W.toScheme :=
    Spec.map (CommRingCat.ofHom (algebraMap Γ(P, W) B)) ≫ hW.isoSpec.inv with hεdef
  have hεfin : IsFinite ε := by
    haveI := hfin
    rw [hεdef]; infer_instance
  have hεsurj : Surjective ε := by
    haveI := hsurj
    rw [hεdef]; infer_instance
  haveI := hεsurj

  obtain ⟨r, gc, hc, hgc, hh1, hh2, hhci⟩ :=
    wcpa_dj_gc_chart_embedding k P (Spec (.of B)) sP W ε hW hεfin
  have hR : wcpaDjIsProjOver k (wcProjKStr k r) := ⟨r, 𝟙 _, inferInstance, Category.id_comp _⟩
  have hQ1 : wcpaDjIsProjOver k (Limits.pullback.snd sP (wcProjKStr k r) ≫ wcProjKStr k r) := by
    have := wcpa_dj_ssm_proj_fibre_product k P (Spec (.of k)) (wcProjK k r)
      (Limits.pullback sP (wcProjKStr k r)) (𝟙 _) sP (wcProjKStr k r) (𝟙 _) inferInstance
      (by rw [Category.comp_id]; exact hP) (by rw [Category.comp_id]; exact hR) inferInstance
    rwa [Category.comp_id, Category.id_comp] at this
  haveI : IsProper (Limits.pullback.snd sP (wcProjKStr k r) ≫ wcProjKStr k r) :=
    wcpa_dj_proj_proper k _ hQ1
  haveI : IsProper sP := wcpa_dj_proj_proper k sP hP
  haveI := quasiSeparatedSpace_of_quasiSeparated
    (Limits.pullback.snd sP (wcProjKStr k r) ≫ wcProjKStr k r)
  have w₁ : (ε ≫ W.ι) ≫ sP = gc ≫ wcProjKStr k r := by rw [hgc, Category.assoc]
  obtain ⟨γ, hγ1, hγ2⟩ : ∃ γ : Spec (.of B) ⟶ Limits.pullback sP (wcProjKStr k r),
      γ ≫ Limits.pullback.fst sP (wcProjKStr k r) = ε ≫ W.ι ∧
      γ ≫ Limits.pullback.snd sP (wcProjKStr k r) = gc :=
    ⟨Limits.pullback.lift _ _ w₁, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  haveI hQC : QuasiCompact γ := quasiCompact_of_compactSpace γ
  haveI hint : AlgebraicGeometry.IsIntegral (Scheme.Hom.image γ) :=
    wcpa_dj_gc_image_integral _ _ γ hQC
  obtain ⟨β₀, hβ₀⟩ : ∃ b : Scheme.Hom.image γ ⟶ P,
      b = Scheme.Hom.imageι γ ≫ Limits.pullback.fst sP (wcProjKStr k r) := ⟨_, rfl⟩
  have hprojI : wcpaDjIsProjOver k (Scheme.Hom.imageι γ ≫
      Limits.pullback.snd sP (wcProjKStr k r) ≫ wcProjKStr k r) := by
    have := wcpa_dj_ssm_proj_fibre_product k P (Spec (.of k)) (wcProjK k r)
      (Scheme.Hom.image γ) (𝟙 _) sP (wcProjKStr k r) (Scheme.Hom.imageι γ) inferInstance
      (by rw [Category.comp_id]; exact hP) (by rw [Category.comp_id]; exact hR) inferInstance
    rwa [Category.comp_id] at this
  have hproj : wcpaDjIsProjOver k (β₀ ≫ sP) := by
    rw [hβ₀, Category.assoc, Limits.pullback.condition]; exact hprojI
  haveI hprop : IsProper β₀ := by
    haveI : IsProper (β₀ ≫ sP) := wcpa_dj_proj_proper k _ hproj
    exact IsProper.of_comp β₀ sP
  have hU : β₀ ⁻¹ᵁ W = (Scheme.Hom.imageι γ ≫ 𝟙 _) ⁻¹ᵁ
      (Limits.pullback.fst sP (wcProjKStr k r) ⁻¹ᵁ W) := by
    rw [hβ₀, Category.comp_id]
    simp only [Scheme.Hom.comp_preimage]
  have hhO : hc ≫ (Limits.pullback.fst sP (wcProjKStr k r) ⁻¹ᵁ W).ι = γ ≫ 𝟙 _ := by
    rw [Category.comp_id]
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hh1, hγ1]
    · simp only [Category.assoc]
      rw [hh2, hγ2]
  obtain ⟨t, ht_iso, ht⟩ := wcpa_dj_gc_image_open_iso _ _ _ γ (𝟙 _)
    (Limits.pullback.fst sP (wcProjKStr k r) ⁻¹ᵁ W) (β₀ ⁻¹ᵁ W) hc hQC inferInstance inferInstance
    hU hhO hhci
  haveI := ht_iso
  have hi : t ≫ (β₀ ⁻¹ᵁ W).ι ≫ β₀ = ε ≫ W.ι := by
    rw [← Category.assoc, ht, hβ₀, ← Category.assoc, Scheme.Hom.toImage_imageι, hγ1]
  have hβsurj : Surjective β₀ := by
    have hcl : IsClosed (Set.range β₀) := β₀.isClosedMap.isClosed_range
    have hsub : (W : Set P) ⊆ Set.range β₀ := by
      intro w hw
      obtain ⟨v, hv⟩ := ε.surjective ⟨w, hw⟩
      refine ⟨(β₀ ⁻¹ᵁ W).ι (t v), ?_⟩
      have e1 : (t ≫ (β₀ ⁻¹ᵁ W).ι ≫ β₀) v = (ε ≫ W.ι) v := by rw [hi]
      simp only [Scheme.Hom.comp_apply] at e1
      rw [e1, hv, Scheme.Opens.ι_apply]
    have hd : Dense (W : Set P) := W.isOpen.dense ⟨_, hη⟩
    refine ⟨fun y => ?_⟩
    have hy : y ∈ closure (W : Set P) := by rw [hd.closure_eq]; trivial
    exact closure_minimal hsub hcl hy
  have htε : t ≫ (β₀ ∣_ W) = ε := by
    rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, hi]
  have hfinβ : IsFinite (β₀ ∣_ W) := by
    have : β₀ ∣_ W = inv t ≫ ε := by rw [← htε, IsIso.inv_hom_id_assoc]
    rw [this]
    infer_instance
  have hW0 : W ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty W).mpr ⟨_, hη⟩
  have hgβ : (t ≫ (β₀ ⁻¹ᵁ W).ι) ≫ β₀ = ε ≫ W.ι := by rw [Category.assoc]; exact hi

  obtain ⟨εff, heq⟩ := t5R (Scheme.Hom.image γ) (CommRingCat.of B) L (t ≫ (β₀ ⁻¹ᵁ W).ι)
  refine ⟨Scheme.Hom.image γ, hint, β₀ ≫ sP, β₀, εff, rfl, hproj, hprop, hβsurj,
    ⟨W, hW0, hfinβ⟩, ?_⟩

  rw [← Category.assoc, heq, Category.assoc, hgβ, hεdef, Category.assoc, IsAffineOpen.isoSpec_inv_ι,
    ← IsAffineOpen.fromSpecStalk_eq_fromSpecStalk hW hη, IsAffineOpen.fromSpecStalk,
    ← Spec.map_comp_assoc, ← Spec.map_comp_assoc]
  congr 2

theorem wcpa_dj_rzf_gen_transport : ∀ (X Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral Y] (j : X ⟶ Y) [IsOpenImmersion j] (L : Type u) [Field L], (∀ g : Spec (.of L) ⟶ X, (∃ εX : X.functionField ≃+* L, Spec.map (CommRingCat.ofHom (εX : X.functionField →+* L)) ≫ X.fromSpecStalk (genericPoint X) = g) → ∃ εY : Y.functionField ≃+* L, Spec.map (CommRingCat.ofHom (εY : Y.functionField →+* L)) ≫ Y.fromSpecStalk (genericPoint Y) = g ≫ j) ∧ (∀ h : Spec (.of L) ⟶ Y, (∃ εY : Y.functionField ≃+* L, Spec.map (CommRingCat.ofHom (εY : Y.functionField →+* L)) ≫ Y.fromSpecStalk (genericPoint Y) = h) → ∃ g : Spec (.of L) ⟶ X, g ≫ j = h ∧ ∃ εX : X.functionField ≃+* L, Spec.map (CommRingCat.ofHom (εX : X.functionField →+* L)) ≫ X.fromSpecStalk (genericPoint X) = g) :=
by
  intro X Y _ _ j _ L _
  have hη : j (genericPoint X) = genericPoint Y := genericPoint_eq_of_isOpenImmersion j
  have hsq : Spec.map (j.stalkMap (genericPoint X)) ≫ Y.fromSpecStalk (j (genericPoint X)) =
      X.fromSpecStalk (genericPoint X) ≫ j := Scheme.SpecMap_stalkMap_fromSpecStalk j
  have s2 : ∀ (y : Y) (_ : j (genericPoint X) = y) (εX : X.functionField ≃+* L),
      ∃ εY : Y.presheaf.stalk y ≃+* L,
        Spec.map (CommRingCat.ofHom (εY : Y.presheaf.stalk y →+* L)) ≫ Y.fromSpecStalk y =
          Spec.map (CommRingCat.ofHom (εX : X.functionField →+* L)) ≫
            X.fromSpecStalk (genericPoint X) ≫ j := by
    intro y hy εX
    subst hy
    refine ⟨(asIso (j.stalkMap (genericPoint X))).commRingCatIsoToRingEquiv.trans εX, ?_⟩
    have e : Spec.map (CommRingCat.ofHom
        (((asIso (j.stalkMap (genericPoint X))).commRingCatIsoToRingEquiv.trans εX :
          Y.presheaf.stalk (j (genericPoint X)) ≃+* L) : Y.presheaf.stalk (j (genericPoint X)) →+* L)) =
        Spec.map (CommRingCat.ofHom (εX : X.functionField →+* L)) ≫
          Spec.map (j.stalkMap (genericPoint X)) := by
      rw [← Spec.map_comp]
      congr 1
    rw [e, Category.assoc, hsq]
  have s3 : ∀ (y : Y) (_ : j (genericPoint X) = y) (εY : Y.presheaf.stalk y ≃+* L),
      ∃ εX : X.functionField ≃+* L,
        Spec.map (CommRingCat.ofHom (εX : X.functionField →+* L)) ≫
            X.fromSpecStalk (genericPoint X) ≫ j =
          Spec.map (CommRingCat.ofHom (εY : Y.presheaf.stalk y →+* L)) ≫ Y.fromSpecStalk y := by
    intro y hy εY
    subst hy
    refine ⟨(asIso (j.stalkMap (genericPoint X))).symm.commRingCatIsoToRingEquiv.trans εY, ?_⟩
    have e : Spec.map (CommRingCat.ofHom
        (((asIso (j.stalkMap (genericPoint X))).symm.commRingCatIsoToRingEquiv.trans εY :
          X.functionField ≃+* L) : X.functionField →+* L)) =
        Spec.map (CommRingCat.ofHom (εY : Y.presheaf.stalk (j (genericPoint X)) →+* L)) ≫
          Spec.map (inv (j.stalkMap (genericPoint X))) := by
      rw [← Spec.map_comp]
      congr 1
    rw [e, ← hsq, Spec.map_inv, Category.assoc, IsIso.inv_hom_id_assoc]
  refine ⟨?_, ?_⟩
  · rintro g ⟨εX, rfl⟩
    obtain ⟨εY, hεY⟩ := s2 (genericPoint Y) hη εX
    exact ⟨εY, hεY.trans (Category.assoc _ _ _).symm⟩
  · rintro h ⟨εY, rfl⟩
    have hr : Set.range (Spec.map (CommRingCat.ofHom (εY : Y.functionField →+* L)) ≫
        Y.fromSpecStalk (genericPoint Y)) ⊆ Set.range j := by
      rintro _ ⟨p, rfl⟩
      refine ⟨genericPoint X, ?_⟩
      rw [hη, Scheme.Hom.comp_apply]
      have h1 : (Spec.map (CommRingCat.ofHom (εY : Y.functionField →+* L))) p =
          IsLocalRing.closedPoint ↑(Y.presheaf.stalk (genericPoint Y)) :=
        Subsingleton.elim (α := PrimeSpectrum Y.functionField) _ _
      rw [h1]
      exact Scheme.fromSpecStalk_closedPoint.symm
    obtain ⟨εX, hεX⟩ := s3 (genericPoint Y) hη εY
    refine ⟨IsOpenImmersion.lift j _ hr, IsOpenImmersion.lift_fac _ _ _, εX, ?_⟩
    rw [← cancel_mono j, IsOpenImmersion.lift_fac, Category.assoc]
    exact hεX

theorem wcpa_dj_lsl_centre_model : ∀ (k : Type u) [Field k] [Finite k] (S₀ : Scheme.{u}) [AlgebraicGeometry.IsIntegral S₀] (sS₀ : S₀ ⟶ Spec (.of k)), wcpaDjIsProjOver k sS₀ → ∀ (L : Type u) [Field L] (ε : S₀.functionField ≃+* L) (V : ValuationSubring L) (F : Finset V), ∃ (SV : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral SV) (dV : SV ⟶ S₀) (εV : SV.functionField ≃+* L) (cV : Spec (CommRingCat.of V) ⟶ SV) (D : SV.Opens) (cD : Spec (CommRingCat.of V) ⟶ D.toScheme) (ρ : D.toScheme ⟶ Spec (.of ↥(Subring.closure (F : Set V)))), wcpaDjIsProjOver k (dV ≫ sS₀) ∧ IsProper dV ∧ (∃ V₀ : S₀.Opens, V₀ ≠ ⊥ ∧ IsIso (dV ∣_ V₀)) ∧ Spec.map (CommRingCat.ofHom (εV : SV.functionField →+* L)) ≫ SV.fromSpecStalk (genericPoint SV) ≫ dV = Spec.map (CommRingCat.ofHom (ε : S₀.functionField →+* L)) ≫ S₀.fromSpecStalk (genericPoint S₀) ∧ Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ cV = Spec.map (CommRingCat.ofHom (εV : SV.functionField →+* L)) ≫ SV.fromSpecStalk (genericPoint SV) ∧ cD ≫ D.ι = cV ∧ cD ≫ ρ = Spec.map (CommRingCat.ofHom (Subring.closure (F : Set V)).subtype) :=
by
  intro k _ _ S₀ _ sS₀ hS₀ L _ ε V F
  classical




  have hN2 : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) (y : Γ(Spec R, ⊤)),
      (Scheme.ΓSpecIso S).hom ((Spec.map f).appTop y) = f ((Scheme.ΓSpecIso R).hom y) := by
    intro R S f y
    rw [← CommRingCat.comp_apply, Scheme.ΓSpecIso_naturality, CommRingCat.comp_apply]
  have happLE_top : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (e : ⊤ ≤ f ⁻¹ᵁ ⊤),
      f.appLE ⊤ ⊤ e = f.appTop := by
    intro X Y f e
    rw [Scheme.Hom.appLE]
    erw [CategoryTheory.Functor.map_id]
    exact Category.comp_id _
  have htopIso : ∀ {X : Scheme.{u}} (U : X.Opens) (e : ⊤ ≤ U.ι ⁻¹ᵁ U),
      U.topIso.inv = U.ι.appLE U ⊤ e := by
    intro X U e
    simp only [Scheme.Opens.topIso_inv, Scheme.Opens.ι_appLE]
    congr 1

  have hG : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
      (εX : X.functionField ≃+* L) (U : X.Opens) (hη : genericPoint X ∈ U)
      (h : Spec (.of L) ⟶ X),
      h = Spec.map (CommRingCat.ofHom (εX : X.functionField →+* L)) ≫
        X.fromSpecStalk (genericPoint X) →
      ∀ (e : ⊤ ≤ h ⁻¹ᵁ U) (s : Γ(X, U)),
      (Scheme.ΓSpecIso (CommRingCat.of L)).hom ((h.appLE U ⊤ e) s) =
        εX ((X.presheaf.germ U (genericPoint X) hη) s) := by
    intro X _ εX U hη h hh e s
    subst hh
    rw [Scheme.Hom.comp_appLE, Scheme.fromSpecStalk_app hη]
    simp only [Category.assoc]
    erw [Scheme.Hom.map_appLE]
    erw [happLE_top]
    rw [CommRingCat.comp_apply, CommRingCat.comp_apply, hN2]
    erw [Iso.inv_hom_id_apply]
    rfl
  have hW : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
      (εX : X.functionField ≃+* L) (U : X.Opens) (hη : genericPoint X ∈ U)
      (g : Spec (.of L) ⟶ U.toScheme),
      g ≫ U.ι = Spec.map (CommRingCat.ofHom (εX : X.functionField →+* L)) ≫
        X.fromSpecStalk (genericPoint X) →
      ∀ s : Γ(X, U), (Scheme.ΓSpecIso (CommRingCat.of L)).hom (g.appTop (U.topIso.inv s)) =
        εX ((X.presheaf.germ U (genericPoint X) hη) s) := by
    intro X _ εX U hη g hg s
    have e₀ : ⊤ ≤ U.ι ⁻¹ᵁ U := by simp
    have e₁ : ⊤ ≤ g ⁻¹ᵁ ⊤ := by simp
    rw [htopIso U e₀, ← happLE_top g e₁,
      ← CommRingCat.comp_apply (U.ι.appLE U ⊤ e₀) (g.appLE ⊤ ⊤ e₁),
      Scheme.Hom.appLE_comp_appLE]
    exact hG X εX U hη _ hg _ s

  have hinj : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
      (εX : X.functionField ≃+* L) (U : X.Opens) (hη : genericPoint X ∈ U)
      (g : Spec (.of L) ⟶ U.toScheme),
      g ≫ U.ι = Spec.map (CommRingCat.ofHom (εX : X.functionField →+* L)) ≫
        X.fromSpecStalk (genericPoint X) →
      Function.Injective (fun z : Γ(U.toScheme, ⊤) =>
        (Scheme.ΓSpecIso (CommRingCat.of L)).hom (g.appTop z)) := by
    intro X _ εX U hη g hg z z' hzz
    have hz : z = U.topIso.inv (U.topIso.hom z) := (Iso.hom_inv_id_apply _ _).symm
    have hz' : z' = U.topIso.inv (U.topIso.hom z') := (Iso.hom_inv_id_apply _ _).symm
    simp only at hzz
    rw [hz, hz', hW X εX U hη g hg, hW X εX U hη g hg] at hzz
    have h2 := germ_injective_of_isIntegral X (genericPoint X) hη (εX.injective hzz)
    rw [hz, hz', h2]

  have s3 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsProper f →
      ∀ (i₁ : Spec (.of L) ⟶ X) (i₂ : Spec (CommRingCat.of V) ⟶ Y),
      i₁ ≫ f = Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ i₂ →
      ∃ l : Spec (CommRingCat.of V) ⟶ X,
        Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ l = i₁ ∧ l ≫ f = i₂ := by
    intro X Y f hf i₁ i₂ h
    haveI := hf
    have hv : ValuativeCriterion.Existence f := by
      have h1 : UniversallyClosed f := inferInstance
      rw [UniversallyClosed.eq_valuativeCriterion] at h1
      exact h1.1
    let S : ValuativeCommSq f := ⟨V, L, i₁, i₂, ⟨h⟩⟩
    obtain ⟨l⟩ := (hv S).exists_lift
    exact ⟨l.l, l.fac_left, l.fac_right⟩

  have s4 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsSeparated f →
      ∀ (a b : Spec (CommRingCat.of V) ⟶ X), a ≫ f = b ≫ f →
      Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ a =
        Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ b → a = b := by
    intro X Y f hf a b h1 h2
    haveI := hf
    have hu := IsSeparated.valuativeCriterion f
    let S : ValuativeCommSq f := ⟨V, L, Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ a, a ≫ f,
      ⟨by rw [Category.assoc]⟩⟩
    haveI := hu S
    let la : S.commSq.LiftStruct := ⟨a, rfl, rfl⟩
    let lb : S.commSq.LiftStruct := ⟨b, h2.symm, h1.symm⟩
    have := Subsingleton.elim la lb
    exact congrArg CommSq.LiftStruct.l this

  have s5 : ∀ (i : Spec (.of L) ⟶ Spec (.of k)), ∃ j : Spec (CommRingCat.of V) ⟶ Spec (.of k),
      Spec.map (CommRingCat.ofHom (algebraMap V L)) ≫ j = i := by
    intro i
    haveI := Fintype.ofFinite k
    have hmem : ∀ c : k, (Spec.preimage i).hom c ∈ V := by
      intro c
      rcases V.mem_or_inv_mem ((Spec.preimage i).hom c) with h | h
      · exact h
      · by_cases hc : c = 0
        · rw [hc, map_zero]; exact V.zero_mem
        · have hq : 2 ≤ Fintype.card k := Fintype.one_lt_card
          have hpow : ((Spec.preimage i).hom c) ^ (Fintype.card k - 2 + 1) = 1 := by
            have e : Fintype.card k - 2 + 1 = Fintype.card k - 1 := by omega
            rw [e, ← map_pow, FiniteField.pow_card_sub_one_eq_one c hc, map_one]
          have key : (Spec.preimage i).hom c =
              (((Spec.preimage i).hom c)⁻¹) ^ (Fintype.card k - 2) := by
            rw [inv_pow]
            apply eq_inv_of_mul_eq_one_left
            rw [← pow_succ']
            exact hpow
          rw [key]
          exact V.pow_mem h _
    let ψ : k →+* V := (Spec.preimage i).hom.codRestrict V.toSubring hmem
    refine ⟨Spec.map (CommRingCat.ofHom ψ), ?_⟩
    rw [← Spec.map_comp]
    conv_rhs => rw [← Spec.map_preimage i]
    congr 1

  have s6 : ∀ (R : Type u) [CommRing R] (χ : R →+* L), Function.Injective χ →
      (∀ x ∈ F, ((x : V) : L) ∈ Set.range χ) →
      ∃ θ : ↥(Subring.closure (F : Set V)) →+* R,
        ∀ x : ↥(Subring.closure (F : Set V)), χ (θ x) = ((x : V) : L) := by
    intro R _ χ hχ hF
    let T : Subring V := (χ.range).comap V.subtype
    have hle : Subring.closure (F : Set V) ≤ T := by
      rw [Subring.closure_le]
      intro x hx
      obtain ⟨r, hr⟩ := hF x hx
      exact RingHom.mem_range.mpr ⟨r, hr⟩
    let e : R ≃+* χ.range := RingEquiv.ofBijective χ.rangeRestrict
      ⟨fun a b h => hχ (congrArg Subtype.val h), χ.rangeRestrict_surjective⟩
    let ι₀ : ↥(Subring.closure (F : Set V)) →+* χ.range :=
      (V.subtype.comp (Subring.closure (F : Set V)).subtype).codRestrict χ.range
        (fun x => hle x.2)
    refine ⟨e.symm.toRingHom.comp ι₀, fun x => ?_⟩
    have : ((e (e.symm (ι₀ x)) : χ.range) : L) = (ι₀ x : L) := by rw [RingEquiv.apply_symm_apply]
    exact this

  have s8 : ∀ (S : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] (m : ℕ)
      (y : Fin m → S.functionField),
      ∃ (W : S.Opens) (hη : genericPoint S ∈ W) (s : Fin m → Γ(S, W)), IsAffineOpen W ∧
        ∀ i, (S.presheaf.germ W (genericPoint S) hη) (s i) = y i := by
    intro S _ m y
    choose U hU t ht using fun i =>
      TopCat.Presheaf.exists_germ_eq S.presheaf (x := genericPoint S) (y i)
    have hmem : ∀ x : S, x ∈ (⨅ i, U i : S.Opens) ↔ ∀ i, x ∈ U i := by
      intro x
      show x ∈ ((⨅ i, U i : S.Opens) : Set S) ↔ _
      rw [TopologicalSpace.Opens.coe_iInf, Set.mem_iInter]
      rfl
    obtain ⟨W, hW, hηW, hWsub⟩ := exists_isAffineOpen_mem_and_subset ((hmem _).mpr hU)
    have hle : ∀ i, W ≤ U i := fun i x hx => (hmem x).mp (hWsub hx) i
    refine ⟨W, hηW, fun i => (S.presheaf.map (homOfLE (hle i)).op) (t i), hW, fun i => ?_⟩
    rw [TopCat.Presheaf.germ_res_apply]
    exact ht i

  have s9 : ∀ (X : Scheme.{u}) (R A : CommRingCat.{u}) (c : Spec R ⟶ X) (θ : A ⟶ Γ(X, ⊤)),
      c ≫ X.toSpecΓ ≫ Spec.map θ =
        Spec.map (θ ≫ Scheme.Hom.appTop c ≫ (Scheme.ΓSpecIso R).hom) := by
    intro X R A c θ
    rw [← Category.assoc, Scheme.toSpecΓ_naturality, ← SpecMap_ΓSpecIso_hom]
    simp only [Spec.map_comp, Category.assoc]

  have s2 : ∀ m : ℕ, ∃ x : Fin m → Γ((wcSgD k m 0).toScheme, ⊤),
      (∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) (v : Fin m → Γ(X, ⊤)),
        ∃ q : X ⟶ (wcSgD k m 0).toScheme, q ≫ (wcSgD k m 0).ι ≫ wcProjKStr k m = f ∧
          ∀ i, q.appTop (x i) = v i) ∧
      (∀ (X : Scheme.{u}) (q q' : X ⟶ (wcSgD k m 0).toScheme),
        q ≫ (wcSgD k m 0).ι ≫ wcProjKStr k m = q' ≫ (wcSgD k m 0).ι ≫ wcProjKStr k m →
        (∀ i, q.appTop (x i) = q'.appTop (x i)) → q = q') := by
    intro m
    obtain ⟨e₀, he₀⟩ := wc_pp_dehomogenize_ringEquiv k m 0
    obtain ⟨φ, hφ⟩ := wc_pp_chart_iso k m 0 e₀ he₀
    refine ⟨fun i => φ.hom.appTop (AffineSpace.coord (Spec (.of k)) ⟨i⟩), ?_, ?_⟩
    · intro X f v
      refine ⟨AffineSpace.homOfVector f (fun j => v j.down) ≫ φ.inv, ?_, ?_⟩
      · rw [hφ, Category.assoc, Iso.inv_hom_id_assoc, AffineSpace.homOfVector_over]
      · intro i
        dsimp only
        rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, Category.assoc, Iso.inv_hom_id,
          Category.comp_id, AffineSpace.homOfVector_appTop_coord]
    · intro X q q' h1 h2
      have : q ≫ φ.hom = q' ≫ φ.hom := by
        apply AffineSpace.hom_ext
        · simp only [Category.assoc, ← hφ]; exact h1
        · intro i
          rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
            CommRingCat.comp_apply]
          exact h2 i.down
      exact (cancel_mono φ.hom).mp this

  have s1 : ∀ (W : S₀.Opens) (m : ℕ) (q : W.toScheme ⟶ wcProjK k m), IsAffineOpen W → W ≠ ⊥ →
      q ≫ wcProjKStr k m = W.ι ≫ sS₀ →
      ∃ (SV : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral SV) (dV : SV ⟶ S₀)
        (pr : SV ⟶ wcProjK k m) (t : W.toScheme ⟶ SV),
        IsOpenImmersion t ∧ wcpaDjIsProjOver k (dV ≫ sS₀) ∧ IsProper dV ∧ IsIso (dV ∣_ W) ∧
        t ≫ dV = W.ι ∧ t ≫ pr = q ∧ pr ≫ wcProjKStr k m = dV ≫ sS₀ := by
    intro W m q hWa hW0 hq
    haveI : IsAffine W := hWa
    obtain ⟨w₀, hw₀⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty W).mp hW0
    haveI : Nonempty W := ⟨⟨w₀, hw₀⟩⟩
    haveI : AlgebraicGeometry.IsIntegral W.toScheme := isIntegral_of_isOpenImmersion W.ι
    have hR : wcpaDjIsProjOver k (wcProjKStr k m) := ⟨m, 𝟙 _, inferInstance, Category.id_comp _⟩
    haveI : IsProper sS₀ := wcpa_dj_proj_proper k sS₀ hS₀
    have hQ1 : wcpaDjIsProjOver k
        (Limits.pullback.snd sS₀ (wcProjKStr k m) ≫ wcProjKStr k m) := by
      have := wcpa_dj_ssm_proj_fibre_product k S₀ (Spec (.of k)) (wcProjK k m)
        (Limits.pullback sS₀ (wcProjKStr k m)) (𝟙 _) sS₀ (wcProjKStr k m) (𝟙 _) inferInstance
        (by rw [Category.comp_id]; exact hS₀) (by rw [Category.comp_id]; exact hR) inferInstance
      rwa [Category.comp_id, Category.id_comp] at this
    haveI : IsProper (Limits.pullback.snd sS₀ (wcProjKStr k m) ≫ wcProjKStr k m) :=
      wcpa_dj_proj_proper k _ hQ1
    haveI := quasiSeparatedSpace_of_quasiSeparated
      (Limits.pullback.snd sS₀ (wcProjKStr k m) ≫ wcProjKStr k m)
    have w₁ : W.ι ≫ sS₀ = q ≫ wcProjKStr k m := hq.symm
    obtain ⟨γ, hγ1, hγ2⟩ : ∃ γ : W.toScheme ⟶ Limits.pullback sS₀ (wcProjKStr k m),
        γ ≫ Limits.pullback.fst sS₀ (wcProjKStr k m) = W.ι ∧
        γ ≫ Limits.pullback.snd sS₀ (wcProjKStr k m) = q :=
      ⟨Limits.pullback.lift _ _ w₁, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    haveI hQC : QuasiCompact γ := quasiCompact_of_compactSpace γ
    haveI hint : AlgebraicGeometry.IsIntegral (Scheme.Hom.image γ) :=
      wcpa_dj_gc_image_integral _ _ γ hQC
    obtain ⟨dV, hdV⟩ : ∃ b : Scheme.Hom.image γ ⟶ S₀,
        b = Scheme.Hom.imageι γ ≫ Limits.pullback.fst sS₀ (wcProjKStr k m) := ⟨_, rfl⟩
    obtain ⟨pr, hpr⟩ : ∃ b : Scheme.Hom.image γ ⟶ wcProjK k m,
        b = Scheme.Hom.imageι γ ≫ Limits.pullback.snd sS₀ (wcProjKStr k m) := ⟨_, rfl⟩
    have hprojI : wcpaDjIsProjOver k (Scheme.Hom.imageι γ ≫
        Limits.pullback.snd sS₀ (wcProjKStr k m) ≫ wcProjKStr k m) := by
      have := wcpa_dj_ssm_proj_fibre_product k S₀ (Spec (.of k)) (wcProjK k m)
        (Scheme.Hom.image γ) (𝟙 _) sS₀ (wcProjKStr k m) (Scheme.Hom.imageι γ) inferInstance
        (by rw [Category.comp_id]; exact hS₀) (by rw [Category.comp_id]; exact hR) inferInstance
      rwa [Category.comp_id] at this
    have hprst : pr ≫ wcProjKStr k m = dV ≫ sS₀ := by
      rw [hpr, hdV, Category.assoc, Category.assoc, Limits.pullback.condition]
    have hproj : wcpaDjIsProjOver k (dV ≫ sS₀) := by
      rw [← hprst, hpr, Category.assoc]; exact hprojI
    haveI hprop : IsProper dV := by
      haveI : IsProper (dV ≫ sS₀) := wcpa_dj_proj_proper k _ hproj
      exact IsProper.of_comp dV sS₀
    have hU : dV ⁻¹ᵁ W = (Scheme.Hom.imageι γ ≫ Limits.pullback.fst sS₀ (wcProjKStr k m)) ⁻¹ᵁ W := by
