      rw [← neg_sub]; exact neg_mem ha
    exact Ideal.Quotient.eq.mpr ha'
  obtain ⟨e₀, he₀⟩ : ∃ e₀ : IsLocalRing.ResidueField A ≃+*
      IsLocalRing.ResidueField (AdicCompletion (IsLocalRing.maximalIdeal A) A),
      ∀ a, e₀ (IsLocalRing.residue A a) = IsLocalRing.residue _ (algebraMap A _ a) :=
    ⟨RingEquiv.ofBijective _ ⟨hinjres, hsurjres⟩, fun a => by
