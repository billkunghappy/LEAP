      have hπs : π (ι s) = Ideal.Quotient.mk _ (MvPowerSeries.C (r s)) := RingHom.congr_fun hπι s
      have hG : G = MvPowerSeries.C (MvPowerSeries.constantCoeff G) + MvPowerSeries.X 0 * a +
