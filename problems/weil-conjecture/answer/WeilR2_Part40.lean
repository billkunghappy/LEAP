    have hβint : β.IsIntegral := by
      rw [hβeq]
      refine RingHom.IsIntegral.trans _ _ (RingHom.IsIntegral.trans _ _ ?_ ?_) ?_
      · exact RingHom.isIntegral_of_surjective _ eÂ.symm.surjective
      · exact fun x => Algebra.IsIntegral.isIntegral x
      · exact RingHom.isIntegral_of_surjective _ hprs
    obtain ⟨h', hh'⟩ : ∃ h' : nccwffQ R 0, h' = eÂ (algebraMap A Â hh) := ⟨_, rfl⟩
