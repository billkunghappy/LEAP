    refine ⟨fun a => (h.app (W a)).hom (β a), fun a b => ?_⟩
    rw [← hc' a b, hβ a b, map_sub, hnat h, hnat h]
    rfl

  have push : ∀ (X' X : Scheme.{u}) (h : X' ⟶ X) {m : ℕ} (W : Fin m → X.Opens),
