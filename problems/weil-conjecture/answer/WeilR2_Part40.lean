    rw [hψ₁def, Category.assoc, hψ₀, ← Category.assoc, Scheme.homOfLE_ι]
  have hφ₁k : ∀ k : AL ⟶ (pa ⁻¹ᵁ V₃.1).toScheme, k ≫ (pa ⁻¹ᵁ V₃.1).ι = qA → k ≫ φ₁ = qB := by
    intro k hk
