    obtain ⟨x, rfl⟩ := (hmem ξ).mp hξ
    refine ⟨x, rfl, ?_⟩
    obtain ⟨C, hC, hxC⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible (closure {x})
        (isIrreducible_singleton (x := x)).closure
    have hCc : IsClosed C := isClosed_of_mem_irreducibleComponents C hC
    obtain ⟨c, hc⟩ := QuasiSober.sober hC.1 hCc
    have hcC : closure {c} = C := hc.def
    have hcx : c ⤳ x := by
      rw [specializes_iff_mem_closure, hcC]
      exact hxC (subset_closure rfl)
    have heq : f c = f x := hmax (f c) ((hmem _).mpr ⟨c, rfl⟩) (hcx.map C1.continuous)
    rw [← hinj heq, hcC]
    exact hC

theorem wcpa_dj_nccw_max_point_dvr : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], IsAlgClosed (IsLocalRing.ResidueField R) → ∀ (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), wcpaDjSemistable u → ∀ ξ : Z, nccwsuMaxS u ξ → IsDomain (Z.presheaf.stalk ξ) ∧ IsIntegrallyClosed (Z.presheaf.stalk ξ) ∧ ¬ IsClosed ({ξ} : Set Z) :=
