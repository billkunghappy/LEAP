  have hft1 : (u.appLE ⊤ V e).hom.FiniteType :=
    HasRingHomProperty.appLE @LocallyOfFiniteType u hu ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ e
  have hft2 : (Scheme.ΓSpecIso (.of R)).inv.hom.FiniteType :=
    RingHom.FiniteType.of_surjective _ (fun y => ⟨(Scheme.ΓSpecIso (.of R)).hom.hom y, by simp⟩)
  letI : Algebra R Γ(Z, V) := ((u.appLE ⊤ V e).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom).toAlgebra
  have hft : Algebra.FiniteType R Γ(Z, V) := hft1.comp hft2

  haveI := hdom
  haveI := hic
  haveI hLdom : IsDomain (Localization.AtPrime (hV.primeIdealOf xV).asIdeal) :=
    Function.Injective.isDomain (φ.symm : Localization.AtPrime (hV.primeIdealOf xV).asIdeal →+*
