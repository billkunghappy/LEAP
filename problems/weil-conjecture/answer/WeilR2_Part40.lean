      (Q : Ideal (TensorProduct B C₀ A)) [Q.IsPrime] :
      IsDomain (Localization.AtPrime Q) ∧ IsIntegrallyClosed (Localization.AtPrime Q) := by
    let L := Localization.AtPrime 𝔪
    let O := AdicCompletion (IsLocalRing.maximalIdeal L) L
    let C := TensorProduct B L C₀
    have hCft : Algebra.FiniteType L C := inferInstance
    have hCnorm : ∀ (P : Ideal C) [P.IsPrime],
        IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P) := by
      intro P _
      letI : Algebra C₀ C := Algebra.TensorProduct.rightAlgebra
      haveI : IsLocalization (Algebra.algebraMapSubmonoid C₀ 𝔪.primeCompl) C :=
        IsLocalization.tensorRight (R := B) (S := C₀) L 𝔪.primeCompl
      haveI hloc := IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
        (M := Algebra.algebraMapSubmonoid C₀ 𝔪.primeCompl) (S := C) (Localization.AtPrime P) P
      let P₀ := Ideal.comap (algebraMap C₀ C) P
      let ψ := IsLocalization.algEquiv P₀.primeCompl (Localization.AtPrime P) (Localization.AtPrime P₀)
      obtain ⟨h1, h2⟩ := hC₀ P₀
      exact ⟨MulEquiv.isDomain _ ψ.toMulEquiv, IsIntegrallyClosed.of_equiv ψ.symm.toRingEquiv⟩
    let D := TensorProduct L O C
    letI : Algebra C D := Algebra.TensorProduct.rightAlgebra
    haveI : IsScalarTower L C D := Algebra.TensorProduct.right_isScalarTower
    have hpush : Algebra.IsPushout L O C D := TensorProduct.isPushout
    have hD := hExcL C hCft hCnorm D hpush
    let Θ1 := Algebra.TensorProduct.cancelBaseChange B L O O C₀
    let e₁B : O ≃ₐ[B] A := AlgEquiv.ofRingEquiv (f := e₁) he₁
    let Θ2 := Algebra.TensorProduct.congr e₁B (AlgEquiv.refl : C₀ ≃ₐ[B] C₀)
    let Θ3 := Algebra.TensorProduct.comm B A C₀
    let Θ : D ≃+* TensorProduct B C₀ A :=
      Θ1.toRingEquiv.trans (Θ2.toRingEquiv.trans Θ3.toRingEquiv)
    have transfer : ∀ (D₁ T₁ : Type u) [CommRing D₁] [CommRing T₁] (Θ₁ : D₁ ≃+* T₁),
