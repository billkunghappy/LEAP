        RingEquiv.symm_apply_eq, he₀]

  have hmaxÂ : IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A) =
      (IsLocalRing.maximalIdeal A).map (algebraMap A _) := by
