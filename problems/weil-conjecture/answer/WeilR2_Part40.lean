          (Ideal.primeCompl_le_nonZeroDivisors P)⟩
    have hpush : Algebra.IsPushout (Localization.AtPrime 𝔪)
        (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
          (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪)
        (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
          (Localization.AtPrime 𝔪)) := inferInstance
    have hft' : Algebra.FiniteType (Localization.AtPrime 𝔪) (Localization.AtPrime 𝔪) :=
      inferInstance
    have hQ := hE R hcomp B hft 𝔪 (Localization.AtPrime 𝔪) hft' hprim
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
        (Localization.AtPrime 𝔪)) hpush (IsLocalRing.maximalIdeal _)
    haveI := hQ.1
    have hle : (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal
        (Localization.AtPrime 𝔪)) (Localization.AtPrime 𝔪))).primeCompl ≤ nonZeroDivisors _ :=
      fun x hx => (IsLocalRing.notMem_maximalIdeal.mp hx).mem_nonZeroDivisors
    exact Function.Injective.isDomain (algebraMap _ (Localization.AtPrime (IsLocalRing.maximalIdeal
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪))
        (Localization.AtPrime 𝔪)))))
