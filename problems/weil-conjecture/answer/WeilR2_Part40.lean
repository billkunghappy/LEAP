  have hc : (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set W)).subtype))
      (IsLocalRing.closedPoint W) ∈ G := hrange ⟨_, rfl⟩
  obtain ⟨_, ⟨g, rfl⟩, hcg, hgG⟩ :=
    (PrimeSpectrum.isTopologicalBasis_basic_opens
      (R := ↥(Subring.closure (F : Set W)))).exists_subset_of_mem_open hc G.isOpen
  have hgu : IsUnit ((Subring.closure (F : Set W)).subtype g) := by
    have h1 : (Subring.closure (F : Set W)).subtype g ∉ IsLocalRing.maximalIdeal W := hcg
    exact IsLocalRing.notMem_maximalIdeal.mp h1
  obtain ⟨w, hw⟩ := hgu.exists_right_inv
  have hw' : (((Subring.closure (F : Set W)).subtype g : W) : AlgebraicClosure P.functionField) *
      (w : AlgebraicClosure P.functionField) = 1 := congrArg Subtype.val hw

  have hgen : ∀ (B : Type u) [Ring B] (ι : ↥(Subring.closure (F : Set W)) →+* B) (T : Subring B),
      (∀ x (hx : x ∈ (F : Set W)), ι ⟨x, Subring.subset_closure hx⟩ ∈ T) → ∀ a, ι a ∈ T := by
    intro B _ ι T h a
    obtain ⟨a, ha⟩ := a
    refine Subring.closure_induction (p := fun x hx => ι ⟨x, hx⟩ ∈ T) ?_ ?_ ?_ ?_ ?_ ?_ ha
    · intro x hx
      exact h x hx
    · change ι 0 ∈ T
      rw [map_zero]
      exact T.zero_mem
    · change ι 1 ∈ T
      rw [map_one]
      exact T.one_mem
    · intro x y hx hy ihx ihy
      change ι (⟨x, hx⟩ + ⟨y, hy⟩) ∈ T
      rw [map_add]
      exact T.add_mem ihx ihy
    · intro x hx ih
      change ι (-⟨x, hx⟩) ∈ T
      rw [map_neg]
      exact T.neg_mem ih
    · intro x y hx hy ihx ihy
      change ι (⟨x, hx⟩ * ⟨y, hy⟩) ∈ T
      rw [map_mul]
      exact T.mul_mem ihx ihy

  let ιΩ : ↥(Subring.closure (F : Set W)) →+* AlgebraicClosure P.functionField :=
    (algebraMap W (AlgebraicClosure P.functionField)).comp (Subring.closure (F : Set W)).subtype
  let E₀ : IntermediateField P.functionField (AlgebraicClosure P.functionField) :=
    IntermediateField.adjoin P.functionField
      ((fun x : W => (x : AlgebraicClosure P.functionField)) '' (F : Set W))
  haveI : Finite ((fun x : W => (x : AlgebraicClosure P.functionField)) '' (F : Set W)) :=
    (F.finite_toSet.image _).to_subtype
  haveI hE₀fd : FiniteDimensional P.functionField E₀ :=
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
  have hE₀ : ∀ a, ιΩ a ∈ E₀ := fun a =>
    hgen _ ιΩ E₀.toSubring (fun x hx => IntermediateField.subset_adjoin _ _ ⟨x, hx, rfl⟩) a

  have hbinc : Spec.map (CommRingCat.ofHom (algebraMap W (AlgebraicClosure P.functionField))) ≫
      Spec.map (CommRingCat.ofHom (Subring.closure (F : Set W)).subtype) =
      Spec.map (CommRingCat.ofHom ιΩ) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have hψΩ : IsPullback (ψw ≫ φ) πw u₀ (Spec.map (CommRingCat.ofHom ιΩ)) := by
    rw [← hbinc]; exact hψ.paste_horiz hφ
  have htψΩ : ∀ i, tw i ≫ ψw ≫ φ = Spec.map (CommRingCat.ofHom ιΩ) ≫ τ₀ i := by
    intro i
    rw [reassoc_of% (htψ i), hτφ i, ← Category.assoc, hbinc]
  obtain ⟨E, hEfd, hE, YE, πE, χE, ψE, tE, _hE₀E, hχE, hψE, htπE, htχE, htψE⟩ :=
    wcpa_dj_lus_generic_iso_finite X P f n σ _ Z₀ u₀ τ₀ ιΩ E₀ hE₀fd hE₀ hfP hpr hfp hτ₀
      Yw πw χw (ψw ≫ φ) tw hχ hψΩ htπ htχ htψΩ

  let ιE : ↥(Subring.closure (F : Set W)) →+* E := ιΩ.codRestrict E hE
  have hg'0 : ιE g ≠ 0 := by
    intro h0
    have h1 : ((ιE g : E) : AlgebraicClosure P.functionField) = 0 := congrArg Subtype.val h0
    have h2 := hw'
    rw [show (((Subring.closure (F : Set W)).subtype g : W) : AlgebraicClosure P.functionField) =
      ((ιE g : E) : AlgebraicClosure P.functionField) from rfl, h1, zero_mul] at h2
    exact zero_ne_one h2
  refine ⟨E, hEfd, insert (ιE g)⁻¹ (F.attach.image
    (fun x => ιE ⟨x.1, Subring.subset_closure (Finset.mem_coe.mpr x.2)⟩)), ?_, ?_⟩
  · intro s hs
    rcases Finset.mem_insert.mp hs with rfl | hs
    · rw [IntermediateField.coe_inv]
      rw [show ((ιE g : E) : AlgebraicClosure P.functionField) =
        (((Subring.closure (F : Set W)).subtype g : W) : AlgebraicClosure P.functionField) from rfl,
        inv_eq_of_mul_eq_one_right hw']
      exact w.2
    · obtain ⟨x, _, rfl⟩ := Finset.mem_image.mp hs
      exact x.1.2

  intro V hSV
  have hAV : ∀ a, ιE a ∈ V := fun a =>
    hgen _ ιE V.toSubring (fun x hx => hSV _ (Finset.mem_insert_of_mem
      (Finset.mem_image.mpr ⟨⟨x, hx⟩, Finset.mem_attach _ _, rfl⟩))) a
  let ρ : ↥(Subring.closure (F : Set W)) →+* ↥V := ιE.codRestrict V hAV
  have hinvV : (ιE g)⁻¹ ∈ V := hSV _ (Finset.mem_insert_self _ _)
  have hρu : IsUnit (ρ g) := by
    refine isUnit_iff_exists_inv.mpr ⟨⟨(ιE g)⁻¹, hinvV⟩, ?_⟩
    apply Subtype.ext
    show ιE g * (ιE g)⁻¹ = 1
    exact mul_inv_cancel₀ hg'0
  have hrangeV : Set.range ⇑(Spec.map (CommRingCat.ofHom ρ)) ⊆
      (G : Set (Spec (.of ↥(Subring.closure (F : Set W))))) := by
    rintro _ ⟨q, rfl⟩
    refine hgG ?_
    show g ∉ Ideal.comap ρ q.asIdeal
    rw [Ideal.mem_comap]
    intro hq
    exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hq hρu)
  exact wcpa_dj_lus_model_at_valuation X P f n σ E _ ιE Z₀ u₀ τ₀ G τG YE πE χE ψE tE hZ₀proj
    hstG hτG hχE hψE htπE htχE htψE V ρ (fun a => rfl) hrangeV

theorem wcpa_dj_lus_locstable_basechange : ∀ (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral P]
    (f : X ⟶ P) (n : ℕ) (σ : Fin n → (P ⟶ X)) (L₁ L₂ : Type u) [Field L₁] [Field L₂]
    [Algebra P.functionField L₁] [Algebra P.functionField L₂] [Algebra L₁ L₂]
    [IsScalarTower P.functionField L₁ L₂] (V₂ : ValuationSubring L₂),
    wcpaDjLocStable f σ L₁ (V₂.comap (algebraMap L₁ L₂)) → wcpaDjLocStable f σ L₂ V₂ :=
by
  refine (fun (hSB : ∀ (Z T T' : Scheme.{u}) (uu : Z ⟶ T) (n : ℕ)
      (τ : Fin n → (T ⟶ Z)) (b : T' ⟶ T), wcpaDjStablePtd uu n τ →
      ∃ τ' : Fin n → (T' ⟶ Limits.pullback uu b),
        wcpaDjStablePtd (Limits.pullback.snd uu b) n τ' ∧
        (∀ i, τ' i ≫ Limits.pullback.snd uu b = 𝟙 T') ∧
        (∀ i, τ' i ≫ Limits.pullback.fst uu b = b ≫ τ i))
    (hPB : ∀ (F F' : Type u) [CommRing F] [CommRing F'] [Algebra F F'] (N : ℕ),
      ∃ e : Limits.pullback (@Proj.toSpecZero _ _ _ _ _
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
              MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
                (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))))
            (Spec.map (CommRingCat.ofHom (algebraMap F F'))) ⟶
          @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
            MvPolynomial.gradedAlgebra,
        IsIso e ∧
        e ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
              MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
                (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) =
          Limits.pullback.snd _ _) => ?_) ?_ ?_
  have hAbs : ∀ {Z PR PR' S S' : Scheme.{u}} (uu : Z ⟶ S) (p : PR ⟶ S) (g : S' ⟶ S)
      (p' : PR' ⟶ S') (e : Limits.pullback p g ⟶ PR') (j : Z ⟶ PR),
      IsIso e → e ≫ p' = Limits.pullback.snd p g → IsClosedImmersion j → j ≫ p = uu →
      ∃ j' : Limits.pullback uu g ⟶ PR', IsClosedImmersion j' ∧
        j' ≫ p' = Limits.pullback.snd uu g := by
    intro Z PR PR' S S' uu p g p' e j he_iso he hj hjeq
    have w : (Limits.pullback.fst uu g ≫ j) ≫ p = Limits.pullback.snd uu g ≫ g := by
      rw [Category.assoc, hjeq, Limits.pullback.condition]
    obtain ⟨jb, hjb1, hjb2⟩ : ∃ jb : Limits.pullback uu g ⟶ Limits.pullback p g,
        jb ≫ Limits.pullback.fst p g = Limits.pullback.fst uu g ≫ j ∧
        jb ≫ Limits.pullback.snd p g = Limits.pullback.snd uu g :=
      ⟨Limits.pullback.lift _ _ w, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have hsq : IsPullback jb (Limits.pullback.fst uu g) (Limits.pullback.fst p g) j := by
      have hout : IsPullback (jb ≫ Limits.pullback.snd p g) (Limits.pullback.fst uu g) g
          (j ≫ p) := by
        rw [hjb2, hjeq]
        exact (IsPullback.of_hasPullback uu g).flip
      exact IsPullback.of_right hout hjb1 (IsPullback.of_hasPullback p g).flip
    haveI hjb : IsClosedImmersion jb :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip hj
    haveI := he_iso
    refine ⟨jb ≫ e, inferInstance, ?_⟩
    rw [Category.assoc, he, hjb2]
  intro X P _ f n σ L₁ L₂ _ _ _ _ _ _ V₂ h
  have hGlue : ∀ {X' P' SV₁ SV₂ SL₁ SL₂ Z₁ Y₁ : Scheme.{u}} (f' : X' ⟶ P') (b : SV₂ ⟶ SV₁)
      (c : SL₂ ⟶ SL₁) (e₁ : SL₁ ⟶ SV₁) (e₂ : SL₂ ⟶ SV₂) (a₁ : SL₁ ⟶ P') (a₂ : SL₂ ⟶ P')
      (σ' : Fin n → (P' ⟶ X')) (u₁ : Z₁ ⟶ SV₁) (τ₁ : Fin n → (SV₁ ⟶ Z₁)) (χ₁ : Y₁ ⟶ X')
      (ψ₁ : Y₁ ⟶ Z₁) (π₁ : Y₁ ⟶ SL₁) (t₁ : Fin n → (SL₁ ⟶ Y₁)),
      e₂ ≫ b = c ≫ e₁ → c ≫ a₁ = a₂ → IsPullback χ₁ π₁ f' a₁ → IsPullback ψ₁ π₁ u₁ e₁ →
      (∀ i, t₁ i ≫ π₁ = 𝟙 _) → (∀ i, t₁ i ≫ χ₁ = a₁ ≫ σ' i) →
      (∀ i, t₁ i ≫ ψ₁ = e₁ ≫ τ₁ i) →
      ∀ τ₂ : Fin n → (SV₂ ⟶ Limits.pullback u₁ b),
      (∀ i, τ₂ i ≫ Limits.pullback.snd u₁ b = 𝟙 SV₂) →
      (∀ i, τ₂ i ≫ Limits.pullback.fst u₁ b = b ≫ τ₁ i) →
      ∃ (Y₂ : Scheme.{u}) (χ₂ : Y₂ ⟶ X') (ψ₂ : Y₂ ⟶ Limits.pullback u₁ b) (π₂ : Y₂ ⟶ SL₂)
        (t₂ : Fin n → (SL₂ ⟶ Y₂)),
        IsPullback χ₂ π₂ f' a₂ ∧ IsPullback ψ₂ π₂ (Limits.pullback.snd u₁ b) e₂ ∧
        (∀ i, t₂ i ≫ π₂ = 𝟙 _) ∧ (∀ i, t₂ i ≫ χ₂ = a₂ ≫ σ' i) ∧
        (∀ i, t₂ i ≫ ψ₂ = e₂ ≫ τ₂ i) := by
    intro X' P' SV₁ SV₂ SL₁ SL₂ Z₁ Y₁ f' b c e₁ e₂ a₁ a₂ σ' u₁ τ₁ χ₁ ψ₁ π₁ t₁ hst hss H3 H4 H5
      H6 H7 τ₂ hτs hτf
    have A : IsPullback (Limits.pullback.fst π₁ c) (Limits.pullback.snd π₁ c) π₁ c :=
      IsPullback.of_hasPullback π₁ c
    have w : (Limits.pullback.fst π₁ c ≫ ψ₁) ≫ u₁ = (Limits.pullback.snd π₁ c ≫ e₂) ≫ b := by
      simp only [Category.assoc]
      rw [H4.w, hst]
      exact Limits.pullback.condition_assoc e₁
    obtain ⟨ψ₂, hψ1, hψ2⟩ : ∃ ψ₂ : Limits.pullback π₁ c ⟶ Limits.pullback u₁ b,
        ψ₂ ≫ Limits.pullback.fst u₁ b = Limits.pullback.fst π₁ c ≫ ψ₁ ∧
        ψ₂ ≫ Limits.pullback.snd u₁ b = Limits.pullback.snd π₁ c ≫ e₂ :=
      ⟨Limits.pullback.lift _ _ w, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    have wt : ∀ i, (c ≫ t₁ i) ≫ π₁ = 𝟙 SL₂ ≫ c := fun i => by
      rw [Category.assoc, H5 i, Category.comp_id, Category.id_comp]
    obtain ⟨t₂, ht1, ht2⟩ : ∃ t₂ : Fin n → (SL₂ ⟶ Limits.pullback π₁ c),
        (∀ i, t₂ i ≫ Limits.pullback.fst π₁ c = c ≫ t₁ i) ∧
        (∀ i, t₂ i ≫ Limits.pullback.snd π₁ c = 𝟙 SL₂) :=
      ⟨fun i => Limits.pullback.lift _ _ (wt i), fun i => Limits.pullback.lift_fst _ _ _,
        fun i => Limits.pullback.lift_snd _ _ _⟩
    refine ⟨Limits.pullback π₁ c, Limits.pullback.fst π₁ c ≫ χ₁, ψ₂, Limits.pullback.snd π₁ c,
      t₂, ?_, ?_, ht2, ?_, ?_⟩
    · rw [← hss]
      exact A.paste_horiz H3
    · have hout : IsPullback (ψ₂ ≫ Limits.pullback.fst u₁ b) (Limits.pullback.snd π₁ c) u₁
          (e₂ ≫ b) := by
        rw [hψ1, hst]
        exact A.paste_horiz H4
      exact IsPullback.of_right hout hψ2 (IsPullback.of_hasPullback u₁ b)
    · intro i
      rw [← Category.assoc, ht1 i, Category.assoc, H6 i, ← Category.assoc, hss]
    · intro i
      apply Limits.pullback.hom_ext
      · calc (t₂ i ≫ ψ₂) ≫ Limits.pullback.fst u₁ b
            = (t₂ i ≫ Limits.pullback.fst π₁ c) ≫ ψ₁ := by simp only [Category.assoc, hψ1]
          _ = c ≫ (t₁ i ≫ ψ₁) := by rw [ht1 i, Category.assoc]
          _ = (e₂ ≫ b) ≫ τ₁ i := by rw [H7 i, ← Category.assoc, ← hst]
          _ = (e₂ ≫ τ₂ i) ≫ Limits.pullback.fst u₁ b := by
            simp only [Category.assoc, hτf i]
      · simp only [Category.assoc, hψ2, hτs i, Category.comp_id]
        rw [← Category.assoc, ht2 i, Category.id_comp]
  unfold wcpaDjLocStable at h ⊢
  obtain ⟨Z₁, u₁, τ₁, Y₁, χ₁, ψ₁, π₁, t₁, H1, ⟨N, j₁, hj₁, hj₁eq⟩, H3, H4, H5, H6, H7⟩ := h
  letI iV : Algebra ↥(V₂.comap (algebraMap L₁ L₂)) ↥V₂ :=
    ((algebraMap L₁ L₂).restrict (V₂.comap (algebraMap L₁ L₂)) V₂
      (fun x hx => ValuationSubring.mem_comap.mp hx)).toAlgebra
  have hst : Spec.map (CommRingCat.ofHom (algebraMap ↥V₂ L₂)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap ↥(V₂.comap (algebraMap L₁ L₂)) ↥V₂)) =
      Spec.map (CommRingCat.ofHom (algebraMap L₁ L₂)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap ↥(V₂.comap (algebraMap L₁ L₂)) L₁)) := by
    have e0 : (algebraMap ↥V₂ L₂).comp (algebraMap ↥(V₂.comap (algebraMap L₁ L₂)) ↥V₂) =
        (algebraMap L₁ L₂).comp (algebraMap ↥(V₂.comap (algebraMap L₁ L₂)) L₁) :=
      RingHom.ext fun x => rfl
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      e0]
  have hss : Spec.map (CommRingCat.ofHom (algebraMap L₁ L₂)) ≫
      (Spec.map (CommRingCat.ofHom (algebraMap P.functionField L₁)) ≫
        P.fromSpecStalk (genericPoint P)) =
      Spec.map (CommRingCat.ofHom (algebraMap P.functionField L₂)) ≫
        P.fromSpecStalk (genericPoint P) := by
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← IsScalarTower.algebraMap_eq P.functionField L₁ L₂]
  obtain ⟨τ₂, hstab, hτs, hτf⟩ := hSB _ _ _ u₁ n τ₁
    (Spec.map (CommRingCat.ofHom (algebraMap ↥(V₂.comap (algebraMap L₁ L₂)) ↥V₂))) H1
  obtain ⟨e, he_iso, he⟩ := @hPB ↥(V₂.comap (algebraMap L₁ L₂)) ↥V₂ _ _ iV N
  obtain ⟨j₂, hj₂, hj₂eq⟩ := hAbs u₁ _ _ _ e j₁ he_iso he hj₁ hj₁eq
  obtain ⟨Y₂, χ₂, ψ₂, π₂, t₂, P3, P4, P5, P6, P7⟩ :=
    hGlue f _ _ _ _ _ _ σ u₁ τ₁ χ₁ ψ₁ π₁ t₁ hst hss H3 H4 H5 H6 H7 τ₂ hτs hτf
  exact ⟨_, _, τ₂, Y₂, χ₂, ψ₂, π₂, t₂, hstab, ⟨N, j₂, hj₂, hj₂eq⟩, P3, P4, P5, P6, P7⟩

  have wcpa_dj_mm_section_point_unique : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
      (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
      τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) ↔ c = τ (g c) := by
    intro X P V C f b ψ g σ τ H1 H2 H3 H4 c
    have hcomp : ∀ x : V, ψ (τ x) = σ (b x) := by
      intro x
      rw [← Scheme.Hom.comp_apply, H4, Scheme.Hom.comp_apply]
    have hgτ : ∀ x : V, g (τ x) = x := by
      intro x
      rw [← Scheme.Hom.comp_apply, H3]
      rfl
    constructor
    · intro h
      have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
        rw [H3, H2]
        exact IsPullback.id_horiz b
      have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
      obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
      have hg : g c = p := by rw [← hp, hgτ]
      rw [hg, hp]
    · intro h
      calc ψ c = ψ (τ (g c)) := congrArg ψ h
        _ = σ (b (g c)) := hcomp (g c)
  have wcpa_dj_mm_semistable_basechange : ∀ (M P'' Z : Scheme.{u}) (φ : P'' ⟶ M) (u : Z ⟶ M),
      wcpaDjSemistable u → wcpaDjSemistable (Limits.pullback.snd u φ) := by
    have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
          Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
      intro A B _ _ _ _ σ n
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      apply Ideal.pow_right_mono
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro h
      exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
    have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
        (x : AdicCompletion I A),
        Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
      intro A _ I m n h x
      obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
      rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
        Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
      have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
      simpa [smul_eq_mul, Ideal.mul_top] using this
    have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
          AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
          AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
      intro A B _ _ _ _ σ
      let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
          B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
        (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
          (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
