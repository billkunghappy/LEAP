        intro y hy
        rw [pow_succ] at hy
        refine Submodule.mul_induction_on hy ?_ ?_
        · intro a ha b hb
          obtain ⟨ha', hah, hae⟩ := ih a ha
          obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hb
          refine ⟨ha' * ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_, ?_⟩
          · apply hah.mul
            apply MvPolynomial.IsHomogeneous.sum
            intro i _
            have := (MvPolynomial.isHomogeneous_C (Fin r) (c i)).mul
              (MvPolynomial.isHomogeneous_X P i)
            rwa [zero_add] at this
          · simp only [map_mul, map_sum, MvPolynomial.eval_C, MvPolynomial.eval_X, hae, hc]
        · rintro _ _ ⟨h1, hh1, he1⟩ ⟨h2, hh2, he2⟩
          exact ⟨h1 + h2, hh1.add hh2, by rw [map_add, he1, he2]⟩
    have H3 : ∀ (n : ℕ) (y : P), y ∈ I ^ n →
        ∃ h : MvPolynomial (Fin r) P, h.IsHomogeneous n ∧ MvPolynomial.eval x h = y := by
      intro n y hy
      rw [← hx] at hy
      exact H3' n y hy

    let f : (n : ℕ) → MvPowerSeries (Fin r) P →+* P ⧸ I ^ n := fun n =>
      { toFun := fun F => Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F))
        map_one' := by
          rw [← map_one (Ideal.Quotient.mk (I ^ n)), ← map_one (MvPolynomial.eval x)]
          apply HC
          intro d hd
          rw [MvPowerSeries.coeff_truncTotal _ hd, MvPowerSeries.coeff_one, MvPolynomial.coeff_one]
          by_cases h : d = 0
          · subst h; simp
          · simp [h, Ne.symm h]
        map_mul' := by
          intro F G
          rw [← map_mul, ← map_mul]
          apply HC
          intro d hd
          rw [MvPowerSeries.coeff_truncTotal _ hd, MvPowerSeries.coeff_mul, MvPolynomial.coeff_mul]
          refine Finset.sum_congr rfl (fun p hp => ?_)
          have hp' := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          have h1 : p.1.degree + p.2.degree = d.degree := by
            rw [← hp', Finsupp.degree_eq_sum, Finsupp.degree_eq_sum, Finsupp.degree_eq_sum,
              ← Finset.sum_add_distrib]
            rfl
          rw [MvPowerSeries.coeff_truncTotal _ (by omega), MvPowerSeries.coeff_truncTotal _ (by omega)]
        map_zero' := by simp
        map_add' := by intro F G; simp }
    have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (f n) = f m := by
      intro m n hle
      refine RingHom.ext (fun F => ?_)
      have hfp : ∀ y : P, Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ n) y) =
          Ideal.Quotient.mk (I ^ m) y := fun y => rfl
      show Ideal.Quotient.factorPow I hle (Ideal.Quotient.mk (I ^ n)
          (MvPolynomial.eval x (MvPowerSeries.truncTotal n F))) =
        Ideal.Quotient.mk (I ^ m) (MvPolynomial.eval x (MvPowerSeries.truncTotal m F))
      rw [hfp]
      apply HC
      intro d hd
      rw [MvPowerSeries.coeff_truncTotal _ hd,
        MvPowerSeries.coeff_truncTotal _ (lt_of_lt_of_le hd hle)]
    set Ψ := AdicCompletion.liftRingHom I f hf with hΨdef
    have hΨ : ∀ (n : ℕ) (F : MvPowerSeries (Fin r) P), AdicCompletion.evalₐ I n (Ψ F) =
        Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F)) := by
      intro n F
      rw [hΨdef, AdicCompletion.evalₐ_liftRingHom]
      rfl

    have hsurj : Function.Surjective Ψ := by
      intro b
      obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective I P b
      have ha : ∀ m n, m ≤ n → (a : ℕ → P) n - (a : ℕ → P) m ∈ I ^ m := by
        intro m n hmn
        have := AdicCompletion.AdicCauchySequence.mk_eq_mk hmn a
        rw [Submodule.Quotient.eq] at this
        simpa [Ideal.smul_eq_mul, Ideal.mul_top] using this
      let c : ℕ → P := fun k => if k = 0 then 0 else (a : ℕ → P) k
      have hc : ∀ k, c (k + 1) - c k ∈ I ^ k := by
        intro k
        rcases Nat.eq_zero_or_pos k with rfl | hk
        · simp
        · simp only [c, if_neg (Nat.succ_ne_zero k), if_neg hk.ne']
          exact ha k (k + 1) (Nat.le_succ k)
      choose h hh he using fun k => H3 k _ (hc k)
      let F : MvPowerSeries (Fin r) P := fun e => (h e.degree).coeff e
      refine ⟨F, ?_⟩
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [hΨ, AdicCompletion.evalₐ_mk]
      have e1 : Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F)) =
          Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (∑ k ∈ Finset.range n, h k)) := by
        apply HC
        intro d hd
        rw [MvPowerSeries.coeff_truncTotal _ hd, MvPolynomial.coeff_sum,
          Finset.sum_eq_single_of_mem d.degree (Finset.mem_range.mpr hd)]
        · rfl
        · intro k _ hk
          exact (hh k).coeff_eq_zero (Ne.symm hk)
      rw [e1, map_sum]
      simp only [he]
      rw [Finset.sum_range_sub]
      have hc0 : c 0 = 0 := by simp [c]
      rw [hc0, sub_zero]
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · rw [Ideal.Quotient.eq]; simp
      · simp only [c, if_neg hn.ne']
    have : IsNoetherianRing (MvPowerSeries (Fin r) P) := MvPowerSeries.isNoetherianRing P
    exact isNoetherianRing_of_surjective (MvPowerSeries (Fin r) P) _ Ψ hsurj
  have s3 : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], (∀ (k : ℕ) (c : AdicCompletion (IsLocalRing.maximalIdeal P) P), ∃ p : P, c - algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) (IsLocalRing.maximalIdeal P ^ k)) ∧ (∀ (k : ℕ) (p : P), algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) (IsLocalRing.maximalIdeal P ^ k) → p ∈ IsLocalRing.maximalIdeal P ^ k) := by
    intro P _ _ _
    have hfg : (IsLocalRing.maximalIdeal P).FG := IsNoetherian.noetherian _
    have hmem : ∀ (k : ℕ) (b : AdicCompletion (IsLocalRing.maximalIdeal P) P),
        b ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
          (IsLocalRing.maximalIdeal P ^ k) ↔
        AdicCompletion.eval (IsLocalRing.maximalIdeal P) P k b = 0 := by
      intro k b
      have h1 := AdicCompletion.pow_smul_top_eq_ker_eval (M := P) (n := k) hfg
      have h2 := Ideal.smul_top_eq_map (S := AdicCompletion (IsLocalRing.maximalIdeal P) P)
        (IsLocalRing.maximalIdeal P ^ k)
      have h3 := SetLike.ext_iff.mp (h2.symm.trans h1) b
      rw [Submodule.restrictScalars_mem, LinearMap.mem_ker] at h3
      exact h3
    have hof : ∀ (k : ℕ) (p : P), AdicCompletion.eval (IsLocalRing.maximalIdeal P) P k
        (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p) =
        Submodule.Quotient.mk p := by
      intro k p
      change AdicCompletion.eval (IsLocalRing.maximalIdeal P) P k
        (AdicCompletion.of (IsLocalRing.maximalIdeal P) P p) = _
      rw [AdicCompletion.eval_of]
      rfl
    refine ⟨fun k c => ?_, fun k p h => ?_⟩
    · obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _
        (AdicCompletion.eval (IsLocalRing.maximalIdeal P) P k c)
      refine ⟨p, (hmem k _).mpr ?_⟩
      rw [map_sub, hof, hp, sub_self]
    · rw [hmem, hof, Submodule.Quotient.mk_eq_zero] at h
      have hle : IsLocalRing.maximalIdeal P ^ k • (⊤ : Submodule P P) ≤
          IsLocalRing.maximalIdeal P ^ k := by
        rw [Ideal.smul_eq_mul, Ideal.mul_top]
      exact hle h
  intro P _ _ _
  have h1 := s1 P
  have h2 := s2 P
  have h3 := s3 P
  obtain ⟨hloc, -, hlh, -⟩ := h1
  obtain ⟨hlev, -⟩ := h3
  haveI := hloc
  haveI := hlh
  haveI : Module.Flat P (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
    AdicCompletion.flat_of_isNoetherian _
  have hff : Module.FaithfullyFlat P (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hge : (IsLocalRing.maximalIdeal P).map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) ≤
      IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
    IsLocalRing.map_maximalIdeal_le _
  have hmax : IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P) =
      (IsLocalRing.maximalIdeal P).map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) := by
    refine le_antisymm (fun z hz => ?_) hge
    obtain ⟨p, hp⟩ := hlev 1 z
    rw [pow_one] at hp
    have hpz : algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p ∈
        IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P) := by
      have := Ideal.sub_mem _ hz (hge hp)
      rwa [sub_sub_cancel] at this
    have hpm : p ∈ IsLocalRing.maximalIdeal P := by
      rw [IsLocalRing.mem_maximalIdeal] at hpz ⊢
      exact (map_mem_nonunits_iff _ p).mp hpz
    have := Ideal.add_mem _ hp (Ideal.mem_map_of_mem
      (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) hpm)
    rwa [sub_add_cancel] at this
  refine ⟨hloc, hlh, h2, hff, hmax, fun k z => ?_⟩
  obtain ⟨p, hp⟩ := hlev k z
  refine ⟨p, ?_⟩
  rw [← Ideal.map_pow]
  exact hp

theorem wcpa_dj_nccw_ebnj_stalk_eft : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), LocallyOfFiniteType u → ∀ z : Z, letI := ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).toAlgebra; Algebra.EssFiniteType R (Z.presheaf.stalk z) ∧ IsNoetherianRing (Z.presheaf.stalk z) :=
by
  intro R _ _ _ Z u hu z
  haveI : LocallyOfFiniteType u := hu
  have s1 : (Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤) =
      (u.stalkMap z).hom.comp
        (((Spec (CommRingCat.of R)).presheaf.germ ⊤ (u z) trivial).hom.comp
          (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom) := by
    ext r
    unfold wcCnSigma
    simp only [RingHom.comp_apply]
    rw [TopCat.Presheaf.germ_res_apply Z.presheaf (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)) z
      (show z ∈ (⊤ : Z.Opens) from trivial)]
    have h : u.appTop ≫ Z.presheaf.germ ⊤ z trivial =
        (Spec (CommRingCat.of R)).presheaf.germ ⊤ (u z) trivial ≫ u.stalkMap z :=
      (Scheme.Hom.germ_stalkMap u ⊤ z trivial).symm
    exact congrArg (fun f => f.hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)) h
  have s2 : (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom.EssFiniteType :=
    RingHom.FiniteType.essFiniteType (RingHom.FiniteType.of_surjective _
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of R)).inv).2)
  have s3 : ((Spec (CommRingCat.of R)).presheaf.germ ⊤ (u z) trivial).hom.EssFiniteType :=
    @Algebra.EssFiniteType.of_isLocalization _ _ _ _
      (TopCat.Presheaf.algebra_section_stalk (Spec (CommRingCat.of R)).presheaf (U := ⊤)
        ⟨u z, trivial⟩) _
      (IsAffineOpen.isLocalization_stalk (isAffineOpen_top (Spec (CommRingCat.of R)))
        ⟨u z, trivial⟩)
  have s4 : (u.stalkMap z).hom.EssFiniteType := LocallyOfFiniteType.stalkMap u z
  have s5 : ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).EssFiniteType := by
    rw [s1]
    exact RingHom.EssFiniteType.comp (RingHom.EssFiniteType.comp s2 s3) s4
  letI := ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).toAlgebra
  haveI hE : Algebra.EssFiniteType R (Z.presheaf.stalk z) := s5
  haveI : IsNoetherianRing R := PrincipalIdealRing.isNoetherianRing
  exact ⟨hE, Algebra.EssFiniteType.isNoetherianRing R (Z.presheaf.stalk z)⟩

theorem wcpa_dj_nccw_ebnj_completed_derivation : ∀ (R O : Type u) [CommRing R] [CommRing O] [Algebra R O] (I : Ideal O), ∃ Dh : AdicCompletion I O → AdicCompletion I (Ω[O⁄R]), (∀ a b, Dh (a + b) = Dh a + Dh b) ∧ (∀ a b, Dh (a * b) = a • Dh b + b • Dh a) ∧ ∀ o : O, Dh (algebraMap O (AdicCompletion I O) o) = AdicCompletion.of I (Ω[O⁄R]) (KaehlerDifferential.D R O o) :=
by
  intro R O _ _ _ I
  classical

  have s1 : ∀ (k : ℕ) (x : O), x ∈ I ^ (k + 1) →
      KaehlerDifferential.D R O x ∈ I ^ k • (⊤ : Submodule O (Ω[O⁄R])) := by
    intro k
    induction k with
    | zero => intro x _; simp
    | succ k ih =>
      intro x hx
      rw [pow_succ'] at hx
      refine Submodule.mul_induction_on
        (C := fun y => KaehlerDifferential.D R O y ∈ I ^ (k + 1) • (⊤ : Submodule O (Ω[O⁄R])))
        hx ?_ ?_
      · intro i hi j hj
        rw [Derivation.leibniz]
        refine Submodule.add_mem _ ?_ ?_
        · rw [pow_succ', Submodule.mul_smul]
          exact Submodule.smul_mem_smul hi (ih j hj)
        · exact Submodule.smul_mem_smul hj Submodule.mem_top
      · intro y z hy hz
        rw [map_add]
        exact add_mem hy hz

  have K : ∀ (n : ℕ) (x x' : O),
      (Submodule.Quotient.mk x : O ⧸ (I ^ (n + 1) • (⊤ : Submodule O O))) =
        Submodule.Quotient.mk x' →
      (Submodule.Quotient.mk (KaehlerDifferential.D R O x) :
          Ω[O⁄R] ⧸ (I ^ n • (⊤ : Submodule O (Ω[O⁄R])))) =
        Submodule.Quotient.mk (KaehlerDifferential.D R O x') := by
    intro n x x' h
    rw [Submodule.Quotient.eq] at h ⊢
    rw [← map_sub]
    apply s1
    simpa [Ideal.smul_eq_mul, Ideal.mul_top] using h

  have lower : ∀ (a : AdicCompletion I O) (n : ℕ) (x : O),
      AdicCompletion.eval I O (n + 1) a = Submodule.Quotient.mk x →
      AdicCompletion.eval I O n a = Submodule.Quotient.mk x := by
    intro a n x h
    rw [AdicCompletion.eval_apply] at h ⊢
    rw [← AdicCompletion.transitionMap_comp_eval_apply I O (Nat.le_succ n) a, h]
    rfl

  choose L hL using fun (a : AdicCompletion I O) (n : ℕ) =>
    Submodule.Quotient.mk_surjective (I ^ n • (⊤ : Submodule O O)) (AdicCompletion.eval I O n a)
  have cauchy : ∀ (a : AdicCompletion I O) (n : ℕ),
      KaehlerDifferential.D R O (L a (n + 1)) ≡ KaehlerDifferential.D R O (L a (n + 1 + 1))
        [SMOD (I ^ n • (⊤ : Submodule O (Ω[O⁄R])))] := by
    intro a n
    exact K n _ _ ((hL a (n + 1)).trans (lower a (n + 1) _ (hL a (n + 1 + 1)).symm))
  obtain ⟨Dh, spec⟩ : ∃ Dh : AdicCompletion I O → AdicCompletion I (Ω[O⁄R]),
      ∀ (a : AdicCompletion I O) (n : ℕ) (x : O),
        AdicCompletion.eval I O (n + 1) a = Submodule.Quotient.mk x →
        AdicCompletion.eval I (Ω[O⁄R]) n (Dh a) =
          Submodule.Quotient.mk (KaehlerDifferential.D R O x) := by
    refine ⟨fun a => AdicCompletion.mk I (Ω[O⁄R])
      (AdicCompletion.AdicCauchySequence.mk I (Ω[O⁄R])
        (fun n => KaehlerDifferential.D R O (L a (n + 1))) (cauchy a)), ?_⟩
    intro a n x h
    rw [AdicCompletion.eval_apply, AdicCompletion.mk_apply_coe]
    exact K n _ _ ((hL a (n + 1)).trans h)

  have ladd : ∀ (a b : AdicCompletion I O) (n : ℕ) (x y : O),
      AdicCompletion.eval I O n a = Submodule.Quotient.mk x →
      AdicCompletion.eval I O n b = Submodule.Quotient.mk y →
      AdicCompletion.eval I O n (a + b) = Submodule.Quotient.mk (x + y) := by
    intro a b n x y ha hb
    rw [map_add, ha, hb]
    rfl
  have lmul : ∀ (a b : AdicCompletion I O) (n : ℕ) (x y : O),
      AdicCompletion.eval I O n a = Submodule.Quotient.mk x →
      AdicCompletion.eval I O n b = Submodule.Quotient.mk y →
      AdicCompletion.eval I O n (a * b) = Submodule.Quotient.mk (x * y) := by
    intro a b n x y ha hb
    rw [AdicCompletion.eval_apply] at ha hb ⊢
    rw [AdicCompletion.val_mul, ha, hb]
    rfl
  have lsmul : ∀ (a : AdicCompletion I O) (w : AdicCompletion I (Ω[O⁄R])) (n : ℕ) (x : O)
      (m : Ω[O⁄R]),
      AdicCompletion.eval I O n a = Submodule.Quotient.mk x →
      AdicCompletion.eval I (Ω[O⁄R]) n w = Submodule.Quotient.mk m →
      AdicCompletion.eval I (Ω[O⁄R]) n (a • w) = Submodule.Quotient.mk (x • m) := by
    intro a w n x m ha hw
    rw [AdicCompletion.eval_apply] at ha hw ⊢
    rw [AdicCompletion.smul_eval, ha, hw]
    exact (AdicCompletion.mk_smul_mk (I ^ n) x m).trans (Submodule.Quotient.mk_smul _ _ _).symm

  have lconst : ∀ (n : ℕ) (o : O),
      AdicCompletion.eval I O n (algebraMap O (AdicCompletion I O) o) = Submodule.Quotient.mk o := by
    intro n o
    rw [AdicCompletion.eval_apply, AdicCompletion.algebraMap_apply, AdicCompletion.of_apply]
    rfl

  refine ⟨Dh, ?_, ?_, ?_⟩
  · intro a b
    apply AdicCompletion.ext
    intro n
    show AdicCompletion.eval I _ n (Dh (a + b)) = AdicCompletion.eval I _ n (Dh a + Dh b)
    obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective _ (AdicCompletion.eval I O (n + 1) a)
    obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective _ (AdicCompletion.eval I O (n + 1) b)
    rw [spec _ n (x + y) (ladd a b (n + 1) x y hx.symm hy.symm),
      map_add (AdicCompletion.eval I (Ω[O⁄R]) n), spec a n x hx.symm,
      spec b n y hy.symm, map_add (KaehlerDifferential.D R O)]
    rfl
  · intro a b
    apply AdicCompletion.ext
    intro n
    show AdicCompletion.eval I _ n (Dh (a * b)) = AdicCompletion.eval I _ n (a • Dh b + b • Dh a)
    obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective _ (AdicCompletion.eval I O (n + 1) a)
    obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective _ (AdicCompletion.eval I O (n + 1) b)
    rw [spec _ n (x * y) (lmul a b (n + 1) x y hx.symm hy.symm), Derivation.leibniz, map_add,
      lsmul a (Dh b) n x _ (lower a n x hx.symm) (spec b n y hy.symm),
      lsmul b (Dh a) n y _ (lower b n y hy.symm) (spec a n x hx.symm)]
    rfl
  · intro o
    apply AdicCompletion.ext
    intro n
    show AdicCompletion.eval I _ n (Dh (algebraMap O (AdicCompletion I O) o)) =
      AdicCompletion.eval I _ n (AdicCompletion.of I (Ω[O⁄R]) (KaehlerDifferential.D R O o))
    rw [spec _ n o (lconst (n + 1) o), AdicCompletion.eval_apply, AdicCompletion.of_apply]
    rfl

theorem wcpa_dj_nccw_ebnj_node_span : ∀ (R O N : Type u) [CommRing R] [CommRing O] [AddCommGroup N] [Module O N] (I : Ideal O) (Dh : AdicCompletion I O → AdicCompletion I N) (eZ : AdicCompletion I O ≃+* (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})), (∀ a b, Dh (a + b) = Dh a + Dh b) → (∀ a b, Dh (a * b) = a • Dh b + b • Dh a) → (∀ r : R, Dh (eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.C r))) = 0) → AdicCompletion.evalₐ I 1 (eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 0))) = 0 → AdicCompletion.evalₐ I 1 (eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 1))) = 0 → ∀ a : AdicCompletion I O, ∃ b c : AdicCompletion I O, Dh a = b • Dh (eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 0))) + c • Dh (eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 1))) :=
by
  intro R O N _ _ _ _ I Dh eZ hadd hmul hC h0 h1
  classical
  obtain ⟨θ, hθ⟩ : ∃ θ : MvPowerSeries (Fin 2) R →+* AdicCompletion I O, ∀ φ,
      θ φ = eZ.symm (Ideal.Quotient.mk
        (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) φ) :=
    ⟨eZ.symm.toRingHom.comp (Ideal.Quotient.mk _), fun _ => rfl⟩
  simp only [← hθ] at hC h0 h1 ⊢
  set x := θ (MvPowerSeries.X 0) with hx
  set y := θ (MvPowerSeries.X 1) with hy

  have s1 : ∀ φ : MvPowerSeries (Fin 2) R, ∃ (c : R) (α β : MvPowerSeries (Fin 2) R),
      φ = MvPowerSeries.C c + MvPowerSeries.X 0 * α + MvPowerSeries.X 1 * β := by
    intro φ
    let β : MvPowerSeries (Fin 2) R :=
      fun m => if m 0 = 0 then φ (m + Finsupp.single 1 1) else 0
    have hdvd : MvPowerSeries.X 0 ∣
        φ - MvPowerSeries.C (MvPowerSeries.constantCoeff φ) - MvPowerSeries.X 1 * β := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      rw [map_sub, map_sub, MvPowerSeries.coeff_C, MvPowerSeries.X_def,
        MvPowerSeries.coeff_monomial_mul, one_mul]
      by_cases hm0 : m = 0
      · subst hm0
        have hnle : ¬ (Finsupp.single (1 : Fin 2) 1 ≤ 0) := by
          rw [Finsupp.single_le_iff]; simp
        rw [if_pos rfl, if_neg hnle, MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
        simp
      · have hle : Finsupp.single (1 : Fin 2) 1 ≤ m := by
          rw [Finsupp.single_le_iff]
          by_contra hlt
          have hm1 : m 1 = 0 := by omega
          apply hm0
          ext i
          fin_cases i
          · simpa using hm
          · simpa using hm1
        rw [if_neg hm0, if_pos hle, MvPowerSeries.coeff_apply, MvPowerSeries.coeff_apply]
        simp only [β, tsub_add_cancel_of_le hle]
        simp [hm]
    obtain ⟨α, hα⟩ := hdvd
    exact ⟨MvPowerSeries.constantCoeff φ, α, β, by linear_combination hα⟩

  let E : MvPowerSeries (Fin 2) R → AdicCompletion I N := fun φ =>
    Dh (θ φ) - θ (MvPowerSeries.pderiv (0 : Fin 2) φ) • Dh x -
      θ (MvPowerSeries.pderiv (1 : Fin 2) φ) • Dh y

  have s2 : ∀ φ : MvPowerSeries (Fin 2) R, ∃ α β : MvPowerSeries (Fin 2) R,
      E φ = x • E α + y • E β := by
    intro φ
    obtain ⟨c, α, β, rfl⟩ := s1 φ
    refine ⟨α, β, ?_⟩
    have hne : (1 : Fin 2) ≠ 0 := by decide
    have hp0 : MvPowerSeries.pderiv (0 : Fin 2)
        (MvPowerSeries.C c + MvPowerSeries.X 0 * α + MvPowerSeries.X 1 * β) =
        MvPowerSeries.X 0 * MvPowerSeries.pderiv (0 : Fin 2) α + α +
          MvPowerSeries.X 1 * MvPowerSeries.pderiv (0 : Fin 2) β := by
      rw [map_add, map_add, Derivation.leibniz, Derivation.leibniz, MvPowerSeries.pderiv_C,
        MvPowerSeries.pderiv_X_self, MvPowerSeries.pderiv_X_of_ne hne]
      simp only [smul_eq_mul]
      ring
    have hp1 : MvPowerSeries.pderiv (1 : Fin 2)
        (MvPowerSeries.C c + MvPowerSeries.X 0 * α + MvPowerSeries.X 1 * β) =
        MvPowerSeries.X 0 * MvPowerSeries.pderiv (1 : Fin 2) α +
          MvPowerSeries.X 1 * MvPowerSeries.pderiv (1 : Fin 2) β + β := by
      rw [map_add, map_add, Derivation.leibniz, Derivation.leibniz, MvPowerSeries.pderiv_C,
        MvPowerSeries.pderiv_X_self, MvPowerSeries.pderiv_X_of_ne hne.symm]
      simp only [smul_eq_mul]
      ring
    simp only [E]
    rw [hp0, hp1]
    simp only [map_add, map_mul, hadd, hmul, hC, ← hx, ← hy]
    module

  have aux : ∀ (z : AdicCompletion I O) (e : AdicCompletion I N) (n : ℕ),
      AdicCompletion.evalₐ I 1 z = 0 → e.1 n = 0 →
      (z • e).1 (n + 1) = 0 := by
    intro z e n hz he
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I O z
    obtain ⟨t, rfl⟩ := AdicCompletion.mk_surjective I N e
    rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq_zero_iff_mem, pow_one] at hz
    rw [AdicCompletion.mk_apply_coe, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at he
    have hs : s.1 (n + 1) ∈ I := by
      have h1 := (Submodule.Quotient.eq _).mp
        (AdicCompletion.AdicCauchySequence.mk_eq_mk (show 1 ≤ n + 1 by omega) s)
      rw [pow_one, Ideal.smul_eq_mul, Ideal.mul_top] at h1
      have := I.add_mem h1 hz
      simpa using this
    have ht : t.1 (n + 1) ∈ (I ^ n • ⊤ : Submodule O N) := by
      have h1 := (Submodule.Quotient.eq _).mp
        (AdicCompletion.AdicCauchySequence.mk_eq_mk (show n ≤ n + 1 by omega) t)
      have := Submodule.add_mem _ h1 he
      simpa using this
    rw [AdicCompletion.smul_eval, AdicCompletion.mk_apply_coe, AdicCompletion.mk_apply_coe,
      Submodule.mkQ_apply, Submodule.mkQ_apply]
    have key := AdicCompletion.mk_smul_mk (I ^ (n + 1)) (s.1 (n + 1)) (t.1 (n + 1))
    erw [key]
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, pow_succ', Submodule.mul_smul]
    exact Submodule.smul_mem_smul hs ht
  have hlev : ∀ n : ℕ, ∀ φ, (E φ).1 n = 0 := by
    intro n
    induction n with
    | zero =>
      intro φ
      obtain ⟨w, hw⟩ := Submodule.Quotient.mk_surjective _ ((E φ).1 0)
      rw [← hw, Submodule.Quotient.mk_eq_zero]
      simp
    | succ n ih =>
      intro φ
      obtain ⟨α, β, h⟩ := s2 φ
      rw [h, AdicCompletion.val_add_apply, aux x _ n h0 (ih α), aux y _ n h1 (ih β), add_zero]
  have hE : ∀ φ, E φ = 0 := by
    intro φ
    apply AdicCompletion.ext
    intro n
    rw [hlev n φ, AdicCompletion.val_zero_apply]

  intro a
  obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective (eZ a)
  have ha : a = θ q := by rw [hθ, hq, RingEquiv.symm_apply_apply]
  refine ⟨θ (MvPowerSeries.pderiv (0 : Fin 2) q), θ (MvPowerSeries.pderiv (1 : Fin 2) q), ?_⟩
  have := hE q
  simp only [E] at this
  rw [sub_sub, sub_eq_zero] at this
  rw [ha]
  exact this

theorem wcpa_dj_nccw_ebnj_rank_bound : ∀ (R O : Type u) [CommRing R] [CommRing O] [IsLocalRing O] [IsNoetherianRing O] [Algebra R O] [Algebra.EssFiniteType R O] (p : Ideal O) [p.IsPrime] (Q : Ideal (AdicCompletion (IsLocalRing.maximalIdeal O) O)) [Q.IsPrime], Q.comap (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) = p → ∀ (X Y : AdicCompletion (IsLocalRing.maximalIdeal O) O), X ∉ Q → X * Y = 0 → ∀ (Dh : AdicCompletion (IsLocalRing.maximalIdeal O) O → AdicCompletion (IsLocalRing.maximalIdeal O) (Ω[O⁄R])), (∀ a b, Dh (a + b) = Dh a + Dh b) → (∀ a b, Dh (a * b) = a • Dh b + b • Dh a) → (∀ o : O, Dh (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) o) = AdicCompletion.of (IsLocalRing.maximalIdeal O) (Ω[O⁄R]) (KaehlerDifferential.D R O o)) → (∀ a, ∃ b c : AdicCompletion (IsLocalRing.maximalIdeal O) O, Dh a = b • Dh X + c • Dh Y) → FiniteDimensional p.ResidueField (TensorProduct O p.ResidueField (Ω[O⁄R])) ∧ Module.finrank p.ResidueField (TensorProduct O p.ResidueField (Ω[O⁄R])) ≤ 1 :=
by
  intro R O _ _ _ _ _ _ p _ Q _ hQ X Y hXQ hXY Dh hadd hmul hof hspan
  classical

  letI : Algebra p.ResidueField Q.ResidueField :=
    (Ideal.ResidueField.map p Q (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))
      hQ.symm).toAlgebra
  haveI : IsScalarTower O p.ResidueField Q.ResidueField := IsScalarTower.of_algebraMap_eq
    (fun x => by
      rw [RingHom.algebraMap_toAlgebra, Ideal.ResidueField.map_algebraMap,
        IsScalarTower.algebraMap_apply O (AdicCompletion (IsLocalRing.maximalIdeal O) O)
          Q.ResidueField x])
  haveI : Module.Finite O (Ω[O⁄R]) := inferInstance
  have hfinK : Module.Finite p.ResidueField (TensorProduct O p.ResidueField (Ω[O⁄R])) :=
    Module.Finite.base_change O p.ResidueField _
  have hrank : Module.finrank p.ResidueField (TensorProduct O p.ResidueField (Ω[O⁄R])) =
      Module.finrank Q.ResidueField (TensorProduct O Q.ResidueField (Ω[O⁄R])) := by
    rw [← Module.finrank_baseChange (R := Q.ResidueField) (S := p.ResidueField)
      (M' := TensorProduct O p.ResidueField (Ω[O⁄R]))]
    exact LinearEquiv.finrank_eq (TensorProduct.AlgebraTensorModule.cancelBaseChange O
      p.ResidueField Q.ResidueField Q.ResidueField (Ω[O⁄R]))
  refine ⟨hfinK, ?_⟩
  rw [hrank]

  let e := AdicCompletion.ofTensorProductEquivOfFiniteNoetherian (IsLocalRing.maximalIdeal O)
    (Ω[O⁄R])
  let c := TensorProduct.AlgebraTensorModule.cancelBaseChange O
    (AdicCompletion (IsLocalRing.maximalIdeal O) O) Q.ResidueField Q.ResidueField (Ω[O⁄R])
  let Ψ : AdicCompletion (IsLocalRing.maximalIdeal O) (Ω[O⁄R]) →
      TensorProduct O Q.ResidueField (Ω[O⁄R]) :=
    fun w => c ((1 : Q.ResidueField) ⊗ₜ[AdicCompletion (IsLocalRing.maximalIdeal O) O] e.symm w)
  have hΨadd : ∀ w w', Ψ (w + w') = Ψ w + Ψ w' := by
    intro w w'
    simp only [Ψ, map_add, TensorProduct.tmul_add]
  have hΨ0 : Ψ 0 = 0 := by
    simp only [Ψ, map_zero, TensorProduct.tmul_zero]
  have hΨof : ∀ m : Ω[O⁄R], Ψ (AdicCompletion.of (IsLocalRing.maximalIdeal O) (Ω[O⁄R]) m) =
      (1 : Q.ResidueField) ⊗ₜ[O] m := by
    intro m
    have he : e.symm (AdicCompletion.of (IsLocalRing.maximalIdeal O) (Ω[O⁄R]) m) =
        (1 : AdicCompletion (IsLocalRing.maximalIdeal O) O) ⊗ₜ[O] m := by
      rw [LinearEquiv.symm_apply_eq]
      simp only [e, AdicCompletion.ofTensorProductEquivOfFiniteNoetherian_apply,
        AdicCompletion.ofTensorProduct_tmul, one_smul]
    simp only [Ψ, he, c, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, one_smul]
  have hΨsmul : ∀ (s : AdicCompletion (IsLocalRing.maximalIdeal O) O)
      (w : AdicCompletion (IsLocalRing.maximalIdeal O) (Ω[O⁄R])),
      Ψ (s • w) = algebraMap (AdicCompletion (IsLocalRing.maximalIdeal O) O) Q.ResidueField s •
        Ψ w := by
    intro s w
    simp only [Ψ]
    rw [map_smul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, ← map_smul]
    congr 1
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]

  have hD0 : Dh 0 = 0 := by simpa using hadd 0 0
  have hXbar : algebraMap (AdicCompletion (IsLocalRing.maximalIdeal O) O) Q.ResidueField X ≠ 0 := by
    rw [Ne, Ideal.algebraMap_residueField_eq_zero]
    exact hXQ
  have hYbar : algebraMap (AdicCompletion (IsLocalRing.maximalIdeal O) O) Q.ResidueField Y = 0 := by
    have h1 : algebraMap (AdicCompletion (IsLocalRing.maximalIdeal O) O) Q.ResidueField X *
        algebraMap (AdicCompletion (IsLocalRing.maximalIdeal O) O) Q.ResidueField Y = 0 := by
      rw [← map_mul, hXY, map_zero]
    exact (mul_eq_zero.mp h1).resolve_left hXbar
  have hΨY : Ψ (Dh Y) = 0 := by
    have h1 := hmul X Y
    rw [hXY, hD0] at h1
    have h2 := congrArg Ψ h1
    rw [hΨ0, hΨadd, hΨsmul, hΨsmul, hYbar, zero_smul, add_zero] at h2
    exact (smul_eq_zero.mp h2.symm).resolve_left hXbar

  set v := Ψ (Dh X) with hv
  have hgen : ∀ o : O, (1 : Q.ResidueField) ⊗ₜ[O] (KaehlerDifferential.D R O o) ∈
      Submodule.span Q.ResidueField {v} := by
    intro o
    obtain ⟨b, c', h⟩ := hspan (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) o)
    rw [← hΨof, ← hof, h, hΨadd, hΨsmul, hΨsmul, hΨY, smul_zero, add_zero]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self v)
  have hA : ∀ m : Ω[O⁄R], (1 : Q.ResidueField) ⊗ₜ[O] m ∈ Submodule.span Q.ResidueField {v} := by
    intro m
    have hm : m ∈ Submodule.span O (Set.range (KaehlerDifferential.D R O)) := by
      rw [KaehlerDifferential.span_range_derivation]; trivial
    induction hm using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨o, rfl⟩ := hx
      exact hgen o
    | zero => rw [TensorProduct.tmul_zero]; exact Submodule.zero_mem _
    | add x y _ _ hx hy => rw [TensorProduct.tmul_add]; exact Submodule.add_mem _ hx hy
    | smul a x _ hx =>
      rw [TensorProduct.tmul_smul]
      exact Submodule.smul_of_tower_mem _ a hx
  apply finrank_le_one v
  intro w
  have hw : w ∈ Submodule.span Q.ResidueField {v} := by
    induction w using TensorProduct.induction_on with
    | zero => exact Submodule.zero_mem _
    | tmul x m =>
      have : x ⊗ₜ[O] m = x • ((1 : Q.ResidueField) ⊗ₜ[O] m) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [this]
      exact Submodule.smul_mem _ _ (hA m)
    | add x y hx hy => exact Submodule.add_mem _ hx hy
  exact Submodule.mem_span_singleton.mp hw

theorem wcpa_dj_nccw_ebn_jacobian_node : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), wcpaDjSemistable u → ∀ z : Z, u z = IsLocalRing.closedPoint R → IsClosed ({z} : Set Z) → ∀ eZ : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z) ≃+* (MvPowerSeries (Fin 2) R ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), eZ.toRingHom.comp ((algebraMap (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))).comp ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤))) = (Ideal.Quotient.mk _).comp MvPowerSeries.C → ∀ p : PrimeSpectrum (Z.presheaf.stalk z), (∃ r ∈ IsLocalRing.maximalIdeal R, (Z.presheaf.germ ⊤ z trivial).hom (wcCnSigma u ⊤ r) ∉ p.asIdeal) → ¬ nccwSm u (Z.fromSpecStalk z p) → ∀ Q : PrimeSpectrum (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)), PrimeSpectrum.comap (algebraMap (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))) Q = p → eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) ∈ Q.asIdeal ∧ eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) ∈ Q.asIdeal :=
by
  intro R _ _ _ Z u hss z _hzu _hzc eZ heZ p _hpr hns Q hQ
  classical
  have hprop : IsProper u := hss.2.1
  have hlft : LocallyOfFiniteType u := inferInstance
  letI : Algebra R (Z.presheaf.stalk z) :=
    ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).toAlgebra
  obtain ⟨hEFT, hNoeth⟩ := wcpa_dj_nccw_ebnj_stalk_eft R Z u hlft z
  haveI := hEFT
  haveI := hNoeth
  obtain ⟨hloc, -, -, -, hmax, -⟩ := wcpa_dj_glt_st_completion_facts (Z.presheaf.stalk z)
  haveI := hloc
  obtain ⟨Dh, hadd, hmul, hof⟩ := wcpa_dj_nccw_ebnj_completed_derivation R (Z.presheaf.stalk z)
    (IsLocalRing.maximalIdeal (Z.presheaf.stalk z))

  have hconst : ∀ r : R, Dh (eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.C r))) = 0 := by
    intro r
    have hc : eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.C r)) =
        algebraMap (Z.presheaf.stalk z)
          (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))
          (algebraMap R (Z.presheaf.stalk z) r) := by
      have h1 := RingHom.congr_fun heZ r
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe] at h1
      rw [← h1, RingEquiv.symm_apply_apply]
      rfl
    rw [hc, hof, Derivation.map_algebraMap, map_zero]

  have hev : ∀ i : Fin 2, AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) 1
      (eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X i))) = 0 := by
    intro i
    have hnu : ¬ IsUnit (eZ.symm (Ideal.Quotient.mk
        (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) R))
        (MvPowerSeries.X i))) := by
      intro hu
      have hu' := hu.map eZ
      rw [RingEquiv.apply_symm_apply] at hu'
      obtain ⟨t, ht⟩ := hu'.exists_right_inv
      obtain ⟨t', rfl⟩ := Ideal.Quotient.mk_surjective t
      rw [← map_mul, ← map_one (Ideal.Quotient.mk _), Ideal.Quotient.eq] at ht
      obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp ht
      have h2 := congrArg MvPowerSeries.constantCoeff hs
      simp only [map_mul, map_sub, map_one, MvPowerSeries.constantCoeff_X, zero_mul, mul_zero,
        zero_sub] at h2
      exact one_ne_zero (neg_eq_zero.mp h2.symm)
    have hmem : eZ.symm (Ideal.Quotient.mk
        (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) R))
        (MvPowerSeries.X i)) ∈ IsLocalRing.maximalIdeal
          (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) :=
      hnu
    rw [hmax] at hmem
    have hle : (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)).map (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))) ≤
        RingHom.ker (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) 1) := by
      rw [Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, RingHom.mem_ker, AdicCompletion.algebraMap_apply,
        Algebra.algebraMap_self, RingHom.id_apply, AdicCompletion.evalₐ_of,
        Ideal.Quotient.eq_zero_iff_mem, pow_one]
      exact hm
    exact hle hmem
  have hspan := wcpa_dj_nccw_ebnj_node_span R (Z.presheaf.stalk z) (Ω[Z.presheaf.stalk z⁄R])
    (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) Dh eZ hadd hmul hconst (hev 0) (hev 1)
  have hXY : eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 0)) *
      eZ.symm (Ideal.Quotient.mk _ (MvPowerSeries.X 1)) = 0 := by
    rw [← map_mul eZ.symm, ← map_mul (Ideal.Quotient.mk _),
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]
  have hQp : Q.asIdeal.comap (algebraMap (Z.presheaf.stalk z)
      (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))) =
      p.asIdeal := by
    have := congrArg PrimeSpectrum.asIdeal hQ
    rwa [PrimeSpectrum.comap_asIdeal] at this
  by_contra hcon
  rw [not_and_or] at hcon
  apply hns
  apply wcpa_dj_nccw_ebn_smooth_of_omega R Z u hss z p
  rcases hcon with hX | hY
  · exact wcpa_dj_nccw_ebnj_rank_bound R (Z.presheaf.stalk z) p.asIdeal Q.asIdeal hQp _ _ hX
      hXY Dh hadd hmul hof hspan
  · refine wcpa_dj_nccw_ebnj_rank_bound R (Z.presheaf.stalk z) p.asIdeal Q.asIdeal hQp _ _ hY
      (by rw [mul_comm]; exact hXY) Dh hadd hmul hof (fun a => ?_)
    obtain ⟨b, c, h⟩ := hspan a
    exact ⟨c, b, by rw [h, add_comm]⟩

theorem wcpa_dj_nccw_eb_count_nonnormal_node : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (Z Z' Y G S S' N : Scheme.{u}) (u : Z ⟶ Spec (.of R)) (u' : Z' ⟶ Spec (.of R)) (n : ℕ) (τ : Fin n → (Spec (.of R) ⟶ Z)) (τ' : Fin n → (Spec (.of R) ⟶ Z')) (π : Y ⟶ Spec (.of (FractionRing R))) (a : Y ⟶ Z) (a' : Y ⟶ Z') (h : a ≫ u = a' ≫ u') (ι : G ⟶ Limits.pullback u u') (j : Y ⟶ G) (γ γ' : G) (ν : S ⟶ Z) (ν' : S' ⟶ Z') (μ : N ⟶ G) (q : N ⟶ S) (q' : N ⟶ S') (st : Fin n → (Spec (.of R) ⟶ N)) (zk : S) (η₀ : N) (η : Z' → N) (ηZ : Z → N), nccwAll R u u' τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ → ¬ nccwSm u (ν zk) → ¬ (IsDomain (Z.presheaf.stalk (ν zk)) ∧ IsIntegrallyClosed (Z.presheaf.stalk (ν zk))) → (nccwEbBv R u ν zk).Finite ∧ (nccwEbBv R u ν zk).ncard ≤ 1 ∧ (nccwEbBh R u ν zk).Finite ∧ (nccwEbBh R u ν zk).ncard ≤ 1 :=
by
  intro R _ _ _ Z Z' Y G S S' N u u' n τ τ' π a a' h ι j γ γ' ν ν' μ q q' st zk η₀ η ηZ hA hsm hnn
  classical

  have L1 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (B : Type u)
      [CommRing B] [IsDomain B] [IsIntegrallyClosed B],
      (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* B) → IsDomain A ∧ IsIntegrallyClosed A := by
    intro A _ _ _ B _ _ _ g
    have hinj : Function.Injective
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) := by
      intro x y hxy
      apply AdicCompletion.of_injective (IsLocalRing.maximalIdeal A) A
      simpa [AdicCompletion.algebraMap_apply] using hxy
    haveI : IsDomain (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      Function.Injective.isDomain (g : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* B)
        g.injective
    haveI hAd : IsDomain A := Function.Injective.isDomain _ hinj
    haveI : IsIntegrallyClosed (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      IsIntegrallyClosed.of_equiv g.symm
    refine ⟨hAd, ?_⟩
    rw [isIntegrallyClosed_iff (FractionRing A)]
    intro x hx
