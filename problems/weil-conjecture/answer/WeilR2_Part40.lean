      have hk := congrArg (fun f => f.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r)) key
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hk
      show (Z.presheaf.germ ⊤ z trivial).hom
        ((Z.presheaf.map (homOfLE (le_top : (⊤ : Z.Opens) ≤ ⊤)).op).hom
          (u.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r))) = _
      rw [hres]
      exact hk
    letI := ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).toAlgebra
    have hE : Algebra.EssFiniteType R (Z.presheaf.stalk z) := by
      have h5 : ((Z.presheaf.germ ⊤ z trivial).hom.comp (wcCnSigma u ⊤)).EssFiniteType := heq ▸ h4
      exact h5
    haveI := hE
    exact ⟨hE, Algebra.EssFiniteType.isNoetherianRing R _⟩

  have s2loc : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P],
      ∃ (_ : IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P)),
        IsLocalHom (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) := by
    intro P _ _ _
    have hfg : (IsLocalRing.maximalIdeal P).FG := IsNoetherian.noetherian _
    have hcompl := AdicCompletion.isAdicComplete_self (IsLocalRing.maximalIdeal P) hfg
    have hmem : ∀ b : AdicCompletion (IsLocalRing.maximalIdeal P) P,
        b ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
          (IsLocalRing.maximalIdeal P) ↔
        AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1 b = 0 := by
      intro b
      have h1 := AdicCompletion.pow_smul_top_eq_ker_eval (M := P) (n := 1) hfg
      have h2 := Ideal.smul_top_eq_map (S := AdicCompletion (IsLocalRing.maximalIdeal P) P)
        (IsLocalRing.maximalIdeal P ^ 1)
      have h3 := SetLike.ext_iff.mp (h2.symm.trans h1) b
      rw [Submodule.restrictScalars_mem, LinearMap.mem_ker] at h3
      have e : Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
          (IsLocalRing.maximalIdeal P ^ 1) =
          Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
          (IsLocalRing.maximalIdeal P) := by rw [pow_one]
      rw [e] at h3
      exact h3
    have hlift : ∀ b : AdicCompletion (IsLocalRing.maximalIdeal P) P, ∃ a : P,
        b - algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) a ∈
          Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
            (IsLocalRing.maximalIdeal P) := by
      intro b
      obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective _
        (AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1 b)
      refine ⟨a, (hmem _).mpr ?_⟩
      rw [map_sub]
      have : AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1
          (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) a) =
          Submodule.Quotient.mk a := by
        change AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1
          (AdicCompletion.of (IsLocalRing.maximalIdeal P) P a) = _
        rw [AdicCompletion.eval_of]
        rfl
      rw [this, ha, sub_self]
    have hone : (1 : AdicCompletion (IsLocalRing.maximalIdeal P) P) ∉
        Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
          (IsLocalRing.maximalIdeal P) := by
      intro h
      rw [hmem, ← map_one (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))] at h
      change AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1
        (AdicCompletion.of (IsLocalRing.maximalIdeal P) P 1) = 0 at h
      rw [AdicCompletion.eval_of, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h
      have hle : IsLocalRing.maximalIdeal P ^ 1 • (⊤ : Submodule P P) ≤
          IsLocalRing.maximalIdeal P := by
        rw [pow_one, Ideal.smul_eq_mul, Ideal.mul_top]
      exact (IsLocalRing.maximalIdeal.isMaximal P).ne_top ((Ideal.eq_top_iff_one _).mpr (hle h))
    have hnu : ∀ x ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
        (IsLocalRing.maximalIdeal P), ¬ IsUnit x := fun x hx hu =>
      hone (by rw [Ideal.eq_top_of_isUnit_mem _ hx hu]; trivial)
    have : Nontrivial (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
      nontrivial_of_ne 1 0 (fun h => hone (h ▸ Ideal.zero_mem _))
    have := hcompl
    have hjac := IsAdicComplete.le_jacobson_bot
      (Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
        (IsLocalRing.maximalIdeal P))
    have hdich : ∀ b : AdicCompletion (IsLocalRing.maximalIdeal P) P,
        b ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
          (IsLocalRing.maximalIdeal P) ∨ IsUnit b := by
      intro b
      obtain ⟨a, ha⟩ := hlift b
      by_cases haM : a ∈ IsLocalRing.maximalIdeal P
      · left
        have := Ideal.add_mem _ ha (Ideal.mem_map_of_mem
          (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) haM)
        rwa [sub_add_cancel] at this
      · right
        have hu : IsUnit (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) a) :=
          (IsLocalRing.notMem_maximalIdeal.mp haM).map _
        obtain ⟨v, hv⟩ := hu.exists_right_inv
        have hx := Ideal.mem_jacobson_bot.mp (hjac ha) v
        have heq : (b - algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) a) * v + 1
            = b * v := by
          rw [sub_mul, hv]; ring
        rw [heq] at hx
        exact isUnit_of_mul_isUnit_left hx
    have hloc : IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) :=
      IsLocalRing.of_nonunits_add (fun x y hx hy =>
        hnu _ (Ideal.add_mem _ ((hdich x).resolve_right hx) ((hdich y).resolve_right hy)))
    refine ⟨hloc, ⟨fun a ha => ?_⟩⟩
    by_contra hna
    exact hnu _ (Ideal.mem_map_of_mem _ ((IsLocalRing.mem_maximalIdeal _).mpr hna)) ha
  have s2noeth : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P],
      IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) := by
    intro P _ _ _
    classical
    obtain ⟨r, x, hx⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
      (IsNoetherian.noetherian (IsLocalRing.maximalIdeal P))
    set I := IsLocalRing.maximalIdeal P with hI
    have hxI : ∀ i, x i ∈ I := fun i => hx ▸ Ideal.subset_span ⟨i, rfl⟩
    have H2 : ∀ (n : ℕ) (q : MvPolynomial (Fin r) P),
        (∀ d : Fin r →₀ ℕ, d.degree < n → q.coeff d = 0) → MvPolynomial.eval x q ∈ I ^ n := by
      intro n q hq
      rw [MvPolynomial.eval_eq']
      refine Ideal.sum_mem _ (fun d hd => ?_)
      have hdeg : n ≤ d.degree := by
        by_contra h
        exact (MvPolynomial.mem_support_iff.mp hd) (hq d (not_le.mp h))
      apply Ideal.mul_mem_left
      have h1 : ∏ i, x i ^ d i ∈ ∏ i, I ^ d i :=
        Ideal.prod_mem_prod (fun i _ => Ideal.pow_mem_pow (hxI i) _)
      rw [Finset.prod_pow_eq_pow_sum, ← Finsupp.degree_eq_sum] at h1
      exact Ideal.pow_le_pow_right hdeg h1
    have HC : ∀ (n : ℕ) (p q : MvPolynomial (Fin r) P),
        (∀ d : Fin r →₀ ℕ, d.degree < n → p.coeff d = q.coeff d) →
        Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x p) =
          Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x q) := by
      intro n p q h
      rw [Ideal.Quotient.eq, ← map_sub]
      exact H2 n (p - q) (fun d hd => by rw [MvPolynomial.coeff_sub, h d hd, sub_self])
    have H3' : ∀ (n : ℕ) (y : P), y ∈ Ideal.span (Set.range x) ^ n →
        ∃ h : MvPolynomial (Fin r) P, h.IsHomogeneous n ∧ MvPolynomial.eval x h = y := by
      intro n
      induction n with
      | zero =>
        intro y _
        exact ⟨MvPolynomial.C y, MvPolynomial.isHomogeneous_C _ _, MvPolynomial.eval_C _⟩
      | succ n ih =>
        intro y hy
        rw [pow_succ] at hy
        refine Submodule.mul_induction_on hy ?_ ?_
        · intro a ha b hb
          obtain ⟨ha', hah, hae⟩ := ih a ha
          obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hb
          refine ⟨ha' * ∑ i, MvPolynomial.C (c i) * MvPolynomial.X i, ?_, ?_⟩
          · apply hah.mul
            apply MvPolynomial.IsHomogeneous.sum
            intro i _
            have := (MvPolynomial.isHomogeneous_C (Fin r) (c i)).mul
              (MvPolynomial.isHomogeneous_X P i)
            rwa [zero_add] at this
          · simp only [map_mul, map_sum, MvPolynomial.eval_C, MvPolynomial.eval_X, hae, hc]
        · rintro _ _ ⟨h1, hh1, he1⟩ ⟨h2, hh2, he2⟩
          exact ⟨h1 + h2, hh1.add hh2, by rw [map_add, he1, he2]⟩
    have H3 : ∀ (n : ℕ) (y : P), y ∈ I ^ n →
        ∃ h : MvPolynomial (Fin r) P, h.IsHomogeneous n ∧ MvPolynomial.eval x h = y := by
      intro n y hy
      rw [← hx] at hy
      exact H3' n y hy
    let f : (n : ℕ) → MvPowerSeries (Fin r) P →+* P ⧸ I ^ n := fun n =>
      { toFun := fun F => Ideal.Quotient.mk (I ^ n) (MvPolynomial.eval x (MvPowerSeries.truncTotal n F))
        map_one' := by
          rw [← map_one (Ideal.Quotient.mk (I ^ n)), ← map_one (MvPolynomial.eval x)]
          apply HC
          intro d hd
          rw [MvPowerSeries.coeff_truncTotal _ hd, MvPowerSeries.coeff_one, MvPolynomial.coeff_one]
