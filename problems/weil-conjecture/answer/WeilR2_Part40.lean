  obtain ⟨W, hW, hsW, -⟩ := exists_isAffineOpen_mem_and_subset (show s ∈ (⊤ : S.Opens) from trivial)
  have hWtop : W ≤ uS ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  let φR : R →+* Γ(S, W) := (uS.appLE ⊤ W hWtop).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom
  letI : Algebra R Γ(S, W) := φR.toAlgebra
