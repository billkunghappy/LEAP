theorem nccwbf_basechange_normal : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R], wcpaDjNccExcellent.{u} → IsAdicComplete (IsLocalRing.maximalIdeal R) R → ∀ (S N : Scheme.{u}) (uS : S ⟶ Spec (.of R)) (q : N ⟶ S), LocallyOfFiniteType uS → LocallyOfFiniteType q → (∀ x : N, IsDomain (N.presheaf.stalk x) ∧ IsIntegrallyClosed (N.presheaf.stalk x)) → ∀ s : S, IsClosed ({s} : Set S) → ∀ (A : Type u) [CommRing A] (e : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s) ≃+* A) (x : ↥(Limits.pullback q (nccwffG s e))), IsDomain ((Limits.pullback q (nccwffG s e)).presheaf.stalk x) ∧ IsIntegrallyClosed ((Limits.pullback q (nccwffG s e)).presheaf.stalk x) :=
by
  have s5 (S : Scheme.{u}) (W : S.Opens) (hW : IsAffineOpen W) (s : S) (hs : s ∈ W)
      (hsc : IsClosed ({s} : Set S)) : (hW.primeIdealOf ⟨s, hs⟩).asIdeal.IsMaximal := by
    have h1 : ({hW.primeIdealOf ⟨s, hs⟩} : Set ↥(Spec Γ(S, W))) = hW.fromSpec ⁻¹' {s} := by
      ext y
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; exact hW.fromSpec_primeIdealOf ⟨s, hs⟩
      · intro hy
        apply hW.fromSpec.isOpenEmbedding.injective
        rw [hy, hW.fromSpec_primeIdealOf ⟨s, hs⟩]
    have h2 : IsClosed ({hW.primeIdealOf ⟨s, hs⟩} : Set ↥(Spec Γ(S, W))) := by
      rw [h1]; exact hsc.preimage hW.fromSpec.continuous
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp h2
  have s6 (N : Scheme.{u}) (V : N.Opens) (hV : IsAffineOpen V)
      (hN : ∀ x : N, IsDomain (N.presheaf.stalk x) ∧ IsIntegrallyClosed (N.presheaf.stalk x))
