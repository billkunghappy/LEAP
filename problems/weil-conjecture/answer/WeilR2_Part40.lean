  obtain ⟨hÂloc, hÂcomp, hÂlh, hÂres⟩ := wc_hnas_completion_local_complete A
  obtain ⟨hBloc, hBcomp, -, -⟩ := wc_hnas_completion_local_complete R
  haveI := hÂloc
  haveI := hBloc
  haveI := hÂcomp
  haveI := hBcomp
  haveI := hÂlh
  haveI := wc_hnas_completion_noetherian A
  haveI := wc_hnas_completion_noetherian R
  obtain ⟨ι, hι, hιloc, hιflat⟩ : ∃ ι : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
      AdicCompletion (IsLocalRing.maximalIdeal R) R,
