by
  classical



  have hsplit : ∀ (R : CommRingCat.{u}) (m : ℕ) (c : Rˣ) (T : Type u) [AddCommGroup T]
      (ι : Additive (rootsOfUnity m R) →+ ↥(wcKaSub R m c))
      (_hι : ∀ ζ : Additive (rootsOfUnity m R), ((ι ζ : ↥(wcKaSub R m c)) : ℤ × Additive Rˣ) =
        (0, Additive.ofMul ((Additive.toMul ζ : rootsOfUnity m R) : Rˣ))),
      (∀ x : TensorProduct ℤ (Additive (rootsOfUnity m R)) T,
        TensorProduct.lift ((LinearMap.lsmul ℤ T).comp
          (((AddMonoidHom.fst ℤ (Additive Rˣ)).comp (wcKaSub R m c).subtype).toIntLinearMap))
          (TensorProduct.map ι.toIntLinearMap (LinearMap.id : T →ₗ[ℤ] T) x) = 0) ∧
      ∀ σ : Rˣ, σ ^ m = c →
        (Function.Injective (TensorProduct.map ι.toIntLinearMap (LinearMap.id : T →ₗ[ℤ] T)) ∧
        (∀ x : TensorProduct ℤ ↥(wcKaSub R m c) T,
          TensorProduct.lift ((LinearMap.lsmul ℤ T).comp
            (((AddMonoidHom.fst ℤ (Additive Rˣ)).comp (wcKaSub R m c).subtype).toIntLinearMap)) x = 0 →
          ∃ y, TensorProduct.map ι.toIntLinearMap (LinearMap.id : T →ₗ[ℤ] T) y = x) ∧
        Function.Surjective (TensorProduct.lift ((LinearMap.lsmul ℤ T).comp
            (((AddMonoidHom.fst ℤ (Additive Rˣ)).comp (wcKaSub R m c).subtype).toIntLinearMap)))) := by
    intro R m c T _ ι hι
    have hG : ∀ (e : ↥(wcKaSub R m c)) (τ : T),
        TensorProduct.lift ((LinearMap.lsmul ℤ T).comp
          (((AddMonoidHom.fst ℤ (Additive Rˣ)).comp (wcKaSub R m c).subtype).toIntLinearMap))
          (e ⊗ₜ τ) = (e : ℤ × Additive Rˣ).1 • τ := by
      intro e τ
      rw [TensorProduct.lift.tmul]
      rfl
    have hF : ∀ (ζ : Additive (rootsOfUnity m R)) (τ : T),
        TensorProduct.map ι.toIntLinearMap (LinearMap.id : T →ₗ[ℤ] T) (ζ ⊗ₜ τ) = ι ζ ⊗ₜ τ := by
      intro ζ τ
      rw [TensorProduct.map_tmul]
      rfl
    refine ⟨?_, ?_⟩
    · intro x
      induction x using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul ζ τ =>
        rw [hF, hG, hι]
        exact zero_smul ℤ τ
      | add x y hx hy => rw [map_add, map_add, hx, hy, add_zero]
    · intro σ hσ
      have he1 : ((1 : ℤ), Additive.ofMul σ) ∈ wcKaSub R m c := by
        show (Additive.toMul (Additive.ofMul σ)) ^ m = c ^ (1 : ℤ)
        rw [toMul_ofMul, zpow_one, hσ]
      let e1 : ↥(wcKaSub R m c) := ⟨(1, Additive.ofMul σ), he1⟩
      have key : ∀ z : ℤ, (σ ^ (-z)) ^ m = (c ^ z)⁻¹ := by
        intro z
        rw [← hσ, ← zpow_natCast (σ ^ (-z)), ← zpow_mul, ← zpow_natCast σ, ← zpow_mul, ← zpow_neg]
        congr 1
        ring
      have hrt : ∀ e : ↥(wcKaSub R m c),
          Additive.toMul (e : ℤ × Additive Rˣ).2 * σ ^ (-(e : ℤ × Additive Rˣ).1) ∈
            rootsOfUnity m R := by
        intro e
        have he : (Additive.toMul (e : ℤ × Additive Rˣ).2) ^ m = c ^ (e : ℤ × Additive Rˣ).1 := e.2
        rw [mem_rootsOfUnity, mul_pow, he, key, mul_inv_cancel]
      let rt : ↥(wcKaSub R m c) →+ Additive (rootsOfUnity m R) :=
        AddMonoidHom.mk' (fun e => Additive.ofMul
          (⟨Additive.toMul (e : ℤ × Additive Rˣ).2 * σ ^ (-(e : ℤ × Additive Rˣ).1), hrt e⟩ :
            rootsOfUnity m R)) (by
          intro e e'
          refine Additive.toMul.injective (Subtype.ext ?_)
          show Additive.toMul ((e : ℤ × Additive Rˣ).2 + (e' : ℤ × Additive Rˣ).2) *
              σ ^ (-((e : ℤ × Additive Rˣ).1 + (e' : ℤ × Additive Rˣ).1)) =
            (Additive.toMul (e : ℤ × Additive Rˣ).2 * σ ^ (-(e : ℤ × Additive Rˣ).1)) *
              (Additive.toMul (e' : ℤ × Additive Rˣ).2 * σ ^ (-(e' : ℤ × Additive Rˣ).1))
          rw [toMul_add, neg_add, zpow_add, mul_mul_mul_comm])
      have I1 : ∀ ζ, rt (ι ζ) = ζ := by
        intro ζ
        refine Additive.toMul.injective (Subtype.ext ?_)
        show Additive.toMul ((ι ζ : ℤ × Additive Rˣ).2) * σ ^ (-(ι ζ : ℤ × Additive Rˣ).1) =
          ((Additive.toMul ζ : rootsOfUnity m R) : Rˣ)
        rw [hι]
        simp
      have I2 : ∀ e : ↥(wcKaSub R m c), ι (rt e) + (e : ℤ × Additive Rˣ).1 • e1 = e := by
        intro e
        apply Subtype.ext
        rw [AddSubgroup.coe_add, AddSubgroup.coe_zsmul, hι]
        apply Prod.ext
        · show (0 : ℤ) + (e : ℤ × Additive Rˣ).1 * 1 = (e : ℤ × Additive Rˣ).1
          ring
        · apply Additive.toMul.injective
          show (Additive.toMul (e : ℤ × Additive Rˣ).2 * σ ^ (-(e : ℤ × Additive Rˣ).1)) *
              σ ^ (e : ℤ × Additive Rˣ).1 = Additive.toMul (e : ℤ × Additive Rˣ).2
          rw [mul_assoc, ← zpow_add, neg_add_cancel, zpow_zero, mul_one]
      have hRt : ∀ (e : ↥(wcKaSub R m c)) (τ : T),
          TensorProduct.map rt.toIntLinearMap (LinearMap.id : T →ₗ[ℤ] T) (e ⊗ₜ τ) = rt e ⊗ₜ τ := by
        intro e τ
        rw [TensorProduct.map_tmul]
        rfl
      have b1 : ∀ x, TensorProduct.map rt.toIntLinearMap (LinearMap.id : T →ₗ[ℤ] T)
          (TensorProduct.map ι.toIntLinearMap (LinearMap.id : T →ₗ[ℤ] T) x) = x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero]
        | tmul ζ τ => rw [hF, hRt, I1]
        | add x y hx hy => rw [map_add, map_add, hx, hy]
      have b3 : ∀ x, TensorProduct.map ι.toIntLinearMap (LinearMap.id : T →ₗ[ℤ] T)
          (TensorProduct.map rt.toIntLinearMap (LinearMap.id : T →ₗ[ℤ] T) x) +
          e1 ⊗ₜ (TensorProduct.lift ((LinearMap.lsmul ℤ T).comp
            (((AddMonoidHom.fst ℤ (Additive Rˣ)).comp (wcKaSub R m c).subtype).toIntLinearMap)) x) =
            x := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero, map_zero, TensorProduct.tmul_zero, add_zero]
        | tmul e τ =>
          rw [hRt, hF, hG, TensorProduct.tmul_smul, TensorProduct.smul_tmul',
            ← TensorProduct.add_tmul, I2]
        | add x y hx hy =>
          rw [map_add, map_add, map_add, TensorProduct.tmul_add, add_add_add_comm, hx, hy]
      refine ⟨Function.LeftInverse.injective b1, ?_, ?_⟩
      · intro x hx
        refine ⟨TensorProduct.map rt.toIntLinearMap (LinearMap.id : T →ₗ[ℤ] T) x, ?_⟩
        have h := b3 x
        rw [hx, TensorProduct.tmul_zero, add_zero] at h
        exact h
      · intro τ
        refine ⟨e1 ⊗ₜ τ, ?_⟩
        rw [hG]
        exact one_smul ℤ τ



  have tens_ext : ∀ {M N : Type u} [AddCommGroup M] [AddCommGroup N] {Q : Type (u+1)}
      [AddCommGroup Q] (φ ψ : ULift.{u+1} (TensorProduct ℤ M N) →+ Q),
