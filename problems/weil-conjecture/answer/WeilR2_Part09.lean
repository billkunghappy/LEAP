theorem wc_lptt_ka_sq1 (Y : Scheme.{u}) (ℓ n D k : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ)
    (a : (Γ(Y, ⊤))ˣ) (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (hk : k < D) (hs : s ⟨k, hk⟩ = a)
    (hnat : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcKaBPre Y ℓ n k a).map f ≫ wcKaT2App Y ℓ n D k s a hℓ W' =
        wcKaT2App Y ℓ n D k s a hℓ W ≫
          (wcLpttEtPre Y (wcTensFun (wcKtE.{u} ℓ n D k) (wcKtT.{u} (ℓ ^ n) k))).map f) :
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n D k s hℓ) ≫
      wcLpttEtShMap Y (wcTensNat (wcKtIotaE.{u} ℓ n D k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))) =
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKaFPre Y ℓ n k a) ≫
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT2Pre Y ℓ n D k s a hℓ) :=
by
  classical

  have hNat : ∀ {F G : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (a : ∀ X, F.obj X ⟶ G.obj X),
      (∀ ⦃X X' : (Y.Etale)ᵒᵖ⦄ (f : X ⟶ X'), F.map f ≫ a X' = a X ≫ G.map f) →
      ∀ X, (wcNatOf a).app X = a X := by
    intro F G a h X
    unfold wcNatOf
    rw [dif_pos h]
  have G1 : ∀ {M M' N N' P P' : Type u} [AddCommGroup M] [AddCommGroup M'] [AddCommGroup N]
      [AddCommGroup N'] [AddCommGroup P] [AddCommGroup P'] (p : M →ₗ[ℤ] M') (q : N →ₗ[ℤ] N')
      (r : P →ₗ[ℤ] P') (z : P) (z' : P'), r z = z' → ∀ x : TensorProduct ℤ M N,
      LinearMap.rTensor N' (TensorProduct.mk ℤ P' M' z') (TensorProduct.map p q x) =
        TensorProduct.map (TensorProduct.map r p) q
          (LinearMap.rTensor N (TensorProduct.mk ℤ P M z) x) := by
    intro M M' N N' P P' _ _ _ _ _ _ p q r z z' hz x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul m b =>
      simp only [TensorProduct.map_tmul, LinearMap.rTensor_tmul, TensorProduct.mk_apply, hz]
    | add x y hx hy => simp only [map_add, hx, hy]
  have G2 : ∀ {M M' N N' K K' : Type u} [AddCommGroup M] [AddCommGroup M'] [AddCommGroup N]
      [AddCommGroup N'] [AddCommGroup K] [AddCommGroup K'] (p : M →ₗ[ℤ] M') (q : N →ₗ[ℤ] N')
      (i : M →ₗ[ℤ] K) (i' : M' →ₗ[ℤ] K') (e : K →ₗ[ℤ] K'), (∀ m, i' (p m) = e (i m)) →
      ∀ x : TensorProduct ℤ M N,
      TensorProduct.map i' (LinearMap.id : N' →ₗ[ℤ] N') (TensorProduct.map p q x) =
        TensorProduct.map e q (TensorProduct.map i (LinearMap.id : N →ₗ[ℤ] N) x) := by
    intro M M' N N' K K' _ _ _ _ _ _ p q i i' e h x
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul m b => simp only [TensorProduct.map_tmul, LinearMap.id_apply, h]
    | add x y hx hy => simp only [map_add, hx, hy]
