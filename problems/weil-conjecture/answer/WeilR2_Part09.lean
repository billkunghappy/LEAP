      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have central : ∀ (e : SheafOfModules.unit (wcEtZModRing YO' ℓ) ⟶
      SheafOfModules.unit (wcEtZModRing YO' ℓ))
      (y : Abelian.Ext (SheafOfModules.unit (wcEtZModRing YO' ℓ))
        (SheafOfModules.unit (wcEtZModRing YO' ℓ)) k),
      (Abelian.Ext.mk₀ e).comp y (zero_add k) = y.comp (Abelian.Ext.mk₀ e) (add_zero k) := by
    intro e y
    have hcm : ∀ (X : (YO'.Etale)ᵒᵖ) (a b : (wcEtZModRing YO' ℓ).obj.obj X), a * b = b * a := s2
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing YO' ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcEtZModRing YO' ℓ)),
        m.app (SheafOfModules.unit (wcEtZModRing YO' ℓ)) = e := by
      let R := wcEtZModRing YO' ℓ
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (YO'.Etale)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (YO'.Etale)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (YO'.Etale)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing YO' ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcEtZModRing YO' ℓ)))
        (z : Abelian.Ext (SheafOfModules.unit (wcEtZModRing YO' ℓ))
          (SheafOfModules.unit (wcEtZModRing YO' ℓ)) k),
        (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcEtZModRing YO' ℓ)))).comp z (zero_add k) =
          z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcEtZModRing YO' ℓ))))
            (add_zero k) := by
      intro m z
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
      simp only [Abelian.Ext.id_mapExactFunctor] at h
      exact h.symm
    obtain ⟨m, hm⟩ := hext
    subst hm
    exact hcen m y

  have gen2 : ∀ {A B : SheafOfModules.{u+1} (wcEtZModRing YO' ℓ)} (z : Abelian.Ext A B k)
      (j : A ⟶ B) (a₁ a₂ : SheafOfModules.unit (wcEtZModRing YO' ℓ) ⟶ A)
      (b₁ b₂ : B ⟶ SheafOfModules.unit (wcEtZModRing YO' ℓ)),
      j ≫ b₂ ≫ a₂ = 𝟙 A → b₂ ≫ a₂ ≫ j = 𝟙 B → a₁ ≫ j ≫ b₁ = 𝟙 _ →
      (Abelian.Ext.mk₀ a₁).comp (z.comp (Abelian.Ext.mk₀ b₁) (add_zero k)) (zero_add k) =
        (Abelian.Ext.mk₀ a₂).comp (z.comp (Abelian.Ext.mk₀ b₂) (add_zero k)) (zero_add k) := by
    intro A B z j a₁ a₂ b₁ b₂ H1 H2 H3
    have ea : (a₁ ≫ j ≫ b₂) ≫ a₂ = a₁ := by
      simp only [Category.assoc, H1, Category.comp_id]
    have eb : b₂ ≫ a₂ ≫ j ≫ b₁ = b₁ := by
      rw [show b₂ ≫ a₂ ≫ j ≫ b₁ = (b₂ ≫ a₂ ≫ j) ≫ b₁ by simp only [Category.assoc], H2,
        Category.id_comp]
    have eE : (a₁ ≫ j ≫ b₂) ≫ (a₂ ≫ j ≫ b₁) = 𝟙 _ := by
      rw [show (a₁ ≫ j ≫ b₂) ≫ (a₂ ≫ j ≫ b₁) = a₁ ≫ j ≫ ((b₂ ≫ a₂ ≫ j) ≫ b₁) by
        simp only [Category.assoc], H2, Category.id_comp, H3]
    have hcc : (Abelian.Ext.mk₀ (a₁ ≫ j ≫ b₂)).comp ((Abelian.Ext.mk₀ a₂).comp
          (z.comp (Abelian.Ext.mk₀ b₂) (add_zero k)) (zero_add k)) (zero_add k) =
        ((Abelian.Ext.mk₀ a₂).comp (z.comp (Abelian.Ext.mk₀ b₂) (add_zero k)) (zero_add k)).comp
          (Abelian.Ext.mk₀ (a₁ ≫ j ≫ b₂)) (add_zero k) :=
      central _ _
    have e1 : (Abelian.Ext.mk₀ a₁).comp (z.comp (Abelian.Ext.mk₀ b₁) (add_zero k)) (zero_add k) =
        ((Abelian.Ext.mk₀ (a₁ ≫ j ≫ b₂)).comp ((Abelian.Ext.mk₀ a₂).comp
          (z.comp (Abelian.Ext.mk₀ b₂) (add_zero k)) (zero_add k)) (zero_add k)).comp
          (Abelian.Ext.mk₀ (a₂ ≫ j ≫ b₁)) (add_zero k) := by
      rw [h2, h4, h3, ea, eb]
    rw [e1, hcc, h3, eE, Abelian.Ext.comp_mk₀_id]

  have hL1 : (Abelian.Ext.mk₀ c').comp ((Abelian.Ext.mapExactFunctor Dg'.Φ
      ((Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mapExactFunctor Ef.Φ x).comp
        (Abelian.Ext.mk₀ Ef.μ.hom) (add_zero k)) (zero_add k))).comp
      (Abelian.Ext.mk₀ Dg'.μ.hom) (add_zero k)) (zero_add k) =
      (Abelian.Ext.mk₀ (c' ≫ Dg'.Φ.map κ)).comp
        ((Abelian.Ext.mapExactFunctor (Ef.Φ ⋙ Dg'.Φ) x).comp
          (Abelian.Ext.mk₀ (Dg'.Φ.map Ef.μ.hom ≫ Dg'.μ.hom)) (add_zero k)) (zero_add k) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
  have hR : wcEtPull Dw k ((Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero k)) (zero_add k)) =
      (Abelian.Ext.mk₀ (Dw.μ.inv ≫ Dw.Φ.map c)).comp
        ((Abelian.Ext.mapExactFunctor (Dg.Φ ⋙ Dw.Φ) x).comp
          (Abelian.Ext.mk₀ (Dw.Φ.map Dg.μ.hom ≫ Dw.μ.hom)) (add_zero k)) (zero_add k) := by
    show (Abelian.Ext.mk₀ Dw.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dw.Φ
      ((Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dg.Φ x).comp
        (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero k)) (zero_add k))).comp
      (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero k)) (zero_add k) = _
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
  have hnatx := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x Ψ.hom
  have hL2 : (Abelian.Ext.mk₀ (c' ≫ Dg'.Φ.map κ)).comp
        ((Abelian.Ext.mapExactFunctor (Ef.Φ ⋙ Dg'.Φ) x).comp
          (Abelian.Ext.mk₀ (Dg'.Φ.map Ef.μ.hom ≫ Dg'.μ.hom)) (add_zero k)) (zero_add k) =
      (Abelian.Ext.mk₀ ((c' ≫ Dg'.Φ.map κ) ≫ Ψ.hom.app (Limits.kernel (wcEtSuppUnitMap D)))).comp
        ((Abelian.Ext.mapExactFunctor (Dg.Φ ⋙ Dw.Φ) x).comp
          (Abelian.Ext.mk₀ (Ψ.inv.app (SheafOfModules.unit (wcEtZModRing W ℓ)) ≫
            Dg'.Φ.map Ef.μ.hom ≫ Dg'.μ.hom)) (add_zero k)) (zero_add k) := by
    have step1 : (Abelian.Ext.mapExactFunctor (Ef.Φ ⋙ Dg'.Φ) x).comp
        (Abelian.Ext.mk₀ (Dg'.Φ.map Ef.μ.hom ≫ Dg'.μ.hom)) (add_zero k) =
        ((Abelian.Ext.mk₀ (Ψ.hom.app (Limits.kernel (wcEtSuppUnitMap D)))).comp
          (Abelian.Ext.mapExactFunctor (Dg.Φ ⋙ Dw.Φ) x) (zero_add k)).comp
          (Abelian.Ext.mk₀ (Ψ.inv.app (SheafOfModules.unit (wcEtZModRing W ℓ)) ≫
            Dg'.Φ.map Ef.μ.hom ≫ Dg'.μ.hom)) (add_zero k) := by
      rw [← hnatx, h3, Iso.hom_inv_id_app_assoc]
    rw [step1, h4, h2]

  have hsplit : Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) ≫ Dg.μ.hom ≫ c = 𝟙 _ := by
    haveI : Mono (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) := inferInstance
    rw [← cancel_mono (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)))]
    simp only [Category.assoc, hc, Iso.hom_inv_id, Category.comp_id, Category.id_comp]
  have hsplit' : Dg.μ.hom ≫ c ≫ Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) = 𝟙 _ := by
    rw [hc, Iso.hom_inv_id]
  have H1 : Dw.Φ.map (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) ≫
      (Dw.Φ.map Dg.μ.hom ≫ Dw.μ.hom) ≫ (Dw.μ.inv ≫ Dw.Φ.map c) = 𝟙 _ := by
    have e := congrArg Dw.Φ.map hsplit
    simp only [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_id] at e
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    exact e
  have H2 : (Dw.Φ.map Dg.μ.hom ≫ Dw.μ.hom) ≫ (Dw.μ.inv ≫ Dw.Φ.map c) ≫
      Dw.Φ.map (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) = 𝟙 _ := by
    have e := congrArg Dw.Φ.map hsplit'
    simp only [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_id] at e
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    exact e
  have hnat : Ψ.hom.app (Limits.kernel (wcEtSuppUnitMap D)) ≫
      Dw.Φ.map (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) ≫
      Ψ.inv.app (SheafOfModules.unit (wcEtZModRing W ℓ)) =
      Dg'.Φ.map (Ef.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) := by
    have e := Ψ.inv.naturality (Limits.kernel.ι (wcEtSuppUnitMap D))
    simp only [Functor.comp_map] at e
    rw [e, Iso.hom_inv_id_app_assoc]
  have hκ0 : κ ≫ Ef.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)) ≫ Ef.μ.hom =
      Limits.kernel.ι (wcEtSuppUnitMap D') := by
    rw [reassoc_of% hκ, Iso.inv_hom_id, Category.comp_id]
  have hκ' : Dg'.Φ.map κ ≫ Dg'.Φ.map (Ef.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) ≫
      Dg'.Φ.map Ef.μ.hom = Dg'.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D')) := by
    rw [← hκ0]
    simp only [CategoryTheory.Functor.map_comp]
  have H3 : ((c' ≫ Dg'.Φ.map κ) ≫ Ψ.hom.app (Limits.kernel (wcEtSuppUnitMap D))) ≫
      Dw.Φ.map (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) ≫
      (Ψ.inv.app (SheafOfModules.unit (wcEtZModRing W ℓ)) ≫ Dg'.Φ.map Ef.μ.hom ≫ Dg'.μ.hom) =
      𝟙 _ := by
    simp only [Category.assoc]
    rw [reassoc_of% hnat, reassoc_of% hκ', reassoc_of% hc', Iso.inv_hom_id]
  rw [hL1, hL2, hR]
  exact gen2 _ (Dw.Φ.map (Dg.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)))) _ _ _ _ H1 H2 H3

theorem wc_et_punct_supp_boundary_lift : ∀ {W ZW YO : Scheme.{u}} (iW : ZW ⟶ W) [IsClosedImmersion iW] (gO : YO ⟶ W) [IsOpenImmersion gO], Set.range gO = (Set.range iW)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData iW ℓ) (k : ℕ) (α : wcEtZModExt YO ℓ k), ∃ θ : wcEtSuppExt D (k + 1), ∀ (W' : Scheme.{u}) (f : W' ⟶ W), Etale f → (∀ (Z' : Scheme.{u}) (iW' : Z' ⟶ W') (g : Z' ⟶ ZW), IsPullback g iW' iW f → ∀ (D' : wcEtPullData iW' ℓ) (Ef : wcEtPullData f ℓ) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ef D' γ (k + 1) θ = 0) → ∀ (YO' : Scheme.{u}) (gO' : YO' ⟶ W') (w : YO' ⟶ YO), IsPullback w gO' gO f → ∃ β : wcEtZModExt W' ℓ k, ∀ (Dw : wcEtPullData w ℓ) (Dg : wcEtPullData gO' ℓ), wcEtPull Dw k α = wcEtPull Dg k β :=
by
  classical
  intro W ZW YO iW _ gO _ hrange ℓ _ D k α
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO ℓ)) := HasExt.standard _

  obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists gO ℓ
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  obtain ⟨c, hc, hT⟩ := wc_et_open_compl_ker_transfer iW gO hrange ℓ D Dg
  obtain ⟨x₀, hx₀⟩ := (hT k).2 α
  haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi iW D
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
      (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ
  refine ⟨hS.extClass.comp x₀ (add_comm 1 k), ?_⟩
  intro W' f _ hkill YO' gO' w hpb
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing W' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YO' ℓ)) := HasExt.standard _

  have hsq := IsPullback.of_hasPullback iW f
  haveI : IsClosedImmersion (Limits.pullback.snd iW f) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
  obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd iW f) ℓ
  obtain ⟨Ef⟩ := wc_et_zmod_pull_data_exists f ℓ
  haveI := Ef.additive
  haveI := Ef.presLim
  haveI := Ef.presColim
  obtain ⟨γ, hγ, hπ'⟩ := wc_et_closed_supp_base_change iW f (Limits.pullback.snd iW f)
    (Limits.pullback.fst iW f) hsq D Ef D'
  have h0 := hkill _ (Limits.pullback.snd iW f) (Limits.pullback.fst iW f) hsq D' Ef γ hγ

  obtain ⟨κ, hκ, hnat⟩ := wc_et_supp_restr_extclass_kernel iW (Limits.pullback.snd iW f) f
    D Ef D' γ hγ
  have hS' : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D')) (wcEtSuppUnitMap D')
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hπ'
  have h1 := hnat hS hS' k x₀
  have h2 := h1.symm.trans h0
  obtain ⟨β, hβ⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS'
    (SheafOfModules.unit (wcEtZModRing W' ℓ)) _ (add_comm 1 k) h2
  refine ⟨β, fun Dw Dg' => ?_⟩

  haveI : IsOpenImmersion gO' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb inferInstance
  have hptw : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
      fst ≫ f = snd ≫ g → ∀ t : P, f (fst t) = g (snd t) := by
    intro P A B S fst snd f g h t
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, h]
  have hpts : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
      IsPullback fst snd f g → ∀ (a : A) (b : B), f a = g b → ∃ t : P, fst t = a ∧ snd t = b := by
    intro P A B S fst snd f g h a b hab
    obtain ⟨t, h1, h2⟩ := Scheme.Pullback.exists_preimage_pullback a b hab
    refine ⟨h.isoPullback.inv t, ?_, ?_⟩
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]; exact h1
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_snd]; exact h2
  have hrange' : Set.range gO' = (Set.range (Limits.pullback.snd iW f))ᶜ := by
    ext y
    constructor
    · rintro ⟨t, rfl⟩ ⟨s, hs⟩
      have h1 : gO (w t) ∈ (Set.range iW)ᶜ := by rw [← hrange]; exact ⟨_, rfl⟩
      apply h1
      refine ⟨Limits.pullback.fst iW f s, ?_⟩
      rw [hptw hsq.w s, hs, ← hptw hpb.w t]
    · intro hy
      have hvy : f y ∈ (Set.range iW)ᶜ := by
        rintro ⟨z, hz⟩
        obtain ⟨s, -, hs⟩ := hpts hsq z y hz
        exact hy ⟨s, hs⟩
      rw [← hrange] at hvy
      obtain ⟨a, ha⟩ := hvy
      obtain ⟨t, -, ht⟩ := hpts hpb a y ha
      exact ⟨t, ht⟩

  obtain ⟨c', hc', -⟩ := wc_et_open_compl_ker_transfer (Limits.pullback.snd iW f) gO' hrange' ℓ
    D' Dg'
  haveI := Dg'.additive
  haveI := Dg'.presLim
  haveI := Dg'.presColim

  have hnat5 := wc_et_open_compl_transfer_natural gO gO' f w hpb.w ℓ D D' Ef Dg Dg' Dw κ c c'
    hκ hc hc' k x₀
  have key : ∀ y, (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D'))).comp β (zero_add k) = y →
      (Abelian.Ext.mk₀ c').comp ((Abelian.Ext.mapExactFunctor Dg'.Φ y).comp
        (Abelian.Ext.mk₀ Dg'.μ.hom) (add_zero k)) (zero_add k) = wcEtPull Dg' k β := by
    intro y hy
    subst hy
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
      Abelian.Ext.mk₀_comp_mk₀, hc']
    rfl
  exact (congrArg (wcEtPull Dw k) hx₀.symm).trans (hnat5.symm.trans (key _ hβ))

theorem wc_et_smooth_pair_supp_ld_of_model : ∀ (K : Type u) [Field K] [IsAlgClosed K] (W : Scheme.{u}) (fW : W ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fW] (ZW : Scheme.{u}) (iW : ZW ⟶ W) [IsClosedImmersion iW] [SmoothOfRelativeDimension (n - c) (iW ≫ fW)], 1 ≤ c → c ≤ n → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (M : ℕ), (∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → ∀ (D0 : wcEtPullData z0 ℓ) (θ : wcEtSuppExt D0 M) (s : S), ∃ (V : Scheme.{u}) (v : V ⟶ S), Etale v ∧ s ∈ Set.range v ∧ ∀ (PV : Scheme.{u}) (a : PV ⟶ P) (pV : PV ⟶ V), IsPullback a pV p v → ∀ (z0V : V ⟶ PV), IsPullback v z0V z0 a → ∀ (D' : wcEtPullData z0V ℓ) (Ea : wcEtPullData a ℓ) (γ : wcEtSuppObj D' ⟶ Ea.Φ.obj (wcEtSuppObj D0)), wcEtSuppUnitMap D' ≫ γ = Ea.μ.inv ≫ Ea.Φ.map (wcEtSuppUnitMap D0) → wcEtSuppRestr D0 Ea D' γ M θ = 0) → ∀ (D : wcEtPullData iW ℓ) (θ : wcEtSuppExt D M) (z : ZW), ∃ (W' : Scheme.{u}) (f : W' ⟶ W), Etale f ∧ iW z ∈ Set.range f ∧ ∀ (Z' : Scheme.{u}) (iW' : Z' ⟶ W') (g : Z' ⟶ ZW), IsPullback g iW' iW f → ∀ (D' : wcEtPullData iW' ℓ) (Ef : wcEtPullData f ℓ) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ef D' γ M θ = 0 :=
by
  classical
  intro K _ _ W fW n c _ ZW iW _ _ hc1 hcn ℓ _ M hmodel D θ z

  have hpts : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
      IsPullback fst snd f g → ∀ (a : A) (b : B), f a = g b → ∃ t : P, fst t = a ∧ snd t = b := by
    intro P A B S fst snd f g h a b hab
    obtain ⟨t, h1, h2⟩ := Scheme.Pullback.exists_preimage_pullback a b hab
    refine ⟨h.isoPullback.inv t, ?_, ?_⟩
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]; exact h1
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_snd]; exact h2

  have kill_of_factor : ∀ {Y Y₁ Y₂ X X₁ X₂ : Scheme.{u}} (i : X ⟶ Y) [IsClosedImmersion i]
      (f₁ : Y₁ ⟶ Y) (i₁ : X₁ ⟶ Y₁) (g₁ : X₁ ⟶ X), IsPullback g₁ i₁ i f₁ →
      ∀ (D : wcEtPullData i ℓ) (θ : wcEtSuppExt D M),
      (∀ (D₁ : wcEtPullData i₁ ℓ) (E₁ : wcEtPullData f₁ ℓ)
        (γ₁ : wcEtSuppObj D₁ ⟶ E₁.Φ.obj (wcEtSuppObj D)),
        wcEtSuppUnitMap D₁ ≫ γ₁ = E₁.μ.inv ≫ E₁.Φ.map (wcEtSuppUnitMap D) →
        wcEtSuppRestr D E₁ D₁ γ₁ M θ = 0) →
      ∀ (f₂ : Y₂ ⟶ Y₁) (f : Y₂ ⟶ Y), f₂ ≫ f₁ = f → ∀ (i₂ : X₂ ⟶ Y₂) (g : X₂ ⟶ X),
      IsPullback g i₂ i f → ∀ (D₂ : wcEtPullData i₂ ℓ) (E : wcEtPullData f ℓ)
      (γ : wcEtSuppObj D₂ ⟶ E.Φ.obj (wcEtSuppObj D)),
      wcEtSuppUnitMap D₂ ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D) →
      wcEtSuppRestr D E D₂ γ M θ = 0 := by
    intro Y Y₁ Y₂ X X₁ X₂ i _ f₁ i₁ g₁ sq₁ D θ hkill f₂ f hf i₂ g sq D₂ E γ hγ
    subst hf
    haveI : IsClosedImmersion i₁ :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) sq₁ inferInstance
    have hw : g ≫ i = (i₂ ≫ f₂) ≫ f₁ := by rw [sq.w, Category.assoc]
    obtain ⟨g₂, hl1, hl2⟩ : ∃ g₂ : X₂ ⟶ X₁, g₂ ≫ g₁ = g ∧ g₂ ≫ i₁ = i₂ ≫ f₂ :=
      ⟨sq₁.lift g (i₂ ≫ f₂) hw, sq₁.lift_fst _ _ _, sq₁.lift_snd _ _ _⟩
    have sq₂ : IsPullback g₂ i₂ i₁ f₂ :=
      IsPullback.of_right (by rw [hl1]; exact sq) hl2 sq₁
    obtain ⟨E₁⟩ := wc_et_zmod_pull_data_exists f₁ ℓ
    obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists f₂ ℓ
    obtain ⟨D₁⟩ := wc_et_zmod_pull_data_exists i₁ ℓ
    obtain ⟨γ₁, h₁, -⟩ := wc_et_closed_supp_base_change i f₁ i₁ g₁ sq₁ D E₁ D₁
    obtain ⟨γ₂, h₂, hepi⟩ := wc_et_closed_supp_base_change i₁ f₂ i₂ g₂ sq₂ D₁ E₂ D₂
    rw [wc_et_supp_restr_comp f₁ f₂ (f₂ ≫ f₁) rfl D D₁ D₂ E₁ E₂ E γ₁ γ₂ γ h₁ h₂ hγ hepi M θ,
      hkill D₁ E₁ γ₁ h₁, map_zero]

  obtain ⟨W₁, -, hzW₁, htube⟩ :=
    wc_smooth_pair_etale_tube K W ZW fW n c iW hc1 hcn ⊤ z trivial
  obtain ⟨ZW₁, gW₁, iW₁, hZ⟩ : ∃ (ZW₁ : Scheme.{u}) (gW₁ : ZW₁ ⟶ ZW) (iW₁ : ZW₁ ⟶ W₁),
      IsPullback gW₁ iW₁ iW W₁.ι := ⟨_, _, _, IsPullback.of_hasPullback iW W₁.ι⟩

  haveI : Etale gW₁ := MorphismProperty.of_isPullback (P := @Etale) hZ.flip inferInstance
  haveI hsm : SmoothOfRelativeDimension (n - c) (iW₁ ≫ W₁.ι ≫ fW) := by
    have h : SmoothOfRelativeDimension (0 + (n - c)) (gW₁ ≫ iW ≫ fW) := inferInstance
    rw [Nat.zero_add, ← Category.assoc, hZ.w, Category.assoc] at h
    exact h
  obtain ⟨P, p, q, hP⟩ : ∃ (P : Scheme.{u}) (p : P ⟶ ZW₁)
      (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))),
      IsPullback p q (iW₁ ≫ W₁.ι ≫ fW)
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  have hoa : Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap,
      CommRingCat.ofHom_id, Spec.map_id]
  obtain ⟨z0, hz0p, hz0q⟩ : ∃ z0 : ZW₁ ⟶ P, z0 ≫ p = 𝟙 ZW₁ ∧
      z0 ≫ q = (iW₁ ≫ W₁.ι ≫ fW) ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) :=
    ⟨hP.lift (𝟙 _) ((iW₁ ≫ W₁.ι ≫ fW) ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)))
      (by rw [Category.id_comp, Category.assoc, hoa, Category.comp_id]),
      hP.lift_fst _ _ _, hP.lift_snd _ _ _⟩
  obtain ⟨hz0ci, V', π, σ, e, hπe, hσe, hπ, hσ⟩ :=
    htube ZW₁ iW₁ gW₁ hZ P p q z0 hP hz0p hz0q
  haveI := hz0ci
  haveI := hπe
  haveI := hσe
  have heσ : e ≫ σ = z0 := hσ.w.symm.trans (Category.id_comp z0)
  have heπ : e ≫ π = iW₁ := hπ.w.symm.trans (Category.id_comp iW₁)

  have hF : IsPullback gW₁ e iW (π ≫ W₁.ι) := by
    have h := hπ.paste_horiz hZ
    rwa [Category.id_comp] at h
  haveI : IsClosedImmersion e :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hσ inferInstance
  obtain ⟨De⟩ := wc_et_zmod_pull_data_exists e ℓ
  obtain ⟨EF⟩ := wc_et_zmod_pull_data_exists (π ≫ W₁.ι) ℓ
  obtain ⟨Eσ⟩ := wc_et_zmod_pull_data_exists σ ℓ
  obtain ⟨D0⟩ := wc_et_zmod_pull_data_exists z0 ℓ
  obtain ⟨γF, hγF, -⟩ := wc_et_closed_supp_base_change iW (π ≫ W₁.ι) e gW₁ hF D EF De
  obtain ⟨γσ, hγσ, -⟩ := wc_et_closed_supp_base_change z0 σ e (𝟙 ZW₁) hσ D0 Eσ De
  obtain ⟨θP, hθP⟩ := wc_et_supp_restr_etale_excision_surjective σ z0 e (𝟙 ZW₁) hσ
    inferInstance D0 Eσ De γσ hγσ M (wcEtSuppRestr D EF De γF M θ)

  have hzr : iW z ∈ Set.range W₁.ι := by rw [Scheme.Opens.range_ι]; exact hzW₁
  obtain ⟨y, hy⟩ := hzr
  obtain ⟨z₁, -, hz₁i⟩ := hpts hZ z y hy.symm
  obtain ⟨V₂, v₂, hv₂, hz₁r, hkillall⟩ :=
    hmodel ZW₁ (iW₁ ≫ W₁.ι ≫ fW) (n - c) P p q z0 hP hz0p hz0q D0 θP z₁
  haveI : Etale v₂ := hv₂
  obtain ⟨PV, a, pV, hPV⟩ : ∃ (PV : Scheme.{u}) (a : PV ⟶ P) (pV : PV ⟶ V₂),
      IsPullback a pV p v₂ := ⟨_, _, _, IsPullback.of_hasPullback p v₂⟩
  haveI : Etale a := MorphismProperty.of_isPullback (P := @Etale) hPV.flip inferInstance
  obtain ⟨z0V, hz0Va, hz0Vp⟩ : ∃ z0V : V₂ ⟶ PV, z0V ≫ a = v₂ ≫ z0 ∧ z0V ≫ pV = 𝟙 V₂ :=
    ⟨hPV.lift (v₂ ≫ z0) (𝟙 V₂) (by rw [Category.assoc, hz0p, Category.comp_id,
      Category.id_comp]), hPV.lift_fst _ _ _, hPV.lift_snd _ _ _⟩

  have hz0V : IsPullback v₂ z0V z0 a := by
    refine IsPullback.of_bot ?_ hz0Va.symm hPV
    rw [hz0Vp, hz0p]
    exact IsPullback.id_vert v₂
  have hkill := hkillall PV a pV hPV z0V hz0V

  obtain ⟨N, nσ, na, hN⟩ : ∃ (N : Scheme.{u}) (nσ : N ⟶ V') (na : N ⟶ PV),
      IsPullback nσ na σ a := ⟨_, _, _, IsPullback.of_hasPullback σ a⟩
  haveI : Etale nσ := MorphismProperty.of_isPullback (P := @Etale) hN.flip inferInstance
  obtain ⟨t, ht⟩ := hz₁r
  have hpz : p (z0 z₁) = v₂ t := by
    rw [ht, ← Scheme.Hom.comp_apply, hz0p]
    try rfl
  obtain ⟨r, hr, -⟩ := hpts hPV (z0 z₁) t hpz
  have hσr : σ (e z₁) = a r := by
    rw [hr, ← Scheme.Hom.comp_apply, heσ]
  obtain ⟨n₀, hn₀, -⟩ := hpts hN (e z₁) r hσr
  refine ⟨N, nσ ≫ (π ≫ W₁.ι), inferInstance, ⟨n₀, ?_⟩, ?_⟩
  · rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hn₀, ← Scheme.Hom.comp_apply e π, heπ,
      hz₁i, hy]

  · intro Z' iW' g hsq D' Ef γ hγ
    have hw : g ≫ iW = (iW' ≫ nσ) ≫ (π ≫ W₁.ι) := by rw [hsq.w, Category.assoc]
    obtain ⟨g₂, hg₂1, hg₂2⟩ : ∃ g₂ : Z' ⟶ ZW₁, g₂ ≫ gW₁ = g ∧ g₂ ≫ e = iW' ≫ nσ :=
      ⟨hF.lift g (iW' ≫ nσ) hw, hF.lift_fst _ _ _, hF.lift_snd _ _ _⟩
    have sq₂ : IsPullback g₂ iW' e nσ :=
      IsPullback.of_right (by rw [hg₂1]; exact hsq) hg₂2 hF
    have sq₃ : IsPullback g₂ iW' z0 (nσ ≫ σ) := by
      have h := sq₂.paste_horiz hσ
      rwa [Category.comp_id] at h
    obtain ⟨Enσ⟩ := wc_et_zmod_pull_data_exists nσ ℓ
    obtain ⟨E₃⟩ := wc_et_zmod_pull_data_exists (nσ ≫ σ) ℓ
    obtain ⟨γh, hγh, hepi⟩ := wc_et_closed_supp_base_change e nσ iW' g₂ sq₂ De Enσ D'
    obtain ⟨γ₃, hγ₃, -⟩ := wc_et_closed_supp_base_change z0 (nσ ≫ σ) iW' g₂ sq₃ D0 E₃ D'
    rw [wc_et_supp_restr_comp (π ≫ W₁.ι) nσ (nσ ≫ (π ≫ W₁.ι)) rfl D De D' EF Enσ Ef γF γh γ
        hγF hγh hγ hepi M θ,
      ← hθP,
      ← wc_et_supp_restr_comp σ nσ (nσ ≫ σ) rfl D0 De D' Eσ Enσ E₃ γσ γh γ₃ hγσ hγh hγ₃ hepi
        M θP]
    exact kill_of_factor z0 a z0V v₂ hz0V D0 θP hkill na (nσ ≫ σ) hN.w.symm iW' g₂ sq₃ D' E₃
      γ₃ hγ₃

theorem wc_et_supp_class_zero_boundary : ∀ {P S0 U0 : Scheme.{u}} (z : S0 ⟶ P) [IsClosedImmersion z] (j : U0 ⟶ P) [IsOpenImmersion j], Set.range j = (Set.range z)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData z ℓ) (M : ℕ) (θ : wcEtSuppExt D (M + 1)), wcEtSuppClass D (M + 1) θ = 0 → ∃ β : wcEtZModExt U0 ℓ M, ∀ (P' : Scheme.{u}) (f : P' ⟶ P), Etale f → ∀ (U' : Scheme.{u}) (j' : U' ⟶ P') (w : U' ⟶ U0), IsPullback w j' j f → (∀ Dw : wcEtPullData w ℓ, wcEtPull Dw M β = 0) → ∀ (S' : Scheme.{u}) (z' : S' ⟶ P') (g : S' ⟶ S0), IsPullback g z' z f → ∀ (D' : wcEtPullData z' ℓ) (Ef : wcEtPullData f ℓ) (γ : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ef D' γ (M + 1) θ = 0 :=
by
  classical
  intro P S0 U0 z _ j _ hr ℓ _ D M θ hcls
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing P ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing U0 ℓ)) := HasExt.standard _

  haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi z D
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ

  have hcls' : (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp θ (zero_add (M + 1)) = 0 := hcls
  obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS
    (SheafOfModules.unit (wcEtZModRing P ℓ)) θ hcls' (n₀ := M) (add_comm 1 M)

  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists j ℓ
  obtain ⟨c, hc, -⟩ := wc_et_open_compl_ker_transfer z j hr ℓ D Dj
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim
  refine ⟨(Abelian.Ext.mk₀ c).comp ((Abelian.Ext.mapExactFunctor Dj.Φ x₁).comp
    (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero M)) (zero_add M), ?_⟩

  intro P' f _ U' j' w hpb hβ S' z' g hsq D' Ef γ hγ
  haveI : IsOpenImmersion j' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb inferInstance
  haveI : IsClosedImmersion z' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
  have hptw : ∀ {Pp A B Ss : Scheme.{u}} {fst : Pp ⟶ A} {snd : Pp ⟶ B} {f1 : A ⟶ Ss}
      {g1 : B ⟶ Ss}, fst ≫ f1 = snd ≫ g1 → ∀ t : Pp, f1 (fst t) = g1 (snd t) := by
    intro Pp A B Ss fst snd f1 g1 h t
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, h]
  have hpts : ∀ {Pp A B Ss : Scheme.{u}} {fst : Pp ⟶ A} {snd : Pp ⟶ B} {f1 : A ⟶ Ss}
      {g1 : B ⟶ Ss}, IsPullback fst snd f1 g1 → ∀ (a : A) (b : B), f1 a = g1 b →
      ∃ t : Pp, fst t = a ∧ snd t = b := by
    intro Pp A B Ss fst snd f1 g1 h a b hab
    obtain ⟨t, h1, h2⟩ := Scheme.Pullback.exists_preimage_pullback a b hab
    refine ⟨h.isoPullback.inv t, ?_, ?_⟩
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]; exact h1
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_snd]; exact h2
  have hr' : Set.range j' = (Set.range z')ᶜ := by
    ext y
    constructor
    · rintro ⟨t, rfl⟩ ⟨s, hs⟩
      have h1 : j (w t) ∈ Set.range j := ⟨_, rfl⟩
      rw [hr] at h1
      apply h1
      refine ⟨g s, ?_⟩
      rw [hptw hsq.w s, hs, ← hptw hpb.w t]
    · intro hy
      have hfy : f y ∈ Set.range j := by
        rw [hr]
        rintro ⟨s0, hs0⟩
        obtain ⟨s, -, hs⟩ := hpts hsq s0 y hs0
        exact hy ⟨s, hs⟩
      obtain ⟨a, ha⟩ := hfy
      obtain ⟨t, -, ht⟩ := hpts hpb a y ha
      exact ⟨t, ht⟩
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing P' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing U' ℓ)) := HasExt.standard _
  haveI := Ef.additive
  haveI := Ef.presLim
  haveI := Ef.presColim

  obtain ⟨κ, hκ, hnat⟩ := wc_et_supp_restr_extclass_kernel z z' f D Ef D' γ hγ
  haveI hπ' : Epi (wcEtSuppUnitMap D') := wc_et_supp_unit_epi z' D'
  have hS' : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D')) (wcEtSuppUnitMap D')
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D')) inferInstance hπ'

  obtain ⟨Dj'⟩ := wc_et_zmod_pull_data_exists j' ℓ
  obtain ⟨Dw⟩ := wc_et_zmod_pull_data_exists w ℓ
  obtain ⟨c', hc', hT'⟩ := wc_et_open_compl_ker_transfer z' j' hr' ℓ D' Dj'
  haveI := Dj'.additive
  haveI := Dj'.presLim
  haveI := Dj'.presColim

  have hnatT := wc_et_open_compl_transfer_natural j j' f w hpb.w ℓ D D' Ef Dj Dj' Dw κ c c'
    hκ hc hc' M x₁
  rw [hβ Dw] at hnatT

  have hx0 : (Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mapExactFunctor Ef.Φ x₁).comp
      (Abelian.Ext.mk₀ Ef.μ.hom) (add_zero M)) (zero_add M) = 0 := by
    refine (hT' M).1 ?_
    refine hnatT.trans ?_
    show (0 : wcEtZModExt U' ℓ M) = (Abelian.Ext.mk₀ c').comp ((Abelian.Ext.mapExactFunctor Dj'.Φ
      (0 : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D')) (SheafOfModules.unit (wcEtZModRing P' ℓ)) M)).comp
      (Abelian.Ext.mk₀ Dj'.μ.hom) (add_zero M)) (zero_add M)
    rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]

  rw [← hx₁]
  refine (hnat hS hS' M x₁).trans ?_
  rw [hx0, Abelian.Ext.comp_zero]

theorem wc_et_punct_high_base : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin 1) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (n : ℕ), 2 ≤ n → ∀ (α : wcEtZModExt (U : Scheme.{u}) ℓ n), wcEtPcLocDies (U.ι ≫ p) ℓ n α :=
by
  classical
  intro K _ _ ℓ _ hℓ S fS m _ P p q z0 hP hz0p hz0q U hU n hn α

  have hmul : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n) (a b c : ℕ)
      (hc : a + b = c) (x : wcEtZModExt S n a) (y : wcEtZModExt S n b),
      wcEtPull D c (wcEtZModCup S n a b c hc x y) =
        wcEtZModCup S' n a b c hc (wcEtPull D a x) (wcEtPull D b y) := by
    intro S S' g n D a b c hc x y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hc)).comp (Abelian.Ext.mk₀ D.μ.hom)
          (add_zero c)) (zero_add c) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        (zero_add a)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) hc
    rw [Abelian.Ext.mapExactFunctor_comp]
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) (zero_add b) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b) := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.hom) (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (add_zero 0) (zero_add b) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    symm
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (zero_add a) hc (by omega),
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x) (Abelian.Ext.mk₀ D.μ.hom)
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (add_zero a) (zero_add b) (by omega),
      e1,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x)
        (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) hc (add_zero b)
        (by omega)]

  haveI hoc : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K))) :=
    IsClosedImmersion.spec_of_surjective _
      (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ a⟩)
  let U₀ : (Spec (.of (MvPolynomial (Fin 1) K))).Opens :=
    ⟨(Set.range (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K))))ᶜ,
      (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K))).isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hU₀ : (U₀ : Set (Spec (.of (MvPolynomial (Fin 1) K)))) = (Set.range (Spec.map
      (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K))))ᶜ := rfl
  have hoa : Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K))) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap]
    simp
  have hz1sq : IsPullback z0 fS q (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K))) := by
    refine IsPullback.of_right ?_ hz0q hP
    rw [hz0p, hoa]
    exact IsPullback.id_horiz fS
  have hrange : Set.range (U.ι ≫ q) ⊆ Set.range U₀.ι := by
    rw [Scheme.Opens.range_ι, hU₀]
    rintro _ ⟨y, rfl⟩ ⟨t, ht⟩
    rw [Scheme.Hom.comp_apply] at ht
    obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := q)
      (g := Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K)))
      (U.ι y) t ht.symm
    have hmemU : U.ι y ∈ (U : Set P) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨y, rfl⟩
    rw [hU] at hmemU
    have h1 : (hz1sq.isoPullback.inv ≫ z0) τ = U.ι y := by
      rw [hz1sq.isoPullback_inv_fst, hτ]
    rw [Scheme.Hom.comp_apply] at h1
    exact hmemU ⟨_, h1⟩
  let pr : (U : Scheme.{u}) ⟶ (U₀ : Scheme.{u}) := IsOpenImmersion.lift U₀.ι (U.ι ≫ q) hrange
  have hpr : pr ≫ U₀.ι = U.ι ≫ q := IsOpenImmersion.lift_fac U₀.ι (U.ι ≫ q) hrange

  have hU₀sq := wc_punct_bundle_restrict_isPullback K S fS 1 P p q z0 hP hz0p hz0q U hU U₀ hU₀
    pr hpr
  obtain ⟨e, he⟩ := wc_punct_line_laurent_iso K U₀ hU₀
  have hQ : IsPullback (U.ι ≫ p) (pr ≫ e.hom) fS
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) := by
    refine IsPullback.of_iso hU₀sq (Iso.refl _) (Iso.refl _) e (Iso.refl _) ?_ ?_ ?_ ?_
    · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
    · simp only [Iso.refl_hom, Category.id_comp]
    · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
    · rw [Iso.refl_hom, Category.comp_id]
      exact he.symm

  obtain ⟨κ, hκ⟩ := wc_et_gm_kunneth_surj K ℓ hℓ
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  have hk : 1 ≤ k := by omega
  obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists (U.ι ≫ p) ℓ
  obtain ⟨Dt⟩ := wc_et_zmod_pull_data_exists (pr ≫ e.hom) ℓ
  obtain ⟨γ0, γ1, hα⟩ := (hκ S fS m _ (U.ι ≫ p) (pr ≫ e.hom) hQ Dr Dt).2 k α

  intro x
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  obtain ⟨S0, s0, hs0, ⟨x0, hx0⟩, h0⟩ :=
    wc_et_zmodext_pos_locally_zero S ℓ hℓ0 (k + 1) (by omega) γ0 x
  haveI : Etale s0 := hs0
  obtain ⟨D0⟩ := wc_et_zmod_pull_data_exists s0 ℓ
  obtain ⟨S2, s2, hs2, ⟨y, hy⟩, h2⟩ :=
    wc_et_zmodext_pos_locally_zero S0 ℓ hℓ0 k hk (wcEtPull D0 k γ1) x0
  haveI : Etale s2 := hs2
  refine ⟨S2, s2 ≫ s0, inferInstance, ⟨y, by rw [Scheme.Hom.comp_apply, hy, hx0]⟩, ?_⟩
  intro Y' h' w' hsq D
  obtain ⟨Ds2⟩ := wc_et_zmod_pull_data_exists s2 ℓ
  obtain ⟨Ds'⟩ := wc_et_zmod_pull_data_exists (s2 ≫ s0) ℓ
  obtain ⟨Dh'⟩ := wc_et_zmod_pull_data_exists h' ℓ
  obtain ⟨Dwr⟩ := wc_et_zmod_pull_data_exists (w' ≫ U.ι ≫ p) ℓ
  have E0 : wcEtPull Ds' (k + 1) γ0 = 0 := by
    rw [wc_et_pull_comp s0 s2 (s2 ≫ s0) rfl D0 Ds2 Ds' (k + 1) γ0, h0 D0, map_zero]
  have E1 : wcEtPull Ds' k γ1 = 0 := by
    rw [wc_et_pull_comp s0 s2 (s2 ≫ s0) rfl D0 Ds2 Ds' k γ1]
    exact h2 Ds2
  have E3 : ∀ (i : ℕ) (β : wcEtZModExt S ℓ i),
      wcEtPull D i (wcEtPull Dr i β) = wcEtPull Dh' i (wcEtPull Ds' i β) := by
    intro i β
    rw [← wc_et_pull_comp (U.ι ≫ p) w' (w' ≫ U.ι ≫ p) rfl Dr D Dwr i β,
      wc_et_pull_comp (s2 ≫ s0) h' (w' ≫ U.ι ≫ p) hsq.w.symm Ds' Dh' Dwr i β]
  rw [hα, map_add, hmul D k 1 (k + 1) rfl, E3, E3, E0, E1, map_zero, map_zero, map_zero,
    AddMonoidHom.zero_apply, add_zero]

theorem wc_et_punct_cover_high_local_surj : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (c' : ℕ), 1 ≤ c' → (∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c') K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (n : ℕ), 2 * c' ≤ n → ∀ (α : wcEtZModExt (U : Scheme.{u}) ℓ n), wcEtPcLocDies (U.ι ≫ p) ℓ n α) → ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (n : ℕ), 2 * (c' + 1) ≤ n → wcEtPcMVSurj (U.ι ≫ p) ℓ (wcEtPcCovA q U) (wcEtPcCovB q U) (n - 1) :=
by
  classical
  intro K _ _ ℓ _ hℓ c' hc' hHigh S fS m _ P p q z0 hP hz0p hz0q U hU n hn

  have hmul : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n) (a b c : ℕ)
      (hc : a + b = c) (x : wcEtZModExt S n a) (y : wcEtZModExt S n b),
      wcEtPull D c (wcEtZModCup S n a b c hc x y) =
        wcEtZModCup S' n a b c hc (wcEtPull D a x) (wcEtPull D b y) := by
    intro S S' g n D a b c hc x y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hc)).comp (Abelian.Ext.mk₀ D.μ.hom)
          (add_zero c)) (zero_add c) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        (zero_add a)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) hc
    rw [Abelian.Ext.mapExactFunctor_comp]
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) (zero_add b) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b) := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.hom) (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (add_zero 0) (zero_add b) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    symm
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (zero_add a) hc (by omega),
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x) (Abelian.Ext.mk₀ D.μ.hom)
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (add_zero a) (zero_add b) (by omega),
      e1,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x)
        (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) hc (add_zero b)
        (by omega)]

  have hres : ∀ {Y1 Y2 : Scheme.{u}} (w2 : Y2 ⟶ Y1) {O O' : Y1.Opens} (h : O ≤ O')
      (h' : w2 ⁻¹ᵁ O ≤ w2 ⁻¹ᵁ O'), Y2.homOfLE h' ≫ w2 ∣_ O' = w2 ∣_ O ≫ Y1.homOfLE h := by
    intro Y1 Y2 w2 O O' h h'
    rw [← cancel_mono O'.ι]
    simp only [Category.assoc, morphismRestrict_ι, Scheme.homOfLE_ι]
    rw [← Category.assoc, Scheme.homOfLE_ι]

  have hsmA : SmoothOfRelativeDimension c'
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) := by
    have h1 : Algebra.IsStandardSmoothOfRelativeDimension c' K (MvPolynomial (Fin c') K) := by
      have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K (Fin c')
      rwa [Nat.card_fin] at this
    have h2 : RingHom.IsStandardSmoothOfRelativeDimension c'
        (algebraMap K (MvPolynomial (Fin c') K)) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap c').mpr h1
    exact (HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension c')).mpr
      (RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _ h2)
  obtain ⟨κ, hκ⟩ := wc_et_gm_kunneth_surj K ℓ hℓ

  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  rw [Nat.add_sub_cancel]
  intro S1 s1 hs1 Y1 h1 w1 hY1 γ x
  have hVA : w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) ≤ w1 ⁻¹ᵁ wcEtPcCovA q U := fun _ hy => hy.1
  have hVB : w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) ≤ w1 ⁻¹ᵁ wcEtPcCovB q U := fun _ hy => hy.2

  suffices hsuff : ∃ (a1 : wcEtZModExt ((w1 ⁻¹ᵁ wcEtPcCovA q U : Y1.Opens) : Scheme.{u}) ℓ k)
      (b1 : wcEtZModExt ((w1 ⁻¹ᵁ wcEtPcCovB q U : Y1.Opens) : Scheme.{u}) ℓ k)
      (S2 : Scheme.{u}) (s2 : S2 ⟶ S1), Etale s2 ∧ x ∈ Set.range s2 ∧
      ∀ (Y2 : Scheme.{u}) (h2 : Y2 ⟶ S2) (w2 : Y2 ⟶ Y1), IsPullback w2 h2 h1 s2 →
      ∀ (Dγ : wcEtPullData (w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))) ℓ)
        (DA : wcEtPullData (Y1.homOfLE hVA) ℓ) (DB : wcEtPullData (Y1.homOfLE hVB) ℓ),
      wcEtPull Dγ k γ = wcEtPull Dγ k (wcEtPull DA k a1 + wcEtPull DB k b1) by
    obtain ⟨a1, b1, S2, s2, hs2, hx, hall⟩ := hsuff
    refine ⟨S2, s2, hs2, hx, fun Y2 h2 w2 hY2 => ?_⟩
    obtain ⟨DwA⟩ := wc_et_zmod_pull_data_exists (w2 ∣_ (w1 ⁻¹ᵁ wcEtPcCovA q U)) ℓ
    obtain ⟨DwB⟩ := wc_et_zmod_pull_data_exists (w2 ∣_ (w1 ⁻¹ᵁ wcEtPcCovB q U)) ℓ
    obtain ⟨DA⟩ := wc_et_zmod_pull_data_exists (Y1.homOfLE hVA) ℓ
    obtain ⟨DB⟩ := wc_et_zmod_pull_data_exists (Y1.homOfLE hVB) ℓ
    obtain ⟨DcA⟩ := wc_et_zmod_pull_data_exists
      (w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)) ≫ Y1.homOfLE hVA) ℓ
    obtain ⟨DcB⟩ := wc_et_zmod_pull_data_exists
      (w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)) ≫ Y1.homOfLE hVB) ℓ
    refine ⟨wcEtPull DwA k a1, wcEtPull DwB k b1, fun Dγ Da Db => ?_⟩
    rw [hall Y2 h2 w2 hY2 Dγ DA DB, map_add, ← wc_et_pull_comp _ _ _ rfl DA Dγ DcA,
      ← wc_et_pull_comp _ _ _ rfl DB Dγ DcB,
      wc_et_pull_comp _ _ _ (hres w2 hVA (fun _ hy => hy.1)) DwA Da DcA,
      wc_et_pull_comp _ _ _ (hres w2 hVB (fun _ hy => hy.2)) DwB Db DcB]

  obtain ⟨P', p', q', z0', U', rab, tab, bB, tA, hP', hz0p', hz0q', hU', hsq, hrab, hbB, htA⟩ :=
    wc_et_pc_cover_charts K S fS c' P p q z0 hP hz0p hz0q U hU S1 s1 Y1 h1 w1 hY1
  haveI := hs1
  haveI i1 : SmoothOfRelativeDimension (0 + m) (s1 ≫ fS) := inferInstance
  haveI i2 : SmoothOfRelativeDimension c' p' :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension c') hP'.flip hsmA
  haveI i3 : SmoothOfRelativeDimension (c' + (0 + m)) (p' ≫ s1 ≫ fS) := inferInstance
  haveI i4 : SmoothOfRelativeDimension (0 + (c' + (0 + m))) (U'.ι ≫ p' ≫ s1 ≫ fS) :=
    inferInstance
  obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists rab ℓ
  obtain ⟨Dt⟩ := wc_et_zmod_pull_data_exists tab ℓ
  obtain ⟨DbB⟩ := wc_et_zmod_pull_data_exists bB ℓ
  have hK := hκ (U' : Scheme.{u}) (U'.ι ≫ p' ≫ s1 ≫ fS) (0 + (c' + (0 + m))) _ rab tab hsq Dr Dt
  obtain _ | _ | j := k
  · exfalso; omega
  · exfalso; omega
  ·
    obtain ⟨γ0, γ1, hγ⟩ := hK.2 (j + 1) γ
    obtain ⟨S2, s2, hs2, hx, hkill⟩ := hHigh S1 (s1 ≫ fS) (0 + m) P' p' q' z0' hP' hz0p' hz0q'
      U' hU' (j + 1) (by omega) γ1 x
    refine ⟨0, wcEtPull DbB (j + 1 + 1) γ0, S2, s2, hs2, hx, fun Y2 h2 w2 hY2 Dγ DA DB => ?_⟩
    have hz : wcEtPull Dγ (j + 1) (wcEtPull Dr (j + 1) γ1) = 0 := by
      have hZ := IsPullback.of_hasPullback (U'.ι ≫ p') s2
      have hw : (w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))) ≫ rab ≫ U'.ι ≫ p' =
          (w2 ⁻¹ᵁ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))).ι ≫ h2 ≫ s2 := by
        rw [hrab, morphismRestrict_ι_assoc, hY2.w]
      obtain ⟨φ, hφ⟩ : ∃ φ : ((w2 ⁻¹ᵁ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)) : Y2.Opens) :
          Scheme.{u}) ⟶ Limits.pullback (U'.ι ≫ p') s2,
          φ ≫ Limits.pullback.fst (U'.ι ≫ p') s2 =
            (w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))) ≫ rab :=
        ⟨Limits.pullback.lift _ ((w2 ⁻¹ᵁ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))).ι ≫ h2)
          (by simpa only [Category.assoc] using hw), Limits.pullback.lift_fst _ _ _⟩
      obtain ⟨Dfst⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst (U'.ι ≫ p') s2) ℓ
      obtain ⟨Dφ⟩ := wc_et_zmod_pull_data_exists φ ℓ
      obtain ⟨Dc⟩ := wc_et_zmod_pull_data_exists
        ((w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))) ≫ rab) ℓ
      rw [← wc_et_pull_comp _ _ _ rfl Dr Dγ Dc, wc_et_pull_comp _ _ _ hφ Dfst Dφ Dc,
        hkill _ (Limits.pullback.snd (U'.ι ≫ p') s2) (Limits.pullback.fst (U'.ι ≫ p') s2) hZ Dfst,
        map_zero]
    rw [map_zero, zero_add, ← wc_et_pull_comp bB _ rab hbB DbB DB Dr, hγ, map_add, hmul Dγ, hz,
      map_zero, AddMonoidHom.zero_apply, add_zero]

theorem wc_et_punct_high_local_death : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (c : ℕ), 1 ≤ c → ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (n : ℕ), 2 * c ≤ n → ∀ (α : wcEtZModExt (U : Scheme.{u}) ℓ n) (x : S), ∃ (S' : Scheme.{u}) (s' : S' ⟶ S), Etale s' ∧ x ∈ Set.range s' ∧ ∀ (Y' : Scheme.{u}) (h' : Y' ⟶ S') (w' : Y' ⟶ (U : Scheme.{u})), IsPullback w' h' (U.ι ≫ p) s' → ∀ (D : wcEtPullData w' ℓ), wcEtPull D n α = 0 :=
by
  classical
  intro K _ _ ℓ _ hℓ c hc
  have hcore : ∀ c0 : ℕ, 1 ≤ c0 → ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c0) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c0) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c0) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (n : ℕ), 2 * c0 ≤ n → ∀ (α : wcEtZModExt (U : Scheme.{u}) ℓ n), wcEtPcLocDies (U.ι ≫ p) ℓ n α := by
    intro c0 hc0
    induction c0, hc0 using Nat.le_induction with
    | base =>
      intro S1 fS1 m1 _ P1 p1 q1 z1 hP1 hz1p hz1q U1 hU1 n1 hn1 α1
      exact wc_et_punct_high_base K ℓ hℓ S1 fS1 m1 P1 p1 q1 z1 hP1 hz1p hz1q U1 hU1 n1 (by omega) α1
    | succ c' hc' ih =>
      intro S1 fS1 m1 _ P1 p1 q1 z1 hP1 hz1p hz1q U1 hU1 n1 hn1 α1
      have hoa : Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) = 𝟙 _ := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap]
        simp
      have hz1sq : IsPullback z1 fS1 q1 (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K))) := by
        refine IsPullback.of_right ?_ hz1q hP1
        rw [hz1p, hoa]
        exact IsPullback.id_horiz fS1
      have hsup : wcEtPcCovA q1 U1 ⊔ wcEtPcCovB q1 U1 = ⊤ := by
        rw [eq_top_iff]
        intro y _
        rw [TopologicalSpace.Opens.mem_sup]
        by_contra hcon
        rw [not_or] at hcon
        obtain ⟨hyA, hyB⟩ := hcon
        have hX : ∀ i : Fin (c' + 1),
            (MvPolynomial.X i : MvPolynomial (Fin (c' + 1)) K) ∈ ((U1.ι ≫ q1) y).asIdeal := by
          intro i
          by_contra hi
          rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨j, rfl⟩
          · exact hyA hi
          · apply hyB
            exact (TopologicalSpace.Opens.mem_iSup (s := fun i : Fin c' =>
              PrimeSpectrum.basicOpen (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K))
              (x := (U1.ι ≫ q1) y)).mpr ⟨j, hi⟩
        have hker : RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K) ≤
            ((U1.ι ≫ q1) y).asIdeal := by
          intro f hf
          have hspan : f ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (c' + 1)))) := by
            rw [MvPolynomial.mem_ideal_span_X_image]
            intro mm hmm
            have hm0 : mm ≠ 0 := by
              rintro rfl
              rw [RingHom.mem_ker, MvPolynomial.constantCoeff_eq] at hf
              exact (MvPolynomial.mem_support_iff.mp hmm) hf
            obtain ⟨i, hi⟩ : ∃ i, mm i ≠ 0 := by
              by_contra hcon
              exact hm0 (Finsupp.ext fun a => by
                by_contra ha
                exact hcon ⟨a, ha⟩)
            exact ⟨i, Set.mem_univ _, hi⟩
          refine (Ideal.span_le.mpr ?_) hspan
          rintro _ ⟨i, -, rfl⟩
          exact hX i
        have hmax := RingHom.ker_isMaximal_of_surjective
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)
          (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ a⟩)
        have e1 := hmax.eq_of_le ((U1.ι ≫ q1) y).isPrime.ne_top hker
        have e2 := hmax.eq_of_le (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K))
            (fS1 (p1 (U1.ι y)))).isPrime.ne_top (fun f hf => by
              show MvPolynomial.constantCoeff f ∈ (fS1 (p1 (U1.ι y))).asIdeal
              rw [RingHom.mem_ker.mp hf]
              exact Ideal.zero_mem _)
        have hzo : q1 (U1.ι y) = Spec.map (CommRingCat.ofHom
            (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K))
              (fS1 (p1 (U1.ι y))) := by
          rw [← Scheme.Hom.comp_apply U1.ι q1 y]
          exact PrimeSpectrum.ext (e1.symm.trans e2)
        obtain ⟨t, ht, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := q1)
          (g := Spec.map (CommRingCat.ofHom
            (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)))
          (U1.ι y) (fS1 (p1 (U1.ι y))) hzo
        have hmemU : U1.ι y ∈ (U1 : Set P1) := by
          rw [← Scheme.Opens.range_ι]
          exact ⟨y, rfl⟩
        rw [hU1] at hmemU
        have h1 : (hz1sq.isoPullback.inv ≫ z1) t = U1.ι y := by
          rw [hz1sq.isoPullback_inv_fst, ht]
        rw [Scheme.Hom.comp_apply] at h1
        exact hmemU ⟨_, h1⟩
      obtain ⟨hA, hB⟩ := wc_et_punct_cover_restr_dies K S1 fS1 m1 c' P1 p1 q1 z1 hP1 hz1p hz1q hc'
        U1 hU1 ℓ hℓ n1 (by omega) α1
      exact wc_et_zariski_mv_local_kill (U1.ι ≫ p1) ℓ (wcEtPcCovA q1 U1) (wcEtPcCovB q1 U1) hsup
        n1 (by omega) α1 hA hB
        (wc_et_punct_cover_high_local_surj K ℓ hℓ c' hc' ih S1 fS1 m1 P1 p1 q1 z1 hP1 hz1p hz1q
          U1 hU1 n1 hn1)
  intro S fS m _ P p q z0 hP hz0p hz0q U hU n hn α x
  exact hcore c hc S fS m P p q z0 hP hz0p hz0q U hU n hn α x

theorem wc_et_bundle_zero_supp_local_death : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (c M : ℕ), 1 ≤ c → 2 * c < M → ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → ∀ (D0 : wcEtPullData z0 ℓ) (θ : wcEtSuppExt D0 M) (s : S), ∃ (V : Scheme.{u}) (v : V ⟶ S), Etale v ∧ s ∈ Set.range v ∧ ∀ (PV : Scheme.{u}) (a : PV ⟶ P) (pV : PV ⟶ V), IsPullback a pV p v → ∀ (z0V : V ⟶ PV), IsPullback v z0V z0 a → ∀ (D' : wcEtPullData z0V ℓ) (Ea : wcEtPullData a ℓ) (γ : wcEtSuppObj D' ⟶ Ea.Φ.obj (wcEtSuppObj D0)), wcEtSuppUnitMap D' ≫ γ = Ea.μ.inv ≫ Ea.Φ.map (wcEtSuppUnitMap D0) → wcEtSuppRestr D0 Ea D' γ M θ = 0 :=
by
  classical
  intro K _ _ ℓ _ hℓK c M hc hM S fS m _ P p q z0 hP hz0p hz0q D0 θ s
  obtain ⟨M', rfl⟩ : ∃ M', M = M' + 1 := ⟨M - 1, by omega⟩
  have hM' : 2 * c ≤ M' := by omega
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero

  have hR : ∀ {X Y Y' X' : Scheme.{u}} {i : X ⟶ Y} {f : Y' ⟶ Y} {i' : X' ⟶ Y'} {n : ℕ}
      (D : wcEtPullData i n) (Df : wcEtPullData f n) (D' : wcEtPullData i' n)
      (γ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D)),
      wcEtSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D) →
      ∀ (k : ℕ) (θ : wcEtSuppExt D k),
      wcEtSuppClass D' k (wcEtSuppRestr D Df D' γ k θ) = wcEtPull Df k (wcEtSuppClass D k θ) := by
    intro X Y Y' X' i f i' n D Df D' γ hγ k θ
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y' n)) := HasExt.standard _
    haveI := Df.additive
    haveI := Df.presLim
    haveI := Df.presColim
    show (Abelian.Ext.mk₀ (wcEtSuppUnitMap D')).comp ((Abelian.Ext.mk₀ γ).comp
        ((Abelian.Ext.mapExactFunctor Df.Φ θ).comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero k))
        (zero_add k)) (zero_add k) =
      (Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ
        ((Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp θ (zero_add k))).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero k)) (zero_add k)
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hγ, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← Abelian.Ext.mk₀_comp_mk₀_assoc]

  haveI hsepp : IsSeparated p :=
    MorphismProperty.of_isPullback (P := @IsSeparated) hP.flip inferInstance
  haveI : IsClosedImmersion (z0 ≫ p) := by rw [hz0p]; infer_instance
  haveI hz0cl : IsClosedImmersion z0 := IsClosedImmersion.of_comp z0 p

  obtain ⟨Dp⟩ := wc_et_zmod_pull_data_exists p ℓ
  obtain ⟨η₀, hη₀⟩ := (wc_et_pull_affine_bundle_bijective K S fS m c P p q hP ℓ hℓK Dp
    (M' + 1)).2 (wcEtSuppClass D0 (M' + 1) θ)

  obtain ⟨V₁, v₁, hv₁, hsV₁, h₁⟩ :=
    wc_et_zmodext_pos_locally_zero S ℓ hℓ0 (M' + 1) (by omega) η₀ s
  haveI : Etale v₁ := hv₁
  obtain ⟨s₁, hs₁⟩ := hsV₁

  obtain ⟨P₁, a₁, p₁, hP₁₀⟩ : ∃ (P₁ : Scheme.{u}) (a₁ : P₁ ⟶ P) (p₁ : P₁ ⟶ V₁),
      IsPullback a₁ p₁ p v₁ := ⟨_, _, _, IsPullback.of_hasPullback p v₁⟩
  have hP₁ : IsPullback p₁ (a₁ ≫ q) (v₁ ≫ fS)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) :=
    IsPullback.paste_vert hP₁₀.flip hP
  obtain ⟨z01, hz01a, hz01p⟩ : ∃ z01 : V₁ ⟶ P₁, z01 ≫ a₁ = v₁ ≫ z0 ∧ z01 ≫ p₁ = 𝟙 V₁ :=
    ⟨hP₁₀.lift (v₁ ≫ z0) (𝟙 V₁) (by rw [Category.assoc, hz0p, Category.comp_id, Category.id_comp]),
      hP₁₀.lift_fst _ _ _, hP₁₀.lift_snd _ _ _⟩
  have hz01q : z01 ≫ (a₁ ≫ q) = (v₁ ≫ fS) ≫ Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) := by
    rw [← Category.assoc, hz01a, Category.assoc, hz0q, Category.assoc]
  have hsq₁ : IsPullback z01 v₁ a₁ z0 := by
    refine IsPullback.of_right ?_ hz01a hP₁₀.flip
    rw [hz01p, hz0p]
    exact IsPullback.id_horiz v₁
  haveI hz01cl : IsClosedImmersion z01 :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq₁.flip inferInstance
  haveI hsm1 : SmoothOfRelativeDimension m (v₁ ≫ fS) := by
    have h0 : SmoothOfRelativeDimension (0 + m) (v₁ ≫ fS) := inferInstance
    rwa [zero_add] at h0
  obtain ⟨U₁, hU₁⟩ : ∃ U₁ : P₁.Opens, (U₁ : Set P₁) = (Set.range z01)ᶜ :=
    ⟨⟨_, z01.isClosedEmbedding.isClosed_range.isOpen_compl⟩, rfl⟩
  have hU₁r : Set.range U₁.ι = (Set.range z01)ᶜ := (Scheme.Opens.range_ι U₁).trans hU₁

  obtain ⟨D₁⟩ := wc_et_zmod_pull_data_exists z01 ℓ
  obtain ⟨E₁⟩ := wc_et_zmod_pull_data_exists a₁ ℓ
  obtain ⟨γ₁, hγ₁, -⟩ := wc_et_closed_supp_base_change z0 a₁ z01 v₁ hsq₁.flip D0 E₁ D₁
  have hcls : wcEtSuppClass D₁ (M' + 1) (wcEtSuppRestr D0 E₁ D₁ γ₁ (M' + 1) θ) = 0 := by
    rw [hR D0 E₁ D₁ γ₁ hγ₁, ← hη₀]
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists (a₁ ≫ p) ℓ
    obtain ⟨Dv⟩ := wc_et_zmod_pull_data_exists v₁ ℓ
    obtain ⟨Dq⟩ := wc_et_zmod_pull_data_exists p₁ ℓ
    rw [← wc_et_pull_comp p a₁ (a₁ ≫ p) rfl Dp E₁ Dk,
      wc_et_pull_comp v₁ p₁ (a₁ ≫ p) hP₁₀.w.symm Dv Dq Dk, h₁ Dv, map_zero]

  obtain ⟨β, hC⟩ := wc_et_supp_class_zero_boundary z01 U₁.ι hU₁r ℓ D₁ M' _ hcls

  obtain ⟨V₂, v₂, hv₂, hsV₂, hH⟩ := wc_et_punct_high_local_death K ℓ hℓK c hc V₁ (v₁ ≫ fS) m
    P₁ p₁ (a₁ ≫ q) z01 hP₁ hz01p hz01q U₁ hU₁ M' hM' β s₁
  haveI : Etale v₂ := hv₂
  obtain ⟨t, ht⟩ := hsV₂

  refine ⟨V₂, v₂ ≫ v₁, inferInstance, ⟨t, by rw [Scheme.Hom.comp_apply, ht, hs₁]⟩, ?_⟩

  intro PV a pV hpb z0V hz D' Ea γ hγ
  obtain ⟨b, hba, hbp⟩ : ∃ b : PV ⟶ P₁, b ≫ a₁ = a ∧ b ≫ p₁ = pV ≫ v₂ :=
    ⟨hP₁₀.lift a (pV ≫ v₂) (by rw [hpb.w, Category.assoc]), hP₁₀.lift_fst _ _ _,
      hP₁₀.lift_snd _ _ _⟩
  have hb : IsPullback b pV p₁ v₂ := IsPullback.of_right (by rw [hba]; exact hpb) hbp hP₁₀
  haveI : Etale b := MorphismProperty.of_isPullback (P := @Etale) hb.flip inferInstance
  have hg1 : (z0V ≫ pV ≫ v₂) ≫ v₁ = v₂ ≫ v₁ :=
    calc (z0V ≫ pV ≫ v₂) ≫ v₁ = z0V ≫ (pV ≫ (v₂ ≫ v₁)) := by simp only [Category.assoc]
      _ = z0V ≫ (a ≫ p) := by rw [hpb.w]
      _ = (z0V ≫ a) ≫ p := (Category.assoc _ _ _).symm
      _ = ((v₂ ≫ v₁) ≫ z0) ≫ p := by rw [hz.w]
      _ = (v₂ ≫ v₁) ≫ (z0 ≫ p) := Category.assoc _ _ _
      _ = v₂ ≫ v₁ := by rw [hz0p, Category.comp_id]
  have hg2 : (z0V ≫ pV ≫ v₂) ≫ z01 = z0V ≫ b := by
    refine hP₁₀.hom_ext ?_ ?_
    · calc ((z0V ≫ pV ≫ v₂) ≫ z01) ≫ a₁ = (z0V ≫ pV ≫ v₂) ≫ (z01 ≫ a₁) := Category.assoc _ _ _
        _ = (z0V ≫ pV ≫ v₂) ≫ (v₁ ≫ z0) := by rw [hz01a]
        _ = ((z0V ≫ pV ≫ v₂) ≫ v₁) ≫ z0 := (Category.assoc _ _ _).symm
        _ = (v₂ ≫ v₁) ≫ z0 := by rw [hg1]
        _ = z0V ≫ a := hz.w
        _ = z0V ≫ (b ≫ a₁) := by rw [hba]
        _ = (z0V ≫ b) ≫ a₁ := (Category.assoc _ _ _).symm
    · calc ((z0V ≫ pV ≫ v₂) ≫ z01) ≫ p₁ = (z0V ≫ pV ≫ v₂) ≫ (z01 ≫ p₁) := Category.assoc _ _ _
        _ = z0V ≫ pV ≫ v₂ := by rw [hz01p, Category.comp_id]
        _ = z0V ≫ (b ≫ p₁) := by rw [hbp]
        _ = (z0V ≫ b) ≫ p₁ := (Category.assoc _ _ _).symm
  have hgz : IsPullback (z0V ≫ pV ≫ v₂) z0V z01 b :=
    IsPullback.of_right (by rw [hg1, hba]; exact hz) hg2 hsq₁.flip
  haveI : IsClosedImmersion z0V :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hz inferInstance
  have hU' : IsPullback (Limits.pullback.fst U₁.ι b) (Limits.pullback.snd U₁.ι b) U₁.ι b :=
    IsPullback.of_hasPullback _ _
  have hUV := IsPullback.paste_vert hU' hb
  have hβ := hH _ _ _ hUV
  obtain ⟨Eb⟩ := wc_et_zmod_pull_data_exists b ℓ
  obtain ⟨γb, hγb, hepi⟩ :=
    wc_et_closed_supp_base_change z01 b z0V (z0V ≫ pV ≫ v₂) hgz D₁ Eb D'
  have hkill := hC PV b inferInstance _ _ _ hU' hβ V₂ z0V _ hgz D' Eb γb hγb
  rw [wc_et_supp_restr_comp a₁ b a hba D0 D₁ D' E₁ Eb Ea γ₁ γb γ hγ₁ hγb hγ hepi]
  exact hkill

theorem wc_et_smooth_pair_punct_high_local_death : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n e : ℕ) [SmoothOfRelativeDimension n fX] (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension e (i ≫ fX)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (V : X.Opens), (V : Set X) = (Set.range i)ᶜ → ∀ (k : ℕ), 1 ≤ k → 2 * n ≤ k + 2 * e → ∀ (W : Scheme.{u}) (v : W ⟶ X), Etale v → ∀ (YV : Scheme.{u}) (gV : YV ⟶ W) (w : YV ⟶ (V : Scheme.{u})), IsPullback w gV V.ι v → ∀ (α : wcEtZModExt YV ℓ k) (x : W), ∃ (W' : Scheme.{u}) (v' : W' ⟶ W), Etale v' ∧ x ∈ Set.range v' ∧ ∀ (YV' : Scheme.{u}) (gV' : YV' ⟶ W') (w' : YV' ⟶ YV), IsPullback w' gV' gV v' → ∀ (Dw' : wcEtPullData w' ℓ), wcEtPull Dw' k α = 0 :=
by
  intro K _ _ X fX n e _ Z i _ _ ℓ _ hℓK V hV k hk1 hk2 W v hv YV gV w hpb α x
  haveI : Etale v := hv
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  haveI hgVo : IsOpenImmersion gV :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hpb inferInstance
  have hptw : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
      fst ≫ f = snd ≫ g → ∀ t : P, f (fst t) = g (snd t) := by
    intro P A B S fst snd f g h t
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, h]
  have hpts : ∀ {P A B S : Scheme.{u}} {fst : P ⟶ A} {snd : P ⟶ B} {f : A ⟶ S} {g : B ⟶ S},
      IsPullback fst snd f g → ∀ (a : A) (b : B), f a = g b → ∃ t : P, fst t = a ∧ snd t = b := by
    intro P A B S fst snd f g h a b hab
    obtain ⟨t, h1, h2⟩ := Scheme.Pullback.exists_preimage_pullback a b hab
    refine ⟨h.isoPullback.inv t, ?_, ?_⟩
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]; exact h1
    · rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_snd]; exact h2
  by_cases hx : v x ∈ Set.range i
  · obtain ⟨z0, hz0⟩ := hx
    obtain ⟨hlt, heq⟩ := wc_smooth_closed_reldim_cases K X fX n e Z i
    rcases lt_trichotomy e n with hen | hen | hen
    ·
      obtain ⟨c, hc⟩ : ∃ c, c = n - e := ⟨_, rfl⟩
      have hc1 : 1 ≤ c := by omega
      have hcn : c ≤ n := by omega
      have hnce : n - c = e := by omega
      obtain ⟨ZW, gZ, iW, hZpb⟩ : ∃ (ZW : Scheme.{u}) (gZ : ZW ⟶ Z) (iW : ZW ⟶ W),
          IsPullback gZ iW i v := ⟨_, _, _, IsPullback.of_hasPullback i v⟩
      haveI : IsClosedImmersion iW :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion) hZpb inferInstance
      haveI : Etale gZ := MorphismProperty.of_isPullback (P := @Etale) hZpb.flip inferInstance
      haveI hsmW : SmoothOfRelativeDimension n (v ≫ fX) := by
        have h : SmoothOfRelativeDimension (0 + n) (v ≫ fX) := inferInstance
        rwa [Nat.zero_add] at h
      haveI hsmZ : SmoothOfRelativeDimension (n - c) (iW ≫ v ≫ fX) := by
        have h : SmoothOfRelativeDimension (0 + e) (gZ ≫ i ≫ fX) := inferInstance
        rw [Nat.zero_add, ← Category.assoc, hZpb.w, Category.assoc] at h
        rw [hnce]; exact h
      have hrange : Set.range gV = (Set.range iW)ᶜ := by
        ext y
        constructor
        · rintro ⟨t, rfl⟩ ⟨s, hs⟩
          have h1 : V.ι (w t) ∈ (V : Set X) := by
            rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
          rw [hV] at h1
          apply h1
          refine ⟨gZ s, ?_⟩
          rw [hptw hZpb.w s, hs, ← hptw hpb.w t]
        · intro hy
          have hvy : v y ∈ (V : Set X) := by
            rw [hV]
            rintro ⟨z, hz⟩
            obtain ⟨s, -, hs⟩ := hpts hZpb z y hz
            exact hy ⟨s, hs⟩
          rw [← Scheme.Opens.range_ι] at hvy
          obtain ⟨a, ha⟩ := hvy
          obtain ⟨t, -, ht⟩ := hpts hpb a y ha
          exact ⟨t, ht⟩
      obtain ⟨D⟩ := wc_et_zmod_pull_data_exists iW ℓ
      obtain ⟨θ, hθ⟩ := wc_et_punct_supp_boundary_lift iW gV hrange ℓ D k α
      obtain ⟨z, -, hz2⟩ := hpts hZpb z0 x hz0
      obtain ⟨W', f, hf, hzf, hkill⟩ := wc_et_smooth_pair_supp_ld_of_model K W (v ≫ fX) n c ZW iW
        hc1 hcn ℓ (k + 1)
        (wc_et_bundle_zero_supp_local_death K ℓ hℓK c (k + 1) hc1 (by omega)) D θ z
      haveI : Etale f := hf
      obtain ⟨β, hβ⟩ := hθ W' f hf hkill (Limits.pullback gV f) (Limits.pullback.snd gV f)
        (Limits.pullback.fst gV f) (IsPullback.of_hasPullback gV f)
      obtain ⟨x', hx'⟩ := hzf
      obtain ⟨S'', s'', hs'', hxs'', hdie⟩ := wc_et_zmodext_pos_locally_zero W' ℓ hℓ0 k hk1 β x'
      haveI : Etale s'' := hs''
      refine ⟨S'', s'' ≫ f, inferInstance, ?_, ?_⟩
      · obtain ⟨y, hy⟩ := hxs''
        exact ⟨y, by rw [Scheme.Hom.comp_apply, hy, hx', hz2]⟩
      · intro YV' gV' w' hpb' Dw'
        have hu : w' ≫ gV = (gV' ≫ s'') ≫ f := by rw [hpb'.w, Category.assoc]
        obtain ⟨Dfst⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst gV f) ℓ
        obtain ⟨Dsnd⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd gV f) ℓ
        obtain ⟨Du⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.lift w' (gV' ≫ s'') hu) ℓ
        obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists gV' ℓ
        obtain ⟨Ds⟩ := wc_et_zmod_pull_data_exists s'' ℓ
        obtain ⟨Dgs⟩ := wc_et_zmod_pull_data_exists (gV' ≫ s'') ℓ
        rw [wc_et_pull_comp (Limits.pullback.fst gV f) (Limits.pullback.lift w' (gV' ≫ s'') hu) w'
            (Limits.pullback.lift_fst _ _ _) Dfst Du Dw' k α,
          hβ Dfst Dsnd,
          ← wc_et_pull_comp (Limits.pullback.snd gV f) (Limits.pullback.lift w' (gV' ≫ s'') hu)
            (gV' ≫ s'') (Limits.pullback.lift_snd _ _ _) Dsnd Du Dgs k β,
          wc_et_pull_comp s'' gV' (gV' ≫ s'') rfl Ds Dg Dgs k β, hdie Ds, map_zero]
    ·
      have hop : IsOpen (Set.range i) := heq hen
      let Zo : X.Opens := ⟨Set.range i, hop⟩
      let O : W.Opens := v ⁻¹ᵁ Zo
      have hxO : x ∈ O := show v x ∈ Set.range i from ⟨z0, hz0⟩
      refine ⟨O, O.ι, inferInstance, ⟨⟨x, hxO⟩, rfl⟩, ?_⟩
      intro YV' gV' w' hpb' Dw'
      haveI hE : IsEmpty YV' := ⟨fun y => by
        have hp : O.ι (gV' y) ∈ (O : Set W) := by
          rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
        have h1 : v (O.ι (gV' y)) ∈ Set.range i := hp
        have h2 : O.ι (gV' y) = gV (w' y) := (hptw hpb'.w y).symm
        have h3 : V.ι (w (w' y)) ∈ (V : Set X) := by
          rw [← Scheme.Opens.range_ι]; exact ⟨_, rfl⟩
        rw [hV, hptw hpb.w (w' y), ← h2] at h3
        exact h3 h1⟩
      have hz := wc_et_zmod_modules_zero_of_isEmpty YV' ℓ hE
        (SheafOfModules.unit (wcEtZModRing YV' ℓ))
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing YV' ℓ)) := HasExt.standard _
      calc wcEtPull Dw' k α
          = (wcEtPull Dw' k α).comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero k) :=
            (Abelian.Ext.comp_mk₀_id _).symm
        _ = (wcEtPull Dw' k α).comp (Abelian.Ext.mk₀ 0) (add_zero k) := by
            rw [hz.eq_of_tgt (𝟙 _) 0]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    · exact ((hlt hen).false z0).elim
  ·
    have hxV : v x ∈ (V : Set X) := by rw [hV]; exact hx
    let O : W.Opens := v ⁻¹ᵁ V
    have hxO : x ∈ O := hxV
    let ρ : (O : Scheme.{u}) ⟶ YV := hpb.lift (v ∣_ V) O.ι (morphismRestrict_ι v V)
    have hρ : ρ ≫ gV = O.ι := hpb.lift_snd _ _ _
    obtain ⟨Dρ⟩ := wc_et_zmod_pull_data_exists ρ ℓ
    obtain ⟨S', s', hs', hxs', hdie⟩ :=
      wc_et_zmodext_pos_locally_zero (O : Scheme.{u}) ℓ hℓ0 k hk1 (wcEtPull Dρ k α) ⟨x, hxO⟩
    haveI : Etale s' := hs'
    refine ⟨S', s' ≫ O.ι, inferInstance, ?_, ?_⟩
    · obtain ⟨y, hy⟩ := hxs'
      exact ⟨y, by rw [Scheme.Hom.comp_apply, hy]; rfl⟩
    · intro YV' gV' w' hpb' Dw'
      have hw' : gV' ≫ s' ≫ ρ = w' := by
        rw [← cancel_mono gV, hpb'.w]
        simp only [Category.assoc, hρ]
      obtain ⟨Ds'⟩ := wc_et_zmod_pull_data_exists s' ℓ
      obtain ⟨Dg⟩ := wc_et_zmod_pull_data_exists gV' ℓ
      obtain ⟨Dsρ⟩ := wc_et_zmod_pull_data_exists (s' ≫ ρ) ℓ
      rw [wc_et_pull_comp (s' ≫ ρ) gV' w' hw' Dsρ Dg Dw' k α,
        wc_et_pull_comp ρ s' (s' ≫ ρ) rfl Dρ Ds' Dsρ k α, hdie Ds', map_zero]

theorem wc_et_closed_push_rightAdj_high_vanishing : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [IsSeparated fX] [QuasiCompact fX] (n e : ℕ) [SmoothOfRelativeDimension n fX] (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension e (i ≫ fX)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D : wcEtPullData i ℓ) (R : SheafOfModules.{u+1} (wcEtZModRing X ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) [R.Additive], (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R) → ∀ (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing X ℓ))) (m : ℕ), 2 * n < m + 2 * e → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology m) :=
by
  intro K _ _ X fX _ _ n e _ Z i _ _ ℓ _ hℓK D R _ adj I m hm
  obtain ⟨hlt, heq⟩ := wc_smooth_closed_reldim_cases K X fX n e Z i
  by_cases hne : n < e
  · exact wc_et_zmod_modules_zero_of_isEmpty Z ℓ (hlt hne) _
  · have hen : e ≤ n := Nat.le_of_not_lt hne
    let V : X.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
    refine wc_et_closed_rightAdj_homology_zero_of_open_push i ℓ D R adj I V rfl m (by omega) ?_ ?_
    · intro h1
      exact heq (by omega)
    · intro h2 Dj J
      exact wc_et_push_homology_zero_of_local V.ι ℓ Dj J (m - 1) (by omega)
        (wc_et_smooth_pair_punct_high_local_death K X fX n e Z i ℓ hℓK V rfl (m - 1) (by omega)
          (by omega))

theorem wc_et_sheaf_union_of_cyclic_subsheaves : ∀ (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), ∃ (Λ : Type (u+1)) (_ : SmallCategory Λ) (_ : IsFiltered Λ) (F : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ι : ∀ i, F.obj i ⟶ G), (∀ (i j : Λ) (f : i ⟶ j), F.map f ≫ ι j = ι i) ∧ (∀ i, Mono (ι i)) ∧ (∀ i, ∃ (U : Y.Etale) (e : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F.obj i), IsAffine U.left ∧ Epi e) ∧ ∃ e : Limits.colimit F ≅ G, ∀ i, Limits.colimit.ι F i ≫ e.hom = ι i :=
by
  intro Y G
  classical
  obtain ⟨η, hη, hηnat⟩ := wc_et_free_sheaf_yoneda Y


  have s1 : ∀ (κ : Type (u+1)) [Finite κ] (T : κ → Y.Etale), (∀ k, IsAffine (T k).left) →
      ∀ (s : ∀ k, G.obj.obj (Opposite.op (T k))), ∃ (S : Y.Etale)
        (π : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj S ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G), IsAffine S.left ∧
        (∀ k, ∃ x : ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj S ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.obj (Opposite.op (T k)),
          (π.hom.app (Opposite.op (T k))).hom x = s k) ∧
        ∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : H ⟶ G),
          (∀ k, ∃ y : H.obj.obj (Opposite.op (T k)), (φ.hom.app (Opposite.op (T k))).hom y = s k) →
          ∃ m : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
            (yoneda.obj S ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ H, m ≫ φ = π := by
    intro κ _ T hT s
    obtain ⟨S, ι', hS, ⟨hc⟩⟩ := wc_et_free_sheaf_affine_coprod Y η hη hηnat κ T hT
    choose g hg hgu using fun k => hη (T k) G (s k)
    refine ⟨S, Limits.Cofan.IsColimit.desc hc g, hS, ?_, ?_⟩
    · intro k
      refine ⟨((ι' k).hom.app (Opposite.op (T k))).hom (η (T k)), ?_⟩
      have h1 : ι' k ≫ Limits.Cofan.IsColimit.desc hc g = g k :=
        Limits.Cofan.IsColimit.fac hc g k
      have h2 : ((ι' k ≫ Limits.Cofan.IsColimit.desc hc g).hom.app
          (Opposite.op (T k))).hom (η (T k)) = s k := by
        rw [h1]; exact hg k
      exact h2
    · intro H φ hy
      choose y hy using hy
      choose g' hg' _ using fun k => hη (T k) H (y k)
      refine ⟨Limits.Cofan.IsColimit.desc hc g', ?_⟩
      refine Limits.Cofan.IsColimit.hom_ext hc _ _ (fun k => ?_)
      rw [← Category.assoc, Limits.Cofan.IsColimit.fac, Limits.Cofan.IsColimit.fac]
      refine hgu k (g' k ≫ φ) ?_
      show (φ.hom.app (Opposite.op (T k))).hom
        (((g' k).hom.app (Opposite.op (T k))).hom (η (T k))) = s k
      rw [hg' k]
      exact hy k

  let A := Σ (U : {U : Y.Etale // IsAffine U.left}), G.obj.obj (Opposite.op U.1)

  have hs1 := fun (σ : Finset A) =>
    s1 (↥σ) (fun k => k.1.1.1) (fun k => k.1.1.2) (fun k => k.1.2)
  choose S π hSaff hsurj huniv using hs1

  have hmon : ∀ σ σ' : Finset A, σ ⊆ σ' → ∃ m, m ≫ π σ' = π σ := fun σ σ' h =>
    huniv σ _ (π σ') (fun k => hsurj σ' ⟨k.1, h k.2⟩)

  let I : Finset A → Subobject G := fun σ => Limits.imageSubobject (π σ)
  have hI : Monotone I := by
    intro σ σ' h
    obtain ⟨m, hm⟩ := hmon σ σ' h
    show Limits.imageSubobject (π σ) ≤ Limits.imageSubobject (π σ')
    rw [← hm]
    exact Limits.imageSubobject_comp_le m (π σ')
  let F : Finset A ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
    hI.functor ⋙ Subobject.underlying
  let ι : ∀ σ, F.obj σ ⟶ G := fun σ => (I σ).arrow
  let e : ∀ σ, (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (yoneda.obj (S σ) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F.obj σ :=
    fun σ => Limits.factorThruImageSubobject (π σ)
  have hcompat : ∀ (i j : Finset A) (f : i ⟶ j), F.map f ≫ ι j = ι i := fun i j f =>
    Subobject.underlying_arrow (hI.functor.map f)
  have hmono : ∀ i, Mono (ι i) := fun i =>
    (inferInstance : Mono (Limits.imageSubobject (π i)).arrow)
  have hepi : ∀ i, Epi (e i) := fun i =>
    (inferInstance : Epi (Limits.factorThruImageSubobject (π i)))

  have hexh : ∀ (V : Y.Etale) (s : G.obj.obj (Opposite.op V)), IsAffine V.left →
      ∃ (i : Finset A) (t : (F.obj i).obj.obj (Opposite.op V)),
        ((ι i).hom.app (Opposite.op V)).hom t = s := by
    intro V s hV
    let a : A := ⟨⟨V, hV⟩, s⟩
    obtain ⟨x, hx⟩ := hsurj {a} ⟨a, Finset.mem_singleton_self a⟩
    refine ⟨{a}, ((e {a}).hom.app (Opposite.op V)).hom x, ?_⟩
    have h := congrArg (fun φ => (φ.hom.app (Opposite.op V)).hom x)
      (Limits.imageSubobject_arrow_comp (π {a}))
    exact h.trans hx

  have hLCa : ∀ (V : Y.Etale) (s : G.obj.obj (Opposite.op V)),
      Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (i : Finset A)
        (t : (F.obj i).obj.obj (Opposite.op V')),
        ((ι i).hom.app (Opposite.op V')).hom t = (G.obj.map h.op).hom s) ∈
        Scheme.smallEtaleTopology Y V := by
    intro V s
    refine wc_et_sieve_of_affine_arrows Y V ⊤ _ (GrothendieckTopology.top_mem _ V) ?_
    intro V' h hV' _
    obtain ⟨i, t, ht⟩ := hexh V' ((G.obj.map h.op).hom s) hV'
    exact ⟨V', 𝟙 _, h, ⟨i, t, ht⟩, Category.id_comp _⟩
  have hLCb : ∀ (i : Finset A) (V : Y.Etale) (t : (F.obj i).obj.obj (Opposite.op V)),
      ((ι i).hom.app (Opposite.op V)).hom t = 0 →
      Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (j : Finset A) (f : i ⟶ j),
        ((F.map f).hom.app (Opposite.op V')).hom (((F.obj i).obj.map h.op).hom t) = 0) ∈
        Scheme.smallEtaleTopology Y V := by
    intro i V t ht
    haveI : Mono (ι i) := hmono i
    have hinj : Function.Injective ((ι i).hom.app (Opposite.op V)).hom :=
      (AddCommGrpCat.mono_iff_injective _).mp inferInstance
    have ht0 : t = 0 := hinj (by rw [ht, map_zero])
    refine GrothendieckTopology.superset_covering _ ?_ (GrothendieckTopology.top_mem _ V)
    intro V' h _
    refine ⟨V', 𝟙 _, h, ⟨i, 𝟙 i, ?_⟩, Category.id_comp _⟩
    rw [ht0, map_zero, map_zero]
  obtain ⟨eIso, heIso⟩ := wc_et_local_cocone_colimit_iso Y (Finset A) F G ι hcompat hLCa hLCb
    (wc_et_sheaf_colimit_cocone_local Y (Finset A) F).1
  exact ⟨Finset A, inferInstance, inferInstance, F, ι, hcompat, hmono,
    fun σ => ⟨S σ, e σ, hSaff σ, hepi σ⟩, eIso, heIso⟩

theorem wc_et_cyclic_sheaf_stalk_support : ∀ (Y : Scheme.{u}) (U : Y.Etale) (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (e : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ I), Epi e → ∃ Z : Set U.left, IsClosed Z ∧ ∀ y : Y, (¬ Subsingleton ((wcEtStalk Y y).obj I) ↔ ∃ u ∈ Z, U.hom u = y) :=
by
  classical
  intro Y U I e he
  obtain ⟨g, hg⟩ : ∃ g : I.obj.obj (Opposite.op U), g = (e.hom.app (Opposite.op U)).hom
      (((toSheafify (Scheme.smallEtaleTopology Y)
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op U)).hom
        (FreeAbelianGroup.of (ULift.up (𝟙 U)))) := ⟨_, rfl⟩
  obtain ⟨hOpen, -⟩ := wc_etale_section_vanishing_open Y I U g
  refine ⟨{v : U.left | ∃ (V₁ : Y.Etale) (c : V₁ ⟶ U), v ∈ Set.range c.left ∧
    I.obj.map c.op g = 0}ᶜ, hOpen.isClosed_compl, ?_⟩
  intro y
  constructor
  swap
  · rintro ⟨u, hu, rfl⟩ hS
    exact hu (wc_et_vanish_off_of_stalks I U g u hS)
  intro hns
  by_contra hno
  apply hns
  have hO : ∀ u : U.left, U.hom u = y → ∃ (V₁ : Y.Etale) (c' : V₁ ⟶ U),
      u ∈ Set.range c'.left ∧ I.obj.map c'.op g = 0 := by
    intro u hu
    by_contra hc
    exact hno ⟨u, hc, hu⟩

  have hyy : (wcEtGeomPt Y y) (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) = y := by
    have e1 := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (algebraMap
      (Y.residueField y) (AlgebraicClosure (Y.residueField y)))))
      (Y.fromSpecResidueField y)
      (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))
    refine e1.trans ?_
    first
      | exact Scheme.fromSpecResidueField_apply _ _
      | simp only [Scheme.fromSpecResidueField_apply]
  have hwA : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y),
      A.hom.left ≫ A.right.hom = wcEtGeomPt Y y := fun A => Over.w A.hom

  have L1 : ∀ (A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y))
      (c : A.right ⟶ U),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ I.obj) (Opposite.op A)).hom ((I.obj.map c.op).hom g) = 0 := by
    intro A c
    have ha : A.right.hom (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) = y := by
      have e2 := Scheme.Hom.comp_apply A.hom.left A.right.hom
        (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))
      have e3 : (A.hom.left ≫ A.right.hom)
          (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) =
          (wcEtGeomPt Y y) (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) := by
        rw [hwA A]
      exact (e2.symm.trans e3).trans hyy
    have hc : c.left ≫ U.hom = A.right.hom := MorphismProperty.Over.w c
    have hu : U.hom (c.left (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))) = y := by
      have e2 := Scheme.Hom.comp_apply c.left U.hom
        (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
      have e3 : (c.left ≫ U.hom)
          (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) =
          A.right.hom (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) := by
        rw [hc]
      exact (e2.symm.trans e3).trans ha
    obtain ⟨V₁, c', ⟨w, hw'⟩, hc'0⟩ := hO _ hu
    have hτpt : c'.left w = (A.hom.left ≫ c.left)
        (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) :=
      hw'.trans (Scheme.Hom.comp_apply A.hom.left c.left
        (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))).symm
    obtain ⟨t₁, ht₁, -⟩ := wc_etale_lift_alg_closed_point (AlgebraicClosure (Y.residueField y))
      c'.left (A.hom.left ≫ c.left) w hτpt
    have hτ : (A.hom.left ≫ c.left) ≫ U.hom = wcEtGeomPt Y y :=
      (Category.assoc A.hom.left c.left U.hom).trans
        ((congrArg (fun z => A.hom.left ≫ z) hc).trans (hwA A))
    have h₁ : t₁ ≫ V₁.hom = wcEtGeomPt Y y :=
      (congrArg (fun z => t₁ ≫ z) (MorphismProperty.Over.w c')).symm.trans
        ((Category.assoc t₁ c'.left U.hom).symm.trans
          ((congrArg (fun z => z ≫ U.hom) ht₁).trans hτ))
    let AU : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
      StructuredArrow.mk (Y := U) (Over.homMk (U := Over.mk (wcEtGeomPt Y y))
        (V := (Scheme.Etale.forget Y).obj U) (A.hom.left ≫ c.left) hτ)
    let A₁ : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
      StructuredArrow.mk (Y := V₁) (Over.homMk (U := Over.mk (wcEtGeomPt Y y))
        (V := (Scheme.Etale.forget Y).obj V₁) t₁ h₁)
    let φ : A ⟶ AU := StructuredArrow.homMk c (Over.OverMorphism.ext rfl)
    let ψ : A₁ ⟶ AU := StructuredArrow.homMk c' (Over.OverMorphism.ext ht₁)
    have e4 := Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ I.obj) φ.op g
    have e5 := Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ I.obj) ψ.op g
    have hz : (I.obj.map c'.op).hom g = 0 := hc'0
    calc (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
          (Scheme.Etale.forget Y)).op ⋙ I.obj) (Opposite.op A)).hom ((I.obj.map c.op).hom g)
        = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
          (Scheme.Etale.forget Y)).op ⋙ I.obj) (Opposite.op AU)).hom g := e4
      _ = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
          (Scheme.Etale.forget Y)).op ⋙ I.obj) (Opposite.op A₁)).hom ((I.obj.map c'.op).hom g) := e5.symm
      _ = 0 := by rw [hz, map_zero]

  haveI hcof : IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) :=
    IsCofiltered.of_hasFiniteLimits _
  obtain ⟨hrep, -, -⟩ := wc_et_stalk_germ_facts Y y hcof I
  have gen : ∀ (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] [P.IsMultiplicative]
      (S : Scheme.{u}) (X : P.Over ⊤ S) (R : Sieve X),
      R ∈ Scheme.smallGrothendieckTopology P S X → ∀ v : X.left,
      ∃ (X₁ : P.Over ⊤ S) (c : X₁ ⟶ X), R.arrows c ∧ v ∈ Set.range c.left := by
    intro P _ _ S X R hR v
    obtain ⟨𝒰, hO', h, hle⟩ := (Scheme.mem_smallGrothendieckTopology X R).mp hR
    obtain ⟨i, y', hy'⟩ := 𝒰.exists_eq v
    refine ⟨_, _, hle _ _ (Presieve.ofArrows.mk i), y', ?_⟩
    exact hy'
  have s1 : ∀ (X : Y.Etale) (R : Sieve X), R ∈ Scheme.smallEtaleTopology Y X →
      ∀ v : X.left, ∃ (X₁ : Y.Etale) (c : X₁ ⟶ X), R.arrows c ∧ v ∈ Set.range c.left :=
    fun X R hR v => gen _ Y X R hR v
  haveI hπ : Sheaf.IsLocallySurjective e :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} e).mpr he
  haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y)
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
    Presheaf.isLocallySurjective_toSheafify' _ _
  have h0 : ∀ x : (wcEtStalk Y y).obj I, x = 0 := by
    intro x
    obtain ⟨A, s, hs⟩ := hrep x

    have hS1 : Presheaf.imageSieve e.hom s ∈ Scheme.smallEtaleTopology Y A.right :=
      Presheaf.imageSieve_mem _ _ s
    obtain ⟨T₀, c₀, ⟨x₀, hx₀⟩, t₀, ht₀⟩ :=
      s1 A.right _ hS1 (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
    have hS2 := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y)
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) x₀
    obtain ⟨V₃, c', ⟨p, hp⟩, v₃, hv₃⟩ := s1 T₀ _ hS2 t₀
    have hd : (c' ≫ c₀).left v₃ =
        A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) := by
      change c₀.left (c'.left v₃) = _
      rw [hv₃, ht₀]
    have hp' : ((toSheafify (Scheme.smallEtaleTopology Y)
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V₃)).hom p =
        (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map c'.op).hom x₀ := hp
    have hx₀' : (e.hom.app (Opposite.op T₀)).hom x₀ = (I.obj.map c₀.op).hom s := hx₀
    have hnat : (e.hom.app (Opposite.op V₃)).hom
        ((((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map c'.op).hom x₀) =
        (I.obj.map c'.op).hom ((e.hom.app (Opposite.op T₀)).hom x₀) :=
      NatTrans.naturality_apply e.hom c'.op x₀
    have hds : (I.obj.map (c' ≫ c₀).op).hom s = (e.hom.app (Opposite.op V₃)).hom
        (((toSheafify (Scheme.smallEtaleTopology Y)
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op V₃)).hom p) := by
      rw [hp', hnat, hx₀', op_comp, Functor.map_comp, AddCommGrpCat.hom_comp,
        AddMonoidHom.comp_apply]

    obtain ⟨t₃, ht₃, -⟩ := wc_etale_lift_alg_closed_point (AlgebraicClosure (Y.residueField y))
      (c' ≫ c₀).left A.hom.left v₃ hd
    have h₃ : t₃ ≫ V₃.hom = wcEtGeomPt Y y :=
      (congrArg (fun z => t₃ ≫ z) (MorphismProperty.Over.w (c' ≫ c₀ : V₃ ⟶ A.right))).symm.trans
        ((Category.assoc t₃ (c' ≫ c₀ : V₃ ⟶ A.right).left A.right.hom).symm.trans
          ((congrArg (fun z => z ≫ A.right.hom) ht₃).trans (hwA A)))
    let A₃ : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
      StructuredArrow.mk (Y := V₃) (Over.homMk (U := Over.mk (wcEtGeomPt Y y))
        (V := (Scheme.Etale.forget Y).obj V₃) t₃ h₃)
    let f : A₃ ⟶ A := StructuredArrow.homMk (c' ≫ c₀) (Over.OverMorphism.ext ht₃)

    let Φ := (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
          (Scheme.Etale.forget Y)).op ⋙ I.obj) (Opposite.op A₃)).hom.comp
          ((e.hom.app (Opposite.op V₃)).hom.comp
            ((toSheafify (Scheme.smallEtaleTopology Y)
              (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
                (Opposite.op V₃)).hom)
    have key : ∀ q : FreeAbelianGroup (ULift.{u+1} (V₃ ⟶ U)), Φ q = 0 := by
      intro q
      refine FreeAbelianGroup.induction_on q ?_ ?_ ?_ ?_
      · exact map_zero Φ
      · intro a
        have hPm : ((yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map a.down.op).hom
            (FreeAbelianGroup.of (ULift.up (𝟙 U))) = FreeAbelianGroup.of a := by
          first
            | (simp [AddCommGrpCat.free_map, FreeAbelianGroup.map_of_apply, yoneda_obj_map]; done)
            | (simp [AddCommGrpCat.free_map, FreeAbelianGroup.map_of_apply, yoneda_obj_map]; rfl)
            | (rw [Functor.comp_map, Functor.comp_map, AddCommGrpCat.free_map,
                AddCommGrpCat.hom_ofHom, FreeAbelianGroup.map_of_apply]
               show FreeAbelianGroup.of (ULift.up (a.down ≫ 𝟙 U)) = _
               rw [Category.comp_id])
        have hn1 := NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology Y)
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) a.down.op
          (FreeAbelianGroup.of (ULift.up (𝟙 U)))
        have hn2 := NatTrans.naturality_apply e.hom a.down.op
          (((toSheafify (Scheme.smallEtaleTopology Y)
            (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op U)).hom
            (FreeAbelianGroup.of (ULift.up (𝟙 U))))
        have s1' : ((toSheafify (Scheme.smallEtaleTopology Y)
              (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
                (Opposite.op V₃)).hom (FreeAbelianGroup.of a) =
            ((toSheafify (Scheme.smallEtaleTopology Y)
              (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
                (Opposite.op V₃)).hom
              (((yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map a.down.op).hom
                (FreeAbelianGroup.of (ULift.up (𝟙 U)))) :=
          congrArg ((toSheafify (Scheme.smallEtaleTopology Y)
              (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
                (Opposite.op V₃)).hom hPm.symm
        have h3 : (e.hom.app (Opposite.op V₃)).hom
            (((toSheafify (Scheme.smallEtaleTopology Y)
              (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
                (Opposite.op V₃)).hom (FreeAbelianGroup.of a)) = (I.obj.map a.down.op).hom g :=
          (congrArg (e.hom.app (Opposite.op V₃)).hom (s1'.trans hn1)).trans
            (hn2.trans (congrArg (I.obj.map a.down.op).hom hg.symm))
        exact (congrArg (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
          (Scheme.Etale.forget Y)).op ⋙ I.obj) (Opposite.op A₃)).hom h3).trans (L1 A₃ a.down)
      · intro a ha
        exact (map_neg Φ (FreeAbelianGroup.of a)).trans ((congrArg Neg.neg ha).trans neg_zero)
      · intro a b ha hb
        exact (map_add Φ a b).trans ((congrArg₂ (· + ·) ha hb).trans (add_zero 0))
    have e6 := Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ I.obj) f.op s
    calc x = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
          (Scheme.Etale.forget Y)).op ⋙ I.obj) (Opposite.op A)).hom s := hs.symm
      _ = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
          (Scheme.Etale.forget Y)).op ⋙ I.obj) (Opposite.op A₃)).hom
            ((I.obj.map (c' ≫ c₀).op).hom s) := e6.symm
      _ = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
          (Scheme.Etale.forget Y)).op ⋙ I.obj) (Opposite.op A₃)).hom
            ((e.hom.app (Opposite.op V₃)).hom
              (((toSheafify (Scheme.smallEtaleTopology Y)
                (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
                  (Opposite.op V₃)).hom p)) := by rw [hds]
      _ = 0 := key p
  exact ⟨fun a b => by rw [h0 a, h0 b]⟩

theorem wc_et_finite_generic_support_reduction : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f] [QuasiCompact f] (N : ℕ) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), (∀ (G' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (j : G' ⟶ G), Mono j → ∀ (S : Finset Y), (∀ s ∈ S, ¬ Subsingleton ((wcEtStalk Y s).obj G')) → (∀ y : Y, ¬ Subsingleton ((wcEtStalk Y y).obj G') → ∃ s ∈ S, y ∈ closure ({s} : Set Y)) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, N < q → ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G' q, z = 0) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, N < q → ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q, z = 0 :=
by
  classical
  intro K _ Y f _ _ N G H
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q hq x

  have hYln : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
  have hYc : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  have hYqs : QuasiSeparatedSpace Y := inferInstance

  have hgen : ∀ (U : Y.Etale), IsAffine U.left → ∀ (Z : Set U.left), IsClosed Z →
      ∃ T : Finset Y, (∀ s ∈ T, ∃ t ∈ Z, U.hom t = s) ∧
        ∀ u ∈ Z, ∃ s ∈ T, U.hom u ∈ closure ({s} : Set Y) := by
    intro U hU Z hZ
    have : LocallyOfFiniteType U.hom := inferInstance
    have : IsLocallyNoetherian ((Functor.fromPUnit Y).obj U.right) := hYln
    have : IsLocallyNoetherian U.left := LocallyOfFiniteType.isLocallyNoetherian U.hom
    have : IsNoetherian U.left := {}
    obtain ⟨T, hTZ, hTcov⟩ : ∃ T : Finset U.left, (∀ t ∈ T, t ∈ Z) ∧
        ∀ z ∈ Z, ∃ t ∈ T, z ∈ closure ({t} : Set U.left) := by
      obtain ⟨𝒮, hfin, hcl, hirr, heq⟩ :=
        TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hZ
      have hg : ∀ C ∈ 𝒮, ∃ g, IsGenericPoint g C :=
        fun C hC => QuasiSober.sober (hirr C hC) (hcl C hC)
      choose g hg using hg
      refine ⟨hfin.toFinset.attach.image (fun C => g C.1 (hfin.mem_toFinset.mp C.2)), ?_, ?_⟩
      · intro t ht
        obtain ⟨C, -, rfl⟩ := Finset.mem_image.mp ht
        rw [heq]
        exact Set.mem_sUnion_of_mem (hg C.1 _).mem (hfin.mem_toFinset.mp C.2)
      · intro z hz
        rw [heq] at hz
        obtain ⟨C, hC, hzC⟩ := Set.mem_sUnion.mp hz
        refine ⟨g C hC, Finset.mem_image.mpr ⟨⟨C, hfin.mem_toFinset.mpr hC⟩,
          Finset.mem_attach _ _, rfl⟩, ?_⟩
        rw [isGenericPoint_def.mp (hg C hC)]
        exact hzC
    refine ⟨T.image U.hom, ?_, ?_⟩
    · intro s hs
      obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hs
      exact ⟨t, hTZ t ht, rfl⟩
    · intro u hu
      obtain ⟨t, ht, hut⟩ := hTcov u hu
      refine ⟨U.hom t, Finset.mem_image_of_mem _ ht, ?_⟩
      exact map_mem_closure U.hom.continuous hut
        (fun a ha => by rw [Set.mem_singleton_iff.mp ha]; exact Set.mem_singleton _)

  obtain ⟨Λ, instC, instF, F, ι, hcompat, hmono, hcyc, e, he⟩ :=
    wc_et_sheaf_union_of_cyclic_subsheaves Y G
  letI := instC
  haveI := instF

  have hstage : ∀ (i : Λ) (q' : ℕ), N < q' → ∀ z : Abelian.Ext ((constantSheaf
      (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) (F.obj i) q', z = 0 := by
    intro i q' hq' z
    obtain ⟨U, eU, hUaff, hepi⟩ := hcyc i
    obtain ⟨Z, hZ, hsupp⟩ := wc_et_cyclic_sheaf_stalk_support Y U (F.obj i) eU hepi
    obtain ⟨S, hSZ, hScov⟩ := hgen U hUaff Z hZ
    refine H (F.obj i) (ι i) (hmono i) S ?_ ?_ q' hq' z
    · intro s hs
      exact (hsupp s).2 (hSZ s hs)
    · intro y hy
      obtain ⟨u, hu, rfl⟩ := (hsupp y).1 hy
      exact hScov u hu

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hTc : CompactSpace (Scheme.Etale.mk (𝟙 Y)).left := hYc
  have hTqs : QuasiSeparatedSpace (Scheme.Etale.mk (𝟙 Y)).left := hYqs
  have H0 : ∀ (G' : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (x₀ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit G') 0),
      ∃ (i : Λ) (y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (G'.obj i) 0),
        y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G' i)) (add_zero 0) = x₀ := by
    intro G' x₀
    obtain ⟨hA', hB'⟩ := wc_et_sheaf_colimit_cocone_local Y Λ G'
    obtain ⟨hsurj, -⟩ := wc_et_qcqs_sections_local_cocone Y Λ G' (Limits.colimit G')
      (Limits.colimit.ι G') (fun i j f => Limits.colimit.w G' f) hA' hB' (Scheme.Etale.mk (𝟙 Y))
      hTc hTqs
    obtain ⟨i, t, ht⟩ := hsurj ((Sheaf.H.equiv₀ (Limits.colimit G') hT) x₀)
    refine ⟨i, (Sheaf.H.equiv₀ (G'.obj i) hT).symm t,
      (Sheaf.H.equiv₀ (Limits.colimit G') hT).injective ?_⟩
    have h := Sheaf.H.equiv₀_naturality hT (Limits.colimit.ι G' i)
      ((Sheaf.H.equiv₀ (G'.obj i) hT).symm t)
    rw [AddEquiv.apply_symm_apply, Sheaf.H.map_apply] at h
    rw [← h, ht]
  have Hemb : ∀ G' : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ∃ (I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (α : G' ⟶ I),
        Mono α ∧
        ∀ (q : ℕ) (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit I) (q + 1)),
          e = 0 := by
    intro G'
    obtain ⟨I, α, hα, hinj⟩ := wc_et_functorial_injective_embedding Y Λ G'
    obtain ⟨hA', hB'⟩ := wc_et_sheaf_colimit_cocone_local Y Λ I
    exact ⟨I, α, hα, wc_et_qcqs_colim_injective_acyclic Y hYc hYqs Λ I hinj
      (fun U hU1 hU2 => wc_et_qcqs_sections_local_cocone Y Λ I (Limits.colimit I)
        (Limits.colimit.ι I) (fun i j f => Limits.colimit.w I f) hA' hB' U hU1 hU2)⟩

  obtain ⟨i, y, hy⟩ := wc_ext_filtered_colim_lift
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) Λ H0 Hemb F q
    (x.comp (Abelian.Ext.mk₀ e.inv) (add_zero q))
  have hy0 : y = 0 := hstage i q hq y
  calc x = (x.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)).comp (Abelian.Ext.mk₀ e.hom)
        (add_zero q) := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    _ = 0 := by rw [← hy, hy0, Abelian.Ext.zero_comp, Abelian.Ext.zero_comp]

theorem wc_rightDerived_homology_nsmul_zero : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (R : C ⥤ D) [R.Additive] (A : C) (I : InjectiveResolution A) (n : ℕ), n • 𝟙 A = 0 → ∀ s : ℕ, n • 𝟙 (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology s) = 0 :=
by
  intro C D _ _ _ _ R _ A I n hn s
  have h1 : I.ι ≫ (n • 𝟙 I.cocomplex) = 0 := by
    rw [Preadditive.comp_nsmul, Category.comp_id]
    have : n • I.ι = (CochainComplex.single₀ C).map (n • 𝟙 A) ≫ I.ι := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Preadditive.nsmul_comp,
        Category.id_comp]
    rw [this, hn, Functor.map_zero, Limits.zero_comp]
  have h := InjectiveResolution.descHomotopyZero (I := I) (J := I) (n • 𝟙 I.cocomplex) h1
  have h' := R.mapHomotopy h
  have E := h'.homologyMap_eq s
  rw [Functor.map_zero, HomologicalComplex.homologyMap_zero, Functor.map_nsmul,
    CategoryTheory.Functor.map_id] at E
  rw [← E, ← HomologicalComplex.homologyFunctor_map, Functor.map_nsmul,
    CategoryTheory.Functor.map_id]
  rfl

theorem wc_lft_residue_algebraic_over_poly : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f] (x : Y) (D : ℕ), topologicalKrullDim ↥(closure ({x} : Set Y)) ≤ (D : WithBot ℕ∞) → letI : Algebra K (Y.residueField x) := (Spec.preimage (Y.fromSpecResidueField x ≫ f)).hom.toAlgebra; ∃ (n : ℕ) (t : Fin n → Y.residueField x), n ≤ D ∧ Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range t)) (Y.residueField x) :=
by
  classical
  intro K _ Y f _ x D hD
  letI iK : Algebra K (Y.residueField x) :=
    (Spec.preimage (Y.fromSpecResidueField x ≫ f)).hom.toAlgebra

  have GU : ∀ (R S : Type u) [CommRing R] [CommRing S] (g : R →+* S),
      Function.Injective g → g.IsIntegral → ringKrullDim R ≤ ringKrullDim S := by
    intro R S _ _ g hinj hint
    letI := g.toAlgebra
    haveI : Algebra.IsIntegral R S := ⟨hint⟩
    have key : ∀ P : LTSeries (PrimeSpectrum R), ∃ Q : LTSeries (PrimeSpectrum S),
        Q.length = P.length ∧ Ideal.under R Q.last.asIdeal = P.last.asIdeal := by
      intro P
      induction P using RelSeries.inductionOn' with
      | singleton P0 =>
        obtain ⟨Q, -, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P0.asIdeal
          (⊥ : Ideal S)
          (by rw [Ideal.under, Ideal.comap_bot_of_injective (algebraMap R S) hinj]; exact bot_le)
        exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQP⟩
      | snoc P P' hP ih =>
        obtain ⟨Q, hlen, hQ⟩ := ih
        have hP' : P.last < P' := hP
        obtain ⟨Q', hle, hQ', hQ'P⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
          P'.asIdeal Q.last.asIdeal (by rw [hQ]; exact le_of_lt hP')
        have hlt : Q.last < (⟨Q', hQ'⟩ : PrimeSpectrum S) := by
          refine lt_of_le_of_ne hle ?_
          intro h
          apply ne_of_lt hP'
          ext1
          rw [← hQ, ← hQ'P, h]
        exact ⟨Q.snoc ⟨Q', hQ'⟩ hlt, by simp [hlen], by simpa using hQ'P⟩
    unfold ringKrullDim Order.krullDim
    apply iSup_le
    intro P
    obtain ⟨Q, hlen, -⟩ := key P
    rw [← hlen]
    exact Order.LTSeries.length_le_krullDim Q

  have NA : ∀ (B : Type u) [CommRing B] [Algebra K B] (n : ℕ)
      (g : MvPolynomial (Fin n) K →ₐ[K] B) (ι : B →ₐ[K] Y.residueField x), g.Finite →
      (∀ z : Y.residueField x, ∃ a b : B, ι b ≠ 0 ∧ z * ι b = ι a) →
      Algebra.IsAlgebraic (IntermediateField.adjoin K
        (Set.range (fun i => ι (g (MvPolynomial.X i))))) (Y.residueField x) := by
    intro B _ _ n g ι hg hfr
    set E := IntermediateField.adjoin K (Set.range (fun i => ι (g (MvPolynomial.X i)))) with hE
    have hmem : ∀ P : MvPolynomial (Fin n) K, ι (g P) ∈ E := by
      intro P
      induction P using MvPolynomial.induction_on with
      | C a =>
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, AlgHom.commutes]
        exact E.algebraMap_mem a
      | add p q hp hq => rw [map_add, map_add]; exact E.add_mem hp hq
      | mul_X p i hp =>
        rw [map_mul, map_mul]
        exact E.mul_mem hp (IntermediateField.subset_adjoin K _ ⟨i, rfl⟩)
    let φ : MvPolynomial (Fin n) K →+* E :=
      RingHom.codRestrict (((ι : B →+* Y.residueField x)).comp (g : MvPolynomial (Fin n) K →+* B))
        E hmem
    have hint : ∀ b : B, IsIntegral E (ι b) := by
      intro b
      letI : Algebra (MvPolynomial (Fin n) K) B := (g : MvPolynomial (Fin n) K →+* B).toAlgebra
      have hb : IsIntegral (MvPolynomial (Fin n) K) b := RingHom.IsIntegral.of_finite hg b
      exact IsIntegral.map_of_comp_eq φ (ι : B →+* Y.residueField x) (by ext <;> rfl) hb
    refine ⟨fun z => ?_⟩
    obtain ⟨a, b, hb, h⟩ := hfr z
    have hz : z = ι a * (ι b)⁻¹ := by rw [← h, mul_assoc, mul_inv_cancel₀ hb, mul_one]
    rw [hz]
    exact (hint a).isAlgebraic.mul (hint b).isAlgebraic.inv

  obtain ⟨U, hU0, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens Y)) (show x ∈ (⊤ : Y.Opens) from trivial)
  have hU : IsAffineOpen U := hU0
  set p : Ideal Γ(Y, U) := (hU.primeIdealOf ⟨x, hxU⟩).asIdeal with hp
  set ev : Γ(Y, U) →+* Y.residueField x := (Y.evaluation U x hxU).hom with hev

  have EV : (∀ a : Γ(Y, U), ev a = 0 ↔ a ∈ p) ∧
      ∀ z : Y.residueField x, ∃ a b : Γ(Y, U), ev b ≠ 0 ∧ z * ev b = ev a := by
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨x, hxU⟩ : U)
    haveI : IsLocalization.AtPrime (Y.presheaf.stalk x) (hU.primeIdealOf ⟨x, hxU⟩).asIdeal :=
      hU.isLocalization_stalk ⟨x, hxU⟩
    have hev' : ∀ a, (Y.evaluation U x hxU).hom a =
        (Y.residue x).hom (algebraMap Γ(Y, U) (Y.presheaf.stalk x) a) := by
      intro a; rw [← Scheme.germ_residue]; rfl
    have hker : ∀ a : Γ(Y, U), (Y.evaluation U x hxU).hom a = 0 ↔
        a ∈ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal := by
      intro a
      rw [hev']
      show IsLocalRing.residue _ _ = 0 ↔ _
      rw [IsLocalRing.residue_eq_zero_iff]
      exact IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ _
    refine ⟨hker, fun z => ?_⟩
    obtain ⟨s, rfl⟩ := Y.residue_surjective x z
    obtain ⟨⟨a, b⟩, hs⟩ := IsLocalization.mk'_surjective
      (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl s
    refine ⟨a, b, ?_, ?_⟩
    · intro h
      exact b.2 ((hker b).mp h)
    · rw [hev, hev', hev', ← map_mul, ← hs]
      simp only
      rw [IsLocalization.mk'_spec]

  set φ : K →+* Γ(Y, U) :=
    (f.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom with hφ
  have ALG : ∀ c : K, algebraMap K (Y.residueField x) c = ev (φ c) := by
    intro c
    have hD : Spec.preimage (Y.fromSpecResidueField x ≫ f) =
        (Scheme.ΓSpecIso (.of K)).inv ≫ f.appTop ≫ Y.presheaf.germ ⊤ x trivial ≫
          Y.residue x := by
      apply Spec.map_injective
      rw [Spec.map_preimage]
      simp only [Spec.map_comp, Category.assoc]
      rw [← Scheme.fromSpecStalk_toSpecΓ_assoc, ← Scheme.toSpecΓ_naturality_assoc,
        toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id, ← Category.assoc]
      rfl
    have hE : f.appLE ⊤ U le_top ≫ Y.evaluation U x hxU =
        f.appTop ≫ Y.presheaf.germ ⊤ x trivial ≫ Y.residue x := by
      rw [← Scheme.germ_residue]
      have h1 : f.appLE ⊤ U le_top =
          f.app ⊤ ≫ Y.presheaf.map (homOfLE (le_top : U ≤ f ⁻¹ᵁ ⊤)).op := rfl
      rw [h1, Category.assoc]
      erw [TopCat.Presheaf.germ_res_assoc]
      rfl
    show (Spec.preimage (Y.fromSpecResidueField x ≫ f)).hom c = _
    rw [hD, ← hE]
    rfl
  letI iA : Algebra K Γ(Y, U) := φ.toAlgebra
  haveI hftA : Algebra.FiniteType K Γ(Y, U) := by
    have h1 : (f.appLE ⊤ U le_top).hom.FiniteType :=
      LocallyOfFiniteType.finiteType_appLE f (isAffineOpen_top (Spec (.of K))) hU le_top
    have h2 : (Scheme.ΓSpecIso (.of K)).inv.hom.FiniteType := by
      apply RingHom.FiniteType.of_surjective
      intro c
      refine ⟨(Scheme.ΓSpecIso (.of K)).hom.hom c, ?_⟩
      rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
    exact h1.comp h2
  haveI : Algebra.FiniteType K (Γ(Y, U) ⧸ p) := Algebra.FiniteType.quotient K p
  obtain ⟨n, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg K (Γ(Y, U) ⧸ p)
  let ι0 : Γ(Y, U) ⧸ p →+* Y.residueField x :=
    Ideal.Quotient.lift p ev (fun a ha => (EV.1 a).mpr ha)
  let ι : Γ(Y, U) ⧸ p →ₐ[K] Y.residueField x :=
    { ι0 with
      commutes' := fun c => by
        show ι0 (Ideal.Quotient.mk p (φ c)) = _
        rw [Ideal.Quotient.lift_mk, ALG c] }
  have hιmk : ∀ a, ι (Ideal.Quotient.mk p a) = ev a := fun a => Ideal.Quotient.lift_mk _ _ _
  have halg := NA (Γ(Y, U) ⧸ p) n g ι hgfin (by
    intro z
    obtain ⟨a, b, hb, h⟩ := EV.2 z
    exact ⟨Ideal.Quotient.mk p a, Ideal.Quotient.mk p b, by rw [hιmk]; exact hb,
      by rw [hιmk, hιmk]; exact h⟩)
  refine ⟨n, fun i => ι (g (MvPolynomial.X i)), ?_, halg⟩

  have h1 : ((n : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (MvPolynomial (Fin n) K) := by
    have := ringKrullDim_add_natCard_le_ringKrullDim_mvPolynomial (R := K) (Fin n)
    rwa [ringKrullDim_eq_zero_of_field, Nat.card_fin, zero_add] at this
  have h2 : ringKrullDim (MvPolynomial (Fin n) K) ≤ ringKrullDim (Γ(Y, U) ⧸ p) :=
    GU _ _ (g : MvPolynomial (Fin n) K →+* Γ(Y, U) ⧸ p) hginj (RingHom.IsIntegral.of_finite hgfin)
  have h3 : ringKrullDim (Γ(Y, U) ⧸ p) ≤ topologicalKrullDim ↥(closure ({x} : Set Y)) := by
    let F : PrimeSpectrum (Γ(Y, U) ⧸ p) → Y :=
      fun Q => hU.fromSpec (PrimeSpectrum.comap (Ideal.Quotient.mk p) Q)
    have hFind : Topology.IsInducing F :=
      (hU.fromSpec.isOpenEmbedding.isInducing).comp
        (PrimeSpectrum.isClosedEmbedding_comap_of_surjective _ _
          Ideal.Quotient.mk_surjective).isInducing
    have hFmem : ∀ Q, F Q ∈ closure ({x} : Set Y) := by
      intro Q
      have hle : hU.primeIdealOf ⟨x, hxU⟩ ≤ PrimeSpectrum.comap (Ideal.Quotient.mk p) Q := by
        intro a ha
        show Ideal.Quotient.mk p a ∈ Q.asIdeal
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha]
        exact Q.asIdeal.zero_mem
      have hsp := ((PrimeSpectrum.le_iff_specializes _ _).mp hle).map hU.fromSpec.continuous
      rw [IsAffineOpen.fromSpec_primeIdealOf] at hsp
      exact specializes_iff_mem_closure.mp hsp
    let G : PrimeSpectrum (Γ(Y, U) ⧸ p) → closure ({x} : Set Y) := fun Q => ⟨F Q, hFmem Q⟩
    have hG : Topology.IsInducing G :=
      (Topology.IsInducing.subtypeVal.of_comp_iff).mp hFind
    rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
    exact hG.topologicalKrullDim_le
  have h4 := h1.trans (h2.trans (h3.trans hD))
  exact_mod_cast h4

theorem wc_field_alg_over_algclosed_acyclic : ∀ (K L : Type u) [Field K] [IsAlgClosed K] [Field L] [Algebra K L], Algebra.IsAlgebraic K L → ∀ (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}), letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ (q : ℕ) (z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G (q + 1)), z = 0 :=
by
  intro K L _ _ _ _ halg G
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q z
  haveI := halg
  haveI : Algebra.IsIntegral K L := Algebra.IsAlgebraic.isIntegral
  have hbij : Function.Bijective (algebraMap K L) :=
    IsAlgClosed.algebraMap_bijective_of_isIntegral
  haveI : IsAlgClosed L := IsAlgClosed.of_ringEquiv K L (RingEquiv.ofBijective (algebraMap K L) hbij)
  haveI : HenselianLocalRing L := Field.henselian L
  have hinj : Function.Injective (IsLocalRing.residue L) := RingHom.injective _
  haveI : IsAlgClosed (IsLocalRing.ResidueField L) :=
    IsAlgClosed.of_ringEquiv L (IsLocalRing.ResidueField L)
      (RingEquiv.ofBijective (IsLocalRing.residue L) ⟨hinj, IsLocalRing.residue_surjective⟩)
  haveI : IsSepClosed (IsLocalRing.ResidueField L) := IsSepClosed.of_isAlgClosed _
  classical


  have hetale : ∀ (E : Type u) [CommRing E] [Algebra L E] [Algebra.Etale L E]
      (σ : E →ₐ[L] IsLocalRing.ResidueField L), ∃ τ : E →ₐ[L] L,
        ∀ x : E, IsLocalRing.residue L (τ x) = σ x := by
    intro E _ _ _ σ
    haveI hq : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
    haveI : Algebra.FormallyEtale E (Localization.AtPrime (RingHom.ker σ)) :=
      Algebra.FormallyEtale.of_isLocalization (RingHom.ker σ).primeCompl
    haveI : Algebra.IsEtaleAt L (RingHom.ker σ) :=
      Algebra.FormallyEtale.comp L E (Localization.AtPrime (RingHom.ker σ))
    obtain ⟨g, hg, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := L) (RingHom.ker σ)
    have hσg : IsUnit (σ g) := isUnit_iff_ne_zero.mpr (fun h =>  hg (RingHom.mem_ker.mpr h))
    let σg : Localization.Away g →ₐ[L] IsLocalRing.ResidueField L :=
      IsLocalization.Away.liftAlgHom g hσg
    have hσg_apply : ∀ y : E, σg (algebraMap E (Localization.Away g) y) = σ y := by
      intro y
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    obtain ⟨Q⟩ := hstd.nonempty_standardEtalePresentation
    let e : Q.Ring ≃ₐ[L] Localization.Away g :=
      AlgEquiv.ofBijective (Q.lift Q.x Q.hasMap) Q.lift_bijective
    have heX : e Q.X = Q.x := by
      rw [AlgEquiv.ofBijective_apply]
      exact Q.lift_X _ _
    set a₀ := σg Q.x with ha₀
    have hf0 : Polynomial.aeval a₀ Q.f = 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply, Q.hasMap.1, map_zero]
    have hf' : Polynomial.aeval a₀ (Polynomial.derivative Q.f) ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact ((StandardEtalePair.HasMap.isUnit_derivative_f Q.P Q.hasMap).map σg).ne_zero
    have hg0 : Polynomial.aeval a₀ Q.g ≠ 0 := by
      rw [ha₀, Polynomial.aeval_algHom_apply]
      exact (Q.hasMap.2.map σg).ne_zero
    have hHen := ((HenselianLocalRing.TFAE L).out 1 2).mp (inferInstance : HenselianLocalRing L)
    obtain ⟨a, hroot, hres⟩ := hHen Q.f Q.monic_f a₀ hf0 hf'
    have hres' : ∀ p : Polynomial L,
        IsLocalRing.residue L (Polynomial.aeval a p) = Polynomial.aeval a₀ p := by
      intro p
      rw [← hres, ← IsLocalRing.ResidueField.algebraMap_eq, ← Algebra.ofId_apply,
        ← Algebra.ofId_apply, ← Polynomial.aeval_algHom_apply]
    have hHas : Q.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.coe_aeval_eq_eval]
        exact hroot
      · rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres']
        exact hg0
    have hcomp : (Algebra.ofId L (IsLocalRing.ResidueField L)).comp (Q.lift a hHas) =
        σg.comp (e : Q.Ring →ₐ[L] Localization.Away g) := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, Q.lift_X, AlgEquiv.coe_toAlgHom, heX,
        Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq, hres]
    refine ⟨((Q.lift a hHas).comp (e.symm : Localization.Away g →ₐ[L] Q.Ring)).comp
      (IsScalarTower.toAlgHom L E (Localization.Away g)), fun y => ?_⟩
    have h1 := congrArg (fun φ => φ (e.symm (algebraMap E (Localization.Away g) y))) hcomp
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.apply_symm_apply,
      Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at h1
    rw [AlgHom.comp_apply, AlgHom.comp_apply, IsScalarTower.coe_toAlgHom',
      AlgEquiv.coe_toAlgHom, h1, hσg_apply]
  have Hsec : ∀ (E : Type u) [CommRing E] [Algebra L E], Algebra.Etale L E →
      ∀ φ : E →ₐ[L] IsLocalRing.ResidueField L, ∃ τ : E →ₐ[L] L,
        (Algebra.ofId L (IsLocalRing.ResidueField L)).comp τ = φ := by
    intro E _ _ hE φ
    haveI := hE
    obtain ⟨τ, hτ⟩ := hetale E φ
    refine ⟨τ, AlgHom.ext fun x => ?_⟩
    rw [AlgHom.comp_apply, Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
    exact hτ x

  have hsec : ∀ {V : Scheme.{u}} (g : V ⟶ Spec (.of L)) [Etale g] (v : V),
      g v = IsLocalRing.closedPoint L → ∃ σ : Spec (.of L) ⟶ V, σ ≫ g = 𝟙 _ := by
    intro V g _ v hv
    have hres : ∀ (S : Type u) [CommRing S] [Algebra L S], Algebra.Etale L S →
        ∀ (q : Ideal S) [q.IsPrime], q.comap (algebraMap L S) = IsLocalRing.maximalIdeal L →
        Nonempty (S →ₐ[L] IsLocalRing.ResidueField L) := by
      intro S _ _ hE q _ hq
      have hker : RingHom.ker (algebraMap L q.ResidueField) = IsLocalRing.maximalIdeal L := by
        rw [IsScalarTower.algebraMap_eq L S q.ResidueField, ← RingHom.comap_ker,
          Ideal.ker_algebraMap_residueField, hq]
      have : IsLocalHom (algebraMap L q.ResidueField) := by
        constructor
        intro a ha
        by_contra hna
        have hm : a ∈ IsLocalRing.maximalIdeal L := hna
        rw [← hker, RingHom.mem_ker] at hm
        exact ha.ne_zero hm
      let j : IsLocalRing.ResidueField L →+* q.ResidueField :=
        IsLocalRing.ResidueField.lift (algebraMap L q.ResidueField)
      letI : Algebra (IsLocalRing.ResidueField L) q.ResidueField := j.toAlgebra
      have : IsScalarTower L (IsLocalRing.ResidueField L) q.ResidueField :=
        IsScalarTower.of_algebraMap_eq (fun r => by
          rw [RingHom.algebraMap_toAlgebra, IsLocalRing.ResidueField.algebraMap_eq,
            IsLocalRing.ResidueField.lift_residue_apply])
      have : Algebra.FormallyUnramified S (Localization.AtPrime q) :=
        Algebra.FormallyUnramified.of_isLocalization q.primeCompl
      have : Algebra.FormallyUnramified S q.ResidueField :=
        Algebra.FormallyUnramified.comp S (Localization.AtPrime q) q.ResidueField
      have : Algebra.FormallyUnramified L q.ResidueField :=
        Algebra.FormallyUnramified.comp L S q.ResidueField
      have : Algebra.EssFiniteType L q.ResidueField := Algebra.EssFiniteType.comp L S q.ResidueField
      have : Algebra.FormallyUnramified (IsLocalRing.ResidueField L) q.ResidueField :=
        Algebra.FormallyUnramified.of_restrictScalars L _ q.ResidueField
      have : Algebra.EssFiniteType (IsLocalRing.ResidueField L) q.ResidueField :=
        Algebra.EssFiniteType.of_comp L _ q.ResidueField
      have : Algebra.IsSeparable (IsLocalRing.ResidueField L) q.ResidueField :=
        Algebra.FormallyUnramified.isSeparable _ q.ResidueField
      have hsurj := IsSepClosed.algebraMap_surjective (IsLocalRing.ResidueField L) q.ResidueField
      let eq : IsLocalRing.ResidueField L ≃ₐ[L] q.ResidueField :=
        AlgEquiv.ofBijective (IsScalarTower.toAlgHom L (IsLocalRing.ResidueField L) q.ResidueField)
          ⟨(algebraMap (IsLocalRing.ResidueField L) q.ResidueField).injective, hsurj⟩
      exact ⟨eq.symm.toAlgHom.comp (IsScalarTower.toAlgHom L S q.ResidueField)⟩
    obtain ⟨E, ι, hι, hvι, -⟩ :=
      Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
    obtain ⟨w, hw⟩ := hvι
    have := hι
    let h : Spec E ⟶ Spec (.of L) := ι ≫ g
    have : Etale h := inferInstance
    let φ : CommRingCat.of L ⟶ E := Spec.preimage h
    have hφ : Spec.map φ = h := Spec.map_preimage h
    have hEt : (CommRingCat.Hom.hom φ).Etale := by
      have : Etale (Spec.map φ) := by rw [hφ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp this
    letI : Algebra L E := (CommRingCat.Hom.hom φ).toAlgebra
    have hAE : Algebra.Etale L E := RingHom.Etale.toAlgebra hEt
    let p : PrimeSpectrum E := w
    have hq : (p.asIdeal).comap (algebraMap L E) = IsLocalRing.maximalIdeal L := by
      have h1 : (Spec.map φ) w = IsLocalRing.closedPoint L := by
        rw [hφ]
        show g (ι w) = _
        rw [hw, hv]
      have h2 := congrArg PrimeSpectrum.asIdeal h1
      exact h2
    obtain ⟨φ₀⟩ := hres E hAE p.asIdeal hq
    obtain ⟨τ, -⟩ := Hsec E hAE φ₀
    let τ' : E ⟶ CommRingCat.of L := CommRingCat.ofHom (τ : E →+* L)
    have hret : φ ≫ τ' = 𝟙 _ := by
      ext r
      exact τ.commutes r
    refine ⟨Spec.map τ' ≫ ι, ?_⟩
    have h3 : ι ≫ g = Spec.map φ := hφ.symm
    rw [Category.assoc, h3, ← Spec.map_comp, hret, Spec.map_id]

  let T : (Spec (.of L)).Etale := Scheme.Etale.mk (𝟙 (Spec (.of L)))
  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hcov : ∀ R ∈ (Scheme.smallEtaleTopology (Spec (.of L))) T, R.arrows (𝟙 T) := by
    intro R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale (Spec (.of L)) T at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    have hR' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR
    obtain ⟨Y, f, y, hf, hfe, hy⟩ := hR' (IsLocalRing.closedPoint L)
    haveI : Etale f.left := hfe
    obtain ⟨σ, hσ⟩ := @hsec Y.left f.left hfe y hy
    let σ' : T ⟶ Y := MorphismProperty.Over.homMk σ (by
      rw [← MorphismProperty.Over.w f]
      exact (Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ T.hom) hσ).trans (Category.id_comp _)))
    have h := R.downward_closed hf σ'
    rwa [hT.hom_ext (σ' ≫ f) (𝟙 T)] at h
  have hsurjT : ∀ {F G : (Spec (.of L)).Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}} (φ : F ⟶ G),
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology (Spec (.of L))) φ →
      Function.Surjective (φ.app (Opposite.op T)) := by
    intro F G φ hφ s
    have h1 := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology (Spec (.of L))) φ s
    have h2 := hcov _ h1
    rw [Presheaf.imageSieve_apply] at h2
    obtain ⟨t, ht⟩ := h2
    exact ⟨t, by simpa using ht⟩
  haveI : ((sheafSections (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}).obj
      (Opposite.op T)).PreservesEpimorphisms := by
    constructor
    intro F G φ hφ
    have h1 : Sheaf.IsLocallySurjective φ :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ
    exact (AddCommGrpCat.epi_iff_surjective _).mpr (hsurjT φ.hom h1)

  have hP : Projective (AddCommGrpCat.of (ULift.{u+1} ℤ)) := by
    refine ⟨fun {E X} f e he => ?_⟩
    have hs := (AddCommGrpCat.epi_iff_surjective e).mp he
    obtain ⟨y, hy⟩ := hs (f ⟨1⟩)
    refine ⟨AddCommGrpCat.ofHom ((zmultiplesHom E y).comp AddEquiv.ulift.toAddMonoidHom), ?_⟩
    ext ⟨n⟩
    have h1 : (⟨n⟩ : ULift.{u+1} ℤ) = n • (⟨1⟩ : ULift.{u+1} ℤ) := by
      ext; simp
    change e (n • y) = f ⟨n⟩
    rw [h1, map_zsmul, map_zsmul, hy]
  have adj := constantSheafAdj (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1} hT
  haveI hproj := adj.map_projective _ hP

  haveI hsub := Abelian.Ext.subsingleton_of_projective
    ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q
  exact Subsingleton.elim _ _

theorem wc_adjoin_fin_succ_split : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (n : ℕ) (t : Fin (n + 1) → L), Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range t)) L → (∃ t' : Fin n → ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc))), Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range t')) ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc)))) ∧ Algebra.IsAlgebraic (IntermediateField.adjoin ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc))) {t (Fin.last n)}) L :=
by
  intro K L _ _ _ n t ht
  refine ⟨⟨fun i => ⟨t (Fin.castSucc i),
    IntermediateField.subset_adjoin K _ (Set.mem_range_self i)⟩, ?_⟩, ?_⟩
  · have key : ∀ y : ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc))),
        y ∈ IntermediateField.adjoin K (Set.range (fun i : Fin n =>
          (⟨t (Fin.castSucc i), IntermediateField.subset_adjoin K _ (Set.mem_range_self i)⟩ :
            ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc)))))) := by
      intro y
      rw [← IntermediateField.mem_lift, IntermediateField.lift_adjoin]
      have himg : Subtype.val '' Set.range (fun i : Fin n =>
          (⟨t (Fin.castSucc i), IntermediateField.subset_adjoin K _ (Set.mem_range_self i)⟩ :
            ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc)))))
          = Set.range (t ∘ Fin.castSucc) := by
        rw [← Set.range_comp]
        rfl
      rw [himg]
      exact y.2
    constructor
    intro y
    exact isAlgebraic_algebraMap (⟨y, key y⟩ : ↥(IntermediateField.adjoin K (Set.range (fun i : Fin n =>
          (⟨t (Fin.castSucc i), IntermediateField.subset_adjoin K _ (Set.mem_range_self i)⟩ :
            ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc))))))))
  · have hsub : ∀ x ∈ IntermediateField.adjoin K (Set.range t),
        x ∈ IntermediateField.adjoin ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc)))
          {t (Fin.last n)} := by
      intro x hx
      have hle : IntermediateField.adjoin K (Set.range t) ≤
          (IntermediateField.adjoin ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc)))
            {t (Fin.last n)}).restrictScalars K := by
        rw [IntermediateField.adjoin_le_iff]
        rintro _ ⟨i, rfl⟩
        rw [SetLike.mem_coe, IntermediateField.mem_restrictScalars]
        rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | rfl
        · have hj : t (Fin.castSucc j) ∈ IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc)) :=
            IntermediateField.subset_adjoin K _ (Set.mem_range_self j)
          exact IntermediateField.algebraMap_mem _ (⟨_, hj⟩ :
            ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc))))
        · exact IntermediateField.mem_adjoin_simple_self _ _
      exact (IntermediateField.mem_restrictScalars K).mp (hle hx)
    let f : ↥(IntermediateField.adjoin K (Set.range t)) →+*
        ↥(IntermediateField.adjoin ↥(IntermediateField.adjoin K (Set.range (t ∘ Fin.castSucc)))
          {t (Fin.last n)}) :=
      { toFun := fun a => ⟨a, hsub a a.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    constructor
    intro x
    exact (ht.isAlgebraic x).ringHom_of_comp_eq f (RingHom.id L)
      (by
        intro a b h
        apply Subtype.ext
        have h2 : ((f a : L)) = ((f b : L)) := by rw [h]
        exact h2) rfl

theorem wc_field_sepclosed_curve_cd_one : ∀ (k E : Type u) [Field k] [Field E] [Algebra k E] [IsSepClosed k] (s : E), Algebra.IsAlgebraic (IntermediateField.adjoin k {s}) E → ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : k) ≠ 0 → ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh (Spec (.of E)) ℓ q) :=
by
  intro k E _ _ _ _ s hs ℓ _ hℓk q hq
  classical

  have hAC : ∀ (Ω E' : Type u) [Field Ω] [IsAlgClosed Ω] [Field E'] [Algebra Ω E'] (s' : E'),
      Algebra.IsAlgebraic (IntermediateField.adjoin Ω {s'}) E' → (ℓ : Ω) ≠ 0 →
      Subsingleton (wcEtCoh (Spec (.of E')) ℓ q) := by
    intro Ω E' _ _ _ _ s' hs' hℓΩ
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of E'))) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    have hG : ∀ n : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
        (Spec (.of E'))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        (wcEtGm (Spec (.of E'))) (n + 1)) :=
      wc_et_gm_field_vanishing_of_norm_surj E' (fun E₁ _ _ halg F _ _ _ =>
        wc_c1_norm_surjective E₁ (wc_tsen_algebraic_c1 Ω E' s' hs' E₁ halg) F)
    obtain ⟨ι, w, hS⟩ := wc_et_kummer_ses_gen Ω (Spec (.of E'))
      (Spec.map (CommRingCat.ofHom (algebraMap Ω E'))) ℓ hℓΩ
    obtain ⟨n, rfl⟩ : ∃ n, q = n + 2 := ⟨q - 2, by omega⟩
    show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of E')))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of E'))) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (n + 2))
    have hz : ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of E')))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of E'))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (n + 2), x = 0 := by
      intro x
      have h0 : x.comp (Abelian.Ext.mk₀ ι) (add_zero (n + 2)) = 0 :=
        @Subsingleton.elim _ (hG (n + 1)) _ _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS x h0
        (show n + 1 + 1 = n + 2 from rfl)
      have e3 : x₃ = 0 := @Subsingleton.elim _ (hG n) _ _
      rw [← hx₃, e3, Abelian.Ext.zero_comp]
    exact ⟨fun a b => by rw [hz a, hz b]⟩

  have hPI : ∀ (E' : Type u) [Field E'] [Algebra E E'] [IsPurelyInseparable E E'],
      Nonempty (wcEtCoh (Spec (.of E')) ℓ q ≃ wcEtCoh (Spec (.of E)) ℓ q) := by
    intro E' _ _ _
    have key : ∀ {Y' : Scheme.{u}} (π : Y' ⟶ Spec (.of E)) [IsIntegralHom π],
        (∀ V : (Spec (.of E)).Etale, IsHomeomorph (Limits.pullback.fst V.hom π)) →
        Nonempty (wcEtCoh Y' ℓ q ≃ wcEtCoh (Spec (.of E)) ℓ q) := by
      intro Y' π _ hV
      obtain ⟨L, ⟨adj⟩, hL, ⟨e⟩⟩ := wc_et_push_left_adjoint π
      haveI := hL
      haveI : Limits.PreservesFiniteColimits (wcEtPush π) := wc_et_integral_push_exact π
      haveI : Limits.PreservesFiniteLimits (wcEtPush π) := by
        have : Limits.PreservesLimitsOfSize.{0, 0} (wcEtPush π) := adj.rightAdjoint_preservesLimits
        infer_instance
      haveI := wc_et_enough_injectives Y'
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of E))) AddCommGrpCat.{u+1}) :=
        HasExt.standard _
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}) := HasExt.standard _
      obtain ⟨E₀⟩ := wc_et_push_const_of_homeomorph π hV ℓ (wc_et_const_sheaf_local_form Y' ℓ).1
        (wc_et_const_sheaf_local_form Y' ℓ).2
      have B := wc_ext_adjoint_transfer L (wcEtPush π) adj
        ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of E))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        ((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q
      show Nonempty (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)))
          ((constantSheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q ≃
        Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of E))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)))
          ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of E))) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q)
      refine ⟨Equiv.trans ?_ ((Equiv.ofBijective _ B).trans ?_)⟩
      · exact
          { toFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add q)
            invFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add q)
            left_inv := fun y => by
              simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
            right_inv := fun y => by
              simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp] }
      · exact
          { toFun := fun x => x.comp (Abelian.Ext.mk₀ E₀.hom) (add_zero q)
            invFun := fun x => x.comp (Abelian.Ext.mk₀ E₀.inv) (add_zero q)
            left_inv := fun x => by
              simp only
              rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
                Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
            right_inv := fun x => by
              simp only
              rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
                Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    haveI hsint : IsIntegralHom (Spec.map (CommRingCat.ofHom (algebraMap E E'))) :=
      IsIntegralHom.SpecMap_iff.mpr (fun x => Algebra.IsIntegral.isIntegral x)
    have hsinj : UniversallyInjective (Spec.map (CommRingCat.ofHom (algebraMap E E'))) := by
      rw [universallyInjective_eq_diagonal]
      change Surjective (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap E E'))))
      have h1 : Subsingleton (PrimeSpectrum (TensorProduct E E' E')) :=
        (PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable E E' E').injective.subsingleton
      haveI : Subsingleton ↥(Spec (CommRingCat.of (TensorProduct E E' E'))) := h1
      haveI : Subsingleton ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap E E')))
          (Spec.map (CommRingCat.ofHom (algebraMap E E')))) :=
        (Scheme.homeoOfIso (pullbackSpecIso E E' E')).injective.subsingleton
      obtain ⟨x⟩ : Nonempty (PrimeSpectrum E') := inferInstance
      exact ⟨fun z => ⟨x, Subsingleton.elim _ _⟩⟩
    have hhomeo : ∀ (T : Scheme.{u}) (h : T ⟶ Spec (.of E)),
        IsHomeomorph (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (algebraMap E E')))) := by
      intro T h
      haveI : UniversallyInjective (Limits.pullback.fst h
          (Spec.map (CommRingCat.ofHom (algebraMap E E')))) :=
        MorphismProperty.of_isPullback (P := @UniversallyInjective)
          (IsPullback.of_hasPullback h _).flip hsinj
      rw [isHomeomorph_iff_continuous_isClosedMap_bijective]
      exact ⟨Scheme.Hom.continuous _, Scheme.Hom.isClosedMap _,
        Scheme.Hom.injective _, Scheme.Hom.surjective _⟩
    exact key _ (fun V => hhomeo V.left V.hom)

  have hgen : ∀ (Eb : Type u) [Field Eb] [Algebra k Eb] [Algebra E Eb] [IsScalarTower k E Eb]
      (Ω₀ : IntermediateField k Eb) [IsAlgClosed Ω₀] (E'₀ : IntermediateField E Eb),
      (∀ x ∈ Ω₀, x ∈ E'₀) → IsPurelyInseparable E E'₀ →
      Subsingleton (wcEtCoh (Spec (.of E)) ℓ q) := by
    intro Eb _ _ _ _ Ω₀ _ E'₀ hsub hpi
    let φ : Ω₀ →+* E'₀ := (Ω₀.val : Ω₀ →+* Eb).codRestrict E'₀ (fun x => hsub x x.2)
    letI : Algebra Ω₀ E'₀ := φ.toAlgebra
    have hcl : Subfield.closure (Set.range (algebraMap k E) ∪ {s}) ≤
        Subfield.comap (algebraMap E E'₀)
          (IntermediateField.adjoin Ω₀ {algebraMap E E'₀ s}).toSubfield := by
      rw [Subfield.closure_le]
      rintro x (⟨c, rfl⟩ | hx)
      · show algebraMap E E'₀ (algebraMap k E c) ∈ IntermediateField.adjoin Ω₀ {algebraMap E E'₀ s}
        have e : algebraMap E E'₀ (algebraMap k E c) = algebraMap Ω₀ E'₀ (algebraMap k Ω₀ c) :=
          Subtype.ext (IsScalarTower.algebraMap_apply k E Eb c).symm
        rw [e]
        exact IntermediateField.algebraMap_mem _ _
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        exact IntermediateField.mem_adjoin_simple_self Ω₀ (algebraMap E E'₀ x)
    have hmem : ∀ a : IntermediateField.adjoin k {s},
        algebraMap E E'₀ (a : E) ∈ IntermediateField.adjoin Ω₀ {algebraMap E E'₀ s} := by
      intro a
      have ha : (a : E) ∈ (IntermediateField.adjoin k {s}).toSubfield := a.2
      rw [IntermediateField.adjoin_toSubfield] at ha
      exact hcl ha
    let f : IntermediateField.adjoin k {s} →+*
        IntermediateField.adjoin Ω₀ {algebraMap E E'₀ s} :=
      ((algebraMap E E'₀).comp (algebraMap (IntermediateField.adjoin k {s}) E)).codRestrict _ hmem
    have hd2 : ∀ e : E, IsAlgebraic (IntermediateField.adjoin Ω₀ {algebraMap E E'₀ s})
        (algebraMap E E'₀ e) :=
      fun e => IsAlgebraic.ringHom_of_comp_eq f (algebraMap E E'₀) (hs.isAlgebraic e)
        f.injective (RingHom.ext fun _ => rfl)
    have halg : Algebra.IsAlgebraic (IntermediateField.adjoin Ω₀ {algebraMap E E'₀ s}) E'₀ := by
      constructor
      intro y
      let ι' : E →+* algebraicClosure (IntermediateField.adjoin Ω₀ {algebraMap E E'₀ s}) E'₀ :=
        (algebraMap E E'₀).codRestrict _ (fun e => mem_algebraicClosure_iff.mpr (hd2 e))
      have hy : IsAlgebraic E y := Algebra.IsAlgebraic.isAlgebraic y
      have h1 : IsAlgebraic (algebraicClosure (IntermediateField.adjoin Ω₀ {algebraMap E E'₀ s}) E'₀)
          ((RingHom.id E'₀) y) :=
        IsAlgebraic.ringHom_of_comp_eq ι' (RingHom.id E'₀) hy ι'.injective
          (RingHom.ext fun _ => rfl)
      exact IsAlgebraic.restrictScalars _ h1
    have hchar : (ℓ : Ω₀) ≠ 0 := by
      intro h
      apply hℓk
      apply (algebraMap k Ω₀).injective
      rw [map_natCast, map_zero]
      exact h
    haveI := hAC Ω₀ E'₀ (algebraMap E E'₀ s) halg hchar
    obtain ⟨e⟩ := hPI E'₀
    exact e.symm.subsingleton
  haveI : ExpChar E (ringExpChar k) :=
    expChar_of_injective_algebraMap (algebraMap k E).injective _
  haveI : IsAlgClosed (algebraicClosure k (AlgebraicClosure E)) := IsAlgClosure.isAlgClosed k
  haveI : IsPurelyInseparable k (algebraicClosure k (AlgebraicClosure E)) :=
    Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
  have hE'pi : IsPurelyInseparable E (IntermediateField.adjoin E
      ((algebraicClosure k (AlgebraicClosure E) : IntermediateField k (AlgebraicClosure E)) :
        Set (AlgebraicClosure E))) := by
    rw [IntermediateField.isPurelyInseparable_adjoin_iff_pow_mem E (AlgebraicClosure E)
      (ringExpChar k)]
    intro x hx
    obtain ⟨n, c, hc⟩ := IsPurelyInseparable.pow_mem k (ringExpChar k)
      (⟨x, hx⟩ : algebraicClosure k (AlgebraicClosure E))
    refine ⟨n, algebraMap k E c, ?_⟩
    have h2 := congrArg Subtype.val hc
    rw [← IsScalarTower.algebraMap_apply k E (AlgebraicClosure E)]
    simpa using h2
  exact hgen (AlgebraicClosure E) (algebraicClosure k (AlgebraicClosure E))
    (IntermediateField.adjoin E _) (fun x hx => IntermediateField.subset_adjoin E _ hx) hE'pi

theorem wc_field_push_higher_vanish : ∀ (F L : Type u) [Field F] [Field L] [Algebra F L] (τ : L), Algebra.IsAlgebraic (IntermediateField.adjoin F {τ}) L → ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : F) ≠ 0 → (∀ (k E : Type u) [Field k] [Field E] [Algebra k E] [IsSepClosed k] (s : E), Algebra.IsAlgebraic (IntermediateField.adjoin k {s}) E → (ℓ : k) ≠ 0 → ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh (Spec (.of E)) ℓ q)) → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (b : ℕ), 2 ≤ b → Limits.IsZero ((((wcEtPush (Spec.map (CommRingCat.ofHom (algebraMap F L)))).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology b) :=
by
  classical

  have s1 : ∀ (K E : Type u) [Field K] [CommRing E] [Algebra K E] [Algebra.Etale K E] (x : E),
      ∃ y : E, x * x * y = x := by
    intro K E _ _ _ _ x
    obtain ⟨Ix, _, Ai, hF, hA, e, _⟩ := (Algebra.Etale.iff_exists_algEquiv_prod K E).mp inferInstance
    refine ⟨e.symm (fun i => (e x i)⁻¹), ?_⟩
    apply e.injective
    rw [map_mul, map_mul, e.apply_symm_apply]
    funext i
    simp only [Pi.mul_apply]
    by_cases h : e x i = 0
    · rw [h]; simp
    · rw [mul_assoc, mul_inv_cancel₀ h, mul_one]

  have s2 : ∀ (F A : Type u) [Field F] [CommRing A] (β : F →+* A) (J : Type u) [SmallCategory J]
      [IsFiltered J] (D : J ⥤ CommRingCat.{u}) (p : ∀ j, F →+* D.obj j) (ι : ∀ j, D.obj j →+* A),
      (∀ j, (p j).Etale) → (∀ {i j : J} (f : i ⟶ j), (ι j).comp (D.map f).hom = ι i) →
      (∀ j, (ι j).comp (p j) = β) → (∀ x : A, ∃ (j : J) (t : D.obj j), ι j t = x) →
      letI : Algebra F A := β.toAlgebra; ∀ s : Finset A, ∃ (E : Type u) (_ : CommRing E)
        (_ : Algebra F E), Algebra.Etale F E ∧ ∃ g : E →ₐ[F] A, ∀ a ∈ s, a ∈ g.range := by
    intro F A _ _ β J _ _ D p ι hp hι hβ hsurj
    letI : Algebra F A := β.toAlgebra
    have C : ∀ s : Finset A, ∃ j, ∀ a ∈ s, ∃ t, ι j t = a := by
      intro s
      induction s using Finset.induction_on with
      | empty => exact ⟨IsFiltered.nonempty.some, by simp⟩
      | insert a s _ ih =>
        obtain ⟨j₁, h₁⟩ := ih
        obtain ⟨j₂, t₂, h₂⟩ := hsurj a
        refine ⟨IsFiltered.max j₁ j₂, fun a' ha' => ?_⟩
        rcases Finset.mem_insert.mp ha' with h | ha'
        · have := congrArg (fun φ : D.obj j₂ →+* A => φ t₂) (hι (IsFiltered.rightToMax j₁ j₂))
          exact ⟨_, (this.trans h₂).trans h.symm⟩
        · obtain ⟨t', ht'⟩ := h₁ a' ha'
          have := congrArg (fun φ : D.obj j₁ →+* A => φ t') (hι (IsFiltered.leftToMax j₁ j₂))
          exact ⟨_, this.trans ht'⟩
    intro s
    obtain ⟨j, hj⟩ := C s
    letI : Algebra F (D.obj j) := (p j).toAlgebra
    refine ⟨D.obj j, inferInstance, inferInstance, hp j,
      ⟨{ toRingHom := ι j, commutes' := fun r => ?_ }, fun a ha => ?_⟩⟩
    · show ι j (p j r) = β r
      rw [← hβ j]; rfl
    · obtain ⟨t, ht⟩ := hj a ha
      exact (AlgHom.mem_range _).mpr ⟨t, ht⟩

  have s3 : ∀ (F L A : Type u) [Field F] [Field L] [CommRing A] [Algebra F L] [Algebra F A],
      (∀ s : Finset A, ∃ (E : Type u) (_ : CommRing E) (_ : Algebra F E), Algebra.Etale F E ∧
        ∃ g : E →ₐ[F] A, ∀ a ∈ s, a ∈ g.range) →
      (∀ a : A, ∃ v : A, a * a * v = a) ∧
        ∀ x : TensorProduct F L A, ∃ y : TensorProduct F L A, x * x * y = x := by
    intro F L A _ _ _ _ _ hS
    constructor
    · intro a
      obtain ⟨E, _, _, _, g, hg⟩ := hS {a}
      obtain ⟨e, he⟩ := (AlgHom.mem_range g).mp (hg a (Finset.mem_singleton_self a))
      obtain ⟨y, hy⟩ := s1 F E e
      exact ⟨g y, by rw [← he, ← map_mul, ← map_mul, hy]⟩
    · intro x
      have M : ∃ s : Finset A, ∀ (E : Type u) [CommRing E] [Algebra F E] (g : E →ₐ[F] A),
          (∀ a ∈ s, a ∈ g.range) → x ∈ (Algebra.TensorProduct.map (AlgHom.id F L) g).range := by
        induction x using TensorProduct.induction_on with
        | zero => exact ⟨∅, fun E _ _ g _ => Subalgebra.zero_mem _⟩
        | tmul l a =>
          refine ⟨{a}, fun E _ _ g hg => ?_⟩
          obtain ⟨e, he⟩ := (AlgHom.mem_range g).mp (hg a (Finset.mem_singleton_self a))
          exact (AlgHom.mem_range _).mpr
            ⟨l ⊗ₜ e, by rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, he]⟩
        | add x x' hx hx' =>
          obtain ⟨s, hs⟩ := hx
          obtain ⟨s', hs'⟩ := hx'
          exact ⟨s ∪ s', fun E _ _ g hg => Subalgebra.add_mem _
            (hs E g fun a ha => hg a (Finset.mem_union_left _ ha))
            (hs' E g fun a ha => hg a (Finset.mem_union_right _ ha))⟩
      obtain ⟨s, hs⟩ := M
      obtain ⟨E, _, _, _, g, hg⟩ := hS s
      obtain ⟨w, hw⟩ := (AlgHom.mem_range _).mp (hs E g hg)
      obtain ⟨y', hy'⟩ := s1 L (TensorProduct F L E) w
      exact ⟨Algebra.TensorProduct.map (AlgHom.id F L) g y',
        by rw [← hw, ← map_mul, ← map_mul, hy']⟩

  have s4 : ∀ (A : Type u) [CommRing A] [IsLocalRing A], (∀ a : A, ∃ v : A, a * a * v = a) →
      Function.Bijective (IsLocalRing.residue A) := by
    intro A _ _ hA
    refine ⟨?_, IsLocalRing.residue_surjective⟩
    rw [injective_iff_map_eq_zero]
    intro x hx
    rw [IsLocalRing.residue_eq_zero_iff] at hx
    obtain ⟨v, hv⟩ := hA x
    have hu : IsUnit (1 - x * v) := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
      ((IsLocalRing.mem_maximalIdeal _).mp (Ideal.mul_mem_right v _ hx))
    have h0 : x * (1 - x * v) = 0 := by rw [mul_sub, mul_one, ← mul_assoc, hv, sub_self]
    exact hu.mul_left_eq_zero.mp h0

  have s5 : ∀ (F L A k E : Type u) [Field F] [Field L] [CommRing A] [Field k] [Field E]
      [Algebra F L] [Algebra F A] (τ : L), Algebra.IsAlgebraic (IntermediateField.adjoin F {τ}) L →
      ∀ (σ : A ≃+* k) (ρ : TensorProduct F L A →+* E), Function.Surjective ρ →
      letI : Algebra k E := ((ρ.comp (Algebra.TensorProduct.includeRight :
        A →ₐ[F] TensorProduct F L A).toRingHom).comp σ.symm.toRingHom).toAlgebra;
      Algebra.IsAlgebraic (IntermediateField.adjoin k {ρ (τ ⊗ₜ[F] (1 : A))}) E := by
    intro F L A k E _ _ _ _ _ _ _ τ hτ σ ρ hρ
    letI : Algebra k E := ((ρ.comp (Algebra.TensorProduct.includeRight :
      A →ₐ[F] TensorProduct F L A).toRingHom).comp σ.symm.toRingHom).toAlgebra
    set s := ρ (τ ⊗ₜ[F] (1 : A)) with hs_def
    set M := IntermediateField.adjoin k {s} with hM
    let j : L →+* E := ρ.comp Algebra.TensorProduct.includeLeftRingHom
    have ha : ∀ a : A, ρ ((1 : L) ⊗ₜ[F] a) ∈ M := by
      intro a
      have : algebraMap k E (σ a) = ρ ((1 : L) ⊗ₜ[F] a) := by
        show ρ (Algebra.TensorProduct.includeRight (σ.symm (σ a))) = _
        rw [σ.symm_apply_apply]; rfl
      rw [← this]; exact IntermediateField.algebraMap_mem M (σ a)
    have hle : (IntermediateField.adjoin F {τ}).toSubfield ≤ M.toSubfield.comap j := by
      rw [IntermediateField.adjoin_toSubfield, Subfield.closure_le]
      rintro z (⟨f, rfl⟩ | hz)
      · show ρ (algebraMap F L f ⊗ₜ[F] (1 : A)) ∈ M
        rw [Algebra.TensorProduct.tmul_one_eq_one_tmul]
        exact ha _
      · rw [Set.mem_singleton_iff] at hz
        subst hz
        exact IntermediateField.mem_adjoin_simple_self k s
    let f₀ : IntermediateField.adjoin F {τ} →+* M :=
      (j.comp (algebraMap (IntermediateField.adjoin F {τ}) L)).codRestrict M (fun z => hle z.2)
    have hj : ∀ l : L, IsAlgebraic M (j l) := by
      intro l
      exact IsAlgebraic.ringHom_of_comp_eq f₀ j (hτ.isAlgebraic l) f₀.injective (by ext; rfl)
    have hd : ∀ x : TensorProduct F L A, IsAlgebraic M (ρ x) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact isAlgebraic_zero
      | tmul l a =>
        have e : l ⊗ₜ[F] a = (l ⊗ₜ[F] (1 : A)) * ((1 : L) ⊗ₜ[F] a) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [e, map_mul]
        exact (hj l).mul (isAlgebraic_algebraMap (⟨_, ha a⟩ : M))
      | add x y hx hy => rw [map_add]; exact hx.add hy
    exact ⟨fun e => by obtain ⟨x, rfl⟩ := hρ e; exact hd x⟩

  have s7 : ∀ (R : Type u) [CommRing R] (m q : ℕ), 1 ≤ q → (∀ x : R, ∃ y : R, x * x * y = x) →
      (∀ (p : Spec (.of R)) (ρ : R →+* (Spec (.of R)).residueField p), Function.Surjective ρ →
        Subsingleton (wcEtCoh (Spec ((Spec (.of R)).residueField p)) m q)) →
      Subsingleton (wcEtCoh (Spec (.of R)) m q) := by
    intro R _ m q hq hR hfib
    let e : Γ(Spec (.of R), ⊤) ≃+* R := (Scheme.ΓSpecIso (CommRingCat.of R)).commRingCatIsoToRingEquiv
    have hΓ : ∀ f : Γ(Spec (.of R), ⊤), ∃ t : Γ(Spec (.of R), ⊤), f * f * t = f := by
      intro f
      obtain ⟨y, hy⟩ := hR (e f)
      refine ⟨e.symm y, e.injective ?_⟩
      rw [map_mul, map_mul, e.apply_symm_apply, hy]
    refine wc_et_coh_vanish_of_vnr_fibres (Spec (.of R)) (Spec (.of R)) (𝟙 _) hΓ m q hq ?_
    intro p
    have hsurj : Function.Surjective
        (((Spec (.of R)).evaluation ⊤ p trivial).hom.comp e.symm.toRingHom) :=
      (wc_vnr_evaluation_surjective (Spec (.of R)) hΓ p).comp e.symm.surjective
    haveI := hfib p _ hsurj
    obtain ⟨E⟩ := wc_et_coh_iso_invariance
      (Limits.pullback.snd (𝟙 (Spec (.of R))) ((Spec (.of R)).fromSpecResidueField p)) m q
    exact E.symm.subsingleton

  intro F L _ _ _ τ hτ ℓ hℓ hℓF Hcurve I b hb
  apply wc_et_stalks_zero
  intro η
  obtain ⟨A, _, _, _, Λ', _, _, W', φ, a, e, hInit, hAff, hcomp, ha, hlim, he, heq, _⟩ :=
    wc_r2gs_geom_hens_lifts η
  have hsh : wcHalShData η A Λ' W' φ a := ⟨hInit, hAff, hcomp, ha, hlim, e, he, heq⟩
  obtain ⟨β, hβa, J, _, _, D, p, ι, hp, _, hι, hβ, hsurj, _⟩ :=
    wc_shdata_filtered_etale_presentation η A Λ' W' φ a hsh F (Iso.refl _)
  rw [Iso.refl_hom, Category.comp_id] at hβa
  subst hβa
  letI : Algebra F A := β.toAlgebra
  have hfin := s2 F A β J D p ι hp hι hβ hsurj
  obtain ⟨hA, hR⟩ := s3 F L A hfin
  have hT : Subsingleton (wcEtCoh (Spec (.of (TensorProduct F L A))) ℓ b) := by
    apply s7 (TensorProduct F L A) ℓ b (by omega) hR
    intro P ρ hρ
    have hbij := s4 A hA
    letI : Algebra (IsLocalRing.ResidueField A) ((Spec (.of (TensorProduct F L A))).residueField P) :=
      ((ρ.comp (Algebra.TensorProduct.includeRight : A →ₐ[F] TensorProduct F L A).toRingHom).comp
        (RingEquiv.ofBijective (IsLocalRing.residue A) hbij).symm.toRingHom).toAlgebra
    have halg := s5 F L A (IsLocalRing.ResidueField A) _ τ hτ
      (RingEquiv.ofBijective (IsLocalRing.residue A) hbij) ρ hρ
    have hℓk : (ℓ : IsLocalRing.ResidueField A) ≠ 0 := by
      intro h0
      apply hℓF
      apply ((IsLocalRing.residue A).comp β).injective
      rw [map_natCast, map_zero]; exact h0
    exact Hcurve (IsLocalRing.ResidueField A) _ (ρ (τ ⊗ₜ[F] (1 : A))) halg hℓk b hb
  have hpb : Subsingleton (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap F L)))
      (Spec.map (CommRingCat.ofHom β))) ℓ b) := by
    obtain ⟨E⟩ := wc_et_coh_iso_invariance (pullbackSpecIso F L A).hom ℓ b
    exact E.symm.subsingleton
  obtain ⟨E7⟩ := wc_et_limit_push_homology_affine (Spec.map (CommRingCat.ofHom (algebraMap F L))) A Λ'
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt _ η)) (Scheme.Etale.forget _)) φ
    (Spec.map (CommRingCat.ofHom β)) hAff hcomp ha hlim ℓ I b
  obtain ⟨E8⟩ := wc_et_stalk_push_homology (Spec.map (CommRingCat.ofHom (algebraMap F L))) η Λ' W'
    hInit I.cocomplex b
  exact (E8.trans E7).subsingleton

theorem wc_field_torsion_cd_of_const : ∀ (L : Type u) [Field L] (ℓ : ℕ), ℓ.Prime → (ℓ : L) ≠ 0 → ∀ N : ℕ, (∀ (L' : Type u) [Field L'] [Algebra L L'] [FiniteDimensional L L'] (q : ℕ), N < q → letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L'))) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L'))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L'))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q, z = 0) → ∀ (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}), ℓ • 𝟙 G = 0 → letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ q : ℕ, N < q → ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q, z = 0 :=
by
  classical
  intro L _ ℓ hℓ hℓL N H G hG q hq z

  have isoT : ∀ (X : Scheme.{u}) (P A B : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
      (A ≅ B) → ∀ (n : ℕ),
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _;
      (∀ x : Abelian.Ext P A n, x = 0) → ∀ x : Abelian.Ext P B n, x = 0 := by
    intro X P A B e n
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    intro hA x
    have h1 : x = (x.comp (Abelian.Ext.mk₀ e.inv) (add_zero n)).comp (Abelian.Ext.mk₀ e.hom)
        (add_zero n) := by
      rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ e.inv) (Abelian.Ext.mk₀ e.hom) (add_zero n)
        (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    rw [h1, hA (x.comp (Abelian.Ext.mk₀ e.inv) (add_zero n)), Abelian.Ext.zero_comp]
  have retT : ∀ (X : Scheme.{u}) (P A B : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (s : A ⟶ B) (r : B ⟶ A), s ≫ r = 𝟙 A → ∀ (n : ℕ),
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _;
      (∀ x : Abelian.Ext P B n, x = 0) → ∀ x : Abelian.Ext P A n, x = 0 := by
    intro X P A B s r hsr n
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    intro hB x
    have h1 : x = (x.comp (Abelian.Ext.mk₀ s) (add_zero n)).comp (Abelian.Ext.mk₀ r)
        (add_zero n) := by
      rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ s) (Abelian.Ext.mk₀ r) (add_zero n)
        (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, hsr, Abelian.Ext.comp_mk₀_id]
    rw [h1, hB (x.comp (Abelian.Ext.mk₀ s) (add_zero n)), Abelian.Ext.zero_comp]
  have sesT : ∀ (X : Scheme.{u}) (P : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})), S.ShortExact →
      ∀ (n : ℕ),
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _;
      (∀ x : Abelian.Ext P S.X₁ n, x = 0) → (∀ x : Abelian.Ext P S.X₃ n, x = 0) →
      ∀ x : Abelian.Ext P S.X₂ n, x = 0 := by
    intro X P S hS n
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    intro h1 h3 x
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS x (h3 _)
    rw [← hx₁, h1 x₁, Abelian.Ext.zero_comp]
  have nonemptyCoh : ∀ (Y : Scheme.{u}) (m n : ℕ), Nonempty (wcEtCoh Y m n) := by
    intro Y m n
    unfold wcEtCoh
    exact ⟨0⟩

  have FIN : ∀ (A : Type u) [CommRing A] [Algebra L A] [Module.Finite L A] (n : ℕ), N < n →
      Subsingleton (wcEtCoh (Spec (CommRingCat.of A)) ℓ n) := by
    intro A _ _ _ n hn
    haveI : IsArtinianRing (A ⧸ nilradical A) := IsArtinianRing.of_finite L (A ⧸ nilradical A)
    haveI : IsReduced (A ⧸ nilradical A) :=
      (Ideal.isRadical_iff_quotient_reduced (nilradical A)).mp (Ideal.radical_isRadical ⊥)

    have vnr : ∀ b : A ⧸ nilradical A, ∃ t, b * b * t = b := by
      intro b
      obtain ⟨k, y, hy⟩ := IsArtinian.exists_pow_succ_smul_dvd b (1 : A ⧸ nilradical A)
      simp only [smul_eq_mul, mul_one, Nat.succ_eq_add_one] at hy
      refine ⟨y, ?_⟩
      obtain ⟨w, hw⟩ : ∃ w : A ⧸ nilradical A, w = 1 - b * y := ⟨_, rfl⟩
      have hc : b ^ k * (b * w) = 0 := by
        rw [hw]; linear_combination (-b) * hy
      have hnil : IsNilpotent (b * w) := by
        refine ⟨k + 1, ?_⟩
        rw [mul_pow, pow_succ w k]
        calc b ^ (k + 1) * (w ^ k * w) = w ^ k * (b ^ k * (b * w)) := by ring
          _ = 0 := by rw [hc, mul_zero]
      have h0 := hnil.eq_zero
      rw [hw] at h0
      linear_combination -h0
    let e : Γ(Spec (CommRingCat.of (A ⧸ nilradical A)), ⊤) ≃+* (A ⧸ nilradical A) :=
      (Scheme.ΓSpecIso (CommRingCat.of (A ⧸ nilradical A))).commRingCatIsoToRingEquiv
    have vnrΓ : ∀ f : Γ(Spec (CommRingCat.of (A ⧸ nilradical A)), ⊤), ∃ t, f * f * t = f := by
      intro f
      obtain ⟨t, ht⟩ := vnr (e f)
      refine ⟨e.symm t, ?_⟩
      apply e.injective
      rw [map_mul, map_mul, e.apply_symm_apply, ht]

    have hB : Subsingleton (wcEtCoh (Spec (CommRingCat.of (A ⧸ nilradical A))) ℓ n) := by
      refine wc_et_coh_vanish_of_vnr_fibres (Spec (CommRingCat.of (A ⧸ nilradical A)))
        (Spec (CommRingCat.of (A ⧸ nilradical A))) (𝟙 _) vnrΓ ℓ n (by omega) ?_
      intro p
      obtain ⟨E3⟩ := wc_et_coh_iso_invariance (Limits.pullback.snd
        (𝟙 (Spec (CommRingCat.of (A ⧸ nilradical A))))
        ((Spec (CommRingCat.of (A ⧸ nilradical A))).fromSpecResidueField p)) ℓ n
      let ρ : (A ⧸ nilradical A) →+* (Spec (CommRingCat.of (A ⧸ nilradical A))).residueField p :=
        ((Spec (CommRingCat.of (A ⧸ nilradical A))).evaluation ⊤ p trivial).hom.comp
          e.symm.toRingHom
      have hρ : Function.Surjective ρ :=
        (wc_vnr_evaluation_surjective _ vnrΓ p).comp e.symm.surjective
      letI : Algebra L ((Spec (CommRingCat.of (A ⧸ nilradical A))).residueField p) :=
        (ρ.comp (algebraMap L (A ⧸ nilradical A))).toAlgebra
      let ρa : (A ⧸ nilradical A) →ₐ[L]
          (Spec (CommRingCat.of (A ⧸ nilradical A))).residueField p :=
        { ρ with commutes' := fun r => rfl }
      haveI : FiniteDimensional L ((Spec (CommRingCat.of (A ⧸ nilradical A))).residueField p) :=
        Module.Finite.of_surjective ρa.toLinearMap hρ
      have hH := H ((Spec (CommRingCat.of (A ⧸ nilradical A))).residueField p) n hn
      have hκ : Subsingleton (wcEtCoh (Spec ((Spec (CommRingCat.of (A ⧸ nilradical A))).residueField
          p)) ℓ n) := ⟨fun a b => (hH a).trans (hH b).symm⟩
      exact @Equiv.subsingleton _ _ E3.symm hκ

    haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (nilradical A)))) :=
      IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
    have hr : Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (nilradical A)))) =
        Set.univ :=
      (PrimeSpectrum.comap_quotientMk_bijective_of_le_nilradical le_rfl).2.range_eq
    have hc := wc_et_fibre_coh_reduced_invariance (Spec (CommRingCat.of A)) (Spec (CommRingCat.of A))
      (Spec (CommRingCat.of A)) (Spec (CommRingCat.of (A ⧸ nilradical A))) (𝟙 _)
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (nilradical A)))) hr (𝟙 _) ℓ n
    obtain ⟨E4⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (nilradical A))) ≫ 𝟙 (Spec (CommRingCat.of A)))
      (𝟙 (Spec (CommRingCat.of A)))) ℓ n
    obtain ⟨E5⟩ := wc_et_coh_iso_invariance (Limits.pullback.fst (𝟙 (Spec (CommRingCat.of A)))
      (𝟙 (Spec (CommRingCat.of A)))) ℓ n
    have h1 : Nat.card (wcEtCoh (Spec (CommRingCat.of (A ⧸ nilradical A))) ℓ n) = 1 :=
      Nat.card_eq_one_iff_unique.mpr ⟨hB, nonemptyCoh _ _ _⟩
    have h2 : Nat.card (wcEtCoh (Spec (CommRingCat.of A)) ℓ n) = 1 := by
      rw [Nat.card_congr E5, ← hc, ← Nat.card_congr E4, h1]
    exact (Nat.card_eq_one_iff_unique.mp h2).1

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of L))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  refine wc_et_torsion_ext_vanish_of_fp (Spec (.of L)) inferInstance inferInstance ℓ N ?_ G hG q hq z
  intro U V g hU1 hU2 hV1 hV2 htor
  refine wc_et_fp_torsion_devissage_class L (Spec (.of L)) (𝟙 _) ℓ hℓ hℓL
    (fun A : Sheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of L))) AddCommGrpCat.{u+1} =>
      ∀ n : ℕ, N < n → ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
        (Spec (CommRingCat.of L))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) A n,
        x = 0)
    ?_ ?_ ?_ ?_ U V g hU1 hU2 hV1 hV2 htor
  · intro A B ⟨e⟩ hA n hn
    exact isoT _ _ A B e n (hA n hn)
  · intro S hS h1 h3 n hn
    exact sesT _ _ S hS n (h1 n hn) (h3 n hn)
  · intro A B s r hsr hB n hn
    exact retT _ _ A B s r hsr n (hB n hn)
  ·
    intro W π _ S _ hSd n hn x
    haveI : IsAffine W := isAffine_of_isAffineHom π

    have hfin : (π.appTop).hom.Finite :=
      ((isFinite_iff π).mp inferInstance).2 ⊤ (isAffineOpen_top _)
    let φ : L →+* Γ(W, ⊤) := (π.appTop).hom.comp (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom
    have hφ : φ.Finite := hfin.comp (RingHom.Finite.of_surjective _
      (fun y => ⟨(Scheme.ΓSpecIso (CommRingCat.of L)).hom.hom y, by simp⟩))
    letI : Algebra L Γ(W, ⊤) := φ.toAlgebra
    haveI : Module.Finite L Γ(W, ⊤) := hφ
    haveI : IsArtinianRing Γ(W, ⊤) := IsArtinianRing.of_finite L Γ(W, ⊤)

    haveI : DiscreteTopology W := (Scheme.homeoOfIso W.isoSpec.symm).discreteTopology
    have hSu : S = Set.univ := by rw [← hSd.closure_eq, (isClosed_discrete S).closure_eq]
    subst hSu

    obtain ⟨E⟩ := wc_et_finite_push_ext_equiv π (wcEtExtZero W Set.univ ℓ) n
    suffices hW : Subsingleton (wcEtExt W (wcEtExtZero W Set.univ ℓ) n) from
      E.injective (@Subsingleton.elim _ hW _ _)

    haveI : IsIso (wcEtExtZeroι W Set.univ ℓ) := by
      have key : ∀ {F G : (Scheme.Etale W)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (τ : F ⟶ G), IsIso τ →
          IsIso ((presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map τ) :=
        fun τ _ => inferInstance
      apply key
      refine @NatIso.isIso_of_isIso_app _ _ _ _ _ _ _ ?_
      intro V
      have mem : ∀ y : ULift.{u+1} (ZMod ℓ),
          y ∈ wcSuppSub.{u} ℓ (∀ x, V.unop.hom x ∈ (Set.univ : Set W)) :=
        fun y => AddSubgroup.mem_iSup_of_mem (fun x => Set.mem_univ _) (AddSubgroup.mem_top y)
      refine (ConcreteCategory.isIso_iff_bijective _).mpr ⟨fun a b h => Subtype.ext h, fun y =>
        ⟨(⟨y, mem y⟩ : ↥(wcSuppSub.{u} ℓ (∀ x, V.unop.hom x ∈ (Set.univ : Set W)))), rfl⟩⟩

    have hcohW : Subsingleton (wcEtCoh W ℓ n) := by
      obtain ⟨E2⟩ := wc_et_coh_iso_invariance W.isoSpec.hom ℓ n
      exact @Equiv.subsingleton _ _ E2.symm (FIN Γ(W, ⊤) n hn)
    have key := isoT W ((constantSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ _ (asIso (wcEtExtZeroι W Set.univ ℓ)).symm n
      (fun y => @Subsingleton.elim _ hcohW y _)
    exact ⟨fun a b => (key a).trans (key b).symm⟩

theorem wc_adjoin_algebraic_finite_ext : ∀ (K L L' : Type u) [Field K] [Field L] [Field L'] [Algebra K L] [Algebra L L'] [FiniteDimensional L L'] (n : ℕ) (t : Fin n → L), Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range t)) L → letI : Algebra K L' := ((algebraMap L L').comp (algebraMap K L)).toAlgebra; Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t))) L' :=
by
  intro K L L' _ _ _ _ _ _ n t hA
  letI : Algebra K L' := ((algebraMap L L').comp (algebraMap K L)).toAlgebra
  haveI : IsScalarTower K L L' := IsScalarTower.of_algebraMap_eq' rfl
  have s2 : ∀ a : IntermediateField.adjoin K (Set.range t),
      algebraMap L L' (a : L) ∈ IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t)) := by
    intro a
    have hle : IntermediateField.adjoin K (Set.range t) ≤
        IntermediateField.comap (IsScalarTower.toAlgHom K L L')
          (IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t))) := by
      rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨i, rfl⟩
      exact IntermediateField.subset_adjoin K (Set.range (algebraMap L L' ∘ t)) ⟨i, rfl⟩
    exact hle a.2
  let φ : IntermediateField.adjoin K (Set.range t) →+*
      IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t)) :=
    RingHom.codRestrict ((algebraMap L L').comp (algebraMap (IntermediateField.adjoin K (Set.range t)) L))
      (IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t))) (fun a => s2 a)
  have hφ : (algebraMap (IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t))) L').comp φ =
      (algebraMap L L').comp (algebraMap (IntermediateField.adjoin K (Set.range t)) L) :=
    RingHom.ext fun a => rfl
  have s4 : ∀ y : L,
      IsIntegral (IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t))) (algebraMap L L' y) :=
    fun y => (IsAlgebraic.ringHom_of_comp_eq φ (algebraMap L L') (hA.isAlgebraic y)
      φ.injective hφ).isIntegral
  haveI h5 : Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t)))
      (IntermediateField.adjoin (IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t)))
        (Set.range (algebraMap L L'))) :=
    IntermediateField.isAlgebraic_adjoin (by rintro _ ⟨y, rfl⟩; exact s4 y)
  haveI : Algebra.IsAlgebraic L L' := Algebra.IsAlgebraic.of_finite L L'
  let ψ : L →+* (IntermediateField.adjoin (IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t)))
        (Set.range (algebraMap L L'))) :=
    RingHom.codRestrict (algebraMap L L') _ (fun y => IntermediateField.subset_adjoin _ _ ⟨y, rfl⟩)
  have hψ : (algebraMap (IntermediateField.adjoin (IntermediateField.adjoin K
      (Set.range (algebraMap L L' ∘ t))) (Set.range (algebraMap L L'))) L').comp ψ =
      (RingHom.id L').comp (algebraMap L L') := RingHom.ext fun _ => rfl
  haveI h6 : Algebra.IsAlgebraic (IntermediateField.adjoin (IntermediateField.adjoin K
      (Set.range (algebraMap L L' ∘ t))) (Set.range (algebraMap L L'))) L' :=
    ⟨fun x => IsAlgebraic.ringHom_of_comp_eq ψ (RingHom.id L') (Algebra.IsAlgebraic.isAlgebraic x)
      ψ.injective hψ⟩
  exact Algebra.IsAlgebraic.trans (IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t)))
    (IntermediateField.adjoin (IntermediateField.adjoin K (Set.range (algebraMap L L' ∘ t)))
      (Set.range (algebraMap L L'))) L'

theorem wc_et_const_zmod_nsmul_zero : ∀ (X : Scheme.{u}) (ℓ : ℕ), ℓ • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) = 0 :=
by
  intro X ℓ
  have hx : ∀ x : ULift.{u+1} (ZMod ℓ), ℓ • x = 0 := by
    intro x
    apply ULift.ext
    change ℓ • x.down = (0 : ZMod ℓ)
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hA : ℓ • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) = 0 := by
    ext x
    first
      | exact hx x
      | simpa using hx x
      | (change ℓ • x = 0; exact hx x)
  rw [← (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map_id,
    ← Functor.map_nsmul, hA, Functor.map_zero]

theorem wc_et_residue_field_cd_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (x : Y) (D : ℕ), topologicalKrullDim ↥(closure ({x} : Set Y)) ≤ (D : WithBot ℕ∞) → ∀ (G : Sheaf (Scheme.smallEtaleTopology (Spec (Y.residueField x))) AddCommGrpCat.{u+1}), ℓ • 𝟙 G = 0 → letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (Y.residueField x))) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ m : ℕ, D < m → ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (Y.residueField x))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G m, z = 0 :=
by
  classical
  intro K _ _ Y f _ ℓ hℓ hℓK x D hD G hG m hm z

  have hℓE : ∀ (E : Type u) [Field E] [Algebra K E], (ℓ : E) ≠ 0 := by
    intro E _ _ h
    apply hℓK
    apply (algebraMap K E).injective
    rw [map_natCast, map_zero]
    exact h

  have P : ∀ n : ℕ, ∀ (L : Type u) [Field L] [Algebra K L] (t : Fin n → L),
      Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range t)) L →
      ∀ (G' : Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}), ℓ • 𝟙 G' = 0 →
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) :=
        HasExt.standard _
      ∀ m' : ℕ, n < m' → ∀ z' : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
        (Spec (.of L))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G' m',
        z' = 0 := by
    intro n
    induction n with
    | zero =>
      intro L _ _ t ht G' _ m' hm' z'
      have h0 : IntermediateField.adjoin K (Set.range t) = ⊥ := by
        rw [Set.range_eq_empty t, IntermediateField.adjoin_empty]
      rw [h0] at ht
      have halg : Algebra.IsAlgebraic K L := Algebra.IsAlgebraic.trans K (⊥ : IntermediateField K L) L
      obtain ⟨q, rfl⟩ : ∃ q, m' = q + 1 := ⟨m' - 1, by omega⟩
      exact wc_field_alg_over_algclosed_acyclic K L halg G' q z'
    | succ n ih =>

      have CONST : ∀ (M : Type u) [Field M] [Algebra K M] (s : Fin (n + 1) → M),
          Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range s)) M →
          ∀ q : ℕ, n + 1 < q →
          letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of M))) AddCommGrpCat.{u+1}) :=
            HasExt.standard _
          ∀ w : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of M)))
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
            ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of M))) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q, w = 0 := by
        intro M _ _ s hs q hq w
        obtain ⟨⟨t', ht'⟩, hτ⟩ := wc_adjoin_fin_succ_split K M n s hs
        let F := IntermediateField.adjoin K (Set.range (s ∘ Fin.castSucc))
        letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of ↥F)))
          AddCommGrpCat.{u+1}) := HasExt.standard _
        letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of M)))
          AddCommGrpCat.{u+1}) := HasExt.standard _
        haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of ↥F)))
          AddCommGrpCat.{u+1}) := wc_et_enough_injectives _
        haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of M)))
          AddCommGrpCat.{u+1}) := wc_et_enough_injectives _
        obtain ⟨Lπ, ⟨adj⟩, hlim, ⟨eL⟩⟩ :=
          wc_et_push_left_adjoint (Spec.map (CommRingCat.ofHom (algebraMap (↥F) M)))
        haveI := hlim
        haveI : Lπ.IsLeftAdjoint := adj.isLeftAdjoint
        haveI : Lπ.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
        haveI : Lπ.Additive := Functor.additive_of_preserves_binary_products _
        haveI : (wcEtPush (Spec.map (CommRingCat.ofHom (algebraMap (↥F) M)))).Additive :=
          Adjunction.right_adjoint_additive adj
        have hℓF : (ℓ : ↥F) ≠ 0 := hℓE ↥F
        have hL := wc_leray_ext_vanishing Lπ
          (wcEtPush (Spec.map (CommRingCat.ofHom (algebraMap (↥F) M)))) adj
          ((constantSheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of ↥F)))
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
          ((constantSheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of M)))
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
          (injectiveResolution _) (n + 1) (by
            intro p b hpb y
            by_cases hb : 2 ≤ b
            · have hz := wc_field_push_higher_vanish (↥F) M (s (Fin.last n)) hτ ℓ hℓ hℓF
                (fun k E _ _ _ _ s' hs' hk q' hq' =>
                  wc_field_sepclosed_curve_cd_one k E s' hs' ℓ hℓ hk q' hq')
                (injectiveResolution _) b hb
              calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) :=
                    (Abelian.Ext.comp_mk₀_id y).symm
                _ = y.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hz.eq_of_tgt (𝟙 _) 0]
                _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
            · have htors := wc_rightDerived_homology_nsmul_zero
                (wcEtPush (Spec.map (CommRingCat.ofHom (algebraMap (↥F) M))))
                ((constantSheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of M)))
                  AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
                (injectiveResolution _) ℓ (wc_et_const_zmod_nsmul_zero _ ℓ) b
              exact ih (↥F) t' ht' _ htors p (by omega) y)
        have h0 : (Abelian.Ext.mk₀ eL.hom).comp w (zero_add q) = 0 := hL q hq _
        calc w = (Abelian.Ext.mk₀ (𝟙 _)).comp w (zero_add q) := (Abelian.Ext.mk₀_id_comp w).symm
          _ = ((Abelian.Ext.mk₀ eL.inv).comp (Abelian.Ext.mk₀ eL.hom) (add_zero 0)).comp w
                (zero_add q) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id]
          _ = (Abelian.Ext.mk₀ eL.inv).comp ((Abelian.Ext.mk₀ eL.hom).comp w (zero_add q))
                (zero_add q) := Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega)
          _ = 0 := by rw [h0, Abelian.Ext.comp_zero]

      intro L _ _ t ht G' hG' m' hm' z'
      exact wc_field_torsion_cd_of_const L ℓ hℓ (hℓE L) (n + 1)
        (fun L' _ _ _ q hq => by
          letI : Algebra K L' := ((algebraMap L L').comp (algebraMap K L)).toAlgebra
          exact CONST L' (algebraMap L L' ∘ t)
            (wc_adjoin_algebraic_finite_ext K L L' (n + 1) t ht) q hq)
        G' hG' m' hm' z'

  letI : Algebra K (Y.residueField x) := (Spec.preimage (Y.fromSpecResidueField x ≫ f)).hom.toAlgebra
  obtain ⟨n, t, hn, ht⟩ := wc_lft_residue_algebraic_over_poly K Y f x D hD
  exact P n (Y.residueField x) t ht G hG m (by omega) z

theorem wc_et_limit_push_homology_affine_gen : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsAffineHom g] (A : Type u) [CommRing A] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ B.Etale) (φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left) (a : Spec (.of A) ⟶ B), (∀ l, IsAffine (W.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) → ∀ (H : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (I : InjectiveResolution H) (L : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (Limits.pullback g a)) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush (Limits.pullback.fst g a)) → Limits.PreservesFiniteLimits L → ∀ (q : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Limits.pullback g a)) AddCommGrpCat.{u+1}) := HasExt.standard _; Nonempty ((((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙ (Functor.whiskeringLeft (B.Etale)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (@Functor.op B.Etale _ X.Etale _ (wcEtBaseChange g)) ⋙ (Functor.whiskeringLeft Λᵒᵖ (B.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj W.op ⋙ Limits.colim).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q ≃ Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback g a)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (L.obj H) q) :=
by
  intro X B g _ A _ Λ _ _ W φ a haff hφ hφa hlim H I L hadj hPFL q
  obtain ⟨adj⟩ := hadj

  have pres : ∀ (XZ : Scheme.{u}) (p : XZ ⟶ X) (hZ : XZ ⟶ Spec (.of A)), IsPullback p hZ g a →
      ∃ π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange g).obj l).left,
        (∀ l, π l ≫ ((W ⋙ wcEtBaseChange g).obj l).hom = p) ∧
        (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange g).map t).left = π l') ∧
        (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange g).obj l).left),
          (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange g).map t).left = z l') →
          ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l) ∧
        (∀ l, CompactSpace ((W ⋙ wcEtBaseChange g).obj l).left) ∧
        (∀ l, QuasiSeparatedSpace ((W ⋙ wcEtBaseChange g).obj l).left) ∧
        (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom ((W ⋙ wcEtBaseChange g).map t).left) ∧
        CompactSpace XZ ∧ QuasiSeparatedSpace XZ ∧ XZ.IsSeparated := by
    intro XZ p hZ hpb
    have M1 : ∀ {l l' : Λ} (t : l ⟶ l'),
        ((W ⋙ wcEtBaseChange g).map t).left ≫ Limits.pullback.fst (W.obj l').hom g =
          Limits.pullback.fst (W.obj l).hom g ≫ (W.map t).left := by
      intro l l' t
      exact Limits.pullback.lift_fst _ _ _
    have M2 : ∀ {l l' : Λ} (t : l ⟶ l'),
        ((W ⋙ wcEtBaseChange g).map t).left ≫ Limits.pullback.snd (W.obj l').hom g =
          Limits.pullback.snd (W.obj l).hom g := by
      intro l l' t
      exact Limits.pullback.lift_snd _ _ _
    have hw : p ≫ g = hZ ≫ a := hpb.w
    have wl : ∀ l, (hZ ≫ φ l) ≫ (W.obj l).hom = p ≫ g := by
      intro l
      rw [Category.assoc, hφa l, hw]
    let π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange g).obj l).left := fun l =>
      Limits.pullback.lift (hZ ≫ φ l) p (wl l)
    have P1 : ∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom g = hZ ≫ φ l := fun l =>
      Limits.pullback.lift_fst _ _ _
    have P2 : ∀ l, π l ≫ Limits.pullback.snd (W.obj l).hom g = p := fun l =>
      Limits.pullback.lift_snd _ _ _
    have C2 : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange g).map t).left = π l' := by
      intro l l' t
      refine Limits.pullback.hom_ext (f := (W.obj l').hom) (g := g) ?_ ?_
      · calc (π l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫ Limits.pullback.fst (W.obj l').hom g
            = π l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
                Limits.pullback.fst (W.obj l').hom g) := Category.assoc _ _ _
          _ = π l ≫ (Limits.pullback.fst (W.obj l).hom g ≫ (W.map t).left) := whisker_eq _ (M1 t)
          _ = (π l ≫ Limits.pullback.fst (W.obj l).hom g) ≫ (W.map t).left :=
              (Category.assoc _ _ _).symm
          _ = (hZ ≫ φ l) ≫ (W.map t).left := eq_whisker (P1 l) _
          _ = hZ ≫ φ l' := by rw [Category.assoc, hφ t]
          _ = π l' ≫ Limits.pullback.fst (W.obj l').hom g := (P1 l').symm
      · calc (π l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫ Limits.pullback.snd (W.obj l').hom g
            = π l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
                Limits.pullback.snd (W.obj l').hom g) := Category.assoc _ _ _
          _ = π l ≫ Limits.pullback.snd (W.obj l).hom g := whisker_eq _ (M2 t)
          _ = p := P2 l
          _ = π l' ≫ Limits.pullback.snd (W.obj l').hom g := (P2 l').symm
    have C3 : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange g).obj l).left),
        (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange g).map t).left = z l') →
        ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l := by
      intro T z hz
      have hs : ∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ Limits.pullback.snd (W.obj l).hom g =
          z l' ≫ Limits.pullback.snd (W.obj l').hom g := by
        intro l l' t
        calc z l ≫ Limits.pullback.snd (W.obj l).hom g
            = z l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
                Limits.pullback.snd (W.obj l').hom g) := (whisker_eq _ (M2 t)).symm
          _ = (z l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫
                Limits.pullback.snd (W.obj l').hom g := (Category.assoc _ _ _).symm
          _ = z l' ≫ Limits.pullback.snd (W.obj l').hom g := eq_whisker (hz t) _
      obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
      have hX : ∀ l, z l ≫ Limits.pullback.snd (W.obj l).hom g =
          z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := fun l =>
        (hs (IsCofiltered.minToLeft l l₀)).symm.trans (hs (IsCofiltered.minToRight l l₀))
      have hf : ∀ {l l' : Λ} (t : l ⟶ l'), (z l ≫ Limits.pullback.fst (W.obj l).hom g) ≫
          (W.map t).left = z l' ≫ Limits.pullback.fst (W.obj l').hom g := by
        intro l l' t
        calc (z l ≫ Limits.pullback.fst (W.obj l).hom g) ≫ (W.map t).left
            = z l ≫ (Limits.pullback.fst (W.obj l).hom g ≫ (W.map t).left) := Category.assoc _ _ _
          _ = z l ≫ (((W ⋙ wcEtBaseChange g).map t).left ≫
                Limits.pullback.fst (W.obj l').hom g) := whisker_eq _ (M1 t).symm
          _ = (z l ≫ ((W ⋙ wcEtBaseChange g).map t).left) ≫
                Limits.pullback.fst (W.obj l').hom g := (Category.assoc _ _ _).symm
          _ = z l' ≫ Limits.pullback.fst (W.obj l').hom g := eq_whisker (hz t) _
      obtain ⟨y, hy, hyu⟩ := hlim T (fun l => z l ≫ Limits.pullback.fst (W.obj l).hom g) hf
      have hy' : ∀ l, y ≫ φ l = z l ≫ Limits.pullback.fst (W.obj l).hom g := hy
      have hxy : (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g) ≫ g = y ≫ a := by
        calc (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g) ≫ g
            = z l₀ ≫ (Limits.pullback.snd (W.obj l₀).hom g ≫ g) := Category.assoc _ _ _
          _ = z l₀ ≫ (Limits.pullback.fst (W.obj l₀).hom g ≫ (W.obj l₀).hom) :=
              whisker_eq _ Limits.pullback.condition.symm
          _ = (z l₀ ≫ Limits.pullback.fst (W.obj l₀).hom g) ≫ (W.obj l₀).hom :=
              (Category.assoc _ _ _).symm
          _ = (y ≫ φ l₀) ≫ (W.obj l₀).hom := eq_whisker (hy' l₀).symm _
          _ = y ≫ a := by rw [Category.assoc, hφa l₀]
      obtain ⟨z₀, hz₀p, hz₀Z⟩ : ∃ z₀ : T ⟶ XZ,
          z₀ ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g ∧ z₀ ≫ hZ = y :=
        ⟨hpb.lift _ y hxy, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
      refine ⟨z₀, fun l => ?_, fun z' hz' => ?_⟩
      · refine Limits.pullback.hom_ext (f := (W.obj l).hom) (g := g) ?_ ?_
        · calc (z₀ ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom g
              = z₀ ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom g) := Category.assoc _ _ _
            _ = z₀ ≫ (hZ ≫ φ l) := whisker_eq _ (P1 l)
            _ = (z₀ ≫ hZ) ≫ φ l := (Category.assoc _ _ _).symm
            _ = y ≫ φ l := eq_whisker hz₀Z _
            _ = z l ≫ Limits.pullback.fst (W.obj l).hom g := hy' l
        · calc (z₀ ≫ π l) ≫ Limits.pullback.snd (W.obj l).hom g
              = z₀ ≫ (π l ≫ Limits.pullback.snd (W.obj l).hom g) := Category.assoc _ _ _
            _ = z₀ ≫ p := whisker_eq _ (P2 l)
            _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := hz₀p
            _ = z l ≫ Limits.pullback.snd (W.obj l).hom g := (hX l).symm
      · have e1 : z' ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := by
          calc z' ≫ p = z' ≫ (π l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g) :=
                whisker_eq _ (P2 l₀).symm
            _ = (z' ≫ π l₀) ≫ Limits.pullback.snd (W.obj l₀).hom g := (Category.assoc _ _ _).symm
            _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom g := eq_whisker (hz' l₀) _
        have e2 : z' ≫ hZ = y := by
          apply hyu
          intro l
          calc (z' ≫ hZ) ≫ φ l = z' ≫ (hZ ≫ φ l) := Category.assoc _ _ _
            _ = z' ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom g) := whisker_eq _ (P1 l).symm
            _ = (z' ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom g := (Category.assoc _ _ _).symm
            _ = z l ≫ Limits.pullback.fst (W.obj l).hom g := eq_whisker (hz' l) _
        exact hpb.hom_ext (e1.trans hz₀p.symm) (e2.trans hz₀Z.symm)

    have keyA : ∀ {S T V : Scheme.{u}} (v : V ⟶ S) (h : T ⟶ S), IsAffineHom h → IsAffine V →
        IsAffine (Limits.pullback v h) := by
      intro S T V v h hh hV
      haveI : IsAffineHom (Limits.pullback.fst v h) :=
        MorphismProperty.of_isPullback (P := @IsAffineHom)
          (IsPullback.of_hasPullback v h).flip hh
      exact isAffine_of_isAffineHom (Limits.pullback.fst v h)
    have hlev : ∀ l, IsAffine ((W ⋙ wcEtBaseChange g).obj l).left := fun l =>
      keyA (W.obj l).hom g inferInstance (haff l)
    have C4 : ∀ l, CompactSpace ((W ⋙ wcEtBaseChange g).obj l).left := fun l => by
      haveI := hlev l
      infer_instance
    have C5 : ∀ l, QuasiSeparatedSpace ((W ⋙ wcEtBaseChange g).obj l).left := fun l => by
      haveI := hlev l
      infer_instance

    have C6 : ∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom ((W ⋙ wcEtBaseChange g).map t).left := by
      intro l l' t
      haveI := hlev l
      haveI := hlev l'
      exact @isAffineHom_of_isAffine _ _ _ (hlev l) (hlev l')

    haveI : IsAffineHom hZ := MorphismProperty.of_isPullback (P := @IsAffineHom) hpb inferInstance
    haveI : IsAffine XZ := isAffine_of_isAffineHom hZ
    have C7 : CompactSpace XZ := inferInstance
    have C8 : QuasiSeparatedSpace XZ := inferInstance
    have C9 : XZ.IsSeparated := inferInstance
    exact ⟨π, P2, C2, C3, C4, C5, C6, C7, C8, C9⟩
  obtain ⟨π, hπ, hπc, hπlim, hcpt, hqs, htaff, hZc, hZqs, hZsep⟩ :=
    pres (Limits.pullback g a) (Limits.pullback.fst g a) (Limits.pullback.snd g a)
      (IsPullback.of_hasPullback g a)

  haveI := hPFL
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L := inferInstance
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Limits.pullback g a)) AddCommGrpCat.{u+1}) :=
    HasExt.standard _

  obtain ⟨hH⟩ := wc_et_limit_sections_colim_iso (Limits.pullback.fst g a) L ⟨adj⟩ Λ
    (W ⋙ wcEtBaseChange g) π hπ hπc hπlim hcpt hqs htaff hZc hZqs

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 (Limits.pullback g a))) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨hS⟩ := wc_et_sections_coyoneda_iso (Limits.pullback g a) _ hT
  let P := (constantSheaf (Scheme.smallEtaleTopology (Limits.pullback g a))
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let K := (L.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  have hex : ∀ n : ℕ, K.ExactAt (n + 1) := by
    intro n
    rw [HomologicalComplex.exactAt_iff' K n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
      (CochainComplex.next ℕ (n + 1))]
    exact (I.exact_succ n).map L
  have hι0 : L.map (I.ι.f 0) ≫ L.map (I.cocomplex.d 0 1) = 0 := by
    rw [← L.map_comp, InjectiveResolution.ι_f_zero_comp_complex_d, L.map_zero]
  haveI : Mono (L.map (I.ι.f 0)) := L.map_mono _
  have h₀ : Limits.IsLimit (Limits.KernelFork.ofι (L.map (I.ι.f 0)) hι0) := by
    let S0 := ShortComplex.mk (I.ι.f 0) (I.cocomplex.d 0 1)
      (by rw [InjectiveResolution.ι_f_zero_comp_complex_d])
    have hE : (S0.map L).Exact := I.exact₀.map L
    haveI : Mono (S0.map L).f := (inferInstance : Mono (L.map (I.ι.f 0)))
    exact hE.fIsKernel
  let e₀ := (CochainComplex.isoHomologyπ₀ K).symm ≪≫
    Limits.IsLimit.conePointUniqueUpToIso (K.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0)) h₀ ≪≫
    L.mapIso (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 H)

  have hacyc : ∀ n k : ℕ, Subsingleton (Abelian.Ext P (K.X n) (k + 1)) := by
    intro n k
    haveI := I.injective n
    exact wc_et_pullback_injective_limit_acyclic (Limits.pullback.fst g a) L ⟨adj⟩ Λ
      (W ⋙ wcEtBaseChange g) π hπ hπc hπlim hcpt hqs htaff hZc hZqs hZsep (I.cocomplex.X n) k

  obtain ⟨E₂⟩ := wc_ext_acyclic_resolution_homology P K hex hacyc q
  let e := e₀
  let E₃ : Abelian.Ext P (K.homology 0) q ≃ Abelian.Ext P (L.obj H) q :=
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero q)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }

  let iso := (NatIso.mapHomologicalComplex (hH ≪≫ Functor.isoWhiskerLeft L hS)
      (ComplexShape.up ℕ)).app I.cocomplex ≪≫
    ((Functor.mapHomologicalComplexCompIso
      (Iso.refl (L ⋙ preadditiveCoyoneda.obj (Opposite.op P))) (ComplexShape.up ℕ)).app
        I.cocomplex).symm
  exact ⟨((HomologicalComplex.homologyMapIso iso q).addCommGroupIsoToAddEquiv.toEquiv).trans
    (E₂.trans E₃)⟩

theorem wc_et_shens_point_fibre_vnr : ∀ (Y : Scheme.{u}) (x y : Y) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ Y), wcHalShData y A Λ W' φ a → IsAffine (Limits.pullback (Y.fromSpecResidueField x) a) ∧ ∀ g : Γ(Limits.pullback (Y.fromSpecResidueField x) a, ⊤), ∃ s : Γ(Limits.pullback (Y.fromSpecResidueField x) a, ⊤), g * g * s = g :=
by
  intro Y x y A _ _ _ Λ _ _ W' φ a hd
  obtain ⟨-, haff, hcomp, hφa, hlim, -⟩ := hd

  haveI hiaff : IsAffineHom (Y.fromSpecResidueField x) := by
    constructor
    intro U _
    have hsub : ∀ p q : PrimeSpectrum (Y.residueField x), p = q := by
      intro p q
      apply PrimeSpectrum.ext
      rw [Ideal.eq_bot_of_prime p.asIdeal, Ideal.eq_bot_of_prime q.asIdeal]
    by_cases h : ∃ p, p ∈ (Y.fromSpecResidueField x) ⁻¹ᵁ U
    · obtain ⟨p, hp⟩ := h
      have htop : (Y.fromSpecResidueField x) ⁻¹ᵁ U = ⊤ := by
        ext q
        exact ⟨fun _ => trivial, fun _ => (hsub p q) ▸ hp⟩
      rw [htop]
      exact isAffineOpen_top _
    · have hbot : (Y.fromSpecResidueField x) ⁻¹ᵁ U = ⊥ := by
        ext q
        exact ⟨fun hq => (h ⟨q, hq⟩).elim, fun hq => by simp at hq⟩
      rw [hbot]
      exact isAffineOpen_bot _
  have hXaff : IsAffine (Limits.pullback (Y.fromSpecResidueField x) a) := inferInstance
  refine ⟨hXaff, ?_⟩

  have s1 : ∀ (G : Λ ⥤ Scheme.{u}) (X : Scheme.{u}) [IsAffine X] (ψ : ∀ l, X ⟶ G.obj l),
      (∀ l, IsAffine (G.obj l)) → (∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l') →
      (∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
        (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') → ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ ψ l = zz l) →
      ∀ f : Γ(X, ⊤), ∃ (l : Λ) (g : Γ(G.obj l, ⊤)), (ψ l).appTop g = f := by
    intro G X _ ψ hGa hψ hlim f
    let F : Λᵒᵖ ⥤ CommRingCat.{u} := G.op ⋙ Scheme.Γ
    have hnat : ∀ (i j : Λᵒᵖ) (f : i ⟶ j), F.map f ≫ (ψ j.unop).appTop = (ψ i.unop).appTop := by
      intro i j f
      rw [← hψ f.unop, Scheme.Hom.comp_appTop]
      rfl
    let c : Limits.Cocone F :=
      { pt := Γ(X, ⊤)
        ι := { app := fun l => (ψ l.unop).appTop
               naturality := fun i j f => by
                 erw [Category.comp_id]
                 exact hnat i j f } }
    let κ : Limits.colimit F ⟶ Γ(X, ⊤) := Limits.colimit.desc F c
    let ι' : ∀ l : Λ, Γ(G.obj l, ⊤) ⟶ Limits.colimit F := fun l =>
      Limits.colimit.ι F (Opposite.op l)
    have hκ : ∀ l : Λ, ι' l ≫ κ = (ψ l).appTop := fun l => Limits.colimit.ι_desc c (Opposite.op l)
    have hιw : ∀ {l l' : Λ} (t : l ⟶ l'), (G.map t).appTop ≫ ι' l = ι' l' := fun t =>
      Limits.colimit.w F t.op
    let ψ' : ∀ l, Spec (Limits.colimit F) ⟶ G.obj l := fun l =>
      Spec.map (ι' l) ≫ (G.obj l).isoSpec.inv
    have hψ' : ∀ {l l' : Λ} (t : l ⟶ l'), ψ' l ≫ G.map t = ψ' l' := by
      intro l l' t
      simp only [ψ']
      rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, ← Category.assoc, ← Spec.map_comp,
        hιw t]
    obtain ⟨z₀, hz₀, -⟩ := hlim _ ψ' hψ'
    obtain ⟨w, -, hwu⟩ := hlim X ψ hψ
    let ρ : X ⟶ Spec (Limits.colimit F) := X.isoSpec.hom ≫ Spec.map κ
    have hρ : ρ ≫ z₀ = 𝟙 X := by
      have e1 : ρ ≫ z₀ = w := hwu _ (fun l => by
        rw [Category.assoc, hz₀]
        simp only [ρ, ψ', Category.assoc]
        rw [← Category.assoc (Spec.map κ), ← Spec.map_comp, hκ l,
          Scheme.isoSpec_inv_naturality, Iso.hom_inv_id_assoc])
      have e2 : 𝟙 X = w := hwu _ (fun l => Category.id_comp _)
      rw [e1, e2]
    have h2 : Spec.map κ ≫ (z₀ ≫ X.isoSpec.hom) = 𝟙 _ := by
      have : Spec.map κ ≫ z₀ = X.isoSpec.inv := by
        rw [← Iso.hom_comp_eq_id, ← Category.assoc]
        exact hρ
      rw [← Category.assoc, this, Iso.inv_hom_id]
    let ζ : Γ(X, ⊤) ⟶ Limits.colimit F := Spec.preimage (z₀ ≫ X.isoSpec.hom)
    have hζκ : ζ ≫ κ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, h2, Spec.map_id]
    obtain ⟨j, g, hg⟩ := Limits.Concrete.colimit_exists_rep F (ζ f)
    refine ⟨j.unop, g, ?_⟩
    have e3 : κ (ζ f) = f := by
      show (ζ ≫ κ) f = f
      rw [hζκ]
      rfl
    have e4 : (ψ j.unop).appTop g = κ (ι' j.unop g) := by
      rw [← hκ j.unop]
      rfl
    rw [e4, ← e3, ← hg]
    rfl

  have s3 : ∀ (Ω : Type u) [Field Ω] (E : Scheme.{u}) [IsAffine E] (s : E ⟶ Spec (.of Ω)),
      Etale s → ∀ g : Γ(E, ⊤), ∃ t : Γ(E, ⊤), g * g * t = g := by
    intro Ω _ E _ s hs g
    have h1 : (s.appTop).hom.Etale := (HasRingHomProperty.iff_of_isAffine (P := @Etale)).mp hs
    have h2 : ((Scheme.ΓSpecIso (.of Ω)).inv).hom.Etale :=
      RingHom.Etale.of_bijective (ConcreteCategory.bijective_of_isIso _)
    have h3 : ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.Etale := by
      rw [CommRingCat.hom_comp]
      exact RingHom.Etale.stableUnderComposition _ _ h2 h1
    letI := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.toAlgebra
    have hE : Algebra.Etale Ω Γ(E, ⊤) := RingHom.Etale.toAlgebra h3
    obtain ⟨I, _, Ai, _, _, e, -⟩ := (Algebra.Etale.iff_exists_algEquiv_prod Ω Γ(E, ⊤)).mp hE
    refine ⟨e.symm (fun i => (e g i)⁻¹), ?_⟩
    apply e.injective
    rw [map_mul, map_mul, AlgEquiv.apply_symm_apply]
    funext i
    simp only [Pi.mul_apply]
    exact mul_self_mul_inv _

  have hw : ∀ {l l' : Λ} (t : l ⟶ l'),
      (W'.map t).right.left ≫ (W'.obj l').right.hom = (W'.obj l).right.hom := by
    intro l l' t
    have := (W'.map t).right.w
    simpa using this
  let h : ∀ l, (W'.obj l).right.left ⟶ Y := fun l => (W'.obj l).right.hom
  let mp : ∀ {l l' : Λ} (t : l ⟶ l'), Limits.pullback (Y.fromSpecResidueField x) (h l) ⟶
      Limits.pullback (Y.fromSpecResidueField x) (h l') :=
    fun t =>
    Limits.pullback.lift (Limits.pullback.fst _ _)
      (Limits.pullback.snd _ _ ≫ (W'.map t).right.left)
      (by rw [Category.assoc, hw t]; exact Limits.pullback.condition)
  have mp_fst : ∀ {l l' : Λ} (t : l ⟶ l'),
      mp t ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ :=
    fun t => Limits.pullback.lift_fst _ _ _
  have mp_snd : ∀ {l l' : Λ} (t : l ⟶ l'),
      mp t ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ (W'.map t).right.left := fun t =>
    Limits.pullback.lift_snd _ _ _
  let G : Λ ⥤ Scheme.{u} :=
    { obj := fun l => Limits.pullback (Y.fromSpecResidueField x) (h l)
      map := fun t => mp t
      map_id := fun l => by
        apply Limits.pullback.hom_ext
        · rw [mp_fst, Category.id_comp]
        · rw [mp_snd, Category.id_comp, W'.map_id]
          rfl
      map_comp := fun {l₁ l₂ l₃} t₁ t₂ => by
        apply Limits.pullback.hom_ext
        · rw [mp_fst, Category.assoc, mp_fst, mp_fst]
        · rw [mp_snd, Category.assoc, mp_snd, ← Category.assoc, mp_snd, Category.assoc,
            W'.map_comp]
          rfl }
  have Gmap_fst : ∀ {l l' : Λ} (t : l ⟶ l'),
      G.map t ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l') =
        Limits.pullback.fst (Y.fromSpecResidueField x) (h l) := mp_fst
  have Gmap_snd : ∀ {l l' : Λ} (t : l ⟶ l'),
      G.map t ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l') =
        Limits.pullback.snd (Y.fromSpecResidueField x) (h l) ≫ (W'.map t).right.left := mp_snd
  let ψ : ∀ l, Limits.pullback (Y.fromSpecResidueField x) a ⟶ G.obj l := fun l =>
    Limits.pullback.lift (Limits.pullback.fst (Y.fromSpecResidueField x) a)
      (Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ φ l)
      (by rw [Category.assoc]; erw [hφa l]; exact Limits.pullback.condition)
  have ψ_fst : ∀ l, ψ l ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l) =
      Limits.pullback.fst (Y.fromSpecResidueField x) a :=
    fun l => Limits.pullback.lift_fst _ _ _
  have ψ_snd : ∀ l, ψ l ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l) =
      Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ φ l := fun l =>
    Limits.pullback.lift_snd _ _ _
  let sG : ∀ l, G.obj l ⟶ Spec (Y.residueField x) := fun l =>
    Limits.pullback.fst (Y.fromSpecResidueField x) (h l)
  have hGaff : ∀ l, IsAffine (G.obj l) := by
    intro l
    haveI := haff l
    show IsAffine (Limits.pullback (Y.fromSpecResidueField x) (h l))
    infer_instance
  have hGet : ∀ l, Etale (sG l) := by
    intro l
    haveI : Etale (h l) := (W'.obj l).right.prop
    show Etale (Limits.pullback.fst (Y.fromSpecResidueField x) (h l))
    infer_instance
  have hψc : ∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l' := by
    intro l l' t
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Gmap_fst, ψ_fst, ψ_fst]
    · rw [Category.assoc, Gmap_snd, ← Category.assoc, ψ_snd, Category.assoc, hcomp, ψ_snd]
  have hψlim : ∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
      (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') →
        ∃! z₀ : T ⟶ Limits.pullback (Y.fromSpecResidueField x) a, ∀ l, z₀ ≫ ψ l = zz l := by
    intro T zz hzz
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hfst1 : ∀ {l l' : Λ} (t : l ⟶ l'),
        zz l ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l) =
          zz l' ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l') := by
      intro l l' t
      rw [← hzz t, Category.assoc, Gmap_fst]
    have hfst : ∀ l l' : Λ,
        zz l ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l) =
          zz l' ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l') := by
      intro l l'
      rw [← hfst1 (IsCofiltered.minToLeft l l'), hfst1 (IsCofiltered.minToRight l l')]
    let v : T ⟶ Spec (Y.residueField x) :=
      zz l₀ ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l₀)
    have hzz' : ∀ {l l' : Λ} (t : l ⟶ l'),
        (zz l ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l)) ≫ (W'.map t).right.left =
          zz l' ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l') := by
      intro l l' t
      rw [← hzz t, Category.assoc, Category.assoc, Gmap_snd]
    obtain ⟨w, hw1, hw2⟩ :=
      hlim T (fun l => zz l ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l)) hzz'
    have hwa : v ≫ Y.fromSpecResidueField x = w ≫ a := by
      rw [← hφa l₀, ← Category.assoc, hw1 l₀]
      simp only [v, Category.assoc]
      exact congrArg (zz l₀ ≫ ·) Limits.pullback.condition
    refine ⟨Limits.pullback.lift v w hwa, fun l => ?_, fun z₁ hz₁ => ?_⟩
    · apply Limits.pullback.hom_ext
      · rw [Category.assoc, ψ_fst, Limits.pullback.lift_fst]
        exact hfst l₀ l
      · rw [Category.assoc, ψ_snd, ← Category.assoc, Limits.pullback.lift_snd]
        exact hw1 l
    · apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, ← ψ_fst l₀, ← Category.assoc, hz₁ l₀]
      · rw [Limits.pullback.lift_snd]
        apply hw2
        intro l
        rw [Category.assoc, ← ψ_snd, ← Category.assoc, hz₁ l]

  intro g
  obtain ⟨l, g₀, hg⟩ := s1 G (Limits.pullback (Y.fromSpecResidueField x) a) ψ hGaff hψc hψlim g
  haveI := hGaff l
  obtain ⟨t₀, ht₀⟩ := s3 (Y.residueField x) (G.obj l) (sG l) (hGet l) g₀
  refine ⟨(ψ l).appTop t₀, ?_⟩
  rw [← hg, ← map_mul, ← map_mul, ht₀]

theorem wc_lft_point_closure_algIndep : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f] (y : Y) (t : ℕ), (t : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set Y)) → letI : Algebra K (Y.residueField y) := (Spec.preimage (Y.fromSpecResidueField y ≫ f)).hom.toAlgebra; ∃ g : Fin t → Y.residueField y, AlgebraicIndependent K g :=
by
  classical
  intro K _ Y f _ y t ht
  letI iK : Algebra K (Y.residueField y) :=
    (Spec.preimage (Y.fromSpecResidueField y ≫ f)).hom.toAlgebra

  have ht' : (t : WithBot ℕ∞) ≤
      Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥(closure ({y} : Set Y))) := ht
  obtain ⟨l, hl⟩ := Order.le_krullDim_iff.mp ht'
  subst hl
  have hSc : IsClosed (closure ({y} : Set Y)) := isClosed_closure
  obtain ⟨V, hVdef⟩ : ∃ V : Fin (l.length + 1) → Set Y,
      V = fun i => Subtype.val '' ((l i : TopologicalSpace.IrreducibleCloseds _) :
        Set ↥(closure ({y} : Set Y))) := ⟨_, rfl⟩
  have hVc : ∀ i, IsClosed (V i) := by
    intro i; rw [hVdef]; exact hSc.isClosedMap_subtype_val _ (l i).isClosed
  have hVi : ∀ i, IsIrreducible (V i) := by
    intro i; rw [hVdef]
    exact (l i).isIrreducible.image _ continuous_subtype_val.continuousOn
  have hVS : ∀ i, V i ⊆ closure ({y} : Set Y) := by
    intro i; rw [hVdef]; rintro _ ⟨z, _, rfl⟩; exact z.2
  have hVmono : ∀ i j, i ≤ j → V i ⊆ V j := by
    intro i j h; rw [hVdef]
    exact Set.image_mono (SetLike.coe_subset_coe.mpr (l.strictMono.monotone h))
  have hVne : ∀ i j, i < j → V i ≠ V j := by
    intro i j h heq
    rw [hVdef] at heq
    have h1 := Set.image_injective.mpr Subtype.val_injective heq
    exact (l.strictMono h).ne (SetLike.coe_injective h1)

  obtain ⟨η, hηdef⟩ : ∃ η : Fin (l.length + 1) → Y, η = fun i => (hVi i).genericPoint :=
    ⟨_, rfl⟩
  have hη : ∀ i, IsGenericPoint (η i) (V i) := by
    intro i; rw [hηdef]; exact (hVi i).isGenericPoint_genericPoint (hVc i)

  obtain ⟨U, hU0, hηU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens Y)) (show η 0 ∈ (⊤ : Y.Opens) from trivial)
  have hU : IsAffineOpen U := hU0
  have hmemU : ∀ z, z ⤳ η 0 → z ∈ U := fun z h => h.mem_open U.isOpen hηU
  have hη0 : ∀ i, η i ⤳ η 0 := fun i =>
    (hη i).specializes (hVmono 0 i (Fin.zero_le i) (hη 0).mem)
  have hy0 : y ⤳ η 0 := specializes_iff_mem_closure.mpr (hVS 0 (hη 0).mem)
  have hyU : y ∈ U := hmemU y hy0
  have hηU' : ∀ i, η i ∈ U := fun i => hmemU _ (hη0 i)
  have hInd : Topology.IsInducing hU.fromSpec := hU.fromSpec.isOpenEmbedding.isInducing
  have key : ∀ (a b : Y) (ha : a ∈ U) (hb : b ∈ U),
      hU.primeIdealOf ⟨a, ha⟩ ≤ hU.primeIdealOf ⟨b, hb⟩ ↔ a ⤳ b := by
    intro a b ha hb
    rw [PrimeSpectrum.le_iff_specializes]
    have h := hInd.specializes_iff (x := hU.primeIdealOf ⟨a, ha⟩) (y := hU.primeIdealOf ⟨b, hb⟩)
    rw [hU.fromSpec_primeIdealOf, hU.fromSpec_primeIdealOf] at h
    exact h.symm
  obtain ⟨P, hPdef⟩ : ∃ P : Fin (l.length + 1) → PrimeSpectrum Γ(Y, U),
      P = fun i => hU.primeIdealOf ⟨η i, hηU' i⟩ := ⟨_, rfl⟩
  have hPanti : ∀ i j, i < j → P j < P i := by
    intro i j h
    have hle : P j ≤ P i := by
      rw [hPdef]
      exact (key _ _ _ _).mpr ((hη j).specializes (hVmono i j h.le (hη i).mem))
    refine lt_of_le_of_ne hle (fun heq => hVne i j h ?_)
    have h2 := congrArg hU.fromSpec heq
    rw [hPdef] at h2
    simp only [hU.fromSpec_primeIdealOf] at h2
    calc V i = closure {η i} := (hη i).def.symm
      _ = closure {η j} := by rw [h2]
      _ = V j := (hη j).def
  have hyP : ∀ i, hU.primeIdealOf ⟨y, hyU⟩ ≤ P i := by
    intro i
    rw [hPdef]
    exact (key _ _ _ _).mpr (specializes_iff_mem_closure.mpr (hVS i (hη i).mem))

  set p : Ideal Γ(Y, U) := (hU.primeIdealOf ⟨y, hyU⟩).asIdeal with hp
  have hcm : ∀ k, Ideal.comap (Ideal.Quotient.mk p) (Ideal.map (Ideal.Quotient.mk p)
      (P k).asIdeal) = (P k).asIdeal := by
    intro k
    rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact sup_eq_left.mpr (hyP k)
  let Q : Fin (l.length + 1) → PrimeSpectrum (Γ(Y, U) ⧸ p) := fun k =>
    ⟨Ideal.map (Ideal.Quotient.mk p) (P (Fin.rev k)).asIdeal,
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by rw [Ideal.mk_ker]; exact hyP _)⟩
  have hQ : StrictMono Q := by
    intro a b hab
    have h : P (Fin.rev a) < P (Fin.rev b) := hPanti _ _ (Fin.rev_lt_rev.mpr hab)
    rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
    refine lt_of_le_of_ne (Ideal.map_mono ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr h.le)) ?_
    intro heq
    apply h.ne
    ext1
    rw [← hcm (Fin.rev a), ← hcm (Fin.rev b)]
    exact congrArg (Ideal.comap (Ideal.Quotient.mk p)) heq
  have hdim : (l.length : WithBot ℕ∞) ≤ ringKrullDim (Γ(Y, U) ⧸ p) :=
    Order.LTSeries.length_le_krullDim (LTSeries.mk l.length Q hQ)

  set ev : Γ(Y, U) →+* Y.residueField y := (Y.evaluation U y hyU).hom with hev
  have hker : ∀ a : Γ(Y, U), ev a = 0 ↔ a ∈ p := by
    letI : Algebra Γ(Y, U) (Y.presheaf.stalk y) :=
      TopCat.Presheaf.algebra_section_stalk Y.presheaf (⟨y, hyU⟩ : U)
    haveI : IsLocalization.AtPrime (Y.presheaf.stalk y) (hU.primeIdealOf ⟨y, hyU⟩).asIdeal :=
      hU.isLocalization_stalk ⟨y, hyU⟩
    have hev' : ∀ a, (Y.evaluation U y hyU).hom a =
        (Y.residue y).hom (algebraMap Γ(Y, U) (Y.presheaf.stalk y) a) := by
      intro a; rw [← Scheme.germ_residue]; rfl
    intro a
    rw [hev, hev']
    show IsLocalRing.residue _ _ = 0 ↔ _
    rw [IsLocalRing.residue_eq_zero_iff]
    exact IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ _
  set φ : K →+* Γ(Y, U) :=
    (f.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom with hφ
  have ALG : ∀ c : K, algebraMap K (Y.residueField y) c = ev (φ c) := by
    intro c
    have hD : Spec.preimage (Y.fromSpecResidueField y ≫ f) =
        (Scheme.ΓSpecIso (.of K)).inv ≫ f.appTop ≫ Y.presheaf.germ ⊤ y trivial ≫
          Y.residue y := by
      apply Spec.map_injective
      rw [Spec.map_preimage]
      simp only [Spec.map_comp, Category.assoc]
      rw [← Scheme.fromSpecStalk_toSpecΓ_assoc, ← Scheme.toSpecΓ_naturality_assoc,
        toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id, ← Category.assoc]
      rfl
    have hE : f.appLE ⊤ U le_top ≫ Y.evaluation U y hyU =
        f.appTop ≫ Y.presheaf.germ ⊤ y trivial ≫ Y.residue y := by
      rw [← Scheme.germ_residue]
      have h1 : f.appLE ⊤ U le_top =
          f.app ⊤ ≫ Y.presheaf.map (homOfLE (le_top : U ≤ f ⁻¹ᵁ ⊤)).op := rfl
      rw [h1, Category.assoc]
      erw [TopCat.Presheaf.germ_res_assoc]
      rfl
    show (Spec.preimage (Y.fromSpecResidueField y ≫ f)).hom c = _
    rw [hD, ← hE]
    rfl
  letI iA : Algebra K Γ(Y, U) := φ.toAlgebra
  haveI hftA : Algebra.FiniteType K Γ(Y, U) := by
    have h1 : (f.appLE ⊤ U le_top).hom.FiniteType :=
      LocallyOfFiniteType.finiteType_appLE f (isAffineOpen_top (Spec (.of K))) hU le_top
    have h2 : (Scheme.ΓSpecIso (.of K)).inv.hom.FiniteType := by
      apply RingHom.FiniteType.of_surjective
      intro c
      refine ⟨(Scheme.ΓSpecIso (.of K)).hom.hom c, ?_⟩
      rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
    exact h1.comp h2
  haveI : Algebra.FiniteType K (Γ(Y, U) ⧸ p) := Algebra.FiniteType.quotient K p
  let ι0 : Γ(Y, U) ⧸ p →+* Y.residueField y :=
    Ideal.Quotient.lift p ev (fun a ha => (hker a).mpr ha)
  let ι : Γ(Y, U) ⧸ p →ₐ[K] Y.residueField y :=
    { ι0 with
      commutes' := fun c => by
        show ι0 (Ideal.Quotient.mk p (φ c)) = _
        rw [Ideal.Quotient.lift_mk, ALG c] }
  have hιmk : ∀ a, ι (Ideal.Quotient.mk p a) = ev a := fun a => Ideal.Quotient.lift_mk _ _ _
  have hιinj : Function.Injective ι := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [hιmk] at hz
    exact Ideal.Quotient.eq_zero_iff_mem.mpr ((hker a).mp hz)

  obtain ⟨s, G, hGinj, hGfin⟩ := exists_finite_inj_algHom_of_fg K (Γ(Y, U) ⧸ p)
  have hdle : ringKrullDim (Γ(Y, U) ⧸ p) ≤ ringKrullDim (MvPolynomial (Fin s) K) := by
    letI : Algebra (MvPolynomial (Fin s) K) (Γ(Y, U) ⧸ p) := G.toRingHom.toAlgebra
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) K) (Γ(Y, U) ⧸ p) :=
      ⟨RingHom.IsIntegral.of_finite hGfin⟩
    let c : PrimeSpectrum (Γ(Y, U) ⧸ p) → PrimeSpectrum (MvPolynomial (Fin s) K) :=
      fun Q => ⟨Ideal.under _ Q.asIdeal, inferInstance⟩
    have hc : StrictMono c := by
      intro Q₁ Q₂ h
      rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
      exact Ideal.IsIntegral.under_lt_under ((PrimeSpectrum.asIdeal_lt_asIdeal _ _).mpr h)
    exact Order.krullDim_le_of_strictMono c hc
  have hpoly : ringKrullDim (MvPolynomial (Fin s) K) = ((s : ℕ∞) : WithBot ℕ∞) := by
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
      ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
  have hts' := hdim.trans (hdle.trans hpoly.le)
  have hts : l.length ≤ s := by exact_mod_cast hts'

  have hind : AlgebraicIndependent K
      (ι ∘ (G ∘ (MvPolynomial.X ∘ Fin.castLE hts))) :=
    (((MvPolynomial.algebraicIndependent_X (Fin s) K).comp _
      (Fin.castLE_injective hts)).map' hGinj).map' hιinj
  exact ⟨_, hind⟩

theorem wc_et_shens_point_fibre_residue_trdeg_le : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f] (x y : Y) (D : ℕ), topologicalKrullDim ↥(closure ({x} : Set Y)) ≤ (D : WithBot ℕ∞) → ∀ (B : Type u) [CommRing B] [IsLocalRing B] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData y B Λ W' φ a → ∀ p : ↥(Limits.pullback (Y.fromSpecResidueField x) a), letI : Algebra K ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) := (Spec.preimage ((Limits.pullback (Y.fromSpecResidueField x) a).fromSpecResidueField p ≫ Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ a ≫ f)).hom.toAlgebra; Algebra.trdeg K ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) ≤ D :=
by
  classical
  intro K _ Y f _ x y D hx B _ _ Λ _ _ W' φ a hsh p


  have LFT : letI : Algebra K (Y.residueField x) :=
      (Spec.preimage (Y.fromSpecResidueField x ≫ f)).hom.toAlgebra;
      ∃ (n : ℕ) (t : Fin n → Y.residueField x), n ≤ D ∧
        Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range t)) (Y.residueField x) := by
    letI iK : Algebra K (Y.residueField x) :=
      (Spec.preimage (Y.fromSpecResidueField x ≫ f)).hom.toAlgebra

    have GU : ∀ (R S : Type u) [CommRing R] [CommRing S] (g : R →+* S),
        Function.Injective g → g.IsIntegral → ringKrullDim R ≤ ringKrullDim S := by
      intro R S _ _ g hinj hint
      letI := g.toAlgebra
      haveI : Algebra.IsIntegral R S := ⟨hint⟩
      have key : ∀ P : LTSeries (PrimeSpectrum R), ∃ Q : LTSeries (PrimeSpectrum S),
          Q.length = P.length ∧ Ideal.under R Q.last.asIdeal = P.last.asIdeal := by
        intro P
        induction P using RelSeries.inductionOn' with
        | singleton P0 =>
          obtain ⟨Q, -, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P0.asIdeal
            (⊥ : Ideal S)
            (by rw [Ideal.under, Ideal.comap_bot_of_injective (algebraMap R S) hinj]; exact bot_le)
          exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQP⟩
        | snoc P P' hP ih =>
          obtain ⟨Q, hlen, hQ⟩ := ih
          have hP' : P.last < P' := hP
          obtain ⟨Q', hle, hQ', hQ'P⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
            P'.asIdeal Q.last.asIdeal (by rw [hQ]; exact le_of_lt hP')
          have hlt : Q.last < (⟨Q', hQ'⟩ : PrimeSpectrum S) := by
            refine lt_of_le_of_ne hle ?_
            intro h
            apply ne_of_lt hP'
            ext1
            rw [← hQ, ← hQ'P, h]
          exact ⟨Q.snoc ⟨Q', hQ'⟩ hlt, by simp [hlen], by simpa using hQ'P⟩
      unfold ringKrullDim Order.krullDim
      apply iSup_le
      intro P
      obtain ⟨Q, hlen, -⟩ := key P
      rw [← hlen]
      exact Order.LTSeries.length_le_krullDim Q

    have NA : ∀ (B : Type u) [CommRing B] [Algebra K B] (n : ℕ)
        (g : MvPolynomial (Fin n) K →ₐ[K] B) (ι : B →ₐ[K] Y.residueField x), g.Finite →
        (∀ z : Y.residueField x, ∃ a b : B, ι b ≠ 0 ∧ z * ι b = ι a) →
        Algebra.IsAlgebraic (IntermediateField.adjoin K
          (Set.range (fun i => ι (g (MvPolynomial.X i))))) (Y.residueField x) := by
      intro B _ _ n g ι hg hfr
      set E := IntermediateField.adjoin K (Set.range (fun i => ι (g (MvPolynomial.X i)))) with hE
      have hmem : ∀ P : MvPolynomial (Fin n) K, ι (g P) ∈ E := by
        intro P
        induction P using MvPolynomial.induction_on with
        | C a =>
          rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, AlgHom.commutes]
          exact E.algebraMap_mem a
        | add p q hp hq => rw [map_add, map_add]; exact E.add_mem hp hq
        | mul_X p i hp =>
          rw [map_mul, map_mul]
          exact E.mul_mem hp (IntermediateField.subset_adjoin K _ ⟨i, rfl⟩)
      let φ0 : MvPolynomial (Fin n) K →+* E :=
        RingHom.codRestrict (((ι : B →+* Y.residueField x)).comp (g : MvPolynomial (Fin n) K →+* B))
          E hmem
      have hint : ∀ b : B, IsIntegral E (ι b) := by
        intro b
        letI : Algebra (MvPolynomial (Fin n) K) B := (g : MvPolynomial (Fin n) K →+* B).toAlgebra
        have hb : IsIntegral (MvPolynomial (Fin n) K) b := RingHom.IsIntegral.of_finite hg b
        exact IsIntegral.map_of_comp_eq φ0 (ι : B →+* Y.residueField x) (by ext <;> rfl) hb
      refine ⟨fun z => ?_⟩
      obtain ⟨a, b, hb, h⟩ := hfr z
      have hz : z = ι a * (ι b)⁻¹ := by rw [← h, mul_assoc, mul_inv_cancel₀ hb, mul_one]
      rw [hz]
      exact (hint a).isAlgebraic.mul (hint b).isAlgebraic.inv

    obtain ⟨U, hU0, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens Y)) (show x ∈ (⊤ : Y.Opens) from trivial)
    have hU : IsAffineOpen U := hU0
    set pI : Ideal Γ(Y, U) := (hU.primeIdealOf ⟨x, hxU⟩).asIdeal with hpI
    set ev : Γ(Y, U) →+* Y.residueField x := (Y.evaluation U x hxU).hom with hev

