        (((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ).obj (Opposite.op U))).hom
          x.down = 0 :=
      congrArg ULift.down hx
    obtain ⟨r, c, hrc, hφ⟩ := wc_lpsk_ring_exact ℓ n D k _ x.down hz
    obtain ⟨R, hR, hroots⟩ := hroot U r c hrc
    refine ⟨R, hR, fun V i hi => ?_⟩
    obtain ⟨y, hy⟩ := hφ _ (((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ).map i.op)
      (fun j => by
        obtain ⟨s, hs⟩ := hroots V i hi j
        exact ⟨s, Units.ext ((Units.val_pow_eq_pow_val _ _).trans hs)⟩)
    exact ⟨ULift.up y, ULift.ext _ _ hy⟩
  ·
    constructor
    intro U z
    obtain ⟨r, c, hrc, hφ⟩ := wc_lpsk_ring_surj ℓ n D k _ z.down
    obtain ⟨R, hR, hroots⟩ := hroot U r c hrc
    refine (Scheme.smallEtaleTopology Y).superset_covering ?_ hR
    intro V i hi
    obtain ⟨y, hy⟩ := hφ _ (((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ).map i.op)
