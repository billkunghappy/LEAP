    refine ⟨Z, ε₁, ρ, ?_, ?_⟩
    · intro Y
      refine bij_help
        (fun φ : Z ⟶ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y =>
          φ.hom.app (Opposite.op (Over.mk (𝟙 U))) γ)
        (fun f : wcFreeSheaf S U ⟶ Y =>
          ε₁ ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map f)
        (fun f : wcFreeSheaf S U ⟶ Y => f.hom.app (Opposite.op U) γU)
        (hZ _) (hUb Y) (fun f => ?_)
