      haveI := (isAffineOpen_top X).isLocalization_stalk ⟨q, trivial⟩
      obtain ⟨⟨a, m⟩, rfl⟩ := IsLocalization.mk'_surjective
        ((isAffineOpen_top X).primeIdealOf ⟨q, trivial⟩).asIdeal.primeCompl s
      have hgr : ∀ c : Γ(X, ⊤), (X.residue q).hom ((X.presheaf.germ ⊤ q trivial).hom c) = ε c := by
        intro c
        show _ = (X.evaluation ⊤ q trivial).hom c
