    haveI : Algebra.FiniteType K (Γ(Y, U) ⧸ pI) := Algebra.FiniteType.quotient K pI
    obtain ⟨n, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg K (Γ(Y, U) ⧸ pI)
    let ι0 : Γ(Y, U) ⧸ pI →+* Y.residueField x :=
