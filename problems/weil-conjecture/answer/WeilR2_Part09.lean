        rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
        exact Set.eq_univ_of_forall fun v => Set.mem_iUnion.mpr ⟨v, hv v⟩
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rw [Sieve.ofArrows, Sieve.generate_le_iff]
      intro W f hf
      cases hf with
      | mk v => exact he v
    have s3 : ∀ (V : Y.Etale) (v : V.left), v ∉ Set.range (Limits.pullback.fst V.hom i) →
        ∃ (V' : Y.Etale) (e : V' ⟶ V), v ∈ Set.range e.left ∧
