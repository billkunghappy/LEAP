      rw [← hι, RingHom.mem_ker, ← hm, F0, hx, map_zero]
    · rw [Ideal.span_le, Set.range_subset_iff]
      intro k
      show iV.appTop.hom (φ.appTop.hom (h k)) = 0
      rw [← F0, ← hsq.w, F0, hk, map_zero]

  have s5 : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) {c : ℕ} (W₁ W : X.Opens) (hle : W ≤ W₁) (h₁ : Fin c → Γ(W₁, ⊤)), wcEtCutOut (i ∣_ W₁) h₁ → IsAffineOpen W → ∀ (ZW : Scheme.{u}) (iW : ZW ⟶ W) (gW : ZW ⟶ Z), IsPullback gW iW i W.ι → wcEtCutOut iW (fun k => (X.homOfLE hle).appTop.hom (h₁ k)) := by
    intro X Z i c W₁ W hle h₁ hcut hWa ZW iW gW hsq
