  have t_s3a : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i], (∀ {T V : Scheme.{u}} (j : T ⟶ V) [IsClosedImmersion j] {W : Scheme.{u}} (w : W ⟶ T) [Etale w] (x : W), ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ W) (x' : ↥(Limits.pullback e j)), h ≫ w = Limits.pullback.snd e j ∧ h x' = x) → ∀ (P Q : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (α : P ⟶ Q), (∀ U : Z.Etale, IsEmpty U.left → Subsingleton ↑(P.obj (Opposite.op U))) → Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Z) α → Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) (Functor.whiskerLeft (wcEtBaseChange i).op α) := by
