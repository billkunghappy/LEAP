      exact (E.symm_apply_apply _).symm
    rw [heq]
    exact RingHom.isStandardSmoothOfRelativeDimension_respectsIso.1 _ E.symm hstd

  have cbc : ∀ {W Z V ZV : Scheme.{u}} (iW : Z ⟶ W) {c : ℕ} (h : Fin c → Γ(W, ⊤)) (φ : V ⟶ W) (iV : ZV ⟶ V) (g : ZV ⟶ Z), wcEtCutOut iW h → IsAffine V → IsPullback g iV iW φ → wcEtCutOut iV (fun k => φ.appTop.hom (h k)) := by
    intro W Z V ZV iW c h φ iV g hcut hV hsq
