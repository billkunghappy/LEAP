      rw [Spec.map_preimage, Category.assoc, Limits.pullback.condition_assoc]
    rw [e1, Spec.preimage_comp, Spec.preimage_map,
      S7 (Limits.pullback (Y.fromSpecResidueField x) a) (Y.residueField x)
        (Limits.pullback.fst (Y.fromSpecResidueField x) a) p]

  obtain ⟨-, haff, hcomp, hφa, hlim, -⟩ := hsh
  haveI hiaff : IsAffineHom (Y.fromSpecResidueField x) := by
    constructor
    intro U _
    have hsub : ∀ p q : PrimeSpectrum (Y.residueField x), p = q := by
      intro p q
      apply PrimeSpectrum.ext
      rw [Ideal.eq_bot_of_prime p.asIdeal, Ideal.eq_bot_of_prime q.asIdeal]
    by_cases h : ∃ p, p ∈ (Y.fromSpecResidueField x) ⁻¹ᵁ U
    · obtain ⟨p, hp⟩ := h
      have htop : (Y.fromSpecResidueField x) ⁻¹ᵁ U = ⊤ := by
        ext q
        exact ⟨fun _ => trivial, fun _ => (hsub p q) ▸ hp⟩
      rw [htop]
      exact isAffineOpen_top _
    · have hbot : (Y.fromSpecResidueField x) ⁻¹ᵁ U = ⊥ := by
        ext q
        exact ⟨fun hq => (h ⟨q, hq⟩).elim, fun hq => by simp at hq⟩
      rw [hbot]
      exact isAffineOpen_bot _
  haveI hXaff : IsAffine (Limits.pullback (Y.fromSpecResidueField x) a) := inferInstance
  have s1 : ∀ (G : Λ ⥤ Scheme.{u}) (X : Scheme.{u}) [IsAffine X] (ψ : ∀ l, X ⟶ G.obj l),
      (∀ l, IsAffine (G.obj l)) → (∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l') →
      (∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
        (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') → ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ ψ l = zz l) →
      ∀ f : Γ(X, ⊤), ∃ (l : Λ) (g : Γ(G.obj l, ⊤)), (ψ l).appTop g = f := by
    intro G X _ ψ hGa hψ hlim f
    let F : Λᵒᵖ ⥤ CommRingCat.{u} := G.op ⋙ Scheme.Γ
    have hnat : ∀ (i j : Λᵒᵖ) (f : i ⟶ j), F.map f ≫ (ψ j.unop).appTop = (ψ i.unop).appTop := by
      intro i j f
      rw [← hψ f.unop, Scheme.Hom.comp_appTop]
      rfl
    let c : Limits.Cocone F :=
      { pt := Γ(X, ⊤)
        ι := { app := fun l => (ψ l.unop).appTop
               naturality := fun i j f => by
                 erw [Category.comp_id]
                 exact hnat i j f } }
    let κ : Limits.colimit F ⟶ Γ(X, ⊤) := Limits.colimit.desc F c
    let ι' : ∀ l : Λ, Γ(G.obj l, ⊤) ⟶ Limits.colimit F := fun l =>
      Limits.colimit.ι F (Opposite.op l)
    have hκ : ∀ l : Λ, ι' l ≫ κ = (ψ l).appTop := fun l => Limits.colimit.ι_desc c (Opposite.op l)
    have hιw : ∀ {l l' : Λ} (t : l ⟶ l'), (G.map t).appTop ≫ ι' l = ι' l' := fun t =>
      Limits.colimit.w F t.op
    let ψ' : ∀ l, Spec (Limits.colimit F) ⟶ G.obj l := fun l =>
      Spec.map (ι' l) ≫ (G.obj l).isoSpec.inv
    have hψ' : ∀ {l l' : Λ} (t : l ⟶ l'), ψ' l ≫ G.map t = ψ' l' := by
      intro l l' t
      simp only [ψ']
      rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, ← Category.assoc, ← Spec.map_comp,
        hιw t]
    obtain ⟨z₀, hz₀, -⟩ := hlim _ ψ' hψ'
    obtain ⟨w, -, hwu⟩ := hlim X ψ hψ
    let ρ : X ⟶ Spec (Limits.colimit F) := X.isoSpec.hom ≫ Spec.map κ
    have hρ : ρ ≫ z₀ = 𝟙 X := by
      have e1 : ρ ≫ z₀ = w := hwu _ (fun l => by
        rw [Category.assoc, hz₀]
        simp only [ρ, ψ', Category.assoc]
        rw [← Category.assoc (Spec.map κ), ← Spec.map_comp, hκ l,
          Scheme.isoSpec_inv_naturality, Iso.hom_inv_id_assoc])
      have e2 : 𝟙 X = w := hwu _ (fun l => Category.id_comp _)
      rw [e1, e2]
    have h2 : Spec.map κ ≫ (z₀ ≫ X.isoSpec.hom) = 𝟙 _ := by
      have : Spec.map κ ≫ z₀ = X.isoSpec.inv := by
        rw [← Iso.hom_comp_eq_id, ← Category.assoc]
        exact hρ
      rw [← Category.assoc, this, Iso.inv_hom_id]
    let ζ : Γ(X, ⊤) ⟶ Limits.colimit F := Spec.preimage (z₀ ≫ X.isoSpec.hom)
    have hζκ : ζ ≫ κ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, h2, Spec.map_id]
    obtain ⟨j, g, hg⟩ := Limits.Concrete.colimit_exists_rep F (ζ f)
    refine ⟨j.unop, g, ?_⟩
    have e3 : κ (ζ f) = f := by
      show (ζ ≫ κ) f = f
      rw [hζκ]
      rfl
    have e4 : (ψ j.unop).appTop g = κ (ι' j.unop g) := by
      rw [← hκ j.unop]
      rfl
    rw [e4, ← e3, ← hg]
    rfl
  have s3 : ∀ (Ω : Type u) [Field Ω] (E : Scheme.{u}) [IsAffine E] (s : E ⟶ Spec (.of Ω)),
      Etale s → ∀ g : Γ(E, ⊤), ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.IsIntegralElem g := by
    intro Ω _ E _ s hs g
    have h1 : (s.appTop).hom.Etale := (HasRingHomProperty.iff_of_isAffine (P := @Etale)).mp hs
    have h2 : ((Scheme.ΓSpecIso (.of Ω)).inv).hom.Etale :=
      RingHom.Etale.of_bijective (ConcreteCategory.bijective_of_isIso _)
    have h3 : ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.Etale := by
      rw [CommRingCat.hom_comp]
      exact RingHom.Etale.stableUnderComposition _ _ h2 h1
    letI := ((Scheme.ΓSpecIso (.of Ω)).inv ≫ s.appTop).hom.toAlgebra
    have hE : Algebra.Etale Ω Γ(E, ⊤) := RingHom.Etale.toAlgebra h3
    obtain ⟨I, _, Ai, _, _, e, hfin⟩ := (Algebra.Etale.iff_exists_algEquiv_prod Ω Γ(E, ⊤)).mp hE
    haveI : ∀ i, Module.Finite Ω (Ai i) := fun i => (hfin i).1
    haveI : Module.Finite Ω (∀ i, Ai i) := Module.Finite.pi
    haveI : Module.Finite Ω Γ(E, ⊤) := Module.Finite.equiv e.symm.toLinearEquiv
    haveI : Algebra.IsIntegral Ω Γ(E, ⊤) := Algebra.IsIntegral.of_finite _ _
    exact Algebra.IsIntegral.isIntegral g
  have hw : ∀ {l l' : Λ} (t : l ⟶ l'),
      (W'.map t).right.left ≫ (W'.obj l').right.hom = (W'.obj l).right.hom := by
    intro l l' t
    have := (W'.map t).right.w
    simpa using this
  let h : ∀ l, (W'.obj l).right.left ⟶ Y := fun l => (W'.obj l).right.hom
  let mp : ∀ {l l' : Λ} (t : l ⟶ l'), Limits.pullback (Y.fromSpecResidueField x) (h l) ⟶
      Limits.pullback (Y.fromSpecResidueField x) (h l') :=
    fun t =>
    Limits.pullback.lift (Limits.pullback.fst _ _)
      (Limits.pullback.snd _ _ ≫ (W'.map t).right.left)
      (by rw [Category.assoc, hw t]; exact Limits.pullback.condition)
  have mp_fst : ∀ {l l' : Λ} (t : l ⟶ l'),
      mp t ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ :=
    fun t => Limits.pullback.lift_fst _ _ _
  have mp_snd : ∀ {l l' : Λ} (t : l ⟶ l'),
      mp t ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ (W'.map t).right.left := fun t =>
    Limits.pullback.lift_snd _ _ _
  let G : Λ ⥤ Scheme.{u} :=
    { obj := fun l => Limits.pullback (Y.fromSpecResidueField x) (h l)
      map := fun t => mp t
      map_id := fun l => by
        apply Limits.pullback.hom_ext
        · rw [mp_fst, Category.id_comp]
        · rw [mp_snd, Category.id_comp, W'.map_id]
          rfl
      map_comp := fun {l₁ l₂ l₃} t₁ t₂ => by
        apply Limits.pullback.hom_ext
        · rw [mp_fst, Category.assoc, mp_fst, mp_fst]
        · rw [mp_snd, Category.assoc, mp_snd, ← Category.assoc, mp_snd, Category.assoc,
            W'.map_comp]
          rfl }
  have Gmap_fst : ∀ {l l' : Λ} (t : l ⟶ l'),
      G.map t ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l') =
        Limits.pullback.fst (Y.fromSpecResidueField x) (h l) := mp_fst
  have Gmap_snd : ∀ {l l' : Λ} (t : l ⟶ l'),
      G.map t ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l') =
        Limits.pullback.snd (Y.fromSpecResidueField x) (h l) ≫ (W'.map t).right.left := mp_snd
  let ψ : ∀ l, Limits.pullback (Y.fromSpecResidueField x) a ⟶ G.obj l := fun l =>
    Limits.pullback.lift (Limits.pullback.fst (Y.fromSpecResidueField x) a)
      (Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ φ l)
      (by rw [Category.assoc]; erw [hφa l]; exact Limits.pullback.condition)
  have ψ_fst : ∀ l, ψ l ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l) =
      Limits.pullback.fst (Y.fromSpecResidueField x) a :=
    fun l => Limits.pullback.lift_fst _ _ _
  have ψ_snd : ∀ l, ψ l ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l) =
      Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ φ l := fun l =>
    Limits.pullback.lift_snd _ _ _
  let sG : ∀ l, G.obj l ⟶ Spec (Y.residueField x) := fun l =>
    Limits.pullback.fst (Y.fromSpecResidueField x) (h l)
  have hGaff : ∀ l, IsAffine (G.obj l) := by
    intro l
    haveI := haff l
    show IsAffine (Limits.pullback (Y.fromSpecResidueField x) (h l))
    infer_instance
  have hGet : ∀ l, Etale (sG l) := by
    intro l
    haveI : Etale (h l) := (W'.obj l).right.prop
    show Etale (Limits.pullback.fst (Y.fromSpecResidueField x) (h l))
    infer_instance
  have hψc : ∀ {l l' : Λ} (t : l ⟶ l'), ψ l ≫ G.map t = ψ l' := by
    intro l l' t
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Gmap_fst, ψ_fst, ψ_fst]
    · rw [Category.assoc, Gmap_snd, ← Category.assoc, ψ_snd, Category.assoc, hcomp, ψ_snd]
  have hψlim : ∀ (T : Scheme.{u}) (zz : ∀ l, T ⟶ G.obj l),
      (∀ {l l' : Λ} (t : l ⟶ l'), zz l ≫ G.map t = zz l') →
        ∃! z₀ : T ⟶ Limits.pullback (Y.fromSpecResidueField x) a, ∀ l, z₀ ≫ ψ l = zz l := by
    intro T zz hzz
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hfst1 : ∀ {l l' : Λ} (t : l ⟶ l'),
        zz l ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l) =
          zz l' ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l') := by
      intro l l' t
      rw [← hzz t, Category.assoc, Gmap_fst]
    have hfst : ∀ l l' : Λ,
        zz l ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l) =
          zz l' ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l') := by
      intro l l'
      rw [← hfst1 (IsCofiltered.minToLeft l l'), hfst1 (IsCofiltered.minToRight l l')]
    let v : T ⟶ Spec (Y.residueField x) :=
      zz l₀ ≫ Limits.pullback.fst (Y.fromSpecResidueField x) (h l₀)
    have hzz' : ∀ {l l' : Λ} (t : l ⟶ l'),
        (zz l ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l)) ≫ (W'.map t).right.left =
          zz l' ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l') := by
      intro l l' t
      rw [← hzz t, Category.assoc, Category.assoc, Gmap_snd]
    obtain ⟨w, hw1, hw2⟩ :=
      hlim T (fun l => zz l ≫ Limits.pullback.snd (Y.fromSpecResidueField x) (h l)) hzz'
    have hwa : v ≫ Y.fromSpecResidueField x = w ≫ a := by
      rw [← hφa l₀, ← Category.assoc, hw1 l₀]
      simp only [v, Category.assoc]
      exact congrArg (zz l₀ ≫ ·) Limits.pullback.condition
    refine ⟨Limits.pullback.lift v w hwa, fun l => ?_, fun z₁ hz₁ => ?_⟩
    · apply Limits.pullback.hom_ext
      · rw [Category.assoc, ψ_fst, Limits.pullback.lift_fst]
        exact hfst l₀ l
      · rw [Category.assoc, ψ_snd, ← Category.assoc, Limits.pullback.lift_snd]
        exact hw1 l
    · apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, ← ψ_fst l₀, ← Category.assoc, hz₁ l₀]
      · rw [Limits.pullback.lift_snd]
        apply hw2
        intro l
        rw [Category.assoc, ← ψ_snd, ← Category.assoc, hz₁ l]
  have hrep := s1 G (Limits.pullback (Y.fromSpecResidueField x) a) ψ hGaff hψc hψlim
  have hint : ∀ g : Γ(Limits.pullback (Y.fromSpecResidueField x) a, ⊤),
      ((Scheme.ΓSpecIso (Y.residueField x)).inv ≫
        (Limits.pullback.fst (Y.fromSpecResidueField x) a).appTop).hom.IsIntegralElem g := by
    intro g
    obtain ⟨l, g₀, hg⟩ := hrep g
    haveI := hGaff l
    have hint0 := s3 (Y.residueField x) (G.obj l) (sG l) (hGet l) g₀
    have hmap := hint0.map ((ψ l).appTop.hom)
    have hmap' : (((Scheme.ΓSpecIso (Y.residueField x)).inv ≫
        (Limits.pullback.fst (Y.fromSpecResidueField x) (h l)).appTop) ≫
          (ψ l).appTop).hom.IsIntegralElem ((ψ l).appTop.hom g₀) := hmap
    rw [Category.assoc, ← Scheme.Hom.comp_appTop, ψ_fst l] at hmap'
    rw [← hg]
    exact hmap'

  letI iKM : Algebra K ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) :=
    (Spec.preimage ((Limits.pullback (Y.fromSpecResidueField x) a).fromSpecResidueField p ≫
      Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ a ≫ f)).hom.toAlgebra
  show Algebra.trdeg K ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) ≤ D
  letI iKL : Algebra K (Y.residueField x) :=
    (Spec.preimage (Y.fromSpecResidueField x ≫ f)).hom.toAlgebra
  letI iLM : Algebra (Y.residueField x)
      ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) :=
    (((Limits.pullback (Y.fromSpecResidueField x) a).evaluation ⊤ p trivial).hom.comp
      ((Scheme.ΓSpecIso (Y.residueField x)).inv ≫
        (Limits.pullback.fst (Y.fromSpecResidueField x) a).appTop).hom).toAlgebra
  haveI hT : IsScalarTower K (Y.residueField x)
      ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) :=
    IsScalarTower.of_algebraMap_eq (fun c => congrArg (fun g => g.hom c) hstr)
  haveI hI : Algebra.IsIntegral (Y.residueField x)
      ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) :=
    ⟨fun z => RES (Y.residueField x) (Limits.pullback (Y.fromSpecResidueField x) a)
      ((Scheme.ΓSpecIso (Y.residueField x)).inv ≫
        (Limits.pullback.fst (Y.fromSpecResidueField x) a).appTop).hom hint p z⟩
  obtain ⟨n, s, hn, halg⟩ : ∃ (n : ℕ) (t : Fin n → Y.residueField x), n ≤ D ∧
      Algebra.IsAlgebraic (IntermediateField.adjoin K (Set.range t)) (Y.residueField x) := LFT
  exact CNT K (Y.residueField x) ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p)
    n s hn halg hI

theorem wc_et_shens_point_fibre_trdeg : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f] (x y : Y) (D t : ℕ), topologicalKrullDim ↥(closure ({x} : Set Y)) ≤ (D : WithBot ℕ∞) → (t : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set Y)) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of A) ⟶ (W'.obj l).right.left) (a : Spec (.of A) ⟶ Y), wcHalShData y A Λ W' φ a → ∀ p : ↥(Limits.pullback (Y.fromSpecResidueField x) a), ∃ (k : Type u) (_ : Field k) (_ : IsSepClosed k) (_ : K →+* k) (_ : Algebra k ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p)), Algebra.trdeg k ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) + t ≤ D :=
by
  classical
  intro K _ _ Y f _ x y D t hx hy A _ _ _ Λ _ _ W' φ a hsh p

  have S1 : ∀ (n : ℕ) (P : Polynomial A), P.natDegree = n → P.Monic →
      (P.map (IsLocalRing.residue A)).Separable → P.Splits := by
    intro n
    induction n with
    | zero =>
      intro P hn hP _
      rw [(Polynomial.Monic.natDegree_eq_zero hP).mp hn]
      simpa using Polynomial.Splits.C (1 : A)
    | succ n ih =>
      intro P hn hP hsep
      have hdeg : (P.map (IsLocalRing.residue A)).degree ≠ 0 := by
        rw [hP.degree_map, Polynomial.degree_eq_natDegree hP.ne_zero, hn]
        exact_mod_cast Nat.succ_ne_zero n
      obtain ⟨α, hα⟩ := IsSepClosed.exists_root _ hdeg hsep
      obtain ⟨a₀, rfl⟩ := IsLocalRing.residue_surjective α
      have h1 : P.eval a₀ ∈ IsLocalRing.maximalIdeal A := by
        rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.eval₂_at_apply,
          ← Polynomial.eval_map]
        exact hα
      have h2 : IsUnit (P.derivative.eval a₀) := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit, ← Polynomial.eval₂_at_apply,
          ← Polynomial.eval_map, ← Polynomial.derivative_map]
        have := hsep.eval₂_derivative_ne_zero (RingHom.id _)
          (x := IsLocalRing.residue A a₀) (by rw [Polynomial.eval₂_id]; exact hα)
        rwa [Polynomial.eval₂_id] at this
      obtain ⟨b, hb, -⟩ := HenselianLocalRing.is_henselian P hP a₀ h1 h2
      have hfac := (Polynomial.mul_divByMonic_eq_iff_isRoot).mpr hb
      have hQm : (P /ₘ (Polynomial.X - Polynomial.C b)).Monic :=
        Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C b) (by rw [hfac]; exact hP)
      have hQd : (P /ₘ (Polynomial.X - Polynomial.C b)).natDegree = n := by
        rw [Polynomial.natDegree_divByMonic P (Polynomial.monic_X_sub_C b), hn,
          Polynomial.natDegree_X_sub_C]
        simp
      have hQs : ((P /ₘ (Polynomial.X - Polynomial.C b)).map
          (IsLocalRing.residue A)).Separable := by
        have e : P.map (IsLocalRing.residue A) =
            (Polynomial.X - Polynomial.C (IsLocalRing.residue A b)) *
              (P /ₘ (Polynomial.X - Polynomial.C b)).map (IsLocalRing.residue A) := by
          conv_lhs => rw [← hfac]
          rw [Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
        rw [e] at hsep
        exact hsep.of_mul_right
      rw [← hfac]
      exact (Polynomial.Splits.X_sub_C b).mul (ih _ hQd hQm hQs)

  have S2 : ∀ (F M : Type u) [Field F] [Field M] [Algebra F M],
      (∀ P : Polynomial F, P.Monic → P.Separable → (P.map (algebraMap F M)).Splits) →
      IsSepClosed (separableClosure F M) := by
    intro F M _ _ _ hspl
    refine IsSepClosed.of_exists_root (separableClosure F M) (fun Q hQm hQirr hQsep => ?_)
    haveI : Fact (Irreducible Q) := ⟨hQirr⟩
    have hmin : minpoly (separableClosure F M) (AdjoinRoot.root Q) = Q := by
      rw [AdjoinRoot.minpoly_root hQirr.ne_zero, hQm.leadingCoeff, inv_one, map_one, mul_one]
    have hsepk : IsSeparable (separableClosure F M) (AdjoinRoot.root Q) := by
      rw [IsSeparable, hmin]; exact hQsep
    have hsepF : IsSeparable F (AdjoinRoot.root Q) :=
      IsSeparable.of_algebra_isSeparable_of_isSeparable F hsepk
    have hPm : (minpoly F (AdjoinRoot.root Q)).Monic := minpoly.monic hsepF.isIntegral
    have hPs : (minpoly F (AdjoinRoot.root Q)).Separable := hsepF
    have hPM := hspl _ hPm hPs
    have hdvd : Q ∣ (minpoly F (AdjoinRoot.root Q)).map
        (algebraMap F (separableClosure F M)) := by
      have := minpoly.dvd (separableClosure F M) (AdjoinRoot.root Q)
        (p := (minpoly F (AdjoinRoot.root Q)).map (algebraMap F (separableClosure F M)))
        (by rw [Polynomial.aeval_map_algebraMap]; exact minpoly.aeval F _)
      rwa [hmin] at this
    have hdvdM : Q.map (algebraMap (separableClosure F M) M) ∣
        (minpoly F (AdjoinRoot.root Q)).map (algebraMap F M) := by
      have := Polynomial.map_dvd (algebraMap (separableClosure F M) M) hdvd
      rwa [Polynomial.map_map, ← IsScalarTower.algebraMap_eq] at this
    have hPM0 : (minpoly F (AdjoinRoot.root Q)).map (algebraMap F M) ≠ 0 :=
      (hPm.map _).ne_zero
    have hQM := hPM.of_dvd hPM0 hdvdM
    have hQdeg : (Q.map (algebraMap (separableClosure F M) M)).degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective (algebraMap (separableClosure F M) M).injective]
      exact (Polynomial.degree_pos_of_irreducible hQirr).ne'
    have hr := Polynomial.eval_rootOfSplits hQM hQdeg
    have hrP : Polynomial.aeval (Polynomial.rootOfSplits hQM hQdeg)
        (minpoly F (AdjoinRoot.root Q)) = 0 := by
      obtain ⟨c, hc⟩ := hdvdM
      rw [Polynomial.aeval_def, ← Polynomial.eval_map, hc, Polynomial.eval_mul, hr, zero_mul]
    have hrk : Polynomial.rootOfSplits hQM hQdeg ∈ separableClosure F M := by
      rw [mem_separableClosure_iff]
      exact Polynomial.Separable.of_dvd hPs (minpoly.dvd F _ hrP)
    refine ⟨⟨_, hrk⟩, ?_⟩
    apply (algebraMap (separableClosure F M) M).injective
    rw [map_zero, ← Polynomial.eval₂_at_apply, ← Polynomial.eval_map]
    exact hr

  have S7 : ∀ (X : Scheme.{u}) (R : CommRingCat.{u}) (h : X ⟶ Spec R) (q : X),
      Spec.preimage (X.fromSpecResidueField q ≫ h) =
        (Scheme.ΓSpecIso R).inv ≫ h.appTop ≫ X.evaluation ⊤ q trivial := by
    intro X R h q
    have hD : Spec.preimage (X.fromSpecResidueField q ≫ h) =
        (Scheme.ΓSpecIso R).inv ≫ h.appTop ≫ X.presheaf.germ ⊤ q trivial ≫ X.residue q := by
      apply Spec.map_injective
      rw [Spec.map_preimage]
      simp only [Spec.map_comp, Category.assoc]
      rw [← Scheme.fromSpecStalk_toSpecΓ_assoc, ← Scheme.toSpecΓ_naturality_assoc,
        toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id, ← Category.assoc]
      rfl
    rw [hD]
    rfl

  have ha : a (IsLocalRing.closedPoint A) = y := by
    obtain ⟨e, -, he⟩ := hsh.2.2.2.2.2
    have hgeom : ∀ z, wcEtGeomPt Y y z = y := by
      intro z
      rw [wcEtGeomPt, Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply y _
    have hres : ∀ z, (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) z =
        IsLocalRing.closedPoint A :=
      fun z => IsLocalRing.PrimeSpectrum.comap_residue A z
    have h1 := congrArg
      (fun f => f (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) he
    have h1' := (Scheme.Hom.comp_apply _ _ _).symm.trans
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (h1.trans (hgeom _)))
    rw [hres] at h1'
    exact h1'
  have hy' : (t : WithBot ℕ∞) ≤
      topologicalKrullDim ↥(closure ({a (IsLocalRing.closedPoint A)} : Set Y)) := by
    rw [ha]; exact hy

  obtain ⟨g, hg⟩ := wc_lft_point_closure_algIndep K Y f (a (IsLocalRing.closedPoint A)) t hy'

  obtain ⟨h, hh⟩ : ∃ h : Fin t → A, letI : Algebra K (IsLocalRing.ResidueField A) :=
      ((IsLocalRing.residue A).comp (Spec.preimage (a ≫ f)).hom).toAlgebra;
      AlgebraicIndependent K (fun i => IsLocalRing.residue A (h i)) := by
    let σ := Scheme.stalkClosedPointTo a
    haveI : IsLocalHom σ.hom := Scheme.isLocalHom_stalkClosedPointTo a
    let jC : Y.residueField (a (IsLocalRing.closedPoint A)) ⟶
        CommRingCat.of (IsLocalRing.ResidueField A) :=
      CommRingCat.ofHom (IsLocalRing.ResidueField.map σ.hom)
    choose g' hg' using fun i => Y.residue_surjective (a (IsLocalRing.closedPoint A)) (g i)
    refine ⟨fun i => σ.hom (g' i), ?_⟩
    letI iY : Algebra K (Y.residueField (a (IsLocalRing.closedPoint A))) :=
      (Spec.preimage (Y.fromSpecResidueField (a (IsLocalRing.closedPoint A)) ≫ f)).hom.toAlgebra
    letI iB : Algebra K (IsLocalRing.ResidueField A) :=
      ((IsLocalRing.residue A).comp (Spec.preimage (a ≫ f)).hom).toAlgebra
    have hjres : ∀ z, jC.hom ((Y.residue (a (IsLocalRing.closedPoint A))).hom z) =
        IsLocalRing.residue A (σ.hom z) := by
      intro z
      exact IsLocalRing.ResidueField.map_residue σ.hom z
    have e1 : Y.residue (a (IsLocalRing.closedPoint A)) ≫ jC =
        σ ≫ CommRingCat.ofHom (IsLocalRing.residue A) := by
      ext z
      exact hjres z
    have key : Spec.preimage (Y.fromSpecResidueField (a (IsLocalRing.closedPoint A)) ≫ f) ≫ jC =
        Spec.preimage (a ≫ f) ≫ CommRingCat.ofHom (IsLocalRing.residue A) := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_comp, Spec.map_preimage,
        Scheme.fromSpecResidueField]
      have e2 : Spec.map jC ≫ Spec.map (Y.residue (a (IsLocalRing.closedPoint A))) =
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ Spec.map σ := by
        rw [← Spec.map_comp, ← Spec.map_comp, e1]
      have h2 := Scheme.Spec_stalkClosedPointTo_fromSpecStalk a
      simp only [Category.assoc]
      erw [reassoc_of% e2, reassoc_of% h2]
    let jA : Y.residueField (a (IsLocalRing.closedPoint A)) →ₐ[K] IsLocalRing.ResidueField A :=
      { jC.hom with
        commutes' := fun c => congrArg (fun φ => φ.hom c) key }
    have hind := hg.map' (f := jA) jC.hom.injective
    convert hind using 1
    funext i
    change _ = jC.hom (g i)
    rw [← hg' i, hjres]

  obtain ⟨lam, hlamK⟩ : ∃ lam : FractionRing (MvPolynomial (Fin t) K) →+* A,
      ∀ c : K, lam (algebraMap K (FractionRing (MvPolynomial (Fin t) K)) c) =
        (Spec.preimage (a ≫ f)).hom c := by
    letI : Algebra K (IsLocalRing.ResidueField A) :=
      ((IsLocalRing.residue A).comp (Spec.preimage (a ≫ f)).hom).toAlgebra
    have hinj := (algebraicIndependent_iff_injective_aeval).mp hh
    have hu : ∀ P : nonZeroDivisors (MvPolynomial (Fin t) K),
        IsUnit (MvPolynomial.eval₂Hom (Spec.preimage (a ≫ f)).hom h
          (P : MvPolynomial (Fin t) K)) := by
      intro P
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
      have hP : (P : MvPolynomial (Fin t) K) ≠ 0 := nonZeroDivisors.ne_zero P.2
      have e : IsLocalRing.residue A (MvPolynomial.eval₂Hom (Spec.preimage (a ≫ f)).hom h
          (P : MvPolynomial (Fin t) K)) =
          MvPolynomial.aeval (fun i => IsLocalRing.residue A (h i))
            (P : MvPolynomial _ K) := by
        rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_comp_left, MvPolynomial.aeval_def]
        rfl
      rw [e]
      intro h0
      exact hP (hinj (by rw [h0, map_zero]))
    refine ⟨IsLocalization.lift (M := nonZeroDivisors (MvPolynomial (Fin t) K))
      (S := FractionRing (MvPolynomial (Fin t) K)) hu, fun c => ?_⟩
    rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin t) K), IsLocalization.lift_eq,
      MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C]

  have hcan : Spec.preimage ((Limits.pullback (Y.fromSpecResidueField x) a).fromSpecResidueField p ≫
        Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ a ≫ f) =
      Spec.preimage (a ≫ f) ≫ (Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
        (Limits.pullback.snd (Y.fromSpecResidueField x) a).appTop ≫
        (Limits.pullback (Y.fromSpecResidueField x) a).evaluation ⊤ p trivial := by
    have hnat : Spec.preimage (a ≫ f) ≫ (Scheme.ΓSpecIso (CommRingCat.of A)).inv =
        (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (a ≫ f).appTop := by
      have := Scheme.ΓSpecIso_inv_naturality (Spec.preimage (a ≫ f))
      rwa [Spec.map_preimage] at this
    rw [S7, Scheme.Hom.comp_appTop, reassoc_of% hnat, Category.assoc]
  letI iKM : Algebra K ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) :=
    (Spec.preimage ((Limits.pullback (Y.fromSpecResidueField x) a).fromSpecResidueField p ≫
      Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ a ≫ f)).hom.toAlgebra
  letI iFM : Algebra (FractionRing (MvPolynomial (Fin t) K))
      ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) :=
    (((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
        (Limits.pullback.snd (Y.fromSpecResidueField x) a).appTop ≫
        (Limits.pullback (Y.fromSpecResidueField x) a).evaluation ⊤ p trivial).hom.comp
      lam).toAlgebra
  haveI : IsScalarTower K (FractionRing (MvPolynomial (Fin t) K))
      ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) :=
    IsScalarTower.of_algebraMap_eq (fun c => by
      have e := congrArg (fun φ => φ.hom c) hcan
      exact e.trans (congrArg ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
        (Limits.pullback.snd (Y.fromSpecResidueField x) a).appTop ≫
        (Limits.pullback (Y.fromSpecResidueField x) a).evaluation ⊤ p trivial).hom
          (hlamK c).symm))

  have hD : Algebra.trdeg K ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) ≤ D :=
    wc_et_shens_point_fibre_residue_trdeg_le K Y f x y D hx A Λ W' φ a hsh p

  have hind : AlgebraicIndependent K (fun i => algebraMap (MvPolynomial (Fin t) K)
      (FractionRing (MvPolynomial (Fin t) K)) (MvPolynomial.X i)) :=
    (MvPolynomial.algebraicIndependent_X (Fin t) K).map'
      (f := IsScalarTower.toAlgHom K (MvPolynomial (Fin t) K)
        (FractionRing (MvPolynomial (Fin t) K)))
      (IsFractionRing.injective _ _)

  have hcount : Algebra.trdeg (separableClosure (FractionRing (MvPolynomial (Fin t) K))
      ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p))
      ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) + t ≤ D := by
    haveI : IsScalarTower K (separableClosure (FractionRing (MvPolynomial (Fin t) K))
        ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p))
        ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) :=
      IsScalarTower.of_algebraMap_eq (fun x => rfl)
    have h1 : AlgebraicIndependent K (fun i => algebraMap (FractionRing (MvPolynomial (Fin t) K))
        (separableClosure (FractionRing (MvPolynomial (Fin t) K))
          ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p))
        (algebraMap (MvPolynomial (Fin t) K) (FractionRing (MvPolynomial (Fin t) K))
          (MvPolynomial.X i))) :=
      hind.map' (f := IsScalarTower.toAlgHom K (FractionRing (MvPolynomial (Fin t) K))
        (separableClosure (FractionRing (MvPolynomial (Fin t) K))
          ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p)))
        (algebraMap (FractionRing (MvPolynomial (Fin t) K))
          (separableClosure (FractionRing (MvPolynomial (Fin t) K))
            ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p))).injective
    have h2 := h1.lift_cardinalMk_le_trdeg
    simp only [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_uzero] at h2
    have h3 := lift_trdeg_add_eq K (separableClosure (FractionRing (MvPolynomial (Fin t) K))
        ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p))
      ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p)
    simp only [Cardinal.lift_id] at h3
    calc _ ≤ Algebra.trdeg (separableClosure (FractionRing (MvPolynomial (Fin t) K))
          ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p))
          ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) +
          Algebra.trdeg K (separableClosure (FractionRing (MvPolynomial (Fin t) K))
          ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p)) :=
          add_le_add le_rfl h2
      _ = Algebra.trdeg K ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p) := by
          rw [add_comm, h3]
      _ ≤ D := hD

  have hspl : ∀ P : Polynomial (FractionRing (MvPolynomial (Fin t) K)), P.Monic → P.Separable →
      (P.map (algebraMap (FractionRing (MvPolynomial (Fin t) K))
        ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p))).Splits := by
    intro P hPm hPs
    have h1 : (P.map lam).Monic := hPm.map lam
    have h2 : ((P.map lam).map (IsLocalRing.residue A)).Separable := by
      rw [Polynomial.map_map]; exact hPs.map
    have h3 := (S1 _ (P.map lam) rfl h1 h2).map
      ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
        (Limits.pullback.snd (Y.fromSpecResidueField x) a).appTop ≫
        (Limits.pullback (Y.fromSpecResidueField x) a).evaluation ⊤ p trivial).hom
    rw [Polynomial.map_map] at h3
    exact h3
  exact ⟨separableClosure (FractionRing (MvPolynomial (Fin t) K))
      ((Limits.pullback (Y.fromSpecResidueField x) a).residueField p), inferInstance,
    S2 _ _ hspl,
    (algebraMap (FractionRing (MvPolynomial (Fin t) K)) _).comp
      (algebraMap K (FractionRing (MvPolynomial (Fin t) K))), inferInstance, hcount⟩

theorem wc_et_iso_point_ext_transport : ∀ {X S Y : Scheme.{u}} (σ : X ⟶ S) [IsIso σ] (i : S ⟶ Y) (f : X ⟶ Y), σ ≫ i = f → ∀ (Lp : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}), Nonempty (Lp ⊣ wcEtPush i) → Limits.PreservesFiniteLimits Lp → ∀ (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (q : ℕ), (letI : HasExt (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Lp.obj F) q, z = 0) → ∃ (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush f) ∧ Limits.PreservesFiniteLimits L ∧ (letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (L.obj F) q, z = 0) :=
by
  intro X S Y σ _ i f hσf Lp hadj hLp F q hvan
  subst hσf
  obtain ⟨adjp⟩ := hadj
  obtain ⟨⟨c0X⟩, ⟨cστ⟩⟩ := wc_et_push_id_comp_iso σ (inv σ)
  obtain ⟨⟨c0S⟩, ⟨cτσ⟩⟩ := wc_et_push_id_comp_iso (inv σ) σ
  obtain ⟨-, ⟨cσi⟩⟩ := wc_et_push_id_comp_iso σ i
  have hστ : σ ≫ inv σ = 𝟙 X := IsIso.hom_inv_id σ
  have hτσ : inv σ ≫ σ = 𝟙 S := IsIso.inv_hom_id σ
  let η : 𝟭 (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) ≅
      wcEtPush σ ⋙ wcEtPush (inv σ) :=
    (cστ ≪≫ eqToIso (congrArg (fun g => wcEtPush g) hστ) ≪≫ c0X).symm
  let ε : wcEtPush (inv σ) ⋙ wcEtPush σ ≅
      𝟭 (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) :=
    cτσ ≪≫ eqToIso (congrArg (fun g => wcEtPush g) hτσ) ≪≫ c0S
  let e := CategoryTheory.Equivalence.mk (wcEtPush σ) (wcEtPush (inv σ)) η ε
  let adjστ : wcEtPush σ ⊣ wcEtPush (inv σ) := e.toAdjunction
  let adjτσ : wcEtPush (inv σ) ⊣ wcEtPush σ := e.symm.toAdjunction
  obtain ⟨hAddτ, hPFLτ, hPFCτ, -, -⟩ := wc_et_push_iso_exact_can (inv σ)
  obtain ⟨-, -, -, hcan, -⟩ := wc_et_push_iso_exact_can σ
  refine ⟨Lp ⋙ wcEtPush (inv σ), ⟨(adjp.comp adjτσ).ofNatIsoRight cσi⟩, ?_, ?_⟩
  · haveI := hPFLτ
    exact Limits.comp_preservesFiniteLimits _ _
  · letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) := HasExt.standard _
    haveI := wc_et_enough_injectives S
    haveI := hAddτ
    haveI := hPFLτ
    haveI := hPFCτ
    haveI : (wcEtPush σ).IsRightAdjoint := adjτσ.isRightAdjoint
    haveI : (wcEtPush σ).PreservesMonomorphisms :=
      Functor.preservesMonomorphisms_of_isRightAdjoint _
    have hΦ := wc_ext_adjoint_transfer (wcEtPush σ) (wcEtPush (inv σ)) adjστ
      ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Lp.obj F) q
    have hsrc : ∀ y : Abelian.Ext ((wcEtPush σ).obj
        ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)))) (Lp.obj F) q, y = 0 := by
      intro y
      haveI := hcan (AddCommGrpCat.of (ULift.{u+1} ℤ))
      have h0 : (Abelian.Ext.mk₀ (wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ)))).comp y
          (zero_add q) = 0 := hvan _
      calc y = (Abelian.Ext.mk₀ (𝟙 _)).comp y (zero_add q) := (Abelian.Ext.mk₀_id_comp y).symm
        _ = ((Abelian.Ext.mk₀ (inv (wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ))))).comp
              (Abelian.Ext.mk₀ (wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ))))
              (add_zero 0)).comp y (zero_add q) := by
            rw [Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id]
        _ = (Abelian.Ext.mk₀ (inv (wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ))))).comp
              ((Abelian.Ext.mk₀ (wcEtCanConst σ (AddCommGrpCat.of (ULift.{u+1} ℤ)))).comp y
                (zero_add q)) (zero_add q) :=
            Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega)
        _ = 0 := by rw [h0, Abelian.Ext.comp_zero]
    intro z
    obtain ⟨y, rfl⟩ := hΦ.2 z
    obtain ⟨y₀, hy₀⟩ := hΦ.2 0
    have hyy : y = y₀ := (hsrc y).trans (hsrc y₀).symm
    rw [hyy]
    exact hy₀

theorem wc_et_vnr_point_coh_vanishing : ∀ (T : Scheme.{u}) [IsAffine T], (∀ f : Γ(T, ⊤), ∃ s : Γ(T, ⊤), f * f * s = f) → ∀ (F : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (q : ℕ), 1 ≤ q → (∀ (p : T) (Lp : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (Spec (T.residueField p))) AddCommGrpCat.{u+1}), Nonempty (Lp ⊣ wcEtPush (T.fromSpecResidueField p)) → Limits.PreservesFiniteLimits Lp → letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (T.residueField p))) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (T.residueField p))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Lp.obj F) q, z = 0) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q, z = 0 :=
by
  intro T _ hR F q hq hfib
  classical
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI := wc_et_enough_injectives T
  let J := InjectiveResolution.of F

  have TU : ∀ (V : T.Etale) (a b : V ⟶ Scheme.Etale.mk (𝟙 T)), a = b := by
    intro V a b
    apply MorphismProperty.Over.Hom.ext
    have ha : a.left ≫ (Scheme.Etale.mk (𝟙 T)).hom = V.hom := MorphismProperty.Over.w a
    have hb : b.left ≫ (Scheme.Etale.mk (𝟙 T)).hom = V.hom := MorphismProperty.Over.w b
    change a.left ≫ 𝟙 T = V.hom at ha
    change b.left ≫ 𝟙 T = V.hom at hb
    exact (Category.comp_id a.left).symm.trans (ha.trans (hb.symm.trans (Category.comp_id b.left)))

  have N : ∀ (i j : ℕ) {V V' : T.Etale} (k : V ⟶ V')
      (x : (J.cocomplex.X i).obj.obj (Opposite.op V')),
      ((J.cocomplex.d i j).hom.app (Opposite.op V)).hom (((J.cocomplex.X i).obj.map k.op).hom x) =
      ((J.cocomplex.X j).obj.map k.op).hom (((J.cocomplex.d i j).hom.app (Opposite.op V')).hom x) := by
    intro i j V V' k x
    have key := congrArg (fun ψ => ψ.hom x) ((J.cocomplex.d i j).hom.naturality k.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at key
    exact key

  have Fn : ∀ (i : ℕ) {V V' V'' : T.Etale} (k₁ : V ⟶ V') (k₂ : V' ⟶ V'')
      (x : (J.cocomplex.X i).obj.obj (Opposite.op V'')),
      ((J.cocomplex.X i).obj.map k₁.op).hom (((J.cocomplex.X i).obj.map k₂.op).hom x) =
      ((J.cocomplex.X i).obj.map (k₁ ≫ k₂).op).hom x := by
    intro i V V' V'' k₁ k₂ x
    rw [op_comp, Functor.map_comp]
    rfl

  have s3 : ∀ (V : T.Etale) (U : T.Opens), IsOpenImmersion V.hom → Set.range V.hom = (U : Set T) →
      Nonempty (Scheme.Etale.mk ((𝟙 T) ⁻¹ᵁ U).ι ⟶ (wcEtBaseChange (𝟙 T)).obj V) := by
    intro V U hV hU
    have hsub : Set.range (((𝟙 T) ⁻¹ᵁ U).ι ≫ 𝟙 T) ⊆ Set.range V.hom := by
      rintro _ ⟨x, rfl⟩
      rw [hU]
      have hx : ((𝟙 T) ⁻¹ᵁ U).ι x ∈ (((𝟙 T) ⁻¹ᵁ U : T.Opens) : Set T) := by
        rw [← Scheme.Opens.range_ι ((𝟙 T) ⁻¹ᵁ U)]
        exact ⟨x, rfl⟩
      first
        | exact hx
        | simpa [Scheme.Hom.comp_apply] using hx
    let k := IsOpenImmersion.lift V.hom (((𝟙 T) ⁻¹ᵁ U).ι ≫ 𝟙 T) hsub
    have hk : k ≫ V.hom = ((𝟙 T) ⁻¹ᵁ U).ι ≫ 𝟙 T := IsOpenImmersion.lift_fac _ _ _
    let κ₀ : ((𝟙 T) ⁻¹ᵁ U : Scheme) ⟶ Limits.pullback V.hom (𝟙 T) :=
      Limits.pullback.lift k ((𝟙 T) ⁻¹ᵁ U).ι hk
    exact ⟨MorphismProperty.Over.homMk κ₀ (Limits.pullback.lift_snd _ _ _) trivial⟩

  have s2 : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
      (G : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1} ⥤ (Λᵒᵖ ⥤ AddCommGrpCat.{u+1}))
      [(G ⋙ Limits.colim).PreservesZeroMorphisms]
      (C : HomologicalComplex (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (ComplexShape.up ℕ)),
      Subsingleton ((((G ⋙ Limits.colim).mapHomologicalComplex (ComplexShape.up ℕ)).obj C).homology q) →
      ∀ (l : Λ) (x : (G.obj (C.X q)).obj (Opposite.op l)),
        ((G.map (C.d q (q + 1))).app (Opposite.op l)).hom x = 0 →
        ∃ (l' : Λ) (t : l' ⟶ l) (β : (G.obj (C.X (q - 1))).obj (Opposite.op l')),
          ((G.map (C.d (q - 1) q)).app (Opposite.op l')).hom β = ((G.obj (C.X q)).map t.op).hom x := by
    intro Λ _ _ G _ C hH l x hx
    let K := ((G ⋙ Limits.colim).mapHomologicalComplex (ComplexShape.up ℕ)).obj C
    have hex : K.ExactAt q := by
      rw [HomologicalComplex.exactAt_iff_isZero_homology]
      exact AddCommGrpCat.isZero_of_subsingleton _
    rw [HomologicalComplex.exactAt_iff' K (q - 1) q (q + 1)
      ((ComplexShape.up ℕ).prev_eq' (show q - 1 + 1 = q by omega))
      ((ComplexShape.up ℕ).next_eq' rfl), ShortComplex.ab_exact_iff] at hex
    haveI := Limits.preservesFilteredColimitsOfSize_shrink.{u, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
    have hd : ∀ (i j : ℕ) (n : Λᵒᵖ) (w : (G.obj (C.X i)).obj n),
        (K.d i j).hom ((Limits.colimit.ι (G.obj (C.X i)) n).hom w) =
          (Limits.colimit.ι (G.obj (C.X j)) n).hom (((G.map (C.d i j)).app n).hom w) := by
      intro i j n w
      have e1 : Limits.colimit.ι (G.obj (C.X i)) n ≫ K.d i j =
          (G.map (C.d i j)).app n ≫ Limits.colimit.ι (G.obj (C.X j)) n :=
        Limits.colimit.ι_map (G.map (C.d i j)) n
      exact congrArg (fun f => f.hom w) e1
    obtain ⟨y, hy⟩ := hex ((Limits.colimit.ι (G.obj (C.X q)) (Opposite.op l)).hom x) (by
      change (K.d q (q + 1)).hom ((Limits.colimit.ι (G.obj (C.X q)) (Opposite.op l)).hom x) = 0
      rw [hd, hx, map_zero])
    obtain ⟨j₀, β₁, hβ₁⟩ := Limits.Concrete.colimit_exists_rep (G.obj (C.X (q - 1))) y
    have heq : (Limits.colimit.ι (G.obj (C.X q)) j₀).hom (((G.map (C.d (q - 1) q)).app j₀).hom β₁) =
        (Limits.colimit.ι (G.obj (C.X q)) (Opposite.op l)).hom x := by
      have h1 := hd (q - 1) q j₀ β₁
      have h2 := congrArg (fun w => (K.d (q - 1) q).hom w) hβ₁
      exact h1.symm.trans (h2.trans hy)
    obtain ⟨k, f, g, hfg⟩ := (Limits.Concrete.colimit_rep_eq_iff_exists (G.obj (C.X q))
      (i := j₀) (j := Opposite.op l) (((G.map (C.d (q - 1) q)).app j₀).hom β₁) x).1 heq
    refine ⟨k.unop, g.unop, ((G.obj (C.X (q - 1))).map f).hom β₁, ?_⟩
    have nat := congrArg (fun ψ => ψ.hom β₁) ((G.map (C.d (q - 1) q)).naturality f)
    exact nat.trans hfg

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 T)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  let adj := constantSheafAdj (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1} hT
  let ev : ∀ X : AddCommGrpCat.{u+1}, (AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ X) ≃ X := fun X =>
    { toFun := fun φ => φ.hom (ULift.up 1)
      invFun := fun x => AddCommGrpCat.ofHom
        ((zmultiplesHom X x).comp (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom)
      left_inv := fun φ => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        rintro ⟨n⟩
        have hn : (ULift.up n : ULift.{u+1} ℤ) = n • (ULift.up 1 : ULift.{u+1} ℤ) := by
          apply ULift.ext
          simp
        change (zmultiplesHom X (φ.hom (ULift.up 1))) n = φ.hom (ULift.up n)
        rw [zmultiplesHom_apply, hn, map_zsmul]
      right_inv := fun x => by
        change (zmultiplesHom X x) (1 : ℤ) = x
        rw [zmultiplesHom_apply, one_zsmul] }
  let ε : ∀ M : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1},
      ((constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M) ≃
        M.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 T))) := fun M =>
    (adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} ℤ)) M).trans
      (ev (M.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 T)))))
  have hnat : ∀ (M M' : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (ψ : M ⟶ M')
      (g : (constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M),
      ε M' (g ≫ ψ) = (ψ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 T)))).hom (ε M g) := by
    intro M M' ψ g
    simp only [ε, Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
    rfl
  have h0 : ∀ M : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}, ε M 0 = 0 := by
    intro M
    have h := hnat M M 0 0
    rw [Limits.zero_comp] at h
    rw [h]
    rfl

  have H : ∀ z : (J.cocomplex.X q).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 T))),
      ((J.cocomplex.d q (q + 1)).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 T)))).hom z = 0 →
      ∃ b : (J.cocomplex.X (q - 1)).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 T))),
        ((J.cocomplex.d (q - 1) q).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 T)))).hom b = z := by
    intro z hz

    have hloc : ∀ p : T, ∃ (e : Γ(T, ⊤)) (_ : e * e = e) (_ : p ∈ T.basicOpen e)
        (β : (J.cocomplex.X (q - 1)).obj.obj
          (Opposite.op (Scheme.Etale.mk ((𝟙 T) ⁻¹ᵁ T.basicOpen e).ι))),
        ∀ g : Scheme.Etale.mk ((𝟙 T) ⁻¹ᵁ T.basicOpen e).ι ⟶ Scheme.Etale.mk (𝟙 T),
          ((J.cocomplex.d (q - 1) q).hom.app
            (Opposite.op (Scheme.Etale.mk ((𝟙 T) ⁻¹ᵁ T.basicOpen e).ι))).hom β =
          ((J.cocomplex.X q).obj.map g.op).hom z := by
      intro p
      have hs3 := wc_vnr_evaluation_surjective T hR p
      have hs4 := wc_vnr_factor_fromSpecResidueField T hR p hs3
      obtain ⟨Λ, _, _, W, E, φ, hA, hO, hE, hp, hrg, hc, hφ, hlim⟩ :=
        wc_vnr_point_clopen_limit T p hs4
      obtain ⟨Lp, ⟨adjp⟩, hLp, -⟩ := wc_et_push_left_adjoint (T.fromSpecResidueField p)
      have hP := hfib p Lp ⟨adjp⟩ hLp
      obtain ⟨L, hadj, hL, hvan⟩ := wc_et_iso_point_ext_transport
        (Limits.pullback.snd (𝟙 T) (T.fromSpecResidueField p)) (T.fromSpecResidueField p)
        (Limits.pullback.fst (𝟙 T) (T.fromSpecResidueField p))
        ((Limits.pullback.condition (f := 𝟙 T) (g := T.fromSpecResidueField p)).symm.trans
          (Category.comp_id _))
        Lp ⟨adjp⟩ hLp F q hP
      haveI : IsAffineHom (𝟙 T) := inferInstance
      obtain ⟨e⟩ := wc_et_limit_push_homology_affine_gen (𝟙 T) (↑(T.residueField p)) Λ W φ
        (T.fromSpecResidueField p) hA hc hφ hlim F J L hadj hL q
      have hH := @Equiv.subsingleton _ _ e ⟨fun a b => by rw [hvan a, hvan b]⟩
      obtain ⟨l₀⟩ : Nonempty Λ := IsCofiltered.nonempty
      let ρ : ∀ V : T.Etale, V ⟶ Scheme.Etale.mk (𝟙 T) := fun V =>
        MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
      obtain ⟨l', t, β₀, hβ₀⟩ := s2 Λ (sheafToPresheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1} ⋙
          (Functor.whiskeringLeft (T.Etale)ᵒᵖ (T.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
            (@Functor.op T.Etale _ T.Etale _ (wcEtBaseChange (𝟙 T))) ⋙
          (Functor.whiskeringLeft Λᵒᵖ (T.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj W.op)
        J.cocomplex hH l₀
        (((J.cocomplex.X q).obj.map (ρ ((wcEtBaseChange (𝟙 T)).obj (W.obj l₀))).op).hom z) (by
          change ((J.cocomplex.d q (q + 1)).hom.app
              (Opposite.op ((wcEtBaseChange (𝟙 T)).obj (W.obj l₀)))).hom
            (((J.cocomplex.X q).obj.map (ρ ((wcEtBaseChange (𝟙 T)).obj (W.obj l₀))).op).hom z) = 0
          rw [N, hz, map_zero])
      have hβ₀' : ((J.cocomplex.d (q - 1) q).hom.app
          (Opposite.op ((wcEtBaseChange (𝟙 T)).obj (W.obj l')))).hom β₀ =
          ((J.cocomplex.X q).obj.map ((wcEtBaseChange (𝟙 T)).map (W.map t) ≫
            ρ ((wcEtBaseChange (𝟙 T)).obj (W.obj l₀))).op).hom z := by
        rw [← Fn]
        exact hβ₀
      obtain ⟨κ⟩ := s3 (W.obj l') (T.basicOpen (E l')) (hO l') (hrg l')
      refine ⟨E l', hE l', hp l', ((J.cocomplex.X (q - 1)).obj.map κ.op).hom β₀, fun g => ?_⟩
      rw [N, hβ₀', Fn, TU _ (κ ≫ _) g]
    choose V hVi hVm β hβ using hloc

    obtain ⟨n, pt, O, hdisj, hcov, hsub⟩ :=
      wc_affine_idempotent_disjoint_refinement T V hVi hVm
    let O' : Fin n → T.Opens := fun i => (𝟙 T) ⁻¹ᵁ O i
    have hle : ∀ i, O' i ≤ (𝟙 T) ⁻¹ᵁ T.basicOpen (V (pt i)) := by
      intro i x hx
      exact hsub i ((𝟙 T) x) hx
    let r : ∀ i, Scheme.Etale.mk (O' i).ι ⟶
        Scheme.Etale.mk ((𝟙 T) ⁻¹ᵁ T.basicOpen (V (pt i))).ι := fun i =>
      MorphismProperty.Over.homMk (T.homOfLE (hle i)) (T.homOfLE_ι _) trivial
    let β' : ∀ i, (J.cocomplex.X (q - 1)).obj.obj (Opposite.op (Scheme.Etale.mk (O' i).ι)) :=
      fun i => ((J.cocomplex.X (q - 1)).obj.map (r i).op).hom (β (pt i))

    apply wc_et_disjoint_open_cover_coboundary T (J.cocomplex.X (q - 1)) (J.cocomplex.X q)
      (J.cocomplex.d (q - 1) q) n O'
      (fun i j hij x hxi hxj => hdisj i j hij ((𝟙 T) x) hxi hxj) (fun x => hcov ((𝟙 T) x)) z β'
    intro i g
    let g₀ : Scheme.Etale.mk ((𝟙 T) ⁻¹ᵁ T.basicOpen (V (pt i))).ι ⟶ Scheme.Etale.mk (𝟙 T) :=
      MorphismProperty.Over.homMk ((𝟙 T) ⁻¹ᵁ T.basicOpen (V (pt i))).ι
        (Category.comp_id _) trivial
    calc ((J.cocomplex.d (q - 1) q).hom.app (Opposite.op (Scheme.Etale.mk (O' i).ι))).hom (β' i)
        = ((J.cocomplex.X q).obj.map (r i).op).hom
            (((J.cocomplex.d (q - 1) q).hom.app
              (Opposite.op (Scheme.Etale.mk ((𝟙 T) ⁻¹ᵁ T.basicOpen (V (pt i))).ι))).hom
              (β (pt i))) := N _ _ (r i) (β (pt i))
      _ = ((J.cocomplex.X q).obj.map (r i).op).hom
            (((J.cocomplex.X q).obj.map g₀.op).hom z) := by rw [hβ (pt i) g₀]
      _ = ((J.cocomplex.X q).obj.map (r i ≫ g₀).op).hom z := Fn _ _ _ _
      _ = ((J.cocomplex.X q).obj.map g.op).hom z := by rw [TU _ (r i ≫ g₀) g]

  intro α
  obtain ⟨f, hf, rfl⟩ := J.extMk_surjective α (q + 1) rfl
  refine (J.extMk_eq_zero_iff f (q + 1) rfl hf (q - 1) (Nat.sub_add_cancel hq)).mpr ?_
  have hz : ((J.cocomplex.d q (q + 1)).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 T)))).hom
      (ε _ f) = 0 := by
    rw [← hnat, hf, h0]
  obtain ⟨b, hb⟩ := H _ hz
  refine ⟨(ε (J.cocomplex.X (q - 1))).symm b, ?_⟩
  apply (ε (J.cocomplex.X q)).injective
  rw [hnat, Equiv.apply_symm_apply, hb]

theorem wc_et_field_cd_le_trdeg : ∀ (k L : Type u) [Field k] [IsSepClosed k] [Field L] [Algebra k L] (ℓ : ℕ), ℓ.Prime → (ℓ : k) ≠ 0 → ∀ (n : ℕ), Algebra.trdeg k L ≤ n → ∀ (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}), ℓ • 𝟙 G = 0 → letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ m : ℕ, n < m → ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G m, z = 0 :=
by
  classical
  intro k L _ hksep _ _ ℓ hℓ hℓk n hn G hG m hm z

  have sepcl : ∀ (A B : Type u) [Field A] [IsSepClosed A] [Field B] [Algebra A B],
      Algebra.IsAlgebraic A B → IsSepClosed B := by
    intro A B _ _ _ _ hAB
    haveI := hAB
    haveI : Algebra.IsAlgebraic A (AlgebraicClosure B) :=
      Algebra.IsAlgebraic.trans A B (AlgebraicClosure B)
    haveI : IsPurelyInseparable A (AlgebraicClosure B) :=
      Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
    haveI : IsPurelyInseparable B (AlgebraicClosure B) :=
      IsPurelyInseparable.tower_top A B (AlgebraicClosure B)
    have h1 : separableClosure B (AlgebraicClosure B) = ⊥ :=
      separableClosure.eq_bot_iff.mpr inferInstance
    exact (IsSepClosed.separableClosure_eq_bot_iff B (AlgebraicClosure B)).mp h1

  have hℓE : ∀ (E : Type u) [Field E] [Algebra k E], (ℓ : E) ≠ 0 := by
    intro E _ _ h
    apply hℓk
    apply (algebraMap k E).injective
    rw [map_natCast, map_zero]
    exact h

  have P : ∀ n : ℕ, ∀ (M : Type u) [Field M] [Algebra k M] (t : Fin n → M),
      Algebra.IsAlgebraic (IntermediateField.adjoin k (Set.range t)) M →
      ∀ (G' : Sheaf (Scheme.smallEtaleTopology (Spec (.of M))) AddCommGrpCat.{u+1}), ℓ • 𝟙 G' = 0 →
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of M))) AddCommGrpCat.{u+1}) :=
        HasExt.standard _
      ∀ m' : ℕ, n < m' → ∀ z' : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
        (Spec (.of M))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G' m',
        z' = 0 := by
    intro n
    induction n with
    | zero =>
      intro M _ _ t ht G' _ m' hm' z'
      have h0 : IntermediateField.adjoin k (Set.range t) = ⊥ := by
        rw [Set.range_eq_empty t, IntermediateField.adjoin_empty]
      rw [h0] at ht
      have halg : Algebra.IsAlgebraic k M :=
        Algebra.IsAlgebraic.trans k (⊥ : IntermediateField k M) M
      have hMsep : IsSepClosed M := @sepcl k M _ hksep _ _ halg
      haveI : HenselianLocalRing M := Field.henselian M
      haveI : Algebra.IsIntegral M (IsLocalRing.ResidueField M) :=
        Algebra.isIntegral_of_surjective (by
          rw [IsLocalRing.ResidueField.algebraMap_eq]
          exact IsLocalRing.residue_surjective)
      haveI : IsSepClosed (IsLocalRing.ResidueField M) :=
        @sepcl M (IsLocalRing.ResidueField M) _ hMsep _ _ Algebra.IsIntegral.isAlgebraic
      obtain ⟨q, rfl⟩ : ∃ q, m' = q + 1 := ⟨m' - 1, by omega⟩
      have hs := wc_et_strictly_local_ext_vanishing M G' q
      exact @Subsingleton.elim _ hs z' (0 : type_of% z')
    | succ n ih =>

      have CONST : ∀ (M : Type u) [Field M] [Algebra k M] (s : Fin (n + 1) → M),
          Algebra.IsAlgebraic (IntermediateField.adjoin k (Set.range s)) M →
          ∀ q : ℕ, n + 1 < q →
          letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of M))) AddCommGrpCat.{u+1}) :=
            HasExt.standard _
          ∀ w : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of M)))
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
            ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of M))) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q, w = 0 := by
        intro M _ _ s hs q hq w
        obtain ⟨⟨t', ht'⟩, hτ⟩ := wc_adjoin_fin_succ_split k M n s hs
        let F := IntermediateField.adjoin k (Set.range (s ∘ Fin.castSucc))
        letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of ↥F)))
          AddCommGrpCat.{u+1}) := HasExt.standard _
        letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of M)))
          AddCommGrpCat.{u+1}) := HasExt.standard _
        haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of ↥F)))
          AddCommGrpCat.{u+1}) := wc_et_enough_injectives _
        haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of M)))
          AddCommGrpCat.{u+1}) := wc_et_enough_injectives _
        obtain ⟨Lπ, ⟨adj⟩, hlim, ⟨eL⟩⟩ :=
          wc_et_push_left_adjoint (Spec.map (CommRingCat.ofHom (algebraMap (↥F) M)))
        haveI := hlim
        haveI : Lπ.IsLeftAdjoint := adj.isLeftAdjoint
        haveI : Lπ.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
        haveI : Lπ.Additive := Functor.additive_of_preserves_binary_products _
        haveI : (wcEtPush (Spec.map (CommRingCat.ofHom (algebraMap (↥F) M)))).Additive :=
          Adjunction.right_adjoint_additive adj
        have hℓF : (ℓ : ↥F) ≠ 0 := hℓE ↥F
        have hL := wc_leray_ext_vanishing Lπ
          (wcEtPush (Spec.map (CommRingCat.ofHom (algebraMap (↥F) M)))) adj
          ((constantSheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of ↥F)))
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
          ((constantSheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of M)))
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
          (injectiveResolution _) (n + 1) (by
            intro p b hpb y
            by_cases hb : 2 ≤ b
            · have hz := wc_field_push_higher_vanish (↥F) M (s (Fin.last n)) hτ ℓ hℓ hℓF
                (fun k' E _ _ _ _ s' hs' hk q' hq' =>
                  wc_field_sepclosed_curve_cd_one k' E s' hs' ℓ hℓ hk q' hq')
                (injectiveResolution _) b hb
              calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) :=
                    (Abelian.Ext.comp_mk₀_id y).symm
                _ = y.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hz.eq_of_tgt (𝟙 _) 0]
                _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
            · have htors := wc_rightDerived_homology_nsmul_zero
                (wcEtPush (Spec.map (CommRingCat.ofHom (algebraMap (↥F) M))))
                ((constantSheaf (Scheme.smallEtaleTopology (Spec (CommRingCat.of M)))
                  AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
                (injectiveResolution _) ℓ (wc_et_const_zmod_nsmul_zero _ ℓ) b
              exact ih (↥F) t' ht' _ htors p (by omega) y)
        have h0 : (Abelian.Ext.mk₀ eL.hom).comp w (zero_add q) = 0 := hL q hq _
        calc w = (Abelian.Ext.mk₀ (𝟙 _)).comp w (zero_add q) := (Abelian.Ext.mk₀_id_comp w).symm
          _ = ((Abelian.Ext.mk₀ eL.inv).comp (Abelian.Ext.mk₀ eL.hom) (add_zero 0)).comp w
                (zero_add q) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id]
          _ = (Abelian.Ext.mk₀ eL.inv).comp ((Abelian.Ext.mk₀ eL.hom).comp w (zero_add q))
                (zero_add q) := Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega)
          _ = 0 := by rw [h0, Abelian.Ext.comp_zero]

      intro M _ _ t ht G' hG' m' hm' z'
      exact wc_field_torsion_cd_of_const M ℓ hℓ (hℓE M) (n + 1)
        (fun L' _ _ _ q hq => by
          letI : Algebra k L' := ((algebraMap M L').comp (algebraMap k M)).toAlgebra
          exact CONST L' (algebraMap M L' ∘ t)
            (wc_adjoin_algebraic_finite_ext k M L' (n + 1) t ht) q hq)
        G' hG' m' hm' z'

  haveI : FaithfulSMul k L :=
    (faithfulSMul_iff_algebraMap_injective k L).mpr (algebraMap k L).injective
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis k L
  have hcard : Cardinal.mk s = Algebra.trdeg k L := hs.cardinalMk_eq_trdeg
  have hsn : Cardinal.mk s ≤ n := hcard.le.trans hn
  haveI hfin : Finite s :=
    Cardinal.mk_lt_aleph0_iff.mp (hsn.trans_lt Cardinal.natCast_lt_aleph0)
  let e := Finite.equivFin s
  let t : Fin (Nat.card s) → L := Subtype.val ∘ e.symm
  have hrange : Set.range t = Set.range (Subtype.val : s → L) :=
    e.symm.surjective.range_comp _
  have hnle : Nat.card s ≤ n := by
    have h1 : ((Nat.card s : ℕ) : Cardinal) = Cardinal.mk s := Nat.cast_card
    have h2 : ((Nat.card s : ℕ) : Cardinal) ≤ ((n : ℕ) : Cardinal) := h1.le.trans hsn
    exact_mod_cast h2
  have ht : Algebra.IsAlgebraic (IntermediateField.adjoin k (Set.range t)) L := by
    rw [hrange]
    exact hs.isAlgebraic_field
  exact P (Nat.card s) L t ht G hG m (by omega) z

theorem wc_et_point_push_higher_stalk_vanish : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (x y : Y) (D t s : ℕ), topologicalKrullDim ↥(closure ({x} : Set Y)) ≤ (D : WithBot ℕ∞) → (t : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set Y)) → D < t + s → ∀ (G : Sheaf (Scheme.smallEtaleTopology (Spec (Y.residueField x))) AddCommGrpCat.{u+1}), ℓ • 𝟙 G = 0 → ∀ (I : InjectiveResolution G), Subsingleton ((wcEtStalk Y y).obj ((((wcEtPush (Y.fromSpecResidueField x)).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology s)) :=
