      first
        | rfl
        | simp [zmultiplesHom_apply]
    · exfalso
      apply H
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      obtain ⟨⟨z, γ⟩, hx⟩ := x
      have hx' : (Additive.toMul γ) ^ (ℓ ^ n) = (wcKaUnit Y a W) ^ z := hx
      show ((wcKtPsi.{u} ℓ D k).app (Scheme.Γ.obj (Opposite.op W.unop.left))).hom
