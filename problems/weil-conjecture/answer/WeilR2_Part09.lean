        Functor.whiskerRight (NatTrans.op adj.unit) (wcEtZModRing T.left ℓ).obj =
        𝟙 (wcEtZModRing T.left ℓ).obj :=
      s1 (Y := T.left) _ (wcEtZModRing T.left ℓ).cond _ _
    let A2 := @SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hF E.cont adj ψ E.φ H1 H2
    have hcounit : ∀ A : X.Etale, (adj.counit.app A).left = Limits.pullback.fst A.hom T.hom :=
      fun A => congrArg (fun k => k.left)
        (MorphismProperty.Over.mapPullbackAdj_counit_app (@Etale : MorphismProperty Scheme.{u}) ⊤
          T.hom T.prop trivial A)
    have hA2 : Epi (A2.unit.app G) := by
      haveI := Functor.reflectsEpimorphisms_of_faithful
        (SheafOfModules.toSheaf (wcEtZModRing X ℓ))
      apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcEtZModRing X ℓ))
      haveI : Sheaf.IsLocallySurjective
          ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).map (A2.unit.app G)) := by
        apply Presheaf.isLocallySurjective_of_surjective
        intro U y
        have hc : IsOpenImmersion (adj.counit.app U.unop).left := by
          rw [hcounit]
          exact MorphismProperty.of_isPullback (P := @IsOpenImmersion)
            (IsPullback.of_hasPullback _ _).flip hT
        have hrange : Set.range (adj.counit.app U.unop).left = U.unop.hom ⁻¹' Set.range T.hom := by
          rw [hcounit]
          exact Scheme.Pullback.range_fst _ _
        have hcl : IsClosed (Set.range (adj.counit.app U.unop).left) := by
          rw [hrange]
          exact hTc.preimage U.unop.hom.continuous
        obtain ⟨t, ht⟩ := hrestr ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj G)
          (adj.counit.app U.unop) hc hcl y
        refine ⟨t, ?_⟩
        exact (@SheafOfModules.pushforwardPushforwardAdj_unit_app_val_app _ _ _ _ _ _ _ _ _ _ hF
          E.cont adj ψ E.φ H1 H2 G U t).trans ht
      exact Sheaf.epi_of_isLocallySurjective _
    rw [← Adjunction.unit_leftAdjointUniq_hom_app A2 E.adj G]
    exact epi_comp _ _
  haveI hc := hcontT (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι))
  exact @gen (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι)) Dj hc
    (inferInstanceAs (IsOpenImmersion V.ι))
    (by
      show IsClosed (Set.range V.ι)
