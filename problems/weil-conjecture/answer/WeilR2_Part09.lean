  intro X Z i _ ℓ D
  haveI := D.cont
  have LH : ∀ {T V : Scheme.{u}} (j : T ⟶ V) [IsClosedImmersion j] {W : Scheme.{u}} (w : W ⟶ T) [Etale w] (x : W), ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ W) (x' : ↥(Limits.pullback e j)), h ≫ w = Limits.pullback.snd e j ∧ h x' = x :=
    by intro T V j _ W w _ x; exact wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg j w x
  haveI hA : Limits.PreservesColimitsOfSize.{u+1, u+1}
      (sheafToPresheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1} ⋙
        (Functor.whiskeringLeft (X.Etale)ᵒᵖ (Z.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (wcEtBaseChange i).op ⋙
