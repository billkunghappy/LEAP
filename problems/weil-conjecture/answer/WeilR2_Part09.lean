  have htrans : ∀ N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Function.Bijective (fun β : Abelian.Ext (wcFreeSheaf S U) N i =>
        (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U) β) (zero_add i)) := by
    intro N
    obtain ⟨θ, hθ⟩ : ∃ θ : L.obj Z ⟶ wcFreeSheaf S U, adj.homEquiv Z (wcFreeSheaf S U) θ = ε :=
      ⟨_, (adj.homEquiv Z (wcFreeSheaf S U)).apply_symm_apply ε⟩
    have hbij : ∀ T : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
        Function.Bijective (fun f : wcFreeSheaf S U ⟶ T => θ ≫ f) := by
      intro T
      have e : (fun f : wcFreeSheaf S U ⟶ T => θ ≫ f) =
          (adj.homEquiv Z T).symm ∘ (fun f : wcFreeSheaf S U ⟶ T =>
            ε ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map f) := by
        funext f
        simp only [Function.comp_apply]
        rw [_root_.Equiv.eq_symm_apply, Adjunction.homEquiv_naturality_right, hθ]
      rw [e]
      exact (adj.homEquiv Z T).symm.bijective.comp (H1 T)
    haveI : IsIso θ := isIso_of_coyoneda_map_bijective θ hbij
    have hψ : Function.Bijective
        (fun β : Abelian.Ext (wcFreeSheaf S U) N i => (Abelian.Ext.mk₀ θ).comp β (zero_add i)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun γ => (Abelian.Ext.mk₀ (inv θ)).comp γ (zero_add i), ?_, ?_⟩
      · intro β
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      · intro γ
        simp only
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    have hfac : (fun β : Abelian.Ext (wcFreeSheaf S U) N i =>
        (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U) β) (zero_add i)) =
        adj.extEquiv ∘ (fun β : Abelian.Ext (wcFreeSheaf S U) N i =>
          (Abelian.Ext.mk₀ θ).comp β (zero_add i)) := by
      funext β
      simp only [Function.comp_apply]
      rw [Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc,
