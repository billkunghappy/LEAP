      ((wcKtT.{u} (ℓ ^ n) k).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom.toIntLinearMap
      ((wcKtZUT.{u} ℓ D).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom.toIntLinearMap
      _ _ hz (ULift.down x))

  have hF : ∀ W, (wcKaFPre Y ℓ n k a).app W = wcKaFApp Y ℓ n k a W := by
    intro W
    unfold wcKaFPre
    refine hNat _ ?_ W
    intro W₁ W₂ f
    have hι : ∀ ζ, (wcKaIota Y (ℓ ^ n) a W₂).toIntLinearMap
        (((wcRootsFun.{u} (ℓ ^ n)).map
          (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom.toIntLinearMap ζ) =
        ((wcKaE Y (ℓ ^ n) a).map f).hom.toIntLinearMap
          ((wcKaIota Y (ℓ ^ n) a W₁).toIntLinearMap ζ) := by
      intro ζ
      apply Subtype.ext
      apply Prod.ext
      · rfl
      · apply Additive.toMul.injective
        apply Units.ext
        first
          | rfl
          | exact restrictRootsOfUnity_coe_apply _ _
    apply AddCommGrpCat.hom_ext
