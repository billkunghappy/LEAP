import WeilR2_Part08
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_et_closed_two_piece_cover : ∀ {X Z : Scheme.{u}} (T : X.Etale) (i : Z ⟶ X) (e : Z ⟶ T.left) [IsClosedImmersion i], e ≫ T.hom = i → ∀ W : X.Etale, ∃ S ∈ Scheme.smallEtaleTopology X W, ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g → (∃ lam : W'.left ⟶ T.left, lam ≫ T.hom = W'.hom) ∨ ∀ w : W'.left, W'.hom w ∉ Set.range i :=
by
  intro X Z T i e _ hv W

  have hjs : ∀ (S : Sieve W), (∀ v : W.left, ∃ (V₁ : X.Etale)
      (c : V₁ ⟶ W), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X W := by
    intro S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X W
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ W.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale W.hom := W.prop
      have h2 : Etale (c.left ≫ W.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left W.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  let P : X.Etale → Prop := fun W' => (∃ lam : W'.left ⟶ T.left, lam ≫ T.hom = W'.hom) ∨
    ∀ w : W'.left, W'.hom w ∉ Set.range i
  let S : Sieve W :=
    { arrows := fun W' _ => P W'
      downward_closed := by
        intro W' W'' g hg h
        have hw : h.left ≫ W'.hom = W''.hom := MorphismProperty.Over.w h
        rcases hg with ⟨lam, hlam⟩ | hmiss
        · left
          exact ⟨h.left ≫ lam, by rw [Category.assoc, hlam, hw]⟩
        · right
          intro w hw'
          apply hmiss (h.left w)
          have hpt : W'.hom (h.left w) = W''.hom w := by
            rw [← hw, Scheme.Hom.comp_apply]
          rw [hpt]
          exact hw' }
  refine ⟨S, hjs S ?_, fun _ g hg => hg⟩
  intro w
  haveI : Etale W.hom := W.prop
  haveI : Etale T.hom := T.prop
  by_cases hw : W.hom w ∈ Set.range i
  · obtain ⟨p, hp⟩ := hw
    have he : W.hom w = T.hom (e p) := by
      rw [← hp, ← hv, Scheme.Hom.comp_apply]
    obtain ⟨z, hz, _⟩ := Scheme.Pullback.exists_preimage_pullback w (e p) he
    refine ⟨Scheme.Etale.mk (Limits.pullback.fst W.hom T.hom ≫ W.hom),
      MorphismProperty.Over.homMk (Limits.pullback.fst W.hom T.hom) rfl trivial, ?_, z, hz⟩
    left
    exact ⟨Limits.pullback.snd W.hom T.hom, Limits.pullback.condition.symm⟩
  · have hZ : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
    let U₀ : W.left.Opens :=
      ⟨W.hom ⁻¹' (Set.range i)ᶜ, hZ.isOpen_compl.preimage W.hom.continuous⟩
    have hwU : w ∈ U₀ := hw
    have gen2 : ∀ (Y : Scheme.{u}) (U : Y.Opens) (y : Y) (hy : y ∈ U), U.ι ⟨y, hy⟩ = y := by
      intro Y U y hy
      exact Scheme.Opens.ι_apply U ⟨y, hy⟩
    have gen : ∀ (Y : Scheme.{u}) (f : Y ⟶ X) (U : Y.Opens), (∀ y ∈ U, f y ∉ Set.range i) →
        ∀ u : (U : Scheme.{u}), f (U.ι u) ∉ Set.range i := by
      intro Y f U h u
      have hpt : U.ι u = u.1 := gen2 Y U u.1 u.2
      rw [hpt]
      exact h _ u.2
    refine ⟨Scheme.Etale.mk (U₀.ι ≫ W.hom), MorphismProperty.Over.homMk U₀.ι rfl trivial, ?_,
      ⟨w, hwU⟩, ?_⟩
    · right
      intro u
      exact gen W.left W.hom U₀ (fun y hy => hy) u
    · exact gen2 W.left U₀ w hwU

theorem wc_et_closed_lifts_agree_locally : ∀ {X Z : Scheme.{u}} (T : X.Etale) (i : Z ⟶ X) (e : Z ⟶ T.left) [IsClosedImmersion i], IsPullback (𝟙 Z) e i T.hom → ∀ (W : X.Etale) (lam lam' : W.left ⟶ T.left), lam ≫ T.hom = W.hom → lam' ≫ T.hom = W.hom → ∃ S ∈ Scheme.smallEtaleTopology X W, ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g → g.left ≫ lam = g.left ≫ lam' ∨ ∀ w : W'.left, W'.hom w ∉ Set.range i :=
by
  intro X Z T i e _ hP W lam lam' hl hl'
  haveI : Etale W.hom := W.prop
  haveI : Etale T.hom := T.prop

  have hjs : ∀ (S : Sieve W), (∀ v : W.left, ∃ (V₁ : X.Etale)
      (c : V₁ ⟶ W), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X W := by
    intro S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X W
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ W.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale W.hom := W.prop
      have h2 : Etale (c.left ≫ W.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left W.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hw0 : e ≫ T.hom = i := (hP.toCommSq.w).symm.trans (Category.id_comp i)
  have hP' : IsPullback (𝟙 Z) e (e ≫ T.hom) T.hom := hw0 ▸ hP
  have capp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (x : A), (f ≫ g) x = g (f x) :=
    fun f g x => Scheme.Hom.comp_apply f g x

  have s1 : ∀ (t : T.left) (z : Z), T.hom t = i z → t = e z := by
    intro t z h
    obtain ⟨q, hq1, hq2⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := i) (g := T.hom) z t h.symm
    have h3 : (hP.isoPullback.inv ≫ e) q = Limits.pullback.snd i T.hom q := by
      rw [hP.isoPullback_inv_snd]
    have h4 : (hP.isoPullback.inv ≫ 𝟙 Z) q = Limits.pullback.fst i T.hom q := by
      rw [hP.isoPullback_inv_fst]
    rw [capp] at h3 h4
    have h5 : hP.isoPullback.inv q = z := h4.trans hq1
    rw [← hq2, ← h3, h5]

  have s2 : ∀ (p : ↥(Limits.pullback T.hom T.hom)) (z : Z),
      Limits.pullback.fst T.hom T.hom p = e z → p = Limits.pullback.diagonal T.hom (e z) := by
    intro p z hp
    let κ : Limits.pullback e (Limits.pullback.fst T.hom T.hom) ≅ Z :=
      Limits.pullbackRightPullbackFstIso T.hom T.hom e ≪≫ hP'.isoPullback.symm
    have hb : κ.hom = Limits.pullback.fst e (Limits.pullback.fst T.hom T.hom) := by
      have h1 : hP'.isoPullback.inv = Limits.pullback.fst (e ≫ T.hom) T.hom := by
        rw [← hP'.isoPullback_inv_fst, Category.comp_id]
      show (Limits.pullbackRightPullbackFstIso T.hom T.hom e).hom ≫ hP'.isoPullback.inv = _
      rw [h1, Limits.pullbackRightPullbackFstIso_hom_fst]
    have hinj : ∀ y₁ y₂ : ↥(Limits.pullback e (Limits.pullback.fst T.hom T.hom)),
        Limits.pullback.fst e (Limits.pullback.fst T.hom T.hom) y₁ =
        Limits.pullback.fst e (Limits.pullback.fst T.hom T.hom) y₂ → y₁ = y₂ := by
      intro y₁ y₂ h
      rw [← hb] at h
      calc y₁ = κ.inv (κ.hom y₁) := (Scheme.hom_inv_apply κ y₁).symm
        _ = κ.inv (κ.hom y₂) := by rw [h]
        _ = y₂ := Scheme.hom_inv_apply κ y₂
    obtain ⟨y, hy1, hy2⟩ := Scheme.Pullback.exists_preimage_pullback (f := e)
      (g := Limits.pullback.fst T.hom T.hom) z p hp.symm
    have H : 𝟙 Z ≫ e =
        (e ≫ Limits.pullback.diagonal T.hom) ≫ Limits.pullback.fst T.hom T.hom := by
      rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id, Category.id_comp]
    obtain ⟨y', hy'1, hy'2⟩ : ∃ y' : Z ⟶ Limits.pullback e (Limits.pullback.fst T.hom T.hom),
        y' ≫ Limits.pullback.fst e (Limits.pullback.fst T.hom T.hom) = 𝟙 Z ∧
        y' ≫ Limits.pullback.snd e (Limits.pullback.fst T.hom T.hom) =
          e ≫ Limits.pullback.diagonal T.hom :=
      ⟨Limits.pullback.lift (𝟙 Z) (e ≫ Limits.pullback.diagonal T.hom) H,
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have h3 : (y' ≫ Limits.pullback.fst e (Limits.pullback.fst T.hom T.hom)) z = (𝟙 Z) z := by
      rw [hy'1]
    have h4 : (y' ≫ Limits.pullback.snd e (Limits.pullback.fst T.hom T.hom)) z =
        (e ≫ Limits.pullback.diagonal T.hom) z := by
      rw [hy'2]
    rw [capp] at h3
    rw [capp, capp] at h4
    have hyy : y = y' z := hinj _ _ (hy1.trans h3.symm)
    rw [← hy2, hyy]
    exact h4

  obtain ⟨π, hπ1, hπ2⟩ : ∃ π : W.left ⟶ Limits.pullback T.hom T.hom,
      π ≫ Limits.pullback.fst T.hom T.hom = lam ∧ π ≫ Limits.pullback.snd T.hom T.hom = lam' :=
    ⟨Limits.pullback.lift lam lam' (hl.trans hl'.symm), Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  let E : W.left.Opens := ⟨π ⁻¹' Set.range (Limits.pullback.diagonal T.hom),
    ((Limits.pullback.diagonal T.hom).isOpenEmbedding.isOpen_range).preimage π.continuous⟩

  have hEagr : E.ι ≫ lam = E.ι ≫ lam' := by
    have hsubr : Set.range (E.ι ≫ π) ⊆ Set.range (Limits.pullback.diagonal T.hom) := by
      rintro _ ⟨u, rfl⟩
      have hu : E.ι u = u.1 := Scheme.Opens.ι_apply E u
      obtain ⟨y, hy⟩ := u.2
      exact ⟨y, hy.trans ((congrArg π hu).symm.trans (capp _ _ _).symm)⟩
    obtain ⟨m, hm⟩ : ∃ m, m ≫ Limits.pullback.diagonal T.hom = E.ι ≫ π :=
      ⟨_, IsOpenImmersion.lift_fac _ _ hsubr⟩
    have ha : E.ι ≫ lam = m := by
      rw [← hπ1, ← Category.assoc, ← hm, Category.assoc, Limits.pullback.diagonal_fst,
        Category.comp_id]
    have hb : E.ι ≫ lam' = m := by
      rw [← hπ2, ← Category.assoc, ← hm, Category.assoc, Limits.pullback.diagonal_snd,
        Category.comp_id]
    rw [ha, hb]

  let S : Sieve W :=
    { arrows := fun W' g => g.left ≫ lam = g.left ≫ lam' ∨ ∀ w : W'.left, W'.hom w ∉ Set.range i
      downward_closed := by
        intro W' W'' g hg h
        have hw : h.left ≫ W'.hom = W''.hom := MorphismProperty.Over.w h
        rcases hg with hg | hmiss
        · left
          show (h.left ≫ g.left) ≫ lam = (h.left ≫ g.left) ≫ lam'
          rw [Category.assoc, Category.assoc, hg]
        · right
          intro w hw'
          apply hmiss (h.left w)
          have he : W'.hom (h.left w) = W''.hom w := by
            rw [← hw, Scheme.Hom.comp_apply]
          rw [he]
          exact hw' }
  refine ⟨S, hjs S ?_, fun _ g hg => hg⟩
  intro w
  by_cases hw : W.hom w ∈ Set.range i
  · obtain ⟨z, hz⟩ := hw
    have h1 : lam w = e z := by
      apply s1 _ z
      have he : T.hom (lam w) = W.hom w := by rw [← hl, Scheme.Hom.comp_apply]
      rw [he]
      exact hz.symm
    have h2 : Limits.pullback.fst T.hom T.hom (π w) = e z := by
      have he : (π ≫ Limits.pullback.fst T.hom T.hom) w = lam w := by rw [hπ1]
      rw [Scheme.Hom.comp_apply] at he
      rw [he, h1]
    have hwE : w ∈ E := by
      show π w ∈ Set.range (Limits.pullback.diagonal T.hom)
      exact ⟨_, (s2 (π w) z h2).symm⟩
    refine ⟨Scheme.Etale.mk (E.ι ≫ W.hom), MorphismProperty.Over.homMk E.ι rfl trivial, ?_,
      ⟨w, hwE⟩, ?_⟩
    · left
      exact hEagr
    · exact Scheme.Opens.ι_apply E ⟨w, hwE⟩
  · have hZ : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
    let U₀ : W.left.Opens :=
      ⟨W.hom ⁻¹' (Set.range i)ᶜ, hZ.isOpen_compl.preimage W.hom.continuous⟩
    have hwU : w ∈ U₀ := hw
    refine ⟨Scheme.Etale.mk (U₀.ι ≫ W.hom), MorphismProperty.Over.homMk U₀.ι rfl trivial, ?_,
      ⟨w, hwU⟩, ?_⟩
    · right
      intro u h
      have hu : U₀.ι u = u.1 := Scheme.Opens.ι_apply U₀ u
      have heq : (U₀.ι ≫ W.hom) u = W.hom u.1 := (capp U₀.ι W.hom u).trans (congrArg W.hom hu)
      have h' : W.hom u.1 ∈ Set.range i := by rw [← heq]; exact h
      exact u.2 h'
    · exact Scheme.Opens.ι_apply U₀ ⟨w, hwU⟩

theorem wc_et_closed_supp_obj_restrict_iso : ∀ {X Z : Scheme.{u}} (T : X.Etale) [hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (i : Z ⟶ X) (e : Z ⟶ T.left), IsPullback (𝟙 Z) e i T.hom → ∀ (ℓ : ℕ), (∀ (S : Sheaf (Scheme.smallEtaleTopology T.left) RingCat.{u+1}) (a b : wcEtZModRing T.left ℓ ⟶ S), a = b) → ∀ (D : wcEtPullData i ℓ) (D' : wcEtPullData e ℓ) (ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj (wcEtZModRing X ℓ)), Nonempty ((SheafOfModules.pushforward.{u+1} ψ).obj (wcEtSuppObj D) ≅ wcEtSuppObj D') :=
by
  intro X Z T hc i e hP ℓ huniq D D' ψ
  have hα : Nonempty (wcEtSlice T ⋙ wcEtBaseChange i ≅ wcEtBaseChange e) := by
    have PB : ∀ U : T.left.Etale, IsPullback (Limits.pullback.fst U.hom e)
        (Limits.pullback.snd U.hom e) (U.hom ≫ T.hom) i := fun U => by
      simpa using (IsPullback.of_hasPullback U.hom e).paste_vert hP.flip
    refine ⟨NatIso.ofComponents
      (fun U => MorphismProperty.Over.isoMk (PB U).isoPullback.symm ?_) ?_⟩
    · exact (PB U).isoPullback_inv_snd
    · intro U U' g
      apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.lift (Limits.pullback.fst (U.hom ≫ T.hom) i ≫ g.left)
          (Limits.pullback.snd (U.hom ≫ T.hom) i)
          (by rw [Category.assoc, ← Category.assoc g.left, MorphismProperty.Over.w g,
            Limits.pullback.condition]) ≫ (PB U').isoPullback.inv =
        (PB U).isoPullback.inv ≫ Limits.pullback.lift (Limits.pullback.fst U.hom e ≫ g.left)
          (Limits.pullback.snd U.hom e)
          (by rw [Category.assoc, MorphismProperty.Over.w g, Limits.pullback.condition])
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, IsPullback.isoPullback_inv_fst]
        erw [Limits.pullback.lift_fst, Limits.pullback.lift_fst]
        rw [IsPullback.isoPullback_inv_fst_assoc]
      · simp only [Category.assoc, IsPullback.isoPullback_inv_snd]
        erw [Limits.pullback.lift_snd, Limits.pullback.lift_snd]
        rw [IsPullback.isoPullback_inv_snd]
  obtain ⟨α⟩ := hα
  haveI := D.cont
  haveI := D'.cont
  haveI := Functor.isContinuous_comp (wcEtSlice T) (wcEtBaseChange i)
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
    (Scheme.smallEtaleTopology Z)
  exact ⟨((SheafOfModules.pushforwardComp ψ D.φ).app
      (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≪≫
    (@SheafOfModules.pushforwardNatIso _ _ _ _ _ _ (wcEtBaseChange e)
      (wcEtSlice T ⋙ wcEtBaseChange i) _ _ _ _
      (ψ ≫ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1} _ _).map D.φ) α.symm).app
        (SheafOfModules.unit (wcEtZModRing Z ℓ)) ≪≫
    (SheafOfModules.pushforwardCongr (huniq _ _ D'.φ)).app
      (SheafOfModules.unit (wcEtZModRing Z ℓ))⟩

theorem wc_et_supp_etale_excision : ∀ {X Z V : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (π : V ⟶ X) [Etale π] (e : Z ⟶ V), IsPullback (𝟙 Z) e i π → ∀ (n : ℕ) (D : wcEtPullData i n) (D' : wcEtPullData e n) (s : ℕ), Nonempty (wcEtSuppExt D s ≃ wcEtSuppExt D' s) :=
by
  classical
  intro X Z V i _ π hπ e hsq n D D' s

  have s5 : ∀ (Y : Scheme.{u}) (m : ℕ) (S : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1})
      (a b : wcEtZModRing Y m ⟶ S), a = b := by
    intro Y m S a b
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}).homEquiv
      ((Functor.const _).obj (RingCat.of (ULift.{u+1} (ZMod m)))) S).injective
    apply NatTrans.ext
    funext W
    apply RingCat.hom_ext
    have key : ∀ f g : ULift.{u+1} (ZMod m) →+* (S.obj.obj W), f = g := by
      intro f g
      have h0 := RingHom.ext_zmod (f.comp (ULift.ringEquiv.{0, u+1} (R := ZMod m)).symm.toRingHom)
        (g.comp (ULift.ringEquiv.{0, u+1} (R := ZMod m)).symm.toRingHom)
      ext x
      exact congrArg (fun k => k x.down) h0
    exact key _ _
  have main : ∀ (T : X.Etale) (w : Z ⟶ T.left), IsPullback (𝟙 Z) w i T.hom →
      ∀ (Dw : wcEtPullData w n), Nonempty (wcEtSuppExt D s ≃ wcEtSuppExt Dw s) := by
    intro T w hP Dw
    have hT : w ≫ T.hom = i := by
      have h := hP.toCommSq.w
      rw [Category.id_comp] at h
      exact h.symm
    haveI hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology X) := (wc_et_slice_continuous T).1
    haveI hcc : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology X) := (wc_et_slice_continuous T).2

    obtain ⟨ψ, ⟨eU⟩⟩ := wc_et_slice_zmod_restrict_unit T n
    obtain ⟨hA, hL, hC⟩ := wc_et_slice_module_restrict_exact T n ψ
    haveI := hA
    haveI := hL
    haveI := hC

    obtain ⟨eN⟩ := wc_et_closed_supp_obj_restrict_iso T i w hP n (s5 T.left n) D Dw ψ
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T.left n)) := HasExt.standard _
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X n)) :=
      sheafOfModules_enoughInjectives _ _

    have hvan0 := wc_et_closed_supp_obj_vanish i n D
    have hcov := wc_et_closed_two_piece_cover T i w hT
    have hloc := wc_et_closed_lifts_agree_locally T i w hP
    have hbij : ∀ Y : SheafOfModules.{u+1} (wcEtZModRing X n), Function.Bijective
        (fun f : wcEtSuppObj D ⟶ Y => (SheafOfModules.pushforward.{u+1} ψ).map f) := fun Y =>
      ⟨wc_et_supp_restrict_hom_injective T n ψ (Set.range i) (wcEtSuppObj D) Y hvan0 hcov,
        wc_et_supp_restrict_hom_surjective T n ψ (Set.range i) (wcEtSuppObj D) Y hvan0 hcov hloc⟩
    have hhom : ∀ Y : SheafOfModules.{u+1} (wcEtZModRing X n), Function.Bijective
        (fun f : wcEtSuppObj D ⟶ Y => eN.inv ≫ (SheafOfModules.pushforward.{u+1} ψ).map f) := by
      intro Y
      have hiso : Function.Bijective (fun g : (SheafOfModules.pushforward.{u+1} ψ).obj
          (wcEtSuppObj D) ⟶ (SheafOfModules.pushforward.{u+1} ψ).obj Y => eN.inv ≫ g) :=
        ⟨fun g₁ g₂ hg => (cancel_epi eN.inv).mp hg,
          fun g => ⟨eN.hom ≫ g, Iso.inv_hom_id_assoc eN g⟩⟩
      exact hiso.comp (hbij Y)

    have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing X n)) [Injective I] (k : ℕ)
        (ε : Abelian.Ext (wcEtSuppObj Dw) ((SheafOfModules.pushforward.{u+1} ψ).obj I) (k + 1)),
        ε = 0 := by
      intro I hI k ε
      haveI := wc_et_slice_module_restrict_injective T n ψ I hI
      exact Abelian.Ext.eq_zero_of_injective ε

    have hΦ := ext_transfer_of_corep (SheafOfModules.pushforward.{u+1} ψ) (wcEtSuppObj D)
      (wcEtSuppObj Dw) eN.inv hhom hvan (SheafOfModules.unit (wcEtZModRing X n)) s
    have hΨ : Function.Bijective (fun y : Abelian.Ext (wcEtSuppObj Dw)
        ((SheafOfModules.pushforward.{u+1} ψ).obj (SheafOfModules.unit (wcEtZModRing X n))) s =>
        y.comp (Abelian.Ext.mk₀ eU.hom) (add_zero s)) := by
      refine ⟨fun y₁ y₂ hy => ?_, fun z => ⟨z.comp (Abelian.Ext.mk₀ eU.inv) (add_zero s), ?_⟩⟩
      · have hy' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ eU.inv) (add_zero s)) hy
        simp only at hy'
        rwa [Abelian.Ext.comp_assoc _ _ _ (add_zero s) (add_zero 0) (by omega),
          Abelian.Ext.comp_assoc _ _ _ (add_zero s) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id,
          Abelian.Ext.comp_mk₀_id] at hy'
      · simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero s) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    exact ⟨Equiv.ofBijective _ (hΨ.comp hΦ)⟩
  exact main (MorphismProperty.Over.mk ⊤ π hπ) e hsq D'

theorem wc_tube_chart : ∀ (K : Type u) [Field K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (V : X.Opens) (z : Z), i z ∈ V → ∃ (W : X.Opens) (hzW : i z ∈ W) (h : Fin c → Γ(W, ⊤)), W ≤ V ∧ IsAffineOpen W ∧ (∀ (ZW : Scheme.{u}) (iW : ZW ⟶ W) (gW : ZW ⟶ Z), IsPullback gW iW i W.ι → wcEtCutOut iW h) ∧ RingHom.IsStandardSmoothOfRelativeDimension n (W.ι ≫ fX).appTop.hom ∧ RingHom.IsStandardSmoothOfRelativeDimension (n - c) ((Ideal.Quotient.mk (Ideal.span (Set.range h))).comp (W.ι ≫ fX).appTop.hom) ∧ Ideal.span (Set.range h) ≤ RingHom.ker ((W : Scheme.{u}).evaluation ⊤ ⟨i z, hzW⟩ trivial).hom :=
by

  have s1b : ∀ {Y : Scheme.{u}} {R : Type u} [CommRing R] (V V' : Y.Opens), IsAffineOpen V → ∀ (s : Γ(Y, V)) (hle : V' ≤ V), V' = Y.basicOpen s → ∀ (m : ℕ) (φ : R →+* Γ(Y, V)), RingHom.IsStandardSmoothOfRelativeDimension m φ → RingHom.IsStandardSmoothOfRelativeDimension m ((Y.presheaf.map (homOfLE hle).op).hom.comp φ) := by
    intro Y R _ V V' hV s hle hV' m φ hφ
    letI : Algebra Γ(Y, V) Γ(Y, V') := (Y.presheaf.map (homOfLE hle).op).hom.toAlgebra
    haveI : IsLocalization.Away s Γ(Y, V') := hV.isLocalization_of_eq_basicOpen s (homOfLE hle) hV'
    have h0 := RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
      (Rᵣ := Γ(Y, V')) s
    have := h0.comp hφ
    rw [zero_add] at this
    exact this

  have s1 : ∀ (K : Type u) [Field K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n m : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension m (i ≫ fX)] (z : Z), ∃ (W₀ : X.Opens) (_ : IsAffineOpen W₀) (e : W₀ ≤ fX ⁻¹ᵁ ⊤), i z ∈ W₀ ∧ RingHom.IsStandardSmoothOfRelativeDimension n (fX.appLE ⊤ W₀ e).hom ∧ RingHom.IsStandardSmoothOfRelativeDimension m ((i.app W₀).hom.comp (fX.appLE ⊤ W₀ e).hom) := by
    have s1a : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m f] (y : Y), ∃ (V : Y.Opens) (_ : IsAffineOpen V) (e : V ≤ f ⁻¹ᵁ ⊤), y ∈ V ∧ RingHom.IsStandardSmoothOfRelativeDimension m (f.appLE ⊤ V e).hom := by
      intro K _ Y f m _ y
      obtain ⟨U, hU, V, hV, hyV, e₀, hstd⟩ :=
        SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := m) (f := f) y
      have hfy : f y ∈ U := (Scheme.Hom.mem_preimage f).mp (e₀ hyV)
      haveI : Subsingleton ↥(Spec (.of K)) := inferInstanceAs (Subsingleton (PrimeSpectrum K))
      have hUtop : U = ⊤ := by
        rw [eq_top_iff]
        intro p _
        rw [Subsingleton.elim p (f y)]
        exact hfy
      refine ⟨V, hV, by rw [Scheme.Hom.preimage_top]; exact le_top, hyV, ?_⟩
      exact (Scheme.Hom.appLE_congr f e₀ hUtop rfl
        (fun φ => RingHom.IsStandardSmoothOfRelativeDimension m φ.hom)).mp hstd
    have s1c : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (V : X.Opens) (V' : Z.Opens), IsAffineOpen V → IsAffineOpen V' → ∀ z : Z, i z ∈ V → z ∈ V' → ∃ (s : Γ(X, V)) (t : Γ(Z, V')), i z ∈ X.basicOpen s ∧ i ⁻¹ᵁ X.basicOpen s = Z.basicOpen t := by
      intro X Z i _ V V' hV hV' z hzV hzV'
      have hpre : IsAffineOpen (i ⁻¹ᵁ V) := hV.preimage i
      obtain ⟨f, t, hft, hzf⟩ := exists_basicOpen_le_affine_inter hpre hV' z
        ⟨(Scheme.Hom.mem_preimage i).mpr hzV, hzV'⟩
      obtain ⟨s, rfl⟩ := (isClosedImmersion_iff_isAffineHom.mp inferInstance).2 V hV f
      refine ⟨s, t, ?_, ?_⟩
      · exact (Scheme.Hom.mem_preimage i).mp (by rw [Scheme.preimage_basicOpen]; exact hzf)
      · rw [Scheme.preimage_basicOpen]; exact hft
    intro K _ X Z fX n m _ i _ _ z
    obtain ⟨V, hV, eV, hzV, stdV⟩ := s1a K X fX n (i z)
    obtain ⟨V', hV', eV', hzV', stdV'⟩ := s1a K Z (i ≫ fX) m z
    obtain ⟨s, t, hs, hpre⟩ := s1c i V V' hV hV' z hzV hzV'
    have etop : ∀ {Y : Scheme.{u}} (f : Y ⟶ Spec (.of K)) (W : Y.Opens), W ≤ f ⁻¹ᵁ ⊤ :=
      fun f W => by rw [Scheme.Hom.preimage_top]; exact le_top
    refine ⟨X.basicOpen s, hV.basicOpen s, etop fX _, hs, ?_, ?_⟩
    · have h1 := Scheme.Hom.appLE_map fX eV (homOfLE (X.basicOpen_le s)).op
      have h2 := s1b V (X.basicOpen s) hV s (X.basicOpen_le s) rfl n _ stdV
      rw [← CommRingCat.hom_comp, h1] at h2
      exact h2
    · have h3 : (i.app (X.basicOpen s)).hom.comp (fX.appLE ⊤ (X.basicOpen s) (etop fX _)).hom =
          ((i ≫ fX).appLE ⊤ (i ⁻¹ᵁ X.basicOpen s) (etop _ _)).hom := by
        rw [← CommRingCat.hom_comp, ← Scheme.Hom.appLE_eq_app, Scheme.Hom.appLE_comp_appLE]
      rw [h3]
      refine (Scheme.Hom.appLE_congr (i ≫ fX) (etop _ _) rfl hpre
        (fun φ => RingHom.IsStandardSmoothOfRelativeDimension m φ.hom)).mpr ?_
      have h4 := Scheme.Hom.appLE_map (i ≫ fX) eV' (homOfLE (Z.basicOpen_le t)).op
      have h5 := s1b V' (Z.basicOpen t) hV' t (Z.basicOpen_le t) rfl m _ stdV'
      rw [← CommRingCat.hom_comp, h4] at h5
      exact h5

  have lc : ∀ (K : Type u) [Field K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ z : Z, ∃ W : X.Opens, IsAffineOpen W ∧ i z ∈ W ∧ ∃ h : Fin c → Γ(↑W, ⊤), wcEtCutOut (i ∣_ W) h := by
    have s3a : ∀ (A k M N Q : Type u) [CommRing A] [Field k] [Algebra A k] [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N] [AddCommGroup Q] [Module A Q] (f : M →ₗ[A] N) (g : N →ₗ[A] Q) (l : N →ₗ[A] M), Function.Exact f g → Function.Surjective g → l ∘ₗ f = LinearMap.id → Module.Finite k (TensorProduct A k N) → Module.Finite k (TensorProduct A k M) ∧ Module.finrank k (TensorProduct A k M) + Module.finrank k (TensorProduct A k Q) = Module.finrank k (TensorProduct A k N) := by
      intro A k M N Q _ _ _ _ _ _ _ _ _ f g l hfg hg hl hN
      let e := ((Function.Exact.splitInjectiveEquiv hfg hg) ⟨l, hl⟩).1
      let E : TensorProduct A k N ≃ₗ[k] TensorProduct A k M × TensorProduct A k Q :=
        (LinearEquiv.baseChange A k N (M × Q) e).trans (TensorProduct.prodRight A k k M Q)
      haveI : Module.Finite k (TensorProduct A k M × TensorProduct A k Q) := Module.Finite.equiv E
      haveI : Module.Finite k (TensorProduct A k M) :=
        Module.Finite.of_surjective (LinearMap.fst k (TensorProduct A k M) (TensorProduct A k Q))
          LinearMap.fst_surjective
      haveI : Module.Finite k (TensorProduct A k Q) :=
        Module.Finite.of_surjective (LinearMap.snd k (TensorProduct A k M) (TensorProduct A k Q))
          LinearMap.snd_surjective
      refine ⟨inferInstance, ?_⟩
      rw [E.finrank_eq, Module.finrank_prod]
    have s3b : ∀ (A B k F : Type u) [CommRing A] [CommRing B] [Field k] [Algebra A B] [Algebra A k] [AddCommGroup F] [Module A F] [Module B F] [IsScalarTower A B F], Function.Surjective (algebraMap A B) → RingHom.ker (algebraMap A B) ≤ RingHom.ker (algebraMap A k) → ∀ r : ℕ, Module.Free B F → Module.Finite B F → Module.finrank B F = r → Module.Finite k (TensorProduct A k F) ∧ Module.finrank k (TensorProduct A k F) = r := by
      intro A B k F _ _ _ _ _ _ _ _ _ hsurj hker r _ _ hr
      haveI : Nontrivial B := by
        refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
        have h1 : (1 : A) ∈ RingHom.ker (algebraMap A B) := by
          rw [RingHom.mem_ker, map_one]; exact h01.symm
        have h2 := hker h1
        rw [RingHom.mem_ker, map_one] at h2
        exact one_ne_zero h2
      let β : B →+* k := (algebraMap A B).liftOfSurjective hsurj ⟨algebraMap A k, hker⟩
      have hβ : ∀ x : A, β (algebraMap A B x) = algebraMap A k x := fun x =>
        RingHom.liftOfSurjective_comp_apply _ _ _ x
      let βA : B →ₗ[A] k :=
        { toFun := β
          map_add' := map_add β
          map_smul' := fun x b => by
            simp only [RingHom.id_apply, Algebra.smul_def, map_mul, hβ] }
      have hβA : ∀ b, βA b = β b := fun _ => rfl
      let μ : TensorProduct A k B →ₗ[k] k := LinearMap.liftBaseChange k βA
      let ν : k →ₗ[k] TensorProduct A k B := LinearMap.toSpanSingleton k _ ((1 : k) ⊗ₜ[A] (1 : B))
      have h₁ : μ ∘ₗ ν = LinearMap.id := by
        apply LinearMap.ext_ring
        show LinearMap.liftBaseChange k βA ((1 : k) • ((1 : k) ⊗ₜ[A] (1 : B))) = 1
        rw [one_smul, LinearMap.liftBaseChange_tmul, hβA, map_one, one_smul]
      have h₂ : ν ∘ₗ μ = LinearMap.id := by
        apply LinearMap.ext; intro t
        induction t using TensorProduct.induction_on with
        | zero => rw [map_zero, map_zero]
        | tmul a b =>
          obtain ⟨x, rfl⟩ := hsurj b
          show (LinearMap.liftBaseChange k βA (a ⊗ₜ[A] algebraMap A B x)) • ((1 : k) ⊗ₜ[A] (1 : B)) =
            a ⊗ₜ[A] algebraMap A B x
          rw [LinearMap.liftBaseChange_tmul, hβA, hβ, TensorProduct.smul_tmul', smul_eq_mul,
            smul_eq_mul, mul_one, mul_comm, ← Algebra.smul_def, TensorProduct.smul_tmul,
            Algebra.algebraMap_eq_smul_one]
        | add s t hs ht => rw [map_add, hs, ht, map_add]
      let μe : TensorProduct A k B ≃ₗ[k] k := LinearEquiv.ofLinear μ ν h₁ h₂
      let b := Module.finBasisOfFinrankEq B F hr
      let E₁ : F ≃ₗ[A] (Fin r → B) := b.equivFun.restrictScalars A
      let E : TensorProduct A k F ≃ₗ[k] (Fin r → k) :=
        ((LinearEquiv.baseChange A k _ _ E₁).trans (TensorProduct.piRight A k k (fun _ : Fin r => B))).trans
          (LinearEquiv.piCongrRight (fun _ => μe))
      haveI : Module.Finite k (TensorProduct A k F) := Module.Finite.equiv E.symm
      exact ⟨inferInstance, by rw [E.finrank_eq, Module.finrank_fin_fun]⟩
    have s3 : ∀ (R A B : Type u) [CommRing R] [CommRing A] [CommRing B] (φ : R →+* A) (π : A →+* B) (n m : ℕ), Function.Surjective π → RingHom.IsStandardSmoothOfRelativeDimension n φ → RingHom.IsStandardSmoothOfRelativeDimension m (π.comp φ) → ∀ (k : Type u) [Field k] [Algebra A k], RingHom.ker π ≤ RingHom.ker (algebraMap A k) → (RingHom.ker π).FG ∧ Module.Finite k (TensorProduct A k (RingHom.ker π).Cotangent) ∧ Module.finrank k (TensorProduct A k (RingHom.ker π).Cotangent) + m = n := by
      intro R A B _ _ _ φ π n m hπ hstdA hstdB k _ _ hker
      letI : Algebra R A := φ.toAlgebra
      letI : Algebra A B := π.toAlgebra
      letI : Algebra R B := (π.comp φ).toAlgebra
      haveI : IsScalarTower R A B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      haveI hA : Algebra.IsStandardSmoothOfRelativeDimension n R A := hstdA
      haveI hB : Algebra.IsStandardSmoothOfRelativeDimension m R B := hstdB
      haveI : Algebra.IsStandardSmooth R A := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
      haveI : Algebra.IsStandardSmooth R B := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth m
      have hsurj : Function.Surjective (algebraMap A B) := hπ
      have hkerA : RingHom.ker (algebraMap A B) ≤ RingHom.ker (algebraMap A k) := hker
      haveI : Nontrivial B := by
        refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
        have h1 : (1 : A) ∈ RingHom.ker π := by
          rw [RingHom.mem_ker, map_one]; exact h01.symm
        have h2 := hker h1
        rw [RingHom.mem_ker, map_one] at h2
        exact one_ne_zero h2
      haveI : Nontrivial A := by
        refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
        have := congrArg π h01
        rw [map_zero, map_one] at this
        exact zero_ne_one this
      have hFG : (RingHom.ker π).FG := by
        haveI : Algebra.FinitePresentation R A := Algebra.IsStandardSmooth.finitePresentation
        haveI : Algebra.FinitePresentation R B := Algebra.IsStandardSmooth.finitePresentation
        exact Algebra.FinitePresentation.ker_fG_of_surjective (IsScalarTower.toAlgHom R A B) hπ
      have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R A B hsurj
      have hgs := KaehlerDifferential.mapBaseChange_surjective R A B hsurj
      haveI : Algebra.FormallySmooth R B := inferInstance
      obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := R) (A := B) (P := A)
        hsurj).mp inferInstance
      have hrA : Module.finrank A Ω[A⁄R] = n :=
        Module.finrank_eq_of_rank_eq (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential n)
      have hrB : Module.finrank B Ω[B⁄R] = m :=
        Module.finrank_eq_of_rank_eq (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential m)
      haveI : Module.Free A Ω[A⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
      haveI : Module.Free B Ω[B⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
      have hrN : Module.finrank B (TensorProduct A B Ω[A⁄R]) = n := by
        rw [Module.finrank_baseChange, hrA]
      obtain ⟨hNfin, hNr⟩ := s3b A B k (TensorProduct A B Ω[A⁄R]) hsurj hkerA n inferInstance
        inferInstance hrN
      obtain ⟨-, hQr⟩ := s3b A B k Ω[B⁄R] hsurj hkerA m inferInstance inferInstance hrB
      obtain ⟨hMfin, hMr⟩ := s3a A k _ _ _ (KaehlerDifferential.kerCotangentToTensor R A B)
        ((KaehlerDifferential.mapBaseChange R A B).restrictScalars A) l hex hgs hl hNfin
      rw [hNr, hQr] at hMr
      exact ⟨hFG, hMfin, hMr⟩
    have s4 : ∀ (A k M : Type u) [CommRing A] [Field k] [Algebra A k] [AddCommGroup M] [Module A M] (c : ℕ), Module.Finite k (TensorProduct A k M) → Module.finrank k (TensorProduct A k M) = c → ∃ m : Fin c → M, Submodule.span k (Set.range fun j => (1 : k) ⊗ₜ[A] m j) = ⊤ := by
      intro A k M _ _ _ _ _ c hfin hc
      have hS : Submodule.span k (Set.range fun x : M => (1 : k) ⊗ₜ[A] x) = ⊤ := by
        rw [eq_top_iff]
        rintro t -
        induction t using TensorProduct.induction_on with
        | zero => exact zero_mem _
        | tmul a x =>
          have : a ⊗ₜ[A] x = a • ((1 : k) ⊗ₜ[A] x) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [this]
          exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨x, rfl⟩)
        | add x y hx hy => exact add_mem hx hy
      obtain ⟨T, hTS, hTspan, hTli⟩ := exists_linearIndependent k (Set.range fun x : M => (1 : k) ⊗ₜ[A] x)
      have hTfin : T.Finite := LinearIndependent.setFinite hTli
      haveI : Fintype T := hTfin.fintype
      have hTtop : Submodule.span k T = ⊤ := hTspan.trans hS
      let b : Module.Basis T k (TensorProduct A k M) :=
        Module.Basis.mk hTli (le_of_eq (by rw [Subtype.range_coe, hTtop]))
      have hcard : Fintype.card T = c := by rw [← hc, Module.finrank_eq_card_basis b]
      let σ := Fintype.equivFinOfCardEq hcard
      have hx : ∀ t : T, ∃ x : M, (1 : k) ⊗ₜ[A] x = t := fun t => hTS t.2
      choose x hx using hx
      refine ⟨fun j => x (σ.symm j), ?_⟩
      have : Set.range (fun j => (1 : k) ⊗ₜ[A] x (σ.symm j)) = T := by
        ext t; constructor
        · rintro ⟨j, rfl⟩; show (1 : k) ⊗ₜ[A] x (σ.symm j) ∈ T; rw [hx]; exact (σ.symm j).2
        · intro ht
          refine ⟨σ ⟨t, ht⟩, ?_⟩
          show (1 : k) ⊗ₜ[A] x (σ.symm (σ ⟨t, ht⟩)) = t
          rw [Equiv.symm_apply_apply, hx]
      rw [this, hTtop]
    have s5 : ∀ (A : Type u) [CommRing A] (I : Ideal A), I.FG → ∀ (q : Ideal A) [q.IsPrime], I ≤ q → ∀ (c : ℕ) (h : Fin c → ↥I), Submodule.span q.ResidueField (Set.range fun j => (1 : q.ResidueField) ⊗ₜ[A] I.toCotangent (h j)) = ⊤ → ∃ g : A, g ∉ q ∧ ∀ a ∈ I, g * a ∈ Ideal.span (Set.range fun j => (h j : A)) := by
      intro A _ I hFG q _ hIq c h hspan
      obtain ⟨N', hN'⟩ : ∃ N' : Submodule A I,
          N' = Submodule.comap I.subtype (Ideal.span (Set.range fun j => (h j : A))) := ⟨_, rfl⟩
      haveI : Module.Finite A I := Module.Finite.iff_fg.mpr hFG
      haveI : Module.Finite A (I ⧸ N') :=
        Module.Finite.of_surjective N'.mkQ (Submodule.mkQ_surjective _)
      have hzero : ∀ (r : A), r ∈ I → ∀ (y : I ⧸ N'), r • ((1 : q.ResidueField) ⊗ₜ[A] y) = 0 := by
        intro r hr y
        rw [TensorProduct.smul_tmul', Algebra.smul_def, mul_one,
          (Ideal.algebraMap_residueField_eq_zero).mpr (hIq hr), TensorProduct.zero_tmul]
      let φ₀ : I →ₗ[A] TensorProduct A q.ResidueField (I ⧸ N') :=
        (TensorProduct.mk A q.ResidueField (I ⧸ N') 1) ∘ₗ N'.mkQ
      have hφ₀ : I • (⊤ : Submodule A I) ≤ LinearMap.ker φ₀ := by
        rw [Submodule.smul_le]
        intro r hr y _
        rw [LinearMap.mem_ker, map_smul]
        exact hzero r hr _
      obtain ⟨ψ₀, hψdef⟩ : ∃ ψ₀ : I.Cotangent →ₗ[A] TensorProduct A q.ResidueField (I ⧸ N'),
          ψ₀ = (I • (⊤ : Submodule A I)).liftQ φ₀ hφ₀ := ⟨_, rfl⟩
      have hψ₀ : ∀ x : I, ψ₀ (I.toCotangent x) = (1 : q.ResidueField) ⊗ₜ[A] N'.mkQ x := by
        intro x; rw [hψdef]; rfl
      obtain ⟨Ψ, hΨdef⟩ : ∃ Ψ : TensorProduct A q.ResidueField I.Cotangent →ₗ[q.ResidueField]
          TensorProduct A q.ResidueField (I ⧸ N'), Ψ = LinearMap.liftBaseChange q.ResidueField ψ₀ :=
        ⟨_, rfl⟩
      have hΨ1 : ∀ x : I, Ψ ((1 : q.ResidueField) ⊗ₜ[A] I.toCotangent x) =
          (1 : q.ResidueField) ⊗ₜ[A] N'.mkQ x := by
        intro x; rw [hΨdef, LinearMap.liftBaseChange_tmul, one_smul, hψ₀]
      have hΨ : Ψ = 0 := by
        apply LinearMap.ext_on_range hspan
        intro j
        show Ψ ((1 : q.ResidueField) ⊗ₜ[A] I.toCotangent (h j)) = 0
        rw [hΨ1]
        have : N'.mkQ (h j) = 0 := by
          rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, hN', Submodule.mem_comap]
          exact Submodule.subset_span ⟨j, rfl⟩
        rw [this, TensorProduct.tmul_zero]
      have hall : ∀ s : TensorProduct A q.ResidueField (I ⧸ N'), s = 0 := by
        intro s
        induction s using TensorProduct.induction_on with
        | zero => rfl
        | tmul a y =>
          obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective N' y
          have h1 : (1 : q.ResidueField) ⊗ₜ[A] N'.mkQ x = 0 := by
            rw [← hΨ1, hΨ, LinearMap.zero_apply]
          rw [show a ⊗ₜ[A] N'.mkQ x = a • ((1 : q.ResidueField) ⊗ₜ[A] N'.mkQ x) by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one], h1, smul_zero]
