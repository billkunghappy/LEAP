      rw [hD, ← hE]
      rfl
    letI iA : Algebra K Γ(Y, U) := φK.toAlgebra
    haveI hftA : Algebra.FiniteType K Γ(Y, U) := by
      have h1 : (f.appLE ⊤ U le_top).hom.FiniteType :=
