        eP ≫ Y.homOfLE (inf_le_left : A' ⊓ B' ≤ A') = pA ≫ eA ∧
        eP ≫ Y.homOfLE (inf_le_right : A' ⊓ B' ≤ B') = pB ≫ eB := by
