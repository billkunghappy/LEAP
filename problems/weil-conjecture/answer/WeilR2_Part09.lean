            (M := (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            (N := (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
