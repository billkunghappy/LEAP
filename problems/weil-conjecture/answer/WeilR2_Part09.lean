        have h1 := Scheme.IdealSheafData.ker_subschemeι_app 𝓘 ⟨⊤, isAffineOpen_top V⟩
        have h2 := Scheme.IdealSheafData.ofIdealTop_ideal J ⟨⊤, isAffineOpen_top V⟩
        change RingHom.ker (ι.app ⊤).hom = J
        rw [h1]
        change 𝓘.ideal ⟨⊤, isAffineOpen_top V⟩ = J
        rw [h2]
        have : (homOfLE (le_top : (⊤ : V.Opens) ≤ ⊤)) = 𝟙 _ := Subsingleton.elim _ _
        simp
      have hle : RingHom.ker iW.appTop.hom ≤ RingHom.ker (ι ≫ φ).appTop.hom := by
        rw [hI, Ideal.span_le, Set.range_subset_iff]
        intro k
        show (ι ≫ φ).appTop.hom (h k) = 0
        rw [F0, ← RingHom.mem_ker, hι]
