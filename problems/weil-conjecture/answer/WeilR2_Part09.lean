    IsGrothendieckAbelian.wellPowered _
  haveI : WellPowered.{u+1} (SheafOfModules.{u+1} (wcEtZModRing Z ℓ))ᵒᵖ :=
    Abelian.wellPowered_opposite
  haveI := t_s2 (Scheme.smallEtaleTopology X) (wcEtZModRing X ℓ)
  haveI := t_s2 (Scheme.smallEtaleTopology Z) (wcEtZModRing Z ℓ)
  haveI : Limits.PreservesColimitsOfSize.{u+1, u+1}
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) :=
    t_s4 (wcEtBaseChange i) (wcEtZModRing X ℓ) (wcEtZModRing Z ℓ) D.φ
