    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology Y₁) _
  let τr := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y₂)).app (wcEtZModRing Y₂ n)
  let φfg : wcEtZModRing Y n ⟶ ((wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂).sheafPushforwardContinuous
