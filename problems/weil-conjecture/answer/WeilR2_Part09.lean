  have hext : ∀ e : SheafOfModules.unit (wcEtZModRing Y₂ n) ⟶
      SheafOfModules.unit (wcEtZModRing Y₂ n),
      ∃ m : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing Y₂ n)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcEtZModRing Y₂ n)),
        m.app (SheafOfModules.unit (wcEtZModRing Y₂ n)) = e := by
    intro e
    have hcomm : ∀ (V : (Y₂.Etale)ᵒᵖ) (a b : (wcEtZModRing Y₂ n).obj.obj V), a * b = b * a :=
      s2 Y₂
    let R := wcEtZModRing Y₂ n
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ V : (Y₂.Etale)ᵒᵖ, R.obj.obj V := fun V => (s.1 V : R.obj.obj V)
    have hσ : ∀ {V W : (Y₂.Etale)ᵒᵖ} (f : V ⟶ W), (R.obj.map f).hom (σ V) = σ W :=
      fun f => PresheafOfModules.sections_property s f
    let L : ∀ (M : SheafOfModules.{u+1} R) (V : (Y₂.Etale)ᵒᵖ), M.val.obj V ⟶ M.val.obj V :=
      fun M V => ModuleCat.ofHom
        { toFun := fun x => σ V • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm V] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro V W f
        ext x
        show σ W • (M.val.map f).hom x = (M.val.map f).hom (σ V • x)
