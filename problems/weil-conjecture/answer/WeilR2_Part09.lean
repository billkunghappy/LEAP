theorem wc_abelian_extzero_mv_ext_glue : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] {CA CB CW : Type*} [Category CA] [Category CB] [Category CW] (LA : CA ⥤ C) (GA : C ⥤ CA) (LB : CB ⥤ C) (GB : C ⥤ CB) (LW : CW ⥤ C) (GW : C ⥤ CW) (adjA : LA ⊣ GA) (adjB : LB ⊣ GB) (adjW : LW ⊣ GW) (PA PB PW : C → Prop), (∀ K, Mono (adjA.counit.app K)) → (∀ K, Mono (adjB.counit.app K)) → (∀ K, Mono (adjW.counit.app K)) → (∀ X, PA (LA.obj X)) → (∀ X, PB (LB.obj X)) → (∀ X, PW (LW.obj X)) → (∀ K, PA K → Epi (adjA.counit.app K)) → (∀ K, PB K → Epi (adjB.counit.app K)) → (∀ K, PW K → Epi (adjW.counit.app K)) → (∀ (K G : C) (m : G ⟶ K), Mono m → PA K → PA G) → (∀ (K G : C) (m : G ⟶ K), Mono m → PB K → PB G) → (∀ K, PW K → PA K) → (∀ K, PW K → PB K) → (∀ K, PA K → PB K → PW K) → ∀ N : C, Epi (Limits.biprod.desc (adjA.counit.app N) (adjB.counit.app N)) → ∃ (u : LW.obj (GW.obj N) ⟶ LA.obj (GA.obj N)) (v : LW.obj (GW.obj N) ⟶ LB.obj (GB.obj N)), u ≫ adjA.counit.app N = adjW.counit.app N ∧ v ≫ adjB.counit.app N = adjW.counit.app N ∧ ∀ (Λ : C) (q : ℕ) (x : Abelian.Ext (LA.obj (GA.obj N)) Λ q) (y : Abelian.Ext (LB.obj (GB.obj N)) Λ q), (Abelian.Ext.mk₀ u).comp x (zero_add q) = (Abelian.Ext.mk₀ v).comp y (zero_add q) → ∃ θ : Abelian.Ext N Λ q, (Abelian.Ext.mk₀ (adjA.counit.app N)).comp θ (zero_add q) = x ∧ (Abelian.Ext.mk₀ (adjB.counit.app N)).comp θ (zero_add q) = y :=
by
  intro C _ _ _ CA CB CW _ _ _ LA GA LB GB LW GW adjA adjB adjW PA PB PW monoA monoB monoW sA sB sW
    eA eB eW clA clB wa wb ab N hepi
  have := monoA N
  have := monoB N
  have := monoW N

  have isoAW : IsIso (adjA.counit.app (LW.obj (GW.obj N))) := by
    have := monoA (LW.obj (GW.obj N))
    have := eA (LW.obj (GW.obj N)) (wa _ (sW (GW.obj N)))
    exact isIso_of_mono_of_epi _
  have isoBW : IsIso (adjB.counit.app (LW.obj (GW.obj N))) := by
    have := monoB (LW.obj (GW.obj N))
    have := eB (LW.obj (GW.obj N)) (wb _ (sW (GW.obj N)))
    exact isIso_of_mono_of_epi _
