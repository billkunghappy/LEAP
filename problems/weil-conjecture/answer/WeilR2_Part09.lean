    (xb : (wcGeomPoint F X h).left) (hxbc : IsClosed ({xb} : Set (wcGeomPoint F X h).left))
    (hpre : g.left ⁻¹' {xb} = {e.inv (IsLocalRing.closedPoint A)})
    (hfib : IsIso (Limits.pullback.snd g.left ((wcGeomPoint F X h).left.fromSpecResidueField xb)))
    (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {e.inv (IsLocalRing.closedPoint A)}ᶜ)
    (f : Fin d → A) (hspan : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (hdim : ringKrullDim A = (d : WithBot ℕ∞))
    (hℓA : IsUnit ((ℓ : ℕ) : A))
    (hT : ⊤ ≤ wcKOpen VT.left (wcParamFn j e f) (d - 1 + 1) (d - 1 + 1))
    (hMV : ∀ {O₁₂ O₁ O₂ O : VT.left.Opens} (h₁ : O₁₂ ≤ O₁) (h₂ : O₁₂ ≤ O₂) (h₃ : O₁ ≤ O)
      (h₄ : O₂ ≤ O), O₁ ⊔ O₂ = O → O₁ ⊓ O₂ = O₁₂ →
        (wcMVComplex X.left VT h₁ h₂ h₃ h₄).ShortExact) :
    ∃ σ : Abelian.Ext (wcFreeSheaf X.left (wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)))
        (wcRootTwist X.left (ℓ ^ n) d) d,
      (∀ b : wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1) ⟶
          wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1),
        (∀ i, b.left.appTop.hom ((wcKOpen VT.left (wcParamFn j e f) 1 1).ι.appTop.hom
            (wcParamFn j e f i)) =
          (wcKOpen VT.left (wcParamFn j e f) 1 1).ι.appTop.hom (wcParamFn j e f i)) →
        (Abelian.Ext.mk₀ (wcFreeSheafMap X.left b)).comp σ (zero_add d) = σ) ∧
      ℓ ^ (n - 1) • wcKFinal X.left VT (wcParamFn j e f) (wcRootTwist X.left (ℓ ^ n) d) hT σ ≠ 0 :=
by
  classical

  have hunit : ∀ (Z : Scheme.{u}) (r : Γ(Z, ⊤)), (∀ x : Z, x ∈ Z.basicOpen r) → IsUnit r := by
    intro Z r hr
    exact RingedSpace.isUnit_of_isUnit_germ Z.toSheafedSpace ⊤ r
