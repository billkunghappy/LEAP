    (x : Abelian.Ext (wcFreeSheaf (Spec (.of (MvPolynomial (Fin d) K)))
      (wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
        (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) a b)))
      (wcRootTwist (Spec (.of (MvPolynomial (Fin d) K))) (ℓ ^ n) d) k) : x = 0 :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hK : (ℓ : K) ≠ 0 := hℓK.ne_zero

  have s2 : ∀ {S X' Y' X₀ Y₀ Z : Scheme.{u}} (f' : X' ⟶ S) (g' : Y' ⟶ S) (i₁ : X₀ ⟶ X')
      (i₂ : Y₀ ⟶ Y') [IsOpenImmersion i₁] [IsOpenImmersion i₂] (ι : Limits.pullback f' g' ≅ Z)
      (U : Z.Opens), (∀ w : ↥(Limits.pullback f' g'), ι.hom w ∈ U ↔
        (Limits.pullback.fst f' g' w ∈ Set.range i₁ ∧ Limits.pullback.snd f' g' w ∈ Set.range i₂)) →
      Nonempty ((U : Scheme.{u}) ≅ Limits.pullback (i₁ ≫ f') (i₂ ≫ g')) := by
    intro S X' Y' X₀ Y₀ Z f' g' i₁ i₂ _ _ ι U h
    let m := Limits.pullback.map (i₁ ≫ f') (i₂ ≫ g') f' g' i₁ i₂ (𝟙 S) (Category.comp_id _)
      (Category.comp_id _)
    have : IsOpenImmersion m :=
      MorphismProperty.pullbackMap (P := @IsOpenImmersion) (inferInstance : IsOpenImmersion i₁)
        (inferInstance : IsOpenImmersion i₂) rfl rfl
    have hm := Scheme.Pullback.range_map (i₁ ≫ f') (i₂ ≫ g') f' g' i₁ i₂ (𝟙 S)
      (Category.comp_id _) (Category.comp_id _)
    have hr : Set.range (m ≫ ι.hom) = (U : Set Z) := by
      ext z
      constructor
      · rintro ⟨v, rfl⟩
        rw [Scheme.Hom.comp_apply]
        have hv : m v ∈ Set.range m := ⟨v, rfl⟩
        rw [hm] at hv
        exact (h (m v)).2 hv
      · intro hz
        have h1 : ι.hom (ι.inv z) ∈ U := by rw [Scheme.inv_hom_apply]; exact hz
        have h2 := (h _).1 h1
        have h3 : ι.inv z ∈ Set.range m := by rw [hm]; exact h2
        obtain ⟨v, hv⟩ := h3
        exact ⟨v, by rw [Scheme.Hom.comp_apply, hv, Scheme.inv_hom_apply]⟩
    exact ⟨IsOpenImmersion.isoOfRangeEq U.ι (m ≫ ι.hom)
      (by rw [Scheme.Opens.range_ι]; exact hr.symm)⟩

  have s3 : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) ∧ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) = {x | (Polynomial.X : Polynomial K) ∉ x.asIdeal} ∧ Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K))) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) = Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) := by
    refine ⟨IsOpenImmersion.of_isLocalization (Polynomial.X : Polynomial K), ?_, ?_⟩
    · have hr := PrimeSpectrum.localization_away_comap_range (LaurentPolynomial K)
        (Polynomial.X : Polynomial K)
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        have h1 : PrimeSpectrum.comap (algebraMap (Polynomial K) (LaurentPolynomial K)) y ∈
            Set.range (PrimeSpectrum.comap (algebraMap (Polynomial K) (LaurentPolynomial K))) :=
          ⟨y, rfl⟩
        rw [hr] at h1
        exact (PrimeSpectrum.mem_basicOpen _ _).1 h1
      · intro hx
        have h1 : (x : PrimeSpectrum (Polynomial K)) ∈
            ((PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) :
              Set (PrimeSpectrum (Polynomial K))) := hx
        rw [← hr] at h1
        obtain ⟨y, hy⟩ := h1
        exact ⟨y, hy⟩
    · have h : (algebraMap (Polynomial K) (LaurentPolynomial K)).comp (algebraMap K (Polynomial K)) =
          algebraMap K (LaurentPolynomial K) := by
        refine RingHom.ext fun k => ?_
        simp [LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_C,
          LaurentPolynomial.algebraMap_apply]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]
  obtain ⟨hj, hjr, hjq⟩ := s3
  have star : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (x : Spec (.of S)) (r : R),
      r ∈ (Spec.map (CommRingCat.ofHom φ) x).asIdeal ↔ φ r ∈ x.asIdeal := by
    intro R S _ _ φ x r
    exact Iff.rfl

  have hiso : ∀ (m : ℕ) (E : (Spec (.of (MvPolynomial (Fin m) K))).Opens)
      (E' : (Spec (.of (MvPolynomial (Fin (m + 1)) K))).Opens),
      (∀ x : Spec (.of (MvPolynomial (Fin (m + 1)) K)), x ∈ E' ↔
        ((MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) K) ∉ x.asIdeal ∧
          Spec.map (CommRingCat.ofHom (MvPolynomial.rename (Fin.castSucc : Fin m → Fin (m + 1)) :
            MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin (m + 1)) K).toRingHom) x ∈ E)) →
      Nonempty ((E' : Scheme.{u}) ≅ Limits.pullback
        (E.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K))))
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) := by
    intro m E E' hE'
    obtain ⟨ι, e₁, e₂⟩ : ∃ ι : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≅ Spec (.of (MvPolynomial (Fin (m + 1)) K)), ι.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename (Fin.castSucc : Fin m → Fin (m + 1)) : MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin (m + 1)) K).toRingHom) = Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ∧ ι.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) K)).toRingHom) = Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
      let Ψ : MvPolynomial (Fin (m + 1)) K ≃ₐ[K]
          TensorProduct K (MvPolynomial (Fin m) K) (Polynomial K) :=
        ((MvPolynomial.renameEquiv K finSuccEquivLast).trans
          (MvPolynomial.optionEquivLeft K (Fin m))).trans (polyEquivTensor K (MvPolynomial (Fin m) K))
      have hX0 : Ψ (MvPolynomial.X (Fin.last m)) = 1 ⊗ₜ Polynomial.X := by
        simp [Ψ, MvPolynomial.rename_X, finSuccEquivLast_last, MvPolynomial.optionEquivLeft_X_none,
          polyEquivTensor_apply]
      have hXs : ∀ j : Fin m, Ψ (MvPolynomial.X j.castSucc) = MvPolynomial.X j ⊗ₜ 1 := by
        intro j
        simp [Ψ, MvPolynomial.rename_X, finSuccEquivLast_castSucc,
          MvPolynomial.optionEquivLeft_X_some, polyEquivTensor_apply]
      have I1 : (Ψ.toRingEquiv.toRingHom).comp
          (MvPolynomial.rename Fin.castSucc :
            MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin (m + 1)) K).toRingHom =
          Algebra.TensorProduct.includeLeftRingHom := by
        have : (Ψ.toAlgHom.comp (MvPolynomial.rename Fin.castSucc)) =
            (Algebra.TensorProduct.includeLeft : MvPolynomial (Fin m) K →ₐ[K] _) := by
          apply MvPolynomial.algHom_ext
          intro j
          simp [hXs]
        refine RingHom.ext fun x => ?_
        have hx := AlgHom.congr_fun this x
        simpa using hx
      have I2 : (Ψ.toRingEquiv.toRingHom).comp
          (Polynomial.aeval (MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) K)).toRingHom =
          (Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] _).toRingHom := by
        have : (Ψ.toAlgHom.comp
            (Polynomial.aeval (MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) K))) =
            (Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] _) := by
          apply Polynomial.algHom_ext
          simp [hX0]
        refine RingHom.ext fun x => ?_
        have hx := AlgHom.congr_fun this x
        simpa using hx
      let e : Spec (.of (TensorProduct K (MvPolynomial (Fin m) K) (Polynomial K))) ≅
          Spec (.of (MvPolynomial (Fin (m + 1)) K)) :=
        Scheme.Spec.mapIso (Ψ.toRingEquiv.toCommRingCatIso).op
      have he : e.hom = Spec.map (CommRingCat.ofHom Ψ.toRingEquiv.toRingHom) := rfl
      refine ⟨pullbackSpecIso K _ _ ≪≫ e, ?_, ?_⟩
      · rw [Iso.trans_hom, Category.assoc, he, ← Spec.map_comp, ← CommRingCat.ofHom_comp, I1]
        exact pullbackSpecIso_hom_fst K _ _
      · rw [Iso.trans_hom, Category.assoc, he, ← Spec.map_comp, ← CommRingCat.ofHom_comp, I2]
        exact pullbackSpecIso_hom_snd K _ _
    have Cf : ∀ w, Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) w = Spec.map (CommRingCat.ofHom (MvPolynomial.rename (Fin.castSucc : Fin m → Fin (m + 1)) : MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin (m + 1)) K).toRingHom) (ι.hom w) := by
      intro w
      rw [← e₁, Scheme.Hom.comp_apply]
    have C2 : ∀ w, (Polynomial.X : Polynomial K) ∈ (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) w).asIdeal ↔
        (MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) K) ∈ (ι.hom w).asIdeal := by
      intro w
      rw [← e₂, Scheme.Hom.comp_apply, star]
      simp [Polynomial.aeval_X]
    obtain ⟨eE⟩ := s2 _ _ E.ι _ ι E' (by
      intro w
      rw [hE' (ι.hom w), Scheme.Opens.range_ι, hjr, Set.mem_setOf_eq, C2, Cf]
      exact and_comm)
    exact ⟨eE ≪≫ Limits.pullback.congrHom rfl hjq⟩

  have hpeel : ∀ (m : ℕ) (E : (Spec (.of (MvPolynomial (Fin m) K))).Opens)
      (E' : (Spec (.of (MvPolynomial (Fin (m + 1)) K))).Opens),
      (∀ x : Spec (.of (MvPolynomial (Fin (m + 1)) K)), x ∈ E' ↔
        ((MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) K) ∉ x.asIdeal ∧
          Spec.map (CommRingCat.ofHom (MvPolynomial.rename (Fin.castSucc : Fin m → Fin (m + 1)) :
            MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin (m + 1)) K).toRingHom) x ∈ E)) →
      ∀ t : ℕ, (∀ q, t ≤ q → Subsingleton (wcEtCoh (E : Scheme.{u}) ℓ q)) →
      ∀ q, t + 1 ≤ q → Subsingleton (wcEtCoh (E' : Scheme.{u}) ℓ q) := by
    intro m E E' hE' t ht q hq
    obtain ⟨P⟩ := hiso m E E' hE'
    haveI : LocallyOfFiniteType
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))) := by
      rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
      exact RingHom.finiteType_algebraMap.mpr inferInstance
    obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
    haveI h1 := ht (q' + 1) (by omega)
    haveI h0 := ht q' (by omega)
    obtain ⟨hfin, hcard⟩ := wc_et_coh_gm_product_card_le K ℓ hℓp hK (E : Scheme.{u})
      (E.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin m) K)))) q'
      (Finite.of_subsingleton) (Finite.of_subsingleton)
    haveI := hfin
    have c1 : Nat.card (wcEtCoh (E : Scheme.{u}) ℓ (q' + 1)) ≤ 1 :=
      Finite.card_le_one_iff_subsingleton.mpr h1
    have c0 : Nat.card (wcEtCoh (E : Scheme.{u}) ℓ q') ≤ 1 :=
      Finite.card_le_one_iff_subsingleton.mpr h0
    haveI hsub := Finite.card_le_one_iff_subsingleton.mp
      (hcard.trans (le_trans (Nat.mul_le_mul c1 c0) (le_of_eq (one_mul 1))))
    obtain ⟨eq⟩ := wc_et_coh_iso_invariance P.hom ℓ (q' + 1)
    exact eq.symm.injective.subsingleton

  have hC1 : b ≤ a → ∀ m, a ≤ m → ∀ (E : (Spec (.of (MvPolynomial (Fin m) K))).Opens),
      (E : Set (Spec (.of (MvPolynomial (Fin m) K)))) =
        {x | (∀ i : Fin m, a ≤ i.val → (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal) ∧
          ∃ i : Fin m, i.val < b ∧ (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal} →
      ∀ q, 2 * b + (m - a) ≤ q → Subsingleton (wcEtCoh (E : Scheme.{u}) ℓ q) := by
    intro hba m ham
    induction m, ham using Nat.le_induction with
    | base =>
      intro E hE q hq
      refine wc_et_affine_partial_punct_vanishing K ℓ hℓp hK a b hba E ?_ q (by omega)
      rw [hE]
      ext x
      simp only [Set.mem_setOf_eq]
      constructor
      · rintro ⟨-, h⟩
        exact h
      · intro h
        exact ⟨fun i hi => absurd i.isLt (by omega), h⟩
    | succ m ham ih =>
      intro E' hE' q hq
      have hopen : IsOpen {x : Spec (.of (MvPolynomial (Fin m) K)) |
          (∀ i : Fin m, a ≤ i.val → (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal) ∧
          ∃ i : Fin m, i.val < b ∧ (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal} := by
        have e : {x : Spec (.of (MvPolynomial (Fin m) K)) |
            (∀ i : Fin m, a ≤ i.val → (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal) ∧
            ∃ i : Fin m, i.val < b ∧ (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal} =
            (⋂ i ∈ {i : Fin m | a ≤ i.val}, {x : Spec (.of (MvPolynomial (Fin m) K)) |
              (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal}) ∩
            (⋃ i ∈ {i : Fin m | i.val < b}, {x : Spec (.of (MvPolynomial (Fin m) K)) |
              (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal}) := by
          ext x; simp
        rw [e]
        exact ((Set.toFinite _).isOpen_biInter fun i _ =>
          PrimeSpectrum.isOpen_basicOpen (a := (MvPolynomial.X i : MvPolynomial (Fin m) K))).inter
          (isOpen_biUnion fun i _ =>
            PrimeSpectrum.isOpen_basicOpen (a := (MvPolynomial.X i : MvPolynomial (Fin m) K)))
      let Em : (Spec (.of (MvPolynomial (Fin m) K))).Opens := ⟨_, hopen⟩
      have hc : ∀ (x : Spec (.of (MvPolynomial (Fin (m + 1)) K))) (j : Fin m),
          (MvPolynomial.X j : MvPolynomial (Fin m) K) ∈
            (Spec.map (CommRingCat.ofHom (MvPolynomial.rename (Fin.castSucc : Fin m → Fin (m + 1)) :
              MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin (m + 1)) K).toRingHom) x).asIdeal ↔
          (MvPolynomial.X j.castSucc : MvPolynomial (Fin (m + 1)) K) ∈ x.asIdeal := by
        intro x j
        rw [star]
        simp [MvPolynomial.rename_X]
      refine hpeel m Em E' ?_ (2 * b + (m - a)) (fun q hq => ih Em rfl q hq) q (by omega)
      intro x
      have hx' := Set.ext_iff.mp hE' x
      simp only [SetLike.mem_coe, Set.mem_setOf_eq] at hx'
      rw [hx']
      constructor
      · rintro ⟨h1, i, hi, h2⟩
        refine ⟨h1 (Fin.last m) (by simp; omega), fun j hj => ?_, ⟨i.val, by omega⟩, hi, ?_⟩
        · rw [hc]
          exact h1 _ (by simpa using hj)
        · rw [hc]
          have : (⟨i.val, by omega⟩ : Fin m).castSucc = i := Fin.ext rfl
          rw [this]
          exact h2
      · rintro ⟨hl, h1, j, hj, h2⟩
        refine ⟨fun i hi => ?_, j.castSucc, by simpa using hj, by rw [← hc]; exact h2⟩
        rcases Fin.eq_castSucc_or_eq_last i with ⟨j', rfl⟩ | rfl
        · rw [← hc]
          exact h1 j' (by simpa using hi)
        · exact hl

  have hC2 : ∀ m, a ≤ m → ∀ (E : (Spec (.of (MvPolynomial (Fin m) K))).Opens),
      (E : Set (Spec (.of (MvPolynomial (Fin m) K)))) =
        {x | ∀ i : Fin m, a ≤ i.val → (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal} →
      ∀ q, m - a + 1 ≤ q → Subsingleton (wcEtCoh (E : Scheme.{u}) ℓ q) := by
    intro m ham
    induction m, ham using Nat.le_induction with
    | base =>
      intro E hE q hq
      have hEt : E = ⊤ := by
        apply TopologicalSpace.Opens.ext
        rw [hE, TopologicalSpace.Opens.coe_top]
        ext x
        simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
        intro i hi
        exact absurd i.isLt (by omega)
      subst hEt
      haveI := wc_et_affine_space_coh_vanishing K ℓ hℓp hK a q (by omega)
      obtain ⟨eq⟩ := wc_et_coh_iso_invariance (Scheme.topIso (Spec (.of (MvPolynomial (Fin a) K)))).hom ℓ q
      exact eq.symm.injective.subsingleton
    | succ m ham ih =>
      intro E' hE' q hq
      have hopen : IsOpen {x : Spec (.of (MvPolynomial (Fin m) K)) |
          ∀ i : Fin m, a ≤ i.val → (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal} := by
        have e : {x : Spec (.of (MvPolynomial (Fin m) K)) |
            ∀ i : Fin m, a ≤ i.val → (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal} =
            (⋂ i ∈ {i : Fin m | a ≤ i.val}, {x : Spec (.of (MvPolynomial (Fin m) K)) |
              (MvPolynomial.X i : MvPolynomial (Fin m) K) ∉ x.asIdeal}) := by
          ext x; simp
        rw [e]
        exact (Set.toFinite _).isOpen_biInter fun i _ =>
          PrimeSpectrum.isOpen_basicOpen (a := (MvPolynomial.X i : MvPolynomial (Fin m) K))
      let Em : (Spec (.of (MvPolynomial (Fin m) K))).Opens := ⟨_, hopen⟩
      have hc : ∀ (x : Spec (.of (MvPolynomial (Fin (m + 1)) K))) (j : Fin m),
          (MvPolynomial.X j : MvPolynomial (Fin m) K) ∈
            (Spec.map (CommRingCat.ofHom (MvPolynomial.rename (Fin.castSucc : Fin m → Fin (m + 1)) :
              MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin (m + 1)) K).toRingHom) x).asIdeal ↔
          (MvPolynomial.X j.castSucc : MvPolynomial (Fin (m + 1)) K) ∈ x.asIdeal := by
        intro x j
        rw [star]
        simp [MvPolynomial.rename_X]
      refine hpeel m Em E' ?_ (m - a + 1) (fun q hq => ih Em rfl q hq) q (by omega)
      intro x
      have hx' := Set.ext_iff.mp hE' x
      simp only [SetLike.mem_coe, Set.mem_setOf_eq] at hx'
      rw [hx']
      constructor
      · intro h1
        refine ⟨h1 (Fin.last m) (by simp; omega), fun j hj => ?_⟩
        rw [hc]
        exact h1 _ (by simpa using hj)
      · rintro ⟨hl, h1⟩ i hi
        rcases Fin.eq_castSucc_or_eq_last i with ⟨j', rfl⟩ | rfl
        · rw [← hc]
          exact h1 j' (by simpa using hi)
        · exact hl

  have K1 : ∀ (i : Fin d) (p : (wcAffPunct K d).left),
      p ∈ (wcAffPunct K d).left.basicOpen (wcAffCoord K d i) ↔
        (MvPolynomial.X i : MvPolynomial (Fin d) K) ∉ ((wcAffPunctOpen K d).ι p).asIdeal := by
    intro i p
    show p ∈ (wcAffPunctOpen K d : Scheme.{u}).basicOpen ((wcAffPunctOpen K d).ι.appTop.hom
      ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin d) K))).inv.hom (MvPolynomial.X i))) ↔ _
    rw [← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine]
    exact Iff.rfl
  have hrange : Set.range ((wcKOpen (wcAffPunct K d).left (wcAffCoord K d) a b).ι ≫
      (wcAffPunctOpen K d).ι) =
      {x : Spec (.of (MvPolynomial (Fin d) K)) |
        (∀ i : Fin d, a ≤ i.val → (MvPolynomial.X i : MvPolynomial (Fin d) K) ∉ x.asIdeal) ∧
          ∃ i : Fin d, i.val < b ∧ (MvPolynomial.X i : MvPolynomial (Fin d) K) ∉ x.asIdeal} := by
    ext y
    constructor
    · rintro ⟨p', rfl⟩
      have hp : (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) a b).ι p' ∈
          ((wcKOpen (wcAffPunct K d).left (wcAffCoord K d) a b : (wcAffPunct K d).left.Opens) :
            Set (wcAffPunct K d).left) := by
        rw [← Scheme.Opens.range_ι]; exact ⟨p', rfl⟩
      obtain ⟨h1, i, hi, h2⟩ := hp
      refine ⟨fun j hj => ?_, i, hi, ?_⟩
      · exact (K1 j _).mp (h1 j hj)
      · exact (K1 i _).mp h2
    · rintro ⟨h1, i, hi, h2⟩
      have hyU : y ∈ Set.range (wcAffPunctOpen K d).ι := by
        rw [Scheme.Opens.range_ι]
