    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  haveI : IsIso γ := hγ
  let B : Abelian.Ext (L.obj (Df.Φ.obj (wcEtSuppObj D))) (SheafOfModules.unit (wcEtZModRing Y n)) q →
      Abelian.Ext (Df.Φ.obj (wcEtSuppObj D)) (Df.Φ.obj (SheafOfModules.unit (wcEtZModRing Y n))) q :=
    fun x => (Abelian.Ext.mk₀ (adj.unit.app (Df.Φ.obj (wcEtSuppObj D)))).comp
      (Abelian.Ext.mapExactFunctor Df.Φ x) (zero_add q)
  have hB : Function.Bijective B := by
    have e : B = adj.extEquiv := by
      funext x
      rw [Adjunction.extEquiv_apply]
    rw [e]
    exact adj.extEquiv.bijective
  refine ⟨fun x => (Abelian.Ext.mk₀ γ).comp ((B x).comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q))
    (zero_add q), ?_, ?_⟩
  · intro x hx
    have hy : (B x).comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q) = 0 := by
      have h1 := congrArg (fun z => (Abelian.Ext.mk₀ (inv γ)).comp z (zero_add q)) hx
      simp only at h1
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp,
        Abelian.Ext.comp_zero] at h1
      exact h1
    have hBx : B x = 0 := by
      have h1 := congrArg (fun z => z.comp (Abelian.Ext.mk₀ Df.μ.inv) (add_zero q)) hy
      try simp only at h1
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id, Abelian.Ext.zero_comp] at h1
      exact h1
    apply hB.1
    rw [hBx]
    show 0 = (Abelian.Ext.mk₀ (adj.unit.app (Df.Φ.obj (wcEtSuppObj D)))).comp
      (Abelian.Ext.mapExactFunctor Df.Φ 0) (zero_add q)
    rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
  · intro θ
    have hc : B ((Abelian.Ext.mk₀ (adj.counit.app (wcEtSuppObj D))).comp θ (zero_add q)) =
        Abelian.Ext.mapExactFunctor Df.Φ θ := by
      show (Abelian.Ext.mk₀ (adj.unit.app (Df.Φ.obj (wcEtSuppObj D)))).comp
        (Abelian.Ext.mapExactFunctor Df.Φ
          ((Abelian.Ext.mk₀ (adj.counit.app (wcEtSuppObj D))).comp θ (zero_add q))) (zero_add q) = _
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀_assoc, adj.right_triangle_components]
      exact Abelian.Ext.mk₀_id_comp _
    show (Abelian.Ext.mk₀ γ).comp
      ((B ((Abelian.Ext.mk₀ (adj.counit.app (wcEtSuppObj D))).comp θ (zero_add q))).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q) = _
    rw [hc]
    rfl

theorem wc_abelian_extzero_mv_ses : ∀ {C : Type*} [Category C] [Abelian C] {CA CB CW : Type*} [Category CA] [Category CB] [Category CW] (LA : CA ⥤ C) (GA : C ⥤ CA) (LB : CB ⥤ C) (GB : C ⥤ CB) (LW : CW ⥤ C) (GW : C ⥤ CW) (adjA : LA ⊣ GA) (adjB : LB ⊣ GB) (adjW : LW ⊣ GW) (PA PB PW : C → Prop), (∀ K, Mono (adjA.counit.app K)) → (∀ K, Mono (adjB.counit.app K)) → (∀ K, Mono (adjW.counit.app K)) → (∀ X, PA (LA.obj X)) → (∀ X, PB (LB.obj X)) → (∀ X, PW (LW.obj X)) → (∀ K, PA K → Epi (adjA.counit.app K)) → (∀ K, PB K → Epi (adjB.counit.app K)) → (∀ K, PW K → Epi (adjW.counit.app K)) → (∀ (K G : C) (m : G ⟶ K), Mono m → PA K → PA G) → (∀ (K G : C) (m : G ⟶ K), Mono m → PB K → PB G) → (∀ K, PW K → PA K) → (∀ K, PW K → PB K) → (∀ K, PA K → PB K → PW K) → ∀ N : C, Epi (Limits.biprod.desc (adjA.counit.app N) (adjB.counit.app N)) → ∃ (f : LW.obj (GW.obj N) ⟶ LA.obj (GA.obj N) ⊞ LB.obj (GB.obj N)) (w : f ≫ Limits.biprod.desc (adjA.counit.app N) (adjB.counit.app N) = 0), (ShortComplex.mk f _ w).ShortExact :=
by
  intro C _ _ CA CB CW _ _ _ LA GA LB GB LW GW adjA adjB adjW PA PB PW monoA monoB monoW
    hLA hLB hLW epiA epiB epiW subA subB hWA hWB hABW N hg
  haveI : Mono (adjA.counit.app N) := monoA N
  haveI : Mono (adjB.counit.app N) := monoB N
  haveI : Mono (adjW.counit.app N) := monoW N
  have facA : ∀ K : C, PA K → ∀ h : K ⟶ N,
      ∃ h' : K ⟶ LA.obj (GA.obj N), h' ≫ adjA.counit.app N = h := by
    intro K hK h
    haveI := monoA K
    haveI := epiA K hK
    haveI : IsIso (adjA.counit.app K) := isIso_of_mono_of_epi _
    refine ⟨inv (adjA.counit.app K) ≫ LA.map (GA.map h), ?_⟩
    have hn : LA.map (GA.map h) ≫ adjA.counit.app N = adjA.counit.app K ≫ h :=
      adjA.counit.naturality h
    rw [Category.assoc, hn, IsIso.inv_hom_id_assoc]
  have facB : ∀ K : C, PB K → ∀ h : K ⟶ N,
      ∃ h' : K ⟶ LB.obj (GB.obj N), h' ≫ adjB.counit.app N = h := by
    intro K hK h
    haveI := monoB K
    haveI := epiB K hK
    haveI : IsIso (adjB.counit.app K) := isIso_of_mono_of_epi _
    refine ⟨inv (adjB.counit.app K) ≫ LB.map (GB.map h), ?_⟩
    have hn : LB.map (GB.map h) ≫ adjB.counit.app N = adjB.counit.app K ≫ h :=
      adjB.counit.naturality h
    rw [Category.assoc, hn, IsIso.inv_hom_id_assoc]
  have facW : ∀ K : C, PW K → ∀ h : K ⟶ N,
      ∃ h' : K ⟶ LW.obj (GW.obj N), h' ≫ adjW.counit.app N = h := by
    intro K hK h
    haveI := monoW K
    haveI := epiW K hK
    haveI : IsIso (adjW.counit.app K) := isIso_of_mono_of_epi _
    refine ⟨inv (adjW.counit.app K) ≫ LW.map (GW.map h), ?_⟩
    have hn : LW.map (GW.map h) ≫ adjW.counit.app N = adjW.counit.app K ≫ h :=
      adjW.counit.naturality h
    rw [Category.assoc, hn, IsIso.inv_hom_id_assoc]
  obtain ⟨u, hu⟩ := facA _ (hWA _ (hLW _)) (adjW.counit.app N)
  obtain ⟨v, hv⟩ := facB _ (hWB _ (hLW _)) (adjW.counit.app N)
  have w : Limits.biprod.lift u (-v) ≫
      Limits.biprod.desc (adjA.counit.app N) (adjB.counit.app N) = 0 := by
    rw [Limits.biprod.lift_desc, hu, Preadditive.neg_comp, hv, add_neg_cancel]
  haveI : Mono u := mono_of_mono_fac hu
  haveI hf_mono : Mono (Limits.biprod.lift u (-v)) :=
    mono_of_mono_fac (Limits.biprod.lift_fst u (-v))
  have hPbA : PA (Limits.pullback (adjA.counit.app N) (adjB.counit.app N)) :=
    subA _ _ (Limits.pullback.fst _ _) inferInstance (hLA _)
  have hPbB : PB (Limits.pullback (adjA.counit.app N) (adjB.counit.app N)) :=
    subB _ _ (Limits.pullback.snd _ _) inferInstance (hLB _)
  obtain ⟨j, hj⟩ := facW _ (hABW _ hPbA hPbB)
    (Limits.pullback.fst (adjA.counit.app N) (adjB.counit.app N) ≫ adjA.counit.app N)
  refine ⟨Limits.biprod.lift u (-v), w, ?_⟩
  have hker : Limits.IsLimit (Limits.KernelFork.ofι (Limits.biprod.lift u (-v)) w) := by
    refine Limits.KernelFork.IsLimit.ofι' _ _ (fun {T} k hk => ?_)
    have hk' : (k ≫ Limits.biprod.fst) ≫ adjA.counit.app N =
        (-(k ≫ Limits.biprod.snd)) ≫ adjB.counit.app N := by
      have e : k = Limits.biprod.lift (k ≫ Limits.biprod.fst) (k ≫ Limits.biprod.snd) := by
        apply Limits.biprod.hom_ext <;> simp
      rw [e, Limits.biprod.lift_desc] at hk
      rw [Preadditive.neg_comp]
      exact eq_neg_of_add_eq_zero_left hk
    refine ⟨Limits.pullback.lift _ _ hk' ≫ j, ?_⟩
    have hl : Limits.pullback.lift _ _ hk' ≫ j ≫ adjW.counit.app N =
        k ≫ Limits.biprod.fst ≫ adjA.counit.app N := by
      rw [hj, Limits.pullback.lift_fst_assoc, Category.assoc]
    apply Limits.biprod.hom_ext
    · simp only [Category.assoc, Limits.biprod.lift_fst]
      rw [← cancel_mono (adjA.counit.app N)]
      simp only [Category.assoc, hu, hl]
    · simp only [Category.assoc, Limits.biprod.lift_snd, Preadditive.comp_neg]
      rw [neg_eq_iff_eq_neg, ← cancel_mono (adjB.counit.app N)]
      simp only [Category.assoc, hv, hl, Preadditive.neg_comp]
      simpa only [Category.assoc, Preadditive.neg_comp] using hk'
  have hex : (ShortComplex.mk _ _ w).Exact := ShortComplex.exact_of_f_is_kernel _ hker
  exact ShortComplex.ShortExact.mk' hex hf_mono hg

theorem wc_et_supp_mv_two_injective : ∀ {X Z : Scheme.{u}} {ℓ : ℕ} (i : Z ⟶ X) [IsClosedImmersion i] (D : wcEtPullData i ℓ) (q : ℕ) (A B : X.Opens), A ⊔ B = ⊤ → (∀ (ZW : Scheme.{u}) (iW : ZW ⟶ ((A ⊓ B : X.Opens) : Scheme.{u})) (gW : ZW ⟶ Z), IsPullback gW iW i (A ⊓ B).ι → ∀ (DW : wcEtPullData iW ℓ) (q' : ℕ), q' + 1 = q → ∀ t : wcEtSuppExt DW q', t = 0) → ∀ θ : wcEtSuppExt D q, (∀ (ZU : Scheme.{u}) (iU : ZU ⟶ (A : Scheme.{u})) (gU : ZU ⟶ Z), IsPullback gU iU i A.ι → ∀ (DU : wcEtPullData iU ℓ) (EU : wcEtPullData A.ι ℓ) (γ : wcEtSuppObj DU ⟶ EU.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap DU ≫ γ = EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D EU DU γ q θ = 0) → (∀ (ZU : Scheme.{u}) (iU : ZU ⟶ (B : Scheme.{u})) (gU : ZU ⟶ Z), IsPullback gU iU i B.ι → ∀ (DU : wcEtPullData iU ℓ) (EU : wcEtPullData B.ι ℓ) (γ : wcEtSuppObj DU ⟶ EU.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap DU ≫ γ = EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D EU DU γ q θ = 0) → θ = 0 :=
by
  classical
  intro X Z ℓ i _ D q A B hAB hW θ hA hB
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _

  have hγ : ∀ (U : X.Opens) (EU : wcEtPullData U.ι ℓ), ∃ (ZU : Scheme.{u})
      (iU : ZU ⟶ (U : Scheme.{u})) (gU : ZU ⟶ Z) (_ : IsPullback gU iU i U.ι)
      (DU : wcEtPullData iU ℓ) (γ : wcEtSuppObj DU ⟶ EU.Φ.obj (wcEtSuppObj D)),
      wcEtSuppUnitMap DU ≫ γ = EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap D) ∧ IsIso γ := by
    intro U EU
    have hsq := IsPullback.of_hasPullback i U.ι
    haveI : IsClosedImmersion (Limits.pullback.snd i U.ι) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    obtain ⟨DU⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i U.ι) ℓ
    obtain ⟨γ, hγ, hepi⟩ := wc_et_closed_supp_base_change i U.ι _ _ hsq D EU DU
    refine ⟨_, _, _, hsq, DU, γ, hγ, ?_⟩
    haveI := EU.presColim
    haveI := EU.additive
    haveI : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D
    haveI : Epi (EU.Φ.map (wcEtSuppUnitMap D)) := inferInstance
    haveI : Epi (EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap D)) := epi_comp _ _
    haveI : Epi γ := epi_of_epi_fac hγ
    haveI : Mono γ := by
      apply Preadditive.mono_of_cancel_zero
      intro P h hh
      haveI := hepi
      have hsnd : Epi (Limits.pullback.snd (wcEtSuppUnitMap DU) h) := inferInstance
      have hfst : Limits.pullback.fst (wcEtSuppUnitMap DU) h ≫
          (EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap D)) = 0 := by
        rw [← hγ, ← Category.assoc, Limits.pullback.condition, Category.assoc, hh,
          Limits.comp_zero]
      have hk := wc_et_open_supp_kernel_reverse U i _ _ hsq D DU EU
      have e : Limits.pullback.fst (wcEtSuppUnitMap DU) h =
          Limits.kernel.lift _ _ hfst ≫ Limits.kernel.ι _ := (Limits.kernel.lift_ι _ _ hfst).symm
      have h2 : Limits.pullback.snd (wcEtSuppUnitMap DU) h ≫ h = 0 := by
        rw [← Limits.pullback.condition, e, Category.assoc, hk, Limits.comp_zero]
      exact (cancel_epi (Limits.pullback.snd (wcEtSuppUnitMap DU) h)).mp
        (h2.trans Limits.comp_zero.symm)
    exact isIso_of_mono_of_epi γ

  obtain ⟨EA⟩ := wc_et_zmod_pull_data_exists A.ι ℓ
  obtain ⟨EB⟩ := wc_et_zmod_pull_data_exists B.ι ℓ
  obtain ⟨EW⟩ := wc_et_zmod_pull_data_exists (A ⊓ B).ι ℓ
  obtain ⟨LA, adjA, pflA, monoA, suppA, epiA, surjA⟩ := wc_et_open_extzero_module_package A ℓ EA
  obtain ⟨LB, adjB, pflB, monoB, suppB, epiB, surjB⟩ := wc_et_open_extzero_module_package B ℓ EB
  obtain ⟨LW, adjW, pflW, monoW, suppW, epiW, surjW⟩ :=
    wc_et_open_extzero_module_package (A ⊓ B) ℓ EW

  obtain ⟨f, w, hS⟩ := wc_abelian_extzero_mv_ses LA EA.Φ LB EB.Φ LW EW.Φ adjA adjB adjW
    (fun K => wcSuppIn X (A : Set X) ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K))
    (fun K => wcSuppIn X (B : Set X) ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K))
    (fun K => wcSuppIn X ((A ⊓ B : X.Opens) : Set X)
      ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K))
    monoA monoB monoW suppA suppB suppW epiA epiB epiW
    (fun K G m hm hK => (wc_et_mod_suppIn_calculus X ℓ (A : Set X) (A : Set X) K G).2.1 m hm hK)
    (fun K G m hm hK => (wc_et_mod_suppIn_calculus X ℓ (B : Set X) (B : Set X) K G).2.1 m hm hK)
    (fun K hK => (wc_et_mod_suppIn_calculus X ℓ ((A ⊓ B : X.Opens) : Set X) (A : Set X) K K).1 hK
      (by rw [TopologicalSpace.Opens.coe_inf]; exact Set.inter_subset_left))
    (fun K hK => (wc_et_mod_suppIn_calculus X ℓ ((A ⊓ B : X.Opens) : Set X) (B : Set X) K K).1 hK
      (by rw [TopologicalSpace.Opens.coe_inf]; exact Set.inter_subset_right))
    (fun K hKA hKB => by
      have h3 := (wc_et_mod_suppIn_calculus X ℓ (A : Set X) (B : Set X) K K).2.2 hKA hKB
      show wcSuppIn X ((A ⊓ B : X.Opens) : Set X) _
      rw [TopologicalSpace.Opens.coe_inf]
      exact h3)
    (wcEtSuppObj D)
    (wc_et_mod_desc_epi_of_open_cover A B hAB _ _ _ _ _ (surjA (wcEtSuppObj D))
      (surjB (wcEtSuppObj D)))

  obtain ⟨ZA, iA, gA, hsqA, DA, γA, hγA, hisoA⟩ := hγ A EA
  obtain ⟨τA, hτA, hτA'⟩ := wc_et_supp_restr_extzero_transfer D EA DA γA hisoA LA adjA pflA q
  have h0A : (Abelian.Ext.mk₀ (adjA.counit.app (wcEtSuppObj D))).comp θ (zero_add q) = 0 := by
    apply hτA
    rw [hτA' θ]
    exact hA ZA iA gA hsqA DA EA γA hγA
  obtain ⟨ZB, iB, gB, hsqB, DB, γB, hγB, hisoB⟩ := hγ B EB
  obtain ⟨τB, hτB, hτB'⟩ := wc_et_supp_restr_extzero_transfer D EB DB γB hisoB LB adjB pflB q
  have h0B : (Abelian.Ext.mk₀ (adjB.counit.app (wcEtSuppObj D))).comp θ (zero_add q) = 0 := by
    apply hτB
    rw [hτB' θ]
    exact hB ZB iB gB hsqB DB EB γB hγB

  have hg : (Abelian.Ext.mk₀ (Limits.biprod.desc (adjA.counit.app (wcEtSuppObj D))
      (adjB.counit.app (wcEtSuppObj D)))).comp θ (zero_add q) = 0 := by
    apply Abelian.Ext.biprod_ext
    · rw [Abelian.Ext.comp_zero, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, Limits.biprod.inl_desc, h0A]
    · rw [Abelian.Ext.comp_zero, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, Limits.biprod.inr_desc, h0B]
  have hepig : Epi (Limits.biprod.desc (adjA.counit.app (wcEtSuppObj D))
      (adjB.counit.app (wcEtSuppObj D))) := hS.epi_g
  cases q with
  | zero =>

    obtain ⟨h₀, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 θ
    rw [Abelian.Ext.mk₀_comp_mk₀] at hg
    have h1 : Limits.biprod.desc (adjA.counit.app (wcEtSuppObj D))
        (adjB.counit.app (wcEtSuppObj D)) ≫ h₀ = 0 :=
      (Abelian.Ext.mk₀_bijective _ _).1 (by rw [Abelian.Ext.mk₀_zero]; exact hg)
    have h2 : h₀ = 0 := (cancel_epi _).mp (h1.trans Limits.comp_zero.symm)
    rw [h2, Abelian.Ext.mk₀_zero]
  | succ q' =>

    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS
      (SheafOfModules.unit (wcEtZModRing X ℓ)) θ hg (n₀ := q') (by omega)
    obtain ⟨ZW, iW, gW, hsqW, DW, γW, hγW, hisoW⟩ := hγ (A ⊓ B) EW
    obtain ⟨τW, hτW, -⟩ := wc_et_supp_restr_extzero_transfer D EW DW γW hisoW LW adjW pflW q'
    have hx : x₁ = 0 := hτW x₁ (hW ZW iW gW hsqW DW q' rfl (τW x₁))
    rw [← hx₁, hx, Abelian.Ext.comp_zero]

theorem wc_et_supp_opens_cover_injective : ∀ {X Z : Scheme.{u}} {ℓ : ℕ} (i : Z ⟶ X) [IsClosedImmersion i] (D : wcEtPullData i ℓ) (q : ℕ), (∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z), IsPullback gV iV i j → ∀ (DV : wcEtPullData iV ℓ) (q' : ℕ), q' + 1 = q → ∀ t : wcEtSuppExt DV q', t = 0) → ∀ (N : ℕ) (U : Fin N → X.Opens), (∀ x : X, ∃ k, x ∈ U k) → ∀ θ : wcEtSuppExt D q, (∀ (k : Fin N) (ZU : Scheme.{u}) (iU : ZU ⟶ (U k : Scheme.{u})) (gU : ZU ⟶ Z), IsPullback gU iU i (U k).ι → ∀ (DU : wcEtPullData iU ℓ) (EU : wcEtPullData (U k).ι ℓ) (γ : wcEtSuppObj DU ⟶ EU.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap DU ≫ γ = EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D EU DU γ q θ = 0) → θ = 0 :=
by
  classical
  intro X₀ Z₀ ℓ i₀ _ D₀ q hdeg₀ N₀ U₀ hU₀ θ₀ hvan₀

  have hlift : ∀ {P Q ZW₀ Z₁ W₀ X₁ : Scheme.{u}} {gW₀ : ZW₀ ⟶ Z₁} {iW₀ : ZW₀ ⟶ W₀}
      {i₁ : Z₁ ⟶ X₁} {ι₀ : W₀ ⟶ X₁}, IsPullback gW₀ iW₀ i₁ ι₀ → ∀ {a : P ⟶ Z₁} {b : P ⟶ Q}
      {k : Q ⟶ X₁}, IsPullback a b i₁ k → ∀ (φ : Q ⟶ W₀), φ ≫ ι₀ = k →
      ∃ a' : P ⟶ ZW₀, IsPullback a' b iW₀ φ := by
    intro P Q ZW₀ Z₁ W₀ X₁ gW₀ iW₀ i₁ ι₀ hR a b k hO φ hφ
    refine ⟨hR.lift a (b ≫ φ) (by rw [hO.w, Category.assoc, hφ]), ?_⟩
    refine IsPullback.of_right ?_ (hR.lift_snd _ _ _) hR
    rw [hR.lift_fst, hφ]
    exact hO

  have s2 : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (D : wcEtPullData i ℓ)
      (θ : wcEtSuppExt D q) (O : X.Opens), (∀ (ZO : Scheme.{u}) (iO : ZO ⟶ (O : Scheme.{u}))
      (gO : ZO ⟶ Z), IsPullback gO iO i O.ι → ∀ (DO : wcEtPullData iO ℓ)
      (EO : wcEtPullData O.ι ℓ) (γ : wcEtSuppObj DO ⟶ EO.Φ.obj (wcEtSuppObj D)),
      wcEtSuppUnitMap DO ≫ γ = EO.μ.inv ≫ EO.Φ.map (wcEtSuppUnitMap D) →
      wcEtSuppRestr D EO DO γ q θ = 0) → ∀ {Y' Z' : Scheme.{u}} (f : Y' ⟶ X),
      Set.range f ⊆ (O : Set X) → ∀ (i' : Z' ⟶ Y') (g' : Z' ⟶ Z), IsPullback g' i' i f →
      ∀ (D' : wcEtPullData i' ℓ) (Ef : wcEtPullData f ℓ)
      (γ' : wcEtSuppObj D' ⟶ Ef.Φ.obj (wcEtSuppObj D)),
      wcEtSuppUnitMap D' ≫ γ' = Ef.μ.inv ≫ Ef.Φ.map (wcEtSuppUnitMap D) →
      wcEtSuppRestr D Ef D' γ' q θ = 0 := by
    intro X Z i _ D θ O hO Y' Z' f hf i' g' hsq D' Ef γ' hγ'
    have hrange : Set.range f ⊆ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      exact hf
    obtain ⟨e, he⟩ : ∃ e : Y' ⟶ (O : Scheme.{u}), e ≫ O.ι = f :=
      ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
    have hV := IsPullback.of_hasPullback i O.ι
    haveI : IsClosedImmersion (Limits.pullback.snd i O.ι) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hV inferInstance
    obtain ⟨g₂, h₂⟩ := hlift hV hsq e he
    obtain ⟨DO⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i O.ι) ℓ
    obtain ⟨EO⟩ := wc_et_zmod_pull_data_exists O.ι ℓ
    obtain ⟨Ee⟩ := wc_et_zmod_pull_data_exists e ℓ
    obtain ⟨γO, hγO, -⟩ := wc_et_closed_supp_base_change i O.ι _ _ hV D EO DO
    obtain ⟨γe, hγe, hepi⟩ := wc_et_closed_supp_base_change _ e i' g₂ h₂ DO Ee D'
    rw [wc_et_supp_restr_comp O.ι e f he D DO D' EO Ee Ef γO γe γ' hγO hγe hγ' hepi q θ,
      hO _ _ _ hV DO EO γO hγO, map_zero]

  have main : ∀ (N : ℕ) {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
      (D : wcEtPullData i ℓ), (∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j]
      (iV : ZV ⟶ V) (gV : ZV ⟶ Z), IsPullback gV iV i j → ∀ (DV : wcEtPullData iV ℓ) (q' : ℕ),
      q' + 1 = q → ∀ t : wcEtSuppExt DV q', t = 0) → ∀ (U : Fin N → X.Opens),
      (∀ x : X, ∃ k, x ∈ U k) → ∀ θ : wcEtSuppExt D q, (∀ (k : Fin N) (ZU : Scheme.{u})
      (iU : ZU ⟶ (U k : Scheme.{u})) (gU : ZU ⟶ Z), IsPullback gU iU i (U k).ι →
      ∀ (DU : wcEtPullData iU ℓ) (EU : wcEtPullData (U k).ι ℓ)
      (γ : wcEtSuppObj DU ⟶ EU.Φ.obj (wcEtSuppObj D)),
      wcEtSuppUnitMap DU ≫ γ = EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap D) →
      wcEtSuppRestr D EU DU γ q θ = 0) → θ = 0 := by
    intro N
    induction N with
    | zero =>

      intro X Z i _ D _ U hU θ _
      haveI : IsEmpty Z := ⟨fun z => by
        obtain ⟨k, _⟩ := hU (i z)
        exact k.elim0⟩
      haveI := wc_et_supp_ext_empty i ℓ D inferInstance q
      exact Subsingleton.elim _ _
    | succ N ih =>
      intro X Z i _ D hdeg U hU θ hvan
      obtain ⟨V', hV'⟩ : ∃ V' : X.Opens, V' = ⨆ k : Fin N, U k.castSucc := ⟨_, rfl⟩
      have hmem : ∀ x : X, x ∈ V' ↔ ∃ k : Fin N, x ∈ U k.castSucc := by
        intro x
        rw [hV']
        exact TopologicalSpace.Opens.mem_iSup

      have hvanV' : ∀ (ZV : Scheme.{u}) (iV : ZV ⟶ (V' : Scheme.{u})) (gV : ZV ⟶ Z),
          IsPullback gV iV i V'.ι → ∀ (DV : wcEtPullData iV ℓ) (EV : wcEtPullData V'.ι ℓ)
          (γV : wcEtSuppObj DV ⟶ EV.Φ.obj (wcEtSuppObj D)),
          wcEtSuppUnitMap DV ≫ γV = EV.μ.inv ≫ EV.Φ.map (wcEtSuppUnitMap D) →
          wcEtSuppRestr D EV DV γV q θ = 0 := by
        intro ZV iV gV hV DV EV γV hγV
        haveI : IsClosedImmersion iV :=
          MorphismProperty.of_isPullback (P := @IsClosedImmersion) hV inferInstance
        refine ih iV DV ?_ (fun k => V'.ι ⁻¹ᵁ U k.castSucc) ?_ _ ?_
        · intro W ZW j _ iW gW hW DW q' hq' t
          exact hdeg (j ≫ V'.ι) iW (gW ≫ gV) (hW.paste_horiz hV) DW q' hq' t
        · intro y
          have hy : V'.ι y ∈ V' := by
            have h0 : V'.ι y ∈ Set.range V'.ι := ⟨y, rfl⟩
            rwa [Scheme.Opens.range_ι] at h0
          obtain ⟨k, hk⟩ := (hmem _).mp hy
          refine ⟨k, ?_⟩
          rw [Scheme.Hom.mem_preimage]
          exact hk
        · intro k Zk ik gk hk Dk Ek γk hγk
          have hk12 := hk.paste_horiz hV
          obtain ⟨E12⟩ := wc_et_zmod_pull_data_exists ((V'.ι ⁻¹ᵁ U k.castSucc).ι ≫ V'.ι) ℓ
          obtain ⟨γ12, hγ12, hepi⟩ :=
            wc_et_closed_supp_base_change i _ ik (gk ≫ gV) hk12 D E12 Dk
          rw [← wc_et_supp_restr_comp V'.ι (V'.ι ⁻¹ᵁ U k.castSucc).ι _ rfl D DV Dk EV Ek E12
            γV γk γ12 hγV hγk hγ12 hepi q θ]
          refine s2 i D θ (U k.castSucc) (hvan k.castSucc) _ ?_ ik (gk ≫ gV) hk12 Dk E12 γ12
            hγ12
          rintro _ ⟨y, rfl⟩
          have hy : (V'.ι ⁻¹ᵁ U k.castSucc).ι y ∈ V'.ι ⁻¹ᵁ U k.castSucc := by
            have h0 : (V'.ι ⁻¹ᵁ U k.castSucc).ι y ∈ Set.range (V'.ι ⁻¹ᵁ U k.castSucc).ι :=
              ⟨y, rfl⟩
            rwa [Scheme.Opens.range_ι] at h0
          rw [Scheme.Hom.mem_preimage] at hy
          rw [Scheme.Hom.comp_apply]
          exact hy

      have htop : V' ⊔ U (Fin.last N) = ⊤ := by
        rw [eq_top_iff]
        intro x _
        obtain ⟨k, hk⟩ := hU x
        rcases Fin.eq_castSucc_or_eq_last k with ⟨j, rfl⟩ | rfl
        · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inl ((hmem x).mpr ⟨j, hk⟩))
        · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inr hk)
      exact wc_et_supp_mv_two_injective i D q V' (U (Fin.last N)) htop
        (fun ZW iW gW hW DW q' hq' t => hdeg (V' ⊓ U (Fin.last N)).ι iW gW hW DW q' hq' t)
        θ hvanV' (hvan (Fin.last N))
  exact main N₀ i₀ D₀ hdeg₀ U₀ hU₀ θ₀ hvan₀

theorem wc_et_supp_finite_cover_injective : ∀ {X Z : Scheme.{u}} {ℓ : ℕ} (i : Z ⟶ X) [IsClosedImmersion i] (D : wcEtPullData i ℓ) (q : ℕ), (∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z), IsPullback gV iV i j → ∀ (DV : wcEtPullData iV ℓ) (q' : ℕ), q' + 1 = q → ∀ t : wcEtSuppExt DV q', t = 0) → ∀ (N : ℕ) (U : Fin N → Scheme.{u}) (j : ∀ k, U k ⟶ X) [∀ k, IsOpenImmersion (j k)], (∀ x : X, ∃ k, x ∈ Set.range (j k)) → ∀ θ : wcEtSuppExt D q, (∀ (k : Fin N) {Zk : Scheme.{u}} (ik : Zk ⟶ U k) (gk : Zk ⟶ Z), IsPullback gk ik i (j k) → ∀ (Dk : wcEtPullData ik ℓ) (Ek : wcEtPullData (j k) ℓ) (γ : wcEtSuppObj Dk ⟶ Ek.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap Dk ≫ γ = Ek.μ.inv ≫ Ek.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ek Dk γ q θ = 0) → θ = 0 :=
by
  intro X Z ℓ i _ D q hvan N U j _ hcov θ hθ
  have hcovO : ∀ x : X, ∃ k, x ∈ (j k).opensRange := by
    intro x
    obtain ⟨k, hk⟩ := hcov x
    refine ⟨k, ?_⟩
    rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
    exact hk
  have hr : ∀ k, Set.range ⇑((j k).opensRange).ι ⊆ Set.range ⇑(j k) := by
    intro k
    rw [Scheme.Opens.range_ι, Scheme.Hom.coe_opensRange]
  refine wc_et_supp_opens_cover_injective i D q hvan N (fun k => (j k).opensRange) hcovO θ ?_
  intro k ZU iU gU hO DU EU γU admU
  have he : IsOpenImmersion.lift (j k) ((j k).opensRange).ι (hr k) ≫ j k =
      ((j k).opensRange).ι := IsOpenImmersion.lift_fac _ _ _
  have hV : IsPullback (Limits.pullback.fst i (j k)) (Limits.pullback.snd i (j k)) i (j k) :=
    IsPullback.of_hasPullback i (j k)
  haveI : IsClosedImmersion (Limits.pullback.snd i (j k)) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hV inferInstance
  have w : gU ≫ i = (iU ≫ IsOpenImmersion.lift (j k) ((j k).opensRange).ι (hr k)) ≫ j k := by
    rw [hO.w, Category.assoc, he]
  have hout : IsPullback (hV.lift gU (iU ≫ IsOpenImmersion.lift (j k) ((j k).opensRange).ι (hr k)) w ≫
      Limits.pullback.fst i (j k)) iU i
      (IsOpenImmersion.lift (j k) ((j k).opensRange).ι (hr k) ≫ j k) := by
    rw [hV.lift_fst, he]
    exact hO
  have h₂ : IsPullback (hV.lift gU (iU ≫ IsOpenImmersion.lift (j k) ((j k).opensRange).ι (hr k)) w)
      iU (Limits.pullback.snd i (j k)) (IsOpenImmersion.lift (j k) ((j k).opensRange).ι (hr k)) :=
    IsPullback.of_right hout (hV.lift_snd _ _ _) hV
  obtain ⟨DV⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i (j k)) ℓ
  obtain ⟨Ej⟩ := wc_et_zmod_pull_data_exists (j k) ℓ
  obtain ⟨Ee⟩ := wc_et_zmod_pull_data_exists
    (IsOpenImmersion.lift (j k) ((j k).opensRange).ι (hr k)) ℓ
  obtain ⟨γj, admj, _⟩ := wc_et_closed_supp_base_change i (j k) (Limits.pullback.snd i (j k))
    (Limits.pullback.fst i (j k)) hV D Ej DV
  obtain ⟨γe, adme, epiU⟩ := wc_et_closed_supp_base_change (Limits.pullback.snd i (j k))
    (IsOpenImmersion.lift (j k) ((j k).opensRange).ι (hr k)) iU _ h₂ DV Ee DU
  rw [wc_et_supp_restr_comp (j k) (IsOpenImmersion.lift (j k) ((j k).opensRange).ι (hr k))
      ((j k).opensRange).ι he D DV DU Ej Ee EU γj γe γU admj adme admU epiU q θ,
    hθ k (Limits.pullback.snd i (j k)) (Limits.pullback.fst i (j k)) hV DV Ej γj admj, map_zero]

theorem wc_et_thom_class_unique : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (T : wcEtLocThom K ℓ) (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] [CompactSpace ↥X] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i ℓ) (θ₁ θ₂ : wcEtSuppExt D (2 * c)), wcEtIsThom T fX D c θ₁ → wcEtIsThom T fX D c θ₂ → θ₁ = θ₂ :=
by
  classical
  intro K _ _ ℓ _ hℓ T X Z fX n c _ _ i _ _ hcn D θ₁ θ₂ h₁ h₂
  rw [← sub_eq_zero]

  have hO1 : ∀ {V : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j],
      SmoothOfRelativeDimension n (j ≫ fX) := by
    intro V j _
    have h0 : SmoothOfRelativeDimension (0 + n) (j ≫ fX) := inferInstance
    rwa [zero_add] at h0
  have hO2 : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → SmoothOfRelativeDimension (n - c) (iV ≫ j ≫ fX) := by
    intro V ZV j _ iV gV hsq
    haveI : IsOpenImmersion gV :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip inferInstance
    have h0 : SmoothOfRelativeDimension (0 + (n - c)) (gV ≫ i ≫ fX) := inferInstance
    rw [zero_add] at h0
    have e : iV ≫ j ≫ fX = gV ≫ i ≫ fX := by
      rw [← Category.assoc, ← hsq.w, Category.assoc]
    rw [e]
    exact h0

  have hvan : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → ∀ (DV : wcEtPullData iV ℓ) (q' : ℕ), q' + 1 = 2 * c →
        ∀ t : wcEtSuppExt DV q', t = 0 := by
    intro V ZV j _ iV gV hsq DV q' hq' t
    haveI := hO1 j
    haveI : IsClosedImmersion iV :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    haveI := hO2 j iV gV hsq
    exact wc_et_supp_semipurity K V ZV (j ≫ fX) n c iV hcn ℓ hℓ DV q' (by omega) t

  have hloc : ∀ x : X, ∃ W : X.Opens, IsAffineOpen W ∧ x ∈ W ∧
      ((∃ h : Fin c → Γ(↑W, ⊤), wcEtCutOut (i ∣_ W) h) ∨ ((W : Set X) ⊆ (Set.range i)ᶜ)) := by
    intro x
    by_cases hx : x ∈ Set.range i
    · obtain ⟨z, rfl⟩ := hx
      obtain ⟨W, hWa, hzW, h, hcut⟩ := wc_smooth_pair_local_cutout K X Z fX n c i hcn z
      exact ⟨W, hWa, hzW, Or.inl ⟨h, hcut⟩⟩
    · have hopen : IsOpen (Set.range i)ᶜ := i.isClosedEmbedding.isClosed_range.isOpen_compl
      obtain ⟨W, hWa, hxW, hWsub⟩ :=
        exists_isAffineOpen_mem_and_subset (U := ⟨(Set.range i)ᶜ, hopen⟩) (x := x) hx
      exact ⟨W, hWa, hxW, Or.inr (show (W : Set X) ⊆ (Set.range i)ᶜ from hWsub)⟩
  choose W hWa hxW hGood using hloc
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (W x : Set X))
    (fun x => (W x).isOpen.mem_nhds (hxW x))
  have hcov : ∀ x : X, ∃ k : Fin t.card, x ∈ Set.range (W (t.equivFin.symm k).1).ι := by
    intro x
    have hx : x ∈ ⋃ y ∈ t, (W y : Set X) := by
      rw [ht]
      exact Set.mem_univ x
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    refine ⟨t.equivFin ⟨y, hy⟩, ?_⟩
    rw [Scheme.Opens.range_ι, Equiv.symm_apply_apply]
    exact hxy
  refine wc_et_supp_finite_cover_injective i D (2 * c) hvan t.card
    (fun k => ((W (t.equivFin.symm k).1 : X.Opens) : Scheme.{u}))
    (fun k => (W (t.equivFin.symm k).1).ι) hcov (θ₁ - θ₂) ?_
  intro k Zk ik gk hsq Dk Ek γ hγ
  rw [map_sub, sub_eq_zero]
  rcases hGood (t.equivFin.symm k).1 with ⟨h, hcut⟩ | hsub
  ·
    have can := (isPullback_morphismRestrict i (W (t.equivFin.symm k).1)).flip
    obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ, κ ≫ (i ⁻¹ᵁ (W (t.equivFin.symm k).1)).ι = gk ∧
        κ ≫ (i ∣_ (W (t.equivFin.symm k).1)) = ik :=
      ⟨can.lift gk ik hsq.w, can.lift_fst _ _ _, can.lift_snd _ _ _⟩
    have sq : IsPullback κ ik (i ∣_ (W (t.equivFin.symm k).1)) (𝟙 _) := by
      refine IsPullback.of_right ?_ ?_ can
      · rw [hκ1, Category.id_comp]
        exact hsq
      · rw [hκ2, Category.comp_id]
    have hcut' := wc_et_cutout_base_change (i ∣_ (W (t.equivFin.symm k).1)) h (𝟙 _) ik κ hcut
      (hWa _) sq
    rw [h₁ _ Zk ik gk hsq Dk Ek γ hγ _ hcut', h₂ _ Zk ik gk hsq Dk Ek γ hγ _ hcut']
  ·
    haveI hE : IsEmpty Zk := by
      apply Scheme.isEmpty_of_commSq hsq.toCommSq
      rw [Scheme.Opens.range_ι]
      exact Set.subset_compl_iff_disjoint_left.mp hsub
    haveI := wc_et_supp_ext_empty ik ℓ Dk hE (2 * c)
    exact Subsingleton.elim _ _

theorem wc_smooth_pair_tuples_locally_GL : ∀ (K : Type u) [Field K] {W ZW : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (iW : ZW ⟶ W) (c : ℕ) (h h' : Fin c → Γ(W, ⊤)), wcEtGoodChart K fW iW c h → wcEtCutOut iW h' → ∀ z : ZW, ∃ (V : Scheme.{u}) (j : V ⟶ W), IsOpenImmersion j ∧ IsAffine V ∧ iW z ∈ Set.range j ∧ ∃ B : Matrix (Fin c) (Fin c) Γ(V, ⊤), IsUnit B.det ∧ (fun k => j.appTop.hom (h' k)) = B.mulVec (fun k => j.appTop.hom (h k)) :=
by
  classical
  intro K _ W ZW fW iW c h h' hgc hcut' z
  obtain ⟨n, hcn, _, _, hcut⟩ := hgc
  obtain ⟨hWaff, _, hker⟩ := hcut
  obtain ⟨_, _, hker'⟩ := hcut'
  haveI := hWaff

  have hfield : ∀ (F : Type u) [Field F] (P Q : Matrix (Fin c) (Fin c) F),
      ∃ μ : Matrix (Fin c) (Fin c) F, IsUnit (P + μ * (1 - Q * P)).det := by
    intro F _ P Q
    let p := Matrix.toLin' P
    obtain ⟨C, hC⟩ := Submodule.exists_isCompl (LinearMap.range p)
    have h1 := Submodule.finrank_add_eq_of_isCompl hC
    have h2 := LinearMap.finrank_range_add_finrank_ker p
    have hdim : Module.finrank F (LinearMap.ker p) = Module.finrank F C := by
      simp only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at h1 h2; omega
    let φ : LinearMap.ker p ≃ₗ[F] C := LinearEquiv.ofFinrankEq _ _ hdim
    obtain ⟨g, hg⟩ := LinearMap.exists_extend φ.toLinearMap
    let m : (Fin c → F) →ₗ[F] (Fin c → F) := C.subtype ∘ₗ g
    refine ⟨LinearMap.toMatrix' m, ?_⟩
    rw [← Matrix.isUnit_iff_isUnit_det, ← Matrix.mulVec_injective_iff_isUnit]
    have hkerB : ∀ u : Fin c → F,
        (P + LinearMap.toMatrix' m * (1 - Q * P)).mulVec u = 0 → u = 0 := by
      intro u hu
      rw [Matrix.add_mulVec, ← Matrix.mulVec_mulVec, LinearMap.toMatrix'_mulVec] at hu
      have hPu : P.mulVec u ∈ C := by
        have e : P.mulVec u = -(m ((1 - Q * P).mulVec u)) := eq_neg_of_add_eq_zero_left hu
        rw [e]
        exact C.neg_mem (g _).2
      have hPu0 : P.mulVec u = 0 :=
        (Submodule.disjoint_def.mp hC.disjoint) _ ⟨u, Matrix.toLin'_apply P u⟩ hPu
      have hN : (1 - Q * P).mulVec u = u := by
        rw [Matrix.sub_mulVec, Matrix.one_mulVec, ← Matrix.mulVec_mulVec, hPu0,
          Matrix.mulVec_zero, sub_zero]
      rw [hPu0, hN, zero_add] at hu
      have hk : u ∈ LinearMap.ker p := by
        rw [LinearMap.mem_ker, Matrix.toLin'_apply]; exact hPu0
      have hgu : g u = 0 := by
        have hc : ((g u : C) : Fin c → F) = 0 := hu
        exact Subtype.ext hc
      have hφ : φ ⟨u, hk⟩ = 0 := by
        have := LinearMap.congr_fun hg ⟨u, hk⟩
        rw [LinearMap.comp_apply, Submodule.subtype_apply] at this
        rw [← hgu]; exact this.symm
      have h0 : (⟨u, hk⟩ : LinearMap.ker p) = 0 := (LinearEquiv.map_eq_zero_iff φ).mp hφ
      exact congrArg Subtype.val h0
    intro v w hvw
    have := hkerB (v - w) (by rw [Matrix.mulVec_sub, hvw, sub_self])
    exact sub_eq_zero.mp this

  have hcoef : ∀ (g g' : Fin c → Γ(W, ⊤)), Ideal.span (Set.range g') ≤ Ideal.span (Set.range g) →
      ∃ P : Matrix (Fin c) (Fin c) Γ(W, ⊤), g' = P.mulVec g := by
    intro g g' hle
    have hmem : ∀ k, ∃ a : Fin c → Γ(W, ⊤), ∑ i, a i • g i = g' k := by
      intro k
      have hk : g' k ∈ Ideal.span (Set.range g) := hle (Ideal.subset_span ⟨k, rfl⟩)
      exact (Submodule.mem_span_range_iff_exists_fun _).mp hk
    choose a ha using hmem
    refine ⟨Matrix.of a, ?_⟩
    funext k
    rw [← ha k]
    simp [Matrix.mulVec, dotProduct, smul_eq_mul]
  obtain ⟨P, hP⟩ := hcoef h h' (hker'.symm.trans hker).le
  obtain ⟨Q, hQ⟩ := hcoef h' h (hker.symm.trans hker').le

  have h𝔮top : Ideal.comap (W.presheaf.germ ⊤ (iW z) trivial).hom
      (IsLocalRing.maximalIdeal (W.presheaf.stalk (iW z))) ≠ ⊤ :=
    Ideal.IsPrime.ne_top inferInstance
  obtain ⟨𝔪, h𝔪max, h𝔮𝔪⟩ := Ideal.exists_le_maximal _ h𝔮top
  letI : Field (Γ(W, ⊤) ⧸ 𝔪) := Ideal.Quotient.field 𝔪
  obtain ⟨μb, hμb⟩ := hfield (Γ(W, ⊤) ⧸ 𝔪) ((Ideal.Quotient.mk 𝔪).mapMatrix P)
    ((Ideal.Quotient.mk 𝔪).mapMatrix Q)
  have hs : ∀ i j, ∃ a, (Ideal.Quotient.mk 𝔪) a = μb i j :=
    fun i j => Ideal.Quotient.mk_surjective _
  choose μ₀ hμ₀ using hs
  have hmap : (Ideal.Quotient.mk 𝔪).mapMatrix (Matrix.of μ₀) = μb := by
    ext i j
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
    exact hμ₀ i j
  obtain ⟨B', hB'⟩ : ∃ B' : Matrix (Fin c) (Fin c) Γ(W, ⊤), B' = P + Matrix.of μ₀ * (1 - Q * P) :=
    ⟨_, rfl⟩
  have hπB : (Ideal.Quotient.mk 𝔪).mapMatrix B' = (Ideal.Quotient.mk 𝔪).mapMatrix P +
      μb * (1 - (Ideal.Quotient.mk 𝔪).mapMatrix Q * (Ideal.Quotient.mk 𝔪).mapMatrix P) := by
    rw [hB', map_add, map_mul, map_sub, map_one, map_mul, hmap]
  have hdet𝔪 : B'.det ∉ 𝔪 := by
    intro hm
    have h0 : (Ideal.Quotient.mk 𝔪) B'.det = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hm
    rw [RingHom.map_det, hπB] at h0
    exact hμb.ne_zero h0
  have hrel : h' = B'.mulVec h := by
    rw [hB', Matrix.add_mulVec, ← Matrix.mulVec_mulVec, Matrix.sub_mulVec, Matrix.one_mulVec,
      ← Matrix.mulVec_mulVec, ← hP, ← hQ, sub_self, Matrix.mulVec_zero, add_zero]
  have hxmem : iW z ∈ W.basicOpen B'.det := by
    rw [Scheme.mem_basicOpen_top]
    by_contra hu
    apply hdet𝔪
    apply h𝔮𝔪
    rw [Ideal.mem_comap]
    exact (IsLocalRing.mem_maximalIdeal _).mpr hu

  have hunit : IsUnit ((W.basicOpen B'.det).ι.appTop.hom B'.det) := by
    have hb : ((W.basicOpen B'.det : W.Opens) : Scheme.{u}).basicOpen
        ((W.basicOpen B'.det).ι.appTop.hom B'.det) = ⊤ := by
      have e1 := Scheme.preimage_basicOpen (W.basicOpen B'.det).ι B'.det
      rw [Scheme.Opens.ι_preimage_self] at e1
      exact e1.symm
    apply RingedSpace.isUnit_of_isUnit_germ
    intro y
    have hy : y ∈ ((W.basicOpen B'.det : W.Opens) : Scheme.{u}).basicOpen
        ((W.basicOpen B'.det).ι.appTop.hom B'.det) := by
      rw [hb]; trivial
    rw [Scheme.mem_basicOpen_top] at hy
    exact fun _ => hy
  refine ⟨W.basicOpen B'.det, (W.basicOpen B'.det).ι, inferInstance,
    (isAffineOpen_top W).basicOpen B'.det, ?_, B'.map (W.basicOpen B'.det).ι.appTop.hom, ?_, ?_⟩
  · rw [Scheme.Opens.range_ι]; exact hxmem
  · have e := RingHom.map_det (W.basicOpen B'.det).ι.appTop.hom B'
    rw [RingHom.mapMatrix_apply] at e
    rw [← e]
    exact hunit
  · funext k
    rw [hrel]
    exact RingHom.map_mulVec _ _ _ _

theorem wc_et_thom_supp_local_injective : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] [CompactSpace ↥X] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i ℓ) (θ : wcEtSuppExt D (2 * c)), (∀ z : Z, ∃ (V : Scheme.{u}) (j : V ⟶ X), IsOpenImmersion j ∧ i z ∈ Set.range j ∧ ∀ (ZV : Scheme.{u}) (iV : ZV ⟶ V) (gV : ZV ⟶ Z), IsPullback gV iV i j → ∀ (DV : wcEtPullData iV ℓ) (Ej : wcEtPullData j ℓ) (γ : wcEtSuppObj DV ⟶ Ej.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap DV ≫ γ = Ej.μ.inv ≫ Ej.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D Ej DV γ (2 * c) θ = 0) → θ = 0 :=
by
  classical
  intro K _ _ ℓ _ hℓ X Z fX n c _ _ i _ _ hcn D θ hloc

  have hsm0 : ∀ {A B C : Scheme.{u}} (ψ : A ⟶ B) [IsOpenImmersion ψ] (φ : B ⟶ C) (k : ℕ)
      [SmoothOfRelativeDimension k φ], SmoothOfRelativeDimension k (ψ ≫ φ) := by
    intro A B C ψ _ φ k _
    have := smoothOfRelativeDimension_comp 0 k ψ φ
    rwa [Nat.zero_add] at this

  have hdeg : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → ∀ (DV : wcEtPullData iV ℓ) (q' : ℕ), q' + 1 = 2 * c →
      ∀ t : wcEtSuppExt DV q', t = 0 := by
    intro V ZV j _ iV gV hV DV q' hq' t
    haveI : IsClosedImmersion iV :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hV inferInstance
    haveI : IsOpenImmersion gV :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hV.flip inferInstance
    haveI : SmoothOfRelativeDimension n (j ≫ fX) := hsm0 j fX n
    haveI : SmoothOfRelativeDimension (n - c) (iV ≫ j ≫ fX) := by
      have e : gV ≫ i ≫ fX = iV ≫ j ≫ fX := by rw [reassoc_of% hV.w]
      rw [← e]
      exact hsm0 gV (i ≫ fX) (n - c)
    exact wc_et_supp_semipurity K V ZV (j ≫ fX) n c iV hcn ℓ hℓ DV q' (by omega) t

  have hlift : ∀ {P Q ZW₀ Z₀ W₀ X₀ : Scheme.{u}} {gW₀ : ZW₀ ⟶ Z₀} {iW₀ : ZW₀ ⟶ W₀}
      {i₀ : Z₀ ⟶ X₀} {ι₀ : W₀ ⟶ X₀}, IsPullback gW₀ iW₀ i₀ ι₀ → ∀ {a : P ⟶ Z₀} {b : P ⟶ Q}
      {k : Q ⟶ X₀}, IsPullback a b i₀ k → ∀ (φ : Q ⟶ W₀), φ ≫ ι₀ = k →
      ∃ a' : P ⟶ ZW₀, IsPullback a' b iW₀ φ := by
    intro P Q ZW₀ Z₀ W₀ X₀ gW₀ iW₀ i₀ ι₀ hR a b k hO φ hφ
    refine ⟨hR.lift a (b ≫ φ) (by rw [hO.w, Category.assoc, hφ]), ?_⟩
    refine IsPullback.of_right ?_ (hR.lift_snd _ _ _) hR
    rw [hR.lift_fst, hφ]
    exact hO

  have hvanO : ∀ x : X, ∃ O : X.Opens, x ∈ O ∧ ∀ (ZU : Scheme.{u}) (iU : ZU ⟶ (O : Scheme.{u}))
      (gU : ZU ⟶ Z), IsPullback gU iU i O.ι → ∀ (DU : wcEtPullData iU ℓ) (EU : wcEtPullData O.ι ℓ)
      (γ : wcEtSuppObj DU ⟶ EU.Φ.obj (wcEtSuppObj D)),
      wcEtSuppUnitMap DU ≫ γ = EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap D) →
      wcEtSuppRestr D EU DU γ (2 * c) θ = 0 := by
    intro x
    by_cases hx : x ∈ Set.range i
    · obtain ⟨z, rfl⟩ := hx
      obtain ⟨V, j, hj, hz, H⟩ := hloc z
      haveI := hj
      refine ⟨j.opensRange, ?_, ?_⟩
      · rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
        exact hz
      · intro ZU iU gU hO DU EU γ hγ
        have hrange : Set.range j.opensRange.ι ⊆ Set.range j := by
          intro y hy
          rwa [Scheme.Opens.range_ι, Scheme.Hom.coe_opensRange] at hy
        obtain ⟨e, he⟩ : ∃ e : (j.opensRange : Scheme.{u}) ⟶ V, e ≫ j = j.opensRange.ι :=
          ⟨_, IsOpenImmersion.lift_fac _ _ hrange⟩
        have hV := IsPullback.of_hasPullback i j
        haveI : IsClosedImmersion (Limits.pullback.snd i j) :=
          MorphismProperty.of_isPullback (P := @IsClosedImmersion) hV inferInstance
        obtain ⟨g₂, h₂⟩ := hlift hV hO e he
        obtain ⟨DV⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i j) ℓ
        obtain ⟨Ej⟩ := wc_et_zmod_pull_data_exists j ℓ
        obtain ⟨Ee⟩ := wc_et_zmod_pull_data_exists e ℓ
        obtain ⟨γj, hγj, -⟩ := wc_et_closed_supp_base_change i j _ _ hV D Ej DV
        obtain ⟨γe, hγe, hepi⟩ := wc_et_closed_supp_base_change _ e iU g₂ h₂ DV Ee DU
        rw [wc_et_supp_restr_comp j e j.opensRange.ι he D DV DU Ej Ee EU γj γe γ hγj hγe hγ hepi
          (2 * c) θ, H _ _ _ hV DV Ej γj hγj, map_zero]
    · refine ⟨⟨(Set.range i)ᶜ, isOpen_compl_iff.mpr i.isClosedEmbedding.isClosed_range⟩, hx, ?_⟩
      intro ZU iU gU hO DU EU γ hγ
      haveI : IsEmpty ZU := Scheme.isEmpty_of_commSq hO.toCommSq (by
        rw [Scheme.Opens.range_ι]
        exact disjoint_compl_right)
      haveI := wc_et_supp_ext_empty iU ℓ DU inferInstance (2 * c)
      exact Subsingleton.elim _ _

  choose O hxO hO using hvanO
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (O x : Set X))
    (fun x => (O x).isOpen.mem_nhds (hxO x))

  refine wc_et_supp_opens_cover_injective i D (2 * c) hdeg t.card
    (fun k => O (t.equivFin.symm k).1) ?_ θ ?_
  · intro y
    have hy : y ∈ ⋃ x ∈ t, (O x : Set X) := by
      rw [ht]
      trivial
    obtain ⟨x, hxt, hyx⟩ := Set.mem_iUnion₂.mp hy
    refine ⟨t.equivFin ⟨x, hxt⟩, ?_⟩
    show y ∈ O (t.equivFin.symm (t.equivFin ⟨x, hxt⟩)).1
    rw [Equiv.symm_apply_apply]
    exact hyx
  · intro k
    exact hO _

theorem wc_et_thom_chart_class : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (T : wcEtLocThom K ℓ), wcEtThomGL T → wcEtThomNat T → ∀ {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fW] (i : Z ⟶ W) [SmoothOfRelativeDimension (n - c) (i ≫ fW)], c ≤ n → ∀ (D : wcEtPullData i ℓ) (h : Fin c → Γ(W, ⊤)), wcEtCutOut i h → wcEtIsThom T fW D c (T fW i D c h) :=
by
  classical
  intro K _ _ ℓ _ hℓ T hGL hNat W Z fW n c _ i _ hcn D h hcut
  haveI : IsAffine W := hcut.1
  haveI : IsClosedImmersion i := hcut.2.1

  have hsm0 : ∀ {A B C : Scheme.{u}} (ψ : A ⟶ B) [IsOpenImmersion ψ] (φ : B ⟶ C) (k : ℕ)
      [SmoothOfRelativeDimension k φ], SmoothOfRelativeDimension k (ψ ≫ φ) := by
    intro A B C ψ _ φ k _
    have := smoothOfRelativeDimension_comp 0 k ψ φ
    rwa [Nat.zero_add] at this
  have gcW : wcEtGoodChart K fW i c h := ⟨n, hcn, ‹_›, ‹_›, hcut⟩

  intro W'' ZW'' iW'' gW'' hsq'' DW'' EW'' γ'' hadm'' h'' hcut''
  haveI hW''aff : IsAffine (W'' : Scheme.{u}) := hcut''.1
  haveI : IsClosedImmersion iW'' := hcut''.2.1
  haveI : IsOpenImmersion gW'' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq''.flip inferInstance
  haveI S1 : SmoothOfRelativeDimension n (W''.ι ≫ fW) := hsm0 W''.ι fW n
  haveI S2 : SmoothOfRelativeDimension (n - c) (iW'' ≫ W''.ι ≫ fW) := by
    have e : gW'' ≫ i ≫ fW = iW'' ≫ W''.ι ≫ fW := by rw [reassoc_of% hsq''.w]
    rw [← e]
    exact hsm0 gW'' (i ≫ fW) (n - c)
  have hsmV : ∀ {V ZV : Scheme.{u}} (ψ : V ⟶ (W'' : Scheme.{u})) [IsOpenImmersion ψ]
      (a : ZV ⟶ ZW'') (b : ZV ⟶ V), IsPullback a b iW'' ψ →
      SmoothOfRelativeDimension (n - c) (b ≫ ψ ≫ W''.ι ≫ fW) := by
    intro V ZV ψ _ a b hab
    haveI : IsOpenImmersion a :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hab.flip inferInstance
    have e : a ≫ iW'' ≫ W''.ι ≫ fW = b ≫ ψ ≫ W''.ι ≫ fW := by rw [reassoc_of% hab.w]
    rw [← e]
    exact hsm0 a (iW'' ≫ W''.ι ≫ fW) (n - c)
  have gcW'' : wcEtGoodChart K (W''.ι ≫ fW) iW'' c h'' := ⟨n, hcn, S1, S2, hcut''⟩

  have hcutA : wcEtCutOut iW'' (fun k => W''.ι.appTop.hom (h k)) :=
    wc_et_cutout_base_change i h W''.ι iW'' gW'' hcut hW''aff hsq''
  have gcA : wcEtGoodChart K (W''.ι ≫ fW) iW'' c (fun k => W''.ι.appTop.hom (h k)) :=
    ⟨n, hcn, S1, S2, hcutA⟩

  rw [← sub_eq_zero]
  refine wc_et_thom_supp_local_injective K ℓ hℓ _ _ (W''.ι ≫ fW) n c iW'' hcn DW'' _ ?_
  intro z''

  obtain ⟨V, jV, hjV, hVaff, hmemV, B, hB, hrel⟩ :=
    wc_smooth_pair_tuples_locally_GL K (W''.ι ≫ fW) iW'' c _ _ gcA hcut'' z''
  haveI := hjV
  haveI := hVaff
  refine ⟨V, jV, hjV, hmemV, ?_⟩

  intro ZV iV gV hV DV Ej γj hadmj
  rw [map_sub, sub_eq_zero]
  have Q := hV.paste_horiz hsq''
  obtain ⟨Ec⟩ := wc_et_zmod_pull_data_exists (jV ≫ W''.ι) ℓ
  obtain ⟨γc, hγc, hepi⟩ := wc_et_closed_supp_base_change i (jV ≫ W''.ι) iV (gV ≫ gW'') Q D Ec DV
  have hca : (fun k => (jV ≫ W''.ι).appTop.hom (h k)) =
      fun k => jV.appTop.hom (W''.ι.appTop.hom (h k)) := by
    funext k
    rw [Scheme.Hom.comp_appTop]
    rfl
  have hcutV1 : wcEtCutOut iV (fun k => jV.appTop.hom (h'' k)) :=
    wc_et_cutout_base_change iW'' h'' jV iV gV hcut'' hVaff hV
  have hcutV2 : wcEtCutOut iV (fun k => (jV ≫ W''.ι).appTop.hom (h k)) :=
    wc_et_cutout_base_change i h (jV ≫ W''.ι) iV (gV ≫ gW'') hcut hVaff Q
  have SV1 : SmoothOfRelativeDimension n (jV ≫ W''.ι ≫ fW) := hsm0 jV (W''.ι ≫ fW) n
  have SV2 : SmoothOfRelativeDimension (n - c) (iV ≫ jV ≫ W''.ι ≫ fW) := hsmV jV gV iV hV
  have gcV1 : wcEtGoodChart K (jV ≫ W''.ι ≫ fW) iV c (fun k => jV.appTop.hom (h'' k)) :=
    ⟨n, hcn, SV1, SV2, hcutV1⟩
  have gcV2 : wcEtGoodChart K (jV ≫ W''.ι ≫ fW) iV c
      (fun k => (jV ≫ W''.ι).appTop.hom (h k)) := ⟨n, hcn, SV1, SV2, hcutV2⟩
  have L6 := wc_et_supp_restr_comp W''.ι jV (jV ≫ W''.ι) rfl D DW'' DV EW'' Ej Ec γ'' γj γc
    hadm'' hadmj hγc hepi (2 * c) (T fW i D c h)
  have NA := hNat fW (jV ≫ W''.ι ≫ fW) (jV ≫ W''.ι) (Category.assoc _ _ _) i iV (gV ≫ gW'') Q
    D Ec DV γc hγc c h gcW gcV2
  have NB := hNat (W''.ι ≫ fW) (jV ≫ W''.ι ≫ fW) jV rfl iW'' iV gV hV DW'' Ej DV γj hadmj c h''
    gcW'' gcV1
  have key : (fun k => jV.appTop.hom (h'' k)) =
      B.mulVec (fun k => (jV ≫ W''.ι).appTop.hom (h k)) :=
    hrel.trans (congrArg B.mulVec hca.symm)
  rw [← L6, NA, NB]
  exact (hGL _ iV DV c _ B hB gcV2).symm.trans
    (congrArg (T (jV ≫ W''.ι ≫ fW) iV DV c) key.symm)

theorem wc_et_supp_restr_iso_bijective : ∀ {Y Z Y' Z' : Scheme.{u}} {n : ℕ} (e : Y' ⟶ Y) [IsIso e] (i : Z ⟶ Y) [IsClosedImmersion i] (i' : Z' ⟶ Y') (g : Z' ⟶ Z), IsPullback g i' i e → ∀ (D : wcEtPullData i n) (E : wcEtPullData e n) (D' : wcEtPullData i' n) (γ : wcEtSuppObj D' ⟶ E.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D) → ∀ q : ℕ, Function.Bijective (wcEtSuppRestr D E D' γ q) :=
by
  intro Y Z Y' Z' n e _ i _ i' g h D E D' γ hγ q
  haveI : Etale e := inferInstance
  have hg : IsIso g := h.isIso_fst_of_isIso
  exact ⟨wc_et_supp_restr_etale_excision_injective e i i' g h hg D E D' γ hγ q,
    wc_et_supp_restr_etale_excision_surjective e i i' g h hg D E D' γ hγ q⟩

theorem wc_et_open_supp_gamma_iso : ∀ {X Z ZU : Scheme.{u}} {ℓ : ℕ} (U : X.Opens) (i : Z ⟶ X) [IsClosedImmersion i] (iU : ZU ⟶ (U : Scheme.{u})) (gU : ZU ⟶ Z), IsPullback gU iU i U.ι → ∀ (D : wcEtPullData i ℓ) (DU : wcEtPullData iU ℓ) (E : wcEtPullData U.ι ℓ) (γ : wcEtSuppObj DU ⟶ E.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap DU ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D) → IsIso γ :=
by
  intro X Z ZU ℓ U i _ iU gU hsq D DU E γ hγ
  obtain ⟨-, -, hepi⟩ := wc_et_closed_supp_base_change i U.ι iU gU hsq D E DU
  haveI := hepi
  haveI := E.presColim
  haveI := E.additive
  haveI : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D
  haveI : Epi (E.Φ.map (wcEtSuppUnitMap D)) := inferInstance
  haveI : Epi (E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D)) := epi_comp _ _
  haveI : Epi γ := epi_of_epi_fac hγ
  haveI : Mono γ := by
    apply Preadditive.mono_of_cancel_zero
    intro P h hh
    have hsnd : Epi (Limits.pullback.snd (wcEtSuppUnitMap DU) h) := inferInstance
    have hfst : Limits.pullback.fst (wcEtSuppUnitMap DU) h ≫
        (E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D)) = 0 := by
      rw [← hγ, ← Category.assoc, Limits.pullback.condition, Category.assoc, hh,
        Limits.comp_zero]
    have hk := wc_et_open_supp_kernel_reverse U i iU gU hsq D DU E
    have e : Limits.pullback.fst (wcEtSuppUnitMap DU) h =
        Limits.kernel.lift _ _ hfst ≫ Limits.kernel.ι _ := (Limits.kernel.lift_ι _ _ hfst).symm
    have h2 : Limits.pullback.snd (wcEtSuppUnitMap DU) h ≫ h = 0 := by
      rw [← Limits.pullback.condition, e, Category.assoc, hk, Limits.comp_zero]
    exact (cancel_epi (Limits.pullback.snd (wcEtSuppUnitMap DU) h)).mp
      (h2.trans Limits.comp_zero.symm)
  exact isIso_of_mono_of_epi γ

theorem wc_et_supp_restr_extzero_transfer_bij : ∀ {X Y Y' X' : Scheme.{u}} {n : ℕ} {i : X ⟶ Y} {f : Y' ⟶ Y} {i' : X' ⟶ Y'} (D : wcEtPullData i n) (Df : wcEtPullData f n) (D' : wcEtPullData i' n) (γ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D)), IsIso γ → ∀ (L : SheafOfModules.{u+1} (wcEtZModRing Y' n) ⥤ SheafOfModules.{u+1} (wcEtZModRing Y n)) (adj : L ⊣ Df.Φ), Limits.PreservesFiniteLimits L → ∀ q : ℕ, letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y' n)) := HasExt.standard _; letI : Df.Φ.Additive := Df.additive; letI : Limits.PreservesFiniteLimits Df.Φ := Df.presLim; letI : Limits.PreservesFiniteColimits Df.Φ := Df.presColim; Function.Bijective (fun x : Abelian.Ext (L.obj (Df.Φ.obj (wcEtSuppObj D))) (SheafOfModules.unit (wcEtZModRing Y n)) q => (Abelian.Ext.mk₀ (γ ≫ adj.unit.app (Df.Φ.obj (wcEtSuppObj D)))).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q)) ∧ ∀ θ : wcEtSuppExt D q, (Abelian.Ext.mk₀ (γ ≫ adj.unit.app (Df.Φ.obj (wcEtSuppObj D)))).comp ((Abelian.Ext.mapExactFunctor Df.Φ ((Abelian.Ext.mk₀ (adj.counit.app (wcEtSuppObj D))).comp θ (zero_add q))).comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q) = wcEtSuppRestr D Df D' γ q θ :=
by
  intro X Y Y' X' n i f i' D Df D' γ hγ L adj hL q
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y' n)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesFiniteLimits L := hL
  haveI : Limits.PreservesFiniteColimits L := by
    haveI := adj.leftAdjoint_preservesColimits.{0, 0}
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  haveI : IsIso γ := hγ
  let B : Abelian.Ext (L.obj (Df.Φ.obj (wcEtSuppObj D))) (SheafOfModules.unit (wcEtZModRing Y n)) q →
      Abelian.Ext (Df.Φ.obj (wcEtSuppObj D)) (Df.Φ.obj (SheafOfModules.unit (wcEtZModRing Y n))) q :=
    fun x => (Abelian.Ext.mk₀ (adj.unit.app (Df.Φ.obj (wcEtSuppObj D)))).comp
      (Abelian.Ext.mapExactFunctor Df.Φ x) (zero_add q)
  have hB : Function.Bijective B := by
    have e : B = adj.extEquiv := by
      funext x
      rw [Adjunction.extEquiv_apply]
    rw [e]
    exact adj.extEquiv.bijective
  let Q : Abelian.Ext (Df.Φ.obj (wcEtSuppObj D)) (Df.Φ.obj (SheafOfModules.unit (wcEtZModRing Y n))) q →
      Abelian.Ext (Df.Φ.obj (wcEtSuppObj D)) (SheafOfModules.unit (wcEtZModRing Y' n)) q :=
    fun z => z.comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)
  have hQ : Function.Bijective Q := by
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun w => w.comp (Abelian.Ext.mk₀ Df.μ.inv) (add_zero q), ?_, ?_⟩
    · intro z
      show (z.comp (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)).comp (Abelian.Ext.mk₀ Df.μ.inv)
        (add_zero q) = z
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    · intro w
      show (w.comp (Abelian.Ext.mk₀ Df.μ.inv) (add_zero q)).comp (Abelian.Ext.mk₀ Df.μ.hom)
        (add_zero q) = w
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
  let P : Abelian.Ext (Df.Φ.obj (wcEtSuppObj D)) (SheafOfModules.unit (wcEtZModRing Y' n)) q →
