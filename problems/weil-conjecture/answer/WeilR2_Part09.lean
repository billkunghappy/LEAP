  have sqT : ∀ (U : Y.Opens) {S S₀ : Scheme.{u}} (f : S ⟶ (U : Scheme.{u})) (i₀ : S₀ ⟶ S)
      (g₀ : S₀ ⟶ Z), IsPullback g₀ i₀ i (f ≫ U.ι) →
      ∃ g' : S₀ ⟶ (i ⁻¹ᵁ U : Scheme.{u}), IsPullback g' i₀ (i ∣_ U) f := by
    intro U S S₀ f i₀ g₀ hsq
    have w : g₀ ≫ i = (i₀ ≫ f) ≫ U.ι := by rw [hsq.w, Category.assoc]
    refine ⟨(CS U).lift g₀ (i₀ ≫ f) w, ?_⟩
    refine IsPullback.of_right ?_ ((CS U).lift_snd _ _ _) (CS U)
    rw [(CS U).lift_fst]
    exact hsq
  obtain ⟨DA'⟩ := wc_et_zmod_pull_data_exists (i ∣_ A') ℓ
  obtain ⟨DB'⟩ := wc_et_zmod_pull_data_exists (i ∣_ B') ℓ
  obtain ⟨DW⟩ := wc_et_zmod_pull_data_exists (i ∣_ (A' ⊓ B')) ℓ
  obtain ⟨EA'⟩ := wc_et_zmod_pull_data_exists A'.ι ℓ
  obtain ⟨EB'⟩ := wc_et_zmod_pull_data_exists B'.ι ℓ
  obtain ⟨EW⟩ := wc_et_zmod_pull_data_exists (A' ⊓ B').ι ℓ
  obtain ⟨γA', hγA', -⟩ :=
    wc_et_closed_supp_base_change i A'.ι (i ∣_ A') (i ⁻¹ᵁ A').ι (CS A') D EA' DA'
  obtain ⟨γB', hγB', -⟩ :=
    wc_et_closed_supp_base_change i B'.ι (i ∣_ B') (i ⁻¹ᵁ B').ι (CS B') D EB' DB'
  obtain ⟨γW, hγW, -⟩ := wc_et_closed_supp_base_change i (A' ⊓ B').ι (i ∣_ (A' ⊓ B'))
    (i ⁻¹ᵁ (A' ⊓ B')).ι (CS (A' ⊓ B')) D EW DW
  have epiDW := wc_et_supp_unit_epi (i ∣_ (A' ⊓ B')) DW

  obtain ⟨gWA, sqWA⟩ := sqT A' (Y.homOfLE (inf_le_left : A' ⊓ B' ≤ A')) (i ∣_ (A' ⊓ B'))
    (i ⁻¹ᵁ (A' ⊓ B')).ι (by rw [Scheme.homOfLE_ι]; exact CS (A' ⊓ B'))
  obtain ⟨gWB, sqWB⟩ := sqT B' (Y.homOfLE (inf_le_right : A' ⊓ B' ≤ B')) (i ∣_ (A' ⊓ B'))
    (i ⁻¹ᵁ (A' ⊓ B')).ι (by rw [Scheme.homOfLE_ι]; exact CS (A' ⊓ B'))
  obtain ⟨FA⟩ := wc_et_zmod_pull_data_exists (Y.homOfLE (inf_le_left : A' ⊓ B' ≤ A')) ℓ
  obtain ⟨FB⟩ := wc_et_zmod_pull_data_exists (Y.homOfLE (inf_le_right : A' ⊓ B' ≤ B')) ℓ
  obtain ⟨γWA, hγWA, -⟩ := wc_et_closed_supp_base_change (i ∣_ A')
    (Y.homOfLE (inf_le_left : A' ⊓ B' ≤ A')) (i ∣_ (A' ⊓ B')) gWA sqWA DA' FA DW
  obtain ⟨γWB, hγWB, -⟩ := wc_et_closed_supp_base_change (i ∣_ B')
    (Y.homOfLE (inf_le_right : A' ⊓ B' ≤ B')) (i ∣_ (A' ⊓ B')) gWB sqWB DB' FB DW

  obtain ⟨gA', sqA⟩ := sqT A' eA iA gA (by rw [heA]; exact hA)
  obtain ⟨gB', sqB⟩ := sqT B' eB iB gB (by rw [heB]; exact hB)
  have hPj : pA ≫ jA = eP ≫ (A' ⊓ B').ι := by
    rw [← heA, ← Category.assoc, ← hePA, Category.assoc, Scheme.homOfLE_ι]
  obtain ⟨gP', sqP⟩ := sqT (A' ⊓ B') eP iP (gPA ≫ gA)
    (by rw [← hPj]; exact hPA.paste_horiz hA)
  obtain ⟨HA⟩ := wc_et_zmod_pull_data_exists eA ℓ
  obtain ⟨HB⟩ := wc_et_zmod_pull_data_exists eB ℓ
  obtain ⟨HP⟩ := wc_et_zmod_pull_data_exists eP ℓ
  obtain ⟨ηA, hηA, -⟩ := wc_et_closed_supp_base_change (i ∣_ A') eA iA gA' sqA DA' HA DA
  obtain ⟨ηB, hηB, -⟩ := wc_et_closed_supp_base_change (i ∣_ B') eB iB gB' sqB DB' HB DB
  obtain ⟨ηP, hηP, -⟩ :=
    wc_et_closed_supp_base_change (i ∣_ (A' ⊓ B')) eP iP gP' sqP DW HP DP
  have bijRA := wc_et_supp_restr_iso_bijective eA (i ∣_ A') iA gA' sqA DA' HA DA ηA hηA q
  have bijRB := wc_et_supp_restr_iso_bijective eB (i ∣_ B') iB gB' sqB DB' HB DB ηB hηB q
  have bijRP :=
    wc_et_supp_restr_iso_bijective eP (i ∣_ (A' ⊓ B')) iP gP' sqP DW HP DP ηP hηP q

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (A' : Scheme.{u}) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (B' : Scheme.{u}) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing ((A' ⊓ B' : Y.Opens) : Scheme.{u}) ℓ)) :=
    HasExt.standard _
  haveI := EA'.additive
  haveI := EA'.presLim
  haveI := EA'.presColim
  haveI := EB'.additive
  haveI := EB'.presLim
  haveI := EB'.presColim
  haveI := EW.additive
  haveI := EW.presLim
  haveI := EW.presColim
  obtain ⟨LA, adjA, pflA, monoA, suppA, epiA, surjA⟩ := wc_et_open_extzero_module_package A' ℓ EA'
  obtain ⟨LB, adjB, pflB, monoB, suppB, epiB, surjB⟩ := wc_et_open_extzero_module_package B' ℓ EB'
  obtain ⟨LW, adjW, pflW, monoW, suppW, epiW, surjW⟩ :=
    wc_et_open_extzero_module_package (A' ⊓ B') ℓ EW
  obtain ⟨uA, vB, hu, hv, Glue⟩ := wc_abelian_extzero_mv_ext_glue LA EA'.Φ LB EB'.Φ LW EW.Φ
    adjA adjB adjW
    (fun K => wcSuppIn Y (A' : Set Y) ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj K))
    (fun K => wcSuppIn Y (B' : Set Y) ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj K))
    (fun K => wcSuppIn Y ((A' ⊓ B' : Y.Opens) : Set Y)
      ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj K))
    monoA monoB monoW suppA suppB suppW epiA epiB epiW
    (fun K G m hm hK => (wc_et_mod_suppIn_calculus Y ℓ (A' : Set Y) (A' : Set Y) K G).2.1 m hm hK)
    (fun K G m hm hK => (wc_et_mod_suppIn_calculus Y ℓ (B' : Set Y) (B' : Set Y) K G).2.1 m hm hK)
    (fun K hK => (wc_et_mod_suppIn_calculus Y ℓ ((A' ⊓ B' : Y.Opens) : Set Y) (A' : Set Y) K K).1
      hK (fun y hy => (TopologicalSpace.Opens.mem_inf.mp hy).1))
    (fun K hK => (wc_et_mod_suppIn_calculus Y ℓ ((A' ⊓ B' : Y.Opens) : Set Y) (B' : Set Y) K K).1
      hK (fun y hy => (TopologicalSpace.Opens.mem_inf.mp hy).2))
    (fun K hKA hKB => by
      have h := (wc_et_mod_suppIn_calculus Y ℓ (A' : Set Y) (B' : Set Y) K K).2.2 hKA hKB
      rw [← TopologicalSpace.Opens.coe_inf] at h
      exact h)
    (wcEtSuppObj D)
    (wc_et_mod_desc_epi_of_open_cover A' B' hsup _ _ _ _ _ (surjA _) (surjB _))

  have isoγA := wc_et_open_supp_gamma_iso A' i (i ∣_ A') (i ⁻¹ᵁ A').ι (CS A') D DA' EA' γA' hγA'
  have isoγB := wc_et_open_supp_gamma_iso B' i (i ∣_ B') (i ⁻¹ᵁ B').ι (CS B') D DB' EB' γB' hγB'
  have isoγW := wc_et_open_supp_gamma_iso (A' ⊓ B') i (i ∣_ (A' ⊓ B')) (i ⁻¹ᵁ (A' ⊓ B')).ι
    (CS (A' ⊓ B')) D DW EW γW hγW
  obtain ⟨bijA, formA⟩ := wc_et_supp_restr_extzero_transfer_bij D EA' DA' γA' isoγA LA adjA pflA q
  obtain ⟨bijB, formB⟩ := wc_et_supp_restr_extzero_transfer_bij D EB' DB' γB' isoγB LB adjB pflB q
  obtain ⟨bijW, -⟩ := wc_et_supp_restr_extzero_transfer_bij D EW DW γW isoγW LW adjW pflW q

  have tA : (γA' ≫ adjA.unit.app (EA'.Φ.obj (wcEtSuppObj D))) ≫
      EA'.Φ.map (adjA.counit.app (wcEtSuppObj D)) = γA' := by
    rw [Category.assoc, Adjunction.right_triangle_components, Category.comp_id]
  have tB : (γB' ≫ adjB.unit.app (EB'.Φ.obj (wcEtSuppObj D))) ≫
      EB'.Φ.map (adjB.counit.app (wcEtSuppObj D)) = γB' := by
    rw [Category.assoc, Adjunction.right_triangle_components, Category.comp_id]
  have tWA : ((γW ≫ adjW.unit.app (EW.Φ.obj (wcEtSuppObj D))) ≫ EW.Φ.map uA) ≫
      EW.Φ.map (adjA.counit.app (wcEtSuppObj D)) = γW := by
    simp only [Category.assoc]
    rw [← Functor.map_comp, hu, Adjunction.right_triangle_components, Category.comp_id]
  have tWB : ((γW ≫ adjW.unit.app (EW.Φ.obj (wcEtSuppObj D))) ≫ EW.Φ.map vB) ≫
      EW.Φ.map (adjB.counit.app (wcEtSuppObj D)) = γW := by
    simp only [Category.assoc]
    rw [← Functor.map_comp, hv, Adjunction.right_triangle_components, Category.comp_id]
  have NatA := wc_et_supp_restr_comp_sub A'.ι (Y.homOfLE (inf_le_left : A' ⊓ B' ≤ A'))
    (A' ⊓ B').ι (Scheme.homOfLE_ι _ _) D DA' DW EA' FA EW γA' γWA γW hγA' hγWA hγW epiDW
    (LA.obj (EA'.Φ.obj (wcEtSuppObj D))) (adjA.counit.app (wcEtSuppObj D)) (monoA _)
    (γA' ≫ adjA.unit.app (EA'.Φ.obj (wcEtSuppObj D)))
    ((γW ≫ adjW.unit.app (EW.Φ.obj (wcEtSuppObj D))) ≫ EW.Φ.map uA) tA tWA q
  have NatB := wc_et_supp_restr_comp_sub B'.ι (Y.homOfLE (inf_le_right : A' ⊓ B' ≤ B'))
    (A' ⊓ B').ι (Scheme.homOfLE_ι _ _) D DB' DW EB' FB EW γB' γWB γW hγB' hγWB hγW epiDW
    (LB.obj (EB'.Φ.obj (wcEtSuppObj D))) (adjB.counit.app (wcEtSuppObj D)) (monoB _)
    (γB' ≫ adjB.unit.app (EB'.Φ.obj (wcEtSuppObj D)))
    ((γW ≫ adjW.unit.app (EW.Φ.obj (wcEtSuppObj D))) ≫ EW.Φ.map vB) tB tWB q
  have h2W : ∀ {A₁ B₁ C₁ D₁ : SheafOfModules.{u+1}
      (wcEtZModRing ((A' ⊓ B' : Y.Opens) : Scheme.{u}) ℓ)} {a : ℕ}
      (f : A₁ ⟶ B₁) (g : B₁ ⟶ C₁) (z : Abelian.Ext C₁ D₁ a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A₁ B₁ C₁ D₁ a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h4W : ∀ {A₁ B₁ C₁ D₁ : SheafOfModules.{u+1}
      (wcEtZModRing ((A' ⊓ B' : Y.Opens) : Scheme.{u}) ℓ)} {a : ℕ}
      (f : A₁ ⟶ B₁) (z : Abelian.Ext B₁ C₁ a) (g : C₁ ⟶ D₁),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A₁ B₁ C₁ D₁ a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
  have PsiWu : ∀ x : Abelian.Ext (LA.obj (EA'.Φ.obj (wcEtSuppObj D)))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) q,
      (Abelian.Ext.mk₀ (γW ≫ adjW.unit.app (EW.Φ.obj (wcEtSuppObj D)))).comp
        ((Abelian.Ext.mapExactFunctor EW.Φ ((Abelian.Ext.mk₀ uA).comp x (zero_add q))).comp
          (Abelian.Ext.mk₀ EW.μ.hom) (add_zero q)) (zero_add q) =
      (Abelian.Ext.mk₀ ((γW ≫ adjW.unit.app (EW.Φ.obj (wcEtSuppObj D))) ≫ EW.Φ.map uA)).comp
        ((Abelian.Ext.mapExactFunctor EW.Φ x).comp (Abelian.Ext.mk₀ EW.μ.hom) (add_zero q))
        (zero_add q) := by
    intro x
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, h4W, h2W]
  have PsiWv : ∀ y : Abelian.Ext (LB.obj (EB'.Φ.obj (wcEtSuppObj D)))
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) q,
      (Abelian.Ext.mk₀ (γW ≫ adjW.unit.app (EW.Φ.obj (wcEtSuppObj D)))).comp
        ((Abelian.Ext.mapExactFunctor EW.Φ ((Abelian.Ext.mk₀ vB).comp y (zero_add q))).comp
          (Abelian.Ext.mk₀ EW.μ.hom) (add_zero q)) (zero_add q) =
      (Abelian.Ext.mk₀ ((γW ≫ adjW.unit.app (EW.Φ.obj (wcEtSuppObj D))) ≫ EW.Φ.map vB)).comp
        ((Abelian.Ext.mapExactFunctor EW.Φ y).comp (Abelian.Ext.mk₀ EW.μ.hom) (add_zero q))
        (zero_add q) := by
    intro y
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, h4W, h2W]

  obtain ⟨θA', hθA'⟩ := bijRA.2 θA
  obtain ⟨θB', hθB'⟩ := bijRB.2 θB
  obtain ⟨xA, hxA⟩ := bijA.2 θA'
  obtain ⟨yB, hyB⟩ := bijB.2 θB'
  beta_reduce at hxA hyB

  obtain ⟨KA⟩ := wc_et_zmod_pull_data_exists (pA ≫ eA) ℓ
  obtain ⟨KB⟩ := wc_et_zmod_pull_data_exists (pB ≫ eB) ℓ
  obtain ⟨κA, hκA, -⟩ := wc_et_closed_supp_base_change (i ∣_ A') (pA ≫ eA) iP (gPA ≫ gA')
    (hPA.paste_horiz sqA) DA' KA DP
  obtain ⟨κB, hκB, -⟩ := wc_et_closed_supp_base_change (i ∣_ B') (pB ≫ eB) iP (gPB ≫ gB')
    (hPB.paste_horiz sqB) DB' KB DP
  have RC1A := wc_et_supp_restr_comp (Y.homOfLE (inf_le_left : A' ⊓ B' ≤ A')) eP (pA ≫ eA) hePA
    DA' DW DP FA HP KA γWA ηP κA hγWA hηP hκA epiDP q θA'
  have RC2A := wc_et_supp_restr_comp eA pA (pA ≫ eA) rfl DA' DA DP HA EPA KA ηA γPA κA
    hηA hγPA hκA epiDP q θA'
  have RC1B := wc_et_supp_restr_comp (Y.homOfLE (inf_le_right : A' ⊓ B' ≤ B')) eP (pB ≫ eB) hePB
    DB' DW DP FB HP KB γWB ηP κB hγWB hηP hκB epiDP q θB'
  have RC2B := wc_et_supp_restr_comp eB pB (pB ≫ eB) rfl DB' DB DP HB EPB KB ηB γPB κB
    hηB hγPB hκB epiDP q θB'
  have agreeW : wcEtSuppRestr DA' FA DW γWA q θA' = wcEtSuppRestr DB' FB DW γWB q θB' := by
    apply bijRP.1
    rw [← RC1A, RC2A, hθA', hagree, ← hθB', ← RC2B, RC1B]

  have hk : (Abelian.Ext.mk₀ uA).comp xA (zero_add q) =
      (Abelian.Ext.mk₀ vB).comp yB (zero_add q) := by
    apply bijW.1
    beta_reduce
    rw [PsiWu, PsiWv, NatA xA, NatB yB, hxA, hyB, agreeW]

  obtain ⟨θ, hθ1, hθ2⟩ := Glue (SheafOfModules.unit (wcEtZModRing Y ℓ)) q xA yB hk

  refine ⟨θ, ?_, ?_⟩
  · rw [wc_et_supp_restr_comp A'.ι eA jA heA D DA' DA EA' HA EA γA' ηA γA hγA' hηA hγA epiDA q θ,
      ← formA θ, hθ1, hxA, hθA']
  · rw [wc_et_supp_restr_comp B'.ι eB jB heB D DB' DB EB' HB EB γB' ηB γB hγB' hηB hγB epiDB q θ,
      ← formB θ, hθ2, hyB, hθB']

theorem wc_et_supp_opens_cover_glue : ∀ {X Z : Scheme.{u}} {ℓ : ℕ} (i : Z ⟶ X) [IsClosedImmersion i] (D : wcEtPullData i ℓ) (q : ℕ), (∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z), IsPullback gV iV i j → ∀ (DV : wcEtPullData iV ℓ) (q' : ℕ), q' + 1 = q → ∀ t : wcEtSuppExt DV q', t = 0) → ∀ (N : ℕ) (U : Fin N → X.Opens), (∀ x : X, ∃ k, x ∈ U k) → ∀ (DU : ∀ k, wcEtPullData (i ∣_ U k) ℓ) (θU : ∀ k, wcEtSuppExt (DU k) q), (∀ (k l : Fin N) {ZP : Scheme.{u}} (iP : ZP ⟶ (U k ⊓ U l : X.Opens)) (gk : ZP ⟶ (i ⁻¹ᵁ U k : Scheme.{u})) (gl : ZP ⟶ (i ⁻¹ᵁ U l : Scheme.{u})), IsPullback gk iP (i ∣_ U k) (X.homOfLE (inf_le_left : U k ⊓ U l ≤ U k)) → IsPullback gl iP (i ∣_ U l) (X.homOfLE (inf_le_right : U k ⊓ U l ≤ U l)) → ∀ (DP : wcEtPullData iP ℓ) (Ek : wcEtPullData (X.homOfLE (inf_le_left : U k ⊓ U l ≤ U k)) ℓ) (El : wcEtPullData (X.homOfLE (inf_le_right : U k ⊓ U l ≤ U l)) ℓ) (γk : wcEtSuppObj DP ⟶ Ek.Φ.obj (wcEtSuppObj (DU k))) (γl : wcEtSuppObj DP ⟶ El.Φ.obj (wcEtSuppObj (DU l))), wcEtSuppUnitMap DP ≫ γk = Ek.μ.inv ≫ Ek.Φ.map (wcEtSuppUnitMap (DU k)) → wcEtSuppUnitMap DP ≫ γl = El.μ.inv ≫ El.Φ.map (wcEtSuppUnitMap (DU l)) → wcEtSuppRestr (DU k) Ek DP γk q (θU k) = wcEtSuppRestr (DU l) El DP γl q (θU l)) → ∃ θ : wcEtSuppExt D q, ∀ (k : Fin N) (E : wcEtPullData (U k).ι ℓ) (γ : wcEtSuppObj (DU k) ⟶ E.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap (DU k) ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D) → wcEtSuppRestr D E (DU k) γ q θ = θU k :=
by
  classical
  intro X Z ℓ i _ D q hvan N U hcov DU θU hcomp

  have s1 : ∀ {A B : X.Opens} (h : A ≤ B) {ZA : Scheme.{u}} (iA : ZA ⟶ (A : Scheme.{u}))
      (gA : ZA ⟶ Z), IsPullback gA iA i A.ι →
      ∃ g' : ZA ⟶ (i ⁻¹ᵁ B : Scheme.{u}), IsPullback g' iA (i ∣_ B) (X.homOfLE h) := by
    intro A B h ZA iA gA hsq
    have CS := (isPullback_morphismRestrict i B).flip
    have w : gA ≫ i = (iA ≫ X.homOfLE h) ≫ B.ι := by
      rw [hsq.w, Category.assoc, Scheme.homOfLE_ι]
    refine ⟨CS.lift gA (iA ≫ X.homOfLE h) w, ?_⟩
    refine IsPullback.of_right ?_ (CS.lift_snd _ _ _) CS
    rw [CS.lift_fst, Scheme.homOfLE_ι]
    exact hsq

  have ADM : ∀ {A B : X.Opens} (h : A ≤ B) (DA : wcEtPullData (i ∣_ A) ℓ)
      (DB : wcEtPullData (i ∣_ B) ℓ) (E : wcEtPullData (X.homOfLE h) ℓ),
      ∃ γ : wcEtSuppObj DA ⟶ E.Φ.obj (wcEtSuppObj DB),
        wcEtSuppUnitMap DA ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap DB) := by
    intro A B h DA DB E
    obtain ⟨g', hg'⟩ := s1 h (i ∣_ A) (i ⁻¹ᵁ A).ι (isPullback_morphismRestrict i A).flip
    obtain ⟨γ, hγ, -⟩ :=
      wc_et_closed_supp_base_change (i ∣_ B) (X.homOfLE h) (i ∣_ A) g' hg' DB E DA
    exact ⟨γ, hγ⟩

  have s2 : ∀ {Y₀ Y' X₀ X' : Scheme.{u}} {i₀ : X₀ ⟶ Y₀} {f : Y' ⟶ Y₀} {i' : X' ⟶ Y'}
      [IsClosedImmersion i'] (D₀ : wcEtPullData i₀ ℓ) (D' : wcEtPullData i' ℓ)
      (E E' : wcEtPullData f ℓ) (γ : wcEtSuppObj D' ⟶ E.Φ.obj (wcEtSuppObj D₀))
      (γ' : wcEtSuppObj D' ⟶ E'.Φ.obj (wcEtSuppObj D₀)),
      wcEtSuppUnitMap D' ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D₀) →
      wcEtSuppUnitMap D' ≫ γ' = E'.μ.inv ≫ E'.Φ.map (wcEtSuppUnitMap D₀) →
      ∀ θ : wcEtSuppExt D₀ q, wcEtSuppRestr D₀ E D' γ q θ = wcEtSuppRestr D₀ E' D' γ' q θ := by
    intro Y₀ Y' X₀ X' i₀ f i' _ D₀ D' E E' γ γ' hγ hγ' θ
    obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists (𝟙 Y') ℓ
    obtain ⟨γ₂, hγ₂, -⟩ :=
      wc_et_closed_supp_base_change i' (𝟙 Y') i' (𝟙 X') (IsPullback.id_horiz i') D' E₂ D'
    have hepi := wc_et_supp_unit_epi i' D'
    have ha := wc_et_supp_restr_comp f (𝟙 Y') f (Category.id_comp f) D₀ D' D' E E₂ E' γ γ₂ γ'
      hγ hγ₂ hγ' hepi q θ
    have hb := wc_et_supp_restr_comp f (𝟙 Y') f (Category.id_comp f) D₀ D' D' E' E₂ E γ' γ₂ γ
      hγ' hγ₂ hγ hepi q θ
    have hc := wc_et_supp_restr_comp (𝟙 Y') (𝟙 Y') (𝟙 Y') (Category.id_comp _) D' D' D'
      E₂ E₂ E₂ γ₂ γ₂ γ₂ hγ₂ hγ₂ hγ₂ hepi q
    exact hb.trans ((congrArg (wcEtSuppRestr D' E₂ D' γ₂ q) ha).trans
      ((hc _).symm.trans ha.symm))

  have hS5 : ∀ (M : ℕ) (V : Fin M → X.Opens) (Wo Uo : X.Opens) (hV : ∀ k, V k ≤ Wo),
      (∀ x : X, x ∈ Wo → ∃ k, x ∈ V k) →
      ∀ (DV : ∀ k, wcEtPullData (i ∣_ V k) ℓ) (θV : ∀ k, wcEtSuppExt (DV k) q)
        (DUo : wcEtPullData (i ∣_ Uo) ℓ) (θUo : wcEtSuppExt DUo q),
      (∀ (k : Fin M) {ZP : Scheme.{u}} (iP : ZP ⟶ (V k ⊓ Uo : X.Opens))
          (gk : ZP ⟶ (i ⁻¹ᵁ V k : Scheme.{u})) (gl : ZP ⟶ (i ⁻¹ᵁ Uo : Scheme.{u})),
          IsPullback gk iP (i ∣_ V k) (X.homOfLE (inf_le_left : V k ⊓ Uo ≤ V k)) →
          IsPullback gl iP (i ∣_ Uo) (X.homOfLE (inf_le_right : V k ⊓ Uo ≤ Uo)) →
          ∀ (DP : wcEtPullData iP ℓ)
            (Ek : wcEtPullData (X.homOfLE (inf_le_left : V k ⊓ Uo ≤ V k)) ℓ)
            (El : wcEtPullData (X.homOfLE (inf_le_right : V k ⊓ Uo ≤ Uo)) ℓ)
            (γk : wcEtSuppObj DP ⟶ Ek.Φ.obj (wcEtSuppObj (DV k)))
            (γl : wcEtSuppObj DP ⟶ El.Φ.obj (wcEtSuppObj DUo)),
          wcEtSuppUnitMap DP ≫ γk = Ek.μ.inv ≫ Ek.Φ.map (wcEtSuppUnitMap (DV k)) →
          wcEtSuppUnitMap DP ≫ γl = El.μ.inv ≫ El.Φ.map (wcEtSuppUnitMap DUo) →
          wcEtSuppRestr (DV k) Ek DP γk q (θV k) = wcEtSuppRestr DUo El DP γl q θUo) →
      ∀ (DW : wcEtPullData (i ∣_ Wo) ℓ) (θW : wcEtSuppExt DW q),
      (∀ (k : Fin M) (E : wcEtPullData (X.homOfLE (hV k)) ℓ)
          (γ : wcEtSuppObj (DV k) ⟶ E.Φ.obj (wcEtSuppObj DW)),
          wcEtSuppUnitMap (DV k) ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap DW) →
          wcEtSuppRestr DW E (DV k) γ q θW = θV k) →
      ∀ (DP : wcEtPullData (i ∣_ (Wo ⊓ Uo)) ℓ)
        (EW : wcEtPullData (X.homOfLE (inf_le_left : Wo ⊓ Uo ≤ Wo)) ℓ)
        (EU : wcEtPullData (X.homOfLE (inf_le_right : Wo ⊓ Uo ≤ Uo)) ℓ)
        (γW : wcEtSuppObj DP ⟶ EW.Φ.obj (wcEtSuppObj DW))
        (γU : wcEtSuppObj DP ⟶ EU.Φ.obj (wcEtSuppObj DUo)),
      wcEtSuppUnitMap DP ≫ γW = EW.μ.inv ≫ EW.Φ.map (wcEtSuppUnitMap DW) →
      wcEtSuppUnitMap DP ≫ γU = EU.μ.inv ≫ EU.Φ.map (wcEtSuppUnitMap DUo) →
      wcEtSuppRestr DW EW DP γW q θW = wcEtSuppRestr DUo EU DP γU q θUo := by
    intro M V Wo Uo hV hcovV DV θV DUo θUo hcompat DW θW hθW DP EW EU γW γU hγW hγU
    rw [← sub_eq_zero]
    have hPk : ∀ k, V k ⊓ Uo ≤ Wo ⊓ Uo := fun k => inf_le_inf_right Uo (hV k)
    refine wc_et_supp_finite_cover_injective (i ∣_ (Wo ⊓ Uo)) DP q ?_ M
      (fun k => ((V k ⊓ Uo : X.Opens) : Scheme.{u})) (fun k => X.homOfLE (hPk k)) ?_ _ ?_
    · intro V' ZV' j' _ iV' gV' hsq DV' q' hq' t
      exact hvan (j' ≫ (Wo ⊓ Uo).ι) iV' _
        (hsq.paste_horiz (isPullback_morphismRestrict i (Wo ⊓ Uo)).flip) DV' q' hq' t
    · intro x
      have hx := TopologicalSpace.Opens.mem_inf.mp x.2
      obtain ⟨k, hk⟩ := hcovV x.1 hx.1
      exact ⟨k, ⟨x.1, TopologicalSpace.Opens.mem_inf.mpr ⟨hk, hx.2⟩⟩,
        Subtype.ext (Scheme.homOfLE_apply _ _)⟩
    · intro k Zk ik gk hk Dk Ek γ hγ
      rw [map_sub, sub_eq_zero]
      have F1 : IsPullback (gk ≫ (i ⁻¹ᵁ (Wo ⊓ Uo)).ι) ik i (V k ⊓ Uo).ι := by
        have h1 := hk.paste_horiz (isPullback_morphismRestrict i (Wo ⊓ Uo)).flip
        rwa [Scheme.homOfLE_ι] at h1
      haveI : IsClosedImmersion ik :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion) hk inferInstance
      have hepi := wc_et_supp_unit_epi ik Dk
      have hPW : V k ⊓ Uo ≤ Wo := le_trans inf_le_left (hV k)
      obtain ⟨g1, hg1⟩ := s1 hPW ik _ F1
      obtain ⟨g3, hg3⟩ := s1 (inf_le_left : V k ⊓ Uo ≤ V k) ik _ F1
      obtain ⟨g4, hg4⟩ := s1 (inf_le_right : V k ⊓ Uo ≤ Uo) ik _ F1
      obtain ⟨E1⟩ := wc_et_zmod_pull_data_exists (X.homOfLE hPW) ℓ
      obtain ⟨E2⟩ := wc_et_zmod_pull_data_exists (X.homOfLE (hV k)) ℓ
      obtain ⟨E3⟩ := wc_et_zmod_pull_data_exists (X.homOfLE (inf_le_left : V k ⊓ Uo ≤ V k)) ℓ
      obtain ⟨E4⟩ := wc_et_zmod_pull_data_exists (X.homOfLE (inf_le_right : V k ⊓ Uo ≤ Uo)) ℓ
      obtain ⟨γ1, hγ1, -⟩ :=
        wc_et_closed_supp_base_change (i ∣_ Wo) (X.homOfLE hPW) ik g1 hg1 DW E1 Dk
      obtain ⟨γ2, hγ2⟩ := ADM (hV k) (DV k) DW E2
      obtain ⟨γ3, hγ3, -⟩ := wc_et_closed_supp_base_change (i ∣_ V k)
        (X.homOfLE (inf_le_left : V k ⊓ Uo ≤ V k)) ik g3 hg3 (DV k) E3 Dk
      obtain ⟨γ4, hγ4, -⟩ := wc_et_closed_supp_base_change (i ∣_ Uo)
        (X.homOfLE (inf_le_right : V k ⊓ Uo ≤ Uo)) ik g4 hg4 DUo E4 Dk
      have hc1 := wc_et_supp_restr_comp (X.homOfLE (inf_le_left : Wo ⊓ Uo ≤ Wo))
        (X.homOfLE (hPk k)) (X.homOfLE hPW) (Scheme.homOfLE_homOfLE _ _ _) DW DP Dk EW Ek E1
        γW γ γ1 hγW hγ hγ1 hepi q θW
      have hc2 := wc_et_supp_restr_comp (X.homOfLE (hV k))
        (X.homOfLE (inf_le_left : V k ⊓ Uo ≤ V k)) (X.homOfLE hPW)
        (Scheme.homOfLE_homOfLE _ _ _) DW (DV k) Dk E2 E3 E1 γ2 γ3 γ1 hγ2 hγ3 hγ1 hepi q θW
      have hc3 := wc_et_supp_restr_comp (X.homOfLE (inf_le_right : Wo ⊓ Uo ≤ Uo))
        (X.homOfLE (hPk k)) (X.homOfLE (inf_le_right : V k ⊓ Uo ≤ Uo))
        (Scheme.homOfLE_homOfLE _ _ _) DUo DP Dk EU Ek E4 γU γ γ4 hγU hγ hγ4 hepi q θUo
      rw [← hc1, hc2, hθW k E2 γ2 hγ2, hcompat k ik g3 g4 hg3 hg4 Dk E3 E4 γ3 γ4 hγ3 hγ4]
      exact hc3

  let W : ℕ → X.Opens := fun m => ⨆ (k : Fin N) (_ : (k : ℕ) < m), U k
  have hUW : ∀ (k : Fin N) (m : ℕ), (k : ℕ) < m → U k ≤ W m := fun k m hk =>
    le_iSup₂_of_le (f := fun (k : Fin N) (_ : (k : ℕ) < m) => U k) k hk le_rfl
  have hWmem : ∀ (m : ℕ) (x : X), x ∈ W m → ∃ k : Fin N, (k : ℕ) < m ∧ x ∈ U k := by
    intro m x hx
    obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    obtain ⟨hk', hx'⟩ := TopologicalSpace.Opens.mem_iSup.mp hk
    exact ⟨k, hk', hx'⟩
  have hWmono : ∀ m, W m ≤ W (m + 1) := fun m =>
    iSup₂_le (fun k hk => hUW k (m + 1) (by omega))

  have hQ : ∀ m, m ≤ N → ∀ DW : wcEtPullData (i ∣_ W m) ℓ, ∃ θW : wcEtSuppExt DW q,
      ∀ (k : Fin N) (hk : (k : ℕ) < m) (E : wcEtPullData (X.homOfLE (hUW k m hk)) ℓ)
        (γ : wcEtSuppObj (DU k) ⟶ E.Φ.obj (wcEtSuppObj DW)),
        wcEtSuppUnitMap (DU k) ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap DW) →
        wcEtSuppRestr DW E (DU k) γ q θW = θU k := by
    intro m
    induction m with
    | zero =>
      intro _ DW
      exact ⟨0, fun k hk => absurd hk (Nat.not_lt_zero _)⟩
    | succ m IH =>
      intro hmN DW'
      have hm : m < N := by omega
      have hW : W m ≤ W (m + 1) := hWmono m
      have hU : U ⟨m, hm⟩ ≤ W (m + 1) := hUW ⟨m, hm⟩ (m + 1) (Nat.lt_succ_self m)
      obtain ⟨DW⟩ := wc_et_zmod_pull_data_exists (i ∣_ W m) ℓ
      obtain ⟨θm, hθm⟩ := IH (by omega) DW
      obtain ⟨DP⟩ := wc_et_zmod_pull_data_exists (i ∣_ (W m ⊓ U ⟨m, hm⟩)) ℓ
      obtain ⟨EA⟩ := wc_et_zmod_pull_data_exists (X.homOfLE hW) ℓ
      obtain ⟨EB⟩ := wc_et_zmod_pull_data_exists (X.homOfLE hU) ℓ
      obtain ⟨EPA⟩ := wc_et_zmod_pull_data_exists
        (X.homOfLE (inf_le_left : W m ⊓ U ⟨m, hm⟩ ≤ W m)) ℓ
      obtain ⟨EPB⟩ := wc_et_zmod_pull_data_exists
        (X.homOfLE (inf_le_right : W m ⊓ U ⟨m, hm⟩ ≤ U ⟨m, hm⟩)) ℓ
      obtain ⟨γA, hγA⟩ := ADM hW DW DW' EA
      obtain ⟨γB, hγB⟩ := ADM hU (DU ⟨m, hm⟩) DW' EB
      obtain ⟨γPA, hγPA⟩ := ADM (inf_le_left : W m ⊓ U ⟨m, hm⟩ ≤ W m) DP DW EPA
      obtain ⟨γPB, hγPB⟩ :=
        ADM (inf_le_right : W m ⊓ U ⟨m, hm⟩ ≤ U ⟨m, hm⟩) DP (DU ⟨m, hm⟩) EPB

      have hagree := hS5 m (fun k' : Fin m => U ⟨k', lt_trans k'.isLt hm⟩) (W m) (U ⟨m, hm⟩)
        (fun k' => hUW ⟨k', lt_trans k'.isLt hm⟩ m k'.isLt)
        (by
          intro x hx
          obtain ⟨k, hk, hxk⟩ := hWmem m x hx
          exact ⟨⟨k, hk⟩, hxk⟩)
        (fun k' => DU ⟨k', lt_trans k'.isLt hm⟩) (fun k' => θU ⟨k', lt_trans k'.isLt hm⟩)
        (DU ⟨m, hm⟩) (θU ⟨m, hm⟩)
        (by
          intro k' ZP iP gk gl h1 h2 DP' Ek El γk γl h3 h4
          exact hcomp ⟨k', lt_trans k'.isLt hm⟩ ⟨m, hm⟩ iP gk gl h1 h2 DP' Ek El γk γl h3 h4)
        DW θm
        (by
          intro k' E γ hγ
          exact hθm ⟨k', lt_trans k'.isLt hm⟩ k'.isLt E γ hγ)
        DP EPA EPB γPA γPB hγPA hγPB

      obtain ⟨gA, hgA⟩ := s1 hW (i ∣_ W m) (i ⁻¹ᵁ W m).ι (isPullback_morphismRestrict i (W m)).flip
      obtain ⟨gB, hgB⟩ := s1 hU (i ∣_ U ⟨m, hm⟩) (i ⁻¹ᵁ U ⟨m, hm⟩).ι
        (isPullback_morphismRestrict i (U ⟨m, hm⟩)).flip
      obtain ⟨gPA, hgPA⟩ := s1 (inf_le_left : W m ⊓ U ⟨m, hm⟩ ≤ W m) (i ∣_ (W m ⊓ U ⟨m, hm⟩))
        (i ⁻¹ᵁ (W m ⊓ U ⟨m, hm⟩)).ι (isPullback_morphismRestrict i (W m ⊓ U ⟨m, hm⟩)).flip
      obtain ⟨gPB, hgPB⟩ := s1 (inf_le_right : W m ⊓ U ⟨m, hm⟩ ≤ U ⟨m, hm⟩)
        (i ∣_ (W m ⊓ U ⟨m, hm⟩))
        (i ⁻¹ᵁ (W m ⊓ U ⟨m, hm⟩)).ι (isPullback_morphismRestrict i (W m ⊓ U ⟨m, hm⟩)).flip
      have hjoint : ∀ y : ((W (m + 1) : X.Opens) : Scheme.{u}),
          y ∈ Set.range (X.homOfLE hW) ∨ y ∈ Set.range (X.homOfLE hU) := by
        intro y
        obtain ⟨k, hk, hyk⟩ := hWmem (m + 1) y.1 y.2
        by_cases hkm : (k : ℕ) < m
        · left
          exact ⟨⟨y.1, hUW k m hkm hyk⟩, Subtype.ext (Scheme.homOfLE_apply _ _)⟩
        · right
          have hk' : k = ⟨m, hm⟩ := Fin.ext (by show (k : ℕ) = m; omega)
          rw [hk'] at hyk
          exact ⟨⟨y.1, hyk⟩, Subtype.ext (Scheme.homOfLE_apply _ _)⟩
      obtain ⟨θ', hA, hB⟩ := wc_et_supp_mv_glue (i ∣_ W (m + 1)) (X.homOfLE hW) (X.homOfLE hU)
        hjoint _ _ (isPullback_opens_inf_le hW hU) (i ∣_ W m) (i ∣_ U ⟨m, hm⟩)
        (i ∣_ (W m ⊓ U ⟨m, hm⟩)) gA gB gPA gPB hgA hgB hgPA hgPB DW' DW (DU ⟨m, hm⟩) DP
        EA EB EPA EPB γA γB γPA γPB hγA hγB hγPA hγPB q θm (θU ⟨m, hm⟩) hagree

      refine ⟨θ', fun k hk E γ hγ => ?_⟩
      by_cases hkm : (k : ℕ) < m
      · obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists (X.homOfLE (hUW k m hkm)) ℓ
        obtain ⟨γ₂, hγ₂⟩ := ADM (hUW k m hkm) (DU k) DW E₂
        have hc := wc_et_supp_restr_comp (X.homOfLE hW) (X.homOfLE (hUW k m hkm))
          (X.homOfLE (hUW k (m + 1) hk)) (Scheme.homOfLE_homOfLE _ _ _) DW' DW (DU k) EA E₂ E
          γA γ₂ γ hγA hγ₂ hγ (wc_et_supp_unit_epi _ _) q θ'
        rw [hc, hA]
        exact hθm k hkm E₂ γ₂ hγ₂
      · have hk' : k = ⟨m, hm⟩ := Fin.ext (by show (k : ℕ) = m; omega)
        subst hk'
        rw [s2 DW' (DU _) E EB γ γB hγ hγB θ']
        exact hB

  obtain ⟨DWN⟩ := wc_et_zmod_pull_data_exists (i ∣_ W N) ℓ
  obtain ⟨θN, hθN⟩ := hQ N le_rfl DWN
  obtain ⟨DPN⟩ := wc_et_zmod_pull_data_exists (i ∣_ (W N ⊓ W N)) ℓ
  obtain ⟨EA⟩ := wc_et_zmod_pull_data_exists (W N).ι ℓ
  obtain ⟨EPA⟩ := wc_et_zmod_pull_data_exists (X.homOfLE (inf_le_left : W N ⊓ W N ≤ W N)) ℓ
  obtain ⟨γA, hγA, -⟩ := wc_et_closed_supp_base_change i (W N).ι (i ∣_ W N) (i ⁻¹ᵁ W N).ι
    (isPullback_morphismRestrict i (W N)).flip D EA DWN
  obtain ⟨γPA, hγPA⟩ := ADM (inf_le_left : W N ⊓ W N ≤ W N) DPN DWN EPA
  obtain ⟨gPA, hgPA⟩ := s1 (inf_le_left : W N ⊓ W N ≤ W N) (i ∣_ (W N ⊓ W N))
    (i ⁻¹ᵁ (W N ⊓ W N)).ι (isPullback_morphismRestrict i (W N ⊓ W N)).flip
  have hjoint : ∀ x : X, x ∈ Set.range (W N).ι ∨ x ∈ Set.range (W N).ι := by
    intro x
    left
    obtain ⟨k, hk⟩ := hcov x
    rw [Scheme.Opens.range_ι]
    exact hUW k N k.isLt hk
  obtain ⟨θ, hθA, -⟩ := wc_et_supp_mv_glue i (W N).ι (W N).ι hjoint _ _
    (isPullback_opens_inf (W N) (W N)) (i ∣_ W N) (i ∣_ W N) (i ∣_ (W N ⊓ W N))
    (i ⁻¹ᵁ W N).ι (i ⁻¹ᵁ W N).ι gPA gPA
    (isPullback_morphismRestrict i (W N)).flip (isPullback_morphismRestrict i (W N)).flip
    hgPA hgPA D DWN DWN DPN EA EA EPA EPA γA γA γPA γPA hγA hγA hγPA hγPA q θN θN rfl
  refine ⟨θ, fun k E γ hγ => ?_⟩
  obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists (X.homOfLE (hUW k N k.isLt)) ℓ
  obtain ⟨γ₂, hγ₂⟩ := ADM (hUW k N k.isLt) (DU k) DWN E₂
  have hc := wc_et_supp_restr_comp (W N).ι (X.homOfLE (hUW k N k.isLt)) (U k).ι
    (Scheme.homOfLE_ι _ _) D DWN (DU k) EA E₂ E γA γ₂ γ hγA hγ₂ hγ
    (wc_et_supp_unit_epi _ _) q θ
  rw [hc, hθA]
  exact hθN k k.isLt E₂ γ₂ hγ₂

theorem wc_et_thom_local_of_cover : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (T : wcEtLocThom K ℓ), wcEtThomGL T → wcEtThomNat T → ∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] [IsSeparated fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i ℓ) (N : ℕ) (U : Fin N → X.Opens), (∀ k, IsAffineOpen (U k)) → (∀ x : X, ∃ k, x ∈ U k) → ∀ (DU : ∀ k, wcEtPullData (i ∣_ U k) ℓ) (θ : wcEtSuppExt D (2 * c)), (∀ (k : Fin N) (E : wcEtPullData (U k).ι ℓ) (γ : wcEtSuppObj (DU k) ⟶ E.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap (DU k) ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D) → wcEtIsThom T ((U k).ι ≫ fX) (DU k) c (wcEtSuppRestr D E (DU k) γ (2 * c) θ)) → wcEtIsThom T fX D c θ :=
by
  classical
  intro K _ _ ℓ _ hℓ T hGL hNat X Z fX n c _ _ i _ _ hcn D N U hUa hcov DU θ hH

  have hO1 : ∀ {V : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j],
      SmoothOfRelativeDimension n (j ≫ fX) := by
    intro V j _
    have h0 : SmoothOfRelativeDimension (0 + n) (j ≫ fX) := inferInstance
    rwa [zero_add] at h0

  have hO2 : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → SmoothOfRelativeDimension (n - c) (iV ≫ j ≫ fX) := by
    intro V ZV j _ iV gV hsq
    haveI : IsOpenImmersion gV :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip inferInstance
    have h0 : SmoothOfRelativeDimension (0 + (n - c)) (gV ≫ i ≫ fX) := inferInstance
    rw [zero_add] at h0
    have e : iV ≫ j ≫ fX = gV ≫ i ≫ fX := by
      rw [← Category.assoc, ← hsq.w, Category.assoc]
    rw [e]
    exact h0
  haveI hqs : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated fX

  intro W ZW iW gW hW DW EW γ hγ h hcut
  haveI : IsClosedImmersion iW := hcut.2.1
  haveI := hO1 W.ι
  haveI := hO2 W.ι iW gW hW

  have hτ : wcEtIsThom T (W.ι ≫ fX) DW c (T (W.ι ≫ fX) iW DW c h) :=
    wc_et_thom_chart_class K ℓ hℓ T hGL hNat (W.ι ≫ fX) n c iW hcn DW h hcut

  have hkey : ∀ (k : Fin N) (ZP : Scheme.{u})
      (iP : ZP ⟶ ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Scheme.{u})) (gP : ZP ⟶ ZW),
      IsPullback gP iP iW (W.ι ⁻¹ᵁ U k).ι → ∀ (DP : wcEtPullData iP ℓ)
      (EP : wcEtPullData (W.ι ⁻¹ᵁ U k).ι ℓ) (γP : wcEtSuppObj DP ⟶ EP.Φ.obj (wcEtSuppObj DW)),
      wcEtSuppUnitMap DP ≫ γP = EP.μ.inv ≫ EP.Φ.map (wcEtSuppUnitMap DW) →
      wcEtSuppRestr DW EP DP γP (2 * c) (wcEtSuppRestr D EW DW γ (2 * c) θ) =
        wcEtSuppRestr DW EP DP γP (2 * c) (T (W.ι ≫ fX) iW DW c h) := by
    intro k ZP iP gP hP DP EP γP hγP
    haveI : IsClosedImmersion iP :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP inferInstance
    have hO : IsPullback (gP ≫ gW) iP i ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) := hP.paste_horiz hW

    have hrange : Set.range ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) ⊆ Set.range (U k).ι := by
      rintro _ ⟨y, rfl⟩
      rw [Scheme.Opens.range_ι]
      simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply]
      exact y.2
    obtain ⟨m, hmo, hm⟩ : ∃ m : ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Scheme.{u}) ⟶
        (U k : Scheme.{u}), IsOpenImmersion m ∧ m ≫ (U k).ι = (W.ι ⁻¹ᵁ U k).ι ≫ W.ι :=
      ⟨IsOpenImmersion.lift (U k).ι _ hrange, inferInstance, IsOpenImmersion.lift_fac _ _ _⟩
    haveI := hmo
    have R := (isPullback_morphismRestrict i (U k)).flip
    have hw : (gP ≫ gW) ≫ i = (iP ≫ m) ≫ (U k).ι := by
      rw [hO.w, Category.assoc, hm]
    obtain ⟨g'', hg1, hg2⟩ : ∃ g'' : ZP ⟶ ((i ⁻¹ᵁ U k : Z.Opens) : Scheme.{u}),
        g'' ≫ (i ⁻¹ᵁ U k).ι = gP ≫ gW ∧ g'' ≫ (i ∣_ U k) = iP ≫ m :=
      ⟨R.lift _ _ hw, R.lift_fst _ _ _, R.lift_snd _ _ _⟩
    have hk' : IsPullback g'' iP (i ∣_ U k) m := by
      refine IsPullback.of_right ?_ hg2 R
      rw [hg1, hm]
      exact hO

    obtain ⟨Es⟩ := wc_et_zmod_pull_data_exists ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) ℓ
    obtain ⟨γs, hγs, _⟩ :=
      wc_et_closed_supp_base_change i ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) iP (gP ≫ gW) hO D Es DP
    obtain ⟨EU⟩ := wc_et_zmod_pull_data_exists (U k).ι ℓ
    obtain ⟨γU, hγU, _⟩ :=
      wc_et_closed_supp_base_change i (U k).ι (i ∣_ U k) (i ⁻¹ᵁ U k).ι R D EU (DU k)
    obtain ⟨Fk⟩ := wc_et_zmod_pull_data_exists m ℓ
    obtain ⟨γ', hγ', _⟩ := wc_et_closed_supp_base_change (i ∣_ U k) m iP g'' hk' (DU k) Fk DP
    have hepi : Epi (wcEtSuppUnitMap DP) := wc_et_supp_unit_epi iP DP

    have e1 := wc_et_supp_restr_comp W.ι (W.ι ⁻¹ᵁ U k).ι ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) rfl
      D DW DP EW EP Es γ γP γs hγ hγP hγs hepi (2 * c) θ
    have e2 := wc_et_supp_restr_comp (U k).ι m ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) hm
      D (DU k) DP EU Fk Es γU γ' γs hγU hγ' hγs hepi (2 * c) θ

    haveI := hO1 (U k).ι
    haveI := hO2 (U k).ι (i ∣_ U k) (i ⁻¹ᵁ U k).ι R
    have hB := wc_et_thom_open_restrict K ℓ hℓ T hNat ((U k).ι ≫ fX) n c (i ∣_ U k) hcn m iP g''
      hk' (DU k) Fk DP γ' hγ' _ (hH k EU γU hγU)
    have hA := wc_et_thom_open_restrict K ℓ hℓ T hNat (W.ι ≫ fX) n c iW hcn (W.ι ⁻¹ᵁ U k).ι iP gP
      hP DW EP DP γP hγP _ hτ
    have hmf : m ≫ (U k).ι ≫ fX = (W.ι ⁻¹ᵁ U k).ι ≫ W.ι ≫ fX := by
      rw [← Category.assoc, hm, Category.assoc]
    rw [hmf] at hB

    have hs1 : SmoothOfRelativeDimension n ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι ≫ fX) := by
      have h0 := hO1 ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι)
      rwa [Category.assoc] at h0
    have hs2 : SmoothOfRelativeDimension (n - c) (iP ≫ (W.ι ⁻¹ᵁ U k).ι ≫ W.ι ≫ fX) := by
      have h0 := hO2 ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι) iP (gP ≫ gW) hO
      rwa [Category.assoc] at h0
    have hcpt : IsCompact ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Set (W : Scheme.{u})) := by
      rw [W.ι.isOpenEmbedding.isEmbedding.isCompact_iff]
      have e : ⇑W.ι '' ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Set (W : Scheme.{u})) =
          (W : Set X) ∩ (U k : Set X) := by
        show ⇑W.ι '' (⇑W.ι ⁻¹' (U k : Set X)) = _
        rw [Set.image_preimage_eq_range_inter, Scheme.Opens.range_ι]
      rw [e]
      exact QuasiSeparatedSpace.inter_isCompact _ _ W.isOpen
        (show IsAffineOpen W from hcut.1).isCompact (U k).isOpen (hUa k).isCompact
    haveI : CompactSpace ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Scheme.{u}) :=
      isCompact_iff_compactSpace.mp hcpt
    have huniq := wc_et_thom_class_unique K ℓ hℓ T
      ((W.ι ⁻¹ᵁ U k : (W : Scheme.{u}).Opens) : Scheme.{u}) ZP
      ((W.ι ⁻¹ᵁ U k).ι ≫ W.ι ≫ fX) n c iP hcn DP _ _ hB hA
    rw [← e1, e2]
    exact huniq

  have hvan : ∀ {V ZV : Scheme.{u}} (j : V ⟶ (W : Scheme.{u})) [IsOpenImmersion j] (iV : ZV ⟶ V)
      (gV : ZV ⟶ ZW), IsPullback gV iV iW j → ∀ (DV : wcEtPullData iV ℓ) (q' : ℕ),
      q' + 1 = 2 * c → ∀ t : wcEtSuppExt DV q', t = 0 := by
    intro V ZV j _ iV gV hsq DV q' hq' t
    have hsq' : IsPullback (gV ≫ gW) iV i (j ≫ W.ι) := hsq.paste_horiz hW
    haveI : IsClosedImmersion iV :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    haveI := hO1 (j ≫ W.ι)
    haveI := hO2 (j ≫ W.ι) iV (gV ≫ gW) hsq'
    exact wc_et_supp_semipurity K V ZV ((j ≫ W.ι) ≫ fX) n c iV hcn ℓ hℓ DV q' (by omega) t

  have hδ := wc_et_supp_opens_cover_injective iW DW (2 * c) hvan N (fun k => W.ι ⁻¹ᵁ U k)
    (by
      intro x
      obtain ⟨k, hk⟩ := hcov (W.ι x)
      exact ⟨k, hk⟩)
    (wcEtSuppRestr D EW DW γ (2 * c) θ - T (W.ι ≫ fX) iW DW c h)
    (by
      intro k ZP iP gP hP DP EP γP hγP
      rw [map_sub, sub_eq_zero]
      exact hkey k ZP iP gP hP DP EP γP hγP)
  exact sub_eq_zero.mp hδ

theorem wc_et_thom_class_glue : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (T : wcEtLocThom K ℓ), wcEtThomGL T → wcEtThomNat T → ∀ (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] [CompactSpace ↥X] [IsSeparated fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (D : wcEtPullData i ℓ), ∃ θ : wcEtSuppExt D (2 * c), wcEtIsThom T fX D c θ :=
by
  classical
  intro K _ _ ℓ _ hℓ T hGL hNat X Z fX n c _ _ _ i _ _ hcn D

  have hO1 : ∀ {V : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j],
      SmoothOfRelativeDimension n (j ≫ fX) := by
    intro V j _
    have h0 : SmoothOfRelativeDimension (0 + n) (j ≫ fX) := inferInstance
    rwa [zero_add] at h0

  have hO2 : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → SmoothOfRelativeDimension (n - c) (iV ≫ j ≫ fX) := by
    intro V ZV j _ iV gV hsq
    haveI : IsOpenImmersion gV :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip inferInstance
    have h0 : SmoothOfRelativeDimension (0 + (n - c)) (gV ≫ i ≫ fX) := inferInstance
    rw [zero_add] at h0
    have e : iV ≫ j ≫ fX = gV ≫ i ≫ fX := by
      rw [← Category.assoc, ← hsq.w, Category.assoc]
    rw [e]
    exact h0

  have hvan : ∀ {V ZV : Scheme.{u}} (j : V ⟶ X) [IsOpenImmersion j] (iV : ZV ⟶ V) (gV : ZV ⟶ Z),
      IsPullback gV iV i j → ∀ (DV : wcEtPullData iV ℓ) (q' : ℕ), q' + 1 = 2 * c →
        ∀ t : wcEtSuppExt DV q', t = 0 := by
    intro V ZV j _ iV gV hsq DV q' hq' t
    haveI := hO1 j
    haveI : IsClosedImmersion iV :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    haveI := hO2 j iV gV hsq
    exact wc_et_supp_semipurity K V ZV (j ≫ fX) n c iV hcn ℓ hℓ DV q' (by omega) t

  have hloc : ∀ x : X, ∃ W : X.Opens, IsAffineOpen W ∧ x ∈ W ∧
      ∀ DW : wcEtPullData (i ∣_ W) ℓ, ∃ θW : wcEtSuppExt DW (2 * c),
        wcEtIsThom T (W.ι ≫ fX) DW c θW := by
    intro x
    by_cases hx : x ∈ Set.range i
    · obtain ⟨z, rfl⟩ := hx
      obtain ⟨W, hWa, hzW, h, hcut⟩ := wc_smooth_pair_local_cutout K X Z fX n c i hcn z
      refine ⟨W, hWa, hzW, fun DW => ⟨T (W.ι ≫ fX) (i ∣_ W) DW c h, ?_⟩⟩
      haveI := hO1 W.ι
      haveI := hO2 W.ι (i ∣_ W) (i ⁻¹ᵁ W).ι (isPullback_morphismRestrict i W).flip
      exact wc_et_thom_chart_class K ℓ hℓ T hGL hNat (W.ι ≫ fX) n c (i ∣_ W) hcn DW h hcut
    · have hopen : IsOpen (Set.range i)ᶜ := i.isClosedEmbedding.isClosed_range.isOpen_compl
      obtain ⟨W, hWa, hxW, hWsub⟩ :=
        exists_isAffineOpen_mem_and_subset (U := ⟨(Set.range i)ᶜ, hopen⟩) (x := x) hx
      refine ⟨W, hWa, hxW, fun DW => ⟨0, ?_⟩⟩
      have hE : IsEmpty (i ⁻¹ᵁ W : Scheme.{u}) := by
        apply Scheme.isEmpty_of_commSq (isPullback_morphismRestrict i W).flip.toCommSq
        rw [Scheme.Opens.range_ι]
        exact Set.subset_compl_iff_disjoint_left.mp (show (W : Set X) ⊆ (Set.range i)ᶜ from hWsub)
      intro W' ZW' iW' gW' _ DW' EW' γ _ h' _
      haveI : IsEmpty ZW' := ⟨fun z => hE.false (gW' z)⟩
      haveI := wc_et_supp_ext_empty iW' ℓ DW' inferInstance (2 * c)
      exact Subsingleton.elim _ _

  choose W hWa hxW hθW using hloc
  choose θW hθW' using hθW
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (W x : Set X))
    (fun x => (W x).isOpen.mem_nhds (hxW x))
  let e := t.equivFin
  let U : Fin t.card → X.Opens := fun k => W (e.symm k).1
  have hUa : ∀ k, IsAffineOpen (U k) := fun k => hWa _
  have hcov : ∀ x : X, ∃ k, x ∈ U k := by
    intro x
    have hx : x ∈ ⋃ y ∈ t, (W y : Set X) := by
      rw [ht]
      exact Set.mem_univ x
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    refine ⟨e ⟨y, hy⟩, ?_⟩
    show x ∈ W (e.symm (e ⟨y, hy⟩)).1
    rw [Equiv.symm_apply_apply]
    exact hxy
  let DU : ∀ k, wcEtPullData (i ∣_ U k) ℓ := fun k => (wc_et_zmod_pull_data_exists _ ℓ).some
  let θU : ∀ k, wcEtSuppExt (DU k) (2 * c) := fun k => θW _ (DU k)
  have hθU : ∀ k, wcEtIsThom T ((U k).ι ≫ fX) (DU k) c (θU k) := fun k => hθW' _ (DU k)

  haveI hqs : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated fX

  obtain ⟨θ, hθ⟩ := wc_et_supp_opens_cover_glue i D (2 * c) hvan t.card U hcov DU θU (by
    intro k l ZP iP gk gl hk hl DP Ek El γk γl hγk hγl
    have hkk : IsPullback (gk ≫ (i ⁻¹ᵁ U k).ι) iP i (U k ⊓ U l).ι := by
      have h1 := hk.paste_horiz (isPullback_morphismRestrict i (U k)).flip
      rwa [Scheme.homOfLE_ι] at h1
    haveI := hO1 (U k ⊓ U l).ι
    haveI := hO2 (U k ⊓ U l).ι iP _ hkk
    haveI : IsClosedImmersion iP :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hkk inferInstance
    have hcpt : IsCompact ((U k ⊓ U l : X.Opens) : Set X) := by
      rw [TopologicalSpace.Opens.coe_inf]
      exact QuasiSeparatedSpace.inter_isCompact _ _ (U k).isOpen (hUa k).isCompact
        (U l).isOpen (hUa l).isCompact
    haveI : CompactSpace ↥((U k ⊓ U l : X.Opens) : Scheme.{u}) :=
      isCompact_iff_compactSpace.mp hcpt
    have hTk : wcEtIsThom T ((U k ⊓ U l).ι ≫ fX) DP c
        (wcEtSuppRestr (DU k) Ek DP γk (2 * c) (θU k)) := by
      haveI := hO1 (U k).ι
      haveI := hO2 (U k).ι (i ∣_ U k) (i ⁻¹ᵁ U k).ι (isPullback_morphismRestrict i (U k)).flip
      have h1 := wc_et_thom_open_restrict K ℓ hℓ T hNat ((U k).ι ≫ fX) n c (i ∣_ U k) hcn
        (X.homOfLE (inf_le_left : U k ⊓ U l ≤ U k)) iP gk hk (DU k) Ek DP γk hγk (θU k) (hθU k)
      have e1 : X.homOfLE (inf_le_left : U k ⊓ U l ≤ U k) ≫ (U k).ι ≫ fX =
          (U k ⊓ U l).ι ≫ fX := by
        rw [← Category.assoc, Scheme.homOfLE_ι]
      rw [e1] at h1
      exact h1
    have hTl : wcEtIsThom T ((U k ⊓ U l).ι ≫ fX) DP c
        (wcEtSuppRestr (DU l) El DP γl (2 * c) (θU l)) := by
      haveI := hO1 (U l).ι
      haveI := hO2 (U l).ι (i ∣_ U l) (i ⁻¹ᵁ U l).ι (isPullback_morphismRestrict i (U l)).flip
      have h1 := wc_et_thom_open_restrict K ℓ hℓ T hNat ((U l).ι ≫ fX) n c (i ∣_ U l) hcn
        (X.homOfLE (inf_le_right : U k ⊓ U l ≤ U l)) iP gl hl (DU l) El DP γl hγl (θU l) (hθU l)
      have e1 : X.homOfLE (inf_le_right : U k ⊓ U l ≤ U l) ≫ (U l).ι ≫ fX =
          (U k ⊓ U l).ι ≫ fX := by
        rw [← Category.assoc, Scheme.homOfLE_ι]
      rw [e1] at h1
      exact h1
    exact wc_et_thom_class_unique K ℓ hℓ T (U k ⊓ U l : X.Opens) ZP ((U k ⊓ U l).ι ≫ fX) n c iP
      hcn DP _ _ hTk hTl)

  refine ⟨θ, wc_et_thom_local_of_cover K ℓ hℓ T hGL hNat X Z fX n c i hcn D t.card U hUa hcov
    DU θ ?_⟩
  intro k E γ hγ
  rw [hθ k E γ hγ]
  exact hθU k

theorem wc_smooth_pair_local_equations : ∀ (K : Type u) [Field K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ z : Z, ∃ W : X.Opens, i z ∈ W ∧ IsAffineOpen W ∧ ∀ (ZW : Scheme.{u}) (iW : ZW ⟶ W) (gW : ZW ⟶ Z), IsPullback gW iW i W.ι → ∃ h : Fin c → Γ(W, ⊤), wcEtCutOut iW h :=
by
  classical

  have s6 : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) (W₀ : X.Opens), IsAffineOpen W₀ → ∀ z : Z, i z ∈ W₀ → ∃ p : Ideal Γ(X, W₀), p.IsPrime ∧ (∀ a : Γ(X, W₀), (i.app W₀).hom a = 0 → a ∈ p) ∧ ∀ f : Γ(X, W₀), f ∉ p → i z ∈ X.basicOpen f := by
    intro X Z i W₀ hW₀ z hz
    let x : W₀ := ⟨i z, hz⟩
    have key : ∀ a : Γ(X, W₀), a ∉ (hW₀.primeIdealOf x).asIdeal ↔ i z ∈ X.basicOpen a := by
      intro a
      have h1 := hW₀.fromSpec_primeIdealOf x
      have h2 := hW₀.fromSpec_preimage_basicOpen a
      have h3 : hW₀.fromSpec (hW₀.primeIdealOf x) ∈ X.basicOpen a ↔
          hW₀.primeIdealOf x ∈ PrimeSpectrum.basicOpen a := by
        rw [← h2]; rfl
      rw [h1] at h3
      rw [← PrimeSpectrum.mem_basicOpen]
      exact h3.symm
    refine ⟨(hW₀.primeIdealOf x).asIdeal, inferInstance, ?_, fun f hf => (key f).mp hf⟩
    intro a ha
    by_contra hna
    have h4 : z ∈ i ⁻¹ᵁ X.basicOpen a := (key a).mp hna
    rw [Scheme.Hom.preimage_basicOpen, ha, Scheme.basicOpen_zero] at h4
    exact h4

  have s2c : ∀ {A : Type u} [CommRing A] (I p : Ideal A) [p.IsPrime], I ≤ p → Function.Bijective (LinearMap.baseChange p.ResidueField I.toCotangent) := by
    intro A _ I p _ hI
    rw [LinearMap.baseChange_eq_ltensor]
    refine ⟨?_, LinearMap.lTensor_surjective _ (Ideal.toCotangent_surjective I)⟩
    have hex := lTensor_exact p.ResidueField (LinearMap.exact_subtype_ker_map I.toCotangent)
      (Ideal.toCotangent_surjective I)
    have hzero : LinearMap.lTensor p.ResidueField (LinearMap.ker I.toCotangent).subtype = 0 := by
      apply TensorProduct.ext'
      intro a x
      simp only [LinearMap.lTensor_tmul, Submodule.coe_subtype, LinearMap.zero_apply]
      obtain ⟨⟨y, hyI⟩, hy⟩ := x
      have hy2 : y ∈ I ^ 2 := (Ideal.toCotangent_eq_zero I ⟨y, hyI⟩).mp hy
      rw [pow_two] at hy2
      show a ⊗ₜ[A] (⟨y, hyI⟩ : I) = 0
      clear hy
      induction hy2 using Submodule.mul_induction_on' with
      | mem_mul_mem u hu w hw =>
        have e : (⟨u * w, hyI⟩ : I) = u • (⟨w, hw⟩ : I) := rfl
        rw [e, ← TensorProduct.smul_tmul, Algebra.smul_def,
          Ideal.algebraMap_residueField_eq_zero.mpr (hI hu), zero_mul, TensorProduct.zero_tmul]
      | add y1 h1 y2 h2 ih1 ih2 =>
        have e : (⟨y1 + y2, hyI⟩ : I) = ⟨y1, Ideal.mul_le_left h1⟩ + ⟨y2, Ideal.mul_le_left h2⟩ := rfl
        rw [e, TensorProduct.tmul_add, ih1, ih2, add_zero]
    rw [injective_iff_map_eq_zero]
    intro t ht
    obtain ⟨s, rfl⟩ := (hex t).mp ht
    rw [hzero, LinearMap.zero_apply]

  have s5 : ∀ {X Z ZW : Scheme.{u}} (i : Z ⟶ X) (U : X.Opens) (iW : ZW ⟶ U) (gW : ZW ⟶ Z), IsPullback gW iW i U.ι → RingHom.ker iW.appTop.hom = Ideal.map U.topIso.inv.hom (RingHom.ker (i.app U).hom) := by
    intro X Z ZW i U iW gW hsq
    have hinj : ∀ {A B : CommRingCat.{u}} (φ : A ⟶ B) [IsIso φ], Function.Injective φ.hom := by
      intro A B φ _ a b hab
      have := congrArg (inv φ).hom hab
      simpa using this
    have hiso : ∀ {A B : CommRingCat.{u}} (φ : A ⟶ B) [IsIso φ] (a : A), φ.hom a = 0 ↔ a = 0 :=
      fun φ _ a => ⟨fun h => hinj φ (by rw [h, map_zero]), fun h => by rw [h, map_zero]⟩
    have hflip := (isPullback_morphismRestrict i U).flip
    set e := hsq.isoIsPullback _ _ hflip with he_def
    have he : e.hom ≫ (i ∣_ U) = iW :=
      hsq.isoIsPullback_hom_snd _ _ hflip
    haveI : IsIso e.hom.appTop := ⟨⟨e.inv.appTop, by
        rw [← Scheme.Hom.comp_appTop, e.inv_hom_id]; rfl, by
        rw [← Scheme.Hom.comp_appTop, e.hom_inv_id]; rfl⟩⟩
    have general : ∀ (V : X.Opens) (hV : V = U) (y : Γ(X, V)), (i.app V).hom y = 0 ↔
        (i.app U).hom ((X.presheaf.map (eqToHom hV.symm).op).hom y) = 0 := by
      rintro V rfl y
      simp
    have hpm : ∀ (Y : Scheme.{u}) (V V' : Y.Opens) (g : V' ⟶ V) [IsIso g] (y : Γ(Y, V)),
        (Y.presheaf.map g.op).hom y = 0 ↔ y = 0 := fun Y V V' g _ y => hiso _ y
    have key : ∀ x : Γ(U, ⊤), iW.appTop.hom x = 0 ↔ (i.app U).hom (U.topIso.hom.hom x) = 0 := by
      intro x
      rw [← he, Scheme.Hom.comp_appTop, CommRingCat.comp_apply, hiso, morphismRestrict_appTop]
      erw [CommRingCat.comp_apply, hpm]
      rw [Scheme.Opens.topIso_hom]
      exact general _ (Scheme.Opens.ι_image_top U) x
    apply le_antisymm
    · intro x hx
      rw [RingHom.mem_ker, key] at hx
      have hx' : U.topIso.inv.hom (U.topIso.hom.hom x) = x :=
        congrArg (fun φ => CommRingCat.Hom.hom φ x) U.topIso.hom_inv_id
      rw [← hx']
      exact Ideal.mem_map_of_mem _ hx
    · rw [Ideal.map_le_iff_le_comap]
      intro y hy
      rw [Ideal.mem_comap, RingHom.mem_ker, key]
      have hy' : U.topIso.hom.hom (U.topIso.inv.hom y) = y :=
        congrArg (fun φ => CommRingCat.Hom.hom φ y) U.topIso.inv_hom_id
      rw [hy']
      exact hy

  have s4 : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (W₀ : X.Opens), IsAffineOpen W₀ → ∀ {c : ℕ} (h : Fin c → Γ(X, W₀)) (f : Γ(X, W₀)), (∀ k, (i.app W₀).hom (h k) = 0) → (∀ y : Γ(X, W₀), (i.app W₀).hom y = 0 → ∃ N : ℕ, f ^ N * y ∈ Ideal.span (Set.range h)) → RingHom.ker (i.app (X.basicOpen f)).hom = Ideal.span (Set.range (fun k => (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (h k))) := by
    intro X Z i _ W₀ hW₀ c h f hh hf
    set ι : X.basicOpen f ⟶ W₀ := homOfLE (X.basicOpen_le f) with hι
    set res := (X.presheaf.map ι.op).hom with hres
    let ιZ : i ⁻¹ᵁ X.basicOpen f ⟶ i ⁻¹ᵁ W₀ := (TopologicalSpace.Opens.map i.base).map ι
    set resZ := (Z.presheaf.map ιZ.op).hom with hresZ
    have hnat : ∀ y, (i.app (X.basicOpen f)).hom (res y) = resZ ((i.app W₀).hom y) := by
      intro y
      have := congrArg (fun φ => φ.hom y) (i.naturality ι.op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this
    letI : Algebra Γ(X, W₀) Γ(X, X.basicOpen f) := res.toAlgebra
    haveI hloc : IsLocalization.Away f Γ(X, X.basicOpen f) := hW₀.isLocalization_basicOpen f
    letI : Algebra Γ(Z, i ⁻¹ᵁ W₀) Γ(Z, i ⁻¹ᵁ X.basicOpen f) := resZ.toAlgebra
    haveI hlocZ : IsLocalization.Away ((i.app W₀).hom f) Γ(Z, i ⁻¹ᵁ X.basicOpen f) :=
      (hW₀.preimage i).isLocalization_of_eq_basicOpen _ ιZ (i.preimage_basicOpen f)
    apply le_antisymm
    · intro a ha
      rw [RingHom.mem_ker] at ha
      obtain ⟨k, y, hy⟩ := IsLocalization.Away.surj f a
      change a * res f ^ k = res y at hy
      have h1 : resZ ((i.app W₀).hom y) = 0 := by
        rw [← hnat, ← hy, map_mul, ha, zero_mul]
      have h2 := (IsLocalization.map_eq_zero_iff (Submonoid.powers ((i.app W₀).hom f))
        Γ(Z, i ⁻¹ᵁ X.basicOpen f) ((i.app W₀).hom y)).mp h1
      obtain ⟨⟨m, j, rfl⟩, hm⟩ := h2
      have h3 : (i.app W₀).hom (f ^ j * y) = 0 := by
        rw [map_mul, map_pow]; exact hm
      obtain ⟨N, hN⟩ := hf _ h3
      have h4 : res (f ^ N * (f ^ j * y)) ∈ Ideal.span (Set.range (fun k => res (h k))) := by
        have := Ideal.mem_map_of_mem res hN
        rwa [Ideal.map_span, ← Set.range_comp] at this
      have hu : IsUnit (res f) := IsLocalization.Away.algebraMap_isUnit (S := Γ(X, X.basicOpen f)) f
      have e : res (f ^ N * (f ^ j * y)) = a * res f ^ (N + j + k) := by
        rw [map_mul, map_mul, ← hy, map_pow, map_pow]; ring
      rw [e] at h4
      exact (Ideal.mul_unit_mem_iff_mem _ (hu.pow _)).mp h4
    · rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      show (i.app (X.basicOpen f)).hom (res (h k)) = 0
      rw [hnat, hh, map_zero]

  have s2a : ∀ {R A B : Type u} [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra A B] [Algebra R B] [IsScalarTower R A B] (n m : ℕ), Function.Surjective (algebraMap A B) → Algebra.IsStandardSmoothOfRelativeDimension n R A → Algebra.IsStandardSmoothOfRelativeDimension m R B → Nontrivial B → Nonempty ((Fin n → B) ≃ₗ[A] (RingHom.ker (algebraMap A B)).Cotangent × (Fin m → B)) := by
    intro R A B _ _ _ _ _ _ _ n m hs hA hB hnt
    haveI := hA.isStandardSmooth
    haveI := hB.isStandardSmooth
    haveI : Nontrivial A := (algebraMap A B).domain_nontrivial
    obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := R) hs).mp inferInstance
    let g : TensorProduct A B Ω[A⁄R] →ₗ[A] Ω[B⁄R] :=
      (KaehlerDifferential.mapBaseChange R A B).restrictScalars A
    have hex' : Function.Exact (KaehlerDifferential.kerCotangentToTensor R A B) g :=
      KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R A B hs
    have hgs : Function.Surjective g := KaehlerDifferential.mapBaseChange_surjective R A B hs
    obtain ⟨e, -⟩ := hex'.splitInjectiveEquiv hgs ⟨l, hl⟩
    haveI : Module.Free A Ω[A⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    haveI : Module.Free B Ω[B⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hrA : Module.rank A Ω[A⁄R] = n := hA.rank_kaehlerDifferential
    have hrB : Module.rank B Ω[B⁄R] = m := hB.rank_kaehlerDifferential
    haveI : Module.Finite A Ω[A⁄R] :=
      Module.rank_lt_aleph0_iff.mp (by rw [hrA]; exact Cardinal.natCast_lt_aleph0)
    haveI : Module.Finite B Ω[B⁄R] :=
      Module.rank_lt_aleph0_iff.mp (by rw [hrB]; exact Cardinal.natCast_lt_aleph0)
    let bA := Module.finBasisOfFinrankEq A Ω[A⁄R] (Module.finrank_eq_of_rank_eq hrA)
    let bB := Module.finBasisOfFinrankEq B Ω[B⁄R] (Module.finrank_eq_of_rank_eq hrB)
    let bT := Algebra.TensorProduct.basis B bA
    let eT : TensorProduct A B Ω[A⁄R] ≃ₗ[A] (Fin n → B) := bT.equivFun.restrictScalars A
    let eB : Ω[B⁄R] ≃ₗ[A] (Fin m → B) := bB.equivFun.restrictScalars A
    exact ⟨eT.symm.trans (e.trans (LinearEquiv.prodCongr (LinearEquiv.refl _ _) eB))⟩

  have s2b : ∀ {A B : Type u} [CommRing A] [CommRing B] [Algebra A B] (M : Type u) [AddCommGroup M] [Module A M] (n m : ℕ), Function.Surjective (algebraMap A B) → ∀ (p : Ideal A) [p.IsPrime], RingHom.ker (algebraMap A B) ≤ p → ((Fin n → B) ≃ₗ[A] M × (Fin m → B)) → Module.Finite p.ResidueField (TensorProduct A p.ResidueField M) ∧ Module.finrank p.ResidueField (TensorProduct A p.ResidueField M) = n - m := by
    intro A B _ _ _ M _ _ n m hs p _ hI e
    let τ : B →+* p.ResidueField := (RingHom.liftOfSurjective (algebraMap A B) hs)
      ⟨algebraMap A p.ResidueField, by rw [Ideal.ker_algebraMap_residueField]; exact hI⟩
    have hτ : ∀ y, τ (algebraMap A B y) = algebraMap A p.ResidueField y := fun y =>
      RingHom.liftOfRightInverse_comp_apply _ _ _ _ y
    let τA : B →ₐ[A] p.ResidueField := { τ with commutes' := hτ }
    let σ : TensorProduct A p.ResidueField B →ₐ[p.ResidueField] p.ResidueField :=
      Algebra.TensorProduct.lift (AlgHom.id p.ResidueField p.ResidueField) τA
        (fun _ _ => Commute.all _ _)
    let ι : p.ResidueField →ₗ[p.ResidueField] TensorProduct A p.ResidueField B :=
      (Algebra.TensorProduct.includeLeft : p.ResidueField →ₐ[p.ResidueField]
        TensorProduct A p.ResidueField B).toLinearMap
    have hσι : ∀ a, σ (ι a) = a := by
      intro a
      simp only [σ, ι, AlgHom.toLinearMap_apply, Algebra.TensorProduct.includeLeft_apply,
        Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, map_one, mul_one]
    have hinj : Function.Injective ι := fun a b hab => by
      rw [← hσι a, ← hσι b, hab]
    have hsurj : Function.Surjective ι := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => exact ⟨0, map_zero ι⟩
      | tmul a b =>
        obtain ⟨y, rfl⟩ := hs b
        refine ⟨y • a, ?_⟩
        simp only [ι, AlgHom.toLinearMap_apply, Algebra.TensorProduct.includeLeft_apply]
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
      | add x y hx hy =>
        obtain ⟨a, rfl⟩ := hx
        obtain ⟨b, rfl⟩ := hy
        exact ⟨a + b, map_add ι a b⟩
    let eB : TensorProduct A p.ResidueField B ≃ₗ[p.ResidueField] p.ResidueField :=
      (LinearEquiv.ofBijective ι ⟨hinj, hsurj⟩).symm
    let eN : ∀ k : ℕ, TensorProduct A p.ResidueField (Fin k → B) ≃ₗ[p.ResidueField]
        (Fin k → p.ResidueField) := fun k =>
      (TensorProduct.piRight A p.ResidueField p.ResidueField (fun _ : Fin k => B)).trans
        (LinearEquiv.piCongrRight (fun _ => eB))
    let F : (Fin n → p.ResidueField) ≃ₗ[p.ResidueField]
        TensorProduct A p.ResidueField M × (Fin m → p.ResidueField) :=
      (eN n).symm.trans ((LinearEquiv.baseChange A p.ResidueField _ _ e).trans
        ((TensorProduct.prodRight A p.ResidueField p.ResidueField M (Fin m → B)).trans
          (LinearEquiv.prodCongr (LinearEquiv.refl _ _) (eN m))))
    have hfin : Module.Finite p.ResidueField (TensorProduct A p.ResidueField M) :=
      Module.Finite.of_surjective ((LinearMap.fst _ _ _).comp F.toLinearMap)
        (fun x => ⟨F.symm (x, 0), by simp⟩)
    refine ⟨hfin, ?_⟩
    have h := F.finrank_eq
    rw [Module.finrank_prod, Module.finrank_fin_fun, Module.finrank_fin_fun] at h
    omega

  have s3 : ∀ {A : Type u} [CommRing A] (I : Ideal A), I.FG → ∀ (p : Ideal A) [p.IsPrime] (c : ℕ), Module.finrank p.ResidueField (TensorProduct A p.ResidueField I) ≤ c → ∃ h : Fin c → A, (∀ k, h k ∈ I) ∧ ∃ f ∉ p, ∀ y ∈ I, ∃ N : ℕ, f ^ N * y ∈ Ideal.span (Set.range h) := by
    intro A _ I hFG p hp c hc
    haveI : Module.Finite A I := Module.Finite.iff_fg.mpr hFG
    let v : I → TensorProduct A p.ResidueField I := fun y => (1 : p.ResidueField) ⊗ₜ[A] y
    have hspan : Submodule.span p.ResidueField (Set.range v) = ⊤ := by
      rw [eq_top_iff]
      intro t _
      induction t using TensorProduct.induction_on with
      | zero => exact zero_mem _
      | tmul a y =>
        have e : a ⊗ₜ[A] y = a • v y := by
          simp only [v, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [e]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨y, rfl⟩)
      | add x y hx hy => exact add_mem (hx trivial) (hy trivial)
    obtain ⟨κ', a, ha, hspan', hli⟩ := exists_linearIndependent' p.ResidueField v
    rw [hspan] at hspan'
    let bas := Module.Basis.mk hli (by rw [hspan'])
    haveI : Finite κ' := Module.Finite.finite_basis bas
    letI : Fintype κ' := Fintype.ofFinite κ'
    have hcard : Fintype.card κ' ≤ Fintype.card (Fin c) := by
      rw [Fintype.card_fin, ← Module.finrank_eq_card_basis bas]; exact hc
    obtain ⟨emb⟩ := Function.Embedding.nonempty_of_card_le hcard
    let h' : Fin c → I := fun j => if hj : ∃ k, emb k = j then a hj.choose else 0
    have hh' : ∀ k, h' (emb k) = a k := by
      intro k
      have hj : ∃ k', emb k' = emb k := ⟨k, rfl⟩
      simp only [h', dif_pos hj]
      rw [emb.injective hj.choose_spec]
    let J : Submodule A I := Submodule.span A (Set.range h')
    have hQ : Subsingleton (TensorProduct A p.ResidueField (I ⧸ J)) := by
      have hsurj : Function.Surjective (LinearMap.baseChange p.ResidueField J.mkQ) := by
        rw [LinearMap.baseChange_eq_ltensor]
        exact LinearMap.lTensor_surjective _ (Submodule.mkQ_surjective J)
      have hzero : LinearMap.baseChange p.ResidueField J.mkQ = 0 := by
        have hle : Submodule.span p.ResidueField (Set.range (v ∘ a)) ≤
            LinearMap.ker (LinearMap.baseChange p.ResidueField J.mkQ) := by
          rw [Submodule.span_le]
          rintro _ ⟨k, rfl⟩
          simp only [Function.comp_apply, v, SetLike.mem_coe, LinearMap.mem_ker,
            LinearMap.baseChange_tmul, Submodule.mkQ_apply]
          rw [(Submodule.Quotient.mk_eq_zero J).mpr (by rw [← hh']; exact Submodule.subset_span ⟨_, rfl⟩),
            TensorProduct.tmul_zero]
        rw [hspan'] at hle
        exact LinearMap.ker_eq_top.mp (eq_top_iff.mpr hle)
      refine ⟨fun x y => ?_⟩
      obtain ⟨x', rfl⟩ := hsurj x
      obtain ⟨y', rfl⟩ := hsurj y
      rw [hzero, LinearMap.zero_apply, LinearMap.zero_apply]
    have hns : (⟨p, hp⟩ : PrimeSpectrum A) ∉ Module.support A (I ⧸ J) := by
      rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct, not_nontrivial_iff_subsingleton]
      exact hQ
    haveI := Module.notMem_support_iff.mp hns
    obtain ⟨f, hfp, hsub⟩ := LocalizedModule.exists_subsingleton_away (M := I ⧸ J) p
    refine ⟨fun j => (h' j : A), fun j => (h' j).2, f, hfp, ?_⟩
    intro y hy
    have h0 : LocalizedModule.mkLinearMap (Submonoid.powers f) (I ⧸ J) (J.mkQ ⟨y, hy⟩) = 0 :=
      Subsingleton.elim (α := LocalizedModule.Away f (I ⧸ J)) _ _
    obtain ⟨⟨s, N, rfl⟩, hs⟩ := (IsLocalizedModule.eq_zero_iff (Submonoid.powers f)
      (LocalizedModule.mkLinearMap (Submonoid.powers f) (I ⧸ J))).mp h0
    refine ⟨N, ?_⟩
    have hs' : (f ^ N) • (⟨y, hy⟩ : I) ∈ J := by
      rw [← Submodule.Quotient.mk_eq_zero]
      exact hs
    have hmap := Submodule.mem_map_of_mem (f := I.subtype) hs'
    rw [Submodule.map_span, ← Set.range_comp] at hmap
    exact hmap

  have s1 : ∀ (K : Type u) [Field K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n m : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension m (i ≫ fX)] (z : Z), ∃ W₁ : X.Opens, IsAffineOpen W₁ ∧ i z ∈ W₁ ∧ RingHom.IsStandardSmoothOfRelativeDimension n (fX.appTop ≫ X.presheaf.map (homOfLE (le_top : W₁ ≤ ⊤)).op).hom ∧ RingHom.IsStandardSmoothOfRelativeDimension m ((i.app W₁).hom.comp (fX.appTop ≫ X.presheaf.map (homOfLE (le_top : W₁ ≤ ⊤)).op).hom) := by
    intro K _ X Z fX n m _ i _ _ z
    have hchart : ∀ {Y : Scheme.{u}} (g : Y ⟶ Spec (.of K)) (k : ℕ) [SmoothOfRelativeDimension k g]
        (y : Y), ∃ V : Y.Opens, IsAffineOpen V ∧ y ∈ V ∧ RingHom.IsStandardSmoothOfRelativeDimension k
          (g.appTop ≫ Y.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom := by
      intro Y g k _ y
      obtain ⟨U, hU, V, hV, hyV, e, hstd⟩ :=
        SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (f := g) (n := k) y
      have hUt : U = ⊤ := by
        rw [eq_top_iff]
        intro q _
        haveI : Subsingleton (Spec (.of K)) := inferInstanceAs (Subsingleton (PrimeSpectrum K))
        rw [Subsingleton.elim q (g y)]
        exact e hyV
      subst hUt
      exact ⟨V, hV, hyV, hstd⟩
    have hres : ∀ {Y : Scheme.{u}} (U V W : Y.Opens) (h1 : W ≤ V) (h2 : V ≤ U),
        (Y.presheaf.map (homOfLE h1).op).hom.comp (Y.presheaf.map (homOfLE h2).op).hom =
          (Y.presheaf.map (homOfLE (h1.trans h2)).op).hom := by
      intros
      rw [← CommRingCat.hom_comp, ← Functor.map_comp]
      rfl
    obtain ⟨V₁, hV₁, hx1, hstd1⟩ := hchart fX n (i z)
    obtain ⟨V₂, hV₂, hz2, hstd2⟩ := hchart (i ≫ fX) m z
    obtain ⟨g₁, g₂, hg, hzg⟩ := exists_basicOpen_le_affine_inter (hV₁.preimage i) hV₂ z ⟨hx1, hz2⟩
    obtain ⟨a, ha⟩ := i.app_surjective V₁ hV₁ g₁
    have hpre : i ⁻¹ᵁ X.basicOpen a = Z.basicOpen g₂ := by
      rw [Scheme.Hom.preimage_basicOpen, ha, hg]
    have hle2 : i ⁻¹ᵁ X.basicOpen a ≤ V₂ := by
      rw [hpre]; exact Z.basicOpen_le g₂
    have hzW : z ∈ i ⁻¹ᵁ X.basicOpen a := by
      rw [hpre, ← hg]; exact hzg
    refine ⟨X.basicOpen a, hV₁.basicOpen a, hzW, ?_, ?_⟩
    · have h0 := @RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway _ _ _ _
        (X.presheaf.map (homOfLE (X.basicOpen_le a)).op).hom.toAlgebra a
        (hV₁.isLocalization_of_eq_basicOpen a (homOfLE (X.basicOpen_le a)) rfl)
      have h1 := h0.comp hstd1
      rw [Nat.zero_add] at h1
      have e : (X.presheaf.map (homOfLE (X.basicOpen_le a)).op).hom.comp
          (fX.appTop ≫ X.presheaf.map (homOfLE (le_top : V₁ ≤ ⊤)).op).hom =
          (fX.appTop ≫ X.presheaf.map (homOfLE (le_top : X.basicOpen a ≤ ⊤)).op).hom := by
        rw [CommRingCat.hom_comp, CommRingCat.hom_comp, ← RingHom.comp_assoc, hres]
      rw [← e]
      exact h1
    · have h0 := @RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway _ _ _ _
        (Z.presheaf.map (homOfLE hle2).op).hom.toAlgebra g₂
        (hV₂.isLocalization_of_eq_basicOpen g₂ (homOfLE hle2) hpre)
      have h1 := h0.comp hstd2
      rw [Nat.zero_add] at h1
      have e : (Z.presheaf.map (homOfLE hle2).op).hom.comp
          ((i ≫ fX).appTop ≫ Z.presheaf.map (homOfLE (le_top : V₂ ≤ ⊤)).op).hom =
          (i.app (X.basicOpen a)).hom.comp
            (fX.appTop ≫ X.presheaf.map (homOfLE (le_top : X.basicOpen a ≤ ⊤)).op).hom := by
        rw [CommRingCat.hom_comp, ← RingHom.comp_assoc, hres, ← CommRingCat.hom_comp,
          ← CommRingCat.hom_comp, Category.assoc, Scheme.Hom.naturality, Scheme.Hom.comp_appTop,
          Category.assoc]
        rfl
      rw [← e]
      exact h1

  intro K _ X Z fX n c _ i _ _ hcn z
  obtain ⟨W₁, hW₁, hx, hA, hB⟩ := s1 K X Z fX n (n - c) i z
  letI : Algebra Γ(Spec (.of K), ⊤) Γ(X, W₁) :=
    (fX.appTop ≫ X.presheaf.map (homOfLE (le_top : W₁ ≤ ⊤)).op).hom.toAlgebra
  letI : Algebra Γ(X, W₁) Γ(Z, i ⁻¹ᵁ W₁) := (i.app W₁).hom.toAlgebra
  letI : Algebra Γ(Spec (.of K), ⊤) Γ(Z, i ⁻¹ᵁ W₁) :=
    ((i.app W₁).hom.comp (fX.appTop ≫ X.presheaf.map (homOfLE (le_top : W₁ ≤ ⊤)).op).hom).toAlgebra
  haveI : IsScalarTower Γ(Spec (.of K), ⊤) Γ(X, W₁) Γ(Z, i ⁻¹ᵁ W₁) :=
    IsScalarTower.of_algebraMap_eq' rfl
  have hA' : Algebra.IsStandardSmoothOfRelativeDimension n Γ(Spec (.of K), ⊤) Γ(X, W₁) := hA
  have hB' : Algebra.IsStandardSmoothOfRelativeDimension (n - c) Γ(Spec (.of K), ⊤)
      Γ(Z, i ⁻¹ᵁ W₁) := hB
  have hsurj : Function.Surjective (algebraMap Γ(X, W₁) Γ(Z, i ⁻¹ᵁ W₁)) :=
    i.app_surjective W₁ hW₁
  have hz : z ∈ i ⁻¹ᵁ W₁ := hx
  have hnt : Nontrivial Γ(Z, i ⁻¹ᵁ W₁) := by
    by_contra hcon
    rw [not_nontrivial_iff_subsingleton] at hcon
    have h1 := Z.basicOpen_of_isUnit (isUnit_one : IsUnit (1 : Γ(Z, i ⁻¹ᵁ W₁)))
    rw [Subsingleton.elim (1 : Γ(Z, i ⁻¹ᵁ W₁)) 0, Scheme.basicOpen_zero] at h1
    rw [← h1] at hz
    exact hz
  obtain ⟨p, hp, hker, hbo⟩ := s6 i W₁ hW₁ z hx
  have hIp : RingHom.ker (algebraMap Γ(X, W₁) Γ(Z, i ⁻¹ᵁ W₁)) ≤ p :=
    fun a ha => hker a (RingHom.mem_ker.mp ha)
  obtain ⟨e⟩ := s2a n (n - c) hsurj hA' hB' hnt
  obtain ⟨-, hrk⟩ := s2b _ n (n - c) hsurj p hIp e
  have hbij := s2c (RingHom.ker (algebraMap Γ(X, W₁) Γ(Z, i ⁻¹ᵁ W₁))) p hIp
  have hrank := (LinearEquiv.ofBijective _ hbij).finrank_eq
  rw [hrk, Nat.sub_sub_self hcn] at hrank
  haveI : Algebra.IsStandardSmooth Γ(Spec (.of K), ⊤) Γ(X, W₁) := hA'.isStandardSmooth
  haveI : Algebra.IsStandardSmooth Γ(Spec (.of K), ⊤) Γ(Z, i ⁻¹ᵁ W₁) := hB'.isStandardSmooth
  have hFG : (RingHom.ker (algebraMap Γ(X, W₁) Γ(Z, i ⁻¹ᵁ W₁))).FG := by
    have := Algebra.FinitePresentation.ker_fG_of_surjective
      (IsScalarTower.toAlgHom Γ(Spec (.of K), ⊤) Γ(X, W₁) Γ(Z, i ⁻¹ᵁ W₁)) hsurj
    exact this
  obtain ⟨h, hhI, f, hfp, hf⟩ := s3 _ hFG p c hrank.le
  have hker4 := s4 i W₁ hW₁ h f
    (fun k => RingHom.mem_ker.mp (hhI k)) (fun y hy => hf y (RingHom.mem_ker.mpr hy))
  refine ⟨X.basicOpen f, hbo f hfp, hW₁.basicOpen f, ?_⟩
  intro ZW iW gW hsq
  refine ⟨fun k => (X.basicOpen f).topIso.inv.hom
      ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (h k)),
    hW₁.basicOpen f, MorphismProperty.of_isPullback hsq inferInstance, ?_⟩
  rw [s5 i _ iW gW hsq, hker4, Ideal.map_span, ← Set.range_comp]
  rfl

theorem wc_et_thom_class_restrict : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (T : wcEtLocThom K ℓ), wcEtThomGL T → wcEtThomNat T → ∀ {X Z X' Z' : Scheme.{u}} (fX : X ⟶ Spec (.of K)) (fX' : X' ⟶ Spec (.of K)) (f : X' ⟶ X), f ≫ fX = fX' → ∀ (n n' c : ℕ) [SmoothOfRelativeDimension n fX] [SmoothOfRelativeDimension n' fX'] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)] (i' : Z' ⟶ X') [SmoothOfRelativeDimension (n' - c) (i' ≫ fX')], c ≤ n → c ≤ n' → ∀ (g : Z' ⟶ Z), IsPullback g i' i f → ∀ (D : wcEtPullData i ℓ) (Df : wcEtPullData f ℓ) (D' : wcEtPullData i' ℓ) (γ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D) → ∀ θ : wcEtSuppExt D (2 * c), wcEtIsThom T fX D c θ → wcEtIsThom T fX' D' c (wcEtSuppRestr D Df D' γ (2 * c) θ) :=
by
  classical
  intro K _ _ ℓ _ hℓ T hTa hTb X Z X' Z' fX fX' f hf n n' c _ _ i _ _ i' _ hcn hcn' g hsq D Df D'
    γ hγ θ hθ
  haveI : IsClosedImmersion i' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance

  have hsm0 : ∀ {A B C : Scheme.{u}} (ψ : A ⟶ B) [IsOpenImmersion ψ] (φ : B ⟶ C) (k : ℕ)
      [SmoothOfRelativeDimension k φ], SmoothOfRelativeDimension k (ψ ≫ φ) := by
    intro A B C ψ _ φ k _
    have := smoothOfRelativeDimension_comp 0 k ψ φ
    rwa [Nat.zero_add] at this

  have hlift : ∀ {P Q ZW₀ Z₀ W₀ X₀ : Scheme.{u}} {gW₀ : ZW₀ ⟶ Z₀} {iW₀ : ZW₀ ⟶ W₀}
      {i₀ : Z₀ ⟶ X₀} {ι₀ : W₀ ⟶ X₀}, IsPullback gW₀ iW₀ i₀ ι₀ → ∀ {a : P ⟶ Z₀} {b : P ⟶ Q}
      {k : Q ⟶ X₀}, IsPullback a b i₀ k → ∀ (φ : Q ⟶ W₀), φ ≫ ι₀ = k →
      ∃ a' : P ⟶ ZW₀, IsPullback a' b iW₀ φ := by
    intro P Q ZW₀ Z₀ W₀ X₀ gW₀ iW₀ i₀ ι₀ hR a b k hO φ hφ
    refine ⟨hR.lift a (b ≫ φ) (by rw [hO.w, Category.assoc, hφ]), ?_⟩
    refine IsPullback.of_right ?_ (hR.lift_snd _ _ _) hR
    rw [hR.lift_fst, hφ]
    exact hO

  intro W' ZW' iW' gW' hsq' DW' EW' γW' hadm' h' hcut'
  haveI hW'aff : IsAffine (W' : Scheme.{u}) := hcut'.1
  haveI : IsClosedImmersion iW' := hcut'.2.1
  haveI : IsOpenImmersion gW' :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq'.flip inferInstance
  haveI S1 : SmoothOfRelativeDimension n' (W'.ι ≫ fX') := hsm0 W'.ι fX' n'
  haveI S2 : SmoothOfRelativeDimension (n' - c) (iW' ≫ W'.ι ≫ fX') := by
    have e : gW' ≫ i' ≫ fX' = iW' ≫ W'.ι ≫ fX' := by rw [reassoc_of% hsq'.w]
    rw [← e]
    exact hsm0 gW' (i' ≫ fX') (n' - c)
  have hsmV : ∀ {V ZV : Scheme.{u}} (ψ : V ⟶ (W' : Scheme.{u})) [IsOpenImmersion ψ]
      (a : ZV ⟶ ZW') (b : ZV ⟶ V), IsPullback a b iW' ψ →
      SmoothOfRelativeDimension (n' - c) (b ≫ ψ ≫ W'.ι ≫ fX') := by
    intro V ZV ψ _ a b hab
    haveI : IsOpenImmersion a :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hab.flip inferInstance
    have e : a ≫ iW' ≫ W'.ι ≫ fX' = b ≫ ψ ≫ W'.ι ≫ fX' := by rw [reassoc_of% hab.w]
    rw [← e]
    exact hsm0 a (iW' ≫ W'.ι ≫ fX') (n' - c)
  have gcW' : wcEtGoodChart K (W'.ι ≫ fX') iW' c h' := ⟨n', hcn', S1, S2, hcut'⟩

  rw [← sub_eq_zero]
  refine wc_et_thom_supp_local_injective K ℓ hℓ _ _ (W'.ι ≫ fX') n' c iW' hcn' DW' _ ?_
  intro z''

  have hz : i (g (gW' z'')) = f (W'.ι (iW' z'')) := by
    have h1 : (gW' ≫ g ≫ i) z'' = (iW' ≫ W'.ι ≫ f) z'' := by
      rw [hsq.w, reassoc_of% hsq'.w]
    exact h1
  obtain ⟨W, hzW, -, hchart⟩ :=
    wc_smooth_pair_local_equations K X Z fX n c i hcn (g (gW' z''))
  obtain ⟨ZW, iW, gW, hsqW⟩ : ∃ (ZW : Scheme.{u}) (iW : ZW ⟶ (W : Scheme.{u})) (gW : ZW ⟶ Z),
      IsPullback gW iW i W.ι :=
    ⟨_, _, _, IsPullback.of_hasPullback i W.ι⟩
  obtain ⟨h, hcutW⟩ := hchart ZW iW gW hsqW
  haveI : IsClosedImmersion iW := hcutW.2.1
  haveI : IsOpenImmersion gW :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsqW.flip inferInstance
  haveI SW1 : SmoothOfRelativeDimension n (W.ι ≫ fX) := hsm0 W.ι fX n
  haveI SW2 : SmoothOfRelativeDimension (n - c) (iW ≫ W.ι ≫ fX) := by
    have e : gW ≫ i ≫ fX = iW ≫ W.ι ≫ fX := by rw [reassoc_of% hsqW.w]
    rw [← e]
    exact hsm0 gW (i ≫ fX) (n - c)
  have gcW : wcEtGoodChart K (W.ι ≫ fX) iW c h := ⟨n, hcn, SW1, SW2, hcutW⟩
  obtain ⟨DW⟩ := wc_et_zmod_pull_data_exists iW ℓ
  obtain ⟨EW⟩ := wc_et_zmod_pull_data_exists W.ι ℓ
  obtain ⟨γW, hγW, -⟩ := wc_et_closed_supp_base_change i W.ι iW gW hsqW D EW DW
  have hθW := hθ W ZW iW gW hsqW DW EW γW hγW h hcutW

  have hxO : iW' z'' ∈ (W'.ι ≫ f) ⁻¹ᵁ W := by
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.comp_apply, ← hz]
    exact hzW
  obtain ⟨t, hUO, hxU⟩ := (isAffineOpen_top (W' : Scheme.{u})).exists_basicOpen_le
    (V := (W'.ι ≫ f) ⁻¹ᵁ W) ⟨iW' z'', hxO⟩ trivial
  haveI hUaff : IsAffine ((W' : Scheme.{u}).basicOpen t) := (isAffineOpen_top _).basicOpen t
  have hrange : Set.range (((W' : Scheme.{u}).basicOpen t).ι ≫ W'.ι ≫ f) ⊆ Set.range W.ι := by
    rintro _ ⟨y, rfl⟩
    rw [Scheme.Opens.range_ι]
    have hy := hUO y.2
    rw [Scheme.Hom.mem_preimage] at hy
    exact hy
  obtain ⟨U, j₀, hj₀, hUaff', hxj₀, φ₀, hφ₀⟩ : ∃ (U : Scheme.{u}) (j₀ : U ⟶ (W' : Scheme.{u})),
      IsOpenImmersion j₀ ∧ IsAffine U ∧ iW' z'' ∈ Set.range j₀ ∧
      ∃ φ₀ : U ⟶ (W : Scheme.{u}), φ₀ ≫ W.ι = j₀ ≫ W'.ι ≫ f :=
    ⟨_, ((W' : Scheme.{u}).basicOpen t).ι, inferInstance, hUaff,
      ⟨⟨iW' z'', hxU⟩, Scheme.Opens.ι_apply _ _⟩, IsOpenImmersion.lift W.ι _ hrange,
      IsOpenImmersion.lift_fac _ _ _⟩
  haveI := hj₀
  haveI := hUaff'
  obtain ⟨pu, hpu⟩ := hxj₀
  obtain ⟨zU0, -, hzU0⟩ :=
    Scheme.Pullback.exists_preimage_pullback (f := iW') (g := j₀) z'' pu hpu.symm
  obtain ⟨ZU, gU, iU, hU, zU, hzU⟩ : ∃ (ZU : Scheme.{u}) (gU : ZU ⟶ ZW') (iU : ZU ⟶ U),
      IsPullback gU iU iW' j₀ ∧ ∃ zU : ZU, iU zU = pu :=
    ⟨_, _, _, IsPullback.of_hasPullback iW' j₀, zU0, hzU0⟩
  have P3 := (hU.paste_horiz hsq').paste_horiz hsq
  obtain ⟨gU', hUW⟩ := hlift hsqW P3 φ₀ (by rw [hφ₀, Category.assoc])
  have hcutUa : wcEtCutOut iU (fun k => j₀.appTop.hom (h' k)) :=
    wc_et_cutout_base_change iW' h' j₀ iU gU hcut' hUaff' hU
  have hcutUb : wcEtCutOut iU (fun k => φ₀.appTop.hom (h k)) :=
    wc_et_cutout_base_change iW h φ₀ iU gU' hcutW hUaff' hUW
  have gcUb : wcEtGoodChart K (j₀ ≫ W'.ι ≫ fX') iU c (fun k => φ₀.appTop.hom (h k)) :=
    ⟨n', hcn', hsm0 j₀ (W'.ι ≫ fX') n', hsmV j₀ gU iU hU, hcutUb⟩

  obtain ⟨V, jV, hjV, hVaff, hmemV, B, hB, hrel⟩ :=
    wc_smooth_pair_tuples_locally_GL K (j₀ ≫ W'.ι ≫ fX') iU c _ _ gcUb hcutUa zU
  haveI := hjV
  haveI := hVaff
  refine ⟨V, jV ≫ j₀, inferInstance, ?_, ?_⟩
  · obtain ⟨v, hv⟩ := hmemV
    exact ⟨v, by rw [Scheme.Hom.comp_apply, hv, hzU, hpu]⟩

  intro ZV iV gV hV DV Ej γj hadmj
  rw [map_sub, sub_eq_zero]
  have Q2 := hV.paste_horiz hsq'
  have Q3 := Q2.paste_horiz hsq
  have hφ : (jV ≫ φ₀) ≫ W.ι = ((jV ≫ j₀) ≫ W'.ι) ≫ f := by
    simp only [Category.assoc]
    rw [hφ₀]
  obtain ⟨gQ4, Q4⟩ := hlift hsqW Q3 (jV ≫ φ₀) hφ
  obtain ⟨Ea⟩ := wc_et_zmod_pull_data_exists ((jV ≫ j₀) ≫ W'.ι) ℓ
  obtain ⟨Eb⟩ := wc_et_zmod_pull_data_exists (((jV ≫ j₀) ≫ W'.ι) ≫ f) ℓ
  obtain ⟨Eφ⟩ := wc_et_zmod_pull_data_exists (jV ≫ φ₀) ℓ
  obtain ⟨γa, hγa, hepi⟩ := wc_et_closed_supp_base_change i' _ iV _ Q2 D' Ea DV
  obtain ⟨γb, hγb, -⟩ := wc_et_closed_supp_base_change i _ iV _ Q3 D Eb DV
  obtain ⟨γφ, hγφ, -⟩ := wc_et_closed_supp_base_change iW _ iV _ Q4 DW Eφ DV
  have hcutV1 : wcEtCutOut iV (fun k => (jV ≫ j₀).appTop.hom (h' k)) :=
    wc_et_cutout_base_change iW' h' (jV ≫ j₀) iV gV hcut' hVaff hV
  have hcutV2 : wcEtCutOut iV (fun k => (jV ≫ φ₀).appTop.hom (h k)) :=
    wc_et_cutout_base_change iW h (jV ≫ φ₀) iV gQ4 hcutW hVaff Q4
  have hja : (fun k => (jV ≫ j₀).appTop.hom (h' k)) =
      fun k => jV.appTop.hom (j₀.appTop.hom (h' k)) := by
    funext k
    rw [Scheme.Hom.comp_appTop]
    rfl
  have hjb : (fun k => (jV ≫ φ₀).appTop.hom (h k)) =
      fun k => jV.appTop.hom (φ₀.appTop.hom (h k)) := by
    funext k
    rw [Scheme.Hom.comp_appTop]
    rfl
  have SV1 : SmoothOfRelativeDimension n' ((jV ≫ j₀) ≫ W'.ι ≫ fX') :=
    hsm0 (jV ≫ j₀) (W'.ι ≫ fX') n'
  have SV2 : SmoothOfRelativeDimension (n' - c) (iV ≫ (jV ≫ j₀) ≫ W'.ι ≫ fX') :=
    hsmV (jV ≫ j₀) gV iV hV
  have gcV1 : wcEtGoodChart K ((jV ≫ j₀) ≫ W'.ι ≫ fX') iV c
      (fun k => (jV ≫ j₀).appTop.hom (h' k)) := ⟨n', hcn', SV1, SV2, hcutV1⟩
  have gcV2 : wcEtGoodChart K ((jV ≫ j₀) ≫ W'.ι ≫ fX') iV c
      (fun k => (jV ≫ φ₀).appTop.hom (h k)) := ⟨n', hcn', SV1, SV2, hcutV2⟩
  have hφf : (jV ≫ φ₀) ≫ W.ι ≫ fX = (jV ≫ j₀) ≫ W'.ι ≫ fX' := by
    rw [← hf]
    simp only [Category.assoc]
    rw [reassoc_of% hφ₀]
  have L6a := wc_et_supp_restr_comp W'.ι (jV ≫ j₀) ((jV ≫ j₀) ≫ W'.ι) rfl D' DW' DV EW' Ej Ea
    γW' γj γa hadm' hadmj hγa hepi (2 * c) (wcEtSuppRestr D Df D' γ (2 * c) θ)
  have L6b := wc_et_supp_restr_comp f ((jV ≫ j₀) ≫ W'.ι) (((jV ≫ j₀) ≫ W'.ι) ≫ f) rfl D D' DV
    Df Ea Eb γ γa γb hγ hγa hγb hepi (2 * c) θ
  have L6c := wc_et_supp_restr_comp W.ι (jV ≫ φ₀) (((jV ≫ j₀) ≫ W'.ι) ≫ f) hφ D DW DV EW Eφ Eb
    γW γφ γb hγW hγφ hγb hepi (2 * c) θ
  have NA := hTb (W'.ι ≫ fX') ((jV ≫ j₀) ≫ W'.ι ≫ fX') (jV ≫ j₀) rfl iW' iV gV hV DW' Ej DV γj
    hadmj c h' gcW' gcV1
  have NB := hTb (W.ι ≫ fX) ((jV ≫ j₀) ≫ W'.ι ≫ fX') (jV ≫ φ₀) hφf iW iV gQ4 Q4 DW Eφ DV γφ
    hγφ c h gcW gcV2
  have key : (fun k => (jV ≫ j₀).appTop.hom (h' k)) =
      B.mulVec (fun k => (jV ≫ φ₀).appTop.hom (h k)) :=
    hja.trans (hrel.trans (congrArg B.mulVec hjb.symm))
  rw [← L6a, ← L6b, L6c, hθW, NB, NA]
  exact (hTa _ iV DV c _ B hB gcV2).symm.trans
    (congrArg (T ((jV ≫ j₀) ≫ W'.ι ≫ fX') iV DV c) key.symm)

theorem wc_std_smooth_section_cotangent_gen : ∀ (R A B : Type u) [CommRing R] [CommRing A] [CommRing B] (φ : R →+* A) (n : ℕ), RingHom.IsStandardSmoothOfRelativeDimension n φ → ∀ (ε : A →+* B), Function.Bijective (ε.comp φ) → ∃ h : Fin n → A, (∀ j, ε (h j) = 0) ∧ (RingHom.ker ε).FG ∧ RingHom.ker ε ≤ Ideal.span (Set.range h) ⊔ RingHom.ker ε ^ 2 :=
by
  classical
  intro R A B _ _ _ φ n hstd ε hbij
  letI : Algebra R A := φ.toAlgebra
  have hstd' : Algebra.IsStandardSmoothOfRelativeDimension n R A := hstd
  obtain ⟨ι, σ, _, _, P, hdim⟩ := hstd'.out
  letI : Fintype ι := Fintype.ofFinite ι
  letI : Fintype σ := Fintype.ofFinite σ
  have hminj : Function.Injective P.map := P.map_inj

  let e : R ≃+* B := RingEquiv.ofBijective (ε.comp φ) hbij
  let r : ι → R := fun i => e.symm (ε (P.val i))
  have hr : ∀ i, ε (φ (r i)) = ε (P.val i) := fun i => by
    show e (e.symm (ε (P.val i))) = _
    exact e.apply_symm_apply _
  let y : ι → A := fun i => P.val i - φ (r i)
  have hy0 : ∀ i, ε (y i) = 0 := fun i => by
    show ε (P.val i - φ (r i)) = 0
    rw [map_sub, hr, sub_self]
  have hinj : ∀ a, ε (φ a) = 0 → a = 0 := fun a ha =>
    hbij.1 (by simp only [RingHom.comp_apply, map_zero, ha])
  set K : Ideal A := Ideal.span (Set.range y) with hK
  have hyK : ∀ i, y i ∈ K := fun i => Ideal.subset_span ⟨i, rfl⟩
  have hLK : ∀ c : ι → A, ∑ i, c i * y i ∈ K := fun c =>
    Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hyK i))

  have heval : ∀ p : MvPolynomial ι R,
      ε (MvPolynomial.eval₂ φ P.val p) = ε (φ (MvPolynomial.eval r p)) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq => simp only [MvPolynomial.eval₂_add, map_add, hp, hq]
    | mul_X p i hp =>
      simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, map_mul, MvPolynomial.eval_X, hp, hr]

  have htaylor : ∀ p : MvPolynomial ι R, MvPolynomial.eval₂ φ P.val p - φ (MvPolynomial.eval r p) -
      ∑ i, φ (MvPolynomial.eval r (MvPolynomial.pderiv i p)) * y i ∈ K ^ 2 := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
      simp
    | add p q hp hq =>
      have hid : MvPolynomial.eval₂ φ P.val (p + q) - φ (MvPolynomial.eval r (p + q)) -
          ∑ i, φ (MvPolynomial.eval r (MvPolynomial.pderiv i (p + q))) * y i =
          (MvPolynomial.eval₂ φ P.val p - φ (MvPolynomial.eval r p) -
            ∑ i, φ (MvPolynomial.eval r (MvPolynomial.pderiv i p)) * y i) +
          (MvPolynomial.eval₂ φ P.val q - φ (MvPolynomial.eval r q) -
            ∑ i, φ (MvPolynomial.eval r (MvPolynomial.pderiv i q)) * y i) := by
        simp only [MvPolynomial.eval₂_add, map_add, add_mul, Finset.sum_add_distrib]
        ring
      rw [hid]
      exact Ideal.add_mem _ hp hq
    | mul_X p k hp =>
      have hsum : ∑ i, φ (MvPolynomial.eval r (MvPolynomial.pderiv i (p * MvPolynomial.X k))) * y i =
          φ (r k) * ∑ i, φ (MvPolynomial.eval r (MvPolynomial.pderiv i p)) * y i +
            φ (MvPolynomial.eval r p) * y k := by
        simp only [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, map_add, map_mul,
          MvPolynomial.eval_X, add_mul, Finset.sum_add_distrib, Finset.mul_sum]
        congr 1
        · exact Finset.sum_congr rfl fun i _ => by ring
        · rw [Finset.sum_eq_single k]
          · simp
          · intro b _ hb
            have : (Pi.single b (1 : MvPolynomial ι R) : ι → MvPolynomial ι R) k = 0 :=
              Pi.single_eq_of_ne (Ne.symm hb) _
            rw [this]; simp
          · intro hk; exact absurd (Finset.mem_univ k) hk
      have hyk : y k = P.val k - φ (r k) := rfl
      have hid : MvPolynomial.eval₂ φ P.val (p * MvPolynomial.X k) -
          φ (MvPolynomial.eval r (p * MvPolynomial.X k)) -
          ∑ i, φ (MvPolynomial.eval r (MvPolynomial.pderiv i (p * MvPolynomial.X k))) * y i =
          (MvPolynomial.eval₂ φ P.val p - φ (MvPolynomial.eval r p) -
            ∑ i, φ (MvPolynomial.eval r (MvPolynomial.pderiv i p)) * y i) * P.val k +
          (∑ i, φ (MvPolynomial.eval r (MvPolynomial.pderiv i p)) * y i) * y k := by
        rw [hsum]
        simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, map_mul, MvPolynomial.eval_X]
        rw [hyk]
        ring
      rw [hid]
      refine Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) ?_
      rw [sq]
      exact Ideal.mul_mem_mul (hLK _) (hyK k)

  have hker : RingHom.ker ε = K := by
    apply le_antisymm
    · intro a ha
      rw [RingHom.mem_ker] at ha
      have h1 := htaylor (P.σ a)
      have hE : MvPolynomial.eval₂ φ P.val (P.σ a) = a :=
        (MvPolynomial.aeval_def _ _).symm.trans (P.aeval_val_σ a)
      have h0 : MvPolynomial.eval r (P.σ a) = 0 := by
        apply hinj
        rw [← heval, hE, ha]
      rw [hE, h0, map_zero, sub_zero] at h1
      have h2 := K.add_mem (Ideal.pow_le_self two_ne_zero h1)
        (hLK fun i => φ (MvPolynomial.eval r (MvPolynomial.pderiv i (P.σ a))))
      simpa using h2
    · rw [hK, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact hy0 i

  let c : ι → σ → A := fun i j =>
    φ (MvPolynomial.eval r (MvPolynomial.pderiv i (P.relation j)))
  have hrel : ∀ j, ∑ i, c i j * y i ∈ K ^ 2 := by
    intro j
    have h1 := htaylor (P.relation j)
    have hE : MvPolynomial.eval₂ φ P.val (P.relation j) = 0 :=
      (MvPolynomial.aeval_def _ _).symm.trans (P.aeval_val_relation j)
    have h0 : MvPolynomial.eval r (P.relation j) = 0 := hinj _ (by rw [← heval, hE, map_zero])
    rw [hE, h0, map_zero, sub_zero, zero_sub, neg_mem_iff] at h1
    exact h1

  let M : Matrix σ σ A := Matrix.of fun k j => c (P.map k) j
  have hdetM : IsUnit M.det := by
    have hJ := P.jacobian_isUnit
    rw [P.jacobian_eq_jacobiMatrix_det, Algebra.Generators.algebraMap_apply,
      MvPolynomial.aeval_def] at hJ
    have h2 : IsUnit (ε (φ (MvPolynomial.eval r P.jacobiMatrix.det))) := by
      rw [← heval]; exact hJ.map ε
    have h3 : IsUnit (MvPolynomial.eval r P.jacobiMatrix.det) := by
      have := h2.map e.symm
      have he' : ε (φ (MvPolynomial.eval r P.jacobiMatrix.det)) =
          e (MvPolynomial.eval r P.jacobiMatrix.det) := rfl
      rwa [he', e.symm_apply_apply] at this
    have hφdet : φ (MvPolynomial.eval r P.jacobiMatrix.det) = M.det := by
      rw [RingHom.map_det, RingHom.map_det]
      congr 1
      ext k j
      simp [M, c, Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
    rw [← hφdet]
    exact h3.map φ

  obtain ⟨T, hTdef⟩ : ∃ T : Finset ι, T = (Finset.univ.image P.map)ᶜ := ⟨_, rfl⟩
  have hTcard : T.card = n := by
    rw [hTdef, Finset.card_compl, Finset.card_image_of_injective _ hminj, Finset.card_univ, ← hdim]
    simp only [Algebra.Presentation.dimension, Nat.card_eq_fintype_card]
  obtain ⟨e'⟩ : Nonempty (Fin n ≃ T) := ⟨(Finset.equivFinOfCardEq hTcard).symm⟩
  let h : Fin n → A := fun j => y (e' j)
  have hTh : ∀ i ∈ T, y i ∈ Ideal.span (Set.range h) := by
    intro i hi
    refine Ideal.subset_span ⟨e'.symm ⟨i, hi⟩, ?_⟩
    show y (e' (e'.symm ⟨i, hi⟩) : ι) = y i
    rw [Equiv.apply_symm_apply]

  have helim : ∀ l, y (P.map l) ∈ Ideal.span (Set.range h) ⊔ K ^ 2 := by
    set S := Ideal.span (Set.range h) ⊔ K ^ 2 with hS
    have hu : ∀ j, ∑ k, M k j * y (P.map k) ∈ S := by
      intro j
      have hsplit := Finset.sum_add_sum_compl (Finset.univ.image P.map) (fun i => c i j * y i)
      rw [← hTdef] at hsplit
      have h1 : ∑ i ∈ Finset.univ.image P.map, c i j * y i = ∑ k, M k j * y (P.map k) := by
        rw [Finset.sum_image (fun a _ b _ hab => hminj hab)]
        rfl
      have h2 : ∑ i ∈ T, c i j * y i ∈ S :=
        Ideal.mem_sup_left (Ideal.sum_mem _ fun i hi => Ideal.mul_mem_left _ _ (hTh i hi))
      have h3 : ∑ i, c i j * y i ∈ S := Ideal.mem_sup_right (hrel j)
      rw [← hsplit, h1] at h3
      have := S.sub_mem h3 h2
      rwa [add_sub_cancel_right] at this
    intro l
    have hMN : M * M⁻¹ = 1 := Matrix.mul_nonsing_inv M hdetM
    have key : ∑ j, M⁻¹ j l * ∑ k, M k j * y (P.map k) = y (P.map l) := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      have hk : ∀ k, ∑ j, M⁻¹ j l * (M k j * y (P.map k)) = (M * M⁻¹) k l * y (P.map k) := by
        intro k
        rw [Matrix.mul_apply, Finset.sum_mul]
        exact Finset.sum_congr rfl fun j _ => by ring
      simp_rw [hk, hMN, Matrix.one_apply]
      simp
    rw [← key]
    exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hu j)

  refine ⟨h, fun j => hy0 _, ?_, ?_⟩
  · rw [hker, hK]
    exact Submodule.fg_span (Set.finite_range y)
  · rw [hker]
    show Ideal.span (Set.range y) ≤ _
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    by_cases hi : i ∈ T
    · exact Ideal.mem_sup_left (hTh i hi)
    · have hi' : i ∈ Finset.univ.image P.map := by
        rw [hTdef, Finset.mem_compl, not_not] at hi
        exact hi
      obtain ⟨l, -, rfl⟩ := Finset.mem_image.mp hi'
      exact helim l

theorem wc_scheme_point_localize_cutout : ∀ {X S : Scheme.{u}} (x : S ⟶ X) [IsClosedImmersion x] (V : X.Opens), IsAffineOpen V → ∀ (hV : ⊤ ≤ x ⁻¹ᵁ V) (n : ℕ) (g : Γ(X, V)) (h : Fin n → Γ(X, V)), IsUnit ((x.appLE V ⊤ hV).hom g) → (∀ j, (x.appLE V ⊤ hV).hom (h j) = 0) → (∀ a : Γ(X, V), (x.appLE V ⊤ hV).hom a = 0 → g * a ∈ Ideal.span (Set.range h)) → ∃ (W : X.Opens) (H : Set.range x ⊆ Set.range W.ι) (h' : Fin n → Γ(W, ⊤)), IsAffineOpen W ∧ IsClosedImmersion (IsOpenImmersion.lift W.ι x H) ∧ RingHom.ker (IsOpenImmersion.lift W.ι x H).appTop.hom = Ideal.span (Set.range h') :=
by
  intro X S x _ V hVa hV n g h hu h0 hg

  have alg : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (ψ : A →+* B)
      (ε' : B →+* C) (g : A) (h : Fin n → A), IsUnit (ψ g) →
      (∀ b : B, ∃ (m : ℕ) (a : A), b * ψ g ^ m = ψ a) → (∀ j, ε' (ψ (h j)) = 0) →
      (∀ a : A, ε' (ψ a) = 0 → g * a ∈ Ideal.span (Set.range h)) →
      RingHom.ker ε' = Ideal.span (Set.range (fun j => ψ (h j))) := by
    intro A B C _ _ _ ψ ε' g h hu hs h0 hg
    apply le_antisymm
    · intro b hb
      rw [RingHom.mem_ker] at hb
      obtain ⟨m, a, hma⟩ := hs b
      have hεa : ε' (ψ a) = 0 := by rw [← hma, map_mul, hb, zero_mul]
      have hga := hg a hεa
      have h1 : ψ (g * a) ∈ Ideal.span (Set.range (fun j => ψ (h j))) := by
        have := Ideal.mem_map_of_mem ψ hga
        rw [Ideal.map_span, ← Set.range_comp] at this
        exact this
      have h2 : ψ (g * a) = b * ψ g ^ (m + 1) := by rw [map_mul, ← hma]; ring
      rw [h2] at h1
      exact (Ideal.mul_unit_mem_iff_mem _ (hu.pow (m + 1))).mp h1
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact h0 j
  obtain ⟨W, hW⟩ : ∃ W : X.Opens, W = X.basicOpen g := ⟨_, rfl⟩
  have hWV : W ≤ V := by rw [hW]; exact X.basicOpen_le g
  have e : ⊤ ≤ W.ι ⁻¹ᵁ V := by
    intro s _
    rw [Scheme.Hom.mem_preimage]
    apply hWV
    have : W.ι s ∈ Set.range W.ι := ⟨s, rfl⟩
    rw [Scheme.Opens.range_ι] at this
    exact this

  have hxW : x ⁻¹ᵁ W = ⊤ := by
    rw [hW]
    calc x ⁻¹ᵁ X.basicOpen g = ⊤ ⊓ x ⁻¹ᵁ X.basicOpen g := (top_inf_eq _).symm
      _ = S.basicOpen ((x.appLE V ⊤ hV).hom g) := (Scheme.basicOpen_appLE x ⊤ V hV g).symm
      _ = ⊤ := Scheme.basicOpen_of_isUnit _ hu
  have H : Set.range x ⊆ Set.range W.ι := by
    rintro _ ⟨s, rfl⟩
    rw [Scheme.Opens.range_ι]
    have : s ∈ x ⁻¹ᵁ W := by rw [hxW]; trivial
    exact (Scheme.Hom.mem_preimage x).mp this

  have hle : W.ι ''ᵁ ⊤ ≤ V := by rw [Scheme.Opens.ι_image_top]; exact hWV
  letI : Algebra Γ(X, V) Γ(X, W.ι ''ᵁ ⊤) := (X.presheaf.map (homOfLE hle).op).hom.toAlgebra
  haveI : IsLocalization.Away g Γ(X, W.ι ''ᵁ ⊤) :=
    hVa.isLocalization_of_eq_basicOpen g (homOfLE hle) (by rw [Scheme.Opens.ι_image_top, hW])
  have hψeq : (W.ι.appLE V ⊤ e).hom = algebraMap Γ(X, V) Γ(X, W.ι ''ᵁ ⊤) := by
    rw [RingHom.algebraMap_toAlgebra, Scheme.Opens.ι_appLE]
    rfl
  have hunit : IsUnit ((W.ι.appLE V ⊤ e).hom g) := by
    have := IsLocalization.Away.algebraMap_isUnit (S := Γ(X, W.ι ''ᵁ ⊤)) g
    rw [← hψeq] at this
    exact this
  have hsurj : ∀ b : Γ(W, ⊤), ∃ (m : ℕ) (a : Γ(X, V)),
      b * (W.ι.appLE V ⊤ e).hom g ^ m = (W.ι.appLE V ⊤ e).hom a := by
    intro b
    obtain ⟨m, a, hb⟩ := IsLocalization.Away.surj (S := Γ(X, W.ι ''ᵁ ⊤)) g b
    rw [← hψeq] at hb
    exact ⟨m, a, hb⟩

  have hcomp : ∀ a, (IsOpenImmersion.lift W.ι x H).appTop.hom ((W.ι.appLE V ⊤ e).hom a) =
      (x.appLE V ⊤ hV).hom a := by
    intro a
    have key : ∀ (f : S ⟶ X), f = x → ∀ e', f.appLE V ⊤ e' = x.appLE V ⊤ hV := by
      rintro f rfl e'; rfl
    have h2 : (IsOpenImmersion.lift W.ι x H).appLE ⊤ ⊤
        (le_of_eq (Scheme.Hom.preimage_top _).symm) = (IsOpenImmersion.lift W.ι x H).appTop :=
      Scheme.Hom.appLE_eq_app _
    have h3 := Scheme.Hom.appLE_comp_appLE (IsOpenImmersion.lift W.ι x H) W.ι V ⊤ ⊤ e
      (le_of_eq (Scheme.Hom.preimage_top _).symm)
    rw [h2, key _ (IsOpenImmersion.lift_fac W.ι x H)] at h3
    rw [← h3]
    rfl
  haveI : IsClosedImmersion (IsOpenImmersion.lift W.ι x H ≫ W.ι) := by
    rw [IsOpenImmersion.lift_fac]; infer_instance
  haveI : IsClosedImmersion (IsOpenImmersion.lift W.ι x H) := IsClosedImmersion.of_comp _ W.ι
  refine ⟨W, H, fun j => (W.ι.appLE V ⊤ e).hom (h j), by rw [hW]; exact hVa.basicOpen g,
    inferInstance, ?_⟩
  exact alg _ _ g h hunit hsurj (fun j => (hcomp _).trans (h0 j))
    (fun a ha => hg a ((hcomp a).symm.trans ha))

theorem wc_et_thom_class_point_ne_zero : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (T : wcEtLocThom K ℓ), wcEtThomPt T → ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n : ℕ) [SmoothOfRelativeDimension n fX] [IsSeparated fX] (x : Spec (.of K) ⟶ X), x ≫ fX = 𝟙 _ → ∀ (D : wcEtPullData x ℓ) (θ : wcEtSuppExt D (2 * n)), wcEtIsThom T fX D n θ → θ ≠ 0 :=
by
  classical
  intro K _ _ ℓ _ hℓ T hTc X fX n _ _ x hx D θ hθ hθ0

  haveI : IsClosedImmersion (x ≫ fX) := by rw [hx]; infer_instance
  haveI : IsClosedImmersion x := IsClosedImmersion.of_comp x fX

  obtain ⟨V, hVa, hV, e, hstd, hbij⟩ : ∃ (V : X.Opens) (_ : IsAffineOpen V) (hV : ⊤ ≤ x ⁻¹ᵁ V)
      (e : V ≤ fX ⁻¹ᵁ ⊤), RingHom.IsStandardSmoothOfRelativeDimension n (fX.appLE ⊤ V e).hom ∧
        Function.Bijective ((x.appLE V ⊤ hV).hom.comp (fX.appLE ⊤ V e).hom) := by
    let pt : Spec (.of K) := Classical.arbitrary _
    obtain ⟨U, _, V, hVa, hxV, e₀, hstd₀⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := fX) (x pt)
    have hU : U = ⊤ := by
      apply eq_top_iff.mpr
      intro q _
      rw [Subsingleton.elim q (fX (x pt))]
      exact e₀ hxV
    subst hU
    have hV : ⊤ ≤ x ⁻¹ᵁ V := by
      intro q _
      rw [Subsingleton.elim q pt]
      exact hxV
    refine ⟨V, hVa, hV, e₀, hstd₀, ?_⟩
    rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
    have key : ∀ (k : Spec (.of K) ⟶ Spec (.of K)), k = 𝟙 _ → ∀ (e' : (⊤ : (Spec (.of K)).Opens) ≤ k ⁻¹ᵁ ⊤),
        Function.Bijective (k.appLE ⊤ ⊤ e').hom := by
      rintro k rfl e'
      have h1 : (𝟙 (Spec (.of K)) : Spec (.of K) ⟶ Spec (.of K)).appLE ⊤ ⊤ e' = 𝟙 _ := by
        rw [Scheme.Hom.appLE, Scheme.Hom.id_app]
        erw [Category.id_comp]
        exact (Spec (.of K)).presheaf.map_id _
      rw [h1, CommRingCat.hom_id]
      exact Function.bijective_id
    exact key _ hx _

  obtain ⟨h, hh0, hfg, hle⟩ := wc_std_smooth_section_cotangent_gen _ _ _ (fX.appLE ⊤ V e).hom n hstd
    (x.appLE V ⊤ hV).hom hbij

  obtain ⟨g, hg1, hg⟩ : ∃ g : Γ(X, V), g - 1 ∈ RingHom.ker (x.appLE V ⊤ hV).hom ∧
      ∀ a ∈ RingHom.ker (x.appLE V ⊤ hV).hom, g * a ∈ Ideal.span (Set.range h) := by
    set I := RingHom.ker (x.appLE V ⊤ hV).hom with hI
    set J := Ideal.span (Set.range h) with hJ
    set N : Submodule Γ(X, V) (Γ(X, V) ⧸ J) := Submodule.map (Submodule.mkQ J) I with hN
    have hNfg : N.FG := Submodule.FG.map (Submodule.mkQ J) hfg
    have hle' : N ≤ I • N := by
      have h1 : N ≤ Submodule.map (Submodule.mkQ J) (J ⊔ I • I) := by
        apply Submodule.map_mono
        rw [Ideal.smul_eq_mul, ← pow_two]
        exact hle
      rw [Submodule.map_sup, Submodule.mkQ_map_self, bot_sup_eq, Submodule.map_smul''] at h1
      exact h1
    obtain ⟨r, hr1, hr⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul I N hNfg hle'
    refine ⟨r, hr1, fun a ha => ?_⟩
    have h2 := hr (Submodule.mkQ J a) (Submodule.mem_map_of_mem ha)
    rw [← LinearMap.map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
      smul_eq_mul] at h2
    exact h2
  have hunit : IsUnit ((x.appLE V ⊤ hV).hom g) := by
    have h1 := RingHom.mem_ker.mp hg1
    rw [map_sub, map_one, sub_eq_zero] at h1
    rw [h1]
    exact isUnit_one
  have hgker : ∀ a : Γ(X, V), (x.appLE V ⊤ hV).hom a = 0 → g * a ∈ Ideal.span (Set.range h) :=
    fun a ha => hg a (RingHom.mem_ker.mpr ha)

  obtain ⟨W, H, h', hWa, hcl, hker⟩ :=
    wc_scheme_point_localize_cutout x V hVa hV n g h hunit hh0 hgker

  have hpb : IsPullback (𝟙 _) (IsOpenImmersion.lift W.ι x H) x W.ι :=
    (IsOpenImmersion.isPullback_lift_id x W.ι H).flip
  let DW : wcEtPullData (IsOpenImmersion.lift W.ι x H) ℓ :=
    (wc_et_zmod_pull_data_exists (IsOpenImmersion.lift W.ι x H) ℓ).some
  let EW : wcEtPullData W.ι ℓ := (wc_et_zmod_pull_data_exists W.ι ℓ).some
  obtain ⟨γ, hγ, -⟩ :=
    wc_et_closed_supp_base_change x W.ι (IsOpenImmersion.lift W.ι x H) (𝟙 _) hpb D EW DW

  have hcut : wcEtCutOut (IsOpenImmersion.lift W.ι x H) h' := ⟨hWa, hcl, hker⟩
  have h1 := hθ W (Spec (.of K)) (IsOpenImmersion.lift W.ι x H) (𝟙 _) hpb DW EW γ hγ h' hcut
  rw [hθ0, map_zero] at h1

  have hsm : SmoothOfRelativeDimension n (W.ι ≫ fX) := by
    have := smoothOfRelativeDimension_comp 0 n W.ι fX
    rwa [Nat.zero_add] at this
  have hsm0 : SmoothOfRelativeDimension 0 (IsOpenImmersion.lift W.ι x H ≫ W.ι ≫ fX) := by
    rw [← Category.assoc, IsOpenImmersion.lift_fac, hx]
    infer_instance
  exact hTc (W.ι ≫ fX) (IsOpenImmersion.lift W.ι x H) DW n h' hsm hsm0 hcut inferInstance h1.symm

theorem wc_et_diag_supp_transversal_lift : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (y₀ : Spec (.of K) ⟶ Y), y₀ ≫ f = 𝟙 _ → ∀ (s : Y ⟶ Limits.pullback f f), s ≫ Limits.pullback.fst f f = 𝟙 Y → s ≫ Limits.pullback.snd f f = f ≫ y₀ → ∀ (DΔ : wcEtPullData (Limits.pullback.diagonal f) ℓ) (Ds : wcEtPullData s ℓ) (Dy : wcEtPullData y₀ ℓ) (u : wcEtSuppExt Dy (2 * d)), ∃ θ : wcEtSuppExt DΔ (2 * d), wcEtPull Ds (2 * d) (wcEtSuppClass DΔ (2 * d) θ) = wcEtSuppClass Dy (2 * d) u :=
by
  classical
  intro K _ _ Y f _ d _ _ ℓ _ hℓ y₀ hy₀ s hs₁ hs₂ DΔ Ds Dy u
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f f) ℓ)) :=
    HasExt.standard _
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos

  have hw : y₀ ≫ Limits.pullback.diagonal f = y₀ ≫ s := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, Limits.pullback.diagonal_fst, hs₁]
    · rw [Category.assoc, Category.assoc, Limits.pullback.diagonal_snd, hs₂, ← Category.assoc,
        hy₀, Category.id_comp, Category.comp_id]
  have hc1 : ∀ c : Limits.PullbackCone (Limits.pullback.diagonal f) s, c.fst = c.snd := by
    intro c
    have h := congrArg (· ≫ Limits.pullback.fst f f) c.condition
    simp only [Category.assoc, Limits.pullback.diagonal_fst, hs₁, Category.comp_id] at h
    exact h
  have hc2 : ∀ c : Limits.PullbackCone (Limits.pullback.diagonal f) s,
      c.fst = c.snd ≫ f ≫ y₀ := by
    intro c
    have h := congrArg (· ≫ Limits.pullback.snd f f) c.condition
    simp only [Category.assoc, Limits.pullback.diagonal_snd, hs₂, Category.comp_id] at h
    exact h
  have hsq : IsPullback y₀ y₀ (Limits.pullback.diagonal f) s := by
    refine IsPullback.mk ⟨hw⟩
      ⟨Limits.PullbackCone.IsLimit.mk hw (fun c => c.snd ≫ f) ?_ ?_ ?_⟩
    · intro c
      show (c.snd ≫ f) ≫ y₀ = c.fst
      rw [hc2 c, Category.assoc]
    · intro c
      show (c.snd ≫ f) ≫ y₀ = c.snd
      rw [Category.assoc, ← hc2 c, hc1 c]
    · intro c m _ hm2
      show m = c.snd ≫ f
      rw [← hm2, Category.assoc, hy₀, Category.comp_id]
  haveI : IsClosedImmersion (Limits.pullback.diagonal f) := inferInstance

  obtain ⟨γ, hγ, hepi⟩ :=
    wc_et_closed_supp_base_change (Limits.pullback.diagonal f) s y₀ y₀ hsq DΔ Ds Dy

  have hB : ∀ θ : wcEtSuppExt DΔ (2 * d), wcEtPull Ds (2 * d) (wcEtSuppClass DΔ (2 * d) θ) =
      wcEtSuppClass Dy (2 * d) ((Abelian.Ext.mk₀ γ).comp (wcEtSuppPullExt DΔ Ds (2 * d) θ)
        (zero_add _)) := by
    intro θ
    have e1 : wcEtPull Ds (2 * d) (wcEtSuppClass DΔ (2 * d) θ) =
        (Abelian.Ext.mk₀ (Ds.μ.inv ≫ Ds.Φ.map (wcEtSuppUnitMap DΔ))).comp
          (wcEtSuppPullExt DΔ Ds (2 * d) θ) (zero_add _) := by
      haveI := Ds.additive
      haveI := Ds.presLim
      haveI := Ds.presColim
      show (Abelian.Ext.mk₀ Ds.μ.inv).comp ((Abelian.Ext.mapExactFunctor Ds.Φ
          ((Abelian.Ext.mk₀ (wcEtSuppUnitMap DΔ)).comp θ (zero_add _))).comp
          (Abelian.Ext.mk₀ Ds.μ.hom) (add_zero _)) (zero_add _) =
        (Abelian.Ext.mk₀ (Ds.μ.inv ≫ Ds.Φ.map (wcEtSuppUnitMap DΔ))).comp
          ((Abelian.Ext.mapExactFunctor Ds.Φ θ).comp (Abelian.Ext.mk₀ Ds.μ.hom) (add_zero _))
          (zero_add _)
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc_of_second_deg_zero]
    rw [e1, ← hγ]
    show (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dy ≫ γ)).comp (wcEtSuppPullExt DΔ Ds (2 * d) θ)
        (zero_add _) =
      (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dy)).comp ((Abelian.Ext.mk₀ γ).comp
        (wcEtSuppPullExt DΔ Ds (2 * d) θ) (zero_add _)) (zero_add _)
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]

  let L : wcEtSuppExt DΔ (2 * d) →+ wcEtSuppExt Dy (2 * d) := wcEtSuppRestr DΔ Ds Dy γ (2 * d)
  have hL : ∀ θ, L θ =
      (Abelian.Ext.mk₀ γ).comp (wcEtSuppPullExt DΔ Ds (2 * d) θ) (zero_add _) := fun θ => rfl

  have hmk : ∀ m : ℕ, Abelian.Ext.mk₀ (m • 𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) =
      m • (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) :
        Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y ℓ))
          (SheafOfModules.unit (wcEtZModRing Y ℓ)) 0) := by
    intro m
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
  have hzero : ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ)) = 0 := by
    have h := (wc_et_zmod_unit_pow_exact Y ℓ 1 hℓpos).1
    rw [pow_one] at h
    exact h
  have htor : ∀ e : wcEtSuppExt Dy (2 * d), ℓ • e = 0 := by
    intro e
    have hlin := map_nsmul (Abelian.Ext.bilinearComp (wcEtSuppObj Dy)
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) (SheafOfModules.unit (wcEtZModRing Y ℓ))
      (2 * d) 0 (2 * d) (add_zero _) e) ℓ
      (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))))
    simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
    rw [Abelian.Ext.comp_mk₀_id] at hlin
    rw [← hlin, ← hmk, hzero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  obtain ⟨hfin, hcard⟩ := wc_et_point_supp_ext_card_le K Y f d ℓ hℓ y₀ hy₀ Dy
  haveI : Finite (wcEtSuppExt Dy (2 * d)) := hfin

  obtain ⟨T, hTa, hTb, hTc⟩ := wc_et_kummer_local_thom K ℓ hℓ
  haveI hP1 : SmoothOfRelativeDimension d (Limits.pullback.fst f f) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback f f).flip ‹_›
  haveI hP2 : SmoothOfRelativeDimension (d + d) (Limits.pullback.fst f f ≫ f) := inferInstance
  have hdd : d + d - d = d := by omega
  haveI hP3 : SmoothOfRelativeDimension (d + d - d)
      (Limits.pullback.diagonal f ≫ Limits.pullback.fst f f ≫ f) := by
    rw [hdd, ← Category.assoc, Limits.pullback.diagonal_fst, Category.id_comp]
    infer_instance
  haveI hP4 : CompactSpace ↥(Limits.pullback f f) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst f f ≫ f)
  haveI hP5 : IsSeparated (Limits.pullback.fst f f ≫ f) := inferInstance
  obtain ⟨θ₀, hθ₀⟩ := wc_et_thom_class_glue K ℓ hℓ T hTa hTb (Limits.pullback f f) Y
    (Limits.pullback.fst f f ≫ f) (d + d) d (Limits.pullback.diagonal f) (by omega) DΔ
  have hsY : s ≫ Limits.pullback.fst f f ≫ f = f := by
    rw [← Category.assoc, hs₁, Category.id_comp]
  have hdd0 : d - d = 0 := Nat.sub_self d
  haveI hY0 : SmoothOfRelativeDimension (d - d) (y₀ ≫ f) := by
    rw [hdd0, hy₀]
    infer_instance
  have hθ' := wc_et_thom_class_restrict K ℓ hℓ T hTa hTb (Limits.pullback.fst f f ≫ f) f s hsY
    (d + d) d d (Limits.pullback.diagonal f) y₀ (by omega) le_rfl y₀ hsq DΔ Ds Dy γ hγ θ₀ hθ₀
  have hv0 : L θ₀ ≠ 0 :=
    wc_et_thom_class_point_ne_zero K ℓ hℓ T hTc Y f d y₀ hy₀ Dy _ hθ'

  have hord : addOrderOf (L θ₀) = ℓ := by
    rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd _
        (addOrderOf_dvd_of_nsmul_eq_zero (htor (L θ₀))) with h | h
    · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) hv0
    · exact h
  have htop : AddSubgroup.zmultiples (L θ₀) = ⊤ :=
    AddSubgroup.eq_top_of_le_card _ (by rw [Nat.card_zmultiples, hord]; exact hcard)
  have hmem : u ∈ AddSubgroup.zmultiples (L θ₀) := by
    rw [htop]; exact AddSubgroup.mem_top _
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
  have hLk : L (k • θ₀) = u := (map_zsmul L k θ₀).trans hk
  refine ⟨k • θ₀, ?_⟩
  rw [hB]
  exact congrArg (wcEtSuppClass Dy (2 * d)) ((hL _).symm.trans hLk)

theorem wc_et_modell_diag_class_exists : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D1 : wcEtPullData (Limits.pullback.fst f f) ℓ) (D2 : wcEtPullData (Limits.pullback.snd f f) ℓ), ∃ (δ : wcEtZModExt (Limits.pullback f f) ℓ (2 * d)) (ω : wcEtZModExt Y ℓ (2 * d)), ω ≠ 0 ∧ (∀ (i k : ℕ) (hk : i + 2 * d = k) (x : wcEtZModExt Y ℓ i), wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) k hk (wcEtPull D1 i x) δ = wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) k hk (wcEtPull D2 i x) δ) ∧ δ - wcEtPull D1 (2 * d) ω ∈ AddSubgroup.closure {z | ∃ (a c : ℕ) (h : a + c = 2 * d) (x : wcEtZModExt Y ℓ a) (b : wcEtZModExt Y ℓ c), a < 2 * d ∧ z = wcEtZModCup (Limits.pullback f f) ℓ a c (2 * d) h (wcEtPull D1 a x) (wcEtPull D2 c b)} :=
by
  classical
  intro K _ _ Y f _ d _ _ ℓ _ hℓ D1 D2
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f f) ℓ)) := HasExt.standard _
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hℓ0 : ℓ ≠ 0 := hℓpos.ne'

  have hmul : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n) (a b c : ℕ)
      (hc : a + b = c) (x : wcEtZModExt S n a) (y : wcEtZModExt S n b),
      wcEtPull D c (wcEtZModCup S n a b c hc x y) =
        wcEtZModCup S' n a b c hc (wcEtPull D a x) (wcEtPull D b y) := by
    intro S S' g n D a b c hc x y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hc)).comp (Abelian.Ext.mk₀ D.μ.hom)
          (add_zero c)) (zero_add c) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        (zero_add a)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) hc
    rw [Abelian.Ext.mapExactFunctor_comp]
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) (zero_add b) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b) := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.hom) (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (add_zero 0) (zero_add b) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    symm
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (zero_add a) hc (by omega),
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x) (Abelian.Ext.mk₀ D.μ.hom)
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (add_zero a) (zero_add b) (by omega),
      e1,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x)
        (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) hc (add_zero b)
        (by omega)]

  have hone : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n),
      wcEtPull D 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S n)))) =
        @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
          (𝟙 (SheafOfModules.unit (wcEtZModRing S' n))) := by
    intro S S' g n D
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ
          (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S n))))).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0)) (zero_add 0) =
      Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S' n)))
    rw [Abelian.Ext.mapExactFunctor_mk₀, CategoryTheory.Functor.map_id, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀, Category.id_comp, Iso.inv_hom_id]

  have hrunit : ∀ (S : Scheme.{u}) (n m : ℕ) (z : wcEtZModExt S n m),
      wcEtZModCup S n m 0 m rfl z (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S n)))) = z := by
    intro S n m z
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    simp only [wcEtZModCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.comp_mk₀_id z


  have hrz : ∀ {X Z : Scheme.{u}} (i : X ⟶ Z) (r : ℕ) (D : wcEtPullData i r),
      Limits.PreservesFiniteColimits
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) →
      ∀ (n N k : ℕ) (hk : N + n = k) (θ : wcEtSuppExt D n) (x : wcEtZModExt Z r N),
      wcEtPull D N x = 0 → wcEtZModCup Z r N n k hk x (wcEtSuppClass D n θ) = 0 := by
    intro X Z i r D hex n N k hk θ x hx
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z r)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X r)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont
        D.φ).Additive :=
      Adjunction.right_adjoint_additive D.adj
    haveI : Limits.PreservesFiniteLimits
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) := by
      haveI := D.adj.rightAdjoint_preservesLimits
      infer_instance
    haveI := hex
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X r)) := by
      have encl : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
          [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
          (R : Sheaf J RingCat.{u+1}), EnoughInjectives (SheafOfModules.{u+1} R) := by
        intro C _ J _ _ R
        have s2 : HasSeparator (PresheafOfModules.{u+1} R.obj) := by
          let G : C → PresheafOfModules.{u+1} R.obj := fun X =>
            (PresheafOfModules.free.{u+1} R.obj).obj (uliftYoneda.{u+1}.obj X)
          have key : ∀ (X : C) (M N : PresheafOfModules.{u+1} R.obj) (φ : M ⟶ N) (h : G X ⟶ M),
              uliftYonedaEquiv.{u+1}
                ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N (h ≫ φ)) =
                φ.app (Opposite.op X) (uliftYonedaEquiv.{u+1}
                  ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M h)) := by
            intro X M N φ h
            rw [Adjunction.homEquiv_naturality_right, uliftYonedaEquiv_comp]
            rfl
          have hsep : (ObjectProperty.ofObj G).IsSeparating := by
            intro M N f g hfg
            apply PresheafOfModules.hom_ext
            intro Y
            obtain ⟨X⟩ := Y
            ext m
            let e := ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv
              (uliftYoneda.{u+1}.obj X) M).trans uliftYonedaEquiv.{u+1}
            have h1 := hfg _ (ObjectProperty.ofObj_apply G X) (e.symm m)
            have h2 := congrArg (fun k => uliftYonedaEquiv.{u+1}
              ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N k)) h1
            rw [key, key] at h2
            have h3 : uliftYonedaEquiv.{u+1}
                ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M (e.symm m)) = m :=
              e.apply_symm_apply m
            rw [h3] at h2
            exact h2
          exact HasSeparator.mk ⟨_, hsep.isSeparator_coproduct⟩
        have h5 : AB5OfSize.{u+1, u+1} (SheafOfModules.{u+1} R) :=
          ⟨fun K _ _ =>
            haveI := HasExactColimitsOfShape.domain_of_functor K
              (PresheafOfModules.toPresheaf.{u+1} R.obj)
            (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj)).hasExactColimitsOfShape K⟩
        have hs : HasSeparator (SheafOfModules.{u+1} R) :=
          HasSeparator.of_adjunction (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj))
        exact @IsGrothendieckAbelian.enoughInjectives _ _ _
          (IsGrothendieckAbelian.mk.{u+1} (C := SheafOfModules.{u+1} R) inferInstance inferInstance
            h5 hs)
      exact encl (Scheme.smallEtaleTopology X) (wcEtZModRing X r)

    have abs : ∀ (Φ : SheafOfModules.{u+1} (wcEtZModRing Z r) ⥤ SheafOfModules.{u+1} (wcEtZModRing X r))
        (G : SheafOfModules.{u+1} (wcEtZModRing X r) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z r))
        (adj : Φ ⊣ G)
        [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ]
        [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
        (M : SheafOfModules.{u+1} (wcEtZModRing Z r)) (n : ℕ)
        (N : SheafOfModules.{u+1} (wcEtZModRing X r)),
        Function.Bijective (fun y : Abelian.Ext M (G.obj N) n =>
          (Abelian.Ext.mapExactFunctor Φ y).comp (Abelian.Ext.mk₀ (adj.counit.app N))
            (add_zero n)) := by
      intro Φ G adj _ _ _ _ _ _ M n
      have N1 : ∀ {N N' : SheafOfModules.{u+1} (wcEtZModRing X r)} (g : N ⟶ N') {m : ℕ}
          (w : Abelian.Ext M (G.obj N) m),
          (Abelian.Ext.mapExactFunctor Φ (w.comp (Abelian.Ext.mk₀ (G.map g)) (add_zero m))).comp
            (Abelian.Ext.mk₀ (adj.counit.app N')) (add_zero m) =
          ((Abelian.Ext.mapExactFunctor Φ w).comp (Abelian.Ext.mk₀ (adj.counit.app N))
            (add_zero m)).comp (Abelian.Ext.mk₀ g) (add_zero m) := by
        intro N N' g m w
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
          Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          show Φ.map (G.map g) ≫ adj.counit.app N' = adj.counit.app N ≫ g from
            adj.counit_naturality g]
      have E : ∀ {S : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing X r))} (hS : S.ShortExact)
          (hGS : (S.map G).ShortExact) (hΦGS : ((S.map G).map Φ).ShortExact) {m : ℕ}
          (z : Abelian.Ext M (G.obj S.X₃) m),
          (Abelian.Ext.mapExactFunctor Φ (z.comp hGS.extClass (rfl : m + 1 = m + 1))).comp
              (Abelian.Ext.mk₀ (adj.counit.app S.X₁)) (add_zero (m + 1)) =
            ((Abelian.Ext.mapExactFunctor Φ z).comp (Abelian.Ext.mk₀ (adj.counit.app S.X₃))
              (add_zero m)).comp hS.extClass (rfl : m + 1 = m + 1) := by
        intro S hS hGS hΦGS m z
        have nat : hΦGS.extClass.comp (Abelian.Ext.mk₀ (adj.counit.app S.X₁)) (add_zero 1) =
            (Abelian.Ext.mk₀ (adj.counit.app S.X₃)).comp hS.extClass (zero_add 1) :=
          hΦGS.extClass_naturality hS (ShortComplex.homMk (adj.counit.app S.X₁)
            (adj.counit.app S.X₂) (adj.counit.app S.X₃) (adj.counit_naturality S.f).symm
            (adj.counit_naturality S.g).symm)
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
          Abelian.Ext.comp_assoc_of_third_deg_zero, nat, Abelian.Ext.comp_assoc_of_second_deg_zero]
      have tadd : ∀ (N : SheafOfModules.{u+1} (wcEtZModRing X r)) (m : ℕ),
          ∃ T : Abelian.Ext M (G.obj N) m →+ Abelian.Ext (Φ.obj M) N m,
          ∀ y, T y = (Abelian.Ext.mapExactFunctor Φ y).comp (Abelian.Ext.mk₀ (adj.counit.app N))
            (add_zero m) :=
        fun N m => ⟨((Abelian.Ext.mk₀ (adj.counit.app N)).postcomp (Φ.obj M) (add_zero m)).comp
          (Φ.mapExtAddHom M (G.obj N) m), fun y => rfl⟩
      induction n with
      | zero =>
        intro N
        have key0 : ∀ f : M ⟶ G.obj N,
            (Abelian.Ext.mapExactFunctor Φ (Abelian.Ext.mk₀ f)).comp
              (Abelian.Ext.mk₀ (adj.counit.app N)) (add_zero 0) =
            Abelian.Ext.mk₀ ((adj.homEquiv M N).symm f) := by
          intro f
          rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
            Adjunction.homEquiv_counit]
        refine ⟨?_, ?_⟩
        · intro y₁ y₂ h
          obtain ⟨f₁, rfl⟩ := (Abelian.Ext.mk₀_bijective M (G.obj N)).2 y₁
          obtain ⟨f₂, rfl⟩ := (Abelian.Ext.mk₀_bijective M (G.obj N)).2 y₂
          beta_reduce at h
          rw [key0, key0] at h
          have h' := (Abelian.Ext.mk₀_bijective _ _).1 h
          rw [(adj.homEquiv M N).symm.injective h']
        · intro v
          obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective (Φ.obj M) N).2 v
          refine ⟨Abelian.Ext.mk₀ (adj.homEquiv M N g), ?_⟩
          beta_reduce
          rw [key0, Equiv.symm_apply_apply]
      | succ n IH =>
        have step : ∀ (S : ShortComplex (SheafOfModules.{u+1} (wcEtZModRing X r)))
            (hS : S.ShortExact) (_ : Injective S.X₂),
            Function.Bijective (fun y : Abelian.Ext M (G.obj S.X₁) (n + 1) =>
              (Abelian.Ext.mapExactFunctor Φ y).comp (Abelian.Ext.mk₀ (adj.counit.app S.X₁))
                (add_zero (n + 1))) := by
          intro S hS hI
          have hGS := hS.map_of_exact G
          have hΦGS := hGS.map_of_exact Φ
          have : Injective (S.map G).X₂ := adj.map_injective S.X₂ hI
          refine ⟨?_, ?_⟩
          · have inj0 : ∀ y : Abelian.Ext M (G.obj S.X₁) (n + 1),
                (Abelian.Ext.mapExactFunctor Φ y).comp (Abelian.Ext.mk₀ (adj.counit.app S.X₁))
                  (add_zero (n + 1)) = 0 → y = 0 := by
              intro y hy
              have h1 : y.comp (Abelian.Ext.mk₀ (S.map G).f) (add_zero (n + 1)) = 0 :=
                Abelian.Ext.eq_zero_of_injective _
              obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ M hGS y h1
                (rfl : n + 1 = n + 1)
              have h2 : ((Abelian.Ext.mapExactFunctor Φ z).comp
                  (Abelian.Ext.mk₀ (adj.counit.app S.X₃)) (add_zero n)).comp hS.extClass
                    (rfl : n + 1 = n + 1) = 0 := by
                have := E hS hGS hΦGS z
                rw [hz] at this
                rw [← this]
                exact hy
              obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₃ (Φ.obj M) hS _
                (rfl : n + 1 = n + 1) h2
              obtain ⟨w', hw'⟩ := (IH S.X₂).2 w
              beta_reduce at hw'
              have h3 : (Abelian.Ext.mapExactFunctor Φ
                  (w'.comp (Abelian.Ext.mk₀ (G.map S.g)) (add_zero n))).comp
                    (Abelian.Ext.mk₀ (adj.counit.app S.X₃)) (add_zero n) =
                  (Abelian.Ext.mapExactFunctor Φ z).comp
                    (Abelian.Ext.mk₀ (adj.counit.app S.X₃)) (add_zero n) := by
                rw [N1, hw', hw]
              have h4 := (IH S.X₃).1 h3
              have h5 : (Abelian.Ext.mk₀ (G.map S.g)).comp hGS.extClass (zero_add 1) = 0 :=
                hGS.comp_extClass
              rw [← hz, ← h4, Abelian.Ext.comp_assoc_of_second_deg_zero, h5,
                Abelian.Ext.comp_zero]
            intro a b hab
            obtain ⟨T, hT⟩ := tadd S.X₁ (n + 1)
            have h0 : T (a - b) = 0 := by
              rw [map_sub, hT, hT]
              exact sub_eq_zero.mpr hab
            rw [hT] at h0
            exact sub_eq_zero.mp (inj0 _ h0)
          · intro v
            have h1 : v.comp (Abelian.Ext.mk₀ S.f) (add_zero (n + 1)) = 0 :=
              Abelian.Ext.eq_zero_of_injective _
            obtain ⟨u, hu⟩ := Abelian.Ext.covariant_sequence_exact₁ (Φ.obj M) hS v h1
              (rfl : n + 1 = n + 1)
            obtain ⟨z, hz⟩ := (IH S.X₃).2 u
            beta_reduce at hz
            refine ⟨z.comp hGS.extClass (rfl : n + 1 = n + 1), ?_⟩
            beta_reduce
            rw [E hS hGS hΦGS z, hz, hu]
        intro N
        exact step (ShortComplex.mk (Injective.ι N) (Limits.cokernel.π (Injective.ι N))
            (Limits.cokernel.condition _))
          (ShortComplex.ShortExact.mk'
            (ShortComplex.exact_of_g_is_cokernel _ (Limits.cokernelIsCokernel (Injective.ι N)))
            (Injective.ι_mono N) inferInstance)
          (show Injective (Injective.under N) from inferInstance)

    have htri : D.Φ.map (D.adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z r))
          (SheafOfModules.unit (wcEtZModRing X r)) D.μ.hom) ≫
        D.adj.counit.app (SheafOfModules.unit (wcEtZModRing X r)) = D.μ.hom := by
      have h1 := D.adj.homEquiv_counit (SheafOfModules.unit (wcEtZModRing Z r))
        (SheafOfModules.unit (wcEtZModRing X r))
        (D.adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z r))
          (SheafOfModules.unit (wcEtZModRing X r)) D.μ.hom)
      rw [Equiv.symm_apply_apply] at h1
      exact h1.symm

    have s3 : (Abelian.Ext.mk₀ D.μ.hom).comp (wcEtPull D N x) (zero_add N) =
        (Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero N) := by
      show (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero N))
          (zero_add N)) (zero_add N) = _
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    have hy : x.comp (Abelian.Ext.mk₀ (D.adj.homEquiv (SheafOfModules.unit (wcEtZModRing Z r))
          (SheafOfModules.unit (wcEtZModRing X r)) D.μ.hom)) (add_zero N) = 0 := by
      apply (abs D.Φ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ)
        D.adj (SheafOfModules.unit (wcEtZModRing Z r)) N
        (SheafOfModules.unit (wcEtZModRing X r))).1
      beta_reduce
      rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp,
        Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, htri, ← s3, hx,
        Abelian.Ext.comp_zero]
    have hy' : x.comp (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)) (add_zero N) = 0 := hy
    show x.comp ((Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp θ (zero_add n)) hk = 0
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, hy', Abelian.Ext.zero_comp]

  have hvan : ∀ (c : ℕ), 0 < c → ∀ y : wcEtZModExt (Spec (.of K)) ℓ c, y = 0 := by
    intro c hc y
    have hdim0 : topologicalKrullDim (Spec (.of K)) = 0 := by
      show topologicalKrullDim (PrimeSpectrum K) = 0
      rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, ringKrullDim_eq_zero_of_field]
    have hdim : topologicalKrullDim (Spec (.of K)) ≤ ((0 : ℕ) : WithBot ℕ∞) := by
      rw [hdim0]; simp
    haveI := wc_et_zero_dim_vanishing K (Spec (.of K)) (𝟙 _) hdim ℓ hℓ0 c hc
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv (Spec (.of K)) ℓ c
    haveI := e.subsingleton
    exact Subsingleton.elim _ _

  have hH0 : ∀ b : wcEtZModExt Y ℓ 0, ∃ k : ℤ, b = k •
      (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) : wcEtZModExt Y ℓ 0) := by
    intro b
    obtain ⟨hfin, hcard⟩ := wc_et_coh_zero_irreducible_card_le Y ℓ hℓ0
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv Y ℓ 0
    haveI : Finite (wcEtZModExt Y ℓ 0) := Finite.of_equiv _ e.symm
    have hc : Nat.card (wcEtZModExt Y ℓ 0) ≤ ℓ := by rw [Nat.card_congr e]; exact hcard
    have hmk : ∀ m : ℕ, Abelian.Ext.mk₀ (m • 𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) =
        m • Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) := by
      intro m
      induction m with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
      | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
    have htor : ℓ • (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) :
        wcEtZModExt Y ℓ 0) = 0 := by
      have h := (wc_et_zmod_unit_pow_exact Y ℓ 1 hℓpos).1
      rw [pow_one] at h
      rw [← hmk, h, Abelian.Ext.mk₀_zero]
    by_cases h1 : (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) :
        wcEtZModExt Y ℓ 0) = 0
    · refine ⟨0, ?_⟩
      rw [zero_smul]
      calc b = b.comp (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))))
            (add_zero 0) := (Abelian.Ext.comp_mk₀_id b).symm
        _ = 0 := by rw [h1, Abelian.Ext.comp_zero]
    · have hord : addOrderOf (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) :
          wcEtZModExt Y ℓ 0) = ℓ := by
        rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd _
            (addOrderOf_dvd_of_nsmul_eq_zero htor) with h | h
        · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) h1
        · exact h
      have htop : AddSubgroup.zmultiples (Abelian.Ext.mk₀
          (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) : wcEtZModExt Y ℓ 0) = ⊤ :=
        AddSubgroup.eq_top_of_le_card _ (by rw [Nat.card_zmultiples, hord]; exact hc)
      have hmem : b ∈ AddSubgroup.zmultiples (Abelian.Ext.mk₀
          (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) : wcEtZModExt Y ℓ 0) := by
        rw [htop]; exact AddSubgroup.mem_top _
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
      exact ⟨k, hk.symm⟩

  haveI : Nonempty Y := inferInstance
  obtain ⟨y₀, hy₀⟩ := wc_alg_closed_lft_section K Y f inferInstance
  obtain ⟨s, hs₁, hs₂⟩ : ∃ s : Y ⟶ Limits.pullback f f,
      s ≫ Limits.pullback.fst f f = 𝟙 Y ∧ s ≫ Limits.pullback.snd f f = f ≫ y₀ :=
    ⟨Limits.pullback.lift (𝟙 Y) (f ≫ y₀)
      (by rw [Category.id_comp, Category.assoc, hy₀, Category.comp_id]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨DΔ⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.diagonal f) ℓ
  obtain ⟨DI⟩ := wc_et_zmod_pull_data_exists (𝟙 Y) ℓ
  obtain ⟨Ds⟩ := wc_et_zmod_pull_data_exists s ℓ
  obtain ⟨Dy⟩ := wc_et_zmod_pull_data_exists y₀ ℓ
  obtain ⟨Df⟩ := wc_et_zmod_pull_data_exists f ℓ
  obtain ⟨Dfy⟩ := wc_et_zmod_pull_data_exists (f ≫ y₀) ℓ
  obtain ⟨u0, hu0⟩ := wc_et_point_supp_class_nonzero K Y f d ℓ hℓ y₀ hy₀ Dy
  obtain ⟨θ, hθ⟩ := wc_et_diag_supp_transversal_lift K Y f d ℓ hℓ y₀ hy₀ s hs₁ hs₂ DΔ Ds Dy u0
  obtain ⟨δ, hδ⟩ : ∃ δ : wcEtZModExt (Limits.pullback f f) ℓ (2 * d),
      δ = wcEtSuppClass DΔ (2 * d) θ := ⟨_, rfl⟩
  have hsδ : wcEtPull Ds (2 * d) δ ≠ 0 := by rw [hδ, hθ]; exact hu0

  have hD : ∀ (i k : ℕ) (hk : i + 2 * d = k) (x : wcEtZModExt Y ℓ i),
      wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) k hk (wcEtPull D1 i x) δ =
        wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) k hk (wcEtPull D2 i x) δ := by
    intro i k hk x
    have h1 := wc_et_pull_comp (Limits.pullback.fst f f) (Limits.pullback.diagonal f) (𝟙 Y)
      (Limits.pullback.diagonal_fst f) D1 DΔ DI i x
    have h2 := wc_et_pull_comp (Limits.pullback.snd f f) (Limits.pullback.diagonal f) (𝟙 Y)
      (Limits.pullback.diagonal_snd f) D2 DΔ DI i x
    have hx0 : wcEtPull DΔ i (wcEtPull D1 i x - wcEtPull D2 i x) = 0 := by
      rw [map_sub, ← h1, ← h2, sub_self]
    have hex := wc_et_finite_push_modules_exact (Limits.pullback.diagonal f) ℓ DΔ
    have h3 := hrz (Limits.pullback.diagonal f) ℓ DΔ hex (2 * d) i k hk θ _ hx0
    rw [← hδ, map_sub, AddMonoidHom.sub_apply, sub_eq_zero] at h3
    exact h3

  obtain ⟨Cl, hCl⟩ : ∃ Cl : AddSubgroup (wcEtZModExt (Limits.pullback f f) ℓ (2 * d)),
      Cl = AddSubgroup.closure {z | ∃ (a c : ℕ) (h : a + c = 2 * d) (x : wcEtZModExt Y ℓ a)
        (b : wcEtZModExt Y ℓ c), a < 2 * d ∧ z = wcEtZModCup (Limits.pullback f f) ℓ a c (2 * d) h
          (wcEtPull D1 a x) (wcEtPull D2 c b)} := ⟨_, rfl⟩
  have hgen2d : ∀ (a c : ℕ) (h : a + c = 2 * d) (x : wcEtZModExt Y ℓ a) (b : wcEtZModExt Y ℓ c),
      ¬ a < 2 * d → ∃ w : wcEtZModExt Y ℓ (2 * d),
        wcEtZModCup (Limits.pullback f f) ℓ a c (2 * d) h (wcEtPull D1 a x) (wcEtPull D2 c b) =
          wcEtPull D1 (2 * d) w := by
    intro a c h x b ha
    obtain rfl : c = 0 := by omega
    obtain rfl : a = 2 * d := by omega
    obtain ⟨k, rfl⟩ := hH0 b
    refine ⟨k • x, ?_⟩
    rw [map_zsmul (wcEtPull D2 0), hone D2,
      map_zsmul (wcEtZModCup (Limits.pullback f f) ℓ (2 * d) 0 (2 * d) h (wcEtPull D1 (2 * d) x)),
      map_zsmul (wcEtPull D1 (2 * d))]
    congr 1
    exact hrunit _ _ _ _
  have hQ : ∀ z : wcEtZModExt (Limits.pullback f f) ℓ (2 * d),
      ∃ w : wcEtZModExt Y ℓ (2 * d), z - wcEtPull D1 (2 * d) w ∈ Cl := by
    intro z
    have hz : z ∈ AddSubgroup.closure {z | ∃ (a c : ℕ) (h : a + c = 2 * d)
        (x : wcEtZModExt Y ℓ a) (b : wcEtZModExt Y ℓ c),
        z = wcEtZModCup (Limits.pullback f f) ℓ a c (2 * d) h (wcEtPull D1 a x)
          (wcEtPull D2 c b)} := by
      rw [(wc_et_modell_kunneth K Y f d ℓ hℓ D1 D2 (2 * d)).1]
      exact AddSubgroup.mem_top _
    refine AddSubgroup.closure_induction
      (p := fun z _ => ∃ w : wcEtZModExt Y ℓ (2 * d), z - wcEtPull D1 (2 * d) w ∈ Cl)
      ?_ ?_ ?_ ?_ hz
    · rintro z ⟨a, c, h, x, b, rfl⟩
      by_cases ha : a < 2 * d
      · refine ⟨0, ?_⟩
        rw [map_zero, sub_zero, hCl]
        exact AddSubgroup.subset_closure ⟨a, c, h, x, b, ha, rfl⟩
      · obtain ⟨w, hw⟩ := hgen2d a c h x b ha
        refine ⟨w, ?_⟩
        rw [hw, sub_self]
        exact zero_mem _
    · refine ⟨0, ?_⟩
      rw [map_zero, sub_zero]
      exact zero_mem _
    · rintro z₁ z₂ _ _ ⟨w₁, h₁⟩ ⟨w₂, h₂⟩
      refine ⟨w₁ + w₂, ?_⟩
      rw [map_add, add_sub_add_comm]
      exact add_mem h₁ h₂
    · rintro z _ ⟨w, hw⟩
      refine ⟨-w, ?_⟩
      have e : -z - wcEtPull D1 (2 * d) (-w) = -(z - wcEtPull D1 (2 * d) w) := by
        rw [map_neg]; abel
      rw [e]
      exact neg_mem hw
  obtain ⟨ω, hS⟩ := hQ δ

  have hker : Cl ≤ (wcEtPull Ds (2 * d)).ker := by
    rw [hCl, AddSubgroup.closure_le]
    rintro z ⟨a, c, h, x, b, ha, rfl⟩
    rw [SetLike.mem_coe, AddMonoidHom.mem_ker, hmul Ds a c (2 * d) h]
    have hb : wcEtPull Ds c (wcEtPull D2 c b) = 0 := by
      rw [← wc_et_pull_comp (Limits.pullback.snd f f) s (f ≫ y₀) hs₂ D2 Ds Dfy c b,
        wc_et_pull_comp y₀ f (f ≫ y₀) rfl Dy Df Dfy c b,
        hvan c (by omega) (wcEtPull Dy c b), map_zero]
    rw [hb, map_zero]
  have hω : ω ≠ 0 := by
    intro h0
    apply hsδ
    have h1 := hker hS
    rw [AddMonoidHom.mem_ker, map_sub, sub_eq_zero] at h1
    rw [h1, ← wc_et_pull_comp (Limits.pullback.fst f f) s (𝟙 Y) hs₁ D1 Ds DI (2 * d) ω, h0,
      map_zero]
  exact ⟨δ, ω, hω, hD, hCl ▸ hS⟩

theorem wc_et_modell_field_poincare_left : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (i j : ℕ) (h : i + j = 2 * d) (u : wcEtZModExt Y ℓ i), u ≠ 0 → ∃ w : wcEtZModExt Y ℓ j, wcEtZModCup Y ℓ i j (2 * d) h u w ≠ 0 :=
by
  classical
  intro K _ _ Y f _ d _ _ ℓ _ hℓ i j h u hu

  have hmul : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n) (a b c : ℕ)
      (hc : a + b = c) (x : wcEtZModExt S n a) (y : wcEtZModExt S n b),
      wcEtPull D c (wcEtZModCup S n a b c hc x y) =
        wcEtZModCup S' n a b c hc (wcEtPull D a x) (wcEtPull D b y) := by
    intro S S' g n D a b c hc x y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hc)).comp (Abelian.Ext.mk₀ D.μ.hom)
          (add_zero c)) (zero_add c) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        (zero_add a)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) hc
    rw [Abelian.Ext.mapExactFunctor_comp]
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) (zero_add b) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b) := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.hom) (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (add_zero 0) (zero_add b) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    symm
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (zero_add a) hc (by omega),
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x) (Abelian.Ext.mk₀ D.μ.hom)
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (add_zero a) (zero_add b) (by omega),
      e1,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x)
        (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) hc (add_zero b)
        (by omega)]

  have hone : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n),
      wcEtPull D 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S n)))) =
        @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
          (𝟙 (SheafOfModules.unit (wcEtZModRing S' n))) := by
    intro S S' g n D
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ
          (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S n))))).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0)) (zero_add 0) =
      Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S' n)))
    rw [Abelian.Ext.mapExactFunctor_mk₀, CategoryTheory.Functor.map_id, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀, Category.id_comp, Iso.inv_hom_id]

  have hrunit : ∀ (S : Scheme.{u}) (n m : ℕ) (z : wcEtZModExt S n m),
      wcEtZModCup S n m 0 m rfl z (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S n)))) = z := by
    intro S n m z
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    simp only [wcEtZModCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.comp_mk₀_id z

  obtain ⟨D1⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst f f) ℓ
  obtain ⟨D2⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd f f) ℓ
  obtain ⟨δ, ω, hω, hD, hS⟩ := wc_et_modell_diag_class_exists K Y f d ℓ hℓ D1 D2
  obtain ⟨κ, hL, hK, hT⟩ := wc_et_modell_slant_exists K Y f d ℓ hℓ D1 D2 ω hω
  by_contra hne
  push_neg at hne
  apply hu

  have hκ0 : κ 0 δ = @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
      (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) := by
    let κ0 : wcEtZModExt (Limits.pullback f f) ℓ (2 * d) →+ wcEtZModExt Y ℓ 0 := κ 0
    have key : δ - wcEtPull D1 (2 * d) ω ∈ κ0.ker := by
      refine (AddSubgroup.closure_le κ0.ker).mpr ?_ hS
      rintro z ⟨a, c, hac, x, b, ha, rfl⟩
      rw [SetLike.mem_coe, AddMonoidHom.mem_ker]
      exact hK 0 a c hac x b (by omega)
    have h0 := AddMonoidHom.mem_ker.mp key
    rw [map_sub, sub_eq_zero] at h0
    exact h0.trans hT

  have hB : κ (i + 0) (wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) (2 * d + (i + 0)) (by omega)
      (wcEtPull D2 i u) δ) = u := by
    have h1 := hL i 0 u δ
    rw [hκ0] at h1
    exact h1.trans (hrunit Y ℓ i u)

  have hA1 : κ (i + 0) (wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) (2 * d + (i + 0)) (by omega)
      (wcEtPull D1 i u) (wcEtPull D1 (2 * d) ω)) = 0 := by
    rw [← hmul D1 i (2 * d) (2 * d + (i + 0)) _ u ω]
    by_cases hi0 : i = 0
    · subst hi0
      have hj : j = 2 * d := by omega
      subst hj
      have h0 : wcEtZModCup Y ℓ 0 (2 * d) (2 * d + (0 + 0)) (by omega) u ω = 0 := hne ω
      rw [h0]
      simp only [map_zero]
    · have h1 := hK (i + 0) (2 * d + (i + 0)) 0 rfl
        (wcEtZModCup Y ℓ i (2 * d) (2 * d + (i + 0)) (by omega) u ω)
        (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
          (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ)))) (by omega)
      rw [hone D2, hrunit] at h1
      exact h1

  have hA2 : κ (i + 0) (wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) (2 * d + (i + 0)) (by omega)
      (wcEtPull D1 i u) (δ - wcEtPull D1 (2 * d) ω)) = 0 := by
    let Ψ : wcEtZModExt (Limits.pullback f f) ℓ (2 * d) →+ wcEtZModExt Y ℓ (i + 0) :=
      (κ (i + 0)).comp (wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) (2 * d + (i + 0))
        (by omega) (wcEtPull D1 i u))
    have key : δ - wcEtPull D1 (2 * d) ω ∈ Ψ.ker := by
      refine (AddSubgroup.closure_le Ψ.ker).mpr ?_ hS
      rintro z ⟨a, c, hac, x, b, ha, rfl⟩
      rw [SetLike.mem_coe, AddMonoidHom.mem_ker]
      show κ (i + 0) (wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) (2 * d + (i + 0)) (by omega)
        (wcEtPull D1 i u) (wcEtZModCup (Limits.pullback f f) ℓ a c (2 * d) hac
          (wcEtPull D1 a x) (wcEtPull D2 c b))) = 0
      by_cases hia : i + a = 2 * d
      · have hassoc : wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) (2 * d + (i + 0)) (by omega)
            (wcEtPull D1 i u) (wcEtZModCup (Limits.pullback f f) ℓ a c (2 * d) hac
              (wcEtPull D1 a x) (wcEtPull D2 c b)) =
            wcEtZModCup (Limits.pullback f f) ℓ (2 * d) c (2 * d + (i + 0)) (by omega)
              (wcEtZModCup (Limits.pullback f f) ℓ i a (2 * d) hia (wcEtPull D1 i u)
                (wcEtPull D1 a x)) (wcEtPull D2 c b) := by
          letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f f) ℓ)) :=
            HasExt.standard _
          simp only [wcEtZModCup, Abelian.Ext.bilinearComp_apply_apply]
          exact (Abelian.Ext.comp_assoc _ _ _ hia hac (by omega)).symm
        rw [hassoc, ← hmul D1 i a (2 * d) hia u x]
        have haj : a = j := by omega
        subst haj
        rw [hne x]
        simp only [map_zero, AddMonoidHom.zero_apply]
      · have hassoc : wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) (2 * d + (i + 0)) (by omega)
            (wcEtPull D1 i u) (wcEtZModCup (Limits.pullback f f) ℓ a c (2 * d) hac
              (wcEtPull D1 a x) (wcEtPull D2 c b)) =
            wcEtZModCup (Limits.pullback f f) ℓ (i + a) c (2 * d + (i + 0)) (by omega)
              (wcEtZModCup (Limits.pullback f f) ℓ i a (i + a) rfl (wcEtPull D1 i u)
                (wcEtPull D1 a x)) (wcEtPull D2 c b) := by
          letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f f) ℓ)) :=
            HasExt.standard _
          simp only [wcEtZModCup, Abelian.Ext.bilinearComp_apply_apply]
          exact (Abelian.Ext.comp_assoc _ _ _ rfl hac (by omega)).symm
        rw [hassoc, ← hmul D1 i a (i + a) rfl u x]
        exact hK (i + 0) (i + a) c (by omega) _ b hia
    exact AddMonoidHom.mem_ker.mp key

  have hA : κ (i + 0) (wcEtZModCup (Limits.pullback f f) ℓ i (2 * d) (2 * d + (i + 0)) (by omega)
      (wcEtPull D1 i u) δ) = 0 := by
    have hδ : δ = wcEtPull D1 (2 * d) ω + (δ - wcEtPull D1 (2 * d) ω) :=
      (add_sub_cancel _ _).symm
    rw [hδ, map_add, map_add, hA1, hA2]
    exact add_zero _

  have hDu := hD i (2 * d + (i + 0)) (by omega) u
  rw [hDu, hB] at hA
  exact hA

theorem wc_et_zmodext_top_exact_order : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (m : ℕ), 1 ≤ m → ∃ g : wcEtZModExt Y (ℓ ^ m) (2 * d), ℓ ^ (m - 1) • g ≠ 0 :=
by
  intro K _ _ Y f _ d _ _ ℓ _ hℓ m hm
  haveI hcyc : IsAddCyclic (wcEtZModExt Y (ℓ ^ m) (2 * d)) :=
    wc_et_zmodext_top_cyclic K Y f d ℓ hℓ m
  have hdim : topologicalKrullDim Y = (d : WithBot ℕ∞) :=
    le_antisymm (wc_smooth_alg_closed_dim_le K Y f d) (wc_smooth_irreducible_dim_ge K Y f d)
  have hc : ℓ ^ m ≤ Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d)) := by
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv Y (ℓ ^ m) (2 * d)
    rw [Nat.card_congr e]
    exact wc_et_top_coh_card_ge K Y f d hdim ℓ (Fact.out) hℓ m hm
  have hℓ1 : 1 < ℓ := (Fact.out : Nat.Prime ℓ).one_lt
  have hpos : 0 < Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d)) :=
    lt_of_lt_of_le (pow_pos (by omega) m) hc
  haveI : Finite (wcEtZModExt Y (ℓ ^ m) (2 * d)) := Nat.finite_of_card_ne_zero hpos.ne'
  obtain ⟨g, hg⟩ := IsAddCyclic.exists_generator (α := wcEtZModExt Y (ℓ ^ m) (2 * d))
  refine ⟨g, fun h0 => ?_⟩
  have hord : addOrderOf g = Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d)) :=
    addOrderOf_eq_card_of_forall_mem_zmultiples hg
  have hdvd := addOrderOf_dvd_of_nsmul_eq_zero h0
  rw [hord] at hdvd
  have hle := Nat.le_of_dvd (pow_pos (by omega) _) hdvd
  have hlt : ℓ ^ (m - 1) < ℓ ^ m := Nat.pow_lt_pow_right hℓ1 (by omega)
  omega

theorem finite_addCircle_dual_card_le : ∀ (B : Type*) [AddCommGroup B] [Finite B], Finite (B →+ AddCircle (1 : ℚ)) ∧ Nat.card (B →+ AddCircle (1 : ℚ)) ≤ Nat.card B :=
by
  intro B _ _
  classical
  have hle : AddSubgroup.zmultiples (1:ℚ) ≤
      AddSubgroup.comap (Rat.castHom ℝ).toAddMonoidHom (AddSubgroup.zmultiples (1:ℝ)) := by
    intro x hx
    obtain ⟨n, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
    rw [AddSubgroup.mem_comap]
    exact ⟨n, by simp⟩
  let ι : AddCircle (1:ℚ) →+ AddCircle (1:ℝ) :=
    QuotientAddGroup.map _ _ (Rat.castHom ℝ).toAddMonoidHom hle
  have hιq : ∀ q : ℚ, ι (q : AddCircle (1:ℚ)) = ((q:ℝ) : AddCircle (1:ℝ)) := fun q => rfl
  have hι : Function.Injective ι := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    induction x using QuotientAddGroup.induction_on with
    | H q =>
      change ι (q : AddCircle (1:ℚ)) = 0 at hx
      rw [hιq, AddCircle.coe_eq_zero_iff] at hx
      obtain ⟨n, hn⟩ := hx
      change (q : AddCircle (1:ℚ)) = 0
      rw [AddCircle.coe_eq_zero_iff]
      refine ⟨n, ?_⟩
      have h1 : ((n:ℚ):ℝ) = (q:ℝ) := by simpa using hn
      have h2 := Rat.cast_injective h1
      simp [h2]
  let Φ : (B →+ AddCircle (1:ℚ)) → AddChar B ℂ := fun φ =>
    { toFun := fun b => ((ι (φ b)).toCircle : ℂ)
      map_zero_eq_one' := by simp
      map_add_eq_mul' := by intro a b; simp [AddCircle.toCircle_add] }
  have hΦ : Function.Injective Φ := by
    intro φ ψ h
    ext b
    have h1 := DFunLike.congr_fun h b
    change ((ι (φ b)).toCircle : ℂ) = ((ι (ψ b)).toCircle : ℂ) at h1
    exact hι (AddCircle.injective_toCircle one_ne_zero (Circle.coe_injective h1))
  have hfin : Finite (B →+ AddCircle (1:ℚ)) := Finite.of_injective Φ hΦ
  refine ⟨hfin, ?_⟩
  calc Nat.card (B →+ AddCircle (1:ℚ)) ≤ Nat.card (AddChar B ℂ) :=
        Nat.card_le_card_of_injective Φ hΦ
    _ = Nat.card B := by
      haveI := Fintype.ofFinite B
      rw [Nat.card_eq_fintype_card, AddChar.card_eq, Nat.card_eq_fintype_card]

theorem wc_et_zmod_modell_perfect : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (m : ℕ), 1 ≤ m → ∀ η : @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) _ _ (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (2 * d) →+ AddCircle (1 : ℚ), Function.Injective η → ∀ (i j : ℕ) (h : i + j = 2 * d), Function.Bijective (fun x : @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) _ _ (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) i => η.comp (@Abelian.Ext.bilinearComp _ _ _ (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) i j (2 * d) h x)) :=
by
  classical
  intro K _ _ Y f _ d _ _ ℓ _ hℓ m hm η hη
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hzero := (wc_et_zmod_unit_pow_exact Y ℓ m hℓpos).1
  obtain ⟨G, hGa, hGl, hGc, q, w, ⟨hq⟩, hΦ⟩ := wc_et_zmod_restrict_unit_ext_bij Y ℓ m hm

  have hℓB : ℓ • 𝟙 (G.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) = 0 := by
    have hq0 : ℓ • q = 0 := by
      have hw := w
      rw [Preadditive.nsmul_comp, Category.id_comp, pow_one] at hw
      exact hw
    apply Limits.Cofork.IsColimit.hom_ext hq
    show q ≫ (ℓ • 𝟙 (G.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)))) = q ≫ 0
    rw [Preadditive.comp_nsmul, Limits.comp_zero]
    simpa using hq0

  have hcomp0 : ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) ≫
      ((ℓ ^ (m - 1)) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) = 0 := by
    rw [Preadditive.comp_nsmul, Category.comp_id, smul_smul, ← pow_add, Nat.sub_add_cancel hm]
    exact hzero
  obtain ⟨ι, hι⟩ : ∃ ι : G.obj (SheafOfModules.unit (wcEtZModRing Y ℓ)) ⟶
      SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)),
      q ≫ ι = (ℓ ^ (m - 1)) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) :=
    ⟨(Limits.CokernelCofork.IsColimit.desc' hq _ hcomp0).1,
      (Limits.CokernelCofork.IsColimit.desc' hq _ hcomp0).2⟩

  obtain ⟨κ⟩ : Nonempty (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))
      ≅ G.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) :=
    ⟨(Limits.cokernelIsCokernel _).coconePointUniqueUpToIso hq⟩

  have hmk : ∀ (T : SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) (k : ℕ),
      (Abelian.Ext.mk₀ (k • 𝟙 T) : Abelian.Ext T T 0) = k • Abelian.Ext.mk₀ (𝟙 T) := by
    intro T k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ k ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
  have hns : ∀ {X T : SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))} {n : ℕ}
      (α : Abelian.Ext X T n) (k : ℕ),
      α.comp (Abelian.Ext.mk₀ (k • 𝟙 T)) (add_zero n) = k • α := by
    intro X T n α k
    have hlin := map_nsmul (Abelian.Ext.bilinearComp X T T n 0 n (add_zero n) α) k
      (Abelian.Ext.mk₀ (𝟙 T))
    simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
    rw [Abelian.Ext.comp_mk₀_id] at hlin
    rw [hmk, hlin]
  have hκinv : ∀ (n : ℕ) (x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) n),
      (x.comp (Abelian.Ext.mk₀ κ.hom) (add_zero n)).comp (Abelian.Ext.mk₀ κ.inv) (add_zero n) = x := by
    intro n x
    rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ κ.hom) (Abelian.Ext.mk₀ κ.inv) (add_zero n)
      (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, κ.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  have hκhom : ∀ (n : ℕ) (x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (G.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) n),
      (x.comp (Abelian.Ext.mk₀ κ.inv) (add_zero n)).comp (Abelian.Ext.mk₀ κ.hom) (add_zero n) = x := by
    intro n x
    rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ κ.inv) (Abelian.Ext.mk₀ κ.hom) (add_zero n)
      (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, κ.inv_hom_id, Abelian.Ext.comp_mk₀_id]

  let eκ : ∀ n : ℕ, Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) n ≃
      Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
        (G.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) n := fun n =>
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ κ.hom) (add_zero n)
      invFun := fun x => x.comp (Abelian.Ext.mk₀ κ.inv) (add_zero n)
      left_inv := fun x => hκinv n x
      right_inv := fun x => hκhom n x }

  have hH : ∀ n, Finite (wcEtZModExt Y ℓ n) := fun n => by
    haveI := wc_etale_proper_finite K Y f ℓ hℓ n
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv Y ℓ n
    exact Finite.of_equiv _ e.symm
  have hcardAN : ∀ n, Nat.card (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) n) =
      Nat.card (wcEtZModExt Y ℓ n) := fun n => by
    rw [Nat.card_congr (eκ n)]
    exact (Nat.card_eq_of_bijective _ (hΦ n)).symm
  have hcardNA : ∀ n, Nat.card (Abelian.Ext
      (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
      (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) n) = Nat.card (wcEtZModExt Y ℓ n) := by
    intro n
    obtain ⟨e⟩ := wc_et_zmod_modell_unit_ext_equiv Y ℓ m hm n
    exact Nat.card_congr e
  have hfinNA : ∀ n, Finite (Abelian.Ext
      (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
      (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) n) := by
    intro n
    obtain ⟨e⟩ := wc_et_zmod_modell_unit_ext_equiv Y ℓ m hm n
    haveI := hH n
    exact Finite.of_equiv _ e.symm

  haveI hEfin : Finite (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (G.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) (2 * d)) := by
    haveI := hH (2 * d)
    exact Finite.of_equiv _ (Equiv.ofBijective _ (hΦ (2 * d)))
  have hEcard : Nat.card (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (G.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) (2 * d)) ≤ ℓ := by
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv Y ℓ (2 * d)
    rw [← Nat.card_eq_of_bijective _ (hΦ (2 * d)), Nat.card_congr e]
    exact (wc_et_top_coh_card_le K Y f d ℓ hℓ).2
  have hEtor : ∀ e : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (G.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) (2 * d), ℓ • e = 0 := fun e => by
    rw [← hns e ℓ, hℓB, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  let ρ : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (G.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) (2 * d) →+
      Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
        (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (2 * d) :=
    AddMonoidHom.mk' (fun e => e.comp (Abelian.Ext.mk₀ ι) (add_zero (2 * d)))
      (fun a b => Abelian.Ext.add_comp a b (Abelian.Ext.mk₀ ι) (add_zero (2 * d)))
  have hρ : ∀ e, ρ e = e.comp (Abelian.Ext.mk₀ ι) (add_zero (2 * d)) := fun _ => rfl
  obtain ⟨g, hg⟩ := wc_et_zmodext_top_exact_order K Y f d ℓ hℓ m hm
  have hρg : ρ (g.comp (Abelian.Ext.mk₀ q) (add_zero (2 * d))) = ℓ ^ (m - 1) • g := by
    rw [hρ, Abelian.Ext.comp_assoc g (Abelian.Ext.mk₀ q) (Abelian.Ext.mk₀ ι) (add_zero _)
      (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, hι, hns]
  have hρinj : ∀ e, ρ e = 0 → e = 0 := by
    intro e he
    by_contra hne
    have hord : addOrderOf e = ℓ := by
      rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd _
          (addOrderOf_dvd_of_nsmul_eq_zero (hEtor e)) with h1 | h1
      · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h1) hne
      · exact h1
    have htop : AddSubgroup.zmultiples e = ⊤ :=
      AddSubgroup.eq_top_of_le_card _ (by rw [Nat.card_zmultiples, hord]; exact hEcard)
    have hmem : g.comp (Abelian.Ext.mk₀ q) (add_zero (2 * d)) ∈ AddSubgroup.zmultiples e := by
      rw [htop]; exact AddSubgroup.mem_top _
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
    apply hg
    rw [← hρg, ← hk, map_zsmul, he, smul_zero]

  have core : ∀ (a b : ℕ) (hab : a + b = 2 * d)
      (x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
        (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) a),
      (∀ y : Abelian.Ext
        (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
        (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) b, x.comp y hab = 0) → x = 0 := by
    intro a b hab x hx
    obtain ⟨z, hz⟩ := (hΦ a).2 (x.comp (Abelian.Ext.mk₀ κ.hom) (add_zero a))
    have hz' : (Abelian.Ext.mk₀ q).comp (Abelian.Ext.mapExactFunctor G z) (zero_add a) =
        x.comp (Abelian.Ext.mk₀ κ.hom) (add_zero a) := hz
    by_cases hz0 : z = 0
    · have h0 : x.comp (Abelian.Ext.mk₀ κ.hom) (add_zero a) = 0 := by
        rw [← hz', hz0, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]
      rw [← hκinv a x, h0, Abelian.Ext.zero_comp]
    · obtain ⟨w', hw'⟩ := wc_et_modell_field_poincare_left K Y f d ℓ hℓ a b hab z hz0
      simp only [wcEtZModCup, Abelian.Ext.bilinearComp_apply_apply] at hw'
      have hxy := hx ((Abelian.Ext.mk₀ κ.hom).comp
        ((Abelian.Ext.mapExactFunctor G w').comp (Abelian.Ext.mk₀ ι) (add_zero b)) (zero_add b))
      rw [← Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ κ.hom) _ (add_zero a) (zero_add b)
        (by omega), ← hz',
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ q) (Abelian.Ext.mapExactFunctor G z) _
          (zero_add a) hab (by omega),
        ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor G z)
          (Abelian.Ext.mapExactFunctor G w') (Abelian.Ext.mk₀ ι) hab (add_zero b) (by omega),
        ← Abelian.Ext.mapExactFunctor_comp G z w' hab,
        ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ q) _ (Abelian.Ext.mk₀ ι) (zero_add (2 * d))
          (add_zero (2 * d)) (by omega)] at hxy
      have h1 : (Abelian.Ext.mk₀ q).comp (Abelian.Ext.mapExactFunctor G (z.comp w' hab))
          (zero_add (2 * d)) = 0 := hρinj _ (by rw [hρ]; exact hxy)
      exfalso
      apply hw'
      apply (hΦ (2 * d)).1
      beta_reduce
      rw [h1, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.comp_zero]

  have Dinj : ∀ (a b : ℕ) (hab : a + b = 2 * d), Function.Injective
      (fun x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
        (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) a =>
        η.comp (Abelian.Ext.bilinearComp (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
          (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
          (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) a b (2 * d) hab x)) := by
    intro a b hab x x' hxx
    beta_reduce at hxx
    rw [← sub_eq_zero]
    apply core a b hab
    intro y
    have h1 := DFunLike.congr_fun hxx y
    simp only [AddMonoidHom.comp_apply, Abelian.Ext.bilinearComp_apply_apply] at h1
    rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, hη h1, add_neg_cancel]

  intro i j h
  haveI := hfinNA j
  haveI := hfinNA i
  haveI := (finite_addCircle_dual_card_le (Abelian.Ext
      (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
      (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) j)).1
  haveI := (finite_addCircle_dual_card_le (Abelian.Ext
      (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
      (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) i)).1
  refine (Dinj i j h).bijective_of_nat_card_le ?_
  calc Nat.card (Abelian.Ext
        (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
        (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) j →+ AddCircle (1 : ℚ))
      ≤ Nat.card (Abelian.Ext
        (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
        (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) j) :=
        (finite_addCircle_dual_card_le _).2
    _ = Nat.card (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
        (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) j) := by
        rw [hcardNA, hcardAN]
    _ ≤ Nat.card (Abelian.Ext
        (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
        (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) i →+ AddCircle (1 : ℚ)) :=
        Nat.card_le_card_of_injective _ (Dinj j i (by omega))
    _ ≤ Nat.card (Abelian.Ext
        (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
        (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) i) :=
        (finite_addCircle_dual_card_le _).2
    _ = Nat.card (Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
        (Limits.cokernel ((ℓ ^ 1) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) i) := by
        rw [hcardNA, hcardAN]

theorem addCyclic_torsion_embeds_addCircle : ∀ (G : Type*) [AddCommGroup G] [IsAddCyclic G] (n : ℕ), 0 < n → (∀ g : G, n • g = 0) → ∃ η : G →+ AddCircle (1 : ℚ), Function.Injective η :=
by
  intro G _ _ n hn htor
  obtain ⟨g, hg⟩ := IsAddCyclic.exists_ofOrder_eq_natCard (α := G)
  have hdvd : addOrderOf g ∣ n := addOrderOf_dvd_of_nsmul_eq_zero (htor g)
  have hN : 0 < Nat.card G := by
    rw [← hg]; exact Nat.pos_of_dvd_of_pos hdvd hn
  set c : AddCircle (1 : ℚ) := ((1 / (Nat.card G : ℚ) : ℚ) : AddCircle (1 : ℚ)) with hc_def
  have hc : addOrderOf c = Nat.card G := AddCircle.addOrderOf_period_div hN
  have hkill : (zmultiplesHom (AddCircle (1 : ℚ)) c) ((Nat.card G : ℕ) : ℤ) = 0 := by
    rw [zmultiplesHom_apply, ← addOrderOf_dvd_iff_zsmul_eq_zero, hc]
  let ψ : ZMod (Nat.card G) →+ AddCircle (1 : ℚ) :=
    ZMod.lift (Nat.card G) ⟨zmultiplesHom (AddCircle (1 : ℚ)) c, hkill⟩
  have hψ : Function.Injective ψ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨a, rfl⟩ := ZMod.intCast_surjective x
    have h1 : ψ (a : ZMod (Nat.card G)) = a • c := by
      simp only [ψ, ZMod.lift_coe, zmultiplesHom_apply]
    rw [h1, ← addOrderOf_dvd_iff_zsmul_eq_zero, hc] at hx
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd a (Nat.card G)).mpr hx
  let e : ZMod (Nat.card G) ≃+ G := zmodAddCyclicAddEquiv ‹IsAddCyclic G›
  exact ⟨ψ.comp e.symm.toAddMonoidHom, hψ.comp e.symm.injective⟩

theorem wc_et_zmod_poincare_left (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u})
    (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f]
    [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (m : ℕ) (hm : 1 ≤ m) (i j : ℕ) (hk : i + j = 2 * d) :
    ∀ u : wcEtZModExt Y (ℓ ^ m) i,
      (∀ w : wcEtZModExt Y (ℓ ^ m) j, wcEtZModCup Y (ℓ ^ m) i j (2 * d) hk u w = 0) → u = 0 :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y (ℓ ^ m))) := HasExt.standard _
  intro u hu
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  obtain ⟨hzero, hexact⟩ := wc_et_zmod_unit_pow_exact Y ℓ m hℓpos

  have hmk : ∀ n : ℕ, Abelian.Ext.mk₀ (n • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) =
      n • Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) := by
    intro n
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ n ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
  have htors : ∀ g : wcEtZModExt Y (ℓ ^ m) (2 * d), (ℓ ^ m) • g = 0 := by
    intro g
    have hlin := map_nsmul (Abelian.Ext.bilinearComp (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
      (2 * d) 0 (2 * d) (add_zero _) g) (ℓ ^ m)
      (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
    simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
    rw [Abelian.Ext.comp_mk₀_id] at hlin
    rw [← hlin, ← hmk, hzero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  haveI hcyc : IsAddCyclic (wcEtZModExt Y (ℓ ^ m) (2 * d)) :=
    wc_et_zmodext_top_cyclic K Y f d ℓ hℓ m
  obtain ⟨η, hη⟩ := addCyclic_torsion_embeds_addCircle (wcEtZModExt Y (ℓ ^ m) (2 * d)) (ℓ ^ m)
    (pow_pos hℓpos m) htors

  have hP : ∀ k : ℕ, 1 ≤ k → k ≤ m →
      (∀ (a b : ℕ) (h : a + b = 2 * d), Function.Bijective
        (fun x : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
            (Limits.cokernel ((ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))) a =>
          η.comp (Abelian.Ext.bilinearComp (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
            (Limits.cokernel ((ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
            (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) a b (2 * d) h x))) ∧
      (∀ y : Abelian.Ext
          (Limits.cokernel ((ℓ ^ k) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
          (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (2 * d + 1), y = 0) := by
    intro k hk1
    induction k, hk1 using Nat.le_induction with
    | base =>
      intro _
      exact ⟨wc_et_zmod_modell_perfect K Y f d ℓ hℓ m hm η hη,
        wc_et_zmod_ext_modell_unit_vanish K Y f d ℓ hℓ m hm⟩
    | succ k hk ih =>
      intro hkm
      obtain ⟨ihB, ihV⟩ := ih (by omega)
      obtain ⟨f', g', w', hS⟩ := wc_coker_pow_ses (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))
        ℓ m hzero hexact k hk (by omega)
      exact wc_ext_pairing_devissage (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) (2 * d) η
        (ShortComplex.mk f' g' w') hS
        (wc_et_zmod_modell_perfect K Y f d ℓ hℓ m hm η hη) ihB
        (wc_et_zmod_ext_unit_modell_vanish K Y f d ℓ hℓ m hm)
        (wc_et_zmod_ext_modell_unit_vanish K Y f d ℓ hℓ m hm) ihV

  obtain ⟨hB, -⟩ := hP m hm le_rfl
  let pr := Limits.cokernel.π ((ℓ ^ m) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))
  let sc := Limits.cokernel.desc ((ℓ ^ m) • 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))))
    (𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))) (by rw [hzero, Limits.zero_comp])
  have hps : pr ≫ sc = 𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m))) :=
    Limits.cokernel.π_desc _ _ _
  have hx : u.comp (Abelian.Ext.mk₀ pr) (add_zero i) = 0 := by
    apply (hB i j hk).1
    show η.comp (Abelian.Ext.bilinearComp _ _ _ i j (2 * d) hk
        (u.comp (Abelian.Ext.mk₀ pr) (add_zero i))) =
      η.comp (Abelian.Ext.bilinearComp _ _ _ i j (2 * d) hk 0)
    rw [map_zero, AddMonoidHom.comp_zero]
    ext y
    rw [AddMonoidHom.comp_apply, Abelian.Ext.bilinearComp_apply_apply, AddMonoidHom.zero_apply,
      Abelian.Ext.comp_assoc u (Abelian.Ext.mk₀ pr) y (add_zero i) (zero_add j) (by omega)]
    have h0 := hu ((Abelian.Ext.mk₀ pr).comp y (zero_add j))
    simp only [wcEtZModCup, Abelian.Ext.bilinearComp_apply_apply] at h0
    rw [h0, map_zero]
  calc u = u.comp (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y (ℓ ^ m)))))
        (add_zero i) := (Abelian.Ext.comp_mk₀_id u).symm
    _ = u.comp ((Abelian.Ext.mk₀ pr).comp (Abelian.Ext.mk₀ sc) (add_zero 0)) (add_zero i) := by
        rw [Abelian.Ext.mk₀_comp_mk₀, hps]
    _ = (u.comp (Abelian.Ext.mk₀ pr) (add_zero i)).comp (Abelian.Ext.mk₀ sc) (add_zero i) :=
        (Abelian.Ext.comp_assoc _ _ _ _ _ (by omega)).symm
    _ = 0 := by rw [hx, Abelian.Ext.zero_comp]

theorem wc_et_zmod_poincare_nondegenerate (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u})
    (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f]
    [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : K) ≠ 0)
    (m : ℕ) (hm : 1 ≤ m) (i : ℕ) (hi : i ≤ 2 * d) :
    (∀ u : wcEtZModExt Y (ℓ ^ m) i,
      (∀ w : wcEtZModExt Y (ℓ ^ m) (2 * d - i),
        wcEtZModCup Y (ℓ ^ m) i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) u w = 0) → u = 0) ∧
    (∀ v : wcEtZModExt Y (ℓ ^ m) (2 * d - i),
      (∀ z : wcEtZModExt Y (ℓ ^ m) i,
        wcEtZModCup Y (ℓ ^ m) i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) z v = 0) → v = 0) :=
by
  classical

  have hn : ((ℓ ^ m : ℕ) : K) ≠ 0 := by
    rw [Nat.cast_pow]
    exact pow_ne_zero m hℓ
  have hfin : ∀ k : ℕ, Finite (wcEtZModExt Y (ℓ ^ m) k) := by
    intro k
    haveI := wc_etale_proper_finite K Y f (ℓ ^ m) hn k
    exact Finite.of_equiv _ (Classical.choice (wc_et_zmodext_coh_equiv Y (ℓ ^ m) k)).symm

  have hP := wc_et_zmod_poincare_left K Y f d ℓ hℓ m hm i (2 * d - i) (Nat.add_sub_cancel' hi)
  have hQ := wc_et_zmod_poincare_left K Y f d ℓ hℓ m hm (2 * d - i) i (Nat.sub_add_cancel hi)
  refine ⟨hP, ?_⟩

  haveI hcyc : IsAddCyclic (wcEtZModExt Y (ℓ ^ m) (2 * d)) :=
    wc_et_zmodext_top_cyclic K Y f d ℓ hℓ m
  haveI hA : Finite (wcEtZModExt Y (ℓ ^ m) i) := hfin i
  haveI hB : Finite (wcEtZModExt Y (ℓ ^ m) (2 * d - i)) := hfin (2 * d - i)
  haveI hC : Finite (wcEtZModExt Y (ℓ ^ m) (2 * d)) := hfin (2 * d)
  have hcard : ∀ (G : Type (u+2)) [AddCommGroup G] [Finite G],
      Nat.card (G →+ wcEtZModExt Y (ℓ ^ m) (2 * d)) ≤ Nat.card G := by
    intro G _ _
    haveI : NeZero (Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d))) := ⟨Nat.card_pos.ne'⟩
    let e : ZMod (Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d))) ≃+ wcEtZModExt Y (ℓ ^ m) (2 * d) :=
      zmodAddCyclicAddEquiv hcyc
    let Φ : (G →+ wcEtZModExt Y (ℓ ^ m) (2 * d)) → AddChar G ℂ := fun φ =>
      (ZMod.stdAddChar (N := Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d)))).compAddMonoidHom
        (e.symm.toAddMonoidHom.comp φ)
    have hΦ : Function.Injective Φ := by
      intro φ ψ h
      ext g
      have h1 : Φ φ g = Φ ψ g := by rw [h]
      have h2 := ZMod.injective_stdAddChar h1
      exact e.symm.injective h2
    letI := Fintype.ofFinite G
    have hc : Nat.card (AddChar G ℂ) = Nat.card G := by
      rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, AddChar.card_eq]
    calc Nat.card (G →+ wcEtZModExt Y (ℓ ^ m) (2 * d)) ≤ Nat.card (AddChar G ℂ) :=
          Nat.card_le_card_of_injective Φ hΦ
      _ = Nat.card G := hc
  intro b hb
  by_contra hb0
  let S := AddSubgroup.zmultiples b
  have hS : 1 < Nat.card S := by
    rw [Finite.one_lt_card_iff_nontrivial]
    exact ⟨⟨⟨0, S.zero_mem⟩, ⟨b, AddSubgroup.mem_zmultiples b⟩,
      fun h => hb0 (congrArg Subtype.val h).symm⟩⟩
  have hBc := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup S
  have hlt : Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d - i) ⧸ S) <
      Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d - i)) := by
    rw [hBc]
    have h0 : 0 < Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d - i) ⧸ S) := Nat.card_pos
    nlinarith
  have hker : ∀ a, S ≤
      (wcEtZModCup Y (ℓ ^ m) i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) a).ker := fun a => by
    rw [AddSubgroup.zmultiples_le]
    exact AddMonoidHom.mem_ker.mpr (hb a)
  let ψ : wcEtZModExt Y (ℓ ^ m) i →
      (wcEtZModExt Y (ℓ ^ m) (2 * d - i) ⧸ S →+ wcEtZModExt Y (ℓ ^ m) (2 * d)) := fun a =>
    QuotientAddGroup.lift S
      (wcEtZModCup Y (ℓ ^ m) i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) a) (hker a)
  have hψ : Function.Injective ψ := by
    intro a a' h
    have hx : ∀ x, wcEtZModCup Y (ℓ ^ m) i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi)
        (a - a') x = 0 := by
      intro x
      have h1 : ψ a (x : wcEtZModExt Y (ℓ ^ m) (2 * d - i) ⧸ S) =
          ψ a' (x : wcEtZModExt Y (ℓ ^ m) (2 * d - i) ⧸ S) := by rw [h]
      simp only [ψ, QuotientAddGroup.lift_mk] at h1
      rw [map_sub, AddMonoidHom.sub_apply, h1, sub_self]
    exact sub_eq_zero.mp (hP _ hx)
  have h1 : Nat.card (wcEtZModExt Y (ℓ ^ m) i) ≤
      Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d - i) ⧸ S) := by
    haveI : Finite (wcEtZModExt Y (ℓ ^ m) (2 * d - i) ⧸ S →+ wcEtZModExt Y (ℓ ^ m) (2 * d)) :=
      Finite.of_injective _ DFunLike.coe_injective
    exact (Nat.card_le_card_of_injective ψ hψ).trans (hcard _)
  have hQinj : Function.Injective (fun b' : wcEtZModExt Y (ℓ ^ m) (2 * d - i) =>
      wcEtZModCup Y (ℓ ^ m) (2 * d - i) i (2 * d) (Nat.sub_add_cancel hi) b') := by
    intro b' b'' h
    have hx : ∀ a, wcEtZModCup Y (ℓ ^ m) (2 * d - i) i (2 * d) (Nat.sub_add_cancel hi)
        (b' - b'') a = 0 := by
      intro a
      have h2 : wcEtZModCup Y (ℓ ^ m) (2 * d - i) i (2 * d) (Nat.sub_add_cancel hi) b' a =
          wcEtZModCup Y (ℓ ^ m) (2 * d - i) i (2 * d) (Nat.sub_add_cancel hi) b'' a := by
        simp only at h
        rw [h]
      rw [map_sub, AddMonoidHom.sub_apply, h2, sub_self]
    exact sub_eq_zero.mp (hQ _ hx)
  have h2 : Nat.card (wcEtZModExt Y (ℓ ^ m) (2 * d - i)) ≤ Nat.card (wcEtZModExt Y (ℓ ^ m) i) := by
    haveI : Finite (wcEtZModExt Y (ℓ ^ m) i →+ wcEtZModExt Y (ℓ ^ m) (2 * d)) :=
      Finite.of_injective _ DFunLike.coe_injective
    exact (Nat.card_le_card_of_injective _ hQinj).trans (hcard _)
  omega

theorem wc_tormod_duality (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (i : ℕ) (hi : i ≤ 2 * d) (m : ℕ) (hm : 1 ≤ m) :
    (∀ a : wcIntModCoh F X h ℓ i, ℓ ^ (m - 1) • wcTorRed F X h ℓ m i a ≠ 0 →
      ∃ c : wcTorModCoh F X h ℓ m (2 * d - i),
        ℓ ^ (m - 1) • wcIntTorAct F X h ℓ m i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) a c ≠ 0) ∧
    (∀ b : wcIntModCoh F X h ℓ (2 * d - i), ℓ ^ (m - 1) • wcTorRed F X h ℓ m (2 * d - i) b ≠ 0 →
      ∃ c : wcTorModCoh F X h ℓ m i, ∀ (e : ℕ) (a : wcIntModCoh F X h ℓ i), e < m →
        wcTorRed F X h ℓ m i a = ℓ ^ e • c →
        ℓ ^ (m - 1 - e) • wcIntTorAct F X h ℓ m i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) a
          (wcTorRed F X h ℓ m (2 * d - i) b) ≠ 0) :=
by
  classical
  obtain ⟨Φ, hΦ⟩ := wc_tormod_ring_comparison F X h ℓ m hm
  obtain ⟨Ψ₁, hΨ₁⟩ := wc_zmodslice_proet_comparison F X h (ℓ ^ m)
  let fY : (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F)) :=
    Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  haveI hprop : IsProper fY :=
    (show IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :
        (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F))) from inferInstance)
  haveI hsmooth : SmoothOfRelativeDimension d fY :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) ‹_›
  haveI hirr : IrreducibleSpace (wcGeomPoint F X h).left :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (IsPullback.of_hasPullback _ _)
  have hne : (ℓ : AlgebraicClosure F) ≠ 0 := by
    intro h0
    have hp : ringChar F ∣ ℓ :=
      (CharP.cast_eq_zero_iff (AlgebraicClosure F) (ringChar F) ℓ).mp h0
    have hpp : Nat.Prime (ringChar F) := CharP.char_is_prime F (ringChar F)
    have hpl : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hp
    letI := Fintype.ofFinite F
    have hc : ((Nat.card F : ℕ) : F) = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F
    have hdvd : ringChar F ∣ Nat.card F := (ringChar.spec F _).mp hc
    exact hℓ (hpl ▸ hdvd)
  have hn : 0 < ℓ ^ m := pow_pos (Fact.out : Nat.Prime ℓ).pos m
  obtain ⟨Ψ₂, hΨ₂⟩ := wc_zmod_proet_etale_mod_comparison (AlgebraicClosure F)
    (wcGeomPoint F X h).left fY (ℓ ^ m) hn
  obtain ⟨hL, hR⟩ := wc_et_zmod_poincare_nondegenerate (AlgebraicClosure F)
    (wcGeomPoint F X h).left fY d ℓ hne m hm i hi
  let Θ : ∀ n, wcZModSliceCoh F X h (ℓ ^ m) n ≃+ wcEtZModExt (wcGeomPoint F X h).left (ℓ ^ m) n :=
    fun n => (Ψ₁ n).trans (Ψ₂ n)
  have hΘ : ∀ (x : wcZModSliceCoh F X h (ℓ ^ m) i) (y : wcZModSliceCoh F X h (ℓ ^ m) (2 * d - i)),
      Θ (2 * d) (wcZModSliceCup F X h (ℓ ^ m) i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) x y) =
        wcEtZModCup (wcGeomPoint F X h).left (ℓ ^ m) i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi)
          (Θ i x) (Θ (2 * d - i) y) := by
    intro x y
    simp only [Θ, AddEquiv.trans_apply]
    rw [hΨ₁, hΨ₂]
  constructor
  · intro a ha
    obtain ⟨x, hax⟩ : ∃ x, wcTorRed F X h ℓ m i a = Φ i x :=
      ⟨_, (AddEquiv.apply_symm_apply _ _).symm⟩
    have hu : ℓ ^ (m - 1) • Θ i x ≠ 0 := by
      intro h0
      rw [← map_nsmul, AddEquiv.map_eq_zero_iff] at h0
      apply ha
      rw [hax, ← map_nsmul, h0, map_zero]
    by_contra hcon
    push_neg at hcon
    apply hu
    apply hL
    intro w
    have h1 := hcon (Φ (2 * d - i) ((Θ (2 * d - i)).symm w))
    rw [hΦ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) a x ((Θ (2 * d - i)).symm w) hax,
      ← map_nsmul (Φ (2 * d)), AddEquiv.map_eq_zero_iff] at h1
    rw [map_nsmul, AddMonoidHom.nsmul_apply]
    rw [← AddEquiv.apply_symm_apply (Θ (2 * d - i)) w, ← hΘ, ← map_nsmul (Θ (2 * d)), h1,
      map_zero]
  · intro b hb
    obtain ⟨yb, hby⟩ : ∃ yb, wcTorRed F X h ℓ m (2 * d - i) b = Φ (2 * d - i) yb :=
      ⟨_, (AddEquiv.apply_symm_apply _ _).symm⟩
    have hv : ℓ ^ (m - 1) • Θ (2 * d - i) yb ≠ 0 := by
      intro h0
      rw [← map_nsmul, AddEquiv.map_eq_zero_iff] at h0
      apply hb
      rw [hby, ← map_nsmul, h0, map_zero]
    obtain ⟨z, hz⟩ : ∃ z, wcEtZModCup (wcGeomPoint F X h).left (ℓ ^ m) i (2 * d - i) (2 * d)
        (Nat.add_sub_cancel' hi) z (ℓ ^ (m - 1) • Θ (2 * d - i) yb) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hv (hR _ hcon)
    refine ⟨Φ i ((Θ i).symm z), fun e a he hae => ?_⟩
    rw [← map_nsmul (Φ i)] at hae
    rw [hby, hΦ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) a _ yb hae,
      ← map_nsmul (Φ (2 * d)), Ne, AddEquiv.map_eq_zero_iff]
    rw [map_nsmul, AddMonoidHom.nsmul_apply, smul_smul, ← pow_add,
      show m - 1 - e + e = m - 1 by omega]
    intro h0
    apply hz
    rw [map_nsmul, ← AddEquiv.apply_symm_apply (Θ i) z, ← hΘ, ← map_nsmul (Θ (2 * d)), h0,
      map_zero]

theorem wc_modcup_perfect (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (i : ℕ) (hi : i ≤ 2 * d) :
    (∀ x : wcModCoh F X h ℓ i,
      (∀ y : wcModCoh F X h ℓ (2 * d - i),
        wcModCup F X h ℓ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) x y = 0) → x = 0) ∧
    (∀ y : wcModCoh F X h ℓ (2 * d - i),
      (∀ x : wcModCoh F X h ℓ i,
        wcModCup F X h ℓ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) x y = 0) → y = 0) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _
  obtain ⟨ι, hmul, hsurj, hker⟩ := wc_intmodcoh_rationalization F X h ℓ
  have tf := wc_modcoh_ell_torsionfree F X h ℓ

  have hT : ∀ n : ℕ, ∃ e : ℕ, ∀ a : wcIntModCoh F X h ℓ n,
      (∃ r : ℕ, ℓ ^ r • a = 0) → ℓ ^ e • a = 0 := by
    intro n
    obtain ⟨inst, fin⟩ := wc_intmodcoh_fg F X d ℓ hℓ h n
    exact (padic_fg_torsion_primitive ℓ (wcIntModCoh F X h ℓ n)).1

  have hP : ∀ (n : ℕ) (a : wcIntModCoh F X h ℓ n), (∀ r : ℕ, ℓ ^ r • a ≠ 0) →
      ∃ (s : ℕ) (a₀ τ : wcIntModCoh F X h ℓ n), a = ℓ ^ s • a₀ + τ ∧
        (∃ r : ℕ, ℓ ^ r • τ = 0) ∧
        ∀ (m : ℕ) (z : wcIntModCoh F X h ℓ n), ℓ ^ m • a₀ ≠ ℓ ^ (m + 1) • z := by
    intro n
    obtain ⟨inst, fin⟩ := wc_intmodcoh_fg F X d ℓ hℓ h n
    exact (padic_fg_torsion_primitive ℓ (wcIntModCoh F X h ℓ n)).2

  have F3 : ∀ (m j k : ℕ) (hk : i + j = k) (a : wcIntModCoh F X h ℓ i)
      (b : wcIntModCoh F X h ℓ j),
      wcIntTorAct F X h ℓ m i j k hk a (wcTorRed F X h ℓ m j b) =
        wcTorRed F X h ℓ m k (wcIntModCup F X h ℓ i j k hk a b) := by
    intro m j k hk a b
    exact (Abelian.Ext.comp_assoc a b
      (Abelian.Ext.mk₀ (Limits.cokernel.π
        ((ℓ ^ m : ℕ) • 𝟙 (SheafOfModules.unit (wcIntSliceRing F X h ℓ)))))
      hk (add_zero j) (by omega)).symm

  have hlift_nt : ∀ (n k : ℕ) (x : wcModCoh F X h ℓ n) (a : wcIntModCoh F X h ℓ n),
      x ≠ 0 → ι n a = ℓ ^ k • x → ∀ r : ℕ, ℓ ^ r • a ≠ 0 := by
    intro n k x a hx0 ha r hr
    apply hx0
    apply tf n (r + k) x
    rw [pow_add, mul_smul, ← ha, ← map_nsmul, hr, map_zero]
  have hιtors : ∀ (n r : ℕ) (τ : wcIntModCoh F X h ℓ n), ℓ ^ r • τ = 0 → ι n τ = 0 := by
    intro n r τ hτ
    exact tf n r _ (by rw [← map_nsmul, hτ, map_zero])

  have hnt_of : ∀ (m e₂ : ℕ), (∀ a : wcIntModCoh F X h ℓ (2 * d),
      (∃ r : ℕ, ℓ ^ r • a = 0) → ℓ ^ e₂ • a = 0) →
      ∀ z : wcIntModCoh F X h ℓ (2 * d), ℓ ^ e₂ • wcTorRed F X h ℓ m (2 * d) z ≠ 0 →
        ι (2 * d) z ≠ 0 := by
    intro m e₂ he₂ z hz h0
    obtain ⟨r, hr⟩ := hker _ _ h0
    apply hz
    rw [← map_nsmul, he₂ _ ⟨r, hr⟩, map_zero]
  constructor
  ·
    intro x hx
    by_contra hx0
    obtain ⟨k, a, ha⟩ := hsurj i x
    obtain ⟨s, a₀, τ, hdec, ⟨r, hτ⟩, hprim⟩ := hP i a (hlift_nt i k x a hx0 ha)
    have hx' : ℓ ^ k • x = ℓ ^ s • ι i a₀ := by
      rw [← ha, hdec, map_add, map_nsmul, hιtors i r τ hτ, add_zero]
    obtain ⟨e, he⟩ := hT (2 * d - i + 1)
    obtain ⟨e₂, he₂⟩ := hT (2 * d)
    obtain ⟨m, hm⟩ : ∃ m : ℕ, m = e + e₂ + 1 := ⟨_, rfl⟩
    have hm1 : 1 ≤ m := by omega
    have hred : ℓ ^ (m - 1) • wcTorRed F X h ℓ m i a₀ ≠ 0 := by
      intro h0
      rw [← map_nsmul] at h0
      obtain ⟨z, hz⟩ := (wc_tormod_les F X h ℓ m i).1 _ h0
      exact hprim (m - 1) z (by rw [show m - 1 + 1 = m by omega]; exact hz)
    obtain ⟨c, hc⟩ := (wc_tormod_duality F X d ℓ hℓ h i hi m hm1).1 a₀ hred
    obtain ⟨b, hb⟩ := (wc_tormod_les F X h ℓ m (2 * d - i)).2 e c (fun w hw => he w ⟨m, hw⟩)
    have hcup_red : ℓ ^ e₂ • wcTorRed F X h ℓ m (2 * d)
        (wcIntModCup F X h ℓ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) a₀ b) ≠ 0 := by
      rw [← F3, hb, map_nsmul, ← mul_smul, ← pow_add, show e₂ + e = m - 1 by omega]
      exact hc
    have hι0 := hnt_of m e₂ he₂ _ hcup_red
    rw [hmul] at hι0
    apply hι0
    apply tf (2 * d) s
    have key : ∀ (n : ℕ) (u : wcModCoh F X h ℓ i) (v : wcModCoh F X h ℓ (2 * d - i)),
        wcModCup F X h ℓ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) (n • u) v =
          n • wcModCup F X h ℓ i (2 * d - i) (2 * d) (Nat.add_sub_cancel' hi) u v := by
      intro n u v
      rw [map_nsmul, AddMonoidHom.nsmul_apply]
    rw [← key, ← hx', key, hx _, smul_zero]
  ·
    intro y hy
    by_contra hy0
    obtain ⟨k, b, hb⟩ := hsurj (2 * d - i) y
    obtain ⟨s, b₀, τ, hdec, ⟨r, hτ⟩, hprim⟩ :=
      hP (2 * d - i) b (hlift_nt (2 * d - i) k y b hy0 hb)
    have hy' : ℓ ^ k • y = ℓ ^ s • ι (2 * d - i) b₀ := by
      rw [← hb, hdec, map_add, map_nsmul, hιtors (2 * d - i) r τ hτ, add_zero]
    obtain ⟨e, he⟩ := hT (i + 1)
    obtain ⟨e₂, he₂⟩ := hT (2 * d)
    obtain ⟨m, hm⟩ : ∃ m : ℕ, m = e + e₂ + 1 := ⟨_, rfl⟩
    have hm1 : 1 ≤ m := by omega
    have hred : ℓ ^ (m - 1) • wcTorRed F X h ℓ m (2 * d - i) b₀ ≠ 0 := by
      intro h0
      rw [← map_nsmul] at h0
      obtain ⟨z, hz⟩ := (wc_tormod_les F X h ℓ m (2 * d - i)).1 _ h0
      exact hprim (m - 1) z (by rw [show m - 1 + 1 = m by omega]; exact hz)
    obtain ⟨c, hc⟩ := (wc_tormod_duality F X d ℓ hℓ h i hi m hm1).2 b₀ hred
    obtain ⟨a, ha⟩ := (wc_tormod_les F X h ℓ m i).2 e c (fun w hw => he w ⟨m, hw⟩)
    have h1 := hc e a (by omega) ha
    rw [show m - 1 - e = e₂ by omega, F3] at h1
    have hι0 := hnt_of m e₂ he₂ _ h1
    rw [hmul] at hι0
    apply hι0
    apply tf (2 * d) s
    rw [← map_nsmul, ← hy', map_nsmul, hy _, smul_zero]

theorem wc_top_coh_nonzero (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    ∃ x : wcCoh F X h ℓ (2 * d), x ≠ 0 :=
by
  classical

  haveI hirr : IrreducibleSpace ↥(Limits.pullback X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
  obtain ⟨p⟩ : Nonempty ↥(Limits.pullback X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    IrreducibleSpace.toNonempty
  letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _

  let x₀ : wcModCoh F X h ℓ 0 := Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcSliceRing F X h ℓ)))
  have hx₀ : x₀ ≠ 0 := by
    intro h0
    have hid : 𝟙 (SheafOfModules.unit (wcSliceRing F X h ℓ)) = 0 :=
      (Abelian.Ext.mk₀_eq_zero_iff _).mp h0
    have hall : ∀ f : SheafOfModules.unit (wcSliceRing F X h ℓ) ⟶
        SheafOfModules.unit (wcSliceRing F X h ℓ), f = 0 := by
      intro f
      calc f = 𝟙 _ ≫ f := (Category.id_comp f).symm
        _ = 0 ≫ f := by rw [hid]
        _ = 0 := Limits.zero_comp
    have h01 : wcModConst F X h ℓ 0 = wcModConst F X h ℓ 1 := by
      rw [hall (wcModConst F X h ℓ 0), hall (wcModConst F X h ℓ 1)]
    have h2 := congrArg (SheafOfModules.unitHomEquiv _) h01
    simp only [wcModConst, Equiv.apply_symm_apply] at h2
    have h3 : (ContinuousMap.const ↥((Over.mk (𝟙 (wcGeomPoint F X h))).left.left)
          (ULift.up (0 : ℚ_[ℓ])) : C(_, ULift.{u+1} ℚ_[ℓ])) =
        ContinuousMap.const ↥((Over.mk (𝟙 (wcGeomPoint F X h))).left.left)
          (ULift.up (1 : ℚ_[ℓ])) :=
      congrArg (fun s => s.1 (Opposite.op (Over.mk (𝟙 (wcGeomPoint F X h))))) h2
    have h4 : (0 : ℚ_[ℓ]) = 1 := congrArg (fun g => (g p).down) h3
    exact zero_ne_one h4

  obtain ⟨T, -, -⟩ := wc_modcoh_comparison F X h ℓ
  have hP := (wc_modcup_perfect F X d ℓ hℓ h 0 (Nat.zero_le _)).1 x₀
  obtain ⟨y, hy⟩ := not_forall.mp (fun hall => hx₀ (hP hall))
  refine ⟨(T (2 * d)).symm
    (wcModCup F X h ℓ 0 (2 * d - 0) (2 * d) (Nat.add_sub_cancel' (Nat.zero_le _)) x₀ y), ?_⟩
  intro hx
  apply hy
  have hT := congrArg (T (2 * d)) hx
  rw [AddEquiv.apply_symm_apply, map_zero] at hT
  exact hT

theorem wc_rtsp_prim_root : ∀ (F : Type u) [Finite F] [Field F] (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    ¬ ℓ ∣ Nat.card F → ∀ n : ℕ, ∃ ζ : AlgebraicClosure F, IsPrimitiveRoot ζ (ℓ ^ n) ∧
      IsUnit ((ℓ ^ n : ℕ) : AlgebraicClosure F) :=
by
  intro F _ _ ℓ hℓfact hℓ n
  have hℓp : Nat.Prime ℓ := hℓfact.out
  have hp : Nat.Prime (ringChar F) := CharP.char_is_prime F (ringChar F)
  have hdvd : ringChar F ∣ Nat.card F := by
    letI := Fintype.ofFinite F
    apply ringChar.dvd
    rw [Nat.card_eq_fintype_card]
    exact FiniteField.cast_card_eq_zero F
  have hℓK : (ℓ : AlgebraicClosure F) ≠ 0 := by
    intro h0
    have h1 : ringChar (AlgebraicClosure F) ∣ ℓ := ringChar.dvd h0
    rw [← Algebra.ringChar_eq F (AlgebraicClosure F)] at h1
    have h2 : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hp hℓp).mp h1
    exact hℓ (h2 ▸ hdvd)
  have hne : ((ℓ ^ n : ℕ) : AlgebraicClosure F) ≠ 0 := by
    rw [Nat.cast_pow]
    exact pow_ne_zero n hℓK
  haveI : NeZero ((ℓ ^ n : ℕ) : AlgebraicClosure F) := ⟨hne⟩
  haveI : HasEnoughRootsOfUnity (AlgebraicClosure F) (ℓ ^ n) :=
    IsSepClosed.hasEnoughRootsOfUnity (AlgebraicClosure F) (ℓ ^ n)
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure F) (ℓ ^ n)
  exact ⟨ζ, hζ, isUnit_iff_ne_zero.mpr hne⟩

theorem wc_rtsp_geom_root : ∀ (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (m : ℕ) (ζ : AlgebraicClosure F),
    IsPrimitiveRoot ζ m → IsUnit ((m : ℕ) : AlgebraicClosure F) →
    (∀ (V : Over (wcGeomPoint F X h)) (z : V.left.left),
        IsPrimitiveRoot ((V.left.left.evaluation ⊤ z trivial).hom
          ((V.hom.left ≫ Limits.pullback.snd X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
              ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ))) m) ∧
    (∀ V : Over (wcGeomPoint F X h), IsUnit ((m : ℕ) : Γ(V.left.left, ⊤))) ∧
    (∀ V : Over (wcGeomPoint F X h),
      ((V.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ) :
            Γ(V.left.left, ⊤)) ^ m = 1) ∧
    (∀ (V V' : Over (wcGeomPoint F X h)) (g : V' ⟶ V),
      ((V'.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ) :
            Γ(V'.left.left, ⊤)) =
        g.left.left.appTop.hom
          ((V.hom.left ≫ Limits.pullback.snd X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
              ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ))) :=
by
  intro F _ _ X h m ζ hζ hmu
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro V z
    let χ : AlgebraicClosure F →+* V.left.left.residueField z :=
      ((V.left.left.evaluation ⊤ z trivial).hom.comp
        ((V.hom.left ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom)).comp
        (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom
    exact hζ.map_of_injective (f := χ) χ.injective
  · intro V
    have := hmu.map (((V.hom.left ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom).comp
        (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom)
    rwa [map_natCast] at this
  · intro V
    rw [← map_pow, ← map_pow, hζ.pow_eq_one, map_one, map_one]
  · intro V V' g
    have hw : g.left.left ≫ V.hom.left = V'.hom.left := by
      first
        | exact congrArg (fun k => k.left) (Over.w g)
        | (have hg := Over.w g; rw [← hg]; rfl)
        | (have hg := Over.w g; rw [← hg]; simp)
        | simp
    have key : V'.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        g.left.left ≫ (V.hom.left ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
      (congrArg (fun k => k ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) hw).symm.trans
        (Category.assoc _ _ _)
    first
      | (rw [key, Scheme.Hom.comp_appTop]; rfl)
      | exact (congrArg (fun φ => φ.appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ)) key).trans
          (by rw [Scheme.Hom.comp_appTop]; rfl)

theorem wc_rtsp_geom_root_frob : ∀ (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ζ : AlgebraicClosure F) (V : Over (wcGeomPoint F X h)),
    ((V.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ) : Γ(V.left.left, ⊤)) =
      ((((Over.mk (V.hom ≫ wcGeomFrob F X h)).hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ) :
            Γ((Over.mk (V.hom ≫ wcGeomFrob F X h)).left.left, ⊤))) ^ Nat.card F :=
by
  intro F _ _ X h ζ V
  have hζ : ζ = ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
      (AlgebraicClosure F) _ _ _).symm : AlgebraicClosure F →+* AlgebraicClosure F) ζ ^
        Nat.card F := by
    rw [← @Fintype.card_eq_nat_card F (Fintype.ofFinite F)]
    rw [← @FiniteField.frobeniusAlgEquivOfAlgebraic_apply F _ (Fintype.ofFinite F)
      (AlgebraicClosure F) _ _ _]
    exact ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
      (AlgebraicClosure F) _ _ _).apply_symm_apply ζ).symm
  have hsnd : (Over.mk (V.hom ≫ wcGeomFrob F X h)).hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      (V.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) ≫
        Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _
          (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm :
            AlgebraicClosure F →+* AlgebraicClosure F)) := by
    exact (Category.assoc V.hom.left (wcGeomFrob F X h).left (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).trans
      ((congrArg (fun g => V.hom.left ≫ g) (Limits.pullback.lift_snd _ _ _)).trans
        (Category.assoc _ _ _).symm)
  have hnat : (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom
        (((@FiniteField.frobeniusAlgEquivOfAlgebraic F _
          (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm :
            AlgebraicClosure F →+* AlgebraicClosure F) ζ) =
      (Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _
          (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm :
            AlgebraicClosure F →+* AlgebraicClosure F))).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ) :=
    congrArg (fun φ => φ.hom ζ) (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _
          (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm :
            AlgebraicClosure F →+* AlgebraicClosure F)))
  rw [hsnd, Scheme.Hom.comp_appTop]
  show _ = ((V.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
      ((Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _
          (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm :
            AlgebraicClosure F →+* AlgebraicClosure F))).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ))) ^ Nat.card F
  rw [← hnat, ← map_pow, ← map_pow, ← hζ]

theorem wc_rtsp_dlog_exists : ∀ (Z : Scheme.{u}) (m : ℕ) [NeZero m] (ω : Γ(Z, ⊤)),
    (∀ z : Z, IsPrimitiveRoot ((Z.evaluation ⊤ z trivial).hom ω) m) →
    ∃ L : Additive (rootsOfUnity m Γ(Z, ⊤)) →+ C(Z, ZMod m),
      ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z) (j : ℕ),
        L v z = (j : ZMod m) ↔
          (Z.evaluation ⊤ z trivial).hom
              (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
            ((Z.evaluation ⊤ z trivial).hom ω) ^ j :=
by
  classical
  intro Z m _ ω hprim

  have hfield : ∀ (K : Type u) [Field K] (ζ x : K), IsPrimitiveRoot ζ m → x ^ m = 1 →
      ∃ a : ZMod m, ∀ j : ℕ, a = (j : ZMod m) ↔ x = ζ ^ j := by
    intro K _ ζ x hζ hx
    obtain ⟨i, hi, hix⟩ := hζ.eq_pow_of_pow_eq_one hx
    refine ⟨(i : ZMod m), fun j => ?_⟩
    have hjm : j % m < m := Nat.mod_lt j (NeZero.pos m)
    have hpm : ζ ^ j = ζ ^ (j % m) := by
      have h := pow_mod_orderOf ζ j
      rw [← hζ.eq_orderOf] at h
      exact h.symm
    rw [ZMod.natCast_eq_natCast_iff' i j m, Nat.mod_eq_of_lt hi, ← hix, hpm]
    constructor
    · intro h; rw [h]
    · intro h; exact hζ.pow_inj hi hjm h

  have hx1 : ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z),
      ((Z.evaluation ⊤ z trivial).hom
        (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤))) ^ m = 1 := by
    intro v z
    have h0 : (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) ^ m = 1 := by
      have h := (Additive.toMul v).2
      rw [mem_rootsOfUnity] at h
      rw [← Units.val_pow_eq_pow_val, h, Units.val_one]
    rw [← map_pow, h0, map_one]

  have hopen : ∀ (x : Γ(Z, ⊤)) (k : ℕ), (∀ z : Z, ((Z.evaluation ⊤ z trivial).hom x) ^ m = 1) →
      k < m → IsOpen {z : Z | (Z.evaluation ⊤ z trivial).hom x =
        ((Z.evaluation ⊤ z trivial).hom ω) ^ k} := by
    intro x k hx hk
    have heq : {z : Z | (Z.evaluation ⊤ z trivial).hom x =
        ((Z.evaluation ⊤ z trivial).hom ω) ^ k} =
        ⋂ j ∈ (Finset.range m).erase k, ((Z.basicOpen (x - ω ^ j) : Z.Opens) : Set Z) := by
      ext z
      have hmem : ∀ j : ℕ, z ∈ ((Z.basicOpen (x - ω ^ j) : Z.Opens) : Set Z) ↔
          (Z.evaluation ⊤ z trivial).hom x ≠ ((Z.evaluation ⊤ z trivial).hom ω) ^ j := by
        intro j
        have h := Scheme.evaluation_ne_zero_iff_mem_basicOpen Z (U := ⊤) z trivial (x - ω ^ j)
        rw [SetLike.mem_coe, ← h, map_sub, map_pow, sub_ne_zero]
      simp only [Set.mem_setOf_eq, Set.mem_iInter, Finset.mem_erase, Finset.mem_range, hmem]
      constructor
      · rintro h j ⟨hjk, hj⟩ h'
        exact hjk ((hprim z).pow_inj hj hk (h'.symm.trans h))
      · intro h
        obtain ⟨i, hi, hix⟩ := (hprim z).eq_pow_of_pow_eq_one (hx z)
        by_cases hik : i = k
        · rw [← hix, hik]
        · exact absurd hix.symm (h i ⟨hik, hi⟩)
    rw [heq]
    exact isOpen_biInter_finset (fun j _ => (Z.basicOpen (x - ω ^ j)).isOpen)

  have hspec : ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z), ∃ a : ZMod m, ∀ j : ℕ,
      a = (j : ZMod m) ↔
        (Z.evaluation ⊤ z trivial).hom
            (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
          ((Z.evaluation ⊤ z trivial).hom ω) ^ j :=
    fun v z => hfield _ _ _ (hprim z) (hx1 v z)
  choose f hf using hspec
  have hval : ∀ v z, (Z.evaluation ⊤ z trivial).hom
      (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
        ((Z.evaluation ⊤ z trivial).hom ω) ^ (f v z).val := by
    intro v z
    exact (hf v z (f v z).val).1 (ZMod.natCast_zmod_val _).symm
  have hcont : ∀ v, Continuous (f v) := by
    intro v
    rw [continuous_discrete_rng]
    intro a
    have hpre : f v ⁻¹' {a} = {z : Z | (Z.evaluation ⊤ z trivial).hom
        (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
          ((Z.evaluation ⊤ z trivial).hom ω) ^ a.val} := by
      ext z
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq]
      rw [← hf v z a.val, ZMod.natCast_zmod_val]
    rw [hpre]
    exact hopen _ a.val (hx1 v) (ZMod.val_lt a)
  let F : Additive (rootsOfUnity m Γ(Z, ⊤)) → C(Z, ZMod m) := fun v => ⟨f v, hcont v⟩

  refine ⟨AddMonoidHom.mk' F ?_, ?_⟩
  · intro v w
    ext z
    show f (v + w) z = f v z + f w z
    have hmul : (Z.evaluation ⊤ z trivial).hom
        (((Additive.toMul (v + w) : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
        (Z.evaluation ⊤ z trivial).hom
          (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) *
        (Z.evaluation ⊤ z trivial).hom
          (((Additive.toMul w : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) := by
      rw [toMul_add, Subgroup.coe_mul, Units.val_mul, map_mul]
    have h := (hf (v + w) z ((f v z).val + (f w z).val)).2
      (by rw [hmul, hval v z, hval w z, pow_add])
    rw [h, Nat.cast_add, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
  · intro v z j
    exact hf v z j

theorem wc_rtsp_root_eq_of_dlog_const : ∀ (Z : Scheme.{u}) (m : ℕ) [NeZero m] (ω : Γ(Z, ⊤))
    (L : Additive (rootsOfUnity m Γ(Z, ⊤)) →+ C(Z, ZMod m)),
    IsUnit ((m : ℕ) : Γ(Z, ⊤)) →
    (∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z) (j : ℕ),
      L v z = (j : ZMod m) ↔
        (Z.evaluation ⊤ z trivial).hom
            (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
          ((Z.evaluation ⊤ z trivial).hom ω) ^ j) →
    ∀ (Z' : Scheme.{u}) (f : Z' ⟶ Z) (v w : Additive (rootsOfUnity m Γ(Z, ⊤))) (k : ℕ),
      (((Additive.toMul w : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) = ω →
      (∀ z' : Z', L v (f z') = (k : ZMod m)) →
      MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) v =
        k • MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) w :=
by
  intro Z m _ ω L hunit hL Z' f v w k hw hk
  have unit_crit : ∀ (Y : Scheme.{u}) (s : Γ(Y, ⊤)),
      (∀ y : Y, (Y.evaluation ⊤ y trivial).hom s ≠ 0) → IsUnit s := by
    intro Y s hs
    apply RingedSpace.isUnit_of_isUnit_germ Y.toSheafedSpace ⊤ s
    intro y hy
    have h1 := (Scheme.evaluation_ne_zero_iff_mem_basicOpen Y (U := ⊤) y trivial s).mp (hs y)
    exact (Scheme.mem_basicOpen_top Y s y).mp h1
  have nat_ev : ∀ (s : Γ(Z, ⊤)) (z' : Z'),
      (Z'.evaluation ⊤ z' trivial).hom (f.appTop.hom s) =
        (f.residueFieldMap z').hom ((Z.evaluation ⊤ (f z') trivial).hom s) := by
    intro s z'
    exact (Scheme.evaluation_naturality_apply f (V := ⊤) z' trivial s).symm
  have hab : f.appTop.hom (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
      (f.appTop.hom ω) ^ k := by
    set a : Γ(Z', ⊤) :=
      f.appTop.hom (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) with ha
    set b : Γ(Z', ⊤) := (f.appTop.hom ω) ^ k with hb
    have hvm : ((((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤))) ^ m = 1 := by
      rw [← Units.val_pow_eq_pow_val, (mem_rootsOfUnity _ _).mp (Additive.toMul v).2,
        Units.val_one]
    have hwm : ω ^ m = 1 := by
      rw [← hw, ← Units.val_pow_eq_pow_val, (mem_rootsOfUnity _ _).mp (Additive.toMul w).2,
        Units.val_one]
    have ham : a ^ m = 1 := by rw [ha, ← map_pow, hvm, map_one]
    have hbm : b ^ m = 1 := by
      rw [hb, ← pow_mul, mul_comm, pow_mul, ← map_pow, hwm, map_one, one_pow]
    set S := ∑ i ∈ Finset.range m, a ^ i * b ^ (m - 1 - i) with hS
    have hS0 : S * (a - b) = 0 := by
      rw [hS, Commute.geom_sum₂_mul (Commute.all a b) m, ham, hbm, sub_self]
    have hmR : IsUnit ((m : ℕ) : Γ(Z', ⊤)) := by
      have := hunit.map f.appTop.hom
      rwa [map_natCast] at this
    have hSu : IsUnit S := by
      apply unit_crit Z' S
      intro z'
      have hφab : (Z'.evaluation ⊤ z' trivial).hom a = (Z'.evaluation ⊤ z' trivial).hom b := by
        have h1 := (hL v (f z') k).mp (hk z')
        have h2 := congrArg (f.residueFieldMap z').hom h1
        rw [map_pow] at h2
        rw [ha, hb, map_pow, nat_ev, nat_ev, h2]
      have hφm : (Z'.evaluation ⊤ z' trivial).hom (m : Γ(Z', ⊤)) ≠ 0 :=
        (hmR.map (Z'.evaluation ⊤ z' trivial).hom).ne_zero
      have hm0 : (m : Z'.residueField z') ≠ 0 := by rwa [map_natCast] at hφm
      have hφa : (Z'.evaluation ⊤ z' trivial).hom a ≠ 0 := by
        intro h0
        have h3 : (Z'.evaluation ⊤ z' trivial).hom (a ^ m) = 1 := by rw [ham, map_one]
        rw [map_pow, h0, zero_pow (NeZero.ne m)] at h3
        exact zero_ne_one h3
      have hφS : (Z'.evaluation ⊤ z' trivial).hom S =
          (m : Z'.residueField z') * (Z'.evaluation ⊤ z' trivial).hom a ^ (m - 1) := by
        rw [hS, map_sum]
        rw [Finset.sum_congr rfl (g := fun _ => (Z'.evaluation ⊤ z' trivial).hom a ^ (m - 1))]
        · rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        · intro i hi
          rw [Finset.mem_range] at hi
          rw [map_mul, map_pow, map_pow, ← hφab, ← pow_add]
          congr 1
          omega
      rw [hφS]
      exact mul_ne_zero hm0 (pow_ne_zero _ hφa)
    exact sub_eq_zero.mp ((hSu.mul_right_eq_zero).mp hS0)
  apply Additive.toMul.injective
  rw [toMul_nsmul, MonoidHom.toAdditive_apply_apply, MonoidHom.toAdditive_apply_apply,
    toMul_ofMul, toMul_ofMul]
  apply Subtype.ext
  apply Units.ext
  rw [restrictRootsOfUnity_coe_apply, rootsOfUnity.coe_pow, restrictRootsOfUnity_coe_apply, hw]
  exact hab

theorem wc_rtsp_tensor_locally_pure : ∀ (Z : Scheme.{u}) (m d : ℕ) [NeZero m]
    (ωu : Additive (rootsOfUnity m Γ(Z, ⊤)))
    (L : Additive (rootsOfUnity m Γ(Z, ⊤)) →+ C(Z, ZMod m))
    (D : TensorProduct ℤ (ZMod m)
      (PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(Z, ⊤)))) →+ C(Z, ZMod m)),
    (∀ (Z' : Scheme.{u}) (f : Z' ⟶ Z) (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (k : ℕ),
      (∀ z' : Z', L v (f z') = (k : ZMod m)) →
      MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) v =
        k • MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) ωu) →
    (∀ (a : ZMod m) (x : Fin d → Additive (rootsOfUnity m Γ(Z, ⊤))),
      D (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) = a • ∏ i, L (x i)) →
    ∀ (w : TensorProduct ℤ (ZMod m)
        (PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(Z, ⊤))))) (y : Z),
    ∃ O : Z.Opens, y ∈ O ∧
      ∀ (Z' : Scheme.{u}) (f : Z' ⟶ Z), Set.range f ⊆ (O : Set Z) →
        LinearMap.lTensor (ZMod m) (PiTensorProduct.map (fun _ : Fin d =>
            (MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m)).toIntLinearMap)) w =
          (D w y) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin d =>
            MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) ωu) :=
by
  intro Z m d _ ωu L D H5 HD w y

  have hadd : ∀ w₁ w₂ : TensorProduct ℤ (ZMod m)
        (PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(Z, ⊤)))),
      (∃ O : Z.Opens, y ∈ O ∧
        ∀ (Z' : Scheme.{u}) (f : Z' ⟶ Z), Set.range f ⊆ (O : Set Z) →
          LinearMap.lTensor (ZMod m) (PiTensorProduct.map (fun _ : Fin d =>
              (MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m)).toIntLinearMap)) w₁ =
            (D w₁ y) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin d =>
              MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) ωu)) →
      (∃ O : Z.Opens, y ∈ O ∧
        ∀ (Z' : Scheme.{u}) (f : Z' ⟶ Z), Set.range f ⊆ (O : Set Z) →
          LinearMap.lTensor (ZMod m) (PiTensorProduct.map (fun _ : Fin d =>
              (MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m)).toIntLinearMap)) w₂ =
            (D w₂ y) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin d =>
              MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) ωu)) →
      (∃ O : Z.Opens, y ∈ O ∧
        ∀ (Z' : Scheme.{u}) (f : Z' ⟶ Z), Set.range f ⊆ (O : Set Z) →
          LinearMap.lTensor (ZMod m) (PiTensorProduct.map (fun _ : Fin d =>
              (MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m)).toIntLinearMap))
              (w₁ + w₂) =
            (D (w₁ + w₂) y) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin d =>
              MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) ωu)) := by
    intro w₁ w₂ ⟨O₁, hy₁, h₁⟩ ⟨O₂, hy₂, h₂⟩
    refine ⟨O₁ ⊓ O₂, ⟨hy₁, hy₂⟩, fun Z' f hf => ?_⟩
    have hf1 : Set.range f ⊆ (O₁ : Set Z) := fun z hz => (hf hz).1
    have hf2 : Set.range f ⊆ (O₂ : Set Z) := fun z hz => (hf hz).2
    simp only [map_add, ContinuousMap.add_apply]
    rw [h₁ Z' f hf1, h₂ Z' f hf2, TensorProduct.add_tmul]

  have hpure : ∀ (a : ZMod m) (x : Fin d → Additive (rootsOfUnity m Γ(Z, ⊤))),
      ∃ O : Z.Opens, y ∈ O ∧
        ∀ (Z' : Scheme.{u}) (f : Z' ⟶ Z), Set.range f ⊆ (O : Set Z) →
          LinearMap.lTensor (ZMod m) (PiTensorProduct.map (fun _ : Fin d =>
              (MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m)).toIntLinearMap))
              (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) =
            (D (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) y) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
              (fun _ : Fin d => MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) ωu) := by
    intro a x
    refine ⟨⟨⋂ i, (L (x i)) ⁻¹' {L (x i) y}, isOpen_iInter_of_finite (fun i =>
      (L (x i)).continuous.isOpen_preimage _ (isOpen_discrete _))⟩, ?_, ?_⟩
    · show y ∈ ⋂ i, (L (x i)) ⁻¹' {L (x i) y}
      simp
    · intro Z' f hf
      have hr : ∀ i, MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) (x i) =
          (L (x i) y).val • MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) ωu := by
        intro i
        apply H5
        intro z'
        have hz : f z' ∈ ⋂ i, (L (x i)) ⁻¹' {L (x i) y} := hf ⟨z', rfl⟩
        rw [Set.mem_iInter] at hz
        have h1 := hz i
        simp only [Set.mem_preimage, Set.mem_singleton_iff] at h1
        rw [h1, ZMod.natCast_zmod_val]
      rw [LinearMap.lTensor_tmul, PiTensorProduct.map_tprod]
      have e1 : (fun i => (MonoidHom.toAdditive
            (restrictRootsOfUnity f.appTop.hom m)).toIntLinearMap (x i)) =
          fun i => ((L (x i) y).val : ℤ) •
            MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) ωu := by
        funext i
        show MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) (x i) = _
        rw [hr i, natCast_zsmul]
      rw [e1, MultilinearMap.map_smul_univ, ← TensorProduct.smul_tmul, HD]
      congr 1
      simp only [ContinuousMap.smul_apply, ContinuousMap.prod_apply, smul_eq_mul, zsmul_eq_mul,
        Int.cast_prod, Int.cast_natCast, ZMod.natCast_zmod_val]
      ring
  induction w using TensorProduct.induction_on
  next =>
    refine ⟨⊤, trivial, fun Z' f _ => ?_⟩
    simp
  next a p =>
    induction p using PiTensorProduct.induction_on
    next r x =>
      obtain ⟨O, hyO, hO⟩ := hpure (r • a) x
      refine ⟨O, hyO, fun Z' f hf => ?_⟩
      rw [← TensorProduct.smul_tmul]
      exact hO Z' f hf
    next p q hp hq =>
      rw [TensorProduct.tmul_add]
      exact hadd _ _ hp hq
  next w₁ w₂ h₁ h₂ =>
    exact hadd _ _ h₁ h₂

theorem wc_rtsp_dlog_tensor_natural : ∀ (Z Z' : Scheme.{u}) (f : Z' ⟶ Z) (m d : ℕ) [NeZero m]
    (ω : Γ(Z, ⊤))
    (L : Additive (rootsOfUnity m Γ(Z, ⊤)) →+ C(Z, ZMod m))
    (L' : Additive (rootsOfUnity m Γ(Z', ⊤)) →+ C(Z', ZMod m))
    (D : TensorProduct ℤ (ZMod m)
      (PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(Z, ⊤)))) →+ C(Z, ZMod m))
    (D' : TensorProduct ℤ (ZMod m)
      (PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(Z', ⊤)))) →+ C(Z', ZMod m)),
    (∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z) (j : ℕ),
      L v z = (j : ZMod m) ↔
        (Z.evaluation ⊤ z trivial).hom
            (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
          ((Z.evaluation ⊤ z trivial).hom ω) ^ j) →
    (∀ (v : Additive (rootsOfUnity m Γ(Z', ⊤))) (z : Z') (j : ℕ),
      L' v z = (j : ZMod m) ↔
        (Z'.evaluation ⊤ z trivial).hom
            (((Additive.toMul v : rootsOfUnity m Γ(Z', ⊤)) : Γ(Z', ⊤)ˣ) : Γ(Z', ⊤)) =
          ((Z'.evaluation ⊤ z trivial).hom (f.appTop.hom ω)) ^ j) →
    (∀ (a : ZMod m) (x : Fin d → Additive (rootsOfUnity m Γ(Z, ⊤))),
      D (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) = a • ∏ i, L (x i)) →
    (∀ (a : ZMod m) (x : Fin d → Additive (rootsOfUnity m Γ(Z', ⊤))),
      D' (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) = a • ∏ i, L' (x i)) →
    ∀ (w : TensorProduct ℤ (ZMod m)
        (PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(Z, ⊤))))) (z : Z'),
      D' (LinearMap.lTensor (ZMod m) (PiTensorProduct.map (fun _ : Fin d =>
          (MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m)).toIntLinearMap)) w) z =
        D w (f z) :=
by
  intro Z Z' f m d _ ω L L' D D' hL hL' hD hD' w z
  have hpull : ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z'),
      L' (MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) v) z = L v (f z) := by
    intro v z
    have hnat : ∀ s : Γ(Z, ⊤), (f.residueFieldMap z).hom ((Z.evaluation ⊤ (f z) trivial).hom s) =
        (Z'.evaluation ⊤ z trivial).hom (f.appTop.hom s) :=
      fun s => Scheme.evaluation_naturality_apply f (V := ⊤) z trivial s
    have hj : (((L v (f z)).val : ℕ) : ZMod m) = L v (f z) := ZMod.natCast_zmod_val _
    have h1 := (hL v (f z) (L v (f z)).val).1 hj.symm
    have h2 := congrArg (f.residueFieldMap z).hom h1
    rw [map_pow, hnat, hnat] at h2
    rw [← hj]
    apply (hL' _ z _).2
    rw [MonoidHom.toAdditive_apply_apply, toMul_ofMul, restrictRootsOfUnity_coe_apply]
    exact h2
  set Mf := LinearMap.lTensor (ZMod m) (PiTensorProduct.map (fun _ : Fin d =>
          (MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m)).toIntLinearMap)) with hMf
  have hpure : ∀ (a : ZMod m) (x : Fin d → Additive (rootsOfUnity m Γ(Z, ⊤))),
      D' (Mf (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x)) z =
        D (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) (f z) := by
    intro a x
    rw [hMf, LinearMap.lTensor_tmul, PiTensorProduct.map_tprod, hD, hD']
    simp only [ContinuousMap.smul_apply, ContinuousMap.prod_apply,
      AddMonoidHom.coe_toIntLinearMap, hpull]
  induction w using TensorProduct.induction_on with
  | zero => rw [map_zero, map_zero, map_zero]; rfl
  | tmul a p =>
    induction p using PiTensorProduct.induction_on with
    | smul_tprod c x =>
      have e : a ⊗ₜ[ℤ] (c • PiTensorProduct.tprod ℤ x) = (c • a) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x :=
        (TensorProduct.smul_tmul c a _).symm
      rw [e, hpure]
    | add p q hp hq =>
      rw [TensorProduct.tmul_add, map_add, map_add, map_add, ContinuousMap.add_apply,
        ContinuousMap.add_apply, hp, hq]
  | add x y hx hy =>
    rw [map_add, map_add, map_add, ContinuousMap.add_apply, ContinuousMap.add_apply, hx, hy]

theorem wc_rtsp_dlog_tensor_scale : ∀ (Z : Scheme.{u}) (m d c : ℕ) [NeZero m] (ω ω' : Γ(Z, ⊤))
    (L L' : Additive (rootsOfUnity m Γ(Z, ⊤)) →+ C(Z, ZMod m))
    (D D' : TensorProduct ℤ (ZMod m)
      (PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(Z, ⊤)))) →+ C(Z, ZMod m)),
    ω = ω' ^ c →
    (∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z) (j : ℕ),
      L v z = (j : ZMod m) ↔
        (Z.evaluation ⊤ z trivial).hom
            (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
          ((Z.evaluation ⊤ z trivial).hom ω) ^ j) →
    (∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z) (j : ℕ),
      L' v z = (j : ZMod m) ↔
        (Z.evaluation ⊤ z trivial).hom
            (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
          ((Z.evaluation ⊤ z trivial).hom ω') ^ j) →
    (∀ (a : ZMod m) (x : Fin d → Additive (rootsOfUnity m Γ(Z, ⊤))),
      D (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) = a • ∏ i, L (x i)) →
    (∀ (a : ZMod m) (x : Fin d → Additive (rootsOfUnity m Γ(Z, ⊤))),
      D' (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) = a • ∏ i, L' (x i)) →
    ∀ w, D' w = (c ^ d) • D w :=
by
  intro Z m d c _ ω ω' L L' D D' hω hL hL' hD hD'
  have s1 : ∀ (v : Additive (rootsOfUnity m Γ(Z, ⊤))) (z : Z),
      L' v z = (c : ZMod m) * L v z := by
    intro v z
    have hk : (((L v z).val : ℕ) : ZMod m) = L v z := ZMod.natCast_zmod_val _
    have h1 := (hL v z (L v z).val).mp hk.symm
    have h2 : (Z.evaluation ⊤ z trivial).hom
            (((Additive.toMul v : rootsOfUnity m Γ(Z, ⊤)) : Γ(Z, ⊤)ˣ) : Γ(Z, ⊤)) =
          ((Z.evaluation ⊤ z trivial).hom ω') ^ (c * (L v z).val) := by
      rw [h1, hω, map_pow, pow_mul]
    rw [(hL' v z _).mpr h2, Nat.cast_mul, hk]
  have s3 : ∀ (a : ZMod m) (x : Fin d → Additive (rootsOfUnity m Γ(Z, ⊤))),
      D' (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) =
        (c ^ d) • D (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) := by
    intro a x
    rw [hD, hD']
    ext z
    simp only [ContinuousMap.smul_apply, ContinuousMap.coe_prod, Finset.prod_apply]
    simp only [s1, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin, smul_eq_mul, nsmul_eq_mul, Nat.cast_pow]
    ring
  have s4 : ∀ (a : ZMod m)
      (y : PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(Z, ⊤)))),
      D' (a ⊗ₜ[ℤ] y) = (c ^ d) • D (a ⊗ₜ[ℤ] y) := by
    intro a y
    induction y using PiTensorProduct.induction_on with
    | smul_tprod r x =>
      rw [TensorProduct.tmul_smul, map_zsmul, map_zsmul, s3, smul_comm]
    | add y₁ y₂ h₁ h₂ =>
      rw [TensorProduct.tmul_add, map_add, map_add, h₁, h₂, smul_add]
  intro w
  induction w using TensorProduct.induction_on with
  | zero => simp
  | tmul a y => exact s4 a y
  | add x y hx hy => rw [map_add, map_add, hx, hy, smul_add]

theorem wc_rtsp_tensor_lift : ∀ (m d : ℕ) (M : Type u) [AddCommGroup M],
    (∀ (B : Type u) [AddCommGroup B]
      (ψ₁ ψ₂ : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin d => M)) →+ B),
      (∀ (a : ZMod m) (x : Fin d → M),
        ψ₁ (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) = ψ₂ (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x)) →
      ψ₁ = ψ₂) ∧
    ∀ (B : Type u) [CommRing B] [Algebra (ZMod m) B] (L : M →+ B),
      ∃ Φ : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin d => M)) →+ B,
        ∀ (a : ZMod m) (x : Fin d → M),
          Φ (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) = a • ∏ i, L (x i) :=
by
  intro m d M _
  refine ⟨?_, ?_⟩
  · intro B _ ψ₁ ψ₂ h
    have key : ∀ (a : ZMod m) (y : PiTensorProduct ℤ (fun _ : Fin d => M)),
        ψ₁ (a ⊗ₜ[ℤ] y) = ψ₂ (a ⊗ₜ[ℤ] y) := by
      intro a y
      induction y using PiTensorProduct.induction_on with
      | smul_tprod r f =>
        rw [TensorProduct.tmul_smul]
        have e1 : ψ₁ (r • (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ f)) =
            r • ψ₁ (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ f) :=
          ψ₁.toIntLinearMap.map_smul r _
        have e2 : ψ₂ (r • (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ f)) =
            r • ψ₂ (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ f) :=
          ψ₂.toIntLinearMap.map_smul r _
        rw [e1, e2, h a f]
      | add x y hx hy =>
        rw [TensorProduct.tmul_add, map_add, map_add, hx, hy]
    apply AddMonoidHom.ext
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul a y => exact key a y
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  · intro B _ _ L
    let P : PiTensorProduct ℤ (fun _ : Fin d => M) →ₗ[ℤ] B :=
      PiTensorProduct.lift ((MultilinearMap.mkPiAlgebra ℤ (Fin d) B).compLinearMap
        (fun _ : Fin d => L.toIntLinearMap))
    let ι : ZMod m →ₗ[ℤ] B := (algebraMap (ZMod m) B).toAddMonoidHom.toIntLinearMap
    refine ⟨(TensorProduct.lift ((LinearMap.mul ℤ B).compl₁₂ ι P)).toAddMonoidHom, ?_⟩
    intro a x
    have hP : P (PiTensorProduct.tprod ℤ x) = ∏ i, L (x i) := by
      simp only [P, PiTensorProduct.lift.tprod, MultilinearMap.compLinearMap_apply,
        MultilinearMap.mkPiAlgebra_apply, AddMonoidHom.coe_toIntLinearMap]
    have hι : ι a = algebraMap (ZMod m) B a := rfl
    show (TensorProduct.lift ((LinearMap.mul ℤ B).compl₁₂ ι P))
      (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ x) = a • ∏ i, L (x i)
    rw [TensorProduct.lift.tmul, LinearMap.compl₁₂_apply, LinearMap.mul_apply', hP, hι,
      Algebra.smul_def]

theorem wc_rtsp_open_cover_mem : ∀ (S : Scheme.{u}) (U : S.ProEt) (V : Over U) (R : Sieve V),
    (∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
      ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) → R.arrows e) →
    R ∈ (Scheme.ProEt.topology S).over U V :=
by
  intro S U V R hR
  choose O hyO hO using hR
  refine (GrothendieckTopology.mem_over_iff (Scheme.ProEt.topology S) R).mpr ?_
  haveI := V.left.prop
  let W' : ULift.{u+1} V.left.left → S.ProEt := fun i =>
    Scheme.ProEt.mk ((O i.down).ι ≫ V.left.hom)
  let f : ∀ i, W' i ⟶ V.left := fun i => MorphismProperty.Over.homMk (O i.down).ι rfl trivial
  have hcov : ∀ x : ↥V.left.left, ∃ (i : ULift.{u+1} V.left.left) (y : ↥(O i.down).toScheme),
      (O i.down).ι y = x := fun x =>
    ⟨ULift.up x, ⟨x, hyO x⟩, Scheme.Opens.ι_apply _ _⟩
  let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) V.left.left :=
    Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} V.left.left)
      (fun i => (O i.down).toScheme) (fun i => (O i.down).ι) hcov (fun i => inferInstance)
  have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
    @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
      (fun i => (Scheme.Hom.isOpenEmbedding (O i.down).ι).isOpenMap)
  have hRb : Presieve.ofArrows (fun i : ULift.{u+1} V.left.left => (O i.down).toScheme)
      (fun i => (O i.down).ι) ∈ Scheme.proetalePrecoverage.coverings V.left.left :=
    Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
  have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget S ⋙ Over.forget S) (Y := W') f
  have hR' : Presieve.ofArrows W' f ∈ (Scheme.ProEt.precoverage S).coverings V.left :=
    Precoverage.mem_comap_iff.mpr (e ▸ hRb)
  have hRJ : Sieve.generate (Presieve.ofArrows W' f) ∈ (Scheme.ProEt.topology S) V.left :=
    Precoverage.generate_mem_toGrothendieck hR'
  refine (Scheme.ProEt.topology S).superset_covering ?_ hRJ
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨i⟩
  rw [Sieve.overEquiv_iff]
  apply hO i.down
  change Set.range (O i.down).ι ⊆ _
  rw [Scheme.Opens.range_ι]

theorem wc_root_twist_slice_presheaf_map (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n d : ℕ) :
    ∃ ρ : (Over.forget (wcGeomPoint F X h)).op ⋙ wcRootTwistPre X.left (ℓ ^ n) d ⟶
        (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
          (wcGeomPoint F X h)).obj (wcZModSheaf X.left (ℓ ^ n))).obj,
      Presheaf.IsLocallyInjective ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) ρ ∧
      Presheaf.IsLocallySurjective ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) ρ ∧
      ∀ V : Over (wcGeomPoint F X h),
        ρ.app (Opposite.op (Over.mk (V.hom ≫ wcGeomFrob F X h))) =
          (Nat.card F ^ d) • ρ.app (Opposite.op V) :=
by
  classical

  have wc_rtsp_presheaf_map_mk : ∀ (S : Scheme.{u}) (U : S.ProEt) (a : U ⟶ U) (m c : ℕ)
      (G : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u})
      (D : ∀ V : Over U, G.obj (Opposite.op V.left) →+ C(V.left.left, ZMod m)),
      (∀ (V V' : Over U) (g : V' ⟶ V) (w : G.obj (Opposite.op V.left)) (z : V'.left.left),
        D V' (G.map g.left.op w) z = D V w (g.left.left z)) →
      (∀ (V : Over U) (w : G.obj (Opposite.op V.left)), D (Over.mk (V.hom ≫ a)) w = c • D V w) →
      ∃ ρ : (Over.forget U).op ⋙ (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ⟶
          (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
            (wcZModSheaf S m)).obj,
        (∀ (V : Over U) (w : G.obj (Opposite.op V.left)),
          ULift.down (ρ.app (Opposite.op V) (ULift.up w)) = D V w) ∧
        ∀ V : Over U, ρ.app (Opposite.op (Over.mk (V.hom ≫ a))) = c • ρ.app (Opposite.op V) := by
    intro S U a m c G D hnat hsc
    let ρ : (Over.forget U).op ⋙ (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ⟶
        (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
          (wcZModSheaf S m)).obj :=
      { app := fun V => AddCommGrpCat.ofHom (AddMonoidHom.mk'
            (fun x : ULift.{u+1} (G.obj (Opposite.op V.unop.left)) =>
              (ULift.up (D V.unop x.down) : ULift.{u+1} C(V.unop.left.left, ZMod m)))
            (fun x y => by
              rw [show (x + y).down = x.down + y.down from rfl, map_add]
              rfl))
        naturality := fun V W f => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro x
          apply ULift.ext
          apply ContinuousMap.ext
          intro z
          exact hnat V.unop W.unop f.unop x.down z }
    refine ⟨ρ, fun V w => rfl, fun V => ?_⟩
    have e1 : ∀ (k : ℕ) (t : ULift.{u+1} C(V.left.left, ZMod m)), (k • t).down = k • t.down := by
      intro k t
      induction k with
      | zero => rw [zero_nsmul, zero_nsmul]; rfl
      | succ k ih => rw [succ_nsmul, succ_nsmul, ULift.add_down, ih]
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    apply ULift.ext
    show D (Over.mk (V.hom ≫ a)) x.down =
      (c • (ULift.up (D V x.down) : ULift.{u+1} C(V.left.left, ZMod m))).down
    rw [e1]
    exact hsc V x.down
  have wc_rtsp_locSurj_of_const : ∀ (S : Scheme.{u}) (U : S.ProEt) (m : ℕ)
      (P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (ρ : (Over.forget U).op ⋙ P ⟶
        (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj (wcZModSheaf S m)).obj),
      (∀ (V : Over U) (R : Sieve V),
        (∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
          ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) → R.arrows e) →
        R ∈ (Scheme.ProEt.topology S).over U V) →
      (∀ (V : Over U) (a : ZMod m), ∃ t : P.obj (Opposite.op V.left),
        ULift.down (ρ.app (Opposite.op V) t) = ContinuousMap.const V.left.left a) →
      Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U) ρ := by
    intro S U m P ρ hcov hconst
    refine ⟨fun {V} s => ?_⟩
    apply hcov V
    intro y
    let s' : C(V.left.left, ZMod m) := ULift.down s
    refine ⟨⟨s' ⁻¹' {s' y}, s'.continuous.isOpen_preimage _ (isOpen_discrete _)⟩,
      rfl, fun W e he => ?_⟩
    rw [Presheaf.imageSieve_apply]
    obtain ⟨t, ht⟩ := hconst W (s' y)
    refine ⟨t, ?_⟩
    apply ULift.ext
    refine ht.trans ?_
    apply ContinuousMap.ext
    intro z
    have hz : s' (e.left.left z) = s' y := he ⟨z, rfl⟩
    exact hz.symm
  have wc_rtsp_locInj_of_local_zero : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (Q : (Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ρ : (Over.forget U).op ⋙ P ⟶ Q),
      (∀ (V : Over U) (R : Sieve V),
        (∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
          ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) → R.arrows e) →
        R ∈ (Scheme.ProEt.topology S).over U V) →
      (∀ (V : Over U) (x : P.obj (Opposite.op V.left)), ρ.app (Opposite.op V) x = 0 →
        ∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
          ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) →
            P.map e.left.op x = 0) →
      Presheaf.IsLocallyInjective ((Scheme.ProEt.topology S).over U) ρ := by
    intro S U P Q ρ hcov hz
    refine ⟨fun {V} x₁ x₂ hx => ?_⟩
    apply hcov V.unop
    intro y
    have h0 : ρ.app V (x₁ - x₂) = 0 := by rw [map_sub, hx, sub_self]
    obtain ⟨O, hyO, hO⟩ := hz V.unop (x₁ - x₂) h0 y
    refine ⟨O, hyO, fun W e he => ?_⟩
    rw [Presheaf.equalizerSieve_apply]
    have h1 := hO W e he
    rw [map_sub, sub_eq_zero] at h1
    exact h1

  obtain ⟨ζ, hζ, hmu⟩ := wc_rtsp_prim_root F ℓ hℓ n
  have hm0 : ℓ ^ n ≠ 0 := pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero
  generalize ℓ ^ n = m at hζ hmu hm0 ⊢
  haveI : NeZero m := ⟨hm0⟩
  obtain ⟨hprim, hunit, hpow, hnat⟩ := wc_rtsp_geom_root F X h m ζ hζ hmu
  obtain ⟨ω, hω⟩ : ∃ ω : ∀ V : Over (wcGeomPoint F X h), Γ(V.left.left, ⊤), ∀ V, ω V =
      (V.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ) :=
    ⟨fun V => (V.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ), fun V => rfl⟩
  have hprim' : ∀ (V : Over (wcGeomPoint F X h)) (z : V.left.left),
      IsPrimitiveRoot ((V.left.left.evaluation ⊤ z trivial).hom (ω V)) m := by
    intro V z; rw [hω]; exact hprim V z
  have hpow' : ∀ V : Over (wcGeomPoint F X h), ω V ^ m = 1 := by
    intro V; rw [hω]; exact hpow V
  have hnat' : ∀ (V V' : Over (wcGeomPoint F X h)) (g : V' ⟶ V),
      ω V' = g.left.left.appTop.hom (ω V) := by
    intro V V' g; rw [hω, hω]; exact hnat V V' g
  have hfrob : ∀ V : Over (wcGeomPoint F X h),
      ω V = ω (Over.mk (V.hom ≫ wcGeomFrob F X h)) ^ Nat.card F := by
    intro V; rw [hω, hω]; exact wc_rtsp_geom_root_frob F X h ζ V
  let ωu : ∀ V : Over (wcGeomPoint F X h), Additive (rootsOfUnity m Γ(V.left.left, ⊤)) :=
    fun V => Additive.ofMul (rootsOfUnity.mkOfPowEq (ω V) (hpow' V))
  have hωu : ∀ V : Over (wcGeomPoint F X h),
      (((Additive.toMul (ωu V) : rootsOfUnity m Γ(V.left.left, ⊤)) : Γ(V.left.left, ⊤)ˣ) :
        Γ(V.left.left, ⊤)) = ω V :=
    fun V => rootsOfUnity.val_mkOfPowEq_coe _ _

  choose L hL using fun V : Over (wcGeomPoint F X h) =>
    wc_rtsp_dlog_exists V.left.left m (ω V) (hprim' V)
  choose D hD using fun V : Over (wcGeomPoint F X h) =>
    (wc_rtsp_tensor_lift m d (Additive (rootsOfUnity m Γ(V.left.left, ⊤)))).2
      C(V.left.left, ZMod m) (L V)
  let G : (X.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
    (Scheme.ProEt.forget X.left ⋙ Over.forget X.left).op ⋙ Scheme.Γ ⋙ wcRootsFun.{u} m ⋙
      wcTwistFun.{u} m d
  let D' : ∀ V : Over (wcGeomPoint F X h), G.obj (Opposite.op V.left) →+ C(V.left.left, ZMod m) :=
    fun V => D V

  have hnatD : ∀ (V V' : Over (wcGeomPoint F X h)) (g : V' ⟶ V) (w : G.obj (Opposite.op V.left))
      (z : V'.left.left), D' V' (G.map g.left.op w) z = D' V w (g.left.left z) := by
    intro V V' g w z
    have hL' : ∀ (v : Additive (rootsOfUnity m Γ(V'.left.left, ⊤))) (z : V'.left.left) (j : ℕ),
        L V' v z = (j : ZMod m) ↔
          (V'.left.left.evaluation ⊤ z trivial).hom
              (((Additive.toMul v : rootsOfUnity m Γ(V'.left.left, ⊤)) : Γ(V'.left.left, ⊤)ˣ) :
                Γ(V'.left.left, ⊤)) =
            ((V'.left.left.evaluation ⊤ z trivial).hom (g.left.left.appTop.hom (ω V))) ^ j := by
      intro v z j; rw [← hnat' V V' g]; exact hL V' v z j
    exact wc_rtsp_dlog_tensor_natural V.left.left V'.left.left g.left.left m d (ω V) (L V) (L V')
      (D V) (D V') (hL V) hL' (hD V) (hD V') w z

  have hscale : ∀ (V : Over (wcGeomPoint F X h)) (w : G.obj (Opposite.op V.left)),
      D' (Over.mk (V.hom ≫ wcGeomFrob F X h)) w = (Nat.card F ^ d) • D' V w := by
    intro V w
    exact wc_rtsp_dlog_tensor_scale V.left.left m d (Nat.card F) (ω V)
      (ω (Over.mk (V.hom ≫ wcGeomFrob F X h))) (L V) (L (Over.mk (V.hom ≫ wcGeomFrob F X h)))
      (D V) (D (Over.mk (V.hom ≫ wcGeomFrob F X h))) (hfrob V) (hL V)
      (hL (Over.mk (V.hom ≫ wcGeomFrob F X h))) (hD V) (hD (Over.mk (V.hom ≫ wcGeomFrob F X h))) w

  obtain ⟨ρ, hρD, hρscale⟩ := wc_rtsp_presheaf_map_mk X.left (wcGeomPoint F X h)
    (wcGeomFrob F X h) m (Nat.card F ^ d) G D' hnatD hscale
  have hcov := wc_rtsp_open_cover_mem X.left (wcGeomPoint F X h)
  refine ⟨ρ, ?_, ?_, hρscale⟩
  ·
    refine wc_rtsp_locInj_of_local_zero X.left (wcGeomPoint F X h)
      (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) _ ρ hcov ?_
    intro V x hx y
    have hDx : D V x.down = 0 := by
      have h1 := (hρD V x.down).symm.trans (congrArg ULift.down hx)
      exact h1
    have H5 : ∀ (Z' : Scheme.{u}) (f : Z' ⟶ V.left.left)
        (v : Additive (rootsOfUnity m Γ(V.left.left, ⊤))) (k : ℕ),
        (∀ z' : Z', L V v (f z') = (k : ZMod m)) →
        MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) v =
          k • MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) (ωu V) :=
      fun Z' f v k hk => wc_rtsp_root_eq_of_dlog_const V.left.left m (ω V) (L V) (hunit V) (hL V)
        Z' f v (ωu V) k (hωu V) hk
    obtain ⟨O, hyO, hO⟩ := wc_rtsp_tensor_locally_pure V.left.left m d (ωu V) (L V) (D V) H5 (hD V)
      x.down y
    refine ⟨O, hyO, fun W e he => ?_⟩
    have h2 := hO W.left.left e.left.left he
    rw [hDx, ContinuousMap.zero_apply, TensorProduct.zero_tmul] at h2
    exact ULift.ext _ _ h2
  ·
    refine wc_rtsp_locSurj_of_const X.left (wcGeomPoint F X h) m
      (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ρ hcov ?_
    intro V a
    have h1 : L V (ωu V) = 1 := by
      ext z
      have h3 := (hL V (ωu V) z 1).2 (by rw [hωu, pow_one])
      rw [h3]
      simp
    refine ⟨ULift.up ((a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin d => ωu V) :
      TensorProduct ℤ (ZMod m)
        (PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(V.left.left, ⊤)))))), ?_⟩
    refine (hρD V _).trans ?_
    refine (hD V a _).trans ?_
    simp only [h1, Finset.prod_const_one]
    ext z
    simp

theorem wc_slice_sheafify_scaled_iso (S : Scheme.{u}) (U : S.ProEt) (a : U ⟶ U)
    (Mpre : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ρ : (Over.forget U).op ⋙ Mpre ⟶
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj N).obj)
    (c : ℕ) :
    Presheaf.IsLocallyInjective ((Scheme.ProEt.topology S).over U) ρ →
    Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U) ρ →
    (∀ V : Over U, ρ.app (Opposite.op (Over.mk (V.hom ≫ a))) = c • ρ.app (Opposite.op V)) →
    ∃ ψ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
        ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj Mpre) ⟶
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj N,
      IsIso ψ ∧
      ∀ V : Over U, ψ.hom.app (Opposite.op (Over.mk (V.hom ≫ a))) =
        c • ψ.hom.app (Opposite.op V) :=
by
  intro hinj hsurj hρ

  have key : ∀ (P : (Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (Q : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) (f : P ⟶ Q.obj),
      Presheaf.IsLocallyInjective ((Scheme.ProEt.topology S).over U) f →
      Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U) f →
      ∃ Λ : (presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj P ⟶ Q,
        IsIso Λ ∧ toSheafify ((Scheme.ProEt.topology S).over U) P ≫ Λ.hom = f := by
    intro P Q f hfi hfs
    haveI := hfi
    haveI := hfs
    have h1 : Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U)
        (sheafifyLift ((Scheme.ProEt.topology S).over U) f Q.property) :=
      Presheaf.isLocallySurjective_of_isLocallySurjective_fac ((Scheme.ProEt.topology S).over U)
        (toSheafify_sheafifyLift ((Scheme.ProEt.topology S).over U) f Q.property)
    haveI : Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U)
        (toSheafify ((Scheme.ProEt.topology S).over U) P) :=
      Presheaf.isLocallySurjective_toSheafify' _ P
    have h2 : Presheaf.IsLocallyInjective ((Scheme.ProEt.topology S).over U)
        (sheafifyLift ((Scheme.ProEt.topology S).over U) f Q.property) :=
      Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective_fac
        ((Scheme.ProEt.topology S).over U) f
        (toSheafify_sheafifyLift ((Scheme.ProEt.topology S).over U) f Q.property)
    exact ⟨ObjectProperty.homMk (sheafifyLift ((Scheme.ProEt.topology S).over U) f Q.property),
      (Sheaf.isLocallyBijective_iff_isIso
        (ObjectProperty.homMk (sheafifyLift ((Scheme.ProEt.topology S).over U) f Q.property) :
          (presheafToSheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).obj P ⟶ Q)).mp
        ⟨h2, h1⟩,
      toSheafify_sheafifyLift ((Scheme.ProEt.topology S).over U) f Q.property⟩

  let θ : (Over.forget U).op ⋙ Mpre ⟶
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
        ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj Mpre)).obj :=
    Functor.whiskerLeft (Over.forget U).op (toSheafify (Scheme.ProEt.topology S) Mpre)
  have hθs : Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U) θ :=
    @Presheaf.isLocallySurjective_whisker _ _ _ _ _ _ ((Scheme.ProEt.topology S).over U)
      (Scheme.ProEt.topology S)
      (Over.forget U) _ _ (toSheafify (Scheme.ProEt.topology S) Mpre) _ _ _ _ inferInstance
      (Presheaf.isLocallySurjective_toSheafify' (Scheme.ProEt.topology S) Mpre)
  have hθi : Presheaf.IsLocallyInjective ((Scheme.ProEt.topology S).over U) θ :=
    @Presheaf.isLocallyInjective_whisker _ _ _ _ _ _ ((Scheme.ProEt.topology S).over U)
      (Scheme.ProEt.topology S)
      (Over.forget U) _ _ (toSheafify (Scheme.ProEt.topology S) Mpre) _ _ _ _ inferInstance
      (Presheaf.isLocallyInjective_toSheafify' (Scheme.ProEt.topology S) Mpre)
  obtain ⟨Λθ, hΛθiso, hΛθ⟩ := key _ _ θ hθi hθs
  obtain ⟨Λρ, hΛρiso, hΛρ⟩ := key _ _ ρ hinj hsurj

  let ψ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
        ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj Mpre) ⟶
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj N :=
    inv Λθ ≫ Λρ
  have hfac : θ ≫ ψ.hom = ρ := by
    have h1 : Λθ ≫ ψ = Λρ := IsIso.hom_inv_id_assoc Λθ Λρ
    have h2 : Λθ.hom ≫ ψ.hom = Λρ.hom := congrArg (fun g => g.hom) h1
    rw [← hΛθ, Category.assoc, h2, hΛρ]

  let σ₁ : (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
        ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj Mpre)).obj ⟶
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj N).obj :=
    { app := fun V => ψ.hom.app (Opposite.op (Over.mk (V.unop.hom ≫ a)))
      naturality := fun _ _ g => ψ.hom.naturality ((Over.map a).map g.unop).op }
  have hA : θ ≫ σ₁ = θ ≫ (c • ψ.hom) := by
    refine NatTrans.ext (funext fun V => ?_)
    have e2 : (θ ≫ (c • ψ.hom)).app V = c • ρ.app V := by
      rw [Preadditive.comp_nsmul, NatTrans.app_nsmul, hfac]
    rw [e2]
    have e3 : ρ.app (Opposite.op (Over.mk (V.unop.hom ≫ a))) = c • ρ.app V := hρ V.unop
    rw [← e3]
    exact congrArg (fun g => g.app (Opposite.op (Over.mk (V.unop.hom ≫ a)))) hfac
  have hB : σ₁ = c • ψ.hom := by
    have h4 : toSheafify ((Scheme.ProEt.topology S).over U) ((Over.forget U).op ⋙ Mpre) ≫
          (Λθ.hom ≫ σ₁) =
        toSheafify ((Scheme.ProEt.topology S).over U) ((Over.forget U).op ⋙ Mpre) ≫
          (Λθ.hom ≫ (c • ψ.hom)) := by
      rw [← Category.assoc, ← Category.assoc, hΛθ]
      exact hA
    have h5 := sheafify_hom_ext ((Scheme.ProEt.topology S).over U) _ _
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj N).property h4
    haveI : IsIso Λθ.hom := inferInstance
    exact (cancel_epi Λθ.hom).mp h5
  refine ⟨ψ, inferInstance, fun V => ?_⟩
  exact (congrArg (fun g => g.app (Opposite.op V)) hB).trans
    (NatTrans.app_nsmul (Opposite.op V) ψ.hom c)

theorem wc_slice_ext_frob_transport (S : Scheme.{u}) (U : S.ProEt) (a : U ⟶ U)
    (M M' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (φ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj M ⟶
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj M')
    (c : ℕ) :
    IsIso φ →
    (∀ V : Over U, φ.hom.app (Opposite.op (Over.mk (V.hom ≫ a))) =
      c • φ.hom.app (Opposite.op V)) →
    ∀ i : ℕ, ∃ Φ : Abelian.Ext (wcFreeSheaf S U) M i →+ Abelian.Ext (wcFreeSheaf S U) M' i,
      Function.Bijective Φ ∧
      ∀ y, c • Φ ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp y (zero_add i)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp (Φ y) (zero_add i) :=
by
  intro hiso hφ i
  letI hExtD : HasExt (Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) :=
    HasExt.standard _

  have hLadj : ∃ (L : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1} ⥤
        Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (_ : L ⊣ (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U),
      L.Additive ∧ Limits.PreservesFiniteLimits L ∧ Limits.PreservesFiniteColimits L := by
    have hfinal : ∀ W : S.ProEt, ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (Over.forget U).op (Opposite.op W)), D.Final := by
      intro W
      obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
          CostructuredArrow (Over.forget U).op (Opposite.op W),
          ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op :=
        ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op),
          fun f => rfl⟩
      have key : ∀ (c : CostructuredArrow (Over.forget U).op (Opposite.op W)) (f : W ⟶ U)
          (k : c.left ⟶ Opposite.op (Over.mk f))
          (hk : (Over.forget U).op.map k ≫ (𝟙 W).op = c.hom),
          (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom ∧
            f = Quiver.Hom.unop c.hom ≫ c.left.unop.hom := by
        intro c f k hk
        have h0 : 𝟙 W ≫ (Over.forget U).map k.unop = c.hom.unop := congrArg Quiver.Hom.unop hk
        have h1 : (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom :=
          (Category.id_comp _).symm.trans h0
        refine ⟨h1, ?_⟩
        have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Over.mk f).hom :=
          Over.w k.unop
        exact hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1)
      refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
      have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
        intro f h h'
        refine (cancel_mono (eqToHom (hD f))).1 ?_
        apply CostructuredArrow.hom_ext
        apply Quiver.Hom.unop_inj
        apply Over.OverMorphism.ext
        exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
          (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
      let fc : W ⟶ U := Quiver.Hom.unop c.hom ≫ c.left.unop.hom
      obtain ⟨κc, hκc⟩ : ∃ κc : Over.mk fc ⟶ c.left.unop,
          κc.left = Quiver.Hom.unop c.hom :=
        ⟨Over.homMk (Quiver.Hom.unop c.hom) rfl, rfl⟩
      have hw : (Over.forget U).op.map κc.op ≫ (𝟙 W).op = c.hom := by
        apply Quiver.Hom.unop_inj
        exact (Category.id_comp _).trans hκc
      let φc : c ⟶ D.obj ⟨fc⟩ :=
        CostructuredArrow.homMk (f := c)
          (f' := CostructuredArrow.mk (Y := Opposite.op (Over.mk fc)) (𝟙 W).op)
          κc.op hw ≫ eqToHom (hD fc).symm
      have hto : ∀ s : StructuredArrow c D, s.right.as = fc := fun s =>
        (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left (CostructuredArrow.w _)).2
      let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
      exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
        (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
        (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))
    have lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
        Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
            (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim) := by
      intro C D _ _ L _ _ Y
      refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
      intro F₁ F₂ φ
      have hnat : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
          (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
        fun j => (L.lan.map φ).naturality j.hom
      have hfac : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
          φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
        Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
          (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
      refine (Iso.inv_comp_eq _).1 ?_
      apply Limits.colimit.hom_ext
      intro j
      have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
          (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
          φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
        calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
            = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
          _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
              (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
          _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
                (Category.assoc _ _ _).symm
          _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
          _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
              Category.assoc _ _ _
          _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
              congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
      erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
      exact key
    have lan_pfl : ∀ {C D : Type (u+1)} [Category.{u} C]
        [Category.{u} D] (L : C ⥤ D)
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
        (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
            (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim)) →
        (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
        Limits.PreservesFiniteLimits
          (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
      intro C D _ _ L _ _ hiso' hfin
      constructor
      intro J _ _
      apply Limits.preservesLimitsOfShape_of_evaluation
      intro Y
      obtain ⟨θ⟩ := hiso' Y
      obtain ⟨I, G, hG⟩ := hfin Y
      haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
        HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
          (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
      let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim :=
        Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
      exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)
    haveI hlan : Limits.PreservesFiniteLimits ((Over.forget U).op.lan :
        ((Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
      lan_pfl (Over.forget U).op (fun Y => lan_eval_iso (Over.forget U).op Y)
        (fun Y => hfinal Y.unop)
    let G := (Over.forget U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
    let F := (Over.forget U).sheafPullback AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
    let adj : F ⊣ G := (Over.forget U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
    haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
    haveI : Limits.PreservesFiniteColimits F :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits F
    haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
    haveI : G.Additive := Functor.additive_of_preserves_binary_products G
    haveI : F.Additive := adj.left_adjoint_additive
    haveI : Limits.PreservesFiniteLimits F := by
      show Limits.PreservesFiniteLimits ((Over.forget U).sheafPullback AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S))
      infer_instance
    exact ⟨F, adj, inferInstance, inferInstance, inferInstance⟩

  have hpush : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (J : GrothendieckTopology C) (K : GrothendieckTopology D) (G : C ⥤ D)
      [G.IsContinuous J K] [G.IsCocontinuous J K],
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).Additive ∧
      Limits.PreservesFiniteColimits (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) := by
    intro C D _ _ J K G _ _
    have adj := G.sheafAdjunctionCocontinuous AddCommGrpCat.{u+1} J K
    have := adj.leftAdjoint_preservesColimits.{0, 0}
    have : (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).IsLeftAdjoint := adj.isLeftAdjoint
    have := Functor.preservesZeroMorphisms_of_isLeftAdjoint
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)
    have := Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)
    exact ⟨Functor.additive_of_preservesBinaryBiproducts _,
      Limits.PreservesColimitsOfSize.preservesFiniteColimits _⟩

  have yon1 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] (T : C) (Fs : Sheaf J AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) := by
    intro C _ J _ T Fs
    let e2 : ∀ G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op T) :=
      fun G => ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    have he2 : ∀ (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1})
        (ψ : yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 G ψ = ψ.app (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))) := by
      intro G ψ
      rfl
    let e : ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs) ≃
          Fs.obj.obj (Opposite.op T) :=
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs).trans (e2 Fs.obj)
    have he : ∀ φ, e φ = φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) := by
      intro φ
      show e2 Fs.obj ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs φ) = _
      rw [he2, Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    have hfun : (fun φ : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) = ⇑e :=
      funext fun φ => (he φ).symm
    rw [hfun]
    exact e.bijective
  have yon2 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] {T T' : C} (g : T ⟶ T'),
      ((presheafToSheaf J AddCommGrpCat.{u+1}).map
          (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).hom.app
          (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) =
        ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map g.op
          ((toSheafify J (yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T') (FreeAbelianGroup.of (ULift.up (𝟙 T')))) := by
    intro C _ J _ T T' g
    have h1 : (toSheafify J (yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op T)
        ((Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) =
        (sheafifyMap J (Functor.whiskerRight (yoneda.map g)
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) := by
      have hn := NatTrans.congr_app (toSheafify_naturality J
        (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
        (Opposite.op T)
      rw [NatTrans.comp_app, NatTrans.comp_app] at hn
      exact ConcreteCategory.congr_hom hn _
    have h2 := NatTrans.naturality_apply
      (toSheafify J (yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) g.op
      (FreeAbelianGroup.of (ULift.up (𝟙 T')))
    have h3 : (Functor.whiskerRight (yoneda.map g)
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op T)
          (FreeAbelianGroup.of (ULift.up (𝟙 T))) =
        (yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map g.op
          (FreeAbelianGroup.of (ULift.up (𝟙 T'))) := by
      show FreeAbelianGroup.of (ULift.up (𝟙 T ≫ g)) = FreeAbelianGroup.of (ULift.up (g ≫ 𝟙 T'))
      rw [Category.id_comp, Category.comp_id]
    exact (h1.symm.trans (congrArg _ h3)).trans h2
  have bij_help : ∀ {α β γ : Type (u+1)} (ev : β → γ) (Θ : α → β) (e : α → γ),
      Function.Bijective ev → Function.Bijective e → (∀ a, ev (Θ a) = e a) →
      Function.Bijective Θ := by
    intro α β γ ev Θ e hev he hc
    refine ⟨fun a b hab => he.1 ((hc a).symm.trans ((congrArg ev hab).trans (hc b))), fun b => ?_⟩
    obtain ⟨a, ha⟩ := he.2 (ev b)
    exact ⟨a, hev.1 ((hc a).trans ha)⟩

  obtain ⟨Z, ε, κ, H1, F1⟩ : ∃ (Z : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1})
