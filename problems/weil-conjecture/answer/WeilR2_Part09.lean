              rw [Limits.pullback.lift_snd]
      obtain ⟨t, ht, huniq⟩ := hsf z hz
      exact ⟨t, fun Z f hf => ht ⟨Z, f, hf⟩, fun y hy => huniq y (fun i => hy i.2.1 i.2.2)⟩

    have s4 : ∀ (J : GrothendieckTopology Y.Etale) (R : (Y.Etale)ᵒᵖ ⥤ CommRingCat.{u}),
        Presieve.IsSheaf J (R ⋙ forget CommRingCat.{u}) →
        Presieve.IsSheaf J (R ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
