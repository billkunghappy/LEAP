        (Limits.pullback (Y.fromSpecResidueField x) a)) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (L.obj G) s) := ⟨fun a b => by rw [V a, V b]⟩
