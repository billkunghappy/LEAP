    apply hext
    · exact (hιfst _ _).trans (hf.trans (zero_smul ℤ _)).symm
    · exact (hιsnd _ _ _).trans hsn.symm

  unfold wcLpttEtShMap
  refine ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
    (Eq.trans ?_ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _))
  congr 1
  apply NatTrans.ext
  funext W
  show (wcKaT1Pre Y ℓ n D k s hℓ).app W ≫ AddCommGrpCat.uliftFunctor.{u+1, u}.map
      ((wcTensNat (wcKtIotaE.{u} ℓ n D k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))).app
        (Scheme.Γ.obj (Opposite.op W.unop.left))) =
    (wcKaFPre Y ℓ n k a).app W ≫ (wcKaT2Pre Y ℓ n D k s a hℓ).app W
  rw [hT1, hF, hT2, hTN]
