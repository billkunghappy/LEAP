    exact cbc (i ∣_ W₁) h₁ (X.homOfLE hle) iW g' hcut hWa hsmall

  have s6 : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) (W : X.Opens) (z : Z) (hzW : i z ∈ W) (a : Γ(W, ⊤)), (i ∣_ W).appTop.hom a = 0 → ((W : Scheme.{u}).evaluation ⊤ ⟨i z, hzW⟩ trivial).hom a = 0 := by
