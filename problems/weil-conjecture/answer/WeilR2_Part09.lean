    fun a b c => (map_nsmul (TensorProduct.mk ℤ _ _ a) c b).symm

  have hT1 : ∀ W, (wcKaT1Pre Y ℓ n D k s hℓ).app W = wcKaT1App Y ℓ n D k s hℓ W := by
    intro W
    unfold wcKaT1Pre
    refine hNat _ ?_ W
    intro W₁ W₂ f
    have hres : ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ D).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
