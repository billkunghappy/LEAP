  haveI := hψiso
  haveI hcomp2 : (Over.map ι ⋙ Over.forget (wcGeomPoint F X h)).IsContinuous
      ((Scheme.ProEt.topology X.left).over V) (Scheme.ProEt.topology X.left) := by
    first
