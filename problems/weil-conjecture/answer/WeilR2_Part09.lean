  have eZ : ∀ (U : Z.Opens), U ≤ (i ≫ fX) ⁻¹ᵁ ⊤ := fun U => by
    rw [Scheme.Hom.preimage_top]; exact le_top
  have stdZ₀ : RingHom.IsStandardSmoothOfRelativeDimension (n - c)
      ((i ≫ fX).appLE ⊤ (i ⁻¹ᵁ W₀) (eZ _)).hom := by
    have h3 : (i.app W₀).hom.comp (fX.appLE ⊤ W₀ e₀).hom =
        ((i ≫ fX).appLE ⊤ (i ⁻¹ᵁ W₀) (eZ _)).hom := by
      rw [← CommRingCat.hom_comp, ← Scheme.Hom.appLE_eq_app, Scheme.Hom.appLE_comp_appLE]
    rw [← h3]; exact stdB₀
  have hZa : IsAffineOpen (i ⁻¹ᵁ W₀) := hW₀.preimage i
  have hpre : i ⁻¹ᵁ X.basicOpen s = Z.basicOpen ((i.app W₀).hom s) := Scheme.preimage_basicOpen i s
  have stdZW : RingHom.IsStandardSmoothOfRelativeDimension (n - c)
      ((i ⁻¹ᵁ X.basicOpen s).ι ≫ i ≫ fX).appTop.hom := by
    have h5 := s1b (i ⁻¹ᵁ W₀) (Z.basicOpen ((i.app W₀).hom s)) hZa ((i.app W₀).hom s)
      (Z.basicOpen_le _) rfl (n - c) _ stdZ₀
    have h4 := Scheme.Hom.appLE_map (i ≫ fX) (eZ (i ⁻¹ᵁ W₀))
      (homOfLE (Z.basicOpen_le ((i.app W₀).hom s))).op
    rw [← CommRingCat.hom_comp, h4] at h5
    have h6 := (Scheme.Hom.appLE_congr (i ≫ fX) (eZ _) rfl hpre
      (fun φ => RingHom.IsStandardSmoothOfRelativeDimension (n - c) φ.hom)).mpr h5
    exact s3 (i ≫ fX) (i ⁻¹ᵁ X.basicOpen s) _ (n - c) h6

  haveI : IsAffine ↑(X.basicOpen s) := hWa
  have hsurj : Function.Surjective (i ∣_ X.basicOpen s).appTop.hom :=
    (isClosedImmersion_iff_isAffineHom.mp hclW).2 ⊤ (isAffineOpen_top _)
  rw [← s7 i fX (X.basicOpen s)] at stdZW
  have stdB := s4 _ _ _ ((X.basicOpen s).ι ≫ fX).appTop.hom (i ∣_ X.basicOpen s).appTop.hom _
    (n - c) hsurj hkerW stdZW
  refine ⟨X.basicOpen s, hzs, fun k => (X.homOfLE hWW₁).appTop.hom (h₁ k), hWV, hWa, hcut, stdA,
    stdB, ?_⟩

  rw [Ideal.span_le]
  rintro _ ⟨k, rfl⟩
  rw [SetLike.mem_coe, RingHom.mem_ker]
  apply s6 i (X.basicOpen s) z hzs
  rw [← RingHom.mem_ker, hkerW]
  exact Ideal.subset_span ⟨k, rfl⟩

theorem wc_tube_complementary_coords : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] (m c : ℕ) (h : Fin c → A), RingHom.IsStandardSmoothOfRelativeDimension m ((Ideal.Quotient.mk (Ideal.span (Set.range h))).comp (algebraMap R A)) → ∀ (q : Ideal A) [q.IsPrime], Ideal.span (Set.range h) ≤ q → ∃ g : Fin m → A, Submodule.span q.ResidueField (Set.range (fun j : Fin c ⊕ Fin m => (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R A (Sum.elim h g j))) = ⊤ :=
by

  have Lb : ∀ (A M N : Type u) [CommRing A] [AddCommGroup M] [Module A M] [AddCommGroup N]
      [Module A N] (q : Ideal A) [q.IsPrime] (J : Ideal A) (c : ℕ) (v : Fin c → M) (Φ : M →ₗ[A] N),
      Function.Surjective Φ → J ≤ q →
      (∀ x : M, Φ x = 0 → x ∈ Submodule.span A (Set.range v) ⊔ J • (⊤ : Submodule A M)) →
      ∀ ω : TensorProduct A q.ResidueField M, LinearMap.lTensor q.ResidueField Φ ω = 0 →
      ω ∈ Submodule.span q.ResidueField (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[A] v j)) := by
    intro A M N _ _ _ _ _ q _ J c v Φ hΦ hJ hker ω hω
    have hex := lTensor_exact q.ResidueField (LinearMap.exact_subtype_ker_map Φ) hΦ
    obtain ⟨ξ, rfl⟩ := (hex ω).mp hω
    have key1 : ∀ (a : q.ResidueField) (y : M), y ∈ Submodule.span A (Set.range v) →
        a ⊗ₜ[A] y ∈ Submodule.span q.ResidueField
          (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[A] v j)) := by
      intro a y hy
      obtain ⟨r, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hy
      rw [TensorProduct.tmul_sum]
      refine Submodule.sum_mem _ (fun j _ => ?_)
      rw [← TensorProduct.smul_tmul]
      have e : (r j • a) ⊗ₜ[A] v j = (r j • a) • ((1 : q.ResidueField) ⊗ₜ[A] v j) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [e]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    have key2 : ∀ (a : q.ResidueField) (z : M), z ∈ J • (⊤ : Submodule A M) →
        a ⊗ₜ[A] z ∈ Submodule.span q.ResidueField
          (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[A] v j)) := by
      intro a z hz
      refine Submodule.smul_induction_on (p := fun z => a ⊗ₜ[A] z ∈ Submodule.span q.ResidueField
        (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[A] v j))) hz ?_ ?_
      · intro r hr n _
        show a ⊗ₜ[A] (r • n) ∈ _
        rw [← TensorProduct.smul_tmul, Algebra.smul_def,
          Ideal.algebraMap_residueField_eq_zero.mpr (hJ hr), zero_mul, TensorProduct.zero_tmul]
        exact Submodule.zero_mem _
      · intro x y hx hy
        show a ⊗ₜ[A] (x + y) ∈ _
        rw [TensorProduct.tmul_add]
        exact Submodule.add_mem _ hx hy
    clear hω hex
    induction ξ using TensorProduct.induction_on with
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | tmul a k =>
      rw [LinearMap.lTensor_tmul]
      obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp (hker k (LinearMap.mem_ker.mp k.2))
      rw [Submodule.subtype_apply, ← hyz, TensorProduct.tmul_add]
      exact Submodule.add_mem _ (key1 a y hy) (key2 a z hz)
    | add x y hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy

  have La : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] (c : ℕ) (h : Fin c → A)
      (x : KaehlerDifferential R A),
      KaehlerDifferential.map R R A (A ⧸ Ideal.span (Set.range h)) x = 0 →
      x ∈ Submodule.span A (Set.range (fun j => KaehlerDifferential.D R A (h j))) ⊔
        Ideal.span (Set.range h) • (⊤ : Submodule A (KaehlerDifferential R A)) := by
    intro R A _ _ _ c h x hx
    have hsurj : Function.Surjective (algebraMap A (A ⧸ Ideal.span (Set.range h))) :=
      Ideal.Quotient.mk_surjective
    have h1 : KaehlerDifferential.mapBaseChange R A (A ⧸ Ideal.span (Set.range h))
        ((1 : A ⧸ Ideal.span (Set.range h)) ⊗ₜ[A] x) = 0 := by
      rw [KaehlerDifferential.mapBaseChange_tmul, hx, smul_zero]
    obtain ⟨ξ, hξ⟩ := (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R A
      (A ⧸ Ideal.span (Set.range h)) hsurj _).mp h1
    obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective _ ξ
    rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hξ
    have hyI : (y : A) ∈ Ideal.span (Set.range h) := by
      have hy : algebraMap A (A ⧸ Ideal.span (Set.range h)) (y : A) = 0 := RingHom.mem_ker.mp y.2
      exact Ideal.Quotient.eq_zero_iff_mem.mp hy
    have hDy : KaehlerDifferential.D R A y ∈
        Submodule.span A (Set.range (fun j => KaehlerDifferential.D R A (h j))) ⊔
          Ideal.span (Set.range h) • (⊤ : Submodule A (KaehlerDifferential R A)) := by
      obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hyI
      rw [← ha, map_sum]
      refine Submodule.sum_mem _ (fun j _ => ?_)
      rw [Derivation.leibniz]
      refine Submodule.add_mem _ ?_ ?_
      · exact Submodule.mem_sup_left (Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))
      · exact Submodule.mem_sup_right
          (Submodule.smul_mem_smul (Ideal.subset_span ⟨j, rfl⟩) Submodule.mem_top)
    have h2 : (1 : A ⧸ Ideal.span (Set.range h)) ⊗ₜ[A] (x - KaehlerDifferential.D R A y) = 0 := by
      rw [TensorProduct.tmul_sub, ← hξ, sub_self]
    have h3 : x - KaehlerDifferential.D R A y ∈
        Ideal.span (Set.range h) • (⊤ : Submodule A (KaehlerDifferential R A)) := by
      rw [← Submodule.Quotient.mk_eq_zero]
      rw [← TensorProduct.quotTensorEquivQuotSMul_symm_mk (Ideal.span (Set.range h)),
        LinearEquiv.map_eq_zero_iff] at h2
      exact h2
    have hxe : x = (x - KaehlerDifferential.D R A y) + KaehlerDifferential.D R A y := by
      rw [sub_add_cancel]
    rw [hxe]
    exact Submodule.add_mem _ (Submodule.mem_sup_right h3) hDy

  have Lc : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] (m c : ℕ) (h : Fin c → A),
      RingHom.IsStandardSmoothOfRelativeDimension m
        ((Ideal.Quotient.mk (Ideal.span (Set.range h))).comp (algebraMap R A)) →
      ∀ (q : Ideal A) [q.IsPrime], Ideal.span (Set.range h) ≤ q →
      ∃ g : Fin m → A, Submodule.span q.ResidueField (Set.range (fun k : Fin m =>
        (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R (A ⧸ Ideal.span (Set.range h))
          (Ideal.Quotient.mk (Ideal.span (Set.range h)) (g k)))) = ⊤ := by
    intro R A _ _ _ m c h hsm q hq hIq
    rw [Ideal.Quotient.mk_comp_algebraMap] at hsm
    haveI : Algebra.IsStandardSmoothOfRelativeDimension m R (A ⧸ Ideal.span (Set.range h)) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap m).mp hsm
    haveI : Nontrivial (A ⧸ Ideal.span (Set.range h)) :=
      Ideal.Quotient.nontrivial_iff.mpr (fun htop => hq.ne_top (top_le_iff.mp (htop ▸ hIq)))
    haveI : Algebra.IsStandardSmooth R (A ⧸ Ideal.span (Set.range h)) :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth m
    haveI : Module.Free (A ⧸ Ideal.span (Set.range h))
        (KaehlerDifferential R (A ⧸ Ideal.span (Set.range h))) :=
      Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hrank := Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
      (R := R) (S := A ⧸ Ideal.span (Set.range h)) m
    haveI : Module.Finite (A ⧸ Ideal.span (Set.range h))
        (KaehlerDifferential R (A ⧸ Ideal.span (Set.range h))) :=
      Module.finite_of_rank_eq_nat hrank
    let b := Module.finBasisOfFinrankEq (A ⧸ Ideal.span (Set.range h))
      (KaehlerDifferential R (A ⧸ Ideal.span (Set.range h))) (Module.finrank_eq_of_rank_eq hrank)
    have transfer : ∀ X : Set (KaehlerDifferential R (A ⧸ Ideal.span (Set.range h))),
        Submodule.span (A ⧸ Ideal.span (Set.range h)) X = ⊤ →
        Submodule.span q.ResidueField ((fun x => (1 : q.ResidueField) ⊗ₜ[A] x) '' X) = ⊤ := by
      intro X hX
      rw [eq_top_iff]
      rintro t -
      induction t using TensorProduct.induction_on with
      | zero => exact Submodule.zero_mem _
      | tmul a ω =>
        have e : a ⊗ₜ[A] ω = a • ((1 : q.ResidueField) ⊗ₜ[A] ω) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [e]
        clear e
        refine Submodule.smul_mem _ _ ?_
        have hω : ω ∈ Submodule.span (A ⧸ Ideal.span (Set.range h)) X := hX ▸ Submodule.mem_top
        induction hω using Submodule.span_induction with
        | mem x hx => exact Submodule.subset_span ⟨x, hx, rfl⟩
        | zero => rw [TensorProduct.tmul_zero]; exact Submodule.zero_mem _
        | add x y _ _ hx hy => rw [TensorProduct.tmul_add]; exact Submodule.add_mem _ hx hy
        | smul r x _ hx =>
          obtain ⟨a', rfl⟩ := Ideal.Quotient.mk_surjective r
          have e1 : (Ideal.Quotient.mk (Ideal.span (Set.range h)) a') • x = a' • x := by
            rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul]
          rw [e1, ← TensorProduct.smul_tmul]
          have e2 : (a' • (1 : q.ResidueField)) ⊗ₜ[A] x =
              (a' • (1 : q.ResidueField)) • ((1 : q.ResidueField) ⊗ₜ[A] x) := by
            rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
          rw [e2]
          exact Submodule.smul_mem _ _ hx
      | add x y hx hy => exact Submodule.add_mem _ hx hy
    have hVfin : Submodule.span q.ResidueField
        (Set.range (fun i => (1 : q.ResidueField) ⊗ₜ[A] b i)) = ⊤ := by
      have := transfer (Set.range b) b.span_eq
      rw [← Set.range_comp] at this
      exact this
    haveI : Module.Finite q.ResidueField
        (TensorProduct A q.ResidueField (KaehlerDifferential R (A ⧸ Ideal.span (Set.range h)))) :=
      Module.finite_def.mpr (Submodule.fg_def.mpr ⟨_, Set.finite_range _, hVfin⟩)
    have hdim : Module.finrank q.ResidueField
        (TensorProduct A q.ResidueField (KaehlerDifferential R (A ⧸ Ideal.span (Set.range h)))) ≤ m := by
      have := finrank_le_of_span_eq_top hVfin
      simpa using this
    have hw : Submodule.span q.ResidueField (Set.range (fun x : A ⧸ Ideal.span (Set.range h) =>
        (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R (A ⧸ Ideal.span (Set.range h)) x)) = ⊤ := by
      have := transfer _
        (KaehlerDifferential.span_range_derivation R (A ⧸ Ideal.span (Set.range h)))
      rw [← Set.range_comp] at this
      exact this
    obtain ⟨ι', a, _, hspan, hli⟩ := exists_linearIndependent' q.ResidueField
      (fun x : A ⧸ Ideal.span (Set.range h) =>
        (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R (A ⧸ Ideal.span (Set.range h)) x)
    haveI : Finite ι' := hli.finite
    letI : Fintype ι' := Fintype.ofFinite ι'
    have hcard : Fintype.card ι' ≤ Fintype.card (Fin m) := by
      rw [Fintype.card_fin]
      exact hli.fintype_card_le_finrank.trans hdim
    obtain ⟨e⟩ := Function.Embedding.nonempty_of_card_le hcard
    have hl : ∀ x : A ⧸ Ideal.span (Set.range h), Ideal.Quotient.mk (Ideal.span (Set.range h))
        (Function.surjInv (Ideal.Quotient.mk_surjective (I := Ideal.span (Set.range h))) x) = x :=
      fun x => Function.surjInv_eq _ x
    refine ⟨Function.extend e (Function.surjInv Ideal.Quotient.mk_surjective ∘ a) 0, ?_⟩
    rw [eq_top_iff, ← hw, ← hspan]
    apply Submodule.span_mono
    rintro _ ⟨t, rfl⟩
    refine ⟨e t, ?_⟩
    simp only [e.injective.extend_apply, Function.comp_apply, hl]

  intro R A _ _ _ m c h hsm q _ hIq
  obtain ⟨g, hg⟩ := Lc R A m c h hsm q hIq
  refine ⟨g, eq_top_iff.mpr ?_⟩
  intro ω _
  have hmem : LinearMap.baseChange q.ResidueField
      (KaehlerDifferential.map R R A (A ⧸ Ideal.span (Set.range h))) ω ∈
      Submodule.span q.ResidueField (Set.range (fun k : Fin m => (1 : q.ResidueField) ⊗ₜ[A]
        KaehlerDifferential.D R (A ⧸ Ideal.span (Set.range h))
          (Ideal.Quotient.mk (Ideal.span (Set.range h)) (g k)))) := by
    rw [hg]; exact Submodule.mem_top
  obtain ⟨d, hd⟩ := (Submodule.mem_span_range_iff_exists_fun q.ResidueField).mp hmem
  have himg : ∀ k, LinearMap.baseChange q.ResidueField
      (KaehlerDifferential.map R R A (A ⧸ Ideal.span (Set.range h)))
      ((1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R A (g k)) =
      (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R (A ⧸ Ideal.span (Set.range h))
        (Ideal.Quotient.mk (Ideal.span (Set.range h)) (g k)) := by
    intro k
    rw [LinearMap.baseChange_tmul, KaehlerDifferential.map_D, Ideal.Quotient.algebraMap_eq]
  have hker : LinearMap.lTensor q.ResidueField
      (KaehlerDifferential.map R R A (A ⧸ Ideal.span (Set.range h)))
      (ω - ∑ k, d k • ((1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R A (g k))) = 0 := by
    rw [← LinearMap.baseChange_eq_ltensor, map_sub, map_sum]
    simp only [map_smul, himg]
    rw [hd, sub_self]
  have h1 := Lb A (KaehlerDifferential R A) (KaehlerDifferential R (A ⧸ Ideal.span (Set.range h)))
    q (Ideal.span (Set.range h)) c
    (fun j => KaehlerDifferential.D R A (h j))
    (KaehlerDifferential.map R R A (A ⧸ Ideal.span (Set.range h)))
    (KaehlerDifferential.map_surjective_of_surjective R R A _ Ideal.Quotient.mk_surjective) hIq
    (La R A c h) _ hker
  rw [← sub_add_cancel ω
    (∑ k, d k • ((1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R A (g k)))]
  refine Submodule.add_mem _ ?_ ?_
  · refine Submodule.span_mono ?_ h1
    rintro _ ⟨j, rfl⟩
    exact ⟨Sum.inl j, rfl⟩
  · exact Submodule.sum_mem _ (fun k _ =>
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨Sum.inr k, rfl⟩))

theorem wc_tube_jacobian_etale : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] (n : ℕ) (ι : Type) [Fintype ι] (a : ι → A), RingHom.IsStandardSmoothOfRelativeDimension n (algebraMap R A) → Fintype.card ι = n → ∀ (q : Ideal A) [q.IsPrime], Submodule.span q.ResidueField (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D R A (a j))) = ⊤ → ∃ s : A, s ∉ q ∧ ∀ (A' : Type u) [CommRing A'] [Algebra A A'] [IsLocalization.Away s A'], RingHom.Etale ((algebraMap A A').comp (MvPolynomial.eval₂Hom (algebraMap R A) a)) :=
by
  classical

  have s5 : ∀ (R S T : Type u) [CommRing R] [CommRing S] [CommRing T] [Algebra R S]
      [Algebra R T] [Algebra S T] [IsScalarTower R S T], Algebra.FormallySmooth R T →
      Algebra.FinitePresentation R T → Algebra.FiniteType R S →
      Function.Bijective (KaehlerDifferential.mapBaseChange R S T) → Algebra.Etale S T := by
    intro R S T _ _ _ _ _ _ _ h1 h2 h3 hb
    have hH : Subsingleton (Algebra.H1Cotangent S T) := by
      have hx0 : ∀ x : Algebra.H1Cotangent S T, x = 0 := by
        intro x
        have hδ : Algebra.H1Cotangent.δ R S T x = 0 := by
          apply hb.1
          rw [map_zero]
          exact (Algebra.H1Cotangent.exact_δ_mapBaseChange R S T).apply_apply_eq_zero x
        obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_map_δ R S T x).mp hδ
        rw [Subsingleton.elim y 0, map_zero]
      exact ⟨fun a b => (hx0 a).trans (hx0 b).symm⟩
    have hΩ : Subsingleton Ω[T⁄S] := by
      have hw0 : ∀ w : Ω[T⁄S], w = 0 := by
        intro w
        obtain ⟨z, rfl⟩ := KaehlerDifferential.map_surjective R S T w
        obtain ⟨y, rfl⟩ := hb.2 z
        exact (KaehlerDifferential.exact_mapBaseChange_map R S T).apply_apply_eq_zero y
      exact ⟨fun a b => (hw0 a).trans (hw0 b).symm⟩
    haveI : Algebra.FormallyEtale S T := Algebra.FormallyEtale.mk hΩ hH
    haveI : Algebra.FinitePresentation S T :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R S T
    exact ⟨inferInstance, inferInstance⟩

  have s2 : ∀ (A M : Type u) [CommRing A] [AddCommGroup M] [Module A M] [Module.Finite A M]
      (ι : Type) (v : ι → M) (q : Ideal A) [q.IsPrime],
      Submodule.span q.ResidueField (Set.range (fun j => (1 : q.ResidueField) ⊗ₜ[A] v j)) = ⊤ →
      ∃ s : A, s ∉ q ∧ ∀ m : M, s • m ∈ Submodule.span A (Set.range v) := by
    intro A M _ _ _ _ ι v q _ h
    set N := Submodule.span A (Set.range v) with hN
    have hsub : Subsingleton (TensorProduct A q.ResidueField (M ⧸ N)) := by
      let πκ := LinearMap.baseChange q.ResidueField N.mkQ
      have hs : Function.Surjective πκ :=
        LinearMap.baseChange_surjective _ (Submodule.mkQ_surjective N)
      have hr : LinearMap.range πκ = ⊥ := by
        rw [LinearMap.range_eq_map, ← h, Submodule.map_span, Submodule.span_eq_bot]
        rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
        simp only [πκ, LinearMap.baseChange_tmul, Submodule.mkQ_apply]
        rw [(Submodule.Quotient.mk_eq_zero N).mpr (Submodule.subset_span ⟨j, rfl⟩),
          TensorProduct.tmul_zero]
      have h0 : ∀ x : TensorProduct A q.ResidueField (M ⧸ N), x = 0 := by
        intro x
        obtain ⟨x', rfl⟩ := hs x
        have hx : πκ x' ∈ LinearMap.range πκ := ⟨x', rfl⟩
        rw [hr] at hx
        exact hx
      exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩
    let p : PrimeSpectrum A := ⟨q, inferInstance⟩
    have hnot : p ∉ Module.support A (M ⧸ N) := fun hp =>
      not_nontrivial_iff_subsingleton.mpr hsub
        ((Module.mem_support_iff_nontrivial_residueField_tensorProduct p).mp hp)
    rw [Module.mem_support_iff_of_finite] at hnot
    obtain ⟨s, hs, hsq⟩ := SetLike.not_le_iff_exists.mp hnot
    refine ⟨s, hsq, fun m => ?_⟩
    have := Module.mem_annihilator.mp hs (Submodule.Quotient.mk m)
    rw [← Submodule.Quotient.mk_smul] at this
    exact (Submodule.Quotient.mk_eq_zero N).mp this

  have s3 : ∀ (R A A' : Type u) [CommRing R] [CommRing A] [CommRing A'] [Algebra R A]
      [Algebra A A'] [Algebra R A'] [IsScalarTower R A A'] (ι : Type) [Fintype ι] (a : ι → A)
      (s : A) [IsLocalization.Away s A'] [Algebra (MvPolynomial ι R) A']
      [IsScalarTower R (MvPolynomial ι R) A'],
      (∀ j, algebraMap (MvPolynomial ι R) A' (MvPolynomial.X j) = algebraMap A A' (a j)) →
      (∀ ω : Ω[A⁄R], s • ω ∈
        Submodule.span A (Set.range (fun j => KaehlerDifferential.D R A (a j)))) →
      Function.Surjective (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) A') := by
    intro R A A' _ _ _ _ _ _ _ ι _ a s _ _ _ hX hs
    haveI : Algebra.FormallyEtale A A' :=
      Algebra.FormallyEtale.of_isLocalization (Submonoid.powers s)
    have hbc := KaehlerDifferential.isBaseChange_of_formallyEtale R A A'
    rw [← LinearMap.range_eq_top, eq_top_iff]
    intro y _
    set Im := LinearMap.range (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) A')
      with hIm
    have hgen : ∀ j, KaehlerDifferential.map R R A A' (KaehlerDifferential.D R A (a j)) ∈ Im := by
      intro j
      refine ⟨1 ⊗ₜ KaehlerDifferential.D R _ (MvPolynomial.X j), ?_⟩
      simp only [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D, hX]
    have hle : Submodule.span A (Set.range (fun j => KaehlerDifferential.D R A (a j))) ≤
        (Im.restrictScalars A).comap (KaehlerDifferential.map R R A A') := by
      rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      exact hgen j
    have hall : ∀ ω, KaehlerDifferential.map R R A A' ω ∈ Im := by
      intro ω
      have h1 := hle (hs ω)
      rw [Submodule.mem_comap, Submodule.restrictScalars_mem, LinearMap.map_smul,
        ← algebraMap_smul A' s] at h1
      obtain ⟨u, hu⟩ := IsLocalization.Away.algebraMap_isUnit (S := A') s
      have e : KaehlerDifferential.map R R A A' ω =
          (↑u⁻¹ : A') • (algebraMap A A' s • KaehlerDifferential.map R R A A' ω) := by
        rw [← hu, smul_smul, Units.inv_mul, one_smul]
      rw [e]
      exact Im.smul_mem _ h1
    exact hbc.inductionOn y hall (fun c n hn => Im.smul_mem c hn)
      (fun _ _ h1 h2 => Im.add_mem h1 h2)

  have s4 : ∀ (R T : Type u) [CommRing R] [CommRing T] (ι : Type) [Fintype ι] [Algebra R T]
      [Algebra (MvPolynomial ι R) T] [IsScalarTower R (MvPolynomial ι R) T] (n : ℕ),
      Algebra.IsStandardSmoothOfRelativeDimension n R T → Fintype.card ι = n →
      Function.Surjective (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) T) →
      Function.Bijective (KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) T) := by
    intro R T _ _ ι _ _ _ _ n hT hc hs
    refine ⟨?_, hs⟩
    rcases subsingleton_or_nontrivial T with hT0 | hT0
    · haveI := Module.subsingleton T
        (TensorProduct (MvPolynomial ι R) T Ω[MvPolynomial ι R⁄R])
      intro x y _
      exact Subsingleton.elim x y
    · haveI := hT
      haveI : Algebra.IsStandardSmooth R T :=
        Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
      haveI : Algebra.FinitePresentation R T := Algebra.IsStandardSmooth.finitePresentation
      haveI : Algebra.FiniteType R T := Algebra.FiniteType.of_finitePresentation
      haveI : Module.Finite T Ω[T⁄R] := KaehlerDifferential.finite R T
      haveI : Module.Free T Ω[T⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
      haveI : StrongRankCondition T := commRing_strongRankCondition T
      have hfr : Module.finrank T Ω[T⁄R] = n := Module.finrank_eq_of_rank_eq
        (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential n)
      let bT := Module.finBasisOfFinrankEq T Ω[T⁄R] hfr
      let bS := ((KaehlerDifferential.mvPolynomialBasis R ι).baseChange T).reindex
        (Fintype.equivFinOfCardEq hc)
      let E := bS.equiv bT (Equiv.refl _)
      haveI : Module.Finite T (TensorProduct (MvPolynomial ι R) T Ω[MvPolynomial ι R⁄R]) :=
        Module.Finite.of_basis bS
      let f := E.symm.toLinearMap ∘ₗ KaehlerDifferential.mapBaseChange R (MvPolynomial ι R) T
      have hf : Function.Surjective f := E.symm.surjective.comp hs
      have hfi := OrzechProperty.injective_of_surjective_endomorphism f hf
      intro x y hxy
      apply hfi
      simp only [f, LinearMap.coe_comp, Function.comp_apply, hxy]

  intro R A _ _ _ n ι _ a hstd hcard q _ hspan
  haveI hA : Algebra.IsStandardSmoothOfRelativeDimension n R A :=
    (RingHom.isStandardSmoothOfRelativeDimension_algebraMap n).mp hstd
  haveI : Algebra.IsStandardSmooth R A :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
  haveI : Algebra.FinitePresentation R A := Algebra.IsStandardSmooth.finitePresentation
  haveI : Algebra.FiniteType R A := Algebra.FiniteType.of_finitePresentation
  haveI : Module.Finite A Ω[A⁄R] := KaehlerDifferential.finite R A
  obtain ⟨s, hsq, hs⟩ := s2 A Ω[A⁄R] ι (fun j => KaehlerDifferential.D R A (a j)) q hspan
  refine ⟨s, hsq, fun A' _ _ _ => ?_⟩
  letI : Algebra R A' := ((algebraMap A A').comp (algebraMap R A)).toAlgebra
  haveI : IsScalarTower R A A' := IsScalarTower.of_algebraMap_eq' rfl
  letI : Algebra (MvPolynomial ι R) A' :=
    ((algebraMap A A').comp (MvPolynomial.eval₂Hom (algebraMap R A) a)).toAlgebra
  haveI : IsScalarTower R (MvPolynomial ι R) A' := IsScalarTower.of_algebraMap_eq (fun r => by
    rw [MvPolynomial.algebraMap_eq]
    exact (congrArg (algebraMap A A') (MvPolynomial.eval₂Hom_C (algebraMap R A) a r)).symm)
  show RingHom.Etale (algebraMap (MvPolynomial ι R) A')
  rw [RingHom.etale_algebraMap]
  haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 A A' :=
    Algebra.IsStandardSmoothOfRelativeDimension.localization_away s
  have hstd' : Algebra.IsStandardSmoothOfRelativeDimension n R A' := by
    have h := Algebra.IsStandardSmoothOfRelativeDimension.trans n 0 R A A'
    rwa [zero_add] at h
  haveI := hstd'
  haveI : Algebra.IsStandardSmooth R A' :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
  haveI hsmA' : Algebra.Smooth R A' := Algebra.instSmoothOfIsStandardSmooth
  have hfsA' : Algebra.FormallySmooth R A' := hsmA'.formallySmooth
  have hfpA' : Algebra.FinitePresentation R A' := Algebra.IsStandardSmooth.finitePresentation
  have hftP : Algebra.FiniteType R (MvPolynomial ι R) :=
    @Algebra.FiniteType.of_finitePresentation R (MvPolynomial ι R) _ _ _
      (Algebra.FinitePresentation.mvPolynomial R R ι)
  have hsurj := s3 R A A' ι a s (fun j => by
    change algebraMap A A' (MvPolynomial.eval₂Hom (algebraMap R A) a (MvPolynomial.X j)) = _
    rw [MvPolynomial.eval₂Hom_X']) hs
  have hbij := s4 R A' ι n hstd' hcard hsurj
  exact s5 R (MvPolynomial ι R) A' hfsA' hfpA' hftP hbij

theorem wc_tube_shrink_basicOpen : ∀ {X Z : Scheme.{u}} {R : CommRingCat.{u}} (fX : X ⟶ Spec R) (i : Z ⟶ X) (W : X.Opens) (x : X) (hx : x ∈ W) (c m : ℕ) (h : Fin c → Γ(W, ⊤)) (g : Fin m → Γ(W, ⊤)) (s : Γ(W, ⊤)), IsAffineOpen W → ((W : Scheme.{u}).evaluation ⊤ ⟨x, hx⟩ trivial).hom s ≠ 0 → (∀ (ZW : Scheme.{u}) (iW : ZW ⟶ W) (gW : ZW ⟶ Z), IsPullback gW iW i W.ι → wcEtCutOut iW h) → (∀ (A' : Type u) [CommRing A'] [Algebra Γ(W, ⊤) A'] [IsLocalization.Away s A'], RingHom.Etale ((algebraMap Γ(W, ⊤) A').comp (MvPolynomial.eval₂Hom (W.ι ≫ fX).appTop.hom (Sum.elim h g)))) → ∃ W' : X.Opens, W' ≤ W ∧ x ∈ W' ∧ ∃ (h' : Fin c → Γ(W', ⊤)) (g' : Fin m → Γ(W', ⊤)), (∀ (ZW : Scheme.{u}) (iW : ZW ⟶ W') (gW : ZW ⟶ Z), IsPullback gW iW i W'.ι → wcEtCutOut iW h') ∧ RingHom.Etale (MvPolynomial.eval₂Hom (W'.ι ≫ fX).appTop.hom (Sum.elim h' g')) :=
by
  intro X Z R fX i W x hx c m h g s hW hs hcut het
  have wc_et_cutout_base_change : ∀ {W Z V ZV : Scheme.{u}} (iW : Z ⟶ W) {c : ℕ}
      (h : Fin c → Γ(W, ⊤)) (φ : V ⟶ W) (iV : ZV ⟶ V) (g : ZV ⟶ Z), wcEtCutOut iW h →
      IsAffine V → IsPullback g iV iW φ → wcEtCutOut iV (fun k => φ.appTop.hom (h k)) := by
    intro W Z V ZV iW c h φ iV g hcut hV hsq
    obtain ⟨hW, hci, hI⟩ := hcut
    haveI := hW
    haveI := hci
    haveI := hV
    haveI hciV : IsClosedImmersion iV :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    have F0 : ∀ {X Y Z' : Scheme.{u}} (f : X ⟶ Y) (f' : Y ⟶ Z') (x : Γ(Z', ⊤)),
        (f ≫ f').appTop.hom x = f.appTop.hom (f'.appTop.hom x) := fun _ _ _ => rfl
    have hk : ∀ k, iW.appTop.hom (h k) = 0 := by
      intro k
      rw [← RingHom.mem_ker, hI]
      exact Ideal.subset_span ⟨k, rfl⟩
    refine ⟨hV, hciV, le_antisymm ?_ ?_⟩
    · set J : Ideal Γ(V, ⊤) := Ideal.span (Set.range (fun k => φ.appTop.hom (h k))) with hJ
      let 𝓘 : V.IdealSheafData := Scheme.IdealSheafData.ofIdealTop J
      let ι : 𝓘.subscheme ⟶ V := 𝓘.subschemeι
      have hι : RingHom.ker ι.appTop.hom = J := by
        have h1 := Scheme.IdealSheafData.ker_subschemeι_app 𝓘 ⟨⊤, isAffineOpen_top V⟩
        have h2 := Scheme.IdealSheafData.ofIdealTop_ideal J ⟨⊤, isAffineOpen_top V⟩
        change RingHom.ker (ι.app ⊤).hom = J
        rw [h1]
        change 𝓘.ideal ⟨⊤, isAffineOpen_top V⟩ = J
        rw [h2]
        have : (homOfLE (le_top : (⊤ : V.Opens) ≤ ⊤)) = 𝟙 _ := Subsingleton.elim _ _
        simp
      have hle : RingHom.ker iW.appTop.hom ≤ RingHom.ker (ι ≫ φ).appTop.hom := by
        rw [hI, Ideal.span_le, Set.range_subset_iff]
        intro k
        show (ι ≫ φ).appTop.hom (h k) = 0
        rw [F0, ← RingHom.mem_ker, hι]
        exact Ideal.subset_span ⟨k, rfl⟩
      have hle' : Scheme.Hom.ker iW ≤ Scheme.Hom.ker (ι ≫ φ) := by
        apply Scheme.IdealSheafData.le_of_isAffine
        rw [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply]
        exact hle
      let l := IsClosedImmersion.lift iW (ι ≫ φ) hle'
      have hl : l ≫ iW = ι ≫ φ := IsClosedImmersion.lift_fac iW (ι ≫ φ) hle'
      have hm : hsq.lift l ι hl ≫ iV = ι := hsq.lift_snd l ι hl
      intro x hx
      rw [RingHom.mem_ker] at hx
      rw [← hι, RingHom.mem_ker, ← hm, F0, hx, map_zero]
    · rw [Ideal.span_le, Set.range_subset_iff]
      intro k
      show iV.appTop.hom (φ.appTop.hom (h k)) = 0
      rw [← F0, ← hsq.w, F0, hk, map_zero]
  have hU : IsAffineOpen (W.ι ''ᵁ ⊤) := by rw [Scheme.Opens.ι_image_top]; exact hW
  let s' : Γ(X, W.ι ''ᵁ ⊤) := s
  have hle : X.basicOpen s' ≤ W := (X.basicOpen_le s').trans (Scheme.Opens.ι_image_top W).le
  have hxW' : x ∈ X.basicOpen s' := by
    have h1 : (⟨x, hx⟩ : (W : Scheme.{u})) ∈ (W : Scheme.{u}).basicOpen s :=
      (Scheme.evaluation_ne_zero_iff_mem_basicOpen (W : Scheme.{u}) (U := ⊤) ⟨x, hx⟩ trivial
        s).mp hs
    have h2 := (Scheme.Hom.apply_mem_image_iff W.ι).mpr h1
    rw [Scheme.Opens.ι_image_basicOpen] at h2
    exact h2
  have hW'a : IsAffineOpen (X.basicOpen s') := hU.basicOpen s'
  letI : Algebra Γ(W, ⊤) Γ(X.basicOpen s', ⊤) := (X.homOfLE hle).appTop.hom.toAlgebra
  haveI hloc : IsLocalization.Away s Γ(X.basicOpen s', ⊤) := by
    show @IsLocalization.Away Γ(W, ⊤) _ s Γ(X.basicOpen s', ⊤) _
      (X.homOfLE hle).appTop.hom.toAlgebra
    rw [Scheme.homOfLE_appTop]
    exact hU.isLocalization_of_eq_basicOpen s' _ (Scheme.Opens.ι_image_top _)
  refine ⟨X.basicOpen s', hle, hxW', fun k => (X.homOfLE hle).appTop.hom (h k),
    fun k => (X.homOfLE hle).appTop.hom (g k), ?_, ?_⟩
  · intro ZW iW gW sq
    have P1 := (isPullback_morphismRestrict i W).flip
    have hcutW := hcut _ (i ∣_ W) (i ⁻¹ᵁ W).ι P1
    have w : gW ≫ i = (iW ≫ X.homOfLE hle) ≫ W.ι := by
      rw [Category.assoc, Scheme.homOfLE_ι]; exact sq.w
    have sq' : IsPullback (P1.lift gW (iW ≫ X.homOfLE hle) w) iW (i ∣_ W) (X.homOfLE hle) := by
      refine IsPullback.of_right ?_ (P1.lift_snd _ _ _) P1
      rw [P1.lift_fst, Scheme.homOfLE_ι]
      exact sq
    exact wc_et_cutout_base_change (i ∣_ W) h (X.homOfLE hle) iW _ hcutW hW'a sq'
  · have H := het Γ(X.basicOpen s', ⊤)
    rw [RingHom.algebraMap_toAlgebra, MvPolynomial.comp_eval₂Hom] at H
    have ha : ((X.basicOpen s').ι ≫ fX).appTop.hom =
        (X.homOfLE hle).appTop.hom.comp (W.ι ≫ fX).appTop.hom := by
      rw [← Scheme.homOfLE_ι X hle, Category.assoc, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    have hb : (fun j => (X.homOfLE hle).appTop.hom (Sum.elim h g j)) =
        Sum.elim (fun k => (X.homOfLE hle).appTop.hom (h k))
          (fun k => (X.homOfLE hle).appTop.hom (g k)) := by
      funext j; cases j <;> rfl
    rw [ha, ← hb]
    exact H

theorem wc_tube_algebraic_roof : ∀ (R A : Type u) [CommRing R] [CommRing A] (φ : R →+* A) (c m : ℕ) (h : Fin c → A) (g : Fin m → A), (MvPolynomial.eval₂Hom φ (Sum.elim h g)).Etale → ∃ (C : Type u) (_ : CommRing C) (f : A →+* C) (σ : MvPolynomial (Fin c) (A ⧸ Ideal.span (Set.range h)) →+* C) (ε : C →+* A ⧸ Ideal.span (Set.range h)), f.Etale ∧ σ.Etale ∧ Function.Surjective ε ∧ ε.comp f = Ideal.Quotient.mk _ ∧ ε.comp σ = MvPolynomial.constantCoeff ∧ RingHom.ker ε = Ideal.map f (Ideal.span (Set.range h)) ∧ RingHom.ker ε = Ideal.map σ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin c) (A ⧸ Ideal.span (Set.range h)) →+* _)) :=
by
  classical

  have s1 : ∀ (S : Type u) [CommRing S] (ι : Type), RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial ι S →+* S) = Ideal.span (Set.range (MvPolynomial.X : ι → MvPolynomial ι S)) := by
    intro S _ ι
    apply le_antisymm
    · intro x hx
      rw [RingHom.mem_ker] at hx
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      rw [MvPolynomial.mem_support_iff] at hm
      by_cases h0 : m = 0
      · subst h0
        exact absurd (by rw [← MvPolynomial.constantCoeff_eq]; exact hx) hm
      · obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp h0
        exact ⟨i, Set.mem_univ _, hi⟩
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      show _ ∈ RingHom.ker _
      rw [RingHom.mem_ker]
      exact MvPolynomial.constantCoeff_X S i

  have s3 : ∀ (R S : Type u) [CommRing R] [CommRing S] (σ : Type) (φ : R →+* S), φ.Etale → (MvPolynomial.map φ : MvPolynomial σ R →+* MvPolynomial σ S).Etale := by
    intro R S _ _ σ φ hφ
    letI := φ.toAlgebra
    have h1 : (algebraMap R S).Etale := hφ
    have h2 := RingHom.Etale.isStableUnderBaseChange.tensorProduct (MvPolynomial σ R) h1
    let e : TensorProduct R (MvPolynomial σ R) S ≃+* MvPolynomial σ S :=
      (Algebra.TensorProduct.comm R (MvPolynomial σ R) S).toRingEquiv.trans
        (MvPolynomial.algebraTensorAlgEquiv R S).toRingEquiv
    have h3 := RingHom.Etale.respectsIso.1 _ e h2
    convert h3 using 1
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
    · simp [e, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.comm_tmul,
        MvPolynomial.algebraTensorAlgEquiv_tmul]
      rfl
    · simp [e, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.comm_tmul,
        MvPolynomial.algebraTensorAlgEquiv_tmul]

  have s4 : ∀ (R₀ A P : Type u) [CommRing R₀] [CommRing A] [CommRing P] (Ψ : R₀ →+* A) (θ : R₀ →+* P), Ψ.Etale → θ.Etale → ∃ (C₀ : Type u) (_ : CommRing C₀) (f₀ : A →+* C₀) (σ₀ : P →+* C₀), f₀.Etale ∧ σ₀.Etale ∧ f₀.comp Ψ = σ₀.comp θ ∧ ∀ (D : Type u) [CommRing D] (u : A →+* D) (v : P →+* D), u.comp Ψ = v.comp θ → ∃ w : C₀ →+* D, w.comp f₀ = u ∧ w.comp σ₀ = v := by
    intro R₀ A P _ _ _ Ψ θ hΨ hθ
    letI := Ψ.toAlgebra
    letI := θ.toAlgebra
    refine ⟨TensorProduct R₀ A P, inferInstance, Algebra.TensorProduct.includeLeftRingHom,
      Algebra.TensorProduct.includeRight.toRingHom, ?_, ?_, ?_, ?_⟩
    · have h := RingHom.Etale.isStableUnderBaseChange.tensorProduct A
        (show (algebraMap R₀ P).Etale from hθ)
      convert h using 1
    · have h := RingHom.Etale.isStableUnderBaseChange.tensorProduct P
        (show (algebraMap R₀ A).Etale from hΨ)
      have h2 := RingHom.Etale.respectsIso.1 _ (Algebra.TensorProduct.comm R₀ P A).toRingEquiv h
      convert h2 using 1
      ext1 p
      simp [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.comm_tmul]
    · exact Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
    · intro D _ u v huv
      letI : Algebra R₀ D := (u.comp Ψ).toAlgebra
      let u' : A →ₐ[R₀] D := { u with commutes' := fun r => rfl }
      let v' : P →ₐ[R₀] D := { v with commutes' := fun r => (RingHom.congr_fun huv r).symm }
      refine ⟨(Algebra.TensorProduct.productMap u' v').toRingHom, ?_, ?_⟩
      · ext1 a
        simp [u', v', Algebra.TensorProduct.productMap_apply_tmul]
      · ext1 p
        simp [u', v', Algebra.TensorProduct.productMap_apply_tmul]

  have s5 : ∀ (R S R' : Type u) [CommRing R] [CommRing S] [CommRing R'] (σ : R →+* S) (ρ : R →+* R') (ε : S →+* R'), σ.Etale → Function.Surjective ρ → ε.comp σ = ρ → ∃ t : S, ε t = 1 ∧ ∀ x : S, ε x = 0 → t * x ∈ Ideal.map σ (RingHom.ker ρ) := by
    intro R S R' _ _ _ σ ρ ε hσ hρ hε
    letI := σ.toAlgebra
    haveI : Algebra.Etale R S := hσ.toAlgebra
    obtain ⟨t₀, ht₁, ht₂⟩ :=
      (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := R) (S := S)).mp inferInstance
    set N := Ideal.map σ (RingHom.ker ρ) with hNdef
    have hN : ∀ a ∈ RingHom.ker ρ, ((Ideal.Quotient.mk N).comp σ) a = 0 := fun a ha =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem σ ha)
    let ι0 : R ⧸ RingHom.ker ρ →+* S ⧸ N := Ideal.Quotient.lift _ ((Ideal.Quotient.mk N).comp σ) hN
    let ι : R' →+* S ⧸ N := ι0.comp (RingHom.quotientKerEquivOfSurjective hρ).symm.toRingHom
    have hι : ∀ r, ι (ρ r) = Ideal.Quotient.mk N (σ r) := by
      intro r
      have e1 : (RingHom.quotientKerEquivOfSurjective hρ).symm (ρ r) =
          Ideal.Quotient.mk (RingHom.ker ρ) r := by
        rw [RingEquiv.symm_apply_eq, RingHom.quotientKerEquivOfSurjective_apply_mk]
      show ι0 ((RingHom.quotientKerEquivOfSurjective hρ).symm (ρ r)) = _
      rw [e1]
      exact Ideal.Quotient.lift_mk _ _ _
    have hNε : N ≤ RingHom.ker ε := by
      rw [hNdef, Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, RingHom.mem_ker, ← RingHom.comp_apply, hε]
      exact hb
    let εb : S ⧸ N →+* R' := Ideal.Quotient.lift N ε (fun a ha => hNε ha)
    have hεb : ∀ s, εb (Ideal.Quotient.mk N s) = ε s := fun s => Ideal.Quotient.lift_mk _ _ _
    have hεbι : ∀ y, εb (ι y) = y := by
      intro y
      obtain ⟨r, rfl⟩ := hρ y
      rw [hι, hεb, ← RingHom.comp_apply, hε]
    let F : S →ₐ[R] S ⧸ N :=
      { (ι.comp ε) with
        commutes' := fun r => by
          show ι (ε (σ r)) = Ideal.Quotient.mk N (σ r)
          rw [← RingHom.comp_apply ε σ, hε, hι] }
    let G : S →ₐ[R] S ⧸ N := Ideal.Quotient.mkₐ R N
    let Φ := Algebra.TensorProduct.productMap F G
    have hΦ : ∀ a b : S, Φ (a ⊗ₜ[R] b) = ι (ε a) * Ideal.Quotient.mk N b := by
      intro a b
      rw [Algebra.TensorProduct.productMap_apply_tmul]
      rfl
    have hkey : ∀ z : TensorProduct R S S, εb (Φ z) = ε (Algebra.TensorProduct.lmul' R z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a b =>
        rw [hΦ, map_mul, hεbι, hεb, Algebra.TensorProduct.lmul'_apply_tmul, map_mul]
      | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
    obtain ⟨t, ht⟩ := Ideal.Quotient.mk_surjective (I := N) (Φ t₀)
    refine ⟨t, ?_, ?_⟩
    · rw [← hεb, ht, hkey, ht₂, map_one]
    · intro x hx
      have h1 := congrArg Φ (ht₁ x)
      rw [map_mul, map_sub, map_zero, hΦ, hΦ, hx, map_zero, map_one, map_one, one_mul,
        zero_mul, sub_zero] at h1
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul, ht, mul_comm]
      exact h1

  have s6 : ∀ (R : Type u) [CommRing R] (σ τ : Type), Function.Surjective (MvPolynomial.eval₂Hom MvPolynomial.C (Sum.elim (fun _ : σ => (0 : MvPolynomial τ R)) MvPolynomial.X) : MvPolynomial (σ ⊕ τ) R →+* MvPolynomial τ R) ∧ RingHom.ker (MvPolynomial.eval₂Hom MvPolynomial.C (Sum.elim (fun _ : σ => (0 : MvPolynomial τ R)) MvPolynomial.X) : MvPolynomial (σ ⊕ τ) R →+* MvPolynomial τ R) = Ideal.span (Set.range (fun j : σ => (MvPolynomial.X (Sum.inl j) : MvPolynomial (σ ⊕ τ) R))) := by
    intro R _ σ τ
    set ρ := (MvPolynomial.eval₂Hom MvPolynomial.C (Sum.elim (fun _ : σ => (0 : MvPolynomial τ R)) MvPolynomial.X) : MvPolynomial (σ ⊕ τ) R →+* MvPolynomial τ R) with hρ
    set J := Ideal.span (Set.range (fun j : σ => (MvPolynomial.X (Sum.inl j) : MvPolynomial (σ ⊕ τ) R))) with hJ
    have hr : ∀ p : MvPolynomial τ R, ρ (MvPolynomial.rename Sum.inr p) = p := by
      intro p
      rw [hρ, MvPolynomial.eval₂Hom_rename]
      have : (Sum.elim (fun _ : σ => (0 : MvPolynomial τ R)) MvPolynomial.X ∘ Sum.inr) =
          (MvPolynomial.X : τ → MvPolynomial τ R) := by
        funext k; rfl
      rw [this]
      exact MvPolynomial.eval₂_eta p
    have key : ∀ p, p - MvPolynomial.rename Sum.inr (ρ p) ∈ J := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a =>
        simp [ρ]
      | add p q hp hq =>
        rw [map_add, map_add]
        convert add_mem hp hq using 1
        ring
      | mul_X p n hp =>
        rw [map_mul, map_mul]
        have e : p * MvPolynomial.X n - MvPolynomial.rename Sum.inr (ρ p) *
            MvPolynomial.rename Sum.inr (ρ (MvPolynomial.X n)) =
            (p - MvPolynomial.rename Sum.inr (ρ p)) * MvPolynomial.X n +
            MvPolynomial.rename Sum.inr (ρ p) *
              (MvPolynomial.X n - MvPolynomial.rename Sum.inr (ρ (MvPolynomial.X n))) := by ring
        rw [e]
        refine add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
        cases n with
        | inl i =>
          simp only [ρ, MvPolynomial.eval₂Hom_X', Sum.elim_inl, map_zero, sub_zero]
          exact Ideal.subset_span ⟨i, rfl⟩
        | inr k =>
          simp [ρ]
    refine ⟨fun p => ⟨_, hr p⟩, le_antisymm ?_ ?_⟩
    · intro p hp
      have := key p
      rw [RingHom.mem_ker.mp hp, map_zero, sub_zero] at this
      exact this
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      show _ ∈ RingHom.ker ρ
      rw [RingHom.mem_ker]
      simp [ρ]

  have s7 : ∀ (A : Type u) [CommRing A] (I : Ideal A) (c : ℕ) (C₀ : Type u) [CommRing C₀] (f₀ : A →+* C₀) (σ₀ : MvPolynomial (Fin c) (A ⧸ I) →+* C₀) (ε₀ : C₀ →+* A ⧸ I) (t : C₀), f₀.Etale → σ₀.Etale → ε₀.comp f₀ = Ideal.Quotient.mk I → ε₀.comp σ₀ = MvPolynomial.constantCoeff → ε₀ t = 1 → Ideal.map f₀ I = Ideal.map σ₀ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin c) (A ⧸ I) →+* A ⧸ I)) → (∀ x : C₀, ε₀ x = 0 → t * x ∈ Ideal.map f₀ I) → ∃ (C : Type u) (_ : CommRing C) (f : A →+* C) (σ : MvPolynomial (Fin c) (A ⧸ I) →+* C) (ε : C →+* A ⧸ I), f.Etale ∧ σ.Etale ∧ Function.Surjective ε ∧ ε.comp f = Ideal.Quotient.mk _ ∧ ε.comp σ = MvPolynomial.constantCoeff ∧ RingHom.ker ε = Ideal.map f I ∧ RingHom.ker ε = Ideal.map σ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin c) (A ⧸ I) →+* _)) := by
    intro A _ I c C₀ _ f₀ σ₀ ε₀ t hf hσ hεf hεσ ht hN htx
    let lam : C₀ →+* Localization.Away t := algebraMap C₀ (Localization.Away t)
    have hlam : lam.Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway t)
    have hu : IsUnit (ε₀ t) := ht ▸ isUnit_one
    let ε : Localization.Away t →+* A ⧸ I := IsLocalization.Away.lift t hu
    have hεl : ∀ a, ε (lam a) = ε₀ a := IsLocalization.Away.lift_eq t hu
    have hεlam : ε.comp lam = ε₀ := RingHom.ext hεl
    have hker : RingHom.ker ε = Ideal.map lam (Ideal.map f₀ I) := by
      apply le_antisymm
      · intro y hy
        obtain ⟨⟨x, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers t) y
        simp only at hy ⊢
        rw [IsLocalization.mk'_mem_map_algebraMap_iff]
        have hx : ε₀ x = 0 := by
          have h2 := congrArg ε (IsLocalization.mk'_spec (Localization.Away t) x s)
          rw [map_mul, RingHom.mem_ker.mp hy, zero_mul] at h2
          rw [← hεl]
          exact h2.symm
        exact ⟨t, Submonoid.mem_powers t, htx x hx⟩
      · rw [Ideal.map_le_iff_le_comap]
        intro n hn
        rw [Ideal.mem_comap, RingHom.mem_ker, hεl]
        have hle : Ideal.map f₀ I ≤ RingHom.ker ε₀ := by
          rw [Ideal.map_le_iff_le_comap]
          intro a ha
          rw [Ideal.mem_comap, RingHom.mem_ker, ← RingHom.comp_apply, hεf,
            Ideal.Quotient.eq_zero_iff_mem]
          exact ha
        exact hle hn
    refine ⟨Localization.Away t, inferInstance, lam.comp f₀, lam.comp σ₀, ε,
      RingHom.Etale.stableUnderComposition _ _ hf hlam,
      RingHom.Etale.stableUnderComposition _ _ hσ hlam, ?_, ?_, ?_, ?_, ?_⟩
    · intro b
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
      exact ⟨lam (f₀ a), by rw [hεl, ← RingHom.comp_apply, hεf]⟩
    · rw [← RingHom.comp_assoc, hεlam, hεf]
    · rw [← RingHom.comp_assoc, hεlam, hεσ]
    · rw [hker, Ideal.map_map]
    · rw [hker, hN, Ideal.map_map]

  have s2 : ∀ (R R' A : Type u) [CommRing R] [CommRing R'] [CommRing A] (φ : R →+* A) (ρ : R →+* R') (J : Ideal A), φ.Etale → Function.Surjective ρ → Ideal.map φ (RingHom.ker ρ) = J → ∀ β : R' →+* A ⧸ J, β.comp ρ = (Ideal.Quotient.mk J).comp φ → β.Etale := by
    intro R R' A _ _ _ φ ρ J hφ hρ hJ β hβ
    letI := φ.toAlgebra
    have h1 := RingHom.Etale.isStableUnderBaseChange.tensorProduct (R ⧸ RingHom.ker ρ)
      (show (algebraMap R A).Etale from hφ)
    let e₁ : R' ≃+* R ⧸ RingHom.ker ρ := (RingHom.quotientKerEquivOfSurjective hρ).symm
    let e₂ : TensorProduct R (R ⧸ RingHom.ker ρ) A ≃+* A ⧸ J :=
      ((Algebra.TensorProduct.comm R (R ⧸ RingHom.ker ρ) A).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A (RingHom.ker ρ)).symm.toRingEquiv).trans
        (Ideal.quotEquivOfEq hJ)
    have h2 := RingHom.Etale.respectsIso.2 _ e₁ (RingHom.Etale.respectsIso.1 _ e₂ h1)
    convert h2 using 1
    ext1 y
    obtain ⟨r, rfl⟩ := hρ y
    have he1 : e₁ (ρ r) = Ideal.Quotient.mk (RingHom.ker ρ) r := by
      show (RingHom.quotientKerEquivOfSurjective hρ).symm (ρ r) = _
      rw [RingEquiv.symm_apply_eq, RingHom.quotientKerEquivOfSurjective_apply_mk]
    have hT : (1 : A) ⊗ₜ[R] (Ideal.Quotient.mk (RingHom.ker ρ) r) = (φ r) ⊗ₜ[R] (1 : R ⧸ RingHom.ker ρ) := by
      rw [← Ideal.Quotient.algebraMap_eq, Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul,
        Algebra.smul_def, mul_one]
      rfl
    have he2 : (Algebra.TensorProduct.quotIdealMapEquivTensorQuot A (RingHom.ker ρ)).symm
        ((φ r) ⊗ₜ[R] (1 : R ⧸ RingHom.ker ρ)) = Ideal.Quotient.mk _ (φ r) := by
      rw [AlgEquiv.symm_apply_eq, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
    rw [← RingHom.comp_apply β ρ, hβ, RingHom.comp_apply]
    show _ = e₂ (algebraMap (R ⧸ RingHom.ker ρ) (TensorProduct R (R ⧸ RingHom.ker ρ) A) (e₁ (ρ r)))
    rw [he1, Algebra.TensorProduct.algebraMap_apply]
    show _ = Ideal.quotEquivOfEq hJ
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot A (RingHom.ker ρ)).symm
        ((Algebra.TensorProduct.comm R (R ⧸ RingHom.ker ρ) A)
          ((algebraMap (R ⧸ RingHom.ker ρ) (R ⧸ RingHom.ker ρ)) (Ideal.Quotient.mk (RingHom.ker ρ) r) ⊗ₜ[R] (1 : A))))
    rw [Algebra.TensorProduct.comm_tmul, Algebra.algebraMap_self, RingHom.id_apply, hT, he2]
    rfl

  intro R A _ _ φ c m h g hΨ
  set I := Ideal.span (Set.range h) with hI
  set Ψ := MvPolynomial.eval₂Hom φ (Sum.elim h g) with hΨdef
  obtain ⟨hρs, hρk⟩ := s6 R (Fin c) (Fin m)
  set ρ := (MvPolynomial.eval₂Hom MvPolynomial.C (Sum.elim (fun _ : Fin c => (0 : MvPolynomial (Fin m) R)) MvPolynomial.X) : MvPolynomial (Fin c ⊕ Fin m) R →+* MvPolynomial (Fin m) R) with hρ
  have hmapI : Ideal.map Ψ (RingHom.ker ρ) = I := by
    rw [hρk, Ideal.map_span, ← Set.range_comp]
    congr 2
    funext j
    simp [Ψ]
  have hhI : ∀ j, Ideal.Quotient.mk I (h j) = 0 := fun j =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
  let ψ : MvPolynomial (Fin m) R →+* A ⧸ I :=
    MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I).comp φ) (fun k => Ideal.Quotient.mk I (g k))
  have hψρ : ψ.comp ρ = (Ideal.Quotient.mk I).comp Ψ := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
    · simp [ψ, ρ, Ψ]
    · cases i with
      | inl j => simp [ψ, ρ, Ψ, hhI]
      | inr k => simp [ψ, ρ, Ψ]
  have hψ : ψ.Etale := s2 _ _ _ Ψ ρ I hΨ hρs hmapI ψ hψρ
  let θ : MvPolynomial (Fin c ⊕ Fin m) R →+* MvPolynomial (Fin c) (A ⧸ I) :=
    (MvPolynomial.map ψ).comp (MvPolynomial.sumRingEquiv R (Fin c) (Fin m)).toRingHom
  have hθ : θ.Etale := RingHom.Etale.respectsIso.2 _ _ (s3 _ _ (Fin c) ψ hψ)
  have hθX : ∀ j, θ (MvPolynomial.X (Sum.inl j)) = MvPolynomial.X j := by
    intro j
    simp [θ, MvPolynomial.sumRingEquiv_X_inl]
  have hθY : ∀ k, θ (MvPolynomial.X (Sum.inr k)) = MvPolynomial.C (Ideal.Quotient.mk I (g k)) := by
    intro k
    simp [θ, MvPolynomial.sumRingEquiv_X_inr, ψ]
  have hθC : ∀ r, θ (MvPolynomial.C r) = MvPolynomial.C (Ideal.Quotient.mk I (φ r)) := by
    intro r
    simp [θ, MvPolynomial.sumRingEquiv_C, ψ]
  obtain ⟨C₀, _, f₀, σ₀, hf₀, hσ₀, hcomm, huniv⟩ := s4 _ _ _ Ψ θ hΨ hθ
  have hcc : (Ideal.Quotient.mk I).comp Ψ = MvPolynomial.constantCoeff.comp θ := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
    · rw [RingHom.comp_apply, RingHom.comp_apply, hθC, MvPolynomial.constantCoeff_C]
      simp [Ψ]
    · cases i with
      | inl j =>
        rw [RingHom.comp_apply, RingHom.comp_apply, hθX, MvPolynomial.constantCoeff_X]
        simp [Ψ, hhI]
      | inr k =>
        rw [RingHom.comp_apply, RingHom.comp_apply, hθY, MvPolynomial.constantCoeff_C]
        simp [Ψ]
  obtain ⟨ε₀, hε₀f, hε₀σ⟩ := huniv (A ⧸ I) (Ideal.Quotient.mk I) MvPolynomial.constantCoeff hcc
  have hN : Ideal.map f₀ I = Ideal.map σ₀ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin c) (A ⧸ I) →+* A ⧸ I)) := by
    rw [s1]
    show Ideal.map f₀ (Ideal.span (Set.range h)) = _
    rw [Ideal.map_span, Ideal.map_span, ← Set.range_comp, ← Set.range_comp]
    congr 2
    funext j
    simp only [Function.comp_apply]
    rw [← hθX j, ← RingHom.comp_apply σ₀ θ, ← hcomm, RingHom.comp_apply]
    simp [Ψ]
  have hccs : Function.Surjective (MvPolynomial.constantCoeff : MvPolynomial (Fin c) (A ⧸ I) →+* A ⧸ I) :=
    fun b => ⟨MvPolynomial.C b, MvPolynomial.constantCoeff_C _ b⟩
  obtain ⟨t, ht1, htx⟩ := s5 _ _ _ σ₀ MvPolynomial.constantCoeff ε₀ hσ₀ hccs hε₀σ
  exact s7 A I c C₀ f₀ σ₀ ε₀ t hf₀ hσ₀ hε₀f hε₀σ ht1 hN (fun x hx => by rw [hN]; exact htx x hx)

theorem wc_tube_spec_roof : ∀ (K : Type u) [Field K] (W ZW : Scheme.{u}) (fW : W ⟶ Spec (.of K)) (iW : ZW ⟶ W) (c : ℕ) (h : Fin c → Γ(W, ⊤)), wcEtCutOut iW h → ∀ (C : Type u) [CommRing C] (f : Γ(W, ⊤) →+* C) (σ : MvPolynomial (Fin c) (Γ(W, ⊤) ⧸ Ideal.span (Set.range h)) →+* C) (ε : C →+* Γ(W, ⊤) ⧸ Ideal.span (Set.range h)), f.Etale → σ.Etale → Function.Surjective ε → ε.comp f = Ideal.Quotient.mk _ → ε.comp σ = MvPolynomial.constantCoeff → RingHom.ker ε = Ideal.map f (Ideal.span (Set.range h)) → RingHom.ker ε = Ideal.map σ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin c) (Γ(W, ⊤) ⧸ Ideal.span (Set.range h)) →+* _)) → ∀ (P : Scheme.{u}) (p : P ⟶ ZW) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : ZW ⟶ P), IsPullback p q (iW ≫ fW) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 ZW → z0 ≫ q = (iW ≫ fW) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → ∃ (V' : Scheme.{u}) (π : V' ⟶ W) (σ' : V' ⟶ P) (e : ZW ⟶ V'), Etale π ∧ Etale σ' ∧ IsPullback (𝟙 ZW) e iW π ∧ IsPullback (𝟙 ZW) e z0 σ' :=
by
  intro K _ W ZW fW iW c h hcut C _ f σ ε hf hσ hεs hεf hεσ hk1 hk2 P p q z0 hP hz0p hz0q

  have s1 : ∀ {A B C : CommRingCat.{u}} (π : A ⟶ B) (f : A ⟶ C) (ε : C ⟶ B), f ≫ ε = π →
      Function.Surjective π.hom → RingHom.ker ε.hom = Ideal.map f.hom (RingHom.ker π.hom) →
      IsPushout π f (𝟙 B) ε := by
    intro A B C π f ε hfe hs hk
    have w : CommSq π f (𝟙 B) ε := ⟨by rw [Category.comp_id, hfe]⟩
    refine IsPushout.of_isColimit' w (Limits.PushoutCocone.IsColimit.mk w.w (fun s => s.inl)
      (fun s => Category.id_comp _) ?_ ?_)
    · intro s
      have hcond : ∀ a, s.inl.hom (π.hom a) = s.inr.hom (f.hom a) := by
        intro a
        have := congrArg (fun g => g.hom a) s.condition
        simpa using this
      have hJ : Ideal.map f.hom (RingHom.ker π.hom) ≤ RingHom.ker s.inr.hom := by
        rw [Ideal.map_le_iff_le_comap]
        intro k hk'
        rw [Ideal.mem_comap, RingHom.mem_ker, ← hcond, RingHom.mem_ker.mp hk', map_zero]
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro x
      obtain ⟨a, ha⟩ := hs (ε.hom x)
      have hx : x - f.hom a ∈ RingHom.ker ε.hom := by
        rw [RingHom.mem_ker, map_sub]
        have : ε.hom (f.hom a) = π.hom a := by rw [← hfe]; rfl
        rw [this, ha, sub_self]
      have h0 := hJ (hk ▸ hx)
      rw [RingHom.mem_ker, map_sub, sub_eq_zero] at h0
      rw [CommRingCat.hom_comp, RingHom.comp_apply, h0, ← hcond, ha]
    · intro s m hm _
      simpa using hm

  have s2 : ∀ {A B C : CommRingCat.{u}} (π : A ⟶ B) (f : A ⟶ C) (ε : C ⟶ B),
      IsPushout π f (𝟙 B) ε → ∀ (Z Y : Scheme.{u}) (j : Z ⟶ Y) (αZ : Z ≅ Spec B)
      (αY : Y ≅ Spec A), j ≫ αY.hom = αZ.hom ≫ Spec.map π →
      IsPullback (𝟙 Z) (αZ.hom ≫ Spec.map ε) j (Spec.map f ≫ αY.inv) := by
    intro A B C π f ε H Z Y j αZ αY hj
    have H' := isPullback_SpecMap_of_isPushout π f (𝟙 B) ε H
    refine IsPullback.of_iso H' αZ.symm αZ.symm (Iso.refl _) αY.symm ?_ ?_ ?_ ?_
    · simp
    · simp
    · simp only [Iso.symm_hom]
      rw [← cancel_mono αY.hom]
      simp [hj]
    · simp

  have s3 : ∃ (αW : W ≅ Spec (.of Γ(W, ⊤)))
      (αZ : ZW ≅ Spec (.of (Γ(W, ⊤) ⧸ Ideal.span (Set.range h))))
      (κ : K →+* Γ(W, ⊤) ⧸ Ideal.span (Set.range h)),
      iW ≫ αW.hom = αZ.hom ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span (Set.range h)))) ∧
      iW ≫ fW = αZ.hom ≫ Spec.map (CommRingCat.ofHom κ) := by
    obtain ⟨hWa, hcl, hker⟩ := hcut
    haveI := hWa
    haveI := hcl
    haveI : IsAffine ZW := isAffine_of_isAffineHom iW
    have hs : Function.Surjective iW.appTop.hom :=
      (isClosedImmersion_iff_isAffineHom.mp hcl).2 ⊤ (isAffineOpen_top W)
    let e : (Γ(W, ⊤) ⧸ Ideal.span (Set.range h)) ≃+* Γ(ZW, ⊤) :=
      (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hs)
    have he : ∀ a, e (Ideal.Quotient.mk _ a) = iW.appTop.hom a := fun a => rfl
    have hcomp : CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span (Set.range h))) ≫
        e.toCommRingCatIso.hom = iW.appTop := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact he a
    let αZ : ZW ≅ Spec (.of (Γ(W, ⊤) ⧸ Ideal.span (Set.range h))) :=
      ZW.isoSpec ≪≫ asIso (Spec.map e.toCommRingCatIso.hom)
    have h1 : iW ≫ W.isoSpec.hom =
        αZ.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span (Set.range h)))) := by
      rw [← Scheme.isoSpec_hom_naturality, ← hcomp, Spec.map_comp]
      simp only [αZ, Iso.trans_hom, asIso_hom, Category.assoc]
    let γ := Scheme.ΓSpecIso (CommRingCat.of K)
    refine ⟨W.isoSpec, αZ, (Ideal.Quotient.mk _).comp (fW.appTop.hom.comp γ.inv.hom), h1, ?_⟩
    have hκ : CommRingCat.ofHom ((Ideal.Quotient.mk (Ideal.span (Set.range h))).comp
        (fW.appTop.hom.comp γ.inv.hom)) =
        γ.inv ≫ fW.appTop ≫ CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span (Set.range h))) :=
      rfl
    have hK : (Spec (.of K)).isoSpec.hom ≫ Spec.map γ.inv = 𝟙 _ := by
      rw [Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
    rw [hκ, Spec.map_comp, Spec.map_comp, ← Category.assoc, ← Category.assoc, ← h1,
      Category.assoc iW, Scheme.isoSpec_hom_naturality, Category.assoc, Category.assoc, hK,
      Category.comp_id]

  have s4 : ∀ (B : Type u) [CommRing B] (κ : K →+* B) (αZ : ZW ≅ Spec (.of B))
      (S : ZW ⟶ Spec (.of K)), S = αZ.hom ≫ Spec.map (CommRingCat.ofHom κ) →
      IsPullback p q S (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) →
      z0 ≫ q = S ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) →
      ∃ αP : P ≅ Spec (.of (MvPolynomial (Fin c) B)), z0 ≫ αP.hom = αZ.hom ≫
        Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin c) B →+* B)) := by
    intro B _ κ αZ S hS hP' hz0q'
    letI : Algebra K B := κ.toAlgebra
    have hT := CommRingCat.isPushout_tensorProduct K B (MvPolynomial (Fin c) K)
    let E := (MvPolynomial.algebraTensorAlgEquiv (σ := Fin c) K B).toRingEquiv.toCommRingCatIso
    have hPo : IsPushout (CommRingCat.ofHom κ)
        (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))
        (CommRingCat.ofHom (MvPolynomial.C : B →+* MvPolynomial (Fin c) B))
        (CommRingCat.ofHom (MvPolynomial.map κ)) := by
      refine IsPushout.of_iso hT (Iso.refl _) (Iso.refl _) (Iso.refl _) E ?_ ?_ ?_ ?_
      · rfl
      · rfl
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro b
        simp [E, MvPolynomial.algebraTensorAlgEquiv_tmul, MvPolynomial.smul_eq_C_mul]
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        simp [E, MvPolynomial.algebraTensorAlgEquiv_tmul, RingHom.algebraMap_toAlgebra]
    have hM0 := isPullback_SpecMap_of_isPushout _ _ _ _ hPo
    have hM : IsPullback
        (Spec.map (CommRingCat.ofHom (MvPolynomial.C : B →+* MvPolynomial (Fin c) B)) ≫ αZ.inv)
        (Spec.map (CommRingCat.ofHom (MvPolynomial.map κ))) S
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) := by
      refine IsPullback.of_iso hM0 (Iso.refl _) αZ.symm (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp
      · simp [hS]
      · simp
    let αP := IsPullback.isoIsPullback _ _ hP' hM
    have hfst : αP.hom ≫
        (Spec.map (CommRingCat.ofHom (MvPolynomial.C : B →+* MvPolynomial (Fin c) B)) ≫
          αZ.inv) = p := IsPullback.isoIsPullback_hom_fst _ _ _ _
    have hsnd : αP.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.map κ)) = q :=
      IsPullback.isoIsPullback_hom_snd _ _ _ _
    refine ⟨αP, hM.hom_ext ?_ ?_⟩
    · rw [Category.assoc z0, hfst, hz0p, Category.assoc, ← Category.assoc (Spec.map _),
        ← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_C,
        CommRingCat.ofHom_id, Spec.map_id, Category.id_comp, Iso.hom_inv_id]
    · rw [Category.assoc z0, hsnd, hz0q', hS, Category.assoc, Category.assoc, ← Spec.map_comp,
        ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
        MvPolynomial.constantCoeff_comp_map]

  obtain ⟨αW, αZ, κ, hr1, hr2⟩ := s3
  obtain ⟨αP, hr3⟩ := s4 (Γ(W, ⊤) ⧸ Ideal.span (Set.range h)) κ αZ (iW ≫ fW) hr2 hP hz0q
  have po1 := s1 (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span (Set.range h))))
    (CommRingCat.ofHom f) (CommRingCat.ofHom ε)
    (by rw [← CommRingCat.ofHom_comp, hεf]) Ideal.Quotient.mk_surjective
    (by simp only [CommRingCat.hom_ofHom]; rw [Ideal.mk_ker]; exact hk1)
  have po2 := s1 (CommRingCat.ofHom (MvPolynomial.constantCoeff :
      MvPolynomial (Fin c) (Γ(W, ⊤) ⧸ Ideal.span (Set.range h)) →+* _))
    (CommRingCat.ofHom σ) (CommRingCat.ofHom ε)
    (by rw [← CommRingCat.ofHom_comp, hεσ])
    (fun b => ⟨MvPolynomial.C b, MvPolynomial.constantCoeff_C _ b⟩)
    (by simp only [CommRingCat.hom_ofHom]; exact hk2)
  have sq1 := s2 _ _ _ po1 ZW W iW αZ αW hr1
  have sq2 := s2 _ _ _ po2 ZW P z0 αZ αP hr3
  haveI : Etale (Spec.map (CommRingCat.ofHom f)) := HasRingHomProperty.Spec_iff.mpr hf
  haveI : Etale (Spec.map (CommRingCat.ofHom σ)) := HasRingHomProperty.Spec_iff.mpr hσ
  exact ⟨Spec (.of C), Spec.map (CommRingCat.ofHom f) ≫ αW.inv,
    Spec.map (CommRingCat.ofHom σ) ≫ αP.inv, αZ.hom ≫ Spec.map (CommRingCat.ofHom ε),
    inferInstance, inferInstance, sq1, sq2⟩

theorem wc_smooth_pair_etale_tube : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], 1 ≤ c → c ≤ n → ∀ (V : X.Opens) (z : Z), i z ∈ V → ∃ W : X.Opens, W ≤ V ∧ i z ∈ W ∧ ∀ (ZW : Scheme.{u}) (iW : ZW ⟶ W) (gW : ZW ⟶ Z), IsPullback gW iW i W.ι → ∀ (P : Scheme.{u}) (p : P ⟶ ZW) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : ZW ⟶ P), IsPullback p q (iW ≫ W.ι ≫ fX) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 ZW → z0 ≫ q = (iW ≫ W.ι ≫ fX) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → IsClosedImmersion z0 ∧ ∃ (V' : Scheme.{u}) (π : V' ⟶ W) (σ : V' ⟶ P) (e : ZW ⟶ V'), Etale π ∧ Etale σ ∧ IsPullback (𝟙 ZW) e iW π ∧ IsPullback (𝟙 ZW) e z0 σ :=
by
  intro K _ _ X Z fX n c _ i _ _ hc1 hcn V z hzV

  obtain ⟨W₁, hzW₁, h, hW₁V, hW₁a, hcut₁, hstdA, hstdB, hker⟩ :=
    wc_tube_chart K X Z fX n c i hcn V z hzV
  letI : Algebra Γ(Spec (.of K), ⊤) Γ(W₁, ⊤) := (W₁.ι ≫ fX).appTop.hom.toAlgebra
  haveI : IsDomain ((W₁ : Scheme.{u}).residueField ⟨i z, hzW₁⟩) := by
    exact @Field.isDomain _ (Scheme.instFieldCarrierResidueField _ _)
  haveI hqp : (RingHom.ker ((W₁ : Scheme.{u}).evaluation ⊤ ⟨i z, hzW₁⟩ trivial).hom).IsPrime :=
    RingHom.ker_isPrime _

  obtain ⟨g, hg⟩ := wc_tube_complementary_coords Γ(Spec (.of K), ⊤) Γ(W₁, ⊤) (n - c) c h hstdB
    (RingHom.ker ((W₁ : Scheme.{u}).evaluation ⊤ ⟨i z, hzW₁⟩ trivial).hom) hker

  obtain ⟨s, hsq, het⟩ := wc_tube_jacobian_etale Γ(Spec (.of K), ⊤) Γ(W₁, ⊤) n
    (Fin c ⊕ Fin (n - c)) (Sum.elim h g) hstdA
    (by simp only [Fintype.card_sum, Fintype.card_fin]; omega)
    (RingHom.ker ((W₁ : Scheme.{u}).evaluation ⊤ ⟨i z, hzW₁⟩ trivial).hom) hg

  obtain ⟨W, hWW₁, hzW, h', g', hcut, hetW⟩ := wc_tube_shrink_basicOpen fX i W₁ (i z) hzW₁ c
    (n - c) h g s hW₁a (fun h0 => hsq (RingHom.mem_ker.mpr h0)) hcut₁ het
  refine ⟨W, hWW₁.trans hW₁V, hzW, ?_⟩
  intro ZW iW gW hsqW P p q z0 hP hz0p hz0q

  have hz0 : IsClosedImmersion z0 := by
    haveI : IsSeparated p :=
      MorphismProperty.of_isPullback (P := @IsSeparated) hP.flip inferInstance
    haveI : IsClosedImmersion (z0 ≫ p) := by rw [hz0p]; infer_instance
    exact IsClosedImmersion.of_comp z0 p

  obtain ⟨C, _, f, σ, ε, hf, hσ, hεs, hεf, hεσ, hk1, hk2⟩ :=
    wc_tube_algebraic_roof _ _ (W.ι ≫ fX).appTop.hom c (n - c) h' g' hetW
  exact ⟨hz0, wc_tube_spec_roof K W ZW (W.ι ≫ fX) iW c h' (hcut ZW iW gW hsqW) C f σ ε hf hσ hεs
    hεf hεσ hk1 hk2 P p q z0 hP hz0p hz0q⟩

theorem wc_et_pull_punctured_bundle : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → 1 ≤ c → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D : wcEtPullData (U.ι ≫ p) ℓ) (k : ℕ), Function.Injective (wcEtPull D k) ∧ (k + 2 ≤ 2 * c → Function.Surjective (wcEtPull D k)) :=
by
  classical
  intro K _ _ S fS m _ c P p q z0 hP hz0p hz0q hc U hU ℓ _ hℓ D k

  obtain ⟨τ, hτ⟩ : ∃ τ : S ⟶ (U : Scheme.{u}), τ ≫ U.ι ≫ p = 𝟙 S := by
    let i₀ : Fin c := ⟨0, by omega⟩
    let e : MvPolynomial (Fin c) K →+* K := MvPolynomial.eval (fun i => if i = i₀ then 1 else 0)
    have he : e.comp (algebraMap K (MvPolynomial (Fin c) K)) = RingHom.id K := by
      ext r
      simp [e, MvPolynomial.algebraMap_eq]
    have hpt : Spec.map (CommRingCat.ofHom e) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) = 𝟙 _ := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, he]
      simp
    let τP : S ⟶ P := hP.lift (𝟙 S) (fS ≫ Spec.map (CommRingCat.ofHom e))
      (by rw [Category.assoc, hpt, Category.comp_id, Category.id_comp])
    have hτp : τP ≫ p = 𝟙 S := hP.lift_fst _ _ _
    have hτq : τP ≫ q = fS ≫ Spec.map (CommRingCat.ofHom e) := hP.lift_snd _ _ _
    have hrange : Set.range τP ⊆ Set.range U.ι := by
      rw [Scheme.Opens.range_ι, hU]
      rintro _ ⟨s, rfl⟩ ⟨s', hs'⟩
      have e1 : (z0 ≫ p) s' = (τP ≫ p) s := by
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hs']
      rw [hz0p, hτp] at e1
      have h1 : s' = s := by simpa using e1
      subst h1
      have e2 : (z0 ≫ q) s' = (τP ≫ q) s' := by
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hs']
      rw [hz0q, hτq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e2
      have e3 : (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff :
            MvPolynomial (Fin c) K →+* K)) (fS s')).asIdeal =
          (Spec.map (CommRingCat.ofHom e) (fS s')).asIdeal := by rw [e2]
      have hm : (MvPolynomial.X i₀ : MvPolynomial (Fin c) K) ∈
          (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff :
            MvPolynomial (Fin c) K →+* K)) (fS s')).asIdeal := by
        show MvPolynomial.constantCoeff (MvPolynomial.X i₀ : MvPolynomial (Fin c) K) ∈ (fS s').asIdeal
        rw [MvPolynomial.constantCoeff_X]
        exact Ideal.zero_mem _
      rw [e3] at hm
      have hm' : e (MvPolynomial.X i₀) ∈ (fS s').asIdeal := hm
      have h1 : e (MvPolynomial.X i₀) = 1 := by simp [e]
      rw [h1] at hm'
      exact (fS s').isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hm')
    refine ⟨IsOpenImmersion.lift U.ι τP hrange, ?_⟩
    rw [← Category.assoc, IsOpenImmersion.lift_fac, hτp]

  have hinj : Function.Injective (wcEtPull D k) := by
    obtain ⟨Dτ⟩ := wc_et_zmod_pull_data_exists τ ℓ
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 S) ℓ
    intro x y hxy
    have h0 : wcEtPull D k (x - y) = 0 := by rw [map_sub, hxy, sub_self]
    have h1 := wc_et_pull_comp (U.ι ≫ p) τ (𝟙 S) hτ D Dτ Did k (x - y)
    rw [h0, map_zero] at h1
    exact sub_eq_zero.mp (wc_et_pull_id_injective Did k (x - y) h1)
  refine ⟨hinj, fun hk => ?_⟩

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (U.ι ≫ p)) _ _ D.cont
      D.φ).Additive := Adjunction.right_adjoint_additive D.adj
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing S ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology S) (wcEtZModRing S ℓ)
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology (U : Scheme.{u}))
      (wcEtZModRing (U : Scheme.{u}) ℓ)
  let I := injectiveResolution (SheafOfModules.unit (wcEtZModRing (U : Scheme.{u}) ℓ))
  have hsurj := wc_ext_truncated_leray_surj D.Φ
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (U.ι ≫ p)) _ _ D.cont D.φ)
    D.adj (SheafOfModules.unit (wcEtZModRing S ℓ))
    (SheafOfModules.unit (wcEtZModRing (U : Scheme.{u}) ℓ)) D.μ I (2 * c - 2)
    (wc_et_punct_push_unit_iso K S fS m c P p q z0 hP hz0p hz0q hc U hU ℓ D)
    (fun n hn1 hnN => wc_et_push_homology_zero_of_local (U.ι ≫ p) ℓ D I n hn1
      (wc_et_punct_local_vanishing K S fS m c P p q z0 hP hz0p hz0q hc U hU ℓ hℓ n hn1
        (by omega)))
    k (by omega)
  intro w
  obtain ⟨b, hb⟩ := hsurj ((Abelian.Ext.mk₀ D.μ.hom).comp w (zero_add k))
  refine ⟨b, ?_⟩
  beta_reduce at hb
  show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ b).comp
    (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) = w
  rw [hb, ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
    Abelian.Ext.mk₀_id_comp]

theorem wc_et_supp_semipurity : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D : wcEtPullData i ℓ) (q : ℕ), q < 2 * c → ∀ θ : wcEtSuppExt D q, θ = 0 :=
by
  classical
  intro K _ _ X Z fX n c _ i _ _ hcn ℓ _ hℓ D q hq θ
  have hc1 : 1 ≤ c := by omega
  refine wc_et_supp_vanish_of_basis i ℓ q D ?_ θ
  intro V x hxV
  by_cases hx : x ∈ Set.range i
  ·
    obtain ⟨z, rfl⟩ := hx
    obtain ⟨W, hWV, hzW, htube⟩ := wc_smooth_pair_etale_tube K X Z fX n c i hc1 hcn V z hxV
    refine ⟨W, hWV, hzW, ?_⟩
    intro ZW iW gW hsq DW s' hs' t
    haveI : IsClosedImmersion iW :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    haveI : IsOpenImmersion gW :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq.flip inferInstance
    haveI hS : SmoothOfRelativeDimension (n - c) (iW ≫ W.ι ≫ fX) := by
      have h0 : SmoothOfRelativeDimension (0 + (n - c)) (gW ≫ i ≫ fX) := inferInstance
      rw [zero_add] at h0
      have e : iW ≫ W.ι ≫ fX = gW ≫ i ≫ fX := by
        rw [← Category.assoc, ← hsq.w, Category.assoc]
      rw [e]
      exact h0

    have hoa : Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) = 𝟙 _ := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap]
      simp
    have hP := IsPullback.of_hasPullback (iW ≫ W.ι ≫ fX)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))
    let z0 : ZW ⟶ Limits.pullback (iW ≫ W.ι ≫ fX)
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) :=
      Limits.pullback.lift (𝟙 ZW) ((iW ≫ W.ι ≫ fX) ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)))
        (by rw [Category.id_comp, Category.assoc, hoa, Category.comp_id])
    have hz0p : z0 ≫ Limits.pullback.fst _ _ = 𝟙 ZW := Limits.pullback.lift_fst _ _ _
    have hz0q : z0 ≫ Limits.pullback.snd _ _ = (iW ≫ W.ι ≫ fX) ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) :=
      Limits.pullback.lift_snd _ _ _
    obtain ⟨hz0, V', π, σ, e, hπ, hσ, sq1, sq2⟩ := htube ZW iW gW hsq _ _ _ z0 hP hz0p hz0q
    haveI := hz0
    haveI := hπ
    haveI := hσ
    let U : (Limits.pullback (iW ≫ W.ι ≫ fX)
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))).Opens :=
      ⟨(Set.range z0)ᶜ, z0.isClosedEmbedding.isClosed_range.isOpen_compl⟩
    obtain ⟨Dp⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst (iW ≫ W.ι ≫ fX)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))) ℓ
    obtain ⟨DU⟩ := wc_et_zmod_pull_data_exists U.ι ℓ
    obtain ⟨DUp⟩ := wc_et_zmod_pull_data_exists (U.ι ≫ Limits.pullback.fst (iW ≫ W.ι ≫ fX)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))) ℓ
    obtain ⟨D0⟩ := wc_et_zmod_pull_data_exists z0 ℓ
    obtain ⟨De⟩ := wc_et_zmod_pull_data_exists e ℓ
    have h5 := wc_et_pull_affine_bundle_bijective K ZW (iW ≫ W.ι ≫ fX) (n - c) c _ _ _ hP ℓ hℓ Dp
    have h6 := wc_et_pull_punctured_bundle K ZW (iW ≫ W.ι ≫ fX) (n - c) c _ _ _ z0 hP hz0p hz0q
      hc1 U rfl ℓ hℓ DUp
    have hcomp := wc_et_pull_comp _ U.ι _ rfl Dp DU DUp
    have hinj : Function.Injective (wcEtPull DU s') := by
      intro y1 y2 hy
      obtain ⟨x1, rfl⟩ := (h5 s').2 y1
      obtain ⟨x2, rfl⟩ := (h5 s').2 y2
      have h12 : wcEtPull DUp s' x1 = wcEtPull DUp s' x2 := by
        rw [hcomp s' x1, hcomp s' x2, hy]
      rw [(h6 s').1 h12]
    have hsurj : ∀ r : ℕ, r + 1 = s' → Function.Surjective (wcEtPull DU r) := by
      intro r hr w
      obtain ⟨x, hx⟩ := (h6 r).2 (by omega) w
      exact ⟨wcEtPull Dp r x, by rw [← hcomp r x, hx]⟩
    have hmodel := wc_et_supp_vanish_of_restr z0 U.ι
      (by rw [Scheme.Opens.range_ι]; rfl) ℓ (Fact.out : Nat.Prime ℓ).pos D0 DU s' hsurj hinj
    obtain ⟨e1⟩ := wc_et_supp_etale_excision iW π e sq1 ℓ DW De s'
    obtain ⟨e2⟩ := wc_et_supp_etale_excision z0 σ e sq2 ℓ D0 De s'
    haveI : Subsingleton (wcEtSuppExt D0 s') := ⟨fun a b => (hmodel a).trans (hmodel b).symm⟩
    haveI : Subsingleton (wcEtSuppExt DW s') := (e1.trans e2.symm).subsingleton
    exact Subsingleton.elim _ _
  ·
    have hopen : IsOpen (Set.range i)ᶜ := i.isClosedEmbedding.isClosed_range.isOpen_compl
    let O : X.Opens := ⟨(Set.range i)ᶜ, hopen⟩
    refine ⟨V ⊓ O, inf_le_left, TopologicalSpace.Opens.mem_inf.mpr ⟨hxV, hx⟩, ?_⟩
    intro ZW iW gW hsq DW s' _ t
    have hE : IsEmpty ZW := by
      apply Scheme.isEmpty_of_commSq hsq.toCommSq
      rw [Scheme.Opens.range_ι]
      refine Set.subset_compl_iff_disjoint_left.mp ?_
      intro y hy
      exact (TopologicalSpace.Opens.mem_inf.mp hy).2
    haveI := wc_et_supp_ext_empty iW ℓ DW hE s'
    exact Subsingleton.elim _ _

theorem wc_et_cutout_base_change : ∀ {W Z V ZV : Scheme.{u}} (iW : Z ⟶ W) {c : ℕ} (h : Fin c → Γ(W, ⊤)) (φ : V ⟶ W) (iV : ZV ⟶ V) (g : ZV ⟶ Z), wcEtCutOut iW h → IsAffine V → IsPullback g iV iW φ → wcEtCutOut iV (fun k => φ.appTop.hom (h k)) :=
by
  intro W Z V ZV iW c h φ iV g hcut hV hsq
  obtain ⟨hW, hci, hI⟩ := hcut
  haveI := hW
  haveI := hci
  haveI := hV
  haveI hciV : IsClosedImmersion iV :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
  have F0 : ∀ {X Y Z' : Scheme.{u}} (f : X ⟶ Y) (f' : Y ⟶ Z') (x : Γ(Z', ⊤)),
      (f ≫ f').appTop.hom x = f.appTop.hom (f'.appTop.hom x) := fun _ _ _ => rfl
  have hk : ∀ k, iW.appTop.hom (h k) = 0 := by
    intro k
    rw [← RingHom.mem_ker, hI]
    exact Ideal.subset_span ⟨k, rfl⟩
  refine ⟨hV, hciV, le_antisymm ?_ ?_⟩
  ·
    set J : Ideal Γ(V, ⊤) := Ideal.span (Set.range (fun k => φ.appTop.hom (h k))) with hJ
    let 𝓘 : V.IdealSheafData := Scheme.IdealSheafData.ofIdealTop J
    let ι : 𝓘.subscheme ⟶ V := 𝓘.subschemeι
    have hι : RingHom.ker ι.appTop.hom = J := by
      have h1 := Scheme.IdealSheafData.ker_subschemeι_app 𝓘 ⟨⊤, isAffineOpen_top V⟩
      have h2 := Scheme.IdealSheafData.ofIdealTop_ideal J ⟨⊤, isAffineOpen_top V⟩
      change RingHom.ker (ι.app ⊤).hom = J
      rw [h1]
      change 𝓘.ideal ⟨⊤, isAffineOpen_top V⟩ = J
      rw [h2]
      have : (homOfLE (le_top : (⊤ : V.Opens) ≤ ⊤)) = 𝟙 _ := Subsingleton.elim _ _
      simp
    have hle : RingHom.ker iW.appTop.hom ≤ RingHom.ker (ι ≫ φ).appTop.hom := by
      rw [hI, Ideal.span_le, Set.range_subset_iff]
      intro k
      show (ι ≫ φ).appTop.hom (h k) = 0
      rw [F0, ← RingHom.mem_ker, hι]
      exact Ideal.subset_span ⟨k, rfl⟩
    have hle' : Scheme.Hom.ker iW ≤ Scheme.Hom.ker (ι ≫ φ) := by
      apply Scheme.IdealSheafData.le_of_isAffine
      rw [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply]
      exact hle
    let l := IsClosedImmersion.lift iW (ι ≫ φ) hle'
    have hl : l ≫ iW = ι ≫ φ := IsClosedImmersion.lift_fac iW (ι ≫ φ) hle'
    have hm : hsq.lift l ι hl ≫ iV = ι := hsq.lift_snd l ι hl
    intro x hx
    rw [RingHom.mem_ker] at hx
    rw [← hι, RingHom.mem_ker, ← hm, F0, hx, map_zero]
  ·
    rw [Ideal.span_le, Set.range_subset_iff]
    intro k
    show iV.appTop.hom (φ.appTop.hom (h k)) = 0
    rw [← F0, ← hsq.w, F0, hk, map_zero]

theorem wc_et_thom_open_restrict : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (T : wcEtLocThom K ℓ), wcEtThomNat T → ∀ {X Z X' Z' : Scheme.{u}} (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ (f : X' ⟶ X) [IsOpenImmersion f] (i' : Z' ⟶ X') (g : Z' ⟶ Z), IsPullback g i' i f → ∀ (D : wcEtPullData i ℓ) (Df : wcEtPullData f ℓ) (D' : wcEtPullData i' ℓ) (γ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D) → ∀ θ : wcEtSuppExt D (2 * c), wcEtIsThom T fX D c θ → wcEtIsThom T (f ≫ fX) D' c (wcEtSuppRestr D Df D' γ (2 * c) θ) :=
by
  classical
  intro K _ _ ℓ _ hℓ T hNat X Z X' Z' fX n c _ i _ _ hcn f _ i' g hsq2 D Df D' γ hγ θ hθ
  unfold wcEtIsThom at hθ ⊢
  unfold wcEtThomNat at hNat
  intro W'' ZW iW gW hsq1 DW EW γ'' adm'' h cut

  haveI : IsClosedImmersion iW := cut.2.1
  haveI hWaff : IsAffine (W'' : Scheme.{u}) := cut.1
  obtain ⟨W₁, e, he⟩ : ∃ (W₁ : X.Opens) (e : (W'' : Scheme.{u}) ≅ (W₁ : Scheme.{u})),
      e.hom ≫ W₁.ι = W''.ι ≫ f :=
    ⟨f ''ᵁ W'', f.isoImage W'', Scheme.Hom.isoImage_hom_ι f W''⟩
  haveI : IsAffine (W₁ : Scheme.{u}) := IsAffine.of_isIso e.inv
  haveI : IsOpenImmersion gW :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq1.flip inferInstance
  haveI : IsOpenImmersion g :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq2.flip inferInstance

  have SF : IsPullback (gW ≫ g) iW i (W''.ι ≫ f) := hsq1.paste_horiz hsq2
  have S1 : IsPullback (gW ≫ g) (iW ≫ e.hom) i W₁.ι :=
    SF.of_iso (Iso.refl _) (Iso.refl _) e (Iso.refl _)
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
      (by rw [Iso.refl_hom, Category.id_comp])
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
      (by rw [Iso.refl_hom, Category.comp_id, he])
  have Se : IsPullback (𝟙 ZW) iW (iW ≫ e.hom) e.hom :=
    IsPullback.of_horiz_isIso ⟨Category.id_comp _⟩
  have Sinv : IsPullback (𝟙 ZW) (iW ≫ e.hom) iW e.inv :=
    IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]⟩

  have hmor : iW ≫ W''.ι ≫ f ≫ fX = (gW ≫ g) ≫ i ≫ fX := by
    calc iW ≫ W''.ι ≫ f ≫ fX = (iW ≫ W''.ι ≫ f) ≫ fX := by simp only [Category.assoc]
      _ = ((gW ≫ g) ≫ i) ≫ fX := by rw [SF.w]
      _ = (gW ≫ g) ≫ i ≫ fX := Category.assoc _ _ _
  have hmor₁ : (iW ≫ e.hom) ≫ W₁.ι ≫ fX = (gW ≫ g) ≫ i ≫ fX := by
    rw [Category.assoc, ← Category.assoc e.hom, he]
    simpa only [Category.assoc] using hmor
  have hcomm : e.hom ≫ W₁.ι ≫ fX = W''.ι ≫ f ≫ fX := by
    rw [← Category.assoc, he, Category.assoc]

  have sm0 : ∀ {A B : Scheme.{u}} (j : A ⟶ B) [IsOpenImmersion j] (m : ℕ)
      (q : B ⟶ Spec (.of K)) [SmoothOfRelativeDimension m q],
      SmoothOfRelativeDimension m (j ≫ q) := by
    intro A B j _ m q _
    have h0 : SmoothOfRelativeDimension (0 + m) (j ≫ q) := inferInstance
    rwa [zero_add] at h0

  have cut₁ : wcEtCutOut (iW ≫ e.hom) (fun k => e.inv.appTop.hom (h k)) :=
    wc_et_cutout_base_change iW h e.inv (iW ≫ e.hom) (𝟙 ZW) cut inferInstance Sinv
  have hid : e.inv.appTop ≫ e.hom.appTop = 𝟙 _ := by
    rw [← Scheme.Hom.comp_appTop, Iso.hom_inv_id, Scheme.Hom.id_appTop]
  have hh : (fun j => e.hom.appTop.hom (e.inv.appTop.hom (h j))) = h := by
    funext j
    exact congrArg (fun φ => φ.hom (h j)) hid

  obtain ⟨D₁⟩ := wc_et_zmod_pull_data_exists (iW ≫ e.hom) ℓ
  obtain ⟨E₁⟩ := wc_et_zmod_pull_data_exists W₁.ι ℓ
  obtain ⟨Ee⟩ := wc_et_zmod_pull_data_exists e.hom ℓ
  obtain ⟨EF⟩ := wc_et_zmod_pull_data_exists (W''.ι ≫ f) ℓ
  obtain ⟨γF, admF, epiW⟩ :=
    wc_et_closed_supp_base_change i (W''.ι ≫ f) iW (gW ≫ g) SF D EF DW
  obtain ⟨γ₁, adm₁, -⟩ :=
    wc_et_closed_supp_base_change i W₁.ι (iW ≫ e.hom) (gW ≫ g) S1 D E₁ D₁
  obtain ⟨γe, adme, -⟩ :=
    wc_et_closed_supp_base_change (iW ≫ e.hom) e.hom iW (𝟙 ZW) Se D₁ Ee DW

  have R1 := wc_et_supp_restr_comp f W''.ι (W''.ι ≫ f) rfl D D' DW Df EW EF γ γ'' γF
    hγ adm'' admF epiW (2 * c) θ
  have R2 := wc_et_supp_restr_comp W₁.ι e.hom (W''.ι ≫ f) he D D₁ DW E₁ Ee EF γ₁ γe γF
    adm₁ adme admF epiW (2 * c) θ

  have R3 := hθ W₁ ZW (iW ≫ e.hom) (gW ≫ g) S1 D₁ E₁ γ₁ adm₁ _ cut₁

  have chart1 : wcEtGoodChart K (W₁.ι ≫ fX) (iW ≫ e.hom) c
      (fun k => e.inv.appTop.hom (h k)) := by
    refine ⟨n, hcn, sm0 W₁.ι n fX, ?_, cut₁⟩
    rw [hmor₁]
    exact sm0 (gW ≫ g) (n - c) (i ≫ fX)
  have chart2 : wcEtGoodChart K (W''.ι ≫ (f ≫ fX)) iW c
      (fun j => e.hom.appTop.hom (e.inv.appTop.hom (h j))) := by
    haveI : SmoothOfRelativeDimension n (f ≫ fX) := sm0 f n fX
    refine ⟨n, hcn, sm0 W''.ι n (f ≫ fX), ?_, ?_⟩
    · rw [hmor]
      exact sm0 (gW ≫ g) (n - c) (i ≫ fX)
    · rw [hh]
      exact cut
  have R4 := hNat (W₁.ι ≫ fX) (W''.ι ≫ (f ≫ fX)) e.hom hcomm (iW ≫ e.hom) iW (𝟙 ZW) Se
    D₁ Ee DW γe adme c (fun k => e.inv.appTop.hom (h k)) chart1 chart2
  exact R1.symm.trans (R2.trans ((congrArg (wcEtSuppRestr D₁ Ee DW γe (2 * c)) R3).trans
    (R4.trans (congrArg (T (W''.ι ≫ (f ≫ fX)) iW DW c) hh))))

theorem wc_et_open_supp_kernel_reverse : ∀ {X Z ZU : Scheme.{u}} {ℓ : ℕ} (U : X.Opens) (i : Z ⟶ X) [IsClosedImmersion i] (iU : ZU ⟶ (U : Scheme.{u})) (gU : ZU ⟶ Z), IsPullback gU iU i U.ι → ∀ (D : wcEtPullData i ℓ) (DU : wcEtPullData iU ℓ) (E : wcEtPullData U.ι ℓ), Limits.kernel.ι (E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D)) ≫ wcEtSuppUnitMap DU = 0 :=
by

  have wc_et_zmod_ring_locbij : ∀ (Y : Scheme.{u}) (n : ℕ),
      ∃ α : (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing Y n).obj,
        Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) α ∧
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α ∧
        ∀ V, ((n : ℕ) : ↑((wcEtZModRing Y n).obj.obj V)) = 0 := by
    intro Y n
    let P : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
    let α : P ⟶ (wcEtZModRing Y n).obj := toSheafify (Scheme.smallEtaleTopology Y) P
    refine ⟨α, Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Y) P,
      Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Y) P, ?_⟩
    intro V
    have h0 : ((n : ℕ) : ULift.{u+1} (ZMod n)) = 0 :=
      ULift.ext _ _ (by rw [ULift.down_natCast, ZMod.natCast_self, ULift.zero_down])
    have h1 := map_natCast (α.app V).hom n
    have h2 : (α.app V).hom ((n : ℕ) : ULift.{u+1} (ZMod n)) = 0 := by
      rw [h0]; exact map_zero _
    exact h1.symm.trans h2

  have covsurj : ∀ (S : Scheme.{u}) (V : S.Etale) (R : Sieve V),
      R ∈ Scheme.smallEtaleTopology S V → ∀ x : V.left,
      ∃ (Y : S.Etale) (f : Y ⟶ V) (y : Y.left), R.arrows f ∧ f.left y = x := by
    intro S V R h x
    haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
    have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V R).mp (e ▸ h)
    obtain ⟨Y, f, y, h1, _, h3⟩ := h' x
    exact ⟨Y, f, y, h1, h3⟩
  have botcov : ∀ (S : Scheme.{u}) (V : S.Etale), IsEmpty V.left →
      (⊥ : Sieve V) ∈ Scheme.smallEtaleTopology S V := by
    intro S V hV
    haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
    have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V
      (⊥ : Sieve V)).mpr (fun x => (IsEmpty.false x).elim)
    rw [show Scheme.smallEtaleTopology S = _ from e]
    exact h'

  have sep : ∀ (S : Scheme.{u}) (n : ℕ) (M : SheafOfModules.{u+1} (wcEtZModRing S n))
      (W : S.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology S W →
      ∀ x : ↑(M.val.obj (Opposite.op W)),
      (∀ (Q : S.Etale) (g : Q ⟶ W), R.arrows g → (M.val.map g.op).hom x = 0) → x = 0 := by
    intro S n M W R hR x h
    have hs := ((SheafOfModules.toSheaf _).obj M).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology S) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x 0
      (fun Q g hg => (h Q g hg).trans (map_zero ((M.val.map g.op).hom)).symm)
  have zeroEmpty : ∀ (S : Scheme.{u}) (n : ℕ) (M : SheafOfModules.{u+1} (wcEtZModRing S n))
      (V : S.Etale), IsEmpty V.left → ∀ x : ↑(M.val.obj (Opposite.op V)), x = 0 := by
    intro S n M V hV x
    exact sep S n M V ⊥ (botcov S V hV) x (fun Q g hg => hg.elim)

  have twist : ∀ {S T : Scheme.{u}} {j : T ⟶ S} {n : ℕ} (E : wcEtPullData j n),
      ∃ e : SheafOfModules.unit (wcEtZModRing T n) ⟶ SheafOfModules.unit (wcEtZModRing T n),
        wcEtSuppUnitMap E ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ).map e
          = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ := by
    intro S T j n E
    refine ⟨E.μ.inv ≫ (E.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ), ?_⟩
    dsimp only [wcEtSuppUnitMap, wcEtSuppObj]
    rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc,
      ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]

  have intcast_eq : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
      (α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj)
      (c : ULift.{u+1} (ZMod n)),
      (α.app (Opposite.op V)).hom c = (((c.down.cast : ℤ)) : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) := by
    intro S n V α c
    have hc : c = (((c.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
      apply ULift.ext
      rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
    conv_lhs => rw [hc]
    exact map_intCast (α.app (Opposite.op V)).hom _

  have intzero : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale) (k : ℤ),
      (k : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) = 0 → (k : ZMod n) = 0 ∨ IsEmpty V.left := by
    intro S n V k hk
    by_cases hV : IsEmpty V.left
    · exact Or.inr hV
    · left
      obtain ⟨x⟩ := not_isEmpty_iff.mp hV
      obtain ⟨α, hinj, hsurj, -⟩ := wc_et_zmod_ring_locbij S n
      have h1 : (α.app (Opposite.op V)).hom ((k : ULift.{u+1} (ZMod n))) =
          (α.app (Opposite.op V)).hom (0 : ULift.{u+1} (ZMod n)) := by
        rw [map_intCast, map_zero]; exact hk
      have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology S) α _ _ h1
      obtain ⟨Q, g, _, hg, _⟩ := covsurj S V _ hmem x
      have h2 : ((k : ULift.{u+1} (ZMod n))) = 0 := hg
      have h3 := congrArg ULift.down h2
      rw [ULift.down_intCast] at h3
      exact h3

  have wc_et_supp_unit_epi : ∀ {X' Y' : Scheme.{u}} {n : ℕ} (i' : X' ⟶ Y') [IsClosedImmersion i']
      (D' : wcEtPullData i' n), Epi (wcEtSuppUnitMap D') := by
    intro X' Y' n i' _ D'
    classical

    have hcov : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), (∀ v : V.left, ∃ (W : S.Etale)
        (f : W ⟶ V) (w : W.left), T.arrows f ∧ Etale f.left ∧ f.left w = v) →
        T ∈ Scheme.smallEtaleTopology S V := by
      intro S V T h
      change T ∈ Scheme.smallGrothendieckTopology @Etale S V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mpr h
    have hcov' : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), T ∈ Scheme.smallEtaleTopology S V →
        ∀ v : V.left, ∃ (W : S.Etale) (f : W ⟶ V) (w : W.left),
          T.arrows f ∧ Etale f.left ∧ f.left w = v := by
      intro S V T hT
      change T ∈ Scheme.smallGrothendieckTopology @Etale S V at hT
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hT
      exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mp hT

    have hsep : Presheaf.IsSeparated (Scheme.smallEtaleTopology X') (wcEtZModRing X' n).obj :=
      Sheaf.isSeparated (wcEtZModRing X' n)
    have hempty : ∀ (Q : X'.Etale), IsEmpty Q.left →
        ∀ a b : ↑((wcEtZModRing X' n).obj.obj (Opposite.op Q)), a = b := by
      intro Q hQ a b
      exact hsep Q ⊥ (hcov X' Q ⊥ (fun v => isEmptyElim v)) a b (fun _ _ h => False.elim h)

    obtain ⟨α, hαs⟩ : ∃ α : (Functor.const (X'.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtZModRing X' n).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X') α :=
      ⟨toSheafify _ _, Presheaf.isLocallySurjective_toSheafify' _ _⟩
    have hnat : ∀ {A B : X'.Etale} (r : A ⟶ B) (b : ULift.{u+1} (ZMod n)),
        ((wcEtZModRing X' n).obj.map r.op).hom (α.app (Opposite.op B) b) =
          α.app (Opposite.op A) b := by
      intro A B r b
      have h := congrArg (fun φ => φ.hom b) (α.naturality r.op)
      exact h.symm
    have hcomp : ∀ {A B C : X'.Etale} (f : A ⟶ B) (h : B ⟶ C)
        (z : ↑((wcEtZModRing X' n).obj.obj (Opposite.op C))),
