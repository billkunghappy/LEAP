    have hhom : (U.ι ≫ f).appTop.hom =
        (Y.presheaf.map (homOfLE hle).op).hom.comp (f.appLE ⊤ U e).hom := by
      exact congrArg (fun φ => CommRingCat.Hom.hom φ) hfac
    rw [hhom]
    exact (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_right_isIso
      (f.appLE ⊤ U e) (Y.presheaf.map (homOfLE hle).op)).mpr hstd

  have s4 : ∀ (R A B : Type u) [CommRing R] [CommRing A] [CommRing B] (φ : R →+* A) (π : A →+* B) (I : Ideal A) (m : ℕ), Function.Surjective π → RingHom.ker π = I → RingHom.IsStandardSmoothOfRelativeDimension m (π.comp φ) → RingHom.IsStandardSmoothOfRelativeDimension m ((Ideal.Quotient.mk I).comp φ) := by
