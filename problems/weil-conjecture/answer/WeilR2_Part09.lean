      intro V v hv
      have hc : IsClosed (Set.range (Limits.pullback.fst V.hom i)) :=
        (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst V.hom i)).isClosed_range
      let O : V.left.Opens := ⟨(Set.range (Limits.pullback.fst V.hom i))ᶜ, hc.isOpen_compl⟩
      have : Etale V.hom := V.prop
      refine ⟨Scheme.Etale.mk (O.ι ≫ V.hom), MorphismProperty.Over.homMk O.ι, ?_, ?_⟩
      · change v ∈ Set.range O.ι
        rw [Scheme.Opens.range_ι]
