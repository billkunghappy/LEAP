  have s3 : ∀ {Y S : Scheme.{u}} (f : Y ⟶ S) (U : Y.Opens) (e : U ≤ f ⁻¹ᵁ ⊤) (m : ℕ), RingHom.IsStandardSmoothOfRelativeDimension m (f.appLE ⊤ U e).hom → RingHom.IsStandardSmoothOfRelativeDimension m (U.ι ≫ f).appTop.hom := by
    intro Y S f U e m hstd
    have hle : U.ι ''ᵁ ⊤ ≤ U := (Scheme.Opens.ι_image_top U).le
    have e₂ : ⊤ ≤ U.ι ⁻¹ᵁ U := by
      intro x _
      rw [Scheme.Hom.mem_preimage]
      have : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι] at this
      exact this
    have hfac : (U.ι ≫ f).appTop = f.appLE ⊤ U e ≫ Y.presheaf.map (homOfLE hle).op := by
