          rintro f _ rfl e₁ e₂; rfl
        have h1 := Scheme.Hom.appLE_comp_appLE (i ∣_ X.basicOpen g) (X.basicOpen g).ι W₀ ⊤ ⊤ e
          (le_of_eq (Scheme.Hom.preimage_top _).symm)
        have h2 : (i ∣_ X.basicOpen g).appLE ⊤ ⊤ (le_of_eq (Scheme.Hom.preimage_top _).symm) =
