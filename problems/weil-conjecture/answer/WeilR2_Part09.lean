        exact ((TensorProduct.tmul_smul z _ _).symm.trans
          (congrArg (fun y : wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left)) =>
            TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
