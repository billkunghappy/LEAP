        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g = 0 := by
      rw [← Functor.map_comp, w, Functor.map_zero]
    have hS₀ : (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).Exact :=
      (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).exact_of_f_is_kernel
        (Limits.kernelIsKernel g)
    have hS₀L := hS₀.map (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    let φ : ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f)
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g) w' ⟶
        (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).map
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
      { τ₁ := (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
            (Limits.kernel.lift g f w)
        τ₂ := 𝟙 _
        τ₃ := 𝟙 _
        comm₁₂ := by
          show (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
              (Limits.kernel.lift g f w) ≫
              (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
                (Limits.kernel.ι g) =
            (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f ≫ 𝟙 _
          rw [← Functor.map_comp, Limits.kernel.lift_ι, Category.comp_id]
        comm₂₃ := by
          show 𝟙 _ ≫ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g =
            (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g ≫ 𝟙 _
          rw [Category.id_comp, Category.comp_id] }
    haveI : Sheaf.IsLocallySurjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Limits.kernel.lift g f w)) :=
      (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
    haveI : Epi φ.τ₁ := Sheaf.epi_of_isLocallySurjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Limits.kernel.lift g f w))
    haveI : IsIso φ.τ₂ := by dsimp [φ]; infer_instance
    haveI : Mono φ.τ₃ := by dsimp [φ]; infer_instance
    have hE := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mpr hS₀L
    haveI : Sheaf.IsLocallyInjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f) :=
      (Presheaf.isLocallyInjective_presheafToSheaf_map_iff _ _).mpr hinj
    haveI : Sheaf.IsLocallySurjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g) :=
      (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hsurj
    exact ⟨w', ShortComplex.ShortExact.mk' hE
      (Sheaf.mono_of_isLocallyInjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f))
      (Sheaf.epi_of_isLocallySurjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g))⟩



  have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
      (m • 𝟙 (wcLpttEtPre Y wcKtGm.{u})) := by
    have s2 : ∀ (R : Type u) [CommRing R], IsUnit (m : R) → ∀ a : R, IsUnit a →
        ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
          Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
          ∃ t : B, t ^ m = algebraMap R B a := by
      intro R _ hℓR a ha
      set fp : Polynomial R := Polynomial.X ^ m - Polynomial.C a with hf
      have hfm : fp.Monic := Polynomial.monic_X_pow_sub_C a hm0
      obtain ⟨u, hu⟩ := (hℓR.mul ha).exists_left_inv
      have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
          Polynomial.derivative fp * p₁ + fp * p₂ = (1 : Polynomial R) ^ n := by
        refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (m : R)), 1, ?_⟩
        have hd : Polynomial.derivative fp = Polynomial.C (m : R) * Polynomial.X ^ (m - 1) := by
          rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
            sub_zero]
        have hX : Polynomial.X ^ (m - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ m :=
          pow_sub_one_mul hm0 Polynomial.X
        have hu' : Polynomial.C u * (Polynomial.C (m : R) * Polynomial.C a) = 1 := by
          rw [← map_mul, ← map_mul, hu, map_one]
        rw [hd, hf, pow_one]
        linear_combination hu' + (Polynomial.C u * Polynomial.C (m : R)) * hX
      let P : StandardEtalePair R := ⟨fp, hfm, 1, hcert⟩
      have e₂ : AdjoinRoot fp ≃ₐ[R] Localization.Away ((AdjoinRoot.mk fp) 1) :=
        (IsLocalization.atUnit (AdjoinRoot fp) (Localization.Away ((AdjoinRoot.mk fp) 1))
          ((AdjoinRoot.mk fp) 1) (by simp)).restrictScalars R
      have e : P.Ring ≃ₐ[R] AdjoinRoot fp := P.equivAwayAdjoinRoot.trans e₂.symm
      have het : Algebra.Etale R (AdjoinRoot fp) := Algebra.Etale.of_equiv e
      refine ⟨AdjoinRoot fp, inferInstance, inferInstance, het, ?_, AdjoinRoot.root fp, ?_⟩
      · rcases subsingleton_or_nontrivial R with hR | hR
        · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
          intro x
          exact isEmptyElim x
        · have : Module.Free R (AdjoinRoot fp) := hfm.free_adjoinRoot
          let pb := AdjoinRoot.powerBasis' hfm
          have hdim : 0 < pb.dim := by
            rw [AdjoinRoot.powerBasis'_dim, hf, Polynomial.natDegree_X_pow_sub_C]
            exact Nat.pos_of_ne_zero hm0
          have : Nontrivial (AdjoinRoot fp) := nontrivial_of_ne _ _ (pb.basis.ne_zero ⟨0, hdim⟩)
          exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
      · have h1 : Polynomial.aeval (AdjoinRoot.root fp) fp = 0 := by
          rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
        rw [hf, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h1
        exact sub_eq_zero.mp h1
    have s3 : ∀ (Z : Scheme.{u}) (B : Type u) [CommRing B] [Algebra Γ(Z, ⊤) B],
        Algebra.Etale Γ(Z, ⊤) B → Function.Surjective (PrimeSpectrum.comap (algebraMap Γ(Z, ⊤) B)) →
        ∃ (V : Scheme.{u}) (p : V ⟶ Z) (ψ : B →+* Γ(V, ⊤)), Etale p ∧ Function.Surjective p ∧
          ∀ r : Γ(Z, ⊤), ψ (algebraMap Γ(Z, ⊤) B r) = p.appTop.hom r := by
      intro Z B _ _ hB hsurjB
      let φ : CommRingCat.of Γ(Z, ⊤) ⟶ CommRingCat.of B := CommRingCat.ofHom (algebraMap Γ(Z, ⊤) B)
      let g : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of Γ(Z, ⊤)) := Spec.map φ
      have hg : Etale g := by
        apply (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
        rw [CommRingCat.hom_ofHom]
        exact RingHom.etale_algebraMap.mpr hB
      have hgs : Surjective g := by
        constructor
        exact hsurjB
      let p := Limits.pullback.fst Z.toSpecΓ g
      let q := Limits.pullback.snd Z.toSpecΓ g
      refine ⟨Limits.pullback Z.toSpecΓ g, p,
        ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop).hom,
        inferInstance, p.surjective, fun r => ?_⟩
      have hc : Z.toSpecΓ.appTop ≫ p.appTop = g.appTop ≫ q.appTop := by
        rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
      have hn := Scheme.ΓSpecIso_inv_naturality φ
      have key : φ ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop = p.appTop := by
        rw [← Category.assoc, hn, Category.assoc, ← hc, Scheme.toSpecΓ_appTop]
        exact Iso.inv_hom_id_assoc _ _
      exact congrArg (fun h => h.hom r) key
    have hcov : ∀ (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V),
        S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
    let aU : (Γ(U.left, ⊤))ˣ := Additive.toMul s.down
    let cU : K →+* Γ(U.left, ⊤) :=
      ((U.hom ≫ fY).appTop).hom.comp (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
    have hℓR : IsUnit (m : Γ(U.left, ⊤)) := by
      rw [← map_natCast cU]
      exact (Ne.isUnit hm).map cU
    obtain ⟨B, _, _, hBet, hBsurj, t, ht⟩ := s2 Γ(U.left, ⊤) hℓR (aU : Γ(U.left, ⊤)) aU.isUnit
    obtain ⟨V, p, ψ, hpet, hpsurj, hψ⟩ := s3 U.left B hBet hBsurj
    have hT : ψ t ^ m = p.appTop.hom (aU : Γ(U.left, ⊤)) := by rw [← map_pow, ht, hψ]
    have hTu : IsUnit (ψ t) := by
      have h1 : IsUnit (ψ t ^ m) := by rw [hT]; exact aU.isUnit.map _
      exact (isUnit_pow_iff hm0).mp h1
    haveI := hpet
    let V₁ : Y.Etale := MorphismProperty.Over.mk ⊤ (p ≫ U.hom) inferInstance
    let c : V₁ ⟶ U := MorphismProperty.Over.homMk p rfl trivial
    have hc : (Presheaf.imageSieve (m • 𝟙 (wcLpttEtPre Y wcKtGm.{u})) s).arrows c := by
      refine ⟨ULift.up (Additive.ofMul hTu.unit), ?_⟩
      simp only [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul,
        AddMonoidHom.nsmul_apply, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
      apply ULift.ext
      apply Additive.toMul.injective
      apply Units.ext
      change ((hTu.unit ^ m : (Γ(V, ⊤))ˣ) : Γ(V, ⊤)) = p.appTop.hom (aU : Γ(U.left, ⊤))
      rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hT]
    exact hcov U _ (fun v => ⟨V₁, c, hc, hpsurj v⟩)



  have hw : f ≫ (m • 𝟙 (wcLpttEtPre Y wcKtGm.{u})) = 0 := by
    rw [Preadditive.comp_nsmul, Category.comp_id]
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    simp only [NatTrans.app_nsmul, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
      AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.zero_apply]
    rw [hfapp]
    apply ULift.ext
    show m • Additive.ofMul
        ((Additive.toMul x.down : rootsOfUnity m (Scheme.Γ.obj (Opposite.op W.unop.left))) :
          (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ) = 0
    rw [← ofMul_pow, (mem_rootsOfUnity m _).mp (Additive.toMul x.down :
      rootsOfUnity m (Scheme.Γ.obj (Opposite.op W.unop.left))).2, ofMul_one]
  have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) f := by
    apply Presheaf.isLocallyInjective_of_injective
    intro W x y hxy
    rw [hfapp, hfapp] at hxy
    have h1 := congrArg (fun z => (Additive.toMul (ULift.down z) :
      (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ)) hxy
    apply ULift.ext
    apply Additive.toMul.injective
    exact Subtype.ext h1
  have hex : ∀ (U : Y.Etale) (x : (wcLpttEtPre Y wcKtGm.{u}).obj (Opposite.op U)),
      ((m • 𝟙 (wcLpttEtPre Y wcKtGm.{u})).app (Opposite.op U)).hom x = 0 →
      ∃ R ∈ Scheme.smallEtaleTopology Y U, ∀ (V : Y.Etale) (i : V ⟶ U), R.arrows i →
        ∃ y : (wcLpttEtPre Y (wcRootsFun.{u} m)).obj (Opposite.op V),
          (f.app (Opposite.op V)).hom y = ((wcLpttEtPre Y wcKtGm.{u}).map i.op).hom x := by
    intro U x hx
    simp only [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul,
      AddMonoidHom.nsmul_apply, AddCommGrpCat.hom_id, AddMonoidHom.id_apply] at hx
    have h1 := congrArg (fun z => Additive.toMul (ULift.down z)) hx
    have hu : (Additive.toMul x.down : (Scheme.Γ.obj (Opposite.op U.left))ˣ) ^ m = 1 := by
      first
        | exact (toMul_nsmul (α := (Scheme.Γ.obj (Opposite.op U.left))ˣ) m x.down).symm.trans h1
        | exact h1
    let ξ : rootsOfUnity m (Scheme.Γ.obj (Opposite.op U.left)) :=
      ⟨Additive.toMul x.down, (mem_rootsOfUnity m _).mpr hu⟩
    let y₀ : (wcLpttEtPre Y (wcRootsFun.{u} m)).obj (Opposite.op U) :=
      (ULift.up (Additive.ofMul ξ) : ULift.{u+1} (Additive (rootsOfUnity m
        (Scheme.Γ.obj (Opposite.op U.left)))))
    have hfy0 : (f.app (Opposite.op U)).hom y₀ = x := by
      rw [hfapp]
      rfl
    refine ⟨⊤, (Scheme.smallEtaleTopology Y).top_mem U, fun V i _ =>
      ⟨((wcLpttEtPre Y (wcRootsFun.{u} m)).map i.op).hom y₀, ?_⟩⟩
    have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ y₀) (f.naturality i.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at h
    rw [h, hfy0]



  have hmap : wcLpttEtShMap Y (wcKtIncl.{u} m) =
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f := by
    rw [hf]
    rfl
  have hgS : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
      (m • 𝟙 (wcLpttEtPre Y wcKtGm.{u})) = m • 𝟙 (wcLpttEtSh Y wcKtGm.{u}) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    try rfl
  rw [hmap, ← hgS]
  exact hsheafify f _ hw hinj hex hsurj

theorem wc_krc_untw_iso (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓK : IsUnit ((ℓ : ℕ) : K)) (n : ℕ) (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) (k : ℕ)
    (ζ : rootsOfUnity (ℓ ^ n) Γ(Y, ⊤)) (ζ₀ : K) (hζ₀ : IsPrimitiveRoot ζ₀ (ℓ ^ n))
    (hζ : ((ζ : Γ(Y, ⊤)ˣ) : Γ(Y, ⊤)) = fY.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom ζ₀)) :
    IsIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
      (wcKrUntw Y (ℓ ^ n) k ζ)) :=
by
  classical
  have hℓ : Nat.Prime ℓ := Fact.out
  have hm0 : ℓ ^ n ≠ 0 := pow_ne_zero n hℓ.ne_zero
  have hmK : IsUnit (((ℓ ^ n : ℕ)) : K) := by rw [Nat.cast_pow]; exact hℓK.pow n
  revert ζ hζ₀ hζ hm0 hmK
  generalize ℓ ^ n = m
  intro ζ hζ₀ hζ hm0 hmK
  haveI : NeZero m := ⟨hm0⟩

  let φ : ∀ V : Y.Etale, K →+* Γ(V.left, ⊤) := fun V =>
    (V.hom ≫ fY).appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
  have hprim : ∀ (V : Y.Etale) (z : V.left),
      IsPrimitiveRoot ((V.left.evaluation ⊤ z trivial).hom (φ V ζ₀)) m := by
    intro V z
    let χ : K →+* V.left.residueField z := (V.left.evaluation ⊤ z trivial).hom.comp (φ V)
    exact hζ₀.map_of_injective (f := χ) χ.injective
  have hunit : ∀ V : Y.Etale, IsUnit ((m : ℕ) : Γ(V.left, ⊤)) := by
    intro V
    have := hmK.map (φ V)
    rwa [map_natCast] at this
  have hφnat : ∀ (V V' : Y.Etale) (c : V' ⟶ V), φ V' ζ₀ = c.left.appTop.hom (φ V ζ₀) := by
    intro V V' c
    have hw : c.left ≫ V.hom = V'.hom := MorphismProperty.Over.w c
    have key : V'.hom ≫ fY = c.left ≫ (V.hom ≫ fY) := by
      rw [← Category.assoc, hw]
    show (V'.hom ≫ fY).appTop.hom _ = _
    rw [key, Scheme.Hom.comp_appTop]
    rfl

  let ωr : ∀ V : Y.Etale, rootsOfUnity m Γ(V.left, ⊤) := fun V =>
    restrictRootsOfUnity V.hom.appTop.hom m ζ
  have hωr : ∀ V : Y.Etale, ((ωr V : Γ(V.left, ⊤)ˣ) : Γ(V.left, ⊤)) = φ V ζ₀ := by
    intro V
    simp only [ωr, φ]
    rw [restrictRootsOfUnity_coe_apply, hζ]
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    try rfl
  have hnatr : ∀ (V V' : Y.Etale) (c : V' ⟶ V),
      restrictRootsOfUnity c.left.appTop.hom m (ωr V) = ωr V' := by
    intro V V' c
    apply Subtype.ext
    apply Units.ext
    rw [restrictRootsOfUnity_coe_apply, hωr, hωr, hφnat V V' c]

  have hUapp : ∀ (X : (Y.Etale)ᵒᵖ) (x : (wcLpttEtPre Y (wcRootsFun.{u} m)).obj X),
      ((wcKrUntwApp Y m k ζ X).hom x).down =
        ((1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
          (Fin.snoc (fun _ : Fin k => Additive.ofMul (ωr X.unop)) x.down) :
          TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ
            (fun _ : Fin (k + 1) => Additive (rootsOfUnity m Γ(X.unop.left, ⊤))))) :=
    fun X x => rfl

  have hnat : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcLpttEtPre Y (wcRootsFun.{u} m)).map f ≫ wcKrUntwApp Y m k ζ W' =
        wcKrUntwApp Y m k ζ W ≫ (wcLpttEtPre Y (wcKtT.{u} m (k + 1))).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    apply ULift.ext
    change ((1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
        (Fin.snoc (fun _ : Fin k => Additive.ofMul (ωr W'.unop))
          (MonoidHom.toAdditive (restrictRootsOfUnity f.unop.left.appTop.hom m) x.down)) :
        TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ
          (fun _ : Fin (k + 1) => Additive (rootsOfUnity m Γ(W'.unop.left, ⊤))))) =
      LinearMap.lTensor (ZMod m) (PiTensorProduct.map (fun _ : Fin (k + 1) =>
        (MonoidHom.toAdditive (restrictRootsOfUnity f.unop.left.appTop.hom m)).toIntLinearMap))
        ((1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
          (Fin.snoc (fun _ : Fin k => Additive.ofMul (ωr W.unop)) x.down))
    rw [LinearMap.lTensor_tmul, PiTensorProduct.map_tprod]
    have e : ∀ a : Additive (rootsOfUnity m Γ(W.unop.left, ⊤)),
        (Fin.snoc (α := fun _ : Fin (k + 1) => Additive (rootsOfUnity m Γ(W'.unop.left, ⊤)))
          (fun _ : Fin k => Additive.ofMul (ωr W'.unop))
          (MonoidHom.toAdditive (restrictRootsOfUnity f.unop.left.appTop.hom m) a)) =
        fun i => MonoidHom.toAdditive (restrictRootsOfUnity f.unop.left.appTop.hom m)
          (Fin.snoc (α := fun _ : Fin (k + 1) => Additive (rootsOfUnity m Γ(W.unop.left, ⊤)))
            (fun _ : Fin k => Additive.ofMul (ωr W.unop)) a i) := by
      intro a
      funext i
      induction i using Fin.lastCases with
      | last => rw [Fin.snoc_last, Fin.snoc_last]
      | cast j =>
        rw [Fin.snoc_castSucc, Fin.snoc_castSucc]
        exact congrArg Additive.ofMul (hnatr _ _ f.unop).symm
    exact congrArg (fun t => (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ t) (e x.down)
  have happ : ∀ X, (wcKrUntw Y m k ζ).app X = wcKrUntwApp Y m k ζ X := by
    intro X
    unfold wcKrUntw wcNatOf
    rw [dif_pos hnat]

  choose L hL using fun V : Y.Etale => wc_rtsp_dlog_exists V.left m (φ V ζ₀) (hprim V)
  choose D hD using fun V : Y.Etale =>
    (wc_rtsp_tensor_lift m (k + 1) (Additive (rootsOfUnity m Γ(V.left, ⊤)))).2
      C(V.left, ZMod m) (L V)
  have hL1 : ∀ V : Y.Etale, L V (Additive.ofMul (ωr V)) = 1 := by
    intro V
    ext z
    have h3 := (hL V (Additive.ofMul (ωr V)) z 1).2 (by rw [pow_one]; exact congrArg _ (hωr V))
    rw [h3]
    simp
  have hDU : ∀ (V : Y.Etale) (ξ : Additive (rootsOfUnity m Γ(V.left, ⊤))),
      D V ((1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
        (Fin.snoc (fun _ : Fin k => Additive.ofMul (ωr V)) ξ)) = L V ξ := by
    intro V ξ
    rw [hD V, Fin.prod_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, hL1, Finset.prod_const_one, one_mul, one_smul]

  have halg : ∀ (M : Type u) [AddCommGroup M] (z : M) (a : ZMod m),
      (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
        (Fin.snoc (fun _ : Fin k => z) (a.val • z) : Fin (k + 1) → M) =
      a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin (k + 1) => z) := by
    intro M _ z a
    have h1 : (Fin.snoc (fun _ : Fin k => z) (a.val • z) : Fin (k + 1) → M) =
        Function.update (fun _ : Fin (k + 1) => z) (Fin.last k) (((a.val : ℕ) : ℤ) • z) := by
      funext i
      induction i using Fin.lastCases with
      | last =>
        rw [Fin.snoc_last, Function.update_self]
        exact (natCast_zsmul z a.val).symm
      | cast j =>
        simp [Fin.snoc_castSucc, Function.update_of_ne (Fin.castSucc_lt_last j).ne]
    have hupd : Function.update (fun _ : Fin (k + 1) => z) (Fin.last k) z = fun _ => z := by
      funext i
      by_cases h : i = Fin.last k
      · subst h; simp
      · simp [Function.update_of_ne h]
    rw [h1, MultilinearMap.map_update_smul, hupd, TensorProduct.tmul_smul,
      TensorProduct.smul_tmul', zsmul_eq_mul, mul_one, Int.cast_natCast, ZMod.natCast_zmod_val]

  have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) (wcKrUntw Y m k ζ) := by
    refine ⟨fun {X} x y hxy => ?_⟩
    have hxy' : (wcKrUntwApp Y m k ζ X).hom x = (wcKrUntwApp Y m k ζ X).hom y := by
      have h := hxy
      rw [happ] at h
      exact h
    obtain ⟨a, ha⟩ : ∃ a : Additive (rootsOfUnity m Γ(X.unop.left, ⊤)), a = x.down := ⟨_, rfl⟩
    obtain ⟨b, hb⟩ : ∃ b : Additive (rootsOfUnity m Γ(X.unop.left, ⊤)), b = y.down := ⟨_, rfl⟩
    have h2 : L X.unop a = L X.unop b := by
      rw [← hDU, ← hDU, ha, hb]
      exact congrArg (fun t => D X.unop t.down) hxy'
    have h3 : L X.unop (a - b) = 0 := by rw [map_sub, h2, sub_self]
    have key : ∀ (V₁ : Y.Etale) (c : V₁ ⟶ X.unop),
        (wcLpttEtPre Y (wcRootsFun.{u} m)).map c.op x =
          (wcLpttEtPre Y (wcRootsFun.{u} m)).map c.op y := by
      intro V₁ c
      apply ULift.ext
      change MonoidHom.toAdditive (restrictRootsOfUnity c.left.appTop.hom m) x.down =
        MonoidHom.toAdditive (restrictRootsOfUnity c.left.appTop.hom m) y.down
      have h4 := wc_rtsp_root_eq_of_dlog_const X.unop.left m (φ X.unop ζ₀) (L X.unop)
        (hunit X.unop) (hL X.unop) V₁.left c.left (a - b)
        (Additive.ofMul (ωr X.unop)) 0 (hωr X.unop)
        (fun z' => by rw [h3]; simp)
      rw [map_sub, zero_smul, sub_eq_zero] at h4
      rw [← ha, ← hb]
      exact h4
    apply wc_etale_jointly_surjective_covers Y X.unop
    intro v
    refine ⟨X.unop, 𝟙 X.unop, ?_, ⟨v, by first | rfl | simp⟩⟩
    rw [Presheaf.equalizerSieve_apply]
    exact key _ _

  have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) (wcKrUntw Y m k ζ) := by
    refine ⟨fun {V} s => ?_⟩
    apply wc_etale_jointly_surjective_covers Y V
    intro v
    have H5 : ∀ (Z' : Scheme.{u}) (f : Z' ⟶ V.left) (w : Additive (rootsOfUnity m Γ(V.left, ⊤)))
        (j : ℕ), (∀ z' : Z', L V w (f z') = (j : ZMod m)) →
        MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) w =
          j • MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) (Additive.ofMul (ωr V)) :=
      fun Z' f w j hj => wc_rtsp_root_eq_of_dlog_const V.left m (φ V ζ₀) (L V) (hunit V) (hL V)
        Z' f w (Additive.ofMul (ωr V)) j (hωr V) hj
    obtain ⟨O, hvO, hO⟩ := wc_rtsp_tensor_locally_pure V.left m (k + 1) (Additive.ofMul (ωr V))
      (L V) (D V) H5 (hD V) (ULift.down s) v
    haveI : Etale V.hom := V.prop
    let V₁ : Y.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) inferInstance
    let c : V₁ ⟶ V := MorphismProperty.Over.homMk (A := V₁) (B := V) O.ι rfl trivial
    refine ⟨V₁, c, ?_, ?_⟩
    · rw [Presheaf.imageSieve_apply]
      refine ⟨ULift.up (((D V (ULift.down s) v).val • Additive.ofMul (ωr V₁) :
        Additive (rootsOfUnity m Γ(V₁.left, ⊤)))), ?_⟩
      rw [happ]
      apply ULift.ext
      have h2 := hO (O : Scheme.{u}) O.ι (by rw [Scheme.Opens.range_ι])
      refine Eq.trans ?_ h2.symm
      have e : (fun _ : Fin (k + 1) => Additive.ofMul (ωr V₁)) = (fun _ : Fin (k + 1) =>
          MonoidHom.toAdditive (restrictRootsOfUnity O.ι.appTop.hom m) (Additive.ofMul (ωr V))) :=
        funext fun _ => congrArg Additive.ofMul (hnatr V V₁ c).symm
      rw [← e]
      exact halg (Additive (rootsOfUnity m Γ(V₁.left, ⊤))) (Additive.ofMul (ωr V₁))
        (D V (ULift.down s) v)
    · show v ∈ Set.range O.ι
      rw [Scheme.Opens.range_ι]
      exact hvO

  have hW : (Scheme.smallEtaleTopology Y).W (wcKrUntw Y m k ζ) :=
    (GrothendieckTopology.W_iff_isLocallyBijective (Scheme.smallEtaleTopology Y) _).mpr
      ⟨hinj, hsurj⟩
  exact (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology Y) _).mp hW

theorem wc_krc_sq_ka (Y : Scheme.{u}) (ℓ n k : ℕ) (a : (Γ(Y, ⊤))ˣ)
    (ζ : rootsOfUnity (ℓ ^ n) Γ(Y, ⊤)) :
    wcKrLam Y (ℓ ^ n) k ζ ≫ wcKaFPre Y ℓ n k a = wcKrIota Y (ℓ ^ n) a ≫ wcKrBeta Y ℓ n k a ζ ∧
    wcKrBeta Y ℓ n k a ζ ≫ wcKaGPre Y ℓ n k a = wcKrZ Y (ℓ ^ n) a ≫ wcKrNu Y (ℓ ^ n) k ζ :=
by
  classical

  have hwnat : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      ((wcKtT.{u} (ℓ ^ n) k).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom
          (wcKrW Y (ℓ ^ n) k ζ W) = wcKrW Y (ℓ ^ n) k ζ W' := by
    intro W W' f
    have hw : f.unop.left ≫ W.unop.hom = W'.unop.hom := MorphismProperty.Over.w f.unop
    have h1 := congrArg (fun q => q.appTop.hom ((ζ : Γ(Y, ⊤)ˣ) : Γ(Y, ⊤))) hw
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
    show (LinearMap.lTensor (ZMod (ℓ ^ n)) (PiTensorProduct.map fun _ : Fin k =>
        ((wcRootsFun.{u} (ℓ ^ n)).map (Scheme.Γ.map
          ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom.toIntLinearMap))
        ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin k =>
          (Additive.ofMul (restrictRootsOfUnity W.unop.hom.appTop.hom (ℓ ^ n) ζ) :
            (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left))))) = _
    rw [LinearMap.lTensor_tmul]
    erw [PiTensorProduct.map_tprod]
    congr 2
    funext i
    show Additive.ofMul (restrictRootsOfUnity (Scheme.Γ.map
        ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)).hom (ℓ ^ n)
        (restrictRootsOfUnity W.unop.hom.appTop.hom (ℓ ^ n) ζ)) =
      Additive.ofMul (restrictRootsOfUnity W'.unop.hom.appTop.hom (ℓ ^ n) ζ)
    congr 1
    apply Subtype.ext
    apply Units.ext
    exact h1

  have hTop : ∀ {V : Y.Etale} (g h : V ⟶ wcEtTop Y), g = h := by
    intro V g h
    have hl : ∀ q : V ⟶ wcEtTop Y, q.left = V.hom :=
      fun q => (Category.comp_id q.left).symm.trans (MorphismProperty.Over.w q)
    exact MorphismProperty.Over.Hom.ext ((hl g).trans (hl h).symm)
  have hNuof : ∀ (W : (Y.Etale)ᵒᵖ) (g : ULift.{u+1} (W.unop ⟶ wcEtTop Y)),
      (wcKrNuApp Y (ℓ ^ n) k ζ W).hom (FreeAbelianGroup.of g) =
        ULift.up (wcKrW Y (ℓ ^ n) k ζ W) := by
    intro W g
    apply FreeAbelianGroup.lift_apply_of
  have hFmap : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W') (g : ULift.{u+1} (W.unop ⟶ wcEtTop Y)),
      ((yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f).hom
        (FreeAbelianGroup.of g) = FreeAbelianGroup.of (ULift.up (f.unop ≫ g.down)) := by
    intro W W' f g
    apply FreeAbelianGroup.map_of_apply
  have tens_ext : ∀ {M N : Type u} [AddCommGroup M] [AddCommGroup N] {Q : Type (u+1)}
      [AddCommGroup Q] (φ ψ : ULift.{u+1} (TensorProduct ℤ M N) →+ Q),
      (∀ (m : M) (p : N), φ (ULift.up (m ⊗ₜ[ℤ] p)) = ψ (ULift.up (m ⊗ₜ[ℤ] p))) → φ = ψ := by
    intro M N _ _ Q _ φ ψ h
    apply AddMonoidHom.ext
    rintro ⟨y⟩
    induction y using TensorProduct.induction_on with
    | zero => exact (map_zero φ).trans (map_zero ψ).symm
    | tmul m p => exact h m p
    | add a b ha hb =>
      exact (map_add φ (ULift.up a) (ULift.up b)).trans
        ((congrArg₂ (· + ·) ha hb).trans (map_add ψ (ULift.up a) (ULift.up b)).symm)

  have hLam : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcLpttEtPre Y (wcRootsFun.{u} (ℓ ^ n))).map f ≫ wcKrLamApp Y (ℓ ^ n) k ζ W' =
        wcKrLamApp Y (ℓ ^ n) k ζ W ≫
          (wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k))).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨ξ⟩
    apply ULift.ext
    exact congrArg (TensorProduct.tmul ℤ (((wcRootsFun.{u} (ℓ ^ n)).map (Scheme.Γ.map
      ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom ξ)) (hwnat f).symm
  have hIota : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcLpttEtPre Y (wcRootsFun.{u} (ℓ ^ n))).map f ≫ wcKrIotaApp Y (ℓ ^ n) a W' =
        wcKrIotaApp Y (ℓ ^ n) a W ≫ (wcKrEPre Y (ℓ ^ n) a).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨ξ⟩
    rfl
  have hBeta : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcKrEPre Y (ℓ ^ n) a).map f ≫ wcKrBetaApp Y ℓ n k a ζ W' =
        wcKrBetaApp Y ℓ n k a ζ W ≫ (wcKaBPre Y ℓ n k a).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨e⟩
    apply ULift.ext
    exact congrArg (TensorProduct.tmul ℤ (((wcKaE Y (ℓ ^ n) a).map f).hom e)) (hwnat f).symm
  have hZ : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcKrEPre Y (ℓ ^ n) a).map f ≫ wcKrZApp Y (ℓ ^ n) a W' =
        wcKrZApp Y (ℓ ^ n) a W ≫
          (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨⟨⟨z, g⟩, he⟩⟩
    show z • FreeAbelianGroup.of (ULift.up.{u+1} (wcKrToTop Y W'.unop)) =
      ((yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f).hom
        (z • FreeAbelianGroup.of (ULift.up.{u+1} (wcKrToTop Y W.unop)))
    refine Eq.trans ?_ (map_zsmul ((yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙
      AddCommGrpCat.free).map f).hom z _).symm
    refine Eq.trans ?_ (congrArg (fun t => z • t) (hFmap f (ULift.up (wcKrToTop Y W.unop)))).symm
    exact congrArg (fun h : W'.unop ⟶ wcEtTop Y => z • FreeAbelianGroup.of (ULift.up.{u+1} h))
      (hTop (wcKrToTop Y W'.unop) (f.unop ≫ wcKrToTop Y W.unop))
  have hNu : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f ≫
        wcKrNuApp Y (ℓ ^ n) k ζ W' =
        wcKrNuApp Y (ℓ ^ n) k ζ W ≫ (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k)).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    have hA : ∀ g : ULift.{u+1} (W.unop ⟶ wcEtTop Y),
        ((yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f ≫
          wcKrNuApp Y (ℓ ^ n) k ζ W').hom (FreeAbelianGroup.of g) =
          (ULift.up (wcKrW Y (ℓ ^ n) k ζ W') :
            ULift.{u+1} ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))) := by
      intro g
      exact (congrArg (wcKrNuApp Y (ℓ ^ n) k ζ W').hom (hFmap f g)).trans (hNuof W' _)
    have hB : ∀ g : ULift.{u+1} (W.unop ⟶ wcEtTop Y),
        (wcKrNuApp Y (ℓ ^ n) k ζ W ≫ (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k)).map f).hom
          (FreeAbelianGroup.of g) =
          (ULift.up (wcKrW Y (ℓ ^ n) k ζ W') :
            ULift.{u+1} ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))) := by
      intro g
      refine (congrArg ((wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k)).map f).hom (hNuof W g)).trans ?_
      apply ULift.ext
      exact hwnat f
    exact (FreeAbelianGroup.lift_unique _ _ hA).trans (FreeAbelianGroup.lift_unique _ _ hB).symm
  have hF : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k))).map f ≫
        wcKaFApp Y ℓ n k a W' = wcKaFApp Y ℓ n k a W ≫ (wcKaBPre Y ℓ n k a).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply tens_ext
    intro ζ τ
    rfl
  have hG : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcKaBPre Y ℓ n k a).map f ≫ wcKaGApp Y ℓ n k a W' =
        wcKaGApp Y ℓ n k a W ≫ (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k)).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply tens_ext
    intro e τ
    obtain ⟨⟨z, g⟩, he⟩ := e
    apply ULift.ext
    exact (map_zsmul ((wcKtT.{u} (ℓ ^ n) k).map
      (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom z τ).symm

  have eLam : wcKrLam Y (ℓ ^ n) k ζ = ({ app := wcKrLamApp Y (ℓ ^ n) k ζ, naturality := hLam } :
      wcLpttEtPre Y (wcRootsFun.{u} (ℓ ^ n)) ⟶
        wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k))) := by
    unfold wcKrLam wcNatOf
    exact dif_pos hLam
  have eIota : wcKrIota Y (ℓ ^ n) a = ({ app := wcKrIotaApp Y (ℓ ^ n) a, naturality := hIota } :
      wcLpttEtPre Y (wcRootsFun.{u} (ℓ ^ n)) ⟶ wcKrEPre Y (ℓ ^ n) a) := by
    unfold wcKrIota wcNatOf
    exact dif_pos hIota
  have eBeta : wcKrBeta Y ℓ n k a ζ = ({ app := wcKrBetaApp Y ℓ n k a ζ, naturality := hBeta } :
      wcKrEPre Y (ℓ ^ n) a ⟶ wcKaBPre Y ℓ n k a) := by
    unfold wcKrBeta wcNatOf
    exact dif_pos hBeta
  have eZ : wcKrZ Y (ℓ ^ n) a = ({ app := wcKrZApp Y (ℓ ^ n) a, naturality := hZ } :
      wcKrEPre Y (ℓ ^ n) a ⟶ yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
    unfold wcKrZ wcNatOf
    exact dif_pos hZ
  have eNu : wcKrNu Y (ℓ ^ n) k ζ = ({ app := wcKrNuApp Y (ℓ ^ n) k ζ, naturality := hNu } :
      yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶
        wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k)) := by
    unfold wcKrNu wcNatOf
    exact dif_pos hNu
  have eF : wcKaFPre Y ℓ n k a = ({ app := wcKaFApp Y ℓ n k a, naturality := hF } :
      wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k)) ⟶
        wcKaBPre Y ℓ n k a) := by
    unfold wcKaFPre wcNatOf
    exact dif_pos hF
  have eG : wcKaGPre Y ℓ n k a = ({ app := wcKaGApp Y ℓ n k a, naturality := hG } :
      wcKaBPre Y ℓ n k a ⟶ wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k)) := by
    unfold wcKaGPre wcNatOf
    exact dif_pos hG
  refine ⟨?_, ?_⟩
  · rw [eLam, eF, eIota, eBeta]
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨ξ⟩
    rfl
  · rw [eBeta, eG, eZ, eNu]
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨⟨⟨z, g⟩, he⟩⟩
    show (ULift.up.{u+1} (z • wcKrW Y (ℓ ^ n) k ζ W) :
        ULift.{u+1} ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))) =
      (wcKrNuApp Y (ℓ ^ n) k ζ W).hom
        (z • FreeAbelianGroup.of (ULift.up.{u+1} (wcKrToTop Y W.unop)))
    refine Eq.trans ?_ (map_zsmul (wcKrNuApp Y (ℓ ^ n) k ζ W).hom z _).symm
    refine Eq.trans ?_ (congrArg (fun t => z • t) (hNuof W (ULift.up (wcKrToTop Y W.unop)))).symm
    apply ULift.ext
    first
      | rfl
      | exact (ULift.smul_down _ _).symm

theorem wc_krc_sq_kum (Y : Scheme.{u}) (m : ℕ) (a : (Γ(Y, ⊤))ˣ) :
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKrIota Y m a) ≫
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKrGamma Y m a) =
      wcLpttEtShMap Y (wcKtIncl.{u} m) ∧
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKrGamma Y m a) ≫
      (m • 𝟙 (wcLpttEtSh Y wcKtGm.{u})) =
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKrZ Y m a) ≫
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKrTau Y a) :=
by
  classical



  have htop : ∀ (V : Y.Etale) (t : V ⟶ wcEtTop Y), t = wcKrToTop Y V := by
    intro V t
    apply MorphismProperty.Over.Hom.ext
    have h1 : t.left ≫ (wcEtTop Y).hom = V.hom := MorphismProperty.Over.w t
    have h2 : (wcKrToTop Y V).left = V.hom := rfl
    rw [h2, ← h1]
    exact (Category.comp_id t.left).symm
  have hres : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      Units.map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)).hom.toMonoidHom
        (wcKaUnit Y a W) = wcKaUnit Y a W' := by
    intro W W' f
    apply Units.ext
    have hw : f.unop.left ≫ W.unop.hom = W'.unop.hom := MorphismProperty.Over.w f.unop
    have h1 := congrArg (fun q => q.appTop.hom (a : Γ(Y, ⊤))) hw
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
    exact h1



  have hI : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcLpttEtPre Y (wcRootsFun.{u} m)).map f ≫ wcKrIotaApp Y m a W' =
        wcKrIotaApp Y m a W ≫ (wcKrEPre Y m a).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨ξ⟩
    first
      | rfl
      | (apply ULift.ext; apply Subtype.ext; exact Prod.ext rfl rfl)
  have hZ : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcKrEPre Y m a).map f ≫ wcKrZApp Y m a W' =
        wcKrZApp Y m a W ≫
          (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨⟨⟨z, g⟩, hzg⟩⟩
    show z • FreeAbelianGroup.of (ULift.up.{u+1} (wcKrToTop Y W'.unop)) =
      FreeAbelianGroup.map (fun t : ULift.{u+1} (W.unop ⟶ wcEtTop Y) => ULift.up.{u+1} (f.unop ≫ t.down))
        (z • FreeAbelianGroup.of (ULift.up.{u+1} (wcKrToTop Y W.unop)))
    rw [map_zsmul, FreeAbelianGroup.map_of_apply, ← htop W'.unop (f.unop ≫ wcKrToTop Y W.unop)]
  have hG : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcKrEPre Y m a).map f ≫ wcKrGammaApp Y m a W' =
        wcKrGammaApp Y m a W ≫ (wcLpttEtPre Y wcKtGm.{u}).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨⟨⟨z, g⟩, hzg⟩⟩
    first
      | rfl
      | (apply ULift.ext; apply Additive.toMul.injective; apply Units.ext; rfl)
  have hT : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f ≫
          wcKrTauApp Y a W' =
        wcKrTauApp Y a W ≫ (wcLpttEtPre Y wcKtGm.{u}).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    refine FreeAbelianGroup.lift_ext _ _ (fun x => ?_)
    show (FreeAbelianGroup.lift (fun _ =>
        (ULift.up (Additive.ofMul (wcKaUnit Y a W')) :
          ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W'.unop.left))))))
        (FreeAbelianGroup.map
          (fun t : ULift.{u+1} (W.unop ⟶ wcEtTop Y) => ULift.up.{u+1} (f.unop ≫ t.down))
          (FreeAbelianGroup.of x)) =
      ((wcLpttEtPre Y wcKtGm.{u}).map f).hom
        ((FreeAbelianGroup.lift (fun _ =>
          (ULift.up (Additive.ofMul (wcKaUnit Y a W)) :
            ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left))))))
          (FreeAbelianGroup.of x))
    have hmap : (FreeAbelianGroup.map
          (fun t : ULift.{u+1} (W.unop ⟶ wcEtTop Y) => ULift.up.{u+1} (f.unop ≫ t.down))
          (FreeAbelianGroup.of x)) = FreeAbelianGroup.of (ULift.up.{u+1} (f.unop ≫ x.down)) :=
      FreeAbelianGroup.map_of_apply _
    refine (congrArg (FreeAbelianGroup.lift (fun _ =>
        (ULift.up (Additive.ofMul (wcKaUnit Y a W')) :
          ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))))) hmap).trans ?_
    refine (FreeAbelianGroup.lift_apply_of _ _).trans ?_
    refine Eq.trans ?_ (congrArg ((wcLpttEtPre Y wcKtGm.{u}).map f).hom
      (FreeAbelianGroup.lift_apply_of _ _).symm)
    exact congrArg (fun c => (ULift.up (Additive.ofMul c) :
      ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W'.unop.left))))) (hres f).symm
  have hguard : ∀ ⦃R S : CommRingCat.{u}⦄ (φ : R ⟶ S),
      (wcRootsFun.{u} m).map φ ≫
          AddCommGrpCat.ofHom (MonoidHom.toAdditive (rootsOfUnity m S).subtype) =
        AddCommGrpCat.ofHom (MonoidHom.toAdditive (rootsOfUnity m R).subtype) ≫
          wcKtGm.{u}.map φ := by
    intro R S φ
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    first
      | rfl
      | (apply Additive.toMul.injective
         apply Units.ext
         simp [restrictRootsOfUnity_coe_apply])
  have hIeq : wcKrIota Y m a = ({ app := wcKrIotaApp Y m a, naturality := hI } :
      wcLpttEtPre Y (wcRootsFun.{u} m) ⟶ wcKrEPre Y m a) := by
    unfold wcKrIota wcNatOf
    exact dif_pos hI
  have hZeq : wcKrZ Y m a = ({ app := wcKrZApp Y m a, naturality := hZ } :
      wcKrEPre Y m a ⟶ yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
    unfold wcKrZ wcNatOf
    exact dif_pos hZ
  have hGeq : wcKrGamma Y m a = ({ app := wcKrGammaApp Y m a, naturality := hG } :
      wcKrEPre Y m a ⟶ wcLpttEtPre Y wcKtGm.{u}) := by
    unfold wcKrGamma wcNatOf
    exact dif_pos hG
  have hTeq : wcKrTau Y a = ({ app := wcKrTauApp Y a, naturality := hT } :
      yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶
        wcLpttEtPre Y wcKtGm.{u}) := by
    unfold wcKrTau wcNatOf
    exact dif_pos hT
  have hincl : wcKtIncl.{u} m =
      ({ app := fun R => AddCommGrpCat.ofHom (MonoidHom.toAdditive (rootsOfUnity m R).subtype)
         naturality := hguard } : wcRootsFun.{u} m ⟶ wcKtGm.{u}) := by
    unfold wcKtIncl wcNatOf
    exact dif_pos hguard



  have hP1 : wcKrIota Y m a ≫ wcKrGamma Y m a =
      Functor.whiskerLeft ((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcKtIncl.{u} m) AddCommGrpCat.uliftFunctor.{u+1, u}) := by
    rw [hIeq, hGeq, hincl]
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨ξ⟩
    rfl
  have hP2 : wcKrGamma Y m a ≫ (m • 𝟙 (wcLpttEtPre Y wcKtGm.{u})) =
      wcKrZ Y m a ≫ wcKrTau Y a := by
    rw [Preadditive.comp_nsmul, Category.comp_id, hGeq, hZeq, hTeq]
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨⟨⟨z, g⟩, hzg⟩⟩
    simp only [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul, AddMonoidHom.nsmul_apply]
    show m • (ULift.up g : ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left)))) =
      (FreeAbelianGroup.lift (fun _ =>
        (ULift.up (Additive.ofMul (wcKaUnit Y a W)) :
          ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left))))))
        (z • FreeAbelianGroup.of (ULift.up.{u+1} (wcKrToTop Y W.unop)))
    rw [map_zsmul, FreeAbelianGroup.lift_apply_of]
    apply ULift.ext
    change m • g = z • Additive.ofMul (wcKaUnit Y a W)
    apply Additive.toMul.injective
    rw [toMul_nsmul, toMul_zsmul, toMul_ofMul]
    exact hzg



  have hS : m • 𝟙 (wcLpttEtSh Y wcKtGm.{u}) =
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (m • 𝟙 (wcLpttEtPre Y wcKtGm.{u})) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    try rfl
  refine ⟨?_, ?_⟩
  · rw [← Functor.map_comp, hP1]
    try rfl
  · rw [hS]
    exact ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      ((congrArg (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map hP2).trans
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _))

theorem wc_krc_sq_untw (Y : Scheme.{u}) (ℓ n k : ℕ) (a : (Γ(Y, ⊤))ˣ)
    (hℓY : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (ζ : rootsOfUnity (ℓ ^ n) Γ(Y, ⊤)) :
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKrLam Y (ℓ ^ n) k ζ) ≫
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n (k + 1) k (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY) ≫
      wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1))) =
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
      (wcKrUntw Y (ℓ ^ n) k ζ) :=
by
  classical

  have hRes : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      ((wcRootsFun.{u} (ℓ ^ n)).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom
        (Additive.ofMul (restrictRootsOfUnity W.unop.hom.appTop.hom (ℓ ^ n) ζ) :
          (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left))) =
      (Additive.ofMul (restrictRootsOfUnity W'.unop.hom.appTop.hom (ℓ ^ n) ζ) :
          (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W'.unop.left))) := by
    intro W W' f
    apply Additive.toMul.injective
    apply Subtype.ext
    apply Units.ext
    have hw : f.unop.left ≫ W.unop.hom = W'.unop.hom := MorphismProperty.Over.w f.unop
    have h1 := congrArg (fun q => q.appTop.hom ((ζ : Γ(Y, ⊤)ˣ) : Γ(Y, ⊤))) hw
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
    exact h1

  have hTmap : ∀ (j : ℕ) ⦃R S : CommRingCat.{u}⦄ (φ : R ⟶ S)
      (v : Fin j → (wcRootsFun.{u} (ℓ ^ n)).obj R),
      ((wcKtT.{u} (ℓ ^ n) j).map φ).hom
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ v) =
        (1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
          (fun i => ((wcRootsFun.{u} (ℓ ^ n)).map φ).hom (v i)) := by
    intro j R S φ v
    show (LinearMap.lTensor (ZMod (ℓ ^ n)) (PiTensorProduct.map (fun _ : Fin j =>
        ((wcRootsFun.{u} (ℓ ^ n)).map φ).hom.toIntLinearMap)))
        ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ v) = _
    rw [LinearMap.lTensor_tmul]
    erw [PiTensorProduct.map_tprod]
  have hsnG : ∀ {A B : Type u} (g : A → B) (v : Fin k → A) (b : A),
      (fun i : Fin (k + 1) => g (Fin.snoc (α := fun _ => A) v b i)) =
        Fin.snoc (α := fun _ => B) (fun i => g (v i)) (g b) := by
    intro A B g v b
    funext i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp only [Fin.snoc_last]
    · simp only [Fin.snoc_castSucc]

  have hLamNat : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcLpttEtPre Y (wcRootsFun.{u} (ℓ ^ n))).map f ≫ wcKrLamApp Y (ℓ ^ n) k ζ W' =
        wcKrLamApp Y (ℓ ^ n) k ζ W ≫
          (wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k))).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    have hW : ((wcKtT.{u} (ℓ ^ n) k).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom
        (wcKrW Y (ℓ ^ n) k ζ W) = wcKrW Y (ℓ ^ n) k ζ W' :=
      (hTmap k _ _).trans (congrArg (fun v => (1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ v)
        (funext fun _ => hRes f))
    exact congrArg ULift.up (congrArg (fun y => TensorProduct.tmul ℤ
      (((wcRootsFun.{u} (ℓ ^ n)).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom (ULift.down x)) y)
      hW.symm)

  have hUntwNat : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcLpttEtPre Y (wcRootsFun.{u} (ℓ ^ n))).map f ≫ wcKrUntwApp Y (ℓ ^ n) k ζ W' =
        wcKrUntwApp Y (ℓ ^ n) k ζ W ≫ (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) (k + 1))).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    have hv : (fun _ : Fin k => ((wcRootsFun.{u} (ℓ ^ n)).map
          (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom
          (Additive.ofMul (restrictRootsOfUnity W.unop.hom.appTop.hom (ℓ ^ n) ζ) :
            (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))) =
        (fun _ : Fin k => (Additive.ofMul (restrictRootsOfUnity W'.unop.hom.appTop.hom (ℓ ^ n) ζ) :
            (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))) :=
      funext fun _ => hRes f
    have hsn := (hsnG (((wcRootsFun.{u} (ℓ ^ n)).map
          (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom)
        (fun _ : Fin k => (Additive.ofMul (restrictRootsOfUnity W.unop.hom.appTop.hom (ℓ ^ n) ζ) :
            (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left))))
        (ULift.down x)).trans
      (congrArg (fun v => Fin.snoc (α := fun _ =>
          (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W'.unop.left))) v
          (((wcRootsFun.{u} (ℓ ^ n)).map
            (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom (ULift.down x))) hv)
    have e1 := (hTmap (k + 1) (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))
      (Fin.snoc (α := fun _ => (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
        (fun _ : Fin k => (Additive.ofMul (restrictRootsOfUnity W.unop.hom.appTop.hom (ℓ ^ n) ζ) :
            (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left))))
        (ULift.down x))).trans
      (congrArg (fun v : Fin (k + 1) → (wcRootsFun.{u} (ℓ ^ n)).obj
          (Scheme.Γ.obj (Opposite.op W'.unop.left)) =>
        (1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ v) hsn)
    exact congrArg ULift.up e1.symm

  have hρnat : ∀ (U U' A B : Type u) [AddCommGroup U] [AddCommGroup U'] [AddCommGroup A]
      [AddCommGroup B] (f : U →ₗ[ℤ] U') (g : A →ₗ[ℤ] B),
      wcKtRhoLin (ℓ ^ n) k U' B ∘ₗ TensorProduct.map (TensorProduct.map f g)
        (LinearMap.lTensor (ZMod (ℓ ^ n)) (PiTensorProduct.map (fun _ : Fin k => g))) =
      TensorProduct.map f
          (LinearMap.lTensor (ZMod (ℓ ^ n)) (PiTensorProduct.map (fun _ : Fin (k + 1) => g)))
        ∘ₗ wcKtRhoLin (ℓ ^ n) k U A := by
    intro U U' A B _ _ _ _ f g
    have hsn : ∀ (v : Fin k → A) (b : A),
        (fun i : Fin (k + 1) => g (Fin.snoc (α := fun _ => A) v b i)) =
          Fin.snoc (α := fun _ => B) (fun i => g (v i)) (g b) := by
      intro v b
      funext i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · simp only [Fin.snoc_last]
      · simp only [Fin.snoc_castSucc]
    ext a b c v
    show (f a ⊗ₜ[ℤ] (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
        (Fin.snoc (α := fun _ => B) (fun i => g (v i)) (g b))) :
        TensorProduct ℤ U' (TensorProduct ℤ (ZMod (ℓ ^ n))
          (PiTensorProduct ℤ (fun _ : Fin (k + 1) => B)))) =
      f a ⊗ₜ[ℤ] (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i => g (Fin.snoc (α := fun _ => A) v b i)))
    rw [hsn]
  have hgen1 : ∀ {α β : Type u} (A B : AddCommGrpCat.{u}) (g : α → β) (h : A ⟶ B),
      AddCommGrpCat.ofHom (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap
          h.hom.toIntLinearMap).toAddMonoidHom ≫
        AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift
          (fun _ => (LinearMap.id : B →ₗ[ℤ] B))).toIntLinearMap).toAddMonoidHom =
      AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift
          (fun _ => (LinearMap.id : A →ₗ[ℤ] A))).toIntLinearMap).toAddMonoidHom ≫ h := by
    intro α β A B g h
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.comp_apply,
      LinearMap.toAddMonoidHom_coe]
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul z τ =>
      rw [TensorProduct.map_tmul, TensorProduct.lift.tmul, TensorProduct.lift.tmul,
        AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.coe_toIntLinearMap,
        AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.coe_toIntLinearMap]
      induction z using FreeAbelianGroup.induction_on with
      | zero => simp only [map_zero, LinearMap.zero_apply]
      | of x =>
        rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of]
        rfl
      | neg x hx => simp only [map_neg, LinearMap.neg_apply, hx]
      | add x y hx hy =>
        simp only [map_add, LinearMap.add_apply, hx, hy]
  have hgenT1 : ∀ {α β : Type u} (M M' T T' : AddCommGrpCat.{u}) (g : α → β) (hM : M ⟶ M')
      (hT : T ⟶ T') (s : α) (s' : β), g s = s' → ∀ y : TensorProduct ℤ M T,
      LinearMap.rTensor T' (TensorProduct.mk ℤ (FreeAbelianGroup β) M' (FreeAbelianGroup.of s'))
          (TensorProduct.map hM.hom.toIntLinearMap hT.hom.toIntLinearMap y) =
        TensorProduct.map (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap
            hM.hom.toIntLinearMap) hT.hom.toIntLinearMap
          (LinearMap.rTensor T (TensorProduct.mk ℤ (FreeAbelianGroup α) M
            (FreeAbelianGroup.of s)) y) := by
    intro α β M M' T T' g hM hT s s' hs y
    subst hs
    have key : (LinearMap.rTensor T' (TensorProduct.mk ℤ (FreeAbelianGroup β) M'
          (FreeAbelianGroup.of (g s)))) ∘ₗ
        (TensorProduct.map hM.hom.toIntLinearMap hT.hom.toIntLinearMap) =
        (TensorProduct.map (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap
            hM.hom.toIntLinearMap) hT.hom.toIntLinearMap) ∘ₗ
          (LinearMap.rTensor T (TensorProduct.mk ℤ (FreeAbelianGroup α) M
            (FreeAbelianGroup.of s))) := by
      ext a b
      show ((FreeAbelianGroup.of (g s) ⊗ₜ[ℤ] hM.hom a) ⊗ₜ[ℤ] hT.hom b :
          TensorProduct ℤ (TensorProduct ℤ (FreeAbelianGroup β) M') T') =
        (FreeAbelianGroup.map g (FreeAbelianGroup.of s) ⊗ₜ[ℤ] hM.hom a) ⊗ₜ[ℤ] hT.hom b
      rw [FreeAbelianGroup.map_of_apply]
    exact LinearMap.congr_fun key y
  have hEPS : ∀ {β : Type u} (X : Type u) [AddCommGroup X] (s' : β) (y : X),
      TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id : X →ₗ[ℤ] X))).toIntLinearMap
        (FreeAbelianGroup.of s' ⊗ₜ[ℤ] y) = y := by
    intro β X _ s' y
    rw [TensorProduct.lift.tmul, AddMonoidHom.coe_toIntLinearMap, FreeAbelianGroup.lift_apply_of]
    rfl

  have hgenU : ∀ {β : Type u} (A : Type u) [AddCommGroup A] (s : β) (ξ : A) (v : Fin k → A),
      TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
          TensorProduct ℤ (ZMod (ℓ ^ n)) (PiTensorProduct ℤ (fun _ : Fin (k + 1) => A)) →ₗ[ℤ]
            TensorProduct ℤ (ZMod (ℓ ^ n)) (PiTensorProduct ℤ (fun _ : Fin (k + 1) => A))))).toIntLinearMap
        (wcKtRhoLin (ℓ ^ n) k (FreeAbelianGroup β) A
          ((FreeAbelianGroup.of s ⊗ₜ[ℤ] ξ) ⊗ₜ[ℤ]
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ v))) =
      (1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Fin.snoc (α := fun _ => A) v ξ) := by
    intro β A _ s ξ v
    have hrho : wcKtRhoLin (ℓ ^ n) k (FreeAbelianGroup β) A
          ((FreeAbelianGroup.of s ⊗ₜ[ℤ] ξ) ⊗ₜ[ℤ]
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ v)) =
        FreeAbelianGroup.of s ⊗ₜ[ℤ]
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Fin.snoc (α := fun _ => A) v ξ)) :=
      rfl
    rw [hrho]
    exact hEPS _ s _

  have hnatρ : ∀ D : ℕ, ∀ ⦃R S : CommRingCat.{u}⦄ (φ : R ⟶ S),
      (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ D) (wcRootsFun.{u} (ℓ ^ n))) (wcKtT.{u} (ℓ ^ n) k)).map φ ≫
        AddCommGrpCat.ofHom (wcKtRhoLin (ℓ ^ n) k ((wcKtZUT.{u} ℓ D).obj S)
          ((wcRootsFun.{u} (ℓ ^ n)).obj S)).toAddMonoidHom =
      AddCommGrpCat.ofHom (wcKtRhoLin (ℓ ^ n) k ((wcKtZUT.{u} ℓ D).obj R)
          ((wcRootsFun.{u} (ℓ ^ n)).obj R)).toAddMonoidHom ≫
        (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) (k + 1))).map φ := by
    intro D R S φ
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    exact LinearMap.congr_fun (hρnat _ _ _ _ ((wcKtZUT.{u} ℓ D).map φ).hom.toIntLinearMap
      ((wcRootsFun.{u} (ℓ ^ n)).map φ).hom.toIntLinearMap) x
  have hρ : ∀ D : ℕ, wcKtRho.{u} ℓ n D k = NatTrans.mk (fun R => AddCommGrpCat.ofHom
      (wcKtRhoLin (ℓ ^ n) k ((wcKtZUT.{u} ℓ D).obj R)
        ((wcRootsFun.{u} (ℓ ^ n)).obj R)).toAddMonoidHom) (hnatρ D) := by
    intro D
    unfold wcKtRho wcNatOf
    exact dif_pos (hnatρ D)
  have hnatε : ∀ ⦃R S : CommRingCat.{u}⦄ (φ : R ⟶ S),
      (wcTensFun (wcKtZUT.{u} ℓ (k + 1)) (wcKtT.{u} (ℓ ^ n) (k + 1))).map φ ≫
        AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
          (wcKtT.{u} (ℓ ^ n) (k + 1)).obj S →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) (k + 1)).obj S))).toIntLinearMap).toAddMonoidHom =
      AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
          (wcKtT.{u} (ℓ ^ n) (k + 1)).obj R →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) (k + 1)).obj R))).toIntLinearMap).toAddMonoidHom ≫
        (wcKtT.{u} (ℓ ^ n) (k + 1)).map φ := by
    intro R S φ
    exact hgen1 ((wcKtT.{u} (ℓ ^ n) (k + 1)).obj R) ((wcKtT.{u} (ℓ ^ n) (k + 1)).obj S)
      (ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ (k + 1)).map φ)) ((wcKtT.{u} (ℓ ^ n) (k + 1)).map φ)
  have hε : wcKtEps.{u} ℓ n (k + 1) = NatTrans.mk (fun R => AddCommGrpCat.ofHom (TensorProduct.lift
      (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
        (wcKtT.{u} (ℓ ^ n) (k + 1)).obj R →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) (k + 1)).obj R))).toIntLinearMap).toAddMonoidHom)
      hnatε := by
    unfold wcKtEps wcNatOf
    exact dif_pos hnatε
  have hnatT1 : ∀ (D : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ) ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k))).map f ≫
        wcKaT1App Y ℓ n D k s hℓY W' =
      wcKaT1App Y ℓ n D k s hℓY W ≫
        (wcLpttEtPre Y (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ D) (wcRootsFun.{u} (ℓ ^ n)))
          (wcKtT.{u} (ℓ ^ n) k))).map f := by
    intro D s W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    have hs : ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ D).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
        (wcKaTup Y ℓ D s hℓY W) = wcKaTup Y ℓ D s hℓY W' := by
      apply Subtype.ext
      funext i
      apply Units.ext
      have hw : f.unop.left ≫ W.unop.hom = W'.unop.hom := MorphismProperty.Over.w f.unop
      have h1 := congrArg (fun q => q.appTop.hom (s i : Γ(Y, ⊤))) hw
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
      exact h1
    exact congrArg ULift.up (hgenT1
      ((wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
      ((wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))
      ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
      ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))
      (ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ D).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))))
      ((wcRootsFun.{u} (ℓ ^ n)).map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
      ((wcKtT.{u} (ℓ ^ n) k).map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
      _ _ hs (ULift.down x))
  have hT1 : ∀ (D : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ),
      wcKaT1Pre Y ℓ n D k s hℓY = NatTrans.mk (wcKaT1App Y ℓ n D k s hℓY) (hnatT1 D s) := by
    intro D s
    unfold wcKaT1Pre wcNatOf
    exact dif_pos (hnatT1 D s)
  have hLam : wcKrLam Y (ℓ ^ n) k ζ = NatTrans.mk (wcKrLamApp Y (ℓ ^ n) k ζ) hLamNat := by
    unfold wcKrLam wcNatOf
    exact dif_pos hLamNat
  have hUntw : wcKrUntw Y (ℓ ^ n) k ζ = NatTrans.mk (wcKrUntwApp Y (ℓ ^ n) k ζ) hUntwNat := by
    unfold wcKrUntw wcNatOf
    exact dif_pos hUntwNat

  have key : wcKrLam Y (ℓ ^ n) k ζ ≫
      wcKaT1Pre Y ℓ n (k + 1) k (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY ≫
      Functor.whiskerLeft ((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcKtRho.{u} ℓ n (k + 1) k) AddCommGrpCat.uliftFunctor.{u+1, u}) ≫
      Functor.whiskerLeft ((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcKtEps.{u} ℓ n (k + 1)) AddCommGrpCat.uliftFunctor.{u+1, u}) =
      wcKrUntw Y (ℓ ^ n) k ζ := by
    rw [hLam, hT1, hρ, hε, hUntw]
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    obtain ⟨ξ⟩ := x
    exact congrArg ULift.up (hgenU _
      (wcKaTup Y ℓ (k + 1) (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY W) ξ
      (fun _ : Fin k => (Additive.ofMul (restrictRootsOfUnity W.unop.hom.appTop.hom (ℓ ^ n) ζ) :
        (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))))
  unfold wcLpttEtShMap
  rw [← key]
  exact (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).trans
    (congrArg (fun z => (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map _ ≫ z)
      (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).trans
        (congrArg (fun z => (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map _ ≫ z)
          ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _))))).symm

theorem wc_krc_gen_eq (Y : Scheme.{u}) (ℓ n k : ℕ) (ζ : rootsOfUnity (ℓ ^ n) Γ(Y, ⊤)) :
    wcLpttGenMap (wcEtTop Y) (wcLpttEtSh Y (wcKtT.{u} (ℓ ^ n) k)) (((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k))).app (Opposite.op (wcEtTop Y))).hom (ULift.up ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin k => Additive.ofMul ζ)))) =
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKrNu Y (ℓ ^ n) k ζ) :=
by
  classical

  have hTN : ∀ {W : Scheme.{u}} {P : (W.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} {A B : (W.Etale)ᵒᵖ}
      (e : A ⟶ B) (x : P.obj A),
      (((presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj P).obj.map e).hom
          (((toSheafify (Scheme.smallEtaleTopology W) P).app A).hom x) =
        ((toSheafify (Scheme.smallEtaleTopology W) P).app B).hom ((P.map e).hom x) := by
    intro W P A B e x
    exact (congrArg (fun t => AddCommGrpCat.Hom.hom t x)
      ((toSheafify (Scheme.smallEtaleTopology W) P).naturality e)).symm

  have hC : ∀ {W : Scheme.{u}} (P : (W.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (q : P.obj (Opposite.op (wcEtTop W))),
      ∃ θ : (yoneda.obj (wcEtTop W) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ P,
        wcLpttGenMap (wcEtTop W) ((presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj P)
            (((toSheafify (Scheme.smallEtaleTopology W) P).app (Opposite.op (wcEtTop W))).hom q) =
          (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map θ ∧
        ∀ (V : (W.Etale)ᵒᵖ) (a : ULift.{u+1} (V.unop ⟶ wcEtTop W)),
          (θ.app V).hom (FreeAbelianGroup.of a) = (P.map a.down.op).hom q := by
    intro W P q
    obtain ⟨θ, hθ⟩ : ∃ θ : (yoneda.obj (wcEtTop W) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ P,
        ∀ (V : (W.Etale)ᵒᵖ) (a : ULift.{u+1} (V.unop ⟶ wcEtTop W)),
          (θ.app V).hom (FreeAbelianGroup.of a) = (P.map a.down.op).hom q :=
      ⟨{ app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun f : ULift.{u+1} (V.unop ⟶ wcEtTop W) => (P.map f.down.op).hom q))
         naturality := by
          intro V V' e
          apply AddCommGrpCat.hom_ext
          apply FreeAbelianGroup.lift_ext
          intro f
          obtain ⟨f⟩ := f
          change (FreeAbelianGroup.lift (fun f : ULift.{u+1} (V'.unop ⟶ wcEtTop W) =>
                (P.map f.down.op).hom q))
              (FreeAbelianGroup.map (fun f : ULift.{u+1} (V.unop ⟶ wcEtTop W) =>
                (ULift.up (e.unop ≫ f.down) : ULift.{u+1} (V'.unop ⟶ wcEtTop W)))
                (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ wcEtTop W)))) =
            (P.map e).hom ((FreeAbelianGroup.lift (fun f : ULift.{u+1} (V.unop ⟶ wcEtTop W) =>
                (P.map f.down.op).hom q))
                (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ wcEtTop W))))
          rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
            FreeAbelianGroup.lift_apply_of]
          change (P.map (e.unop ≫ f).op).hom q = (P.map e).hom ((P.map f.op).hom q)
          rw [op_comp, Quiver.Hom.op_unop, Functor.map_comp]
          rfl },
        fun V a => FreeAbelianGroup.lift_apply_of _ _⟩
    refine ⟨θ, ?_, hθ⟩
    have hA : ∀ X : (W.Etale)ᵒᵖ,
        (θ ≫ toSheafify (Scheme.smallEtaleTopology W) P).app X =
          AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun f : ULift.{u+1} (X.unop ⟶ wcEtTop W) =>
              (((presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj P).obj.map
                f.down.op).hom
                (((toSheafify (Scheme.smallEtaleTopology W) P).app (Opposite.op (wcEtTop W))).hom q))) := by
      intro X
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro f
      obtain ⟨f⟩ := f
      show ((toSheafify (Scheme.smallEtaleTopology W) P).app X).hom ((θ.app X).hom
        (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (X.unop ⟶ wcEtTop W)))) = _
      rw [hθ X ⟨f⟩]
      erw [AddCommGrpCat.hom_ofHom, FreeAbelianGroup.lift_apply_of]
      exact (hTN _ _).symm
    unfold wcLpttGenMap wcNatOf
    split_ifs with h
    · rw [Equiv.symm_apply_eq, Adjunction.homEquiv_unit, Adjunction.unit_naturality,
        sheafificationAdjunction_unit_app]
      apply NatTrans.ext
      funext X
      exact (hA X).symm
    · exfalso
      apply h
      intro X X' f
      have hn := (θ ≫ toSheafify (Scheme.smallEtaleTopology W) P).naturality f
      rw [hA, hA] at hn
      exact hn
  obtain ⟨θ, hθgen, hθ⟩ := hC (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k))
    (ULift.up ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin k => Additive.ofMul ζ)) :
      ULift.{u+1} ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op Y))))

  have hApp : ∀ X : (Y.Etale)ᵒᵖ, wcKrNuApp Y (ℓ ^ n) k ζ X = θ.app X := by
    intro X
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro f
    obtain ⟨f⟩ := f
    have hx : f.left = X.unop.hom :=
      (Category.comp_id f.left).symm.trans (MorphismProperty.Over.w f)
    refine Eq.trans ?_ (hθ X ⟨f⟩).symm
    show (ULift.up (wcKrW Y (ℓ ^ n) k ζ X) :
        ULift.{u+1} ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op X.unop.left)))) = _
    symm
    apply ULift.ext
    show (LinearMap.lTensor (ZMod (ℓ ^ n)) (PiTensorProduct.map fun _ : Fin k =>
        ((wcRootsFun.{u} (ℓ ^ n)).map (Scheme.Γ.map f.left.op)).hom.toIntLinearMap))
        ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin k => Additive.ofMul ζ)) =
      wcKrW Y (ℓ ^ n) k ζ X
    rw [LinearMap.lTensor_tmul]
    erw [PiTensorProduct.map_tprod]
    unfold wcKrW
    congr 2
    funext i
    have key : ∀ g : X.unop.left ⟶ Y, g = X.unop.hom →
        restrictRootsOfUnity (Scheme.Γ.map g.op).hom (ℓ ^ n) ζ =
          restrictRootsOfUnity X.unop.hom.appTop.hom (ℓ ^ n) ζ := by
      rintro g rfl
      rfl
    show Additive.ofMul (restrictRootsOfUnity (Scheme.Γ.map f.left.op).hom (ℓ ^ n) ζ) =
      Additive.ofMul (restrictRootsOfUnity X.unop.hom.appTop.hom (ℓ ^ n) ζ)
    exact congrArg Additive.ofMul (key f.left hx)

  have hNu : wcKrNu Y (ℓ ^ n) k ζ = θ := by
    unfold wcKrNu wcNatOf
    split_ifs with h
    · apply NatTrans.ext
      funext X
      exact hApp X
    · exfalso
      apply h
      intro A B e
      rw [hApp A, hApp B]
      exact θ.naturality e
  rw [hNu]
  exact hθgen

theorem wc_krc_kt_extclass (Y : Scheme.{u}) (ℓ n k : ℕ) (a : (Γ(Y, ⊤))ˣ)
    (hℓY : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤)))
    (w : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKaFPre Y ℓ n k a) ≫
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKaGPre Y ℓ n k a) = 0)
    (hK : (ShortComplex.mk
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKaFPre Y ℓ n k a))
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKaGPre Y ℓ n k a))
      w).ShortExact) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    wcLpttKt Y ℓ n k a hℓY = hK.extClass.comp (Abelian.Ext.mk₀
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n (k + 1) k (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY) ≫
      wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1))))
      (add_zero 1) :=
by
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨wk, hSk⟩ := wc_lptt_et_step_ses Y ℓ n (k + 1) k
  have hext : wcLpttEtStep Y ℓ n (k + 1) k =
      hSk.extClass.comp (Abelian.Ext.mk₀ (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k))) (add_zero 1) := by
    unfold wcLpttEtStep wcExtOfMaps
    rw [dif_pos wk, dif_pos hSk]
  have hu : (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) ⟨k, Nat.lt_succ_self k⟩ = a := by
    simp
  have hnat := wc_lptt_ka_tau2_nat Y ℓ n (k + 1) k
    (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) a hℓY (Nat.lt_succ_self k) hu
  have hN : hK.extClass.comp (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).map (wcKaT1Pre Y ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY))) (add_zero 1) =
      (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n (k + 1) k
        (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY)).comp hSk.extClass (zero_add 1) :=
    hK.extClass_naturality hSk (ShortComplex.Hom.mk
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n (k + 1) k (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY))
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT2Pre Y ℓ n (k + 1) k (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) a hℓY))
      (wcLpttUSec Y ℓ n (k + 1) k (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY)
      (wc_lptt_ka_sq1 Y ℓ n (k + 1) k _ a hℓY (Nat.lt_succ_self k) hu hnat)
      (wc_lptt_ka_sq2 Y ℓ n (k + 1) k _ a hℓY (Nat.lt_succ_self k) hu hnat))
  have A1 : ∀ {X₁ X₂ X₃ X₄ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (e : Abelian.Ext X₁ X₂ 1) (f : X₂ ⟶ X₃) (g : X₃ ⟶ X₄),
      (e.comp (Abelian.Ext.mk₀ f) (add_zero 1)).comp (Abelian.Ext.mk₀ g) (add_zero 1) =
        e.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero 1) := by
    intro X₁ X₂ X₃ X₄ e f g
    rw [Abelian.Ext.comp_assoc e _ _ (add_zero 1) (zero_add 0) (by omega : 1 + 0 + 0 = 1),
      Abelian.Ext.mk₀_comp_mk₀]
  have A2 : ∀ {X₀ X₁ X₂ X₃ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (v : X₀ ⟶ X₁) (e : Abelian.Ext X₁ X₂ 1) (f : X₂ ⟶ X₃),
      (Abelian.Ext.mk₀ v).comp (e.comp (Abelian.Ext.mk₀ f) (add_zero 1)) (zero_add 1) =
        ((Abelian.Ext.mk₀ v).comp e (zero_add 1)).comp (Abelian.Ext.mk₀ f) (add_zero 1) := by
    intro X₀ X₁ X₂ X₃ v e f
    exact (Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ v) e (Abelian.Ext.mk₀ f) (zero_add 1)
      (add_zero 1) (by omega : 0 + 1 + 0 = 1)).symm
  unfold wcLpttKt
  rw [hext]
  have R1 := congrArg (fun z => (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n (k + 1) k
        (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY)).comp z (zero_add 1))
    (A1 hSk.extClass (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k))
      (wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1))))
  have R2 := A2 (wcLpttUSec Y ℓ n (k + 1) k
        (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY) hSk.extClass
      (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1)))
  have R3 := congrArg (fun z => z.comp (Abelian.Ext.mk₀
      (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1))))
      (add_zero 1)) hN.symm
  have R4 := A1 hK.extClass
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓY))
      (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1)))
  exact R1.trans (R2.trans (R3.trans R4))

theorem wc_krc_restrict (Y : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    (I : InjectiveResolution G) (c : wcFtcFS Y (wcEtTop Y) ⟶ I.cocomplex.X 1)
    (hc : c ≫ I.cocomplex.d 1 (1 + 1) = 0) (W : Y.Etale) (rW : W ⟶ wcEtTop Y) (N : ℕ)
    (y : (I.cocomplex.X 0).obj.obj (Opposite.op W))
    (hy : ((I.cocomplex.d 0 1).hom.app (Opposite.op W)).hom y = N • (c.hom.app (Opposite.op W)).hom (((wcFtcFS Y (wcEtTop Y)).obj.map rW.op).hom (wcFtcGen Y (wcEtTop Y)))) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    N • (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
      (Functor.whiskerRight (yoneda.map rW) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))).comp
      (I.extMk c (1 + 1) rfl hc) (zero_add 1) = 0 :=
by
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  have corep : ∀ (U : Y.Etale) (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : wcFtcFS Y U ⟶ F => (φ.hom.app (Opposite.op U)).hom (wcFtcGen Y U)) := by
    intro U F
    let P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let g₀ : P.obj (Opposite.op U) := FreeAbelianGroup.of (ULift.up (𝟙 U))
    let Φ : (wcFtcFS Y U ⟶ F) → (P ⟶ F.obj) := fun φ =>
      toSheafify (Scheme.smallEtaleTopology Y) P ≫ φ.hom
    let Ψ : (P ⟶ F.obj) → F.obj.obj (Opposite.op U) := fun α => (α.app (Opposite.op U)).hom g₀
    have hfac : (fun φ : wcFtcFS Y U ⟶ F => (φ.hom.app (Opposite.op U)).hom (wcFtcGen Y U)) =
        Ψ ∘ Φ := by
      funext φ
      rfl
    have hΦ : Function.Bijective Φ := by
      constructor
      · intro φ ψ h
        apply Sheaf.hom_ext
        exact sheafify_hom_ext (Scheme.smallEtaleTopology Y) _ _ F.property h
      · intro α
        exact ⟨⟨sheafifyLift (Scheme.smallEtaleTopology Y) α F.property⟩,
          toSheafify_sheafifyLift (Scheme.smallEtaleTopology Y) α F.property⟩
    have hgen : ∀ (T : Y.Etale) (f : T ⟶ U),
        (P.map f.op).hom g₀ = FreeAbelianGroup.of (ULift.up f) := by
      intro T f
      change FreeAbelianGroup.of (ULift.up (f ≫ 𝟙 U)) = _
      rw [Category.comp_id]
    have hΨ : Function.Bijective Ψ := by
      constructor
      · intro α β h
        apply NatTrans.ext
        funext T
        cases T with
        | op T =>
        apply AddCommGrpCat.hom_ext
        apply FreeAbelianGroup.lift_ext
        intro x
        obtain ⟨f⟩ := x
        have hα := NatTrans.naturality_apply α f.op g₀
        have hβ := NatTrans.naturality_apply β f.op g₀
        change (α.app (Opposite.op T)).hom ((P.map f.op).hom g₀) =
          (F.obj.map f.op).hom ((α.app (Opposite.op U)).hom g₀) at hα
        change (β.app (Opposite.op T)).hom ((P.map f.op).hom g₀) =
          (F.obj.map f.op).hom ((β.app (Opposite.op U)).hom g₀) at hβ
        rw [hgen] at hα hβ
        change (α.app (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up f)) =
          (β.app (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up f))
        exact hα.trans ((congrArg (fun z => (F.obj.map f.op).hom z) h).trans hβ.symm)
      · intro s
        let α : P ⟶ F.obj :=
          { app := fun T => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
              (fun x : ULift.{u+1} (Opposite.unop T ⟶ U) => (F.obj.map x.down.op).hom s))
            naturality := by
              intro T T₂ h
              apply AddCommGrpCat.hom_ext
              apply FreeAbelianGroup.lift_ext
              intro x
              change FreeAbelianGroup.lift
                  (fun x : ULift.{u+1} (Opposite.unop T₂ ⟶ U) => (F.obj.map x.down.op).hom s)
                  (FreeAbelianGroup.of (ULift.up (h.unop ≫ x.down))) =
                (F.obj.map h).hom (FreeAbelianGroup.lift
                  (fun x : ULift.{u+1} (Opposite.unop T ⟶ U) => (F.obj.map x.down.op).hom s)
                  (FreeAbelianGroup.of x))
              have e1 : (F.obj.map (h.unop ≫ x.down).op).hom s =
                  (F.obj.map h).hom ((F.obj.map x.down.op).hom s) := by
                rw [op_comp, Quiver.Hom.op_unop, Functor.map_comp, AddCommGrpCat.hom_comp]
                rfl
              have e2 := FreeAbelianGroup.lift_apply_of
                (fun y : ULift.{u+1} (Opposite.unop T ⟶ U) => (F.obj.map y.down.op).hom s) x
              have e3 := FreeAbelianGroup.lift_apply_of
                (fun y : ULift.{u+1} (Opposite.unop T₂ ⟶ U) => (F.obj.map y.down.op).hom s)
                (ULift.up (h.unop ≫ x.down))
              exact e3.trans (e1.trans (congrArg (fun z => (F.obj.map h).hom z) e2.symm)) }
        refine ⟨α, ?_⟩
        change FreeAbelianGroup.lift
            (fun x : ULift.{u+1} (U ⟶ U) => (F.obj.map x.down.op).hom s)
            (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s
        rw [FreeAbelianGroup.lift_apply_of]
        change (F.obj.map (𝟙 U).op).hom s = s
        rw [op_id, F.obj.map_id]
        rfl
    rw [hfac]
    exact hΨ.comp hΦ


  have hnatgen : (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
      (Functor.whiskerRight (yoneda.map rW) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).hom.app
        (Opposite.op W)).hom (wcFtcGen Y W) =
      ((wcFtcFS Y (wcEtTop Y)).obj.map rW.op).hom (wcFtcGen Y (wcEtTop Y)) := by
    have e1 : ((Functor.whiskerRight (yoneda.map rW)
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op W)).hom
          (FreeAbelianGroup.of (ULift.up (𝟙 W))) = FreeAbelianGroup.of (ULift.up rW) := by
      change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) = _
      first
        | exact (FreeAbelianGroup.map_of_apply _).trans
            (congrArg FreeAbelianGroup.of (congrArg ULift.up (Category.id_comp rW)))
        | (erw [FreeAbelianGroup.map_of_apply]
           exact congrArg FreeAbelianGroup.of (congrArg ULift.up (Category.id_comp rW)))
        | (simp [FreeAbelianGroup.map_of_apply]; done)
    have e2 : ((yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map rW.op).hom
          (FreeAbelianGroup.of (ULift.up (𝟙 (wcEtTop Y)))) = FreeAbelianGroup.of (ULift.up rW) := by
      change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) = _
      first
        | exact (FreeAbelianGroup.map_of_apply _).trans
            (congrArg FreeAbelianGroup.of (congrArg ULift.up (Category.comp_id rW)))
        | (erw [FreeAbelianGroup.map_of_apply]
           exact congrArg FreeAbelianGroup.of (congrArg ULift.up (Category.comp_id rW)))
        | (simp [FreeAbelianGroup.map_of_apply]; done)
    have k1 := congrArg
      (fun f => (f.app (Opposite.op W)).hom (FreeAbelianGroup.of (ULift.up (𝟙 W))))
      (toSheafify_naturality (Scheme.smallEtaleTopology Y)
        (Functor.whiskerRight (yoneda.map rW) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
    have k2 := congrArg (fun f => f.hom (FreeAbelianGroup.of (ULift.up (𝟙 (wcEtTop Y)))))
      ((toSheafify (Scheme.smallEtaleTopology Y)
        (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).naturality rW.op)
    calc _ = ((toSheafify (Scheme.smallEtaleTopology Y)
            (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op W)).hom
            (((Functor.whiskerRight (yoneda.map rW)
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op W)).hom
                (FreeAbelianGroup.of (ULift.up (𝟙 W)))) := k1.symm
      _ = ((toSheafify (Scheme.smallEtaleTopology Y)
            (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op W)).hom
            (FreeAbelianGroup.of (ULift.up rW)) := congrArg _ e1
      _ = ((toSheafify (Scheme.smallEtaleTopology Y)
            (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op W)).hom
            (((yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map rW.op).hom
              (FreeAbelianGroup.of (ULift.up (𝟙 (wcEtTop Y))))) := congrArg _ e2.symm
      _ = _ := k2

  have nsmul_extMk : ∀ (M : ℕ) {X : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (f : X ⟶ I.cocomplex.X 1) (hf : f ≫ I.cocomplex.d 1 (1 + 1) = 0),
      M • I.extMk f (1 + 1) rfl hf =
        I.extMk (M • f) (1 + 1) rfl (by rw [Preadditive.nsmul_comp, hf, nsmul_zero]) := by
    intro M X f hf
    induction M with
    | zero =>
      have e : I.extMk ((0 : ℕ) • f) (1 + 1) rfl
          (by rw [Preadditive.nsmul_comp, hf, nsmul_zero]) =
          I.extMk (0 : X ⟶ I.cocomplex.X 1) (1 + 1) rfl (by rw [Limits.zero_comp]) := by
        congr 1
        exact zero_nsmul f
      rw [zero_nsmul, e, I.extMk_zero]
    | succ M ih =>
      rw [succ_nsmul, ih, I.add_extMk]
      congr 1
      exact (succ_nsmul f M).symm
  obtain ⟨j, hj⟩ : ∃ j : wcFtcFS Y W ⟶ wcFtcFS Y (wcEtTop Y),
      j = (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (Functor.whiskerRight (yoneda.map rW) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
    ⟨_, rfl⟩
  have hj' : (j.hom.app (Opposite.op W)).hom (wcFtcGen Y W) =
      ((wcFtcFS Y (wcEtTop Y)).obj.map rW.op).hom (wcFtcGen Y (wcEtTop Y)) := by
    rw [hj]; exact hnatgen
  rw [← hj]
  have hjc : (j ≫ c) ≫ I.cocomplex.d 1 (1 + 1) = 0 := by
    rw [Category.assoc, hc, Limits.comp_zero]
  rw [I.mk₀_comp_extMk c (1 + 1) rfl hc j, nsmul_extMk N (j ≫ c) hjc,
    I.extMk_eq_zero_iff _ (1 + 1) rfl _ 0 rfl]
  have ev : ∀ (φ : wcFtcFS Y W ⟶ I.cocomplex.X 1) (M : ℕ),
      ((M • φ).hom.app (Opposite.op W)).hom (wcFtcGen Y W) =
        M • (φ.hom.app (Opposite.op W)).hom (wcFtcGen Y W) := by
    intro φ M
    let e : (wcFtcFS Y W ⟶ I.cocomplex.X 1) →+ (I.cocomplex.X 1).obj.obj (Opposite.op W) :=
      AddMonoidHom.mk' (fun f => (f.hom.app (Opposite.op W)).hom (wcFtcGen Y W))
        (fun f₁ f₂ => by
          simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply])
    exact map_nsmul e M φ
  obtain ⟨g, hg⟩ := (corep W (I.cocomplex.X 0)).2 y
  refine ⟨g, (corep W (I.cocomplex.X 1)).1 ?_⟩
  show ((g ≫ I.cocomplex.d 0 1).hom.app (Opposite.op W)).hom (wcFtcGen Y W) =
    ((N • (j ≫ c)).hom.app (Opposite.op W)).hom (wcFtcGen Y W)
  rw [ev]
  have h1 : ((g ≫ I.cocomplex.d 0 1).hom.app (Opposite.op W)).hom (wcFtcGen Y W) =
      ((I.cocomplex.d 0 1).hom.app (Opposite.op W)).hom
        ((g.hom.app (Opposite.op W)).hom (wcFtcGen Y W)) := rfl
  have h2 : ((j ≫ c).hom.app (Opposite.op W)).hom (wcFtcGen Y W) =
      (c.hom.app (Opposite.op W)).hom ((j.hom.app (Opposite.op W)).hom (wcFtcGen Y W)) := rfl
  have hg' : (g.hom.app (Opposite.op W)).hom (wcFtcGen Y W) = y := hg
  rw [h1, h2, hg', hy, hj']

theorem wc_krc_root_extract (Y : Scheme.{u}) (m : ℕ) (a : (Γ(Y, ⊤))ˣ)
    (w : wcLpttEtShMap Y (wcKtIncl.{u} m) ≫ (m • 𝟙 (wcLpttEtSh Y wcKtGm.{u})) = 0)
    (hU : (ShortComplex.mk (wcLpttEtShMap Y (wcKtIncl.{u} m))
      (m • 𝟙 (wcLpttEtSh Y wcKtGm.{u})) w).ShortExact)
    (W : Y.Etale) (rW : W ⟶ wcEtTop Y) (N : ℕ) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    N • (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
      (Functor.whiskerRight (yoneda.map rW) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKrTau Y a))).comp
      hU.extClass (zero_add 1) = 0 →
    ∃ u : (Γ(W.left, ⊤))ˣ, (u : Γ(W.left, ⊤)) ^ m = W.hom.appTop.hom ((a : Γ(Y, ⊤)) ^ N) :=
by
  classical
  intro hyp
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hlift : ∀ {X : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (g : X ⟶ wcLpttEtSh Y wcKtGm.{u}) (M : ℕ),
      M • (Abelian.Ext.mk₀ g).comp hU.extClass (zero_add 1) = 0 →
      ∃ χ : X ⟶ wcLpttEtSh Y wcKtGm.{u}, χ ≫ (m • 𝟙 (wcLpttEtSh Y wcKtGm.{u})) = M • g := by
    intro X g M h
    have hA : ∀ M' : ℕ, (Abelian.Ext.mk₀ (M' • g)).comp hU.extClass (zero_add 1) =
        M' • (Abelian.Ext.mk₀ g).comp hU.extClass (zero_add 1) := by
      intro M'
      induction M' with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
      | succ M' ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp, ih]
    rw [← hA] at h
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hU _ (zero_add 1) h
    refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
    rw [← Abelian.Ext.mk₀_homEquiv₀_apply x₂, Abelian.Ext.mk₀_comp_mk₀] at hx₂
    have h2 := congrArg Abelian.Ext.homEquiv₀ hx₂
    rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply] at h2
    exact h2

  have hres : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      Units.map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)).hom.toMonoidHom
        (wcKaUnit Y a W) = wcKaUnit Y a W' := by
    intro W W' f
    apply Units.ext
    have hw : f.unop.left ≫ W.unop.hom = W'.unop.hom := MorphismProperty.Over.w f.unop
    have h1 := congrArg (fun q => q.appTop.hom (a : Γ(Y, ⊤))) hw
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
    exact h1
  have hT : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f ≫
          wcKrTauApp Y a W' =
        wcKrTauApp Y a W ≫ (wcLpttEtPre Y wcKtGm.{u}).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    refine FreeAbelianGroup.lift_ext _ _ (fun x => ?_)
    show (FreeAbelianGroup.lift (fun _ =>
        (ULift.up (Additive.ofMul (wcKaUnit Y a W')) :
          ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W'.unop.left))))))
        (FreeAbelianGroup.map
          (fun t : ULift.{u+1} (W.unop ⟶ wcEtTop Y) => ULift.up.{u+1} (f.unop ≫ t.down))
          (FreeAbelianGroup.of x)) =
      ((wcLpttEtPre Y wcKtGm.{u}).map f).hom
        ((FreeAbelianGroup.lift (fun _ =>
          (ULift.up (Additive.ofMul (wcKaUnit Y a W)) :
            ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left))))))
          (FreeAbelianGroup.of x))
    have hmap : (FreeAbelianGroup.map
          (fun t : ULift.{u+1} (W.unop ⟶ wcEtTop Y) => ULift.up.{u+1} (f.unop ≫ t.down))
          (FreeAbelianGroup.of x)) = FreeAbelianGroup.of (ULift.up.{u+1} (f.unop ≫ x.down)) :=
      FreeAbelianGroup.map_of_apply _
    refine (congrArg (FreeAbelianGroup.lift (fun _ =>
        (ULift.up (Additive.ofMul (wcKaUnit Y a W')) :
          ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))))) hmap).trans ?_
    refine (FreeAbelianGroup.lift_apply_of _ _).trans ?_
    refine Eq.trans ?_ (congrArg ((wcLpttEtPre Y wcKtGm.{u}).map f).hom
      (FreeAbelianGroup.lift_apply_of _ _).symm)
    exact congrArg (fun c => (ULift.up (Additive.ofMul c) :
      ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W'.unop.left))))) (hres f).symm
  have hTeq : wcKrTau Y a = ({ app := wcKrTauApp Y a, naturality := hT } :
      yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶
        wcLpttEtPre Y wcKtGm.{u}) := by
    unfold wcKrTau wcNatOf
    exact dif_pos hT
  have hτapp : (wcKrTau Y a).app (Opposite.op W) = wcKrTauApp Y a (Opposite.op W) := by
    rw [hTeq]
  have hTS : ∀ {P P' : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (η : P ⟶ P') (U : (Y.Etale)ᵒᵖ)
      (x : P.obj U),
      (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map η).hom.app U).hom
        (((toSheafify (Scheme.smallEtaleTopology Y) P).app U).hom x) =
      ((toSheafify (Scheme.smallEtaleTopology Y) P').app U).hom ((η.app U).hom x) := by
    intro P P' η U x
    exact (congrArg (fun g => AddCommGrpCat.Hom.hom (NatTrans.app g U) x)
