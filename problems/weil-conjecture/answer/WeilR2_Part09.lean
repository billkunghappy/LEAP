    isIso_toSheafify _ hsh
  have hbij : Function.Bijective
      ((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y wcKtGm.{u})).app
        (Opposite.op W)).hom := by
    first
    | exact ConcreteCategory.bijective_of_isIso
        ((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y wcKtGm.{u})).app (Opposite.op W))
    | exact (asIso ((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y wcKtGm.{u})).app
        (Opposite.op W))).addCommGroupIsoToAddEquiv.bijective
  obtain ⟨s', hs'⟩ := hbij.2 (ev χ)
  have hkey : ((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y wcKtGm.{u})).app
        (Opposite.op W)).hom (m • s') =
      ((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y wcKtGm.{u})).app
        (Opposite.op W)).hom (N • (ULift.up (Additive.ofMul (wcKaUnit Y a (Opposite.op W))) :
          ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.left))))) := by
    refine (map_nsmul ((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y wcKtGm.{u})).app
        (Opposite.op W)).hom m s').trans ?_
    refine Eq.trans ?_ (map_nsmul ((toSheafify (Scheme.smallEtaleTopology Y)
        (wcLpttEtPre Y wcKtGm.{u})).app (Opposite.op W)).hom N
        (ULift.up (Additive.ofMul (wcKaUnit Y a (Opposite.op W))) :
          ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.left))))).symm
    rw [hs']
    exact h5
  have h4 := hbij.1 hkey

  obtain ⟨v, hv⟩ : ∃ v : (Γ(W.left, ⊤))ˣ, v = Additive.toMul s'.down := ⟨_, rfl⟩
  obtain ⟨ua, hua⟩ : ∃ ua : (Γ(W.left, ⊤))ˣ, ua = wcKaUnit Y a (Opposite.op W) := ⟨_, rfl⟩
  refine ⟨v, ?_⟩
  have h6 := congrArg (fun t : (wcLpttEtPre Y wcKtGm.{u}).obj (Opposite.op W) =>
    ((Additive.toMul t.down : (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤))) h4
  have e2 : (Additive.toMul (m • s').down : (Γ(W.left, ⊤))ˣ) = v ^ m := by
    subst hv
    first
    | rfl
    | exact toMul_nsmul _ _
    | (rw [ULift.smul_down, toMul_nsmul])
  have e3 : (Additive.toMul (N • (ULift.up (Additive.ofMul (wcKaUnit Y a (Opposite.op W))) :
          ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.left))))).down :
        (Γ(W.left, ⊤))ˣ) = ua ^ N := by
    subst hua
    first
    | rfl
    | exact toMul_nsmul _ _
    | (rw [ULift.smul_down, toMul_nsmul]; rfl)
  have e4 : (ua : Γ(W.left, ⊤)) = W.hom.appTop.hom (a : Γ(Y, ⊤)) := by
    subst hua
    first
    | rfl
    | simp [wcKaUnit]
  calc (v : Γ(W.left, ⊤)) ^ m
      = ((v ^ m : (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤)) := (Units.val_pow_eq_pow_val _ _).symm
    _ = ((Additive.toMul (m • s').down : (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤)) := by rw [e2]
    _ = ((Additive.toMul (N • (ULift.up (Additive.ofMul (wcKaUnit Y a (Opposite.op W))) :
          ULift.{u+1} (wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.left))))).down :
        (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤)) := h6
    _ = ((ua ^ N : (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤)) := by rw [e3]
    _ = (ua : Γ(W.left, ⊤)) ^ N := Units.val_pow_eq_pow_val _ _
    _ = W.hom.appTop.hom ((a : Γ(Y, ⊤)) ^ N) := by rw [e4, map_pow]

theorem wc_lptt_kt_root_cocycle : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : IsUnit ((ℓ : ℕ) : K)) (n : ℕ) (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) (k : ℕ) (a : (Γ(Y, ⊤))ˣ) (hℓY : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (ζ : rootsOfUnity (ℓ ^ n) Γ(Y, ⊤)) (ζ₀ : K), IsPrimitiveRoot ζ₀ (ℓ ^ n) → ((ζ : Γ(Y, ⊤)ˣ) : Γ(Y, ⊤)) = fY.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom ζ₀) → ∀ (I : InjectiveResolution (wcLpttEtSh Y (wcKtT.{u} (ℓ ^ n) (k + 1)))) (c : wcFtcFS Y (wcEtTop Y) ⟶ I.cocomplex.X 1) (hc : c ≫ I.cocomplex.d 1 (1 + 1) = 0), letI := HasExt.standard (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}); I.extMk c (1 + 1) rfl hc = (Abelian.Ext.mk₀ (wcLpttGenMap (wcEtTop Y) (wcLpttEtSh Y (wcKtT.{u} (ℓ ^ n) k)) (((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k))).app (Opposite.op (wcEtTop Y))).hom (ULift.up ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin k => Additive.ofMul ζ)))))).comp (wcLpttKt Y ℓ n k a hℓY) (zero_add 1) → ∀ (W : Y.Etale) (rW : W ⟶ wcEtTop Y) (N : ℕ) (y : (I.cocomplex.X 0).obj.obj (Opposite.op W)), ((I.cocomplex.d 0 1).hom.app (Opposite.op W)).hom y = N • (c.hom.app (Opposite.op W)).hom (((wcFtcFS Y (wcEtTop Y)).obj.map rW.op).hom (wcFtcGen Y (wcEtTop Y))) → ∃ u : (Γ(W.left, ⊤))ˣ, (u : Γ(W.left, ⊤)) ^ (ℓ ^ n) = W.hom.appTop.hom ((a : Γ(Y, ⊤)) ^ N) :=
by
