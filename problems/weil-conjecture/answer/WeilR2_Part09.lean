                ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀,
                Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega),
                Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega)]
          _ = 0 := by rw [h1, h2, Abelian.Ext.comp_zero, Abelian.Ext.comp_zero, add_zero]
      set S := ShortComplex.mk _ g hz with hSdef
      have h0 : (Abelian.Ext.mk₀ S.g).comp e (zero_add _) = 0 := hmid _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS G e h0 (show 1 + n = n + 1 by omega)
      rw [← hx₁]
      cases n with
      | succ k =>
        rw [hA0 k x₁, Abelian.Ext.comp_zero]
      | zero =>
        obtain ⟨z, hz'⟩ := hsurj (Abelian.Ext.homEquiv₀ x₁)
        have hx : x₁ = (Abelian.Ext.mk₀ S.f).comp (Abelian.Ext.mk₀ (Limits.biprod.fst ≫ z)) (add_zero 0) := by
          rw [Abelian.Ext.mk₀_comp_mk₀]
          have : S.f ≫ Limits.biprod.fst ≫ z = Abelian.Ext.homEquiv₀ x₁ := by
            show Limits.biprod.lift f₁ f₂ ≫ Limits.biprod.fst ≫ z = _
            rw [Limits.biprod.lift_fst_assoc, hz']
          rw [this, Abelian.Ext.mk₀_homEquiv₀_apply]
        rw [hx, ← Abelian.Ext.comp_assoc hS.extClass (Abelian.Ext.mk₀ S.f) _ (add_zero 1) (add_zero 0) (by omega),
          ShortComplex.ShortExact.extClass_comp, Abelian.Ext.zero_comp]
    have s7 : ∀ {E E' : T.Etale} (i : E' ⟶ E), Function.Surjective (I.obj.map i.op) → Function.Surjective (((wcEpsInv T).obj I).obj.map ((wcEtToProEt T).map i).op) := by
      intro E E' i hsurj
      set η := (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt T) AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T) (Scheme.ProEt.topology T)).unit.app I with hη
      haveI := hU I
      haveI : IsIso η.hom := (sheafToPresheaf _ _).map_isIso η
      haveI : IsIso (η.hom.app (Opposite.op E')) := inferInstance
      have hbij : Function.Bijective (η.hom.app (Opposite.op E')) := ConcreteCategory.bijective_of_isIso _
      intro y
      obtain ⟨x, rfl⟩ := hbij.2 y
      obtain ⟨z, rfl⟩ := hsurj x
      refine ⟨η.hom.app (Opposite.op E) z, ?_⟩
      have hn := ConcreteCategory.congr_hom (η.hom.naturality i.op) z
      exact hn.symm
    obtain ⟨eP, hnatP, haddP⟩ := s2 (Scheme.ProEt.topology T)
    obtain ⟨eE, hnatE, haddE⟩ := s2 (Scheme.smallEtaleTopology T)
    have s11 : ∀ {X X' : T.Etale} (i : X' ⟶ X), Mono i → Function.Surjective (I.obj.map i.op) := by
      intro X X' i hi s
      haveI := s3 (Scheme.smallEtaleTopology T) i hi
      refine ⟨eE X I (Injective.factorThru ((eE X' I).symm s) ((presheafToSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))), ?_⟩
      rw [← hnatE, Injective.comp_factorThru, Equiv.apply_symm_apply]
    let 𝒢 := (wcEpsInv T).obj I
    let Hp : T.Opens → Prop := fun W => ∀ (n : ℕ) (e : Abelian.Ext (wcFreeSheaf T (Scheme.ProEt.mk W.ι)) 𝒢 (n + 1)), e = 0
    have hAff : ∀ A : T.Opens, IsAffineOpen A → Hp A := fun A hA' n e => hA A hA' I n e

    have hmv : ∀ A V : T.Opens, Hp A → Hp V → Hp (A ⊓ V) → Hp (A ⊔ V) := by
      intro A V hAp hV hAV
      let a : Scheme.ProEt.mk (A ⊓ V).ι ⟶ Scheme.ProEt.mk A.ι :=
        MorphismProperty.Over.homMk (T.homOfLE (inf_le_left : A ⊓ V ≤ A)) (T.homOfLE_ι _) trivial
      let b : Scheme.ProEt.mk (A ⊓ V).ι ⟶ Scheme.ProEt.mk V.ι :=
        MorphismProperty.Over.homMk (T.homOfLE (inf_le_right : A ⊓ V ≤ V)) (T.homOfLE_ι _) trivial
      let c : Scheme.ProEt.mk A.ι ⟶ Scheme.ProEt.mk (A ⊔ V).ι :=
        MorphismProperty.Over.homMk (T.homOfLE (le_sup_left : A ≤ A ⊔ V)) (T.homOfLE_ι _) trivial
      let d : Scheme.ProEt.mk V.ι ⟶ Scheme.ProEt.mk (A ⊔ V).ι :=
        MorphismProperty.Over.homMk (T.homOfLE (le_sup_right : V ≤ A ⊔ V)) (T.homOfLE_ι _) trivial
      let a' : Scheme.Etale.mk (A ⊓ V).ι ⟶ Scheme.Etale.mk A.ι :=
        MorphismProperty.Over.homMk (T.homOfLE (inf_le_left : A ⊓ V ≤ A)) (T.homOfLE_ι _) trivial
      have hmonoc : Mono c := ⟨fun g h _ => s8sub _ _ g h⟩
      have hmonod : Mono d := ⟨fun g h _ => s8sub _ _ g h⟩
      have hmonoa : Mono a := ⟨fun g h _ => s8sub _ _ g h⟩
      have hmonoa' : Mono a' := ⟨fun g h _ => s8et _ _ g h⟩
      have hpb : ∀ (Z : T.ProEt) (g₁ : Z ⟶ Scheme.ProEt.mk A.ι) (g₂ : Z ⟶ Scheme.ProEt.mk V.ι), g₁ ≫ c = g₂ ≫ d → ∃ k : Z ⟶ Scheme.ProEt.mk (A ⊓ V).ι, k ≫ a = g₁ ∧ k ≫ b = g₂ := by
        intro Z g₁ g₂ _
        have hsub : Set.range Z.hom ⊆ ((A ⊓ V : T.Opens) : Set T) := by
          rintro _ ⟨x, rfl⟩
          exact ⟨hrange A Z g₁ x, hrange V Z g₂ x⟩
        obtain ⟨k⟩ := s8ex (A ⊓ V) Z hsub
        exact ⟨k, s8sub _ _ _ _, s8sub _ _ _ _⟩
      have hcovR : ∀ R : Sieve (Scheme.ProEt.mk (A ⊔ V).ι), R.arrows c → R.arrows d → R ∈ Scheme.ProEt.topology T (Scheme.ProEt.mk (A ⊔ V).ι) := by
        intro R hc hd
        apply s4 (Scheme.ProEt.mk (A ⊔ V).ι) A V (fun x => hrange (A ⊔ V) (Scheme.ProEt.mk (A ⊔ V).ι) (𝟙 _) x) R
        intro T' f hT'
        rcases hT' with hT' | hT'
        · obtain ⟨k⟩ := s8ex A T' (by rintro _ ⟨x, rfl⟩; exact hT' x)
          rw [s8sub _ _ f (k ≫ c)]
          exact R.downward_closed hc k
        · obtain ⟨k⟩ := s8ex V T' (by rintro _ ⟨x, rfl⟩; exact hT' x)
          rw [s8sub _ _ f (k ≫ d)]
          exact R.downward_closed hd k
      have hglue := s5 a b c d hmonoc hmonod hpb hcovR
      let hm : ∀ {X X' : T.ProEt}, (X' ⟶ X) → (wcFreeSheaf T X' ⟶ wcFreeSheaf T X) :=
        fun i => (presheafToSheaf (Scheme.ProEt.topology T) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      have hcomp : ∀ {X X' X'' : T.ProEt} (i : X'' ⟶ X') (j : X' ⟶ X), hm i ≫ hm j = hm (i ≫ j) := by
        intro X X' X'' i j
        have h := (presheafToSheaf (Scheme.ProEt.topology T) AddCommGrpCat.{u+1}).map_comp
          (Functor.whiskerRight (yoneda.map i) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
          (Functor.whiskerRight (yoneda.map j) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
        rw [← Functor.whiskerRight_comp, ← yoneda.map_comp] at h
        exact h.symm
      have hma : Mono (hm a) := s3 (Scheme.ProEt.topology T) a hmonoa
      have hac : a ≫ c = b ≫ d := s8sub _ _ _ _
      obtain ⟨hz, hSE⟩ := s6 (fun X => wcFreeSheaf T X) hm hcomp eP (fun X X' i F g => hnatP X X' i F g) haddP a b c d hma hac hglue
      have hsurjA : Function.Surjective (𝒢.obj.map a.op) := s7 a' (s11 a' hmonoa')
      have hdeg0 : ∀ y : wcFreeSheaf T (Scheme.ProEt.mk (A ⊓ V).ι) ⟶ 𝒢, ∃ z : wcFreeSheaf T (Scheme.ProEt.mk A.ι) ⟶ 𝒢, hm a ≫ z = y := by
        intro y
        obtain ⟨σ', hσ'⟩ := hsurjA (eP _ 𝒢 y)
        refine ⟨(eP _ 𝒢).symm σ', ?_⟩
        apply (eP _ 𝒢).injective
        refine (hnatP (Scheme.ProEt.mk A.ι) (Scheme.ProEt.mk (A ⊓ V).ι) a 𝒢 ((eP _ 𝒢).symm σ')).trans ?_
        rw [Equiv.apply_symm_apply, hσ']
      exact s1 (hm a) (hm b) _ hz hSE hAV hAp hV hdeg0

    have stage1 : ∀ (U : T.Opens), IsAffineOpen U → ∀ (k : ℕ) (s : Finset Γ(T, U)), s.card ≤ k →
        Hp (s.sup (fun g => T.basicOpen g)) := by
      intro U hU' k
      induction k with
      | zero =>
        intro s hs
        rw [Finset.card_eq_zero.mp (Nat.le_zero.mp hs), Finset.sup_empty]
        exact hAff ⊥ (isAffineOpen_bot T)
      | succ k ih =>
        intro s hs
        rcases s.eq_empty_or_nonempty with h | ⟨f, hf⟩
        · rw [h, Finset.sup_empty]
          exact hAff ⊥ (isAffineOpen_bot T)
        · have e1 : s.sup (fun g => T.basicOpen g) =
              T.basicOpen f ⊔ (s.erase f).sup (fun g => T.basicOpen g) := by
            conv_lhs => rw [← Finset.insert_erase hf]
            rw [Finset.sup_insert]
          have hc : (s.erase f).card ≤ k := by
            rw [Finset.card_erase_of_mem hf]
            omega
          have e2 : T.basicOpen f ⊓ (s.erase f).sup (fun g => T.basicOpen g) =
              ((s.erase f).image (fun g => f * g)).sup (fun g => T.basicOpen g) := by
            rw [Finset.sup_inf_distrib_left, Finset.sup_image]
            refine Finset.sup_congr rfl (fun g _ => ?_)
            exact (Scheme.basicOpen_mul T f g).symm
          rw [e1]
          apply hmv _ _ (hAff _ (hU'.basicOpen f)) (ih _ hc)
          rw [e2]
          exact ih _ (Finset.card_image_le.trans hc)

    have stage2 : ∀ S : T.Opens, IsCompact (S : Set T) → Hp S := by
      intro S hS
      refine compact_open_induction_on (P := Hp) S hS (hAff ⊥ (isAffineOpen_bot T)) ?_
      intro S' hS' U hPS'
      refine hmv S' U hPS' (hAff U U.2) ?_
      have hK : IsCompact ((S' ⊓ (U : T.Opens) : T.Opens) : Set T) := by
        rw [TopologicalSpace.Opens.coe_inf]
        exact QuasiSeparatedSpace.inter_isCompact _ _ S'.isOpen hS' (U : T.Opens).isOpen U.2.isCompact
      have hloc : ∀ x : ↥(S' ⊓ (U : T.Opens)), ∃ f : Γ(T, (U : T.Opens)),
          T.basicOpen f ≤ S' ⊓ (U : T.Opens) ∧ (x : T) ∈ T.basicOpen f :=
        fun x => U.2.exists_basicOpen_le x (TopologicalSpace.Opens.mem_inf.mp x.2).2
      choose f hf using hloc
      obtain ⟨t, ht⟩ := hK.elim_finite_subcover (fun x => ((T.basicOpen (f x) : T.Opens) : Set T))
        (fun x => (T.basicOpen (f x)).isOpen) (by
          intro y hy
          exact Set.mem_iUnion.mpr ⟨⟨y, hy⟩, (hf ⟨y, hy⟩).2⟩)
      have heq : S' ⊓ (U : T.Opens) = (t.image f).sup (fun g => T.basicOpen g) := by
        apply le_antisymm
        · intro y hy
          have hy' := ht hy
          rw [Set.mem_iUnion₂] at hy'
          obtain ⟨x, hx, hyx⟩ := hy'
          exact Finset.le_sup (f := fun g => T.basicOpen g) (Finset.mem_image_of_mem f hx) hyx
        · apply Finset.sup_le
          intro g hg
          obtain ⟨x, _, rfl⟩ := Finset.mem_image.mp hg
          exact (hf x).1
      rw [heq]
      exact stage1 _ U.2 _ _ le_rfl
    have htop : Hp ⊤ := stage2 ⊤ (by rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ)
    have hsub1 : ∀ (f g : Scheme.ProEt.mk (⊤ : T.Opens).ι ⟶ Scheme.ProEt.mk (⊤ : T.Opens).ι), f = g := s8sub _ _
    have hsub2 : ∀ (f g : Scheme.ProEt.mk (𝟙 T) ⟶ Scheme.ProEt.mk (𝟙 T)), f = g := by
      intro f g
      apply MorphismProperty.Over.Hom.ext
      have h1 : f.left ≫ 𝟙 T = g.left ≫ 𝟙 T := (MorphismProperty.Over.w f).trans (MorphismProperty.Over.w g).symm
      exact (cancel_mono (𝟙 T)).mp h1
    let p : Scheme.ProEt.mk (⊤ : T.Opens).ι ⟶ Scheme.ProEt.mk (𝟙 T) :=
      MorphismProperty.Over.homMk (⊤ : T.Opens).ι (Category.comp_id _) trivial
    have hr : Set.range (𝟙 T : T ⟶ T) ⊆ Set.range (⊤ : T.Opens).ι := fun x _ => (Scheme.Opens.range_ι (⊤ : T.Opens)).ge trivial
    let k : (T : Scheme.{u}) ⟶ ((⊤ : T.Opens) : Scheme.{u}) := IsOpenImmersion.lift (⊤ : T.Opens).ι (𝟙 T) hr
    have hk : k ≫ (⊤ : T.Opens).ι = 𝟙 T := IsOpenImmersion.lift_fac _ _ _
    let q : Scheme.ProEt.mk (𝟙 T) ⟶ Scheme.ProEt.mk (⊤ : T.Opens).ι :=
      MorphismProperty.Over.homMk k hk trivial
    let iso : Scheme.ProEt.mk (⊤ : T.Opens).ι ≅ Scheme.ProEt.mk (𝟙 T) :=
      { hom := p, inv := q, hom_inv_id := hsub1 _ _, inv_hom_id := hsub2 _ _ }
    let ψ : wcFreeSheaf T (Scheme.ProEt.mk (⊤ : T.Opens).ι) ≅ wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T)) :=
      (yoneda ⋙ (Functor.whiskeringRight _ _ _).obj (uliftFunctor.{u+1,u} ⋙ AddCommGrpCat.free) ⋙
        presheafToSheaf (Scheme.ProEt.topology T) AddCommGrpCat.{u+1}).mapIso iso
    have h0 : (Abelian.Ext.mk₀ ψ.hom).comp e (zero_add (n + 1)) = 0 := htop n _
    calc e = (Abelian.Ext.mk₀ (𝟙 _)).comp e (zero_add (n + 1)) := (Abelian.Ext.mk₀_id_comp e).symm
      _ = ((Abelian.Ext.mk₀ ψ.inv).comp (Abelian.Ext.mk₀ ψ.hom) (add_zero 0)).comp e
            (zero_add (n + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id]
      _ = (Abelian.Ext.mk₀ ψ.inv).comp ((Abelian.Ext.mk₀ ψ.hom).comp e (zero_add (n + 1)))
            (zero_add (n + 1)) :=
          Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega)
      _ = 0 := by rw [h0, Abelian.Ext.comp_zero]

  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt T)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T) (Scheme.ProEt.topology T)
  haveI : ∀ G', IsIso (adj.unit.app G') := hU
  haveI : IsIso adj.unit := NatIso.isIso_of_isIso_app _
  have ha : ∀ G' : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1},
      Function.Bijective (fun g : X ⟶ G' => (wcEpsInv T).map g) :=
    fun G' => (adj.fullyFaithfulLOfIsIsoUnit).map_bijective X G'

  let ψX : (wcEpsInv T).obj X ≅ wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T)) :=
    (wcEpsInv T).mapIso hX.some ≪≫ (wc_epsInv_const T (AddCommGrpCat.of (ULift.{u+1} ℤ))).some ≪≫
      (wc_free_terminal_const T).some.symm
  have hb : ∀ (I : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) [Injective I] (m : ℕ)
      (e : Abelian.Ext ((wcEpsInv T).obj X) ((wcEpsInv T).obj I) (m + 1)), e = 0 := by
    intro I _ m e
    have h0 : (Abelian.Ext.mk₀ ψX.inv).comp e (zero_add (m + 1)) = 0 := hfin I m _
    calc e = (Abelian.Ext.mk₀ (𝟙 _)).comp e (zero_add (m + 1)) := (Abelian.Ext.mk₀_id_comp e).symm
      _ = ((Abelian.Ext.mk₀ ψX.hom).comp (Abelian.Ext.mk₀ ψX.inv) (add_zero 0)).comp e
            (zero_add (m + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      _ = (Abelian.Ext.mk₀ ψX.hom).comp ((Abelian.Ext.mk₀ ψX.inv).comp e (zero_add (m + 1)))
            (zero_add (m + 1)) :=
          Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (m + 1)) (by omega)
      _ = 0 := by rw [h0, Abelian.Ext.comp_zero]
  haveI : EssentiallySmall.{u+1} T.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives
  exact wc_ext_transfer_exact (wcEpsInv T) X ha hb H n

theorem wc_lptt_epsInv_ext_inj (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y]
    [(wcEpsInv Y).Additive] [Limits.PreservesFiniteLimits (wcEpsInv Y)]
    [Limits.PreservesFiniteColimits (wcEpsInv Y)]
    (M : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (k : ℕ) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ x : Abelian.Ext (wcFtcFS Y (wcEtTop Y)) M k,
      Abelian.Ext.mapExactFunctor (wcEpsInv Y) x = 0 → x = 0 :=
by
  intro x hx
  have huniq : ∀ (V : Y.Etale) (f g : V ⟶ wcEtTop Y), f = g := by
    intro V f g
    apply MorphismProperty.Over.Hom.ext
    have hf : f.left ≫ 𝟙 Y = V.hom := MorphismProperty.Over.w f
    have hg : g.left ≫ 𝟙 Y = V.hom := MorphismProperty.Over.w g
    exact (Category.comp_id f.left).symm.trans (hf.trans (hg.symm.trans (Category.comp_id g.left)))
  have hU : ∀ V : Y.Etale, Unique (V ⟶ wcEtTop Y) := fun V =>
    { default := MorphismProperty.Over.homMk V.hom
      uniq := fun f => huniq V f _ }
  let e : ∀ V : Y.Etaleᵒᵖ,
      FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ wcEtTop Y)) ≃+ ULift.{u+1} ℤ :=
    fun V => by
      letI := hU V.unop
      exact (FreeAbelianGroup.uniqueEquiv _).trans AddEquiv.ulift.symm
  have he : ∀ (V : Y.Etaleᵒᵖ) (t : ULift.{u+1} (V.unop ⟶ wcEtTop Y)),
      e V (FreeAbelianGroup.of t) = ULift.up 1 := by
    intro V t
    simp [e, FreeAbelianGroup.uniqueEquiv, AddEquiv.ulift] <;> rfl
  let η : (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≅
      (Functor.const Y.Etaleᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) :=
    NatIso.ofComponents (fun V => (e V).toAddCommGrpIso) (by
      intro V W f
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro t
      change e W (FreeAbelianGroup.map
          (fun x : ULift.{u+1} (V.unop ⟶ wcEtTop Y) =>
            (ULift.up (f.unop ≫ x.down) : ULift.{u+1} (W.unop ⟶ wcEtTop Y)))
          (FreeAbelianGroup.of t)) = e V (FreeAbelianGroup.of t)
      exact (congrArg (e W) (FreeAbelianGroup.map_of_apply _)).trans
        ((he W _).trans (he V t).symm))
  have hX : Nonempty (wcFtcFS Y (wcEtTop Y) ≅ wcEtUnitSheaf Y) :=
    ⟨(presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapIso η⟩
  have hbij := wc_epsInv_ext_bijective_qcqs Y (wcFtcFS Y (wcEtTop Y)) M hX k
  apply hbij.1
  rw [hx, Abelian.Ext.mapExactFunctor_zero]

theorem wc_lptt_et_step_ses (Y : Scheme.{u}) (ℓ n D k : ℕ) :
    ∃ w, (ShortComplex.mk
      (wcLpttEtShMap Y (wcTensNat (wcKtIotaE.{u} ℓ n D k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
      (wcLpttEtShMap Y (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n D k ⟶ wcKtZUT.{u} ℓ D)
        (𝟙 (wcKtT.{u} (ℓ ^ n) k)))) w).ShortExact :=
by
  classical



  have hsheafify : ∀ {P₁ P₂ P₃ : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
      (f : P₁ ⟶ P₂) (g : P₂ ⟶ P₃) (w : f ≫ g = 0)
      (_hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) f)
      (_hex : ∀ (U : Y.Etale) (x : P₂.obj (Opposite.op U)), (g.app (Opposite.op U)).hom x = 0 →
        ∃ R ∈ Scheme.smallEtaleTopology Y U, ∀ (V : Y.Etale) (i : V ⟶ U), R.arrows i →
