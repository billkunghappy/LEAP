    let U := Functor.whiskerRight
        ((yonedaEquiv (X := wcEtTop Y)
          (F := (Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ 0)).symm
          (Subtype.mk Fin.elim0 hℓY : {t : Fin 0 → (Γ(Y, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))}))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let ε' := Functor.whiskerLeft ((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcKtEps.{u} ℓ n 0) AddCommGrpCat.uliftFunctor.{u+1, u})
    let θ := U ≫ wcLpttEtNu Y ℓ n 0 ≫ ε'
    have hgen : wcLpttGen0 Y ℓ n hℓY =
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map θ := by
      have e1 : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map θ =
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map U ≫
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
            (wcLpttEtNu Y ℓ n 0) ≫
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map ε' := by
        exact ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp U
          (wcLpttEtNu Y ℓ n 0 ≫ ε')).trans
          (congrArg ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map U ≫ ·)
            ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp
              (wcLpttEtNu Y ℓ n 0) ε'))
      rw [e1]
      rfl
    have hcθ : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (c • θ) = 0 := by
      rw [Functor.map_nsmul, ← hgen]
      exact hc
    have hnat := (sheafificationAdjunction (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).unit_naturality (c • θ)
    rw [sheafificationAdjunction_unit_app, sheafificationAdjunction_unit_app, hcθ, Functor.map_zero,
      Limits.comp_zero] at hnat
    let W0 : (Y.Etale)ᵒᵖ := Opposite.op (wcEtTop Y)
    let x0 : FreeAbelianGroup (ULift.{u+1} (wcEtTop Y ⟶ wcEtTop Y)) :=
      FreeAbelianGroup.of (ULift.up (𝟙 (wcEtTop Y)))
    have hU : ∃ a, (U.app W0).hom x0 = FreeAbelianGroup.of a :=
      ⟨_, FreeAbelianGroup.map_of_apply _⟩
    obtain ⟨a, ha⟩ := hU
    have hθ : (θ.app W0).hom x0 = ULift.up (e (Scheme.Γ.obj (Opposite.op (wcEtTop Y).left))) := by
      change (ε'.app W0).hom (((wcLpttEtNu Y ℓ n 0).app W0).hom ((U.app W0).hom x0)) = _
      rw [ha]
      refine (congrArg (ε'.app W0).hom (hνapp W0 a)).trans ?_
      apply ULift.ext
      exact (hεapp _ _ _).trans (he _).symm
    have h0' := NatTrans.congr_app hnat.symm W0
    rw [NatTrans.comp_app, NatTrans.app_zero] at h0'
    have h1 : ((toSheafify (Scheme.smallEtaleTopology Y)
        (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) 0))).app W0).hom (((c • θ).app W0).hom x0) = 0 := by
      have := congrArg (fun g => g.hom x0) h0'
      exact this
    rw [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul] at h1
    erw [AddMonoidHom.nsmul_apply] at h1
    rw [hθ] at h1
    have h2 : ((toSheafify (Scheme.smallEtaleTopology Y)
        (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) 0))).app W0).hom
        (ULift.up (c • e (Scheme.Γ.obj (Opposite.op (wcEtTop Y).left)))) =
        ((toSheafify (Scheme.smallEtaleTopology Y)
          (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) 0))).app W0).hom 0 := by
      rw [map_zero]
      exact h1

    have hS := Presheaf.IsLocallyInjective.equalizerSieve_mem (J := Scheme.smallEtaleTopology Y)
      (φ := toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) 0))) _ _ h2
    obtain ⟨𝒰, hOver, hP, hle⟩ := (Scheme.mem_smallGrothendieckTopology _ _).mp hS
    obtain ⟨pt⟩ := (inferInstance : Nonempty Y)
    obtain ⟨i, -, -⟩ := @Scheme.Cover.exists_eq _ _ Scheme.instJointlySurjectivePrecoverage 𝒰 pt
    have h3 := hle _ _ (Presieve.ofArrows.mk (C := Y.Etale) i)
    change _ = _ at h3
    rw [map_zero] at h3
    have h4 := congrArg ULift.down h3
    change ((wcKtT.{u} (ℓ ^ n) 0).map _).hom (c • e _) = 0 at h4
    rw [map_nsmul, heT, he] at h4
    exact key _ _ h4

  have hmk : ∀ k : ℕ, k • Abelian.Ext.mk₀ (wcLpttGen0 (Spec (.of K)) ℓ n hℓ) =
      Abelian.Ext.mk₀ (k • wcLpttGen0 (Spec (.of K)) ℓ n hℓ) := by
    intro k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have h0' : ℓ ^ (n - 1) • Abelian.Ext.mk₀ (wcLpttGen0 (Spec (.of K)) ℓ n hℓ) = 0 := h0
  rw [hmk, Abelian.Ext.mk₀_eq_zero_iff] at h0'
  have hdvd := main (Spec (.of K)) hℓ (ℓ ^ (n - 1)) h0'
  have hp : Nat.Prime ℓ := Fact.out
  have hle := (Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp hdvd
  omega

theorem wc_ext_two_row_edge : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] (A : C) (I : InjectiveResolution A), letI := HasExt.standard C; letI := HasExt.standard D; (∀ q : ℕ, 2 ≤ q → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) → ∃ (E : ∀ (P : D) (k : ℕ), Abelian.Ext (L.obj P) A (k + 1) →+ Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1) k) (ε : ℕ → ℤ), (∀ k, ε k = 1 ∨ ε k = -1) ∧ (∀ (P₁ : D) (g : L.obj P₁ ⟶ I.cocomplex.X 1) (hg : g ≫ I.cocomplex.d 1 (1 + 1) = 0) (hf : adj.homEquiv _ _ g ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d 1 (1 + 1) = 0), E P₁ 0 (I.extMk g (1 + 1) rfl hg) = Abelian.Ext.mk₀ (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (adj.homEquiv _ _ g) (1 + 1) (by simp) hf ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ 1)) ∧ ∀ (P P₁ : D) (k : ℕ) (y : Abelian.Ext P P₁ k) (c : Abelian.Ext (L.obj P₁) A 1), E P k ((Abelian.Ext.mapExactFunctor L y).comp c rfl) = ε k • y.comp (E P₁ 0 c) (add_zero k) :=
by
  intro C D _ _ _ _ _ L R _ _ adj _ _ A I hH
  letI := HasExt.standard C
  letI := HasExt.standard D

  have s1 : ∀ (K : CochainComplex D ℕ) (j : ℕ), Limits.IsZero (K.homology (j + 1)) →
      ∃ (w : K.iCycles j ≫ K.toCycles j (j + 1) = 0),
        (ShortComplex.mk (K.iCycles j) (K.toCycles j (j + 1)) w).ShortExact := by
    intro K j hZ
    have w : K.iCycles j ≫ K.toCycles j (j + 1) = 0 := by
      rw [← cancel_mono (K.iCycles (j + 1)), Category.assoc, HomologicalComplex.toCycles_i,
        HomologicalComplex.iCycles_d, Limits.zero_comp]
    refine ⟨w, ?_⟩
    have hepi : Epi (K.toCycles j (j + 1)) :=
      Preadditive.epi_of_isZero_cokernel' _ (K.homologyIsCokernel j (j + 1) (by simp)) hZ
    refine ShortComplex.ShortExact.mk' ?_ (by dsimp; infer_instance) hepi
    refine ShortComplex.exact_of_f_is_kernel _ ?_
    refine Limits.KernelFork.IsLimit.ofι _ _
      (fun {W'} g' hg' => K.liftCycles g' (j + 1) (by simp) (by
        have hg'' : g' ≫ K.toCycles j (j + 1) = 0 := hg'
        rw [← HomologicalComplex.toCycles_i, ← Category.assoc, hg'', Limits.zero_comp])) ?_ ?_
    · intro W' g' hg'
      exact K.liftCycles_i _ _ _ _
    · intro W' g' hg' m hm
      rw [← cancel_mono (K.iCycles j), K.liftCycles_i]
      exact hm

  have s5 : ∀ (P P' : D) (a : ℕ) (y : Abelian.Ext P P' (a + 1)), ∃ (Q I' : D) (i : P' ⟶ I') (p : I' ⟶ Q)
      (w : i ≫ p = 0) (hS : (ShortComplex.mk i p w).ShortExact) (y' : Abelian.Ext P Q a),
      y = y'.comp hS.extClass rfl := by
    intro P P' a y
    have hS : (ShortComplex.mk (Injective.ι P') (Limits.cokernel.π (Injective.ι P'))
        (Limits.cokernel.condition _)).ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ (by dsimp; infer_instance) (by dsimp; infer_instance)
      exact ShortComplex.exact_of_g_is_cokernel _ (Limits.cokernelIsCokernel _)
    have h0 : y.comp (Abelian.Ext.mk₀ (Injective.ι P')) (add_zero _) = 0 :=
      Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS y h0 (rfl : a + 1 = a + 1)
    exact ⟨_, _, _, _, _, hS, x₃, hx₃.symm⟩

  have s2 : ∀ (K : CochainComplex D ℕ) (hw : ∀ j : ℕ, K.iCycles (j + 1) ≫ K.toCycles (j + 1) (j + 1 + 1) = 0)
      (hK : ∀ j : ℕ, (ShortComplex.mk _ _ (hw j)).ShortExact),
      ∃ Δ : ∀ k : ℕ, Abelian.Ext (K.cycles (k + 1)) (K.homology 1) k,
        Δ 0 = Abelian.Ext.mk₀ (K.homologyπ 1) ∧
        (∀ k : ℕ, (Abelian.Ext.mk₀ (K.toCycles k (k + 1))).comp (Δ k) (zero_add k) = 0) ∧
        ∀ k : ℕ, Δ (k + 1) = (hK k).extClass.comp (Δ k) (add_comm 1 k) := by
    intro K hw hK
    let Δ : ∀ k : ℕ, Abelian.Ext (K.cycles (k + 1)) (K.homology 1) k := fun k =>
      Nat.rec (motive := fun k => Abelian.Ext (K.cycles (k + 1)) (K.homology 1) k)
        (Abelian.Ext.mk₀ (K.homologyπ 1)) (fun k ih => (hK k).extClass.comp ih (add_comm 1 k)) k
    refine ⟨Δ, rfl, ?_, fun k => rfl⟩
    intro k
    cases k with
    | zero =>
      show (Abelian.Ext.mk₀ (K.toCycles 0 (0 + 1))).comp (Abelian.Ext.mk₀ (K.homologyπ 1)) (zero_add 0) = 0
      rw [Abelian.Ext.mk₀_comp_mk₀, HomologicalComplex.toCycles_comp_homologyπ, Abelian.Ext.mk₀_zero]
    | succ k =>
      show (Abelian.Ext.mk₀ (K.toCycles (k + 1) (k + 1 + 1))).comp
        ((hK k).extClass.comp (Δ k) (add_comm 1 k)) (zero_add (k + 1)) = 0
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (K.toCycles (k + 1) (k + 1 + 1))) (hK k).extClass (Δ k)
        (zero_add 1) (add_comm 1 k) (show 0 + 1 + k = k + 1 by omega)]
      have h0 := (hK k).comp_extClass
      dsimp only at h0
      rw [h0, Abelian.Ext.zero_comp]

  have s6 : ∀ (T : D) (E : ∀ (P : D) (m : ℕ), Abelian.Ext (L.obj P) A (m + 1) →+ Abelian.Ext P T m)
      (εI : ℕ → ℤ), (∀ b, εI b = 1 ∨ εI b = -1) →
      (∀ (P P' : D) (f : P ⟶ P') (b : ℕ) (x : Abelian.Ext (L.obj P') A (b + 1)),
        E P b ((Abelian.Ext.mk₀ (L.map f)).comp x (zero_add (b + 1))) =
          (Abelian.Ext.mk₀ f).comp (E P' b x) (zero_add b)) →
      (∀ (S : ShortComplex D) (hS : S.ShortExact) (b : ℕ) (x : Abelian.Ext (L.obj S.X₁) A (b + 1)),
        E S.X₃ (b + 1) ((hS.map_of_exact L).extClass.comp x (add_comm 1 (b + 1))) =
          εI b • hS.extClass.comp (E S.X₁ b x) (add_comm 1 b)) →
      ∃ ε : ℕ → ℤ, (∀ k, ε k = 1 ∨ ε k = -1) ∧ ∀ (P P₁ : D) (k : ℕ) (y : Abelian.Ext P P₁ k)
        (c : Abelian.Ext (L.obj P₁) A 1),
        E P k ((Abelian.Ext.mapExactFunctor L y).comp c rfl) = ε k • y.comp (E P₁ 0 c) (add_zero k) := by
    intro T E εI hεI hnat hconn
    have hzs : ∀ {X Y Z : D} {a b c : ℕ} (α : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b) (h : a + b = c)
        (n : ℤ), α.comp (n • β) h = n • α.comp β h := by
      intro X Y Z a b c α β h n
      have := map_zsmul (Abelian.Ext.bilinearComp X Y Z a b c h α) n β
      simpa only [Abelian.Ext.bilinearComp_apply_apply] using this
    have G : ∀ k : ℕ, ∃ s : ℕ → ℤ, (∀ b, s b = 1 ∨ s b = -1) ∧ ∀ (b : ℕ) (P P₁ : D)
        (y : Abelian.Ext P P₁ k) (x : Abelian.Ext (L.obj P₁) A (b + 1)) (m : ℕ) (hm : k + b = m)
        (h' : k + (b + 1) = m + 1),
        E P m ((Abelian.Ext.mapExactFunctor L y).comp x h') = s b • y.comp (E P₁ b x) hm := by
      intro k
      induction k with
      | zero =>
        refine ⟨fun _ => 1, fun _ => Or.inl rfl, ?_⟩
        intro b P P₁ y x m hm h'
        obtain rfl : m = b := by omega
        obtain ⟨y₀, rfl⟩ : ∃ y₀, Abelian.Ext.mk₀ y₀ = y := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply y⟩
        rw [Abelian.Ext.mapExactFunctor_mk₀, one_smul]
        exact hnat P P₁ y₀ _ x
      | succ k ih =>
        obtain ⟨s, hs, hG⟩ := ih
        refine ⟨fun b => s (b + 1) * εI b, ?_, ?_⟩
        · intro b
          rcases hs (b + 1) with h1 | h1 <;> rcases hεI b with h2 | h2 <;> simp [h1, h2]
        intro b P P₁ y x m hm h'
        obtain ⟨Q, I', i, p, w, hS, y', rfl⟩ := s5 P P₁ k y
        rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
          Abelian.Ext.comp_assoc _ _ _ rfl (add_comm 1 (b + 1)) (show k + 1 + (b + 1) = m + 1 by omega),
