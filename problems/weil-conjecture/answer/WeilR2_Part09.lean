          (Scheme.Γ.obj (Opposite.op W.unop.left))).hom ((wcKaEs Y ℓ n D k s a hℓ W).hom x) =
        (x.1.1 : ℤ) • FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W) ∧
      ((Limits.pullback.snd (wcKtPsi.{u} ℓ D k)
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ D) wcKtGm.{u}))).app
          (Scheme.Γ.obj (Opposite.op W.unop.left))).hom ((wcKaEs Y ℓ n D k s a hℓ W).hom x) =
        TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
          (N := wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
