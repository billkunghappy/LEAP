    exact ⟨w', ShortComplex.ShortExact.mk' hE
      (Sheaf.mono_of_isLocallyInjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f))
      (Sheaf.epi_of_isLocallySurjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g))⟩



  have hjs : ∀ (V : Y.Etale) (S : Sieve V),
      (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) →
      S ∈ Scheme.smallEtaleTopology Y V := by
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hKumAlg : ∀ (m : ℕ), 0 < m → ∀ (R : Type u) [CommRing R], IsUnit ((m : ℕ) : R) →
      ∀ y : Rˣ, ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
        Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
        ∃ x : B, x ^ m = algebraMap R B (y : R) := by
    intro m hm R _ hmR y
    have hm0 : m ≠ 0 := Nat.pos_iff_ne_zero.mp hm
    set f : Polynomial R := Polynomial.X ^ m - Polynomial.C (y : R) with hf
    have hfm : f.Monic := Polynomial.monic_X_pow_sub_C (y : R) hm0
    obtain ⟨u, hu⟩ := (hmR.mul y.isUnit).exists_left_inv
    have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
        Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
      refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (m : R)), 1, ?_⟩
      have hd : Polynomial.derivative f = Polynomial.C (m : R) * Polynomial.X ^ (m - 1) := by
        rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero]
      have hX : Polynomial.X ^ (m - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ m :=
        pow_sub_one_mul hm0 Polynomial.X
      have hu' : Polynomial.C u * (Polynomial.C (m : R) * Polynomial.C (y : R)) = 1 := by
        rw [← map_mul, ← map_mul, hu, map_one]
      rw [hd, hf, pow_one]
      linear_combination hu' + (Polynomial.C u * Polynomial.C (m : R)) * hX
    let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
    have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
      (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
        ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
    have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
    have het : Algebra.Etale R (AdjoinRoot f) := Algebra.Etale.of_equiv e
    refine ⟨AdjoinRoot f, inferInstance, inferInstance, het, ?_, AdjoinRoot.root f, ?_⟩
    · rcases subsingleton_or_nontrivial R with hR | hR
      · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
        intro x
        exact isEmptyElim x
      · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
        let pb := AdjoinRoot.powerBasis' hfm
