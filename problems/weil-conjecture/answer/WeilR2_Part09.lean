          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U) y) (zero_add i) := by
      rw [hΨ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀_assoc]
    rw [F1] at s1
    rw [s1, hΨ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    exact congrArg (fun z => (Abelian.Ext.mk₀ (κ ≫
      ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a).map ε)).comp z
        (zero_add i)) (hRΓ N y).symm
  have hkey : ∀ z : Abelian.Ext Z
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj M) i,
      Ξ M' (Pe z) = c • Pe (Ξ M z) := by
    intro z
    rw [hPe z, hPe (Ξ M z), hΞ M', hΞ M, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, hΓφ, hmk, hcn, hcn,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, hφΓ]
    rfl

  refine ⟨Θe.toAddMonoidHom, Θe.bijective, fun y => ?_⟩
  show c • Θe ((Abelian.Ext.mk₀ Φ).comp y (zero_add i)) =
    (Abelian.Ext.mk₀ Φ).comp (Θe y) (zero_add i)
  apply (hΨbij M').1
  rw [map_nsmul, hΘe, hstar M y, hstar M' (Θe y), hΘe y, hkey]

theorem wc_glc_zmod_ses (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ) :
    ∃ (f : wcZModSheaf S (ℓ ^ k) ⟶ wcZModSheaf S (ℓ ^ (k + 1)))
      (g : wcZModSheaf S (ℓ ^ (k + 1)) ⟶ wcZModSheaf S ℓ)
      (f' : wcZModSheaf S ℓ ⟶ wcZModSheaf S (ℓ ^ (k + 1)))
      (p : wcZModSheaf S (ℓ ^ (k + 1)) ⟶ wcZModSheaf S (ℓ ^ k))
      (hfg : f ≫ g = 0) (hfp : f' ≫ p = 0),
      (ShortComplex.mk f g hfg).ShortExact ∧ (ShortComplex.mk f' p hfp).ShortExact ∧
      p ≫ f = ℓ • 𝟙 (wcZModSheaf S (ℓ ^ (k + 1))) :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap S φ hφ = wcContSheafMap S φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl



  have hred : ∀ (M d : ℕ) (hd : d ∣ M) (j : ℤ),
      (ZMod.castHom hd (ZMod d)).toAddMonoidHom (j : ZMod M) = (j : ZMod d) := by
    intro M d hd j
    show (ZMod.castHom hd (ZMod d)) (j : ZMod M) = _
    exact map_intCast _ j
  have arith : ∀ (N c M : ℕ), c ≠ 0 → ∀ (hcM : c ∣ M) (hNM : N ∣ M), M = N * c →
      ∃ φ : ZMod N →+ ZMod M, Function.Injective φ ∧
        (∀ b : ZMod M, (ZMod.castHom hcM (ZMod c)).toAddMonoidHom b = 0 ↔ ∃ a, φ a = b) ∧
        (∀ b : ZMod M, φ ((ZMod.castHom hNM (ZMod N)).toAddMonoidHom b) = c • b) := by
    intro N c M hc hcM hNM hM
    obtain ⟨φ, hφ⟩ : ∃ φ : ZMod N →+ ZMod M, ∀ j : ℤ,
        φ (j : ZMod N) = (j : ZMod M) * ((c : ℕ) : ZMod M) :=
      ⟨ZMod.lift N ⟨zmultiplesHom (ZMod M) ((c : ℕ) : ZMod M), by
          rw [zmultiplesHom_apply, natCast_zsmul, nsmul_eq_mul, ← Nat.cast_mul, ← hM]
          exact ZMod.natCast_self M⟩,
        fun j => by
          rw [ZMod.lift_coe]
          change zmultiplesHom (ZMod M) ((c : ℕ) : ZMod M) j = _
          rw [zmultiplesHom_apply, zsmul_eq_mul]⟩
    have hinj : Function.Injective φ := by
      intro a b hab
      obtain ⟨ka, rfl⟩ := ZMod.intCast_surjective a
      obtain ⟨kb, rfl⟩ := ZMod.intCast_surjective b
      rw [hφ, hφ] at hab
      have h1 : ((ka * (c : ℤ) : ℤ) : ZMod M) = ((kb * (c : ℤ) : ℤ) : ZMod M) := by
        push_cast at hab ⊢
        exact hab
      rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at h1
      rw [ZMod.intCast_eq_intCast_iff_dvd_sub]
      have hl : (c : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hc
      have e1 : kb * (c : ℤ) - ka * (c : ℤ) = (c : ℤ) * (kb - ka) := by ring
      have e2 : ((M : ℕ) : ℤ) = (c : ℤ) * (N : ℤ) := by rw [hM]; push_cast; ring
      rw [e1, e2] at h1
      exact Int.dvd_of_mul_dvd_mul_left hl h1
    refine ⟨φ, hinj, ?_, ?_⟩
    · intro b
      obtain ⟨kb, rfl⟩ := ZMod.intCast_surjective b
      rw [hred M c hcM, ZMod.intCast_zmod_eq_zero_iff_dvd]
      constructor
      · rintro ⟨j, hj⟩
        refine ⟨(j : ZMod N), ?_⟩
        rw [hφ, hj]
        push_cast
        ring
      · rintro ⟨a, ha⟩
        obtain ⟨j, rfl⟩ := ZMod.intCast_surjective a
        rw [hφ] at ha
        have h1 : ((j * (c : ℤ) : ℤ) : ZMod M) = (kb : ZMod M) := by
          push_cast at ha ⊢
          exact ha
        rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at h1
        have h2 : (c : ℤ) ∣ kb - j * (c : ℤ) := (Int.natCast_dvd_natCast.mpr hcM).trans h1
        have h3 : (c : ℤ) ∣ j * (c : ℤ) := Dvd.intro_left _ rfl
        have h4 := dvd_add h2 h3
        rwa [sub_add_cancel] at h4
    · intro b
      obtain ⟨j, rfl⟩ := ZMod.intCast_surjective b
      rw [hred M N hNM, hφ, nsmul_eq_mul]
      exact mul_comm _ _



  have hdvd₁ : ℓ ∣ ℓ ^ (k + 1) := dvd_pow_self ℓ (Nat.succ_ne_zero k)
  have hdvd₂ : ℓ ^ k ∣ ℓ ^ (k + 1) := pow_dvd_pow ℓ (Nat.le_succ k)
  obtain ⟨φ₁, hinj₁, hex₁, hcomp₁⟩ :=
    arith (ℓ ^ k) ℓ (ℓ ^ (k + 1)) hℓ0 hdvd₁ hdvd₂ (pow_succ ℓ k)
  obtain ⟨φ₂, hinj₂, hex₂, -⟩ :=
    arith ℓ (ℓ ^ k) (ℓ ^ (k + 1)) (pow_ne_zero k hℓ0) hdvd₂ hdvd₁ (pow_succ' ℓ k)
  have hs₁ : Function.Surjective (ZMod.castHom hdvd₁ (ZMod ℓ)).toAddMonoidHom :=
    ZMod.castHom_surjective hdvd₁
  have hs₂ : Function.Surjective (ZMod.castHom hdvd₂ (ZMod (ℓ ^ k))).toAddMonoidHom :=
    ZMod.castHom_surjective hdvd₂
  have hemb₁ : Topology.IsEmbedding φ₁ :=
    (Topology.IsOpenEmbedding.of_continuous_injective_isOpenMap continuous_of_discreteTopology
      hinj₁ (fun s _ => isOpen_discrete _)).isEmbedding
  have hemb₂ : Topology.IsEmbedding φ₂ :=
    (Topology.IsOpenEmbedding.of_continuous_injective_isOpenMap continuous_of_discreteTopology
      hinj₂ (fun s _ => isOpen_discrete _)).isEmbedding



  obtain ⟨hz₁, hS₁⟩ := wc_contSheaf_shortExact S φ₁ continuous_of_discreteTopology
    (ZMod.castHom hdvd₁ (ZMod ℓ)).toAddMonoidHom continuous_of_discreteTopology hemb₁ hex₁
    ⟨Function.surjInv hs₁, continuous_of_discreteTopology, Function.surjInv_eq hs₁⟩
  obtain ⟨hz₂, hS₂⟩ := wc_contSheaf_shortExact S φ₂ continuous_of_discreteTopology
    (ZMod.castHom hdvd₂ (ZMod (ℓ ^ k))).toAddMonoidHom continuous_of_discreteTopology hemb₂ hex₂
    ⟨Function.surjInv hs₂, continuous_of_discreteTopology, Function.surjInv_eq hs₂⟩



  have hmap_id : wcContSheafMap S (AddMonoidHom.id (ZMod (ℓ ^ (k + 1))))
      continuous_of_discreteTopology = 𝟙 (wcContSheaf S (ZMod (ℓ ^ (k + 1)))) := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro y
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    rfl
  have hsub : ∀ ψ ψ' : ZMod (ℓ ^ (k + 1)) →+ ZMod (ℓ ^ (k + 1)),
      wcContSheafMap S (ψ - ψ') continuous_of_discreteTopology =
        wcContSheafMap S ψ continuous_of_discreteTopology -
          wcContSheafMap S ψ' continuous_of_discreteTopology := by
    intro ψ ψ'
    exact (wc_contSheafMap_comp_sub S ψ ψ' continuous_of_discreteTopology
      continuous_of_discreteTopology (AddMonoidHom.id _) continuous_id).2
  have hmap0 : wcContSheafMap S (0 : ZMod (ℓ ^ (k + 1)) →+ ZMod (ℓ ^ (k + 1)))
      continuous_of_discreteTopology = 0 := by
    rw [hcongr (0 : ZMod (ℓ ^ (k + 1)) →+ ZMod (ℓ ^ (k + 1)))
      (AddMonoidHom.id _ - AddMonoidHom.id _) (sub_self _).symm continuous_of_discreteTopology
      continuous_of_discreteTopology, hsub, sub_self]
  have hneg : ∀ ψ : ZMod (ℓ ^ (k + 1)) →+ ZMod (ℓ ^ (k + 1)),
      wcContSheafMap S (-ψ) continuous_of_discreteTopology =
        -wcContSheafMap S ψ continuous_of_discreteTopology := by
    intro ψ
    rw [hcongr (-ψ) (0 - ψ) (zero_sub ψ).symm continuous_of_discreteTopology
      continuous_of_discreteTopology, hsub, hmap0, zero_sub]
  have hadd : ∀ ψ ψ' : ZMod (ℓ ^ (k + 1)) →+ ZMod (ℓ ^ (k + 1)),
      wcContSheafMap S (ψ + ψ') continuous_of_discreteTopology =
        wcContSheafMap S ψ continuous_of_discreteTopology +
          wcContSheafMap S ψ' continuous_of_discreteTopology := by
    intro ψ ψ'
    rw [hcongr (ψ + ψ') (ψ - -ψ') (sub_neg_eq_add ψ ψ').symm continuous_of_discreteTopology
      continuous_of_discreteTopology, hsub, hneg, sub_neg_eq_add]
  have hnsmul : ∀ n : ℕ, wcContSheafMap S (n • AddMonoidHom.id (ZMod (ℓ ^ (k + 1))))
      continuous_of_discreteTopology = n • 𝟙 (wcContSheaf S (ZMod (ℓ ^ (k + 1)))) := by
    intro n
    induction n with
    | zero =>
      rw [hcongr _ 0 (zero_nsmul (AddMonoidHom.id (ZMod (ℓ ^ (k + 1)))))
        continuous_of_discreteTopology continuous_of_discreteTopology, hmap0, zero_nsmul]
    | succ n ih =>
      rw [hcongr _ (n • AddMonoidHom.id (ZMod (ℓ ^ (k + 1))) + AddMonoidHom.id _)
        (succ_nsmul (AddMonoidHom.id (ZMod (ℓ ^ (k + 1)))) n)
        continuous_of_discreteTopology continuous_of_discreteTopology, hadd, ih, hmap_id,
        succ_nsmul]



  have e2 : φ₁.comp (ZMod.castHom hdvd₂ (ZMod (ℓ ^ k))).toAddMonoidHom =
      ℓ • AddMonoidHom.id (ZMod (ℓ ^ (k + 1))) := by
    apply AddMonoidHom.ext
    intro b
    first
      | exact hcomp₁ b
      | (rw [AddMonoidHom.comp_apply, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply]
         exact hcomp₁ b)
  have e1 := (wc_contSheafMap_comp_sub S (ZMod.castHom hdvd₂ (ZMod (ℓ ^ k))).toAddMonoidHom
    (ZMod.castHom hdvd₂ (ZMod (ℓ ^ k))).toAddMonoidHom continuous_of_discreteTopology
    continuous_of_discreteTopology φ₁ continuous_of_discreteTopology).1
  have hpf : wcContSheafMap S (ZMod.castHom hdvd₂ (ZMod (ℓ ^ k))).toAddMonoidHom
      continuous_of_discreteTopology ≫ wcContSheafMap S φ₁ continuous_of_discreteTopology =
      ℓ • 𝟙 (wcContSheaf S (ZMod (ℓ ^ (k + 1)))) :=
    e1.symm.trans ((hcongr _ _ e2 _ continuous_of_discreteTopology).trans (hnsmul ℓ))



  exact ⟨wcContSheafMap S φ₁ continuous_of_discreteTopology,
    wcContSheafMap S (ZMod.castHom hdvd₁ (ZMod ℓ)).toAddMonoidHom continuous_of_discreteTopology,
    wcContSheafMap S φ₂ continuous_of_discreteTopology,
    wcContSheafMap S (ZMod.castHom hdvd₂ (ZMod (ℓ ^ k))).toAddMonoidHom
      continuous_of_discreteTopology,
    hz₁, hz₂, hS₁, hS₂, hpf⟩

theorem wc_glc_local_succ_vanish (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (V₀ : X.left.ProEt) (ι₀ : V₀ ⟶ wcGeomPoint F X h)
    (hι₀ : IsOpenImmersion ι₀.left) (xb : (wcGeomPoint F X h).left)
    (hpt : Set.range ι₀.left = {xb}ᶜ) :
    ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀)) (wcZModSheaf X.left ℓ)
      (2 * d + 1), x = 0 :=
by
  classical

  have hne : Set.range ι₀.left ≠ Set.univ := by
    intro heq
    have hmem : xb ∈ Set.range ι₀.left := by rw [heq]; exact Set.mem_univ _
    rw [hpt] at hmem
    exact hmem rfl

  haveI := hι₀
  have hmono : Mono ι₀.left := inferInstance
  have hSE : (ShortComplex.mk (wcFreeSheafMap X.left ι₀)
      (Limits.cokernel.π (wcFreeSheafMap X.left ι₀)) (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _)
      (wc_free_sheaf_map_mono X.left V₀ (wcGeomPoint F X h) ι₀ hmono) inferInstance

  obtain ⟨ρ, hinj, hsurj, hρ⟩ := wc_root_twist_slice_presheaf_map F X ℓ hℓ h 1 d
  obtain ⟨ψ, hψiso, hψ⟩ := wc_slice_sheafify_scaled_iso X.left (wcGeomPoint F X h)
    (wcGeomFrob F X h) (wcRootTwistPre X.left (ℓ ^ 1) d) (wcZModSheaf X.left (ℓ ^ 1))
    ρ (Nat.card F ^ d) hinj hsurj hρ
  let ψ' : ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
      (wcGeomPoint F X h)).obj (wcRootTwist X.left (ℓ ^ 1) d) ⟶
      ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
      (wcGeomPoint F X h)).obj (wcZModSheaf X.left (ℓ ^ 1)) := ψ
  have hψiso' : IsIso ψ' := hψiso
  have hψ' : ∀ V : Over (wcGeomPoint F X h),
      ψ'.hom.app (Opposite.op (Over.mk (V.hom ≫ wcGeomFrob F X h))) =
        (Nat.card F ^ d) • ψ'.hom.app (Opposite.op V) := hψ

  have hcont : ∀ z : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcZModSheaf X.left (ℓ ^ 1)) (2 * d + 1), z = 0 := by
    intro z
    have hA : ∀ a : ZMod (ℓ ^ 1), ∃ k : ℕ, ℓ ^ k • a = 0 := by
      intro a
      refine ⟨1, ?_⟩
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    exact wc_coh_torsion_vanishing F X d ℓ hℓ h (ZMod (ℓ ^ 1)) hA (2 * d + 1) (by omega) z
  obtain ⟨Φ, hΦbij, -⟩ := wc_slice_ext_frob_transport X.left (wcGeomPoint F X h)
    (wcGeomFrob F X h) (wcRootTwist X.left (ℓ ^ 1) d) (wcZModSheaf X.left (ℓ ^ 1)) ψ'
    (Nat.card F ^ d) hψiso' hψ' (2 * d + 1)
  have hglob : ∀ y : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ 1) d) (2 * d + 1), y = 0 := by
    intro y
    apply hΦbij.injective
    rw [hcont (Φ y), map_zero]

  have hmid : ∀ x₃ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
      (wcRootTwist X.left (ℓ ^ 1) d) (2 * d + 1), x₃ = 0 := by
    intro x₃
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hSE
      (wcRootTwist X.left (ℓ ^ 1) d) x₃ (hglob _) (n₀ := 2 * d) (by omega)
    have h1 : x₁ = 0 := wc_rpc_open_top_vanishing F X d ℓ hℓ h 1 V₀ ι₀ hι₀ hne x₁
    rw [← hx₁, h1, Abelian.Ext.comp_zero]

  have hψ1 : ∀ W : Over (wcGeomPoint F X h),
      ψ'.hom.app (Opposite.op (Over.mk (W.hom ≫ 𝟙 (wcGeomPoint F X h)))) =
        1 • ψ'.hom.app (Opposite.op W) := by
    intro W
    let g : Over.mk (W.hom ≫ 𝟙 (wcGeomPoint F X h)) ⟶ W :=
      Over.homMk (U := Over.mk (W.hom ≫ 𝟙 (wcGeomPoint F X h))) (V := W) (𝟙 W.left) (by simp)
    have hn := ψ'.hom.naturality g.op
    have e1 : (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint F X h)).obj (wcRootTwist X.left (ℓ ^ 1) d)).obj.map g.op = 𝟙 _ :=
      (wcRootTwist X.left (ℓ ^ 1) d).obj.map_id (Opposite.op W.left)
    have e2 : (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint F X h)).obj (wcZModSheaf X.left (ℓ ^ 1))).obj.map g.op = 𝟙 _ :=
      (wcZModSheaf X.left (ℓ ^ 1)).obj.map_id (Opposite.op W.left)
    rw [e1, e2] at hn
    have key : ψ'.hom.app (Opposite.op (Over.mk (W.hom ≫ 𝟙 (wcGeomPoint F X h)))) =
        ψ'.hom.app (Opposite.op W) := by
      first
        | exact (Category.id_comp _).symm.trans (hn.trans (Category.comp_id _))
        | (erw [Category.id_comp, Category.comp_id] at hn; exact hn)
        | simpa using hn
    first
      | exact key.trans (one_smul ℕ _).symm
      | (rw [key]; exact (one_smul ℕ _).symm)
      | (erw [one_smul]; exact key)
  have hid : wcFreeSheafMap X.left (𝟙 (wcGeomPoint F X h)) = 𝟙 _ := by
    first
      | (unfold wcFreeSheafMap
         rw [CategoryTheory.Functor.map_id yoneda, Functor.whiskerRight_id',
           CategoryTheory.Functor.map_id]; rfl)
      | (unfold wcFreeSheafMap
         rw [CategoryTheory.Functor.map_id yoneda, Functor.whiskerRight_id',
           CategoryTheory.Functor.map_id])
      | simp [wcFreeSheafMap, wcFreeSheaf]
  have hΦid : Limits.cokernel.π (wcFreeSheafMap X.left ι₀) ≫ 𝟙 _ =
      wcFreeSheafMap X.left (𝟙 (wcGeomPoint F X h)) ≫
        Limits.cokernel.π (wcFreeSheafMap X.left ι₀) := by
    rw [hid, Category.comp_id, Category.id_comp]
  obtain ⟨Θ, hΘ, -⟩ := wc_lfi_coker_scaled_transport X.left (wcGeomPoint F X h) V₀ ι₀ (𝟙 _) (𝟙 _)
    (by rw [Category.id_comp, Category.comp_id]) (𝟙 _) hΦid (wcRootTwist X.left (ℓ ^ 1) d)
    (wcZModSheaf X.left (ℓ ^ 1)) ψ' 1 hψiso' hψ1 (2 * d + 1)
  have hlev : ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
      (wcZModSheaf X.left (ℓ ^ 1)) (2 * d + 1), z = 0 := by
    intro z
    obtain ⟨x₃, rfl⟩ := hΘ.2 z
    rw [hmid x₃, map_zero]

  rw [pow_one] at hlev
  exact hlev

theorem wc_lfi_point_excision (S : Scheme.{u}) (U V T VT : S.ProEt) (ι : V ⟶ U)
    (hι : IsOpenImmersion ι.left) (x : U.left) (hr : Set.range ι.left = {x}ᶜ)
    (g : T ⟶ U) (j : VT ⟶ T) (hj : IsOpenImmersion j.left)
    (hrj : Set.range j.left = g.left ⁻¹' {x}ᶜ) (gV : VT ⟶ V) (hgV : gV ≫ ι = j ≫ g)
    (hfib : IsIso (Limits.pullback.snd g.left (U.left.fromSpecResidueField x)))
    (hT : CompactSpace T.left) (hqs : QuasiSeparatedSpace U.left) (hln : IsLocallyNoetherian U.left) :
    ∃ κ : Limits.cokernel (wcFreeSheafMap S j) ⟶ Limits.cokernel (wcFreeSheafMap S ι),
      IsIso κ ∧
      Limits.cokernel.π (wcFreeSheafMap S j) ≫ κ =
        wcFreeSheafMap S g ≫ Limits.cokernel.π (wcFreeSheafMap S ι) :=
by
  classical

  obtain ⟨e, he0, hen⟩ : ∃ e : ∀ (W : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        (wcFreeSheaf S W ⟶ G) ≃ G.obj.obj (Opposite.op W),
      (∀ (W : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}), e W G 0 = 0) ∧
      (∀ {W W' : S.ProEt} (f : W ⟶ W') (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (φ : wcFreeSheaf S W' ⟶ G),
        e W G (wcFreeSheafMap S f ≫ φ) = G.obj.map f.op (e W' G φ)) := by

    let adj := sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
    let adjW := Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}
    let e2 : ∀ (W : S.ProEt) (G : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}),
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op W) :=
      fun W G => (adjW.homEquiv (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := W) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    let e : ∀ (W : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        (wcFreeSheaf S W ⟶ G) ≃ G.obj.obj (Opposite.op W) := fun W G =>
      (adj.homEquiv (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans (e2 W G.obj)
    have hnat2 : ∀ (W : S.ProEt) (G G' : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
        (h : yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 W G' (h ≫ ψ) = ψ.app (Opposite.op W) (e2 W G h) := by
      intro W G G' ψ h
      have hW := adjW.homEquiv_naturality_right (X := yoneda.obj W ⋙ uliftFunctor.{u+1, u}) h ψ
      have hY := uliftYonedaEquiv_comp.{u+1}
        (adjW.homEquiv (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) G h)
        (((Functor.whiskeringRight S.ProEtᵒᵖ AddCommGrpCat.{u+1} (Type (u+1))).obj
            (forget AddCommGrpCat.{u+1})).map ψ)
      exact (congrArg (uliftYonedaEquiv.{u+1} (X := W) (F := G' ⋙ forget AddCommGrpCat.{u+1})) hW).trans hY
    have hnat : ∀ (W : S.ProEt) (F F' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (φ : F ⟶ F') (g : wcFreeSheaf S W ⟶ F), e W F' (g ≫ φ) = φ.hom.app (Opposite.op W) (e W F g) := by
      intro W F F' φ g
      have hA := adj.homEquiv_naturality_right
        (X := yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) g φ
      exact (congrArg (e2 W F'.obj) hA).trans (hnat2 W F.obj F'.obj φ.hom _)
    refine ⟨e, fun W F => ?_, fun {W W'} f G φ => ?_⟩
    · have h1 := hnat W F F 0 0
      rw [Limits.zero_comp] at h1
      rw [h1]
      have h0 : (0 : F ⟶ F).hom = 0 :=
        (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_zero F F
      rw [h0, NatTrans.app_zero]
      rfl
    · let α := Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      let β : uliftYoneda.{u+1}.obj W ⟶ uliftYoneda.{u+1}.obj W' := uliftYoneda.{u+1}.map f
      have e1 : adj.homEquiv _ G (wcFreeSheafMap S f ≫ φ) = α ≫ adj.homEquiv _ G φ :=
        adj.homEquiv_naturality_left α φ
      have hsrc2 : ∀ (P : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1})
          (h : yoneda.obj W' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ P),
          e2 W P (α ≫ h) = P.map f.op (e2 W' P h) := by
        intro P h
        have e3 := adjW.homEquiv_naturality_left β h
        have e4 := uliftYonedaEquiv_naturality.{u+1} (adjW.homEquiv _ P h) f.op
        exact (congrArg uliftYonedaEquiv.{u+1} e3).trans e4.symm
      calc e W G (wcFreeSheafMap S f ≫ φ)
          = e2 W G.obj (adj.homEquiv _ G (wcFreeSheafMap S f ≫ φ)) := rfl
        _ = e2 W G.obj (α ≫ adj.homEquiv _ G φ) := congrArg (e2 W G.obj) e1
        _ = G.obj.map f.op (e2 W' G.obj (adj.homEquiv _ G φ)) := hsrc2 _ _
        _ = G.obj.map f.op (e W' G φ) := rfl

  have hs3 : ∀ (Y A B : S.ProEt) (p : A ⟶ Y) (q : B ⟶ Y)
      (hp : IsOpenImmersion p.left) (hpqc : QuasiCompact p.left) (y₀ : Y.left)
      (hy₀ : y₀ ∈ Set.range q.left) (hcomp : ∀ y : Y.left, y ∈ Set.range p.left ∨ y = y₀)
      (R : Sieve Y) (hRp : R.arrows p) (hRq : R.arrows q),
      R ∈ Scheme.ProEt.topology S Y := by
    intro Y A B p q hp hpqc y₀ hy₀ hcomp R hRp hRq
    let W' : ULift.{u+1} Bool → S.ProEt := fun i => Bool.rec B A i.down
    let f : ∀ i, W' i ⟶ Y := fun i => Bool.rec (motive := fun b => W' ⟨b⟩ ⟶ Y) q p i.down
    have hcov : ∀ y : ↥Y.left, ∃ (i : ULift.{u+1} Bool) (z : ↥(W' i).left), (f i).left z = y := by
      intro y
      rcases hcomp y with ⟨a, ha⟩ | rfl
      · exact ⟨⟨true⟩, a, ha⟩
      · obtain ⟨b, hb⟩ := hy₀
        exact ⟨⟨false⟩, b, hb⟩
    have hwe : ∀ i, WeaklyEtale (f i).left := by
      intro i
      haveI := (W' i).prop
      haveI := Y.prop
      haveI : WeaklyEtale ((f i).left ≫ Y.hom) := by
        rw [MorphismProperty.Over.w (f i)]; exact (W' i).prop
      exact WeaklyEtale.of_comp _ Y.hom
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) Y.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} Bool)
        (fun i => (W' i).left) (fun i => (f i).left) hcov hwe
    have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover := by
      rw [quasiCompactCover_iff]
      intro O hO
      have hcA : IsCompact ((p.left ⁻¹ᵁ O : A.left.Opens) : Set A.left) :=
        QuasiCompact.isCompact_preimage _ O.isOpen hO.isCompact
      by_cases hy : y₀ ∈ O
      · obtain ⟨b, hb⟩ := hy₀
        have hbO : b ∈ q.left ⁻¹ᵁ O := by
          show q.left b ∈ O; rw [hb]; exact hy
        obtain ⟨Wb, hWa, hbW, hWsub⟩ := exists_isAffineOpen_mem_and_subset hbO
        refine IsCompactOpenCovered.of_finite (κ := Bool) (fun b => (⟨b⟩ : ULift.{u+1} Bool))
          (fun k => Bool.rec (motive := fun b => TopologicalSpace.Opens (𝒰.X ⟨b⟩))
            Wb (p.left ⁻¹ᵁ O) k) ?_ ?_
        · intro k
          cases k
          · exact hWa.isCompact
          · exact hcA
        · ext y
          simp only [Set.mem_iUnion, Set.mem_image]
          constructor
          · rintro ⟨k, z, hz, rfl⟩
            cases k
            · have hz' : z ∈ q.left ⁻¹ᵁ O := hWsub hz
              exact hz'
            · exact hz
          · intro hyO
            rcases hcomp y with ⟨a, rfl⟩ | rfl
            · exact ⟨true, a, hyO, rfl⟩
            · exact ⟨false, b, hbW, hb⟩
      · refine IsCompactOpenCovered.of_finite (κ := Unit) (fun _ => (⟨true⟩ : ULift.{u+1} Bool))
          (fun _ => (p.left ⁻¹ᵁ O : A.left.Opens)) (fun _ => hcA) ?_
        ext y
        simp only [Set.mem_iUnion, Set.mem_image, exists_const]
        constructor
        · rintro ⟨z, hz, rfl⟩
          exact hz
        · intro hyO
          rcases hcomp y with ⟨a, rfl⟩ | rfl
          · exact ⟨a, hyO, rfl⟩
          · exact absurd hyO hy
    have hRb : Presieve.ofArrows (fun i => (W' i).left) (fun i => (f i).left) ∈
        Scheme.proetalePrecoverage.coverings Y.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget S ⋙ Over.forget S) (Y := W') f
    have hR' : Presieve.ofArrows W' f ∈ (Scheme.ProEt.precoverage S).coverings Y :=
      Precoverage.mem_comap_iff.mpr (e ▸ hRb)
    have hRJ : Sieve.generate (Presieve.ofArrows W' f) ∈ (Scheme.ProEt.topology S) Y :=
      Precoverage.generate_mem_toGrothendieck hR'
    refine (Scheme.ProEt.topology S).superset_covering ?_ hRJ
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    rcases i with ⟨_ | _⟩
    · exact hRq
    · exact hRp

  have hs4 : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (Y A B : S.ProEt) (p : A ⟶ Y) (q : B ⟶ Y)
      (hcov : ∀ R : Sieve Y, R.arrows p → R.arrows q → R ∈ Scheme.ProEt.topology S Y),
      (∀ s s' : G.obj.obj (Opposite.op Y), G.obj.map p.op s = G.obj.map p.op s' →
          G.obj.map q.op s = G.obj.map q.op s' → s = s') ∧
      (∀ (sA : G.obj.obj (Opposite.op A)) (sB : G.obj.obj (Opposite.op B)),
        (∀ (Z : S.ProEt) (u v : Z ⟶ A), u ≫ p = v ≫ p → G.obj.map u.op sA = G.obj.map v.op sA) →
        (∀ (Z : S.ProEt) (u : Z ⟶ A) (v : Z ⟶ B), u ≫ p = v ≫ q →
          G.obj.map u.op sA = G.obj.map v.op sB) →
        (∀ (Z : S.ProEt) (u v : Z ⟶ B), u ≫ q = v ≫ q → G.obj.map u.op sB = G.obj.map v.op sB) →
        ∃ s : G.obj.obj (Opposite.op Y), G.obj.map p.op s = sA ∧ G.obj.map q.op s = sB) := by
    intro G Y A B p q hcov
    let W' : ULift.{u+1} Bool → S.ProEt := fun i => Bool.rec B A i.down
    let f : ∀ i, W' i ⟶ Y := fun i => Bool.rec (motive := fun b => W' ⟨b⟩ ⟶ Y) q p i.down
    have hR : Sieve.generate (Presieve.ofArrows W' f) ∈ Scheme.ProEt.topology S Y :=
      hcov _ ⟨_, 𝟙 _, f ⟨true⟩, Presieve.ofArrows.mk (Y := W') (f := f) ⟨true⟩, Category.id_comp _⟩
        ⟨_, 𝟙 _, f ⟨false⟩, Presieve.ofArrows.mk (Y := W') (f := f) ⟨false⟩, Category.id_comp _⟩
    have hG : Presieve.IsSheaf (Scheme.ProEt.topology S) (G.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) G.obj
          (forget AddCommGrpCat.{u+1})).mp G.cond)
    have hSF := (Presieve.isSheafFor_arrows_iff _ f).mp (hG.isSheafFor _ hR)
    refine ⟨fun s s' h1 h2 => ?_, fun sA sB hAA hAB hBB => ?_⟩
    · obtain ⟨t, _, huniq⟩ := hSF (fun i => G.obj.map (f i).op s) (by
        intro i j Z gi gj h
        change G.obj.map gi.op (G.obj.map (f i).op s) = G.obj.map gj.op (G.obj.map (f j).op s)
        rw [← CategoryTheory.comp_apply, ← Functor.map_comp, ← op_comp, h, op_comp, Functor.map_comp,
          CategoryTheory.comp_apply])
      have e1 := huniq s (fun i => rfl)
      have e2 := huniq s' (fun i => by
        rcases i with ⟨_ | _⟩
        · exact h2.symm
        · exact h1.symm)
      rw [e1, e2]
    · obtain ⟨t, ht, _⟩ := hSF
        (fun i => Bool.rec (motive := fun b => (G.obj ⋙ forget AddCommGrpCat.{u+1}).obj
          (Opposite.op (W' ⟨b⟩))) sB sA i.down) (by
        intro i j Z gi gj h
        rcases i with ⟨_ | _⟩ <;> rcases j with ⟨_ | _⟩
        · exact hBB Z gi gj h
        · exact (hAB Z gj gi h.symm).symm
        · exact hAB Z gi gj h
        · exact hAA Z gi gj h)
      exact ⟨t, ht ⟨true⟩, ht ⟨false⟩⟩

  have hs5 : ∀ (T U : Scheme.{u}) (g : T ⟶ U) (x : U)
      (hfib : IsIso (Limits.pullback.snd g (U.fromSpecResidueField x))),
      (∃ t₀ : T, ∀ t : T, g t = x ↔ t = t₀) ∧
      ∀ w : ↥(Limits.pullback g g), g (Limits.pullback.fst g g w) = x →
        w ∈ Set.range (Limits.pullback.diagonal g) := by
    intro T U g x hfib
    haveI := hfib
    have hsub : Subsingleton ↥(Limits.pullback g (U.fromSpecResidueField x)) :=
      (Scheme.Hom.homeomorph (Limits.pullback.snd g (U.fromSpecResidueField x))).injective.subsingleton
    have hxr : x ∈ Set.range (U.fromSpecResidueField x) := by
      rw [Scheme.range_fromSpecResidueField]; rfl
    obtain ⟨k, hk⟩ := hxr
    let p₀ := (Scheme.Hom.homeomorph (Limits.pullback.snd g (U.fromSpecResidueField x))).symm k
    have hpt : ∀ p : ↥(Limits.pullback g (U.fromSpecResidueField x)),
        g (Limits.pullback.fst g (U.fromSpecResidueField x) p) = x := by
      intro p
      have h1 := congrArg (fun φ : (Limits.pullback g (U.fromSpecResidueField x)) ⟶ U => φ p)
        (Limits.pullback.condition (f := g) (g := U.fromSpecResidueField x))
      simp only [Scheme.Hom.comp_apply] at h1
      rw [h1]
      have h2 : (U.fromSpecResidueField x) (Limits.pullback.snd g (U.fromSpecResidueField x) p) ∈
          Set.range (U.fromSpecResidueField x) := ⟨_, rfl⟩
      rw [Scheme.range_fromSpecResidueField] at h2
      exact h2
    refine ⟨⟨Limits.pullback.fst g (U.fromSpecResidueField x) p₀, fun t => ⟨fun ht => ?_, fun ht => ?_⟩⟩, ?_⟩
    · have hm : t ∈ Set.range (Limits.pullback.fst g (U.fromSpecResidueField x)) := by
        rw [Scheme.Pullback.range_fst, Scheme.range_fromSpecResidueField]; exact ht
      obtain ⟨p, rfl⟩ := hm
      rw [Subsingleton.elim p p₀]
    · rw [ht]; exact hpt p₀
    · intro w hw
      have hw' : (Limits.pullback.fst g g ≫ g) w = x := by
        rw [Scheme.Hom.comp_apply]; exact hw
      let kk := Spec.map (Scheme.Hom.residueFieldMap (Limits.pullback.fst g g ≫ g) w) ≫
        Spec.map (Scheme.residueFieldCongr hw'.symm).hom
      have hkk : kk ≫ U.fromSpecResidueField x =
          (Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.fst g g ≫ g := by
        simp only [kk, Category.assoc, Scheme.residueFieldCongr_fromSpecResidueField,
          Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
      have hα : ((Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.fst g g) ≫ g =
          kk ≫ U.fromSpecResidueField x := by rw [hkk, Category.assoc]
      have hβ : ((Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.snd g g) ≫ g =
          kk ≫ U.fromSpecResidueField x := by
        rw [hkk, Category.assoc, ← Limits.pullback.condition]
      have hl : Limits.pullback.lift _ _ hα = Limits.pullback.lift _ _ hβ := by
        rw [← cancel_mono (Limits.pullback.snd g (U.fromSpecResidueField x))]
        simp only [Limits.pullback.lift_snd]
      have hαβ : (Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.fst g g =
          (Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.snd g g := by
        have := congrArg (fun φ => φ ≫ Limits.pullback.fst g (U.fromSpecResidueField x)) hl
        simpa only [Limits.pullback.lift_fst] using this
      have hdiag : (Limits.pullback g g).fromSpecResidueField w =
          ((Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.fst g g) ≫
            Limits.pullback.diagonal g := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
        · rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id, hαβ]
      have hwr : w ∈ Set.range ((Limits.pullback g g).fromSpecResidueField w) := by
        rw [Scheme.range_fromSpecResidueField]; rfl
      obtain ⟨q, hq⟩ := hwr
      refine ⟨((Limits.pullback g g).fromSpecResidueField w ≫ Limits.pullback.fst g g) q, ?_⟩
      rw [← Scheme.Hom.comp_apply, ← hdiag, hq]
  obtain ⟨⟨t₀, ht₀⟩, hdiag⟩ := hs5 T.left U.left g.left x hfib

  have hιqc : QuasiCompact ι.left := by
    haveI := hln
    haveI := hι
    rw [← Scheme.Hom.isoOpensRange_hom_ι ι.left]; infer_instance

  have hs7 : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (t : G.obj.obj (Opposite.op T)),
      G.obj.map j.op t = 0 → ∀ (Z : S.ProEt) (v : Z ⟶ T),
      (∀ z : Z.left, g.left (v.left z) ≠ x) → G.obj.map v.op t = 0 := by
    intro G t ht Z v hv
    have H : Set.range v.left ⊆ Set.range j.left := by
      rintro _ ⟨z, rfl⟩
      rw [hrj]; exact hv z
    let l := IsOpenImmersion.lift j.left v.left H
    have hl : l ≫ j.left = v.left := IsOpenImmersion.lift_fac _ _ H
    have hlw : l ≫ VT.hom = Z.hom := by
      rw [← MorphismProperty.Over.w j, ← Category.assoc, hl, MorphismProperty.Over.w v]
    let l' : Z ⟶ VT := MorphismProperty.Over.homMk l hlw trivial
    have hl' : l' ≫ j = v := MorphismProperty.Over.Hom.ext hl
    rw [← hl', op_comp, Functor.map_comp, CategoryTheory.comp_apply, ht, map_zero]
  have hAB : ∀ (Z : S.ProEt) (u : Z ⟶ V) (v : Z ⟶ T), u ≫ ι = v ≫ g →
      ∀ z : Z.left, g.left (v.left z) ≠ x := by
    intro Z u v huv z
    intro hz
    have h1 : (u.left ≫ ι.left) z = (v.left ≫ g.left) z := by
      have h := congrArg (fun φ => φ.left) huv
      exact congrArg (fun φ : Z.left ⟶ U.left => φ z) h
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
    have h2 : ι.left (u.left z) ∈ Set.range ι.left := ⟨_, rfl⟩
    rw [hr, h1] at h2
    exact h2 hz

  have hs8 : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (hsep : ∀ (Y A B : S.ProEt) (p : A ⟶ Y) (q : B ⟶ Y) (y₀ : Y.left),
        IsOpenImmersion p.left → QuasiCompact p.left → y₀ ∈ Set.range q.left →
        (∀ y : Y.left, y ∈ Set.range p.left ∨ y = y₀) →
        ∀ s s' : G.obj.obj (Opposite.op Y), G.obj.map p.op s = G.obj.map p.op s' →
          G.obj.map q.op s = G.obj.map q.op s' → s = s')
      (t : G.obj.obj (Opposite.op T))
      (hvan : ∀ (Z : S.ProEt) (v : Z ⟶ T), (∀ z : Z.left, g.left (v.left z) ≠ x) →
        G.obj.map v.op t = 0)
      (Z : S.ProEt) (a b : Z ⟶ T) (hab : a ≫ g = b ≫ g),
      G.obj.map a.op t = G.obj.map b.op t := by
    intro G hsep t hvan Z a b hab
    haveI := hι
    haveI := hln
    haveI := T.prop
    haveI := U.prop
    haveI : WeaklyEtale (g.left ≫ U.hom) := by
      rw [MorphismProperty.Over.w g]; exact T.prop
    haveI : WeaklyEtale g.left := WeaklyEtale.of_comp _ U.hom
    let P : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst g.left g.left ≫ T.hom)
    have hcond : Limits.pullback.snd g.left g.left ≫ T.hom = Limits.pullback.fst g.left g.left ≫ T.hom := by
      rw [← MorphismProperty.Over.w g, ← Category.assoc, ← Limits.pullback.condition, Category.assoc]
    let p₁ : P ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.fst g.left g.left) rfl trivial
    let p₂ : P ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.snd g.left g.left) hcond trivial
    have hΔw : Limits.pullback.diagonal g.left ≫ (Limits.pullback.fst g.left g.left ≫ T.hom) = T.hom := by
      rw [← Category.assoc, Limits.pullback.diagonal_fst, Category.id_comp]
    let Δ : T ⟶ P := MorphismProperty.Over.homMk (Limits.pullback.diagonal g.left) hΔw trivial
    have hΔ1 : Δ ≫ p₁ = 𝟙 T := MorphismProperty.Over.Hom.ext (Limits.pullback.diagonal_fst g.left)
    have hΔ2 : Δ ≫ p₂ = 𝟙 T := MorphismProperty.Over.Hom.ext (Limits.pullback.diagonal_snd g.left)
    have hab' : a.left ≫ g.left = b.left ≫ g.left := congrArg (fun φ => φ.left) hab
    have hhw : Limits.pullback.lift a.left b.left hab' ≫ (Limits.pullback.fst g.left g.left ≫ T.hom) =
        Z.hom := by
      rw [← Category.assoc, Limits.pullback.lift_fst, MorphismProperty.Over.w a]
    let h : Z ⟶ P := MorphismProperty.Over.homMk (Limits.pullback.lift a.left b.left hab') hhw trivial
    have hh1 : h ≫ p₁ = a := MorphismProperty.Over.Hom.ext (Limits.pullback.lift_fst _ _ _)
    have hh2 : h ≫ p₂ = b := MorphismProperty.Over.Hom.ext (Limits.pullback.lift_snd _ _ _)
    have hmap : ∀ {X Y W : S.ProEt} (f₁ : X ⟶ Y) (f₂ : Y ⟶ W) (s : G.obj.obj (Opposite.op W)),
        G.obj.map (f₁ ≫ f₂).op s = G.obj.map f₁.op (G.obj.map f₂.op s) := by
      intro X Y W f₁ f₂ s
      rw [op_comp, Functor.map_comp, CategoryTheory.comp_apply]
    suffices hP : G.obj.map p₁.op t = G.obj.map p₂.op t by
      rw [← hh1, ← hh2, hmap, hmap, hP]

    let hO := Limits.pullback.fst g.left g.left ≫ g.left
    let O : (Limits.pullback g.left g.left).Opens := hO ⁻¹ᵁ ι.left.opensRange
    haveI := P.prop
    let A : S.ProEt := Scheme.ProEt.mk (O.ι ≫ Limits.pullback.fst g.left g.left ≫ T.hom)
    let p : A ⟶ P := MorphismProperty.Over.homMk (A := A) (B := P) O.ι rfl trivial
    have hpqc : QuasiCompact p.left :=
      MorphismProperty.of_isPullback (P := @QuasiCompact)
        (isPullback_morphismRestrict hO ι.left.opensRange) inferInstance
    have hpoi : IsOpenImmersion p.left := by
      show IsOpenImmersion O.ι; infer_instance
    have hOmem : ∀ y : ↥(Limits.pullback g.left g.left), y ∈ O ↔
        g.left (Limits.pullback.fst g.left g.left y) ≠ x := by
      intro y
      show hO y ∈ (ι.left.opensRange : Set U.left) ↔ _
      rw [Scheme.Hom.coe_opensRange, hr]
      show (Limits.pullback.fst g.left g.left ≫ g.left) y ≠ x ↔ _
      rw [Scheme.Hom.comp_apply]
    have hsnd : ∀ y : ↥(Limits.pullback g.left g.left),
        g.left (Limits.pullback.snd g.left g.left y) = g.left (Limits.pullback.fst g.left g.left y) := by
      intro y
      have h1 := congrArg (fun φ : (Limits.pullback g.left g.left) ⟶ U.left => φ y)
        (Limits.pullback.condition (f := g.left) (g := g.left))
      simp only [Scheme.Hom.comp_apply] at h1
      exact h1.symm
    apply hsep P A T p Δ (Δ.left t₀) hpoi hpqc ⟨t₀, rfl⟩
    · intro y
      by_cases hy : g.left (Limits.pullback.fst g.left g.left y) = x
      · right
        obtain ⟨t', rfl⟩ := hdiag y hy
        have hfd : Limits.pullback.fst g.left g.left (Limits.pullback.diagonal g.left t') = t' := by
          rw [← Scheme.Hom.comp_apply, Limits.pullback.diagonal_fst]; rfl
        rw [hfd] at hy
        rw [(ht₀ t').mp hy]
        rfl
      · left
        have hyO : y ∈ O := (hOmem y).mpr hy
        show y ∈ Set.range O.ι
        rw [Scheme.Opens.range_ι]
        exact hyO
    · rw [← hmap, ← hmap]
      rw [hvan A (p ≫ p₁), hvan A (p ≫ p₂)]
      · intro z
        show g.left (Limits.pullback.snd g.left g.left (O.ι z)) ≠ x
        rw [hsnd]
        exact (hOmem (O.ι z)).mp (by
          have : O.ι z ∈ Set.range O.ι := ⟨z, rfl⟩
          rw [Scheme.Opens.range_ι] at this; exact this)
      · intro z
        show g.left (Limits.pullback.fst g.left g.left (O.ι z)) ≠ x
        exact (hOmem (O.ι z)).mp (by
          have : O.ι z ∈ Set.range O.ι := ⟨z, rfl⟩
          rw [Scheme.Opens.range_ι] at this; exact this)
    · rw [← hmap, ← hmap, hΔ1, hΔ2]

  have hsepG : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (Y A B : S.ProEt) (p : A ⟶ Y) (q : B ⟶ Y) (y₀ : Y.left),
      IsOpenImmersion p.left → QuasiCompact p.left → y₀ ∈ Set.range q.left →
      (∀ y : Y.left, y ∈ Set.range p.left ∨ y = y₀) →
      ∀ s s' : G.obj.obj (Opposite.op Y), G.obj.map p.op s = G.obj.map p.op s' →
        G.obj.map q.op s = G.obj.map q.op s' → s = s' := by
    intro G Y A B p q y₀ hp hpqc hy₀ hc
    exact (hs4 G Y A B p q (fun R hRp hRq => hs3 Y A B p q hp hpqc y₀ hy₀ hc R hRp hRq)).1
  have hcovU : ∀ R : Sieve U, R.arrows ι → R.arrows g → R ∈ Scheme.ProEt.topology S U := by
    intro R hRp hRq
    refine hs3 U V T ι g hι hιqc x ⟨t₀, (ht₀ t₀).mpr rfl⟩ (fun y => ?_) R hRp hRq
    by_cases hy : y = x
    · exact Or.inr hy
    · left
      rw [hr]
      exact hy
  have hinj : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (s : G.obj.obj (Opposite.op U)),
      G.obj.map ι.op s = 0 → G.obj.map g.op s = 0 → s = 0 := by
    intro G s h1 h2
    exact (hs4 G U V T ι g hcovU).1 s 0 (by rw [h1, map_zero]) (by rw [h2, map_zero])
  have hsurj : ∀ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (t : G.obj.obj (Opposite.op T)), G.obj.map j.op t = 0 →
      ∃ s : G.obj.obj (Opposite.op U), G.obj.map ι.op s = 0 ∧ G.obj.map g.op s = t := by
    intro G t ht
    refine (hs4 G U V T ι g hcovU).2 0 t ?_ ?_ ?_
    · intro Z u v _
      rw [map_zero, map_zero]
    · intro Z u v huv
      rw [map_zero]
      exact (hs7 G t ht Z v (hAB Z u v huv)).symm
    · intro Z u v huv
      exact hs8 G (hsepG G) t (hs7 G t ht) Z u v huv

  have hfun : ∀ {A B C : S.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap S a ≫ wcFreeSheafMap S b = wcFreeSheafMap S (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      first
        | rw [yoneda.map_comp, Functor.whiskerRight_comp]
        | (apply NatTrans.ext; funext V; simp [← Functor.map_comp])
    exact ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map e)
  have hw : wcFreeSheafMap S j ≫ (wcFreeSheafMap S g ≫ Limits.cokernel.π (wcFreeSheafMap S ι)) = 0 := by
    rw [← Category.assoc, hfun, ← hgV, ← hfun, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero]
  obtain ⟨κ, hκ⟩ : ∃ κ : Limits.cokernel (wcFreeSheafMap S j) ⟶ Limits.cokernel (wcFreeSheafMap S ι),
      Limits.cokernel.π (wcFreeSheafMap S j) ≫ κ =
        wcFreeSheafMap S g ≫ Limits.cokernel.π (wcFreeSheafMap S ι) :=
    ⟨_, Limits.cokernel.π_desc _ _ hw⟩
  refine ⟨κ, ?_, hκ⟩
  rw [isIso_iff_coyoneda_map_bijective]
  intro G
  have hι' : ∀ ψ : Limits.cokernel (wcFreeSheafMap S ι) ⟶ G,
      G.obj.map ι.op (e U G (Limits.cokernel.π (wcFreeSheafMap S ι) ≫ ψ)) = 0 := by
    intro ψ
    rw [← hen ι G, ← Category.assoc, Limits.cokernel.condition, Limits.zero_comp, he0]
  have hg' : ∀ ψ : Limits.cokernel (wcFreeSheafMap S ι) ⟶ G,
      G.obj.map g.op (e U G (Limits.cokernel.π (wcFreeSheafMap S ι) ≫ ψ)) =
        e T G (Limits.cokernel.π (wcFreeSheafMap S j) ≫ κ ≫ ψ) := by
    intro ψ
    rw [← Category.assoc, hκ, Category.assoc, hen]
  constructor
  · intro ψ ψ' h
    have h' : κ ≫ ψ = κ ≫ ψ' := h
    rw [← sub_eq_zero]
    have hΔ : κ ≫ (ψ - ψ') = 0 := by rw [Preadditive.comp_sub, h', sub_self]
    apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap S ι))).mp
    rw [Limits.comp_zero]
    apply (e U G).injective
    rw [he0]
    apply hinj
    · exact hι' _
    · rw [hg', hΔ, Limits.comp_zero, he0]
  · intro χ
    have ht : G.obj.map j.op (e T G (Limits.cokernel.π (wcFreeSheafMap S j) ≫ χ)) = 0 := by
      rw [← hen j G, ← Category.assoc, Limits.cokernel.condition, Limits.zero_comp, he0]
    obtain ⟨s, hs1, hs2⟩ := hsurj G _ ht
    have hφ : wcFreeSheafMap S ι ≫ (e U G).symm s = 0 := by
      apply (e V G).injective
      rw [hen, Equiv.apply_symm_apply, hs1, he0]
    refine ⟨Limits.cokernel.desc _ _ hφ, ?_⟩
    apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap S j))).mp
    apply (e T G).injective
    show e T G (Limits.cokernel.π (wcFreeSheafMap S j) ≫ κ ≫ Limits.cokernel.desc _ _ hφ) = _
    rw [reassoc_of% hκ, Limits.cokernel.π_desc, hen, Equiv.apply_symm_apply, hs2]

theorem wc_glc_etale_fibre_iso : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X W : Scheme.{u}) (f : X ⟶ Spec (.of K)) (φ : W ⟶ X) [Etale φ] (x₀ : Spec (.of K) ⟶ X), x₀ ≫ f = 𝟙 _ → ∀ (x : X), x₀ (IsLocalRing.closedPoint K) = x → ∀ (w₀ : W), φ w₀ = x → (∀ w : W, φ w = x → w = w₀) → IsIso (Limits.pullback.snd φ (X.fromSpecResidueField x)) :=
by
  intro K _ _ X W f φ _ x₀ hsec x hx w₀ hw₀ huniq
  subst hx

  have hA : IsAlgClosed (X.residueField (x₀ (IsLocalRing.closedPoint K))) := by
    have hstar : Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo x₀)) ≫
        X.fromSpecResidueField (x₀ (IsLocalRing.closedPoint K)) = x₀ :=
      Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K X x₀
    have hτσ : Spec.preimage (X.fromSpecResidueField (x₀ (IsLocalRing.closedPoint K)) ≫ f) ≫
        Scheme.descResidueField (Scheme.stalkClosedPointTo x₀) = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, ← Category.assoc, hstar, hsec, Spec.map_id]
    have hsurj : Function.Surjective
        (Scheme.descResidueField (Scheme.stalkClosedPointTo x₀)).hom := by
      intro y
      refine ⟨(Spec.preimage
        (X.fromSpecResidueField (x₀ (IsLocalRing.closedPoint K)) ≫ f)).hom y, ?_⟩
      have := congrArg (fun g => g.hom y) hτσ
      simpa using this
    have hinj : Function.Injective
        (Scheme.descResidueField (Scheme.stalkClosedPointTo x₀)).hom :=
      (Scheme.descResidueField (Scheme.stalkClosedPointTo x₀)).hom.injective
    exact IsAlgClosed.of_ringEquiv K _
      (RingEquiv.ofBijective (Scheme.descResidueField (Scheme.stalkClosedPointTo x₀)).hom
        ⟨hinj, hsurj⟩).symm

  have hB : ∀ (k : Type u) [Field k] [IsAlgClosed k] (P : Scheme.{u}) (p : P ⟶ Spec (.of k))
      [Etale p], Subsingleton P → Nonempty P → IsIso p := by
    intro k _ _ P p _ hs hn
    haveI : IsAffine P := inferInstance
    haveI : Etale (P.isoSpec.inv ≫ p) := inferInstance
    have hq : Spec.map (Spec.preimage (P.isoSpec.inv ≫ p)) = P.isoSpec.inv ≫ p :=
      Spec.map_preimage _
    have hψet : RingHom.Etale (Spec.preimage (P.isoSpec.inv ≫ p)).hom := by
      have : Etale (Spec.map (Spec.preimage (P.isoSpec.inv ≫ p))) := by
        rw [hq]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp this
    letI := (Spec.preimage (P.isoSpec.inv ≫ p)).hom.toAlgebra
    haveI : Algebra.Etale k Γ(P, ⊤) := RingHom.etale_algebraMap.mp hψet
    haveI hS : Subsingleton (PrimeSpectrum Γ(P, ⊤)) :=
      (Scheme.homeoOfIso P.isoSpec).symm.toEquiv.subsingleton
    haveI hN : Nonempty (PrimeSpectrum Γ(P, ⊤)) :=
      (Scheme.homeoOfIso P.isoSpec).symm.toEquiv.nonempty
    haveI : Nontrivial Γ(P, ⊤) := PrimeSpectrum.nonempty_iff_nontrivial.mp hN
    haveI : IsLocalRing Γ(P, ⊤) := by
      apply IsLocalRing.of_unique_max_ideal
      obtain ⟨M, hM⟩ := Ideal.exists_maximal Γ(P, ⊤)
      refine ⟨M, hM, fun J hJ => ?_⟩
      have := Subsingleton.elim (⟨J, hJ.isPrime⟩ : PrimeSpectrum Γ(P, ⊤)) ⟨M, hM.isPrime⟩
      exact congrArg PrimeSpectrum.asIdeal this
    have hb := Algebra.FormallyUnramified.bijective_of_isAlgClosed_of_isLocalRing k Γ(P, ⊤)
    haveI : IsIso (Spec.preimage (P.isoSpec.inv ≫ p)) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hb
    haveI : IsIso (P.isoSpec.inv ≫ p) := by rw [← hq]; infer_instance
    exact IsIso.of_isIso_comp_left P.isoSpec.inv p

  haveI := hA
  haveI : Subsingleton ↑(φ ⁻¹' {x₀ (IsLocalRing.closedPoint K)}) :=
    ⟨fun a b => Subtype.ext ((huniq a a.2).trans (huniq b b.2).symm)⟩
  haveI : Nonempty ↑(φ ⁻¹' {x₀ (IsLocalRing.closedPoint K)}) := ⟨⟨w₀, hw₀⟩⟩
  have h1 : Subsingleton ↥(Scheme.Hom.fiber φ (x₀ (IsLocalRing.closedPoint K))) :=
    (Scheme.Hom.fiberHomeo φ _).toEquiv.subsingleton
  have h2 : Nonempty ↥(Scheme.Hom.fiber φ (x₀ (IsLocalRing.closedPoint K))) :=
    (Scheme.Hom.fiberHomeo φ _).toEquiv.nonempty
  exact hB (X.residueField (x₀ (IsLocalRing.closedPoint K)))
    (Limits.pullback φ (X.fromSpecResidueField (x₀ (IsLocalRing.closedPoint K))))
    (Limits.pullback.snd φ (X.fromSpecResidueField _)) h1 h2

theorem wc_glc_coker_slice : ∀ (S : Scheme.{u}) (U V : S.ProEt) (ι : V ⟶ U) [IsOpenImmersion ι.left] (m i : ℕ), Nonempty (Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) (wcZModSheaf S m) i ≃ Abelian.Ext (Limits.cokernel (wcFreeSheafMap U.left (MorphismProperty.Over.homMk ι.left (Category.comp_id _) trivial : Scheme.ProEt.mk ι.left ⟶ Scheme.ProEt.mk (𝟙 U.left)))) (wcZModSheaf U.left m) i) :=
by
  have wc_proet_mem_topology_iff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
      Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
          (Sieve.functorPullback (wcSliceFunctor S U) T) =
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
    intro S U V T
    ext Z g
    constructor
    · rintro ⟨W, t', h, ht', rfl⟩
      exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
    · rintro ⟨W', t, h, ht, rfl⟩
      have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
      haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
      haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
      let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
      let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
      let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨W'', t'', h, ?_, rfl⟩
      show T.arrows ((wcSliceFunctor S U).map t'')
      rw [he]
      exact T.downward_closed ht e
  have wc_slice_compatiblePreserving : ∀ (S : Scheme.{u}) (U : S.ProEt),
      CompatiblePreserving.{u+1} (Scheme.ProEt.topology S) (wcSliceFunctor S U) := by
    intro S U
    apply CompatiblePreserving.mk
    intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ U.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : WeaklyEtale ((f₁.left ≫ Y₁.hom) ≫ U.hom) := hw ▸ X.prop
    haveI : WeaklyEtale (f₁.left ≫ Y₁.hom) := WeaklyEtale.of_comp _ U.hom
    let X' : U.left.ProEt := Scheme.ProEt.mk (f₁.left ≫ Y₁.hom)
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
    let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
    let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
    let e : X ⟶ (wcSliceFunctor S U).obj X' :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
    have hf₁ : f₁ = e ≫ (wcSliceFunctor S U).map f₁' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hf₂ : f₂ = e ≫ (wcSliceFunctor S U).map f₂' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact hleft
    have hc := hx f₁' f₂' hg₁ hg₂ hsq
    rw [hf₁, hf₂]
    simp only [Functor.map_comp, op_comp]
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    exact congrArg _ hc
  have wc_slice_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    have hWf : ∀ f : W ⟶ U, WeaklyEtale f.left := fun f => by
      have h : f.left ≫ U.hom = W.hom := MorphismProperty.Over.w f
      haveI : WeaklyEtale (f.left ≫ U.hom) := h ▸ W.prop
      exact WeaklyEtale.of_comp f.left U.hom
    let Wf : (W ⟶ U) → U.left.ProEt := fun f => @Scheme.ProEt.mk _ _ f.left (hWf f)
    obtain ⟨ε, hε⟩ : ∃ ε : ∀ f : W ⟶ U, W ⟶ (wcSliceFunctor S U).obj (Wf f),
        ∀ f, (ε f).left = 𝟙 W.left := ⟨fun f =>
      MorphismProperty.Over.homMk (𝟙 _)
        ((Category.id_comp _).trans (MorphismProperty.Over.w f)) trivial, fun f => rfl⟩
    have hWfhom : ∀ f : W ⟶ U, (Wf f).hom = f.left := fun f => rfl
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Wf f))
        (hk : (wcSliceFunctor S U).op.map k ≫ (ε f).op = c.hom),
        (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left ∧
          f.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : ε f ≫ (wcSliceFunctor S U).map k.unop = c.hom.unop :=
        congrArg Quiver.Hom.unop hk
