  haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
  haveI : F.IsLeftAdjoint := ⟨_, ⟨adj⟩⟩
  haveI : F.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint F
  let i₁ : F.obj (Limits.cokernel (wcFreeSheafMap U.left ι')) ≅
      Limits.cokernel (F.map (wcFreeSheafMap U.left ι')) :=
    Limits.PreservesCokernel.iso F (wcFreeSheafMap U.left ι')
  obtain ⟨θ, hθ⟩ := wc_natIso (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
    (wcSliceFunctor S U) F adj
  let θA : F.obj (wcFreeSheaf U.left (Scheme.ProEt.mk ι.left)) ≅
      wcFreeSheaf S ((wcSliceFunctor S U).obj (Scheme.ProEt.mk ι.left)) := θ _
  let θB : F.obj (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) ≅
      wcFreeSheaf S ((wcSliceFunctor S U).obj (Scheme.ProEt.mk (𝟙 U.left))) := θ _
  have hθι : F.map (wcFreeSheafMap U.left ι') ≫ θB.hom =
      θA.hom ≫ wcFreeSheafMap S ((wcSliceFunctor S U).map ι') := hθ ι'
  let i₂ : Limits.cokernel (F.map (wcFreeSheafMap U.left ι')) ≅
      Limits.cokernel (wcFreeSheafMap S ((wcSliceFunctor S U).map ι')) :=
    Limits.cokernel.mapIso _ _ θA θB hθι
  let aH : (wcSliceFunctor S U).obj (Scheme.ProEt.mk ι.left) ⟶ V :=
    MorphismProperty.Over.homMk (𝟙 V.left)
      ((Category.id_comp _).trans (MorphismProperty.Over.w ι).symm) trivial
  let aI : V ⟶ (wcSliceFunctor S U).obj (Scheme.ProEt.mk ι.left) :=
    MorphismProperty.Over.homMk (𝟙 V.left)
      ((Category.id_comp _).trans (MorphismProperty.Over.w ι)) trivial
  let bH : (wcSliceFunctor S U).obj (Scheme.ProEt.mk (𝟙 U.left)) ⟶ U :=
    MorphismProperty.Over.homMk (𝟙 U.left) rfl trivial
  let bI : U ⟶ (wcSliceFunctor S U).obj (Scheme.ProEt.mk (𝟙 U.left)) :=
    MorphismProperty.Over.homMk (𝟙 U.left) rfl trivial
  let a : (wcSliceFunctor S U).obj (Scheme.ProEt.mk ι.left) ≅ V :=
    { hom := aH, inv := aI
      hom_inv_id := MorphismProperty.Over.Hom.ext (Category.comp_id _)
      inv_hom_id := MorphismProperty.Over.Hom.ext (Category.comp_id _) }
  let b : (wcSliceFunctor S U).obj (Scheme.ProEt.mk (𝟙 U.left)) ≅ U :=
    { hom := bH, inv := bI
      hom_inv_id := MorphismProperty.Over.Hom.ext (Category.comp_id _)
      inv_hom_id := MorphismProperty.Over.Hom.ext (Category.comp_id _) }
  have sq : (wcSliceFunctor S U).map ι' ≫ b.hom = a.hom ≫ ι :=
    MorphismProperty.Over.Hom.ext ((Category.comp_id _).trans (Category.id_comp _).symm)
  let Fr : S.ProEt ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} :=
    yoneda ⋙ (Functor.whiskeringRight _ _ _).obj (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
      presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
  have hFr : ∀ {A B : S.ProEt} (f : A ⟶ B), Fr.map f = wcFreeSheafMap S f := fun f => rfl
  have w : wcFreeSheafMap S ((wcSliceFunctor S U).map ι') ≫ (Fr.mapIso b).hom =
      (Fr.mapIso a).hom ≫ wcFreeSheafMap S ι :=
    (Fr.map_comp ((wcSliceFunctor S U).map ι') b.hom).symm.trans
      ((congrArg (fun k => Fr.map k) sq).trans (Fr.map_comp a.hom ι))
  let i₃ : Limits.cokernel (wcFreeSheafMap S ((wcSliceFunctor S U).map ι')) ≅
      Limits.cokernel (wcFreeSheafMap S ι) :=
    Limits.cokernel.mapIso _ _ (Fr.mapIso a) (Fr.mapIso b) w
  let e : F.obj (Limits.cokernel (wcFreeSheafMap U.left ι')) ≅
      Limits.cokernel (wcFreeSheafMap S ι) := i₁ ≪≫ i₂ ≪≫ i₃
  obtain ⟨EB⟩ := wc_slice_ext_adjunction S U (Limits.cokernel (wcFreeSheafMap U.left ι'))
    (wcZModSheaf S m) i
  let EA : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) (wcZModSheaf S m) i ≃
      Abelian.Ext (F.obj (Limits.cokernel (wcFreeSheafMap U.left ι'))) (wcZModSheaf S m) i :=
    { toFun := fun x => (Abelian.Ext.mk₀ e.hom).comp x (zero_add i)
      invFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add i)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp] }
  exact ⟨EA.trans EB⟩

theorem wc_glc_affine_local_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (d ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (O : (Spec (.of (MvPolynomial (Fin d) K))).Opens), (O : Set (Spec (.of (MvPolynomial (Fin d) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K))))ᶜ → Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap (Spec (.of (MvPolynomial (Fin d) K))) (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (MvPolynomial (Fin d) K))))))) (wcZModSheaf (Spec (.of (MvPolynomial (Fin d) K))) ℓ) (2 * d)) ∧ Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap (Spec (.of (MvPolynomial (Fin d) K))) (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 (Spec (.of (MvPolynomial (Fin d) K))))))) (wcZModSheaf (Spec (.of (MvPolynomial (Fin d) K))) ℓ) (2 * d)) ≤ ℓ :=
by
  classical
  intro K _ _ d ℓ _ hℓK O hO
  have hℓp : ℓ.Prime := Fact.out
  have hℓ0 : ℓ ≠ 0 := hℓp.ne_zero

  have hcomp : ∀ (Y : Scheme.{u}) [CompactSpace Y] [IsSeparated (Limits.terminal.from Y)]
      (m : ℕ) (i : ℕ),
      Nonempty (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) (wcZModSheaf Y m) i ≃
        wcEtCoh Y m i) := by
    intro Y _ _ m i
    obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont Y
    haveI := hlim
    haveI := hcont
    haveI hlan := wc_lan_preservesFiniteLimits (wcEtToProEt Y)
    let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
    haveI hpl : Limits.PreservesFiniteLimits (wcEpsInv Y) := by
      haveI := Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
      exact Limits.preservesFiniteLimits_of_natIso
        (Adjunction.leftAdjointUniq (Functor.sheafAdjunctionContinuous (wcEtToProEt Y)
          AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)) adj)
    haveI hladj : (wcEpsInv Y).IsLeftAdjoint := adj.isLeftAdjoint
    haveI hpc : Limits.PreservesFiniteColimits (wcEpsInv Y) := by
      haveI := adj.leftAdjoint_preservesColimits.{0, 0}
      exact Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} _
    haveI : (wcEpsInv Y).PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    haveI hadd : (wcEpsInv Y).Additive := Functor.additive_of_preserves_binary_products _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    haveI : EssentiallySmall.{u+1} Y.Etale := inferInstance
    haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
      Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
      IsGrothendieckAbelian.enoughInjectives
    have hunit := fun G => wc_epsInv_unit_iso Y G
    haveI : ∀ G, IsIso (adj.unit.app G) := hunit
    haveI : IsIso adj.unit := NatIso.isIso_of_isIso_app _
    let Zet := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))
    let Λet := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))
    have ha : ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
        Function.Bijective (fun g : Zet ⟶ G => (wcEpsInv Y).map g) :=
      fun G => (adj.fullyFaithfulLOfIsIsoUnit).map_bijective Zet G
    let ψ : (wcEpsInv Y).obj Zet ≅ wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)) :=
      (wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} ℤ))).some ≪≫
        (wc_free_terminal_const Y).some.symm
    let χ : (wcEpsInv Y).obj Λet ≅ wcZModSheaf Y m :=
      (wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))).some ≪≫
        (wc_zmod_sheaf_const Y m).some.symm
    have hb : ∀ (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I] (n : ℕ)
        (e : Abelian.Ext ((wcEpsInv Y).obj Zet) ((wcEpsInv Y).obj I) (n + 1)), e = 0 := by
      intro I _ n e
      have h0 : (Abelian.Ext.mk₀ ψ.inv).comp e (zero_add (n + 1)) = 0 :=
        wc_proet_globalize_vanishing Y hunit (wc_epsInv_affine_vanishing Y) I n _
      calc e = (Abelian.Ext.mk₀ (𝟙 _)).comp e (zero_add (n + 1)) := (Abelian.Ext.mk₀_id_comp e).symm
        _ = ((Abelian.Ext.mk₀ ψ.hom).comp (Abelian.Ext.mk₀ ψ.inv) (add_zero 0)).comp e
              (zero_add (n + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
        _ = (Abelian.Ext.mk₀ ψ.hom).comp ((Abelian.Ext.mk₀ ψ.inv).comp e (zero_add (n + 1)))
              (zero_add (n + 1)) :=
            Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega)
        _ = 0 := by rw [h0, Abelian.Ext.comp_zero]
    have hΦ := wc_ext_transfer_exact (wcEpsInv Y) Zet ha hb Λet i
    let Φ := Equiv.ofBijective _ hΦ
    have pre : ∀ {A A' B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (e : A ≅ A'),
        Nonempty (Abelian.Ext A B i ≃ Abelian.Ext A' B i) := by
      intro A A' B e
      refine ⟨{ toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add i)
                invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add i)
                left_inv := fun y => ?_
                right_inv := fun y => ?_ }⟩
      · simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      · simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (e : B ≅ B'),
        Nonempty (Abelian.Ext A B i ≃ Abelian.Ext A B' i) := by
      intro A B B' e
      refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)
                invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero i)
                left_inv := fun y => ?_
                right_inv := fun y => ?_ }⟩
      · simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      · simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    obtain ⟨E1⟩ := pre (B := wcZModSheaf Y m) ψ.symm
    obtain ⟨E2⟩ := post (A := (wcEpsInv Y).obj Zet) χ.symm
    exact ⟨E1.trans (E2.trans Φ.symm)⟩

  let A : Scheme.{u} := Spec (.of (MvPolynomial (Fin d) K))
  let ιO : Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 A) :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
  have hmono : Mono (wcFreeSheafMap A ιO) :=
    wc_free_sheaf_map_mono A _ _ ιO (show Mono O.ι from inferInstance)
  have hS₀ : (ShortComplex.mk (wcFreeSheafMap A ιO) (Limits.cokernel.π (wcFreeSheafMap A ιO))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  by_cases hd0 : d = 0
  ·
    rw [show 2 * d = 0 by omega]
    obtain ⟨E⟩ := hcomp A ℓ 0
    haveI hAirr : IrreducibleSpace A := by
      first
        | exact (inferInstance : IrreducibleSpace (Spec (.of (MvPolynomial (Fin d) K))))
        | infer_instance
    obtain ⟨hfin, hcard⟩ := wc_et_coh_zero_irreducible_card_le A ℓ hℓ0
    let r : Abelian.Ext (Limits.cokernel (wcFreeSheafMap A ιO)) (wcZModSheaf A ℓ) 0 →
        Abelian.Ext (wcFreeSheaf A (Scheme.ProEt.mk (𝟙 A))) (wcZModSheaf A ℓ) 0 :=
      fun x => (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap A ιO))).comp x (zero_add 0)
    have hr : Function.Injective r := by
      intro x y hxy
      obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
      obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
      have h1 : Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap A ιO) ≫ f) =
          Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap A ιO) ≫ g) := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀]
        exact hxy
      have h2 := (Abelian.Ext.mk₀_bijective _ _).1 h1
      rw [cancel_epi] at h2
      rw [h2]
    have hEr : Function.Injective (E ∘ r) := E.injective.comp hr
    exact ⟨Finite.of_injective _ hEr, (Nat.card_le_card_of_injective _ hEr).trans hcard⟩
  ·
    have hd : 1 ≤ d := Nat.pos_of_ne_zero hd0
    have hn : 1 + (2 * d - 1) = 2 * d := by omega
    obtain ⟨EA⟩ := hcomp A ℓ (2 * d)
    haveI hsubA := wc_et_affine_space_top_coh_vanishing K d hd ℓ hℓp hℓK
    haveI hsubE : Subsingleton (Abelian.Ext (wcFreeSheaf A (Scheme.ProEt.mk (𝟙 A)))
        (wcZModSheaf A ℓ) (2 * d)) := EA.injective.subsingleton
    have hδ : ∀ x₃ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap A ιO)) (wcZModSheaf A ℓ) (2 * d),
        ∃ x₁ : Abelian.Ext (wcFreeSheaf A (Scheme.ProEt.mk O.ι)) (wcZModSheaf A ℓ) (2 * d - 1),
          hS₀.extClass.comp x₁ hn = x₃ := fun x₃ =>
      Abelian.Ext.contravariant_sequence_exact₃ hS₀ (wcZModSheaf A ℓ) x₃
        (Subsingleton.elim (α := Abelian.Ext (wcFreeSheaf A (Scheme.ProEt.mk (𝟙 A)))
          (wcZModSheaf A ℓ) (2 * d)) _ _) hn
    obtain ⟨E1⟩ := wc_ext_free_slice_zmod A (Scheme.ProEt.mk O.ι) ℓ (2 * d - 1)
    haveI hRn : IsNoetherianRing (MvPolynomial (Fin d) K) := by
      first
        | infer_instance
        | exact MvPolynomial.isNoetherianRing
    haveI hAln : IsLocallyNoetherian (Spec (.of (MvPolynomial (Fin d) K))) := by
      first
        | infer_instance
        | exact (isLocallyNoetherian_Spec).mpr hRn
    haveI hOqc : QuasiCompact (O.ι : (O : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Fin d) K))) := by
      first
        | infer_instance
        | exact @instQuasiCompactOfIsLocallyNoetherianOfIsOpenImmersion _ _ hAln O.ι inferInstance
        | exact quasiCompact_of_noetherianSpace_source O.ι
    have hOc0 : CompactSpace (O : Scheme.{u}) := by
      first
        | exact QuasiCompact.compactSpace_of_compactSpace O.ι
        | exact isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact
            (O : Set (Spec (.of (MvPolynomial (Fin d) K)))))
    haveI hOc : CompactSpace (Scheme.ProEt.mk O.ι).left := hOc0
    have hOs0 : IsSeparated (Limits.terminal.from (O : Scheme.{u})) := by
      have e : Limits.terminal.from (O : Scheme.{u}) =
          O.ι ≫ Limits.terminal.from (Spec (.of (MvPolynomial (Fin d) K))) :=
        Limits.terminal.hom_ext _ _
      rw [e]
      haveI hAsep : IsSeparated (Limits.terminal.from (Spec (.of (MvPolynomial (Fin d) K)))) :=
        inferInstance
      haveI hOιsep : IsSeparated (O.ι : (O : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Fin d) K))) :=
        inferInstance
      first
        | infer_instance
        | exact IsSeparated.instCompScheme _ _
    haveI hOs : IsSeparated (Limits.terminal.from (Scheme.ProEt.mk O.ι).left) := hOs0
    obtain ⟨E2⟩ := hcomp (Scheme.ProEt.mk O.ι).left ℓ (2 * d - 1)
    obtain ⟨hfinO, hcardO⟩ := wc_et_punctured_affine_coh_card_le K d hd ℓ hℓp hℓK O hO
    haveI : Finite (wcEtCoh (Scheme.ProEt.mk O.ι).left ℓ (2 * d - 1)) := hfinO
    let G : wcEtCoh (Scheme.ProEt.mk O.ι).left ℓ (2 * d - 1) →
        Abelian.Ext (Limits.cokernel (wcFreeSheafMap A ιO)) (wcZModSheaf A ℓ) (2 * d) :=
      fun c => hS₀.extClass.comp (E1.symm (E2.symm c)) hn
    have hG : Function.Surjective G := by
      intro x₃
      obtain ⟨x₁, hx₁⟩ := hδ x₃
      refine ⟨E2 (E1 x₁), ?_⟩
      simp only [G, Equiv.symm_apply_apply]
      exact hx₁
    exact ⟨Finite.of_surjective G hG, (Nat.card_le_card_of_surjective G hG).trans hcardO⟩

theorem wc_glc_local_card_le (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (V₀ : X.left.ProEt) (ι₀ : V₀ ⟶ wcGeomPoint F X h)
    (hι₀ : IsOpenImmersion ι₀.left) (xb : (wcGeomPoint F X h).left)
    (hpt : Set.range ι₀.left = {xb}ᶜ) :
    Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀)) (wcZModSheaf X.left ℓ) (2 * d)) ∧
    Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
      (wcZModSheaf X.left ℓ) (2 * d)) ≤ ℓ :=
by
  classical
  haveI := hι₀

  let fY : (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F)) :=
    Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  haveI hprop : IsProper fY :=
    (show IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :
        (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F))) from inferInstance)
  haveI hsm : SmoothOfRelativeDimension d fY :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) inferInstance
  have hneℓ : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro h0
    have hp : ringChar F ∣ ℓ := (CharP.cast_eq_zero_iff (AlgebraicClosure F) (ringChar F) ℓ).mp h0
    have hpp : Nat.Prime (ringChar F) := CharP.char_is_prime F (ringChar F)
    have hpl : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hp
    letI := Fintype.ofFinite F
    have hc : ((Nat.card F : ℕ) : F) = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F
    have hdvd : ringChar F ∣ Nat.card F := (ringChar.spec F _).mp hc
    exact hℓ (hpl ▸ hdvd)
  haveI : IsLocallyNoetherian (wcGeomPoint F X h).left := LocallyOfFiniteType.isLocallyNoetherian fY
  haveI : CompactSpace (wcGeomPoint F X h).left := QuasiCompact.compactSpace_of_compactSpace fY
  have hxbc : IsClosed ({xb} : Set (wcGeomPoint F X h).left) := by
    have ho : IsOpen (Set.range ι₀.left) := ι₀.left.isOpenEmbedding.isOpen_range
    rw [hpt] at ho
    exact isOpen_compl_iff.mp ho

  obtain ⟨y₀, hy₀f, hy₀pt⟩ := wc_glc_closed_point_section (AlgebraicClosure F)
    (wcGeomPoint F X h).left fY xb hxbc
  obtain ⟨W, ι, hι, v₀, φ, hv₀ι, hφet, hv₀φ, hfib⟩ :=
    wc_smooth_rational_point_etale_chart (AlgebraicClosure F) (wcGeomPoint F X h).left fY d y₀ hy₀f
  haveI := hι
  haveI := hφet
  haveI : CompactSpace W := QuasiCompact.compactSpace_of_compactSpace ι
  set orig : Spec (.of (AlgebraicClosure F)) ⟶ Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))) :=
    Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin d) (AlgebraicClosure F) →+* AlgebraicClosure F))
    with horig
  set pt : Spec (.of (AlgebraicClosure F)) := IsLocalRing.closedPoint (AlgebraicClosure F) with hptdef
  have hopK : orig ≫ Spec.map (CommRingCat.ofHom
      (MvPolynomial.C : AlgebraicClosure F →+* MvPolynomial (Fin d) (AlgebraicClosure F))) = 𝟙 _ := by
    rw [horig, ← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext x
    simp
  haveI : IsClosedImmersion orig := by
    haveI : IsClosedImmersion (orig ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : AlgebraicClosure F →+* MvPolynomial (Fin d) (AlgebraicClosure F)))) := by
      rw [hopK]; infer_instance
    exact IsClosedImmersion.of_comp orig (Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : AlgebraicClosure F →+* MvPolynomial (Fin d) (AlgebraicClosure F))))
  have hclosed : IsClosed (Set.range orig) := (Scheme.Hom.isClosedEmbedding orig).isClosed_range
  let O : (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))).Opens :=
    ⟨(Set.range orig)ᶜ, hclosed.isOpen_compl⟩
  have hrangeO : ∀ p : Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))),
      p ∈ Set.range orig ↔ p = orig pt := by
    intro p
    constructor
    · rintro ⟨q, rfl⟩
      rw [Subsingleton.elim q pt]
    · intro hp
      exact ⟨pt, hp.symm⟩
  have hιw₀ : ι (v₀ pt) = xb := by rw [← Scheme.Hom.comp_apply, hv₀ι, hy₀pt]
  have hφw₀ : φ (v₀ pt) = orig pt := by rw [← Scheme.Hom.comp_apply, hv₀φ]
  have hmemO : ∀ v : W, φ v ∈ (O : Set (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))))) ↔
      v ≠ v₀ pt := by
    intro v
    show φ v ∈ (Set.range orig)ᶜ ↔ _
    rw [Set.mem_compl_iff, hrangeO]
    constructor
    · intro hne heq
      apply hne
      rw [heq, hφw₀]
    · intro hne heq
      exact hne (hfib v heq)
  have huniq1 : ∀ w : W, ι w = xb → w = v₀ pt :=
    fun w hw => ι.isOpenEmbedding.injective (hw.trans hιw₀.symm)
  have hmemι : ∀ v : W, ι v ≠ xb ↔ v ≠ v₀ pt := by
    intro v
    constructor
    · intro hne heq
      apply hne
      rw [heq, hιw₀]
    · intro hne heq
      exact hne (huniq1 v heq)
  let Wo : W.Opens := φ ⁻¹ᵁ O
  have hWo : ∀ v : W, v ∈ (Wo : Set W) ↔
      φ v ∈ (O : Set (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))))) := fun v => Iff.rfl
  have hrangeWo : Set.range Wo.ι = (Wo : Set W) := Scheme.Opens.range_ι Wo

  let U1 : (wcGeomPoint F X h).left.ProEt := Scheme.ProEt.mk (𝟙 (wcGeomPoint F X h).left)
  let ι1 : Scheme.ProEt.mk ι₀.left ⟶ U1 :=
    MorphismProperty.Over.homMk ι₀.left (Category.comp_id _) trivial
  let T1 : (wcGeomPoint F X h).left.ProEt := Scheme.ProEt.mk ι
  let VT1 : (wcGeomPoint F X h).left.ProEt := Scheme.ProEt.mk (Wo.ι ≫ ι)
  let g1 : T1 ⟶ U1 := MorphismProperty.Over.homMk ι (Category.comp_id _) trivial
  let j1 : VT1 ⟶ T1 := MorphismProperty.Over.homMk Wo.ι rfl trivial
  have H1 : Set.range (Wo.ι ≫ ι) ⊆ Set.range ι₀.left := by
    rintro _ ⟨v, rfl⟩
    rw [hpt, Scheme.Hom.comp_apply]
    have hv : Wo.ι v ∈ (Wo : Set W) := by rw [← hrangeWo]; exact ⟨v, rfl⟩
    exact (hmemι _).mpr ((hmemO _).mp ((hWo _).mp hv))
  obtain ⟨L1, hL1⟩ : ∃ L1 : Wo.toScheme ⟶ V₀.left, L1 ≫ ι₀.left = Wo.ι ≫ ι :=
    ⟨IsOpenImmersion.lift ι₀.left (Wo.ι ≫ ι) H1, IsOpenImmersion.lift_fac _ _ H1⟩
  let gV1 : VT1 ⟶ Scheme.ProEt.mk ι₀.left :=
    MorphismProperty.Over.homMk L1 hL1 trivial
  have hgV1 : gV1 ≫ ι1 = j1 ≫ g1 := MorphismProperty.Over.Hom.ext hL1
  have hrj1 : Set.range j1.left = g1.left ⁻¹' {xb}ᶜ := by
    show Set.range Wo.ι = ι ⁻¹' {xb}ᶜ
    rw [hrangeWo]
    ext v
    exact (hWo v).trans ((hmemO v).trans (hmemι v).symm)
  haveI : Etale ι := inferInstance
  have hfib1 : IsIso (Limits.pullback.snd ι ((wcGeomPoint F X h).left.fromSpecResidueField xb)) :=
    wc_glc_etale_fibre_iso (AlgebraicClosure F) (wcGeomPoint F X h).left W fY ι y₀ hy₀f xb hy₀pt
      (v₀ pt) hιw₀ huniq1
  obtain ⟨κ₁, hκ₁, -⟩ := wc_lfi_point_excision (wcGeomPoint F X h).left U1
    (Scheme.ProEt.mk ι₀.left) T1 VT1 ι1 hι₀ xb hpt g1 j1
    (show IsOpenImmersion Wo.ι from inferInstance) hrj1 gV1 hgV1 hfib1
    (show CompactSpace W from inferInstance)
    (show QuasiSeparatedSpace (wcGeomPoint F X h).left from inferInstance)
    (show IsLocallyNoetherian (wcGeomPoint F X h).left from inferInstance)

  let U2 : (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))).ProEt :=
    Scheme.ProEt.mk (𝟙 (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))))
  let ι2 : Scheme.ProEt.mk O.ι ⟶ U2 :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
  let T2 : (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))).ProEt := Scheme.ProEt.mk φ
  let VT2 : (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))).ProEt :=
    Scheme.ProEt.mk (Wo.ι ≫ φ)
  let g2 : T2 ⟶ U2 := MorphismProperty.Over.homMk φ (Category.comp_id _) trivial
  let j2 : VT2 ⟶ T2 := MorphismProperty.Over.homMk Wo.ι rfl trivial
  let gV2 : VT2 ⟶ Scheme.ProEt.mk O.ι :=
    MorphismProperty.Over.homMk (φ ∣_ O) (morphismRestrict_ι φ O) trivial
  have hgV2 : gV2 ≫ ι2 = j2 ≫ g2 := MorphismProperty.Over.Hom.ext (morphismRestrict_ι φ O)
  have hOset : (O : Set (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))))) = {orig pt}ᶜ := by
    ext p
    show p ∈ (Set.range orig)ᶜ ↔ _
    rw [Set.mem_compl_iff, hrangeO]
    exact Iff.rfl
  have hr2 : Set.range ι2.left = {orig pt}ᶜ := by
    show Set.range O.ι = _
    rw [Scheme.Opens.range_ι]
    exact hOset
  have hrj2 : Set.range j2.left = g2.left ⁻¹' {orig pt}ᶜ := by
    show Set.range Wo.ι = φ ⁻¹' {orig pt}ᶜ
    rw [hrangeWo, ← hOset]
    ext v
    exact Iff.rfl
  have hfib2 : IsIso (Limits.pullback.snd φ
      ((Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))).fromSpecResidueField (orig pt))) :=
    wc_glc_etale_fibre_iso (AlgebraicClosure F) (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))))
      W (Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : AlgebraicClosure F →+* MvPolynomial (Fin d) (AlgebraicClosure F))))
      φ orig hopK (orig pt) rfl (v₀ pt) hφw₀ hfib
  obtain ⟨κ₂, hκ₂, -⟩ := wc_lfi_point_excision (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))))
    U2 (Scheme.ProEt.mk O.ι) T2 VT2 ι2 (show IsOpenImmersion O.ι from inferInstance) (orig pt) hr2
    g2 j2 (show IsOpenImmersion Wo.ι from inferInstance) hrj2 gV2 hgV2 hfib2
    (show CompactSpace W from inferInstance)
    (show QuasiSeparatedSpace (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))) from
      inferInstance)
    (show IsLocallyNoetherian (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))) from
      inferInstance)

  have pre : ∀ (Z : Scheme.{u}) {A A' B : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (e : A ≅ A'), Nonempty (Abelian.Ext A B (2 * d) ≃ Abelian.Ext A' B (2 * d)) := by
    intro Z A A' B e
    refine ⟨{ toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add (2 * d))
              invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add (2 * d))
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (2 * d)) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (2 * d)) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  obtain ⟨E1⟩ := wc_glc_coker_slice X.left (wcGeomPoint F X h) V₀ ι₀ ℓ (2 * d)
  obtain ⟨E2⟩ := pre (wcGeomPoint F X h).left (B := wcZModSheaf (wcGeomPoint F X h).left ℓ)
    (@asIso _ _ _ _ κ₁ hκ₁)
  haveI : IsOpenImmersion j1.left := (show IsOpenImmersion Wo.ι from inferInstance)
  obtain ⟨E3⟩ := wc_glc_coker_slice (wcGeomPoint F X h).left T1 VT1 j1 ℓ (2 * d)
  haveI : IsOpenImmersion j2.left := (show IsOpenImmersion Wo.ι from inferInstance)
  obtain ⟨E4⟩ := wc_glc_coker_slice (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))))
    T2 VT2 j2 ℓ (2 * d)
  obtain ⟨E5⟩ := pre (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F))))
    (B := wcZModSheaf (Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))) ℓ)
    (@asIso _ _ _ _ κ₂ hκ₂)
  let E := E1.trans (E2.symm.trans (E3.trans (E4.symm.trans E5)))

  obtain ⟨hfin, hcard⟩ := wc_glc_affine_local_card_le (AlgebraicClosure F) d ℓ hneℓ O rfl
  exact ⟨@Finite.of_equiv _ _ hfin E.symm, (Nat.card_congr E).trans_le hcard⟩

theorem wc_rpc_geom_local_cyclic (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (V₀ : X.left.ProEt) (ι₀ : V₀ ⟶ wcGeomPoint F X h)
    (hι₀ : IsOpenImmersion ι₀.left) (xb : (wcGeomPoint F X h).left)
    (hpt : Set.range ι₀.left = {xb}ᶜ) :
    ∃ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀)) (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
      ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀)) (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
        ∃ k : ℤ, x = k • y :=
by
  classical

  have hsm : ∀ {Q M : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} {i : ℕ}
      (x : Abelian.Ext Q M i) (k : ℕ), x.comp (Abelian.Ext.mk₀ (k • 𝟙 M)) (add_zero i) = k • x := by
    intro Q M i x k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]
  rcases n with _ | m
  ·
    refine ⟨0, fun x => ⟨0, ?_⟩⟩
    rw [zero_smul]
    have e := hsm x (ℓ ^ 0)
    rw [wc_lfd_root_twist_torsion, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at e
    have e1 : ∀ k : ℕ, k = 1 → k • x = x := fun k hk => by subst hk; exact one_smul ℕ x
    rw [e1 _ (pow_zero ℓ)] at e
    exact e.symm
  ·
    obtain ⟨ρ, hinj, hsurj, hρ⟩ := wc_root_twist_slice_presheaf_map F X ℓ hℓ h (m + 1) d
    obtain ⟨ψ, hψiso, -⟩ := wc_slice_sheafify_scaled_iso X.left (wcGeomPoint F X h)
      (wcGeomFrob F X h) (wcRootTwistPre X.left (ℓ ^ (m + 1)) d) (wcZModSheaf X.left (ℓ ^ (m + 1)))
      ρ (Nat.card F ^ d) hinj hsurj hρ
    let ψ' : ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint F X h)).obj (wcRootTwist X.left (ℓ ^ (m + 1)) d) ⟶
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint F X h)).obj (wcZModSheaf X.left (ℓ ^ (m + 1))) := ψ
    have hψiso' : IsIso ψ' := hψiso
    have hψ1 : ∀ W : Over (wcGeomPoint F X h),
        ψ'.hom.app (Opposite.op (Over.mk (W.hom ≫ 𝟙 (wcGeomPoint F X h)))) =
          1 • ψ'.hom.app (Opposite.op W) := by
      intro W
      let g : Over.mk (W.hom ≫ 𝟙 (wcGeomPoint F X h)) ⟶ W :=
        Over.homMk (U := Over.mk (W.hom ≫ 𝟙 (wcGeomPoint F X h))) (V := W) (𝟙 W.left) (by simp)
      have hn := ψ'.hom.naturality g.op
      have e1 : (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
          (wcGeomPoint F X h)).obj (wcRootTwist X.left (ℓ ^ (m + 1)) d)).obj.map g.op = 𝟙 _ :=
        (wcRootTwist X.left (ℓ ^ (m + 1)) d).obj.map_id (Opposite.op W.left)
      have e2 : (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
          (wcGeomPoint F X h)).obj (wcZModSheaf X.left (ℓ ^ (m + 1)))).obj.map g.op = 𝟙 _ :=
        (wcZModSheaf X.left (ℓ ^ (m + 1))).obj.map_id (Opposite.op W.left)
      rw [e1, e2] at hn
      have key : ψ'.hom.app (Opposite.op (Over.mk (W.hom ≫ 𝟙 (wcGeomPoint F X h)))) =
          ψ'.hom.app (Opposite.op W) := by
        first
          | exact (Category.id_comp _).symm.trans (hn.trans (Category.comp_id _))
          | (erw [Category.id_comp, Category.comp_id] at hn; exact hn)
          | simpa using hn
      first
        | exact key.trans (one_smul ℕ _).symm
        | (rw [key]; exact (one_smul ℕ _).symm)
        | (erw [one_smul]; exact key)
    have hid : wcFreeSheafMap X.left (𝟙 (wcGeomPoint F X h)) = 𝟙 _ := by
      first
        | (unfold wcFreeSheafMap
           rw [CategoryTheory.Functor.map_id yoneda, Functor.whiskerRight_id',
             CategoryTheory.Functor.map_id]; rfl)
        | (unfold wcFreeSheafMap
           rw [CategoryTheory.Functor.map_id yoneda, Functor.whiskerRight_id',
             CategoryTheory.Functor.map_id])
        | simp [wcFreeSheafMap, wcFreeSheaf]
    have hΦ : Limits.cokernel.π (wcFreeSheafMap X.left ι₀) ≫ 𝟙 _ =
        wcFreeSheafMap X.left (𝟙 (wcGeomPoint F X h)) ≫
          Limits.cokernel.π (wcFreeSheafMap X.left ι₀) := by
      rw [hid, Category.comp_id, Category.id_comp]
    obtain ⟨Θ, hΘ, -⟩ := wc_lfi_coker_scaled_transport X.left (wcGeomPoint F X h) V₀ ι₀ (𝟙 _) (𝟙 _)
      (by rw [Category.id_comp, Category.comp_id]) (𝟙 _) hΦ (wcRootTwist X.left (ℓ ^ (m + 1)) d)
      (wcZModSheaf X.left (ℓ ^ (m + 1))) ψ' 1 hψiso' hψ1 (2 * d)

    obtain ⟨f, g, f', p, hfg, hfp, hS₁, hS₂, hpf⟩ := wc_glc_zmod_ses X.left ℓ m
    obtain ⟨hfin, hcard⟩ := wc_glc_local_card_le F X d ℓ hℓ h V₀ ι₀ hι₀ xb hpt
    have hvan := wc_glc_local_succ_vanish F X d ℓ hℓ h V₀ ι₀ hι₀ xb hpt

    let r := AddMonoidHom.mk' (fun x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
        (wcRootTwist X.left (ℓ ^ (m + 1)) d) (2 * d) =>
        (Θ x).comp (Abelian.Ext.mk₀ g) (add_zero (2 * d)))
      (fun a b => by rw [map_add, Abelian.Ext.add_comp])
    have hr : ∀ x, r x = (Θ x).comp (Abelian.Ext.mk₀ g) (add_zero (2 * d)) := fun x => rfl

    have hA : ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
        (wcRootTwist X.left (ℓ ^ (m + 1)) d) (2 * d), ℓ ^ (m + 1) • x = 0 := by
      intro x
      have e := hsm x (ℓ ^ (m + 1))
      rw [wc_lfd_root_twist_torsion, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at e
      exact e.symm

    have hker : ∀ x, r x = 0 → ∃ w, x = ℓ • w := by
      intro x hx
      rw [hr] at hx
      obtain ⟨z₁, hz₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS₁ (Θ x) hx
      obtain ⟨z₂, hz₂⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hS₂ z₁ (n₁ := 2 * d + 1) rfl
        (hvan _)
      obtain ⟨w, hw⟩ := hΘ.2 z₂
      refine ⟨w, hΘ.1 ?_⟩
      dsimp only at hz₁ hz₂
      rw [map_nsmul, hw, ← hz₁, ← hz₂, Abelian.Ext.comp_assoc_of_third_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, hpf, hsm]

    have hstep : ∃ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
        (wcRootTwist X.left (ℓ ^ (m + 1)) d) (2 * d),
        ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
          (wcRootTwist X.left (ℓ ^ (m + 1)) d) (2 * d),
          ∃ (c : ℤ) (w : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
            (wcRootTwist X.left (ℓ ^ (m + 1)) d) (2 * d)), x = c • y + ℓ • w := by
      by_cases hr0 : ∀ x, r x = 0
      · refine ⟨0, fun x => ?_⟩
        obtain ⟨w, hw⟩ := hker x (hr0 x)
        exact ⟨0, w, by rw [zero_smul, zero_add, hw]⟩
      · push_neg at hr0
        obtain ⟨y, hy⟩ := hr0
        refine ⟨y, fun x => ?_⟩
        haveI := hfin
        have hly : ℓ ^ (m + 1) • r y = 0 := by
          have e := map_nsmul r (ℓ ^ (m + 1)) y
          rw [hA, map_zero] at e
          exact e.symm
        have hord_dvd : addOrderOf (r y) ∣ ℓ ^ (m + 1) := addOrderOf_dvd_of_nsmul_eq_zero hly
        obtain ⟨j, -, hjeq⟩ := (Nat.dvd_prime_pow (Fact.out : ℓ.Prime)).mp hord_dvd
        have hj0 : j ≠ 0 := by
          rintro rfl
          rw [pow_zero, AddMonoid.addOrderOf_eq_one_iff] at hjeq
          exact hy hjeq
        have hge : ℓ ≤ addOrderOf (r y) := by
          rw [hjeq]
          exact Nat.le_self_pow hj0 ℓ
        have htop : AddSubgroup.zmultiples (r y) = ⊤ := by
          apply AddSubgroup.eq_top_of_le_card
          rw [Nat.card_zmultiples]
          exact hcard.trans hge
        obtain ⟨c, hc⟩ := AddSubgroup.mem_zmultiples_iff.mp
          (show r x ∈ AddSubgroup.zmultiples (r y) by rw [htop]; exact AddSubgroup.mem_top _)
        obtain ⟨w, hw⟩ := hker (x - c • y) (by rw [map_sub, map_zsmul, hc, sub_self])
        exact ⟨c, w, by rw [← hw]; abel⟩

    obtain ⟨y, hy⟩ := hstep
    have hiter : ∀ j : ℕ, ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
        (wcRootTwist X.left (ℓ ^ (m + 1)) d) (2 * d),
        ∃ (c : ℤ) (w : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
          (wcRootTwist X.left (ℓ ^ (m + 1)) d) (2 * d)), x = c • y + (ℓ ^ j) • w := by
      intro j
      induction j with
      | zero => intro x; exact ⟨0, x, by rw [zero_smul, zero_add, pow_zero, one_smul]⟩
      | succ j ih =>
        intro x
        obtain ⟨c, w, hw⟩ := ih x
        obtain ⟨c', w', hw'⟩ := hy w
        refine ⟨c + ((ℓ ^ j : ℕ) : ℤ) * c', w', ?_⟩
        have e1 : (ℓ ^ j) • (c' • y) = (((ℓ ^ j : ℕ) : ℤ) * c') • y := by
          rw [mul_smul, natCast_zsmul]
        have e2 : (ℓ ^ j) • (ℓ • w') = (ℓ ^ (j + 1)) • w' := by
          rw [smul_smul, ← pow_succ]
        rw [hw, hw', smul_add, e1, e2, add_smul]
        abel
    refine ⟨y, fun x => ?_⟩
    obtain ⟨c, w, hw⟩ := hiter (m + 1) x
    exact ⟨c, by rw [hw, hA, add_zero]⟩

theorem wc_lfi_henselization_weaklyEtale : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], ∃ (H : Type u) (_ : CommRing H) (_ : HenselianLocalRing H) (_ : IsNoetherianRing H) (ι : P →+* H), IsLocalHom ι ∧ (∀ x : H, ∃ y : P, x - ι y ∈ IsLocalRing.maximalIdeal H) ∧ Ideal.map ι (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal H ∧ (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (g : P →+* A), IsLocalHom g → ∃! h : H →+* A, IsLocalHom h ∧ h.comp ι = g) ∧ @Algebra.WeaklyEtale P H _ _ ι.toAlgebra :=
by
  intro P _ _ _
  classical
  obtain ⟨H, iH, hH, hN, ι, hloc, hres, hmax, huniv, hchart⟩ := wc_hnas_henselization_exists P
  refine ⟨H, iH, hH, hN, ι, hloc, hres, hmax, huniv, ?_⟩

  obtain ⟨hL, hC, hlocC, -⟩ := wc_hnas_completion_local_complete P
  haveI := hL
  haveI := hC
  haveI hHenR : HenselianRing (AdicCompletion (IsLocalRing.maximalIdeal P) P)
      (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P)) :=
    IsAdicComplete.henselianRing _ _
  haveI hHenC : HenselianLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) := by
    refine HenselianLocalRing.mk ?_
    intro f hf a₀ h₁ h₂
    exact HenselianRing.is_henselian f hf a₀ h₁ (h₂.map _)

  obtain ⟨χ, ⟨-, hχ⟩, -⟩ :=
    huniv (AdicCompletion (IsLocalRing.maximalIdeal P) P) (algebraMap P _) hlocC
  letI : Algebra P H := ι.toAlgebra
  haveI : IsLocalHom (algebraMap P H) := hloc

  have hkill : ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (e : E →+* H),
      e.comp (algebraMap P E) = ι → ∀ z : E, e z = 0 → ∃ s : E, IsUnit (e s) ∧ s * z = 0 := by
    intro E _ _ _ e he z hz
    let φ : E →ₐ[P] H := { e with commutes' := fun p => RingHom.congr_fun he p }
    have hφ : ∀ x, φ x = e x := fun _ => rfl
    obtain ⟨φB, hφB, hNB, hmB, hlev⟩ := wc_hnas_hs_etale_local_ring_levels P H hres E φ
    haveI := hNB
    have hz' : ∀ k : ℕ, algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) z ∈
        Ideal.map (algebraMap P (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))))
          (IsLocalRing.maximalIdeal P ^ k) := by
      intro k
      obtain ⟨p, hp⟩ := hlev k (algebraMap E _ z)
      have h1 := Ideal.mem_map_of_mem (φB : _ →+* H) hp
      rw [Ideal.map_map, AlgHom.comp_algebraMap] at h1
      have h1' : φB (algebraMap E _ z - algebraMap P _ p) ∈
          Ideal.map (algebraMap P H) (IsLocalRing.maximalIdeal P ^ k) := h1
      rw [map_sub, hφB, hφ, hz, AlgHom.commutes, zero_sub] at h1'
      have h2 : algebraMap P H p ∈ Ideal.map (algebraMap P H) (IsLocalRing.maximalIdeal P ^ k) :=
        neg_mem_iff.mp h1'
      have h3 : algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p ∈
          Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
            (IsLocalRing.maximalIdeal P ^ k) := by
        have h4 := Ideal.mem_map_of_mem χ h2
        rw [Ideal.map_map] at h4
        rw [← hχ]
        exact h4
      have h5 := (wc_hnas_hs_completion_levels P).2 k p h3
      have h6 := Ideal.mem_map_of_mem
        (algebraMap P (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H)))) h5
      have h7 := Ideal.add_mem _ hp h6
      rwa [sub_add_cancel] at h7
    have hzero : algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) z = 0 := by
      have hne : IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) ≠ ⊤ :=
        (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing _ hne
      have hmem : algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) z ∈
          ⨅ i, IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) ^ i := by
        rw [Submodule.mem_iInf]
        intro k
        rw [hmB, ← Ideal.map_pow]
        exact hz' k
      rw [hK] at hmem
      exact (Submodule.mem_bot _).mp hmem
    obtain ⟨⟨m, hm⟩, hmz⟩ := (IsLocalization.map_eq_zero_iff
      (Ideal.comap φ (IsLocalRing.maximalIdeal H)).primeCompl _ z).mp hzero
    refine ⟨m, ?_, hmz⟩
    have hm' : m ∉ Ideal.comap φ (IsLocalRing.maximalIdeal H) := hm
    rw [Ideal.mem_comap, hφ] at hm'
    exact IsLocalRing.notMem_maximalIdeal.mp hm'

  apply wc_indEtale_weaklyEtale
  unfold wcIndEtale
  intro Q _ _ _ h
  obtain ⟨n, f, hf, hfg⟩ := Algebra.FinitePresentation.out (R := P) (A := Q)
  obtain ⟨G, hG⟩ := hfg
  obtain ⟨E, iE, aE, hE, e, he, hmem⟩ :=
    hchart (Finset.univ.image (fun i : Fin n => h (f (MvPolynomial.X i))))
  have ha : ∀ i : Fin n, ∃ a : E, e a = h (f (MvPolynomial.X i)) := fun i =>
    RingHom.mem_range.mp (hmem _ (Finset.mem_image_of_mem _ (Finset.mem_univ i)))
  choose a ha using ha
  let ê : E →ₐ[P] H := { e with commutes' := fun p => RingHom.congr_fun he p }
  let ψ : MvPolynomial (Fin n) P →ₐ[P] E := MvPolynomial.aeval a
  have hψ : ê.comp ψ = h.comp f := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, ψ, MvPolynomial.aeval_X]
    exact ha i
  have hψx : ∀ x, e (ψ x) = h (f x) := by
    intro x
    have h1 := AlgHom.congr_fun hψ x
    simp only [AlgHom.comp_apply] at h1
    exact h1
  have hrel : ∀ g ∈ G, e (ψ g) = 0 := by
    intro g hg
    have hgk : g ∈ RingHom.ker f.toRingHom := by
      rw [← hG]
      exact Submodule.subset_span (Finset.mem_coe.mpr hg)
    have h2 : f g = 0 := hgk
    rw [hψx, h2, map_zero]
  have hs : ∀ g : MvPolynomial (Fin n) P, ∃ s : E, IsUnit (e s) ∧ (g ∈ G → s * ψ g = 0) := by
    intro g
    by_cases hg : g ∈ G
    · obtain ⟨s, hs1, hs2⟩ := hkill E e he (ψ g) (hrel g hg)
      exact ⟨s, hs1, fun _ => hs2⟩
    · exact ⟨1, by simp, fun h' => absurd h' hg⟩
  choose s hsu hsz using hs
  obtain ⟨S, hS⟩ : ∃ S : E, S = ∏ g ∈ G, s g := ⟨_, rfl⟩
  have hSu : IsUnit (e S) := by
    rw [hS, map_prod]
    exact Finset.prod_induction _ IsUnit (fun _ _ => IsUnit.mul) isUnit_one (fun g _ => hsu g)
  have hSz : ∀ g ∈ G, S * ψ g = 0 := by
    intro g hg
    rw [hS, ← Finset.prod_erase_mul G s hg, mul_assoc, hsz g hg, mul_zero]
  haveI : Algebra.Etale E (Localization.Away S) := Algebra.Etale.of_isLocalizationAway S
  haveI : Algebra.Etale P (Localization.Away S) := Algebra.Etale.comp P E (Localization.Away S)
  let β₀ : Localization.Away S →+* H := IsLocalization.Away.lift S hSu
  have hβ₀ : ∀ x : E, β₀ (algebraMap E (Localization.Away S) x) = e x :=
    IsLocalization.Away.lift_eq S hSu
  let β : Localization.Away S →ₐ[P] H :=
    { β₀ with
      commutes' := fun p => by
        show β₀ (algebraMap P (Localization.Away S) p) = ι p
        rw [IsScalarTower.algebraMap_apply P E (Localization.Away S), hβ₀]
        exact RingHom.congr_fun he p }
  let α₀ : MvPolynomial (Fin n) P →ₐ[P] Localization.Away S :=
    (IsScalarTower.toAlgHom P E (Localization.Away S)).comp ψ
  have hle : RingHom.ker f.toRingHom ≤ RingHom.ker α₀ := by
    rw [← hG]
    apply Submodule.span_le.mpr
    intro g hg
    rw [SetLike.mem_coe, RingHom.mem_ker]
    show algebraMap E (Localization.Away S) (ψ g) = 0
    have hu := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away S) S
    rw [← hu.mul_right_eq_zero, ← map_mul, hSz g hg, map_zero]
  let ᾱ : (MvPolynomial (Fin n) P ⧸ RingHom.ker f) →ₐ[P] Localization.Away S :=
    Ideal.Quotient.liftₐ (RingHom.ker f) α₀ (fun x hx => by
      have hx' : x ∈ RingHom.ker f.toRingHom := by
        rw [RingHom.mem_ker] at hx ⊢
        exact hx
      exact RingHom.mem_ker.mp (hle hx'))
  let α : Q →ₐ[P] Localization.Away S :=
    ᾱ.comp (Ideal.quotientKerAlgEquivOfSurjective hf).symm.toAlgHom
  refine ⟨Localization.Away S, inferInstance, inferInstance, inferInstance, α, β, ?_⟩
  apply AlgHom.ext
  intro y
  obtain ⟨x, rfl⟩ := hf y
  have hsymm : (Ideal.quotientKerAlgEquivOfSurjective hf).symm (f x) =
      Ideal.Quotient.mk (RingHom.ker f) x := by
    rw [AlgEquiv.symm_apply_eq]
    exact (Ideal.kerLiftAlg_mk f x).symm
  have hα : α (f x) = algebraMap E (Localization.Away S) (ψ x) := by
    show ᾱ ((Ideal.quotientKerAlgEquivOfSurjective hf).symm (f x)) = _
    rw [hsymm]
    rfl
  rw [AlgHom.comp_apply, hα]
  show β₀ (algebraMap E (Localization.Away S) (ψ x)) = h (f x)
  rw [hβ₀, hψx]

theorem wc_lfi_flat_local_dim_eq : ∀ (P A : Type u) [CommRing P] [CommRing A] [IsLocalRing P] [IsLocalRing A] [IsNoetherianRing P] [IsNoetherianRing A] [Algebra P A] [Module.Flat P A] [IsLocalHom (algebraMap P A)], Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal A → ringKrullDim A = ringKrullDim P :=
by
  intro P A _ _ _ _ _ _ _ _ _ hmax
  haveI : Algebra.HasGoingDown P A := Algebra.HasGoingDown.of_flat
  haveI : (IsLocalRing.maximalIdeal A).LiesOver (IsLocalRing.maximalIdeal P) :=
    ⟨by rw [Ideal.under_def, IsLocalRing.maximalIdeal_comap]⟩
  have h1 := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
    (IsLocalRing.maximalIdeal P) (IsLocalRing.maximalIdeal A)
  have h5 : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P)))
      (IsLocalRing.maximalIdeal A) = ⊥ := by
    rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
    exact hmax.ge
  haveI : Nontrivial (A ⧸ Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P)) := by
    rw [Ideal.Quotient.nontrivial_iff, hmax]
    exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top
  rw [h5, Ideal.height_bot, add_zero] at h1
  rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
    ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, h1]

theorem wc_lfi_specMap_weaklyEtale : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], Algebra.WeaklyEtale R S → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) :=
by
  intro R S _ _ _ hwe
  haveI := hwe
  have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
    rw [HasRingHomProperty.Spec_iff (P := @Flat)]
    exact RingHom.flat_algebraMap_iff.mpr (Algebra.WeaklyEtale.flat (R := R) (S := S))
  have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R S)))) := by
    rw [diagonal_SpecMap]
    haveI : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) :=
      HasRingHomProperty.Spec_iff.mpr (Algebra.WeaklyEtale.flat_lmul' R S)
    infer_instance
  exact WeaklyEtale.mk hf hd

theorem wc_lfi_smooth_stalk_dim : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (q : Z ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d q] (z : Z), IsClosed ({z} : Set Z) → ringKrullDim (Z.presheaf.stalk z) = (d : WithBot ℕ∞) :=
by
  intro K _ Z q d _ z hcl

  have wc_lfi_flat_local_dim_eq : ∀ (P A : Type u) [CommRing P] [CommRing A] [IsLocalRing P]
      [IsLocalRing A] [IsNoetherianRing P] [IsNoetherianRing A] [Algebra P A] [Module.Flat P A]
      [IsLocalHom (algebraMap P A)],
      Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal A →
      ringKrullDim A = ringKrullDim P := by
    intro P A _ _ _ _ _ _ _ _ _ hmax
    haveI : Algebra.HasGoingDown P A := Algebra.HasGoingDown.of_flat
    haveI : (IsLocalRing.maximalIdeal A).LiesOver (IsLocalRing.maximalIdeal P) :=
      ⟨by rw [Ideal.under_def, IsLocalRing.maximalIdeal_comap]⟩
    have h1 := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
      (IsLocalRing.maximalIdeal P) (IsLocalRing.maximalIdeal A)
    have h5 : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P)))
        (IsLocalRing.maximalIdeal A) = ⊥ := by
      rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
      exact hmax.ge
    haveI : Nontrivial (A ⧸ Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P)) := by
      rw [Ideal.Quotient.nontrivial_iff, hmax]
      exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    rw [h5, Ideal.height_bot, add_zero] at h1
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
      ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, h1]

  have s3 : ∀ (n : ℕ) (M : Ideal (MvPolynomial (Fin n) K)), M.IsMaximal → M.height = (n : ℕ∞) := by
    intro n
    induction n with
    | zero =>
      intro M hM
      let e := (MvPolynomial.isEmptyAlgEquiv K (Fin 0)).toRingEquiv
      haveI : (Ideal.map e M).IsMaximal := Ideal.map_isMaximal_of_equiv e
      have h2 : Ideal.map e M = ⊥ := Ideal.eq_bot_of_prime _
      rw [← RingEquiv.height_map e M, h2, Ideal.height_bot]
      simp
    | succ n ih =>
      intro M hM
      let e := (MvPolynomial.finSuccEquiv K n).toRingEquiv
      haveI : (Ideal.map e M).IsMaximal := Ideal.map_isMaximal_of_equiv e
      haveI := Ideal.over_under (A := MvPolynomial (Fin n) K) (Ideal.map e M)
      have h3 := Polynomial.height_eq_height_add_one
        (Ideal.under (MvPolynomial (Fin n) K) (Ideal.map e M)) (Ideal.map e M)
      have h4 : (Ideal.under (MvPolynomial (Fin n) K) (Ideal.map e M)).IsMaximal := by
        have := Polynomial.isMaximal_comap_C_of_isJacobsonRing (Ideal.map e M)
        unfold Ideal.under
        rw [Polynomial.algebraMap_eq]
        exact this
      rw [← RingEquiv.height_map e M, h3, ih _ h4]
      push_cast
      rfl

  have s4 : ∀ (S : Type u) [CommRing S] (g : MvPolynomial (Fin d) K →+* S), g.FiniteType →
      ∀ (Q : Ideal S), Q.IsMaximal → (Ideal.comap g Q).IsMaximal := by
    intro S _ g hg Q hQ
    letI := g.toAlgebra
    haveI : Algebra.FiniteType (MvPolynomial (Fin d) K) S := hg
    letI : Field (S ⧸ Q) := Ideal.Quotient.field Q
    haveI : Algebra.FiniteType (MvPolynomial (Fin d) K) (S ⧸ Q) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ _ Q)
        (Ideal.Quotient.mkₐ_surjective _ Q)
    haveI : Module.Finite (MvPolynomial (Fin d) K) (S ⧸ Q) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    haveI : (⊥ : Ideal (S ⧸ Q)).IsMaximal := Ideal.bot_isMaximal
    have h := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal
      (algebraMap (MvPolynomial (Fin d) K) (S ⧸ Q))
      (fun x => Algebra.IsIntegral.isIntegral x) (⊥ : Ideal (S ⧸ Q))
    have heq : Ideal.comap (algebraMap (MvPolynomial (Fin d) K) (S ⧸ Q)) ⊥ = Ideal.comap g Q := by
      ext x
      rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_bot]
      first
        | (rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq_zero_iff_mem]; rfl)
        | exact Ideal.Quotient.eq_zero_iff_mem
        | (show Ideal.Quotient.mk Q (g x) = 0 ↔ _; exact Ideal.Quotient.eq_zero_iff_mem)
    rw [heq] at h
    exact h

  have key : ∀ (S : Type u) [CommRing S] (g : MvPolynomial (Fin d) K →+* S), g.Etale →
      ∀ (Q : Ideal S), Q.IsMaximal → Q.height = (d : ℕ∞) := by
    intro S _ g hg Q hQ
    haveI := hQ.isPrime
    letI := g.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin d) K) S := hg
    have hft : g.FiniteType := (inferInstance : Algebra.FiniteType (MvPolynomial (Fin d) K) S)
    have hfl : g.Flat := (inferInstance : Module.Flat (MvPolynomial (Fin d) K) S)
    haveI : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing (MvPolynomial (Fin d) K) S
    have hpmax := s4 S g hft Q hQ
    have hpd := s3 d _ hpmax
    let φ := Localization.localRingHom (Ideal.comap g Q) Q g rfl
    letI : Algebra (Localization.AtPrime (Ideal.comap g Q)) (Localization.AtPrime Q) := φ.toAlgebra
    haveI : IsLocalHom (algebraMap (Localization.AtPrime (Ideal.comap g Q)) (Localization.AtPrime Q)) :=
      Localization.isLocalHom_localRingHom (Ideal.comap g Q) Q g rfl
    haveI : Module.Flat (Localization.AtPrime (Ideal.comap g Q)) (Localization.AtPrime Q) :=
      RingHom.Flat.localRingHom hfl Q (Ideal.comap g Q) rfl
    haveI : IsNoetherianRing (Localization.AtPrime (Ideal.comap g Q)) :=
      IsLocalization.isNoetherianRing (Ideal.comap g Q).primeCompl _ inferInstance
    haveI : IsNoetherianRing (Localization.AtPrime Q) :=
      IsLocalization.isNoetherianRing Q.primeCompl _ inferInstance
    haveI : IsScalarTower (MvPolynomial (Fin d) K) (Localization.AtPrime (Ideal.comap g Q))
        (Localization.AtPrime Q) :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) K) S (Localization.AtPrime Q) x,
          RingHom.algebraMap_toAlgebra φ, Localization.localRingHom_to_map]
        rfl)
    haveI : Algebra.FormallyUnramified S (Localization.AtPrime Q) :=
      Algebra.FormallyUnramified.of_isLocalization Q.primeCompl
    haveI : Algebra.FormallyUnramified (MvPolynomial (Fin d) K) (Localization.AtPrime Q) :=
      Algebra.FormallyUnramified.comp (MvPolynomial (Fin d) K) S (Localization.AtPrime Q)
    haveI : Algebra.FormallyUnramified (Localization.AtPrime (Ideal.comap g Q))
        (Localization.AtPrime Q) :=
      Algebra.FormallyUnramified.localization_base (Ideal.comap g Q).primeCompl
    haveI : Algebra.EssFiniteType (MvPolynomial (Fin d) K) S :=
      Algebra.EssFiniteType.of_finiteType _ _
    haveI : Algebra.EssFiniteType S (Localization.AtPrime Q) :=
      Algebra.EssFiniteType.of_isLocalization _ Q.primeCompl
    haveI : Algebra.EssFiniteType (MvPolynomial (Fin d) K) (Localization.AtPrime Q) :=
      Algebra.EssFiniteType.comp (MvPolynomial (Fin d) K) S (Localization.AtPrime Q)
    haveI : Algebra.EssFiniteType (Localization.AtPrime (Ideal.comap g Q))
        (Localization.AtPrime Q) :=
      Algebra.EssFiniteType.of_comp (MvPolynomial (Fin d) K) _ _
    have hmap := Algebra.FormallyUnramified.map_maximalIdeal
      (R := Localization.AtPrime (Ideal.comap g Q)) (S := Localization.AtPrime Q)
    have hdim := wc_lfi_flat_local_dim_eq _ _ hmap
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height Q (Localization.AtPrime Q),
      IsLocalization.AtPrime.ringKrullDim_eq_height (Ideal.comap g Q)
        (Localization.AtPrime (Ideal.comap g Q))] at hdim
    have hdim' : Q.height = (Ideal.comap g Q).height := by exact_mod_cast hdim
    rw [hdim', hpd]

  obtain ⟨U, hU, V, hV, hzV, e, hss⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := d) (f := q) z
  obtain ⟨g₀, -, hg₀⟩ := hss.exists_etale_mvPolynomial
  have hUtop : U = ⊤ := by
    have h1 : q z ∈ U := e hzV
    refine eq_top_iff.mpr (fun w _ => ?_)
    rwa [Subsingleton.elim w (q z)]
  subst hUtop
  let e₀ : K ≃+* Γ(Spec (.of K), ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of K)).symm.commRingCatIsoToRingEquiv
  let g := g₀.comp (MvPolynomial.mapEquiv (Fin d) e₀).toRingHom
  have hg : g.Etale := RingHom.Etale.respectsIso.2 g₀ (MvPolynomial.mapEquiv (Fin d) e₀) hg₀

  obtain ⟨x, hx⟩ : ∃ x : V, (x : Z) = z := ⟨⟨z, hzV⟩, rfl⟩
  subst hx
  have hQmax : (hV.primeIdealOf x).asIdeal.IsMaximal := by
    haveI := hV.isOpenImmersion_fromSpec
    have hinj := hV.fromSpec.isOpenEmbedding.injective
    have hpre : hV.fromSpec ⁻¹' {(x : Z)} = {hV.primeIdealOf x} := by
      ext w
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hw
        apply hinj
        rw [hw, hV.fromSpec_primeIdealOf]
      · intro hw
        rw [hw, hV.fromSpec_primeIdealOf]
    have hc : IsClosed ({hV.primeIdealOf x} : Set (Spec Γ(Z, V))) := by
      rw [← hpre]
      exact hcl.preimage hV.fromSpec.continuous
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal (hV.primeIdealOf x)).mp hc

  haveI := hQmax.isPrime
  haveI := hV.isLocalization_stalk x
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height (hV.primeIdealOf x).asIdeal
    (Z.presheaf.stalk (x : Z)), key _ g hg _ hQmax]
  rfl

theorem wc_lfi_rational_fibre_maxIdeal : ∀ (K L : Type u) [Field K] [Field L] (τ : K →+* L) (Z Y : Scheme.{u}) (q : Z ⟶ Spec (.of K)) (p : Y ⟶ Spec (.of L)) (s : Y ⟶ Z), IsPullback s p q (Spec.map (CommRingCat.ofHom τ)) → ∀ (σ : Spec (.of K) ⟶ Z), σ ≫ q = 𝟙 _ → ∀ (y : Y), s y ∈ Set.range σ → Ideal.map (s.stalkMap y).hom (IsLocalRing.maximalIdeal (Z.presheaf.stalk (s y))) = IsLocalRing.maximalIdeal (Y.presheaf.stalk y) :=
by
  intro K L _ _ τ Z Y q p s pb σ hσ y hsy

  have s1 : ∀ (z : Z), z ∈ Set.range σ → ∃ e : Z.presheaf.stalk z ⟶ Z.presheaf.stalk z,
      Z.fromSpecStalk z ≫ q ≫ σ = Spec.map e ≫ Z.fromSpecStalk z ∧
      ∀ a : Z.presheaf.stalk z, a - e.hom a ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z) := by
    rintro _ ⟨w, rfl⟩
    obtain rfl : w = IsLocalRing.closedPoint K := Subsingleton.elim _ _
    have hχ : Spec.map (Scheme.stalkClosedPointTo σ) ≫ Z.fromSpecStalk _ = σ :=
      Scheme.Spec_stalkClosedPointTo_fromSpecStalk σ
    have hκ : Spec.map (Spec.preimage (Z.fromSpecStalk (σ (IsLocalRing.closedPoint K)) ≫ q)) =
        Z.fromSpecStalk _ ≫ q := Spec.map_preimage _
    have hret : Spec.preimage (Z.fromSpecStalk (σ (IsLocalRing.closedPoint K)) ≫ q) ≫
        Scheme.stalkClosedPointTo σ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, hκ, ← Category.assoc, hχ, hσ, Spec.map_id]
    have hret' : ∀ k, (Scheme.stalkClosedPointTo σ).hom
        ((Spec.preimage (Z.fromSpecStalk (σ (IsLocalRing.closedPoint K)) ≫ q)).hom k) = k := by
      intro k
      rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, hret]
      rfl
    refine ⟨Scheme.stalkClosedPointTo σ ≫
      Spec.preimage (Z.fromSpecStalk (σ (IsLocalRing.closedPoint K)) ≫ q), ?_, ?_⟩
    · rw [Spec.map_comp, Category.assoc, hχ, hκ, Category.assoc]
    · intro a
      have h0 : (Scheme.stalkClosedPointTo σ).hom (a - (Scheme.stalkClosedPointTo σ ≫
          Spec.preimage (Z.fromSpecStalk (σ (IsLocalRing.closedPoint K)) ≫ q)).hom a) = 0 := by
        rw [map_sub, CommRingCat.hom_comp, RingHom.comp_apply, hret', sub_self]
      by_contra hn
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hn
      have hu := hn.map (Scheme.stalkClosedPointTo σ).hom
      rw [h0] at hu
      exact not_isUnit_zero hu

  have s2 : ∀ (σ' : Spec (.of L) ⟶ Y) (y : Y), y ∈ Set.range σ' → ∀ (C : CommRingCat.{u})
      (π : Y.presheaf.stalk y ⟶ C) (k : Spec C ⟶ Spec (.of L)),
      Spec.map π ≫ Y.fromSpecStalk y = k ≫ σ' →
      ∀ b ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y), π.hom b = 0 := by
    rintro σ' _ ⟨w, rfl⟩ C π k hk b hb
    obtain rfl : w = IsLocalRing.closedPoint L := Subsingleton.elim _ _
    have hχ : Spec.map (Scheme.stalkClosedPointTo σ') ≫ Y.fromSpecStalk _ = σ' :=
      Scheme.Spec_stalkClosedPointTo_fromSpecStalk σ'
    have hπ : π = Scheme.stalkClosedPointTo σ' ≫ Spec.preimage k := by
      apply Spec.map_injective
      rw [← cancel_mono (Y.fromSpecStalk _), hk, Spec.map_comp, Spec.map_preimage,
        Category.assoc, hχ]
    have h0 : (Scheme.stalkClosedPointTo σ').hom b = 0 := by
      by_contra hne
      have hu : IsUnit ((Scheme.stalkClosedPointTo σ').hom b) := isUnit_iff_ne_zero.mpr hne
      exact (IsLocalRing.mem_maximalIdeal _).mp hb (isUnit_of_map_unit _ b hu)
    rw [hπ, CommRingCat.hom_comp, RingHom.comp_apply, h0, map_zero]

  set I := Ideal.map (s.stalkMap y).hom (IsLocalRing.maximalIdeal (Z.presheaf.stalk (s y)))
    with hIdef
  have hle : I ≤ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) :=
    IsLocalRing.map_maximalIdeal_le (s.stalkMap y).hom
  refine le_antisymm hle ?_
  have hI : I ≠ ⊤ := fun h =>
    (IsLocalRing.maximalIdeal.isMaximal _).ne_top (top_le_iff.mp (h ▸ hle))
  haveI : Nontrivial (Y.presheaf.stalk y ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  haveI : IsLocalRing (Y.presheaf.stalk y ⧸ I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  let C : CommRingCat.{u} := CommRingCat.of (Y.presheaf.stalk y ⧸ I)
  let πc : Y.presheaf.stalk y ⟶ C := CommRingCat.ofHom (Ideal.Quotient.mk I)
  haveI : IsLocalHom πc.hom := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  obtain ⟨h, hh⟩ : ∃ h : Spec C ⟶ Y, h = Spec.map πc ≫ Y.fromSpecStalk y := ⟨_, rfl⟩

  obtain ⟨e, he1, he2⟩ := s1 (s y) hsy
  have hhs : h ≫ s = Spec.map (s.stalkMap y ≫ πc) ≫ Z.fromSpecStalk (s y) := by
    rw [hh, Spec.map_comp, Category.assoc, Category.assoc,
      Scheme.SpecMap_stalkMap_fromSpecStalk]
  have hkill : e ≫ s.stalkMap y ≫ πc = s.stalkMap y ≫ πc := by
    ext a
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rw [← sub_eq_zero, ← map_sub, ← map_sub]
    have hm : e.hom a - a ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk (s y)) := by
      rw [← neg_sub]; exact neg_mem (he2 a)
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hm)
  have H4 : h ≫ s ≫ q ≫ σ = h ≫ s := by
    rw [← Category.assoc h s, hhs, Category.assoc, he1, ← Category.assoc, ← Spec.map_comp, hkill]

  have hw : (Spec.map (CommRingCat.ofHom τ) ≫ σ) ≫ q = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom τ) := by
    rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]
  obtain ⟨σ', hσ's, hσ'p⟩ : ∃ σ' : Spec (.of L) ⟶ Y,
      σ' ≫ s = Spec.map (CommRingCat.ofHom τ) ≫ σ ∧ σ' ≫ p = 𝟙 _ :=
    ⟨pb.lift _ _ hw, pb.lift_fst _ _ hw, pb.lift_snd _ _ hw⟩

  have H6 : h = (h ≫ p) ≫ σ' := by
    apply pb.hom_ext
    · symm
      simp only [Category.assoc, hσ's]
      rw [← Category.assoc p, ← pb.w, Category.assoc, H4]
    · rw [Category.assoc, hσ'p, Category.comp_id]

  obtain ⟨c, hc⟩ : ∃ c : Spec C, Spec.map πc c = IsLocalRing.closedPoint (Y.presheaf.stalk y) :=
    ⟨IsLocalRing.closedPoint C, IsLocalRing.comap_closedPoint πc.hom⟩
  have hhcp : h c = y := by
    rw [hh, Scheme.Hom.comp_apply, hc, Scheme.fromSpecStalk_closedPoint]
  have hyr : y ∈ Set.range σ' :=
    ⟨(h ≫ p) c, by rw [← Scheme.Hom.comp_apply, ← H6, hhcp]⟩

  intro b hb
  have hb0 := s2 σ' y hyr C πc (h ≫ p) (by rw [← H6, hh]) b hb
  exact Ideal.Quotient.eq_zero_iff_mem.mp hb0

theorem wc_lfi_fromSpecStalk_weaklyEtale : ∀ (X : Scheme.{u}) (x : X), WeaklyEtale (X.fromSpecStalk x) :=
by
  have hLoc : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L] (M : Submonoid A)
      [IsLocalization M L], Algebra.WeaklyEtale A L := by
    intro A L _ _ _ M _
    haveI hc : TensorProduct.CompatibleSMul A L L L :=
      IsLocalization.tensorProduct_compatibleSMul M L L L
    have key : ∀ z : TensorProduct A L L,
        z = (Algebra.TensorProduct.lmul' A (S := L) z) ⊗ₜ[A] (1 : L) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero, TensorProduct.zero_tmul]
      | tmul a b =>
        rw [Algebra.TensorProduct.lmul'_apply_tmul]
        have h := TensorProduct.smul_tmul (R := A) b a (1 : L)
        rw [smul_eq_mul, smul_eq_mul, mul_one, mul_comm b a] at h
        exact h.symm
      | add x y hx hy =>
        rw [map_add, TensorProduct.add_tmul, ← hx, ← hy]
    have hbij : Function.Bijective (Algebra.TensorProduct.lmul' A (S := L)) := by
      refine ⟨fun z₁ z₂ h => ?_, fun c => ⟨c ⊗ₜ[A] (1 : L), ?_⟩⟩
      · rw [key z₁, key z₂, h]
      · rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
    exact Algebra.WeaklyEtale.mk (IsLocalization.flat L M)
      (RingHom.Flat.of_bijective (f := (Algebra.TensorProduct.lmul' A (S := L)).toRingHom) hbij)
  have hSpec : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], Algebra.WeaklyEtale R S →
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
    intro R S _ _ _ hwe
    haveI := hwe
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact RingHom.flat_algebraMap_iff.mpr (Algebra.WeaklyEtale.flat (R := R) (S := S))
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R S)))) := by
      rw [diagonal_SpecMap]
      haveI : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) :=
        HasRingHomProperty.Spec_iff.mpr (Algebra.WeaklyEtale.flat_lmul' R S)
      infer_instance
    exact WeaklyEtale.mk hf hd
  intro X x
  obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
  rw [← hW.fromSpecStalk_eq_fromSpecStalk hxW, IsAffineOpen.fromSpecStalk.eq_1]
  letI : Algebra Γ(X, W) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : W)
  haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x) (hW.primeIdealOf ⟨x, hxW⟩).asIdeal :=
    hW.isLocalization_stalk ⟨x, hxW⟩
  have h5 : Algebra.WeaklyEtale Γ(X, W) (X.presheaf.stalk x) :=
    hLoc Γ(X, W) (X.presheaf.stalk x) (hW.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
  have h6 : WeaklyEtale (Spec.map (X.presheaf.germ W x hxW)) :=
    hSpec _ _ h5
  haveI : MorphismProperty.IsStableUnderComposition @WeaklyEtale :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  exact MorphismProperty.comp_mem @WeaklyEtale _ _ h6 inferInstance

theorem wc_lfi_local_spec_fibre : ∀ (X : Scheme.{u}) (x : X) (A : Type u) [CommRing A] [IsLocalRing A] (ι : X.presheaf.stalk x ⟶ CommRingCat.of A) [IsLocalHom ι.hom], Ideal.map ι.hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) = IsLocalRing.maximalIdeal A → (∀ a : A, ∃ b, a - ι.hom b ∈ IsLocalRing.maximalIdeal A) → (Spec.map ι ≫ X.fromSpecStalk x) ⁻¹' {x} = {IsLocalRing.closedPoint A} ∧ IsIso (Limits.pullback.snd (Spec.map ι ≫ X.fromSpecStalk x) (X.fromSpecResidueField x)) :=
by
  intro X x A _ _ ι _ hm hr
  have bij_aux : ∀ (P A : Type u) [CommRing P] [IsLocalRing P] [CommRing A] [IsLocalRing A]
      [Algebra P A],
      Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal A →
      (∀ a : A, ∃ b : P, a - algebraMap P A b ∈ IsLocalRing.maximalIdeal A) →
      Function.Bijective (Algebra.TensorProduct.includeRight :
        IsLocalRing.ResidueField P →ₐ[P] TensorProduct P A (IsLocalRing.ResidueField P)) := by
    intro P A _ _ _ _ _ hm hr
    have hzero : ∀ n ∈ IsLocalRing.maximalIdeal A,
        (n ⊗ₜ[P] (1 : IsLocalRing.ResidueField P)) = 0 := by
      intro n hn
      rw [← hm] at hn
      induction hn using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨p, hp, rfl⟩ := hy
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
          IsLocalRing.ResidueField.algebraMap_eq, (IsLocalRing.residue_eq_zero_iff p).mpr hp,
          TensorProduct.tmul_zero]
      | zero => exact TensorProduct.zero_tmul _ _
      | add y z _ _ hy hz => rw [TensorProduct.add_tmul, hy, hz, add_zero]
      | smul a y _ hy =>
        rw [smul_eq_mul]
        have : (a * y) ⊗ₜ[P] (1 : IsLocalRing.ResidueField P) =
            (a ⊗ₜ[P] (1 : IsLocalRing.ResidueField P)) *
              (y ⊗ₜ[P] (1 : IsLocalRing.ResidueField P)) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        rw [this, hy, mul_zero]
    have hsurj : Function.Surjective (Algebra.TensorProduct.includeRight :
        IsLocalRing.ResidueField P →ₐ[P] TensorProduct P A (IsLocalRing.ResidueField P)) := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => exact ⟨0, map_zero _⟩
      | tmul a c =>
        obtain ⟨p, rfl⟩ := IsLocalRing.residue_surjective c
        obtain ⟨b, hb⟩ := hr (p • a)
        refine ⟨IsLocalRing.residue P b, ?_⟩
        rw [Algebra.TensorProduct.includeRight_apply]
        have e1 : a ⊗ₜ[P] (IsLocalRing.residue P p) =
            (p • a) ⊗ₜ[P] (1 : IsLocalRing.ResidueField P) := by
          rw [← IsLocalRing.ResidueField.algebraMap_eq, Algebra.algebraMap_eq_smul_one,
            TensorProduct.smul_tmul]
        have e2 : (p • a) = algebraMap P A b + (p • a - algebraMap P A b) := by ring
        rw [e1, e2, TensorProduct.add_tmul, hzero _ hb, add_zero, Algebra.algebraMap_eq_smul_one,
          TensorProduct.smul_tmul, Algebra.smul_def, mul_one, IsLocalRing.ResidueField.algebraMap_eq]
      | add y z hy hz =>
        obtain ⟨c, hc⟩ := hy
        obtain ⟨c', hc'⟩ := hz
        exact ⟨c + c', by rw [map_add, hc, hc']⟩
    have hnt : Nontrivial (TensorProduct P A (IsLocalRing.ResidueField P)) := by
      have e := Algebra.TensorProduct.quotIdealMapEquivTensorQuot A (IsLocalRing.maximalIdeal P)
      rw [hm] at e
      haveI : Nontrivial (A ⧸ IsLocalRing.maximalIdeal A) := inferInstance
      exact e.symm.toEquiv.nontrivial
    refine ⟨?_, hsurj⟩
    exact (Algebra.TensorProduct.includeRight :
        IsLocalRing.ResidueField P →ₐ[P]
          TensorProduct P A (IsLocalRing.ResidueField P)).toRingHom.injective
  constructor
  · ext q
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply, Spec.map_apply]
    have hinj := (IsPreimmersion.isEmbedding (X.fromSpecStalk x)).injective
    constructor
    · intro hq
      have h1 : PrimeSpectrum.comap ι.hom q = IsLocalRing.closedPoint (X.presheaf.stalk x) :=
        hinj (hq.trans Scheme.fromSpecStalk_closedPoint.symm)
      have h2 : Ideal.comap ι.hom q.asIdeal = IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
        congrArg PrimeSpectrum.asIdeal h1
      have h3 : IsLocalRing.maximalIdeal A ≤ q.asIdeal := by
        rw [← hm, Ideal.map_le_iff_le_comap, h2]
      exact PrimeSpectrum.ext
        ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le q.isPrime.ne_top h3).symm
    · rintro rfl
      rw [IsLocalRing.comap_closedPoint, Scheme.fromSpecStalk_closedPoint]
  · letI : Algebra (X.presheaf.stalk x) A := ι.hom.toAlgebra
    have hbij := bij_aux (X.presheaf.stalk x) A hm hr
    have aux : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S), Function.Bijective f.hom →
        IsIso (Spec.map f) := fun f hf => by
      haveI := (ConcreteCategory.isIso_iff_bijective f).mpr hf
      infer_instance
    have hP : IsPullback
        (Limits.pullback.fst (Spec.map ι) (Spec.map (X.residue x)))
        (Limits.pullback.snd (Spec.map ι) (Spec.map (X.residue x)))
        (Spec.map ι ≫ X.fromSpecStalk x) (X.fromSpecResidueField x) :=
      IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono (Spec.map ι)
        (Spec.map (X.residue x)) (X.fromSpecStalk x))
    rw [← hP.isoPullback_inv_snd]
    have key : IsIso (Limits.pullback.snd (Spec.map ι) (Spec.map (X.residue x))) := by
      change IsIso (Limits.pullback.snd
        (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) A)))
        (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
            (IsLocalRing.ResidueField (X.presheaf.stalk x))))))
      rw [← pullbackSpecIso_hom_snd]
      exact IsIso.comp_isIso' inferInstance (aux _ hbij)
    infer_instance

theorem wc_lfi_s0_isPullback : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F))) (h : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) (E : Type u) [Field E] [Algebra F E] (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))) (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt)) (τ : E →ₐ[F] AlgebraicClosure F), s₀.left ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) = Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫ Spec.map (CommRingCat.ofHom τ.toRingHom) → IsPullback s₀.left (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))) (Spec.map (CommRingCat.ofHom τ.toRingHom)) :=
by
  intro F _ X h E _ _ hU s₀ τ hτ
  have hTop : s₀.left ≫ Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
      Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :=
    MorphismProperty.Over.w s₀
  have hBot : Spec.map (CommRingCat.ofHom τ.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F E)) =
      Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) := by
    rw [← Spec.map_comp]
    congr 1
    ext x
    exact τ.commutes x
  have hO : IsPullback (s₀.left ≫ Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F E))))
      (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      X.hom
      (Spec.map (CommRingCat.ofHom τ.toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F E))) := by
    rw [hTop, hBot]
    exact IsPullback.of_hasPullback _ _
  exact IsPullback.of_right hO hτ (IsPullback.of_hasPullback _ _)

theorem wc_ldp_il_stalk_of_smooth_field (E : Type u) [Field E] {Z : Scheme.{u}}
    (s : Z ⟶ Spec (.of E)) (m : ℕ) [SmoothOfRelativeDimension m s] (z : Z) :
    letI := (wcLdpConst E s z).toAlgebra
    Algebra.FormallySmooth E (Z.presheaf.stalk z) ∧
      Module.Free (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄E] ∧
      Module.Finite (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄E] ∧
      Module.finrank (Z.presheaf.stalk z) Ω[Z.presheaf.stalk z⁄E] = m ∧
      Algebra.EssFiniteType E (Z.presheaf.stalk z) :=
by

  have alg : ∀ (C L : Type u) [CommRing C] [CommRing L] [Algebra C L] (f : E →+* C)
      (_hf : RingHom.IsStandardSmoothOfRelativeDimension m f)
      (q : Ideal C) [q.IsPrime] [IsLocalization.AtPrime L q]
      (g : E →+* L), g = (algebraMap C L).comp f →
      letI := g.toAlgebra
      Algebra.FormallySmooth E L ∧ Module.Free L Ω[L⁄E] ∧ Module.Finite L Ω[L⁄E] ∧
        Module.finrank L Ω[L⁄E] = m ∧ Algebra.EssFiniteType E L := by
    intro C L _ _ _ f hf q _ _ g hg
    subst hg
    letI : Algebra E C := f.toAlgebra
    letI : Algebra E L := ((algebraMap C L).comp f).toAlgebra
    haveI : IsScalarTower E C L := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.IsStandardSmoothOfRelativeDimension m E C :=
      RingHom.IsStandardSmoothOfRelativeDimension.toAlgebra m hf
    haveI : Algebra.IsStandardSmooth E C :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth m
    haveI : Algebra.FormallySmooth E C := inferInstance
    haveI : Algebra.FinitePresentation E C := Algebra.IsStandardSmooth.finitePresentation
    haveI : Algebra.FiniteType E C := Algebra.FiniteType.of_finitePresentation
    haveI : Algebra.EssFiniteType E C := Algebra.EssFiniteType.of_finiteType E C
    haveI : Module.Free C Ω[C⁄E] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    haveI : Module.Finite C Ω[C⁄E] := KaehlerDifferential.finite E C
    haveI : Nontrivial C := by
      refine ⟨⟨0, 1, fun h => ?_⟩⟩
      apply (‹q.IsPrime›).ne_top
      rw [Ideal.eq_top_iff_one, ← h]
      exact q.zero_mem
    haveI : IsLocalRing L := IsLocalization.AtPrime.isLocalRing L q
    have hrkC : Module.finrank C Ω[C⁄E] = m :=
      Module.finrank_eq_of_rank_eq
        (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential m)
    haveI : Algebra.FormallyEtale C L := Algebra.FormallyEtale.of_isLocalization q.primeCompl
    haveI : Algebra.FormallySmooth C L := Algebra.FormallySmooth.of_isLocalization q.primeCompl
    haveI : Algebra.EssFiniteType C L := Algebra.EssFiniteType.of_isLocalization L q.primeCompl
    obtain ⟨Φ, -⟩ : ∃ Φ : TensorProduct C L Ω[C⁄E] ≃ₗ[L] Ω[L⁄E],
        Φ = KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale E C L := ⟨_, rfl⟩
    refine ⟨Algebra.FormallySmooth.comp E C L, Module.Free.of_equiv Φ, Module.Finite.equiv Φ,
      ?_, Algebra.EssFiniteType.comp E C L⟩
    rw [← LinearEquiv.finrank_eq Φ, Module.finrank_baseChange, hrkC]

  obtain ⟨U, hU, V, hV, hz, e, hstd⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := m) (f := s) z
  have hUtop : U = ⊤ := by
    have hsz : s z ∈ U := e hz
    rw [eq_top_iff]
    intro p _
    rwa [Subsingleton.elim p (s z)]
  subst hUtop
  have h0 : RingHom.IsStandardSmoothOfRelativeDimension 0
      (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom :=
    RingHom.IsStandardSmoothOfRelativeDimension.equiv
      ((Scheme.ΓSpecIso (CommRingCat.of E)).symm.commRingCatIsoToRingEquiv)
  have hf : RingHom.IsStandardSmoothOfRelativeDimension m
      ((s.appLE ⊤ V e).hom.comp (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom) :=
    hstd.comp h0
  letI : Algebra Γ(Z, V) (Z.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hz⟩
  haveI : IsLocalization.AtPrime (Z.presheaf.stalk z) (hV.primeIdealOf ⟨z, hz⟩).asIdeal :=
    hV.isLocalization_stalk ⟨z, hz⟩
  have key : s.appTop ≫ Z.presheaf.germ ⊤ z trivial = s.appLE ⊤ V e ≫ Z.presheaf.germ V z hz := by
    rw [Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    rfl
  have hg : wcLdpConst E s z = (algebraMap Γ(Z, V) (Z.presheaf.stalk z)).comp
      ((s.appLE ⊤ V e).hom.comp (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom) := by
    ext c
    exact congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom c)) key
  exact alg Γ(Z, V) (Z.presheaf.stalk z) _ hf (hV.primeIdealOf ⟨z, hz⟩).asIdeal _ hg

theorem wc_lfi_rational_point_generators : ∀ (E : Type u) [Field E] (Z : Scheme.{u}) (q : Z ⟶ Spec (.of E)) (d : ℕ) [SmoothOfRelativeDimension d q] (σ : Spec (.of E) ⟶ Z), σ ≫ q = 𝟙 _ → ∀ z : Z, z ∈ Set.range σ → ∃ b : Fin d → Z.presheaf.stalk z, Ideal.span (Set.range b) = IsLocalRing.maximalIdeal (Z.presheaf.stalk z) :=
by
  intro E _ Z q d _ σ hσ z hz

  have hpad : ∀ (R : Type u) [CommRing R] (I : Ideal R) (n : ℕ), I.FG →
      Submodule.spanFinrank I ≤ n → ∃ b : Fin n → R, Ideal.span (Set.range b) = I := by
    intro R _ I n hFG hle
    obtain ⟨s, hs, hspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hFG
    have hfin : s.Finite := Set.finite_of_encard_eq_coe hs
    set t := hfin.toFinset with ht
    have hcard : t.card = Submodule.spanFinrank I := by
      have h1 := hfin.encard_eq_coe_toFinset_card
      rw [hs] at h1
      exact_mod_cast h1.symm
    let e := t.equivFin
    refine ⟨fun i => if h : (i : ℕ) < t.card then ((e.symm ⟨i, h⟩ : t) : R) else 0, ?_⟩
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      simp only
      split_ifs with h
      · have hmem : ((e.symm ⟨i, h⟩ : t) : R) ∈ s := hfin.mem_toFinset.mp (e.symm ⟨i, h⟩).2
        rw [← hspan]
        exact Submodule.subset_span hmem
      · exact zero_mem _
    · rw [← hspan]
      apply Submodule.span_mono
      intro x hx
      have hxt : x ∈ t := hfin.mem_toFinset.mpr hx
      refine ⟨⟨(e ⟨x, hxt⟩ : ℕ), lt_of_lt_of_le (e ⟨x, hxt⟩).2 (hcard ▸ hle)⟩, ?_⟩
      simp only [Fin.is_lt, dif_pos]
      simp

  have hres : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [Algebra E O] (r : O →+* E),
      r.comp (algebraMap E O) = RingHom.id E →
      Algebra.FormallySmooth E (IsLocalRing.ResidueField O) := by
    intro O _ _ _ r hr
    have hinj : Function.Injective (algebraMap E (IsLocalRing.ResidueField O)) :=
      (algebraMap E (IsLocalRing.ResidueField O)).injective
    have hsurj : Function.Surjective (algebraMap E (IsLocalRing.ResidueField O)) := by
      intro y
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
      refine ⟨r a, ?_⟩
      have hx : a - algebraMap E O (r a) ∈ IsLocalRing.maximalIdeal O := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        have h1 := hu.map r
        have h2 : r (a - algebraMap E O (r a)) = 0 := by
          rw [map_sub, ← RingHom.comp_apply, hr, RingHom.id_apply, sub_self]
        rw [h2] at h1
        exact not_isUnit_zero h1
      rw [IsScalarTower.algebraMap_apply E O (IsLocalRing.ResidueField O),
        IsLocalRing.ResidueField.algebraMap_eq]
      symm
      rw [← sub_eq_zero, ← map_sub]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr hx
    exact Algebra.FormallySmooth.of_equiv
      (AlgEquiv.ofBijective (Algebra.ofId E (IsLocalRing.ResidueField O)) ⟨hinj, hsurj⟩)

  have hretr : ∃ r : Z.presheaf.stalk z →+* E, r.comp (wcLdpConst E q z) = RingHom.id E := by
    obtain ⟨w, rfl⟩ := hz
    obtain rfl : w = IsLocalRing.closedPoint E := Subsingleton.elim _ _
    refine ⟨(Scheme.stalkClosedPointTo σ).hom, ?_⟩
    have key : (Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫ q.appTop ≫
        Z.presheaf.germ ⊤ (σ (IsLocalRing.closedPoint E)) trivial ≫
        Scheme.stalkClosedPointTo σ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_comp, Spec.map_comp, Spec.map_id,
        ← Scheme.fromSpecStalk_toSpecΓ, ← Category.assoc,
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk]
      simp only [Category.assoc]
      rw [← Category.assoc Z.toSpecΓ, ← Scheme.toSpecΓ_naturality, Category.assoc,
        reassoc_of% hσ, toSpecΓ_SpecMap_ΓSpecIso_inv]
    have := congrArg CommRingCat.Hom.hom key
    simp only [CommRingCat.hom_comp, CommRingCat.hom_id] at this
    rw [← this]
    rfl
  obtain ⟨r, hr⟩ := hretr
  letI := (wcLdpConst E q z).toAlgebra
  obtain ⟨hFS, hFree, hFin, hrank, hEFT⟩ := wc_ldp_il_stalk_of_smooth_field E q d z
  haveI : IsNoetherianRing (Z.presheaf.stalk z) := Algebra.EssFiniteType.isNoetherianRing E _
  have hFSκ := hres (Z.presheaf.stalk z) r hr
  have hle := wcpa_embdim_le_rank_omega E (Z.presheaf.stalk z) hFS hFree hFin hFSκ
  rw [hrank] at hle
  exact hpad _ _ d (IsNoetherian.noetherian _) hle

theorem wc_lfi_closed_point_residue_algClosed : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (p : Y ⟶ Spec (.of K)) [LocallyOfFiniteType p] (y : Y), IsClosed ({y} : Set Y) → IsAlgClosed (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
by
  intro K _ _ Y p _ y hy
  haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace p
  haveI h2 : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
    isClosed_singleton_iff_locallyOfFiniteType.mp hy
  haveI h3 : LocallyOfFiniteType (Y.fromSpecResidueField y ≫ p) := inferInstance
  obtain ⟨φ, hφeq⟩ := Spec.map_surjective (Y.fromSpecResidueField y ≫ p)
  have h4 : LocallyOfFiniteType (Spec.map φ) := by rw [hφeq]; exact h3
  have hφ : φ.hom.FiniteType :=
    (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp h4
  letI : Algebra K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) := φ.hom.toAlgebra
  haveI : Algebra.FiniteType K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
    RingHom.finiteType_algebraMap.mp hφ
  haveI : Module.Finite K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
    finite_of_finite_type_of_isJacobsonRing K _
  haveI : Algebra.IsIntegral K (IsLocalRing.ResidueField (Y.presheaf.stalk y)) :=
    Algebra.IsIntegral.of_finite K _
  have hb := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K)
    (K := IsLocalRing.ResidueField (Y.presheaf.stalk y))
  exact IsAlgClosed.of_ringEquiv K _ (RingEquiv.ofBijective _ hb)

theorem wc_lfi_strict_nbhd (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (σ : Spec (.of E) ⟶ Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
    (hσ : σ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) = 𝟙 _)
    (t : ℕ → (wcGeomPoint F X h ⟶ wcGeomPoint F X h)) (ht0 : t 0 = 𝟙 _)
    (hts : ∀ j, t (j + 1) = wcGeomFrob F X h ≫ t j)
    (hfix : t (Module.finrank F E) ≫ s₀ = s₀)
    (xb : (wcGeomPoint F X h).left) (hxb : s₀.left ⁻¹' Set.range σ = {xb}) :
    ∃ (T : X.left.ProEt) (g : T ⟶ wcGeomPoint F X h) (φT : T ⟶ T)
      (A : Type u) (_ : CommRing A) (_ : IsNoetherianRing A) (_ : HenselianLocalRing A)
      (_ : IsSepClosed (IsLocalRing.ResidueField A)) (e : T.left ≅ Spec (.of A))
      (ρ : A →+* A) (f : Fin d → A)
      (VT : X.left.ProEt) (j : VT ⟶ T) (φV : VT ⟶ VT),
      φT ≫ g = g ≫ t (Module.finrank F E) ∧
      e.inv ≫ φT.left ≫ e.hom = Spec.map (CommRingCat.ofHom ρ) ∧
      (∀ i, ρ (f i) = f i) ∧
      Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A ∧
      ringKrullDim A = (d : WithBot ℕ∞) ∧
      IsUnit ((ℓ : ℕ) : A) ∧
      g.left ⁻¹' {xb} = {e.inv (IsLocalRing.closedPoint A)} ∧
      IsIso (Limits.pullback.snd g.left ((wcGeomPoint F X h).left.fromSpecResidueField xb)) ∧
      IsOpenImmersion j.left ∧
      Set.range j.left = {e.inv (IsLocalRing.closedPoint A)}ᶜ ∧
      φV ≫ j = j ≫ φT ∧
      CompactSpace T.left ∧
      QuasiSeparatedSpace (wcGeomPoint F X h).left ∧
      IsLocallyNoetherian (wcGeomPoint F X h).left :=
by
  classical

  have hfixL : (t (Module.finrank F E)).left ≫ s₀.left = s₀.left := congrArg (fun f => f.left) hfix
  have hxbmem : xb ∈ s₀.left ⁻¹' Set.range σ := by rw [hxb]; exact Set.mem_singleton xb
  have hsxb : s₀.left xb ∈ Set.range σ := hxbmem
  have hφx : (t (Module.finrank F E)).left xb = xb := by
    have h1 : (t (Module.finrank F E)).left xb ∈ s₀.left ⁻¹' Set.range σ := by
      show s₀.left ((t (Module.finrank F E)).left xb) ∈ Set.range σ
      rw [← Scheme.Hom.comp_apply, hfixL]
      exact hsxb
    rw [hxb] at h1
    exact h1
  have hxbc : IsClosed ({xb} : Set (wcGeomPoint F X h).left) := by
    haveI : IsClosedImmersion
        (σ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))) := by
      rw [hσ]; infer_instance
    haveI : IsClosedImmersion σ :=
      IsClosedImmersion.of_comp σ
        (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
    rw [← hxb]
    exact σ.isClosedEmbedding.isClosed_range.preimage s₀.left.continuous
  haveI hsm : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := by
    haveI := smoothOfRelativeDimension_isStableUnderBaseChange d
    exact MorphismProperty.of_isPullback (IsPullback.of_hasPullback X.hom _) inferInstance
  haveI hsmE : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F E)))) := by
    haveI := smoothOfRelativeDimension_isStableUnderBaseChange d
    exact MorphismProperty.of_isPullback (IsPullback.of_hasPullback X.hom _) inferInstance
  haveI hprop : IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (IsPullback.of_hasPullback X.hom _) inferInstance
  haveI hlft : LocallyOfFiniteType (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := inferInstance
  have hqsep : QuasiSeparated (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := by
    haveI := hprop; infer_instance
  have hqs : QuasiSeparatedSpace (wcGeomPoint F X h).left :=
    @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) inferInstance hqsep
  haveI hln : IsLocallyNoetherian (wcGeomPoint F X h).left :=
    @LocallyOfFiniteType.isLocallyNoetherian _ _ (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) hlft inferInstance
  haveI hWEc : MorphismProperty.IsStableUnderComposition @WeaklyEtale :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hℓF : IsUnit ((ℓ : ℕ) : F) := by
    rw [isUnit_iff_ne_zero]
    intro h0
    have := Fintype.ofFinite F
    have hp := CharP.char_is_prime F (ringChar F)
    have h1 : ringChar F ∣ ℓ := (CharP.cast_eq_zero_iff F (ringChar F) ℓ).mp h0
    have h2 : ringChar F ∣ Fintype.card F :=
      (CharP.cast_eq_zero_iff F (ringChar F) _).mp (FiniteField.cast_card_eq_zero F)
    rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd _ h1 with h3 | h3
    · exact hp.one_lt.ne' h3
    · apply hℓ; rw [← h3, Nat.card_eq_fintype_card]; exact h2

  obtain ⟨A, iA, iAh, iAn, ι, hιloc, hres, hmax, huniv, hwe⟩ :=
    wc_lfi_henselization_weaklyEtale ((wcGeomPoint F X h).left.presheaf.stalk xb)
  have hacP : IsAlgClosed (IsLocalRing.ResidueField ((wcGeomPoint F X h).left.presheaf.stalk xb)) :=
    @wc_lfi_closed_point_residue_algClosed (AlgebraicClosure F) _ _ (wcGeomPoint F X h).left
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      hlft xb hxbc
  have hsurjR : Function.Surjective (IsLocalRing.ResidueField.map ι) := by
    intro y
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨b, hb⟩ := hres a
    refine ⟨IsLocalRing.residue _ b, ?_⟩
    rw [IsLocalRing.ResidueField.map_residue, eq_comm, ← sub_eq_zero, ← map_sub,
      IsLocalRing.residue_eq_zero_iff]
    exact hb
  haveI hacA : IsAlgClosed (IsLocalRing.ResidueField A) :=
    IsAlgClosed.of_ringEquiv _ _
      (RingEquiv.ofBijective _ ⟨(IsLocalRing.ResidueField.map ι).injective, hsurjR⟩)
  have hsepA : IsSepClosed (IsLocalRing.ResidueField A) := inferInstance
  have hdimA : ringKrullDim A = ringKrullDim ((wcGeomPoint F X h).left.presheaf.stalk xb) := by
    letI : Algebra ((wcGeomPoint F X h).left.presheaf.stalk xb) A := ι.toAlgebra
    haveI : Module.Flat ((wcGeomPoint F X h).left.presheaf.stalk xb) A :=
      @Algebra.WeaklyEtale.flat _ _ _ _ _ hwe
    haveI : IsLocalHom (algebraMap ((wcGeomPoint F X h).left.presheaf.stalk xb) A) := hιloc
    exact wc_lfi_flat_local_dim_eq _ _ hmax
  have hdim : ringKrullDim A = (d : WithBot ℕ∞) :=
    hdimA.trans (@wc_lfi_smooth_stalk_dim (AlgebraicClosure F) _ (wcGeomPoint F X h).left
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      d hsm xb hxbc)

  obtain ⟨ι', hι'⟩ : ∃ ι' : (wcGeomPoint F X h).left.presheaf.stalk xb ⟶ CommRingCat.of A,
      ι'.hom = ι := ⟨CommRingCat.ofHom ι, rfl⟩
  haveI hι'loc : IsLocalHom ι'.hom := by rw [hι']; exact hιloc
  obtain ⟨γ, hγ⟩ : ∃ γ : Spec (CommRingCat.of A) ⟶ (wcGeomPoint F X h).left,
      γ = Spec.map ι' ≫ (wcGeomPoint F X h).left.fromSpecStalk xb := ⟨_, rfl⟩
  have hSW : WeaklyEtale (Spec.map ι') := by
    letI : Algebra ((wcGeomPoint F X h).left.presheaf.stalk xb) A := ι.toAlgebra
    have hι'eq : ι' = CommRingCat.ofHom ι := CommRingCat.hom_ext hι'
    rw [hι'eq]
    exact wc_lfi_specMap_weaklyEtale _ _ hwe
  have hγwe : WeaklyEtale γ := by
    rw [hγ]
    exact MorphismProperty.comp_mem @WeaklyEtale _ _ hSW
      (wc_lfi_fromSpecStalk_weaklyEtale (wcGeomPoint F X h).left xb)
  have hT : WeaklyEtale (γ ≫ (wcGeomPoint F X h).hom) :=
    MorphismProperty.comp_mem @WeaklyEtale γ (wcGeomPoint F X h).hom hγwe h
  let T : X.left.ProEt := MorphismProperty.Over.mk ⊤ (γ ≫ (wcGeomPoint F X h).hom) hT
  let g : T ⟶ wcGeomPoint F X h := MorphismProperty.Over.homMk γ rfl trivial

  obtain ⟨θ, hθloc, hθ1⟩ : ∃ θ : (wcGeomPoint F X h).left.presheaf.stalk xb ⟶
      (wcGeomPoint F X h).left.presheaf.stalk xb,
      IsLocalHom θ.hom ∧ Spec.map θ ≫ (wcGeomPoint F X h).left.fromSpecStalk xb =
        (wcGeomPoint F X h).left.fromSpecStalk xb ≫ (t (Module.finrank F E)).left := by
    refine ⟨((wcGeomPoint F X h).left.presheaf.stalkCongr (Inseparable.of_eq hφx)).inv ≫
      (t (Module.finrank F E)).left.stalkMap xb, ?_, ?_⟩
    · rw [CommRingCat.hom_comp]; infer_instance
    · have key : ∀ (y z : (wcGeomPoint F X h).left) (hy : y = z),
          Spec.map ((wcGeomPoint F X h).left.presheaf.stalkCongr (Inseparable.of_eq hy)).inv ≫
            (wcGeomPoint F X h).left.fromSpecStalk z = (wcGeomPoint F X h).left.fromSpecStalk y := by
        intro y z hy; subst hy; simp
      rw [Spec.map_comp, Category.assoc, key _ _ hφx, Scheme.SpecMap_stalkMap_fromSpecStalk]
  haveI := hθloc
  obtain ⟨ρ, ⟨hρloc, hρι⟩, -⟩ := huniv A (ι.comp θ.hom) (RingHom.isLocalHom_comp ι θ.hom)
  have hcomp : ι' ≫ CommRingCat.ofHom ρ = θ ≫ ι' := by
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, CommRingCat.hom_ofHom, hι']
    exact hρι
  have hI2 : Spec.map (CommRingCat.ofHom ρ) ≫ γ = γ ≫ (t (Module.finrank F E)).left := by
    rw [hγ, ← Category.assoc, ← Spec.map_comp, hcomp, Spec.map_comp]
    simp only [Category.assoc]
    rw [hθ1]
  have hw : Spec.map (CommRingCat.ofHom ρ) ≫ γ ≫ (wcGeomPoint F X h).hom =
      γ ≫ (wcGeomPoint F X h).hom := by
    rw [← Category.assoc, hI2, Category.assoc, MorphismProperty.Over.w (t (Module.finrank F E))]
  let φT : T ⟶ T := MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom ρ)) hw trivial
  have hφTg : φT ≫ g = g ≫ t (Module.finrank F E) := MorphismProperty.Over.Hom.ext hI2

  obtain ⟨τ, hτ⟩ := wc_rpc_s0_factor F X h E hU s₀
  have hpb := wc_lfi_s0_isPullback F X h E hU s₀ τ hτ
  have hrf := wc_lfi_rational_fibre_maxIdeal E (AlgebraicClosure F) τ.toRingHom _ _ _ _ s₀.left
    hpb σ hσ xb hsxb
  obtain ⟨b, hb⟩ := @wc_lfi_rational_point_generators E _
    (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt).left
    (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))) d hsmE σ hσ
    (s₀.left xb) hsxb
  let f : Fin d → A := fun i => ι ((s₀.left.stalkMap xb).hom (b i))
  have hspan : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A := by
    have e1 : Set.range f = ι '' ((s₀.left.stalkMap xb).hom '' Set.range b) := by
      rw [← Set.range_comp, ← Set.range_comp]; rfl
    have h2 : Ideal.map (s₀.left.stalkMap xb).hom (Ideal.span (Set.range b)) =
        IsLocalRing.maximalIdeal ((wcGeomPoint F X h).left.presheaf.stalk xb) :=
      (congrArg (Ideal.map (s₀.left.stalkMap xb).hom) hb).trans hrf
    rw [e1, ← Ideal.map_span, ← Ideal.map_span, h2]
    exact hmax
  have hA1 : Spec.map ((s₀.left.stalkMap xb) ≫ ι') ≫ Scheme.fromSpecStalk _ (s₀.left xb) =
      γ ≫ s₀.left := by
    rw [Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkMap_fromSpecStalk, ← Category.assoc,
      ← hγ]
  have hA2 : Spec.map (((s₀.left.stalkMap xb) ≫ ι') ≫ CommRingCat.ofHom ρ) ≫
      Scheme.fromSpecStalk _ (s₀.left xb) = γ ≫ s₀.left := by
    rw [Spec.map_comp, Category.assoc, hA1, ← Category.assoc, hI2, Category.assoc, hfixL]
  have hkey : ((s₀.left.stalkMap xb) ≫ ι') ≫ CommRingCat.ofHom ρ = (s₀.left.stalkMap xb) ≫ ι' := by
    apply Spec.map_injective
    rw [← cancel_mono (Scheme.fromSpecStalk _ (s₀.left xb)), hA2, hA1]
  have hρf : ∀ i, ρ (f i) = f i := by
    intro i
    have := congrArg (fun g => g.hom (b i)) hkey
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom, hι'] at this
    exact this

  have hmax' : Ideal.map ι'.hom (IsLocalRing.maximalIdeal ((wcGeomPoint F X h).left.presheaf.stalk xb))
      = IsLocalRing.maximalIdeal A := by rw [hι']; exact hmax
  have hres' : ∀ a : A, ∃ b, a - ι'.hom b ∈ IsLocalRing.maximalIdeal A := by rw [hι']; exact hres
  have hLF := wc_lfi_local_spec_fibre (wcGeomPoint F X h).left xb A ι' hmax' hres'
  rw [← hγ] at hLF

  let U' : (Spec (CommRingCat.of A)).Opens :=
    ⟨{IsLocalRing.closedPoint A}ᶜ, (IsLocalRing.isClosed_singleton_closedPoint A).isOpen_compl⟩
  have hVT : WeaklyEtale (U'.ι ≫ γ ≫ (wcGeomPoint F X h).hom) :=
    MorphismProperty.comp_mem @WeaklyEtale _ _ inferInstance hT
  let VT : X.left.ProEt := MorphismProperty.Over.mk ⊤ (U'.ι ≫ γ ≫ (wcGeomPoint F X h).hom) hVT
  let j : VT ⟶ T := MorphismProperty.Over.homMk U'.ι rfl trivial
  have hsub : Set.range (U'.ι ≫ Spec.map (CommRingCat.ofHom ρ)) ⊆ Set.range U'.ι := by
    rintro _ ⟨v, rfl⟩
    rw [Scheme.Opens.range_ι]
    intro hv
    have hv' : PrimeSpectrum.comap ρ v.1 = IsLocalRing.closedPoint A := hv
    have hle : IsLocalRing.maximalIdeal A ≤ (v.1 : PrimeSpectrum A).asIdeal := by
      rw [← hspan, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      have h1 : f i ∈ (PrimeSpectrum.comap ρ v.1).asIdeal := by
        rw [hv']
        show f i ∈ IsLocalRing.maximalIdeal A
        rw [← hspan]; exact Ideal.subset_span ⟨i, rfl⟩
      have h2 : ρ (f i) ∈ (v.1 : PrimeSpectrum A).asIdeal := h1
      rw [hρf i] at h2
      exact h2
    have heq := (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le
      (v.1 : PrimeSpectrum A).isPrime.ne_top hle
    exact v.2 (PrimeSpectrum.ext heq.symm)
  let L : (U' : Scheme) ⟶ (U' : Scheme) :=
    IsOpenImmersion.lift U'.ι (U'.ι ≫ Spec.map (CommRingCat.ofHom ρ)) hsub
  have hLfac : L ≫ U'.ι = U'.ι ≫ Spec.map (CommRingCat.ofHom ρ) := IsOpenImmersion.lift_fac _ _ hsub
  have hLw : L ≫ U'.ι ≫ γ ≫ (wcGeomPoint F X h).hom = U'.ι ≫ γ ≫ (wcGeomPoint F X h).hom := by
    rw [← Category.assoc, hLfac, Category.assoc, hw]
  let φV : VT ⟶ VT := MorphismProperty.Over.homMk L hLw trivial
  have hφV : φV ≫ j = j ≫ φT := MorphismProperty.Over.Hom.ext hLfac

  have hℓA : IsUnit ((ℓ : ℕ) : A) := by
    have := hℓF.map (ι.comp (((wcGeomPoint F X h).left.presheaf.germ ⊤ xb trivial).hom.comp
      ((((wcGeomPoint F X h).hom ≫ X.hom).appTop).hom.comp (Scheme.ΓSpecIso (.of F)).inv.hom)))
    rwa [map_natCast] at this
  have hTc : CompactSpace T.left := by
    show CompactSpace (Spec (CommRingCat.of A))
    infer_instance

  refine ⟨T, g, φT, A, iA, iAn, iAh, hsepA, Iso.refl _, ρ, f, VT, j, φV, hφTg, ?_, hρf, hspan, hdim,
    hℓA, ?_, ?_, ?_, ?_, hφV, hTc, hqs, hln⟩
  · exact (Category.id_comp _).trans (Category.comp_id _)
  · exact hLF.1
  · exact hLF.2
  · show IsOpenImmersion U'.ι
    infer_instance
  · show Set.range U'.ι = _
    rw [Scheme.Opens.range_ι]
    rfl

theorem wc_proet_free_projective_strict_local (S : Scheme.{u}) (V : S.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A)) : Projective (wcFreeSheaf S V) :=
by

  have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) → Algebra.WeaklyEtale R E := by
    intro R E _ _ _ hW
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
      hW.flat_diagonal
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
      RingHom.flat_algebraMap_iff] at hf
    rw [diagonal_SpecMap] at hd
    have hd' : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
      have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
            (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [heq]
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
    exact ⟨hf, hd'⟩

  have s7 : ∀ (E : Type u) [CommRing E] [Algebra A E],
      Algebra.WeaklyEtale A E → ∀ (p : Ideal E) [p.IsPrime],
      p.comap (algebraMap A E) = IsLocalRing.maximalIdeal A → Nonempty (E →ₐ[A] A) := by
    intro E _ _ hAE p _ hp
    haveI : Algebra.WeaklyEtale E (Localization.AtPrime p) :=
      wc_localization_weaklyEtale E (Localization.AtPrime p) p.primeCompl
    haveI := hAE
    haveI : Algebra.WeaklyEtale A (Localization.AtPrime p) := Algebra.WeaklyEtale.trans A E _
    have hloc : IsLocalHom (algebraMap A (Localization.AtPrime p)) := by
      have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
          (algebraMap A (Localization.AtPrime p)) = IsLocalRing.maximalIdeal A := by
        rw [IsScalarTower.algebraMap_eq A E (Localization.AtPrime p), ← Ideal.comap_comap]
        have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
            (algebraMap E (Localization.AtPrime p)) = p :=
          Localization.AtPrime.under_maximalIdeal
        rw [h2, hp]
      exact ((IsLocalRing.local_hom_TFAE (algebraMap A (Localization.AtPrime p))).out 1 5).mpr h1
    have hbij := wc_olivier A (Localization.AtPrime p) inferInstance inferInstance hloc inferInstance
    let eqv : A ≃ₐ[A] Localization.AtPrime p := AlgEquiv.ofBijective (Algebra.ofId A _) hbij
    exact ⟨eqv.symm.toAlgHom.comp (IsScalarTower.toAlgHom A E (Localization.AtPrime p))⟩

  have s5 : ∀ {U V : Scheme.{u}} (e : U ≅ Spec (.of A)) (g : V ⟶ U) [WeaklyEtale g] (v : V),
      e.hom (g v) = IsLocalRing.closedPoint A → ∃ σ : U ⟶ V, σ ≫ g = 𝟙 U := by
    intro U V e g _ v hv
    obtain ⟨E, ι, hι, hvι, -⟩ :=
      Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
    obtain ⟨w, hw⟩ := hvι
    have := hι
    let h : Spec E ⟶ Spec (.of A) := ι ≫ g ≫ e.hom
    have hWh : WeaklyEtale h := inferInstance
    let φ : CommRingCat.of A ⟶ E := Spec.preimage h
    have hφ : Spec.map φ = h := Spec.map_preimage h
    letI : Algebra A E := (CommRingCat.Hom.hom φ).toAlgebra
    have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A E))) := by
      change WeaklyEtale (Spec.map φ)
      rw [hφ]
      exact hWh
    have hAE : Algebra.WeaklyEtale A E := s6 A E hW'
    let p : PrimeSpectrum E := w
    have hq : (p.asIdeal).comap (algebraMap A E) = IsLocalRing.maximalIdeal A := by
      have h1 : (Spec.map φ) w = IsLocalRing.closedPoint A := by
        rw [hφ]
        show e.hom (g (ι w)) = _
        rw [hw, hv]
      exact congrArg PrimeSpectrum.asIdeal h1
    obtain ⟨τ⟩ := s7 E hAE p.asIdeal hq
    let τ' : E ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : E →+* A)
    have hret : φ ≫ τ' = 𝟙 _ := by
      ext r
      exact τ.commutes r
    refine ⟨e.hom ≫ Spec.map τ' ≫ ι, ?_⟩
    rw [← cancel_mono e.hom]
    simp only [Category.assoc, Category.id_comp]
    have h3 : ι ≫ g ≫ e.hom = Spec.map φ := hφ.symm
    rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]

  have s4 : ∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
      ∀ (W : S.ProEt) (a : W ⟶ U), Nonempty (W.left ≅ Spec (.of A)) →
      ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a := by
    intro U R hR W a ⟨eW⟩
    have hR' : Presieve.map (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
        (Scheme.precoverage @WeaklyEtale).coverings U.left := hR.2
    obtain ⟨Y', g', hg', y', hy'⟩ :=
      (Scheme.instJointlySurjectivePrecoverage (P := @WeaklyEtale)).exists_eq _ hR'
        (a.left (eW.inv (IsLocalRing.closedPoint A)))
    obtain ⟨Y, hY, g, hg, hgg⟩ := Presieve.map_iff.mp hg'
    subst hY
    have hgl : g.left = g' := hgg.trans (by simp only [eqToHom_refl]; exact Category.id_comp _)
    haveI : WeaklyEtale U.hom := U.prop
    haveI : WeaklyEtale (g.left ≫ U.hom) := by
      rw [MorphismProperty.Over.w g]; exact Y.prop
    haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
    obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := g.left)
      (eW.inv (IsLocalRing.closedPoint A)) y' (by rw [hgl]; exact hy'.symm)
    obtain ⟨σ, hσ⟩ := s5 eW (Limits.pullback.fst a.left g.left) z (by
      rw [hz1]
      change (eW.inv ≫ eW.hom) (IsLocalRing.closedPoint A) = _
      rw [Iso.inv_hom_id]
      rfl)
    have hh₀ : (σ ≫ Limits.pullback.snd a.left g.left) ≫ g.left = a.left := by
      rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
    refine ⟨Y, g, MorphismProperty.Over.homMk (σ ≫ Limits.pullback.snd a.left g.left) ?_ trivial,
      hg, ?_⟩
    · rw [← MorphismProperty.Over.w g, ← Category.assoc, hh₀, MorphismProperty.Over.w a]
    · apply MorphismProperty.Over.Hom.ext
      exact hh₀

  have s3 : ∀ (P : S.ProEt → Prop),
      (∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
        ∀ (W : S.ProEt) (a : W ⟶ U), P W →
          ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a) →
      ∀ (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U →
        ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a := by
    intro P hK
    let JP : GrothendieckTopology S.ProEt :=
      GrothendieckTopology.mk
        (fun U => {T : Sieve U | ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a})
        (by
          intro U W a _
          trivial)
        (by
          intro U Y T f hT W a hW
          rw [Sieve.pullback_apply]
          exact hT W (a ≫ f) hW)
        (by
          intro U T hT R hR W a hW
          have h1 := hR (hT W a hW) W (𝟙 W) hW
          rw [Sieve.pullback_apply, Category.id_comp] at h1
          exact h1)
    have hle : Scheme.ProEt.topology S ≤ JP := by
      rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
      intro U R hR
      show ∀ (W : S.ProEt) (a : W ⟶ U), P W → (Sieve.generate R).arrows a
      intro W a hW
      obtain ⟨Y, g, h, hg, hhg⟩ := hK U R hR W a hW
      exact ⟨Y, h, g, hg, hhg⟩
    intro U T hT W a hW
    have h1 : T ∈ JP U := GrothendieckTopology.le_def.mp hle U hT
    exact h1 W a hW

  obtain ⟨eF, heF, -⟩ := proet_free_sheaf_hom_equiv S V
  have hcov := s3 (fun W => Nonempty (W.left ≅ Spec (.of A))) s4
  refine ⟨fun {E X} f π _ => ?_⟩
  haveI : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S) π.hom :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} π).mpr inferInstance
  have hT := Presheaf.imageSieve_mem (Scheme.ProEt.topology S) π.hom (U := Opposite.op V) (eF X f)
  have h1 := hcov V _ hT V (𝟙 V) ⟨e⟩
  rw [Presheaf.imageSieve_apply] at h1
  obtain ⟨s, hs⟩ := h1
  refine ⟨(eF E).symm s, ?_⟩
  apply (eF X).injective
  rw [heF, Equiv.apply_symm_apply]
  exact hs.trans (by simp)

theorem wc_lpgi_geom_untwist (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (m d : ℕ) (hm : IsUnit ((m : ℕ) : AlgebraicClosure F)) :
    ∃ ψ : ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
          (wcGeomPoint F X h)).obj (wcRootTwist X.left m d) ⟶
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
          (wcGeomPoint F X h)).obj (wcZModSheaf X.left m),
      IsIso ψ ∧
      ∀ W : Over (wcGeomPoint F X h),
        ψ.hom.app (Opposite.op (Over.mk (W.hom ≫ 𝟙 (wcGeomPoint F X h)))) =
          (1 : ℕ) • ψ.hom.app (Opposite.op W) :=
by
  classical

  have wc_rtsp_locSurj_of_const : ∀ (S : Scheme.{u}) (U : S.ProEt) (m : ℕ)
      (P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (ρ : (Over.forget U).op ⋙ P ⟶
        (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj (wcZModSheaf S m)).obj),
      (∀ (V : Over U) (R : Sieve V),
        (∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
          ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) → R.arrows e) →
        R ∈ (Scheme.ProEt.topology S).over U V) →
      (∀ (V : Over U) (a : ZMod m), ∃ t : P.obj (Opposite.op V.left),
        ULift.down (ρ.app (Opposite.op V) t) = ContinuousMap.const V.left.left a) →
      Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U) ρ := by
    intro S U m P ρ hcov hconst
    refine ⟨fun {V} s => ?_⟩
    apply hcov V
    intro y
    let s' : C(V.left.left, ZMod m) := ULift.down s
    refine ⟨⟨s' ⁻¹' {s' y}, s'.continuous.isOpen_preimage _ (isOpen_discrete _)⟩,
      rfl, fun W e he => ?_⟩
    rw [Presheaf.imageSieve_apply]
    obtain ⟨t, ht⟩ := hconst W (s' y)
    refine ⟨t, ?_⟩
    apply ULift.ext
    refine ht.trans ?_
    apply ContinuousMap.ext
    intro z
    have hz : s' (e.left.left z) = s' y := he ⟨z, rfl⟩
    exact hz.symm
  have wc_rtsp_locInj_of_local_zero : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (Q : (Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ρ : (Over.forget U).op ⋙ P ⟶ Q),
      (∀ (V : Over U) (R : Sieve V),
        (∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
          ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) → R.arrows e) →
        R ∈ (Scheme.ProEt.topology S).over U V) →
      (∀ (V : Over U) (x : P.obj (Opposite.op V.left)), ρ.app (Opposite.op V) x = 0 →
        ∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
          ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) →
            P.map e.left.op x = 0) →
      Presheaf.IsLocallyInjective ((Scheme.ProEt.topology S).over U) ρ := by
    intro S U P Q ρ hcov hz
    refine ⟨fun {V} x₁ x₂ hx => ?_⟩
    apply hcov V.unop
    intro y
    have h0 : ρ.app V (x₁ - x₂) = 0 := by rw [map_sub, hx, sub_self]
    obtain ⟨O, hyO, hO⟩ := hz V.unop (x₁ - x₂) h0 y
    refine ⟨O, hyO, fun W e he => ?_⟩
    rw [Presheaf.equalizerSieve_apply]
    have h1 := hO W e he
    rw [map_sub, sub_eq_zero] at h1
    exact h1

  have hm0 : m ≠ 0 := by
    rintro rfl
    rw [Nat.cast_zero] at hm
    exact not_isUnit_zero hm
  haveI : NeZero m := ⟨hm0⟩
  haveI : NeZero ((m : ℕ) : AlgebraicClosure F) := ⟨hm.ne_zero⟩
  haveI := IsSepClosed.hasEnoughRootsOfUnity (AlgebraicClosure F) m
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure F) m

  have hprim : ∀ (V : Over (wcGeomPoint F X h)) (z : V.left.left),
      IsPrimitiveRoot ((V.left.left.evaluation ⊤ z trivial).hom
        ((V.hom.left ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ))) m := by
    intro V z
    let χ : AlgebraicClosure F →+* V.left.left.residueField z :=
      ((V.left.left.evaluation ⊤ z trivial).hom.comp
        ((V.hom.left ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom)).comp
        (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom
    exact hζ.map_of_injective (f := χ) χ.injective
  have hunit : ∀ V : Over (wcGeomPoint F X h), IsUnit ((m : ℕ) : Γ(V.left.left, ⊤)) := by
    intro V
    have := hm.map (((V.hom.left ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom).comp
        (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom)
    rwa [map_natCast] at this
  have hpow : ∀ V : Over (wcGeomPoint F X h),
      ((V.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ) :
            Γ(V.left.left, ⊤)) ^ m = 1 := by
    intro V
    rw [← map_pow, ← map_pow, hζ.pow_eq_one, map_one, map_one]
  have hnat : ∀ (V V' : Over (wcGeomPoint F X h)) (g : V' ⟶ V),
      ((V'.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ) :
            Γ(V'.left.left, ⊤)) =
        g.left.left.appTop.hom
          ((V.hom.left ≫ Limits.pullback.snd X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
              ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ)) := by
    intro V V' g
    have hw : g.left.left ≫ V.hom.left = V'.hom.left := by
      first
        | exact congrArg (fun k => k.left) (Over.w g)
        | (have hg := Over.w g; rw [← hg]; rfl)
        | (have hg := Over.w g; rw [← hg]; simp)
        | simp
    have key : V'.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        g.left.left ≫ (V.hom.left ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
      (congrArg (fun k => k ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) hw).symm.trans
        (Category.assoc _ _ _)
    first
      | (rw [key, Scheme.Hom.comp_appTop]; rfl)
      | exact (congrArg (fun φ => φ.appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ)) key).trans
          (by rw [Scheme.Hom.comp_appTop]; rfl)

  obtain ⟨ω, hω⟩ : ∃ ω : ∀ V : Over (wcGeomPoint F X h), Γ(V.left.left, ⊤), ∀ V, ω V =
      (V.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ) :=
    ⟨fun V => (V.hom.left ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).inv.hom ζ), fun V => rfl⟩
  have hprim' : ∀ (V : Over (wcGeomPoint F X h)) (z : V.left.left),
      IsPrimitiveRoot ((V.left.left.evaluation ⊤ z trivial).hom (ω V)) m := by
    intro V z; rw [hω]; exact hprim V z
  have hpow' : ∀ V : Over (wcGeomPoint F X h), ω V ^ m = 1 := by
    intro V; rw [hω]; exact hpow V
  have hnat' : ∀ (V V' : Over (wcGeomPoint F X h)) (g : V' ⟶ V),
      ω V' = g.left.left.appTop.hom (ω V) := by
    intro V V' g; rw [hω, hω]; exact hnat V V' g
  let ωu : ∀ V : Over (wcGeomPoint F X h), Additive (rootsOfUnity m Γ(V.left.left, ⊤)) :=
    fun V => Additive.ofMul (rootsOfUnity.mkOfPowEq (ω V) (hpow' V))
  have hωu : ∀ V : Over (wcGeomPoint F X h),
      (((Additive.toMul (ωu V) : rootsOfUnity m Γ(V.left.left, ⊤)) : Γ(V.left.left, ⊤)ˣ) :
        Γ(V.left.left, ⊤)) = ω V :=
    fun V => rootsOfUnity.val_mkOfPowEq_coe _ _

  choose L hL using fun V : Over (wcGeomPoint F X h) =>
    wc_rtsp_dlog_exists V.left.left m (ω V) (hprim' V)
  choose D hD using fun V : Over (wcGeomPoint F X h) =>
    (wc_rtsp_tensor_lift m d (Additive (rootsOfUnity m Γ(V.left.left, ⊤)))).2
      C(V.left.left, ZMod m) (L V)
  let G : (X.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
    (Scheme.ProEt.forget X.left ⋙ Over.forget X.left).op ⋙ Scheme.Γ ⋙ wcRootsFun.{u} m ⋙
      wcTwistFun.{u} m d
  let D' : ∀ V : Over (wcGeomPoint F X h), G.obj (Opposite.op V.left) →+ C(V.left.left, ZMod m) :=
    fun V => D V
  have hnatD : ∀ (V V' : Over (wcGeomPoint F X h)) (g : V' ⟶ V) (w : G.obj (Opposite.op V.left))
      (z : V'.left.left), D' V' (G.map g.left.op w) z = D' V w (g.left.left z) := by
    intro V V' g w z
    have hL' : ∀ (v : Additive (rootsOfUnity m Γ(V'.left.left, ⊤))) (z : V'.left.left) (j : ℕ),
        L V' v z = (j : ZMod m) ↔
          (V'.left.left.evaluation ⊤ z trivial).hom
              (((Additive.toMul v : rootsOfUnity m Γ(V'.left.left, ⊤)) : Γ(V'.left.left, ⊤)ˣ) :
                Γ(V'.left.left, ⊤)) =
            ((V'.left.left.evaluation ⊤ z trivial).hom (g.left.left.appTop.hom (ω V))) ^ j := by
      intro v z j; rw [← hnat' V V' g]; exact hL V' v z j
    exact wc_rtsp_dlog_tensor_natural V.left.left V'.left.left g.left.left m d (ω V) (L V) (L V')
      (D V) (D V') (hL V) hL' (hD V) (hD V') w z

  let ρ : (Over.forget (wcGeomPoint F X h)).op ⋙ (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ⟶
      (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcZModSheaf X.left m)).obj :=
    { app := fun V => AddCommGrpCat.ofHom (AddMonoidHom.mk'
          (fun x : ULift.{u+1} (G.obj (Opposite.op V.unop.left)) =>
            (ULift.up (D' V.unop x.down) : ULift.{u+1} C(V.unop.left.left, ZMod m)))
          (fun x y => by
            rw [show (x + y).down = x.down + y.down from rfl, map_add]
            rfl))
      naturality := fun V W f => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply ULift.ext
        apply ContinuousMap.ext
        intro z
        exact hnatD V.unop W.unop f.unop x.down z }
  have hρD : ∀ (V : Over (wcGeomPoint F X h)) (w : G.obj (Opposite.op V.left)),
      ULift.down (ρ.app (Opposite.op V) (ULift.up w)) = D' V w := fun V w => rfl
  have hcov := wc_rtsp_open_cover_mem X.left (wcGeomPoint F X h)

  have hinj : Presheaf.IsLocallyInjective
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) ρ := by
    refine wc_rtsp_locInj_of_local_zero X.left (wcGeomPoint F X h)
      (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) _ ρ hcov ?_
    intro V x hx y
    have hDx : D V x.down = 0 := by
      have h1 := (hρD V x.down).symm.trans (congrArg ULift.down hx)
      exact h1
    have H5 : ∀ (Z' : Scheme.{u}) (f : Z' ⟶ V.left.left)
        (v : Additive (rootsOfUnity m Γ(V.left.left, ⊤))) (k : ℕ),
        (∀ z' : Z', L V v (f z') = (k : ZMod m)) →
        MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) v =
          k • MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) (ωu V) :=
      fun Z' f v k hk => wc_rtsp_root_eq_of_dlog_const V.left.left m (ω V) (L V) (hunit V) (hL V)
        Z' f v (ωu V) k (hωu V) hk
    obtain ⟨O, hyO, hO⟩ := wc_rtsp_tensor_locally_pure V.left.left m d (ωu V) (L V) (D V) H5 (hD V)
      x.down y
    refine ⟨O, hyO, fun W e he => ?_⟩
    have h2 := hO W.left.left e.left.left he
    rw [hDx, ContinuousMap.zero_apply, TensorProduct.zero_tmul] at h2
    exact ULift.ext _ _ h2

  have hsurj : Presheaf.IsLocallySurjective
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) ρ := by
    refine wc_rtsp_locSurj_of_const X.left (wcGeomPoint F X h) m
      (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ρ hcov ?_
    intro V a
    have h1 : L V (ωu V) = 1 := by
      ext z
      have h3 := (hL V (ωu V) z 1).2 (by rw [hωu, pow_one])
      rw [h3]
      simp
    refine ⟨ULift.up ((a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin d => ωu V) :
      TensorProduct ℤ (ZMod m)
        (PiTensorProduct ℤ (fun _ : Fin d => Additive (rootsOfUnity m Γ(V.left.left, ⊤)))))), ?_⟩
    refine (hρD V _).trans ?_
    refine (hD V a _).trans ?_
    simp only [h1, Finset.prod_const_one]
    ext z
    simp

  have hscale1 : ∀ V : Over (wcGeomPoint F X h),
      ρ.app (Opposite.op (Over.mk (V.hom ≫ 𝟙 (wcGeomPoint F X h)))) =
        1 • ρ.app (Opposite.op V) := by
    intro V
    let g : Over.mk (V.hom ≫ 𝟙 (wcGeomPoint F X h)) ⟶ V :=
      Over.homMk (U := Over.mk (V.hom ≫ 𝟙 (wcGeomPoint F X h))) (V := V) (𝟙 V.left) (by simp)
    have hn := ρ.naturality g.op
    have e1 : ((Over.forget (wcGeomPoint F X h)).op ⋙
        (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u})).map g.op = 𝟙 _ :=
      (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map_id (Opposite.op V.left)
    have e2 : (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint F X h)).obj (wcZModSheaf X.left m)).obj.map g.op = 𝟙 _ :=
      (wcZModSheaf X.left m).obj.map_id (Opposite.op V.left)
    rw [e1, e2] at hn
    have key : ρ.app (Opposite.op (Over.mk (V.hom ≫ 𝟙 (wcGeomPoint F X h)))) =
        ρ.app (Opposite.op V) := by
      first
        | exact (Category.id_comp _).symm.trans (hn.trans (Category.comp_id _))
        | (erw [Category.id_comp, Category.comp_id] at hn; exact hn)
        | simpa using hn
    first
      | exact key.trans (one_smul ℕ _).symm
      | (rw [key]; exact (one_smul ℕ _).symm)
      | (erw [one_smul]; exact key)

  obtain ⟨ψ, hψiso, hψ⟩ := wc_slice_sheafify_scaled_iso X.left (wcGeomPoint F X h)
    (𝟙 (wcGeomPoint F X h)) (wcRootTwistPre X.left m d) (wcZModSheaf X.left m) ρ 1
    hinj hsurj hscale1
  exact ⟨ψ, hψiso, hψ⟩

theorem wc_lpgi_smooth_point_local_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d f]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], ((ℓ : ℕ) : K) ≠ 0 →
    ∀ (O : Y.Opens) (y : Y), (O : Set Y) = {y}ᶜ →
    Finite (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y ℓ) (2 * d)) ∧
    Nat.card (Abelian.Ext (Limits.cokernel (wcFreeSheafMap Y
        (MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial :
          Scheme.ProEt.mk O.ι ⟶ Scheme.ProEt.mk (𝟙 Y)))) (wcZModSheaf Y ℓ) (2 * d)) ≤ ℓ :=
by
  classical
  intro K _ _ Y f d _ ℓ _ hneℓ O y hO

  haveI : Smooth f := SmoothOfRelativeDimension.smooth d f
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
  have hyc : IsClosed ({y} : Set Y) := by
    have ho : IsOpen (O : Set Y) := O.isOpen
    rw [hO] at ho
    exact isOpen_compl_iff.mp ho
  have hr1 : Set.range O.ι = {y}ᶜ := (Scheme.Opens.range_ι O).trans hO

  obtain ⟨y₀, hy₀f, hy₀pt⟩ := wc_glc_closed_point_section K Y f y hyc

  have hchart : ∃ (V : Scheme.{u}) (ι : V ⟶ Y) (_ : IsOpenImmersion ι) (_ : CompactSpace V)
      (v₀ : Spec (.of K) ⟶ V) (φ : V ⟶ Spec (.of (MvPolynomial (Fin d) K))),
      v₀ ≫ ι = y₀ ∧ Etale φ ∧
      v₀ ≫ φ = Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K)) ∧
      ∀ v : V, φ v = (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K))) (IsLocalRing.closedPoint K) →
        v = v₀ (IsLocalRing.closedPoint K) := by
    obtain ⟨W0, ι0, hι0, v00, φ0, hv0ι, hφ0, hv0φ, hfib0⟩ :=
      wc_smooth_rational_point_etale_chart K Y f d y₀ hy₀f
    haveI := hι0
    haveI := hφ0
    obtain ⟨W', hW'mem, hw0W'⟩ : ∃ W' : W0.Opens, IsAffineOpen W' ∧
        v00 (IsLocalRing.closedPoint K) ∈ W' := by
      obtain ⟨U', hU', hxU', -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (Scheme.isBasis_affineOpens W0))
        (show v00 (IsLocalRing.closedPoint K) ∈ (⊤ : W0.Opens) from trivial)
      exact ⟨U', hU', hxU'⟩
    haveI : IsAffine W' := hW'mem
    have H : Set.range v00 ⊆ Set.range W'.ι := by
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Opens.range_ι, Subsingleton.elim p (IsLocalRing.closedPoint K)]
      exact hw0W'
    have hv : IsOpenImmersion.lift W'.ι v00 H ≫ W'.ι = v00 := IsOpenImmersion.lift_fac _ _ H
    refine ⟨W', W'.ι ≫ ι0, inferInstance, inferInstance, IsOpenImmersion.lift W'.ι v00 H,
      W'.ι ≫ φ0, ?_, inferInstance, ?_, ?_⟩
    · rw [← Category.assoc, hv, hv0ι]
    · rw [← Category.assoc, hv, hv0φ]
    · intro v hv'
      apply W'.ι.isOpenEmbedding.injective
      have h1 : φ0 (W'.ι v) = (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K))) (IsLocalRing.closedPoint K) := by
        rw [← Scheme.Hom.comp_apply]; exact hv'
      rw [hfib0 _ h1]
      have h2 : (IsOpenImmersion.lift W'.ι v00 H ≫ W'.ι) (IsLocalRing.closedPoint K : Spec (.of K)) =
          v00 (IsLocalRing.closedPoint K : Spec (.of K)) := by rw [hv]
      exact h2.symm
  obtain ⟨W, ι, hι, hWc, v₀, φ, hv₀ι, hφet, hv₀φ, hfib⟩ := hchart
  haveI := hι
  haveI := hφet
  haveI := hWc

  set orig : Spec (.of K) ⟶ Spec (.of (MvPolynomial (Fin d) K)) :=
    Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K)) with horig
  set pt : Spec (.of K) := IsLocalRing.closedPoint K with hptdef
  have hopK : orig ≫ Spec.map (CommRingCat.ofHom
      (MvPolynomial.C : K →+* MvPolynomial (Fin d) K)) = 𝟙 _ := by
    rw [horig, ← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext x
    simp
  haveI : IsClosedImmersion orig := by
    haveI : IsClosedImmersion (orig ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : K →+* MvPolynomial (Fin d) K))) := by
      rw [hopK]; infer_instance
    exact IsClosedImmersion.of_comp orig (Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : K →+* MvPolynomial (Fin d) K)))
  have hclosed : IsClosed (Set.range orig) := (Scheme.Hom.isClosedEmbedding orig).isClosed_range
  let OA : (Spec (.of (MvPolynomial (Fin d) K))).Opens :=
    ⟨(Set.range orig)ᶜ, hclosed.isOpen_compl⟩
  have hrangeO : ∀ p : Spec (.of (MvPolynomial (Fin d) K)),
      p ∈ Set.range orig ↔ p = orig pt := by
    intro p
    constructor
    · rintro ⟨q, rfl⟩
      rw [Subsingleton.elim q pt]
    · intro hp
      exact ⟨pt, hp.symm⟩
  have hιw₀ : ι (v₀ pt) = y := by rw [← Scheme.Hom.comp_apply, hv₀ι, hy₀pt]
  have hφw₀ : φ (v₀ pt) = orig pt := by rw [← Scheme.Hom.comp_apply, hv₀φ]
  have hmemO : ∀ v : W, φ v ∈ (OA : Set (Spec (.of (MvPolynomial (Fin d) K)))) ↔
      v ≠ v₀ pt := by
    intro v
    show φ v ∈ (Set.range orig)ᶜ ↔ _
    rw [Set.mem_compl_iff, hrangeO]
    constructor
    · intro hne heq
      apply hne
      rw [heq, hφw₀]
    · intro hne heq
      exact hne (hfib v heq)
  have huniq1 : ∀ w : W, ι w = y → w = v₀ pt :=
    fun w hw => ι.isOpenEmbedding.injective (hw.trans hιw₀.symm)
  have hmemι : ∀ v : W, ι v ≠ y ↔ v ≠ v₀ pt := by
    intro v
    constructor
    · intro hne heq
      apply hne
      rw [heq, hιw₀]
    · intro hne heq
      exact hne (huniq1 v heq)
  let Wo : W.Opens := φ ⁻¹ᵁ OA
  have hWo : ∀ v : W, v ∈ (Wo : Set W) ↔
      φ v ∈ (OA : Set (Spec (.of (MvPolynomial (Fin d) K)))) := fun v => Iff.rfl
  have hrangeWo : Set.range Wo.ι = (Wo : Set W) := Scheme.Opens.range_ι Wo

  let U1 : Y.ProEt := Scheme.ProEt.mk (𝟙 Y)
  let ι1 : Scheme.ProEt.mk O.ι ⟶ U1 :=
    MorphismProperty.Over.homMk O.ι (Category.comp_id _) trivial
  let T1 : Y.ProEt := Scheme.ProEt.mk ι
  let VT1 : Y.ProEt := Scheme.ProEt.mk (Wo.ι ≫ ι)
  let g1 : T1 ⟶ U1 := MorphismProperty.Over.homMk ι (Category.comp_id _) trivial
  let j1 : VT1 ⟶ T1 := MorphismProperty.Over.homMk Wo.ι rfl trivial
  have H1 : Set.range (Wo.ι ≫ ι) ⊆ Set.range O.ι := by
    rintro _ ⟨v, rfl⟩
    rw [hr1, Scheme.Hom.comp_apply]
    have hv : Wo.ι v ∈ (Wo : Set W) := by rw [← hrangeWo]; exact ⟨v, rfl⟩
    exact (hmemι _).mpr ((hmemO _).mp ((hWo _).mp hv))
  obtain ⟨L1, hL1⟩ : ∃ L1 : Wo.toScheme ⟶ O.toScheme, L1 ≫ O.ι = Wo.ι ≫ ι :=
    ⟨IsOpenImmersion.lift O.ι (Wo.ι ≫ ι) H1, IsOpenImmersion.lift_fac _ _ H1⟩
  let gV1 : VT1 ⟶ Scheme.ProEt.mk O.ι :=
    MorphismProperty.Over.homMk L1 hL1 trivial
  have hgV1 : gV1 ≫ ι1 = j1 ≫ g1 := MorphismProperty.Over.Hom.ext hL1
  have hrj1 : Set.range j1.left = g1.left ⁻¹' {y}ᶜ := by
    show Set.range Wo.ι = ι ⁻¹' {y}ᶜ
    rw [hrangeWo]
    ext v
    exact (hWo v).trans ((hmemO v).trans (hmemι v).symm)
  haveI : Etale ι := inferInstance
  have hfib1 : IsIso (Limits.pullback.snd ι (Y.fromSpecResidueField y)) :=
    wc_glc_etale_fibre_iso K Y W f ι y₀ hy₀f y hy₀pt (v₀ pt) hιw₀ huniq1
  obtain ⟨κ₁, hκ₁, -⟩ := wc_lfi_point_excision Y U1
    (Scheme.ProEt.mk O.ι) T1 VT1 ι1 (show IsOpenImmersion O.ι from inferInstance) y hr1 g1 j1
    (show IsOpenImmersion Wo.ι from inferInstance) hrj1 gV1 hgV1 hfib1
    (show CompactSpace W from inferInstance)
    (show QuasiSeparatedSpace Y from inferInstance)
    (show IsLocallyNoetherian Y from inferInstance)

  let U2 : (Spec (.of (MvPolynomial (Fin d) K))).ProEt :=
    Scheme.ProEt.mk (𝟙 (Spec (.of (MvPolynomial (Fin d) K))))
  let ι2 : Scheme.ProEt.mk OA.ι ⟶ U2 :=
    MorphismProperty.Over.homMk OA.ι (Category.comp_id _) trivial
  let T2 : (Spec (.of (MvPolynomial (Fin d) K))).ProEt := Scheme.ProEt.mk φ
  let VT2 : (Spec (.of (MvPolynomial (Fin d) K))).ProEt :=
    Scheme.ProEt.mk (Wo.ι ≫ φ)
  let g2 : T2 ⟶ U2 := MorphismProperty.Over.homMk φ (Category.comp_id _) trivial
  let j2 : VT2 ⟶ T2 := MorphismProperty.Over.homMk Wo.ι rfl trivial
  let gV2 : VT2 ⟶ Scheme.ProEt.mk OA.ι :=
    MorphismProperty.Over.homMk (φ ∣_ OA) (morphismRestrict_ι φ OA) trivial
  have hgV2 : gV2 ≫ ι2 = j2 ≫ g2 := MorphismProperty.Over.Hom.ext (morphismRestrict_ι φ OA)
  have hOset : (OA : Set (Spec (.of (MvPolynomial (Fin d) K)))) = {orig pt}ᶜ := by
    ext p
    show p ∈ (Set.range orig)ᶜ ↔ _
    rw [Set.mem_compl_iff, hrangeO]
    exact Iff.rfl
  have hr2 : Set.range ι2.left = {orig pt}ᶜ := by
    show Set.range OA.ι = _
    rw [Scheme.Opens.range_ι]
    exact hOset
  have hrj2 : Set.range j2.left = g2.left ⁻¹' {orig pt}ᶜ := by
    show Set.range Wo.ι = φ ⁻¹' {orig pt}ᶜ
    rw [hrangeWo, ← hOset]
    ext v
    exact Iff.rfl
  have hfib2 : IsIso (Limits.pullback.snd φ
      ((Spec (.of (MvPolynomial (Fin d) K))).fromSpecResidueField (orig pt))) :=
    wc_glc_etale_fibre_iso K (Spec (.of (MvPolynomial (Fin d) K)))
      W (Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : K →+* MvPolynomial (Fin d) K)))
      φ orig hopK (orig pt) rfl (v₀ pt) hφw₀ hfib
  obtain ⟨κ₂, hκ₂, -⟩ := wc_lfi_point_excision (Spec (.of (MvPolynomial (Fin d) K)))
    U2 (Scheme.ProEt.mk OA.ι) T2 VT2 ι2 (show IsOpenImmersion OA.ι from inferInstance) (orig pt) hr2
    g2 j2 (show IsOpenImmersion Wo.ι from inferInstance) hrj2 gV2 hgV2 hfib2
    (show CompactSpace W from inferInstance)
    (show QuasiSeparatedSpace (Spec (.of (MvPolynomial (Fin d) K))) from inferInstance)
    (show IsLocallyNoetherian (Spec (.of (MvPolynomial (Fin d) K))) from inferInstance)

  have pre : ∀ (Z : Scheme.{u}) {A A' B : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (e : A ≅ A'), Nonempty (Abelian.Ext A B (2 * d) ≃ Abelian.Ext A' B (2 * d)) := by
    intro Z A A' B e
    refine ⟨{ toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add (2 * d))
              invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add (2 * d))
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (2 * d)) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (2 * d)) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  obtain ⟨E2⟩ := pre Y (B := wcZModSheaf Y ℓ) (@asIso _ _ _ _ κ₁ hκ₁)
  haveI : IsOpenImmersion j1.left := (show IsOpenImmersion Wo.ι from inferInstance)
  obtain ⟨E3⟩ := wc_glc_coker_slice Y T1 VT1 j1 ℓ (2 * d)
  haveI : IsOpenImmersion j2.left := (show IsOpenImmersion Wo.ι from inferInstance)
  obtain ⟨E4⟩ := wc_glc_coker_slice (Spec (.of (MvPolynomial (Fin d) K))) T2 VT2 j2 ℓ (2 * d)
  obtain ⟨E5⟩ := pre (Spec (.of (MvPolynomial (Fin d) K)))
    (B := wcZModSheaf (Spec (.of (MvPolynomial (Fin d) K))) ℓ)
    (@asIso _ _ _ _ κ₂ hκ₂)
  let E := E2.symm.trans (E3.trans (E4.symm.trans E5))

  obtain ⟨hfin, hcard⟩ := wc_glc_affine_local_card_le K d ℓ hneℓ OA rfl
  exact ⟨@Finite.of_equiv _ _ hfin E.symm, (Nat.card_congr E).trans_le hcard⟩

theorem wc_lpgi_zmod_devissage (S : Scheme.{u})
    (Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (i : ℕ)
    (h1 : Finite (Abelian.Ext Q (wcZModSheaf S ℓ) i))
    (h2 : Nat.card (Abelian.Ext Q (wcZModSheaf S ℓ) i) ≤ ℓ) :
    ∀ k : ℕ, Finite (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k + 1))) i) ∧
      Nat.card (Abelian.Ext Q (wcZModSheaf S (ℓ ^ (k + 1))) i) ≤ ℓ ^ (k + 1) :=
by
  classical
  have hmid : ∀ (S₀ : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})),
      S₀.ShortExact → Finite (Abelian.Ext Q S₀.X₁ i) → Finite (Abelian.Ext Q S₀.X₃ i) →
        Finite (Abelian.Ext Q S₀.X₂ i) ∧
        Nat.card (Abelian.Ext Q S₀.X₂ i) ≤
          Nat.card (Abelian.Ext Q S₀.X₃ i) * Nat.card (Abelian.Ext Q S₀.X₁ i) := by
    intro S₀ hS hf1 hf3
    let ψ : Abelian.Ext Q S₀.X₂ i →+ Abelian.Ext Q S₀.X₃ i :=
      (Abelian.Ext.mk₀ S₀.g).postcomp Q (add_zero i)
    let φ : Abelian.Ext Q S₀.X₁ i →+ Abelian.Ext Q S₀.X₂ i :=
      (Abelian.Ext.mk₀ S₀.f).postcomp Q (add_zero i)
    have hex : ∀ b, ψ b = 0 → ∃ a, φ a = b := fun b hb =>
      Abelian.Ext.covariant_sequence_exact₂ Q hS b hb
    let σ : Abelian.Ext Q S₀.X₃ i → Abelian.Ext Q S₀.X₂ i :=
      fun c => if h : ∃ b, ψ b = c then h.choose else 0
    have hσ : ∀ b, ψ (σ (ψ b)) = ψ b := by
      intro b
      have h : ∃ b', ψ b' = ψ b := ⟨b, rfl⟩
      simp only [σ, dif_pos h]
      exact h.choose_spec
    have hpre : ∀ b, ∃ a, φ a = b - σ (ψ b) := fun b =>
      hex _ (by rw [map_sub, hσ, sub_self])
    choose τ hτ using hpre
    have hinj : Function.Injective (fun b => (ψ b, τ b)) := by
      intro b b' hbb
      simp only [Prod.mk.injEq] at hbb
      obtain ⟨e1, e2⟩ := hbb
      have := hτ b
      rw [e2, hτ b', e1] at this
      exact (sub_left_inj.mp this).symm
    exact ⟨Finite.of_injective _ hinj,
      (Nat.card_le_card_of_injective _ hinj).trans_eq (Nat.card_prod _ _)⟩
  intro k
  induction k with
  | zero =>
    rw [Nat.zero_add, pow_one]
    exact ⟨h1, h2⟩
  | succ k ih =>
    obtain ⟨f, g, -, -, hfg, -, hS, -, -⟩ := wc_glc_zmod_ses S ℓ (k + 1)
    have key := hmid (ShortComplex.mk f g hfg) hS ih.1 h1
    exact ⟨key.1, key.2.trans ((Nat.mul_le_mul h2 ih.2).trans_eq (pow_succ' ℓ (k + 1)).symm)⟩

theorem wc_lpgi_punct_card_le (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (d : ℕ) (hd : 1 ≤ d)
    (hsm : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ)
    (T VT : X.left.ProEt) (g : T ⟶ wcGeomPoint F X h) (j : VT ⟶ T)
    (A : Type u) [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : T.left ≅ Spec (.of A))
    (xb : (wcGeomPoint F X h).left) (hxbc : IsClosed ({xb} : Set (wcGeomPoint F X h).left))
    (hpre : g.left ⁻¹' {xb} = {e.inv (IsLocalRing.closedPoint A)})
    (hfib : IsIso (Limits.pullback.snd g.left ((wcGeomPoint F X h).left.fromSpecResidueField xb)))
    (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {e.inv (IsLocalRing.closedPoint A)}ᶜ)
    (f : Fin d → A) (hspan : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (hdim : ringKrullDim A = (d : WithBot ℕ∞))
    (hℓA : IsUnit ((ℓ : ℕ) : A)) :
    Finite (Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ n) d) (2 * d - 1)) ∧
    Nat.card (Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ n) d) (2 * d - 1)) ≤ ℓ ^ n :=
by
  classical
  have hfun : ∀ {A B C : X.left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap X.left a ≫ wcFreeSheafMap X.left b = wcFreeSheafMap X.left (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      first
        | rw [yoneda.map_comp, Functor.whiskerRight_comp]
        | (apply NatTrans.ext; funext V; simp [← Functor.map_comp])
    exact ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map e)

  rcases Nat.eq_zero_or_pos n with hn0 | hnpos
  · subst hn0
    have t0 := wc_lfd_root_twist_torsion X.left (ℓ ^ 0) d
    have hid : 𝟙 (wcRootTwist X.left (ℓ ^ 0) d) = 0 := by
      have e : (ℓ ^ 0) • 𝟙 (wcRootTwist X.left (ℓ ^ 0) d) = 𝟙 (wcRootTwist X.left (ℓ ^ 0) d) :=
        (congrArg (fun k : ℕ => k • 𝟙 (wcRootTwist X.left (ℓ ^ 0) d)) (pow_zero ℓ)).trans
          (one_smul ℕ _)
      rw [← e]
      exact t0
    have hz : ∀ x : Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ 0) d) (2 * d - 1),
        x = 0 := by
      intro x
      calc x = x.comp (Abelian.Ext.mk₀ (𝟙 (wcRootTwist X.left (ℓ ^ 0) d))) (add_zero _) :=
            (Abelian.Ext.comp_mk₀_id x).symm
        _ = x.comp (Abelian.Ext.mk₀ 0) (add_zero _) := by rw [hid]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    have hsub : Subsingleton
        (Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ 0) d) (2 * d - 1)) :=
      ⟨fun a b => (hz a).trans (hz b).symm⟩
    haveI := hsub
    haveI hfin0 : Finite
        (Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ 0) d) (2 * d - 1)) :=
      Finite.of_subsingleton
    refine ⟨hfin0, ?_⟩
    exact (Finite.card_le_one_iff_subsingleton.mpr hsub).trans (le_of_eq (pow_zero ℓ).symm)
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩

  let fY : (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F)) :=
    Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  haveI hsm' : SmoothOfRelativeDimension d fY := hsm
  haveI : Smooth fY := SmoothOfRelativeDimension.smooth d fY
  haveI : IsLocallyNoetherian (wcGeomPoint F X h).left := LocallyOfFiniteType.isLocallyNoetherian fY
  haveI hT : CompactSpace T.left := (Scheme.homeoOfIso e.symm).compactSpace
  have hneℓ : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro h0
    let τ : CommRingCat.of (AlgebraicClosure F) ⟶ CommRingCat.of A :=
      Spec.preimage (e.inv ≫ g.left ≫ fY)
    have h1 : ((ℓ : ℕ) : A) = 0 := by
      have h2 := map_natCast τ.hom ℓ
      rw [h0, map_zero] at h2
      exact h2.symm
    rw [h1] at hℓA
    exact not_isUnit_zero hℓA
  have hmU : IsUnit (((ℓ ^ (k + 1) : ℕ) : ℕ) : AlgebraicClosure F) :=
    isUnit_iff_ne_zero.mpr (by rw [Nat.cast_pow]; exact pow_ne_zero _ hneℓ)

  let O : (wcGeomPoint F X h).left.Opens := ⟨{xb}ᶜ, isOpen_compl_iff.mpr hxbc⟩
  have hV0 : WeaklyEtale (O.ι ≫ (wcGeomPoint F X h).hom) := by
    first
      | (haveI := h; infer_instance)
      | exact (MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)).comp_mem
          O.ι _ inferInstance h
  let V₀ : X.left.ProEt := MorphismProperty.Over.mk ⊤ (O.ι ≫ (wcGeomPoint F X h).hom) hV0
  let ι₀ : V₀ ⟶ wcGeomPoint F X h := MorphismProperty.Over.homMk O.ι rfl trivial
  have hι₀ : IsOpenImmersion ι₀.left := show IsOpenImmersion O.ι from inferInstance
  have hpt : Set.range ι₀.left = {xb}ᶜ := by
    show Set.range O.ι = _
    rw [Scheme.Opens.range_ι]
    rfl

  have hsub : Set.range (j ≫ g).left ⊆ Set.range ι₀.left := by
    rintro _ ⟨v, rfl⟩
    rw [hpt]
    intro hv
    have hv1 : (j ≫ g).left v = xb := hv
    have hv2 : g.left (j.left v) = xb := by
      rw [show (j ≫ g).left = j.left ≫ g.left from rfl, Scheme.Hom.comp_apply] at hv1
      exact hv1
    have h2 : j.left v ∈ g.left ⁻¹' {xb} := hv2
    rw [hpre] at h2
    have h3 : j.left v ∈ Set.range j.left := ⟨v, rfl⟩
    rw [hrange] at h3
    exact h3 h2
  let Lg : VT.left ⟶ V₀.left := IsOpenImmersion.lift ι₀.left (j ≫ g).left hsub
  have hLg : Lg ≫ ι₀.left = (j ≫ g).left := IsOpenImmersion.lift_fac _ _ hsub
  have hLgw : Lg ≫ V₀.hom = VT.hom := by
    rw [← MorphismProperty.Over.w ι₀, ← Category.assoc, hLg]
    show (j.left ≫ g.left) ≫ (wcGeomPoint F X h).hom = VT.hom
    rw [Category.assoc, MorphismProperty.Over.w g, MorphismProperty.Over.w j]
  let gV : VT ⟶ V₀ := MorphismProperty.Over.homMk Lg hLgw trivial
  have hgV : gV ≫ ι₀ = j ≫ g := MorphismProperty.Over.Hom.ext hLg
  have hrj : Set.range j.left = g.left ⁻¹' {xb}ᶜ := by
    rw [hrange, Set.preimage_compl, hpre]
  obtain ⟨κ, hκiso, -⟩ := wc_lfi_point_excision X.left (wcGeomPoint F X h) V₀ T VT ι₀ hι₀
    xb hpt g j hj hrj gV hgV hfib hT
    (show QuasiSeparatedSpace (wcGeomPoint F X h).left from inferInstance)
    (show IsLocallyNoetherian (wcGeomPoint F X h).left from inferInstance)

  have hmono : Mono (wcFreeSheafMap X.left j) :=
    wc_free_sheaf_map_mono X.left VT T j (@IsOpenImmersion.mono _ _ _ hj)
  have hS : (ShortComplex.mk (wcFreeSheafMap X.left j)
      (Limits.cokernel.π (wcFreeSheafMap X.left j)) (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  haveI hproj : Projective (wcFreeSheaf X.left T) :=
    wc_proet_free_projective_strict_local X.left T A e
  have hvan : ∀ (p : ℕ) (w : Abelian.Ext (wcFreeSheaf X.left T)
      (wcRootTwist X.left (ℓ ^ (k + 1)) d) p), 1 ≤ p → w = 0 := by
    intro p w hp
    cases p with
    | zero => omega
    | succ q => exact Abelian.Ext.eq_zero_of_projective w
  have hm : 1 + (2 * d - 1) = 2 * d := by omega
  let δ := hS.extClass.precomp (wcRootTwist X.left (ℓ ^ (k + 1)) d) hm
  have hδ : ∀ w, δ w = hS.extClass.comp w hm := by
    intro w
    simp only [δ, Abelian.Ext.precomp, Abelian.Ext.bilinearComp_apply_apply]
  have hδinj : Function.Injective δ := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    rw [hδ] at hw
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS _ w hm hw
    rw [← hx₂, hvan _ x₂ (by omega), Abelian.Ext.comp_zero]

  have pre : ∀ (Z : Scheme.{u}) {A A' B : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (e : A ≅ A'), Nonempty (Abelian.Ext A B (2 * d) ≃ Abelian.Ext A' B (2 * d)) := by
    intro Z A A' B e
    refine ⟨{ toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add (2 * d))
              invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add (2 * d))
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (2 * d)) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (2 * d)) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  obtain ⟨Eexc⟩ := pre X.left (B := wcRootTwist X.left (ℓ ^ (k + 1)) d) (@asIso _ _ _ _ κ hκiso)

  obtain ⟨ψ, hψiso, hψ1⟩ := wc_lpgi_geom_untwist F X h (ℓ ^ (k + 1)) d hmU
  have hab : 𝟙 V₀ ≫ ι₀ = ι₀ ≫ 𝟙 (wcGeomPoint F X h) := by
    rw [Category.id_comp, Category.comp_id]
  have hw0 : wcFreeSheafMap X.left ι₀ ≫ (wcFreeSheafMap X.left (𝟙 (wcGeomPoint F X h)) ≫
      Limits.cokernel.π (wcFreeSheafMap X.left ι₀)) = 0 := by
    rw [← Category.assoc, hfun, Category.comp_id, Limits.cokernel.condition]
  let Φ : Limits.cokernel (wcFreeSheafMap X.left ι₀) ⟶ Limits.cokernel (wcFreeSheafMap X.left ι₀) :=
    Limits.cokernel.desc (wcFreeSheafMap X.left ι₀)
      (wcFreeSheafMap X.left (𝟙 (wcGeomPoint F X h)) ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₀)) hw0
  have hΦ : Limits.cokernel.π (wcFreeSheafMap X.left ι₀) ≫ Φ =
      wcFreeSheafMap X.left (𝟙 (wcGeomPoint F X h)) ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₀) :=
    Limits.cokernel.π_desc _ _ _
  obtain ⟨Θ, hΘbij, -⟩ := wc_lfi_coker_scaled_transport X.left (wcGeomPoint F X h) V₀ ι₀
    (𝟙 (wcGeomPoint F X h)) (𝟙 V₀) hab Φ hΦ (wcRootTwist X.left (ℓ ^ (k + 1)) d)
    (wcZModSheaf X.left (ℓ ^ (k + 1))) ψ 1 hψiso hψ1 (2 * d)
  let Etw := Equiv.ofBijective Θ hΘbij

  haveI : IsOpenImmersion ι₀.left := hι₀
  obtain ⟨Esl⟩ := wc_glc_coker_slice X.left (wcGeomPoint F X h) V₀ ι₀ (ℓ ^ (k + 1)) (2 * d)

  obtain ⟨hf1, hc1⟩ := wc_lpgi_smooth_point_local_card_le (AlgebraicClosure F)
    (wcGeomPoint F X h).left fY d ℓ hneℓ O xb rfl
  obtain ⟨hfin, hcard⟩ := wc_lpgi_zmod_devissage (wcGeomPoint F X h).left
    (Limits.cokernel (wcFreeSheafMap (wcGeomPoint F X h).left
      (MorphismProperty.Over.homMk ι₀.left (Category.comp_id _) trivial :
        Scheme.ProEt.mk ι₀.left ⟶ Scheme.ProEt.mk (𝟙 (wcGeomPoint F X h).left))))
    ℓ (2 * d) hf1 hc1 k

  have hinj : Function.Injective
      (fun w : Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ (k + 1)) d) (2 * d - 1) =>
        Esl (Etw (Eexc (δ w)))) :=
    Esl.injective.comp (Etw.injective.comp (Eexc.injective.comp hδinj))
  haveI := hfin
  exact ⟨Finite.of_injective _ hinj, (Nat.card_le_card_of_injective _ hinj).trans hcard⟩

theorem wc_lpgfg_open_mv_ses (S : Scheme.{u}) (V : S.ProEt) {O₁₂ O₁ O₂ O : V.left.Opens}
    (h₁ : O₁₂ ≤ O₁) (h₂ : O₁₂ ≤ O₂) (h₃ : O₁ ≤ O) (h₄ : O₂ ≤ O)
    (hcup : O₁ ⊔ O₂ = O) (hcap : O₁ ⊓ O₂ = O₁₂) :
    (wcMVComplex S V h₁ h₂ h₃ h₄).ShortExact :=
by
  classical

  let adj := sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
  let adjW := Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}
  let e : ∀ (U : S.ProEt) (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      (wcFreeSheaf S U ⟶ F) ≃ F.obj.obj (Opposite.op U) := fun U F =>
    (adj.homEquiv (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans
      ((adjW.homEquiv (uliftYoneda.{u+1}.obj U) F.obj).trans
        (uliftYonedaEquiv.{u+1} (X := U) (F := F.obj ⋙ forget AddCommGrpCat.{u+1})))
  have he : ∀ {U U' : S.ProEt} (f : U ⟶ U') (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (g : wcFreeSheaf S U' ⟶ F), e U F (wcFreeSheafMap S f ≫ g) = F.obj.map f.op (e U' F g) := by
    intro U U' f F g
    have k1 : adj.homEquiv (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F
          (wcFreeSheafMap S f ≫ g) =
        Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          adj.homEquiv (yoneda.obj U' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F g :=
      adj.homEquiv_naturality_left _ g
    have k2 : adjW.homEquiv (uliftYoneda.{u+1}.obj U) F.obj
          (Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            adj.homEquiv (yoneda.obj U' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F g) =
        uliftYoneda.{u+1}.map f ≫ adjW.homEquiv (uliftYoneda.{u+1}.obj U') F.obj
          (adj.homEquiv (yoneda.obj U' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F g) :=
      adjW.homEquiv_naturality_left (uliftYoneda.{u+1}.map f) _
    have k3 := uliftYonedaEquiv_naturality.{u+1} (adjW.homEquiv (uliftYoneda.{u+1}.obj U') F.obj
          (adj.homEquiv (yoneda.obj U' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F g)) f.op
    show uliftYonedaEquiv.{u+1} (adjW.homEquiv (uliftYoneda.{u+1}.obj U) F.obj
        (adj.homEquiv (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F
          (wcFreeSheafMap S f ≫ g))) = _
    exact (congrArg (fun z => uliftYonedaEquiv.{u+1} (X := U) (F := F.obj ⋙ forget AddCommGrpCat.{u+1})
        (adjW.homEquiv (uliftYoneda.{u+1}.obj U) F.obj z)) k1).trans
      ((congrArg (uliftYonedaEquiv.{u+1} (X := U) (F := F.obj ⋙ forget AddCommGrpCat.{u+1})) k2).trans
        k3.symm)

  have hmono : Mono (wcMVComplex S V h₁ h₂ h₃ h₄).f := by
    haveI hι : Mono (wcVResLE S V h₁) := ⟨fun g h e' => MorphismProperty.Over.Hom.ext
      ((cancel_mono (V.left.homOfLE h₁)).mp (congrArg (fun q => q.left) e'))⟩
    haveI hm1 : Mono (wcFreeSheafMap S (wcVResLE S V h₁)) :=
      Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (Functor.whiskerRight (yoneda.map (wcVResLE S V h₁)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    show Mono (Limits.biprod.lift (wcFreeSheafMap S (wcVResLE S V h₁))
      (-wcFreeSheafMap S (wcVResLE S V h₂)))
    exact mono_of_mono_fac (Limits.biprod.lift_fst _ _)

  have hJ : ∀ x : (O : Scheme.{u}), (∃ y : (O₁ : Scheme.{u}), V.left.homOfLE h₃ y = x) ∨
      (∃ y : (O₂ : Scheme.{u}), V.left.homOfLE h₄ y = x) := by
    intro x
    have hx : (x.1 : V.left) ∈ O₁ ⊔ O₂ := by rw [hcup]; exact x.2
    rcases TopologicalSpace.Opens.mem_sup.mp hx with h | h
    · exact Or.inl ⟨⟨x.1, h⟩, Subtype.ext (Scheme.homOfLE_apply h₃ ⟨x.1, h⟩)⟩
    · exact Or.inr ⟨⟨x.1, h⟩, Subtype.ext (Scheme.homOfLE_apply h₄ ⟨x.1, h⟩)⟩
  let π : (k : Limits.WalkingPair) → Limits.pairFunction (wcVRes S V O₁) (wcVRes S V O₂) k ⟶
      wcVRes S V O := fun k => Limits.WalkingPair.casesOn k (wcVResLE S V h₃) (wcVResLE S V h₄)
  have hcov : Sieve.ofTwoArrows (wcVResLE S V h₃) (wcVResLE S V h₄) ∈
      Scheme.ProEt.topology S (wcVRes S V O) := by
    refine Precoverage.generate_mem_toGrothendieck ?_
    refine Precoverage.mem_comap_iff.mpr ?_
    change Presieve.map (Scheme.ProEt.forget S ⋙ Over.forget S) (Presieve.ofArrows _ π) ∈ _
    rw [Presieve.map_ofArrows]
    have hsurj : ∀ x, ∃ i, x ∈ Set.range ((Scheme.ProEt.forget S ⋙ Over.forget S).map (π i)) := by
      intro x
      rcases hJ x with ⟨y, hy⟩ | ⟨y, hy⟩
      · exact ⟨Limits.WalkingPair.left, y, hy⟩
      · exact ⟨Limits.WalkingPair.right, y, hy⟩
    have hzar := (Scheme.ofArrows_mem_precoverage_iff IsOpenImmersion).mpr ⟨hsurj, by
      intro i; cases i
      · exact (inferInstance : IsOpenImmersion (V.left.homOfLE h₃))
      · exact (inferInstance : IsOpenImmersion (V.left.homOfLE h₄))⟩
    have hwe := (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr ⟨hsurj, by
      intro i; cases i
      · exact etale_le_weaklyEtale _ _ _ (inferInstance : Etale (V.left.homOfLE h₃))
      · exact etale_le_weaklyEtale _ _ _ (inferInstance : Etale (V.left.homOfLE h₄))⟩
    have hqc := Scheme.zariskiPrecoverage_le_qcPrecoverage _ hzar
    exact ⟨hqc, hwe⟩

  have hmemW : ∀ (W : V.left.Opens) (y : (W : Scheme.{u})), W.ι y ∈ (W : Set V.left) := by
    intro W y
    rw [← Scheme.Opens.range_ι]
    exact ⟨y, rfl⟩
  have hglue : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (a : F.obj.obj (Opposite.op (wcVRes S V O₁))) (b : F.obj.obj (Opposite.op (wcVRes S V O₂))),
      F.obj.map (wcVResLE S V h₁).op a = F.obj.map (wcVResLE S V h₂).op b →
      ∃! t : F.obj.obj (Opposite.op (wcVRes S V O)),
        F.obj.map (wcVResLE S V h₃).op t = a ∧ F.obj.map (wcVResLE S V h₄).op t = b := by
    intro F a b hab
    have key : ∀ (Zs : Scheme.{u}) (a' : Zs ⟶ (O₁ : Scheme.{u})) (b' : Zs ⟶ (O₂ : Scheme.{u})),
        a' ≫ V.left.homOfLE h₃ = b' ≫ V.left.homOfLE h₄ →
        ∃ k : Zs ⟶ (O₁₂ : Scheme.{u}), k ≫ V.left.homOfLE h₁ = a' ∧ k ≫ V.left.homOfLE h₂ = b' ∧
          k ≫ O₁₂.ι = a' ≫ O₁.ι := by
      intro Zs a' b' hc
      have hm : a' ≫ O₁.ι = b' ≫ O₂.ι := by
        rw [← Scheme.homOfLE_ι V.left h₃, ← Scheme.homOfLE_ι V.left h₄, ← Category.assoc,
          ← Category.assoc, hc]
      have H : Set.range (a' ≫ O₁.ι) ⊆ Set.range O₁₂.ι := by
        rintro _ ⟨z, rfl⟩
        rw [Scheme.Opens.range_ι, ← hcap]
        refine ⟨?_, ?_⟩
        · rw [Scheme.Hom.comp_apply]
          exact hmemW O₁ _
        · rw [hm, Scheme.Hom.comp_apply]
          exact hmemW O₂ _
      have hk : IsOpenImmersion.lift O₁₂.ι (a' ≫ O₁.ι) H ≫ O₁₂.ι = a' ≫ O₁.ι :=
        IsOpenImmersion.lift_fac _ _ H
      refine ⟨IsOpenImmersion.lift O₁₂.ι (a' ≫ O₁.ι) H, ?_, ?_, hk⟩
      · rw [← cancel_mono O₁.ι, Category.assoc, Scheme.homOfLE_ι, hk]
      · rw [← cancel_mono O₂.ι, Category.assoc, Scheme.homOfLE_ι, hk, hm]
    have hmix : ∀ (Z : S.ProEt) (gi : Z ⟶ wcVRes S V O₁) (gj : Z ⟶ wcVRes S V O₂),
        gi ≫ wcVResLE S V h₃ = gj ≫ wcVResLE S V h₄ → F.obj.map gi.op a = F.obj.map gj.op b := by
      intro Z gi gj hcomm
      obtain ⟨k, hk1, hk2, hk⟩ := key Z.left gi.left gj.left (congrArg (fun q => q.left) hcomm)
      have hkw : k ≫ (wcVRes S V O₁₂).hom = Z.hom :=
        (Category.assoc _ _ _).symm.trans ((congrArg (fun q => q ≫ V.hom) hk).trans
          ((Category.assoc _ _ _).trans (MorphismProperty.Over.w gi)))
      let kk : Z ⟶ wcVRes S V O₁₂ := MorphismProperty.Over.homMk k hkw trivial
      have e1 : kk ≫ wcVResLE S V h₁ = gi := MorphismProperty.Over.Hom.ext hk1
      have e2 : kk ≫ wcVResLE S V h₂ = gj := MorphismProperty.Over.Hom.ext hk2
      rw [← e1, ← e2, op_comp, op_comp, Functor.map_comp, Functor.map_comp, ConcreteCategory.comp_apply,
        ConcreteCategory.comp_apply, hab]
    have hP : Presieve.IsSheaf (Scheme.ProEt.topology S) (F.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((Presheaf.isSheaf_iff_isSheaf_forget _ F.obj (forget AddCommGrpCat.{u+1})).mp F.cond)
    have hSF : Presieve.IsSheafFor (F.obj ⋙ forget AddCommGrpCat.{u+1}) (Presieve.ofArrows _ π) :=
      (Presieve.isSheafFor_iff_generate _).mpr (hP _ hcov)
    let x : (i : Limits.WalkingPair) → (F.obj ⋙ forget AddCommGrpCat.{u+1}).obj
        (Opposite.op (Limits.pairFunction (wcVRes S V O₁) (wcVRes S V O₂) i)) := fun i =>
      match i with
      | .left => a
      | .right => b
    have hcompat : Presieve.Arrows.Compatible (F.obj ⋙ forget AddCommGrpCat.{u+1}) π x := by
      intro i j Z gi gj hcomm
      cases i <;> cases j
      · have hg : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          exact (cancel_mono (V.left.homOfLE h₃)).mp (congrArg (fun q => q.left) hcomm)
        subst hg
        rfl
      · exact hmix Z gi gj hcomm
      · exact (hmix Z gj gi hcomm.symm).symm
      · have hg : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          exact (cancel_mono (V.left.homOfLE h₄)).mp (congrArg (fun q => q.left) hcomm)
        subst hg
        rfl
    obtain ⟨t, ht, hu⟩ := (Presieve.isSheafFor_arrows_iff _ π).mp hSF x hcompat
    refine ⟨t, ⟨ht Limits.WalkingPair.left, ht Limits.WalkingPair.right⟩, fun y hy => hu y ?_⟩
    intro i
    cases i
    · exact hy.1
    · exact hy.2

  have habOf : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (g' : wcFreeSheaf S (wcVRes S V O₁) ⊞ wcFreeSheaf S (wcVRes S V O₂) ⟶ F),
      Limits.biprod.lift (wcFreeSheafMap S (wcVResLE S V h₁))
        (-wcFreeSheafMap S (wcVResLE S V h₂)) ≫ g' = 0 →
      F.obj.map (wcVResLE S V h₁).op (e _ F (Limits.biprod.inl ≫ g')) =
        F.obj.map (wcVResLE S V h₂).op (e _ F (Limits.biprod.inr ≫ g')) := by
    intro F g' h0
    rw [Limits.biprod.lift_eq, Preadditive.add_comp, Category.assoc, Category.assoc,
      Preadditive.neg_comp] at h0
    have h' := add_neg_eq_zero.mp h0
    rw [← he, ← he, h']
  have hglue' : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (g' : (wcMVComplex S V h₁ h₂ h₃ h₄).X₂ ⟶ F), (wcMVComplex S V h₁ h₂ h₃ h₄).f ≫ g' = 0 →
      ∃ t : F.obj.obj (Opposite.op (wcVRes S V O)),
        (F.obj.map (wcVResLE S V h₃).op t = e _ F (Limits.biprod.inl ≫ g') ∧
          F.obj.map (wcVResLE S V h₄).op t = e _ F (Limits.biprod.inr ≫ g')) ∧
        ∀ t', (F.obj.map (wcVResLE S V h₃).op t' = e _ F (Limits.biprod.inl ≫ g') ∧
          F.obj.map (wcVResLE S V h₄).op t' = e _ F (Limits.biprod.inr ≫ g')) → t' = t :=
    fun F g' h => hglue F _ _ (habOf F g' h)
  choose t ht hu using hglue'
  have hcok : Nonempty (Limits.IsColimit (Limits.CokernelCofork.ofπ
      (wcMVComplex S V h₁ h₂ h₃ h₄).g (wcMVComplex S V h₁ h₂ h₃ h₄).zero)) := by
    refine ⟨Limits.CokernelCofork.IsColimit.ofπ _ _
      (fun {Z'} g' eq' => (e _ Z').symm (t Z' g' eq')) ?_ ?_⟩
    · intro Z' g' eq'
      apply Limits.biprod.hom_ext'
      · show Limits.biprod.inl ≫ Limits.biprod.desc (wcFreeSheafMap S (wcVResLE S V h₃))
          (wcFreeSheafMap S (wcVResLE S V h₄)) ≫ (e _ Z').symm (t Z' g' eq') = _
        rw [Limits.biprod.inl_desc_assoc]
        apply (e _ Z').injective
        rw [he, Equiv.apply_symm_apply]
        exact (ht Z' g' eq').1
      · show Limits.biprod.inr ≫ Limits.biprod.desc (wcFreeSheafMap S (wcVResLE S V h₃))
          (wcFreeSheafMap S (wcVResLE S V h₄)) ≫ (e _ Z').symm (t Z' g' eq') = _
        rw [Limits.biprod.inr_desc_assoc]
        apply (e _ Z').injective
        rw [he, Equiv.apply_symm_apply]
        exact (ht Z' g' eq').2
    · intro Z' g' eq' m hm
      apply (e _ Z').injective
      rw [Equiv.apply_symm_apply]
      apply hu Z' g' eq'
      have hm' : Limits.biprod.desc (wcFreeSheafMap S (wcVResLE S V h₃))
          (wcFreeSheafMap S (wcVResLE S V h₄)) ≫ m = g' := hm
      refine ⟨?_, ?_⟩
      · exact (he (wcVResLE S V h₃) Z' m).symm.trans (congrArg (e _ Z')
          ((Limits.biprod.inl_desc_assoc _ _ m).symm.trans (congrArg (Limits.biprod.inl ≫ ·) hm')))
      · exact (he (wcVResLE S V h₄) Z' m).symm.trans (congrArg (e _ Z')
          ((Limits.biprod.inr_desc_assoc _ _ m).symm.trans (congrArg (Limits.biprod.inr ≫ ·) hm')))
  obtain ⟨hex, hepi⟩ := (ShortComplex.exact_and_epi_g_iff_g_is_cokernel _).mpr hcok
  exact ShortComplex.ShortExact.mk' hex hmono hepi

theorem wc_d1_ell_unit_all : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F))) (T : X.left.ProEt)
    (A : Type u) [CommRing A] [IsLocalRing A] (e : T.left ≅ Spec (.of A)) (ℓ : ℕ),
    IsUnit ((ℓ : ℕ) : A) → ∀ (W : X.left.ProEt), IsUnit ((ℓ : ℕ) : Γ(W.left, ⊤)) :=
by
  intro F _ X T A _ _ e ℓ hA W
  let ψT : F →+* A := ((Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom.comp
    (e.inv.appTop.hom.comp ((T.hom ≫ X.hom).appTop.hom))).comp
      (Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom
  have hF : (ℓ : F) ≠ 0 := by
    intro h0
    have h1 : ψT (ℓ : F) = (ℓ : A) := map_natCast ψT ℓ
    rw [h0, map_zero] at h1
    rw [← h1] at hA
    exact not_isUnit_zero hA
  have hu : IsUnit (ℓ : F) := hF.isUnit
  let ψW : F →+* Γ(W.left, ⊤) := ((W.hom ≫ X.hom).appTop.hom).comp
    (Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom
  have h2 := hu.map ψW
  rwa [map_natCast] at h2

theorem wc_d1_gamma_forget_isSheaf : ∀ (S : Scheme.{u}), Presieve.IsSheaf (Scheme.ProEt.topology S)
    ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget CommRingCat.{u}) :=
by
  intro S
  have hb : Presieve.IsSheaf Scheme.fpqcTopology.{u} (Scheme.Γ ⋙ forget CommRingCat.{u}) := by
    let A1 : Scheme.{u} := Spec (CommRingCat.of (MvPolynomial PUnit.{u+1} (ULift.{u} ℤ)))
    let e : yoneda.obj A1 ≅ Scheme.Γ ⋙ forget CommRingCat.{u} :=
      NatIso.ofComponents (fun T => Equiv.toIso
        ((AffineSpace.toSpecMvPolyIntEquiv PUnit.{u+1} (X := T.unop)).trans
          (Equiv.funUnique PUnit.{u+1} _))) (by
        intro T T' g
        ext h
        exact AffineSpace.toSpecMvPolyIntEquiv_comp PUnit.{u+1} g.unop h PUnit.unit)
    exact Presieve.isSheaf_iso Scheme.fpqcTopology e
      (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable (yoneda.obj A1))
  have hb' : Presieve.IsSheaf Scheme.proetaleTopology.{u} (Scheme.Γ ⋙ forget CommRingCat.{u}) :=
    Presieve.isSheaf_of_le _ Scheme.proetaleTopology_le_fpqcTopology hb
  let G : Sheaf Scheme.proetaleTopology.{u} (Type u) :=
    ⟨Scheme.Γ ⋙ forget CommRingCat.{u}, (isSheaf_iff_isSheaf_of_type _ _).2 hb'⟩
  exact (isSheaf_iff_isSheaf_of_type _ _).1
    (Functor.op_comp_isSheaf (Scheme.ProEt.forget S ⋙ Over.forget S) (Scheme.ProEt.topology S)
      Scheme.proetaleTopology G)

theorem wc_d1_units_isSheaf_of_ring : ∀ (S : Scheme.{u}) (P : (S.ProEt)ᵒᵖ ⥤ CommRingCat.{u}),
    Presieve.IsSheaf (Scheme.ProEt.topology S) (P ⋙ forget CommRingCat.{u}) →
    Presheaf.IsSheaf (Scheme.ProEt.topology S)
      (P ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}) :=
by
  intro S R hR
  rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S)
    (R ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u})
    (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
  intro V Sv hS x hx
  have hP := hR Sv hS
  let Q := R ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
      CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u} ⋙
        forget AddCommGrpCat.{u+1}
  let P := R ⋙ forget CommRingCat.{u}
  let val : ∀ (W : (S.ProEt)ᵒᵖ), Q.obj W → P.obj W :=
    fun W a => ((Additive.toMul (ULift.down a) : (R.obj W)ˣ) : R.obj W)
  let ival : ∀ (W : (S.ProEt)ᵒᵖ), Q.obj W → P.obj W :=
    fun W a => (((Additive.toMul (ULift.down a) : (R.obj W)ˣ)⁻¹ : (R.obj W)ˣ) : R.obj W)
  have hmap : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
      val W' (Q.map g a) = P.map g (val W a) := fun g a => rfl
  have hmapi : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
      ival W' (Q.map g a) = P.map g (ival W a) := fun g a => rfl
  have hext : ∀ {W : (S.ProEt)ᵒᵖ} (a b : Q.obj W), val W a = val W b → a = b := by
    intro W a b h
    apply ULift.ext
    apply Additive.toMul.injective
    exact Units.ext h
  let a : Presieve.FamilyOfElements P Sv.arrows := fun Y f hf => val _ (x f hf)
  let b : Presieve.FamilyOfElements P Sv.arrows := fun Y f hf => ival _ (x f hf)
  have ha : a.Compatible := by
    intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
    change P.map g₁.op (val _ (x f₁ h₁)) = P.map g₂.op (val _ (x f₂ h₂))
    rw [← hmap, ← hmap]
    exact congrArg (val _) (hx g₁ g₂ h₁ h₂ comm)
  have hb : b.Compatible := by
    intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
    change P.map g₁.op (ival _ (x f₁ h₁)) = P.map g₂.op (ival _ (x f₂ h₂))
    rw [← hmapi, ← hmapi]
    exact congrArg (ival _) (hx g₁ g₂ h₁ h₂ comm)
  let α := hP.amalgamate a ha
  let β := hP.amalgamate b hb
  have hα : ∀ ⦃Y⦄ (f : Y ⟶ V) (hf : Sv.arrows f), P.map f.op α = a f hf :=
    fun Y f hf => hP.valid_glue ha f hf
  have hβ : ∀ ⦃Y⦄ (f : Y ⟶ V) (hf : Sv.arrows f), P.map f.op β = b f hf :=
    fun Y f hf => hP.valid_glue hb f hf
  have hαβ : (α * β : R.obj (Opposite.op V)) = 1 := by
    apply hP.isSeparatedFor.ext
    intro Y f hf
    change (R.map f.op).hom (α * β) = (R.map f.op).hom 1
    rw [map_mul, map_one]
    change P.map f.op α * P.map f.op β = 1
    rw [hα f hf, hβ f hf]
    exact Units.mul_inv _
  have hβα : (β * α : R.obj (Opposite.op V)) = 1 := by
    apply hP.isSeparatedFor.ext
    intro Y f hf
    change (R.map f.op).hom (β * α) = (R.map f.op).hom 1
    rw [map_mul, map_one]
    change P.map f.op β * P.map f.op α = 1
    rw [hα f hf, hβ f hf]
    exact Units.inv_mul _
  let υ : (R.obj (Opposite.op V))ˣ := ⟨α, β, hαβ, hβα⟩
  let t : Q.obj (Opposite.op V) := ULift.up (Additive.ofMul υ)
  refine ⟨t, ?_, ?_⟩
  · intro Y f hf
    apply hext
    exact (hmap f.op t).trans (hα f hf)
  · intro y hy
    apply hext
    refine hP.isSeparatedFor a (val _ y) α (fun Y f hf => ?_) hα
    rw [← hmap]
    exact congrArg (val _) (hy f hf)

theorem wc_d1_roots_isSheaf : ∀ (S : Scheme.{u}) (m : ℕ),
    Presheaf.IsSheaf (Scheme.ProEt.topology S)
      ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) →
    Presheaf.IsSheaf (Scheme.ProEt.topology S)
      ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun m ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}) :=
by
  intro S m hG
  let R := (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ
  let Q := ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ⋙
      forget AddCommGrpCat.{u+1}
  let P := ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun m ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}) ⋙ forget AddCommGrpCat.{u+1}
  have hQ : Presieve.IsSheaf (Scheme.ProEt.topology S) Q :=
    (isSheaf_iff_isSheaf_of_type _ _).1
      ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) _
        (forget AddCommGrpCat.{u+1})).1 hG)
  rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) _ (forget AddCommGrpCat.{u+1}),
    isSheaf_iff_isSheaf_of_type]
  intro V Sv hSv x hx
  have hP := hQ Sv hSv
  let incl : ∀ W : (S.ProEt)ᵒᵖ, P.obj W → Q.obj W := fun W a =>
    ULift.up (Additive.ofMul
      ((Additive.toMul (ULift.down a) : rootsOfUnity m (R.obj W)) : (R.obj W)ˣ))
  have hmapP : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W') (a : P.obj W),
      incl W' (P.map g a) = Q.map g (incl W a) := fun _ _ => rfl
  have hinj : ∀ {W : (S.ProEt)ᵒᵖ} (a b : P.obj W), incl W a = incl W b → a = b := by
    intro W a b h
    apply ULift.ext
    apply Additive.toMul.injective
    apply Subtype.ext
    exact congrArg (fun z : Q.obj W => (Additive.toMul (ULift.down z) : (R.obj W)ˣ)) h
  let pw : ∀ W : (S.ProEt)ᵒᵖ, Q.obj W → Q.obj W := fun W a =>
    ULift.up (Additive.ofMul ((Additive.toMul (ULift.down a) : (R.obj W)ˣ) ^ m))
  let one : ∀ W : (S.ProEt)ᵒᵖ, Q.obj W := fun W => ULift.up (Additive.ofMul (1 : (R.obj W)ˣ))
  have hpw : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
      Q.map g (pw W a) = pw W' (Q.map g a) := by
    intro W W' g a
    apply ULift.ext
    apply Additive.toMul.injective
    apply Units.ext
    change (R.map g).hom (((Additive.toMul (ULift.down a) : (R.obj W)ˣ) ^ m : (R.obj W)ˣ) : R.obj W) =
      (((Additive.toMul (ULift.down (Q.map g a)) : (R.obj W')ˣ) ^ m : (R.obj W')ˣ) : R.obj W')
    rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, map_pow]
    rfl
  have hone : ∀ {W W' : (S.ProEt)ᵒᵖ} (g : W ⟶ W'), Q.map g (one W) = one W' := by
    intro W W' g
    apply ULift.ext
    apply Additive.toMul.injective
    apply Units.ext
    change (R.map g).hom (1 : R.obj W) = (1 : R.obj W')
    exact map_one _
  have hincl_pw : ∀ (W : (S.ProEt)ᵒᵖ) (a : P.obj W), pw W (incl W a) = one W := by
    intro W a
    apply ULift.ext
    apply Additive.toMul.injective
    change ((Additive.toMul (ULift.down a) : rootsOfUnity m (R.obj W)) : (R.obj W)ˣ) ^ m = 1
    exact (mem_rootsOfUnity m _).1 (Additive.toMul (ULift.down a) : rootsOfUnity m (R.obj W)).2
  let y : Presieve.FamilyOfElements Q Sv.arrows := fun Y f hf => incl _ (x f hf)
  have hy : y.Compatible := by
    intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
    change Q.map g₁.op (incl _ (x f₁ h₁)) = Q.map g₂.op (incl _ (x f₂ h₂))
    rw [← hmapP, ← hmapP]
    exact congrArg (incl _) (hx g₁ g₂ h₁ h₂ comm)
  let t := hP.amalgamate y hy
  have ht : ∀ ⦃Y⦄ (f : Y ⟶ V) (hf : Sv.arrows f), Q.map f.op t = y f hf :=
    fun Y f hf => hP.valid_glue hy f hf
  have htm : pw _ t = one _ := by
    apply hP.isSeparatedFor.ext
    intro Y f hf
    exact (hpw f.op t).trans ((congrArg (pw _) (ht f hf)).trans
      ((hincl_pw _ (x f hf)).trans (hone f.op).symm))
  have hvm : (Additive.toMul (ULift.down t) : (R.obj (Opposite.op V))ˣ) ^ m = 1 :=
    congrArg (fun z : Q.obj (Opposite.op V) => (Additive.toMul (ULift.down z) : (R.obj (Opposite.op V))ˣ)) htm
  let s : P.obj (Opposite.op V) := ULift.up (Additive.ofMul
    (⟨(Additive.toMul (ULift.down t) : (R.obj (Opposite.op V))ˣ), (mem_rootsOfUnity m _).2 hvm⟩ :
      rootsOfUnity m (R.obj (Opposite.op V))))
  have hs : incl _ s = t := rfl
  refine ⟨s, ?_, ?_⟩
  · intro Y f hf
    apply hinj
    exact (hmapP f.op s).trans ((congrArg (Q.map f.op) hs).trans (ht f hf))
  · intro s' hs'
    apply hinj
    exact (hP.isSeparatedFor y (incl _ s') t
      (fun Y f hf => (hmapP f.op s').symm.trans (congrArg (incl _) (hs' f hf)))
      (fun Y f hf => ht f hf)).trans hs.symm

theorem wc_d1_kummer_algebra : ∀ (m : ℕ), 0 < m → ∀ (R : Type u) [CommRing R], IsUnit ((m : ℕ) : R) →
    ∀ y : Rˣ, ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
      Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
      ∃ x : B, x ^ m = algebraMap R B (y : R) :=
by
  intro m hm R _ hmR y
  classical
  have hm0 : m ≠ 0 := Nat.pos_iff_ne_zero.mp hm
  set f : Polynomial R := Polynomial.X ^ m - Polynomial.C (y : R) with hf
  have hfm : f.Monic := Polynomial.monic_X_pow_sub_C (y : R) hm0
  obtain ⟨u, hu⟩ := (hmR.mul y.isUnit).exists_left_inv
  have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
      Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
    refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (m : R)), 1, ?_⟩
    have hd : Polynomial.derivative f = Polynomial.C (m : R) * Polynomial.X ^ (m - 1) := by
      rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero]
    have hX : Polynomial.X ^ (m - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ m :=
      pow_sub_one_mul hm0 Polynomial.X
    have hu' : Polynomial.C u * (Polynomial.C (m : R) * Polynomial.C (y : R)) = 1 := by
      rw [← map_mul, ← map_mul, hu, map_one]
    rw [hd, hf, pow_one]
    linear_combination hu' + (Polynomial.C u * Polynomial.C (m : R)) * hX
  let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
  have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
    (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
      ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
  have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
  have het : Algebra.Etale R (AdjoinRoot f) := Algebra.Etale.of_equiv e
  refine ⟨AdjoinRoot f, inferInstance, inferInstance, het, ?_, AdjoinRoot.root f, ?_⟩
  · rcases subsingleton_or_nontrivial R with hR | hR
    · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
      intro x
      exact isEmptyElim x
    · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
      let pb := AdjoinRoot.powerBasis' hfm
      have hdim : 0 < pb.dim := by
        rw [AdjoinRoot.powerBasis'_dim, hf, Polynomial.natDegree_X_pow_sub_C]
        exact hm
      have : Nontrivial (AdjoinRoot f) := nontrivial_of_ne _ _ (pb.basis.ne_zero ⟨0, hdim⟩)
      exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
  · have h1 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
      rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
    rw [hf, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h1
    exact sub_eq_zero.mp h1

theorem wc_d1_local_root_cover : ∀ (S : Scheme.{u}) (m : ℕ) (_hm : 0 < m)
    (_hKum : ∀ (R : Type u) [CommRing R], IsUnit ((m : ℕ) : R) → ∀ y : Rˣ,
      ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
        Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
        ∃ x : B, x ^ m = algebraMap R B (y : R))
    (U : S.ProEt), IsUnit ((m : ℕ) : Γ(U.left, ⊤)) → ∀ (y : (Γ(U.left, ⊤))ˣ),
    ∃ (V : S.ProEt) (g : V ⟶ U) (x : (Γ(V.left, ⊤))ˣ),
      Sieve.generate (Presieve.singleton g) ∈ Scheme.ProEt.topology S U ∧
      (x : Γ(V.left, ⊤)) ^ m = g.left.appTop.hom (y : Γ(U.left, ⊤)) :=
by
  intro S m hm hKum U hmR y
  classical
  have hm0 : m ≠ 0 := Nat.pos_iff_ne_zero.mp hm
  obtain ⟨B, _, _, hBet, hBsurj, x', hx'⟩ := hKum Γ(U.left, ⊤) hmR y
  let φ : CommRingCat.of Γ(U.left, ⊤) ⟶ CommRingCat.of B :=
    CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) B)
  let gS : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of Γ(U.left, ⊤)) := Spec.map φ
  haveI hg : Etale gS := by
    apply (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
    rw [CommRingCat.hom_ofHom]
    exact RingHom.etale_algebraMap.mpr hBet
  haveI hgs : Surjective gS := by
    constructor
    exact hBsurj
  haveI hgq : QuasiCompact gS := inferInstance
  let p := Limits.pullback.fst U.left.toSpecΓ gS
  let q := Limits.pullback.snd U.left.toSpecΓ gS
  haveI hpe : Etale p := inferInstance
  haveI hps : Surjective p := inferInstance
  haveI hpq : QuasiCompact p := inferInstance
  have hW : WeaklyEtale (p ≫ U.hom) :=
    @MorphismProperty.comp_mem _ _ @WeaklyEtale
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      _ _ _ p U.hom (etale_le_weaklyEtale _ _ _ hpe) U.prop
  let V : S.ProEt := MorphismProperty.Over.mk ⊤ (p ≫ U.hom) hW
  let g : V ⟶ U := MorphismProperty.Over.homMk p rfl trivial
  have hcov : Sieve.generate (Presieve.singleton g) ∈ Scheme.ProEt.topology S U := by
    apply Precoverage.generate_mem_toGrothendieck
    change Presieve.singleton g ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
      Scheme.proetalePrecoverage).coverings U
    rw [Precoverage.mem_comap_iff, Presieve.map_singleton]
    exact Scheme.Hom.singleton_mem_propQCPrecoverage (P := @WeaklyEtale) (f := p)
      (etale_le_weaklyEtale _ _ _ hpe)
  have hc : U.left.toSpecΓ.appTop ≫ p.appTop = gS.appTop ≫ q.appTop := by
    rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
  have hn := Scheme.ΓSpecIso_inv_naturality φ
  have key : φ ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop = p.appTop := by
    rw [← Category.assoc, hn, Category.assoc, ← hc, Scheme.toSpecΓ_appTop]
    exact Iso.inv_hom_id_assoc _ _
  have hkey : ∀ r : Γ(U.left, ⊤), q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
      (algebraMap Γ(U.left, ⊤) B r)) = p.appTop.hom r :=
    fun r => congrArg (fun h => h.hom r) key
  let x0 : Γ(V.left, ⊤) := q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom x')
  have hx0 : x0 ^ m = g.left.appTop.hom (y : Γ(U.left, ⊤)) := by
    change (q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom x')) ^ m =
      p.appTop.hom (y : Γ(U.left, ⊤))
    rw [← map_pow, ← map_pow, hx', hkey]
  have hu : IsUnit x0 := by
    have h1 : IsUnit (x0 ^ m) := by rw [hx0]; exact y.isUnit.map _
    exact (isUnit_pow_iff hm0).mp h1
  exact ⟨V, g, hu.unit, hcov, by rw [IsUnit.unit_spec]; exact hx0⟩

theorem wc_d1_kummer_ses : ∀ (S : Scheme.{u}) (m : ℕ)
    (hG : Presheaf.IsSheaf (Scheme.ProEt.topology S)
      ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}))
    (hμ : Presheaf.IsSheaf (Scheme.ProEt.topology S)
      ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun m ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}))
    (_hloc : ∀ (U : S.ProEt) (y : (Γ(U.left, ⊤))ˣ), ∃ (V : S.ProEt) (g : V ⟶ U) (x : (Γ(V.left, ⊤))ˣ),
      Sieve.generate (Presieve.singleton g) ∈ Scheme.ProEt.topology S U ∧
      (x : Γ(V.left, ⊤)) ^ m = g.left.appTop.hom (y : Γ(U.left, ⊤))),
    ∃ (ι : (⟨_, hμ⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) ⟶ ⟨_, hG⟩)
      (wι : ι ≫ (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})) = 0),
      (ShortComplex.mk ι (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}))
        wι).ShortExact :=
by
  intro S m hG hμ hloc
  let ιpre : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun m ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}) ⟶
      ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) :=
    { app := fun W => AddCommGrpCat.ofHom
        { toFun := fun ζ => ULift.up (Additive.ofMul
            ((Additive.toMul ζ.down : rootsOfUnity m Γ(W.unop.left, ⊤)) : (Γ(W.unop.left, ⊤))ˣ))
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      naturality := by
        intro W W' g
        ext ζ
        apply ULift.ext
        apply Additive.toMul.injective
        apply Units.ext
        rfl }
  let ι : (⟨_, hμ⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) ⟶ ⟨_, hG⟩ :=
    ObjectProperty.homMk ιpre
  have hι : ∀ (W : (S.ProEt)ᵒᵖ) (ζ : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      wcRootsFun m ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).obj W),
      ι.hom.app W ζ = ULift.up (Additive.ofMul
        ((Additive.toMul ζ.down : rootsOfUnity m Γ(W.unop.left, ⊤)) : (Γ(W.unop.left, ⊤))ˣ)) :=
    fun _ _ => rfl
  have hg : ∀ (W : (S.ProEt)ᵒᵖ) (z : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u}).obj W),
      (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})).hom.app W z = m • z := by
    intro W z
    have hnsapp : ∀ {P Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (φ : P ⟶ Q) (k : ℕ)
        (W : (S.ProEt)ᵒᵖ) (x : P.obj.obj W), (k • φ).hom.app W x = k • φ.hom.app W x := by
      intro P Q φ k W x
      have e3 : (k • φ).hom = k • φ.hom :=
        (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_nsmul
      rw [e3, NatTrans.app_nsmul]
      rfl
    exact hnsapp (𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})) m W z
  have wι : ι ≫ (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})) = 0 := by
    apply Sheaf.hom_ext
    ext W ζ
    change (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})).hom.app W
      (ι.hom.app W ζ) = 0
    rw [hg, hι]
    apply ULift.ext
    apply Additive.toMul.injective
    change ((Additive.toMul ζ.down : rootsOfUnity m Γ(W.unop.left, ⊤)) : (Γ(W.unop.left, ⊤))ˣ) ^ m = 1
    exact (Additive.toMul ζ.down).2
  have H1 : ∀ (U : S.ProEt) (a : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      wcRootsFun m ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).obj (Opposite.op U)),
      ι.hom.app (Opposite.op U) a = 0 → a = 0 := by
    intro U a ha
    have h1 : ((Additive.toMul a.down : rootsOfUnity m Γ(U.left, ⊤)) : (Γ(U.left, ⊤))ˣ) = 1 :=
      congrArg (fun z : ULift.{u+1} (Additive (Γ(U.left, ⊤))ˣ) => Additive.toMul z.down) ha
    apply ULift.ext
    apply Additive.toMul.injective
    exact Subtype.ext h1
  have H2 : ∀ (U : S.ProEt) (b : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u}).obj (Opposite.op U)),
      (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})).hom.app
        (Opposite.op U) b = 0 → ∃ a, ι.hom.app (Opposite.op U) a = b := by
    intro U b hb
    rw [hg] at hb
    have hu : (Additive.toMul b.down : (Γ(U.left, ⊤))ˣ) ^ m = 1 :=
      congrArg (fun z : ULift.{u+1} (Additive (Γ(U.left, ⊤))ˣ) => Additive.toMul z.down) hb
    exact Exists.intro (ULift.up (Additive.ofMul (⟨Additive.toMul b.down, hu⟩ :
      rootsOfUnity m Γ(U.left, ⊤)))) rfl
  have H3 : ∀ (U : S.ProEt) (q : ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u}).obj (Opposite.op U)),
      Presheaf.imageSieve
        (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})).hom q ∈
        Scheme.ProEt.topology S U := by
    intro U q
    obtain ⟨V, g, x, hcov, hx⟩ := hloc U (Additive.toMul q.down)
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff, Presieve.singleton_le_iff]
    have hxu : x ^ m = Units.map g.left.appTop.hom.toMonoidHom (Additive.toMul q.down) := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, Units.coe_map]
      exact hx
    refine Exists.intro (ULift.up (Additive.ofMul x)) ((hg _ _).trans ?_)
    change ULift.up (Additive.ofMul (x ^ m)) =
      ULift.up (Additive.ofMul (Units.map g.left.appTop.hom.toMonoidHom (Additive.toMul q.down)))
    rw [hxu]

  have hmono : Mono ι := by
    haveI : Sheaf.IsLocallyInjective ι := (Sheaf.isLocallyInjective_iff_injective ι).mpr
      (fun X => (injective_iff_map_eq_zero _).mpr (fun a ha => H1 X.unop a ha))
    exact Sheaf.mono_of_isLocallyInjective ι
  have hepi : Epi (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})) := by
    haveI : Sheaf.IsLocallySurjective
        (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})) :=
      Presheaf.IsLocallySurjective.mk (fun {U} q => H3 U q)
    exact Sheaf.epi_of_isLocallySurjective _
  have hk0 : ∀ X : (S.ProEt)ᵒᵖ, Function.Injective ((Limits.kernel.ι
      (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}))).hom.app X) :=
    fun X => by
      have h1 : Mono ((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
          (Limits.kernel.ι
            (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})))) :=
        Functor.map_mono _ _
      exact (AddCommGrpCat.mono_iff_injective _).mp ((NatTrans.mono_iff_mono_app _).mp h1 X)
  have hk : Epi (Limits.kernel.lift
      (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})) ι wι) := by
    haveI : Sheaf.IsLocallySurjective (Limits.kernel.lift
        (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})) ι wι) :=
      Presheaf.isLocallySurjective_of_surjective (Scheme.ProEt.topology S) _ (fun X s => by
        have hb : (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})).hom.app X
            ((Limits.kernel.ι
              (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}))).hom.app X s)
            = 0 := by
          have h := congrArg (fun φ => (φ.hom.app X) s) (Limits.kernel.condition
            (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})))
          exact h
        obtain ⟨a, ha⟩ := H2 X.unop _ hb
        refine ⟨a, hk0 X ?_⟩
        have h := congrArg (fun φ => (φ.hom.app X) a) (Limits.kernel.lift_ι
          (m • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})) ι wι)
        exact h.trans ha)
    exact Sheaf.epi_of_isLocallySurjective _
  exact ⟨ι, wι, ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_epi_kernel_lift _).mpr hk)
    hmono hepi⟩

theorem wc_d1_zmod_tensor_one_bij : ∀ (m : ℕ), 0 < m → ∀ (M : Type u) [AddCommGroup M],
    (∀ x : M, m • x = 0) →
    Function.Bijective (fun ζ : M => (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ)) :=
by
  intro m hm M _ hM
  have : NeZero m := ⟨by omega⟩
  set e : PiTensorProduct ℤ (fun _ : Fin 1 => M) ≃ₗ[ℤ] M :=
    PiTensorProduct.subsingletonEquiv (0 : Fin 1) with he_def
  have he : ∀ ζ : M, e (PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ)) = ζ := fun ζ =>
    PiTensorProduct.subsingletonEquiv_apply_tprod _ _
  have hes : ∀ ζ : M, e.symm ζ = PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ) := fun ζ => by
    rw [LinearEquiv.symm_apply_eq, he]
  set g0 : ℤ →+ (PiTensorProduct ℤ (fun _ : Fin 1 => M) →ₗ[ℤ] M) :=
    zmultiplesHom (PiTensorProduct ℤ (fun _ : Fin 1 => M) →ₗ[ℤ] M) e.toLinearMap with hg0_def
  have hg0v : ∀ (k : ℤ) p, g0 k p = k • e p := by
    intro k p
    simp [g0, zmultiplesHom_apply]
  have hg0 : g0 (m : ℤ) = 0 := by
    refine LinearMap.ext fun p => ?_
    rw [hg0v, LinearMap.zero_apply, natCast_zsmul, hM]
  set B : ZMod m →+ (PiTensorProduct ℤ (fun _ : Fin 1 => M) →ₗ[ℤ] M) :=
    ZMod.lift m ⟨g0, hg0⟩ with hB_def
  have hBv : ∀ (k : ℤ) p, B (k : ZMod m) p = k • e p := by
    intro k p
    rw [hB_def, ZMod.lift_coe]
    exact hg0v k p
  set β := TensorProduct.lift B.toIntLinearMap with hβ_def
  have hβ : ∀ (k : ℤ) p, β ((k : ZMod m) ⊗ₜ[ℤ] p) = k • e p := by
    intro k p
    rw [hβ_def, TensorProduct.lift.tmul]
    exact hBv k p
  set f := (fun ζ : M => (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ))
    with hf_def
  have hf : ∀ ζ, f ζ = (1 : ZMod m) ⊗ₜ[ℤ] e.symm ζ := fun ζ => by rw [hes]
  have hleft : Function.LeftInverse β f := by
    intro ζ
    rw [hf, ← Int.cast_one, hβ, one_smul, LinearEquiv.apply_symm_apply]
  have hright : Function.RightInverse β f := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, hf, map_zero, TensorProduct.tmul_zero]
    | tmul a p =>
      obtain ⟨k, rfl⟩ := ZMod.intCast_surjective a
      rw [hβ, hf, map_zsmul, LinearEquiv.symm_apply_apply, TensorProduct.tmul_smul,
        TensorProduct.smul_tmul', zsmul_eq_mul, mul_one]
    | add x y hx hy =>
      rw [map_add, hf, map_add, TensorProduct.tmul_add, ← hf, ← hf, hx, hy]
  exact ⟨hleft.injective, hright.surjective⟩

theorem wc_d1_roots_twist_iso : ∀ (S : Scheme.{u}) (m : ℕ) (_hm : 0 < m)
    (hμ : Presheaf.IsSheaf (Scheme.ProEt.topology S)
      ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun m ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}))
    (_hbij : ∀ (M : Type u) [AddCommGroup M], (∀ x : M, m • x = 0) →
      Function.Bijective (fun ζ : M => (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ))),
    Nonempty ((⟨_, hμ⟩ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) ≅ wcRootTwist S m 1) :=
by
  intro S m _hm hμ hbij
  classical

  let θ : ∀ (M : Type u) [AddCommGroup M],
      M →+ TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin 1 => M)) :=
    fun M _ => ((TensorProduct.mk ℤ (ZMod m) (PiTensorProduct ℤ fun _ : Fin 1 => M) 1).comp
      (PiTensorProduct.subsingletonEquiv (R := ℤ) (s := fun _ : Fin 1 => M) 0).symm.toLinearMap).toAddMonoidHom
  have hθ : ∀ (M : Type u) [AddCommGroup M] (a : M),
      θ M a = (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin 1 => a) := by
    intro M _ a
    have h1 : (PiTensorProduct.subsingletonEquiv (R := ℤ) (s := fun _ : Fin 1 => M) 0).symm a =
        PiTensorProduct.tprod ℤ (fun _ : Fin 1 => a) := by
      rw [LinearEquiv.symm_apply_eq, PiTensorProduct.subsingletonEquiv_apply_tprod]
    show (1 : ZMod m) ⊗ₜ[ℤ] (PiTensorProduct.subsingletonEquiv (R := ℤ)
      (s := fun _ : Fin 1 => M) 0).symm a = _
    rw [h1]

  have htor : ∀ (R : CommRingCat.{u}) (x : Additive (rootsOfUnity m R)), m • x = 0 := by
    intro R x
    apply Additive.toMul.injective
    rw [toMul_nsmul, toMul_zero]
    apply Subtype.ext
    simpa using (mem_rootsOfUnity m _).mp (Additive.toMul x).prop

  let η : wcRootsFun m ⟶ wcRootsFun m ⋙ wcTwistFun m 1 :=
    { app := fun R => AddCommGrpCat.ofHom (θ ((wcRootsFun m).obj R))
      naturality := by
        intro R R' φ
        ext x
        change θ ((wcRootsFun m).obj R') (((wcRootsFun m).map φ).hom x) =
          (LinearMap.lTensor (ZMod m) (PiTensorProduct.map fun _ : Fin 1 =>
            ((wcRootsFun m).map φ).hom.toIntLinearMap)) (θ ((wcRootsFun m).obj R) x)
        rw [hθ, hθ, LinearMap.lTensor_tmul, PiTensorProduct.map_tprod]
        rfl }
  let ν : (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcRootsFun m ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u} ⟶ wcRootTwistPre S m 1 :=
    Functor.whiskerLeft ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ)
      (Functor.whiskerRight η AddCommGrpCat.uliftFunctor.{u+1, u})
  have hbijν : ∀ W, Function.Bijective (ν.app W).hom := by
    intro W
    have hb := hbij ((wcRootsFun m).obj (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙
      Scheme.Γ).obj W)) (fun x => htor _ x)
    have hfun : (⇑(θ ((wcRootsFun m).obj (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙
        Scheme.Γ).obj W)))) = fun ζ => (1 : ZMod m) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin 1 => ζ) :=
      funext (hθ _)
    rw [← hfun] at hb
    exact Equiv.ulift.symm.bijective.comp (hb.comp Equiv.ulift.bijective)
  haveI : ∀ W, IsIso (ν.app W) := fun W =>
    (ConcreteCategory.isIso_iff_bijective _).mpr (hbijν W)
  haveI : IsIso ν := NatIso.isIso_of_isIso_app ν
  exact ⟨sheafificationIso ⟨_, hμ⟩ ≪≫
    (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).mapIso (asIso ν)⟩

theorem wc_d1_tuple_to_units_nat : ∀ (S : Scheme.{u}) (UT : (S.ProEt)ᵒᵖ ⥤ Type u)
    (val : ∀ W : S.ProEt, UT.obj (Opposite.op W) → (Γ(W.left, ⊤))ˣ)
    (_hval : ∀ (W W' : S.ProEt) (f : W ⟶ W') (x : UT.obj (Opposite.op W')),
      val W (UT.map f.op x) = Units.map f.left.appTop.hom.toMonoidHom (val W' x)),
    ∃ β : (UT ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
        ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
          CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}),
      ∀ (W : S.ProEt) (x : UT.obj (Opposite.op W)),
        β.app (Opposite.op W) (FreeAbelianGroup.of (ULift.up x)) = ULift.up (Additive.ofMul (val W x)) :=
by
  intro S UT val hval
  refine ⟨{ app := fun W => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
      fun y : ULift.{u+1} (UT.obj W) => (ULift.up (Additive.ofMul (val W.unop y.down)) :
        ULift.{u+1} (Additive (Γ(W.unop.left, ⊤))ˣ))), naturality := ?_ }, ?_⟩
  · intro W W' φ
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro a
    obtain ⟨x⟩ := a
    have h1 : (FreeAbelianGroup.lift fun y : ULift.{u+1} (UT.obj W') =>
        (ULift.up (Additive.ofMul (val W'.unop y.down)) :
          ULift.{u+1} (Additive (Γ(W'.unop.left, ⊤))ˣ)))
        (FreeAbelianGroup.of (ULift.up (UT.map φ x))) =
        ULift.up (Additive.ofMul (val W'.unop (UT.map φ x))) :=
      FreeAbelianGroup.lift_apply_of _ _
    have h2 : (FreeAbelianGroup.lift fun y : ULift.{u+1} (UT.obj W) =>
        (ULift.up (Additive.ofMul (val W.unop y.down)) :
          ULift.{u+1} (Additive (Γ(W.unop.left, ⊤))ˣ)))
        (FreeAbelianGroup.of (ULift.up x)) =
        ULift.up (Additive.ofMul (val W.unop x)) :=
      FreeAbelianGroup.lift_apply_of _ _
    have h3 : (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
          CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map
            φ.unop.op).hom (ULift.up (Additive.ofMul (val W.unop x))) =
        ULift.up (Additive.ofMul (Units.map φ.unop.left.appTop.hom.toMonoidHom (val W.unop x))) := rfl
    have e2 : val W'.unop (UT.map φ.unop.op x) =
        Units.map φ.unop.left.appTop.hom.toMonoidHom (val W.unop x) := hval W'.unop W.unop φ.unop x
    have h4 := congrArg (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
      forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u}).map φ.unop.op).hom h2
    exact h1.trans ((congrArg (fun y => (ULift.up (Additive.ofMul y) :
      ULift.{u+1} (Additive (Γ(W'.unop.left, ⊤))ˣ))) e2).trans (h3.symm.trans h4.symm))
  · intro W x
    exact FreeAbelianGroup.lift_apply_of _ _

theorem wc_d1_free_yoneda_eval : ∀ (S : Scheme.{u}) (Q : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (hQ : Presheaf.IsSheaf (Scheme.ProEt.topology S) Q)
    (UT : (S.ProEt)ᵒᵖ ⥤ Type u) (β : (UT ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q)
    (V D : S.ProEt) (a : V ⟶ D) (x : UT.obj (Opposite.op D)),
    (((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (Functor.whiskerRight (yonedaEquiv.symm x) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
      ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
        (UT ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟨Q, hQ⟩).symm β).hom.app
        (Opposite.op V)
        ((toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op V) (FreeAbelianGroup.of (ULift.up (𝟙 V))))) =
      Q.map a.op (β.app (Opposite.op D) (FreeAbelianGroup.of (ULift.up x))) :=
by
  intro S Q hQ UT β V D a x
  rw [← Adjunction.homEquiv_naturality_left_symm, ← Adjunction.homEquiv_naturality_left_symm]
  have key : ∀ (P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (γ : P ⟶ Q) (U : (S.ProEt)ᵒᵖ) (s : P.obj U),
      (((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
        P ⟨Q, hQ⟩).symm γ).hom.app U
        ((toSheafify (Scheme.ProEt.topology S) P).app U s) = γ.app U s := by
    intro P γ U s
    have h := (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv_unit
      P ⟨Q, hQ⟩ (((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
        P ⟨Q, hQ⟩).symm γ)
    rw [Equiv.apply_symm_apply, sheafificationAdjunction_unit_app] at h
    exact (congrArg (fun φ : P ⟶ Q => φ.app U s) h).symm
  refine Eq.trans (key _ _ (Opposite.op V) _) ?_
  have hn := NatTrans.naturality_apply β a.op (FreeAbelianGroup.of (ULift.up x))
  refine Eq.trans ?_ hn
  have hfr : ∀ {X Y : Type u} (f : X ⟶ Y) (t : X),
      ((uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f)
        (FreeAbelianGroup.of (ULift.up t : ULift.{u+1} X)) =
      FreeAbelianGroup.of (ULift.up (f t) : ULift.{u+1} Y) := by
    intro X Y f t
    rfl
  have hs : ((Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op V) ≫
      (Functor.whiskerRight (yonedaEquiv.symm x) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op V))
      (FreeAbelianGroup.of (ULift.up (𝟙 V) :
        uliftFunctor.{u+1, u}.obj ((yoneda.obj V).obj (Opposite.op V)))) =
      (UT ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map a.op
        (FreeAbelianGroup.of (ULift.up x)) := by
    change ((uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map ((yonedaEquiv.symm x).app (Opposite.op V)))
        (((uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map ((yoneda.map a).app (Opposite.op V)))
          (FreeAbelianGroup.of (ULift.up (𝟙 V) : ULift.{u+1} (V ⟶ V)))) =
      ((uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map (UT.map a.op))
        (FreeAbelianGroup.of (ULift.up x : ULift.{u+1} (UT.obj (Opposite.op D))))
    rw [hfr, hfr]
    erw [hfr]
    simp [yonedaEquiv_symm_app_apply, yoneda_map_app]
    rfl
  exact congrArg (β.app (Opposite.op V)) hs

theorem wc_d1_ext_kummer_lift : ∀ {C : Type u} [Category.{v} C] [Abelian C] [HasExt.{w} C] {X M G : C}
    (ι : M ⟶ G) (m : ℕ) (wι : ι ≫ (m • 𝟙 G) = 0) (hS : (ShortComplex.mk ι (m • 𝟙 G) wι).ShortExact)
    (g : X ⟶ G) (k : ℕ),
    k • (Abelian.Ext.mk₀ g).comp hS.extClass (zero_add 1) = 0 →
    ∃ h : X ⟶ G, h ≫ (m • 𝟙 G) = k • g :=
by
  intro C _ _ _ X M G ι m wι hS g k hk
  have hmove : ∀ j : ℕ, j • (Abelian.Ext.mk₀ g).comp hS.extClass (zero_add 1) =
      (Abelian.Ext.mk₀ (j • g)).comp hS.extClass (zero_add 1) := by
    intro j
    induction j with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
    | succ j ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp, ih]
  rw [hmove] at hk
  obtain ⟨x₂, hx₂⟩ :=
    Abelian.Ext.covariant_sequence_exact₃ X hS (Abelian.Ext.mk₀ (k • g)) (zero_add 1) hk
  refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
  apply (Abelian.Ext.mk₀_bijective X G).1
  rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
  exact hx₂

theorem wc_d1_dvr_pow_dvd : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] (t : A),
    Ideal.span {t} = IsLocalRing.maximalIdeal A → ringKrullDim A = ((1 : ℕ) : WithBot ℕ∞) →
    IsDomain A ∧ t ≠ 0 ∧ ∀ (a b : ℕ) (x : A), 0 < b → t ^ a = x ^ b → b ∣ a :=
by
  classical
  intro A _ _ _ t hspan hdim
  have htmem : t ∈ IsLocalRing.maximalIdeal A := by
    rw [← hspan]; exact Ideal.mem_span_singleton_self t
  have htnu : ¬ IsUnit t := (IsLocalRing.mem_maximalIdeal t).mp htmem

  have hfac : ∀ x : A, x ≠ 0 → ∃ (u : A) (n : ℕ), IsUnit u ∧ x = u * t ^ n := by
    intro x hx
    have hinf := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal A)
      (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    have hex : ∃ i, ¬ t ^ i ∣ x := by
      by_contra hcon
      push_neg at hcon
      apply hx
      have hmem : x ∈ ⨅ i, IsLocalRing.maximalIdeal A ^ i := by
        rw [Submodule.mem_iInf]
        intro i
        rw [← hspan, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        exact hcon i
      rw [hinf] at hmem
      exact (Submodule.mem_bot A).mp hmem
    have hN := Nat.find_spec hex
    have hN0 : Nat.find hex ≠ 0 := by
      intro h0
      rw [h0, pow_zero] at hN
      exact hN (one_dvd x)
    obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hN0
    have hmin : t ^ n ∣ x := by
      have h := Nat.find_min hex (show n < Nat.find hex by omega)
      exact not_not.mp h
    obtain ⟨c, hc⟩ := hmin
    refine ⟨c, n, ?_, by rw [hc, mul_comm]⟩
    by_contra hcu
    have hcm : c ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal c).mpr hcu
    rw [← hspan, Ideal.mem_span_singleton] at hcm
    obtain ⟨c', hc'⟩ := hcm
    apply hN
    rw [hn]
    exact ⟨c', by rw [hc, hc', pow_succ, mul_assoc]⟩

  have hne : ∀ k : ℕ, t ^ k ≠ 0 := by
    intro k hk
    have hmax : ∀ P : Ideal A, P.IsPrime → P.IsMaximal := by
      intro P hP
      have ht : t ∈ P := hP.mem_of_pow_mem k (by rw [hk]; exact P.zero_mem)
      have hle : IsLocalRing.maximalIdeal A ≤ P := by
        rw [← hspan, Ideal.span_singleton_le_iff_mem]; exact ht
      have heq := (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le hP.ne_top hle
      rw [← heq]; exact IsLocalRing.maximalIdeal.isMaximal A
    have h0 : Ring.KrullDimLE 0 A := Ring.KrullDimLE.mk₀ (fun P hP => hmax P hP)
    have hle := (Ring.krullDimLE_iff (n := 0) (R := A)).mp h0
    rw [hdim] at hle
    exact absurd (Nat.cast_le.mp hle) (by norm_num)

  haveI hdom : IsDomain A := by
    haveI : NoZeroDivisors A := ⟨by
      intro x y hxy
      by_contra hcon
      push_neg at hcon
      obtain ⟨u, n, hu, rfl⟩ := hfac x hcon.1
      obtain ⟨v, m, hv, rfl⟩ := hfac y hcon.2
      apply hne (n + m)
      have h2 : (u * v) * t ^ (n + m) = 0 := by rw [← hxy]; ring
      exact (hu.mul hv).mul_right_eq_zero.mp h2⟩
    exact NoZeroDivisors.to_isDomain A
  refine ⟨hdom, by simpa using hne 1, ?_⟩
  intro a b x hb hab
  have hx : x ≠ 0 := by
    rintro rfl
    exact hne a (by rw [hab, zero_pow (by omega)])
  obtain ⟨u, n, hu, rfl⟩ := hfac x hx
  rw [mul_pow, ← pow_mul] at hab
  have hub : IsUnit (u ^ b) := hu.pow b
  have key : a = n * b := by
    rcases lt_trichotomy a (n * b) with h | h | h
    · exfalso
      obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_lt h
      rw [hk] at hab
      have h1 : t ^ a * 1 = t ^ a * (u ^ b * t ^ k * t) := by
        rw [mul_one]; conv_lhs => rw [hab]
        ring
      have h2 := mul_left_cancel₀ (hne a) h1
      exact htnu (isUnit_of_dvd_one ⟨u ^ b * t ^ k, by rw [h2]; ring⟩)
    · exact h
    · exfalso
      obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_lt h
      rw [hk] at hab
      have h1 : t ^ (n * b) * (t ^ k * t) = t ^ (n * b) * u ^ b := by
        rw [mul_comm (t ^ (n * b)) (u ^ b), ← hab]; ring
      have h2 := mul_left_cancel₀ (hne (n * b)) h1
      rw [← h2] at hub
      exact htnu (isUnit_of_mul_isUnit_right hub)
  exact ⟨n, by rw [key, mul_comm]⟩

theorem wc_d1_away_pow_dvd : ∀ (A : Type u) [CommRing A] [IsDomain A] (t : A), t ≠ 0 →
    (∀ (a b : ℕ) (x : A), 0 < b → t ^ a = x ^ b → b ∣ a) →
    ∀ (z : Localization.Away t) (a b : ℕ), 0 < b →
      z ^ b = (algebraMap A (Localization.Away t) t) ^ a → b ∣ a :=
by
  intro A _ _ t ht H z a b hb hz
  obtain ⟨n, c, hc⟩ := IsLocalization.Away.surj t z
  have hinj : Function.Injective (algebraMap A (Localization.Away t)) :=
    IsLocalization.injective (Localization.Away t) (powers_le_nonZeroDivisors_of_noZeroDivisors ht)
  have key : algebraMap A (Localization.Away t) (c ^ b) =
      algebraMap A (Localization.Away t) (t ^ (a + n * b)) := by
    rw [map_pow, map_pow, ← hc, mul_pow, hz, pow_add, ← pow_mul, mul_comm n b]
  have h2 : t ^ (a + n * b) = c ^ b := (hinj key).symm
  have h3 : b ∣ a + n * b := H _ _ _ hb h2
  exact (Nat.dvd_add_left (dvd_mul_left b n)).mp h3

theorem wc_d1_punct_to_away : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (t : A),
    Ideal.span {t} = IsLocalRing.maximalIdeal A →
    ∀ (Y Z : Scheme.{u}) (j : Y ⟶ Z), IsOpenImmersion j → ∀ (e : Z ≅ Spec (.of A)),
    Set.range j = {e.inv (IsLocalRing.closedPoint A)}ᶜ →
    ∃ ρ : Γ(Y, ⊤) →+* Localization.Away t, ∀ a : A,
      ρ ((j ≫ e.hom).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) =
        algebraMap A (Localization.Away t) a :=
by
  intro A _ _ t hspan Y Z j hj e hrange
  haveI := hj
  let φ : A →+* Localization.Away t := algebraMap A (Localization.Away t)
  let ι : Spec (.of (Localization.Away t)) ⟶ Spec (.of A) := Spec.map (CommRingCat.ofHom φ)
  have ht : t ∈ IsLocalRing.maximalIdeal A := hspan ▸ Ideal.mem_span_singleton_self t
  have hne : ∀ y, ι y ≠ IsLocalRing.closedPoint A := by
    intro y hy
    have h1 : (ι y).asIdeal = IsLocalRing.maximalIdeal A := by rw [hy]; rfl
    have h2 : (ι y).asIdeal = Ideal.comap φ y.asIdeal := rfl
    rw [h2] at h1
    have hmem : φ t ∈ y.asIdeal := by
      have h3 : t ∈ Ideal.comap φ y.asIdeal := h1 ▸ ht
      exact h3
    exact y.isPrime.ne_top
      (Ideal.eq_top_of_isUnit_mem _ hmem (IsLocalization.Away.algebraMap_isUnit t))
  have hsub : Set.range (ι ≫ e.inv) ⊆ Set.range j := by
    rintro _ ⟨y, rfl⟩
    rw [hrange]
    intro h
    apply hne y
    have h' := congrArg e.hom (Set.mem_singleton_iff.mp h)
    rw [Scheme.Hom.comp_apply, Scheme.inv_hom_apply] at h'
    exact h'.trans (Scheme.inv_hom_apply e _)
  let s := IsOpenImmersion.lift j (ι ≫ e.inv) hsub
  have hs : s ≫ j = ι ≫ e.inv := IsOpenImmersion.lift_fac _ _ _
  have hs' : s ≫ j ≫ e.hom = ι := by
    rw [← Category.assoc, hs, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  refine ⟨(Scheme.ΓSpecIso (.of (Localization.Away t))).hom.hom.comp s.appTop.hom, fun a => ?_⟩
  rw [RingHom.comp_apply]
  have h1 : s.appTop.hom ((j ≫ e.hom).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) =
      ι.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a) := by
    rw [← hs', Scheme.Hom.comp_appTop]
    rfl
  rw [h1]
  have hnat := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom φ)
  have h2 := congrArg (fun h => h.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) hnat
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
  rw [h2]
  simp [φ]

theorem wc_lpsym_order_d1 (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (d : ℕ) (hd : 1 ≤ d)
    (hsm : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) (hn : 1 ≤ n)
    (T VT : X.left.ProEt) (g : T ⟶ wcGeomPoint F X h) (j : VT ⟶ T)
    (A : Type u) [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : T.left ≅ Spec (.of A))
    (xb : (wcGeomPoint F X h).left) (hxbc : IsClosed ({xb} : Set (wcGeomPoint F X h).left))
    (hpre : g.left ⁻¹' {xb} = {e.inv (IsLocalRing.closedPoint A)})
    (hfib : IsIso (Limits.pullback.snd g.left ((wcGeomPoint F X h).left.fromSpecResidueField xb)))
    (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {e.inv (IsLocalRing.closedPoint A)}ᶜ)
    (f : Fin d → A) (hspan : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (hdim : ringKrullDim A = (d : WithBot ℕ∞))
    (hℓA : IsUnit ((ℓ : ℕ) : A))
    (hT : ⊤ ≤ wcKOpen VT.left (wcParamFn j e f) (d - 1 + 1) (d - 1 + 1))
    (hMV : ∀ {O₁₂ O₁ O₂ O : VT.left.Opens} (h₁ : O₁₂ ≤ O₁) (h₂ : O₁₂ ≤ O₂) (h₃ : O₁ ≤ O)
      (h₄ : O₂ ≤ O), O₁ ⊔ O₂ = O → O₁ ⊓ O₂ = O₁₂ →
        (wcMVComplex X.left VT h₁ h₂ h₃ h₄).ShortExact)
    (hd1 : d = 1)
    (tD : Fin d → (Γ((wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)).left, ⊤))ˣ)
    (htD : ∀ i, ((tD i : Γ((wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)).left, ⊤))) =
      (wcKOpen VT.left (wcParamFn j e f) 1 1).ι.appTop.hom (wcParamFn j e f i))
    (hℓD : IsUnit ((ℓ : ℕ) : Γ((wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)).left, ⊤))) :
    ∃ τ : Abelian.Ext (wcUnitTuple X.left ℓ d) (wcRootTwist X.left (ℓ ^ n) d) d,
      ℓ ^ (n - 1) • wcKFinal X.left VT (wcParamFn j e f) (wcRootTwist X.left (ℓ ^ n) d) hT
        ((Abelian.Ext.mk₀ (wcUnitTupleMap X.left
          (wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)) ℓ d tD hℓD)).comp τ
          (zero_add d)) ≠ 0 :=
by
  classical
  subst hd1
  have hp : Nat.Prime ℓ := Fact.out
  have hm : 0 < ℓ ^ n := pow_pos hp.pos n

  have hunit := wc_d1_ell_unit_all F X T A e ℓ hℓA
  have hmU : ∀ W : X.left.ProEt, IsUnit ((ℓ ^ n : ℕ) : Γ(W.left, ⊤)) := fun W => by
    rw [Nat.cast_pow]; exact (hunit W).pow n
  have hG : Presheaf.IsSheaf (Scheme.ProEt.topology X.left)
      ((Scheme.ProEt.forget X.left ⋙ Over.forget X.left).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) :=
    wc_d1_units_isSheaf_of_ring X.left ((Scheme.ProEt.forget X.left ⋙ Over.forget X.left).op ⋙ Scheme.Γ)
      (wc_d1_gamma_forget_isSheaf X.left)
  have hμ := wc_d1_roots_isSheaf X.left (ℓ ^ n) hG
  obtain ⟨ι, wι, hSES⟩ := wc_d1_kummer_ses X.left (ℓ ^ n) hG hμ
    (fun U y => wc_d1_local_root_cover X.left (ℓ ^ n) hm (wc_d1_kummer_algebra (ℓ ^ n) hm) U (hmU U) y)
  obtain ⟨ν⟩ := wc_d1_roots_twist_iso X.left (ℓ ^ n) hm hμ (wc_d1_zmod_tensor_one_bij (ℓ ^ n) hm)

  obtain ⟨β, hβ⟩ := wc_d1_tuple_to_units_nat X.left
    ((Scheme.ProEt.forget X.left ⋙ Over.forget X.left).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ 1)
    (fun W (x : {t : Fin 1 → (Γ(W.left, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(W.left, ⊤))}) => x.1 0)
    (fun _ _ _ _ => rfl)
  let q : wcUnitTuple X.left ℓ 1 ⟶ (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) :=
    ((sheafificationAdjunction (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).homEquiv
      (((Scheme.ProEt.forget X.left ⋙ Over.forget X.left).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ 1) ⋙
        uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟨_, hG⟩).symm β
  let δ := hSES.extClass
  let Fsec := wcFreeSheafMap X.left (wcVResSec X.left VT _ hT)
  let π := wcUnitTupleMap X.left (wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)) ℓ 1 tD hℓD
  let gg : wcFreeSheaf X.left VT ⟶ (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) :=
    (Fsec ≫ π) ≫ q

  let τ : Abelian.Ext (wcUnitTuple X.left ℓ 1) (wcRootTwist X.left (ℓ ^ n) 1) 1 :=
    (Abelian.Ext.mk₀ q).comp (δ.comp (Abelian.Ext.mk₀ ν.hom) (add_zero 1)) (zero_add 1)
  refine ⟨τ, ?_⟩
  intro hk

  have key : wcKFinal X.left VT (wcParamFn j e f) (wcRootTwist X.left (ℓ ^ n) 1) hT
      ((Abelian.Ext.mk₀ π).comp τ (zero_add 1)) =
      ((Abelian.Ext.mk₀ gg).comp δ (zero_add 1)).comp (Abelian.Ext.mk₀ ν.hom) (add_zero 1) := by
    show (Abelian.Ext.mk₀ Fsec).comp ((Abelian.Ext.mk₀ π).comp ((Abelian.Ext.mk₀ q).comp
      (δ.comp (Abelian.Ext.mk₀ ν.hom) (add_zero 1)) (zero_add 1)) (zero_add 1)) (zero_add 1) = _
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc Fsec π, Abelian.Ext.mk₀_comp_mk₀_assoc (Fsec ≫ π) q,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ gg) δ (Abelian.Ext.mk₀ ν.hom) (zero_add 1) (add_zero 1)
        (show 0 + 1 + 0 = 1 from rfl)]
    all_goals rfl
  have hk' : ℓ ^ (n - 1) • ((Abelian.Ext.mk₀ gg).comp δ (zero_add 1)).comp (Abelian.Ext.mk₀ ν.hom)
      (add_zero 1) = 0 := by
    rw [← key]; exact hk

  have hnc : ∀ {P Q R : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} {a b c : ℕ}
      (y : Abelian.Ext P Q a) (z : Abelian.Ext Q R b) (hh : a + b = c) (k : ℕ),
      (k • y).comp z hh = k • y.comp z hh := by
    intro P Q R a b c y z hh k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.zero_comp]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih]
  have hk2 : ℓ ^ (n - 1) • (Abelian.Ext.mk₀ gg).comp δ (zero_add 1) = 0 := by
    have e2 := congrArg (fun y : Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ n) 1) 1 =>
      y.comp (Abelian.Ext.mk₀ ν.inv) (add_zero 1)) hk'
    try dsimp only at e2
    rw [hnc, Abelian.Ext.zero_comp,
      Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (show 1 + 0 + 0 = 1 from rfl),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] at e2
    exact e2
  obtain ⟨hh, hhe⟩ := wc_d1_ext_kummer_lift ι (ℓ ^ n) wι hSES gg (ℓ ^ (n - 1)) hk2

  have hnsapp : ∀ {P Q : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} (φ : P ⟶ Q) (k : ℕ)
      (W : (X.left.ProEt)ᵒᵖ) (x : P.obj.obj W), (k • φ).hom.app W x = k • φ.hom.app W x := by
    intro P Q φ k W x
    have e3 : (k • φ).hom = k • φ.hom :=
      (sheafToPresheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_nsmul
    rw [e3, NatTrans.app_nsmul]
    rfl
  have hcompapp : ∀ {P Q R : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} (a : P ⟶ Q)
      (b : Q ⟶ R) (W : (X.left.ProEt)ᵒᵖ) (x : P.obj.obj W),
      (a ≫ b).hom.app W x = b.hom.app W (a.hom.app W x) :=
    fun _ _ _ _ => rfl
  have hidapp : ∀ {P : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}}
      (W : (X.left.ProEt)ᵒᵖ) (x : P.obj.obj W), (𝟙 P : P ⟶ P).hom.app W x = x := fun _ _ => rfl
  let gen := (toSheafify (Scheme.ProEt.topology X.left)
      (yoneda.obj VT ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app (Opposite.op VT)
      (FreeAbelianGroup.of (ULift.up (𝟙 VT)))

  have hev := wc_d1_free_yoneda_eval X.left
    ((Scheme.ProEt.forget X.left ⋙ Over.forget X.left).op ⋙ Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙
        CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) hG
    ((Scheme.ProEt.forget X.left ⋙ Over.forget X.left).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ 1) β
    VT (wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)) (wcVResSec X.left VT _ hT)
    (Subtype.mk tD hℓD : {t : Fin 1 → (Γ((wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)).left, ⊤))ˣ //
      IsUnit ((ℓ : ℕ) : Γ((wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)).left, ⊤))})
  have hg : gg.hom.app (Opposite.op VT) gen = ULift.up (Additive.ofMul
      (Units.map (wcVResSec X.left VT _ hT).left.appTop.hom.toMonoidHom (tD 0))) := by
    have hb := hβ (wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)) ⟨tD, hℓD⟩
    refine hev.trans ((congrArg (fun z => ((Scheme.ProEt.forget X.left ⋙ Over.forget X.left).op ⋙
      Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙
      AddCommGrpCat.uliftFunctor.{u+1, u}).map (wcVResSec X.left VT _ hT).op z) hb).trans ?_)
    rfl
  have ev0 := congrArg (fun φ : wcFreeSheaf X.left VT ⟶
      (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}) =>
    φ.hom.app (Opposite.op VT) gen) hhe
  have e1 := hcompapp hh (ℓ ^ n • 𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}))
    (Opposite.op VT) gen
  have e2 := hnsapp (𝟙 (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1})) (ℓ ^ n)
    (Opposite.op VT) (hh.hom.app (Opposite.op VT) gen)
  have e3 := hnsapp gg (ℓ ^ (n - 1)) (Opposite.op VT) gen
  have e5 := hidapp (P := (⟨_, hG⟩ : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}))
    (Opposite.op VT) (hh.hom.app (Opposite.op VT) gen)
  have ev : (ℓ ^ n) • hh.hom.app (Opposite.op VT) gen =
      (ℓ ^ (n - 1)) • gg.hom.app (Opposite.op VT) gen :=
    (congrArg (fun z => (ℓ ^ n) • z) e5).symm.trans (e2.symm.trans (e1.symm.trans (ev0.trans e3)))
  have hval : (wcVResSec X.left VT _ hT).left.appTop.hom
      ((tD 0 : Γ((wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)).left, ⊤))) =
      wcParamFn j e f 0 := by
    rw [htD 0]
    have hts : ∀ (Y : Scheme.{u}) (O : Y.Opens) (hO : ⊤ ≤ O), wcTopSec Y O hO ≫ O.ι = 𝟙 Y :=
      fun Y O hO => IsOpenImmersion.lift_fac _ _ _
    have h1 := congrArg (fun φ : VT.left ⟶ VT.left => φ.appTop.hom (wcParamFn j e f 0)) (hts VT.left _ hT)
    first
      | exact h1
      | (simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply,
          Scheme.Hom.id_appTop, CommRingCat.hom_id, RingHom.id_apply] at h1
         exact h1)

  have hring : ((Additive.toMul (ULift.down (hh.hom.app (Opposite.op VT) gen)) : (Γ(VT.left, ⊤))ˣ) :
      Γ(VT.left, ⊤)) ^ (ℓ ^ n) = (wcParamFn j e f 0) ^ (ℓ ^ (n - 1)) := by
    have ev' := ev.trans (congrArg (fun z => (ℓ ^ (n - 1)) • z) hg)
    have ev'' := congrArg (fun z : ULift.{u+1} (Additive (Γ(VT.left, ⊤))ˣ) =>
      ((Additive.toMul z.down : (Γ(VT.left, ⊤))ˣ) : Γ(VT.left, ⊤))) ev'
    rw [← hval]
    exact ev''

  have hspan1 : Ideal.span {f 0} = IsLocalRing.maximalIdeal A := by
    rw [← hspan, Set.range_unique]
    all_goals rfl
  obtain ⟨hdom, ht0, hP⟩ := wc_d1_dvr_pow_dvd A (f 0) hspan1 hdim
  haveI := hdom
  obtain ⟨ρ, hρ⟩ := wc_d1_punct_to_away A (f 0) hspan1 VT.left T.left j.left hj e hrange
  have hρ0 : ρ (wcParamFn j e f 0) = algebraMap A (Localization.Away (f 0)) (f 0) := hρ (f 0)
  have hρeq := congrArg ρ hring
  rw [map_pow, map_pow, hρ0] at hρeq
  have hdvd := wc_d1_away_pow_dvd A (f 0) ht0 hP _ (ℓ ^ (n - 1)) (ℓ ^ n) hm hρeq
  have hle := (Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp hdvd
  omega

theorem wc_lpkt_chart_extract : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (d : ℕ) (hsm : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (T : X.left.ProEt) (g : T ⟶ wcGeomPoint F X h) (A : Type u) [CommRing A] [IsLocalRing A]
    (e : T.left ≅ Spec (.of A)) (xb : (wcGeomPoint F X h).left)
    (hxbc : IsClosed ({xb} : Set (wcGeomPoint F X h).left))
    (hpre : g.left ⁻¹' {xb} = {e.inv (IsLocalRing.closedPoint A)}),
    ∃ (O : Type u) (_ : CommRing O) (κO : AlgebraicClosure F →+* O) (ψ : O →+* A),
      RingHom.IsStandardSmoothOfRelativeDimension d κO ∧
      WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) ∧
      (Ideal.comap ψ (IsLocalRing.maximalIdeal A)).IsMaximal :=
by
  classical
  intro F _ X h d hsm T g A _ _ e xb hxbc hpre

  let s : (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F)) :=
    Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  haveI : SmoothOfRelativeDimension d s := hsm

  obtain ⟨U, hU, V, hV, hxV, eUV, hP⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := d) (f := s) xb
  have hUtop : U = ⊤ := by
    apply eq_top_iff.mpr
    intro z _
    have h1 : s xb ∈ U := (Scheme.Hom.mem_preimage s).mp (eUV hxV)
    have h2 : z = s xb := Subsingleton.elim _ _
    rw [h2]
    exact h1
  subst hUtop
  let ε : AlgebraicClosure F ≃+* Γ(Spec (.of (AlgebraicClosure F)), ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of (AlgebraicClosure F))).symm.commRingCatIsoToRingEquiv
  have hκ : RingHom.IsStandardSmoothOfRelativeDimension d
      ((Scheme.Hom.appLE s ⊤ V eUV).hom.comp ε.toRingHom) :=
    RingHom.isStandardSmoothOfRelativeDimension_respectsIso.2 _ ε hP

  haveI hWg : WeaklyEtale g.left := by
    haveI : WeaklyEtale (wcGeomPoint F X h).hom := (wcGeomPoint F X h).prop
    haveI : WeaklyEtale (g.left ≫ (wcGeomPoint F X h).hom) := by
      rw [MorphismProperty.Over.w g]
      exact T.prop
    exact WeaklyEtale.of_comp g.left (wcGeomPoint F X h).hom
  let u : Spec (.of A) ⟶ (wcGeomPoint F X h).left := e.inv ≫ g.left
  haveI hWu : WeaklyEtale u := inferInstance

  have huc : u (IsLocalRing.closedPoint A) = xb := by
    have hmem : e.inv (IsLocalRing.closedPoint A) ∈ g.left ⁻¹' {xb} := by
      rw [hpre]
      rfl
    exact (Scheme.Hom.comp_apply e.inv g.left (IsLocalRing.closedPoint A)).trans hmem

  have hrange : Set.range u ⊆ Set.range hV.fromSpec := by
    rintro _ ⟨x, rfl⟩
    rw [hV.range_fromSpec]
    have h1 : u x ⤳ u (IsLocalRing.closedPoint A) :=
      (IsLocalRing.specializes_closedPoint (R := A) x).map (Scheme.Hom.continuous u)
    rw [huc] at h1
    exact h1.mem_open V.isOpen hxV

  let l := IsOpenImmersion.lift hV.fromSpec u hrange
  have hl : l ≫ hV.fromSpec = u := IsOpenImmersion.lift_fac _ _ _
  haveI : WeaklyEtale (l ≫ hV.fromSpec) := by
    rw [hl]
    exact hWu
  haveI hWl : WeaklyEtale l := WeaklyEtale.of_comp l hV.fromSpec
  let ψ : Γ((wcGeomPoint F X h).left, V) →+* A := (Spec.preimage l).hom
  have hψ : Spec.map (CommRingCat.ofHom ψ) = l := Spec.map_preimage l
  refine ⟨Γ((wcGeomPoint F X h).left, V), inferInstance,
    (Scheme.Hom.appLE s ⊤ V eUV).hom.comp ε.toRingHom, ψ, hκ, ?_, ?_⟩
  · rw [hψ]
    exact hWl
  ·
    have hfp1 : (Spec.map (CommRingCat.ofHom ψ) ≫ hV.fromSpec) (IsLocalRing.closedPoint A) = xb := by
      rw [hψ, hl, huc]
    have hfp0 : hV.fromSpec (Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint A)) = xb :=
      (Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom ψ)) hV.fromSpec
        (IsLocalRing.closedPoint A)).symm.trans hfp1
    have hpre' : hV.fromSpec ⁻¹' {xb} =
        {Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint A)} := by
      ext q
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      constructor
      · intro hq
        exact Scheme.Hom.injective hV.fromSpec (hq.trans hfp0.symm)
      · rintro rfl
        exact hfp0
    have hcl : IsClosed
        ({Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint A)} :
          Set (Spec Γ((wcGeomPoint F X h).left, V))) := by
      rw [← hpre']
      exact hxbc.preimage (Scheme.Hom.continuous hV.fromSpec)
    have hmax := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hcl
    have hcomap : Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint A) =
        PrimeSpectrum.comap ψ (IsLocalRing.closedPoint A) := Spec.map_apply _ _
    rw [hcomap, PrimeSpectrum.comap_asIdeal] at hmax
    exact hmax

theorem wc_lpkt_specMap_weaklyEtale_ring : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
    WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) → @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra :=
by
  intro R S _ _ ψ hW
  letI : Algebra R S := ψ.toAlgebra
  have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
  have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
    ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
  have h2 := hW'.flat_diagonal
  rw [diagonal_SpecMap] at h2
  have h3 : Flat (Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
    have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
        (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
          (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
      rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
    rw [e]
    exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
  exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)

theorem wc_lpkt_residue_rational : ∀ (K O A : Type u) [Field K] [IsAlgClosed K] [CommRing O] [CommRing A]
    [IsLocalRing A] (d : ℕ) (κO : K →+* O), RingHom.IsStandardSmoothOfRelativeDimension d κO →
    ∀ (ψ : O →+* A), @Algebra.WeaklyEtale O A _ _ ψ.toAlgebra →
    (Ideal.comap ψ (IsLocalRing.maximalIdeal A)).IsMaximal →
    ∀ a : A, ∃ c : K, a - ψ (κO c) ∈ IsLocalRing.maximalIdeal A :=
by
  intro K O A _ _ _ _ _ d κO hκ ψ hW hmax a
  classical
  letI : Algebra K O := κO.toAlgebra
  haveI : Algebra.IsStandardSmoothOfRelativeDimension d K O := hκ
  haveI : Algebra.IsStandardSmooth K O :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth d
  haveI : Algebra.FiniteType K O := inferInstance
  haveI : (Ideal.comap ψ (IsLocalRing.maximalIdeal A)).IsMaximal := hmax
  set ρ : O →+* IsLocalRing.ResidueField A := (IsLocalRing.residue A).comp ψ with hρ
  set ι : K →+* IsLocalRing.ResidueField A := ρ.comp κO with hι
  have hR1 : ∀ o : O, ∃ c : K, ρ o = ι c := by
    intro o
    obtain ⟨c, hc⟩ := wcpa_ssd_residue_rational K O (Ideal.comap ψ (IsLocalRing.maximalIdeal A))
      (algebraMap O (Localization.AtPrime (Ideal.comap ψ (IsLocalRing.maximalIdeal A))) o)
    refine ⟨c, ?_⟩
    rw [IsScalarTower.algebraMap_apply K O
      (Localization.AtPrime (Ideal.comap ψ (IsLocalRing.maximalIdeal A))), ← map_sub] at hc
    have h1 : o - algebraMap K O c ∈ Ideal.comap ψ (IsLocalRing.maximalIdeal A) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff
        (Localization.AtPrime (Ideal.comap ψ (IsLocalRing.maximalIdeal A)))
        (Ideal.comap ψ (IsLocalRing.maximalIdeal A)) _).mp hc
    have h2 : ψ (o - κO c) ∈ IsLocalRing.maximalIdeal A := h1
    have h3 := (IsLocalRing.residue_eq_zero_iff _).mpr h2
    rw [map_sub, map_sub, sub_eq_zero] at h3
    simpa [hρ, hι] using h3
  letI : Algebra O A := ψ.toAlgebra
  obtain ⟨F, hF0, hFr⟩ := wc_weaklyEtale_point_algebraic O A (IsLocalRing.ResidueField A) hW
    (IsLocalRing.residue A) a
  have hcomp : (IsLocalRing.residue A).comp (algebraMap O A) = ρ := rfl
  rw [hcomp] at hF0 hFr
  have hlift : F.map ρ ∈ Polynomial.lifts ι := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    rw [Polynomial.coeff_map]
    obtain ⟨c, hc⟩ := hR1 (F.coeff n)
    exact ⟨c, hc.symm⟩
  obtain ⟨G, hG⟩ := (Polynomial.mem_lifts _).mp hlift
  have hG0 : G ≠ 0 := by
    rintro rfl
    apply hF0
    rw [← hG, Polynomial.map_zero]
  have hroot : (G.map ι).IsRoot (IsLocalRing.residue A a) := by
    rw [hG, Polynomial.IsRoot.def, Polynomial.eval_map]
    exact hFr
  obtain ⟨c, hc⟩ := Polynomial.Splits.mem_range_of_isRoot (IsAlgClosed.splits G) hG0 hroot
  refine ⟨c, ?_⟩
  rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← hc]
  simp [hι, hρ]

theorem wc_lpkt_cotangent_indep : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] (d : ℕ)
    (f : Fin d → A) (hspan : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (hdim : ringKrullDim A = (d : WithBot ℕ∞)) (hf : ∀ i, f i ∈ IsLocalRing.maximalIdeal A),
    LinearIndependent (IsLocalRing.ResidueField A)
      (fun i => (IsLocalRing.maximalIdeal A).toCotangent ⟨f i, hf i⟩) :=
by
  classical
  intro A _ _ _ d f hspan hdim hf
  have s1 : ∀ s : Set (IsLocalRing.maximalIdeal A), Submodule.span A s = ⊤ ↔
      Ideal.span (Subtype.val '' s) = IsLocalRing.maximalIdeal A := by
    intro s
    have h1 : Submodule.map (IsLocalRing.maximalIdeal A).subtype (Submodule.span A s) =
        Ideal.span (Subtype.val '' s) := by
      rw [Submodule.map_span]; rfl
    constructor
    · intro h
      rw [← h1, h, Submodule.map_subtype_top]
    · intro h
      apply Submodule.map_injective_of_injective (IsLocalRing.maximalIdeal A).injective_subtype
      rw [h1, h, Submodule.map_subtype_top]
  let g : Fin d → IsLocalRing.maximalIdeal A := fun j => ⟨f j, hf j⟩
  have hg : Submodule.span A (Set.range g) = ⊤ := by
    rw [s1]
    have : Subtype.val '' Set.range g = Set.range f := by
      rw [← Set.range_comp]; rfl
    rw [this, hspan]
  have s2 : Submodule.span (IsLocalRing.ResidueField A)
      (Set.range (fun i => (IsLocalRing.maximalIdeal A).toCotangent ⟨f i, hf i⟩)) = ⊤ := by
    have : Set.range (fun i => (IsLocalRing.maximalIdeal A).toCotangent ⟨f i, hf i⟩) =
        (IsLocalRing.maximalIdeal A).toCotangent '' Set.range g := by
      rw [← Set.range_comp]; rfl
    rw [this, IsLocalRing.CotangentSpace.span_image_eq_top_iff]
    exact hg
  rw [linearIndependent_iff_notMem_span]
  intro i hi
  have hU : Submodule.span (IsLocalRing.ResidueField A)
      ((fun i => (IsLocalRing.maximalIdeal A).toCotangent ⟨f i, hf i⟩) '' (Set.univ \ {i})) = ⊤ := by
    rw [eq_top_iff, ← s2, Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    by_cases hj : j = i
    · subst hj; exact hi
    · exact Submodule.subset_span ⟨j, ⟨trivial, hj⟩, rfl⟩
  have hU' : (fun i => (IsLocalRing.maximalIdeal A).toCotangent ⟨f i, hf i⟩) '' (Set.univ \ {i}) =
      (IsLocalRing.maximalIdeal A).toCotangent '' (g '' (Set.univ \ {i})) := by
    rw [Set.image_image]
  rw [hU', IsLocalRing.CotangentSpace.span_image_eq_top_iff, s1, Set.image_image] at hU
  set S : Finset A := (Finset.univ.erase i).image f with hSdef
  have hS : Ideal.span (S : Set A) = IsLocalRing.maximalIdeal A := by
    rw [← hU]
    congr 1
    ext x
    simp [S, g]
  have hcard : S.card ≤ d - 1 := by
    calc S.card ≤ (Finset.univ.erase i).card := Finset.card_image_le
      _ = d - 1 := by
        rw [Finset.card_erase_of_mem (Finset.mem_univ i), Finset.card_univ, Fintype.card_fin]
  have hmem : IsLocalRing.maximalIdeal A ∈ (Ideal.span (S : Set A)).minimalPrimes := by
    rw [hS, Ideal.minimalPrimes_eq_subsingleton_self]
    rfl
  have h7 := Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmem
  have h8 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := A)
  rw [hdim] at h8
  have h9 : (IsLocalRing.maximalIdeal A).height = (d : ℕ∞) := by
    have : ((d : ℕ∞) : WithBot ℕ∞) = (d : WithBot ℕ∞) := WithBot.coe_natCast d
    exact WithBot.coe_inj.mp (h8.trans this.symm)
  rw [h9] at h7
  have h10 : d ≤ S.card := by exact_mod_cast h7
  have := i.isLt
  omega

theorem wc_lpkt_coord_derivations : ∀ (K A : Type u) [Field K] [CommRing A] [IsLocalRing A] (κ : K →+* A)
    (hres : ∀ a : A, ∃ c : K, a - κ c ∈ IsLocalRing.maximalIdeal A) (d : ℕ) (f : Fin d → A)
    (hf : ∀ i, f i ∈ IsLocalRing.maximalIdeal A)
    (hspan : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (hind : LinearIndependent (IsLocalRing.ResidueField A)
      (fun i => (IsLocalRing.maximalIdeal A).toCotangent ⟨f i, hf i⟩)) (k : Fin d),
    ∃ D : A → IsLocalRing.ResidueField A, (∀ a b, D (a + b) = D a + D b) ∧
      (∀ a b, D (a * b) = IsLocalRing.residue A a * D b + IsLocalRing.residue A b * D a) ∧
      (∀ c, D (κ c) = 0) ∧ ∀ j, D (f j) = if j = k then 1 else 0 :=
by
  classical
  intro K A _ _ _ κ hres d f hf hspan hind k

  have hsmul : ∀ (r : A) (w : (IsLocalRing.maximalIdeal A).Cotangent),
      r • w = (IsLocalRing.residue A r) • w := by
    intro r w
    rw [← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul]

  have hsp : ⊤ ≤ Submodule.span (IsLocalRing.ResidueField A)
      (Set.range (fun i => (IsLocalRing.maximalIdeal A).toCotangent ⟨f i, hf i⟩)) := by
    rintro w -
    obtain ⟨x, rfl⟩ := (IsLocalRing.maximalIdeal A).toCotangent_surjective w
    have hx : (x : A) ∈ Ideal.span (Set.range f) := by rw [hspan]; exact x.2
    obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hx
    have hxe : x = ∑ i, c i • (⟨f i, hf i⟩ : IsLocalRing.maximalIdeal A) := by
      apply Subtype.ext
      simp only [Submodule.coe_sum, Submodule.coe_smul, smul_eq_mul]
      exact hc.symm
    rw [hxe, map_sum]
    refine Submodule.sum_mem _ (fun i _ => ?_)
    rw [map_smul, hsmul]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  let b := Module.Basis.mk hind hsp

  have huniq : ∀ c c' : K, κ c - κ c' ∈ IsLocalRing.maximalIdeal A → c = c' := by
    intro c c' h
    by_contra hne
    have hu : IsUnit (κ (c - c')) := (isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr hne)).map κ
    rw [map_sub] at hu
    exact (IsLocalRing.mem_maximalIdeal _).mp h hu
  choose cf hcf using hres
  have hres' : ∀ a, IsLocalRing.residue A (κ (cf a)) = IsLocalRing.residue A a := by
    intro a
    have h := (IsLocalRing.residue_eq_zero_iff (a - κ (cf a))).mpr (hcf a)
    rw [map_sub, sub_eq_zero] at h
    exact h.symm
  obtain ⟨G, hG⟩ : ∃ G : A → (IsLocalRing.maximalIdeal A).Cotangent,
      ∀ a, G a = (IsLocalRing.maximalIdeal A).toCotangent ⟨a - κ (cf a), hcf a⟩ := ⟨_, fun _ => rfl⟩
  have L0 : ∀ (a : A) (c' : K) (h : a - κ c' ∈ IsLocalRing.maximalIdeal A),
      (IsLocalRing.maximalIdeal A).toCotangent ⟨a - κ c', h⟩ = G a := by
    intro a c' h
    have e : cf a = c' := huniq _ _ (by
      have h2 := (IsLocalRing.maximalIdeal A).sub_mem h (hcf a)
      convert h2 using 1
      ring)
    subst e
    rw [hG]
  have hadd : ∀ a a', G (a + a') = G a + G a' := by
    intro a a'
    have h : (a + a') - κ (cf a + cf a') ∈ IsLocalRing.maximalIdeal A := by
      have h2 := (IsLocalRing.maximalIdeal A).add_mem (hcf a) (hcf a')
      convert h2 using 1
      rw [map_add]; ring
    rw [← L0 _ _ h, hG, hG, ← map_add]
    congr 1
    apply Subtype.ext
    show (a + a') - κ (cf a + cf a') = (a - κ (cf a)) + (a' - κ (cf a'))
    rw [map_add]; ring
  have hmul : ∀ a a', G (a * a') = κ (cf a) • G a' + κ (cf a') • G a := by
    intro a a'
    have hrr : (a - κ (cf a)) * (a' - κ (cf a')) ∈ IsLocalRing.maximalIdeal A ^ 2 := by
      rw [pow_two]; exact Ideal.mul_mem_mul (hcf a) (hcf a')
    have hrr' : (a - κ (cf a)) * (a' - κ (cf a')) ∈ IsLocalRing.maximalIdeal A :=
      (IsLocalRing.maximalIdeal A).mul_mem_left _ (hcf a')
    have e1 : a * a' - κ (cf a * cf a') = κ (cf a) * (a' - κ (cf a')) +
        κ (cf a') * (a - κ (cf a)) + (a - κ (cf a)) * (a' - κ (cf a')) := by
      rw [map_mul]; ring
    have h : a * a' - κ (cf a * cf a') ∈ IsLocalRing.maximalIdeal A := by
      rw [e1]
      exact (IsLocalRing.maximalIdeal A).add_mem
        ((IsLocalRing.maximalIdeal A).add_mem
          ((IsLocalRing.maximalIdeal A).mul_mem_left _ (hcf a'))
          ((IsLocalRing.maximalIdeal A).mul_mem_left _ (hcf a))) hrr'
    have e : (⟨a * a' - κ (cf a * cf a'), h⟩ : IsLocalRing.maximalIdeal A) =
        κ (cf a) • (⟨a' - κ (cf a'), hcf a'⟩ : IsLocalRing.maximalIdeal A) +
        κ (cf a') • (⟨a - κ (cf a), hcf a⟩ : IsLocalRing.maximalIdeal A) +
        (⟨(a - κ (cf a)) * (a' - κ (cf a')), hrr'⟩ : IsLocalRing.maximalIdeal A) := by
      apply Subtype.ext
      exact e1
    have hz : (IsLocalRing.maximalIdeal A).toCotangent
        (⟨(a - κ (cf a)) * (a' - κ (cf a')), hrr'⟩ : IsLocalRing.maximalIdeal A) = 0 :=
      ((IsLocalRing.maximalIdeal A).toCotangent_eq_zero _).mpr hrr
    rw [← L0 _ _ h, e, map_add, map_add, map_smul, map_smul, hz, add_zero, hG, hG]
  refine ⟨fun a => b.coord k (G a), ?_, ?_, ?_, ?_⟩
  · intro a a'
    dsimp only
    rw [hadd, map_add]
  · intro a a'
    dsimp only
    rw [hmul, map_add, hsmul, hsmul (κ (cf a')), map_smul, map_smul, hres', hres',
      smul_eq_mul, smul_eq_mul]
  · intro c
    dsimp only
    have h : κ c - κ c ∈ IsLocalRing.maximalIdeal A := by
      rw [sub_self]; exact Submodule.zero_mem _
    have hz : (IsLocalRing.maximalIdeal A).toCotangent
        (⟨κ c - κ c, h⟩ : IsLocalRing.maximalIdeal A) = 0 := by
      rw [Ideal.toCotangent_eq_zero]
      show κ c - κ c ∈ IsLocalRing.maximalIdeal A ^ 2
      rw [sub_self]; exact Submodule.zero_mem _
    rw [← L0 (κ c) c h, hz, map_zero]
  · intro j
    dsimp only
    have h : f j - κ 0 ∈ IsLocalRing.maximalIdeal A := by
      rw [map_zero, sub_zero]; exact hf j
    have e : (IsLocalRing.maximalIdeal A).toCotangent
        (⟨f j - κ 0, h⟩ : IsLocalRing.maximalIdeal A) = b j := by
      rw [Module.Basis.mk_apply]
      congr 1
      apply Subtype.ext
      show f j - κ 0 = f j
      rw [map_zero, sub_zero]
    rw [← L0 (f j) 0 h, e, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]

theorem wc_lpkt_indetale_factor : ∀ (O A : Type u) [CommRing O] [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (ψ : O →+* A), @Algebra.WeaklyEtale O A _ _ ψ.toAlgebra →
    ∀ (n : ℕ) (a : Fin n → A), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra O E), Algebra.Etale O E ∧
      ∃ (β : E →+* A) (e : Fin n → E), β.comp (algebraMap O E) = ψ ∧ ∀ i, β (e i) = a i :=
by
  intro O A _ _ _ _ ψ hW n a
  letI : Algebra O A := ψ.toAlgebra
  obtain ⟨R, _, σ, ρ, hRloc, hρσ, hHR, hSR, hloc, hind⟩ := wc_strict_hull O A inferInstance
  haveI := hRloc
  letI : Algebra O R := σ.toAlgebra
  letI : Algebra R A := ρ.toAlgebra
  haveI : IsScalarTower O R A := IsScalarTower.of_algebraMap_eq' hρσ.symm
  have hWOR : Algebra.WeaklyEtale O R := wc_indEtale_weaklyEtale σ hind
  have hWRA : Algebra.WeaklyEtale R A := wc_weaklyEtale_cancel O R A hWOR hW
  have hbij : Function.Bijective (algebraMap R A) := wc_olivier R A hHR hSR hloc hWRA
  let ρ' : R ≃+* A := RingEquiv.ofBijective ρ hbij
  obtain ⟨E, iE, aE, hE, α, β₀, hαβ⟩ :=
    hind (MvPolynomial (Fin n) O) (MvPolynomial.aeval (fun i => ρ'.symm (a i)))
  refine ⟨E, iE, aE, hE, ρ.comp (β₀ : E →+* R), fun i => α (MvPolynomial.X i), ?_, ?_⟩
  · rw [RingHom.comp_assoc, AlgHom.comp_algebraMap]
    exact hρσ
  · intro i
    have h1 : β₀ (α (MvPolynomial.X i)) = ρ'.symm (a i) := by
      rw [← AlgHom.comp_apply, hαβ, MvPolynomial.aeval_X]
    show ρ (β₀ (α (MvPolynomial.X i))) = a i
    rw [h1]
    exact ρ'.apply_symm_apply (a i)

theorem wc_lpkt_ring_assembly : ∀ (K O A E : Type u) [Field K] [CommRing O] [CommRing A] [IsLocalRing A]
    [CommRing E] [Algebra O E] (d : ℕ) (hd : 1 ≤ d) (κO : K →+* O)
    (hκ : RingHom.IsStandardSmoothOfRelativeDimension d κO) (ψ : O →+* A)
    (hW : @Algebra.WeaklyEtale O A _ _ ψ.toAlgebra) (hE : Algebra.Etale O E) (β : E →+* A)
    (hβ : β.comp (algebraMap O E) = ψ) (e : Fin d → E) (f : Fin d → A) (hβe : ∀ i, β (e i) = f i)
    (D : Fin d → A → IsLocalRing.ResidueField A) (hDadd : ∀ k a b, D k (a + b) = D k a + D k b)
    (hDmul : ∀ k a b, D k (a * b) = IsLocalRing.residue A a * D k b + IsLocalRing.residue A b * D k a)
    (hDK : ∀ k c, D k (ψ (κO c)) = 0) (hDf : ∀ k j, D k (f j) = if j = k then 1 else 0),
    ∃ φ : MvPolynomial (Fin d) K →+* A, (∀ i, φ (MvPolynomial.X i) = f i) ∧
      (∀ c, φ (MvPolynomial.C c) = ψ (κO c)) ∧ WeaklyEtale (Spec.map (CommRingCat.ofHom φ)) :=
by
  intro K O A E _ _ _ _ _ _ d hd κO hκ ψ hW hE β hβ e f hβe D hDadd hDmul hDK hDf
  classical
  letI : Algebra K E := ((algebraMap O E).comp κO).toAlgebra
  have hβK : ∀ c, β (algebraMap K E c) = ψ (κO c) := by
    intro c
    rw [← hβ]
    rfl

  have hOE : RingHom.IsStandardSmoothOfRelativeDimension 0 (algebraMap O E) :=
    (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 0).mpr
      (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hE)
  have hRK : RingHom.IsStandardSmoothOfRelativeDimension d (algebraMap K E) := by
    have h0 := hOE.comp hκ
    rw [Nat.zero_add] at h0
    exact h0
  have hstd : Algebra.IsStandardSmoothOfRelativeDimension d K E :=
    (RingHom.isStandardSmoothOfRelativeDimension_algebraMap d).mp hRK

  let χ : E →+* IsLocalRing.ResidueField A := (IsLocalRing.residue A).comp β
  let q : Ideal E := RingHom.ker χ
  haveI hqP : q.IsPrime := RingHom.ker_isPrime χ

  have hspanq : Submodule.span q.ResidueField (Set.range (fun j =>
      (1 : q.ResidueField) ⊗ₜ[E] KaehlerDifferential.D K E (e j))) = ⊤ := by
    haveI : Nontrivial E := RingHom.domain_nontrivial χ
    haveI := hstd
    haveI : Algebra.IsStandardSmooth K E :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth d
    haveI : Module.Free E Ω[E⁄K] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hrank : Module.finrank E Ω[E⁄K] = d :=
      Module.finrank_eq_of_rank_eq
        (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential d)
    have hdimV : Module.finrank q.ResidueField
        (TensorProduct E q.ResidueField Ω[E⁄K]) = d := by
      rw [Module.finrank_baseChange, hrank]
    have h₁ : q ≤ RingHom.ker χ := le_rfl
    have h₂ : q.primeCompl ≤ Submonoid.comap χ (IsUnit.submonoid _) := by
      intro s hs
      have hne : χ s ≠ 0 := fun h0 => hs (RingHom.mem_ker.mpr h0)
      exact isUnit_iff_ne_zero.mpr hne
    let lam : q.ResidueField →+* IsLocalRing.ResidueField A :=
      Ideal.ResidueField.lift q χ h₁ h₂
    have hlam : ∀ r, lam (algebraMap E q.ResidueField r) = χ r :=
      Ideal.ResidueField.lift_algebraMap q χ h₁ h₂
    have hlaminj : Function.Injective lam := lam.injective
    letI : Algebra E (IsLocalRing.ResidueField A) := χ.toAlgebra
    letI : Algebra K (IsLocalRing.ResidueField A) := (χ.comp (algebraMap K E)).toAlgebra
    letI : Algebra q.ResidueField (IsLocalRing.ResidueField A) := lam.toAlgebra
    haveI : IsScalarTower K E (IsLocalRing.ResidueField A) := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower E q.ResidueField (IsLocalRing.ResidueField A) :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun r => (hlam r).symm)
    let δ : Fin d → Derivation K E (IsLocalRing.ResidueField A) := fun k =>
      { toFun := fun a => D k (β a)
        map_add' := fun a b => by simp only [map_add, hDadd]
        map_smul' := fun c a => by
          have hsm : (c • D k (β a) : IsLocalRing.ResidueField A) =
              IsLocalRing.residue A (ψ (κO c)) * D k (β a) := by
            rw [Algebra.smul_def]
            show IsLocalRing.residue A (β (algebraMap K E c)) * _ = _
            rw [hβK]
          simp only [RingHom.id_apply]
          rw [hsm, Algebra.smul_def, map_mul, hDmul, hβK, hDK, mul_zero, add_zero]
        map_one_eq_zero' := by
          show D k (β 1) = 0
          rw [map_one]
          simpa using hDK k 1
        leibniz' := fun a b => by
          show D k (β (a * b)) = _
          rw [map_mul, hDmul]
          rfl }
    have hval : ∀ k j, (δ k) (e j) = if j = k then 1 else 0 := fun k j => by
      show D k (β (e j)) = _
      rw [hβe, hDf]
    let Lk : Fin d → TensorProduct E q.ResidueField Ω[E⁄K] →ₗ[q.ResidueField]
        IsLocalRing.ResidueField A := fun k =>
      ((δ k).liftKaehlerDifferential).liftBaseChange q.ResidueField
    have hLk : ∀ k j, Lk k ((1 : q.ResidueField) ⊗ₜ[E] KaehlerDifferential.D K E (e j)) =
        if j = k then 1 else 0 := by
      intro k j
      simp only [Lk, LinearMap.liftBaseChange_tmul, Derivation.liftKaehlerDifferential_comp_D,
        one_smul, hval]
    have hli : LinearIndependent q.ResidueField (fun j =>
        (1 : q.ResidueField) ⊗ₜ[E] KaehlerDifferential.D K E (e j)) := by
      rw [Fintype.linearIndependent_iff]
      intro g hg k
      have h := congrArg (Lk k) hg
      rw [map_sum, map_zero] at h
      simp only [map_smul, hLk, smul_ite, smul_zero, Finset.sum_ite_eq', Finset.sum_ite_eq,
        Finset.mem_univ, if_true] at h
      rw [Algebra.smul_def, mul_one] at h
      apply hlaminj
      rw [map_zero]
      exact h
    haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
    exact hli.span_eq_top_of_card_eq_finrank (by rw [Fintype.card_fin, hdimV])

  obtain ⟨s, hsq, hθ⟩ := wc_tube_jacobian_etale K E d (Fin d) e hRK (Fintype.card_fin d) q hspanq
  have hs : IsUnit (β s) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
    intro h0
    exact hsq (RingHom.mem_ker.mpr h0)
  let β' : Localization.Away s →+* A := IsLocalization.Away.lift (S := Localization.Away s) s hs
  let θ : MvPolynomial (Fin d) K →+* Localization.Away s :=
    (algebraMap E (Localization.Away s)).comp (MvPolynomial.eval₂Hom (algebraMap K E) e)
  have hθet : RingHom.Etale θ := hθ (Localization.Away s)

  have hβ'W : WeaklyEtale (Spec.map (CommRingCat.ofHom β')) := by
    letI : Algebra O A := ψ.toAlgebra
    letI : Algebra (Localization.Away s) A := β'.toAlgebra
    haveI : IsScalarTower O (Localization.Away s) A := IsScalarTower.of_algebraMap_eq' (by
      show ψ = β'.comp (algebraMap O (Localization.Away s))
      rw [IsScalarTower.algebraMap_eq O E (Localization.Away s), ← RingHom.comp_assoc,
        IsLocalization.Away.lift_comp, hβ])
    haveI : Algebra.Etale E (Localization.Away s) := Algebra.Etale.of_isLocalizationAway s
    haveI : Algebra.Etale O (Localization.Away s) := Algebra.Etale.comp O E (Localization.Away s)
    have h1 : Algebra.WeaklyEtale (Localization.Away s) A :=
      wc_weaklyEtale_cancel O (Localization.Away s) A inferInstance hW
    exact wc_lfi_specMap_weaklyEtale (Localization.Away s) A h1

  refine ⟨β'.comp θ, ?_, ?_, ?_⟩
  · intro i
    simp only [RingHom.comp_apply, θ, MvPolynomial.eval₂Hom_X', β', IsLocalization.Away.lift_eq,
      hβe]
  · intro c
    simp only [RingHom.comp_apply, θ, MvPolynomial.eval₂Hom_C, β', IsLocalization.Away.lift_eq,
      hβK]
  · have hθE : Etale (Spec.map (CommRingCat.ofHom θ)) :=
      (HasRingHomProperty.Spec_iff (P := @Etale) (Q := @RingHom.Etale)).mpr hθet
    haveI := hθE
    haveI := hβ'W
    rw [CommRingCat.ofHom_comp, Spec.map_comp]
    infer_instance

theorem wc_lpkt_fibre : ∀ (K A : Type u) [Field K] [CommRing A] [IsLocalRing A] (d : ℕ) (T : Scheme.{u})
    (e : T ≅ Spec (.of A)) (φ : MvPolynomial (Fin d) K →+* A)
    (hX : ∀ i, φ (MvPolynomial.X i) ∈ IsLocalRing.maximalIdeal A)
    (hspan : Ideal.span (Set.range (fun i => φ (MvPolynomial.X i))) = IsLocalRing.maximalIdeal A)
    (hres : ∀ a : A, ∃ c : K, a - φ (MvPolynomial.C c) ∈ IsLocalRing.maximalIdeal A),
    (e.hom ≫ Spec.map (CommRingCat.ofHom φ)) ⁻¹' {wcAffOrigin K d} =
        {e.inv (IsLocalRing.closedPoint A)} ∧
      IsIso (Limits.pullback.snd (e.hom ≫ Spec.map (CommRingCat.ofHom φ))
        ((Spec (.of (MvPolynomial (Fin d) K))).fromSpecResidueField (wcAffOrigin K d))) :=
by
  intro K A _ _ _ d T e φ _ hspan hres

  have lsf : ∀ (X : Scheme.{u}) (x : X) (A : Type u) [CommRing A] [IsLocalRing A]
      (ι : X.presheaf.stalk x ⟶ CommRingCat.of A) [IsLocalHom ι.hom],
      Ideal.map ι.hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) = IsLocalRing.maximalIdeal A →
      (∀ a : A, ∃ b, a - ι.hom b ∈ IsLocalRing.maximalIdeal A) →
      (Spec.map ι ≫ X.fromSpecStalk x) ⁻¹' {x} = {IsLocalRing.closedPoint A} ∧
      IsIso (Limits.pullback.snd (Spec.map ι ≫ X.fromSpecStalk x) (X.fromSpecResidueField x)) := by
    intro X x A _ _ ι _ hm hr
    have bij_aux : ∀ (P A : Type u) [CommRing P] [IsLocalRing P] [CommRing A] [IsLocalRing A]
        [Algebra P A],
        Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal A →
        (∀ a : A, ∃ b : P, a - algebraMap P A b ∈ IsLocalRing.maximalIdeal A) →
        Function.Bijective (Algebra.TensorProduct.includeRight :
          IsLocalRing.ResidueField P →ₐ[P] TensorProduct P A (IsLocalRing.ResidueField P)) := by
      intro P A _ _ _ _ _ hm hr
      have hzero : ∀ n ∈ IsLocalRing.maximalIdeal A,
          (n ⊗ₜ[P] (1 : IsLocalRing.ResidueField P)) = 0 := by
        intro n hn
        rw [← hm] at hn
        induction hn using Submodule.span_induction with
        | mem y hy =>
          obtain ⟨p, hp, rfl⟩ := hy
          rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul, Algebra.smul_def, mul_one,
            IsLocalRing.ResidueField.algebraMap_eq, (IsLocalRing.residue_eq_zero_iff p).mpr hp,
            TensorProduct.tmul_zero]
        | zero => exact TensorProduct.zero_tmul _ _
        | add y z _ _ hy hz => rw [TensorProduct.add_tmul, hy, hz, add_zero]
        | smul a y _ hy =>
          rw [smul_eq_mul]
          have : (a * y) ⊗ₜ[P] (1 : IsLocalRing.ResidueField P) =
              (a ⊗ₜ[P] (1 : IsLocalRing.ResidueField P)) *
                (y ⊗ₜ[P] (1 : IsLocalRing.ResidueField P)) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          rw [this, hy, mul_zero]
      have hsurj : Function.Surjective (Algebra.TensorProduct.includeRight :
          IsLocalRing.ResidueField P →ₐ[P] TensorProduct P A (IsLocalRing.ResidueField P)) := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => exact ⟨0, map_zero _⟩
        | tmul a c =>
          obtain ⟨p, rfl⟩ := IsLocalRing.residue_surjective c
          obtain ⟨b, hb⟩ := hr (p • a)
          refine ⟨IsLocalRing.residue P b, ?_⟩
          rw [Algebra.TensorProduct.includeRight_apply]
          have e1 : a ⊗ₜ[P] (IsLocalRing.residue P p) =
              (p • a) ⊗ₜ[P] (1 : IsLocalRing.ResidueField P) := by
            rw [← IsLocalRing.ResidueField.algebraMap_eq, Algebra.algebraMap_eq_smul_one,
              TensorProduct.smul_tmul]
          have e2 : (p • a) = algebraMap P A b + (p • a - algebraMap P A b) := by ring
          rw [e1, e2, TensorProduct.add_tmul, hzero _ hb, add_zero, Algebra.algebraMap_eq_smul_one,
            TensorProduct.smul_tmul, Algebra.smul_def, mul_one, IsLocalRing.ResidueField.algebraMap_eq]
        | add y z hy hz =>
          obtain ⟨c, hc⟩ := hy
          obtain ⟨c', hc'⟩ := hz
          exact ⟨c + c', by rw [map_add, hc, hc']⟩
      have hnt : Nontrivial (TensorProduct P A (IsLocalRing.ResidueField P)) := by
        have e := Algebra.TensorProduct.quotIdealMapEquivTensorQuot A (IsLocalRing.maximalIdeal P)
        rw [hm] at e
        haveI : Nontrivial (A ⧸ IsLocalRing.maximalIdeal A) := inferInstance
        exact e.symm.toEquiv.nontrivial
      refine ⟨?_, hsurj⟩
      exact (Algebra.TensorProduct.includeRight :
          IsLocalRing.ResidueField P →ₐ[P]
            TensorProduct P A (IsLocalRing.ResidueField P)).toRingHom.injective
    constructor
    · ext q
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply, Spec.map_apply]
      have hinj := (IsPreimmersion.isEmbedding (X.fromSpecStalk x)).injective
      constructor
      · intro hq
        have h1 : PrimeSpectrum.comap ι.hom q = IsLocalRing.closedPoint (X.presheaf.stalk x) :=
          hinj (hq.trans Scheme.fromSpecStalk_closedPoint.symm)
        have h2 : Ideal.comap ι.hom q.asIdeal = IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
          congrArg PrimeSpectrum.asIdeal h1
        have h3 : IsLocalRing.maximalIdeal A ≤ q.asIdeal := by
          rw [← hm, Ideal.map_le_iff_le_comap, h2]
        exact PrimeSpectrum.ext
          ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le q.isPrime.ne_top h3).symm
      · rintro rfl
        rw [IsLocalRing.comap_closedPoint, Scheme.fromSpecStalk_closedPoint]
    · letI : Algebra (X.presheaf.stalk x) A := ι.hom.toAlgebra
      have hbij := bij_aux (X.presheaf.stalk x) A hm hr
      have aux : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S), Function.Bijective f.hom →
          IsIso (Spec.map f) := fun f hf => by
        haveI := (ConcreteCategory.isIso_iff_bijective f).mpr hf
        infer_instance
      have hP : IsPullback
          (Limits.pullback.fst (Spec.map ι) (Spec.map (X.residue x)))
          (Limits.pullback.snd (Spec.map ι) (Spec.map (X.residue x)))
          (Spec.map ι ≫ X.fromSpecStalk x) (X.fromSpecResidueField x) :=
        IsPullback.of_isLimit (Limits.pullbackIsPullbackOfCompMono (Spec.map ι)
          (Spec.map (X.residue x)) (X.fromSpecStalk x))
      rw [← hP.isoPullback_inv_snd]
      have key : IsIso (Limits.pullback.snd (Spec.map ι) (Spec.map (X.residue x))) := by
        change IsIso (Limits.pullback.snd
          (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) A)))
          (Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x)
              (IsLocalRing.ResidueField (X.presheaf.stalk x))))))
        rw [← pullbackSpecIso_hom_snd]
        exact IsIso.comp_isIso' inferInstance (aux _ hbij)
      infer_instance

  have alg : ∀ (R : Type u) [CommRing R] (ψ : R →+* A) (P : Ideal R),
      Ideal.comap ψ (IsLocalRing.maximalIdeal A) = P →
      Ideal.map ψ P = IsLocalRing.maximalIdeal A →
      (∀ a : A, ∃ r : R, a - ψ r ∈ IsLocalRing.maximalIdeal A) →
      ∀ (S : CommRingCat.{u}) [IsLocalRing S] (ι : S ⟶ CommRingCat.of A)
        [IsLocalHom ι.hom] (τ : CommRingCat.of R ⟶ S), τ ≫ ι = CommRingCat.ofHom ψ →
        Ideal.map ι.hom (IsLocalRing.maximalIdeal S) = IsLocalRing.maximalIdeal A ∧
        ∀ a : A, ∃ b, a - ι.hom b ∈ IsLocalRing.maximalIdeal A := by
    intro R _ ψ P hc hm hr S _ ι _ τ hτι
    have hstar : ∀ r : R, ι.hom (τ.hom r) = ψ r := by
      intro r
      have := congrArg (fun g => CommRingCat.Hom.hom g r) hτι
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] using this
    refine ⟨le_antisymm ?_ ?_, ?_⟩
    · rw [Ideal.map_le_iff_le_comap]
      intro y hy
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (IsLocalRing.mem_maximalIdeal _).mp hy (isUnit_of_map_unit _ y hu)
    · rw [← hm, Ideal.map_le_iff_le_comap]
      intro r hr'
      rw [← hc, Ideal.mem_comap] at hr'
      rw [Ideal.mem_comap, ← hstar r]
      apply Ideal.mem_map_of_mem
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hu' := hu.map ι.hom
      rw [hstar r] at hu'
      exact (IsLocalRing.mem_maximalIdeal _).mp hr' hu'
    · intro a
      obtain ⟨r, hr0⟩ := hr a
      refine ⟨τ.hom r, ?_⟩
      rw [hstar r]
      exact hr0

  have gen : ∀ (R : Type u) [CommRing R] (ψ : R →+* A) (x : Spec (.of R)),
      Ideal.comap ψ (IsLocalRing.maximalIdeal A) = x.asIdeal →
      Ideal.map ψ x.asIdeal = IsLocalRing.maximalIdeal A →
      (∀ a : A, ∃ r : R, a - ψ r ∈ IsLocalRing.maximalIdeal A) →
      (Spec.map (CommRingCat.ofHom ψ)) ⁻¹' {x} = {IsLocalRing.closedPoint A} ∧
      IsIso (Limits.pullback.snd (Spec.map (CommRingCat.ofHom ψ))
        ((Spec (.of R)).fromSpecResidueField x)) := by
    intro R _ ψ x hc hm hr
    have halg := alg R ψ x.asIdeal hc hm hr
    have hfx : (Spec.map (CommRingCat.ofHom ψ)) (IsLocalRing.closedPoint (CommRingCat.of A)) = x :=
      PrimeSpectrum.ext ((congrArg PrimeSpectrum.asIdeal (Spec.map_apply _ _)).trans hc)
    subst hfx
    have hfac := Scheme.Spec_stalkClosedPointTo_fromSpecStalk (Spec.map (CommRingCat.ofHom ψ))
    haveI : IsLocalHom (Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom ψ))).hom :=
      Scheme.isLocalHom_stalkClosedPointTo _
    have h2 : StructureSheaf.toStalk R ((Spec.map (CommRingCat.ofHom ψ))
        (IsLocalRing.closedPoint (CommRingCat.of A))) ≫
        Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom ψ)) = CommRingCat.ofHom ψ := by
      apply Spec.map_injective
      exact (Spec.map_comp _ _).trans
        ((congrArg (fun t => Spec.map (Scheme.stalkClosedPointTo
          (Spec.map (CommRingCat.ofHom ψ))) ≫ t) (Spec.fromSpecStalk_eq' _ _).symm).trans hfac)
    obtain ⟨hmι, hrι⟩ := halg _ (Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom ψ))) _ h2
    have := lsf (Spec (.of R)) _ A _ hmι hrι
    rw [hfac] at this
    exact this

  have trans : ∀ (S Y Z : Scheme.{u}) (e : T ≅ S) (g : S ⟶ Y) (h : Z ⟶ Y) (x : Y) (c : S),
      g ⁻¹' {x} = {c} → IsIso (Limits.pullback.snd g h) →
      (e.hom ≫ g) ⁻¹' {x} = {e.inv c} ∧ IsIso (Limits.pullback.snd (e.hom ≫ g) h) := by
    intro S Y Z e g h x c hpre hiso
    constructor
    · ext t
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
      constructor
      · intro ht
        have ht' : e.hom t ∈ g ⁻¹' {x} := ht
        rw [hpre] at ht'
        have ht'' : e.hom t = c := ht'
        rw [← ht'', ← Scheme.Hom.comp_apply, Iso.hom_inv_id]
        rfl
      · rintro rfl
        have hc' : e.hom (e.inv c) = c := by
          rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
          rfl
        show g (e.hom (e.inv c)) = x
        rw [hc']
        have : c ∈ g ⁻¹' {x} := by rw [hpre]; rfl
        exact this
    · have eq₁ : (e.hom ≫ g) ≫ 𝟙 Y = e.hom ≫ g := Category.comp_id _
      have eq₂ : h ≫ 𝟙 Y = 𝟙 Z ≫ h := by simp
      haveI := Limits.pullback.map_isIso (e.hom ≫ g) h g h e.hom (𝟙 Z) (𝟙 Y) eq₁ eq₂
      have hc : Limits.pullback.map (e.hom ≫ g) h g h e.hom (𝟙 Z) (𝟙 Y) eq₁ eq₂ ≫
          Limits.pullback.snd g h = Limits.pullback.snd (e.hom ≫ g) h := by
        simp only [Limits.pullback.map, Category.comp_id]
        exact Limits.pullback.lift_snd _ _ _
      rw [← hc]
      infer_instance

  have hM : (RingHom.ker (MvPolynomial.constantCoeff (σ := Fin d) (R := K))).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective _
      (fun c => ⟨MvPolynomial.C c, MvPolynomial.constantCoeff_C _ c⟩)
  have hcomap : Ideal.comap φ (IsLocalRing.maximalIdeal A) = (wcAffOrigin K d).asIdeal := by
    show _ = RingHom.ker (MvPolynomial.constantCoeff (σ := Fin d) (R := K))
    symm
    apply hM.eq_of_le (Ideal.comap_ne_top φ (IsLocalRing.maximalIdeal.isMaximal A).ne_top)
    intro p hp
    rw [Ideal.mem_comap, ← hspan]
    have hp' : p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin d))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro μ hμ
      by_contra hcon
      push_neg at hcon
      have hμ0 : μ = 0 := Finsupp.ext (fun i => by simpa using hcon i (Set.mem_univ i))
      subst hμ0
      rw [MvPolynomial.mem_support_iff] at hμ
      apply hμ
      rw [RingHom.mem_ker, MvPolynomial.constantCoeff_eq] at hp
      exact hp
    have := Ideal.mem_map_of_mem φ hp'
    rw [Ideal.map_span, Set.image_image, Set.image_univ] at this
    exact this
  have hmap : Ideal.map φ (wcAffOrigin K d).asIdeal = IsLocalRing.maximalIdeal A := by
    apply le_antisymm
    · rw [Ideal.map_le_iff_le_comap, hcomap]
    · rw [← hspan, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      apply Ideal.mem_map_of_mem
      show MvPolynomial.X i ∈ RingHom.ker (MvPolynomial.constantCoeff (σ := Fin d) (R := K))
      rw [RingHom.mem_ker, MvPolynomial.constantCoeff_X]
  obtain ⟨h1, h2⟩ := gen (MvPolynomial (Fin d) K) φ (wcAffOrigin K d) hcomap hmap
    (fun a => by
      obtain ⟨c, hc⟩ := hres a
      exact ⟨_, hc⟩)
  exact trans _ _ _ e _ _ _ _ h1 h2

theorem wc_lpkt_chart (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (d : ℕ) (hd : 1 ≤ d)
    (hsm : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (T : X.left.ProEt) (g : T ⟶ wcGeomPoint F X h)
    (A : Type u) [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : T.left ≅ Spec (.of A))
    (xb : (wcGeomPoint F X h).left) (hxbc : IsClosed ({xb} : Set (wcGeomPoint F X h).left))
    (hpre : g.left ⁻¹' {xb} = {e.inv (IsLocalRing.closedPoint A)})
    (hfib : IsIso (Limits.pullback.snd g.left ((wcGeomPoint F X h).left.fromSpecResidueField xb)))
    (f : Fin d → A) (hspan : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (hdim : ringKrullDim A = (d : WithBot ℕ∞)) :
    ∃ φ : MvPolynomial (Fin d) (AlgebraicClosure F) →+* A,
      (∀ i, φ (MvPolynomial.X i) = f i) ∧
      WeaklyEtale (e.hom ≫ Spec.map (CommRingCat.ofHom φ)) ∧
      (e.hom ≫ Spec.map (CommRingCat.ofHom φ)) ⁻¹' {wcAffOrigin (AlgebraicClosure F) d} =
        {e.inv (IsLocalRing.closedPoint A)} ∧
      IsIso (Limits.pullback.snd (e.hom ≫ Spec.map (CommRingCat.ofHom φ))
        ((Spec (.of (MvPolynomial (Fin d) (AlgebraicClosure F)))).fromSpecResidueField
          (wcAffOrigin (AlgebraicClosure F) d))) :=
by
  classical
  obtain ⟨O, _, κO, ψ, hκ, hWs, hmax⟩ :=
    wc_lpkt_chart_extract F X h d hsm T g A e xb hxbc hpre
  have hW := wc_lpkt_specMap_weaklyEtale_ring O A ψ hWs
  have hres0 : ∀ a : A, ∃ c : AlgebraicClosure F, a - ψ (κO c) ∈ IsLocalRing.maximalIdeal A :=
    wc_lpkt_residue_rational (AlgebraicClosure F) O A d κO hκ ψ hW hmax
  have hf : ∀ i, f i ∈ IsLocalRing.maximalIdeal A := fun i => by
    rw [← hspan]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hind := wc_lpkt_cotangent_indep A d f hspan hdim hf
  choose D hDadd hDmul hDK hDf using
    wc_lpkt_coord_derivations (AlgebraicClosure F) A (ψ.comp κO) hres0 d f hf hspan hind
  obtain ⟨E, _, _, hE, β, e', hβ, hβe⟩ := wc_lpkt_indetale_factor O A ψ hW d f
  obtain ⟨φ, hφX, hφC, hφW⟩ := wc_lpkt_ring_assembly (AlgebraicClosure F) O A E d hd κO hκ ψ hW
    hE β hβ e' f hβe D hDadd hDmul (fun k c => hDK k c) hDf
  have hfun : (fun i => φ (MvPolynomial.X i)) = f := funext hφX
  obtain ⟨hpre', hfib'⟩ := wc_lpkt_fibre (AlgebraicClosure F) A d T.left e φ
    (fun i => by rw [hφX]; exact hf i) (by rw [hfun]; exact hspan)
    (fun a => by
      obtain ⟨c, hc⟩ := hres0 a
      exact ⟨c, by rw [hφC]; exact hc⟩)
  refine ⟨φ, hφX, ?_, hpre', hfib'⟩
  haveI := hφW
  infer_instance

theorem wc_lpsc_site (S : Scheme.{u}) (V : S.ProEt) :
    ∃ (_ : (wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left)
        (Scheme.ProEt.topology S))
      (_ : (wcSliceFunctor S V).IsCocontinuous (Scheme.ProEt.topology V.left)
        (Scheme.ProEt.topology S)),
      (wcLpscG S V).Additive ∧ Limits.PreservesFiniteLimits (wcLpscG S V) ∧
        Limits.PreservesFiniteColimits (wcLpscG S V) :=
by
  have wc_proet_mem_topology_iff : ∀ (S : Scheme.{u}) (X : S.ProEt) (R : Sieve X),
      R ∈ Scheme.ProEt.topology S X ↔
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          Scheme.proetaleTopology X.left := by
    intro S X R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have h : Scheme.ProEt.topology S =
        (Scheme.ProEt.forget S).restrictedTopology (Scheme.proetaleTopology.over S) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := S)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [h, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have wc_slice_pushforward_functorPullback : ∀ (S : Scheme.{u}) (U : S.ProEt)
      (V : U.left.ProEt) (T : Sieve ((wcSliceFunctor S U).obj V)),
      Sieve.functorPushforward (Scheme.ProEt.forget U.left ⋙ Over.forget U.left)
          (Sieve.functorPullback (wcSliceFunctor S U) T) =
        Sieve.functorPushforward (Scheme.ProEt.forget S ⋙ Over.forget S) T := by
    intro S U V T
    ext Z g
    constructor
    · rintro ⟨W, t', h, ht', rfl⟩
      exact ⟨(wcSliceFunctor S U).obj W, (wcSliceFunctor S U).map t', h, ht', rfl⟩
    · rintro ⟨W', t, h, ht, rfl⟩
      have hw : (t.left ≫ V.hom) ≫ U.hom = W'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w t)
      haveI : WeaklyEtale ((t.left ≫ V.hom) ≫ U.hom) := hw ▸ W'.prop
      haveI : WeaklyEtale (t.left ≫ V.hom) := WeaklyEtale.of_comp _ U.hom
      let W'' : U.left.ProEt := Scheme.ProEt.mk (t.left ≫ V.hom)
      let t'' : W'' ⟶ V := MorphismProperty.Over.homMk t.left rfl trivial
      let e : (wcSliceFunctor S U).obj W'' ⟶ W' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he : (wcSliceFunctor S U).map t'' = e ≫ t := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨W'', t'', h, ?_, rfl⟩
      show T.arrows ((wcSliceFunctor S U).map t'')
      rw [he]
      exact T.downward_closed ht e
  have wc_slice_compatiblePreserving : ∀ (S : Scheme.{u}) (U : S.ProEt),
      CompatiblePreserving.{u+1} (Scheme.ProEt.topology S) (wcSliceFunctor S U) := by
    intro S U
    apply CompatiblePreserving.mk
    intro ℱ Z T x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
    have hw : (f₁.left ≫ Y₁.hom) ≫ U.hom = X.hom :=
      (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
    haveI : WeaklyEtale ((f₁.left ≫ Y₁.hom) ≫ U.hom) := hw ▸ X.prop
    haveI : WeaklyEtale (f₁.left ≫ Y₁.hom) := WeaklyEtale.of_comp _ U.hom
    let X' : U.left.ProEt := Scheme.ProEt.mk (f₁.left ≫ Y₁.hom)
    have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
      congrArg (fun k => k.left) hfg
    have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
      have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
      have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
      calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
            (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
        _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
        _ = f₁.left ≫ Y₁.hom :=
            (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
    let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
    let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
    let e : X ⟶ (wcSliceFunctor S U).obj X' :=
      MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
    have hf₁ : f₁ = e ≫ (wcSliceFunctor S U).map f₁' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hf₂ : f₂ = e ≫ (wcSliceFunctor S U).map f₂' := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp _).symm
    have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact hleft
    have hc := hx f₁' f₂' hg₁ hg₂ hsq
    rw [hf₁, hf₂]
    simp only [Functor.map_comp, op_comp]
    rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    exact congrArg _ hc
  have hcov : CoverPreserving (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)
      (wcSliceFunctor S V) :=
    CoverPreserving.mk (fun {W} {R} hR =>
      (wc_proet_mem_topology_iff S ((wcSliceFunctor S V).obj W)
        (Sieve.functorPushforward (wcSliceFunctor S V) R)).2
        ((Sieve.functorPushforward_comp (wcSliceFunctor S V)
          (Scheme.ProEt.forget S ⋙ Over.forget S) R) ▸ (wc_proet_mem_topology_iff V.left W R).1 hR))
  haveI hcont : (wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology S) :=
    Functor.isContinuous_of_coverPreserving (wc_slice_compatiblePreserving S V) hcov
  haveI hcocont : (wcSliceFunctor S V).IsCocontinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology S) :=
    Functor.IsCocontinuous.mk (fun {W} {T} hT => by
      have h1 := (wc_proet_mem_topology_iff S ((wcSliceFunctor S V).obj W) T).1 hT
      rw [← wc_slice_pushforward_functorPullback S V W T] at h1
      exact (wc_proet_mem_topology_iff V.left W _).2 h1)
  refine ⟨hcont, hcocont, ?_⟩
  let G := (wcSliceFunctor S V).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)
  let F := (wcSliceFunctor S V).sheafPullback AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)
  let adj : F ⊣ G := (wcSliceFunctor S V).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)
  let adj2 := (wcSliceFunctor S V).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} G := adj2.leftAdjoint_preservesColimits
  haveI hcol : Limits.PreservesFiniteColimits G :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits G
  haveI : Limits.PreservesLimitsOfSize.{0, 0} G := adj.rightAdjoint_preservesLimits
  haveI hlim : Limits.PreservesFiniteLimits G :=
    Limits.PreservesLimitsOfSize.preservesFiniteLimits G
  haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
  haveI hadd : G.Additive := Functor.additive_of_preserves_binary_products G
  exact ⟨hadd, hlim, hcol⟩

theorem wc_lpsc_psi_inj (S : Scheme.{u}) (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor S V).IsCocontinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcLpscG S V).Additive] [Limits.PreservesFiniteLimits (wcLpscG S V)]
    [Limits.PreservesFiniteColimits (wcLpscG S V)] (m d q : ℕ) :
    Function.Injective (wcLpscPsi S V m d (wcLpscBetaTop S V) q) :=
by
  classical

  have hev : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (W : C) (Q : Sheaf J' AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
        φ.hom.app (Opposite.op W)
          ((toSheafify J' (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op W) (FreeAbelianGroup.of (ULift.up (𝟙 W))))) := by
    intro C _ J' _ W Q
    let e := ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ Q).trans
      (((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
    have h : (fun φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
        φ.hom.app (Opposite.op W)
          ((toSheafify J' (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op W) (FreeAbelianGroup.of (ULift.up (𝟙 W))))) = ⇑e := by
      funext φ
      simp only [e, Equiv.trans_apply]
      rw [Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    rw [h]
    exact e.bijective

  have hkey : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (Q : Sheaf J' AddCommGrpCat.{u+1}) (γ : P ⟶ Q.obj) (U : Cᵒᵖ) (s : P.obj U),
      (((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv P Q).symm γ).hom.app U
        ((toSheafify J' P).app U s) = γ.app U s := by
    intro C _ J' _ P Q γ U s
    have h := (sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv_unit P Q
      (((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv P Q).symm γ)
    rw [Equiv.apply_symm_apply, sheafificationAdjunction_unit_app] at h
    exact (congrArg (fun φ : P ⟶ Q.obj => φ.app U s) h).symm

  have wc_slice_costructuredArrow_final : ∀ (S : Scheme.{u}) (U W : S.ProEt),
      ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)),
        D.Final := by
    intro S U W
    have hWf : ∀ f : W ⟶ U, WeaklyEtale f.left := fun f => by
      have h : f.left ≫ U.hom = W.hom := MorphismProperty.Over.w f
      haveI : WeaklyEtale (f.left ≫ U.hom) := h ▸ W.prop
      exact WeaklyEtale.of_comp f.left U.hom
    let Wf : (W ⟶ U) → U.left.ProEt := fun f => @Scheme.ProEt.mk _ _ f.left (hWf f)
    obtain ⟨ε, hε⟩ : ∃ ε : ∀ f : W ⟶ U, W ⟶ (wcSliceFunctor S U).obj (Wf f),
        ∀ f, (ε f).left = 𝟙 W.left := ⟨fun f =>
      MorphismProperty.Over.homMk (𝟙 _)
        ((Category.id_comp _).trans (MorphismProperty.Over.w f)) trivial, fun f => rfl⟩
    have hWfhom : ∀ f : W ⟶ U, (Wf f).hom = f.left := fun f => rfl
    obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
        CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W),
        ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op :=
      ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Wf f)) (ε f).op),
        fun f => rfl⟩
    have key : ∀ (c : CostructuredArrow (wcSliceFunctor S U).op (Opposite.op W)) (f : W ⟶ U)
        (k : c.left ⟶ Opposite.op (Wf f))
        (hk : (wcSliceFunctor S U).op.map k ≫ (ε f).op = c.hom),
        (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left ∧
          f.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom := by
      intro c f k hk
      have h0 : ε f ≫ (wcSliceFunctor S U).map k.unop = c.hom.unop :=
        congrArg Quiver.Hom.unop hk
      have h1 : (ε f).left ≫ (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        congrArg (fun k : W ⟶ (wcSliceFunctor S U).obj c.left.unop => k.left) h0
      have h1' : (Quiver.Hom.unop k).left = (Quiver.Hom.unop c.hom).left :=
        (Category.id_comp _).symm.trans
          ((congrArg (· ≫ (Quiver.Hom.unop k).left) (hε f)).symm.trans h1)
      refine ⟨h1', ?_⟩
      have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Wf f).hom :=
        MorphismProperty.Over.w (k.unop : Wf f ⟶ c.left.unop)
      exact (hWfhom f).symm.trans (hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1'))
    refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
    have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
      intro f h h'
      refine (cancel_mono (eqToHom (hD f))).1 ?_
      apply CostructuredArrow.hom_ext
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
        (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
    have ha : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom ≫ U.hom = W.hom :=
      MorphismProperty.Over.w (Quiver.Hom.unop c.hom : W ⟶ (wcSliceFunctor S U).obj c.left.unop)
    obtain ⟨fc, hfc⟩ : ∃ fc : W ⟶ U,
        fc.left = (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom :=
      ⟨MorphismProperty.Over.homMk ((Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom)
        ((Category.assoc _ _ _).trans ha) trivial, rfl⟩
    have hκ : (Quiver.Hom.unop c.hom).left ≫ c.left.unop.hom = (Wf fc).hom :=
      hfc.symm.trans (hWfhom fc).symm
    obtain ⟨κc, hκc⟩ : ∃ κc : Wf fc ⟶ c.left.unop,
        κc.left = (Quiver.Hom.unop c.hom).left :=
      ⟨MorphismProperty.Over.homMk (Quiver.Hom.unop c.hom).left hκ trivial, rfl⟩
    have hw : (wcSliceFunctor S U).op.map κc.op ≫ (ε fc).op = c.hom := by
      apply Quiver.Hom.unop_inj
      apply MorphismProperty.Over.Hom.ext
      exact ((congrArg (· ≫ κc.left) (hε fc)).trans (Category.id_comp _)).trans hκc
    let φc : c ⟶ D.obj ⟨fc⟩ :=
      CostructuredArrow.homMk (f := c)
        (f' := CostructuredArrow.mk (Y := Opposite.op (Wf fc)) (ε fc).op)
        κc.op hw ≫ eqToHom (hD fc).symm
    have hto : ∀ s : StructuredArrow c D, s.right.as = fc := by
      intro s
      apply MorphismProperty.Over.Hom.ext
      exact (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left
        (CostructuredArrow.w _)).2.trans hfc.symm
    let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
    exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
      (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
      (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))
  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key
  have wc_lan_preservesFiniteLimits_of_discrete_final : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hiso hfin
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := hiso Y
    obtain ⟨I, G, hG⟩ := hfin Y
    haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
    let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
        ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
    exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)
  haveI hlan : Limits.PreservesFiniteLimits ((wcSliceFunctor S V).op.lan :
      ((V.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
    wc_lan_preservesFiniteLimits_of_discrete_final (wcSliceFunctor S V).op
      (fun Y => wc_lan_eval_iso (wcSliceFunctor S V).op Y)
      (fun Y => wc_slice_costructuredArrow_final S V Y.unop)
  let L := (wcSliceFunctor S V).sheafPullback AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)
  let adj : L ⊣ wcLpscG S V := (wcSliceFunctor S V).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  haveI : L.Additive := adj.left_adjoint_additive

  haveI hβiso : IsIso (wcLpscBetaTop S V) :=
    ⟨⟨(MorphismProperty.Over.homMk (𝟙 V.left) rfl trivial :
        V ⟶ (wcSliceFunctor S V).obj (Scheme.ProEt.mk (𝟙 V.left))),
      MorphismProperty.Over.Hom.ext (Category.comp_id _),
      MorphismProperty.Over.Hom.ext (Category.comp_id _)⟩⟩

  have hclaim : ∀ (Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (f : wcFreeSheaf S V ⟶ Y),
      (wcLpscGen S V (Scheme.ProEt.mk (𝟙 V.left)) V (wcLpscBetaTop S V) ≫
          (wcLpscG S V).map f).hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
        ((toSheafify (Scheme.ProEt.topology V.left)
          (yoneda.obj (Scheme.ProEt.mk (𝟙 V.left)) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)).app
          (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
          (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 V.left)))))) =
      Y.obj.map (wcLpscBetaTop S V).op (f.hom.app (Opposite.op V)
        ((toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op V) (FreeAbelianGroup.of (ULift.up (𝟙 V))))) := by
    intro Y f
    have e2 := hkey (Scheme.ProEt.topology V.left)
      (yoneda.obj (Scheme.ProEt.mk (𝟙 V.left)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      ((wcLpscG S V).obj (wcFreeSheaf S V))
      (Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj V)).symm
          (wcLpscBetaTop S V)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerLeft (wcSliceFunctor S V).op
          (toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
      (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
      (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 V.left)))))
    have hb : ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj V)).symm
        (wcLpscBetaTop S V)).app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
          (𝟙 (Scheme.ProEt.mk (𝟙 V.left))) = wcLpscBetaTop S V ≫ 𝟙 V := by
      have hb0 : ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj V)).symm
          (wcLpscBetaTop S V)).app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
            (𝟙 (Scheme.ProEt.mk (𝟙 V.left))) =
          (wcSliceFunctor S V).map (𝟙 (Scheme.ProEt.mk (𝟙 V.left))) ≫ wcLpscBetaTop S V := by
        first
          | rfl
          | exact yonedaEquiv_symm_app_apply _ _ _
          | (erw [yonedaEquiv_symm_app_apply]; rfl)
      rw [hb0]
      first
        | rw [CategoryTheory.Functor.map_id, Category.id_comp, Category.comp_id]
        | simp only [CategoryTheory.Functor.map_id, Category.id_comp, Category.comp_id]
        | (apply MorphismProperty.Over.Hom.ext; rfl)
        | rfl
        | simp
    have hn1 := NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) (wcLpscBetaTop S V).op
          (FreeAbelianGroup.of (ULift.up (𝟙 V)))
    have hn2 := NatTrans.naturality_apply f.hom (wcLpscBetaTop S V).op
      ((toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op V) (FreeAbelianGroup.of (ULift.up (𝟙 V))))
    refine Eq.trans (congrArg (fun x => f.hom.app
      (Opposite.op ((wcSliceFunctor S V).obj (Scheme.ProEt.mk (𝟙 V.left)))) x) e2) ?_
    refine Eq.trans ?_ hn2
    refine congrArg (fun x => f.hom.app
      (Opposite.op ((wcSliceFunctor S V).obj (Scheme.ProEt.mk (𝟙 V.left)))) x) ?_
    refine Eq.trans ?_ hn1
    show (toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op ((wcSliceFunctor S V).obj (Scheme.ProEt.mk (𝟙 V.left))))
        (FreeAbelianGroup.of (ULift.up (((yonedaEquiv
          (F := (wcSliceFunctor S V).op ⋙ yoneda.obj V)).symm
          (wcLpscBetaTop S V)).app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
            (𝟙 (Scheme.ProEt.mk (𝟙 V.left)))))) = _
    rw [hb]
    rfl

  have hΦ : ∀ Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Function.Bijective (fun f : wcFreeSheaf S V ⟶ Y =>
        wcLpscGen S V (Scheme.ProEt.mk (𝟙 V.left)) V (wcLpscBetaTop S V) ≫
          (wcLpscG S V).map f) := by
    intro Y
    have h1 := hev (Scheme.ProEt.topology V.left) (Scheme.ProEt.mk (𝟙 V.left))
      ((wcLpscG S V).obj Y)
    have h2 := hev (Scheme.ProEt.topology S) V Y
    have h3 : Function.Bijective (fun x : Y.obj.obj (Opposite.op V) =>
        Y.obj.map (wcLpscBetaTop S V).op x) :=
      ConcreteCategory.bijective_of_isIso (Y.obj.map (wcLpscBetaTop S V).op)
    refine ⟨fun f₁ f₂ hf => h2.1 (h3.1 ?_), fun g => ?_⟩
    · have := congrArg (fun φ : wcFreeSheaf V.left (Scheme.ProEt.mk (𝟙 V.left)) ⟶
          (wcLpscG S V).obj Y => φ.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
        ((toSheafify (Scheme.ProEt.topology V.left)
          (yoneda.obj (Scheme.ProEt.mk (𝟙 V.left)) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)).app
          (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
          (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 V.left))))))) hf
      exact (hclaim Y f₁).symm.trans (this.trans (hclaim Y f₂))
    · obtain ⟨y, hy⟩ := h3.2 (g.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
        ((toSheafify (Scheme.ProEt.topology V.left)
          (yoneda.obj (Scheme.ProEt.mk (𝟙 V.left)) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)).app
          (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
          (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 V.left)))))))
      obtain ⟨f, hf⟩ := h2.2 y
      refine ⟨f, h1.1 ?_⟩
      exact (hclaim Y f).trans
        ((congrArg (fun x => Y.obj.map (wcLpscBetaTop S V).op x) hf).trans hy)

  obtain ⟨θ, hθ⟩ : ∃ θ : L.obj (wcFreeSheaf V.left (Scheme.ProEt.mk (𝟙 V.left))) ⟶
      wcFreeSheaf S V,
      adj.homEquiv _ _ θ = wcLpscGen S V (Scheme.ProEt.mk (𝟙 V.left)) V (wcLpscBetaTop S V) :=
    ⟨_, (adj.homEquiv _ _).apply_symm_apply _⟩
  have hbij : ∀ T, Function.Bijective (fun f : wcFreeSheaf S V ⟶ T => θ ≫ f) := by
    intro T
    have e : (fun f : wcFreeSheaf S V ⟶ T => θ ≫ f) =
        (adj.homEquiv _ T).symm ∘ (fun f : wcFreeSheaf S V ⟶ T =>
          wcLpscGen S V (Scheme.ProEt.mk (𝟙 V.left)) V (wcLpscBetaTop S V) ≫
            (wcLpscG S V).map f) := by
      funext f
      simp only [Function.comp_apply]
      rw [_root_.Equiv.eq_symm_apply, Adjunction.homEquiv_naturality_right, hθ]
    rw [e]
    exact (adj.homEquiv _ T).symm.bijective.comp (hΦ T)
  haveI : IsIso θ := isIso_of_coyoneda_map_bijective θ hbij
  have hψ : Function.Bijective
      (fun y : Abelian.Ext (wcFreeSheaf S V) (wcRootTwist S m d) q =>
        (Abelian.Ext.mk₀ θ).comp y (zero_add q)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun γ => (Abelian.Ext.mk₀ (inv θ)).comp γ (zero_add q), ?_, ?_⟩
    · intro β
      simp only
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · intro γ
      simp only
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  have hfac : (fun y : Abelian.Ext (wcFreeSheaf S V) (wcRootTwist S m d) q =>
      (Abelian.Ext.mk₀ (wcLpscGen S V (Scheme.ProEt.mk (𝟙 V.left)) V (wcLpscBetaTop S V))).comp
        (Abelian.Ext.mapExactFunctor (wcLpscG S V) y) (zero_add q)) =
      adj.extEquiv ∘ (fun y : Abelian.Ext (wcFreeSheaf S V) (wcRootTwist S m d) q =>
        (Abelian.Ext.mk₀ θ).comp y (zero_add q)) := by
    funext y
    simp only [Function.comp_apply]
    rw [Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc,
      ← hθ, Adjunction.homEquiv_unit]
  have hT : Function.Bijective (fun y : Abelian.Ext (wcFreeSheaf S V) (wcRootTwist S m d) q =>
      (Abelian.Ext.mk₀ (wcLpscGen S V (Scheme.ProEt.mk (𝟙 V.left)) V (wcLpscBetaTop S V))).comp
        (Abelian.Ext.mapExactFunctor (wcLpscG S V) y) (zero_add q)) := by
    rw [hfac]
    exact adj.extEquiv.bijective.comp hψ

  have hgen : ∀ {A X Y : Sheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}} (e : X ≅ Y)
      (t : Abelian.Ext A Y q),
      (t.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)).comp (Abelian.Ext.mk₀ e.hom) (add_zero q) = t := by
    intro A X Y e t
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have hinj : ∀ {A X Y : Sheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}} (e : X ≅ Y),
      Function.Injective (fun t : Abelian.Ext A Y q => t.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)) := by
    intro A X Y e t₁ t₂ h
    have h' := congrArg (fun z => z.comp (Abelian.Ext.mk₀ e.hom) (add_zero q)) h
    simp only at h'
    rwa [hgen, hgen] at h'
  intro a b hab
  apply hT.1
  exact hinj (wcLpscCP S V (wcRootTwistPre S m d)) hab

theorem wc_lpsc_gen_nat (S : Scheme.{u}) (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    {W W' : V.left.ProEt} {Z Z' : S.ProEt} (g : W ⟶ W') (h : Z ⟶ Z')
    (β : (wcSliceFunctor S V).obj W ⟶ Z) (β' : (wcSliceFunctor S V).obj W' ⟶ Z')
    (hw : (wcSliceFunctor S V).map g ≫ β' = β ≫ h) :
    wcFreeSheafMap V.left g ≫ wcLpscGen S V W' Z' β' =
      wcLpscGen S V W Z β ≫ (wcLpscG S V).map (wcFreeSheafMap S h) :=
by
  classical
  have hY : yoneda.map g ≫ (yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z')).symm β' =
      (yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z)).symm β ≫
        Functor.whiskerLeft (wcSliceFunctor S V).op (yoneda.map h) := by
    ext U f
    show (wcSliceFunctor S V).map (f ≫ g) ≫ β' = ((wcSliceFunctor S V).map f ≫ β) ≫ h
    rw [Functor.map_comp, Category.assoc, hw, Category.assoc]
  have e1 : (sheafToPresheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}).map
      ((wcLpscG S V).map (wcFreeSheafMap S h)) =
      Functor.whiskerLeft (wcSliceFunctor S V).op
        (sheafifyMap (Scheme.ProEt.topology S)
          (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := rfl
  have e2 : Functor.whiskerLeft (wcSliceFunctor S V).op
      (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) =
      Functor.whiskerRight (Functor.whiskerLeft (wcSliceFunctor S V).op (yoneda.map h))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := rfl
  have hstar : Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
      (Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z')).symm β')
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerLeft (wcSliceFunctor S V).op
          (toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj Z' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) =
      (Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z)).symm β)
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerLeft (wcSliceFunctor S V).op
          (toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj Z ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫
      (sheafToPresheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}).map
        ((wcLpscG S V).map (wcFreeSheafMap S h)) := by
    have n1 : toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj Z ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        sheafifyMap (Scheme.ProEt.topology S)
          (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) =
        Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj Z' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) :=
      (toSheafify_naturality _ _).symm
    have n2 : Functor.whiskerLeft (wcSliceFunctor S V).op (toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj Z ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
        Functor.whiskerLeft (wcSliceFunctor S V).op (sheafifyMap (Scheme.ProEt.topology S)
          (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) =
        Functor.whiskerLeft (wcSliceFunctor S V).op
            (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
          Functor.whiskerLeft (wcSliceFunctor S V).op (toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj Z' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      rw [← Functor.whiskerLeft_comp, ← Functor.whiskerLeft_comp, n1]
    have n3 : Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z')).symm β')
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z)).symm β)
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          Functor.whiskerLeft (wcSliceFunctor S V).op
            (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      rw [← Functor.whiskerRight_comp, hY, Functor.whiskerRight_comp, e2]
    calc Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          (Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z')).symm β')
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            Functor.whiskerLeft (wcSliceFunctor S V).op
              (toSheafify (Scheme.ProEt.topology S)
                (yoneda.obj Z' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
        = (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z')).symm β')
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
            Functor.whiskerLeft (wcSliceFunctor S V).op
              (toSheafify (Scheme.ProEt.topology S)
                (yoneda.obj Z' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
          (Category.assoc _ _ _).symm
      _ = (Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z)).symm β)
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            Functor.whiskerLeft (wcSliceFunctor S V).op
              (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) ≫
            Functor.whiskerLeft (wcSliceFunctor S V).op
              (toSheafify (Scheme.ProEt.topology S)
                (yoneda.obj Z' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by rw [n3]
      _ = Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z)).symm β)
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            (Functor.whiskerLeft (wcSliceFunctor S V).op
              (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
            Functor.whiskerLeft (wcSliceFunctor S V).op
              (toSheafify (Scheme.ProEt.topology S)
                (yoneda.obj Z' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :=
          Category.assoc _ _ _
      _ = Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z)).symm β)
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
            (Functor.whiskerLeft (wcSliceFunctor S V).op (toSheafify (Scheme.ProEt.topology S)
              (yoneda.obj Z ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
            Functor.whiskerLeft (wcSliceFunctor S V).op (sheafifyMap (Scheme.ProEt.topology S)
              (Functor.whiskerRight (yoneda.map h) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))) := by
          rw [n2]
      _ = _ := by exact (Category.assoc _ _ _).symm
  have L := (sheafificationAdjunction (Scheme.ProEt.topology V.left)
    AddCommGrpCat.{u+1}).homEquiv_naturality_left_symm (Y := (wcLpscG S V).obj (wcFreeSheaf S Z'))
      (Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z')).symm β')
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerLeft (wcSliceFunctor S V).op
          (toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj Z' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
  have R := (sheafificationAdjunction (Scheme.ProEt.topology V.left)
    AddCommGrpCat.{u+1}).homEquiv_naturality_right_symm (Y := (wcLpscG S V).obj (wcFreeSheaf S Z))
      (Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj Z)).symm β)
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerLeft (wcSliceFunctor S V).op
          (toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj Z ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
      ((wcLpscG S V).map (wcFreeSheafMap S h))
  have M := congrArg (fun φ => ((sheafificationAdjunction (Scheme.ProEt.topology V.left)
    AddCommGrpCat.{u+1}).homEquiv (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      ((wcLpscG S V).obj (wcFreeSheaf S Z'))).symm φ) hstar
  exact L.symm.trans (M.trans R)

theorem wc_lpsc_mv_compat (S : Scheme.{u}) (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcLpscG S V).Additive] [Limits.PreservesFiniteLimits (wcLpscG S V)]
    [Limits.PreservesFiniteColimits (wcLpscG S V)]
    {O₁₂ O₁ O₂ O : V.left.Opens} (h₁ : O₁₂ ≤ O₁) (h₂ : O₁₂ ≤ O₂) (h₃ : O₁ ≤ O) (h₄ : O₂ ≤ O)
    (hcup : O₁ ⊔ O₂ = O) (hcap : O₁ ⊓ O₂ = O₁₂)
    (e₁₂ : wcFreeSheaf V.left (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) O₁₂) ⟶
      (wcLpscG S V).obj (wcFreeSheaf S (wcVRes S V O₁₂)))
    (e₁ : wcFreeSheaf V.left (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) O₁) ⟶
      (wcLpscG S V).obj (wcFreeSheaf S (wcVRes S V O₁)))
    (e₂ : wcFreeSheaf V.left (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) O₂) ⟶
      (wcLpscG S V).obj (wcFreeSheaf S (wcVRes S V O₂)))
    (e : wcFreeSheaf V.left (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) O) ⟶
      (wcLpscG S V).obj (wcFreeSheaf S (wcVRes S V O)))
    (s₁ : wcFreeSheafMap V.left (wcVResLE V.left (Scheme.ProEt.mk (𝟙 V.left)) h₁) ≫ e₁ =
      e₁₂ ≫ (wcLpscG S V).map (wcFreeSheafMap S (wcVResLE S V h₁)))
    (s₂ : wcFreeSheafMap V.left (wcVResLE V.left (Scheme.ProEt.mk (𝟙 V.left)) h₂) ≫ e₂ =
      e₁₂ ≫ (wcLpscG S V).map (wcFreeSheafMap S (wcVResLE S V h₂)))
    (s₃ : wcFreeSheafMap V.left (wcVResLE V.left (Scheme.ProEt.mk (𝟙 V.left)) h₃) ≫ e =
      e₁ ≫ (wcLpscG S V).map (wcFreeSheafMap S (wcVResLE S V h₃)))
    (s₄ : wcFreeSheafMap V.left (wcVResLE V.left (Scheme.ProEt.mk (𝟙 V.left)) h₄) ≫ e =
      e₂ ≫ (wcLpscG S V).map (wcFreeSheafMap S (wcVResLE S V h₄))) :
    (Abelian.Ext.mk₀ e).comp
        (Abelian.Ext.mapExactFunctor (wcLpscG S V) (wcMVClass S V h₁ h₂ h₃ h₄)) (zero_add 1) =
      (wcMVClass V.left (Scheme.ProEt.mk (𝟙 V.left)) h₁ h₂ h₃ h₄).comp
        (Abelian.Ext.mk₀ e₁₂) (add_zero 1) :=
by
  have hS := wc_lpgfg_open_mv_ses S V h₁ h₂ h₃ h₄ hcup hcap
  have hV := wc_lpgfg_open_mv_ses V.left (Scheme.ProEt.mk (𝟙 V.left)) h₁ h₂ h₃ h₄ hcup hcap
  have eS : wcMVClass S V h₁ h₂ h₃ h₄ = hS.extClass := by
    unfold wcMVClass
    exact dif_pos hS
  have eV : wcMVClass V.left (Scheme.ProEt.mk (𝟙 V.left)) h₁ h₂ h₃ h₄ = hV.extClass := by
    unfold wcMVClass
    exact dif_pos hV
  have hm : Abelian.Ext.mapExactFunctor (wcLpscG S V) hS.extClass =
      (hS.map_of_exact (wcLpscG S V)).extClass :=
    Abelian.Ext.mapExactFunctor_extClass (wcLpscG S V) hS
  rw [eS, eV]
  refine (congrArg (fun z => (Abelian.Ext.mk₀ e).comp z (zero_add 1)) hm).trans ?_
  refine (hV.extClass_naturality (hS.map_of_exact (wcLpscG S V))
    { τ₁ := e₁₂
      τ₂ := Limits.biprod.desc (e₁ ≫ (wcLpscG S V).map Limits.biprod.inl)
        (e₂ ≫ (wcLpscG S V).map Limits.biprod.inr)
      τ₃ := e
      comm₁₂ := ?_
      comm₂₃ := ?_ }).symm
  · dsimp only [wcMVComplex, ShortComplex.map_f]
    simp only [Limits.biprod.lift_eq, Functor.map_add, Functor.map_neg, Functor.map_comp,
      Preadditive.neg_comp, Preadditive.comp_add, Preadditive.comp_neg, Preadditive.add_comp,
      Category.assoc, Limits.biprod.inl_desc, Limits.biprod.inr_desc]
    rw [reassoc_of% s₁, reassoc_of% s₂]
  · dsimp only [wcMVComplex, ShortComplex.map_g]
    apply Limits.biprod.hom_ext'
    · rw [Limits.biprod.inl_desc_assoc, Limits.biprod.inl_desc_assoc, Category.assoc,
        ← Functor.map_comp, Limits.biprod.inl_desc]
      exact s₃.symm
    · rw [Limits.biprod.inr_desc_assoc, Limits.biprod.inr_desc_assoc, Category.assoc,
        ← Functor.map_comp, Limits.biprod.inr_desc]
      exact s₄.symm

theorem wc_lpsc_pi_compat (S : Scheme.{u}) (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor S V).IsCocontinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (ℓ d : ℕ) (O : V.left.Opens) (tD : Fin d → (Γ((wcVRes S V O).left, ⊤))ˣ)
    (hℓD : IsUnit ((ℓ : ℕ) : Γ((wcVRes S V O).left, ⊤))) :
    wcLpscGen S V _ _ (wcLpscBeta S V O) ≫
        (wcLpscG S V).map (wcUnitTupleMap S (wcVRes S V O) ℓ d tD hℓD) ≫
          (wcLpscCP S V (wcUnitTuplePre S ℓ d)).inv =
      wcUnitTupleMap V.left (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) O) ℓ d tD hℓD :=
by
  classical

  have hCP : ∀ P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
      Functor.whiskerLeft (wcSliceFunctor S V).op (toSheafify (Scheme.ProEt.topology S) P) ≫
          (wcLpscCP S V P).inv.hom =
        toSheafify (Scheme.ProEt.topology V.left) ((wcSliceFunctor S V).op ⋙ P) := by
    intro P
    have h1 : toSheafify (Scheme.ProEt.topology V.left) ((wcSliceFunctor S V).op ⋙ P) ≫
        (wcLpscCP S V P).hom.hom =
          Functor.whiskerLeft (wcSliceFunctor S V).op (toSheafify (Scheme.ProEt.topology S) P) := by
      unfold wcLpscCP
      rw [Iso.app_hom, Functor.pushforwardContinuousSheafificationCompatibility_hom_app_hom]
      exact toSheafify_sheafifyLift _ _ _
    have h2 : (wcLpscCP S V P).hom.hom ≫ (wcLpscCP S V P).inv.hom = 𝟙 _ := by
      show ((wcLpscCP S V P).hom ≫ (wcLpscCP S V P).inv).hom = _
      rw [Iso.hom_inv_id]
      rfl
    calc Functor.whiskerLeft (wcSliceFunctor S V).op (toSheafify (Scheme.ProEt.topology S) P) ≫
          (wcLpscCP S V P).inv.hom
        = (toSheafify (Scheme.ProEt.topology V.left) ((wcSliceFunctor S V).op ⋙ P) ≫
            (wcLpscCP S V P).hom.hom) ≫ (wcLpscCP S V P).inv.hom := eq_whisker h1.symm _
      _ = toSheafify (Scheme.ProEt.topology V.left) ((wcSliceFunctor S V).op ⋙ P) ≫
            ((wcLpscCP S V P).hom.hom ≫ (wcLpscCP S V P).inv.hom) := Category.assoc _ _ _
      _ = toSheafify (Scheme.ProEt.topology V.left) ((wcSliceFunctor S V).op ⋙ P) ≫ 𝟙 _ :=
            whisker_eq _ h2
      _ = toSheafify (Scheme.ProEt.topology V.left) ((wcSliceFunctor S V).op ⋙ P) :=
            Category.comp_id _

  obtain ⟨yS, hyS⟩ : ∃ y, y = (yonedaEquiv (X := wcVRes S V O)
      (F := (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ d)).symm
      (Subtype.mk tD hℓD : {t : Fin d → (Γ((wcVRes S V O).left, ⊤))ˣ //
        IsUnit ((ℓ : ℕ) : Γ((wcVRes S V O).left, ⊤))}) := ⟨_, rfl⟩
  obtain ⟨yV, hyV⟩ : ∃ y, y = (yonedaEquiv (X := wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) O)
      (F := (Scheme.ProEt.forget V.left ⋙ Over.forget V.left).op ⋙ Scheme.Γ ⋙
        wcUnitTupleFun.{u} ℓ d)).symm
      (Subtype.mk tD hℓD : {t : Fin d → (Γ((wcVRes S V O).left, ⊤))ˣ //
        IsUnit ((ℓ : ℕ) : Γ((wcVRes S V O).left, ⊤))}) := ⟨_, rfl⟩
  obtain ⟨yβ, hyβ⟩ : ∃ y, y = (yonedaEquiv (F := (wcSliceFunctor S V).op ⋙
      yoneda.obj (wcVRes S V O))).symm (wcLpscBeta S V O) := ⟨_, rfl⟩

  have hY : yβ ≫ Functor.whiskerLeft (wcSliceFunctor S V).op yS = yV := by
    subst hyS hyV hyβ
    apply yonedaEquiv.injective
    refine (yonedaEquiv_comp _ _).trans ?_
    refine (congrArg (ConcreteCategory.hom
      ((Functor.whiskerLeft (wcSliceFunctor S V).op ((yonedaEquiv (X := wcVRes S V O)
          (F := (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ d)).symm
          (Subtype.mk tD hℓD : {t : Fin d → (Γ((wcVRes S V O).left, ⊤))ˣ //
            IsUnit ((ℓ : ℕ) : Γ((wcVRes S V O).left, ⊤))}))).app
        (Opposite.op (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) O))))
      (Equiv.apply_symm_apply _ _)).trans ?_
    refine Eq.trans ?_ (Equiv.apply_symm_apply _ _).symm
    apply Subtype.ext
    funext i
    apply Units.ext
    show ((wcLpscBeta S V O).left.appTop.hom) _ = _
    show ((𝟙 _ : (wcVRes S V O).left ⟶ (wcVRes S V O).left).appTop.hom) _ = _
    rw [Scheme.Hom.id_appTop]
    rfl
  have hmerge : Functor.whiskerRight yβ (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
      Functor.whiskerLeft (wcSliceFunctor S V).op
        (Functor.whiskerRight yS (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) =
      Functor.whiskerRight yV (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
    rw [← hY]
    ext X : 2
    exact (Functor.map_comp (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) _ _).symm

  have hGen : toSheafify (Scheme.ProEt.topology V.left)
        (yoneda.obj (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) O) ⋙
          uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
      (wcLpscGen S V _ _ (wcLpscBeta S V O)).hom =
      Functor.whiskerRight yβ (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerLeft (wcSliceFunctor S V).op (toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj (wcVRes S V O) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    subst hyβ
    have e1 := (sheafificationAdjunction (Scheme.ProEt.topology V.left)
      AddCommGrpCat.{u+1}).homEquiv_unit (f := wcLpscGen S V _ _ (wcLpscBeta S V O))
    unfold wcLpscGen at e1 ⊢
    rw [Equiv.apply_symm_apply] at e1
    exact e1.symm

  have hLmap : ((wcLpscG S V).map (wcUnitTupleMap S (wcVRes S V O) ℓ d tD hℓD)).hom =
      Functor.whiskerLeft (wcSliceFunctor S V).op (sheafifyMap (Scheme.ProEt.topology S)
        (Functor.whiskerRight yS (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := by
    subst hyS
    rfl
  have hRmap : (wcUnitTupleMap V.left (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) O) ℓ d tD hℓD).hom =
      sheafifyMap (Scheme.ProEt.topology V.left)
        (Functor.whiskerRight yV (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
    subst hyV
    rfl

  have hsq : Functor.whiskerLeft (wcSliceFunctor S V).op (toSheafify (Scheme.ProEt.topology S)
          (yoneda.obj (wcVRes S V O) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
      Functor.whiskerLeft (wcSliceFunctor S V).op (sheafifyMap (Scheme.ProEt.topology S)
        (Functor.whiskerRight yS (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) =
      Functor.whiskerLeft (wcSliceFunctor S V).op
          (Functor.whiskerRight yS (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
        Functor.whiskerLeft (wcSliceFunctor S V).op
          (toSheafify (Scheme.ProEt.topology S) (wcUnitTuplePre S ℓ d)) := by
    have hnat := toSheafify_naturality (Scheme.ProEt.topology S)
      (Functor.whiskerRight yS (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    have h2 := congrArg (Functor.whiskerLeft (wcSliceFunctor S V).op) hnat
    rw [Functor.whiskerLeft_comp, Functor.whiskerLeft_comp] at h2
    exact h2.symm

  have generic : ∀ {X0 X1 X2 X3 X4 Y1 Y2 : (V.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
      (a : X0 ⟶ X1) (g : X1 ⟶ X2) (m : X2 ⟶ X3) (c : X3 ⟶ X4) (r : X1 ⟶ X4)
      (wβ : X0 ⟶ Y1) (wtZ : Y1 ⟶ X2) (n : X2 ⟶ X3) (wLα : Y1 ⟶ Y2) (wtS : Y2 ⟶ X3)
      (wV : X0 ⟶ Y2) (t2 : Y2 ⟶ X4) (s : X1 ⟶ X4),
      a ≫ g = wβ ≫ wtZ → m = n → wtZ ≫ n = wLα ≫ wtS → wβ ≫ wLα = wV →
      wtS ≫ c = t2 → r = s → wV ≫ t2 = a ≫ s → a ≫ g ≫ m ≫ c = a ≫ r := by
    intro X0 X1 X2 X3 X4 Y1 Y2 a g m c r wβ wtZ n wLα wtS wV t2 s h1 h2 h3 h4 h5 h7 h6
    rw [h2, h7]
    calc a ≫ g ≫ n ≫ c = (a ≫ g) ≫ n ≫ c := (Category.assoc _ _ _).symm
      _ = (wβ ≫ wtZ) ≫ n ≫ c := by rw [h1]
      _ = wβ ≫ (wtZ ≫ n) ≫ c := by simp only [Category.assoc]
      _ = wβ ≫ (wLα ≫ wtS) ≫ c := by rw [h3]
      _ = (wβ ≫ wLα) ≫ (wtS ≫ c) := by simp only [Category.assoc]
      _ = wV ≫ t2 := by rw [h4, h5]
      _ = a ≫ s := h6
  have hnatV := toSheafify_naturality (Scheme.ProEt.topology V.left)
    (Functor.whiskerRight yV (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
  have hfin := generic _ _ _ _ _ _ _ _ _ _ _ _ _ hGen hLmap hsq hmerge
    (hCP (wcUnitTuplePre S ℓ d)) hRmap hnatV
  apply Sheaf.hom_ext
  exact sheafify_hom_ext _ _ _ (wcUnitTuple V.left ℓ d).property hfin

theorem wc_lpsk_sheafify_ses (S : Scheme.{u}) {P₁ P₂ P₃ : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
    (f : P₁ ⟶ P₂) (g : P₂ ⟶ P₃) (w : f ≫ g = 0)
    (hinj : Presheaf.IsLocallyInjective (Scheme.ProEt.topology S) f)
    (hex : ∀ (U : S.ProEt) (x : P₂.obj (Opposite.op U)), (g.app (Opposite.op U)).hom x = 0 →
      ∃ R ∈ Scheme.ProEt.topology S U, ∀ (V : S.ProEt) (i : V ⟶ U), R.arrows i →
        ∃ y : P₁.obj (Opposite.op V), (f.app (Opposite.op V)).hom y = (P₂.map i.op).hom x)
    (hsurj : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S) g) :
    ∃ w', (ShortComplex.mk ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f)
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g) w').ShortExact :=
by
  classical

  have hιinj : ∀ W, Function.Injective ((Limits.kernel.ι g).app W).hom := by
    intro W
    have hm : Mono ((Limits.kernel.ι g).app W) :=
      (NatTrans.mono_iff_mono_app (Limits.kernel.ι g)).mp inferInstance W
    exact (AddCommGrpCat.mono_iff_injective _).mp hm
  have hb : ∀ W (y : P₁.obj W), ((Limits.kernel.ι g).app W).hom
      (((Limits.kernel.lift g f w).app W).hom y) = (f.app W).hom y := by
    intro W y
    have h := congrArg (fun φ => (φ.app W).hom y) (Limits.kernel.lift_ι g f w)
    exact h
  have hc : ∀ W (s : (Limits.kernel g).obj W),
      (g.app W).hom (((Limits.kernel.ι g).app W).hom s) = 0 := by
    intro W s
    have h := congrArg (fun φ => (φ.app W).hom s) (Limits.kernel.condition g)
    exact h
  have hk : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S)
      (Limits.kernel.lift g f w) := by
    constructor
    intro U s
    obtain ⟨R, hR, hy⟩ := hex U (((Limits.kernel.ι g).app (Opposite.op U)).hom s) (hc _ s)
    refine (Scheme.ProEt.topology S).superset_covering ?_ hR
    intro V i hi
    obtain ⟨y, hy⟩ := hy V i hi
    refine ⟨y, ?_⟩
    change ((Limits.kernel.lift g f w).app (Opposite.op V)).hom y =
      ((Limits.kernel g).map i.op).hom s
    apply hιinj
    rw [hb, hy]
    have h := congrArg (fun φ => φ.hom s) ((Limits.kernel.ι g).naturality i.op)
    simpa using h.symm

  have w' : (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f ≫
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g = 0 := by
    rw [← Functor.map_comp, w, Functor.map_zero]
  have hS₀ : (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).Exact :=
    (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).exact_of_f_is_kernel
      (Limits.kernelIsKernel g)
  have hS₀L := hS₀.map (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})

  let φ : ShortComplex.mk ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f)
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g) w' ⟶
      (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).map
        (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    { τ₁ := (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
          (Limits.kernel.lift g f w)
      τ₂ := 𝟙 _
      τ₃ := 𝟙 _
      comm₁₂ := by
        show (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
            (Limits.kernel.lift g f w) ≫
            (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
              (Limits.kernel.ι g) =
          (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f ≫ 𝟙 _
        rw [← Functor.map_comp, Limits.kernel.lift_ι, Category.comp_id]
      comm₂₃ := by
        show 𝟙 _ ≫ (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g =
          (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g ≫ 𝟙 _
        rw [Category.id_comp, Category.comp_id] }
  haveI : Sheaf.IsLocallySurjective
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift g f w)) :=
    (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
  haveI : Epi φ.τ₁ := Sheaf.epi_of_isLocallySurjective
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift g f w))
  haveI : IsIso φ.τ₂ := by dsimp [φ]; infer_instance
  haveI : Mono φ.τ₃ := by dsimp [φ]; infer_instance
  have hE := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mpr hS₀L

  haveI : Sheaf.IsLocallyInjective
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f) :=
    (Presheaf.isLocallyInjective_presheafToSheaf_map_iff _ _).mpr hinj
  haveI : Sheaf.IsLocallySurjective
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g) :=
    (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hsurj
  exact ⟨w', ShortComplex.ShortExact.mk' hE
    (Sheaf.mono_of_isLocallyInjective
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f))
    (Sheaf.epi_of_isLocallySurjective
      ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map g))⟩

theorem wc_lpsk_tensnat_app {A A' B B' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : A ⟶ A')
    (β : B ⟶ B') (R : CommRingCat.{u}) :
    (wcTensNat α β).app R = AddCommGrpCat.ofHom
      (TensorProduct.map (α.app R).hom.toIntLinearMap (β.app R).hom.toIntLinearMap).toAddMonoidHom :=
by
  have H : ∀ ⦃X Y : CommRingCat.{u}⦄ (f : X ⟶ Y),
      (wcTensFun A B).map f ≫ (AddCommGrpCat.ofHom (TensorProduct.map (α.app Y).hom.toIntLinearMap
        (β.app Y).hom.toIntLinearMap).toAddMonoidHom : (wcTensFun A B).obj Y ⟶ (wcTensFun A' B').obj Y) =
      (AddCommGrpCat.ofHom (TensorProduct.map (α.app X).hom.toIntLinearMap
        (β.app X).hom.toIntLinearMap).toAddMonoidHom : (wcTensFun A B).obj X ⟶ (wcTensFun A' B').obj X) ≫
        (wcTensFun A' B').map f := by
    intro X Y f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    change TensorProduct.map _ _ (TensorProduct.map _ _ x) =
      TensorProduct.map _ _ (TensorProduct.map _ _ x)
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a b =>
      have ha := congrArg (fun g => g.hom a) (α.naturality f)
      have hb := congrArg (fun g => g.hom b) (β.naturality f)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at ha hb
      simp only [TensorProduct.map_tmul, AddMonoidHom.coe_toIntLinearMap]
      rw [ha, hb]
    | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]
  unfold wcTensNat wcNatOf
  split
  · rfl
  · exact absurd H ‹_›

theorem wc_lpsk_ring_inj (ℓ n d k : ℕ) (R : CommRingCat.{u})
    (x : (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n))) (wcKtT.{u} (ℓ ^ n) k)).obj R) :
    ((wcTensNat (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))).app R).hom x = 0 →
    ∃ (r : ℕ) (c : Fin r → Rˣ), (r = 0 ∨ IsUnit ((ℓ : ℕ) : R)) ∧
      ∀ (R' : CommRingCat.{u}) (φ : R ⟶ R'),
        (∀ i, ∃ s : R'ˣ, s ^ (ℓ ^ n) = Units.map φ.hom.toMonoidHom (c i)) →
        ((wcTensFun (wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n))) (wcKtT.{u} (ℓ ^ n) k)).map φ).hom x = 0 :=
by
  intro hx
  refine ⟨0, Fin.elim0, Or.inl rfl, fun R' φ _ => ?_⟩
  suffices hx0 : x = 0 by rw [hx0, map_zero]

  have hTor : ∀ {M N A X : Type u} [AddCommGroup M] [AddCommGroup N] [AddCommGroup A]
      (g : M →+ N) (f : N →+ FreeAbelianGroup X),
      Function.Injective g → (∀ w, f (g w) = 0) → (∀ e, f e = 0 → ∃ w, g w = e) →
      Function.Injective (TensorProduct.map g.toIntLinearMap (LinearMap.id : A →ₗ[ℤ] A)) := by
    intro M N A X _ _ _ g f hg hfg hex
    have hsurj : Function.Surjective f.toIntLinearMap.rangeRestrict :=
      LinearMap.surjective_rangeRestrict _
    have hexact : Function.Exact g.toIntLinearMap f.toIntLinearMap.rangeRestrict := by
      intro e
      constructor
      · intro he
        have he' : f e = 0 := congrArg Subtype.val he
        obtain ⟨w, hw⟩ := hex e he'
        exact ⟨w, hw⟩
      · rintro ⟨w, rfl⟩
        apply Subtype.ext
        exact hfg w
    have hl := LinearMap.lTensor_injective_of_exact_of_flat _ hsurj g.toIntLinearMap hg hexact A
    rw [← LinearMap.rTensor_def]
    intro a b hab
    apply (TensorProduct.comm ℤ M A).injective
    apply hl
    rw [LinearMap.lTensor_comm, LinearMap.lTensor_comm, hab]

  have hFE : ∀ {F M G : Type u} [AddCommGroup F] [AddCommGroup M] [AddCommGroup G]
      [Module.Flat ℤ F] (i : M →+ G) (c : ℕ), Function.Injective i →
      (∀ g : G, c • g = 0 → ∃ w, i w = g) → (∀ w, c • i w = 0) →
      Function.Injective (LinearMap.lTensor F i.toIntLinearMap) ∧
      ∀ b : TensorProduct ℤ F G, c • b = 0 → ∃ w, LinearMap.lTensor F i.toIntLinearMap w = b := by
    intro F M G _ _ _ _ i c hi hex hci
    refine ⟨Module.Flat.lTensor_preserves_injective_linearMap _ hi, ?_⟩
    have hE : Function.Exact i.toIntLinearMap ((c : ℤ) • (LinearMap.id : G →ₗ[ℤ] G)) := by
      intro g
      simp only [LinearMap.smul_apply, LinearMap.id_apply, natCast_zsmul, Set.mem_range,
        AddMonoidHom.coe_toIntLinearMap]
      exact ⟨hex g, by rintro ⟨w, rfl⟩; exact hci w⟩
    have hT := Module.Flat.lTensor_exact F hE
    intro b hb
    have : LinearMap.lTensor F ((c : ℤ) • (LinearMap.id : G →ₗ[ℤ] G)) b = 0 := by
      rw [LinearMap.lTensor_smul, LinearMap.lTensor_id, LinearMap.smul_apply, LinearMap.id_apply,
        natCast_zsmul, hb]
    exact (hT b).mp this

  have hPb : ∀ {X Y W : AddCommGrpCat.{u}} (f : X ⟶ W) (g : Y ⟶ W) (y : ↑(Limits.pullback f g)),
      (Limits.pullback.fst f g).hom y = 0 → (Limits.pullback.snd f g).hom y = 0 → y = 0 := by
    intro X Y W f g y h1 h2
    apply Limits.Concrete.limit_ext
    rintro (_ | ⟨_ | _⟩)
    · show (Limits.limit.π (Limits.cospan f g) Limits.WalkingCospan.one).hom y =
        (Limits.limit.π (Limits.cospan f g) Limits.WalkingCospan.one).hom 0
      rw [← Limits.limit.w (Limits.cospan f g) Limits.WalkingCospan.Hom.inl, Limits.cospan_map_inl,
        map_zero, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
      change f.hom ((Limits.pullback.fst f g).hom y) = 0
      rw [h1, map_zero]
    · show (Limits.pullback.fst f g).hom y = (Limits.pullback.fst f g).hom 0
      rw [h1, map_zero]
    · show (Limits.pullback.snd f g).hom y = (Limits.pullback.snd f g).hom 0
      rw [h2, map_zero]

  have hTN : ∀ {A A' B B' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : A ⟶ A') (β : B ⟶ B')
      (S : CommRingCat.{u}), (wcTensNat α β).app S = AddCommGrpCat.ofHom
        (TensorProduct.map (α.app S).hom.toIntLinearMap (β.app S).hom.toIntLinearMap).toAddMonoidHom := by
    intro A A' B B' α β S
    have H : ∀ ⦃X Y : CommRingCat.{u}⦄ (f : X ⟶ Y),
        (wcTensFun A B).map f ≫ (AddCommGrpCat.ofHom (TensorProduct.map (α.app Y).hom.toIntLinearMap
          (β.app Y).hom.toIntLinearMap).toAddMonoidHom : (wcTensFun A B).obj Y ⟶ (wcTensFun A' B').obj Y) =
        (AddCommGrpCat.ofHom (TensorProduct.map (α.app X).hom.toIntLinearMap
          (β.app X).hom.toIntLinearMap).toAddMonoidHom : (wcTensFun A B).obj X ⟶ (wcTensFun A' B').obj X) ≫
          (wcTensFun A' B').map f := by
      intro X Y f
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      change TensorProduct.map _ _ (TensorProduct.map _ _ x) =
        TensorProduct.map _ _ (TensorProduct.map _ _ x)
      induction x using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a b =>
        have ha := congrArg (fun g => g.hom a) (α.naturality f)
        have hb := congrArg (fun g => g.hom b) (β.naturality f)
        simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at ha hb
        simp only [TensorProduct.map_tmul, AddMonoidHom.coe_toIntLinearMap]
        rw [ha, hb]
      | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]
    unfold wcTensNat wcNatOf
    split
    · rfl
    · exact absurd H ‹_›
  have hTNe : ∀ {A A' B B' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : A ⟶ A') (β : B ⟶ B')
      (S : CommRingCat.{u}) (y : TensorProduct ℤ (A.obj S) (B.obj S)),
      ((wcTensNat α β).app S).hom y =
        TensorProduct.map (α.app S).hom.toIntLinearMap (β.app S).hom.toIntLinearMap y := by
    intro A A' B B' α β S y
    rw [hTN]
    rfl
  have hsm : ∀ {M N : Type u} [AddCommGroup M] [AddCommGroup N] (a : M) (b : N) (c : ℕ),
      c • (a ⊗ₜ[ℤ] b) = a ⊗ₜ[ℤ] (c • b) :=
    fun a b c => (map_nsmul (TensorProduct.mk ℤ _ _ a) c b).symm

  have hIncl : ∀ S : CommRingCat.{u}, (wcKtIncl.{u} (ℓ ^ n)).app S =
      AddCommGrpCat.ofHom (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) S).subtype) := by
    intro S
    unfold wcKtIncl wcNatOf
    split
    · rfl
    · rename_i h
      exfalso
      apply h
      intro X Y f
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro ζ
      rfl

  have hroot0 : ∀ (S : Type u) [CommRing S] (ζ : Additive (rootsOfUnity (ℓ ^ n) S)),
      (ℓ ^ n) • (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) S).subtype ζ) = 0 := by
    intro S _ ζ
    apply Additive.toMul.injective
    rw [toMul_nsmul, toMul_zero]
    exact (mem_rootsOfUnity _ _).mp (Additive.toMul ζ).2
  have hroot : ∀ (S : CommRingCat.{u}) (ζ : ↑((wcRootsFun.{u} (ℓ ^ n)).obj S)),
      (ℓ ^ n) • ((wcKtIncl.{u} (ℓ ^ n)).app S).hom ζ = 0 := by
    intro S ζ
    rw [hIncl]
    exact hroot0 S ζ

  have Hc : (0 : wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)) ⟶ wcKtZUT.{u} ℓ d) ≫
      wcKtPsi.{u} ℓ d k =
      wcTensNat (𝟙 (wcKtZUT.{u} ℓ d)) (wcKtIncl.{u} (ℓ ^ n)) ≫
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) := by
    rw [Limits.zero_comp]
    apply NatTrans.ext
    funext S
    rw [NatTrans.app_zero, NatTrans.comp_app, NatTrans.app_nsmul, NatTrans.id_app]
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro y
    simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
      AddMonoidHom.comp_apply, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply,
      AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply]
    refine Eq.symm ?_
    have key : ∀ y : TensorProduct ℤ ((wcKtZUT.{u} ℓ d).obj S) ((wcRootsFun.{u} (ℓ ^ n)).obj S),
        (ℓ ^ n) • TensorProduct.map (NatTrans.app (𝟙 (wcKtZUT.{u} ℓ d)) S).hom.toIntLinearMap
          ((wcKtIncl.{u} (ℓ ^ n)).app S).hom.toIntLinearMap y = 0 := by
      intro y
      induction y using TensorProduct.induction_on with
      | zero => rw [map_zero, smul_zero]
      | tmul z ζ =>
        rw [TensorProduct.map_tmul, hsm]
        simp only [AddMonoidHom.coe_toIntLinearMap]
        rw [hroot, TensorProduct.tmul_zero]
      | add a b ha hb => rw [map_add, smul_add, ha, hb, add_zero]
    have hk := key y
    exact (congrArg (fun t => (ℓ ^ n) • t)
      (hTNe (𝟙 (wcKtZUT.{u} ℓ d)) (wcKtIncl.{u} (ℓ ^ n)) S y)).trans hk

  have main : ∀ ι : wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)) ⟶
      Limits.pullback (wcKtPsi.{u} ℓ d k) ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})),
      ι ≫ Limits.pullback.fst _ _ = 0 →
      ι ≫ Limits.pullback.snd _ _ = wcTensNat (𝟙 (wcKtZUT.{u} ℓ d)) (wcKtIncl.{u} (ℓ ^ n)) →
      Function.Injective (TensorProduct.map (ι.app R).hom.toIntLinearMap
        (LinearMap.id : ↑((wcKtT.{u} (ℓ ^ n) k).obj R) →ₗ[ℤ] ↑((wcKtT.{u} (ℓ ^ n) k).obj R))) := by
    intro ι h0 hsnd
    have h0R : ∀ w, ((Limits.pullback.fst (wcKtPsi.{u} ℓ d k)
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}))).app R).hom
        ((ι.app R).hom w) = 0 := by
      intro w
      have h1 := congrArg (fun φ => (φ.app R).hom w) h0
      simpa only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
        NatTrans.app_zero, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] using h1
    have hsndR : ∀ w, ((Limits.pullback.snd (wcKtPsi.{u} ℓ d k)
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}))).app R).hom
        ((ι.app R).hom w) =
        LinearMap.lTensor (FreeAbelianGroup ((wcUnitTupleFun.{u} ℓ d).obj R))
          (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) R).subtype).toIntLinearMap w := by
      intro w
      have h1 := congrArg (fun φ => (φ.app R).hom w) hsnd
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h1
      refine h1.trans ?_
      rw [hTN, hIncl]
      rfl
    have hJI : ∀ y : ↑((Limits.pullback (wcKtPsi.{u} ℓ d k)
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}))).obj R),
        ((Limits.pullback.fst (wcKtPsi.{u} ℓ d k)
          ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}))).app R).hom y = 0 →
        ((Limits.pullback.snd (wcKtPsi.{u} ℓ d k)
          ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}))).app R).hom y = 0 → y = 0 := by
      intro y h1 h2
      have e1 := congrArg (fun φ => φ.hom y) (Limits.pullbackObjIso_hom_comp_fst
        (wcKtPsi.{u} ℓ d k) ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) R)
      have e2 := congrArg (fun φ => φ.hom y) (Limits.pullbackObjIso_hom_comp_snd
        (wcKtPsi.{u} ℓ d k) ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) R)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at e1 e2
      have hp := hPb _ _ _ (e1.trans h1) (e2.trans h2)
      have e3 := congrArg (fun φ => φ.hom y) (Limits.pullbackObjIso
        (wcKtPsi.{u} ℓ d k) ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) R).hom_inv_id
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_id,
        AddMonoidHom.id_apply] at e3
      rw [← e3, hp, map_zero]

    have hi : Function.Injective (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) R).subtype) :=
      fun a b h => Additive.toMul.injective (Subtype.ext (congrArg Additive.toMul h))
    have hiex : ∀ g : Additive (R : Type u)ˣ, (ℓ ^ n) • g = 0 →
        ∃ w, MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) R).subtype w = g := by
      intro g hg
      have h' : Additive.toMul g ^ (ℓ ^ n) = 1 := by rw [← toMul_nsmul, hg, toMul_zero]
      exact ⟨Additive.ofMul ⟨Additive.toMul g, (mem_rootsOfUnity _ _).mpr h'⟩, rfl⟩
    obtain ⟨hlinj, hlex⟩ := hFE (F := FreeAbelianGroup ((wcUnitTupleFun.{u} ℓ d).obj R))
      (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) R).subtype) (ℓ ^ n) hi hiex (hroot0 R)
    have hg : Function.Injective (ι.app R).hom := by
      intro a b hab
      apply hlinj
      rw [← hsndR, ← hsndR, hab]
    have hex : ∀ e, ((Limits.pullback.fst (wcKtPsi.{u} ℓ d k)
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}))).app R).hom e = 0 →
        ∃ w, (ι.app R).hom w = e := by
      intro e he
      have hcond := congrArg (fun φ => (φ.app R).hom e)
        (Limits.pullback.condition (f := wcKtPsi.{u} ℓ d k)
          (g := (ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})))
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
        NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul, AddMonoidHom.nsmul_apply, NatTrans.id_app,
        AddCommGrpCat.hom_id, AddMonoidHom.id_apply] at hcond
      rw [he, map_zero] at hcond
      obtain ⟨w, hw⟩ : ∃ w : ↑((wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n))).obj R),
          LinearMap.lTensor (FreeAbelianGroup ((wcUnitTupleFun.{u} ℓ d).obj R))
            (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) R).subtype).toIntLinearMap w =
          ((Limits.pullback.snd (wcKtPsi.{u} ℓ d k)
            ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}))).app R).hom e :=
        hlex _ hcond.symm
      refine ⟨w, ?_⟩
      have hy := hJI ((ι.app R).hom w - e)
        (by rw [map_sub, h0R, he, sub_zero])
        (by rw [map_sub, hsndR, hw, sub_self])
      exact sub_eq_zero.mp hy
    exact hTor (A := ↑((wcKtT.{u} (ℓ ^ n) k).obj R)) (X := (wcUnitTupleFun.{u} ℓ d).obj R)
      (ι.app R).hom
      ((Limits.pullback.fst (wcKtPsi.{u} ℓ d k)
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}))).app R).hom hg h0R hex

  have keyF : ∀ (Pr : Prop) [Decidable Pr]
      (a : Pr → (wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)) ⟶
        Limits.pullback (wcKtPsi.{u} ℓ d k) ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})))),
      (∀ h, a h ≫ Limits.pullback.fst _ _ = 0) →
      (dite Pr a (fun _ => 0)) ≫ Limits.pullback.fst _ _ = 0 := by
    intro Pr _ a ha
    by_cases h : Pr
    · rw [dif_pos h]; exact ha h
    · rw [dif_neg h]; exact Limits.zero_comp
  have keyS : ∀ (Pr : Prop) [Decidable Pr]
      (a : Pr → (wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)) ⟶
        Limits.pullback (wcKtPsi.{u} ℓ d k) ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})))),
      Pr → (∀ h, a h ≫ Limits.pullback.snd _ _ =
        wcTensNat (𝟙 (wcKtZUT.{u} ℓ d)) (wcKtIncl.{u} (ℓ ^ n))) →
      (dite Pr a (fun _ => 0)) ≫ Limits.pullback.snd _ _ =
        wcTensNat (𝟙 (wcKtZUT.{u} ℓ d)) (wcKtIncl.{u} (ℓ ^ n)) := by
    intro Pr _ a hp ha
    rw [dif_pos hp]
    exact ha hp
  have h0 : wcKtIotaE.{u} ℓ n d k ≫
      (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d) = 0 := by
    classical
    exact keyF _ _ (fun h => Limits.pullback.lift_fst _ _ _)
  have hsnd : wcKtIotaE.{u} ℓ n d k ≫
      (Limits.pullback.snd _ _ : wcKtE.{u} ℓ n d k ⟶ wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}) =
      wcTensNat (𝟙 (wcKtZUT.{u} ℓ d)) (wcKtIncl.{u} (ℓ ^ n)) := by
    classical
    exact keyS _ _ Hc (fun h => Limits.pullback.lift_snd _ _ _)
  have hinj := main (wcKtIotaE.{u} ℓ n d k) h0 hsnd
  have hx' : TensorProduct.map ((wcKtIotaE.{u} ℓ n d k).app R).hom.toIntLinearMap
      (LinearMap.id : ↑((wcKtT.{u} (ℓ ^ n) k).obj R) →ₗ[ℤ] ↑((wcKtT.{u} (ℓ ^ n) k).obj R)) x = 0 := by
    rw [hTN] at hx
    exact hx
  exact hinj (hx'.trans (map_zero _).symm)

theorem wc_lpsk_ring_exact (ℓ n d k : ℕ) (R : CommRingCat.{u})
    (x : (wcTensFun (wcKtE.{u} ℓ n d k) (wcKtT.{u} (ℓ ^ n) k)).obj R) :
    ((wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
      (𝟙 (wcKtT.{u} (ℓ ^ n) k))).app R).hom x = 0 →
    ∃ (r : ℕ) (c : Fin r → Rˣ), (r = 0 ∨ IsUnit ((ℓ : ℕ) : R)) ∧
      ∀ (R' : CommRingCat.{u}) (φ : R ⟶ R'),
        (∀ i, ∃ s : R'ˣ, s ^ (ℓ ^ n) = Units.map φ.hom.toMonoidHom (c i)) →
        ∃ y, ((wcTensNat (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))).app R').hom y =
          ((wcTensFun (wcKtE.{u} ℓ n d k) (wcKtT.{u} (ℓ ^ n) k)).map φ).hom x :=
by
  classical
  intro hx

  let fstE : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d := Limits.pullback.fst _ _
  let sndE : wcKtE.{u} ℓ n d k ⟶ wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u} := Limits.pullback.snd _ _

  have hTN : ∀ {A A' B B' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : A ⟶ A') (β : B ⟶ B')
      (R₁ : CommRingCat.{u}), (wcTensNat α β).app R₁ = AddCommGrpCat.ofHom
        (TensorProduct.map (α.app R₁).hom.toIntLinearMap (β.app R₁).hom.toIntLinearMap).toAddMonoidHom := by
    intro A A' B B' α β R₁
    have hnat : ∀ ⦃X Y : CommRingCat.{u}⦄ (f : X ⟶ Y),
        (wcTensFun A B).map f ≫ (fun R => AddCommGrpCat.ofHom
          (TensorProduct.map (α.app R).hom.toIntLinearMap (β.app R).hom.toIntLinearMap).toAddMonoidHom) Y =
        (fun R => AddCommGrpCat.ofHom
          (TensorProduct.map (α.app R).hom.toIntLinearMap (β.app R).hom.toIntLinearMap).toAddMonoidHom) X ≫
          (wcTensFun A' B').map f := by
      intro X Y f
      apply AddCommGrpCat.hom_ext
      show ((TensorProduct.map (α.app Y).hom.toIntLinearMap (β.app Y).hom.toIntLinearMap) ∘ₗ
          (TensorProduct.map (A.map f).hom.toIntLinearMap (B.map f).hom.toIntLinearMap)).toAddMonoidHom =
        ((TensorProduct.map (A'.map f).hom.toIntLinearMap (B'.map f).hom.toIntLinearMap) ∘ₗ
          (TensorProduct.map (α.app X).hom.toIntLinearMap (β.app X).hom.toIntLinearMap)).toAddMonoidHom
      congr 1
      apply TensorProduct.ext'
      intro x y
      simp only [LinearMap.comp_apply, TensorProduct.map_tmul, AddMonoidHom.coe_toIntLinearMap]
      have ha := congrArg (fun g => AddCommGrpCat.Hom.hom g x) (α.naturality f)
      have hb := congrArg (fun g => AddCommGrpCat.Hom.hom g y) (β.naturality f)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at ha hb
      rw [ha, hb]
    unfold wcTensNat wcNatOf
    split_ifs with H
    · rfl
    · exact absurd hnat H
  have hidT : ∀ S : CommRingCat.{u}, ((𝟙 (wcKtT.{u} (ℓ ^ n) k)).app S).hom.toIntLinearMap =
      (LinearMap.id : ↑((wcKtT.{u} (ℓ ^ n) k).obj S) →ₗ[ℤ] ↑((wcKtT.{u} (ℓ ^ n) k).obj S)) :=
    fun S => LinearMap.ext fun _ => rfl
  have hTNx : ∀ {A A' B B' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : A ⟶ A') (β : B ⟶ B')
      (R₁ : CommRingCat.{u}) (z : ↑((wcTensFun A B).obj R₁)),
      ((wcTensNat α β).app R₁).hom z =
        TensorProduct.map (α.app R₁).hom.toIntLinearMap (β.app R₁).hom.toIntLinearMap z := by
    intro A A' B B' α β R₁ z
    first
      | exact congrArg (fun f => AddCommGrpCat.Hom.hom f z) (hTN α β R₁)
      | (rw [hTN]; rfl)

  have hcoord : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : R₁ ⟶ R₂) (t : (wcUnitTupleFun.{u} ℓ d).obj R₁),
      wcKtCoord ℓ d k R₂ ((wcUnitTupleFun.{u} ℓ d).map φ t) =
        Units.map φ.hom.toMonoidHom (wcKtCoord ℓ d k R₁ t) := by
    intro R₁ R₂ φ t
    unfold wcKtCoord
    by_cases hk : k < d
    · rw [dif_pos hk, dif_pos hk]
      rfl
    · rw [dif_neg hk, dif_neg hk, map_one]

  have hZmap : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : R₁ ⟶ R₂) (t : (wcUnitTupleFun.{u} ℓ d).obj R₁),
      ((wcKtZUT.{u} ℓ d).map φ).hom (FreeAbelianGroup.of t) =
        FreeAbelianGroup.of ((wcUnitTupleFun.{u} ℓ d).map φ t) := by
    intro R₁ R₂ φ t
    first
      | exact FreeAbelianGroup.map_of_apply _
      | (show (AddCommGrpCat.free.map ((wcUnitTupleFun.{u} ℓ d).map φ)).hom
            (FreeAbelianGroup.of t) = _
         rw [AddCommGrpCat.free_map_coe]
         first
           | exact FreeAbelianGroup.map_pure _ _
           | rfl)
      | rfl

  have hTmap : ∀ {A B : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} {R₁ R₂ : CommRingCat.{u}}
      (φ : R₁ ⟶ R₂) (a : A.obj R₁) (b : B.obj R₁),
      ((wcTensFun A B).map φ).hom (a ⊗ₜ[ℤ] b) = (A.map φ).hom a ⊗ₜ[ℤ] (B.map φ).hom b := by
    intro A B R₁ R₂ φ a b
    show (TensorProduct.map (A.map φ).hom.toIntLinearMap (B.map φ).hom.toIntLinearMap)
      (a ⊗ₜ[ℤ] b) = _
    rw [TensorProduct.map_tmul]
    rfl

  have hpsi : ∀ R₁ : CommRingCat.{u}, (wcKtPsi.{u} ℓ d k).app R₁ =
      AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun t =>
        TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R₁) (N := wcKtGm.{u}.obj R₁)
          (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k R₁ t)))) := by
    intro R₁
    have hnat : ∀ ⦃X Y : CommRingCat.{u}⦄ (f : X ⟶ Y),
        (wcKtZUT.{u} ℓ d).map f ≫ (fun R => AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun t =>
          TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R) (N := wcKtGm.{u}.obj R)
            (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k R t))))) Y =
        (fun R => AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun t =>
          TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R) (N := wcKtGm.{u}.obj R)
            (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k R t))))) X ≫
          (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}).map f := by
      intro X Y f
      apply AddCommGrpCat.hom_ext
      refine FreeAbelianGroup.lift_ext _ _ (fun t => ?_)
      show (FreeAbelianGroup.lift (fun t =>
          TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj Y) (N := wcKtGm.{u}.obj Y)
            (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k Y t))))
          (((wcKtZUT.{u} ℓ d).map f).hom (FreeAbelianGroup.of t)) =
        ((wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}).map f).hom
          ((FreeAbelianGroup.lift (fun t =>
            TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj X) (N := wcKtGm.{u}.obj X)
              (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k X t))))
            (FreeAbelianGroup.of t))
      rw [hZmap, FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
      have hG : (wcKtGm.{u}.map f).hom (Additive.ofMul (wcKtCoord ℓ d k X t) : Additive Xˣ) =
          (Additive.ofMul (wcKtCoord ℓ d k Y ((wcUnitTupleFun.{u} ℓ d).map f t)) : Additive Yˣ) := by
        rw [hcoord]
        first
          | rfl
          | (apply Additive.toMul.injective; apply Units.ext; rfl)
      exact ((hTmap (A := wcKtZUT.{u} ℓ d) (B := wcKtGm.{u}) f (FreeAbelianGroup.of t)
        (Additive.ofMul (wcKtCoord ℓ d k X t) : Additive Xˣ)).trans
        (congrArg₂ (fun (a : (wcKtZUT.{u} ℓ d).obj Y) (b : wcKtGm.{u}.obj Y) => a ⊗ₜ[ℤ] b)
          (hZmap f t) hG)).symm
    unfold wcKtPsi wcNatOf
    split_ifs with H
    · rfl
    · exact absurd hnat H

  have hlift : ∀ (R' : CommRingCat.{u}) (t : (wcUnitTupleFun.{u} ℓ d).obj R') (s : R'ˣ),
      s ^ (ℓ ^ n) = wcKtCoord ℓ d k R' t →
      ∃ e : (wcKtE.{u} ℓ n d k).obj R',
        (fstE.app R').hom e = FreeAbelianGroup.of t := by
    intro R' t s hs
    have hL : ((wcKtPsi.{u} ℓ d k).app R').hom (FreeAbelianGroup.of t) =
        TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := wcKtGm.{u}.obj R')
          (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k R' t) : Additive R'ˣ) :=
      (congrArg (fun F => AddCommGrpCat.Hom.hom F (FreeAbelianGroup.of t)) (hpsi R')).trans
        (FreeAbelianGroup.lift_apply_of _ _)
    have hR : ∀ x, (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})).app R').hom x =
        (ℓ ^ n) • x := by
      intro x
      first
        | (rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
            AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply])
        | rfl
    have e1 : (Additive.ofMul (wcKtCoord ℓ d k R' t) : Additive R'ˣ) =
        (ℓ ^ n) • (Additive.ofMul s : Additive R'ˣ) := by
      rw [← hs, ofMul_pow]
    have hS : TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := wcKtGm.{u}.obj R')
          (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k R' t) : Additive R'ˣ) =
        (ℓ ^ n) • TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := wcKtGm.{u}.obj R')
          (FreeAbelianGroup.of t) (Additive.ofMul s : Additive R'ˣ) :=
      (congrArg (fun y : wcKtGm.{u}.obj R' =>
        TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := wcKtGm.{u}.obj R')
          (FreeAbelianGroup.of t) y) e1).trans (TensorProduct.tmul_smul _ _ _)
    have h : ((wcKtPsi.{u} ℓ d k).app R').hom (FreeAbelianGroup.of t) =
        (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})).app R').hom
          (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := wcKtGm.{u}.obj R')
            (FreeAbelianGroup.of t) (Additive.ofMul s : Additive R'ˣ)) :=
      hL.trans (hS.trans (hR _).symm)
    obtain ⟨pb, hpb⟩ : ∃ pb, (Limits.pullback.fst ((wcKtPsi.{u} ℓ d k).app R')
        (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})).app R')).hom pb =
          (FreeAbelianGroup.of t : (wcKtZUT.{u} ℓ d).obj R') :=
      ⟨_, Limits.Concrete.pullbackMk_fst ((wcKtPsi.{u} ℓ d k).app R')
        (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})).app R') _ _ h⟩
    refine ⟨(Limits.pullbackObjIso (wcKtPsi.{u} ℓ d k)
      ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) R').inv.hom pb, ?_⟩
    have e2 := congrArg (fun g => AddCommGrpCat.Hom.hom g pb)
      (Limits.pullbackObjIso_inv_comp_fst (wcKtPsi.{u} ℓ d k)
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) R')
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at e2
    exact e2.trans hpb

  have hFE : ∀ {F M G : Type u} [AddCommGroup F] [AddCommGroup M] [AddCommGroup G]
      [Module.Flat ℤ F] (i : M →+ G) (c : ℕ), Function.Injective i →
      (∀ g : G, c • g = 0 → ∃ w, i w = g) → (∀ w, c • i w = 0) →
      Function.Injective (LinearMap.lTensor F i.toIntLinearMap) ∧
      ∀ b : TensorProduct ℤ F G, c • b = 0 → ∃ w, LinearMap.lTensor F i.toIntLinearMap w = b := by
    intro F M G _ _ _ _ i c hi hex hci
    refine ⟨Module.Flat.lTensor_preserves_injective_linearMap _ hi, ?_⟩
    have hE : Function.Exact i.toIntLinearMap ((c : ℤ) • (LinearMap.id : G →ₗ[ℤ] G)) := by
      intro g
      simp only [LinearMap.smul_apply, LinearMap.id_apply, natCast_zsmul, Set.mem_range,
        AddMonoidHom.coe_toIntLinearMap]
      exact ⟨hex g, by rintro ⟨w, rfl⟩; exact hci w⟩
    have hT := Module.Flat.lTensor_exact F hE
    intro b hb
    have : LinearMap.lTensor F ((c : ℤ) • (LinearMap.id : G →ₗ[ℤ] G)) b = 0 := by
      rw [LinearMap.lTensor_smul, LinearMap.lTensor_id, LinearMap.smul_apply, LinearMap.id_apply,
        natCast_zsmul, hb]
    exact (hT b).mp this

  have hPb : ∀ {X Y W : AddCommGrpCat.{u}} (f : X ⟶ W) (g : Y ⟶ W) (y : ↑(Limits.pullback f g)),
      (Limits.pullback.fst f g).hom y = 0 → (Limits.pullback.snd f g).hom y = 0 → y = 0 := by
    intro X Y W f g y h1 h2
    apply Limits.Concrete.limit_ext
    rintro (_ | ⟨_ | _⟩)
    · show (Limits.limit.π (Limits.cospan f g) Limits.WalkingCospan.one).hom y =
        (Limits.limit.π (Limits.cospan f g) Limits.WalkingCospan.one).hom 0
      rw [← Limits.limit.w (Limits.cospan f g) Limits.WalkingCospan.Hom.inl, Limits.cospan_map_inl,
        map_zero, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
      change f.hom ((Limits.pullback.fst f g).hom y) = 0
      rw [h1, map_zero]
    · show (Limits.pullback.fst f g).hom y = (Limits.pullback.fst f g).hom 0
      rw [h1, map_zero]
    · show (Limits.pullback.snd f g).hom y = (Limits.pullback.snd f g).hom 0
      rw [h2, map_zero]

  have hIncl : ∀ S : CommRingCat.{u}, (wcKtIncl.{u} (ℓ ^ n)).app S =
      AddCommGrpCat.ofHom (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) S).subtype) := by
    intro S
    unfold wcKtIncl wcNatOf
    split
    · rfl
    · rename_i h
      exfalso
      apply h
      intro X Y f
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro ζ
      rfl
  have hroot0 : ∀ (S : Type u) [CommRing S] (ζ : Additive (rootsOfUnity (ℓ ^ n) S)),
      (ℓ ^ n) • (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) S).subtype ζ) = 0 := by
    intro S _ ζ
    apply Additive.toMul.injective
    rw [toMul_nsmul, toMul_zero]
    exact (mem_rootsOfUnity _ _).mp (Additive.toMul ζ).2
  have hroot : ∀ (S : CommRingCat.{u}) (ζ : ↑((wcRootsFun.{u} (ℓ ^ n)).obj S)),
      (ℓ ^ n) • ((wcKtIncl.{u} (ℓ ^ n)).app S).hom ζ = 0 := by
    intro S ζ
    rw [hIncl]
    exact hroot0 S ζ
  have hkill : ∀ {M N G : Type u} [AddCommGroup M] [AddCommGroup N] [AddCommGroup G]
      (f : M →ₗ[ℤ] M) (g : N →ₗ[ℤ] G) (c : ℕ), (∀ ζ, c • g ζ = 0) →
      ∀ y, c • TensorProduct.map f g y = 0 := by
    intro M N G _ _ _ f g c hg y
    induction y using TensorProduct.induction_on with
    | zero => rw [map_zero, smul_zero]
    | tmul a b => rw [TensorProduct.map_tmul, ← TensorProduct.tmul_smul, hg, TensorProduct.tmul_zero]
    | add a b ha hb => rw [map_add, smul_add, ha, hb, add_zero]

  have Hc : (0 : wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)) ⟶ wcKtZUT.{u} ℓ d) ≫
      wcKtPsi.{u} ℓ d k =
      wcTensNat (𝟙 (wcKtZUT.{u} ℓ d)) (wcKtIncl.{u} (ℓ ^ n)) ≫
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) := by
    rw [Limits.zero_comp]
    apply NatTrans.ext
    funext S
    rw [NatTrans.app_zero, NatTrans.comp_app, NatTrans.app_nsmul, NatTrans.id_app]
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro y
    rw [AddCommGrpCat.hom_zero, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_nsmul,
      AddCommGrpCat.hom_id, AddMonoidHom.zero_apply, AddMonoidHom.comp_apply,
      AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, hTNx]
    refine Eq.symm (hkill _ (((wcKtIncl.{u} (ℓ ^ n)).app S).hom.toIntLinearMap) (ℓ ^ n)
      (fun ζ => hroot S ζ) y)
  have hιE : wcKtIotaE.{u} ℓ n d k = Limits.pullback.lift _ _ Hc := by
    unfold wcKtIotaE
    first
      | exact dif_pos Hc
      | (split_ifs with hh
         · rfl
         · exact absurd Hc hh)
  have hιfst : wcKtIotaE.{u} ℓ n d k ≫ fstE = 0 := by
    rw [hιE]
    exact Limits.pullback.lift_fst _ _ _
  have hsnd : wcKtIotaE.{u} ℓ n d k ≫ sndE =
      wcTensNat (𝟙 (wcKtZUT.{u} ℓ d)) (wcKtIncl.{u} (ℓ ^ n)) := by
    rw [hιE]
    exact Limits.pullback.lift_snd _ _ _

  have hexS : ∀ (S : CommRingCat.{u}) (e : ↑((wcKtE.{u} ℓ n d k).obj S)),
      (fstE.app S).hom e = 0 → ∃ w, ((wcKtIotaE.{u} ℓ n d k).app S).hom w = e := by
    intro S e he
    have h0R : ∀ w, (fstE.app S).hom (((wcKtIotaE.{u} ℓ n d k).app S).hom w) = 0 := by
      intro w
      have h1 : (fstE.app S).hom (((wcKtIotaE.{u} ℓ n d k).app S).hom w) =
          ((0 : wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)) ⟶ wcKtZUT.{u} ℓ d).app S).hom w :=
        congrArg (fun φ => (φ.app S).hom w) hιfst
      rw [h1, NatTrans.app_zero]
      first
        | rfl
        | simp
    have hsndR : ∀ w, (sndE.app S).hom (((wcKtIotaE.{u} ℓ n d k).app S).hom w) =
        LinearMap.lTensor (FreeAbelianGroup ((wcUnitTupleFun.{u} ℓ d).obj S))
          (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) S).subtype).toIntLinearMap w := by
      intro w
      have h1 : (sndE.app S).hom (((wcKtIotaE.{u} ℓ n d k).app S).hom w) =
          ((wcTensNat (𝟙 (wcKtZUT.{u} ℓ d)) (wcKtIncl.{u} (ℓ ^ n))).app S).hom w :=
        congrArg (fun φ => (φ.app S).hom w) hsnd
      rw [h1, hTNx]
      first
        | (rw [hIncl]; rfl)
        | (erw [hIncl]; rfl)
        | (simp only [hIncl]; rfl)
    have hJI : ∀ y : ↑((wcKtE.{u} ℓ n d k).obj S),
        (fstE.app S).hom y = 0 → (sndE.app S).hom y = 0 → y = 0 := by
      intro y h1 h2
      have hp := hPb ((wcKtPsi.{u} ℓ d k).app S)
        (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})).app S)
        ((Limits.pullbackObjIso (wcKtPsi.{u} ℓ d k)
          ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) S).hom.hom y)
        ((congrArg (fun φ => AddCommGrpCat.Hom.hom φ y) (Limits.pullbackObjIso_hom_comp_fst
          (wcKtPsi.{u} ℓ d k) ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) S)).trans h1)
        ((congrArg (fun φ => AddCommGrpCat.Hom.hom φ y) (Limits.pullbackObjIso_hom_comp_snd
          (wcKtPsi.{u} ℓ d k) ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) S)).trans h2)
      have e3 : (Limits.pullbackObjIso (wcKtPsi.{u} ℓ d k)
            ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) S).inv.hom
          ((Limits.pullbackObjIso (wcKtPsi.{u} ℓ d k)
            ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) S).hom.hom y) = y :=
        congrArg (fun φ => AddCommGrpCat.Hom.hom φ y) (Limits.pullbackObjIso (wcKtPsi.{u} ℓ d k)
          ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) S).hom_inv_id
      exact (e3.symm.trans (congrArg _ hp)).trans (map_zero _)
    have hi : Function.Injective (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) S).subtype) :=
      fun a b h => Additive.toMul.injective (Subtype.ext (congrArg Additive.toMul h))
    have hiex : ∀ g : Additive (S : Type u)ˣ, (ℓ ^ n) • g = 0 →
        ∃ w, MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) S).subtype w = g := by
      intro g hg
      have h' : Additive.toMul g ^ (ℓ ^ n) = 1 := by rw [← toMul_nsmul, hg, toMul_zero]
      exact ⟨Additive.ofMul ⟨Additive.toMul g, (mem_rootsOfUnity _ _).mpr h'⟩, rfl⟩
    obtain ⟨_, hlex⟩ := hFE (F := FreeAbelianGroup ((wcUnitTupleFun.{u} ℓ d).obj S))
      (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) S).subtype) (ℓ ^ n) hi hiex (hroot0 S)
    have hcond : ((wcKtPsi.{u} ℓ d k).app S).hom ((fstE.app S).hom e) =
        (ℓ ^ n) • (sndE.app S).hom e := by
      have h := congrArg (fun φ => (φ.app S).hom e)
        (Limits.pullback.condition (f := wcKtPsi.{u} ℓ d k)
          (g := (ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})))
      refine h.trans ?_
      show (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})).app S).hom ((sndE.app S).hom e) = _
      first
        | (rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
            AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply])
        | rfl
    rw [he, map_zero] at hcond
    obtain ⟨w, hw⟩ : ∃ w : ↑((wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n))).obj S),
        LinearMap.lTensor (FreeAbelianGroup ((wcUnitTupleFun.{u} ℓ d).obj S))
          (MonoidHom.toAdditive (rootsOfUnity (ℓ ^ n) S).subtype).toIntLinearMap w =
          (sndE.app S).hom e := hlex ((sndE.app S).hom e) hcond.symm
    refine ⟨w, ?_⟩
    have hy := hJI (((wcKtIotaE.{u} ℓ n d k).app S).hom w - e)
      (by rw [map_sub, he, sub_zero]; exact h0R w)
      (by rw [map_sub, sub_eq_zero]; exact (hsndR w).trans hw)
    exact sub_eq_zero.mp hy

  have hsupp : ∀ a : FreeAbelianGroup ((wcUnitTupleFun.{u} ℓ d).obj R),
      ∃ F : Finset ((wcUnitTupleFun.{u} ℓ d).obj R), ∀ (G : Type u) [AddCommGroup G]
        (g h : FreeAbelianGroup ((wcUnitTupleFun.{u} ℓ d).obj R) →+ G),
        (∀ t ∈ F, g (FreeAbelianGroup.of t) = h (FreeAbelianGroup.of t)) → g a = h a := by
    intro a
    induction a using FreeAbelianGroup.induction_on
    · exact ⟨∅, fun G _ g h _ => by rw [map_zero, map_zero]⟩
    · rename_i t
      exact ⟨{t}, fun G _ g h H => H t (Finset.mem_singleton_self t)⟩
    · rename_i t ih
      obtain ⟨F, hF⟩ := ih
      exact ⟨F, fun G _ g h H => by rw [map_neg, map_neg, hF G g h H]⟩
    · rename_i a b iha ihb
      obtain ⟨F₁, hF₁⟩ := iha
      obtain ⟨F₂, hF₂⟩ := ihb
      exact ⟨F₁ ∪ F₂, fun G _ g h H => by
        rw [map_add, map_add, hF₁ G g h (fun t ht => H t (Finset.mem_union_left _ ht)),
          hF₂ G g h (fun t ht => H t (Finset.mem_union_right _ ht))]⟩

  let P : TensorProduct ℤ ↑((wcKtE.{u} ℓ n d k).obj R) ↑((wcKtT.{u} (ℓ ^ n) k).obj R) → Prop :=
    fun z => ∃ F : Finset ((wcUnitTupleFun.{u} ℓ d).obj R), ∀ (R' : CommRingCat.{u}) (φ : R ⟶ R')
      (σ : ↑((wcKtZUT.{u} ℓ d).obj R) →+ ↑((wcKtE.{u} ℓ n d k).obj R')),
      (∀ t ∈ F, (fstE.app R').hom
          (σ (FreeAbelianGroup.of t)) = ((wcKtZUT.{u} ℓ d).map φ).hom (FreeAbelianGroup.of t)) →
      ∃ y : TensorProduct ℤ ↑((wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n))).obj R')
          ↑((wcKtT.{u} (ℓ ^ n) k).obj R'),
        TensorProduct.map ((wcKtIotaE.{u} ℓ n d k).app R').hom.toIntLinearMap LinearMap.id y =
          TensorProduct.map (((wcKtE.{u} ℓ n d k).map φ).hom -
            σ.comp (fstE.app R).hom).toIntLinearMap
            ((wcKtT.{u} (ℓ ^ n) k).map φ).hom.toIntLinearMap z
  have hP0 : P 0 := ⟨∅, fun R' φ σ _ => ⟨0, by rw [map_zero, map_zero]⟩⟩
  have hPadd : ∀ a b, P a → P b → P (a + b) := by
    rintro a b ⟨F₁, hF₁⟩ ⟨F₂, hF₂⟩
    refine ⟨F₁ ∪ F₂, fun R' φ σ hσ => ?_⟩
    obtain ⟨y₁, hy₁⟩ := hF₁ R' φ σ (fun t ht => hσ t (Finset.mem_union_left _ ht))
    obtain ⟨y₂, hy₂⟩ := hF₂ R' φ σ (fun t ht => hσ t (Finset.mem_union_right _ ht))
    exact ⟨y₁ + y₂, by rw [map_add, map_add, hy₁, hy₂]⟩
  have hPgen : ∀ (e : ↑((wcKtE.{u} ℓ n d k).obj R)) (τ : ↑((wcKtT.{u} (ℓ ^ n) k).obj R)),
      P (e ⊗ₜ[ℤ] τ) := by
    intro e τ
    obtain ⟨F, hF⟩ := hsupp
      ((fstE.app R).hom e)
    refine ⟨F, fun R' φ σ hσ => ?_⟩
    have hnat : (fstE.app R').hom
        (((wcKtE.{u} ℓ n d k).map φ).hom e) =
        ((wcKtZUT.{u} ℓ d).map φ).hom
          ((fstE.app R).hom e) := by
      first
        | exact NatTrans.naturality_apply fstE φ e
        | exact congrArg (fun g => AddCommGrpCat.Hom.hom g e) (fstE.naturality φ)
    have hagree := hF ↑((wcKtZUT.{u} ℓ d).obj R')
      ((fstE.app R').hom.comp σ)
      ((wcKtZUT.{u} ℓ d).map φ).hom hσ
    have hD : (fstE.app R').hom
        ((((wcKtE.{u} ℓ n d k).map φ).hom -
          σ.comp (fstE.app R).hom) e) =
          0 := by
      rw [AddMonoidHom.sub_apply, AddMonoidHom.comp_apply, map_sub, hnat]
      exact sub_eq_zero.mpr hagree.symm
    obtain ⟨w, hw⟩ := hexS R' _ hD
    refine ⟨w ⊗ₜ[ℤ] ((wcKtT.{u} (ℓ ^ n) k).map φ).hom τ, ?_⟩
    simp only [TensorProduct.map_tmul, AddMonoidHom.coe_toIntLinearMap, LinearMap.id_apply]
    rw [hw]
  have key : ∀ z, P z := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact hP0
    | tmul e τ => exact hPgen e τ
    | add a b ha hb => exact hPadd a b ha hb

  have hx' : TensorProduct.map (fstE.app R).hom.toIntLinearMap
      (LinearMap.id : ↑((wcKtT.{u} (ℓ ^ n) k).obj R) →ₗ[ℤ] ↑((wcKtT.{u} (ℓ ^ n) k).obj R)) x = 0 := by
    have h := (hTNx (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
      (𝟙 (wcKtT.{u} (ℓ ^ n) k)) R x).symm.trans hx
    first
      | exact h
      | (rw [hidT] at h; exact h)
      | simpa only [hidT] using h
  obtain ⟨F, hF⟩ := key x
  refine ⟨F.card, fun i => wcKtCoord ℓ d k R (F.equivFin.symm i).1, ?_, ?_⟩
  · by_cases hF0 : F = ∅
    · left
      rw [hF0, Finset.card_empty]
    · right
      obtain ⟨t, _⟩ := Finset.nonempty_iff_ne_empty.mpr hF0
      exact t.2
  · intro R' φ hroot
    have hσex : ∀ t ∈ F, ∃ e : ↑((wcKtE.{u} ℓ n d k).obj R'),
        (fstE.app R').hom e =
          ((wcKtZUT.{u} ℓ d).map φ).hom (FreeAbelianGroup.of t) := by
      intro t ht
      obtain ⟨s, hs⟩ := hroot (F.equivFin ⟨t, ht⟩)
      simp only [Equiv.symm_apply_apply] at hs
      have hs' : s ^ (ℓ ^ n) = wcKtCoord ℓ d k R' ((wcUnitTupleFun.{u} ℓ d).map φ t) := by
        rw [hcoord]
        exact hs
      obtain ⟨e, he⟩ := hlift R' _ s hs'
      exact ⟨e, he.trans (hZmap φ t).symm⟩
    choose eσ heσ using hσex
    obtain ⟨σ, hσdef⟩ : ∃ σ : ↑((wcKtZUT.{u} ℓ d).obj R) →+ ↑((wcKtE.{u} ℓ n d k).obj R'),
        ∀ t (ht : t ∈ F), σ (FreeAbelianGroup.of t) = eσ t ht :=
      ⟨FreeAbelianGroup.lift (fun t => if ht : t ∈ F then eσ t ht else 0),
        fun t ht => (FreeAbelianGroup.lift_apply_of _ _).trans (dif_pos ht)⟩
    obtain ⟨y, hy⟩ := hF R' φ σ (fun t ht => by rw [hσdef t ht]; exact heσ t ht)
    refine ⟨y, ?_⟩
    have hLin : TensorProduct.map (((wcKtE.{u} ℓ n d k).map φ).hom -
          σ.comp (fstE.app R).hom).toIntLinearMap
          ((wcKtT.{u} (ℓ ^ n) k).map φ).hom.toIntLinearMap =
        TensorProduct.map ((wcKtE.{u} ℓ n d k).map φ).hom.toIntLinearMap
            ((wcKtT.{u} (ℓ ^ n) k).map φ).hom.toIntLinearMap -
          (TensorProduct.map σ.toIntLinearMap ((wcKtT.{u} (ℓ ^ n) k).map φ).hom.toIntLinearMap) ∘ₗ
          (TensorProduct.map
            (fstE.app R).hom.toIntLinearMap
            LinearMap.id) := by
      apply TensorProduct.ext'
      intro a b
      simp only [LinearMap.sub_apply, LinearMap.comp_apply, TensorProduct.map_tmul,
        AddMonoidHom.coe_toIntLinearMap, LinearMap.id_apply, AddMonoidHom.sub_apply,
        AddMonoidHom.comp_apply, TensorProduct.sub_tmul]
    have hfin : TensorProduct.map ((wcKtE.{u} ℓ n d k).map φ).hom.toIntLinearMap
        ((wcKtT.{u} (ℓ ^ n) k).map φ).hom.toIntLinearMap x =
        TensorProduct.map ((wcKtIotaE.{u} ℓ n d k).app R').hom.toIntLinearMap LinearMap.id y := by
      have hgen : ∀ {M N P : Type u} [AddCommGroup M] [AddCommGroup N] [AddCommGroup P]
          (A : M →ₗ[ℤ] P) (B : N →ₗ[ℤ] P) (C : M →ₗ[ℤ] N) (z : M), C z = 0 →
          (A - B ∘ₗ C) z = A z := by
        intro M N P _ _ _ A B C z hz
        rw [LinearMap.sub_apply, LinearMap.comp_apply, hz, map_zero, sub_zero]
      exact ((hy.trans (LinearMap.congr_fun hLin x)).trans (hgen _ _ _ x hx')).symm
    refine (hTNx (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k)) R' y).trans ?_
    first
      | (rw [hidT]; exact hfin.symm)
      | exact hfin.symm
      | (simp only [hidT]; exact hfin.symm)

theorem wc_lpsk_ring_surj (ℓ n d k : ℕ) (R : CommRingCat.{u})
    (z : (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) k)).obj R) :
    ∃ (r : ℕ) (c : Fin r → Rˣ), (r = 0 ∨ IsUnit ((ℓ : ℕ) : R)) ∧
      ∀ (R' : CommRingCat.{u}) (φ : R ⟶ R'),
        (∀ i, ∃ s : R'ˣ, s ^ (ℓ ^ n) = Units.map φ.hom.toMonoidHom (c i)) →
        ∃ y, ((wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
          (𝟙 (wcKtT.{u} (ℓ ^ n) k))).app R').hom y =
          ((wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) k)).map φ).hom z :=
by
  classical

  have hcoord : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : R₁ ⟶ R₂) (t : (wcUnitTupleFun.{u} ℓ d).obj R₁),
      wcKtCoord ℓ d k R₂ ((wcUnitTupleFun.{u} ℓ d).map φ t) =
        Units.map φ.hom.toMonoidHom (wcKtCoord ℓ d k R₁ t) := by
    intro R₁ R₂ φ t
    unfold wcKtCoord
    by_cases hk : k < d
    · rw [dif_pos hk, dif_pos hk]
      rfl
    · rw [dif_neg hk, dif_neg hk, map_one]

  have hZmap : ∀ {R₁ R₂ : CommRingCat.{u}} (φ : R₁ ⟶ R₂) (t : (wcUnitTupleFun.{u} ℓ d).obj R₁),
      ((wcKtZUT.{u} ℓ d).map φ).hom (FreeAbelianGroup.of t) =
        FreeAbelianGroup.of ((wcUnitTupleFun.{u} ℓ d).map φ t) := by
    intro R₁ R₂ φ t
    first
      | exact FreeAbelianGroup.map_of_apply _
      | (show (AddCommGrpCat.free.map ((wcUnitTupleFun.{u} ℓ d).map φ)).hom
            (FreeAbelianGroup.of t) = _
         rw [AddCommGrpCat.free_map_coe]
         first
           | exact FreeAbelianGroup.map_pure _ _
           | rfl)
      | rfl

  have hTmap : ∀ {A B : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} {R₁ R₂ : CommRingCat.{u}}
      (φ : R₁ ⟶ R₂) (a : A.obj R₁) (b : B.obj R₁),
      ((wcTensFun A B).map φ).hom (a ⊗ₜ[ℤ] b) = (A.map φ).hom a ⊗ₜ[ℤ] (B.map φ).hom b := by
    intro A B R₁ R₂ φ a b
    show (TensorProduct.map (A.map φ).hom.toIntLinearMap (B.map φ).hom.toIntLinearMap)
      (a ⊗ₜ[ℤ] b) = _
    rw [TensorProduct.map_tmul]
    rfl

  have htm : ∀ {A A' B B' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : A ⟶ A') (β : B ⟶ B')
      (R₁ : CommRingCat.{u}) (a : A.obj R₁) (b : B.obj R₁),
      ((wcTensNat α β).app R₁).hom (a ⊗ₜ[ℤ] b) = (α.app R₁).hom a ⊗ₜ[ℤ] (β.app R₁).hom b := by
    intro A A' B B' α β R₁ a b
    have hnat : ∀ ⦃X Y : CommRingCat.{u}⦄ (f : X ⟶ Y),
        (wcTensFun A B).map f ≫ (fun R => AddCommGrpCat.ofHom
          (TensorProduct.map (α.app R).hom.toIntLinearMap (β.app R).hom.toIntLinearMap).toAddMonoidHom) Y =
        (fun R => AddCommGrpCat.ofHom
          (TensorProduct.map (α.app R).hom.toIntLinearMap (β.app R).hom.toIntLinearMap).toAddMonoidHom) X ≫
          (wcTensFun A' B').map f := by
      intro X Y f
      apply AddCommGrpCat.hom_ext
      show ((TensorProduct.map (α.app Y).hom.toIntLinearMap (β.app Y).hom.toIntLinearMap) ∘ₗ
          (TensorProduct.map (A.map f).hom.toIntLinearMap (B.map f).hom.toIntLinearMap)).toAddMonoidHom =
        ((TensorProduct.map (A'.map f).hom.toIntLinearMap (B'.map f).hom.toIntLinearMap) ∘ₗ
          (TensorProduct.map (α.app X).hom.toIntLinearMap (β.app X).hom.toIntLinearMap)).toAddMonoidHom
      congr 1
      apply TensorProduct.ext'
      intro x y
      simp only [LinearMap.comp_apply, TensorProduct.map_tmul, AddMonoidHom.coe_toIntLinearMap]
      have ha := congrArg (fun g => AddCommGrpCat.Hom.hom g x) (α.naturality f)
      have hb := congrArg (fun g => AddCommGrpCat.Hom.hom g y) (β.naturality f)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at ha hb
      rw [ha, hb]
    unfold wcTensNat wcNatOf
    split_ifs with H
    · show (TensorProduct.map (α.app R₁).hom.toIntLinearMap (β.app R₁).hom.toIntLinearMap)
        (a ⊗ₜ[ℤ] b) = _
      exact TensorProduct.map_tmul _ _ _ _
    · exact absurd hnat H

  have hpsi : ∀ R₁ : CommRingCat.{u}, (wcKtPsi.{u} ℓ d k).app R₁ =
      AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun t =>
        TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R₁) (N := wcKtGm.{u}.obj R₁)
          (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k R₁ t)))) := by
    intro R₁
    have hnat : ∀ ⦃X Y : CommRingCat.{u}⦄ (f : X ⟶ Y),
        (wcKtZUT.{u} ℓ d).map f ≫ (fun R => AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun t =>
          TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R) (N := wcKtGm.{u}.obj R)
            (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k R t))))) Y =
        (fun R => AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun t =>
          TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R) (N := wcKtGm.{u}.obj R)
            (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k R t))))) X ≫
          (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}).map f := by
      intro X Y f
      apply AddCommGrpCat.hom_ext
      refine FreeAbelianGroup.lift_ext _ _ (fun t => ?_)
      show (FreeAbelianGroup.lift (fun t =>
          TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj Y) (N := wcKtGm.{u}.obj Y)
            (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k Y t))))
          (((wcKtZUT.{u} ℓ d).map f).hom (FreeAbelianGroup.of t)) =
        ((wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}).map f).hom
          ((FreeAbelianGroup.lift (fun t =>
            TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj X) (N := wcKtGm.{u}.obj X)
              (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k X t))))
            (FreeAbelianGroup.of t))
      rw [hZmap, FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
      have hG : (wcKtGm.{u}.map f).hom (Additive.ofMul (wcKtCoord ℓ d k X t) : Additive Xˣ) =
          (Additive.ofMul (wcKtCoord ℓ d k Y ((wcUnitTupleFun.{u} ℓ d).map f t)) : Additive Yˣ) := by
        rw [hcoord]
        first
          | rfl
          | (apply Additive.toMul.injective; apply Units.ext; rfl)
      exact ((hTmap (A := wcKtZUT.{u} ℓ d) (B := wcKtGm.{u}) f (FreeAbelianGroup.of t)
        (Additive.ofMul (wcKtCoord ℓ d k X t) : Additive Xˣ)).trans
        (congrArg₂ (fun (a : (wcKtZUT.{u} ℓ d).obj Y) (b : wcKtGm.{u}.obj Y) => a ⊗ₜ[ℤ] b)
          (hZmap f t) hG)).symm
    unfold wcKtPsi wcNatOf
    split_ifs with H
    · rfl
    · exact absurd hnat H

  have hlift : ∀ (R' : CommRingCat.{u}) (t : (wcUnitTupleFun.{u} ℓ d).obj R') (s : R'ˣ),
      s ^ (ℓ ^ n) = wcKtCoord ℓ d k R' t →
      ∃ e : (wcKtE.{u} ℓ n d k).obj R',
        ((Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d).app R').hom e =
          FreeAbelianGroup.of t := by
    intro R' t s hs
    have hL : ((wcKtPsi.{u} ℓ d k).app R').hom (FreeAbelianGroup.of t) =
        TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := wcKtGm.{u}.obj R')
          (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k R' t) : Additive R'ˣ) :=
      (congrArg (fun F => AddCommGrpCat.Hom.hom F (FreeAbelianGroup.of t)) (hpsi R')).trans
        (FreeAbelianGroup.lift_apply_of _ _)
    have hR : ∀ x, (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})).app R').hom x =
        (ℓ ^ n) • x := by
      intro x
      first
        | (rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
            AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply])
        | rfl
    have e1 : (Additive.ofMul (wcKtCoord ℓ d k R' t) : Additive R'ˣ) =
        (ℓ ^ n) • (Additive.ofMul s : Additive R'ˣ) := by
      rw [← hs, ofMul_pow]
    have hS : TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := wcKtGm.{u}.obj R')
          (FreeAbelianGroup.of t) (Additive.ofMul (wcKtCoord ℓ d k R' t) : Additive R'ˣ) =
        (ℓ ^ n) • TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := wcKtGm.{u}.obj R')
          (FreeAbelianGroup.of t) (Additive.ofMul s : Additive R'ˣ) :=
      (congrArg (fun y : wcKtGm.{u}.obj R' =>
        TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := wcKtGm.{u}.obj R')
          (FreeAbelianGroup.of t) y) e1).trans (TensorProduct.tmul_smul _ _ _)
    have h : ((wcKtPsi.{u} ℓ d k).app R').hom (FreeAbelianGroup.of t) =
        (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})).app R').hom
          (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := wcKtGm.{u}.obj R')
            (FreeAbelianGroup.of t) (Additive.ofMul s : Additive R'ˣ)) :=
      hL.trans (hS.trans (hR _).symm)
    obtain ⟨pb, hpb⟩ : ∃ pb, (Limits.pullback.fst ((wcKtPsi.{u} ℓ d k).app R')
        (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})).app R')).hom pb =
          (FreeAbelianGroup.of t : (wcKtZUT.{u} ℓ d).obj R') :=
      ⟨_, Limits.Concrete.pullbackMk_fst ((wcKtPsi.{u} ℓ d k).app R')
        (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})).app R') _ _ h⟩
    refine ⟨(Limits.pullbackObjIso (wcKtPsi.{u} ℓ d k)
      ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) R').inv.hom pb, ?_⟩
    have e2 := congrArg (fun g => AddCommGrpCat.Hom.hom g pb)
      (Limits.pullbackObjIso_inv_comp_fst (wcKtPsi.{u} ℓ d k)
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})) R')
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at e2
    exact e2.trans hpb

  let P : ((wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) k)).obj R : Type u) → Prop := fun x =>
    ∃ (r : ℕ) (c : Fin r → Rˣ), (r = 0 ∨ IsUnit ((ℓ : ℕ) : R)) ∧
      ∀ (R' : CommRingCat.{u}) (φ : R ⟶ R'),
        (∀ i, ∃ s : R'ˣ, s ^ (ℓ ^ n) = Units.map φ.hom.toMonoidHom (c i)) →
        ∃ y, ((wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
          (𝟙 (wcKtT.{u} (ℓ ^ n) k))).app R').hom y =
          ((wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) k)).map φ).hom x

  have h0 : P 0 := by
    refine ⟨0, Fin.elim0, Or.inl rfl, fun R' φ _ => ⟨0, ?_⟩⟩
    rw [map_zero, map_zero]

  have hadd : ∀ x y, P x → P y → P (x + y) := by
    intro x y hx hy
    obtain ⟨r₁, c₁, h₁, H₁⟩ := hx
    obtain ⟨r₂, c₂, h₂, H₂⟩ := hy
    refine ⟨r₁ + r₂, Fin.append c₁ c₂, ?_, ?_⟩
    · rcases h₁ with h₁ | h₁
      · rcases h₂ with h₂ | h₂
        · left
          omega
        · right
          exact h₂
      · right
        exact h₁
    · intro R' φ hroot
      obtain ⟨y₁, hy₁⟩ := H₁ R' φ (fun i => by
        obtain ⟨s, hs⟩ := hroot (Fin.castAdd r₂ i)
        exact ⟨s, by rw [hs, Fin.append_left]⟩)
      obtain ⟨y₂, hy₂⟩ := H₂ R' φ (fun i => by
        obtain ⟨s, hs⟩ := hroot (Fin.natAdd r₁ i)
        exact ⟨s, by rw [hs, Fin.append_right]⟩)
      exact ⟨y₁ + y₂, by rw [map_add, map_add, hy₁, hy₂]⟩

  have hneg : ∀ x, P x → P (-x) := by
    intro x hx
    obtain ⟨r, c, h, H⟩ := hx
    refine ⟨r, c, h, fun R' φ hroot => ?_⟩
    obtain ⟨y, hy⟩ := H R' φ hroot
    exact ⟨-y, by rw [map_neg, map_neg, hy]⟩

  have hgen : ∀ (t : (wcUnitTupleFun.{u} ℓ d).obj R) (b : (wcKtT.{u} (ℓ ^ n) k).obj R),
      P ((FreeAbelianGroup.of t : (wcKtZUT.{u} ℓ d).obj R) ⊗ₜ[ℤ] b) := by
    intro t b
    refine ⟨1, fun _ => wcKtCoord ℓ d k R t, Or.inr t.2, ?_⟩
    intro R' φ hroot
    obtain ⟨s, hs⟩ := hroot 0
    have hs' : s ^ (ℓ ^ n) = wcKtCoord ℓ d k R' ((wcUnitTupleFun.{u} ℓ d).map φ t) := by
      rw [hcoord]
      exact hs
    obtain ⟨e, he⟩ := hlift R' _ s hs'
    refine ⟨e ⊗ₜ[ℤ] ((wcKtT.{u} (ℓ ^ n) k).map φ).hom b, ?_⟩
    refine (htm (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
      (𝟙 (wcKtT.{u} (ℓ ^ n) k)) R' e (((wcKtT.{u} (ℓ ^ n) k).map φ).hom b)).trans ?_
    have hid : ((𝟙 (wcKtT.{u} (ℓ ^ n) k)).app R').hom (((wcKtT.{u} (ℓ ^ n) k).map φ).hom b) =
        ((wcKtT.{u} (ℓ ^ n) k).map φ).hom b := by
      rw [NatTrans.id_app, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
    have hT2 := hTmap (A := wcKtZUT.{u} ℓ d) (B := wcKtT.{u} (ℓ ^ n) k) φ
      (FreeAbelianGroup.of t) b
    exact (congrArg₂ (fun (x : (wcKtZUT.{u} ℓ d).obj R') (y : (wcKtT.{u} (ℓ ^ n) k).obj R') =>
      TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := (wcKtT.{u} (ℓ ^ n) k).obj R') x y)
      (he.trans (hZmap φ t).symm) hid).trans hT2.symm

  have key : ∀ x : TensorProduct ℤ ((wcKtZUT.{u} ℓ d).obj R) ((wcKtT.{u} (ℓ ^ n) k).obj R),
      P x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => exact h0
    | tmul a b =>
      change FreeAbelianGroup ((wcUnitTupleFun.{u} ℓ d).obj R) at a
      induction a using FreeAbelianGroup.induction_on
      · first
          | (erw [TensorProduct.zero_tmul]; exact h0)
          | exact (congrArg P (TensorProduct.zero_tmul _ b)).mpr h0
      · rename_i t
        exact hgen t b
      · rename_i t ih
        first
          | (erw [TensorProduct.neg_tmul]; exact hneg _ ih)
          | exact (congrArg P (TensorProduct.neg_tmul _ b)).mpr (hneg _ ih)
      · rename_i x y hx hy
        first
          | (erw [TensorProduct.add_tmul]; exact hadd _ _ hx hy)
          | exact (congrArg P (TensorProduct.add_tmul _ _ b)).mpr (hadd _ _ hx hy)
    | add x y hx hy => exact hadd _ _ hx hy
  exact key z

theorem wc_lpsk_root_sieve (S : Scheme.{u}) (ℓ m : ℕ) (U : S.ProEt) (r : ℕ)
    (c : Fin r → (Γ(U.left, ⊤))ˣ) (hc : r = 0 ∨ IsUnit ((ℓ : ℕ) : Γ(U.left, ⊤))) :
    ∃ R ∈ Scheme.ProEt.topology S U, ∀ (V : S.ProEt) (g : V ⟶ U), R.arrows g →
      ∀ i, ∃ s : (Γ(V.left, ⊤))ˣ, (s : Γ(V.left, ⊤)) ^ (ℓ ^ m) = g.left.appTop.hom (c i : Γ(U.left, ⊤)) :=
by
  classical
  rcases hc with rfl | hℓ
  · exact ⟨⊤, (Scheme.ProEt.topology S).top_mem U, fun V g _ i => i.elim0⟩
  have hM : IsUnit (((ℓ ^ m : ℕ)) : Γ(U.left, ⊤)) := by
    rw [Nat.cast_pow]; exact hℓ.pow m
  by_cases h0 : ℓ ^ m = 0
  · refine ⟨⊤, (Scheme.ProEt.topology S).top_mem U, fun V g _ i => ⟨1, ?_⟩⟩
    have h01 : (0 : Γ(U.left, ⊤)) = 1 := by
      rw [h0, Nat.cast_zero] at hM
      exact isUnit_zero_iff.mp hM
    have h01' : (0 : Γ(V.left, ⊤)) = 1 := by
      have := congrArg g.left.appTop.hom h01
      rwa [map_zero, map_one] at this
    haveI := subsingleton_of_zero_eq_one h01'
    exact Subsingleton.elim _ _
  have hpos : 0 < ℓ ^ m := Nat.pos_of_ne_zero h0
  have hKumAlg : ∀ (m : ℕ), 0 < m → ∀ (R : Type u) [CommRing R], IsUnit ((m : ℕ) : R) →
      ∀ y : Rˣ, ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
        Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
        ∃ x : B, x ^ m = algebraMap R B (y : R) := by
    intro m hm R _ hmR y
    have hm0 : m ≠ 0 := Nat.pos_iff_ne_zero.mp hm
    set f : Polynomial R := Polynomial.X ^ m - Polynomial.C (y : R) with hf
    have hfm : f.Monic := Polynomial.monic_X_pow_sub_C (y : R) hm0
    obtain ⟨u, hu⟩ := (hmR.mul y.isUnit).exists_left_inv
    have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
        Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
      refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (m : R)), 1, ?_⟩
      have hd : Polynomial.derivative f = Polynomial.C (m : R) * Polynomial.X ^ (m - 1) := by
        rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero]
      have hX : Polynomial.X ^ (m - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ m :=
        pow_sub_one_mul hm0 Polynomial.X
      have hu' : Polynomial.C u * (Polynomial.C (m : R) * Polynomial.C (y : R)) = 1 := by
        rw [← map_mul, ← map_mul, hu, map_one]
      rw [hd, hf, pow_one]
      linear_combination hu' + (Polynomial.C u * Polynomial.C (m : R)) * hX
    let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
    have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
      (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
        ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
    have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
    have het : Algebra.Etale R (AdjoinRoot f) := Algebra.Etale.of_equiv e
    refine ⟨AdjoinRoot f, inferInstance, inferInstance, het, ?_, AdjoinRoot.root f, ?_⟩
    · rcases subsingleton_or_nontrivial R with hR | hR
      · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
        intro x
        exact isEmptyElim x
      · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
        let pb := AdjoinRoot.powerBasis' hfm
        have hdim : 0 < pb.dim := by
          rw [AdjoinRoot.powerBasis'_dim, hf, Polynomial.natDegree_X_pow_sub_C]
          exact hm
        have : Nontrivial (AdjoinRoot f) := nontrivial_of_ne _ _ (pb.basis.ne_zero ⟨0, hdim⟩)
        exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
    · have h1 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
        rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
      rw [hf, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h1
      exact sub_eq_zero.mp h1
  have hLRC : ∀ (S : Scheme.{u}) (m : ℕ) (_hm : 0 < m)
      (_hKum : ∀ (R : Type u) [CommRing R], IsUnit ((m : ℕ) : R) → ∀ y : Rˣ,
        ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
          Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
          ∃ x : B, x ^ m = algebraMap R B (y : R))
      (U : S.ProEt), IsUnit ((m : ℕ) : Γ(U.left, ⊤)) → ∀ (y : (Γ(U.left, ⊤))ˣ),
      ∃ (V : S.ProEt) (g : V ⟶ U) (x : (Γ(V.left, ⊤))ˣ),
        Sieve.generate (Presieve.singleton g) ∈ Scheme.ProEt.topology S U ∧
        (x : Γ(V.left, ⊤)) ^ m = g.left.appTop.hom (y : Γ(U.left, ⊤)) := by
    intro S m hm hKum U hmR y
    have hm0 : m ≠ 0 := Nat.pos_iff_ne_zero.mp hm
    obtain ⟨B, _, _, hBet, hBsurj, x', hx'⟩ := hKum Γ(U.left, ⊤) hmR y
    let φ : CommRingCat.of Γ(U.left, ⊤) ⟶ CommRingCat.of B :=
      CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) B)
    let gS : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of Γ(U.left, ⊤)) := Spec.map φ
    haveI hg : Etale gS := by
      apply (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
      rw [CommRingCat.hom_ofHom]
      exact RingHom.etale_algebraMap.mpr hBet
    haveI hgs : Surjective gS := by
      constructor
      exact hBsurj
    haveI hgq : QuasiCompact gS := inferInstance
    let p := Limits.pullback.fst U.left.toSpecΓ gS
    let q := Limits.pullback.snd U.left.toSpecΓ gS
    haveI hpe : Etale p := inferInstance
    haveI hps : Surjective p := inferInstance
    haveI hpq : QuasiCompact p := inferInstance
    have hW : WeaklyEtale (p ≫ U.hom) :=
      @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        _ _ _ p U.hom (etale_le_weaklyEtale _ _ _ hpe) U.prop
    let V : S.ProEt := MorphismProperty.Over.mk ⊤ (p ≫ U.hom) hW
    let g : V ⟶ U := MorphismProperty.Over.homMk p rfl trivial
    have hcov : Sieve.generate (Presieve.singleton g) ∈ Scheme.ProEt.topology S U := by
      apply Precoverage.generate_mem_toGrothendieck
      change Presieve.singleton g ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_singleton]
      exact Scheme.Hom.singleton_mem_propQCPrecoverage (P := @WeaklyEtale) (f := p)
        (etale_le_weaklyEtale _ _ _ hpe)
    have hc : U.left.toSpecΓ.appTop ≫ p.appTop = gS.appTop ≫ q.appTop := by
      rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
    have hn := Scheme.ΓSpecIso_inv_naturality φ
    have key : φ ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop = p.appTop := by
      rw [← Category.assoc, hn, Category.assoc, ← hc, Scheme.toSpecΓ_appTop]
      exact Iso.inv_hom_id_assoc _ _
    have hkey : ∀ r : Γ(U.left, ⊤), q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
        (algebraMap Γ(U.left, ⊤) B r)) = p.appTop.hom r :=
      fun r => congrArg (fun h => h.hom r) key
    let x0 : Γ(V.left, ⊤) := q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom x')
    have hx0 : x0 ^ m = g.left.appTop.hom (y : Γ(U.left, ⊤)) := by
      change (q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom x')) ^ m =
        p.appTop.hom (y : Γ(U.left, ⊤))
      rw [← map_pow, ← map_pow, hx', hkey]
    have hu : IsUnit x0 := by
      have h1 : IsUnit (x0 ^ m) := by rw [hx0]; exact y.isUnit.map _
      exact (isUnit_pow_iff hm0).mp h1
    exact ⟨V, g, hu.unit, hcov, by rw [IsUnit.unit_spec]; exact hx0⟩
  have hcov := hLRC S (ℓ ^ m) hpos (hKumAlg (ℓ ^ m) hpos) U hM
  have htrans : ∀ (V₂ : S.ProEt) (g₂ : V₂ ⟶ U) (x : (Γ(V₂.left, ⊤))ˣ) (y : (Γ(U.left, ⊤))ˣ),
      (x : Γ(V₂.left, ⊤)) ^ (ℓ ^ m) = g₂.left.appTop.hom (y : Γ(U.left, ⊤)) →
      ∀ (V : S.ProEt) (g : V ⟶ U), (Sieve.generate (Presieve.singleton g₂)).arrows g →
        ∃ s : (Γ(V.left, ⊤))ˣ, (s : Γ(V.left, ⊤)) ^ (ℓ ^ m) =
          g.left.appTop.hom (y : Γ(U.left, ⊤)) := by
    intro V₂ g₂ x y hx V g hg
    rw [Sieve.generate_apply] at hg
    obtain ⟨Y, h, g', hg', rfl⟩ := hg
    cases hg'
    refine ⟨Units.map h.left.appTop.hom.toMonoidHom x, ?_⟩
    have e1 : ((Units.map h.left.appTop.hom.toMonoidHom x : _ˣ) : _) =
        h.left.appTop.hom (x : _) := rfl
    have hcomp : (h ≫ g₂).left = h.left ≫ g₂.left := by
      first
        | rfl
        | simp
    rw [e1, ← map_pow, hx, hcomp, Scheme.Hom.comp_appTop]
    rfl
  have key : ∀ (r' : ℕ) (c' : Fin r' → (Γ(U.left, ⊤))ˣ), ∃ R ∈ Scheme.ProEt.topology S U,
      ∀ (V : S.ProEt) (g : V ⟶ U), R.arrows g →
        ∀ i, ∃ s : (Γ(V.left, ⊤))ˣ, (s : Γ(V.left, ⊤)) ^ (ℓ ^ m) =
          g.left.appTop.hom (c' i : Γ(U.left, ⊤)) := by
    intro r'
    induction r' with
    | zero =>
      intro c'
      exact ⟨⊤, (Scheme.ProEt.topology S).top_mem U, fun V g _ i => i.elim0⟩
    | succ r' ih =>
      intro c'
      obtain ⟨R₁, hR₁, h₁⟩ := ih (fun j => c' j.castSucc)
      obtain ⟨V₂, g₂, x₂, hR₂, hx₂⟩ := hcov (c' (Fin.last r'))
      refine ⟨R₁ ⊓ Sieve.generate (Presieve.singleton g₂),
        (Scheme.ProEt.topology S).intersection_covering hR₁ hR₂, fun V g hg i => ?_⟩
      obtain ⟨hg₁, hg₂⟩ := (Sieve.inter_apply _).mp hg
      induction i using Fin.lastCases with
      | last => exact htrans V₂ g₂ x₂ _ hx₂ V g hg₂
      | cast j => exact h₁ V g hg₁ j
  exact key r c

theorem wc_lpsc_kummer_ses (S : Scheme.{u}) (ℓ n d k : ℕ) :
    ∃ w, (ShortComplex.mk
      (wcKtShMap S (wcTensNat (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
      (wcKtShMap S (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
        (𝟙 (wcKtT.{u} (ℓ ^ n) k)))) w).ShortExact :=
by
  classical

  have hιE : wcKtIotaE.{u} ℓ n d k ≫
      (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d) = 0 := by
    have key : ∀ (P : Prop) [Decidable P]
        (a : P → (wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)) ⟶
          Limits.pullback (wcKtPsi.{u} ℓ d k) ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u})))),
        (∀ h, a h ≫ Limits.pullback.fst _ _ = 0) →
        (dite P a (fun _ => 0)) ≫ Limits.pullback.fst _ _ = 0 := by
      intro P _ a ha
      by_cases h : P
      · rw [dif_pos h]; exact ha h
      · rw [dif_neg h]; exact Limits.zero_comp
    exact key _ _ (fun h => Limits.pullback.lift_fst _ _ _)

  have htm : ∀ {A A' B B' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : A ⟶ A') (β : B ⟶ B')
      (R : CommRingCat.{u}) (a : A.obj R) (b : B.obj R),
      ((wcTensNat α β).app R).hom (a ⊗ₜ[ℤ] b) = (α.app R).hom a ⊗ₜ[ℤ] (β.app R).hom b := by
    intro A A' B B' α β R a b
    rw [wc_lpsk_tensnat_app]
    first
      | rfl
      | simp
  have hel : ∀ (R : CommRingCat.{u})
      (x : TensorProduct ℤ ((wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n))).obj R)
        ((wcKtT.{u} (ℓ ^ n) k).obj R)),
      ((wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
        (𝟙 (wcKtT.{u} (ℓ ^ n) k))).app R).hom
        (((wcTensNat (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))).app R).hom x) = 0 := by
    intro R x
    induction x using TensorProduct.induction_on with
    | zero =>
      erw [map_zero, map_zero]
      all_goals rfl
    | tmul a b =>
      have hh := congrArg (fun φ => (φ.app R).hom a) hιE
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
        NatTrans.app_zero, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at hh
      erw [htm, htm, hh, TensorProduct.zero_tmul]
      all_goals rfl
    | add x y hx hy =>
      erw [map_add, map_add, hx, hy, add_zero]
      all_goals rfl

  have hw : Functor.whiskerLeft ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcTensNat (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k)))
          AddCommGrpCat.uliftFunctor.{u+1, u}) ≫
      Functor.whiskerLeft ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
          (𝟙 (wcKtT.{u} (ℓ ^ n) k))) AddCommGrpCat.uliftFunctor.{u+1, u}) = 0 := by
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    exact congrArg ULift.up (hel _ x.down)
  refine wc_lpsk_sheafify_ses S _ _ hw ?_ ?_ ?_
  ·
    constructor
    intro X x y hxy
    have hz : ((wcTensNat (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))).app
        (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ).obj X)).hom
          (x.down - y.down) = 0 := by
      rw [map_sub, sub_eq_zero]
      exact congrArg ULift.down hxy
    obtain ⟨r, c, hrc, hφ⟩ := wc_lpsk_ring_inj ℓ n d k _ (x.down - y.down) hz
    obtain ⟨R, hR, hroots⟩ := wc_lpsk_root_sieve S ℓ n X.unop r c hrc
    refine (Scheme.ProEt.topology S).superset_covering ?_ hR
    intro V i hi
    have h0 := hφ _ (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ).map i.op)
      (fun j => by
        obtain ⟨s, hs⟩ := hroots V i hi j
        exact ⟨s, Units.ext ((Units.val_pow_eq_pow_val _ _).trans hs)⟩)
    rw [map_sub, sub_eq_zero] at h0
    apply ULift.ext
    exact h0
  ·
    intro U x hx
    have hz : ((wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
        (𝟙 (wcKtT.{u} (ℓ ^ n) k))).app
        (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ).obj (Opposite.op U))).hom
          x.down = 0 :=
      congrArg ULift.down hx
    obtain ⟨r, c, hrc, hφ⟩ := wc_lpsk_ring_exact ℓ n d k _ x.down hz
    obtain ⟨R, hR, hroots⟩ := wc_lpsk_root_sieve S ℓ n U r c hrc
    refine ⟨R, hR, fun V i hi => ?_⟩
    obtain ⟨y, hy⟩ := hφ _ (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ).map i.op)
      (fun j => by
        obtain ⟨s, hs⟩ := hroots V i hi j
        exact ⟨s, Units.ext ((Units.val_pow_eq_pow_val _ _).trans hs)⟩)
    exact ⟨ULift.up y, ULift.ext _ _ hy⟩
  ·
    constructor
    intro U z
    obtain ⟨r, c, hrc, hφ⟩ := wc_lpsk_ring_surj ℓ n d k _ z.down
    obtain ⟨R, hR, hroots⟩ := wc_lpsk_root_sieve S ℓ n U r c hrc
    refine (Scheme.ProEt.topology S).superset_covering ?_ hR
    intro V i hi
    obtain ⟨y, hy⟩ := hφ _ (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ).map i.op)
      (fun j => by
        obtain ⟨s, hs⟩ := hroots V i hi j
        exact ⟨s, Units.ext ((Units.val_pow_eq_pow_val _ _).trans hs)⟩)
    exact ⟨ULift.up y, ULift.ext _ _ hy⟩

theorem wc_lpsc_nu_slice (S : Scheme.{u}) (V : S.ProEt) (ℓ n d : ℕ) :
    Functor.whiskerLeft (wcSliceFunctor S V).op (wcKtNu S ℓ n d) = wcKtNu V.left ℓ n d :=
by
  have key : ∀ (R R' : CommRingCat.{u}) (φ : R ⟶ R') (y : (wcUnitTupleFun.{u} ℓ d).obj R),
      ((wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) 0)).map φ).hom
        (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
          (FreeAbelianGroup.of y)
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) =
      TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := (wcKtT.{u} (ℓ ^ n) 0).obj R')
          (FreeAbelianGroup.of ((wcUnitTupleFun.{u} ℓ d).map φ y))
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0)) := by
    intro R R' φ y
    have h0 : ∀ (A : Type u) [AddCommGroup A] (g : Fin 0 → A),
        (PiTensorProduct.tprod ℤ g : PiTensorProduct ℤ (fun _ : Fin 0 => A)) =
          PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0) :=
      fun A _ g => congrArg _ (funext fun i => i.elim0)
    show TensorProduct.map ((wcKtZUT.{u} ℓ d).map φ).hom.toIntLinearMap
        ((wcKtT.{u} (ℓ ^ n) 0).map φ).hom.toIntLinearMap
        (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
          (FreeAbelianGroup.of y)
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) = _
    refine (TensorProduct.map_tmul (R := ℤ) _ _ _ _).trans ?_
    congr 1
    all_goals first
      | exact FreeAbelianGroup.map_of_apply y
      | exact FreeAbelianGroup.map_of_apply _
      | (refine (LinearMap.lTensor_tmul _ _ _ _).trans ?_
         exact congrArg _ ((PiTensorProduct.map_tprod _ _).trans (h0 _ _)))
  have key2 : ∀ (R R' : CommRingCat.{u}) (φ : R ⟶ R'),
      (wcUnitTupleFun.{u} ℓ d ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map φ ≫
        (AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun x : ULift.{u+1} ((wcUnitTupleFun.{u} ℓ d).obj R') =>
            (ULift.up (TensorProduct.tmul ℤ
              (M := (wcKtZUT.{u} ℓ d).obj R') (N := (wcKtT.{u} (ℓ ^ n) 0).obj R')
              (FreeAbelianGroup.of x.down)
              ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
              ULift.{u+1} _))) :
          (wcUnitTupleFun.{u} ℓ d ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj R' ⟶
            (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) 0) ⋙
              AddCommGrpCat.uliftFunctor.{u+1, u}).obj R') =
      (AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun x : ULift.{u+1} ((wcUnitTupleFun.{u} ℓ d).obj R) =>
            (ULift.up (TensorProduct.tmul ℤ
              (M := (wcKtZUT.{u} ℓ d).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
              (FreeAbelianGroup.of x.down)
              ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
              ULift.{u+1} _))) :
          (wcUnitTupleFun.{u} ℓ d ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj R ⟶
            (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) 0) ⋙
              AddCommGrpCat.uliftFunctor.{u+1, u}).obj R) ≫
        (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) 0) ⋙
          AddCommGrpCat.uliftFunctor.{u+1, u}).map φ := by
    intro R R' φ
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro x
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom,
      Functor.comp_map, AddCommGrpCat.free_map, FreeAbelianGroup.map_of_apply,
      FreeAbelianGroup.lift_apply_of]
    apply ULift.ext
    exact (key R R' φ x.down).symm
  unfold wcKtNu wcNatOf
  split_ifs with h1 h2 h2
  · apply NatTrans.ext
    funext W
    rfl
  all_goals exfalso
  all_goals first | apply h1 | apply h2
  all_goals intro W W' f
  all_goals exact key2 _ _ _

theorem wc_lpsc_kum_transfer (S : Scheme.{u}) (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor S V).IsCocontinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    [(wcLpscG S V).Additive] [Limits.PreservesFiniteLimits (wcLpscG S V)]
    [Limits.PreservesFiniteColimits (wcLpscG S V)] (ℓ n d : ℕ) :
    (Abelian.Ext.mapExactFunctor (wcLpscG S V) (wcKumTuple S ℓ n d)).comp
        (Abelian.Ext.mk₀ (wcLpscCP S V (wcRootTwistPre S (ℓ ^ n) d)).inv) (add_zero d) =
      (Abelian.Ext.mk₀ (wcLpscCP S V (wcUnitTuplePre S ℓ d)).inv).comp
        (wcKumTuple V.left ℓ n d) (zero_add d) :=
by
  classical

  have hCPinv : ∀ {P P' : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : P ⟶ P'),
      (wcLpscG S V).map ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map α) ≫
          (wcLpscCP S V P').inv =
        (wcLpscCP S V P).inv ≫ (presheafToSheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcSliceFunctor S V).op α) :=
    fun α => ((wcSliceFunctor S V).pushforwardContinuousSheafificationCompatibility AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).inv.naturality α
  have hCPhom : ∀ {P P' : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : P ⟶ P'),
      (presheafToSheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcSliceFunctor S V).op α) ≫ (wcLpscCP S V P').hom =
        (wcLpscCP S V P).hom ≫
          (wcLpscG S V).map ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map α) :=
    fun α => ((wcSliceFunctor S V).pushforwardContinuousSheafificationCompatibility AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).hom.naturality α

  have hcomp : ∀ {AS BS CS : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      {AV BV CV : Sheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}}
      (eA : AV ≅ (wcLpscG S V).obj AS) (eB : BV ≅ (wcLpscG S V).obj BS)
      (eC : CV ≅ (wcLpscG S V).obj CS) {a b c : ℕ} (h : a + b = c)
      (αS : Abelian.Ext AS BS a) (βS : Abelian.Ext BS CS b)
      (αV : Abelian.Ext AV BV a) (βV : Abelian.Ext BV CV b),
      (Abelian.Ext.mapExactFunctor (wcLpscG S V) αS).comp (Abelian.Ext.mk₀ eB.inv) (add_zero a) =
          (Abelian.Ext.mk₀ eA.inv).comp αV (zero_add a) →
      (Abelian.Ext.mapExactFunctor (wcLpscG S V) βS).comp (Abelian.Ext.mk₀ eC.inv) (add_zero b) =
          (Abelian.Ext.mk₀ eB.inv).comp βV (zero_add b) →
      (Abelian.Ext.mapExactFunctor (wcLpscG S V) (αS.comp βS h)).comp (Abelian.Ext.mk₀ eC.inv)
          (add_zero c) =
        (Abelian.Ext.mk₀ eA.inv).comp (αV.comp βV h) (zero_add c) := by
    intro AS BS CS AV BV CV eA eB eC a b c h αS βS αV βV hα hβ
    rw [Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.comp_assoc _ _ _ h (add_zero b) (by omega : a + b + 0 = c), hβ,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero a) (zero_add b) (by omega : a + 0 + b = c), hα,
      Abelian.Ext.comp_assoc _ _ _ (zero_add a) h (by omega : 0 + a + b = c)]

  have hmk : ∀ {AS BS : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      {AV BV : Sheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}}
      (eA : AV ≅ (wcLpscG S V).obj AS) (eB : BV ≅ (wcLpscG S V).obj BS)
      (fS : AS ⟶ BS) (fV : AV ⟶ BV),
      (wcLpscG S V).map fS ≫ eB.inv = eA.inv ≫ fV →
      (Abelian.Ext.mapExactFunctor (wcLpscG S V) (Abelian.Ext.mk₀ fS)).comp
          (Abelian.Ext.mk₀ eB.inv) (add_zero 0) =
        (Abelian.Ext.mk₀ eA.inv).comp (Abelian.Ext.mk₀ fV) (zero_add 0) := by
    intro AS BS AV BV eA eB fS fV h
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, h]

  have hEOM : ∀ {A B E : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : A ⟶ B)
      (g : B ⟶ E) (w : f ≫ g = 0) (_hS : (ShortComplex.mk f g w).ShortExact)
      {A' B' E' : Sheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}} (f' : A' ⟶ B')
      (g' : B' ⟶ E') (a : A' ≅ (wcLpscG S V).obj A) (b : B' ≅ (wcLpscG S V).obj B)
      (c : E' ≅ (wcLpscG S V).obj E)
      (_hf : f' ≫ b.hom = a.hom ≫ (wcLpscG S V).map f)
      (_hg : g' ≫ c.hom = b.hom ≫ (wcLpscG S V).map g),
      (Abelian.Ext.mapExactFunctor (wcLpscG S V) (wcExtOfMaps f g)).comp
          (Abelian.Ext.mk₀ a.inv) (add_zero 1) =
        (Abelian.Ext.mk₀ c.inv).comp (wcExtOfMaps f' g') (zero_add 1) := by
    intro A B E f g w hS A' B' E' f' g' a b c hf hg
    have w' : f' ≫ g' = 0 := by
      rw [← cancel_mono c.hom, Category.assoc, hg, ← Category.assoc, hf, Category.assoc,
        ← Functor.map_comp, w, Functor.map_zero, Limits.comp_zero, Limits.zero_comp]
    have hΦ : ((ShortComplex.mk f g w).map (wcLpscG S V)).ShortExact :=
      hS.map_of_exact (wcLpscG S V)
    have h₂ : (ShortComplex.mk f' g' w').ShortExact :=
      ShortComplex.shortExact_of_iso (ShortComplex.isoMk a b c hf.symm hg.symm).symm hΦ
    have e1 : wcExtOfMaps f g = hS.extClass := by
      unfold wcExtOfMaps
      rw [dif_pos w]
      exact dif_pos hS
    have e2 : wcExtOfMaps f' g' = h₂.extClass := by
      unfold wcExtOfMaps
      rw [dif_pos w']
      exact dif_pos h₂
    let φ : (ShortComplex.mk f g w).map (wcLpscG S V) ⟶ ShortComplex.mk f' g' w' :=
      { τ₁ := a.inv
        τ₂ := b.inv
        τ₃ := c.inv
        comm₁₂ := by
          show a.inv ≫ f' = (wcLpscG S V).map f ≫ b.inv
          rw [Iso.eq_comp_inv, Category.assoc, hf, Iso.inv_hom_id_assoc]
        comm₂₃ := by
          show b.inv ≫ g' = (wcLpscG S V).map g ≫ c.inv
          rw [Iso.eq_comp_inv, Category.assoc, hg, Iso.inv_hom_id_assoc] }
    have key := hΦ.extClass_naturality h₂ φ
    rw [e1, e2, Abelian.Ext.mapExactFunctor_extClass]
    exact key

  have hstep : ∀ k : ℕ,
      (Abelian.Ext.mapExactFunctor (wcLpscG S V) (wcKtStep S ℓ n d k)).comp
          (Abelian.Ext.mk₀ (wcLpscCP S V
            (wcKtPre S (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) (k + 1))))).inv) (add_zero 1) =
        (Abelian.Ext.mk₀ (wcLpscCP S V
            (wcKtPre S (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) k)))).inv).comp
          (wcKtStep V.left ℓ n d k) (zero_add 1) := by
    intro k
    obtain ⟨w, hS⟩ := wc_lpsc_kummer_ses S ℓ n d k
    have hext := hEOM _ _ w hS
      (wcKtShMap V.left (wcTensNat (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
      (wcKtShMap V.left (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
        (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
      (wcLpscCP S V (wcKtPre S (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)))
        (wcKtT.{u} (ℓ ^ n) k))))
      (wcLpscCP S V (wcKtPre S (wcTensFun (wcKtE.{u} ℓ n d k) (wcKtT.{u} (ℓ ^ n) k))))
      (wcLpscCP S V (wcKtPre S (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) k))))
      (hCPhom (Functor.whiskerLeft ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcTensNat (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k)))
          AddCommGrpCat.uliftFunctor.{u+1, u})))
      (hCPhom (Functor.whiskerLeft ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
          (𝟙 (wcKtT.{u} (ℓ ^ n) k))) AddCommGrpCat.uliftFunctor.{u+1, u})))
    have hrho := hmk
      (wcLpscCP S V (wcKtPre S (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)))
        (wcKtT.{u} (ℓ ^ n) k))))
      (wcLpscCP S V (wcKtPre S (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) (k + 1)))))
      (wcKtShMap S (wcKtRho.{u} ℓ n d k)) (wcKtShMap V.left (wcKtRho.{u} ℓ n d k))
      (hCPinv (Functor.whiskerLeft ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcKtRho.{u} ℓ n d k) AddCommGrpCat.uliftFunctor.{u+1, u})))
    unfold wcKtStep
    exact hcomp _ _ _ (add_zero 1) _ _ _ _ hext hrho

  have hchain : ∀ k : ℕ,
      (Abelian.Ext.mapExactFunctor (wcLpscG S V) (wcKtChain S ℓ n d k)).comp
          (Abelian.Ext.mk₀ (wcLpscCP S V
            (wcKtPre S (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) k)))).inv) (add_zero k) =
        (Abelian.Ext.mk₀ (wcLpscCP S V
            (wcKtPre S (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) 0)))).inv).comp
          (wcKtChain V.left ℓ n d k) (zero_add k) := by
    intro k
    induction k with
    | zero =>
      exact hmk _ _ (𝟙 _) (𝟙 _) (by
        first
          | rw [CategoryTheory.Functor.map_id, Category.id_comp, Category.comp_id]
          | simp)
    | succ k ih =>
      exact hcomp _ _ _ rfl _ _ _ _ ih (hstep k)

  have hnu := hCPinv (wcKtNu S ℓ n d)
  rw [wc_lpsc_nu_slice S V ℓ n d] at hnu
  have heps := hCPinv (P := wcKtPre S (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) d)))
    (P' := wcRootTwistPre S (ℓ ^ n) d)
    (Functor.whiskerLeft ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ)
      (Functor.whiskerRight (wcKtEps.{u} ℓ n d) AddCommGrpCat.uliftFunctor.{u+1, u}))
  unfold wcKumTuple
  exact hcomp _ _ _ (zero_add d) _ _ _ _ (hmk _ _ _ _ hnu)
    (hcomp _ _ _ (add_zero d) _ _ _ _ (hchain d) (hmk _ _ _ _ heps))

theorem wc_lpkt_slice_compat (S : Scheme.{u}) (V : S.ProEt) (d : ℕ) (fV : Fin d → Γ(V.left, ⊤))
    (ℓ n : ℕ) (hT : ⊤ ≤ wcKOpen V.left fV (d - 1 + 1) (d - 1 + 1)) :
    wcSymNZ S V fV ℓ n hT ↔ wcSymNZ V.left (Scheme.ProEt.mk (𝟙 V.left)) fV ℓ n hT :=
by
  classical
  obtain ⟨hc, hcc, hadd, hlim, hcolim⟩ := wc_lpsc_site S V
  haveI := hc
  haveI := hcc
  haveI := hadd
  haveI := hlim
  haveI := hcolim
  have hPsi : ∀ {W : V.left.ProEt} {Z : S.ProEt} (β : (wcSliceFunctor S V).obj W ⟶ Z) (q : ℕ)
      (y : Abelian.Ext (wcFreeSheaf S Z) (wcRootTwist S (ℓ ^ n) d) q),
      wcLpscPsi S V (ℓ ^ n) d β q y =
        ((Abelian.Ext.mk₀ (wcLpscGen S V W Z β)).comp
          (Abelian.Ext.mapExactFunctor (wcLpscG S V) y) (zero_add q)).comp
          (Abelian.Ext.mk₀ (wcLpscCP S V (wcRootTwistPre S (ℓ ^ n) d)).inv) (add_zero q) :=
    fun _ _ _ => rfl
  have hLE : ∀ {O O' : V.left.Opens} (h : O ≤ O'),
      wcFreeSheafMap V.left (wcVResLE V.left (Scheme.ProEt.mk (𝟙 V.left)) h) ≫
          wcLpscGen S V _ _ (wcLpscBeta S V O') =
        wcLpscGen S V _ _ (wcLpscBeta S V O) ≫ (wcLpscG S V).map (wcFreeSheafMap S (wcVResLE S V h)) :=
    fun h => wc_lpsc_gen_nat S V _ _ _ _
      (MorphismProperty.Over.Hom.ext ((Category.comp_id _).trans (Category.id_comp _).symm))
  have hcup : ∀ t : ℕ, wcKOpen V.left fV (t + 1 + 1) (t + 1) ⊔ wcKOpen V.left fV (t + 1) (t + 1 + 1) =
      wcKOpen V.left fV (t + 1 + 1) (t + 1 + 1) := by
    intro t
    apply le_antisymm
    · intro x hx
      rcases TopologicalSpace.Opens.mem_sup.1 hx with ⟨h1, i, hi, h2⟩ | ⟨h1, i, hi, h2⟩
      · exact ⟨h1, i, by omega, h2⟩
      · exact ⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩
    · rintro x ⟨h1, i, hi, h2⟩
      apply TopologicalSpace.Opens.mem_sup.2
      by_cases hx : ∀ i' : Fin d, t + 1 ≤ i'.val → x ∈ V.left.basicOpen (fV i')
      · exact Or.inr ⟨hx, i, hi, h2⟩
      · left
        refine ⟨h1, i, ?_, h2⟩
        by_contra hne
        apply hx
        intro i' hi'
        by_cases hi'' : t + 1 + 1 ≤ i'.val
        · exact h1 i' hi''
        · have he : i' = i := Fin.ext (by omega)
          rw [he]
          exact h2
  have hcap : ∀ t : ℕ, wcKOpen V.left fV (t + 1 + 1) (t + 1) ⊓ wcKOpen V.left fV (t + 1) (t + 1 + 1) =
      wcKOpen V.left fV (t + 1) (t + 1) := by
    intro t
    apply le_antisymm
    · intro x hx
      obtain ⟨⟨_, i, hi, h2⟩, ⟨h1, _⟩⟩ := TopologicalSpace.Opens.mem_inf.1 hx
      exact ⟨h1, i, hi, h2⟩
    · rintro x ⟨h1, i, hi, h2⟩
      exact TopologicalSpace.Opens.mem_inf.2
        ⟨⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩, ⟨h1, i, by omega, h2⟩⟩

  have hA : ∀ (q q' : ℕ) (hq : 0 + q = q')
      (y : Abelian.Ext (wcFreeSheaf S (wcVRes S V (wcKOpen V.left fV (d - 1 + 1) (d - 1 + 1))))
        (wcRootTwist S (ℓ ^ n) d) q),
      wcLpscPsi S V (ℓ ^ n) d (wcLpscBetaTop S V) q'
          ((Abelian.Ext.mk₀ (wcFreeSheafMap S (wcVResSec S V _ hT))).comp y hq) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap V.left
            (wcVResSec V.left (Scheme.ProEt.mk (𝟙 V.left)) _ hT))).comp
          (wcLpscPsi S V (ℓ ^ n) d (wcLpscBeta S V _) q y) hq := by
    intro q q' hq y
    have hsq := wc_lpsc_gen_nat S V (wcVResSec V.left (Scheme.ProEt.mk (𝟙 V.left)) _ hT)
      (wcVResSec S V _ hT) (wcLpscBetaTop S V) (wcLpscBeta S V _)
      (MorphismProperty.Over.Hom.ext ((Category.comp_id _).trans (Category.id_comp _).symm))
    rw [hPsi, hPsi, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) hq (by omega), Abelian.Ext.mk₀_comp_mk₀, ← hsq,
      ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
      Abelian.Ext.comp_assoc _ _ _ hq (add_zero q) (by omega)]
    all_goals rfl

  have hB : ∀ (q t : ℕ)
      (y : Abelian.Ext (wcFreeSheaf S (wcVRes S V (wcKOpen V.left fV 1 1))) (wcRootTwist S (ℓ ^ n) d) q),
      wcLpscPsi S V (ℓ ^ n) d (wcLpscBeta S V (wcKOpen V.left fV (t + 1) (t + 1))) (q + t)
          (wcKChain S V fV (wcRootTwist S (ℓ ^ n) d) q t y) =
        wcKChain V.left (Scheme.ProEt.mk (𝟙 V.left)) fV (wcRootTwist V.left (ℓ ^ n) d) q t
          (wcLpscPsi S V (ℓ ^ n) d (wcLpscBeta S V (wcKOpen V.left fV 1 1)) q y) := by
    intro q t
    induction t with
    | zero => intro y; rfl
    | succ t ih =>
      intro y
      have h₁ : wcKOpen V.left fV (t + 1) (t + 1) ≤ wcKOpen V.left fV (t + 1 + 1) (t + 1) := by
        rintro x ⟨h1, i, hi, h2⟩; exact ⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩
      have h₂ : wcKOpen V.left fV (t + 1) (t + 1) ≤ wcKOpen V.left fV (t + 1) (t + 1 + 1) := by
        rintro x ⟨h1, i, hi, h2⟩; exact ⟨h1, i, by omega, h2⟩
      have h₃ : wcKOpen V.left fV (t + 1 + 1) (t + 1) ≤ wcKOpen V.left fV (t + 1 + 1) (t + 1 + 1) := by
        rintro x ⟨h1, i, hi, h2⟩; exact ⟨h1, i, by omega, h2⟩
      have h₄ : wcKOpen V.left fV (t + 1) (t + 1 + 1) ≤ wcKOpen V.left fV (t + 1 + 1) (t + 1 + 1) := by
        rintro x ⟨h1, i, hi, h2⟩; exact ⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩
      have hmv := wc_lpsc_mv_compat S V h₁ h₂ h₃ h₄ (hcup t) (hcap t) _ _ _ _
        (hLE h₁) (hLE h₂) (hLE h₃) (hLE h₄)
      have e1 : wcKChain V.left (Scheme.ProEt.mk (𝟙 V.left)) fV (wcRootTwist V.left (ℓ ^ n) d) q (t + 1)
          (wcLpscPsi S V (ℓ ^ n) d (wcLpscBeta S V (wcKOpen V.left fV 1 1)) q y) =
          (wcMVClass V.left (Scheme.ProEt.mk (𝟙 V.left)) h₁ h₂ h₃ h₄).comp
            (wcKChain V.left (Scheme.ProEt.mk (𝟙 V.left)) fV (wcRootTwist V.left (ℓ ^ n) d) q t
              (wcLpscPsi S V (ℓ ^ n) d (wcLpscBeta S V (wcKOpen V.left fV 1 1)) q y))
            (by omega : 1 + (q + t) = q + (t + 1)) := rfl
      have e2 : wcKChain S V fV (wcRootTwist S (ℓ ^ n) d) q (t + 1) y =
          (wcMVClass S V h₁ h₂ h₃ h₄).comp (wcKChain S V fV (wcRootTwist S (ℓ ^ n) d) q t y)
            (by omega : 1 + (q + t) = q + (t + 1)) := rfl
      rw [e1, e2, ← ih y, hPsi, hPsi, Abelian.Ext.mapExactFunctor_comp,
        ← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) _ (by omega : 0 + 1 + (q + t) = q + (t + 1)), hmv,
        Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add (q + t))
          (by omega : 1 + 0 + (q + t) = q + (t + 1)),
        Abelian.Ext.comp_assoc _ _ _ _ (add_zero (q + t)) (by omega : 1 + (q + t) + 0 = q + (t + 1))]
      all_goals rfl

  have hC : ∀ (tD : Fin d → (Γ((wcVRes S V (wcKOpen V.left fV 1 1)).left, ⊤))ˣ)
      (hℓD : IsUnit ((ℓ : ℕ) : Γ((wcVRes S V (wcKOpen V.left fV 1 1)).left, ⊤))),
      wcLpscPsi S V (ℓ ^ n) d (wcLpscBeta S V (wcKOpen V.left fV 1 1)) d
          ((Abelian.Ext.mk₀ (wcUnitTupleMap S (wcVRes S V (wcKOpen V.left fV 1 1)) ℓ d tD hℓD)).comp
            (wcKumTuple S ℓ n d) (zero_add d)) =
        (Abelian.Ext.mk₀ (wcUnitTupleMap V.left
            (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) (wcKOpen V.left fV 1 1)) ℓ d tD hℓD)).comp
          (wcKumTuple V.left ℓ n d) (zero_add d) := by
    intro tD hℓD
    have hk : ∀ {A B C D : Sheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}}
        (f : A ⟶ B) (g : B ⟶ C) (κ : Abelian.Ext C D d),
        (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp κ (zero_add d)) (zero_add d) =
          (Abelian.Ext.mk₀ (f ≫ g)).comp κ (zero_add d) := by
      intro A B C D f g κ
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add d) (by omega),
        Abelian.Ext.mk₀_comp_mk₀]
    rw [hPsi, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add d) (by omega : 0 + 0 + d = d),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add d) (add_zero d) (by omega : 0 + d + 0 = d),
      wc_lpsc_kum_transfer]
    exact (hk _ _ _).trans (congrArg (fun φ => (Abelian.Ext.mk₀ φ).comp (wcKumTuple V.left ℓ n d)
      (zero_add d)) ((Category.assoc _ _ _).trans (wc_lpsc_pi_compat S V ℓ d _ tD hℓD)))
  have hkey : ∀ (tD : Fin d → (Γ((wcVRes S V (wcKOpen V.left fV 1 1)).left, ⊤))ˣ)
      (hℓD : IsUnit ((ℓ : ℕ) : Γ((wcVRes S V (wcKOpen V.left fV 1 1)).left, ⊤))),
      wcLpscPsi S V (ℓ ^ n) d (wcLpscBetaTop S V) (2 * d - 1)
          (wcKFinal S V fV (wcRootTwist S (ℓ ^ n) d) hT
            ((Abelian.Ext.mk₀ (wcUnitTupleMap S (wcVRes S V (wcKOpen V.left fV 1 1)) ℓ d tD hℓD)).comp
              (wcKumTuple S ℓ n d) (zero_add d))) =
        wcKFinal V.left (Scheme.ProEt.mk (𝟙 V.left)) fV (wcRootTwist V.left (ℓ ^ n) d) hT
          ((Abelian.Ext.mk₀ (wcUnitTupleMap V.left
            (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) (wcKOpen V.left fV 1 1)) ℓ d tD hℓD)).comp
            (wcKumTuple V.left ℓ n d) (zero_add d)) := by
    intro tD hℓD
    show wcLpscPsi S V (ℓ ^ n) d (wcLpscBetaTop S V) (2 * d - 1)
        ((Abelian.Ext.mk₀ (wcFreeSheafMap S (wcVResSec S V _ hT))).comp
          (wcKChain S V fV (wcRootTwist S (ℓ ^ n) d) d (d - 1)
            ((Abelian.Ext.mk₀ (wcUnitTupleMap S (wcVRes S V (wcKOpen V.left fV 1 1)) ℓ d tD hℓD)).comp
              (wcKumTuple S ℓ n d) (zero_add d)))
          (by omega : 0 + (d + (d - 1)) = 2 * d - 1)) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap V.left
          (wcVResSec V.left (Scheme.ProEt.mk (𝟙 V.left)) _ hT))).comp
        (wcKChain V.left (Scheme.ProEt.mk (𝟙 V.left)) fV (wcRootTwist V.left (ℓ ^ n) d) d (d - 1)
          ((Abelian.Ext.mk₀ (wcUnitTupleMap V.left
            (wcVRes V.left (Scheme.ProEt.mk (𝟙 V.left)) (wcKOpen V.left fV 1 1)) ℓ d tD hℓD)).comp
            (wcKumTuple V.left ℓ n d) (zero_add d)))
        (by omega : 0 + (d + (d - 1)) = 2 * d - 1)
    rw [hA, hB, hC]
  constructor
  · rintro ⟨tD, hℓD, htD, hne⟩
    refine ⟨tD, hℓD, htD, fun h0 => hne ?_⟩
    apply wc_lpsc_psi_inj S V (ℓ ^ n) d (2 * d - 1)
    rw [map_nsmul, hkey tD hℓD, map_zero]
    exact h0
  · rintro ⟨tD, hℓD, htD, hne⟩
    refine ⟨tD, hℓD, htD, fun h0 => hne ?_⟩
    have h1 := congrArg (wcLpscPsi S V (ℓ ^ n) d (wcLpscBetaTop S V) (2 * d - 1)) h0
    rw [map_nsmul, hkey tD hℓD, map_zero] at h1
    exact h1

theorem wc_lpkt_affine_vanishing (K : Type u) [Field K] [IsAlgClosed K] (d : ℕ)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : IsUnit ((ℓ : ℕ) : K)) (n q : ℕ) (hq : 1 ≤ q)
    (x : Abelian.Ext (wcFreeSheaf (Spec (.of (MvPolynomial (Fin d) K)))
      (Scheme.ProEt.mk (𝟙 (Spec (.of (MvPolynomial (Fin d) K))))))
      (wcRootTwist (Spec (.of (MvPolynomial (Fin d) K))) (ℓ ^ n) d) q) : x = 0 :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out

  rcases Nat.eq_zero_or_pos n with hn0 | hnpos
  · have key : ∀ m : ℕ, m = 1 → ∀ y : Abelian.Ext (wcFreeSheaf (Spec (.of (MvPolynomial (Fin d) K)))
        (Scheme.ProEt.mk (𝟙 (Spec (.of (MvPolynomial (Fin d) K))))))
        (wcRootTwist (Spec (.of (MvPolynomial (Fin d) K))) m d) q, y = 0 := by
      intro m hm y
      subst hm
      have h := wc_lfd_root_twist_torsion (Spec (.of (MvPolynomial (Fin d) K))) 1 d
      rw [one_smul] at h
      calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero q) := (Abelian.Ext.comp_mk₀_id y).symm
        _ = y.comp (Abelian.Ext.mk₀ 0) (add_zero q) := by rw [h]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    exact key (ℓ ^ n) (by rw [hn0, pow_zero]) x

  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩

  have huntw : ∀ (S : Scheme.{u}) (U : S.ProEt) (p : U.left ⟶ Spec (CommRingCat.of K)) (m : ℕ)
      (hm : IsUnit ((m : ℕ) : K)),
      ∃ ψ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
          (wcRootTwist S m d) ⟶
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj (wcZModSheaf S m),
        IsIso ψ := by
    intro S U p m hm
    have wc_rtsp_locSurj_of_const : ∀ (S : Scheme.{u}) (U : S.ProEt) (m : ℕ)
        (P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
        (ρ : (Over.forget U).op ⋙ P ⟶
          (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj (wcZModSheaf S m)).obj),
        (∀ (V : Over U) (R : Sieve V),
          (∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
            ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) → R.arrows e) →
          R ∈ (Scheme.ProEt.topology S).over U V) →
        (∀ (V : Over U) (a : ZMod m), ∃ t : P.obj (Opposite.op V.left),
          ULift.down (ρ.app (Opposite.op V) t) = ContinuousMap.const V.left.left a) →
        Presheaf.IsLocallySurjective ((Scheme.ProEt.topology S).over U) ρ := by
      intro S U m P ρ hcov hconst
      refine ⟨fun {V} s => ?_⟩
      apply hcov V
      intro y
      let s' : C(V.left.left, ZMod m) := ULift.down s
      refine ⟨⟨s' ⁻¹' {s' y}, s'.continuous.isOpen_preimage _ (isOpen_discrete _)⟩,
        rfl, fun W e he => ?_⟩
      rw [Presheaf.imageSieve_apply]
      obtain ⟨t, ht⟩ := hconst W (s' y)
      refine ⟨t, ?_⟩
      apply ULift.ext
      refine ht.trans ?_
      apply ContinuousMap.ext
      intro z
      have hz : s' (e.left.left z) = s' y := he ⟨z, rfl⟩
      exact hz.symm
    have wc_rtsp_locInj_of_local_zero : ∀ (S : Scheme.{u}) (U : S.ProEt)
        (P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
        (Q : (Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ρ : (Over.forget U).op ⋙ P ⟶ Q),
        (∀ (V : Over U) (R : Sieve V),
          (∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
            ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) → R.arrows e) →
          R ∈ (Scheme.ProEt.topology S).over U V) →
        (∀ (V : Over U) (x : P.obj (Opposite.op V.left)), ρ.app (Opposite.op V) x = 0 →
          ∀ y : V.left.left, ∃ O : V.left.left.Opens, y ∈ O ∧
            ∀ (W : Over U) (e : W ⟶ V), Set.range e.left.left ⊆ (O : Set V.left.left) →
              P.map e.left.op x = 0) →
        Presheaf.IsLocallyInjective ((Scheme.ProEt.topology S).over U) ρ := by
      intro S U P Q ρ hcov hz
      refine ⟨fun {V} x₁ x₂ hx => ?_⟩
      apply hcov V.unop
      intro y
      have h0 : ρ.app V (x₁ - x₂) = 0 := by rw [map_sub, hx, sub_self]
      obtain ⟨O, hyO, hO⟩ := hz V.unop (x₁ - x₂) h0 y
      refine ⟨O, hyO, fun W e he => ?_⟩
      rw [Presheaf.equalizerSieve_apply]
      have h1 := hO W e he
      rw [map_sub, sub_eq_zero] at h1
      exact h1
    have hm0 : m ≠ 0 := by
      rintro rfl
      rw [Nat.cast_zero] at hm
      exact not_isUnit_zero hm
