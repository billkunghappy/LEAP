  obtain ⟨ρ, hinj, hsurj, hρ⟩ := wc_root_twist_slice_presheaf_map F X ℓ hℓ h n d
  obtain ⟨ψ, hψiso, -⟩ := wc_slice_sheafify_scaled_iso X.left (wcGeomPoint F X h)
