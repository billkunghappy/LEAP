        (Functor.whiskerRight (wcKtIncl.{u} m) AddCommGrpCat.uliftFunctor.{u+1, u}) := ⟨_, rfl⟩
  have hfapp : ∀ (W : (Y.Etale)ᵒᵖ) (x : (wcLpttEtPre Y (wcRootsFun.{u} m)).obj W),
      (f.app W).hom x = ULift.up (Additive.ofMul
        ((Additive.toMul x.down : rootsOfUnity m (Scheme.Γ.obj (Opposite.op W.unop.left))) :
          (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ)) := by
    intro W x
    rw [hf]
    show (AddCommGrpCat.uliftFunctor.{u+1, u}.map ((wcKtIncl.{u} m).app _)).hom x = _
    rw [hincl]
    try rfl



  have hsheafify : ∀ {P₁ P₂ P₃ : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
