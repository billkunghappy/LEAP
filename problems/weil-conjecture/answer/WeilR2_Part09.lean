    have hιmk : ∀ a, ι (Ideal.Quotient.mk pI a) = ev a := fun a => Ideal.Quotient.lift_mk _ _ _
    have halg := NA (Γ(Y, U) ⧸ pI) n g ι hgfin (by
      intro z
