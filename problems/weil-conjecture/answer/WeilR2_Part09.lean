    unfold wcKtCoord
    rw [dif_pos hk]
    show Units.map W.unop.hom.appTop.hom.toMonoidHom (s ⟨k, hk⟩) =
      Units.map W.unop.hom.appTop.hom.toMonoidHom a
    rw [hs]

  have hfst : ∀ (W : (Y.Etale)ᵒᵖ)
      (e : ↥(wcKaSub (Scheme.Γ.obj (Opposite.op W.unop.left)) (ℓ ^ n) (wcKaUnit Y a W))),
      ((Limits.pullback.fst _ _ : wcKtE.{u} ℓ n D k ⟶ wcKtZUT.{u} ℓ D).app
          (Scheme.Γ.obj (Opposite.op W.unop.left))).hom ((wcKaEs Y ℓ n D k s a hℓ W).hom e) =
        (e.1.1 : ℤ) • (FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W) :
          (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left))) := by
    intro W e
    unfold wcKaEs
    split_ifs with H
    · have h3 := (Category.assoc _ _ _).trans ((congrArg (fun q => Limits.pullback.lift _ _ H ≫ q)
        (Limits.pullbackObjIso_inv_comp_fst (wcKtPsi.{u} ℓ D k)
          ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ D) wcKtGm.{u}))
          (Scheme.Γ.obj (Opposite.op W.unop.left)))).trans (Limits.pullback.lift_fst _ _ H))
      have h4 := congrArg (fun q => AddCommGrpCat.Hom.hom q e) h3
