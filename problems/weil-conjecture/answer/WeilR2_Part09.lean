  intro K _ X Z fX n c _ i _ _ hcn V z hzV
  obtain ⟨W₀, hW₀, e₀, hzW₀, stdA₀, stdB₀⟩ := s1 K X Z fX n (n - c) i z
  obtain ⟨W₁, -, hzW₁, h₁, hcut₁⟩ := lc K X Z fX n c i hcn z
  obtain ⟨s, hsle, hzs⟩ := hW₀.exists_basicOpen_le (V := W₁ ⊓ V)
