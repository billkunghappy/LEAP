      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      ext x
      show σ V • (g.val.app V).hom x = (g.val.app V).hom (σ V • x)
      exact ((g.val.app V).hom.map_smul _ _).symm
