theorem wc_ext_leray_edge_vanishing : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C) (I : InjectiveResolution A) (M : ℕ), letI := HasExt.standard C; letI := HasExt.standard D; (∀ m : ℕ, M < m → ∀ z : Abelian.Ext (L.obj P) A m, z = 0) → (∀ a s : ℕ, 1 ≤ s → M ≤ a + s → ∀ z : Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology s) a, z = 0) → ∀ p : ℕ, M < p → ∀ z : Abelian.Ext P (R.obj A) p, z = 0 :=
by
  intro C D _ _ _ _ _ L R _ adj _ P A I M
  letI := HasExt.standard C
  letI := HasExt.standard D
  intro h1 h2
  haveI : L.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _

  have hhom : ∀ n : ℕ, M < n + 1 → ∀ f : P ⟶ R.obj (I.cocomplex.X (n + 1)),
      f ≫ R.map (I.cocomplex.d (n + 1) (n + 2)) = 0 →
      ∃ g : P ⟶ R.obj (I.cocomplex.X n), g ≫ R.map (I.cocomplex.d n (n + 1)) = f := by
    intro n hn f hf
    have hf' : (adj.homEquiv P _).symm f ≫ I.cocomplex.d (n + 1) (n + 2) = 0 := by
      rw [← Adjunction.homEquiv_naturality_right_symm, hf, Adjunction.homEquiv_counit,
        L.map_zero, Limits.zero_comp]
    have h0 := h1 (n + 1) hn (I.extMk ((adj.homEquiv P _).symm f) (n + 2) rfl hf')
    obtain ⟨g', hg'⟩ := (I.extMk_eq_zero_iff _ (n + 2) rfl hf' n rfl).mp h0
    refine ⟨adj.homEquiv P _ g', ?_⟩
    rw [← Adjunction.homEquiv_naturality_right, hg', Equiv.apply_symm_apply]

  have hinj : ∀ n : ℕ,
      Injective (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).X n) := by
    intro n
    haveI := I.injective n
    exact Injective.injective_of_adjoint adj (I.cocomplex.X n)

  have hiso : Nonempty (R.obj A ≅
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cycles 0) := by
    haveI := adj.rightAdjoint_preservesLimits.{0, 0}
    exact ⟨(Limits.KernelFork.mapIsLimit _ I.isLimitKernelFork R).conePointUniqueUpToIso
      (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cyclesIsKernel 0 1
        (CochainComplex.next ℕ 0))⟩

  have key : ∀ (K : CochainComplex D ℕ), (∀ n : ℕ, Injective (K.X n)) →
      (∀ n : ℕ, M < n + 1 → ∀ f : P ⟶ K.X (n + 1), f ≫ K.d (n + 1) (n + 2) = 0 →
        ∃ g : P ⟶ K.X n, g ≫ K.d n (n + 1) = f) →
      (∀ a s : ℕ, 1 ≤ s → M ≤ a + s → ∀ z : Abelian.Ext P (K.homology s) a, z = 0) →
      ∀ t j : ℕ, M < j + (t + 1) → ∀ z : Abelian.Ext P (K.cycles j) (t + 1), z = 0 := by
    intro K hinjK hhomK hH

    have hses : ∀ j : ℕ, ∃ (Q : D) (π : K.X j ⟶ Q) (u : Q ⟶ K.cycles (j + 1))
        (w₁ : K.iCycles j ≫ π = 0) (w₂ : u ≫ K.homologyπ (j + 1) = 0),
        (ShortComplex.mk (K.iCycles j) π w₁).ShortExact ∧
        (ShortComplex.mk u (K.homologyπ (j + 1)) w₂).ShortExact ∧
        π ≫ u = K.toCycles j (j + 1) := by
      intro j
      have h0 : K.iCycles j ≫ K.toCycles j (j + 1) = 0 := by
        rw [← cancel_mono (K.iCycles (j + 1)), Category.assoc, HomologicalComplex.toCycles_i,
          HomologicalComplex.iCycles_d, Limits.zero_comp]
      obtain ⟨u, hu⟩ : ∃ u : Limits.cokernel (K.iCycles j) ⟶ K.cycles (j + 1),
          u = Limits.cokernel.desc (K.iCycles j) (K.toCycles j (j + 1)) h0 := ⟨_, rfl⟩
      have hfac : Limits.cokernel.π (K.iCycles j) ≫ u = K.toCycles j (j + 1) := by
        rw [hu, Limits.cokernel.π_desc]
      have w₂ : u ≫ K.homologyπ (j + 1) = 0 := by
        rw [← cancel_epi (Limits.cokernel.π (K.iCycles j)), ← Category.assoc, hfac,
          HomologicalComplex.toCycles_comp_homologyπ, Limits.comp_zero]
      have hS'ex : (ShortComplex.mk (K.iCycles j) (K.d j (j + 1))
          (K.iCycles_d j (j + 1))).Exact :=
        ShortComplex.exact_of_f_is_kernel _
          (K.cyclesIsKernel j (j + 1) (CochainComplex.next ℕ j))
      have hmono1 : Mono (Limits.cokernel.desc (K.iCycles j) (K.d j (j + 1))
          (K.iCycles_d j (j + 1))) := hS'ex.mono_cokernelDesc
      have hcomp : u ≫ K.iCycles (j + 1) =
          Limits.cokernel.desc (K.iCycles j) (K.d j (j + 1)) (K.iCycles_d j (j + 1)) := by
        rw [← cancel_epi (Limits.cokernel.π (K.iCycles j)), ← Category.assoc, hfac,
          HomologicalComplex.toCycles_i, Limits.cokernel.π_desc]
      haveI : Mono (u ≫ K.iCycles (j + 1)) := by rw [hcomp]; exact hmono1
      haveI : Mono u := mono_of_mono u (K.iCycles (j + 1))
      have hc := Limits.isCokernelOfComp (f := u) (Limits.cokernel.π (K.iCycles j))
        (K.toCycles j (j + 1))
        (K.homologyIsCokernel j (j + 1) (CochainComplex.prev_nat_succ j)) w₂ hfac
      have hSbex : (ShortComplex.mk u (K.homologyπ (j + 1)) w₂).Exact :=
        ShortComplex.exact_of_g_is_cokernel _ hc
      refine ⟨Limits.cokernel (K.iCycles j), Limits.cokernel.π _, u,
        Limits.cokernel.condition _, w₂, ?_, ?_, hfac⟩
      · exact ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (K.iCycles j))
          inferInstance inferInstance
      · exact ShortComplex.ShortExact.mk' hSbex inferInstance inferInstance

    intro t
    induction t with
    | zero =>
      intro j hj z
      obtain ⟨Q, π, u, w₁, w₂, hSa, hSb, hfac⟩ := hses j
      haveI := hinjK j
      have hz1 : z.comp (Abelian.Ext.mk₀ (K.iCycles j)) (add_zero _) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hSa z hz1 (n₀ := 0) rfl
      have hy0 : y = Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ y) :=
        (Abelian.Ext.mk₀_homEquiv₀_apply y).symm
      have hfd : (Abelian.Ext.homEquiv₀ y ≫ u ≫ K.iCycles (j + 1)) ≫ K.d (j + 1) (j + 2) = 0 := by
        simp only [Category.assoc, HomologicalComplex.iCycles_d, Limits.comp_zero]
      obtain ⟨ψ, hψ⟩ := hhomK j (by omega) _ hfd
      haveI : Mono u := hSb.mono_f
      have hψπ : ψ ≫ π = Abelian.Ext.homEquiv₀ y := by
        rw [← cancel_mono (u ≫ K.iCycles (j + 1))]
        simp only [Category.assoc]
        rw [reassoc_of% hfac, HomologicalComplex.toCycles_i, hψ]
      have hc : (Abelian.Ext.mk₀ π).comp hSa.extClass (zero_add 1) = 0 := hSa.comp_extClass
      rw [← hy, hy0, ← hψπ]
      calc _ = (Abelian.Ext.mk₀ ψ).comp ((Abelian.Ext.mk₀ π).comp hSa.extClass (zero_add 1))
              (zero_add 1) := by
              rw [← Abelian.Ext.mk₀_comp_mk₀]
              exact Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega)
        _ = 0 := by rw [hc, Abelian.Ext.comp_zero]
    | succ t ih =>
      intro j hj z
      obtain ⟨Q, π, u, w₁, w₂, hSa, hSb, hfac⟩ := hses j
      haveI := hinjK j
      have hz1 : z.comp (Abelian.Ext.mk₀ (K.iCycles j)) (add_zero _) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hSa z hz1 (n₀ := t + 1) rfl
      have hy1 : y.comp (Abelian.Ext.mk₀ u) (add_zero _) = 0 := ih (j + 1) (by omega) _
      obtain ⟨x, hx⟩ := Abelian.Ext.covariant_sequence_exact₁ P hSb y hy1 (n₀ := t) rfl
      have hx0 : x = 0 := hH t (j + 1) (by omega) (by omega) x
      rw [← hy, ← hx, hx0, Abelian.Ext.zero_comp, Abelian.Ext.zero_comp]

  intro p hp z
  obtain ⟨t, rfl⟩ : ∃ t, p = t + 1 := ⟨p - 1, by omega⟩
  obtain ⟨e⟩ := hiso
  have hz0 : z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _) = 0 :=
    key _ hinj (fun n hn f hf => hhom n hn f hf) h2 t 0 (by omega) _
  calc z = z.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id z).symm
    _ = z.comp ((Abelian.Ext.mk₀ e.hom).comp (Abelian.Ext.mk₀ e.inv) (add_zero 0)) (add_zero _) := by
        rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
    _ = (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp (Abelian.Ext.mk₀ e.inv) (add_zero _) :=
        (Abelian.Ext.comp_assoc _ _ _ _ _ (by omega)).symm
    _ = 0 := by rw [hz0, Abelian.Ext.zero_comp]

theorem wc_closure_point_krullDim_facts : ∀ (X : Type*) [TopologicalSpace X] [T0Space X] (x y : X) (D : ℕ), (0 ≤ topologicalKrullDim ↥(closure ({x} : Set X))) ∧ (topologicalKrullDim ↥(closure ({x} : Set X)) ≤ topologicalKrullDim X) ∧ (y ∈ closure ({x} : Set X) → y ≠ x → topologicalKrullDim ↥(closure ({x} : Set X)) ≤ (D : WithBot ℕ∞) → topologicalKrullDim ↥(closure ({y} : Set X)) + 1 ≤ topologicalKrullDim ↥(closure ({x} : Set X))) :=
by
  intro X _ _ x y D
  have hne : ∀ p : X, Nonempty (TopologicalSpace.IrreducibleCloseds ↥(closure ({p} : Set X))) := by
    intro p
    haveI : IrreducibleSpace ↥(closure ({p} : Set X)) :=
      Subtype.irreducibleSpace isIrreducible_singleton.closure
    exact ⟨⟨Set.univ, IrreducibleSpace.isIrreducible_univ _, isClosed_univ⟩⟩
  refine ⟨?_, topologicalKrullDim_subspace_le X _, ?_⟩
  · haveI := hne x
    exact Order.krullDim_nonneg
  · intro hy hyx _
    have h : closure ({y} : Set X) ⊆ closure ({x} : Set X) :=
      closure_minimal (Set.singleton_subset_iff.mpr hy) isClosed_closure
    have hind : Topology.IsInducing (Set.inclusion h) :=
      (Topology.IsEmbedding.inclusion h).isInducing
    have hxy : x ∉ closure ({y} : Set X) := by
      intro hx
      exact hyx (inseparable_iff_mem_closure.mpr ⟨hx, hy⟩).eq.symm
    haveI : IrreducibleSpace ↥(closure ({x} : Set X)) :=
      Subtype.irreducibleSpace isIrreducible_singleton.closure
    let Ux : TopologicalSpace.IrreducibleCloseds ↥(closure ({x} : Set X)) :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ _, isClosed_univ⟩
    let g := TopologicalSpace.IrreducibleCloseds.map (Set.inclusion h) hind.continuous
    have hg : StrictMono g := TopologicalSpace.IrreducibleCloseds.map_strictMono_of_isInducing hind
    have hlt : ∀ a, g a < Ux := by
      intro a
      rw [SetLike.lt_iff_le_and_exists]
      refine ⟨?_, ⟨x, subset_closure (Set.mem_singleton x)⟩, ?_, ?_⟩
      · intro z _
        show z ∈ (Set.univ : Set ↥(closure ({x} : Set X)))
        exact Set.mem_univ _
      · show _ ∈ (Set.univ : Set ↥(closure ({x} : Set X)))
        exact Set.mem_univ _
      · intro hz
        have hC : IsClosed (Subtype.val ⁻¹' closure ({y} : Set X) :
            Set ↥(closure ({x} : Set X))) :=
          isClosed_closure.preimage continuous_subtype_val
        have hsub : Set.inclusion h '' (a : Set ↥(closure ({y} : Set X))) ⊆
            Subtype.val ⁻¹' closure ({y} : Set X) := by
          rintro _ ⟨w, _, rfl⟩
          exact w.property
        have hcl := closure_minimal hsub hC
        have hz' : (⟨x, subset_closure (Set.mem_singleton x)⟩ : ↥(closure ({x} : Set X)))
            ∈ ((g a : TopologicalSpace.IrreducibleCloseds ↥(closure ({x} : Set X))) :
              Set ↥(closure ({x} : Set X))) := hz
        rw [TopologicalSpace.IrreducibleCloseds.coe_map] at hz'
        exact hxy (hcl hz')
    let f : WithTop (TopologicalSpace.IrreducibleCloseds ↥(closure ({y} : Set X))) →
        TopologicalSpace.IrreducibleCloseds ↥(closure ({x} : Set X)) :=
      fun t => WithTop.recTopCoe Ux g t
    have hf : StrictMono f := WithTop.strictMono_iff.mpr ⟨hg, hlt⟩
    have hle := Order.krullDim_le_of_strictMono f hf
    haveI := hne y
    rw [Order.krullDim_WithTop] at hle
    exact hle

theorem wc_et_stalk_exact : ∀ (B : Scheme.{u}) (b : B), Limits.PreservesFiniteLimits (wcEtStalk B b) ∧ Limits.PreservesFiniteColimits (wcEtStalk B b) :=
by
  intro B b
  haveI : AB5OfSize.{u, u} AddCommGrpCat.{u+1} :=
    AB5OfSize_shrink.{u, u, u+1, u+1} AddCommGrpCat.{u+1}
  let Φ := Scheme.pointSmallEtale (wcEtGeomPt B b)
  let E : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) ⥤ Φ.fiber.Elements :=
    { obj := fun A => Φ.fiber.elementsMk A.right A.hom
      map := fun {A A'} g => ⟨g.right, StructuredArrow.w g⟩
      map_id := fun A => rfl
      map_comp := fun f g => rfl }
  let Einv : Φ.fiber.Elements ⥤ StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) :=
    { obj := fun x => StructuredArrow.mk (T := Scheme.Etale.forget B) (Y := x.1) x.2
      map := fun {x y} φ => StructuredArrow.homMk φ.1 φ.2
      map_id := fun x => rfl
      map_comp := fun f g => rfl }
  let eqv : StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B) ≌ Φ.fiber.Elements :=
    CategoryTheory.Equivalence.mk E Einv (NatIso.ofComponents (fun A => Iso.refl _) (by intros; rfl))
      (NatIso.ofComponents (fun x => Iso.refl _) (by intros; rfl))
  haveI : E.IsEquivalence := eqv.isEquivalence_functor
  haveI : E.IsLeftAdjoint := Functor.isLeftAdjoint_of_isEquivalence
  haveI : E.Initial := Functor.initial_of_isLeftAdjoint E
  haveI : E.op.Final := Functor.final_op_of_initial E
  let i0 := Functor.Final.colimIso (E := AddCommGrpCat.{u+1}) E.op
  let i1 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
      (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ Limits.colim ≅
      (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (Functor.Elements.π Φ.fiber).op ⋙
        Limits.colim :=
    Functor.isoWhiskerLeft ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
      (Functor.Elements.π Φ.fiber).op) i0
  let j : Φ.sheafFiber (A := AddCommGrpCat.{u+1}) ≅ wcEtStalk B b :=
    Functor.isoWhiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) i1.symm
  exact ⟨Limits.preservesFiniteLimits_of_natIso j, Limits.preservesFiniteColimits_of_natIso j⟩

theorem wc_et_push_skyscraper_iso : ∀ {Y Z : Scheme.{u}} (g : Z ⟶ Y) (Ω : Type u) [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ Z) (M : AddCommGrpCat.{u+1}), Nonempty ((wcEtPush g).obj ((Scheme.pointSmallEtale s).skyscraperSheaf M) ≅ (Scheme.pointSmallEtale (s ≫ g)).skyscraperSheaf M) :=
by
  intro Y Z g Ω _ _ s M
  exact ⟨(presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapIso
      (Functor.isoWhiskerRight (NatIso.op
        (Functor.isoWhiskerLeft (Scheme.Etale.forget Y)
            ((Over.mapPullbackAdj g).compCoyonedaIso.app (Opposite.op (Over.mk s))) ≪≫
          (Functor.associator _ _ _).symm ≪≫
          Functor.isoWhiskerRight (Iso.refl _ : Scheme.Etale.forget Y ⋙ Over.pullback g ≅
            wcEtBaseChange g ⋙ Scheme.Etale.forget Z) _ ≪≫
          Functor.associator _ _ _ :
          (Scheme.pointSmallEtale (s ≫ g)).fiber ≅
            wcEtBaseChange g ⋙ (Scheme.pointSmallEtale s).fiber))
        (Limits.piFunctor.{u}.obj M) :
        (wcEtBaseChange g).op ⋙ ((Scheme.pointSmallEtale s).skyscraperSheaf M).obj ≅
          (Scheme.pointSmallEtale (s ≫ g)).skyscraperPresheaf M) ≪≫
    (sheafificationIso ((Scheme.pointSmallEtale (s ≫ g)).skyscraperSheaf M)).symm⟩

theorem wc_et_residue_point_lift_cover : ∀ (Y : Scheme.{u}) (x : Y) (T : (Spec (Y.residueField x)).Etale) (t : T.left), ∃ (V : Y.Etale) (a : (wcEtBaseChange (Y.fromSpecResidueField x)).obj V ⟶ T), t ∈ Set.range a.left :=
by
  intro Y x T t

  have s1 : ∀ {X Z : Scheme.{u}} (f : X ⟶ Z) [LocallyOfFiniteType f] [FormallyUnramified f] (x : X),
      letI : Algebra (Z.residueField (f x)) (X.residueField x) := (f.residueFieldMap x).hom.toAlgebra
      FiniteDimensional (Z.residueField (f x)) (X.residueField x) ∧
        Algebra.IsSeparable (Z.residueField (f x)) (X.residueField x) := by
    intro X Z f _ _ x
    let φ := (f.stalkMap x).hom
    letI : Algebra (Z.presheaf.stalk (f x)) (X.presheaf.stalk x) := φ.toAlgebra
    haveI : Algebra.FormallyUnramified (Z.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
      FormallyUnramified.stalkMap f x
    haveI : Algebra.EssFiniteType (Z.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
      LocallyOfFiniteType.stalkMap f x
    haveI : IsLocalHom (algebraMap (Z.presheaf.stalk (f x)) (X.presheaf.stalk x)) :=
      inferInstanceAs (IsLocalHom φ)
    have hsep : Algebra.IsSeparable (IsLocalRing.ResidueField (Z.presheaf.stalk (f x)))
        (IsLocalRing.ResidueField (X.presheaf.stalk x)) := inferInstance
    have heq : (IsLocalRing.ResidueField.instAlgebra :
          Algebra (IsLocalRing.ResidueField (Z.presheaf.stalk (f x)))
            (IsLocalRing.ResidueField (X.presheaf.stalk x))) =
        (IsLocalRing.ResidueField.map φ).toAlgebra := by
      apply Algebra.algebra_ext
      intro r
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective r
      rw [IsLocalRing.ResidueField.algebraMap_residue]
      exact (IsLocalRing.ResidueField.map_residue φ a).symm
    have hsep' : @Algebra.IsSeparable (IsLocalRing.ResidueField (Z.presheaf.stalk (f x)))
        (IsLocalRing.ResidueField (X.presheaf.stalk x)) _ _
        (IsLocalRing.ResidueField.map φ).toAlgebra := heq ▸ hsep
    have hfe : (IsLocalRing.ResidueField.map φ).EssFiniteType :=
      (LocallyOfFiniteType.stalkMap f x).residueFieldMap
    letI : Algebra (Z.residueField (f x)) (X.residueField x) := (f.residueFieldMap x).hom.toAlgebra
    haveI : Algebra.IsSeparable (Z.residueField (f x)) (X.residueField x) := hsep'
    haveI : Algebra.EssFiniteType (Z.residueField (f x)) (X.residueField x) := hfe
    haveI : Algebra.IsAlgebraic (Z.residueField (f x)) (X.residueField x) :=
      Algebra.IsSeparable.isAlgebraic _ _
    exact ⟨Algebra.finite_of_essFiniteType_of_isAlgebraic, inferInstance⟩

  have s2 : ∀ (Y : Scheme.{u}) (y : Y) (p : Spec (Y.residueField y)),
      IsIso (Spec.preimage ((Spec (Y.residueField y)).fromSpecResidueField p)) := by
    intro Y y p
    have h1 := (Scheme.SpecToEquivOfField (Y.residueField y) (Spec (Y.residueField y))).symm_apply_apply
      (𝟙 _)
    rw [Scheme.SpecToEquivOfField_symm_apply] at h1
    generalize Scheme.SpecToEquivOfField (Y.residueField y) (Spec (Y.residueField y)) (𝟙 _) = s at h1
    obtain ⟨q, φ⟩ := s
    have hq : q = p := Subsingleton.elim _ _
    subst hq
    haveI : IsSplitEpi ((Spec (Y.residueField y)).fromSpecResidueField q) :=
      ⟨⟨⟨Spec.map φ, h1⟩⟩⟩
    haveI : IsIso ((Spec (Y.residueField y)).fromSpecResidueField q) :=
      isIso_of_mono_of_isSplitEpi _
    refine ⟨⟨Spec.preimage (inv ((Spec (Y.residueField y)).fromSpecResidueField q)), ?_, ?_⟩⟩
    · apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, IsIso.inv_hom_id, Spec.map_id]
    · apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, IsIso.hom_inv_id, Spec.map_id]

  have s3 : ∀ (Y : Scheme.{u}) (y : Y) (X : Scheme.{u}) (f : X ⟶ Spec (Y.residueField y)) [Etale f]
      (x : X), letI : Algebra (Y.residueField y) (X.residueField x) :=
        (Spec.preimage (X.fromSpecResidueField x ≫ f)).hom.toAlgebra
      FiniteDimensional (Y.residueField y) (X.residueField x) ∧
        Algebra.IsSeparable (Y.residueField y) (X.residueField x) := by
    intro Y y X f _ x
    let β := Spec.preimage ((Spec (Y.residueField y)).fromSpecResidueField (f x))
    let r := f.residueFieldMap x
    haveI hβ : IsIso β := s2 Y y (f x)
    have key : Spec.preimage (X.fromSpecResidueField x ≫ f) = β ≫ r := by
      apply Spec.map_injective
      rw [Spec.map_preimage, Spec.map_comp, Spec.map_preimage,
        Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField]
    rw [key]
    obtain ⟨hfin, hsep⟩ := s1 f x
    letI A1 : Algebra ((Spec (Y.residueField y)).residueField (f x)) (X.residueField x) :=
      r.hom.toAlgebra
    letI A2 : Algebra (Y.residueField y) (X.residueField x) := (β ≫ r).hom.toAlgebra
    let e₁ : (Spec (Y.residueField y)).residueField (f x) ≃+* (Y.residueField y) :=
      (asIso β).symm.commRingCatIsoToRingEquiv
    have hc : (algebraMap (Y.residueField y) (X.residueField x)).comp (e₁ : _ →+* _) =
        ((RingEquiv.refl (X.residueField x)) : _ →+* _).comp
          (algebraMap ((Spec (Y.residueField y)).residueField (f x)) (X.residueField x)) := by
      ext a
      change ((asIso β).inv ≫ β ≫ r).hom a = r.hom a
      rw [asIso_inv, IsIso.inv_hom_id_assoc]
    exact ⟨Module.Finite.of_equiv_equiv e₁ (RingEquiv.refl _) hc,
      Algebra.IsSeparable.of_equiv_equiv e₁ (RingEquiv.refl _) hc⟩

  have s4 : ∀ (Y : Scheme.{u}) (y : Y) (F : Scheme.{u}) (g : F ⟶ Spec (Y.residueField y)) [Etale g]
      (w : F), (∀ z : F, z = w) →
      (letI : Algebra (Y.residueField y) (F.residueField w) :=
        (Spec.preimage (F.fromSpecResidueField w ≫ g)).hom.toAlgebra
       FiniteDimensional (Y.residueField y) (F.residueField w) ∧
        Algebra.IsSeparable (Y.residueField y) (F.residueField w)) →
      IsIso (F.fromSpecResidueField w) := by
    intro Y y F g _ w hone hfs
    letI : Algebra (Y.residueField y) (F.residueField w) :=
      (Spec.preimage (F.fromSpecResidueField w ≫ g)).hom.toAlgebra
    obtain ⟨hfin, hsep⟩ := hfs
    have h1 : F.fromSpecResidueField w ≫ g =
        Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) (F.residueField w))) := by
      rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage]
    haveI : Algebra.FormallyEtale (Y.residueField y) (F.residueField w) :=
      Algebra.FormallyEtale.of_isSeparable _ _
    haveI : Algebra.Etale (Y.residueField y) (F.residueField w) :=
      ⟨inferInstance, Algebra.FinitePresentation.of_finiteType.mp inferInstance⟩
    have h2 : Etale (Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) (F.residueField w)))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr inferInstance)
    haveI : Etale (F.fromSpecResidueField w ≫ g) := h1 ▸ h2
    haveI : Etale (F.fromSpecResidueField w) := Etale.of_comp _ g
    haveI : IsOpenImmersion (F.fromSpecResidueField w) := IsOpenImmersion.of_flat_of_mono _
    obtain ⟨pt⟩ := (inferInstance : Nonempty (Spec (F.residueField w)))
    have hs : Surjective (F.fromSpecResidueField w) :=
      ⟨fun z => ⟨pt, by rw [Scheme.fromSpecResidueField_apply, hone z]⟩⟩
    exact (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨inferInstance, hs⟩

  have s6 : ∀ {Y V : Scheme.{u}} (q : V ⟶ Y) (y : Y) (v : V), q v = y → (∀ w : V, q w = y → w = v) →
      ∃ w : ↥(Limits.pullback q (Y.fromSpecResidueField y)),
        (Limits.pullback.fst q (Y.fromSpecResidueField y)) w = v ∧
        ∀ z : ↥(Limits.pullback q (Y.fromSpecResidueField y)), z = w := by
    intro Y V q y v hv huniq
    have hall : ∀ z : ↥(Limits.pullback q (Y.fromSpecResidueField y)),
        (Limits.pullback.fst q (Y.fromSpecResidueField y)) z = v := by
      intro z
      apply huniq
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply,
        Scheme.fromSpecResidueField_apply]
    obtain ⟨pt⟩ := (inferInstance : Nonempty (Spec (Y.residueField y)))
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := q)
      (g := Y.fromSpecResidueField y) v pt (by rw [hv, Scheme.fromSpecResidueField_apply])
    refine ⟨w, hw1, fun z => ?_⟩
    apply (Limits.pullback.fst q (Y.fromSpecResidueField y)).isEmbedding.injective
    rw [hall z, hall w]

  letI : Algebra (Y.residueField x) (T.left.residueField t) :=
    (Spec.preimage (T.left.fromSpecResidueField t ≫ T.hom)).hom.toAlgebra
  obtain ⟨hfin, hsep⟩ := s3 Y x T.left T.hom t
  obtain ⟨V', v', e, he, hv', huniq, hcomm⟩ := wc_esgr_etale_model Y x (T.left.residueField t)
  obtain ⟨w, hw, hP⟩ := s6 (Y := Y) (V := V'.left) V'.hom x v' hv' huniq
  subst hw
  have h3P := s3 Y x (Limits.pullback V'.hom (Y.fromSpecResidueField x))
    (Limits.pullback.snd V'.hom (Y.fromSpecResidueField x)) w
  have hiso := s4 Y x _ (Limits.pullback.snd V'.hom (Y.fromSpecResidueField x)) w hP h3P
  clear s1 s2 s3 s4 s6
  have hmono : Mono (Y.fromSpecResidueField x) := inferInstance
  let aL : Limits.pullback V'.hom (Y.fromSpecResidueField x) ⟶ T.left :=
    inv ((Limits.pullback V'.hom (Y.fromSpecResidueField x)).fromSpecResidueField w) ≫
      Spec.map ((Limits.pullback.fst V'.hom (Y.fromSpecResidueField x)).residueFieldMap w) ≫
      Spec.map (inv e) ≫ T.left.fromSpecResidueField t
  have hstar : T.left.fromSpecResidueField t ≫ T.hom =
      Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField x) (T.left.residueField t))) := by
    rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hover : aL ≫ T.hom = Limits.pullback.snd V'.hom (Y.fromSpecResidueField x) := by
    rw [← cancel_mono (Y.fromSpecResidueField x)]
    calc aL ≫ T.hom ≫ Y.fromSpecResidueField x
        = inv ((Limits.pullback V'.hom (Y.fromSpecResidueField x)).fromSpecResidueField w) ≫
          Spec.map ((Limits.pullback.fst V'.hom (Y.fromSpecResidueField x)).residueFieldMap w) ≫
          Spec.map (inv e) ≫ ((T.left.fromSpecResidueField t ≫ T.hom) ≫ Y.fromSpecResidueField x) := by
          simp only [aL, Category.assoc]
      _ = inv ((Limits.pullback V'.hom (Y.fromSpecResidueField x)).fromSpecResidueField w) ≫
          Spec.map ((Limits.pullback.fst V'.hom (Y.fromSpecResidueField x)).residueFieldMap w) ≫
          Spec.map (inv e) ≫ ((Spec.map e ≫ V'.left.fromSpecResidueField
            ((Limits.pullback.fst V'.hom (Y.fromSpecResidueField x)) w)) ≫ V'.hom) := by
          rw [hstar, hcomm]
      _ = inv ((Limits.pullback V'.hom (Y.fromSpecResidueField x)).fromSpecResidueField w) ≫
          Spec.map ((Limits.pullback.fst V'.hom (Y.fromSpecResidueField x)).residueFieldMap w) ≫
          (Spec.map (inv e) ≫ Spec.map e) ≫ V'.left.fromSpecResidueField
            ((Limits.pullback.fst V'.hom (Y.fromSpecResidueField x)) w) ≫ V'.hom := by
          simp only [Category.assoc]
      _ = (inv ((Limits.pullback V'.hom (Y.fromSpecResidueField x)).fromSpecResidueField w) ≫
          (Spec.map ((Limits.pullback.fst V'.hom (Y.fromSpecResidueField x)).residueFieldMap w) ≫
          V'.left.fromSpecResidueField
            ((Limits.pullback.fst V'.hom (Y.fromSpecResidueField x)) w))) ≫ V'.hom := by
          rw [← Spec.map_comp, IsIso.hom_inv_id, Spec.map_id]
          simp only [Category.assoc]
          congr 2
      _ = Limits.pullback.fst V'.hom (Y.fromSpecResidueField x) ≫ V'.hom := by
          rw [Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, IsIso.inv_hom_id_assoc]
      _ = Limits.pullback.snd V'.hom (Y.fromSpecResidueField x) ≫ Y.fromSpecResidueField x :=
          Limits.pullback.condition
  let a : (wcEtBaseChange (Y.fromSpecResidueField x)).obj V' ⟶ T :=
    MorphismProperty.Over.homMk (A := (wcEtBaseChange (Y.fromSpecResidueField x)).obj V') (B := T)
      aL hover trivial
  refine ⟨V', a, w, ?_⟩
  show aL w = t
  simp only [aL, Scheme.Hom.comp_apply]
  exact Scheme.fromSpecResidueField_apply t _

theorem wc_et_preimmersion_bc_locally_full : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsPreimmersion i], (wcEtBaseChange i).IsLocallyFull (Scheme.smallEtaleTopology Z) :=
by
  intro B Z i _
  refine Functor.IsLocallyFull.mk (fun {U V} f => ?_)
  haveI : Etale U.hom := U.prop
  haveI : Etale V.hom := V.prop
  obtain ⟨φ, hφdef⟩ : ∃ φ : Limits.pullback U.hom i ⟶ Limits.pullback V.hom i, φ = f.left :=
    ⟨f.left, rfl⟩
  have hφ : φ ≫ Limits.pullback.snd V.hom i = Limits.pullback.snd U.hom i := by
    rw [hφdef]; exact MorphismProperty.Over.w f
  obtain ⟨pB, hpB⟩ : ∃ pB : Limits.pullback U.hom V.hom ⟶ B,
      pB = Limits.pullback.fst U.hom V.hom ≫ U.hom := ⟨_, rfl⟩
  have hp' : Limits.pullback.fst U.hom V.hom ≫ U.hom = pB := hpB.symm
  have hcUV : Limits.pullback.snd U.hom V.hom ≫ V.hom = pB := by
    rw [← hp']; exact (Limits.pullback.condition (f := U.hom) (g := V.hom)).symm
  haveI : Etale pB := by rw [hpB]; infer_instance

  obtain ⟨Γ, hΓs, hΓ1, hΓ2⟩ : ∃ Γ : Limits.pullback U.hom i ⟶ Limits.pullback pB i,
      Γ ≫ Limits.pullback.snd pB i = Limits.pullback.snd U.hom i ∧
      Γ ≫ Limits.pullback.fst pB i ≫ Limits.pullback.fst U.hom V.hom =
        Limits.pullback.fst U.hom i ∧
      Γ ≫ Limits.pullback.fst pB i ≫ Limits.pullback.snd U.hom V.hom =
        φ ≫ Limits.pullback.fst V.hom i := by
    have e1 : Limits.pullback.fst U.hom i ≫ U.hom =
        (φ ≫ Limits.pullback.fst V.hom i) ≫ V.hom := by
      rw [Limits.pullback.condition (f := U.hom) (g := i), ← hφ, Category.assoc, Category.assoc,
        ← Limits.pullback.condition (f := V.hom) (g := i)]
    have e2 : Limits.pullback.lift _ _ e1 ≫ pB = Limits.pullback.snd U.hom i ≫ i := by
      rw [← hp', Limits.pullback.lift_fst_assoc, Limits.pullback.condition]
    exact ⟨Limits.pullback.lift _ _ e2, Limits.pullback.lift_snd _ _ _,
      by rw [Limits.pullback.lift_fst_assoc, Limits.pullback.lift_fst],
      by rw [Limits.pullback.lift_fst_assoc, Limits.pullback.lift_snd]⟩
  haveI : Etale Γ := by
    haveI : Etale (Γ ≫ Limits.pullback.snd pB i) := by rw [hΓs]; infer_instance
    exact Etale.of_comp Γ (Limits.pullback.snd pB i)

  obtain ⟨q, hq⟩ : ∃ q : Limits.pullback pB i ⟶ Limits.pullback U.hom i, Γ ≫ q = 𝟙 _ := by
    have h0 : (Limits.pullback.fst pB i ≫ Limits.pullback.fst U.hom V.hom) ≫ U.hom =
        Limits.pullback.snd pB i ≫ i := by
      rw [Category.assoc, hp']; exact Limits.pullback.condition
    refine ⟨Limits.pullback.lift _ _ h0, ?_⟩
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, hΓ1, Category.id_comp]
    · rw [Category.assoc, Limits.pullback.lift_snd, hΓs, Category.id_comp]
  haveI : IsSplitMono Γ := IsSplitMono.mk' ⟨q, hq⟩
  haveI : IsOpenImmersion Γ := IsOpenImmersion.of_flat_of_mono Γ

  have hind : Topology.IsInducing (Limits.pullback.fst pB i) :=
    (Limits.pullback.fst pB i).isEmbedding.isInducing
  obtain ⟨t, ht, htΓ⟩ := hind.isOpen_iff.mp Γ.isOpenEmbedding.isOpen_range
  let O : (Limits.pullback U.hom V.hom).Opens := ⟨t, ht⟩
  have hOι : ∀ w, O.ι w ∈ t := by
    intro w
    have hw : O.ι w ∈ Set.range O.ι := ⟨w, rfl⟩
    rw [Scheme.Opens.range_ι] at hw
    exact hw
  have hrange : Set.range (Limits.pullback.snd O.ι (Limits.pullback.fst pB i)) ⊆ Set.range Γ := by
    rintro _ ⟨z, rfl⟩
    rw [← htΓ, Set.mem_preimage]
    have hz : (Limits.pullback.fst pB i) ((Limits.pullback.snd O.ι (Limits.pullback.fst pB i)) z) =
        O.ι ((Limits.pullback.fst O.ι (Limits.pullback.fst pB i)) z) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, ← Limits.pullback.condition]
    rw [hz]
    exact hOι _
  have hL : ∀ x : ↥(Limits.pullback U.hom i), ∃ (E : Scheme.{u})
      (e : E ⟶ Limits.pullback U.hom V.hom) (_ : Etale e)
      (h : Limits.pullback e (Limits.pullback.fst pB i) ⟶ Limits.pullback U.hom i)
      (x' : ↥(Limits.pullback e (Limits.pullback.fst pB i))),
      h ≫ Γ = Limits.pullback.snd e (Limits.pullback.fst pB i) ∧ h x' = x := by
    intro x
    let h := IsOpenImmersion.lift Γ (Limits.pullback.snd O.ι (Limits.pullback.fst pB i)) hrange
    have hh : h ≫ Γ = Limits.pullback.snd O.ι (Limits.pullback.fst pB i) :=
      IsOpenImmersion.lift_fac _ _ _
    have hx : (Limits.pullback.fst pB i) (Γ x) ∈ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      have : Γ x ∈ Set.range Γ := ⟨x, rfl⟩
      rw [← htΓ] at this
      exact this
    obtain ⟨o, ho⟩ := hx
    obtain ⟨z, -, hz2⟩ := Scheme.Pullback.exists_preimage_pullback o (Γ x) ho
    refine ⟨_, O.ι, inferInstance, h, z, hh, ?_⟩
    apply Γ.isOpenEmbedding.injective
    rw [← Scheme.Hom.comp_apply, hh, hz2]

  change _ ∈ Scheme.smallGrothendieckTopology @Etale Z _
  rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
  apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
  intro x
  obtain ⟨E, e, he, h, x', hh, hx'⟩ := hL x
  haveI := he
  let W' : B.Etale := MorphismProperty.Over.mk ⊤ (e ≫ pB) inferInstance
  let g : W' ⟶ U := MorphismProperty.Over.homMk (e ≫ Limits.pullback.fst U.hom V.hom)
    (by show (e ≫ Limits.pullback.fst U.hom V.hom) ≫ U.hom = e ≫ pB
        rw [Category.assoc, hp']) trivial
  let g' : W' ⟶ V := MorphismProperty.Over.homMk (e ≫ Limits.pullback.snd U.hom V.hom)
    (by show (e ≫ Limits.pullback.snd U.hom V.hom) ≫ V.hom = e ≫ pB
        rw [Category.assoc, hcUV]) trivial
  have h0 : (Limits.pullback.fst (e ≫ pB) i ≫ (e ≫ Limits.pullback.fst U.hom V.hom)) ≫ U.hom =
      Limits.pullback.snd (e ≫ pB) i ≫ i := by
    simp only [Category.assoc]
    rw [hp']
    exact Limits.pullback.condition
  have h0' : (Limits.pullback.fst (e ≫ pB) i ≫ (e ≫ Limits.pullback.snd U.hom V.hom)) ≫ V.hom =
      Limits.pullback.snd (e ≫ pB) i ≫ i := by
    simp only [Category.assoc]
    rw [hcUV]
    exact Limits.pullback.condition
  have hm : ((wcEtBaseChange i).map g).left =
      Limits.pullback.lift (Limits.pullback.fst (e ≫ pB) i ≫ (e ≫ Limits.pullback.fst U.hom V.hom))
        (Limits.pullback.snd (e ≫ pB) i) h0 := rfl
  have hm' : ((wcEtBaseChange i).map g').left =
      Limits.pullback.lift (Limits.pullback.fst (e ≫ pB) i ≫ (e ≫ Limits.pullback.snd U.hom V.hom))
        (Limits.pullback.snd (e ≫ pB) i) h0' := rfl
  have hMρ : ((wcEtBaseChange i).map g).left =
      (Limits.pullbackRightPullbackFstIso pB i e).inv ≫ h := by
    rw [hm]
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst]
      simp only [Category.assoc]
      rw [← hΓ1, reassoc_of% hh, Limits.pullbackRightPullbackFstIso_inv_snd_fst_assoc]
    · rw [Limits.pullback.lift_snd]
      simp only [Category.assoc]
      rw [← hΓs, reassoc_of% hh, Limits.pullbackRightPullbackFstIso_inv_snd_snd]
  have keyL : Limits.pullback.lift
      (Limits.pullback.fst (e ≫ pB) i ≫ (e ≫ Limits.pullback.snd U.hom V.hom))
      (Limits.pullback.snd (e ≫ pB) i) h0' =
      ((Limits.pullbackRightPullbackFstIso pB i e).inv ≫ h) ≫ φ := by
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst, Category.assoc, Category.assoc,
        ← hΓ2, reassoc_of% hh, Limits.pullbackRightPullbackFstIso_inv_snd_fst_assoc]
    · rw [Limits.pullback.lift_snd, Category.assoc, Category.assoc,
        hφ, ← hΓs, reassoc_of% hh, Limits.pullbackRightPullbackFstIso_inv_snd_snd]
  have key : (wcEtBaseChange i).map g' = (wcEtBaseChange i).map g ≫ f := by
    apply MorphismProperty.Over.Hom.ext
    show ((wcEtBaseChange i).map g').left = ((wcEtBaseChange i).map g).left ≫ f.left
    rw [← hφdef, hMρ, hm']
    exact keyL
  have hg : ((wcEtBaseChange i).imageSieve f).arrows g := ⟨g', key⟩
  refine ⟨(wcEtBaseChange i).obj W', (wcEtBaseChange i).map g,
    (Limits.pullbackRightPullbackFstIso pB i e).hom x',
    Sieve.image_mem_functorPushforward (wcEtBaseChange i) _ hg, ?_, ?_⟩
  · have hw : ((wcEtBaseChange i).map g).left ≫ ((wcEtBaseChange i).obj U).hom =
        ((wcEtBaseChange i).obj W').hom := MorphismProperty.Over.w _
    have h1 : Etale ((wcEtBaseChange i).obj U).hom := ((wcEtBaseChange i).obj U).prop
    have h2 : Etale (((wcEtBaseChange i).map g).left ≫ ((wcEtBaseChange i).obj U).hom) := by
      rw [hw]; exact ((wcEtBaseChange i).obj W').prop
    exact Etale.of_comp _ ((wcEtBaseChange i).obj U).hom
  · have hy : (Limits.pullbackRightPullbackFstIso pB i e).inv
        ((Limits.pullbackRightPullbackFstIso pB i e).hom x') = x' := by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      all_goals rfl
    have hpt : ((Limits.pullbackRightPullbackFstIso pB i e).inv ≫ h)
        ((Limits.pullbackRightPullbackFstIso pB i e).hom x') = x := by
      rw [Scheme.Hom.comp_apply, hy, hx']
    rw [hMρ]
    exact hpt

theorem wc_et_point_push_stalks : ∀ (Y : Scheme.{u}) (x : Y) (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (Spec (Y.residueField x))) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush (Y.fromSpecResidueField x)), (∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, IsIso ((wcEtStalk Y x).map (adj.unit.app G))) ∧ (∀ (H : Sheaf (Scheme.smallEtaleTopology (Spec (Y.residueField x))) AddCommGrpCat.{u+1}) (y : Y), y ∉ closure ({x} : Set Y) → Subsingleton ((wcEtStalk Y y).obj ((wcEtPush (Y.fromSpecResidueField x)).obj H))) :=
by
  intro Y x L adj

  have hstalk : ∀ b : Y, Nonempty ((Scheme.pointSmallEtale (wcEtGeomPt Y b)).sheafFiber
      (A := AddCommGrpCat.{u+1}) ≅ wcEtStalk Y b) := by
    intro b
    let Φ := Scheme.pointSmallEtale (wcEtGeomPt Y b)
    let E : StructuredArrow (Over.mk (wcEtGeomPt Y b)) (Scheme.Etale.forget Y) ⥤ Φ.fiber.Elements :=
      { obj := fun A => Φ.fiber.elementsMk A.right A.hom
        map := fun {A A'} g => ⟨g.right, StructuredArrow.w g⟩
        map_id := fun A => rfl
        map_comp := fun f g => rfl }
    let Einv : Φ.fiber.Elements ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y b)) (Scheme.Etale.forget Y) :=
      { obj := fun x => StructuredArrow.mk (T := Scheme.Etale.forget Y) (Y := x.1) x.2
        map := fun {x y} φ => StructuredArrow.homMk φ.1 φ.2
        map_id := fun x => rfl
        map_comp := fun f g => rfl }
    let eqv : StructuredArrow (Over.mk (wcEtGeomPt Y b)) (Scheme.Etale.forget Y) ≌ Φ.fiber.Elements :=
      CategoryTheory.Equivalence.mk E Einv (NatIso.ofComponents (fun A => Iso.refl _) (by intros; rfl))
        (NatIso.ofComponents (fun x => Iso.refl _) (by intros; rfl))
    haveI : E.IsEquivalence := eqv.isEquivalence_functor
    haveI : E.IsLeftAdjoint := Functor.isLeftAdjoint_of_isEquivalence
    haveI : E.Initial := Functor.initial_of_isLeftAdjoint E
    haveI : E.op.Final := Functor.final_op_of_initial E
    let i0 := Functor.Final.colimIso (E := AddCommGrpCat.{u+1}) E.op
    let i1 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (StructuredArrow.proj (Over.mk (wcEtGeomPt Y b)) (Scheme.Etale.forget Y)).op ⋙ Limits.colim ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (Functor.Elements.π Φ.fiber).op ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj
        (Functor.Elements.π Φ.fiber).op) i0
    exact ⟨Functor.isoWhiskerLeft (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      i1.symm⟩
  refine ⟨?_, ?_⟩
  ·
    intro G
    let i := Y.fromSpecResidueField x

    haveI hcd : (wcEtBaseChange i).IsCoverDense
        (Scheme.smallEtaleTopology (Spec (Y.residueField x))) := by
      constructor
      intro T
      choose V a ha using wc_et_residue_point_lift_cover Y x T
      refine GrothendieckTopology.superset_covering _ ?_
        ((Scheme.ofArrows_mem_smallEtaleTopology_iff (fun t : T.left => a t)).2
          (Set.eq_univ_of_forall (fun t => Set.mem_iUnion.2 ⟨t, ha t⟩)))
      rw [Sieve.ofArrows, Sieve.generate_le_iff]
      rintro W f ⟨t⟩
      exact Presieve.in_coverByImage _ (a t)
    haveI hlf : (wcEtBaseChange i).IsLocallyFull
        (Scheme.smallEtaleTopology (Spec (Y.residueField x))) :=
      wc_et_preimmersion_bc_locally_full i
    haveI hcounit : IsIso adj.counit := wc_et_push_counit_iso_of_dense_full i L adj
    have hR : (wcEtPush i).FullyFaithful := adj.fullyFaithfulROfIsIsoCounit
    let Φ := Scheme.pointSmallEtale (wcEtGeomPt Y x)
    let s₀ : Spec (.of (AlgebraicClosure (Y.residueField x))) ⟶ Spec (Y.residueField x) :=
      Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField x)
        (AlgebraicClosure (Y.residueField x))))
    let Ψ := Scheme.pointSmallEtale s₀
    have hsky : ∀ M : AddCommGrpCat.{u+1},
        Nonempty ((wcEtPush i).obj (Ψ.skyscraperSheaf M) ≅ Φ.skyscraperSheaf M) :=
      fun M => wc_et_push_skyscraper_iso i (AlgebraicClosure (Y.residueField x)) s₀ M
    let a₁ := Φ.skyscraperSheafAdjunction (A := AddCommGrpCat.{u+1})
    have key : ∀ T : AddCommGrpCat.{u+1}, Function.Bijective
        (fun h : (wcEtPush i).obj (L.obj G) ⟶ Φ.skyscraperSheaf T => adj.unit.app G ≫ h) := by
      intro T
      obtain ⟨e⟩ := hsky T
      have h1 : Function.Bijective (fun k : L.obj G ⟶ Ψ.skyscraperSheaf T =>
          adj.unit.app G ≫ (wcEtPush i).map k) := by
        have := (adj.homEquiv G (Ψ.skyscraperSheaf T)).bijective
        convert this using 1
        funext k
        rw [Adjunction.homEquiv_unit]
      have h2 : Function.Bijective (fun k : (wcEtPush i).obj (L.obj G) ⟶
          (wcEtPush i).obj (Ψ.skyscraperSheaf T) => adj.unit.app G ≫ k) := by
        rw [← Function.Bijective.of_comp_iff _ (hR.map_bijective (L.obj G) (Ψ.skyscraperSheaf T))]
        exact h1
      have hpost : Function.Bijective (fun k : G ⟶
          (wcEtPush i).obj (Ψ.skyscraperSheaf T) => k ≫ e.hom) := by
        rw [Function.bijective_iff_has_inverse]
        exact ⟨fun k => k ≫ e.inv, fun k => by simp, fun k => by simp⟩
      have hpre : Function.Bijective (fun k : (wcEtPush i).obj (L.obj G) ⟶
          Φ.skyscraperSheaf T => k ≫ e.inv) := by
        rw [Function.bijective_iff_has_inverse]
        exact ⟨fun k => k ≫ e.hom, fun k => by simp, fun k => by simp⟩
      have hb := hpost.comp (h2.comp hpre)
      convert hb using 1
      funext h
      simp
    have hiso : IsIso (Φ.sheafFiber.map (adj.unit.app G)) := by
      apply isIso_of_coyoneda_map_bijective
      intro T
      have hb0 := (a₁.homEquiv G T).symm.bijective.comp
        ((key T).comp (a₁.homEquiv ((wcEtPush i).obj (L.obj G)) T).bijective)
      have hb : Function.Bijective (fun g : Φ.sheafFiber.obj ((wcEtPush i).obj (L.obj G)) ⟶ T =>
          Φ.sheafFiber.map (adj.unit.app G) ≫ g) := by
        have hfun : (fun g : Φ.sheafFiber.obj ((wcEtPush i).obj (L.obj G)) ⟶ T =>
            Φ.sheafFiber.map (adj.unit.app G) ≫ g) =
            ⇑(a₁.homEquiv G T).symm ∘ (fun h => adj.unit.app G ≫ h) ∘
              ⇑(a₁.homEquiv ((wcEtPush i).obj (L.obj G)) T) := by
          funext g
          simp only [Function.comp_apply]
          apply (a₁.homEquiv G T).injective
          rw [Equiv.apply_symm_apply]
          exact a₁.homEquiv_naturality_left (adj.unit.app G) g
        rw [hfun]
        exact hb0
      exact hb
    obtain ⟨eS⟩ := hstalk x
    exact (NatIso.isIso_map_iff eS (adj.unit.app G)).mp hiso
  ·
    intro H y hy
    let i := Y.fromSpecResidueField x

    have hS10 : ∀ O' : (Spec (Y.residueField x)).Etale, IsEmpty O'.left →
        Limits.IsZero (H.obj.obj (Opposite.op O')) := by
      intro O' hO'
      have hmem : Sieve.ofArrows (fun _ : PEmpty.{u+1} => O') (fun e => e.elim) ∈
          Scheme.smallEtaleTopology _ O' := by
        rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
        exact Set.eq_univ_of_forall (fun p => isEmptyElim p)
      have hbot : (⊥ : Sieve O') ∈ Scheme.smallEtaleTopology _ O' := by
        refine GrothendieckTopology.superset_covering _ ?_ hmem
        rintro W f ⟨Z, g, h, ⟨e⟩, _⟩
        exact e.elim
      exact (Sheaf.isTerminalOfBotCover H O' hbot).isZero
    let Φy := Scheme.pointSmallEtale (wcEtGeomPt Y y)
    let P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} := (wcEtBaseChange i).op ⋙ H.obj
    let U : Y.Opens := ⟨(closure ({x} : Set Y))ᶜ, isClosed_closure.isOpen_compl⟩
    have hP : Limits.IsZero (Φy.presheafFiber.obj P) := by
      rw [Limits.IsZero.iff_id_eq_zero]
      apply Φy.presheafFiber_hom_ext
      intro X t
      rw [Category.comp_id, Limits.comp_zero]
      let t0 : Over.mk (wcEtGeomPt Y y) ⟶ (Scheme.Etale.forget Y).obj X := t
      let tl : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ X.left := t0.left
      have hw : tl ≫ X.hom = wcEtGeomPt Y y := Over.w t0
      let O : X.left.Opens := X.hom ⁻¹ᵁ U
      have hrange : Set.range tl ⊆ Set.range O.ι := by
        have hO : Set.range O.ι = (O : Set X.left) := Scheme.Opens.range_ι O
        rw [hO]
        rintro _ ⟨p, rfl⟩
        have h1 : X.hom (tl p) = (wcEtGeomPt Y y) p := by
          rw [← hw, Scheme.Hom.comp_apply]
        have h2 : (wcEtGeomPt Y y) p = y :=
          (Scheme.Hom.comp_apply _ (Y.fromSpecResidueField y) p).trans
            (Scheme.fromSpecResidueField_apply y _)
        show X.hom (tl p) ∈ (U : Set Y)
        rw [h1, h2]
        exact hy
      let t'l := IsOpenImmersion.lift O.ι tl hrange
      have hfac : t'l ≫ O.ι = tl := IsOpenImmersion.lift_fac O.ι tl hrange
      let t'0 : Over.mk (wcEtGeomPt Y y) ⟶ (Scheme.Etale.forget Y).obj (wcEtOpen Y X O) :=
        Over.homMk t'l (by
          show t'l ≫ (O.ι ≫ X.hom) = wcEtGeomPt Y y
          rw [← Category.assoc, hfac]
          exact hw)
      let t' : Φy.fiber.obj (wcEtOpen Y X O) := t'0
      have ht' : Φy.fiber.map (wcEtOpenι Y X O) t' = t := by
        change (t'0 ≫ (Scheme.Etale.forget Y).map (wcEtOpenι Y X O) :
          Over.mk (wcEtGeomPt Y y) ⟶ _) = t0
        apply Over.OverMorphism.ext
        exact hfac
      have hempty : IsEmpty ((wcEtBaseChange i).obj (wcEtOpen Y X O)).left := by
        change IsEmpty ↥(Limits.pullback (O.ι ≫ X.hom) i)
        apply Scheme.isEmpty_pullback
        rw [Set.disjoint_left]
        rintro _ ⟨q, rfl⟩ ⟨r, hr⟩
        have hr' : i r = x := Scheme.fromSpecResidueField_apply x r
        have hO : Set.range O.ι = (O : Set X.left) := Scheme.Opens.range_ι O
        have hq' : O.ι q ∈ (O : Set X.left) := by
          rw [← hO]; exact ⟨q, rfl⟩
        have hq'' : X.hom (O.ι q) ∈ (U : Set Y) := hq'
        have : X.hom (O.ι q) = x := by
          rw [← hr', hr, Scheme.Hom.comp_apply]
        rw [this] at hq''
        exact hq'' (subset_closure rfl)
      have hzero : Limits.IsZero (P.obj (Opposite.op (wcEtOpen Y X O))) :=
        hS10 _ hempty
      have hw2 := Φy.toPresheafFiber_w (wcEtOpenι Y X O) t' P
      rw [ht'] at hw2
      rw [← hw2, hzero.eq_of_tgt (P.map (wcEtOpenι Y X O).op) 0, Limits.zero_comp]
    let e1 : Φy.sheafFiber.obj ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P) ≅
        Φy.presheafFiber.obj P :=
      (Φy.presheafToSheafCompSheafFiberIso AddCommGrpCat.{u+1}).app P
    have h2 : Limits.IsZero (Φy.sheafFiber.obj
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P)) :=
      hP.of_iso e1
    obtain ⟨eS⟩ := hstalk y
    have h3 : Limits.IsZero ((wcEtStalk Y y).obj
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P)) :=
      h2.of_iso (eS.app _).symm
    exact AddCommGrpCat.isZero_iff_subsingleton.mp h3

theorem wc_et_point_devissage_step : ∀ (Y : Scheme.{u}) (ℓ D : ℕ) (s : Y) (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (Spec (Y.residueField s))) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush (Y.fromSpecResidueField s)) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), (∀ y : Y, Limits.PreservesFiniteLimits (wcEtStalk Y y) ∧ Limits.PreservesFiniteColimits (wcEtStalk Y y)) → ℓ • 𝟙 G = 0 → IsIso ((wcEtStalk Y s).map (adj.unit.app G)) → (∀ y : Y, y ≠ s → (D : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set Y)) → Subsingleton ((wcEtStalk Y y).obj ((wcEtPush (Y.fromSpecResidueField s)).obj (L.obj G)))) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; (∀ q : ℕ, 2 * D < q → ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((wcEtPush (Y.fromSpecResidueField s)).obj (L.obj G)) q, z = 0) → (∀ H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, ℓ • 𝟙 H = 0 → (∀ y : Y, (D : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set Y)) → Subsingleton ((wcEtStalk Y y).obj H)) → ∀ q : ℕ, 2 * D < q + 1 → ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) H q, z = 0) → (∀ y : Y, ¬ Subsingleton ((wcEtStalk Y y).obj (Limits.kernel (adj.unit.app G))) → ¬ Subsingleton ((wcEtStalk Y y).obj G) ∧ y ≠ s) ∧ ℓ • 𝟙 (Limits.kernel (adj.unit.app G)) = 0 ∧ ((∀ q : ℕ, 2 * D < q → ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.kernel (adj.unit.app G)) q, z = 0) → ∀ q : ℕ, 2 * D < q → ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G q, z = 0) :=
by
  classical
  intro Y ℓ D s L adj G hex hG hiso hoff
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro h1 h2

  have stk : ∀ (y : Y) {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (f : A ⟶ B),
      (Subsingleton ((wcEtStalk Y y).obj A) →
        Subsingleton ((wcEtStalk Y y).obj (Limits.kernel f))) ∧
      (Subsingleton ((wcEtStalk Y y).obj B) →
        Subsingleton ((wcEtStalk Y y).obj (Limits.cokernel f))) ∧
      (IsIso ((wcEtStalk Y y).map f) →
        Subsingleton ((wcEtStalk Y y).obj (Limits.kernel f)) ∧
        Subsingleton ((wcEtStalk Y y).obj (Limits.cokernel f))) := by
    intro y A B f
    haveI := (hex y).1
    haveI := (hex y).2
    refine ⟨fun hA => ?_, fun hB => ?_, fun hI => ⟨?_, ?_⟩⟩
    · haveI := hA
      have hm : Mono ((wcEtStalk Y y).map (Limits.kernel.ι f)) := inferInstance
      exact ((AddCommGrpCat.mono_iff_injective _).mp hm).subsingleton
    · haveI := hB
      have he : Epi ((wcEtStalk Y y).map (Limits.cokernel.π f)) := inferInstance
      exact ((AddCommGrpCat.epi_iff_surjective _).mp he).subsingleton
    · haveI := hI
      have h0 : (wcEtStalk Y y).map (Limits.kernel.ι f) = 0 := by
        rw [← cancel_mono ((wcEtStalk Y y).map f), ← Functor.map_comp, Limits.kernel.condition,
          Functor.map_zero, Limits.zero_comp]
      have hm : Mono ((wcEtStalk Y y).map (Limits.kernel.ι f)) := inferInstance
      rw [h0] at hm
      haveI := hm
      exact AddCommGrpCat.isZero_iff_subsingleton.mp
        (Limits.IsZero.of_mono_zero _ ((wcEtStalk Y y).obj A))
    · haveI := hI
      have h0 : (wcEtStalk Y y).map (Limits.cokernel.π f) = 0 := by
        rw [← cancel_epi ((wcEtStalk Y y).map f), ← Functor.map_comp, Limits.cokernel.condition,
          Functor.map_zero, Limits.comp_zero]
      have he : Epi ((wcEtStalk Y y).map (Limits.cokernel.π f)) := inferInstance
      rw [h0] at he
      haveI := he
      exact AddCommGrpCat.isZero_iff_subsingleton.mp
        (Limits.IsZero.of_epi_zero ((wcEtStalk Y y).obj B) _)

  haveI : (wcEtPush (Y.fromSpecResidueField s)).IsRightAdjoint := adj.isRightAdjoint
  haveI : (wcEtPush (Y.fromSpecResidueField s)).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI : L.Additive := Adjunction.left_adjoint_additive adj

  have hP : ℓ • 𝟙 ((wcEtPush (Y.fromSpecResidueField s)).obj (L.obj G)) = 0 := by
    have h : (wcEtPush (Y.fromSpecResidueField s)).map (L.map (ℓ • 𝟙 G)) = 0 := by
      rw [hG, CategoryTheory.Functor.map_zero, CategoryTheory.Functor.map_zero]
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_nsmul, L.map_id G,
      (wcEtPush (Y.fromSpecResidueField s)).map_id (L.obj G)] at h
    exact h
  have torK : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (f : A ⟶ B),
      ℓ • 𝟙 A = 0 → ℓ • 𝟙 (Limits.kernel f) = 0 := by
    intro A B f hA
    rw [← cancel_mono (Limits.kernel.ι f), Preadditive.nsmul_comp,
      Category.id_comp, Limits.zero_comp]
    have h : Limits.kernel.ι f ≫ (ℓ • 𝟙 A) = 0 := by
      rw [hA, Limits.comp_zero]
    rw [Preadditive.comp_nsmul, Category.comp_id] at h
    exact h
  have torC : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (f : A ⟶ B),
      ℓ • 𝟙 B = 0 → ℓ • 𝟙 (Limits.cokernel f) = 0 := by
    intro A B f hB
    rw [← cancel_epi (Limits.cokernel.π f), Preadditive.comp_nsmul,
      Category.comp_id, Limits.comp_zero]
    have h : (ℓ • 𝟙 B) ≫ Limits.cokernel.π f = 0 := by
      rw [hB, Limits.zero_comp]
    rw [Preadditive.nsmul_comp, Category.id_comp] at h
    exact h
  have hK : ℓ • 𝟙 (Limits.kernel (adj.unit.app G)) = 0 := torK (adj.unit.app G) hG
  have hC : ℓ • 𝟙 (Limits.cokernel (adj.unit.app G)) = 0 := torC (adj.unit.app G) hP

  have hCst : ∀ y : Y, (D : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set Y)) →
      Subsingleton ((wcEtStalk Y y).obj (Limits.cokernel (adj.unit.app G))) := by
    intro y hy
    by_cases hys : y = s
    · rw [hys]
      exact ((stk s (adj.unit.app G)).2.2 hiso).2
    · exact (stk y (adj.unit.app G)).2.1 (hoff y hys hy)

  have w1 : Limits.kernel.ι (adj.unit.app G) ≫ Abelian.factorThruImage (adj.unit.app G) = 0 := by
    rw [← cancel_mono (Abelian.image.ι (adj.unit.app G)), Category.assoc, Abelian.image.fac,
      Limits.kernel.condition, Limits.zero_comp]
  have hS1 : (ShortComplex.mk _ _ w1).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _
      (Limits.isKernelOfComp _ _ (Limits.kernelIsKernel _) w1 (Abelian.image.fac _)))
      inferInstance inferInstance
  have w2 : Abelian.image.ι (adj.unit.app G) ≫ Limits.cokernel.π (adj.unit.app G) = 0 := by
    rw [← cancel_epi (Abelian.factorThruImage (adj.unit.app G)), ← Category.assoc,
      Abelian.image.fac, Limits.cokernel.condition, Limits.comp_zero]
  have hS2 : (ShortComplex.mk _ _ w2).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
      (Limits.isCokernelOfComp _ _ (Limits.cokernelIsCokernel _) w2 (Abelian.image.fac _)))
      inferInstance inferInstance
  refine ⟨fun y hy => ⟨fun hGy => hy ((stk y (adj.unit.app G)).1 hGy), fun hys => ?_⟩, hK, ?_⟩
  · rw [hys] at hy
    exact hy ((stk s (adj.unit.app G)).2.2 hiso).1
  · intro hKv q hq z
    have hCv := h2 _ hC hCst (q - 1) (by omega)
    have hJv : ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
        (Abelian.image (adj.unit.app G)) q, x = 0 := by
      intro x
      have hx0 : x.comp (Abelian.Ext.mk₀ (ShortComplex.mk _ _ w2).f) (add_zero q) = 0 :=
        h1 q hq _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS2 x hx0
        (show q - 1 + 1 = q by omega)
      rw [← hx₃, hCv x₃, Abelian.Ext.zero_comp]
    have hz0 : z.comp (Abelian.Ext.mk₀ (ShortComplex.mk _ _ w1).g) (add_zero q) = 0 := hJv _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS1 z hz0
    rw [← hx₁, hKv q hq x₁, Abelian.Ext.zero_comp]

theorem wc_et_smooth_qcqs_module_cd : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsSeparated f] [QuasiCompact f] (e : ℕ) [SmoothOfRelativeDimension e f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (G : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _; ∀ (p : ℕ), 2 * e < p → ∀ y : Abelian.Ext (SheafOfModules.unit (wcEtZModRing Y ℓ)) G p, y = 0 :=
by
  classical
  intro K _ _ Y f _ _ e _ ℓ _ hℓK G
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  intro p hp y
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : Smooth f := SmoothOfRelativeDimension.smooth e f
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives Y
  have hℓ : ℓ.Prime := Fact.out

  have hlt_succ : ∀ (n : ℕ) (a : WithBot ℕ∞), (n : WithBot ℕ∞) < a →
      ((n + 1 : ℕ) : WithBot ℕ∞) ≤ a := by
    intro n a h
    induction a using WithBot.recBotCoe with
    | bot => exact absurd h (not_lt_bot)
    | coe b =>
      have h' : ((n : ℕ∞) : WithBot ℕ∞) < (b : WithBot ℕ∞) := by simpa using h
      have h'' : (n : ℕ∞) < b := WithBot.coe_lt_coe.mp h'
      have h3 : ((n : ℕ∞) + 1) ≤ b := Order.add_one_le_of_lt h''
      have h4 : (((n + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) ≤ (b : WithBot ℕ∞) := by
        exact WithBot.coe_le_coe.mpr (by exact_mod_cast h3)
      simpa using h4
  have hnoloop : ∀ (b : WithBot ℕ∞) (D : ℕ), (D : WithBot ℕ∞) ≤ b →
      b + 1 ≤ (D : WithBot ℕ∞) → False := by
    intro b D h1 h2
    have h : (D : WithBot ℕ∞) + 1 ≤ (D : WithBot ℕ∞) := le_trans (add_le_add_left h1 1) h2
    have h' : ((D + 1 : ℕ) : WithBot ℕ∞) ≤ (D : WithBot ℕ∞) := by push_cast; exact h
    have : D + 1 ≤ D := by exact_mod_cast h'
    omega

  have hzero : ∀ (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      (∀ b : Y, Subsingleton ((wcEtStalk Y b).obj F)) → ∀ (q : ℕ)
      (z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q), z = 0 := by
    intro F hF q z
    have hz := wc_et_stalks_zero F hF
    calc z = z.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero q) := (Abelian.Ext.comp_mk₀_id z).symm
      _ = z.comp (Abelian.Ext.mk₀ 0) (add_zero q) := by rw [hz.eq_of_tgt (𝟙 _) 0]
      _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have stalkmono : ∀ (A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (j : A ⟶ B),
      Mono j → ∀ x : Y, Subsingleton ((wcEtStalk Y x).obj B) →
      Subsingleton ((wcEtStalk Y x).obj A) := by
    intro A B j hj x hB
    haveI := (wc_et_stalk_exact Y x).1
    have hm : Mono ((wcEtStalk Y x).map j) := inferInstance
    exact ((AddCommGrpCat.mono_iff_injective _).mp hm).subsingleton

  have SUPP : ∀ D : ℕ, ∀ F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ℓ • 𝟙 F = 0 →
      (∀ x : Y, (D : WithBot ℕ∞) < topologicalKrullDim ↥(closure ({x} : Set Y)) →
        Subsingleton ((wcEtStalk Y x).obj F)) →
      ∀ q : ℕ, 2 * D < q →
      ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q, z = 0 := by
    intro D
    induction D using Nat.strong_induction_on with
    | h D IH =>

      have LOW : ∀ H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, ℓ • 𝟙 H = 0 →
          (∀ y : Y, (D : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set Y)) →
            Subsingleton ((wcEtStalk Y y).obj H)) →
          ∀ q : ℕ, 2 * D < q + 1 →
          ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) H q, z = 0 := by
        intro H hH hst q hq z
        rcases Nat.eq_zero_or_pos D with hD | hD
        · refine hzero H (fun y => hst y ?_) q z
          rw [hD, Nat.cast_zero]
          exact (wc_closure_point_krullDim_facts Y y y 0).1
        · refine IH (D - 1) (by omega) H hH (fun y hy => hst y ?_) q (by omega) z
          have h1 := hlt_succ (D - 1) _ hy
          rwa [show D - 1 + 1 = D by omega] at h1

      have GEN : ∀ a : Y, topologicalKrullDim ↥(closure ({a} : Set Y)) ≤ (D : WithBot ℕ∞) →
          ∀ (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤
              Sheaf (Scheme.smallEtaleTopology (Spec (Y.residueField a))) AddCommGrpCat.{u+1})
            (adj : L ⊣ wcEtPush (Y.fromSpecResidueField a)), Limits.PreservesFiniteLimits L →
          Nonempty (L.obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
              (AddCommGrpCat.of (ULift.{u+1} ℤ))) ≅
            (constantSheaf (Scheme.smallEtaleTopology (Spec (Y.residueField a)))
              AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) →
          ∀ Gs : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, ℓ • 𝟙 Gs = 0 →
          ∀ q : ℕ, 2 * D < q →
          ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
            ((wcEtPush (Y.fromSpecResidueField a)).obj (L.obj Gs)) q, z = 0 := by
        intro a ha L adj hL hLZ Gs hGs
        obtain ⟨eL⟩ := hLZ
        letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (Y.residueField a)))
          AddCommGrpCat.{u+1}) := HasExt.standard _
        haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology (Spec (Y.residueField a)))
          AddCommGrpCat.{u+1}) := wc_et_enough_injectives _
        haveI : L.IsLeftAdjoint := adj.isLeftAdjoint
        haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
        haveI : L.Additive := Functor.additive_of_preserves_binary_products _
        haveI : (wcEtPush (Y.fromSpecResidueField a)).Additive :=
          Adjunction.right_adjoint_additive adj
        have htA : ℓ • 𝟙 (L.obj Gs) = 0 := by
          have h := congrArg L.map hGs
          rw [Functor.map_nsmul, L.map_id, L.map_zero] at h
          exact h
        refine wc_ext_leray_edge_vanishing L (wcEtPush (Y.fromSpecResidueField a)) adj _
          (L.obj Gs) (injectiveResolution (L.obj Gs)) (2 * D) ?_ ?_
        · intro m hm z
          have h0 : (Abelian.Ext.mk₀ eL.inv).comp z (zero_add m) = 0 :=
            wc_et_residue_field_cd_le K Y f ℓ hℓ hℓK a D ha (L.obj Gs) htA m (by omega) _
          calc z = (Abelian.Ext.mk₀ (𝟙 _)).comp z (zero_add m) := (Abelian.Ext.mk₀_id_comp z).symm
            _ = ((Abelian.Ext.mk₀ eL.hom).comp (Abelian.Ext.mk₀ eL.inv) (add_zero 0)).comp z
                  (zero_add m) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
            _ = (Abelian.Ext.mk₀ eL.hom).comp ((Abelian.Ext.mk₀ eL.inv).comp z (zero_add m))
                  (zero_add m) :=
                Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add m) (by omega)
            _ = 0 := by rw [h0, Abelian.Ext.comp_zero]
        · intro a' s hs hsum z
          have htH := wc_rightDerived_homology_nsmul_zero (wcEtPush (Y.fromSpecResidueField a))
            (L.obj Gs) (injectiveResolution (L.obj Gs)) ℓ htA s
          by_cases hsD : s ≤ D
          · exact IH (D - s) (by omega) _ htH
              (fun y hy => wc_et_point_push_higher_stalk_vanish K Y f ℓ hℓ hℓK a y D (D - s + 1) s
                ha (hlt_succ (D - s) _ hy) (by omega) (L.obj Gs) htA
                (injectiveResolution (L.obj Gs))) a' (by omega) z
          · exact hzero _
              (fun y => wc_et_point_push_higher_stalk_vanish K Y f ℓ hℓ hℓK a y D 0 s ha
                (by rw [Nat.cast_zero]; exact (wc_closure_point_krullDim_facts Y y y 0).1)
                (by omega) (L.obj Gs) htA (injectiveResolution (L.obj Gs))) a' z

      have FIN : ∀ S : Finset Y,
          (∀ s ∈ S, topologicalKrullDim ↥(closure ({s} : Set Y)) ≤ (D : WithBot ℕ∞)) →
          ∀ F'' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, ℓ • 𝟙 F'' = 0 →
          (∀ x : Y, (D : WithBot ℕ∞) < topologicalKrullDim ↥(closure ({x} : Set Y)) →
            Subsingleton ((wcEtStalk Y x).obj F'')) →
          (∀ y : Y, ¬ Subsingleton ((wcEtStalk Y y).obj F'') →
            (D : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set Y)) → y ∈ S) →
          ∀ q : ℕ, 2 * D < q →
          ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
            AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F'' q, z = 0 := by
        intro S
        induction S using Finset.induction_on with
        | empty =>
          intro _ F'' hF _ hS q hq z
          refine LOW F'' hF (fun y hy => ?_) q (by omega) z
          by_contra hns
          have hmem := hS y hns hy
          simp at hmem
        | insert a S₀ haS IHS =>
          intro hSD F'' hF hstk hS q hq z
          have ha : topologicalKrullDim ↥(closure ({a} : Set Y)) ≤ (D : WithBot ℕ∞) :=
            hSD a (Finset.mem_insert_self a S₀)
          obtain ⟨L, ⟨adj⟩, hL, hLZ⟩ := wc_et_push_left_adjoint (Y.fromSpecResidueField a)
          have hoff : ∀ y : Y, y ≠ a →
              (D : WithBot ℕ∞) ≤ topologicalKrullDim ↥(closure ({y} : Set Y)) →
              Subsingleton ((wcEtStalk Y y).obj
                ((wcEtPush (Y.fromSpecResidueField a)).obj (L.obj F''))) := by
            intro y hya hDy
            refine (wc_et_point_push_stalks Y a L adj).2 (L.obj F'') y ?_
            intro hycl
            exact hnoloop _ D hDy
              (le_trans ((wc_closure_point_krullDim_facts Y a y D).2.2 hycl hya ha) ha)
          obtain ⟨hK1, hK2, hK3⟩ := wc_et_point_devissage_step Y ℓ D a L adj F''
            (fun y => wc_et_stalk_exact Y y) hF ((wc_et_point_push_stalks Y a L adj).1 F'')
            hoff (GEN a ha L adj hL hLZ F'' hF) LOW
          refine hK3 ?_ q hq z
          refine IHS (fun s hs => hSD s (Finset.mem_insert_of_mem hs)) _ hK2 ?_ ?_
          · intro x hx
            by_contra hns
            exact (hK1 x hns).1 (hstk x hx)
          · intro y hy hDy
            obtain ⟨hy1, hy2⟩ := hK1 y hy
            rcases Finset.mem_insert.mp (hS y hy1 hDy) with h | h
            · exact absurd h hy2
            · exact h

      intro F hF hstk q hq z
      refine wc_et_finite_generic_support_reduction K Y f (2 * D) F ?_ q hq z
      intro G' j hj S hS1 hS2 q' hq' z'
      have hG' : ℓ • 𝟙 G' = 0 := by
        rw [← cancel_mono j, Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp]
        have h : j ≫ (ℓ • 𝟙 F) = 0 := by rw [hF, Limits.comp_zero]
        rw [Preadditive.comp_nsmul, Category.comp_id] at h
        exact h
      have hsD : ∀ s ∈ S, topologicalKrullDim ↥(closure ({s} : Set Y)) ≤ (D : WithBot ℕ∞) := by
        intro s hs
        by_contra hlt
        exact hS1 s hs (stalkmono G' F j hj s (hstk s (not_le.mp hlt)))
      refine FIN S hsD G' hG' (fun x hx => stalkmono G' F j hj x (hstk x hx)) ?_ q' hq' z'
      intro y hy hDy
      obtain ⟨s, hs, hys⟩ := hS2 y hy
      by_cases hys' : y = s
      · rw [hys']; exact hs
      · exact absurd (hnoloop _ D hDy
          (le_trans ((wc_closure_point_krullDim_facts Y s y D).2.2 hys hys' (hsD s hs))
            (hsD s hs))) id

  have hF := wc_et_zmod_toSheaf_nsmul_zero Y ℓ G
  have hdimY := wc_smooth_alg_closed_dim_le K Y f e
  have hvan := SUPP e ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj G) hF
    (fun x hx => absurd hx
      (not_lt.mpr (le_trans (wc_closure_point_krullDim_facts Y x x 0).2.1 hdimY))) p hp
  obtain ⟨E⟩ := wc_et_zmod_modext_toSheaf_equiv Y ℓ hℓ.pos G p
  haveI : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj G) p) :=
    ⟨fun a b => by rw [hvan a, hvan b]⟩
  haveI := E.subsingleton
  exact Subsingleton.elim _ _

theorem wc_et_smooth_pair_supp_high_vanishing : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [IsSeparated fX] [QuasiCompact fX] (n e : ℕ) [SmoothOfRelativeDimension n fX] (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension e (i ≫ fX)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (V : X.Opens), (V : Set X) = (Set.range i)ᶜ → ∀ (N : SheafOfModules.{u+1} (wcEtZModRing X ℓ)) (ι : N ⟶ SheafOfModules.unit (wcEtZModRing X ℓ)), Mono ι → Nonempty ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj N ≅ wcEtExtZero X (V : Set X) ℓ) → letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _; ∀ (q : ℕ), 2 * n < q → ∀ x : Abelian.Ext (Limits.cokernel ι) (SheafOfModules.unit (wcEtZModRing X ℓ)) q, x = 0 :=
by
  classical
  intro K _ _ X fX _ _ n e _ Z i _ _ ℓ _ hℓK V hV N ι hι hN
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _
  intro q hq x
  obtain ⟨D⟩ := wc_et_zmod_pull_data_exists i ℓ
  haveI := D.additive

  haveI hPadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).Additive :=
    Adjunction.right_adjoint_additive D.adj
  haveI hPlim : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) := by
    haveI := D.adj.rightAdjoint_preservesLimits.{0, 0}
    exact Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} _

  haveI hLA := wc_et_closed_push_modules_isLeftAdjoint_u1 i ℓ D
  haveI hRadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).rightAdjoint.Additive :=
    Adjunction.right_adjoint_additive
      (Adjunction.ofIsLeftAdjoint (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ))
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Z) (wcEtZModRing Z ℓ)
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology X) (wcEtZModRing X ℓ)

  have hL := wc_leray_ext_vanishing
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ)
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).rightAdjoint
    (Adjunction.ofIsLeftAdjoint (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ))
    (SheafOfModules.unit (wcEtZModRing Z ℓ)) (SheafOfModules.unit (wcEtZModRing X ℓ))
    (injectiveResolution (SheafOfModules.unit (wcEtZModRing X ℓ))) (2 * n)
    (by
      intro p m hpm y
      by_cases hm : 2 * n < m + 2 * e
      · have hz := wc_et_closed_push_rightAdj_high_vanishing K X fX n e Z i ℓ hℓK D
          (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).rightAdjoint
          (Adjunction.ofIsLeftAdjoint (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ))
          (injectiveResolution (SheafOfModules.unit (wcEtZModRing X ℓ))) m hm
        calc y = y.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id y).symm
          _ = y.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hz.eq_of_tgt (𝟙 _) 0]
          _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      · exact wc_et_smooth_qcqs_module_cd K Z (i ≫ fX) e ℓ hℓK _ p (by omega) y)

  obtain ⟨φ⟩ := wc_et_closed_coker_supp_obj_iso i ℓ V hV N ι hι hN D
  have h0 : (Abelian.Ext.mk₀ φ.inv).comp x (zero_add q) = 0 := hL q hq _
  calc x = (Abelian.Ext.mk₀ (𝟙 _)).comp x (zero_add q) := (Abelian.Ext.mk₀_id_comp x).symm
    _ = ((Abelian.Ext.mk₀ φ.hom).comp (Abelian.Ext.mk₀ φ.inv) (add_zero 0)).comp x (zero_add q) := by
        rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
    _ = (Abelian.Ext.mk₀ φ.hom).comp ((Abelian.Ext.mk₀ φ.inv).comp x (zero_add q)) (zero_add q) :=
        Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega)
    _ = 0 := by rw [h0, Abelian.Ext.comp_zero]

theorem wc_et_open_supp_semipurity : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsSeparated f] [QuasiCompact f] (d : ℕ) [SmoothOfRelativeDimension d f] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (U : Y.Opens) (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (ι : N ⟶ SheafOfModules.unit (wcEtZModRing Y ℓ)), Mono ι → Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅ wcEtExtZero Y (U : Set Y) ℓ) → letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _; ∀ (q : ℕ), 2 * d < q → ∀ x : Abelian.Ext (Limits.cokernel ι) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q, x = 0 :=
by
  classical
  intro K _ _ Y f _ _ d _ ℓ _ hℓK
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  haveI : Smooth f := SmoothOfRelativeDimension.smooth d f
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  haveI : IsNoetherian Y := {}
  have key : ∀ (U : Y.Opens) (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ))
      (ι : N ⟶ SheafOfModules.unit (wcEtZModRing Y ℓ)), Mono ι →
      Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅ wcEtExtZero Y (U : Set Y) ℓ) →
      ∀ (q : ℕ), 2 * d < q →
      ∀ x : Abelian.Ext (Limits.cokernel ι) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q, x = 0 := by
    intro U0
    refine WellFoundedGT.induction (motive := fun U : Y.Opens =>
      ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ))
      (ι : N ⟶ SheafOfModules.unit (wcEtZModRing Y ℓ)), Mono ι →
      Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅ wcEtExtZero Y (U : Set Y) ℓ) →
      ∀ (q : ℕ), 2 * d < q →
      ∀ x : Abelian.Ext (Limits.cokernel ι) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q, x = 0)
      U0 ?_
    intro U IH N ι hι hN q hq x
    by_cases hU : U = ⊤
    · haveI hepi : Epi ι := wc_et_open_supp_top_epi Y ℓ U hU N ι hι hN
      have hz : Limits.IsZero (Limits.cokernel ι) := Limits.isZero_cokernel_of_epi ι
      calc x = (Abelian.Ext.mk₀ (𝟙 _)).comp x (zero_add q) := (Abelian.Ext.mk₀_id_comp x).symm
        _ = (Abelian.Ext.mk₀ 0).comp x (zero_add q) := by rw [hz.eq_of_src (𝟙 _) 0]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
    · obtain ⟨U', e, Z, i, hUU', hi, hsmZ, hrange, hsmU', hsepU', hqcU'⟩ :=
        wc_et_open_supp_smooth_stratum K Y f d U hU
      obtain ⟨N', ι', hι', hN'⟩ := wc_et_extzero_module_mono Y U' ℓ hℓpos
      obtain ⟨NV, ιV, hιV, hNV⟩ :=
        wc_et_extzero_module_mono (U' : Scheme.{u}) (U'.ι ⁻¹ᵁ U) ℓ hℓpos
      have h1 := IH U' hUU' N' ι' hι' hN' q hq
      haveI := hi
      haveI := hsmZ
      haveI := hsmU'
      haveI := hsepU'
      haveI := hqcU'
      have h2 := wc_et_smooth_pair_supp_high_vanishing K (U' : Scheme.{u}) (U'.ι ≫ f) d e Z i ℓ
        hℓK (U'.ι ⁻¹ᵁ U) (by rw [hrange, compl_compl]) NV ιV hιV hNV q hq
      exact wc_et_open_supp_les_step Y ℓ U U' hUU'.le N ι hι hN N' ι' hι' hN' NV ιV hιV hNV q
        h1 h2 x
  intro U N ι hι hN
  exact key U N ι hι hN

theorem wc_et_open_top_vanishing : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (Y : Scheme.{u})
    (f : Y ⟶ Spec (.of Ω)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f]
    [IrreducibleSpace Y] (W : Scheme.{u}) (j : W ⟶ Y) [IsOpenImmersion j],
    Set.range j ≠ Set.univ → ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 →
    Subsingleton (wcEtCoh W ℓ (2 * d)) :=
by
  classical
  intro Ω _ _ Y f _ d _ _ W j _ hne ℓ hℓ hℓΩ
  haveI hfact : Fact (Nat.Prime ℓ) := ⟨hℓ⟩
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  have hℓpos : 0 < ℓ := hℓ.pos

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  have hopen : IsOpen (Set.range j) := j.isOpenEmbedding.isOpen_range
  have hZc : IsClosed (Set.range j)ᶜ := hopen.isClosed_compl
  have hZne : ((Set.range j)ᶜ).Nonempty := Set.nonempty_compl.mpr hne
  obtain ⟨z₀, hz₀Z, hz₀cl⟩ := hZc.exists_closed_singleton hZne

  obtain ⟨y₀, hy₀f, hy₀pt⟩ := wc_glc_closed_point_section Ω Y f z₀ hz₀cl

  obtain ⟨Dy⟩ := wc_et_zmod_pull_data_exists y₀ ℓ
  have hUset : (j.opensRange : Set Y) = Set.range j := Scheme.Hom.coe_opensRange j
  have hnotin : y₀ (IsLocalRing.closedPoint Ω) ∉ j.opensRange := by
    intro hmem
    apply hz₀Z
    rw [← hUset, ← hy₀pt]
    exact hmem

  obtain ⟨N, ι, hι, he⟩ := wc_et_extzero_module_mono Y j.opensRange ℓ hℓpos

  obtain ⟨eG⟩ := wc_et_zmodext_coh_equiv Y ℓ (2 * d)
  obtain ⟨hfin, hle⟩ := wc_et_top_coh_card_le Ω Y f d ℓ hℓΩ
  have hdim : topologicalKrullDim Y = (d : WithBot ℕ∞) :=
    le_antisymm (wc_smooth_alg_closed_dim_le Ω Y f d) (wc_smooth_irreducible_dim_ge Ω Y f d)
  have hge := wc_et_top_coh_card_ge Ω Y f d hdim ℓ hℓ hℓΩ 1 le_rfl
  rw [pow_one] at hge
  haveI : Finite (wcEtZModExt Y ℓ (2 * d)) := Finite.of_equiv _ eG.symm
  have hcardG : Nat.card (wcEtZModExt Y ℓ (2 * d)) = ℓ := by
    rw [Nat.card_congr eG]; omega

  have hsupp : ∃ u : wcEtSuppExt Dy (2 * d), wcEtSuppClass Dy (2 * d) u ≠ 0 := by
    obtain ⟨N', Y', π, j', y₀', A, V, _hπ, hj, hjπ, hirr, hdim', hy₀', hA, hAiso, hV, hVsm⟩ :=
      wc_chow_cover_iso_near_point Ω Y f d y₀ hy₀f
    obtain ⟨p, W', hpfin, hpStr, hW, hWet⟩ :=
      wc_proj_generic_projection_etale_at_point Ω N' d Y' j' hj hdim' y₀' V hV hVsm
    have hx₀ : (y₀' ≫ p) ≫ wcProjKStr Ω d = 𝟙 _ := by
      rw [Category.assoc, hpStr, hjπ, ← Category.assoc, hy₀', hy₀f]
    obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists π ℓ
    obtain ⟨Dy'⟩ := wc_et_zmod_pull_data_exists y₀' ℓ
    obtain ⟨Dx⟩ := wc_et_zmod_pull_data_exists (y₀' ≫ p) ℓ
    have hPnz : ∃ v : wcEtSuppExt Dx (2 * d), wcEtSuppClass Dx (2 * d) v ≠ 0 := by
      letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (wcProjK Ω d) ℓ)) := HasExt.standard _
      haveI := wc_proj_space_isProper Ω d
      haveI := wc_proj_space_irreducible Ω d
      have hcard := wc_et_top_coh_card_ge Ω (wcProjK Ω d) (wcProjKStr Ω d) d
        (wc_proj_space_dim Ω d) ℓ hℓ hℓΩ 1 le_rfl
      rw [pow_one] at hcard
      obtain ⟨e⟩ := wc_et_zmodext_coh_equiv (wcProjK Ω d) ℓ (2 * d)
      have hpos : 0 < Nat.card (wcEtCoh (wcProjK Ω d) ℓ (2 * d)) := lt_of_lt_of_le hℓ.pos hcard
      haveI : Finite (wcEtCoh (wcProjK Ω d) ℓ (2 * d)) := (Nat.card_pos_iff.mp hpos).2
      haveI : Nontrivial (wcEtCoh (wcProjK Ω d) ℓ (2 * d)) :=
        Finite.one_lt_card_iff_nontrivial.mp (lt_of_lt_of_le hℓ.one_lt hcard)
      haveI : Nontrivial (wcEtZModExt (wcProjK Ω d) ℓ (2 * d)) := e.nontrivial
      obtain ⟨c, hc⟩ := exists_ne (0 : wcEtZModExt (wcProjK Ω d) ℓ (2 * d))
      haveI : IsClosedImmersion ((y₀' ≫ p) ≫ wcProjKStr Ω d) := by rw [hx₀]; infer_instance
      haveI : IsClosedImmersion (y₀' ≫ p) := IsClosedImmersion.of_comp (y₀' ≫ p) (wcProjKStr Ω d)
      have hcl : IsClosed (Set.range (y₀' ≫ p)) := (y₀' ≫ p).isClosedEmbedding.isClosed_range
      obtain ⟨U, hU⟩ : ∃ U : (wcProjK Ω d).Opens,
          (U : Set (wcProjK Ω d)) = (Set.range (y₀' ≫ p))ᶜ :=
        ⟨⟨(Set.range (y₀' ≫ p))ᶜ, hcl.isOpen_compl⟩, rfl⟩
      obtain ⟨hepi, ⟨iso⟩⟩ := wc_et_point_supp_unit_map_epi_ker Ω (wcProjK Ω d) (wcProjKStr Ω d) ℓ
        (y₀' ≫ p) hx₀ Dx
      rw [← hU] at iso
      obtain ⟨eU⟩ := wc_et_extzero_module_ext_open_coh (wcProjK Ω d) U ℓ hℓ.pos
        (Limits.kernel (wcEtSuppUnitMap Dx)) ⟨iso⟩ (2 * d)
      haveI := wc_et_proj_punctured_top_vanishing Ω d ℓ hℓ hℓΩ (y₀' ≫ p) hx₀ U hU
      haveI := eU.subsingleton
      have hzero : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap Dx))).comp c
          (zero_add _) = 0 := Subsingleton.elim _ _
      have hS' : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap Dx)) (wcEtSuppUnitMap Dx)
          (Limits.kernel.condition _)).ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS' _ c hzero
      refine ⟨x₃, ?_⟩
      show (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dx)).comp x₃ (zero_add _) ≠ 0
      rw [hx₃]
      exact hc
    obtain ⟨v, hv⟩ := hPnz
    obtain ⟨Tr, hTr⟩ := wc_et_finite_trace_point_class Ω d Y' p hpfin hirr hdim' y₀' W' hW hWet
      hx₀ ℓ hℓΩ Dy' Dx
    obtain ⟨u', hu'⟩ := hTr v
    have hu'0 : wcEtSuppClass Dy' (2 * d) u' ≠ 0 := by
      intro h
      apply hv
      rw [← hu', h, map_zero]
    haveI : IsClosedImmersion (y₀ ≫ f) := by rw [hy₀f]; infer_instance
    haveI : IsClosedImmersion y₀ := IsClosedImmersion.of_comp y₀ f
    obtain ⟨u, hu⟩ := wc_et_supp_class_pull_iso_near_point Ω Y Y' π y₀ y₀' hy₀' inferInstance A hA
      hAiso ℓ Dπ Dy Dy' (2 * d) u'
    refine ⟨u, fun h => hu'0 ?_⟩
    rw [← hu, h, map_zero]
  obtain ⟨u₀, hu₀⟩ := hsupp
  obtain ⟨x₀, hx₀⟩ : ∃ x₀ : wcEtZModExt Y ℓ (2 * d),
      x₀ = (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dy)).comp u₀ (zero_add (2 * d)) := ⟨_, rfl⟩
  have hx₀ne : x₀ ≠ 0 := by
    rw [hx₀]; exact hu₀
  have hord : addOrderOf x₀ = ℓ := by
    have hdvd : addOrderOf x₀ ∣ ℓ := by
      have h := addOrderOf_dvd_natCard x₀
      rw [hcardG] at h
      exact h
    rcases (Nat.dvd_prime hℓ).mp hdvd with h1 | h1
    · exfalso
      apply hx₀ne
      have h2 := addOrderOf_nsmul_eq_zero x₀
      rw [h1, one_smul] at h2
      exact h2
    · exact h1
  have htop : AddSubgroup.zmultiples x₀ = ⊤ := by
    apply AddSubgroup.eq_top_of_le_card
    rw [Nat.card_zmultiples, hord, hcardG]

  have hιs : ι ≫ wcEtSuppUnitMap Dy = 0 :=
    wc_et_extzero_to_point_supp_zero Ω Y ℓ y₀ Dy j.opensRange hnotin N _ he
  have hB : ∀ c : wcEtZModExt Y ℓ (2 * d),
      (Abelian.Ext.mk₀ ι).comp c (zero_add (2 * d)) = 0 := by
    intro c
    have hc : c ∈ AddSubgroup.zmultiples x₀ := by rw [htop]; exact AddSubgroup.mem_top c
    obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hc
    have hlin := map_zsmul ((Abelian.Ext.mk₀ ι).precomp
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) (zero_add (2 * d))) k x₀
    simp only [Abelian.Ext.precomp, Abelian.Ext.bilinearComp_apply_apply] at hlin
    rw [hlin, hx₀, ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ι)
      (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dy)) u₀ (zero_add 0) (zero_add (2 * d)) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hιs, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp, smul_zero]

  have hS : (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hι inferInstance
  have hsub : ∀ x : Abelian.Ext N (SheafOfModules.unit (wcEtZModRing Y ℓ)) (2 * d), x = 0 := by
    intro x
    have h0 : hS.extClass.comp x (rfl : 1 + 2 * d = 1 + 2 * d) = 0 :=
      wc_et_open_supp_semipurity Ω Y f d ℓ hℓΩ j.opensRange N ι hι he (1 + 2 * d) (by omega) _
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS
      (SheafOfModules.unit (wcEtZModRing Y ℓ)) x (rfl : 1 + 2 * d = 1 + 2 * d) h0
    rw [← hx₂]
    exact hB x₂

  obtain ⟨E1⟩ := wc_et_extzero_module_ext_open_coh Y j.opensRange ℓ hℓpos N he (2 * d)
  obtain ⟨E2⟩ := wc_et_coh_iso_invariance j.isoOpensRange.hom ℓ (2 * d)
  haveI : Subsingleton (Abelian.Ext N (SheafOfModules.unit (wcEtZModRing Y ℓ)) (2 * d)) :=
    ⟨fun a b => by rw [hsub a, hsub b]⟩
  exact (E2.symm.trans E1.symm).subsingleton

theorem wc_rpc_open_top_vanishing (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (V : X.left.ProEt) (ι : V ⟶ wcGeomPoint F X h)
    (hι : IsOpenImmersion ι.left) (hne : Set.range ι.left ≠ Set.univ)
    (x : Abelian.Ext (wcFreeSheaf X.left V) (wcRootTwist X.left (ℓ ^ n) d) (2 * d)) :
    x = 0 :=
by
  classical

  have hdev : ∀ (Y : Scheme.{u}) (p i : ℕ), p ≠ 0 → Subsingleton (wcEtCoh Y p i) →
      ∀ k : ℕ, Subsingleton (wcEtCoh Y (p ^ k) i) := by
    intro Y p i hp hsp
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hsub : ∀ (X₀ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})), S.ShortExact →
        ∀ m : ℕ, Subsingleton (Abelian.Ext X₀ S.X₁ m) → Subsingleton (Abelian.Ext X₀ S.X₃ m) →
          Subsingleton (Abelian.Ext X₀ S.X₂ m) := by
      intro X₀ S hS m h1 h3
      have hz : ∀ y : Abelian.Ext X₀ S.X₂ m, y = 0 := by
        intro y
        obtain ⟨y₁, hy₁⟩ := Abelian.Ext.covariant_sequence_exact₂ X₀ hS y (Subsingleton.elim _ _)
        rw [← hy₁, Subsingleton.elim y₁ 0, Abelian.Ext.zero_comp]
      exact ⟨fun a b => by rw [hz a, hz b]⟩
    have hzero : ∀ (X₀ Z : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
        Limits.IsZero Z → ∀ m, Subsingleton (Abelian.Ext X₀ Z m) := by
      intro X₀ Z hZ m
      have hx : ∀ x : Abelian.Ext X₀ Z m, x = 0 := by
        intro x
        have := Abelian.Ext.comp_mk₀_id x
        rw [hZ.eq_of_tgt (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
        exact this.symm
      exact ⟨fun x y => by rw [hx x, hx y]⟩
    have hses : ∀ (p k : ℕ), p ≠ 0 →
        ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
          (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
          (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
      intro p k hp
      have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
        rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
          ZMod.natCast_self]
      let α : ZMod k →+ ZMod (p * k) :=
        ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
      have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
        intro z
        show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
        rw [ZMod.lift_coe]
        change z • (p : ZMod (p * k)) = _
        rw [zsmul_eq_mul]
        push_cast
        ring
      let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
      have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
        map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
      have hαinj : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
        have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
        push_cast at hx
        rw [mul_comm z] at hx
        exact (mul_dvd_mul_iff_left hp').mp hx
      have hβsurj : Function.Surjective β := by
        intro y
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        exact ⟨(z : ZMod (p * k)), hβ z⟩
      have hβα : ∀ x, β (α x) = 0 := by
        intro x
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, hβ]
        push_cast
        rw [ZMod.natCast_self, mul_zero]
      have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
        intro y hy
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
        obtain ⟨t, rfl⟩ := hy
        refine ⟨(t : ZMod k), ?_⟩
        rw [hα]
        congr 1
        ring
      let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
          AddEquiv.ulift.toAddMonoidHom)
      let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
          AddEquiv.ulift.toAddMonoidHom)
