    have hne : ε m ≠ 0 := hu.ne_zero
    have hz : z = ε a * (ε m)⁻¹ := by
      rw [eq_mul_inv_iff_mul_eq₀ hne]
      exact hw
    have hres : IsIntegral Ω (ε a * (ε m)⁻¹) := (hint a).mul (hint m).inv
    rw [hz]
    exact hres

  have S7 : ∀ (X : Scheme.{u}) (R : CommRingCat.{u}) (h : X ⟶ Spec R) (q : X),
      Spec.preimage (X.fromSpecResidueField q ≫ h) =
        (Scheme.ΓSpecIso R).inv ≫ h.appTop ≫ X.evaluation ⊤ q trivial := by
    intro X R h q
    have hD : Spec.preimage (X.fromSpecResidueField q ≫ h) =
        (Scheme.ΓSpecIso R).inv ≫ h.appTop ≫ X.presheaf.germ ⊤ q trivial ≫ X.residue q := by
      apply Spec.map_injective
      rw [Spec.map_preimage]
      simp only [Spec.map_comp, Category.assoc]
      rw [← Scheme.fromSpecStalk_toSpecΓ_assoc, ← Scheme.toSpecΓ_naturality_assoc,
        toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id, ← Category.assoc]
      rfl
    rw [hD]
    rfl

  have hstr : Spec.preimage ((Limits.pullback (Y.fromSpecResidueField x) a).fromSpecResidueField p ≫
        Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ a ≫ f) =
      Spec.preimage (Y.fromSpecResidueField x ≫ f) ≫ (Scheme.ΓSpecIso (Y.residueField x)).inv ≫
        (Limits.pullback.fst (Y.fromSpecResidueField x) a).appTop ≫
        (Limits.pullback (Y.fromSpecResidueField x) a).evaluation ⊤ p trivial := by
    have e1 : (Limits.pullback (Y.fromSpecResidueField x) a).fromSpecResidueField p ≫
        Limits.pullback.snd (Y.fromSpecResidueField x) a ≫ a ≫ f =
        ((Limits.pullback (Y.fromSpecResidueField x) a).fromSpecResidueField p ≫
          Limits.pullback.fst (Y.fromSpecResidueField x) a) ≫
