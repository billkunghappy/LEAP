theorem wc_et_supp_mv_glue : ∀ {Y Z A B P ZA ZB ZP : Scheme.{u}} {ℓ : ℕ} (i : Z ⟶ Y) [IsClosedImmersion i] (jA : A ⟶ Y) (jB : B ⟶ Y) [IsOpenImmersion jA] [IsOpenImmersion jB], (∀ y : Y, y ∈ Set.range jA ∨ y ∈ Set.range jB) → ∀ (pA : P ⟶ A) (pB : P ⟶ B), IsPullback pA pB jA jB → ∀ (iA : ZA ⟶ A) (iB : ZB ⟶ B) (iP : ZP ⟶ P) (gA : ZA ⟶ Z) (gB : ZB ⟶ Z) (gPA : ZP ⟶ ZA) (gPB : ZP ⟶ ZB), IsPullback gA iA i jA → IsPullback gB iB i jB → IsPullback gPA iP iA pA → IsPullback gPB iP iB pB → ∀ (D : wcEtPullData i ℓ) (DA : wcEtPullData iA ℓ) (DB : wcEtPullData iB ℓ) (DP : wcEtPullData iP ℓ) (EA : wcEtPullData jA ℓ) (EB : wcEtPullData jB ℓ) (EPA : wcEtPullData pA ℓ) (EPB : wcEtPullData pB ℓ) (γA : wcEtSuppObj DA ⟶ EA.Φ.obj (wcEtSuppObj D)) (γB : wcEtSuppObj DB ⟶ EB.Φ.obj (wcEtSuppObj D)) (γPA : wcEtSuppObj DP ⟶ EPA.Φ.obj (wcEtSuppObj DA)) (γPB : wcEtSuppObj DP ⟶ EPB.Φ.obj (wcEtSuppObj DB)), wcEtSuppUnitMap DA ≫ γA = EA.μ.inv ≫ EA.Φ.map (wcEtSuppUnitMap D) → wcEtSuppUnitMap DB ≫ γB = EB.μ.inv ≫ EB.Φ.map (wcEtSuppUnitMap D) → wcEtSuppUnitMap DP ≫ γPA = EPA.μ.inv ≫ EPA.Φ.map (wcEtSuppUnitMap DA) → wcEtSuppUnitMap DP ≫ γPB = EPB.μ.inv ≫ EPB.Φ.map (wcEtSuppUnitMap DB) → ∀ (q : ℕ) (θA : wcEtSuppExt DA q) (θB : wcEtSuppExt DB q), wcEtSuppRestr DA EPA DP γPA q θA = wcEtSuppRestr DB EPB DP γPB q θB → ∃ θ : wcEtSuppExt D q, wcEtSuppRestr D EA DA γA q θ = θA ∧ wcEtSuppRestr D EB DB γB q θ = θB :=
by
  classical
  intro Y Z A B P ZA ZB ZP ℓ i _ jA jB _ _ hcov pA pB hP iA iB iP gA gB gPA gPB hA hB hPA hPB
    D DA DB DP EA EB EPA EPB γA γB γPA γPB hγA hγB hγPA hγPB q θA θB hagree

  haveI : IsClosedImmersion iA :=
