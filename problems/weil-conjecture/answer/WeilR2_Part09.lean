            (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))) =
        (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ D) wcKtGm.{u})).app
            (Scheme.Γ.obj (Opposite.op W.unop.left))).hom
          (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            (N := wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            (FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W)) γ)
      have e1 : (z • Additive.ofMul (wcKaUnit Y a W) :
          Additive (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ) = (ℓ ^ n) • γ := by
        rw [← ofMul_zpow, ← hx', ofMul_pow, ofMul_toMul]
      have e2 : (z • TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            (N := wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            (FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W))
            (Additive.ofMul (wcKtCoord ℓ D k (Scheme.Γ.obj (Opposite.op W.unop.left))
              (wcKaTup Y ℓ D s hℓ W)))) =
          (ℓ ^ n) • TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            (N := wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            (FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W)) γ := by
