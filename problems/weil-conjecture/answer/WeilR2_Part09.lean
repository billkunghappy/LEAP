  have hu : ∀ i, IsUnit ((wcKOpen VT.left (wcParamFn j e f) 1 1).ι.appTop.hom (wcParamFn j e f i)) := by
    intro i
    apply hunit
    intro x
    have hx : (∀ i' : Fin d, 1 ≤ i'.val → x.1 ∈ VT.left.basicOpen (wcParamFn j e f i')) ∧
        ∃ i' : Fin d, i'.val < 1 ∧ x.1 ∈ VT.left.basicOpen (wcParamFn j e f i') := x.2
    obtain ⟨hall, k, hk, hmem⟩ := hx
    have key : x.1 ∈ VT.left.basicOpen (wcParamFn j e f i) := by
      by_cases hi : 1 ≤ i.val
      · exact hall i hi
      · have hki : k = i := Fin.ext (by omega)
        rw [← hki]
        exact hmem
    rw [← Scheme.preimage_basicOpen_top]
    exact key
  obtain ⟨tD, htD⟩ : ∃ tD : Fin d →
      (Γ((wcVRes X.left VT (wcKOpen VT.left (wcParamFn j e f) 1 1)).left, ⊤))ˣ,
