    have h4 := h1.trans (h2.trans (h3.trans hx))
    exact_mod_cast h4

  have CNT : ∀ (K' L M : Type u) [Field K'] [Field L] [Field M] [Algebra K' L] [Algebra L M]
      [Algebra K' M] [IsScalarTower K' L M] (n : ℕ) (s : Fin n → L), n ≤ D →
      Algebra.IsAlgebraic (IntermediateField.adjoin K' (Set.range s)) L →
