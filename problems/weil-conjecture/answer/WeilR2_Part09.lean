    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing Y₂ n)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
  show (Abelian.Ext.mk₀ κ₁₂).comp ((Abelian.Ext.mapExactFunctor E₁₂.Φ x).comp
      (Abelian.Ext.mk₀ E₁₂.μ.hom) (add_zero k)) (zero_add k) =
    (Abelian.Ext.mk₀ γ₂).comp ((Abelian.Ext.mapExactFunctor E₂.Φ
      ((Abelian.Ext.mk₀ κ₁).comp ((Abelian.Ext.mapExactFunctor E₁.Φ x).comp
        (Abelian.Ext.mk₀ E₁.μ.hom) (add_zero k)) (zero_add k))).comp
      (Abelian.Ext.mk₀ E₂.μ.hom) (add_zero k)) (zero_add k)

  have hR : (Abelian.Ext.mk₀ γ₂).comp ((Abelian.Ext.mapExactFunctor E₂.Φ
      ((Abelian.Ext.mk₀ κ₁).comp ((Abelian.Ext.mapExactFunctor E₁.Φ x).comp
        (Abelian.Ext.mk₀ E₁.μ.hom) (add_zero k)) (zero_add k))).comp
