    have hE := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mpr hS₀L
    haveI : Sheaf.IsLocallyInjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f) :=
