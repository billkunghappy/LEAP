      (_hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) f)
      (_hex : ∀ (U : Y.Etale) (x : P₂.obj (Opposite.op U)), (g.app (Opposite.op U)).hom x = 0 →
        ∃ R ∈ Scheme.smallEtaleTopology Y U, ∀ (V : Y.Etale) (i : V ⟶ U), R.arrows i →
          ∃ y : P₁.obj (Opposite.op V), (f.app (Opposite.op V)).hom y = (P₂.map i.op).hom x)
      (_hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) g),
      ∃ w', (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f)
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g) w').ShortExact := by
    intro P₁ P₂ P₃ f g w hinj hex hsurj
    have hιinj : ∀ W, Function.Injective ((Limits.kernel.ι g).app W).hom := by
      intro W
      have hm : Mono ((Limits.kernel.ι g).app W) :=
        (NatTrans.mono_iff_mono_app (Limits.kernel.ι g)).mp inferInstance W
      exact (AddCommGrpCat.mono_iff_injective _).mp hm
    have hb : ∀ W (y : P₁.obj W), ((Limits.kernel.ι g).app W).hom
