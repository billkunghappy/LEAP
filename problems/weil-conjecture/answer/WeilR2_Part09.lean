    (wc_lptt_gm_push_twist_higher_zero K ℓ hℓK n X fX k I)

  obtain ⟨g, hg, hc⟩ := I.extMk_surjective
    ((Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcLpttGam (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))
        (wcKtT.{u} (ℓ ^ n) k)))).comp
      (wcLpttKt (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ n k
        (Units.map (Limits.pullback.snd fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))).appTop.hom.toMonoidHom
          (wcLpttLaurentT K)) hℓQ) (zero_add 1)) (1 + 1) rfl
  have hf : adj.homEquiv _ _ g ≫ (((wcEtPush (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).d 1 (1 + 1) = 0 := by
    rw [Functor.mapHomologicalComplex_obj_d, ← Adjunction.homEquiv_naturality_right, hg,
      Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]

  obtain ⟨ψ, hψ⟩ := wc_lptt_gm_R1_split K ℓ hℓK n hn X fX k hℓQ L adj I g hg hf hc

  have h4 := wc_lptt_sym_adj_transport (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) L adj ℓ n k s hℓX hℓQ

  let Φ := ((Abelian.Ext.mk₀ ψ).postcomp (wcFtcFS X (wcEtTop X)) (add_zero k)).comp
    ((E (wcFtcFS X (wcEtTop X)) k).comp
      ((Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcLpttGamF (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))))).precomp
        (wcLpttEtSh (Limits.pullback fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))
          (wcKtT.{u} (ℓ ^ n) (k + 1))) (zero_add (k + 1))))

  have hz : wcLpttSym (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ n (k + 1)
      (Fin.snoc
        (fun i => Units.map (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))).appTop.hom.toMonoidHom
            (s i))
        (Units.map (Limits.pullback.snd fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))).appTop.hom.toMonoidHom
            (wcLpttLaurentT K))) hℓQ =
      (wcLpttSym (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ n k
        (fun i => Units.map (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))).appTop.hom.toMonoidHom
            (s i)) hℓQ).comp
        (wcLpttKt (Limits.pullback fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ n k
          (Units.map (Limits.pullback.snd fX
            (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))).appTop.hom.toMonoidHom
            (wcLpttLaurentT K)) hℓQ) rfl := by
    rw [wcLpttSym]
    simp only [Fin.snoc_castSucc, Fin.snoc_last]

  have hsc : ∀ {Y : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}} (m : ℤ)
      (x : Abelian.Ext (wcFtcFS X (wcEtTop X)) Y k) (f : Y ⟶ wcLpttEtSh X (wcKtT.{u} (ℓ ^ n) k)),
      (m • x).comp (Abelian.Ext.mk₀ f) (add_zero k) = m • x.comp (Abelian.Ext.mk₀ f) (add_zero k) := by
    intro Y m x f
    have := ((Abelian.Ext.mk₀ f).postcomp (wcFtcFS X (wcEtTop X)) (add_zero k)).map_zsmul m x
    simpa only [Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
      Abelian.Ext.bilinearComp_apply_apply] using this
  have hΦz : Φ (wcLpttSym (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ n (k + 1)
      (Fin.snoc
        (fun i => Units.map (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))).appTop.hom.toMonoidHom
            (s i))
        (Units.map (Limits.pullback.snd fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))).appTop.hom.toMonoidHom
            (wcLpttLaurentT K))) hℓQ) = ε k • wcLpttSym X ℓ n k s hℓX := by
    simp only [Φ, AddMonoidHom.comp_apply, Abelian.Ext.precomp, Abelian.Ext.postcomp,
      AddMonoidHom.flip_apply, Abelian.Ext.bilinearComp_apply_apply]
    rw [hz, ← Abelian.Ext.comp_assoc _ _ _ (zero_add k) rfl (by omega), ← h4,
      Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 1) (by omega), hEprod, ← hc,
      hE0 _ g hg hf, hsc,
      Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hψ, Abelian.Ext.comp_mk₀_id]

  have h1 : ℓ ^ (n - 1) • (ε k • wcLpttSym X ℓ n k s hℓX) = 0 := by
    rw [← hΦz, ← map_nsmul, h0, map_zero]
  rcases hε k with he | he
  · rw [he, one_smul] at h1
    exact hX h1
  · rw [he, neg_one_zsmul, smul_neg, neg_eq_zero] at h1
    exact hX h1

theorem wc_etInv_exact {Z Y : Scheme.{u}} (g : Z ⟶ Y) :
    (wcEtInv g).Additive ∧ Limits.PreservesFiniteLimits (wcEtInv g) ∧
      Limits.PreservesFiniteColimits (wcEtInv g) :=
by

  have hjs : ∀ (X : Scheme.{u}) (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
    intro X V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcov : CoverPreserving (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Z) (wcEtBaseChange g) := by
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩

  haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange g) := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget Z) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget Y ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget Z)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g) (Scheme.Etale.forget Z)⟩
  haveI := flat_of_preservesFiniteLimits (wcEtBaseChange g)
  haveI hcont : (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Z) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) hcov

  haveI hadj : (wcEtInv g).IsLeftAdjoint :=
    (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtBaseChange g)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)).isLeftAdjoint

  have wc_lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
      Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim) := by
    intro C D _ _ L _ _ Y
    refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
    intro F₁ F₂ φ
    have hnat : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
        (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
      fun j => (L.lan.map φ).naturality j.hom
    have hfac : ∀ j : CostructuredArrow L Y,
        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key
  haveI hlan : Limits.PreservesFiniteLimits ((wcEtBaseChange g).op.lan :
      ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) := by
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro W
    obtain ⟨θ⟩ := wc_lan_eval_iso (wcEtBaseChange g).op W
    haveI := (flat_of_preservesFiniteLimits (wcEtBaseChange g)).cofiltered W.unop
    haveI : IsFiltered (CostructuredArrow (wcEtBaseChange g).op W) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence (wcEtBaseChange g) W.unop)
    haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow (wcEtBaseChange g).op W)) :=
      IsFiltered.of_equivalence (ULiftHom.equiv (C := CostructuredArrow (wcEtBaseChange g).op W))
    haveI : HasExactColimitsOfShape (ULiftHom.{u+1} (CostructuredArrow (wcEtBaseChange g).op W))
        AddCommGrpCat.{u+1} :=
      AB5OfSize.ofShape (ULiftHom.{u+1} (CostructuredArrow (wcEtBaseChange g).op W))
    haveI : HasExactColimitsOfShape (CostructuredArrow (wcEtBaseChange g).op W)
        AddCommGrpCat.{u+1} :=
      @HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _
        (ULiftHom.{u+1} (CostructuredArrow (wcEtBaseChange g).op W))
        (CostructuredArrow (wcEtBaseChange g).op W) _ _
        (ULiftHom.equiv (C := CostructuredArrow (wcEtBaseChange g).op W)).symm _ _
    exact Limits.preservesLimitsOfShape_of_natIso θ.symm

  have hlim : Limits.PreservesFiniteLimits (wcEtInv g) :=
    (Limits.comp_preservesFiniteLimits (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      ((wcEtBaseChange g).op.lan ⋙ presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) :
      Limits.PreservesFiniteLimits (wcEtInv g))
  haveI := hlim

  haveI := Functor.preservesZeroMorphisms_of_isLeftAdjoint (wcEtInv g)
  have hadd : (wcEtInv g).Additive := Functor.additive_of_preserves_binary_products _
  exact ⟨hadd, hlim, inferInstance⟩

theorem wc_lptt_pullsh_nat {X Z : Scheme.{u}} (g : Z ⟶ X)
    {P P' : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} {Q Q' : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
    (a : P ⟶ P') (b : Q ⟶ Q') (θ : P ⟶ (wcEtBaseChange g).op ⋙ Q)
    (θ' : P' ⟶ (wcEtBaseChange g).op ⋙ Q')
    (h : a ≫ θ' = θ ≫ Functor.whiskerLeft (wcEtBaseChange g).op b) :
    (wcEtInv g).map ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map a) ≫
        wcLpttPullSh g θ' =
      wcLpttPullSh g θ ≫ (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).map b :=
by
  classical
  by_cases hc : (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology Z)
  · haveI := hc
    have hpos : ∀ {P₀ : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} {Q₀ : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
        (θ₀ : P₀ ⟶ (wcEtBaseChange g).op ⋙ Q₀),
        wcLpttPullSh g θ₀ =
        ((sheafificationAdjunction (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).homEquiv _ _).symm
          ((((wcEtBaseChange g).op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv _ _).symm
            (sheafifyLift (Scheme.smallEtaleTopology X)
              (θ₀ ≫ Functor.whiskerLeft (wcEtBaseChange g).op
                (toSheafify (Scheme.smallEtaleTopology Z) Q₀))
              ((wcEtBaseChange g).op_comp_isSheaf (Scheme.smallEtaleTopology X)
                (Scheme.smallEtaleTopology Z)
                ((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj Q₀)))) :=
      fun θ₀ => dif_pos hc
    have hQ := (wcEtBaseChange g).op_comp_isSheaf (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology Z)
      ((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj Q)
    have hQ' := (wcEtBaseChange g).op_comp_isSheaf (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology Z)
      ((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj Q')
    have key : sheafifyLift (Scheme.smallEtaleTopology X)
        (a ≫ θ' ≫ Functor.whiskerLeft (wcEtBaseChange g).op
          (toSheafify (Scheme.smallEtaleTopology Z) Q')) hQ' =
      sheafifyLift (Scheme.smallEtaleTopology X)
        (θ ≫ Functor.whiskerLeft (wcEtBaseChange g).op
          (toSheafify (Scheme.smallEtaleTopology Z) Q)) hQ ≫
        Functor.whiskerLeft (wcEtBaseChange g).op
          (sheafifyMap (Scheme.smallEtaleTopology Z) b) := by
      apply sheafify_hom_ext _ _ _ hQ'
      rw [toSheafify_sheafifyLift, ← Category.assoc (toSheafify _ P), toSheafify_sheafifyLift,
        Category.assoc, ← Functor.whiskerLeft_comp, ← toSheafify_naturality,
        Functor.whiskerLeft_comp, ← Category.assoc θ, ← h, Category.assoc]
    have e1 : (wcEtInv g).map
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map a) =
        (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).map
          ((wcEtBaseChange g).op.lan.map (sheafifyMap (Scheme.smallEtaleTopology X) a)) := rfl
    rw [hpos θ, hpos θ', e1]
    erw [← Adjunction.homEquiv_naturality_left_symm
        (adj := sheafificationAdjunction (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})]
    erw [← Adjunction.homEquiv_naturality_left_symm
        (adj := (wcEtBaseChange g).op.lanAdjunction AddCommGrpCat.{u+1})]
    erw [sheafifyMap_sheafifyLift]
    erw [← Adjunction.homEquiv_naturality_right_symm
        (adj := sheafificationAdjunction (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})]
    erw [← Adjunction.homEquiv_naturality_right_symm
        (adj := (wcEtBaseChange g).op.lanAdjunction AddCommGrpCat.{u+1})]
    erw [key]
    rfl
  · have hneg : ∀ {P₀ : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} {Q₀ : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
        (θ₀ : P₀ ⟶ (wcEtBaseChange g).op ⋙ Q₀), wcLpttPullSh g θ₀ = 0 :=
      fun θ₀ => dif_neg hc
    rw [hneg θ, hneg θ', Limits.comp_zero, Limits.zero_comp]

theorem wc_lptt_kt_pull {X Z : Scheme.{u}} (g : Z ⟶ X) (ℓ n k : ℕ) (a : (Γ(X, ⊤))ˣ)
    (hℓX : IsUnit ((ℓ : ℕ) : Γ(X, ⊤))) (hℓZ : IsUnit ((ℓ : ℕ) : Γ(Z, ⊤)))
    [(wcEtInv g).Additive] [Limits.PreservesFiniteLimits (wcEtInv g)]
    [Limits.PreservesFiniteColimits (wcEtInv g)]
    (hB : ∀ {G G' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : G ⟶ G'),
      (wcEtInv g).map (wcLpttEtShMap X α) ≫ wcLpttPullB g G' = wcLpttPullB g G ≫ wcLpttEtShMap Z α)
    (hU : (wcEtInv g).map (wcLpttUSec X ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓX) ≫
        wcLpttPullB g (wcTensFun (wcKtZUT.{u} ℓ (k + 1)) (wcKtT.{u} (ℓ ^ n) k)) =
      wcLpttPullB g (wcKtT.{u} (ℓ ^ n) k) ≫ wcLpttUSec Z ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then Units.map g.appTop.hom.toMonoidHom a else 1) hℓZ)
    (hSX : ∃ w, (ShortComplex.mk
      (wcLpttEtShMap X (wcTensNat (wcKtIotaE.{u} ℓ n (k + 1) k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
      (wcLpttEtShMap X (wcTensNat
        (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n (k + 1) k ⟶ wcKtZUT.{u} ℓ (k + 1))
        (𝟙 (wcKtT.{u} (ℓ ^ n) k)))) w).ShortExact)
    (hSZ : ∃ w, (ShortComplex.mk
      (wcLpttEtShMap Z (wcTensNat (wcKtIotaE.{u} ℓ n (k + 1) k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
      (wcLpttEtShMap Z (wcTensNat
        (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n (k + 1) k ⟶ wcKtZUT.{u} ℓ (k + 1))
        (𝟙 (wcKtT.{u} (ℓ ^ n) k)))) w).ShortExact) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    (Abelian.Ext.mapExactFunctor (wcEtInv g) (wcLpttKt X ℓ n k a hℓX)).comp
        (Abelian.Ext.mk₀ (wcLpttPullB g (wcKtT.{u} (ℓ ^ n) (k + 1)))) (add_zero 1) =
      (Abelian.Ext.mk₀ (wcLpttPullB g (wcKtT.{u} (ℓ ^ n) k))).comp
        (wcLpttKt Z ℓ n k (Units.map g.appTop.hom.toMonoidHom a) hℓZ) (zero_add 1) :=
by
  classical
  obtain ⟨wX, hX⟩ := hSX
  obtain ⟨wZ, hZ⟩ := hSZ
  letI iX : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI iZ : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  have hKX : wcLpttKt X ℓ n k a hℓX =
      (Abelian.Ext.mk₀ (wcLpttUSec X ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓX)).comp
        ((hX.extClass.comp (Abelian.Ext.mk₀ (wcLpttEtShMap X (wcKtRho.{u} ℓ n (k + 1) k)))
            (add_zero 1)).comp
          (Abelian.Ext.mk₀ (wcLpttEtShMap X (wcKtEps.{u} ℓ n (k + 1)))) (add_zero 1))
        (zero_add 1) := by
    unfold wcLpttKt wcLpttEtStep wcExtOfMaps
    simp only [dif_pos wX, dif_pos hX]
  have hKZ : wcLpttKt Z ℓ n k (Units.map g.appTop.hom.toMonoidHom a) hℓZ =
      (Abelian.Ext.mk₀ (wcLpttUSec Z ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then Units.map g.appTop.hom.toMonoidHom a else 1)
          hℓZ)).comp
        ((hZ.extClass.comp (Abelian.Ext.mk₀ (wcLpttEtShMap Z (wcKtRho.{u} ℓ n (k + 1) k)))
            (add_zero 1)).comp
          (Abelian.Ext.mk₀ (wcLpttEtShMap Z (wcKtEps.{u} ℓ n (k + 1)))) (add_zero 1))
        (zero_add 1) := by
    unfold wcLpttKt wcLpttEtStep wcExtOfMaps
    simp only [dif_pos wZ, dif_pos hZ]
  have NAT : (hX.map_of_exact (wcEtInv g)).extClass.comp
      (Abelian.Ext.mk₀ (wcLpttPullB g (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ (k + 1))
        (wcRootsFun.{u} (ℓ ^ n))) (wcKtT.{u} (ℓ ^ n) k)))) (add_zero 1) =
      (Abelian.Ext.mk₀ (wcLpttPullB g (wcTensFun (wcKtZUT.{u} ℓ (k + 1))
        (wcKtT.{u} (ℓ ^ n) k)))).comp hZ.extClass (zero_add 1) :=
    (hX.map_of_exact (wcEtInv g)).extClass_naturality hZ
      (ShortComplex.homMk _ _ _
        (hB (wcTensNat (wcKtIotaE.{u} ℓ n (k + 1) k) (𝟙 (wcKtT.{u} (ℓ ^ n) k)))).symm
        (hB (wcTensNat
          (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n (k + 1) k ⟶ wcKtZUT.{u} ℓ (k + 1))
          (𝟙 (wcKtT.{u} (ℓ ^ n) k)))).symm)
  have hM : (wcEtInv g).map (wcLpttEtShMap X (wcKtRho.{u} ℓ n (k + 1) k)) ≫
      (wcEtInv g).map (wcLpttEtShMap X (wcKtEps.{u} ℓ n (k + 1))) ≫
        wcLpttPullB g (wcKtT.{u} (ℓ ^ n) (k + 1)) =
      wcLpttPullB g (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ (k + 1))
        (wcRootsFun.{u} (ℓ ^ n))) (wcKtT.{u} (ℓ ^ n) k)) ≫
        wcLpttEtShMap Z (wcKtRho.{u} ℓ n (k + 1) k) ≫
          wcLpttEtShMap Z (wcKtEps.{u} ℓ n (k + 1)) := by
    rw [hB (wcKtEps.{u} ℓ n (k + 1)), ← Category.assoc, hB (wcKtRho.{u} ℓ n (k + 1) k),
      Category.assoc]
  show (Abelian.Ext.mapExactFunctor (wcEtInv g) (wcLpttKt X ℓ n k a hℓX)).comp
        (Abelian.Ext.mk₀ (wcLpttPullB g (wcKtT.{u} (ℓ ^ n) (k + 1)))) (add_zero 1) =
      (Abelian.Ext.mk₀ (wcLpttPullB g (wcKtT.{u} (ℓ ^ n) k))).comp
        (wcLpttKt Z ℓ n k (Units.map g.appTop.hom.toMonoidHom a) hℓZ) (zero_add 1)
  rw [hKX, hKZ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
    Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.mapExactFunctor_extClass]
  simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
    Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc]
  rw [hM, ← hU, ← Abelian.Ext.mk₀_comp_mk₀ (wcLpttPullB g (wcTensFun (wcTensFun
      (wcKtZUT.{u} ℓ (k + 1)) (wcRootsFun.{u} (ℓ ^ n))) (wcKtT.{u} (ℓ ^ n) k)))
      (wcLpttEtShMap Z (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Z (wcKtEps.{u} ℓ n (k + 1))),
    ← Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (add_zero 1), NAT]
  simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc]

theorem wc_lptt_gen0_pull {X Z : Scheme.{u}} (g : Z ⟶ X) (ℓ n : ℕ)
    (hℓX : IsUnit ((ℓ : ℕ) : Γ(X, ⊤))) (hℓZ : IsUnit ((ℓ : ℕ) : Γ(Z, ⊤)))
    (hc : (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology Z)) :
    wcLpttPullAlpha g ≫ (wcEtInv g).map (wcLpttGen0 X ℓ n hℓX) ≫
        wcLpttPullB g (wcKtT.{u} (ℓ ^ n) 0) = wcLpttGen0 Z ℓ n hℓZ :=
by
  classical

  have he : ∀ R : CommRingCat.{u}, wcLpttE0.{u} (ℓ ^ n) R =
      ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0) :
        (wcKtT.{u} (ℓ ^ n) 0).obj R) := fun _ => rfl
  have heT' : ∀ (R S : CommRingCat.{u}) (r : R ⟶ S) (y : (wcKtT.{u} (ℓ ^ n) 0).obj R),
      y = wcLpttE0 (ℓ ^ n) R → ((wcKtT.{u} (ℓ ^ n) 0).map r).hom y = wcLpttE0 (ℓ ^ n) S := by
    intro R S φ y hy
    rw [hy, he, he]
    show (LinearMap.lTensor (ZMod (ℓ ^ n)) (PiTensorProduct.map fun _ : Fin 0 =>
      ((wcRootsFun.{u} (ℓ ^ n)).map φ).hom.toIntLinearMap))
        ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0)) = _
    rw [LinearMap.lTensor_tmul]
    erw [PiTensorProduct.map_tprod]
    congr 2
    funext i
    exact i.elim0

  have hinj : ∀ {Y : Scheme.{u}} (S : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (φ ψ : wcFtcFS Y (wcEtTop Y) ⟶ S),
      (φ.hom.app (Opposite.op (wcEtTop Y))).hom (wcFtcGen Y (wcEtTop Y)) =
        (ψ.hom.app (Opposite.op (wcEtTop Y))).hom (wcFtcGen Y (wcEtTop Y)) → φ = ψ := by
    intro Y S φ ψ h
    let P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let g₀ : P.obj (Opposite.op (wcEtTop Y)) := FreeAbelianGroup.of (ULift.up (𝟙 (wcEtTop Y)))
    apply Sheaf.hom_ext
    apply sheafify_hom_ext (Scheme.smallEtaleTopology Y) _ _ S.property
    apply NatTrans.ext
    funext T
    cases T with
    | op T =>
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro x
    obtain ⟨f⟩ := x
    have hgen : (P.map f.op).hom g₀ = FreeAbelianGroup.of (ULift.up f) := by
      change FreeAbelianGroup.of (ULift.up (f ≫ 𝟙 (wcEtTop Y))) = _
      rw [Category.comp_id]
    have hφ := NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology Y) P ≫ φ.hom) f.op g₀
    have hψ := NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology Y) P ≫ ψ.hom) f.op g₀
    change ((toSheafify (Scheme.smallEtaleTopology Y) P ≫ φ.hom).app (Opposite.op T)).hom
        ((P.map f.op).hom g₀) = (S.obj.map f.op).hom
        (((toSheafify (Scheme.smallEtaleTopology Y) P ≫ φ.hom).app
          (Opposite.op (wcEtTop Y))).hom g₀) at hφ
    change ((toSheafify (Scheme.smallEtaleTopology Y) P ≫ ψ.hom).app (Opposite.op T)).hom
        ((P.map f.op).hom g₀) = (S.obj.map f.op).hom
        (((toSheafify (Scheme.smallEtaleTopology Y) P ≫ ψ.hom).app
          (Opposite.op (wcEtTop Y))).hom g₀) at hψ
    rw [hgen] at hφ hψ
    change ((toSheafify (Scheme.smallEtaleTopology Y) P ≫ φ.hom).app (Opposite.op T)).hom
        (FreeAbelianGroup.of (ULift.up f)) =
      ((toSheafify (Scheme.smallEtaleTopology Y) P ≫ ψ.hom).app (Opposite.op T)).hom
        (FreeAbelianGroup.of (ULift.up f))
    exact hφ.trans ((congrArg (fun z => (S.obj.map f.op).hom z) h).trans hψ.symm)

  have hGen : ∀ {Y : Scheme.{u}} (T : Y.Etale)
      (S : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (x : S.obj.obj (Opposite.op T)),
      ((wcLpttGenMap T S x).hom.app (Opposite.op T)).hom (wcFtcGen Y T) = x := by
    intro Y T S x
    have hnat : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f ≫
          AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun c : ULift.{u+1} (W'.unop ⟶ T) => (S.obj.map c.down.op).hom x)) =
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun c : ULift.{u+1} (W.unop ⟶ T) => (S.obj.map c.down.op).hom x)) ≫
          ((sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj S).map f := by
      intro W W' f
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro c
      change FreeAbelianGroup.lift
          (fun c : ULift.{u+1} (W'.unop ⟶ T) => (S.obj.map c.down.op).hom x)
          (FreeAbelianGroup.of (ULift.up (f.unop ≫ c.down))) =
        (S.obj.map f).hom (FreeAbelianGroup.lift
          (fun c : ULift.{u+1} (W.unop ⟶ T) => (S.obj.map c.down.op).hom x) (FreeAbelianGroup.of c))
      have e1 : (S.obj.map (f.unop ≫ c.down).op).hom x =
          (S.obj.map f).hom ((S.obj.map c.down.op).hom x) := by
        rw [op_comp, Quiver.Hom.op_unop, Functor.map_comp, AddCommGrpCat.hom_comp]
        rfl
      have e2 := FreeAbelianGroup.lift_apply_of
        (fun y : ULift.{u+1} (W.unop ⟶ T) => (S.obj.map y.down.op).hom x) c
      have e3 := FreeAbelianGroup.lift_apply_of
        (fun y : ULift.{u+1} (W'.unop ⟶ T) => (S.obj.map y.down.op).hom x)
        (ULift.up (f.unop ≫ c.down))
      exact e3.trans (e1.trans (congrArg (fun z => (S.obj.map f).hom z) e2.symm))
    have hadj := Equiv.apply_symm_apply
      ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).homEquiv
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) S)
      (wcNatOf (F := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
        (G := (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj S)
        (fun W => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun f : ULift.{u+1} (W.unop ⟶ T) => (S.obj.map f.down.op).hom x))))
    rw [Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app] at hadj
    have h2 := congrArg (fun φ => (φ.app (Opposite.op T)).hom
      (FreeAbelianGroup.of (ULift.up (𝟙 T)))) hadj
    refine Eq.trans h2 ?_
    unfold wcNatOf
    split_ifs with h
    · change FreeAbelianGroup.lift
          (fun f : ULift.{u+1} ((Opposite.op T).unop ⟶ T) => (S.obj.map f.down.op).hom x)
          (FreeAbelianGroup.of (ULift.up (𝟙 T))) = x
      rw [FreeAbelianGroup.lift_apply_of]
      change (S.obj.map (𝟙 T).op).hom x = x
      rw [op_id, S.obj.map_id]
      rfl
    · exact absurd hnat h

  have hRho : ∀ {A B : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}} (φ : A ⟶ B)
      (V : X.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g)
      (x : A.obj.obj (Opposite.op V)),
      (((wcEtInv g).map φ).hom.app (Opposite.op O)).hom (wcEtInvRho g A V O h hh x) =
        wcEtInvRho g B V O h hh ((φ.hom.app (Opposite.op V)).hom x) := by
    intro A B φ V O h hh x
    have e1 := toSheafify_naturality (Scheme.smallEtaleTopology Z)
      ((wcEtBaseChange g).op.lan.map φ.hom)
    have e2 := ((wcEtBaseChange g).op.lanUnit (H := AddCommGrpCat.{u+1})).naturality φ.hom
    have e3 := congrArg (fun k => (k.app (Opposite.op V)).hom x) e2
    have e4 := NatTrans.naturality_apply ((wcEtBaseChange g).op.lan.map φ.hom)
      (wcEtInvLift g V O h hh).op
      ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x)
    have e5 := congrArg (fun k => (k.app (Opposite.op O)).hom
      ((((wcEtBaseChange g).op.lan.obj A.obj).map (wcEtInvLift g V O h hh).op).hom
        ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x))) e1
    refine e5.symm.trans ?_
    refine congrArg (fun p => ((toSheafify (Scheme.smallEtaleTopology Z)
      ((wcEtBaseChange g).op.lan.obj B.obj)).app (Opposite.op O)).hom p) ?_
    refine e4.trans ?_
    refine congrArg (fun p => (((wcEtBaseChange g).op.lan.obj B.obj).map
      (wcEtInvLift g V O h hh).op).hom p) ?_
    exact e3.symm

  have hPull : ∀ {P : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} {Q : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
      (θ : P ⟶ (wcEtBaseChange g).op ⋙ Q) (V : X.Etale) (O : Z.Etale) (h : O.left ⟶ V.left)
      (hh : h ≫ V.hom = O.hom ≫ g) (x : P.obj (Opposite.op V)),
      ((wcLpttPullSh g θ).hom.app (Opposite.op O)).hom
        (wcEtInvRho g ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P)
          V O h hh (((toSheafify (Scheme.smallEtaleTopology X) P).app (Opposite.op V)).hom x)) =
      ((toSheafify (Scheme.smallEtaleTopology Z) Q).app (Opposite.op O)).hom
        ((Q.map (wcEtInvLift g V O h hh).op).hom ((θ.app (Opposite.op V)).hom x)) := by
    intro P Q θ V O h hh x
    haveI := hc
    let Lp := sheafifyLift (Scheme.smallEtaleTopology X)
      (θ ≫ Functor.whiskerLeft (wcEtBaseChange g).op (toSheafify (Scheme.smallEtaleTopology Z) Q))
      ((wcEtBaseChange g).op_comp_isSheaf (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology Z)
        ((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj Q))
    let M := (((wcEtBaseChange g).op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv
      (sheafify (Scheme.smallEtaleTopology X) P) (sheafify (Scheme.smallEtaleTopology Z) Q)).symm Lp
    let N := ((sheafificationAdjunction (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).homEquiv
      ((wcEtBaseChange g).op.lan.obj (sheafify (Scheme.smallEtaleTopology X) P))
      ((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj Q)).symm M
    have hN : wcLpttPullSh g θ = N := by
      unfold wcLpttPullSh
      exact dif_pos hc
    have hNM := Equiv.apply_symm_apply
      ((sheafificationAdjunction (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).homEquiv
        ((wcEtBaseChange g).op.lan.obj (sheafify (Scheme.smallEtaleTopology X) P))
        ((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj Q)) M
    rw [Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app] at hNM
    have hML := Equiv.apply_symm_apply
      (((wcEtBaseChange g).op.lanAdjunction AddCommGrpCat.{u+1}).homEquiv
        (sheafify (Scheme.smallEtaleTopology X) P) (sheafify (Scheme.smallEtaleTopology Z) Q)) Lp
    rw [Adjunction.homEquiv_unit, Functor.lanAdjunction_unit] at hML
    have hLp := toSheafify_sheafifyLift (Scheme.smallEtaleTopology X)
      (θ ≫ Functor.whiskerLeft (wcEtBaseChange g).op (toSheafify (Scheme.smallEtaleTopology Z) Q))
      ((wcEtBaseChange g).op_comp_isSheaf (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology Z)
        ((presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj Q))
    rw [hN]
    have c1 := congrArg (fun k => (k.app (Opposite.op O)).hom
      ((((wcEtBaseChange g).op.lan.obj (sheafify (Scheme.smallEtaleTopology X) P)).map
        (wcEtInvLift g V O h hh).op).hom
        ((((wcEtBaseChange g).op.lanUnit.app (sheafify (Scheme.smallEtaleTopology X) P)).app
          (Opposite.op V)).hom
          (((toSheafify (Scheme.smallEtaleTopology X) P).app (Opposite.op V)).hom x)))) hNM
    have c2 := NatTrans.naturality_apply M (wcEtInvLift g V O h hh).op
      ((((wcEtBaseChange g).op.lanUnit.app (sheafify (Scheme.smallEtaleTopology X) P)).app
          (Opposite.op V)).hom
          (((toSheafify (Scheme.smallEtaleTopology X) P).app (Opposite.op V)).hom x))
    have c3 := congrArg (fun k => (k.app (Opposite.op V)).hom
      (((toSheafify (Scheme.smallEtaleTopology X) P).app (Opposite.op V)).hom x)) hML
    have c4 := congrArg (fun k => (k.app (Opposite.op V)).hom x) hLp
    have c5 := NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology Z) Q)
      (wcEtInvLift g V O h hh).op ((θ.app (Opposite.op V)).hom x)
    refine c1.trans ?_
    refine c2.trans ?_
    have c34 := c3.trans c4
    refine (congrArg (fun p => ((sheafify (Scheme.smallEtaleTopology Z) Q).map
      (wcEtInvLift g V O h hh).op).hom p) c34).trans ?_
    exact c5.symm

  have hGen0 : ∀ (Y : Scheme.{u}) (hℓY : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))),
      ((wcLpttGen0 Y ℓ n hℓY).hom.app (Opposite.op (wcEtTop Y))).hom (wcFtcGen Y (wcEtTop Y)) =
        ((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) 0))).app
          (Opposite.op (wcEtTop Y))).hom
          (ULift.up (wcLpttE0 (ℓ ^ n) (Scheme.Γ.obj (Opposite.op (wcEtTop Y).left)))) := by
    intro Y hℓY
    have hνnat : ∀ ⦃X Z : (Y.Etale)ᵒᵖ⦄ (f : X ⟶ Z),
        (wcLpttEtUTPre Y ℓ 0).map f ≫ (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun x =>
          (ULift.up (TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ 0).obj (Scheme.Γ.obj (Opposite.op (Z.unop.left))))
            (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op (Z.unop.left))))
            (FreeAbelianGroup.of x.down)
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
            ULift.{u+1} _)))) =
        (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun x =>
          (ULift.up (TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ 0).obj (Scheme.Γ.obj (Opposite.op (X.unop.left))))
            (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op (X.unop.left))))
            (FreeAbelianGroup.of x.down)
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
            ULift.{u+1} _)))) ≫
          (wcLpttEtPre Y (wcTensFun (wcKtZUT.{u} ℓ 0) (wcKtT.{u} (ℓ ^ n) 0))).map f := by
      intro X Z f
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro x
      erw [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_comp]
      erw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply]
      erw [FreeAbelianGroup.lift_apply_of]
      erw [FreeAbelianGroup.lift_apply_of]
      apply ULift.ext
      refine Eq.trans ?_ (TensorProduct.map_tmul _ _ _ _).symm
      refine congrArg₂ (TensorProduct.tmul ℤ) ?_ ?_
      · exact (FreeAbelianGroup.map_of_apply _).symm
      · exact (heT' _ _ (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).map f.unop).op)
          _ rfl).symm
    have hνapp : ∀ (W : (Y.Etale)ᵒᵖ) (a : ULift.{u+1} ((wcUnitTupleFun.{u} ℓ 0).obj
        (Scheme.Γ.obj (Opposite.op W.unop.left)))),
        ((wcLpttEtNu Y ℓ n 0).app W).hom (FreeAbelianGroup.of a) =
          ULift.up (TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ 0).obj (Scheme.Γ.obj (Opposite.op (W.unop.left))))
            (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op (W.unop.left))))
            (FreeAbelianGroup.of a.down)
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) := by
      intro W a
      unfold wcLpttEtNu wcNatOf
      split_ifs with h
      · exact FreeAbelianGroup.lift_apply_of _ _
      · exact absurd hνnat h
    have hL : ∀ (M : Type u) [AddCommGroup M] (α : Type u) (a : FreeAbelianGroup α) (b : M),
        (FreeAbelianGroup.lift (fun _ : α => (LinearMap.id : M →ₗ[ℤ] M))) a b =
          (FreeAbelianGroup.lift (fun _ : α => (1 : ℤ)) a) • b := by
      intro M _ α a b
      induction a using FreeAbelianGroup.induction_on with
      | zero => simp
      | of x => simp [FreeAbelianGroup.lift_apply_of]
      | neg x hx => simp only [map_neg, LinearMap.neg_apply, hx, neg_smul]
      | add x y hx hy => simp only [map_add, LinearMap.add_apply, hx, hy, add_smul]
    have haug : ∀ (α β : Type u) (g : α → β) (z : FreeAbelianGroup α),
        FreeAbelianGroup.lift (fun _ : β => (1 : ℤ)) (FreeAbelianGroup.map g z) =
          FreeAbelianGroup.lift (fun _ : α => (1 : ℤ)) z := by
      intro α β g z
      have : (FreeAbelianGroup.lift (fun _ : β => (1 : ℤ))).comp (FreeAbelianGroup.map g) =
          FreeAbelianGroup.lift (fun _ : α => (1 : ℤ)) := by
        apply FreeAbelianGroup.lift_ext
        intro a
        rw [AddMonoidHom.comp_apply, FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of]
      exact congrArg (fun h => h z) this
    have hgenT : ∀ (α β : Type u) (g : α → β) (A B : Type u) [AddCommGroup A] [AddCommGroup B]
        (h : A →+ B) (w : TensorProduct ℤ (FreeAbelianGroup α) A),
        TensorProduct.lift
            (FreeAbelianGroup.lift (fun _ : β => (LinearMap.id : B →ₗ[ℤ] B))).toIntLinearMap
          (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap h.toIntLinearMap w) =
        h (TensorProduct.lift
            (FreeAbelianGroup.lift (fun _ : α => (LinearMap.id : A →ₗ[ℤ] A))).toIntLinearMap w) := by
      intro α β g A B _ _ h w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul z y =>
        rw [TensorProduct.map_tmul, TensorProduct.lift.tmul, TensorProduct.lift.tmul]
        simp only [AddMonoidHom.coe_toIntLinearMap]
        rw [hL, hL, haug, map_zsmul]
      | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂, map_add, map_add]
    have hεnat : ∀ ⦃R S : CommRingCat.{u}⦄ (φ : R ⟶ S),
        (wcTensFun (wcKtZUT.{u} ℓ 0) (wcKtT.{u} (ℓ ^ n) 0)).map φ ≫
          AddCommGrpCat.ofHom (TensorProduct.lift
            (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
              (wcKtT.{u} (ℓ ^ n) 0).obj S →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) 0).obj S))).toIntLinearMap).toAddMonoidHom =
        AddCommGrpCat.ofHom (TensorProduct.lift
            (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
              (wcKtT.{u} (ℓ ^ n) 0).obj R →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) 0).obj R))).toIntLinearMap).toAddMonoidHom ≫
          (wcKtT.{u} (ℓ ^ n) 0).map φ := by
      intro R S φ
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro w
      exact hgenT _ _ _ _ _ _ w
    have hεapp : ∀ (R : CommRingCat.{u}) (t : (wcUnitTupleFun.{u} ℓ 0).obj R)
        (y : (wcKtT.{u} (ℓ ^ n) 0).obj R),
        ((wcKtEps.{u} ℓ n 0).app R).hom
          (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ 0).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
            (FreeAbelianGroup.of t) y) = y := by
      intro R t y
      unfold wcKtEps wcNatOf
      split_ifs with h
      · change (TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
            (wcKtT.{u} (ℓ ^ n) 0).obj R →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) 0).obj R))).toIntLinearMap)
            (FreeAbelianGroup.of t ⊗ₜ[ℤ] y) = y
        rw [TensorProduct.lift.tmul, AddMonoidHom.coe_toIntLinearMap, FreeAbelianGroup.lift_apply_of,
          LinearMap.id_apply]
      · exact absurd hεnat h
    let U := Functor.whiskerRight
        ((yonedaEquiv (X := wcEtTop Y)
          (F := (Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ 0)).symm
          (Subtype.mk Fin.elim0 hℓY : {t : Fin 0 → (Γ(Y, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))}))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let ε' := Functor.whiskerLeft ((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcKtEps.{u} ℓ n 0) AddCommGrpCat.uliftFunctor.{u+1, u})
    let θ := U ≫ wcLpttEtNu Y ℓ n 0 ≫ ε'
    have hgen : wcLpttGen0 Y ℓ n hℓY =
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map θ := by
      have e1 : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map θ =
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map U ≫
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
            (wcLpttEtNu Y ℓ n 0) ≫
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map ε' := by
        exact ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp U
          (wcLpttEtNu Y ℓ n 0 ≫ ε')).trans
          (congrArg ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map U ≫ ·)
            ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp
              (wcLpttEtNu Y ℓ n 0) ε'))
      rw [e1]
      rfl
    let W0 : (Y.Etale)ᵒᵖ := Opposite.op (wcEtTop Y)
    let x0 : FreeAbelianGroup (ULift.{u+1} (wcEtTop Y ⟶ wcEtTop Y)) :=
      FreeAbelianGroup.of (ULift.up (𝟙 (wcEtTop Y)))
    have hU : ∃ a, (U.app W0).hom x0 = FreeAbelianGroup.of a :=
      ⟨_, FreeAbelianGroup.map_of_apply _⟩
    obtain ⟨a, ha⟩ := hU
    have hθ : (θ.app W0).hom x0 =
        ULift.up (wcLpttE0 (ℓ ^ n) (Scheme.Γ.obj (Opposite.op (wcEtTop Y).left))) := by
      change (ε'.app W0).hom (((wcLpttEtNu Y ℓ n 0).app W0).hom ((U.app W0).hom x0)) = _
      rw [ha]
      refine (congrArg (ε'.app W0).hom (hνapp W0 a)).trans ?_
      apply ULift.ext
      exact (hεapp _ _ _).trans (he _).symm
    rw [hgen]
    exact (congrArg (fun k => (k.app W0).hom x0)
      (toSheafify_naturality (Scheme.smallEtaleTopology Y) θ)).symm.trans
      (congrArg (fun p => ((toSheafify (Scheme.smallEtaleTopology Y)
        (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) 0))).app W0).hom p) hθ)

  have hg : g ≫ (wcEtTop X).hom = (wcEtTop Z).hom ≫ g :=
    (Category.comp_id g).trans (Category.id_comp g).symm
  apply hinj
  rw [hGen0 Z hℓZ]
  have s1 : ((wcLpttPullAlpha g).hom.app (Opposite.op (wcEtTop Z))).hom (wcFtcGen Z (wcEtTop Z)) =
      wcEtInvRho g (wcFtcFS X (wcEtTop X)) (wcEtTop X) (wcEtTop Z) g hg (wcFtcGen X (wcEtTop X)) :=
    hGen (wcEtTop Z) ((wcEtInv g).obj (wcFtcFS X (wcEtTop X)))
      (wcEtInvRho g (wcFtcFS X (wcEtTop X)) (wcEtTop X) (wcEtTop Z) g hg (wcFtcGen X (wcEtTop X)))
  have s2 := hRho (wcLpttGen0 X ℓ n hℓX) (wcEtTop X) (wcEtTop Z) g hg (wcFtcGen X (wcEtTop X))
  rw [hGen0 X hℓX] at s2
  have s3 := hPull (wcLpttCanPre g (wcKtT.{u} (ℓ ^ n) 0)) (wcEtTop X) (wcEtTop Z) g hg
    (ULift.up (wcLpttE0 (ℓ ^ n) (Scheme.Γ.obj (Opposite.op (wcEtTop X).left))))
  have s4 : ((wcLpttEtPre Z (wcKtT.{u} (ℓ ^ n) 0)).map
        (wcEtInvLift g (wcEtTop X) (wcEtTop Z) g hg).op).hom
      (((wcLpttCanPre g (wcKtT.{u} (ℓ ^ n) 0)).app (Opposite.op (wcEtTop X))).hom
        (ULift.up (wcLpttE0 (ℓ ^ n) (Scheme.Γ.obj (Opposite.op (wcEtTop X).left))))) =
      ULift.up (wcLpttE0 (ℓ ^ n) (Scheme.Γ.obj (Opposite.op (wcEtTop Z).left))) := by
    apply ULift.ext
    change ((wcKtT.{u} (ℓ ^ n) 0).map (Scheme.Γ.map ((Scheme.Etale.forget Z ⋙ Over.forget Z).map
        (wcEtInvLift g (wcEtTop X) (wcEtTop Z) g hg)).op)).hom
      (((wcKtT.{u} (ℓ ^ n) 0).map (Scheme.Γ.map ((wcEtBaseChangeFst g).app (wcEtTop X)).op)).hom
        (wcLpttE0 (ℓ ^ n) (Scheme.Γ.obj (Opposite.op (wcEtTop X).left)))) = _
    exact heT' _ _ _ _ (heT' _ _ _ _ rfl)
  change ((wcLpttPullB g (wcKtT.{u} (ℓ ^ n) 0)).hom.app (Opposite.op (wcEtTop Z))).hom
      ((((wcEtInv g).map (wcLpttGen0 X ℓ n hℓX)).hom.app (Opposite.op (wcEtTop Z))).hom
        (((wcLpttPullAlpha g).hom.app (Opposite.op (wcEtTop Z))).hom (wcFtcGen Z (wcEtTop Z)))) = _
  rw [s1, s2]
  exact s3.trans (congrArg (fun p => ((toSheafify (Scheme.smallEtaleTopology Z)
    (wcLpttEtPre Z (wcKtT.{u} (ℓ ^ n) 0))).app (Opposite.op (wcEtTop Z))).hom p) s4)

theorem wc_lptt_sym_pull {X Z : Scheme.{u}} (g : Z ⟶ X) (ℓ n k : ℕ) (s : Fin k → (Γ(X, ⊤))ˣ)
    (hℓX : IsUnit ((ℓ : ℕ) : Γ(X, ⊤))) (hℓZ : IsUnit ((ℓ : ℕ) : Γ(Z, ⊤))) (c : ℕ) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    c • wcLpttSym X ℓ n k s hℓX = 0 →
      c • wcLpttSym Z ℓ n k (fun i => Units.map g.appTop.hom.toMonoidHom (s i)) hℓZ = 0 :=
by
  classical
  letI iX : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI iZ : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨h1, h2, h3⟩ := wc_etInv_exact g
  haveI := h1
  haveI := h2
  haveI := h3
  have hc := wc_et_basechange_isContinuous g
  have hB : ∀ {G G' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : G ⟶ G'),
      (wcEtInv g).map (wcLpttEtShMap X α) ≫ wcLpttPullB g G' =
        wcLpttPullB g G ≫ wcLpttEtShMap Z α :=
    fun α => wc_lptt_pullsh_nat g (wcLpttPreMap X α) (wcLpttPreMap Z α) (wcLpttCanPre g _)
      (wcLpttCanPre g _) ((wc_lptt_canpre_squares g).1 α)
  have hU : ∀ (k : ℕ) (a : (Γ(X, ⊤))ˣ),
      (wcEtInv g).map (wcLpttUSec X ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓX) ≫
        wcLpttPullB g (wcTensFun (wcKtZUT.{u} ℓ (k + 1)) (wcKtT.{u} (ℓ ^ n) k)) =
      wcLpttPullB g (wcKtT.{u} (ℓ ^ n) k) ≫ wcLpttUSec Z ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then Units.map g.appTop.hom.toMonoidHom a else 1)
          hℓZ := by
    intro k a
    have e : (fun i : Fin (k + 1) => Units.map g.appTop.hom.toMonoidHom
        (if (i : ℕ) = k then a else 1)) =
        fun i : Fin (k + 1) => if (i : ℕ) = k then Units.map g.appTop.hom.toMonoidHom a else 1 := by
      funext i
      split_ifs <;> simp
    have h0 := wc_lptt_pullsh_nat g _ _ (wcLpttCanPre g _) (wcLpttCanPre g _)
      ((wc_lptt_canpre_squares g).2 ℓ n (k + 1) k
        (fun i : Fin (k + 1) => if (i : ℕ) = k then a else 1) hℓX hℓZ)
    rw [e] at h0
    exact h0
  let Φ : ∀ k : ℕ, Abelian.Ext (wcFtcFS X (wcEtTop X)) (wcLpttEtSh X (wcKtT.{u} (ℓ ^ n) k)) k →+
      Abelian.Ext (wcFtcFS Z (wcEtTop Z)) (wcLpttEtSh Z (wcKtT.{u} (ℓ ^ n) k)) k := fun k =>
    ((Abelian.Ext.mk₀ (wcLpttPullAlpha g)).precomp _ (zero_add k)).comp
      (((Abelian.Ext.mk₀ (wcLpttPullB g (wcKtT.{u} (ℓ ^ n) k))).postcomp _ (add_zero k)).comp
        ((wcEtInv g).mapExtAddHom _ _ k))
  have hΦ : ∀ k y, Φ k y = (Abelian.Ext.mk₀ (wcLpttPullAlpha g)).comp
      ((Abelian.Ext.mapExactFunctor (wcEtInv g) y).comp
        (Abelian.Ext.mk₀ (wcLpttPullB g (wcKtT.{u} (ℓ ^ n) k))) (add_zero k)) (zero_add k) := by
    intro k y
    simp only [Φ, AddMonoidHom.comp_apply, Abelian.Ext.precomp, Abelian.Ext.postcomp,
      AddMonoidHom.flip_apply, Abelian.Ext.bilinearComp_apply_apply, Functor.mapExtAddHom_apply]
  have key : ∀ (k : ℕ) (s : Fin k → (Γ(X, ⊤))ˣ), Φ k (wcLpttSym X ℓ n k s hℓX) =
      wcLpttSym Z ℓ n k (fun i => Units.map g.appTop.hom.toMonoidHom (s i)) hℓZ := by
    intro k
    induction k with
    | zero =>
      intro s
      rw [hΦ]
      show (Abelian.Ext.mk₀ (wcLpttPullAlpha g)).comp
          ((Abelian.Ext.mapExactFunctor (wcEtInv g) (Abelian.Ext.mk₀ (wcLpttGen0 X ℓ n hℓX))).comp
            (Abelian.Ext.mk₀ (wcLpttPullB g (wcKtT.{u} (ℓ ^ n) 0))) (add_zero 0)) (zero_add 0) =
        Abelian.Ext.mk₀ (wcLpttGen0 Z ℓ n hℓZ)
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        wc_lptt_gen0_pull g ℓ n hℓX hℓZ hc]
    | succ k ih =>
      intro s
      rw [hΦ]
      show (Abelian.Ext.mk₀ (wcLpttPullAlpha g)).comp
          ((Abelian.Ext.mapExactFunctor (wcEtInv g)
            ((wcLpttSym X ℓ n k (fun i => s i.castSucc) hℓX).comp
              (wcLpttKt X ℓ n k (s (Fin.last k)) hℓX) rfl)).comp
            (Abelian.Ext.mk₀ (wcLpttPullB g (wcKtT.{u} (ℓ ^ n) (k + 1))))
            (add_zero (k + 1))) (zero_add (k + 1)) =
        (wcLpttSym Z ℓ n k (fun i => Units.map g.appTop.hom.toMonoidHom (s i.castSucc)) hℓZ).comp
          (wcLpttKt Z ℓ n k (Units.map g.appTop.hom.toMonoidHom (s (Fin.last k))) hℓZ) rfl
      rw [Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega : k + 1 + 0 = k + 1),
        wc_lptt_kt_pull g ℓ n k (s (Fin.last k)) hℓX hℓZ hB (hU k _)
          (wc_lptt_et_step_ses X ℓ n (k + 1) k) (wc_lptt_et_step_ses Z ℓ n (k + 1) k),
        ← Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 1) (by omega : k + 0 + 1 = k + 1),
        ← Abelian.Ext.comp_assoc _ _ _ (zero_add k) rfl (by omega : 0 + k + 1 = k + 1),
        ← hΦ k, ih (fun i => s i.castSucc)]
  intro h
  rw [← key k s, ← map_nsmul, h, map_zero]

theorem wc_lptt_tor_to_torus (K : Type u) [Field K] [IsAlgClosed K] (d : ℕ) (hd : 1 ≤ d)
    (tD : Fin d → (Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤))ˣ)
    (htD : ∀ i, ((tD i : Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤))) =
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1).ι.appTop.hom (wcAffCoord K d i)) :
    ∃ h : (wcLpttTor K d).left ⟶ (wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left,
      ∀ i, Units.map h.appTop.hom.toMonoidHom (tD i) = wcLpttTorCoord K d i :=
by
  classical

  have hiso : ∀ (A B : CommRingCat.{u}) (e : A ≅ B) (x : B), e.hom.hom (e.inv.hom x) = x := by
    intro A B e x
    have := congrArg (fun q : B ⟶ B => q.hom x) e.inv_hom_id
    first
      | exact this
      | simp
      | simpa using this
  have hunitTop : ∀ (Y : Scheme.{u}) (r : Γ(Y, ⊤)), IsUnit r → ∀ y : Y, y ∈ Y.basicOpen r := by
    intro Y r hr y
    rw [Scheme.basicOpen_of_isUnit Y hr]
    trivial

  obtain ⟨φ, hφ⟩ : ∃ φ : MvPolynomial (Fin d) K →+* Γ((wcLpttTor K d).left, ⊤),
      ∀ i, φ (MvPolynomial.X i) = (wcLpttTorCoord K d i : Γ((wcLpttTor K d).left, ⊤)) :=
    ⟨MvPolynomial.eval₂Hom ((wcLpttTor K d).hom.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)
      (fun i => (wcLpttTorCoord K d i : Γ((wcLpttTor K d).left, ⊤))),
     fun i => MvPolynomial.eval₂Hom_X' _ _ _⟩
  obtain ⟨a, ha⟩ : ∃ a : (wcLpttTor K d).left ⟶ Spec (.of (MvPolynomial (Fin d) K)),
      ∀ i, a.appTop.hom ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin d) K))).inv.hom
        (MvPolynomial.X i)) = (wcLpttTorCoord K d i : Γ((wcLpttTor K d).left, ⊤)) := by
    refine ⟨(wcLpttTor K d).left.toSpecΓ ≫ Spec.map (CommRingCat.ofHom φ), fun i => ?_⟩
    rw [← hφ i]
    have h5 := congrArg (fun q => q.hom (MvPolynomial.X i))
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h5
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [← h5, Scheme.toSpecΓ_appTop]
    exact hiso _ _ _ _

  have haX : ∀ (z : (wcLpttTor K d).left) (i : Fin d),
      a z ∈ PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin d) K) := by
    intro z i
    have h1 : z ∈ (wcLpttTor K d).left.basicOpen (a.appTop.hom
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin d) K))).inv.hom (MvPolynomial.X i))) := by
      rw [ha i]
      exact hunitTop _ _ (Units.isUnit _) z
    rw [← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine] at h1
    exact h1
  haveI hUimm : IsOpenImmersion (wcAffPunct K d).hom :=
    inferInstanceAs (IsOpenImmersion (wcAffPunctOpen K d).ι)
  obtain ⟨a₁, ha₁⟩ : ∃ a₁ : (wcLpttTor K d).left ⟶ (wcAffPunct K d).left,
      a₁ ≫ (wcAffPunct K d).hom = a := by
    have hr : Set.range a ⊆ Set.range (wcAffPunct K d).hom := by
      rintro _ ⟨z, rfl⟩
      show a z ∈ Set.range (wcAffPunctOpen K d).ι
      rw [Scheme.Opens.range_ι]
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨0, by omega⟩, haX z _⟩
    exact ⟨IsOpenImmersion.lift (wcAffPunct K d).hom a hr, IsOpenImmersion.lift_fac _ _ _⟩
  subst ha₁
  have ha₁c : ∀ i, a₁.appTop.hom (wcAffCoord K d i) =
      (wcLpttTorCoord K d i : Γ((wcLpttTor K d).left, ⊤)) := by
    intro i
    have := ha i
    rw [Scheme.Hom.comp_appTop] at this
    exact this

  have hb : ∀ (z : (wcLpttTor K d).left) (i : Fin d),
      a₁ z ∈ (wcAffPunct K d).left.basicOpen (wcAffCoord K d i) := by
    intro z i
    have h1 : z ∈ (wcLpttTor K d).left.basicOpen (a₁.appTop.hom (wcAffCoord K d i)) := by
      rw [ha₁c i]
      exact hunitTop _ _ (Units.isUnit _) z
    rw [← Scheme.preimage_basicOpen_top] at h1
    exact h1
  obtain ⟨h, hh⟩ : ∃ h : (wcLpttTor K d).left ⟶
      ((wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1 : (wcAffPunct K d).left.Opens) :
        Scheme.{u}),
      h ≫ (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1).ι = a₁ := by
    have hr : Set.range a₁ ⊆
        Set.range (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1).ι := by
      rintro _ ⟨z, rfl⟩
      rw [Scheme.Opens.range_ι]
      exact ⟨fun i _ => hb z i, ⟨0, by omega⟩, Nat.one_pos, hb z _⟩
    exact ⟨IsOpenImmersion.lift (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1).ι a₁ hr,
      IsOpenImmersion.lift_fac _ _ _⟩

  refine ⟨h, fun i => Units.ext ?_⟩
  have key' : h.appTop.hom ((wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1).ι.appTop.hom
      (wcAffCoord K d i)) = (wcLpttTorCoord K d i : Γ((wcLpttTor K d).left, ⊤)) := by
    rw [← ha₁c i, ← hh, Scheme.Hom.comp_appTop]
    all_goals rfl
  have e1 := congrArg h.appTop.hom (htD i)
  exact e1.trans key'

theorem wc_lptt_tor_lft (K : Type u) [Field K] (j : ℕ) :
    LocallyOfFiniteType (wcLpttTor K j).hom :=
by
  haveI hg : LocallyOfFiniteType
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) :=
    (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType) (R := CommRingCat.of K)
      (S := CommRingCat.of (LaurentPolynomial K))
      (φ := CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))).mpr
      (RingHom.finiteType_algebraMap.mpr
        (inferInstance : Algebra.FiniteType K (LaurentPolynomial K)))
  induction j with
  | zero =>
    show LocallyOfFiniteType (𝟙 (Spec (.of K)))
    infer_instance
  | succ j ih =>
    haveI := ih
    show LocallyOfFiniteType (Limits.pullback.snd (wcLpttTor K j).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))
    infer_instance

theorem wc_lptt_et_symbol_order (K : Type u) [Field K] [IsAlgClosed K] (d : ℕ) (hd : 1 ≤ d)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : IsUnit ((ℓ : ℕ) : K)) (n : ℕ) (hn : 1 ≤ n)
    (tD : Fin d → (Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤))ˣ)
    (hℓD : IsUnit ((ℓ : ℕ) : Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤)))
    (htD : ∀ i, ((tD i : Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤))) =
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1).ι.appTop.hom (wcAffCoord K d i)) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (wcVRes (Spec (.of (MvPolynomial (Fin d) K)))
      (wcAffPunct K d) (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left)
      AddCommGrpCat.{u+1}) := HasExt.standard _
    ℓ ^ (n - 1) • (Abelian.Ext.mk₀ (wcLpttEtUTMap (wcVRes (Spec (.of (MvPolynomial (Fin d) K)))
        (wcAffPunct K d) (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left ℓ d tD hℓD)).comp
      (wcLpttEtKum (wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
        (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left ℓ n d) (zero_add d) ≠ 0 :=
by
  classical
  have hℓj : ∀ j, IsUnit ((ℓ : ℕ) : Γ((wcLpttTor K j).left, ⊤)) := by
    intro j
    have h1 := hℓK.map ((wcLpttTor K j).hom.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)
    rw [map_natCast] at h1
    exact h1
  have hb : ∀ j, ℓ ^ (n - 1) • wcLpttSym (wcLpttTor K j).left ℓ n j (wcLpttTorCoord K j)
      (hℓj j) ≠ 0 := by
    intro j
    induction j with
    | zero => exact wc_lptt_sym_point K ℓ n hn (hℓj 0)
    | succ j ih =>
      haveI := wc_lptt_tor_lft K j
      exact wc_lptt_et_gm_step K ℓ hℓK n hn (wcLpttTor K j).left (wcLpttTor K j).hom j
        (wcLpttTorCoord K j) (hℓj j) (hℓj (j + 1)) ih
  obtain ⟨h, hh⟩ := wc_lptt_tor_to_torus K d hd tD htD
  have key := wc_lptt_kum_eq_sym (wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
    (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left ℓ n d tD hℓD
  rw [key]
  intro h0
  apply hb d
  have hp := wc_lptt_sym_pull h ℓ n d tD hℓD (hℓj d) (ℓ ^ (n - 1)) h0
  have e : (fun i => Units.map h.appTop.hom.toMonoidHom (tD i)) = wcLpttTorCoord K d := funext hh
  rw [e] at hp
  exact hp

theorem wc_lpkt_torus_symbol_order (K : Type u) [Field K] [IsAlgClosed K] (d : ℕ) (hd : 1 ≤ d)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : IsUnit ((ℓ : ℕ) : K)) (n : ℕ) (hn : 1 ≤ n)
    (tD : Fin d → (Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤))ˣ)
    (hℓD : IsUnit ((ℓ : ℕ) : Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤)))
    (htD : ∀ i, ((tD i : Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤))) =
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1).ι.appTop.hom (wcAffCoord K d i)) :
    ℓ ^ (n - 1) • (Abelian.Ext.mk₀ (wcUnitTupleMap (Spec (.of (MvPolynomial (Fin d) K)))
      (wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
        (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)) ℓ d tD hℓD)).comp
      (wcKumTuple (Spec (.of (MvPolynomial (Fin d) K))) ℓ n d) (zero_add d) ≠ 0 :=
by
  classical

  have hNopen : ∀ (X : Scheme.{u}) [TopologicalSpace.NoetherianSpace X] (U : X.Opens),
      TopologicalSpace.NoetherianSpace (U : Scheme.{u}) :=
    fun X _ U => TopologicalSpace.NoetherianSpace.set (U : Set X)
  haveI hN0 : TopologicalSpace.NoetherianSpace (Spec (.of (MvPolynomial (Fin d) K))) :=
    inferInstance
  haveI hN1 : TopologicalSpace.NoetherianSpace (wcAffPunct K d).left :=
    hNopen _ (wcAffPunctOpen K d)
  haveI hN2 : TopologicalSpace.NoetherianSpace (wcVRes (Spec (.of (MvPolynomial (Fin d) K)))
      (wcAffPunct K d) (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left :=
    hNopen _ (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)
  haveI hLN1 : IsLocallyNoetherian (wcAffPunct K d).left :=
    (inferInstance : IsLocallyNoetherian ((wcAffPunctOpen K d : Scheme.{u})))
  haveI hLN2 : IsLocallyNoetherian (wcVRes (Spec (.of (MvPolynomial (Fin d) K)))
      (wcAffPunct K d) (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left :=
    (inferInstance : IsLocallyNoetherian
      ((wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1 : Scheme.{u})))

  apply wc_lptt_slice_reduce _ _ ℓ n d tD hℓD
  intro h0

  obtain ⟨h1, h2, h3⟩ := wc_epsInv_exact (wcVRes (Spec (.of (MvPolynomial (Fin d) K)))
      (wcAffPunct K d) (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left
  haveI := h1
  haveI := h2
  haveI := h3
  haveI : (wcEpsInv (wcVRes (Spec (.of (MvPolynomial (Fin d) K)))
      (wcAffPunct K d) (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left).Additive :=
    Functor.additive_of_preserves_binary_products _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (wcVRes (Spec (.of (MvPolynomial (Fin d) K)))
      (wcAffPunct K d) (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left)
      AddCommGrpCat.{u+1}) := HasExt.standard _

  obtain ⟨cF, cμ, hT⟩ := wc_lptt_epsInv_kum_transfer (wcVRes (Spec (.of (MvPolynomial (Fin d) K)))
      (wcAffPunct K d) (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left ℓ n d tD hℓD

  apply wc_lptt_et_symbol_order K d hd ℓ hℓK n hn tD hℓD htD
  apply wc_lptt_epsInv_ext_inj _ _ d
  rw [← Functor.mapExtAddHom_apply, map_nsmul, Functor.mapExtAddHom_apply, ← hT]
  have hlin : ∀ w : Abelian.Ext (wcFreeSheaf (wcVRes (Spec (.of (MvPolynomial (Fin d) K)))
        (wcAffPunct K d) (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left
        (Scheme.ProEt.mk (𝟙 _)))
        (wcRootTwist (wcVRes (Spec (.of (MvPolynomial (Fin d) K)))
          (wcAffPunct K d) (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left (ℓ ^ n) d) d,
      (Abelian.Ext.mk₀ cF.hom).comp (w.comp (Abelian.Ext.mk₀ cμ.inv) (add_zero d)) (zero_add d) =
        (((Abelian.Ext.mk₀ cF.hom).precomp _ (zero_add d)).comp
          ((Abelian.Ext.mk₀ cμ.inv).postcomp _ (add_zero d))) w := by
    intro w
    simp only [AddMonoidHom.comp_apply, Abelian.Ext.precomp, Abelian.Ext.postcomp,
      AddMonoidHom.flip_apply, Abelian.Ext.bilinearComp_apply_apply]
  rw [hlin, ← map_nsmul, h0, map_zero]

theorem wc_lpkt_affine_symbol_order (K : Type u) [Field K] [IsAlgClosed K] (d : ℕ) (hd2 : 2 ≤ d)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : IsUnit ((ℓ : ℕ) : K)) (n : ℕ) (hn : 1 ≤ n)
    (hT0 : ⊤ ≤ wcKOpen (wcAffPunct K d).left (wcAffCoord K d) (d - 1 + 1) (d - 1 + 1)) :
    wcSymNZ (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d) (wcAffCoord K d) ℓ n hT0 :=
by
  classical

  have hfun : ∀ {S : Scheme.{u}} {A B C : S.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap S a ≫ wcFreeSheafMap S b = wcFreeSheafMap S (a ≫ b) := by
    intro S A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      rw [yoneda.map_comp, Functor.whiskerRight_comp]
    exact ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map e)
  have hfunid : ∀ {S : Scheme.{u}} (A : S.ProEt), wcFreeSheafMap S (𝟙 A) = 𝟙 _ := by
    intro S A
    show (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
      (Functor.whiskerRight (yoneda.map (𝟙 A)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) = _
    rw [yoneda.map_id, Functor.whiskerRight_id', CategoryTheory.Functor.map_id]
    all_goals rfl

  have hsecinj : ∀ (S : Scheme.{u}) (V : S.ProEt) (O : V.left.Opens) (hO : ⊤ ≤ O)
      (M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (k k' : ℕ) (h : 0 + k = k')
      (w : Abelian.Ext (wcFreeSheaf S (wcVRes S V O)) M k),
      (Abelian.Ext.mk₀ (wcFreeSheafMap S (wcVResSec S V O hO))).comp w h = 0 → w = 0 := by
    intro S V O hO M k k' h w hw
    obtain rfl : k = k' := by omega
    let r : wcVRes S V O ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
    have hts : wcTopSec V.left O hO ≫ O.ι = 𝟙 V.left := IsOpenImmersion.lift_fac _ _ _
    have hrs : r ≫ wcVResSec S V O hO = 𝟙 _ := by
      apply MorphismProperty.Over.Hom.ext
      show O.ι ≫ wcTopSec V.left O hO = 𝟙 _
      rw [← cancel_mono O.ι, Category.assoc, hts, Category.comp_id, Category.id_comp]
    have h1 := congrArg (fun z => (Abelian.Ext.mk₀ (wcFreeSheafMap S r)).comp z (zero_add k)) hw
    simp only [Abelian.Ext.comp_zero] at h1
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hfun, hrs, hfunid, Abelian.Ext.mk₀_id_comp] at h1
    exact h1

  have hmvinj : ∀ (S : Scheme.{u}) (V : S.ProEt) {O₁₂ O₁ O₂ O : V.left.Opens}
      (h₁ : O₁₂ ≤ O₁) (h₂ : O₁₂ ≤ O₂) (h₃ : O₁ ≤ O) (h₄ : O₂ ≤ O),
      O₁ ⊔ O₂ = O → O₁ ⊓ O₂ = O₁₂ →
      ∀ (M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (k k' : ℕ) (hk : 1 + k = k'),
      (∀ z : Abelian.Ext (wcFreeSheaf S (wcVRes S V O₁)) M k, z = 0) →
      (∀ z : Abelian.Ext (wcFreeSheaf S (wcVRes S V O₂)) M k, z = 0) →
      ∀ y : Abelian.Ext (wcFreeSheaf S (wcVRes S V O₁₂)) M k,
        (wcMVClass S V h₁ h₂ h₃ h₄).comp y hk = 0 → y = 0 := by
    intro S V O₁₂ O₁ O₂ O h₁ h₂ h₃ h₄ hcup hcap M k k' hk hz1 hz2 y hy
    have hS := wc_lpgfg_open_mv_ses S V h₁ h₂ h₃ h₄ hcup hcap
    have e1 : wcMVClass S V h₁ h₂ h₃ h₄ = hS.extClass := by
      unfold wcMVClass
      exact dif_pos hS
    rw [e1] at hy
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS M y hk hy
    have hx0 : ∀ z : Abelian.Ext (wcFreeSheaf S (wcVRes S V O₁) ⊞ wcFreeSheaf S (wcVRes S V O₂)) M k,
        z = 0 := by
      intro z
      have htot := Limits.biprod.total (X := wcFreeSheaf S (wcVRes S V O₁))
        (Y := wcFreeSheaf S (wcVRes S V O₂))
      rw [← Abelian.Ext.mk₀_id_comp z, ← htot, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add k) (show 0 + 0 + k = k by omega),
        Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add k) (show 0 + 0 + k = k by omega),
        hz1 ((Abelian.Ext.mk₀ Limits.biprod.inl).comp z (zero_add k)),
        hz2 ((Abelian.Ext.mk₀ Limits.biprod.inr).comp z (zero_add k)),
        Abelian.Ext.comp_zero, Abelian.Ext.comp_zero, add_zero]
    have hx20 : x₂ = 0 := hx0 x₂
    rw [← hx₂, hx20]
    exact Abelian.Ext.comp_zero _ _ _ _ _

  have hcup : ∀ (X : Scheme.{u}) (fV : Fin d → Γ(X, ⊤)) (t : ℕ), t + 2 ≤ d →
      wcKOpen X fV (t + 1 + 1) (t + 1) ⊔ wcKOpen X fV (t + 1) (t + 1 + 1) =
        wcKOpen X fV (t + 1 + 1) (t + 1 + 1) := by
    intro X fV t ht
    apply le_antisymm
    · apply sup_le
      · rintro p ⟨h1, i, hi, h2⟩
        exact ⟨h1, i, by omega, h2⟩
      · rintro p ⟨h1, i, hi, h2⟩
        exact ⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩
    · rintro p ⟨h1, i, hi, h2⟩
      by_cases hx : p ∈ X.basicOpen (fV ⟨t + 1, by omega⟩)
      · refine TopologicalSpace.Opens.mem_sup.mpr (Or.inr ⟨fun i' hi' => ?_, ⟨t + 1, by omega⟩,
          (show t + 1 < t + 1 + 1 by omega), hx⟩)
        by_cases he : i'.val = t + 1
        · have hi'e : i' = ⟨t + 1, by omega⟩ := Fin.ext he
          rw [hi'e]
          exact hx
        · exact h1 i' (by omega)
      · refine TopologicalSpace.Opens.mem_sup.mpr (Or.inl ⟨h1, i, ?_, h2⟩)
        by_contra hlt
        have hie : i = ⟨t + 1, by omega⟩ := Fin.ext (show i.val = t + 1 by omega)
        rw [hie] at h2
        exact hx h2
  have hcap : ∀ (X : Scheme.{u}) (fV : Fin d → Γ(X, ⊤)) (t : ℕ),
      wcKOpen X fV (t + 1 + 1) (t + 1) ⊓ wcKOpen X fV (t + 1) (t + 1 + 1) =
        wcKOpen X fV (t + 1) (t + 1) := by
    intro X fV t
    apply le_antisymm
    · intro p hp
      rcases TopologicalSpace.Opens.mem_inf.mp hp with ⟨⟨_, i, hi, h2⟩, ⟨h1', _, _, _⟩⟩
      exact ⟨h1', i, hi, h2⟩
    · rintro p ⟨h1, i, hi, h2⟩
      exact TopologicalSpace.Opens.mem_inf.mpr
        ⟨⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩, ⟨h1, i, by omega, h2⟩⟩

  have hchain : ∀ t : ℕ, t + 1 ≤ d → ∀ y : Abelian.Ext (wcFreeSheaf (Spec (.of (MvPolynomial (Fin d) K)))
      (wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
        (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)))
      (wcRootTwist (Spec (.of (MvPolynomial (Fin d) K))) (ℓ ^ n) d) d,
      wcKChain (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d) (wcAffCoord K d)
        (wcRootTwist (Spec (.of (MvPolynomial (Fin d) K))) (ℓ ^ n) d) d t y = 0 → y = 0 := by
    intro t
    induction t with
    | zero => intro _ y hy; exact hy
    | succ t ih =>
      intro ht y hy
      simp only [wcKChain, AddMonoidHom.comp_apply, Abelian.Ext.precomp,
        Abelian.Ext.bilinearComp_apply_apply] at hy
      exact ih (by omega) y (hmvinj _ _ _ _ _ _
        (hcup (wcAffPunct K d).left (wcAffCoord K d) t (by omega))
        (hcap (wcAffPunct K d).left (wcAffCoord K d) t)
        _ (d + t) _ _
        (fun z => wc_lpkt_open_ext_vanishing K d ℓ hℓK n (t + 1 + 1) (t + 1) (d + t)
          (Or.inl ⟨by omega, by omega, by omega, by omega⟩) z)
        (fun z => wc_lpkt_open_ext_vanishing K d ℓ hℓK n (t + 1) (t + 1 + 1) (d + t)
          (Or.inr ⟨by omega, by omega, by omega⟩) z) _ hy)

  have hinj : ∀ z, wcKFinal (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d) (wcAffCoord K d)
      (wcRootTwist (Spec (.of (MvPolynomial (Fin d) K))) (ℓ ^ n) d) hT0 z = 0 → z = 0 := by
    intro z hz
    have hz' : (Abelian.Ext.mk₀ (wcFreeSheafMap (Spec (.of (MvPolynomial (Fin d) K)))
        (wcVResSec (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d) _ hT0))).comp
        (wcKChain (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d) (wcAffCoord K d)
          (wcRootTwist (Spec (.of (MvPolynomial (Fin d) K))) (ℓ ^ n) d) d (d - 1) z)
        (by omega : 0 + (d + (d - 1)) = 2 * d - 1) = 0 := hz
    exact hchain (d - 1) (by omega) z (hsecinj _ _ _ hT0 _ _ _ _ _ hz')

  have hunit : ∀ (Z : Scheme.{u}) (r : Γ(Z, ⊤)), (∀ z : Z, z ∈ Z.basicOpen r) → IsUnit r := by
    intro Z r hr
    exact RingedSpace.isUnit_of_isUnit_germ Z.toSheafedSpace ⊤ r
      (fun z _ => (Z.mem_basicOpen_top r z).mp (hr z))
  have hu : ∀ i, IsUnit ((wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1).ι.appTop.hom
      (wcAffCoord K d i)) := by
    intro i
    apply hunit
    intro z
    have hz : (∀ i' : Fin d, 1 ≤ i'.val → z.1 ∈ (wcAffPunct K d).left.basicOpen (wcAffCoord K d i')) ∧
        ∃ i' : Fin d, i'.val < 1 ∧ z.1 ∈ (wcAffPunct K d).left.basicOpen (wcAffCoord K d i') := z.2
    obtain ⟨hall, k, hk, hmem⟩ := hz
    have key : z.1 ∈ (wcAffPunct K d).left.basicOpen (wcAffCoord K d i) := by
      by_cases hi : 1 ≤ i.val
      · exact hall i hi
      · have hki : k = i := Fin.ext (by omega)
        rw [← hki]
        exact hmem
    rw [← Scheme.preimage_basicOpen_top]
    exact key
  have hℓD : IsUnit ((ℓ : ℕ) : Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤)) := by
    have h1 := hℓK.map ((wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1).ι.appTop.hom.comp
      ((wcAffPunctOpen K d).ι.appTop.hom.comp
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin d) K))).inv.hom.comp
          (algebraMap K (MvPolynomial (Fin d) K)))))
    rw [map_natCast] at h1
    exact h1
  obtain ⟨tD, htD⟩ : ∃ tD : Fin d → (Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
      (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤))ˣ,
      ∀ i, ((tD i : Γ((wcVRes (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d)
        (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1)).left, ⊤))) =
        (wcKOpen (wcAffPunct K d).left (wcAffCoord K d) 1 1).ι.appTop.hom (wcAffCoord K d i) :=
    ⟨fun i => (hu i).unit, fun i => (hu i).unit_spec⟩
  unfold wcSymNZ
  refine ⟨tD, hℓD, htD, ?_⟩
  intro h0
  apply wc_lpkt_torus_symbol_order K d (by omega) ℓ hℓK n hn tD hℓD htD
  refine hinj _ ?_
  rw [map_nsmul]
  exact h0

theorem wc_lpkt_affine_transport (K : Type u) [Field K] [IsAlgClosed K] (d : ℕ) (hd : 1 ≤ d)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : IsUnit ((ℓ : ℕ) : K)) (n : ℕ) (hn : 1 ≤ n)
    (T VT : (Spec (.of (MvPolynomial (Fin d) K))).ProEt) (j : VT ⟶ T)
    (A : Type u) [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : T.left ≅ Spec (.of A)) (φ : MvPolynomial (Fin d) K →+* A)
    (hTφ : T.hom = e.hom ≫ Spec.map (CommRingCat.ofHom φ))
    (f : Fin d → A) (hφf : ∀ i, φ (MvPolynomial.X i) = f i)
    (hspan : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (hdim : ringKrullDim A = (d : WithBot ℕ∞))
    (hpre : T.hom ⁻¹' {wcAffOrigin K d} = {e.inv (IsLocalRing.closedPoint A)})
    (hfib : IsIso (Limits.pullback.snd T.hom
      ((Spec (.of (MvPolynomial (Fin d) K))).fromSpecResidueField (wcAffOrigin K d))))
    (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {e.inv (IsLocalRing.closedPoint A)}ᶜ)
    (hT : ⊤ ≤ wcKOpen VT.left (wcParamFn j e f) (d - 1 + 1) (d - 1 + 1))
    (hvan : ∀ (q : ℕ), 1 ≤ q → ∀ x : Abelian.Ext (wcFreeSheaf (Spec (.of (MvPolynomial (Fin d) K)))
      (Scheme.ProEt.mk (𝟙 (Spec (.of (MvPolynomial (Fin d) K))))))
      (wcRootTwist (Spec (.of (MvPolynomial (Fin d) K))) (ℓ ^ n) d) q, x = 0)
    (hsym : ∀ hT0 : ⊤ ≤ wcKOpen (wcAffPunct K d).left (wcAffCoord K d) (d - 1 + 1) (d - 1 + 1),
      wcSymNZ (Spec (.of (MvPolynomial (Fin d) K))) (wcAffPunct K d) (wcAffCoord K d) ℓ n hT0) :
    wcSymNZ (Spec (.of (MvPolynomial (Fin d) K))) VT (wcParamFn j e f) ℓ n hT :=
by
  classical

  have hfun : ∀ (S : Scheme.{u}) {A₁ B₁ C₁ : S.ProEt} (a : A₁ ⟶ B₁) (b : B₁ ⟶ C₁),
      wcFreeSheafMap S a ≫ wcFreeSheafMap S b = wcFreeSheafMap S (a ≫ b) := by
    intro S A₁ B₁ C₁ a b
    have e' : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      rw [yoneda.map_comp, Functor.whiskerRight_comp]
    exact ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map e')

  have hlat : ∀ (X : Scheme.{u}) (fX : Fin d → Γ(X, ⊤)) (t : ℕ),
      wcKOpen X fX (t + 1 + 1) (t + 1) ⊔ wcKOpen X fX (t + 1) (t + 1 + 1) =
          wcKOpen X fX (t + 1 + 1) (t + 1 + 1) ∧
        wcKOpen X fX (t + 1 + 1) (t + 1) ⊓ wcKOpen X fX (t + 1) (t + 1 + 1) =
          wcKOpen X fX (t + 1) (t + 1) := by
    intro X fX t
    constructor
    · apply le_antisymm
      · intro x hx
        rcases (TopologicalSpace.Opens.mem_sup.mp hx) with ⟨h1, i, hi, h2⟩ | ⟨h1, i, hi, h2⟩
        · exact ⟨h1, i, by omega, h2⟩
        · exact ⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩
      · rintro x ⟨h1, i, hi, h2⟩
        by_cases hit : i.val < t + 1
        · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inl ⟨h1, i, hit, h2⟩)
        · refine TopologicalSpace.Opens.mem_sup.mpr (Or.inr ⟨fun i' hi' => ?_, i, hi, h2⟩)
          by_cases hi'' : t + 1 + 1 ≤ i'.val
          · exact h1 i' hi''
          · have hii : i' = i := Fin.ext (by omega)
            rw [hii]
            exact h2
    · apply le_antisymm
      · intro x hx
        obtain ⟨⟨_, i, hi, h2⟩, ⟨h1', _, _, _⟩⟩ := TopologicalSpace.Opens.mem_inf.mp hx
        exact ⟨h1', i, hi, h2⟩
      · rintro x ⟨h1, i, hi, h2⟩
        exact TopologicalSpace.Opens.mem_inf.mpr
          ⟨⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩, ⟨h1, i, by omega, h2⟩⟩
  have hK1 : ∀ (X : Scheme.{u}) (fX : Fin d → Γ(X, ⊤)) (t : ℕ),
      wcKOpen X fX (t + 1) (t + 1) ≤ wcKOpen X fX (t + 1 + 1) (t + 1) := by
    intro X fX t
    rintro x ⟨h1, i, hi, h2⟩
    exact ⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩
  have hK2 : ∀ (X : Scheme.{u}) (fX : Fin d → Γ(X, ⊤)) (t : ℕ),
      wcKOpen X fX (t + 1) (t + 1) ≤ wcKOpen X fX (t + 1) (t + 1 + 1) := by
    intro X fX t
    rintro x ⟨h1, i, hi, h2⟩
    exact ⟨h1, i, by omega, h2⟩
  have hK3 : ∀ (X : Scheme.{u}) (fX : Fin d → Γ(X, ⊤)) (t : ℕ),
      wcKOpen X fX (t + 1 + 1) (t + 1) ≤ wcKOpen X fX (t + 1 + 1) (t + 1 + 1) := by
    intro X fX t
    rintro x ⟨h1, i, hi, h2⟩
    exact ⟨h1, i, by omega, h2⟩
  have hK4 : ∀ (X : Scheme.{u}) (fX : Fin d → Γ(X, ⊤)) (t : ℕ),
      wcKOpen X fX (t + 1) (t + 1 + 1) ≤ wcKOpen X fX (t + 1 + 1) (t + 1 + 1) := by
    intro X fX t
    rintro x ⟨h1, i, hi, h2⟩
    exact ⟨fun i' hi' => h1 i' (by omega), i, hi, h2⟩

  have hnat : ∀ (S : Scheme.{u}) (V V' : S.ProEt) (g : V ⟶ V')
      (fV : Fin d → Γ(V.left, ⊤)) (fV' : Fin d → Γ(V'.left, ⊤))
      (hf : ∀ i, g.left.appTop.hom (fV' i) = fV i)
      (M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (hT : ⊤ ≤ wcKOpen V.left fV (d - 1 + 1) (d - 1 + 1))
      (hT' : ⊤ ≤ wcKOpen V'.left fV' (d - 1 + 1) (d - 1 + 1))
      (tD : Fin d → (Γ((wcVRes S V (wcKOpen V.left fV 1 1)).left, ⊤))ˣ)
      (hℓD : IsUnit ((ℓ : ℕ) : Γ((wcVRes S V (wcKOpen V.left fV 1 1)).left, ⊤)))
      (htD : ∀ i, ((tD i : Γ((wcVRes S V (wcKOpen V.left fV 1 1)).left, ⊤))) =
        (wcKOpen V.left fV 1 1).ι.appTop.hom (fV i))
      (tD' : Fin d → (Γ((wcVRes S V' (wcKOpen V'.left fV' 1 1)).left, ⊤))ˣ)
      (hℓD' : IsUnit ((ℓ : ℕ) : Γ((wcVRes S V' (wcKOpen V'.left fV' 1 1)).left, ⊤)))
      (htD' : ∀ i, ((tD' i : Γ((wcVRes S V' (wcKOpen V'.left fV' 1 1)).left, ⊤))) =
        (wcKOpen V'.left fV' 1 1).ι.appTop.hom (fV' i))
      (τ : Abelian.Ext (wcUnitTuple S ℓ d) M d),
      wcKFinal S V fV M hT ((Abelian.Ext.mk₀ (wcUnitTupleMap S (wcVRes S V (wcKOpen V.left fV 1 1))
          ℓ d tD hℓD)).comp τ (zero_add d)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap S g)).comp
          (wcKFinal S V' fV' M hT' ((Abelian.Ext.mk₀ (wcUnitTupleMap S
            (wcVRes S V' (wcKOpen V'.left fV' 1 1)) ℓ d tD' hℓD')).comp τ (zero_add d)))
          (zero_add (2 * d - 1)) := by
    intro S V V' g fV fV' hf M hT hT' tD hℓD htD tD' hℓD' htD' τ
    have hF : ∀ {A₁ B₁ C₁ : S.ProEt} (a : A₁ ⟶ B₁) (b : B₁ ⟶ C₁),
        wcFreeSheafMap S a ≫ wcFreeSheafMap S b = wcFreeSheafMap S (a ≫ b) :=
      fun a b => hfun S a b
    have hmonoι : ∀ (Y : Scheme.{u}) (O : Y.Opens), Mono O.ι := fun Y O => inferInstance
    have hts : ∀ (Y : Scheme.{u}) (O : Y.Opens) (hO : ⊤ ≤ O), wcTopSec Y O hO ≫ O.ι = 𝟙 Y :=
      fun Y O hO => IsOpenImmersion.lift_fac _ _ _
    have hpreD : ∀ i, g.left ⁻¹ᵁ V'.left.basicOpen (fV' i) = V.left.basicOpen (fV i) := by
      intro i
      rw [Scheme.preimage_basicOpen_top, hf i]
    have hpres : ∀ a b, wcKOpen V.left fV a b ≤ g.left ⁻¹ᵁ wcKOpen V'.left fV' a b := by
      rintro a b x ⟨h1, i, hi, h2⟩
      refine ⟨fun i' hi' => ?_, i, hi, ?_⟩
      · have h3 := h1 i' hi'
        rw [← hpreD i'] at h3
        exact h3
      · rw [← hpreD i] at h2
        exact h2
    have hcompat : ∀ (O₁ O₂ : V.left.Opens) (O₁' O₂' : V'.left.Opens) (hle : O₁ ≤ O₂)
        (hle' : O₁' ≤ O₂') (h1 : O₁ ≤ g.left ⁻¹ᵁ O₁') (h2 : O₂ ≤ g.left ⁻¹ᵁ O₂'),
        wcVResLE S V hle ≫ wcVResMap S g O₂ O₂' h2 = wcVResMap S g O₁ O₁' h1 ≫ wcVResLE S V' hle' := by
      intro O₁ O₂ O₁' O₂' hle hle' h1 h2
      apply MorphismProperty.Over.Hom.ext
      show V.left.homOfLE hle ≫ g.left.resLE O₂' O₂ h2 = g.left.resLE O₁' O₁ h1 ≫ V'.left.homOfLE hle'
      haveI := hmonoι V'.left O₂'
      rw [← cancel_mono O₂'.ι]
      simp only [Category.assoc, Scheme.Hom.resLE_comp_ι, Scheme.homOfLE_ι_assoc, Scheme.homOfLE_ι]
    have hMVnat : ∀ t : ℕ,
        (wcMVClass S V (hK1 V.left fV t) (hK2 V.left fV t) (hK3 V.left fV t) (hK4 V.left fV t)).comp
            (Abelian.Ext.mk₀ (wcFreeSheafMap S (wcVResMap S g _ _ (hpres (t + 1) (t + 1)))))
            (add_zero 1) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap S (wcVResMap S g _ _ (hpres (t + 1 + 1) (t + 1 + 1))))).comp
            (wcMVClass S V' (hK1 V'.left fV' t) (hK2 V'.left fV' t) (hK3 V'.left fV' t)
              (hK4 V'.left fV' t)) (zero_add 1) := by
      intro t
      have hS := wc_lpgfg_open_mv_ses S V (hK1 V.left fV t) (hK2 V.left fV t) (hK3 V.left fV t)
        (hK4 V.left fV t) (hlat V.left fV t).1 (hlat V.left fV t).2
      have hS' := wc_lpgfg_open_mv_ses S V' (hK1 V'.left fV' t) (hK2 V'.left fV' t)
        (hK3 V'.left fV' t) (hK4 V'.left fV' t) (hlat V'.left fV' t).1 (hlat V'.left fV' t).2
      have e1 : wcMVClass S V (hK1 V.left fV t) (hK2 V.left fV t) (hK3 V.left fV t)
          (hK4 V.left fV t) = hS.extClass := by
        unfold wcMVClass
        exact dif_pos hS
      have e2 : wcMVClass S V' (hK1 V'.left fV' t) (hK2 V'.left fV' t) (hK3 V'.left fV' t)
          (hK4 V'.left fV' t) = hS'.extClass := by
        unfold wcMVClass
        exact dif_pos hS'
      rw [e1, e2]
      exact hS.extClass_naturality hS'
        { τ₁ := wcFreeSheafMap S (wcVResMap S g _ _ (hpres (t + 1) (t + 1)))
          τ₂ := Limits.biprod.map (wcFreeSheafMap S (wcVResMap S g _ _ (hpres (t + 1 + 1) (t + 1))))
            (wcFreeSheafMap S (wcVResMap S g _ _ (hpres (t + 1) (t + 1 + 1))))
          τ₃ := wcFreeSheafMap S (wcVResMap S g _ _ (hpres (t + 1 + 1) (t + 1 + 1)))
          comm₁₂ := by
            dsimp only [wcMVComplex]
            apply Limits.biprod.hom_ext
            · simp only [Category.assoc, Limits.biprod.lift_fst, Limits.biprod.map_fst,
                Limits.biprod.lift_fst_assoc, hF]
              rw [hcompat _ _ _ _ (hK1 V.left fV t) (hK1 V'.left fV' t) (hpres (t + 1) (t + 1))
                (hpres (t + 1 + 1) (t + 1))]
            · simp only [Category.assoc, Limits.biprod.lift_snd, Limits.biprod.map_snd,
                Limits.biprod.lift_snd_assoc, Preadditive.comp_neg, Preadditive.neg_comp, hF]
              rw [hcompat _ _ _ _ (hK2 V.left fV t) (hK2 V'.left fV' t) (hpres (t + 1) (t + 1))
                (hpres (t + 1) (t + 1 + 1))]
          comm₂₃ := by
            dsimp only [wcMVComplex]
            apply Limits.biprod.hom_ext'
            · simp only [Limits.biprod.inl_map_assoc, Limits.biprod.inl_desc,
                Limits.biprod.inl_desc_assoc, hF]
              rw [hcompat _ _ _ _ (hK3 V.left fV t) (hK3 V'.left fV' t) (hpres (t + 1 + 1) (t + 1))
                (hpres (t + 1 + 1) (t + 1 + 1))]
            · simp only [Limits.biprod.inr_map_assoc, Limits.biprod.inr_desc,
                Limits.biprod.inr_desc_assoc, hF]
              rw [hcompat _ _ _ _ (hK4 V.left fV t) (hK4 V'.left fV' t) (hpres (t + 1) (t + 1 + 1))
                (hpres (t + 1 + 1) (t + 1 + 1))] }
    have hchain : ∀ (q t : ℕ)
        (x : Abelian.Ext (wcFreeSheaf S (wcVRes S V' (wcKOpen V'.left fV' 1 1))) M q),
        (Abelian.Ext.mk₀ (wcFreeSheafMap S (wcVResMap S g _ _ (hpres (t + 1) (t + 1))))).comp
            (wcKChain S V' fV' M q t x) (zero_add _) =
          wcKChain S V fV M q t
            ((Abelian.Ext.mk₀ (wcFreeSheafMap S (wcVResMap S g _ _ (hpres 1 1)))).comp x
              (zero_add _)) := by
      intro q t
      induction t with
      | zero => intro x; rfl
      | succ t ih =>
        intro x
        simp only [wcKChain, AddMonoidHom.comp_apply, Abelian.Ext.precomp,
          Abelian.Ext.bilinearComp_apply_apply]
        rw [← ih x, ← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) _ (by omega), ← hMVnat t,
          Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add _) (by omega)]
    have hut : wcFreeSheafMap S (wcVResMap S g _ _ (hpres 1 1)) ≫
        wcUnitTupleMap S (wcVRes S V' (wcKOpen V'.left fV' 1 1)) ℓ d tD' hℓD' =
        wcUnitTupleMap S (wcVRes S V (wcKOpen V.left fV 1 1)) ℓ d tD hℓD := by
      have hy := yonedaEquiv_symm_naturality_left (wcVResMap S g _ _ (hpres 1 1))
        ((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ d)
        (Subtype.mk tD' hℓD' : {t : Fin d → (Γ((wcVRes S V' (wcKOpen V'.left fV' 1 1)).left, ⊤))ˣ //
            IsUnit ((ℓ : ℕ) : Γ((wcVRes S V' (wcKOpen V'.left fV' 1 1)).left, ⊤))})
      have hx : (ConcreteCategory.hom (((Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙
          Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ d).map (wcVResMap S g _ _ (hpres 1 1)).op))
            (Subtype.mk tD' hℓD' : {t : Fin d →
              (Γ((wcVRes S V' (wcKOpen V'.left fV' 1 1)).left, ⊤))ˣ //
              IsUnit ((ℓ : ℕ) : Γ((wcVRes S V' (wcKOpen V'.left fV' 1 1)).left, ⊤))}) =
          (Subtype.mk tD hℓD : {t : Fin d → (Γ((wcVRes S V (wcKOpen V.left fV 1 1)).left, ⊤))ˣ //
              IsUnit ((ℓ : ℕ) : Γ((wcVRes S V (wcKOpen V.left fV 1 1)).left, ⊤))}) := by
        apply Subtype.ext
        funext i
        apply Units.ext
        have hbi : (wcVResMap S g _ _ (hpres 1 1)).left.appTop.hom
            ((wcKOpen V'.left fV' 1 1).ι.appTop.hom (fV' i)) =
            (wcKOpen V.left fV 1 1).ι.appTop.hom (fV i) := by
          have e1 := congrArg (fun q => q.appTop.hom (fV' i))
            (Scheme.Hom.resLE_comp_ι g.left (hpres 1 1))
          simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e1
          rw [hf i] at e1
          exact e1
        rw [← htD' i, ← htD i] at hbi
        exact hbi
      rw [hx] at hy
      have e' : Functor.whiskerRight (yoneda.map (wcVResMap S g _ _ (hpres 1 1)))
            (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          Functor.whiskerRight
            ((yonedaEquiv (X := wcVRes S V' (wcKOpen V'.left fV' 1 1))
              (F := (Scheme.ProEt.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ ⋙
                wcUnitTupleFun.{u} ℓ d)).symm
              (Subtype.mk tD' hℓD' : {t : Fin d →
                (Γ((wcVRes S V' (wcKOpen V'.left fV' 1 1)).left, ⊤))ˣ //
                IsUnit ((ℓ : ℕ) : Γ((wcVRes S V' (wcKOpen V'.left fV' 1 1)).left, ⊤))}))
