      let β := hP.amalgamate b hb
      have hα : ∀ ⦃Z⦄ (f : Z ⟶ V) (hf : S.arrows f), P.map f.op α = a f hf :=
        fun Z f hf => hP.valid_glue ha f hf
      have hβ : ∀ ⦃Z⦄ (f : Z ⟶ V) (hf : S.arrows f), P.map f.op β = b f hf :=
        fun Z f hf => hP.valid_glue hb f hf
      have hαβ : (α * β : R.obj (Opposite.op V)) = 1 := by
        apply hP.isSeparatedFor.ext
        intro Z f hf
        change (R.map f.op).hom (α * β) = (R.map f.op).hom 1
        rw [map_mul, map_one]
        change P.map f.op α * P.map f.op β = 1
        rw [hα f hf, hβ f hf]
        exact Units.mul_inv _
      have hβα : (β * α : R.obj (Opposite.op V)) = 1 := by
        apply hP.isSeparatedFor.ext
        intro Z f hf
        change (R.map f.op).hom (β * α) = (R.map f.op).hom 1
        rw [map_mul, map_one]
        change P.map f.op β * P.map f.op α = 1
        rw [hα f hf, hβ f hf]
        exact Units.inv_mul _
      let υ : (R.obj (Opposite.op V))ˣ := ⟨α, β, hαβ, hβα⟩
      let t : Q.obj (Opposite.op V) := ULift.up (Additive.ofMul υ)
      refine ⟨t, ?_, ?_⟩
      · intro Z f hf
        apply hext
        rw [hmap]
        exact hα f hf
      · intro y hy
        apply hext
        refine hP.isSeparatedFor a (val _ y) α (fun Z f hf => ?_) hα
        rw [← hmap, hy f hf]
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)
      (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    exact s4 (Scheme.smallEtaleTopology Y) ((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ)
      (s3 (Scheme.Γ ⋙ forget CommRingCat.{u})
        (Presieve.isSheaf_of_le _ s2a s2b))
  have hsh : Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y wcKtGm.{u}) := by
    first
      | exact hGm
