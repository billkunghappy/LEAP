          (U.ι ≫ f).appTop := Scheme.Hom.appLE_eq_app _
      rw [← h2, ← Scheme.Hom.appLE_comp_appLE U.ι f ⊤ U ⊤ e e₂, Scheme.Opens.ι_appLE]
