  have hT2 : wcKaT2Pre Y ℓ n D k s a hℓ = NatTrans.mk (wcKaT2App Y ℓ n D k s a hℓ) hnat := by
    unfold wcKaT2Pre wcNatOf
    exact dif_pos hnat

  have hGnat : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcKaBPre Y ℓ n k a).map f ≫ wcKaGApp Y ℓ n k a W' =
        wcKaGApp Y ℓ n k a W ≫ (wcLpttEtPre Y (wcKtT.{u} (ℓ ^ n) k)).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    refine tens_ind _ _ (fun e τ => ?_)
    exact congrArg ULift.up (map_zsmul ((wcKtT.{u} (ℓ ^ n) k).map
      (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))).hom
      ((e : ↥(wcKaSub (Scheme.Γ.obj (Opposite.op W.unop.left)) (ℓ ^ n) (wcKaUnit Y a W))).1.1)
      τ).symm
  have hG : wcKaGPre Y ℓ n k a = NatTrans.mk (wcKaGApp Y ℓ n k a) hGnat := by
    unfold wcKaGPre wcNatOf
    exact dif_pos hGnat
  have hgen3 : ∀ {α β : Type u} (A B : AddCommGrpCat.{u}) (g : α → β) (h : A ⟶ B) (s : α) (s' : β),
      g s = s' → ∀ τ : A,
      (FreeAbelianGroup.of s' ⊗ₜ[ℤ] h.hom τ : TensorProduct ℤ (FreeAbelianGroup β) B) =
        (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap h.hom.toIntLinearMap).toAddMonoidHom
          (FreeAbelianGroup.of s ⊗ₜ[ℤ] τ) := by
    intro α β A B g h s s' hs τ
    subst hs
    rw [LinearMap.toAddMonoidHom_coe, TensorProduct.map_tmul, AddMonoidHom.coe_toIntLinearMap,
      AddMonoidHom.coe_toIntLinearMap, FreeAbelianGroup.map_of_apply]

  rw [hT2, hG]
  unfold wcLpttUSec wcLpttEtShMap
  refine ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans ?_
  refine Eq.trans ?_ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _)
  congr 1
  have htm : ∀ {A A' B B' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : A ⟶ A') (β : B ⟶ B')
      (R₁ : CommRingCat.{u}) (x : A.obj R₁) (y : B.obj R₁),
      ((wcTensNat α β).app R₁).hom (x ⊗ₜ[ℤ] y) = (α.app R₁).hom x ⊗ₜ[ℤ] (β.app R₁).hom y := by
    intro A A' B B' α β R₁ x y
    have hnat2 : ∀ ⦃X Y : CommRingCat.{u}⦄ (f : X ⟶ Y),
        (wcTensFun A B).map f ≫ (fun R => AddCommGrpCat.ofHom
          (TensorProduct.map (α.app R).hom.toIntLinearMap (β.app R).hom.toIntLinearMap).toAddMonoidHom) Y =
        (fun R => AddCommGrpCat.ofHom
          (TensorProduct.map (α.app R).hom.toIntLinearMap (β.app R).hom.toIntLinearMap).toAddMonoidHom) X ≫
          (wcTensFun A' B').map f := by
      intro X Y f
      apply AddCommGrpCat.hom_ext
      show ((TensorProduct.map (α.app Y).hom.toIntLinearMap (β.app Y).hom.toIntLinearMap) ∘ₗ
          (TensorProduct.map (A.map f).hom.toIntLinearMap (B.map f).hom.toIntLinearMap)).toAddMonoidHom =
        ((TensorProduct.map (A'.map f).hom.toIntLinearMap (B'.map f).hom.toIntLinearMap) ∘ₗ
          (TensorProduct.map (α.app X).hom.toIntLinearMap (β.app X).hom.toIntLinearMap)).toAddMonoidHom
      congr 1
      apply TensorProduct.ext'
      intro x y
      simp only [LinearMap.comp_apply, TensorProduct.map_tmul, AddMonoidHom.coe_toIntLinearMap]
      have ha := congrArg (fun g => AddCommGrpCat.Hom.hom g x) (α.naturality f)
      have hb := congrArg (fun g => AddCommGrpCat.Hom.hom g y) (β.naturality f)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at ha hb
      rw [ha, hb]
    unfold wcTensNat wcNatOf
    split_ifs with H
    · show (TensorProduct.map (α.app R₁).hom.toIntLinearMap (β.app R₁).hom.toIntLinearMap)
        (x ⊗ₜ[ℤ] y) = _
      exact TensorProduct.map_tmul _ _ _ _
    · exact absurd hnat2 H
  apply NatTrans.ext
  funext W
  unfold wcNatOf
  split_ifs with H
  · apply AddCommGrpCat.hom_ext
    refine tens_ind _ _ (fun e τ => ?_)
    have h1 := htm (Limits.pullback.fst (wcKtPsi.{u} ℓ D k)
        ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ D) wcKtGm.{u})))
      (𝟙 (wcKtT.{u} (ℓ ^ n) k)) (Scheme.Γ.obj (Opposite.op W.unop.left))
      ((wcKaEs Y ℓ n D k s a hℓ W).hom e) τ
    have h2 := hfst W e
    have h3 : ((𝟙 (wcKtT.{u} (ℓ ^ n) k)).app (Scheme.Γ.obj (Opposite.op W.unop.left))).hom τ = τ := rfl
    exact congrArg ULift.up ((h1.trans (congrArg₂ (fun x y => x ⊗ₜ[ℤ] y) h2 h3)).trans
      (TensorProduct.smul_tmul _ _ _))
  · exfalso
    apply H
    intro W₁ W₂ f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    have hsr : ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ D).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
        (⟨fun i => Units.map W₁.unop.hom.appTop.hom.toMonoidHom (s i),
          by
            have h := hℓ.map W₁.unop.hom.appTop.hom
            rw [map_natCast] at h
            exact h⟩ : (wcUnitTupleFun.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W₁.unop.left))) =
        (⟨fun i => Units.map W₂.unop.hom.appTop.hom.toMonoidHom (s i),
          by
            have h := hℓ.map W₂.unop.hom.appTop.hom
            rw [map_natCast] at h
            exact h⟩ : (wcUnitTupleFun.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W₂.unop.left))) := by
      apply Subtype.ext
      funext i
      apply Units.ext
      have hw : f.unop.left ≫ W₁.unop.hom = W₂.unop.hom := MorphismProperty.Over.w f.unop
      have h1 := congrArg (fun q => q.appTop.hom (s i : Γ(Y, ⊤))) hw
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
      exact h1
    exact congrArg ULift.up (hgen3 ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W₁.unop.left)))
      ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W₂.unop.left)))
      (ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ D).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))))
      ((wcKtT.{u} (ℓ ^ n) k).map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
      _ _ hsr (ULift.down x))

theorem wc_lptt_ka_rho (Y : Scheme.{u}) (ℓ n d k : ℕ) (t : Fin d → (Γ(Y, ⊤))ˣ)
    (u : Fin (k + 1) → (Γ(Y, ⊤))ˣ) (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n d k t hℓ) ≫ wcLpttEtShMap Y (wcKtRho.{u} ℓ n d k) =
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n (k + 1) k u hℓ) ≫ wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫
      wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1)) ≫ wcLpttUSec Y ℓ n d (k + 1) t hℓ :=
by
  classical

  have hρnat : ∀ (U U' A B : Type u) [AddCommGroup U] [AddCommGroup U'] [AddCommGroup A]
      [AddCommGroup B] (f : U →ₗ[ℤ] U') (g : A →ₗ[ℤ] B),
      wcKtRhoLin (ℓ ^ n) k U' B ∘ₗ TensorProduct.map (TensorProduct.map f g)
        (LinearMap.lTensor (ZMod (ℓ ^ n)) (PiTensorProduct.map (fun _ : Fin k => g))) =
      TensorProduct.map f
          (LinearMap.lTensor (ZMod (ℓ ^ n)) (PiTensorProduct.map (fun _ : Fin (k + 1) => g)))
        ∘ₗ wcKtRhoLin (ℓ ^ n) k U A := by
    intro U U' A B _ _ _ _ f g
    have hsn : ∀ (v : Fin k → A) (b : A),
        (fun i : Fin (k + 1) => g (Fin.snoc (α := fun _ => A) v b i)) =
          Fin.snoc (α := fun _ => B) (fun i => g (v i)) (g b) := by
      intro v b
      funext i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · simp only [Fin.snoc_last]
      · simp only [Fin.snoc_castSucc]
    ext a b c v
    show (f a ⊗ₜ[ℤ] (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
        (Fin.snoc (α := fun _ => B) (fun i => g (v i)) (g b))) :
        TensorProduct ℤ U' (TensorProduct ℤ (ZMod (ℓ ^ n))
          (PiTensorProduct ℤ (fun _ : Fin (k + 1) => B)))) =
      f a ⊗ₜ[ℤ] (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i => g (Fin.snoc (α := fun _ => A) v b i)))
    rw [hsn]

  have hgen1 : ∀ {α β : Type u} (A B : AddCommGrpCat.{u}) (g : α → β) (h : A ⟶ B),
      AddCommGrpCat.ofHom (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap
          h.hom.toIntLinearMap).toAddMonoidHom ≫
        AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift
          (fun _ => (LinearMap.id : B →ₗ[ℤ] B))).toIntLinearMap).toAddMonoidHom =
      AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift
          (fun _ => (LinearMap.id : A →ₗ[ℤ] A))).toIntLinearMap).toAddMonoidHom ≫ h := by
    intro α β A B g h
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.comp_apply,
      LinearMap.toAddMonoidHom_coe]
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul z τ =>
      rw [TensorProduct.map_tmul, TensorProduct.lift.tmul, TensorProduct.lift.tmul,
        AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.coe_toIntLinearMap,
        AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.coe_toIntLinearMap]
      induction z using FreeAbelianGroup.induction_on with
      | zero => simp only [map_zero, LinearMap.zero_apply]
      | of x =>
        rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of]
        rfl
      | neg x hx => simp only [map_neg, LinearMap.neg_apply, hx]
      | add x y hx hy =>
        simp only [map_add, LinearMap.add_apply, hx, hy]
  have hgen3 : ∀ {α β : Type u} (A B : AddCommGrpCat.{u}) (g : α → β) (h : A ⟶ B) (s : α) (s' : β),
      g s = s' → ∀ τ : A,
      (FreeAbelianGroup.of s' ⊗ₜ[ℤ] h.hom τ : TensorProduct ℤ (FreeAbelianGroup β) B) =
        (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap h.hom.toIntLinearMap).toAddMonoidHom
          (FreeAbelianGroup.of s ⊗ₜ[ℤ] τ) := by
    intro α β A B g h s s' hs τ
    subst hs
    rw [LinearMap.toAddMonoidHom_coe, TensorProduct.map_tmul, AddMonoidHom.coe_toIntLinearMap,
      AddMonoidHom.coe_toIntLinearMap, FreeAbelianGroup.map_of_apply]
  have hgenT1 : ∀ {α β : Type u} (M M' T T' : AddCommGrpCat.{u}) (g : α → β) (hM : M ⟶ M')
      (hT : T ⟶ T') (s : α) (s' : β), g s = s' → ∀ y : TensorProduct ℤ M T,
      LinearMap.rTensor T' (TensorProduct.mk ℤ (FreeAbelianGroup β) M' (FreeAbelianGroup.of s'))
          (TensorProduct.map hM.hom.toIntLinearMap hT.hom.toIntLinearMap y) =
        TensorProduct.map (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap
            hM.hom.toIntLinearMap) hT.hom.toIntLinearMap
          (LinearMap.rTensor T (TensorProduct.mk ℤ (FreeAbelianGroup α) M
            (FreeAbelianGroup.of s)) y) := by
    intro α β M M' T T' g hM hT s s' hs y
    subst hs
    have key : (LinearMap.rTensor T' (TensorProduct.mk ℤ (FreeAbelianGroup β) M'
          (FreeAbelianGroup.of (g s)))) ∘ₗ
        (TensorProduct.map hM.hom.toIntLinearMap hT.hom.toIntLinearMap) =
        (TensorProduct.map (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap
            hM.hom.toIntLinearMap) hT.hom.toIntLinearMap) ∘ₗ
          (LinearMap.rTensor T (TensorProduct.mk ℤ (FreeAbelianGroup α) M
            (FreeAbelianGroup.of s))) := by
      ext a b
      show ((FreeAbelianGroup.of (g s) ⊗ₜ[ℤ] hM.hom a) ⊗ₜ[ℤ] hT.hom b :
          TensorProduct ℤ (TensorProduct ℤ (FreeAbelianGroup β) M') T') =
        (FreeAbelianGroup.map g (FreeAbelianGroup.of s) ⊗ₜ[ℤ] hM.hom a) ⊗ₜ[ℤ] hT.hom b
      rw [FreeAbelianGroup.map_of_apply]
    exact LinearMap.congr_fun key y
  have hEPS : ∀ {β : Type u} (X : Type u) [AddCommGroup X] (s' : β) (y : X),
      TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id : X →ₗ[ℤ] X))).toIntLinearMap
        (FreeAbelianGroup.of s' ⊗ₜ[ℤ] y) = y := by
    intro β X _ s' y
    rw [TensorProduct.lift.tmul, AddMonoidHom.coe_toIntLinearMap, FreeAbelianGroup.lift_apply_of]
    rfl
  have hgenM : ∀ {α β : Type u} (A : Type u) [AddCommGroup A] (s : α) (s' : β) (ζ : A)
      (τ : TensorProduct ℤ (ZMod (ℓ ^ n)) (PiTensorProduct ℤ (fun _ : Fin k => A))),
      wcKtRhoLin (ℓ ^ n) k (FreeAbelianGroup α) A ((FreeAbelianGroup.of s ⊗ₜ[ℤ] ζ) ⊗ₜ[ℤ] τ) =
        FreeAbelianGroup.of s ⊗ₜ[ℤ]
          (TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
            TensorProduct ℤ (ZMod (ℓ ^ n)) (PiTensorProduct ℤ (fun _ : Fin (k + 1) => A)) →ₗ[ℤ]
              TensorProduct ℤ (ZMod (ℓ ^ n)) (PiTensorProduct ℤ (fun _ : Fin (k + 1) => A))))).toIntLinearMap
            (wcKtRhoLin (ℓ ^ n) k (FreeAbelianGroup β) A
              ((FreeAbelianGroup.of s' ⊗ₜ[ℤ] ζ) ⊗ₜ[ℤ] τ))) := by
    intro α β A _ s s' ζ τ
    exact congrArg (TensorProduct.tmul ℤ (FreeAbelianGroup.of s))
      (hEPS (TensorProduct ℤ (ZMod (ℓ ^ n)) (PiTensorProduct ℤ (fun _ : Fin (k + 1) => A))) s'
        ((TensorProduct.lift ((LinearMap.lTensorHom (ZMod (ℓ ^ n))) ∘ₗ
          (PiTensorProduct.lift (PiTensorProduct.tprod ℤ (s := fun _ : Fin (k + 1) => A)).curryRight).flip) :
          TensorProduct ℤ A (TensorProduct ℤ (ZMod (ℓ ^ n)) (PiTensorProduct ℤ (fun _ : Fin k => A))) →ₗ[ℤ]
            TensorProduct ℤ (ZMod (ℓ ^ n)) (PiTensorProduct ℤ (fun _ : Fin (k + 1) => A)))
          (ζ ⊗ₜ[ℤ] τ))).symm

  have hnatρ : ∀ D : ℕ, ∀ ⦃R S : CommRingCat.{u}⦄ (φ : R ⟶ S),
      (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ D) (wcRootsFun.{u} (ℓ ^ n))) (wcKtT.{u} (ℓ ^ n) k)).map φ ≫
        AddCommGrpCat.ofHom (wcKtRhoLin (ℓ ^ n) k ((wcKtZUT.{u} ℓ D).obj S)
          ((wcRootsFun.{u} (ℓ ^ n)).obj S)).toAddMonoidHom =
      AddCommGrpCat.ofHom (wcKtRhoLin (ℓ ^ n) k ((wcKtZUT.{u} ℓ D).obj R)
          ((wcRootsFun.{u} (ℓ ^ n)).obj R)).toAddMonoidHom ≫
        (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) (k + 1))).map φ := by
    intro D R S φ
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    exact LinearMap.congr_fun (hρnat _ _ _ _ ((wcKtZUT.{u} ℓ D).map φ).hom.toIntLinearMap
      ((wcRootsFun.{u} (ℓ ^ n)).map φ).hom.toIntLinearMap) x
  have hρ : ∀ D : ℕ, wcKtRho.{u} ℓ n D k = NatTrans.mk (fun R => AddCommGrpCat.ofHom
      (wcKtRhoLin (ℓ ^ n) k ((wcKtZUT.{u} ℓ D).obj R)
        ((wcRootsFun.{u} (ℓ ^ n)).obj R)).toAddMonoidHom) (hnatρ D) := by
    intro D
    unfold wcKtRho wcNatOf
    exact dif_pos (hnatρ D)
  have hnatε : ∀ ⦃R S : CommRingCat.{u}⦄ (φ : R ⟶ S),
      (wcTensFun (wcKtZUT.{u} ℓ (k + 1)) (wcKtT.{u} (ℓ ^ n) (k + 1))).map φ ≫
        AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
          (wcKtT.{u} (ℓ ^ n) (k + 1)).obj S →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) (k + 1)).obj S))).toIntLinearMap).toAddMonoidHom =
      AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
          (wcKtT.{u} (ℓ ^ n) (k + 1)).obj R →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) (k + 1)).obj R))).toIntLinearMap).toAddMonoidHom ≫
        (wcKtT.{u} (ℓ ^ n) (k + 1)).map φ := by
    intro R S φ
    exact hgen1 ((wcKtT.{u} (ℓ ^ n) (k + 1)).obj R) ((wcKtT.{u} (ℓ ^ n) (k + 1)).obj S)
      (ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ (k + 1)).map φ)) ((wcKtT.{u} (ℓ ^ n) (k + 1)).map φ)
  have hε : wcKtEps.{u} ℓ n (k + 1) = NatTrans.mk (fun R => AddCommGrpCat.ofHom (TensorProduct.lift
      (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
        (wcKtT.{u} (ℓ ^ n) (k + 1)).obj R →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) (k + 1)).obj R))).toIntLinearMap).toAddMonoidHom)
      hnatε := by
    unfold wcKtEps wcNatOf
    exact dif_pos hnatε
  have hnatT1 : ∀ (D : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ) ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcLpttEtPre Y (wcTensFun (wcRootsFun.{u} (ℓ ^ n)) (wcKtT.{u} (ℓ ^ n) k))).map f ≫
        wcKaT1App Y ℓ n D k s hℓ W' =
      wcKaT1App Y ℓ n D k s hℓ W ≫
        (wcLpttEtPre Y (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ D) (wcRootsFun.{u} (ℓ ^ n)))
          (wcKtT.{u} (ℓ ^ n) k))).map f := by
    intro D s W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    have hs : ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ D).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
        (wcKaTup Y ℓ D s hℓ W) = wcKaTup Y ℓ D s hℓ W' := by
      apply Subtype.ext
      funext i
      apply Units.ext
      have hw : f.unop.left ≫ W.unop.hom = W'.unop.hom := MorphismProperty.Over.w f.unop
      have h1 := congrArg (fun q => q.appTop.hom (s i : Γ(Y, ⊤))) hw
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
      exact h1
    exact congrArg ULift.up (hgenT1
      ((wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
      ((wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))
      ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
      ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))
      (ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ D).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))))
      ((wcRootsFun.{u} (ℓ ^ n)).map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
      ((wcKtT.{u} (ℓ ^ n) k).map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
      _ _ hs (ULift.down x))
  have hT1 : ∀ (D : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ),
      wcKaT1Pre Y ℓ n D k s hℓ = NatTrans.mk (wcKaT1App Y ℓ n D k s hℓ) (hnatT1 D s) := by
    intro D s
    unfold wcKaT1Pre wcNatOf
    exact dif_pos (hnatT1 D s)

  unfold wcLpttUSec wcLpttEtShMap
  refine ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
    (Eq.trans ?_ (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).trans
      (congrArg (fun z => (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map _ ≫ z)
        (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).trans
          (congrArg (fun z => (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map _ ≫ z)
            ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _))))))
  congr 1
  rw [hT1 d t, hT1 (k + 1) u, hρ d, hρ (k + 1), hε]
  unfold wcNatOf
  rw [dif_pos]
  swap
  · intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    have hs : ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ d).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
        (⟨fun i => Units.map W.unop.hom.appTop.hom.toMonoidHom (t i),
          by
            have h := hℓ.map W.unop.hom.appTop.hom
            rw [map_natCast] at h
            exact h⟩ : (wcUnitTupleFun.{u} ℓ d).obj (Scheme.Γ.obj (Opposite.op W.unop.left))) =
        (⟨fun i => Units.map W'.unop.hom.appTop.hom.toMonoidHom (t i),
          by
            have h := hℓ.map W'.unop.hom.appTop.hom
            rw [map_natCast] at h
            exact h⟩ : (wcUnitTupleFun.{u} ℓ d).obj (Scheme.Γ.obj (Opposite.op W'.unop.left))) := by
      apply Subtype.ext
      funext i
      apply Units.ext
      have hw : f.unop.left ≫ W.unop.hom = W'.unop.hom := MorphismProperty.Over.w f.unop
      have h1 := congrArg (fun q => q.appTop.hom (t i : Γ(Y, ⊤))) hw
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
      exact h1
    exact congrArg ULift.up (hgen3
      ((wcKtT.{u} (ℓ ^ n) (k + 1)).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
      ((wcKtT.{u} (ℓ ^ n) (k + 1)).obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))
      (ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ d).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))))
      ((wcKtT.{u} (ℓ ^ n) (k + 1)).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
      _ _ hs (ULift.down x))

  · apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    obtain ⟨y⟩ := x
    induction y using TensorProduct.induction_on with
    | zero => exact (map_zero _).trans (map_zero _).symm
    | add a b ha hb =>
      exact (map_add _ (ULift.up a) (ULift.up b)).trans
        ((congrArg₂ (· + ·) ha hb).trans (map_add _ _ _).symm)
    | tmul ζ τ =>
      exact congrArg ULift.up (hgenM _ (wcKaTup Y ℓ d t hℓ W) (wcKaTup Y ℓ (k + 1) u hℓ W) ζ τ)

theorem wc_lptt_step_nat (Y : Scheme.{u}) (ℓ n d k : ℕ) (t : Fin d → (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (hk : k < d)
    (hSd : ∃ w, (ShortComplex.mk
      (wcLpttEtShMap Y (wcTensNat (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
      (wcLpttEtShMap Y (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
        (𝟙 (wcKtT.{u} (ℓ ^ n) k)))) w).ShortExact)
    (hSk : ∃ w, (ShortComplex.mk
      (wcLpttEtShMap Y (wcTensNat (wcKtIotaE.{u} ℓ n (k + 1) k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
      (wcLpttEtShMap Y (wcTensNat
        (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n (k + 1) k ⟶ wcKtZUT.{u} ℓ (k + 1))
        (𝟙 (wcKtT.{u} (ℓ ^ n) k)))) w).ShortExact) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n d k t hℓ)).comp (wcLpttEtStep Y ℓ n d k) (zero_add 1) =
      (wcLpttKt Y ℓ n k (t ⟨k, hk⟩) hℓ).comp
        (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n d (k + 1) t hℓ)) (add_zero 1) :=
by
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨wd, hSd'⟩ := hSd
  obtain ⟨wk, hSk'⟩ := hSk
  obtain ⟨wa, hK⟩ := wc_lptt_ka_ses Y ℓ n k (t ⟨k, hk⟩) hℓ

  have hext : ∀ (D : ℕ)
      (w : wcLpttEtShMap Y (wcTensNat (wcKtIotaE.{u} ℓ n D k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))) ≫
        wcLpttEtShMap Y (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n D k ⟶ wcKtZUT.{u} ℓ D)
          (𝟙 (wcKtT.{u} (ℓ ^ n) k))) = 0)
      (hS : (ShortComplex.mk
        (wcLpttEtShMap Y (wcTensNat (wcKtIotaE.{u} ℓ n D k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
        (wcLpttEtShMap Y (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n D k ⟶ wcKtZUT.{u} ℓ D)
          (𝟙 (wcKtT.{u} (ℓ ^ n) k)))) w).ShortExact),
      wcLpttEtStep Y ℓ n D k =
        hS.extClass.comp (Abelian.Ext.mk₀ (wcLpttEtShMap Y (wcKtRho.{u} ℓ n D k))) (add_zero 1) := by
    intro D w hS
    unfold wcLpttEtStep wcExtOfMaps
    rw [dif_pos w, dif_pos hS]

  have hN : ∀ (D : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ) (hkD : k < D) (hs : s ⟨k, hkD⟩ = t ⟨k, hk⟩)
      (w : wcLpttEtShMap Y (wcTensNat (wcKtIotaE.{u} ℓ n D k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))) ≫
        wcLpttEtShMap Y (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n D k ⟶ wcKtZUT.{u} ℓ D)
          (𝟙 (wcKtT.{u} (ℓ ^ n) k))) = 0)
      (hS : (ShortComplex.mk
        (wcLpttEtShMap Y (wcTensNat (wcKtIotaE.{u} ℓ n D k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
        (wcLpttEtShMap Y (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n D k ⟶ wcKtZUT.{u} ℓ D)
          (𝟙 (wcKtT.{u} (ℓ ^ n) k)))) w).ShortExact),
      hK.extClass.comp (Abelian.Ext.mk₀ ((presheafToSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).map (wcKaT1Pre Y ℓ n D k s hℓ))) (add_zero 1) =
        (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n D k s hℓ)).comp hS.extClass (zero_add 1) := by
    intro D s hkD hs w hS
    have hnat := wc_lptt_ka_tau2_nat Y ℓ n D k s (t ⟨k, hk⟩) hℓ hkD hs
    exact hK.extClass_naturality hS (ShortComplex.Hom.mk
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n D k s hℓ))
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT2Pre Y ℓ n D k s (t ⟨k, hk⟩) hℓ))
      (wcLpttUSec Y ℓ n D k s hℓ)
      (wc_lptt_ka_sq1 Y ℓ n D k s (t ⟨k, hk⟩) hℓ hkD hs hnat)
      (wc_lptt_ka_sq2 Y ℓ n D k s (t ⟨k, hk⟩) hℓ hkD hs hnat))
  have hu : (fun i : Fin (k + 1) => if (i : ℕ) = k then t ⟨k, hk⟩ else 1) ⟨k, Nat.lt_succ_self k⟩ =
      t ⟨k, hk⟩ := by simp
  have Nt := hN d t hk rfl wd hSd'
  have Nu := hN (k + 1) (fun i : Fin (k + 1) => if (i : ℕ) = k then t ⟨k, hk⟩ else 1)
    (Nat.lt_succ_self k) hu wk hSk'
  have hrho := wc_lptt_ka_rho Y ℓ n d k t
    (fun i : Fin (k + 1) => if (i : ℕ) = k then t ⟨k, hk⟩ else 1) hℓ

  unfold wcLpttKt
  rw [hext d wd hSd', hext (k + 1) wk hSk']
  have A1 : ∀ {X₁ X₂ X₃ X₄ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (e : Abelian.Ext X₁ X₂ 1) (f : X₂ ⟶ X₃) (g : X₃ ⟶ X₄),
      (e.comp (Abelian.Ext.mk₀ f) (add_zero 1)).comp (Abelian.Ext.mk₀ g) (add_zero 1) =
        e.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero 1) := by
    intro X₁ X₂ X₃ X₄ e f g
    rw [Abelian.Ext.comp_assoc e _ _ (add_zero 1) (zero_add 0) (by omega : 1 + 0 + 0 = 1),
      Abelian.Ext.mk₀_comp_mk₀]
  have A2 : ∀ {X₀ X₁ X₂ X₃ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (v : X₀ ⟶ X₁) (e : Abelian.Ext X₁ X₂ 1) (f : X₂ ⟶ X₃),
      (Abelian.Ext.mk₀ v).comp (e.comp (Abelian.Ext.mk₀ f) (add_zero 1)) (zero_add 1) =
        ((Abelian.Ext.mk₀ v).comp e (zero_add 1)).comp (Abelian.Ext.mk₀ f) (add_zero 1) := by
    intro X₀ X₁ X₂ X₃ v e f
    exact (Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ v) e (Abelian.Ext.mk₀ f) (zero_add 1)
      (add_zero 1) (by omega : 0 + 1 + 0 = 1)).symm
  have L := (A2 (wcLpttUSec Y ℓ n d k t hℓ) hSd'.extClass
      (wcLpttEtShMap Y (wcKtRho.{u} ℓ n d k))).trans
    ((congrArg (fun z => z.comp (Abelian.Ext.mk₀ (wcLpttEtShMap Y (wcKtRho.{u} ℓ n d k)))
      (add_zero 1)) Nt.symm).trans (A1 _ _ _))
  have R1 := congrArg (fun z => ((Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n (k + 1) k
        (fun i : Fin (k + 1) => if (i : ℕ) = k then t ⟨k, hk⟩ else 1) hℓ)).comp z (zero_add 1)).comp
      (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n d (k + 1) t hℓ)) (add_zero 1))
    (A1 hSk'.extClass (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k))
      (wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1))))
  have R2 := congrArg (fun z => z.comp
      (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n d (k + 1) t hℓ)) (add_zero 1))
    (A2 (wcLpttUSec Y ℓ n (k + 1) k
        (fun i : Fin (k + 1) => if (i : ℕ) = k then t ⟨k, hk⟩ else 1) hℓ) hSk'.extClass
      (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1))))
  have R3 := congrArg (fun z => (z.comp (Abelian.Ext.mk₀
      (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1))))
      (add_zero 1)).comp (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n d (k + 1) t hℓ)) (add_zero 1)) Nu.symm
  have R4 := congrArg (fun z => z.comp
      (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n d (k + 1) t hℓ)) (add_zero 1)) (A1 hK.extClass
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then t ⟨k, hk⟩ else 1) hℓ))
      (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1))))
  have R5 := A1 hK.extClass
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then t ⟨k, hk⟩ else 1) hℓ) ≫
        wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1)))
      (wcLpttUSec Y ℓ n d (k + 1) t hℓ)
  have hrho' : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n d k t hℓ) ≫ wcLpttEtShMap Y (wcKtRho.{u} ℓ n d k) =
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcKaT1Pre Y ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then t ⟨k, hk⟩ else 1) hℓ) ≫
        wcLpttEtShMap Y (wcKtRho.{u} ℓ n (k + 1) k) ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n (k + 1))) ≫
        wcLpttUSec Y ℓ n d (k + 1) t hℓ :=
    hrho.trans ((congrArg (fun z => (presheafToSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).map (wcKaT1Pre Y ℓ n (k + 1) k
          (fun i : Fin (k + 1) => if (i : ℕ) = k then t ⟨k, hk⟩ else 1) hℓ) ≫ z)
      (Category.assoc _ _ _).symm).trans (Category.assoc _ _ _).symm)
  exact L.trans ((congrArg (fun φ => hK.extClass.comp (Abelian.Ext.mk₀ φ) (add_zero 1)) hrho').trans
    (R1.trans (R2.trans (R3.trans (R4.trans R5)))).symm)

theorem wc_lptt_base_eq (Y : Scheme.{u}) (ℓ n d : ℕ) (t : Fin d → (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    wcLpttEtUTMap Y ℓ d t hℓ ≫ wcLpttEtNuSh Y ℓ n d =
      wcLpttGen0 Y ℓ n hℓ ≫ wcLpttUSec Y ℓ n d 0 t hℓ :=
by
  classical

  have hgen1 : ∀ {α β : Type u} (A B : AddCommGrpCat.{u}) (g : α → β) (h : A ⟶ B),
      AddCommGrpCat.ofHom (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap
          h.hom.toIntLinearMap).toAddMonoidHom ≫
        AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift
          (fun _ => (LinearMap.id : B →ₗ[ℤ] B))).toIntLinearMap).toAddMonoidHom =
      AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift
          (fun _ => (LinearMap.id : A →ₗ[ℤ] A))).toIntLinearMap).toAddMonoidHom ≫ h := by
    intro α β A B g h
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.comp_apply,
      LinearMap.toAddMonoidHom_coe]
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul z τ =>
      rw [TensorProduct.map_tmul, TensorProduct.lift.tmul, TensorProduct.lift.tmul,
        AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.coe_toIntLinearMap,
        AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.coe_toIntLinearMap]
      induction z using FreeAbelianGroup.induction_on with
      | zero => simp only [map_zero, LinearMap.zero_apply]
      | of x =>
        rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of]
        rfl
      | neg x hx => simp only [map_neg, LinearMap.neg_apply, hx]
      | add x y hx hy =>
        simp only [map_add, LinearMap.add_apply, hx, hy]
  have hgen2 : ∀ {α : Type u} (A : AddCommGrpCat.{u}) (s : α) (y : A),
      (TensorProduct.lift (FreeAbelianGroup.lift
          (fun _ => (LinearMap.id : A →ₗ[ℤ] A))).toIntLinearMap).toAddMonoidHom
        (FreeAbelianGroup.of s ⊗ₜ[ℤ] y) = y := by
    intro α A s y
    rw [LinearMap.toAddMonoidHom_coe, TensorProduct.lift.tmul, AddMonoidHom.coe_toIntLinearMap,
      FreeAbelianGroup.lift_apply_of]
    rfl
  have hgen3 : ∀ {α β : Type u} (A B : AddCommGrpCat.{u}) (g : α → β) (h : A ⟶ B) (s : α) (s' : β),
      g s = s' → ∀ τ : A,
      (FreeAbelianGroup.of s' ⊗ₜ[ℤ] h.hom τ : TensorProduct ℤ (FreeAbelianGroup β) B) =
        (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap h.hom.toIntLinearMap).toAddMonoidHom
          (FreeAbelianGroup.of s ⊗ₜ[ℤ] τ) := by
    intro α β A B g h s s' hs τ
    subst hs
    rw [LinearMap.toAddMonoidHom_coe, TensorProduct.map_tmul, AddMonoidHom.coe_toIntLinearMap,
      AddMonoidHom.coe_toIntLinearMap, FreeAbelianGroup.map_of_apply]

  have key : ∀ (D : ℕ) (R R' : CommRingCat.{u}) (φ : R ⟶ R') (y : (wcUnitTupleFun.{u} ℓ D).obj R),
      ((wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) 0)).map φ).hom
        (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ D).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
          (FreeAbelianGroup.of y)
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) =
      TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ D).obj R') (N := (wcKtT.{u} (ℓ ^ n) 0).obj R')
          (FreeAbelianGroup.of ((wcUnitTupleFun.{u} ℓ D).map φ y))
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0)) := by
    intro D R R' φ y
    have h0 : ∀ (A : Type u) [AddCommGroup A] (g : Fin 0 → A),
        (PiTensorProduct.tprod ℤ g : PiTensorProduct ℤ (fun _ : Fin 0 => A)) =
          PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0) :=
      fun A _ g => congrArg _ (funext fun i => i.elim0)
    show TensorProduct.map ((wcKtZUT.{u} ℓ D).map φ).hom.toIntLinearMap
        ((wcKtT.{u} (ℓ ^ n) 0).map φ).hom.toIntLinearMap
        (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ D).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
          (FreeAbelianGroup.of y)
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) = _
    refine (TensorProduct.map_tmul (R := ℤ) _ _ _ _).trans ?_
    congr 1
    all_goals first
      | exact FreeAbelianGroup.map_of_apply y
      | exact FreeAbelianGroup.map_of_apply _
      | (refine (LinearMap.lTensor_tmul _ _ _ _).trans ?_
         exact congrArg _ ((PiTensorProduct.map_tprod _ _).trans (h0 _ _)))
  have key2 : ∀ (D : ℕ) (R R' : CommRingCat.{u}) (φ : R ⟶ R'),
      (wcUnitTupleFun.{u} ℓ D ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map φ ≫
        (AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun x : ULift.{u+1} ((wcUnitTupleFun.{u} ℓ D).obj R') =>
            (ULift.up (TensorProduct.tmul ℤ
              (M := (wcKtZUT.{u} ℓ D).obj R') (N := (wcKtT.{u} (ℓ ^ n) 0).obj R')
              (FreeAbelianGroup.of x.down)
              ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
              ULift.{u+1} _))) :
          (wcUnitTupleFun.{u} ℓ D ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj R' ⟶
            (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) 0) ⋙
              AddCommGrpCat.uliftFunctor.{u+1, u}).obj R') =
      (AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun x : ULift.{u+1} ((wcUnitTupleFun.{u} ℓ D).obj R) =>
            (ULift.up (TensorProduct.tmul ℤ
              (M := (wcKtZUT.{u} ℓ D).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
              (FreeAbelianGroup.of x.down)
              ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
              ULift.{u+1} _))) :
          (wcUnitTupleFun.{u} ℓ D ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj R ⟶
            (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) 0) ⋙
              AddCommGrpCat.uliftFunctor.{u+1, u}).obj R) ≫
        (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) 0) ⋙
          AddCommGrpCat.uliftFunctor.{u+1, u}).map φ := by
    intro D R R' φ
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro x
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom,
      Functor.comp_map, AddCommGrpCat.free_map, FreeAbelianGroup.map_of_apply,
      FreeAbelianGroup.lift_apply_of]
    apply ULift.ext
    exact (key D R R' φ x.down).symm

  have hνapp : ∀ (D : ℕ) (W : (Y.Etale)ᵒᵖ)
      (x : ULift.{u+1} ((wcUnitTupleFun.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))),
      ((wcLpttEtNu Y ℓ n D).app W).hom (FreeAbelianGroup.of x) =
        (ULift.up (TensorProduct.tmul ℤ
          (M := (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
          (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
          (FreeAbelianGroup.of x.down)
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
          ULift.{u+1} _) := by
    intro D W x
    unfold wcLpttEtNu wcNatOf
    split_ifs with h
    · exact FreeAbelianGroup.lift_apply_of _ _
    · exfalso
      apply h
      intro W W' f
      exact key2 D _ _ _

  have hεapp : ∀ (R : CommRingCat.{u}) (x : (wcUnitTupleFun.{u} ℓ 0).obj R)
      (v : (wcKtT.{u} (ℓ ^ n) 0).obj R),
      ((wcKtEps.{u} ℓ n 0).app R).hom (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ 0).obj R)
        (N := (wcKtT.{u} (ℓ ^ n) 0).obj R) (FreeAbelianGroup.of x) v) = v := by
    intro R x v
    unfold wcKtEps wcNatOf
    split_ifs with h
    · exact hgen2 ((wcKtT.{u} (ℓ ^ n) 0).obj R) x v
    · exfalso
      apply h
      intro R S φ
      exact hgen1 ((wcKtT.{u} (ℓ ^ n) 0).obj R) ((wcKtT.{u} (ℓ ^ n) 0).obj S)
        (ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ 0).map φ)) ((wcKtT.{u} (ℓ ^ n) 0).map φ)

  have hPapp : ∀ (W : (Y.Etale)ᵒᵖ)
      (τ : (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op W.unop.left))),
      ((wcLpttUSecPre Y ℓ n d 0 t hℓ).app W).hom (ULift.up τ) =
        ULift.up (TensorProduct.tmul ℤ
          (M := (wcKtZUT.{u} ℓ d).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
          (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
          (FreeAbelianGroup.of
            (⟨fun i => Units.map W.unop.hom.appTop.hom.toMonoidHom (t i),
              by
                have h := hℓ.map W.unop.hom.appTop.hom
                rw [map_natCast] at h
                exact h⟩ :
              (wcUnitTupleFun.{u} ℓ d).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))) τ) := by
    intro W τ
    unfold wcLpttUSecPre wcNatOf
    split_ifs with h
    · rfl
    · exfalso
      apply h
      intro W W' f
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      have hs : ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ d).map
          (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
          (⟨fun i => Units.map W.unop.hom.appTop.hom.toMonoidHom (t i),
            by
              have h := hℓ.map W.unop.hom.appTop.hom
              rw [map_natCast] at h
              exact h⟩ : (wcUnitTupleFun.{u} ℓ d).obj (Scheme.Γ.obj (Opposite.op W.unop.left))) =
          (⟨fun i => Units.map W'.unop.hom.appTop.hom.toMonoidHom (t i),
            by
              have h := hℓ.map W'.unop.hom.appTop.hom
              rw [map_natCast] at h
              exact h⟩ : (wcUnitTupleFun.{u} ℓ d).obj (Scheme.Γ.obj (Opposite.op W'.unop.left))) := by
        apply Subtype.ext
        funext i
        apply Units.ext
        have hw : f.unop.left ≫ W.unop.hom = W'.unop.hom := MorphismProperty.Over.w f.unop
        have h1 := congrArg (fun q => q.appTop.hom (t i : Γ(Y, ⊤))) hw
        simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
        exact h1
      exact congrArg ULift.up (hgen3 ((wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
        ((wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))
        (ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ d).map
          (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))))
        ((wcKtT.{u} (ℓ ^ n) 0).map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
        _ _ hs (ULift.down x))

  have hYapp : ∀ (D : ℕ) (s : Fin D → (Γ(Y, ⊤))ˣ) (W : (Y.Etale)ᵒᵖ)
      (f : ULift.{u+1} (W.unop ⟶ wcEtTop Y)),
      ((Functor.whiskerRight
        ((yonedaEquiv (X := wcEtTop Y)
          (F := (Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ D)).symm
          (Subtype.mk s hℓ : {t : Fin D → (Γ(Y, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))}))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app W).hom (FreeAbelianGroup.of f) =
        FreeAbelianGroup.of (ULift.up
          (⟨fun i => Units.map W.unop.hom.appTop.hom.toMonoidHom (s i),
            by
              have h := hℓ.map W.unop.hom.appTop.hom
              rw [map_natCast] at h
              exact h⟩ :
            (wcUnitTupleFun.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))) := by
    intro D s W f
    have hf : f.down.left = W.unop.hom :=
      (Category.comp_id f.down.left).symm.trans (MorphismProperty.Over.w f.down)
    show FreeAbelianGroup.map _ (FreeAbelianGroup.of f) = _
    refine (FreeAbelianGroup.map_of_apply f).trans ?_
    refine congrArg FreeAbelianGroup.of (ULift.ext _ _ ?_)
    refine Subtype.ext (funext fun i => Units.ext ?_)
    exact congrArg (fun q => q.appTop.hom (s i : Γ(Y, ⊤))) hf

  have hstar :
      Functor.whiskerRight
          ((yonedaEquiv (X := wcEtTop Y)
            (F := (Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ d)).symm
            (Subtype.mk t hℓ : {t : Fin d → (Γ(Y, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))}))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ wcLpttEtNu Y ℓ n d =
        (Functor.whiskerRight
          ((yonedaEquiv (X := wcEtTop Y)
            (F := (Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ 0)).symm
            (Subtype.mk Fin.elim0 hℓ : {t : Fin 0 → (Γ(Y, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))}))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫ wcLpttEtNu Y ℓ n 0 ≫
          Functor.whiskerLeft ((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ)
            (Functor.whiskerRight (wcKtEps.{u} ℓ n 0) AddCommGrpCat.uliftFunctor.{u+1, u})) ≫
          wcLpttUSecPre Y ℓ n d 0 t hℓ := by
    have hel : ∀ {F G H : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : F ⟶ G) (β : G ⟶ H)
        (W : (Y.Etale)ᵒᵖ) (x : F.obj W),
        ((α ≫ β).app W).hom x = (β.app W).hom ((α.app W).hom x) := fun _ _ _ _ => rfl
    apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    refine FreeAbelianGroup.lift_ext _ _ (fun f => ?_)
    refine Eq.trans (congrArg (fun z => ((wcLpttEtNu Y ℓ n d).app W).hom z) (hYapp d t W f)) ?_
    refine Eq.trans (hνapp d W _) ?_
    refine Eq.symm ?_
    refine Eq.trans (congrArg (fun z => ((wcLpttUSecPre Y ℓ n d 0 t hℓ).app W).hom
      (((Functor.whiskerLeft ((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ)
          (Functor.whiskerRight (wcKtEps.{u} ℓ n 0) AddCommGrpCat.uliftFunctor.{u+1, u})).app W).hom
        (((wcLpttEtNu Y ℓ n 0).app W).hom z))) (hYapp 0 Fin.elim0 W f)) ?_
    refine Eq.trans (congrArg (fun z => ((wcLpttUSecPre Y ℓ n d 0 t hℓ).app W).hom
      (((Functor.whiskerLeft ((Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ)
          (Functor.whiskerRight (wcKtEps.{u} ℓ n 0) AddCommGrpCat.uliftFunctor.{u+1, u})).app W).hom
        z)) (hνapp 0 W _)) ?_
    refine Eq.trans (congrArg (fun z => ((wcLpttUSecPre Y ℓ n d 0 t hℓ).app W).hom (ULift.up z))
      (hεapp _ _ _)) ?_
    exact hPapp W _
  have h := congrArg (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map hstar
  unfold wcLpttEtUTMap wcLpttEtNuSh wcLpttGen0
  refine ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
    (h.trans ?_)
  exact ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).trans
    (congrArg (· ≫ _)
      (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).trans
        (congrArg (_ ≫ ·)
          ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _))))

theorem wc_lptt_usec_eps (Y : Scheme.{u}) (ℓ n d : ℕ) (t : Fin d → (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    wcLpttUSec Y ℓ n d d t hℓ ≫ wcLpttEtShMap Y (wcKtEps.{u} ℓ n d) = 𝟙 _ :=
by
  classical

  have hgen1 : ∀ {α β : Type u} (A B : AddCommGrpCat.{u}) (g : α → β) (h : A ⟶ B),
      AddCommGrpCat.ofHom (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap
          h.hom.toIntLinearMap).toAddMonoidHom ≫
        AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift
          (fun _ => (LinearMap.id : B →ₗ[ℤ] B))).toIntLinearMap).toAddMonoidHom =
      AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift
          (fun _ => (LinearMap.id : A →ₗ[ℤ] A))).toIntLinearMap).toAddMonoidHom ≫ h := by
    intro α β A B g h
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.comp_apply,
      LinearMap.toAddMonoidHom_coe]
    induction x using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul z τ =>
      rw [TensorProduct.map_tmul, TensorProduct.lift.tmul, TensorProduct.lift.tmul,
        AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.coe_toIntLinearMap,
        AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.coe_toIntLinearMap]
      induction z using FreeAbelianGroup.induction_on with
      | zero => simp only [map_zero, LinearMap.zero_apply]
      | of x =>
        rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of]
        rfl
      | neg x hx => simp only [map_neg, LinearMap.neg_apply, hx]
      | add x y hx hy =>
        simp only [map_add, LinearMap.add_apply, hx, hy]
  have hgen2 : ∀ {α : Type u} (A : AddCommGrpCat.{u}) (s : α) (y : A),
      (TensorProduct.lift (FreeAbelianGroup.lift
          (fun _ => (LinearMap.id : A →ₗ[ℤ] A))).toIntLinearMap).toAddMonoidHom
        (FreeAbelianGroup.of s ⊗ₜ[ℤ] y) = y := by
    intro α A s y
    rw [LinearMap.toAddMonoidHom_coe, TensorProduct.lift.tmul, AddMonoidHom.coe_toIntLinearMap,
      FreeAbelianGroup.lift_apply_of]
    rfl
  have hgen3 : ∀ {α β : Type u} (A B : AddCommGrpCat.{u}) (g : α → β) (h : A ⟶ B) (s : α) (s' : β),
      g s = s' → ∀ τ : A,
      (FreeAbelianGroup.of s' ⊗ₜ[ℤ] h.hom τ : TensorProduct ℤ (FreeAbelianGroup β) B) =
        (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap h.hom.toIntLinearMap).toAddMonoidHom
          (FreeAbelianGroup.of s ⊗ₜ[ℤ] τ) := by
    intro α β A B g h s s' hs τ
    subst hs
    rw [LinearMap.toAddMonoidHom_coe, TensorProduct.map_tmul, AddMonoidHom.coe_toIntLinearMap,
      AddMonoidHom.coe_toIntLinearMap, FreeAbelianGroup.map_of_apply]

  have hnatε : ∀ ⦃R S : CommRingCat.{u}⦄ (φ : R ⟶ S),
      (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) d)).map φ ≫
        AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
          (wcKtT.{u} (ℓ ^ n) d).obj S →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) d).obj S))).toIntLinearMap).toAddMonoidHom =
      AddCommGrpCat.ofHom (TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
          (wcKtT.{u} (ℓ ^ n) d).obj R →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) d).obj R))).toIntLinearMap).toAddMonoidHom ≫
        (wcKtT.{u} (ℓ ^ n) d).map φ := by
    intro R S φ
    exact hgen1 ((wcKtT.{u} (ℓ ^ n) d).obj R) ((wcKtT.{u} (ℓ ^ n) d).obj S)
      (ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ d).map φ)) ((wcKtT.{u} (ℓ ^ n) d).map φ)
  have hε : wcKtEps.{u} ℓ n d = NatTrans.mk (fun R => AddCommGrpCat.ofHom (TensorProduct.lift
      (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
        (wcKtT.{u} (ℓ ^ n) d).obj R →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) d).obj R))).toIntLinearMap).toAddMonoidHom)
      hnatε := by
    unfold wcKtEps wcNatOf
    exact dif_pos hnatε

  rw [hε]
  unfold wcLpttUSec wcLpttEtShMap
  refine ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans ?_
  refine Eq.trans ?_ ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_id _)
  congr 1

  unfold wcNatOf
  rw [dif_pos]
  swap
  · intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    have hs : ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ d).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
        (⟨fun i => Units.map W.unop.hom.appTop.hom.toMonoidHom (t i),
          by
            have h := hℓ.map W.unop.hom.appTop.hom
            rw [map_natCast] at h
            exact h⟩ : (wcUnitTupleFun.{u} ℓ d).obj (Scheme.Γ.obj (Opposite.op W.unop.left))) =
        (⟨fun i => Units.map W'.unop.hom.appTop.hom.toMonoidHom (t i),
          by
            have h := hℓ.map W'.unop.hom.appTop.hom
            rw [map_natCast] at h
            exact h⟩ : (wcUnitTupleFun.{u} ℓ d).obj (Scheme.Γ.obj (Opposite.op W'.unop.left))) := by
      apply Subtype.ext
      funext i
      apply Units.ext
      have hw : f.unop.left ≫ W.unop.hom = W'.unop.hom := MorphismProperty.Over.w f.unop
      have h1 := congrArg (fun q => q.appTop.hom (t i : Γ(Y, ⊤))) hw
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
      exact h1
    exact congrArg ULift.up (hgen3 ((wcKtT.{u} (ℓ ^ n) d).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
      ((wcKtT.{u} (ℓ ^ n) d).obj (Scheme.Γ.obj (Opposite.op W'.unop.left)))
      (ConcreteCategory.hom ((wcUnitTupleFun.{u} ℓ d).map
        (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f))))
      ((wcKtT.{u} (ℓ ^ n) d).map (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).op.map f)))
      _ _ hs (ULift.down x))

  · apply NatTrans.ext
    funext W
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    exact congrArg ULift.up (hgen2 ((wcKtT.{u} (ℓ ^ n) d).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
      (⟨fun i => Units.map W.unop.hom.appTop.hom.toMonoidHom (t i),
          by
            have h := hℓ.map W.unop.hom.appTop.hom
            rw [map_natCast] at h
            exact h⟩ : (wcUnitTupleFun.{u} ℓ d).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
      (ULift.down x))

theorem wc_lptt_kum_eq_sym (Y : Scheme.{u}) (ℓ n d : ℕ) (t : Fin d → (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    (Abelian.Ext.mk₀ (wcLpttEtUTMap Y ℓ d t hℓ)).comp (wcLpttEtKum Y ℓ n d) (zero_add d) =
      wcLpttSym Y ℓ n d t hℓ :=
by
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  have inv : ∀ j (h : j ≤ d),
      (Abelian.Ext.mk₀ (wcLpttEtUTMap Y ℓ d t hℓ ≫ wcLpttEtNuSh Y ℓ n d)).comp
          (wcLpttEtChain Y ℓ n d j) (zero_add j) =
        (wcLpttSym Y ℓ n j (fun i => t (Fin.castLE h i)) hℓ).comp
          (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n d j t hℓ)) (add_zero j) := by
    intro j
    induction j with
    | zero =>
      intro h
      show (Abelian.Ext.mk₀ _).comp (Abelian.Ext.mk₀ (𝟙 _)) (zero_add 0) =
        (Abelian.Ext.mk₀ (wcLpttGen0 Y ℓ n hℓ)).comp _ (add_zero 0)
      rw [Abelian.Ext.comp_mk₀_id, Abelian.Ext.mk₀_comp_mk₀, wc_lptt_base_eq Y ℓ n d t hℓ]
    | succ j ih =>
      intro h
      have ih' := ih (by omega)
      show (Abelian.Ext.mk₀ _).comp ((wcLpttEtChain Y ℓ n d j).comp (wcLpttEtStep Y ℓ n d j) rfl)
          (zero_add (j + 1)) =
        ((wcLpttSym Y ℓ n j (fun i => t (Fin.castLE (by omega) i)) hℓ).comp
          (wcLpttKt Y ℓ n j (t ⟨j, by omega⟩) hℓ) rfl).comp _ (add_zero (j + 1))
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add j) rfl (by omega : 0 + j + 1 = j + 1), ih',
        Abelian.Ext.comp_assoc _ _ _ (add_zero j) (zero_add 1) (by omega : j + 0 + 1 = j + 1),
        wc_lptt_step_nat Y ℓ n d j t hℓ (by omega) (wc_lptt_et_step_ses Y ℓ n d j)
          (wc_lptt_et_step_ses Y ℓ n (j + 1) j),
        ← Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega : j + 1 + 0 = j + 1)]
  show (Abelian.Ext.mk₀ (wcLpttEtUTMap Y ℓ d t hℓ)).comp
      ((Abelian.Ext.mk₀ (wcLpttEtNuSh Y ℓ n d)).comp
        ((wcLpttEtChain Y ℓ n d d).comp
          (Abelian.Ext.mk₀ (wcLpttEtShMap Y (wcKtEps.{u} ℓ n d))) (add_zero d)) (zero_add d))
      (zero_add d) = _
  rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add d) (by omega : 0 + 0 + d = d),
    Abelian.Ext.mk₀_comp_mk₀,
    ← Abelian.Ext.comp_assoc _ _ _ (zero_add d) (add_zero d) (by omega : 0 + d + 0 = d),
    inv d le_rfl,
    Abelian.Ext.comp_assoc _ _ _ (add_zero d) (zero_add 0) (by omega : d + 0 + 0 = d),
    Abelian.Ext.mk₀_comp_mk₀, wc_lptt_usec_eps Y ℓ n d t hℓ, Abelian.Ext.comp_mk₀_id]
  all_goals rfl

theorem wc_lptt_sym_point (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (n : ℕ) (hn : 1 ≤ n) (hℓ : IsUnit ((ℓ : ℕ) : Γ(Spec (.of K), ⊤))) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of K))) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    ℓ ^ (n - 1) • wcLpttSym (Spec (.of K)) ℓ n 0 Fin.elim0 hℓ ≠ 0 :=
by
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of K))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  intro h0
  have main : ∀ (Y : Scheme.{u}) [Nonempty Y] (hℓY : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (c : ℕ),
      c • wcLpttGen0 Y ℓ n hℓY = 0 → ℓ ^ n ∣ c := by
    intro Y _ hℓY c hc

    obtain ⟨e, he⟩ : ∃ e : ∀ R : CommRingCat.{u}, (wcKtT.{u} (ℓ ^ n) 0).obj R,
        ∀ R, e R = ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0) :
          (wcKtT.{u} (ℓ ^ n) 0).obj R) := ⟨_, fun _ => rfl⟩
    have heT : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S),
        ((wcKtT.{u} (ℓ ^ n) 0).map φ).hom (e R) = e S := by
      intro R S φ
      rw [he, he]
      show (LinearMap.lTensor (ZMod (ℓ ^ n)) (PiTensorProduct.map fun _ : Fin 0 =>
        ((wcRootsFun.{u} (ℓ ^ n)).map φ).hom.toIntLinearMap))
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0)) = _
      rw [LinearMap.lTensor_tmul]
      erw [PiTensorProduct.map_tprod]
      congr 2
      funext i
      exact i.elim0

    have key : ∀ (A : Type u) [AddCommGroup A] (g : Fin 0 → A),
        c • ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ g :
          TensorProduct ℤ (ZMod (ℓ ^ n)) (PiTensorProduct ℤ fun _ : Fin 0 => A)) = 0 →
          ℓ ^ n ∣ c := by
      intro A _ g h
      have h5 := congrArg (fun z => (TensorProduct.rid ℤ (ZMod (ℓ ^ n)))
        ((LinearEquiv.lTensor (ZMod (ℓ ^ n))
          (PiTensorProduct.isEmptyEquiv (Fin 0) (R := ℤ) (s := fun _ : Fin 0 => A))) z)) h
      simp only [map_nsmul, map_zero, LinearEquiv.lTensor_tmul,
        PiTensorProduct.isEmptyEquiv_apply_tprod, TensorProduct.rid_tmul, one_smul] at h5
      rw [Nat.smul_one_eq_cast, ZMod.natCast_eq_zero_iff] at h5
      exact h5

    have hνnat : ∀ ⦃X Z : (Y.Etale)ᵒᵖ⦄ (f : X ⟶ Z),
        (wcLpttEtUTPre Y ℓ 0).map f ≫ (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun x =>
          (ULift.up (TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ 0).obj (Scheme.Γ.obj (Opposite.op (Z.unop.left))))
            (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op (Z.unop.left))))
            (FreeAbelianGroup.of x.down)
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
            ULift.{u+1} _)))) =
        (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun x =>
          (ULift.up (TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ 0).obj (Scheme.Γ.obj (Opposite.op (X.unop.left))))
            (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op (X.unop.left))))
            (FreeAbelianGroup.of x.down)
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
            ULift.{u+1} _)))) ≫
          (wcLpttEtPre Y (wcTensFun (wcKtZUT.{u} ℓ 0) (wcKtT.{u} (ℓ ^ n) 0))).map f := by
      intro X Z f
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro x
      erw [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_comp]
      erw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply]
      erw [FreeAbelianGroup.lift_apply_of]
      erw [FreeAbelianGroup.lift_apply_of]
      apply ULift.ext
      refine Eq.trans ?_ (TensorProduct.map_tmul _ _ _ _).symm
      refine congrArg₂ (TensorProduct.tmul ℤ) ?_ ?_
      · exact (FreeAbelianGroup.map_of_apply _).symm
      · have := heT _ _ (Scheme.Γ.map ((Scheme.Etale.forget Y ⋙ Over.forget Y).map f.unop).op)
        rw [he, he] at this
        exact this.symm
    have hνapp : ∀ (W : (Y.Etale)ᵒᵖ) (a : ULift.{u+1} ((wcUnitTupleFun.{u} ℓ 0).obj
        (Scheme.Γ.obj (Opposite.op W.unop.left)))),
        ((wcLpttEtNu Y ℓ n 0).app W).hom (FreeAbelianGroup.of a) =
          ULift.up (TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ 0).obj (Scheme.Γ.obj (Opposite.op (W.unop.left))))
            (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op (W.unop.left))))
            (FreeAbelianGroup.of a.down)
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) := by
      intro W a
      unfold wcLpttEtNu wcNatOf
      split_ifs with h
      · exact FreeAbelianGroup.lift_apply_of _ _
      · exact absurd hνnat h

    have hL : ∀ (M : Type u) [AddCommGroup M] (α : Type u) (a : FreeAbelianGroup α) (b : M),
        (FreeAbelianGroup.lift (fun _ : α => (LinearMap.id : M →ₗ[ℤ] M))) a b =
          (FreeAbelianGroup.lift (fun _ : α => (1 : ℤ)) a) • b := by
      intro M _ α a b
