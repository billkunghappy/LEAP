      subst hyβ
      have e1 := (sheafificationAdjunction (Scheme.ProEt.topology V.left)
        AddCommGrpCat.{u+1}).homEquiv_unit (f := wcLpscGen S V _ _ (wcLpscBetaTop S V))
      unfold wcLpscGen at e1 ⊢
      rw [Equiv.apply_symm_apply] at e1
      exact e1.symm
    have hLmap : ((wcLpscG S V).map (wcUnitTupleMap S V ℓ d tD hℓD)).hom =
        Functor.whiskerLeft (wcSliceFunctor S V).op (sheafifyMap (Scheme.ProEt.topology S)
          (Functor.whiskerRight yS (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) := by
      subst hyS
      rfl
    have hRmap : (wcUnitTupleMap V.left (Scheme.ProEt.mk (𝟙 V.left)) ℓ d tD hℓD).hom =
        sheafifyMap (Scheme.ProEt.topology V.left)
          (Functor.whiskerRight yV (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      subst hyV
      rfl
    have hsq : Functor.whiskerLeft (wcSliceFunctor S V).op (toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
        Functor.whiskerLeft (wcSliceFunctor S V).op (sheafifyMap (Scheme.ProEt.topology S)
          (Functor.whiskerRight yS (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) =
        Functor.whiskerLeft (wcSliceFunctor S V).op
            (Functor.whiskerRight yS (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) ≫
          Functor.whiskerLeft (wcSliceFunctor S V).op
            (toSheafify (Scheme.ProEt.topology S) (wcUnitTuplePre S ℓ d)) := by
      have hnat := toSheafify_naturality (Scheme.ProEt.topology S)
        (Functor.whiskerRight yS (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      have h2 := congrArg (Functor.whiskerLeft (wcSliceFunctor S V).op) hnat
      rw [Functor.whiskerLeft_comp, Functor.whiskerLeft_comp] at h2
      exact h2.symm
    have generic : ∀ {X0 X1 X2 X3 X4 Y1 Y2 : (V.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
        (a : X0 ⟶ X1) (g : X1 ⟶ X2) (m : X2 ⟶ X3) (c : X3 ⟶ X4) (r : X1 ⟶ X4)
        (wβ : X0 ⟶ Y1) (wtZ : Y1 ⟶ X2) (n : X2 ⟶ X3) (wLα : Y1 ⟶ Y2) (wtS : Y2 ⟶ X3)
        (wV : X0 ⟶ Y2) (t2 : Y2 ⟶ X4) (s : X1 ⟶ X4),
        a ≫ g = wβ ≫ wtZ → m = n → wtZ ≫ n = wLα ≫ wtS → wβ ≫ wLα = wV →
        wtS ≫ c = t2 → r = s → wV ≫ t2 = a ≫ s → a ≫ g ≫ m ≫ c = a ≫ r := by
      intro X0 X1 X2 X3 X4 Y1 Y2 a g m c r wβ wtZ n wLα wtS wV t2 s h1 h2 h3 h4 h5 h7 h6
      rw [h2, h7]
      calc a ≫ g ≫ n ≫ c = (a ≫ g) ≫ n ≫ c := (Category.assoc _ _ _).symm
        _ = (wβ ≫ wtZ) ≫ n ≫ c := by rw [h1]
        _ = wβ ≫ (wtZ ≫ n) ≫ c := by simp only [Category.assoc]
        _ = wβ ≫ (wLα ≫ wtS) ≫ c := by rw [h3]
        _ = (wβ ≫ wLα) ≫ (wtS ≫ c) := by simp only [Category.assoc]
        _ = wV ≫ t2 := by rw [h4, h5]
        _ = a ≫ s := h6
    have hnatV := toSheafify_naturality (Scheme.ProEt.topology V.left)
      (Functor.whiskerRight yV (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
    have hfin := generic _ _ _ _ _ _ _ _ _ _ _ _ _ hGen hLmap hsq hmerge
      (hCP (wcUnitTuplePre S ℓ d)) hRmap hnatV
    apply Sheaf.hom_ext
    exact sheafify_hom_ext _ _ _ (wcUnitTuple V.left ℓ d).property hfin

  have hPsi : ∀ (y : Abelian.Ext (wcFreeSheaf S V) (wcRootTwist S (ℓ ^ n) d) d),
      wcLpscPsi S V (ℓ ^ n) d (wcLpscBetaTop S V) d y =
        ((Abelian.Ext.mk₀ (wcLpscGen S V _ _ (wcLpscBetaTop S V))).comp
          (Abelian.Ext.mapExactFunctor (wcLpscG S V) y) (zero_add d)).comp
          (Abelian.Ext.mk₀ (wcLpscCP S V (wcRootTwistPre S (ℓ ^ n) d)).inv) (add_zero d) :=
    fun _ => rfl
  have hk : ∀ {A B C D : Sheaf (Scheme.ProEt.topology V.left) AddCommGrpCat.{u+1}}
      (f : A ⟶ B) (g : B ⟶ C) (κ : Abelian.Ext C D d),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp κ (zero_add d)) (zero_add d) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp κ (zero_add d) := by
    intro A B C D f g κ
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add d) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
  have hkey : wcLpscPsi S V (ℓ ^ n) d (wcLpscBetaTop S V) d
        ((Abelian.Ext.mk₀ (wcUnitTupleMap S V ℓ d tD hℓD)).comp
          (wcKumTuple S ℓ n d) (zero_add d)) =
      (Abelian.Ext.mk₀ (wcUnitTupleMap V.left (Scheme.ProEt.mk (𝟙 V.left)) ℓ d tD hℓD)).comp
        (wcKumTuple V.left ℓ n d) (zero_add d) := by
    rw [hPsi, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add d) (by omega : 0 + 0 + d = d),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add d) (add_zero d) (by omega : 0 + d + 0 = d),
      wc_lpsc_kum_transfer]
    exact (hk _ _ _).trans (congrArg (fun φ => (Abelian.Ext.mk₀ φ).comp (wcKumTuple V.left ℓ n d)
      (zero_add d)) ((Category.assoc _ _ _).trans hPi))

  intro hne h0
  apply hne
  have h1 := congrArg (wcLpscPsi S V (ℓ ^ n) d (wcLpscBetaTop S V) d) h0
  rw [map_nsmul, hkey, map_zero] at h1
  exact h1

theorem wc_proet_affIndEt_covering : ∀ (B : Scheme.{u}) (U : B.ProEt), Sieve.generate (fun (T : B.ProEt) (_ : T ⟶ U) => ∃ A : B.Opens, IsAffineOpen A ∧ wcAffIndEt B A T) ∈ Scheme.ProEt.topology B U :=
by
  classical

  have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
    intro R' S' _ _ _ hW
    have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff]
      exact hW.flat
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
      exact hW.flat_lmul'
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
      rw [diagonal_SpecMap]
      infer_instance
    exact ⟨hfl, hd⟩
  have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
    intro R' S' _ _ _ hW
    have hfl : Module.Flat R' S' := by
      have := hW.flat
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at this
      exact this
    have hd := hW.flat_diagonal
    rw [diagonal_SpecMap] at hd
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
            (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      haveI := hd
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
    exact Algebra.WeaklyEtale.mk hfl hmu

  have s1 : ∀ {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y] (f : X ⟶ Y), WeaklyEtale f →
      @Algebra.WeaklyEtale Γ(Y, ⊤) Γ(X, ⊤) _ _ f.appTop.hom.toAlgebra := by
    intro X Y _ _ f hf
    letI := f.appTop.hom.toAlgebra
    apply toRing
    have e : Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, ⊤) Γ(X, ⊤))) =
        X.isoSpec.inv ≫ f ≫ Y.isoSpec.hom := by
      rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, ← Scheme.isoSpec_hom_naturality,
        Iso.inv_hom_id_assoc]
    rw [e]
    haveI := hf
    infer_instance

  have s3 : ∀ {R S S' : Type u} [CommRing R] [CommRing S] [CommRing S'] (φ : R →+* S)
      (e : S ≃+* S'), wcIndEtale φ → wcIndEtale ((e : S →+* S').comp φ) := by
    intro R S S' _ _ _ φ e hφ
    letI : Algebra R S := φ.toAlgebra
    letI : Algebra R S' := ((e : S →+* S').comp φ).toAlgebra
    have hφ : ∀ (P : Type u) [CommRing P] [Algebra R P] [Algebra.FinitePresentation R P]
        (h : P →ₐ[R] S), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E), Algebra.Etale R E ∧
          ∃ (α : P →ₐ[R] E) (β : E →ₐ[R] S), β.comp α = h := hφ
    show ∀ (P : Type u) [CommRing P] [Algebra R P] [Algebra.FinitePresentation R P]
        (h : P →ₐ[R] S'), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E), Algebra.Etale R E ∧
          ∃ (α : P →ₐ[R] E) (β : E →ₐ[R] S'), β.comp α = h
    intro P _ _ _ h
    let h' : P →ₐ[R] S :=
      { toRingHom := (e.symm : S' →+* S).comp h.toRingHom
        commutes' := fun r => by
          change e.symm (h (algebraMap R P r)) = φ r
          rw [h.commutes]
          exact e.symm_apply_apply (φ r) }
    obtain ⟨E, iE, aE, hE, α, β, hβ⟩ := hφ P h'
    refine ⟨E, iE, aE, hE, α,
      { toRingHom := (e : S →+* S').comp β.toRingHom
        commutes' := fun r => by
          change e (β (algebraMap R E r)) = e (φ r)
          rw [β.commutes]
          rfl }, ?_⟩
    apply AlgHom.ext
    intro p
    change e (β (α p)) = h p
    rw [← AlgHom.comp_apply, hβ]
    change e (e.symm (h p)) = h p
    exact e.apply_symm_apply _

  have s4 : ∀ {Y : Scheme.{u}} [IsAffine Y] {R : CommRingCat.{u}} (φ : Γ(Y, ⊤) ⟶ R),
      (Spec.map φ ≫ Y.isoSpec.inv).appTop = φ ≫ (Scheme.ΓSpecIso R).inv := by
    intro Y _ R φ
    have h1 : Y.isoSpec.inv.appTop = (Scheme.ΓSpecIso Γ(Y, ⊤)).inv := by
      have := congrArg Scheme.Hom.appTop Y.isoSpec.hom_inv_id
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.id_appTop, Scheme.isoSpec_hom,
        Scheme.toSpecΓ_appTop] at this
      exact (Iso.comp_hom_eq_id _).1 this
    have h2 := Scheme.ΓSpecIso_naturality φ
    rw [← Iso.eq_comp_inv] at h2
    rw [Scheme.Hom.comp_appTop, h1, h2]
    simp

  intro B U
  haveI hU : WeaklyEtale U.hom := U.prop
  have hA0 : ∀ x : U.left, ∃ A : B.Opens, IsAffineOpen A ∧ U.hom x ∈ A := fun x => by
    obtain ⟨A, hA, hxA, -⟩ := exists_isAffineOpen_mem_and_subset (x := U.hom x) (U := ⊤) trivial
    exact ⟨A, hA, hxA⟩
  choose A hA hxA using hA0
  have hW0 : ∀ x : U.left, ∃ W : U.left.Opens, IsAffineOpen W ∧ x ∈ W ∧ W ≤ U.hom ⁻¹ᵁ (A x) :=
    fun x => by
      obtain ⟨W, hW, hxW, hWA⟩ :=
        exists_isAffineOpen_mem_and_subset (x := x) (U := U.hom ⁻¹ᵁ A x) (hxA x)
      exact ⟨W, hW, hxW, fun y hy => hWA hy⟩
  choose W hW hxW hWA using hW0
  haveI : ∀ x, IsAffine (A x).toScheme := hA
  haveI : ∀ x, IsAffine (W x).toScheme := hW
  let f : ∀ x, (W x).toScheme ⟶ (A x).toScheme := fun x => U.hom.resLE (A x) (W x) (hWA x)
  have hf : ∀ x, f x ≫ (A x).ι = (W x).ι ≫ U.hom := fun x => Scheme.Hom.resLE_comp_ι _ _
  have hfw : ∀ x, WeaklyEtale (f x) := fun x => by
    haveI : WeaklyEtale (f x ≫ (A x).ι) := by rw [hf x]; infer_instance
    exact WeaklyEtale.of_comp (f x) (A x).ι
  have hBS : ∀ x, ∃ (T : Type u) (_ : CommRing T) (_ : Algebra Γ((W x).toScheme, ⊤) T),
      Module.FaithfullyFlat Γ((W x).toScheme, ⊤) T ∧ Algebra.WeaklyEtale Γ((W x).toScheme, ⊤) T ∧
      wcIndEtale ((algebraMap Γ((W x).toScheme, ⊤) T).comp (f x).appTop.hom) := fun x => by
    letI := (f x).appTop.hom.toAlgebra
    exact wc_bs_weaklyEtale_indEtale_locally _ _ (s1 (f x) (hfw x))
  choose T iT aT hff hwe hind using hBS
  let φ : ∀ x, Γ((W x).toScheme, ⊤) ⟶ CommRingCat.of (T x) := fun x =>
    CommRingCat.ofHom (algebraMap Γ((W x).toScheme, ⊤) (T x))
  let δ : ∀ x, Spec (CommRingCat.of (T x)) ⟶ (W x).toScheme := fun x =>
    Spec.map (φ x) ≫ (W x).toScheme.isoSpec.inv
  have hδw : ∀ x, WeaklyEtale (δ x) := fun x => by
    haveI := toSch _ _ (hwe x)
    show WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap Γ((W x).toScheme, ⊤) (T x))) ≫
      (W x).toScheme.isoSpec.inv)
    infer_instance
  have hδs : ∀ x, Surjective (δ x) := fun x => by
    haveI := hff x
    haveI : Surjective (Spec.map (CommRingCat.ofHom (algebraMap Γ((W x).toScheme, ⊤) (T x)))) :=
      ⟨PrimeSpectrum.comap_surjective_of_faithfullyFlat⟩
    show Surjective (Spec.map (CommRingCat.ofHom (algebraMap Γ((W x).toScheme, ⊤) (T x))) ≫
      (W x).toScheme.isoSpec.inv)
    infer_instance
  have hδq : ∀ x, QuasiCompact (δ x) := fun x => inferInstance
  have hcov := Precoverage.comp_mem_coverings (J := Scheme.proetalePrecoverage)
    (fun x : U.left => (W x).ι)
    ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left
      ((Scheme.ofArrows_mem_precoverage_iff _).2
        ⟨fun y => ⟨y, by rw [Scheme.Opens.range_ι]; exact hxW y⟩, fun i => inferInstance⟩),
     (Scheme.ofArrows_mem_precoverage_iff _).2
       ⟨fun y => ⟨y, by rw [Scheme.Opens.range_ι]; exact hxW y⟩, fun i => inferInstance⟩⟩
    (σ := fun _ => PUnit.{1}) (Y := fun i _ => Spec (CommRingCat.of (T i))) (fun i _ => δ i)
    (fun i => by
      haveI := hδs i
      haveI := hδq i
      rw [Presieve.ofArrows_pUnit]
      exact Scheme.Hom.singleton_mem_propQCPrecoverage (hδw i))
  let 𝒯 : U.left → B.ProEt := fun x =>
    haveI := hδw x
    Scheme.ProEt.mk (δ x ≫ (W x).ι ≫ U.hom)
  let t : ∀ x, 𝒯 x ⟶ U := fun x =>
    MorphismProperty.Over.homMk (A := 𝒯 x) (B := U) (δ x ≫ (W x).ι) (Category.assoc _ _ _) trivial
  have hmemP : ∀ x, wcAffIndEt B (A x) (𝒯 x) := fun x => by
    refine ⟨show IsAffine (Spec (CommRingCat.of (T x))) from inferInstance, δ x ≫ f x, ?_, ?_⟩
    · show (δ x ≫ f x) ≫ (A x).ι = δ x ≫ (W x).ι ≫ U.hom
      rw [Category.assoc, hf x]
    · have happ : (δ x ≫ f x).appTop =
          (f x).appTop ≫ φ x ≫ (Scheme.ΓSpecIso (CommRingCat.of (T x))).inv := by
        rw [Scheme.Hom.comp_appTop]
        exact congrArg (fun g => (f x).appTop ≫ g) (s4 (φ x))
      have key := congrArg CommRingCat.Hom.hom happ
      show wcIndEtale (CommRingCat.Hom.hom (Scheme.Hom.appTop (δ x ≫ f x)))
      rw [key]
      exact s3 _ (Scheme.ΓSpecIso (CommRingCat.of (T x))).symm.commRingCatIsoToRingEquiv (hind x)
  let 𝒯' : (Σ _ : U.left, PUnit.{1}) → B.ProEt := fun p => 𝒯 p.1
  let t' : ∀ p, 𝒯' p ⟶ U := fun p => t p.1
  have hmem' : Presieve.ofArrows 𝒯' t' ∈
      (Scheme.proetalePrecoverage.comap (Scheme.ProEt.forget B ⋙ Over.forget B)).coverings U := by
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    exact hcov
  have hmem : Presieve.ofArrows 𝒯' t' ∈ (Scheme.ProEt.precoverage B).coverings U := hmem'
  refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
    (Precoverage.generate_mem_toGrothendieck hmem)
  rintro _ _ ⟨p⟩
  exact ⟨A p.1, hA p.1, hmemP p.1⟩

theorem wc_rtc_pres_limit : ∀ (S : Scheme.{u}) (W : S.ProEt) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (U' : Λ ⥤ S.Etale) (φ : ∀ l, W ⟶ (wcEtToProEt S).obj (U'.obj l)), (∀ {l l' : Λ} (g : l ⟶ l'), φ l ≫ (wcEtToProEt S).map (U'.map g) = φ l') → (∀ l, IsAffine (U'.obj l).left) → (∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (U'.obj l).left), (∀ {l l' : Λ} (g : l ⟶ l'), z l ≫ (U'.map g).left = z l') → ∃! h : Z ⟶ W.left, ∀ l, h ≫ (φ l).left = z l) → (∀ (E : S.Etale) (a : W ⟶ (wcEtToProEt S).obj E), ∃ (l : Λ) (e : U'.obj l ⟶ E), φ l ≫ (wcEtToProEt S).map e = a) ∧ (∀ s : Γ(W.left, ⊤), ∃ (l : Λ) (r : Γ((U'.obj l).left, ⊤)), (φ l).left.appTop.hom r = s) ∧ (∀ (l : Λ) (r : Γ((U'.obj l).left, ⊤)), (φ l).left.appTop.hom r = 0 → ∃ (l' : Λ) (g : l' ⟶ l), (U'.map g).left.appTop.hom r = 0) :=
by
  intro S W Λ _ _ U' φ hφ hAff hlim
  let D₀ : Λ ⥤ Scheme.{u} := U' ⋙ Scheme.Etale.forget S ⋙ Over.forget S
  let c : Limits.Cone D₀ :=
    { pt := W.left
      π := { app := fun l => (φ l).left
             naturality := fun l l' g => by
               have := congrArg (fun x => x.left) (hφ g)
               exact (Category.id_comp _).trans this.symm } }
  have hc : Limits.IsLimit c := Limits.IsLimit.ofExistsUnique (fun s =>
    hlim s.pt s.π.app (fun g => s.w g))
  let t : D₀ ⟶ (Functor.const Λ).obj S :=
    { app := fun l => (U'.obj l).hom
      naturality := fun l l' g => by
        exact (MorphismProperty.Over.w (U'.map g)).trans (Category.comp_id _).symm }
  have : ∀ l, IsAffine (D₀.obj l) := hAff
  have : ∀ {i j : Λ} (g : i ⟶ j), IsAffineHom (D₀.map g) := fun g => isAffineHom_of_isAffine _
  have : ∀ l, CompactSpace (D₀.obj l) := fun l => inferInstance
  have : ∀ l, QuasiSeparatedSpace (D₀.obj l) := fun l => inferInstance
  refine ⟨fun E a => ?_, fun s => ?_, fun l r hr => ?_⟩
  · obtain ⟨l, g, hg1, hg2⟩ := Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation D₀ t
      E.hom c hc a.left (by
        ext l
        exact (MorphismProperty.Over.w (φ l)).trans (MorphismProperty.Over.w a).symm)
    exact ⟨l, MorphismProperty.Over.homMk g hg2 trivial, MorphismProperty.Over.Hom.ext hg1⟩
  · obtain ⟨l, r, hr⟩ := exists_appTop_π_eq_of_isAffine_of_isLimit D₀ c hc s
    exact ⟨l, r, hr⟩
  · have hcpt : IsCompact ((⊤ : (D₀.obj l).Opens) : Set (D₀.obj l)) := by
      rw [TopologicalSpace.Opens.coe_top]
      exact isCompact_univ
    obtain ⟨l', g, hg⟩ := exists_app_map_eq_zero_of_isLimit D₀ c hc hcpt r hr
    exact ⟨l', g, hg⟩

theorem wc_lpet_counit_iso (Y : Scheme.{u}) (P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (hP : wcPresFin Y P) :
    IsIso ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
      (((wcEtToProEt Y).op.lanAdjunction AddCommGrpCat.{u+1}).counit.app P)) :=
by
  obtain ⟨ε, hε⟩ : ∃ ε : (wcEtToProEt Y).op.lan.obj ((wcEtToProEt Y).op ⋙ P) ⟶ P,
      ε = ((wcEtToProEt Y).op.lanAdjunction AddCommGrpCat.{u+1}).counit.app P := ⟨_, rfl⟩
  have hc1 : ∀ (T : Y.ProEt) (V : Y.Etale) (a : T ⟶ (wcEtToProEt Y).obj V)
      (t : ((wcEtToProEt Y).op ⋙ P).obj (Opposite.op V)),
      ε.app (Opposite.op T)
        (((wcEtToProEt Y).op.lan.obj ((wcEtToProEt Y).op ⋙ P)).map a.op
          ((((wcEtToProEt Y).op.lanUnit.app ((wcEtToProEt Y).op ⋙ P)).app
            (Opposite.op V)) t)) = P.map a.op t := by
    intro T V a t
    have h := Functor.lanUnit_app_app_lanAdjunction_counit_app_app (wcEtToProEt Y).op
      P (Opposite.op V)
    rw [← hε] at h
    have h2 := ConcreteCategory.congr_hom h t
    rw [CategoryTheory.comp_apply, CategoryTheory.id_apply] at h2
    rw [NatTrans.naturality_apply]
    exact congrArg (fun z => P.map a.op z) h2
  have hnat : ∀ (V V' : Y.Etale) (e : V' ⟶ V)
      (t : ((wcEtToProEt Y).op ⋙ P).obj (Opposite.op V)),
      ((wcEtToProEt Y).op.lan.obj ((wcEtToProEt Y).op ⋙ P)).map
          ((wcEtToProEt Y).map e).op
          ((((wcEtToProEt Y).op.lanUnit.app ((wcEtToProEt Y).op ⋙ P)).app
            (Opposite.op V)) t) =
        (((wcEtToProEt Y).op.lanUnit.app ((wcEtToProEt Y).op ⋙ P)).app
            (Opposite.op V')) (((wcEtToProEt Y).op ⋙ P).map e.op t) := by
    intro V V' e t
    exact (NatTrans.naturality_apply
      ((wcEtToProEt Y).op.lanUnit.app ((wcEtToProEt Y).op ⋙ P)) e.op t).symm
  have hbij : ∀ (A : Y.Opens), IsAffineOpen A → ∀ W : Y.ProEt, wcAffIndEt Y A W →
      Function.Bijective (ConcreteCategory.hom (ε.app (Opposite.op W))) := by
    intro A hA W hW
    obtain ⟨Pr⟩ := wc_etPres_of_affIndEt Y A hA W 0 (fun i => Fin.elim0 i) (fun i => Fin.elim0 i)
      hW (fun i => Fin.elim0 i)
    obtain ⟨hR, -, -⟩ := wc_rtc_pres_limit Y W Pr.Λ Pr.U' Pr.φ Pr.hφ Pr.affU Pr.limU
    obtain ⟨hFs, hFi⟩ := hP W Pr.Λ Pr.U' Pr.φ Pr.hφ Pr.affU Pr.limU
    refine ⟨(injective_iff_map_eq_zero (ConcreteCategory.hom (ε.app (Opposite.op W)))).mpr ?_, ?_⟩
    · intro x hx
      obtain ⟨l₀⟩ : Nonempty Pr.Λ := IsCofiltered.nonempty
      obtain ⟨V₁, b, a, t, -, rfl⟩ :=
        (wc_lan_etale_rep Y ((wcEtToProEt Y).op ⋙ P) W).1
          (Pr.U'.obj l₀) (Pr.φ l₀) x
      obtain ⟨l, e, he⟩ := hR V₁ a
      subst he
      rw [op_comp, Functor.map_comp, CategoryTheory.comp_apply, hnat] at hx ⊢
      have h0 := (hc1 W (Pr.U'.obj l) (Pr.φ l) _).symm.trans hx
      obtain ⟨l', g, hg⟩ := hFi l _ h0
      have hg' : ((wcEtToProEt Y).op ⋙ P).map (Pr.U'.map g).op
          (((wcEtToProEt Y).op ⋙ P).map e.op t) = 0 := hg
      rw [← Pr.hφ g, op_comp, Functor.map_comp, CategoryTheory.comp_apply, hnat, hg', map_zero,
        map_zero]
    · intro s
      obtain ⟨l, t, ht⟩ := hFs s
      exact ⟨_, (hc1 W _ (Pr.φ l) t).trans ht⟩
  haveI hsurj : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y) ε := by
    apply Presheaf.IsLocallySurjective.mk
    intro U s
    apply GrothendieckTopology.superset_covering _ _ (wc_proet_affIndEt_covering Y U)
    rw [Sieve.generate_le_iff]
    rintro T g ⟨A, hA, hT⟩
    rw [Presheaf.imageSieve_apply]
    exact (hbij A hA T hT).2 _
  haveI hinj : Presheaf.IsLocallyInjective (Scheme.ProEt.topology Y) ε := by
    apply Presheaf.IsLocallyInjective.mk
    intro X x y hxy
    apply GrothendieckTopology.superset_covering _ _ (wc_proet_affIndEt_covering Y X.unop)
    rw [Sieve.generate_le_iff]
    rintro T g ⟨A, hA, hT⟩
    rw [Presheaf.equalizerSieve_apply]
    apply (hbij A hA T hT).1
    have e1 := NatTrans.naturality_apply ε g.op x
    have e2 := NatTrans.naturality_apply ε g.op y
    exact e1.trans ((congrArg _ hxy).trans e2.symm)
  have hW : (Scheme.ProEt.topology Y).W ε := GrothendieckTopology.W_of_isLocallyBijective _ ε
  rw [GrothendieckTopology.W_iff] at hW
  subst hε
  exact hW

theorem wc_lpet_presfin_ring (Y : Scheme.{u}) (H : CommRingCat.{u} ⥤ AddCommGrpCat.{u+1})
    (hH : wcRingFin H) :
    wcPresFin Y ((Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ H) :=
by
  intro W Λ _ _ U' φ hφ hAff hlim
  let D₀ : Λ ⥤ Scheme.{u} := U' ⋙ Scheme.Etale.forget Y ⋙ Over.forget Y
  let c : Limits.Cone D₀ :=
    { pt := W.left
      π := { app := fun l => (φ l).left
             naturality := fun l l' g => by
               have := congrArg (fun x => x.left) (hφ g)
               exact (Category.id_comp _).trans this.symm } }
  have hc : Limits.IsLimit c := Limits.IsLimit.ofExistsUnique (fun s =>
    hlim s.pt s.π.app (fun g => s.w g))
  have : ∀ l, IsAffine (D₀.obj l) := hAff
  have : ∀ {i j : Λ} (g : i ⟶ j), IsAffineHom (D₀.map g) := fun g => isAffineHom_of_isAffine _
  have : ∀ l, CompactSpace (D₀.obj l) := fun l => inferInstance
  have : ∀ l, QuasiSeparatedSpace (D₀.obj l) := fun l => inferInstance
  have hΓs : ∀ s : Γ(W.left, ⊤), ∃ (l : Λ) (r : Γ((U'.obj l).left, ⊤)),
      (φ l).left.appTop.hom r = s := by
    intro s
    obtain ⟨l, r, hr⟩ := exists_appTop_π_eq_of_isAffine_of_isLimit D₀ c hc s
    exact ⟨l, r, hr⟩
  have hΓz : ∀ (l : Λ) (r : Γ((U'.obj l).left, ⊤)), (φ l).left.appTop.hom r = 0 →
      ∃ (l' : Λ) (g : l' ⟶ l), (U'.map g).left.appTop.hom r = 0 := by
    intro l r hr
    have hcpt : IsCompact ((⊤ : (D₀.obj l).Opens) : Set (D₀.obj l)) := by
      rw [TopologicalSpace.Opens.coe_top]
      exact isCompact_univ
    obtain ⟨l', g, hg⟩ := exists_app_map_eq_zero_of_isLimit D₀ c hc hcpt r hr
    exact ⟨l', g, hg⟩
  let R : Λᵒᵖ ⥤ CommRingCat.{u} := D₀.op ⋙ Scheme.Γ
  have hRc : ∀ {l l' : Λ} (g : l ⟶ l'),
      R.map g.op ≫ (φ l).left.appTop = (φ l').left.appTop := by
    intro l l' g
    have e : (φ l').left = (φ l).left ≫ (U'.map g).left :=
      (congrArg (fun f => f.left) (hφ g)).symm
    have h := Scheme.Hom.comp_appTop (φ l).left (U'.map g).left
    rw [← e] at h
    exact h.symm
  obtain ⟨hS, hK⟩ := hH Λ R Γ(W.left, ⊤) (fun l => (φ l).left.appTop) hRc hΓs hΓz
  refine ⟨fun s => ?_, fun l t ht => ?_⟩
  · obtain ⟨l, x, hx⟩ := hS s
    exact ⟨l, x, hx⟩
  · obtain ⟨l', g, hg⟩ := hK l t ht
    exact ⟨l', g, hg⟩

theorem wc_lpet_presfin_free (Y : Scheme.{u}) :
    wcPresFin Y (yoneda.obj (Scheme.ProEt.mk (𝟙 Y)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) :=
by
  classical
  have hsub : ∀ (T : Y.ProEt) (f g : T ⟶ Scheme.ProEt.mk (𝟙 Y)), f = g := fun T f g =>
    MorphismProperty.Over.Hom.ext
      (((Category.comp_id f.left).symm.trans (MorphismProperty.Over.w f)).trans
        ((Category.comp_id g.left).symm.trans (MorphismProperty.Over.w g)).symm)
  have hbij : ∀ {A B : Y.ProEt} (f : A ⟶ B),
      Function.Bijective ((yoneda.obj (Scheme.ProEt.mk (𝟙 Y)) ⋙ uliftFunctor.{u+1, u} ⋙
        AddCommGrpCat.free).map f.op) := by
    intro A B f
    haveI h1 : IsIso ((yoneda.obj (Scheme.ProEt.mk (𝟙 Y))).map f.op) := by
      rw [isIso_iff_bijective]
      exact ⟨fun x y _ => hsub _ x y, fun h =>
        ⟨MorphismProperty.Over.homMk B.hom (Category.comp_id _) trivial, hsub _ _ _⟩⟩
    haveI : IsIso ((yoneda.obj (Scheme.ProEt.mk (𝟙 Y)) ⋙ uliftFunctor.{u+1, u} ⋙
        AddCommGrpCat.free).map f.op) :=
      Functor.map_isIso (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
        ((yoneda.obj (Scheme.ProEt.mk (𝟙 Y))).map f.op)
    exact ConcreteCategory.bijective_of_isIso _
  intro W Λ _ _ U' φ _ _ _
  refine ⟨fun s => ?_, fun l t ht => ?_⟩
  · obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    obtain ⟨t, ht⟩ := (hbij (φ l₀)).2 s
    exact ⟨l₀, t, ht⟩
  · have ht0 : t = 0 := (hbij (φ l)).1 (ht.trans (map_zero _).symm)
    refine ⟨l, 𝟙 l, ?_⟩
    rw [ht0, map_zero]

theorem wc_lpet_fin_ulift (G : CommRingCat.{u} ⥤ AddCommGrpCat.{u}) (hG : wcRingFin G) :
    wcRingFin (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) :=
by
  intro Λ _ _ R B π hc hS hK
  obtain ⟨hGS, hGK⟩ := hG Λ R B π hc hS hK
  have key : ∀ {A A' : CommRingCat.{u}} (f : A ⟶ A')
      (x : (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).obj A),
      ULift.down ((G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map f x) =
        G.map f (ULift.down x) := fun _ _ => rfl
  refine ⟨fun y => ?_, fun l x hx => ?_⟩
  · obtain ⟨l, x, hx⟩ := hGS (ULift.down y)
    exact ⟨l, ULift.up x, ULift.ext _ _ ((key _ _).trans hx)⟩
  · have h0 : G.map (π l) (ULift.down x) = 0 :=
      (key _ _).symm.trans ((congrArg ULift.down hx).trans rfl)
    obtain ⟨l', g, hg⟩ := hGK l (ULift.down x) h0
    exact ⟨l', g, ULift.ext _ _ ((key _ _).trans (hg.trans rfl))⟩

theorem wc_lpet_fin_tens (A B : CommRingCat.{u} ⥤ AddCommGrpCat.{u}) (hA : wcRingFin A)
    (hB : wcRingFin B) : wcRingFin (wcTensFun A B) :=
by
  unfold wcRingFin
  intro Λ _ _ R S π hπ hSr hKr
  classical
  obtain ⟨hSA, hKA⟩ := hA Λ R S π hπ hSr hKr
  obtain ⟨hSB, hKB⟩ := hB Λ R S π hπ hSr hKr

  obtain ⟨RT, hRT, hRTt, hRTc⟩ : ∃ RT : ∀ {X Y : CommRingCat.{u}}, (X ⟶ Y) →
      (TensorProduct ℤ (A.obj X) (B.obj X) →+ TensorProduct ℤ (A.obj Y) (B.obj Y)),
      (∀ {X Y : CommRingCat.{u}} (f : X ⟶ Y) (x : TensorProduct ℤ (A.obj X) (B.obj X)),
        (wcTensFun A B).map f x = RT f x) ∧
      (∀ {X Y : CommRingCat.{u}} (f : X ⟶ Y) (a : A.obj X) (b : B.obj X),
        RT f (a ⊗ₜ[ℤ] b) = (A.map f a) ⊗ₜ[ℤ] (B.map f b)) ∧
      (∀ {X Y Z : CommRingCat.{u}} (f : X ⟶ Y) (g : Y ⟶ Z)
        (x : TensorProduct ℤ (A.obj X) (B.obj X)),
        RT g (RT f x) = RT (f ≫ g) x) := by
    refine ⟨fun f => (TensorProduct.map (A.map f).hom.toIntLinearMap
      (B.map f).hom.toIntLinearMap).toAddMonoidHom, fun f x => rfl, ?_, ?_⟩
    · intro X Y f a b
      show TensorProduct.map (A.map f).hom.toIntLinearMap (B.map f).hom.toIntLinearMap
        (a ⊗ₜ[ℤ] b) = _
      rw [TensorProduct.map_tmul]
      rfl
    · intro X Y Z f g x
      have h := ConcreteCategory.congr_hom ((wcTensFun A B).map_comp f g) x
      exact h.symm

  have hTFA : ∀ {l l' : Λ} (g : l ⟶ l') (x : A.obj (R.obj (Opposite.op l'))),
      A.map (π l) (A.map (R.map g.op) x) = A.map (π l') x := by
    intro l l' g x
    rw [← hπ g, Functor.map_comp]
    rfl
  have hTFB : ∀ {l l' : Λ} (g : l ⟶ l') (x : B.obj (R.obj (Opposite.op l'))),
      B.map (π l) (B.map (R.map g.op) x) = B.map (π l') x := by
    intro l l' g x
    rw [← hπ g, Functor.map_comp]
    rfl

  obtain ⟨C, _, ν, hν, hKer⟩ : ∃ (C : Type u) (_ : AddCommGroup C)
      (ν : ∀ l : Λ, TensorProduct ℤ (A.obj (R.obj (Opposite.op l))) (B.obj (R.obj (Opposite.op l))) →+ C),
      (∀ {l l' : Λ} (g : l ⟶ l')
        (x : TensorProduct ℤ (A.obj (R.obj (Opposite.op l'))) (B.obj (R.obj (Opposite.op l')))),
        ν l (RT (R.map g.op) x) = ν l' x) ∧
      (∀ (l : Λ) (x : TensorProduct ℤ (A.obj (R.obj (Opposite.op l))) (B.obj (R.obj (Opposite.op l)))),
        ν l x = 0 → ∃ (l' : Λ) (g : l' ⟶ l), RT (R.map g.op) x = 0) := by
    let D : Λᵒᵖ ⥤ AddCommGrpCat.{u} := R ⋙ wcTensFun A B
    refine ⟨((Limits.colimit D : AddCommGrpCat.{u}) : Type u), inferInstance,
      fun l => (Limits.colimit.ι D (Opposite.op l)).hom, ?_, ?_⟩
    · intro l l' g x
      have h := ConcreteCategory.congr_hom (Limits.colimit.w D g.op) x
      rw [← hRT (R.map g.op) x]
      exact h
    · intro l x hx
      have h0 : ConcreteCategory.hom (Limits.colimit.ι D (Opposite.op l)) x =
          ConcreteCategory.hom (Limits.colimit.ι D (Opposite.op l)) 0 :=
        hx.trans (map_zero _).symm
      obtain ⟨k, f, f', hff⟩ := (Limits.Concrete.colimit_rep_eq_iff_exists D x 0).mp h0
      have h1 := hff.trans (map_zero _)
      refine ⟨k.unop, f.unop, ?_⟩
      rw [← hRT]
      exact h1

  have hvanA : ∀ (l : Λ) (y : A.obj (R.obj (Opposite.op l))) (y' : B.obj (R.obj (Opposite.op l))),
      A.map (π l) y = 0 → ν l (y ⊗ₜ[ℤ] y') = 0 := by
    intro l y y' hy
    obtain ⟨l', g, hg⟩ := hKA l y hy
    rw [← hν g, hRTt, hg, TensorProduct.zero_tmul, map_zero]
  have hvanB : ∀ (l : Λ) (y : A.obj (R.obj (Opposite.op l))) (y' : B.obj (R.obj (Opposite.op l))),
      B.map (π l) y' = 0 → ν l (y ⊗ₜ[ℤ] y') = 0 := by
    intro l y y' hy
    obtain ⟨l', g, hg⟩ := hKB l y' hy
    rw [← hν g, hRTt, hg, TensorProduct.tmul_zero, map_zero]

  have hsame : ∀ (l : Λ) (y₁ y₂ : A.obj (R.obj (Opposite.op l)))
      (y₁' y₂' : B.obj (R.obj (Opposite.op l))),
      A.map (π l) y₁ = A.map (π l) y₂ → B.map (π l) y₁' = B.map (π l) y₂' →
      ν l (y₁ ⊗ₜ[ℤ] y₁') = ν l (y₂ ⊗ₜ[ℤ] y₂') := by
    intro l y₁ y₂ y₁' y₂' h1 h2
    have e : y₁ ⊗ₜ[ℤ] y₁' = (y₁ - y₂) ⊗ₜ[ℤ] y₁' + y₂ ⊗ₜ[ℤ] (y₁' - y₂') + y₂ ⊗ₜ[ℤ] y₂' := by
      rw [TensorProduct.sub_tmul, TensorProduct.tmul_sub]
      abel
    rw [e, map_add, map_add, hvanA l _ _ (by rw [map_sub, h1, sub_self]),
      hvanB l _ _ (by rw [map_sub, h2, sub_self]), zero_add, zero_add]

  have hind : ∀ (l l' : Λ) (y : A.obj (R.obj (Opposite.op l))) (y' : B.obj (R.obj (Opposite.op l)))
      (z : A.obj (R.obj (Opposite.op l'))) (z' : B.obj (R.obj (Opposite.op l'))),
      A.map (π l) y = A.map (π l') z → B.map (π l) y' = B.map (π l') z' →
      ν l (y ⊗ₜ[ℤ] y') = ν l' (z ⊗ₜ[ℤ] z') := by
    intro l l' y y' z z' h1 h2
    rw [← hν (IsCofiltered.minToLeft l l'), ← hν (IsCofiltered.minToRight l l'), hRTt, hRTt]
    apply hsame
    · rw [hTFA, hTFA]; exact h1
    · rw [hTFB, hTFB]; exact h2

  have hlift2 : ∀ (a : A.obj S) (b : B.obj S), ∃ (l : Λ) (y : A.obj (R.obj (Opposite.op l)))
      (y' : B.obj (R.obj (Opposite.op l))), A.map (π l) y = a ∧ B.map (π l) y' = b := by
    intro a b
    obtain ⟨l₁, x₁, h₁⟩ := hSA a
    obtain ⟨l₂, x₂, h₂⟩ := hSB b
    exact ⟨IsCofiltered.min l₁ l₂, A.map (R.map (IsCofiltered.minToLeft l₁ l₂).op) x₁,
      B.map (R.map (IsCofiltered.minToRight l₁ l₂).op) x₂, by rw [hTFA, h₁], by rw [hTFB, h₂]⟩
  have hlift4 : ∀ (a₁ a₂ : A.obj S) (b₁ b₂ : B.obj S), ∃ (l : Λ)
      (y₁ y₂ : A.obj (R.obj (Opposite.op l))) (z₁ z₂ : B.obj (R.obj (Opposite.op l))),
      A.map (π l) y₁ = a₁ ∧ A.map (π l) y₂ = a₂ ∧ B.map (π l) z₁ = b₁ ∧ B.map (π l) z₂ = b₂ := by
    intro a₁ a₂ b₁ b₂
    obtain ⟨l₁, y₁, z₁, h₁, h₁'⟩ := hlift2 a₁ b₁
    obtain ⟨l₂, y₂, z₂, h₂, h₂'⟩ := hlift2 a₂ b₂
    exact ⟨IsCofiltered.min l₁ l₂, A.map (R.map (IsCofiltered.minToLeft l₁ l₂).op) y₁,
      A.map (R.map (IsCofiltered.minToRight l₁ l₂).op) y₂,
      B.map (R.map (IsCofiltered.minToLeft l₁ l₂).op) z₁,
      B.map (R.map (IsCofiltered.minToRight l₁ l₂).op) z₂, by rw [hTFA, h₁], by rw [hTFA, h₂],
      by rw [hTFB, h₁'], by rw [hTFB, h₂']⟩

  choose L Y Y' hY hY' using hlift2
  obtain ⟨β, hP⟩ : ∃ β : A.obj S → B.obj S → C, ∀ (a : A.obj S) (b : B.obj S) (l : Λ)
      (y : A.obj (R.obj (Opposite.op l))) (y' : B.obj (R.obj (Opposite.op l))),
      A.map (π l) y = a → B.map (π l) y' = b → β a b = ν l (y ⊗ₜ[ℤ] y') :=
    ⟨fun a b => ν (L a b) (Y a b ⊗ₜ[ℤ] Y' a b), fun a b l y y' hy hy' =>
      hind _ _ _ _ _ _ ((hY a b).trans hy.symm) ((hY' a b).trans hy'.symm)⟩
  have H1 : ∀ (a₁ a₂ : A.obj S) (b : B.obj S), β (a₁ + a₂) b = β a₁ b + β a₂ b := by
    intro a₁ a₂ b
    obtain ⟨l, y₁, y₂, z₁, -, h1, h2, h3, -⟩ := hlift4 a₁ a₂ b b
    rw [hP _ _ l (y₁ + y₂) z₁ (by rw [map_add, h1, h2]) h3, hP _ _ l y₁ z₁ h1 h3,
      hP _ _ l y₂ z₁ h2 h3, TensorProduct.add_tmul, map_add]
  have H3 : ∀ (a : A.obj S) (b₁ b₂ : B.obj S), β a (b₁ + b₂) = β a b₁ + β a b₂ := by
    intro a b₁ b₂
    obtain ⟨l, y₁, -, z₁, z₂, h1, -, h3, h4⟩ := hlift4 a a b₁ b₂
    rw [hP _ _ l y₁ (z₁ + z₂) h1 (by rw [map_add, h3, h4]), hP _ _ l y₁ z₁ h1 h3,
      hP _ _ l y₁ z₂ h1 h4, TensorProduct.tmul_add, map_add]
  have H2 : ∀ (c : ℤ) (a : A.obj S) (b : B.obj S), β (c • a) b = c • β a b := by
    intro c a b
    obtain ⟨l, y, -, z, -, h1, -, h3, -⟩ := hlift4 a a b b
    rw [hP _ _ l (c • y) z (by rw [map_zsmul, h1]) h3, hP _ _ l y z h1 h3,
      ← TensorProduct.smul_tmul', map_zsmul]
  have H4 : ∀ (c : ℤ) (a : A.obj S) (b : B.obj S), β a (c • b) = c • β a b := by
    intro c a b
    obtain ⟨l, y, -, z, -, h1, -, h3, -⟩ := hlift4 a a b b
    rw [hP _ _ l y (c • z) h1 (by rw [map_zsmul, h3]), hP _ _ l y z h1 h3,
      TensorProduct.tmul_smul, map_zsmul]
  let Ψ : TensorProduct ℤ (A.obj S) (B.obj S) →ₗ[ℤ] C :=
    TensorProduct.lift (LinearMap.mk₂ ℤ β H1 H2 H3 H4)
  have hΨt : ∀ (a : A.obj S) (b : B.obj S), Ψ (a ⊗ₜ[ℤ] b) = β a b := by
    intro a b
    show TensorProduct.lift (LinearMap.mk₂ ℤ β H1 H2 H3 H4) (a ⊗ₜ[ℤ] b) = _
    rw [TensorProduct.lift.tmul, LinearMap.mk₂_apply]
  have hΦ : ∀ (l : Λ)
      (x : TensorProduct ℤ (A.obj (R.obj (Opposite.op l))) (B.obj (R.obj (Opposite.op l)))),
      Ψ (RT (π l) x) = ν l x := by
    intro l x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero]
    | tmul y y' =>
      rw [hRTt, hΨt]
      exact hP _ _ l y y' rfl rfl
    | add x₁ x₂ h₁ h₂ => rw [map_add, map_add, map_add, h₁, h₂]

  have hCF : ∀ {l l' : Λ} (g : l ⟶ l')
      (x : TensorProduct ℤ (A.obj (R.obj (Opposite.op l'))) (B.obj (R.obj (Opposite.op l')))),
      RT (π l) (RT (R.map g.op) x) = RT (π l') x := by
    intro l l' g x
    rw [hRTc, hπ g]
  refine ⟨?_, ?_⟩
  ·
    have merge : ∀ z₁ z₂ : TensorProduct ℤ (A.obj S) (B.obj S),
        (∃ (l : Λ) (x : TensorProduct ℤ (A.obj (R.obj (Opposite.op l))) (B.obj (R.obj (Opposite.op l)))),
          RT (π l) x = z₁) →
        (∃ (l : Λ) (x : TensorProduct ℤ (A.obj (R.obj (Opposite.op l))) (B.obj (R.obj (Opposite.op l)))),
          RT (π l) x = z₂) →
        ∃ (l : Λ) (x : TensorProduct ℤ (A.obj (R.obj (Opposite.op l))) (B.obj (R.obj (Opposite.op l)))),
          RT (π l) x = z₁ + z₂ := by
      rintro z₁ z₂ ⟨l₁, x₁, rfl⟩ ⟨l₂, x₂, rfl⟩
      refine ⟨IsCofiltered.min l₁ l₂,
        RT (R.map (IsCofiltered.minToLeft l₁ l₂).op) x₁ +
          RT (R.map (IsCofiltered.minToRight l₁ l₂).op) x₂, ?_⟩
      rw [map_add, hCF, hCF]
    have hsurj : ∀ z : TensorProduct ℤ (A.obj S) (B.obj S),
        ∃ (l : Λ) (x : TensorProduct ℤ (A.obj (R.obj (Opposite.op l))) (B.obj (R.obj (Opposite.op l)))),
          RT (π l) x = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero =>
        obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
        exact ⟨l₀, 0, map_zero _⟩
      | tmul a b =>
        exact ⟨L a b, Y a b ⊗ₜ[ℤ] Y' a b, by rw [hRTt, hY, hY']⟩
      | add z₁ z₂ h₁ h₂ => exact merge _ _ h₁ h₂
    intro y
    obtain ⟨l, x, hx⟩ := hsurj y
    exact ⟨l, x, (hRT (π l) x).trans hx⟩
  ·
    intro l x hx
    have h0 : RT (π l) x = 0 := (hRT (π l) x).symm.trans hx
    obtain ⟨l', g, hg⟩ := hKer l x (by rw [← hΦ l x, h0, map_zero])
    exact ⟨l', g, (hRT _ x).trans hg⟩

theorem wc_lpet_fin_free (Q : CommRingCat.{u} ⥤ Type w) (hQ : wcTypeFin Q) :
    wcRingFin (Q ⋙ AddCommGrpCat.free.{w}) :=
by
  classical

  have s1 : ∀ {α : Type w} (x : FreeAbelianGroup α), ∃ S : Finset α,
      x ∈ AddSubgroup.closure (FreeAbelianGroup.of '' (S : Set α)) := by
    intro α x
    refine FreeAbelianGroup.induction_on x ?_ ?_ ?_ ?_
    · exact ⟨∅, AddSubgroup.zero_mem _⟩
    · intro a
      exact ⟨{a}, AddSubgroup.subset_closure ⟨a, by simp, rfl⟩⟩
    · rintro a ⟨S, hS⟩
      exact ⟨S, AddSubgroup.neg_mem _ hS⟩
    · rintro x y ⟨S₁, h₁⟩ ⟨S₂, h₂⟩
      refine ⟨S₁ ∪ S₂, AddSubgroup.add_mem _ ?_ ?_⟩
      · exact AddSubgroup.closure_mono
          (Set.image_mono (Finset.coe_subset.mpr Finset.subset_union_left)) h₁
      · exact AddSubgroup.closure_mono
          (Set.image_mono (Finset.coe_subset.mpr Finset.subset_union_right)) h₂

  have s2 : ∀ {α β γ : Type w} (p : α → β) (h : α → γ) (S : Set α),
      (∀ a ∈ S, ∀ a' ∈ S, p a = p a' → h a = h a') →
      ∀ x ∈ AddSubgroup.closure (FreeAbelianGroup.of '' S),
        FreeAbelianGroup.map p x = 0 → FreeAbelianGroup.map h x = 0 := by
    intro α β γ p h S hph x hx hpx
    let k : β → FreeAbelianGroup γ := fun b =>
      if hb : ∃ a ∈ S, p a = b then FreeAbelianGroup.of (h (Classical.choose hb)) else 0
    have heq : Set.EqOn (FreeAbelianGroup.map h)
        ((FreeAbelianGroup.lift k).comp (FreeAbelianGroup.map p)) (FreeAbelianGroup.of '' S) := by
      rintro _ ⟨a, ha, rfl⟩
      have hb : ∃ a' ∈ S, p a' = p a := ⟨a, ha, rfl⟩
      have hspec := Classical.choose_spec hb
      rw [AddMonoidHom.comp_apply, FreeAbelianGroup.map_of_apply, FreeAbelianGroup.map_of_apply,
        FreeAbelianGroup.lift_apply_of]
      simp only [k]
      rw [dif_pos hb, hph _ hspec.1 _ ha hspec.2]
    have h1 := AddMonoidHom.eqOn_closure heq hx
    rw [h1, AddMonoidHom.comp_apply, hpx, map_zero]
  intro Λ _ _ R B π hc hS hK
  obtain ⟨SQ, KQ⟩ := hQ Λ R B π hc hS hK

  have s3 : ∀ {ι : Type w} (I : Finset ι) (l : Λ) (P : ι → ∀ l' : Λ, (l' ⟶ l) → Prop),
      (∀ i l' (g : l' ⟶ l) l'' (c : l'' ⟶ l'), P i l' g → P i l'' (c ≫ g)) →
      (∀ i ∈ I, ∃ (l' : Λ) (g : l' ⟶ l), P i l' g) →
      ∃ (l' : Λ) (g : l' ⟶ l), ∀ i ∈ I, P i l' g := by
    intro ι I l P hst
    induction I using Finset.induction_on with
    | empty => intro _; exact ⟨l, 𝟙 l, fun i hi => absurd hi (Finset.notMem_empty i)⟩
    | insert j I hj ih =>
      intro hall
      obtain ⟨l₁, g₁, h₁⟩ := ih (fun i hi => hall i (Finset.mem_insert_of_mem hi))
      obtain ⟨l₂, g₂, h₂⟩ := hall j (Finset.mem_insert_self j I)
      obtain ⟨k, c₁, c₂, e⟩ := IsCofiltered.cospan g₁ g₂
      refine ⟨k, c₁ ≫ g₁, fun i hi => ?_⟩
      rcases Finset.mem_insert.mp hi with rfl | hi
      · rw [e]; exact hst _ _ _ _ _ h₂
      · exact hst _ _ _ _ _ (h₁ i hi)

  have F2 : ∀ {m l₁ : Λ} (a : m ⟶ l₁) (x : FreeAbelianGroup (Q.obj (R.obj (Opposite.op l₁)))),
      FreeAbelianGroup.map (fun b => Q.map (π m) b)
        (FreeAbelianGroup.map (fun b => Q.map (R.map a.op) b) x) =
      FreeAbelianGroup.map (fun b => Q.map (π l₁) b) x := by
    intro m l₁ a x
    rw [← FreeAbelianGroup.map_comp_apply]
    congr 2
    funext b
    simp only [Function.comp_apply]
    rw [← hc a]
    simp
  refine ⟨fun y => ?_, fun l x hx => ?_⟩
  ·
    have SS : ∀ y : FreeAbelianGroup (Q.obj B), ∃ (l : Λ)
        (x : FreeAbelianGroup (Q.obj (R.obj (Opposite.op l)))),
        FreeAbelianGroup.map (fun a => Q.map (π l) a) x = y := by
      intro y
      refine FreeAbelianGroup.induction_on y ?_ ?_ ?_ ?_
      · obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
        exact ⟨l₀, 0, map_zero _⟩
      · intro q
        obtain ⟨l, x₀, e⟩ := SQ q
        exact ⟨l, FreeAbelianGroup.of x₀, by rw [FreeAbelianGroup.map_of_apply, e]⟩
      · rintro q ⟨l, x, e⟩
        exact ⟨l, -x, by rw [map_neg, e]⟩
      · rintro y₁ y₂ ⟨l₁, x₁, e₁⟩ ⟨l₂, x₂, e₂⟩
        refine ⟨IsCofiltered.min l₁ l₂,
          FreeAbelianGroup.map (fun a => Q.map (R.map (IsCofiltered.minToLeft l₁ l₂).op) a) x₁ +
          FreeAbelianGroup.map (fun a => Q.map (R.map (IsCofiltered.minToRight l₁ l₂).op) a) x₂,
          ?_⟩
        rw [map_add, F2, F2, e₁, e₂]
    obtain ⟨l, x, e⟩ := SS y
    exact ⟨l, x, e⟩
  ·
    have hx' : FreeAbelianGroup.map (fun a => Q.map (π l) a) x = 0 := hx
    obtain ⟨S, hxS⟩ := s1 (α := Q.obj (R.obj (Opposite.op l))) x
    obtain ⟨l', g, hg⟩ := s3 (S ×ˢ S) l
      (fun p l' g => Q.map (π l) p.1 = Q.map (π l) p.2 →
        Q.map (R.map g.op) p.1 = Q.map (R.map g.op) p.2)
      (by
        intro p l' g l'' c hp he
        have h1 := hp he
        simp only [op_comp, Functor.map_comp, types_comp_apply, h1])
      (by
        intro p _
        by_cases e : Q.map (π l) p.1 = Q.map (π l) p.2
        · obtain ⟨l', g, h⟩ := KQ l p.1 p.2 e
          exact ⟨l', g, fun _ => h⟩
        · exact ⟨l, 𝟙 l, fun e' => absurd e' e⟩)
    have hfac : ∀ a ∈ (S : Set (Q.obj (R.obj (Opposite.op l)))),
        ∀ a' ∈ (S : Set (Q.obj (R.obj (Opposite.op l)))),
        Q.map (π l) a = Q.map (π l) a' → Q.map (R.map g.op) a = Q.map (R.map g.op) a' := by
      intro a ha a' ha' he
      exact hg (a, a') (Finset.mem_product.mpr ⟨Finset.mem_coe.mp ha, Finset.mem_coe.mp ha'⟩) he
    have hfin : FreeAbelianGroup.map (fun a => Q.map (R.map g.op) a) x = 0 :=
      s2 (fun a => Q.map (π l) a) (fun a => Q.map (R.map g.op) a)
        (S : Set (Q.obj (R.obj (Opposite.op l)))) hfac x hxS hx'
    exact ⟨l', g, hfin⟩

theorem wc_lpet_fin_unitTuple (ℓ d : ℕ) :
    wcTypeFin (wcUnitTupleFun.{u} ℓ d) ∧ wcTypeFin (wcUnitTupleFun.{u} ℓ d ⋙ uliftFunctor.{u+1, u}) :=
by
  have hmain : wcTypeFin (wcUnitTupleFun.{u} ℓ d) := by
    intro Λ _ _ R B π hπ hS hK
    have hT : ∀ {l l' : Λ} (g : l ⟶ l') (r : R.obj (Opposite.op l')),
        π l (R.map g.op r) = π l' r := by
      intro l l' g r
      rw [← hπ g, CommRingCat.comp_apply]
    have hC : ∀ {l l₁ l₂ : Λ} (g₂ : l₂ ⟶ l₁) (g₁ : l₁ ⟶ l) (r : R.obj (Opposite.op l)),
        R.map (g₂ ≫ g₁).op r = R.map g₂.op (R.map g₁.op r) := by
      intro l l₁ l₂ g₂ g₁ r
      rw [op_comp, Functor.map_comp, CommRingCat.comp_apply]

    have hLift : ∀ (k : ℕ) (b : Fin k → B), ∃ (l : Λ) (r : Fin k → R.obj (Opposite.op l)),
        ∀ j, π l (r j) = b j := by
      intro k
      induction k with
      | zero =>
        intro b
        obtain ⟨l⟩ : Nonempty Λ := IsCofiltered.nonempty
        exact ⟨l, fun j => j.elim0, fun j => j.elim0⟩
      | succ k ih =>
        intro b
        obtain ⟨l₁, r₁, hr₁⟩ := ih (fun j => b j.castSucc)
        obtain ⟨l₂, r₂, hr₂⟩ := hS (b (Fin.last k))
        refine ⟨IsCofiltered.min l₁ l₂, fun j => Fin.lastCases
          (motive := fun _ => R.obj (Opposite.op (IsCofiltered.min l₁ l₂)))
          (R.map (IsCofiltered.minToRight l₁ l₂).op r₂)
          (fun j' => R.map (IsCofiltered.minToLeft l₁ l₂).op (r₁ j')) j, ?_⟩
        intro j
        refine Fin.lastCases ?_ (fun j' => ?_) j
        · simp only [Fin.lastCases_last]
          rw [hT, hr₂]
        · simp only [Fin.lastCases_castSucc]
          rw [hT]
          exact hr₁ j'

    have hKill : ∀ (l : Λ) (k : ℕ) (r : Fin k → R.obj (Opposite.op l)), (∀ j, π l (r j) = 0) →
        ∃ (l' : Λ) (g : l' ⟶ l), ∀ j, R.map g.op (r j) = 0 := by
      intro l k
      induction k with
      | zero => intro r _; exact ⟨l, 𝟙 l, fun j => j.elim0⟩
      | succ k ih =>
        intro r hr
        obtain ⟨l₁, g₁, hg₁⟩ := ih (fun j => r j.castSucc) (fun j => hr _)
        obtain ⟨l₂, g₂, hg₂⟩ := hK l₁ (R.map g₁.op (r (Fin.last k))) (by rw [hT]; exact hr _)
        refine ⟨l₂, g₂ ≫ g₁, fun j => ?_⟩
        rw [hC]
        refine Fin.lastCases ?_ (fun j' => ?_) j
        · exact hg₂
        · rw [show R.map g₁.op (r j'.castSucc) = 0 from hg₁ j', map_zero]
    refine ⟨fun y => ?_, fun l x x' hxx => ?_⟩
    · change {t : Fin d → (B : Type u)ˣ // IsUnit ((ℓ : ℕ) : B)} at y
      obtain ⟨t, hℓB⟩ := y
      obtain ⟨v, hℓv⟩ : ∃ v : B, ((ℓ : ℕ) : B) * v = 1 := by
        refine ⟨((hℓB.unit⁻¹ : Bˣ) : B), ?_⟩
        have h := hℓB.unit.mul_inv
        rwa [IsUnit.unit_spec] at h
      obtain ⟨l₁, a, ha⟩ : ∃ (l : Λ) (r : Fin d → R.obj (Opposite.op l)),
          ∀ j, π l (r j) = ((t j : Bˣ) : B) := hLift d _
      obtain ⟨l₂, a', ha'⟩ : ∃ (l : Λ) (r : Fin d → R.obj (Opposite.op l)),
          ∀ j, π l (r j) = (((t j)⁻¹ : Bˣ) : B) := hLift d _
      obtain ⟨l₃, w, hw⟩ := hS v
      obtain ⟨l₄, q₁, q₂, q₃⟩ : ∃ (l₄ : Λ) (_ : l₄ ⟶ l₁) (_ : l₄ ⟶ l₂), Nonempty (l₄ ⟶ l₃) :=
        ⟨IsCofiltered.min l₁ (IsCofiltered.min l₂ l₃), IsCofiltered.minToLeft _ _,
          IsCofiltered.minToRight _ _ ≫ IsCofiltered.minToLeft _ _,
          ⟨IsCofiltered.minToRight _ _ ≫ IsCofiltered.minToRight _ _⟩⟩
      obtain ⟨q₃⟩ := q₃
      obtain ⟨x, hx⟩ : ∃ x : Fin d → R.obj (Opposite.op l₄), ∀ i, π l₄ (x i) = ((t i : Bˣ) : B) :=
        ⟨fun i => R.map q₁.op (a i), fun i => (hT q₁ (a i)).trans (ha i)⟩
      obtain ⟨x', hx'⟩ : ∃ x' : Fin d → R.obj (Opposite.op l₄),
          ∀ i, π l₄ (x' i) = (((t i)⁻¹ : Bˣ) : B) :=
        ⟨fun i => R.map q₂.op (a' i), fun i => (hT q₂ (a' i)).trans (ha' i)⟩
      obtain ⟨w', hw'⟩ : ∃ w' : R.obj (Opposite.op l₄), π l₄ w' = v :=
        ⟨R.map q₃.op w, (hT q₃ w).trans hw⟩
      obtain ⟨l₅, g₅, hg₅⟩ := hKill l₄ d (fun i => x i * x' i - 1)
        (fun i => by
          show π l₄ (x i * x' i - 1) = 0
          rw [map_sub, map_mul, map_one, hx, hx', Units.mul_inv, sub_self])
      have hxx₅ : ∀ i, R.map g₅.op (x i) * R.map g₅.op (x' i) = 1 := by
        intro i
        have h : R.map g₅.op (x i * x' i - 1) = 0 := hg₅ i
        rw [map_sub, map_mul, map_one, sub_eq_zero] at h
        exact h
      obtain ⟨l₆, g₆, hg₆⟩ := hK l₅ (R.map g₅.op (((ℓ : ℕ) : R.obj (Opposite.op l₄)) * w' - 1))
        (by rw [hT, map_sub, map_mul, map_natCast, map_one, hw', hℓv, sub_self])
      have hℓ₆ : ((ℓ : ℕ) : R.obj (Opposite.op l₆)) * R.map g₆.op (R.map g₅.op w') = 1 := by
        simp only [map_sub, map_mul, map_natCast, map_one, sub_eq_zero] at hg₆
        exact hg₆
      have hu₁ : ∀ i, R.map g₆.op (R.map g₅.op (x i)) * R.map g₆.op (R.map g₅.op (x' i)) = 1 := by
        intro i
        rw [← map_mul, hxx₅ i, map_one]
      have hu₂ : ∀ i, R.map g₆.op (R.map g₅.op (x' i)) * R.map g₆.op (R.map g₅.op (x i)) = 1 := by
        intro i
        rw [mul_comm]
        exact hu₁ i
      let u : Fin d → (R.obj (Opposite.op l₆))ˣ := fun i =>
        ⟨R.map g₆.op (R.map g₅.op (x i)), R.map g₆.op (R.map g₅.op (x' i)), hu₁ i, hu₂ i⟩
      have hU6 : IsUnit ((ℓ : ℕ) : R.obj (Opposite.op l₆)) :=
        ⟨⟨_, _, hℓ₆, by rw [mul_comm]; exact hℓ₆⟩, rfl⟩
      refine ⟨l₆, (⟨u, hU6⟩ : {t : Fin d → (R.obj (Opposite.op l₆))ˣ //
        IsUnit ((ℓ : ℕ) : R.obj (Opposite.op l₆))}), ?_⟩
      apply Subtype.ext
      funext i
      apply Units.ext
      show π l₆ (R.map g₆.op (R.map g₅.op (x i))) = ((t i : Bˣ) : B)
      rw [hT, hT, hx]
    · change {t : Fin d → (R.obj (Opposite.op l))ˣ // IsUnit ((ℓ : ℕ) : R.obj (Opposite.op l))}
        at x x'
      have hcomp : ∀ i, π l ((x.1 i : (R.obj (Opposite.op l))ˣ) : R.obj (Opposite.op l)) =
          π l ((x'.1 i : (R.obj (Opposite.op l))ˣ) : R.obj (Opposite.op l)) := by
        intro i
        have h1 := congrArg (fun z : {t : Fin d → (B : Type u)ˣ // IsUnit ((ℓ : ℕ) : B)} =>
          ((z.1 i : Bˣ) : B)) hxx
        exact h1
      obtain ⟨l', g, hg⟩ := hKill l d
        (fun i => ((x.1 i : (R.obj (Opposite.op l))ˣ) : R.obj (Opposite.op l)) -
          ((x'.1 i : (R.obj (Opposite.op l))ˣ) : R.obj (Opposite.op l)))
        (fun i => by
          show π l (((x.1 i : (R.obj (Opposite.op l))ˣ) : R.obj (Opposite.op l)) -
            ((x'.1 i : (R.obj (Opposite.op l))ˣ) : R.obj (Opposite.op l))) = 0
          rw [map_sub, hcomp i, sub_self])
      refine ⟨l', g, ?_⟩
      apply Subtype.ext
      funext i
      apply Units.ext
      show R.map g.op ((x.1 i : (R.obj (Opposite.op l))ˣ) : R.obj (Opposite.op l)) =
        R.map g.op ((x'.1 i : (R.obj (Opposite.op l))ˣ) : R.obj (Opposite.op l))
      have h : R.map g.op (((x.1 i : (R.obj (Opposite.op l))ˣ) : R.obj (Opposite.op l)) -
          ((x'.1 i : (R.obj (Opposite.op l))ˣ) : R.obj (Opposite.op l))) = 0 := hg i
      rw [map_sub, sub_eq_zero] at h
      exact h
  refine ⟨hmain, ?_⟩
  intro Λ _ _ R B π hπ hS hK
  obtain ⟨hQS, hQK⟩ := hmain Λ R B π hπ hS hK
  refine ⟨fun y => ?_, fun l x x' hxx => ?_⟩
  · obtain ⟨l, x, hx⟩ := hQS (ULift.down y)
    exact ⟨l, ULift.up x, ULift.ext _ _ hx⟩
  · obtain ⟨l', g, hg⟩ := hQK l (ULift.down x) (ULift.down x') (congrArg ULift.down hxx)
    exact ⟨l', g, ULift.ext _ _ hg⟩

theorem wc_lpet_fin_pullback {A B C : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (f : A ⟶ C) (g : B ⟶ C)
    (hA : wcRingFin A) (hB : wcRingFin B) (hC : wcRingFin C) : wcRingFin (Limits.pullback f g) :=
by
  classical
  have hfstE : ∀ (Y : CommRingCat.{u}) (p : (Limits.pullback f g).obj Y),
      (Limits.pullback.fst (f.app Y) (g.app Y)) ((Limits.pullbackObjIso f g Y).hom p) =
        (Limits.pullback.fst f g).app Y p := by
    intro Y p
    rw [← Limits.pullbackObjIso_hom_comp_fst f g Y, comp_apply]
  have hsndE : ∀ (Y : CommRingCat.{u}) (p : (Limits.pullback f g).obj Y),
      (Limits.pullback.snd (f.app Y) (g.app Y)) ((Limits.pullbackObjIso f g Y).hom p) =
        (Limits.pullback.snd f g).app Y p := by
    intro Y p
    rw [← Limits.pullbackObjIso_hom_comp_snd f g Y, comp_apply]
  have hext : ∀ (Y : CommRingCat.{u}) (p q : (Limits.pullback f g).obj Y),
      (Limits.pullback.fst f g).app Y p = (Limits.pullback.fst f g).app Y q →
      (Limits.pullback.snd f g).app Y p = (Limits.pullback.snd f g).app Y q → p = q := by
    intro Y p q h1 h2
    have key : (Limits.pullbackObjIso f g Y).hom p = (Limits.pullbackObjIso f g Y).hom q := by
      obtain ⟨a1, b1, e1, hp⟩ := Limits.Concrete.pullbackMk_surjective (f.app Y) (g.app Y)
        ((Limits.pullbackObjIso f g Y).hom p)
      obtain ⟨a2, b2, e2, hq⟩ := Limits.Concrete.pullbackMk_surjective (f.app Y) (g.app Y)
        ((Limits.pullbackObjIso f g Y).hom q)
      have ha : a1 = a2 := by
        have h1' := hfstE Y p
        have h2' := hfstE Y q
        rw [hp, Limits.Concrete.pullbackMk_fst] at h1'
        rw [hq, Limits.Concrete.pullbackMk_fst] at h2'
        rw [h1', h2', h1]
      have hb : b1 = b2 := by
        have h1' := hsndE Y p
        have h2' := hsndE Y q
        rw [hp, Limits.Concrete.pullbackMk_snd] at h1'
        rw [hq, Limits.Concrete.pullbackMk_snd] at h2'
        rw [h1', h2', h2]
      subst ha hb
      rw [hp, hq]
    have h3 := congrArg (ConcreteCategory.hom (Limits.pullbackObjIso f g Y).inv) key
    rwa [Iso.hom_inv_id_apply, Iso.hom_inv_id_apply] at h3
  have hmk : ∀ (Y : CommRingCat.{u}) (a : A.obj Y) (b : B.obj Y), f.app Y a = g.app Y b →
      ∃ p : (Limits.pullback f g).obj Y, (Limits.pullback.fst f g).app Y p = a ∧
        (Limits.pullback.snd f g).app Y p = b := by
    intro Y a b h
    refine ⟨(Limits.pullbackObjIso f g Y).inv
      (Limits.Concrete.pullbackMk (f.app Y) (g.app Y) a b h), ?_, ?_⟩
    · rw [← comp_apply, Limits.pullbackObjIso_inv_comp_fst, Limits.Concrete.pullbackMk_fst]
    · rw [← comp_apply, Limits.pullbackObjIso_inv_comp_snd, Limits.Concrete.pullbackMk_snd]
  have hcond : ∀ (Y : CommRingCat.{u}) (p : (Limits.pullback f g).obj Y),
      f.app Y ((Limits.pullback.fst f g).app Y p) = g.app Y ((Limits.pullback.snd f g).app Y p) := by
    intro Y p
    have h := NatTrans.congr_app (Limits.pullback.condition (f := f) (g := g)) Y
    rw [NatTrans.comp_app, NatTrans.comp_app] at h
    rw [← comp_apply, h, comp_apply]
  intro Λ _ _ R X π hc hsurj hker
  obtain ⟨SA, KA⟩ := hA Λ R X π hc hsurj hker
  obtain ⟨SB, KB⟩ := hB Λ R X π hc hsurj hker
  obtain ⟨-, KC⟩ := hC Λ R X π hc hsurj hker
  have N4 : ∀ (H : CommRingCat.{u} ⥤ AddCommGrpCat.{u}) {l l' : Λ} (u : l' ⟶ l)
      (z : H.obj (R.obj (Opposite.op l))), H.map (π l') (H.map (R.map u.op) z) = H.map (π l) z := by
    intro H l l' u z
    rw [← hc u, Functor.map_comp, comp_apply]
  refine ⟨?_, ?_⟩
  · intro y
    obtain ⟨l₁, a₁, ha₁⟩ := SA ((Limits.pullback.fst f g).app X y)
    obtain ⟨l₂, b₂, hb₂⟩ := SB ((Limits.pullback.snd f g).app X y)
    obtain ⟨a, ha_def⟩ : ∃ a, a = A.map (R.map (IsCofiltered.minToLeft l₁ l₂).op) a₁ := ⟨_, rfl⟩
    obtain ⟨b, hb_def⟩ : ∃ b, b = B.map (R.map (IsCofiltered.minToRight l₁ l₂).op) b₂ := ⟨_, rfl⟩
    have ha : A.map (π (IsCofiltered.min l₁ l₂)) a = (Limits.pullback.fst f g).app X y := by
      rw [ha_def, N4, ha₁]
    have hb : B.map (π (IsCofiltered.min l₁ l₂)) b = (Limits.pullback.snd f g).app X y := by
      rw [hb_def, N4, hb₂]
    have hc0 : C.map (π (IsCofiltered.min l₁ l₂)) (f.app _ a - g.app _ b) = 0 := by
      rw [map_sub, ← NatTrans.naturality_apply, ← NatTrans.naturality_apply, ha, hb, hcond,
        sub_self]
    obtain ⟨l₄, u₃, hu₃⟩ := KC _ _ hc0
    have hcompat : f.app _ (A.map (R.map u₃.op) a) = g.app _ (B.map (R.map u₃.op) b) := by
      rw [NatTrans.naturality_apply, NatTrans.naturality_apply, ← sub_eq_zero, ← map_sub]
      exact hu₃
    obtain ⟨x, hx1, hx2⟩ := hmk _ _ _ hcompat
    refine ⟨l₄, x, hext _ _ _ ?_ ?_⟩
    · rw [NatTrans.naturality_apply, hx1, N4, ha]
    · rw [NatTrans.naturality_apply, hx2, N4, hb]
  · intro l x hx
    have hxa : A.map (π l) ((Limits.pullback.fst f g).app _ x) = 0 := by
      rw [← NatTrans.naturality_apply, hx, map_zero]
    obtain ⟨l₁, u₁, hu₁⟩ := KA l _ hxa
    have hxb : B.map (π l₁) (B.map (R.map u₁.op) ((Limits.pullback.snd f g).app _ x)) = 0 := by
      rw [N4, ← NatTrans.naturality_apply, hx, map_zero]
    obtain ⟨l₂, u₂, hu₂⟩ := KB l₁ _ hxb
    refine ⟨l₂, u₂ ≫ u₁, hext _ _ _ ?_ ?_⟩
    · rw [op_comp, Functor.map_comp, Functor.map_comp, comp_apply, NatTrans.naturality_apply,
        NatTrans.naturality_apply, hu₁, map_zero, map_zero]
    · rw [op_comp, Functor.map_comp, Functor.map_comp, comp_apply, NatTrans.naturality_apply,
        NatTrans.naturality_apply, hu₂, map_zero]

theorem wc_lpet_fin_gm : wcRingFin wcKtGm.{u} :=
by
  intro Λ _ _ R B π hπ hS hK
  have hV : ∀ {A A' : CommRingCat.{u}} (φ : A ⟶ A') (x : wcKtGm.{u}.obj A),
      (((Additive.toMul (α := (A' : Type u)ˣ) (wcKtGm.{u}.map φ x)) : (A' : Type u)ˣ) : A') =
        φ (((Additive.toMul (α := (A : Type u)ˣ) x) : (A : Type u)ˣ) : A) :=
    fun φ x => rfl
  have hE : ∀ {A : CommRingCat.{u}} (y₁ y₂ : wcKtGm.{u}.obj A),
      (((Additive.toMul (α := (A : Type u)ˣ) y₁) : (A : Type u)ˣ) : A) =
        (((Additive.toMul (α := (A : Type u)ˣ) y₂) : (A : Type u)ˣ) : A) → y₁ = y₂ := by
    intro A y₁ y₂ h
    exact Additive.toMul.injective (Units.ext h)
  have h0 : ∀ {A : CommRingCat.{u}},
      (((Additive.toMul (α := (A : Type u)ˣ) (0 : wcKtGm.{u}.obj A)) : (A : Type u)ˣ) : A) = 1 :=
    rfl
  have hT : ∀ {l l' : Λ} (g : l ⟶ l') (r : R.obj (Opposite.op l')),
      π l (R.map g.op r) = π l' r := by
    intro l l' g r
    rw [← hπ g, CommRingCat.comp_apply]
  refine ⟨fun y => ?_, fun l x hx => ?_⟩
  · obtain ⟨ζ, hζdef⟩ : ∃ ζ : (B : Type u)ˣ,
        ζ = (Additive.toMul (α := (B : Type u)ˣ) y) := ⟨_, rfl⟩
    obtain ⟨l₁, r₁, hr₁⟩ := hS (ζ : B)
    obtain ⟨l₂, r₂, hr₂⟩ := hS ((ζ⁻¹ : Bˣ) : B)
    obtain ⟨l₃, p₁, p₂⟩ : ∃ (l₃ : Λ) (_ : l₃ ⟶ l₁), Nonempty (l₃ ⟶ l₂) :=
      ⟨IsCofiltered.min l₁ l₂, IsCofiltered.minToLeft l₁ l₂, ⟨IsCofiltered.minToRight l₁ l₂⟩⟩
    obtain ⟨p₂⟩ := p₂
    obtain ⟨s₃, hs₃⟩ : ∃ s₃ : R.obj (Opposite.op l₃), π l₃ s₃ = ζ :=
      ⟨R.map p₁.op r₁, (hT p₁ r₁).trans hr₁⟩
    obtain ⟨s'₃, hs'₃⟩ : ∃ s'₃ : R.obj (Opposite.op l₃), π l₃ s'₃ = ((ζ⁻¹ : Bˣ) : B) :=
      ⟨R.map p₂.op r₂, (hT p₂ r₂).trans hr₂⟩
    obtain ⟨l₄, h₁, hh₁⟩ := hK l₃ (s₃ * s'₃ - 1)
      (by rw [map_sub, map_mul, map_one, hs₃, hs'₃, Units.mul_inv, sub_self])
    obtain ⟨s₄, s'₄, hss₄, hs₄⟩ : ∃ s₄ s'₄ : R.obj (Opposite.op l₄), s₄ * s'₄ = 1 ∧
        π l₄ s₄ = ζ := by
      refine ⟨R.map h₁.op s₃, R.map h₁.op s'₃, ?_, (hT h₁ s₃).trans hs₃⟩
      rw [map_sub, map_mul, map_one, sub_eq_zero] at hh₁
      exact hh₁
    let v : (R.obj (Opposite.op l₄))ˣ :=
      ⟨s₄, s'₄, hss₄, by rw [mul_comm]; exact hss₄⟩
    refine ⟨l₄, Additive.ofMul v, ?_⟩
    apply hE
    refine (hV (π l₄) _).trans ?_
    rw [hζdef] at hs₄
    exact hs₄
  · have ha : π l (((Additive.toMul (α := (R.obj (Opposite.op l) : Type u)ˣ) x) :
        (R.obj (Opposite.op l) : Type u)ˣ) : R.obj (Opposite.op l)) = 1 := by
      have h1 := congrArg (fun z : wcKtGm.{u}.obj B =>
        (((Additive.toMul (α := (B : Type u)ˣ) z) : (B : Type u)ˣ) : B)) hx
      simp only [hV, h0] at h1
      exact h1
    obtain ⟨l', g, hg⟩ := hK l ((((Additive.toMul (α := (R.obj (Opposite.op l) : Type u)ˣ) x) :
        (R.obj (Opposite.op l) : Type u)ˣ) : R.obj (Opposite.op l)) - 1)
        (by rw [map_sub, map_one, ha, sub_self])
    refine ⟨l', g, hE _ _ ?_⟩
    rw [hV, h0]
    rw [map_sub, map_one, sub_eq_zero] at hg
    exact hg

theorem wc_rtc_roots_fin : ∀ (m : ℕ) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (R : Λᵒᵖ ⥤ CommRingCat.{u}) (B : CommRingCat.{u}) (π : ∀ l, R.obj (Opposite.op l) ⟶ B), (∀ {l l' : Λ} (g : l ⟶ l'), R.map g.op ≫ π l = π l') → (∀ b : B, ∃ (l : Λ) (r : R.obj (Opposite.op l)), π l r = b) → (∀ (l : Λ) (r : R.obj (Opposite.op l)), π l r = 0 → ∃ (l' : Λ) (g : l' ⟶ l), R.map g.op r = 0) → (∀ y : (wcRootsFun.{u} m).obj B, ∃ (l : Λ) (x : (wcRootsFun.{u} m).obj (R.obj (Opposite.op l))), (wcRootsFun.{u} m).map (π l) x = y) ∧ (∀ (l : Λ) (x : (wcRootsFun.{u} m).obj (R.obj (Opposite.op l))), (wcRootsFun.{u} m).map (π l) x = 0 → ∃ (l' : Λ) (g : l' ⟶ l), (wcRootsFun.{u} m).map (R.map g.op) x = 0) :=
by
  intro m Λ _ _ R B π hπ hS hK
  have hV : ∀ {A A' : CommRingCat.{u}} (φ : A ⟶ A') (x : (wcRootsFun.{u} m).obj A),
      (((Additive.toMul (α := rootsOfUnity m A') ((wcRootsFun.{u} m).map φ x) :
          rootsOfUnity m A') : A'ˣ) : A') =
        φ (((Additive.toMul (α := rootsOfUnity m A) x : rootsOfUnity m A) : Aˣ) : A) :=
    fun φ x => rfl
  have hE : ∀ {A : CommRingCat.{u}} (y₁ y₂ : (wcRootsFun.{u} m).obj A),
      (((Additive.toMul (α := rootsOfUnity m A) y₁ : rootsOfUnity m A) : Aˣ) : A) =
        (((Additive.toMul (α := rootsOfUnity m A) y₂ : rootsOfUnity m A) : Aˣ) : A) → y₁ = y₂ := by
    intro A y₁ y₂ h
    exact Additive.toMul.injective (Subtype.ext (Units.ext h))
  have h0 : ∀ {A : CommRingCat.{u}},
      (((Additive.toMul (α := rootsOfUnity m A) (0 : (wcRootsFun.{u} m).obj A) :
        rootsOfUnity m A) : Aˣ) : A) = 1 := rfl
  have hT : ∀ {l l' : Λ} (g : l ⟶ l') (r : R.obj (Opposite.op l')),
      π l (R.map g.op r) = π l' r := by
    intro l l' g r
    rw [← hπ g, CommRingCat.comp_apply]
  refine ⟨fun y => ?_, fun l x hx => ?_⟩
  · obtain ⟨ζ, hζdef⟩ : ∃ ζ : (B : Type u)ˣ,
        ζ = ((Additive.toMul (α := rootsOfUnity m B) y : rootsOfUnity m B) : Bˣ) := ⟨_, rfl⟩
    have hζm : (ζ : B) ^ m = 1 := by
      rw [hζdef]
      exact (mem_rootsOfUnity' m _).mp (Additive.toMul (α := rootsOfUnity m B) y).2
    obtain ⟨l₁, r₁, hr₁⟩ := hS (ζ : B)
    obtain ⟨l₂, r₂, hr₂⟩ := hS ((ζ⁻¹ : Bˣ) : B)
    obtain ⟨l₃, p₁, p₂⟩ : ∃ (l₃ : Λ) (_ : l₃ ⟶ l₁), Nonempty (l₃ ⟶ l₂) :=
      ⟨IsCofiltered.min l₁ l₂, IsCofiltered.minToLeft l₁ l₂, ⟨IsCofiltered.minToRight l₁ l₂⟩⟩
    obtain ⟨p₂⟩ := p₂
    obtain ⟨s₃, hs₃⟩ : ∃ s₃ : R.obj (Opposite.op l₃), π l₃ s₃ = ζ :=
      ⟨R.map p₁.op r₁, (hT p₁ r₁).trans hr₁⟩
    obtain ⟨s'₃, hs'₃⟩ : ∃ s'₃ : R.obj (Opposite.op l₃), π l₃ s'₃ = ((ζ⁻¹ : Bˣ) : B) :=
      ⟨R.map p₂.op r₂, (hT p₂ r₂).trans hr₂⟩
    obtain ⟨l₄, h₁, hh₁⟩ := hK l₃ (s₃ * s'₃ - 1)
      (by rw [map_sub, map_mul, map_one, hs₃, hs'₃, Units.mul_inv, sub_self])
    obtain ⟨s₄, s'₄, hss₄, hs₄⟩ : ∃ s₄ s'₄ : R.obj (Opposite.op l₄), s₄ * s'₄ = 1 ∧
        π l₄ s₄ = ζ := by
      refine ⟨R.map h₁.op s₃, R.map h₁.op s'₃, ?_, (hT h₁ s₃).trans hs₃⟩
      rw [map_sub, map_mul, map_one, sub_eq_zero] at hh₁
      exact hh₁
    obtain ⟨l₅, h₂, hh₂⟩ := hK l₄ (s₄ ^ m - 1)
      (by rw [map_sub, map_pow, map_one, hs₄, hζm, sub_self])
    have hm₅ : (R.map h₂.op s₄) ^ m = 1 := by
      rw [map_sub, map_pow, map_one, sub_eq_zero] at hh₂
      exact hh₂
    have hss₅ : R.map h₂.op s₄ * R.map h₂.op s'₄ = 1 := by
      rw [← map_mul, hss₄, map_one]
    have hs₅ : π l₅ (R.map h₂.op s₄) = ζ := (hT h₂ s₄).trans hs₄
    let u : (R.obj (Opposite.op l₅))ˣ :=
      ⟨R.map h₂.op s₄, R.map h₂.op s'₄, hss₅, by rw [mul_comm]; exact hss₅⟩
    have hu : u ∈ rootsOfUnity m (R.obj (Opposite.op l₅)) := (mem_rootsOfUnity' m u).mpr hm₅
    refine ⟨l₅, Additive.ofMul (⟨u, hu⟩ : rootsOfUnity m (R.obj (Opposite.op l₅))), ?_⟩
    apply hE
    refine (hV (π l₅) _).trans ?_
    rw [hζdef] at hs₅
    exact hs₅
  · have ha : π l (((Additive.toMul (α := rootsOfUnity m (R.obj (Opposite.op l))) x :
        rootsOfUnity m (R.obj (Opposite.op l))) : (R.obj (Opposite.op l))ˣ) :
          R.obj (Opposite.op l)) = 1 := by
      have h1 := congrArg (fun z : (wcRootsFun.{u} m).obj B =>
        (((Additive.toMul (α := rootsOfUnity m B) z : rootsOfUnity m B) : Bˣ) : B)) hx
      simp only [hV, h0] at h1
      exact h1
    obtain ⟨l', g, hg⟩ := hK l ((((Additive.toMul (α := rootsOfUnity m (R.obj (Opposite.op l))) x :
        rootsOfUnity m (R.obj (Opposite.op l))) : (R.obj (Opposite.op l))ˣ) :
          R.obj (Opposite.op l)) - 1) (by rw [map_sub, map_one, ha, sub_self])
    refine ⟨l', g, hE _ _ ?_⟩
    rw [hV, h0]
    rw [map_sub, map_one, sub_eq_zero] at hg
    exact hg

theorem wc_rtc_twist_fin : ∀ (m dd : ℕ) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (M : Λᵒᵖ ⥤ AddCommGrpCat.{u}) (N : AddCommGrpCat.{u}) (π : ∀ l, M.obj (Opposite.op l) ⟶ N), (∀ {l l' : Λ} (g : l ⟶ l'), M.map g.op ≫ π l = π l') → (∀ n : N, ∃ (l : Λ) (x : M.obj (Opposite.op l)), π l x = n) → (∀ (l : Λ) (x : M.obj (Opposite.op l)), π l x = 0 → ∃ (l' : Λ) (g : l' ⟶ l), M.map g.op x = 0) → (∀ y : (wcTwistFun.{u} m dd).obj N, ∃ (l : Λ) (x : (wcTwistFun.{u} m dd).obj (M.obj (Opposite.op l))), (wcTwistFun.{u} m dd).map (π l) x = y) ∧ (∀ (l : Λ) (x : (wcTwistFun.{u} m dd).obj (M.obj (Opposite.op l))), (wcTwistFun.{u} m dd).map (π l) x = 0 → ∃ (l' : Λ) (g : l' ⟶ l), (wcTwistFun.{u} m dd).map (M.map g.op) x = 0) :=
by
  intro m dd Λ _ _ M N π hπ hS hK
  classical

  obtain ⟨RT, hRT, tw_tmul, hRTc⟩ : ∃ RT : ∀ {A B : AddCommGrpCat.{u}}, (A ⟶ B) →
      (TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => A)) →+
        TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => B))),
      (∀ {A B : AddCommGrpCat.{u}} (f : A ⟶ B)
        (x : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => A))),
        (wcTwistFun.{u} m dd).map f x = RT f x) ∧
      (∀ {A B : AddCommGrpCat.{u}} (f : A ⟶ B) (c : ZMod m) (y : Fin dd → A),
        RT f (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ y) = c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i => f (y i))) ∧
      (∀ {A B E : AddCommGrpCat.{u}} (f : A ⟶ B) (g : B ⟶ E)
        (x : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => A))),
        RT g (RT f x) = RT (f ≫ g) x) := by
    refine ⟨fun f => (LinearMap.lTensor (ZMod m)
      (PiTensorProduct.map (fun _ : Fin dd => f.hom.toIntLinearMap))).toAddMonoidHom,
      fun f x => rfl, ?_, ?_⟩
    · intro A B f c y
      show LinearMap.lTensor (ZMod m) (PiTensorProduct.map (fun _ : Fin dd => f.hom.toIntLinearMap))
        (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ y) = _
      rw [LinearMap.lTensor_tmul, PiTensorProduct.map_tprod]
      rfl
    · intro A B E f g x
      have h := ConcreteCategory.congr_hom ((wcTwistFun.{u} m dd).map_comp f g) x
      exact h.symm

  have hTF : ∀ {l l' : Λ} (g : l ⟶ l') (x : M.obj (Opposite.op l')), π l (M.map g.op x) = π l' x := by
    intro l l' g x
    have h := ConcreteCategory.congr_hom (hπ g) x
    rwa [CategoryTheory.comp_apply] at h

  obtain ⟨C, _, ν, hν, hKer⟩ : ∃ (C : Type u) (_ : AddCommGroup C)
      (ν : ∀ l : Λ, TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => M.obj (Opposite.op l))) →+ C),
      (∀ {l l' : Λ} (g : l ⟶ l')
        (x : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => M.obj (Opposite.op l')))),
        ν l (RT (M.map g.op) x) = ν l' x) ∧
      (∀ (l : Λ) (x : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => M.obj (Opposite.op l)))),
        ν l x = 0 → ∃ (l' : Λ) (g : l' ⟶ l), RT (M.map g.op) x = 0) := by
    let D : Λᵒᵖ ⥤ AddCommGrpCat.{u} := M ⋙ wcTwistFun.{u} m dd
    refine ⟨((Limits.colimit D : AddCommGrpCat.{u}) : Type u), inferInstance,
      fun l => (Limits.colimit.ι D (Opposite.op l)).hom, ?_, ?_⟩
    · intro l l' g x
      have h := ConcreteCategory.congr_hom (Limits.colimit.w D g.op) x
      rw [← hRT (M.map g.op) x]
      exact h
    · intro l x hx
      have h0 : ConcreteCategory.hom (Limits.colimit.ι D (Opposite.op l)) x =
          ConcreteCategory.hom (Limits.colimit.ι D (Opposite.op l)) 0 :=
        hx.trans (map_zero _).symm
      obtain ⟨k, f, f', hff⟩ := (Limits.Concrete.colimit_rep_eq_iff_exists D x 0).mp h0
      have h1 := hff.trans (map_zero _)
      refine ⟨k.unop, f.unop, ?_⟩
      rw [← hRT]
      exact h1

  have hlift : ∀ (k : ℕ) (n : Fin k → N), ∃ (l : Λ) (y : Fin k → M.obj (Opposite.op l)),
      ∀ i, π l (y i) = n i := by
    intro k
    induction k with
    | zero =>
      intro n
      obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
      exact ⟨l₀, fun i => i.elim0, fun i => i.elim0⟩
    | succ k ih =>
      intro n
      obtain ⟨l₁, y₁, hy₁⟩ := ih (Fin.init n)
      obtain ⟨l₂, x₂, hx₂⟩ := hS (n (Fin.last k))
      refine ⟨IsCofiltered.min l₁ l₂, Fin.snoc (fun i => M.map (IsCofiltered.minToLeft l₁ l₂).op (y₁ i))
        (M.map (IsCofiltered.minToRight l₁ l₂).op x₂), ?_⟩
      intro i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · simp only [Fin.snoc_last]
        rw [hTF, hx₂]
      · simp only [Fin.snoc_castSucc]
        rw [hTF, hy₁]
        rfl

  have htrans : ∀ {l l' : Λ} (g : l ⟶ l') (c : ZMod m) (y : Fin dd → M.obj (Opposite.op l')),
      ν l' (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ y) =
        ν l (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i => M.map g.op (y i))) := by
    intro l l' g c y
    rw [← hν g, tw_tmul]

  have hvan : ∀ (l : Λ) (c : ZMod m) (z : Fin dd → M.obj (Opposite.op l)) (i : Fin dd),
      π l (z i) = 0 → ν l (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ z) = 0 := by
    intro l c z i hz
    obtain ⟨l', g, hg⟩ := hK l (z i) hz
    rw [htrans g, MultilinearMap.map_coord_zero (PiTensorProduct.tprod ℤ)
      (m := fun j => M.map g.op (z j)) i hg, TensorProduct.tmul_zero, map_zero]

  have interp : ∀ {A B : Type u} [AddCommGroup A] [AddCommGroup B]
      (F : MultilinearMap ℤ (fun _ : Fin dd => A) B) (K : AddSubgroup A),
      (∀ (z : Fin dd → A) (i : Fin dd), z i ∈ K → F z = 0) →
      ∀ a b : Fin dd → A, (∀ i, a i - b i ∈ K) → F a = F b := by
    intro A B _ _ F K hF a b hab
    have key : ∀ S : Finset (Fin dd), ∀ a : Fin dd → A, (∀ i, i ∉ S → a i = b i) →
        (∀ i, a i - b i ∈ K) → F a = F b := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        intro a h _
        congr 1
        funext i
        exact h i (Finset.notMem_empty i)
      | insert j S hj ih =>
        intro a h hK'
        have h1 : F (Function.update a j (b j)) = F b := by
          apply ih
          · intro i hi
            by_cases hij : i = j
            · subst hij; simp
            · rw [Function.update_of_ne hij]
              exact h i (by simp [hij, hi])
          · intro i
            by_cases hij : i = j
            · subst hij; simp
            · rw [Function.update_of_ne hij]; exact hK' i
        have h2 : F a - F (Function.update a j (b j)) = 0 := by
          have e := F.map_update_sub a j (a j) (b j)
          rw [Function.update_eq_self] at e
          rw [← e]
          exact hF _ j (by simp [hK' j])
        rw [← h1]
        exact sub_eq_zero.mp h2
    exact key Finset.univ a (fun i hi => absurd (Finset.mem_univ i) hi) hab

  have hsame : ∀ (l : Λ) (c : ZMod m) (a b : Fin dd → M.obj (Opposite.op l)),
      (∀ i, π l (a i) = π l (b i)) →
      ν l (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ a) = ν l (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ b) := by
    intro l c a b hab
    let F : MultilinearMap ℤ (fun _ : Fin dd => M.obj (Opposite.op l)) C :=
      ((ν l).toIntLinearMap ∘ₗ TensorProduct.mk ℤ (ZMod m)
        (PiTensorProduct ℤ (fun _ : Fin dd => M.obj (Opposite.op l))) c).compMultilinearMap
        (PiTensorProduct.tprod ℤ)
    have hFv : ∀ z, F z = ν l (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ z) := fun z => rfl
    have key := interp F (π l).hom.ker
      (fun z i hz => by rw [hFv]; exact hvan l c z i (AddMonoidHom.mem_ker.mp hz)) a b
      (fun i => by
        rw [AddMonoidHom.mem_ker, map_sub]
        exact sub_eq_zero.mpr (hab i))
    exact (hFv a).symm.trans (key.trans (hFv b))

  have hind : ∀ (l l' : Λ) (c : ZMod m) (y : Fin dd → M.obj (Opposite.op l))
      (y' : Fin dd → M.obj (Opposite.op l')), (∀ i, π l (y i) = π l' (y' i)) →
      ν l (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ y) = ν l' (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ y') := by
    intro l l' c y y' h
    rw [htrans (IsCofiltered.minToLeft l l'), htrans (IsCofiltered.minToRight l l')]
    apply hsame
    intro i
    rw [hTF, hTF]
    exact h i

  choose L Y hY using hlift dd
  have hP : ∀ (n : Fin dd → N) (l : Λ) (y : Fin dd → M.obj (Opposite.op l)), (∀ i, π l (y i) = n i) →
      ∀ c : ZMod m, ν (L n) (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y n)) =
        ν l (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ y) :=
    fun n l y hy c => hind _ _ c _ _ (fun i => (hY n i).trans (hy i).symm)
  have hlift3 : ∀ (n : Fin dd → N) (a b : N), ∃ (l : Λ) (y : Fin dd → M.obj (Opposite.op l))
      (ya yb : M.obj (Opposite.op l)), (∀ i, π l (y i) = n i) ∧ π l ya = a ∧ π l yb = b := by
    intro n a b
    obtain ⟨l, w, hw⟩ := hlift (dd + 2) (Fin.snoc (Fin.snoc n a) b)
    refine ⟨l, fun i => w i.castSucc.castSucc, w (Fin.last dd).castSucc, w (Fin.last (dd + 1)),
      fun i => ?_, ?_, ?_⟩
    · rw [hw]; simp
    · rw [hw]; simp
    · rw [hw]; simp
  let μ : ZMod m → MultilinearMap ℤ (fun _ : Fin dd => N) C := fun c =>
    { toFun := fun n => ν (L n) (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y n))
      map_update_add' := by
        intro _ n i a b
        obtain ⟨l, y, ya, yb, hy, ha, hb⟩ := hlift3 n a b
        have hu : ∀ (x : M.obj (Opposite.op l)) (e : N), π l x = e →
            ∀ j, π l (Function.update y i x j) = Function.update n i e j := by
          intro x e hx j
          by_cases hj : j = i
          · subst hj; simp [hx]
          · simp [Function.update_of_ne hj, hy]
        show ν (L _) (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y _)) =
          ν (L _) (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y _)) +
            ν (L _) (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y _))
        rw [hP _ l _ (hu (ya + yb) (a + b) (by rw [map_add, ha, hb])),
          hP _ l _ (hu ya a ha), hP _ l _ (hu yb b hb),
          MultilinearMap.map_update_add, TensorProduct.tmul_add, map_add]
      map_update_smul' := by
        intro _ n i r a
        obtain ⟨l, y, ya, -, hy, ha, -⟩ := hlift3 n a a
        have hu : ∀ (x : M.obj (Opposite.op l)) (e : N), π l x = e →
            ∀ j, π l (Function.update y i x j) = Function.update n i e j := by
          intro x e hx j
          by_cases hj : j = i
          · subst hj; simp [hx]
          · simp [Function.update_of_ne hj, hy]
        show ν (L _) (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y _)) =
          r • ν (L _) (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y _))
        rw [hP _ l _ (hu (r • ya) (r • a) (by rw [map_zsmul, ha])), hP _ l _ (hu ya a ha),
          MultilinearMap.map_update_smul, TensorProduct.tmul_smul, map_zsmul] }
  have μadd : ∀ c c' : ZMod m, μ (c + c') = μ c + μ c' := by
    intro c c'
    ext n
    show ν (L n) ((c + c') ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y n)) =
      ν (L n) (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y n)) + ν (L n) (c' ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y n))
    rw [TensorProduct.add_tmul, map_add]
  have μsmul : ∀ (r : ℤ) (c : ZMod m), μ (r • c) = r • μ c := by
    intro r c
    ext n
    show ν (L n) ((r • c) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y n)) =
      r • ν (L n) (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y n))
    rw [← TensorProduct.smul_tmul', map_zsmul]
  let B : ZMod m →ₗ[ℤ] PiTensorProduct ℤ (fun _ : Fin dd => N) →ₗ[ℤ] C :=
    { toFun := fun c => PiTensorProduct.lift (μ c)
      map_add' := fun c c' => by
        show PiTensorProduct.lift (μ (c + c')) = PiTensorProduct.lift (μ c) + PiTensorProduct.lift (μ c')
        rw [μadd, map_add]
      map_smul' := fun r c => by
        show PiTensorProduct.lift (μ (r • c)) = r • PiTensorProduct.lift (μ c)
        rw [μsmul, map_smul] }
  let Φ : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => N)) →+ C :=
    (TensorProduct.lift B).toAddMonoidHom
  have hΦt : ∀ (c : ZMod m) (n : Fin dd → N), Φ (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ n) =
      ν (L n) (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (Y n)) := by
    intro c n
    show TensorProduct.lift B (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ n) = _
    refine (TensorProduct.lift.tmul _ _).trans ?_
    exact PiTensorProduct.lift.tprod (φ := μ c) n
  have hΦ : ∀ (l : Λ) (x : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => M.obj (Opposite.op l)))),
      Φ (RT (π l) x) = ν l x := by
    intro l x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero, map_zero]
    | tmul c t =>
      refine PiTensorProduct.induction_on t ?_ ?_
      · intro r y
        rw [TensorProduct.tmul_smul, map_zsmul, map_zsmul, map_zsmul, tw_tmul, hΦt]
        congr 1
        exact hP _ l y (fun i => rfl) c
      · intro t₁ t₂ h₁ h₂
        rw [TensorProduct.tmul_add, map_add, map_add, map_add, h₁, h₂]
    | add x₁ x₂ h₁ h₂ => rw [map_add, map_add, map_add, h₁, h₂]

  have hCF : ∀ {l l' : Λ} (g : l ⟶ l')
      (x : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => M.obj (Opposite.op l')))),
      RT (π l) (RT (M.map g.op) x) = RT (π l') x := by
    intro l l' g x
    rw [hRTc, hπ g]
  refine ⟨?_, ?_⟩
  ·
    have merge : ∀ z₁ z₂ : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => N)),
        (∃ (l : Λ) (x : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => M.obj (Opposite.op l)))),
          RT (π l) x = z₁) →
        (∃ (l : Λ) (x : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => M.obj (Opposite.op l)))),
          RT (π l) x = z₂) →
        ∃ (l : Λ) (x : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => M.obj (Opposite.op l)))),
          RT (π l) x = z₁ + z₂ := by
      rintro z₁ z₂ ⟨l₁, x₁, rfl⟩ ⟨l₂, x₂, rfl⟩
      refine ⟨IsCofiltered.min l₁ l₂,
        RT (M.map (IsCofiltered.minToLeft l₁ l₂).op) x₁ +
          RT (M.map (IsCofiltered.minToRight l₁ l₂).op) x₂, ?_⟩
      rw [map_add, hCF, hCF]
    have hsurj : ∀ z : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => N)),
        ∃ (l : Λ) (x : TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin dd => M.obj (Opposite.op l)))),
          RT (π l) x = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero =>
        obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
        exact ⟨l₀, 0, map_zero _⟩
      | tmul c t =>
        refine PiTensorProduct.induction_on t ?_ ?_
        · intro r n
          obtain ⟨l, y, hy⟩ := hlift dd n
          refine ⟨l, r • (c ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ y), ?_⟩
          rw [map_zsmul, tw_tmul, TensorProduct.tmul_smul]
          congr 3
          funext i
          exact hy i
        · intro t₁ t₂ h₁ h₂
          rw [TensorProduct.tmul_add]
          exact merge _ _ h₁ h₂
      | add z₁ z₂ h₁ h₂ => exact merge _ _ h₁ h₂
    intro y
    obtain ⟨l, x, hx⟩ := hsurj y
    exact ⟨l, x, (hRT (π l) x).trans hx⟩
  ·
    intro l x hx
    have h0 : RT (π l) x = 0 := (hRT (π l) x).symm.trans hx
    obtain ⟨l', g, hg⟩ := hKer l x (by rw [← hΦ l x, h0, map_zero])
    exact ⟨l', g, (hRT _ x).trans hg⟩

theorem wc_lpet_fin_roots_twist (m k : ℕ) :
    wcRingFin (wcRootsFun.{u} m) ∧ wcRingFin (wcKtT.{u} m k) :=
by
  refine ⟨fun Λ _ _ R B π hc hs hk => wc_rtc_roots_fin m Λ R B π hc hs hk, ?_⟩
  intro Λ _ _ R B π hc hs hk
  obtain ⟨hS1, hK1⟩ := wc_rtc_roots_fin m Λ R B π hc hs hk
  have hMc : ∀ {l l' : Λ} (g : l ⟶ l'),
      (R ⋙ wcRootsFun.{u} m).map g.op ≫ (wcRootsFun.{u} m).map (π l) =
        (wcRootsFun.{u} m).map (π l') := fun g =>
    ((wcRootsFun.{u} m).map_comp _ _).symm.trans (congrArg (wcRootsFun.{u} m).map (hc g))
  obtain ⟨hS2, hK2⟩ := wc_rtc_twist_fin m k Λ (R ⋙ wcRootsFun.{u} m) ((wcRootsFun.{u} m).obj B)
    (fun l => (wcRootsFun.{u} m).map (π l)) hMc hS1 hK1
  exact ⟨fun y => hS2 y, fun l x hx => hK2 l x hx⟩

theorem wc_lpet_nu_restrict (Y : Scheme.{u}) (ℓ n d : ℕ) :
    wcLpttEtNu Y ℓ n d = Functor.whiskerLeft (wcEtToProEt Y).op (wcKtNu Y ℓ n d) :=
by
  have key : ∀ (R R' : CommRingCat.{u}) (φ : R ⟶ R') (y : (wcUnitTupleFun.{u} ℓ d).obj R),
      ((wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) 0)).map φ).hom
        (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
          (FreeAbelianGroup.of y)
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) =
      TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R') (N := (wcKtT.{u} (ℓ ^ n) 0).obj R')
          (FreeAbelianGroup.of ((wcUnitTupleFun.{u} ℓ d).map φ y))
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0)) := by
    intro R R' φ y
    have h0 : ∀ (A : Type u) [AddCommGroup A] (g : Fin 0 → A),
        (PiTensorProduct.tprod ℤ g : PiTensorProduct ℤ (fun _ : Fin 0 => A)) =
          PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0) :=
      fun A _ g => congrArg _ (funext fun i => i.elim0)
    show TensorProduct.map ((wcKtZUT.{u} ℓ d).map φ).hom.toIntLinearMap
        ((wcKtT.{u} (ℓ ^ n) 0).map φ).hom.toIntLinearMap
        (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ d).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
          (FreeAbelianGroup.of y)
          ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) = _
    refine (TensorProduct.map_tmul (R := ℤ) _ _ _ _).trans ?_
    congr 1
    all_goals first
      | exact FreeAbelianGroup.map_of_apply y
      | exact FreeAbelianGroup.map_of_apply _
      | (refine (LinearMap.lTensor_tmul _ _ _ _).trans ?_
         exact congrArg _ ((PiTensorProduct.map_tprod _ _).trans (h0 _ _)))
  have key2 : ∀ (R R' : CommRingCat.{u}) (φ : R ⟶ R'),
      (wcUnitTupleFun.{u} ℓ d ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map φ ≫
        (AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun x : ULift.{u+1} ((wcUnitTupleFun.{u} ℓ d).obj R') =>
            (ULift.up (TensorProduct.tmul ℤ
              (M := (wcKtZUT.{u} ℓ d).obj R') (N := (wcKtT.{u} (ℓ ^ n) 0).obj R')
              (FreeAbelianGroup.of x.down)
              ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
              ULift.{u+1} _))) :
          (wcUnitTupleFun.{u} ℓ d ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj R' ⟶
            (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) 0) ⋙
              AddCommGrpCat.uliftFunctor.{u+1, u}).obj R') =
      (AddCommGrpCat.ofHom (FreeAbelianGroup.lift
          (fun x : ULift.{u+1} ((wcUnitTupleFun.{u} ℓ d).obj R) =>
            (ULift.up (TensorProduct.tmul ℤ
              (M := (wcKtZUT.{u} ℓ d).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
              (FreeAbelianGroup.of x.down)
              ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
              ULift.{u+1} _))) :
          (wcUnitTupleFun.{u} ℓ d ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj R ⟶
            (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) 0) ⋙
              AddCommGrpCat.uliftFunctor.{u+1, u}).obj R) ≫
        (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) 0) ⋙
          AddCommGrpCat.uliftFunctor.{u+1, u}).map φ := by
    intro R R' φ
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro x
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom,
      Functor.comp_map, AddCommGrpCat.free_map, FreeAbelianGroup.map_of_apply,
      FreeAbelianGroup.lift_apply_of]
    apply ULift.ext
    exact (key R R' φ x.down).symm
  unfold wcLpttEtNu wcKtNu wcNatOf
  split_ifs with h1 h2 h2
  · apply NatTrans.ext
    funext W
    rfl
  all_goals exfalso
  all_goals first | apply h1 | apply h2
  all_goals intro W W' f
  all_goals exact key2 _ _ _

theorem wc_lpet_free_restrict (Y : Scheme.{u}) (ℓ d : ℕ) (t : Fin d → (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    ∃ e : yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ≅
        (wcEtToProEt Y).op ⋙
          (yoneda.obj (Scheme.ProEt.mk (𝟙 Y)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free),
      e.hom ≫ Functor.whiskerLeft (wcEtToProEt Y).op
        (Functor.whiskerRight ((yonedaEquiv (X := Scheme.ProEt.mk (𝟙 Y))
          (F := (Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ d)).symm
          (Subtype.mk t hℓ : {t : Fin d → (Γ(Y, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))}))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) =
      Functor.whiskerRight ((yonedaEquiv (X := wcEtTop Y)
          (F := (Scheme.Etale.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ d)).symm
          (Subtype.mk t hℓ : {t : Fin d → (Γ(Y, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))}))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) :=
by
  have hsubP : ∀ (T : Y.ProEt) (f g : T ⟶ Scheme.ProEt.mk (𝟙 Y)), f = g :=
    fun T f g => MorphismProperty.Over.Hom.ext
      (((Category.comp_id f.left).symm.trans (MorphismProperty.Over.w f)).trans
        ((Category.comp_id g.left).symm.trans (MorphismProperty.Over.w g)).symm)
  have hsubE : ∀ (V : Y.Etale) (f g : V ⟶ wcEtTop Y), f = g :=
    fun V f g => MorphismProperty.Over.Hom.ext
      (((Category.comp_id f.left).symm.trans (MorphismProperty.Over.w f)).trans
        ((Category.comp_id g.left).symm.trans (MorphismProperty.Over.w g)).symm)
  let e₀ : yoneda.obj (wcEtTop Y) ≅ (wcEtToProEt Y).op ⋙ yoneda.obj (Scheme.ProEt.mk (𝟙 Y)) :=
    NatIso.ofComponents (fun V =>
      { hom := TypeCat.ofHom (fun f => (wcEtToProEt Y).map f)
        inv := TypeCat.ofHom (fun _ =>
          (MorphismProperty.Over.homMk V.unop.hom (Category.comp_id _) trivial :
            V.unop ⟶ wcEtTop Y))
        hom_inv_id := by ext f; exact hsubE _ _ _
        inv_hom_id := by ext g; exact hsubP _ _ _ })
      (fun g => by ext f; exact hsubP _ _ _)
  refine ⟨Functor.isoWhiskerRight e₀ (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free), ?_⟩
  apply NatTrans.ext
  funext V
  rw [NatTrans.comp_app, Functor.isoWhiskerRight_hom, Functor.whiskerRight_app,
    Functor.whiskerLeft_app, Functor.whiskerRight_app, Functor.whiskerRight_app,
    ← Functor.map_comp]
  congr 1

theorem wc_lptt_epsInv_kum_transfer (Y : Scheme.{u}) [(wcEpsInv Y).Additive]
    [Limits.PreservesFiniteLimits (wcEpsInv Y)] [Limits.PreservesFiniteColimits (wcEpsInv Y)]
    (ℓ n d : ℕ) (t : Fin d → (Γ(Y, ⊤))ˣ) (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∃ (cF : (wcEpsInv Y).obj (wcFtcFS Y (wcEtTop Y)) ≅ wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)))
      (cμ : (wcEpsInv Y).obj (wcLpttEtSh Y (wcKtT.{u} (ℓ ^ n) d)) ≅ wcRootTwist Y (ℓ ^ n) d),
      (Abelian.Ext.mk₀ cF.hom).comp
          (((Abelian.Ext.mk₀ (wcUnitTupleMap Y (Scheme.ProEt.mk (𝟙 Y)) ℓ d t hℓ)).comp
            (wcKumTuple Y ℓ n d) (zero_add d)).comp (Abelian.Ext.mk₀ cμ.inv) (add_zero d))
          (zero_add d) =
        Abelian.Ext.mapExactFunctor (wcEpsInv Y)
          ((Abelian.Ext.mk₀ (wcLpttEtUTMap Y ℓ d t hℓ)).comp (wcLpttEtKum Y ℓ n d) (zero_add d)) :=
by
  classical
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI hcont : (wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y)
      (Scheme.ProEt.topology Y) := (wc_etToProEt_flat_cont Y).2

  haveI hunitIso : IsIso (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous
      (wcEtToProEt Y) AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y)
      (Scheme.ProEt.topology Y)).unit := by
    haveI := fun G => wc_epsInv_unit_iso Y G
    exact NatIso.isIso_of_isIso_app _
  haveI hfaith : (wcEpsInv Y).Faithful :=
    (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y)
      (Scheme.ProEt.topology Y)).fullyFaithfulLOfIsIsoUnit.faithful

  let adj₁ := ((wcEtToProEt Y).op.lanAdjunction AddCommGrpCat.{u+1}).comp
    (sheafificationAdjunction (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
  let adj₂' := (sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).comp
    (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y))
  let adj₂ := adj₂'.ofNatIsoRight (Functor.sheafPushforwardContinuousCompSheafToPresheafIso
    (wcEtToProEt Y) AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y))
  let e₁ := adj₂.leftAdjointUniq adj₁

  let θ : ∀ P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
      (wcEpsInv Y).obj ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        ((wcEtToProEt Y).op ⋙ P)) ⟶
        (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P :=
    fun P => e₁.hom.app ((wcEtToProEt Y).op ⋙ P) ≫
      (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
        (((wcEtToProEt Y).op.lanAdjunction AddCommGrpCat.{u+1}).counit.app P)
  have hθ : ∀ {P P' : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : P ⟶ P'),
      (wcEpsInv Y).map ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (Functor.whiskerLeft (wcEtToProEt Y).op α)) ≫ θ P' =
      θ P ≫ (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map α := by
    intro P P' α
    have h1' : (wcEpsInv Y).map ((presheafToSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).map (Functor.whiskerLeft (wcEtToProEt Y).op α)) ≫
          e₁.hom.app ((wcEtToProEt Y).op ⋙ P') =
        e₁.hom.app ((wcEtToProEt Y).op ⋙ P) ≫
          (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
            ((wcEtToProEt Y).op.lan.map (Functor.whiskerLeft (wcEtToProEt Y).op α)) :=
      e₁.hom.naturality (Functor.whiskerLeft (wcEtToProEt Y).op α)
    have h2' : (wcEtToProEt Y).op.lan.map (Functor.whiskerLeft (wcEtToProEt Y).op α) ≫
        ((wcEtToProEt Y).op.lanAdjunction AddCommGrpCat.{u+1}).counit.app P' =
        ((wcEtToProEt Y).op.lanAdjunction AddCommGrpCat.{u+1}).counit.app P ≫ α :=
      ((wcEtToProEt Y).op.lanAdjunction AddCommGrpCat.{u+1}).counit.naturality α
    exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ _) h1').trans
      ((Category.assoc _ _ _).trans ((congrArg (_ ≫ ·)
        ((((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
          (congrArg (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map h2')).trans
          ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map_comp _ _))).trans
        (Category.assoc _ _ _).symm)))
  let cP : ∀ (P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}), wcPresFin Y P →
      ((wcEpsInv Y).obj ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        ((wcEtToProEt Y).op ⋙ P)) ≅
        (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P) :=
    fun P hP => e₁.app ((wcEtToProEt Y).op ⋙ P) ≪≫
      @asIso _ _ _ _ ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
          (((wcEtToProEt Y).op.lanAdjunction AddCommGrpCat.{u+1}).counit.app P))
        (wc_lpet_counit_iso Y P hP)

  have hcomp : ∀ {AE BE CE : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      {AP BP CP : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      (eA : (wcEpsInv Y).obj AE ≅ AP) (eB : (wcEpsInv Y).obj BE ≅ BP)
      (eC : (wcEpsInv Y).obj CE ≅ CP) {a b c : ℕ} (h : a + b = c)
      (αE : Abelian.Ext AE BE a) (βE : Abelian.Ext BE CE b)
      (αP : Abelian.Ext AP BP a) (βP : Abelian.Ext BP CP b),
      (Abelian.Ext.mapExactFunctor (wcEpsInv Y) αE).comp (Abelian.Ext.mk₀ eB.hom) (add_zero a) =
          (Abelian.Ext.mk₀ eA.hom).comp αP (zero_add a) →
      (Abelian.Ext.mapExactFunctor (wcEpsInv Y) βE).comp (Abelian.Ext.mk₀ eC.hom) (add_zero b) =
          (Abelian.Ext.mk₀ eB.hom).comp βP (zero_add b) →
      (Abelian.Ext.mapExactFunctor (wcEpsInv Y) (αE.comp βE h)).comp (Abelian.Ext.mk₀ eC.hom)
          (add_zero c) =
        (Abelian.Ext.mk₀ eA.hom).comp (αP.comp βP h) (zero_add c) := by
    intro AE BE CE AP BP CP eA eB eC a b c h αE βE αP βP hα hβ
    rw [Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.comp_assoc _ _ _ h (add_zero b) (by omega : a + b + 0 = c), hβ,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero a) (zero_add b) (by omega : a + 0 + b = c), hα,
      Abelian.Ext.comp_assoc _ _ _ (zero_add a) h (by omega : 0 + a + b = c)]
  have hmk : ∀ {AE BE : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      {AP BP : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      (eA : (wcEpsInv Y).obj AE ≅ AP) (eB : (wcEpsInv Y).obj BE ≅ BP)
      (fE : AE ⟶ BE) (fP : AP ⟶ BP),
      (wcEpsInv Y).map fE ≫ eB.hom = eA.hom ≫ fP →
      (Abelian.Ext.mapExactFunctor (wcEpsInv Y) (Abelian.Ext.mk₀ fE)).comp
          (Abelian.Ext.mk₀ eB.hom) (add_zero 0) =
        (Abelian.Ext.mk₀ eA.hom).comp (Abelian.Ext.mk₀ fP) (zero_add 0) := by
    intro AE BE AP BP eA eB fE fP h
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, h]
  have hEOM : ∀ {A B D : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (f : A ⟶ B)
      (g : B ⟶ D) (w : f ≫ g = 0) (_hS : (ShortComplex.mk f g w).ShortExact)
      {A' B' D' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (f' : A' ⟶ B')
      (g' : B' ⟶ D') (a : (wcEpsInv Y).obj A' ≅ A) (b : (wcEpsInv Y).obj B' ≅ B)
      (c : (wcEpsInv Y).obj D' ≅ D)
      (_hf : (wcEpsInv Y).map f' ≫ b.hom = a.hom ≫ f)
      (_hg : (wcEpsInv Y).map g' ≫ c.hom = b.hom ≫ g),
      (Abelian.Ext.mapExactFunctor (wcEpsInv Y) (wcExtOfMaps f' g')).comp
          (Abelian.Ext.mk₀ a.hom) (add_zero 1) =
        (Abelian.Ext.mk₀ c.hom).comp (wcExtOfMaps f g) (zero_add 1) := by
    intro A B D f g w hS A' B' D' f' g' a b c hf hg
    have w' : f' ≫ g' = 0 := by
      apply (wcEpsInv Y).map_injective
      rw [Functor.map_zero, ← cancel_mono c.hom, Functor.map_comp, Category.assoc, hg,
        ← Category.assoc, hf, Category.assoc, w, Limits.comp_zero, Limits.zero_comp]
    let φ : (ShortComplex.mk f' g' w').map (wcEpsInv Y) ≅ ShortComplex.mk f g w :=
      ShortComplex.isoMk a b c hf.symm hg.symm
    have hΦ : ((ShortComplex.mk f' g' w').map (wcEpsInv Y)).ShortExact :=
      ShortComplex.shortExact_of_iso φ.symm hS
    have hS' : (ShortComplex.mk f' g' w').ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · exact (ShortComplex.exact_map_iff_of_faithful _ (wcEpsInv Y)).mp hΦ.exact
      · exact (wcEpsInv Y).mono_of_mono_map hΦ.mono_f
      · exact (wcEpsInv Y).epi_of_epi_map hΦ.epi_g
    have e1 : wcExtOfMaps f g = hS.extClass := by
      unfold wcExtOfMaps
      rw [dif_pos w]
      exact dif_pos hS
    have e2 : wcExtOfMaps f' g' = hS'.extClass := by
      unfold wcExtOfMaps
      rw [dif_pos w']
      exact dif_pos hS'
    have key := hΦ.extClass_naturality hS φ.hom
    rw [e1, e2, Abelian.Ext.mapExactFunctor_extClass]
    exact key

  have hZUT : wcRingFin (wcKtZUT.{u} ℓ d) :=
    wc_lpet_fin_free (wcUnitTupleFun.{u} ℓ d) (wc_lpet_fin_unitTuple ℓ d).1
  have hT : ∀ k, wcRingFin (wcKtT.{u} (ℓ ^ n) k) := fun k => (wc_lpet_fin_roots_twist (ℓ ^ n) k).2
  have hμ : wcRingFin (wcRootsFun.{u} (ℓ ^ n)) := (wc_lpet_fin_roots_twist (ℓ ^ n) 0).1
  have hZG : wcRingFin (wcTensFun (wcKtZUT.{u} ℓ d) wcKtGm.{u}) :=
    wc_lpet_fin_tens _ _ hZUT wc_lpet_fin_gm
  have hZT : ∀ k, wcRingFin (wcTensFun (wcKtZUT.{u} ℓ d) (wcKtT.{u} (ℓ ^ n) k)) :=
    fun k => wc_lpet_fin_tens _ _ hZUT (hT k)
  have hZμT : ∀ k, wcRingFin (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ d) (wcRootsFun.{u} (ℓ ^ n)))
      (wcKtT.{u} (ℓ ^ n) k)) :=
    fun k => wc_lpet_fin_tens _ _ (wc_lpet_fin_tens _ _ hZUT hμ) (hT k)
  have hET : ∀ k, wcRingFin (wcTensFun (wcKtE.{u} ℓ n d k) (wcKtT.{u} (ℓ ^ n) k)) :=
    fun k => wc_lpet_fin_tens _ _
      (wc_lpet_fin_pullback (wcKtPsi.{u} ℓ d k) ((ℓ ^ n) • 𝟙 _) hZUT hZG hZG) (hT k)

  let cG : ∀ G : CommRingCat.{u} ⥤ AddCommGrpCat.{u}, wcRingFin G →
      ((wcEpsInv Y).obj (wcLpttEtSh Y G) ≅ wcKtSh Y G) :=
    fun G hG => cP (wcKtPre Y G)
      (wc_lpet_presfin_ring Y (G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) (wc_lpet_fin_ulift G hG))
  have hsq : ∀ {G G' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : G ⟶ G') (hG : wcRingFin G)
      (hG' : wcRingFin G'),
      (wcEpsInv Y).map (wcLpttEtShMap Y α) ≫ (cG G' hG').hom = (cG G hG).hom ≫ wcKtShMap Y α :=
    fun α _ _ => hθ (Functor.whiskerLeft ((Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ)
      (Functor.whiskerRight α AddCommGrpCat.uliftFunctor.{u+1, u}))
  let cUT : (wcEpsInv Y).obj (wcLpttEtUT Y ℓ d) ≅ wcUnitTuple Y ℓ d :=
    cP (wcUnitTuplePre Y ℓ d) (wc_lpet_presfin_ring Y
      ((wcUnitTupleFun.{u} ℓ d ⋙ uliftFunctor.{u+1, u}) ⋙ AddCommGrpCat.free.{u+1})
      (wc_lpet_fin_free _ (wc_lpet_fin_unitTuple ℓ d).2))
  obtain ⟨eF, heF⟩ := wc_lpet_free_restrict Y ℓ d t hℓ
  let cF : (wcEpsInv Y).obj (wcFtcFS Y (wcEtTop Y)) ≅ wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)) :=
    (wcEpsInv Y).mapIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapIso eF) ≪≫
      cP (yoneda.obj (Scheme.ProEt.mk (𝟙 Y)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
        (wc_lpet_presfin_free Y)
  let cμ : (wcEpsInv Y).obj (wcLpttEtSh Y (wcKtT.{u} (ℓ ^ n) d)) ≅ wcRootTwist Y (ℓ ^ n) d :=
    cG _ (hT d)

  have hstep : ∀ k, (Abelian.Ext.mapExactFunctor (wcEpsInv Y) (wcLpttEtStep Y ℓ n d k)).comp
        (Abelian.Ext.mk₀ (cG _ (hZT (k + 1))).hom) (add_zero 1) =
      (Abelian.Ext.mk₀ (cG _ (hZT k)).hom).comp (wcKtStep Y ℓ n d k) (zero_add 1) := by
    intro k
    obtain ⟨w, hS⟩ := wc_lpsc_kummer_ses Y ℓ n d k
    have hext := hEOM _ _ w hS
      (wcLpttEtShMap Y (wcTensNat (wcKtIotaE.{u} ℓ n d k) (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
      (wcLpttEtShMap Y (wcTensNat (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n d k ⟶ wcKtZUT.{u} ℓ d)
        (𝟙 (wcKtT.{u} (ℓ ^ n) k))))
      (cG _ (hZμT k)) (cG _ (hET k)) (cG _ (hZT k))
      (hsq _ (hZμT k) (hET k)) (hsq _ (hET k) (hZT k))
    have hrho := hmk (cG _ (hZμT k)) (cG _ (hZT (k + 1)))
      (wcLpttEtShMap Y (wcKtRho.{u} ℓ n d k)) (wcKtShMap Y (wcKtRho.{u} ℓ n d k))
      (hsq _ (hZμT k) (hZT (k + 1)))
    unfold wcKtStep wcLpttEtStep
    exact hcomp _ _ _ (add_zero 1) _ _ _ _ hext hrho
  have hchain : ∀ k : ℕ,
      (Abelian.Ext.mapExactFunctor (wcEpsInv Y) (wcLpttEtChain Y ℓ n d k)).comp
          (Abelian.Ext.mk₀ (cG _ (hZT k)).hom) (add_zero k) =
        (Abelian.Ext.mk₀ (cG _ (hZT 0)).hom).comp (wcKtChain Y ℓ n d k) (zero_add k) := by
    intro k
    induction k with
    | zero =>
      exact hmk _ _ (𝟙 _) (𝟙 _) (by
        rw [CategoryTheory.Functor.map_id, Category.id_comp, Category.comp_id])
    | succ k ih =>
      exact hcomp _ _ _ rfl _ _ _ _ ih (hstep k)
  have hnu : (wcEpsInv Y).map ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
        (wcLpttEtNu Y ℓ n d)) ≫ (cG _ (hZT 0)).hom =
      cUT.hom ≫ (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map
        (wcKtNu Y ℓ n d) := by
    rw [wc_lpet_nu_restrict]
    exact hθ (wcKtNu Y ℓ n d)
  have heps := hsq (wcKtEps.{u} ℓ n d) (hZT d) (hT d)
  have hkum : (Abelian.Ext.mapExactFunctor (wcEpsInv Y) (wcLpttEtKum Y ℓ n d)).comp
        (Abelian.Ext.mk₀ cμ.hom) (add_zero d) =
      (Abelian.Ext.mk₀ cUT.hom).comp (wcKumTuple Y ℓ n d) (zero_add d) := by
    unfold wcLpttEtKum wcKumTuple
    exact hcomp _ _ _ (zero_add d) _ _ _ _ (hmk _ _ _ _ hnu)
      (hcomp _ _ _ (add_zero d) _ _ _ _ (hchain d) (hmk _ _ _ _ heps))

  have hU : (wcEpsInv Y).map (wcLpttEtUTMap Y ℓ d t hℓ) ≫ cUT.hom =
      cF.hom ≫ wcUnitTupleMap Y (Scheme.ProEt.mk (𝟙 Y)) ℓ d t hℓ := by
    have h1 : wcLpttEtUTMap Y ℓ d t hℓ =
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map eF.hom ≫
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcEtToProEt Y).op
            (Functor.whiskerRight ((yonedaEquiv (X := Scheme.ProEt.mk (𝟙 Y))
              (F := (Scheme.ProEt.forget Y ⋙ Over.forget Y).op ⋙ Scheme.Γ ⋙
                wcUnitTupleFun.{u} ℓ d)).symm
              (Subtype.mk t hℓ : {t : Fin d → (Γ(Y, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))}))
              (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :=
      (congrArg (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map heF).symm.trans
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_comp _ _)
    have h2 := congrArg (fun k => k ≫ cUT.hom) (congrArg (wcEpsInv Y).map h1)
    refine h2.trans ?_
    refine (congrArg (fun k => k ≫ cUT.hom) ((wcEpsInv Y).map_comp _ _)).trans ?_
    refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (fun k => (wcEpsInv Y).map
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map eF.hom) ≫ k)
      (hθ _)).trans ?_
    exact (Category.assoc _ _ _).symm
  have hfin := hcomp cF cUT cμ (zero_add d) _ _ _ _
    (hmk cF cUT (wcLpttEtUTMap Y ℓ d t hℓ) (wcUnitTupleMap Y (Scheme.ProEt.mk (𝟙 Y)) ℓ d t hℓ) hU)
    hkum
  refine ⟨cF, cμ, ?_⟩
  rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add d) (add_zero d) (by omega), ← hfin,
    Abelian.Ext.comp_assoc _ _ _ (add_zero d) (zero_add 0) (by omega), Abelian.Ext.mk₀_comp_mk₀,
    Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]

theorem wc_epsInv_ext_bijective_qcqs (T : Scheme.{u}) [CompactSpace T] [QuasiSeparatedSpace T]
    [(wcEpsInv T).Additive] [Limits.PreservesFiniteLimits (wcEpsInv T)]
    [Limits.PreservesFiniteColimits (wcEpsInv T)]
    (X H : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
    (hX : Nonempty (X ≅ wcEtUnitSheaf T)) (n : ℕ) :
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
    Function.Bijective (Abelian.Ext.mapExactFunctor (wcEpsInv T) (X := X) (Y := H) (n := n)) :=
by
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨_, hcont⟩ := wc_etToProEt_flat_cont T
  haveI := hcont
  have hU := fun G' => wc_epsInv_unit_iso T G'
  have hA := wc_epsInv_affine_vanishing T

  have hfin : ∀ (I : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) [Injective I]
      (n : ℕ) (e : Abelian.Ext (wcFreeSheaf T (Scheme.ProEt.mk (𝟙 T))) ((wcEpsInv T).obj I) (n + 1)),
      e = 0 := by
    intro I _ n e
