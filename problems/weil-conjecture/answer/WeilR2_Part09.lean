theorem wc_rpc_s0_factor (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom]
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt)) :
    ∃ τ : E →ₐ[F] AlgebraicClosure F,
      s₀.left ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
        Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom τ.toRingHom) :=
by
  classical

  have s1 : ∀ (Y : Scheme.{u}) [IrreducibleSpace Y],
      Y.basicOpen (1 : Γ(Y, ⊤)) ≠ ⊥ ∧
      (∀ a b : Γ(Y, ⊤), Y.basicOpen (a * b) = ⊥ → Y.basicOpen a = ⊥ ∨ Y.basicOpen b = ⊥) ∧
      (∀ a v : Γ(Y, ⊤), Y.basicOpen a = ⊥ → IsUnit v → IsUnit (a + v)) := by
    intro Y _
    refine ⟨?_, ?_, ?_⟩
    · intro h
      rw [Scheme.basicOpen_one] at h
      obtain ⟨y⟩ := (inferInstance : Nonempty Y)
      have hy : y ∈ (⊤ : Y.Opens) := trivial
      rw [h] at hy
      simp at hy
    · intro a b hab
      by_contra hcon
      rw [not_or] at hcon
      obtain ⟨ha, hb⟩ := hcon
      rw [Scheme.basicOpen_mul] at hab
      have ha' := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp ha
      have hb' := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hb
      obtain ⟨x, hx⟩ := nonempty_preirreducible_inter (Y.basicOpen a).isOpen
        (Y.basicOpen b).isOpen ha' hb'
      have hx' : x ∈ Y.basicOpen a ⊓ Y.basicOpen b := hx
      rw [hab] at hx'
      simp at hx'
    · intro a v ha hv
      apply RingedSpace.isUnit_of_isUnit_germ Y.toRingedSpace ⊤ (a + v)
      intro y hy
      have hna : ¬ IsUnit (Y.presheaf.germ ⊤ y hy a) := by
        intro hu
        have hmem : y ∈ Y.basicOpen a := (Scheme.mem_basicOpen_top Y a y).mpr hu
        rw [ha] at hmem
        simp at hmem
      have hvu : IsUnit (Y.presheaf.germ ⊤ y hy v) := hv.map _
      have hsum : IsUnit (Y.presheaf.germ ⊤ y hy (a + v) + -(Y.presheaf.germ ⊤ y hy a)) := by
        rw [map_add]
        simpa using hvu
      rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add hsum with h1 | h1
      · exact h1
      · exact absurd (by simpa using h1.neg) hna

  have s2 : ∀ (R : Type u) [CommRing R] (N : R → Prop), N 0 → ¬ N 1 →
      (∀ a b : R, N (a * b) → N a ∨ N b) →
      (∀ a v : R, N a → IsUnit v → IsUnit (a + v)) →
      ∀ (c : AlgebraicClosure F →+* R) (φ : E →+* R),
      φ.comp (algebraMap F E) = c.comp (algebraMap F (AlgebraicClosure F)) →
      ∃ τ : E →ₐ[F] AlgebraicClosure F, φ = c.comp τ.toRingHom := by
    intro R _ N hN0 h1 hprime hNunit c φ hcomp
    let pb := Field.powerBasisOfFiniteOfSeparable F E
    have hint : IsIntegral F pb.gen := IsIntegral.of_finite F pb.gen
    have hmon : (minpoly F pb.gen).Monic := minpoly.monic hint
    have hsep : (minpoly F pb.gen).Separable := Algebra.IsSeparable.isSeparable F pb.gen
    set fK := (minpoly F pb.gen).map (algebraMap F (AlgebraicClosure F)) with hfK
    have hmonK : fK.Monic := hmon.map _
    have hsepK : fK.Separable := hsep.map
    have hsplit : fK = (fK.roots.map (fun β => Polynomial.X - Polynomial.C β)).prod :=
      (Polynomial.Splits.eq_prod_roots_of_monic (IsAlgClosed.splits fK) hmonK)
    have hnd : fK.roots.Nodup := Polynomial.nodup_roots hsepK
    have hev0 : Polynomial.eval₂ c (φ pb.gen) fK = 0 := by
      rw [hfK, Polynomial.eval₂_map, ← hcomp, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def,
        minpoly.aeval, map_zero]
    have hprod : (fK.roots.map (fun β => φ pb.gen - c β)).prod = 0 := by
      rw [← hev0]
      conv_rhs => rw [hsplit]
      rw [Polynomial.eval₂_multiset_prod, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro β _
      simp
    have hd : ∀ M : Multiset R, N M.prod → ∃ a ∈ M, N a := by
      intro M
      induction M using Multiset.induction_on with
      | empty => intro h; exact absurd (by simpa using h) h1
      | cons a M ih =>
        intro h
        rw [Multiset.prod_cons] at h
        rcases hprime _ _ h with ha | hM
        · exact ⟨a, Multiset.mem_cons_self _ _, ha⟩
        · obtain ⟨b, hb, hb'⟩ := ih hM
          exact ⟨b, Multiset.mem_cons_of_mem hb, hb'⟩
    have hunit : ∀ M : Multiset R, (∀ a ∈ M, IsUnit a) → IsUnit M.prod := by
      intro M
      induction M using Multiset.induction_on with
      | empty => intro _; simp
      | cons a M ih =>
        intro h
        rw [Multiset.prod_cons]
        exact (h a (Multiset.mem_cons_self _ _)).mul
          (ih fun b hb => h b (Multiset.mem_cons_of_mem hb))
    obtain ⟨u, hu, hunil⟩ := hd _ (by rw [hprod]; exact hN0)
    obtain ⟨β₀, hβ₀, rfl⟩ := Multiset.mem_map.mp hu
    have hP : IsUnit (((fK.roots.erase β₀).map (fun β => φ pb.gen - c β)).prod) := by
      apply hunit
      intro a ha
      obtain ⟨β, hβ, rfl⟩ := Multiset.mem_map.mp ha
      have hne : β ≠ β₀ := ((Multiset.Nodup.mem_erase_iff hnd).mp hβ).1
      have e : φ pb.gen - c β = (φ pb.gen - c β₀) + c (β₀ - β) := by rw [map_sub]; ring
      rw [e]
      exact hNunit _ _ hunil ((isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr hne.symm)).map c)
    have hu0 : φ pb.gen - c β₀ = 0 := by
      have : (fK.roots.map (fun β => φ pb.gen - c β)).prod =
          (φ pb.gen - c β₀) * ((fK.roots.erase β₀).map (fun β => φ pb.gen - c β)).prod := by
        conv_lhs => rw [← Multiset.cons_erase hβ₀]
        rw [Multiset.map_cons, Multiset.prod_cons]
      rw [hprod] at this
      exact (hP.mul_left_eq_zero).mp this.symm
    have hx : φ pb.gen = c β₀ := sub_eq_zero.mp hu0
    have hroot : Polynomial.aeval β₀ (minpoly F pb.gen) = 0 := by
      have := (Polynomial.mem_roots hmonK.ne_zero).mp hβ₀
      rw [Polynomial.IsRoot.def, hfK, Polynomial.eval_map_algebraMap] at this
      exact this
    refine ⟨pb.lift β₀ hroot, ?_⟩
    apply RingHom.ext
    intro y
    obtain ⟨p, rfl⟩ := pb.exists_eq_aeval' y
    rw [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      ← Polynomial.aeval_algHom_apply (pb.lift β₀ hroot),
      PowerBasis.lift_gen, Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.hom_eval₂,
      Polynomial.hom_eval₂, hcomp, hx]

  have s3 : ∀ (Y : Scheme.{u}) (t : Y ⟶ Spec (.of E)) (g : Y ⟶ Spec (.of (AlgebraicClosure F))),
      t ≫ Spec.map (CommRingCat.ofHom (algebraMap F E)) =
        g ≫ Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) →
      (∀ (c : AlgebraicClosure F →+* Γ(Y, ⊤)) (φ : E →+* Γ(Y, ⊤)),
        φ.comp (algebraMap F E) = c.comp (algebraMap F (AlgebraicClosure F)) →
        ∃ τ : E →ₐ[F] AlgebraicClosure F, φ = c.comp τ.toRingHom) →
      ∃ τ : E →ₐ[F] AlgebraicClosure F, t = g ≫ Spec.map (CommRingCat.ofHom τ.toRingHom) := by
    intro Y t g hw alg
    let φ : E →+* Γ(Y, ⊤) := ((Scheme.ΓSpecIso (.of E)).inv ≫ t.appTop).hom
    let c : AlgebraicClosure F →+* Γ(Y, ⊤) :=
      ((Scheme.ΓSpecIso (.of (AlgebraicClosure F))).inv ≫ g.appTop).hom
    have hcomp : φ.comp (algebraMap F E) = c.comp (algebraMap F (AlgebraicClosure F)) := by
      have h := congrArg Scheme.Hom.appTop hw
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop] at h
      have h2 := congrArg (fun z => (Scheme.ΓSpecIso (.of F)).inv ≫ z) h
      have kE := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap F E))
      have kK := Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
      have h3 : CommRingCat.ofHom (algebraMap F E) ≫ (Scheme.ΓSpecIso (.of E)).inv ≫ t.appTop =
          CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)) ≫
            (Scheme.ΓSpecIso (.of (AlgebraicClosure F))).inv ≫ g.appTop := by
        rw [← Category.assoc, kE, ← Category.assoc, kK, Category.assoc, Category.assoc]
        exact h2
      have h4 := congrArg CommRingCat.Hom.hom h3
      exact h4
    obtain ⟨τ, hτ⟩ := alg c φ hcomp
    refine ⟨τ, ?_⟩
    have key := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom τ.toRingHom)
    apply ext_of_isAffine
    rw [Scheme.Hom.comp_appTop, ← cancel_epi (Scheme.ΓSpecIso (.of E)).inv, ← Category.assoc,
      ← key, Category.assoc]
    apply CommRingCat.hom_ext
    exact hτ

  have main : ∀ (s : Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⟶
        Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))),
      s ≫ Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
        Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) →
      ∃ τ : E →ₐ[F] AlgebraicClosure F,
        s ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
          Limits.pullback.snd X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
            Spec.map (CommRingCat.ofHom τ.toRingHom) := by
    intro s hw0
    haveI : IrreducibleSpace ↥(Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) : Scheme.{u}) :=
      GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
        (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
    have ht : (s ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F E)) =
        Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) := by
      rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hw0,
        Limits.pullback.condition]
    obtain ⟨hn1, hmul, hun⟩ := s1 (Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
    exact s3 _ _ _ ht (fun c φ hc => s2 _ (fun a => Scheme.basicOpen _ a = ⊥)
      (by simp) hn1 hmul hun c φ hc)
  exact main s₀.left (MorphismProperty.Over.w s₀)

theorem wc_rpc_fibre_singleton (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (E : Type u) [Field E] [Algebra F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (τ : E →ₐ[F] AlgebraicClosure F)
    (hτ : s₀.left ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
        Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom τ.toRingHom))
    (σ : Spec (.of E) ⟶ Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
    (hσ : σ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) = 𝟙 _) :
    ∃ xb : (wcGeomPoint F X h).left, s₀.left ⁻¹' Set.range σ = {xb} :=
by
  have hcomp : Spec.map (CommRingCat.ofHom τ.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F E)) =
      Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) := by
    rw [← Spec.map_comp]
    congr 1
    ext x
    exact τ.commutes x
  have hw : s₀.left ≫ Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
      Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :=
    MorphismProperty.Over.w s₀
  have L : IsPullback s₀.left
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
      (Spec.map (CommRingCat.ofHom τ.toRingHom)) := by
    refine IsPullback.of_right ?_ hτ (IsPullback.of_hasPullback X.hom _)
    rw [hw, hcomp]
    exact IsPullback.of_hasPullback X.hom _
  have wj : (Spec.map (CommRingCat.ofHom τ.toRingHom) ≫ σ) ≫
      Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
      𝟙 _ ≫ Spec.map (CommRingCat.ofHom τ.toRingHom) := by
    rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]
  obtain ⟨j, hj1, hj2⟩ : ∃ j : Spec (.of (AlgebraicClosure F)) ⟶ (wcGeomPoint F X h).left,
      j ≫ s₀.left = Spec.map (CommRingCat.ofHom τ.toRingHom) ≫ σ ∧
      j ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) = 𝟙 _ :=
    ⟨L.lift _ _ wj, L.lift_fst _ _ wj, L.lift_snd _ _ wj⟩
  have K : IsPullback j (Spec.map (CommRingCat.ofHom τ.toRingHom)) s₀.left σ := by
    refine IsPullback.of_right ?_ hj1 L.flip
    rw [hj2]
    convert IsPullback.id_horiz (Spec.map (CommRingCat.ofHom τ.toRingHom)) using 1
    exact hσ
  have hrange : Set.range (Limits.pullback.fst s₀.left σ) = Set.range j := by
    have he : K.isoPullback.inv ≫ j = Limits.pullback.fst s₀.left σ := K.isoPullback_inv_fst
    ext x
    constructor
    · rintro ⟨z, rfl⟩
      exact ⟨K.isoPullback.inv z, by rw [← he, Scheme.Hom.comp_apply]⟩
    · rintro ⟨y, rfl⟩
      refine ⟨K.isoPullback.hom y, ?_⟩
      rw [← he, Scheme.Hom.comp_apply, Scheme.hom_inv_apply]
  have h1 : s₀.left ⁻¹' Set.range σ = Set.range j :=
    (Scheme.Pullback.range_fst s₀.left σ).symm.trans hrange
  obtain ⟨pt⟩ := (inferInstance : Nonempty (Spec (CommRingCat.of (AlgebraicClosure F))))
  refine ⟨j pt, ?_⟩
  rw [h1]
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    rw [Subsingleton.elim y pt]
    rfl
  · rintro rfl
    exact ⟨pt, rfl⟩

theorem wc_rpc_frob_fixes_s0 (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (τ : E →ₐ[F] AlgebraicClosure F)
    (hτ : s₀.left ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
        Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom τ.toRingHom))
    (t : ℕ → (wcGeomPoint F X h ⟶ wcGeomPoint F X h)) (ht0 : t 0 = 𝟙 _)
    (hts : ∀ j, t (j + 1) = wcGeomFrob F X h ≫ t j) :
    t (Module.finrank F E) ≫ s₀ = s₀ :=
by
  classical
  letI : Fintype F := Fintype.ofFinite F
  haveI : Finite E := Module.finite_of_finite F
  letI : Fintype E := Fintype.ofFinite E
  let Fr : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F :=
    @FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _
  let ρ : ℕ → (AlgebraicClosure F →+* AlgebraicClosure F) := fun j =>
    ((Fr.symm ^ j : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
      AlgebraicClosure F →+* AlgebraicClosure F)

  have hcardE : Fintype.card E = Fintype.card F ^ Module.finrank F E :=
    Module.card_eq_pow_finrank
  have hFrpow : ∀ y : AlgebraicClosure F,
      (Fr ^ Module.finrank F E) y = y ^ (Fintype.card F ^ Module.finrank F E) := by
    intro y
    rw [AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
  have hfixτ : ∀ e : E, (Fr ^ Module.finrank F E) (τ e) = τ e := by
    intro e
    rw [hFrpow, ← hcardE, ← map_pow τ, FiniteField.pow_card]
  have hsymm : Fr.symm ^ Module.finrank F E = (Fr ^ Module.finrank F E).symm := by
    rw [← AlgEquiv.aut_inv, ← AlgEquiv.aut_inv, inv_pow]
  have hring : (ρ (Module.finrank F E)).comp τ.toRingHom = τ.toRingHom := by
    ext e
    show (Fr.symm ^ Module.finrank F E) (τ e) = τ e
    rw [hsymm, AlgEquiv.symm_apply_eq, hfixτ]
  have hρ0 : ρ 0 = RingHom.id _ := by
    ext x
    show (Fr.symm ^ 0) x = x
    rw [pow_zero]
    rfl
  have hρs : ∀ j, (Fr.symm : AlgebraicClosure F →+* AlgebraicClosure F).comp (ρ j) = ρ (j + 1) := by
    intro j
    ext x
    show Fr.symm ((Fr.symm ^ j) x) = (Fr.symm ^ (j + 1)) x
    rw [pow_succ', AlgEquiv.mul_apply]

  obtain ⟨Frl, hFl, hFs⟩ : ∃ m : Limits.pullback X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⟶
      Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))),
      (wcGeomFrob F X h).left = m ∧
        m ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom (Fr.symm : AlgebraicClosure F →+* AlgebraicClosure F)) :=
    ⟨(wcGeomFrob F X h).left, rfl, Limits.pullback.lift_snd _ _ _⟩
  have hstep : ∀ (j : ℕ) (A B : Limits.pullback X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⟶
      Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))),
      A ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom (Fr.symm : AlgebraicClosure F →+* AlgebraicClosure F)) →
      B ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom (ρ j)) →
      (A ≫ B) ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom (ρ (j + 1))) := by
    intro j A B hA hB
    rw [Category.assoc, hB, ← Category.assoc, hA, Category.assoc,
      ← Spec.map_comp, ← CommRingCat.ofHom_comp, hρs]
  have hiter : ∀ j, (t j).left ≫ Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
        Spec.map (CommRingCat.ofHom (ρ j)) := by
    intro j
    induction j with
    | zero =>
      rw [ht0, hρ0, CommRingCat.ofHom_id, Spec.map_id, Category.comp_id]
      exact Category.id_comp _
    | succ j ih =>
      rw [hts j]
      exact hstep j (wcGeomFrob F X h).left (t j).left (by rw [hFl]; exact hFs) ih

  have hfinal : ∀ (T : Limits.pullback X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⟶
      Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (S : Limits.pullback X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⟶
      Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))),
      T ≫ Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) →
      T ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom (ρ (Module.finrank F E))) →
      S ≫ Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
        Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) →
      S ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
        Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom τ.toRingHom) →
      T ≫ S = S := by
    intro T S hTf hTs hSf hSs
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hSf, hTf]
    · rw [Category.assoc, hSs, ← Category.assoc, hTs, Category.assoc, ← Spec.map_comp,
        ← CommRingCat.ofHom_comp, hring]
  exact MorphismProperty.Over.Hom.ext
    (hfinal _ _ (MorphismProperty.Over.w (t (Module.finrank F E))) (hiter _)
      (MorphismProperty.Over.w s₀) hτ)

theorem wc_lfd_root_twist_torsion (S : Scheme.{u}) (m d : ℕ) :
    m • 𝟙 (wcRootTwist S m d) = 0 :=
by
  have key : ∀ (A : Type u) [AddCommGroup A]
      (x : ULift.{u+1} (TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ (fun _ : Fin d => A)))),
      m • x = 0 := by
    intro A _ x
    apply ULift.ext
    rw [ULift.smul_down, ULift.zero_down, ← Nat.cast_smul_eq_nsmul (ZMod m), ZMod.natCast_self,
      zero_smul]
  have hpre : m • 𝟙 (wcRootTwistPre S m d) = 0 := by
    apply NatTrans.ext
    funext U
    rw [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero]
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    rw [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero,
      AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
    exact key _ x
  show m • 𝟙 ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
    (wcRootTwistPre S m d)) = 0
  rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hpre,
    CategoryTheory.Functor.map_zero]

theorem wc_lfi_coker_scaled_transport (S : Scheme.{u}) (U V : S.ProEt) (ι : V ⟶ U)
    (a : U ⟶ U) (b : V ⟶ V) (hab : b ≫ ι = ι ≫ a)
    (Φ : Limits.cokernel (wcFreeSheafMap S ι) ⟶ Limits.cokernel (wcFreeSheafMap S ι))
    (hΦ : Limits.cokernel.π (wcFreeSheafMap S ι) ≫ Φ =
      wcFreeSheafMap S a ≫ Limits.cokernel.π (wcFreeSheafMap S ι))
    (M M' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (φ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj M ⟶
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj M')
    (c : ℕ) (hiso : IsIso φ)
    (hφ : ∀ W : Over U, φ.hom.app (Opposite.op (Over.mk (W.hom ≫ a))) =
      c • φ.hom.app (Opposite.op W))
    (i : ℕ) :
    ∃ Θ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) M i →+
        Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ι)) M' i,
      Function.Bijective Θ ∧
      ∀ y, c • Θ ((Abelian.Ext.mk₀ Φ).comp y (zero_add i)) =
        (Abelian.Ext.mk₀ Φ).comp (Θ y) (zero_add i) :=
by
  letI hExtD : HasExt (Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) :=
    HasExt.standard _

  have hLadj : ∃ (L : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1} ⥤
        Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (_ : L ⊣ (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U),
      L.Additive ∧ Limits.PreservesFiniteLimits L ∧ Limits.PreservesFiniteColimits L := by
    have hfinal : ∀ W : S.ProEt, ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (Over.forget U).op (Opposite.op W)), D.Final := by
      intro W
      obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
          CostructuredArrow (Over.forget U).op (Opposite.op W),
          ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op :=
        ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op),
          fun f => rfl⟩
      have key : ∀ (c : CostructuredArrow (Over.forget U).op (Opposite.op W)) (f : W ⟶ U)
          (k : c.left ⟶ Opposite.op (Over.mk f))
          (hk : (Over.forget U).op.map k ≫ (𝟙 W).op = c.hom),
          (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom ∧
            f = Quiver.Hom.unop c.hom ≫ c.left.unop.hom := by
        intro c f k hk
        have h0 : 𝟙 W ≫ (Over.forget U).map k.unop = c.hom.unop := congrArg Quiver.Hom.unop hk
        have h1 : (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom :=
          (Category.id_comp _).symm.trans h0
        refine ⟨h1, ?_⟩
        have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Over.mk f).hom :=
          Over.w k.unop
        exact hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1)
      refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
      have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
        intro f h h'
        refine (cancel_mono (eqToHom (hD f))).1 ?_
        apply CostructuredArrow.hom_ext
        apply Quiver.Hom.unop_inj
        apply Over.OverMorphism.ext
        exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
          (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
      let fc : W ⟶ U := Quiver.Hom.unop c.hom ≫ c.left.unop.hom
      obtain ⟨κc, hκc⟩ : ∃ κc : Over.mk fc ⟶ c.left.unop,
          κc.left = Quiver.Hom.unop c.hom :=
        ⟨Over.homMk (Quiver.Hom.unop c.hom) rfl, rfl⟩
      have hw : (Over.forget U).op.map κc.op ≫ (𝟙 W).op = c.hom := by
        apply Quiver.Hom.unop_inj
        exact (Category.id_comp _).trans hκc
      let φc : c ⟶ D.obj ⟨fc⟩ :=
        CostructuredArrow.homMk (f := c)
          (f' := CostructuredArrow.mk (Y := Opposite.op (Over.mk fc)) (𝟙 W).op)
          κc.op hw ≫ eqToHom (hD fc).symm
      have hto : ∀ s : StructuredArrow c D, s.right.as = fc := fun s =>
        (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left (CostructuredArrow.w _)).2
      let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
      exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
        (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
        (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))
    have lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
        Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
            (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim) := by
      intro C D _ _ L _ _ Y
      refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
      intro F₁ F₂ φ
      have hnat : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
          (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
        fun j => (L.lan.map φ).naturality j.hom
      have hfac : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
          φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
        Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
          (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
      refine (Iso.inv_comp_eq _).1 ?_
      apply Limits.colimit.hom_ext
      intro j
      have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
          (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
          φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
        calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
            = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
          _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
              (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
          _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
                (Category.assoc _ _ _).symm
          _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
          _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
              Category.assoc _ _ _
          _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
              congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
      erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
      exact key
    have lan_pfl : ∀ {C D : Type (u+1)} [Category.{u} C]
        [Category.{u} D] (L : C ⥤ D)
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
        (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
            (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim)) →
        (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
        Limits.PreservesFiniteLimits
          (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
      intro C D _ _ L _ _ hiso' hfin
      constructor
      intro J _ _
      apply Limits.preservesLimitsOfShape_of_evaluation
      intro Y
      obtain ⟨θ⟩ := hiso' Y
      obtain ⟨I, G, hG⟩ := hfin Y
      haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
        HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
          (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
      let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim :=
        Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
      exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)
    haveI hlan : Limits.PreservesFiniteLimits ((Over.forget U).op.lan :
        ((Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
      lan_pfl (Over.forget U).op (fun Y => lan_eval_iso (Over.forget U).op Y)
        (fun Y => hfinal Y.unop)
    let G := (Over.forget U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
    let F := (Over.forget U).sheafPullback AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
    let adj : F ⊣ G := (Over.forget U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
    haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
    haveI : Limits.PreservesFiniteColimits F :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits F
    haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
    haveI : G.Additive := Functor.additive_of_preserves_binary_products G
    haveI : F.Additive := adj.left_adjoint_additive
    haveI : Limits.PreservesFiniteLimits F := by
      show Limits.PreservesFiniteLimits ((Over.forget U).sheafPullback AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S))
      infer_instance
    exact ⟨F, adj, inferInstance, inferInstance, inferInstance⟩

  have hpush : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (J : GrothendieckTopology C) (K : GrothendieckTopology D) (G : C ⥤ D)
      [G.IsContinuous J K] [G.IsCocontinuous J K],
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).Additive ∧
      Limits.PreservesFiniteColimits (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) := by
    intro C D _ _ J K G _ _
    have adj := G.sheafAdjunctionCocontinuous AddCommGrpCat.{u+1} J K
    have := adj.leftAdjoint_preservesColimits.{0, 0}
    have : (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).IsLeftAdjoint := adj.isLeftAdjoint
    have := Functor.preservesZeroMorphisms_of_isLeftAdjoint
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)
    have := Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)
    exact ⟨Functor.additive_of_preservesBinaryBiproducts _,
      Limits.PreservesColimitsOfSize.preservesFiniteColimits _⟩

  have yon1 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] (T : C) (Fs : Sheaf J AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) := by
    intro C _ J _ T Fs
    let e2 : ∀ G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op T) :=
      fun G => ((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    have he2 : ∀ (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1})
        (ψ : yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 G ψ = ψ.app (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))) := by
      intro G ψ
      rfl
    let e : ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs) ≃
          Fs.obj.obj (Opposite.op T) :=
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs).trans (e2 Fs.obj)
    have he : ∀ φ, e φ = φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T)))) := by
      intro φ
      show e2 Fs.obj ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) Fs φ) = _
      rw [he2, Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    have hfun : (fun φ : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) = ⇑e :=
      funext fun φ => (he φ).symm
    rw [hfun]
    exact e.bijective
  have yon2 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasWeakSheafify J AddCommGrpCat.{u+1}] {T T' : C} (g : T ⟶ T'),
