        change ↥(Limits.pullback (O.ι ≫ V.hom) i) at z
        have h1 : V.hom (O.ι (Limits.pullback.fst (O.ι ≫ V.hom) i z)) =
            i (Limits.pullback.snd (O.ι ≫ V.hom) i z) := by
          rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition,
