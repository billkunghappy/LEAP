    rw [e, ← Abelian.Ext.mk₀_comp_mk₀_assoc, hθ']
    simp only [z, Abelian.Ext.comp_add, Abelian.Ext.mk₀_comp_mk₀_assoc]
    erw [Limits.biprod.inl_fst, Limits.biprod.inl_snd]
    rw [Abelian.Ext.mk₀_id_comp, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp, add_zero]
