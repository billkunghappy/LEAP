  have s7 : ∀ {X Z S : Scheme.{u}} (i : Z ⟶ X) (f : X ⟶ S) (W : X.Opens), (i ∣_ W).appTop.hom.comp (W.ι ≫ f).appTop.hom = ((i ⁻¹ᵁ W).ι ≫ i ≫ f).appTop.hom := by
