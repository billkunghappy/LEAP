    rw [← h3]
    exact h1.trans (Nat.cast_le.mpr hn)

  have RES : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) [IsAffine X] (χ : Ω →+* Γ(X, ⊤)),
      (∀ g : Γ(X, ⊤), χ.IsIntegralElem g) → ∀ (q : X) (z : X.residueField q),
