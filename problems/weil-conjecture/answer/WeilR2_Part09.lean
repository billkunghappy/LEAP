    rintro ⟨V⟩ x y hxy
    apply s2 V
    intro v
    by_cases hv : v ∈ Set.range (Limits.pullback.fst V.hom i)
    · obtain ⟨y0, hy0⟩ := hv
      have hR := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology Z) α
        (X := Opposite.op ((wcEtBaseChange i).obj V)) x y hxy
      obtain ⟨𝒰, h𝒰o, h𝒰, hle⟩ := (Scheme.mem_smallGrothendieckTopology _ _).1 hR
      have := h𝒰o
      have : Scheme.JointlySurjective.{u}
          (Scheme.precoverage (@Etale : MorphismProperty Scheme.{u})) :=
        Scheme.instJointlySurjectivePrecoverage
      unfold Scheme.Cover.toPresieveOverProp at hle
      have crux : ∀ {ι : Type u} (X' : ι → Z.Etale)
          (f' : ∀ j, X' j ⟶ (wcEtBaseChange i).obj V),
          Presieve.ofArrows X' f' ≤ (Presheaf.equalizerSieve (F := P)
            (X := Opposite.op ((wcEtBaseChange i).obj V)) x y).arrows →
          ∀ (k : ι), Etale (f' k).left → ∀ z : (X' k).left, (f' k).left z = y0 →
          ∃ (V' : Y.Etale) (e : V' ⟶ V),
