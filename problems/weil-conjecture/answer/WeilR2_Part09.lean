theorem wc_smooth_closed_reldim_cases : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n e : ℕ) [SmoothOfRelativeDimension n fX] (Z : Scheme.{u}) (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension e (i ≫ fX)], (n < e → IsEmpty Z) ∧ (e = n → IsOpen (Set.range i)) :=
by
  intro K _ _ X fX n e _ Z i _ _
  refine ⟨fun hne => ?_, fun heq => ?_⟩
  · rw [← not_nonempty_iff]
    intro hZ
    haveI : Smooth (i ≫ fX) := SmoothOfRelativeDimension.smooth e (i ≫ fX)
    haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian (i ≫ fX)

    have hW : ∃ W : Z.Opens, IrreducibleSpace W.toScheme := by
      obtain ⟨z⟩ := hZ
      obtain ⟨R, f, hf, hz, -⟩ :=
        Scheme.exists_affine_mem_range_and_range_subset (X := Z) (U := ⊤) (x := z) trivial
      let U : Z.Opens := f.opensRange
      have hU : IsAffineOpen U := isAffineOpen_opensRange f
      have hzU : z ∈ U := by
        show z ∈ (f.opensRange : Set Z)
        rw [Scheme.Hom.coe_opensRange]; exact hz
      haveI : IsNoetherianRing Γ(Z, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
      have hNS := noetherianSpace_of_isAffineOpen U hU
      let p : U := ⟨z, hzU⟩
      obtain ⟨o, ho, hne', hoC⟩ :=
        @TopologicalSpace.NoetherianSpace.exists_isOpen_nonempty_subset_irreducibleComponent _ _ hNS
          (irreducibleComponent p) (irreducibleComponent_mem_irreducibleComponents p)
      have hoIrr : IsIrreducible o :=
        ⟨hne', isIrreducible_irreducibleComponent.isPreirreducible.open_subset ho hoC⟩
      have hSopen : IsOpen (Subtype.val '' o : Set Z) := U.isOpen.isOpenMap_subtype_val o ho
      have hSirr : IsIrreducible (Subtype.val '' o : Set Z) :=
        hoIrr.image Subtype.val continuous_subtype_val.continuousOn
      exact ⟨⟨_, hSopen⟩, Subtype.irreducibleSpace hSirr⟩
    obtain ⟨W, hWirr⟩ := hW
    haveI : SmoothOfRelativeDimension e (W.ι ≫ i ≫ fX) := by
      have := smoothOfRelativeDimension_comp 0 e W.ι (i ≫ fX)
      simpa using this
    have h1 : (e : WithBot ℕ∞) ≤ topologicalKrullDim W.toScheme :=
      wc_smooth_irreducible_dim_ge K W.toScheme (W.ι ≫ i ≫ fX) e
    have h2 : topologicalKrullDim W.toScheme ≤ topologicalKrullDim X :=
      Topology.IsInducing.topologicalKrullDim_le
        (i.isClosedEmbedding.isInducing.comp W.ι.isOpenEmbedding.isInducing)
    have h3 : topologicalKrullDim X ≤ (n : WithBot ℕ∞) := wc_smooth_alg_closed_dim_le K X fX n
    have h4 : (e : WithBot ℕ∞) ≤ (n : WithBot ℕ∞) := h1.trans (h2.trans h3)
    have h5 : e ≤ n := by exact_mod_cast h4
    omega
  · subst heq
    haveI : Etale i :=
      wc_etale_of_unramified_smooth_same_reldim i fX e inferInstance inferInstance inferInstance
    exact i.isOpenMap.isOpen_range

theorem wc_et_zmod_modules_zero_of_isEmpty : ∀ (Z : Scheme.{u}) (ℓ : ℕ), IsEmpty Z → ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Z ℓ)), Limits.IsZero M :=
by
  intro Z ℓ hZ M
  have hSub : ∀ V : Z.Etale, Subsingleton ↑(((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj
      M).obj.obj (Opposite.op V)) := by
    intro V
    haveI hE : IsEmpty ↥V.left := ⟨fun x => hZ.false (V.hom x)⟩
    have hBot : (⊥ : Sieve V) ∈ Scheme.smallEtaleTopology Z V :=
      (congrArg (fun J : GrothendieckTopology Z.Etale => (⊥ : Sieve V) ∈ J V)
        (@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
          Z MorphismProperty.IsMultiplicative.toIsStableUnderComposition
          _ _ _ _ le_rfl)).mpr
        ((@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _
          V (⊥ : Sieve V)).2 (fun x => isEmptyElim x))
    exact AddCommGrpCat.subsingleton_of_isZero
      (Sheaf.isTerminalOfBotCover ((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj M) _ hBot).isZero
  rw [Limits.IsZero.iff_id_eq_zero]
  apply (SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).map_injective
  rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
  first
    | (ext V x; exact @Subsingleton.elim _ (hSub V.unop) _ _)
    | (apply Sheaf.hom_ext; ext V x; exact @Subsingleton.elim _ (hSub V.unop) _ _)
    | (apply ObjectProperty.hom_ext; ext V x; exact @Subsingleton.elim _ (hSub V.unop) _ _)
    | (apply Sheaf.hom_ext; apply NatTrans.ext; funext V; apply AddCommGrpCat.ext; intro x;
       exact @Subsingleton.elim _ (hSub V.unop) _ _)
    | (apply Sheaf.Hom.ext; apply NatTrans.ext; funext V; apply AddCommGrpCat.ext; intro x;
       exact @Subsingleton.elim _ (hSub V.unop) _ _)

theorem wc_et_closed_push_modules_full_faithful : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (ℓ : ℕ) (D : wcEtPullData i ℓ), (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).Full ∧ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).Faithful :=
by
  intro X Z i _ ℓ D
  obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint i
  haveI : IsIso adj.counit := (wc_et_closed_push_adj_isos i L adj).1
  have hPush : (wcEtPush i).FullyFaithful := adj.fullyFaithfulROfIsIsoCounit
  haveI hPf : (wcEtPush i).Full := hPush.full
  haveI hPft : (wcEtPush i).Faithful := hPush.faithful
  obtain ⟨α, hinj, hsurj, -⟩ := wc_et_zmod_ring_locbij Z ℓ
  haveI hTf : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Z ℓ)).Full :=
    (sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Z) (wcEtZModRing Z ℓ) ℓ α
      hinj hsurj).1
  haveI hCf : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Z ℓ) ⋙ wcEtPush i).Full :=
    Functor.Full.comp _ _
  haveI hCft : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Z ℓ) ⋙ wcEtPush i).Faithful :=
    Functor.Faithful.comp _ _
  obtain ⟨e⟩ := wc_et_toSheaf_pushforward_iso i ℓ D
  haveI h1 := Functor.Full.of_iso e.symm
  haveI h2 := Functor.Faithful.of_iso e.symm
  exact ⟨Functor.Full.of_comp_faithful _ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing X ℓ)),
    Functor.Faithful.of_comp _ (SheafOfModules.toSheaf.{u+1} (wcEtZModRing X ℓ))⟩

theorem wc_et_open_pull_closed_push_isZero : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) (ℓ : ℕ) (V : X.Opens), (V : Set X) = (Set.range i)ᶜ → ∀ (D : wcEtPullData i ℓ) (Dj : wcEtPullData V.ι ℓ) (M : SheafOfModules.{u+1} (wcEtZModRing Z ℓ)), Limits.IsZero (Dj.Φ.obj ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj M)) :=
by
  intro X Z i ℓ V hV D Dj M

  have slice_cont : ∀ {S : Scheme.{u}} (T : S.Etale),
      (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology S) := by
    intro S T
    haveI hT : Etale T.hom := T.prop
    have hSurj : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Y V →
        ∀ y : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
      intro Y V R hR y
      change R ∈ Scheme.smallGrothendieckTopology @Etale Y V at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
      exact ⟨V₁, c, w, hc, hw⟩
    have hCov : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V R hR
      change R ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hR x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : CoverPreserving (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S)
        (wcEtSlice T) := by
      refine CoverPreserving.mk (fun {V} {R} hR => ?_)
      apply hCov
      intro v
      obtain ⟨V₁, c, w, hc, hw⟩ := hSurj T.left V R hR v
      exact ⟨(wcEtSlice T).obj V₁, (wcEtSlice T).map c, ⟨V₁, c, 𝟙 _, hc, (Category.id_comp _).symm⟩,
        ⟨w, hw⟩⟩
    have hcomp : CompatiblePreserving.{u+1} (Scheme.smallEtaleTopology S) (wcEtSlice T) := by
      apply CompatiblePreserving.mk
      intro ℱ Z T' x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      have hw : (f₁.left ≫ Y₁.hom) ≫ T.hom = X.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
      haveI : Etale ((f₁.left ≫ Y₁.hom) ≫ T.hom) := hw ▸ X.prop
      haveI : Etale (f₁.left ≫ Y₁.hom) := Etale.of_comp _ T.hom
      let X' : T.left.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) ‹_›
      have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun k => k.left) hfg
      have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
        have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
        have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
        calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
              (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
          _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
          _ = f₁.left ≫ Y₁.hom :=
              (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
      let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
      let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
      let e : X ⟶ (wcEtSlice T).obj X' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
      have hf₁ : f₁ = e ≫ (wcEtSlice T).map f₁' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hf₂ : f₂ = e ≫ (wcEtSlice T).map f₂' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
        apply MorphismProperty.Over.Hom.ext
        exact hleft
      have hc := hx f₁' f₂' hg₁ hg₂ hsq
      rw [hf₁, hf₂]
      simp only [Functor.map_comp, op_comp]
      rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
      exact congrArg _ hc
    exact Functor.isContinuous_of_coverPreserving hcomp hcov

  have gen : ∀ {X : Scheme.{u}} (T : X.Etale) (n : ℕ)
      (E : wcEtPullData (S := X) (S' := T.left) T.hom n)
      [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)],
      ∃ ψ : wcEtZModRing T.left n ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X n),
        Nonempty (E.Φ ≅ SheafOfModules.pushforward.{u+1} ψ) := by
    intro X T n E hF
    have key : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod n) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod n →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    have s1 : ∀ {Y : Scheme.{u}} (Q : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1}),
        Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) Q →
        ∀ (a b : (wcEtZModRing Y n).obj ⟶ Q), a = b := by
      intro Y Q hQ a b
      apply sheafify_hom_ext (Scheme.smallEtaleTopology Y) _ _ hQ
      apply NatTrans.ext
      funext V
      apply RingCat.hom_ext
      exact key _ _
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) T.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u})
        T.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong T.hom)) (@Etale : MorphismProperty Scheme.{u})
    letI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have adj : wcEtSlice T ⊣ wcEtBaseChange T.hom :=
      @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ (@Etale : MorphismProperty Scheme.{u}) ⊤ _
        T.left X _ _ T.hom _ _ _ T.prop trivial
    haveI hG := E.cont
    let α : (Functor.const (T.left.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtSlice T).op ⋙ (wcEtZModRing X n).obj :=
      Functor.whiskerLeft (wcEtSlice T).op (toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))))
    let ψ : wcEtZModRing T.left n ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X n) :=
      ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology T.left) α
        (Functor.op_comp_isSheaf (wcEtSlice T) (Scheme.smallEtaleTopology T.left)
          (Scheme.smallEtaleTopology X) (wcEtZModRing X n)))
    haveI hGF : (wcEtBaseChange T.hom ⋙ wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology X) :=
      Functor.isContinuous_comp (wcEtBaseChange T.hom) (wcEtSlice T) (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
    have H1 : Functor.whiskerRight (NatTrans.op adj.counit) (wcEtZModRing X n).obj =
        E.φ.hom ≫ (wcEtBaseChange T.hom).op.whiskerLeft ψ.hom :=
      s1 (Y := X) _ (Functor.op_comp_isSheaf (wcEtBaseChange T.hom ⋙ wcEtSlice T)
        (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology X) (wcEtZModRing X n)) _ _
    have H2 : ψ.hom ≫ (wcEtSlice T).op.whiskerLeft E.φ.hom ≫
        Functor.whiskerRight (NatTrans.op adj.unit) (wcEtZModRing T.left n).obj =
        𝟙 (wcEtZModRing T.left n).obj :=
      s1 (Y := T.left) _ (wcEtZModRing T.left n).cond _ _
    exact ⟨ψ, ⟨Adjunction.leftAdjointUniq E.adj
      (@SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hF E.cont adj ψ E.φ H1 H2)⟩⟩
  haveI hc := slice_cont
    (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) : X.Etale)
  haveI hc' : (wcEtSlice (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) :
      X.Etale)).IsContinuous (Scheme.smallEtaleTopology (V : Scheme.{u}))
        (Scheme.smallEtaleTopology X) := hc
  obtain ⟨ψ, ⟨e⟩⟩ : ∃ φ : wcEtZModRing (V : Scheme.{u}) ℓ ⟶
      ((wcEtSlice (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) :
        X.Etale)).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology (V : Scheme.{u})) (Scheme.smallEtaleTopology X)).obj
          (wcEtZModRing X ℓ),
      Nonempty (Dj.Φ ≅ SheafOfModules.pushforward.{u+1}
        (F := wcEtSlice (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) :
          X.Etale)) φ) :=
    @gen X (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι)) ℓ Dj hc
  refine Limits.IsZero.of_iso ?_ (e.app _)
  have hSubGen : ∀ B : Z.Etale, IsEmpty B.left →
      Subsingleton ↑(((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj M).obj.obj
        (Opposite.op B)) := by
    intro B hE
    have hBot : (⊥ : Sieve B) ∈ Scheme.smallEtaleTopology Z B :=
      (congrArg (fun J : GrothendieckTopology Z.Etale => (⊥ : Sieve B) ∈ J B)
        (@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
          Z MorphismProperty.IsMultiplicative.toIsStableUnderComposition
          _ _ _ _ le_rfl)).mpr
        ((@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _
          B (⊥ : Sieve B)).2
            (fun x => isEmptyElim x))
    exact AddCommGrpCat.subsingleton_of_isZero
      (Sheaf.isTerminalOfBotCover ((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj M) _
        hBot).isZero
  have hSub : ∀ W : (V : Scheme.{u}).Etale, Subsingleton ↑(((SheafOfModules.toSheaf
      (wcEtZModRing Z ℓ)).obj M).obj.obj (Opposite.op ((wcEtBaseChange i).obj
        ((wcEtSlice (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) :
          X.Etale)).obj W)))) := by
    intro W
    have hEmpty : IsEmpty ↥(Limits.pullback (W.hom ≫ V.ι) i) :=
      Scheme.isEmpty_pullback (W.hom ≫ V.ι) i (Set.disjoint_left.2 (by
        rintro _ ⟨w, rfl⟩
        have h1 : (W.hom ≫ V.ι) w ∈ (V : Set X) := by
          rw [← Scheme.Opens.range_ι V]
          exact ⟨W.hom w, rfl⟩
        rw [hV] at h1
        exact h1))
    exact hSubGen _ hEmpty
  refine (Limits.IsZero.iff_id_eq_zero _).2 ?_
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro U
  haveI := hSub U.unop
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  exact @Subsingleton.elim _ (hSub U.unop) _ _

theorem wc_et_zmod_toSheaf_nsmul_zero : ∀ (Y : Scheme.{u}) (ℓ : ℕ) (G : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)), ℓ • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj G) = 0 :=
by
  intro Y ℓ G
  have hR : ∀ V, ((ℓ : ℕ) : ↑((wcEtZModRing Y ℓ).obj.obj V)) = 0 := by
    intro V
    have h := map_natCast ((toSheafify (Scheme.smallEtaleTopology Y)
      ((Functor.const _).obj (RingCat.of (ULift.{u+1} (ZMod ℓ))))).app V).hom ℓ
    have h0 : ((ℓ : ℕ) : ULift.{u+1} (ZMod ℓ)) = 0 := by
      apply ULift.ext
      simp
    rw [h0, map_zero] at h
    exact h.symm
  apply (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_injective
  rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Functor.map_zero]
  ext V x
  simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
    AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply,
    AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
  have key : ∀ y : ↑(G.val.obj V), ℓ • y = 0 := by
    intro y
    rw [← Nat.cast_smul_eq_nsmul (↑((wcEtZModRing Y ℓ).obj.obj V)), hR V, zero_smul]
  exact key x

theorem wc_et_closed_push_essImage_of_open_pull_isZero : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (ℓ : ℕ) (V : X.Opens), (V : Set X) = (Set.range i)ᶜ → ∀ (D : wcEtPullData i ℓ) (Dj : wcEtPullData V.ι ℓ) (K : SheafOfModules.{u+1} (wcEtZModRing X ℓ)), Limits.IsZero (Dj.Φ.obj K) → ∃ M : SheafOfModules.{u+1} (wcEtZModRing Z ℓ), Nonempty ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj M ≅ K) :=
by
  intro X Z i _ ℓ V hV D Dj K hK

  have hvo : ∀ (W : X.Etale) (s : ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K).obj.obj
      (Opposite.op W)) (w : W.left), W.hom w ∉ Set.range i → ∃ (W₁ : X.Etale) (c : W₁ ⟶ W),
      w ∈ Set.range c.left ∧ ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K).obj.map c.op s = 0 := by
    intro W s w hw
    haveI hc := (wc_et_slice_continuous
      (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) : X.Etale)).1
    obtain ⟨φ, ⟨e⟩⟩ := @wc_et_open_pull_data_restr_iso _ V ℓ Dj hc
    have hQ := Limits.IsZero.of_iso hK (e.app K).symm
    haveI : Etale W.hom := W.prop
    let W' : (V : Scheme.{u}).Etale := MorphismProperty.Over.mk ⊤ (W.hom ∣_ V) inferInstance
    haveI hsub : Subsingleton ↑(((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K).obj.obj
        (Opposite.op ((wcEtSlice (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) :
          X.Etale)).obj W'))) := by
      have h1 := Functor.map_isZero (SheafOfModules.toSheaf (wcEtZModRing (V : Scheme.{u}) ℓ) ⋙
        sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (Opposite.op W')) hQ
      exact AddCommGrpCat.subsingleton_of_isZero h1
    have hcomm : (W.hom ⁻¹ᵁ V).ι ≫ W.hom =
        ((wcEtSlice (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) :
          X.Etale)).obj W').hom := (morphismRestrict_ι W.hom V).symm
    let c : (wcEtSlice (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι) :
        X.Etale)).obj W' ⟶ W := MorphismProperty.Over.homMk (W.hom ⁻¹ᵁ V).ι hcomm trivial
    refine ⟨_, c, ?_, Subsingleton.elim _ _⟩
    have hwO : w ∈ W.hom ⁻¹ᵁ V := by
      rw [Scheme.Hom.mem_preimage]
      show W.hom w ∈ (V : Set X)
      rw [hV]
      exact hw
    show w ∈ Set.range (W.hom ⁻¹ᵁ V).ι
    rw [Scheme.Opens.range_ι]
    exact hwO

  obtain ⟨L, ⟨adjL⟩, -, -⟩ := wc_et_push_left_adjoint i
  obtain ⟨hcounit, hunit⟩ := wc_et_closed_push_adj_isos i L adjL
  have hiso : IsIso (adjL.unit.app ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K)) :=
    hunit _ hvo
  haveI := hcounit
  let u : (SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K ≅
      (wcEtPush i).obj (L.obj ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K)) :=
    @asIso _ _ _ _ (adjL.unit.app ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K)) hiso
  haveI hfaith : (wcEtPush i).Faithful := adjL.fullyFaithfulROfIsIsoCounit.faithful
  have hH : ℓ • 𝟙 (L.obj ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K)) = 0 := by
    apply (wcEtPush i).map_injective
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero]
    have hG := wc_et_zmod_toSheaf_nsmul_zero X ℓ K
    calc ℓ • 𝟙 ((wcEtPush i).obj (L.obj ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K)))
        = u.inv ≫ (ℓ • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K)) ≫ u.hom := by
          rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Iso.inv_hom_id]
      _ = 0 := by rw [hG, Limits.zero_comp, Limits.comp_zero]
  obtain ⟨αZ, hiZ, hsZ, -⟩ := wc_et_zmod_ring_locbij Z ℓ
  obtain ⟨-, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Z)
    (wcEtZModRing Z ℓ) ℓ αZ hiZ hsZ
  obtain ⟨M, ⟨e₁⟩⟩ := hess _ hH
  obtain ⟨αX, hiX, hsX, -⟩ := wc_et_zmod_ring_locbij X ℓ
  haveI := (sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology X)
    (wcEtZModRing X ℓ) ℓ αX hiX hsX).1
  obtain ⟨τ⟩ := wc_et_toSheaf_pushforward_iso i ℓ D
  let E : (SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj
      ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).obj M) ≅
      (SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K :=
    τ.app M ≪≫ (wcEtPush i).mapIso e₁ ≪≫ u.symm
  exact ⟨M, ⟨(SheafOfModules.toSheaf (wcEtZModRing X ℓ)).preimageIso E⟩⟩

theorem wc_et_open_unit_epi_of_injective : ∀ {X : Scheme.{u}} (V : X.Opens) (ℓ : ℕ) (Dj : wcEtPullData V.ι ℓ) (G : SheafOfModules.{u+1} (wcEtZModRing X ℓ)), Injective G → Epi (Dj.adj.unit.app G) :=
by

  have s4 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}) (I : SheafOfModules.{u+1} R) [Injective I] {U V : C}
      (m : U ⟶ V) [Mono m], Function.Surjective (((SheafOfModules.toSheaf R).obj I).obj.map m.op).hom := by
    intro C _ J _ _ R I _ U V m _
    let adj := (PresheafOfModules.freeAdjunction.{u+1} R.obj).comp
      (PresheafOfModules.sheafificationAdjunction (𝟙 R.obj))
    have hfree : Mono ((PresheafOfModules.free.{u+1} R.obj).map (uliftYoneda.{u+1}.map m)) := by
      rw [PresheafOfModules.mono_iff_surjective]
      intro X
      have h1 : Mono ((uliftYoneda.{u+1}.map m).app X) :=
        (NatTrans.mono_iff_mono_app _).mp inferInstance X
      have h2 : Function.Injective ((uliftYoneda.{u+1}.map m).app X) := (mono_iff_injective _).mp h1
      rw [PresheafOfModules.free_map_app]
      exact Finsupp.mapDomain_injective h2
    have hL : Mono ((PresheafOfModules.free.{u+1} R.obj ⋙
        PresheafOfModules.sheafification (𝟙 R.obj)).map (uliftYoneda.{u+1}.map m)) := by
      rw [Functor.comp_map]
      exact Functor.map_mono _ _
    intro x
    let b := (adj.homEquiv (uliftYoneda.{u+1}.obj U) I).symm (uliftYonedaEquiv.symm x)
    let c := Injective.factorThru b ((PresheafOfModules.free.{u+1} R.obj ⋙
        PresheafOfModules.sheafification (𝟙 R.obj)).map (uliftYoneda.{u+1}.map m))
    have hc : _ ≫ c = b := Injective.comp_factorThru b _
    have key : uliftYoneda.{u+1}.map m ≫ adj.homEquiv _ I c = uliftYonedaEquiv.symm x := by
      rw [← Adjunction.homEquiv_naturality_left, hc, Equiv.apply_symm_apply]
    refine ⟨uliftYonedaEquiv (adj.homEquiv _ I c), ?_⟩
    have nat := uliftYonedaEquiv_naturality (adj.homEquiv _ I c) m.op
    have e2 : uliftYonedaEquiv (uliftYoneda.{u+1}.map m ≫ adj.homEquiv _ I c) = x := by
      rw [key]; exact Equiv.apply_symm_apply _ _
    exact nat.trans e2

  have s2 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [J.HasSheafCompose (forget AddCommGrpCat.{u+1})] (R : Sheaf J RingCat.{u+1})
      {M N : SheafOfModules.{u+1} R} (f : M ⟶ N),
      (∀ U : Cᵒᵖ, Function.Surjective (f.val.app U).hom) → Epi f := by
    intro C _ J _ R M N f hf
    have hrefl : (SheafOfModules.toSheaf R).ReflectsEpimorphisms :=
      Functor.reflectsEpimorphisms_of_faithful _
    apply Functor.epi_of_epi_map (SheafOfModules.toSheaf R)
    haveI : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf R).map f) :=
      Presheaf.isLocallySurjective_of_surjective J _ (fun U x => by
        obtain ⟨y, hy⟩ := hf U x
        exact ⟨y, hy⟩)
    exact Sheaf.epi_of_isLocallySurjective _

  have gen : ∀ {X : Scheme.{u}} (T : X.Etale) (n : ℕ)
      (E : wcEtPullData (S := X) (S' := T.left) T.hom n)
      (G : SheafOfModules.{u+1} (wcEtZModRing X n)), Injective G → Mono T.hom →
      (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) →
      Epi (E.adj.unit.app G) := by
    intro X T n E G hG hmonoT hF
    have key : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod n) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod n →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    have s1 : ∀ {Y : Scheme.{u}} (Q : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1}),
        Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) Q →
        ∀ (a b : (wcEtZModRing Y n).obj ⟶ Q), a = b := by
      intro Y Q hQ a b
      apply sheafify_hom_ext (Scheme.smallEtaleTopology Y) _ _ hQ
      apply NatTrans.ext
      funext V
      apply RingCat.hom_ext
      exact key _ _
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) T.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u})
        T.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong T.hom)) (@Etale : MorphismProperty Scheme.{u})
    letI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let adj : wcEtSlice T ⊣ wcEtBaseChange T.hom :=
      @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ (@Etale : MorphismProperty Scheme.{u}) ⊤ _
        T.left X _ _ T.hom _ _ _ T.prop trivial
    haveI hG' := E.cont
    let α : (Functor.const (T.left.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtSlice T).op ⋙ (wcEtZModRing X n).obj :=
      Functor.whiskerLeft (wcEtSlice T).op (toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))))
    let ψ : wcEtZModRing T.left n ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X n) :=
      ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology T.left) α
        (Functor.op_comp_isSheaf (wcEtSlice T) (Scheme.smallEtaleTopology T.left)
          (Scheme.smallEtaleTopology X) (wcEtZModRing X n)))
    haveI hGF : (wcEtBaseChange T.hom ⋙ wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology X) :=
      Functor.isContinuous_comp (wcEtBaseChange T.hom) (wcEtSlice T) (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
    have H1 : Functor.whiskerRight (NatTrans.op adj.counit) (wcEtZModRing X n).obj =
        E.φ.hom ≫ (wcEtBaseChange T.hom).op.whiskerLeft ψ.hom :=
      s1 (Y := X) _ (Functor.op_comp_isSheaf (wcEtBaseChange T.hom ⋙ wcEtSlice T)
        (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology X) (wcEtZModRing X n)) _ _
    have H2 : ψ.hom ≫ (wcEtSlice T).op.whiskerLeft E.φ.hom ≫
        Functor.whiskerRight (NatTrans.op adj.unit) (wcEtZModRing T.left n).obj =
        𝟙 (wcEtZModRing T.left n).obj :=
      s1 (Y := T.left) _ (wcEtZModRing T.left n).cond _ _

    have hεl : ∀ U : X.Etale, (adj.counit.app U).left = Limits.pullback.fst U.hom T.hom := by
      intro U
      simp only [adj, MorphismProperty.Over.mapPullbackAdj_counit_app]
      rfl
    have hmono : ∀ U : X.Etale, Mono (adj.counit.app U) := by
      intro U
      haveI := hmonoT
      haveI : Mono (Limits.pullback.fst U.hom T.hom) := Limits.pullback.fst_of_mono
      constructor
      intro Z g h hgh
      apply MorphismProperty.Over.Hom.ext
      have h1 := congrArg (fun k => k.left) hgh
      change g.left ≫ (adj.counit.app U).left = h.left ≫ (adj.counit.app U).left at h1
      rw [hεl] at h1
      exact (cancel_mono (Limits.pullback.fst U.hom T.hom)).1 h1
    let adjP := @SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hF E.cont adj ψ E.φ H1 H2
    have hres : ∀ U : X.Etale, Function.Surjective
        (((SheafOfModules.toSheaf (wcEtZModRing X n)).obj G).obj.map (adj.counit.app U).op).hom := by
      intro U
      haveI := hmono U
      haveI := hG
      exact s4 (Scheme.smallEtaleTopology X) (wcEtZModRing X n) G (adj.counit.app U)
    have hsurj : ∀ U : (X.Etale)ᵒᵖ, Function.Surjective ((adjP.unit.app G).val.app U).hom := by
      intro U y
      obtain ⟨x, hx⟩ := hres U.unop y
      refine ⟨x, ?_⟩
      exact (SheafOfModules.pushforwardPushforwardAdj_unit_app_val_app adj ψ E.φ H1 H2 G U x).trans hx
    have hepiP : Epi (adjP.unit.app G) :=
      s2 (Scheme.smallEtaleTopology X) (wcEtZModRing X n) (adjP.unit.app G) hsurj
    have hst := Adjunction.unit_leftAdjointUniq_hom_app E.adj adjP G
    rw [← hst] at hepiP
    have cancel : ∀ {A B C : SheafOfModules.{u+1} (wcEtZModRing X n)} (f : A ⟶ B) (g : B ⟶ C)
        [IsIso g], Epi (f ≫ g) → Epi f := by
      intro A B C f g _ h
      have hf : f = (f ≫ g) ≫ inv g := by simp
      rw [hf]
      exact epi_comp _ _
    exact cancel _ _ hepiP

  have slice_cont : ∀ {S : Scheme.{u}} (T : S.Etale),
      (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S) := by
    intro S T
    haveI hT : Etale T.hom := T.prop
    have hSurj : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Y V →
        ∀ y : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
      intro Y V R hR y
      change R ∈ Scheme.smallGrothendieckTopology @Etale Y V at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
      exact ⟨V₁, c, w, hc, hw⟩
    have hCov : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V R hR
      change R ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hR x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : CoverPreserving (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S)
        (wcEtSlice T) := by
      refine CoverPreserving.mk (fun {V} {R} hR => ?_)
      apply hCov
      intro v
      obtain ⟨V₁, c, w, hc, hw⟩ := hSurj T.left V R hR v
      exact ⟨(wcEtSlice T).obj V₁, (wcEtSlice T).map c, ⟨V₁, c, 𝟙 _, hc, (Category.id_comp _).symm⟩,
        ⟨w, hw⟩⟩
    have hcomp : CompatiblePreserving.{u+1} (Scheme.smallEtaleTopology S) (wcEtSlice T) := by
      apply CompatiblePreserving.mk
      intro ℱ Z T' x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      have hw : (f₁.left ≫ Y₁.hom) ≫ T.hom = X.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
      haveI : Etale ((f₁.left ≫ Y₁.hom) ≫ T.hom) := hw ▸ X.prop
      haveI : Etale (f₁.left ≫ Y₁.hom) := Etale.of_comp _ T.hom
      let X' : T.left.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) ‹_›
      have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun k => k.left) hfg
      have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
        have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
        have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
        calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
              (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
          _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
          _ = f₁.left ≫ Y₁.hom :=
              (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
      let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
      let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
      let e : X ⟶ (wcEtSlice T).obj X' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
      have hf₁ : f₁ = e ≫ (wcEtSlice T).map f₁' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hf₂ : f₂ = e ≫ (wcEtSlice T).map f₂' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
        apply MorphismProperty.Over.Hom.ext
        exact hleft
      have hc := hx f₁' f₂' hg₁ hg₂ hsq
      rw [hf₁, hf₂]
      simp only [Functor.map_comp, op_comp]
      rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
      exact congrArg _ hc
    exact Functor.isContinuous_of_coverPreserving hcomp hcov
  intro X V ℓ Dj G hG
  exact @gen X (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι)) ℓ Dj G hG
    (show Mono V.ι from inferInstance)
    (slice_cont (MorphismProperty.Over.mk ⊤ V.ι (inferInstance : Etale V.ι)))

theorem wc_et_open_unit_epi_of_isClosed : ∀ {X : Scheme.{u}} (V : X.Opens) (ℓ : ℕ) (Dj : wcEtPullData V.ι ℓ) (G : SheafOfModules.{u+1} (wcEtZModRing X ℓ)), IsClosed (V : Set X) → Epi (Dj.adj.unit.app G) :=
by
  intro X V ℓ Dj G hV
  classical

  have hSurj : ∀ (Y : Scheme.{u}) (W : Y.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology Y W →
      ∀ y : W.left, ∃ (W₁ : Y.Etale) (c : W₁ ⟶ W) (w : W₁.left), R.arrows c ∧ c.left w = y := by
    intro Y W R hR y
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y W at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨W₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ W R).mp hR y
    exact ⟨W₁, c, w, hc, hw⟩
  have hCov : ∀ (Y : Scheme.{u}) (W : Y.Etale) (R : Sieve W), (∀ v : W.left, ∃ (W₁ : Y.Etale)
      (c : W₁ ⟶ W), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology Y W := by
    intro Y W R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y W
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨W₁, c, hc, y, hy⟩ := hR x
    have hw : c.left ≫ W.hom = W₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale W.hom := W.prop
      have h2 : Etale (c.left ≫ W.hom) := by rw [hw]; exact W₁.prop
      exact Etale.of_comp c.left W.hom
    exact ⟨W₁, c, y, hc, hEt, hy⟩

  have hcontT : ∀ T : X.Etale, (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology X) := by
    intro T
    haveI hT : Etale T.hom := T.prop
    have hcov : CoverPreserving (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
        (wcEtSlice T) := by
      refine CoverPreserving.mk (fun {W} {R} hR => ?_)
      apply hCov
      intro v
      obtain ⟨W₁, c, w, hc, hw⟩ := hSurj T.left W R hR v
      exact ⟨(wcEtSlice T).obj W₁, (wcEtSlice T).map c, ⟨W₁, c, 𝟙 _, hc, (Category.id_comp _).symm⟩,
        ⟨w, hw⟩⟩
    have hcomp : CompatiblePreserving.{u+1} (Scheme.smallEtaleTopology X) (wcEtSlice T) := by
      apply CompatiblePreserving.mk
      intro ℱ Z T' x hx Y₁ Y₂ X' f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      have hw : (f₁.left ≫ Y₁.hom) ≫ T.hom = X'.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
      haveI : Etale ((f₁.left ≫ Y₁.hom) ≫ T.hom) := hw ▸ X'.prop
      haveI : Etale (f₁.left ≫ Y₁.hom) := Etale.of_comp _ T.hom
      let X'' : T.left.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) ‹_›
      have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun k => k.left) hfg
      have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
        have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
        have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
        calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
              (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
          _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
          _ = f₁.left ≫ Y₁.hom :=
              (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
      let f₁' : X'' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
      let f₂' : X'' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
      let e : X' ⟶ (wcEtSlice T).obj X'' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
      have hf₁ : f₁ = e ≫ (wcEtSlice T).map f₁' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hf₂ : f₂ = e ≫ (wcEtSlice T).map f₂' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
        apply MorphismProperty.Over.Hom.ext
        exact hleft
      have hc := hx f₁' f₂' hg₁ hg₂ hsq
      rw [hf₁, hf₂]
      simp only [Functor.map_comp, op_comp]
      rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
      exact congrArg _ hc
    exact Functor.isContinuous_of_coverPreserving hcomp hcov

  have hempty : ∀ (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (Z : X.Etale),
      IsEmpty Z.left → Subsingleton ↑(F.obj.obj (Opposite.op Z)) := by
    intro F Z hZ
    exact AddCommGrpCat.subsingleton_of_isZero
      (Sheaf.isTerminalOfBotCover F Z (hCov X Z ⊥ (fun v => isEmptyElim v))).isZero

  have hrestr : ∀ (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) {U₁ U : X.Etale}
      (c : U₁ ⟶ U), IsOpenImmersion c.left → IsClosed (Set.range c.left) →
      Function.Surjective (F.obj.map c.op).hom := by
    intro F U₁ U c hc hcl s
    haveI := hc
    let W : U.left.Opens := ⟨(Set.range c.left)ᶜ, hcl.isOpen_compl⟩
    let Xs : Bool → X.Etale := fun b => Bool.rec (wcEtOpen X U W) U₁ b
    let π : (b : Bool) → Xs b ⟶ U := fun b =>
      Bool.rec (motive := fun b => Xs b ⟶ U) (wcEtOpenι X U W) c b
    let P := F.obj ⋙ forget AddCommGrpCat.{u+1}
    have hP : Presheaf.IsSheaf (Scheme.smallEtaleTopology X) P :=
      (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) F.obj
        (forget AddCommGrpCat.{u+1})).1 F.cond
    have hS : Sieve.generate (Presieve.ofArrows Xs π) ∈ Scheme.smallEtaleTopology X U := by
      apply hCov
      intro y
      by_cases hy : y ∈ Set.range c.left
      · exact ⟨Xs true, π true, ⟨Xs true, 𝟙 _, π true, Presieve.ofArrows.mk true,
          Category.id_comp _⟩, hy⟩
      · refine ⟨Xs false, π false, ⟨Xs false, 𝟙 _, π false, Presieve.ofArrows.mk false,
          Category.id_comp _⟩, ?_⟩
        refine ⟨(⟨y, hy⟩ : (W : Scheme.{u})), ?_⟩
        exact Scheme.Opens.ι_apply W ⟨y, hy⟩
    have hSF : Presieve.IsSheafFor P (Presieve.ofArrows Xs π) :=
      (Presieve.isSheafFor_iff_generate _).2 (hP.isSheafFor _ hS)
    let x : (b : Bool) → P.obj (Opposite.op (Xs b)) := fun b =>
      Bool.rec (motive := fun b => P.obj (Opposite.op (Xs b)))
        (0 : F.obj.obj (Opposite.op (wcEtOpen X U W))) s b
    have hmixed : ∀ (Z : X.Etale) (g₁ : Z ⟶ wcEtOpen X U W) (g₂ : Z ⟶ U₁),
        g₁.left ≫ W.ι = g₂.left ≫ c.left → IsEmpty Z.left := by
      intro Z g₁ g₂ h'
      refine ⟨fun z => ?_⟩
      have hz : W.ι (g₁.left z) = c.left (g₂.left z) :=
        (Scheme.Hom.comp_apply g₁.left W.ι z).symm.trans
          ((congrArg (fun k => k z) h').trans (Scheme.Hom.comp_apply g₂.left c.left z))
      have hm : W.ι (g₁.left z) ∈ Set.range W.ι := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι] at hm
      exact absurd (⟨g₂.left z, hz.symm⟩ : W.ι (g₁.left z) ∈ Set.range c.left) hm
    have hx : Presieve.Arrows.Compatible P π x := by
      intro i j Z gi gj hij
      cases i <;> cases j
      · show (F.obj.map gi.op).hom 0 = (F.obj.map gj.op).hom 0
        rw [map_zero, map_zero]
      · have hZ : IsEmpty Z.left := hmixed Z gi gj (congrArg (fun k => k.left) hij)
        exact @Subsingleton.elim _ (hempty F Z hZ) _ _
      · have hZ : IsEmpty Z.left := hmixed Z gj gi (congrArg (fun k => k.left) hij).symm
        exact @Subsingleton.elim _ (hempty F Z hZ) _ _
      · have h' : gi.left ≫ c.left = gj.left ≫ c.left := congrArg (fun k => k.left) hij
        have hg : gi = gj := MorphismProperty.Over.Hom.ext ((cancel_mono c.left).1 h')
        rw [hg]
    obtain ⟨t, ht, -⟩ := (Presieve.isSheafFor_arrows_iff P π).1 hSF x hx
    exact ⟨t, ht true⟩

  have gen : ∀ (T : X.Etale) (E : wcEtPullData (S := X) (S' := T.left) T.hom ℓ)
      [hF : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)]
      [hT : IsOpenImmersion T.hom], IsClosed (Set.range T.hom) → Epi (E.adj.unit.app G) := by
    intro T E hF hT hTc
    have key : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod ℓ) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod ℓ)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod ℓ)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod ℓ →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    have s1 : ∀ {Y : Scheme.{u}} (Q : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1}),
        Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) Q →
        ∀ (a b : (wcEtZModRing Y ℓ).obj ⟶ Q), a = b := by
      intro Y Q hQ a b
      apply sheafify_hom_ext (Scheme.smallEtaleTopology Y) _ _ hQ
      apply NatTrans.ext
      funext W
      apply RingCat.hom_ext
      exact key _ _
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) T.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u})
        T.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong T.hom)) (@Etale : MorphismProperty Scheme.{u})
    letI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let adj : wcEtSlice T ⊣ wcEtBaseChange T.hom :=
      @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ (@Etale : MorphismProperty Scheme.{u}) ⊤ _
        T.left X _ _ T.hom _ _ _ T.prop trivial
    haveI hG := E.cont
    let α : (Functor.const (T.left.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod ℓ))) ⟶
        (wcEtSlice T).op ⋙ (wcEtZModRing X ℓ).obj :=
      Functor.whiskerLeft (wcEtSlice T).op (toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod ℓ)))))
    let ψ : wcEtZModRing T.left ℓ ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X ℓ) :=
      ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology T.left) α
        (Functor.op_comp_isSheaf (wcEtSlice T) (Scheme.smallEtaleTopology T.left)
          (Scheme.smallEtaleTopology X) (wcEtZModRing X ℓ)))
    haveI hGF : (wcEtBaseChange T.hom ⋙ wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology X) :=
      Functor.isContinuous_comp (wcEtBaseChange T.hom) (wcEtSlice T) (Scheme.smallEtaleTopology X)
