    rw [hfac]
    exact adj.extEquiv.bijective.comp hψ

  obtain ⟨φΓ, hφΓ⟩ : ∃ f : ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a).obj
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj M) ⟶
      ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a).obj
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj M'), f = φ :=
    ⟨φ, rfl⟩
  have hΓφ : ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a).map φ =
      c • φΓ := by
    have e1 : (c • φΓ).hom = c • φΓ.hom :=
      (sheafToPresheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}).map_nsmul
        (f := φΓ) (n := c)
    apply Sheaf.hom_ext
    rw [e1]
    apply NatTrans.ext
    funext V
    rw [NatTrans.app_nsmul, hφΓ]
    exact hφ V.unop
  have hmk : ∀ n : ℕ, Abelian.Ext.mk₀ (n • φΓ) = n • Abelian.Ext.mk₀ φΓ := by
    intro n
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ n ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have hcn : ∀ {A B C' : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}}
      {p q r : ℕ} (α : Abelian.Ext A B p) (β : Abelian.Ext B C' q) (h : p + q = r) (n : ℕ),
      α.comp (n • β) h = n • α.comp β h := by
    intro A B C' p q r α β h n
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.comp_zero]
    | succ n ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]

  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ∀ N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Abelian.Ext (wcFreeSheaf S U) N i →+ Abelian.Ext Z
        (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj N) i,
      ∀ N y, Ψ N y = (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U) y) (zero_add i) :=
    ⟨fun N => AddMonoidHom.mk' (fun y => (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U) y) (zero_add i))
      (fun x y => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ _ => rfl⟩
  have hΨbij : ∀ N, Function.Bijective (Ψ N) := by
    intro N
    have e : (⇑(Ψ N)) = fun y => (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U) y) (zero_add i) :=
      funext (hΨ N)
    rw [e]
    exact htrans N
  haveI := hiso
  obtain ⟨Pe, hPe⟩ : ∃ Pe : Abelian.Ext Z
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj M) i ≃+ Abelian.Ext Z
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj M') i,
      ∀ z, Pe z = z.comp (Abelian.Ext.mk₀ φ) (add_zero i) :=
    ⟨{ toFun := fun z => z.comp (Abelian.Ext.mk₀ φ) (add_zero i)
       invFun := fun z => z.comp (Abelian.Ext.mk₀ (inv φ)) (add_zero i)
       left_inv := fun z => by
         change (z.comp (Abelian.Ext.mk₀ φ) (add_zero i)).comp (Abelian.Ext.mk₀ (inv φ))
           (add_zero i) = z
         rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id,
           Abelian.Ext.comp_mk₀_id]
       right_inv := fun z => by
         change (z.comp (Abelian.Ext.mk₀ (inv φ)) (add_zero i)).comp (Abelian.Ext.mk₀ φ)
           (add_zero i) = z
         rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id,
           Abelian.Ext.comp_mk₀_id]
       map_add' := fun x y => Abelian.Ext.add_comp _ _ _ _ }, fun _ => rfl⟩
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : Abelian.Ext (wcFreeSheaf S U) M i ≃+ Abelian.Ext (wcFreeSheaf S U) M' i,
      ∀ y, Ψ M' (Φ y) = Pe (Ψ M y) :=
    ⟨(AddEquiv.ofBijective (Ψ M) (hΨbij M)).trans
        (Pe.trans (AddEquiv.ofBijective (Ψ M') (hΨbij M')).symm),
      fun y => AddEquiv.ofBijective_apply_symm_apply (Ψ M') (hΨbij M')⟩

  obtain ⟨Ξ, hΞ⟩ : ∃ Ξ : ∀ N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Abelian.Ext Z (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj N) i →
      Abelian.Ext Z (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj N) i,
      ∀ N x, Ξ N x = (Abelian.Ext.mk₀ κ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a) x) (zero_add i) :=
    ⟨fun N x => (Abelian.Ext.mk₀ κ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a) x) (zero_add i),
      fun _ _ => rfl⟩
  have hRΓ : ∀ (N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (x : Abelian.Ext (wcFreeSheaf S U) N i),
      Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a)
        (Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U) x) =
      Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U) x := by
    intro N x
    rw [← Abelian.Ext.comp_mapExactFunctor]
    rfl
  have hstar : ∀ (N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (y : Abelian.Ext (wcFreeSheaf S U) N i),
      Ψ N ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp y (zero_add i)) = Ξ N (Ψ N y) := by
    intro N y
    rw [hΞ]
    have s1 : Ψ N ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp y (zero_add i)) =
        (Abelian.Ext.mk₀ (ε ≫
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map
            (wcFreeSheafMap S a))).comp (Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U) y) (zero_add i) := by
      rw [hΨ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀_assoc]
    rw [F1] at s1
    rw [s1, hΨ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    exact congrArg (fun z => (Abelian.Ext.mk₀ (κ ≫
      ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a).map ε)).comp z
        (zero_add i)) (hRΓ N y).symm
  have hkey : ∀ z : Abelian.Ext Z
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj M) i,
      Ξ M' (Pe z) = c • Pe (Ξ M z) := by
    intro z
    rw [hPe z, hPe (Ξ M z), hΞ M', hΞ M, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, hΓφ, hmk, hcn, hcn,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, hφΓ]
    rfl

  refine ⟨Φ.toAddMonoidHom, Φ.bijective, fun y => ?_⟩
  show c • Φ ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp y (zero_add i)) =
    (Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp (Φ y) (zero_add i)
  apply (hΨbij M').1
  rw [map_nsmul, hΦ, hstar M y, hstar M' (Φ y), hΦ y, hkey]

theorem wc_top_twist_compare (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n d i : ℕ) :
    ∃ Θ : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
          (Limits.cokernel (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n))) i →+
        Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h)) (wcRootTwist X.left (ℓ ^ n) d) i,
      Function.Injective Θ ∧
      ∀ y, Θ ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp y (zero_add i)) =
        (Nat.card F ^ d) •
          (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp (Θ y) (zero_add i) :=
by
  classical
  obtain ⟨e⟩ := wc_int_coker_zmod X.left ℓ n ((ℓ : ℤ_[ℓ]) ^ n) rfl
  obtain ⟨ρ, hinj, hsurj, hρ⟩ := wc_root_twist_slice_presheaf_map F X ℓ hℓ h n d
  obtain ⟨ψ, hψiso, hψ⟩ := wc_slice_sheafify_scaled_iso X.left (wcGeomPoint F X h)
    (wcGeomFrob F X h) (wcRootTwistPre X.left (ℓ ^ n) d) (wcZModSheaf X.left (ℓ ^ n)) ρ
    (Nat.card F ^ d) hinj hsurj hρ
  obtain ⟨Φ, hΦbij, hΦ⟩ := wc_slice_ext_frob_transport X.left (wcGeomPoint F X h)
    (wcGeomFrob F X h) (wcRootTwist X.left (ℓ ^ n) d) (wcZModSheaf X.left (ℓ ^ n)) ψ
    (Nat.card F ^ d) hψiso hψ i
  set G := Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h)) with hG
  let Φe := AddEquiv.ofBijective Φ hΦbij
  have hΦe : ∀ x, Φ (Φe.symm x) = x := fun x => Φe.apply_symm_apply x
  let E1 := (Abelian.Ext.mk₀ e.hom).postcomp
    (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero i)
  have hE1 : ∀ y, E1 y = y.comp (Abelian.Ext.mk₀ e.hom) (add_zero i) := by
    intro y
    simp only [E1, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
      Abelian.Ext.bilinearComp_apply_apply]
  have hE1inj : Function.Injective E1 := by
    intro a b hab
    rw [hE1, hE1] at hab
    have hinv : ∀ y : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
        (Limits.cokernel (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n))) i,
        (y.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)).comp (Abelian.Ext.mk₀ e.inv) (add_zero i)
          = y := by
      intro y
      rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ e.hom) (Abelian.Ext.mk₀ e.inv)
        (add_zero _) (add_zero _) (by omega), Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [← hinv a, ← hinv b, hab]
  refine ⟨Φe.symm.toAddMonoidHom.comp E1, ?_, ?_⟩
  · intro a b hab
    have hab' : Φe.symm (E1 a) = Φe.symm (E1 b) := hab
    exact hE1inj (Φe.symm.injective hab')
  · intro y
    show Φe.symm (E1 (G.comp y (zero_add i))) =
      (Nat.card F ^ d) • G.comp (Φe.symm (E1 y)) (zero_add i)
    rw [AddEquiv.symm_apply_eq]
    show E1 (G.comp y (zero_add i)) = Φ ((Nat.card F ^ d) • G.comp (Φe.symm (E1 y)) (zero_add i))
    rw [map_nsmul, hΦ, hΦe, hE1, hE1,
      Abelian.Ext.comp_assoc G y (Abelian.Ext.mk₀ e.hom) (zero_add _) (add_zero _) (by omega)]

theorem wc_top_twist_card_le (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) :
    Finite (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ n) d) (2 * d)) ∧
    Nat.card (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ n) d) (2 * d)) ≤ ℓ ^ n :=
by
  classical

  have hdev : ∀ (Y : Scheme.{u}) (p i : ℕ), p ≠ 0 → Finite (wcEtCoh Y p i) →
      Nat.card (wcEtCoh Y p i) ≤ p →
      ∀ k : ℕ, Finite (wcEtCoh Y (p ^ k) i) ∧ Nat.card (wcEtCoh Y (p ^ k) i) ≤ p ^ k := by
    intro Y p i hp hfp hcp
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

    have hmid : ∀ (X₀ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})), S.ShortExact →
        ∀ m : ℕ, Finite (Abelian.Ext X₀ S.X₁ m) → Finite (Abelian.Ext X₀ S.X₃ m) →
          Finite (Abelian.Ext X₀ S.X₂ m) ∧
          Nat.card (Abelian.Ext X₀ S.X₂ m) ≤
            Nat.card (Abelian.Ext X₀ S.X₃ m) * Nat.card (Abelian.Ext X₀ S.X₁ m) := by
      intro X₀ S hS m h1 h3
      let ψ : Abelian.Ext X₀ S.X₂ m →+ Abelian.Ext X₀ S.X₃ m :=
        (Abelian.Ext.mk₀ S.g).postcomp X₀ (add_zero m)
      let φ : Abelian.Ext X₀ S.X₁ m →+ Abelian.Ext X₀ S.X₂ m :=
        (Abelian.Ext.mk₀ S.f).postcomp X₀ (add_zero m)
      have hex : ∀ b, ψ b = 0 → ∃ a, φ a = b := fun b hb =>
        Abelian.Ext.covariant_sequence_exact₂ X₀ hS b hb
      let σ : Abelian.Ext X₀ S.X₃ m → Abelian.Ext X₀ S.X₂ m :=
        fun c => if h : ∃ b, ψ b = c then h.choose else 0
      have hσ : ∀ b, ψ (σ (ψ b)) = ψ b := by
        intro b
        have h : ∃ b', ψ b' = ψ b := ⟨b, rfl⟩
        simp only [σ, dif_pos h]
        exact h.choose_spec
      have hpre : ∀ b, ∃ a, φ a = b - σ (ψ b) := fun b =>
        hex _ (by rw [map_sub, hσ, sub_self])
      choose τ hτ using hpre
      have hinj : Function.Injective (fun b => (ψ b, τ b)) := by
        intro b b' hbb
        simp only [Prod.mk.injEq] at hbb
        obtain ⟨e1, e2⟩ := hbb
        have := hτ b
        rw [e2, hτ b', e1] at this
        exact (sub_left_inj.mp this).symm
      exact ⟨Finite.of_injective _ hinj,
        (Nat.card_le_card_of_injective _ hinj).trans_eq (Nat.card_prod _ _)⟩

    have hzero : ∀ (X₀ Z : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
        Limits.IsZero Z → ∀ m, Finite (Abelian.Ext X₀ Z m) ∧ Nat.card (Abelian.Ext X₀ Z m) ≤ 1 := by
      intro X₀ Z hZ m
      have hx : ∀ x : Abelian.Ext X₀ Z m, x = 0 := by
        intro x
        have := Abelian.Ext.comp_mk₀_id x
        rw [hZ.eq_of_tgt (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
        exact this.symm
      haveI : Subsingleton (Abelian.Ext X₀ Z m) := ⟨fun x y => by rw [hx x, hx y]⟩
      haveI : Finite (Abelian.Ext X₀ Z m) := Finite.of_subsingleton
      exact ⟨inferInstance, Finite.card_le_one_iff_subsingleton.mpr inferInstance⟩

    have hses : ∀ (p k : ℕ), p ≠ 0 →
        ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
          (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
          (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
      intro p k hp
      have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
        rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
          ZMod.natCast_self]
      let α : ZMod k →+ ZMod (p * k) :=
        ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
      have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
        intro z
        show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
        rw [ZMod.lift_coe]
        change z • (p : ZMod (p * k)) = _
        rw [zsmul_eq_mul]
        push_cast
        ring
      let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
      have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
        map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
      have hαinj : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
        have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
        push_cast at hx
        rw [mul_comm z] at hx
        exact (mul_dvd_mul_iff_left hp').mp hx
      have hβsurj : Function.Surjective β := by
        intro y
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        exact ⟨(z : ZMod (p * k)), hβ z⟩
      have hβα : ∀ x, β (α x) = 0 := by
        intro x
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, hβ]
        push_cast
        rw [ZMod.natCast_self, mul_zero]
      have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
        intro y hy
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
        obtain ⟨t, rfl⟩ := hy
        refine ⟨(t : ZMod k), ?_⟩
        rw [hα]
        congr 1
        ring
      let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
          AddEquiv.ulift.toAddMonoidHom)
      let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
          AddEquiv.ulift.toAddMonoidHom)
      have hw : f ≫ g = 0 := by
        ext x
        exact hβα x.down
      refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
      · rw [ShortComplex.ab_exact_iff]
        intro x₂ hx₂
        obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
        exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
      · rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro y
        obtain ⟨x, hx⟩ := hβsurj y.down
        exact ⟨ULift.up x, congrArg ULift.up hx⟩

    haveI : Limits.PreservesFiniteLimits
        (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
      Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Y)ᵒᵖ)
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})

    intro k
    induction k with
    | zero =>
      rw [pow_zero]
      exact hzero _ _ (Functor.map_isZero _ (AddCommGrpCat.isZero_of_subsingleton _)) i
    | succ k ih =>
      obtain ⟨f, g, hw, hS₀⟩ := hses p (p ^ k) hp
      have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      have key := hmid ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ hS i ih.1 hfp
      rw [pow_succ']
      exact ⟨key.1, key.2.trans (Nat.mul_le_mul hcp ih.2)⟩

  obtain ⟨ρ, hinj, hsurj, hρ⟩ := wc_root_twist_slice_presheaf_map F X ℓ hℓ h n d
  obtain ⟨ψ, hψiso, hψ⟩ := wc_slice_sheafify_scaled_iso X.left (wcGeomPoint F X h)
    (wcGeomFrob F X h) (wcRootTwistPre X.left (ℓ ^ n) d) (wcZModSheaf X.left (ℓ ^ n)) ρ
    (Nat.card F ^ d) hinj hsurj hρ
  obtain ⟨Φ, hΦbij, -⟩ := wc_slice_ext_frob_transport X.left (wcGeomPoint F X h)
    (wcGeomFrob F X h) (wcRootTwist X.left (ℓ ^ n) d) (wcZModSheaf X.left (ℓ ^ n)) ψ
    (Nat.card F ^ d) hψiso hψ (2 * d)
  let E₁ := Equiv.ofBijective Φ hΦbij

  obtain ⟨E₂⟩ := wc_ext_free_slice_zmod X.left (wcGeomPoint F X h) (ℓ ^ n) (2 * d)

  let fY : (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F)) :=
    Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  haveI hprop : IsProper fY :=
    (show IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :
        (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F))) from inferInstance)
  obtain ⟨E₃⟩ := wc_proet_etale_comparison_zmod (AlgebraicClosure F) (wcGeomPoint F X h).left
    fY (ℓ ^ n) (2 * d)

  haveI hsm : SmoothOfRelativeDimension d fY :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) inferInstance
  haveI hirr : IrreducibleSpace (wcGeomPoint F X h).left :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
  have hne : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro h0
    have hp : ringChar F ∣ ℓ := (CharP.cast_eq_zero_iff (AlgebraicClosure F) (ringChar F) ℓ).mp h0
    have hpp : Nat.Prime (ringChar F) := CharP.char_is_prime F (ringChar F)
    have hpl : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hp
    letI := Fintype.ofFinite F
    have hc : ((Nat.card F : ℕ) : F) = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F
    have hdvd : ringChar F ∣ Nat.card F := (ringChar.spec F _).mp hc
    exact hℓ (hpl ▸ hdvd)

  obtain ⟨hf1, hc1⟩ := wc_et_top_coh_card_le (AlgebraicClosure F) (wcGeomPoint F X h).left fY d ℓ hne
  obtain ⟨hfn, hcn⟩ := hdev (wcGeomPoint F X h).left ℓ (2 * d) (Fact.out : ℓ.Prime).ne_zero hf1 hc1 n
  let E := E₁.trans (E₂.trans E₃)
  exact ⟨Finite.of_equiv _ E.symm, (Nat.card_congr E).trans_le hcn⟩

theorem wc_finite_ext_transfer (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))) :
    ∃ (s : ℕ → (wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt)))
      (N : wcFreeSheaf X.left (Scheme.ProEt.mk (𝟙 X.left)) ⟶
        wcFreeSheaf X.left (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU)),
      (∀ j, s (j + 1) = wcGeomFrob F X h ≫ s j) ∧ s (Module.finrank F E) = s 0 ∧
      ∀ π : wcGeomPoint F X h ⟶ Scheme.ProEt.mk (𝟙 X.left),
        wcFreeSheafMap X.left π ≫ N =
          ∑ j ∈ Finset.range (Module.finrank F E), wcFreeSheafMap X.left (s j) :=
by
  classical

  have wc_frob_embedding_data : ∀ (F : Type u) [Finite F] [Field F]
      (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
      ∃ (τ₀ : E →ₐ[F] AlgebraicClosure F) (γ₀ : E ≃ₐ[F] E),
        (∀ x : E, τ₀ (γ₀ x) =
          (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
            (AlgebraicClosure F) _ _ _).symm (τ₀ x)) ∧
        orderOf γ₀ = Module.finrank F E := by
    intro F _ _ E _ _ _
    letI : Fintype F := Fintype.ofFinite F
    haveI : Finite E := Module.finite_of_finite F
    refine ⟨IsAlgClosed.lift, (FiniteField.frobeniusAlgEquivOfAlgebraic F E)⁻¹, ?_, ?_⟩
    · intro x
      rw [AlgEquiv.eq_symm_apply, FiniteField.coe_frobeniusAlgEquivOfAlgebraic]
      show (IsAlgClosed.lift ((FiniteField.frobeniusAlgEquivOfAlgebraic F E)⁻¹ x) :
        AlgebraicClosure F) ^ Fintype.card F = _
      rw [← map_pow]
      congr 1
      have := congrArg (fun f => f ((FiniteField.frobeniusAlgEquivOfAlgebraic F E)⁻¹ x))
        (FiniteField.coe_frobeniusAlgEquivOfAlgebraic F E)
      simp only at this
      rw [← this, AlgEquiv.aut_inv, AlgEquiv.apply_symm_apply]
    · rw [orderOf_inv, FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic]

  have wc_galois_lagrange_partition : ∀ (F : Type u) [Field F] [Finite F]
      (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
      (γ₀ : E ≃ₐ[F] E) (hγ : orderOf γ₀ = Module.finrank F E)
      (A : Type u) [CommRing A] (φ ψ : E →+* A)
      (hφψ : φ.comp (algebraMap F E) = ψ.comp (algebraMap F E)),
      ∃ v : Fin (Module.finrank F E) → A, ∑ k, v k = 1 ∧
        ∀ (k : Fin (Module.finrank F E)) (x : E), v k * (ψ x - φ ((γ₀ ^ (k : ℕ)) x)) = 0 := by
    intro F _ _ E _ _ _ γ₀ hγ A _ φ ψ hφψ
    set r := Module.finrank F E with hr
    obtain ⟨θ, hθ⟩ := Field.exists_primitive_element F E
    have hint : IsIntegral F θ := Algebra.IsIntegral.isIntegral θ
    have hadj : Algebra.adjoin F {θ} = ⊤ := by
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic, hθ,
        IntermediateField.top_toSubalgebra]
    have hdeg : (minpoly F θ).natDegree = r := by
      have h1 := IntermediateField.adjoin.finrank hint
      rw [hθ, IntermediateField.finrank_top'] at h1
      exact h1.symm
    have hr0 : 0 < r := Module.finrank_pos
    let t : Fin r → E := fun k => (γ₀ ^ (k : ℕ)) θ
    have htinj : Function.Injective t := by
      intro j k hjk
      have h1 : (γ₀ ^ (j : ℕ)).toAlgHom = (γ₀ ^ (k : ℕ)).toAlgHom :=
        AlgHom.ext_of_adjoin_eq_top hadj (fun y hy => by
          rw [Set.mem_singleton_iff.mp hy]; exact hjk)
      have h2 : γ₀ ^ (j : ℕ) = γ₀ ^ (k : ℕ) := AlgEquiv.ext (fun y => DFunLike.congr_fun h1 y)
      have h3 := pow_injOn_Iio_orderOf (x := γ₀) (show (j : ℕ) ∈ Set.Iio (orderOf γ₀) by
        rw [hγ]; exact j.isLt) (show (k : ℕ) ∈ Set.Iio (orderOf γ₀) by rw [hγ]; exact k.isLt) h2
      exact Fin.ext h3
    set mE := (minpoly F θ).map (algebraMap F E) with hmE
    have hroot : ∀ k, mE.IsRoot (t k) := by
      intro k
      rw [Polynomial.IsRoot, hmE, Polynomial.eval_map_algebraMap]
      show Polynomial.aeval ((γ₀ ^ (k : ℕ)).toAlgHom θ) (minpoly F θ) = 0
      rw [Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
    have hcop : (↑(Finset.univ : Finset (Fin r)) : Set (Fin r)).Pairwise
        (Function.onFun IsCoprime fun i => Polynomial.X - Polynomial.C (t i)) :=
      (Polynomial.pairwise_coprime_X_sub_C htinj).set_pairwise _
    have hdvd : Lagrange.nodal Finset.univ t ∣ mE :=
      Finset.prod_dvd_of_coprime hcop (fun k _ => Polynomial.dvd_iff_isRoot.mpr (hroot k))
    have hdegle : mE.natDegree ≤ (Lagrange.nodal Finset.univ t).natDegree := by
      rw [Lagrange.natDegree_nodal, hmE, Polynomial.natDegree_map, hdeg, Finset.card_univ,
        Fintype.card_fin]
    have hnodal : Lagrange.nodal Finset.univ t = mE :=
      (Polynomial.eq_of_monic_of_dvd_of_natDegree_le Lagrange.nodal_monic
        ((minpoly.monic hint).map _) hdvd hdegle).symm
    have hmulL : ∀ k, (Polynomial.X - Polynomial.C (t k)) * Lagrange.basis Finset.univ t k =
        Polynomial.C (∏ j ∈ Finset.univ.erase k, (t k - t j)⁻¹) *
          Lagrange.nodal Finset.univ t := by
      intro k
      simp only [Lagrange.basis, Lagrange.basisDivisor, Finset.prod_mul_distrib, map_prod]
      rw [Lagrange.nodal, ← Finset.mul_prod_erase Finset.univ
        (fun j => Polynomial.X - Polynomial.C (t j)) (Finset.mem_univ k)]
      ring
    have hnonempty : (Finset.univ : Finset (Fin r)).Nonempty := ⟨⟨0, hr0⟩, Finset.mem_univ _⟩
    have hnodal0 : Polynomial.eval (ψ θ) ((Lagrange.nodal Finset.univ t).map φ) = 0 := by
      rw [hnodal, hmE, Polynomial.map_map, hφψ, Polynomial.eval_map, ← Polynomial.hom_eval₂,
        ← Polynomial.aeval_def, minpoly.aeval, map_zero]
    refine ⟨fun k => Polynomial.eval (ψ θ) ((Lagrange.basis Finset.univ t k).map φ), ?_, ?_⟩
    · rw [← Polynomial.eval_finset_sum, ← Polynomial.map_sum,
        Lagrange.sum_basis htinj.injOn hnonempty, Polynomial.map_one, Polynomial.eval_one]
    · intro k x
      have hkθ : Polynomial.eval (ψ θ) ((Lagrange.basis Finset.univ t k).map φ) *
          (ψ θ - φ (t k)) = 0 := by
        have e := congrArg (fun p => Polynomial.eval (ψ θ) (p.map φ)) (hmulL k)
        simp only [Polynomial.map_mul, Polynomial.eval_mul, Polynomial.map_sub,
          Polynomial.map_X, Polynomial.map_C, Polynomial.eval_sub, Polynomial.eval_X,
          Polynomial.eval_C] at e
        rw [hnodal0, mul_zero] at e
        rw [mul_comm]; exact e
      have hx : x ∈ Algebra.adjoin F {θ} := hadj ▸ Algebra.mem_top
      rw [Algebra.adjoin_singleton_eq_range_aeval] at hx
      obtain ⟨P, hP⟩ := hx
      have hP' : Polynomial.aeval θ P = x := hP
      rw [← hP']
      have e1 : ψ (Polynomial.aeval θ P) =
          Polynomial.eval (ψ θ) (P.map (ψ.comp (algebraMap F E))) := by
        rw [Polynomial.eval_map, Polynomial.aeval_def, Polynomial.hom_eval₂]
      have e2 : φ ((γ₀ ^ (k : ℕ)) (Polynomial.aeval θ P)) =
          Polynomial.eval (φ (t k)) (P.map (ψ.comp (algebraMap F E))) := by
        have : (γ₀ ^ (k : ℕ)) (Polynomial.aeval θ P) = Polynomial.aeval (t k) P :=
          (Polynomial.aeval_algHom_apply (γ₀ ^ (k : ℕ)).toAlgHom θ P).symm
        rw [this, Polynomial.eval_map, ← hφψ, Polynomial.aeval_def, Polynomial.hom_eval₂]
      obtain ⟨c, hc⟩ := Polynomial.sub_dvd_eval_sub (ψ θ) (φ (t k))
        (P.map (ψ.comp (algebraMap F E)))
      show Polynomial.eval (ψ θ) ((Lagrange.basis Finset.univ t k).map φ) *
        (ψ (Polynomial.aeval θ P) - φ ((γ₀ ^ (k : ℕ)) (Polynomial.aeval θ P))) = 0
      rw [e1, e2, hc, ← mul_assoc, hkθ, zero_mul]

  have wc_scheme_split_of_partition : ∀ (W : Scheme.{u}) (R : CommRingCat.{u})
      (α β : W ⟶ Spec R) (n : ℕ) (γ : Fin n → (R ⟶ R)) (v : Fin n → Γ(W, ⊤))
      (hv : ∑ k, v k = 1)
      (hvk : ∀ (k : Fin n) (x : R), v k * ((β.appTop).hom ((Scheme.ΓSpecIso R).inv.hom x) -
        (α.appTop).hom ((Scheme.ΓSpecIso R).inv.hom ((γ k).hom x))) = 0),
      ∃ U : Fin n → W.Opens, (∀ x : W, ∃ k, x ∈ U k) ∧ (∀ k, QuasiCompact (U k).ι) ∧
        ∀ k, (U k).ι ≫ β = (U k).ι ≫ α ≫ Spec.map (γ k) := by
    intro W R α β n γ v hv hvk
    refine ⟨fun k => W.basicOpen (v k), ?_, fun k => inferInstance, ?_⟩
    · intro x
      by_contra hx
      push_neg at hx
      have hnu : ∀ k, (W.presheaf.germ ⊤ x trivial).hom (v k) ∈ nonunits _ := by
        intro k hk
        exact hx k ((W.mem_basicOpen (v k) x trivial).mpr hk)
      have hsum : (W.presheaf.germ ⊤ x trivial).hom (∑ k, v k) ∈ nonunits _ := by
        rw [map_sum]
        refine Finset.sum_induction _ (· ∈ nonunits _)
          (fun a b ha hb => IsLocalRing.nonunits_add ha hb) ?_ (fun k _ => hnu k)
        exact zero_mem_nonunits.mpr zero_ne_one
      rw [hv, map_one] at hsum
      exact hsum isUnit_one
    · intro k
      apply ext_of_isAffine
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
      ext y
      obtain ⟨x, rfl⟩ : ∃ x, (Scheme.ΓSpecIso R).inv.hom x = y :=
        ⟨(Scheme.ΓSpecIso R).hom.hom y, by simp⟩
      have hnat := congrArg (fun f => f.hom x) (Scheme.ΓSpecIso_inv_naturality (γ k))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hnat
      simp only [CommRingCat.hom_comp, RingHom.comp_apply]
      rw [← hnat]
      have hu' : IsUnit ((W.basicOpen (v k)).ι.appTop.hom (v k)) := by
        have hA : (W.basicOpen (v k)).ι ''ᵁ ⊤ ≤ W.basicOpen (v k) :=
          (Scheme.Opens.ι_image_top _).le
        have hu0 := (RingedSpace.isUnit_res_basicOpen W.toRingedSpace (v k)).map
          (W.presheaf.map (homOfLE hA).op).hom
        rw [Scheme.Opens.ι_appTop]
        refine (congrArg IsUnit ?_).mp hu0
        change (W.presheaf.map (homOfLE _).op ≫ W.presheaf.map (homOfLE hA).op).hom (v k) = _
        rw [← Functor.map_comp]
        rfl
      have h0 := congrArg ((W.basicOpen (v k)).ι.appTop.hom) (hvk k x)
      rw [map_mul, map_sub, map_zero] at h0
      exact sub_eq_zero.mp ((hu'.mul_right_eq_zero).mp h0)

  have wc_proet_finite_cover_mem : ∀ (S : Scheme.{u}) (Z : S.ProEt) (ι : Type) [Finite ι]
      (V : ι → S.ProEt) (h : ∀ i, V i ⟶ Z)
      (hqc : ∀ i, QuasiCompact (h i).left)
      (hsurj : ∀ x : Z.left, ∃ i, x ∈ Set.range (h i).left),
      Sieve.generate (Presieve.ofArrows V h) ∈ Scheme.ProEt.topology S Z := by
    intro S Z ι _ V h hqc hsurj
    rw [Scheme.ProEt.topology, Precoverage.mem_toGrothendieck_iff]
    apply Precoverage.Saturate.of
    change Presieve.map (Scheme.ProEt.forget S ⋙ Over.forget S) (Presieve.ofArrows V h) ∈
      Scheme.proetalePrecoverage.coverings _
    rw [Presieve.map_ofArrows]
    refine ⟨?_, ?_⟩
    · have hs' : ∀ x : Z.left, ∃ i, ∃ y, (h i).left y = x := by
        intro x
        obtain ⟨i, y, hy⟩ := hsurj x
        exact ⟨i, y, hy⟩
      let 𝒰 : Scheme.Cover (Scheme.precoverage (⊤ : MorphismProperty Scheme)) Z.left :=
        Scheme.Cover.mkOfCovers ι (fun i => (V i).left) (fun i => (h i).left) hs'
          (fun _ => trivial)
      haveI : ∀ i : 𝒰.I₀, QuasiCompact (𝒰.f i) := fun i => hqc i
      haveI : Finite 𝒰.I₀ := (inferInstance : Finite ι)
      have h1 : QuasiCompactCover 𝒰.toPreZeroHypercover := QuasiCompactCover.of_finite
      exact Scheme.presieve₀_mem_qcPrecoverage_iff.mpr h1
    · refine (Scheme.ofArrows_mem_precoverage_iff _).mpr ⟨fun x => hsurj x, fun i => ?_⟩
      haveI : WeaklyEtale Z.hom := Z.prop
      haveI : WeaklyEtale ((h i).left ≫ Z.hom) := by
        rw [MorphismProperty.Over.w (h i)]; exact (V i).prop
      exact WeaklyEtale.of_comp (h i).left Z.hom

  have wc_ext_lifts_deck : ∀ (τ₀ : E →ₐ[F] AlgebraicClosure F) (γ₀ : E ≃ₐ[F] E)
      (hτ : ∀ x : E, τ₀ (γ₀ x) =
        (@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
          (AlgebraicClosure F) _ _ _).symm (τ₀ x))
      (hγ : γ₀ ^ Module.finrank F E = 1),
      ∃ (s : ℕ → (wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt)))
        (σ : ℕ → @Quiver.Hom X.left.ProEt _ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU)
          (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU)),
        (∀ j, s (j + 1) = wcGeomFrob F X h ≫ s j) ∧ s (Module.finrank F E) = s 0 ∧
        (∀ j, s j = s 0 ≫ σ j) ∧ (∀ j k, σ j ≫ σ k = σ (j + k)) ∧
        (∀ j, σ (j + Module.finrank F E) = σ j) ∧
        ∀ j, (σ j).left ≫ Limits.pullback.snd X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
          Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) ≫
            Spec.map (CommRingCat.ofHom ((γ₀ ^ j : E ≃ₐ[F] E) : E →+* E)) := by
    intro τ₀ γ₀ hτ hγ
    set fE := Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) with hfE
    set sE := Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) with hsE
    set f0 := Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) with hf0
    set s0 := Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) with hs0
    let g : ℕ → (E →+* E) := fun j => ((γ₀ ^ j : E ≃ₐ[F] E) : E →+* E)
    let Fr : AlgebraicClosure F →+* AlgebraicClosure F :=
      ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F)
            (AlgebraicClosure F) _ _ _).symm : AlgebraicClosure F →+* AlgebraicClosure F)
    let τ : E →+* AlgebraicClosure F := (τ₀ : E →+* AlgebraicClosure F)
    have hgalg : ∀ j, (g j).comp (algebraMap F E) = algebraMap F E := fun j =>
      RingHom.ext fun c => (γ₀ ^ j).commutes c
    have hτalg : τ.comp (algebraMap F E) = algebraMap F (AlgebraicClosure F) :=
      RingHom.ext fun c => τ₀.commutes c
    have hgmul : ∀ j k, (g j).comp (g k) = g (j + k) := by
      intro j k
      ext x
      show (γ₀ ^ j) ((γ₀ ^ k) x) = (γ₀ ^ (j + k)) x
      rw [pow_add, AlgEquiv.mul_apply]
    have hgper : ∀ j, g (j + Module.finrank F E) = g j := by
      intro j
      show ((γ₀ ^ (j + Module.finrank F E) : E ≃ₐ[F] E) : E →+* E) =
        ((γ₀ ^ j : E ≃ₐ[F] E) : E →+* E)
      rw [pow_add, hγ, mul_one]
    have hFrτ : Fr.comp τ = τ.comp (g 1) := by
      ext x
      show Fr (τ₀ x) = τ₀ ((γ₀ ^ 1) x)
      rw [pow_one, hτ]
      rfl
    have wj : ∀ j, fE ≫ X.hom = (sE ≫ Spec.map (CommRingCat.ofHom (g j))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F E)) := by
      intro j
      rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hgalg]
      exact Limits.pullback.condition
    have w0 : f0 ≫ X.hom = (s0 ≫ Spec.map (CommRingCat.ofHom τ)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F E)) := by
      rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hτalg]
      exact Limits.pullback.condition
    obtain ⟨σl, hσfst, hσsnd⟩ : ∃ σl : ℕ → (Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F E))) ⟶
        Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))),
        (∀ j, σl j ≫ fE = fE) ∧ (∀ j, σl j ≫ sE = sE ≫ Spec.map (CommRingCat.ofHom (g j))) :=
      ⟨fun j => Limits.pullback.lift fE (sE ≫ Spec.map (CommRingCat.ofHom (g j))) (wj j),
        fun j => Limits.pullback.lift_fst _ _ _, fun j => Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨s0l, hs0f, hs0s⟩ : ∃ s0l : Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⟶
        Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))),
        s0l ≫ fE = f0 ∧ s0l ≫ sE = s0 ≫ Spec.map (CommRingCat.ofHom τ) :=
      ⟨Limits.pullback.lift f0 (s0 ≫ Spec.map (CommRingCat.ofHom τ)) w0,
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨Frl, hFl, hFf, hFs⟩ : ∃ m : Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⟶
        Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))),
        (wcGeomFrob F X h).left = m ∧ m ≫ f0 = f0 ∧
          m ≫ s0 = s0 ≫ Spec.map (CommRingCat.ofHom Fr) :=
      ⟨(wcGeomFrob F X h).left, rfl, MorphismProperty.Over.w (wcGeomFrob F X h),
        Limits.pullback.lift_snd _ _ _⟩
    have hσmul : ∀ j k, σl j ≫ σl k = σl (j + k) := by
      intro j k
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hσfst, hσfst, hσfst]
      · rw [Category.assoc, hσsnd, ← Category.assoc, hσsnd, Category.assoc, ← Spec.map_comp,
          ← CommRingCat.ofHom_comp, hσsnd, hgmul]
    have hσper : ∀ j, σl (j + Module.finrank F E) = σl j := by
      intro j
      apply Limits.pullback.hom_ext
      · rw [hσfst, hσfst]
      · rw [hσsnd, hσsnd, hgper]
    have hkey : Frl ≫ s0l = s0l ≫ σl 1 := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hs0f, hFf, Category.assoc, hσfst, hs0f]
      · rw [Category.assoc, hs0s, ← Category.assoc, hFs, Category.assoc, ← Spec.map_comp,
          ← CommRingCat.ofHom_comp, Category.assoc, hσsnd, ← Category.assoc, hs0s,
          Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hFrτ]
    have hsl : ∀ j, (s0l ≫ σl j) ≫ fE = f0 := by
      intro j
      rw [Category.assoc, hσfst, hs0f]
    have hstep : ∀ j, s0l ≫ σl (j + 1) = Frl ≫ (s0l ≫ σl j) := by
      intro j
      rw [← Category.assoc, hkey, Category.assoc, hσmul, Nat.add_comm]
    refine ⟨fun j => MorphismProperty.Over.homMk (s0l ≫ σl j) (hsl j) trivial,
      fun j => MorphismProperty.Over.homMk (σl j) (hσfst j) trivial, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro j
      exact MorphismProperty.Over.Hom.ext
        ((hstep j).trans (congrArg (fun m => m ≫ (s0l ≫ σl j)) hFl.symm))
    · exact MorphismProperty.Over.Hom.ext
        (congrArg (fun m => s0l ≫ m) ((congrArg σl (Nat.zero_add _).symm).trans (hσper 0)))
    · intro j
      exact MorphismProperty.Over.Hom.ext
        ((congrArg (fun m => s0l ≫ m)
          ((hσmul 0 j).trans (congrArg σl (Nat.zero_add j))).symm).trans
          (Category.assoc _ _ _).symm)
    · intro j k
      exact MorphismProperty.Over.Hom.ext (hσmul j k)
    · intro j
      exact MorphismProperty.Over.Hom.ext (hσper j)
    · intro j
      exact hσsnd j

  have wc_deck_local_split : ∀ (γ₀ : E ≃ₐ[F] E)
      (σ : ℕ → @Quiver.Hom X.left.ProEt _ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU)
          (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU))
      (hσ : ∀ j, (σ j).left ≫ Limits.pullback.snd X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
          Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) ≫
            Spec.map (CommRingCat.ofHom ((γ₀ ^ j : E ≃ₐ[F] E) : E →+* E)))
      (hsplit : ∀ (W : Scheme.{u}) (α β : W ⟶ Spec (.of E)),
          α ≫ Spec.map (CommRingCat.ofHom (algebraMap F E)) =
            β ≫ Spec.map (CommRingCat.ofHom (algebraMap F E)) →
          ∃ U : Fin (Module.finrank F E) → W.Opens, (∀ x : W, ∃ k, x ∈ U k) ∧
            (∀ k, QuasiCompact (U k).ι) ∧
            ∀ k, (U k).ι ≫ β = (U k).ι ≫ α ≫
              Spec.map (CommRingCat.ofHom ((γ₀ ^ (k : ℕ) : E ≃ₐ[F] E) : E →+* E)))
      (Z : X.left.ProEt)
      (a b : @Quiver.Hom X.left.ProEt _ Z (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU)),
      ∃ (V : Fin (Module.finrank F E) → X.left.ProEt) (i : ∀ k, V k ⟶ Z),
        (∀ k, QuasiCompact (i k).left) ∧ (∀ x : Z.left, ∃ k, x ∈ Set.range (i k).left) ∧
        ∀ k, i k ≫ b = i k ≫ a ≫ σ k := by
    intro γ₀ σ hσ hsplit Z a b
    have hwa : a.left ≫ Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F E))) = Z.hom := MorphismProperty.Over.w a
    have hwb : b.left ≫ Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F E))) = Z.hom := MorphismProperty.Over.w b
    have hws : ∀ j, (σ j).left ≫ Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
        Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) :=
      fun j => MorphismProperty.Over.w (σ j)
    have hab : (a.left ≫ Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap F E)) =
        (b.left ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap F E)) :=
      ((Category.assoc _ _ _).trans ((congrArg (fun t => a.left ≫ t)
        Limits.pullback.condition.symm).trans ((Category.assoc _ _ _).symm.trans
          (congrArg (fun t => t ≫ X.hom) hwa)))).trans
      ((Category.assoc _ _ _).trans ((congrArg (fun t => b.left ≫ t)
        Limits.pullback.condition.symm).trans ((Category.assoc _ _ _).symm.trans
          (congrArg (fun t => t ≫ X.hom) hwb)))).symm
    obtain ⟨U, hcov, hqc, heq⟩ := hsplit Z.left _ _ hab
    haveI : WeaklyEtale Z.hom := Z.prop
    refine ⟨fun k => MorphismProperty.Over.mk ⊤ ((U k).ι ≫ Z.hom) inferInstance,
      fun k => MorphismProperty.Over.homMk (U k).ι rfl trivial, fun k => hqc k, ?_, ?_⟩
    · intro x
      obtain ⟨k, hk⟩ := hcov x
      exact ⟨k, ⟨⟨x, hk⟩, rfl⟩⟩
    · intro k
      apply MorphismProperty.Over.Hom.ext
      show (U k).ι ≫ b.left = (U k).ι ≫ a.left ≫ (σ k).left
      apply Limits.pullback.hom_ext
      · exact ((Category.assoc _ _ _).trans (congrArg (fun t => (U k).ι ≫ t) hwb)).trans
          ((Category.assoc _ _ _).trans (congrArg (fun t => (U k).ι ≫ t)
            ((Category.assoc _ _ _).trans ((congrArg (fun t => a.left ≫ t) (hws k)).trans
              hwa)))).symm
      · exact ((Category.assoc _ _ _).trans (heq k)).trans
          ((Category.assoc _ _ _).trans (congrArg (fun t => (U k).ι ≫ t)
            ((Category.assoc _ _ _).trans ((congrArg (fun t => a.left ≫ t) (hσ k)).trans
              (Category.assoc _ _ _).symm)))).symm

  have wc_free_sheaf_hom_equiv : ∀ (S : Scheme.{u})
      (M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      ∃ Θ : ∀ V : S.ProEt, (wcFreeSheaf S V ⟶ M) ≃+ M.obj.obj (Opposite.op V),
        ∀ (V W : S.ProEt) (f : W ⟶ V) (g : wcFreeSheaf S V ⟶ M),
          Θ W (wcFreeSheafMap S f ≫ g) = (M.obj.map f.op).hom (Θ V g) := by
    intro S M
    let P : S.ProEt → (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} := fun V =>
      yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let η : ∀ V : S.ProEt, P V ⟶ (wcFreeSheaf S V).obj := fun V =>
      toSheafify (Scheme.ProEt.topology S) (P V)
    let gen : ∀ {V W : S.ProEt} (k : W ⟶ V), (P V).obj (Opposite.op W) :=
      fun k => FreeAbelianGroup.of (ULift.up k)
    have hgen : ∀ {V W : S.ProEt} (k : W ⟶ V), (P V).map k.op (gen (𝟙 V)) = gen k := by
      intro V W k
      simp only [P, gen, Functor.comp_map]
      rw [AddCommGrpCat.free_map_coe]
      refine (FreeAbelianGroup.map_pure _ _).trans ?_
      exact congrArg FreeAbelianGroup.of (ULift.ext _ _ (Category.comp_id k))
    have hwh : ∀ {V W : S.ProEt} (f : W ⟶ V),
        (Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op W) (gen (𝟙 W)) = gen f := by
      intro V W f
      simp only [gen, Functor.whiskerRight_app, Functor.comp_map]
      rw [AddCommGrpCat.free_map_coe]
      refine (FreeAbelianGroup.map_pure _ _).trans ?_
      exact congrArg FreeAbelianGroup.of (ULift.ext _ _ (Category.id_comp f))
    have hPc : ∀ {V : S.ProEt} {W W' : (S.ProEt)ᵒᵖ} (c : W ⟶ W')
        (k : ULift.{u+1} (W.unop ⟶ V)),
        ((P V).map c).hom (FreeAbelianGroup.of k) =
          FreeAbelianGroup.of (ULift.up (c.unop ≫ k.down)) := by
      intro V W W' c k
      simp only [P, Functor.comp_map]
      rw [AddCommGrpCat.free_map_coe]
      exact FreeAbelianGroup.map_pure _ _
    let ev : ∀ V : S.ProEt, (wcFreeSheaf S V ⟶ M) →+ M.obj.obj (Opposite.op V) := fun V =>
      { toFun := fun g => (g.hom.app (Opposite.op V)) (((η V).app (Opposite.op V)) (gen (𝟙 V)))
        map_zero' := rfl
        map_add' := fun g h => by
          simp only [Sheaf.Hom.add_app]
          rfl }
    have key : ∀ (V W : S.ProEt) (k : W ⟶ V) (g : wcFreeSheaf S V ⟶ M),
        (g.hom.app (Opposite.op W)) (((η V).app (Opposite.op W)) (gen k)) =
          (M.obj.map k.op).hom (ev V g) := by
      intro V W k g
      have h1 := congrArg (fun φ => φ (gen (𝟙 V))) ((η V ≫ g.hom).naturality k.op)
      simp only [NatTrans.comp_app, ConcreteCategory.comp_apply] at h1
      rw [hgen] at h1
      exact h1
    have hinj : ∀ V, Function.Injective (ev V) := by
      intro V g g' hgg
      have hη : η V ≫ g.hom = η V ≫ g'.hom := by
        apply NatTrans.ext
        funext W
        apply AddCommGrpCat.hom_ext
        apply FreeAbelianGroup.lift_ext
        intro k
        obtain ⟨k⟩ := k
        have e1 := key V W.unop k g
        have e2 := key V W.unop k g'
        exact e1.trans (hgg ▸ e2.symm)
      exact (sheafToPresheaf _ _).map_injective
        (sheafify_hom_ext (Scheme.ProEt.topology S) g.hom g'.hom M.property hη)
    have hsurj : ∀ V, Function.Surjective (ev V) := by
      intro V t
      let φ : P V ⟶ M.obj :=
        { app := fun W => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun k : ULift.{u+1} (W.unop ⟶ V) => (M.obj.map k.down.op).hom t))
          naturality := fun W W' c => by
            apply AddCommGrpCat.hom_ext
            apply FreeAbelianGroup.lift_ext
            intro k
            obtain ⟨k⟩ := k
            show (FreeAbelianGroup.lift
                (fun k : ULift.{u+1} (W'.unop ⟶ V) => (M.obj.map k.down.op).hom t))
                (((P V).map c).hom (FreeAbelianGroup.of (ULift.up k))) =
              (M.obj.map c).hom ((FreeAbelianGroup.lift
                (fun k : ULift.{u+1} (W.unop ⟶ V) => (M.obj.map k.down.op).hom t))
                (FreeAbelianGroup.of (ULift.up k)))
            rw [hPc, FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of, op_comp,
              Functor.map_comp, AddCommGrpCat.hom_comp]
            rfl }
      let g0 : (wcFreeSheaf S V).obj ⟶ M.obj :=
        sheafifyLift (Scheme.ProEt.topology S) φ M.property
      have hg0 : η V ≫ g0 = φ := toSheafify_sheafifyLift _ _ _
      refine ⟨(sheafToPresheaf _ _).preimage g0, ?_⟩
      have hpre : ((sheafToPresheaf _ _).preimage g0 : wcFreeSheaf S V ⟶ M).hom = g0 :=
        (sheafToPresheaf _ _).map_preimage g0
      show (((sheafToPresheaf _ _).preimage g0 : wcFreeSheaf S V ⟶ M).hom.app (Opposite.op V))
        (((η V).app (Opposite.op V)) (gen (𝟙 V))) = t
      rw [hpre]
      have h2 := congrArg (fun ψ => (ψ.app (Opposite.op V)) (gen (𝟙 V))) hg0
      simp only [NatTrans.comp_app, ConcreteCategory.comp_apply] at h2
      refine h2.trans ?_
      show (FreeAbelianGroup.lift
          (fun k : ULift.{u+1} (V ⟶ V) => (M.obj.map k.down.op).hom t))
          (FreeAbelianGroup.of (ULift.up (𝟙 V))) = t
      rw [FreeAbelianGroup.lift_apply_of, op_id, M.obj.map_id]
      rfl
    refine ⟨fun V => AddEquiv.ofBijective (ev V) ⟨hinj V, hsurj V⟩, ?_⟩
    intro V W f g
    show ((wcFreeSheafMap S f ≫ g).hom.app (Opposite.op W))
        (((η W).app (Opposite.op W)) (gen (𝟙 W))) = (M.obj.map f.op).hom (ev V g)
    have h3 := congrArg (fun ψ => ψ.app (Opposite.op W) (gen (𝟙 W)))
      (toSheafify_naturality (Scheme.ProEt.topology S)
        (Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
    simp only [NatTrans.comp_app, ConcreteCategory.comp_apply] at h3
    rw [hwh] at h3
    refine Eq.trans ?_ (key V W f g)
    exact (congrArg (fun x => (g.hom.app (Opposite.op W)) x) h3).symm

  have wc_free_sheaf_descent : ∀ (S : Scheme.{u})
      (M : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (Θ : ∀ V : S.ProEt, (wcFreeSheaf S V ⟶ M) ≃+ M.obj.obj (Opposite.op V))
      (hΘ : ∀ (V W : S.ProEt) (f : W ⟶ V) (g : wcFreeSheaf S V ⟶ M),
        Θ W (wcFreeSheafMap S f ≫ g) = (M.obj.map f.op).hom (Θ V g))
      (U T : S.ProEt) (p : U ⟶ T)
      (hp : Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology S T)
      (Φ : wcFreeSheaf S U ⟶ M)
      (hΦ : ∀ (Z : S.ProEt) (a b : Z ⟶ U), a ≫ p = b ≫ p →
        ∃ R : Sieve Z, R ∈ Scheme.ProEt.topology S Z ∧
          ∀ (Y : S.ProEt) (c : Y ⟶ Z), R.arrows c →
            wcFreeSheafMap S (c ≫ a) ≫ Φ = wcFreeSheafMap S (c ≫ b) ≫ Φ),
      ∃ N : wcFreeSheaf S T ⟶ M, wcFreeSheafMap S p ≫ N = Φ := by
    intro S M Θ hΘ U T p hp Φ hΦ
    have hP : Presheaf.IsSheaf (Scheme.ProEt.topology S) (M.obj ⋙ forget AddCommGrpCat) :=
      Presheaf.isSheaf_comp_of_isSheaf _ M.obj (forget AddCommGrpCat) M.property
    have hcomp : ∀ {A B C : S.ProEt} (f : A ⟶ B) (g : B ⟶ C) (x : M.obj.obj (Opposite.op C)),
        (M.obj.map (f ≫ g).op).hom x = (M.obj.map f.op).hom ((M.obj.map g.op).hom x) := by
      intro A B C f g x
      rw [op_comp, Functor.map_comp]
      rfl
    set t := Θ U Φ with ht
    have hsing := (Presieve.isSheafFor_iff_generate (Presieve.singleton p)).mpr
      (hP.isSheafFor _ hp)
    rw [Presieve.isSheafFor_singleton] at hsing
    obtain ⟨tb, htb, -⟩ := hsing t (by
      intro Z a b hab
      obtain ⟨R, hR, hRc⟩ := hΦ Z a b hab
      apply (hP.isSheafFor R hR).isSeparatedFor.ext
      intro Y c hc
      have h1 := hΘ U Y (c ≫ a) Φ
      have h2 := hΘ U Y (c ≫ b) Φ
      rw [hRc Y c hc, h2, hcomp, hcomp] at h1
      exact h1.symm)
    refine ⟨(Θ T).symm tb, (Θ U).injective ?_⟩
    rw [hΘ, AddEquiv.apply_symm_apply]
    exact htb

  obtain ⟨τ₀, γ₀, hτ, hγo⟩ := wc_frob_embedding_data F E
  have hγ : γ₀ ^ Module.finrank F E = 1 := by rw [← hγo]; exact pow_orderOf_eq_one γ₀
  obtain ⟨s, σ, hs1, hsr, hs0, hσσ, hσr, hσsnd⟩ := wc_ext_lifts_deck τ₀ γ₀ hτ hγ

  have hsplit : ∀ (W : Scheme.{u}) (α β : W ⟶ Spec (.of E)),
      α ≫ Spec.map (CommRingCat.ofHom (algebraMap F E)) =
        β ≫ Spec.map (CommRingCat.ofHom (algebraMap F E)) →
      ∃ U : Fin (Module.finrank F E) → W.Opens, (∀ x : W, ∃ k, x ∈ U k) ∧
        (∀ k, QuasiCompact (U k).ι) ∧
        ∀ k, (U k).ι ≫ β = (U k).ι ≫ α ≫
          Spec.map (CommRingCat.ofHom ((γ₀ ^ (k : ℕ) : E ≃ₐ[F] E) : E →+* E)) := by
    intro W α β hαβ
    have e1 : ∀ c : F, (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom (algebraMap F E c) =
        (Spec.map (CommRingCat.ofHom (algebraMap F E))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom c) := by
      intro c
      have := congrArg (fun g => g.hom c)
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap F E)))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this
    have e2 : ∀ (γ : W ⟶ Spec (.of E)) (y : Γ(Spec (.of F), ⊤)),
        γ.appTop.hom ((Spec.map (CommRingCat.ofHom (algebraMap F E))).appTop.hom y) =
          (γ ≫ Spec.map (CommRingCat.ofHom (algebraMap F E))).appTop.hom y := by
      intro γ y
      rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    have hφψ : (α.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom).comp
          (algebraMap F E) =
        (β.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of E)).inv.hom).comp
          (algebraMap F E) := by
      ext c
      simp only [RingHom.comp_apply]
      rw [e1, e2, e2, hαβ]
    obtain ⟨v, hv1, hvk⟩ := wc_galois_lagrange_partition F E γ₀ hγo _ _ _ hφψ
    exact wc_scheme_split_of_partition W (CommRingCat.of E) α β (Module.finrank F E)
      (fun k => CommRingCat.ofHom ((γ₀ ^ (k : ℕ) : E ≃ₐ[F] E) : E →+* E)) v hv1
      (fun k x => hvk k x)

  let pE : @Quiver.Hom X.left.ProEt _ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU) (Scheme.ProEt.mk (𝟙 X.left)) :=
    MorphismProperty.Over.homMk
      (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
      (Category.comp_id _) trivial
  have hp : Sieve.generate (Presieve.singleton pE) ∈
      Scheme.ProEt.topology X.left (Scheme.ProEt.mk (𝟙 X.left)) := by
    have := wc_proet_finite_cover_mem X.left (Scheme.ProEt.mk (𝟙 X.left)) PUnit.{1}
      (fun _ => MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU) (fun _ => pE)
      (fun _ => (inferInstance : QuasiCompact (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E))))))
      (fun x => ⟨PUnit.unit, Surjective.surj (f := Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) x⟩)
    have e := Presieve.ofArrows_pUnit pE
    exact e ▸ this

  have hfun : ∀ {A B C : X.left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap X.left a ≫ wcFreeSheafMap X.left b = wcFreeSheafMap X.left (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      first
        | rw [yoneda.map_comp, Functor.whiskerRight_comp]
        | (apply NatTrans.ext; funext V; simp [← Functor.map_comp])
    exact ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map e)

  have hre : ∀ {A B : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} (f : ℕ → (A ⟶ B)),
      (∀ j, f (j + Module.finrank F E) = f j) → ∀ k : ℕ,
      ∑ j ∈ Finset.range (Module.finrank F E), f (k + j) =
        ∑ j ∈ Finset.range (Module.finrank F E), f j := by
    intro A B f hf k
    induction k with
    | zero => simp only [Nat.zero_add]
    | succ k ih =>
      have h1 := Finset.sum_range_succ' (fun j => f (k + j)) (Module.finrank F E)
      have h2 := Finset.sum_range_succ (fun j => f (k + j)) (Module.finrank F E)
      simp only [Nat.add_zero] at h1 h2
      rw [hf k] at h2
      have e : ∑ j ∈ Finset.range (Module.finrank F E), f (k + 1 + j) =
          ∑ j ∈ Finset.range (Module.finrank F E), f (k + (j + 1)) := by
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Nat.add_assoc, Nat.add_comm 1 j]
      rw [e, ← ih]
      exact add_right_cancel (h1.symm.trans h2)

  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : wcFreeSheaf X.left (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU) ⟶
      wcFreeSheaf X.left (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU),
      Φ = ∑ j ∈ Finset.range (Module.finrank F E), wcFreeSheafMap X.left (σ j) := ⟨_, rfl⟩
  have hshift : ∀ {Y : X.left.ProEt}
      (e : @Quiver.Hom X.left.ProEt _ Y (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU)) (k : ℕ),
      wcFreeSheafMap X.left (e ≫ σ k) ≫ Φ = wcFreeSheafMap X.left e ≫ Φ := by
    intro Y e k
    rw [hΦdef, Preadditive.comp_sum, Preadditive.comp_sum]
    calc ∑ j ∈ Finset.range (Module.finrank F E),
          wcFreeSheafMap X.left (e ≫ σ k) ≫ wcFreeSheafMap X.left (σ j)
        = ∑ j ∈ Finset.range (Module.finrank F E), wcFreeSheafMap X.left (e ≫ σ (k + j)) :=
          Finset.sum_congr rfl (fun j _ => (hfun _ _).trans
            (congrArg (wcFreeSheafMap X.left)
              ((Category.assoc _ _ _).trans (congrArg (fun t => e ≫ t) (hσσ k j)))))
      _ = ∑ j ∈ Finset.range (Module.finrank F E), wcFreeSheafMap X.left (e ≫ σ j) :=
          hre (fun j => wcFreeSheafMap X.left (e ≫ σ j))
            (fun j => congrArg (fun t => wcFreeSheafMap X.left (e ≫ t)) (hσr j)) k
      _ = ∑ j ∈ Finset.range (Module.finrank F E),
          wcFreeSheafMap X.left e ≫ wcFreeSheafMap X.left (σ j) :=
          Finset.sum_congr rfl (fun j _ => (hfun _ _).symm)
  obtain ⟨Θ, hΘ⟩ := wc_free_sheaf_hom_equiv X.left (wcFreeSheaf X.left
    (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU))
  obtain ⟨N, hN⟩ := wc_free_sheaf_descent X.left _ Θ hΘ _ _ pE hp Φ (by
    intro Z a b _
    obtain ⟨V, i, hqc, hsurj, hab⟩ :=
      wc_deck_local_split γ₀ σ hσsnd hsplit Z a b
    refine ⟨Sieve.generate (Presieve.ofArrows V i),
      wc_proet_finite_cover_mem X.left Z (Fin (Module.finrank F E)) V i hqc hsurj, ?_⟩
    intro Y c hc
    rw [Sieve.generate_apply] at hc
    obtain ⟨Y', d, g, hg, rfl⟩ := hc
    obtain ⟨k⟩ := hg
    have e1 : (d ≫ i k) ≫ b = ((d ≫ i k) ≫ a) ≫ σ k :=
      ((Category.assoc _ _ _).trans (congrArg (fun t => d ≫ t) (hab k))).trans
        ((Category.assoc _ _ _).symm.trans (Category.assoc _ _ _).symm)
    exact (congrArg (fun t => wcFreeSheafMap X.left t ≫ Φ) e1).trans (hshift _ k) |>.symm)

  refine ⟨s, N, hs1, hsr, fun π => ?_⟩
  have hl : ∀ {Y : X.left.ProEt} (f : Y ⟶ Scheme.ProEt.mk (𝟙 X.left)), f.left = Y.hom :=
    fun f => (Category.comp_id f.left).symm.trans (MorphismProperty.Over.w f)
  have hπ : π = s 0 ≫ pE :=
    MorphismProperty.Over.Hom.ext ((hl π).trans (hl _).symm)
  calc wcFreeSheafMap X.left π ≫ N
      = wcFreeSheafMap X.left (s 0 ≫ pE) ≫ N :=
        congrArg (fun t => wcFreeSheafMap X.left t ≫ N) hπ
    _ = wcFreeSheafMap X.left (s 0) ≫ (wcFreeSheafMap X.left pE ≫ N) :=
        (congrArg (fun t => t ≫ N) (hfun (s 0) pE).symm).trans (Category.assoc _ _ _)
    _ = wcFreeSheafMap X.left (s 0) ≫ Φ :=
        congrArg (fun t => wcFreeSheafMap X.left (s 0) ≫ t) hN
    _ = ∑ j ∈ Finset.range (Module.finrank F E),
          wcFreeSheafMap X.left (s 0) ≫ wcFreeSheafMap X.left (σ j) :=
        (congrArg (fun t => wcFreeSheafMap X.left (s 0) ≫ t) hΦdef).trans
          (Preadditive.comp_sum _ _ _)
    _ = ∑ j ∈ Finset.range (Module.finrank F E), wcFreeSheafMap X.left (s j) :=
        Finset.sum_congr rfl (fun j _ =>
          (hfun _ _).trans (congrArg (wcFreeSheafMap X.left) (hs0 j).symm))

theorem wc_free_sheaf_map_mono (S : Scheme.{u}) (V U : S.ProEt) (ι : V ⟶ U) (hι : Mono ι.left) :
    Mono (wcFreeSheafMap S ι) :=
by
  haveI : Mono ι := ⟨fun g h e => MorphismProperty.Over.Hom.ext ((cancel_mono ι.left).mp
    (by
      have e' := congrArg (fun t => t.left) e
      first
        | exact e'
        | simpa [MorphismProperty.Comma.comp_left, Comma.comp_left, Over.comp_left] using e'))⟩
  unfold wcFreeSheafMap
  exact Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (Functor.whiskerRight (yoneda.map ι) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))

theorem wc_rpc_geom_point_surj (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt)) :
    Function.Surjective s₀.left :=
by
  classical

  have s1 : ∀ (Y : Scheme.{u}) [IrreducibleSpace Y] [CompactSpace Y],
      ¬ IsNilpotent (1 : Γ(Y, ⊤)) ∧
      ∀ a b : Γ(Y, ⊤), IsNilpotent (a * b) → IsNilpotent a ∨ IsNilpotent b := by
    intro Y _ _
    constructor
    · intro h
      rw [Scheme.isNilpotent_iff_basicOpen_eq_bot, Scheme.basicOpen_one] at h
      obtain ⟨y⟩ := (inferInstance : Nonempty Y)
      have hy : y ∈ (⊤ : Y.Opens) := trivial
      rw [h] at hy
      simp at hy
    · intro a b hab
      by_contra hcon
      rw [not_or] at hcon
      obtain ⟨ha, hb⟩ := hcon
      rw [Scheme.isNilpotent_iff_basicOpen_eq_bot] at hab ha hb
      rw [Scheme.basicOpen_mul] at hab
      have ha' := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp ha
      have hb' := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hb
      obtain ⟨x, hx⟩ := nonempty_preirreducible_inter (Y.basicOpen a).isOpen
        (Y.basicOpen b).isOpen ha' hb'
      have hx' : x ∈ Y.basicOpen a ⊓ Y.basicOpen b := hx
      rw [hab] at hx'
      simp at hx'

  have s2 : ∀ (R : Type u) [CommRing R], ¬ IsNilpotent (1 : R) →
      (∀ a b : R, IsNilpotent (a * b) → IsNilpotent a ∨ IsNilpotent b) →
      ∀ (c : AlgebraicClosure F →+* R) (φ : E →+* R),
      φ.comp (algebraMap F E) = c.comp (algebraMap F (AlgebraicClosure F)) →
      ∃ τ : E →ₐ[F] AlgebraicClosure F, φ = c.comp τ.toRingHom := by
    intro R _ h1 hprime c φ hcomp
    let pb := Field.powerBasisOfFiniteOfSeparable F E
    have hint : IsIntegral F pb.gen := IsIntegral.of_finite F pb.gen
    have hmon : (minpoly F pb.gen).Monic := minpoly.monic hint
    have hsep : (minpoly F pb.gen).Separable := Algebra.IsSeparable.isSeparable F pb.gen
    set fK := (minpoly F pb.gen).map (algebraMap F (AlgebraicClosure F)) with hfK
    have hmonK : fK.Monic := hmon.map _
    have hsepK : fK.Separable := hsep.map
    have hsplit : fK = (fK.roots.map (fun β => Polynomial.X - Polynomial.C β)).prod :=
      (Polynomial.Splits.eq_prod_roots_of_monic (IsAlgClosed.splits fK) hmonK)
    have hnd : fK.roots.Nodup := Polynomial.nodup_roots hsepK
    have hev0 : Polynomial.eval₂ c (φ pb.gen) fK = 0 := by
      rw [hfK, Polynomial.eval₂_map, ← hcomp, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def,
        minpoly.aeval, map_zero]
    have hprod : (fK.roots.map (fun β => φ pb.gen - c β)).prod = 0 := by
      rw [← hev0]
      conv_rhs => rw [hsplit]
      rw [Polynomial.eval₂_multiset_prod, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro β _
      simp
    have hd : ∀ N : Multiset R, IsNilpotent N.prod → ∃ a ∈ N, IsNilpotent a := by
      intro N
      induction N using Multiset.induction_on with
      | empty => intro h; exact absurd (by simpa using h) h1
      | cons a N ih =>
        intro h
        rw [Multiset.prod_cons] at h
        rcases hprime _ _ h with ha | hN
        · exact ⟨a, Multiset.mem_cons_self _ _, ha⟩
        · obtain ⟨b, hb, hb'⟩ := ih hN
          exact ⟨b, Multiset.mem_cons_of_mem hb, hb'⟩
    have hunit : ∀ N : Multiset R, (∀ a ∈ N, IsUnit a) → IsUnit N.prod := by
      intro N
      induction N using Multiset.induction_on with
      | empty => intro _; simp
      | cons a N ih =>
        intro h
        rw [Multiset.prod_cons]
        exact (h a (Multiset.mem_cons_self _ _)).mul
          (ih fun b hb => h b (Multiset.mem_cons_of_mem hb))
    obtain ⟨u, hu, hunil⟩ := hd _ (by rw [hprod]; exact IsNilpotent.zero)
    obtain ⟨β₀, hβ₀, rfl⟩ := Multiset.mem_map.mp hu
    have hP : IsUnit (((fK.roots.erase β₀).map (fun β => φ pb.gen - c β)).prod) := by
      apply hunit
      intro a ha
      obtain ⟨β, hβ, rfl⟩ := Multiset.mem_map.mp ha
      have hne : β ≠ β₀ := ((Multiset.Nodup.mem_erase_iff hnd).mp hβ).1
      have e : φ pb.gen - c β = (φ pb.gen - c β₀) + c (β₀ - β) := by rw [map_sub]; ring
      rw [e]
      exact hunil.isUnit_add_right_of_commute
        ((isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr hne.symm)).map c) (Commute.all _ _)
    have hu0 : φ pb.gen - c β₀ = 0 := by
      have : (fK.roots.map (fun β => φ pb.gen - c β)).prod =
          (φ pb.gen - c β₀) * ((fK.roots.erase β₀).map (fun β => φ pb.gen - c β)).prod := by
        conv_lhs => rw [← Multiset.cons_erase hβ₀]
        rw [Multiset.map_cons, Multiset.prod_cons]
      rw [hprod] at this
      exact (hP.mul_left_eq_zero).mp this.symm
    have hx : φ pb.gen = c β₀ := sub_eq_zero.mp hu0
    have hroot : Polynomial.aeval β₀ (minpoly F pb.gen) = 0 := by
      have := (Polynomial.mem_roots hmonK.ne_zero).mp hβ₀
      rw [Polynomial.IsRoot.def, hfK, Polynomial.eval_map_algebraMap] at this
      exact this
    refine ⟨pb.lift β₀ hroot, ?_⟩
    apply RingHom.ext
    intro y
    obtain ⟨p, rfl⟩ := pb.exists_eq_aeval' y
    rw [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      ← Polynomial.aeval_algHom_apply (pb.lift β₀ hroot),
      PowerBasis.lift_gen, Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.hom_eval₂,
      Polynomial.hom_eval₂, hcomp, hx]

  have s3 : ∀ (Y : Scheme.{u}) (t : Y ⟶ Spec (.of E)) (g : Y ⟶ Spec (.of (AlgebraicClosure F))),
      t ≫ Spec.map (CommRingCat.ofHom (algebraMap F E)) =
        g ≫ Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) →
      (∀ (c : AlgebraicClosure F →+* Γ(Y, ⊤)) (φ : E →+* Γ(Y, ⊤)),
        φ.comp (algebraMap F E) = c.comp (algebraMap F (AlgebraicClosure F)) →
        ∃ τ : E →ₐ[F] AlgebraicClosure F, φ = c.comp τ.toRingHom) →
      ∃ τ : E →ₐ[F] AlgebraicClosure F, t = g ≫ Spec.map (CommRingCat.ofHom τ.toRingHom) := by
    intro Y t g hw alg
    let φ : E →+* Γ(Y, ⊤) := ((Scheme.ΓSpecIso (.of E)).inv ≫ t.appTop).hom
    let c : AlgebraicClosure F →+* Γ(Y, ⊤) :=
      ((Scheme.ΓSpecIso (.of (AlgebraicClosure F))).inv ≫ g.appTop).hom
    have hcomp : φ.comp (algebraMap F E) = c.comp (algebraMap F (AlgebraicClosure F)) := by
      have h := congrArg Scheme.Hom.appTop hw
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop] at h
      have h2 := congrArg (fun z => (Scheme.ΓSpecIso (.of F)).inv ≫ z) h
      have kE := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap F E))
      have kK := Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
      have h3 : CommRingCat.ofHom (algebraMap F E) ≫ (Scheme.ΓSpecIso (.of E)).inv ≫ t.appTop =
          CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)) ≫
            (Scheme.ΓSpecIso (.of (AlgebraicClosure F))).inv ≫ g.appTop := by
        rw [← Category.assoc, kE, ← Category.assoc, kK, Category.assoc, Category.assoc]
        exact h2
      have h4 := congrArg CommRingCat.Hom.hom h3
      exact h4
    obtain ⟨τ, hτ⟩ := alg c φ hcomp
    refine ⟨τ, ?_⟩
    have key := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom τ.toRingHom)
    apply ext_of_isAffine
    rw [Scheme.Hom.comp_appTop, ← cancel_epi (Scheme.ΓSpecIso (.of E)).inv, ← Category.assoc,
      ← key, Category.assoc]
    apply CommRingCat.hom_ext
    exact hτ

  have main : ∀ (s : Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⟶
        Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))),
      s ≫ Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
        Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) →
      Function.Surjective s := by
    intro s hw0
    haveI : IrreducibleSpace ↥(Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) : Scheme.{u}) :=
      GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
        (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
    haveI : CompactSpace ↥(Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) : Scheme.{u}) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
    have ht : (s ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F E)) =
        Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) := by
      rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hw0,
        Limits.pullback.condition]
    obtain ⟨hn1, hnp⟩ := s1 (Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
    obtain ⟨τ, hτ⟩ := s3 _ _ _ ht (fun c φ hc => s2 _ hn1 hnp c φ hc)
    have hbot : Spec.map (CommRingCat.ofHom τ.toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F E)) =
        Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      exact τ.comp_algebraMap
    have hsq : IsPullback s
        (Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
        (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
        (Spec.map (CommRingCat.ofHom τ.toRingHom)) := by
      apply IsPullback.of_right
        (h₁₂ := Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
        (v₁₃ := X.hom) (h₂₂ := Spec.map (CommRingCat.ofHom (algebraMap F E)))
      · rw [hw0, hbot]
        exact IsPullback.of_hasPullback _ _
      · exact hτ
      · exact IsPullback.of_hasPullback _ _
    have hτs : Surjective (Spec.map (CommRingCat.ofHom τ.toRingHom)) :=
      ⟨fun y => ⟨Classical.arbitrary _, Subsingleton.elim _ _⟩⟩
    exact (MorphismProperty.of_isPullback (P := @Surjective) hsq.flip hτs).surj
  exact main s₀.left (MorphismProperty.Over.w s₀)

theorem wc_et_extzero_module_mono : ∀ (Y : Scheme.{u}) (U : Y.Opens) (ℓ : ℕ), 0 < ℓ → ∃ (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (ι : N ⟶ SheafOfModules.unit (wcEtZModRing Y ℓ)), Mono ι ∧ Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅ wcEtExtZero Y (U : Set Y) ℓ) :=
by
  classical
  intro Y U ℓ _hℓ
  obtain ⟨α, hinj, hsurj, hR⟩ := wc_et_zmod_ring_locbij Y ℓ
  obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y)
    (wcEtZModRing Y ℓ) ℓ α hinj hsurj
  haveI := hfull
  obtain ⟨κ⟩ := wc_et_zmod_unit_toSheaf_iso Y ℓ



  let θ : wcEtExtZeroPre Y (U : Set Y) ℓ ⟶
      (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) :=
    { app := fun V => AddCommGrpCat.ofHom
        (wcSuppSub.{u} ℓ (∀ x, V.unop.hom x ∈ (U : Set Y))).subtype
      naturality := fun _ _ _ => rfl }
  have hθ : Mono θ := by
    haveI : ∀ V, Mono (θ.app V) := by
      intro V
      rw [AddCommGrpCat.mono_iff_injective]
      exact AddSubgroup.subtype_injective _
    exact NatTrans.mono_of_mono_app _
  have hθs : Mono ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map θ) :=
    Functor.map_mono _ _
  haveI hι₀ : Mono (wcEtExtZeroι Y (U : Set Y) ℓ) := by
    first
      | exact hθs
      | (unfold wcEtExtZeroι; exact hθs)
      | (delta wcEtExtZeroι; exact hθs)



  have hev : ∀ {M M' : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (f : M ⟶ M')
      (V : (Y.Etale)ᵒᵖ), f.val.app V = (SheafOfModules.forget (wcEtZModRing Y ℓ) ⋙
        PresheafOfModules.evaluation (wcEtZModRing Y ℓ).obj V).map f :=
    fun _ _ => rfl
  have hnsmulApp : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (V : (Y.Etale)ᵒᵖ),
      (ℓ • 𝟙 M).val.app V = ℓ • 𝟙 (M.val.obj V) := by
    intro M V
    rw [hev, CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl
  have hzeroApp : ∀ (M M' : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (V : (Y.Etale)ᵒᵖ),
      (0 : M ⟶ M').val.app V = 0 := by
    intro M M' V
    rw [hev, CategoryTheory.Functor.map_zero]
    rfl
  have hkillM : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ), ℓ • 𝟙 M = 0 := by
    intro M
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    rw [hnsmulApp, hzeroApp]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    rw [ModuleCat.hom_nsmul, ModuleCat.hom_id, ModuleCat.hom_zero, LinearMap.smul_apply,
      LinearMap.id_apply, LinearMap.zero_apply,
      ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Y ℓ).obj.obj V), hR V, zero_smul]
  have htorF : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ),
      ℓ • 𝟙 ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).obj M) = 0 := by
    intro M
    rw [← (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map_id, ← Functor.map_nsmul,
      hkillM M, Functor.map_zero]



  have hE : ℓ • 𝟙 (wcEtExtZero Y (U : Set Y) ℓ) = 0 := by
    rw [← cancel_mono (wcEtExtZeroι Y (U : Set Y) ℓ ≫ κ.inv), Limits.zero_comp,
      Preadditive.nsmul_comp, Category.id_comp]
    have h1 : (wcEtExtZeroι Y (U : Set Y) ℓ ≫ κ.inv) ≫
        (ℓ • 𝟙 ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).obj
          (SheafOfModules.unit (wcEtZModRing Y ℓ)))) = 0 := by
      rw [htorF, Limits.comp_zero]
    rw [Preadditive.comp_nsmul, Category.comp_id] at h1
    exact h1



  obtain ⟨N, ⟨e⟩⟩ := hess _ hE
  let ι : N ⟶ SheafOfModules.unit (wcEtZModRing Y ℓ) :=
    (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).preimage
      (e.hom ≫ wcEtExtZeroι Y (U : Set Y) ℓ ≫ κ.inv)
  have hg : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map ι =
      e.hom ≫ wcEtExtZeroι Y (U : Set Y) ℓ ≫ κ.inv :=
    (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map_preimage _
  haveI hmg : Mono ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).map ι) := by
    rw [hg]; infer_instance
  haveI : Mono ι := (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y ℓ)).mono_of_mono_map hmg
  exact ⟨N, ι, inferInstance, ⟨e⟩⟩

theorem wc_et_extzero_to_point_supp_zero : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (ℓ : ℕ) (y₀ : Spec (.of K) ⟶ Y) (Dy : wcEtPullData y₀ ℓ) (U : Y.Opens), y₀ (IsLocalRing.closedPoint K) ∉ U → ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (g : N ⟶ wcEtSuppObj Dy), Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅ wcEtExtZero Y (U : Set Y) ℓ) → g = 0 :=
by
  classical
  intro K _ Y ℓ y₀ Dy U hU N g hN
  obtain ⟨e⟩ := hN

  have hsub : ∀ V : Y.Etale, (∀ x : V.left, V.hom x ∈ (U : Set Y)) →
      Subsingleton ↑(((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj (wcEtSuppObj Dy)).obj.obj
        (Opposite.op V)) := by
    intro V hV
    have hX : IsEmpty ((wcEtBaseChange y₀).obj V).left := by
      constructor
      intro p
      let q : ↥(Limits.pullback V.hom y₀) := p
      have h1 : (Limits.pullback.fst V.hom y₀ ≫ V.hom) q = (Limits.pullback.snd V.hom y₀ ≫ y₀) q := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      have h2 : Limits.pullback.snd V.hom y₀ q = IsLocalRing.closedPoint K := Subsingleton.elim _ _
      apply hU
      have h3 := hV (Limits.pullback.fst V.hom y₀ q)
      rw [h1, h2] at h3
      exact h3
    have hbot : (⊥ : Sieve ((wcEtBaseChange y₀).obj V)) ∈
        Scheme.smallEtaleTopology (Spec (.of K)) ((wcEtBaseChange y₀).obj V) := by
      change (⊥ : Sieve ((wcEtBaseChange y₀).obj V)) ∈
        Scheme.smallGrothendieckTopology @Etale (Spec (.of K)) ((wcEtBaseChange y₀).obj V)
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
        (Spec (.of K)) MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale (Spec (.of K))
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      exact (hX.false x).elim
    have hT := Sheaf.isTerminalOfBotCover
      ((SheafOfModules.toSheaf (wcEtZModRing (Spec (.of K)) ℓ)).obj
        (SheafOfModules.unit (wcEtZModRing (Spec (.of K)) ℓ))) ((wcEtBaseChange y₀).obj V) hbot
    have hss := AddCommGrpCat.isZero_iff_subsingleton.mp hT.isZero
    exact hss

  have key : ∀ h : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (wcEtExtZeroPre Y (U : Set Y) ℓ) ⟶
        (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj (wcEtSuppObj Dy), h = 0 := by
    intro h
    let A := sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}
    apply (A.homEquiv (wcEtExtZeroPre Y (U : Set Y) ℓ)
      ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj (wcEtSuppObj Dy))).injective
    rw [A.homEquiv_unit, A.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
    apply NatTrans.ext
    funext V
    rw [NatTrans.app_zero]
    by_cases hp : ∀ x : V.unop.left, V.unop.hom x ∈ (U : Set Y)
    · haveI := hsub V.unop hp
      exact (AddCommGrpCat.isZero_of_subsingleton
        (((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj (wcEtSuppObj Dy)).obj.obj
          (Opposite.op V.unop))).eq_of_tgt _ _
    · have hbot : wcSuppSub ℓ (∀ x : V.unop.left, V.unop.hom x ∈ (U : Set Y)) = ⊥ := by
        unfold wcSuppSub
        exact iSup_neg hp
      have hs : Subsingleton ↥(wcSuppSub ℓ (∀ x : V.unop.left, V.unop.hom x ∈ (U : Set Y))) := by
        constructor
        intro a b
        have hk : ∀ x : ULift.{u+1} (ZMod ℓ),
            x ∈ wcSuppSub ℓ (∀ x : V.unop.left, V.unop.hom x ∈ (U : Set Y)) → x = 0 := by
          intro x hx
          rw [hbot] at hx
          exact AddSubgroup.mem_bot.mp hx
        exact Subtype.ext ((hk _ a.2).trans (hk _ b.2).symm)
      haveI := hs
      exact (AddCommGrpCat.isZero_of_subsingleton
        (AddCommGrpCat.of ↥(wcSuppSub ℓ (∀ x : V.unop.left, V.unop.hom x ∈ (U : Set Y))))).eq_of_src
          _ _

  apply (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map_injective
  rw [Functor.map_zero]
  have hh : e.inv ≫ (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map g = 0 := key _
  calc (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map g
      = e.hom ≫ (e.inv ≫ (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map g) := by
        rw [Iso.hom_inv_id_assoc]
    _ = 0 := by rw [hh, Limits.comp_zero]

theorem wc_et_open_supp_smooth_stratum : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsSeparated f] [QuasiCompact f] (d : ℕ) [SmoothOfRelativeDimension d f] (U : Y.Opens), U ≠ ⊤ → ∃ (U' : Y.Opens) (e : ℕ) (Z : Scheme.{u}) (i : Z ⟶ (U' : Scheme.{u})), U < U' ∧ IsClosedImmersion i ∧ SmoothOfRelativeDimension e (i ≫ U'.ι ≫ f) ∧ Set.range i = ((U'.ι ⁻¹ᵁ U : (U' : Scheme.{u}).Opens) : Set (U' : Scheme.{u}))ᶜ ∧ SmoothOfRelativeDimension d (U'.ι ≫ f) ∧ IsSeparated (U'.ι ≫ f) ∧ QuasiCompact (U'.ι ≫ f) :=
by
  classical
  intro K _ _ Y f _ _ d _ U hU
  haveI : PerfectField K := IsAlgClosed.perfectField K
  haveI : Smooth f := SmoothOfRelativeDimension.smooth d f
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f

  have s1 : ∀ (A : Type u) [CommRing A] [Algebra K A] [Algebra.FiniteType K A] (I : Ideal A),
      I.IsRadical → I ≠ ⊤ → ∃ (a : A) (e : ℕ),
        (∃ P : PrimeSpectrum A, I ≤ P.asIdeal ∧ a ∉ P.asIdeal) ∧
        Algebra.IsStandardSmoothOfRelativeDimension e K
          (Localization.Away (Ideal.Quotient.mk I a)) := by
    intro A _ _ _ I hI hItop
    have : IsReduced (A ⧸ I) := (Ideal.isRadical_iff_quotient_reduced I).mp hI
    have : Nontrivial (A ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hItop
    have : Algebra.FiniteType K (A ⧸ I) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ K I) (Ideal.Quotient.mkₐ_surjective K I)
    have : Algebra.FinitePresentation K (A ⧸ I) :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    obtain ⟨q, hq⟩ := Ideal.nonempty_minimalPrimes (R := A ⧸ I) (I := ⊥) bot_ne_top
    have hqmin : q ∈ minimalPrimes (A ⧸ I) := hq
    have hqp : q.IsPrime := Ideal.minimalPrimes_isPrime hqmin
    have : Ring.KrullDimLE 0 (Localization.AtPrime q) :=
      Ring.KrullDimLE.of_isLocalization q hqmin (Localization.AtPrime q)
    have hfield : IsField (Localization.AtPrime q) := Ring.KrullDimLE.isField_of_isReduced
    have : Algebra.EssFiniteType K (A ⧸ I) := Algebra.EssFiniteType.of_finiteType K _
    have : Algebra.EssFiniteType (A ⧸ I) (Localization.AtPrime q) :=
      Algebra.EssFiniteType.of_isLocalization (Localization.AtPrime q) q.primeCompl
    have : Algebra.EssFiniteType K (Localization.AtPrime q) :=
      Algebra.EssFiniteType.comp K (A ⧸ I) (Localization.AtPrime q)
    let R := IsLocalRing.ResidueField (Localization.AtPrime q)
    let τ : Localization.AtPrime q →ₐ[K] R := IsScalarTower.toAlgHom K (Localization.AtPrime q) R
    have hτs : Function.Surjective τ := IsLocalRing.residue_surjective
    have hτi : Function.Injective τ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      have hx' : x ∈ RingHom.ker (IsLocalRing.residue (Localization.AtPrime q)) := hx
      rw [IsLocalRing.ker_residue, IsLocalRing.isField_iff_maximalIdeal_eq.mp hfield] at hx'
      exact hx'
    have : Algebra.EssFiniteType K R := Algebra.EssFiniteType.of_surjective τ hτs
    have : Algebra.FormallySmooth K R := Algebra.FormallySmooth.of_perfectField
    let eR : Localization.AtPrime q ≃ₐ[K] R := AlgEquiv.ofBijective τ ⟨hτi, hτs⟩
    have : Algebra.IsSmoothAt K q := Algebra.FormallySmooth.of_equiv eR.symm
    obtain ⟨g, hg, hstd⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth K q
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective g
    obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := hstd.out
    refine ⟨a, P.dimension, ⟨⟨q.comap (Ideal.Quotient.mk I), inferInstance⟩, ?_, hg⟩,
      Algebra.IsStandardSmoothOfRelativeDimension.mk ⟨ι, σ, hσ, hι, P, rfl⟩⟩
    intro x hx
    show Ideal.Quotient.mk I x ∈ q
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx]
    exact q.zero_mem

  have s2 : ∀ (A : Type u) [CommRing A] (I : Ideal A) (a : A),
      IsPreimmersion (Spec.map (CommRingCat.ofHom ((algebraMap (A ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I a))).comp (Ideal.Quotient.mk I)))) ∧
      Set.range (Spec.map (CommRingCat.ofHom ((algebraMap (A ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I a))).comp (Ideal.Quotient.mk I)))) =
        PrimeSpectrum.zeroLocus (I : Set A) ∩
          (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)) := by
    intro A _ I a
    have hfac : CommRingCat.ofHom ((algebraMap (A ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I a))).comp (Ideal.Quotient.mk I)) =
        CommRingCat.ofHom (Ideal.Quotient.mk I) ≫
          CommRingCat.ofHom (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I a))) :=
      rfl
    have : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
      IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
    have : IsOpenImmersion (Spec.map (CommRingCat.ofHom
        (algebraMap (A ⧸ I) (Localization.Away (Ideal.Quotient.mk I a))))) :=
      Scheme.isOpenImmersion_SpecMap_localizationAway (R := CommRingCat.of (A ⧸ I)) _
    refine ⟨by rw [hfac, Spec.map_comp]; infer_instance, ?_⟩
    have key : Set.range (PrimeSpectrum.comap ((algebraMap (A ⧸ I)
        (Localization.Away (Ideal.Quotient.mk I a))).comp (Ideal.Quotient.mk I))) =
        PrimeSpectrum.zeroLocus (I : Set A) ∩
          (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum A)) := by
      rw [PrimeSpectrum.comap_comp, Set.range_comp,
        PrimeSpectrum.localization_away_comap_range (Localization.Away (Ideal.Quotient.mk I a))
          (Ideal.Quotient.mk I a)]
      have hb : (PrimeSpectrum.basicOpen (Ideal.Quotient.mk I a) : Set (PrimeSpectrum (A ⧸ I))) =
          PrimeSpectrum.comap (Ideal.Quotient.mk I) ⁻¹' (PrimeSpectrum.basicOpen a : Set _) := by
        ext x; rfl
      rw [hb, Set.image_preimage_eq_inter_range,
        range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker, Set.inter_comm]
    exact key

  have s3 : ∀ (S : Type u) [CommRing S] [Algebra K S] (e : ℕ),
      Algebra.IsStandardSmoothOfRelativeDimension e K S →
      SmoothOfRelativeDimension e (Spec.map (CommRingCat.ofHom (algebraMap K S))) := by
    intro S _ _ e h
    rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension e)]
    exact RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _
      ((RingHom.isStandardSmoothOfRelativeDimension_algebraMap e).mpr h)

  have hTne : ((U : Set Y)ᶜ).Nonempty :=
    Set.nonempty_compl.mpr (fun h => hU (TopologicalSpace.Opens.coe_eq_univ.mp h))
  obtain ⟨t, ht⟩ := hTne

  obtain ⟨W, hW, htW, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := t) trivial

  let φ : CommRingCat.of K ⟶ Γ(Y, W) := Spec.preimage (hW.fromSpec ≫ f)
  letI : Algebra K Γ(Y, W) := φ.hom.toAlgebra
  have hft : LocallyOfFiniteType (Spec.map φ) := by
    rw [Spec.map_preimage]; infer_instance
  have hft' : RingHom.FiniteType φ.hom :=
    (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hft
  have : Algebra.FiniteType K Γ(Y, W) := hft'

  have hTc : IsClosed (hW.fromSpec ⁻¹' (U : Set Y)ᶜ) :=
    U.isOpen.isClosed_compl.preimage hW.fromSpec.continuous
  let T' : Set (PrimeSpectrum Γ(Y, W)) := hW.fromSpec ⁻¹' (U : Set Y)ᶜ
  let I : Ideal Γ(Y, W) := PrimeSpectrum.vanishingIdeal T'
  have hIrad : I.IsRadical := PrimeSpectrum.isRadical_vanishingIdeal _
  have htW' : t ∈ Set.range hW.fromSpec := by rw [hW.range_fromSpec]; exact htW
  obtain ⟨t', ht'⟩ := htW'
  have ht'T : t' ∈ T' := by
    show hW.fromSpec t' ∈ (U : Set Y)ᶜ
    rw [ht']; exact ht
  have hItop : I ≠ ⊤ := by
    intro h
    have h1 : (1 : Γ(Y, W)) ∈ I := by rw [h]; exact Submodule.mem_top
    have h2 := (PrimeSpectrum.mem_vanishingIdeal T' 1).mp h1 t' ht'T
    exact t'.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h2)
  have hZI : PrimeSpectrum.zeroLocus (I : Set Γ(Y, W)) = T' := by
    show PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal T' : Set Γ(Y, W)) = T'
    rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure]
    exact hTc.closure_eq

  obtain ⟨a, e, ⟨P₀, hP₀I, hP₀a⟩, hstd⟩ := s1 Γ(Y, W) I hIrad hItop

  let g : Γ(Y, W) →+* Localization.Away (Ideal.Quotient.mk I a) :=
    (algebraMap (Γ(Y, W) ⧸ I) (Localization.Away (Ideal.Quotient.mk I a))).comp
      (Ideal.Quotient.mk I)
  obtain ⟨hgpre, hgrange⟩ := s2 Γ(Y, W) I a
  let j : Spec (CommRingCat.of (Localization.Away (Ideal.Quotient.mk I a))) ⟶ Y :=
    Spec.map (CommRingCat.ofHom g) ≫ hW.fromSpec
  have hjpre : IsPreimmersion j := by
    haveI := hgpre
    show IsPreimmersion (Spec.map (CommRingCat.ofHom g) ≫ hW.fromSpec)
    infer_instance
  let O : Y.Opens := hW.fromSpec ''ᵁ PrimeSpectrum.basicOpen a
  have hrj : Set.range j = hW.fromSpec '' Set.range (Spec.map (CommRingCat.ofHom g)) := by
    ext y; constructor
    · rintro ⟨z, rfl⟩; exact ⟨_, ⟨z, rfl⟩, (Scheme.Hom.comp_apply _ _ _).symm⟩
    · rintro ⟨_, ⟨z, rfl⟩, rfl⟩; exact ⟨z, Scheme.Hom.comp_apply _ _ _⟩
  have hO : (O : Set Y) = hW.fromSpec '' ((PrimeSpectrum.basicOpen a : Set (PrimeSpectrum Γ(Y, W))) :
      Set (Spec Γ(Y, W))) := Scheme.Hom.coe_image _
  have hjrange : Set.range j = (O : Set Y) ∩ (U : Set Y)ᶜ := by
    rw [hrj, hgrange, hZI, hO]
    exact (Set.image_preimage_inter hW.fromSpec _ (U : Set Y)ᶜ).trans (Set.inter_comm _ _)
  have hjne : (Set.range j).Nonempty := by
    refine ⟨hW.fromSpec (show Spec Γ(Y, W) from P₀), ?_⟩
    rw [hrj, hgrange]
    exact ⟨P₀, ⟨(PrimeSpectrum.mem_zeroLocus _ _).mpr hP₀I, hP₀a⟩, rfl⟩

  obtain ⟨U', hU'⟩ : ∃ U' : Y.Opens, U' = U ⊔ O := ⟨_, rfl⟩
  have hU'coe : (U' : Set Y) = (U : Set Y) ∪ (O : Set Y) := by
    rw [hU', TopologicalSpace.Opens.coe_sup]
  have hsub : Set.range j ⊆ Set.range U'.ι := by
    rw [Scheme.Opens.range_ι, hU'coe, hjrange]
    exact fun y hy => Or.inr hy.1
  let i : Spec (CommRingCat.of (Localization.Away (Ideal.Quotient.mk I a))) ⟶ (U' : Scheme.{u}) :=
    IsOpenImmersion.lift U'.ι j hsub
  have hfac : i ≫ U'.ι = j := IsOpenImmersion.lift_fac _ _ _
  have hipre : IsPreimmersion i := by
    haveI : IsPreimmersion (i ≫ U'.ι) := by rw [hfac]; exact hjpre
    exact IsPreimmersion.of_comp i U'.ι
  have hirange : Set.range i = ((U'.ι ⁻¹ᵁ U : (U' : Scheme.{u}).Opens) : Set (U' : Scheme.{u}))ᶜ := by
    rw [Scheme.Hom.coe_preimage]
    ext x
    simp only [Set.mem_compl_iff, Set.mem_preimage, Set.mem_range]
    constructor
    · rintro ⟨z, rfl⟩
      have h1 : U'.ι (i z) = j z := by rw [← Scheme.Hom.comp_apply, hfac]
      have h2 : j z ∈ Set.range j := ⟨z, rfl⟩
      rw [hjrange] at h2
      rw [h1]; exact h2.2
    · intro hx
      have h1 : U'.ι x ∈ Set.range U'.ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι, hU'coe] at h1
      have h2 : U'.ι x ∈ Set.range j := by
        rw [hjrange]
        exact ⟨h1.resolve_left hx, hx⟩
      obtain ⟨z, hz⟩ := h2
      refine ⟨z, U'.ι.isOpenEmbedding.injective ?_⟩
      rw [← Scheme.Hom.comp_apply, hfac, hz]
  have hiclosed : IsClosedImmersion i := by
    haveI := hipre
    refine IsClosedImmersion.of_isPreimmersion i ?_
    rw [hirange]
    exact (U'.ι ⁻¹ᵁ U).isOpen.isClosed_compl
  have hlt : U < U' := by
    refine lt_of_le_of_ne (by rw [hU']; exact le_sup_left) ?_
    intro hEq
    obtain ⟨y, hy⟩ := hjne
    rw [hjrange] at hy
    have hyU' : y ∈ (U' : Set Y) := by rw [hU'coe]; exact Or.inr hy.1
    rw [← hEq] at hyU'
    exact hy.2 hyU'

  have hφg : φ ≫ CommRingCat.ofHom g =
      CommRingCat.ofHom (algebraMap K (Localization.Away (Ideal.Quotient.mk I a))) := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    rfl
  have hcomp : i ≫ U'.ι ≫ f =
      Spec.map (CommRingCat.ofHom (algebraMap K (Localization.Away (Ideal.Quotient.mk I a)))) := by
    rw [← Category.assoc, hfac, ← hφg, Spec.map_comp]
    show Spec.map (CommRingCat.ofHom g) ≫ hW.fromSpec ≫ f = _
    rw [← Spec.map_preimage (hW.fromSpec ≫ f)]
  have hsmZ : SmoothOfRelativeDimension e (i ≫ U'.ι ≫ f) := by
    rw [hcomp]; exact s3 _ e hstd

  have hsmU' : SmoothOfRelativeDimension d (U'.ι ≫ f) := by
    have := smoothOfRelativeDimension_comp 0 d U'.ι f
    rwa [Nat.zero_add] at this
  have hsepU' : IsSeparated (U'.ι ≫ f) := by
    haveI : IsSeparated U'.ι := IsSeparated.isSeparated_of_mono _
    infer_instance
  have hqcU' : QuasiCompact (U'.ι ≫ f) := inferInstance
  exact ⟨U', e, _, i, hlt, hiclosed, hsmZ, hirange, hsmU', hsepU', hqcU'⟩

theorem wc_et_open_supp_top_epi : ∀ (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.Opens), U = ⊤ → ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (ι : N ⟶ SheafOfModules.unit (wcEtZModRing Y ℓ)), Mono ι → Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅ wcEtExtZero Y (U : Set Y) ℓ) → Epi ι :=
by
  classical
  intro Y ℓ _ U hU N ι hι hN
  subst hU
  obtain ⟨eN⟩ := hN
  haveI := hι

  have key : ∀ {F G : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (η : F ⟶ G),
      (∀ V, Function.Bijective (η.app V).hom) →
      IsIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map η) := by
    intro F G η h
    haveI : ∀ V, IsIso (η.app V) := fun V => (ConcreteCategory.isIso_iff_bijective _).mpr (h V)
    haveI : IsIso η := NatIso.isIso_of_isIso_app η
    infer_instance
  have hsupp : ∀ (p : Prop), p → wcSuppSub.{u} ℓ p = ⊤ := by
    intro p hp
    unfold wcSuppSub
    exact iSup_pos hp
  have hiso1 : IsIso (wcEtExtZeroι Y ((⊤ : Y.Opens) : Set Y) ℓ) := by
    unfold wcEtExtZeroι
    refine key _ (fun V => ⟨fun a b h => Subtype.ext h, fun y => ⟨⟨y, ?_⟩, rfl⟩⟩)
    rw [hsupp]
    all_goals first
      | exact AddSubgroup.mem_top y
      | (intro x; simp)
      | (intro x; trivial)

  obtain ⟨α, hinj, hsurj, -⟩ := wc_et_zmod_ring_locbij Y ℓ
  obtain ⟨hfull, -⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y)
    (wcEtZModRing Y ℓ) ℓ α hinj hsurj
  haveI := hfull
  obtain ⟨eR⟩ := wc_et_zmod_unit_toSheaf_iso Y ℓ
  haveI := hiso1
  let E : (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅
      (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj (SheafOfModules.unit (wcEtZModRing Y ℓ)) :=
    eN ≪≫ asIso (wcEtExtZeroι Y ((⊤ : Y.Opens) : Set Y) ℓ) ≪≫ eR.symm
  let e : N ≅ SheafOfModules.unit (wcEtZModRing Y ℓ) :=
    (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).preimageIso E

  have hpowU : ∀ c : ULift.{u+1} (ZMod ℓ), c ^ ℓ = c := fun c =>
    ULift.ext _ _ (by
      first
        | (rw [ULift.pow_down]; exact ZMod.pow_card _)
        | simp [ZMod.pow_card])
  have hfermat : ∀ (V : (Y.Etale)ᵒᵖ) (t : ↑((wcEtZModRing Y ℓ).obj.obj V)), t ^ ℓ = t := by
    intro V t
    haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α := hsurj
    have hS := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) α t
    refine (wcEtZModRing Y ℓ).isSeparated _ _ hS _ _ ?_
    intro W g hg
    obtain ⟨c, hc⟩ := hg
    first
      | (rw [map_pow, ← hc]
         exact ((map_pow _ c ℓ).symm).trans (congrArg _ (hpowU c)))
      | (erw [map_pow, ← hc]
         exact ((map_pow _ c ℓ).symm).trans (congrArg _ (hpowU c)))
      | (simp only [map_pow, ← hc]
         exact ((map_pow _ c ℓ).symm).trans (congrArg _ (hpowU c)))

  obtain ⟨φ, hφ⟩ : ∃ φ : End (SheafOfModules.unit (wcEtZModRing Y ℓ)), φ = e.inv ≫ ι :=
    ⟨_, rfl⟩
  haveI : Mono φ := by rw [hφ]; infer_instance
  obtain ⟨a, ha⟩ : ∃ a : ∀ V : (Y.Etale)ᵒᵖ, ↑((wcEtZModRing Y ℓ).obj.obj V),
      ∀ V, a V = (φ.val.app V).hom (1 : ↑((wcEtZModRing Y ℓ).obj.obj V)) :=
    ⟨fun V => (φ.val.app V).hom (1 : ↑((wcEtZModRing Y ℓ).obj.obj V)), fun V => rfl⟩
  have hmulφ : ∀ (V : (Y.Etale)ᵒᵖ) (x : ↑((wcEtZModRing Y ℓ).obj.obj V)),
      (φ.val.app V).hom x = x * a V := by
    intro V x
    rw [ha V]
    calc (φ.val.app V).hom x
        = (φ.val.app V).hom (x • (1 : ↑((wcEtZModRing Y ℓ).obj.obj V))) :=
          congrArg _ (mul_one x).symm
      _ = x • (φ.val.app V).hom (1 : ↑((wcEtZModRing Y ℓ).obj.obj V)) := map_smul _ _ _
      _ = _ := rfl
  have hpow : ∀ (k : ℕ) (V : (Y.Etale)ᵒᵖ) (x : ↑((wcEtZModRing Y ℓ).obj.obj V)),
      ((φ ^ k).val.app V).hom x = x * a V ^ k := by
    intro k
    induction k with
    | zero =>
      intro V x
      rw [pow_zero, pow_zero, mul_one]
      rfl
    | succ k ih =>
      intro V x
      have e1 : ((φ ^ (k+1)).val.app V).hom x = ((φ ^ k).val.app V).hom (x * a V) := by
        rw [← hmulφ V x, pow_succ φ k, End.mul_def]
        rfl
      rw [e1, ih V (x * a V), mul_assoc, ← pow_succ']
  have hfix : φ ^ ℓ = φ := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    have hx : ∀ y : ↑((wcEtZModRing Y ℓ).obj.obj V),
        ((φ ^ ℓ).val.app V).hom y = (φ.val.app V).hom y := fun y =>
      (hpow ℓ V y).trans
        ((congrArg (fun s => y * s) (hfermat V (a V))).trans (hmulφ V y).symm)
    exact hx x
  obtain ⟨m, hm⟩ : ∃ m, ℓ = m + 2 :=
    ⟨ℓ - 2, by have := (Fact.out : ℓ.Prime).two_le; omega⟩
  have hfix' : φ ^ (m + 1 + 1) = φ := by
    rw [show m + 1 + 1 = ℓ by omega]
    exact hfix
  have h1 : (φ ^ (m + 1)) ≫ φ = 𝟙 _ ≫ φ := by
    rw [Category.id_comp, ← End.mul_def, ← pow_succ', hfix']
  have h2 : φ ^ (m + 1) = 𝟙 _ := (cancel_mono φ).mp h1
  have hA : φ ≫ (φ ^ m) = 𝟙 _ := by
    rw [← End.mul_def, ← pow_succ, h2]
  have hB : (φ ^ m) ≫ φ = 𝟙 _ := by
    rw [← End.mul_def, ← pow_succ', h2]
  haveI : IsIso φ := ⟨⟨φ ^ m, hA, hB⟩⟩
  have hιe : ι = e.hom ≫ φ := by
    rw [hφ, Iso.hom_inv_id_assoc]
  rw [hιe]
  infer_instance

theorem wc_et_extzero_module_suppIn : ∀ (Y : Scheme.{u}) (ℓ : ℕ) (W : Y.Opens) (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)), Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅ wcEtExtZero Y (W : Set Y) ℓ) → wcSuppIn Y (W : Set Y) ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N) :=
by
  intro Y ℓ W N hN
  obtain ⟨e⟩ := hN
  have hEsupp : wcSuppIn Y (W : Set Y) (wcEtExtZero Y (W : Set Y) ℓ) := by
    intro V s
    let η := toSheafify (Scheme.smallEtaleTopology Y) (wcEtExtZeroPre Y (W : Set Y) ℓ)
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) η :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) η s
    refine GrothendieckTopology.superset_covering _ ?_ hI
    intro V' g hg
    obtain ⟨t, ht⟩ := hg
    apply Sieve.le_generate
    by_cases hp : ∀ x, V'.hom x ∈ (W : Set Y)
    · exact Or.inr hp
    · left
      have key : ∀ (p : Prop), ¬p → ∀ y : ↥(wcSuppSub.{u} ℓ p), y = 0 := by
        intro p hp y
        obtain ⟨y, hy⟩ := y
        have hy' : y ∈ (⊥ : AddSubgroup (ULift.{u+1} (ZMod ℓ))) := by
          unfold wcSuppSub at hy
          rwa [iSup_neg hp] at hy
        exact Subtype.ext ((AddSubgroup.mem_bot).mp hy')
      have ht0 : t = 0 := key _ hp t
      have h2 : (sheafify (Scheme.smallEtaleTopology Y) (wcEtExtZeroPre Y (W : Set Y) ℓ)).map g.op s
          = 0 := by
        rw [← ht, ht0, map_zero]
      exact h2
  intro V s
  let G := (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N
  let s' := (e.hom.hom.app (Opposite.op V)).hom s
  refine GrothendieckTopology.superset_covering _ ?_ (hEsupp V s')
  rw [Sieve.generate_le_iff]
  intro V' g hg
  apply Sieve.le_generate
  rcases hg with h0 | hW
  · left
    have h0' : ((wcEtExtZero Y (W : Set Y) ℓ).obj.map g.op).hom s' = 0 := h0
    have hs : (e.inv.hom.app (Opposite.op V)).hom s' = s := by
      have h := congrArg (fun f : G ⟶ G => (f.hom.app (Opposite.op V)).hom s) e.hom_inv_id
      first
        | exact h
        | simpa using h
    have hnat : (G.obj.map g.op).hom ((e.inv.hom.app (Opposite.op V)).hom s') =
        (e.inv.hom.app (Opposite.op V')).hom
          (((wcEtExtZero Y (W : Set Y) ℓ).obj.map g.op).hom s') :=
      (NatTrans.naturality_apply e.inv.hom g.op s').symm
    show (G.obj.map g.op).hom s = 0
    rw [← hs, hnat, h0', map_zero]
  · exact Or.inr hW

theorem wc_et_open_restrict_extzero_module : ∀ (Y : Scheme.{u}) (ℓ : ℕ) (U' W : Y.Opens) (E : wcEtPullData U'.ι ℓ) (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)), Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅ wcEtExtZero Y (W : Set Y) ℓ) → Nonempty ((SheafOfModules.toSheaf (wcEtZModRing (U' : Scheme.{u}) ℓ)).obj (E.Φ.obj N) ≅ wcEtExtZero (U' : Scheme.{u}) ((U'.ι ⁻¹ᵁ W : (U' : Scheme.{u}).Opens) : Set (U' : Scheme.{u})) ℓ) :=
by
  intro Y ℓ U' W E N hN
  obtain ⟨e⟩ := hN
  have key : ∀ (T : Y.Etale)
      [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)]
      [(wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)]
      (φ : wcEtZModRing T.left ℓ ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).obj (wcEtZModRing Y ℓ))
      (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)),
      ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅ wcEtExtZero Y (W : Set Y) ℓ) →
      Nonempty ((SheafOfModules.toSheaf (wcEtZModRing T.left ℓ)).obj
          ((SheafOfModules.pushforward (F := wcEtSlice T) φ).obj N) ≅
        (presheafToSheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}).obj
          ((wcEtSlice T).op ⋙ wcEtExtZeroPre Y (W : Set Y) ℓ)) := by
    intro T _ _ φ N e
    exact ⟨((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).mapIso e ≪≫
      ((Functor.pushforwardContinuousSheafificationCompatibility (wcEtSlice T) AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).app
            (wcEtExtZeroPre Y (W : Set Y) ℓ)).symm⟩
  have wc_et_slice_continuous : ∀ {S : Scheme.{u}} (T : S.Etale), (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S) ∧ (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S) := by
    intro S T
    haveI hT : Etale T.hom := T.prop
    have hSurj : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Y V →
        ∀ y : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
      intro Y V R hR y
      change R ∈ Scheme.smallGrothendieckTopology @Etale Y V at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
      exact ⟨V₁, c, w, hc, hw⟩
    have hCov : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V R hR
      change R ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hR x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : CoverPreserving (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S)
        (wcEtSlice T) := by
      refine CoverPreserving.mk (fun {V} {R} hR => ?_)
      apply hCov
      intro v
      obtain ⟨V₁, c, w, hc, hw⟩ := hSurj T.left V R hR v
      exact ⟨(wcEtSlice T).obj V₁, (wcEtSlice T).map c, ⟨V₁, c, 𝟙 _, hc, (Category.id_comp _).symm⟩,
        ⟨w, hw⟩⟩
    have hcomp : CompatiblePreserving.{u+1} (Scheme.smallEtaleTopology S) (wcEtSlice T) := by
      apply CompatiblePreserving.mk
      intro ℱ Z T' x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      have hw : (f₁.left ≫ Y₁.hom) ≫ T.hom = X.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
      haveI : Etale ((f₁.left ≫ Y₁.hom) ≫ T.hom) := hw ▸ X.prop
      haveI : Etale (f₁.left ≫ Y₁.hom) := Etale.of_comp _ T.hom
      let X' : T.left.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) ‹_›
      have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun k => k.left) hfg
      have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
        have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
        have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
        calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
              (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
          _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
          _ = f₁.left ≫ Y₁.hom :=
              (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
      let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
      let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
      let e : X ⟶ (wcEtSlice T).obj X' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
      have hf₁ : f₁ = e ≫ (wcEtSlice T).map f₁' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hf₂ : f₂ = e ≫ (wcEtSlice T).map f₂' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
        apply MorphismProperty.Over.Hom.ext
        exact hleft
      have hc := hx f₁' f₂' hg₁ hg₂ hsq
      rw [hf₁, hf₂]
      simp only [Functor.map_comp, op_comp]
      rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
      exact congrArg _ hc
    have hcont : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology S) :=
      Functor.isContinuous_of_coverPreserving hcomp hcov
    have hcocont : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology S) := by
      refine Functor.IsCocontinuous.mk (fun {V} {S'} hS' => ?_)
      apply hCov
      intro v
      obtain ⟨V₁, c, w, hc, hcw⟩ := hSurj S ((wcEtSlice T).obj V) S' hS' v
      have hw : (c.left ≫ V.hom) ≫ T.hom = V₁.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w c)
      haveI : Etale ((c.left ≫ V.hom) ≫ T.hom) := hw ▸ V₁.prop
      haveI : Etale (c.left ≫ V.hom) := Etale.of_comp _ T.hom
      let X' : T.left.Etale := MorphismProperty.Over.mk ⊤ (c.left ≫ V.hom) ‹_›
      let c' : X' ⟶ V := MorphismProperty.Over.homMk c.left rfl trivial
      let e' : (wcEtSlice T).obj X' ⟶ V₁ :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he' : (wcEtSlice T).map c' = e' ≫ c := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨X', c', ?_, ⟨w, hcw⟩⟩
      show S'.arrows ((wcEtSlice T).map c')
      rw [he']
      exact S'.downward_closed hc e'
    exact ⟨hcont, hcocont⟩
  obtain ⟨hc, hcc⟩ := wc_et_slice_continuous
    (MorphismProperty.Over.mk ⊤ U'.ι (inferInstance : Etale U'.ι) : Y.Etale)
  have gen : ∀ {X : Scheme.{u}} (T : X.Etale) (n : ℕ)
      (E : wcEtPullData (S := X) (S' := T.left) T.hom n)
      [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)],
      ∃ ψ : wcEtZModRing T.left n ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X n),
        Nonempty (E.Φ ≅ SheafOfModules.pushforward.{u+1} ψ) := by
    intro X T n E hF
    have key0 : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod n) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod n →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    have s1 : ∀ {Y : Scheme.{u}} (Q : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1}),
        Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) Q →
        ∀ (a b : (wcEtZModRing Y n).obj ⟶ Q), a = b := by
      intro Y Q hQ a b
      apply sheafify_hom_ext (Scheme.smallEtaleTopology Y) _ _ hQ
      apply NatTrans.ext
      funext V
      apply RingCat.hom_ext
      exact key0 _ _
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) T.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u})
        T.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong T.hom)) (@Etale : MorphismProperty Scheme.{u})
    letI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have adj : wcEtSlice T ⊣ wcEtBaseChange T.hom :=
      @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ (@Etale : MorphismProperty Scheme.{u}) ⊤ _
        T.left X _ _ T.hom _ _ _ T.prop trivial
    haveI hG := E.cont
    let α : (Functor.const (T.left.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtSlice T).op ⋙ (wcEtZModRing X n).obj :=
      Functor.whiskerLeft (wcEtSlice T).op (toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))))
    let ψ : wcEtZModRing T.left n ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X n) :=
      ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology T.left) α
        (Functor.op_comp_isSheaf (wcEtSlice T) (Scheme.smallEtaleTopology T.left)
          (Scheme.smallEtaleTopology X) (wcEtZModRing X n)))
    haveI hGF : (wcEtBaseChange T.hom ⋙ wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology X) :=
      Functor.isContinuous_comp (wcEtBaseChange T.hom) (wcEtSlice T) (Scheme.smallEtaleTopology X)
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
    have H1 : Functor.whiskerRight (NatTrans.op adj.counit) (wcEtZModRing X n).obj =
        E.φ.hom ≫ (wcEtBaseChange T.hom).op.whiskerLeft ψ.hom :=
      s1 (Y := X) _ (Functor.op_comp_isSheaf (wcEtBaseChange T.hom ⋙ wcEtSlice T)
        (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology X) (wcEtZModRing X n)) _ _
    have H2 : ψ.hom ≫ (wcEtSlice T).op.whiskerLeft E.φ.hom ≫
        Functor.whiskerRight (NatTrans.op adj.unit) (wcEtZModRing T.left n).obj =
        𝟙 (wcEtZModRing T.left n).obj :=
      s1 (Y := T.left) _ (wcEtZModRing T.left n).cond _ _
    exact ⟨ψ, ⟨Adjunction.leftAdjointUniq E.adj
      (@SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hF E.cont adj ψ E.φ H1 H2)⟩⟩
  obtain ⟨φ, ⟨θ⟩⟩ := @gen Y (MorphismProperty.Over.mk ⊤ U'.ι (inferInstance : Etale U'.ι)) ℓ E hc
  obtain ⟨k⟩ := @key (MorphismProperty.Over.mk ⊤ U'.ι (inferInstance : Etale U'.ι)) hc hcc φ N e
  exact ⟨(SheafOfModules.toSheaf (wcEtZModRing (U' : Scheme.{u}) ℓ)).mapIso (θ.app N) ≪≫ k⟩

theorem wc_et_open_supp_module_ext_vanish : ∀ (Y : Scheme.{u}) (ℓ : ℕ) (U' : Y.Opens) (E : wcEtPullData U'.ι ℓ) (L : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (adj : L ⊣ E.Φ) (A : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)) (q : ℕ), (∀ x : @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)) _ _ (HasExt.standard _) A (SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ)) q, x = 0) → ∀ x : @Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) _ _ (HasExt.standard _) (L.obj A) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q, x = 0 :=
by
  classical
  intro Y ℓ U' E L adj A q hA x
  letI instY : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI instU : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)) :=
    HasExt.standard _
  haveI := E.additive
  haveI := E.presLim
  haveI := E.presColim
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  have hhom : ∀ Y' : SheafOfModules.{u+1} (wcEtZModRing Y ℓ),
      Function.Bijective (fun f : L.obj A ⟶ Y' => adj.unit.app A ≫ E.Φ.map f) := by
    intro Y'
    have e : (fun f : L.obj A ⟶ Y' => adj.unit.app A ≫ E.Φ.map f) = adj.homEquiv A Y' :=
      funext fun f => (adj.homEquiv_unit A Y' f).symm
    rw [e]
    exact (adj.homEquiv A Y').bijective
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) [Injective I] (n : ℕ)
      (e : Abelian.Ext A (E.Φ.obj I) (n + 1)), e = 0 := by
    intro I _ n e
    haveI : Injective (E.Φ.obj I) := wc_et_open_pull_preserves_injective U'.ι ℓ E I inferInstance
    exact Abelian.Ext.eq_zero_of_injective e
  have h := ext_transfer_of_corep E.Φ (L.obj A) A (adj.unit.app A) hhom hvan
    (SheafOfModules.unit (wcEtZModRing Y ℓ)) q
  have hz : ∀ y : Abelian.Ext A (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Y ℓ))) q, y = 0 := by
    intro y
    have hy : y = (y.comp (Abelian.Ext.mk₀ E.μ.hom) (add_zero q)).comp
        (Abelian.Ext.mk₀ E.μ.inv) (add_zero q) := by
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    rw [hy, hA (y.comp (Abelian.Ext.mk₀ E.μ.hom) (add_zero q)), Abelian.Ext.zero_comp]
  exact h.1 ((hz _).trans (hz _).symm)

theorem abelian_cokernel_comp_mono_shortExact {C : Type*} [Category C] [Abelian C] {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z) (h : X ⟶ Z) (hfg : f ≫ g = h) [Mono g] : ∃ (a : Limits.cokernel f ⟶ Limits.cokernel h) (b : Limits.cokernel h ⟶ Limits.cokernel g) (w : a ≫ b = 0), (ShortComplex.mk a b w).ShortExact :=
by
  subst hfg
  have ha : f ≫ g ≫ Limits.cokernel.π (f ≫ g) = 0 := by
    rw [← Category.assoc, Limits.cokernel.condition]
  have hb : (f ≫ g) ≫ Limits.cokernel.π g = 0 := by
    rw [Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  obtain ⟨a, hA⟩ : ∃ a : Limits.cokernel f ⟶ Limits.cokernel (f ≫ g),
      Limits.cokernel.π f ≫ a = g ≫ Limits.cokernel.π (f ≫ g) :=
    ⟨_, Limits.cokernel.π_desc _ _ ha⟩
  obtain ⟨b, hB⟩ : ∃ b : Limits.cokernel (f ≫ g) ⟶ Limits.cokernel g,
      Limits.cokernel.π (f ≫ g) ≫ b = Limits.cokernel.π g :=
    ⟨_, Limits.cokernel.π_desc _ _ hb⟩
  have w : a ≫ b = 0 := by
    rw [← cancel_epi (Limits.cokernel.π f), ← Category.assoc, hA, Category.assoc, hB,
      Limits.cokernel.condition, Limits.comp_zero]
  have : Epi b := epi_of_epi_fac hB
  have : Mono a := by
    apply Preadditive.mono_of_cancel_zero
    intro P t ht
    obtain ⟨P₁, e₁, he₁, y, hy⟩ := surjective_up_to_refinements_of_epi (Limits.cokernel.π f) t
    have h1 : (y ≫ g) ≫ Limits.cokernel.π (f ≫ g) = 0 := by
      rw [Category.assoc, ← hA, ← Category.assoc, ← hy, Category.assoc, ht, Limits.comp_zero]
    obtain ⟨P₂, e₂, he₂, x, hx⟩ :=
      (ShortComplex.exact_cokernel (f ≫ g)).exact_up_to_refinements (y ≫ g) h1
    have h2 : e₂ ≫ y = x ≫ f := by
      rw [← cancel_mono g]
      simpa only [Category.assoc] using hx
    rw [← cancel_epi (e₂ ≫ e₁), Limits.comp_zero, Category.assoc, hy, ← Category.assoc, h2,
      Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  refine ⟨a, b, w, ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance⟩
  rw [ShortComplex.exact_iff_exact_up_to_refinements]
  intro P t ht
  obtain ⟨P₁, e₁, he₁, z, hz⟩ :=
    surjective_up_to_refinements_of_epi (Limits.cokernel.π (f ≫ g)) t
  have h1 : z ≫ Limits.cokernel.π g = 0 := by
    dsimp at ht
    rw [← hB, ← Category.assoc, ← hz, Category.assoc, ht, Limits.comp_zero]
  obtain ⟨P₂, e₂, he₂, y, hy⟩ := (ShortComplex.exact_cokernel g).exact_up_to_refinements z h1
  refine ⟨P₂, e₂ ≫ e₁, epi_comp _ _, y ≫ Limits.cokernel.π f, ?_⟩
  dsimp at hy ⊢
  rw [Category.assoc, hz, ← Category.assoc, hy]
  simp only [Category.assoc, hA]

theorem wc_et_open_supp_les_step : ∀ (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U U' : Y.Opens), U ≤ U' → ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (ι : N ⟶ SheafOfModules.unit (wcEtZModRing Y ℓ)), Mono ι → Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N ≅ wcEtExtZero Y (U : Set Y) ℓ) → ∀ (N' : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (ι' : N' ⟶ SheafOfModules.unit (wcEtZModRing Y ℓ)), Mono ι' → Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N' ≅ wcEtExtZero Y (U' : Set Y) ℓ) → ∀ (NV : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)) (ιV : NV ⟶ SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ)), Mono ιV → Nonempty ((SheafOfModules.toSheaf (wcEtZModRing (U' : Scheme.{u}) ℓ)).obj NV ≅ wcEtExtZero (U' : Scheme.{u}) ((U'.ι ⁻¹ᵁ U : (U' : Scheme.{u}).Opens) : Set (U' : Scheme.{u})) ℓ) → letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)) := HasExt.standard _; ∀ (q : ℕ), (∀ x : Abelian.Ext (Limits.cokernel ι') (SheafOfModules.unit (wcEtZModRing Y ℓ)) q, x = 0) → (∀ x : Abelian.Ext (Limits.cokernel ιV) (SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ)) q, x = 0) → ∀ x : Abelian.Ext (Limits.cokernel ι) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q, x = 0 :=
by
  classical
  intro Y ℓ _ U U' hUU' N ι hι hN N' ι' hι' hN' NV ιV hιV hNV q hq' hqV x
  letI instY : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI instU : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)) :=
    HasExt.standard _

  have hmax : ∀ (Z : Scheme.{u}) (W : Z.Opens) (M : SheafOfModules.{u+1} (wcEtZModRing Z ℓ))
      (m : M ⟶ SheafOfModules.unit (wcEtZModRing Z ℓ)), Mono m →
      Nonempty ((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj M ≅ wcEtExtZero Z (W : Set Z) ℓ) →
      ∀ (G : SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (φ : G ⟶ SheafOfModules.unit (wcEtZModRing Z ℓ)),
      wcSuppIn Z (W : Set Z) ((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj G) →
      φ ≫ Limits.cokernel.π m = 0 := by
    intro Z W M m hm hM G φ hG
    obtain ⟨E⟩ := wc_et_zmod_pull_data_exists W.ι ℓ
    haveI := E.additive
    haveI := E.presLim
    haveI := E.presColim
    obtain ⟨L, adj, -, hmono, -, hepi, -⟩ := wc_et_open_extzero_module_package W ℓ E
    haveI hΦm_mono : Mono (E.Φ.map m) := inferInstance
    have hW := wc_et_open_restrict_extzero_module Z ℓ W W E M hM
    haveI hep : Epi (E.Φ.map m ≫ E.μ.hom) :=
      wc_et_open_supp_top_epi (W : Scheme.{u}) ℓ (W.ι ⁻¹ᵁ W) (Scheme.Opens.ι_preimage_self W)
        (E.Φ.obj M) (E.Φ.map m ≫ E.μ.hom) inferInstance hW
    haveI hΦm_epi : Epi (E.Φ.map m) := by
      have e : E.Φ.map m = (E.Φ.map m ≫ E.μ.hom) ≫ E.μ.inv := by simp
      rw [e]
      infer_instance
    haveI : IsIso (E.Φ.map m) := isIso_of_mono_of_epi _
    have nat := adj.counit_naturality m
    have hc : adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ≫ Limits.cokernel.π m = 0 := by
      have hce : adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) =
          inv (L.map (E.Φ.map m)) ≫ adj.counit.app M ≫ m := by
        rw [← nat, IsIso.inv_hom_id_assoc]
      rw [hce]
      simp only [Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    haveI := hepi G hG
    apply (cancel_epi (adj.counit.app G)).1
    rw [Limits.comp_zero, ← Category.assoc, ← adj.counit_naturality φ, Category.assoc, hc,
      Limits.comp_zero]

  have transY : ∀ {A B : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)} (_ : A ≅ B),
      (∀ y : Abelian.Ext B (SheafOfModules.unit (wcEtZModRing Y ℓ)) q, y = 0) →
      ∀ y : Abelian.Ext A (SheafOfModules.unit (wcEtZModRing Y ℓ)) q, y = 0 := by
    intro A B e hB y
    have hy : y = (Abelian.Ext.mk₀ e.hom).comp ((Abelian.Ext.mk₀ e.inv).comp y (zero_add q))
        (zero_add q) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [hy, hB ((Abelian.Ext.mk₀ e.inv).comp y (zero_add q)), Abelian.Ext.comp_zero]
  have transU : ∀ {A B : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)} (_ : A ≅ B),
      (∀ y : Abelian.Ext B (SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ)) q, y = 0) →
      ∀ y : Abelian.Ext A (SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ)) q, y = 0 := by
    intro A B e hB y
    have hy : y = (Abelian.Ext.mk₀ e.hom).comp ((Abelian.Ext.mk₀ e.inv).comp y (zero_add q))
        (zero_add q) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [hy, hB ((Abelian.Ext.mk₀ e.inv).comp y (zero_add q)), Abelian.Ext.comp_zero]

  have hsN : wcSuppIn Y (U : Set Y) ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N) :=
    wc_et_extzero_module_suppIn Y ℓ U N hN
  have hsN' : wcSuppIn Y (U' : Set Y) ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N) :=
    (wc_et_mod_suppIn_calculus Y ℓ U U' N N).1 hsN (fun _ hx => hUU' hx)
  have hk0 : ι ≫ Limits.cokernel.π ι' = 0 := hmax Y U' N' ι' hι' hN' N ι hsN'
  let k := Abelian.monoLift ι' ι hk0
  have hk : k ≫ ι' = ι := Abelian.monoLift_comp ι' ι hk0
  haveI : Mono k := by
    haveI : Mono (k ≫ ι') := by rw [hk]; exact hι
    exact mono_of_mono k ι'

  obtain ⟨a, b, w, hS⟩ := abelian_cokernel_comp_mono_shortExact k ι' ι hk

  have hQ : ∀ y : Abelian.Ext (Limits.cokernel k) (SheafOfModules.unit (wcEtZModRing Y ℓ)) q,
      y = 0 := by
    obtain ⟨E'⟩ := wc_et_zmod_pull_data_exists U'.ι ℓ
    haveI := E'.additive
    haveI := E'.presLim
    haveI := E'.presColim
    obtain ⟨L', adj', -, hmono', -, hepi', -⟩ := wc_et_open_extzero_module_package U' ℓ E'
    haveI : Epi (adj'.counit.app N') := hepi' N' (wc_et_extzero_module_suppIn Y ℓ U' N' hN')
    haveI : Mono (adj'.counit.app (Limits.cokernel k)) := hmono' _
    haveI : Epi (adj'.counit.app (Limits.cokernel k)) := by
      have nat := adj'.counit_naturality (Limits.cokernel.π k)
      haveI : Epi (L'.map (E'.Φ.map (Limits.cokernel.π k)) ≫ adj'.counit.app (Limits.cokernel k)) := by
        rw [nat]; infer_instance
      exact epi_of_epi (L'.map (E'.Φ.map (Limits.cokernel.π k))) _
    haveI : IsIso (adj'.counit.app (Limits.cokernel k)) := isIso_of_mono_of_epi _
    let e1 : L'.obj (E'.Φ.obj (Limits.cokernel k)) ≅ Limits.cokernel k :=
      asIso (adj'.counit.app (Limits.cokernel k))
    let e2 : E'.Φ.obj (Limits.cokernel k) ≅ Limits.cokernel (E'.Φ.map k) :=
      Limits.PreservesCokernel.iso E'.Φ k
    let ι'' := E'.Φ.map ι' ≫ E'.μ.hom
    haveI : Mono ι'' := inferInstance
    haveI : Epi ι'' :=
      wc_et_open_supp_top_epi (U' : Scheme.{u}) ℓ (U'.ι ⁻¹ᵁ U') (Scheme.Opens.ι_preimage_self U')
        (E'.Φ.obj N') ι'' inferInstance (wc_et_open_restrict_extzero_module Y ℓ U' U' E' N' hN')
    haveI : IsIso ι'' := isIso_of_mono_of_epi _
    let e3 : Limits.cokernel (E'.Φ.map k ≫ ι'') ≅ Limits.cokernel (E'.Φ.map k) :=
      Limits.cokernelCompIsIso (E'.Φ.map k) ι''
    let ι₃ := E'.Φ.map k ≫ ι''
    haveI hι₃ : Mono ι₃ := inferInstance
    have h₃ := wc_et_open_restrict_extzero_module Y ℓ U' U E' N hN
    have hα0 : ι₃ ≫ Limits.cokernel.π ιV = 0 :=
      hmax (U' : Scheme.{u}) (U'.ι ⁻¹ᵁ U) NV ιV hιV hNV (E'.Φ.obj N) ι₃
        (wc_et_extzero_module_suppIn (U' : Scheme.{u}) ℓ (U'.ι ⁻¹ᵁ U) (E'.Φ.obj N) h₃)
    have hβ0 : ιV ≫ Limits.cokernel.π ι₃ = 0 :=
      hmax (U' : Scheme.{u}) (U'.ι ⁻¹ᵁ U) (E'.Φ.obj N) ι₃ hι₃ h₃ NV ιV
        (wc_et_extzero_module_suppIn (U' : Scheme.{u}) ℓ (U'.ι ⁻¹ᵁ U) NV hNV)
    haveI := hιV
    let α := Abelian.monoLift ιV ι₃ hα0
    let β := Abelian.monoLift ι₃ ιV hβ0
    have hα : α ≫ ιV = ι₃ := Abelian.monoLift_comp ιV ι₃ hα0
    have hβ : β ≫ ι₃ = ιV := Abelian.monoLift_comp ι₃ ιV hβ0
    let eN : E'.Φ.obj N ≅ NV :=
      { hom := α
        inv := β
        hom_inv_id := by rw [← cancel_mono ι₃, Category.assoc, hβ, hα, Category.id_comp]
        inv_hom_id := by rw [← cancel_mono ιV, Category.assoc, hα, hβ, Category.id_comp] }
    let e4 : Limits.cokernel ι₃ ≅ Limits.cokernel ιV :=
      Limits.cokernel.mapIso ι₃ ιV eN (Iso.refl _) (by
        rw [Iso.refl_hom, Category.comp_id]
        exact hα.symm)
    let eA : E'.Φ.obj (Limits.cokernel k) ≅ Limits.cokernel ιV := e2 ≪≫ e3.symm ≪≫ e4
    have hA := transU eA hqV
    have hLA := wc_et_open_supp_module_ext_vanish Y ℓ U' E' L' adj' (E'.Φ.obj (Limits.cokernel k)) q hA
    exact transY e1.symm hLA

  have h0 : (Abelian.Ext.mk₀ a).comp x (zero_add q) = 0 := hQ _
  obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS
    (SheafOfModules.unit (wcEtZModRing Y ℓ)) x h0
  rw [← hx₁, hq' x₁, Abelian.Ext.comp_zero]

theorem wc_et_closed_coker_supp_obj_iso : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : X.Opens), (V : Set X) = (Set.range i)ᶜ → ∀ (N : SheafOfModules.{u+1} (wcEtZModRing X ℓ)) (ι : N ⟶ SheafOfModules.unit (wcEtZModRing X ℓ)), Mono ι → Nonempty ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj N ≅ wcEtExtZero X (V : Set X) ℓ) → ∀ (D : wcEtPullData i ℓ), Nonempty (Limits.cokernel ι ≅ wcEtSuppObj D) :=
by
  classical
  intro X Z i _ ℓ _ V hV N ι hι hN D
  haveI : NeZero ℓ := ⟨(Fact.out : Nat.Prime ℓ).ne_zero⟩

  have key : ∀ (p : Prop), ¬p → ∀ y : ↥(wcSuppSub.{u} ℓ p), y = 0 := by
    intro p hp y
    obtain ⟨y, hy⟩ := y
    have hy' : y ∈ (⊥ : AddSubgroup (ULift.{u+1} (ZMod ℓ))) := by
      unfold wcSuppSub at hy
      rwa [iSup_neg hp] at hy
    exact Subtype.ext ((AddSubgroup.mem_bot).mp hy')

  have hs3 : ∀ (S : Set X) (a : wcEtExtZero X S ℓ ⟶ wcEtExtZero X S ℓ), Mono a → Epi a := by
    intro S a ha
    let η := toSheafify (Scheme.smallEtaleTopology X) (wcEtExtZeroPre X S ℓ)
    haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) η :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    haveI : Mono a.hom :=
      (Functor.map_mono (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) a :)
    have hinj : ∀ W : (X.Etale)ᵒᵖ, Function.Injective (a.hom.app W).hom := by
      intro W
      have := (NatTrans.mono_iff_mono_app a.hom).mp inferInstance W
      exact (AddCommGrpCat.mono_iff_injective _).mp this
    let mk : ∀ (W : X.Etale), (∀ y, W.hom y ∈ S) → ZMod ℓ →
        ToType ((wcEtExtZeroPre X S ℓ).obj (Opposite.op W)) :=
      fun W hp c => (⟨ULift.up c, AddSubgroup.mem_iSup_of_mem hp (AddSubgroup.mem_top _)⟩ :
        ↥(wcSuppSub.{u} ℓ (∀ y, W.hom y ∈ S)))
    have hmkadd : ∀ (W : X.Etale) (hp : ∀ y, W.hom y ∈ S) (c d : ZMod ℓ),
        mk W hp c + mk W hp d = mk W hp (c + d) := fun _ _ _ _ => rfl
    have hmk0 : ∀ (W : X.Etale) (hp : ∀ y, W.hom y ∈ S), mk W hp 0 = 0 := fun _ _ => rfl
    have hsmul : ∀ (W : X.Etale) (hp : ∀ y, W.hom y ∈ S) (n : ℕ) (c : ZMod ℓ),
        n • mk W hp c = mk W hp ((n : ZMod ℓ) * c) := by
      intro W hp n c
      induction n with
      | zero => rw [zero_smul, Nat.cast_zero, zero_mul, hmk0 W hp]
      | succ n ih =>
        rw [succ_nsmul, ih, hmkadd W hp]
        congr 1
        push_cast
        ring
    have hlocal : ∀ (W : X.Etale) (s : (wcEtExtZero X S ℓ).obj.obj (Opposite.op W)),
        Presheaf.imageSieve a.hom s ∈ Scheme.smallEtaleTopology X W := by
      intro W s
      refine GrothendieckTopology.transitive _ (Presheaf.imageSieve_mem _ η s) _ ?_
      intro W' f hf
      obtain ⟨x, hx⟩ := hf
      have hxf : ((sheafify (Scheme.smallEtaleTopology X) (wcEtExtZeroPre X S ℓ)).map f.op).hom s =
          (η.app (Opposite.op W')).hom x := hx.symm
      by_cases hp : ∀ y, W'.hom y ∈ S
