theorem wc_et_closed_rightAdj_homology_zero_of_open_push : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData i ℓ) (R : SheafOfModules.{u+1} (wcEtZModRing X ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) [R.Additive], (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ ⊣ R) → ∀ (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing X ℓ))) (V : X.Opens), (V : Set X) = (Set.range i)ᶜ → ∀ (m : ℕ), 1 ≤ m → (m = 1 → IsOpen (Set.range i)) → (2 ≤ m → ∀ (Dj : wcEtPullData V.ι ℓ) (J : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (V : Scheme.{u}) ℓ))), letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange V.ι) _ _ Dj.cont Dj.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dj.adj Dj.additive; Limits.IsZero ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange V.ι) _ _ Dj.cont Dj.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology (m - 1))) → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology m) :=
by

  have abs_main : ∀ {C D E : Type (u+2)} [Category.{u+1} C] [Category.{u+1} D] [Category.{u+1} E]
      [Abelian C] [Abelian D] [Abelian E]
      (P : D ⥤ C) [P.Additive] [P.Full] [P.Faithful] [Limits.PreservesFiniteLimits P]
      [Limits.PreservesFiniteColimits P]
      (R : C ⥤ D) [R.Additive] (adj : P ⊣ R)
      (Φ : C ⥤ E) [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ]
      (Pj : E ⥤ C) [Pj.Additive] (adjj : Φ ⊣ Pj),
      (∀ M : D, Limits.IsZero (Φ.obj (P.obj M))) →
      (∀ K : C, Limits.IsZero (Φ.obj K) → ∃ M : D, Nonempty (P.obj M ≅ K)) →
      (∀ G : C, Injective G → Epi (adjj.unit.app G)) →
      ∀ (A : C) (I : InjectiveResolution A) (m : ℕ), 1 ≤ m →
      (m = 1 → Epi (adjj.unit.app A)) →
      (2 ≤ m → Limits.IsZero (((Pj.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        ((Φ.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)).homology (m - 1))) →
      Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology m) := by
    intro C D E _ _ _ _ _ _ P _ _ _ _ _ R _ adj Φ _ _ _ Pj _ adjj h6 h7 h8 A I m hm h1 h2

    have K0 : ∀ {A' G : C} (f : A' ⟶ G), f ≫ adjj.unit.app G = 0 → Φ.map f = 0 := by
      intro A' G f hf
      apply (adjj.homEquiv A' (Φ.obj G)).injective
      rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit, adjj.unit_naturality, hf,
        Functor.map_zero, Limits.comp_zero]
    have K0' : ∀ {A' G : C} (f : A' ⟶ G), Φ.map f = 0 → f ≫ adjj.unit.app G = 0 := by
      intro A' G f hf
      rw [← adjj.unit_naturality, hf, Functor.map_zero, Limits.comp_zero]
    have zero_of_mono_zero : ∀ {Y₁ Y₂ : E} (g : Y₁ ⟶ Y₂) [Mono g], g = 0 → Limits.IsZero Y₁ := by
      intro Y₁ Y₂ g _ hg
      rw [Limits.IsZero.iff_id_eq_zero]
      apply (cancel_mono g).1
      rw [hg, Limits.comp_zero, Limits.comp_zero]

    have hker : ∀ G : C, adj.counit.app G ≫ adjj.unit.app G = 0 ∧ Mono (adj.counit.app G) ∧
        ∀ (A' : C) (f : A' ⟶ G), f ≫ adjj.unit.app G = 0 →
          ∃ g : A' ⟶ P.obj (R.obj G), g ≫ adj.counit.app G = f := by
      intro G
      refine ⟨K0' _ ((h6 _).eq_of_src _ _), ?_, ?_⟩
      · apply Preadditive.mono_of_kernel_zero
        have hz : Limits.IsZero (Φ.obj (Limits.kernel (adj.counit.app G))) :=
          Limits.IsZero.of_mono (Φ.map (Limits.kernel.ι (adj.counit.app G))) (h6 _)
        obtain ⟨M, ⟨e⟩⟩ := h7 _ hz
        have hκ : P.preimage (e.hom ≫ Limits.kernel.ι (adj.counit.app G)) = 0 := by
          apply (adj.homEquiv M G).symm.injective
          rw [Adjunction.homEquiv_counit, Adjunction.homEquiv_counit, Functor.map_preimage,
            Category.assoc, Limits.kernel.condition, Limits.comp_zero, Functor.map_zero,
            Limits.zero_comp]
        have h3 : e.hom ≫ Limits.kernel.ι (adj.counit.app G) = 0 := by
          rw [← P.map_preimage (e.hom ≫ Limits.kernel.ι (adj.counit.app G)), hκ, Functor.map_zero]
        calc Limits.kernel.ι (adj.counit.app G)
            = e.inv ≫ (e.hom ≫ Limits.kernel.ι (adj.counit.app G)) := by simp
          _ = 0 := by rw [h3, Limits.comp_zero]
      · intro A' f hf
        have hΦf := K0 f hf
        have hm0 : Φ.map (Limits.image.ι f) = 0 := by
          apply (cancel_epi (Φ.map (Limits.factorThruImage f))).1
          rw [← Φ.map_comp, Limits.image.fac, hΦf, Limits.comp_zero]
        have hz : Limits.IsZero (Φ.obj (Limits.image f)) := zero_of_mono_zero _ hm0
        obtain ⟨M, ⟨e⟩⟩ := h7 _ hz
        refine ⟨Limits.factorThruImage f ≫ e.inv ≫
          P.map (adj.homEquiv M G (e.hom ≫ Limits.image.ι f)), ?_⟩
        have hc := adj.homEquiv_counit M G (adj.homEquiv M G (e.hom ≫ Limits.image.ι f))
        rw [Equiv.symm_apply_apply] at hc
        rw [Category.assoc, Category.assoc, ← hc, Iso.inv_hom_id_assoc, Limits.image.fac]

    let ψ : (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) ⟶ I.cocomplex :=
      { f := fun p => adj.counit.app (I.cocomplex.X p)
        comm' := fun i j _ => (adj.counit_naturality (I.cocomplex.d i j)).symm }
    let φ : I.cocomplex ⟶ (Pj.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        ((Φ.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) :=
      { f := fun p => adjj.unit.app (I.cocomplex.X p)
        comm' := fun i j _ => (adjj.unit_naturality (I.cocomplex.d i j)) }
    have hψφ : ψ ≫ φ = 0 := by
      ext p
      exact (hker _).1
    let S := ShortComplex.mk ψ φ hψφ
    have hS : S.ShortExact := by
      apply HomologicalComplex.shortExact_of_degreewise_shortExact
      intro p
      obtain ⟨hz, hmono, hlift⟩ := hker (I.cocomplex.X p)
      let T := ShortComplex.mk (adj.counit.app (I.cocomplex.X p))
        (adjj.unit.app (I.cocomplex.X p)) hz
      have hT : T.ShortExact := by
        refine ShortComplex.ShortExact.mk' ?_ hmono (h8 _ (I.injective p))
        exact ShortComplex.exact_of_f_is_kernel T
          (Limits.KernelFork.IsLimit.ofι' T.f T.zero (fun k hk =>
            ⟨(hlift _ k hk).choose, (hlift _ k hk).choose_spec⟩))
      exact hT
    have hIz : ∀ n : ℕ, Limits.IsZero (I.cocomplex.homology (n + 1)) := fun n =>
      (HomologicalComplex.exactAt_iff_isZero_homology _ _).1 (I.cocomplex_exactAt_succ n)
    have hX1 : Limits.IsZero (S.X₁.homology m) := by
      obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by omega⟩
      rcases Nat.eq_zero_or_pos n with hn | hn
      · subst hn
        have hηA : Epi (adjj.unit.app (((CochainComplex.single₀ C).obj A).X 0)) := h1 rfl

        have hepi : Epi (HomologicalComplex.homologyMap φ 0) := by
          have hnx : (ComplexShape.up ℕ).next 0 = 1 := by simp
          have hk : I.ι.f 0 ≫ I.cocomplex.d 0 1 = 0 := I.ι_f_zero_comp_complex_d
          let a := I.cocomplex.liftCycles (I.ι.f 0) 1 hnx hk
          haveI : Limits.PreservesLimitsOfSize.{0, 0} Pj := adjj.rightAdjoint_preservesLimits
          have hl := Limits.KernelFork.mapIsLimit _ (I.exact₀.fIsKernel) (Φ ⋙ Pj)
          let X₃ := (Pj.mapHomologicalComplex (ComplexShape.up ℕ)).obj
            ((Φ.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)
          let e := Limits.IsLimit.conePointUniqueUpToIso hl (X₃.cyclesIsKernel 0 1 hnx)
          let e' : (Φ ⋙ Pj).obj (((CochainComplex.single₀ C).obj A).X 0) ⟶ X₃.cycles 0 := e.hom
          haveI : IsIso e' := (inferInstance : IsIso e.hom)
          have he : e' ≫ X₃.iCycles 0 = Pj.map (Φ.map (I.ι.f 0)) :=
            Limits.IsLimit.conePointUniqueUpToIso_hom_comp hl (X₃.cyclesIsKernel 0 1 hnx)
              Limits.WalkingParallelPair.zero
          have hkey : a ≫ HomologicalComplex.cyclesMap φ 0 =
              adjj.unit.app (((CochainComplex.single₀ C).obj A).X 0) ≫ e' := by
            rw [← cancel_mono (X₃.iCycles 0), Category.assoc, Category.assoc, he,
              HomologicalComplex.cyclesMap_i, HomologicalComplex.liftCycles_i_assoc]
            exact (adjj.unit_naturality (I.ι.f 0)).symm
          have h3 : Epi (a ≫ HomologicalComplex.cyclesMap φ 0) := by
            rw [hkey]; infer_instance
          have h4 : Epi (HomologicalComplex.cyclesMap φ 0) := epi_of_epi a _
          exact epi_of_epi_fac (HomologicalComplex.homologyπ_naturality φ 0)
        have hδ0 : hS.δ 0 1 rfl = 0 := by
          apply (cancel_epi (HomologicalComplex.homologyMap φ 0)).1
          rw [Limits.comp_zero]
          exact hS.comp_δ 0 1 rfl
        have hδepi : Epi (hS.δ 0 1 rfl) :=
          (hS.homology_exact₁ 0 1 rfl).epi_f ((hIz 0).eq_of_tgt _ _)
        rw [Limits.IsZero.iff_id_eq_zero]
        apply (cancel_epi (hS.δ 0 1 rfl)).1
        rw [hδ0, Limits.zero_comp, Limits.zero_comp]
      · have h2' := h2 (by omega)
        rw [Nat.add_sub_cancel] at h2'
        exact (hS.homology_exact₁ n (n + 1) rfl).isZero_X₂ (h2'.eq_of_src _ _)
          ((hIz n).eq_of_tgt _ _)

    haveI : P.PreservesHomology := Functor.preservesHomologyOfExact P
    rw [← HomologicalComplex.exactAt_iff_isZero_homology, HomologicalComplex.exactAt_iff]
    rw [← HomologicalComplex.exactAt_iff_isZero_homology, HomologicalComplex.exactAt_iff] at hX1
    exact (ShortComplex.exact_map_iff_of_faithful _ P).1 hX1

  intro X Z i _ ℓ _ D R _ adj I V hV m hm h1 h2
  haveI := D.additive
  haveI hPadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont
      D.φ).Additive := Adjunction.right_adjoint_additive D.adj
  haveI hPlim : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) := by
    haveI := D.adj.rightAdjoint_preservesLimits.{0, 0}
    exact Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} _
  haveI hPcolim := wc_et_finite_push_modules_exact i ℓ D
  obtain ⟨hfull, hfaith⟩ := wc_et_closed_push_modules_full_faithful i ℓ D
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists V.ι ℓ
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim
  letI hPjadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange V.ι) _ _ Dj.cont
      Dj.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dj.adj Dj.additive
  refine abs_main
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ) R adj Dj.Φ
    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange V.ι) _ _ Dj.cont Dj.φ) Dj.adj
    (fun M => wc_et_open_pull_closed_push_isZero i ℓ V hV D Dj M)
    (fun K hK => wc_et_closed_push_essImage_of_open_pull_isZero i ℓ V hV D Dj K hK)
    (fun G hG => wc_et_open_unit_epi_of_injective V ℓ Dj G hG)
    _ I m hm ?_ ?_
  · intro h
