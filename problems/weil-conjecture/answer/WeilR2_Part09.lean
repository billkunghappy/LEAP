    letI : Algebra Ω (X.residueField q) := (ε.comp χ).toAlgebra
    have hint : ∀ c : Γ(X, ⊤), IsIntegral Ω (ε c) := fun c => (hχ c).map ε
    have hfrac : ∀ w : X.residueField q, ∃ a m : Γ(X, ⊤), IsUnit (ε m) ∧ w * ε m = ε a := by
      intro w
      obtain ⟨s, rfl⟩ := X.residue_surjective q w
