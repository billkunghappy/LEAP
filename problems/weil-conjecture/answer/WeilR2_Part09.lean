        exact (IsLocalization.map_units (X.presheaf.stalk q) m).map (X.residue q).hom
      · rw [← hgr, ← hgr, ← map_mul]
        congr 1
        exact IsLocalization.mk'_spec (X.presheaf.stalk q) a m
