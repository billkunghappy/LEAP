        let g : (wcEtBaseChange i).obj (Scheme.Etale.mk (e ≫ V.hom)) ⟶ X' k :=
          MorphismProperty.Over.homMk (ι.inv ≫ h) hover trivial
        have hc : (Presheaf.equalizerSieve (F := P)
            (X := Opposite.op ((wcEtBaseChange i).obj V)) x y).arrows (f' k) :=
          hle _ _ (Presieve.ofArrows.mk k)
        have hRm := (Presheaf.equalizerSieve (F := P)
            (X := Opposite.op ((wcEtBaseChange i).obj V)) x y).downward_closed hc g
        have hcomp : g ≫ f' k = (wcEtBaseChange i).map
            (MorphismProperty.Over.homMk e : Scheme.Etale.mk (e ≫ V.hom) ⟶ V) := by
          apply MorphismProperty.Over.Hom.ext
          refine Eq.trans ?_ key.symm
          show (ι.inv ≫ h) ≫ (f' k).left = _
          exact (Category.assoc _ _ _).trans (congrArg (ι.inv ≫ ·) hh)
        rw [hcomp] at hRm
        refine ⟨Scheme.Etale.mk (e ≫ V.hom), MorphismProperty.Over.homMk e, hRm, ?_⟩
        change v ∈ Set.range e
        refine ⟨Limits.pullback.fst e (Limits.pullback.fst V.hom i) x', ?_⟩
        have h1 : e (Limits.pullback.fst e (Limits.pullback.fst V.hom i) x') =
            Limits.pullback.fst V.hom i (Limits.pullback.snd e (Limits.pullback.fst V.hom i) x') := by
          rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
        have h2 : Limits.pullback.snd e (Limits.pullback.fst V.hom i) x' = (f' k).left (h x') :=
          (congrArg (fun m => m x') hh).symm.trans (Scheme.Hom.comp_apply _ _ _)
        rw [h1, h2, hx, hz, hy0]
