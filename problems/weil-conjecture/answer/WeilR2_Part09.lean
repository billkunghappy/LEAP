      | add x y hx hy => simp only [map_add, LinearMap.add_apply, hx, hy, add_smul]
    have haug : ∀ (α β : Type u) (g : α → β) (z : FreeAbelianGroup α),
        FreeAbelianGroup.lift (fun _ : β => (1 : ℤ)) (FreeAbelianGroup.map g z) =
          FreeAbelianGroup.lift (fun _ : α => (1 : ℤ)) z := by
      intro α β g z
      have : (FreeAbelianGroup.lift (fun _ : β => (1 : ℤ))).comp (FreeAbelianGroup.map g) =
          FreeAbelianGroup.lift (fun _ : α => (1 : ℤ)) := by
        apply FreeAbelianGroup.lift_ext
        intro a
        rw [AddMonoidHom.comp_apply, FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of]
      exact congrArg (fun h => h z) this
    have hgenT : ∀ (α β : Type u) (g : α → β) (A B : Type u) [AddCommGroup A] [AddCommGroup B]
        (h : A →+ B) (w : TensorProduct ℤ (FreeAbelianGroup α) A),
        TensorProduct.lift
            (FreeAbelianGroup.lift (fun _ : β => (LinearMap.id : B →ₗ[ℤ] B))).toIntLinearMap
          (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap h.toIntLinearMap w) =
        h (TensorProduct.lift
            (FreeAbelianGroup.lift (fun _ : α => (LinearMap.id : A →ₗ[ℤ] A))).toIntLinearMap w) := by
      intro α β g A B _ _ h w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul z y =>
        rw [TensorProduct.map_tmul, TensorProduct.lift.tmul, TensorProduct.lift.tmul]
        simp only [AddMonoidHom.coe_toIntLinearMap]
        rw [hL, hL, haug, map_zsmul]
      | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂, map_add, map_add]
    have hεnat : ∀ ⦃R S : CommRingCat.{u}⦄ (φ : R ⟶ S),
        (wcTensFun (wcKtZUT.{u} ℓ 0) (wcKtT.{u} (ℓ ^ n) 0)).map φ ≫
          AddCommGrpCat.ofHom (TensorProduct.lift
            (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
              (wcKtT.{u} (ℓ ^ n) 0).obj S →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) 0).obj S))).toIntLinearMap).toAddMonoidHom =
        AddCommGrpCat.ofHom (TensorProduct.lift
            (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
