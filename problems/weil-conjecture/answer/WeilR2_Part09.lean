      have hmapi : ∀ {W W' : (Y.Etale)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
          ival W' (Q.map g a) = P.map g (ival W a) := fun g a => rfl
      have hext : ∀ {W : (Y.Etale)ᵒᵖ} (a b : Q.obj W), val W a = val W b → a = b := by
