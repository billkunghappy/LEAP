      have e1 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ ((Limits.pullback.lift _ _ hw).hom x))
        (Limits.pullbackObjIso_inv_comp_fst (wcKtPsi.{u} ℓ D k)
          ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ D) wcKtGm.{u}))
          (Scheme.Γ.obj (Opposite.op W.unop.left)))
      have e2 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ ((Limits.pullback.lift _ _ hw).hom x))
        (Limits.pullbackObjIso_inv_comp_snd (wcKtPsi.{u} ℓ D k)
          ((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ D) wcKtGm.{u}))
          (Scheme.Γ.obj (Opposite.op W.unop.left)))
      have e3 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ x) (Limits.pullback.lift_fst _ _ hw)
      have e4 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ x) (Limits.pullback.lift_snd _ _ hw)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at e1 e2 e3 e4
      exact ⟨e1.trans (e3.trans rfl), e2.trans (e4.trans rfl)⟩
    · rename_i hne
      exfalso
      apply hne
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro y
      obtain ⟨⟨y1, y2⟩, hy⟩ := y
      have hy' : (Additive.toMul y2) ^ (ℓ ^ n) = (wcKaUnit Y a W) ^ y1 := hy
      have key : (y1 • Additive.ofMul (wcKaUnit Y a W) :
          Additive (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ) = (ℓ ^ n) • y2 := by
        rw [← ofMul_zpow, ← hy', ofMul_pow, ofMul_toMul]
      show ((wcKtPsi.{u} ℓ D k).app (Scheme.Γ.obj (Opposite.op W.unop.left))).hom
          (y1 • FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W)) =
        (((ℓ ^ n) • 𝟙 (wcTensFun (wcKtZUT.{u} ℓ D) wcKtGm.{u})).app
          (Scheme.Γ.obj (Opposite.op W.unop.left))).hom
          (TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            (N := wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            (FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W)) y2)
      refine (congrArg (fun F => AddCommGrpCat.Hom.hom F
        (y1 • FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W))) (hpsi _)).trans ?_
      refine Eq.trans ?_ (hR _ _).symm
      show FreeAbelianGroup.lift _ (y1 • FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W)) = _
      refine ((map_zsmul _ y1 _).trans
        (congrArg (fun z => y1 • z) (FreeAbelianGroup.lift_apply_of _ _))).trans ?_
      refine (hzs _ _ _).trans ?_
      refine Eq.trans ?_ (hsm _ _ _).symm
      exact congrArg (fun g => TensorProduct.tmul ℤ
        (M := (wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
        (N := wcKtGm.{u}.obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
        (FreeAbelianGroup.of (wcKaTup Y ℓ D s hℓ W)) g)
        ((congrArg (fun c => y1 • (Additive.ofMul c :
          Additive (Scheme.Γ.obj (Opposite.op W.unop.left))ˣ)) (hcoordW W)).trans key)

  have hGEN : ∀ (W : (Y.Etale)ᵒᵖ)
      (ζ : (wcRootsFun.{u} (ℓ ^ n)).obj (Scheme.Γ.obj (Opposite.op W.unop.left))),
      ((wcKtIotaE.{u} ℓ n D k).app (Scheme.Γ.obj (Opposite.op W.unop.left))).hom
