        intro a; rw [← Scheme.germ_residue]; rfl
      have hker : ∀ a : Γ(Y, U), (Y.evaluation U x hxU).hom a = 0 ↔
          a ∈ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal := by
        intro a
        rw [hev']
        show IsLocalRing.residue _ _ = 0 ↔ _
        rw [IsLocalRing.residue_eq_zero_iff]
        exact IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ _
      refine ⟨hker, fun z => ?_⟩
      obtain ⟨s, rfl⟩ := Y.residue_surjective x z
      obtain ⟨⟨a, b⟩, hs⟩ := IsLocalization.mk'_surjective
        (hU.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl s
      refine ⟨a, b, ?_, ?_⟩
      · intro h
        exact b.2 ((hker b).mp h)
      · rw [hev, hev', hev', ← map_mul, ← hs]
        simp only
        rw [IsLocalization.mk'_spec]

    set φK : K →+* Γ(Y, U) :=
      (f.appLE ⊤ U le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom with hφK
    have ALG : ∀ c : K, algebraMap K (Y.residueField x) c = ev (φK c) := by
      intro c
      have hD : Spec.preimage (Y.fromSpecResidueField x ≫ f) =
          (Scheme.ΓSpecIso (.of K)).inv ≫ f.appTop ≫ Y.presheaf.germ ⊤ x trivial ≫
            Y.residue x := by
        apply Spec.map_injective
        rw [Spec.map_preimage]
        simp only [Spec.map_comp, Category.assoc]
        rw [← Scheme.fromSpecStalk_toSpecΓ_assoc, ← Scheme.toSpecΓ_naturality_assoc,
          toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id, ← Category.assoc]
        rfl
      have hE : f.appLE ⊤ U le_top ≫ Y.evaluation U x hxU =
          f.appTop ≫ Y.presheaf.germ ⊤ x trivial ≫ Y.residue x := by
        rw [← Scheme.germ_residue]
        have h1 : f.appLE ⊤ U le_top =
            f.app ⊤ ≫ Y.presheaf.map (homOfLE (le_top : U ≤ f ⁻¹ᵁ ⊤)).op := rfl
        rw [h1, Category.assoc]
        erw [TopCat.Presheaf.germ_res_assoc]
        rfl
