theorem wc_lpgfg_symbol_order (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (d : ℕ) (hd : 1 ≤ d)
    (hsm : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) (hn : 1 ≤ n)
    (T VT : X.left.ProEt) (g : T ⟶ wcGeomPoint F X h) (j : VT ⟶ T)
    (A : Type u) [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)]
