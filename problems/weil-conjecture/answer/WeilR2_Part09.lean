    refine ⟨n, fun i => ι (g (MvPolynomial.X i)), ?_, halg⟩

    have h1 : ((n : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (MvPolynomial (Fin n) K) := by
      have := ringKrullDim_add_natCard_le_ringKrullDim_mvPolynomial (R := K) (Fin n)
      rwa [ringKrullDim_eq_zero_of_field, Nat.card_fin, zero_add] at this
    have h2 : ringKrullDim (MvPolynomial (Fin n) K) ≤ ringKrullDim (Γ(Y, U) ⧸ pI) :=
      GU _ _ (g : MvPolynomial (Fin n) K →+* Γ(Y, U) ⧸ pI) hginj (RingHom.IsIntegral.of_finite hgfin)
    have h3 : ringKrullDim (Γ(Y, U) ⧸ pI) ≤ topologicalKrullDim ↥(closure ({x} : Set Y)) := by
      let F : PrimeSpectrum (Γ(Y, U) ⧸ pI) → Y :=
        fun Q => hU.fromSpec (PrimeSpectrum.comap (Ideal.Quotient.mk pI) Q)
