theorem wc_et_supp_restr_comp_sub : ∀ {Y Y₁ Y₂ X X₁ X₂ : Scheme.{u}} {n : ℕ} {i : X ⟶ Y} {i₁ : X₁ ⟶ Y₁} {i₂ : X₂ ⟶ Y₂} (f₁ : Y₁ ⟶ Y) (f₂ : Y₂ ⟶ Y₁) (f₁₂ : Y₂ ⟶ Y), f₂ ≫ f₁ = f₁₂ → ∀ (D : wcEtPullData i n) (D₁ : wcEtPullData i₁ n) (D₂ : wcEtPullData i₂ n) (E₁ : wcEtPullData f₁ n) (E₂ : wcEtPullData f₂ n) (E₁₂ : wcEtPullData f₁₂ n) (γ₁ : wcEtSuppObj D₁ ⟶ E₁.Φ.obj (wcEtSuppObj D)) (γ₂ : wcEtSuppObj D₂ ⟶ E₂.Φ.obj (wcEtSuppObj D₁)) (γ₁₂ : wcEtSuppObj D₂ ⟶ E₁₂.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D₁ ≫ γ₁ = E₁.μ.inv ≫ E₁.Φ.map (wcEtSuppUnitMap D) → wcEtSuppUnitMap D₂ ≫ γ₂ = E₂.μ.inv ≫ E₂.Φ.map (wcEtSuppUnitMap D₁) → wcEtSuppUnitMap D₂ ≫ γ₁₂ = E₁₂.μ.inv ≫ E₁₂.Φ.map (wcEtSuppUnitMap D) → Epi (wcEtSuppUnitMap D₂) → ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y n)) (c : N ⟶ wcEtSuppObj D), Mono c → ∀ (κ₁ : wcEtSuppObj D₁ ⟶ E₁.Φ.obj N) (κ₁₂ : wcEtSuppObj D₂ ⟶ E₁₂.Φ.obj N), κ₁ ≫ E₁.Φ.map c = γ₁ → κ₁₂ ≫ E₁₂.Φ.map c = γ₁₂ → ∀ k : ℕ, letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y₁ n)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y₂ n)) := HasExt.standard _; letI : E₁.Φ.Additive := E₁.additive; letI : Limits.PreservesFiniteLimits E₁.Φ := E₁.presLim; letI : Limits.PreservesFiniteColimits E₁.Φ := E₁.presColim; letI : E₁₂.Φ.Additive := E₁₂.additive; letI : Limits.PreservesFiniteLimits E₁₂.Φ := E₁₂.presLim; letI : Limits.PreservesFiniteColimits E₁₂.Φ := E₁₂.presColim; ∀ x : Abelian.Ext N (SheafOfModules.unit (wcEtZModRing Y n)) k, (Abelian.Ext.mk₀ κ₁₂).comp ((Abelian.Ext.mapExactFunctor E₁₂.Φ x).comp (Abelian.Ext.mk₀ E₁₂.μ.hom) (add_zero k)) (zero_add k) = wcEtSuppRestr D₁ E₂ D₂ γ₂ k ((Abelian.Ext.mk₀ κ₁).comp ((Abelian.Ext.mapExactFunctor E₁.Φ x).comp (Abelian.Ext.mk₀ E₁.μ.hom) (add_zero k)) (zero_add k)) :=
by
  classical
  intro Y Y₁ Y₂ X X₁ X₂ n i i₁ i₂ f₁ f₂ f₁₂ hf D D₁ D₂ E₁ E₂ E₁₂ γ₁ γ₂ γ₁₂ h₁ h₂ h₁₂ hepi
    N c hmc κ₁ κ₁₂ hK₁ hK₁₂ k x
  subst hf

  have s1 : ∀ (X' : Scheme.{u}) (T : Sheaf (Scheme.smallEtaleTopology X') RingCat.{u+1})
      (a b : wcEtZModRing X' n ⟶ T), a = b := by
    intro X' T a b
    have key : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod n) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod n →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    apply Sheaf.hom_ext
    apply sheafify_hom_ext (Scheme.smallEtaleTopology X') _ _ T.cond
    apply NatTrans.ext
    funext V
    apply RingCat.hom_ext
    exact key _ _

  have s2 : ∀ (X' : Scheme.{u}) (V : (X'.Etale)ᵒᵖ) (a b : ↑((wcEtZModRing X' n).obj.obj V)),
      a * b = b * a := by
    intro X' V a b
    obtain ⟨α, hsurj⟩ : ∃ α : (Functor.const (X'.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtZModRing X' n).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X') α :=
      ⟨toSheafify (Scheme.smallEtaleTopology X')
          ((Functor.const (X'.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))),
        Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology X') _⟩
    haveI := hsurj
    have hsep := Sheaf.isSeparated (wcEtZModRing X' n)
    induction V using Opposite.rec with
    | op V =>
    refine hsep V _ (GrothendieckTopology.intersection_covering _
      (Presheaf.imageSieve_mem _ α a) (Presheaf.imageSieve_mem _ α b)) (a * b) (b * a) ?_
    intro W h hh
    have hh' : (Presheaf.imageSieve α a).arrows h ∧ (Presheaf.imageSieve α b).arrows h := hh
    obtain ⟨⟨t₁, ht₁⟩, ⟨t₂, ht₂⟩⟩ := hh'
    have hc : t₁ * t₂ = t₂ * t₁ := @mul_comm (ULift.{u+1} (ZMod n)) _ t₁ t₂
    rw [map_mul, map_mul, ← ht₁, ← ht₂, ← map_mul, ← map_mul]
    exact congrArg _ hc

  have hmap : ∀ {A B : Scheme.{u}} (h : A ⟶ B) {V V' : B.Etale} (u : V ⟶ V'),
      ((wcEtBaseChange h).map u).left ≫ Limits.pullback.fst V'.hom h =
        Limits.pullback.fst V.hom h ≫ u.left ∧
      ((wcEtBaseChange h).map u).left ≫ Limits.pullback.snd V'.hom h =
        Limits.pullback.snd V.hom h := by
    intro A B h V V' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsnd : ∀ V : Y.Etale, (Limits.pullbackLeftPullbackSndIso V.hom f₁ f₂).symm.hom ≫
      Limits.pullback.snd (Limits.pullback.snd V.hom f₁) f₂ =
        Limits.pullback.snd V.hom (f₂ ≫ f₁) := by
    intro V
    rw [Iso.symm_hom, Iso.inv_comp_eq, Limits.pullbackLeftPullbackSndIso_hom_snd]
  choose cc hcc using fun V : Y.Etale =>
    (⟨MorphismProperty.Over.isoMk (A := (wcEtBaseChange (f₂ ≫ f₁)).obj V)
        (B := (wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂).obj V)
        (Limits.pullbackLeftPullbackSndIso V.hom f₁ f₂).symm (hsnd V),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcEtBaseChange (f₂ ≫ f₁)).obj V ≅ (wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂).obj V,
        c.hom.left = (Limits.pullbackLeftPullbackSndIso V.hom f₁ f₂).inv)
  have natc : ∀ {V V' : Y.Etale} (u : V ⟶ V'),
      (wcEtBaseChange (f₂ ≫ f₁)).map u ≫ (cc V').hom =
        (cc V).hom ≫ (wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂).map u := by
    intro V V' u
    have key : ∀ (L : Limits.pullback V.hom (f₂ ≫ f₁) ⟶ Limits.pullback V'.hom (f₂ ≫ f₁))
        (M1 : Limits.pullback V.hom f₁ ⟶ Limits.pullback V'.hom f₁)
        (M2 : Limits.pullback (Limits.pullback.snd V.hom f₁) f₂ ⟶
          Limits.pullback (Limits.pullback.snd V'.hom f₁) f₂),
        L ≫ Limits.pullback.fst V'.hom (f₂ ≫ f₁) = Limits.pullback.fst V.hom (f₂ ≫ f₁) ≫ u.left →
        L ≫ Limits.pullback.snd V'.hom (f₂ ≫ f₁) = Limits.pullback.snd V.hom (f₂ ≫ f₁) →
        M1 ≫ Limits.pullback.fst V'.hom f₁ = Limits.pullback.fst V.hom f₁ ≫ u.left →
        M1 ≫ Limits.pullback.snd V'.hom f₁ = Limits.pullback.snd V.hom f₁ →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd V'.hom f₁) f₂ =
          Limits.pullback.fst (Limits.pullback.snd V.hom f₁) f₂ ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd V'.hom f₁) f₂ =
          Limits.pullback.snd (Limits.pullback.snd V.hom f₁) f₂ →
        L ≫ (Limits.pullbackLeftPullbackSndIso V'.hom f₁ f₂).inv =
          (Limits.pullbackLeftPullbackSndIso V.hom f₁ f₂).inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst V.hom f₁ f₂)]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcEtBaseChange (f₂ ≫ f₁)).map u).left ≫ (cc V').hom.left =
      (cc V).hom.left ≫ ((wcEtBaseChange f₂).map ((wcEtBaseChange f₁).map u)).left
    rw [hcc V, hcc V']
    exact key _ _ _ (hmap (f₂ ≫ f₁) u).1 (hmap (f₂ ≫ f₁) u).2 (hmap f₁ u).1 (hmap f₁ u).2
      (hmap f₂ ((wcEtBaseChange f₁).map u)).1 (hmap f₂ ((wcEtBaseChange f₁).map u)).2
  let α : wcEtBaseChange (f₂ ≫ f₁) ≅ wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂ :=
    NatIso.ofComponents cc natc

  haveI := E₁.cont
  haveI := E₂.cont
  haveI := E₁₂.cont
  haveI : (wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂).IsContinuous (Scheme.smallEtaleTopology Y)
