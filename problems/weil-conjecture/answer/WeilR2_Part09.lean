  choose εI hεI hsign using s7

  have hconn : ∀ (S : ShortComplex D) (hS : S.ShortExact) (b : ℕ) (x : Abelian.Ext (L.obj S.X₁) A (b + 1)),
      E₀ (b + 1) S.X₃ ((hS.map_of_exact L).extClass.comp x (add_comm 1 (b + 1))) =
        εI (b + 1) • hS.extClass.comp (E₀ b S.X₁ x) (add_comm 1 b) := by
    intro S hS b x
    obtain ⟨f, hf, rfl⟩ := I.extMk_surjective x (b + 1 + 1) rfl
    haveI : Mono (L.map S.f) := (hS.map_of_exact L).mono_f
    haveI : Epi (L.map S.g) := (hS.map_of_exact L).epi_g
    haveI := I.injective (b + 1)
    let f' : L.obj S.X₂ ⟶ I.cocomplex.X (b + 1) := Injective.factorThru f (L.map S.f)
    have h1 : L.map S.f ≫ f' = f := Injective.comp_factorThru _ _
    have hz : L.map S.f ≫ (f' ≫ I.cocomplex.d (b + 1) (b + 1 + 1)) = 0 := by
      rw [← Category.assoc, h1, hf]
    obtain ⟨h, h2⟩ := Limits.CokernelCofork.IsColimit.desc' (hS.map_of_exact L).gIsCokernel
      (f' ≫ I.cocomplex.d (b + 1) (b + 1 + 1)) hz
    have h2' : L.map S.g ≫ h = f' ≫ I.cocomplex.d (b + 1) (b + 1 + 1) := h2
    have hh : h ≫ I.cocomplex.d (b + 1 + 1) (b + 1 + 1 + 1) = 0 := by
      rw [← cancel_epi (L.map S.g), reassoc_of% h2', HomologicalComplex.d_comp_d, Limits.comp_zero,
        Limits.comp_zero]
    let τ : S ⟶ ShortComplex.mk _ _ (hw b) := ShortComplex.homMk
      (K.liftCycles (adj.homEquiv _ _ f) (b + 1 + 1) (by simp) (hφd (b + 1) f hf))
      (adj.homEquiv _ _ f')
      (K.liftCycles (adj.homEquiv _ _ h) (b + 1 + 1 + 1) (by simp) (hφd (b + 1 + 1) h hh))
      (by
        show _ ≫ K.iCycles (b + 1) = S.f ≫ adj.homEquiv _ _ f'
        rw [K.liftCycles_i, ← Adjunction.homEquiv_naturality_left, h1])
      (by
        show adj.homEquiv _ _ f' ≫ K.toCycles (b + 1) (b + 1 + 1) = S.g ≫ _
        rw [← cancel_mono (K.iCycles (b + 1 + 1)), Category.assoc, Category.assoc, K.toCycles_i,
          K.liftCycles_i, hKd, ← Adjunction.homEquiv_naturality_right,
          ← Adjunction.homEquiv_naturality_left, h2'])
    have N : hS.extClass.comp (Abelian.Ext.mk₀
          (K.liftCycles (adj.homEquiv _ _ f) (b + 1 + 1) (by simp) (hφd (b + 1) f hf))) (add_zero 1) =
        (Abelian.Ext.mk₀
          (K.liftCycles (adj.homEquiv _ _ h) (b + 1 + 1 + 1) (by simp) (hφd (b + 1 + 1) h hh))).comp
          (hK b).extClass (zero_add 1) :=
      ShortComplex.ShortExact.extClass_naturality hS (hK b) τ
    have hs := hsign (b + 1) (S.map L) (hS.map_of_exact L) f hf f' h1 h h2' hh
    have hs' : (hS.map_of_exact L).extClass.comp (I.extMk f (b + 1 + 1) rfl hf) (add_comm 1 (b + 1)) =
        εI (b + 1) • I.extMk h (b + 1 + 1 + 1) rfl hh := hs
    rw [hs', map_zsmul, hE (b + 1) S.X₃ h hh (hφd (b + 1 + 1) h hh), hΔs b,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_comm 1 b) (show 0 + 1 + b = b + 1 by omega),
      ← N, Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add b) (show 1 + 0 + b = b + 1 by omega),
      ← hE b S.X₁ f hf (hφd (b + 1) f hf)]

  obtain ⟨ε, hε, hprod⟩ := s6 (K.homology 1) (fun P m => E₀ m P) (fun b => εI (b + 1))
    (fun b => hεI (b + 1)) (fun P P' f b x => hnat b P P' f x) hconn
  refine ⟨fun P k => E₀ k P, ε, hε, ?_, hprod⟩

  intro P₁ g hg hf
  have h0 := hE 0 P₁ g hg hf
  rw [hΔ0, Abelian.Ext.mk₀_comp_mk₀] at h0
  exact h0

theorem wc_lptt_canpre_squares {X Z : Scheme.{u}} (g : Z ⟶ X) :
    (∀ {G G' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (a : G ⟶ G'),
      wcLpttPreMap X a ≫ wcLpttCanPre g G' =
        wcLpttCanPre g G ≫ Functor.whiskerLeft (wcEtBaseChange g).op (wcLpttPreMap Z a)) ∧
    ∀ (ℓ n D k : ℕ) (s : Fin D → (Γ(X, ⊤))ˣ) (hℓX : IsUnit ((ℓ : ℕ) : Γ(X, ⊤)))
      (hℓZ : IsUnit ((ℓ : ℕ) : Γ(Z, ⊤))),
      wcLpttUSecPre X ℓ n D k s hℓX ≫
          wcLpttCanPre g (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) k)) =
        wcLpttCanPre g (wcKtT.{u} (ℓ ^ n) k) ≫
          Functor.whiskerLeft (wcEtBaseChange g).op
            (wcLpttUSecPre Z ℓ n D k (fun i => Units.map g.appTop.hom.toMonoidHom (s i)) hℓZ) :=
by
  refine ⟨?_, ?_⟩
  · intro G G' a
    apply NatTrans.ext
    funext V
    show AddCommGrpCat.uliftFunctor.map (a.app _) ≫
        AddCommGrpCat.uliftFunctor.map (G'.map (Scheme.Γ.map ((wcEtBaseChangeFst g).app V.unop).op)) =
      AddCommGrpCat.uliftFunctor.map (G.map (Scheme.Γ.map ((wcEtBaseChangeFst g).app V.unop).op)) ≫
        AddCommGrpCat.uliftFunctor.map (a.app _)
    rw [← Functor.map_comp, ← Functor.map_comp, a.naturality]
  · intro ℓ n D k s hℓX hℓZ

    have hH : ∀ {R S : CommRingCat.{u}} (r : R ⟶ S) (t : Fin D → Rˣ) (ht : IsUnit ((ℓ : ℕ) : R))
        (t' : Fin D → Sˣ) (ht' : IsUnit ((ℓ : ℕ) : S)), (∀ i, r.hom (t i : R) = (t' i : S)) →
        ∀ z : (wcKtT.{u} (ℓ ^ n) k).obj R,
        ((wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) k)).map r).hom
            (TensorProduct.mk ℤ ((wcKtZUT.{u} ℓ D).obj R) ((wcKtT.{u} (ℓ ^ n) k).obj R)
              (FreeAbelianGroup.of (⟨t, ht⟩ : (wcUnitTupleFun.{u} ℓ D).obj R)) z) =
          TensorProduct.mk ℤ ((wcKtZUT.{u} ℓ D).obj S) ((wcKtT.{u} (ℓ ^ n) k).obj S)
            (FreeAbelianGroup.of (⟨t', ht'⟩ : (wcUnitTupleFun.{u} ℓ D).obj S))
            (((wcKtT.{u} (ℓ ^ n) k).map r).hom z) := by
      intro R S r t ht t' ht' hrt z
      have hz : ((wcKtZUT.{u} ℓ D).map r).hom
          (FreeAbelianGroup.of (⟨t, ht⟩ : (wcUnitTupleFun.{u} ℓ D).obj R)) =
          FreeAbelianGroup.of (⟨t', ht'⟩ : (wcUnitTupleFun.{u} ℓ D).obj S) := by
        show (ConcreteCategory.hom (AddCommGrpCat.free.map ((wcUnitTupleFun.{u} ℓ D).map r)))
          (FreeAbelianGroup.of (⟨t, ht⟩ : (wcUnitTupleFun.{u} ℓ D).obj R)) = _
        rw [AddCommGrpCat.free_map_coe]
        refine (FreeAbelianGroup.map_of _ _).trans ?_
        refine congrArg FreeAbelianGroup.of (Subtype.ext (funext fun i => Units.ext ?_))
        exact hrt i
      have e2 := TensorProduct.map_tmul ((wcKtZUT.{u} ℓ D).map r).hom.toIntLinearMap
        ((wcKtT.{u} (ℓ ^ n) k).map r).hom.toIntLinearMap
        (FreeAbelianGroup.of (⟨t, ht⟩ : (wcUnitTupleFun.{u} ℓ D).obj R) :
          (wcKtZUT.{u} ℓ D).obj R) z
      rw [AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.coe_toIntLinearMap, hz] at e2
      exact e2

    have happ : ∀ (Y : Scheme.{u}) (s : Fin D → (Γ(Y, ⊤))ˣ) (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤)))
        (W : (Y.Etale)ᵒᵖ) (hW : IsUnit ((ℓ : ℕ) : Γ(W.unop.left, ⊤)))
        (y : (wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left))),
        ((wcLpttUSecPre Y ℓ n D k s hℓ).app W).hom (ULift.up y) =
          ULift.up (TensorProduct.mk ℤ
            ((wcKtZUT.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            ((wcKtT.{u} (ℓ ^ n) k).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))
            (FreeAbelianGroup.of (⟨fun i => Units.map W.unop.hom.appTop.hom.toMonoidHom (s i), hW⟩ :
              (wcUnitTupleFun.{u} ℓ D).obj (Scheme.Γ.obj (Opposite.op W.unop.left)))) y) := by
      intro Y s hℓ W hW y
      have hU : ∀ W' : (Y.Etale)ᵒᵖ, IsUnit ((ℓ : ℕ) : Γ(W'.unop.left, ⊤)) := by
        intro W'
        have h := hℓ.map W'.unop.hom.appTop.hom
        rw [map_natCast] at h
        exact h
      unfold wcLpttUSecPre wcNatOf
      split_ifs with hN
      · rfl
      · exfalso
        apply hN
        intro W₁ W₂ φ
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        rintro ⟨y₁⟩
        refine (congrArg ULift.up (hH (Scheme.Γ.map φ.unop.left.op)
          (fun i => Units.map W₁.unop.hom.appTop.hom.toMonoidHom (s i)) (hU W₁)
          (fun i => Units.map W₂.unop.hom.appTop.hom.toMonoidHom (s i)) (hU W₂)
          (fun i => ?_) y₁)).symm
        show (Scheme.Γ.map φ.unop.left.op).hom (W₁.unop.hom.appTop.hom (s i : Γ(Y, ⊤))) =
          W₂.unop.hom.appTop.hom (s i : Γ(Y, ⊤))
        have hw := congrArg (fun q => q.appTop.hom (s i : Γ(Y, ⊤))) (MorphismProperty.Over.w φ.unop)
        exact hw
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨y⟩
    have hUX : IsUnit ((ℓ : ℕ) : Γ(V.unop.left, ⊤)) := by
      have h := hℓX.map V.unop.hom.appTop.hom
      rw [map_natCast] at h
      exact h
    have hUZ : IsUnit ((ℓ : ℕ) : Γ(((wcEtBaseChange g).obj V.unop).left, ⊤)) := by
      have h := hℓZ.map ((wcEtBaseChange g).obj V.unop).hom.appTop.hom
      rw [map_natCast] at h
      exact h

    have hc : (wcEtBaseChangeFst g).app V.unop ≫ V.unop.hom =
        ((wcEtBaseChange g).obj V.unop).hom ≫ g := Limits.pullback.condition
    have hsq : ∀ i, (Scheme.Γ.map ((wcEtBaseChangeFst g).app V.unop).op).hom
        (V.unop.hom.appTop.hom (s i : Γ(X, ⊤))) =
        ((wcEtBaseChange g).obj V.unop).hom.appTop.hom (g.appTop.hom (s i : Γ(X, ⊤))) := by
      intro i
      have h := congrArg (fun φ => φ.appTop.hom (s i : Γ(X, ⊤))) hc
      exact h
    have h1 := happ X s hℓX V hUX y
    have h2 := happ Z (fun i => Units.map g.appTop.hom.toMonoidHom (s i)) hℓZ
      (Opposite.op ((wcEtBaseChange g).obj V.unop)) hUZ
      (((wcKtT.{u} (ℓ ^ n) k).map (Scheme.Γ.map ((wcEtBaseChangeFst g).app V.unop).op)).hom y)
    have h3 := hH (Scheme.Γ.map ((wcEtBaseChangeFst g).app V.unop).op)
      (fun i => Units.map V.unop.hom.appTop.hom.toMonoidHom (s i)) hUX
      (fun i => Units.map ((wcEtBaseChange g).obj V.unop).hom.appTop.hom.toMonoidHom
        (Units.map g.appTop.hom.toMonoidHom (s i))) hUZ hsq y
    exact (congrArg (fun w => ((wcLpttCanPre g
      (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) k))).app V).hom w) h1).trans
      ((congrArg ULift.up h3).trans h2.symm)

theorem wc_lptt_gen0_gam {Z Y : Scheme.{u}} (g : Z ⟶ Y) (ℓ n : ℕ)
    (hℓY : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (hℓZ : IsUnit ((ℓ : ℕ) : Γ(Z, ⊤))) :
    wcLpttGen0 Y ℓ n hℓY ≫ wcLpttGam g (wcKtT.{u} (ℓ ^ n) 0) =
      wcLpttGamF g ≫ (wcEtPush g).map (wcLpttGen0 Z ℓ n hℓZ) :=
by
  classical

  have he : ∀ R : CommRingCat.{u}, wcLpttE0.{u} (ℓ ^ n) R =
      ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0) :
        (wcKtT.{u} (ℓ ^ n) 0).obj R) := fun _ => rfl
  have heT' : ∀ (R S : CommRingCat.{u}) (r : R ⟶ S) (y : (wcKtT.{u} (ℓ ^ n) 0).obj R),
      y = wcLpttE0 (ℓ ^ n) R → ((wcKtT.{u} (ℓ ^ n) 0).map r).hom y = wcLpttE0 (ℓ ^ n) S := by
    intro R S φ y hy
    rw [hy, he, he]
    show (LinearMap.lTensor (ZMod (ℓ ^ n)) (PiTensorProduct.map fun _ : Fin 0 =>
      ((wcRootsFun.{u} (ℓ ^ n)).map φ).hom.toIntLinearMap))
        ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0)) = _
    rw [LinearMap.lTensor_tmul]
    erw [PiTensorProduct.map_tprod]
    congr 2
    funext i
    exact i.elim0

  have hL : ∀ (M : Type u) [AddCommGroup M] (α : Type u) (a : FreeAbelianGroup α) (b : M),
      (FreeAbelianGroup.lift (fun _ : α => (LinearMap.id : M →ₗ[ℤ] M))) a b =
        (FreeAbelianGroup.lift (fun _ : α => (1 : ℤ)) a) • b := by
    intro M _ α a b
    induction a using FreeAbelianGroup.induction_on with
    | zero => simp
    | of x => simp [FreeAbelianGroup.lift_apply_of]
    | neg x hx => simp only [map_neg, LinearMap.neg_apply, hx, neg_smul]
    | add x y hx hy => simp only [map_add, LinearMap.add_apply, hx, hy, add_smul]
  have haug : ∀ (α β : Type u) (g : α → β) (z : FreeAbelianGroup α),
      FreeAbelianGroup.lift (fun _ : β => (1 : ℤ)) (FreeAbelianGroup.map g z) =
        FreeAbelianGroup.lift (fun _ : α => (1 : ℤ)) z := by
    intro α β g z
    have : (FreeAbelianGroup.lift (fun _ : β => (1 : ℤ))).comp (FreeAbelianGroup.map g) =
        FreeAbelianGroup.lift (fun _ : α => (1 : ℤ)) := by
      apply FreeAbelianGroup.lift_ext
      intro a
      rw [AddMonoidHom.comp_apply, FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
        FreeAbelianGroup.lift_apply_of]
    exact congrArg (fun h => h z) this
  have hgenT : ∀ (α β : Type u) (g : α → β) (A B : Type u) [AddCommGroup A] [AddCommGroup B]
      (h : A →+ B) (w : TensorProduct ℤ (FreeAbelianGroup α) A),
      TensorProduct.lift
          (FreeAbelianGroup.lift (fun _ : β => (LinearMap.id : B →ₗ[ℤ] B))).toIntLinearMap
        (TensorProduct.map (FreeAbelianGroup.map g).toIntLinearMap h.toIntLinearMap w) =
      h (TensorProduct.lift
          (FreeAbelianGroup.lift (fun _ : α => (LinearMap.id : A →ₗ[ℤ] A))).toIntLinearMap w) := by
    intro α β g A B _ _ h w
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul z y =>
      rw [TensorProduct.map_tmul, TensorProduct.lift.tmul, TensorProduct.lift.tmul]
      simp only [AddMonoidHom.coe_toIntLinearMap]
      rw [hL, hL, haug, map_zsmul]
    | add w₁ w₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂, map_add, map_add]
  have hεnat : ∀ ⦃R S : CommRingCat.{u}⦄ (φ : R ⟶ S),
      (wcTensFun (wcKtZUT.{u} ℓ 0) (wcKtT.{u} (ℓ ^ n) 0)).map φ ≫
        AddCommGrpCat.ofHom (TensorProduct.lift
          (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
            (wcKtT.{u} (ℓ ^ n) 0).obj S →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) 0).obj S))).toIntLinearMap).toAddMonoidHom =
      AddCommGrpCat.ofHom (TensorProduct.lift
          (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
            (wcKtT.{u} (ℓ ^ n) 0).obj R →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) 0).obj R))).toIntLinearMap).toAddMonoidHom ≫
        (wcKtT.{u} (ℓ ^ n) 0).map φ := by
    intro R S φ
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro w
    exact hgenT _ _ _ _ _ _ w
  have hεapp : ∀ (R : CommRingCat.{u}) (t : (wcUnitTupleFun.{u} ℓ 0).obj R)
      (y : (wcKtT.{u} (ℓ ^ n) 0).obj R),
      ((wcKtEps.{u} ℓ n 0).app R).hom
        (TensorProduct.tmul ℤ (M := (wcKtZUT.{u} ℓ 0).obj R) (N := (wcKtT.{u} (ℓ ^ n) 0).obj R)
          (FreeAbelianGroup.of t) y) = y := by
    intro R t y
    unfold wcKtEps wcNatOf
    split_ifs with h
    · change (TensorProduct.lift (FreeAbelianGroup.lift (fun _ => (LinearMap.id :
          (wcKtT.{u} (ℓ ^ n) 0).obj R →ₗ[ℤ] (wcKtT.{u} (ℓ ^ n) 0).obj R))).toIntLinearMap)
          (FreeAbelianGroup.of t ⊗ₜ[ℤ] y) = y
      rw [TensorProduct.lift.tmul, AddMonoidHom.coe_toIntLinearMap, FreeAbelianGroup.lift_apply_of,
        LinearMap.id_apply]
    · exact absurd hεnat h

  have hC : ∀ (W : Scheme.{u}) (hℓW : IsUnit ((ℓ : ℕ) : Γ(W, ⊤))),
      ∃ θ : (yoneda.obj (wcEtTop W) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
          wcLpttEtPre W (wcKtT.{u} (ℓ ^ n) 0),
        wcLpttGen0 W ℓ n hℓW =
          (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map θ ∧
        ∀ (V : (W.Etale)ᵒᵖ) (a : ULift.{u+1} (V.unop ⟶ wcEtTop W)),
          (θ.app V).hom (FreeAbelianGroup.of a) =
            ULift.up (wcLpttE0 (ℓ ^ n) (Scheme.Γ.obj (Opposite.op V.unop.left))) := by
    intro W hℓW
    have hνnat : ∀ ⦃X Z : (W.Etale)ᵒᵖ⦄ (f : X ⟶ Z),
        (wcLpttEtUTPre W ℓ 0).map f ≫ (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun x =>
          (ULift.up (TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ 0).obj (Scheme.Γ.obj (Opposite.op (Z.unop.left))))
            (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op (Z.unop.left))))
            (FreeAbelianGroup.of x.down)
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
            ULift.{u+1} _)))) =
        (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun x =>
          (ULift.up (TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ 0).obj (Scheme.Γ.obj (Opposite.op (X.unop.left))))
            (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op (X.unop.left))))
            (FreeAbelianGroup.of x.down)
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) :
            ULift.{u+1} _)))) ≫
          (wcLpttEtPre W (wcTensFun (wcKtZUT.{u} ℓ 0) (wcKtT.{u} (ℓ ^ n) 0))).map f := by
      intro X Z f
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro x
      erw [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_comp]
      erw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply]
      erw [FreeAbelianGroup.lift_apply_of]
      erw [FreeAbelianGroup.lift_apply_of]
      apply ULift.ext
      refine Eq.trans ?_ (TensorProduct.map_tmul _ _ _ _).symm
      refine congrArg₂ (TensorProduct.tmul ℤ) ?_ ?_
      · exact (FreeAbelianGroup.map_of_apply _).symm
      · exact (heT' _ _ (Scheme.Γ.map ((Scheme.Etale.forget W ⋙ Over.forget W).map f.unop).op)
          _ rfl).symm
    have hνapp : ∀ (V : (W.Etale)ᵒᵖ) (a : ULift.{u+1} ((wcUnitTupleFun.{u} ℓ 0).obj
        (Scheme.Γ.obj (Opposite.op V.unop.left)))),
        ((wcLpttEtNu W ℓ n 0).app V).hom (FreeAbelianGroup.of a) =
          ULift.up (TensorProduct.tmul ℤ
            (M := (wcKtZUT.{u} ℓ 0).obj (Scheme.Γ.obj (Opposite.op (V.unop.left))))
            (N := (wcKtT.{u} (ℓ ^ n) 0).obj (Scheme.Γ.obj (Opposite.op (V.unop.left))))
            (FreeAbelianGroup.of a.down)
            ((1 : ZMod (ℓ ^ n)) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun i : Fin 0 => i.elim0))) := by
      intro V a
      unfold wcLpttEtNu wcNatOf
      split_ifs with h
      · exact FreeAbelianGroup.lift_apply_of _ _
      · exact absurd hνnat h
    let U := Functor.whiskerRight
        ((yonedaEquiv (X := wcEtTop W)
          (F := (Scheme.Etale.forget W ⋙ Over.forget W).op ⋙ Scheme.Γ ⋙ wcUnitTupleFun.{u} ℓ 0)).symm
          (Subtype.mk Fin.elim0 hℓW : {t : Fin 0 → (Γ(W, ⊤))ˣ // IsUnit ((ℓ : ℕ) : Γ(W, ⊤))}))
        (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let ε' := Functor.whiskerLeft ((Scheme.Etale.forget W ⋙ Over.forget W).op ⋙ Scheme.Γ)
        (Functor.whiskerRight (wcKtEps.{u} ℓ n 0) AddCommGrpCat.uliftFunctor.{u+1, u})
    let θ := U ≫ wcLpttEtNu W ℓ n 0 ≫ ε'
    have hgen : wcLpttGen0 W ℓ n hℓW =
        (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map θ := by
      have e1 : (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map θ =
          (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map U ≫
          (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map
            (wcLpttEtNu W ℓ n 0) ≫
          (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map ε' := by
        exact ((presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map_comp U
          (wcLpttEtNu W ℓ n 0 ≫ ε')).trans
          (congrArg ((presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map U ≫ ·)
            ((presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map_comp
              (wcLpttEtNu W ℓ n 0) ε'))
      rw [e1]
      rfl
    refine ⟨θ, hgen, ?_⟩
    intro V a
    have hU : ∃ b, (U.app V).hom (FreeAbelianGroup.of a) = FreeAbelianGroup.of b :=
      ⟨_, FreeAbelianGroup.map_of_apply _⟩
    obtain ⟨b, hb⟩ := hU
    change (ε'.app V).hom (((wcLpttEtNu W ℓ n 0).app V).hom ((U.app V).hom
      (FreeAbelianGroup.of a))) = _
    rw [hb]
    refine (congrArg (ε'.app V).hom (hνapp V b)).trans ?_
    apply ULift.ext
    exact (hεapp _ _ _).trans (he _).symm
  obtain ⟨θY, hgY, hθY⟩ := hC Y hℓY
  obtain ⟨θZ, hgZ, hθZ⟩ := hC Z hℓZ

  have hG : ∀ {P P' : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} {Q Q' : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
      (a : P ⟶ P') (b : Q ⟶ Q') (θ : P ⟶ (wcEtBaseChange g).op ⋙ Q)
      (θ' : P' ⟶ (wcEtBaseChange g).op ⋙ Q'),
      a ≫ θ' = θ ≫ Functor.whiskerLeft (wcEtBaseChange g).op b →
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map a ≫
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (θ' ≫ Functor.whiskerLeft (wcEtBaseChange g).op
            (toSheafify (Scheme.smallEtaleTopology Z) Q')) =
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (θ ≫ Functor.whiskerLeft (wcEtBaseChange g).op
            (toSheafify (Scheme.smallEtaleTopology Z) Q)) ≫
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcEtBaseChange g).op
            (sheafifyMap (Scheme.smallEtaleTopology Z) b)) := by
    intro P P' Q Q' a b θ θ' h
    rw [← Functor.map_comp, ← Functor.map_comp]
    congr 1
    rw [← Category.assoc, h, Category.assoc, Category.assoc, ← Functor.whiskerLeft_comp,
      ← Functor.whiskerLeft_comp, toSheafify_naturality]
  let Φ : yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶
      (wcEtBaseChange g).op ⋙
        (yoneda.obj (wcEtTop Z) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) :=
    Functor.whiskerRight (yonedaMap (wcEtBaseChange g) (wcEtTop Y) ≫
        Functor.whiskerLeft (wcEtBaseChange g).op (yoneda.map (wcLpttTopMap g)))
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)

  have hstar : θY ≫ wcLpttCanPre g (wcKtT.{u} (ℓ ^ n) 0) =
      Φ ≫ Functor.whiskerLeft (wcEtBaseChange g).op θZ := by
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro x
    change ((wcLpttCanPre g (wcKtT.{u} (ℓ ^ n) 0)).app V).hom ((θY.app V).hom
        (FreeAbelianGroup.of x)) =
      (θZ.app (Opposite.op ((wcEtBaseChange g).obj V.unop))).hom ((Φ.app V).hom
        (FreeAbelianGroup.of x))
    obtain ⟨b, hb⟩ : ∃ b, (Φ.app V).hom (FreeAbelianGroup.of x) = FreeAbelianGroup.of b :=
      ⟨_, FreeAbelianGroup.map_of_apply _⟩
    refine (congrArg ((wcLpttCanPre g (wcKtT.{u} (ℓ ^ n) 0)).app V).hom (hθY V x)).trans ?_
    refine Eq.trans ?_ ((congrArg (θZ.app (Opposite.op ((wcEtBaseChange g).obj V.unop))).hom
      hb).trans (hθZ _ b)).symm
    apply ULift.ext
    change ((wcKtT.{u} (ℓ ^ n) 0).map (Scheme.Γ.map ((wcEtBaseChangeFst g).app V.unop).op)).hom
      (wcLpttE0 (ℓ ^ n) (Scheme.Γ.obj (Opposite.op V.unop.left))) = _
    exact heT' _ _ _ _ rfl

  rw [hgY, hgZ]
  exact hG θY θZ Φ (wcLpttCanPre g (wcKtT.{u} (ℓ ^ n) 0)) hstar

theorem wc_lptt_sym_adj_transport : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y) (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush g) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] (ℓ n k : ℕ) (s : Fin k → (Γ(Y, ⊤))ˣ) (hℓY : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) (hℓZ : IsUnit ((ℓ : ℕ) : Γ(Z, ⊤))), letI := HasExt.standard (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}); letI := HasExt.standard (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}); (Abelian.Ext.mapExactFunctor L (wcLpttSym Y ℓ n k s hℓY)).comp (Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcLpttGam g (wcKtT.{u} (ℓ ^ n) k)))) (add_zero k) = (Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcLpttGamF g))).comp (wcLpttSym Z ℓ n k (fun i => Units.map g.appTop.hom.toMonoidHom (s i)) hℓZ) (zero_add k) :=
by
  intro Z Y g L adj _ _ _ ℓ n k s hℓY hℓZ
  letI iY : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI iZ : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _

  have hG : ∀ {P P' : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} {Q Q' : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
      (a : P ⟶ P') (b : Q ⟶ Q') (θ : P ⟶ (wcEtBaseChange g).op ⋙ Q)
      (θ' : P' ⟶ (wcEtBaseChange g).op ⋙ Q'),
      a ≫ θ' = θ ≫ Functor.whiskerLeft (wcEtBaseChange g).op b →
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map a ≫
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (θ' ≫ Functor.whiskerLeft (wcEtBaseChange g).op
            (toSheafify (Scheme.smallEtaleTopology Z) Q')) =
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (θ ≫ Functor.whiskerLeft (wcEtBaseChange g).op
            (toSheafify (Scheme.smallEtaleTopology Z) Q)) ≫
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcEtBaseChange g).op
            (sheafifyMap (Scheme.smallEtaleTopology Z) b)) := by
    intro P P' Q Q' a b θ θ' h
    rw [← Functor.map_comp, ← Functor.map_comp]
    congr 1
    rw [← Category.assoc, h, Category.assoc, Category.assoc, ← Functor.whiskerLeft_comp,
      ← Functor.whiskerLeft_comp, toSheafify_naturality]

  have hB : ∀ {G G' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : G ⟶ G'),
      L.map (wcLpttEtShMap Y α) ≫ (adj.homEquiv _ _).symm (wcLpttGam g G') =
        (adj.homEquiv _ _).symm (wcLpttGam g G) ≫ wcLpttEtShMap Z α := by
    intro G G' α
    have hsq : wcLpttEtShMap Y α ≫ wcLpttGam g G' =
        wcLpttGam g G ≫ (wcEtPush g).map (wcLpttEtShMap Z α) :=
      hG (wcLpttPreMap Y α) (wcLpttPreMap Z α) (wcLpttCanPre g G) (wcLpttCanPre g G')
        ((wc_lptt_canpre_squares g).1 α)
    rw [← Adjunction.homEquiv_naturality_left_symm, hsq,
      Adjunction.homEquiv_naturality_right_symm]
  have hUg : ∀ (D j : ℕ) (t : Fin D → (Γ(Y, ⊤))ˣ),
      L.map (wcLpttUSec Y ℓ n D j t hℓY) ≫
          (adj.homEquiv _ _).symm (wcLpttGam g (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) j))) =
        (adj.homEquiv _ _).symm (wcLpttGam g (wcKtT.{u} (ℓ ^ n) j)) ≫
          wcLpttUSec Z ℓ n D j (fun i => Units.map g.appTop.hom.toMonoidHom (t i)) hℓZ := by
    intro D j t
    have hsq : wcLpttUSec Y ℓ n D j t hℓY ≫
          wcLpttGam g (wcTensFun (wcKtZUT.{u} ℓ D) (wcKtT.{u} (ℓ ^ n) j)) =
        wcLpttGam g (wcKtT.{u} (ℓ ^ n) j) ≫ (wcEtPush g).map
          (wcLpttUSec Z ℓ n D j (fun i => Units.map g.appTop.hom.toMonoidHom (t i)) hℓZ) :=
      hG (wcLpttUSecPre Y ℓ n D j t hℓY)
        (wcLpttUSecPre Z ℓ n D j (fun i => Units.map g.appTop.hom.toMonoidHom (t i)) hℓZ)
        (wcLpttCanPre g _) (wcLpttCanPre g _) ((wc_lptt_canpre_squares g).2 ℓ n D j t hℓY hℓZ)
    rw [← Adjunction.homEquiv_naturality_left_symm, hsq,
      Adjunction.homEquiv_naturality_right_symm]
  have hbase : L.map (wcLpttGen0 Y ℓ n hℓY) ≫
        (adj.homEquiv _ _).symm (wcLpttGam g (wcKtT.{u} (ℓ ^ n) 0)) =
      (adj.homEquiv _ _).symm (wcLpttGamF g) ≫ wcLpttGen0 Z ℓ n hℓZ := by
    rw [← Adjunction.homEquiv_naturality_left_symm, wc_lptt_gen0_gam g ℓ n hℓY hℓZ,
      Adjunction.homEquiv_naturality_right_symm]

  have hgen : ∀ (B : ∀ G : CommRingCat.{u} ⥤ AddCommGrpCat.{u}, L.obj (wcLpttEtSh Y G) ⟶ wcLpttEtSh Z G)
      (j : ℕ) (a : (Γ(Y, ⊤))ˣ) (b : (Γ(Z, ⊤))ˣ),
      (∀ {G G' : CommRingCat.{u} ⥤ AddCommGrpCat.{u}} (α : G ⟶ G'),
        L.map (wcLpttEtShMap Y α) ≫ B G' = B G ≫ wcLpttEtShMap Z α) →
      L.map (wcLpttUSec Y ℓ n (j + 1) j (fun i : Fin (j + 1) => if (i : ℕ) = j then a else 1) hℓY) ≫
          B (wcTensFun (wcKtZUT.{u} ℓ (j + 1)) (wcKtT.{u} (ℓ ^ n) j)) =
        B (wcKtT.{u} (ℓ ^ n) j) ≫ wcLpttUSec Z ℓ n (j + 1) j
          (fun i : Fin (j + 1) => if (i : ℕ) = j then b else 1) hℓZ →
      (Abelian.Ext.mapExactFunctor L (wcLpttKt Y ℓ n j a hℓY)).comp
          (Abelian.Ext.mk₀ (B (wcKtT.{u} (ℓ ^ n) (j + 1)))) (add_zero 1) =
        (Abelian.Ext.mk₀ (B (wcKtT.{u} (ℓ ^ n) j))).comp (wcLpttKt Z ℓ n j b hℓZ) (zero_add 1) := by
    classical
    intro B j a b hB' hU
    obtain ⟨wY, hY⟩ := wc_lptt_et_step_ses Y ℓ n (j + 1) j
    obtain ⟨wZ, hZ⟩ := wc_lptt_et_step_ses Z ℓ n (j + 1) j
    have hKY : wcLpttKt Y ℓ n j a hℓY =
        (Abelian.Ext.mk₀ (wcLpttUSec Y ℓ n (j + 1) j
            (fun i : Fin (j + 1) => if (i : ℕ) = j then a else 1) hℓY)).comp
          ((hY.extClass.comp (Abelian.Ext.mk₀ (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (j + 1) j)))
              (add_zero 1)).comp
            (Abelian.Ext.mk₀ (wcLpttEtShMap Y (wcKtEps.{u} ℓ n (j + 1)))) (add_zero 1))
          (zero_add 1) := by
      unfold wcLpttKt wcLpttEtStep wcExtOfMaps
      simp only [dif_pos wY, dif_pos hY]
    have hKZ : wcLpttKt Z ℓ n j b hℓZ =
        (Abelian.Ext.mk₀ (wcLpttUSec Z ℓ n (j + 1) j
            (fun i : Fin (j + 1) => if (i : ℕ) = j then b else 1) hℓZ)).comp
          ((hZ.extClass.comp (Abelian.Ext.mk₀ (wcLpttEtShMap Z (wcKtRho.{u} ℓ n (j + 1) j)))
              (add_zero 1)).comp
            (Abelian.Ext.mk₀ (wcLpttEtShMap Z (wcKtEps.{u} ℓ n (j + 1)))) (add_zero 1))
          (zero_add 1) := by
      unfold wcLpttKt wcLpttEtStep wcExtOfMaps
      simp only [dif_pos wZ, dif_pos hZ]
    have NAT : (hY.map_of_exact L).extClass.comp
        (Abelian.Ext.mk₀ (B (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ (j + 1))
          (wcRootsFun.{u} (ℓ ^ n))) (wcKtT.{u} (ℓ ^ n) j)))) (add_zero 1) =
        (Abelian.Ext.mk₀ (B (wcTensFun (wcKtZUT.{u} ℓ (j + 1))
          (wcKtT.{u} (ℓ ^ n) j)))).comp hZ.extClass (zero_add 1) :=
      (hY.map_of_exact L).extClass_naturality hZ
        (ShortComplex.homMk _ _ _
          (hB' (wcTensNat (wcKtIotaE.{u} ℓ n (j + 1) j) (𝟙 (wcKtT.{u} (ℓ ^ n) j)))).symm
          (hB' (wcTensNat
            (Limits.pullback.fst _ _ : wcKtE.{u} ℓ n (j + 1) j ⟶ wcKtZUT.{u} ℓ (j + 1))
            (𝟙 (wcKtT.{u} (ℓ ^ n) j)))).symm)
    have hM : L.map (wcLpttEtShMap Y (wcKtRho.{u} ℓ n (j + 1) j)) ≫
        L.map (wcLpttEtShMap Y (wcKtEps.{u} ℓ n (j + 1))) ≫
          B (wcKtT.{u} (ℓ ^ n) (j + 1)) =
        B (wcTensFun (wcTensFun (wcKtZUT.{u} ℓ (j + 1))
          (wcRootsFun.{u} (ℓ ^ n))) (wcKtT.{u} (ℓ ^ n) j)) ≫
          wcLpttEtShMap Z (wcKtRho.{u} ℓ n (j + 1) j) ≫
            wcLpttEtShMap Z (wcKtEps.{u} ℓ n (j + 1)) := by
      rw [hB' (wcKtEps.{u} ℓ n (j + 1)), ← Category.assoc, hB' (wcKtRho.{u} ℓ n (j + 1) j),
        Category.assoc]
    rw [hKY, hKZ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mapExactFunctor_extClass]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc]
    rw [hM, ← hU, ← Abelian.Ext.mk₀_comp_mk₀ (B (wcTensFun (wcTensFun
        (wcKtZUT.{u} ℓ (j + 1)) (wcRootsFun.{u} (ℓ ^ n))) (wcKtT.{u} (ℓ ^ n) j)))
        (wcLpttEtShMap Z (wcKtRho.{u} ℓ n (j + 1) j) ≫ wcLpttEtShMap Z (wcKtEps.{u} ℓ n (j + 1))),
      ← Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (add_zero 1), NAT]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc]
  have hstep : ∀ (j : ℕ) (a : (Γ(Y, ⊤))ˣ),
      (Abelian.Ext.mapExactFunctor L (wcLpttKt Y ℓ n j a hℓY)).comp
          (Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcLpttGam g (wcKtT.{u} (ℓ ^ n) (j + 1)))))
          (add_zero 1) =
        (Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcLpttGam g (wcKtT.{u} (ℓ ^ n) j)))).comp
          (wcLpttKt Z ℓ n j (Units.map g.appTop.hom.toMonoidHom a) hℓZ) (zero_add 1) := by
    intro j a
    have htup : (fun i : Fin (j + 1) =>
          Units.map g.appTop.hom.toMonoidHom (if (i : ℕ) = j then a else 1)) =
        (fun i : Fin (j + 1) =>
          if (i : ℕ) = j then Units.map g.appTop.hom.toMonoidHom a else 1) := by
      funext i
      split_ifs
      · rfl
      · exact map_one _
    have hU := hUg (j + 1) j (fun i : Fin (j + 1) => if (i : ℕ) = j then a else 1)
    rw [htup] at hU
    exact hgen (fun G => (adj.homEquiv _ _).symm (wcLpttGam g G)) j a
      (Units.map g.appTop.hom.toMonoidHom a) hB hU

  induction k with
  | zero =>
    show (Abelian.Ext.mapExactFunctor L (Abelian.Ext.mk₀ (wcLpttGen0 Y ℓ n hℓY))).comp
        (Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcLpttGam g (wcKtT.{u} (ℓ ^ n) 0)))) (add_zero 0) =
      (Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcLpttGamF g))).comp
        (Abelian.Ext.mk₀ (wcLpttGen0 Z ℓ n hℓZ)) (zero_add 0)
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hbase]
  | succ k ih =>
    show (Abelian.Ext.mapExactFunctor L ((wcLpttSym Y ℓ n k (fun i => s i.castSucc) hℓY).comp
          (wcLpttKt Y ℓ n k (s (Fin.last k)) hℓY) rfl)).comp
        (Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcLpttGam g (wcKtT.{u} (ℓ ^ n) (k + 1)))))
        (add_zero (k + 1)) =
      (Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcLpttGamF g))).comp
        ((wcLpttSym Z ℓ n k (fun i => Units.map g.appTop.hom.toMonoidHom (s i.castSucc)) hℓZ).comp
          (wcLpttKt Z ℓ n k (Units.map g.appTop.hom.toMonoidHom (s (Fin.last k))) hℓZ) rfl)
        (zero_add (k + 1))
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.comp_assoc_of_third_deg_zero, hstep,
      ← Abelian.Ext.comp_assoc_of_second_deg_zero, ih]
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add k) rfl (by omega)

theorem wc_lptt_et_twist_const_iso : ∀ (K : Type u) [Field K] [IsAlgClosed K] (m : ℕ), IsUnit ((m : ℕ) : K) → ∀ (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)) (j : ℕ), Nonempty (wcLpttEtSh Y (wcKtT.{u} m j) ≅ (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
by
  classical
  intro K _ _ m hm Y fY j
  have hm0 : m ≠ 0 := by
    rintro rfl
    rw [Nat.cast_zero] at hm
    exact not_isUnit_zero hm
  haveI : NeZero m := ⟨hm0⟩
  haveI : NeZero ((m : ℕ) : K) := ⟨hm.ne_zero⟩
  haveI := IsSepClosed.hasEnoughRootsOfUnity K m
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K m

  let φ : ∀ V : Y.Etale, K →+* Γ(V.left, ⊤) := fun V =>
    (V.hom ≫ fY).appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
  have hpow : ∀ V : Y.Etale, (φ V ζ) ^ m = 1 := by
    intro V
    rw [← map_pow, hζ.pow_eq_one, map_one]
  have hprim : ∀ (V : Y.Etale) (z : V.left),
      IsPrimitiveRoot ((V.left.evaluation ⊤ z trivial).hom (φ V ζ)) m := by
    intro V z
    let χ : K →+* V.left.residueField z := (V.left.evaluation ⊤ z trivial).hom.comp (φ V)
    exact hζ.map_of_injective (f := χ) χ.injective
  have hunit : ∀ V : Y.Etale, IsUnit ((m : ℕ) : Γ(V.left, ⊤)) := by
    intro V
    have := hm.map (φ V)
    rwa [map_natCast] at this
  have hnat : ∀ (V V' : Y.Etale) (c : V' ⟶ V), φ V' ζ = c.left.appTop.hom (φ V ζ) := by
    intro V V' c
    have hw : c.left ≫ V.hom = V'.hom := MorphismProperty.Over.w c
    have key : V'.hom ≫ fY = c.left ≫ (V.hom ≫ fY) := by
      rw [← Category.assoc, hw]
    show (V'.hom ≫ fY).appTop.hom _ = _
    rw [key, Scheme.Hom.comp_appTop]
    rfl
  let ωr : ∀ V : Y.Etale, rootsOfUnity m Γ(V.left, ⊤) := fun V =>
    rootsOfUnity.mkOfPowEq (φ V ζ) (hpow V)
  have hωr : ∀ V : Y.Etale, ((ωr V : Γ(V.left, ⊤)ˣ) : Γ(V.left, ⊤)) = φ V ζ :=
    fun V => rootsOfUnity.val_mkOfPowEq_coe _ _
  have hnatr : ∀ (V V' : Y.Etale) (c : V' ⟶ V),
      restrictRootsOfUnity c.left.appTop.hom m (ωr V) = ωr V' := by
    intro V V' c
    apply Subtype.ext
    apply Units.ext
    rw [restrictRootsOfUnity_coe_apply, hωr, hωr, hnat V V' c]

  choose L hL using fun V : Y.Etale => wc_rtsp_dlog_exists V.left m (φ V ζ) (hprim V)
  choose D hD using fun V : Y.Etale =>
    (wc_rtsp_tensor_lift m j (Additive (rootsOfUnity m Γ(V.left, ⊤)))).2 C(V.left, ZMod m) (L V)
  have hL1 : ∀ V : Y.Etale, L V (Additive.ofMul (ωr V)) = 1 := by
    intro V
    ext z
    have h3 := (hL V (Additive.ofMul (ωr V)) z 1).2 (by rw [pow_one]; exact congrArg _ (hωr V))
    rw [h3]
    simp
  have hDc : ∀ (V : Y.Etale) (a : ZMod m),
      D V (a ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin j => Additive.ofMul (ωr V))) =
        ContinuousMap.const V.left a := by
    intro V a
    rw [hD V a _]
    simp only [hL1, Finset.prod_const_one]
    ext z
    simp

  let ρ : (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶
      wcLpttEtPre Y (wcKtT.{u} m j) :=
    { app := fun V => AddCommGrpCat.ofHom (AddMonoidHom.mk'
          (fun x : ULift.{u+1} (ZMod m) =>
            (ULift.up (x.down ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
                (fun _ : Fin j => Additive.ofMul (ωr V.unop))) :
              ULift.{u+1} (TensorProduct ℤ (ZMod m) (PiTensorProduct ℤ
                (fun _ : Fin j => Additive (rootsOfUnity m Γ(V.unop.left, ⊤)))))))
          (fun x y => by
            rw [show (x + y).down = x.down + y.down from rfl, TensorProduct.add_tmul]
            rfl))
      naturality := fun V W f => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply ULift.ext
        change x.down ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin j => Additive.ofMul (ωr W.unop)) =
          LinearMap.lTensor (ZMod m) (PiTensorProduct.map (fun _ : Fin j =>
            (MonoidHom.toAdditive (restrictRootsOfUnity f.unop.left.appTop.hom m)).toIntLinearMap))
            (x.down ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ (fun _ : Fin j => Additive.ofMul (ωr V.unop)))
        rw [LinearMap.lTensor_tmul, PiTensorProduct.map_tprod]
        have e : (fun _ : Fin j => Additive.ofMul (ωr W.unop)) = (fun _ : Fin j =>
            (MonoidHom.toAdditive (restrictRootsOfUnity f.unop.left.appTop.hom m)).toIntLinearMap
              (Additive.ofMul (ωr V.unop))) :=
          funext fun _ => congrArg Additive.ofMul (hnatr V.unop W.unop f.unop).symm
        rw [e] }

  have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) ρ := by
    refine ⟨fun {V} x y hxy => ?_⟩
    apply wc_etale_jointly_surjective_covers Y V.unop
    intro v
    refine ⟨V.unop, 𝟙 V.unop, ?_, ⟨v, by first | rfl | simp⟩⟩
    rw [Presheaf.equalizerSieve_apply]
    have h1 : D V.unop (ULift.down (ρ.app V x)) = D V.unop (ULift.down (ρ.app V y)) := by
      rw [hxy]
    have h2 : ContinuousMap.const V.unop.left (ULift.down x) =
        ContinuousMap.const V.unop.left (ULift.down y) :=
      (hDc V.unop _).symm.trans (h1.trans (hDc V.unop _))
    have h3 : ULift.down x = ULift.down y := by
      have := DFunLike.congr_fun h2 v
      simpa using this
    exact congrArg _ (ULift.ext _ _ h3)

  have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) ρ := by
    refine ⟨fun {V} s => ?_⟩
    apply wc_etale_jointly_surjective_covers Y V
    intro v
    have H5 : ∀ (Z' : Scheme.{u}) (f : Z' ⟶ V.left) (w : Additive (rootsOfUnity m Γ(V.left, ⊤)))
        (k : ℕ), (∀ z' : Z', L V w (f z') = (k : ZMod m)) →
        MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) w =
          k • MonoidHom.toAdditive (restrictRootsOfUnity f.appTop.hom m) (Additive.ofMul (ωr V)) :=
      fun Z' f w k hk => wc_rtsp_root_eq_of_dlog_const V.left m (φ V ζ) (L V) (hunit V) (hL V)
        Z' f w (Additive.ofMul (ωr V)) k (hωr V) hk
    obtain ⟨O, hvO, hO⟩ := wc_rtsp_tensor_locally_pure V.left m j (Additive.ofMul (ωr V)) (L V)
      (D V) H5 (hD V) (ULift.down s) v
    haveI : Etale V.hom := V.prop
    let V₁ : Y.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom) inferInstance
    let c : V₁ ⟶ V := MorphismProperty.Over.homMk (A := V₁) (B := V) O.ι rfl trivial
    refine ⟨V₁, c, ?_, ?_⟩
    · rw [Presheaf.imageSieve_apply]
      refine ⟨ULift.up (D V (ULift.down s) v), ?_⟩
      apply ULift.ext
      have h2 := hO (O : Scheme.{u}) O.ι (by rw [Scheme.Opens.range_ι])
      refine Eq.trans ?_ h2.symm
      have e : (fun _ : Fin j => Additive.ofMul (ωr V₁)) = (fun _ : Fin j =>
          MonoidHom.toAdditive (restrictRootsOfUnity O.ι.appTop.hom m) (Additive.ofMul (ωr V))) :=
        funext fun _ => congrArg Additive.ofMul (hnatr V V₁ c).symm
      show (D V (ULift.down s) v) ⊗ₜ[ℤ] PiTensorProduct.tprod ℤ
        (fun _ : Fin j => Additive.ofMul (ωr V₁)) = _
      rw [e]
      first
        | exact rfl
        | (congr 1)
        | simp
    · show v ∈ Set.range O.ι
      rw [Scheme.Opens.range_ι]
      exact hvO

  have hW : (Scheme.smallEtaleTopology Y).W ρ :=
    (GrothendieckTopology.W_iff_isLocallyBijective (Scheme.smallEtaleTopology Y) ρ).mpr
      ⟨hinj, hsurj⟩
  haveI : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map ρ) :=
    (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology Y) ρ).mp hW
  exact ⟨(asIso ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map ρ)).symm⟩

theorem wc_lptt_twist_const_iso : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : IsUnit ((ℓ : ℕ) : K)) (n j : ℕ) (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of K)), Nonempty (wcLpttEtSh Y (wcKtT.{u} (ℓ ^ n) j) ≅ (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ n))))) :=
by
  intro K _ _ ℓ _ hℓK n j Y fY
  have hm : IsUnit (((ℓ ^ n : ℕ) : ℕ) : K) := by
    rw [Nat.cast_pow]
    exact hℓK.pow n
  exact wc_lptt_et_twist_const_iso K (ℓ ^ n) hm Y fY j

theorem wc_et_const_zmod_stalk_cyclic : ∀ (Y : Scheme.{u}) (M : ℕ), 0 < M → ∀ (y : Y), Finite ((wcEtStalk Y y).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))) ∧ Nat.card ((wcEtStalk Y y).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))) = M ∧ ∃ x : (wcEtStalk Y y).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))), ∀ z, ∃ c : ℤ, z = c • x :=
by
  classical
  intro Y M hM y
  haveI : NeZero M := ⟨by omega⟩
  have hcof : IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) :=
    wc_et_geomstalk_cofiltered Y y (@fun P E S e _ a b h Ω _ π hπ =>
      @wc_etale_maps_agree_near_geom_point P E S e _ a b h Ω _ π hπ)
  obtain ⟨gsurj, gext, -⟩ := wc_et_stalk_germ_facts Y y hcof
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))
  obtain ⟨lf1, lf2⟩ := wc_et_const_sheaf_local_form Y M
  have hdec : ∀ a : ULift.{u+1} (ZMod M), a = a.down.val • (1 : ULift.{u+1} (ZMod M)) := by
    intro a
    apply ULift.ext
    show a.down = a.down.val • (1 : ZMod M)
    rw [nsmul_one, ZMod.natCast_zmod_val]
  have hC1 : ∀ {V V' : Y.Etale} (g : V' ⟶ V) (a : ULift.{u+1} (ZMod M)),
      ((((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj.map g.op).hom
          (wcConstSec Y (ULift.{u+1} (ZMod M)) V a)) = wcConstSec Y (ULift.{u+1} (ZMod M)) V' a := by
    intro V V' g a
    have e := congrArg (fun f => f.hom a) ((toSheafify (Scheme.smallEtaleTopology Y)
      ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))).naturality g.op)
    exact e.symm
  have hwD : ∀ {A A' : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)} (h : A' ⟶ A)
      (s : ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj.obj (Opposite.op A.right)),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj) (Opposite.op A')).hom
        ((((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
          ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj).map h.op).hom s) =
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj) (Opposite.op A)).hom s := by
    intro A A' h s
    have e := congrArg (fun g : (((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj).obj (Opposite.op A) ⟶
        Limits.colimit ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj)) => AddCommGrpCat.Hom.hom g s)
      (Limits.colimit.w ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj) h.op)
    exact e
  obtain ⟨A₀, hA₀⟩ : ∃ A₀ : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y),
      ∀ A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y), Nonempty (A ⟶ A₀) :=
    ⟨StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 Y)) (Over.homMk (wcEtGeomPt Y y) (Category.comp_id _)),
      fun A => ⟨StructuredArrow.homMk
        (MorphismProperty.Over.homMk A.right.hom (Category.comp_id _) trivial)
        (Over.OverMorphism.ext (Over.w A.hom))⟩⟩
  have hgermA0 : ∀ (A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y))
      (a : ULift.{u+1} (ZMod M)),
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj) (Opposite.op A₀)).hom
          (wcConstSec Y (ULift.{u+1} (ZMod M)) A₀.right a) =
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj) (Opposite.op A)).hom
          (wcConstSec Y (ULift.{u+1} (ZMod M)) A.right a) := by
    intro A a
    obtain ⟨h⟩ := hA₀ A
    have e := hwD h (wcConstSec Y (ULift.{u+1} (ZMod M)) A₀.right a)
    have e2 : ((((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj).map h.op).hom
            (wcConstSec Y (ULift.{u+1} (ZMod M)) A₀.right a)) =
        wcConstSec Y (ULift.{u+1} (ZMod M)) A.right a := hC1 h.right a
    rw [← e, e2]

  let e : ULift.{u+1} (ZMod M) →+ ↑(Limits.colimit ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj)) :=
    (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj) (Opposite.op A₀)).hom.comp
      ((toSheafify (Scheme.smallEtaleTopology Y)
        ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))).app
          (Opposite.op A₀.right)).hom
  have he : ∀ a, e a = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
      (Scheme.Etale.forget Y)).op ⋙ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj) (Opposite.op A₀)).hom
          (wcConstSec Y (ULift.{u+1} (ZMod M)) A₀.right a) := fun a => rfl
  have hinj : Function.Injective e := by
    rw [injective_iff_map_eq_zero]
    intro a h0
    rw [he] at h0
    have h0' : (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj) (Opposite.op A₀)).hom
        (wcConstSec Y (ULift.{u+1} (ZMod M)) A₀.right a) =
      (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj) (Opposite.op A₀)).hom
        (0 : ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj.obj (Opposite.op A₀.right)) := by
      rw [h0, map_zero]
    obtain ⟨A'', f, f', hff⟩ := gext A₀ A₀ _ _ h0'
    rw [hC1, map_zero] at hff
    rcases lf1 A''.right a hff with h1 | h1
    · exact h1
    · exact (h1.false (A''.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))).elim
  have hsurj : Function.Surjective e := by
    intro x
    obtain ⟨A, s, hs⟩ := gsurj x
    obtain ⟨O, a, hO, hpO, hloc⟩ := lf2 A.right s
      (A.hom.left (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))))
    obtain ⟨O', rfl⟩ : ∃ O' : A.right.left.Opens, (O' : Set A.right.left) = O := ⟨⟨O, hO⟩, rfl⟩
    have hrange : Set.range (wcEtOpenι Y A.right O').left ⊆ (O' : Set A.right.left) := by
      show Set.range O'.ι ⊆ _
      exact (Scheme.Opens.range_ι O').subset
    have hsV := hloc (wcEtOpen Y A.right O') (wcEtOpenι Y A.right O') hrange
    have hsub : Set.range A.hom.left ⊆ Set.range O'.ι := by
      rintro _ ⟨w, rfl⟩
      have hw : w = IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)) :=
        Subsingleton.elim (α := ↥(Spec (CommRingCat.of (AlgebraicClosure (Y.residueField y))))) w _
      subst hw
      exact ((Set.ext_iff.mp (Scheme.Opens.range_ι O')) _).mpr hpO
    have liftH : ∀ {X Z : Scheme.{u}} (U : X.Opens) (g : Z ⟶ X), Set.range g ⊆ Set.range U.ι →
        ∃ t : Z ⟶ U.toScheme, t ≫ U.ι = g :=
      fun U g h => ⟨IsOpenImmersion.lift U.ι g h, IsOpenImmersion.lift_fac _ _ _⟩
    obtain ⟨t', ht'⟩ : ∃ t' : (Over.mk (wcEtGeomPt Y y)).left ⟶ (wcEtOpen Y A.right O').left,
        t' ≫ O'.ι = A.hom.left := liftH O' A.hom.left hsub
    have hw' : t' ≫ ((Scheme.Etale.forget Y).obj (wcEtOpen Y A.right O')).hom =
        (Over.mk (wcEtGeomPt Y y)).hom :=
      (Category.assoc _ _ _).symm.trans ((congrArg (fun q => q ≫ A.right.hom) ht').trans
        (Over.w A.hom))
    let A' : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
      StructuredArrow.mk (Y := wcEtOpen Y A.right O') (Over.homMk t' hw')
    let hf : A' ⟶ A := StructuredArrow.homMk (wcEtOpenι Y A.right O')
      (Over.OverMorphism.ext ht')
    have e1 := hwD hf s
    have e3 : ((((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙
          ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj).map hf.op).hom s) =
        wcConstSec Y (ULift.{u+1} (ZMod M)) A'.right a := hsV
    refine ⟨a, ?_⟩
    rw [he, ← hs, ← e1, e3, ← hgermA0 A' a]
  have hbij : Function.Bijective e := ⟨hinj, hsurj⟩
  have key : Finite ↑(Limits.colimit ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj)) ∧
      Nat.card ↑(Limits.colimit ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj)) = M ∧
      ∃ x : ↑(Limits.colimit ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
        (Scheme.Etale.forget Y)).op ⋙ ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))).obj)), ∀ z, ∃ c : ℤ, z = c • x := by
    refine ⟨Finite.of_equiv _ (Equiv.ofBijective e hbij), ?_, ⟨e 1, fun z => ?_⟩⟩
    · rw [← Nat.card_eq_of_bijective e hbij, Nat.card_ulift, Nat.card_zmod]
    · obtain ⟨a, rfl⟩ := hsurj z
      refine ⟨((a.down.val : ℕ) : ℤ), ?_⟩
      rw [natCast_zsmul, ← map_nsmul, ← hdec a]
  exact key

theorem wc_gm_local_pullback_connected : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [IsLocalRing A] (s : Spec (.of A) ⟶ Spec (.of K)), ConnectedSpace (Limits.pullback (C := Scheme.{u}) s (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) :=
by
  intro K _ A _ _ s
  classical

  have hcoef : ∀ (e : AddMonoidAlgebra A ℤ), IsIdempotentElem e → ∀ n : ℤ, n ≠ 0 →
      IsNilpotent (e.coeff n) := by
    intro e he n hn
    rw [← mem_nilradical, nilradical_eq_sInf, Ideal.mem_sInf]
    intro p hp
    have : p.IsPrime := hp
    have hpe : IsIdempotentElem (AddMonoidAlgebra.mapRingHom ℤ (Ideal.Quotient.mk p) e) :=
      he.map _
    have hc := AddMonoidAlgebra.coeff_mapRingHom (Ideal.Quotient.mk p) e n
    rw [← Ideal.Quotient.eq_zero_iff_mem, ← hc]
    rcases IsIdempotentElem.iff_eq_zero_or_one.mp hpe with h | h
    · rw [h, AddMonoidAlgebra.coeff_zero]
      rfl
    · rw [h, AddMonoidAlgebra.one_def, AddMonoidAlgebra.coeff_single]
      simp [Ne.symm hn]

  have hnil : ∀ x : AddMonoidAlgebra A ℤ, (∀ n : ℤ, IsNilpotent (x.coeff n)) → IsNilpotent x := by
    intro x hx
    have hx' : x = ∑ n ∈ x.coeff.support, AddMonoidAlgebra.single n (x.coeff n) :=
      (AddMonoidAlgebra.sum_coeff_single x).symm
    rw [hx']
    apply isNilpotent_sum
    intro n _
    obtain ⟨k, hk⟩ := hx n
    exact ⟨k, by rw [AddMonoidAlgebra.single_pow, hk, AddMonoidAlgebra.single_zero]⟩

  have hidem : ∀ e : AddMonoidAlgebra A ℤ, IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro e he
    have hN : IsNilpotent (e - AddMonoidAlgebra.single 0 (e.coeff 0)) := by
      apply hnil
      intro m
      rw [AddMonoidAlgebra.coeff_sub, Finsupp.sub_apply, AddMonoidAlgebra.coeff_single]
      by_cases hm : m = 0
      · subst hm
        simp
      · rw [Finsupp.single_apply, if_neg (Ne.symm hm), sub_zero]
        exact hcoef e he m hm
    have hunitC : ∀ b : A, IsUnit b → IsUnit (AddMonoidAlgebra.single (0 : ℤ) b) := by
      intro b hb
      obtain ⟨c, hc⟩ := hb.exists_right_inv
      refine ⟨⟨AddMonoidAlgebra.single 0 b, AddMonoidAlgebra.single 0 c, ?_, ?_⟩, rfl⟩
      · rw [AddMonoidAlgebra.single_mul_single, add_zero, hc, ← AddMonoidAlgebra.one_def]
      · rw [AddMonoidAlgebra.single_mul_single, add_zero, mul_comm, hc,
          ← AddMonoidAlgebra.one_def]
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (e.coeff 0) with h | h
    · right
      have hu : IsUnit e := by
        have h1 := hN.isUnit_add_left_of_commute (hunitC _ h) (Commute.all _ _)
        have heq : AddMonoidAlgebra.single (0 : ℤ) (e.coeff 0) +
            (e - AddMonoidAlgebra.single 0 (e.coeff 0)) = e := by abel
        rwa [heq] at h1
      exact (IsIdempotentElem.iff_eq_one_of_isUnit hu).mp he
    · left
      have hu : IsUnit (1 - e) := by
        have h1 := hN.neg.isUnit_add_left_of_commute (hunitC _ h) (Commute.all _ _)
        have heq : AddMonoidAlgebra.single (0 : ℤ) (1 - e.coeff 0) +
            -(e - AddMonoidAlgebra.single 0 (e.coeff 0)) = 1 - e := by
          rw [AddMonoidAlgebra.single_sub, ← AddMonoidAlgebra.one_def]
          abel
        rwa [heq] at h1
      have h1 := (IsIdempotentElem.iff_eq_one_of_isUnit hu).mp he.one_sub
      have h2 : e = 1 - (1 - e) := by abel
      rw [h2, h1, sub_self]

  have hconn : ConnectedSpace (PrimeSpectrum (AddMonoidAlgebra A ℤ)) := by
    rw [connectedSpace_iff_clopen]
    refine ⟨PrimeSpectrum.nonempty_iff_nontrivial.mpr inferInstance, ?_⟩
    intro S hS
    obtain ⟨E, hE⟩ : ∃ E, PrimeSpectrum.isIdempotentElemEquivClopens E =
        (⟨S, hS⟩ : TopologicalSpace.Clopens (PrimeSpectrum (AddMonoidAlgebra A ℤ))) :=
      ⟨_, OrderIso.apply_symm_apply _ _⟩
    have hCS : S = ((PrimeSpectrum.isIdempotentElemEquivClopens E :
        TopologicalSpace.Clopens (PrimeSpectrum (AddMonoidAlgebra A ℤ))) : Set _) := by
      rw [hE]
      rfl
    rw [PrimeSpectrum.coe_isIdempotentElemEquivClopens_apply] at hCS
    rcases hidem E.1 E.2 with h | h
    · left
      rw [hCS, h, PrimeSpectrum.basicOpen_zero]
      rfl
    · right
      rw [hCS, h, PrimeSpectrum.basicOpen_one]
      rfl

  let φ : K →+* A := (Spec.preimage s).hom
  let _ : Algebra K A := φ.toAlgebra
  have hs : Spec.map (CommRingCat.ofHom (algebraMap K A)) = s := Spec.map_preimage s
  let e1 := Limits.pullback.congrHom hs.symm
    (rfl : Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) = _)
  let h := (Scheme.homeoOfIso e1).trans ((Scheme.homeoOfIso
    (pullbackSpecIso K A (LaurentPolynomial K))).trans
    (PrimeSpectrum.homeomorphOfRingEquiv (AddMonoidAlgebra.scalarTensorEquiv K (M := ℤ) A).toRingEquiv))
  exact Function.Surjective.connectedSpace h.symm.surjective h.symm.continuous

theorem wc_et_coh_one_card_prime_pow : ∀ (Y : Scheme.{u}) [ConnectedSpace Y] (ℓ : ℕ), ℓ.Prime → Nat.card (wcEtCoh Y ℓ 1) = ℓ → Subsingleton (wcEtCoh Y ℓ 2) → ∀ n : ℕ, 1 ≤ n → Nat.card (wcEtCoh Y (ℓ ^ n) 1) = ℓ ^ n :=
by
  classical
  intro Y _ ℓ hℓ h1 h2 n hn
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  have habs : ∀ (P : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})),
      S.ShortExact →
      Nat.card (Abelian.Ext P S.X₁ 0) ≠ 0 → Nat.card (Abelian.Ext P S.X₃ 0) ≠ 0 →
      Nat.card (Abelian.Ext P S.X₂ 0) =
        Nat.card (Abelian.Ext P S.X₁ 0) * Nat.card (Abelian.Ext P S.X₃ 0) →
      Subsingleton (Abelian.Ext P S.X₁ 2) →
      Nat.card (Abelian.Ext P S.X₂ 1) =
        Nat.card (Abelian.Ext P S.X₁ 1) * Nat.card (Abelian.Ext P S.X₃ 1) := by
    intro P S hS hc1 hc3 hc2 hsub
    have hcard : ∀ {A B D : Type _} [AddCommGroup A] [AddCommGroup B] [AddCommGroup D]
        (α : A →+ B) (β : B →+ D), Function.Injective α → (∀ b, β b = 0 ↔ ∃ a, α a = b) →
        Nat.card B = Nat.card A * Nat.card β.range := by
      intro A B D _ _ _ α β hα hex
      have hker : β.ker = α.range := by
        ext b
        rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
        exact hex b
      have e1 : Nat.card (B ⧸ β.ker) = Nat.card β.range :=
        Nat.card_congr (QuotientAddGroup.quotientKerEquivRange β).toEquiv
      have e2 : Nat.card β.ker = Nat.card A := by
        rw [hker]
        exact (Nat.card_congr (AddMonoidHom.ofInjective hα).toEquiv).symm
      rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup β.ker, e1, e2, mul_comm]
    let α : ∀ i : ℕ, Abelian.Ext P S.X₁ i →+ Abelian.Ext P S.X₂ i :=
      fun i => (Abelian.Ext.mk₀ S.f).postcomp P (add_zero i)
    let β : ∀ i : ℕ, Abelian.Ext P S.X₂ i →+ Abelian.Ext P S.X₃ i :=
      fun i => (Abelian.Ext.mk₀ S.g).postcomp P (add_zero i)
    have hα : ∀ i (x : Abelian.Ext P S.X₁ i),
        α i x = x.comp (Abelian.Ext.mk₀ S.f) (add_zero i) := by
      intro i x
      simp only [α, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
        Abelian.Ext.bilinearComp_apply_apply]
    have hβ : ∀ i (x : Abelian.Ext P S.X₂ i),
        β i x = x.comp (Abelian.Ext.mk₀ S.g) (add_zero i) := by
      intro i x
      simp only [β, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
        Abelian.Ext.bilinearComp_apply_apply]
    have hex : ∀ i, ∀ b, β i b = 0 ↔ ∃ a, α i a = b := by
      intro i b
      rw [hβ]
      constructor
      · intro hb
        obtain ⟨a, ha⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS b hb
        exact ⟨a, by rw [hα]; exact ha⟩
      · rintro ⟨a, rfl⟩
        rw [hα, Abelian.Ext.comp_assoc a (Abelian.Ext.mk₀ S.f) (Abelian.Ext.mk₀ S.g) (add_zero i)
          (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, S.zero, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero]
    have hinj0 : Function.Injective (α 0) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨h, rfl⟩ := (Abelian.Ext.mk₀_bijective P S.X₁).2 x
      rw [hα, Abelian.Ext.mk₀_comp_mk₀] at hx
      have hf : h ≫ S.f = 0 :=
        (Abelian.Ext.mk₀_bijective P S.X₂).1 (by rw [hx, Abelian.Ext.mk₀_zero])
      have := hS.mono_f
      have h0 : h = 0 := by
        rw [← cancel_mono S.f, Limits.zero_comp]
        exact hf
      rw [h0, Abelian.Ext.mk₀_zero]
    have hsurj0 : Function.Surjective (β 0) := by
      have h := hcard (α 0) (β 0) hinj0 (hex 0)
      rw [hc2] at h
      have hr : Nat.card (β 0).range = Nat.card (Abelian.Ext P S.X₃ 0) :=
        (Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hc1) h).symm
      have : Finite (Abelian.Ext P S.X₃ 0) := Nat.finite_of_card_ne_zero hc3
      exact AddMonoidHom.range_eq_top.mp (AddSubgroup.eq_top_of_card_eq _ hr)
    have hinj1 : Function.Injective (α 1) := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      rw [hα] at hz
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS z hz (zero_add 1)
      obtain ⟨x₂, rfl⟩ := hsurj0 x₃
      rw [← hx₃, hβ, Abelian.Ext.comp_assoc x₂ (Abelian.Ext.mk₀ S.g) hS.extClass (add_zero 0)
        (zero_add 1) (by omega), hS.comp_extClass, Abelian.Ext.comp_zero]
    have hsurj1 : Function.Surjective (β 1) := by
      intro x₃
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS x₃ (rfl : 1 + 1 = 2)
        (Subsingleton.elim _ _)
      exact ⟨x₂, by rw [hβ]; exact hx₂⟩
    rw [hcard (α 1) (β 1) hinj1 (hex 1), AddMonoidHom.range_eq_top.mpr hsurj1,
      AddSubgroup.card_top]

  have hses : ∀ (p k : ℕ), p ≠ 0 →
      ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
        (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
        (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
    intro p k hp
    have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
      rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
        ZMod.natCast_self]
    let α : ZMod k →+ ZMod (p * k) :=
      ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
    have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
      intro z
      show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
      rw [ZMod.lift_coe]
      change z • (p : ZMod (p * k)) = _
      rw [zsmul_eq_mul]
      push_cast
      ring
    let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
    have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
      map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
    have hαinj : Function.Injective α := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
      push_cast at hx
      rw [mul_comm z] at hx
      exact (mul_dvd_mul_iff_left hp').mp hx
    have hβsurj : Function.Surjective β := by
      intro y
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      exact ⟨(z : ZMod (p * k)), hβ z⟩
    have hβα : ∀ x, β (α x) = 0 := by
      intro x
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
      rw [hα, hβ]
      push_cast
      rw [ZMod.natCast_self, mul_zero]
    have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
      intro y hy
      obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
      rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
      obtain ⟨t, rfl⟩ := hy
      refine ⟨(t : ZMod k), ?_⟩
      rw [hα]
      congr 1
      ring
    let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
        AddEquiv.ulift.toAddMonoidHom)
    let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
      AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
        AddEquiv.ulift.toAddMonoidHom)
    have hw : f ≫ g = 0 := by
      ext x
      exact hβα x.down
    refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
    · rw [ShortComplex.ab_exact_iff]
      intro x₂ hx₂
      obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
      exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
    · rw [AddCommGrpCat.mono_iff_injective]
      intro a b hab
      exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
    · rw [AddCommGrpCat.epi_iff_surjective]
      intro y
      obtain ⟨x, hx⟩ := hβsurj y.down
      exact ⟨ULift.up x, congrArg ULift.up hx⟩
  haveI : Limits.PreservesFiniteLimits
      (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Y)ᵒᵖ)
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
  have H0 : ∀ m : ℕ, m ≠ 0 → Nat.card (wcEtCoh Y m 0) = m :=
    fun m hm => wc_et_coh_zero_connected_card Y m hm

  induction n, hn using Nat.le_induction with
  | base => rw [pow_one]; exact h1
  | succ j hj ih =>
    have hp : ℓ ^ j ≠ 0 := pow_ne_zero j hℓ0
    obtain ⟨f, g, hw, hS₀⟩ := hses (ℓ ^ j) ℓ hp
    have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    have hc1 : Nat.card (wcEtCoh Y ℓ 0) = ℓ := H0 ℓ hℓ0
    have hc3 : Nat.card (wcEtCoh Y (ℓ ^ j) 0) = ℓ ^ j := H0 _ hp
    have hc2 : Nat.card (wcEtCoh Y (ℓ ^ j * ℓ) 0) = ℓ ^ j * ℓ := H0 _ (mul_ne_zero hp hℓ0)
    have key := habs ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ hS
      (by change Nat.card (wcEtCoh Y ℓ 0) ≠ 0; rw [hc1]; exact hℓ0)
      (by change Nat.card (wcEtCoh Y (ℓ ^ j) 0) ≠ 0; rw [hc3]; exact hp)
      (by
        change Nat.card (wcEtCoh Y (ℓ ^ j * ℓ) 0) =
          Nat.card (wcEtCoh Y ℓ 0) * Nat.card (wcEtCoh Y (ℓ ^ j) 0)
        rw [hc1, hc2, hc3, mul_comm])
      h2
    change Nat.card (wcEtCoh Y (ℓ ^ j * ℓ) 1) =
      Nat.card (wcEtCoh Y ℓ 1) * Nat.card (wcEtCoh Y (ℓ ^ j) 1) at key
    rw [pow_succ, key, h1, ih, mul_comm]

theorem wc_lptt_R1_stalk_card : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓK : IsUnit ((ℓ : ℕ) : K)) (n : ℕ) (hn : 1 ≤ n) (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (k : ℕ) (I : InjectiveResolution (wcLpttEtSh (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) (wcKtT.{u} (ℓ ^ n) (k + 1)))) (b : X), Finite ((wcEtStalk X b).obj ((((wcEtPush (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1)) ∧ Nat.card ((wcEtStalk X b).obj ((((wcEtPush (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1)) = ℓ ^ n :=
by
  classical
  intro K _ _ ℓ _ hℓK n hn X fX k I b
  have hℓp : ℓ.Prime := Fact.out
  have hℓK0 : ((ℓ : ℕ) : K) ≠ 0 := hℓK.ne_zero
  haveI hπaff : IsAffineHom (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback fX _).flip
      inferInstance

  obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint (Limits.pullback.fst fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))
  haveI : (wcEtPush (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).IsRightAdjoint :=
    adj.isRightAdjoint
  haveI : (wcEtPush (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI := wc_et_enough_injectives (Limits.pullback fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))

  have hm : IsUnit (((ℓ ^ n : ℕ)) : K) := by
    rw [Nat.cast_pow]
    exact hℓK.pow n
  obtain ⟨eiso⟩ := wc_lptt_et_twist_const_iso K (ℓ ^ n) hm
    (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))
    (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) ≫ fX)
    (k + 1)
  let J₀ := injectiveResolution ((constantSheaf (Scheme.smallEtaleTopology
      (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ n)))))
  let Φ := (I.isoRightDerivedObj _ 1).symm ≪≫ ((wcEtPush (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).rightDerived 1).mapIso eiso
      ≪≫ J₀.isoRightDerivedObj _ 1
  let eS := ((wcEtStalk X b).mapIso Φ).addCommGroupIsoToAddEquiv

  obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, -, -⟩ :=
    wc_et_geom_strict_henselization b
  obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) b Λ W' hinit
    J₀.cocomplex 1
  obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) A Λ
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt X b)) (Scheme.Etale.forget X)) φ a
    haff hφ hφa hlim (ℓ ^ n) J₀ 1
  obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
    ((Limits.pullbackSymmetry (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) a).hom ≫
      (Limits.pullbackRightPullbackFstIso fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) a).hom) (ℓ ^ n) 1

  haveI : ConnectedSpace (Limits.pullback (C := Scheme.{u}) (a ≫ fX)
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) :=
    wc_gm_local_pullback_connected K A (a ≫ fX)
  have h4 := wc_et_henselian_gm_coh K ℓ hℓp hℓK0 A (a ≫ fX)
  have hG := wc_et_coh_one_card_prime_pow _ ℓ hℓp h4.1 (h4.2 2 le_rfl) n hn

  have hT : Nat.card ((wcEtStalk X b).obj ((((wcEtPush (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology 1)) = ℓ ^ n :=
    (Nat.card_congr (eS.toEquiv.trans (E₁.trans (E₂.trans E₃.symm)))).trans hG
  exact ⟨Nat.finite_of_card_ne_zero (by rw [hT]; exact pow_ne_zero n hℓp.ne_zero), hT⟩

theorem wc_lptt_genmap_gam : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y) (G : CommRingCat.{u} ⥤ AddCommGrpCat.{u}) (p : (wcLpttEtPre Y G).obj (Opposite.op (wcEtTop Y))), wcLpttGenMap (wcEtTop Y) (wcLpttEtSh Y G) (((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y G)).app (Opposite.op (wcEtTop Y))).hom p) ≫ wcLpttGam g G = wcLpttGamF g ≫ (wcEtPush g).map (wcLpttGenMap (wcEtTop Z) (wcLpttEtSh Z G) (((toSheafify (Scheme.smallEtaleTopology Z) (wcLpttEtPre Z G)).app (Opposite.op (wcEtTop Z))).hom (((G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map (Scheme.Γ.map g.op)).hom p))) :=
by
  classical
  intro Z Y g G p

  have hTN : ∀ {W : Scheme.{u}} {P : (W.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} {A B : (W.Etale)ᵒᵖ}
      (e : A ⟶ B) (x : P.obj A),
      (((presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj P).obj.map e).hom
          (((toSheafify (Scheme.smallEtaleTopology W) P).app A).hom x) =
        ((toSheafify (Scheme.smallEtaleTopology W) P).app B).hom ((P.map e).hom x) := by
    intro W P A B e x
    exact (congrArg (fun t => AddCommGrpCat.Hom.hom t x)
      ((toSheafify (Scheme.smallEtaleTopology W) P).naturality e)).symm

  have hC : ∀ {W : Scheme.{u}} (P : (W.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (q : P.obj (Opposite.op (wcEtTop W))),
      ∃ θ : (yoneda.obj (wcEtTop W) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ P,
        wcLpttGenMap (wcEtTop W) ((presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj P)
            (((toSheafify (Scheme.smallEtaleTopology W) P).app (Opposite.op (wcEtTop W))).hom q) =
          (presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).map θ ∧
        ∀ (V : (W.Etale)ᵒᵖ) (a : ULift.{u+1} (V.unop ⟶ wcEtTop W)),
          (θ.app V).hom (FreeAbelianGroup.of a) = (P.map a.down.op).hom q := by
    intro W P q
    obtain ⟨θ, hθ⟩ : ∃ θ : (yoneda.obj (wcEtTop W) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ P,
        ∀ (V : (W.Etale)ᵒᵖ) (a : ULift.{u+1} (V.unop ⟶ wcEtTop W)),
          (θ.app V).hom (FreeAbelianGroup.of a) = (P.map a.down.op).hom q :=
      ⟨{ app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun f : ULift.{u+1} (V.unop ⟶ wcEtTop W) => (P.map f.down.op).hom q))
         naturality := by
          intro V V' e
          apply AddCommGrpCat.hom_ext
          apply FreeAbelianGroup.lift_ext
          intro f
          obtain ⟨f⟩ := f
          change (FreeAbelianGroup.lift (fun f : ULift.{u+1} (V'.unop ⟶ wcEtTop W) =>
                (P.map f.down.op).hom q))
              (FreeAbelianGroup.map (fun f : ULift.{u+1} (V.unop ⟶ wcEtTop W) =>
                (ULift.up (e.unop ≫ f.down) : ULift.{u+1} (V'.unop ⟶ wcEtTop W)))
                (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ wcEtTop W)))) =
            (P.map e).hom ((FreeAbelianGroup.lift (fun f : ULift.{u+1} (V.unop ⟶ wcEtTop W) =>
                (P.map f.down.op).hom q))
                (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (V.unop ⟶ wcEtTop W))))
          rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
            FreeAbelianGroup.lift_apply_of]
          change (P.map (e.unop ≫ f).op).hom q = (P.map e).hom ((P.map f.op).hom q)
          rw [op_comp, Quiver.Hom.op_unop, Functor.map_comp]
          rfl },
        fun V a => FreeAbelianGroup.lift_apply_of _ _⟩
    refine ⟨θ, ?_, hθ⟩
    have hA : ∀ X : (W.Etale)ᵒᵖ,
        (θ ≫ toSheafify (Scheme.smallEtaleTopology W) P).app X =
          AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun f : ULift.{u+1} (X.unop ⟶ wcEtTop W) =>
              (((presheafToSheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}).obj P).obj.map
                f.down.op).hom
                (((toSheafify (Scheme.smallEtaleTopology W) P).app (Opposite.op (wcEtTop W))).hom q))) := by
      intro X
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro f
      obtain ⟨f⟩ := f
      show ((toSheafify (Scheme.smallEtaleTopology W) P).app X).hom ((θ.app X).hom
        (FreeAbelianGroup.of (ULift.up f : ULift.{u+1} (X.unop ⟶ wcEtTop W)))) = _
      rw [hθ X ⟨f⟩]
      erw [AddCommGrpCat.hom_ofHom, FreeAbelianGroup.lift_apply_of]
      exact (hTN _ _).symm
    unfold wcLpttGenMap wcNatOf
    split_ifs with h
    · rw [Equiv.symm_apply_eq, Adjunction.homEquiv_unit, Adjunction.unit_naturality,
        sheafificationAdjunction_unit_app]
      apply NatTrans.ext
      funext X
      exact (hA X).symm
    · exfalso
      apply h
      intro X X' f
      have hn := (θ ≫ toSheafify (Scheme.smallEtaleTopology W) P).naturality f
      rw [hA, hA] at hn
      exact hn
  obtain ⟨θY, hgY, hθY⟩ := hC (wcLpttEtPre Y G) p
  obtain ⟨θZ, hgZ, hθZ⟩ := hC (wcLpttEtPre Z G)
    (((G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map (Scheme.Γ.map g.op)).hom p)
  have hgY' : wcLpttGenMap (wcEtTop Y) (wcLpttEtSh Y G)
      (((toSheafify (Scheme.smallEtaleTopology Y) (wcLpttEtPre Y G)).app
        (Opposite.op (wcEtTop Y))).hom p) =
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map θY := hgY
  have hgZ' : wcLpttGenMap (wcEtTop Z) (wcLpttEtSh Z G)
      (((toSheafify (Scheme.smallEtaleTopology Z) (wcLpttEtPre Z G)).app
        (Opposite.op (wcEtTop Z))).hom
        (((G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map (Scheme.Γ.map g.op)).hom p)) =
      (presheafToSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).map θZ := hgZ

  have hG : ∀ {P P' : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} {Q Q' : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
      (a : P ⟶ P') (b : Q ⟶ Q') (θ : P ⟶ (wcEtBaseChange g).op ⋙ Q)
      (θ' : P' ⟶ (wcEtBaseChange g).op ⋙ Q'),
      a ≫ θ' = θ ≫ Functor.whiskerLeft (wcEtBaseChange g).op b →
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map a ≫
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (θ' ≫ Functor.whiskerLeft (wcEtBaseChange g).op
            (toSheafify (Scheme.smallEtaleTopology Z) Q')) =
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (θ ≫ Functor.whiskerLeft (wcEtBaseChange g).op
            (toSheafify (Scheme.smallEtaleTopology Z) Q)) ≫
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Functor.whiskerLeft (wcEtBaseChange g).op
            (sheafifyMap (Scheme.smallEtaleTopology Z) b)) := by
    intro P P' Q Q' a b θ θ' h
    rw [← Functor.map_comp, ← Functor.map_comp]
    congr 1
    rw [← Category.assoc, h, Category.assoc, Category.assoc, ← Functor.whiskerLeft_comp,
      ← Functor.whiskerLeft_comp, toSheafify_naturality]
  let Φ : yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶
      (wcEtBaseChange g).op ⋙
        (yoneda.obj (wcEtTop Z) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) :=
    Functor.whiskerRight (yonedaMap (wcEtBaseChange g) (wcEtTop Y) ≫
        Functor.whiskerLeft (wcEtBaseChange g).op (yoneda.map (wcLpttTopMap g)))
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)

  have hstar : θY ≫ wcLpttCanPre g G = Φ ≫ Functor.whiskerLeft (wcEtBaseChange g).op θZ := by
    apply NatTrans.ext
    funext V
    apply AddCommGrpCat.hom_ext
    apply FreeAbelianGroup.lift_ext
    intro x
    change ((wcLpttCanPre g G).app V).hom ((θY.app V).hom (FreeAbelianGroup.of x)) =
      (θZ.app (Opposite.op ((wcEtBaseChange g).obj V.unop))).hom ((Φ.app V).hom
        (FreeAbelianGroup.of x))
    obtain ⟨b, hb⟩ : ∃ b, (Φ.app V).hom (FreeAbelianGroup.of x) = FreeAbelianGroup.of b :=
      ⟨_, FreeAbelianGroup.map_of_apply _⟩
    rw [hb, hθY V x]
    erw [hθZ (Opposite.op ((wcEtBaseChange g).obj V.unop)) b]
    have hx : x.down.left = V.unop.hom :=
      (Category.comp_id _).symm.trans (MorphismProperty.Over.w x.down)
    have hb' : b.down.left = ((wcEtBaseChange g).obj V.unop).hom :=
      (Category.comp_id _).symm.trans (MorphismProperty.Over.w b.down)
    have hsq : (wcEtBaseChangeFst g).app V.unop ≫ V.unop.hom =
        ((wcEtBaseChange g).obj V.unop).hom ≫ g := Limits.pullback.condition
    change ((Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map x.down.left.op ≫
        (Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map
          ((wcEtBaseChangeFst g).app V.unop).op).hom p =
      ((Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map g.op ≫
        (Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map b.down.left.op).hom p
    have key : ∀ (a1 : V.unop.left ⟶ Y) (b1 : ((wcEtBaseChange g).obj V.unop).left ⟶ Z),
        a1 = V.unop.hom → b1 = ((wcEtBaseChange g).obj V.unop).hom →
        ((Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map a1.op ≫
          (Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map
            ((wcEtBaseChangeFst g).app V.unop).op).hom p =
        ((Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map g.op ≫
          (Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map b1.op).hom p := by
      rintro a1 b1 rfl rfl
      have e : (Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map V.unop.hom.op ≫
            (Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map
              ((wcEtBaseChangeFst g).app V.unop).op =
          (Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map g.op ≫
            (Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map
              ((wcEtBaseChange g).obj V.unop).hom.op := by
        have e2 : (Quiver.Hom.op V.unop.hom ≫ Quiver.Hom.op ((wcEtBaseChangeFst g).app V.unop) :
            Opposite.op Y ⟶ Opposite.op ((wcEtBaseChange g).obj V.unop).left) =
            Quiver.Hom.op g ≫ Quiver.Hom.op ((wcEtBaseChange g).obj V.unop).hom := by
          exact congrArg Quiver.Hom.op hsq
        first
          | (rw [← Functor.map_comp, ← Functor.map_comp, e2])
          | exact ((Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map_comp _ _).symm.trans
              ((congrArg (Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map e2).trans
                ((Scheme.Γ ⋙ G ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map_comp _ _))
      exact congrArg (fun t => AddCommGrpCat.Hom.hom t p) e
    exact key _ _ hx hb'

  rw [hgY', hgZ']
  exact hG θY θZ Φ (wcLpttCanPre g G) hstar

theorem wc_krc_E_ses (Y : Scheme.{u}) (ℓ n : ℕ) (a : (Γ(Y, ⊤))ˣ)
    (hℓ : IsUnit ((ℓ : ℕ) : Γ(Y, ⊤))) :
    ∃ w, (ShortComplex.mk
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKrIota Y (ℓ ^ n) a))
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (wcKrZ Y (ℓ ^ n) a))
      w).ShortExact :=
by
  classical



  have htop : ∀ (V : Y.Etale) (t : V ⟶ wcEtTop Y), t = wcKrToTop Y V := by
    intro V t
    apply MorphismProperty.Over.Hom.ext
    have h1 : t.left ≫ (wcEtTop Y).hom = V.hom := MorphismProperty.Over.w t
    have h2 : (wcKrToTop Y V).left = V.hom := rfl
    rw [h2, ← h1]
    exact (Category.comp_id t.left).symm
  have hfr : ∀ (V : Y.Etale) (s : FreeAbelianGroup (ULift.{u+1} (V ⟶ wcEtTop Y))),
      s = (FreeAbelianGroup.lift (fun _ : ULift.{u+1} (V ⟶ wcEtTop Y) => (1 : ℤ)) s) •
        FreeAbelianGroup.of (ULift.up.{u+1} (wcKrToTop Y V)) := by
    intro V s
    refine FreeAbelianGroup.induction_on s ?_ ?_ ?_ ?_
    · rw [map_zero, zero_smul]
    · intro x
      rw [FreeAbelianGroup.lift_apply_of, one_smul]
      exact congrArg FreeAbelianGroup.of (ULift.ext _ _ (htop V x.down))
    · intro x hx
      rw [map_neg, neg_smul, ← hx]
    · intro x y hx hy
      rw [map_add, add_smul, ← hx, ← hy]



  have hI : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcLpttEtPre Y (wcRootsFun.{u} (ℓ ^ n))).map f ≫ wcKrIotaApp Y (ℓ ^ n) a W' =
        wcKrIotaApp Y (ℓ ^ n) a W ≫ (wcKrEPre Y (ℓ ^ n) a).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨ξ⟩
    first
      | rfl
      | (apply ULift.ext; apply Subtype.ext; exact Prod.ext rfl rfl)
  have hZ : ∀ ⦃W W' : (Y.Etale)ᵒᵖ⦄ (f : W ⟶ W'),
      (wcKrEPre Y (ℓ ^ n) a).map f ≫ wcKrZApp Y (ℓ ^ n) a W' =
        wcKrZApp Y (ℓ ^ n) a W ≫
          (yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).map f := by
    intro W W' f
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨⟨⟨z, g⟩, hzg⟩⟩
    show z • FreeAbelianGroup.of (ULift.up.{u+1} (wcKrToTop Y W'.unop)) =
      FreeAbelianGroup.map (fun t : ULift.{u+1} (W.unop ⟶ wcEtTop Y) => ULift.up.{u+1} (f.unop ≫ t.down))
        (z • FreeAbelianGroup.of (ULift.up.{u+1} (wcKrToTop Y W.unop)))
    rw [map_zsmul, FreeAbelianGroup.map_of_apply, ← htop W'.unop (f.unop ≫ wcKrToTop Y W.unop)]
  have hIeq : wcKrIota Y (ℓ ^ n) a = ({ app := wcKrIotaApp Y (ℓ ^ n) a, naturality := hI } :
      wcLpttEtPre Y (wcRootsFun.{u} (ℓ ^ n)) ⟶ wcKrEPre Y (ℓ ^ n) a) := by
    unfold wcKrIota wcNatOf
    exact dif_pos hI
  have hZeq : wcKrZ Y (ℓ ^ n) a = ({ app := wcKrZApp Y (ℓ ^ n) a, naturality := hZ } :
      wcKrEPre Y (ℓ ^ n) a ⟶ yoneda.obj (wcEtTop Y) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
    unfold wcKrZ wcNatOf
    exact dif_pos hZ



  have hsheafify : ∀ {P₁ P₂ P₃ : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
      (f : P₁ ⟶ P₂) (g : P₂ ⟶ P₃) (w : f ≫ g = 0)
      (_hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) f)
      (_hex : ∀ (U : Y.Etale) (x : P₂.obj (Opposite.op U)), (g.app (Opposite.op U)).hom x = 0 →
        ∃ R ∈ Scheme.smallEtaleTopology Y U, ∀ (V : Y.Etale) (i : V ⟶ U), R.arrows i →
          ∃ y : P₁.obj (Opposite.op V), (f.app (Opposite.op V)).hom y = (P₂.map i.op).hom x)
      (_hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) g),
      ∃ w', (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f)
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g) w').ShortExact := by
    intro P₁ P₂ P₃ f g w hinj hex hsurj
    have hιinj : ∀ W, Function.Injective ((Limits.kernel.ι g).app W).hom := by
      intro W
      have hm : Mono ((Limits.kernel.ι g).app W) :=
        (NatTrans.mono_iff_mono_app (Limits.kernel.ι g)).mp inferInstance W
      exact (AddCommGrpCat.mono_iff_injective _).mp hm
    have hb : ∀ W (y : P₁.obj W), ((Limits.kernel.ι g).app W).hom
        (((Limits.kernel.lift g f w).app W).hom y) = (f.app W).hom y := by
      intro W y
      have h := congrArg (fun φ => (φ.app W).hom y) (Limits.kernel.lift_ι g f w)
      exact h
    have hc : ∀ W (s : (Limits.kernel g).obj W),
        (g.app W).hom (((Limits.kernel.ι g).app W).hom s) = 0 := by
      intro W s
      have h := congrArg (fun φ => (φ.app W).hom s) (Limits.kernel.condition g)
      exact h
    have hk : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
        (Limits.kernel.lift g f w) := by
      constructor
      intro U s
      obtain ⟨R, hR, hy⟩ := hex U (((Limits.kernel.ι g).app (Opposite.op U)).hom s) (hc _ s)
      refine (Scheme.smallEtaleTopology Y).superset_covering ?_ hR
      intro V i hi
      obtain ⟨y, hy⟩ := hy V i hi
      refine ⟨y, ?_⟩
      change ((Limits.kernel.lift g f w).app (Opposite.op V)).hom y =
        ((Limits.kernel g).map i.op).hom s
      apply hιinj
      rw [hb, hy]
      have h := congrArg (fun φ => φ.hom s) ((Limits.kernel.ι g).naturality i.op)
      simpa using h.symm
    have w' : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f ≫
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g = 0 := by
      rw [← Functor.map_comp, w, Functor.map_zero]
    have hS₀ : (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).Exact :=
      (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).exact_of_f_is_kernel
        (Limits.kernelIsKernel g)
    have hS₀L := hS₀.map (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    let φ : ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f)
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g) w' ⟶
        (ShortComplex.mk (Limits.kernel.ι g) g (Limits.kernel.condition g)).map
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
      { τ₁ := (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
            (Limits.kernel.lift g f w)
        τ₂ := 𝟙 _
        τ₃ := 𝟙 _
        comm₁₂ := by
          show (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
              (Limits.kernel.lift g f w) ≫
              (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
                (Limits.kernel.ι g) =
            (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f ≫ 𝟙 _
          rw [← Functor.map_comp, Limits.kernel.lift_ι, Category.comp_id]
        comm₂₃ := by
          show 𝟙 _ ≫ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g =
            (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g ≫ 𝟙 _
          rw [Category.id_comp, Category.comp_id] }
    haveI : Sheaf.IsLocallySurjective
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (Limits.kernel.lift g f w)) :=
      (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
