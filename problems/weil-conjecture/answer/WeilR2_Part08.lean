        · intro s m _ hm2
          rw [← cancel_mono i, hm2, IsClosedImmersion.lift_fac]
      · rw [AffineSpace.comp_homOfVector, AffineSpace.comp_homOfVector, Category.comp_id]
        congr 1
        funext j
        have hker : h j.down ∈ RingHom.ker i.appTop.hom := by
          rw [hcut.2.2]
          exact Ideal.subset_span ⟨_, rfl⟩
        simp only [Function.comp_apply, Pi.zero_apply, map_zero]
