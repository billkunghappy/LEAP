    rw [hl, Preadditive.nsmul_comp]
  have hcongr : ∀ (x x' : D1.Φ.obj (SheafOfModules.unit (wcEtZModRing X ℓ)) ⟶ I.cocomplex.X 1)
      (hxx : x = x') (hx : x ≫ I.cocomplex.d 1 (1 + 1) = 0)
      (hx' : x' ≫ I.cocomplex.d 1 (1 + 1) = 0),
      I.extMk x (1 + 1) rfl hx = I.extMk x' (1 + 1) rfl hx' := by
    rintro x _ rfl _ _
    rfl
  have hnsmul : ∀ (m : ℕ) (x : D1.Φ.obj (SheafOfModules.unit (wcEtZModRing X ℓ)) ⟶ I.cocomplex.X 1)
      (hx : x ≫ I.cocomplex.d 1 (1 + 1) = 0) (hmx : (m • x) ≫ I.cocomplex.d 1 (1 + 1) = 0),
      I.extMk (m • x) (1 + 1) rfl hmx = m • I.extMk x (1 + 1) rfl hx := by
