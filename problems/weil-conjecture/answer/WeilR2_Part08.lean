theorem wc_et_extzero_transfer_bijective : ∀ {Z : Scheme.{u}} (U : Z.Opens) (ℓ : ℕ) (E : wcEtPullData U.ι ℓ) (L : SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adj : L ⊣ E.Φ), Limits.PreservesFiniteLimits L → ∀ q : ℕ, letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ)) := HasExt.standard _; haveI := E.additive; haveI := E.presLim; haveI := E.presColim; ∃ T : Abelian.Ext (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) (SheafOfModules.unit (wcEtZModRing Z ℓ)) q →+ wcEtZModExt (U : Scheme.{u}) ℓ q, (∀ x, T x = (Abelian.Ext.mk₀ (E.μ.inv ≫ adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))).comp ((Abelian.Ext.mapExactFunctor E.Φ x).comp (Abelian.Ext.mk₀ E.μ.hom) (add_zero q)) (zero_add q)) ∧ Function.Bijective T ∧ ∀ α : wcEtZModExt Z ℓ q, T ((Abelian.Ext.mk₀ (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))).comp α (zero_add q)) = wcEtPull E q α :=
