      μF.hom) = 𝟙 _ := by
    rw [hsdef, CategoryTheory.Functor.map_comp, Category.assoc, ← Category.assoc σ, hσ,
      Category.id_comp, ← CategoryTheory.Functor.map_comp, Iso.inv_hom_id,
      CategoryTheory.Functor.map_id]
  refine ⟨L'.map s ≫ adj'.counit.app
    (F.obj (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))), ?_⟩
  have hnat := adj'.counit_naturality
    (F.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫ μF.hom)
  calc (L'.map s ≫ adj'.counit.app
        (F.obj (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))))) ≫
        F.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫ μF.hom
      = L'.map s ≫ (adj'.counit.app
        (F.obj (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))) ≫
        (F.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫ μF.hom)) :=
        Category.assoc _ _ _
    _ = L'.map s ≫ (L'.map (E'.Φ.map
        (F.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫ μF.hom)) ≫
        adj'.counit.app (SheafOfModules.unit (wcEtZModRing Z' ℓ))) :=
        congrArg (fun g => L'.map s ≫ g) hnat.symm
    _ = L'.map (s ≫ E'.Φ.map
        (F.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫ μF.hom)) ≫
        adj'.counit.app (SheafOfModules.unit (wcEtZModRing Z' ℓ)) :=
        (L'.map_comp_assoc s _ _).symm
    _ = adj'.counit.app (SheafOfModules.unit (wcEtZModRing Z' ℓ)) := by
        rw [hs, CategoryTheory.Functor.map_id, Category.id_comp]

theorem wc_et_extzero_transfer_natural : ∀ {Z Z' : Scheme.{u}} (ℓ : ℕ) (U : Z.Opens) (U' : Z'.Opens) (h' : (U' : Scheme.{u}) ⟶ (U : Scheme.{u})) (E : wcEtPullData U.ι ℓ) (E' : wcEtPullData U'.ι ℓ) (Dh' : wcEtPullData h' ℓ) (L : SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adj : L ⊣ E.Φ) (L' : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z' ℓ)) (adj' : L' ⊣ E'.Φ) (F : SheafOfModules.{u+1} (wcEtZModRing Z ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z' ℓ)) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] (μF : F.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)) ≅ SheafOfModules.unit (wcEtZModRing Z' ℓ)) (θ : F ⋙ E'.Φ ≅ E.Φ ⋙ Dh'.Φ) (κ : L'.obj (E'.Φ.obj (SheafOfModules.unit (wcEtZModRing Z' ℓ))) ⟶ F.obj (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))), Mono (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) → κ ≫ F.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫ μF.hom = adj'.counit.app (SheafOfModules.unit (wcEtZModRing Z' ℓ)) → ∀ q : ℕ, letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z' ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)) := HasExt.standard _; haveI := E.additive; haveI := E.presLim; haveI := E.presColim; haveI := E'.additive; haveI := E'.presLim; haveI := E'.presColim; ∀ x : Abelian.Ext (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) (SheafOfModules.unit (wcEtZModRing Z ℓ)) q, (Abelian.Ext.mk₀ (E'.μ.inv ≫ adj'.unit.app (E'.Φ.obj (SheafOfModules.unit (wcEtZModRing Z' ℓ))))).comp ((Abelian.Ext.mapExactFunctor E'.Φ ((Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mapExactFunctor F x).comp (Abelian.Ext.mk₀ μF.hom) (add_zero q)) (zero_add q))).comp (Abelian.Ext.mk₀ E'.μ.hom) (add_zero q)) (zero_add q) = wcEtPull Dh' q ((Abelian.Ext.mk₀ (E.μ.inv ≫ adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))).comp ((Abelian.Ext.mapExactFunctor E.Φ x).comp (Abelian.Ext.mk₀ E.μ.hom) (add_zero q)) (zero_add q)) :=
by
  classical
  intro Z Z' ℓ U U' h' E E' Dh' L adj L' adj' F _ _ _ μF θ κ hc hκ q
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)) := HasExt.standard _
  haveI := E.additive
  haveI := E.presLim
  haveI := E.presColim
  haveI := E'.additive
  haveI := E'.presLim
  haveI := E'.presColim
  haveI := Dh'.additive
  haveI := Dh'.presLim
  haveI := Dh'.presColim
  intro x

  haveI hpm : E.Φ.PreservesMonomorphisms := Functor.preservesMonomorphisms_of_adjunction adj
  haveI hmono : Mono (E.Φ.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) :=
    Functor.map_mono _ _
  haveI hse : IsSplitEpi (E.Φ.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) :=
    IsSplitEpi.mk' ⟨adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))),
      adj.right_triangle_components _⟩
  haveI hcIso : IsIso (E.Φ.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) :=
    isIso_of_mono_of_isSplitEpi _
  haveI hηIso : IsIso (adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) := by
    haveI : IsIso (adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫
        E.Φ.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) := by
      rw [adj.right_triangle_components]; infer_instance
    exact IsIso.of_isIso_comp_right _
      (E.Φ.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))))

  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have s2 : ∀ (X : Scheme.{u}) (V : (X.Etale)ᵒᵖ) (a b : ↑((wcEtZModRing X ℓ).obj.obj V)),
      a * b = b * a := by
    intro X V a b
    obtain ⟨α, hsurj⟩ : ∃ α : (Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod ℓ))) ⟶
        (wcEtZModRing X ℓ).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) α :=
      ⟨toSheafify (Scheme.smallEtaleTopology X)
          ((Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod ℓ)))),
        Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology X) _⟩
    haveI := hsurj
    have hsep := Sheaf.isSeparated (wcEtZModRing X ℓ)
    induction V using Opposite.rec with
    | op V =>
    refine hsep V _ (GrothendieckTopology.intersection_covering _
      (Presheaf.imageSieve_mem _ α a) (Presheaf.imageSieve_mem _ α b)) (a * b) (b * a) ?_
    intro W h hh
    have hh' : (Presheaf.imageSieve α a).arrows h ∧ (Presheaf.imageSieve α b).arrows h := hh
    obtain ⟨⟨t₁, ht₁⟩, ⟨t₂, ht₂⟩⟩ := hh'
    have hc0 : t₁ * t₂ = t₂ * t₁ := @mul_comm (ULift.{u+1} (ZMod ℓ)) _ t₁ t₂
    rw [map_mul, map_mul, ← ht₁, ← ht₂, ← map_mul, ← map_mul]
    exact congrArg _ hc0

  have central : ∀ (e : SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ) ⟶
      SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ))
      (y : wcEtZModExt (U' : Scheme.{u}) ℓ q),
      (Abelian.Ext.mk₀ e).comp y (zero_add q) = y.comp (Abelian.Ext.mk₀ e) (add_zero q) := by
    intro e y
    have hcomm : ∀ (X : ((U' : Scheme.{u}).Etale)ᵒᵖ)
        (a b : (wcEtZModRing (U' : Scheme.{u}) ℓ).obj.obj X), a * b = b * a :=
      s2 (U' : Scheme.{u})
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)),
        m.app (SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ)) = e := by
      let R := wcEtZModRing (U' : Scheme.{u}) ℓ
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : ((U' : Scheme.{u}).Etale)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : ((U' : Scheme.{u}).Etale)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let Lm : ∀ (M : SheafOfModules.{u+1} R) (X : ((U' : Scheme.{u}).Etale)ᵒᵖ),
          M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (Lm M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)))
        (z : wcEtZModExt (U' : Scheme.{u}) ℓ q),
        (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ)))).comp z
          (zero_add q) =
          z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ))))
            (add_zero q) := by
      intro m z
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
      simp only [Abelian.Ext.id_mapExactFunctor] at h
      exact h.symm
    obtain ⟨m, hm⟩ := hext
    subst hm
    exact hcen m y

  have gen : ∀ {Y : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)} (y : Abelian.Ext Y Y q)
      (a a' : SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ) ⟶ Y)
      (b b' : Y ⟶ SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ)),
      a ≫ b = 𝟙 _ → b' ≫ a' = 𝟙 _ →
      (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero q)) (zero_add q) =
        (Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero q)) (zero_add q) := by
    intro Y y a a' b b' hab hba
    have ea : (a ≫ b') ≫ a' = a := by rw [Category.assoc, hba, Category.comp_id]
    have eb : b' ≫ a' ≫ b = b := by rw [← Category.assoc, hba, Category.id_comp]
    have eE : (a ≫ b') ≫ (a' ≫ b) = 𝟙 _ := by rw [← Category.assoc, ea, hab]
    have hc1 : (Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (y.comp (Abelian.Ext.mk₀ b') (add_zero q)) (zero_add q)) (zero_add q) =
        ((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero q)) (zero_add q)).comp
          (Abelian.Ext.mk₀ (a ≫ b')) (add_zero q) :=
      central _ _
    have e1 : (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero q)) (zero_add q) =
        ((Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (y.comp (Abelian.Ext.mk₀ b') (add_zero q)) (zero_add q)) (zero_add q)).comp
          (Abelian.Ext.mk₀ (a' ≫ b)) (add_zero q) := by
      rw [h2, h4, h3, ea, eb]
    rw [e1, hc1, h3, eE, Abelian.Ext.comp_mk₀_id]
  have genr : ∀ {M M' : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ)}
      (y : Abelian.Ext M M' q)
      (a a' : SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ) ⟶ M)
      (b b' : M' ⟶ SheafOfModules.unit (wcEtZModRing (U' : Scheme.{u}) ℓ)) (r : M ⟶ M'),
      IsIso r → IsIso a' → a ≫ r ≫ b = 𝟙 _ → a' ≫ r ≫ b' = 𝟙 _ →
      (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero q)) (zero_add q) =
        (Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero q)) (zero_add q) := by
    intro M M' y a a' b b' r hr ha' hab hab'
    have hy : y = (y.comp (Abelian.Ext.mk₀ (inv r)) (add_zero q)).comp (Abelian.Ext.mk₀ r)
        (add_zero q) := by
      rw [h3, IsIso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    have hB' : (r ≫ b') ≫ a' = 𝟙 M := by
      rw [IsIso.eq_inv_of_hom_inv_id hab', IsIso.inv_hom_id]
    rw [hy, h3 _ r b, h3 _ r b']
    exact gen _ a a' (r ≫ b) (r ≫ b') hab hB'

  have nat' : (Abelian.Ext.mapExactFunctor (F ⋙ E'.Φ) x).comp
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) (add_zero q) =
      (Abelian.Ext.mk₀ (θ.hom.app (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))))).comp
        (Abelian.Ext.mapExactFunctor (E.Φ ⋙ Dh'.Φ) x) (zero_add q) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.hom
  have step1 : (Abelian.Ext.mapExactFunctor (F ⋙ E'.Φ) x).comp
      (Abelian.Ext.mk₀ (E'.Φ.map μF.hom)) (add_zero q) =
      ((Abelian.Ext.mk₀ (θ.hom.app (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))))).comp
        (Abelian.Ext.mapExactFunctor (E.Φ ⋙ Dh'.Φ) x) (zero_add q)).comp
        (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ≫ E'.Φ.map μF.hom))
        (add_zero q) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  have hL : (Abelian.Ext.mk₀ (E'.μ.inv ≫
      adj'.unit.app (E'.Φ.obj (SheafOfModules.unit (wcEtZModRing Z' ℓ))))).comp
      ((Abelian.Ext.mapExactFunctor E'.Φ ((Abelian.Ext.mk₀ κ).comp
        ((Abelian.Ext.mapExactFunctor F x).comp (Abelian.Ext.mk₀ μF.hom) (add_zero q))
        (zero_add q))).comp (Abelian.Ext.mk₀ E'.μ.hom) (add_zero q)) (zero_add q) =
      (Abelian.Ext.mk₀ (E'.μ.inv ≫ adj'.unit.app (E'.Φ.obj (SheafOfModules.unit (wcEtZModRing Z' ℓ))) ≫
        E'.Φ.map κ ≫ θ.hom.app (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))))).comp
        ((Abelian.Ext.mapExactFunctor (E.Φ ⋙ Dh'.Φ) x).comp
          (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ≫
            E'.Φ.map μF.hom ≫ E'.μ.hom)) (add_zero q)) (zero_add q) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, step1]
    simp only [h2, h3, h4, Category.assoc]
  have hR : (Abelian.Ext.mk₀ Dh'.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dh'.Φ
      ((Abelian.Ext.mk₀ (E.μ.inv ≫ adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))).comp
        ((Abelian.Ext.mapExactFunctor E.Φ x).comp (Abelian.Ext.mk₀ E.μ.hom) (add_zero q))
        (zero_add q))).comp (Abelian.Ext.mk₀ Dh'.μ.hom) (add_zero q)) (zero_add q) =
      (Abelian.Ext.mk₀ (Dh'.μ.inv ≫
        Dh'.Φ.map (E.μ.inv ≫ adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))))).comp
        ((Abelian.Ext.mapExactFunctor (E.Φ ⋙ Dh'.Φ) x).comp
          (Abelian.Ext.mk₀ (Dh'.Φ.map E.μ.hom ≫ Dh'.μ.hom)) (add_zero q)) (zero_add q) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]

  have hθ : θ.hom.app (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) ≫
      (E.Φ ⋙ Dh'.Φ).map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫
      θ.inv.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) =
      (F ⋙ E'.Φ).map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) := by
    rw [← θ.hom.naturality_assoc]
    simp
  have hκ' : E'.Φ.map κ ≫ E'.Φ.map (F.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) ≫
      E'.Φ.map μF.hom = E'.Φ.map (adj'.counit.app (SheafOfModules.unit (wcEtZModRing Z' ℓ))) := by
    rw [← Functor.map_comp, ← Functor.map_comp, hκ]
  have hLret : (E'.μ.inv ≫ adj'.unit.app (E'.Φ.obj (SheafOfModules.unit (wcEtZModRing Z' ℓ))) ≫
      E'.Φ.map κ ≫ θ.hom.app (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))) ≫
      (E.Φ ⋙ Dh'.Φ).map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫
      (θ.inv.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ≫ E'.Φ.map μF.hom ≫ E'.μ.hom) = 𝟙 _ := by
    simp only [Category.assoc, Functor.comp_map] at hθ ⊢
    rw [reassoc_of% hθ, reassoc_of% hκ',
      reassoc_of% (adj'.right_triangle_components (SheafOfModules.unit (wcEtZModRing Z' ℓ))),
      Iso.inv_hom_id]
  have hη' : Dh'.Φ.map (E.μ.inv ≫ adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) ≫
      Dh'.Φ.map (E.Φ.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) ≫
      Dh'.Φ.map E.μ.hom = 𝟙 _ := by
    rw [← Functor.map_comp, ← Functor.map_comp, Category.assoc,
      reassoc_of% (adj.right_triangle_components (SheafOfModules.unit (wcEtZModRing Z ℓ))),
      Iso.inv_hom_id, CategoryTheory.Functor.map_id]
  have hRret : (Dh'.μ.inv ≫
      Dh'.Φ.map (E.μ.inv ≫ adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))) ≫
      (E.Φ ⋙ Dh'.Φ).map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫
      (Dh'.Φ.map E.μ.hom ≫ Dh'.μ.hom) = 𝟙 _ := by
    rw [Functor.comp_map]
    simp only [Category.assoc]
    rw [reassoc_of% hη', Iso.inv_hom_id]
  haveI hrIso : IsIso ((E.Φ ⋙ Dh'.Φ).map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) :=
    Functor.map_isIso Dh'.Φ (E.Φ.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))))
  haveI haIso : IsIso (Dh'.μ.inv ≫
      Dh'.Φ.map (E.μ.inv ≫ adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))) :=
    inferInstance
  refine hL.trans ((genr _ _ _ _ _ _ hrIso haIso hLret hRret).trans ?_)
  exact hR.symm

theorem wc_et_zariski_mv_natural_kill : ∀ {Y : Scheme.{u}} (ℓ : ℕ) (A B : Y.Opens), A ⊔ B = ⊤ → ∀ (k : ℕ) (α : wcEtZModExt Y ℓ (k + 1)), (∀ DA : wcEtPullData A.ι ℓ, wcEtPull DA (k + 1) α = 0) → (∀ DB : wcEtPullData B.ι ℓ, wcEtPull DB (k + 1) α = 0) → ∃ γ : wcEtZModExt ((A ⊓ B : Y.Opens) : Scheme.{u}) ℓ k, ∀ (Y' : Scheme.{u}) (w : Y' ⟶ Y) (a : wcEtZModExt ((w ⁻¹ᵁ A : Y'.Opens) : Scheme.{u}) ℓ k) (b : wcEtZModExt ((w ⁻¹ᵁ B : Y'.Opens) : Scheme.{u}) ℓ k), (∀ (Dγ : wcEtPullData (w ∣_ (A ⊓ B)) ℓ) (Da : wcEtPullData (Y'.homOfLE (show w ⁻¹ᵁ (A ⊓ B) ≤ w ⁻¹ᵁ A from fun _ hy => hy.1)) ℓ) (Db : wcEtPullData (Y'.homOfLE (show w ⁻¹ᵁ (A ⊓ B) ≤ w ⁻¹ᵁ B from fun _ hy => hy.2)) ℓ), wcEtPull Dγ k γ = wcEtPull Da k a + wcEtPull Db k b) → ∀ Dw : wcEtPullData w ℓ, wcEtPull Dw (k + 1) α = 0 :=
by
  classical
  intro Y ℓ A B hAB k α hA hB
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _

  obtain ⟨EA⟩ := wc_et_zmod_pull_data_exists A.ι ℓ
  obtain ⟨EB⟩ := wc_et_zmod_pull_data_exists B.ι ℓ
  obtain ⟨EC⟩ := wc_et_zmod_pull_data_exists (A ⊓ B).ι ℓ
  obtain ⟨LA, adjA, LB, adjB, LC, adjC, hLA, hLB, hLC, mA, mB, mC, u, v, hu, hv, w0, hS⟩ :=
    wc_et_zariski_mv_unit_ses ℓ A B hAB EA EB EC

  obtain ⟨TA, -, bTA, cTA⟩ := wc_et_extzero_transfer_bijective A ℓ EA LA adjA hLA (k + 1)
  obtain ⟨TB, -, bTB, cTB⟩ := wc_et_extzero_transfer_bijective B ℓ EB LB adjB hLB (k + 1)
  obtain ⟨TC, hTC, -, -⟩ := wc_et_extzero_transfer_bijective (A ⊓ B) ℓ EC LC adjC hLC k

  have hcA : (Abelian.Ext.mk₀ (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Y ℓ)))).comp α
      (zero_add (k + 1)) = 0 := by
    apply bTA.1
    rw [cTA, hA EA, map_zero]
  have hcB : (Abelian.Ext.mk₀ (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Y ℓ)))).comp α
      (zero_add (k + 1)) = 0 := by
    apply bTB.1
    rw [cTB, hB EB, map_zero]
  have hg : (Abelian.Ext.mk₀ (Limits.biprod.desc
      (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Y ℓ)))
      (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Y ℓ))))).comp α (zero_add (k + 1)) = 0 := by
    apply Abelian.Ext.biprod_ext
    · rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Limits.biprod.inl_desc, hcA, Abelian.Ext.comp_zero]
    · rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Limits.biprod.inr_desc, hcB, Abelian.Ext.comp_zero]

  obtain ⟨x, hx⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS _ α hg (add_comm 1 k)
  refine ⟨TC x, ?_⟩

  intro Y' w a b hsum Dw
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)) := HasExt.standard _
  haveI := Dw.additive
  haveI := Dw.presLim
  haveI := Dw.presColim
  have hAB' : w ⁻¹ᵁ A ⊔ w ⁻¹ᵁ B = ⊤ := by
    rw [← Scheme.Hom.preimage_sup, hAB, Scheme.Hom.preimage_top]
  obtain ⟨EA'⟩ := wc_et_zmod_pull_data_exists (w ⁻¹ᵁ A).ι ℓ
  obtain ⟨EB'⟩ := wc_et_zmod_pull_data_exists (w ⁻¹ᵁ B).ι ℓ
  obtain ⟨EC'⟩ := wc_et_zmod_pull_data_exists (w ⁻¹ᵁ A ⊓ w ⁻¹ᵁ B).ι ℓ
  obtain ⟨LA', adjA', LB', adjB', LC', adjC', hLA', hLB', hLC', mA', mB', mC', u', v', hu', hv',
    w0', hS'⟩ := wc_et_zariski_mv_unit_ses ℓ (w ⁻¹ᵁ A) (w ⁻¹ᵁ B) hAB' EA' EB' EC'
  obtain ⟨TA', hTA', bTA', -⟩ := wc_et_extzero_transfer_bijective (w ⁻¹ᵁ A) ℓ EA' LA' adjA' hLA' k
  obtain ⟨TB', hTB', bTB', -⟩ := wc_et_extzero_transfer_bijective (w ⁻¹ᵁ B) ℓ EB' LB' adjB' hLB' k
  obtain ⟨TC', hTC', bTC', -⟩ :=
    wc_et_extzero_transfer_bijective (w ⁻¹ᵁ A ⊓ w ⁻¹ᵁ B) ℓ EC' LC' adjC' hLC' k

  obtain ⟨DhA⟩ := wc_et_zmod_pull_data_exists (w ∣_ A) ℓ
  obtain ⟨DhB⟩ := wc_et_zmod_pull_data_exists (w ∣_ B) ℓ
  obtain ⟨DhC⟩ := wc_et_zmod_pull_data_exists (w ∣_ (A ⊓ B)) ℓ
  obtain ⟨DkA⟩ := wc_et_zmod_pull_data_exists ((w ⁻¹ᵁ A).ι ≫ w) ℓ
  obtain ⟨DkB⟩ := wc_et_zmod_pull_data_exists ((w ⁻¹ᵁ B).ι ≫ w) ℓ
  obtain ⟨DkC⟩ := wc_et_zmod_pull_data_exists ((w ⁻¹ᵁ A ⊓ w ⁻¹ᵁ B).ι ≫ w) ℓ
  obtain ⟨iA1⟩ := wc_et_pull_data_comp_iso w (w ⁻¹ᵁ A).ι _ rfl Dw EA' DkA
  obtain ⟨iA2⟩ := wc_et_pull_data_comp_iso A.ι (w ∣_ A) _ (morphismRestrict_ι w A) EA DhA DkA
  obtain ⟨iB1⟩ := wc_et_pull_data_comp_iso w (w ⁻¹ᵁ B).ι _ rfl Dw EB' DkB
  obtain ⟨iB2⟩ := wc_et_pull_data_comp_iso B.ι (w ∣_ B) _ (morphismRestrict_ι w B) EB DhB DkB
  obtain ⟨iC1⟩ := wc_et_pull_data_comp_iso w (w ⁻¹ᵁ A ⊓ w ⁻¹ᵁ B).ι _ rfl Dw EC' DkC
  obtain ⟨iC2⟩ := wc_et_pull_data_comp_iso (A ⊓ B).ι (w ∣_ (A ⊓ B)) _
    (morphismRestrict_ι w (A ⊓ B)) EC DhC DkC

  obtain ⟨κA, hκA⟩ := wc_et_extzero_counit_lift ℓ A (w ⁻¹ᵁ A) (w ∣_ A) EA EA' DhA LA adjA LA' adjA'
    Dw.Φ Dw.μ (iA1.symm ≪≫ iA2) (mA _)
  obtain ⟨κB, hκB⟩ := wc_et_extzero_counit_lift ℓ B (w ⁻¹ᵁ B) (w ∣_ B) EB EB' DhB LB adjB LB' adjB'
    Dw.Φ Dw.μ (iB1.symm ≪≫ iB2) (mB _)
  obtain ⟨κC, hκC⟩ := wc_et_extzero_counit_lift ℓ (A ⊓ B) (w ⁻¹ᵁ A ⊓ w ⁻¹ᵁ B) (w ∣_ (A ⊓ B)) EC EC'
    DhC LC adjC LC' adjC' Dw.Φ Dw.μ (iC1.symm ≪≫ iC2) (mC _)

  haveI := mA (SheafOfModules.unit (wcEtZModRing Y ℓ))
  haveI := mB (SheafOfModules.unit (wcEtZModRing Y ℓ))
  have key := wc_abelian_mv_extclass_base_change Dw.Φ _ _ _ u v w0 hS _ _ _ u' v' w0' hS' hu hv hu' hv'
    Dw.μ κA κB κC inferInstance inferInstance hκA hκB hκC k x
  rw [hx] at key
  have hpull : wcEtPull Dw (k + 1) α = hS'.extClass.comp ((Abelian.Ext.mk₀ κC).comp
      ((Abelian.Ext.mapExactFunctor Dw.Φ x).comp (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero k))
      (zero_add k)) (add_comm 1 k) := key

  have hC6 := wc_et_extzero_transfer_natural ℓ (A ⊓ B) (w ⁻¹ᵁ A ⊓ w ⁻¹ᵁ B) (w ∣_ (A ⊓ B)) EC EC' DhC
    LC adjC LC' adjC' Dw.Φ Dw.μ (iC1.symm ≪≫ iC2) κC (mC _) hκC k x
  rw [← hTC', ← hTC] at hC6
  obtain ⟨Da⟩ := wc_et_zmod_pull_data_exists
    (Y'.homOfLE (show w ⁻¹ᵁ (A ⊓ B) ≤ w ⁻¹ᵁ A from fun _ hy => hy.1)) ℓ
  obtain ⟨Db⟩ := wc_et_zmod_pull_data_exists
    (Y'.homOfLE (show w ⁻¹ᵁ (A ⊓ B) ≤ w ⁻¹ᵁ B from fun _ hy => hy.2)) ℓ
  obtain ⟨jA⟩ := wc_et_pull_data_comp_iso (w ⁻¹ᵁ A).ι
    (Y'.homOfLE (show w ⁻¹ᵁ (A ⊓ B) ≤ w ⁻¹ᵁ A from fun _ hy => hy.1)) (w ⁻¹ᵁ A ⊓ w ⁻¹ᵁ B).ι
    (Scheme.homOfLE_ι _ _) EA' Da EC'
  obtain ⟨jB⟩ := wc_et_pull_data_comp_iso (w ⁻¹ᵁ B).ι
    (Y'.homOfLE (show w ⁻¹ᵁ (A ⊓ B) ≤ w ⁻¹ᵁ B from fun _ hy => hy.2)) (w ⁻¹ᵁ A ⊓ w ⁻¹ᵁ B).ι
    (Scheme.homOfLE_ι _ _) EB' Db EC'
  have hA6 : ∀ a₀, TC' ((Abelian.Ext.mk₀ u').comp a₀ (zero_add k)) = wcEtPull Da k (TA' a₀) := by
    intro a₀
    have h := wc_et_extzero_transfer_natural ℓ (w ⁻¹ᵁ A) (w ⁻¹ᵁ A ⊓ w ⁻¹ᵁ B)
      (Y'.homOfLE (show w ⁻¹ᵁ (A ⊓ B) ≤ w ⁻¹ᵁ A from fun _ hy => hy.1)) EA' EC' Da LA' adjA' LC' adjC'
      (𝟭 _) (Iso.refl _) (Functor.leftUnitor _ ≪≫ jA) u' (mA' _)
      (by
        rw [Functor.id_map, Iso.refl_hom]
        first
          | exact (congrArg (fun t => u' ≫ t) (Category.comp_id _)).trans hu'
          | simpa only [Functor.id_obj, Category.comp_id] using hu') k a₀
    rw [Abelian.Ext.id_mapExactFunctor, Iso.refl_hom, Abelian.Ext.comp_mk₀_id] at h
    rw [hTC', hTA']
    exact h
  have hB6 : ∀ b₀, TC' ((Abelian.Ext.mk₀ v').comp b₀ (zero_add k)) = wcEtPull Db k (TB' b₀) := by
    intro b₀
    have h := wc_et_extzero_transfer_natural ℓ (w ⁻¹ᵁ B) (w ⁻¹ᵁ A ⊓ w ⁻¹ᵁ B)
      (Y'.homOfLE (show w ⁻¹ᵁ (A ⊓ B) ≤ w ⁻¹ᵁ B from fun _ hy => hy.2)) EB' EC' Db LB' adjB' LC' adjC'
      (𝟭 _) (Iso.refl _) (Functor.leftUnitor _ ≪≫ jB) v' (mB' _)
      (by
        rw [Functor.id_map, Iso.refl_hom]
        first
          | exact (congrArg (fun t => v' ≫ t) (Category.comp_id _)).trans hv'
          | simpa only [Functor.id_obj, Category.comp_id] using hv') k b₀
    rw [Abelian.Ext.id_mapExactFunctor, Iso.refl_hom, Abelian.Ext.comp_mk₀_id] at h
    rw [hTC', hTB']
    exact h
  obtain ⟨a₀, rfl⟩ := bTA'.2 a
  obtain ⟨b₀, rfl⟩ := bTB'.2 b
  have hyC : (Abelian.Ext.mk₀ κC).comp
      ((Abelian.Ext.mapExactFunctor Dw.Φ x).comp (Abelian.Ext.mk₀ Dw.μ.hom) (add_zero k))
      (zero_add k) = (Abelian.Ext.mk₀ u').comp a₀ (zero_add k) +
        (Abelian.Ext.mk₀ v').comp b₀ (zero_add k) := by
    apply bTC'.1
    rw [hC6, map_add, hA6, hB6]
    exact hsum DhC Da Db

  have hf : (Abelian.Ext.mk₀ (Limits.biprod.lift u' (-v'))).comp
      ((Abelian.Ext.mk₀ Limits.biprod.fst).comp a₀ (zero_add k) +
        (Abelian.Ext.mk₀ (-Limits.biprod.snd)).comp b₀ (zero_add k)) (zero_add k) =
      (Abelian.Ext.mk₀ u').comp a₀ (zero_add k) + (Abelian.Ext.mk₀ v').comp b₀ (zero_add k) := by
    rw [Abelian.Ext.comp_add, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
      ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀, Limits.biprod.lift_fst, Preadditive.comp_neg,
      Limits.biprod.lift_snd, neg_neg]
  have h0 : hS'.extClass.comp (Abelian.Ext.mk₀ (Limits.biprod.lift u' (-v'))) (add_zero 1) = 0 :=
    hS'.extClass_comp
  rw [hpull, hyC, ← hf, ← Abelian.Ext.comp_assoc_of_second_deg_zero, h0, Abelian.Ext.zero_comp]

theorem wc_et_zariski_mv_local_kill : ∀ {S Y : Scheme.{u}} (h : Y ⟶ S) (ℓ : ℕ) (A B : Y.Opens), A ⊔ B = ⊤ → ∀ (n : ℕ), 1 ≤ n → ∀ α : wcEtZModExt Y ℓ n, (∀ DA : wcEtPullData A.ι ℓ, wcEtPcLocDies (A.ι ≫ h) ℓ n (wcEtPull DA n α)) → (∀ DB : wcEtPullData B.ι ℓ, wcEtPcLocDies (B.ι ≫ h) ℓ n (wcEtPull DB n α)) → wcEtPcMVSurj h ℓ A B (n - 1) → wcEtPcLocDies h ℓ n α :=
by
  classical
  intro S Y h ℓ A B hAB n hn α HA HB HS
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  rw [Nat.add_sub_cancel] at HS

  have hrefine : ∀ {T Z T0 : Scheme.{u}} (g : Z ⟶ T) (s0 : T0 ⟶ T) (β : wcEtZModExt Z ℓ (k + 1)),
      (∀ (Y' : Scheme.{u}) (h' : Y' ⟶ T0) (w' : Y' ⟶ Z), IsPullback w' h' g s0 →
        ∀ D : wcEtPullData w' ℓ, wcEtPull D (k + 1) β = 0) →
      ∀ {W : Scheme.{u}} (w1 : W ⟶ Z) (t1 : W ⟶ T0), w1 ≫ g = t1 ≫ s0 →
        ∀ D : wcEtPullData w1 ℓ, wcEtPull D (k + 1) β = 0 := by
    intro T Z T0 g s0 β hkill W w1 t1 e D
    obtain ⟨Dfst⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst g s0) ℓ
    obtain ⟨Dm⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.lift w1 t1 e) ℓ
    rw [wc_et_pull_comp (Limits.pullback.fst g s0) (Limits.pullback.lift w1 t1 e) w1
      (Limits.pullback.lift_fst _ _ _) Dfst Dm D (k + 1) β,
      hkill _ _ _ (IsPullback.of_hasPullback g s0) Dfst, map_zero]
  intro x
  obtain ⟨DA0⟩ := wc_et_zmod_pull_data_exists A.ι ℓ
  obtain ⟨DB0⟩ := wc_et_zmod_pull_data_exists B.ι ℓ
  obtain ⟨SA, sA, hsA, ⟨xa, hxa⟩, killA⟩ := HA DA0 x
  obtain ⟨SB, sB, hsB, ⟨xb, hxb⟩, killB⟩ := HB DB0 x
  haveI := hsA
  haveI := hsB

  obtain ⟨S1, s1, tA, tB, hs1, htA, htB, x1, hx1⟩ : ∃ (S1 : Scheme.{u}) (s1 : S1 ⟶ S)
      (tA : S1 ⟶ SA) (tB : S1 ⟶ SB), Etale s1 ∧ s1 = tA ≫ sA ∧ s1 = tB ≫ sB ∧
      ∃ x1 : S1, s1 x1 = x := by
    obtain ⟨x1, hx1a, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := sA) (g := sB) xa xb
      (hxa.trans hxb.symm)
    exact ⟨_, Limits.pullback.fst sA sB ≫ sA, Limits.pullback.fst sA sB,
      Limits.pullback.snd sA sB, inferInstance, rfl, Limits.pullback.condition, x1,
      by rw [Scheme.Hom.comp_apply, hx1a, hxa]⟩
  haveI := hs1
  obtain ⟨Y1, w1, h1, hsq1⟩ : ∃ (Y1 : Scheme.{u}) (w1 : Y1 ⟶ Y) (h1 : Y1 ⟶ S1),
      IsPullback w1 h1 h s1 := ⟨_, _, _, IsPullback.of_hasPullback h s1⟩
  obtain ⟨D1⟩ := wc_et_zmod_pull_data_exists w1 ℓ
  have hAB1 : w1 ⁻¹ᵁ A ⊔ w1 ⁻¹ᵁ B = ⊤ := by
    rw [← Scheme.Hom.preimage_sup, hAB, Scheme.Hom.preimage_top]

  have hres : ∀ (U : Y.Opens) (SU : Scheme.{u}) (sU : SU ⟶ S) (tU : S1 ⟶ SU), s1 = tU ≫ sU →
      ∀ DU0 : wcEtPullData U.ι ℓ,
      (∀ (Y' : Scheme.{u}) (h' : Y' ⟶ SU) (w' : Y' ⟶ (U : Scheme.{u})), IsPullback w' h' (U.ι ≫ h) sU →
        ∀ D : wcEtPullData w' ℓ, wcEtPull D (k + 1) (wcEtPull DU0 (k + 1) α) = 0) →
      ∀ DU1 : wcEtPullData (w1 ⁻¹ᵁ U).ι ℓ, wcEtPull DU1 (k + 1) (wcEtPull D1 (k + 1) α) = 0 := by
    intro U SU sU tU htU DU0 killU DU1
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists ((w1 ⁻¹ᵁ U).ι ≫ w1) ℓ
    obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists (w1 ∣_ U) ℓ
    rw [← wc_et_pull_comp w1 (w1 ⁻¹ᵁ U).ι _ rfl D1 DU1 Dk,
      wc_et_pull_comp U.ι (w1 ∣_ U) _ (morphismRestrict_ι w1 U) DU0 Dr Dk]
    refine hrefine (U.ι ≫ h) sU _ killU (w1 ∣_ U) ((w1 ⁻¹ᵁ U).ι ≫ h1 ≫ tU) ?_ Dr
    calc w1 ∣_ U ≫ U.ι ≫ h = (w1 ⁻¹ᵁ U).ι ≫ w1 ≫ h := by
          rw [← Category.assoc, morphismRestrict_ι, Category.assoc]
      _ = (w1 ⁻¹ᵁ U).ι ≫ h1 ≫ s1 := by rw [hsq1.w]
      _ = ((w1 ⁻¹ᵁ U).ι ≫ h1 ≫ tU) ≫ sU := by rw [htU]; simp only [Category.assoc]
  have hresA := hres A SA sA tA htA DA0 killA
  have hresB := hres B SB sB tB htB DB0 killB

  obtain ⟨γ1, kill1⟩ := wc_et_zariski_mv_natural_kill ℓ (w1 ⁻¹ᵁ A) (w1 ⁻¹ᵁ B) hAB1 k
    (wcEtPull D1 (k + 1) α) hresA hresB

  obtain ⟨S2, s2, hs2, ⟨x2, hx2⟩, split⟩ := HS S1 s1 hs1 Y1 h1 w1 hsq1 γ1 x1
  haveI := hs2
  refine ⟨S2, s2 ≫ s1, inferInstance, ⟨x2, by rw [Scheme.Hom.comp_apply, hx2, hx1]⟩, ?_⟩
  intro Y' h' w' hsq' D'
  have e : w' ≫ h = (h' ≫ s2) ≫ s1 := by rw [hsq'.w, Category.assoc]
  obtain ⟨w2, hw2a, hw2b⟩ : ∃ w2 : Y' ⟶ Y1, w2 ≫ w1 = w' ∧ w2 ≫ h1 = h' ≫ s2 :=
    ⟨hsq1.lift w' (h' ≫ s2) e, hsq1.lift_fst _ _ _, hsq1.lift_snd _ _ _⟩
  have hsq2 : IsPullback w2 h' h1 s2 :=
    IsPullback.of_right (by rw [hw2a]; exact hsq') hw2b hsq1
  obtain ⟨a, b, hsum⟩ := split Y' h' w2 hsq2
  obtain ⟨Dw2⟩ := wc_et_zmod_pull_data_exists w2 ℓ
  rw [wc_et_pull_comp w1 w2 w' hw2a D1 Dw2 D' (k + 1) α]
  exact kill1 Y' w2 a b hsum Dw2

theorem wc_et_zmodext_pos_locally_zero : ∀ (S : Scheme.{u}) (ℓ : ℕ), ℓ ≠ 0 → ∀ (n : ℕ), 1 ≤ n → ∀ (β : wcEtZModExt S ℓ n) (x : S), ∃ (S' : Scheme.{u}) (s' : S' ⟶ S), Etale s' ∧ x ∈ Set.range s' ∧ ∀ (D : wcEtPullData s' ℓ), wcEtPull D n β = 0 :=
by
  classical
  intro S ℓ hℓ n hn β x
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨μ, hbij, hnat⟩ := wc_r2gs_free_ext_zmodext_natural (X := S) ℓ hℓ (k + 1)
  obtain ⟨ξ, hξ⟩ := (hbij (wcEtTop S)).2 β
  obtain ⟨R, hR, hkill⟩ := wc_et_ext_free_locally_zero S (wcEtTop S)
    ((constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) k ξ
  have key : ∀ (V : S.Etale) (g : V ⟶ wcEtTop S), R.arrows g →
      ∀ D : wcEtPullData g.left ℓ, wcEtPull D (k + 1) β = 0 := by
    intro V g hg D
    obtain ⟨D₀, hD₀⟩ := hnat (wcEtTop S) V g
    have h0 : wcEtPull D₀ (k + 1) β = 0 := by
      have h1 := hD₀ ξ
      rw [hkill V g hg, map_zero, hξ] at h1
      exact h1.symm
    obtain ⟨E, -⟩ := hnat V V (𝟙 V)
    have hid : (𝟙 V : V ⟶ V).left ≫ g.left = g.left := by
      rw [show (𝟙 V : V ⟶ V).left = 𝟙 V.left from rfl, Category.id_comp]
    rw [wc_et_pull_comp g.left (𝟙 V : V ⟶ V).left g.left hid D₀ E D (k + 1) β, h0, map_zero]
  obtain ⟨𝒰, hO, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology (wcEtTop S) R).mp hR
  have hcov := (Scheme.ofArrows_mem_precoverage_iff @Etale).mp 𝒰.mem₀
  obtain ⟨i, hi⟩ := hcov.1 x
  unfold Scheme.Cover.toPresieveOverProp at hle
  have hg := (Presieve.ofArrows_le_iff (C := S.Etale)).mp hle i
  refine ⟨𝒰.X i, 𝒰.f i, hcov.2 i, hi, ?_⟩
  intro D
  exact key _ _ hg D

theorem wc_mvpoly_fin_succ_spec_isPullback : ∀ (K : Type u) [Field K] (c' : ℕ), IsPullback (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) (Spec.map (CommRingCat.ofHom (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K)))) :=
by
  intro K _ c'
  apply isPullback_SpecMap_of_isPushout
  have hw : CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)) ≫
      CommRingCat.ofHom (MvPolynomial.rename Fin.succ :
        MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom =
      CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K)) ≫
      CommRingCat.ofHom (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) :
        MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom := by
    ext r
    simp [MvPolynomial.algebraMap_eq]
  refine IsPushout.of_isColimit' ⟨hw⟩ (Limits.PushoutCocone.IsColimit.mk hw
    (fun s => CommRingCat.ofHom (MvPolynomial.eval₂Hom (s.inl.hom.comp MvPolynomial.C)
      (fun i : Fin (c' + 1) => Fin.cases (motive := fun _ => (s.pt : Type u))
        (s.inr.hom (MvPolynomial.X 0)) (fun j => s.inl.hom (MvPolynomial.X j)) i))) ?_ ?_ ?_)
  · intro s
    apply CommRingCat.hom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      simp
    · intro j
      simp
  · intro s
    have hC : ∀ r : K, s.inl.hom (MvPolynomial.C r) = s.inr.hom (MvPolynomial.C r) := by
      intro r
      have h := congrArg (fun f => f.hom r) s.condition
      simpa [MvPolynomial.algebraMap_eq] using h
    apply CommRingCat.hom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      simpa using hC r
    · intro i
      rw [Fin.fin_one_eq_zero i]
      simp
  · intro s m hl hr
    apply CommRingCat.hom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      have h := congrArg (fun f => f.hom (MvPolynomial.C r)) hl
      simp at h
      simpa using h
    · intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · have h := congrArg (fun f => f.hom (MvPolynomial.X 0)) hr
        simp at h
        simpa using h
      · have h := congrArg (fun f => f.hom (MvPolynomial.X j)) hl
        simp at h
        simpa using h

theorem wc_et_pc_covB_bundle : ∀ (K : Type u) [Field K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (c' : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K)))) → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → IsPullback (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) (Spec.map (CommRingCat.ofHom (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K)))) → ∃ (P' : Scheme.{u}) (p' : P' ⟶ S) (q' : P' ⟶ Spec (.of (MvPolynomial (Fin c') K))) (U'' : P'.Opens) (gB : ((wcEtPcCovB q U : (U : Scheme.{u}).Opens) : Scheme.{u}) ⟶ (U'' : Scheme.{u})) (qB : ((wcEtPcCovB q U : (U : Scheme.{u}).Opens) : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Fin 1) K))) (jB : (U'' : Scheme.{u}) ⟶ ((wcEtPcCovB q U : (U : Scheme.{u}).Opens) : Scheme.{u})) (e1 : P' ⟶ (U : Scheme.{u})), IsPullback p' q' fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) ∧ IsPullback gB qB (U''.ι ≫ p' ≫ fS) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K)))) ∧ jB ≫ gB = 𝟙 _ ∧ jB ≫ (wcEtPcCovB q U).ι = U''.ι ≫ e1 ∧ gB ≫ U''.ι ≫ p' = (wcEtPcCovB q U).ι ≫ U.ι ≫ p :=
by
  classical
  intro K _ S fS c' P p q z0 hP hz0q U hU hsq

  have hcomp : Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) = Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]
  obtain ⟨θ, hθX0, hθrs, hθa⟩ : ∃ θ : MvPolynomial (Fin (c' + 1)) K →ₐ[K] MvPolynomial (Fin c') K,
      θ (MvPolynomial.X 0) = 1 ∧
      Spec.map (CommRingCat.ofHom θ.toRingHom) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) = 𝟙 _ ∧
      Spec.map (CommRingCat.ofHom θ.toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) = Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) := by
    refine ⟨MvPolynomial.aeval (Fin.cons (1 : MvPolynomial (Fin c') K) (fun j : Fin c' => MvPolynomial.X j)), ?_, ?_, ?_⟩
    · simp
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h : (MvPolynomial.aeval (Fin.cons (1 : MvPolynomial (Fin c') K) (fun j : Fin c' => MvPolynomial.X j)) : MvPolynomial (Fin (c' + 1)) K →ₐ[K] MvPolynomial (Fin c') K).toRingHom.comp (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp
        · intro j; simp
      rw [h, CommRingCat.ofHom_id, Spec.map_id]
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]

  obtain ⟨P', p', q', hP'⟩ : ∃ (P' : Scheme.{u}) (p' : P' ⟶ S) (q' : P' ⟶ Spec (.of (MvPolynomial (Fin c') K))), IsPullback p' q' fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  have hw1 : p ≫ fS = (q ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) := by
    rw [Category.assoc, hcomp]; exact hP.w
  obtain ⟨u, hup, huq⟩ : ∃ u : P ⟶ P', u ≫ p' = p ∧ u ≫ q' = q ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) :=
    ⟨hP'.lift _ _ hw1, hP'.lift_fst _ _ _, hP'.lift_snd _ _ _⟩
  have houter : IsPullback q (u ≫ p') (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) fS := by
    rw [hup, hcomp]; exact hP.flip
  have htop := IsPullback.of_bot houter huq.symm hP'.flip
  have hbundle0 := IsPullback.paste_horiz htop hsq.flip
  rw [← hP'.w] at hbundle0
  have hbundle := hbundle0.flip

  have hw2 : p' ≫ fS = (q' ≫ Spec.map (CommRingCat.ofHom θ.toRingHom)) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    rw [Category.assoc, hθa]; exact hP'.w
  obtain ⟨e1P, he1p, he1q⟩ : ∃ e1P : P' ⟶ P, e1P ≫ p = p' ∧ e1P ≫ q = q' ≫ Spec.map (CommRingCat.ofHom θ.toRingHom) :=
    ⟨hP.lift _ _ hw2, hP.lift_fst _ _ _, hP.lift_snd _ _ _⟩
  have he1u : e1P ≫ u = 𝟙 P' := by
    apply hP'.hom_ext
    · rw [Category.assoc, hup, he1p, Category.id_comp]
    · rw [Category.assoc, huq, ← Category.assoc, he1q, Category.assoc, hθrs, Category.comp_id,
        Category.id_comp]
  have hX0 : ∀ x : P', (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) ∉ (q (e1P x)).asIdeal := by
    intro x hx
    rw [← Scheme.Hom.comp_apply e1P q x, he1q, Scheme.Hom.comp_apply] at hx
    have h1 : θ (MvPolynomial.X 0) ∈ (q' x).asIdeal := hx
    rw [hθX0] at h1
    exact (q' x).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  have hoff : ∀ (y : P) (i : Fin (c' + 1)), (MvPolynomial.X i : MvPolynomial (Fin (c' + 1)) K) ∉ (q y).asIdeal → y ∈ (U : Set P) := by
    intro y i hi
    rw [hU, Set.mem_compl_iff]
    rintro ⟨s, rfl⟩
    apply hi
    rw [← Scheme.Hom.comp_apply z0 q s, hz0q, Scheme.Hom.comp_apply]
    have h0 : (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K) (MvPolynomial.X i) ∈ (fS s).asIdeal := by
      rw [MvPolynomial.constantCoeff_X]; exact Ideal.zero_mem _
    exact h0

  obtain ⟨U'', hU''⟩ : ∃ U'' : P'.Opens, U'' = q' ⁻¹ᵁ (⨆ j : Fin c', PrimeSpectrum.basicOpen (MvPolynomial.X j : MvPolynomial (Fin c') K)) := ⟨_, rfl⟩
  have hmemU'' : ∀ x : P', x ∈ U'' ↔ ∃ j : Fin c', (MvPolynomial.X j : MvPolynomial (Fin c') K) ∉ (q' x).asIdeal := by
    intro x
    rw [hU'', Scheme.Hom.mem_preimage]
    exact (TopologicalSpace.Opens.mem_iSup (s := fun j : Fin c' => PrimeSpectrum.basicOpen (MvPolynomial.X j : MvPolynomial (Fin c') K)) (x := q' x)).trans (exists_congr fun j => PrimeSpectrum.mem_basicOpen _ _)
  have hstar : ∀ (y : P) (j : Fin c'), (MvPolynomial.X j : MvPolynomial (Fin c') K) ∈ (q' (u y)).asIdeal ↔ (MvPolynomial.X j.succ : MvPolynomial (Fin (c' + 1)) K) ∈ (q y).asIdeal := by
    intro y j
    rw [← Scheme.Hom.comp_apply u q' y, huq, Scheme.Hom.comp_apply]
    change (MvPolynomial.X j : MvPolynomial (Fin c') K) ∈ Ideal.comap (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom (q y).asIdeal ↔ _
    rw [Ideal.mem_comap]
    exact Iff.of_eq (congrArg (· ∈ (q y).asIdeal) (MvPolynomial.rename_X (R := K) Fin.succ j))
  have hB : ∀ w : (U : Scheme.{u}), w ∈ wcEtPcCovB q U ↔ ∃ i : Fin c', (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K) ∉ (q (U.ι w)).asIdeal := by
    intro w
    change (U.ι ≫ q) w ∈ (⨆ i : Fin c', PrimeSpectrum.basicOpen (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K)) ↔ _
    exact (TopologicalSpace.Opens.mem_iSup (s := fun i : Fin c' => PrimeSpectrum.basicOpen (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K)) (x := (U.ι ≫ q) w)).trans (exists_congr fun i => (PrimeSpectrum.mem_basicOpen _ _).trans (by rw [Scheme.Hom.comp_apply]))
  have hrange : Set.range ((wcEtPcCovB q U).ι ≫ U.ι) = ((u ⁻¹ᵁ U'' : P.Opens) : Set P) := by
    ext y
    constructor
    · rintro ⟨v, rfl⟩
      have hv : (wcEtPcCovB q U).ι v ∈ wcEtPcCovB q U := by
        rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]; exact ⟨v, rfl⟩
      obtain ⟨i, hi⟩ := (hB _).mp hv
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, hmemU'']
      refine ⟨i, ?_⟩
      rw [hstar, Scheme.Hom.comp_apply]
      exact hi
    · intro hy
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, hmemU''] at hy
      obtain ⟨j, hj⟩ := hy
      rw [hstar] at hj
      have hyU : y ∈ (U : Set P) := hoff y j.succ hj
      rw [← Scheme.Opens.range_ι] at hyU
      obtain ⟨w, rfl⟩ := hyU
      have hwB : w ∈ wcEtPcCovB q U := (hB w).mpr ⟨j, hj⟩
      rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι] at hwB
      obtain ⟨v, rfl⟩ := hwB
      exact ⟨v, Scheme.Hom.comp_apply _ _ _⟩

  have hrange' : Set.range ((wcEtPcCovB q U).ι ≫ U.ι) = Set.range (u ⁻¹ᵁ U'').ι := by
    rw [hrange, Scheme.Opens.range_ι]
  obtain ⟨e, he⟩ : ∃ e : ((wcEtPcCovB q U : (U : Scheme.{u}).Opens) : Scheme.{u}) ≅ ((u ⁻¹ᵁ U'' : P.Opens) : Scheme.{u}), e.hom ≫ (u ⁻¹ᵁ U'').ι = (wcEtPcCovB q U).ι ≫ U.ι :=
    ⟨_, IsOpenImmersion.isoOfRangeEq_hom_fac _ _ hrange'⟩
  have sq1 : IsPullback e.hom ((wcEtPcCovB q U).ι ≫ U.ι) (u ⁻¹ᵁ U'').ι (𝟙 P) :=
    IsPullback.of_horiz_isIso ⟨by rw [he, Category.comp_id]⟩
  have hgB0 := IsPullback.paste_horiz sq1 (isPullback_morphismRestrict u U'')
  rw [Category.id_comp] at hgB0
  obtain ⟨gB, hgB⟩ : ∃ gB : ((wcEtPcCovB q U : (U : Scheme.{u}).Opens) : Scheme.{u}) ⟶ (U'' : Scheme.{u}), IsPullback gB ((wcEtPcCovB q U).ι ≫ U.ι) U''.ι u := ⟨_, hgB0⟩

  have hsub : Set.range e1P ⊆ Set.range U.ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hoff _ 0 (hX0 x)
  obtain ⟨e1, he1⟩ : ∃ e1 : P' ⟶ (U : Scheme.{u}), e1 ≫ U.ι = e1P :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hsub⟩
  have hsub' : Set.range (U''.ι ≫ e1P) ⊆ Set.range ((wcEtPcCovB q U).ι ≫ U.ι) := by
    rintro _ ⟨x, rfl⟩
    rw [hrange, SetLike.mem_coe, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply (U''.ι ≫ e1P) u x,
      Category.assoc, he1u, Category.comp_id, ← SetLike.mem_coe, ← Scheme.Opens.range_ι]
    exact ⟨x, rfl⟩
  obtain ⟨jB, hjB⟩ : ∃ jB : (U'' : Scheme.{u}) ⟶ ((wcEtPcCovB q U : (U : Scheme.{u}).Opens) : Scheme.{u}), jB ≫ (wcEtPcCovB q U).ι ≫ U.ι = U''.ι ≫ e1P :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hsub'⟩
  refine ⟨P', p', q', U'', gB, ((wcEtPcCovB q U).ι ≫ U.ι) ≫ q ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom), jB, e1, hP', IsPullback.paste_vert hgB hbundle, ?_, ?_, ?_⟩
  · rw [← cancel_mono U''.ι, Category.assoc, hgB.w, Category.id_comp, ← Category.assoc jB, hjB,
      Category.assoc, he1u, Category.comp_id]
  · rw [← cancel_mono U.ι]
    simp only [Category.assoc]
    rw [hjB, he1]
  · rw [← Category.assoc, hgB.w]
    simp only [Category.assoc, hup]

theorem wc_et_pc_covA_bundle : ∀ (K : Type u) [Field K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (c' : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K)))) → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)) → 1 ≤ c' → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → IsPullback (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) (Spec.map (CommRingCat.ofHom (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K)))) → ∃ (P0 : Scheme.{u}) (p0 : P0 ⟶ S) (q0 : P0 ⟶ Spec (.of (MvPolynomial (Fin 1) K))) (V0 : P0.Opens) (gA : ((wcEtPcCovA q U : (U : Scheme.{u}).Opens) : Scheme.{u}) ⟶ (V0 : Scheme.{u})) (qA : ((wcEtPcCovA q U : (U : Scheme.{u}).Opens) : Scheme.{u}) ⟶ Spec (.of (MvPolynomial (Fin c') K))) (jA : (V0 : Scheme.{u}) ⟶ ((wcEtPcCovA q U : (U : Scheme.{u}).Opens) : Scheme.{u})) (σB : (V0 : Scheme.{u}) ⟶ ((wcEtPcCovB q U : (U : Scheme.{u}).Opens) : Scheme.{u})), IsPullback p0 q0 fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K)))) ∧ IsPullback gA qA (V0.ι ≫ p0 ≫ fS) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) ∧ jA ≫ gA = 𝟙 _ ∧ jA ≫ (wcEtPcCovA q U).ι = σB ≫ (wcEtPcCovB q U).ι ∧ gA ≫ V0.ι ≫ p0 = (wcEtPcCovA q U).ι ≫ U.ι ≫ p ∧ σB ≫ (wcEtPcCovB q U).ι ≫ U.ι ≫ p = V0.ι ≫ p0 :=
by
  classical
  intro K _ S fS c' P p q z0 hP hz0q hc' U hU hsq

  have hcomp0 : Spec.map (CommRingCat.ofHom (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K))) = Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]
  obtain ⟨φ, hφX, hφr0, hφa⟩ : ∃ φ : MvPolynomial (Fin (c' + 1)) K →ₐ[K] MvPolynomial (Fin 1) K,
      φ (MvPolynomial.X (Fin.succ (⟨0, hc'⟩ : Fin c'))) = 1 ∧
      Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) = 𝟙 _ ∧
      Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) = Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K))) := by
    refine ⟨MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) (fun j : Fin c' => if (j : ℕ) = 0 then (1 : MvPolynomial (Fin 1) K) else 0)), ?_, ?_, ?_⟩
    · rw [MvPolynomial.aeval_X, Fin.cons_succ]
      exact if_pos rfl
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h : (MvPolynomial.aeval (Fin.cons (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) (fun j : Fin c' => if (j : ℕ) = 0 then (1 : MvPolynomial (Fin 1) K) else 0)) : MvPolynomial (Fin (c' + 1)) K →ₐ[K] MvPolynomial (Fin 1) K).toRingHom.comp (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp
        · intro i; rw [Fin.fin_one_eq_zero i]; simp
      rw [h, CommRingCat.ofHom_id, Spec.map_id]
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]

  obtain ⟨P0, p0, q0, hP0⟩ : ∃ (P0 : Scheme.{u}) (p0 : P0 ⟶ S) (q0 : P0 ⟶ Spec (.of (MvPolynomial (Fin 1) K))), IsPullback p0 q0 fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K)))) :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  have hw1 : p ≫ fS = (q ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K))) := by
    rw [Category.assoc, hcomp0]; exact hP.w
  obtain ⟨u0, hup, huq⟩ : ∃ u0 : P ⟶ P0, u0 ≫ p0 = p ∧ u0 ≫ q0 = q ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) :=
    ⟨hP0.lift _ _ hw1, hP0.lift_fst _ _ _, hP0.lift_snd _ _ _⟩
  have houter : IsPullback q (u0 ≫ p0) (Spec.map (CommRingCat.ofHom (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K)))) fS := by
    rw [hup, hcomp0]; exact hP.flip
  have htop := IsPullback.of_bot houter huq.symm hP0.flip
  have hbundle0 := IsPullback.paste_horiz htop hsq
  rw [← hP0.w] at hbundle0
  have hbundle := hbundle0.flip

  have hw2 : p0 ≫ fS = (q0 ≫ Spec.map (CommRingCat.ofHom φ.toRingHom)) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    rw [Category.assoc, hφa]; exact hP0.w
  obtain ⟨σP, hσp, hσq⟩ : ∃ σP : P0 ⟶ P, σP ≫ p = p0 ∧ σP ≫ q = q0 ≫ Spec.map (CommRingCat.ofHom φ.toRingHom) :=
    ⟨hP.lift _ _ hw2, hP.lift_fst _ _ _, hP.lift_snd _ _ _⟩
  have hσu : σP ≫ u0 = 𝟙 P0 := by
    apply hP0.hom_ext
    · rw [Category.assoc, hup, hσp, Category.id_comp]
    · rw [Category.assoc, huq, ← Category.assoc, hσq, Category.assoc, hφr0, Category.comp_id,
        Category.id_comp]
  have hXj : ∀ x : P0, (MvPolynomial.X (Fin.succ (⟨0, hc'⟩ : Fin c')) : MvPolynomial (Fin (c' + 1)) K) ∉ (q (σP x)).asIdeal := by
    intro x hx
    rw [← Scheme.Hom.comp_apply σP q x, hσq, Scheme.Hom.comp_apply] at hx
    have h1 : φ (MvPolynomial.X (Fin.succ (⟨0, hc'⟩ : Fin c'))) ∈ (q0 x).asIdeal := hx
    rw [hφX] at h1
    exact (q0 x).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  have hoff : ∀ (y : P) (i : Fin (c' + 1)), (MvPolynomial.X i : MvPolynomial (Fin (c' + 1)) K) ∉ (q y).asIdeal → y ∈ (U : Set P) := by
    intro y i hi
    rw [hU, Set.mem_compl_iff]
    rintro ⟨s, rfl⟩
    apply hi
    rw [← Scheme.Hom.comp_apply z0 q s, hz0q, Scheme.Hom.comp_apply]
    have h0 : (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K) (MvPolynomial.X i) ∈ (fS s).asIdeal := by
      rw [MvPolynomial.constantCoeff_X]; exact Ideal.zero_mem _
    exact h0

  obtain ⟨V0, hV0⟩ : ∃ V0 : P0.Opens, V0 = q0 ⁻¹ᵁ PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) := ⟨_, rfl⟩
  have hmemV0 : ∀ x : P0, x ∈ V0 ↔ (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) ∉ (q0 x).asIdeal := by
    intro x
    rw [hV0]
    exact Iff.rfl
  have hstar : ∀ y : P, (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) ∈ (q0 (u0 y)).asIdeal ↔ (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) ∈ (q y).asIdeal := by
    intro y
    rw [← Scheme.Hom.comp_apply u0 q0 y, huq, Scheme.Hom.comp_apply]
    change (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) ∈ Ideal.comap (MvPolynomial.rename (fun _ : Fin 1 => (0 : Fin (c' + 1))) : MvPolynomial (Fin 1) K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom (q y).asIdeal ↔ _
    rw [Ideal.mem_comap]
    exact Iff.of_eq (congrArg (· ∈ (q y).asIdeal) (MvPolynomial.rename_X (R := K) (fun _ : Fin 1 => (0 : Fin (c' + 1))) 0))
  have hA : ∀ w : (U : Scheme.{u}), w ∈ wcEtPcCovA q U ↔ (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) ∉ (q (U.ι w)).asIdeal := by
    intro w
    change (U.ι ≫ q) w ∈ PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) ↔ _
    exact (PrimeSpectrum.mem_basicOpen _ _).trans (by rw [Scheme.Hom.comp_apply])
  have hB : ∀ w : (U : Scheme.{u}), w ∈ wcEtPcCovB q U ↔ ∃ i : Fin c', (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K) ∉ (q (U.ι w)).asIdeal := by
    intro w
    change (U.ι ≫ q) w ∈ (⨆ i : Fin c', PrimeSpectrum.basicOpen (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K)) ↔ _
    exact (TopologicalSpace.Opens.mem_iSup (s := fun i : Fin c' => PrimeSpectrum.basicOpen (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K)) (x := (U.ι ≫ q) w)).trans (exists_congr fun i => (PrimeSpectrum.mem_basicOpen _ _).trans (by rw [Scheme.Hom.comp_apply]))
  have hrange : Set.range ((wcEtPcCovA q U).ι ≫ U.ι) = ((u0 ⁻¹ᵁ V0 : P.Opens) : Set P) := by
    ext y
    constructor
    · rintro ⟨v, rfl⟩
      have hv : (wcEtPcCovA q U).ι v ∈ wcEtPcCovA q U := by
        rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]; exact ⟨v, rfl⟩
      have hi := (hA _).mp hv
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, hmemV0, hstar, Scheme.Hom.comp_apply]
      exact hi
    · intro hy
      rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, hmemV0, hstar] at hy
      have hyU : y ∈ (U : Set P) := hoff y 0 hy
      rw [← Scheme.Opens.range_ι] at hyU
      obtain ⟨w, rfl⟩ := hyU
      have hwA : w ∈ wcEtPcCovA q U := (hA w).mpr hy
      rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι] at hwA
      obtain ⟨v, rfl⟩ := hwA
      exact ⟨v, Scheme.Hom.comp_apply _ _ _⟩

  have hrange' : Set.range ((wcEtPcCovA q U).ι ≫ U.ι) = Set.range (u0 ⁻¹ᵁ V0).ι := by
    rw [hrange, Scheme.Opens.range_ι]
  obtain ⟨e, he⟩ : ∃ e : ((wcEtPcCovA q U : (U : Scheme.{u}).Opens) : Scheme.{u}) ≅ ((u0 ⁻¹ᵁ V0 : P.Opens) : Scheme.{u}), e.hom ≫ (u0 ⁻¹ᵁ V0).ι = (wcEtPcCovA q U).ι ≫ U.ι :=
    ⟨_, IsOpenImmersion.isoOfRangeEq_hom_fac _ _ hrange'⟩
  have sq1 : IsPullback e.hom ((wcEtPcCovA q U).ι ≫ U.ι) (u0 ⁻¹ᵁ V0).ι (𝟙 P) :=
    IsPullback.of_horiz_isIso ⟨by rw [he, Category.comp_id]⟩
  have hgA0 := IsPullback.paste_horiz sq1 (isPullback_morphismRestrict u0 V0)
  rw [Category.id_comp] at hgA0
  obtain ⟨gA, hgA⟩ : ∃ gA : ((wcEtPcCovA q U : (U : Scheme.{u}).Opens) : Scheme.{u}) ⟶ (V0 : Scheme.{u}), IsPullback gA ((wcEtPcCovA q U).ι ≫ U.ι) V0.ι u0 := ⟨_, hgA0⟩

  have hsB : Set.range (V0.ι ≫ σP) ⊆ Set.range ((wcEtPcCovB q U).ι ≫ U.ι) := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Hom.comp_apply]
    have hyU : σP (V0.ι x) ∈ (U : Set P) := hoff _ _ (hXj _)
    rw [← Scheme.Opens.range_ι] at hyU
    obtain ⟨w, hw⟩ := hyU
    have hwB : w ∈ wcEtPcCovB q U := (hB w).mpr ⟨⟨0, hc'⟩, by rw [hw]; exact hXj _⟩
    rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι] at hwB
    obtain ⟨v, rfl⟩ := hwB
    exact ⟨v, by rw [Scheme.Hom.comp_apply, hw]⟩
  obtain ⟨σB, hσB⟩ : ∃ σB : (V0 : Scheme.{u}) ⟶ ((wcEtPcCovB q U : (U : Scheme.{u}).Opens) : Scheme.{u}), σB ≫ (wcEtPcCovB q U).ι ≫ U.ι = V0.ι ≫ σP :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hsB⟩
  have hsA : Set.range (V0.ι ≫ σP) ⊆ Set.range ((wcEtPcCovA q U).ι ≫ U.ι) := by
    rintro _ ⟨x, rfl⟩
    rw [hrange, SetLike.mem_coe, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply (V0.ι ≫ σP) u0 x,
      Category.assoc, hσu, Category.comp_id, ← SetLike.mem_coe, ← Scheme.Opens.range_ι]
    exact ⟨x, rfl⟩
  obtain ⟨jA, hjA⟩ : ∃ jA : (V0 : Scheme.{u}) ⟶ ((wcEtPcCovA q U : (U : Scheme.{u}).Opens) : Scheme.{u}), jA ≫ (wcEtPcCovA q U).ι ≫ U.ι = V0.ι ≫ σP :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hsA⟩
  refine ⟨P0, p0, q0, V0, gA, ((wcEtPcCovA q U).ι ≫ U.ι) ≫ q ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom), jA, σB, hP0, IsPullback.paste_vert hgA hbundle, ?_, ?_, ?_, ?_⟩
  · rw [← cancel_mono V0.ι, Category.assoc, hgA.w, Category.id_comp, ← Category.assoc jA, hjA,
      Category.assoc, hσu, Category.comp_id]
  · rw [← cancel_mono U.ι]
    simp only [Category.assoc]
    rw [hjA, hσB]
  · rw [← Category.assoc, hgA.w]
    simp only [Category.assoc, hup]
  · have h6 := hσB =≫ p
    simp only [Category.assoc] at h6
    rw [h6, hσp]

theorem wc_mvpoly_spec_smoothOfRelDim : ∀ (K : Type u) [Field K] (k : ℕ), SmoothOfRelativeDimension k (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin k) K)))) :=
by
  intro K _ k
  have h : Algebra.IsStandardSmoothOfRelativeDimension k K (MvPolynomial (Fin k) K) := by
    have h0 := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K (Fin k)
    rwa [Nat.card_fin] at h0
  exact (HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension k)).mpr
    (RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _
      ((RingHom.isStandardSmoothOfRelativeDimension_algebraMap k).mpr h))

theorem wc_et_punct_cover_restr_dies : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (c' : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)) → 1 ≤ c' → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (n : ℕ), 1 ≤ n → ∀ α : wcEtZModExt (U : Scheme.{u}) ℓ n, (∀ DA : wcEtPullData (wcEtPcCovA q U).ι ℓ, wcEtPcLocDies ((wcEtPcCovA q U).ι ≫ U.ι ≫ p) ℓ n (wcEtPull DA n α)) ∧ (∀ DB : wcEtPullData (wcEtPcCovB q U).ι ℓ, wcEtPcLocDies ((wcEtPcCovB q U).ι ≫ U.ι ≫ p) ℓ n (wcEtPull DB n α)) :=
by
  classical
  intro K _ _ S fS m _ c' P p q z0 hP hz0p hz0q hc' U hU ℓ _ hℓ n hn α

  have G1 : ∀ {T : Scheme.{u}} (E : wcEtPullData (𝟙 T) ℓ) (y : wcEtZModExt T ℓ n),
      wcEtPull E n y = y := by
    intro T E y
    have h1 := wc_et_pull_comp (𝟙 T) (𝟙 T) (𝟙 T) (Category.id_comp _) E E E n y
    have h2 : wcEtPull E n (wcEtPull E n y - y) = 0 := by
      rw [map_sub, ← h1, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective E n _ h2)

  have G2 : ∀ {Y T : Scheme.{u}} (g : Y ⟶ T) (j : T ⟶ Y), j ≫ g = 𝟙 T →
      ∀ (Dg : wcEtPullData g ℓ) (Dj : wcEtPullData j ℓ) (y : wcEtZModExt T ℓ n),
      wcEtPull Dj n (wcEtPull Dg n y) = y := by
    intro Y T g j hj Dg Dj y
    obtain ⟨E⟩ := wc_et_zmod_pull_data_exists (𝟙 T) ℓ
    rw [← wc_et_pull_comp g j (𝟙 T) hj Dg Dj E n y, G1]

  have hsq := wc_mvpoly_fin_succ_spec_isPullback K c'
  obtain ⟨P', p', q', U'', gB, qB, jB, e1, hP', hB, hjB, hjBe, hgB⟩ :=
    wc_et_pc_covB_bundle K S fS c' P p q z0 hP hz0q U hU hsq
  obtain ⟨P0, p0, q0, V0, gA, qA, jA, σB, hP0, hA, hjA, hjAσ, hgA, hσ⟩ :=
    wc_et_pc_covA_bundle K S fS c' P p q z0 hP hz0q hc' U hU hsq

  haveI : SmoothOfRelativeDimension c'
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) :=
    wc_mvpoly_spec_smoothOfRelDim K c'
  haveI : SmoothOfRelativeDimension 1
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K)))) :=
    wc_mvpoly_spec_smoothOfRelDim K 1
  haveI : SmoothOfRelativeDimension c' p' :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension c') hP'.flip inferInstance
  haveI : SmoothOfRelativeDimension 1 p0 :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hP0.flip inferInstance
  haveI hsmB : SmoothOfRelativeDimension (0 + (c' + m)) (U''.ι ≫ p' ≫ fS) := inferInstance
  haveI hsmA : SmoothOfRelativeDimension (0 + (1 + m)) (V0.ι ≫ p0 ≫ fS) := inferInstance

  obtain ⟨De1⟩ := wc_et_zmod_pull_data_exists e1 ℓ
  obtain ⟨Dp'⟩ := wc_et_zmod_pull_data_exists p' ℓ
  obtain ⟨β, hβ⟩ :=
    (wc_et_pull_affine_bundle_bijective K S fS m c' P' p' q' hP' ℓ hℓ Dp' n).2 (wcEtPull De1 n α)

  have claimB : ∀ (DB : wcEtPullData (wcEtPcCovB q U).ι ℓ)
      (Dπ : wcEtPullData ((wcEtPcCovB q U).ι ≫ U.ι ≫ p) ℓ),
      wcEtPull DB n α = wcEtPull Dπ n β := by
    intro DB Dπ
    obtain ⟨DgB⟩ := wc_et_zmod_pull_data_exists gB ℓ
    obtain ⟨DjB⟩ := wc_et_zmod_pull_data_exists jB ℓ
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists (jB ≫ (wcEtPcCovB q U).ι) ℓ
    obtain ⟨DU''⟩ := wc_et_zmod_pull_data_exists U''.ι ℓ
    obtain ⟨Dk2⟩ := wc_et_zmod_pull_data_exists (U''.ι ≫ p') ℓ
    obtain ⟨y, hy⟩ := (wc_et_pull_affine_bundle_bijective K (U'' : Scheme.{u}) (U''.ι ≫ p' ≫ fS)
      (0 + (c' + m)) 1 _ gB qB hB ℓ hℓ DgB n).2 (wcEtPull DB n α)
    have hy2 : y = wcEtPull Dk2 n β := by
      calc y = wcEtPull DjB n (wcEtPull DgB n y) := (G2 gB jB hjB DgB DjB y).symm
        _ = wcEtPull DjB n (wcEtPull DB n α) := by rw [hy]
        _ = wcEtPull Dk n α := (wc_et_pull_comp _ jB _ rfl DB DjB Dk n α).symm
        _ = wcEtPull DU'' n (wcEtPull De1 n α) :=
          wc_et_pull_comp e1 U''.ι _ hjBe.symm De1 DU'' Dk n α
        _ = wcEtPull DU'' n (wcEtPull Dp' n β) := by rw [hβ]
        _ = wcEtPull Dk2 n β := (wc_et_pull_comp p' U''.ι _ rfl Dp' DU'' Dk2 n β).symm
    rw [← hy, hy2]
    exact (wc_et_pull_comp (U''.ι ≫ p') gB _ hgB Dk2 DgB Dπ n β).symm

  have claimA : ∀ (DA : wcEtPullData (wcEtPcCovA q U).ι ℓ)
      (Dπ : wcEtPullData ((wcEtPcCovA q U).ι ≫ U.ι ≫ p) ℓ),
      wcEtPull DA n α = wcEtPull Dπ n β := by
    intro DA Dπ
    obtain ⟨DgA⟩ := wc_et_zmod_pull_data_exists gA ℓ
    obtain ⟨DjA⟩ := wc_et_zmod_pull_data_exists jA ℓ
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists (jA ≫ (wcEtPcCovA q U).ι) ℓ
    obtain ⟨DσB⟩ := wc_et_zmod_pull_data_exists σB ℓ
    obtain ⟨DB⟩ := wc_et_zmod_pull_data_exists (wcEtPcCovB q U).ι ℓ
    obtain ⟨DπB⟩ := wc_et_zmod_pull_data_exists ((wcEtPcCovB q U).ι ≫ U.ι ≫ p) ℓ
    obtain ⟨Dk3⟩ := wc_et_zmod_pull_data_exists (V0.ι ≫ p0) ℓ
    obtain ⟨z, hz⟩ := (wc_et_pull_affine_bundle_bijective K (V0 : Scheme.{u}) (V0.ι ≫ p0 ≫ fS)
      (0 + (1 + m)) c' _ gA qA hA ℓ hℓ DgA n).2 (wcEtPull DA n α)
    have hz2 : z = wcEtPull Dk3 n β := by
      calc z = wcEtPull DjA n (wcEtPull DgA n z) := (G2 gA jA hjA DgA DjA z).symm
        _ = wcEtPull DjA n (wcEtPull DA n α) := by rw [hz]
        _ = wcEtPull Dk n α := (wc_et_pull_comp _ jA _ rfl DA DjA Dk n α).symm
        _ = wcEtPull DσB n (wcEtPull DB n α) :=
          wc_et_pull_comp _ σB _ hjAσ.symm DB DσB Dk n α
        _ = wcEtPull DσB n (wcEtPull DπB n β) := by rw [claimB DB DπB]
        _ = wcEtPull Dk3 n β := (wc_et_pull_comp _ σB _ hσ DπB DσB Dk3 n β).symm
    rw [← hz, hz2]
    exact (wc_et_pull_comp (V0.ι ≫ p0) gA _ hgA Dk3 DgA Dπ n β).symm

  have kill : ∀ {Y : Scheme.{u}} (h : Y ⟶ S) (γ : wcEtZModExt Y ℓ n),
      (∀ Dh : wcEtPullData h ℓ, γ = wcEtPull Dh n β) → wcEtPcLocDies h ℓ n γ := by
    intro Y h γ hγ
    unfold wcEtPcLocDies
    intro x
    obtain ⟨S', s', hs', hx, hkill⟩ :=
      wc_et_zmodext_pos_locally_zero S ℓ (Fact.out : Nat.Prime ℓ).ne_zero n hn β x
    refine ⟨S', s', hs', hx, ?_⟩
    intro Y' h' w' hsq' D'
    obtain ⟨Dh⟩ := wc_et_zmod_pull_data_exists h ℓ
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists (w' ≫ h) ℓ
    obtain ⟨Dh'⟩ := wc_et_zmod_pull_data_exists h' ℓ
    obtain ⟨Ds'⟩ := wc_et_zmod_pull_data_exists s' ℓ
    rw [hγ Dh, ← wc_et_pull_comp h w' _ rfl Dh D' Dk n β,
      wc_et_pull_comp s' h' _ hsq'.w.symm Ds' Dh' Dk n β, hkill Ds', map_zero]
  exact ⟨fun DA => kill _ _ (fun Dh => claimA DA Dh), fun DB => kill _ _ (fun Dh => claimB DB Dh)⟩

theorem wc_ext_truncated_leray_surj : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] (P : D) (A : C) (φ : L.obj P ≅ A) (I : InjectiveResolution A) (N : ℕ), letI := HasExt.standard C; letI := HasExt.standard D; IsIso (adj.unit.app P ≫ R.map φ.hom) → (∀ n : ℕ, 1 ≤ n → n ≤ N → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n)) → ∀ m : ℕ, m ≤ N → Function.Surjective (fun b : Abelian.Ext P P m => (Abelian.Ext.mapExactFunctor L b).comp (Abelian.Ext.mk₀ φ.hom) (add_zero m)) :=
by
  intro C D _ _ _ _ _ L R _ _ adj _ _ P A φ I N
  letI : HasExt C := HasExt.standard C
  letI : HasExt D := HasExt.standard D
  intro hθ hH m hm
  classical
  let K := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  have hKd : ∀ i j, K.d i j = R.map (I.cocomplex.d i j) := fun _ _ => rfl
  have hKX : ∀ (a b : ℕ) (h : a = b), (K.XIsoOfEq h).hom = R.map (I.cocomplex.XIsoOfEq h).hom := by
    intro a b h
    subst h
    simp only [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, CategoryTheory.Functor.map_id]
    rfl
  have hK : ∀ j, Injective (K.X j) := fun j => by
    haveI := I.injective j
    exact Injective.injective_of_adjoint adj (I.cocomplex.X j)
  obtain ⟨J⟩ : Nonempty (InjectiveResolution P) := ⟨InjectiveResolution.of P⟩
  have s1 : ∀ (h : I.ι.f 0 ≫ I.cocomplex.d 0 1 = 0),
      I.extMk (I.ι.f 0) 1 rfl h = Abelian.Ext.mk₀ (𝟙 A) := by
    intro h
    have := HasDerivedCategory.standard C
    have hz : ∀ (K' : CochainComplex C ℤ),
        ((shiftFunctorZero' (CochainComplex C ℤ) (0:ℤ) rfl).inv.app K').f 0 = 𝟙 _ := by
      intro K'
      simp [shiftFunctorZero', CochainComplex.shiftFunctorZero_inv_app_f]
    have key : ∀ hf', (CochainComplex.HomComplex.Cocycle.equivHomShift.symm
        (CochainComplex.HomComplex.Cocycle.fromSingleMk
          (I.ι.f 0 ≫ (I.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv)
          (zero_add _) ((1 : ℕ) : ℤ) (by simp) hf') :
          ShiftedHom ((CochainComplex.singleFunctor C 0).obj
            (((CochainComplex.single₀ C).obj A).X 0)) I.cochainComplex ((0 : ℕ) : ℤ)) =
          ShiftedHom.mk₀ _ rfl I.ι' := by
      intro hf'
      apply HomologicalComplex.from_single_hom_ext
      rw [CochainComplex.HomComplex.Cocycle.equivHomShift_symm_apply]
      simp [ShiftedHom.mk₀,
        CochainComplex.HomComplex.Cochain.rightShift_v _ _ _ _ 0 0 (add_zero 0) 0 (add_zero 0),
        InjectiveResolution.ι'_f_zero, CochainComplex.HomComplex.Cochain.fromSingleMk_v]
      erw [hz]
      simp
    apply Abelian.Ext.ext
    rw [InjectiveResolution.extMk_hom]
    erw [key]
    erw [ShiftedHom.map_mk₀, ShiftedHom.mk₀_comp_mk₀, ShiftedHom.mk₀_comp_mk₀, Abelian.Ext.mk₀_hom]
    congr 1
    simp
  have liftInj : ∀ {X Y Z W : D} (f : X ⟶ Y) (g' : Y ⟶ Z) (hfg : f ≫ g' = 0),
      (ShortComplex.mk f g' hfg).Exact → Injective W → ∀ (u : Y ⟶ W), f ≫ u = 0 →
      ∃ v : Z ⟶ W, g' ≫ v = u := by
    intro X Y Z W f g' hfg hex hW u hu
    haveI : Mono (Limits.cokernel.desc f g' hfg) := hex.mono_cokernelDesc
    refine ⟨Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g' hfg), ?_⟩
    calc g' ≫ Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g' hfg)
        = (Limits.cokernel.π f ≫ Limits.cokernel.desc f g' hfg) ≫
            Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g' hfg) := by
          rw [Limits.cokernel.π_desc]
      _ = u := by rw [Category.assoc, Injective.comp_factorThru, Limits.cokernel.π_desc]
  have hcI : ∀ {Y : C} {k m' : ℕ} (hm' : k + 1 = m') (f₁ f₂ : Y ⟶ I.cocomplex.X k)
      (h₁ : f₁ ≫ I.cocomplex.d k m' = 0) (h₂ : f₂ ≫ I.cocomplex.d k m' = 0),
      f₁ = f₂ → I.extMk f₁ m' hm' h₁ = I.extMk f₂ m' hm' h₂ := by
    intro Y k m' hm' f₁ f₂ h₁ h₂ e
    subst e
    rfl
  have hsq : ∀ r : ℤ, (r = 1 ∨ r = -1) → r * r = 1 := by
    rintro r (rfl | rfl) <;> norm_num
  have hLz : ∀ {Y Z : D} {k : ℕ} (r : ℤ) (x : Abelian.Ext Y Z k),
      Abelian.Ext.mapExactFunctor L (r • x) = r • Abelian.Ext.mapExactFunctor L x := by
    intro Y Z k r x
    have := map_zsmul (L.mapExtAddHom Y Z k) r x
    rwa [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply] at this
  have hzc : ∀ {X Y Z : C} {a b c : ℕ} (r : ℤ) (x : Abelian.Ext X Y a) (y : Abelian.Ext Y Z b)
      (h : a + b = c), (r • x).comp y h = r • x.comp y h := by
    intro X Y Z a b c r x y h
    have := map_zsmul ((Abelian.Ext.bilinearComp X Y Z a b c h).flip y) r x
    simpa only [AddMonoidHom.flip_apply, Abelian.Ext.bilinearComp_apply_apply] using this
  have hφ0z : ∀ k, adj.homEquiv P (I.cocomplex.X k) 0 = 0 := fun k => by
    rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have hhe_sub : ∀ {k : ℕ} (a b : L.obj P ⟶ I.cocomplex.X k),
      adj.homEquiv P _ (a - b) = adj.homEquiv P _ a - adj.homEquiv P _ b := by
    intro k a b
    simp only [Adjunction.homEquiv_unit, Functor.map_sub, Preadditive.comp_sub]
  obtain ⟨ιA, hιA⟩ : ∃ x : A ⟶ I.cocomplex.X 0, x = I.ι.f 0 := ⟨I.ι.f 0, rfl⟩
  have hιA0 : ιA ≫ I.cocomplex.d 0 1 = 0 := by
    rw [hιA]
    exact I.ι_f_zero_comp_complex_d
  haveI hιAm : Mono ιA := by
    rw [hιA]
    first
      | exact (inferInstance : Mono (I.ι.f 0))
      | exact Limits.mono_of_isLimit_fork I.isLimitKernelFork
  obtain ⟨θ, hθe⟩ : ∃ x : P ⟶ R.obj A, x = adj.unit.app P ≫ R.map φ.hom := ⟨_, rfl⟩
  obtain ⟨θinv, hθ1, hθ2⟩ : ∃ y : R.obj A ⟶ P, θ ≫ y = 𝟙 P ∧ y ≫ θ = 𝟙 (R.obj A) := by
    rw [hθe]
    exact hθ.out
  have hg : (φ.hom ≫ ιA) ≫ I.cocomplex.d 0 (0 + 1) = 0 := by
    show (φ.hom ≫ ιA) ≫ I.cocomplex.d 0 1 = 0
    rw [Category.assoc, hιA0, Limits.comp_zero]
  obtain ⟨φ0, hφ0e⟩ : ∃ x : P ⟶ K.X 0, x = adj.homEquiv _ _ (φ.hom ≫ ιA) := ⟨_, rfl⟩
  have hφ0def : φ0 = θ ≫ R.map ιA := by
    rw [hφ0e, hθe, Adjunction.homEquiv_unit, Functor.map_comp, Category.assoc]
  have hφ0 : φ0 ≫ K.d 0 1 = 0 := by
    rw [hφ0def, hKd, Category.assoc, ← Functor.map_comp, hιA0,
      Functor.map_zero, Limits.comp_zero]
  have hmono : Mono φ0 := by
    rw [hφ0def]
    haveI : R.IsRightAdjoint := adj.isRightAdjoint
    haveI : Mono θ := ⟨fun a b hab => by
      have := congrArg (· ≫ θinv) hab
      simpa only [Category.assoc, hθ1, Category.comp_id] using this⟩
    infer_instance
  have hex0 : (ShortComplex.mk φ0 (K.d 0 1) hφ0).Exact := by
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro T x hx
    have hx' : (adj.homEquiv T (I.cocomplex.X 0)).symm x ≫ I.cocomplex.d 0 1 = 0 := by
      rw [← adj.homEquiv_naturality_right_symm]
      have : x ≫ R.map (I.cocomplex.d 0 1) = 0 := hx
      rw [this, Adjunction.homEquiv_counit, Functor.map_zero, Limits.zero_comp]
    obtain ⟨y0, hy⟩ := Limits.KernelFork.IsLimit.lift' I.isLimitKernelFork _ hx'
    obtain ⟨y, hyy⟩ : ∃ y : L.obj T ⟶ A, y = y0 := ⟨y0, rfl⟩
    have hy' : y ≫ ιA = (adj.homEquiv T (I.cocomplex.X 0)).symm x := by
      rw [hyy, hιA]
      exact hy
    refine ⟨T, 𝟙 T, inferInstance, adj.homEquiv _ _ y ≫ θinv, ?_⟩
    have key : (adj.homEquiv T A y ≫ θinv) ≫ φ0 = adj.homEquiv T (I.cocomplex.X 0) (y ≫ ιA) := by
      rw [hφ0def, Category.assoc, ← Category.assoc θinv, hθ2, Category.id_comp,
        adj.homEquiv_naturality_right]
    rw [hy', Equiv.apply_symm_apply] at key
    exact (Category.id_comp _).trans key.symm
  have hexK : ∀ k : ℕ, k + 1 ≤ N →
      (ShortComplex.mk (K.d k (k + 1)) (K.d (k + 1) (k + 1 + 1)) (K.d_comp_d _ _ _)).Exact := by
    intro k hk
    have h1 : K.ExactAt (k + 1) :=
      (HomologicalComplex.exactAt_iff_isZero_homology K (k + 1)).mpr (hH (k + 1) (by omega) hk)
    exact (HomologicalComplex.exactAt_iff' K k (k + 1) (k + 1 + 1) (CochainComplex.prev_nat_succ k)
      (CochainComplex.next ℕ (k + 1))).mp h1
  have chainLift : ∀ (n : ℕ) (φ' : P ⟶ K.X n), φ' ≫ K.d n (n + 1) = 0 →
      ∃ ψ : (k : ℕ) → (J.cocomplex.X k ⟶ K.X (n + k)), J.ι.f 0 ≫ ψ 0 = φ' ∧
        ∀ k, ψ k ≫ K.d (n + k) (n + k + 1) = J.cocomplex.d k (k + 1) ≫ ψ (k + 1) := by
    intro n φ' hφ'
    let T : ℕ → Type _ := fun k => {p : (J.cocomplex.X k ⟶ K.X (n + k)) ×
        (J.cocomplex.X (k + 1) ⟶ K.X (n + (k + 1))) //
      p.1 ≫ K.d (n + k) (n + (k + 1)) = J.cocomplex.d k (k + 1) ≫ p.2}
    have hstep : ∀ (k : ℕ) (p : T k), ∃ c : J.cocomplex.X (k + 2) ⟶ K.X (n + (k + 2)),
        J.cocomplex.d (k + 1) (k + 2) ≫ c = p.1.2 ≫ K.d (n + (k + 1)) (n + (k + 2)) := by
      intro k p
      have hu : J.cocomplex.d k (k + 1) ≫ (p.1.2 ≫ K.d (n + (k + 1)) (n + (k + 2))) = 0 := by
        rw [← Category.assoc, ← p.2, Category.assoc, K.d_comp_d, Limits.comp_zero]
      exact liftInj _ _ _ (J.exact_succ k) (hK _) _ hu
    choose c hc using hstep
    have hbase : ∃ p : T 0, J.ι.f 0 ≫ p.1.1 = φ' := by
      let ι0 : P ⟶ J.cocomplex.X 0 := J.ι.f 0
      haveI : Mono ι0 := (inferInstance : Mono (J.ι.f 0))
      haveI := hK (n + 0)
      let ψ0 : J.cocomplex.X 0 ⟶ K.X (n + 0) := Injective.factorThru φ' ι0
      have hψ0 : ι0 ≫ ψ0 = φ' := Injective.comp_factorThru _ _
      have hu : J.ι.f 0 ≫ (ψ0 ≫ K.d (n + 0) (n + (0 + 1))) = 0 := by
        rw [← Category.assoc]
        exact (congrArg (· ≫ K.d (n + 0) (n + (0 + 1))) hψ0).trans hφ'
      obtain ⟨v, hv⟩ := liftInj _ _ _ J.exact₀ (hK _) _ hu
      exact ⟨⟨(ψ0, v), hv.symm⟩, hψ0⟩
    obtain ⟨p0, hp0⟩ := hbase
    let F : (k : ℕ) → T k := fun k => Nat.rec (motive := T) p0
      (fun k p => ⟨(p.1.2, c k p), (hc k p).symm⟩) k
    refine ⟨fun k => (F k).1.1, hp0, fun k => ?_⟩
    have h1 := (F k).2
    have h2 : (F (k + 1)).1.1 = (F k).1.2 := by
      show (Nat.rec (motive := T) p0 (fun k p => ⟨(p.1.2, c k p), (hc k p).symm⟩) (k + 1)).1.1 = _
      rfl
    show (F k).1.1 ≫ K.d (n + k) (n + (k + 1)) = J.cocomplex.d k (k + 1) ≫ (F (k + 1)).1.1
    rw [h2]
    exact h1
  obtain ⟨ψ, hψ0, hψ⟩ := chainLift 0 φ0 hφ0
  obtain ⟨ψ', hψ'e⟩ : ∃ ψ' : (k : ℕ) → (J.cocomplex.X k ⟶ K.X k),
      ∀ k, ψ' k = ψ k ≫ (K.XIsoOfEq (Nat.zero_add k)).hom := ⟨_, fun _ => rfl⟩
  have hψ'0 : J.ι.f 0 ≫ ψ' 0 = φ0 := by
    rw [hψ'e, ← Category.assoc, hψ0]
    first
      | exact Category.comp_id φ0
      | simp
  have hψ' : ∀ k, ψ' k ≫ K.d k (k + 1) = J.cocomplex.d k (k + 1) ≫ ψ' (k + 1) := by
    intro k
    have e1 : ∀ (a b : ℕ) (h : a = b) (h' : a + 1 = b + 1),
        (K.XIsoOfEq h).hom ≫ K.d b (b + 1) = K.d a (a + 1) ≫ (K.XIsoOfEq h').hom := by
      intro a b h h'
      subst h
      simp
    have e2 : ψ' (k + 1) = ψ (k + 1) ≫ (K.XIsoOfEq (show 0 + k + 1 = k + 1 by omega)).hom :=
      hψ'e (k + 1)
    rw [e2, hψ'e k, Category.assoc, e1 (0 + k) k (Nat.zero_add k) (by omega), ← Category.assoc,
      hψ k, Category.assoc]
  let Tχ : ℕ → Type _ := fun k => {p : (K.X k ⟶ J.cocomplex.X k) ×
      (K.X (k + 1) ⟶ J.cocomplex.X (k + 1)) //
    k ≤ N → p.1 ≫ J.cocomplex.d k (k + 1) = K.d k (k + 1) ≫ p.2}
  have hstepχ : ∀ (k : ℕ) (p : Tχ k), ∃ c : K.X (k + 1 + 1) ⟶ J.cocomplex.X (k + 1 + 1),
      k + 1 ≤ N → p.1.2 ≫ J.cocomplex.d (k + 1) (k + 1 + 1) = K.d (k + 1) (k + 1 + 1) ≫ c := by
    intro k p
    by_cases hk : k + 1 ≤ N
    · have hp : p.1.1 ≫ J.cocomplex.d k (k + 1) = K.d k (k + 1) ≫ p.1.2 := p.2 (by omega)
      have hu : K.d k (k + 1) ≫ (p.1.2 ≫ J.cocomplex.d (k + 1) (k + 1 + 1)) = 0 := by
        rw [← Category.assoc, ← hp, Category.assoc, J.cocomplex.d_comp_d, Limits.comp_zero]
      obtain ⟨v, hv⟩ := liftInj _ _ _ (hexK k hk) (J.injective _) _ hu
      exact ⟨v, fun _ => hv.symm⟩
    · exact ⟨0, fun h => absurd h hk⟩
  choose cχ hcχ using hstepχ
  have hbaseχ : ∃ p : Tχ 0, φ0 ≫ p.1.1 = J.ι.f 0 := by
    let ι0 : P ⟶ J.cocomplex.X 0 := J.ι.f 0
    haveI := J.injective 0
    haveI := hmono
    let χ0 : K.X 0 ⟶ J.cocomplex.X 0 := Injective.factorThru ι0 φ0
    have hχ0 : φ0 ≫ χ0 = ι0 := Injective.comp_factorThru _ _
    have hu : φ0 ≫ (χ0 ≫ J.cocomplex.d 0 1) = 0 := by
      rw [← Category.assoc, hχ0]
      exact J.ι_f_zero_comp_complex_d
    obtain ⟨v, hv⟩ := liftInj _ _ _ hex0 (J.injective _) _ hu
    exact ⟨⟨(χ0, v), fun _ => hv.symm⟩, hχ0⟩
  obtain ⟨q0, hq0⟩ := hbaseχ
  let Fχ : (k : ℕ) → Tχ k := fun k => Nat.rec (motive := Tχ) q0
    (fun k p => ⟨(p.1.2, cχ k p), hcχ k p⟩) k
  obtain ⟨χ, hχe⟩ : ∃ χ : (k : ℕ) → (K.X k ⟶ J.cocomplex.X k), ∀ k, χ k = (Fχ k).1.1 :=
    ⟨_, fun _ => rfl⟩
  have hχ0 : φ0 ≫ χ 0 = J.ι.f 0 := by
    rw [hχe]
    exact hq0
  have hχ : ∀ k, k ≤ N → χ k ≫ J.cocomplex.d k (k + 1) = K.d k (k + 1) ≫ χ (k + 1) := by
    intro k hk
    have h2 : (Fχ (k + 1)).1.1 = (Fχ k).1.2 := by
      show (Nat.rec (motive := Tχ) q0 (fun k p => ⟨(p.1.2, cχ k p), hcχ k p⟩) (k + 1)).1.1 = _
      rfl
    rw [hχe, hχe, h2]
    exact (Fχ k).2 hk
  obtain ⟨u, hue⟩ : ∃ u : (k : ℕ) → (K.X k ⟶ K.X k), ∀ k, u k = 𝟙 _ - χ k ≫ ψ' k :=
    ⟨_, fun _ => rfl⟩
  have hφχψ : φ0 ≫ χ 0 ≫ ψ' 0 = φ0 := by
    rw [← Category.assoc, hχ0]
    exact hψ'0
  have hu0 : φ0 ≫ u 0 = 0 := by
    rw [hue 0, Preadditive.comp_sub, Category.comp_id, hφχψ, sub_self]
  have hucomm : ∀ k, k ≤ N → u k ≫ K.d k (k + 1) = K.d k (k + 1) ≫ u (k + 1) := by
    intro k hk
    rw [hue, hue, Preadditive.sub_comp, Preadditive.comp_sub, Category.id_comp, Category.comp_id,
      Category.assoc, hψ' k, ← Category.assoc (χ k), hχ k hk, Category.assoc]
  let Tσ : ℕ → Type _ := fun k => {p : (K.X (k + 1) ⟶ K.X k) × (K.X (k + 1 + 1) ⟶ K.X (k + 1)) //
    k + 1 ≤ N → K.d (k + 1) (k + 1 + 1) ≫ p.2 = u (k + 1) - p.1 ≫ K.d k (k + 1)}
  have hstepσ : ∀ (k : ℕ) (p : Tσ k), ∃ c : K.X (k + 1 + 1 + 1) ⟶ K.X (k + 1 + 1),
      k + 1 + 1 ≤ N → K.d (k + 1 + 1) (k + 1 + 1 + 1) ≫ c =
        u (k + 1 + 1) - p.1.2 ≫ K.d (k + 1) (k + 1 + 1) := by
    intro k p
    by_cases hk : k + 1 + 1 ≤ N
    · have hp : K.d (k + 1) (k + 1 + 1) ≫ p.1.2 = u (k + 1) - p.1.1 ≫ K.d k (k + 1) :=
        p.2 (by omega)
      have hc1 : u (k + 1) ≫ K.d (k + 1) (k + 1 + 1) = K.d (k + 1) (k + 1 + 1) ≫ u (k + 1 + 1) :=
        hucomm (k + 1) (by omega)
      have hu : K.d (k + 1) (k + 1 + 1) ≫ (u (k + 1 + 1) - p.1.2 ≫ K.d (k + 1) (k + 1 + 1)) = 0 := by
        rw [Preadditive.comp_sub, ← Category.assoc, hp, Preadditive.sub_comp, Category.assoc,
          K.d_comp_d, Limits.comp_zero, sub_zero, hc1, sub_self]
      obtain ⟨v, hv⟩ := liftInj _ _ _ (hexK (k + 1) hk) (hK _) _ hu
      exact ⟨v, fun _ => hv⟩
    · exact ⟨0, fun h => absurd h hk⟩
  choose cσ hcσ using hstepσ
  have hbaseσ : ∃ p : Tσ 0, K.d 0 1 ≫ p.1.1 = u 0 := by
    obtain ⟨σ0, hσ0⟩ := liftInj _ _ _ hex0 (hK 0) (u 0) hu0
    by_cases h1 : 1 ≤ N
    · have hc0 : u 0 ≫ K.d 0 1 = K.d 0 1 ≫ u 1 := hucomm 0 (by omega)
      have hv : K.d 0 1 ≫ (u 1 - σ0 ≫ K.d 0 1) = 0 := by
        rw [Preadditive.comp_sub, ← Category.assoc, hσ0, hc0, sub_self]
      obtain ⟨σ1, hσ1⟩ := liftInj _ _ _ (hexK 0 (by omega)) (hK 1) _ hv
      exact ⟨⟨(σ0, σ1), fun _ => hσ1⟩, hσ0⟩
    · exact ⟨⟨(σ0, 0), fun h => absurd h (by omega)⟩, hσ0⟩
  obtain ⟨r0, hr0⟩ := hbaseσ
  let Fσ : (k : ℕ) → Tσ k := fun k => Nat.rec (motive := Tσ) r0
    (fun k p => ⟨(p.1.2, cσ k p), hcσ k p⟩) k
  obtain ⟨σ, hσe⟩ : ∃ σ : (k : ℕ) → (K.X (k + 1) ⟶ K.X k), ∀ k, σ k = (Fσ k).1.1 :=
    ⟨_, fun _ => rfl⟩
  have hσ0 : K.d 0 1 ≫ σ 0 = u 0 := by
    rw [hσe]
    exact hr0
  have hσs : ∀ k, k + 1 ≤ N →
      K.d (k + 1) (k + 1 + 1) ≫ σ (k + 1) = u (k + 1) - σ k ≫ K.d k (k + 1) := by
    intro k hk
    have h2 : (Fσ (k + 1)).1.1 = (Fσ k).1.2 := by
      show (Nat.rec (motive := Tσ) r0 (fun k p => ⟨(p.1.2, cσ k p), hcσ k p⟩) (k + 1)).1.1 = _
      rfl
    rw [hσe, hσe, h2]
    exact (Fσ k).2 hk
  have hzeroI : ∀ (f : L.obj P ⟶ I.cocomplex.X m) (hf₁ : f ≫ I.cocomplex.d m (m + 1) = 0)
      (e : L.obj P ⟶ I.cocomplex.X (m - 1)), e ≫ I.cocomplex.d (m - 1) m = f →
      I.extMk f (m + 1) rfl hf₁ = 0 := by
    intro f hf₁ e he
    rcases Nat.eq_zero_or_pos m with h0 | hpos
    · have hd : I.cocomplex.d (m - 1) m = 0 :=
        I.cocomplex.shape _ _ (by simp only [ComplexShape.up_Rel]; omega)
      rw [hd, Limits.comp_zero] at he
      subst he
      exact I.extMk_zero _ _
    · exact (I.extMk_eq_zero_iff f (m + 1) rfl hf₁ (m - 1) (by omega)).mpr ⟨e, he⟩
  have hg' : (φ.hom ≫ I.ι.f 0) ≫ I.cocomplex.d 0 (0 + 1) = 0 := by
    rw [← hιA]
    exact hg
  have hφ0e' : φ0 = adj.homEquiv _ _ (φ.hom ≫ I.ι.f 0) := by
    rw [hφ0e, hιA]
  have hcls : I.extMk (φ.hom ≫ I.ι.f 0) (0 + 1) rfl hg' = Abelian.Ext.mk₀ φ.hom := by
    have := InjectiveResolution.mk₀_comp_extMk I (I.ι.f 0) 1 rfl I.ι_f_zero_comp_complex_d φ.hom
    rw [s1 I.ι_f_zero_comp_complex_d] at this
    exact this.symm.trans (Abelian.Ext.comp_mk₀_id _)
  obtain ⟨s, hs, H⟩ := wc_lh_extMk_comp_transport L R adj P A I J 0 (φ.hom ≫ I.ι.f 0) hg' ψ
    (hψ0.trans hφ0e') hψ m
  intro z
  obtain ⟨f, hf0, rfl⟩ := I.extMk_surjective z (m + 1) rfl
  have hc : adj.homEquiv _ _ f ≫ K.d m (m + 1) = 0 := by
    rw [hKd, ← adj.homEquiv_naturality_right, hf0, hφ0z]
  obtain ⟨β, hβdef⟩ : ∃ β : P ⟶ J.cocomplex.X m, β = adj.homEquiv _ _ f ≫ χ m := ⟨_, rfl⟩
  have hβ : β ≫ J.cocomplex.d m (m + 1) = 0 := by
    rw [hβdef, Category.assoc, hχ m hm, ← Category.assoc, hc, Limits.zero_comp]
  obtain ⟨T, hTdef⟩ : ∃ T : L.obj P ⟶ I.cocomplex.X m,
      T = (adj.homEquiv _ _).symm (β ≫ ψ m) ≫ (I.cocomplex.XIsoOfEq (Nat.zero_add m)).hom :=
    ⟨_, rfl⟩
  have hTe : adj.homEquiv _ _ T = β ≫ ψ' m := by
    rw [hTdef, adj.homEquiv_naturality_right, Equiv.apply_symm_apply, hψ'e, hKX, Category.assoc]
  have hbd : ∃ e : P ⟶ K.X (m - 1), adj.homEquiv _ _ f ≫ u m = e ≫ K.d (m - 1) m := by
    rcases Nat.eq_zero_or_pos m with h0 | hpos
    · subst h0
      refine ⟨0, ?_⟩
      have hc0 : adj.homEquiv _ _ f ≫ K.d 0 1 = 0 := hc
      rw [Limits.zero_comp, ← hσ0, ← Category.assoc, hc0, Limits.zero_comp]
    · obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
      refine ⟨adj.homEquiv _ _ f ≫ σ k, ?_⟩
      have hs' := hσs k hm
      have hu' : u (k + 1) = K.d (k + 1) (k + 1 + 1) ≫ σ (k + 1) + σ k ≫ K.d k (k + 1) := by
        rw [hs', sub_add_cancel]
      rw [hu', Preadditive.comp_add, ← Category.assoc, hc, Limits.zero_comp, zero_add]
      exact (Category.assoc _ _ _).symm
  obtain ⟨e, he⟩ := hbd
  have hfT : f - T = (adj.homEquiv _ _).symm e ≫ I.cocomplex.d (m - 1) m := by
    rw [← adj.homEquiv_naturality_right_symm]
    apply (adj.homEquiv P (I.cocomplex.X m)).injective
    rw [Equiv.apply_symm_apply, ← hKd, ← he, hhe_sub, hTe, hue, Preadditive.comp_sub, hβdef,
      Category.assoc]
    congr 1
    exact (Category.comp_id _).symm
  have hT : T ≫ I.cocomplex.d m (m + 1) = 0 := by
    rw [← sub_sub_cancel f T, hfT, Preadditive.sub_comp, hf0, Category.assoc,
      HomologicalComplex.d_comp_d, Limits.comp_zero, sub_zero]
  have hTI : ((adj.homEquiv _ _).symm (β ≫ ψ m) ≫ (I.cocomplex.XIsoOfEq (Nat.zero_add m)).hom) ≫
      I.cocomplex.d m (m + 1) = 0 := by
    rw [← hTdef]
    exact hT
  have hext' : I.extMk f (m + 1) rfl hf0 = I.extMk T (m + 1) rfl hT := by
    rw [← sub_eq_zero, I.sub_extMk]
    exact hzeroI _ _ _ hfT.symm
  have hext : I.extMk f (m + 1) rfl hf0 = I.extMk ((adj.homEquiv _ _).symm (β ≫ ψ m) ≫
      (I.cocomplex.XIsoOfEq (Nat.zero_add m)).hom) (m + 1) rfl hTI :=
    hext'.trans (hcI rfl _ _ _ _ hTdef)
  have H1 := H m (add_zero m) (Nat.zero_add m) β hβ hTI
  refine ⟨s • J.extMk β (m + 1) rfl hβ, ?_⟩
  show (Abelian.Ext.mapExactFunctor L (s • J.extMk β (m + 1) rfl hβ)).comp
    (Abelian.Ext.mk₀ φ.hom) (add_zero m) = I.extMk f (m + 1) rfl hf0
  rw [hLz, hzc, ← hcls, H1, smul_smul, hsq s hs, one_smul]
  exact hext.symm

theorem wc_et_gm_push_unit_iso : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ), IsIso (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing X ℓ)) ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _ D.cont D.φ).map D.μ.hom) :=
by
  classical
  intro K _ X fX ℓ _ D

  obtain ⟨τ, hτ⟩ : ∃ τ : X ⟶ Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))),
      τ ≫ Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) = 𝟙 X := by
    let e : LaurentPolynomial K →ₐ[K] K := AddMonoidAlgebra.lift K K ℤ 1
    have he : (e : LaurentPolynomial K →+* K).comp (algebraMap K (LaurentPolynomial K)) =
        RingHom.id K := by
      rw [AlgHom.comp_algebraMap, Algebra.algebraMap_self]
    have hpt : Spec.map (CommRingCat.ofHom (e : LaurentPolynomial K →+* K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) = 𝟙 _ := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, he]
      simp
    exact ⟨Limits.pullback.lift (𝟙 X)
      (fX ≫ Spec.map (CommRingCat.ofHom (e : LaurentPolynomial K →+* K)))
      (by rw [Category.id_comp, Category.assoc, hpt, Category.comp_id]),
      Limits.pullback.lift_fst _ _ _⟩

  have hfib : ∀ (V : Scheme.{u}) (g : V ⟶ X) (A : Type (u+1))
      (h : LocallyConstant ↥(Limits.pullback g (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) A)
      (x y : ↥(Limits.pullback g (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))),
      Limits.pullback.fst g (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) x =
      Limits.pullback.fst g (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) y → h x = h y := by
    intro V g A h x y hxy
    obtain ⟨v, hv⟩ : ∃ v, Limits.pullback.fst g (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) x = v := ⟨_, rfl⟩
    have hx : x ∈ Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst g (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))) := by
      rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecResidueField]
      exact hv
    have hy : y ∈ Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst g (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))) := by
      rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecResidueField]
      exact hxy.symm.trans hv
    let φ : CommRingCat.of K ⟶ V.residueField v :=
      Spec.preimage ((V.fromSpecResidueField v ≫ g) ≫ fX)
    letI : Algebra K (V.residueField v) := φ.hom.toAlgebra
    have hφ : Spec.map (CommRingCat.ofHom (algebraMap K (V.residueField v))) =
        (V.fromSpecResidueField v ≫ g) ≫ fX := by
      show Spec.map (CommRingCat.ofHom φ.hom) = _
      rw [CommRingCat.ofHom_hom]
      exact Spec.map_preimage _
    haveI : IsDomain (TensorProduct K (V.residueField v) (LaurentPolynomial K)) :=
      MulEquiv.isDomain (AddMonoidAlgebra (V.residueField v) ℤ)
        (AddMonoidAlgebra.scalarTensorEquiv K (M := ℤ) (V.residueField v)).toRingEquiv.toMulEquiv
    let eG : Limits.pullback (V.fromSpecResidueField v) (Limits.pullback.fst g
        (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) ≅
        Spec (.of (TensorProduct K (V.residueField v) (LaurentPolynomial K))) :=
      Limits.pullbackRightPullbackFstIso g (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))
          (V.fromSpecResidueField v) ≪≫
        Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))
          (V.fromSpecResidueField v ≫ g) ≪≫
        Limits.pullback.congrHom hφ.symm rfl ≪≫
        pullbackSpecIso K (V.residueField v) (LaurentPolynomial K)
    haveI : IrreducibleSpace ↥(Limits.pullback (V.fromSpecResidueField v) (Limits.pullback.fst g
        (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))) :=
      Function.Surjective.irreducibleSpace eG.inv.continuous
        (fun z => ⟨eG.hom z, Scheme.hom_inv_apply eG z⟩)
    have hirr := (IrreducibleSpace.isIrreducible_univ ↥(Limits.pullback (V.fromSpecResidueField v)
        (Limits.pullback.fst g (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))))).isPreirreducible.image
      _ (Scheme.Hom.continuous (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst g (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))))).continuousOn
    rw [Set.image_univ] at hirr
    exact h.isLocallyConstant.apply_eq_of_isPreconnected hirr.isPreconnected hx hy

  have hsec : ∀ (V : X.Etale), ∃ σ : V.left ⟶ Limits.pullback V.hom (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))),
      σ ≫ Limits.pullback.fst V.hom (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) = 𝟙 V.left := by
    intro V
    exact ⟨Limits.pullback.lift (𝟙 V.left) (V.hom ≫ τ)
      (by rw [Category.id_comp, Category.assoc, hτ]; exact (Category.comp_id _).symm),
      Limits.pullback.lift_fst _ _ _⟩
  have hbij : ∀ V : X.Etale, Function.Bijective (LocallyConstant.comapAddMonoidHom
      ⟨Limits.pullback.fst V.hom (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))),
        (Limits.pullback.fst V.hom (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).continuous⟩ :
      LocallyConstant V.left (ULift.{u+1} (ZMod ℓ)) →+
        LocallyConstant ↥(Limits.pullback V.hom (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) (ULift.{u+1} (ZMod ℓ))) := by
    intro V
    obtain ⟨σ, hσ⟩ := hsec V
    have hcσ : ∀ v, Limits.pullback.fst V.hom (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) (σ v) = v := by
      intro v
      rw [← Scheme.Hom.comp_apply, hσ]
      rfl
    refine ⟨fun a b hab => LocallyConstant.comap_injective _ (fun v => ⟨σ v, hcσ v⟩) hab,
      fun h => ⟨h.comap ⟨σ, σ.continuous⟩, ?_⟩⟩
    apply LocallyConstant.ext
    intro w
    show h (σ (Limits.pullback.fst V.hom (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) w)) = h w
    exact hfib V.left V.hom _ h _ _ (hcσ _)
  let Ψ : wcEtLC X (ULift.{u+1} (ZMod ℓ)) ≅ wcLCPb (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) (ULift.{u+1} (ZMod ℓ)) :=
    NatIso.ofComponents (fun V => (AddEquiv.ofBijective _ (hbij V.unop)).toAddCommGrpIso) (by
      intro V W g
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro h
      apply LocallyConstant.ext
      intro w
      have key : ((wcEtBaseChange (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).map g.unop).left ≫
          Limits.pullback.fst V.unop.hom (Limits.pullback.fst fX
            (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) =
          Limits.pullback.fst W.unop.hom (Limits.pullback.fst fX
            (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ≫ g.unop.left := by
        exact Limits.pullback.lift_fst _ _ _
      let h' : LocallyConstant V.unop.left (ULift.{u+1} (ZMod ℓ)) := h
      have key2 := congrArg (fun k => h' (k w)) key
      exact key2.symm)
  obtain ⟨ea⟩ := wc_et_push_const_lc_iso (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) (ULift.{u+1} (ZMod ℓ))
    (wc_et_lc_isSheaf _ _) (wc_et_const_to_lc_locBij _ _)
  obtain ⟨φS, hinjS, hsurjS⟩ := wc_et_const_to_lc_locBij X (ULift.{u+1} (ZMod ℓ))
  have hW : (Scheme.smallEtaleTopology X).W φS :=
    (GrothendieckTopology.W_iff_isLocallyBijective (Scheme.smallEtaleTopology X) φS).mpr
      ⟨hinjS, hsurjS⟩
  have hI : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φS) :=
    (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology X) φS).mp hW
  let e1 := @asIso _ _ _ _ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φS) hI
  let E3 : (wcEtPush (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).obj
      ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) ≅
      (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) :=
    ea.symm ≪≫ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).mapIso Ψ).symm ≪≫
      e1.symm

  haveI := D.cont
  have s4 : ∀ (L : SheafOfModules.{u+1} (wcEtZModRing X ℓ) ⥤
        SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ))
      (R : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ) ⥤
        SheafOfModules.{u+1} (wcEtZModRing X ℓ))
      (adj : L ⊣ R) (Y : SheafOfModules.{u+1} (wcEtZModRing X ℓ))
      (Z : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ))
      (μ : L.obj Y ≅ Z) (ψ : R.obj Z ≅ Y),
      (∀ a b : Y ⟶ Y, a ≫ b = b ≫ a) → IsIso (adj.unit.app Y ≫ R.map μ.hom) := by
    intro L R adj Y Z μ ψ hcomm
    obtain ⟨g, hg⟩ := (adj.homEquiv Y Z).surjective ψ.inv
    have h1 : adj.unit.app Y ≫ R.map μ.hom ≫ R.map (μ.inv ≫ g) = ψ.inv := by
      rw [← R.map_comp, Iso.hom_inv_id_assoc, ← hg, Adjunction.homEquiv_unit]
    have hts : (adj.unit.app Y ≫ R.map μ.hom ≫ ψ.hom) ≫
        (ψ.inv ≫ R.map (μ.inv ≫ g) ≫ ψ.hom) = 𝟙 Y := by
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      rw [reassoc_of% h1, Iso.inv_hom_id]
    have hst := (hcomm _ _).symm.trans hts
    haveI : IsIso (adj.unit.app Y ≫ R.map μ.hom ≫ ψ.hom) := ⟨⟨_, hts, hst⟩⟩
    have e1 : adj.unit.app Y ≫ R.map μ.hom =
        (adj.unit.app Y ≫ R.map μ.hom ≫ ψ.hom) ≫ ψ.inv := by
      simp
    rw [e1]
    infer_instance

  have s5 : ∀ (V : (X.Etale)ᵒᵖ) (x y : ↑((wcEtZModRing X ℓ).obj.obj V)), x * y = y * x := by
    obtain ⟨α, _, hsurj, _⟩ := wc_et_zmod_ring_locbij X ℓ
    intro V x y
    have hsep := (wcEtZModRing X ℓ).isSeparated
    apply hsep (Opposite.unop V) _ ((Scheme.smallEtaleTopology X).intersection_covering
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X) α x)
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X) α y))
    intro W g hg
    obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := hg
    rw [map_mul, map_mul, ← ha, ← hb, ← map_mul, ← map_mul]
    congr 1
    exact @mul_comm (ULift.{u+1} (ZMod ℓ)) _ a b
  have s6 : ∀ (a b : SheafOfModules.unit (wcEtZModRing X ℓ) ⟶ SheafOfModules.unit (wcEtZModRing X ℓ)),
      a ≫ b = b ≫ a := by
    intro a b
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W0
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    let fa : ↑((wcEtZModRing X ℓ).obj.obj W0) →ₗ[↑((wcEtZModRing X ℓ).obj.obj W0)]
        ↑((wcEtZModRing X ℓ).obj.obj W0) := (a.val.app W0).hom
    let fb : ↑((wcEtZModRing X ℓ).obj.obj W0) →ₗ[↑((wcEtZModRing X ℓ).obj.obj W0)]
        ↑((wcEtZModRing X ℓ).obj.obj W0) := (b.val.app W0).hom
    have key : ∀ (g : ↑((wcEtZModRing X ℓ).obj.obj W0) →ₗ[↑((wcEtZModRing X ℓ).obj.obj W0)]
        ↑((wcEtZModRing X ℓ).obj.obj W0)) (y : ↑((wcEtZModRing X ℓ).obj.obj W0)),
        g y = y * g 1 := by
      intro g y
      have h2 := g.map_smul y 1
      rw [smul_eq_mul, mul_one] at h2
      rw [h2, smul_eq_mul]
    revert x
    change ∀ x : ↑((wcEtZModRing X ℓ).obj.obj W0), fb (fa x) = fa (fb x)
    intro x
    rw [key fb (fa x), key fa x, key fa (fb x), key fb x, mul_assoc, mul_assoc, s5 W0 (fa 1)]

  obtain ⟨E1⟩ := wc_et_toSheaf_pushforward_iso (Limits.pullback.fst fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ D
  obtain ⟨E2⟩ := wc_et_zmod_unit_toSheaf_iso (Limits.pullback fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ
  obtain ⟨E4⟩ := wc_et_zmod_unit_toSheaf_iso X ℓ
  obtain ⟨α, hinj, hsurj, _⟩ := wc_et_zmod_ring_locbij X ℓ
  haveI : (SheafOfModules.toSheaf (wcEtZModRing X ℓ)).Full :=
    (sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology X) (wcEtZModRing X ℓ) ℓ
      α hinj hsurj).1
  let Θ : (SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ))) ≅
      (SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj (SheafOfModules.unit (wcEtZModRing X ℓ)) :=
    E1.app (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ)) ≪≫
      (wcEtPush (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).mapIso E2 ≪≫
      E3 ≪≫ E4.symm
  let ψ := (SheafOfModules.toSheaf (wcEtZModRing X ℓ)).preimageIso Θ
  exact s4 D.Φ _ D.adj _ _ D.μ ψ s6

theorem wc_lh_degree_zero_isIso : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) (P : D) (A : C) (φ : L.obj P ≅ A) (I : InjectiveResolution A) (hf : adj.homEquiv _ _ (φ.hom ≫ I.ι.f 0) ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d 0 (0 + 1) = 0), IsIso (adj.unit.app P ≫ R.map φ.hom) → IsIso (Limits.Sigma.desc (fun _ : Fin 1 => ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (adj.homEquiv _ _ (φ.hom ≫ I.ι.f 0)) (0 + 1) (by simp) hf ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ 0)) :=
by
  intro C D _ _ _ _ L R _ adj P A φ I hf hu
  haveI := adj.isRightAdjoint
  let K := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  let ι : A ⟶ I.cocomplex.X 0 := I.ι.f 0
  have hιd : ι ≫ I.cocomplex.d 0 1 = 0 := I.ι_f_zero_comp_complex_d
  haveI hιm : Mono ι := (inferInstance : Mono (I.ι.f 0))

  have hι : R.map ι ≫ K.d 0 (0 + 1) = 0 := by
    show R.map ι ≫ R.map (I.cocomplex.d 0 1) = 0
    rw [← Functor.map_comp, hιd, Functor.map_zero]

  let e : R.obj A ⟶ K.cycles 0 := K.liftCycles (R.map ι) (0 + 1) (by simp) hι
  have he : e ≫ K.iCycles 0 = R.map ι := HomologicalComplex.liftCycles_i _ _ _ _ _

  let t := K.iCycles 0
  let tb : L.obj (K.cycles 0) ⟶ I.cocomplex.X 0 := (adj.homEquiv _ _).symm t
  have htb : tb ≫ I.cocomplex.d 0 1 = 0 := by
    have h0 : t ≫ R.map (I.cocomplex.d 0 1) = 0 := K.iCycles_d 0 1
    show (adj.homEquiv _ _).symm t ≫ I.cocomplex.d 0 1 = 0
    rw [← Adjunction.homEquiv_naturality_right_symm, h0, Equiv.symm_apply_eq,
      Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  obtain ⟨l, hl⟩ : ∃ l : L.obj (K.cycles 0) ⟶ A, l ≫ ι = tb :=
    ⟨(Limits.KernelFork.IsLimit.lift' I.isLimitKernelFork tb htb).1,
      (Limits.KernelFork.IsLimit.lift' I.isLimitKernelFork tb htb).2⟩
  let s : K.cycles 0 ⟶ R.obj A := adj.homEquiv _ _ l
  have hs : s ≫ R.map ι = t := by
    show adj.homEquiv _ _ l ≫ R.map ι = t
    rw [← Adjunction.homEquiv_naturality_right, hl]
    exact Equiv.apply_symm_apply _ _
  haveI : Mono (R.map ι) := inferInstance
  haveI : IsIso e := by
    refine ⟨⟨s, ?_, ?_⟩⟩
    · apply (cancel_mono (R.map ι)).mp
      rw [Category.assoc, hs, Category.id_comp]
      exact he
    · apply (cancel_mono (K.iCycles 0)).mp
      rw [Category.assoc, he, Category.id_comp]
      exact hs
  have hg : K.liftCycles (adj.homEquiv _ _ (φ.hom ≫ I.ι.f 0)) (0 + 1) (by simp) hf =
      (adj.unit.app P ≫ R.map φ.hom) ≫ e := by
    apply (cancel_mono (K.iCycles 0)).mp
    rw [HomologicalComplex.liftCycles_i, Category.assoc, he, Adjunction.homEquiv_unit]
    exact (congrArg (fun z => adj.unit.app P ≫ z) (R.map_comp φ.hom ι)).trans
      (Category.assoc _ _ _).symm
  haveI := CochainComplex.isIso_homologyπ₀ K
  have hfi : IsIso (K.liftCycles (adj.homEquiv _ _ (φ.hom ≫ I.ι.f 0)) (0 + 1) (by simp) hf ≫
      K.homologyπ 0) := by
    rw [hg]
    infer_instance
  haveI hj : IsIso (Limits.Sigma.ι (fun _ : Fin 1 => P) 0) := by
    rw [show Limits.Sigma.ι (fun _ : Fin 1 => P) 0 =
      (Limits.coproductUniqueIso (fun _ : Fin 1 => P)).inv from
        (Limits.coproductUniqueIso_inv _).symm]
    infer_instance
  haveI : IsIso (Limits.Sigma.ι (fun _ : Fin 1 => P) 0 ≫ Limits.Sigma.desc (fun _ : Fin 1 =>
      K.liftCycles (adj.homEquiv _ _ (φ.hom ≫ I.ι.f 0)) (0 + 1) (by simp) hf ≫
        K.homologyπ 0)) := by
    rw [Limits.Sigma.ι_comp_desc]
    exact hfi
  exact IsIso.of_isIso_comp_left (Limits.Sigma.ι (fun _ : Fin 1 => P) 0) _

theorem wc_et_module_push_homology_toSheaf_iso : ∀ {T Q : Scheme.{u}} (r : Q ⟶ T) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData r ℓ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Q ℓ))) (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (n : ℕ), letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; Nonempty ((SheafOfModules.toSheaf (wcEtZModRing T ℓ)).obj ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) ≅ (((wcEtPush r).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology n) :=
by
  classical
  intro T Q r ℓ _ D I J n
  letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives Q
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives T
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Q) (wcEtZModRing Q ℓ)
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology T) (wcEtZModRing T ℓ)
  haveI hIRQ : HasInjectiveResolutions (SheafOfModules.{u+1} (wcEtZModRing Q ℓ)) :=
    ⟨fun Z => ⟨⟨InjectiveResolution.of Z⟩⟩⟩
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Q)
    (wcEtZModRing Q ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology T)
    (wcEtZModRing T ℓ)
  have hn : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos

  have s1 : ∀ (X : Scheme.{u}) (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      [Injective E], Epi (ℓ • 𝟙 E) := by
    intro X E _
    have hP : Injective ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) :=
      Injective.injective_of_adjoint
        (sheafificationAdjunction (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) E
    have hdiv : ∀ (U : X.Etale)
        (s : ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E).obj
          (Opposite.op U)), ∃ t, ℓ • t = s := by
      intro U s
      let P := (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E
      let G : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
        yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let φ : G ⟶ P :=
        { app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun f : ULift.{u+1} (V.unop ⟶ U) => (P.map f.down.op).hom s))
          naturality := by
            intro V W h
            apply AddCommGrpCat.hom_ext
            apply FreeAbelianGroup.lift_ext
            intro f
            show (FreeAbelianGroup.lift (fun f' : ULift.{u+1} (W.unop ⟶ U) => (P.map f'.down.op).hom s))
                ((G.map h).hom (FreeAbelianGroup.of f)) =
              (P.map h).hom ((FreeAbelianGroup.lift
                (fun f' : ULift.{u+1} (V.unop ⟶ U) => (P.map f'.down.op).hom s)) (FreeAbelianGroup.of f))
            have hG : (G.map h).hom (FreeAbelianGroup.of f) =
                FreeAbelianGroup.of (ULift.up (h.unop ≫ f.down)) := rfl
            rw [hG]
            erw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
            show (P.map (h.unop ≫ f.down).op).hom s = (P.map h).hom ((P.map f.down.op).hom s)
            rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp]
            rfl }
      have tf : ∀ (Y : Type (u+1)) (a b : FreeAbelianGroup Y), ℓ • a = ℓ • b → a = b := by
        intro Y a b hab
        apply (FreeAbelianGroup.equivFinsupp Y).injective
        ext x
        have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp Y z x) hab
        simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
        exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hn.ne') hx
      have hmono : Mono (ℓ • 𝟙 G) := by
        have : ∀ V, Mono ((ℓ • 𝟙 G).app V) := by
          intro V
          rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
          intro a b hab
          simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
            AddMonoidHom.id_apply] at hab
          exact tf _ a b hab
        exact NatTrans.mono_of_mono_app _
      let g := Injective.factorThru φ (ℓ • 𝟙 G)
      have hg : (ℓ • 𝟙 G) ≫ g = φ := Injective.comp_factorThru φ (ℓ • 𝟙 G)
      rw [Preadditive.nsmul_comp, Category.id_comp] at hg
      refine ⟨(g.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))), ?_⟩
      have h1 := congrArg (fun α : G ⟶ P =>
        (α.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U)))) hg
      have h2 : (φ.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s := by
        show (FreeAbelianGroup.lift (fun f : ULift.{u+1} (U ⟶ U) => (P.map f.down.op).hom s))
          (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s
        rw [FreeAbelianGroup.lift_apply_of]
        simp
      rw [← h2, ← h1]
      simp only [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul]
      rfl
    have hmap : (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (ℓ • 𝟙 E) =
        ℓ • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply Functor.epi_of_epi_map (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    rw [hmap]
    have : ∀ V, Epi ((ℓ • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj E)).app V) := by
      intro V
      rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.epi_iff_surjective]
      intro s
      obtain ⟨t, ht⟩ := hdiv V.unop s
      exact ⟨t, by simpa using ht⟩
    exact NatTrans.epi_of_epi_app _

  have hker : ∀ (E : Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) [Injective E],
      Epi ((wcEtPush r).map (ℓ • 𝟙 E)) → ∀ q : ℕ,
      Limits.IsZero (((wcEtPush r).rightDerived (q + 1)).obj (Limits.kernel (ℓ • 𝟙 E))) := by
    intro E _ hRe q
    let S := ShortComplex.mk (Limits.kernel.ι (ℓ • 𝟙 E)) (ℓ • 𝟙 E) (Limits.kernel.condition _)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ (by dsimp [S]; infer_instance) (s1 Q E)
      exact S.exact_of_f_is_kernel (Limits.kernelIsKernel (ℓ • 𝟙 E))
    obtain ⟨_, _, hles⟩ := wc_rightDerived_les_package (wcEtPush r) S hS
    obtain ⟨_, δ, h1, h2, _, hex⟩ := hles q
    have hf : ((wcEtPush r).rightDerived (q + 1)).map S.f = 0 :=
      (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) q E).eq_of_tgt _ _
    have hδ : δ = 0 := by
      cases q with
      | zero =>
        have hRe' : Epi ((wcEtPush r).map S.g) := hRe
        have hepi : Epi (((wcEtPush r).rightDerived 0).map S.g) := by
          rw [← NatIso.naturality_2 (wcEtPush r).rightDerivedZeroIsoSelf S.g]
          infer_instance
        exact (cancel_epi _).1 (h1.trans Limits.comp_zero.symm)
      | succ m =>
        exact (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) m E).eq_of_src _ _
    exact hex.isZero_X₂ hδ hf

  obtain ⟨α₀, hinj₀, hsurj₀, hR⟩ := wc_et_zmod_ring_locbij Q ℓ
  obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Q)
    (wcEtZModRing Q ℓ) ℓ α₀ hinj₀ hsurj₀
  haveI := hfull
  have hacyc : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Q ℓ)) [Injective I] (k : ℕ),
      Limits.IsZero (((wcEtPush r).rightDerived (k + 1)).obj
        ((SheafOfModules.toSheaf (wcEtZModRing Q ℓ)).obj I)) := by
    intro I _ k
    let Φ := SheafOfModules.toSheaf.{u+1} (wcEtZModRing Q ℓ)
    have hI0 : ℓ • 𝟙 (Φ.obj I) = 0 := by
      apply (sheafToPresheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).map_injective
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero]
      ext X m
      have key : ∀ m' : (I.val.obj X : Type _), ℓ • m' = 0 := fun m' => by
        rw [← Nat.cast_smul_eq_nsmul ((wcEtZModRing Q ℓ).obj.obj X) ℓ m', hR X, zero_smul]
      simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
        AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply,
        AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
      exact key m
    let E := Injective.under (Φ.obj I)
    let ι := Injective.ι (Φ.obj I)
    have hιn : ι ≫ (ℓ • 𝟙 E) = 0 := by
      have h1 : ℓ • ι = (ℓ • 𝟙 (Φ.obj I)) ≫ ι := by
        rw [Preadditive.nsmul_comp, Category.id_comp]
      rw [Preadditive.comp_nsmul, Category.comp_id, h1, hI0, Limits.zero_comp]
    let j := Limits.kernel.lift (ℓ • 𝟙 E) ι hιn
    have hj : j ≫ Limits.kernel.ι (ℓ • 𝟙 E) = ι := Limits.kernel.lift_ι _ _ _
    have : Mono j := mono_of_mono_fac hj
    have hK0 : ℓ • 𝟙 (Limits.kernel (ℓ • 𝟙 E)) = 0 := by
      apply (cancel_mono (Limits.kernel.ι (ℓ • 𝟙 E))).1
      have h1 : Limits.kernel.ι (ℓ • 𝟙 E) ≫ (ℓ • 𝟙 E) = ℓ • Limits.kernel.ι (ℓ • 𝟙 E) := by
        rw [Preadditive.comp_nsmul, Category.comp_id]
      rw [Preadditive.nsmul_comp, Category.id_comp, ← h1, Limits.kernel.condition, Limits.zero_comp]
    obtain ⟨M', ⟨β⟩⟩ := hess _ hK0
    let g := Φ.preimage (j ≫ β.inv)
    have hg : Φ.map g = j ≫ β.inv := Φ.map_preimage _
    have : Mono g := Φ.mono_of_mono_map (by rw [hg]; infer_instance)
    let rr := Injective.factorThru (𝟙 I) g
    have hr : g ≫ rr = 𝟙 I := Injective.comp_factorThru _ _
    let ρ := β.inv ≫ Φ.map rr
    have hjρ : j ≫ ρ = 𝟙 _ := by
      calc j ≫ ρ = (j ≫ β.inv) ≫ Φ.map rr := by simp only [ρ, Category.assoc]
        _ = Φ.map (g ≫ rr) := by rw [Φ.map_comp, hg]
        _ = 𝟙 _ := by rw [hr, Φ.map_id]

    have hEinj : Injective ((wcEtPush r).obj E) := by
      obtain ⟨L, ⟨adj⟩, hL, _⟩ := wc_et_push_left_adjoint r
      haveI := hL
      exact adj.map_injective E inferInstance
    haveI := hEinj
    have hepi : Epi ((wcEtPush r).map (ℓ • 𝟙 E)) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      exact s1 T _
    have hK := hker E hepi k
    rw [Limits.IsZero.iff_id_eq_zero]
    calc 𝟙 _ = ((wcEtPush r).rightDerived (k + 1)).map (𝟙 (Φ.obj I)) :=
          (CategoryTheory.Functor.map_id _ _).symm
      _ = ((wcEtPush r).rightDerived (k + 1)).map j ≫
            ((wcEtPush r).rightDerived (k + 1)).map ρ := by
          rw [← hjρ, CategoryTheory.Functor.map_comp]
      _ = 0 := by
          rw [hK.eq_of_tgt (((wcEtPush r).rightDerived (k + 1)).map j) 0, Limits.zero_comp]

  obtain ⟨βc⟩ := wc_et_toSheaf_pushforward_iso r ℓ D
  have hiso := wc_rightDerived_exact_conj_iso
