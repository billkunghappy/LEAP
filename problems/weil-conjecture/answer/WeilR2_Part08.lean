        exact (hpull V W f.unop m x).trans
          (congrArg (fun F => F (f.unop.left x)) (hT V m)).symm }
    (fun V r m => by
      obtain ⟨V⟩ := V
      let a : (wcEtZModRing Y' ℓ).obj.obj (Opposite.op ((wcEtBaseChange p).obj V)) :=
        (Dp.φ.hom.app (Opposite.op V)).hom r
      let m' : (wcEtZModRing Y' ℓ).obj.obj (Opposite.op ((wcEtBaseChange p).obj V)) := m
      change T V (a * m') = r * T V m'
      apply (eX V).injective
      ext x
      rw [map_mul (eX V), LocallyConstant.coe_mul, Pi.mul_apply, hT, hT]
      obtain ⟨V₁, j, x₁, k, hjx, hjr, hk⟩ := hloc V r x
      subst hjx
      rw [← hpull V V₁ j, ← hpull V V₁ j, ← hk]
      have hn : ((wcEtZModRing Y' ℓ).obj.map ((wcEtBaseChange p).map j).op).hom a =
          (Dp.φ.hom.app (Opposite.op V₁)).hom (((wcEtZModRing X ℓ).obj.map j.op).hom r) :=
        (NatTrans.naturality_apply Dp.φ.hom j.op r).symm
      rw [map_mul, hn, hjr, map_intCast]
      have hz : ∀ s : (wcEtZModRing Y' ℓ).obj.obj (Opposite.op ((wcEtBaseChange p).obj V₁)),
          eY ((wcEtBaseChange p).obj V₁) ((k : (wcEtZModRing Y' ℓ).obj.obj
            (Opposite.op ((wcEtBaseChange p).obj V₁))) * s) =
          k • eY ((wcEtBaseChange p).obj V₁) s := fun s => by
        rw [← zsmul_eq_mul, map_zsmul]
      refine (congrArg (fun F => t V₁ F x₁) (hz _)).trans ?_
      exact (congrArg (fun F => F x₁) (map_zsmul (t V₁) k _)).trans
        ((map_zsmul (LocallyConstant.evalRingHom x₁ :
          LocallyConstant V₁.left (ZMod ℓ) →+* ZMod ℓ) k _).trans (zsmul_eq_mul _ k)))⟩, ?_⟩

  intro V σ hσ e H1 H2
  change T V e = 1
  haveI hEtB : Etale ((wcEtBaseChange p).obj V).hom := ((wcEtBaseChange p).obj V).prop
  have h1 : ∀ z, z ∈ interior (Set.range (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ
      (by rw [Category.id_comp, hσ]))) → eY ((wcEtBaseChange p).obj V) e z = 1 := by
    intro z hz
    let U : ((wcEtBaseChange p).obj V).left.Opens := ⟨interior (Set.range
      (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ (by rw [Category.id_comp, hσ]))),
      isOpen_interior⟩
    let O : Y'.Etale := MorphismProperty.Over.mk ⊤ (U.ι ≫ ((wcEtBaseChange p).obj V).hom)
      (by infer_instance)
    let w : O ⟶ (wcEtBaseChange p).obj V := MorphismProperty.Over.homMk U.ι rfl trivial
    have hw : Set.range w.left = (U : Set ((wcEtBaseChange p).obj V).left) :=
      Scheme.Opens.range_ι U
    have hres := H1 O w (by rw [hw]; exact interior_subset)
    have hzU : z ∈ Set.range U.ι := by
      rw [Scheme.Opens.range_ι]
      exact hz
    obtain ⟨z', rfl⟩ := hzU
    have h3 := heY _ O w e z'
    have h4 : ((wcEtZModRing Y' ℓ).obj.map w.op).hom e = 1 := hres
    rw [h4, map_one] at h3
    exact h3.symm
  have h0 : ∀ z, z ∉ Set.range (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ
      (by rw [Category.id_comp, hσ])) → eY ((wcEtBaseChange p).obj V) e z = 0 := by
    intro z hz
    have hGc := hcl V σ hσ
    let U : ((wcEtBaseChange p).obj V).left.Opens := ⟨(Set.range
      (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ (by rw [Category.id_comp, hσ])))ᶜ,
      hGc.isOpen_compl⟩
    let O : Y'.Etale := MorphismProperty.Over.mk ⊤ (U.ι ≫ ((wcEtBaseChange p).obj V).hom)
      (by infer_instance)
    let w : O ⟶ (wcEtBaseChange p).obj V := MorphismProperty.Over.homMk U.ι rfl trivial
    have hw : Set.range w.left = (U : Set ((wcEtBaseChange p).obj V).left) :=
      Scheme.Opens.range_ι U
    have hres := H2 O w (by rw [hw]; exact disjoint_compl_left)
    have hzU : z ∈ Set.range U.ι := by
      rw [Scheme.Opens.range_ι]
      exact hz
    obtain ⟨z', rfl⟩ := hzU
    have h3 := heY _ O w e z'
    have h4 : ((wcEtZModRing Y' ℓ).obj.map w.op).hom e = 0 := hres
    rw [h4, map_zero] at h3
    exact h3.symm
  apply (eX V).injective
  exact (hT V e).trans ((hnorm V σ hσ _ h1 h0).trans (map_one (eX V)).symm)

theorem wc_et_finite_trace_sheet_normalised : ∀ (K : Type u) [Field K] [IsAlgClosed K] (d : ℕ) (Y' : Scheme.{u}) (p : Y' ⟶ wcProjK K d), IsFinite p → IrreducibleSpace Y' → topologicalKrullDim Y' = (d : WithBot ℕ∞) → ∀ (W : Y'.Opens), Nonempty W → Etale (W.ι ≫ p) → ∀ (ℓ : ℕ) (Dp : wcEtPullData p ℓ), ∃ τ : wcEtSuppObj Dp ⟶ SheafOfModules.unit (wcEtZModRing (wcProjK K d) ℓ), wcEtSheetNorm Dp τ :=
by
  intro K _ _ d Y' p hp hirr _ W hW hWet ℓ Dp
  haveI : IsFinite p := hp
  obtain ⟨t, hnat, hnorm⟩ := wc_et_generic_trace_lc K d Y' p hp hirr W hW hWet ℓ
  exact wc_et_lc_trace_sheaf_map Dp t hnat hnorm

theorem wc_finite_etale_point_local_sheet : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X Y' : Scheme.{u}) (p : Y' ⟶ X), IsFinite p → ∀ (y₀' : Spec (.of K) ⟶ Y') (W : Y'.Opens), y₀' (IsLocalRing.closedPoint K) ∈ W → Etale (W.ι ≫ p) → IsClosedImmersion (y₀' ≫ p) → ∃ (T : X.Etale) (t₀ : Spec (.of K) ⟶ T.left) (s : T.left ⟶ Y') (hs : s ≫ p = T.hom), wcEtLocalSheet K p y₀' T t₀ s hs :=
by
  intro K _ _ X Y' p hp y₀' W hW hWet hcl

  have s1 : ∀ {T : Scheme.{u}} (s' : T ⟶ W),
      IsOpenImmersion (Limits.pullback.lift (f := s' ≫ W.ι ≫ p) (g := p) (𝟙 T) (s' ≫ W.ι)
        (by rw [Category.id_comp, Category.assoc])) := by
    intro T s'
    have hP := CategoryTheory.Limits.pullback_lift_diagonal_isPullback s' (W.ι ≫ p)
    have hΓ : IsOpenImmersion (Limits.pullback.lift (f := s' ≫ W.ι ≫ p) (g := W.ι ≫ p)
        (𝟙 T) s' (by simp)) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hP inferInstance
    have hj : IsOpenImmersion (Limits.pullback.map (s' ≫ W.ι ≫ p) (W.ι ≫ p) (s' ≫ W.ι ≫ p) p
        (𝟙 T) W.ι (𝟙 X) (by simp) (by simp)) := inferInstance
    have heq : Limits.pullback.lift (f := s' ≫ W.ι ≫ p) (g := p) (𝟙 T) (s' ≫ W.ι)
        (by rw [Category.id_comp, Category.assoc]) =
        Limits.pullback.lift (f := s' ≫ W.ι ≫ p) (g := W.ι ≫ p) (𝟙 T) s' (by simp) ≫
          Limits.pullback.map (s' ≫ W.ι ≫ p) (W.ι ≫ p) (s' ≫ W.ι ≫ p) p
            (𝟙 T) W.ι (𝟙 X) (by simp) (by simp) := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.map,
          Category.comp_id]
      · simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
          Limits.pullback.map]
    rw [heq]
    infer_instance

  have s2 : ∀ {X₁ T Y S : Scheme.{u}} (f : T ⟶ X₁) (q : Y ⟶ X₁) (y₀ : S ⟶ Y),
      IsClosedImmersion (y₀ ≫ q) → ∀ (pt : S) (z₁ z₂ : ↥(Limits.pullback f q)),
      Limits.pullback.snd f q z₁ = y₀ pt → Limits.pullback.snd f q z₂ = y₀ pt →
      Limits.pullback.fst f q z₁ = Limits.pullback.fst f q z₂ → z₁ = z₂ := by
    intro X₁ T Y S f q y₀ hcl' pt z₁ z₂ h1 h2 h
    have hP : IsPullback (Limits.pullback.fst (Limits.pullback.snd f q) y₀ ≫
        Limits.pullback.fst f q) (Limits.pullback.snd (Limits.pullback.snd f q) y₀) f (y₀ ≫ q) :=
      IsPullback.paste_horiz (IsPullback.of_hasPullback _ _) (IsPullback.of_hasPullback _ _)
    have : IsClosedImmersion (Limits.pullback.fst (Limits.pullback.snd f q) y₀ ≫
        Limits.pullback.fst f q) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hP.flip hcl'
    have hinj := (Limits.pullback.fst (Limits.pullback.snd f q) y₀ ≫
        Limits.pullback.fst f q).isClosedEmbedding.isEmbedding.injective
    obtain ⟨w₁, hw₁, -⟩ := Scheme.Pullback.exists_preimage_pullback z₁ pt h1
    obtain ⟨w₂, hw₂, -⟩ := Scheme.Pullback.exists_preimage_pullback z₂ pt h2
    have hw : w₁ = w₂ := by
      apply hinj
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hw₁, hw₂, h]
    rw [← hw₁, ← hw₂, hw]

  have s3 : ∀ (y₀ : Y') (W₀ : Y'.Opens), y₀ ∈ W₀ → IsClosed ({p y₀} : Set X) →
      ∃ W' : Y'.Opens, W' ≤ W₀ ∧ y₀ ∈ W' ∧ ∀ y ∈ W', p y = p y₀ → y = y₀ := by
    intro y₀ W₀ hW₀ hclosed
    have hF : IsClosed (p ⁻¹' {p y₀}) := hclosed.preimage p.continuous
    have : DiscreteTopology ↑(p ⁻¹' {p y₀}) := (p.fiberHomeo (p y₀)).discreteTopology
    set t : Set ↑(p ⁻¹' {p y₀}) := {a | a.val ≠ y₀} with ht
    have hC : IsClosed (Subtype.val '' t : Set Y') := IsClosed.trans (isClosed_discrete t) hF
    refine ⟨W₀ ⊓ ⟨(Subtype.val '' t)ᶜ, hC.isOpen_compl⟩, inf_le_left, ?_, ?_⟩
    · refine ⟨hW₀, ?_⟩
      rintro ⟨a, ha, hay⟩
      exact ha hay
    · rintro y ⟨-, hy⟩ hpy
      by_contra hne
      exact hy ⟨⟨y, hpy⟩, hne, rfl⟩

  obtain ⟨pt, hptdef⟩ : ∃ pt : ↥(Spec (.of K)), IsLocalRing.closedPoint K = pt := ⟨_, rfl⟩
  have hW' : y₀' pt ∈ W := by subst hptdef; exact hW
  have hpt : ∀ a : ↥(Spec (.of K)), a = pt := fun a => Subsingleton.elim _ _
  have hclosed : IsClosed ({p (y₀' pt)} : Set X) := by
    have h1 := (y₀' ≫ p).isClosedEmbedding.isClosed_range
    have h2 : Set.range (y₀' ≫ p) = {p (y₀' pt)} := by
      ext x
      constructor
      · rintro ⟨a, rfl⟩
        rw [hpt a, Scheme.Hom.comp_apply]
        rfl
      · intro hx
        rw [Set.mem_singleton_iff] at hx
        exact ⟨pt, by rw [Scheme.Hom.comp_apply, hx]⟩
    rwa [h2] at h1
  obtain ⟨W', hle, hy, hiso⟩ := s3 _ W hW' hclosed
  have H' : Set.range y₀' ⊆ Set.range W'.ι := by
    rintro _ ⟨a, rfl⟩
    rw [Scheme.Opens.range_ι, hpt a]
    exact hy
  set t₀ : Spec (.of K) ⟶ W' := IsOpenImmersion.lift W'.ι y₀' H' with ht₀
  have hfac : t₀ ≫ W'.ι = y₀' := IsOpenImmersion.lift_fac _ _ _
  have hT : Etale (Y'.homOfLE hle ≫ W.ι ≫ p) := inferInstance
  have hC2 : t₀ ≫ Y'.homOfLE hle ≫ W.ι = y₀' := by
    rw [Scheme.homOfLE_ι, hfac]
  have hC1 : t₀ ≫ Y'.homOfLE hle ≫ W.ι ≫ p = y₀' ≫ p := by
    rw [← Category.assoc (Y'.homOfLE hle), ← Category.assoc t₀, hC2]
  have hC4 : ∀ t : (W' : Scheme.{u}), (Y'.homOfLE hle ≫ W.ι ≫ p) t =
      (y₀' ≫ p) pt → t = t₀ pt := by
    intro t ht
    rw [Scheme.homOfLE_ι_assoc, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at ht
    have hmem : W'.ι t ∈ W' := by
      have h0 : W'.ι t ∈ Set.range W'.ι := ⟨t, rfl⟩
      rwa [Scheme.Opens.range_ι] at h0
    have h1 := hiso _ hmem ht
    apply W'.ι.isOpenEmbedding.isEmbedding.injective
    rw [h1, ← Scheme.Hom.comp_apply, hfac]
  have hC3 := s1 (Y'.homOfLE hle)
  have hC5 : ∀ z : ↥(Limits.pullback (Y'.homOfLE hle ≫ W.ι ≫ p) p),
      Limits.pullback.snd (Y'.homOfLE hle ≫ W.ι ≫ p) p z = y₀' pt →
      z ∈ Set.range (Limits.pullback.lift (f := Y'.homOfLE hle ≫ W.ι ≫ p) (g := p)
        (𝟙 (W' : Scheme.{u})) (Y'.homOfLE hle ≫ W.ι)
        (by rw [Category.id_comp, Category.assoc])) := by
    intro z hz
    have hc : (Y'.homOfLE hle ≫ W.ι ≫ p) (Limits.pullback.fst _ p z) = (y₀' ≫ p) pt := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply,
        Scheme.Hom.comp_apply, hz]
    have hft := hC4 _ hc
    refine ⟨Limits.pullback.fst _ p z, ?_⟩
    apply s2 (Y'.homOfLE hle ≫ W.ι ≫ p) p y₀' hcl pt
    · rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_snd, hft, ← Scheme.Hom.comp_apply, hC2]
    · exact hz
    · rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst]
      rfl
  subst hptdef
  exact ⟨MorphismProperty.Over.mk ⊤ (Y'.homOfLE hle ≫ W.ι ≫ p) hT, t₀,
    Y'.homOfLE hle ≫ W.ι, Category.assoc _ _ _, hC1, hC2, hC3, hC4, hC5⟩

theorem ext_mapExactFunctor_natTrans_comp : ∀ {C C' D : Type*} [Category C] [Abelian C] [Category C'] [Abelian C'] [Category D] [Abelian D] [HasExt C] [HasExt C'] [HasExt D] [EnoughInjectives C] (F : C ⥤ C') (G : C' ⥤ D) (H : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G] [H.Additive] [Limits.PreservesFiniteLimits H] [Limits.PreservesFiniteColimits H] (ι : H ⟶ F ⋙ G) {A B : C} {n : ℕ} (u : Abelian.Ext A B n), (Abelian.Ext.mapExactFunctor H u).comp (Abelian.Ext.mk₀ (ι.app B)) (add_zero n) = (Abelian.Ext.mk₀ (ι.app A)).comp (Abelian.Ext.mapExactFunctor G (Abelian.Ext.mapExactFunctor F u)) (zero_add n) :=
by
  intro C C' D _ _ _ _ _ _ _ _ _ _ F G H _ _ _ _ _ _ _ _ _ ι A B n u
  have h1 := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp u ι
  rw [Abelian.Ext.comp_mapExactFunctor] at h1
  exact h1

theorem wc_et_supp_ext_restrict_bijective : ∀ {K : Type u} [Field K] {X : Scheme.{u}} (T : X.Etale) (hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)) (hcc : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)) (x₀ : Spec (.of K) ⟶ X) (v₀ : Spec (.of K) ⟶ T.left) [IsClosedImmersion x₀], IsPullback (𝟙 (Spec (.of K))) v₀ x₀ T.hom → ∀ (ℓ : ℕ) (ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj (wcEtZModRing X ℓ)) [hadd : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hc ψ).Additive] [hlim : Limits.PreservesFiniteLimits (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hc ψ)] [hcolim : Limits.PreservesFiniteColimits (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hc ψ)] (N Y : SheafOfModules.{u+1} (wcEtZModRing X ℓ)), (∀ W : X.Etale, (∀ w : W.left, W.hom w ∉ Set.range x₀) → Subsingleton ↑(N.val.obj (Opposite.op W))) → ∀ q : ℕ, (letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T.left ℓ)) := HasExt.standard _; Function.Bijective (fun β : Abelian.Ext N Y q => Abelian.Ext.mapExactFunctor (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hc ψ) β)) :=
by
  intro K _ X T hc hcc x₀ v₀ _ hP ℓ ψ hadd hlim hcolim N Y hN q
  letI iX : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _
  letI iT : HasExt (SheafOfModules.{u+1} (wcEtZModRing T.left ℓ)) := HasExt.standard _
  haveI := hc
  haveI := hcc
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  have hw : v₀ ≫ T.hom = x₀ := (hP.toCommSq.w).symm.trans (Category.id_comp x₀)
  have hcov := wc_et_point_two_piece_cover T x₀ v₀ hw
  have hloc := wc_et_point_lifts_agree_locally T x₀ v₀ hP
  have hbij : ∀ Y' : SheafOfModules.{u+1} (wcEtZModRing X ℓ), Function.Bijective
      (fun f : N ⟶ Y' => (SheafOfModules.pushforward.{u+1} ψ).map f) := fun Y' =>
    ⟨wc_et_supp_restrict_hom_injective T ℓ ψ (Set.range x₀) N Y' hN hcov,
      wc_et_supp_restrict_hom_surjective T ℓ ψ (Set.range x₀) N Y' hN hcov hloc⟩
  have hhom : ∀ Y' : SheafOfModules.{u+1} (wcEtZModRing X ℓ), Function.Bijective
      (fun f : N ⟶ Y' => 𝟙 ((SheafOfModules.pushforward.{u+1} ψ).obj N) ≫
        (SheafOfModules.pushforward.{u+1} ψ).map f) := by
    intro Y'
    have hiso : Function.Bijective (fun g : (SheafOfModules.pushforward.{u+1} ψ).obj N ⟶
        (SheafOfModules.pushforward.{u+1} ψ).obj Y' =>
          𝟙 ((SheafOfModules.pushforward.{u+1} ψ).obj N) ≫ g) :=
      ⟨fun g₁ g₂ hg => (Category.id_comp g₁).symm.trans (hg.trans (Category.id_comp g₂)),
        fun g => ⟨g, Category.id_comp g⟩⟩
    exact hiso.comp (hbij Y')
  have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing X ℓ)) [Injective I] (k : ℕ)
      (e : Abelian.Ext ((SheafOfModules.pushforward.{u+1} ψ).obj N)
        ((SheafOfModules.pushforward.{u+1} ψ).obj I) (k + 1)), e = 0 := by
    intro I hI k e
    haveI := wc_et_slice_module_restrict_injective T ℓ ψ I hI
    exact Abelian.Ext.eq_zero_of_injective e
  have hΦ := ext_transfer_of_corep (SheafOfModules.pushforward.{u+1} ψ) N
    ((SheafOfModules.pushforward.{u+1} ψ).obj N) (𝟙 _) hhom hvan Y q
  have hfun : (fun β : Abelian.Ext N Y q =>
      (Abelian.Ext.mk₀ (𝟙 ((SheafOfModules.pushforward.{u+1} ψ).obj N))).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) β) (zero_add q)) =
      (fun β : Abelian.Ext N Y q =>
        Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) β) :=
    funext fun β => Abelian.Ext.mk₀_id_comp _
  exact hfun ▸ hΦ

theorem wc_et_local_sheet_geom : ∀ (K : Type u) [Field K] {X Y' : Scheme.{u}} (p : Y' ⟶ X) (y₀' : Spec (.of K) ⟶ Y') [IsClosedImmersion (y₀' ≫ p)] (T : X.Etale) (t₀ : Spec (.of K) ⟶ T.left) (s : T.left ⟶ Y') (hs : s ≫ p = T.hom), wcEtLocalSheet K p y₀' T t₀ s hs → Etale s ∧ IsClosedImmersion t₀ ∧ ∀ t : T.left, s t = y₀' (IsLocalRing.closedPoint K) → t = t₀ (IsLocalRing.closedPoint K) :=
by
  intro K _ X Y' p y₀' _ T t₀ s hs h
  obtain ⟨L1, L2, L3, L4, -⟩ := h
  haveI hTE : Etale T.hom := T.prop
  refine ⟨?_, ?_, ?_⟩
  · haveI := L3
    have e : Etale (Limits.pullback.lift (f := T.hom) (g := p) (𝟙 T.left) s
        (by rw [Category.id_comp, hs]) ≫ Limits.pullback.snd T.hom p) := inferInstance
    rwa [Limits.pullback.lift_snd] at e
  · have hsq : 𝟙 (Spec (.of K)) ≫ (y₀' ≫ p) = t₀ ≫ T.hom := by rw [Category.id_comp, L1]
    let σ : Spec (.of K) ⟶ Limits.pullback (y₀' ≫ p) T.hom := Limits.pullback.lift (𝟙 _) t₀ hsq
    have hs1 : σ ≫ Limits.pullback.fst (y₀' ≫ p) T.hom = 𝟙 _ := Limits.pullback.lift_fst _ _ _
    have hs2 : σ ≫ Limits.pullback.snd (y₀' ≫ p) T.hom = t₀ := Limits.pullback.lift_snd _ _ _
    haveI hp : Etale (Limits.pullback.fst (y₀' ≫ p) T.hom) := inferInstance
    have hle : @Etale ≤ (@IsOpenImmersion).diagonal := by
      intro A B f hf
      rw [MorphismProperty.diagonal_iff]
      haveI := hf
      infer_instance
    haveI hpost : (@IsOpenImmersion).HasOfPostcompProperty @Etale :=
      (MorphismProperty.hasOfPostcompProperty_iff_le_diagonal).mpr hle
    have hso : IsOpenImmersion σ := by
      apply MorphismProperty.of_postcomp (W := @IsOpenImmersion) (W' := @Etale) σ
        (Limits.pullback.fst (y₀' ≫ p) T.hom) hp
      rw [hs1]; infer_instance
    have hss : Surjective σ := by
      constructor
      intro z
      let pt : ↥(Spec (.of K)) := IsLocalRing.closedPoint K
      refine ⟨pt, ?_⟩
      apply (Limits.pullback.snd (y₀' ≫ p) T.hom).isClosedEmbedding.injective
      have e1 : (Limits.pullback.snd (y₀' ≫ p) T.hom) (σ pt) = t₀ pt := by
        rw [← Scheme.Hom.comp_apply, hs2]
      have e2 : T.hom ((Limits.pullback.snd (y₀' ≫ p) T.hom) z) = (y₀' ≫ p) pt := by
        rw [← Scheme.Hom.comp_apply, ← Limits.pullback.condition, Scheme.Hom.comp_apply]
        congr 1
        exact Subsingleton.elim _ _
      rw [e1]
      exact (L4 _ e2).symm
    haveI : IsIso σ := (isIso_iff_isOpenImmersion_and_surjective σ).mpr ⟨hso, hss⟩
    have hc : IsClosedImmersion (σ ≫ Limits.pullback.snd (y₀' ≫ p) T.hom) := inferInstance
    rwa [hs2] at hc
  · intro t hst
    let pt : ↥(Spec (.of K)) := IsLocalRing.closedPoint K
    apply L4
    have e : T.hom t = p (s t) := by rw [← hs, Scheme.Hom.comp_apply]
    have e2 : (y₀' ≫ p) pt = p (y₀' pt) := Scheme.Hom.comp_apply _ _ _
    rw [e, hst]
    exact e2.symm

theorem wc_et_slice_unitToPushforward_isIso : ∀ {X : Scheme.{u}} (T : X.Etale) (hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)) (hcc : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)) (ℓ : ℕ) (ψ : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj (wcEtZModRing X ℓ)), IsIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtSlice T) _ _ hc ψ) :=
by
  intro X T hc hcc ℓ ψ
  haveI := hc
  haveI := hcc
  let γ : wcEtZModRing T.left ℓ ≅ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T)
      RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hc).obj
      (wcEtZModRing X ℓ) :=
    (Functor.pushforwardContinuousSheafificationCompatibility (wcEtSlice T) RingCat.{u+1}
      (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).app
      ((Functor.const _).obj (RingCat.of (ULift.{u+1} (ZMod ℓ))))
  have huniq : ∀ (S : Sheaf (Scheme.smallEtaleTopology T.left) RingCat.{u+1})
      (f g : wcEtZModRing T.left ℓ ⟶ S), f = g := by
    intro S f g
    let P : (T.left.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      (Functor.const (T.left.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod ℓ)))
    let adj := sheafificationAdjunction (Scheme.smallEtaleTopology T.left) RingCat.{u+1}
    let f' : (presheafToSheaf (Scheme.smallEtaleTopology T.left) RingCat.{u+1}).obj P ⟶ S := f
    let g' : (presheafToSheaf (Scheme.smallEtaleTopology T.left) RingCat.{u+1}).obj P ⟶ S := g
    show f' = g'
    apply (adj.homEquiv P S).injective
    apply NatTrans.ext
    funext U
    apply RingCat.hom_ext
    apply RingHom.ext
    intro x
    let e : ZMod ℓ →+* ULift.{u+1} (ZMod ℓ) := (ULift.ringEquiv).symm.toRingHom
    let a : ULift.{u+1} (ZMod ℓ) →+* ↑(S.obj.obj U) := ((adj.homEquiv P S f').app U).hom
    let b : ULift.{u+1} (ZMod ℓ) →+* ↑(S.obj.obj U) := ((adj.homEquiv P S g').app U).hom
    have hab := RingHom.ext_zmod (a.comp e) (b.comp e)
    exact congrArg (fun h => h x.down) hab
  have hψ : ψ = γ.hom := huniq _ _ _
  rw [hψ]
  let u := SheafOfModules.unitToPushforwardObjUnit γ.hom
  show IsIso u
  have hU : ∀ U, IsIso (((PresheafOfModules.toPresheaf _).map
      ((SheafOfModules.forget _).map u)).app U) := by
    intro U
    have hb : Function.Bijective
        (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map
          ((SheafOfModules.forget _).map u)).app U)) :=
      ConcreteCategory.bijective_of_isIso (γ.hom.hom.app U)
    have h2 : IsIso ((forget AddCommGrpCat.{u+1}).map (((PresheafOfModules.toPresheaf _).map
          ((SheafOfModules.forget _).map u)).app U)) :=
      (isIso_iff_bijective _).mpr hb
    exact isIso_of_reflects_iso _ (forget AddCommGrpCat.{u+1})
  have h3 : IsIso ((PresheafOfModules.toPresheaf _).map
      ((SheafOfModules.forget _).map u)) := NatIso.isIso_of_isIso_app _
  have h4 : IsIso ((SheafOfModules.forget _).map u) :=
    isIso_of_reflects_iso _ (PresheafOfModules.toPresheaf _)
  exact isIso_of_reflects_iso u (SheafOfModules.forget _)

theorem wc_et_clopen_sheet_ext_zero : ∀ {Y' : Scheme.{u}} {R : Sheaf (Scheme.smallEtaleTopology Y') RingCat.{u+1}} (N : SheafOfModules.{u+1} R) {A B : Y'.Etale} (γ : A ⟶ B), IsOpenImmersion γ.left → IsClosed (Set.range γ.left) → ∃ e : ↑(N.val.obj (Opposite.op A)) →+ ↑(N.val.obj (Opposite.op B)), (∀ a, (N.val.map γ.op).hom (e a) = a) ∧ (∀ (O : Y'.Etale) (w : O ⟶ B), Disjoint (Set.range w.left) (Set.range γ.left) → ∀ a, (N.val.map w.op).hom (e a) = 0) ∧ (∀ t t' : ↑(N.val.obj (Opposite.op B)), (N.val.map γ.op).hom t = (N.val.map γ.op).hom t' → (∀ (O : Y'.Etale) (w : O ⟶ B), Disjoint (Set.range w.left) (Set.range γ.left) → (N.val.map w.op).hom t = (N.val.map w.op).hom t') → t = t') :=
by
  intro Y' R N A B γ hO hC
  classical
  haveI := hO
  have hJ : ∀ (V : Y'.Etale) (S : Sieve V), (∀ x : V.left, ∃ (Y : Y'.Etale) (f : Y ⟶ V) (y : Y.left),
      S.arrows f ∧ Etale f.left ∧ f.left y = x) → S ∈ Scheme.smallEtaleTopology Y' V := fun V S h =>
    (congrArg (fun J : GrothendieckTopology Y'.Etale => S ∈ J V)
      (@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y'
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl)).mpr
      ((@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y'
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V S).2 h)
  have hEmp : ∀ O : Y'.Etale, IsEmpty O.left → Subsingleton ↑(N.val.obj (Opposite.op O)) := by
    intro O hE
    have hBot : (⊥ : Sieve O) ∈ Scheme.smallEtaleTopology Y' O := hJ O ⊥ (fun x => isEmptyElim x)
    have hSub : Subsingleton ↑(((SheafOfModules.toSheaf R).obj N).obj.obj (Opposite.op O)) :=
      AddCommGrpCat.subsingleton_of_isZero
        (Sheaf.isTerminalOfBotCover ((SheafOfModules.toSheaf R).obj N) O hBot).isZero
    exact hSub
  have hmc : ∀ {O₁ O₂ O₃ : Y'.Etale} (f₁ : O₁ ⟶ O₂) (f₂ : O₂ ⟶ O₃) (x : N.val.obj (Opposite.op O₃)),
      (N.val.map (f₁ ≫ f₂).op).hom x = (N.val.map f₁.op).hom ((N.val.map f₂.op).hom x) := by
    intro O₁ O₂ O₃ f₁ f₂ x
    rw [op_comp, PresheafOfModules.map_comp]
    rfl

  let C : B.left.Opens := ⟨(Set.range γ.left)ᶜ, hC.isOpen_compl⟩
  have hCr : Set.range C.ι = (Set.range γ.left)ᶜ := Scheme.Opens.range_ι C
  let A₂ : Y'.Etale := MorphismProperty.Over.mk ⊤ (C.ι ≫ B.hom)
    (by have : Etale B.hom := B.prop; infer_instance)
  let π₂ : A₂ ⟶ B := MorphismProperty.Over.homMk C.ι rfl trivial
  have hdisj : Disjoint (Set.range π₂.left) (Set.range γ.left) := by
    have : Disjoint (Set.range C.ι) (Set.range γ.left) := by
      rw [hCr]; exact disjoint_compl_left
    exact this

  let X : Bool → Y'.Etale := fun b => Bool.rec A₂ A b
  let π : (b : Bool) → X b ⟶ B := fun b => Bool.rec (motive := fun b => X b ⟶ B) π₂ γ b
  have hcov : Sieve.generate (Presieve.ofArrows X π) ∈ Scheme.smallEtaleTopology Y' B := by
    apply hJ
    intro x
    by_cases hx : x ∈ Set.range γ.left
    · obtain ⟨y, hy⟩ := hx
      exact ⟨A, γ, y, ⟨_, 𝟙 _, γ, Presieve.ofArrows.mk (f := π) true, Category.id_comp _⟩,
        inferInstance, hy⟩
    · have hx' : x ∈ Set.range C.ι := by rw [hCr]; exact hx
      obtain ⟨y, hy⟩ := hx'
      exact ⟨A₂, π₂, y, ⟨_, 𝟙 _, π₂, Presieve.ofArrows.mk (f := π) false, Category.id_comp _⟩,
        (inferInstance : Etale C.ι), hy⟩
  let P := N.val.presheaf ⋙ forget AddCommGrpCat.{u+1}
  have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology Y') P :=
    (isSheaf_iff_isSheaf_of_type _ P).1
      ((Presheaf.isSheaf_iff_isSheaf_forget _ N.val.presheaf (forget AddCommGrpCat.{u+1})).1 N.isSheaf)
  have hSF := (Presieve.isSheafFor_arrows_iff P π).1 (hP.isSheafFor _ hcov)

  have hsep : ∀ t t' : ↑(N.val.obj (Opposite.op B)), (N.val.map γ.op).hom t = (N.val.map γ.op).hom t' →
      (N.val.map π₂.op).hom t = (N.val.map π₂.op).hom t' → t = t' := by
    intro t t' h1 h2
    obtain ⟨t₀, -, huniq⟩ := hSF (fun b => P.map (π b).op t) (by
      intro i j Z gi gj h
      show (N.val.map gi.op).hom ((N.val.map (π i).op).hom t) =
        (N.val.map gj.op).hom ((N.val.map (π j).op).hom t)
      rw [← hmc, ← hmc, h])
    have e1 := huniq t (fun b => rfl)
    have e2 := huniq t' (fun b => by
      cases b
      · exact h2.symm
      · exact h1.symm)
    exact e1.trans e2.symm

  have hmixed : ∀ (Z : Y'.Etale) (g₁ : Z ⟶ A) (g₂ : Z ⟶ A₂), g₁ ≫ γ = g₂ ≫ π₂ → IsEmpty Z.left := by
    intro Z g₁ g₂ h
    refine ⟨fun o => ?_⟩
    have e : (g₁.left ≫ γ.left) o = (g₂.left ≫ π₂.left) o := congrArg (fun k : Z ⟶ B => k.left o) h
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
    have h1 : π₂.left (g₂.left o) ∈ Set.range C.ι := ⟨_, rfl⟩
    rw [hCr] at h1
    exact h1 ⟨_, e⟩

  have hex : ∀ a : ↑(N.val.obj (Opposite.op A)), ∃ t : ↑(N.val.obj (Opposite.op B)),
      (N.val.map γ.op).hom t = a ∧ (N.val.map π₂.op).hom t = 0 := by
    intro a
    obtain ⟨t, ht, -⟩ := hSF
      (fun b => Bool.rec (motive := fun b => P.obj (Opposite.op (X b)))
        (0 : N.val.obj (Opposite.op A₂)) a b) (by
      intro i j Z gi gj h
      cases i <;> cases j
      · show (N.val.map gi.op).hom 0 = (N.val.map gj.op).hom 0
        exact ((N.val.map gi.op).hom.map_zero).trans ((N.val.map gj.op).hom.map_zero).symm
      · exact @Subsingleton.elim _ (hEmp Z (hmixed Z gj gi h.symm)) _ _
      · exact @Subsingleton.elim _ (hEmp Z (hmixed Z gi gj h)) _ _
      · have hg : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          exact (cancel_mono γ.left).1 (congrArg (fun k => k.left) h)
        subst hg
        rfl)
    exact ⟨t, ht true, ht false⟩
  choose e₀ he₁ he₂ using hex
  have hadd : ∀ a b, e₀ (a + b) = e₀ a + e₀ b := by
    intro a b
    apply hsep
    · rw [(N.val.map γ.op).hom.map_add, he₁, he₁, he₁]
      rfl
    · rw [(N.val.map π₂.op).hom.map_add, he₂, he₂, he₂]
      exact (add_zero _).symm
  refine ⟨AddMonoidHom.mk' e₀ hadd, fun a => he₁ a, ?_, ?_⟩
  · intro O w hw a
    have H' : Set.range w.left ⊆ Set.range C.ι := by
      rw [hCr]
      rintro _ ⟨o, rfl⟩ hmem
      exact Set.disjoint_left.1 hw ⟨o, rfl⟩ hmem
    have hCι : IsOpenImmersion C.ι := by infer_instance
    obtain ⟨w₀, hw₀⟩ : ∃ w₀ : O.left ⟶ A₂.left, w₀ ≫ π₂.left = w.left :=
      ⟨@IsOpenImmersion.lift _ _ _ C.ι w.left hCι H', @IsOpenImmersion.lift_fac _ _ _ C.ι w.left hCι H'⟩
    have hŵ : w₀ ≫ A₂.hom = O.hom := by
      have e1 : A₂.hom = π₂.left ≫ B.hom := rfl
      rw [e1, ← Category.assoc, hw₀]
      exact MorphismProperty.Over.w w
    let ŵ : O ⟶ A₂ := MorphismProperty.Over.homMk w₀ hŵ trivial
    have hfac : ŵ ≫ π₂ = w := by
      apply MorphismProperty.Over.Hom.ext
      exact hw₀
    show (N.val.map w.op).hom (e₀ a) = 0
    rw [← hfac, hmc, he₂]
    exact (N.val.map ŵ.op).hom.map_zero
  · intro t t' h1 h2
    exact hsep t t' h1 (h2 A₂ π₂ hdisj)

theorem wc_sheet_graph_isPullback : ∀ {X Y' U U' : Scheme.{u}} (p : Y' ⟶ X) (f : U ⟶ X) (f' : U' ⟶ X) (σ : U ⟶ Y') (a : U' ⟶ U) (g : U ⟶ Limits.pullback f p) (g' : U' ⟶ Limits.pullback f' p) (m : Limits.pullback f' p ⟶ Limits.pullback f p), a ≫ f = f' → g ≫ Limits.pullback.fst f p = 𝟙 U → g ≫ Limits.pullback.snd f p = σ → g' ≫ Limits.pullback.fst f' p = 𝟙 U' → g' ≫ Limits.pullback.snd f' p = a ≫ σ → m ≫ Limits.pullback.fst f p = Limits.pullback.fst f' p ≫ a → m ≫ Limits.pullback.snd f p = Limits.pullback.snd f' p → IsPullback a g' g m ∧ Set.range g' = m ⁻¹' Set.range g :=
by
  intro X Y' U U' p f f' σ a g g' m _h0 h1 h2 h3 h4 h5 h6
  have s1 : a ≫ g = g' ≫ m := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, h1, h5, ← Category.assoc, h3, Category.comp_id,
        Category.id_comp]
    · rw [Category.assoc, Category.assoc, h2, h6, h4]
  have fac1 : ∀ s : Limits.PullbackCone g m,
      (s.snd ≫ Limits.pullback.fst f' p) ≫ a = s.fst := by
    intro s
    rw [Category.assoc, ← h5, ← Category.assoc, ← s.condition, Category.assoc, h1,
      Category.comp_id]
  have fac2 : ∀ s : Limits.PullbackCone g m,
      (s.snd ≫ Limits.pullback.fst f' p) ≫ g' = s.snd := by
    intro s
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, h3, Category.comp_id]
    · rw [Category.assoc, h4, ← Category.assoc, fac1 s, ← h6, ← Category.assoc, ← s.condition,
        Category.assoc, h2]
  have hPB : IsPullback a g' g m := by
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk a g' s1) ?_
    refine Limits.PullbackCone.IsLimit.mk s1 (fun s => s.snd ≫ Limits.pullback.fst f' p)
      (fun s => fac1 s) (fun s => fac2 s) ?_
    intro s l _hl1 hl2
    rw [← hl2, Category.assoc, h3, Category.comp_id]
  refine ⟨hPB, ?_⟩
  ext x
  constructor
  · rintro ⟨z, rfl⟩
    refine ⟨a z, ?_⟩
    rw [← Scheme.Hom.comp_apply, s1, Scheme.Hom.comp_apply]
  · rintro ⟨u, hu⟩
    obtain ⟨z, -, hz⟩ := Scheme.exists_preimage_of_isPullback hPB u x hu
    exact ⟨z, hz⟩

theorem wc_et_sheet_ext_zero_exists : ∀ {X Y' : Scheme.{u}} (p : Y' ⟶ X) [IsFinite p] {ℓ : ℕ} (Dp : wcEtPullData p ℓ) (T : X.Etale) (s : T.left ⟶ Y') (hs : s ≫ p = T.hom) (hsE : Etale s), IsOpenImmersion (Limits.pullback.lift (f := T.hom) (g := p) (𝟙 T.left) s (by simp [hs])) → ∀ (hcX : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)) (hcY : (wcEtSliceOf T.left s hsE).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y')) (ψX : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hcX).obj (wcEtZModRing X ℓ)) (ψY : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSliceOf T.left s hsE) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y') hcY).obj (wcEtZModRing Y' ℓ)), ∃ ι : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSliceOf T.left s hsE) _ _ hcY ψY) ⟶ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ) ⋙ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX), ∀ N, wcEtSheetExtZero p Dp T s hs hsE hcX hcY ψX ψY N (ι.app N) :=
by
  intro X Y' p hpfin ℓ Dp T s hs hsE hΓ hcX hcY ψX ψY
  classical

  have hFull : (SheafOfModules.toSheaf.{u+1} (wcEtZModRing T.left ℓ)).Full := by
    obtain ⟨α, hinj, hsurj, -⟩ := wc_et_zmod_ring_locbij T.left ℓ
    exact (sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology T.left)
      (wcEtZModRing T.left ℓ) ℓ α hinj hsurj).1

  have hgw : ∀ U : T.left.Etale, 𝟙 U.left ≫ ((wcEtSlice T).obj U).hom = (U.hom ≫ s) ≫ p := by
    intro U
    show 𝟙 U.left ≫ (U.hom ≫ T.hom) = (U.hom ≫ s) ≫ p
    rw [Category.id_comp, Category.assoc, hs]
  obtain ⟨g, hg⟩ : ∃ g : ∀ U : T.left.Etale, U.left ⟶ Limits.pullback ((wcEtSlice T).obj U).hom p,
      ∀ U, g U = Limits.pullback.lift (f := ((wcEtSlice T).obj U).hom) (g := p) (𝟙 U.left)
        (U.hom ≫ s) (hgw U) :=
    ⟨fun U => Limits.pullback.lift (f := ((wcEtSlice T).obj U).hom) (g := p) (𝟙 U.left)
        (U.hom ≫ s) (hgw U), fun U => rfl⟩
  have hg1 : ∀ U : T.left.Etale, g U ≫ Limits.pullback.fst ((wcEtSlice T).obj U).hom p = 𝟙 U.left :=
    fun U => by rw [hg U]; exact Limits.pullback.lift_fst _ _ _
  have hg2 : ∀ U : T.left.Etale, g U ≫ Limits.pullback.snd ((wcEtSlice T).obj U).hom p = U.hom ≫ s :=
    fun U => by rw [hg U]; exact Limits.pullback.lift_snd _ _ _
  obtain ⟨γ, hγ⟩ : ∃ γ : ∀ U : T.left.Etale, (wcEtSliceOf T.left s hsE).obj U ⟶
      (wcEtBaseChange p).obj ((wcEtSlice T).obj U), ∀ U, (γ U).left = g U :=
    ⟨fun U => MorphismProperty.Over.homMk (g U) (by exact hg2 U) trivial, fun U => rfl⟩

  have hgeom : ∀ U : T.left.Etale, IsOpenImmersion (γ U).left ∧ IsClosed (Set.range (γ U).left) := by
    intro U
    rw [hγ U]
    refine ⟨?_, ?_⟩
    · have hPB := (wc_sheet_graph_isPullback p T.hom ((wcEtSlice T).obj U).hom s U.hom
        (Limits.pullback.lift (f := T.hom) (g := p) (𝟙 T.left) s (by simp [hs])) (g U)
        (Limits.pullback.lift (f := T.hom) (g := p)
          (Limits.pullback.fst ((wcEtSlice T).obj U).hom p ≫ U.hom)
          (Limits.pullback.snd ((wcEtSlice T).obj U).hom p)
          ((Category.assoc _ _ _).trans Limits.pullback.condition))
        rfl (Limits.pullback.lift_fst _ _ _) (Limits.pullback.lift_snd _ _ _)
        (hg1 U) (hg2 U) (Limits.pullback.lift_fst _ _ _) (Limits.pullback.lift_snd _ _ _)).1
      exact MorphismProperty.of_isPullback (P := @IsOpenImmersion) hPB hΓ
    · have hid : IsClosedImmersion (𝟙 U.left) := inferInstance
      have : IsClosedImmersion (g U ≫ Limits.pullback.fst ((wcEtSlice T).obj U).hom p) :=
        (hg1 U).symm ▸ hid
      have := IsClosedImmersion.of_comp (g U) (Limits.pullback.fst ((wcEtSlice T).obj U).hom p)
      exact (g U).isClosedEmbedding.isClosed_range

  have hBf : ∀ {U U' : T.left.Etale} (h : U' ⟶ U),
      ((wcEtBaseChange p).map ((wcEtSlice T).map h)).left ≫
        Limits.pullback.fst ((wcEtSlice T).obj U).hom p =
      Limits.pullback.fst ((wcEtSlice T).obj U').hom p ≫ h.left := by
    intro U U' h
    exact Limits.pullback.lift_fst _ _ _
  have hBs : ∀ {U U' : T.left.Etale} (h : U' ⟶ U),
      ((wcEtBaseChange p).map ((wcEtSlice T).map h)).left ≫
        Limits.pullback.snd ((wcEtSlice T).obj U).hom p =
      Limits.pullback.snd ((wcEtSlice T).obj U').hom p := by
    intro U U' h
    exact Limits.pullback.lift_snd _ _ _
  have hrange : ∀ {U U' : T.left.Etale} (h : U' ⟶ U), Set.range (g U') =
      ((wcEtBaseChange p).map ((wcEtSlice T).map h)).left ⁻¹' Set.range (g U) := by
    intro U U' h
    exact (wc_sheet_graph_isPullback p ((wcEtSlice T).obj U).hom ((wcEtSlice T).obj U').hom
      (U.hom ≫ s) h.left (g U) (g U') ((wcEtBaseChange p).map ((wcEtSlice T).map h)).left
      ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ T.hom) (MorphismProperty.Over.w h)))
      (hg1 U) (hg2 U) (hg1 U')
      ((hg2 U').trans ((congrArg (· ≫ s) (MorphismProperty.Over.w h)).symm.trans
        (Category.assoc _ _ _)))
      (hBf h) (hBs h)).2

  choose e he1 he2 he3 using fun (N : SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)) (U : T.left.Etale) =>
    wc_et_clopen_sheet_ext_zero N (γ U) (hgeom U).1 (hgeom U).2
  have hmc : ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)) {O₁ O₂ O₃ : Y'.Etale}
      (f₁ : O₁ ⟶ O₂) (f₂ : O₂ ⟶ O₃) (x : N.val.obj (Opposite.op O₃)),
      (N.val.map (f₁ ≫ f₂).op).hom x = (N.val.map f₁.op).hom ((N.val.map f₂.op).hom x) := by
    intro N O₁ O₂ O₃ f₁ f₂ x
    rw [op_comp, PresheafOfModules.map_comp]
    rfl
  have hnat : ∀ {N N' : SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)} (φ : N ⟶ N') {O O' : Y'.Etale}
      (f : O ⟶ O') (x : N.val.obj (Opposite.op O')),
      (N'.val.map f.op).hom ((φ.val.app (Opposite.op O')).hom x) =
        (φ.val.app (Opposite.op O)).hom ((N.val.map f.op).hom x) := by
    intro N N' φ O O' f x
    exact (ConcreteCategory.congr_hom (φ.val.naturality f.op) x).symm

  have hC1 : ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)) (U : T.left.Etale)
      (a : N.val.obj (Opposite.op ((wcEtSliceOf T.left s hsE).obj U))) (O : Y'.Etale)
      (k : O ⟶ (wcEtSliceOf T.left s hsE).obj U) (w : O ⟶ (wcEtBaseChange p).obj ((wcEtSlice T).obj U)),
      w.left ≫ Limits.pullback.fst ((wcEtSlice T).obj U).hom p = k.left →
      (N.val.map w.op).hom (e N U a) = (N.val.map k.op).hom a := by
    intro N U a O k w hw
    have hwk : w = k ≫ γ U := by
      apply MorphismProperty.Over.Hom.ext
      show w.left = k.left ≫ (γ U).left
      rw [hγ U]
      apply Limits.pullback.hom_ext
      · exact hw.trans ((Category.comp_id _).symm.trans
          ((congrArg (k.left ≫ ·) (hg1 U)).symm.trans (Category.assoc _ _ _).symm))
      · exact (MorphismProperty.Over.w w).trans ((MorphismProperty.Over.w k).symm.trans
          ((congrArg (k.left ≫ ·) (hg2 U)).symm.trans (Category.assoc _ _ _).symm))
    subst hwk
    rw [hmc, he1]

  have hnatU : ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)) {U U' : T.left.Etale} (h : U' ⟶ U)
      (a : N.val.obj (Opposite.op ((wcEtSliceOf T.left s hsE).obj U))),
      e N U' ((N.val.map ((wcEtSliceOf T.left s hsE).map h).op).hom a) =
        (N.val.map ((wcEtBaseChange p).map ((wcEtSlice T).map h)).op).hom (e N U a) := by
    intro N U U' h a
    apply he3 N U'
    · have hfst : ((γ U').left ≫ ((wcEtBaseChange p).map ((wcEtSlice T).map h)).left) ≫
          Limits.pullback.fst ((wcEtSlice T).obj U).hom p = h.left :=
        (Category.assoc _ _ _).trans ((congrArg ((γ U').left ≫ ·) (hBf h)).trans
          ((Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ h.left) ((congrArg (· ≫ Limits.pullback.fst ((wcEtSlice T).obj U').hom p)
              (hγ U')).trans (hg1 U'))).trans (Category.id_comp _))))
      exact (he1 N U' _).trans ((hC1 N U a _ ((wcEtSliceOf T.left s hsE).map h)
        (γ U' ≫ (wcEtBaseChange p).map ((wcEtSlice T).map h)) hfst).symm.trans (hmc N _ _ _))
    · intro O w hw
      have hdisj : Disjoint (Set.range (w ≫ (wcEtBaseChange p).map ((wcEtSlice T).map h)).left)
          (Set.range (γ U).left) := by
        rw [Set.disjoint_left]
        rintro x ⟨o, rfl⟩ ⟨y, hy⟩
        have h1 : (w ≫ (wcEtBaseChange p).map ((wcEtSlice T).map h)).left o =
            ((wcEtBaseChange p).map ((wcEtSlice T).map h)).left (w.left o) :=
          Scheme.Hom.comp_apply _ _ _
        have hx' : ((wcEtBaseChange p).map ((wcEtSlice T).map h)).left (w.left o) ∈
            Set.range (g U) :=
          ⟨y, (congrArg (fun f => f y) (hγ U)).symm.trans (hy.trans h1)⟩
        obtain ⟨y', hy'⟩ := (Set.ext_iff.mp (hrange h) (w.left o)).mpr hx'
        exact Set.disjoint_left.mp hw ⟨o, rfl⟩ ⟨y', (congrArg (fun f => f y') (hγ U')).trans hy'⟩
      exact (he2 N U' O w hw _).trans ((he2 N U O _ hdisj a).symm.trans (hmc N _ _ _))

  have hnatN : ∀ {N N' : SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)} (φ : N ⟶ N') (U : T.left.Etale)
      (a : N.val.obj (Opposite.op ((wcEtSliceOf T.left s hsE).obj U))),
      e N' U ((φ.val.app (Opposite.op ((wcEtSliceOf T.left s hsE).obj U))).hom a) =
        (φ.val.app (Opposite.op ((wcEtBaseChange p).obj ((wcEtSlice T).obj U)))).hom (e N U a) := by
    intro N N' φ U a
    apply he3 N' U
    · exact (he1 N' U _).trans ((congrArg (φ.val.app _).hom (he1 N U a)).symm.trans
        (hnat φ (γ U) (e N U a)).symm)
    · intro O w hw
      exact (he2 N' U O w hw _).trans ((LinearMap.map_zero (φ.val.app (Opposite.op O)).hom).symm.trans
        ((congrArg (φ.val.app _).hom (he2 N U O w hw a)).symm.trans (hnat φ w _).symm))

  let E : ∀ N : SheafOfModules.{u+1} (wcEtZModRing Y' ℓ),
      (SheafOfModules.toSheaf (wcEtZModRing T.left ℓ)).obj
        ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSliceOf T.left s hsE) _ _ hcY ψY).obj N) ⟶
      (SheafOfModules.toSheaf (wcEtZModRing T.left ℓ)).obj
        (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ) ⋙
          (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX)).obj N) :=
    fun N => ObjectProperty.homMk
      { app := fun V => AddCommGrpCat.ofHom (e N V.unop)
        naturality := fun V V' f => by
          ext a
          exact hnatU N f.unop a }
  have := hFull
  have hcomp : ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)) (U : T.left.Etale)
      (a : N.val.obj (Opposite.op ((wcEtSliceOf T.left s hsE).obj U))),
      (((SheafOfModules.toSheaf (wcEtZModRing T.left ℓ)).preimage (E N)).val.app
        (Opposite.op U)).hom a = e N U a := by
    intro N U a
    have h := congrArg (fun f => (f.hom.app (Opposite.op U)).hom a)
      ((SheafOfModules.toSheaf (wcEtZModRing T.left ℓ)).map_preimage (E N))
    exact h
  refine ⟨{ app := fun N => (SheafOfModules.toSheaf (wcEtZModRing T.left ℓ)).preimage (E N)
            naturality := ?_ }, ?_⟩
  · intro N N' φ
    apply (SheafOfModules.toSheaf (wcEtZModRing T.left ℓ)).map_injective
    rw [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp,
      CategoryTheory.Functor.map_preimage, CategoryTheory.Functor.map_preimage]
    apply Sheaf.hom_ext
    ext V a
    exact hnatN φ V.unop a
  · intro N U a
    refine ⟨fun O k w hw => ?_, fun O w hw => ?_⟩
    · exact (congrArg (N.val.map w.op).hom (hcomp N U a)).trans (hC1 N U a O k w hw)
    · exact (congrArg (N.val.map w.op).hom (hcomp N U a)).trans
        (he2 N U O w ((hγ U).trans (hg U) ▸ hw) a)

theorem wc_et_sheet_ext_zero_isIso : ∀ (K : Type u) [Field K] {X Y' : Scheme.{u}} (p : Y' ⟶ X) [IsFinite p] (y₀' : Spec (.of K) ⟶ Y') {ℓ : ℕ} (Dp : wcEtPullData p ℓ) (T : X.Etale) (t₀ : Spec (.of K) ⟶ T.left) (s : T.left ⟶ Y') (hs : s ≫ p = T.hom) (hsE : Etale s), wcEtLocalSheet K p y₀' T t₀ s hs → ∀ (hcX : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)) (hcY : (wcEtSliceOf T.left s hsE).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y')) (ψX : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hcX).obj (wcEtZModRing X ℓ)) (ψY : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSliceOf T.left s hsE) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y') hcY).obj (wcEtZModRing Y' ℓ)) (N : SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)) (f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSliceOf T.left s hsE) _ _ hcY ψY).obj N ⟶ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX).obj ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).obj N)), wcEtSheetExtZero p Dp T s hs hsE hcX hcY ψX ψY N f → (∀ W : Y'.Etale, (∀ w : W.left, W.hom w ∉ Set.range y₀') → Subsingleton ↑(N.val.obj (Opposite.op W))) → IsIso f :=
by
  intro K _ X Y' p _ y₀' ℓ Dp T t₀ s hs hsE hsheet hcX hcY ψX ψY N f hf hvan

  have s1 : ∀ {M M' : SheafOfModules.{u+1} (wcEtZModRing T.left ℓ)} (g : M ⟶ M'),
      (∀ V : (T.left.Etale)ᵒᵖ, Function.Bijective (g.val.app V).hom) → IsIso g := by
    intro M M' g h
    have hU : ∀ V, IsIso (((PresheafOfModules.toPresheaf _).map
        ((SheafOfModules.forget _).map g)).app V) := by
      intro V
      have h2 : IsIso ((forget AddCommGrpCat.{u+1}).map (((PresheafOfModules.toPresheaf _).map
          ((SheafOfModules.forget _).map g)).app V)) := (isIso_iff_bijective _).mpr (h V)
      exact isIso_of_reflects_iso _ (forget AddCommGrpCat.{u+1})
    have h3 : IsIso ((PresheafOfModules.toPresheaf _).map ((SheafOfModules.forget _).map g)) :=
      NatIso.isIso_of_isIso_app _
    have h4 : IsIso ((SheafOfModules.forget _).map g) :=
      isIso_of_reflects_iso _ (PresheafOfModules.toPresheaf _)
    exact isIso_of_reflects_iso g (SheafOfModules.forget _)

  have s4 : ∀ {X₁ Y₁ U₁ : Scheme.{u}} (p₁ : Y₁ ⟶ X₁) [IsFinite p₁] (v : U₁ ⟶ X₁) (σ : U₁ ⟶ Y₁)
      (h : σ ≫ p₁ = v), IsClosed (Set.range (Limits.pullback.lift (f := v) (g := p₁) (𝟙 U₁) σ
        (by rw [Category.id_comp, h]))) := by
    intro X₁ Y₁ U₁ p₁ _ v σ h
    have : IsClosedImmersion (Limits.pullback.lift (f := v) (g := p₁) (𝟙 U₁) σ
        (by rw [Category.id_comp, h]) ≫ Limits.pullback.fst v p₁) := by
      rw [Limits.pullback.lift_fst]; infer_instance
    have : IsClosedImmersion (Limits.pullback.lift (f := v) (g := p₁) (𝟙 U₁) σ
        (by rw [Category.id_comp, h])) :=
      IsClosedImmersion.of_comp _ (Limits.pullback.fst v p₁)
    exact (Scheme.Hom.isClosedEmbedding _).isClosed_range

  have s3 : ∀ {X₁ Y₁ T₁ U₁ : Scheme.{u}} (p₁ : Y₁ ⟶ X₁) (τ : T₁ ⟶ X₁) (s₁ : T₁ ⟶ Y₁)
      (hs₁ : s₁ ≫ p₁ = τ) (u₁ : U₁ ⟶ T₁) (y : Y₁),
      (∀ z : ↥(Limits.pullback τ p₁), Limits.pullback.snd τ p₁ z = y →
        z ∈ Set.range (Limits.pullback.lift (f := τ) (g := p₁) (𝟙 T₁) s₁
          (by rw [Category.id_comp, hs₁]))) →
      ∀ e : ↥(Limits.pullback (u₁ ≫ τ) p₁), Limits.pullback.snd (u₁ ≫ τ) p₁ e = y →
        e ∈ Set.range (Limits.pullback.lift (f := u₁ ≫ τ) (g := p₁) (𝟙 U₁) (u₁ ≫ s₁)
          (by rw [Category.id_comp, Category.assoc, hs₁])) := by
    intro X₁ Y₁ T₁ U₁ p₁ τ s₁ hs₁ u₁ y hL e he
    let Γ := Limits.pullback.lift (f := τ) (g := p₁) (𝟙 T₁) s₁ (by rw [Category.id_comp, hs₁])
    let g := Limits.pullback.lift (f := u₁ ≫ τ) (g := p₁) (𝟙 U₁) (u₁ ≫ s₁)
      (by rw [Category.id_comp, Category.assoc, hs₁])
    let φ : Limits.pullback (u₁ ≫ τ) p₁ ⟶ Limits.pullback τ p₁ :=
      Limits.pullback.lift (Limits.pullback.fst (u₁ ≫ τ) p₁ ≫ u₁) (Limits.pullback.snd (u₁ ≫ τ) p₁)
        (by rw [Category.assoc, Limits.pullback.condition])
    have hφ1 : φ ≫ Limits.pullback.fst τ p₁ = Limits.pullback.fst (u₁ ≫ τ) p₁ ≫ u₁ :=
      Limits.pullback.lift_fst _ _ _
    have hφ2 : φ ≫ Limits.pullback.snd τ p₁ = Limits.pullback.snd (u₁ ≫ τ) p₁ :=
      Limits.pullback.lift_snd _ _ _
    have hΓ1 : Γ ≫ Limits.pullback.fst τ p₁ = 𝟙 T₁ := Limits.pullback.lift_fst _ _ _
    have hΓ2 : Γ ≫ Limits.pullback.snd τ p₁ = s₁ := Limits.pullback.lift_snd _ _ _
    have hg1 : g ≫ Limits.pullback.fst (u₁ ≫ τ) p₁ = 𝟙 U₁ := Limits.pullback.lift_fst _ _ _
    have hg2 : g ≫ Limits.pullback.snd (u₁ ≫ τ) p₁ = u₁ ≫ s₁ := Limits.pullback.lift_snd _ _ _
    have hφe : Limits.pullback.snd τ p₁ (φ e) = y := by
      rw [← Scheme.Hom.comp_apply, hφ2, he]
    obtain ⟨t, ht⟩ := hL (φ e) hφe
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := φ) (g := Γ) e t ht.symm
    have hQ : Limits.pullback.fst φ Γ ≫ φ = Limits.pullback.snd φ Γ ≫ Γ :=
      Limits.pullback.condition
    have e1 : Limits.pullback.fst φ Γ ≫ Limits.pullback.fst (u₁ ≫ τ) p₁ ≫ u₁ =
        Limits.pullback.snd φ Γ := by
      rw [← hφ1, ← Category.assoc, hQ, Category.assoc, hΓ1, Category.comp_id]
    have e2 : Limits.pullback.fst φ Γ ≫ Limits.pullback.snd (u₁ ≫ τ) p₁ =
        Limits.pullback.snd φ Γ ≫ s₁ := by
      rw [← hφ2, ← Category.assoc, hQ, Category.assoc, hΓ2]
    have hm : Limits.pullback.fst φ Γ ≫ Limits.pullback.fst (u₁ ≫ τ) p₁ ≫ g =
        Limits.pullback.fst φ Γ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, hg1, Category.comp_id]
      · rw [Category.assoc, Category.assoc, hg2, e2, ← e1, Category.assoc, Category.assoc]
    have h' : (Limits.pullback.fst φ Γ ≫ Limits.pullback.fst (u₁ ≫ τ) p₁ ≫ g) w =
        Limits.pullback.fst φ Γ w := by rw [hm]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hw1] at h'
    exact ⟨_, h'⟩

  have s2 : ∀ {A B : Y'.Etale} (j : A ⟶ B), IsClosed (Set.range j.left) →
      (∀ (O : Y'.Etale) (h : O ⟶ B), (∀ o : O.left, h.left o ∉ Set.range j.left) →
        Subsingleton ↑(N.val.obj (Opposite.op O))) →
      ∀ x y : ↑(N.val.obj (Opposite.op B)),
        (N.val.map j.op).hom x = (N.val.map j.op).hom y → x = y := by
    intro A B j hcl hv x y hxy
    let S : Sieve B :=
      { arrows := fun Z g => (∃ h : Z ⟶ A, g = h ≫ j) ∨ (∀ z : Z.left, g.left z ∉ Set.range j.left)
        downward_closed := by
          rintro Z Z' g (⟨h, rfl⟩ | hg) k
          · exact Or.inl ⟨k ≫ h, (Category.assoc _ _ _).symm⟩
          · right
            intro z
            show (k.left ≫ g.left) z ∉ _
            rw [Scheme.Hom.comp_apply]
            exact hg _ }
    have hS : S ∈ Scheme.smallEtaleTopology Y' B := by
      refine (congrArg (fun J : GrothendieckTopology Y'.Etale => S ∈ J B)
        (@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale
          Y' MorphismProperty.IsMultiplicative.toIsStableUnderComposition
          _ _ _ _ le_rfl)).mpr
        ((@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y'
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ B S).2 ?_)
      intro x
      by_cases hx : x ∈ Set.range j.left
      · obtain ⟨a, rfl⟩ := hx
        refine ⟨A, j, a, Or.inl ⟨𝟙 A, (Category.id_comp j).symm⟩, ?_, rfl⟩
        have hA : Etale (j.left ≫ B.hom) := by rw [MorphismProperty.Over.w j]; exact A.prop
        exact MorphismProperty.of_postcomp (W' := @Etale) @Etale j.left B.hom B.prop hA
      · let Cc : B.left.Opens := ⟨(Set.range j.left)ᶜ, hcl.isOpen_compl⟩
        let O : Y'.Etale := MorphismProperty.Over.mk ⊤ (Cc.ι ≫ B.hom)
          (by have : Etale B.hom := B.prop; infer_instance)
        let i₂ : O ⟶ B := MorphismProperty.Over.homMk Cc.ι rfl trivial
        refine ⟨O, i₂, (⟨x, hx⟩ : Cc), Or.inr ?_, ?_, ?_⟩
        · intro z hz
          have hm : Cc.ι z ∈ Set.range Cc.ι := Set.mem_range_self _
          rw [Scheme.Opens.range_ι] at hm
          exact (hm : Cc.ι z ∈ (Set.range j.left)ᶜ) hz
        · show Etale Cc.ι
          infer_instance
        · exact Scheme.Opens.ι_apply _ _
    let F := (SheafOfModules.toSheaf (wcEtZModRing Y' ℓ)).obj N
    have key : ∀ x' y' : F.obj.obj (Opposite.op B),
        (∀ (Z : Y'.Etale) (g : Z ⟶ B), S.arrows g → F.obj.map g.op x' = F.obj.map g.op y') →
        x' = y' := fun x' y' => F.isSeparated B S hS x' y'
    refine key x y ?_
    intro Z g hg
    rcases hg with ⟨h, rfl⟩ | hg
    · have e : ∀ z : F.obj.obj (Opposite.op B),
          F.obj.map (h ≫ j).op z = F.obj.map h.op (F.obj.map j.op z) := by
        intro z
        rw [op_comp, Functor.map_comp]
        rfl
      have hxy' : F.obj.map j.op x = F.obj.map j.op y := hxy
      exact (e x).trans ((congrArg (F.obj.map h.op) hxy').trans (e y).symm)
    · exact @Subsingleton.elim _ (hv Z g hg) _ _

  have mapid : ∀ (V : Y'.Etale) (z : ↑(N.val.obj (Opposite.op V))),
      (N.val.map (𝟙 (Opposite.op V))).hom z = z := by
    intro V z
    first
      | (simp; done)
      | (simp; rfl)
      | (let F := (SheafOfModules.toSheaf (wcEtZModRing Y' ℓ)).obj N
         have h := ConcreteCategory.congr_hom (F.obj.map_id (Opposite.op V)) z
         exact h)

  apply s1 f
  rintro ⟨U⟩
  let gU := Limits.pullback.lift (f := ((wcEtSlice T).obj U).hom) (g := p) (𝟙 U.left) (U.hom ≫ s)
    (show 𝟙 U.left ≫ (U.hom ≫ T.hom) = (U.hom ≫ s) ≫ p by
      rw [Category.id_comp, Category.assoc, hs])
  let j : (wcEtSliceOf T.left s hsE).obj U ⟶ (wcEtBaseChange p).obj ((wcEtSlice T).obj U) :=
    MorphismProperty.Over.homMk gU
      (Limits.pullback.lift_snd (f := ((wcEtSlice T).obj U).hom) (g := p) (𝟙 U.left) (U.hom ≫ s)
        (show 𝟙 U.left ≫ (U.hom ≫ T.hom) = (U.hom ≫ s) ≫ p by
          rw [Category.id_comp, Category.assoc, hs])) trivial

  have hr : ∀ a, (N.val.map j.op).hom ((f.val.app (Opposite.op U)).hom a) = a := by
    intro a
    have h1 := (hf U a).1 _ (𝟙 _) j
      (Limits.pullback.lift_fst (f := ((wcEtSlice T).obj U).hom) (g := p) (𝟙 U.left) (U.hom ≫ s)
        (show 𝟙 U.left ≫ (U.hom ≫ T.hom) = (U.hom ≫ s) ≫ p by
          rw [Category.id_comp, Category.assoc, hs]))
    exact h1.trans (mapid ((wcEtSliceOf T.left s hsE).obj U) a)

  have hvB : ∀ (O : Y'.Etale) (h : O ⟶ (wcEtBaseChange p).obj ((wcEtSlice T).obj U)),
      (∀ o : O.left, h.left o ∉ Set.range j.left) → Subsingleton ↑(N.val.obj (Opposite.op O)) := by
    intro O h hO
    apply hvan O
    rintro o ⟨k, hk⟩
    apply hO o
    have hk' : y₀' k = y₀' (IsLocalRing.closedPoint K) := by
      rw [Subsingleton.elim k (IsLocalRing.closedPoint K)]
    have hsnd : Limits.pullback.snd (U.hom ≫ T.hom) p (h.left o) =
        y₀' (IsLocalRing.closedPoint K) := by
      have e : h.left ≫ Limits.pullback.snd (U.hom ≫ T.hom) p = O.hom := MorphismProperty.Over.w h
      have h2 : (h.left ≫ Limits.pullback.snd (U.hom ≫ T.hom) p) o = O.hom o := by rw [e]
      first
        | exact (Scheme.Hom.comp_apply _ _ o).symm.trans (h2.trans (hk.symm.trans hk'))
        | (rw [Scheme.Hom.comp_apply] at h2; exact h2.trans (hk.symm.trans hk'))
    exact s3 p T.hom s hs U.hom _ hsheet.2.2.2.2 (h.left o) hsnd

  have hcl : IsClosed (Set.range j.left) :=
    s4 p (U.hom ≫ T.hom) (U.hom ≫ s) (by rw [Category.assoc, hs])
  have hinj := s2 j hcl hvB

  refine ⟨fun a a' haa => ?_, fun b => ⟨(N.val.map j.op).hom b, hinj _ _ (hr _)⟩⟩
  exact (hr a).symm.trans ((congrArg (N.val.map j.op).hom haa).trans (hr a'))

theorem wc_et_sheet_ext_zero_trace : ∀ {X Y' : Scheme.{u}} (p : Y' ⟶ X) {ℓ : ℕ} (Dp : wcEtPullData p ℓ) (T : X.Etale) (s : T.left ⟶ Y') (hs : s ≫ p = T.hom) (hsE : Etale s), IsOpenImmersion (Limits.pullback.lift (f := T.hom) (g := p) (𝟙 T.left) s (by simp [hs])) → ∀ (hcX : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)) (hcY : (wcEtSliceOf T.left s hsE).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y')) (ψX : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSlice T) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X) hcX).obj (wcEtZModRing X ℓ)) (ψY : wcEtZModRing T.left ℓ ⟶ (@Functor.sheafPushforwardContinuous _ _ _ _ (wcEtSliceOf T.left s hsE) RingCat.{u+1} _ (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y') hcY).obj (wcEtZModRing Y' ℓ)) (τ : wcEtSuppObj Dp ⟶ SheafOfModules.unit (wcEtZModRing X ℓ)) (f : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSliceOf T.left s hsE) _ _ hcY ψY).obj (SheafOfModules.unit (wcEtZModRing Y' ℓ)) ⟶ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX).obj ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).obj (SheafOfModules.unit (wcEtZModRing Y' ℓ)))), wcEtSheetExtZero p Dp T s hs hsE hcX hcY ψX ψY (SheafOfModules.unit (wcEtZModRing Y' ℓ)) f → wcEtSheetNorm Dp τ → @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtSliceOf T.left s hsE) _ _ hcY ψY ≫ f ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX).map τ = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX :=
by
  intro X Y' p ℓ Dp T s hs hsE hΓ hcX hcY ψX ψY τ f hE hτ

  have gf : ∀ (U : T.left.Etale) (O : Scheme.{u}) (w : O ⟶ Limits.pullback (U.hom ≫ T.hom) p),
      Set.range w ⊆ Set.range (Limits.pullback.lift (f := U.hom ≫ T.hom) (g := p) (𝟙 U.left)
        (U.hom ≫ s) (by rw [Category.id_comp, Category.assoc, hs])) →
      w ≫ Limits.pullback.fst (U.hom ≫ T.hom) p ≫ U.hom ≫ s =
        w ≫ Limits.pullback.snd (U.hom ≫ T.hom) p := by
    intro U O w hw
    obtain ⟨Γ, hΓi, hΓ1, hΓ2⟩ : ∃ Γ : T.left ⟶ Limits.pullback T.hom p, IsOpenImmersion Γ ∧
        Γ ≫ Limits.pullback.fst T.hom p = 𝟙 T.left ∧ Γ ≫ Limits.pullback.snd T.hom p = s :=
      ⟨_, hΓ, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨m, hm1, hm2⟩ : ∃ m : Limits.pullback (U.hom ≫ T.hom) p ⟶ Limits.pullback T.hom p,
        m ≫ Limits.pullback.fst T.hom p = Limits.pullback.fst (U.hom ≫ T.hom) p ≫ U.hom ∧
        m ≫ Limits.pullback.snd T.hom p = Limits.pullback.snd (U.hom ≫ T.hom) p :=
      ⟨Limits.pullback.lift (Limits.pullback.fst (U.hom ≫ T.hom) p ≫ U.hom)
        (Limits.pullback.snd (U.hom ≫ T.hom) p)
        (by rw [Category.assoc, Limits.pullback.condition]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hgm : Limits.pullback.lift (f := U.hom ≫ T.hom) (g := p) (𝟙 U.left) (U.hom ≫ s)
        (by rw [Category.id_comp, Category.assoc, hs]) ≫ m = U.hom ≫ Γ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hm1, Limits.pullback.lift_fst_assoc, Category.id_comp,
          Category.assoc, hΓ1]
        exact (Category.comp_id _).symm
      · rw [Category.assoc, hm2, Limits.pullback.lift_snd, Category.assoc, hΓ2]
    have hr : Set.range (w ≫ m) ⊆ Set.range Γ := by
      rintro _ ⟨o, rfl⟩
      obtain ⟨x, hx⟩ := hw ⟨o, rfl⟩
      refine ⟨U.hom x, ?_⟩
      have h := congrArg (fun φ : U.left ⟶ Limits.pullback T.hom p => φ x) hgm
      simp only [Scheme.Hom.comp_apply] at h
      rw [Scheme.Hom.comp_apply, ← hx, h]
    have hfac := IsOpenImmersion.lift_fac Γ (w ≫ m) hr
    have h1 : IsOpenImmersion.lift Γ (w ≫ m) hr =
        w ≫ Limits.pullback.fst (U.hom ≫ T.hom) p ≫ U.hom := by
      have := congrArg (· ≫ Limits.pullback.fst T.hom p) hfac
      simp only [Category.assoc, hΓ1, hm1, Category.comp_id] at this
      exact this
    have h2 : IsOpenImmersion.lift Γ (w ≫ m) hr ≫ s =
        w ≫ Limits.pullback.snd (U.hom ≫ T.hom) p := by
      have := congrArg (· ≫ Limits.pullback.snd T.hom p) hfac
      simp only [Category.assoc, hΓ2, hm2] at this
      exact this
    rw [← h2, h1]
    simp only [Category.assoc]

  apply (SheafOfModules.unitHomEquiv _).injective
  apply Subtype.ext
  funext V
  rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
  obtain ⟨U⟩ := V
  have hσ : (U.hom ≫ s) ≫ p = ((wcEtSlice T).obj U).hom := by
    show (U.hom ≫ s) ≫ p = U.hom ≫ T.hom
    rw [Category.assoc, hs]
  have ha : @Eq ((wcEtZModRing Y' ℓ).obj.obj (Opposite.op ((wcEtSliceOf T.left s hsE).obj U)))
      (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtSliceOf T.left s hsE) _ _ hcY
        ψY).val.app (Opposite.op U)).hom (1 : (wcEtZModRing T.left ℓ).obj.obj (Opposite.op U))) 1 :=
    @Eq.trans ((wcEtZModRing Y' ℓ).obj.obj (Opposite.op ((wcEtSliceOf T.left s hsE).obj U))) _ _ _
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply ψY _)
      (map_one (ψY.hom.app (Opposite.op U)).hom)
  have hR : @Eq ((wcEtZModRing X ℓ).obj.obj (Opposite.op ((wcEtSlice T).obj U)))
      (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtSlice T) _ _ hcX
        ψX).val.app (Opposite.op U)).hom (1 : (wcEtZModRing T.left ℓ).obj.obj (Opposite.op U))) 1 :=
    @Eq.trans ((wcEtZModRing X ℓ).obj.obj (Opposite.op ((wcEtSlice T).obj U))) _ _ _
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply ψX _)
      (map_one (ψX.hom.app (Opposite.op U)).hom)
  have key := hτ ((wcEtSlice T).obj U) (U.hom ≫ s) hσ
    ((f.val.app (Opposite.op U)).hom
      (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtSliceOf T.left s hsE) _ _ hcY
        ψY).val.app (Opposite.op U)).hom (1 : (wcEtZModRing T.left ℓ).obj.obj (Opposite.op U))))
    (by
      intro O w hw
      have hk : (w.left ≫ Limits.pullback.fst ((wcEtSlice T).obj U).hom p) ≫
          ((wcEtSliceOf T.left s hsE).obj U).hom = O.hom :=
        (Category.assoc _ _ _).trans ((gf U O.left w.left hw).trans (MorphismProperty.Over.w w))
      let k : O ⟶ (wcEtSliceOf T.left s hsE).obj U := MorphismProperty.Over.homMk
          (w.left ≫ Limits.pullback.fst ((wcEtSlice T).obj U).hom p) hk trivial
      have h1 := (hE U
        (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtSliceOf T.left s hsE) _ _ hcY
          ψY).val.app (Opposite.op U)).hom
            (1 : (wcEtZModRing T.left ℓ).obj.obj (Opposite.op U)))).1 O k w rfl
      have h2 := congrArg ((SheafOfModules.unit (wcEtZModRing Y' ℓ)).val.map k.op).hom ha
      have h3 := PresheafOfModules.unit_map_one (wcEtZModRing Y' ℓ).obj k.op
      exact h1.trans (h2.trans h3))
    (fun O w hw => (hE U _).2 O w hw)
  exact key.trans hR.symm

