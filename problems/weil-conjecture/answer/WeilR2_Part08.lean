theorem wc_et_coh_gm_product_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [LocallyOfFiniteType fX] (q : ℕ), Finite (wcEtCoh X ℓ (q + 1)) → Finite (wcEtCoh X ℓ q) → Finite (wcEtCoh (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ (q + 1)) ∧ Nat.card (wcEtCoh (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ (q + 1)) ≤ Nat.card (wcEtCoh X ℓ (q + 1)) * Nat.card (wcEtCoh X ℓ q) :=
by
  classical
  intro K _ _ ℓ hℓ hℓK X fX _ q hfin1 hfin0

  obtain ⟨L, ⟨adj⟩, hPFL, ⟨eℤ⟩⟩ := wc_et_push_left_adjoint (Limits.pullback.fst fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))
