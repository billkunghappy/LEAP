      (∀ k, ε k k = 1) →
      (∀ J k, (Φ ≫ p1) ⁻¹ᵁ U J ⊓ (Φ ≫ p2) ⁻¹ᵁ D k ≤ (Φ ≫ p1) ⁻¹ᵁ X.basicOpen (g J k)) →
      (∀ J k l, (Φ ≫ p2).appLE (D k) ((Φ ≫ p1) ⁻¹ᵁ U J ⊓ (Φ ≫ p2) ⁻¹ᵁ D k) inf_le_right (ε k l) *
          (Φ ≫ p1).appLE (U J) ((Φ ≫ p1) ⁻¹ᵁ U J ⊓ (Φ ≫ p2) ⁻¹ᵁ D k) inf_le_left (g J k) =
        (Φ ≫ p1).appLE (U J) ((Φ ≫ p1) ⁻¹ᵁ U J ⊓ (Φ ≫ p2) ⁻¹ᵁ D k) inf_le_left (g J l)) →
      (∀ J k (F : Γ(X, U J)),
