theorem wc_csd_invpull_open_push : ∀ (X X0 T : Scheme.{u}) (κ : X0 ⟶ X) [IsOpenImmersion κ] [QuasiCompact κ] (I0 : X0.IdealSheafData) (h : T ⟶ X0), wcCsdInvPull I0 h → wcCsdInvPull (I0.map κ) (h ≫ κ) :=
by
  intro X X0 T κ _ _ I0 h H t
  obtain ⟨U0, V, e, a0, ht, ha0, hnzd, hspan⟩ := H t
  have hWaff : IsAffineOpen (κ ''ᵁ U0.1) := IsAffineOpen.image_of_isOpenImmersion U0.2 κ
  have hWle : κ ''ᵁ U0.1 ≤ κ.opensRange := Scheme.Hom.image_le_opensRange κ U0.1
  have HW0 : IsAffineOpen (κ ⁻¹ᵁ (κ ''ᵁ U0.1)) :=
    IsAffineOpen.preimage_of_isOpenImmersion hWaff κ hWle
  let W : X.affineOpens := ⟨κ ''ᵁ U0.1, hWaff⟩
  let W0 : X0.affineOpens := ⟨κ ⁻¹ᵁ (κ ''ᵁ U0.1), HW0⟩
  have hpi : κ ⁻¹ᵁ (κ ''ᵁ U0.1) = U0.1 := Scheme.Hom.preimage_image_eq κ U0.1
  have hle : W0 ≤ U0 := hpi.le
  have e'' : V.1 ≤ h ⁻¹ᵁ W0.1 := by
    intro x hx
    have hx' := e hx
    show h x ∈ κ ⁻¹ᵁ (κ ''ᵁ U0.1)
    rw [hpi]; exact hx'
  have e' : V.1 ≤ (h ≫ κ) ⁻¹ᵁ W.1 := e''
  have hJ : (I0.map κ).ideal W = Ideal.comap (κ.app W.1).hom (I0.ideal W0) :=
    Scheme.IdealSheafData.ideal_map I0 κ W HW0
  have := Scheme.Hom.isIso_app κ W.1 hWle
  have hsurj : Function.Surjective (κ.app W.1).hom :=
    (ConcreteCategory.bijective_of_isIso (κ.app W.1)).2
  have hstar : Ideal.map (κ.app W.1).hom ((I0.map κ).ideal W) = I0.ideal W0 := by
    rw [hJ]; exact Ideal.map_comap_of_surjective _ hsurj _
  have hres : Ideal.map (X0.presheaf.map (homOfLE (show W0.1 ≤ U0.1 from hle)).op).hom
      (I0.ideal U0) = I0.ideal W0 := Scheme.IdealSheafData.map_ideal I0 hle
  have hθ : X0.presheaf.map (homOfLE (show W0.1 ≤ U0.1 from hle)).op ≫ h.appLE W0.1 V.1 e'' =
      h.appLE U0.1 V.1 e := Scheme.Hom.map_appLE h e'' (homOfLE (show W0.1 ≤ U0.1 from hle)).op
  have ha0' : (X0.presheaf.map (homOfLE (show W0.1 ≤ U0.1 from hle)).op).hom a0 ∈ I0.ideal W0 := by
    rw [← hres]; exact Ideal.mem_map_of_mem _ ha0
  obtain ⟨a, hfa⟩ := hsurj ((X0.presheaf.map (homOfLE (show W0.1 ≤ U0.1 from hle)).op).hom a0)
  have ha : a ∈ (I0.map κ).ideal W := by
    rw [hJ, Ideal.mem_comap, hfa]; exact ha0'
  have hψ : (h ≫ κ).appLE W.1 V.1 e' = κ.app W.1 ≫ h.appLE W0.1 V.1 e'' :=
    Scheme.Hom.comp_appLE h κ W.1 V.1 e'
  have hval : ((h ≫ κ).appLE W.1 V.1 e').hom a = (h.appLE U0.1 V.1 e).hom a0 := by
    rw [hψ, ← hθ, CommRingCat.comp_apply, CommRingCat.comp_apply, hfa]
  refine ⟨W, V, e', a, ht, ha, ?_, ?_⟩
  · rw [hval]; exact hnzd
  · rw [hval, ← hspan, hψ, ← hθ, CommRingCat.hom_comp, CommRingCat.hom_comp, ← Ideal.map_map,
      ← Ideal.map_map, hstar, hres]

theorem wc_csd_invpull_open_pull : ∀ (X X0 T : Scheme.{u}) (κ : X0 ⟶ X) [IsOpenImmersion κ] [QuasiCompact κ] (I0 : X0.IdealSheafData) (h : T ⟶ X0), wcCsdInvPull (I0.map κ) (h ≫ κ) → wcCsdInvPull I0 h :=
by
  have wc_csd_invpull_chart_shrink : ∀ (X T : Scheme.{u}) (I : X.IdealSheafData) (r : T ⟶ X) (t : T) (W₀ : X.affineOpens) (V₀ : T.affineOpens) (e₀ : V₀.1 ≤ r ⁻¹ᵁ W₀.1) (a : Γ(X, W₀.1)), t ∈ V₀.1 → (r.appLE W₀.1 V₀.1 e₀).hom a ∈ nonZeroDivisors Γ(T, V₀.1) → Ideal.map (r.appLE W₀.1 V₀.1 e₀).hom (I.ideal W₀) = Ideal.span {(r.appLE W₀.1 V₀.1 e₀).hom a} → ∀ (O : X.Opens), r t ∈ O → ∃ (W : X.affineOpens) (V : T.affineOpens) (e : V.1 ≤ r ⁻¹ᵁ W.1) (ε : Γ(T, V.1)), W.1 ≤ O ∧ t ∈ V.1 ∧ ε ∈ nonZeroDivisors Γ(T, V.1) ∧ Ideal.map (r.appLE W.1 V.1 e).hom (I.ideal W) = Ideal.span {ε} := by
    intro X T I r t W₀ V₀ e₀ a ht hnzd hspan O hO
    obtain ⟨f, hfO, hxf⟩ := W₀.2.exists_basicOpen_le (V := O) ⟨r t, hO⟩ (e₀ ht)
    have hD : T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f) = V₀.1 ⊓ r ⁻¹ᵁ X.basicOpen f :=
      Scheme.basicOpen_appLE _ _ _ _ _
    have e : (T.affineBasicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)).1 ≤
        r ⁻¹ᵁ (X.affineBasicOpen f).1 := by
      show T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f) ≤ r ⁻¹ᵁ X.basicOpen f
      rw [hD]; exact inf_le_right
    have htV : t ∈ (T.affineBasicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)).1 := by
      show t ∈ T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)
      rw [hD]; exact ⟨ht, hxf⟩
    let resT := T.presheaf.map (homOfLE (T.basicOpen_le ((r.appLE W₀.1 V₀.1 e₀).hom f))).op
    refine ⟨X.affineBasicOpen f, T.affineBasicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f), e,
      resT.hom ((r.appLE W₀.1 V₀.1 e₀).hom a), hfO, htV, ?_, ?_⟩
    · have hloc := V₀.2.isLocalization_basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)
      exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers ((r.appLE W₀.1 V₀.1 e₀).hom f))
        Γ(T, T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)) (Submonoid.mem_map_of_mem _ hnzd)
    · have e' : T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f) ≤ r ⁻¹ᵁ X.basicOpen f := e
      let resX := X.presheaf.map (homOfLE (X.basicOpen_le f)).op
      have h1 : Ideal.map resX.hom (I.ideal W₀) = I.ideal (X.affineBasicOpen f) :=
        I.map_ideal_basicOpen W₀ f
      show Ideal.map (r.appLE (X.basicOpen f) (T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
        (I.ideal (X.affineBasicOpen f)) = _
      calc Ideal.map (r.appLE (X.basicOpen f) (T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
            (I.ideal (X.affineBasicOpen f))
          = Ideal.map (r.appLE (X.basicOpen f) (T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
            (Ideal.map resX.hom (I.ideal W₀)) := by rw [h1]; rfl
        _ = Ideal.map (resX ≫ r.appLE (X.basicOpen f)
              (T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)) e').hom (I.ideal W₀) := by
            rw [Ideal.map_map]; rfl
        _ = Ideal.map (r.appLE W₀.1 V₀.1 e₀ ≫ resT).hom (I.ideal W₀) := by
            rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
        _ = Ideal.map resT.hom (Ideal.map (r.appLE W₀.1 V₀.1 e₀).hom (I.ideal W₀)) := by
            rw [CommRingCat.hom_comp, Ideal.map_map]
        _ = _ := by rw [hspan, Ideal.map_span, Set.image_singleton]; rfl
  have wc_csd_invpull_local_generator : ∀ (Y T : Scheme.{u}) (J : Y.IdealSheafData) (h : T ⟶ Y) (U : Y.affineOpens) (V : T.affineOpens) (e : V.1 ≤ h ⁻¹ᵁ U.1) (ε : Γ(T, V.1)) (t : T), t ∈ V.1 → ε ∈ nonZeroDivisors Γ(T, V.1) → Ideal.map (h.appLE U.1 V.1 e).hom (J.ideal U) = Ideal.span {ε} → ∃ (V' : T.affineOpens) (e' : V'.1 ≤ h ⁻¹ᵁ U.1) (b : Γ(Y, U.1)), t ∈ V'.1 ∧ b ∈ J.ideal U ∧ (h.appLE U.1 V'.1 e').hom b ∈ nonZeroDivisors Γ(T, V'.1) ∧ Ideal.map (h.appLE U.1 V'.1 e').hom (J.ideal U) = Ideal.span {(h.appLE U.1 V'.1 e').hom b} := by
    intro Y T J h U V e ε t ht hε hmap
    classical
    have hεmem : ε ∈ Submodule.span Γ(T, V.1)
        ((h.appLE U.1 V.1 e).hom '' (J.ideal U : Set Γ(Y, U.1))) := by
      change ε ∈ Ideal.map (h.appLE U.1 V.1 e).hom (J.ideal U)
      rw [hmap]
      exact Ideal.mem_span_singleton_self ε
    obtain ⟨n, c, g, hcg⟩ := Submodule.mem_span_set'.mp hεmem
    have hg : ∀ i, ∃ a, a ∈ J.ideal U ∧ (h.appLE U.1 V.1 e).hom a = (g i : Γ(T, V.1)) :=
      fun i => (g i).2
    choose a ha hga using hg
    have hy : ∀ i, ∃ y, y * ε = (h.appLE U.1 V.1 e).hom (a i) := by
      intro i
      apply Ideal.mem_span_singleton'.mp
      rw [← hmap]
      exact Ideal.mem_map_of_mem _ (ha i)
    choose y hy using hy
    have hcy : ∑ i, c i * y i = 1 := by
      have h1 : (∑ i, c i * y i) * ε = ε := by
        rw [Finset.sum_mul]
        simp_rw [mul_assoc, hy, hga]
        simpa [smul_eq_mul] using hcg
      have h0 : (∑ i, c i * y i - 1) * ε = 0 := by rw [sub_mul, h1, one_mul, sub_self]
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hε).mp h0)
    obtain ⟨j, hj⟩ : ∃ j, t ∈ T.basicOpen (y j) := by
      by_contra hcon
      push_neg at hcon
      have hm : ∀ j, (T.presheaf.germ V.1 t ht).hom (c j * y j) ∈
          IsLocalRing.maximalIdeal (T.presheaf.stalk t) := by
        intro j
        rw [map_mul]
        apply Ideal.mul_mem_left
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen T (y j) t ht]
        exact hcon j
      have h1 := Ideal.sum_mem (IsLocalRing.maximalIdeal (T.presheaf.stalk t))
        (t := Finset.univ) (fun j _ => hm j)
      rw [← map_sum, hcy, map_one] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
        (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
    have e' : T.basicOpen (y j) ≤ h ⁻¹ᵁ U.1 := (T.basicOpen_le (y j)).trans e
    have hform : ∀ x : Γ(Y, U.1), (h.appLE U.1 (T.basicOpen (y j)) e').hom x =
        (T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom ((h.appLE U.1 V.1 e).hom x) := by
      intro x
      rw [← Scheme.Hom.appLE_map h e (homOfLE (T.basicOpen_le (y j))).op]
      rfl
    have hcomp : (h.appLE U.1 (T.basicOpen (y j)) e').hom =
        (T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom.comp (h.appLE U.1 V.1 e).hom :=
      RingHom.ext hform
    have hε' : (T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom ε ∈
        nonZeroDivisors Γ(T, T.basicOpen (y j)) :=
      @IsLocalization.map_nonZeroDivisors_le _ _ (Submonoid.powers (y j)) _ _ _
        (V.2.isLocalization_basicOpen (y j)) _ (Submonoid.mem_map_of_mem _ hε)
    have hu : IsUnit ((T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom (y j)) :=
      @IsLocalization.Away.algebraMap_isUnit _ _ _ _ _ (y j) (V.2.isLocalization_basicOpen (y j))
    refine ⟨⟨T.basicOpen (y j), V.2.basicOpen (y j)⟩, e', a j, hj, ha j, ?_, ?_⟩
    · show (h.appLE U.1 (T.basicOpen (y j)) e').hom (a j) ∈ nonZeroDivisors Γ(T, T.basicOpen (y j))
      rw [hform, ← hy j, map_mul]
      exact mul_mem_nonZeroDivisors.mpr ⟨hu.mem_nonZeroDivisors, hε'⟩
    · show Ideal.map (h.appLE U.1 (T.basicOpen (y j)) e').hom (J.ideal U) =
        Ideal.span {(h.appLE U.1 (T.basicOpen (y j)) e').hom (a j)}
      rw [hform (a j), ← hy j, map_mul, Ideal.span_singleton_mul_left_unit hu, hcomp,
        ← Ideal.map_map, hmap, Ideal.map_span, Set.image_singleton]
  intro X X0 T κ _ _ I0 h hJ t
  obtain ⟨W₀, V₀, e₀, a, ht₀, -, hnzd₀, hspan₀⟩ := hJ t
  have hmem : (h ≫ κ) t ∈ κ.opensRange := by
    rw [Scheme.Hom.comp_apply, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
    exact Set.mem_range_self (h t)
  obtain ⟨W, V, e, ε, hW, htV, hε, hspanε⟩ :=
    wc_csd_invpull_chart_shrink X T (I0.map κ) (h ≫ κ) t W₀ V₀ e₀ a ht₀ hnzd₀ hspan₀
      κ.opensRange hmem
  obtain ⟨V', e', b, htV', hbJ, hbnzd, hbspan⟩ :=
    wc_csd_invpull_local_generator X T (I0.map κ) (h ≫ κ) W V e ε t htV hε hspanε
  have H : IsAffineOpen (κ ⁻¹ᵁ W.1) := IsAffineOpen.preimage_of_isOpenImmersion W.2 κ hW
  let U0 : X0.affineOpens := ⟨κ ⁻¹ᵁ W.1, H⟩
  have e'' : V'.1 ≤ h ⁻¹ᵁ U0.1 := e'
  have hfac : ((h ≫ κ).appLE W.1 V'.1 e').hom =
      (h.appLE U0.1 V'.1 e'').hom.comp (κ.app W.1).hom := by
    rw [Scheme.Hom.comp_appLE]; rfl
  have hid : (I0.map κ).ideal W = Ideal.comap (κ.app W.1).hom (I0.ideal U0) :=
    Scheme.IdealSheafData.ideal_map I0 κ W H
  haveI := Scheme.Hom.isIso_app κ W.1 hW
  have hsurj : Function.Surjective (κ.app W.1).hom :=
    (ConcreteCategory.bijective_of_isIso (κ.app W.1)).2
  have hstar : Ideal.map (κ.app W.1).hom ((I0.map κ).ideal W) = I0.ideal U0 := by
    rw [hid]; exact Ideal.map_comap_of_surjective _ hsurj _
  have hpt : (h.appLE U0.1 V'.1 e'').hom ((κ.app W.1).hom b) =
      ((h ≫ κ).appLE W.1 V'.1 e').hom b := by
    rw [hfac]; rfl
  refine ⟨U0, V', e'', (κ.app W.1).hom b, htV', ?_, ?_, ?_⟩
  · rw [hid] at hbJ; exact Ideal.mem_comap.mp hbJ
  · rw [hpt]; exact hbnzd
  · rw [hpt, ← hbspan, ← hstar, Ideal.map_map, ← hfac]

theorem wc_csd_blowup_open_restrict : ∀ (X X0 X' X0' : Scheme.{u}) (κ : X0 ⟶ X) [IsOpenImmersion κ] (I0 : X0.IdealSheafData) (J : X.IdealSheafData) (r : X' ⟶ X) (r0 : X0' ⟶ X0), (∀ (T : Scheme.{u}) (h : T ⟶ X0), wcCsdInvPull I0 h ↔ wcCsdInvPull J (h ≫ κ)) → wcCsdIsBlowup J r → wcCsdIsBlowup I0 r0 → ∃ κ' : X0' ⟶ X', IsOpenImmersion κ' ∧ κ' ≫ r = r0 ≫ κ ∧ ∀ x : X', x ∈ Set.range κ' ↔ r x ∈ Set.range κ :=
by
  intro X X0 X' X0' κ _ I0 J r r0 hT hbr hb0

  have hres : ∀ (T T' : Scheme.{u}) (j : T' ⟶ T) [IsOpenImmersion j] (h : T ⟶ X),
      wcCsdInvPull J h → wcCsdInvPull J (j ≫ h) := by
    intro T T' j _ h H t'
    obtain ⟨U, ⟨V, hVaff⟩, e, a, hjt, ha, hN, hI⟩ := H (j t')
    have hmapcomp : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (σ : B ⟶ C) (J : Ideal A) (x : A),
        Ideal.map φ.hom J = Ideal.span {φ.hom x} →
        Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom x} := by
      intro A B C φ σ J x hx
      rw [CommRingCat.hom_comp, ← Ideal.map_map, hx, Ideal.map_span, Set.image_singleton]
      try rfl
    have hiso : ∀ {A B C : CommRingCat.{u}} (ρ : A ⟶ B) (σ : B ⟶ C) [IsIso σ] (J : Ideal A)
        (x : A), ρ.hom x ∈ nonZeroDivisors B → Ideal.map ρ.hom J = Ideal.span {ρ.hom x} →
        (ρ ≫ σ).hom x ∈ nonZeroDivisors C ∧
          Ideal.map (ρ ≫ σ).hom J = Ideal.span {(ρ ≫ σ).hom x} := by
      intro A B C ρ σ _ J x hN hI
      refine ⟨?_, hmapcomp ρ σ J x hI⟩
      rw [← MulEquivClass.map_nonZeroDivisors (asIso σ).commRingCatIsoToRingEquiv]
      exact ⟨ρ.hom x, hN, rfl⟩
    have happ : ∀ (W : T.Opens) (V : T'.Opens) (e : V ≤ j ⁻¹ᵁ W), j ''ᵁ V = W →
        IsIso (j.appLE W V e) := by
      intro W V e hW
      subst hW
      have : j.appLE (j ''ᵁ V) V e = (j.appIso V).hom := by
        rw [Scheme.Hom.appIso_hom]
        rfl
      rw [this]
      infer_instance
    have hjr : j t' ∈ j.opensRange := ⟨t', rfl⟩
    obtain ⟨f, hfO, hft⟩ := hVaff.exists_basicOpen_le (V := V ⊓ j.opensRange) ⟨j t', hjt, hjr⟩ hjt
    have hDR : T.basicOpen f ≤ j.opensRange := hfO.trans inf_le_right
    have eD : T.basicOpen f ≤ h ⁻¹ᵁ U.1 := (T.basicOpen_le f).trans e
    have hfac1 : h.appLE U.1 V e ≫ T.presheaf.map (homOfLE (T.basicOpen_le f)).op =
        h.appLE U.1 (T.basicOpen f) eD := Scheme.Hom.appLE_map _ _ _
    have := hVaff.isLocalization_basicOpen f
    have hN1 : (h.appLE U.1 (T.basicOpen f) eD).hom a ∈ nonZeroDivisors Γ(T, T.basicOpen f) := by
      rw [← hfac1]
      exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers f) Γ(T, T.basicOpen f)
        ⟨_, hN, rfl⟩
    have hI1 := hmapcomp _ (T.presheaf.map (homOfLE (T.basicOpen_le f)).op) _ _ hI
    rw [hfac1] at hI1
    have hV' : IsAffineOpen (j ⁻¹ᵁ T.basicOpen f) :=
      (hVaff.basicOpen f).preimage_of_isOpenImmersion j hDR
    have e' : j ⁻¹ᵁ T.basicOpen f ≤ (j ≫ h) ⁻¹ᵁ U.1 := fun y hy => eD hy
    have hfac2 := Scheme.Hom.appLE_comp_appLE j h U.1 (T.basicOpen f) (j ⁻¹ᵁ T.basicOpen f)
      eD le_rfl
    have himg : j ''ᵁ (j ⁻¹ᵁ T.basicOpen f) = T.basicOpen f := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
      exact inf_eq_right.mpr hDR
    have := happ _ _ (le_rfl : j ⁻¹ᵁ T.basicOpen f ≤ j ⁻¹ᵁ T.basicOpen f) himg
    obtain ⟨g1, g2⟩ := hiso (h.appLE U.1 (T.basicOpen f) eD)
      (j.appLE (T.basicOpen f) (j ⁻¹ᵁ T.basicOpen f) le_rfl) (J.ideal U) a hN1 hI1
    rw [hfac2] at g1 g2
    exact ⟨U, ⟨_, hV'⟩, e', a, hft, ha, g1, g2⟩
  obtain ⟨hr, Ur⟩ := hbr
  set P : X'.Opens := r ⁻¹ᵁ κ.opensRange with hP
  have hcov : ∀ x : X', r x ∈ Set.range κ → x ∈ Set.range P.ι := by
    intro x hx
    rw [Scheme.Opens.range_ι]
    show r x ∈ κ.opensRange
    rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
    exact hx
  have hmemP : ∀ p : P.toScheme, r (P.ι p) ∈ Set.range κ := by
    intro p
    have h1 : P.ι p ∈ Set.range P.ι := ⟨p, rfl⟩
    rw [Scheme.Opens.range_ι] at h1
    have h2 : r (P.ι p) ∈ κ.opensRange := h1
    rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at h2
    exact h2
  have hrange : Set.range (P.ι ≫ r) ⊆ Set.range κ := by
    rintro _ ⟨p, rfl⟩
    exact hmemP p
  obtain ⟨ρ, hρ⟩ : ∃ ρ : P.toScheme ⟶ X0, ρ ≫ κ = P.ι ≫ r :=
    ⟨IsOpenImmersion.lift κ (P.ι ≫ r) hrange, IsOpenImmersion.lift_fac _ _ _⟩

  have hρb1 : wcCsdInvPull I0 ρ := by
    apply (hT P.toScheme ρ).mpr
    rw [hρ]
    exact hres X' P.toScheme P.ι r hr
  have hρb2 : ∀ (T : Scheme.{u}) (h : T ⟶ X0), wcCsdInvPull I0 h →
      ∃! h' : T ⟶ P.toScheme, h' ≫ ρ = h := by
    intro T h hh
    obtain ⟨g, hg, hgu⟩ := Ur T (h ≫ κ) ((hT T h).mp hh)
    have H' : Set.range g ⊆ Set.range P.ι := by
      rintro _ ⟨t, rfl⟩
      apply hcov
      have e : r (g t) = κ (h t) := by
        show (g ≫ r) t = (h ≫ κ) t
        rw [hg]
      rw [e]
      exact ⟨h t, rfl⟩
    have hg' : IsOpenImmersion.lift P.ι g H' ≫ P.ι = g := IsOpenImmersion.lift_fac _ _ _
    refine ⟨IsOpenImmersion.lift P.ι g H', ?_, ?_⟩
    · show IsOpenImmersion.lift P.ι g H' ≫ ρ = h
      rw [← cancel_mono κ, Category.assoc, hρ, ← Category.assoc, hg', hg]
    · intro y hy
      apply IsOpenImmersion.lift_uniq
      apply hgu
      rw [Category.assoc, ← hρ, ← Category.assoc, hy]

  obtain ⟨hp0, U0⟩ := hb0
  obtain ⟨α, hα⟩ := (hρb2 X0' r0 hp0).exists
  obtain ⟨β, hβ⟩ := (U0 P.toScheme ρ hρb1).exists
  have hαβ : α ≫ β = 𝟙 X0' := by
    apply (U0 X0' r0 hp0).unique
    · show (α ≫ β) ≫ r0 = r0
      rw [Category.assoc, hβ, hα]
    · show 𝟙 X0' ≫ r0 = r0
      rw [Category.id_comp]
  have hβα : β ≫ α = 𝟙 P.toScheme := by
    apply (hρb2 P.toScheme ρ hρb1).unique
    · show (β ≫ α) ≫ ρ = ρ
      rw [Category.assoc, hα, hβ]
    · show 𝟙 P.toScheme ≫ ρ = ρ
      rw [Category.id_comp]
  haveI hαiso : IsIso α := ⟨⟨β, hαβ, hβα⟩⟩
  refine ⟨α ≫ P.ι, inferInstance, ?_, ?_⟩
  · rw [Category.assoc, ← hρ, ← Category.assoc, hα]
  · intro x
    constructor
    · rintro ⟨y, rfl⟩
      exact hmemP (α y)
    · intro hx
      obtain ⟨p, hp⟩ := hcov x hx
      refine ⟨β p, ?_⟩
      rw [← hp]
      show P.ι ((β ≫ α) p) = P.ι p
      rw [hβα]
      rfl

theorem wc_csd_tower_extend : ∀ (B : Scheme.{u}) [IsNoetherian B] (O U' : B.Opens) (X0 : Scheme.{u}) (q0 : X0 ⟶ O.toScheme), wcCsdAdmTower O.toScheme (O.ι ⁻¹ᵁ U') X0 q0 → ∃ (X : Scheme.{u}) (q : X ⟶ B) (κ : X0 ⟶ X), wcCsdAdmTower B U' X q ∧ IsOpenImmersion κ ∧ κ ≫ q = q0 ≫ O.ι ∧ ∀ x : X, x ∈ Set.range κ ↔ q x ∈ O :=
by
  intro B _ O U' X0 q0 htow
  suffices H : ∃ (X : Scheme.{u}) (q : X ⟶ B) (κ : X0 ⟶ X), wcCsdAdmTower B U' X q ∧
      IsNoetherian X ∧ IsOpenImmersion κ ∧ κ ≫ q = q0 ≫ O.ι ∧ ∀ x : X, x ∈ Set.range κ ↔ q x ∈ O by
    obtain ⟨X, q, κ, h1, _, h2, h3, h4⟩ := H
    exact ⟨X, q, κ, h1, h2, h3, h4⟩
  induction htow with
  | base =>
    refine ⟨B, 𝟙 B, O.ι, wcCsdAdmTower.base, inferInstance, inferInstance, by simp, ?_⟩
    intro x
    rw [Scheme.Opens.range_ι]
    first
    | exact Iff.rfl
    | simp
  | @step Y0 Y0' p0 I0 r0 htow0 hI0 hb0 ih =>
    obtain ⟨X, q, κ, htowX, hXn, hκ, hκq, hκr⟩ := ih
    haveI := hXn
    haveI := hκ
    haveI : QuasiCompact κ := inferInstance
    have hadm : ((I0.map κ).support : Set X) ∩ ((q ⁻¹ᵁ U' : X.Opens) : Set X) = ∅ := by
      rw [Scheme.IdealSheafData.support_map, TopologicalSpace.Closeds.coe_closure]
      have hsub : κ '' (I0.support : Set Y0) ⊆ ((q ⁻¹ᵁ U' : X.Opens) : Set X)ᶜ := by
        rintro _ ⟨x0, hx0, rfl⟩ hq
        have hq' : (κ ≫ q) x0 ∈ U' := hq
        rw [hκq] at hq'
        have hmem : x0 ∈ (I0.support : Set Y0) ∩
            ((p0 ⁻¹ᵁ (O.ι ⁻¹ᵁ U') : Y0.Opens) : Set Y0) := ⟨hx0, hq'⟩
        rw [hI0] at hmem
        exact hmem
      have hcl : closure (κ '' (I0.support : Set Y0)) ⊆ ((q ⁻¹ᵁ U' : X.Opens) : Set X)ᶜ :=
        closure_minimal hsub (q ⁻¹ᵁ U').isOpen.isClosed_compl
      exact Set.eq_empty_of_subset_empty (fun x hx => hcl hx.1 hx.2)
    obtain ⟨X', r, hbr, hX'n⟩ := wc_csd_blowup_exists_noeth X (I0.map κ)
    have htow' : wcCsdAdmTower B U' X' (r ≫ q) :=
      wcCsdAdmTower.step q (I0.map κ) r htowX hadm hbr
    have hT : ∀ (T : Scheme.{u}) (h : T ⟶ Y0),
        wcCsdInvPull I0 h ↔ wcCsdInvPull (I0.map κ) (h ≫ κ) :=
      fun T h => ⟨wc_csd_invpull_open_push X Y0 T κ I0 h, wc_csd_invpull_open_pull X Y0 T κ I0 h⟩
    obtain ⟨κ', hκ', hκ'r, hκ'range⟩ :=
      wc_csd_blowup_open_restrict X Y0 X' Y0' κ I0 (I0.map κ) r r0 hT hbr hb0
    refine ⟨X', r ≫ q, κ', htow', hX'n, hκ', ?_, ?_⟩
    · rw [← Category.assoc, hκ'r, Category.assoc, hκq, Category.assoc]
    · intro x
      rw [hκ'range, hκr]
      exact Iff.rfl

theorem wc_csd_case1_normalize : ∀ (B' : Scheme.{u}) [IsAffine B'] [IsNoetherian B'] (U' : B'.Opens) (Y : Scheme.{u}) (n : ℕ) (f : U'.toScheme ⟶ Y) (c : Fin n → Γ(Y, ⊤)), ∃ (m N : ℕ) (u : Fin m → Γ(B', ⊤)) (g : Fin m → Fin n → Γ(B', ⊤)) (hle : ∀ i, B'.basicOpen (u i) ≤ U'), 0 < N ∧ U' = ⨆ i, B'.basicOpen (u i) ∧ (∀ i i' j, u i' ^ N * g i j = u i ^ N * g i' j) ∧ ∀ i j, B'.presheaf.map (homOfLE (hle i)).op (U'.topIso.hom (f.appTop (c j))) * (B'.presheaf.map (homOfLE le_top).op (u i)) ^ N = B'.presheaf.map (homOfLE le_top).op (g i j) :=
by
  classical
  intro B' _ _ U' Y n f c

  have hRT : ∀ (U V W : B'.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (s : Γ(B', U)),
      B'.presheaf.map (homOfLE h2).op (B'.presheaf.map (homOfLE h1).op s) =
        B'.presheaf.map (homOfLE (h2.trans h1)).op s := by
    intro U V W h1 h2 s
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  obtain ⟨m, u, hle, hcov⟩ : ∃ (m : ℕ) (u : Fin m → Γ(B', ⊤)),
      (∀ i, B'.basicOpen (u i) ≤ U') ∧ U' = ⨆ i, B'.basicOpen (u i) := by
    have hb : ∀ z : U', ∃ a : Γ(B', ⊤), z.1 ∈ B'.basicOpen a ∧ B'.basicOpen a ≤ U' := by
      intro z
      obtain ⟨V, ⟨a, rfl⟩, hzV, hVU⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (isBasis_basicOpen B')) z.2
      exact ⟨a, hzV, hVU⟩
    choose a hza hale using hb
    have hUc : IsCompact (U' : Set B') := TopologicalSpace.NoetherianSpace.isCompact _
    obtain ⟨t, ht⟩ := hUc.elim_finite_subcover (fun z : U' => (B'.basicOpen (a z) : Set B'))
      (fun z => (B'.basicOpen (a z)).isOpen)
      (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hza ⟨x, hx⟩⟩)
    refine ⟨t.card, fun i => a (t.equivFin.symm i), fun i => hale _,
      le_antisymm ?_ (iSup_le fun i => hale _)⟩
    intro x hx
    have hx' := ht hx
    simp only [Set.mem_iUnion] at hx'
    obtain ⟨z, hz, hxz⟩ := hx'
    refine TopologicalSpace.Opens.mem_iSup.mpr ⟨t.equivFin ⟨z, hz⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hxz

  obtain ⟨s, hs⟩ : ∃ s : Fin n → Γ(B', U'), ∀ j, s j = U'.topIso.hom (f.appTop (c j)) :=
    ⟨_, fun _ => rfl⟩

  have hfr : ∀ i j, ∃ (k : ℕ) (a : Γ(B', ⊤)),
      B'.presheaf.map (homOfLE (hle i)).op (s j) *
        (B'.presheaf.map (homOfLE le_top).op (u i)) ^ k =
        B'.presheaf.map (homOfLE le_top).op a := by
    intro i j
    obtain ⟨k, a, h⟩ := IsLocalization.Away.surj (u i) (B'.presheaf.map (homOfLE (hle i)).op (s j))
    exact ⟨k, a, h⟩
  choose kk a hka using hfr
  obtain ⟨N₀, hN₀⟩ : ∃ N₀ : ℕ, N₀ = 1 + ∑ i, ∑ j, kk i j := ⟨_, rfl⟩
  have hkle : ∀ i j, kk i j ≤ N₀ := by
    intro i j
    have h1 : kk i j ≤ ∑ j, kk i j :=
      Finset.single_le_sum (f := kk i) (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
    have h2 : ∑ j, kk i j ≤ ∑ i, ∑ j, kk i j :=
      Finset.single_le_sum (f := fun i => ∑ j, kk i j) (fun _ _ => Nat.zero_le _)
        (Finset.mem_univ i)
    omega
  obtain ⟨g₀, hg₀⟩ : ∃ g₀ : Fin m → Fin n → Γ(B', ⊤), ∀ i j, g₀ i j = u i ^ (N₀ - kk i j) * a i j :=
    ⟨_, fun _ _ => rfl⟩
  have hfrac : ∀ i j, B'.presheaf.map (homOfLE (hle i)).op (s j) *
      (B'.presheaf.map (homOfLE le_top).op (u i)) ^ N₀ =
      B'.presheaf.map (homOfLE le_top).op (g₀ i j) := by
    intro i j
    obtain ⟨t, ht⟩ : ∃ t, N₀ = kk i j + t := ⟨N₀ - kk i j, by have := hkle i j; omega⟩
    have htt : N₀ - kk i j = t := by omega
    rw [hg₀, htt, ht, pow_add, ← mul_assoc, hka i j, map_mul, map_pow]
    ring

  have hov : ∀ i i' j, ∃ k : ℕ,
      (u i * u i') ^ k * (u i' ^ N₀ * g₀ i j - u i ^ N₀ * g₀ i' j) = 0 := by
    intro i i' j
    have hD := Scheme.basicOpen_mul B' (u i) (u i')
    have hDa : B'.basicOpen (u i * u i') ≤ B'.basicOpen (u i) := by rw [hD]; exact inf_le_left
    have hDb : B'.basicOpen (u i * u i') ≤ B'.basicOpen (u i') := by rw [hD]; exact inf_le_right
    have h1 : B'.presheaf.map (homOfLE (hDa.trans (hle i))).op (s j) *
        (B'.presheaf.map (homOfLE le_top).op (u i)) ^ N₀ =
        B'.presheaf.map (homOfLE (le_top : B'.basicOpen (u i * u i') ≤ ⊤)).op (g₀ i j) := by
      have := congrArg (fun x => B'.presheaf.map (homOfLE hDa).op x) (hfrac i j)
      simp only [map_mul, map_pow, hRT] at this
      exact this
    have h2 : B'.presheaf.map (homOfLE (hDa.trans (hle i))).op (s j) *
        (B'.presheaf.map (homOfLE le_top).op (u i')) ^ N₀ =
        B'.presheaf.map (homOfLE (le_top : B'.basicOpen (u i * u i') ≤ ⊤)).op (g₀ i' j) := by
      have := congrArg (fun x => B'.presheaf.map (homOfLE hDb).op x) (hfrac i' j)
      simp only [map_mul, map_pow, hRT] at this
      exact this
    have hz : algebraMap Γ(B', ⊤) Γ(B', B'.basicOpen (u i * u i'))
        (u i' ^ N₀ * g₀ i j - u i ^ N₀ * g₀ i' j) = 0 := by
      change B'.presheaf.map (homOfLE (le_top : B'.basicOpen (u i * u i') ≤ ⊤)).op
        (u i' ^ N₀ * g₀ i j - u i ^ N₀ * g₀ i' j) = 0
      rw [map_sub, map_mul, map_mul, map_pow, map_pow]
      linear_combination
        (-(B'.presheaf.map (homOfLE (le_top : B'.basicOpen (u i * u i') ≤ ⊤)).op (u i')) ^ N₀) * h1 +
        (B'.presheaf.map (homOfLE (le_top : B'.basicOpen (u i * u i') ≤ ⊤)).op (u i)) ^ N₀ * h2
    obtain ⟨⟨x, hx⟩, hx0⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers (u i * u i')) _ _).mp hz
    obtain ⟨k, rfl⟩ := hx
    exact ⟨k, hx0⟩
  choose kk2 hk2 using hov
  obtain ⟨M, hM⟩ : ∃ M : ℕ, M = ∑ i, ∑ i', ∑ j, kk2 i i' j := ⟨_, rfl⟩
  have hkle2 : ∀ i i' j, kk2 i i' j ≤ M := by
    intro i i' j
    have h1 : kk2 i i' j ≤ ∑ j, kk2 i i' j :=
      Finset.single_le_sum (f := kk2 i i') (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
    have h2 : ∑ j, kk2 i i' j ≤ ∑ i', ∑ j, kk2 i i' j :=
      Finset.single_le_sum (f := fun i' => ∑ j, kk2 i i' j) (fun _ _ => Nat.zero_le _)
        (Finset.mem_univ i')
    have h3 : ∑ i', ∑ j, kk2 i i' j ≤ ∑ i, ∑ i', ∑ j, kk2 i i' j :=
      Finset.single_le_sum (f := fun i => ∑ i', ∑ j, kk2 i i' j) (fun _ _ => Nat.zero_le _)
        (Finset.mem_univ i)
    omega
  have hkill : ∀ i i' j, (u i * u i') ^ M * (u i' ^ N₀ * g₀ i j - u i ^ N₀ * g₀ i' j) = 0 := by
    intro i i' j
    obtain ⟨t, ht⟩ : ∃ t, M = kk2 i i' j + t := ⟨M - kk2 i i' j, by have := hkle2 i i' j; omega⟩
    rw [ht, pow_add, mul_comm ((u i * u i') ^ kk2 i i' j), mul_assoc, hk2, mul_zero]

  refine ⟨m, N₀ + M, u, fun i j => u i ^ M * g₀ i j, hle, by omega, hcov, ?_, ?_⟩
  · intro i i' j
    linear_combination hkill i i' j
  · intro i j
    show B'.presheaf.map (homOfLE (hle i)).op (U'.topIso.hom (f.appTop (c j))) *
        (B'.presheaf.map (homOfLE le_top).op (u i)) ^ (N₀ + M) =
        B'.presheaf.map (homOfLE le_top).op (u i ^ M * g₀ i j)
    rw [← hs j, pow_add, ← mul_assoc, hfrac i j, map_mul, map_pow]
    ring

theorem wc_csd_case1_chart_coords : ∀ (B' X₁ : Scheme.{u}) [IsAffine B'] (r : X₁ ⟶ B') (U' : B'.Opens) (m n N : ℕ) (u : Fin m → Γ(B', ⊤)) (g : Fin m → Fin n → Γ(B', ⊤)), 0 < N → U' = ⨆ i, B'.basicOpen (u i) → (∀ i i' j, u i' ^ N * g i j = u i ^ N * g i' j) → ∃ (W : X₁.Opens) (x : Fin n → Γ(X₁, W)), (∀ t : X₁, t ∈ W ↔ ∃ k : Fin m, wcCsdChartAt (wcCsdC1Ideal B' u g N) r ⟨⊤, isAffineOpen_top B'⟩ (u k ^ (2 * N)) t) ∧ (∀ i j, (wcCsdPullTo r W).hom (u i ^ (2 * N)) * x j = (wcCsdPullTo r W).hom (u i ^ N * g i j)) ∧ r ⁻¹ᵁ U' ≤ W ∧ (∀ t ∈ W, ∃ (V : X₁.Opens) (k : Fin m), IsAffineOpen V ∧ t ∈ V ∧ V ≤ W ∧ (wcCsdPullTo r V).hom (u k ^ (2 * N)) ∈ nonZeroDivisors Γ(X₁, V)) :=
by
  classical
  intro B' X₁ _ r U' m n N u g hN hcov hstar

  have hres : ∀ (A B C : X₁.Opens) (h1 : A ≤ B) (h2 : B ≤ C) (s : Γ(X₁, C)),
      (X₁.presheaf.map (homOfLE h1).op).hom ((X₁.presheaf.map (homOfLE h2).op).hom s) =
        (X₁.presheaf.map (homOfLE (h1.trans h2)).op).hom s := by
    intro A B C h1 h2 s
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
    rfl

  have hRCa : ∀ (O O' : X₁.Opens) (h : O ≤ O') (a : Γ(B', ⊤)),
      (X₁.presheaf.map (homOfLE h).op).hom ((wcCsdPullTo r O').hom a) = (wcCsdPullTo r O).hom a := by
    intro O O' h a
    simp only [wcCsdPullTo, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [hres]

  have hid : ∀ (h : (⊤ : B'.Opens) ≤ ⊤) (a : Γ(B', ⊤)), (B'.presheaf.map (homOfLE h).op).hom a = a := by
    intro h a
    rw [show (homOfLE h).op = 𝟙 (Opposite.op (⊤ : B'.Opens)) from rfl, CategoryTheory.Functor.map_id]
    rfl

  have hmemI : ∀ a ∈ Ideal.span (Set.range (fun p : Fin m × Fin n => u p.1 ^ N * g p.1 p.2) ∪
      Set.range (fun i : Fin m => u i ^ (2 * N))),
      a ∈ (wcCsdC1Ideal B' u g N).ideal ⟨⊤, isAffineOpen_top B'⟩ := by
    intro a ha
    rw [wcCsdC1Ideal, Scheme.IdealSheafData.ofIdealTop_ideal]
    have h := Ideal.mem_map_of_mem (B'.presheaf.map (homOfLE (le_refl (⊤ : B'.Opens))).op).hom ha
    rw [hid] at h
    exact h
  have hE : ∀ i, u i ^ (2 * N) ∈ (wcCsdC1Ideal B' u g N).ideal ⟨⊤, isAffineOpen_top B'⟩ :=
    fun i => hmemI _ (Ideal.subset_span (Or.inr ⟨i, rfl⟩))
  have hG : ∀ i j, u i ^ N * g i j ∈ (wcCsdC1Ideal B' u g N).ideal ⟨⊤, isAffineOpen_top B'⟩ :=
    fun i j => hmemI _ (Ideal.subset_span (Or.inl ⟨(i, j), rfl⟩))

  have hID : ∀ i k j, u i ^ (2 * N) * (u k ^ N * g k j) = u k ^ (2 * N) * (u i ^ N * g i j) := by
    intro i k j
    have h := hstar k i j
    rw [two_mul, pow_add, pow_add]
    linear_combination (u i ^ N * u k ^ N) * h

  have hchart : ∀ (k : Fin m) (t : X₁),
      wcCsdChartAt (wcCsdC1Ideal B' u g N) r ⟨⊤, isAffineOpen_top B'⟩ (u k ^ (2 * N)) t →
      ∃ V : X₁.Opens, IsAffineOpen V ∧ t ∈ V ∧
        (wcCsdPullTo r V).hom (u k ^ (2 * N)) ∈ nonZeroDivisors Γ(X₁, V) ∧
        Ideal.map (wcCsdPullTo r V).hom ((wcCsdC1Ideal B' u g N).ideal ⟨⊤, isAffineOpen_top B'⟩) =
          Ideal.span {(wcCsdPullTo r V).hom (u k ^ (2 * N))} ∧
        ∀ t' ∈ V, wcCsdChartAt (wcCsdC1Ideal B' u g N) r ⟨⊤, isAffineOpen_top B'⟩ (u k ^ (2 * N)) t' := by
    rintro k t ⟨V, e, ht, h1, h2⟩
    exact ⟨V.1, V.2, ht, h1, h2, fun t' ht' => ⟨V, e, ht', h1, h2⟩⟩

  obtain ⟨W, hW⟩ : ∃ W : X₁.Opens, ∀ t : X₁, t ∈ W ↔ ∃ k : Fin m,
      wcCsdChartAt (wcCsdC1Ideal B' u g N) r ⟨⊤, isAffineOpen_top B'⟩ (u k ^ (2 * N)) t := by
    refine ⟨⟨{t | ∃ k : Fin m,
      wcCsdChartAt (wcCsdC1Ideal B' u g N) r ⟨⊤, isAffineOpen_top B'⟩ (u k ^ (2 * N)) t}, ?_⟩,
      fun t => Iff.rfl⟩
    rw [isOpen_iff_forall_mem_open]
    rintro t ⟨k, hk⟩
    obtain ⟨V, -, htV, -, -, hall⟩ := hchart k t hk
    exact ⟨V, fun t' ht' => ⟨k, hall t' ht'⟩, V.isOpen, htV⟩

  have hL0 : ∀ (V : X₁.Opens), IsAffineOpen V → ∀ (a : Γ(X₁, V)), a ∈ nonZeroDivisors Γ(X₁, V) →
      ∀ (O : X₁.Opens) (hO : O ≤ V), (X₁.presheaf.map (homOfLE hO).op).hom a ∈ nonZeroDivisors Γ(X₁, O) := by
    intro V hV a ha O hO
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    have hloc : ∀ p : O, ∃ f : Γ(X₁, V), X₁.basicOpen f ≤ O ∧ (p : X₁) ∈ X₁.basicOpen f :=
      fun p => hV.exists_basicOpen_le p (hO p.2)
    choose f hfO hpf using hloc
    have hcov' : O ≤ iSup (fun p : O => X₁.basicOpen (f p)) := fun x hx =>
      TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hpf ⟨x, hx⟩⟩
    apply TopCat.Sheaf.eq_of_locally_eq' X₁.sheaf (fun p : O => X₁.basicOpen (f p)) O
      (fun p => homOfLE (hfO p)) hcov' y 0
    intro p
    show (X₁.presheaf.map (homOfLE (hfO p)).op).hom y = (X₁.presheaf.map (homOfLE (hfO p)).op).hom 0
    rw [map_zero]
    haveI := hV.isLocalization_basicOpen (f p)
    have hnz : (X₁.presheaf.map (homOfLE (X₁.basicOpen_le (f p))).op).hom a ∈
        nonZeroDivisors Γ(X₁, X₁.basicOpen (f p)) :=
      IsLocalization.map_nonZeroDivisors_le (Submonoid.powers (f p)) Γ(X₁, X₁.basicOpen (f p))
        ⟨a, ha, rfl⟩
    have hm : (X₁.presheaf.map (homOfLE (hfO p)).op).hom y *
        (X₁.presheaf.map (homOfLE (X₁.basicOpen_le (f p))).op).hom a = 0 := by
      rw [← hres _ _ _ (hfO p) hO, ← map_mul, hy, map_zero]
    exact (mem_nonZeroDivisors_iff_right.mp hnz) _ hm

  have hlocal : ∀ t : W, ∃ (V : X₁.Opens) (hV : V ≤ W) (k : Fin m) (y : Fin n → Γ(X₁, V)),
      IsAffineOpen V ∧ (t : X₁) ∈ V ∧
      (wcCsdPullTo r V).hom (u k ^ (2 * N)) ∈ nonZeroDivisors Γ(X₁, V) ∧
      ∀ i j, (wcCsdPullTo r V).hom (u i ^ (2 * N)) * y j = (wcCsdPullTo r V).hom (u i ^ N * g i j) := by
    rintro ⟨t, ht⟩
    obtain ⟨k, hk⟩ := (hW t).mp ht
    obtain ⟨V, hVa, htV, hnzd, hspan, hall⟩ := hchart k t hk
    have hVW : V ≤ W := fun t' ht' => (hW t').mpr ⟨k, hall t' ht'⟩
    have hy : ∀ j, ∃ y : Γ(X₁, V), y * (wcCsdPullTo r V).hom (u k ^ (2 * N)) =
        (wcCsdPullTo r V).hom (u k ^ N * g k j) := by
      intro j
      have hmem : (wcCsdPullTo r V).hom (u k ^ N * g k j) ∈
          Ideal.map (wcCsdPullTo r V).hom ((wcCsdC1Ideal B' u g N).ideal ⟨⊤, isAffineOpen_top B'⟩) :=
        Ideal.mem_map_of_mem _ (hG k j)
      rw [hspan] at hmem
      exact Ideal.mem_span_singleton'.mp hmem
    choose y hy using hy
    refine ⟨V, hVW, k, y, hVa, htV, hnzd, fun i j => ?_⟩
    have e : (wcCsdPullTo r V).hom (u i ^ (2 * N)) * (wcCsdPullTo r V).hom (u k ^ N * g k j) =
        (wcCsdPullTo r V).hom (u k ^ (2 * N)) * (wcCsdPullTo r V).hom (u i ^ N * g i j) := by
      rw [← map_mul, ← map_mul, hID i k j]
    have h0 : ((wcCsdPullTo r V).hom (u i ^ (2 * N)) * y j - (wcCsdPullTo r V).hom (u i ^ N * g i j)) *
        (wcCsdPullTo r V).hom (u k ^ (2 * N)) = 0 := by
      calc _ = (wcCsdPullTo r V).hom (u i ^ (2 * N)) * (y j * (wcCsdPullTo r V).hom (u k ^ (2 * N))) -
            (wcCsdPullTo r V).hom (u k ^ (2 * N)) * (wcCsdPullTo r V).hom (u i ^ N * g i j) := by ring
        _ = 0 := by rw [hy j, e, sub_self]
    exact sub_eq_zero.mp ((mem_nonZeroDivisors_iff_right.mp hnzd) _ h0)
  choose V hVW k y hVa htV hnzd hrel using hlocal
  have hcover : W ≤ iSup V := fun t ht =>
    TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨t, ht⟩, htV ⟨t, ht⟩⟩

  have hglue : ∀ j, ∃ x : Γ(X₁, W), ∀ t, (X₁.presheaf.map (homOfLE (hVW t)).op).hom x = y t j := by
    intro j
    obtain ⟨x, hx, -⟩ := TopCat.Sheaf.existsUnique_gluing' X₁.sheaf V W (fun t => homOfLE (hVW t))
      hcover (fun t => y t j) (by
        intro s t
        show (X₁.presheaf.map (homOfLE (inf_le_left : V s ⊓ V t ≤ V s)).op).hom (y s j) =
          (X₁.presheaf.map (homOfLE (inf_le_right : V s ⊓ V t ≤ V t)).op).hom (y t j)
        have e1 : (X₁.presheaf.map (homOfLE (inf_le_left : V s ⊓ V t ≤ V s)).op).hom (y s j) *
            (wcCsdPullTo r (V s ⊓ V t)).hom (u (k s) ^ (2 * N)) =
            (wcCsdPullTo r (V s ⊓ V t)).hom (u (k s) ^ N * g (k s) j) := by
          rw [← hRCa (V s ⊓ V t) (V s) inf_le_left (u (k s) ^ (2 * N)),
            ← hRCa (V s ⊓ V t) (V s) inf_le_left (u (k s) ^ N * g (k s) j), ← map_mul,
            mul_comm (y s j), hrel s (k s) j]
        have e2 : (X₁.presheaf.map (homOfLE (inf_le_right : V s ⊓ V t ≤ V t)).op).hom (y t j) *
            (wcCsdPullTo r (V s ⊓ V t)).hom (u (k s) ^ (2 * N)) =
            (wcCsdPullTo r (V s ⊓ V t)).hom (u (k s) ^ N * g (k s) j) := by
          rw [← hRCa (V s ⊓ V t) (V t) inf_le_right (u (k s) ^ (2 * N)),
            ← hRCa (V s ⊓ V t) (V t) inf_le_right (u (k s) ^ N * g (k s) j), ← map_mul,
            mul_comm (y t j), hrel t (k s) j]
        have hnz : (wcCsdPullTo r (V s ⊓ V t)).hom (u (k s) ^ (2 * N)) ∈
            nonZeroDivisors Γ(X₁, V s ⊓ V t) := by
          rw [← hRCa (V s ⊓ V t) (V s) inf_le_left (u (k s) ^ (2 * N))]
          exact hL0 (V s) (hVa s) _ (hnzd s) _ inf_le_left
        rw [← sub_eq_zero]
        apply (mem_nonZeroDivisors_iff_right.mp hnz)
        rw [sub_mul, e1, e2, sub_self])
    exact ⟨x, hx⟩
  choose x hx using hglue
  refine ⟨W, x, hW, ?_, ?_, ?_⟩
  ·
    intro i j
    apply TopCat.Sheaf.eq_of_locally_eq' X₁.sheaf V W (fun t => homOfLE (hVW t)) hcover
    intro t
    show (X₁.presheaf.map (homOfLE (hVW t)).op).hom ((wcCsdPullTo r W).hom (u i ^ (2 * N)) * x j) =
      (X₁.presheaf.map (homOfLE (hVW t)).op).hom ((wcCsdPullTo r W).hom (u i ^ N * g i j))
    rw [map_mul, hRCa, hRCa, hx j t]
    exact hrel t i j
  ·
    intro t ht
    have hrt : r t ∈ U' := ht
    rw [hcov] at hrt
    obtain ⟨kk, hkk⟩ := TopologicalSpace.Opens.mem_iSup.mp hrt
    have hk' : r t ∈ B'.basicOpen (u kk ^ (2 * N)) := by
      rw [Scheme.basicOpen_pow B' (u kk) (by omega)]; exact hkk
    have ht' : t ∈ r ⁻¹ᵁ B'.basicOpen (u kk ^ (2 * N)) := hk'
    rw [Scheme.preimage_basicOpen] at ht'
    obtain ⟨V0, hV0a, htV0, hV0sub⟩ := exists_isAffineOpen_mem_and_subset ht'
    have hVD : V0 ≤ X₁.basicOpen ((r.app ⊤).hom (u kk ^ (2 * N))) := hV0sub
    have hunit : IsUnit ((wcCsdPullTo r V0).hom (u kk ^ (2 * N))) := by
      have h1 := RingedSpace.isUnit_res_basicOpen X₁.toLocallyRingedSpace.toRingedSpace
        (U := r ⁻¹ᵁ ⊤) ((r.app ⊤).hom (u kk ^ (2 * N)))
      have h2 := h1.map (X₁.presheaf.map (homOfLE hVD).op).hom
      have e : wcCsdPullTo r V0 = r.app ⊤ ≫
          X₁.presheaf.map (homOfLE (X₁.basicOpen_le ((r.app ⊤).hom (u kk ^ (2 * N))))).op ≫
            X₁.presheaf.map (homOfLE hVD).op := by
        rw [← Functor.map_comp]; rfl
      rw [e]
      exact h2
    apply (hW t).mpr
    refine ⟨kk, ⟨V0, hV0a⟩, le_top.trans_eq (Scheme.Hom.preimage_top r).symm, htV0, ?_⟩
    show (wcCsdPullTo r V0).hom (u kk ^ (2 * N)) ∈ nonZeroDivisors Γ(X₁, V0) ∧
      Ideal.map (wcCsdPullTo r V0).hom ((wcCsdC1Ideal B' u g N).ideal ⟨⊤, isAffineOpen_top B'⟩) =
        Ideal.span {(wcCsdPullTo r V0).hom (u kk ^ (2 * N))}
    refine ⟨hunit.mem_nonZeroDivisors, ?_⟩
    rw [Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ (hE kk)) hunit, eq_comm,
      Ideal.span_singleton_eq_top]
    exact hunit
  ·
    intro t ht
    obtain ⟨kk, hkk⟩ := (hW t).mp ht
    obtain ⟨V0, hV0a, htV0, hnz0, -, hall⟩ := hchart kk t hkk
    exact ⟨V0, kk, hV0a, htV0, fun t' ht' => (hW t').mpr ⟨kk, hall t' ht'⟩, hnz0⟩

theorem wc_csd_case1_boundary_inverse : ∀ (B' X₁ : Scheme.{u}) [IsAffine B'] (r : X₁ ⟶ B') (m n N : ℕ) (u : Fin m → Γ(B', ⊤)) (g : Fin m → Fin n → Γ(B', ⊤)) (W : X₁.Opens) (x : Fin n → Γ(X₁, W)), wcCsdInvPull (wcCsdC1Ideal B' u g N) r → (∀ t : X₁, t ∈ W ↔ ∃ k : Fin m, wcCsdChartAt (wcCsdC1Ideal B' u g N) r ⟨⊤, isAffineOpen_top B'⟩ (u k ^ (2 * N)) t) → (∀ i j, (wcCsdPullTo r W).hom (u i ^ (2 * N)) * x j = (wcCsdPullTo r W).hom (u i ^ N * g i j)) → ∀ t : X₁, t ∉ W → ∃ (O : X₁.Opens) (ε : Γ(X₁, O)) (j : Fin n), t ∈ O ∧ t ∉ X₁.basicOpen ε ∧ X₁.presheaf.map (homOfLE (inf_le_right : W ⊓ O ≤ O)).op ε * X₁.presheaf.map (homOfLE (inf_le_left : W ⊓ O ≤ W)).op (x j) = 1 :=
by
  classical
  intro B' X₁ _ r m n N u g W x hInv hW ha t ht

  have hIdeal : (wcCsdC1Ideal B' u g N).ideal ⟨⊤, isAffineOpen_top B'⟩ = Ideal.span
      (Set.range (fun p : Fin m × Fin n => u p.1 ^ N * g p.1 p.2) ∪
        Set.range (fun i : Fin m => u i ^ (2 * N))) := by
    rw [wcCsdC1Ideal, Scheme.IdealSheafData.ofIdealTop_ideal]
    have key : ∀ (h : (⊤ : B'.Opens) ≤ ⊤),
        (B'.presheaf.map (homOfLE h).op).hom = RingHom.id _ := by
      intro h
      rw [show (homOfLE h).op = 𝟙 (Opposite.op (⊤ : B'.Opens)) from rfl,
        CategoryTheory.Functor.map_id, CommRingCat.hom_id]
    erw [key]
    exact Ideal.map_id _
  have hmemE : ∀ i, u i ^ (2 * N) ∈
      (wcCsdC1Ideal B' u g N).ideal ⟨⊤, isAffineOpen_top B'⟩ := by
    intro i
    rw [hIdeal]
    exact Ideal.subset_span (Or.inr ⟨i, rfl⟩)

  let G : Fin m × Fin n → Γ(B', ⊤) := fun p => u p.1 ^ N * g p.1 p.2
  let E : Fin m → Γ(B', ⊤) := fun i => u i ^ (2 * N)
  let b : Fin (m * n + m) → Γ(B', ⊤) :=
    Sum.elim (G ∘ finProdFinEquiv.symm) E ∘ finSumFinEquiv.symm
  have hb : Ideal.span (Set.range b) =
      (wcCsdC1Ideal B' u g N).ideal ⟨⊤, isAffineOpen_top B'⟩ := by
    rw [hIdeal]
    congr 1
    simp only [b]
    rw [EquivLike.range_comp, Set.Sum.elim_range, EquivLike.range_comp]

  obtain ⟨l, hl⟩ := wc_csd_invpull_generator_chart B' X₁ (wcCsdC1Ideal B' u g N) r hInv
    ⟨⊤, isAffineOpen_top B'⟩ (m * n + m) b hb t (show r t ∈ (⊤ : B'.Opens) from trivial)

  obtain ⟨s, rfl⟩ := finSumFinEquiv.surjective l
  rcases s with p | i
  swap
  · have hbl : b (finSumFinEquiv (Sum.inr i)) = u i ^ (2 * N) := by
      simp [b, E]
    rw [hbl] at hl
    exact absurd ((hW t).2 ⟨i, hl⟩) ht
  obtain ⟨⟨i, j⟩, rfl⟩ := finProdFinEquiv.surjective p
  have hbl : b (finSumFinEquiv (Sum.inl (finProdFinEquiv (i, j)))) = u i ^ N * g i j := by
    simp [b, G]
  rw [hbl] at hl

  obtain ⟨V, e, htV, hc, hgen⟩ := hl
  have hEmem := Ideal.mem_map_of_mem
    (r.appLE (⟨⊤, isAffineOpen_top B'⟩ : B'.affineOpens).1 V.1 e).hom (hmemE i)
  rw [hgen] at hEmem
  obtain ⟨ε, hε⟩ := Ideal.mem_span_singleton'.mp hEmem

  have L0 : ∀ (O : X₁.Opens) (hO : O ≤ V.1) (a : Γ(X₁, V.1)), a ∈ nonZeroDivisors Γ(X₁, V.1) →
      (X₁.presheaf.map (homOfLE hO).op).hom a ∈ nonZeroDivisors Γ(X₁, O) := by
    intro O hO a ha'
    have key : ∀ y : Γ(X₁, O), y * (X₁.presheaf.map (homOfLE hO).op).hom a = 0 → y = 0 := by
      intro y hy
      apply TopCat.Presheaf.section_ext X₁.sheaf O y 0
      intro p hp
      obtain ⟨f, hfO, hpf⟩ := V.2.exists_basicOpen_le ⟨p, hp⟩ (hO hp)
      have := V.2.isLocalization_basicOpen f
      have hσ : algebraMap Γ(X₁, V.1) Γ(X₁, X₁.basicOpen f) a ∈ nonZeroDivisors _ :=
        IsLocalization.map_nonZeroDivisors_le (Submonoid.powers f) _
          (Submonoid.mem_map_of_mem _ ha')
      have h1 : (X₁.presheaf.map (homOfLE hfO).op).hom y *
          algebraMap Γ(X₁, V.1) Γ(X₁, X₁.basicOpen f) a = 0 := by
        have h0 : (X₁.presheaf.map (homOfLE hfO).op).hom
            (y * (X₁.presheaf.map (homOfLE hO).op).hom a) = 0 := by
          rw [hy, map_zero]
        rw [map_mul] at h0
        have hres : (X₁.presheaf.map (homOfLE hfO).op).hom
            ((X₁.presheaf.map (homOfLE hO).op).hom a) =
            algebraMap Γ(X₁, V.1) Γ(X₁, X₁.basicOpen f) a := by
          show (X₁.presheaf.map (homOfLE hO).op ≫ X₁.presheaf.map (homOfLE hfO).op).hom a = _
          rw [← Functor.map_comp]
          rfl
        rw [hres] at h0
        exact h0
      have h2 : (X₁.presheaf.map (homOfLE hfO).op).hom y = 0 :=
        (mul_right_mem_nonZeroDivisors_eq_zero_iff hσ).mp h1
      have h3 := TopCat.Presheaf.germ_res_apply X₁.presheaf (homOfLE hfO) p hpf y
      erw [← h3, h2, map_zero, map_zero]
      rfl
    exact mem_nonZeroDivisors_iff.mpr ⟨fun y hy => key y (by rw [mul_comm]; exact hy), key⟩
  refine ⟨V.1, ε, j, htV, ?_, ?_⟩
  ·
    intro htε
    apply ht
    apply (hW t).2
    refine ⟨i, ⟨X₁.basicOpen ε, V.2.basicOpen ε⟩, (X₁.basicOpen_le ε).trans e, htε, ?_, ?_⟩
    · have hunit := X₁.toRingedSpace.isUnit_res_basicOpen ε
      have := V.2.isLocalization_basicOpen ε
      have hσ : algebraMap Γ(X₁, V.1) Γ(X₁, X₁.basicOpen ε)
          ((r.appLE (⟨⊤, isAffineOpen_top B'⟩ : B'.affineOpens).1 V.1 e).hom (u i ^ N * g i j))
          ∈ nonZeroDivisors _ :=
        IsLocalization.map_nonZeroDivisors_le (Submonoid.powers ε) _
          (Submonoid.mem_map_of_mem _ hc)
      rw [← Scheme.Hom.appLE_map r e (homOfLE (X₁.basicOpen_le ε)).op, CommRingCat.hom_comp,
        RingHom.comp_apply, ← hε, map_mul]
      exact mul_mem_nonZeroDivisors.mpr ⟨hunit.mem_nonZeroDivisors, hσ⟩
    · have hunit := X₁.toRingedSpace.isUnit_res_basicOpen ε
      rw [← Scheme.Hom.appLE_map r e (homOfLE (X₁.basicOpen_le ε)).op, CommRingCat.hom_comp,
        ← Ideal.map_map, hgen, Ideal.map_span, Set.image_singleton, RingHom.comp_apply, ← hε,
        map_mul (X₁.presheaf.map (homOfLE (X₁.basicOpen_le ε)).op).hom ε]
      exact (Ideal.span_singleton_mul_left_unit hunit _).symm
  ·
    have hA : ∀ a : Γ(B', ⊤), (X₁.presheaf.map (homOfLE (inf_le_right : W ⊓ V.1 ≤ V.1)).op).hom
        ((r.appLE (⟨⊤, isAffineOpen_top B'⟩ : B'.affineOpens).1 V.1 e).hom a) =
        (wcCsdPullTo r (W ⊓ V.1)).hom a := by
      intro a
      show (r.appLE _ V.1 e ≫ X₁.presheaf.map (homOfLE (inf_le_right : W ⊓ V.1 ≤ V.1)).op).hom a = _
      rw [Scheme.Hom.appLE_map]
      rfl
    have hB : ∀ a : Γ(B', ⊤), (X₁.presheaf.map (homOfLE (inf_le_left : W ⊓ V.1 ≤ W)).op).hom
        ((wcCsdPullTo r W).hom a) = (wcCsdPullTo r (W ⊓ V.1)).hom a := by
      intro a
      show (wcCsdPullTo r W ≫ X₁.presheaf.map (homOfLE (inf_le_left : W ⊓ V.1 ≤ W)).op).hom a = _
      rw [wcCsdPullTo, wcCsdPullTo, Category.assoc, ← Functor.map_comp]
      rfl
    have hcbar := L0 (W ⊓ V.1) inf_le_right _ hc
    have e1 : (X₁.presheaf.map (homOfLE (inf_le_right : W ⊓ V.1 ≤ V.1)).op).hom ε *
        (X₁.presheaf.map (homOfLE (inf_le_right : W ⊓ V.1 ≤ V.1)).op).hom
          ((r.appLE (⟨⊤, isAffineOpen_top B'⟩ : B'.affineOpens).1 V.1 e).hom (u i ^ N * g i j)) =
        (wcCsdPullTo r (W ⊓ V.1)).hom (u i ^ (2 * N)) := by
      rw [← map_mul, hε, hA]
    have e2 : (wcCsdPullTo r (W ⊓ V.1)).hom (u i ^ (2 * N)) *
        (X₁.presheaf.map (homOfLE (inf_le_left : W ⊓ V.1 ≤ W)).op).hom (x j) =
        (wcCsdPullTo r (W ⊓ V.1)).hom (u i ^ N * g i j) := by
      have h := congrArg (X₁.presheaf.map (homOfLE (inf_le_left : W ⊓ V.1 ≤ W)).op).hom (ha i j)
      rw [map_mul, hB, hB] at h
      exact h
    have e3 : (X₁.presheaf.map (homOfLE (inf_le_right : W ⊓ V.1 ≤ V.1)).op).hom
          ((r.appLE (⟨⊤, isAffineOpen_top B'⟩ : B'.affineOpens).1 V.1 e).hom (u i ^ N * g i j)) *
        ((X₁.presheaf.map (homOfLE (inf_le_right : W ⊓ V.1 ≤ V.1)).op).hom ε *
          (X₁.presheaf.map (homOfLE (inf_le_left : W ⊓ V.1 ≤ W)).op).hom (x j) - 1) = 0 := by
      rw [mul_sub, mul_one, ← mul_assoc, mul_comm _ ((X₁.presheaf.map (homOfLE
        (inf_le_right : W ⊓ V.1 ≤ V.1)).op).hom ε), e1, e2, hA, sub_self]
    exact sub_eq_zero.mp ((mul_left_mem_nonZeroDivisors_eq_zero_iff hcbar).mp e3)

theorem wc_csd_case1_factor : ∀ (B' X₁ Y : Scheme.{u}) [IsAffine B'] (r : X₁ ⟶ B') (pY : Y ⟶ B') [IsAffineHom pY] (U' : B'.Opens) (f : U'.toScheme ⟶ Y) (m n N : ℕ) (u : Fin m → Γ(B', ⊤)) (g : Fin m → Fin n → Γ(B', ⊤)) (c : Fin n → Γ(Y, ⊤)) (hle : ∀ i, B'.basicOpen (u i) ≤ U') (W : X₁.Opens) (x : Fin n → Γ(X₁, W)), f ≫ pY = U'.ι → Function.Surjective (MvPolynomial.eval₂Hom pY.appTop.hom c) → 0 < N → U' = ⨆ i, B'.basicOpen (u i) → (∀ i j, B'.presheaf.map (homOfLE (hle i)).op (U'.topIso.hom (f.appTop (c j))) * (B'.presheaf.map (homOfLE le_top).op (u i)) ^ N = B'.presheaf.map (homOfLE le_top).op (g i j)) → (∀ i j, (wcCsdPullTo r W).hom (u i ^ (2 * N)) * x j = (wcCsdPullTo r W).hom (u i ^ N * g i j)) → (∀ t ∈ W, ∃ (V : X₁.Opens) (k : Fin m), IsAffineOpen V ∧ t ∈ V ∧ V ≤ W ∧ (wcCsdPullTo r V).hom (u k ^ (2 * N)) ∈ nonZeroDivisors Γ(X₁, V)) → ∃ φ : W.toScheme ⟶ Y, W.ι ≫ r = φ ≫ pY ∧ (∀ j, W.topIso.hom (φ.appTop (c j)) = x j) ∧ ∀ ι₀ : (r ⁻¹ᵁ U').toScheme ⟶ W.toScheme, ι₀ ≫ W.ι = (r ⁻¹ᵁ U').ι → ι₀ ≫ φ = (r ∣_ U') ≫ f :=
by
  classical
  intro B' X₁ Y _ r pY _ U' f m n N u g c hle W x hf hsurj hN hU' hcomp ha hcharts
  have : IsAffine Y := isAffine_of_isAffineHom pY

  have L1 : ∀ (T : Scheme.{u}) (θ : Γ(Y, ⊤) ⟶ Γ(T, ⊤)), ∃ φ : T ⟶ Y, φ.appTop = θ := by
    intro T θ
    refine ⟨T.toSpecΓ ≫ Spec.map θ ≫ Y.isoSpec.inv, ?_⟩
    have h1 : Y.isoSpec.inv.appTop = (Scheme.ΓSpecIso Γ(Y, ⊤)).inv := by
      have h2 := congrArg Scheme.Hom.appTop (Scheme.isoSpec_inv_toSpecΓ Y)
      rw [Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop, Scheme.Hom.id_appTop] at h2
      exact (Iso.hom_comp_eq_id _).mp h2
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, h1, Scheme.toSpecΓ_appTop, Category.assoc,
      Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]

  have L2a1 : ∀ (X : Scheme.{u}) (V : X.Opens),
      V.ι.appTop ≫ V.topIso.hom = X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op := by
    intro X V
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
    exact (X.presheaf.map_comp _ _).symm
  have PM : ∀ {A B B₂ C : X₁.Opens} (a : Opposite.op A ⟶ Opposite.op B)
      (b : Opposite.op B ⟶ Opposite.op C)
      (a' : Opposite.op A ⟶ Opposite.op B₂) (b' : Opposite.op B₂ ⟶ Opposite.op C),
      X₁.presheaf.map a ≫ X₁.presheaf.map b = X₁.presheaf.map a' ≫ X₁.presheaf.map b' := by
    intro A B B₂ C a b a' b'
    rw [← Functor.map_comp, ← Functor.map_comp]
    rfl
  have L2a2 : ∀ (U V : X₁.Opens) (e : U ≤ V),
      (X₁.homOfLE e).appTop ≫ U.topIso.hom = V.topIso.hom ≫ X₁.presheaf.map (homOfLE e).op := by
    intro U V e
    rw [Scheme.homOfLE_appTop, Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
    exact PM _ _ _ _
  have NAT : ∀ {U1 U2 : B'.Opens} {V1 : X₁.Opens} (a : Opposite.op U1 ⟶ Opposite.op U2)
      (b1 : Opposite.op (r ⁻¹ᵁ U1) ⟶ Opposite.op V1) (b2 : Opposite.op V1 ⟶ Opposite.op (r ⁻¹ᵁ U2)),
      (r.app U1 ≫ X₁.presheaf.map b1) ≫ X₁.presheaf.map b2 = B'.presheaf.map a ≫ r.app U2 := by
    intro U1 U2 V1 a b1 b2
    rw [Scheme.Hom.naturality, Category.assoc, ← Functor.map_comp]
    rfl
  have L2b2 : (r ∣_ U').appTop ≫ (r ⁻¹ᵁ U').topIso.hom = U'.topIso.hom ≫ r.app U' := by
    rw [morphismRestrict_appTop, Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
    exact NAT _ _ _

  have L3 : ∀ (V : X₁.Opens), IsAffineOpen V → ∀ (e : Γ(X₁, V)), e ∈ nonZeroDivisors Γ(X₁, V) →
      Function.Injective (X₁.presheaf.map (homOfLE (X₁.basicOpen_le e)).op) := by
    intro V hV e he
    have := hV.isLocalization_basicOpen e
    exact IsLocalization.injective (M := Submonoid.powers e) (S := Γ(X₁, X₁.basicOpen e))
      (Submonoid.powers_le.mpr he)

  have F1 : ∀ (O D : X₁.Opens) (h : D ≤ O) (y : Γ(B', ⊤)),
      X₁.presheaf.map (homOfLE h).op (wcCsdPullTo r O y) = wcCsdPullTo r D y := by
    intro O D h y
    rw [← CategoryTheory.comp_apply]
    congr 1
    unfold wcCsdPullTo
    rw [Category.assoc, ← Functor.map_comp]
    rfl

  have L6b : ∀ (a : Γ(B', ⊤)) (D : X₁.Opens), D ≤ r ⁻¹ᵁ B'.basicOpen a →
      IsUnit (wcCsdPullTo r D a) := by
    intro a D hD
    have e2 : r ⁻¹ᵁ B'.basicOpen a = X₁.basicOpen (r.appTop a) := Scheme.preimage_basicOpen r a
    rw [e2] at hD
    have hu := RingedSpace.isUnit_res_basicOpen X₁.toRingedSpace (r.appTop a)
    have : wcCsdPullTo r D a = X₁.presheaf.map (homOfLE hD).op
        (X₁.presheaf.map (homOfLE (X₁.basicOpen_le (r.appTop a))).op (r.appTop a)) := by
      rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    rw [this]
    exact hu.map _

  have L4 : ∀ (k : Fin m) (j : Fin n) (D : X₁.Opens) (hDk : D ≤ r ⁻¹ᵁ B'.basicOpen (u k))
      (hDW : D ≤ W),
      X₁.presheaf.map (homOfLE hDW).op (x j) =
        X₁.presheaf.map (homOfLE (hDk.trans (r.preimage_mono (hle k)))).op
          (r.app U' (U'.topIso.hom (f.appTop (c j)))) := by
    intro k j D hDk hDW
    have hw : IsUnit (wcCsdPullTo r D (u k)) := L6b (u k) D hDk
    have hκ1 : B'.presheaf.map (homOfLE (hle k)).op ≫ r.appLE (B'.basicOpen (u k)) D hDk =
        r.app U' ≫ X₁.presheaf.map (homOfLE (hDk.trans (r.preimage_mono (hle k)))).op := by
      rw [Scheme.Hom.map_appLE]; rfl
    have hκ2 : B'.presheaf.map (homOfLE (le_top : B'.basicOpen (u k) ≤ ⊤)).op ≫
        r.appLE (B'.basicOpen (u k)) D hDk = wcCsdPullTo r D := by
      rw [Scheme.Hom.map_appLE]; rfl
    have e1 : ∀ y, r.appLE (B'.basicOpen (u k)) D hDk (B'.presheaf.map (homOfLE (hle k)).op y) =
        X₁.presheaf.map (homOfLE (hDk.trans (r.preimage_mono (hle k)))).op (r.app U' y) := by
      intro y
      rw [← CategoryTheory.comp_apply, hκ1, CategoryTheory.comp_apply]
    have e2 : ∀ y, r.appLE (B'.basicOpen (u k)) D hDk
        (B'.presheaf.map (homOfLE (le_top : B'.basicOpen (u k) ≤ ⊤)).op y) = wcCsdPullTo r D y := by
      intro y
      rw [← CategoryTheory.comp_apply, hκ2]
    have h1 := congrArg (r.appLE (B'.basicOpen (u k)) D hDk) (hcomp k j)
    rw [map_mul, map_pow, e1, e2, e2] at h1
    have ha' : wcCsdPullTo r W (u k ^ (2 * N)) * x j = wcCsdPullTo r W (u k ^ N * g k j) := ha k j
    have h2 := congrArg (X₁.presheaf.map (homOfLE hDW).op) ha'
    simp only [map_mul, map_pow, F1] at h2
    apply (hw.pow (2 * N)).mul_left_cancel
    rw [h2, ← h1]
    ring

  have hfα : ∀ a : Γ(B', ⊤), f.appTop (pY.appTop a) = U'.ι.appTop a := by
    intro a
    rw [← CategoryTheory.comp_apply, ← Scheme.Hom.comp_appTop, hf]

  have L2b1 : ∀ a : Γ(B', ⊤), r.app U' (U'.topIso.hom (U'.ι.appTop a)) =
      wcCsdPullTo r (r ⁻¹ᵁ U') a := by
    intro a
    have h1 : U'.topIso.hom (U'.ι.appTop a) = B'.presheaf.map (homOfLE (le_top : U' ≤ ⊤)).op a := by
      rw [← CategoryTheory.comp_apply, L2a1]
    rw [h1, ← CategoryTheory.comp_apply]
    rw [Scheme.Hom.naturality]
    rfl

  have hker : ∀ p, MvPolynomial.eval₂Hom pY.appTop.hom c p = 0 →
      MvPolynomial.eval₂Hom (wcCsdPullTo r W).hom x p = 0 := by
    intro p hp
    have hloc : ∀ t : W, ∃ (V : X₁.Opens) (hVW : V ≤ W), t.1 ∈ V ∧
        X₁.presheaf.map (homOfLE hVW).op (MvPolynomial.eval₂Hom (wcCsdPullTo r W).hom x p) = 0 := by
      intro t
      obtain ⟨V, k, hVaff, htV, hVW, hnzd⟩ := hcharts t.1 t.2
      obtain ⟨e, he⟩ : ∃ e, e = (wcCsdPullTo r V).hom (u k ^ (2 * N)) := ⟨_, rfl⟩
      rw [← he] at hnzd
      have hDV : X₁.basicOpen e ≤ V := X₁.basicOpen_le e
      have hDW : X₁.basicOpen e ≤ W := hDV.trans hVW
      have hDk : X₁.basicOpen e ≤ r ⁻¹ᵁ B'.basicOpen (u k) := by
        rw [he]
        show X₁.basicOpen (X₁.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op
          (r.appTop (u k ^ (2 * N)))) ≤ _
        rw [Scheme.basicOpen_res]
        refine inf_le_right.trans ?_
        rw [← Scheme.basicOpen_pow B' (u k) (show 0 < 2 * N by omega), Scheme.preimage_basicOpen]
        exact le_rfl
      have hDU : X₁.basicOpen e ≤ r ⁻¹ᵁ U' := hDk.trans (r.preimage_mono (hle k))
      let ψ : Γ(Y, ⊤) ⟶ Γ(X₁, X₁.basicOpen e) :=
        f.appTop ≫ U'.topIso.hom ≫ r.app U' ≫ X₁.presheaf.map (homOfLE hDU).op
      have hψα : ψ.hom.comp pY.appTop.hom =
          (X₁.presheaf.map (homOfLE hDW).op).hom.comp (wcCsdPullTo r W).hom := by
        refine RingHom.ext (fun a => ?_)
        have e1 : X₁.presheaf.map (homOfLE hDU).op (r.app U' (U'.topIso.hom (f.appTop (pY.appTop a))))
            = wcCsdPullTo r (X₁.basicOpen e) a := by rw [hfα, L2b1, F1]
        have e2 : X₁.presheaf.map (homOfLE hDW).op (wcCsdPullTo r W a) =
            wcCsdPullTo r (X₁.basicOpen e) a := F1 _ _ _ _
        exact e1.trans e2.symm
      have hψc : ψ.hom ∘ c = (X₁.presheaf.map (homOfLE hDW).op).hom ∘ x := by
        funext j
        exact (L4 k j _ hDk hDW).symm
      have hp' : MvPolynomial.eval₂ pY.appTop.hom c p = 0 := hp
      have h0 : (X₁.presheaf.map (homOfLE hDW).op).hom
          (MvPolynomial.eval₂ (wcCsdPullTo r W).hom x p) = 0 := by
        calc (X₁.presheaf.map (homOfLE hDW).op).hom (MvPolynomial.eval₂ (wcCsdPullTo r W).hom x p)
            = MvPolynomial.eval₂ ((X₁.presheaf.map (homOfLE hDW).op).hom.comp
                (wcCsdPullTo r W).hom) ((X₁.presheaf.map (homOfLE hDW).op).hom ∘ x) p :=
              MvPolynomial.eval₂_comp_left _ _ _ _
          _ = MvPolynomial.eval₂ (ψ.hom.comp pY.appTop.hom) (ψ.hom ∘ c) p := by rw [hψα, hψc]
          _ = ψ.hom (MvPolynomial.eval₂ pY.appTop.hom c p) :=
              (MvPolynomial.eval₂_comp_left _ _ _ _).symm
          _ = 0 := by rw [hp', map_zero]
      refine ⟨V, hVW, htV, L3 V hVaff e hnzd ?_⟩
      rw [map_zero, ← CategoryTheory.comp_apply, ← Functor.map_comp]
      exact h0
    choose V hVW htV hV0 using hloc
    apply TopCat.Sheaf.eq_of_locally_eq' X₁.sheaf V W (fun t => homOfLE (hVW t)) ?_ _ 0
    · intro t
      rw [map_zero]
      exact hV0 t
    · intro y hy
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨y, hy⟩, htV ⟨y, hy⟩⟩
  have hker' : RingHom.ker (MvPolynomial.eval₂Hom pY.appTop.hom c) ≤
      RingHom.ker (MvPolynomial.eval₂Hom (wcCsdPullTo r W).hom x) :=
    fun p hp => (RingHom.mem_ker).mpr (hker p ((RingHom.mem_ker).mp hp))
  obtain ⟨θ, hθ⟩ : ∃ θ : Γ(Y, ⊤) →+* Γ(X₁, W), ∀ q,
      θ (MvPolynomial.eval₂Hom pY.appTop.hom c q) = MvPolynomial.eval₂Hom (wcCsdPullTo r W).hom x q :=
    ⟨_, RingHom.liftOfSurjective_comp_apply _ hsurj ⟨_, hker'⟩⟩
  have hθX : ∀ j, θ (c j) = x j := by
    intro j
    have := hθ (MvPolynomial.X j)
    rwa [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X'] at this
  have hθC : ∀ a, θ (pY.appTop.hom a) = (wcCsdPullTo r W).hom a := by
    intro a
    have := hθ (MvPolynomial.C a)
    rwa [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C] at this
  obtain ⟨φ, hφ⟩ := L1 W.toScheme (CommRingCat.ofHom θ ≫ W.topIso.inv)
  have hii : ∀ j, W.topIso.hom (φ.appTop (c j)) = x j := by
    intro j
    rw [hφ, CategoryTheory.comp_apply, Iso.inv_hom_id_apply]
    exact hθX j
  have hi : W.ι ≫ r = φ ≫ pY := by
    apply ext_of_isAffine
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, hφ, ← cancel_mono W.topIso.hom,
      Category.assoc, L2a1, Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    ext a
    exact (hθC a).symm
  have hiii : ∀ ι₀ : (r ⁻¹ᵁ U').toScheme ⟶ W.toScheme, ι₀ ≫ W.ι = (r ⁻¹ᵁ U').ι →
      ι₀ ≫ φ = (r ∣_ U') ≫ f := by
    intro ι₀ hι₀
    have hOW : r ⁻¹ᵁ U' ≤ W := by
      intro y hy
      have hy' : y ∈ Set.range (r ⁻¹ᵁ U').ι := by rw [Scheme.Opens.range_ι]; exact hy
      obtain ⟨y', rfl⟩ := hy'
      rw [← hι₀]
      show W.ι (ι₀ y') ∈ W
      exact (ι₀ y').2
    have hι : ι₀ = X₁.homOfLE hOW := by
      rw [← cancel_mono W.ι, hι₀, Scheme.homOfLE_ι]
    subst hι
    have hB : (X₁.homOfLE hOW ≫ φ) ≫ pY = ((r ∣_ U') ≫ f) ≫ pY := by
      rw [Category.assoc, Category.assoc, ← hi, hf, morphismRestrict_ι, Scheme.homOfLE_ι_assoc]
    have hloc2 : ∀ j, X₁.presheaf.map (homOfLE hOW).op (x j) =
        r.app U' (U'.topIso.hom (f.appTop (c j))) := by
      intro j
      apply TopCat.Sheaf.eq_of_locally_eq' X₁.sheaf (fun k => r ⁻¹ᵁ B'.basicOpen (u k)) (r ⁻¹ᵁ U')
        (fun k => homOfLE (r.preimage_mono (hle k)))
      · intro y hy
        have hy' : r y ∈ U' := hy
        rw [hU'] at hy'
        obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp hy'
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨k, hk⟩
      · intro k
        have hDW : r ⁻¹ᵁ B'.basicOpen (u k) ≤ W := (r.preimage_mono (hle k)).trans hOW
        have h4 := L4 k j (r ⁻¹ᵁ B'.basicOpen (u k)) le_rfl hDW
        refine Eq.trans ?_ h4
        change X₁.presheaf.map (homOfLE (r.preimage_mono (hle k))).op
          (X₁.presheaf.map (homOfLE hOW).op (x j)) = _
        rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
        rfl
    apply ext_of_isAffine
    apply CommRingCat.hom_ext
    refine (RingHom.cancel_right hsurj).mp ?_
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
      have h := congrArg Scheme.Hom.appTop hB
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop] at h
      exact congrArg (fun z => z.hom a) h
    · intro j
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
      apply (r ⁻¹ᵁ U').topIso.commRingCatIsoToRingEquiv.injective
      show (r ⁻¹ᵁ U').topIso.hom ((X₁.homOfLE hOW ≫ φ).appTop (c j)) =
        (r ⁻¹ᵁ U').topIso.hom (((r ∣_ U') ≫ f).appTop (c j))
      rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, CategoryTheory.comp_apply,
        CategoryTheory.comp_apply, ← CategoryTheory.comp_apply (X₁.homOfLE hOW).appTop,
        ← CategoryTheory.comp_apply (r ∣_ U').appTop, L2a2, L2b2, CategoryTheory.comp_apply,
        CategoryTheory.comp_apply, hii]
      exact hloc2 j
  exact ⟨φ, hi, hii, hiii⟩

theorem wc_csd_closed_graph_of_local_inverse : ∀ (X Y B : Scheme.{u}) (q : X ⟶ B) (pY : Y ⟶ B) [IsSeparated pY] (W : X.Opens) (φ : W.toScheme ⟶ Y) (h : W.ι ≫ q = φ ≫ pY), (∀ t : X, t ∉ W → ∃ (O : X.Opens) (ε : Γ(X, O)) (s : Γ(Y, ⊤)), t ∈ O ∧ t ∉ X.basicOpen ε ∧ X.presheaf.map (homOfLE (inf_le_right : W ⊓ O ≤ O)).op ε * X.presheaf.map (homOfLE (inf_le_left : W ⊓ O ≤ W)).op (W.topIso.hom (φ.appTop s)) = 1) → IsClosedImmersion (Limits.pullback.lift W.ι φ h) :=
by
  intro X Y B q pY _ W φ h hbd
  obtain ⟨γ, hγ⟩ : ∃ γ, γ = Limits.pullback.lift W.ι φ h := ⟨_, rfl⟩
  rw [← hγ]
  have hγfst : γ ≫ Limits.pullback.fst q pY = W.ι := by rw [hγ, Limits.pullback.lift_fst]
  have hγsnd : γ ≫ Limits.pullback.snd q pY = φ := by rw [hγ, Limits.pullback.lift_snd]
  haveI : IsImmersion (γ ≫ Limits.pullback.fst q pY) := by rw [hγfst]; infer_instance
  haveI : IsImmersion γ := IsImmersion.of_comp γ (Limits.pullback.fst q pY)
  have hpt : ∀ w, Limits.pullback.fst q pY (γ w) = W.ι w := fun w => by
    show (γ ≫ Limits.pullback.fst q pY) w = _
    rw [hγfst]
  have hmemW : ∀ w : W.toScheme, W.ι w ∈ W := fun w => w.2
  have hkey3 : ∀ {U1 U2 U3 U4 : X.Opens} (a : Opposite.op U1 ⟶ Opposite.op U2)
      (b : Opposite.op U2 ⟶ Opposite.op U3) (c : Opposite.op U3 ⟶ Opposite.op U4)
      (k : Opposite.op U1 ⟶ Opposite.op U4),
      X.presheaf.map a ≫ X.presheaf.map b ≫ X.presheaf.map c = X.presheaf.map k := by
    intro U1 U2 U3 U4 a b c k
    rw [← Functor.map_comp, ← Functor.map_comp]
    rfl
  have hcongr : ∀ {T T' : Scheme.{u}} (f f' : T ⟶ T') (hf : f = f') (U : T'.Opens) (V : T.Opens)
      (e1 : V ≤ f ⁻¹ᵁ U), f.appLE U V e1 = f'.appLE U V (hf ▸ e1) := by
    intro T T' f f' hf U V e1
    subst hf
    rfl
  apply IsClosedImmersion.of_isPreimmersion γ
  rw [← closure_subset_iff_isClosed]
  intro z hz
  by_cases hzW : Limits.pullback.fst q pY z ∈ W
  ·
    have hrng : Set.range γ ⊆ Set.range (Limits.pullback.fst q pY ⁻¹ᵁ W).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨w, rfl⟩
      show Limits.pullback.fst q pY (γ w) ∈ W
      rw [hpt]; exact hmemW w
    obtain ⟨γ', hγ'⟩ : ∃ γ', γ' ≫ (Limits.pullback.fst q pY ⁻¹ᵁ W).ι = γ :=
      ⟨_, IsOpenImmersion.lift_fac _ _ hrng⟩
    have hsec : γ' ≫ (Limits.pullback.fst q pY ∣_ W) = 𝟙 _ := by
      rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, reassoc_of% hγ', hγfst,
        Category.id_comp]
    haveI : IsClosedImmersion (γ' ≫ (Limits.pullback.fst q pY ∣_ W)) := by
      rw [hsec]; infer_instance
    haveI : IsClosedImmersion γ' := IsClosedImmersion.of_comp γ' (Limits.pullback.fst q pY ∣_ W)
    have hcl : IsClosed (Set.range γ') := γ'.isClosedEmbedding.isClosed_range
    obtain ⟨z', rfl⟩ : z ∈ Set.range (Limits.pullback.fst q pY ⁻¹ᵁ W).ι := by
      rw [Scheme.Opens.range_ι]; exact hzW
    have hpre : (Limits.pullback.fst q pY ⁻¹ᵁ W).ι ⁻¹' Set.range γ ⊆ Set.range γ' := by
      rintro y ⟨w, hw⟩
      refine ⟨w, ?_⟩
      apply (Limits.pullback.fst q pY ⁻¹ᵁ W).ι.isOpenEmbedding.injective
      rw [← hw, ← hγ'] <;> rfl
    have hz' : z' ∈ closure ((Limits.pullback.fst q pY ⁻¹ᵁ W).ι ⁻¹' Set.range γ) := by
      rw [← IsOpenMap.preimage_closure_eq_closure_preimage
        (Limits.pullback.fst q pY ⁻¹ᵁ W).ι.isOpenEmbedding.isOpenMap
        (Limits.pullback.fst q pY ⁻¹ᵁ W).ι.continuous]
      exact hz
    obtain ⟨w, hw⟩ := hcl.closure_subset (closure_mono hpre hz')
    exact ⟨w, by rw [← hw, ← hγ'] <;> rfl⟩
  ·
    exfalso
    obtain ⟨O, ε, s, htO, htε, hprod⟩ := hbd _ hzW
    have e : W.ι ⁻¹ᵁ O ≤ γ ⁻¹ᵁ (Limits.pullback.fst q pY ⁻¹ᵁ O) := by
      intro w hw
      show Limits.pullback.fst q pY (γ w) ∈ O
      rw [hpt]; exact hw
    have e' : γ ⁻¹ᵁ (Limits.pullback.fst q pY ⁻¹ᵁ O) ≤ W.ι ⁻¹ᵁ O := by
      intro w hw
      show W.ι w ∈ O
      rw [← hpt]; exact hw
    have eR : W.ι ⁻¹ᵁ O ≤ W.ι ⁻¹ᵁ (W ⊓ O) := fun w hw => ⟨hmemW w, hw⟩
    have hA : (Limits.pullback.fst q pY).app O ≫
        γ.appLE (Limits.pullback.fst q pY ⁻¹ᵁ O) (W.ι ⁻¹ᵁ O) e =
        X.presheaf.map (homOfLE (inf_le_right : W ⊓ O ≤ O)).op ≫
          W.ι.appLE (W ⊓ O) (W.ι ⁻¹ᵁ O) eR := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE, Scheme.Hom.map_appLE,
        hcongr _ _ hγfst]
    have eS : Limits.pullback.fst q pY ⁻¹ᵁ O ≤ Limits.pullback.snd q pY ⁻¹ᵁ ⊤ :=
      fun _ _ => trivial
    have eT : W.ι ⁻¹ᵁ O ≤ φ ⁻¹ᵁ ⊤ := fun _ _ => trivial
    have hB1 : (Limits.pullback.snd q pY).appLE ⊤ (Limits.pullback.fst q pY ⁻¹ᵁ O) eS ≫
        γ.appLE (Limits.pullback.fst q pY ⁻¹ᵁ O) (W.ι ⁻¹ᵁ O) e =
        φ.appLE ⊤ (W.ι ⁻¹ᵁ O) eT := by
      rw [Scheme.Hom.appLE_comp_appLE]
      exact hcongr _ _ hγsnd _ _ _
    have hB2 : φ.appLE ⊤ (W.ι ⁻¹ᵁ O) eT =
        φ.appTop ≫ W.topIso.hom ≫ X.presheaf.map (homOfLE (inf_le_left : W ⊓ O ≤ W)).op ≫
          W.ι.appLE (W ⊓ O) (W.ι ⁻¹ᵁ O) eR := by
      rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_hom,
        ← Scheme.Hom.appLE_map φ (le_refl (φ ⁻¹ᵁ ⊤)) (homOfLE eT).op, Scheme.Hom.appLE_eq_app,
        Scheme.Opens.toScheme_presheaf_map]
      refine congrArg (φ.app ⊤ ≫ ·) ?_
      exact (hkey3 _ _ _ _).symm
    have hB : (Limits.pullback.snd q pY).appLE ⊤ (Limits.pullback.fst q pY ⁻¹ᵁ O) eS ≫
        γ.appLE (Limits.pullback.fst q pY ⁻¹ᵁ O) (W.ι ⁻¹ᵁ O) e =
        φ.appTop ≫ W.topIso.hom ≫ X.presheaf.map (homOfLE (inf_le_left : W ⊓ O ≤ W)).op ≫
          W.ι.appLE (W ⊓ O) (W.ι ⁻¹ᵁ O) eR := hB1.trans hB2
    have hγg : γ.appLE (Limits.pullback.fst q pY ⁻¹ᵁ O) (W.ι ⁻¹ᵁ O) e
        ((Limits.pullback.fst q pY).app O ε *
          (Limits.pullback.snd q pY).appLE ⊤ (Limits.pullback.fst q pY ⁻¹ᵁ O) eS s) = 1 := by
      rw [map_mul, ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, hA, hB]
      simp only [ConcreteCategory.comp_apply]
      rw [← map_mul, hprod, map_one]
    obtain ⟨g, hg⟩ : ∃ g : Γ(Limits.pullback q pY, Limits.pullback.fst q pY ⁻¹ᵁ O),
        g = (Limits.pullback.fst q pY).app O ε *
          (Limits.pullback.snd q pY).appLE ⊤ (Limits.pullback.fst q pY ⁻¹ᵁ O) eS s :=
      ⟨_, rfl⟩
    rw [← hg] at hγg
    have hzero : γ.appLE (Limits.pullback.fst q pY ⁻¹ᵁ O) (W.ι ⁻¹ᵁ O) e (1 - g) = 0 := by
      rw [map_sub, map_one, hγg, sub_self]
    have hclosed1 := ((Limits.pullback q pY).basicOpen (1 - g)).isOpen.isClosed_compl
    have hrng1 : Set.range γ ⊆
        ((Limits.pullback q pY).basicOpen (1 - g) : Set ↥(Limits.pullback q pY))ᶜ := by
      rintro _ ⟨w, rfl⟩ hw
      have hwU : γ w ∈ Limits.pullback.fst q pY ⁻¹ᵁ O :=
        Scheme.basicOpen_le (Limits.pullback q pY) (1 - g) hw
      have hmem : w ∈ W.toScheme.basicOpen
          (γ.appLE (Limits.pullback.fst q pY ⁻¹ᵁ O) (W.ι ⁻¹ᵁ O) e (1 - g)) := by
        rw [Scheme.basicOpen_appLE]; exact ⟨e' hwU, hw⟩
      rw [hzero, Scheme.basicOpen_zero] at hmem
      simpa using hmem
    have hz1 : z ∉ (Limits.pullback q pY).basicOpen (1 - g) :=
      hclosed1.closure_subset_iff.mpr hrng1 hz
    have hz2 : z ∉ (Limits.pullback q pY).basicOpen g := by
      intro hzg
      rw [hg, Scheme.basicOpen_mul] at hzg
      have h1 := hzg.1
      rw [← Scheme.preimage_basicOpen] at h1
      exact htε h1
    have hzV : z ∈ Limits.pullback.fst q pY ⁻¹ᵁ O := htO
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self
      ((Limits.pullback q pY).presheaf.germ _ z hzV g) with hu | hu
    · exact hz2 ((Scheme.mem_basicOpen _ g z hzV).mpr hu)
    · apply hz1
      rw [Scheme.mem_basicOpen _ _ z hzV, map_sub, map_one]
      exact hu

theorem wc_csd_pqd_case1 : ∀ (B' : Scheme.{u}) [IsNoetherian B'] [IsAffine B'] (U' : B'.Opens) (Y : Scheme.{u}) (pY : Y ⟶ B') [IsAffineHom pY] [LocallyOfFiniteType pY] (f : U'.toScheme ⟶ Y), Dense (U' : Set B') → f ≫ pY = U'.ι → ∃ (X : Scheme.{u}) (q : X ⟶ B') (W : X.Opens) (φ : W.toScheme ⟶ Y) (e : U'.toScheme ⟶ W.toScheme), wcCsdAdmTower B' U' X q ∧ (∃ h : W.ι ≫ q = φ ≫ pY, IsClosedImmersion (Limits.pullback.lift W.ι φ h)) ∧ e ≫ W.ι ≫ q = U'.ι ∧ e ≫ φ = f :=
by
  classical
  intro B' _ _ U' Y pY _ _ f _hU'd hf
  haveI hYaff : IsAffine Y := isAffine_of_isAffineHom pY

  have hFT : RingHom.FiniteType pY.appTop.hom :=
    (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType)).mp inferInstance
  letI : Algebra Γ(B', ⊤) Γ(Y, ⊤) := pY.appTop.hom.toAlgebra
  obtain ⟨n, π, hπ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT
  let c : Fin n → Γ(Y, ⊤) := fun j => π (MvPolynomial.X j)
  have heq : MvPolynomial.eval₂Hom pY.appTop.hom c = π.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro a
      rw [MvPolynomial.eval₂Hom_C]
      show pY.appTop.hom a = π (MvPolynomial.C a)
      rw [← MvPolynomial.algebraMap_eq, π.commutes]
      rfl
    · intro j
      rw [MvPolynomial.eval₂Hom_X']
      rfl
  have hsurj : Function.Surjective (MvPolynomial.eval₂Hom pY.appTop.hom c) := by
    rw [heq]; exact hπ

  obtain ⟨m, N, u, g, hle, hN, hcov, hstar, hcomp⟩ := wc_csd_case1_normalize B' U' Y n f c

  have hdisj : ((wcCsdC1Ideal B' u g N).support : Set B') ∩ (U' : Set B') = ∅ := by
    ext x
    simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
    intro hxs hxU
    have hxU' : x ∈ ⨆ i, B'.basicOpen (u i) := hcov ▸ hxU
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hxU'
    have hz := (Scheme.IdealSheafData.mem_support_iff_of_mem (I := wcCsdC1Ideal B' u g N) (x := x)
      (U := ⟨⊤, isAffineOpen_top B'⟩) trivial).mp hxs
    rw [Scheme.mem_zeroLocus_iff] at hz
    apply hz ((B'.presheaf.map (homOfLE (le_top : (⊤ : B'.Opens) ≤ ⊤)).op).hom (u i ^ (2 * N)))
    · show _ ∈ (wcCsdC1Ideal B' u g N).ideal ⟨⊤, isAffineOpen_top B'⟩
      rw [wcCsdC1Ideal, Scheme.IdealSheafData.ofIdealTop_ideal]
      exact Ideal.mem_map_of_mem _ (Ideal.subset_span (Or.inr ⟨i, rfl⟩))
    · have e := Scheme.basicOpen_res B' (u i ^ (2 * N)) (homOfLE (le_top : (⊤ : B'.Opens) ≤ ⊤)).op
      erw [e, Scheme.basicOpen_pow B' (u i) (by omega)]
      exact ⟨trivial, hi⟩

  obtain ⟨X₁, r, hbl, -⟩ := wc_csd_blowup_exists_noeth B' (wcCsdC1Ideal B' u g N)

  obtain ⟨W, x, hWchar, ha, hUW, hcharts⟩ :=
    wc_csd_case1_chart_coords B' X₁ r U' m n N u g hN hcov hstar
  have hbd := wc_csd_case1_boundary_inverse B' X₁ r m n N u g W x hbl.1 hWchar ha
  obtain ⟨φ, h₀, hφc, hagree⟩ :=
    wc_csd_case1_factor B' X₁ Y r pY U' f m n N u g c hle W x hf hsurj hN hcov hcomp ha hcharts

  have hdisj' : ((wcCsdC1Ideal B' u g N).support : Set B') ∩
      ((𝟙 B' ⁻¹ᵁ U' : B'.Opens) : Set B') = ∅ := by
    rw [Scheme.Hom.id_preimage]; exact hdisj
  have htow : wcCsdAdmTower B' U' X₁ (r ≫ 𝟙 B') :=
    wcCsdAdmTower.step (𝟙 B') (wcCsdC1Ideal B' u g N) r wcCsdAdmTower.base hdisj' hbl
  have h : W.ι ≫ (r ≫ 𝟙 B') = φ ≫ pY := by rw [Category.comp_id]; exact h₀

  have hcl : IsClosedImmersion (Limits.pullback.lift W.ι φ h) := by
    apply wc_csd_closed_graph_of_local_inverse X₁ Y B' (r ≫ 𝟙 B') pY W φ h
    intro t ht
    obtain ⟨O, ε, j, htO, htε, hεx⟩ := hbd t ht
    exact ⟨O, ε, c j, htO, htε, by rw [hφc j]; exact hεx⟩

  haveI : IsIso (r ∣_ U') :=
    wc_csd_blowup_iso_off_center B' X₁ (wcCsdC1Ideal B' u g N) r U' hbl hdisj
  have hrng : Set.range (r ⁻¹ᵁ U').ι ⊆ Set.range W.ι := by
    rw [Scheme.Opens.range_ι, Scheme.Opens.range_ι]
    exact fun y hy => hUW hy
  obtain ⟨ι₀, hι₀⟩ : ∃ ι₀ : (r ⁻¹ᵁ U').toScheme ⟶ W.toScheme, ι₀ ≫ W.ι = (r ⁻¹ᵁ U').ι :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hrng⟩
  refine ⟨X₁, r ≫ 𝟙 B', W, φ, inv (r ∣_ U') ≫ ι₀, htow, ⟨h, hcl⟩, ?_, ?_⟩
  · rw [Category.comp_id, Category.assoc, reassoc_of% hι₀, ← morphismRestrict_ι,
      IsIso.inv_hom_id_assoc]
  · rw [Category.assoc, hagree ι₀ hι₀, IsIso.inv_hom_id_assoc]

theorem wc_csd_tower_refine_noeth : ∀ (B : Scheme.{u}) [IsNoetherian B] (U' : B.Opens) (k : ℕ) (X : Fin k → Scheme.{u}) (q : ∀ i, X i ⟶ B), (∀ i, wcCsdAdmTower B U' (X i) (q i)) → ∃ (X' : Scheme.{u}) (q' : X' ⟶ B) (π : ∀ i, X' ⟶ X i), wcCsdAdmTower B U' X' q' ∧ IsNoetherian X' ∧ ∀ i, π i ≫ q i = q' :=
by
  classical
  intro B hBn U' k X q htow

  have htrans : ∀ {X'' X₂ T : Scheme.{u}} (J : X₂.IdealSheafData) (b : X'' ⟶ X₂) (r : T ⟶ X''),
      wcCsdInvPull (J.comap b) r → wcCsdInvPull J (r ≫ b) := by
    intro X'' X₂ T J b r h t
    obtain ⟨W₀, V₀, e₀, a, ht, -, hnzd, hspan⟩ := h t
    obtain ⟨U, hU, hbU, -⟩ := exists_isAffineOpen_mem_and_subset (x := b (r t)) (U := ⊤) trivial
    obtain ⟨W, V, e, ε, hWO, htV, hε, hmap⟩ :=
      wc_csd_invpull_chart_shrink X'' T (J.comap b) r t W₀ V₀ e₀ a ht hnzd hspan (b ⁻¹ᵁ U) hbU
    have eW : W.1 ≤ b ⁻¹ᵁ (⟨U, hU⟩ : X₂.affineOpens).1 := hWO
    rw [wc_csd_comap_ideal_affine X'' X₂ J b ⟨U, hU⟩ W eW, Ideal.map_map] at hmap
    have e'' : V.1 ≤ (r ≫ b) ⁻¹ᵁ (⟨U, hU⟩ : X₂.affineOpens).1 := by
      intro x hx
      exact eW (e hx)
    have hcomp : (r.appLE W.1 V.1 e).hom.comp (b.appLE U W.1 eW).hom =
        ((r ≫ b).appLE U V.1 e'').hom := by
      rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
    rw [hcomp] at hmap
    obtain ⟨V', e', b₀, htV', hb₀, hnzd', hspan'⟩ :=
      wc_csd_invpull_local_generator X₂ T J (r ≫ b) ⟨U, hU⟩ V e'' ε t htV hε hmap
    exact ⟨⟨U, hU⟩, V', e', b₀, htV', hb₀, hnzd', hspan'⟩

  have hsupp : ∀ {X'' X₂ : Scheme.{u}} (J : X₂.IdealSheafData) (b : X'' ⟶ X₂) (q₂ : X₂ ⟶ B)
      (q'' : X'' ⟶ B), b ≫ q₂ = q'' →
      (J.support : Set X₂) ∩ ((q₂ ⁻¹ᵁ U' : X₂.Opens) : Set X₂) = ∅ →
      ((J.comap b).support : Set X'') ∩ ((q'' ⁻¹ᵁ U' : X''.Opens) : Set X'') = ∅ := by
    intro X'' X₂ J b q₂ q'' hbq hJ
    rw [Scheme.IdealSheafData.support_comap]
    apply Set.eq_empty_of_forall_notMem
    rintro x ⟨hx, hx'⟩
    have hmem : b x ∈ (J.support : Set X₂) ∩ ((q₂ ⁻¹ᵁ U' : X₂.Opens) : Set X₂) := by
      refine ⟨hx, ?_⟩
      show q₂ (b x) ∈ U'
      rw [← Scheme.Hom.comp_apply, hbq]
      exact hx'
    rw [hJ] at hmem
    exact hmem

  have hpair : ∀ {X₂ : Scheme.{u}} {q₂ : X₂ ⟶ B}, wcCsdAdmTower B U' X₂ q₂ →
      ∀ (X0 : Scheme.{u}) (q0 : X0 ⟶ B), wcCsdAdmTower B U' X0 q0 →
        AlgebraicGeometry.IsNoetherian X0 →
      ∃ (X' : Scheme.{u}) (q' : X' ⟶ B) (a : X' ⟶ X0) (b : X' ⟶ X₂),
        wcCsdAdmTower B U' X' q' ∧ AlgebraicGeometry.IsNoetherian X' ∧ a ≫ q0 = q' ∧
          b ≫ q₂ = q' := by
    intro X₂ q₂ h₂
    induction h₂ with
    | base =>
      intro X0 q0 h0 hn0
      exact ⟨X0, q0, 𝟙 X0, q0, h0, hn0, Category.id_comp q0, Category.comp_id q0⟩
    | step q₂ J r _ hJ hb ih =>
      intro X0 q0 h0 hn0
      obtain ⟨X'', q'', a, b, h'', hn'', ha, hb'⟩ := ih X0 q0 h0 hn0
      haveI := hn''
      obtain ⟨X''', r'', hbl, hn'''⟩ := wc_csd_blowup_exists_noeth X'' (J.comap b)
      have htow3 : wcCsdAdmTower B U' X''' (r'' ≫ q'') :=
        wcCsdAdmTower.step q'' (J.comap b) r'' h'' (hsupp J b q₂ q'' hb' hJ) hbl
      obtain ⟨b'', hb''1, -⟩ := hb.2 X''' (r'' ≫ b) (htrans J b r'' hbl.1)
      refine ⟨X''', r'' ≫ q'', r'' ≫ a, b'', htow3, hn''', ?_, ?_⟩
      · rw [Category.assoc, ha]
      · rw [← Category.assoc, hb''1, Category.assoc, hb']

  have hall : ∀ (k : ℕ) (X : Fin k → Scheme.{u}) (q : ∀ i, X i ⟶ B),
      (∀ i, wcCsdAdmTower B U' (X i) (q i)) →
      ∃ (X' : Scheme.{u}) (q' : X' ⟶ B) (π : ∀ i, X' ⟶ X i), wcCsdAdmTower B U' X' q' ∧
        AlgebraicGeometry.IsNoetherian X' ∧ ∀ i, π i ≫ q i = q' := by
    intro k
    induction k with
    | zero =>
      intro X q _
      exact ⟨B, 𝟙 B, fun i => i.elim0, wcCsdAdmTower.base, hBn, fun i => i.elim0⟩
    | succ k ih =>
      intro X q htw
      obtain ⟨X'', q'', π'', h'', hn'', hπ''⟩ :=
        ih (fun j => X j.castSucc) (fun j => q j.castSucc) (fun j => htw j.castSucc)
      obtain ⟨X', q', a, b, h', hn', ha, hb⟩ := hpair (htw (Fin.last k)) X'' q'' h'' hn''
      refine ⟨X', q', fun i => Fin.lastCases (motive := fun i => X' ⟶ X i) b
        (fun j => a ≫ π'' j) i, h', hn', ?_⟩
      intro i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · dsimp only
        rw [Fin.lastCases_last]
        exact hb
      · dsimp only
        rw [Fin.lastCases_castSucc, Category.assoc, hπ'' j, ha]
  exact hall k X q htow

theorem wc_csd_case2_local_graph : ∀ (B' : Scheme.{u}) (O : B'.Opens) (Y : Scheme.{u}) (pY : Y ⟶ B') (X0 : Scheme.{u}) (q0 : X0 ⟶ O.toScheme) (W0 : X0.Opens) (φ0 : W0.toScheme ⟶ (pY ⁻¹ᵁ O).toScheme) (h0 : W0.ι ≫ q0 = φ0 ≫ (pY ∣_ O)) (X1 : Scheme.{u}) (q1 : X1 ⟶ B') (κ : X0 ⟶ X1) [IsOpenImmersion κ] (X : Scheme.{u}) (q : X ⟶ B') (ρ : X ⟶ X1) (W : X.Opens) (ψ : W.toScheme ⟶ W0.toScheme) (h : W.ι ≫ q = (ψ ≫ φ0 ≫ (pY ⁻¹ᵁ O).ι) ≫ pY), IsClosedImmersion (Limits.pullback.lift W0.ι φ0 h0) → κ ≫ q1 = q0 ≫ O.ι → (∀ x : X1, x ∈ Set.range κ ↔ q1 x ∈ O) → ρ ≫ q1 = q → (∀ x : X, x ∈ W ↔ ρ x ∈ Set.range (W0.ι ≫ κ)) → ψ ≫ W0.ι ≫ κ = W.ι ≫ ρ → ∀ z ∈ closure (Set.range (Limits.pullback.lift W.ι (ψ ≫ φ0 ≫ (pY ⁻¹ᵁ O).ι) h)), q (Limits.pullback.fst q pY z) ∈ O → z ∈ Set.range (Limits.pullback.lift W.ι (ψ ≫ φ0 ≫ (pY ⁻¹ᵁ O).ι) h) :=
by
  classical
  intro B' O Y pY X0 q0 W0 φ0 h0 X1 q1 κ _ X q ρ W ψ h hcl0 hκq hκr hρ hWh hψ z hz hzO

  obtain ⟨m, hmfst, hmsnd⟩ : ∃ m : Limits.pullback q0 (pY ∣_ O) ⟶ Limits.pullback q1 pY,
      m ≫ Limits.pullback.fst q1 pY = Limits.pullback.fst _ _ ≫ κ ∧
      m ≫ Limits.pullback.snd q1 pY = Limits.pullback.snd _ _ ≫ (pY ⁻¹ᵁ O).ι := by
    refine ⟨Limits.pullback.lift (Limits.pullback.fst _ _ ≫ κ)
      (Limits.pullback.snd _ _ ≫ (pY ⁻¹ᵁ O).ι) ?_,
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    simp only [Category.assoc]
    rw [hκq, Limits.pullback.condition_assoc, morphismRestrict_ι]

  have hA := (IsPullback.of_hasPullback q0 (pY ∣_ O)).flip
  have hB := (isPullback_morphismRestrict pY O).flip
  have houter : IsPullback (m ≫ Limits.pullback.snd q1 pY)
      (Limits.pullback.fst q0 (pY ∣_ O)) pY (κ ≫ q1) := by
    rw [hmsnd, hκq]
    exact hA.paste_horiz hB
  have hbot : IsPullback m (Limits.pullback.fst q0 (pY ∣_ O)) (Limits.pullback.fst q1 pY) κ :=
    IsPullback.of_right houter hmfst (IsPullback.of_hasPullback q1 pY).flip
  haveI hmopen : IsOpenImmersion m :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hbot.flip ‹_›
  have hmrange : ∀ p, Limits.pullback.fst q1 pY p ∈ Set.range κ → p ∈ Set.range m := by
    intro p hp
    have hp' : p ∈ Set.range (Limits.pullback.fst (Limits.pullback.fst q1 pY) κ) := by
      rw [Scheme.Pullback.range_fst]; exact hp
    obtain ⟨w, hw⟩ := hp'
    refine ⟨hbot.isoPullback.inv w, ?_⟩
    rw [← hw]
    show (hbot.isoPullback.inv ≫ m) w = _
    rw [IsPullback.isoPullback_inv_fst]

  obtain ⟨γ0, hγ0⟩ : ∃ γ0, γ0 = Limits.pullback.lift W0.ι φ0 h0 := ⟨_, rfl⟩
  rw [← hγ0] at hcl0
  haveI := hcl0
  have hγ''fst : γ0 ≫ m ≫ Limits.pullback.fst q1 pY = W0.ι ≫ κ := by
    rw [hmfst, hγ0, Limits.pullback.lift_fst_assoc]
  have hγ''snd : γ0 ≫ m ≫ Limits.pullback.snd q1 pY = φ0 ≫ (pY ⁻¹ᵁ O).ι := by
    rw [hmsnd, hγ0, Limits.pullback.lift_snd_assoc]

  obtain ⟨n, hnfst, hnsnd⟩ : ∃ n : Limits.pullback q pY ⟶ Limits.pullback q1 pY,
      n ≫ Limits.pullback.fst q1 pY = Limits.pullback.fst q pY ≫ ρ ∧
      n ≫ Limits.pullback.snd q1 pY = Limits.pullback.snd q pY :=
    ⟨Limits.pullback.lift (Limits.pullback.fst q pY ≫ ρ) (Limits.pullback.snd q pY)
      (by rw [Category.assoc, hρ, Limits.pullback.condition]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have houterQ : IsPullback (n ≫ Limits.pullback.snd q1 pY) (Limits.pullback.fst q pY) pY
      (ρ ≫ q1) := by
    rw [hnsnd, hρ]
    exact (IsPullback.of_hasPullback q pY).flip
  have hbotQ : IsPullback n (Limits.pullback.fst q pY) (Limits.pullback.fst q1 pY) ρ :=
    IsPullback.of_right houterQ hnfst (IsPullback.of_hasPullback q1 pY).flip

  have hWsq : IsPullback ψ W.ι (W0.ι ≫ κ) ρ := by
    apply IsOpenImmersion.isPullback ψ W.ι (W0.ι ≫ κ) ρ hψ.symm
    rw [Scheme.Opens.opensRange_ι]
    ext x
    exact (hWh x).symm

  obtain ⟨γh, hγh⟩ : ∃ γh, γh = Limits.pullback.lift W.ι (ψ ≫ φ0 ≫ (pY ⁻¹ᵁ O).ι) h :=
    ⟨_, rfl⟩
  rw [← hγh] at hz ⊢
  have hcomm : ψ ≫ γ0 ≫ m = γh ≫ n := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hγ''fst, hnfst, hγh, Limits.pullback.lift_fst_assoc]
      exact hψ
    · simp only [Category.assoc]
      rw [hγ''snd, hnsnd, hγh, Limits.pullback.lift_snd]
  have hsq : IsPullback ψ γh (γ0 ≫ m) n := by
    refine IsPullback.of_bot ?_ hcomm hbotQ
    rw [hγh, Limits.pullback.lift_fst, Category.assoc, hγ''fst]
    exact hWsq
  have hrange : ∀ y, n y ∈ Set.range (γ0 ≫ m) → y ∈ Set.range γh := by
    intro y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst n (γ0 ≫ m)) := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨w, hw⟩ := hy'
    refine ⟨hsq.flip.isoPullback.inv w, ?_⟩
    rw [← hw]
    show (hsq.flip.isoPullback.inv ≫ γh) w = _
    rw [IsPullback.isoPullback_inv_fst]

  have hz1 : n z ∈ closure (Set.range (γ0 ≫ m)) := by
    refine map_mem_closure n.continuous hz ?_
    rintro _ ⟨w, rfl⟩
    refine ⟨ψ w, ?_⟩
    show (ψ ≫ γ0 ≫ m) w = (γh ≫ n) w
    rw [hcomm]
  have hfst : Limits.pullback.fst q1 pY (n z) = ρ (Limits.pullback.fst q pY z) := by
    show (n ≫ Limits.pullback.fst q1 pY) z = (Limits.pullback.fst q pY ≫ ρ) z
    rw [hnfst]
  have hk : ρ (Limits.pullback.fst q pY z) ∈ Set.range κ := by
    rw [hκr]
    show (ρ ≫ q1) (Limits.pullback.fst q pY z) ∈ O
    rw [hρ]
    exact hzO
  obtain ⟨r, hr⟩ := hmrange (n z) (by rw [hfst]; exact hk)
  have himg : m '' Set.range γ0 = Set.range (γ0 ≫ m) := by
    ext x
    constructor
    · rintro ⟨_, ⟨w, rfl⟩, rfl⟩
      exact ⟨w, rfl⟩
    · rintro ⟨w, rfl⟩
      exact ⟨γ0 w, ⟨w, rfl⟩, rfl⟩
  have hrc : r ∈ closure (Set.range γ0) := by
    rw [m.isOpenEmbedding.isInducing.closure_eq_preimage_closure_image, himg]
    rw [Set.mem_preimage, hr]
    exact hz1
  rw [γ0.isClosedEmbedding.isClosed_range.closure_eq] at hrc
  obtain ⟨w0, rfl⟩ := hrc
  exact hrange z ⟨w0, hr⟩

theorem wc_csd_eq_of_schem_dense : ∀ (X Y B : Scheme.{u}) (pY : Y ⟶ B) [IsSeparated pY] (S V : X.Opens) (h₁ h₂ : V.toScheme ⟶ Y), (∀ O : X.Opens, Function.Injective (X.presheaf.map (homOfLE (inf_le_left : O ⊓ S ≤ O)).op)) → h₁ ≫ pY = h₂ ≫ pY → X.homOfLE (inf_le_left : V ⊓ S ≤ V) ≫ h₁ = X.homOfLE (inf_le_left : V ⊓ S ≤ V) ≫ h₂ → h₁ = h₂ :=
by
  intro X Y B pY _ S V h₁ h₂ hS hb hc
  have injcomp : ∀ {R R' R'' : CommRingCat.{u}} (f : R ⟶ R') (g : R' ⟶ R''),
      Function.Injective (f ≫ g) → Function.Injective f := by
    intro R R' R'' f g h a b hab
    apply h
    simp only [CategoryTheory.comp_apply, hab]

  have hjinj : ∀ U : V.toScheme.Opens,
      Function.Injective ((X.homOfLE (inf_le_left : V ⊓ S ≤ V)).app U) := by
    intro U
    rw [Scheme.homOfLE_app]
    have hOS : V.ι ''ᵁ U ⊓ S ≤ (V ⊓ S).ι ''ᵁ (X.homOfLE (inf_le_left : V ⊓ S ≤ V) ⁻¹ᵁ U) := by
      rintro x ⟨hxO, hxS⟩
      have hxO' : x ∈ V.ι '' (U : Set V.toScheme) := by
        rw [← Scheme.Hom.coe_image]; exact hxO
      obtain ⟨u, hu, rfl⟩ := hxO'
      have hxV : V.ι u ∈ V ⊓ S := ⟨u.2, hxS⟩
      let w : (V ⊓ S).toScheme := ⟨V.ι u, hxV⟩
      have hw : (V ⊓ S).ι w = V.ι u := rfl
      have hjw : X.homOfLE (inf_le_left : V ⊓ S ≤ V) w = u := by
        apply V.ι.isOpenEmbedding.injective
        rw [← Scheme.Hom.comp_apply, Scheme.homOfLE_ι, hw]
      show V.ι u ∈ ((V ⊓ S).ι ''ᵁ (X.homOfLE (inf_le_left : V ⊓ S ≤ V) ⁻¹ᵁ U) : Set X)
      rw [Scheme.Hom.coe_image]
      refine ⟨w, ?_, hw⟩
      show X.homOfLE (inf_le_left : V ⊓ S ≤ V) w ∈ U
      rw [hjw]; exact hu
    have hfac : X.presheaf.map (homOfLE (inf_le_left : V.ι ''ᵁ U ⊓ S ≤ V.ι ''ᵁ U)).op =
        X.presheaf.map (homOfLE (Scheme.ι_image_homOfLE_le_ι_image
          (inf_le_left : V ⊓ S ≤ V) U)).op ≫ X.presheaf.map (homOfLE hOS).op := by
      rw [← Functor.map_comp]
      rfl
    have h0 := hS (V.ι ''ᵁ U)
    rw [hfac] at h0
    exact injcomp _ _ h0

  set j := X.homOfLE (inf_le_left : V ⊓ S ≤ V) with hj
  set g := Limits.pullback.lift h₁ h₂ hb with hg
  set Δ := Limits.pullback.diagonal pY with hΔ
  set i := Limits.pullback.fst g Δ with hi
  set σ := Limits.pullback.snd g Δ with hσ
  have hcond : i ≫ g = σ ≫ Δ := Limits.pullback.condition
  have hg1 : g ≫ Limits.pullback.fst pY pY = h₁ := Limits.pullback.lift_fst _ _ _
  have hg2 : g ≫ Limits.pullback.snd pY pY = h₂ := Limits.pullback.lift_snd _ _ _
  have hΔ1 : Δ ≫ Limits.pullback.fst pY pY = 𝟙 _ := Limits.pullback.diagonal_fst pY
  have hΔ2 : Δ ≫ Limits.pullback.snd pY pY = 𝟙 _ := Limits.pullback.diagonal_snd pY
  have hk : j ≫ g = (j ≫ h₁) ≫ Δ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, hg1, hΔ1, Category.comp_id]
    · rw [Category.assoc, Category.assoc, hg2, hΔ2, Category.comp_id, hc]
  set k := Limits.pullback.lift j (j ≫ h₁) hk with hkdef
  have hki : k ≫ i = j := Limits.pullback.lift_fst _ _ _

  have hfac : ∀ {T Z' : Scheme.{u}} (i' : Z' ⟶ V.toScheme) (j' : T ⟶ V.toScheme) (k' : T ⟶ Z'),
      k' ≫ i' = j' → (∀ U : V.toScheme.Opens, Function.Injective (j'.app U)) →
      ∀ U : V.toScheme.Opens, Function.Injective (i'.app U) := by
    intro T Z' i' j' k' hkij hj' U
    subst hkij
    have h0 := hj' U
    rw [Scheme.Hom.comp_app] at h0
    exact injcomp _ _ h0
  have hiinj := hfac i j k hki hjinj
  have hiso : IsIso i := by
    rw [IsClosedImmersion.isIso_iff_ker_eq_bot]
    refine le_antisymm ?_ bot_le
    rw [Scheme.IdealSheafData.le_def]
    intro U
    rw [Scheme.Hom.ker_apply, Scheme.IdealSheafData.ideal_bot]
    intro a ha
    rw [RingHom.mem_ker] at ha
    have ha0 : a = 0 := hiinj U (by rw [map_zero]; exact ha)
    rw [ha0]
    exact Submodule.zero_mem _

  have e1 : i ≫ h₁ = σ := by
    rw [← hg1, ← Category.assoc, hcond, Category.assoc, hΔ1, Category.comp_id]
  have e2 : i ≫ h₂ = σ := by
    rw [← hg2, ← Category.assoc, hcond, Category.assoc, hΔ2, Category.comp_id]
  exact (cancel_epi i).mp (e1.trans e2.symm)

theorem wc_csd_glue_opens : ∀ (X Y : Scheme.{u}) (k : ℕ) (V : Fin k → X.Opens), (∀ (V₀ : X.Opens) (hle : ∀ l, V l ≤ V₀), V₀ ≤ ⨆ l, V l → ∀ (g₁ g₂ : V₀.toScheme ⟶ Y), (∀ l, X.homOfLE (hle l) ≫ g₁ = X.homOfLE (hle l) ≫ g₂) → g₁ = g₂) ∧ ∀ g : ∀ l, (V l).toScheme ⟶ Y, (∀ l m, X.homOfLE (inf_le_left : V l ⊓ V m ≤ V l) ≫ g l = X.homOfLE (inf_le_right : V l ⊓ V m ≤ V m) ≫ g m) → ∃ φ : (⨆ l, V l).toScheme ⟶ Y, ∀ l, X.homOfLE (le_iSup V l) ≫ φ = g l :=
by
  intro X Y k V
  refine ⟨?_, ?_⟩
  · intro V₀ hle hsup g₁ g₂ H
    obtain rfl : V₀ = ⨆ l, V l := le_antisymm hsup (iSup_le hle)
    exact Scheme.Cover.hom_ext (Scheme.Opens.iSupOpenCover V) g₁ g₂ (fun l => H l)
  · intro g hg
    have hf : ∀ x y : Fin k,
        Limits.pullback.fst ((Scheme.Opens.iSupOpenCover V).f x)
            ((Scheme.Opens.iSupOpenCover V).f y) ≫ g x =
          Limits.pullback.snd ((Scheme.Opens.iSupOpenCover V).f x)
            ((Scheme.Opens.iSupOpenCover V).f y) ≫ g y := by
      intro x y
      have P : IsPullback (X.homOfLE (inf_le_left : V x ⊓ V y ≤ V x))
          (X.homOfLE (inf_le_right : V x ⊓ V y ≤ V y))
          ((Scheme.Opens.iSupOpenCover V).f x) ((Scheme.Opens.iSupOpenCover V).f y) :=
        isPullback_opens_inf_le (le_iSup V x) (le_iSup V y)
      have e1 := P.isoPullback_hom_fst
      have e2 := P.isoPullback_hom_snd
      apply (cancel_epi P.isoPullback.hom).mp
      calc P.isoPullback.hom ≫ Limits.pullback.fst _ _ ≫ g x
          = (P.isoPullback.hom ≫ Limits.pullback.fst _ _) ≫ g x := (Category.assoc _ _ _).symm
        _ = X.homOfLE (inf_le_left : V x ⊓ V y ≤ V x) ≫ g x := by rw [e1]
        _ = X.homOfLE (inf_le_right : V x ⊓ V y ≤ V y) ≫ g y := hg x y
        _ = (P.isoPullback.hom ≫ Limits.pullback.snd _ _) ≫ g y := by rw [e2]
        _ = P.isoPullback.hom ≫ Limits.pullback.snd _ _ ≫ g y := Category.assoc _ _ _
    exact ⟨Scheme.Cover.glueMorphisms (Scheme.Opens.iSupOpenCover V) g hf,
      fun l => Scheme.Cover.ι_glueMorphisms (Scheme.Opens.iSupOpenCover V) g hf l⟩

theorem wc_csd_pqd_case2 : ∀ (B' : Scheme.{u}) [IsNoetherian B'] (U' : B'.Opens) (Y : Scheme.{u}) (pY : Y ⟶ B') [IsAffineHom pY] [LocallyOfFiniteType pY] (f : U'.toScheme ⟶ Y), Dense (U' : Set B') → f ≫ pY = U'.ι → ∃ (X : Scheme.{u}) (q : X ⟶ B') (W : X.Opens) (φ : W.toScheme ⟶ Y) (e : U'.toScheme ⟶ W.toScheme), wcCsdAdmTower B' U' X q ∧ (∃ h : W.ι ≫ q = φ ≫ pY, IsClosedImmersion (Limits.pullback.lift W.ι φ h)) ∧ e ≫ W.ι ≫ q = U'.ι ∧ e ≫ φ = f :=
by
  classical
  intro B' _ U' Y pY _ _ f hU'd hf
  have hmemι : ∀ {Z : Scheme.{u}} (V : Z.Opens) (v : V.toScheme), V.ι v ∈ V := fun V v => v.2

  have htowiso : ∀ {B₀ : Scheme.{u}} {V₀ : B₀.Opens} {Z : Scheme.{u}} {t : Z ⟶ B₀},
      wcCsdAdmTower B₀ V₀ Z t → (∀ V'' : B₀.Opens, V'' ≤ V₀ → IsIso (t ∣_ V'')) ∧
        (Dense (V₀ : Set B₀) → Dense ((t ⁻¹ᵁ V₀ : Z.Opens) : Set Z)) := by
    intro B₀ V₀ Z t h
    induction h with
    | base => exact ⟨fun V'' _ => inferInstance, fun hd => hd⟩
    | @step X0 X1 q I r _ hI hb ih =>
      refine ⟨fun V'' hV'' => ?_, fun hd => ?_⟩
      · have h1 : IsIso (r ∣_ (q ⁻¹ᵁ V'')) := by
          apply wc_csd_blowup_iso_off_center X0 X1 I r (q ⁻¹ᵁ V'') hb
          apply Set.eq_empty_of_subset_empty
          rintro x ⟨hx1, hx2⟩
          have hmem : x ∈ (I.support : Set X0) ∩ ((q ⁻¹ᵁ V₀ : X0.Opens) : Set X0) :=
            ⟨hx1, hV'' hx2⟩
          rw [hI] at hmem
          exact hmem
        haveI := ih.1 V'' hV''
        rw [morphismRestrict_comp]
        exact IsIso.comp_isIso' h1 ‹_›
      · obtain ⟨W0, hW0⟩ : ∃ W0 : X0.Opens, (W0 : Set X0) = (I.support : Set X0)ᶜ :=
          ⟨⟨(I.support : Set X0)ᶜ, I.support.isClosed.isOpen_compl⟩, rfl⟩
        have hiso0 : IsIso (r ∣_ W0) :=
          wc_csd_blowup_iso_off_center X0 X1 I r W0 hb (by rw [hW0]; exact Set.inter_compl_self _)
        have hd0 := (wc_csd_invpull_compl_schem_dense X0 X1 I r W0 hb.1 hW0).2
        have hle : q ⁻¹ᵁ V₀ ≤ W0 := by
          intro x hx
          show x ∈ (W0 : Set X0)
          rw [hW0]
          intro hs
          have hmem : x ∈ (I.support : Set X0) ∩ ((q ⁻¹ᵁ V₀ : X0.Opens) : Set X0) := ⟨hs, hx⟩
          rw [hI] at hmem
          exact hmem
        exact wc_csd_dense_preimage_transfer X0 X1 r W0 (q ⁻¹ᵁ V₀) hle (ih.2 hd) hiso0 hd0

  have huniq : ∀ {B₀ : Scheme.{u}} {V₀ : B₀.Opens} {Z : Scheme.{u}} {t : Z ⟶ B₀},
      wcCsdAdmTower B₀ V₀ Z t → ∀ {T : Scheme.{u}} (a b : T ⟶ Z), a ≫ t = b ≫ t →
        Set.range (a ≫ t) ⊆ (V₀ : Set B₀) → a = b := by
    intro B₀ V₀ Z t h T a b hab hr
    haveI := (htowiso h).1 V₀ le_rfl
    have ha : Set.range a ⊆ Set.range (t ⁻¹ᵁ V₀).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      exact hr ⟨x, rfl⟩
    have hb : Set.range b ⊆ Set.range (t ⁻¹ᵁ V₀).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      rw [hab] at hr
      exact hr ⟨x, rfl⟩
    obtain ⟨a', ha'⟩ : ∃ a', a' ≫ (t ⁻¹ᵁ V₀).ι = a := ⟨_, IsOpenImmersion.lift_fac _ _ ha⟩
    obtain ⟨b', hb'⟩ : ∃ b', b' ≫ (t ⁻¹ᵁ V₀).ι = b := ⟨_, IsOpenImmersion.lift_fac _ _ hb⟩
    have e1 : a' ≫ (t ∣_ V₀) = b' ≫ (t ∣_ V₀) := by
      rw [← cancel_mono V₀.ι, Category.assoc, Category.assoc, morphismRestrict_ι,
        ← Category.assoc, ← Category.assoc, ha', hb']
      exact hab
    have e2 : a' = b' := (cancel_mono _).mp e1
    rw [← ha', ← hb', e2]

  obtain ⟨k, Bc, hBcaff, hBcov⟩ : ∃ (k : ℕ) (Bc : Fin k → B'.Opens),
      (∀ l, IsAffineOpen (Bc l)) ∧ ∀ x : B', ∃ l, x ∈ Bc l := by
    have hA : ∀ z : B', ∃ A : B'.Opens, IsAffineOpen A ∧ z ∈ A := fun z => by
      obtain ⟨A, hA, hzA, -⟩ := exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
      exact ⟨A, hA, hzA⟩
    choose A hAaff hzA using hA
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun z => (A z : Set B'))
      (fun z => (A z).isOpen) (fun z _ => Set.mem_iUnion.mpr ⟨z, hzA z⟩)
    refine ⟨t.card, fun i => A (t.equivFin.symm i), fun i => hAaff _, fun x => ?_⟩
    have hx := ht (Set.mem_univ x)
    simp only [Set.mem_iUnion] at hx
    obtain ⟨z, hz, hxz⟩ := hx
    refine ⟨t.equivFin ⟨z, hz⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hxz

  have hloc : ∀ l : Fin k, ∃ (X0 : Scheme.{u}) (q0 : X0 ⟶ (Bc l).toScheme) (W0 : X0.Opens)
      (φ0 : W0.toScheme ⟶ (pY ⁻¹ᵁ Bc l).toScheme)
      (e0 : ((Bc l).ι ⁻¹ᵁ U').toScheme ⟶ W0.toScheme)
      (Xl : Scheme.{u}) (ql : Xl ⟶ B') (κ : X0 ⟶ Xl)
      (a : ((Bc l).ι ⁻¹ᵁ U').toScheme ⟶ U'.toScheme)
      (h0 : W0.ι ≫ q0 = φ0 ≫ (pY ∣_ Bc l)),
      wcCsdAdmTower (Bc l).toScheme ((Bc l).ι ⁻¹ᵁ U') X0 q0 ∧
      IsClosedImmersion (Limits.pullback.lift W0.ι φ0 h0) ∧
      e0 ≫ W0.ι ≫ q0 = ((Bc l).ι ⁻¹ᵁ U').ι ∧
      e0 ≫ φ0 ≫ (pY ⁻¹ᵁ Bc l).ι = a ≫ f ∧
      a ≫ U'.ι = ((Bc l).ι ⁻¹ᵁ U').ι ≫ (Bc l).ι ∧
      wcCsdAdmTower B' U' Xl ql ∧ IsOpenImmersion κ ∧ κ ≫ ql = q0 ≫ (Bc l).ι ∧
      ∀ x : Xl, x ∈ Set.range κ ↔ ql x ∈ Bc l := by
    intro l
    haveI : IsAffine (Bc l).toScheme := hBcaff l
    haveI : IsLocallyNoetherian (Bc l).toScheme := isLocallyNoetherian_of_isOpenImmersion (Bc l).ι
    haveI : CompactSpace (Bc l).toScheme :=
      isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact ((Bc l) : Set B'))
    haveI : AlgebraicGeometry.IsNoetherian (Bc l).toScheme :=
      { toIsLocallyNoetherian := ‹_›, toCompactSpace := ‹_› }
    haveI : IsAffineHom (pY ∣_ Bc l) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (isPullback_morphismRestrict pY (Bc l)).flip ‹_›
    have hUld : Dense (((Bc l).ι ⁻¹ᵁ U' : (Bc l).toScheme.Opens) : Set (Bc l).toScheme) :=
      hU'd.preimage (Bc l).ι.isOpenEmbedding.isOpenMap
    have hra : Set.range (((Bc l).ι ⁻¹ᵁ U').ι ≫ (Bc l).ι) ⊆ Set.range U'.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      exact hmemι _ x
    obtain ⟨a, ha⟩ : ∃ a : ((Bc l).ι ⁻¹ᵁ U').toScheme ⟶ U'.toScheme,
        a ≫ U'.ι = ((Bc l).ι ⁻¹ᵁ U').ι ≫ (Bc l).ι := ⟨_, IsOpenImmersion.lift_fac _ _ hra⟩
    have hrf : Set.range (a ≫ f) ⊆ Set.range (pY ⁻¹ᵁ Bc l).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      show (a ≫ f ≫ pY) x ∈ Bc l
      rw [hf, ha]
      exact hmemι _ (((Bc l).ι ⁻¹ᵁ U').ι x)
    obtain ⟨fl, hfl⟩ : ∃ fl : ((Bc l).ι ⁻¹ᵁ U').toScheme ⟶ (pY ⁻¹ᵁ Bc l).toScheme,
        fl ≫ (pY ⁻¹ᵁ Bc l).ι = a ≫ f := ⟨_, IsOpenImmersion.lift_fac _ _ hrf⟩
    have hflp : fl ≫ (pY ∣_ Bc l) = ((Bc l).ι ⁻¹ᵁ U').ι := by
      rw [← cancel_mono (Bc l).ι, Category.assoc, morphismRestrict_ι, reassoc_of% hfl, hf, ha]
    obtain ⟨X0, q0, W0, φ0, e0, htow0, ⟨h0, hcl0⟩, he01, he02⟩ :=
      wc_csd_pqd_case1 (Bc l).toScheme ((Bc l).ι ⁻¹ᵁ U') (pY ⁻¹ᵁ Bc l).toScheme (pY ∣_ Bc l) fl
        hUld hflp
    obtain ⟨Xl, ql, κ, htowl, hκ, hκq, hκr⟩ := wc_csd_tower_extend B' (Bc l) U' X0 q0 htow0
    refine ⟨X0, q0, W0, φ0, e0, Xl, ql, κ, a, h0, htow0, hcl0, he01, ?_, ha, htowl, hκ, hκq, hκr⟩
    rw [← Category.assoc, he02, hfl]
  choose X0 q0 W0 φ0 e0 Xl ql κ a h0 htow0 hcl0 he01 he02 ha htowl hκ hκq hκr using hloc
  haveI := hκ

  obtain ⟨X₁, q₁, π, htow₁, hX₁n, hπ⟩ := wc_csd_tower_refine_noeth B' U' k Xl ql htowl
  haveI := hX₁n
  obtain ⟨I, hIsupp⟩ : ∃ I : X₁.IdealSheafData,
      (I.support : Set X₁) = ((q₁ ⁻¹ᵁ U' : X₁.Opens) : Set X₁)ᶜ :=
    ⟨Scheme.IdealSheafData.vanishingIdeal ⟨_, (q₁ ⁻¹ᵁ U').isOpen.isClosed_compl⟩,
      Scheme.IdealSheafData.coe_support_vanishingIdeal _⟩
  obtain ⟨X, r, hbl, -⟩ := wc_csd_blowup_exists_noeth X₁ I
  have hdisj : (I.support : Set X₁) ∩ ((q₁ ⁻¹ᵁ U' : X₁.Opens) : Set X₁) = ∅ := by
    rw [hIsupp]; exact Set.compl_inter_self _
  have hWc : ((q₁ ⁻¹ᵁ U' : X₁.Opens) : Set X₁) = (I.support : Set X₁)ᶜ := by
    rw [hIsupp, compl_compl]
  obtain ⟨hSD, -⟩ := wc_csd_invpull_compl_schem_dense X₁ X I r (q₁ ⁻¹ᵁ U') hbl.1 hWc
  obtain ⟨q, hq⟩ : ∃ q : X ⟶ B', q = r ≫ q₁ := ⟨_, rfl⟩
  have htow : wcCsdAdmTower B' U' X q := by
    rw [hq]; exact wcCsdAdmTower.step q₁ I r htow₁ hdisj hbl
  have hSDq : ∀ O : X.Opens,
      Function.Injective (X.presheaf.map (homOfLE (inf_le_left : O ⊓ q ⁻¹ᵁ U' ≤ O)).op) := by
    subst hq; exact hSD
  have hqd : Dense ((q ⁻¹ᵁ U' : X.Opens) : Set X) := (htowiso htow).2 hU'd
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ∀ l, X ⟶ Xl l, ∀ l, ρ l ≫ ql l = q :=
    ⟨fun l => r ≫ π l, fun l => by
      show (r ≫ π l) ≫ ql l = q
      rw [Category.assoc, hπ l, hq]⟩

  obtain ⟨Wh, hWh⟩ : ∃ Wh : Fin k → X.Opens,
      ∀ l x, x ∈ Wh l ↔ ρ l x ∈ Set.range ((W0 l).ι ≫ κ l) :=
    ⟨fun l => ρ l ⁻¹ᵁ ((W0 l).ι ≫ κ l).opensRange, fun l x => Iff.rfl⟩
  have hψex : ∀ l, ∃ ψ : (Wh l).toScheme ⟶ (W0 l).toScheme,
      ψ ≫ (W0 l).ι ≫ κ l = (Wh l).ι ≫ ρ l := by
    intro l
    have hr : Set.range ((Wh l).ι ≫ ρ l) ⊆ Set.range ((W0 l).ι ≫ κ l) := by
      rintro _ ⟨x, rfl⟩
      exact (hWh l _).mp (hmemι _ x)
    exact ⟨_, IsOpenImmersion.lift_fac _ _ hr⟩
  choose ψ hψ using hψex
  have hl : ∀ l, (Wh l).ι ≫ q = (ψ l ≫ φ0 l ≫ (pY ⁻¹ᵁ Bc l).ι) ≫ pY := by
    intro l
    rw [← hρ l, ← Category.assoc (Wh l).ι (ρ l) (ql l), ← hψ l]
    simp only [Category.assoc]
    rw [hκq l, reassoc_of% (h0 l), morphismRestrict_ι]
  have hl' : ∀ l, (Wh l).ι ≫ q = ψ l ≫ φ0 l ≫ (pY ⁻¹ᵁ Bc l).ι ≫ pY := fun l => by
    rw [hl l]; simp only [Category.assoc]
  have hkey : ∀ (l : Fin k) {T : Scheme.{u}} (b : T ⟶ X) (c : T ⟶ ((Bc l).ι ⁻¹ᵁ U').toScheme),
      c ≫ ((Bc l).ι ⁻¹ᵁ U').ι ≫ (Bc l).ι = b ≫ q →
      b ≫ ρ l = c ≫ e0 l ≫ (W0 l).ι ≫ κ l := by
    intro l T b c hbc
    apply huniq (htowl l)
    · simp only [Category.assoc]
      rw [hρ l, ← hbc, hκq l, reassoc_of% (he01 l)]
    · rw [Category.assoc, hρ l, ← hbc]
      rintro _ ⟨x, rfl⟩
      exact hmemι _ (c x)
  have hlift : ∀ (l : Fin k) (V : X.Opens), V ≤ q ⁻¹ᵁ U' → V ≤ q ⁻¹ᵁ Bc l →
      ∃ c : V.toScheme ⟶ ((Bc l).ι ⁻¹ᵁ U').toScheme,
        c ≫ ((Bc l).ι ⁻¹ᵁ U').ι ≫ (Bc l).ι = V.ι ≫ q := by
    intro l V hV1 hV2
    have hr : Set.range (V.ι ≫ q) ⊆ Set.range (((Bc l).ι ⁻¹ᵁ U').ι ≫ (Bc l).ι) := by
      rintro _ ⟨v, rfl⟩
      have h2 : q (V.ι v) ∈ Bc l := hV2 (hmemι V v)
      obtain ⟨y, hy⟩ : q (V.ι v) ∈ Set.range (Bc l).ι := by
        rw [Scheme.Opens.range_ι]; exact h2
      obtain ⟨y', hy'⟩ : y ∈ Set.range ((Bc l).ι ⁻¹ᵁ U').ι := by
        rw [Scheme.Opens.range_ι]
        show (Bc l).ι y ∈ U'
        rw [hy]; exact hV1 (hmemι V v)
      refine ⟨y', ?_⟩
      show (Bc l).ι (((Bc l).ι ⁻¹ᵁ U').ι y') = q (V.ι v)
      rw [hy', hy]
    exact ⟨_, IsOpenImmersion.lift_fac _ _ hr⟩
  have hsub : ∀ l, Wh l ≤ q ⁻¹ᵁ Bc l := by
    intro l x hx
    obtain ⟨y, hy⟩ := (hWh l x).mp hx
    show q x ∈ Bc l
    rw [← hρ l]
    show ql l (ρ l x) ∈ Bc l
    rw [← hy]
    show ((W0 l).ι ≫ κ l ≫ ql l) y ∈ Bc l
    rw [hκq l]
    exact hmemι _ (q0 l ((W0 l).ι y))
  have hcov : ∀ l, q ⁻¹ᵁ U' ⊓ q ⁻¹ᵁ Bc l ≤ Wh l := by
    intro l
    obtain ⟨c, hc⟩ := hlift l (q ⁻¹ᵁ U' ⊓ q ⁻¹ᵁ Bc l) inf_le_left inf_le_right
    have hk := hkey l _ c hc
    intro x hx
    obtain ⟨v, rfl⟩ : x ∈ Set.range (q ⁻¹ᵁ U' ⊓ q ⁻¹ᵁ Bc l).ι := by
      rw [Scheme.Opens.range_ι]; exact hx
    rw [hWh l]
    refine ⟨e0 l (c v), ?_⟩
    show (c ≫ e0 l ≫ (W0 l).ι ≫ κ l) v = ((q ⁻¹ᵁ U' ⊓ q ⁻¹ᵁ Bc l).ι ≫ ρ l) v
    rw [hk]
  have hagree : ∀ l (V : X.Opens) (h1 : V ≤ Wh l) (h2 : V ≤ q ⁻¹ᵁ U'),
      X.homOfLE h1 ≫ ψ l ≫ φ0 l ≫ (pY ⁻¹ᵁ Bc l).ι = X.homOfLE h2 ≫ (q ∣_ U') ≫ f := by
    intro l V h1 h2
    obtain ⟨c, hc⟩ := hlift l V h2 (h1.trans (hsub l))
    have hk := hkey l _ c hc
    have e1 : X.homOfLE h1 ≫ ψ l = c ≫ e0 l := by
      rw [← cancel_mono ((W0 l).ι ≫ κ l)]
      simp only [Category.assoc]
      rw [hψ l, Scheme.homOfLE_ι_assoc, hk]
    have e2 : c ≫ a l = X.homOfLE h2 ≫ (q ∣_ U') := by
      rw [← cancel_mono U'.ι]
      simp only [Category.assoc]
      rw [ha l, hc, morphismRestrict_ι, Scheme.homOfLE_ι_assoc]
    rw [reassoc_of% e1, he02 l, reassoc_of% e2]

  have hcompat : ∀ l m, X.homOfLE (inf_le_left : Wh l ⊓ Wh m ≤ Wh l) ≫
      (ψ l ≫ φ0 l ≫ (pY ⁻¹ᵁ Bc l).ι) =
      X.homOfLE (inf_le_right : Wh l ⊓ Wh m ≤ Wh m) ≫ (ψ m ≫ φ0 m ≫ (pY ⁻¹ᵁ Bc m).ι) := by
    intro l m
    apply wc_csd_eq_of_schem_dense X Y B' pY (q ⁻¹ᵁ U') (Wh l ⊓ Wh m) _ _ hSDq
    · simp only [Category.assoc]
      rw [← hl' l, ← hl' m, Scheme.homOfLE_ι_assoc, Scheme.homOfLE_ι_assoc]
    · simp only [Scheme.homOfLE_homOfLE_assoc]
      rw [hagree l (Wh l ⊓ Wh m ⊓ q ⁻¹ᵁ U') (inf_le_left.trans inf_le_left) inf_le_right,
        hagree m (Wh l ⊓ Wh m ⊓ q ⁻¹ᵁ U') (inf_le_left.trans inf_le_right) inf_le_right]
  obtain ⟨φ, hφ⟩ :=
    (wc_csd_glue_opens X Y k Wh).2 (fun l => ψ l ≫ φ0 l ≫ (pY ⁻¹ᵁ Bc l).ι) hcompat
  have hWq : (⨆ l, Wh l).ι ≫ q = φ ≫ pY := by
    apply (wc_csd_glue_opens X B' k Wh).1 (⨆ l, Wh l) (le_iSup Wh) le_rfl
    intro l
    rw [Scheme.homOfLE_ι_assoc, hl l, ← Category.assoc (X.homOfLE (le_iSup Wh l)) φ pY, hφ l]
  have hS₀W : q ⁻¹ᵁ U' ≤ ⨆ l, Wh l := by
    intro x hx
    obtain ⟨l, hxl⟩ := hBcov (q x)
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨l, hcov l ⟨hx, hxl⟩⟩
  have hS₀φ : X.homOfLE hS₀W ≫ φ = (q ∣_ U') ≫ f := by
    have hcov' : q ⁻¹ᵁ U' ≤ ⨆ l, (q ⁻¹ᵁ U' ⊓ Wh l) := by
      intro x hx
      obtain ⟨l, hxl⟩ := hBcov (q x)
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨l, ⟨hx, hcov l ⟨hx, hxl⟩⟩⟩
    apply (wc_csd_glue_opens X Y k (fun l => q ⁻¹ᵁ U' ⊓ Wh l)).1 (q ⁻¹ᵁ U')
      (fun l => inf_le_left) hcov'
    intro l
    have h1 := hagree l (q ⁻¹ᵁ U' ⊓ Wh l) inf_le_right inf_le_left
    rw [← hφ l, Scheme.homOfLE_homOfLE_assoc] at h1
    rw [Scheme.homOfLE_homOfLE_assoc]
    exact h1

  obtain ⟨γ, hγ⟩ : ∃ γ, γ = Limits.pullback.lift (⨆ l, Wh l).ι φ hWq := ⟨_, rfl⟩
  have hγfst : γ ≫ Limits.pullback.fst q pY = (⨆ l, Wh l).ι := by
    rw [hγ, Limits.pullback.lift_fst]
  have hγsnd : γ ≫ Limits.pullback.snd q pY = φ := by
    rw [hγ, Limits.pullback.lift_snd]
  have hDd : Dense ((⨆ l, Wh l).ι ⁻¹' ((q ⁻¹ᵁ U' : X.Opens) : Set X)) :=
    hqd.preimage (⨆ l, Wh l).ι.isOpenEmbedding.isOpenMap
  have hclosed : IsClosed (Set.range γ) := by
    rw [← closure_subset_iff_isClosed]
    intro z hz
    obtain ⟨l, hzl⟩ := hBcov (q (Limits.pullback.fst q pY z))
    obtain ⟨γl, hγl⟩ : ∃ γl, γl =
        Limits.pullback.lift (Wh l).ι (ψ l ≫ φ0 l ≫ (pY ⁻¹ᵁ Bc l).ι) (hl l) := ⟨_, rfl⟩
    have hr : X.homOfLE (le_iSup Wh l) ≫ γ = γl := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hγfst, hγl, Limits.pullback.lift_fst, Scheme.homOfLE_ι]
      · rw [Category.assoc, hγsnd, hγl, Limits.pullback.lift_snd, hφ l]
    have hpt : ∀ v, γl v = γ (X.homOfLE (le_iSup Wh l) v) := fun v => by
      rw [← hr]; rfl
    have hstep : (Limits.pullback.fst q pY ⁻¹' (q ⁻¹' (Bc l : Set B'))) ∩ Set.range γ ⊆
        closure (Set.range γl) := by
      rintro _ ⟨hw, ⟨w, rfl⟩⟩
      have e : (γ ≫ Limits.pullback.fst q pY) w = (⨆ l, Wh l).ι w := by rw [hγfst]
      have hwM : w ∈ (⨆ l, Wh l).ι ⁻¹' (q ⁻¹' (Bc l : Set B')) := by
        show q ((⨆ l, Wh l).ι w) ∈ (Bc l : Set B')
        rw [← e]; exact hw
      have hMo : IsOpen ((⨆ l, Wh l).ι ⁻¹' (q ⁻¹' (Bc l : Set B'))) :=
        ((Bc l).isOpen.preimage q.continuous).preimage (⨆ l, Wh l).ι.continuous
      have hwD : w ∈ closure ((⨆ l, Wh l).ι ⁻¹' ((q ⁻¹ᵁ U' : X.Opens) : Set X)) := by
        rw [hDd.closure_eq]; exact Set.mem_univ w
      have hw1 := hMo.inter_closure ⟨hwM, hwD⟩
      refine map_mem_closure γ.continuous hw1 ?_
      rintro v ⟨hvM, hvD⟩
      obtain ⟨v', hv'⟩ : (⨆ l, Wh l).ι v ∈ Set.range (Wh l).ι := by
        rw [Scheme.Opens.range_ι]
        exact hcov l ⟨hvD, hvM⟩
      refine ⟨v', ?_⟩
      rw [hpt]
      congr 1
      apply (⨆ l, Wh l).ι.isOpenEmbedding.injective
      rw [← hv']
      show (X.homOfLE (le_iSup Wh l) ≫ (⨆ l, Wh l).ι) v' = _
      rw [Scheme.homOfLE_ι]
    have hQo : IsOpen (Limits.pullback.fst q pY ⁻¹' (q ⁻¹' (Bc l : Set B'))) :=
      ((Bc l).isOpen.preimage q.continuous).preimage (Limits.pullback.fst q pY).continuous
    have hzcl : z ∈ closure (Set.range γl) :=
      closure_minimal hstep isClosed_closure (hQo.inter_closure ⟨hzl, hz⟩)
    rw [hγl] at hzcl
    have hz' := wc_csd_case2_local_graph B' (Bc l) Y pY (X0 l) (q0 l) (W0 l) (φ0 l) (h0 l)
      (Xl l) (ql l) (κ l) X q (ρ l) (Wh l) (ψ l) (hl l) (hcl0 l) (hκq l) (hκr l) (hρ l) (hWh l)
      (hψ l) z hzcl hzl
    rw [← hγl] at hz'
    obtain ⟨w', rfl⟩ := hz'
    exact ⟨_, (hpt w').symm⟩
  haveI : IsImmersion (γ ≫ Limits.pullback.fst q pY) := by rw [hγfst]; infer_instance
  haveI : IsImmersion γ := IsImmersion.of_comp γ (Limits.pullback.fst q pY)
  have hγcl : IsClosedImmersion γ := IsClosedImmersion.of_isPreimmersion γ hclosed

  haveI : IsIso (q ∣_ U') := (htowiso htow).1 U' le_rfl
  refine ⟨X, q, ⨆ l, Wh l, φ, inv (q ∣_ U') ≫ X.homOfLE hS₀W, htow, ⟨hWq, ?_⟩, ?_, ?_⟩
  · rw [← hγ]; exact hγcl
  · rw [Category.assoc, Scheme.homOfLE_ι_assoc, ← morphismRestrict_ι, IsIso.inv_hom_id_assoc]
  · rw [Category.assoc, hS₀φ, IsIso.inv_hom_id_assoc]

theorem wc_csd_piece_quasi_domination : ∀ (K : Type u) [Field K] (n : ℕ) (B : Scheme.{u}) (jB : B ⟶ wcProjK K n) (U : Scheme.{u}) (ι : U ⟶ B) [IsOpenImmersion ι] (Z : Scheme.{u}) (p : Z ⟶ B) [IsProper p] (s : U ⟶ Z) (Zi : Z.Opens), IsClosedImmersion jB → Dense (Set.range ι) → IsAffineOpen Zi → s ≫ p = ι → ∃ (X : Scheme.{u}) (q : X ⟶ B) (W : X.Opens) (φ : W.toScheme ⟶ Zi.toScheme) (e : (s ⁻¹ᵁ Zi).toScheme ⟶ W.toScheme), wcCsdAdmTower B ι.opensRange X q ∧ (∃ h : W.ι ≫ q = φ ≫ Zi.ι ≫ p, IsClosedImmersion (Limits.pullback.lift W.ι φ h)) ∧ e ≫ W.ι ≫ q = (s ⁻¹ᵁ Zi).ι ≫ ι ∧ e ≫ φ ≫ Zi.ι = (s ⁻¹ᵁ Zi).ι ≫ s :=
by
  classical
  intro K _ n B jB U ι _ Z p _ s Zi hjB hιd hZi hsp

  have htowiso : ∀ {B' : Scheme.{u}} {V' : B'.Opens} {Y : Scheme.{u}} {t : Y ⟶ B'},
      wcCsdAdmTower B' V' Y t → (∀ V'' : B'.Opens, V'' ≤ V' → IsIso (t ∣_ V'')) ∧
        (Dense (V' : Set B') → Dense ((t ⁻¹ᵁ V' : Y.Opens) : Set Y)) := by
    intro B' V' Y t h
    induction h with
    | base => exact ⟨fun V'' _ => inferInstance, fun hd => hd⟩
    | @step X0 X1 q I r _ hI hb ih =>
      refine ⟨fun V'' hV'' => ?_, fun hd => ?_⟩
      · have h1 : IsIso (r ∣_ (q ⁻¹ᵁ V'')) := by
          apply wc_csd_blowup_iso_off_center X0 X1 I r (q ⁻¹ᵁ V'') hb
          apply Set.eq_empty_of_subset_empty
          rintro x ⟨hx1, hx2⟩
          have hmem : x ∈ (I.support : Set X0) ∩ ((q ⁻¹ᵁ V' : X0.Opens) : Set X0) :=
            ⟨hx1, hV'' hx2⟩
          rw [hI] at hmem
          exact hmem
        haveI := ih.1 V'' hV''
        rw [morphismRestrict_comp]
        exact IsIso.comp_isIso' h1 ‹_›
      · obtain ⟨W0, hW0⟩ : ∃ W0 : X0.Opens, (W0 : Set X0) = (I.support : Set X0)ᶜ :=
          ⟨⟨(I.support : Set X0)ᶜ, I.support.isClosed.isOpen_compl⟩, rfl⟩
        have hiso0 : IsIso (r ∣_ W0) :=
          wc_csd_blowup_iso_off_center X0 X1 I r W0 hb (by rw [hW0]; exact Set.inter_compl_self _)
        have hd0 := (wc_csd_invpull_compl_schem_dense X0 X1 I r W0 hb.1 hW0).2
        have hle : q ⁻¹ᵁ V' ≤ W0 := by
          intro x hx
          show x ∈ (W0 : Set X0)
          rw [hW0]
          intro hs
          have hmem : x ∈ (I.support : Set X0) ∩ ((q ⁻¹ᵁ V' : X0.Opens) : Set X0) := ⟨hs, hx⟩
          rw [hI] at hmem
          exact hmem
        exact wc_csd_dense_preimage_transfer X0 X1 r W0 (q ⁻¹ᵁ V') hle (ih.2 hd) hiso0 hd0

  haveI := hjB
  haveI := wc_proj_space_isProper K n
  haveI hprojB : IsProper (jB ≫ wcProjKStr K n) := inferInstance
  haveI hBn : AlgebraicGeometry.IsNoetherian B := by
    haveI : IsLocallyNoetherian B := LocallyOfFiniteType.isLocallyNoetherian (jB ≫ wcProjKStr K n)
    haveI : CompactSpace B := QuasiCompact.compactSpace_of_compactSpace (jB ≫ wcProjKStr K n)
    exact { toIsLocallyNoetherian := ‹_›, toCompactSpace := ‹_› }
  have hmemV : ∀ u : U, ι u ∈ ι.opensRange := fun u => by
    rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]; exact Set.mem_range_self u
  have hVd : Dense (ι.opensRange : Set B) := by rw [Scheme.Hom.coe_opensRange]; exact hιd
  obtain ⟨pY, hpY⟩ : ∃ pY : Zi.toScheme ⟶ B, pY = Zi.ι ≫ p := ⟨_, rfl⟩
  haveI : IsAffine Zi.toScheme := hZi
  haveI hpYaff : IsAffineHom pY := by
    haveI : IsAffineHom (pY ≫ jB ≫ wcProjKStr K n) := isAffineHom_of_isAffine _
    exact IsAffineHom.of_comp pY (jB ≫ wcProjKStr K n)
  haveI hpYlft : LocallyOfFiniteType pY := by rw [hpY]; infer_instance

  obtain ⟨U₀, ε₀, hε₀, hU₀V⟩ : ∃ (U₀ : B.Opens) (ε₀ : (s ⁻¹ᵁ Zi).toScheme ≅ U₀.toScheme),
      ε₀.hom ≫ U₀.ι = (s ⁻¹ᵁ Zi).ι ≫ ι ∧ U₀ ≤ ι.opensRange :=
    ⟨ι ''ᵁ (s ⁻¹ᵁ Zi), ι.isoImage (s ⁻¹ᵁ Zi), ι.isoImage_hom_ι (s ⁻¹ᵁ Zi), by
      rintro _ ⟨y, -, rfl⟩
      exact hmemV y⟩
  obtain ⟨f, hfε⟩ : ∃ f : U₀.toScheme ⟶ Zi.toScheme, ε₀.hom ≫ f = s ∣_ Zi :=
    ⟨ε₀.inv ≫ (s ∣_ Zi), Iso.hom_inv_id_assoc _ _⟩
  have hfZ : ε₀.hom ≫ f ≫ Zi.ι = (s ⁻¹ᵁ Zi).ι ≫ s := by
    rw [reassoc_of% hfε, morphismRestrict_ι]
  have hfZ' : f ≫ Zi.ι = ε₀.inv ≫ (s ⁻¹ᵁ Zi).ι ≫ s := by
    rw [← hfZ, Iso.inv_hom_id_assoc]
  have hf : f ≫ pY = U₀.ι := by
    rw [← cancel_epi ε₀.hom, hpY, reassoc_of% hfZ, hsp, hε₀]

  obtain ⟨σ, hσ⟩ : ∃ σ : U ⟶ (p ⁻¹ᵁ ι.opensRange).toScheme, σ ≫ (p ⁻¹ᵁ ι.opensRange).ι = s := by
    refine ⟨IsOpenImmersion.lift _ s ?_, IsOpenImmersion.lift_fac _ _ _⟩
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨u, rfl⟩
    show (s ≫ p) u ∈ ι.opensRange
    rw [hsp]
    exact hmemV u
  have hinvι : ι.isoOpensRange.inv ≫ ι = ι.opensRange.ι := by
    rw [Iso.inv_comp_eq, Scheme.Hom.isoOpensRange_hom_ι]
  have hσπ : σ ≫ (p ∣_ ι.opensRange) ≫ ι.isoOpensRange.inv = 𝟙 U := by
    rw [← cancel_mono ι, Category.id_comp, Category.assoc, Category.assoc, hinvι,
      morphismRestrict_ι, reassoc_of% hσ, hsp]
  haveI : IsClosedImmersion (σ ≫ (p ∣_ ι.opensRange) ≫ ι.isoOpensRange.inv) := by
    rw [hσπ]; infer_instance
  haveI : IsClosedImmersion σ :=
    IsClosedImmersion.of_comp σ ((p ∣_ ι.opensRange) ≫ ι.isoOpensRange.inv)
  have hσcl : IsClosed (Set.range σ) := σ.isClosedEmbedding.isClosed_range
  have hcl : ∀ y ∈ closure (Set.range f), pY y ∈ ι.opensRange → y ∈ Set.range f := by
    intro y hy hyV
    have hz : Zi.ι y ∈ closure (Set.range s) := by
      refine map_mem_closure Zi.ι.continuous hy ?_
      rintro _ ⟨x, rfl⟩
      refine ⟨(s ⁻¹ᵁ Zi).ι (ε₀.inv x), ?_⟩
      show (ε₀.inv ≫ (s ⁻¹ᵁ Zi).ι ≫ s) x = (f ≫ Zi.ι) x
      rw [hfZ']
    have hzP : Zi.ι y ∈ Set.range (p ⁻¹ᵁ ι.opensRange).ι := by
      rw [Scheme.Opens.range_ι]
      show p (Zi.ι y) ∈ ι.opensRange
      have e : pY y = p (Zi.ι y) := by rw [hpY]; rfl
      rw [← e]; exact hyV
    obtain ⟨w, hw⟩ := hzP
    have hwcl : w ∈ closure (Set.range σ) := by
      rw [(p ⁻¹ᵁ ι.opensRange).ι.isOpenEmbedding.isInducing.closure_eq_preimage_closure_image]
      show (p ⁻¹ᵁ ι.opensRange).ι w ∈ closure ((p ⁻¹ᵁ ι.opensRange).ι '' Set.range σ)
      rw [hw]
      refine closure_mono ?_ hz
      rintro _ ⟨u, rfl⟩
      exact ⟨σ u, ⟨u, rfl⟩, by show (σ ≫ (p ⁻¹ᵁ ι.opensRange).ι) u = s u; rw [hσ]⟩
    rw [hσcl.closure_eq] at hwcl
    obtain ⟨u, rfl⟩ := hwcl
    have hsu : s u = Zi.ι y := by
      rw [← hw]; show s u = (σ ≫ (p ⁻¹ᵁ ι.opensRange).ι) u; rw [hσ]
    obtain ⟨u', hu'⟩ : u ∈ Set.range (s ⁻¹ᵁ Zi).ι := by
      rw [Scheme.Opens.range_ι]
      show s u ∈ Zi
      rw [hsu]; exact y.2
    refine ⟨ε₀.hom u', ?_⟩
    apply Subtype.ext
    show Zi.ι (f (ε₀.hom u')) = Zi.ι y
    rw [← hsu, ← hu']
    show (ε₀.hom ≫ f ≫ Zi.ι) u' = ((s ⁻¹ᵁ Zi).ι ≫ s) u'
    rw [hfZ]

  obtain ⟨X₁, q₁, h₁, htow₁, hX₁n, hsep⟩ :=
    wc_csd_pqd_separation B ι.opensRange U₀ Zi.toScheme pY f hU₀V hf hcl
  haveI := hX₁n

  have trans : ∀ {Y : Scheme.{u}} {t : Y ⟶ X₁},
      wcCsdAdmTower X₁ (q₁ ⁻¹ᵁ ι.opensRange) Y t → wcCsdAdmTower B ι.opensRange Y (t ≫ q₁) := by
    intro Y t h
    induction h with
    | base => rw [Category.id_comp]; exact htow₁
    | step q I r' _ hI hb ih =>
      rw [Category.assoc]
      exact wcCsdAdmTower.step _ I r' ih hI hb
  obtain ⟨F₁, hF₁⟩ : ∃ F₁, F₁ = Limits.pullback.lift (q₁ ⁻¹ᵁ U₀).ι ((q₁ ∣_ U₀) ≫ f) h₁ :=
    ⟨_, rfl⟩
  rw [← hF₁] at hsep
  have hF₁fst : F₁ ≫ Limits.pullback.fst q₁ pY = (q₁ ⁻¹ᵁ U₀).ι := by
    rw [hF₁, Limits.pullback.lift_fst]
  have hF₁snd : F₁ ≫ Limits.pullback.snd q₁ pY = (q₁ ∣_ U₀) ≫ f := by
    rw [hF₁, Limits.pullback.lift_snd]

  obtain ⟨O, hO⟩ : ∃ O : X₁.Opens, (O : Set X₁) = (closure
      (((q₁ ⁻¹ᵁ ι.opensRange : X₁.Opens) : Set X₁) \ ((q₁ ⁻¹ᵁ U₀ : X₁.Opens) : Set X₁)))ᶜ :=
    ⟨⟨_, isClosed_closure.isOpen_compl⟩, rfl⟩
  have hO1 : q₁ ⁻¹ᵁ U₀ ≤ O := by
    intro x hx
    show x ∈ (O : Set X₁)
    rw [hO]
    intro hcx
    obtain ⟨y, hy1, hy2⟩ := mem_closure_iff.mp hcx _ (q₁ ⁻¹ᵁ U₀).isOpen hx
    exact hy2.2 hy1
  have hO2 : ∀ x : X₁, x ∈ O → x ∈ q₁ ⁻¹ᵁ ι.opensRange → x ∈ q₁ ⁻¹ᵁ U₀ := by
    intro x hxO hxV
    by_contra hxU
    have hxO' : x ∈ (O : Set X₁) := hxO
    rw [hO] at hxO'
    exact hxO' (subset_closure ⟨hxV, hxU⟩)
  have hmemO : ∀ y : O.toScheme, O.ι y ∈ O := by
    intro y
    have h : O.ι y ∈ Set.range O.ι := ⟨y, rfl⟩
    rwa [Scheme.Opens.range_ι] at h
  set U' : O.toScheme.Opens := O.ι ⁻¹ᵁ (q₁ ⁻¹ᵁ ι.opensRange) with hU'
  have hmemU'' : ∀ x : U'.toScheme, U'.ι x ∈ U' := by
    intro x
    have h : U'.ι x ∈ Set.range U'.ι := ⟨x, rfl⟩
    rwa [Scheme.Opens.range_ι] at h
  have hmemU' : ∀ x : U'.toScheme, O.ι (U'.ι x) ∈ q₁ ⁻¹ᵁ ι.opensRange := fun x => hmemU'' x
  haveI hOn : AlgebraicGeometry.IsNoetherian O.toScheme := by
    haveI : IsLocallyNoetherian O.toScheme := isLocallyNoetherian_of_isOpenImmersion O.ι
    haveI : CompactSpace O.toScheme :=
      isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (O : Set X₁))
    exact { toIsLocallyNoetherian := ‹_›, toCompactSpace := ‹_› }
  have hq1d : Dense ((q₁ ⁻¹ᵁ ι.opensRange : X₁.Opens) : Set X₁) := (htowiso htow₁).2 hVd
  have hU'd : Dense (U' : Set O.toScheme) := hq1d.preimage O.ι.isOpenEmbedding.isOpenMap

  haveI hfstaff : IsAffineHom (Limits.pullback.fst q₁ pY) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback q₁ pY).flip ‹_›
  haveI hfstlft : LocallyOfFiniteType (Limits.pullback.fst q₁ pY) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
      (IsPullback.of_hasPullback q₁ pY).flip ‹_›
  haveI hpY0aff : IsAffineHom (Limits.pullback.fst q₁ pY ∣_ O) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (isPullback_morphismRestrict (Limits.pullback.fst q₁ pY) O).flip ‹_›
  haveI hpY0lft : LocallyOfFiniteType (Limits.pullback.fst q₁ pY ∣_ O) := inferInstance

  have hrc : Set.range (U'.ι ≫ O.ι) ⊆ Set.range (q₁ ⁻¹ᵁ U₀).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    exact hO2 _ (hmemO _) (hmemU' x)
  obtain ⟨c'', hc''⟩ : ∃ c'' : U'.toScheme ⟶ (q₁ ⁻¹ᵁ U₀).toScheme,
      c'' ≫ (q₁ ⁻¹ᵁ U₀).ι = U'.ι ≫ O.ι := ⟨_, IsOpenImmersion.lift_fac _ _ hrc⟩
  have hcF : c'' ≫ F₁ ≫ Limits.pullback.fst q₁ pY = U'.ι ≫ O.ι := by rw [hF₁fst, hc'']
  have hrf : Set.range (c'' ≫ F₁) ⊆ Set.range (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    show (c'' ≫ F₁ ≫ Limits.pullback.fst q₁ pY) x ∈ O
    rw [hcF]
    exact hmemO _
  obtain ⟨f', hf'Y⟩ : ∃ f' : U'.toScheme ⟶ (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).toScheme,
      f' ≫ (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι = c'' ≫ F₁ :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hrf⟩
  have hf' : f' ≫ (Limits.pullback.fst q₁ pY ∣_ O) = U'.ι := by
    rw [← cancel_mono O.ι, Category.assoc, morphismRestrict_ι, reassoc_of% hf'Y, hcF]

  obtain ⟨X0, q0, W, φ0, e0, htow0, ⟨h0, hgr0⟩, he01, he02⟩ :=
    wc_csd_pqd_case2 O.toScheme U' (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).toScheme
      (Limits.pullback.fst q₁ pY ∣_ O) f' hU'd hf'

  obtain ⟨X₂, q₂, κ, htow₂, hκ, hκq, hκr⟩ :=
    wc_csd_tower_extend X₁ O (q₁ ⁻¹ᵁ ι.opensRange) X0 q0 htow0
  haveI := hκ

  haveI hisoU₀ : IsIso (q₁ ∣_ U₀) := (htowiso htow₁).1 U₀ hU₀V
  obtain ⟨g₀, hg₀⟩ : ∃ g₀ : (s ⁻¹ᵁ Zi).toScheme ⟶ (q₁ ⁻¹ᵁ U₀).toScheme,
      g₀ ≫ (q₁ ∣_ U₀) = ε₀.hom :=
    ⟨ε₀.hom ≫ inv (q₁ ∣_ U₀), by rw [Category.assoc, IsIso.inv_hom_id, Category.comp_id]⟩
  have hra : Set.range (g₀ ≫ (q₁ ⁻¹ᵁ U₀).ι) ⊆ Set.range (U'.ι ≫ O.ι) := by
    rintro _ ⟨x, rfl⟩
    have hw : (g₀ ≫ (q₁ ⁻¹ᵁ U₀).ι) x ∈ q₁ ⁻¹ᵁ U₀ := by
      have h : (q₁ ⁻¹ᵁ U₀).ι (g₀ x) ∈ Set.range (q₁ ⁻¹ᵁ U₀).ι := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι] at h
      exact h
    obtain ⟨o, ho⟩ : (g₀ ≫ (q₁ ⁻¹ᵁ U₀).ι) x ∈ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]; exact hO1 hw
    obtain ⟨o', ho'⟩ : o ∈ Set.range U'.ι := by
      rw [Scheme.Opens.range_ι]
      show O.ι o ∈ q₁ ⁻¹ᵁ ι.opensRange
      rw [ho]
      exact hU₀V hw
    exact ⟨o', by rw [← ho, ← ho']; rfl⟩
  obtain ⟨a, ha⟩ : ∃ a : (s ⁻¹ᵁ Zi).toScheme ⟶ U'.toScheme,
      a ≫ U'.ι ≫ O.ι = g₀ ≫ (q₁ ⁻¹ᵁ U₀).ι :=
    ⟨IsOpenImmersion.lift (U'.ι ≫ O.ι) _ hra, IsOpenImmersion.lift_fac _ _ _⟩
  have hac : a ≫ c'' = g₀ := by
    rw [← cancel_mono (q₁ ⁻¹ᵁ U₀).ι, Category.assoc, hc'', ha]
  have haq : a ≫ U'.ι ≫ O.ι ≫ q₁ = (s ⁻¹ᵁ Zi).ι ≫ ι := by
    rw [← Category.assoc U'.ι, ← Category.assoc a, ha, Category.assoc, ← morphismRestrict_ι,
      ← Category.assoc, hg₀, hε₀]
  obtain ⟨Wf, ε, hε⟩ : ∃ (Wf : X₂.Opens) (ε : W.toScheme ≅ Wf.toScheme),
      ε.hom ≫ Wf.ι = W.ι ≫ κ :=
    ⟨κ ''ᵁ W, κ.isoImage W, κ.isoImage_hom_ι W⟩
  have h' : (W.ι ≫ κ) ≫ q₂ ≫ q₁ = (φ0 ≫ (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι ≫
      Limits.pullback.snd q₁ pY) ≫ pY := by
    simp only [Category.assoc]
    rw [reassoc_of% hκq, reassoc_of% h0,
      reassoc_of% (morphismRestrict_ι (Limits.pullback.fst q₁ pY) O), Limits.pullback.condition]
  have hW : Wf.ι ≫ q₂ ≫ q₁ = (ε.inv ≫ φ0 ≫ (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι ≫
      Limits.pullback.snd q₁ pY) ≫ pY := by
    rw [← cancel_epi ε.hom, reassoc_of% hε]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    simpa only [Category.assoc] using h'
  obtain ⟨γ', hγ'⟩ : ∃ γ', γ' = Limits.pullback.lift (W.ι ≫ κ)
      (φ0 ≫ (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι ≫ Limits.pullback.snd q₁ pY) h' := ⟨_, rfl⟩
  have hγ'fst : γ' ≫ Limits.pullback.fst (q₂ ≫ q₁) pY = W.ι ≫ κ := by
    rw [hγ', Limits.pullback.lift_fst]
  have hγ'snd : γ' ≫ Limits.pullback.snd (q₂ ≫ q₁) pY =
      φ0 ≫ (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι ≫ Limits.pullback.snd q₁ pY := by
    rw [hγ', Limits.pullback.lift_snd]
  have hγ : Limits.pullback.lift Wf.ι (ε.inv ≫ φ0 ≫ (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι ≫
      Limits.pullback.snd q₁ pY) hW = ε.inv ≫ γ' := by
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst, Category.assoc, hγ'fst, ← hε, Iso.inv_hom_id_assoc]
    · rw [Limits.pullback.lift_snd, Category.assoc, hγ'snd]

  haveI hiso0 : IsIso (q0 ∣_ U') := (htowiso htow0).1 U' le_rfl
  have hrt : Set.range (e0 ≫ W.ι) ⊆ Set.range (q0 ⁻¹ᵁ U').ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨u, rfl⟩
    show (e0 ≫ W.ι ≫ q0) u ∈ U'
    rw [he01]
    exact hmemU'' u
  obtain ⟨t, ht⟩ : ∃ t, t ≫ (q0 ⁻¹ᵁ U').ι = e0 ≫ W.ι := ⟨_, IsOpenImmersion.lift_fac _ _ hrt⟩
  have ht1 : t ≫ (q0 ∣_ U') = 𝟙 _ := by
    rw [← cancel_mono U'.ι, Category.assoc, morphismRestrict_ι, reassoc_of% ht, he01,
      Category.id_comp]
  have ht2 : t = inv (q0 ∣_ U') := by
    rw [← Category.comp_id t, ← IsIso.hom_inv_id (q0 ∣_ U'), ← Category.assoc, ht1,
      Category.id_comp]
  have hsub : W.ι ⁻¹' ((q0 ⁻¹ᵁ U' : X0.Opens) : Set X0) ⊆ Set.range e0 := by
    intro x hx
    obtain ⟨v, hv⟩ : W.ι x ∈ Set.range (q0 ⁻¹ᵁ U').ι := by
      rw [Scheme.Opens.range_ι]; exact hx
    refine ⟨(q0 ∣_ U') v, ?_⟩
    apply Subtype.ext
    show W.ι (e0 ((q0 ∣_ U') v)) = W.ι x
    rw [← hv]
    show ((q0 ∣_ U') ≫ e0 ≫ W.ι) v = (q0 ⁻¹ᵁ U').ι v
    rw [← ht, ht2, IsIso.hom_inv_id_assoc]
  have hrdense : Dense (Set.range e0) :=
    (((htowiso htow0).2 hU'd).preimage W.ι.isOpenEmbedding.isOpenMap).mono hsub
  obtain ⟨ρ, hρfst, hρsnd⟩ : ∃ ρ : Limits.pullback (q₂ ≫ q₁) pY ⟶ Limits.pullback q₁ pY,
      ρ ≫ Limits.pullback.fst q₁ pY = Limits.pullback.fst (q₂ ≫ q₁) pY ≫ q₂ ∧
      ρ ≫ Limits.pullback.snd q₁ pY = Limits.pullback.snd (q₂ ≫ q₁) pY :=
    ⟨Limits.pullback.lift (Limits.pullback.fst _ _ ≫ q₂) (Limits.pullback.snd _ _)
      (by rw [Category.assoc, Limits.pullback.condition]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hkey : e0 ≫ γ' ≫ ρ = c'' ≫ F₁ := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc]
      rw [hρfst, reassoc_of% hγ'fst, hκq, reassoc_of% he01, hcF]
    · simp only [Category.assoc]
      rw [hρsnd, hγ'snd, reassoc_of% he02, reassoc_of% hf'Y]
  have hstep1 : ∀ w : W.toScheme, (γ' ≫ ρ) w ∈ closure (Set.range F₁) := by
    intro w
    refine map_mem_closure (γ' ≫ ρ).continuous (hrdense w) ?_
    rintro _ ⟨u, rfl⟩
    refine ⟨c'' u, ?_⟩
    show (c'' ≫ F₁) u = (e0 ≫ γ' ≫ ρ) u
    rw [hkey]
  have hCl : ∀ z ∈ closure (Set.range γ'), Limits.pullback.fst (q₂ ≫ q₁) pY z ∈ Set.range κ := by
    intro z hz
    have h2 : ρ z ∈ closure (Set.range F₁) := by
      have h3 := map_mem_closure ρ.continuous hz (t := closure (Set.range F₁))
        (by rintro _ ⟨w, rfl⟩; exact hstep1 w)
      rwa [closure_closure] at h3
    have h1 := hsep (ρ z) h2
    rw [hκr]
    have e : Limits.pullback.fst q₁ pY (ρ z) = q₂ (Limits.pullback.fst (q₂ ≫ q₁) pY z) := by
      show (ρ ≫ Limits.pullback.fst q₁ pY) z = (Limits.pullback.fst (q₂ ≫ q₁) pY ≫ q₂) z
      rw [hρfst]
    have h4 : q₂ (Limits.pullback.fst (q₂ ≫ q₁) pY z) ∈ (O : Set X₁) := by
      rw [hO, ← e]; exact h1
    exact h4

  obtain ⟨m, hmfst, hmsnd⟩ : ∃ m : Limits.pullback q0 (Limits.pullback.fst q₁ pY ∣_ O) ⟶
      Limits.pullback (q₂ ≫ q₁) pY,
      m ≫ Limits.pullback.fst (q₂ ≫ q₁) pY = Limits.pullback.fst _ _ ≫ κ ∧
      m ≫ Limits.pullback.snd (q₂ ≫ q₁) pY = Limits.pullback.snd _ _ ≫
        (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι ≫ Limits.pullback.snd q₁ pY := by
    refine ⟨Limits.pullback.lift (Limits.pullback.fst _ _ ≫ κ) (Limits.pullback.snd _ _ ≫
        (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι ≫ Limits.pullback.snd q₁ pY) ?_,
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    simp only [Category.assoc]
    rw [reassoc_of% hκq, Limits.pullback.condition_assoc, ← Limits.pullback.condition,
      reassoc_of% (morphismRestrict_ι (Limits.pullback.fst q₁ pY) O)]
  have hA := (IsPullback.of_hasPullback q0 (Limits.pullback.fst q₁ pY ∣_ O)).flip
  have hB := (isPullback_morphismRestrict (Limits.pullback.fst q₁ pY) O).flip
  have hC := (IsPullback.of_hasPullback q₁ pY).flip
  have houter : IsPullback (m ≫ Limits.pullback.snd (q₂ ≫ q₁) pY)
      (Limits.pullback.fst q0 (Limits.pullback.fst q₁ pY ∣_ O)) pY (κ ≫ q₂ ≫ q₁) := by
    rw [hmsnd, reassoc_of% hκq]
    simpa only [Category.assoc] using (hA.paste_horiz hB).paste_horiz hC
  have hbot : IsPullback m (Limits.pullback.fst q0 (Limits.pullback.fst q₁ pY ∣_ O))
      (Limits.pullback.fst (q₂ ≫ q₁) pY) κ :=
    IsPullback.of_right houter hmfst (IsPullback.of_hasPullback (q₂ ≫ q₁) pY).flip
  haveI hmopen : IsOpenImmersion m :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hbot.flip ‹_›
  have hmrange : ∀ z, Limits.pullback.fst (q₂ ≫ q₁) pY z ∈ Set.range κ → z ∈ Set.range m := by
    intro z hz
    have hz' : z ∈ Set.range (Limits.pullback.fst (Limits.pullback.fst (q₂ ≫ q₁) pY) κ) := by
      rw [Scheme.Pullback.range_fst]; exact hz
    obtain ⟨w, hw⟩ := hz'
    refine ⟨hbot.isoPullback.inv w, ?_⟩
    rw [← hw]
    show (hbot.isoPullback.inv ≫ m) w = _
    rw [IsPullback.isoPullback_inv_fst]
  obtain ⟨γ0, hγ0⟩ : ∃ γ0, γ0 = Limits.pullback.lift W.ι φ0 h0 := ⟨_, rfl⟩
  rw [← hγ0] at hgr0
  haveI := hgr0
  have hγfac : γ' = γ0 ≫ m := by
    apply Limits.pullback.hom_ext
    · rw [hγ'fst, Category.assoc, hmfst, hγ0, Limits.pullback.lift_fst_assoc]
    · rw [hγ'snd, Category.assoc, hmsnd, hγ0, Limits.pullback.lift_snd_assoc]
  have hpt : ∀ w, γ' w = m (γ0 w) := fun w => by
    rw [hγfac]; rfl
  haveI hγ'cl : IsClosedImmersion γ' := by
    haveI : IsPreimmersion γ' := by rw [hγfac]; infer_instance
    apply IsClosedImmersion.of_isPreimmersion
    rw [← closure_subset_iff_isClosed]
    intro z hz
    obtain ⟨r, rfl⟩ := hmrange z (hCl z hz)
    have himg : m '' Set.range γ0 = Set.range γ' := by
      ext x
      constructor
      · rintro ⟨_, ⟨w, rfl⟩, rfl⟩
        exact ⟨w, hpt w⟩
      · rintro ⟨w, rfl⟩
        exact ⟨γ0 w, ⟨w, rfl⟩, (hpt w).symm⟩
    have hr : r ∈ closure (Set.range γ0) := by
      rw [m.isOpenEmbedding.isInducing.closure_eq_preimage_closure_image, himg]
      exact hz
    rw [γ0.isClosedEmbedding.isClosed_range.closure_eq] at hr
    obtain ⟨w, rfl⟩ := hr
    exact ⟨w, hpt w⟩
  have hei : (a ≫ e0 ≫ ε.hom) ≫ Wf.ι ≫ q₂ ≫ q₁ = (s ⁻¹ᵁ Zi).ι ≫ ι := by
    simp only [Category.assoc]
    rw [reassoc_of% hε, reassoc_of% hκq, reassoc_of% he01, haq]
  have heii : (a ≫ e0 ≫ ε.hom) ≫ (ε.inv ≫ φ0 ≫ (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι ≫
      Limits.pullback.snd q₁ pY) ≫ Zi.ι = (s ⁻¹ᵁ Zi).ι ≫ s := by
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [reassoc_of% he02, reassoc_of% hf'Y, reassoc_of% hF₁snd, reassoc_of% hac,
      reassoc_of% hg₀, hfZ]
  have hgraph : IsClosedImmersion (Limits.pullback.lift Wf.ι (ε.inv ≫ φ0 ≫
      (Limits.pullback.fst q₁ pY ⁻¹ᵁ O).ι ≫ Limits.pullback.snd q₁ pY) hW) := by
    rw [hγ]; infer_instance
  subst hpY
  exact ⟨X₂, q₂ ≫ q₁, Wf, ε.inv ≫ φ0 ≫ (Limits.pullback.fst q₁ (Zi.ι ≫ p) ⁻¹ᵁ O).ι ≫
    Limits.pullback.snd q₁ (Zi.ι ≫ p), a ≫ e0 ≫ ε.hom, trans htow₂, ⟨hW, hgraph⟩, hei, heii⟩

theorem wc_csd_piecewise_quasi_domination : ∀ (K : Type u) [Field K] (n : ℕ) (B : Scheme.{u}) (jB : B ⟶ wcProjK K n) (U : Scheme.{u}) (ι : U ⟶ B) [IsOpenImmersion ι] (Z : Scheme.{u}) (p : Z ⟶ B) [IsProper p] (s : U ⟶ Z), IsClosedImmersion jB → Dense (Set.range ι) → s ≫ p = ι → ∃ (X₂ : Scheme.{u}) (q₂ : X₂ ⟶ B) (ι₂ : U ⟶ X₂) (k : ℕ) (Zc : Fin k → Z.Opens) (W : Fin k → X₂.Opens) (φ : ∀ i, (W i).toScheme ⟶ (Zc i).toScheme) (e : ∀ i, (s ⁻¹ᵁ Zc i).toScheme ⟶ (W i).toScheme), wcCsdAdmTower B ι.opensRange X₂ q₂ ∧ IsNoetherian X₂ ∧ IsOpenImmersion ι₂ ∧ QuasiCompact ι₂ ∧ Dense (Set.range ι₂) ∧ ι₂ ≫ q₂ = ι ∧ (∀ x : X₂, x ∈ Set.range ι₂ ↔ x ∈ q₂ ⁻¹ᵁ ι.opensRange) ∧ (⨆ i, Zc i) = ⊤ ∧ (∀ i, ∃ h : (W i).ι ≫ q₂ = φ i ≫ (Zc i).ι ≫ p, IsClosedImmersion (Limits.pullback.lift (W i).ι (φ i) h)) ∧ (∀ i, e i ≫ (W i).ι = (s ⁻¹ᵁ Zc i).ι ≫ ι₂) ∧ (∀ i, e i ≫ φ i ≫ (Zc i).ι = (s ⁻¹ᵁ Zc i).ι ≫ s) :=
by
  classical
  intro K _ n B jB U ι _ Z p _ s hjB hιd hsp

  have hnoeth : ∀ (Y : Scheme.{u}) (N : ℕ) (j : Y ⟶ wcProjK K N), IsClosedImmersion j →
      AlgebraicGeometry.IsNoetherian Y := by
    intro Y N j hj
    haveI := hj
    haveI := wc_proj_space_isProper K N
    haveI : IsProper (j ≫ wcProjKStr K N) := inferInstance
    haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian (j ≫ wcProjKStr K N)
    haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace (j ≫ wcProjKStr K N)
    exact { toIsLocallyNoetherian := ‹_›, toCompactSpace := ‹_› }
  haveI hBn : AlgebraicGeometry.IsNoetherian B := hnoeth B n jB hjB
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace p

  obtain ⟨k, Zc, hZcaff, hcov⟩ : ∃ (k : ℕ) (Zc : Fin k → Z.Opens),
      (∀ i, IsAffineOpen (Zc i)) ∧ (⨆ i, Zc i) = ⊤ := by
    have hA : ∀ z : Z, ∃ A : Z.Opens, IsAffineOpen A ∧ z ∈ A := fun z => by
      obtain ⟨A, hA, hzA, -⟩ := exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
      exact ⟨A, hA, hzA⟩
    choose A hAaff hzA using hA
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun z => (A z : Set Z))
      (fun z => (A z).isOpen) (fun z _ => Set.mem_iUnion.mpr ⟨z, hzA z⟩)
    refine ⟨t.card, fun i => A (t.equivFin.symm i), fun i => hAaff _, ?_⟩
    rw [eq_top_iff]
    intro x _
    have hx := ht (Set.mem_univ x)
    simp only [Set.mem_iUnion] at hx
    obtain ⟨z, hz, hxz⟩ := hx
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨t.equivFin ⟨z, hz⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hxz

  have hpiece := fun i : Fin k =>
    wc_csd_piece_quasi_domination K n B jB U ι Z p s (Zc i) hjB hιd (hZcaff i) hsp
  choose X q W' φ' e' htw hgr hc hd using hpiece
  obtain ⟨X₂, q₂, π, htow₂, hπ⟩ := wc_csd_tower_refine K n B jB ι.opensRange k X q hjB htw
  obtain ⟨N₂, j₂, hj₂, -⟩ := wc_csd_tower_projective K n B jB ι.opensRange X₂ q₂ hjB htow₂
  haveI hX₂ : AlgebraicGeometry.IsNoetherian X₂ := hnoeth X₂ N₂ j₂ hj₂

  have hUd : Dense (ι.opensRange : Set B) := by
    rw [Scheme.Hom.coe_opensRange]; exact hιd
  have htowiso : ∀ {Y : Scheme.{u}} {t : Y ⟶ B}, wcCsdAdmTower B ι.opensRange Y t →
      IsIso (t ∣_ ι.opensRange) ∧
        (Dense (ι.opensRange : Set B) → Dense ((t ⁻¹ᵁ ι.opensRange : Y.Opens) : Set Y)) := by
    intro Y t h
    induction h with
    | base => exact ⟨inferInstance, fun hd => hd⟩
    | @step X0 X1 q I r _ hI hb ih =>
      have h1 : IsIso (r ∣_ (q ⁻¹ᵁ ι.opensRange)) :=
        wc_csd_blowup_iso_off_center X0 X1 I r (q ⁻¹ᵁ ι.opensRange) hb hI
      refine ⟨?_, fun hd => ?_⟩
      · rw [morphismRestrict_comp]
        exact IsIso.comp_isIso' h1 ih.1
      · obtain ⟨W0, hW0⟩ : ∃ W0 : X0.Opens, (W0 : Set X0) = (I.support : Set X0)ᶜ :=
          ⟨⟨(I.support : Set X0)ᶜ, I.support.isClosed.isOpen_compl⟩, rfl⟩
        have hiso0 : IsIso (r ∣_ W0) :=
          wc_csd_blowup_iso_off_center X0 X1 I r W0 hb (by rw [hW0]; exact Set.inter_compl_self _)
        have hd0 := (wc_csd_invpull_compl_schem_dense X0 X1 I r W0 hb.1 hW0).2
        have hle : q ⁻¹ᵁ ι.opensRange ≤ W0 := by
          intro x hx
          show x ∈ (W0 : Set X0)
          rw [hW0]
          intro hs
          have hmem : x ∈ (I.support : Set X0) ∩ ((q ⁻¹ᵁ ι.opensRange : X0.Opens) : Set X0) :=
            ⟨hs, hx⟩
          rw [hI] at hmem
          exact hmem
        exact wc_csd_dense_preimage_transfer X0 X1 r W0 (q ⁻¹ᵁ ι.opensRange) hle (ih.2 hd)
          hiso0 hd0
  have huniq : ∀ {Y : Scheme.{u}} {t : Y ⟶ B}, wcCsdAdmTower B ι.opensRange Y t →
      ∀ {T : Scheme.{u}} (a b : T ⟶ Y), a ≫ t = b ≫ t → Set.range (a ≫ t) ⊆ Set.range ι →
        a = b := by
    intro Y t h T a b hab hr
    haveI := (htowiso h).1
    have ha : Set.range a ⊆ Set.range (t ⁻¹ᵁ ι.opensRange).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      exact hr ⟨x, rfl⟩
    have hb : Set.range b ⊆ Set.range (t ⁻¹ᵁ ι.opensRange).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      rw [hab] at hr
      exact hr ⟨x, rfl⟩
    obtain ⟨a', ha'⟩ : ∃ a', a' ≫ (t ⁻¹ᵁ ι.opensRange).ι = a := ⟨_, IsOpenImmersion.lift_fac _ _ ha⟩
    obtain ⟨b', hb'⟩ : ∃ b', b' ≫ (t ⁻¹ᵁ ι.opensRange).ι = b := ⟨_, IsOpenImmersion.lift_fac _ _ hb⟩
    have e1 : a' ≫ (t ∣_ ι.opensRange) = b' ≫ (t ∣_ ι.opensRange) := by
      rw [← cancel_mono ι.opensRange.ι, Category.assoc, Category.assoc, morphismRestrict_ι,
        ← Category.assoc, ← Category.assoc, ha', hb']
      exact hab
    have e2 : a' = b' := (cancel_mono _).mp e1
    rw [← ha', ← hb', e2]

  haveI hiso₂ : IsIso (q₂ ∣_ ι.opensRange) := (htowiso htow₂).1
  obtain ⟨φ0, hφ0iso, hφ0⟩ : ∃ φ0 : U ⟶ (q₂ ⁻¹ᵁ ι.opensRange).toScheme,
      IsIso φ0 ∧ φ0 ≫ (q₂ ∣_ ι.opensRange) = ι.isoOpensRange.hom :=
    ⟨ι.isoOpensRange.hom ≫ inv (q₂ ∣_ ι.opensRange), inferInstance,
      by rw [Category.assoc, IsIso.inv_hom_id, Category.comp_id]⟩
  haveI := hφ0iso
  obtain ⟨ι₂, hι₂⟩ : ∃ ι₂ : U ⟶ X₂, ι₂ = φ0 ≫ (q₂ ⁻¹ᵁ ι.opensRange).ι := ⟨_, rfl⟩
  haveI hι₂oi : IsOpenImmersion ι₂ := by rw [hι₂]; infer_instance
  have hι₂q : ι₂ ≫ q₂ = ι := by
    rw [hι₂, Category.assoc, ← morphismRestrict_ι, ← Category.assoc, hφ0,
      Scheme.Hom.isoOpensRange_hom_ι]
  have hrangeiff : ∀ x : X₂, x ∈ Set.range ι₂ ↔ x ∈ q₂ ⁻¹ᵁ ι.opensRange := by
    intro x
    constructor
    · rintro ⟨y, rfl⟩
      have hmem := Set.mem_range_self (f := (q₂ ⁻¹ᵁ ι.opensRange).ι) (φ0 y)
      rw [Scheme.Opens.range_ι] at hmem
      rw [hι₂]
      exact hmem
    · intro hx
      obtain ⟨w, hw⟩ : x ∈ Set.range (q₂ ⁻¹ᵁ ι.opensRange).ι := by
        rw [Scheme.Opens.range_ι]; exact hx
      refine ⟨(inv φ0) w, ?_⟩
      rw [hι₂, ← hw]
      show (q₂ ⁻¹ᵁ ι.opensRange).ι ((inv φ0 ≫ φ0) w) = (q₂ ⁻¹ᵁ ι.opensRange).ι w
      rw [IsIso.inv_hom_id]
      rfl
  have hdense : Dense (Set.range ι₂) := by
    have hset : Set.range ι₂ = ((q₂ ⁻¹ᵁ ι.opensRange : X₂.Opens) : Set X₂) := Set.ext hrangeiff
    rw [hset]
    exact (htowiso htow₂).2 hUd

  have hgraph : ∀ i, ∃ h : (π i ⁻¹ᵁ W' i).ι ≫ q₂ = ((π i ∣_ W' i) ≫ φ' i) ≫ (Zc i).ι ≫ p,
      IsClosedImmersion (Limits.pullback.lift (π i ⁻¹ᵁ W' i).ι ((π i ∣_ W' i) ≫ φ' i) h) := by
    intro i
    obtain ⟨h0, hcl⟩ := hgr i
    have h' : (π i ⁻¹ᵁ W' i).ι ≫ q₂ = ((π i ∣_ W' i) ≫ φ' i) ≫ (Zc i).ι ≫ p := by
      rw [← hπ i, ← Category.assoc, ← morphismRestrict_ι, Category.assoc, h0, Category.assoc]
    refine ⟨h', ?_⟩
    obtain ⟨m, hm1, hm2⟩ : ∃ m : Limits.pullback q₂ ((Zc i).ι ≫ p) ⟶
        Limits.pullback (q i) ((Zc i).ι ≫ p),
        m ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ π i ∧
        m ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ :=
      ⟨Limits.pullback.lift (Limits.pullback.fst _ _ ≫ π i) (Limits.pullback.snd _ _)
        (by rw [Category.assoc, hπ i, Limits.pullback.condition]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have houter : IsPullback (m ≫ Limits.pullback.snd (q i) ((Zc i).ι ≫ p))
        (Limits.pullback.fst q₂ ((Zc i).ι ≫ p)) ((Zc i).ι ≫ p) (π i ≫ q i) := by
      rw [hm2, hπ i]
      exact (IsPullback.of_hasPullback q₂ ((Zc i).ι ≫ p)).flip
    have hbot : IsPullback m (Limits.pullback.fst q₂ ((Zc i).ι ≫ p))
        (Limits.pullback.fst (q i) ((Zc i).ι ≫ p)) (π i) :=
      IsPullback.of_right houter hm1 (IsPullback.of_hasPullback (q i) ((Zc i).ι ≫ p)).flip
    have hrect : IsPullback (π i ∣_ W' i)
        (Limits.pullback.lift (π i ⁻¹ᵁ W' i).ι ((π i ∣_ W' i) ≫ φ' i) h' ≫
          Limits.pullback.fst q₂ ((Zc i).ι ≫ p))
        (Limits.pullback.lift (W' i).ι (φ' i) h0 ≫ Limits.pullback.fst (q i) ((Zc i).ι ≫ p))
        (π i) := by
      rw [Limits.pullback.lift_fst, Limits.pullback.lift_fst]
      exact isPullback_morphismRestrict (π i) (W' i)
    have hcomm : (π i ∣_ W' i) ≫ Limits.pullback.lift (W' i).ι (φ' i) h0 =
        Limits.pullback.lift (π i ⁻¹ᵁ W' i).ι ((π i ∣_ W' i) ≫ φ' i) h' ≫ m := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, hm1, Limits.pullback.lift_fst, ← Category.assoc,
          Limits.pullback.lift_fst, morphismRestrict_ι]
      · rw [Category.assoc, Category.assoc, hm2, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    have htop := IsPullback.of_bot hrect hcomm hbot
    exact MorphismProperty.of_isPullback (P := @IsClosedImmersion) htop hcl

  have hE : ∀ i, ∃ ee : (s ⁻¹ᵁ Zc i).toScheme ⟶ (π i ⁻¹ᵁ W' i).toScheme,
      ee ≫ (π i ⁻¹ᵁ W' i).ι = (s ⁻¹ᵁ Zc i).ι ≫ ι₂ ∧ ee ≫ (π i ∣_ W' i) = e' i := by
    intro i
    have hgπ : ((s ⁻¹ᵁ Zc i).ι ≫ ι₂) ≫ π i = e' i ≫ (W' i).ι := by
      apply huniq (htw i)
      · rw [Category.assoc, hπ i, Category.assoc, hι₂q, Category.assoc, hc i]
      · rw [Category.assoc, hπ i, Category.assoc, hι₂q]
        rintro _ ⟨x, rfl⟩
        exact ⟨_, rfl⟩
    have hrg : Set.range ((s ⁻¹ᵁ Zc i).ι ≫ ι₂) ⊆ Set.range (π i ⁻¹ᵁ W' i).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have hx : (((s ⁻¹ᵁ Zc i).ι ≫ ι₂) ≫ π i) x = (e' i ≫ (W' i).ι) x := by rw [hgπ]
      have hmem := Set.mem_range_self (f := (W' i).ι) (e' i x)
      rw [Scheme.Opens.range_ι] at hmem
      show (((s ⁻¹ᵁ Zc i).ι ≫ ι₂) ≫ π i) x ∈ W' i
      rw [hx]
      exact hmem
    obtain ⟨ee, hee⟩ : ∃ ee, ee ≫ (π i ⁻¹ᵁ W' i).ι = (s ⁻¹ᵁ Zc i).ι ≫ ι₂ :=
      ⟨_, IsOpenImmersion.lift_fac _ _ hrg⟩
    refine ⟨ee, hee, ?_⟩
    rw [← cancel_mono (W' i).ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hee, hgπ]
  choose E hE1 hE2 using hE
  refine ⟨X₂, q₂, ι₂, k, Zc, fun i => π i ⁻¹ᵁ W' i, fun i => (π i ∣_ W' i) ≫ φ' i, E, htow₂,
    hX₂, hι₂oi, inferInstance, hdense, hι₂q, hrangeiff, hcov, hgraph, hE1, ?_⟩
  intro i
  show E i ≫ ((π i ∣_ W' i) ≫ φ' i) ≫ (Zc i).ι = (s ⁻¹ᵁ Zc i).ι ≫ s
  rw [Category.assoc, ← Category.assoc (E i), hE2 i]
  exact hd i

theorem wc_csd_graph_closure_finite : ∀ (B X₂ : Scheme.{u}) (q₂ : X₂ ⟶ B) (U : Scheme.{u}) (ι₂ : U ⟶ X₂) [QuasiCompact ι₂] (Z : Scheme.{u}) (p : Z ⟶ B) [IsProper p] (s : U ⟶ Z) (k : ℕ) (Zc : Fin k → Z.Opens) (W : Fin k → X₂.Opens) (φ : ∀ i, (W i).toScheme ⟶ (Zc i).toScheme) (e : ∀ i, (s ⁻¹ᵁ Zc i).toScheme ⟶ (W i).toScheme), s ≫ p = ι₂ ≫ q₂ → (⨆ i, Zc i) = ⊤ → (∀ i, ∃ h : (W i).ι ≫ q₂ = φ i ≫ (Zc i).ι ≫ p, IsClosedImmersion (Limits.pullback.lift (W i).ι (φ i) h)) → (∀ i, e i ≫ (W i).ι = (s ⁻¹ᵁ Zc i).ι ≫ ι₂) → (∀ i, e i ≫ φ i ≫ (Zc i).ι = (s ⁻¹ᵁ Zc i).ι ≫ s) → ∃ (G : Scheme.{u}) (π : G ⟶ X₂) (σ : U ⟶ G) (g : G ⟶ Z), IsFinite π ∧ σ ≫ π = ι₂ ∧ σ ≫ g = s ∧ g ≫ p = π ≫ q₂ ∧ ∀ O : G.Opens, Function.Injective (σ.app O) :=
by
  intro B X₂ q₂ U ι₂ _ Z p _ s k Zc W φ e H0 hcov hgr he1 he2
  classical
  obtain ⟨F, hFfst, hFsnd⟩ : ∃ F : U ⟶ Limits.pullback q₂ p,
      F ≫ Limits.pullback.fst q₂ p = ι₂ ∧ F ≫ Limits.pullback.snd q₂ p = s :=
    ⟨Limits.pullback.lift ι₂ s H0.symm, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  haveI : QuasiCompact (F ≫ Limits.pullback.fst q₂ p) := by rw [hFfst]; infer_instance
  haveI : QuasiCompact F := QuasiCompact.of_comp F (Limits.pullback.fst q₂ p)

  have hrange : Set.range F.imageι = closure (Set.range F) := by
    show Set.range (Scheme.Hom.ker F).subschemeι = _
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.Hom.support_ker]

  have piece : ∀ i, ∃ O R : Set ↥(Limits.pullback q₂ p), IsOpen O ∧
      (∀ y, Limits.pullback.snd q₂ p y ∈ Zc i → y ∈ O) ∧ closure R ∩ O ⊆ R ∧
      Set.range F ∩ O ⊆ R ∧ ∀ x, (R ∩ Limits.pullback.fst q₂ p ⁻¹' {x}).Subsingleton := by
    intro i
    obtain ⟨h, hci⟩ := hgr i
    obtain ⟨γ, hγc, hγfst, hγsnd⟩ : ∃ γ : (W i).toScheme ⟶ Limits.pullback q₂ ((Zc i).ι ≫ p),
        IsClosedImmersion γ ∧ γ ≫ Limits.pullback.fst _ _ = (W i).ι ∧
          γ ≫ Limits.pullback.snd _ _ = φ i :=
      ⟨_, hci, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨m, hmo, hmfst, hmsnd, hmr⟩ : ∃ m : Limits.pullback q₂ ((Zc i).ι ≫ p) ⟶
        Limits.pullback q₂ p,
        IsOpenImmersion m ∧ m ≫ Limits.pullback.fst q₂ p = Limits.pullback.fst q₂ ((Zc i).ι ≫ p) ∧
        m ≫ Limits.pullback.snd q₂ p = Limits.pullback.snd q₂ ((Zc i).ι ≫ p) ≫ (Zc i).ι ∧
        Set.range m = Limits.pullback.snd q₂ p ⁻¹' (Zc i : Set Z) := by
      refine ⟨Limits.pullback.map q₂ ((Zc i).ι ≫ p) q₂ p (𝟙 X₂) (Zc i).ι (𝟙 B) (by simp)
        (by simp), inferInstance, by simp only [Limits.pullback.map]; exact Limits.pullback.lift_fst _ _ _,
        by simp only [Limits.pullback.map]; exact Limits.pullback.lift_snd _ _ _, ?_⟩
      rw [Scheme.Pullback.range_map, Scheme.Opens.range_ι]
      have h1 : Set.range ⇑(𝟙 X₂) = Set.univ :=
        Set.range_eq_univ.mpr (fun x => ⟨x, by simp⟩)
      rw [h1, Set.preimage_univ, Set.univ_inter]
    have hmE : Topology.IsOpenEmbedding m := m.isOpenEmbedding
    refine ⟨Set.range m, m '' Set.range γ, hmE.isOpen_range, ?_, ?_, ?_, ?_⟩
    · intro y hy
      rw [hmr]
      exact hy
    · rintro y ⟨hy, ⟨t, rfl⟩⟩
      have ht : t ∈ closure (Set.range γ) := by
        rw [hmE.isInducing.closure_eq_preimage_closure_image]
        exact hy
      rw [γ.isClosedEmbedding.isClosed_range.closure_eq] at ht
      exact ⟨t, ht, rfl⟩
    · rintro y ⟨⟨u, rfl⟩, ⟨t, ht⟩⟩
      have hu : u ∈ s ⁻¹ᵁ Zc i := by
        show s u ∈ Zc i
        rw [← hFsnd, Scheme.Hom.comp_apply, ← ht, ← Scheme.Hom.comp_apply m, hmsnd,
          Scheme.Hom.comp_apply]
        rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι (Zc i)]
        exact ⟨_, rfl⟩
      have hstar : (s ⁻¹ᵁ Zc i).ι ≫ F = e i ≫ γ ≫ m := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hFfst, Category.assoc, Category.assoc, hmfst, hγfst, he1]
        · rw [Category.assoc, hFsnd, Category.assoc, Category.assoc, hmsnd, ← Category.assoc γ,
            hγsnd, he2]
      have h1 : ((s ⁻¹ᵁ Zc i).ι ≫ F) ⟨u, hu⟩ = (e i ≫ γ ≫ m) ⟨u, hu⟩ := by rw [hstar]
      simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply] at h1
      exact ⟨γ (e i ⟨u, hu⟩), ⟨e i ⟨u, hu⟩, rfl⟩, h1.symm⟩
    · have key : ∀ w, Limits.pullback.fst q₂ p (m (γ w)) = (W i).ι w := by
        intro w
        rw [← Scheme.Hom.comp_apply m, hmfst, ← Scheme.Hom.comp_apply γ, hγfst]
      rintro x y₁ ⟨⟨_, ⟨w₁, rfl⟩, rfl⟩, hx₁⟩ y₂ ⟨⟨_, ⟨w₂, rfl⟩, rfl⟩, hx₂⟩
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx₁ hx₂
      rw [key] at hx₁ hx₂
      have hw : w₁ = w₂ := (W i).ι.isOpenEmbedding.isEmbedding.injective (hx₁.trans hx₂.symm)
      rw [hw]
  choose O R hO hcovO hRc hFR hsub using piece
  have hcl : closure (Set.range F) ⊆ ⋃ i, R i := by
    intro y hy
    have hy' : Limits.pullback.snd q₂ p y ∈ (⨆ j, Zc j) := by rw [hcov]; trivial
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hy'
    have hyO := hcovO i y hi
    have h1 : y ∈ closure (O i ∩ Set.range F) := (hO i).inter_closure ⟨hyO, hy⟩
    have h2 : y ∈ closure (R i) := closure_mono (fun z hz => hFR i ⟨hz.2, hz.1⟩) h1
    exact Set.mem_iUnion.mpr ⟨i, hRc i ⟨h2, hyO⟩⟩
  have hclos : ∀ x : X₂,
      (closure (Set.range F) ∩ Limits.pullback.fst q₂ p ⁻¹' {x}).Finite := by
    intro x
    apply Set.Finite.subset (Set.finite_iUnion (fun i => (hsub i x).finite))
    rintro y ⟨hy, hyx⟩
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcl hy)
    exact Set.mem_iUnion.mpr ⟨i, hi, hyx⟩

  have hfib : ∀ x, ((F.imageι ≫ Limits.pullback.fst q₂ p) ⁻¹' {x}).Finite := by
    intro x
    have hinj : Function.Injective F.imageι := F.imageι.isClosedEmbedding.isEmbedding.injective
    apply Set.Finite.of_finite_image _ hinj.injOn
    apply (hclos x).subset
    rintro _ ⟨z, hz, rfl⟩
    refine ⟨hrange ▸ ⟨z, rfl⟩, ?_⟩
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hz ⊢
    rw [← Scheme.Hom.comp_apply]
    exact hz
  haveI : LocallyQuasiFinite (F.imageι ≫ Limits.pullback.fst q₂ p) :=
    LocallyQuasiFinite.of_finite_preimage_singleton _ hfib
  have hfin : IsFinite (F.imageι ≫ Limits.pullback.fst q₂ p) :=
    IsFinite.of_isProper_of_locallyQuasiFinite _
  refine ⟨F.image, F.imageι ≫ Limits.pullback.fst q₂ p, F.toImage,
    F.imageι ≫ Limits.pullback.snd q₂ p, hfin, ?_, ?_, ?_, ?_⟩
  · rw [← Category.assoc, Scheme.Hom.toImage_imageι, hFfst]
  · rw [← Category.assoc, Scheme.Hom.toImage_imageι, hFsnd]
  · rw [Category.assoc, Category.assoc, Limits.pullback.condition]
  · intro V
    let f := F
    rw [injective_iff_map_eq_zero]
    intro s hs
    obtain ⟨t, ht, htU⟩ := (f.imageι.isClosedEmbedding.isInducing.isOpen_iff).mp V.isOpen
    have key : ∀ x (hx : x ∈ V), ∃ V' : (Limits.pullback q₂ p).affineOpens,
        ∃ _ : f.imageι ⁻¹ᵁ (V' : (Limits.pullback q₂ p).Opens) ≤ V,
          x ∈ f.imageι ⁻¹ᵁ (V' : (Limits.pullback q₂ p).Opens) := by
      intro x hx
      have hx' : f.imageι x ∈ (⟨t, ht⟩ : (Limits.pullback q₂ p).Opens) := by
        have : x ∈ f.imageι ⁻¹' t := by rw [htU]; exact hx
        exact this
      obtain ⟨V'', hV, hxV, hVU⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
          (Scheme.isBasis_affineOpens (Limits.pullback q₂ p))) hx'
      refine ⟨⟨V'', hV⟩, ?_, hxV⟩
      intro y hy
      have h1 : f.imageι y ∈ (⟨t, ht⟩ : (Limits.pullback q₂ p).Opens) := hVU hy
      have h2 : y ∈ f.imageι ⁻¹' t := h1
      rw [htU] at h2
      exact h2
    apply TopCat.Presheaf.section_ext f.image.sheaf V s 0
    intro x hx
    obtain ⟨V', hW, hxW⟩ := key x hx
    have hres : (ConcreteCategory.hom (f.image.presheaf.map (homOfLE hW).op)) s = 0 := by
      apply f.toImage_app_injective V'
      rw [map_zero, ← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply, hs,
        map_zero]
    have e := TopCat.Presheaf.germ_res_apply f.image.presheaf (homOfLE hW) x hxW s
    rw [hres, map_zero] at e
    rw [map_zero]
    exact e.symm

theorem wc_csd_conductor_ideal : ∀ (X₀ G₀ : Scheme.{u}) (V₀ : X₀.Opens) (π₀ : G₀ ⟶ X₀) [IsFinite π₀] (τ : V₀.toScheme ⟶ G₀), τ ≫ π₀ = V₀.ι → (∀ O : X₀.Opens, Function.Injective (X₀.presheaf.map (homOfLE (inf_le_left : O ⊓ V₀ ≤ O)).op)) → (∀ O : G₀.Opens, Function.Injective (τ.app O)) → ∃ J : X₀.IdealSheafData, (J.support : Set X₀) ∩ (V₀ : Set X₀) = ∅ ∧ (∀ U : X₀.affineOpens, Function.Injective (π₀.app U)) ∧ (∀ (U : X₀.affineOpens) (c : Γ(X₀, U)), c ∈ J.ideal U → ∀ b : Γ(G₀, π₀ ⁻¹ᵁ U), ∃ a ∈ J.ideal U, π₀.app U a = π₀.app U c * b) :=
by
  intro X₀ G₀ V₀ π₀ _ τ e hSD hTI

  have hιinj : ∀ U : X₀.Opens, Function.Injective (V₀.ι.app U) := by
    intro U a b hab
    rw [Scheme.Opens.ι_app] at hab
    have hle : U ⊓ V₀ ≤ V₀.ι ''ᵁ V₀.ι ⁻¹ᵁ U := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι, inf_comm]
    have hle2 : V₀.ι ''ᵁ V₀.ι ⁻¹ᵁ U ≤ U := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf]; exact inf_le_right
    have hcomp : X₀.presheaf.map (homOfLE (inf_le_left : U ⊓ V₀ ≤ U)).op =
        X₀.presheaf.map (homOfLE hle2).op ≫ X₀.presheaf.map (homOfLE hle).op := by
      rw [← Functor.map_comp]; rfl
    apply hSD U
    rw [hcomp, CategoryTheory.comp_apply, CategoryTheory.comp_apply]
    exact congrArg (ConcreteCategory.hom (X₀.presheaf.map (homOfLE hle).op)) hab
  have hfac : ∀ U : X₀.Opens, ∃ ε : Γ(V₀.toScheme, V₀.ι ⁻¹ᵁ U) ⟶ Γ(V₀.toScheme, τ ⁻¹ᵁ (π₀ ⁻¹ᵁ U)),
      IsIso ε ∧ π₀.app U ≫ τ.app (π₀ ⁻¹ᵁ U) = V₀.ι.app U ≫ ε := by
    intro U
    have h1 : π₀.app U ≫ τ.app (π₀ ⁻¹ᵁ U) = _ :=
      (Scheme.Hom.comp_app τ π₀ U).symm.trans (Scheme.Hom.congr_app e U)
    refine ⟨_, ?_, h1⟩
    rw [eqToHom_op, eqToHom_map]
    have hiso : ∀ {X Y : CommRingCat.{u}} (h : X = Y), IsIso (eqToHom h) := by
      intro X Y h
      subst h
      exact IsIso.id _
    exact hiso _
  have hinj : ∀ U : X₀.Opens, Function.Injective (π₀.app U) := by
    intro U a b hab
    obtain ⟨ε, hε, h1⟩ := hfac U
    have hεinj := (ConcreteCategory.bijective_of_isIso ε).1
    have h2 : (π₀.app U ≫ τ.app (π₀ ⁻¹ᵁ U)) a = (π₀.app U ≫ τ.app (π₀ ⁻¹ᵁ U)) b := by
      rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, hab]
    rw [h1, CategoryTheory.comp_apply, CategoryTheory.comp_apply] at h2
    exact hιinj U (hεinj h2)
  have hsurj : ∀ U : X₀.Opens, U ≤ V₀ → Function.Surjective (π₀.app U) := by
    intro U hU r
    obtain ⟨ε, hε, h1⟩ := hfac U
    haveI : IsIso (V₀.ι.app U) :=
      Scheme.Hom.isIso_app V₀.ι U (by rw [Scheme.Opens.opensRange_ι]; exact hU)
    obtain ⟨a, ha⟩ := (ConcreteCategory.bijective_of_isIso (V₀.ι.app U ≫ ε)).2
      (τ.app (π₀ ⁻¹ᵁ U) r)
    refine ⟨a, hTI _ ?_⟩
    rw [← h1, CategoryTheory.comp_apply] at ha
    exact ha

  have s2 : ∀ (A R : Type u) [CommRing A] [CommRing R] (φ : A →+* R), ∃ I : Ideal A,
      ∀ a : A, a ∈ I ↔ ∀ b : R, ∃ a' : A, φ a' = φ a * b := by
    intro A R _ _ φ
    let I : Ideal A :=
      { carrier := {a | ∀ b : R, ∃ a' : A, φ a' = φ a * b}
        add_mem' := by
          intro a₁ a₂ h₁ h₂ b
          obtain ⟨c₁, hc₁⟩ := h₁ b
          obtain ⟨c₂, hc₂⟩ := h₂ b
          exact ⟨c₁ + c₂, by rw [map_add, map_add, hc₁, hc₂, add_mul]⟩
        zero_mem' := by
          intro b
          exact ⟨0, by simp⟩
        smul_mem' := by
          intro x a h b
          obtain ⟨c, hc⟩ := h b
          exact ⟨x * c, by rw [smul_eq_mul, map_mul, map_mul, hc, mul_assoc]⟩ }
    exact ⟨I, fun a => Iff.rfl⟩

  have s3a : ∀ (A R Af Rf : Type u) [CommRing A] [CommRing R] [CommRing Af] [CommRing Rf]
      (φ : A →+* R) (ρA : A →+* Af) (ρR : R →+* Rf) (φf : Af →+* Rf) (f : A), IsUnit (ρA f) →
      (∀ y : Rf, ∃ (b : R) (n : ℕ), y * ρR (φ f) ^ n = ρR b) →
      (∀ a : A, φf (ρA a) = ρR (φ a)) → ∀ a : A, (∀ b : R, ∃ a' : A, φ a' = φ a * b) →
      ∀ y : Rf, ∃ x' : Af, φf x' = φf (ρA a) * y := by
    intro A R Af Rf _ _ _ _ φ ρA ρR φf f hu hsurjR hcompat a ha y
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    obtain ⟨b, n, hb⟩ := hsurjR y
    obtain ⟨a', ha'⟩ := ha b
    refine ⟨ρA a' * v ^ n, ?_⟩
    have h1 : ρR (φ f) * φf v = 1 := by rw [← hcompat, ← map_mul, hv, map_one]
    have h2 : ρR (φ f) ^ n * φf v ^ n = 1 := by rw [← mul_pow, h1, one_pow]
    simp only [map_mul, map_pow, hcompat]
    rw [ha', map_mul, ← hb]
    linear_combination (ρR (φ a) * y) * h2

  have s3b : ∀ (A R Af Rf : Type u) [CommRing A] [CommRing R] [CommRing Af] [CommRing Rf]
      (φ : A →+* R) (ρA : A →+* Af) (ρR : R →+* Rf) (φf : Af →+* Rf) (f : A) (n : ℕ)
      (g : Fin n → R), IsUnit (ρA f) → (∀ x : Af, ∃ (a : A) (k : ℕ), x * ρA f ^ k = ρA a) →
      (∀ b b' : R, ρR b = ρR b' → ∃ m : ℕ, φ f ^ m * b = φ f ^ m * b') →
      (∀ a : A, φf (ρA a) = ρR (φ a)) → (∀ b : R, ∃ c : Fin n → A, b = ∑ i, φ (c i) * g i) →
      ∀ x : Af, (∀ y : Rf, ∃ x' : Af, φf x' = φf x * y) →
      ∃ (a : A) (w : Af), (∀ b : R, ∃ a' : A, φ a' = φ a * b) ∧ x = ρA a * w := by
    intro A R Af Rf _ _ _ _ φ ρA ρR φf f n g hu hsurjA hker hcompat hgen x hx
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    obtain ⟨a₀, k, hk⟩ := hsurjA x
    choose x' hx' using fun i => hx (ρR (g i))
    choose ai ki hki using fun i => hsurjA (x' i)
    have hrel : ∀ i, ρR (φ (ai i * f ^ k)) = ρR (φ (a₀ * f ^ (ki i)) * g i) := by
      intro i
      have e1 := congrArg φf (hki i)
      have e2 := congrArg φf hk
      simp only [map_mul, map_pow, hcompat] at e1 e2 ⊢
      rw [hx' i] at e1
      linear_combination (-(ρR (φ f)) ^ k) * e1 + (ρR (φ f) ^ ki i * ρR (g i)) * e2
    choose m hm using fun i => hker _ _ (hrel i)
    have key : ∀ i d, φ (a₀ * f ^ (d + (ki i + m i))) * g i =
        φ (f ^ d * ai i * f ^ (k + m i)) := by
      intro i d
      have h := hm i
      simp only [map_mul, map_pow] at h ⊢
      linear_combination (-(φ f) ^ d) * h
    obtain ⟨M, hM⟩ : ∃ M, M = ∑ i, (ki i + m i) := ⟨_, rfl⟩
    have hle : ∀ i, ki i + m i ≤ M := by
      intro i
      rw [hM]
      exact Finset.single_le_sum (f := fun j => ki j + m j) (fun j _ => Nat.zero_le _)
        (Finset.mem_univ i)
    refine ⟨a₀ * f ^ M, v ^ (k + M), ?_, ?_⟩
    · intro b
      obtain ⟨c, hc⟩ := hgen b
      refine ⟨∑ i, c i * (f ^ (M - (ki i + m i)) * ai i * f ^ (k + m i)), ?_⟩
      rw [hc, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      have h := key i (M - (ki i + m i))
      rw [Nat.sub_add_cancel (hle i)] at h
      rw [map_mul, ← h]
      ring
    · have hv' : ρA f ^ (k + M) * v ^ (k + M) = 1 := by rw [← mul_pow, hv, one_pow]
      rw [map_mul, ← hk, map_pow]
      linear_combination (-x) * hv'

  have s4 : ∀ (U : X₀.affineOpens) (f : Γ(X₀, U)),
      IsUnit ((X₀.presheaf.map (homOfLE (X₀.basicOpen_le f)).op).hom f) ∧
      (∀ x : Γ(X₀, X₀.basicOpen f), ∃ (a : Γ(X₀, U)) (k : ℕ),
        x * (X₀.presheaf.map (homOfLE (X₀.basicOpen_le f)).op).hom f ^ k =
          (X₀.presheaf.map (homOfLE (X₀.basicOpen_le f)).op).hom a) ∧
      (∀ y : Γ(G₀, π₀ ⁻¹ᵁ X₀.basicOpen f), ∃ (b : Γ(G₀, π₀ ⁻¹ᵁ U)) (k : ℕ),
        y * (G₀.presheaf.map (homOfLE (π₀.preimage_mono (X₀.basicOpen_le f))).op).hom
            ((π₀.app U).hom f) ^ k =
          (G₀.presheaf.map (homOfLE (π₀.preimage_mono (X₀.basicOpen_le f))).op).hom b) ∧
      (∀ b b' : Γ(G₀, π₀ ⁻¹ᵁ U),
        (G₀.presheaf.map (homOfLE (π₀.preimage_mono (X₀.basicOpen_le f))).op).hom b =
          (G₀.presheaf.map (homOfLE (π₀.preimage_mono (X₀.basicOpen_le f))).op).hom b' →
        ∃ m : ℕ, (π₀.app U).hom f ^ m * b = (π₀.app U).hom f ^ m * b') ∧
      (∀ a : Γ(X₀, U), (π₀.app (X₀.basicOpen f)).hom
          ((X₀.presheaf.map (homOfLE (X₀.basicOpen_le f)).op).hom a) =
        (G₀.presheaf.map (homOfLE (π₀.preimage_mono (X₀.basicOpen_le f))).op).hom
          ((π₀.app U).hom a)) := by
    intro U f
    have hU := U.2
    haveI hA := hU.isLocalization_basicOpen f
    have hpre : π₀ ⁻¹ᵁ X₀.basicOpen f = G₀.basicOpen ((π₀.app U).hom f) :=
      Scheme.preimage_basicOpen π₀ f
    letI : Algebra Γ(G₀, π₀ ⁻¹ᵁ U) Γ(G₀, π₀ ⁻¹ᵁ X₀.basicOpen f) :=
      (G₀.presheaf.map (homOfLE (π₀.preimage_mono (X₀.basicOpen_le f))).op).hom.toAlgebra
    haveI hR : IsLocalization.Away ((π₀.app U).hom f) Γ(G₀, π₀ ⁻¹ᵁ X₀.basicOpen f) :=
      (hU.preimage π₀).isLocalization_of_eq_basicOpen _
        (homOfLE (π₀.preimage_mono (X₀.basicOpen_le f))) hpre
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · exact IsLocalization.Away.algebraMap_isUnit f
    · intro x
      obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers f) x
      obtain ⟨k, hk⟩ := Submonoid.mem_powers_iff _ _ |>.mp s.2
      refine ⟨a, k, ?_⟩
      rw [← map_pow, hk]
      exact hs
    · intro y
      obtain ⟨⟨b, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers ((π₀.app U).hom f)) y
      obtain ⟨k, hk⟩ := Submonoid.mem_powers_iff _ _ |>.mp s.2
      refine ⟨b, k, ?_⟩
      rw [← map_pow, hk]
      exact hs
    · intro b b' h
      exact IsLocalization.Away.exists_of_eq (S := Γ(G₀, π₀ ⁻¹ᵁ X₀.basicOpen f)) _ h
    · intro a
      have h := Scheme.Hom.naturality π₀ (homOfLE (X₀.basicOpen_le f)).op
      have h2 := congrArg
        (fun φ : Γ(X₀, U) ⟶ Γ(G₀, π₀ ⁻¹ᵁ X₀.basicOpen f) => φ.hom a) h
      exact h2

  have s5 : ∀ U : X₀.affineOpens, ∃ (n : ℕ) (g : Fin n → Γ(G₀, π₀ ⁻¹ᵁ U)),
      ∀ b : Γ(G₀, π₀ ⁻¹ᵁ U), ∃ c : Fin n → Γ(X₀, U), b = ∑ i, (π₀.app U).hom (c i) * g i := by
    intro U
    have hf := IsFinite.finite_app π₀ U U.2
    letI := (π₀.app U).hom.toAlgebra
    haveI : Module.Finite Γ(X₀, U) Γ(G₀, π₀ ⁻¹ᵁ U) := hf
    obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := Γ(X₀, U)) (M := Γ(G₀, π₀ ⁻¹ᵁ U))
    refine ⟨n, g, fun b => ?_⟩
    have hb : b ∈ Submodule.span Γ(X₀, U) (Set.range g) := by rw [hg]; trivial
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hb
    exact ⟨c, by rw [← hc]; rfl⟩

  have s6 : ∀ J : X₀.IdealSheafData, (∀ U : X₀.affineOpens, (U : X₀.Opens) ≤ V₀ →
      (1 : Γ(X₀, U)) ∈ J.ideal U) → (J.support : Set X₀) ∩ (V₀ : Set X₀) = ∅ := by
    intro J hJ
    ext x
    simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
    intro hx hxV
    obtain ⟨W, hW, hxW, hWV⟩ := exists_isAffineOpen_mem_and_subset hxV
    have h1 := hJ ⟨W, hW⟩ (fun y hy => hWV hy)
    have h2 := (Scheme.IdealSheafData.mem_support_iff_of_mem (I := J) (U := ⟨W, hW⟩) hxW).mp hx
    rw [Scheme.mem_zeroLocus_iff] at h2
    exact h2 1 h1 (by rw [Scheme.basicOpen_one]; exact hxW)

  choose cond hcond using fun U : X₀.affineOpens => s2 Γ(X₀, U) Γ(G₀, π₀ ⁻¹ᵁ U) (π₀.app U).hom
  have hloc : ∀ (U : X₀.affineOpens) (f : Γ(X₀, U)),
      Ideal.map (X₀.presheaf.map (homOfLE (X₀.basicOpen_le f)).op).hom (cond U) =
        cond (X₀.affineBasicOpen f) := by
    intro U f
    obtain ⟨hunit, hsurjA, hsurjR, hkerR, hcompat⟩ := s4 U f
    apply le_antisymm
    · refine Ideal.map_le_iff_le_comap.mpr (fun a ha => ?_)
      exact (hcond (X₀.affineBasicOpen f) _).2
        (s3a _ _ _ _ (π₀.app U).hom _ _ (π₀.app (X₀.basicOpen f)).hom f hunit hsurjR
          hcompat a ((hcond U a).1 ha))
    · intro x hx
      have hx' := (hcond (X₀.affineBasicOpen f) x).1 hx
      obtain ⟨n, g, hgen⟩ := s5 U
      obtain ⟨a, w, ha, hxa⟩ := s3b _ _ _ _ (π₀.app U).hom _ _ (π₀.app (X₀.basicOpen f)).hom
        f n g hunit hsurjA hkerR hcompat hgen x hx'
      have hmem := Ideal.mul_mem_right w _ (Ideal.mem_map_of_mem
        (X₀.presheaf.map (homOfLE (X₀.basicOpen_le f)).op).hom ((hcond U a).2 ha))
      rw [← hxa] at hmem
      exact hmem
  let J : X₀.IdealSheafData :=
    { ideal := cond
      map_ideal_basicOpen := hloc
      supportSet := ⋂ U : X₀.affineOpens, X₀.zeroLocus ((cond U : Ideal Γ(X₀, U)) : Set Γ(X₀, U))
      supportSet_eq_iInter_zeroLocus := rfl }
  refine ⟨J, s6 J ?_, fun U => hinj U, ?_⟩
  · intro U hU
    show (1 : Γ(X₀, U)) ∈ cond U
    rw [hcond]
    intro b
    obtain ⟨a', ha'⟩ := hsurj U hU b
    exact ⟨a', by rw [map_one, one_mul]; exact ha'⟩
  · intro U c hc b
    have hc' := (hcond U c).1 hc
    obtain ⟨a', ha'⟩ := hc' b
    refine ⟨a', (hcond U a').2 (fun b'' => ?_), ha'⟩
    obtain ⟨a'', ha''⟩ := hc' (b * b'')
    exact ⟨a'', by rw [ha'', ha', mul_assoc]⟩

theorem wc_csd_conductor_blowup_map : ∀ (X₀ G₀ X₁ : Scheme.{u}) (π₀ : G₀ ⟶ X₀) [IsAffineHom π₀] (J : X₀.IdealSheafData) (r₁ : X₁ ⟶ X₀), (∀ U : X₀.affineOpens, Function.Injective (π₀.app U)) → (∀ (U : X₀.affineOpens) (c : Γ(X₀, U)), c ∈ J.ideal U → ∀ b : Γ(G₀, π₀ ⁻¹ᵁ U), ∃ a ∈ J.ideal U, π₀.app U a = π₀.app U c * b) → wcCsdInvPull J r₁ → ∃ g : X₁ ⟶ G₀, g ≫ π₀ = r₁ ∧ ∀ (T : Scheme.{u}) (k : T ⟶ X₁) [IsOpenImmersion k] (h : T ⟶ G₀), h ≫ π₀ = k ≫ r₁ → k ≫ g = h :=
by
  intro X₀ G₀ X₁ π₀ _ J r₁ hinj hcond hinv

  have L1 : ∀ (A R B : Type u) [CommRing A] [CommRing R] [CommRing B] (φ : A →+* R) (ρ : A →+* B)
      (I : Ideal A) (c : A), Function.Injective φ → (∀ b : R, ∃ a ∈ I, φ a = φ c * b) →
      ρ c ∈ nonZeroDivisors B → Ideal.map ρ I = Ideal.span {ρ c} → ∃ ψ : R →+* B, ψ.comp φ = ρ := by
    intro A R B _ _ _ φ ρ I c hφ hc hnz hspan
    choose a haI ha using hc
    have hh : ∀ b, ∃ x, x * ρ c = ρ (a b) := fun b => by
      have hm : ρ (a b) ∈ Ideal.map ρ I := Ideal.mem_map_of_mem ρ (haI b)
      rw [hspan, Ideal.mem_span_singleton'] at hm
      exact hm
    choose h hh using hh
    have key : ∀ b x w, x * ρ c = ρ w → φ w = φ c * b → x = h b := by
      intro b x w hx hw
      have hwa : w = a b := hφ (by rw [hw, ha])
      subst hwa
      have h0 : (x - h b) * ρ c = 0 := by rw [sub_mul, hx, hh, sub_self]
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hnz).mp h0)
    refine ⟨{ toFun := h, map_one' := ?_, map_mul' := ?_, map_zero' := ?_, map_add' := ?_ }, ?_⟩
    · exact (key 1 1 c (by simp) (by simp)).symm
    · intro b b'
      have e1 : c * a (b * b') = a b * a b' := hφ (by rw [map_mul, map_mul, ha, ha, ha]; ring)
      have e2 := congrArg ρ e1
      rw [map_mul, map_mul, ← hh, ← hh, ← hh] at e2
      have h0 : (h (b * b') - h b * h b') * (ρ c * ρ c) = 0 := by linear_combination e2
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff
        (Submonoid.mul_mem _ hnz hnz)).mp h0)
    · exact (key 0 0 0 (by simp) (by simp)).symm
    · intro b b'
      exact (key (b + b') (h b + h b') (a b + a b') (by rw [add_mul, hh, hh, map_add])
        (by rw [map_add, ha, ha, mul_add])).symm
    · apply RingHom.ext
      intro x
      exact (key (φ x) (ρ x) (c * x) (by rw [map_mul, mul_comm]) (by rw [map_mul])).symm

  have appLE_congr : ∀ {S Y : Scheme.{u}} (f f' : S ⟶ Y) (hf : f = f') (W : Y.Opens) (O : S.Opens)
      (e : O ≤ f ⁻¹ᵁ W) (e' : O ≤ f' ⁻¹ᵁ W), f.appLE W O e = f'.appLE W O e' := by
    rintro S Y f f' rfl W O e e'
    rfl

  have L2 : ∀ (S : Scheme.{u}) (U : X₀.affineOpens) (c : Γ(X₀, U)) (s : S ⟶ X₀) (O : S.Opens)
      (hO : IsAffineOpen O) (hOU : O ≤ s ⁻¹ᵁ U.1) (h h' : S ⟶ G₀),
      (∀ b : Γ(G₀, π₀ ⁻¹ᵁ U), ∃ a : Γ(X₀, U), π₀.app U a = π₀.app U c * b) →
      h ≫ π₀ = s → h' ≫ π₀ = s → (s.appLE U.1 O hOU).hom c ∈ nonZeroDivisors Γ(S, O) →
      O.ι ≫ h = O.ι ≫ h' := by
    intro S U c s O hO hOU h h' hc hh hh' hnz
    subst hh
    have e : O ≤ h ⁻¹ᵁ (π₀ ⁻¹ᵁ U.1) := by rw [← Scheme.Hom.comp_preimage]; exact hOU
    have e' : O ≤ h' ⁻¹ᵁ (π₀ ⁻¹ᵁ U.1) := by rw [← Scheme.Hom.comp_preimage, hh']; exact hOU
    have hβ : π₀.app U.1 ≫ h.appLE (π₀ ⁻¹ᵁ U.1) O e = (h ≫ π₀).appLE U.1 O hOU :=
      (Scheme.Hom.comp_appLE h π₀ U.1 O hOU).symm
    have hβ' : π₀.app U.1 ≫ h'.appLE (π₀ ⁻¹ᵁ U.1) O e' = (h ≫ π₀).appLE U.1 O hOU := by
      rw [← Scheme.Hom.comp_appLE h' π₀ U.1 O (by rw [Scheme.Hom.comp_preimage]; exact e')]
      exact appLE_congr _ _ hh' _ _ _ _
    have k1 : ∀ x, ((h ≫ π₀).appLE U.1 O hOU).hom x = (h.appLE _ O e).hom ((π₀.app U.1).hom x) :=
      fun x => by rw [← hβ]; rfl
    have k2 : ∀ x, ((h ≫ π₀).appLE U.1 O hOU).hom x = (h'.appLE _ O e').hom ((π₀.app U.1).hom x) :=
      fun x => by rw [← hβ']; rfl
    have hbb : h.appLE (π₀ ⁻¹ᵁ U.1) O e = h'.appLE (π₀ ⁻¹ᵁ U.1) O e' := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro b
      obtain ⟨a, ha⟩ := hc b
      have ha' : (π₀.app U.1).hom a = (π₀.app U.1).hom c * b := ha
      apply (mul_cancel_left_mem_nonZeroDivisors hnz).mp
      calc _ = (h.appLE _ O e).hom ((π₀.app U.1).hom c) * (h.appLE _ O e).hom b := by rw [k1 c]
        _ = (h.appLE _ O e).hom ((π₀.app U.1).hom c * b) := (map_mul _ _ _).symm
        _ = (h.appLE _ O e).hom ((π₀.app U.1).hom a) := by rw [ha']
        _ = ((h ≫ π₀).appLE U.1 O hOU).hom a := (k1 a).symm
        _ = (h'.appLE _ O e').hom ((π₀.app U.1).hom a) := k2 a
        _ = (h'.appLE _ O e').hom ((π₀.app U.1).hom c * b) := by rw [ha']
        _ = (h'.appLE _ O e').hom ((π₀.app U.1).hom c) * (h'.appLE _ O e').hom b := map_mul _ _ _
        _ = _ := by rw [k2 c]
    have hR : IsAffineOpen (π₀ ⁻¹ᵁ U.1) := U.2.preimage π₀
    have s1 := IsAffineOpen.SpecMap_appLE_fromSpec h hR hO e
    have s2 := IsAffineOpen.SpecMap_appLE_fromSpec h' hR hO e'
    rw [← hO.toSpecΓ_fromSpec, Category.assoc, Category.assoc, ← s1, ← s2, hbb]

  have nzd_iso : ∀ {R S : CommRingCat.{u}} (Φ : R ⟶ S), Function.Bijective Φ.hom →
      ∀ x, x ∈ nonZeroDivisors R → Φ.hom x ∈ nonZeroDivisors S := by
    intro R S Φ hΦ x hx
    have key : ∀ y, Φ.hom x * y = 0 → y = 0 := by
      intro y hy
      obtain ⟨y₀, rfl⟩ := hΦ.2 y
      have h1 : x * y₀ = 0 := hΦ.1 (by rw [map_mul, hy, map_zero])
      have h2 : y₀ = 0 := (mul_left_mem_nonZeroDivisors_eq_zero_iff hx).mp h1
      rw [h2, map_zero]
    rw [mem_nonZeroDivisors_iff]
    exact ⟨key, fun y hy => key y (by rw [mul_comm]; exact hy)⟩

  have L3 : ∀ (T : Scheme.{u}) (k : T ⟶ X₁) [IsOpenImmersion k] (U : X₀.affineOpens)
      (V : X₁.affineOpens) (hVU : V.1 ≤ r₁ ⁻¹ᵁ U.1) (a : Γ(X₀, U.1)) (τ : T), k τ ∈ V.1 →
      (r₁.appLE U.1 V.1 hVU).hom a ∈ nonZeroDivisors Γ(X₁, V.1) →
      ∃ (O : T.Opens) (hO : IsAffineOpen O) (hOU : O ≤ (k ≫ r₁) ⁻¹ᵁ U.1), τ ∈ O ∧
        ((k ≫ r₁).appLE U.1 O hOU).hom a ∈ nonZeroDivisors Γ(T, O) := by
    intro T k _ U V hVU a τ hτ hnz
    have hx : k τ ∈ k.opensRange ⊓ V.1 := ⟨⟨τ, rfl⟩, hτ⟩
    obtain ⟨f, hfle, hfmem⟩ := V.2.exists_basicOpen_le (V := k.opensRange ⊓ V.1) ⟨k τ, hx⟩ hτ
    have hDV : X₁.basicOpen f ≤ V.1 := X₁.basicOpen_le f
    have hDk : X₁.basicOpen f ≤ k.opensRange := hfle.trans inf_le_left
    have hO : IsAffineOpen (k ⁻¹ᵁ X₁.basicOpen f) :=
      (V.2.basicOpen f).preimage_of_isOpenImmersion k hDk
    have hOU : k ⁻¹ᵁ X₁.basicOpen f ≤ (k ≫ r₁) ⁻¹ᵁ U.1 := by
      rw [Scheme.Hom.comp_preimage]; exact k.preimage_mono (hDV.trans hVU)
    refine ⟨k ⁻¹ᵁ X₁.basicOpen f, hO, hOU, hfmem, ?_⟩
    have heq : (k ≫ r₁).appLE U.1 (k ⁻¹ᵁ X₁.basicOpen f) hOU =
        (r₁.appLE U.1 V.1 hVU ≫ X₁.presheaf.map (homOfLE hDV).op) ≫ k.app (X₁.basicOpen f) := by
      rw [Scheme.Hom.appLE_map, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
    rw [heq]
    haveI := V.2.isLocalization_basicOpen f
    have h1 : (X₁.presheaf.map (homOfLE hDV).op).hom ((r₁.appLE U.1 V.1 hVU).hom a) ∈
        nonZeroDivisors Γ(X₁, X₁.basicOpen f) :=
      IsLocalization.map_nonZeroDivisors_le (Submonoid.powers f) Γ(X₁, X₁.basicOpen f)
        ⟨_, hnz, rfl⟩
    haveI := k.isIso_app (X₁.basicOpen f) hDk
    have hbij : Function.Bijective (k.app (X₁.basicOpen f)).hom :=
      ConcreteCategory.bijective_of_isIso (k.app (X₁.basicOpen f))
    exact nzd_iso _ hbij _ h1

  have UNIQ : ∀ (T : Scheme.{u}) (k : T ⟶ X₁) [IsOpenImmersion k] (h h' : T ⟶ G₀),
      h ≫ π₀ = k ≫ r₁ → h' ≫ π₀ = k ≫ r₁ → h = h' := by
    intro T k _ h h' hh hh'
    apply Scheme.hom_ext_of_forall
    intro τ
    obtain ⟨U, V, hVU, a, hτ, ha, hnz, -⟩ := hinv (k τ)
    obtain ⟨O, hO, hOU, hτO, hnzO⟩ := L3 T k U V hVU a τ hτ hnz
    exact ⟨O, hτO, L2 T U a (k ≫ r₁) O hO hOU h h'
      (fun b => by obtain ⟨a', -, e⟩ := hcond U a ha b; exact ⟨a', e⟩) hh hh' hnzO⟩

  choose U V hVU a hmem ha hnz hspan using hinv
  have hloc : ∀ t, ∃ g : (V t).1.toScheme ⟶ G₀, g ≫ π₀ = (V t).1.ι ≫ r₁ := by
    intro t
    obtain ⟨ψ, hψ⟩ := L1 Γ(X₀, (U t).1) Γ(G₀, π₀ ⁻¹ᵁ (U t).1) Γ(X₁, (V t).1)
      (π₀.app (U t).1).hom (r₁.appLE (U t).1 (V t).1 (hVU t)).hom (J.ideal (U t)) (a t)
      (hinj (U t)) (fun b => hcond (U t) (a t) (ha t) b) (hnz t) (hspan t)
    have hVt : IsAffineOpen (V t).1 := (V t).2
    have hUt : IsAffineOpen (U t).1 := (U t).2
    refine ⟨(V t).1.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ) ≫
      (hUt.preimage π₀).fromSpec, ?_⟩
    have hW : π₀.app (U t).1 ≫ CommRingCat.ofHom ψ = r₁.appLE (U t).1 (V t).1 (hVU t) := by
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      exact hψ
    rw [Scheme.Hom.app_eq_appLE] at hW
    rw [Category.assoc, Category.assoc,
      ← IsAffineOpen.SpecMap_appLE_fromSpec π₀ hUt (hUt.preimage π₀) le_rfl,
      ← Category.assoc (Spec.map (CommRingCat.ofHom ψ)), ← Spec.map_comp, hW,
      IsAffineOpen.SpecMap_appLE_fromSpec r₁ hUt hVt (hVU t), ← Category.assoc,
      IsAffineOpen.toSpecΓ_fromSpec]
  choose g hg using hloc

  have hcov : TopologicalSpace.IsOpenCover (fun t => (V t).1) :=
    TopologicalSpace.IsOpenCover.mk
      (eq_top_iff.2 fun x _ => TopologicalSpace.Opens.mem_iSup.2 ⟨x, hmem x⟩)
  have compat : ∀ x y : (X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov).I₀,
      Limits.pullback.fst ((X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov).f x)
        ((X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov).f y) ≫ g x =
      Limits.pullback.snd ((X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov).f x)
        ((X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov).f y) ≫ g y := by
    intro x y
    apply UNIQ _ (Limits.pullback.fst ((X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov).f x)
        ((X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov).f y) ≫
        (X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov).f x)
    · exact (Category.assoc _ _ _).trans
        (congrArg (fun q => Limits.pullback.fst _ _ ≫ q) (hg x))
    · exact (Category.assoc _ _ _).trans ((congrArg (fun q => Limits.pullback.snd _ _ ≫ q) (hg y)).trans
        (by rw [Limits.pullback.condition, Category.assoc]; try rfl))
  have hG : (X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov).glueMorphisms
      (fun t => g t) compat ≫ π₀ = r₁ := by
    apply (X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov).hom_ext
    intro t
    have e1 := Scheme.Cover.ι_glueMorphisms (X₁.openCoverOfIsOpenCover (fun t => (V t).1) hcov)
      (fun t => g t) compat t
    rw [← Category.assoc, e1]
    exact hg t
  exact ⟨_, hG, fun T k _ h hh => UNIQ T k _ h (by rw [Category.assoc, hG]) hh⟩

theorem wc_csd_finite_conductor : ∀ (X : Scheme.{u}) [IsNoetherian X] (U : Scheme.{u}) (ιU : U ⟶ X) [IsOpenImmersion ιU] (G : Scheme.{u}) (π : G ⟶ X) (σ : U ⟶ G), IsFinite π → σ ≫ π = ιU → (∀ O : G.Opens, Function.Injective (σ.app O)) → Dense (Set.range ιU) → ∃ (X' : Scheme.{u}) (r : X' ⟶ X) (g : X' ⟶ G) (ι' : U ⟶ X'), wcCsdAdmTower X ιU.opensRange X' r ∧ g ≫ π = r ∧ IsOpenImmersion ι' ∧ Dense (Set.range ι') ∧ ι' ≫ r = ιU ∧ ι' ≫ g = σ :=
by
  intro X _ U ιU _ G π σ hπ hσπ _ _
  classical
  haveI : IsFinite π := hπ

  let Z : TopologicalSpace.Closeds X :=
    ⟨((ιU.opensRange : X.Opens) : Set X)ᶜ, ιU.opensRange.isOpen.isClosed_compl⟩
  obtain ⟨I₀, hI₀⟩ : ∃ I₀ : X.IdealSheafData,
      (I₀.support : Set X) = ((ιU.opensRange : X.Opens) : Set X)ᶜ :=
    ⟨Scheme.IdealSheafData.vanishingIdeal Z, Scheme.IdealSheafData.coe_support_vanishingIdeal Z⟩
  obtain ⟨X₀, r₀, hb₀, hX₀⟩ := wc_csd_blowup_exists_noeth X I₀
  haveI := hX₀
  have hVdisj : (I₀.support : Set X) ∩ ((ιU.opensRange : X.Opens) : Set X) = ∅ := by
    rw [hI₀]; exact Set.compl_inter_self _
  have hs₀ : (I₀.support : Set X) ∩ (((𝟙 X) ⁻¹ᵁ ιU.opensRange : X.Opens) : Set X) = ∅ := by
    rw [Scheme.Hom.id_preimage]; exact hVdisj
  have h₁ : wcCsdAdmTower X ιU.opensRange X₀ (r₀ ≫ 𝟙 X) :=
    wcCsdAdmTower.step (𝟙 X) I₀ r₀ wcCsdAdmTower.base hs₀ hb₀
  haveI hiso₀ : IsIso (r₀ ∣_ ιU.opensRange) :=
    wc_csd_blowup_iso_off_center X X₀ I₀ r₀ _ hb₀ hVdisj
  obtain ⟨hsd₀, hd₀⟩ := wc_csd_invpull_compl_schem_dense X X₀ I₀ r₀ ιU.opensRange hb₀.1
    (by rw [hI₀, compl_compl])

  obtain ⟨e, he_def⟩ : ∃ e : (r₀ ⁻¹ᵁ ιU.opensRange).toScheme ⟶ U,
      e = (r₀ ∣_ ιU.opensRange) ≫ ιU.isoOpensRange.inv := ⟨_, rfl⟩
  have hinvι : ιU.isoOpensRange.inv ≫ ιU = ιU.opensRange.ι :=
    (Iso.inv_comp_eq _).mpr ιU.isoOpensRange_hom_ι.symm
  have he : e ≫ ιU = (r₀ ⁻¹ᵁ ιU.opensRange).ι ≫ r₀ := by
    rw [he_def, Category.assoc, hinvι, morphismRestrict_ι]
  obtain ⟨τ₀, hτ₀f, hτ₀s⟩ : ∃ τ₀ : (r₀ ⁻¹ᵁ ιU.opensRange).toScheme ⟶ Limits.pullback π r₀,
      τ₀ ≫ Limits.pullback.fst π r₀ = e ≫ σ ∧
        τ₀ ≫ Limits.pullback.snd π r₀ = (r₀ ⁻¹ᵁ ιU.opensRange).ι :=
    ⟨Limits.pullback.lift (e ≫ σ) _ (by rw [Category.assoc, hσπ, he]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  haveI : QuasiCompact τ₀ := by
    haveI : QuasiCompact (τ₀ ≫ Limits.pullback.snd π r₀) := by rw [hτ₀s]; infer_instance
    exact QuasiCompact.of_comp τ₀ (Limits.pullback.snd π r₀)
  obtain ⟨π₁, hπ₁⟩ : ∃ π₁ : τ₀.image ⟶ X₀, π₁ = τ₀.imageι ≫ Limits.pullback.snd π r₀ :=
    ⟨_, rfl⟩
  haveI : IsFinite π₁ := by rw [hπ₁]; infer_instance
  have hτπ₁ : τ₀.toImage ≫ π₁ = (r₀ ⁻¹ᵁ ιU.opensRange).ι := by
    rw [hπ₁, ← Category.assoc, Scheme.Hom.toImage_imageι, hτ₀s]
  have hL5 := (wc_toImage_injective_dense _ _ τ₀).1

  obtain ⟨J, hJV, hinj, hcond⟩ :=
    wc_csd_conductor_ideal X₀ τ₀.image (r₀ ⁻¹ᵁ ιU.opensRange) π₁ τ₀.toImage hτπ₁ hsd₀ hL5
  obtain ⟨X₁, r₁, hb₁, _⟩ := wc_csd_blowup_exists_noeth X₀ J
  have hJV' : (J.support : Set X₀) ∩ (((r₀ ≫ 𝟙 X) ⁻¹ᵁ ιU.opensRange : X₀.Opens) : Set X₀) = ∅ := by
    rw [Category.comp_id]; exact hJV
  have h₂ : wcCsdAdmTower X ιU.opensRange X₁ (r₁ ≫ r₀ ≫ 𝟙 X) :=
    wcCsdAdmTower.step _ J r₁ h₁ hJV' hb₁
  obtain ⟨g₁, hg₁, hU₁⟩ := wc_csd_conductor_blowup_map X₀ τ₀.image X₁ π₁ J r₁ hinj hcond hb₁.1

  haveI hiso₁ : IsIso (r₁ ∣_ (r₀ ⁻¹ᵁ ιU.opensRange)) :=
    wc_csd_blowup_iso_off_center X₀ X₁ J r₁ _ hb₁ hJV
  obtain ⟨Q, hQ⟩ : ∃ Q : U ⟶ (r₁ ⁻¹ᵁ (r₀ ⁻¹ᵁ ιU.opensRange)).toScheme,
      Q = ιU.isoOpensRange.hom ≫ inv (r₀ ∣_ ιU.opensRange) ≫
        inv (r₁ ∣_ (r₀ ⁻¹ᵁ ιU.opensRange)) := ⟨_, rfl⟩
  haveI : IsIso Q := by rw [hQ]; infer_instance
  have k1 : (r₁ ⁻¹ᵁ (r₀ ⁻¹ᵁ ιU.opensRange)).ι ≫ r₁ ≫ r₀ =
      (r₁ ∣_ (r₀ ⁻¹ᵁ ιU.opensRange)) ≫ (r₀ ∣_ ιU.opensRange) ≫ ιU.opensRange.ι := by
    rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc, ← morphismRestrict_ι]
  have hk : (r₁ ⁻¹ᵁ (r₀ ⁻¹ᵁ ιU.opensRange)).ι ≫ g₁ =
      (r₁ ∣_ (r₀ ⁻¹ᵁ ιU.opensRange)) ≫ τ₀.toImage :=
    hU₁ _ _ _ (by rw [Category.assoc, hτπ₁, morphismRestrict_ι])

  let W₁ : X₀.Opens := ⟨(J.support : Set X₀)ᶜ, J.support.isClosed.isOpen_compl⟩
  have hVW : r₀ ⁻¹ᵁ ιU.opensRange ≤ W₁ := by
    intro x hx
    show x ∉ (J.support : Set X₀)
    intro hxJ
    have hmem : x ∈ (J.support : Set X₀) ∩ ((r₀ ⁻¹ᵁ ιU.opensRange : X₀.Opens) : Set X₀) :=
      ⟨hxJ, hx⟩
    rw [hJV] at hmem
    exact hmem
  haveI hisoW : IsIso (r₁ ∣_ W₁) :=
    wc_csd_blowup_iso_off_center X₀ X₁ J r₁ W₁ hb₁ (Set.inter_compl_self _)
  have hdW := (wc_csd_invpull_compl_schem_dense X₀ X₁ J r₁ W₁ hb₁.1 rfl).2
  have hdV := wc_csd_dense_preimage_transfer X₀ X₁ r₁ W₁ _ hVW hd₀ hisoW hdW
  refine ⟨X₁, r₁ ≫ r₀ ≫ 𝟙 X, g₁ ≫ τ₀.imageι ≫ Limits.pullback.fst π r₀,
    Q ≫ (r₁ ⁻¹ᵁ (r₀ ⁻¹ᵁ ιU.opensRange)).ι, h₂, ?_, inferInstance, ?_, ?_, ?_⟩
  · simp only [Category.assoc, Category.comp_id]
    rw [Limits.pullback.condition, ← hg₁, hπ₁]
    simp only [Category.assoc]
  · refine hdV.mono ?_
    intro x hx
    obtain ⟨y, rfl⟩ : x ∈ Set.range (r₁ ⁻¹ᵁ (r₀ ⁻¹ᵁ ιU.opensRange)).ι := by
      rw [Scheme.Opens.range_ι]; exact hx
    refine ⟨inv Q y, ?_⟩
    rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply (inv Q) Q, IsIso.inv_hom_id]
    rfl
  · simp only [Category.assoc, Category.comp_id]
    rw [k1, hQ]
    simp only [Category.assoc, IsIso.inv_hom_id_assoc]
    exact ιU.isoOpensRange_hom_ι
  · simp only [Category.assoc]
    rw [reassoc_of% hk, hQ]
    simp only [Category.assoc, IsIso.inv_hom_id_assoc]
    rw [reassoc_of% (Scheme.Hom.toImage_imageι τ₀), hτ₀f, he_def]
    simp only [Category.assoc, IsIso.inv_hom_id_assoc, Iso.hom_inv_id_assoc]

theorem wc_csd_nagata_general_proper : ∀ (K : Type u) [Field K] (n : ℕ) (B : Scheme.{u}) (jB : B ⟶ wcProjK K n) (U : Scheme.{u}) (ι : U ⟶ B) [IsOpenImmersion ι] (Z : Scheme.{u}) (p : Z ⟶ B) [IsProper p] (s : U ⟶ Z), IsClosedImmersion jB → Dense (Set.range ι) → s ≫ p = ι → ∃ (X : Scheme.{u}) (q : X ⟶ B) (f' : X ⟶ Z) (ι' : U ⟶ X), wcCsdAdmTower B ι.opensRange X q ∧ f' ≫ p = q ∧ IsOpenImmersion ι' ∧ Dense (Set.range ι') ∧ ι' ≫ q = ι ∧ ι' ≫ f' = s :=
by
  intro K _ n B jB U ι _ Z p _ s hjB hιd hsp

  obtain ⟨X₂, q₂, ι₂, k, Zc, W, φ, e, htow, hnoeth, hι₂, hqc, hd₂, hι₂q, hrange, hcov, hgraph,
    he1, he2⟩ :=
    wc_csd_piecewise_quasi_domination K n B jB U ι Z p s hjB hιd hsp
  haveI := hnoeth
  haveI := hι₂
  haveI := hqc

  obtain ⟨G, π, σ, g, hπ, hσπ, hσg, hgp, hσinj⟩ :=
    wc_csd_graph_closure_finite B X₂ q₂ U ι₂ Z p s k Zc W φ e
      (by rw [hsp, hι₂q]) hcov hgraph he1 he2

  obtain ⟨X', r, g', ι', htow', hg'π, hι', hd', hι'r, hι'g⟩ :=
    wc_csd_finite_conductor X₂ U ι₂ G π σ hπ hσπ hσinj hd₂
  have hrange' : ι₂.opensRange = q₂ ⁻¹ᵁ ι.opensRange :=
    TopologicalSpace.Opens.ext (Set.ext hrange)
  rw [hrange'] at htow'

  have trans : ∀ {Y : Scheme.{u}} {t : Y ⟶ X₂},
      wcCsdAdmTower X₂ (q₂ ⁻¹ᵁ ι.opensRange) Y t → wcCsdAdmTower B ι.opensRange Y (t ≫ q₂) := by
    intro Y t h
    induction h with
    | base => rw [Category.id_comp]; exact htow
    | step q I r' _ hI hb ih =>
      rw [Category.assoc]
      exact wcCsdAdmTower.step _ I r' ih hI hb
  refine ⟨X', r ≫ q₂, g' ≫ g, ι', trans htow', ?_, hι', hd', ?_, ?_⟩
  · rw [Category.assoc, hgp, ← Category.assoc, hg'π]
  · rw [← Category.assoc, hι'r, hι₂q]
  · rw [← Category.assoc, hι'g, hσg]

theorem wc_chow_strong_dense_affine : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (A₀ : Y.Opens), IsAffineOpen A₀ → Dense (A₀ : Set Y) → ∃ (N : ℕ) (Y₁ : Scheme.{u}) (π₁ : Y₁ ⟶ Y) (j₁ : Y₁ ⟶ wcProjK K N), IsProper π₁ ∧ IsClosedImmersion j₁ ∧ j₁ ≫ wcProjKStr K N = π₁ ≫ f ∧ IsIso (π₁ ∣_ A₀) :=
by
  intro K _ Y f _ A₀ hA₀ _

  obtain ⟨n, B, jB, ι, hjB, hι, hcomm, hιd⟩ := wc_csd_projective_closure K Y f A₀ hA₀
  haveI := hι

  let s : A₀.toScheme ⟶ Limits.pullback f (jB ≫ wcProjKStr K n) :=
    Limits.pullback.lift A₀.ι ι hcomm.symm
  have hsp : s ≫ Limits.pullback.snd f (jB ≫ wcProjKStr K n) = ι :=
    Limits.pullback.lift_snd _ _ _
  have hsf : s ≫ Limits.pullback.fst f (jB ≫ wcProjKStr K n) = A₀.ι :=
    Limits.pullback.lift_fst _ _ _

  obtain ⟨X, q, f', ι', htow, hf'p, hι', hι'd, _, hι's⟩ :=
    wc_csd_nagata_general_proper K n B jB A₀.toScheme ι
      (Limits.pullback f (jB ≫ wcProjKStr K n)) (Limits.pullback.snd f (jB ≫ wcProjKStr K n))
      s hjB hιd hsp

  obtain ⟨N, j, hj, hjstr⟩ := wc_csd_tower_projective K n B jB ι.opensRange X q hjB htow
  have h1 : ι' ≫ (f' ≫ Limits.pullback.fst f (jB ≫ wcProjKStr K n)) = A₀.ι := by
    rw [← Category.assoc, hι's, hsf]
  have h2 : j ≫ wcProjKStr K N = (f' ≫ Limits.pullback.fst f (jB ≫ wcProjKStr K n)) ≫ f := by
    rw [hjstr, ← hf'p]
    simp only [Category.assoc]
    rw [Limits.pullback.condition]

  obtain ⟨hprop, hiso⟩ := wc_csd_extension_gives_target K Y f A₀ N X j ι'
    (f' ≫ Limits.pullback.fst f (jB ≫ wcProjKStr K n)) hj hι' hι'd h1 h2
  exact ⟨N, X, f' ≫ Limits.pullback.fst f (jB ≫ wcProjKStr K n), j, hprop, hj, h2, hiso⟩

theorem wc_closed_irreducible_model_of_open : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (g : X ⟶ Spec (.of K)) [IsProper g] (W : X.Opens), IrreducibleSpace W → ∃ (Z : Scheme.{u}) (i : Z ⟶ X), IsClosedImmersion i ∧ IrreducibleSpace Z ∧ IsIso (i ∣_ W) :=
by
  intro K _ X g _ W hW
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian g
  have ht : W.ι.toImage ≫ W.ι.imageι = W.ι := Scheme.Hom.toImage_imageι W.ι

  have hirr : IrreducibleSpace W.ι.image := by
    have h1 : IsIrreducible (Set.univ : Set W.toScheme) := by
      have : IrreducibleSpace W.toScheme := hW
      exact IrreducibleSpace.isIrreducible_univ _
    have h2 : IsIrreducible (Set.range W.ι.toImage) := by
      rw [← Set.image_univ]
      exact h1.image _ (Scheme.Hom.continuous _).continuousOn
    have h3 : closure (Set.range W.ι.toImage) = Set.univ :=
      (IsDominant.denseRange (f := W.ι.toImage)).closure_range
    have h4 := h2.closure
    rw [h3] at h4
    exact (irreducibleSpace_def _).mpr h4

  have hrange : Set.range W.ι.toImage ⊆ Set.range (W.ι.imageι ⁻¹ᵁ W).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, ht]
    have : W.ι x ∈ Set.range W.ι := ⟨x, rfl⟩
    rwa [Scheme.Opens.range_ι] at this
  let s := IsOpenImmersion.lift (W.ι.imageι ⁻¹ᵁ W).ι W.ι.toImage hrange
  have hs : s ≫ (W.ι.imageι ⁻¹ᵁ W).ι = W.ι.toImage := IsOpenImmersion.lift_fac _ _ _
  have hsplit : s ≫ (W.ι.imageι ∣_ W) = 𝟙 _ := by
    rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hs, ht,
      Category.id_comp]
  have : IsSplitEpi (W.ι.imageι ∣_ W) := IsSplitEpi.mk' ⟨s, hsplit⟩
  have : Mono (W.ι.imageι ∣_ W ≫ W.ι) := by
    rw [morphismRestrict_ι]
    infer_instance
  have : Mono (W.ι.imageι ∣_ W) := mono_of_mono _ W.ι
  exact ⟨W.ι.image, W.ι.imageι, inferInstance, hirr, isIso_of_mono_of_isSplitEpi _⟩

theorem wc_chow_cover_iso_near_point : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] [IrreducibleSpace Y] (y₀ : Spec (.of K) ⟶ Y), y₀ ≫ f = 𝟙 _ → ∃ (N : ℕ) (Y' : Scheme.{u}) (π : Y' ⟶ Y) (j : Y' ⟶ wcProjK K N) (y₀' : Spec (.of K) ⟶ Y') (A : Y.Opens) (V : Y'.Opens), IsProper π ∧ IsClosedImmersion j ∧ j ≫ wcProjKStr K N = π ≫ f ∧ IrreducibleSpace Y' ∧ topologicalKrullDim Y' = (d : WithBot ℕ∞) ∧ y₀' ≫ π = y₀ ∧ y₀ (IsLocalRing.closedPoint K) ∈ A ∧ IsIso (π ∣_ A) ∧ y₀' (IsLocalRing.closedPoint K) ∈ V ∧ SmoothOfRelativeDimension d (V.ι ≫ j ≫ wcProjKStr K N) :=
by
  intro K _ _ Y f _ d _ _ y₀ hy₀
  have hdimlem := @wc_dim_le_dim_dense_open_part

  obtain ⟨A, hAaff, hyA, -⟩ := exists_isAffineOpen_mem_and_subset (U := (⊤ : Y.Opens))
    (x := y₀ (IsLocalRing.closedPoint K)) trivial
  have hAdense : Dense (A : Set Y) := A.isOpen.dense ⟨_, hyA⟩
  have hAirr : IrreducibleSpace A := by
    have h1 : IsPreirreducible (A : Set Y) :=
      (IrreducibleSpace.isIrreducible_univ Y).isPreirreducible.open_subset A.isOpen
        (Set.subset_univ _)
    exact Subtype.irreducibleSpace ⟨⟨_, hyA⟩, h1⟩
  haveI hAirr' : IrreducibleSpace A.toScheme := hAirr
  haveI hAsm : SmoothOfRelativeDimension d (A.ι ≫ f) := by
    have h := smoothOfRelativeDimension_comp 0 d A.ι f
    rw [zero_add] at h
    exact h

  obtain ⟨N, Y₁, π₁, j₁, hπ₁, hj₁, hcomm₁, hiso₁⟩ :=
    wc_chow_strong_dense_affine K Y f A hAaff hAdense
  haveI := hπ₁
  haveI := hj₁
  haveI := hiso₁

  have hWirr : IrreducibleSpace (π₁ ⁻¹ᵁ A) :=
    Function.Surjective.irreducibleSpace (f := (Scheme.homeoOfIso (asIso (π₁ ∣_ A))).symm)
      (Scheme.homeoOfIso (asIso (π₁ ∣_ A))).symm.continuous
      (Scheme.homeoOfIso (asIso (π₁ ∣_ A))).symm.surjective
  obtain ⟨Y', i, hi, hY'irr, hiso_i⟩ :=
    wc_closed_irreducible_model_of_open K Y₁ (π₁ ≫ f) (π₁ ⁻¹ᵁ A) hWirr
  haveI := hi
  haveI := hY'irr
  haveI := hiso_i
  haveI hisoπ : IsIso ((i ≫ π₁) ∣_ A) := by
    rw [morphismRestrict_comp]
    exact IsIso.comp_isIso' hiso_i hiso₁

  have hrange : Set.range y₀ ⊆ Set.range A.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨p, rfl⟩
    have hp : p = IsLocalRing.closedPoint K := Subsingleton.elim (α := PrimeSpectrum K) _ _
    rw [hp]
    exact hyA
  let y₀' : Spec (.of K) ⟶ Y' :=
    IsOpenImmersion.lift A.ι y₀ hrange ≫ inv ((i ≫ π₁) ∣_ A) ≫ ((i ≫ π₁) ⁻¹ᵁ A).ι
  have hy₀' : y₀' ≫ (i ≫ π₁) = y₀ := by
    show (IsOpenImmersion.lift A.ι y₀ hrange ≫ inv ((i ≫ π₁) ∣_ A) ≫ ((i ≫ π₁) ⁻¹ᵁ A).ι) ≫
      (i ≫ π₁) = y₀
    rw [Category.assoc, Category.assoc, ← morphismRestrict_ι, IsIso.inv_hom_id_assoc,
      IsOpenImmersion.lift_fac]
  have hmemV : y₀' (IsLocalRing.closedPoint K) ∈ (i ≫ π₁) ⁻¹ᵁ A := by
    have h : (y₀' ≫ (i ≫ π₁)) (IsLocalRing.closedPoint K) ∈ A := by
      rw [hy₀']
      exact hyA
    exact h

  have hsm : SmoothOfRelativeDimension d (((i ≫ π₁) ⁻¹ᵁ A).ι ≫ (i ≫ j₁) ≫ wcProjKStr K N) := by
    have e : ((i ≫ π₁) ⁻¹ᵁ A).ι ≫ (i ≫ j₁) ≫ wcProjKStr K N = ((i ≫ π₁) ∣_ A) ≫ (A.ι ≫ f) := by
      rw [Category.assoc i j₁ (wcProjKStr K N), hcomm₁, ← Category.assoc i π₁ f,
        ← Category.assoc ((i ≫ π₁) ⁻¹ᵁ A).ι (i ≫ π₁) f, ← morphismRestrict_ι,
        Category.assoc ((i ≫ π₁) ∣_ A) A.ι f]
    rw [e]
    have h := smoothOfRelativeDimension_comp 0 d ((i ≫ π₁) ∣_ A) (A.ι ≫ f)
    rw [zero_add] at h
    exact h

  have hdimA : topologicalKrullDim A.toScheme = (d : WithBot ℕ∞) :=
    le_antisymm (wc_smooth_alg_closed_dim_le K A.toScheme (A.ι ≫ f) d)
      (wc_smooth_irreducible_dim_ge K A.toScheme (A.ι ≫ f) d)
  have hdimV : topologicalKrullDim ((i ≫ π₁) ⁻¹ᵁ A).toScheme = topologicalKrullDim A.toScheme :=
    IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso (asIso ((i ≫ π₁) ∣_ A))).isHomeomorph
  have hle1 : topologicalKrullDim ((i ≫ π₁) ⁻¹ᵁ A).toScheme ≤ topologicalKrullDim Y' :=
    topologicalKrullDim_subspace_le Y' (((i ≫ π₁) ⁻¹ᵁ A : Y'.Opens) : Set Y')
  have hsub : (Set.univ : Set Y') ⊆
      closure (Set.univ ∩ (((i ≫ π₁) ⁻¹ᵁ A : Y'.Opens) : Set Y')) := by
    rw [Set.univ_inter, (((i ≫ π₁) ⁻¹ᵁ A).isOpen.dense ⟨_, hmemV⟩).closure_eq]
  have hle2 : topologicalKrullDim Y' ≤ topologicalKrullDim ((i ≫ π₁) ⁻¹ᵁ A).toScheme := by
    have h := hdimlem K Y' ((i ≫ π₁) ≫ f) Set.univ _ isClosed_univ
      ((i ≫ π₁) ⁻¹ᵁ A).isOpen hsub
    rw [IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ Y').isHomeomorph,
      IsHomeomorph.topologicalKrullDim_eq _
        (Homeomorph.setCongr (Set.univ_inter _)).isHomeomorph] at h
    exact h
  refine ⟨N, Y', i ≫ π₁, i ≫ j₁, y₀', A, (i ≫ π₁) ⁻¹ᵁ A, inferInstance, inferInstance, ?_,
    hY'irr, ?_, hy₀', hyA, hisoπ, hmemV, hsm⟩
  · rw [Category.assoc, hcomm₁, Category.assoc]
  · rw [← hdimA, ← hdimV]
    exact le_antisymm hle2 hle1

theorem wc_etale_of_unramified_smooth_same_reldim : ∀ {X Y S : Scheme.{u}} (p : X ⟶ Y) (g : Y ⟶ S)
    (d : ℕ), SmoothOfRelativeDimension d g → SmoothOfRelativeDimension d (p ≫ g) →
    FormallyUnramified p → Etale p :=
by

  have s1 : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] [Algebra A B]
      [Algebra B C] [Algebra A C] [IsScalarTower A B C] (d : ℕ),
      Algebra.IsStandardSmoothOfRelativeDimension d A B →
      Algebra.IsStandardSmoothOfRelativeDimension d A C →
      Algebra.FormallyUnramified B C → Algebra.Etale B C := by
    intro A B C _ _ _ _ _ _ _ d hB hC hU
    haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth d (R := A) (S := B)
    haveI := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth d (R := A) (S := C)
    haveI : Algebra.FinitePresentation A C := Algebra.IsStandardSmooth.finitePresentation
    haveI : Algebra.FinitePresentation A B := Algebra.IsStandardSmooth.finitePresentation
    haveI : Algebra.FinitePresentation B C :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation A B C
    have hH1 : Subsingleton (Algebra.H1Cotangent B C) := by
      rcases subsingleton_or_nontrivial C with hC0 | hC0
      · exact Module.subsingleton C _
      haveI : Nontrivial B := RingHom.domain_nontrivial (algebraMap B C)
      haveI : Module.Free B Ω[B⁄A] := Algebra.IsStandardSmooth.free_kaehlerDifferential
      haveI : Module.Free C Ω[C⁄A] := Algebra.IsStandardSmooth.free_kaehlerDifferential
      have rB : Module.rank B Ω[B⁄A] = d :=
        Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential d
      have rC : Module.rank C Ω[C⁄A] = d :=
        Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential d
      haveI : Module.Finite B Ω[B⁄A] := Module.finite_of_rank_eq_nat rB
      haveI : Module.Finite C Ω[C⁄A] := Module.finite_of_rank_eq_nat rC
      have fB : Module.finrank B Ω[B⁄A] = d := Module.finrank_eq_of_rank_eq rB
      have fC : Module.finrank C Ω[C⁄A] = d := Module.finrank_eq_of_rank_eq rC
      have fM : Module.finrank C (TensorProduct B C Ω[B⁄A]) = d := by
        rw [Module.finrank_baseChange, fB]
      have hsurj : Function.Surjective (KaehlerDifferential.mapBaseChange A B C) := by
        intro y
        exact (KaehlerDifferential.exact_mapBaseChange_map A B C y).mp (Subsingleton.elim _ _)
      let e : Ω[C⁄A] ≃ₗ[C] TensorProduct B C Ω[B⁄A] :=
        LinearEquiv.ofFinrankEq _ _ (by rw [fC, fM])
      have hinj : Function.Injective (KaehlerDifferential.mapBaseChange A B C) := by
        have h1 : Function.Injective (e.toLinearMap ∘ₗ KaehlerDifferential.mapBaseChange A B C) :=
          OrzechProperty.injective_of_surjective_endomorphism _ (e.surjective.comp hsurj)
        exact Function.Injective.of_comp h1
      have hz : ∀ z : Algebra.H1Cotangent B C, z = 0 := by
        intro z
        have h1 : KaehlerDifferential.mapBaseChange A B C (Algebra.H1Cotangent.δ A B C z) = 0 :=
          (Algebra.H1Cotangent.exact_δ_mapBaseChange A B C).apply_apply_eq_zero z
        have h2 : Algebra.H1Cotangent.δ A B C z = 0 := hinj (by rw [h1, map_zero])
        obtain ⟨w, hw⟩ := (Algebra.H1Cotangent.exact_map_δ A B C z).mp h2
        rw [← hw, Subsingleton.elim w 0, map_zero]
      exact ⟨fun a b => (hz a).trans (hz b).symm⟩
    haveI : Subsingleton Ω[C⁄B] := Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    haveI : Module.Free C Ω[C⁄B] := Module.Free.of_subsingleton _ _
    haveI : Algebra.FormallySmooth B C := Algebra.FormallySmooth.mk inferInstance hH1
    haveI : Algebra.FormallyEtale B C :=
      Algebra.FormallyEtale.of_formallyUnramified_and_formallySmooth
    exact Algebra.Etale.mk

  have s2 : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B)
      (g : B →+* C) (d : ℕ),
      RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d) f →
      RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d) (g.comp f) →
      g.FormallyUnramified → g.Etale := by
    intro A B C _ _ _ f g d hf hgf hg
    obtain ⟨s, hs, hsf⟩ := hf
    obtain ⟨s', hs', hs'f⟩ := hgf
    open Pointwise in
    have hspan : Ideal.span ((g '' s) * s') = ⊤ := by
      rw [← Ideal.span_mul_span, ← Ideal.map_span, hs, hs', Ideal.map_top, Ideal.top_mul]
    open Pointwise in
    apply RingHom.OfLocalizationSpanTarget.ofIsLocalization RingHom.Etale.ofLocalizationSpanTarget
      RingHom.Etale.respectsIso g _ hspan
    rintro ⟨r, hr⟩
    open Pointwise in
    obtain ⟨_, ⟨t, ht, rfl⟩, t', ht', rfl⟩ := Set.mem_mul.mp hr
    haveI hT' : IsLocalization.Away (g t * t')
        (Localization.Away (algebraMap C (Localization.Away t') (g t))) :=
      IsLocalization.Away.mul (Localization.Away t')
        (Localization.Away (algebraMap C (Localization.Away t') (g t))) t' (g t)
    refine ⟨Localization.Away (algebraMap C (Localization.Away t') (g t)), inferInstance,
      inferInstance, hT', ?_⟩
    have hunit : IsUnit (((algebraMap C
        (Localization.Away (algebraMap C (Localization.Away t') (g t)))).comp g) t) := by
      have h := IsLocalization.Away.algebraMap_isUnit
        (S := Localization.Away (algebraMap C (Localization.Away t') (g t))) (g t * t')
      rw [map_mul] at h
      exact isUnit_of_mul_isUnit_left h
    have hstar := IsLocalization.Away.lift_comp (S := Localization.Away t) t hunit
    set h := IsLocalization.Away.lift (S := Localization.Away t) t hunit with hh
    have hii : RingHom.IsStandardSmoothOfRelativeDimension d
        (h.comp ((algebraMap B (Localization.Away t)).comp f)) := by
      rw [← RingHom.comp_assoc, hstar, IsScalarTower.algebraMap_eq C (Localization.Away t')
        (Localization.Away (algebraMap C (Localization.Away t') (g t))), RingHom.comp_assoc,
        RingHom.comp_assoc]
      have := RingHom.IsStandardSmoothOfRelativeDimension.comp
        (RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
          (Rᵣ := Localization.Away (algebraMap C (Localization.Away t') (g t)))
          (algebraMap C (Localization.Away t') (g t))) (hs'f t' ht')
      rwa [zero_add] at this
    have hiii : h.FormallyUnramified := by
      apply RingHom.FormallyUnramified.of_comp (f := algebraMap B (Localization.Away t))
      rw [hstar]
      exact RingHom.FormallyUnramified.comp hg
        (RingHom.FormallyUnramified.holdsForLocalizationAway
          (Localization.Away (algebraMap C (Localization.Away t') (g t))) (g t * t'))
    have hi := hsf t ht
    have hE : h.Etale := by
      letI : Algebra A (Localization.Away t) :=
        ((algebraMap B (Localization.Away t)).comp f).toAlgebra
      letI : Algebra (Localization.Away t)
          (Localization.Away (algebraMap C (Localization.Away t') (g t))) := h.toAlgebra
      letI : Algebra A (Localization.Away (algebraMap C (Localization.Away t') (g t))) :=
        (h.comp ((algebraMap B (Localization.Away t)).comp f)).toAlgebra
      haveI : IsScalarTower A (Localization.Away t)
          (Localization.Away (algebraMap C (Localization.Away t') (g t))) :=
        IsScalarTower.of_algebraMap_eq' rfl
      exact s1 A _ _ d hi hii hiii
    have hloc : (algebraMap B (Localization.Away t)).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway t)
    have := RingHom.Etale.stableUnderComposition _ _ hloc hE
    rwa [hstar] at this

  intro X Y S p g d hg hpg hu
  haveI := hu
  rw [Etale.iff_smoothOfRelativeDimension_zero]
  constructor
  intro x
  obtain ⟨U₀, hU₀, hxU₀, -⟩ := exists_isAffineOpen_mem_and_subset (x := g (p x))
    (U := (⊤ : S.Opens)) trivial
  obtain ⟨W, hW, hxW, hWU⟩ := exists_isAffineOpen_mem_and_subset (x := p x) (U := g ⁻¹ᵁ U₀) hxU₀
  obtain ⟨V, hV, hxV, hVW⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := p ⁻¹ᵁ W) hxW
  have eW : W ≤ g ⁻¹ᵁ U₀ := hWU
  have eV : V ≤ p ⁻¹ᵁ W := hVW
  have eVU : V ≤ (p ≫ g) ⁻¹ᵁ U₀ := by
    rw [Scheme.Hom.comp_preimage]; exact eV.trans (Scheme.Hom.preimage_mono p eW)
  have h1 := HasRingHomProperty.appLE (@SmoothOfRelativeDimension d) g hg ⟨U₀, hU₀⟩ ⟨W, hW⟩ eW
  have h2 := HasRingHomProperty.appLE (@SmoothOfRelativeDimension d) (p ≫ g) hpg ⟨U₀, hU₀⟩
    ⟨V, hV⟩ eVU
  have h3 := FormallyUnramified.formallyUnramified_appLE p hW hV eV
  have hcomp : (p.appLE W V eV).hom.comp (g.appLE U₀ W eW).hom =
      ((p ≫ g).appLE U₀ V eVU).hom := by
    rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
  rw [← hcomp] at h2
  have hE := s2 _ _ d h1 h2 h3
  refine ⟨W, hW, V, hV, hxV, eV, ?_⟩
  letI := (p.appLE W V eV).hom.toAlgebra
  exact (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero).mp hE

theorem wc_rational_closed_specialization : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u})
    (f : X ⟶ Spec (.of K)) [LocallyOfFiniteType f] (x : X),
    ∃ x₁ : Spec (.of K) ⟶ X, x₁ ≫ f = 𝟙 _ ∧ x ⤳ x₁ (IsLocalRing.closedPoint K) :=
by
  intro K _ _ X f _ x
  haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace f
  have hZ : IsClosed (closure ({x} : Set X)) := isClosed_closure
  have hxZ : x ∈ closure ({x} : Set X) := subset_closure rfl
  have hc := JacobsonSpace.closure_inter_closedPoints hZ
  have hne : (closure ({x} : Set X) ∩ closedPoints X).Nonempty := by
    rw [← closure_nonempty_iff, hc]; exact ⟨x, hxZ⟩
  obtain ⟨y, hyZ, hyc⟩ := hne
  have hy : IsClosed ({y} : Set X) := mem_closedPoints_iff.mp hyc
  have hxy : x ⤳ y := specializes_iff_mem_closure.mpr hyZ
  haveI : LocallyOfFiniteType (X.fromSpecResidueField y) :=
    isClosed_singleton_iff_locallyOfFiniteType.mp hy
  obtain ⟨g, hg⟩ : ∃ g, g = X.fromSpecResidueField y ≫ f := ⟨_, rfl⟩
  haveI : LocallyOfFiniteType g := by rw [hg]; infer_instance
  let φ : CommRingCat.of K ⟶ X.residueField y := (Spec.fullyFaithful.preimage g).unop
  have hφ : Spec.map φ = g := Spec.map_preimage_unop g
  have hlft : LocallyOfFiniteType (Spec.map φ) := by rw [hφ]; infer_instance
  have hft : φ.hom.FiniteType := (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hlft
  letI : Algebra K (X.residueField y) := φ.hom.toAlgebra
  haveI : Algebra.FiniteType K (X.residueField y) := hft
  haveI hmf : Module.Finite K (X.residueField y) :=
    finite_of_finite_type_of_isJacobsonRing K (X.residueField y)
  have hfin : φ.hom.Finite := hmf
  have hint : φ.hom.IsIntegral := RingHom.IsIntegral.of_finite hfin
  have hbij : Function.Bijective φ.hom := IsAlgClosed.ringHom_bijective_of_isIntegral φ.hom hint
  let e : K ≃+* X.residueField y := RingEquiv.ofBijective φ.hom hbij
  let ψ : X.residueField y ⟶ CommRingCat.of K := CommRingCat.ofHom e.symm.toRingHom
  refine ⟨Spec.map ψ ≫ X.fromSpecResidueField y, ?_, ?_⟩
  · rw [Category.assoc, ← hg, ← hφ, ← Spec.map_comp]
    have h1 : φ ≫ ψ = 𝟙 _ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      show e.symm (φ.hom a) = a
      exact e.symm_apply_apply a
    rw [h1, Spec.map_id]
  · have hpt : ∀ z : Spec (X.residueField y), X.fromSpecResidueField y z = y :=
      fun z => Scheme.fromSpecResidueField_apply y z
    convert hxy using 1
    exact hpt _

theorem wc_linear_forms_avoid_closed : ∀ (K : Type u) [Field K] [Infinite K] (N e : ℕ)
    (T : Set (wcProjK K N)), IsClosed T → topologicalKrullDim ↥T ≤ (e : WithBot ℕ∞) →
    ∀ (C : ℕ → (ℕ → MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) →
        Submodule K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1)),
    (∀ i f g, (∀ k < i, f k = g k) → C i f = C i g) → (∀ i f, C i f ≠ ⊤) →
    ∃ ℓ : ℕ → MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1, (∀ i ≤ e, ℓ i ∉ C i ℓ) ∧
      ∀ x ∈ T, ∃ i ≤ e, x ∈ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
        (ℓ i : MvPolynomial (Fin (N + 1)) K) :=
by
  intro K _ _ N e T hT hTdim C hdep hne
  classical
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have hPS : TopologicalSpace.NoetherianSpace
      (ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)) := by
    let f : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) →
        PrimeSpectrum (MvPolynomial (Fin (N + 1)) K) :=
      fun x => ⟨x.asHomogeneousIdeal.toIdeal, x.isPrime⟩
    have hf : Topology.IsInducing f := by
      rw [Topology.isInducing_iff]
      apply TopologicalSpace.ext_isClosed
      intro s
      refine (ProjectiveSpectrum.isClosed_iff_zeroLocus _ s).trans
        (Iff.trans ?_ isClosed_induced_iff.symm)
      constructor
      · rintro ⟨t, rfl⟩
        exact ⟨PrimeSpectrum.zeroLocus t, PrimeSpectrum.isClosed_zeroLocus t,
          Set.ext fun x => Iff.rfl⟩
      · rintro ⟨t, ht, rfl⟩
        obtain ⟨u, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus t).mp ht
        exact ⟨u, Set.ext fun x => Iff.rfl⟩
    exact hf.noetherianSpace
  haveI : TopologicalSpace.NoetherianSpace ↥(wcProjK K N) := hPS

  have hsucc : ∀ (X : Type u) [TopologicalSpace X] (Z W : Set X), IsIrreducible Z → IsClosed W →
      W ⊆ Z → W ≠ Z → ∀ m : ℕ, (m : WithBot ℕ∞) ≤ topologicalKrullDim ↥W →
      ((m + 1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim ↥Z := by
    intro X _ Z W hZ hW hWZ hne m hm
    have hm' : (m : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥W) := hm
    obtain ⟨p, hp⟩ := Order.le_krullDim_iff.mp hm'
    have hι : Topology.IsClosedEmbedding (Set.inclusion hWZ) :=
      Topology.IsClosedEmbedding.inclusion hWZ hW.preimage_val
    let φ : TopologicalSpace.IrreducibleCloseds ↥W → TopologicalSpace.IrreducibleCloseds ↥Z :=
      fun S => ⟨Set.inclusion hWZ '' (S : Set ↥W),
        S.isIrreducible.image _ hι.continuous.continuousOn, hι.isClosedMap _ S.isClosed⟩
    have hφ : StrictMono φ := by
      intro S T hST
      have h1 : (S : Set ↥W) ⊂ (T : Set ↥W) := SetLike.coe_ssubset_coe.mpr hST
      have h2 := (Set.inclusion_injective hWZ).image_strictMono h1
      exact SetLike.coe_ssubset_coe.mp h2
    haveI : IrreducibleSpace ↥Z := Subtype.irreducibleSpace hZ
    let top : TopologicalSpace.IrreducibleCloseds ↥Z :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥Z, isClosed_univ⟩
    obtain ⟨z, hzZ, hzW⟩ : ∃ z ∈ Z, z ∉ W := by
      by_contra h
      push_neg at h
      exact hne (Set.Subset.antisymm hWZ h)
    have hlast : (p.map φ hφ).last < top := by
      rw [LTSeries.last_map]
      apply SetLike.coe_ssubset_coe.mp
      show Set.inclusion hWZ '' (p.last : Set ↥W) ⊂ Set.univ
      refine ⟨Set.subset_univ _, fun h => ?_⟩
      obtain ⟨w, _, hw⟩ := h (Set.mem_univ (⟨z, hzZ⟩ : ↥Z))
      apply hzW
      have h3 : (w : X) = z := congrArg Subtype.val hw
      exact h3 ▸ w.2
    show ((m + 1 : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Z)
    exact Order.le_krullDim_iff.mpr ⟨(p.map φ hφ).snoc top hlast, by simp [hp]⟩

  have hE : ∀ (X : Type u) [TopologicalSpace X] (S : Set X), S = ∅ →
      topologicalKrullDim ↥S = ⊥ := by
    intro X _ S hS
    subst hS
    unfold topologicalKrullDim
    rw [Order.krullDim_eq_bot_iff]
    constructor
    intro Z
    obtain ⟨p, _⟩ := Z.isIrreducible.nonempty
    exact p.2
  have hN : ∀ (X : Type u) [TopologicalSpace X] (S : Set X),
      topologicalKrullDim ↥S < ((0 : ℕ) : WithBot ℕ∞) → S = ∅ := by
    intro X _ S hS
    by_contra hne
    obtain ⟨a, ha⟩ := Set.nonempty_iff_ne_empty.mpr hne
    haveI : Nonempty (TopologicalSpace.IrreducibleCloseds ↥S) :=
      ⟨⟨closure {(⟨a, ha⟩ : ↥S)}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
    have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥S := Order.krullDim_nonneg
    rw [Nat.cast_zero] at hS
    exact absurd hS (not_lt.mpr h0)

  have hunion : ∀ (X : Type u) [TopologicalSpace X] {ι : Type u} (s : Finset ι) (A : ι → Set X)
      (n : ℕ), (∀ i ∈ s, IsClosed (A i)) → (∀ i ∈ s, topologicalKrullDim ↥(A i) < (n : WithBot ℕ∞)) →
      topologicalKrullDim ↥(⋃ i ∈ s, A i) < (n : WithBot ℕ∞) := by
    intro X _ ι s A n hc hd
    have wc_union : ∀ (A B : Set X) (n : ℕ),
        IsClosed A → IsClosed B → topologicalKrullDim ↥A ≤ (n : WithBot ℕ∞) →
        topologicalKrullDim ↥B ≤ (n : WithBot ℕ∞) →
        topologicalKrullDim ↥(A ∪ B) ≤ (n : WithBot ℕ∞) := by
      intro A B n hAc hBc hA hB
      have key : ∀ (S T : Set X) (h : S ⊆ T) (Z : TopologicalSpace.IrreducibleCloseds ↥T),
          (∀ z ∈ (Z : Set ↥T), (z : X) ∈ S) →
          Order.krullDim ↑(Set.Iic Z) ≤ topologicalKrullDim ↥S := by
        intro S T h Z hZ
        have hlift : ∀ P : Set ↥T, (∀ p ∈ P, (p : X) ∈ S) →
            Set.inclusion h '' (Set.inclusion h ⁻¹' P) = P := by
          intro P hP
          apply Set.image_preimage_eq_of_subset
          intro p hp
          exact ⟨⟨p.1, hP p hp⟩, rfl⟩
        have hirr : ∀ W : Set ↥T, IsIrreducible W → (∀ w ∈ W, (w : X) ∈ S) →
            IsIrreducible (Set.inclusion h ⁻¹' W) := by
          intro W hW hWS
          refine ⟨?_, ?_⟩
          · obtain ⟨w, hw⟩ := hW.nonempty
            exact ⟨⟨w.1, hWS w hw⟩, hw⟩
          · rw [isPreirreducible_iff_isClosed_union_isClosed]
            intro z₁ z₂ hz₁ hz₂ hsub
            have hind := (Topology.IsEmbedding.inclusion h).isInducing
            obtain ⟨c₁, hc₁, rfl⟩ := hind.isClosed_iff.mp hz₁
            obtain ⟨c₂, hc₂, rfl⟩ := hind.isClosed_iff.mp hz₂
            have hW' : W ⊆ c₁ ∪ c₂ := by
              intro w hw
              have hmem : (⟨w.1, hWS w hw⟩ : ↥S) ∈ Set.inclusion h ⁻¹' W := hw
              exact hsub hmem
            rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hW.isPreirreducible)
                c₁ c₂ hc₁ hc₂ hW' with h1 | h1
            · left; exact Set.preimage_mono h1
            · right; exact Set.preimage_mono h1
        have hsubZ : ∀ W : ↑(Set.Iic Z), (W.1 : Set ↥T) ⊆ (Z : Set ↥T) := fun W =>
          SetLike.coe_subset_coe.mpr W.2
        let Φ : ↑(Set.Iic Z) → TopologicalSpace.IrreducibleCloseds ↥S := fun W =>
          ⟨Set.inclusion h ⁻¹' (W.1 : Set ↥T),
            hirr _ W.1.isIrreducible (fun w hw => hZ w (hsubZ W hw)),
            W.1.isClosed.preimage (continuous_inclusion h)⟩
        have hmono : Monotone Φ := by
          intro W W' hle
          have hle' : (W.1 : Set ↥T) ⊆ (W'.1 : Set ↥T) := SetLike.coe_subset_coe.mpr hle
          exact SetLike.coe_subset_coe.mp (Set.preimage_mono hle' :
            Set.inclusion h ⁻¹' (W.1 : Set ↥T) ⊆ Set.inclusion h ⁻¹' (W'.1 : Set ↥T))
        have hinj : Function.Injective Φ := by
          intro W W' hWW
          have e1 : Set.inclusion h ⁻¹' (W.1 : Set ↥T) = Set.inclusion h ⁻¹' (W'.1 : Set ↥T) :=
            congrArg (fun V : TopologicalSpace.IrreducibleCloseds ↥S => (V : Set ↥S)) hWW
          have e2 : (W.1 : Set ↥T) = (W'.1 : Set ↥T) := by
            calc (W.1 : Set ↥T) = Set.inclusion h '' (Set.inclusion h ⁻¹' (W.1 : Set ↥T)) :=
                  (hlift _ (fun w hw => hZ w (hsubZ W hw))).symm
              _ = Set.inclusion h '' (Set.inclusion h ⁻¹' (W'.1 : Set ↥T)) := by rw [e1]
              _ = (W'.1 : Set ↥T) := hlift _ (fun w hw => hZ w (hsubZ W' hw))
          exact Subtype.ext (TopologicalSpace.IrreducibleCloseds.ext e2)
        exact Order.krullDim_le_of_strictMono Φ (hmono.strictMono_of_injective hinj)
      have hU : topologicalKrullDim ↥(A ∪ B) =
          Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥(A ∪ B)) := rfl
      rw [hU, Order.krullDim_eq_iSup_height]
      refine iSup_le (fun Z => ?_)
      rw [Order.height_eq_krullDim_Iic]
      have himg : IsIrreducible (Subtype.val '' (Z : Set ↥(A ∪ B))) :=
        Z.isIrreducible.image _ continuous_subtype_val.continuousOn
      have hcov : Subtype.val '' (Z : Set ↥(A ∪ B)) ⊆ A ∪ B := by
        rintro _ ⟨z, _, rfl⟩
        exact z.2
      rcases (isPreirreducible_iff_isClosed_union_isClosed.mp himg.isPreirreducible)
          A B hAc hBc hcov with hZA | hZB
      · exact (key A (A ∪ B) Set.subset_union_left Z
          (fun z hz => hZA (Set.mem_image_of_mem _ hz))).trans hA
      · exact (key B (A ∪ B) Set.subset_union_right Z
          (fun z hz => hZB (Set.mem_image_of_mem _ hz))).trans hB
    have hS : ∀ (m : ℕ) (x : WithBot ℕ∞),
        x < ((m + 1 : ℕ) : WithBot ℕ∞) ↔ x ≤ ((m : ℕ) : WithBot ℕ∞) := by
      intro m x
      induction x using WithBot.recBotCoe with
      | bot => simp
      | coe e =>
        rw [← WithBot.coe_natCast, ← WithBot.coe_natCast, WithBot.coe_lt_coe, WithBot.coe_le_coe,
          Nat.cast_add, Nat.cast_one]
        exact ENat.lt_add_one_iff (by simp)
    rcases n with _ | m
    · have hAe : ∀ i ∈ s, A i = ∅ := fun i hi => hN X _ (hd i hi)
      have hU : (⋃ i ∈ s, A i) = ∅ := by
        ext x
        simp only [Set.mem_iUnion, Set.mem_empty_iff_false, iff_false]
        rintro ⟨i, hi, hx⟩
        rw [hAe i hi] at hx
        exact hx
      rw [hE X _ hU]
      exact bot_lt_iff_ne_bot.mpr (WithBot.natCast_ne_bot _)
    · rw [hS m]
      have hd' : ∀ i ∈ s, topologicalKrullDim ↥(A i) ≤ ((m : ℕ) : WithBot ℕ∞) :=
        fun i hi => (hS m _).mp (hd i hi)
      clear hd
      revert hc hd'
      induction s using Finset.induction_on with
      | empty =>
        intro _ _
        rw [hE X _ (by simp)]
        exact bot_le
      | insert a t hat ih =>
        intro hc hd'
        rw [Finset.set_biUnion_insert]
        apply wc_union (A a) (⋃ x ∈ t, A x) m
        · exact hc a (Finset.mem_insert_self a t)
        · exact isClosed_biUnion_finset (fun i hi => hc i (Finset.mem_insert_of_mem hi))
        · exact hd' a (Finset.mem_insert_self a t)
        · exact ih (fun i hi => hc i (Finset.mem_insert_of_mem hi))
            (fun i hi => hd' i (Finset.mem_insert_of_mem hi))

  have hX : ∀ x : ↥(wcProjK K N), ∃ j : Fin (N + 1), x ∈ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j) := by
    intro x
    by_contra hx
    push_neg at hx
    apply x.not_irrelevant_le
    intro a ha
    have hi : ∀ i, MvPolynomial.X i ∈ x.asHomogeneousIdeal.toIdeal := fun i => by
      have := hx i
      rw [Proj.mem_basicOpen, not_not] at this
      exact HomogeneousIdeal.mem_iff.mpr this
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha
    have ha' : MvPolynomial.homogeneousComponent 0 a = 0 :=
      (MvPolynomial.decomposition.decompose'_apply a 0).symm.trans ha
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha'
    have hspan : a ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra hc
      push_neg at hc
      have hm0 : m = 0 := Finsupp.ext fun i => hc i (Set.mem_univ i)
      rw [hm0] at hm
      exact (MvPolynomial.mem_support_iff.mp hm) ha'
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) ≤
        x.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨i, _, rfl⟩
      exact hi i
    exact HomogeneousIdeal.mem_iff.mp (hle hspan)

  obtain ⟨V, hVc, hVmem⟩ : ∃ V : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) →
      Set ↥(wcProjK K N), (∀ ℓ, IsClosed (V ℓ)) ∧ ∀ ℓ z, z ∈ V ℓ ↔
        z ∉ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (ℓ : MvPolynomial (Fin (N + 1)) K) :=
    ⟨fun ℓ => ((Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (ℓ : MvPolynomial (Fin (N + 1)) K) : Set ↥(wcProjK K N)))ᶜ,
      fun ℓ => (Proj.basicOpen _ _).isOpen.isClosed_compl, fun ℓ z => Iff.rfl⟩
  have hVmem' : ∀ ℓ (z : ↥(wcProjK K N)), z ∈ V ℓ ↔
      (ℓ : MvPolynomial (Fin (N + 1)) K) ∈ z.asHomogeneousIdeal.toIdeal := by
    intro ℓ z
    rw [hVmem, Proj.mem_basicOpen, not_not]
    first
      | rfl
      | exact HomogeneousIdeal.mem_iff.symm
      | exact HomogeneousIdeal.mem_iff

  have hVanEx : ∀ t : Set ↥(wcProjK K N), ∃ W : Submodule K
      ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1), ∀ ℓ, ℓ ∈ W ↔ ∀ z ∈ t, z ∈ V ℓ := by
    intro t
    refine ⟨⨅ z ∈ t, Submodule.comap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1).subtype
      ((z : ↥(wcProjK K N)).asHomogeneousIdeal.toIdeal.restrictScalars K), fun ℓ => ?_⟩
    simp only [Submodule.mem_iInf, Submodule.mem_comap, Submodule.restrictScalars_mem,
      Submodule.subtype_apply, hVmem']
  choose Van hVan using hVanEx

  have hcut : ∀ (n : ℕ) (S : Set ↥(wcProjK K N)), IsClosed S →
      topologicalKrullDim ↥S < ((n + 1 : ℕ) : WithBot ℕ∞) →
      ∀ P : Submodule K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1), P ≠ ⊤ →
      ∃ m, m ∉ P ∧ topologicalKrullDim ↥(S ∩ V m) < (n : WithBot ℕ∞) := by
    intro n S hS hSd P hP
    obtain ⟨𝒮, h𝒮f, h𝒮c, h𝒮i, hS𝒮⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hS
    have hVne : ∀ t ∈ 𝒮, Van t ≠ ⊤ := by
      intro t ht htop
      obtain ⟨z, hz⟩ := (h𝒮i t ht).nonempty
      obtain ⟨j, hj⟩ := hX z
      have hxj : (⟨MvPolynomial.X j, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
          (MvPolynomial.isHomogeneous_X K j)⟩ :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1)) ∈ Van t := by
        rw [htop]; exact Submodule.mem_top
      exact (hVmem _ z).mp ((hVan t _).mp hxj z hz) hj
    haveI : Finite ↥𝒮 := h𝒮f.to_subtype
    obtain ⟨ℓ, hℓ⟩ := Submodule.exists_forall_notMem_of_forall_ne_top
      (fun o : Option ↥𝒮 => o.elim P (fun t => Van t.1)) (by
        intro o
        cases o with
        | none => exact hP
        | some t => exact hVne t.1 t.2)
    have hℓP : ℓ ∉ P := hℓ none
    have hℓV : ∀ t ∈ 𝒮, ℓ ∉ Van t := fun t ht => hℓ (some ⟨t, ht⟩)
    have hpiece : ∀ t ∈ 𝒮, IsClosed (t ∩ V ℓ) ∧
        topologicalKrullDim ↥(t ∩ V ℓ) < (n : WithBot ℕ∞) := by
      intro t ht
      have hWc : IsClosed (t ∩ V ℓ) := (h𝒮c t ht).inter (hVc ℓ)
      refine ⟨hWc, ?_⟩
      by_contra hlt
      rw [not_lt] at hlt
      have hne' : t ∩ V ℓ ≠ t := by
        intro heq
        apply hℓV t ht
        rw [hVan]
        intro z hz
        exact ((Set.ext_iff.mp heq z).mpr hz).2
      have h1 := hsucc _ t (t ∩ V ℓ) (h𝒮i t ht) hWc Set.inter_subset_left hne' n hlt
      have hts : t ⊆ S := by rw [hS𝒮]; exact Set.subset_sUnion_of_mem ht
      have h2 : topologicalKrullDim ↥t ≤ topologicalKrullDim ↥S :=
        (Topology.IsEmbedding.inclusion hts).isInducing.topologicalKrullDim_le
      exact absurd (lt_of_le_of_lt (h1.trans h2) hSd) (lt_irrefl _)
    have hSeq : S ∩ V ℓ = ⋃ t ∈ h𝒮f.toFinset, (t ∩ V ℓ) := by
      ext x
      simp only [Set.mem_inter_iff, Set.mem_iUnion, Set.Finite.mem_toFinset, exists_prop]
      constructor
      · rintro ⟨hx, hv⟩
        rw [hS𝒮, Set.mem_sUnion] at hx
        obtain ⟨t, ht, hxt⟩ := hx
        exact ⟨t, ht, hxt, hv⟩
      · rintro ⟨t, ht, hxt, hv⟩
        refine ⟨?_, hv⟩
        rw [hS𝒮]
        exact Set.mem_sUnion_of_mem hxt ht
    refine ⟨ℓ, hℓP, ?_⟩
    rw [hSeq]
    exact hunion _ h𝒮f.toFinset (fun t => t ∩ V ℓ) n
      (fun t ht => (hpiece t ((Set.Finite.mem_toFinset h𝒮f).mp ht)).1)
      (fun t ht => (hpiece t ((Set.Finite.mem_toFinset h𝒮f).mp ht)).2)

  have claim : ∀ i, i ≤ e + 1 → ∃ f : ℕ → ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1),
      (∀ k < i, f k ∉ C k f) ∧ IsClosed (T ∩ ⋂ k ∈ Finset.range i, V (f k)) ∧
      topologicalKrullDim ↥(T ∩ ⋂ k ∈ Finset.range i, V (f k)) <
        ((e + 1 - i : ℕ) : WithBot ℕ∞) := by
    intro i
    induction i with
    | zero =>
      intro _
      have hR0 : ∀ f : ℕ → ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1),
          T ∩ ⋂ k ∈ Finset.range 0, V (f k) = T := by
        intro f
        simp
      refine ⟨fun _ => 0, fun k hk => absurd hk (Nat.not_lt_zero k), ?_, ?_⟩
      · rw [hR0]; exact hT
      · rw [hR0, Nat.sub_zero]
        exact lt_of_le_of_lt hTdim (by exact_mod_cast Nat.lt_succ_self e)
    | succ i ih =>
      intro hi
      obtain ⟨f, hf, hRc, hRd⟩ := ih (by omega)
      have he : e + 1 - i = (e - i) + 1 := by omega
      rw [he] at hRd
      obtain ⟨m, hmC, hmd⟩ := hcut (e - i) _ hRc hRd (C i f) (hne i f)
      obtain ⟨g, hg⟩ : ∃ g : ℕ → ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1),
          g = fun k => if k < i then f k else m := ⟨_, rfl⟩
      have hgi : ∀ k < i, g k = f k := fun k hk => by rw [hg]; exact if_pos hk
      have hgm : g i = m := by rw [hg]; exact if_neg (lt_irrefl i)
      have hReq : T ∩ ⋂ k ∈ Finset.range (i + 1), V (g k) =
          (T ∩ ⋂ k ∈ Finset.range i, V (f k)) ∩ V m := by
        ext x
        simp only [Set.mem_inter_iff, Set.mem_iInter, Finset.mem_range]
        constructor
        · rintro ⟨hxT, hx⟩
          refine ⟨⟨hxT, fun k hk => ?_⟩, ?_⟩
          · rw [← hgi k hk]; exact hx k (by omega)
          · rw [← hgm]; exact hx i (by omega)
        · rintro ⟨⟨hxT, hx⟩, hxm⟩
          refine ⟨hxT, fun k hk => ?_⟩
          rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk | hk
          · rw [hgi k hk]; exact hx k hk
          · rw [hk, hgm]; exact hxm
      refine ⟨g, ?_, ?_, ?_⟩
      · intro k hk
        rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk | hk
        · rw [hdep k g f (fun j hj => hgi j (lt_trans hj hk)), hgi k hk]
          exact hf k hk
        · rw [hk, hdep i g f hgi, hgm]
          exact hmC
      · rw [hReq]; exact hRc.inter (hVc m)
      · rw [hReq, show e + 1 - (i + 1) = e - i by omega]
        exact hmd

  obtain ⟨f, hf, -, hRd⟩ := claim (e + 1) le_rfl
  rw [Nat.sub_self] at hRd
  have hRempty : T ∩ ⋂ k ∈ Finset.range (e + 1), V (f k) = ∅ := hN _ _ hRd
  refine ⟨f, fun i hi => hf i (by omega), fun x hx => ?_⟩
  by_contra hcon
  push_neg at hcon
  have hxR : x ∈ T ∩ ⋂ k ∈ Finset.range (e + 1), V (f k) := by
    refine ⟨hx, ?_⟩
    simp only [Set.mem_iInter, Finset.mem_range]
    intro k hk
    exact (hVmem (f k) x).mpr (hcon k (by omega))
  rw [hRempty] at hxR
  exact hxR

theorem wc_unram_kaehler_nakayama : ∀ (K A C : Type u) [CommRing K] [CommRing A] [CommRing C]
    [Algebra K C] [Algebra A C] [Algebra.EssFiniteType K C] (κ : K →+* A),
    (algebraMap A C).comp κ = algebraMap K C →
    ∀ (I : Ideal C) (n : ℕ) (s : Fin n → A),
    (⊤ : Submodule C Ω[C⁄K]) ≤ Submodule.span C (Set.range fun i =>
      KaehlerDifferential.D K C (algebraMap A C (s i))) ⊔ I • ⊤ →
    ∃ g : C, g - 1 ∈ I ∧ ∀ (C' : Type u) [CommRing C'] [Algebra C C'] [IsLocalization.Away g C'],
      ((algebraMap C C').comp (algebraMap A C)).FormallyUnramified :=
by
  intro K A C _ _ _ _ _ _ κ hκ I n s hH
  letI : Algebra K A := κ.toAlgebra
  haveI : IsScalarTower K A C :=
    IsScalarTower.of_algebraMap_eq (fun x => (RingHom.congr_fun hκ x).symm)
  let μ : Ω[C⁄K] →ₗ[C] Ω[C⁄A] := KaehlerDifferential.map K A C C
  have hsurj : Function.Surjective μ := KaehlerDifferential.map_surjective K A C
  haveI := KaehlerDifferential.finite K C
  haveI hfin : Module.Finite C Ω[C⁄A] := Module.Finite.of_surjective μ hsurj
  have hspan : Submodule.span C (Set.range fun i =>
      KaehlerDifferential.D K C (algebraMap A C (s i))) ≤ LinearMap.ker μ := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    simp only [SetLike.mem_coe, LinearMap.mem_ker, μ, KaehlerDifferential.map_D]
    exact (KaehlerDifferential.D A C).map_algebraMap (s i)
  have hle : (⊤ : Submodule C Ω[C⁄A]) ≤ I • ⊤ := by
    intro ω _
    obtain ⟨ω₀, rfl⟩ := hsurj ω
    obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.mp (hH (Submodule.mem_top (x := ω₀)))
    rw [← hxy, map_add, LinearMap.mem_ker.mp (hspan hx), zero_add]
    have hmem : μ y ∈ Submodule.map μ (I • ⊤) := Submodule.mem_map_of_mem hy
    rw [Submodule.map_smul''] at hmem
    exact Submodule.smul_mono (le_refl I) le_top hmem
  obtain ⟨g, hg1, hg⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul I ⊤
    Module.Finite.fg_top hle
  refine ⟨g, hg1, ?_⟩
  intro C' _ _ _
  letI : Algebra A C' := ((algebraMap C C').comp (algebraMap A C)).toAlgebra
  haveI : IsScalarTower A C C' := IsScalarTower.of_algebraMap_eq (fun x => rfl)
  have hD1 : ∀ c : C, KaehlerDifferential.D A C' (algebraMap C C' c) = 0 := by
    intro c
    have hu : IsUnit (algebraMap C C' g) := IsLocalization.Away.algebraMap_isUnit g
    rw [← KaehlerDifferential.map_D A A C C']
    refine (hu.smul_left_cancel).mp ?_
    rw [smul_zero, algebraMap_smul, ← LinearMap.map_smul, hg _ Submodule.mem_top, map_zero]
  have hD : ∀ c' : C', KaehlerDifferential.D A C' c' = 0 := by
    intro c'
    obtain ⟨⟨c, m⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers g) c'
    have hspec := IsLocalization.mk'_spec C' c m
    have hm : IsUnit (algebraMap C C' m) := IsLocalization.map_units C' m
    have h := congrArg (KaehlerDifferential.D A C') hspec
    rw [Derivation.leibniz, hD1, hD1, smul_zero, zero_add] at h
    exact (hm.smul_left_cancel).mp (h.trans (smul_zero _).symm)
  haveI : Subsingleton Ω[C'⁄A] := by
    have h : Submodule.span C' (Set.range (KaehlerDifferential.D A C')) = ⊥ := by
      rw [Submodule.span_eq_bot]
      rintro _ ⟨c', rfl⟩
      exact hD c'
    rw [KaehlerDifferential.span_range_derivation] at h
    refine subsingleton_of_forall_eq 0 (fun ω => ?_)
    have hω : ω ∈ (⊤ : Submodule C' Ω[C'⁄A]) := Submodule.mem_top
    rw [h] at hω
    exact (Submodule.mem_bot C').mp hω
  have hFU : Algebra.FormallyUnramified A C' := Algebra.FormallyUnramified.mk inferInstance
  exact RingHom.formallyUnramified_algebraMap.mpr hFU

theorem wc_unram_cotangent_finrank_le : ∀ (K B : Type u) [Field K] [CommRing B] [Algebra K B]
    (d : ℕ) [Algebra.IsStandardSmoothOfRelativeDimension d K B] (I : Ideal B), I ≠ ⊤ →
    (∀ b : B, ∃ c : K, b - algebraMap K B c ∈ I) →
    FiniteDimensional K (Ω[B⁄K] ⧸ (I • ⊤ : Submodule B Ω[B⁄K])) ∧
      Module.finrank K (Ω[B⁄K] ⧸ (I • ⊤ : Submodule B Ω[B⁄K])) ≤ d :=
by
  intro K B _ _ _ d _ I hI hK
  classical
  haveI : Nontrivial B := by
    by_contra h
    rw [not_nontrivial_iff_subsingleton] at h
    apply hI
    rw [Ideal.eq_top_iff_one]
    rw [Subsingleton.elim (1 : B) 0]
    exact I.zero_mem
  haveI : Algebra.IsStandardSmooth K B :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth d
  have hrank : Module.rank B Ω[B⁄K] = d :=
    Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential d
  haveI : Module.Finite B Ω[B⁄K] := Module.finite_of_rank_eq_nat hrank
  have hfin : Module.finrank B Ω[B⁄K] = d := Module.finrank_eq_of_rank_eq hrank
  let b := Module.finBasisOfFinrankEq B Ω[B⁄K] hfin
  set N : Submodule B Ω[B⁄K] := I • ⊤ with hN
  have hspan : Submodule.span K (Set.range fun i : Fin d =>
      (Submodule.Quotient.mk (b i) : Ω[B⁄K] ⧸ N)) = ⊤ := by
    rw [eq_top_iff]
    rintro q -
    obtain ⟨ω, rfl⟩ := Submodule.Quotient.mk_surjective N q
    choose k hk using fun i => hK (b.repr ω i)
    have hsub : ω - ∑ i, k i • b i ∈ N := by
      have e : ω - ∑ i, k i • b i = ∑ i, (b.repr ω i - algebraMap K B (k i)) • b i := by
        conv_lhs => rw [← b.sum_repr ω]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [sub_smul, algebraMap_smul]
      rw [e]
      exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem_smul (hk i) Submodule.mem_top
    have heq : (Submodule.Quotient.mk ω : Ω[B⁄K] ⧸ N) =
        ∑ i, k i • (Submodule.Quotient.mk (b i) : Ω[B⁄K] ⧸ N) := by
      rw [(Submodule.Quotient.eq N).mpr hsub]
      have := map_sum N.mkQ (fun i => k i • b i) Finset.univ
      simp only [Submodule.mkQ_apply, Submodule.Quotient.mk_smul] at this
      exact this
    rw [heq]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have hfd : FiniteDimensional K (Ω[B⁄K] ⧸ N) := by
    show Module.Finite K (Ω[B⁄K] ⧸ N)
    refine ⟨?_⟩
    rw [← hspan]
    exact Submodule.fg_span (Set.finite_range _)
  refine ⟨hfd, ?_⟩
  have := finrank_le_of_span_eq_top hspan
  simpa using this

theorem wc_unram_linear_choice : ∀ (K L E : Type u) [Field K] [AddCommGroup L] [Module K L]
    [AddCommGroup E] [Module K E] [FiniteDimensional K E] (d : ℕ), Module.finrank K E ≤ d →
    ∀ (ev : L →ₗ[K] K) (Φ : L →ₗ[K] E), (∃ v, ev v ≠ 0) →
    Submodule.map Φ (LinearMap.ker ev) = ⊤ →
    ∃ C : ℕ → (ℕ → L) → Submodule K L, (∀ i f g, (∀ k < i, f k = g k) → C i f = C i g) ∧
      (∀ i f, C i f ≠ ⊤) ∧ ∀ ℓ : ℕ → L, (∀ i ≤ d, ℓ i ∉ C i ℓ) →
        ev (ℓ 0) ≠ 0 ∧ Submodule.span K (Set.range fun i : Fin d =>
          ev (ℓ 0) • Φ (ℓ ((i : ℕ) + 1)) - ev (ℓ ((i : ℕ) + 1)) • Φ (ℓ 0)) = ⊤ :=
by
  intro K L E _ _ _ _ _ _ d hd ev Φ hv hΦ
  classical
  obtain ⟨v₀, hv₀⟩ := hv

  have hsurj : ∀ a : L, ev a ≠ 0 → ∀ e : E, ∃ v : L, ev a • Φ v - ev v • Φ a = e := by
    intro a ha e
    have he : e ∈ Submodule.map Φ (LinearMap.ker ev) := by rw [hΦ]; exact Submodule.mem_top
    obtain ⟨u, hu, rfl⟩ := Submodule.mem_map.mp he
    rw [LinearMap.mem_ker] at hu
    refine ⟨(ev a)⁻¹ • u, ?_⟩
    rw [map_smul, map_smul, hu, smul_zero, zero_smul, sub_zero, smul_smul,
      mul_inv_cancel₀ ha, one_smul]

  have hgrow : ∀ w : ℕ → E, (∀ i, 1 ≤ i → i ≤ d → Submodule.span K (w '' Set.Ico 1 i) ≠ ⊤ →
      w i ∉ Submodule.span K (w '' Set.Ico 1 i)) →
      Submodule.span K (Set.range fun i : Fin d => w ((i : ℕ) + 1)) = ⊤ := by
    intro w hw
    have P : ∀ j ≤ d, Submodule.span K (w '' Set.Ico 1 (j + 1)) = ⊤ ∨
        j ≤ Module.finrank K (Submodule.span K (w '' Set.Ico 1 (j + 1))) := by
      intro j
      induction j with
      | zero => intro _; right; exact Nat.zero_le _
      | succ j ih =>
        intro hj
        have hmono : Submodule.span K (w '' Set.Ico 1 (j + 1)) ≤
            Submodule.span K (w '' Set.Ico 1 (j + 1 + 1)) :=
          Submodule.span_mono (Set.image_mono (Set.Ico_subset_Ico_right (by omega)))
        by_cases htop : Submodule.span K (w '' Set.Ico 1 (j + 1)) = ⊤
        · left
          rw [eq_top_iff, ← htop]
          exact hmono
        · right
          rcases ih (by omega) with h | h
          · exact absurd h htop
          · have hnot := hw (j + 1) (by omega) (by omega) htop
            have hin : w (j + 1) ∈ Submodule.span K (w '' Set.Ico 1 (j + 1 + 1)) :=
              Submodule.subset_span ⟨j + 1, ⟨by omega, by omega⟩, rfl⟩
            have hlt : Submodule.span K (w '' Set.Ico 1 (j + 1)) <
                Submodule.span K (w '' Set.Ico 1 (j + 1 + 1)) :=
              SetLike.lt_iff_le_and_exists.mpr ⟨hmono, w (j + 1), hin, hnot⟩
            have := Submodule.finrank_lt_finrank_of_lt hlt
            omega
    have hset : (Set.range fun i : Fin d => w ((i : ℕ) + 1)) = w '' Set.Ico 1 (d + 1) := by
      ext x
      simp only [Set.mem_range, Set.mem_image, Set.mem_Ico]
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨(i : ℕ) + 1, ⟨by omega, by have := i.isLt; omega⟩, rfl⟩
      · rintro ⟨k, ⟨hk1, hk2⟩, rfl⟩
        exact ⟨⟨k - 1, by omega⟩, by show w (k - 1 + 1) = w k; rw [Nat.sub_add_cancel hk1]⟩
    rw [hset]
    rcases P d le_rfl with h | h
    · exact h
    · apply Submodule.eq_top_of_finrank_eq
      have := Submodule.finrank_le (Submodule.span K (w '' Set.Ico 1 (d + 1)))
      omega

  let Ψ : (ℕ → L) → L →ₗ[K] E := fun f => ev (f 0) • Φ - ev.smulRight (Φ (f 0))
  have hΨ : ∀ f v, Ψ f v = ev (f 0) • Φ v - ev v • Φ (f 0) := fun f v => rfl
  let S : ℕ → (ℕ → L) → Submodule K E := fun i f =>
    Submodule.span K ((fun k => ev (f 0) • Φ (f k) - ev (f k) • Φ (f 0)) '' Set.Ico 1 i)
  let C : ℕ → (ℕ → L) → Submodule K L := fun i f =>
    if i = 0 then LinearMap.ker ev
    else if Submodule.comap (Ψ f) (S i f) = ⊤ then ⊥ else Submodule.comap (Ψ f) (S i f)
  refine ⟨C, ?_, ?_, ?_⟩
  · intro i f g hfg
    rcases Nat.eq_zero_or_pos i with rfl | hi
    · simp [C]
    · have h0 : f 0 = g 0 := hfg 0 hi
      have hΨe : Ψ f = Ψ g := by
        show ev (f 0) • Φ - ev.smulRight (Φ (f 0)) = ev (g 0) • Φ - ev.smulRight (Φ (g 0))
        rw [h0]
      have hSe : S i f = S i g := by
        show Submodule.span K ((fun k => ev (f 0) • Φ (f k) - ev (f k) • Φ (f 0)) '' Set.Ico 1 i) =
          Submodule.span K ((fun k => ev (g 0) • Φ (g k) - ev (g k) • Φ (g 0)) '' Set.Ico 1 i)
        congr 1
        apply Set.image_congr
        intro k hk
        simp only [h0, hfg k hk.2]
      dsimp only [C]
      rw [hΨe, hSe]
  · intro i f htop
    dsimp only [C] at htop
    split_ifs at htop with h1 h2
    · have hm : v₀ ∈ LinearMap.ker ev := by rw [htop]; exact Submodule.mem_top
      exact hv₀ (LinearMap.mem_ker.mp hm)
    · have hm : v₀ ∈ (⊥ : Submodule K L) := by rw [htop]; exact Submodule.mem_top
      rw [Submodule.mem_bot] at hm
      exact hv₀ (by rw [hm, map_zero])
    · exact h2 htop
  · intro ℓ hℓ
    have he0 : ev (ℓ 0) ≠ 0 := by
      have h := hℓ 0 (Nat.zero_le _)
      dsimp only [C] at h
      rw [if_pos rfl, LinearMap.mem_ker] at h
      exact h
    refine ⟨he0, ?_⟩
    apply hgrow (fun k => ev (ℓ 0) • Φ (ℓ k) - ev (ℓ k) • Φ (ℓ 0))
    intro i hi1 hid hSne
    have hcomap : Submodule.comap (Ψ ℓ) (S i ℓ) ≠ ⊤ := by
      intro htop
      apply hSne
      rw [Submodule.eq_top_iff']
      intro e
      obtain ⟨v, hv⟩ := hsurj (ℓ 0) he0 e
      have hvmem : v ∈ Submodule.comap (Ψ ℓ) (S i ℓ) := by rw [htop]; exact Submodule.mem_top
      rw [Submodule.mem_comap, hΨ, hv] at hvmem
      exact hvmem
    have h := hℓ i hid
    dsimp only [C] at h
    rw [if_neg (by omega), if_neg hcomap, Submodule.mem_comap, hΨ] at h
    exact h

theorem wc_kaehler_span_of_closure : ∀ (K P C : Type u) [CommRing K] [CommRing P] [CommRing C]
    [Algebra K C] (κ : K →+* P) (ψ : P →+* C), ψ.comp κ = algebraMap K C →
    ∀ (ι : Type) (s : ι → P), Subring.closure (Set.range s ∪ Set.range κ) = ⊤ →
    (∀ c : C, ∃ p q : P, IsUnit (ψ q) ∧ c * ψ q = ψ p) →
    Submodule.span C (Set.range fun i => KaehlerDifferential.D K C (ψ (s i))) = ⊤ :=
by
  intro K P C _ _ _ _ κ ψ hκ ι s hcl hfrac
  set M : Submodule C Ω[C⁄K] :=
    Submodule.span C (Set.range fun i => KaehlerDifferential.D K C (ψ (s i))) with hM
  have hA : ∀ p : P, KaehlerDifferential.D K C (ψ p) ∈ M := by
    intro p
    have hp : p ∈ Subring.closure (Set.range s ∪ Set.range κ) := by
      rw [hcl]; exact Subring.mem_top p
    induction hp using Subring.closure_induction with
    | mem x hx =>
      rcases hx with ⟨i, rfl⟩ | ⟨k, rfl⟩
      · exact Submodule.subset_span ⟨i, rfl⟩
      · have e : ψ (κ k) = algebraMap K C k := by
          rw [← hκ]; rfl
        rw [e, Derivation.map_algebraMap]
        exact M.zero_mem
    | zero => rw [map_zero, map_zero]; exact M.zero_mem
    | one => rw [map_one, Derivation.map_one_eq_zero]; exact M.zero_mem
    | add x y _ _ hx hy => rw [map_add, map_add]; exact M.add_mem hx hy
    | neg x _ hx => rw [map_neg, map_neg]; exact M.neg_mem hx
    | mul x y _ _ hx hy =>
      rw [map_mul, Derivation.leibniz]
      exact M.add_mem (M.smul_mem _ hy) (M.smul_mem _ hx)
  have hB : ∀ c : C, KaehlerDifferential.D K C c ∈ M := by
    intro c
    obtain ⟨p, q, hu, hc⟩ := hfrac c
    have h1 : KaehlerDifferential.D K C (c * ψ q) =
        c • KaehlerDifferential.D K C (ψ q) + ψ q • KaehlerDifferential.D K C c :=
      Derivation.leibniz _ _ _
    have h2 : ψ q • KaehlerDifferential.D K C c ∈ M := by
      have e : ψ q • KaehlerDifferential.D K C c =
          KaehlerDifferential.D K C (ψ p) - c • KaehlerDifferential.D K C (ψ q) := by
        rw [← hc, h1]; abel
      rw [e]
      exact M.sub_mem (hA p) (M.smul_mem _ (hA q))
    obtain ⟨b, hb⟩ := hu.exists_left_inv
    have e : KaehlerDifferential.D K C c = b • (ψ q • KaehlerDifferential.D K C c) := by
      rw [smul_smul, hb, one_smul]
    rw [e]
    exact M.smul_mem _ h2
  rw [eq_top_iff, ← KaehlerDifferential.span_range_derivation K C, Submodule.span_le]
  rintro _ ⟨c, rfl⟩
  exact hB c

theorem wc_away_X_closure_top : ∀ (K : Type u) [Field K] (n : ℕ) (k : Fin (n + 1)),
    Subring.closure (Set.range (fun i : Fin (n + 1) => HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k)) 1
      (MvPolynomial.X i)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i))) ∪
      Set.range ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (Submonoid.powers (MvPolynomial.X k))).comp (algebraMap K _))) = ⊤ :=
by
  intro K _ n k
  classical
  have hf : (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k)
  rw [eq_top_iff]
  rintro z -
  obtain ⟨m, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hf z
  have hu : ∀ i : Fin (n + 1), HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) hf 1 (MvPolynomial.X i)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)) ∈
      Subring.closure (Set.range (fun i : Fin (n + 1) => HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k)) 1
      (MvPolynomial.X i)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i))) ∪
      Set.range ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (Submonoid.powers (MvPolynomial.X k))).comp (algebraMap K _))) :=
    fun i => Subring.subset_closure (Set.mem_union_left _ (Set.mem_range_self i))
  have hκ : ∀ c : K, ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (Submonoid.powers (MvPolynomial.X k))).comp (algebraMap K _)) c ∈
      Subring.closure (Set.range (fun i : Fin (n + 1) => HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k)) 1
      (MvPolynomial.X i)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i))) ∪
      Set.range ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (Submonoid.powers (MvPolynomial.X k))).comp (algebraMap K _))) :=
    fun c => Subring.subset_closure (Set.mem_union_right _ (Set.mem_range_self c))

  have hdeg : ∀ α ∈ p.support, ∑ i, α i = m := by
    intro α hα
    have hp' : p.IsHomogeneous (m • 1) := (MvPolynomial.mem_homogeneousSubmodule _ _).mp hp
    by_contra hne
    apply MvPolynomial.mem_support_iff.mp hα
    apply hp'.coeff_eq_zero
    rw [Finsupp.degree_eq_sum, smul_eq_mul, mul_one]
    exact hne
  have hmk : ∀ (a : MvPolynomial (Fin (n + 1)) K) (j : ℕ)
      (h : MvPolynomial.X k ^ j ∈ Submonoid.powers (MvPolynomial.X k)),
      (Localization.mk a ⟨MvPolynomial.X k ^ j, h⟩ : Localization (Submonoid.powers
        (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))) =
        algebraMap _ _ a * (Localization.mk 1 ⟨MvPolynomial.X k, Submonoid.mem_powers _⟩) ^ j := by
    intro a j h
    rw [← Localization.mk_one_eq_algebraMap, Localization.mk_pow, Localization.mk_mul]
    congr 1
    · simp
    · ext; simp
  have key : HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) hf m p hp =
      ∑ α ∈ p.support, ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (Submonoid.powers (MvPolynomial.X k))).comp (algebraMap K _)) (p.coeff α) *
        ∏ i : Fin (n + 1), (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) hf 1 (MvPolynomial.X i)
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr
            (MvPolynomial.isHomogeneous_X K i))) ^ (α i) := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply, map_sum]
    simp only [map_mul, map_prod, map_pow, HomogeneousLocalization.algebraMap_apply,
      HomogeneousLocalization.Away.val_mk]
    have hκv : ∀ c : K, (((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (Submonoid.powers (MvPolynomial.X k))).comp (algebraMap K _)) c).val =
        algebraMap (MvPolynomial (Fin (n + 1)) K) (Localization (Submonoid.powers
          (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
          (MvPolynomial.C c : MvPolynomial (Fin (n + 1)) K) := by
      intro c
      rw [← Localization.mk_one_eq_algebraMap]
      rfl
    simp only [hκv, hmk]
    conv_lhs => rw [MvPolynomial.as_sum p]
    rw [map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun α hα => ?_)
    rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun i => pow_zero _)]
    simp only [map_mul, map_prod, map_pow, pow_one, mul_pow, Finset.prod_mul_distrib,
      Finset.prod_pow_eq_pow_sum, hdeg α hα, mul_assoc]
  rw [key]
  exact Subring.sum_mem _ (fun α _ => Subring.mul_mem _ (hκ _)
    (Subring.prod_mem _ (fun i _ => Subring.pow_mem _ (hu i) _)))

theorem wc_unram_span_transfer : ∀ (K B B₁ : Type u) [Field K] [CommRing B] [CommRing B₁]
    [Algebra K B] [Algebra K B₁] [Algebra B B₁] [IsScalarTower K B B₁] (ε : B →+* K),
    (∀ c : K, ε (algebraMap K B c) = c) → ∀ (a₀ : B), ε a₀ ≠ 0 → IsLocalization.Away a₀ B₁ →
    ∀ (n : ℕ) (y : Fin n → B) (t : Fin n → B₁),
    (∀ i, t i * algebraMap B B₁ a₀ = algebraMap B B₁ (y i)) →
    (⊤ : Submodule B Ω[B⁄K]) ≤ Submodule.span B (Set.range fun i =>
      ε a₀ • KaehlerDifferential.D K B (y i) - ε (y i) • KaehlerDifferential.D K B a₀) ⊔
      (RingHom.ker ε) • ⊤ →
    (⊤ : Submodule B₁ Ω[B₁⁄K]) ≤ Submodule.span B₁ (Set.range fun i =>
      KaehlerDifferential.D K B₁ (t i)) ⊔ (Ideal.map (algebraMap B B₁) (RingHom.ker ε)) • ⊤ :=
by
  intro K B B₁ _ _ _ _ _ _ _ ε hε a₀ _ hloc n y t ht hH
  haveI := hloc
  set M : Submodule B₁ Ω[B₁⁄K] := Submodule.span B₁ (Set.range fun i =>
      KaehlerDifferential.D K B₁ (t i)) ⊔ (Ideal.map (algebraMap B B₁) (RingHom.ker ε)) • ⊤
    with hM
  have hD : ∀ b : B, KaehlerDifferential.map K K B B₁ (KaehlerDifferential.D K B b) =
      KaehlerDifferential.D K B₁ (algebraMap B B₁ b) :=
    fun b => KaehlerDifferential.map_D K K B B₁ b
  obtain ⟨v, hv⟩ := (IsLocalization.Away.algebraMap_isUnit (S := B₁) a₀).exists_left_inv
  have hμK : ∀ (c : K) (ω : Ω[B⁄K]), KaehlerDifferential.map K K B B₁ (c • ω) =
      algebraMap K B₁ c • KaehlerDifferential.map K K B B₁ ω := by
    intro c ω
    rw [← algebraMap_smul B c ω, map_smul,
      ← algebraMap_smul B₁ (algebraMap K B c) (KaehlerDifferential.map K K B B₁ ω),
      ← IsScalarTower.algebraMap_apply]

  have hgen : ∀ i, KaehlerDifferential.map K K B B₁
      (ε a₀ • KaehlerDifferential.D K B (y i) - ε (y i) • KaehlerDifferential.D K B a₀) ∈ M := by
    intro i
    have e1 : KaehlerDifferential.map K K B B₁
        (ε a₀ • KaehlerDifferential.D K B (y i) - ε (y i) • KaehlerDifferential.D K B a₀) =
        (algebraMap K B₁ (ε a₀) * algebraMap B B₁ a₀) • KaehlerDifferential.D K B₁ (t i) +
        (algebraMap K B₁ (ε a₀) * t i - algebraMap K B₁ (ε (y i))) •
          KaehlerDifferential.D K B₁ (algebraMap B B₁ a₀) := by
      rw [map_sub, hμK, hμK, hD, hD, ← ht i, Derivation.leibniz]
      simp only [smul_add, smul_smul, sub_smul]
      abel
    have hs : algebraMap K B₁ (ε a₀) * t i - algebraMap K B₁ (ε (y i)) ∈
        Ideal.map (algebraMap B B₁) (RingHom.ker ε) := by
      have hz : algebraMap K B (ε a₀) * y i - algebraMap K B (ε (y i)) * a₀ ∈ RingHom.ker ε := by
        rw [RingHom.mem_ker, map_sub, map_mul, map_mul, hε, hε]; ring
      have h1 := Ideal.mul_mem_left (Ideal.map (algebraMap B B₁) (RingHom.ker ε)) v
        (Ideal.mem_map_of_mem (algebraMap B B₁) hz)
      convert h1 using 1
      rw [map_sub, map_mul, map_mul, ← IsScalarTower.algebraMap_apply,
        ← IsScalarTower.algebraMap_apply, ← ht i]
      linear_combination (-(algebraMap K B₁ (ε a₀) * t i - algebraMap K B₁ (ε (y i)))) * hv
    rw [e1, hM]
    refine Submodule.add_mem_sup ?_ ?_
    · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    · exact Submodule.smul_mem_smul hs Submodule.mem_top

  have hker : ∀ r ∈ RingHom.ker ε, ∀ ω : Ω[B⁄K],
      KaehlerDifferential.map K K B B₁ (r • ω) ∈ M := by
    intro r hr ω
    rw [map_smul, ← algebraMap_smul B₁ r (KaehlerDifferential.map K K B B₁ ω), hM]
    exact Submodule.mem_sup_right
      (Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hr) Submodule.mem_top)

  have key : (⊤ : Submodule B Ω[B⁄K]) ≤
      (M.restrictScalars B).comap (KaehlerDifferential.map K K B B₁) := by
    refine hH.trans (sup_le ?_ ?_)
    · rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact hgen i
    · refine Submodule.smul_le.mpr ?_
      intro r hr ω _
      exact hker r hr ω
  have hDφ : ∀ b : B, KaehlerDifferential.D K B₁ (algebraMap B B₁ b) ∈ M := fun b => by
    rw [← hD b]
    exact key Submodule.mem_top

  rw [← KaehlerDifferential.span_range_derivation K B₁, Submodule.span_le]
  rintro _ ⟨b₁, rfl⟩
  obtain ⟨x, hbs⟩ := IsLocalization.surj (Submonoid.powers a₀) b₁
  obtain ⟨w, hw⟩ := (IsLocalization.map_units B₁ x.2).exists_left_inv
  have h1 : (algebraMap B B₁ (x.2 : B)) • KaehlerDifferential.D K B₁ b₁ ∈ M := by
    have e : (algebraMap B B₁ (x.2 : B)) • KaehlerDifferential.D K B₁ b₁ =
        KaehlerDifferential.D K B₁ (algebraMap B B₁ x.1) -
          b₁ • KaehlerDifferential.D K B₁ (algebraMap B B₁ (x.2 : B)) := by
      rw [← hbs, Derivation.leibniz]
      abel
    rw [e]
    exact M.sub_mem (hDφ x.1) (M.smul_mem _ (hDφ _))
  have e2 : KaehlerDifferential.D K B₁ b₁ =
      w • (algebraMap B B₁ (x.2 : B)) • KaehlerDifferential.D K B₁ b₁ := by
    rw [smul_smul, hw, one_smul]
  rw [SetLike.mem_coe, e2]
  exact M.smul_mem _ h1

theorem wc_unram_linear_data : ∀ (K B L : Type u) [Field K] [CommRing B] [Algebra K B]
    [AddCommGroup L] [Module K L] (ε : B →+* K), (∀ c, ε (algebraMap K B c) = c) →
    ∀ (lam : L →ₗ[K] B) (v₀ : L), lam v₀ = 1 → ∀ (ι : Type) (gens : ι → L),
    Submodule.span B (Set.range fun i => KaehlerDifferential.D K B (lam (gens i))) = ⊤ →
    ∃ (ev : L →ₗ[K] K) (Φ : L →ₗ[K] (Ω[B⁄K] ⧸ ((RingHom.ker ε) • ⊤ : Submodule B Ω[B⁄K]))),
      (∀ v, ev v = ε (lam v)) ∧
      (∀ v, Φ v = Submodule.Quotient.mk (KaehlerDifferential.D K B (lam v))) ∧
      ev v₀ ≠ 0 ∧ Submodule.map Φ (LinearMap.ker ev) = ⊤ :=
by
  intro K B L _ _ _ _ _ ε hε lam v₀ hv₀ ι gens hspan
  classical
  set P : Submodule B Ω[B⁄K] := (RingHom.ker ε) • ⊤ with hP
  let ev : L →ₗ[K] K :=
    { toFun := fun v => ε (lam v)
      map_add' := fun v w => by rw [map_add, map_add]
      map_smul' := fun c v => by
        rw [map_smul, Algebra.smul_def, map_mul, hε, RingHom.id_apply, smul_eq_mul] }
  let Φ : L →ₗ[K] (Ω[B⁄K] ⧸ P) :=
    { toFun := fun v => Submodule.Quotient.mk (KaehlerDifferential.D K B (lam v))
      map_add' := fun v w => by rw [map_add, map_add, Submodule.Quotient.mk_add]
      map_smul' := fun c v => by
        rw [map_smul, Derivation.map_smul, Submodule.Quotient.mk_smul, RingHom.id_apply] }
  have hev1 : ev v₀ = 1 := by
    show ε (lam v₀) = 1
    rw [hv₀, map_one]
  have hΦ0 : Φ v₀ = 0 := by
    show Submodule.Quotient.mk (KaehlerDifferential.D K B (lam v₀)) = (0 : Ω[B⁄K] ⧸ P)
    rw [hv₀, Derivation.map_one_eq_zero, Submodule.Quotient.mk_zero]
  have key : ∀ (a : B) (x : Ω[B⁄K]),
      (Submodule.Quotient.mk (a • x) : Ω[B⁄K] ⧸ P) = (ε a) • Submodule.Quotient.mk x := by
    intro a x
    have hmem : (a - algebraMap K B (ε a)) • x ∈ P :=
      Submodule.smul_mem_smul (by rw [RingHom.mem_ker, map_sub, hε, sub_self]) Submodule.mem_top
    rw [← Submodule.Quotient.mk_smul, ← sub_eq_zero, ← Submodule.Quotient.mk_sub,
      Submodule.Quotient.mk_eq_zero, ← algebraMap_smul B (ε a) x, ← sub_smul]
    exact hmem
  have hgen : ∀ i, (Submodule.Quotient.mk (KaehlerDifferential.D K B (lam (gens i))) :
      Ω[B⁄K] ⧸ P) ∈ Submodule.map Φ (LinearMap.ker ev) := by
    intro i
    refine Submodule.mem_map.mpr ⟨gens i - ev (gens i) • v₀, ?_, ?_⟩
    · rw [LinearMap.mem_ker, map_sub, map_smul, hev1, smul_eq_mul, mul_one, sub_self]
    · rw [map_sub, map_smul, hΦ0, smul_zero, sub_zero]
      rfl
  refine ⟨ev, Φ, fun _ => rfl, fun _ => rfl, by rw [hev1]; exact one_ne_zero, ?_⟩
  rw [Submodule.eq_top_iff']
  intro y
  obtain ⟨ω, rfl⟩ := Submodule.Quotient.mk_surjective P y
  have hω : ω ∈ Submodule.span B
      (Set.range fun i => KaehlerDifferential.D K B (lam (gens i))) := by
    rw [hspan]; exact Submodule.mem_top
  induction hω using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact hgen i
  | zero =>
    rw [Submodule.Quotient.mk_zero]
    exact Submodule.zero_mem _
  | add x z _ _ hx hz =>
    rw [Submodule.Quotient.mk_add]
    exact Submodule.add_mem _ hx hz
  | smul a x _ hx =>
    rw [key]
    exact Submodule.smul_mem _ _ hx

theorem wc_away_mk_one_linear : ∀ (K : Type u) [Field K] (N : ℕ) (f : MvPolynomial (Fin (N + 1)) K)
    (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1)
    (m m' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) (c : K),
    HomogeneousLocalization.Away.mk _ hf 1
        ((m + m' : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) :
          MvPolynomial (Fin (N + 1)) K) (m + m').2 =
      HomogeneousLocalization.Away.mk _ hf 1 m m.2 +
        HomogeneousLocalization.Away.mk _ hf 1 m' m'.2 ∧
    HomogeneousLocalization.Away.mk _ hf 1
        ((c • m : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) :
          MvPolynomial (Fin (N + 1)) K) (c • m).2 =
      HomogeneousLocalization.fromZeroRingHom _ (Submonoid.powers f) (algebraMap K _ c) *
        HomogeneousLocalization.Away.mk _ hf 1 m m.2 ∧
    HomogeneousLocalization.Away.mk _ hf 1 f hf = 1 :=
by
  intro K _ N f hf m m' c
  refine ⟨?_, ?_, ?_⟩
  · apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_add, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      Localization.add_mk_self]
    rfl
  · apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk]
    have h0 : (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers f)
        (algebraMap K _ c)).val =
        Localization.mk (algebraMap K (MvPolynomial (Fin (N + 1)) K) c) 1 := by
      rfl
    rw [h0, Localization.mk_mul, one_mul, Submodule.coe_smul, Algebra.smul_def]
  · apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
    convert Localization.mk_self _ using 2
    simp

theorem wc_unram_section_K_compat : ∀ (K : Type u) [Field K] (N : ℕ) (Y' : Scheme.{u})
    (j : Y' ⟶ wcProjK K N) (h : MvPolynomial (Fin (N + 1)) K) (O : Y'.Opens)
    (hO : O ≤ j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) h) (r : K),
    wcUnSec K N j h O hO (HomogeneousLocalization.fromZeroRingHom _ (Submonoid.powers h)
      (algebraMap K _ r)) = wcUnK K N j O r :=
by
  intro K _ N Y' j h O hO r
  have gen : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] {R : Type u} [CommRing R] (φ : R →+* 𝒜 0) (Y' : Scheme.{u})
      (j : Y' ⟶ Proj 𝒜) (h : A) (O : Y'.Opens)
      (hO : O ≤ j ⁻¹ᵁ Proj.basicOpen 𝒜 h) (r : R)
      (e : O ≤ (j ≫ Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ ⊤),
      (j.appLE (Proj.basicOpen 𝒜 h) O hO).hom
        ((Proj.awayToSection 𝒜 h).hom
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers h) (φ r))) =
      ((j ≫ Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom φ)).appLE ⊤ O e).hom
        ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r) := by
    intro σ A _ _ _ 𝒜 _ R _ φ Y' j h O hO r e

    have s1 : ∀ {X Z : Scheme.{u}} {f g : X ⟶ Z} (_ : f = g) (U : Z.Opens) (V : X.Opens)
        (e : V ≤ f ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U), f.appLE U V e = g.appLE U V e' := by
      intro X Z f g hfg U V e e'
      subst hfg
      rfl

    have s3 : ∀ (a : 𝒜 0) (g f : A) (hfg : Proj.basicOpen 𝒜 f ≤ Proj.basicOpen 𝒜 g),
        ((Proj 𝒜).presheaf.map (homOfLE hfg).op).hom
          ((Proj.awayToSection 𝒜 g).hom
            (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers g) a)) =
        (Proj.awayToSection 𝒜 f).hom
            (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) a) := by
      intro a g f hfg
      apply Proj.ext
      funext x
      erw [Proj.res_apply]

    have hm : ((Proj 𝒜).topIso.inv ≫ ((Proj 𝒜).isoOfEq (Proj.basicOpen_one 𝒜)).inv) ≫
        (Proj.basicOpen 𝒜 1).ι = 𝟙 _ := by
      rw [Category.assoc, Scheme.isoOfEq_inv_ι, Scheme.toIso_inv_ι]
    have hlast : (Proj.basicOpen 𝒜 1).topIso.inv ≫
        (((Proj 𝒜).topIso.inv ≫ ((Proj 𝒜).isoOfEq (Proj.basicOpen_one 𝒜)).inv)).appTop =
        (Proj 𝒜).presheaf.map (homOfLE (Proj.basicOpen_one 𝒜).ge).op := by
      set m := ((Proj 𝒜).topIso.inv ≫ ((Proj 𝒜).isoOfEq (Proj.basicOpen_one 𝒜)).inv) with hm_def
      have hT : (Proj.basicOpen 𝒜 1).topIso.inv =
          (Proj.basicOpen 𝒜 1).ι.appLE (Proj.basicOpen 𝒜 1) ⊤
            (le_of_eq (Scheme.Opens.ι_preimage_self _).symm) := by
        rw [Scheme.Opens.topIso_inv, Scheme.Opens.ι_appLE]
        rfl
      have e2 : (⊤ : (Proj 𝒜).Opens) ≤ m ⁻¹ᵁ ⊤ := (Scheme.Hom.preimage_top m).ge
      have hA : m.appTop = m.appLE ⊤ ⊤ e2 := (Scheme.Hom.appLE_eq_app m).symm
      have hC := Scheme.Hom.appLE_comp_appLE m (Proj.basicOpen 𝒜 1).ι (Proj.basicOpen 𝒜 1) ⊤ ⊤
        (le_of_eq (Scheme.Opens.ι_preimage_self _).symm) e2
      have e3 : (⊤ : (Proj 𝒜).Opens) ≤ (𝟙 (Proj 𝒜)) ⁻¹ᵁ (Proj.basicOpen 𝒜 1) := by
        intro x hx
        exact (Proj.basicOpen_one 𝒜).ge hx
      rw [hT, hA, hC, s1 hm _ _ _ e3]
      simp only [Scheme.Hom.appLE, Scheme.Hom.id_app]
      rfl
    have key : (Scheme.ΓSpecIso (CommRingCat.of (𝒜 0))).inv ≫ (Proj.toSpecZero 𝒜).appTop =
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers 1)) ≫
          Proj.awayToSection 𝒜 1 ≫
            (Proj 𝒜).presheaf.map (homOfLE (Proj.basicOpen_one 𝒜).ge).op := by
      have hB : (Proj.basicOpenToSpec 𝒜 1).appTop =
          (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 1))).hom ≫
            Proj.awayToSection 𝒜 1 ≫ (Proj.basicOpen 𝒜 1).topIso.inv :=
        Proj.basicOpenToSpec_app_top 𝒜 1
      rw [← hlast, Proj.toSpecZero.eq_1]
      simp only [Scheme.Hom.comp_appTop, Category.assoc]
      rw [← Category.assoc (Scheme.ΓSpecIso _).inv, ← Scheme.ΓSpecIso_inv_naturality, hB]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    have key2 : (Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
        (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom φ)).appTop =
        CommRingCat.ofHom φ ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers 1)) ≫
          Proj.awayToSection 𝒜 1 ≫
            (Proj 𝒜).presheaf.map (homOfLE (Proj.basicOpen_one 𝒜).ge).op := by
      rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
        Category.assoc, key]
    have k2 := congrArg (fun ψ => ψ.hom r) key2
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at k2
    have hD1 : Proj.basicOpen 𝒜 h ≤ Proj.basicOpen 𝒜 1 := by
      rw [Proj.basicOpen_one]; exact le_top
    have hcomb : ∀ s, ((Proj 𝒜).presheaf.map (homOfLE (le_top : Proj.basicOpen 𝒜 h ≤ ⊤)).op).hom
        (((Proj 𝒜).presheaf.map (homOfLE (Proj.basicOpen_one 𝒜).ge).op).hom s) =
        ((Proj 𝒜).presheaf.map (homOfLE hD1).op).hom s := by
      intro s
      rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
      rfl
    have hmap : j.appLE ((Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ ⊤) O e =
        (Proj 𝒜).presheaf.map (homOfLE (le_top : Proj.basicOpen 𝒜 h ≤ ⊤)).op ≫
          j.appLE (Proj.basicOpen 𝒜 h) O hO :=
      (Scheme.Hom.map_appLE _ _ _).symm
    rw [Scheme.Hom.comp_appLE, hmap]
    show _ = (j.appLE _ O hO).hom (((Proj 𝒜).presheaf.map (homOfLE le_top).op).hom
      ((Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom φ)).appTop.hom
        ((Scheme.ΓSpecIso _).inv.hom r)))
    refine congrArg (j.appLE _ O hO).hom ?_
    rw [k2, hcomb, s3]
  show (Proj.awayToSection _ h ≫ j.appLE _ O hO).hom _ =
    ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ (j ≫ wcProjKStr K N).appLE ⊤ O
        (le_top.trans_eq (Scheme.Hom.preimage_top _).symm)).hom r
  simp only [CommRingCat.hom_comp, RingHom.comp_apply]
  exact gen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
    (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) Y' j h O hO r
    (le_top.trans_eq (Scheme.Hom.preimage_top _).symm)

theorem wc_unram_eval_rational_point : ∀ (K : Type u) [Field K] (N : ℕ) (Y' : Scheme.{u})
    (j : Y' ⟶ wcProjK K N) (y₁ : Spec (.of K) ⟶ Y'),
    (∀ (O : Y'.Opens) (hO : y₁ (IsLocalRing.closedPoint K) ∈ O) (f : Γ(Y', O)),
      y₁ (IsLocalRing.closedPoint K) ∈ Y'.basicOpen f ↔ wcUnEv K y₁ O hO f ≠ 0) ∧
    (∀ (O O' : Y'.Opens) (hO : y₁ (IsLocalRing.closedPoint K) ∈ O)
      (hO' : y₁ (IsLocalRing.closedPoint K) ∈ O') (hle : O' ≤ O) (f : Γ(Y', O)),
      wcUnEv K y₁ O' hO' ((Y'.presheaf.map (homOfLE hle).op).hom f) = wcUnEv K y₁ O hO f) ∧
    (y₁ ≫ j ≫ wcProjKStr K N = 𝟙 _ → ∀ (O : Y'.Opens) (hO : y₁ (IsLocalRing.closedPoint K) ∈ O)
      (r : K), wcUnEv K y₁ O hO (wcUnK K N j O r) = r) :=
by
  intro K _ N Y' j y₁
  have hΓ : ∀ x : Γ(Spec (.of K), ⊤),
      (Scheme.ΓSpecIso (.of K)).inv.hom ((Scheme.ΓSpecIso (.of K)).hom.hom x) = x := by
    intro x
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.hom_inv_id]
    rfl
  refine ⟨?_, ?_, ?_⟩
  · intro O hO f
    have he : (⊤ : (Spec (.of K)).Opens) ≤ y₁ ⁻¹ᵁ O := by
      intro x _
      show y₁ x ∈ O
      rw [Subsingleton.elim x (IsLocalRing.closedPoint K)]
      exact hO
    show _ ↔ (Scheme.ΓSpecIso (.of K)).hom.hom ((y₁.appLE O ⊤ he).hom f) ≠ 0
    have hb : (Spec (.of K)).basicOpen ((y₁.appLE O ⊤ he).hom f) = ⊤ ⊓ y₁ ⁻¹ᵁ Y'.basicOpen f :=
      Scheme.basicOpen_appLE _ _ _ _ _
    have hmem : y₁ (IsLocalRing.closedPoint K) ∈ Y'.basicOpen f ↔
        IsLocalRing.closedPoint K ∈ (Spec (.of K)).basicOpen ((y₁.appLE O ⊤ he).hom f) := by
      rw [hb]; exact ⟨fun h => ⟨trivial, h⟩, fun h => h.2⟩
    rw [hmem]
    generalize (y₁.appLE O ⊤ he).hom f = s
    constructor
    · intro h h0
      have : s = 0 := by rw [← hΓ s, h0, map_zero]
      rw [this, Scheme.basicOpen_zero] at h
      exact h
    · intro h
      have hu : IsUnit s := by
        rw [← hΓ s]
        exact (Ne.isUnit h).map _
      rw [Scheme.basicOpen_of_isUnit _ hu]
      trivial
  · intro O O' hO hO' hle f
    unfold wcUnEv
    generalize_proofs h1 h2
    have key : Y'.presheaf.map (homOfLE hle).op ≫ y₁.appLE O' ⊤ h1 = y₁.appLE O ⊤ h2 :=
      Scheme.Hom.map_appLE _ _ _
    rw [← key]
    rfl
  · intro hid O hO r
    unfold wcUnEv wcUnK
    generalize_proofs h1 h2
    have aux : ∀ (h : Spec (.of K) ⟶ Spec (.of K)) (e : (⊤ : (Spec (.of K)).Opens) ≤ h ⁻¹ᵁ ⊤),
        h = 𝟙 _ → h.appLE ⊤ ⊤ e = 𝟙 _ := by
      intro h e hh
      subst hh
      simp only [Scheme.Hom.appLE, Scheme.Hom.id_app]
      exact (Spec (.of K)).presheaf.map_id _
    have key : (j ≫ wcProjKStr K N).appLE ⊤ O h2 ≫ y₁.appLE O ⊤ h1 = 𝟙 _ := by
      rw [Scheme.Hom.appLE_comp_appLE]
      exact aux _ _ (by rw [hid])
    show ((Scheme.ΓSpecIso (.of K)).inv ≫ (j ≫ wcProjKStr K N).appLE ⊤ O h2 ≫
      y₁.appLE O ⊤ h1 ≫ (Scheme.ΓSpecIso (.of K)).hom).hom r = r
    rw [reassoc_of% key, Iso.inv_hom_id]
    rfl

theorem wc_unram_chart_fraction : ∀ (K : Type u) [Field K] (N : ℕ) (Y' : Scheme.{u})
    (j : Y' ⟶ wcProjK K N), IsClosedImmersion j → ∀ (k : Fin (N + 1))
    (g : Γ(Y', j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (MvPolynomial.X k))) (c : Γ(Y', Y'.basicOpen g)),
    ∃ p q, IsUnit (wcUnSec K N j (MvPolynomial.X k) (Y'.basicOpen g) (Y'.basicOpen_le g) q) ∧
      c * wcUnSec K N j (MvPolynomial.X k) (Y'.basicOpen g) (Y'.basicOpen_le g) q =
        wcUnSec K N j (MvPolynomial.X k) (Y'.basicOpen g) (Y'.basicOpen_le g) p :=
by
  intro K _ N Y' j hj k g c
  haveI := hj
  have hdeg : (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k)
  have hDaff : IsAffineOpen (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (MvPolynomial.X k)) := Proj.isAffineOpen_basicOpen _ _ hdeg one_pos
  have hjs := j.app_surjective _ hDaff
  have hτs : Function.Surjective (Proj.awayToSection
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X k)).hom := by
    intro s
    refine ⟨(Proj.basicOpenIsoAway _ _ hdeg one_pos).inv.hom s, ?_⟩
    have h1 := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ _ hdeg one_pos) s
    rw [Proj.basicOpenIsoAway_hom] at h1
    exact h1
  have hσU : Function.Surjective (wcUnSec K N j (MvPolynomial.X k) _ le_rfl) := by
    have e : wcUnSec K N j (MvPolynomial.X k) _ le_rfl =
        (j.app _).hom.comp (Proj.awayToSection
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X k)).hom := by
      simp only [wcUnSec, Scheme.Hom.appLE_eq_app, CommRingCat.hom_comp]
    rw [e]
    exact hjs.comp hτs
  have hUaff := hDaff.preimage j
  haveI := hUaff.isLocalization_basicOpen g
  obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj g c
  obtain ⟨p, hp⟩ := hσU a
  obtain ⟨q, hq⟩ := hσU (g ^ n)
  have hres : ∀ z, wcUnSec K N j (MvPolynomial.X k) (Y'.basicOpen g) (Y'.basicOpen_le g) z =
      algebraMap _ Γ(Y', Y'.basicOpen g) (wcUnSec K N j (MvPolynomial.X k) _ le_rfl z) := by
    intro z
    show _ = (Y'.presheaf.map (homOfLE (Y'.basicOpen_le g)).op).hom _
    simp only [wcUnSec]
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Category.assoc, Scheme.Hom.appLE_map]
  refine ⟨p, q, ?_, ?_⟩
  · rw [hres, hq, map_pow]
    exact IsLocalization.Away.algebraMap_pow_isUnit g n
  · rw [hres, hres, hq, hp, map_pow]
    exact ha

theorem wc_unram_basicOpen_section_le : ∀ (K : Type u) [Field K] (N : ℕ) (Y' : Scheme.{u})
    (j : Y' ⟶ wcProjK K N) (h : MvPolynomial (Fin (N + 1)) K)
    (hh : h ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) (O : Y'.Opens)
    (hO : O ≤ j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) h)
    (m : MvPolynomial (Fin (N + 1)) K) (hm : m ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1),
    Y'.basicOpen (wcUnSec K N j h O hO (HomogeneousLocalization.Away.mk _ hh 1 m hm)) ≤
      j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) m :=
by
  have PF : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ)
      [GradedRing 𝒜] (h : A) (hh : h ∈ 𝒜 1) (m : A) (hm : m ∈ 𝒜 1),
      (Proj 𝒜).basicOpen ((Proj.awayToSection 𝒜 h).hom
        (HomogeneousLocalization.Away.mk 𝒜 hh 1 m hm)) ≤ Proj.basicOpen 𝒜 m := by
    intro σ A _ _ _ 𝒜 _ h hh m hm
    set U := Proj.basicOpen 𝒜 h with hU
    set r := HomogeneousLocalization.Away.mk 𝒜 hh 1 m hm with hr
    set x := (Proj.awayToSection 𝒜 h).hom r with hx
    have h1 : (Proj 𝒜).basicOpen x = U.ι ''ᵁ (U : Scheme).basicOpen (U.topIso.inv.hom x) := by
      have h1a := Scheme.Opens.ι_image_basicOpen U (U.topIso.inv.hom x)
      have h1b : (Proj 𝒜).basicOpen (((Proj 𝒜).presheaf.map
          (eqToHom (Scheme.Opens.ι_image_top U)).op).hom x) = (Proj 𝒜).basicOpen x :=
        Scheme.basicOpen_res_eq _ _ _
      rw [h1a, ← h1b]
      rfl
    have e : (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 h))).hom.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 h))).inv.hom r) = r :=
      Iso.inv_hom_id_apply _ _
    have h2 : (Proj.basicOpenToSpec 𝒜 h).appTop.hom ((Scheme.ΓSpecIso _).inv.hom r) =
        U.topIso.inv.hom x := by
      show ((Proj.basicOpenToSpec 𝒜 h).app ⊤).hom ((Scheme.ΓSpecIso _).inv.hom r) = _
      rw [Proj.basicOpenToSpec_app_top]
      show U.topIso.inv.hom ((Proj.awayToSection 𝒜 h).hom
        ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 h))).hom.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 h))).inv.hom r))) = _
      rw [e]
    have hloc : HomogeneousLocalization.Away.isLocalizationElem hh hm = r := by
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.Away.isLocalizationElem, hr,
        HomogeneousLocalization.Away.val_mk, pow_one]
    have h4 : Proj.basicOpenToSpec 𝒜 h ≫ Proj.awayι 𝒜 h hh one_pos = U.ι := by
      rw [← Proj.basicOpenIsoSpec_inv_ι 𝒜 h hh one_pos, ← Proj.basicOpenIsoSpec_hom 𝒜 h hh one_pos,
        Iso.hom_inv_id_assoc]
    have h3 : (U : Scheme).basicOpen (U.topIso.inv.hom x) = U.ι ⁻¹ᵁ Proj.basicOpen 𝒜 m := by
      rw [← h2, ← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine, ← h4,
        Scheme.Hom.comp_preimage, Proj.awayι_preimage_basicOpen 𝒜 hh one_pos hm one_pos, hloc]
    rw [h1, h3]
    exact Scheme.Hom.image_preimage_le U.ι _
  intro K _ N Y' j h hh O hO m hm
  have key := PF (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) h hh m hm
  show Y'.basicOpen ((j.appLE _ O hO).hom ((Proj.awayToSection _ h).hom
    (HomogeneousLocalization.Away.mk _ hh 1 m hm))) ≤ _
  rw [Scheme.basicOpen_appLE]
  exact inf_le_right.trans (Scheme.Hom.preimage_mono j key)

theorem wc_unram_section_ratio : ∀ (K : Type u) [Field K] (N : ℕ) (Y' : Scheme.{u})
    (j : Y' ⟶ wcProjK K N) (h₁ h₂ m : MvPolynomial (Fin (N + 1)) K)
    (hh₁ : h₁ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1)
    (hh₂ : h₂ ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1)
    (hm : m ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) (O : Y'.Opens)
    (hO₁ : O ≤ j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) h₁)
    (hO₂ : O ≤ j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) h₂),
    wcUnSec K N j h₁ O hO₁ (HomogeneousLocalization.Away.mk _ hh₁ 1 m hm) =
      wcUnSec K N j h₂ O hO₂ (HomogeneousLocalization.Away.mk _ hh₂ 1 m hm) *
        wcUnSec K N j h₁ O hO₁ (HomogeneousLocalization.Away.mk _ hh₁ 1 h₂ hh₂) :=
by
  intro K _ N Y' j h₁ h₂ m hh₁ hh₂ hm O hO₁ hO₂
  have hO : O ≤ j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (h₁ * h₂) := by
    rw [Proj.basicOpen_mul, Scheme.Hom.preimage_inf]
    exact le_inf hO₁ hO₂
  have key : ∀ (f g : MvPolynomial (Fin (N + 1)) K)
      (hg : g ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) (hx : h₁ * h₂ = f * g)
      (hOf : O ≤ j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) f)
      (z : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) f),
      wcUnSec K N j f O hOf z =
        wcUnSec K N j (h₁ * h₂) O hO (HomogeneousLocalization.awayMap _ hg hx z) := by
    intro f g hg hx hOf z
    show (Proj.awayToSection _ f ≫ j.appLE _ O hOf).hom z =
      (Proj.awayToSection _ (h₁ * h₂) ≫ j.appLE _ O hO).hom
        ((CommRingCat.ofHom (HomogeneousLocalization.awayMap _ hg hx)).hom z)
    rw [← CommRingCat.comp_apply, ← Category.assoc, Proj.awayMap_awayToSection, Category.assoc,
      Scheme.Hom.map_appLE]
  have hid : HomogeneousLocalization.awayMap _ hh₂ (rfl : h₁ * h₂ = h₁ * h₂)
        (HomogeneousLocalization.Away.mk _ hh₁ 1 m hm) =
      HomogeneousLocalization.awayMap _ hh₁ (mul_comm h₁ h₂)
          (HomogeneousLocalization.Away.mk _ hh₂ 1 m hm) *
        HomogeneousLocalization.awayMap _ hh₂ (rfl : h₁ * h₂ = h₁ * h₂)
          (HomogeneousLocalization.Away.mk _ hh₁ 1 h₂ hh₂) := by
    rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
      HomogeneousLocalization.awayMap_mk]
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [Submonoid.coe_mul, OneMemClass.coe_one, one_mul, pow_one]
    ring
  rw [key h₁ h₂ hh₂ rfl hO₁, key h₂ h₁ hh₁ (mul_comm h₁ h₂) hO₂, key h₁ h₂ hh₂ rfl hO₁,
    ← map_mul, hid]

theorem wc_unram_smooth_basic_chart : ∀ (K : Type u) [Field K] (N d : ℕ) (Y' : Scheme.{u})
    (j : Y' ⟶ wcProjK K N), IsClosedImmersion j → ∀ (y₁ : Spec (.of K) ⟶ Y'),
    y₁ ≫ j ≫ wcProjKStr K N = 𝟙 _ → ∀ (V : Y'.Opens), y₁ (IsLocalRing.closedPoint K) ∈ V →
    SmoothOfRelativeDimension d (V.ι ≫ j ≫ wcProjKStr K N) →
    ∃ (k : Fin (N + 1)) (g : Γ(Y', j ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X k))),
      IsAffineOpen (Y'.basicOpen g) ∧ y₁ (IsLocalRing.closedPoint K) ∈ Y'.basicOpen g ∧
      Y'.basicOpen g ≤ V ∧
      @Algebra.IsStandardSmoothOfRelativeDimension d K Γ(Y', Y'.basicOpen g) _ _
        (wcUnK K N j (Y'.basicOpen g)).toAlgebra :=
by
  intro K _ N d Y' j hj y₁ _ V hV hVsm
  classical
  haveI := hj
  haveI := hVsm

  have c4 : ∀ z : wcProjK K N, ∃ i : Fin (N + 1), z ∈ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) := by
    intro z
    by_contra hz
    push_neg at hz
    apply z.not_irrelevant_le
    intro a ha
    have hi : ∀ i, MvPolynomial.X i ∈ z.asHomogeneousIdeal.toIdeal := fun i => by
      have := hz i
      rw [Proj.mem_basicOpen, not_not] at this
      exact HomogeneousIdeal.mem_iff.mpr this
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha
    have ha' : MvPolynomial.homogeneousComponent 0 a = 0 :=
      (MvPolynomial.decomposition.decompose'_apply a 0).symm.trans ha
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha'
    have hspan : a ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra hc
      push_neg at hc
      have hm0 : m = 0 := Finsupp.ext fun i => hc i (Set.mem_univ i)
      rw [hm0] at hm
      exact (MvPolynomial.mem_support_iff.mp hm) ha'
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) ≤
        z.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨i, _, rfl⟩
      exact hi i
    exact HomogeneousIdeal.mem_iff.mp (hle hspan)
  obtain ⟨k, hk⟩ := c4 (j (y₁ (IsLocalRing.closedPoint K)))
  have hXk : (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K k)
  have hxA : y₁ (IsLocalRing.closedPoint K) ∈ j ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X k) := hk
  have hA : IsAffineOpen (j ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X k)) :=
    IsAffineHom.isAffine_preimage _ (Proj.isAffineOpen_basicOpen _ _ hXk one_pos)

  have hiso : ∀ {R S : CommRingCat.{u}} (φ : R ≅ S),
      RingHom.IsStandardSmoothOfRelativeDimension 0 φ.hom.hom := by
    intro R S φ
    letI := φ.hom.hom.toAlgebra
    exact Algebra.IsStandardSmoothOfRelativeDimension.of_algebraMap_bijective
      (ConcreteCategory.bijective_of_isIso φ.hom)

  have hsm2 : ∃ V₂ : Y'.Opens, IsAffineOpen V₂ ∧ y₁ (IsLocalRing.closedPoint K) ∈ V₂ ∧
      V₂ ≤ V ∧ RingHom.IsStandardSmoothOfRelativeDimension d (wcUnK K N j V₂) := by
    obtain ⟨U, hU, V₁, hV₁, hvV₁, e, hst⟩ :=
      @SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension d _ _
        (V.ι ≫ j ≫ wcProjKStr K N) hVsm (⟨y₁ (IsLocalRing.closedPoint K), hV⟩ : V)
    have hUtop : U = ⊤ := by
      rw [eq_top_iff]
      intro p _
      have hmem : (V.ι ≫ j ≫ wcProjKStr K N) ⟨y₁ (IsLocalRing.closedPoint K), hV⟩ ∈ U :=
        e hvV₁
      rwa [Subsingleton.elim p ((V.ι ≫ j ≫ wcProjKStr K N)
        ⟨y₁ (IsLocalRing.closedPoint K), hV⟩)]
    subst hUtop
    refine ⟨V.ι ''ᵁ V₁, hV₁.image_of_isOpenImmersion V.ι, ?_, Scheme.Opens.ι_image_le V V₁, ?_⟩
    · rw [← SetLike.mem_coe, Scheme.Hom.coe_image]
      exact ⟨⟨y₁ (IsLocalRing.closedPoint K), hV⟩, hvV₁, rfl⟩
    · have h2 : (j ≫ wcProjKStr K N).appLE ⊤ (V.ι ''ᵁ V₁)
          (le_top.trans_eq (Scheme.Hom.preimage_top _).symm) =
          Scheme.Hom.appLE (V.ι ≫ j ≫ wcProjKStr K N) ⊤ V₁ e ≫ (V.ι.appIso V₁).inv := by
        rw [Iso.eq_comp_inv, Scheme.Hom.appIso_hom', Scheme.Hom.appLE_comp_appLE]
      have heq : wcUnK K N j (V.ι ''ᵁ V₁) = (V.ι.appIso V₁).symm.hom.hom.comp
          ((Scheme.Hom.appLE (V.ι ≫ j ≫ wcProjKStr K N) ⊤ V₁ e).hom.comp
            (Scheme.ΓSpecIso (.of K)).symm.hom.hom) := by
        simp only [wcUnK]
        rw [h2]
        rfl
      rw [heq]
      have := (hiso (V.ι.appIso V₁).symm).comp (hst.comp (hiso (Scheme.ΓSpecIso (.of K)).symm))
      have e2 : 0 + (d + 0) = d := by omega
      rw [e2] at this
      exact this

  have s3 : ∀ (V₂ : Y'.Opens), IsAffineOpen V₂ →
      RingHom.IsStandardSmoothOfRelativeDimension d (wcUnK K N j V₂) →
      ∀ f : Γ(Y', V₂),
        RingHom.IsStandardSmoothOfRelativeDimension d (wcUnK K N j (Y'.basicOpen f)) := by
    intro V₂ hV₂ hsm f
    haveI := hV₂.isLocalization_basicOpen f
    have hloc := RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
      (Rᵣ := Γ(Y', Y'.basicOpen f)) f
    have e1 : wcUnK K N j (Y'.basicOpen f) =
        (algebraMap Γ(Y', V₂) Γ(Y', Y'.basicOpen f)).comp (wcUnK K N j V₂) := by
      apply RingHom.ext
      intro r
      show _ = (Y'.presheaf.map (homOfLE (Y'.basicOpen_le f)).op).hom (wcUnK K N j V₂ r)
      simp only [wcUnK]
      rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Category.assoc, Scheme.Hom.appLE_map]
    rw [e1]
    have := hloc.comp hsm
    rwa [zero_add] at this

  obtain ⟨V₂, hV₂, hxV₂, hV₂V, hsmV₂⟩ := hsm2
  obtain ⟨f, g, hfg, hxf⟩ :=
    exists_basicOpen_le_affine_inter hV₂ hA (y₁ (IsLocalRing.closedPoint K)) ⟨hxV₂, hxA⟩
  refine ⟨k, g, hA.basicOpen g, ?_, ?_, ?_⟩
  · rw [← hfg]; exact hxf
  · rw [← hfg]; exact (Y'.basicOpen_le f).trans hV₂V
  · have h := s3 V₂ hV₂ hsmV₂ f
    rw [hfg] at h
    exact h

theorem wc_unram_chart_factor : ∀ (K : Type u) [Field K] (N d : ℕ) (Y' : Scheme.{u})
    (j : Y' ⟶ wcProjK K N) (ℓ : Fin (d + 1) → MvPolynomial (Fin (N + 1)) K)
    (hℓ : ∀ k, ℓ k ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1)
    (π : (wcLinU K N d ℓ : Scheme.{u}) ⟶ wcProjK K d)
    (ρ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
      (MvPolynomial.X 0) →+*
      HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ 0)),
    (Proj.basicOpenIsoSpec _ (ℓ 0) (hℓ 0) one_pos).inv ≫
        (wcProjK K N).homOfLE (le_iSup (fun k => Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ k)) 0) ≫ π =
      Spec.map (CommRingCat.ofHom ρ) ≫
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X 0)
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K 0))
          one_pos →
    ∀ (h₀ : Y' ⟶ (wcLinU K N d ℓ : Scheme.{u})), h₀ ≫ Scheme.Opens.ι _ = j →
    ∀ (W : Y'.Opens), IsAffineOpen W →
    ∀ (hW : W ≤ j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ 0)),
    ((wcUnSec K N j (ℓ 0) W hW).comp ρ).FormallyUnramified →
    FormallyUnramified (W.ι ≫ h₀ ≫ π) :=
by
  intro K _ N d Y' j ℓ hℓ π ρ hch3 h₀ hfac W hWa hW hFU
  have hDℓ : IsAffineOpen (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (ℓ 0)) := Proj.isAffineOpen_basicOpen _ _ (hℓ 0) one_pos

  have hP : Spec.map (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (ℓ 0)) ≫ Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ 0) (hℓ 0)
        one_pos = hDℓ.fromSpec := by
    rw [← Proj.basicOpenIsoSpec_inv_ι _ _ (hℓ 0) one_pos, ← IsAffineOpen.isoSpec_inv_ι,
      ← Category.assoc]
    congr 1
    rw [Iso.comp_inv_eq, Iso.eq_inv_comp, IsAffineOpen.isoSpec_hom, Proj.basicOpenIsoSpec_hom,
      Proj.basicOpenToSpec.eq_1]

  have hK1 : ((Proj.basicOpenIsoSpec _ (ℓ 0) (hℓ 0) one_pos).inv ≫
        (wcProjK K N).homOfLE (le_iSup (fun k => Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ k)) 0)) ≫
        (wcLinU K N d ℓ).ι =
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ 0) (hℓ 0) one_pos := by
    simp only [Category.assoc, Scheme.homOfLE_ι, Proj.basicOpenIsoSpec_inv_ι]

  have hQ : Spec.map (j.appLE _ W hW) ≫
      Spec.map (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ 0)) ≫
      ((Proj.basicOpenIsoSpec _ (ℓ 0) (hℓ 0) one_pos).inv ≫
        (wcProjK K N).homOfLE (le_iSup (fun k => Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ k)) 0)) =
      hWa.fromSpec ≫ h₀ := by
    rw [← cancel_mono (wcLinU K N d ℓ).ι, Category.assoc, Category.assoc, hK1, hP,
      IsAffineOpen.SpecMap_appLE_fromSpec, Category.assoc, hfac]
  have hQπ := congrArg (· ≫ π) hQ
  simp only [Category.assoc] at hQπ

  have e : Spec.map (CommRingCat.ofHom ((wcUnSec K N j (ℓ 0) W hW).comp ρ)) =
      Spec.map (j.appLE _ W hW) ≫
        Spec.map (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ 0)) ≫
        Spec.map (CommRingCat.ofHom ρ) := by
    simp only [wcUnSec]
    rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_hom, Spec.map_comp, Spec.map_comp,
      Category.assoc]

  have hstar : W.ι ≫ h₀ ≫ π = hWa.isoSpec.hom ≫
      Spec.map (CommRingCat.ofHom ((wcUnSec K N j (ℓ 0) W hW).comp ρ)) ≫
      Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X 0)
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K 0))
          one_pos := by
    rw [e]
    simp only [Category.assoc]
    rw [← hch3, hQπ, ← IsAffineOpen.isoSpec_inv_ι]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
  rw [hstar]
  have hA : FormallyUnramified hWa.isoSpec.hom := inferInstance
  have hB : FormallyUnramified
      (Spec.map (CommRingCat.ofHom ((wcUnSec K N j (ℓ 0) W hW).comp ρ))) :=
    (HasRingHomProperty.Spec_iff (P := @FormallyUnramified)).mpr
      (by rw [CommRingCat.hom_ofHom]; exact hFU)
  have hC : FormallyUnramified (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
      (MvPolynomial.X 0)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K 0))
      one_pos) := inferInstance
  exact MorphismProperty.comp_mem @FormallyUnramified _ _ hA
    (MorphismProperty.comp_mem @FormallyUnramified _ _ hB hC)

theorem wc_projection_unramified_at_rational_point : ∀ (K : Type u) [Field K] [IsAlgClosed K]
    (N d : ℕ) (Y' : Scheme.{u}) (j : Y' ⟶ wcProjK K N), IsClosedImmersion j →
    ∀ (y₁ : Spec (.of K) ⟶ Y'), y₁ ≫ j ≫ wcProjKStr K N = 𝟙 _ →
    ∀ (V : Y'.Opens), y₁ (IsLocalRing.closedPoint K) ∈ V →
    SmoothOfRelativeDimension d (V.ι ≫ j ≫ wcProjKStr K N) →
    ∃ C : ℕ → (ℕ → MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) →
        Submodule K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1),
      (∀ i f g, (∀ k < i, f k = g k) → C i f = C i g) ∧ (∀ i f, C i f ≠ ⊤) ∧
      ∀ ℓ : ℕ → MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1, (∀ i ≤ d, ℓ i ∉ C i ℓ) →
      ∀ (π : (wcLinU K N d (fun i => (ℓ i : MvPolynomial (Fin (N + 1)) K)) : Scheme.{u}) ⟶
          wcProjK K d),
        wcLinChart K N d (fun i => (ℓ i : MvPolynomial (Fin (N + 1)) K)) π 0 (fun k => (ℓ k).2) →
      ∀ (h₀ : Y' ⟶ (wcLinU K N d (fun i => (ℓ i : MvPolynomial (Fin (N + 1)) K)) : Scheme.{u})),
        h₀ ≫ Scheme.Opens.ι _ = j →
      ∃ W : Y'.Opens, y₁ (IsLocalRing.closedPoint K) ∈ W ∧ W ≤ V ∧
        FormallyUnramified (W.ι ≫ h₀ ≫ π) :=
by
  intro K _ _ N d Y' j hj y₁ hy₁ V hV hVsm
  classical
  have hX : ∀ i : Fin (N + 1), (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)
  obtain ⟨hev1, hevres, hevK⟩ := wc_unram_eval_rational_point K N Y' j y₁

  have hres : ∀ (h : MvPolynomial (Fin (N + 1)) K) (O O' : Y'.Opens)
      (hO : O ≤ j ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) h)
      (hle : O' ≤ O) (z : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) h),
      (Y'.presheaf.map (homOfLE hle).op).hom (wcUnSec K N j h O hO z) =
        wcUnSec K N j h O' (hle.trans hO) z := by
    intro h O O' hO hle z
    simp only [wcUnSec]
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Category.assoc, Scheme.Hom.appLE_map]
  have hresK : ∀ (O O' : Y'.Opens) (hle : O' ≤ O) (r : K),
      (Y'.presheaf.map (homOfLE hle).op).hom (wcUnK K N j O r) = wcUnK K N j O' r := by
    intro O O' hle r
    simp only [wcUnK]
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Category.assoc, Scheme.Hom.appLE_map]

  obtain ⟨k, g, hU₀aff, hx₀, hU₀V, hsm⟩ :=
    wc_unram_smooth_basic_chart K N d Y' j hj y₁ hy₁ V hV hVsm
  letI : Algebra K Γ(Y', Y'.basicOpen g) := (wcUnK K N j (Y'.basicOpen g)).toAlgebra
  have hU₀k : Y'.basicOpen g ≤ j ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X k) := Y'.basicOpen_le g
  have hεK : ∀ c : K, wcUnEv K y₁ _ hx₀ (algebraMap K Γ(Y', Y'.basicOpen g) c) = c :=
    fun c => hevK hy₁ _ hx₀ c

  let lam : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 →ₗ[K] Γ(Y', Y'.basicOpen g) :=
    { toFun := fun m => wcUnSec K N j (MvPolynomial.X k) _ hU₀k
          (HomogeneousLocalization.Away.mk _ (hX k) 1 m m.2)
      map_add' := fun m m' => by
        rw [(wc_away_mk_one_linear K N _ (hX k) m m' 1).1, map_add]
      map_smul' := fun c m => by
        simp only [RingHom.id_apply]
        rw [(wc_away_mk_one_linear K N _ (hX k) m m c).2.1, map_mul,
          wc_unram_section_K_compat, Algebra.smul_def]
        rfl }
  have hspan : Submodule.span Γ(Y', Y'.basicOpen g) (Set.range fun i : Fin (N + 1) =>
      KaehlerDifferential.D K Γ(Y', Y'.basicOpen g)
        (lam ⟨MvPolynomial.X i, hX i⟩)) = ⊤ :=
    wc_kaehler_span_of_closure K _ _
      ((HomogeneousLocalization.fromZeroRingHom _
        (Submonoid.powers (MvPolynomial.X k))).comp (algebraMap K _))
      (wcUnSec K N j (MvPolynomial.X k) _ hU₀k)
      (RingHom.ext fun r => wc_unram_section_K_compat K N Y' j _ _ hU₀k r)
      (Fin (N + 1)) (fun i => HomogeneousLocalization.Away.mk _ (hX k) 1 (MvPolynomial.X i) (hX i))
      (wc_away_X_closure_top K N k)
      (wc_unram_chart_fraction K N Y' j hj k g)
  have hlam1 : lam ⟨MvPolynomial.X k, hX k⟩ = 1 := by
    show wcUnSec K N j (MvPolynomial.X k) _ hU₀k
      (HomogeneousLocalization.Away.mk _ (hX k) 1 (MvPolynomial.X k) (hX k)) = 1
    rw [(wc_away_mk_one_linear K N _ (hX k) 0 0 0).2.2, map_one]
  obtain ⟨ev, Φ, hev, hΦ, hev0, hΦsurj⟩ := wc_unram_linear_data K Γ(Y', Y'.basicOpen g)
    (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) (wcUnEv K y₁ _ hx₀) hεK lam
    ⟨MvPolynomial.X k, hX k⟩ hlam1 (Fin (N + 1)) (fun i => ⟨MvPolynomial.X i, hX i⟩) hspan
  obtain ⟨hfd, hrk⟩ := wc_unram_cotangent_finrank_le K Γ(Y', Y'.basicOpen g) d
    (RingHom.ker (wcUnEv K y₁ _ hx₀)) (RingHom.ker_ne_top _)
    (fun b => ⟨wcUnEv K y₁ _ hx₀ b, by rw [RingHom.mem_ker, map_sub, hεK, sub_self]⟩)
  obtain ⟨C, hCdep, hCne, hCuse⟩ := wc_unram_linear_choice K _ _ d hrk ev Φ
    ⟨⟨MvPolynomial.X k, hX k⟩, hev0⟩ hΦsurj
  refine ⟨C, hCdep, hCne, ?_⟩

  intro ℓ hℓC π hπ h₀ hh₀
  obtain ⟨he₀, hspanE⟩ := hCuse ℓ hℓC
  obtain ⟨ρ, hch1, hch2, hch3⟩ := hπ

  have hC1 : (⊤ : Submodule Γ(Y', Y'.basicOpen g) Ω[Γ(Y', Y'.basicOpen g)⁄K]) ≤
      Submodule.span Γ(Y', Y'.basicOpen g) (Set.range fun i : Fin d =>
        wcUnEv K y₁ _ hx₀ (lam (ℓ 0)) •
            KaehlerDifferential.D K Γ(Y', Y'.basicOpen g) (lam (ℓ ((i : ℕ) + 1))) -
          wcUnEv K y₁ _ hx₀ (lam (ℓ ((i : ℕ) + 1))) •
            KaehlerDifferential.D K Γ(Y', Y'.basicOpen g) (lam (ℓ 0))) ⊔
      (RingHom.ker (wcUnEv K y₁ _ hx₀)) • ⊤ := by
    have key : ∀ x : Fin d → Ω[Γ(Y', Y'.basicOpen g)⁄K],
        (∀ i : Fin d, ev (ℓ 0) • Φ (ℓ ((i : ℕ) + 1)) - ev (ℓ ((i : ℕ) + 1)) • Φ (ℓ 0) =
          Submodule.Quotient.mk (x i)) →
        (⊤ : Submodule Γ(Y', Y'.basicOpen g) Ω[Γ(Y', Y'.basicOpen g)⁄K]) ≤
          Submodule.span Γ(Y', Y'.basicOpen g) (Set.range x) ⊔
          (RingHom.ker (wcUnEv K y₁ _ hx₀)) • ⊤ := by
      intro x hq ω _
      have hmem : (Submodule.Quotient.mk ω : Ω[Γ(Y', Y'.basicOpen g)⁄K] ⧸
          (RingHom.ker (wcUnEv K y₁ _ hx₀)) •
            (⊤ : Submodule Γ(Y', Y'.basicOpen g) Ω[Γ(Y', Y'.basicOpen g)⁄K])) ∈
          Submodule.span K (Set.range fun i : Fin d =>
            ev (ℓ 0) • Φ (ℓ ((i : ℕ) + 1)) - ev (ℓ ((i : ℕ) + 1)) • Φ (ℓ 0)) := by
        rw [hspanE]; exact Submodule.mem_top
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hmem
      simp only [hq] at hc
      have hsub : ω - ∑ i, c i • x i ∈ (RingHom.ker (wcUnEv K y₁ _ hx₀)) •
          (⊤ : Submodule Γ(Y', Y'.basicOpen g) Ω[Γ(Y', Y'.basicOpen g)⁄K]) := by
        rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_sub, ← hc,
          ← Submodule.mkQ_apply _ (∑ i, c i • x i), map_sum]
        simp only [Submodule.mkQ_apply, Submodule.Quotient.mk_smul, sub_self]
      have e : ω = ∑ i, c i • x i + (ω - ∑ i, c i • x i) := by abel
      rw [e]
      refine Submodule.add_mem_sup ?_ hsub
      refine Submodule.sum_mem _ fun i _ => ?_
      rw [← algebraMap_smul Γ(Y', Y'.basicOpen g) (c i) (x i)]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    refine key _ fun i => ?_
    rw [hev, hev, hΦ, hΦ]
    simp only [Submodule.Quotient.mk_sub, Submodule.Quotient.mk_smul]

  have hev0' : wcUnEv K y₁ _ hx₀ (lam (ℓ 0)) ≠ 0 := by rw [← hev]; exact he₀
  have hW₁x : y₁ (IsLocalRing.closedPoint K) ∈ Y'.basicOpen (lam (ℓ 0)) :=
    (hev1 _ hx₀ _).mpr hev0'
  have hW₁ℓ : Y'.basicOpen (lam (ℓ 0)) ≤ j ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ 0) :=
    wc_unram_basicOpen_section_le K N Y' j _ (hX k) _ hU₀k (ℓ 0) (ℓ 0).2
  have hW₁U₀ : Y'.basicOpen (lam (ℓ 0)) ≤ Y'.basicOpen g := Y'.basicOpen_le _
  have hW₁aff : IsAffineOpen (Y'.basicOpen (lam (ℓ 0))) := hU₀aff.basicOpen _
  letI : Algebra K Γ(Y', Y'.basicOpen (lam (ℓ 0))) := (wcUnK K N j _).toAlgebra
  haveI : IsScalarTower K Γ(Y', Y'.basicOpen g) Γ(Y', Y'.basicOpen (lam (ℓ 0))) :=
    IsScalarTower.of_algebraMap_eq fun r => (hresK _ _ hW₁U₀ r).symm
  haveI hloc₁ : IsLocalization.Away (lam (ℓ 0)) Γ(Y', Y'.basicOpen (lam (ℓ 0))) :=
    hU₀aff.isLocalization_basicOpen _

  let t : Fin d → Γ(Y', Y'.basicOpen (lam (ℓ 0))) := fun i =>
    wcUnSec K N j (ℓ 0) _ hW₁ℓ
      (HomogeneousLocalization.Away.mk _ (ℓ 0).2 1 (ℓ ((i : ℕ) + 1)) (ℓ ((i : ℕ) + 1)).2)
  have ht : ∀ i, t i * algebraMap Γ(Y', Y'.basicOpen g) Γ(Y', Y'.basicOpen (lam (ℓ 0)))
      (lam (ℓ 0)) = algebraMap Γ(Y', Y'.basicOpen g) Γ(Y', Y'.basicOpen (lam (ℓ 0)))
      (lam (ℓ ((i : ℕ) + 1))) := by
    intro i
    have e1 : algebraMap Γ(Y', Y'.basicOpen g) Γ(Y', Y'.basicOpen (lam (ℓ 0))) (lam (ℓ 0)) =
        wcUnSec K N j (MvPolynomial.X k) _ (hW₁U₀.trans hU₀k)
          (HomogeneousLocalization.Away.mk _ (hX k) 1 (ℓ 0) (ℓ 0).2) :=
      hres _ _ _ hU₀k hW₁U₀ _
    have e2 : algebraMap Γ(Y', Y'.basicOpen g) Γ(Y', Y'.basicOpen (lam (ℓ 0)))
        (lam (ℓ ((i : ℕ) + 1))) =
        wcUnSec K N j (MvPolynomial.X k) _ (hW₁U₀.trans hU₀k)
          (HomogeneousLocalization.Away.mk _ (hX k) 1 (ℓ ((i : ℕ) + 1)) (ℓ ((i : ℕ) + 1)).2) :=
      hres _ _ _ hU₀k hW₁U₀ _
    rw [e1, e2, wc_unram_section_ratio K N Y' j _ (ℓ 0) _ (hX k) (ℓ 0).2 (ℓ ((i : ℕ) + 1)).2 _
      (hW₁U₀.trans hU₀k) hW₁ℓ]

  have hC4 := wc_unram_span_transfer K Γ(Y', Y'.basicOpen g) Γ(Y', Y'.basicOpen (lam (ℓ 0)))
    (wcUnEv K y₁ _ hx₀) hεK (lam (ℓ 0)) hev0' hloc₁ d
    (fun i => lam (ℓ ((i : ℕ) + 1))) t ht hC1

  letI : Algebra (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X 0))
      Γ(Y', Y'.basicOpen (lam (ℓ 0))) :=
    ((wcUnSec K N j (ℓ 0) _ hW₁ℓ).comp ρ).toAlgebra
  have hκ : (algebraMap (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X 0))
      Γ(Y', Y'.basicOpen (lam (ℓ 0)))).comp
      ((HomogeneousLocalization.fromZeroRingHom _
        (Submonoid.powers (MvPolynomial.X 0))).comp (algebraMap K _)) =
      algebraMap K Γ(Y', Y'.basicOpen (lam (ℓ 0))) := RingHom.ext fun r => by
    show wcUnSec K N j (ℓ 0) _ hW₁ℓ (ρ (HomogeneousLocalization.fromZeroRingHom
      _ _ (algebraMap K _ r))) = wcUnK K N j _ r
    exact (congrArg (wcUnSec K N j (ℓ 0) _ hW₁ℓ) (hch2 r)).trans
      (wc_unram_section_K_compat K N Y' j _ _ hW₁ℓ r)
  haveI : Algebra.IsStandardSmooth K Γ(Y', Y'.basicOpen g) :=
    Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth d
  haveI : Algebra.FinitePresentation Γ(Y', Y'.basicOpen g) Γ(Y', Y'.basicOpen (lam (ℓ 0))) :=
    IsLocalization.Away.finitePresentation (lam (ℓ 0))
  haveI : Algebra.FinitePresentation K Γ(Y', Y'.basicOpen (lam (ℓ 0))) :=
    Algebra.FinitePresentation.trans K Γ(Y', Y'.basicOpen g) _
  obtain ⟨g₁, hg₁, hFU⟩ := wc_unram_kaehler_nakayama K (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X 0))
    Γ(Y', Y'.basicOpen (lam (ℓ 0))) _ hκ
    (Ideal.map (algebraMap Γ(Y', Y'.basicOpen g) Γ(Y', Y'.basicOpen (lam (ℓ 0))))
      (RingHom.ker (wcUnEv K y₁ _ hx₀))) d
    (fun i => HomogeneousLocalization.Away.mk _
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K 0)) 1
      (MvPolynomial.X i.succ)
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i.succ)))
    (by
      have e : ∀ i : Fin d, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X 0))
          Γ(Y', Y'.basicOpen (lam (ℓ 0))) (HomogeneousLocalization.Away.mk _
            ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K 0)) 1
            (MvPolynomial.X i.succ)
            ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr
              (MvPolynomial.isHomogeneous_X K i.succ))) = t i := fun i => by
        show wcUnSec K N j (ℓ 0) _ hW₁ℓ (ρ _) = _
        rw [hch1 i.succ]
        rfl
      simp only [e]
      exact hC4)

  have hW : Y'.basicOpen g₁ ≤ j ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ℓ 0) :=
    (Y'.basicOpen_le g₁).trans hW₁ℓ
  have hWV : Y'.basicOpen g₁ ≤ V := ((Y'.basicOpen_le g₁).trans hW₁U₀).trans hU₀V
  have hε₁ : wcUnEv K y₁ _ hW₁x g₁ ≠ 0 := by
    have hle : Ideal.map (algebraMap Γ(Y', Y'.basicOpen g) Γ(Y', Y'.basicOpen (lam (ℓ 0))))
        (RingHom.ker (wcUnEv K y₁ _ hx₀)) ≤ RingHom.ker (wcUnEv K y₁ _ hW₁x) := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, RingHom.mem_ker]
      rw [RingHom.mem_ker] at hx
      exact (hevres _ _ hx₀ hW₁x hW₁U₀ x).trans hx
    have h1 := hle hg₁
    rw [RingHom.mem_ker, map_sub, map_one, sub_eq_zero] at h1
    rw [h1]; exact one_ne_zero
  have hWx : y₁ (IsLocalRing.closedPoint K) ∈ Y'.basicOpen g₁ := (hev1 _ hW₁x g₁).mpr hε₁

  have hWaff : IsAffineOpen (Y'.basicOpen g₁) := hW₁aff.basicOpen g₁
  haveI : IsLocalization.Away g₁ Γ(Y', Y'.basicOpen g₁) := hW₁aff.isLocalization_basicOpen g₁
  have hFU' := hFU Γ(Y', Y'.basicOpen g₁)
  have hφ : (algebraMap Γ(Y', Y'.basicOpen (lam (ℓ 0))) Γ(Y', Y'.basicOpen g₁)).comp
      (algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X 0))
        Γ(Y', Y'.basicOpen (lam (ℓ 0)))) = (wcUnSec K N j (ℓ 0) _ hW).comp ρ :=
    RingHom.ext fun z => hres _ _ _ hW₁ℓ (Y'.basicOpen_le g₁) (ρ z)
  rw [hφ] at hFU'
  exact ⟨Y'.basicOpen g₁, hWx, hWV, wc_unram_chart_factor K N d Y' j
    (fun i => (ℓ i : MvPolynomial (Fin (N + 1)) K)) (fun k => (ℓ k).2) π ρ hch3 h₀ hh₀ _
    hWaff hW hFU'⟩

theorem wc_proj_generic_projection_etale_at_point : ∀ (K : Type u) [Field K] [IsAlgClosed K] (N d : ℕ) (Y' : Scheme.{u}) (j : Y' ⟶ wcProjK K N), IsClosedImmersion j → topologicalKrullDim Y' = (d : WithBot ℕ∞) → ∀ (y₀' : Spec (.of K) ⟶ Y') (V : Y'.Opens), y₀' (IsLocalRing.closedPoint K) ∈ V → SmoothOfRelativeDimension d (V.ι ≫ j ≫ wcProjKStr K N) → ∃ (p : Y' ⟶ wcProjK K d) (W : Y'.Opens), IsFinite p ∧ p ≫ wcProjKStr K d = j ≫ wcProjKStr K N ∧ y₀' (IsLocalRing.closedPoint K) ∈ W ∧ Etale (W.ι ≫ p) :=
by
  intro K _ _ N d Y' j hj hdim y₀' V hV hVsm
  classical
  haveI := hj
  haveI := wc_proj_space_isProper K N
  haveI := wc_proj_space_isProper K d
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) := MvPolynomial.gradedAlgebra
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) := MvPolynomial.gradedAlgebra

  haveI : LocallyOfFiniteType (V.ι ≫ j ≫ wcProjKStr K N) := inferInstance
  obtain ⟨x₁, hx₁, hsp⟩ := wc_rational_closed_specialization K (V : Scheme.{u})
    (V.ι ≫ j ≫ wcProjKStr K N) ⟨y₀' (IsLocalRing.closedPoint K), hV⟩
  obtain ⟨y₁, hy₁⟩ : ∃ y₁ : Spec (.of K) ⟶ Y', y₁ = x₁ ≫ V.ι := ⟨_, rfl⟩
  have hy₁s : y₁ ≫ j ≫ wcProjKStr K N = 𝟙 _ := by rw [hy₁, Category.assoc]; exact hx₁
  have hy₁V : y₁ (IsLocalRing.closedPoint K) ∈ V := by
    rw [hy₁]
    exact (x₁ (IsLocalRing.closedPoint K)).2
  have hysp : y₀' (IsLocalRing.closedPoint K) ⤳ y₁ (IsLocalRing.closedPoint K) := by
    have h1 := hsp.map (Scheme.Hom.continuous V.ι)
    rw [hy₁]
    exact h1

  obtain ⟨C, hCdep, hCne, hCuse⟩ :=
    wc_projection_unramified_at_rational_point K N d Y' j hj y₁ hy₁s V hy₁V hVsm

  have hT : IsClosed (Set.range j) := j.isClosedEmbedding.isClosed_range
  have hTdim : topologicalKrullDim ↥(Set.range j) ≤ (d : WithBot ℕ∞) := by
    rw [← IsHomeomorph.topologicalKrullDim_eq _
      (j.isClosedEmbedding.isEmbedding.toHomeomorph.isHomeomorph), hdim]
  obtain ⟨ℓ, hℓC, hℓcov⟩ := wc_linear_forms_avoid_closed K N d (Set.range j) hT hTdim C hCdep hCne

  let L : Fin (d + 1) → MvPolynomial (Fin (N + 1)) K := fun i => (ℓ i : MvPolynomial (Fin (N + 1)) K)
  have hLmem : ∀ k, L k ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun k => (ℓ k).2
  have hLhom : ∀ k, (L k).IsHomogeneous 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).mp (hLmem k)
  have hrange : Set.range j ⊆ ((wcLinU K N d L : (wcProjK K N).Opens) : Set (wcProjK K N)) := by
    rintro _ ⟨y, rfl⟩
    obtain ⟨i, hi, hx⟩ := hℓcov (j y) ⟨y, rfl⟩
    rw [SetLike.mem_coe, TopologicalSpace.Opens.mem_iSup]
    exact ⟨⟨i, by omega⟩, hx⟩
  obtain ⟨h₀, hfac⟩ : ∃ h₀ : Y' ⟶ (wcLinU K N d L : Scheme.{u}), h₀ ≫ (wcLinU K N d L).ι = j :=
    ⟨IsOpenImmersion.lift (wcLinU K N d L).ι j (by rw [Scheme.Opens.range_ι]; exact hrange),
      IsOpenImmersion.lift_fac _ _ _⟩

  obtain ⟨π, hπstr, hπpre, hπchart⟩ : ∃ π : (wcLinU K N d L : Scheme.{u}) ⟶ wcProjK K d,
      π ≫ wcProjKStr K d = (wcLinU K N d L).ι ≫ wcProjKStr K N ∧
      (∀ i : Fin (d + 1), π ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
          (MvPolynomial.X i) =
        (wcLinU K N d L).ι ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (L i)) ∧
      wcLinChart K N d L π 0 hLmem := by
    let φ : MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K :=
      GradedRingHom.mk (MvPolynomial.aeval L).toRingHom (fun {i} {x} hx => by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
        simpa using (hx.aeval L hLhom))
    have hφ : ∀ a, φ a = MvPolynomial.aeval L a := fun a => rfl
    have hy : ∀ i : Fin (d + 1), (MvPolynomial.X i : MvPolynomial (Fin (d + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1 :=
      fun i => (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)
    have hφX : ∀ i, φ (MvPolynomial.X i) = L i := fun i => MvPolynomial.aeval_X L i
    have h : ∀ i, Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (d + 1)) K) ≤
        Submonoid.comap φ (Submonoid.powers (L i)) :=
      fun i => Submonoid.powers_le.mpr (Submonoid.mem_comap.mpr
        (by rw [hφX]; exact Submonoid.mem_powers _))
    have h₂ : ∀ i j, Submonoid.powers (MvPolynomial.X i * MvPolynomial.X j :
        MvPolynomial (Fin (d + 1)) K) ≤ Submonoid.comap φ (Submonoid.powers (L i * L j)) :=
      fun i j => Submonoid.powers_le.mpr (Submonoid.mem_comap.mpr (by
        rw [map_mul, hφX, hφX]; exact Submonoid.mem_powers _))
    have L1 : ∀ j (n : ℕ) (a : MvPolynomial (Fin (d + 1)) K)
        (ha : a ∈ MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K (n • 1)),
        HomogeneousLocalization.map φ (h j) (HomogeneousLocalization.Away.mk _ (hy j) n a ha) =
        HomogeneousLocalization.Away.mk _ (hLmem j) n (φ a) (φ.map_mem ha) := by
      intro j n a ha
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.mk,
        HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
      congr 1
      apply Subtype.ext
      show φ (MvPolynomial.X j ^ n) = L j ^ n
      rw [map_pow, hφX]
    have C4 : ∀ (a b : Fin (d + 1)) (x : MvPolynomial (Fin (d + 1)) K)
        (x' : MvPolynomial (Fin (N + 1)) K)
        (hx : x = MvPolynomial.X a * MvPolynomial.X b) (hx' : x' = L a * L b)
        (h₂ : Submonoid.powers x ≤ Submonoid.comap φ (Submonoid.powers x')),
        (HomogeneousLocalization.awayMap _ (hLmem b) hx').comp (HomogeneousLocalization.map φ (h a)) =
          (HomogeneousLocalization.map φ h₂).comp (HomogeneousLocalization.awayMap _ (hy b) hx) := by
      intro a b x x' hx hx' h₂
      refine RingHom.ext fun z => ?_
      obtain ⟨n, z, hz, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ (hy a) z
      rw [RingHom.comp_apply, RingHom.comp_apply, L1, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.mk,
        HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk]
      subst hx hx'
      congr 1
      · show φ z * L b ^ n = φ (z * MvPolynomial.X b ^ n)
        rw [map_mul, map_pow, hφX]
      · apply Subtype.ext
        show (L a * L b) ^ n = φ ((MvPolynomial.X a * MvPolynomial.X b) ^ n)
        rw [map_pow, map_mul, hφX, hφX]
    have C5 : ∀ i (r : K), HomogeneousLocalization.map φ (h i)
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
          (Submonoid.powers (MvPolynomial.X i)) (algebraMap K _ r)) =
        HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (L i)) (algebraMap K _ r) := by
      intro i r
      apply HomogeneousLocalization.val_injective
      change (HomogeneousLocalization.map φ (h i) (HomogeneousLocalization.mk
          ⟨0, algebraMap K _ r, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩)).val =
        (HomogeneousLocalization.mk
          ⟨0, algebraMap K _ r, 1, by rw [SetLike.GradeZero.coe_one]; exact Submonoid.one_mem _⟩ :
            HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
              (Submonoid.powers (L i))).val
      rw [HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk,
        HomogeneousLocalization.val_mk]
      congr 1
      · show φ ((algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0) r :
            MvPolynomial (Fin (d + 1)) K)) = _
        rw [SetLike.GradeZero.coe_algebraMap, SetLike.GradeZero.coe_algebraMap, hφ, AlgHom.commutes]
      · apply Subtype.ext
        show φ (((1 : MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0)) :
          MvPolynomial (Fin (d + 1)) K) = ((1 : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) :
            MvPolynomial (Fin (N + 1)) K)
        rw [SetLike.GradeZero.coe_one, SetLike.GradeZero.coe_one, map_one]
    have C6 : ∀ i j, HomogeneousLocalization.map φ (h j)
        (HomogeneousLocalization.Away.isLocalizationElem (hy j) (hy i)) =
        HomogeneousLocalization.Away.isLocalizationElem (hLmem j) (hLmem i) := by
      intro i j
      unfold HomogeneousLocalization.Away.isLocalizationElem
      rw [L1]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, map_pow, hφX]
    let U : (wcProjK K N).Opens := wcLinU K N d L
    let c : ∀ i, Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (L i))) ⟶ (U : Scheme) :=
      fun i => (Proj.basicOpenIsoSpec _ (L i) (hLmem i) one_pos).inv ≫
        (wcProjK K N).homOfLE (le_iSup (fun i => Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (L i)) i)
    have K1 : ∀ i, c i ≫ U.ι = Proj.awayι _ (L i) (hLmem i) one_pos := by
      intro i
      simp only [c, Category.assoc, Scheme.homOfLE_ι, Proj.basicOpenIsoSpec_inv_ι]
    have hcov : ∀ z : (U : Scheme), ∃ i w, c i w = z := by
      intro z
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp z.2
      refine ⟨i, (Proj.basicOpenIsoSpec _ (L i) (hLmem i) one_pos).hom ⟨z.1, hi⟩, ?_⟩
      apply Subtype.ext
      simp only [c, Scheme.Hom.comp_apply]
      have e := Scheme.hom_inv_apply (Proj.basicOpenIsoSpec _ (L i) (hLmem i) one_pos) ⟨z.1, hi⟩
      refine (Scheme.homOfLE_apply _ _).trans ?_
      rw [e]
    let 𝒰 : (U : Scheme).OpenCover :=
      Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) (Fin (d + 1)) _ c hcov (fun i => inferInstance)
    let f : ∀ i, Spec (CommRingCat.of (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (L i))) ⟶ wcProjK K d :=
      fun i => Spec.map (CommRingCat.ofHom (HomogeneousLocalization.map φ (h i))) ≫
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X i) (hy i)
          one_pos
    have cocycle : ∀ i j, Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hLmem j)
        (rfl : L i * L j = L i * L j))) ≫ f i =
        Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hLmem i)
          (mul_comm (L i) (L j)))) ≫ f j := by
      intro i j
      simp only [f]
      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        C4 i j _ _ rfl rfl (h₂ i j), CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc,
        Proj.SpecMap_awayMap_awayι]
      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        C4 j i _ _ (mul_comm (MvPolynomial.X i) (MvPolynomial.X j)) (mul_comm (L i) (L j)) (h₂ i j),
        CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, Proj.SpecMap_awayMap_awayι]
    have hglue : ∀ i j, Limits.pullback.fst (𝒰.f i) (𝒰.f j) ≫ f i =
        Limits.pullback.snd (𝒰.f i) (𝒰.f j) ≫ f j := by
      intro i j
      change Limits.pullback.fst (c i) (c j) ≫ f i = Limits.pullback.snd (c i) (c j) ≫ f j
      have w : Limits.pullback.fst (c i) (c j) ≫ Proj.awayι _ (L i) (hLmem i) one_pos =
          Limits.pullback.snd (c i) (c j) ≫ Proj.awayι _ (L j) (hLmem j) one_pos := by
        rw [← K1 i, ← K1 j, ← Category.assoc, Limits.pullback.condition, Category.assoc]
      have e1 := Proj.pullbackAwayιIso_inv_fst
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hLmem i) one_pos (hLmem j) one_pos
        (rfl : L i * L j = L i * L j)
      have e2 := Proj.pullbackAwayιIso_inv_snd
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hLmem i) one_pos (hLmem j) one_pos
        (rfl : L i * L j = L i * L j)
      obtain ⟨t, ht1, ht2⟩ : ∃ t : Limits.pullback (c i) (c j) ⟶ Spec (CommRingCat.of
          (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (L i * L j))),
          Limits.pullback.fst (c i) (c j) = t ≫
            Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hLmem j)
              (rfl : L i * L j = L i * L j))) ∧
          Limits.pullback.snd (c i) (c j) = t ≫
            Spec.map (CommRingCat.ofHom (HomogeneousLocalization.awayMap _ (hLmem i)
              (mul_comm (L i) (L j)))) := by
        refine ⟨Limits.pullback.lift _ _ w ≫
          (Proj.pullbackAwayιIso (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hLmem i)
            one_pos (hLmem j) one_pos (rfl : L i * L j = L i * L j)).hom, ?_, ?_⟩
        · rw [Category.assoc, ← e1, Iso.hom_inv_id_assoc, Limits.pullback.lift_fst]
        · rw [Category.assoc, ← e2, Iso.hom_inv_id_assoc, Limits.pullback.lift_snd]
      rw [ht1, ht2, Category.assoc, Category.assoc, cocycle i j]
    let π : (U : Scheme) ⟶ wcProjK K d := 𝒰.glueMorphisms f hglue
    have hπ : ∀ i, c i ≫ π = f i := fun i => 𝒰.ι_glueMorphisms f hglue i
    refine ⟨π, ?_, ?_, ?_⟩
    · apply 𝒰.hom_ext
      intro i
      change c i ≫ π ≫ _ = c i ≫ U.ι ≫ _
      rw [← Category.assoc, hπ i, ← Category.assoc (c i), K1 i]
      simp only [f, Category.assoc]
      rw [← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero,
        ← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero]
      simp only [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      exact RingHom.ext fun r => C5 i r
    · intro i
      apply TopologicalSpace.Opens.ext
      refine Set.ext fun z => ?_
      obtain ⟨j, w, rfl⟩ := hcov z
      have key2 : (c j ≫ π) ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
            (MvPolynomial.X i) =
          (c j ≫ U.ι) ⁻¹ᵁ
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (L i) := by
        rw [hπ j, K1 j]
        simp only [f]
        rw [Scheme.Hom.comp_preimage, Proj.awayι_preimage_basicOpen _ (hy j) one_pos (hy i) one_pos,
          Proj.awayι_preimage_basicOpen _ (hLmem j) one_pos (hLmem i) one_pos,
          SpecMap_preimage_basicOpen]
        congr 1
        exact C6 i j
      have hw := SetLike.ext_iff.mp key2 w
      simp only [Scheme.Hom.comp_preimage, Scheme.Hom.mem_preimage] at hw
      simp only [SetLike.mem_coe, Scheme.Hom.mem_preimage]
      exact hw
    · refine ⟨HomogeneousLocalization.map φ (h 0), ?_, fun r => C5 0 r, ?_⟩
      · intro k
        rw [L1]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, hφX]
      · have := hπ 0
        simp only [c] at this
        rw [Category.assoc] at this
        exact this

  have c4 : ∀ x : wcProjK K d, ∃ i : Fin (d + 1), x ∈ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X i) := by
    intro x
    by_contra hx
    push_neg at hx
    apply x.not_irrelevant_le
    intro a ha
    have hi : ∀ i, MvPolynomial.X i ∈ x.asHomogeneousIdeal.toIdeal := fun i => by
      have := hx i
      rw [Proj.mem_basicOpen, not_not] at this
      exact HomogeneousIdeal.mem_iff.mpr this
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha
    have ha' : MvPolynomial.homogeneousComponent 0 a = 0 :=
      (MvPolynomial.decomposition.decompose'_apply a 0).symm.trans ha
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha'
    have hspan : a ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra hc
      push_neg at hc
      have hm0 : m = 0 := Finsupp.ext fun i => hc i (Set.mem_univ i)
      rw [hm0] at hm
      exact (MvPolynomial.mem_support_iff.mp hm) ha'
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1)))) ≤
        x.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨i, _, rfl⟩
      exact hi i
    exact HomogeneousIdeal.mem_iff.mp (hle hspan)
  have hcomp : (h₀ ≫ π) ≫ wcProjKStr K d = j ≫ wcProjKStr K N := by
    rw [Category.assoc, hπstr, ← Category.assoc, hfac]
  haveI : IsProper ((h₀ ≫ π) ≫ wcProjKStr K d) := by rw [hcomp]; infer_instance
  haveI : IsProper (h₀ ≫ π) := IsProper.of_comp _ (wcProjKStr K d)
  haveI : IsAffineHom (h₀ ≫ π) := by
    apply isAffineHom_of_forall_exists_isAffineOpen
    intro y
    obtain ⟨i, hi⟩ := c4 y
    refine ⟨_, hi, ?_, ?_⟩
    · exact Proj.isAffineOpen_basicOpen _ _
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i)) one_pos
    · rw [Scheme.Hom.comp_preimage, hπpre i, ← Scheme.Hom.comp_preimage, hfac]
      exact IsAffineHom.isAffine_preimage _ (Proj.isAffineOpen_basicOpen _ _ (hLmem i) one_pos)
  have hfin : IsFinite (h₀ ≫ π) :=
    IsFinite.iff_isProper_and_isAffineHom.mpr ⟨inferInstance, inferInstance⟩

  obtain ⟨W, hW, hWV, hWun⟩ := hCuse ℓ hℓC π hπchart h₀ hfac

  haveI := hVsm
  have hsm : SmoothOfRelativeDimension d ((W.ι ≫ h₀ ≫ π) ≫ wcProjKStr K d) := by
    have e : (W.ι ≫ h₀ ≫ π) ≫ wcProjKStr K d =
        Y'.homOfLE hWV ≫ (V.ι ≫ j ≫ wcProjKStr K N) := by
      rw [Category.assoc, Category.assoc, hπstr, ← Category.assoc h₀, hfac,
        ← Scheme.homOfLE_ι Y' hWV, Category.assoc]
    rw [e]
    have := smoothOfRelativeDimension_comp 0 d (Y'.homOfLE hWV) (V.ι ≫ j ≫ wcProjKStr K N)
    rwa [zero_add] at this
  have het : Etale (W.ι ≫ h₀ ≫ π) :=
    wc_etale_of_unramified_smooth_same_reldim (W.ι ≫ h₀ ≫ π) (wcProjKStr K d) d
      (wc_proj_space_smooth K d) hsm hWun
  exact ⟨h₀ ≫ π, W, hfin, hcomp, hysp.mem_open W.isOpen hW, het⟩

theorem wc_et_supp_obj_comp_iso : ∀ {X Y Z : Scheme.{u}} {n : ℕ} (y : X ⟶ Y) (p : Y ⟶ Z) (Dy : wcEtPullData y n) (Dp : wcEtPullData p n) (Dx : wcEtPullData (y ≫ p) n), ∃ κ : wcEtSuppObj Dx ≅ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).obj (wcEtSuppObj Dy), wcEtSuppUnitMap Dx ≫ κ.hom = wcEtSuppUnitMap Dp ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).map (wcEtSuppUnitMap Dy) :=
by
  classical
  intro X Y Z n y p Dy Dp Dx

  have key : ∀ (Pp : SheafOfModules.{u+1} (wcEtZModRing Y n) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z n))
      (Py : SheafOfModules.{u+1} (wcEtZModRing X n) ⥤ SheafOfModules.{u+1} (wcEtZModRing Y n))
      (Px : SheafOfModules.{u+1} (wcEtZModRing X n) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z n))
      (Φp : SheafOfModules.{u+1} (wcEtZModRing Z n) ⥤ SheafOfModules.{u+1} (wcEtZModRing Y n))
      (Φy : SheafOfModules.{u+1} (wcEtZModRing Y n) ⥤ SheafOfModules.{u+1} (wcEtZModRing X n))
      (Φx : SheafOfModules.{u+1} (wcEtZModRing Z n) ⥤ SheafOfModules.{u+1} (wcEtZModRing X n))
      (adjp : Φp ⊣ Pp) (adjy : Φy ⊣ Py) (adjx : Φx ⊣ Px) (ι : Py ⋙ Pp ≅ Px)
      (c : SheafOfModules.{u+1} (wcEtZModRing Z n)) (d : SheafOfModules.{u+1} (wcEtZModRing Y n))
      (e : SheafOfModules.{u+1} (wcEtZModRing X n))
      (μp : Φp.obj c ≅ d) (μy : Φy.obj d ≅ e) (μx : Φx.obj c ≅ e),
      ∃ κ : Px.obj e ≅ Pp.obj (Py.obj e),
        (adjx.unit.app c ≫ Px.map μx.hom) ≫ κ.hom =
          (adjp.unit.app c ≫ Pp.map μp.hom) ≫ Pp.map (adjy.unit.app d ≫ Py.map μy.hom) := by
    intro Pp Py Px Φp Φy Φx adjp adjy adjx ι c d e μp μy μx
    let adjc : Φp ⋙ Φy ⊣ Px := (adjp.comp adjy).ofNatIsoRight ι
    let θ : Φx ≅ Φp ⋙ Φy := adjx.leftAdjointUniq adjc
    let g : Φy.obj (Φp.obj c) ⟶ e := Φy.map μp.hom ≫ μy.hom
    have hΘ : adjx.unit.app c ≫ Px.map (θ.hom.app c) = adjc.unit.app c :=
      adjx.unit_leftAdjointUniq_hom_app adjc c
    have hU : adjc.unit.app c = adjp.unit.app c ≫ Pp.map (adjy.unit.app (Φp.obj c)) ≫
        ι.hom.app (Φy.obj (Φp.obj c)) := by
      simp only [adjc, Adjunction.ofNatIsoRight_unit, NatTrans.comp_app, Adjunction.comp_unit_app,
        Functor.whiskerLeft_app, Category.assoc]
      rfl
    have hnat : ι.hom.app (Φy.obj (Φp.obj c)) ≫ Px.map g = Pp.map (Py.map g) ≫ ι.hom.app e :=
      (ι.hom.naturality g).symm
    have h0 : adjy.unit.app (Φp.obj c) ≫ Py.map (Φy.map μp.hom) = μp.hom ≫ adjy.unit.app d :=
      (adjy.unit.naturality μp.hom).symm
    have hun : adjy.unit.app (Φp.obj c) ≫ Py.map g = μp.hom ≫ adjy.unit.app d ≫ Py.map μy.hom := by
      simp only [g, CategoryTheory.Functor.map_comp]
      rw [← Category.assoc, h0, Category.assoc]
    refine ⟨Px.mapIso (μx.symm ≪≫ θ.app c ≪≫ Φy.mapIso μp ≪≫ μy) ≪≫ (ι.app e).symm, ?_⟩
    have hw : (Px.mapIso (μx.symm ≪≫ θ.app c ≪≫ Φy.mapIso μp ≪≫ μy) ≪≫ (ι.app e).symm).hom =
        Px.map μx.inv ≫ Px.map (θ.hom.app c) ≫ Px.map g ≫ ι.inv.app e := by
      simp only [Iso.trans_hom, Functor.mapIso_hom, Iso.symm_hom, Iso.app_hom, Iso.app_inv,
        Functor.mapIso_hom, CategoryTheory.Functor.map_comp, Category.assoc, g]
    rw [hw]
    calc (adjx.unit.app c ≫ Px.map μx.hom) ≫ Px.map μx.inv ≫ Px.map (θ.hom.app c) ≫ Px.map g ≫
          ι.inv.app e
        = (adjx.unit.app c ≫ Px.map (θ.hom.app c)) ≫ Px.map g ≫ ι.inv.app e := by
          simp only [Category.assoc]
          rw [← CategoryTheory.Functor.map_comp_assoc Px μx.hom μx.inv, Iso.hom_inv_id,
            CategoryTheory.Functor.map_id, Category.id_comp]
      _ = adjp.unit.app c ≫ Pp.map (adjy.unit.app (Φp.obj c)) ≫
            (ι.hom.app (Φy.obj (Φp.obj c)) ≫ Px.map g) ≫ ι.inv.app e := by
          rw [hΘ, hU]; simp only [Category.assoc]
      _ = adjp.unit.app c ≫ Pp.map (adjy.unit.app (Φp.obj c) ≫ Py.map g) := by
          rw [hnat, Category.assoc, Iso.hom_inv_id_app]
          erw [Category.comp_id]
          simp only [CategoryTheory.Functor.map_comp]
      _ = (adjp.unit.app c ≫ Pp.map μp.hom) ≫ Pp.map (adjy.unit.app d ≫ Py.map μy.hom) := by
          rw [hun, CategoryTheory.Functor.map_comp, Category.assoc]

  have s1 : ∀ (W : Scheme.{u}) (T : Sheaf (Scheme.smallEtaleTopology W) RingCat.{u+1})
      (a b : wcEtZModRing W n ⟶ T), a = b := by
    intro W T a b
    have key' : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod n) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod n →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    apply Sheaf.hom_ext
    apply sheafify_hom_ext (Scheme.smallEtaleTopology W) _ _ T.cond
    apply NatTrans.ext
    funext V
    apply RingCat.hom_ext
    exact key' _ _
  have hmap : ∀ {A B : Scheme.{u}} (h : A ⟶ B) {V V' : B.Etale} (u : V ⟶ V'),
      ((wcEtBaseChange h).map u).left ≫ Limits.pullback.fst V'.hom h =
        Limits.pullback.fst V.hom h ≫ u.left ∧
      ((wcEtBaseChange h).map u).left ≫ Limits.pullback.snd V'.hom h =
        Limits.pullback.snd V.hom h := by
    intro A B h V V' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsnd : ∀ V : Z.Etale, (Limits.pullbackLeftPullbackSndIso V.hom p y).symm.hom ≫
      Limits.pullback.snd (Limits.pullback.snd V.hom p) y = Limits.pullback.snd V.hom (y ≫ p) := by
    intro V
    rw [Iso.symm_hom, Iso.inv_comp_eq, Limits.pullbackLeftPullbackSndIso_hom_snd]
  choose c hc using fun V : Z.Etale =>
    (⟨MorphismProperty.Over.isoMk (A := (wcEtBaseChange (y ≫ p)).obj V)
        (B := (wcEtBaseChange p ⋙ wcEtBaseChange y).obj V)
        (Limits.pullbackLeftPullbackSndIso V.hom p y).symm (hsnd V),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcEtBaseChange (y ≫ p)).obj V ≅ (wcEtBaseChange p ⋙ wcEtBaseChange y).obj V,
        c.hom.left = (Limits.pullbackLeftPullbackSndIso V.hom p y).inv)
  have nat : ∀ {V V' : Z.Etale} (u : V ⟶ V'),
      (wcEtBaseChange (y ≫ p)).map u ≫ (c V').hom =
        (c V).hom ≫ (wcEtBaseChange p ⋙ wcEtBaseChange y).map u := by
    intro V V' u
    have key2 : ∀ (L : Limits.pullback V.hom (y ≫ p) ⟶ Limits.pullback V'.hom (y ≫ p))
        (M1 : Limits.pullback V.hom p ⟶ Limits.pullback V'.hom p)
        (M2 : Limits.pullback (Limits.pullback.snd V.hom p) y ⟶
          Limits.pullback (Limits.pullback.snd V'.hom p) y),
        L ≫ Limits.pullback.fst V'.hom (y ≫ p) = Limits.pullback.fst V.hom (y ≫ p) ≫ u.left →
        L ≫ Limits.pullback.snd V'.hom (y ≫ p) = Limits.pullback.snd V.hom (y ≫ p) →
        M1 ≫ Limits.pullback.fst V'.hom p = Limits.pullback.fst V.hom p ≫ u.left →
        M1 ≫ Limits.pullback.snd V'.hom p = Limits.pullback.snd V.hom p →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd V'.hom p) y =
          Limits.pullback.fst (Limits.pullback.snd V.hom p) y ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd V'.hom p) y =
          Limits.pullback.snd (Limits.pullback.snd V.hom p) y →
        L ≫ (Limits.pullbackLeftPullbackSndIso V'.hom p y).inv =
          (Limits.pullbackLeftPullbackSndIso V.hom p y).inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst V.hom p y)]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcEtBaseChange (y ≫ p)).map u).left ≫ (c V').hom.left =
      (c V).hom.left ≫ ((wcEtBaseChange y).map ((wcEtBaseChange p).map u)).left
    rw [hc V, hc V']
    exact key2 _ _ _ (hmap (y ≫ p) u).1 (hmap (y ≫ p) u).2 (hmap p u).1 (hmap p u).2
      (hmap y ((wcEtBaseChange p).map u)).1 (hmap y ((wcEtBaseChange p).map u)).2
  let α : wcEtBaseChange (y ≫ p) ≅ wcEtBaseChange p ⋙ wcEtBaseChange y := NatIso.ofComponents c nat
  haveI := Dp.cont
  haveI := Dy.cont
  haveI := Dx.cont
  haveI : (wcEtBaseChange p ⋙ wcEtBaseChange y).IsContinuous (Scheme.smallEtaleTopology Z)
      (Scheme.smallEtaleTopology X) :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology Y) _
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.smallEtaleTopology Z) (Scheme.smallEtaleTopology X)).app (wcEtZModRing X n)
  let φpy : wcEtZModRing Z n ⟶ ((wcEtBaseChange p ⋙ wcEtBaseChange y).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology Z) (Scheme.smallEtaleTopology X)).obj
        (wcEtZModRing X n) :=
    Dp.φ ≫ ((wcEtBaseChange p).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology Z) (Scheme.smallEtaleTopology Y)).map Dy.φ
  have hcompat : φpy ≫ τ = Dx.φ := s1 Z _ _ _
  let ι : SheafOfModules.pushforward Dy.φ ⋙ SheafOfModules.pushforward Dp.φ ≅
      SheafOfModules.pushforward Dx.φ :=
    SheafOfModules.pushforwardComp Dp.φ Dy.φ ≪≫
      SheafOfModules.pushforwardNatIso φpy α ≪≫ SheafOfModules.pushforwardCongr hcompat
  exact key _ _ _ Dp.Φ Dy.Φ Dx.Φ Dp.adj Dy.adj Dx.adj ι _ _ _ Dp.μ Dy.μ Dx.μ

theorem wc_finite_generic_etale_open_dense : ∀ {X Y' : Scheme.{u}} [IrreducibleSpace X] (p : Y' ⟶ X), IsFinite p → IrreducibleSpace Y' → ∀ (W : Y'.Opens), Nonempty W → Etale (W.ι ≫ p) → ∃ U : X.Opens, p ⁻¹ᵁ U ≤ W ∧ ∀ V : X.Etale, Dense (V.hom ⁻¹' (U : Set X)) :=
by
  intro X Y' _ p hp hirr W hW _
  haveI : IsFinite p := hp
  haveI : IrreducibleSpace Y' := hirr
  have hZ : IsClosed (p '' (W : Set Y')ᶜ) := p.isClosedMap _ W.isOpen.isClosed_compl
  let U : X.Opens := ⟨(p '' (W : Set Y')ᶜ)ᶜ, hZ.isOpen_compl⟩
  have hηW : genericPoint Y' ∈ (W : Set Y') := by
    obtain ⟨⟨w, hw⟩⟩ := hW
    exact ((genericPoint_spec Y').mem_open_set_iff W.isOpen).mpr ⟨w, trivial, hw⟩
  have hdisc := p.isDiscrete_preimage (s := {p (genericPoint Y')})
    (Set.subsingleton_singleton).isDiscrete
  have hηU : p (genericPoint Y') ∈ (U : Set X) := by
    rintro ⟨y, hyW, hy⟩
    have hspec : genericPoint Y' ⤳ y := genericPoint_specializes y
    have heq : genericPoint Y' = y :=
      hdisc.eq_of_specializes hspec (by simp) (by simp [hy])
    exact hyW (heq ▸ hηW)
  have hUd : Dense (U : Set X) := IsOpen.dense U.isOpen ⟨_, hηU⟩
  refine ⟨U, ?_, ?_⟩
  · intro y hy
    by_contra h
    exact hy ⟨y, h, rfl⟩
  · intro V
    haveI : Etale V.hom := V.prop
    exact Dense.preimage hUd V.hom.isOpenMap

theorem wcpa_irreducible_of_connected_domain_stalks : ∀ (W : Scheme.{u}) [IsLocallyNoetherian W]
    [ConnectedSpace W], (∀ w : W, IsDomain (W.presheaf.stalk w)) → IrreducibleSpace W :=
by
  intro W _ _ hdom

  have s1 : ∀ z : W, ∃ η : W, ∀ y : W, y ⤳ z → η ⤳ y := by
    intro z
    haveI := hdom z
    refine ⟨W.fromSpecStalk z (⊥ : PrimeSpectrum (W.presheaf.stalk z)), ?_⟩
    intro y hy
    have hr : y ∈ Set.range (W.fromSpecStalk z) := by
      rw [Scheme.range_fromSpecStalk]; exact hy
    obtain ⟨p, rfl⟩ := hr
    have hle : (⊥ : PrimeSpectrum (W.presheaf.stalk z)) ≤ (p : PrimeSpectrum (W.presheaf.stalk z)) :=
      bot_le
    exact ((PrimeSpectrum.le_iff_specializes _ _).mp hle).map (W.fromSpecStalk z).continuous

  have s2 : ∀ (z η : W), (∀ y : W, y ⤳ z → η ⤳ y) →
      ∀ T : Set W, IsIrreducible T → z ∈ T → T ⊆ closure {η} := by
    intro z η hη T hT hz t ht
    have hg := hT.isGenericPoint_genericPoint_closure
    have h1 : hT.genericPoint ⤳ z := hg.specializes (subset_closure hz)
    have h2 : hT.genericPoint ⤳ t := hg.specializes (subset_closure ht)
    exact ((hη _ h1).trans h2).mem_closure

  have s3 : ∀ (U : Set W), IsOpen U → TopologicalSpace.NoetherianSpace U → ∀ z : W, z ∈ U →
      ∀ C : Set W, (∀ T : Set W, IsIrreducible T → z ∈ T → T ⊆ C) →
      ∃ V : Set W, IsOpen V ∧ z ∈ V ∧ V ⊆ C := by
    intro U hU hN z hz C hC
    haveI := hN
    let z' : U := ⟨z, hz⟩
    have hfin := TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := U)
    let S : Set (Set U) := {K ∈ irreducibleComponents U | z' ∉ K}
    have hSfin : S.Finite := hfin.subset (fun K hK => hK.1)
    have hDc : IsClosed (⋃₀ S) :=
      hSfin.isClosed_sUnion (fun K hK => isClosed_of_mem_irreducibleComponents K hK.1)
    refine ⟨Subtype.val '' (⋃₀ S)ᶜ, hU.isOpenMap_subtype_val _ hDc.isOpen_compl,
      ⟨z', ?_, rfl⟩, ?_⟩
    · rintro ⟨K, hK, hzK⟩
      exact hK.2 hzK
    · rintro _ ⟨v, hv, rfl⟩
      have hvU : v ∈ ⋃₀ irreducibleComponents U := by
        rw [sUnion_irreducibleComponents]; trivial
      obtain ⟨K, hK, hvK⟩ := hvU
      have hzK : z' ∈ K := by
        by_contra h
        exact hv ⟨K, ⟨hK, h⟩, hvK⟩
      have hKirr : IsIrreducible K := hK.1
      have hT := hKirr.image Subtype.val continuous_subtype_val.continuousOn
      exact hC _ hT ⟨z', hzK, rfl⟩ ⟨v, hvK, rfl⟩

  have s4 : ∀ w : W, ∃ U : Set W, IsOpen U ∧ w ∈ U ∧ TopologicalSpace.NoetherianSpace U := by
    intro w
    obtain ⟨A, hA, hwA, -⟩ := exists_isAffineOpen_mem_and_subset (X := W) (x := w) (U := ⊤)
      (by trivial)
    haveI := IsLocallyNoetherian.component_noetherian (⟨A, hA⟩ : W.affineOpens)
    exact ⟨A, A.isOpen, hwA, noetherianSpace_of_isAffineOpen A hA⟩

  choose η hη using s1
  have hz : ∀ z, z ∈ closure ({η z} : Set W) := fun z => (hη z z specializes_rfl).mem_closure
  have hirr : ∀ z, IsIrreducible (closure ({η z} : Set W)) :=
    fun z => isIrreducible_singleton.closure
  have hb : ∀ z (T : Set W), IsIrreducible T → z ∈ T → T ⊆ closure {η z} :=
    fun z => s2 z (η z) (hη z)
  have hc : ∀ z w, w ∈ closure ({η z} : Set W) → closure ({η w} : Set W) ⊆ closure {η z} := by
    intro z w hw
    have h1 := hb w _ (hirr z) hw
    exact hb z _ (hirr w) (h1 (hz z))
  obtain ⟨z0⟩ := (inferInstance : Nonempty W)
  have hopen : IsOpen (closure ({η z0} : Set W)) := by
    rw [isOpen_iff_forall_mem_open]
    intro w hw
    obtain ⟨U, hU, hwU, hN⟩ := s4 w
    obtain ⟨V, hV, hwV, hVC⟩ := s3 U hU hN w hwU _ (hb w)
    exact ⟨V, hVC.trans (hc z0 w hw), hV, hwV⟩
  have huniv : closure ({η z0} : Set W) = Set.univ :=
    IsClopen.eq_univ ⟨isClosed_closure, hopen⟩ ⟨z0, hz z0⟩
  rw [irreducibleSpace_def, Set.top_eq_univ, ← huniv]
  exact hirr z0

theorem wc_et_over_proj_locally_irreducible : ∀ (K : Type u) [Field K] (d : ℕ) (V : (wcProjK K d).Etale) (v : V.left), ∃ N : V.left.Opens, v ∈ N ∧ IsIrreducible (N : Set V.left) :=
by
  intro K _ d V v

  have s1 : ∀ {α : Type u} [TopologicalSpace α] [TopologicalSpace.NoetherianSpace α] (x : α),
      IsOpen (connectedComponent x) := by
    intro α _ _ x
    rw [isOpen_iff_forall_mem_open]
    intro y hy
    have hfin : (irreducibleComponents α).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    let B : Set α := ⋃₀ {Z | Z ∈ irreducibleComponents α ∧ y ∉ Z}
    have hB : IsClosed B := by
      apply Set.Finite.isClosed_sUnion (hfin.subset (Set.sep_subset _ _))
      intro Z hZ
      exact isClosed_of_mem_irreducibleComponents Z hZ.1
    refine ⟨Bᶜ, ?_, hB.isOpen_compl, ?_⟩
    · intro z hz
      have hZ := irreducibleComponent_mem_irreducibleComponents z
      have hzZ := mem_irreducibleComponent (x := z)
      have hyZ : y ∈ irreducibleComponent z := by
        by_contra hne
        exact hz (Set.mem_sUnion.mpr ⟨_, ⟨hZ, hne⟩, hzZ⟩)
      have hsub : irreducibleComponent z ⊆ connectedComponent y :=
        (isIrreducible_irreducibleComponent).isPreirreducible.isPreconnected.subset_connectedComponent hyZ
      rw [connectedComponent_eq hy]
      exact hsub hzZ
    · intro hyB
      obtain ⟨Z, hZ, hyZ⟩ := Set.mem_sUnion.mp hyB
      exact hZ.2 hyZ

  haveI : Etale V.hom := V.prop
  haveI := wc_proj_space_smooth K d
  haveI hs : SmoothOfRelativeDimension (0 + d) (V.hom ≫ wcProjKStr K d) :=
    smoothOfRelativeDimension_comp 0 d V.hom (wcProjKStr K d)
  haveI : Smooth (V.hom ≫ wcProjKStr K d) := SmoothOfRelativeDimension.smooth (0 + d) _
  haveI : IsLocallyNoetherian V.left :=
    LocallyOfFiniteType.isLocallyNoetherian (V.hom ≫ wcProjKStr K d)

  obtain ⟨O, hO, hvO, -⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
    (U := (⊤ : V.left.Opens)) (x := v) trivial
  haveI : IsNoetherianRing Γ(V.left, O) := IsLocallyNoetherian.component_noetherian ⟨O, hO⟩
  haveI : TopologicalSpace.NoetherianSpace ↥(O : Set V.left) := noetherianSpace_of_isAffineOpen O hO
  let x : ↥(O : Set V.left) := ⟨v, hvO⟩
  have hC : IsOpen (connectedComponent x) := s1 x
  let N : V.left.Opens := ⟨Subtype.val '' connectedComponent x, O.isOpen.isOpenMap_subtype_val _ hC⟩
  have hvN : v ∈ N := ⟨x, mem_connectedComponent, rfl⟩
  have hNconn : _root_.IsConnected (N : Set V.left) :=
    isConnected_connectedComponent.image Subtype.val continuous_subtype_val.continuousOn
  haveI : ConnectedSpace N.toScheme := isConnected_iff_connectedSpace.mp hNconn
  haveI : SmoothOfRelativeDimension (0 + (0 + d)) (N.ι ≫ (V.hom ≫ wcProjKStr K d)) :=
    smoothOfRelativeDimension_comp 0 (0 + d) N.ι (V.hom ≫ wcProjKStr K d)
  have hdom : ∀ w : N.toScheme, IsDomain (N.toScheme.presheaf.stalk w) := fun w =>
    wcpa_smooth_stalk_isDomain K N.toScheme (N.ι ≫ (V.hom ≫ wcProjKStr K d)) (0 + (0 + d)) w
  haveI : IrreducibleSpace N.toScheme := wcpa_irreducible_of_connected_domain_stalks N.toScheme hdom
  exact ⟨N, hvN, isIrreducible_iff_irreducibleSpace.mpr this⟩

theorem wc_fet_field_etale_card_hom : ∀ (K E Ω : Type u) [Field K] [CommRing E] [Algebra K E] [Module.Finite K E] [Algebra.Etale K E] [Field Ω] [IsAlgClosed Ω] [Algebra K Ω], Finite (E →ₐ[K] Ω) ∧ Nat.card (E →ₐ[K] Ω) = Module.finrank K E :=
by
  classical
  intro K E Ω _ _ _ _ _ _ _ _
  obtain ⟨I, hI, L, hLF, hLA, e, hL⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod K E).mp inferInstance
  haveI : Fintype I := Fintype.ofFinite I
  have hfin : ∀ i, Module.Finite K (L i) := fun i => (hL i).1
  have hsep : ∀ i, Algebra.IsSeparable K (L i) := fun i => (hL i).2
  let Φ : (Σ i, (L i →ₐ[K] Ω)) → ((Π i, L i) →ₐ[K] Ω) :=
    fun p => p.2.comp (Pi.evalAlgHom K L p.1)
  have hΦ : Function.Bijective Φ := by
    constructor
    · rintro ⟨i, χ⟩ ⟨j, χ'⟩ h
      have hv : ∀ v : Π k, L k, χ (v i) = χ' (v j) := fun v => by
        have := AlgHom.congr_fun h v
        simpa [Φ] using this
      have hij : i = j := by
        by_contra hne
        have := hv (Pi.single i 1)
        rw [Pi.single_eq_same, Pi.single_eq_of_ne (Ne.symm hne), map_one, map_zero] at this
        exact one_ne_zero this
      subst hij
      have : χ = χ' := by
        ext x
        have := hv (Pi.single i x)
        simpa using this
      subst this
      rfl
    · intro ψ
      have hid : ∀ j, ψ (Pi.single j 1) = 0 ∨ ψ (Pi.single j 1) = 1 := by
        intro j
        apply IsIdempotentElem.iff_eq_zero_or_one.mp
        show ψ (Pi.single j 1) * ψ (Pi.single j 1) = ψ (Pi.single j 1)
        rw [← map_mul, ← Pi.single_mul, mul_one]
      have hone : ∑ j, (Pi.single j 1 : Π k, L k) = 1 := by
        simpa using Finset.univ_sum_single (1 : Π k, L k)
      have hsum : ∑ j, ψ (Pi.single j 1) = 1 := by
        rw [← map_sum, hone, map_one]
      obtain ⟨i, hi⟩ : ∃ i, ψ (Pi.single i 1) = 1 := by
        by_contra hne
        push_neg at hne
        have h0 : ∑ j, ψ (Pi.single j 1) = 0 :=
          Finset.sum_eq_zero (fun j _ => (hid j).resolve_right (hne j))
        rw [hsum] at h0
        exact one_ne_zero h0
      have hmulε : ∀ v : Π k, L k, v * Pi.single i 1 = Pi.single i (v i) := by
        intro v
        ext k
        by_cases hk : k = i
        · subst hk
          simp
        · simp [Pi.single_eq_of_ne hk]
      let χ : L i →ₐ[K] Ω :=
        { toFun := fun x => ψ (Pi.single i x)
          map_one' := hi
          map_mul' := fun x y => by
            show ψ (Pi.single i (x * y)) = ψ (Pi.single i x) * ψ (Pi.single i y)
            rw [Pi.single_mul, map_mul]
          map_zero' := by
            show ψ (Pi.single i 0) = 0
            rw [Pi.single_zero, map_zero]
          map_add' := fun x y => by
            show ψ (Pi.single i (x + y)) = ψ (Pi.single i x) + ψ (Pi.single i y)
            rw [Pi.single_add, map_add]
          commutes' := fun r => by
            show ψ (Pi.single i (algebraMap K (L i) r)) = algebraMap K Ω r
            have hr : (Pi.single i (algebraMap K (L i) r) : Π k, L k) =
                algebraMap K (Π k, L k) r * Pi.single i 1 := by
              rw [hmulε]
              rfl
            rw [hr, map_mul, hi, mul_one, AlgHom.commutes] }
      refine ⟨⟨i, χ⟩, ?_⟩
      ext v
      show ψ (Pi.single i (v i)) = ψ v
      rw [← hmulε, map_mul, hi, mul_one]
  let α : (E →ₐ[K] Ω) ≃ ((Π i, L i) →ₐ[K] Ω) := AlgEquiv.arrowCongr e AlgEquiv.refl
  let β : (E →ₐ[K] Ω) ≃ Σ i, (L i →ₐ[K] Ω) := α.trans (Equiv.ofBijective Φ hΦ).symm
  have hcard : ∀ i, Nat.card (L i →ₐ[K] Ω) = Module.finrank K (L i) := by
    intro i
    rw [← AlgHom.card K (L i) Ω, Nat.card_eq_fintype_card]
  have : ∀ i, Finite (L i →ₐ[K] Ω) := fun i => inferInstance
  have : Finite (Σ i, (L i →ₐ[K] Ω)) := inferInstance
  refine ⟨Finite.of_equiv _ β.symm, ?_⟩
  rw [Nat.card_congr β, Nat.card_sigma, Finset.sum_congr rfl (fun i _ => hcard i),
    ← Module.finrank_pi_fintype, LinearEquiv.finrank_eq e.toLinearEquiv]

theorem wc_fet_card_hom_rankAtStalk : (∀ (K E Ω : Type u) [Field K] [CommRing E] [Algebra K E] [Module.Finite K E] [Algebra.Etale K E] [Field Ω] [IsAlgClosed Ω] [Algebra K Ω], Finite (E →ₐ[K] Ω) ∧ Nat.card (E →ₐ[K] Ω) = Module.finrank K E) → ∀ (R T Ω : Type u) [CommRing R] [CommRing T] [Algebra R T] [Module.Finite R T] [Algebra.Etale R T] [Field Ω] [IsAlgClosed Ω] [Algebra R Ω], Finite (T →ₐ[R] Ω) ∧ Nat.card (T →ₐ[R] Ω) = Module.rankAtStalk T (PrimeSpectrum.comap (algebraMap R Ω) (IsLocalRing.closedPoint Ω)) :=
by
  intro H R T Ω _ _ _ _ _ _ _ _
  classical
  have hmem : ∀ r : R, r ∈ (PrimeSpectrum.comap (algebraMap R Ω) (IsLocalRing.closedPoint Ω)).asIdeal ↔
      algebraMap R Ω r = 0 := by
    intro r
    rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
    show algebraMap R Ω r ∈ IsLocalRing.maximalIdeal Ω ↔ _
    rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot]
  generalize PrimeSpectrum.comap (algebraMap R Ω) (IsLocalRing.closedPoint Ω) = p at hmem ⊢
  have h₁ : p.asIdeal ≤ RingHom.ker (algebraMap R Ω) := fun r hr =>
    (RingHom.mem_ker).mpr ((hmem r).mp hr)
  have h₂ : p.asIdeal.primeCompl ≤ Submonoid.comap (algebraMap R Ω) (IsUnit.submonoid Ω) := by
    intro r hr
    have hne : algebraMap R Ω r ≠ 0 := fun h => hr ((hmem r).mpr h)
    exact (IsUnit.mem_submonoid_iff _).mpr (isUnit_iff_ne_zero.mpr hne)
  let φ : p.asIdeal.ResidueField →+* Ω := Ideal.ResidueField.lift p.asIdeal (algebraMap R Ω) h₁ h₂
  have hφ : ∀ r, φ (algebraMap R p.asIdeal.ResidueField r) = algebraMap R Ω r :=
    Ideal.ResidueField.lift_algebraMap _ _ h₁ h₂
  letI : Algebra p.asIdeal.ResidueField Ω := φ.toAlgebra
  haveI : IsScalarTower R p.asIdeal.ResidueField Ω :=
    IsScalarTower.of_algebraMap_eq (fun r => (hφ r).symm)
  let e : (p.asIdeal.Fiber T →ₐ[p.asIdeal.ResidueField] Ω) ≃ (T →ₐ[R] Ω) :=
    { toFun := fun Φ => (Φ.restrictScalars R).comp Algebra.TensorProduct.includeRight
      invFun := fun ψ => Algebra.TensorProduct.lift (Algebra.ofId p.asIdeal.ResidueField Ω) ψ
        (fun _ _ => Commute.all _ _)
      left_inv := fun Φ => by
        apply Algebra.TensorProduct.ext
        · exact Subsingleton.elim _ _
        · ext t
          simp
      right_inv := fun ψ => by
        ext t
        simp }
  obtain ⟨hfin, hcard⟩ := H p.asIdeal.ResidueField (p.asIdeal.Fiber T) Ω
  refine ⟨Finite.of_equiv _ e, ?_⟩
  rw [← Nat.card_congr e, hcard, Module.rankAtStalk_eq]

theorem wc_fet_idempotent_away : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S] [Algebra.Etale R S] (e : S), IsIdempotentElem e → Module.Finite R (Localization.Away e) ∧ Algebra.Etale R (Localization.Away e) ∧ ∀ (Ω : Type u) [Field Ω] [Algebra R Ω], Nonempty ((Localization.Away e →ₐ[R] Ω) ≃ {ψ : S →ₐ[R] Ω // ψ e = 1}) :=
by
  intro R S _ _ _ _ _ e he
  have hsurj : Function.Surjective (algebraMap S (Localization.Away e)) :=
    IsLocalization.Away.algebraMap_surjective_of_isIdempotentElem e he
  let ι : S →ₐ[R] Localization.Away e := IsScalarTower.toAlgHom R S (Localization.Away e)
  have hι : ∀ s, ι s = algebraMap S (Localization.Away e) s := fun s => rfl
  refine ⟨?_, ?_, ?_⟩
  · exact Module.Finite.of_surjective ι.toLinearMap hsurj
  · haveI : Algebra.Etale S (Localization.Away e) := Algebra.Etale.of_isLocalizationAway e
    exact Algebra.Etale.comp R S (Localization.Away e)
  · intro Ω _ _
    have key : ∀ Φ : Localization.Away e →ₐ[R] Ω, Φ (algebraMap S (Localization.Away e) e) = 1 := by
      intro Φ
      have hu : IsUnit (Φ (algebraMap S (Localization.Away e) e)) :=
        (IsLocalization.Away.algebraMap_isUnit e).map Φ
      have hi : IsIdempotentElem (Φ (algebraMap S (Localization.Away e) e)) :=
        (he.map (algebraMap S (Localization.Away e))).map Φ
      have hne : Φ (algebraMap S (Localization.Away e) e) ≠ 0 := hu.ne_zero
      exact mul_left_cancel₀ hne (hi.eq.trans (mul_one _).symm)
    have hext : ∀ Φ₁ Φ₂ : Localization.Away e →ₐ[R] Ω,
        (∀ s, Φ₁ (algebraMap S (Localization.Away e) s) = Φ₂ (algebraMap S (Localization.Away e) s)) →
          Φ₁ = Φ₂ := by
      intro Φ₁ Φ₂ h
      refine AlgHom.ext (fun z => ?_)
      obtain ⟨s, rfl⟩ := hsurj z
      exact h s
    have hlift : ∀ (ψ : S →ₐ[R] Ω) (h : IsUnit (ψ e)) (s : S),
        IsLocalization.Away.liftAlgHom e (f := ψ) h (algebraMap S (Localization.Away e) s) = ψ s := by
      intro ψ h s
      rw [IsLocalization.Away.liftAlgHom_apply, IsLocalization.Away.lift_eq]
      rfl
    have hunit : ∀ ψ : {ψ : S →ₐ[R] Ω // ψ e = 1}, IsUnit (ψ.1 e) := fun ψ => by
      rw [ψ.2]; exact isUnit_one
    refine ⟨{ toFun := fun Φ => ⟨Φ.comp ι, by rw [AlgHom.comp_apply, hι]; exact key Φ⟩
              invFun := fun ψ => IsLocalization.Away.liftAlgHom e (f := ψ.1) (hunit ψ)
              left_inv := ?_
              right_inv := ?_ }⟩
    · intro Φ
      apply hext
      intro s
      rw [hlift]
      rfl
    · intro ψ
      apply Subtype.ext
      ext s
      show IsLocalization.Away.liftAlgHom e (f := ψ.1) (hunit ψ) (ι s) = ψ.1 s
      rw [hι, hlift]

theorem wc_fet_ring_lc_trace : (∀ (R T Ω : Type u) [CommRing R] [CommRing T] [Algebra R T] [Module.Finite R T] [Algebra.Etale R T] [Field Ω] [IsAlgClosed Ω] [Algebra R Ω], Finite (T →ₐ[R] Ω) ∧ Nat.card (T →ₐ[R] Ω) = Module.rankAtStalk T (PrimeSpectrum.comap (algebraMap R Ω) (IsLocalRing.closedPoint Ω))) → (∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S] [Algebra.Etale R S] (e : S), IsIdempotentElem e → Module.Finite R (Localization.Away e) ∧ Algebra.Etale R (Localization.Away e) ∧ ∀ (Ω : Type u) [Field Ω] [Algebra R Ω], Nonempty ((Localization.Away e →ₐ[R] Ω) ≃ {ψ : S →ₐ[R] Ω // ψ e = 1})) → ∀ (m : ℕ) (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S] [Algebra.Etale R S] (f : PrimeSpectrum S → ZMod m), IsLocallyConstant f → ∃ F : PrimeSpectrum R → ZMod m, IsLocallyConstant F ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra R Ω], Finite (S →ₐ[R] Ω) ∧ ∑ᶠ ψ : S →ₐ[R] Ω, f (PrimeSpectrum.comap (ψ : S →+* Ω) (IsLocalRing.closedPoint Ω)) = F (PrimeSpectrum.comap (algebraMap R Ω) (IsLocalRing.closedPoint Ω)) :=
by
  classical
  intro H5 H6 m R S _ _ _ _ _ f hf

  have hfinr : (Set.range f).Finite := hf.range_finite
  have hV : ∀ p, f p ∈ hfinr.toFinset := fun p => hfinr.mem_toFinset.mpr (Set.mem_range_self p)
  choose e he using fun c => PrimeSpectrum.isClopen_iff.mp (hf.isClopen_fiber c)
  have hidem : ∀ c, IsIdempotentElem (e c) := fun c => (he c).1
  have hfib : ∀ c p, f p = c ↔ p ∈ PrimeSpectrum.basicOpen (e c) := by
    intro c p
    exact Set.ext_iff.mp (he c).2 p

  have hs2 : ∀ (Ω : Type u) [Field Ω] (ψ : S →+* Ω) (x : S), IsIdempotentElem x →
      (PrimeSpectrum.comap ψ (IsLocalRing.closedPoint Ω) ∈ PrimeSpectrum.basicOpen x ↔ ψ x = 1) := by
    intro Ω _ ψ x hx
    rw [PrimeSpectrum.mem_basicOpen, PrimeSpectrum.comap_asIdeal]
    have h0 : (IsLocalRing.closedPoint Ω).asIdeal = ⊥ := IsLocalRing.maximalIdeal_eq_bot
    rw [h0, Ideal.mem_comap, Ideal.mem_bot]
    rcases (IsIdempotentElem.iff_eq_zero_or_one.mp (hx.map ψ)) with h | h
    · simp [h]
    · simp [h]

  have hinst : ∀ c, Module.Finite R (Localization.Away (e c)) ∧
      Algebra.Etale R (Localization.Away (e c)) :=
    fun c => ⟨(H6 R S (e c) (hidem c)).1, (H6 R S (e c) (hidem c)).2.1⟩

  have hlc : ∀ c, IsLocallyConstant (fun p : PrimeSpectrum R =>
      ((Module.rankAtStalk (Localization.Away (e c)) p : ℕ) : ZMod m) * c) := by
    intro c
    have := (hinst c).1
    have := (hinst c).2
    have : Module.FinitePresentation R (Localization.Away (e c)) :=
      Module.FinitePresentation.of_finite_of_finitePresentation R _
    exact (Module.isLocallyConstant_rankAtStalk (R := R) (M := Localization.Away (e c))).comp
      (fun n : ℕ => (n : ZMod m) * c)

  have hsumlc : ∀ (s : Finset (ZMod m)), IsLocallyConstant (fun p : PrimeSpectrum R =>
      ∑ c ∈ s, ((Module.rankAtStalk (Localization.Away (e c)) p : ℕ) : ZMod m) * c) := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      simp only [Finset.sum_empty]
      exact IsLocallyConstant.const 0
    | insert a s ha ih =>
      simp only [Finset.sum_insert ha]
      exact IsLocallyConstant.comp₂ (hlc a) ih (· + ·)

  have s3 : ∀ (α : Type u) [Fintype α] (g : α → ZMod m), (∀ a, g a ∈ hfinr.toFinset) →
      ∑ a, g a = ∑ c ∈ hfinr.toFinset, (Nat.card {a // g a = c} : ZMod m) * c := by
    intro α _ g hg
    rw [← Finset.sum_fiberwise_of_maps_to (s := Finset.univ) (t := hfinr.toFinset) (g := g)
      (fun a _ => hg a) g]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    rw [Finset.sum_congr rfl ((fun a ha => (Finset.mem_filter.mp ha).2) :
        ∀ a ∈ Finset.univ.filter (fun a => g a = c), g a = c),
      Finset.sum_const, nsmul_eq_mul,
      Nat.subtype_card (Finset.univ.filter (fun a => g a = c)) (fun a => by simp)]

  have hcount : ∀ c (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra R Ω],
      Nat.card {ψ : S →ₐ[R] Ω //
          f (PrimeSpectrum.comap (ψ : S →+* Ω) (IsLocalRing.closedPoint Ω)) = c} =
        Module.rankAtStalk (Localization.Away (e c))
          (PrimeSpectrum.comap (algebraMap R Ω) (IsLocalRing.closedPoint Ω)) := by
    intro c Ω _ _ _
    have := (hinst c).1
    have := (hinst c).2
    have h1 : Nat.card {ψ : S →ₐ[R] Ω //
          f (PrimeSpectrum.comap (ψ : S →+* Ω) (IsLocalRing.closedPoint Ω)) = c} =
        Nat.card {ψ : S →ₐ[R] Ω // ψ (e c) = 1} :=
      Nat.card_congr (Equiv.subtypeEquivRight fun ψ : S →ₐ[R] Ω =>
        (hfib c _).trans (hs2 Ω (ψ : S →+* Ω) (e c) (hidem c)))
    have h2 := Nat.card_congr ((H6 R S (e c) (hidem c)).2.2 Ω).some
    have h3 := (H5 R (Localization.Away (e c)) Ω).2
    exact h1.trans (h2.symm.trans h3)
  refine ⟨fun p => ∑ c ∈ hfinr.toFinset,
      ((Module.rankAtStalk (Localization.Away (e c)) p : ℕ) : ZMod m) * c, hsumlc _, ?_⟩
  intro Ω _ _ _
  obtain ⟨hfinS, -⟩ := H5 R S Ω
  refine ⟨hfinS, ?_⟩
  haveI := Fintype.ofFinite (S →ₐ[R] Ω)
  rw [finsum_eq_sum_of_fintype, s3 _ _ (fun ψ => hV _)]
  refine Finset.sum_congr rfl (fun c _ => ?_)
  rw [hcount c Ω]

theorem wc_fet_spec_points_algHom : ∀ (R S Ω : Type u) [CommRing R] [CommRing S] [Field Ω] [Algebra R S] [Algebra R Ω], ∃ e : {x : Spec (.of Ω) ⟶ Spec (.of S) // x ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = Spec.map (CommRingCat.ofHom (algebraMap R Ω))} ≃ (S →ₐ[R] Ω), ∀ x, x.1 (IsLocalRing.closedPoint Ω) = PrimeSpectrum.comap ((e x : S →ₐ[R] Ω) : S →+* Ω) (IsLocalRing.closedPoint Ω) :=
by
  intro R S Ω _ _ _ _ _
  have hcomm : ∀ x : {x : Spec (.of Ω) ⟶ Spec (.of S) // x ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = Spec.map (CommRingCat.ofHom (algebraMap R Ω))},
      ∀ r : R, (Spec.preimage x.1).hom (algebraMap R S r) = algebraMap R Ω r := by
    intro x r
    have h : CommRingCat.ofHom (algebraMap R S) ≫ Spec.preimage x.1 =
        CommRingCat.ofHom (algebraMap R Ω) := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, x.2]
    have h2 := congrArg (fun f => CommRingCat.Hom.hom f r) h
    simpa using h2
  refine ⟨{ toFun := fun x => { toRingHom := (Spec.preimage x.1).hom, commutes' := hcomm x }
            invFun := fun ψ => ⟨Spec.map (CommRingCat.ofHom (ψ : S →+* Ω)), by
              rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]⟩
            left_inv := ?_
            right_inv := ?_ }, ?_⟩
  · intro x
    apply Subtype.ext
    change Spec.map (CommRingCat.ofHom (Spec.preimage x.1).hom) = x.1
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  · intro ψ
    apply AlgHom.ext
    intro s
    change (Spec.preimage (Spec.map (CommRingCat.ofHom (ψ : S →+* Ω)))).hom s = ψ s
    rw [Spec.preimage_map]
    rfl
  · intro x
    have h1 : x.1 (IsLocalRing.closedPoint Ω) =
        (Spec.map (Spec.preimage x.1)) (IsLocalRing.closedPoint Ω) := by
      rw [Spec.map_preimage]
    rw [h1]
    exact Spec.map_apply (Spec.preimage x.1) (IsLocalRing.closedPoint Ω)

theorem wc_fet_spec_lc_trace : (∀ (m : ℕ) (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S] [Algebra.Etale R S] (f : PrimeSpectrum S → ZMod m), IsLocallyConstant f → ∃ F : PrimeSpectrum R → ZMod m, IsLocallyConstant F ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra R Ω], Finite (S →ₐ[R] Ω) ∧ ∑ᶠ ψ : S →ₐ[R] Ω, f (PrimeSpectrum.comap (ψ : S →+* Ω) (IsLocalRing.closedPoint Ω)) = F (PrimeSpectrum.comap (algebraMap R Ω) (IsLocalRing.closedPoint Ω))) → (∀ (R S Ω : Type u) [CommRing R] [CommRing S] [Field Ω] [Algebra R S] [Algebra R Ω], ∃ e : {x : Spec (.of Ω) ⟶ Spec (.of S) // x ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = Spec.map (CommRingCat.ofHom (algebraMap R Ω))} ≃ (S →ₐ[R] Ω), ∀ x, x.1 (IsLocalRing.closedPoint Ω) = PrimeSpectrum.comap ((e x : S →ₐ[R] Ω) : S →+* Ω) (IsLocalRing.closedPoint Ω)) → ∀ (m : ℕ) (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S] [Algebra.Etale R S] (f : Spec (.of S) → ZMod m), IsLocallyConstant f → ∃ T : Spec (.of R) → ZMod m, IsLocallyConstant T ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (y : Spec (.of Ω) ⟶ Spec (.of R)), Finite {x : Spec (.of Ω) ⟶ Spec (.of S) // x ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = y} ∧ ∑ᶠ x : {x : Spec (.of Ω) ⟶ Spec (.of S) // x ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = y}, f (x.1 (IsLocalRing.closedPoint Ω)) = T (y (IsLocalRing.closedPoint Ω)) :=
by
  intro H7 H8 m R S _ _ _ _ _ f hf
  obtain ⟨F, hFlc, hF⟩ := H7 m R S f hf
  refine ⟨F, hFlc, ?_⟩
  intro Ω _ _ y
  obtain ⟨φ, rfl⟩ : ∃ φ : CommRingCat.of R ⟶ CommRingCat.of Ω, Spec.map φ = y :=
    ⟨Spec.preimage y, Spec.map_preimage y⟩
  letI : Algebra R Ω := φ.hom.toAlgebra
  obtain ⟨e, he⟩ := H8 R S Ω
  obtain ⟨hfin, hsum⟩ := hF Ω
  haveI := hfin
  let e' : {x : Spec (.of Ω) ⟶ Spec (.of S) //
      x ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = Spec.map φ} ≃ (S →ₐ[R] Ω) := e
  have he' : ∀ x, x.1 (IsLocalRing.closedPoint Ω) =
      PrimeSpectrum.comap ((e' x : S →ₐ[R] Ω) : S →+* Ω) (IsLocalRing.closedPoint Ω) := he
  refine ⟨Finite.of_equiv _ e'.symm, ?_⟩
  calc ∑ᶠ x : {x : Spec (.of Ω) ⟶ Spec (.of S) //
          x ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = Spec.map φ},
          f (x.1 (IsLocalRing.closedPoint Ω))
      = ∑ᶠ x : {x : Spec (.of Ω) ⟶ Spec (.of S) //
          x ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = Spec.map φ},
          (fun ψ : S →ₐ[R] Ω => f (PrimeSpectrum.comap (ψ : S →+* Ω)
            (IsLocalRing.closedPoint Ω))) (e' x) :=
        finsum_congr (fun x => congrArg f (he' x))
    _ = ∑ᶠ ψ : S →ₐ[R] Ω, f (PrimeSpectrum.comap (ψ : S →+* Ω) (IsLocalRing.closedPoint Ω)) :=
        finsum_comp_equiv e' (f := fun ψ : S →ₐ[R] Ω => f (PrimeSpectrum.comap (ψ : S →+* Ω)
            (IsLocalRing.closedPoint Ω)))
    _ = F (PrimeSpectrum.comap (algebraMap R Ω) (IsLocalRing.closedPoint Ω)) := hsum
    _ = F ((Spec.map φ) (IsLocalRing.closedPoint Ω)) := by
        first
          | exact congrArg F (Spec.map_apply φ (IsLocalRing.closedPoint Ω)).symm
          | rfl

theorem wc_fet_affine_lc_trace : (∀ (m : ℕ) (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S] [Algebra.Etale R S] (f : Spec (.of S) → ZMod m), IsLocallyConstant f → ∃ T : Spec (.of R) → ZMod m, IsLocallyConstant T ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (y : Spec (.of Ω) ⟶ Spec (.of R)), Finite {x : Spec (.of Ω) ⟶ Spec (.of S) // x ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = y} ∧ ∑ᶠ x : {x : Spec (.of Ω) ⟶ Spec (.of S) // x ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) = y}, f (x.1 (IsLocalRing.closedPoint Ω)) = T (y (IsLocalRing.closedPoint Ω))) → (∀ {A B A' B' : Scheme.{u}} (q : A ⟶ B) (q' : A' ⟶ B') (g : B' ⟶ B) (g' : A' ⟶ A), IsPullback g' q' q g → ∀ (m : ℕ) (Ω : Type u) [Field Ω] (y' : Spec (.of Ω) ⟶ B') (f : A → ZMod m), (Finite {x' : Spec (.of Ω) ⟶ A' // x' ≫ q' = y'} ↔ Finite {x : Spec (.of Ω) ⟶ A // x ≫ q = y' ≫ g}) ∧ ∑ᶠ x' : {x' : Spec (.of Ω) ⟶ A' // x' ≫ q' = y'}, f (g' (x'.1 (IsLocalRing.closedPoint Ω))) = ∑ᶠ x : {x : Spec (.of Ω) ⟶ A // x ≫ q = y' ≫ g}, f (x.1 (IsLocalRing.closedPoint Ω))) → ∀ (m : ℕ) {A B : Scheme.{u}} [IsAffine A] [IsAffine B] (q : A ⟶ B), IsFinite q → Etale q → ∀ f : A → ZMod m, IsLocallyConstant f → ∃ T : B → ZMod m, IsLocallyConstant T ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (y : Spec (.of Ω) ⟶ B), Finite {x : Spec (.of Ω) ⟶ A // x ≫ q = y} ∧ ∑ᶠ x : {x : Spec (.of Ω) ⟶ A // x ≫ q = y}, f (x.1 (IsLocalRing.closedPoint Ω)) = T (y (IsLocalRing.closedPoint Ω)) :=
by
  intro H9 H2 m A B _ _ q h₁ h₂ f hf
  haveI : IsFinite q := h₁
  letI : Algebra Γ(B, ⊤) Γ(A, ⊤) := q.appTop.hom.toAlgebra
  haveI : Module.Finite Γ(B, ⊤) Γ(A, ⊤) :=
    RingHom.finite_algebraMap.mp (IsFinite.finite_app q ⊤ (isAffineOpen_top B))
  haveI : Algebra.Etale Γ(B, ⊤) Γ(A, ⊤) :=
    RingHom.etale_algebraMap.mp (HasRingHomProperty.appTop @Etale q h₂)
  have hP : IsPullback A.isoSpec.hom q
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(B, ⊤) Γ(A, ⊤)))) B.isoSpec.hom :=
    IsPullback.of_horiz_isIso ⟨Scheme.isoSpec_hom_naturality q⟩
  let f₀ : Spec (.of Γ(A, ⊤)) → ZMod m := fun a => f (A.isoSpec.inv a)
  have hf₀ : IsLocallyConstant f₀ := hf.comp_continuous (A.isoSpec.inv).continuous
  obtain ⟨T₀, hT₀, hspec₀⟩ := H9 m Γ(B, ⊤) Γ(A, ⊤) f₀ hf₀
  refine ⟨fun b => T₀ (B.isoSpec.hom b), hT₀.comp_continuous (B.isoSpec.hom).continuous, ?_⟩
  intro Ω _ _ y
  obtain ⟨ha, hb⟩ := hspec₀ Ω (y ≫ B.isoSpec.hom)
  obtain ⟨hc, hd⟩ := H2 (Spec.map (CommRingCat.ofHom (algebraMap Γ(B, ⊤) Γ(A, ⊤)))) q
    B.isoSpec.hom A.isoSpec.hom hP m Ω y f₀
  refine ⟨hc.mpr ha, ?_⟩
  calc ∑ᶠ x : {x : Spec (.of Ω) ⟶ A // x ≫ q = y}, f (x.1 (IsLocalRing.closedPoint Ω))
      = ∑ᶠ x : {x : Spec (.of Ω) ⟶ A // x ≫ q = y},
          f₀ (A.isoSpec.hom (x.1 (IsLocalRing.closedPoint Ω))) := by
        refine finsum_congr (fun x => ?_)
        show f _ = f (A.isoSpec.inv (A.isoSpec.hom _))
        rw [Scheme.hom_inv_apply]
    _ = _ := hd
    _ = _ := hb
    _ = _ := congrArg T₀ (Scheme.Hom.comp_apply _ _ _)

theorem wc_fet_zariski_glue_lc_trace : (∀ (B : Scheme.{u}) (b : B), ∃ (Ω : Type u) (_ : Field Ω), IsAlgClosed Ω ∧ ∃ y : Spec (.of Ω) ⟶ B, y (IsLocalRing.closedPoint Ω) = b) → (∀ {A B A' B' : Scheme.{u}} (q : A ⟶ B) (q' : A' ⟶ B') (g : B' ⟶ B) (g' : A' ⟶ A), IsPullback g' q' q g → ∀ (m : ℕ) (Ω : Type u) [Field Ω] (y' : Spec (.of Ω) ⟶ B') (f : A → ZMod m), (Finite {x' : Spec (.of Ω) ⟶ A' // x' ≫ q' = y'} ↔ Finite {x : Spec (.of Ω) ⟶ A // x ≫ q = y' ≫ g}) ∧ ∑ᶠ x' : {x' : Spec (.of Ω) ⟶ A' // x' ≫ q' = y'}, f (g' (x'.1 (IsLocalRing.closedPoint Ω))) = ∑ᶠ x : {x : Spec (.of Ω) ⟶ A // x ≫ q = y' ≫ g}, f (x.1 (IsLocalRing.closedPoint Ω))) → ∀ (m : ℕ) {A B : Scheme.{u}} (q : A ⟶ B), (∀ b : B, ∃ U : B.Opens, b ∈ U ∧ ∀ f : (q ⁻¹ᵁ U).toScheme → ZMod m, IsLocallyConstant f → ∃ T : U.toScheme → ZMod m, IsLocallyConstant T ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (y : Spec (.of Ω) ⟶ U.toScheme), Finite {x : Spec (.of Ω) ⟶ (q ⁻¹ᵁ U).toScheme // x ≫ (q ∣_ U) = y} ∧ ∑ᶠ x : {x : Spec (.of Ω) ⟶ (q ⁻¹ᵁ U).toScheme // x ≫ (q ∣_ U) = y}, f (x.1 (IsLocalRing.closedPoint Ω)) = T (y (IsLocalRing.closedPoint Ω))) → ∀ f : A → ZMod m, IsLocallyConstant f → ∃ T : B → ZMod m, IsLocallyConstant T ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (y : Spec (.of Ω) ⟶ B), Finite {x : Spec (.of Ω) ⟶ A // x ≫ q = y} ∧ ∑ᶠ x : {x : Spec (.of Ω) ⟶ A // x ≫ q = y}, f (x.1 (IsLocalRing.closedPoint Ω)) = T (y (IsLocalRing.closedPoint Ω)) :=
by
  classical
  intro H1 H2 m A B q HL f hf
  choose U hU HT using HL
  have hfb : ∀ b, IsLocallyConstant (fun x : (q ⁻¹ᵁ U b).toScheme => f ((q ⁻¹ᵁ U b).ι x)) :=
    fun b => hf.comp_continuous (q ⁻¹ᵁ U b).ι.continuous
  choose Tb hTlc hTspec using fun b => HT b _ (hfb b)
  have key : ∀ (b : B) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (y : Spec (.of Ω) ⟶ B) (b' : B)
      (hb' : b' ∈ U b), y (IsLocalRing.closedPoint Ω) = b' →
      Finite {x : Spec (.of Ω) ⟶ A // x ≫ q = y} ∧
      ∑ᶠ x : {x : Spec (.of Ω) ⟶ A // x ≫ q = y}, f (x.1 (IsLocalRing.closedPoint Ω)) =
        Tb b ⟨b', hb'⟩ := by
    intro b Ω _ _ y b' hb' hy
    have hrange : Set.range y ⊆ Set.range (U b).ι := by
      rw [Scheme.Opens.range_ι]
      rintro z ⟨w, rfl⟩
      rw [Subsingleton.elim w (IsLocalRing.closedPoint Ω), hy]
      exact hb'
    obtain ⟨yU, hyU⟩ : ∃ yU : Spec (.of Ω) ⟶ (U b).toScheme, yU ≫ (U b).ι = y :=
      ⟨IsOpenImmersion.lift (U b).ι y hrange, IsOpenImmersion.lift_fac _ _ _⟩
    subst hyU
    have hpt : yU (IsLocalRing.closedPoint Ω) = ⟨b', hb'⟩ := by
      apply Subtype.ext
      exact (Scheme.Opens.ι_apply (U b) (yU (IsLocalRing.closedPoint Ω))).symm.trans
        ((Scheme.Hom.comp_apply yU (U b).ι (IsLocalRing.closedPoint Ω)).symm.trans hy)
    obtain ⟨hfin, hsum⟩ := H2 q (q ∣_ U b) (U b).ι (q ⁻¹ᵁ U b).ι
      (isPullback_morphismRestrict q (U b)).flip m Ω yU f
    obtain ⟨hfin', hsum'⟩ := hTspec b Ω yU
    exact ⟨hfin.mp hfin', hsum.symm.trans (hsum'.trans (congrArg (Tb b) hpt))⟩
  have compat : ∀ (b b' : B) (h : b' ∈ U b), Tb b ⟨b', h⟩ = Tb b' ⟨b', hU b'⟩ := by
    intro b b' h
    obtain ⟨Ω, _, _, y, hy⟩ := H1 B b'
    rw [← (key b Ω y b' h hy).2, (key b' Ω y b' (hU b') hy).2]
  refine ⟨fun b => Tb b ⟨b, hU b⟩, ?_, ?_⟩
  · rw [IsLocallyConstant.iff_exists_open]
    intro b₀
    refine ⟨(U b₀).ι '' {x | Tb b₀ x = Tb b₀ ⟨b₀, hU b₀⟩}, ?_, ?_, ?_⟩
    · exact (U b₀).ι.isOpenEmbedding.isOpenMap _ ((hTlc b₀).isOpen_fiber _)
    · exact ⟨⟨b₀, hU b₀⟩, rfl, Scheme.Opens.ι_apply _ _⟩
    · rintro z ⟨x, hx, hz⟩
      have hz' : x.1 = z := (Scheme.Opens.ι_apply (U b₀) x).symm.trans hz
      obtain ⟨b', h⟩ := x
      change b' = z at hz'
      subst hz'
      show Tb b' ⟨b', hU b'⟩ = Tb b₀ ⟨b₀, hU b₀⟩
      rw [← compat b₀ b' h]
      exact hx
  · intro Ω _ _ y
    exact key _ Ω y _ (hU _) rfl

theorem wc_finite_etale_lc_trace : ∀ (m : ℕ), ∃ t : ∀ {A B : Scheme.{u}} (q : A ⟶ B), IsFinite q → Etale q → (LocallyConstant A (ZMod m) →+ LocallyConstant B (ZMod m)), (∀ {A B A' B' : Scheme.{u}} (q : A ⟶ B) (q' : A' ⟶ B') (g : B' ⟶ B) (g' : A' ⟶ A), IsPullback g' q' q g → ∀ (h₁ : IsFinite q) (h₂ : Etale q) (h₁' : IsFinite q') (h₂' : Etale q') (f : LocallyConstant A (ZMod m)) (b : B'), t q' h₁' h₂' (f.comap ⟨g', g'.continuous⟩) b = t q h₁ h₂ f (g b)) ∧ (∀ {A B : Scheme.{u}} (q : A ⟶ B) (h₁ : IsFinite q) (h₂ : Etale q) (σ : B ⟶ A), σ ≫ q = 𝟙 B → ∀ f : LocallyConstant A (ZMod m), (∀ a, a ∈ Set.range σ → f a = 1) → (∀ a, a ∉ Set.range σ → f a = 0) → t q h₁ h₂ f = 1) :=
by
  classical
  intro m

  have s1 : ∀ (B : Scheme.{u}) (b : B), ∃ (Ω : Type u) (_ : Field Ω), IsAlgClosed Ω ∧
      ∃ y : Spec (.of Ω) ⟶ B, y (IsLocalRing.closedPoint Ω) = b := by
    intro B b
    refine ⟨AlgebraicClosure (B.residueField b), inferInstance, inferInstance,
      Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b))) :
          B.residueField b ⟶ CommRingCat.of (AlgebraicClosure (B.residueField b))) ≫
        B.fromSpecResidueField b, ?_⟩
    exact Scheme.fromSpecResidueField_apply b _

  have s2 : ∀ {A B A' B' : Scheme.{u}} (q : A ⟶ B) (q' : A' ⟶ B') (g : B' ⟶ B) (g' : A' ⟶ A),
      IsPullback g' q' q g → ∀ (m : ℕ) (Ω : Type u) [Field Ω] (y' : Spec (.of Ω) ⟶ B')
      (f : A → ZMod m), (Finite {x' : Spec (.of Ω) ⟶ A' // x' ≫ q' = y'} ↔
        Finite {x : Spec (.of Ω) ⟶ A // x ≫ q = y' ≫ g}) ∧
      ∑ᶠ x' : {x' : Spec (.of Ω) ⟶ A' // x' ≫ q' = y'}, f (g' (x'.1 (IsLocalRing.closedPoint Ω))) =
        ∑ᶠ x : {x : Spec (.of Ω) ⟶ A // x ≫ q = y' ≫ g}, f (x.1 (IsLocalRing.closedPoint Ω)) := by
    intro A B A' B' q q' g g' hP m Ω _ y' f
    let e : {x' : Spec (.of Ω) ⟶ A' // x' ≫ q' = y'} ≃ {x : Spec (.of Ω) ⟶ A // x ≫ q = y' ≫ g} :=
      { toFun := fun x' => ⟨x'.1 ≫ g', by rw [Category.assoc, hP.w, ← Category.assoc, x'.2]⟩
        invFun := fun x => ⟨hP.lift x.1 y' x.2, hP.lift_snd _ _ _⟩
        left_inv := fun x' => by
          apply Subtype.ext
          apply hP.hom_ext
          · exact hP.lift_fst _ _ _
          · rw [hP.lift_snd]; exact x'.2.symm
        right_inv := fun x => by
          apply Subtype.ext
          exact hP.lift_fst _ _ _ }
    refine ⟨e.finite_iff, ?_⟩
    rw [← finsum_comp_equiv e]
    refine finsum_congr (fun x' => ?_)
    exact congrArg f (Scheme.Hom.comp_apply x'.1 g' (IsLocalRing.closedPoint Ω)).symm

  have s10 := wc_fet_affine_lc_trace (wc_fet_spec_lc_trace (wc_fet_ring_lc_trace
    (wc_fet_card_hom_rankAtStalk wc_fet_field_etale_card_hom) wc_fet_idempotent_away)
    wc_fet_spec_points_algHom) s2
  have s11 := wc_fet_zariski_glue_lc_trace s1 s2

  have G : ∀ {A B : Scheme.{u}} (q : A ⟶ B), IsFinite q → Etale q → ∀ f : A → ZMod m,
      IsLocallyConstant f → ∃ T : B → ZMod m, IsLocallyConstant T ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (y : Spec (.of Ω) ⟶ B),
        Finite {x : Spec (.of Ω) ⟶ A // x ≫ q = y} ∧
        ∑ᶠ x : {x : Spec (.of Ω) ⟶ A // x ≫ q = y}, f (x.1 (IsLocalRing.closedPoint Ω)) =
          T (y (IsLocalRing.closedPoint Ω)) := by
    intro A B q h₁ h₂
    refine s11 m q ?_
    intro b
    obtain ⟨U, hU, hbU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens B)) (show b ∈ (⊤ : B.Opens) from trivial)
    refine ⟨U, hbU, ?_⟩
    haveI : IsAffine U := hU
    haveI : IsFinite q := h₁
    haveI : Etale q := h₂
    haveI : IsAffine (q ⁻¹ᵁ U) := IsAffineOpen.preimage hU q
    exact s10 m (q ∣_ U) inferInstance inferInstance
  have G' : ∀ (A B : Scheme.{u}) (q : A ⟶ B) (h₁ : IsFinite q) (h₂ : Etale q)
      (f : LocallyConstant A (ZMod m)), ∃ T : B → ZMod m, IsLocallyConstant T ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (y : Spec (.of Ω) ⟶ B),
        Finite {x : Spec (.of Ω) ⟶ A // x ≫ q = y} ∧
        ∑ᶠ x : {x : Spec (.of Ω) ⟶ A // x ≫ q = y}, f (x.1 (IsLocalRing.closedPoint Ω)) =
          T (y (IsLocalRing.closedPoint Ω)) :=
    fun A B q h₁ h₂ f => G q h₁ h₂ f f.isLocallyConstant
  choose T hTlc hTspec using G'

  have hadd : ∀ (A B : Scheme.{u}) (q : A ⟶ B) (h₁ : IsFinite q) (h₂ : Etale q)
      (f g : LocallyConstant A (ZMod m)) (b : B),
      T A B q h₁ h₂ (f + g) b = T A B q h₁ h₂ f b + T A B q h₁ h₂ g b := by
    intro A B q h₁ h₂ f g b
    obtain ⟨Ω, _, _, y, rfl⟩ := s1 B b
    obtain ⟨hfin, h1⟩ := hTspec A B q h₁ h₂ f Ω y
    obtain ⟨-, h2⟩ := hTspec A B q h₁ h₂ g Ω y
    obtain ⟨-, h3⟩ := hTspec A B q h₁ h₂ (f + g) Ω y
    haveI := hfin
    rw [← h1, ← h2, ← h3]
    exact finsum_add_distrib (Set.toFinite _) (Set.toFinite _)
  have hzero : ∀ (A B : Scheme.{u}) (q : A ⟶ B) (h₁ : IsFinite q) (h₂ : Etale q) (b : B),
      T A B q h₁ h₂ 0 b = 0 := by
    intro A B q h₁ h₂ b
    obtain ⟨Ω, _, _, y, rfl⟩ := s1 B b
    rw [← (hTspec A B q h₁ h₂ 0 Ω y).2]
    simp only [LocallyConstant.coe_zero, Pi.zero_apply, finsum_zero]
  refine ⟨fun {A B} q h₁ h₂ =>
    { toFun := fun f => ⟨T A B q h₁ h₂ f, hTlc A B q h₁ h₂ f⟩
      map_zero' := LocallyConstant.ext (hzero A B q h₁ h₂)
      map_add' := fun f g => LocallyConstant.ext (hadd A B q h₁ h₂ f g) }, ?_, ?_⟩

  · intro A B A' B' q q' g g' hP h₁ h₂ h₁' h₂' f b
    show T A' B' q' h₁' h₂' (f.comap ⟨g', g'.continuous⟩) b = T A B q h₁ h₂ f (g b)
    obtain ⟨Ω, _, _, y, rfl⟩ := s1 B' b
    have hb : g (y (IsLocalRing.closedPoint Ω)) = (y ≫ g) (IsLocalRing.closedPoint Ω) :=
      (Scheme.Hom.comp_apply _ _ _).symm
    rw [← (hTspec A' B' q' h₁' h₂' _ Ω y).2, hb, ← (hTspec A B q h₁ h₂ f Ω (y ≫ g)).2]
    exact (s2 q q' g g' hP m Ω y f).2

  · intro A B q h₁ h₂ σ hσ f h1 h0
    apply LocallyConstant.ext
    intro b
    show T A B q h₁ h₂ f b = 1
    obtain ⟨Ω, _, _, y, rfl⟩ := s1 B b
    rw [← (hTspec A B q h₁ h₂ f Ω y).2]
    have hx₀ : (y ≫ σ) ≫ q = y := by rw [Category.assoc, hσ, Category.comp_id]
    rw [finsum_eq_single _ (⟨y ≫ σ, hx₀⟩ : {x : Spec (.of Ω) ⟶ A // x ≫ q = y})]
    · apply h1
      exact ⟨y (IsLocalRing.closedPoint Ω), (Scheme.Hom.comp_apply _ _ _).symm⟩
    · intro x hx
      apply h0
      intro hmem
      exact hx (Subtype.ext (wc_fet_section_fibre_unique q σ hσ Ω y x.1 x.2 hmem))

theorem wc_finite_lc_trace_etale_locus : ∀ (m : ℕ), (∃ t : ∀ {A B : Scheme.{u}} (q : A ⟶ B), IsFinite q → Etale q → (LocallyConstant A (ZMod m) →+ LocallyConstant B (ZMod m)), (∀ {A B A' B' : Scheme.{u}} (q : A ⟶ B) (q' : A' ⟶ B') (g : B' ⟶ B) (g' : A' ⟶ A), IsPullback g' q' q g → ∀ (h₁ : IsFinite q) (h₂ : Etale q) (h₁' : IsFinite q') (h₂' : Etale q') (f : LocallyConstant A (ZMod m)) (b : B'), t q' h₁' h₂' (f.comap ⟨g', g'.continuous⟩) b = t q h₁ h₂ f (g b)) ∧ (∀ {A B : Scheme.{u}} (q : A ⟶ B) (h₁ : IsFinite q) (h₂ : Etale q) (σ : B ⟶ A), σ ≫ q = 𝟙 B → ∀ f : LocallyConstant A (ZMod m), (∀ a, a ∈ Set.range σ → f a = 1) → (∀ a, a ∉ Set.range σ → f a = 0) → t q h₁ h₂ f = 1)) → ∃ t : ∀ {A B : Scheme.{u}} (q : A ⟶ B) (D : B.Opens), IsFinite q → (∀ a : A, q a ∈ D → ∃ O : A.Opens, a ∈ O ∧ Etale (O.ι ≫ q)) → (LocallyConstant A (ZMod m) →+ LocallyConstant D (ZMod m)), (∀ {A B A' B' : Scheme.{u}} (q : A ⟶ B) (q' : A' ⟶ B') (g : B' ⟶ B) (g' : A' ⟶ A), IsPullback g' q' q g → ∀ (D : B.Opens) (D' : B'.Opens), (∀ x : B', x ∈ D' → g x ∈ D) → ∀ (h₁ : IsFinite q) (h₂ : ∀ a : A, q a ∈ D → ∃ O : A.Opens, a ∈ O ∧ Etale (O.ι ≫ q)) (h₁' : IsFinite q') (h₂' : ∀ a : A', q' a ∈ D' → ∃ O : A'.Opens, a ∈ O ∧ Etale (O.ι ≫ q')) (f : LocallyConstant A (ZMod m)) (b : D') (hb : g b.1 ∈ D), t q' D' h₁' h₂' (f.comap ⟨g', g'.continuous⟩) b = t q D h₁ h₂ f ⟨g b.1, hb⟩) ∧ (∀ {A B : Scheme.{u}} (q : A ⟶ B) (D : B.Opens) (h₁ : IsFinite q) (h₂ : ∀ a : A, q a ∈ D → ∃ O : A.Opens, a ∈ O ∧ Etale (O.ι ≫ q)) (σ : B ⟶ A), σ ≫ q = 𝟙 B → ∀ f : LocallyConstant A (ZMod m), (∀ a, q a ∈ D → a ∈ interior (Set.range σ) → f a = 1) → (∀ a, q a ∈ D → a ∉ Set.range σ → f a = 0) → t q D h₁ h₂ f = 1) :=
by
  rintro m ⟨tc, NAT, SECT⟩
  haveI hZ : IsZariskiLocalAtSource @Etale := HasRingHomProperty.instIsZariskiLocalAtSource
  have hmemι : ∀ {A B : Scheme.{u}} (q : A ⟶ B) (D : B.Opens) (a : (q ⁻¹ᵁ D : Scheme.{u})),
      q ((q ⁻¹ᵁ D).ι a) ∈ D := by
    intro A B q D a
    first
      | exact a.2
      | (show q a.1 ∈ D; exact a.2)
      | (have e := Scheme.Opens.ι_apply (q ⁻¹ᵁ D) a; rw [e]; exact a.2)
      | (have e := Scheme.Opens.ι_apply (q ⁻¹ᵁ D) a; exact e ▸ a.2)
      | (convert a.2 using 2)

  have s1 : ∀ {A B : Scheme.{u}} (q : A ⟶ B) (D : B.Opens),
      (∀ a : A, q a ∈ D → ∃ O : A.Opens, a ∈ O ∧ Etale (O.ι ≫ q)) → Etale (q ∣_ D) := by
    intro A B q D h₂
    have h' : ∀ a : (q ⁻¹ᵁ D : Scheme.{u}), ∃ O : A.Opens, (q ⁻¹ᵁ D).ι a ∈ O ∧ Etale (O.ι ≫ q) := by
      intro a
      exact h₂ _ (hmemι q D a)
    choose O hO hE using h'
    refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @Etale)
      (fun a => (q ⁻¹ᵁ D).ι ⁻¹ᵁ O a) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hO x⟩
    · intro a
      haveI hr : Etale (((q ⁻¹ᵁ D).ι).resLE (O a) ((q ⁻¹ᵁ D).ι ⁻¹ᵁ O a) le_rfl) := by
        have : Etale ((((q ⁻¹ᵁ D).ι).resLE (O a) ((q ⁻¹ᵁ D).ι ⁻¹ᵁ O a) le_rfl) ≫ (O a).ι) := by
          rw [Scheme.Hom.resLE_comp_ι]; infer_instance
        exact Etale.of_comp _ (O a).ι
      haveI hE' := hE a
      have h3 : Etale ((((q ⁻¹ᵁ D).ι ⁻¹ᵁ O a).ι ≫ q ∣_ D) ≫ D.ι) := by
        rw [Category.assoc, morphismRestrict_ι, ← Category.assoc,
          ← Scheme.Hom.resLE_comp_ι (q ⁻¹ᵁ D).ι
            (le_rfl : (q ⁻¹ᵁ D).ι ⁻¹ᵁ O a ≤ (q ⁻¹ᵁ D).ι ⁻¹ᵁ O a),
          Category.assoc]
        infer_instance
      exact Etale.of_comp _ D.ι

  have s2 : ∀ {A B A' B' : Scheme.{u}} (q : A ⟶ B) (q' : A' ⟶ B') (g : B' ⟶ B) (g' : A' ⟶ A),
      IsPullback g' q' q g → ∀ (D : B.Opens) (D' : B'.Opens) (hD : D' ≤ g ⁻¹ᵁ D)
      (hA : q' ⁻¹ᵁ D' ≤ g' ⁻¹ᵁ (q ⁻¹ᵁ D)),
      IsPullback (g'.resLE (q ⁻¹ᵁ D) (q' ⁻¹ᵁ D') hA) (q' ∣_ D') (q ∣_ D) (g.resLE D D' hD) := by
    intro A B A' B' q q' g g' h D D' hD hA
    have E1 := Scheme.Hom.resLE_comp_ι g' hA
    have E2 := Scheme.Hom.resLE_comp_ι g hD
    have hsq : g'.resLE (q ⁻¹ᵁ D) (q' ⁻¹ᵁ D') hA ≫ q ∣_ D = q' ∣_ D' ≫ g.resLE D D' hD := by
      rw [← cancel_mono D.ι]
      calc _ = g'.resLE _ _ hA ≫ (q ⁻¹ᵁ D).ι ≫ q := by rw [Category.assoc, morphismRestrict_ι]
        _ = (q' ⁻¹ᵁ D').ι ≫ g' ≫ q := by rw [← Category.assoc, E1, Category.assoc]
        _ = (q' ⁻¹ᵁ D').ι ≫ q' ≫ g := by rw [h.toCommSq.w]
        _ = (q' ∣_ D' ≫ D'.ι) ≫ g := by rw [morphismRestrict_ι, Category.assoc]
        _ = _ := by simp only [Category.assoc, ← E2]
    refine IsPullback.of_right ?_ hsq (isPullback_morphismRestrict q D).flip
    rw [E1, E2]
    exact (isPullback_morphismRestrict q' D').flip.paste_horiz h

  have s3 : ∀ {A B : Scheme.{u}} (q : A ⟶ B) (D : B.Opens) (σ : B ⟶ A), Etale (q ∣_ D) →
      σ ≫ q = 𝟙 B → ∃ σD : (D : Scheme.{u}) ⟶ (q ⁻¹ᵁ D : Scheme.{u}),
        σD ≫ (q ∣_ D) = 𝟙 _ ∧
        (∀ a, a ∈ Set.range σD → (q ⁻¹ᵁ D).ι a ∈ interior (Set.range σ)) ∧
        (∀ a, a ∉ Set.range σD → (q ⁻¹ᵁ D).ι a ∉ Set.range σ) := by
    intro A B q D σ hq hσ
    have hP : ∀ b : B, q (σ b) = b := by
      intro b
      have := congrArg (fun h : B ⟶ B => h b) hσ
      simpa using this
    have hσD : D ≤ σ ⁻¹ᵁ (q ⁻¹ᵁ D) := by
      intro b hb
      show q (σ b) ∈ D
      rw [hP]; exact hb
    have E3 := Scheme.Hom.resLE_comp_ι σ hσD
    have E3b : ∀ b : (D : Scheme.{u}),
        (q ⁻¹ᵁ D).ι (σ.resLE (q ⁻¹ᵁ D) D hσD b) = σ (D.ι b) := by
      intro b
      have := congrArg (fun h : (D : Scheme.{u}) ⟶ A => h b) E3
      simpa only [Scheme.Hom.comp_apply] using this
    have hsec : σ.resLE (q ⁻¹ᵁ D) D hσD ≫ q ∣_ D = 𝟙 _ := by
      rw [← cancel_mono D.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, E3,
        Category.assoc, hσ, Category.comp_id, Category.id_comp]
    refine ⟨σ.resLE (q ⁻¹ᵁ D) D hσD, hsec, ?_, ?_⟩
    · have hE : Etale (σ.resLE (q ⁻¹ᵁ D) D hσD) := by
        have : Etale (σ.resLE (q ⁻¹ᵁ D) D hσD ≫ q ∣_ D) := by rw [hsec]; infer_instance
        exact Etale.of_comp _ (q ∣_ D)
      have hopen : IsOpen ((q ⁻¹ᵁ D).ι '' Set.range (σ.resLE (q ⁻¹ᵁ D) D hσD)) :=
        (q ⁻¹ᵁ D).ι.isOpenEmbedding.isOpenMap _ (σ.resLE (q ⁻¹ᵁ D) D hσD).isOpenMap.isOpen_range
      have hsub : (q ⁻¹ᵁ D).ι '' Set.range (σ.resLE (q ⁻¹ᵁ D) D hσD) ⊆ Set.range σ := by
        rintro _ ⟨_, ⟨b, rfl⟩, rfl⟩
        exact ⟨D.ι b, (E3b b).symm⟩
      intro a ha
      exact interior_maximal hsub hopen ⟨a, ha, rfl⟩
    · intro a ha hc
      apply ha
      obtain ⟨b, hb⟩ := hc
      have hbD : b ∈ D := by
        have h1 : q ((q ⁻¹ᵁ D).ι a) ∈ D := hmemι q D a
        rw [← hb, hP] at h1
        exact h1
      obtain ⟨b', hb'⟩ : ∃ b' : (D : Scheme.{u}), D.ι b' = b :=
        ⟨⟨b, hbD⟩, Scheme.Opens.ι_apply _ _⟩
      refine ⟨b', ?_⟩
      apply (q ⁻¹ᵁ D).ι.isOpenEmbedding.injective
      rw [E3b, hb', hb]
  refine ⟨fun {A B} q D h₁ h₂ =>
    (tc (q ∣_ D) (by haveI := h₁; infer_instance) (s1 q D h₂)).comp
      (LocallyConstant.comapAddMonoidHom ⟨(q ⁻¹ᵁ D).ι, (q ⁻¹ᵁ D).ι.continuous⟩), ?_, ?_⟩
  · intro A B A' B' q q' g g' h D D' hDD' h₁ h₂ h₁' h₂' f b hb
    have hf₁ : IsFinite (q ∣_ D) := by haveI := h₁; infer_instance
    have hf₁' : IsFinite (q' ∣_ D') := by haveI := h₁'; infer_instance
    have hD : D' ≤ g ⁻¹ᵁ D := fun x hx => hDD' x hx
    have hw : ∀ a', q (g' a') = g (q' a') := by
      intro a'
      have := congrArg (fun k : A' ⟶ B => k a') h.toCommSq.w
      simpa only [Scheme.Hom.comp_apply] using this
    have hA : q' ⁻¹ᵁ D' ≤ g' ⁻¹ᵁ (q ⁻¹ᵁ D) := by
      intro a' ha'
      show q (g' a') ∈ D
      rw [hw]; exact hDD' _ ha'
    have sq := s2 q q' g g' h D D' hD hA
    have key := NAT (q ∣_ D) (q' ∣_ D') (g.resLE D D' hD) (g'.resLE (q ⁻¹ᵁ D) (q' ⁻¹ᵁ D') hA) sq
      hf₁ (s1 q D h₂) hf₁' (s1 q' D' h₂')
      (f.comap ⟨(q ⁻¹ᵁ D).ι, (q ⁻¹ᵁ D).ι.continuous⟩) b
    have hf : (f.comap ⟨(q ⁻¹ᵁ D).ι, (q ⁻¹ᵁ D).ι.continuous⟩).comap
        ⟨g'.resLE (q ⁻¹ᵁ D) (q' ⁻¹ᵁ D') hA, (g'.resLE (q ⁻¹ᵁ D) (q' ⁻¹ᵁ D') hA).continuous⟩ =
        (f.comap ⟨g', g'.continuous⟩).comap ⟨(q' ⁻¹ᵁ D').ι, (q' ⁻¹ᵁ D').ι.continuous⟩ := by
      ext x
      simp only [LocallyConstant.coe_comap, Function.comp_apply, ContinuousMap.coe_mk]
      have := congrArg (fun k => k x) (Scheme.Hom.resLE_comp_ι g' hA)
      simp only [Scheme.Hom.comp_apply] at this
      rw [this]
    have hpt : g.resLE D D' hD b = ⟨g b.1, hb⟩ := by
      apply (D.ι).isOpenEmbedding.injective
      have hres : ∀ x : (D' : Scheme.{u}), D.ι (g.resLE D D' hD x) = g (D'.ι x) := by
        intro x
        have := congrArg (fun k : (D' : Scheme.{u}) ⟶ B => k x) (Scheme.Hom.resLE_comp_ι g hD)
        simpa only [Scheme.Hom.comp_apply] using this
      refine (hres b).trans ?_
      first
        | rfl
        | simp [Scheme.Opens.ι_apply]
        | (erw [Scheme.Opens.ι_apply, Scheme.Opens.ι_apply])
    calc _ = tc (q' ∣_ D') hf₁' (s1 q' D' h₂')
          ((f.comap ⟨g', g'.continuous⟩).comap ⟨(q' ⁻¹ᵁ D').ι, (q' ⁻¹ᵁ D').ι.continuous⟩) b := rfl
      _ = tc (q' ∣_ D') hf₁' (s1 q' D' h₂')
          ((f.comap ⟨(q ⁻¹ᵁ D).ι, (q ⁻¹ᵁ D).ι.continuous⟩).comap
            ⟨g'.resLE (q ⁻¹ᵁ D) (q' ⁻¹ᵁ D') hA,
              (g'.resLE (q ⁻¹ᵁ D) (q' ⁻¹ᵁ D') hA).continuous⟩) b := by rw [hf]
      _ = tc (q ∣_ D) hf₁ (s1 q D h₂) (f.comap ⟨(q ⁻¹ᵁ D).ι, (q ⁻¹ᵁ D).ι.continuous⟩)
          (g.resLE D D' hD b) := key
      _ = _ := by
        first
          | exact congrArg _ hpt
          | (rw [hpt]; rfl)
  · intro A B q D h₁ h₂ σ hσ f h1 h0
    have hf₁ : IsFinite (q ∣_ D) := by haveI := h₁; infer_instance
    obtain ⟨σD, hsec, hin, hout⟩ := s3 q D σ (s1 q D h₂) hσ
    have hmem : ∀ a : (q ⁻¹ᵁ D : Scheme.{u}), q ((q ⁻¹ᵁ D).ι a) ∈ D := fun a => hmemι q D a
    exact SECT (q ∣_ D) hf₁ (s1 q D h₂) σD hsec
      (f.comap ⟨(q ⁻¹ᵁ D).ι, (q ⁻¹ᵁ D).ι.continuous⟩)
      (fun a ha => h1 _ (hmem a) (hin a ha)) (fun a ha => h0 _ (hmem a) (hout a ha))

theorem wc_et_generic_trace_lc : ∀ (K : Type u) [Field K] (d : ℕ) (Y' : Scheme.{u}) (p : Y' ⟶ wcProjK K d), IsFinite p → IrreducibleSpace Y' → ∀ (W : Y'.Opens), Nonempty W → Etale (W.ι ≫ p) → ∀ (m : ℕ), ∃ t : ∀ V : (wcProjK K d).Etale, LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m) →+ LocallyConstant V.left (ZMod m), (∀ (V V' : (wcProjK K d).Etale) (g : V' ⟶ V) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m)) (x : V'.left), t V' (f.comap ⟨((wcEtBaseChange p).map g).left, ((wcEtBaseChange p).map g).left.continuous⟩) x = t V f (g.left x)) ∧ (∀ (V : (wcProjK K d).Etale) (σ : V.left ⟶ Y') (hσ : σ ≫ p = V.hom) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod m)), (∀ z, z ∈ interior (Set.range (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ (by rw [Category.id_comp, hσ]))) → f z = 1) → (∀ z, z ∉ Set.range (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ (by rw [Category.id_comp, hσ])) → f z = 0) → t V f = 1) :=
by
  intro K _ d Y' p hp hirr W hW hWet m
  haveI : IsFinite p := hp
  haveI : IrreducibleSpace (wcProjK K d) := wc_proj_space_irreducible K d

  obtain ⟨U, hUW, hUd⟩ := wc_finite_generic_etale_open_dense p hp hirr W hW hWet
  obtain ⟨t', t'nat, t'sec⟩ := wc_finite_lc_trace_etale_locus m (wc_finite_etale_lc_trace m)

  have s8 : ∀ (V : (wcProjK K d).Etale),
      Etale ((Limits.pullback.snd V.hom p ⁻¹ᵁ W).ι ≫ Limits.pullback.fst V.hom p) := by
    intro V
    have h1 := isPullback_morphismRestrict (Limits.pullback.snd V.hom p) W
    have h2 := (IsPullback.of_hasPullback V.hom p).flip
    have h3 := h1.paste_vert h2
    exact MorphismProperty.of_isPullback (P := @Etale) h3 hWet

  have s9 : ∀ {V V' : Scheme.{u}} (v : V ⟶ wcProjK K d) (v' : V' ⟶ wcProjK K d) (g : V' ⟶ V)
      (hg : g ≫ v = v'), IsPullback (Limits.pullback.lift (Limits.pullback.fst v' p ≫ g)
        (Limits.pullback.snd v' p) (by rw [Category.assoc, hg, Limits.pullback.condition]))
        (Limits.pullback.fst v' p) (Limits.pullback.fst v p) g := by
    intro V V' v v' g hg
    subst hg
    refine IsPullback.of_right ?_ (Limits.pullback.lift_fst _ _ _)
      (IsPullback.of_hasPullback v p).flip
    rw [Limits.pullback.lift_snd]
    exact (IsPullback.of_hasPullback (g ≫ v) p).flip

  have s4 : ∀ {T : Type u} [TopologicalSpace T] (D : TopologicalSpace.Opens T), Dense (D : Set T) →
      (∀ t : T, ∃ N : Set T, IsOpen N ∧ t ∈ N ∧ IsIrreducible N) →
      ∃ E : LocallyConstant D (ZMod m) →+ LocallyConstant T (ZMod m),
        (∀ (g : LocallyConstant D (ZMod m)) (x : D), E g x = g x) ∧
        (∀ f₁ f₂ : LocallyConstant T (ZMod m), (∀ x : D, f₁ x = f₂ x) → f₁ = f₂) := by
    intro T _ D hD hli
    have huniq : ∀ f₁ f₂ : LocallyConstant T (ZMod m), (∀ x : D, f₁ x = f₂ x) → f₁ = f₂ := by
      intro f₁ f₂ h
      ext t
      have hU : IsOpen ({s | f₁ s = f₁ t} ∩ {s | f₂ s = f₂ t}) :=
        (f₁.isLocallyConstant.isOpen_fiber _).inter (f₂.isLocallyConstant.isOpen_fiber _)
      obtain ⟨x, ⟨hx1, hx2⟩, hxD⟩ := hD.inter_open_nonempty _ hU ⟨t, rfl, rfl⟩
      have hx := h ⟨x, hxD⟩
      simp only [Set.mem_setOf_eq] at hx1 hx2
      rw [← hx1, ← hx2]
      exact hx
    have hex : ∀ g : LocallyConstant D (ZMod m), ∃ f : LocallyConstant T (ZMod m),
        ∀ x : D, f x = g x := by
      intro g
      choose N hNo hNt hNi using hli
      have hconst : ∀ (t : T) (x y : D), x.1 ∈ N t → y.1 ∈ N t → g x = g y := by
        intro t x y hx hy
        have hpre : IsPreirreducible ((Subtype.val : D → T) ⁻¹' N t) :=
          (hNi t).isPreirreducible.preimage D.isOpen.isOpenEmbedding_subtypeVal
        exact g.isLocallyConstant.apply_eq_of_isPreconnected hpre.isPreconnected hx hy
      have hpt : ∀ t, ∃ x : D, x.1 ∈ N t := by
        intro t
        obtain ⟨x, hxN, hxD⟩ := hD.inter_open_nonempty (N t) (hNo t) ⟨t, hNt t⟩
        exact ⟨⟨x, hxD⟩, hxN⟩
      choose pt hpt using hpt
      have hloc : ∀ s t, s ∈ N t → g (pt s) = g (pt t) := by
        intro s t hs
        obtain ⟨x, ⟨hxs, hxt⟩, hxD⟩ :=
          hD.inter_open_nonempty (N s ∩ N t) ((hNo s).inter (hNo t)) ⟨s, hNt s, hs⟩
        rw [hconst s (pt s) ⟨x, hxD⟩ (hpt s) hxs, hconst t ⟨x, hxD⟩ (pt t) hxt (hpt t)]
      refine ⟨⟨fun t => g (pt t), ?_⟩, ?_⟩
      · rw [IsLocallyConstant.iff_exists_open]
        intro t
        exact ⟨N t, hNo t, hNt t, fun s hs => hloc s t hs⟩
      · intro x
        show g (pt x.1) = g x
        exact hconst x.1 (pt x.1) x (hpt x.1) (hNt x.1)
    choose E hE using hex
    refine ⟨{ toFun := E, map_zero' := ?_, map_add' := ?_ }, hE, huniq⟩
    · apply huniq
      intro x
      rw [hE]
      rfl
    · intro g₁ g₂
      apply huniq
      intro x
      rw [hE]
      simp [hE]

  have hloc : ∀ (V : (wcProjK K d).Etale) (a : ↥(Limits.pullback V.hom p : Scheme.{u})),
      Limits.pullback.fst V.hom p a ∈ V.hom ⁻¹ᵁ U →
        ∃ O : Scheme.Opens (Limits.pullback V.hom p : Scheme.{u}), a ∈ O ∧
          Etale (O.ι ≫ Limits.pullback.fst V.hom p) := by
    intro V a ha
    refine ⟨Limits.pullback.snd V.hom p ⁻¹ᵁ W, ?_, s8 V⟩
    have hc : p (Limits.pullback.snd V.hom p a) = V.hom (Limits.pullback.fst V.hom p a) := by
      have h := congrArg (fun h : (Limits.pullback V.hom p : Scheme.{u}) ⟶ wcProjK K d => h a)
        (Limits.pullback.condition (f := V.hom) (g := p))
      simpa using h.symm
    show Limits.pullback.snd V.hom p a ∈ W
    have hmem : Limits.pullback.snd V.hom p a ∈ p ⁻¹ᵁ U := by
      show p (Limits.pullback.snd V.hom p a) ∈ U
      rw [hc]
      exact ha
    exact hUW hmem

  have hli : ∀ (V : (wcProjK K d).Etale) (v : V.left),
      ∃ N : Set V.left, IsOpen N ∧ v ∈ N ∧ IsIrreducible N := by
    intro V v
    obtain ⟨N, hvN, hN⟩ := wc_et_over_proj_locally_irreducible K d V v
    exact ⟨N, N.isOpen, hvN, hN⟩

  have hD : ∀ V : (wcProjK K d).Etale, Dense ((V.hom ⁻¹ᵁ U : V.left.Opens) : Set V.left) :=
    fun V => hUd V
  choose E hEs hEu using fun V : (wcProjK K d).Etale => s4 (V.hom ⁻¹ᵁ U) (hD V) (hli V)
  let r : ∀ V : (wcProjK K d).Etale,
