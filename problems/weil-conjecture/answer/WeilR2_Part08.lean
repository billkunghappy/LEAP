  have hεkk : ∀ k, wcSgE K m k k = 1 := by
    intro k
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (m + 1), (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) K) ∈
