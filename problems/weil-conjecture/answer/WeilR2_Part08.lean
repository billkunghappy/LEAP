theorem wc_pp_segre : ∀ (K : Type u) [Field K] (N m : ℕ), ∃ (N' : ℕ) (σ : Limits.pullback (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))) (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)))) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) K) MvPolynomial.gradedAlgebra), IsClosedImmersion σ ∧ σ ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) K 0))) = Limits.pullback.fst _ _ ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) :=
by
  have hres : ∀ (X : Scheme.{u}) (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
      X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op x) =
        X.presheaf.map (homOfLE h3).op x := by
    intro X A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl

  have UQ : ∀ (P S : Scheme.{u}) (q : P ⟶ S) {ι : Type} (D : ι → P.Opens), (∀ J, IsAffineOpen (D J)) →
      ∀ (ε : ∀ J, ι → Γ(P, D J)), (∀ J (x : Γ(P, D J)), x ∈ Subring.closure (Set.range (ε J) ∪
        Set.range (fun c : Γ(S, ⊤) => P.presheaf.map (homOfLE (le_top : D J ≤ ⊤)).op (q.appTop c)))) →
      ∀ (W : Scheme.{u}) (g g' : W ⟶ P) (t : ι → Γ(W, ⊤)), g ≫ q = g' ≫ q →
