  let T : ∀ V : X.Etale, (wcEtZModRing Y' ℓ).obj.obj (Opposite.op ((wcEtBaseChange p).obj V)) →+
      (wcEtZModRing X ℓ).obj.obj (Opposite.op V) := fun V =>
    (eX V).symm.toRingHom.toAddMonoidHom.comp
      ((t V).comp (eY ((wcEtBaseChange p).obj V)).toRingHom.toAddMonoidHom)
