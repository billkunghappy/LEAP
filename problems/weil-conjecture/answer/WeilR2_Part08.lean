            (wcEtPull Dj 1 (wcEtPull D2 1 β)) (zero_add 1) := by rw [IsIso.inv_hom_id]
      _ = 0 := by rw [← Abelian.Ext.mk₀_comp_mk₀_assoc, h2, Abelian.Ext.comp_zero]
  have hβ : β = 0 := by
    apply wc_et_pull_id_injective Did 1 β
    rw [wc_et_pull_comp (Limits.pullback.snd fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) j (𝟙 _) hj2 D2 Dj Did 1 β]
    exact hy
  exact hκ c (hβ_def.symm.trans hβ)

theorem wc_et_gm_coh_one_nondegenerate_class : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∃ κ : wcEtZModExt (Spec (.of (LaurentPolynomial K))) ℓ 1, ∀ c : ZMod ℓ, c.val • κ = 0 → c = 0 :=
by
  intro K _ _ ℓ _ hℓ
  classical
  have hp : ℓ.Prime := Fact.out
  have hℓpos : 0 < ℓ := hp.pos
  haveI : NeZero ℓ := ⟨hp.ne_zero⟩

  have s1 : ∀ w : LaurentPolynomial K, w ^ ℓ ≠ LaurentPolynomial.T 1 := by
    intro w hw
    obtain ⟨n, f, hf⟩ := LaurentPolynomial.exists_T_pow w
    have h1 : Polynomial.toLaurent (f ^ ℓ) =
        Polynomial.toLaurent (Polynomial.X ^ (ℓ * n + 1) : Polynomial K) := by
      rw [map_pow, hf, mul_pow, hw, LaurentPolynomial.T_pow, ← LaurentPolynomial.T_add,
        Polynomial.toLaurent_X_pow]
      congr 1
      push_cast
      ring
    have h2 : f ^ ℓ = Polynomial.X ^ (ℓ * n + 1) := Polynomial.toLaurent_injective h1
    have h3 := congrArg Polynomial.natDegree h2
    rw [Polynomial.natDegree_pow, Polynomial.natDegree_X_pow] at h3
    have h4 : ℓ ∣ ℓ * n + 1 := h3 ▸ dvd_mul_right ℓ _
    have h5 : ℓ ∣ 1 := (Nat.dvd_add_right (dvd_mul_right ℓ n)).mp h4
    exact hp.one_lt.ne' (Nat.dvd_one.mp h5)

  let a : (Γ(Spec (.of (LaurentPolynomial K)), ⊤))ˣ :=
    ((LaurentPolynomial.isUnit_T (R := K) 1).map
      (Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial K))).inv.hom).unit
  have ha : (a : Γ(Spec (.of (LaurentPolynomial K)), ⊤)) =
      (Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial K))).inv.hom (LaurentPolynomial.T 1) :=
    IsUnit.unit_spec _
  have hnot : ∀ u : (Γ(Spec (.of (LaurentPolynomial K)), ⊤))ˣ,
      (u : Γ(Spec (.of (LaurentPolynomial K)), ⊤)) ^ ℓ ≠ (a : Γ(Spec (.of (LaurentPolynomial K)), ⊤)) := by
    intro u hu
    apply s1 ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial K))).hom.hom
      (u : Γ(Spec (.of (LaurentPolynomial K)), ⊤)))
    rw [← map_pow, hu, ha]
    exact CommRingCat.hom_inv_apply (Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial K))) _

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of (LaurentPolynomial K))))
    AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI := wc_et_enough_injectives (Spec (.of (LaurentPolynomial K)))
  let I := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology
    (Spec (.of (LaurentPolynomial K)))) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))
  obtain ⟨ζ, hζ, hroot⟩ := wc_et_kummer_unit_cocycle K (Spec (.of (LaurentPolynomial K)))
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) ℓ hℓ I a
  have he : I.extMk ζ 2 rfl hζ ≠ 0 := by
    intro h0
    obtain ⟨g, hg⟩ := (InjectiveResolution.extMk_eq_zero_iff I ζ 2 rfl hζ 0 rfl).mp h0
    have hd : ((I.cocomplex.d 0 1).hom.app (Opposite.op
        (Scheme.Etale.mk (𝟙 (Spec (.of (LaurentPolynomial K))))))).hom
        ((g.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of (LaurentPolynomial K))))))).hom
          (wcConstSec (Spec (.of (LaurentPolynomial K))) (ULift.{u+1} ℤ)
            (Scheme.Etale.mk (𝟙 (Spec (.of (LaurentPolynomial K))))) (ULift.up 1))) =
        (ζ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of (LaurentPolynomial K))))))).hom
          (wcConstSec (Spec (.of (LaurentPolynomial K))) (ULift.{u+1} ℤ)
            (Scheme.Etale.mk (𝟙 (Spec (.of (LaurentPolynomial K))))) (ULift.up 1)) := by
      rw [← hg]
      rfl
    obtain ⟨u, hu⟩ := hroot _ _ hd
    apply hnot u
    refine hu.trans ?_
    show (𝟙 (Spec (.of (LaurentPolynomial K))) : Spec (.of (LaurentPolynomial K)) ⟶ _).appTop.hom
      (a : Γ(Spec (.of (LaurentPolynomial K)), ⊤)) = _
    rw [Scheme.Hom.id_appTop]
    rfl
  have hN : Nontrivial (wcEtCoh (Spec (.of (LaurentPolynomial K))) ℓ 1) := by
    have h := nontrivial_of_ne _ _ he
    exact h

  obtain ⟨E⟩ := wc_et_zmodext_coh_equiv (Spec (.of (LaurentPolynomial K))) ℓ 1
  haveI : Nontrivial (wcEtZModExt (Spec (.of (LaurentPolynomial K))) ℓ 1) := E.nontrivial
  obtain ⟨κ, hκ⟩ := exists_ne (0 : wcEtZModExt (Spec (.of (LaurentPolynomial K))) ℓ 1)

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Spec (.of (LaurentPolynomial K))) ℓ)) :=
    HasExt.standard _
  have htors : ∀ (k : ℕ) (y : wcEtZModExt (Spec (.of (LaurentPolynomial K))) ℓ k), ℓ • y = 0 := by
    intro k y
    have h := (wc_et_zmod_unit_pow_exact (Spec (.of (LaurentPolynomial K))) ℓ 1 hℓpos).1
    rw [pow_one] at h
    have hmk : ∀ k' : ℕ, Abelian.Ext.mk₀ (k' • 𝟙 (SheafOfModules.unit
        (wcEtZModRing (Spec (.of (LaurentPolynomial K))) ℓ))) =
        k' • Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit
          (wcEtZModRing (Spec (.of (LaurentPolynomial K))) ℓ))) := by
      intro k'
      induction k' with
      | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
      | succ k' ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
    have hlin := map_nsmul (Abelian.Ext.bilinearComp
      (SheafOfModules.unit (wcEtZModRing (Spec (.of (LaurentPolynomial K))) ℓ))
      (SheafOfModules.unit (wcEtZModRing (Spec (.of (LaurentPolynomial K))) ℓ))
      (SheafOfModules.unit (wcEtZModRing (Spec (.of (LaurentPolynomial K))) ℓ))
      k 0 k (add_zero _) y) ℓ
      (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing (Spec (.of (LaurentPolynomial K))) ℓ))))
    simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
    rw [Abelian.Ext.comp_mk₀_id] at hlin
    rw [← hlin, ← hmk, h, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  refine ⟨κ, fun c hc => ?_⟩
  have h1 : addOrderOf κ ∣ ℓ := addOrderOf_dvd_of_nsmul_eq_zero (htors 1 κ)
  have h2 : addOrderOf κ ≠ 1 := fun h => hκ (AddMonoid.addOrderOf_eq_one_iff.mp h)
  have h3 : addOrderOf κ = ℓ := (hp.eq_one_or_self_of_dvd _ h1).resolve_left h2
  have h4 : ℓ ∣ c.val := by
    have h := addOrderOf_dvd_of_nsmul_eq_zero hc
    rwa [h3] at h
  rw [← ZMod.natCast_zmod_val c]
  exact (ZMod.natCast_eq_zero_iff c.val ℓ).mpr h4

theorem wc_ext_extMk_iota_zero : ∀ {C : Type*} [Category C] [Abelian C] {X A : C} (I : InjectiveResolution A) (f : X ⟶ A) (h : (f ≫ I.ι.f 0) ≫ I.cocomplex.d 0 (0 + 1) = 0), letI := HasExt.standard C; I.extMk (f ≫ I.ι.f 0) (0 + 1) rfl h = Abelian.Ext.mk₀ f :=
by
  intro C _ _ X A I f h
  letI := HasExt.standard C
  obtain ⟨g, hg⟩ : ∃ g : A ⟶ I.cocomplex.X 0, g = I.ι.f 0 := ⟨_, rfl⟩
  have hg0 : g ≫ I.cocomplex.d 0 (0 + 1) = 0 := by rw [hg]; exact I.ι_f_zero_comp_complex_d
  have hE : ∀ (q' : ℤ) (hq' : ((0 : ℕ) : ℤ) + 1 = q')
      (hf : (g ≫ (I.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv) ≫
        I.cochainComplex.d ((0 : ℕ) : ℤ) q' = 0),
      CochainComplex.HomComplex.Cocycle.equivHomShift.symm
        (CochainComplex.HomComplex.Cocycle.fromSingleMk
          (g ≫ (I.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv)
          (zero_add ((0 : ℕ) : ℤ)) q' hq' hf) =
        CategoryTheory.ShiftedHom.mk₀ ((0 : ℕ) : ℤ) Nat.cast_zero I.ι' := by
    intro q' hq' hf
    apply HomologicalComplex.from_single_hom_ext
    rw [CochainComplex.HomComplex.Cocycle.equivHomShift_symm_apply,
      CochainComplex.HomComplex.Cocycle.homOf_f, CochainComplex.HomComplex.Cocycle.rightShift_coe,
      CochainComplex.HomComplex.Cochain.rightShift_v _ _ _ _ 0 0 (by simp) ((0 : ℕ) : ℤ) (by simp),
      CochainComplex.HomComplex.Cocycle.fromSingleMk_coe,
      CochainComplex.HomComplex.Cochain.fromSingleMk_v]
    simp [ShiftedHom.mk₀, InjectiveResolution.ι'_f_zero, shiftFunctorZero',
      CochainComplex.shiftFunctorZero_inv_app_f]
    subst hg
    rfl
  have hid : I.extMk g (0 + 1) rfl hg0 = Abelian.Ext.mk₀ (𝟙 A) := by
    let _ := HasDerivedCategory.standard C
    apply Abelian.Ext.ext
    rw [InjectiveResolution.extMk_hom, hE, ShiftedHom.map_mk₀, ShiftedHom.mk₀_comp_mk₀,
      ShiftedHom.mk₀_comp_mk₀, Abelian.Ext.mk₀_hom, CategoryTheory.Functor.map_id]
    congr 1
    simp
  have h1 := I.mk₀_comp_extMk g (0 + 1) rfl hg0 f
  rw [hid] at h1
  subst hg
  exact h1.symm.trans (Abelian.Ext.comp_mk₀_id _)

theorem wc_et_gm_kunneth_surj : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∃ κ : wcEtZModExt (Spec (.of (LaurentPolynomial K))) ℓ 1, ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d fX] (Q : Scheme.{u}) (r : Q ⟶ X) (t : Q ⟶ Spec (.of (LaurentPolynomial K))), IsPullback r t fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) → ∀ (Dr : wcEtPullData r ℓ) (Dt : wcEtPullData t ℓ), (∀ γ : wcEtZModExt Q ℓ 0, ∃ γ0, γ = wcEtPull Dr 0 γ0) ∧ ∀ (k : ℕ) (γ : wcEtZModExt Q ℓ (k + 1)), ∃ (γ0 : wcEtZModExt X ℓ (k + 1)) (γ1 : wcEtZModExt X ℓ k), γ = wcEtPull Dr (k + 1) γ0 + wcEtZModCup Q ℓ k 1 (k + 1) rfl (wcEtPull Dr k γ1) (wcEtPull Dt 1 κ) :=
by
  classical
  intro K _ _ ℓ _ hℓ

  obtain ⟨κ, hκ⟩ := wc_et_gm_coh_one_nondegenerate_class K ℓ hℓ
  refine ⟨κ, ?_⟩
  intro X fX d _ Q r t hQ Dr Dt
  haveI : Smooth fX := SmoothOfRelativeDimension.smooth d fX

  have hid : ∀ {S : Scheme.{u}} (E : wcEtPullData (𝟙 S) ℓ) (i : ℕ) (y : wcEtZModExt S ℓ i),
      wcEtPull E i y = y := by
    intro S E i y
    have h1 := wc_et_pull_comp (𝟙 S) (𝟙 S) (𝟙 S) (Category.id_comp _) E E E i y
    apply sub_eq_zero.mp
    apply wc_et_pull_id_injective E i
    rw [map_sub, ← h1, sub_self]

  have hmul : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n) (a b c : ℕ)
      (hc : a + b = c) (x : wcEtZModExt S n a) (y : wcEtZModExt S n b),
      wcEtPull D c (wcEtZModCup S n a b c hc x y) =
        wcEtZModCup S' n a b c hc (wcEtPull D a x) (wcEtPull D b y) := by
    intro S S' g n D a b c hc x y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hc)).comp (Abelian.Ext.mk₀ D.μ.hom)
          (add_zero c)) (zero_add c) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        (zero_add a)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) hc
    rw [Abelian.Ext.mapExactFunctor_comp]
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) (zero_add b) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b) := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.hom) (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (add_zero 0) (zero_add b) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    symm
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (zero_add a) hc (by omega),
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x) (Abelian.Ext.mk₀ D.μ.hom)
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (add_zero a) (zero_add b) (by omega),
      e1,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x)
        (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) hc (add_zero b)
        (by omega)]

  obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ
  obtain ⟨Dτ⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ)) := HasExt.standard _
  haveI := Dπ.additive
  haveI := Dπ.presLim
  haveI := Dπ.presColim
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _
      Dπ.cont Dπ.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ Dπ.adj Dπ.additive
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology _) _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology _) _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives _
  have hστ : ∀ (m : ℕ) (z : wcEtZModExt (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ m),
      (Abelian.Ext.mk₀ Dπ.μ.inv).comp ((Abelian.Ext.mk₀ Dπ.μ.hom).comp z (zero_add m))
        (zero_add m) = z := by
    intro m z
    rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ Dπ.μ.inv) (Abelian.Ext.mk₀ Dπ.μ.hom) z
      (add_zero 0) (zero_add m) (show 0 + 0 + m = m by omega), Abelian.Ext.mk₀_comp_mk₀,
      Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]

  have hC0 : ∀ γ : wcEtZModExt (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ 0,
      ∃ γ0, γ = wcEtPull Dπ 0 γ0 := by
    intro γ
    obtain ⟨I⟩ : Nonempty (InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ))) :=
      ⟨InjectiveResolution.of _⟩
    have hsurj := wc_ext_truncated_leray_surj Dπ.Φ
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _ Dπ.cont Dπ.φ)
      Dπ.adj (SheafOfModules.unit (wcEtZModRing X ℓ))
      (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ)) Dπ.μ I 0
      (wc_et_gm_push_unit_iso K X fX ℓ Dπ) (fun n hn1 hnN => absurd hnN (by omega)) 0 le_rfl
    obtain ⟨b, hb⟩ := hsurj ((Abelian.Ext.mk₀ Dπ.μ.hom).comp γ (zero_add 0))
    refine ⟨b, ?_⟩
    beta_reduce at hb
    show γ = (Abelian.Ext.mk₀ Dπ.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dπ.Φ b).comp
      (Abelian.Ext.mk₀ Dπ.μ.hom) (add_zero 0)) (zero_add 0)
    rw [hb, hστ]

  have hCp : ∀ (k : ℕ) (γ : wcEtZModExt (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ (k + 1)),
      ∃ (γ0 : wcEtZModExt X ℓ (k + 1)) (γ1 : wcEtZModExt X ℓ k),
      γ = wcEtPull Dπ (k + 1) γ0 + wcEtZModCup (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ k 1 (k + 1) rfl
        (wcEtPull Dπ k γ1) (wcEtPull Dτ 1 κ) := by
    intro k γ
    obtain ⟨I⟩ : Nonempty (InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ))) :=
      ⟨InjectiveResolution.of _⟩
    obtain ⟨g1, hg1, hg1E⟩ : ∃ (g : Dπ.Φ.obj (SheafOfModules.unit (wcEtZModRing X ℓ)) ⟶
        I.cocomplex.X 1) (hg : g ≫ I.cocomplex.d 1 (1 + 1) = 0),
        I.extMk g (1 + 1) rfl hg =
          (Abelian.Ext.mk₀ Dπ.μ.hom).comp (wcEtPull Dτ 1 κ) (zero_add 1) :=
      InjectiveResolution.extMk_surjective I _ (1 + 1) rfl
    let g0 : Dπ.Φ.obj (SheafOfModules.unit (wcEtZModRing X ℓ)) ⟶ I.cocomplex.X 0 :=
      Dπ.μ.hom ≫ I.ι.f 0
    have hg : ∀ (n : ℕ) (i : Fin (wcGmLHRank n)),
        wcGmLHGen (Kx := I.cocomplex.X) g0 g1 n i ≫ I.cocomplex.d n (n + 1) = 0 := by
      intro n i
      match n, i with
      | 0, _ =>
        show (Dπ.μ.hom ≫ I.ι.f 0) ≫ I.cocomplex.d 0 1 = 0
        first
          | exact (Category.assoc _ _ _).trans ((congrArg (fun z => Dπ.μ.hom ≫ z)
              I.ι_f_zero_comp_complex_d).trans Limits.comp_zero)
          | (erw [Category.assoc, I.ι_f_zero_comp_complex_d]; exact Limits.comp_zero)
      | 1, _ => exact hg1
      | _ + 2, i => exact i.elim0
    have hf : ∀ (n : ℕ) (i : Fin (wcGmLHRank n)),
        Dπ.adj.homEquiv _ _ (wcGmLHGen (Kx := I.cocomplex.X) g0 g1 n i) ≫
          (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
            (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _
            Dπ.cont Dπ.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d n (n + 1)
          = 0 := by
      intro n i
      rw [Functor.mapHomologicalComplex_obj_d, ← Adjunction.homEquiv_naturality_right, hg n i,
        Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]

    let J := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
