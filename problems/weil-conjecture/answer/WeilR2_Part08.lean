  have hqpt : (ι ≫ qB) (IsLocalRing.closedPoint
      (AlgebraicClosure ((wcHalA1 (b ≫ s)).residueField (ã (IsLocalRing.closedPoint B))))) =
      IsLocalRing.closedPoint B :=
