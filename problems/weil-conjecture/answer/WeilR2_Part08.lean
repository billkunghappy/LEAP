    funext j
    simp only [Function.comp_apply, Matrix.mulVec, dotProduct, Matrix.map_apply, map_sum, map_mul,
      Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
  have hΦπ : ∀ P, Φ P ≫ AffineSpace (ULift.{u} (Fin c)) G ↘ G = AffineSpace (ULift.{u} (Fin c)) G ↘ G := by
