          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) V.hom).hom x)
      ((Limits.pullbackRightPullbackFstIso fT
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) V.hom).hom y)
      (by rw [he, he, hxy])
    rw [LocallyConstant.coe_comap_apply, LocallyConstant.coe_comap_apply] at key
    simpa only [ContinuousMap.coe_mk, Scheme.hom_inv_apply] using key
  have hcσ : ∀ v, Limits.pullback.fst V.hom
      (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) (σ v) = v := by
    intro v
    rw [← Scheme.Hom.comp_apply, hσ]
    rfl
  refine ⟨fun a b hab => LocallyConstant.comap_injective _ (fun v => ⟨σ v, hcσ v⟩) hab,
    fun h => ⟨h.comap ⟨σ, σ.continuous⟩, ?_⟩⟩
  apply LocallyConstant.ext
  intro w
  show h (σ (Limits.pullback.fst V.hom
    (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) w)) = h w
  exact hfib h _ _ (hcσ _)

theorem wc_et_affine_line_push_acyclic : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [LocallyOfFiniteType fX] (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (n : ℕ), 1 ≤ n → Limits.IsZero ((((wcEtPush (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) :=
by
  classical
  intro K _ _ ℓ hℓ hℓK X fX _ I n hn
  haveI hπaff : IsAffineHom (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback fX _).flip inferInstance
  apply wc_et_stalks_zero
  intro b
  obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, -, -⟩ :=
    wc_et_geom_strict_henselization b
  obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) b Λ W' hinit I.cocomplex n
  obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) A Λ
    (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt X b)) (Scheme.Etale.forget X)) φ a
    haff hφ hφa hlim ℓ I n
  obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
    ((Limits.pullbackSymmetry (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) a).hom ≫
      (Limits.pullbackRightPullbackFstIso fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) a).hom) ℓ n
  haveI := wc_et_henselian_affine_line_acyclic K ℓ hℓ hℓK A (a ≫ fX) n hn
  exact (E₁.trans (E₂.trans E₃.symm)).subsingleton

theorem wc_rightDerived_exact_conj_iso : ∀ {C C' D D' : Type*} [Category C] [Category C'] [Category D] [Category D'] [Abelian C] [Abelian C'] [Abelian D] [Abelian D'] [HasInjectiveResolutions C] [HasInjectiveResolutions C'] (F : C ⥤ D) [F.Additive] (F' : C' ⥤ D') [F'.Additive] [Limits.PreservesFiniteLimits F'] (E : C ⥤ C') [E.Additive] [Limits.PreservesFiniteLimits E] [Limits.PreservesFiniteColimits E] (E' : D ⥤ D') [E'.Additive] [Limits.PreservesFiniteLimits E'] [Limits.PreservesFiniteColimits E'], Nonempty (F ⋙ E' ≅ E ⋙ F') → (∀ (I : C) [Injective I] (n : ℕ), Limits.IsZero ((F'.rightDerived (n + 1)).obj (E.obj I))) → ∀ (X : C) (q : ℕ), Nonempty ((F'.rightDerived q).obj (E.obj X) ≅ E'.obj ((F.rightDerived q).obj X)) :=
by
  intro C C' D D' _ _ _ _ _ _ _ _ _ _ F _ F' _ _ E _ _ _ E' _ _ _ hβ hacyc X q
  obtain ⟨β⟩ := hβ

  have hles : ∀ (R : C' ⥤ D') [R.Additive] [Limits.PreservesFiniteLimits R] (S : ShortComplex C'), S.ShortExact → (∀ (q : ℕ) {X Y : C'} (a b : X ⟶ Y), (R.rightDerived q).map (a - b) = (R.rightDerived q).map a - (R.rightDerived q).map b) ∧ Mono ((R.rightDerived 0).map S.f) ∧ ∀ q : ℕ, (∃ h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0, (ShortComplex.mk _ _ h0).Exact) ∧ ∃ (δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁) (h1 : (R.rightDerived q).map S.g ≫ δ = 0) (h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0), (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact := by
    intro R _ _ S hS

    have hadd : ∀ (q : ℕ) {X Y : C'} (a b : X ⟶ Y),
        (R.rightDerived q).map (a - b) = (R.rightDerived q).map a - (R.rightDerived q).map b := by
      intro q X Y a b
      have ha := InjectiveResolution.desc_commutes a (injectiveResolution Y) (injectiveResolution X)
      have hb := InjectiveResolution.desc_commutes b (injectiveResolution Y) (injectiveResolution X)
      have hab : (injectiveResolution X).ι ≫
          (InjectiveResolution.desc a (injectiveResolution Y) (injectiveResolution X) -
            InjectiveResolution.desc b (injectiveResolution Y) (injectiveResolution X)) =
          (CochainComplex.single₀ C').map (a - b) ≫ (injectiveResolution Y).ι := by
        rw [Preadditive.comp_sub, ha, hb, Functor.map_sub, Preadditive.sub_comp]
      rw [R.rightDerived_map_eq q (a - b) _ hab, R.rightDerived_map_eq q a _ ha,
        R.rightDerived_map_eq q b _ hb, Functor.map_sub, Preadditive.sub_comp,
        Preadditive.comp_sub]

    have hmono : Mono ((R.rightDerived 0).map S.f) := by
      have := hS.mono_f
      rw [← NatIso.naturality_2 R.rightDerivedZeroIsoSelf S.f]
      infer_instance
    refine ⟨hadd, hmono, ?_⟩

    have s3 : ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃), ∃ (σ : S.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), S.f ≫ σ = I₁.ι.f 0 ∧ σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t 0 = 0 ∧ ∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0 := by
      intro I₁ I₃
      have hmf : Mono S.f := hS.mono_f
      have heg : Epi S.g := hS.epi_g
      obtain ⟨ι₁, hι₁⟩ : ∃ ι₁ : S.X₁ ⟶ I₁.cocomplex.X 0, ι₁ = I₁.ι.f 0 := ⟨_, rfl⟩
      obtain ⟨ι₃, hι₃⟩ : ∃ ι₃ : S.X₃ ⟶ I₃.cocomplex.X 0, ι₃ = I₃.ι.f 0 := ⟨_, rfl⟩
      have hι₃m : Mono ι₃ := by subst hι₃; exact (inferInstance : Mono (I₃.ι.f 0))
      have hι₁d : ι₁ ≫ I₁.cocomplex.d 0 1 = 0 := by subst hι₁; exact I₁.ι_f_zero_comp_complex_d
      have ref₃ : ∀ {A : C'} (x : A ⟶ I₃.cocomplex.X 0), x ≫ I₃.cocomplex.d 0 1 = 0 →
          ∃ (A' : C') (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₃), π ≫ x = y ≫ ι₃ := by
        subst hι₃
        intro A x hx
        exact I₃.exact₀.exact_up_to_refinements x hx
      let σ : S.X₂ ⟶ I₁.cocomplex.X 0 := Injective.factorThru ι₁ S.f
      have hσ : S.f ≫ σ = ι₁ := Injective.comp_factorThru _ _
      have hv : S.f ≫ (-(σ ≫ I₁.cocomplex.d 0 1)) = 0 := by
        rw [Preadditive.comp_neg, ← Category.assoc, hσ, hι₁d, neg_zero]
      let u : S.X₃ ⟶ I₁.cocomplex.X 1 := hS.exact.desc _ hv
      have hu : S.g ≫ u = -(σ ≫ I₁.cocomplex.d 0 1) := hS.exact.g_desc _ hv
      let t₀ : I₃.cocomplex.X 0 ⟶ I₁.cocomplex.X 1 := Injective.factorThru u ι₃
      have ht₀ : ι₃ ≫ t₀ = u := Injective.comp_factorThru _ _
      let Q : ∀ n : ℕ, (I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)) → Prop := fun n t =>
        ∀ (A : C') (y : A ⟶ I₃.cocomplex.X n), y ≫ I₃.cocomplex.d n (n + 1) = 0 →
          y ≫ t ≫ I₁.cocomplex.d (n + 1) (n + 2) = 0
      have hud : u ≫ I₁.cocomplex.d 1 2 = 0 := by
        apply (cancel_epi S.g).1
        rw [← Category.assoc, hu, Preadditive.neg_comp, Category.assoc,
          HomologicalComplex.d_comp_d, Limits.comp_zero, neg_zero, Limits.comp_zero]
      have h₀ : Q 0 t₀ := by
        intro A y hy
        obtain ⟨A', π, hπ, z, hz⟩ := ref₃ y hy
        have key : π ≫ y ≫ t₀ ≫ I₁.cocomplex.d 1 2 = 0 := by
          rw [← Category.assoc, hz, Category.assoc, ← Category.assoc ι₃, ht₀, hud,
            Limits.comp_zero]
        exact (cancel_epi π).1 (key.trans Limits.comp_zero.symm)
      have step : ∀ (n : ℕ) (t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), Q n t →
          ∃ t' : I₃.cocomplex.X (n + 1) ⟶ I₁.cocomplex.X (n + 2),
            I₃.cocomplex.d n (n + 1) ≫ t' = -(t ≫ I₁.cocomplex.d (n + 1) (n + 2)) ∧
              Q (n + 1) t' := by
        intro n t ht
        let E := ShortComplex.mk (Limits.kernel.ι (I₃.cocomplex.d n (n + 1)))
          (I₃.cocomplex.d n (n + 1)) (Limits.kernel.condition _)
        have hE : E.Exact := E.exact_of_f_is_kernel (Limits.kernelIsKernel _)
        have hf : E.f ≫ (-(t ≫ I₁.cocomplex.d (n + 1) (n + 2))) = 0 := by
          rw [Preadditive.comp_neg, ht _ _ (Limits.kernel.condition _), neg_zero]
        have hdesc : I₃.cocomplex.d n (n + 1) ≫ hE.descToInjective _ hf =
            -(t ≫ I₁.cocomplex.d (n + 1) (n + 2)) := hE.comp_descToInjective _ hf
        refine ⟨hE.descToInjective _ hf, hdesc, ?_⟩
        intro A y hy
        have ref : ∃ (A' : C') (π : A' ⟶ A) (_ : Epi π) (z : A' ⟶ I₃.cocomplex.X n),
            π ≫ y = z ≫ I₃.cocomplex.d n (n + 1) :=
          (I₃.exact_succ n).exact_up_to_refinements y hy
        obtain ⟨A', π, hπ, z, hz⟩ := ref
        have key : π ≫ y ≫ hE.descToInjective _ hf ≫ I₁.cocomplex.d (n + 2) (n + 3) = 0 := by
          rw [← Category.assoc, hz, Category.assoc, ← Category.assoc (I₃.cocomplex.d n (n + 1)),
            hdesc, Preadditive.neg_comp, Category.assoc, HomologicalComplex.d_comp_d,
            Limits.comp_zero, neg_zero, Limits.comp_zero]
        exact (cancel_epi π).1 (key.trans Limits.comp_zero.symm)
      choose F hF using step
      let T : ∀ n, {t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1) // Q n t} := fun n =>
        Nat.rec (motive := fun n => {t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1) // Q n t})
          ⟨t₀, h₀⟩ (fun n T => ⟨F n T.1 T.2, (hF n T.1 T.2).2⟩) n
      refine ⟨σ, fun n => (T n).1, hσ.trans hι₁, ?_, ?_⟩
      · show σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t₀ = 0
        rw [← hι₃, ht₀, hu, add_neg_cancel]
      · intro n
        show (T n).1 ≫ I₁.cocomplex.d (n + 1) (n + 2) +
          I₃.cocomplex.d n (n + 1) ≫ F n (T n).1 (T n).2 = 0
        rw [(hF n (T n).1 (T n).2).1, add_neg_cancel]

    have s4 : ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃) (σ : S.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), S.f ≫ σ = I₁.ι.f 0 → σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t 0 = 0 → (∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0) → ∃ (K : CochainComplex C' ℕ) (i : I₁.cocomplex ⟶ K) (p : K ⟶ I₃.cocomplex) (e : (CochainComplex.single₀ C').obj S.X₂ ⟶ K), (∀ n, Injective (K.X n)) ∧ I₁.ι ≫ i = (CochainComplex.single₀ C').map S.f ≫ e ∧ e ≫ p = (CochainComplex.single₀ C').map S.g ≫ I₃.ι ∧ ∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, Nonempty (ShortComplex.mk (i.f n) (p.f n) h).Splitting := by
      intro I₁ I₃ σ t H1 H2 H3
      let X : ℕ → C' := fun n => I₁.cocomplex.X n ⊞ I₃.cocomplex.X n
      let d : ∀ n, X n ⟶ X (n + 1) := fun n =>
        Limits.biprod.lift (Limits.biprod.fst ≫ I₁.cocomplex.d n (n + 1) + Limits.biprod.snd ≫ t n)
          (Limits.biprod.snd ≫ I₃.cocomplex.d n (n + 1))
      have sq : ∀ n, d n ≫ d (n + 1) = 0 := by
        intro n
        have h3 : t n ≫ I₁.cocomplex.d (n + 1) (n + 1 + 1) +
            I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0 := H3 n
        apply Limits.biprod.hom_ext
        · simp only [d, Category.assoc, Limits.biprod.lift_fst, Preadditive.comp_add,
            Preadditive.add_comp, Limits.biprod.lift_fst_assoc, Limits.biprod.lift_snd_assoc,
            HomologicalComplex.d_comp_d, Limits.comp_zero, zero_add, Limits.zero_comp]
          rw [← Preadditive.comp_add, h3, Limits.comp_zero]
        · simp only [d, Category.assoc, Limits.biprod.lift_snd, Limits.biprod.lift_snd_assoc,
            HomologicalComplex.d_comp_d, Limits.comp_zero, Limits.zero_comp]
      let K : CochainComplex C' ℕ := CochainComplex.of X d sq
      have hKd : ∀ n, K.d n (n + 1) = d n := fun n => CochainComplex.of_d X d n
      let i : I₁.cocomplex ⟶ K :=
        { f := fun n => (Limits.biprod.inl : I₁.cocomplex.X n ⟶ X n)
          comm' := by
            rintro n m rfl
            rw [hKd]
            apply Limits.biprod.hom_ext <;> simp [d] }
      let p : K ⟶ I₃.cocomplex :=
        { f := fun n => (Limits.biprod.snd : X n ⟶ I₃.cocomplex.X n)
          comm' := by
            rintro n m rfl
            rw [hKd]
            simp [d] }
      have hz : (Limits.biprod.lift σ (S.g ≫ I₃.ι.f 0) : S.X₂ ⟶ X 0) ≫ K.d 0 1 = 0 := by
        have hK0 : K.d 0 1 = d 0 := hKd 0
        rw [hK0]
        apply Limits.biprod.hom_ext
        · simp only [d, Category.assoc, Limits.biprod.lift_fst, Limits.biprod.lift_fst_assoc,
            Preadditive.comp_add, Limits.biprod.lift_snd_assoc, Limits.zero_comp]
          refine Eq.trans ?_ H2
          congr 1
          exact Category.assoc _ _ _
        · simp only [d, Category.assoc, Limits.biprod.lift_snd, Limits.biprod.lift_snd_assoc,
            Limits.zero_comp]
          exact (Category.assoc _ _ _).trans
            ((congrArg (S.g ≫ ·) I₃.ι_f_zero_comp_complex_d).trans Limits.comp_zero)
      refine ⟨K, i, p, (K.fromSingle₀Equiv S.X₂).symm ⟨Limits.biprod.lift σ (S.g ≫ I₃.ι.f 0), hz⟩,
        fun n => ?_, ?_, ?_, fun n => ?_⟩
      · show Injective (I₁.cocomplex.X n ⊞ I₃.cocomplex.X n)
        infer_instance
      · apply HomologicalComplex.from_single_hom_ext
        rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero,
          CochainComplex.fromSingle₀Equiv_symm_apply_f_zero]
        apply Limits.biprod.hom_ext
        · simp [i, H1]
          exact (Category.assoc _ _ _).trans
            ((congrArg (I₁.ι.f 0 ≫ ·) Limits.biprod.inl_fst).trans (Category.comp_id _))
        · simp [i]
          refine ((Category.assoc _ _ _).trans
            ((congrArg (I₁.ι.f 0 ≫ ·) Limits.biprod.inl_snd).trans Limits.comp_zero)).trans ?_
          refine Eq.symm (Eq.trans (Category.assoc S.f S.g (I₃.ι.f 0)).symm ?_)
          exact (congrArg (· ≫ I₃.ι.f 0) S.zero).trans Limits.zero_comp
      · apply HomologicalComplex.from_single_hom_ext
        rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero,
          CochainComplex.fromSingle₀Equiv_symm_apply_f_zero]
        simp [p]
      · refine ⟨Limits.biprod.inl_snd, ⟨?_⟩⟩
        exact ShortComplex.Splitting.mk Limits.biprod.fst Limits.biprod.inr Limits.biprod.inl_fst
          Limits.biprod.inr_snd Limits.biprod.total

    have s5 : ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃) (K : CochainComplex C' ℕ) (i : I₁.cocomplex ⟶ K) (p : K ⟶ I₃.cocomplex) (e : (CochainComplex.single₀ C').obj S.X₂ ⟶ K), I₁.ι ≫ i = (CochainComplex.single₀ C').map S.f ≫ e → e ≫ p = (CochainComplex.single₀ C').map S.g ≫ I₃.ι → (∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, (ShortComplex.mk (i.f n) (p.f n) h).ShortExact) → QuasiIso e := by
      intro I₁ I₃ K i p e hi hp hses
      have heg : Epi S.g := hS.epi_g
      have hip : i ≫ p = 0 := by
        ext n
        obtain ⟨h, -⟩ := hses n
        rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
        exact h
      let T := ShortComplex.mk i p hip
      have hT : T.ShortExact := by
        apply HomologicalComplex.shortExact_of_degreewise_shortExact
        intro n
        obtain ⟨h, hn⟩ := hses n
        exact ShortComplex.shortExact_of_iso
          (ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp [T]) (by simp [T])) hn
      rw [quasiIso_iff]
      intro n
      cases n with
      | succ n =>
        rw [quasiIsoAt_iff_exactAt e (n + 1) (CochainComplex.exactAt_succ_single_obj S.X₂ n),
          HomologicalComplex.exactAt_iff_isZero_homology]
        have hex := hT.homology_exact₂ (n + 1)
        have h1 : Limits.IsZero (I₁.cocomplex.homology (n + 1)) :=
          (I₁.cocomplex_exactAt_succ n).isZero_homology
        have h3 : Limits.IsZero (I₃.cocomplex.homology (n + 1)) :=
          (I₃.cocomplex_exactAt_succ n).isZero_homology
        exact hex.isZero_of_both_zeros (h1.eq_of_src _ _) (h3.eq_of_tgt _ _)
      | zero =>
        obtain ⟨ι₁, hι₁⟩ : ∃ ι₁ : S.X₁ ⟶ I₁.cocomplex.X 0, ι₁ = I₁.ι.f 0 := ⟨_, rfl⟩
        obtain ⟨ι₃, hι₃⟩ : ∃ ι₃ : S.X₃ ⟶ I₃.cocomplex.X 0, ι₃ = I₃.ι.f 0 := ⟨_, rfl⟩
        obtain ⟨e0, he0⟩ : ∃ e0 : S.X₂ ⟶ K.X 0, e0 = e.f 0 := ⟨_, rfl⟩
        have hι₁m : Mono ι₁ := by subst hι₁; exact (inferInstance : Mono (I₁.ι.f 0))
        have hι₃m : Mono ι₃ := by subst hι₃; exact (inferInstance : Mono (I₃.ι.f 0))
        have ref₁ : ∀ {A : C'} (x : A ⟶ I₁.cocomplex.X 0), x ≫ I₁.cocomplex.d 0 1 = 0 →
            ∃ (A' : C') (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₁), π ≫ x = y ≫ ι₁ := by
          subst hι₁
          intro A x hx
          exact I₁.exact₀.exact_up_to_refinements x hx
        have ref₃ : ∀ {A : C'} (x : A ⟶ I₃.cocomplex.X 0), x ≫ I₃.cocomplex.d 0 1 = 0 →
            ∃ (A' : C') (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₃), π ≫ x = y ≫ ι₃ := by
          subst hι₃
          intro A x hx
          exact I₃.exact₀.exact_up_to_refinements x hx
        have hi0 : Mono (i.f 0) := (hses 0).choose_spec.mono_f
        have hi1 : Mono (i.f 1) := (hses 1).choose_spec.mono_f
        have F1 : S.f ≫ e0 = ι₁ ≫ i.f 0 := by
          have := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) hi
          simp only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero] at this
          subst hι₁ he0
          exact this.symm
        have F2 : e0 ≫ p.f 0 = S.g ≫ ι₃ := by
          have := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) hp
          simp only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero] at this
          subst hι₃ he0
          exact this
        have F3 : e0 ≫ K.d 0 1 = 0 := by
          subst he0
          have hd : ((CochainComplex.single₀ C').obj S.X₂).d 0 1 = 0 := rfl
          exact (e.comm 0 1).trans ((congrArg (· ≫ e.f 1) hd).trans Limits.zero_comp)
        have F4 : i.f 0 ≫ K.d 0 1 = I₁.cocomplex.d 0 1 ≫ i.f 1 := i.comm 0 1
        have F5 : K.d 0 1 ≫ p.f 1 = p.f 0 ≫ I₃.cocomplex.d 0 1 := (p.comm 0 1).symm
        have hmono' : Mono e0 := by
          apply Preadditive.mono_of_cancel_zero
          intro A x hx
          have h1 : x ≫ S.g = 0 := by
            apply (cancel_mono ι₃).1
            rw [Category.assoc, ← F2, ← Category.assoc, hx, Limits.zero_comp, Limits.zero_comp]
          have ref : ∃ (A' : C') (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₁), π ≫ x = y ≫ S.f :=
            hS.exact.exact_up_to_refinements x h1
          obtain ⟨A', π, hπ, y, hy⟩ := ref
          have h2 : y ≫ (ι₁ ≫ i.f 0) = 0 := by
            rw [← F1, ← Category.assoc, ← hy, Category.assoc, hx, Limits.comp_zero]
          have h3 : y = 0 := by
            apply (cancel_mono (ι₁ ≫ i.f 0)).1
            rw [h2, Limits.zero_comp]
          apply (cancel_epi π).1
          rw [hy, h3, Limits.zero_comp, Limits.comp_zero]
        have hexact : (ShortComplex.mk e0 (K.d 0 1) F3).Exact := by
          rw [ShortComplex.exact_iff_exact_up_to_refinements]
          intro A x hx
          have hx' : x ≫ K.d 0 1 = 0 := hx
          have s1 : (x ≫ p.f 0) ≫ I₃.cocomplex.d 0 1 = 0 := by
            rw [Category.assoc, ← F5, ← Category.assoc, hx', Limits.zero_comp]
          obtain ⟨A₁, π₁, hπ₁, y₃, hy₃⟩ := ref₃ (x ≫ p.f 0) s1
          obtain ⟨A₂, π₂, hπ₂, y₂, hy₂⟩ := surjective_up_to_refinements_of_epi S.g y₃
          have s3' : (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) ≫ p.f 0 = 0 := by
            have e1 : (π₂ ≫ π₁ ≫ x) ≫ p.f 0 = y₂ ≫ S.g ≫ ι₃ := by
              rw [Category.assoc, Category.assoc, hy₃, ← Category.assoc, hy₂, Category.assoc]
            have e2 : (y₂ ≫ e0) ≫ p.f 0 = y₂ ≫ S.g ≫ ι₃ := by
              rw [Category.assoc, F2]
            rw [Preadditive.sub_comp, e1, e2, sub_self]
          obtain ⟨h0, hs0⟩ := hses 0
          have ref : ∃ (A' : C') (π : A' ⟶ A₂) (_ : Epi π) (z : A' ⟶ I₁.cocomplex.X 0),
              π ≫ (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) = z ≫ i.f 0 :=
            hs0.exact.exact_up_to_refinements _ s3'
          obtain ⟨A₃, π₃, hπ₃, z, hz⟩ := ref
          have s4' : (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) ≫ K.d 0 1 = 0 := by
            simp only [Preadditive.sub_comp, Category.assoc, hx', F3, Limits.comp_zero, sub_self]
          have s4'' : z ≫ I₁.cocomplex.d 0 1 = 0 := by
            apply (cancel_mono (i.f 1)).1
            have : (z ≫ i.f 0) ≫ K.d 0 1 = 0 := by
              rw [← hz, Category.assoc, s4', Limits.comp_zero]
            rw [Limits.zero_comp, Category.assoc, ← F4, ← Category.assoc, this]
          obtain ⟨A₄, π₄, hπ₄, w, hw⟩ := ref₁ z s4''
          have k1 : π₃ ≫ π₂ ≫ π₁ ≫ x = π₃ ≫ y₂ ≫ e0 + z ≫ i.f 0 := by
            rw [← hz, Preadditive.comp_sub]
            abel
          refine ⟨A₄, π₄ ≫ π₃ ≫ π₂ ≫ π₁, inferInstance, π₄ ≫ π₃ ≫ y₂ + w ≫ S.f, ?_⟩
          show (π₄ ≫ π₃ ≫ π₂ ≫ π₁) ≫ x = (π₄ ≫ π₃ ≫ y₂ + w ≫ S.f) ≫ e0
          simp only [Category.assoc, Preadditive.add_comp]
          rw [k1, Preadditive.comp_add, ← Category.assoc π₄ z, hw, Category.assoc, ← F1]
        rw [CochainComplex.quasiIsoAt₀_iff]
        subst he0
        refine (ShortComplex.quasiIso_iff_of_zeros _ ?_ ?_ ?_).2 ⟨hexact, hmono'⟩
        · exact ((CochainComplex.single₀ C').obj S.X₂).shape 0 0 (by simp)
        · rfl
        · exact K.shape 0 0 (by simp)

    have s6 : ∀ (I₁ : InjectiveResolution S.X₁) (I₂ : InjectiveResolution S.X₂) (I₃ : InjectiveResolution S.X₃) (i : I₁.cocomplex ⟶ I₂.cocomplex) (p : I₂.cocomplex ⟶ I₃.cocomplex), I₁.ι ≫ i = (CochainComplex.single₀ C').map S.f ≫ I₂.ι → I₂.ι ≫ p = (CochainComplex.single₀ C').map S.g ≫ I₃.ι → (∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, Nonempty (ShortComplex.mk (i.f n) (p.f n) h).Splitting) → ∀ q : ℕ, (∃ h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0, (ShortComplex.mk _ _ h0).Exact) ∧ ∃ (δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁) (h1 : (R.rightDerived q).map S.g ≫ δ = 0) (h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0), (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact := by
      intro I₁ I₂ I₃ i p hi hp hspl q
      have hip : i ≫ p = 0 := by
        ext n
        obtain ⟨h, -⟩ := hspl n
        rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
        exact h
      have hz : (R.mapHomologicalComplex (ComplexShape.up ℕ)).map i ≫
          (R.mapHomologicalComplex (ComplexShape.up ℕ)).map p = 0 := by
        rw [← Functor.map_comp, hip, Functor.map_zero]
      let S' := ShortComplex.mk _ _ hz
      have hS' : S'.ShortExact := by
        apply HomologicalComplex.shortExact_of_degreewise_shortExact
        intro n
        obtain ⟨h, ⟨spl⟩⟩ := hspl n
        exact ShortComplex.shortExact_of_iso
          (ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp [S']) (by simp [S']))
          (spl.map R).shortExact
      let α₁ : ∀ k, (R.rightDerived k).obj S.X₁ ≅ S'.X₁.homology k :=
        fun k => I₁.isoRightDerivedObj R k
      let α₂ : ∀ k, (R.rightDerived k).obj S.X₂ ≅ S'.X₂.homology k :=
        fun k => I₂.isoRightDerivedObj R k
      let α₃ : ∀ k, (R.rightDerived k).obj S.X₃ ≅ S'.X₃.homology k :=
        fun k => I₃.isoRightDerivedObj R k
      have C1 : ∀ k, (α₁ k).hom ≫ HomologicalComplex.homologyMap S'.f k =
          (R.rightDerived k).map S.f ≫ (α₂ k).hom := by
        intro k
        show (I₁.isoRightDerivedObj R k).hom ≫ _ = _ ≫ (I₂.isoRightDerivedObj R k).hom
        rw [R.rightDerived_map_eq k S.f i hi, Category.assoc, Category.assoc, Iso.inv_hom_id,
          Category.comp_id]
        rfl
      have C2 : ∀ k, (α₂ k).hom ≫ HomologicalComplex.homologyMap S'.g k =
          (R.rightDerived k).map S.g ≫ (α₃ k).hom := by
        intro k
        show (I₂.isoRightDerivedObj R k).hom ≫ _ = _ ≫ (I₃.isoRightDerivedObj R k).hom
        rw [R.rightDerived_map_eq k S.g p hp, Category.assoc, Category.assoc, Iso.inv_hom_id,
          Category.comp_id]
        rfl
      have hrel : (ComplexShape.up ℕ).Rel q (q + 1) := rfl
      have h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0 := by
        rw [← cancel_mono (α₃ q).hom, Category.assoc, ← C2, ← Category.assoc,
          ← C1, Category.assoc, ← HomologicalComplex.homologyMap_comp, S'.zero,
          HomologicalComplex.homologyMap_zero, Limits.comp_zero, Limits.zero_comp]
      let δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁ :=
        (α₃ q).hom ≫ hS'.δ q (q + 1) hrel ≫ (α₁ (q + 1)).inv
      have Cδ : (α₃ q).hom ≫ hS'.δ q (q + 1) hrel = δ ≫ (α₁ (q + 1)).hom := by
        simp only [δ, Category.assoc, Iso.inv_hom_id, Category.comp_id]
      have h1 : (R.rightDerived q).map S.g ≫ δ = 0 := by
        rw [← cancel_mono (α₁ (q + 1)).hom, Category.assoc, ← Cδ,
          ← Category.assoc, ← C2, Category.assoc, hS'.comp_δ, Limits.comp_zero, Limits.zero_comp]
      have h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0 := by
        rw [← cancel_mono (α₂ (q + 1)).hom, Category.assoc, ← C1,
          ← Category.assoc, ← Cδ, Category.assoc, hS'.δ_comp, Limits.comp_zero, Limits.zero_comp]
      refine ⟨⟨h0, ?_⟩, δ, h1, h2, ?_, ?_⟩
      · exact ShortComplex.exact_of_iso
          (ShortComplex.isoMk (α₁ q) (α₂ q) (α₃ q) (C1 q) (C2 q)).symm (hS'.homology_exact₂ q)
      · exact ShortComplex.exact_of_iso
          (ShortComplex.isoMk (α₂ q) (α₃ q) (α₁ (q + 1)) (C2 q) Cδ).symm
          (hS'.homology_exact₃ q (q + 1) hrel)
      · exact ShortComplex.exact_of_iso
          (ShortComplex.isoMk (α₃ q) (α₁ (q + 1)) (α₂ (q + 1)) Cδ (C1 (q + 1))).symm
          (hS'.homology_exact₁ q (q + 1) hrel)

    obtain ⟨σ, t, H1, H2, H3⟩ := s3 (injectiveResolution S.X₁) (injectiveResolution S.X₃)
    obtain ⟨K, i, p, e, hK, hi, hp, hspl⟩ := s4 _ _ σ t H1 H2 H3
    have he : QuasiIso e := s5 _ _ K i p e hi hp (fun n => by
      obtain ⟨h, ⟨spl⟩⟩ := hspl n
      exact ⟨h, spl.shortExact⟩)
    let I₂ : InjectiveResolution S.X₂ :=
      { cocomplex := K, injective := hK, ι := e, quasiIso := he }
    exact s6 _ I₂ _ i p hi hp hspl

  have hE : ∀ (K : CochainComplex C ℕ) (i : ℕ),
      Nonempty (((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology i ≅
        E.obj (K.homology i)) :=
    fun K i => ⟨(K.sc i).mapHomologyIso E⟩
  have hE' : ∀ (K : CochainComplex D ℕ) (i : ℕ),
      Nonempty (((E'.mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology i ≅
        E'.obj (K.homology i)) :=
    fun K i => ⟨(K.sc i).mapHomologyIso E'⟩

  have hφ : ∀ (L : CochainComplex C' ℕ) (i : ℕ),
      ∃ φ : F'.obj (L.cycles i) ≅ ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).cycles i,
        φ.hom ≫ ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).iCycles i =
          F'.map (L.iCycles i) := by
    intro L i
    have h1 := Limits.KernelFork.mapIsLimit _ (L.cyclesIsKernel i (i + 1) (CochainComplex.next ℕ i)) F'
    have h2 := ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).cyclesIsKernel i (i + 1)
      (CochainComplex.next ℕ i)
    refine ⟨Limits.IsLimit.conePointUniqueUpToIso h1 h2, ?_⟩
    have := Limits.IsLimit.conePointUniqueUpToIso_hom_comp h1 h2 Limits.WalkingParallelPair.zero
    simpa using this

  have hH : ∀ (L : CochainComplex C' ℕ) (n : ℕ),
      Nonempty (((F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).homology (n + 1) ≅
        Limits.cokernel (F'.map (L.toCycles n (n + 1)))) := by
    intro L n
    obtain ⟨φ, hφ'⟩ := hφ L (n + 1)
    have hsq : F'.map (L.toCycles n (n + 1)) ≫ φ.hom =
        ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).toCycles n (n + 1) := by
      rw [← cancel_mono (((F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).iCycles (n + 1)),
        Category.assoc, hφ', ← F'.map_comp, L.toCycles_i, HomologicalComplex.toCycles_i]
      all_goals rfl
    have hc := ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).homologyIsCokernel n (n + 1)
      (CochainComplex.prev_nat_succ n)
    exact ⟨Limits.IsColimit.coconePointUniqueUpToIso hc (Limits.cokernelIsCokernel _) ≪≫
      (Limits.cokernel.mapIso _ _ (Iso.refl _) φ (by rw [hsq, Iso.refl_hom, Category.id_comp])).symm⟩

  have hH0 : ∀ (L : CochainComplex C' ℕ),
      Nonempty (F'.obj (L.homology 0) ≅
        ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).homology 0) := by
    intro L
    obtain ⟨φ, -⟩ := hφ L 0
    exact ⟨F'.mapIso (CochainComplex.isoHomologyπ₀ L).symm ≪≫ φ ≪≫ CochainComplex.isoHomologyπ₀ _⟩

  have hds : ∀ (S : ShortComplex C'), S.ShortExact →
      (∀ k : ℕ, Limits.IsZero ((F'.rightDerived (k + 1)).obj S.X₂)) →
      Nonempty ((F'.rightDerived 1).obj S.X₁ ≅ Limits.cokernel (F'.map S.g)) ∧
        ∀ k : ℕ, Nonempty ((F'.rightDerived (k + 2)).obj S.X₁ ≅ (F'.rightDerived (k + 1)).obj S.X₃) := by
    intro S hS hz
    obtain ⟨-, -, hl⟩ := hles F' S hS
    constructor
    · obtain ⟨-, δ, h1, h2, hex1, hex2⟩ := hl 0
      have hf : (F'.rightDerived (0 + 1)).map S.f = 0 := (hz 0).eq_of_tgt _ _
      haveI : Epi δ := hex2.epi_f hf
      haveI : Epi (ShortComplex.mk _ _ h1).g := by assumption
      have hcok := hex1.gIsCokernel
      exact ⟨(Limits.IsColimit.coconePointUniqueUpToIso hcok (Limits.cokernelIsCokernel _)) ≪≫
        Limits.cokernel.mapIso _ _ (F'.rightDerivedZeroIsoSelf.app S.X₂)
          (F'.rightDerivedZeroIsoSelf.app S.X₃) (F'.rightDerivedZeroIsoSelf.hom.naturality S.g)⟩
    · intro k
      obtain ⟨-, δ, h1, h2, hex1, hex2⟩ := hl (k + 1)
      have hg : (F'.rightDerived (k + 1)).map S.g = 0 := (hz k).eq_of_src _ _
      have hf : (F'.rightDerived (k + 1 + 1)).map S.f = 0 := (hz (k + 1)).eq_of_tgt _ _
      haveI : Mono δ := hex1.mono_g hg
      haveI : Epi δ := hex2.epi_f hf
      haveI : IsIso δ := isIso_of_mono_of_epi δ
      exact ⟨(asIso δ).symm⟩

  have hA1 : ∀ (L : CochainComplex C' ℕ), (∀ n, L.ExactAt (n + 1)) →
      (∀ n k, Limits.IsZero ((F'.rightDerived (k + 1)).obj (L.X n))) → ∀ q,
      Nonempty ((F'.rightDerived q).obj (L.homology 0) ≅
        ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).homology q) := by
    intro L hexL hacL
    have hw : ∀ n : ℕ, L.iCycles n ≫ L.toCycles n (n + 1) = 0 := by
      intro n
      rw [← cancel_mono (L.iCycles (n + 1)), Category.assoc, L.toCycles_i, L.iCycles_d,
        Limits.zero_comp]
    have hSE : ∀ n : ℕ, (ShortComplex.mk (L.iCycles n) (L.toCycles n (n + 1)) (hw n)).ShortExact := by
      intro n
      have hex' := (L.exactAt_iff' n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
        (CochainComplex.next ℕ (n + 1))).mp (hexL n)
      have hepi : Epi (L.toCycles n (n + 1)) := by
        have h1 : Epi (L.toCycles n (n + 1) ≫ (L.cyclesIsoSc' n (n + 1) (n + 1 + 1)
            (CochainComplex.prev_nat_succ n) (CochainComplex.next ℕ (n + 1))).hom) := by
          rw [L.toCycles_cyclesIsoSc'_hom]
          exact hex'.epi_toCycles
        exact (epi_comp_iff_of_isIso _ _).mp h1
      have hlim : Limits.IsLimit (Limits.KernelFork.ofι (L.iCycles n) (hw n)) :=
        Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => L.liftCycles g' (n + 1) (CochainComplex.next ℕ n) (by
            rw [← L.toCycles_i n (n + 1), ← Category.assoc, hg', Limits.zero_comp]))
          (fun g' hg' => L.liftCycles_i _ _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (L.iCycles n), hm, L.liftCycles_i])
      exact ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ hlim) inferInstance hepi
    have hP : ∀ q n : ℕ, Nonempty ((F'.rightDerived (q + 1)).obj (L.cycles n) ≅
        ((F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj L).homology (n + q + 1)) := by
      intro q
      induction q with
      | zero =>
        intro n
        obtain ⟨⟨e1⟩, -⟩ := hds _ (hSE n) (fun k => hacL n k)
        obtain ⟨e2⟩ := hH L n
        exact ⟨e1 ≪≫ e2.symm⟩
      | succ q ih =>
        intro n
        obtain ⟨-, h2⟩ := hds _ (hSE n) (fun k => hacL n k)
        obtain ⟨e1⟩ := h2 q
        obtain ⟨e2⟩ := ih (n + 1)
        exact ⟨e1 ≪≫ e2 ≪≫ eqToIso (by rw [show n + 1 + q + 1 = n + (q + 1) + 1 by omega])⟩
    intro q
    cases q with
    | zero =>
      obtain ⟨e⟩ := hH0 L
      exact ⟨F'.rightDerivedZeroIsoSelf.app _ ≪≫ e⟩
    | succ q =>
      obtain ⟨e⟩ := hP q 0
      exact ⟨(F'.rightDerived (q + 1)).mapIso (CochainComplex.isoHomologyπ₀ L).symm ≪≫ e ≪≫
        eqToIso (by rw [show 0 + q + 1 = q + 1 by omega])⟩

  let P := injectiveResolution X
  have hLex : ∀ n, ((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj P.cocomplex).ExactAt (n + 1) := by
    intro n
    rw [HomologicalComplex.exactAt_iff_isZero_homology]
    obtain ⟨e⟩ := hE P.cocomplex (n + 1)
    refine Limits.IsZero.of_iso ?_ e
    exact E.map_isZero ((HomologicalComplex.exactAt_iff_isZero_homology _ _).mp
      (P.cocomplex_exactAt_succ n))
  have hLac : ∀ n k, Limits.IsZero ((F'.rightDerived (k + 1)).obj
      (((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj P.cocomplex).X n)) := by
    intro n k
    haveI := P.injective n
    exact hacyc (P.cocomplex.X n) k
  obtain ⟨a1⟩ := hA1 _ hLex hLac q
  let e0 : P.cocomplex.homology 0 ≅ X :=
    (asIso (HomologicalComplex.homologyMap P.ι 0)).symm ≪≫
      HomologicalComplex.singleObjHomologySelfIso (ComplexShape.up ℕ) 0 X
  obtain ⟨e1'⟩ := hE P.cocomplex 0
  let γ : (F'.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      ((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj P.cocomplex) ≅
      (E'.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      ((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj P.cocomplex) :=
    HomologicalComplex.Hom.isoOfComponents (fun i => β.symm.app (P.cocomplex.X i))
      (fun i j _ => (β.inv.naturality (P.cocomplex.d i j)).symm)
  obtain ⟨e2⟩ := hE' ((F.mapHomologicalComplex (ComplexShape.up ℕ)).obj P.cocomplex) q
  exact ⟨(F'.rightDerived q).mapIso (e1' ≪≫ E.mapIso e0).symm ≪≫ a1 ≪≫
    HomologicalComplex.homologyMapIso γ q ≪≫ e2 ≪≫ E'.mapIso (P.isoRightDerivedObj F q).symm⟩

theorem wc_rightDerived_les_package : ∀ {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [HasInjectiveResolutions C] (R : C ⥤ D) [R.Additive] [Limits.PreservesFiniteLimits R] (S : ShortComplex C), S.ShortExact → (∀ (q : ℕ) {X Y : C} (a b : X ⟶ Y), (R.rightDerived q).map (a - b) = (R.rightDerived q).map a - (R.rightDerived q).map b) ∧ Mono ((R.rightDerived 0).map S.f) ∧ ∀ q : ℕ, (∃ h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0, (ShortComplex.mk _ _ h0).Exact) ∧ ∃ (δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁) (h1 : (R.rightDerived q).map S.g ≫ δ = 0) (h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0), (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact :=
by
  intro C D _ _ _ _ _ R _ _ S hS

  have hadd : ∀ (q : ℕ) {X Y : C} (a b : X ⟶ Y),
      (R.rightDerived q).map (a - b) = (R.rightDerived q).map a - (R.rightDerived q).map b := by
    intro q X Y a b
    have ha := InjectiveResolution.desc_commutes a (injectiveResolution Y) (injectiveResolution X)
    have hb := InjectiveResolution.desc_commutes b (injectiveResolution Y) (injectiveResolution X)
    have hab : (injectiveResolution X).ι ≫
        (InjectiveResolution.desc a (injectiveResolution Y) (injectiveResolution X) -
          InjectiveResolution.desc b (injectiveResolution Y) (injectiveResolution X)) =
        (CochainComplex.single₀ C).map (a - b) ≫ (injectiveResolution Y).ι := by
      rw [Preadditive.comp_sub, ha, hb, Functor.map_sub, Preadditive.sub_comp]
    rw [R.rightDerived_map_eq q (a - b) _ hab, R.rightDerived_map_eq q a _ ha,
      R.rightDerived_map_eq q b _ hb, Functor.map_sub, Preadditive.sub_comp,
      Preadditive.comp_sub]

  have hmono : Mono ((R.rightDerived 0).map S.f) := by
    have := hS.mono_f
    rw [← NatIso.naturality_2 R.rightDerivedZeroIsoSelf S.f]
    infer_instance
  refine ⟨hadd, hmono, ?_⟩

  have s3 : ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃), ∃ (σ : S.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), S.f ≫ σ = I₁.ι.f 0 ∧ σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t 0 = 0 ∧ ∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0 := by
    intro I₁ I₃
    have hmf : Mono S.f := hS.mono_f
    have heg : Epi S.g := hS.epi_g
    obtain ⟨ι₁, hι₁⟩ : ∃ ι₁ : S.X₁ ⟶ I₁.cocomplex.X 0, ι₁ = I₁.ι.f 0 := ⟨_, rfl⟩
    obtain ⟨ι₃, hι₃⟩ : ∃ ι₃ : S.X₃ ⟶ I₃.cocomplex.X 0, ι₃ = I₃.ι.f 0 := ⟨_, rfl⟩
    have hι₃m : Mono ι₃ := by subst hι₃; exact (inferInstance : Mono (I₃.ι.f 0))
    have hι₁d : ι₁ ≫ I₁.cocomplex.d 0 1 = 0 := by subst hι₁; exact I₁.ι_f_zero_comp_complex_d
    have ref₃ : ∀ {A : C} (x : A ⟶ I₃.cocomplex.X 0), x ≫ I₃.cocomplex.d 0 1 = 0 →
        ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₃), π ≫ x = y ≫ ι₃ := by
      subst hι₃
      intro A x hx
      exact I₃.exact₀.exact_up_to_refinements x hx
    let σ : S.X₂ ⟶ I₁.cocomplex.X 0 := Injective.factorThru ι₁ S.f
    have hσ : S.f ≫ σ = ι₁ := Injective.comp_factorThru _ _
    have hv : S.f ≫ (-(σ ≫ I₁.cocomplex.d 0 1)) = 0 := by
      rw [Preadditive.comp_neg, ← Category.assoc, hσ, hι₁d, neg_zero]
    let u : S.X₃ ⟶ I₁.cocomplex.X 1 := hS.exact.desc _ hv
    have hu : S.g ≫ u = -(σ ≫ I₁.cocomplex.d 0 1) := hS.exact.g_desc _ hv
    let t₀ : I₃.cocomplex.X 0 ⟶ I₁.cocomplex.X 1 := Injective.factorThru u ι₃
    have ht₀ : ι₃ ≫ t₀ = u := Injective.comp_factorThru _ _
    let Q : ∀ n : ℕ, (I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)) → Prop := fun n t =>
      ∀ (A : C) (y : A ⟶ I₃.cocomplex.X n), y ≫ I₃.cocomplex.d n (n + 1) = 0 →
        y ≫ t ≫ I₁.cocomplex.d (n + 1) (n + 2) = 0
    have hud : u ≫ I₁.cocomplex.d 1 2 = 0 := by
      apply (cancel_epi S.g).1
      rw [← Category.assoc, hu, Preadditive.neg_comp, Category.assoc,
        HomologicalComplex.d_comp_d, Limits.comp_zero, neg_zero, Limits.comp_zero]
    have h₀ : Q 0 t₀ := by
      intro A y hy
      obtain ⟨A', π, hπ, z, hz⟩ := ref₃ y hy
      have key : π ≫ y ≫ t₀ ≫ I₁.cocomplex.d 1 2 = 0 := by
        rw [← Category.assoc, hz, Category.assoc, ← Category.assoc ι₃, ht₀, hud,
          Limits.comp_zero]
      exact (cancel_epi π).1 (key.trans Limits.comp_zero.symm)
    have step : ∀ (n : ℕ) (t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), Q n t →
        ∃ t' : I₃.cocomplex.X (n + 1) ⟶ I₁.cocomplex.X (n + 2),
          I₃.cocomplex.d n (n + 1) ≫ t' = -(t ≫ I₁.cocomplex.d (n + 1) (n + 2)) ∧
            Q (n + 1) t' := by
      intro n t ht
      let E := ShortComplex.mk (Limits.kernel.ι (I₃.cocomplex.d n (n + 1)))
        (I₃.cocomplex.d n (n + 1)) (Limits.kernel.condition _)
      have hE : E.Exact := E.exact_of_f_is_kernel (Limits.kernelIsKernel _)
      have hf : E.f ≫ (-(t ≫ I₁.cocomplex.d (n + 1) (n + 2))) = 0 := by
        rw [Preadditive.comp_neg, ht _ _ (Limits.kernel.condition _), neg_zero]
      have hdesc : I₃.cocomplex.d n (n + 1) ≫ hE.descToInjective _ hf =
          -(t ≫ I₁.cocomplex.d (n + 1) (n + 2)) := hE.comp_descToInjective _ hf
      refine ⟨hE.descToInjective _ hf, hdesc, ?_⟩
      intro A y hy
      have ref : ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (z : A' ⟶ I₃.cocomplex.X n),
          π ≫ y = z ≫ I₃.cocomplex.d n (n + 1) :=
        (I₃.exact_succ n).exact_up_to_refinements y hy
      obtain ⟨A', π, hπ, z, hz⟩ := ref
      have key : π ≫ y ≫ hE.descToInjective _ hf ≫ I₁.cocomplex.d (n + 2) (n + 3) = 0 := by
        rw [← Category.assoc, hz, Category.assoc, ← Category.assoc (I₃.cocomplex.d n (n + 1)),
          hdesc, Preadditive.neg_comp, Category.assoc, HomologicalComplex.d_comp_d,
          Limits.comp_zero, neg_zero, Limits.comp_zero]
      exact (cancel_epi π).1 (key.trans Limits.comp_zero.symm)
    choose F hF using step
    let T : ∀ n, {t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1) // Q n t} := fun n =>
      Nat.rec (motive := fun n => {t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1) // Q n t})
        ⟨t₀, h₀⟩ (fun n T => ⟨F n T.1 T.2, (hF n T.1 T.2).2⟩) n
    refine ⟨σ, fun n => (T n).1, hσ.trans hι₁, ?_, ?_⟩
    · show σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t₀ = 0
      rw [← hι₃, ht₀, hu, add_neg_cancel]
    · intro n
      show (T n).1 ≫ I₁.cocomplex.d (n + 1) (n + 2) +
        I₃.cocomplex.d n (n + 1) ≫ F n (T n).1 (T n).2 = 0
      rw [(hF n (T n).1 (T n).2).1, add_neg_cancel]

  have s4 : ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃) (σ : S.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), S.f ≫ σ = I₁.ι.f 0 → σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t 0 = 0 → (∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0) → ∃ (K : CochainComplex C ℕ) (i : I₁.cocomplex ⟶ K) (p : K ⟶ I₃.cocomplex) (e : (CochainComplex.single₀ C).obj S.X₂ ⟶ K), (∀ n, Injective (K.X n)) ∧ I₁.ι ≫ i = (CochainComplex.single₀ C).map S.f ≫ e ∧ e ≫ p = (CochainComplex.single₀ C).map S.g ≫ I₃.ι ∧ ∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, Nonempty (ShortComplex.mk (i.f n) (p.f n) h).Splitting := by
    intro I₁ I₃ σ t H1 H2 H3
    let X : ℕ → C := fun n => I₁.cocomplex.X n ⊞ I₃.cocomplex.X n
    let d : ∀ n, X n ⟶ X (n + 1) := fun n =>
      Limits.biprod.lift (Limits.biprod.fst ≫ I₁.cocomplex.d n (n + 1) + Limits.biprod.snd ≫ t n)
        (Limits.biprod.snd ≫ I₃.cocomplex.d n (n + 1))
    have sq : ∀ n, d n ≫ d (n + 1) = 0 := by
      intro n
      have h3 : t n ≫ I₁.cocomplex.d (n + 1) (n + 1 + 1) +
          I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0 := H3 n
      apply Limits.biprod.hom_ext
      · simp only [d, Category.assoc, Limits.biprod.lift_fst, Preadditive.comp_add,
          Preadditive.add_comp, Limits.biprod.lift_fst_assoc, Limits.biprod.lift_snd_assoc,
          HomologicalComplex.d_comp_d, Limits.comp_zero, zero_add, Limits.zero_comp]
        rw [← Preadditive.comp_add, h3, Limits.comp_zero]
      · simp only [d, Category.assoc, Limits.biprod.lift_snd, Limits.biprod.lift_snd_assoc,
          HomologicalComplex.d_comp_d, Limits.comp_zero, Limits.zero_comp]
    let K : CochainComplex C ℕ := CochainComplex.of X d sq
    have hKd : ∀ n, K.d n (n + 1) = d n := fun n => CochainComplex.of_d X d n
    let i : I₁.cocomplex ⟶ K :=
      { f := fun n => (Limits.biprod.inl : I₁.cocomplex.X n ⟶ X n)
        comm' := by
          rintro n m rfl
          rw [hKd]
          apply Limits.biprod.hom_ext <;> simp [d] }
    let p : K ⟶ I₃.cocomplex :=
      { f := fun n => (Limits.biprod.snd : X n ⟶ I₃.cocomplex.X n)
        comm' := by
          rintro n m rfl
          rw [hKd]
          simp [d] }
    have hz : (Limits.biprod.lift σ (S.g ≫ I₃.ι.f 0) : S.X₂ ⟶ X 0) ≫ K.d 0 1 = 0 := by
      have hK0 : K.d 0 1 = d 0 := hKd 0
      rw [hK0]
      apply Limits.biprod.hom_ext
      · simp only [d, Category.assoc, Limits.biprod.lift_fst, Limits.biprod.lift_fst_assoc,
          Preadditive.comp_add, Limits.biprod.lift_snd_assoc, Limits.zero_comp]
        refine Eq.trans ?_ H2
        congr 1
        exact Category.assoc _ _ _
      · simp only [d, Category.assoc, Limits.biprod.lift_snd, Limits.biprod.lift_snd_assoc,
          Limits.zero_comp]
        exact (Category.assoc _ _ _).trans
          ((congrArg (S.g ≫ ·) I₃.ι_f_zero_comp_complex_d).trans Limits.comp_zero)
    refine ⟨K, i, p, (K.fromSingle₀Equiv S.X₂).symm ⟨Limits.biprod.lift σ (S.g ≫ I₃.ι.f 0), hz⟩,
      fun n => ?_, ?_, ?_, fun n => ?_⟩
    · show Injective (I₁.cocomplex.X n ⊞ I₃.cocomplex.X n)
      infer_instance
    · apply HomologicalComplex.from_single_hom_ext
      rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero,
        CochainComplex.fromSingle₀Equiv_symm_apply_f_zero]
      apply Limits.biprod.hom_ext
      · simp [i, H1]
        exact (Category.assoc _ _ _).trans
          ((congrArg (I₁.ι.f 0 ≫ ·) Limits.biprod.inl_fst).trans (Category.comp_id _))
      · simp [i]
        refine ((Category.assoc _ _ _).trans
          ((congrArg (I₁.ι.f 0 ≫ ·) Limits.biprod.inl_snd).trans Limits.comp_zero)).trans ?_
        refine Eq.symm (Eq.trans (Category.assoc S.f S.g (I₃.ι.f 0)).symm ?_)
        exact (congrArg (· ≫ I₃.ι.f 0) S.zero).trans Limits.zero_comp
    · apply HomologicalComplex.from_single_hom_ext
      rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero,
        CochainComplex.fromSingle₀Equiv_symm_apply_f_zero]
      simp [p]
    · refine ⟨Limits.biprod.inl_snd, ⟨?_⟩⟩
      exact ShortComplex.Splitting.mk Limits.biprod.fst Limits.biprod.inr Limits.biprod.inl_fst
        Limits.biprod.inr_snd Limits.biprod.total

  have s5 : ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃) (K : CochainComplex C ℕ) (i : I₁.cocomplex ⟶ K) (p : K ⟶ I₃.cocomplex) (e : (CochainComplex.single₀ C).obj S.X₂ ⟶ K), I₁.ι ≫ i = (CochainComplex.single₀ C).map S.f ≫ e → e ≫ p = (CochainComplex.single₀ C).map S.g ≫ I₃.ι → (∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, (ShortComplex.mk (i.f n) (p.f n) h).ShortExact) → QuasiIso e := by
    intro I₁ I₃ K i p e hi hp hses
    have heg : Epi S.g := hS.epi_g
    have hip : i ≫ p = 0 := by
      ext n
      obtain ⟨h, -⟩ := hses n
      rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
      exact h
    let T := ShortComplex.mk i p hip
    have hT : T.ShortExact := by
      apply HomologicalComplex.shortExact_of_degreewise_shortExact
      intro n
      obtain ⟨h, hn⟩ := hses n
      exact ShortComplex.shortExact_of_iso
        (ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp [T]) (by simp [T])) hn
    rw [quasiIso_iff]
    intro n
    cases n with
    | succ n =>
      rw [quasiIsoAt_iff_exactAt e (n + 1) (CochainComplex.exactAt_succ_single_obj S.X₂ n),
        HomologicalComplex.exactAt_iff_isZero_homology]
      have hex := hT.homology_exact₂ (n + 1)
      have h1 : Limits.IsZero (I₁.cocomplex.homology (n + 1)) :=
        (I₁.cocomplex_exactAt_succ n).isZero_homology
      have h3 : Limits.IsZero (I₃.cocomplex.homology (n + 1)) :=
        (I₃.cocomplex_exactAt_succ n).isZero_homology
      exact hex.isZero_of_both_zeros (h1.eq_of_src _ _) (h3.eq_of_tgt _ _)
    | zero =>
      obtain ⟨ι₁, hι₁⟩ : ∃ ι₁ : S.X₁ ⟶ I₁.cocomplex.X 0, ι₁ = I₁.ι.f 0 := ⟨_, rfl⟩
      obtain ⟨ι₃, hι₃⟩ : ∃ ι₃ : S.X₃ ⟶ I₃.cocomplex.X 0, ι₃ = I₃.ι.f 0 := ⟨_, rfl⟩
      obtain ⟨e0, he0⟩ : ∃ e0 : S.X₂ ⟶ K.X 0, e0 = e.f 0 := ⟨_, rfl⟩
      have hι₁m : Mono ι₁ := by subst hι₁; exact (inferInstance : Mono (I₁.ι.f 0))
      have hι₃m : Mono ι₃ := by subst hι₃; exact (inferInstance : Mono (I₃.ι.f 0))
      have ref₁ : ∀ {A : C} (x : A ⟶ I₁.cocomplex.X 0), x ≫ I₁.cocomplex.d 0 1 = 0 →
          ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₁), π ≫ x = y ≫ ι₁ := by
        subst hι₁
        intro A x hx
        exact I₁.exact₀.exact_up_to_refinements x hx
      have ref₃ : ∀ {A : C} (x : A ⟶ I₃.cocomplex.X 0), x ≫ I₃.cocomplex.d 0 1 = 0 →
          ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₃), π ≫ x = y ≫ ι₃ := by
        subst hι₃
        intro A x hx
        exact I₃.exact₀.exact_up_to_refinements x hx
      have hi0 : Mono (i.f 0) := (hses 0).choose_spec.mono_f
      have hi1 : Mono (i.f 1) := (hses 1).choose_spec.mono_f
      have F1 : S.f ≫ e0 = ι₁ ≫ i.f 0 := by
        have := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) hi
        simp only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero] at this
        subst hι₁ he0
        exact this.symm
      have F2 : e0 ≫ p.f 0 = S.g ≫ ι₃ := by
        have := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) hp
        simp only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero] at this
        subst hι₃ he0
        exact this
      have F3 : e0 ≫ K.d 0 1 = 0 := by
        subst he0
        have hd : ((CochainComplex.single₀ C).obj S.X₂).d 0 1 = 0 := rfl
        exact (e.comm 0 1).trans ((congrArg (· ≫ e.f 1) hd).trans Limits.zero_comp)
      have F4 : i.f 0 ≫ K.d 0 1 = I₁.cocomplex.d 0 1 ≫ i.f 1 := i.comm 0 1
      have F5 : K.d 0 1 ≫ p.f 1 = p.f 0 ≫ I₃.cocomplex.d 0 1 := (p.comm 0 1).symm
      have hmono' : Mono e0 := by
        apply Preadditive.mono_of_cancel_zero
        intro A x hx
        have h1 : x ≫ S.g = 0 := by
          apply (cancel_mono ι₃).1
          rw [Category.assoc, ← F2, ← Category.assoc, hx, Limits.zero_comp, Limits.zero_comp]
        have ref : ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₁), π ≫ x = y ≫ S.f :=
          hS.exact.exact_up_to_refinements x h1
        obtain ⟨A', π, hπ, y, hy⟩ := ref
        have h2 : y ≫ (ι₁ ≫ i.f 0) = 0 := by
          rw [← F1, ← Category.assoc, ← hy, Category.assoc, hx, Limits.comp_zero]
        have h3 : y = 0 := by
          apply (cancel_mono (ι₁ ≫ i.f 0)).1
          rw [h2, Limits.zero_comp]
        apply (cancel_epi π).1
        rw [hy, h3, Limits.zero_comp, Limits.comp_zero]
      have hexact : (ShortComplex.mk e0 (K.d 0 1) F3).Exact := by
        rw [ShortComplex.exact_iff_exact_up_to_refinements]
        intro A x hx
        have hx' : x ≫ K.d 0 1 = 0 := hx
        have s1 : (x ≫ p.f 0) ≫ I₃.cocomplex.d 0 1 = 0 := by
          rw [Category.assoc, ← F5, ← Category.assoc, hx', Limits.zero_comp]
        obtain ⟨A₁, π₁, hπ₁, y₃, hy₃⟩ := ref₃ (x ≫ p.f 0) s1
        obtain ⟨A₂, π₂, hπ₂, y₂, hy₂⟩ := surjective_up_to_refinements_of_epi S.g y₃
        have s3' : (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) ≫ p.f 0 = 0 := by
          have e1 : (π₂ ≫ π₁ ≫ x) ≫ p.f 0 = y₂ ≫ S.g ≫ ι₃ := by
            rw [Category.assoc, Category.assoc, hy₃, ← Category.assoc, hy₂, Category.assoc]
          have e2 : (y₂ ≫ e0) ≫ p.f 0 = y₂ ≫ S.g ≫ ι₃ := by
            rw [Category.assoc, F2]
          rw [Preadditive.sub_comp, e1, e2, sub_self]
        obtain ⟨h0, hs0⟩ := hses 0
        have ref : ∃ (A' : C) (π : A' ⟶ A₂) (_ : Epi π) (z : A' ⟶ I₁.cocomplex.X 0),
            π ≫ (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) = z ≫ i.f 0 :=
          hs0.exact.exact_up_to_refinements _ s3'
        obtain ⟨A₃, π₃, hπ₃, z, hz⟩ := ref
        have s4' : (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) ≫ K.d 0 1 = 0 := by
          simp only [Preadditive.sub_comp, Category.assoc, hx', F3, Limits.comp_zero, sub_self]
        have s4'' : z ≫ I₁.cocomplex.d 0 1 = 0 := by
          apply (cancel_mono (i.f 1)).1
          have : (z ≫ i.f 0) ≫ K.d 0 1 = 0 := by
            rw [← hz, Category.assoc, s4', Limits.comp_zero]
          rw [Limits.zero_comp, Category.assoc, ← F4, ← Category.assoc, this]
        obtain ⟨A₄, π₄, hπ₄, w, hw⟩ := ref₁ z s4''
        have k1 : π₃ ≫ π₂ ≫ π₁ ≫ x = π₃ ≫ y₂ ≫ e0 + z ≫ i.f 0 := by
          rw [← hz, Preadditive.comp_sub]
          abel
        refine ⟨A₄, π₄ ≫ π₃ ≫ π₂ ≫ π₁, inferInstance, π₄ ≫ π₃ ≫ y₂ + w ≫ S.f, ?_⟩
        show (π₄ ≫ π₃ ≫ π₂ ≫ π₁) ≫ x = (π₄ ≫ π₃ ≫ y₂ + w ≫ S.f) ≫ e0
        simp only [Category.assoc, Preadditive.add_comp]
        rw [k1, Preadditive.comp_add, ← Category.assoc π₄ z, hw, Category.assoc, ← F1]
      rw [CochainComplex.quasiIsoAt₀_iff]
      subst he0
      refine (ShortComplex.quasiIso_iff_of_zeros _ ?_ ?_ ?_).2 ⟨hexact, hmono'⟩
      · exact ((CochainComplex.single₀ C).obj S.X₂).shape 0 0 (by simp)
      · rfl
      · exact K.shape 0 0 (by simp)

  have s6 : ∀ (I₁ : InjectiveResolution S.X₁) (I₂ : InjectiveResolution S.X₂) (I₃ : InjectiveResolution S.X₃) (i : I₁.cocomplex ⟶ I₂.cocomplex) (p : I₂.cocomplex ⟶ I₃.cocomplex), I₁.ι ≫ i = (CochainComplex.single₀ C).map S.f ≫ I₂.ι → I₂.ι ≫ p = (CochainComplex.single₀ C).map S.g ≫ I₃.ι → (∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, Nonempty (ShortComplex.mk (i.f n) (p.f n) h).Splitting) → ∀ q : ℕ, (∃ h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0, (ShortComplex.mk _ _ h0).Exact) ∧ ∃ (δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁) (h1 : (R.rightDerived q).map S.g ≫ δ = 0) (h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0), (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact := by
    intro I₁ I₂ I₃ i p hi hp hspl q
    have hip : i ≫ p = 0 := by
      ext n
      obtain ⟨h, -⟩ := hspl n
      rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
      exact h
    have hz : (R.mapHomologicalComplex (ComplexShape.up ℕ)).map i ≫
        (R.mapHomologicalComplex (ComplexShape.up ℕ)).map p = 0 := by
      rw [← Functor.map_comp, hip, Functor.map_zero]
    let S' := ShortComplex.mk _ _ hz
    have hS' : S'.ShortExact := by
      apply HomologicalComplex.shortExact_of_degreewise_shortExact
      intro n
      obtain ⟨h, ⟨spl⟩⟩ := hspl n
      exact ShortComplex.shortExact_of_iso
        (ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp [S']) (by simp [S']))
        (spl.map R).shortExact
    let α₁ : ∀ k, (R.rightDerived k).obj S.X₁ ≅ S'.X₁.homology k :=
      fun k => I₁.isoRightDerivedObj R k
    let α₂ : ∀ k, (R.rightDerived k).obj S.X₂ ≅ S'.X₂.homology k :=
      fun k => I₂.isoRightDerivedObj R k
    let α₃ : ∀ k, (R.rightDerived k).obj S.X₃ ≅ S'.X₃.homology k :=
      fun k => I₃.isoRightDerivedObj R k
    have C1 : ∀ k, (α₁ k).hom ≫ HomologicalComplex.homologyMap S'.f k =
        (R.rightDerived k).map S.f ≫ (α₂ k).hom := by
      intro k
      show (I₁.isoRightDerivedObj R k).hom ≫ _ = _ ≫ (I₂.isoRightDerivedObj R k).hom
      rw [R.rightDerived_map_eq k S.f i hi, Category.assoc, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
      rfl
    have C2 : ∀ k, (α₂ k).hom ≫ HomologicalComplex.homologyMap S'.g k =
        (R.rightDerived k).map S.g ≫ (α₃ k).hom := by
      intro k
      show (I₂.isoRightDerivedObj R k).hom ≫ _ = _ ≫ (I₃.isoRightDerivedObj R k).hom
      rw [R.rightDerived_map_eq k S.g p hp, Category.assoc, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
      rfl
    have hrel : (ComplexShape.up ℕ).Rel q (q + 1) := rfl
    have h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0 := by
      rw [← cancel_mono (α₃ q).hom, Category.assoc, ← C2, ← Category.assoc,
        ← C1, Category.assoc, ← HomologicalComplex.homologyMap_comp, S'.zero,
        HomologicalComplex.homologyMap_zero, Limits.comp_zero, Limits.zero_comp]
    let δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁ :=
      (α₃ q).hom ≫ hS'.δ q (q + 1) hrel ≫ (α₁ (q + 1)).inv
    have Cδ : (α₃ q).hom ≫ hS'.δ q (q + 1) hrel = δ ≫ (α₁ (q + 1)).hom := by
      simp only [δ, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have h1 : (R.rightDerived q).map S.g ≫ δ = 0 := by
      rw [← cancel_mono (α₁ (q + 1)).hom, Category.assoc, ← Cδ,
        ← Category.assoc, ← C2, Category.assoc, hS'.comp_δ, Limits.comp_zero, Limits.zero_comp]
    have h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0 := by
      rw [← cancel_mono (α₂ (q + 1)).hom, Category.assoc, ← C1,
        ← Category.assoc, ← Cδ, Category.assoc, hS'.δ_comp, Limits.comp_zero, Limits.zero_comp]
    refine ⟨⟨h0, ?_⟩, δ, h1, h2, ?_, ?_⟩
    · exact ShortComplex.exact_of_iso
        (ShortComplex.isoMk (α₁ q) (α₂ q) (α₃ q) (C1 q) (C2 q)).symm (hS'.homology_exact₂ q)
    · exact ShortComplex.exact_of_iso
        (ShortComplex.isoMk (α₂ q) (α₃ q) (α₁ (q + 1)) (C2 q) Cδ).symm
        (hS'.homology_exact₃ q (q + 1) hrel)
    · exact ShortComplex.exact_of_iso
        (ShortComplex.isoMk (α₃ q) (α₁ (q + 1)) (α₂ (q + 1)) Cδ (C1 (q + 1))).symm
        (hS'.homology_exact₁ q (q + 1) hrel)

  obtain ⟨σ, t, H1, H2, H3⟩ := s3 (injectiveResolution S.X₁) (injectiveResolution S.X₃)
  obtain ⟨K, i, p, e, hK, hi, hp, hspl⟩ := s4 _ _ σ t H1 H2 H3
  have he : QuasiIso e := s5 _ _ K i p e hi hp (fun n => by
    obtain ⟨h, ⟨spl⟩⟩ := hspl n
    exact ⟨h, spl.shortExact⟩)
  let I₂ : InjectiveResolution S.X₂ :=
    { cocomplex := K, injective := hK, ι := e, quasiIso := he }
  exact s6 _ I₂ _ i p hi hp hspl

theorem wc_et_module_push_acyclic_of_ab : ∀ {T Q : Scheme.{u}} (r : Q ⟶ T) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData r ℓ), (∀ (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (n : ℕ), 1 ≤ n → Limits.IsZero ((((wcEtPush r).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology n)) → letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; ∃ I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Q ℓ)), ∀ n : ℕ, 1 ≤ n → Limits.IsZero ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) :=
by
  classical
  intro T Q r ℓ _ D hJ
  letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives Q
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives T
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology Q) (wcEtZModRing Q ℓ)
  haveI := sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology T) (wcEtZModRing T ℓ)
  haveI hIRQ : HasInjectiveResolutions (SheafOfModules.{u+1} (wcEtZModRing Q ℓ)) :=
    ⟨fun Z => ⟨⟨InjectiveResolution.of Z⟩⟩⟩
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology Q)
    (wcEtZModRing Q ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.smallEtaleTopology T)
    (wcEtZModRing T ℓ)
  have hn : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos

  have s1 : ∀ (X : Scheme.{u}) (E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      [Injective E], Epi (ℓ • 𝟙 E) := by
    intro X E _
    have hP : Injective ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) :=
      Injective.injective_of_adjoint
        (sheafificationAdjunction (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) E
    have hdiv : ∀ (U : X.Etale)
        (s : ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E).obj
          (Opposite.op U)), ∃ t, ℓ • t = s := by
      intro U s
      let P := (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E
      let G : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
        yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let φ : G ⟶ P :=
        { app := fun V => AddCommGrpCat.ofHom (FreeAbelianGroup.lift
            (fun f : ULift.{u+1} (V.unop ⟶ U) => (P.map f.down.op).hom s))
          naturality := by
            intro V W h
            apply AddCommGrpCat.hom_ext
            apply FreeAbelianGroup.lift_ext
            intro f
            show (FreeAbelianGroup.lift (fun f' : ULift.{u+1} (W.unop ⟶ U) => (P.map f'.down.op).hom s))
                ((G.map h).hom (FreeAbelianGroup.of f)) =
              (P.map h).hom ((FreeAbelianGroup.lift
                (fun f' : ULift.{u+1} (V.unop ⟶ U) => (P.map f'.down.op).hom s)) (FreeAbelianGroup.of f))
            have hG : (G.map h).hom (FreeAbelianGroup.of f) =
                FreeAbelianGroup.of (ULift.up (h.unop ≫ f.down)) := rfl
            rw [hG]
            erw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
            show (P.map (h.unop ≫ f.down).op).hom s = (P.map h).hom ((P.map f.down.op).hom s)
            rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp]
            rfl }
      have tf : ∀ (Y : Type (u+1)) (a b : FreeAbelianGroup Y), ℓ • a = ℓ • b → a = b := by
        intro Y a b hab
        apply (FreeAbelianGroup.equivFinsupp Y).injective
        ext x
        have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp Y z x) hab
        simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
        exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hn.ne') hx
      have hmono : Mono (ℓ • 𝟙 G) := by
        have : ∀ V, Mono ((ℓ • 𝟙 G).app V) := by
          intro V
          rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
          intro a b hab
          simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
            AddMonoidHom.id_apply] at hab
          exact tf _ a b hab
        exact NatTrans.mono_of_mono_app _
      let g := Injective.factorThru φ (ℓ • 𝟙 G)
      have hg : (ℓ • 𝟙 G) ≫ g = φ := Injective.comp_factorThru φ (ℓ • 𝟙 G)
      rw [Preadditive.nsmul_comp, Category.id_comp] at hg
      refine ⟨(g.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))), ?_⟩
      have h1 := congrArg (fun α : G ⟶ P =>
        (α.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U)))) hg
      have h2 : (φ.app (Opposite.op U)).hom (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s := by
        show (FreeAbelianGroup.lift (fun f : ULift.{u+1} (U ⟶ U) => (P.map f.down.op).hom s))
          (FreeAbelianGroup.of (ULift.up (𝟙 U))) = s
        rw [FreeAbelianGroup.lift_apply_of]
        simp
      rw [← h2, ← h1]
      simp only [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul]
      rfl
    have hmap : (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (ℓ • 𝟙 E) =
        ℓ • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj E) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    apply Functor.epi_of_epi_map (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    rw [hmap]
    have : ∀ V, Epi ((ℓ • 𝟙 ((sheafToPresheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj E)).app V) := by
      intro V
      rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.epi_iff_surjective]
      intro s
      obtain ⟨t, ht⟩ := hdiv V.unop s
      exact ⟨t, by simpa using ht⟩
    exact NatTrans.epi_of_epi_app _

  have hker : ∀ (E : Sheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}) [Injective E],
      Epi ((wcEtPush r).map (ℓ • 𝟙 E)) → ∀ q : ℕ,
      Limits.IsZero (((wcEtPush r).rightDerived (q + 1)).obj (Limits.kernel (ℓ • 𝟙 E))) := by
    intro E _ hRe q
    let S := ShortComplex.mk (Limits.kernel.ι (ℓ • 𝟙 E)) (ℓ • 𝟙 E) (Limits.kernel.condition _)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ (by dsimp [S]; infer_instance) (s1 Q E)
      exact S.exact_of_f_is_kernel (Limits.kernelIsKernel (ℓ • 𝟙 E))
    obtain ⟨_, _, hles⟩ := wc_rightDerived_les_package (wcEtPush r) S hS
    obtain ⟨_, δ, h1, h2, _, hex⟩ := hles q
    have hf : ((wcEtPush r).rightDerived (q + 1)).map S.f = 0 :=
      (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) q E).eq_of_tgt _ _
    have hδ : δ = 0 := by
      cases q with
      | zero =>
        have hRe' : Epi ((wcEtPush r).map S.g) := hRe
        have hepi : Epi (((wcEtPush r).rightDerived 0).map S.g) := by
          rw [← NatIso.naturality_2 (wcEtPush r).rightDerivedZeroIsoSelf S.g]
          infer_instance
        exact (cancel_epi _).1 (h1.trans Limits.comp_zero.symm)
      | succ m =>
        exact (Functor.isZero_rightDerived_obj_injective_succ (wcEtPush r) m E).eq_of_src _ _
    exact hex.isZero_X₂ hδ hf

  obtain ⟨α₀, hinj₀, hsurj₀, hR⟩ := wc_et_zmod_ring_locbij Q ℓ
  obtain ⟨hfull, hess⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Q)
    (wcEtZModRing Q ℓ) ℓ α₀ hinj₀ hsurj₀
  haveI := hfull
  have hacyc : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing Q ℓ)) [Injective I] (k : ℕ),
      Limits.IsZero (((wcEtPush r).rightDerived (k + 1)).obj
        ((SheafOfModules.toSheaf (wcEtZModRing Q ℓ)).obj I)) := by
    intro I _ k
    let Φ := SheafOfModules.toSheaf.{u+1} (wcEtZModRing Q ℓ)
    have hI0 : ℓ • 𝟙 (Φ.obj I) = 0 := by
      apply (sheafToPresheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).map_injective
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
        CategoryTheory.Functor.map_zero]
      ext X m
      have key : ∀ m' : (I.val.obj X : Type _), ℓ • m' = 0 := fun m' => by
        rw [← Nat.cast_smul_eq_nsmul ((wcEtZModRing Q ℓ).obj.obj X) ℓ m', hR X, zero_smul]
      simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
        AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply,
        AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
      exact key m
    let E := Injective.under (Φ.obj I)
    let ι := Injective.ι (Φ.obj I)
    have hιn : ι ≫ (ℓ • 𝟙 E) = 0 := by
      have h1 : ℓ • ι = (ℓ • 𝟙 (Φ.obj I)) ≫ ι := by
        rw [Preadditive.nsmul_comp, Category.id_comp]
      rw [Preadditive.comp_nsmul, Category.comp_id, h1, hI0, Limits.zero_comp]
    let j := Limits.kernel.lift (ℓ • 𝟙 E) ι hιn
    have hj : j ≫ Limits.kernel.ι (ℓ • 𝟙 E) = ι := Limits.kernel.lift_ι _ _ _
    have : Mono j := mono_of_mono_fac hj
    have hK0 : ℓ • 𝟙 (Limits.kernel (ℓ • 𝟙 E)) = 0 := by
      apply (cancel_mono (Limits.kernel.ι (ℓ • 𝟙 E))).1
      have h1 : Limits.kernel.ι (ℓ • 𝟙 E) ≫ (ℓ • 𝟙 E) = ℓ • Limits.kernel.ι (ℓ • 𝟙 E) := by
        rw [Preadditive.comp_nsmul, Category.comp_id]
      rw [Preadditive.nsmul_comp, Category.id_comp, ← h1, Limits.kernel.condition, Limits.zero_comp]
    obtain ⟨M', ⟨β⟩⟩ := hess _ hK0
    let g := Φ.preimage (j ≫ β.inv)
    have hg : Φ.map g = j ≫ β.inv := Φ.map_preimage _
    have : Mono g := Φ.mono_of_mono_map (by rw [hg]; infer_instance)
    let rr := Injective.factorThru (𝟙 I) g
    have hr : g ≫ rr = 𝟙 I := Injective.comp_factorThru _ _
    let ρ := β.inv ≫ Φ.map rr
    have hjρ : j ≫ ρ = 𝟙 _ := by
      calc j ≫ ρ = (j ≫ β.inv) ≫ Φ.map rr := by simp only [ρ, Category.assoc]
        _ = Φ.map (g ≫ rr) := by rw [Φ.map_comp, hg]
        _ = 𝟙 _ := by rw [hr, Φ.map_id]

    have hEinj : Injective ((wcEtPush r).obj E) := by
      obtain ⟨L, ⟨adj⟩, hL, _⟩ := wc_et_push_left_adjoint r
      haveI := hL
      exact adj.map_injective E inferInstance
    haveI := hEinj
    have hepi : Epi ((wcEtPush r).map (ℓ • 𝟙 E)) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      exact s1 T _
    have hK := hker E hepi k
    rw [Limits.IsZero.iff_id_eq_zero]
    calc 𝟙 _ = ((wcEtPush r).rightDerived (k + 1)).map (𝟙 (Φ.obj I)) :=
          (CategoryTheory.Functor.map_id _ _).symm
      _ = ((wcEtPush r).rightDerived (k + 1)).map j ≫
            ((wcEtPush r).rightDerived (k + 1)).map ρ := by
          rw [← hjρ, CategoryTheory.Functor.map_comp]
      _ = 0 := by
          rw [hK.eq_of_tgt (((wcEtPush r).rightDerived (k + 1)).map j) 0, Limits.zero_comp]

  obtain ⟨βc⟩ := wc_et_toSheaf_pushforward_iso r ℓ D
  have hiso := wc_rightDerived_exact_conj_iso
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) (wcEtPush r)
    (SheafOfModules.toSheaf (wcEtZModRing Q ℓ)) (SheafOfModules.toSheaf (wcEtZModRing T ℓ))
    ⟨βc⟩ hacyc
  refine ⟨InjectiveResolution.of _, fun n hn1 => ?_⟩
  obtain ⟨Θ⟩ := hiso (SheafOfModules.unit (wcEtZModRing Q ℓ)) n
  obtain ⟨e⟩ := wc_et_zmod_unit_toSheaf_iso Q ℓ
  have h1 : Limits.IsZero (((wcEtPush r).rightDerived n).obj
      ((constantSheaf (Scheme.smallEtaleTopology Q) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) :=
    (hJ (InjectiveResolution.of _) n hn1).of_iso
      ((InjectiveResolution.of _).isoRightDerivedObj (wcEtPush r) n)
  have h2 : Limits.IsZero (((wcEtPush r).rightDerived n).obj
      ((SheafOfModules.toSheaf (wcEtZModRing Q ℓ)).obj (SheafOfModules.unit (wcEtZModRing Q ℓ)))) :=
    h1.of_iso (((wcEtPush r).rightDerived n).mapIso e)
  have h3 := h2.of_iso Θ.symm
  have reflZero : ∀ {Y : SheafOfModules.{u+1} (wcEtZModRing T ℓ)},
      Limits.IsZero ((SheafOfModules.toSheaf (wcEtZModRing T ℓ)).obj Y) → Limits.IsZero Y := by
    intro Y hY
    rw [Limits.IsZero.iff_id_eq_zero]
    apply (SheafOfModules.toSheaf (wcEtZModRing T ℓ)).map_injective
    rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_zero]
    exact hY.eq_of_src _ _
  have h4 := reflZero h3
  exact h4.of_iso ((InjectiveResolution.of (SheafOfModules.unit (wcEtZModRing Q ℓ))).isoRightDerivedObj
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange r) _ _ D.cont D.φ) n).symm

theorem wc_et_pull_affine_bundle_bijective : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D : wcEtPullData p ℓ) (k : ℕ), Function.Bijective (wcEtPull D k) :=
by
  classical
  intro K _ _ S fS m _ c P p q hpb ℓ _ hℓ D k

  have hid : ∀ {X : Scheme.{u}} (E : wcEtPullData (𝟙 X) ℓ) (i : ℕ) (x : wcEtZModExt X ℓ i),
      wcEtPull E i x = x := by
    intro X E i x
    have h := wc_et_pull_comp (𝟙 X) (𝟙 X) (𝟙 X) (Category.id_comp _) E E E i x
    have h0 : wcEtPull E i (wcEtPull E i x - x) = 0 := by
      rw [map_sub, ← h, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective E i _ h0)

  have hiso : ∀ {X Y : Scheme.{u}} (g : Y ⟶ X) [IsIso g] (E : wcEtPullData g ℓ) (i : ℕ),
      Function.Bijective (wcEtPull E i) := by
    intro X Y g _ E i
    obtain ⟨Eh⟩ := wc_et_zmod_pull_data_exists (inv g) ℓ
    obtain ⟨EX⟩ := wc_et_zmod_pull_data_exists (𝟙 X) ℓ
    obtain ⟨EY⟩ := wc_et_zmod_pull_data_exists (𝟙 Y) ℓ
    refine ⟨fun x y hxy => ?_, fun y => ⟨wcEtPull Eh i y, ?_⟩⟩
    · have hx := wc_et_pull_comp g (inv g) (𝟙 X) (IsIso.inv_hom_id g) E Eh EX i x
      have hy := wc_et_pull_comp g (inv g) (𝟙 X) (IsIso.inv_hom_id g) E Eh EX i y
      rw [hid] at hx hy
      calc x = wcEtPull Eh i (wcEtPull E i x) := hx
        _ = wcEtPull Eh i (wcEtPull E i y) := by rw [hxy]
        _ = y := hy.symm
    · have h := wc_et_pull_comp (inv g) g (𝟙 Y) (IsIso.hom_inv_id g) Eh E EY i y
      rw [hid] at h
      exact h.symm

  have hA1 : ∀ (T : Scheme.{u}) (fT : T ⟶ Spec (.of K)) [LocallyOfFiniteType fT]
      (E : wcEtPullData (Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ℓ) (i : ℕ),
      Function.Bijective (wcEtPull E i) := by
    intro T fT _ E i
    have h7a := wc_et_affine_line_push_acyclic K ℓ (Fact.out) hℓ T fT
    obtain ⟨I, hI⟩ := wc_et_module_push_acyclic_of_ab _ ℓ E h7a
    have h6 := wc_et_affine_line_unit_iso K T fT ℓ E
    letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) _ _ E.cont E.φ).Additive :=
      @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ E.adj E.additive
    haveI := E.additive
    haveI := E.presLim
    haveI := E.presColim
    exact wc_ext_map_bijective_of_degenerate_leray E.Φ
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fT
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) _ _ E.cont E.φ)
      E.adj _ _ E.μ h6 I hI i

  have main : ∀ (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S)
      (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))),
      IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) →
      ∀ (D : wcEtPullData p ℓ) (k : ℕ), Function.Bijective (wcEtPull D k) := by
    intro c
    induction c with
    | zero =>
      intro P p q hpb D k
      have hbij : Function.Bijective (algebraMap K (MvPolynomial (Fin 0) K)) :=
        ⟨MvPolynomial.C_injective _ _, MvPolynomial.C_surjective _⟩
      haveI : IsIso (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 0) K))) :=
        (RingEquiv.ofBijective _ hbij).toCommRingCatIso.isIso_hom
      haveI : IsIso p := hpb.isIso_fst_of_isIso
      exact hiso p D k
    | succ c ih =>
      intro P p q hpb D k
      haveI : Smooth fS := SmoothOfRelativeDimension.smooth m fS
      haveI : LocallyOfFiniteType fS := inferInstance
      obtain ⟨P', p', q', e, hpb', hlft, he, hep⟩ :=
        wc_affine_space_succ_factor K S fS c P p q hpb
      haveI := hlft
      haveI := he
      obtain ⟨Dp'⟩ := wc_et_zmod_pull_data_exists p' ℓ
      obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst (p' ≫ fS)
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ℓ
      obtain ⟨De⟩ := wc_et_zmod_pull_data_exists e ℓ
      obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists (e ≫ Limits.pullback.fst (p' ≫ fS)
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ℓ
      have h1 := ih P' p' q' hpb' Dp' k
      have h2 := hA1 P' (p' ≫ fS) Dπ k
      have h3 := hiso e De k
      have hfun : ⇑(wcEtPull D k) =
          ⇑(wcEtPull De k) ∘ ⇑(wcEtPull Dπ k) ∘ ⇑(wcEtPull Dp' k) := by
        funext x
        rw [wc_et_pull_comp p' _ p hep Dp' Dr D k x, wc_et_pull_comp _ e _ rfl Dπ De Dr k]
        rfl
      rw [hfun]
      exact h3.comp (h2.comp h1)
  exact main c P p q hpb D k

theorem wc_smooth_over_field_irreducible_reldim : ∀ (K : Type u) [Field K] (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) [Smooth qB] [IrreducibleSpace B], ∃ m : ℕ, SmoothOfRelativeDimension m qB :=
by
  intro K _ B qB _ _
  have s1 : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S), φ.IsStandardSmooth →
      ∃ n : ℕ, RingHom.IsStandardSmoothOfRelativeDimension n φ := by
    intro R S _ _ φ h
    letI := φ.toAlgebra
    have h' : Algebra.IsStandardSmooth R S := h
    obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := h'.out
    exact ⟨P.dimension, Algebra.IsStandardSmoothOfRelativeDimension.mk ⟨ι, σ, hσ, hι, P, rfl⟩⟩
  have s2 : ∀ {R S : Type u} [CommRing R] [CommRing S] [Nontrivial S] (φ : R →+* S) (a b : ℕ),
      RingHom.IsStandardSmoothOfRelativeDimension a φ →
      RingHom.IsStandardSmoothOfRelativeDimension b φ → a = b := by
    intro R S _ _ _ φ a b ha hb
    letI := φ.toAlgebra
    have ha' : Algebra.IsStandardSmoothOfRelativeDimension a R S := ha
    have hb' : Algebra.IsStandardSmoothOfRelativeDimension b R S := hb
    have h1 : Module.rank S (KaehlerDifferential R S) = a := by
      haveI := ha'
      exact Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential a
    have h2 : Module.rank S (KaehlerDifferential R S) = b := by
      haveI := hb'
      exact Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential b
    exact_mod_cast h1.symm.trans h2
  have s3 : ∀ (V : B.Opens), IsAffineOpen V → ∀ (e : V ≤ qB ⁻¹ᵁ ⊤) (n : ℕ),
      RingHom.IsStandardSmoothOfRelativeDimension n (qB.appLE ⊤ V e).hom → ∀ (r : Γ(B, V)),
      RingHom.IsStandardSmoothOfRelativeDimension n
        (qB.appLE ⊤ (B.basicOpen r) ((B.basicOpen_le r).trans e)).hom := by
    intro V hV e n h r
    haveI := hV.isLocalization_basicOpen r
    have h0 : Algebra.IsStandardSmoothOfRelativeDimension 0 Γ(B, V) Γ(B, B.basicOpen r) :=
      Algebra.IsStandardSmoothOfRelativeDimension.localization_away r
    have h0' : RingHom.IsStandardSmoothOfRelativeDimension 0
        (B.presheaf.map (homOfLE (B.basicOpen_le r)).op).hom :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 0).mpr h0
    have hc := RingHom.IsStandardSmoothOfRelativeDimension.comp h0' h
    rw [zero_add, ← CommRingCat.hom_comp, Scheme.Hom.appLE_map] at hc
    exact hc
  have s4 : ∀ (U : (Spec (.of K)).Opens) (p : Spec (.of K)), p ∈ U → U = ⊤ := by
    intro U p hp
    exact top_le_iff.mp (fun q _ => (Subsingleton.elim p q) ▸ hp)
  have s5 : ∀ x : B, ∃ (V : B.Opens) (_ : IsAffineOpen V) (_ : x ∈ V) (e : V ≤ qB ⁻¹ᵁ ⊤) (n : ℕ),
      RingHom.IsStandardSmoothOfRelativeDimension n (qB.appLE ⊤ V e).hom := by
    intro x
    obtain ⟨U, hU, V, hV, hxV, e, hs⟩ := Smooth.exists_isStandardSmooth qB x
    have hUt : U = ⊤ := s4 U _ (e hxV)
    subst hUt
    obtain ⟨n, hn⟩ := s1 _ hs
    exact ⟨V, hV, hxV, e, n, hn⟩
  choose V hV hxV e n hn using s5
  have s7 : ∀ x y, n x = n y := by
    intro x y
    obtain ⟨z, hzx, hzy⟩ := nonempty_preirreducible_inter (V x).isOpen (V y).isOpen
      ⟨x, hxV x⟩ ⟨y, hxV y⟩
    obtain ⟨r, s, hrs, hz⟩ := exists_basicOpen_le_affine_inter (hV x) (hV y) z ⟨hzx, hzy⟩
    have h1 := s3 (V x) (hV x) (e x) (n x) (hn x) r
    have h2 := s3 (V y) (hV y) (e y) (n y) (hn y) s
    have h2' : ∃ e', RingHom.IsStandardSmoothOfRelativeDimension (n y)
        (qB.appLE ⊤ (B.basicOpen s) e').hom := ⟨_, h2⟩
    rw [← hrs] at h2'
    obtain ⟨e', h2'⟩ := h2'
    haveI : Nonempty (B.basicOpen r) := ⟨⟨z, hz⟩⟩
    haveI := Scheme.component_nontrivial B (B.basicOpen r)
    exact s2 _ _ _ h1 h2'
  have hne : Nonempty B := inferInstance
  obtain ⟨x₀⟩ := hne
  refine ⟨n x₀, SmoothOfRelativeDimension.mk ?_⟩
  intro x
  exact ⟨⊤, isAffineOpen_top _, V x, hV x, hxV x, e x, s7 x x₀ ▸ hn x⟩

theorem wc_et_affine_bundle_punct_restr_injective : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) [IsAffine B] [IrreducibleSpace B] [Smooth qB] (c : ℕ), 1 ≤ c → ∀ (U : (AffineSpace (ULift.{u} (Fin c)) B).Opens), (U : Set (AffineSpace (ULift.{u} (Fin c)) B)) = (Set.range (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))))ᶜ → ∀ (Dj : wcEtPullData U.ι ℓ) (k : ℕ), Function.Injective (wcEtPull Dj k) :=
by
  classical
  intro K _ _ ℓ _ hℓ B qB _ _ _ c hc U hU Dj k

  let j₀ : ULift.{u} (Fin c) := ⟨⟨0, hc⟩⟩
  let e₁ : ULift.{u} (Fin c) → Γ(B, ⊤) := fun j => if j = j₀ then 1 else 0
  let s₁ : B ⟶ AffineSpace (ULift.{u} (Fin c)) B := AffineSpace.homOfVector (𝟙 B) e₁
  have hrange : Set.range s₁ ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι, hU]
    rintro _ ⟨x, rfl⟩ ⟨y, hy⟩
    have h1 : s₁ x ∈ (AffineSpace (ULift.{u} (Fin c)) B).basicOpen
        (AffineSpace.coord B j₀) := by
      rw [← Scheme.Hom.mem_preimage, Scheme.preimage_basicOpen]
      have he : (ConcreteCategory.hom (Scheme.Hom.app s₁ ⊤)) (AffineSpace.coord B j₀) = 1 := by
        have := AffineSpace.homOfVector_appTop_coord (𝟙 B) e₁ j₀
        simp only [e₁, if_pos rfl] at this
        exact this
      rw [he, Scheme.basicOpen_one]
      trivial
    have h2 : (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) y ∉
        (AffineSpace (ULift.{u} (Fin c)) B).basicOpen (AffineSpace.coord B j₀) := by
      rw [← Scheme.Hom.mem_preimage, Scheme.preimage_basicOpen]
      have he : (ConcreteCategory.hom (Scheme.Hom.app
          (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) ⊤))
          (AffineSpace.coord B j₀) = 0 := by
        have := AffineSpace.homOfVector_appTop_coord (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) j₀
        exact this
      rw [he, Scheme.basicOpen_zero]
      intro h
      exact h
    exact h2 (hy ▸ h1)
  let s : B ⟶ (U : Scheme.{u}) := IsOpenImmersion.lift U.ι s₁ hrange
  have hs : s ≫ U.ι = s₁ := IsOpenImmersion.lift_fac U.ι s₁ hrange
  have hs' : s ≫ U.ι ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B) = 𝟙 B := by
    rw [← Category.assoc, hs]
    exact AffineSpace.homOfVector_over _ _

  have hpb : ∃ q : AffineSpace (ULift.{u} (Fin c)) B ⟶ Spec (.of (MvPolynomial (Fin c) K)),
      IsPullback (AffineSpace (ULift.{u} (Fin c)) B ↘ B) q qB
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) := by
    let ρ : MvPolynomial (Fin c) K →+* MvPolynomial (ULift.{u} (Fin c)) K :=
      (MvPolynomial.rename (fun i : Fin c => (ULift.up i : ULift.{u} (Fin c)))).toRingHom
    let ρe : MvPolynomial (Fin c) K ≃+* MvPolynomial (ULift.{u} (Fin c)) K :=
      (MvPolynomial.renameEquiv K (Equiv.ulift : ULift.{u} (Fin c) ≃ Fin c).symm).toRingEquiv
    have hρ : (ρe : MvPolynomial (Fin c) K →+* MvPolynomial (ULift.{u} (Fin c)) K) = ρ := rfl
    have : IsIso (Spec.map (CommRingCat.ofHom ρ)) := by
      rw [← hρ]
      exact (Scheme.Spec.mapIso ρe.toCommRingCatIso.op).isIso_hom
    let E3 : AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ≅
        Spec (.of (MvPolynomial (Fin c) K)) :=
      AffineSpace.SpecIso (ULift.{u} (Fin c)) (.of K) ≪≫ asIso (Spec.map (CommRingCat.ofHom ρ))
    have hcomp : ρ.comp (algebraMap K (MvPolynomial (Fin c) K)) =
        (MvPolynomial.C : K →+* MvPolynomial (ULift.{u} (Fin c)) K) := by
      ext x
      simp [ρ, MvPolynomial.algebraMap_eq]
    have hg : (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K)) ≫
          (Iso.refl (Spec (.of K))).hom =
        E3.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) := by
      have h0 := AffineSpace.SpecIso_inv_over (n := ULift.{u} (Fin c)) (CommRingCat.of K)
      rw [Iso.refl_hom, Category.comp_id, Iso.trans_hom, asIso_hom, Category.assoc,
        ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp, ← h0, Iso.hom_inv_id_assoc]
    refine ⟨AffineSpace.map (ULift.{u} (Fin c)) qB ≫ E3.hom, ?_⟩
    exact IsPullback.of_iso (AffineSpace.isPullback_map (n := ULift.{u} (Fin c)) qB).flip
      (Iso.refl _) (Iso.refl _) E3 (Iso.refl _)
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
      (by rw [Iso.refl_hom, Category.id_comp])
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]) hg
  obtain ⟨q, hpb⟩ := hpb

  obtain ⟨m, hm⟩ := wc_smooth_over_field_irreducible_reldim K B qB
  haveI := hm
  obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists (AffineSpace (ULift.{u} (Fin c)) B ↘ B) ℓ
  have hbij := wc_et_pull_affine_bundle_bijective K B qB m c _ _ _ hpb ℓ hℓ Dπ k
  obtain ⟨DUπ⟩ := wc_et_zmod_pull_data_exists (U.ι ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B)) ℓ
  obtain ⟨Ds⟩ := wc_et_zmod_pull_data_exists s ℓ
  obtain ⟨DI⟩ := wc_et_zmod_pull_data_exists (𝟙 B) ℓ

  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨y, rfl⟩ := hbij.2 x
  have h1 := wc_et_pull_comp (AffineSpace (ULift.{u} (Fin c)) B ↘ B) U.ι _ rfl Dπ Dj DUπ k y
  have h2 := wc_et_pull_comp _ s _ hs' DUπ Ds DI k y
  rw [h1, hx, map_zero] at h2
  rw [wc_et_pull_id_injective DI k y h2, map_zero]

theorem wc_affine_space_ulift_mvpoly_zero_pullback : ∀ (K : Type u) [Field K] (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) (c : ℕ), ∃ q : AffineSpace (ULift.{u} (Fin c)) B ⟶ Spec (.of (MvPolynomial (Fin c) K)), IsPullback (AffineSpace (ULift.{u} (Fin c)) B ↘ B) q qB (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) ∧ AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) ≫ q = qB ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) :=
by
  intro K _ B qB c
  have e1 : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : Γ(Z, ⊤)),
      ConcreteCategory.hom (f ≫ g).appTop x =
        ConcreteCategory.hom f.appTop (ConcreteCategory.hom g.appTop x) := by
    intro X Y Z f g x
    rw [Scheme.Hom.comp_appTop]
    rfl
  let ρ : MvPolynomial (Fin c) K →+* MvPolynomial (ULift.{u} (Fin c)) K :=
    (MvPolynomial.rename (ULift.up : Fin c → ULift.{u} (Fin c))).toRingHom
  let ρe : MvPolynomial (Fin c) K ≃+* MvPolynomial (ULift.{u} (Fin c)) K :=
    (MvPolynomial.renameEquiv K (Equiv.ulift (α := Fin c)).symm).toRingEquiv
  let s := AffineSpace.SpecIso (ULift.{u} (Fin c)) (CommRingCat.of K)
  let e : AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ≅ Spec (.of (MvPolynomial (Fin c) K)) :=
    s ≪≫ Scheme.Spec.mapIso ρe.toCommRingCatIso.op
  have he : e.hom = s.hom ≫ Spec.map (CommRingCat.ofHom ρ) := rfl
  have hρC : ρ.comp MvPolynomial.C =
      (MvPolynomial.C : K →+* MvPolynomial (ULift.{u} (Fin c)) K) :=
    RingHom.ext fun r => MvPolynomial.rename_C _ r
  have hccρ : (MvPolynomial.constantCoeff : MvPolynomial (ULift.{u} (Fin c)) K →+* K).comp ρ =
      MvPolynomial.constantCoeff :=
    RingHom.ext fun φ => MvPolynomial.constantCoeff_rename _ φ

  have ha : e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) =
      AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) := by
    rw [he, Category.assoc, ← Iso.eq_inv_comp, AffineSpace.SpecIso_inv_over, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, MvPolynomial.algebraMap_eq, hρC]

  have hnat : ∀ x : MvPolynomial (ULift.{u} (Fin c)) K,
      ConcreteCategory.hom (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (ULift.{u} (Fin c)) K →+* K))).appTop
        (ConcreteCategory.hom (Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial (ULift.{u} (Fin c)) K))).inv x)
      = ConcreteCategory.hom (Scheme.ΓSpecIso (CommRingCat.of K)).inv
          (MvPolynomial.constantCoeff x) := by
    intro x
    have h := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (ULift.{u} (Fin c)) K →+* K))
    have h2 := ConcreteCategory.congr_hom h x
    simp only at h2
    exact h2.symm
  have hkey : AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))
      ≫ s.hom = Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (ULift.{u} (Fin c)) K →+* K)) := by
    rw [← Iso.eq_comp_inv]
    apply AffineSpace.hom_ext
    · rw [AffineSpace.homOfVector_over, Category.assoc, AffineSpace.SpecIso_inv_over,
        ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      erw [MvPolynomial.constantCoeff_comp_C]
      rw [CommRingCat.ofHom_id, Spec.map_id]
    · intro i
      rw [e1, AffineSpace.SpecIso_inv_appTop_coord, AffineSpace.homOfVector_appTop_coord,
        Pi.zero_apply]
      erw [hnat]
      rw [MvPolynomial.constantCoeff_X, map_zero]
  have hb : AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))
      ≫ e.hom = Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) := by
    rw [he, ← Category.assoc, hkey, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hccρ]

  have P0 := AffineSpace.isPullback_map (n := ULift.{u} (Fin c)) qB
  have P1 : IsPullback (AffineSpace (ULift.{u} (Fin c)) B ↘ B)
      (AffineSpace.map (ULift.{u} (Fin c)) qB ≫ e.hom) qB
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) :=
    IsPullback.of_iso P0.flip (Iso.refl _) (Iso.refl _) e (Iso.refl _)
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
      (by rw [Iso.refl_hom, Category.id_comp])
      (by rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp])
      (by rw [Iso.refl_hom, Category.comp_id, ha])

  have hcomm : AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) ≫
      AffineSpace.map (ULift.{u} (Fin c)) qB =
      qB ≫ AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)) := by
    apply AffineSpace.hom_ext
    · rw [Category.assoc, AffineSpace.map_over, ← Category.assoc, AffineSpace.homOfVector_over,
        Category.id_comp, Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]
    · intro i
      simp only [e1, AffineSpace.homOfVector_appTop_coord, AffineSpace.map_appTop_coord,
        Pi.zero_apply, map_zero]
  refine ⟨AffineSpace.map (ULift.{u} (Fin c)) qB ≫ e.hom, P1, ?_⟩
  rw [← Category.assoc, hcomm, Category.assoc, hb]

theorem wc_ext_leray_low_coker : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] (P : D) (A : C) (φ : L.obj P ≅ A) (I : InjectiveResolution A) (N : ℕ), letI := HasExt.standard C; letI := HasExt.standard D; 1 ≤ N → IsIso (adj.unit.app P ≫ R.map φ.hom) → (∀ n : ℕ, 1 ≤ n → n < N → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n)) → ∀ m : ℕ, Finite (P ⟶ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology N) → Nat.card (P ⟶ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology N) ≤ m → ∃ T : Finset (Abelian.Ext (L.obj P) A N), T.card ≤ m ∧ ∀ x : Abelian.Ext (L.obj P) A N, ∃ t ∈ T, ∃ y : Abelian.Ext P P N, x = t + (Abelian.Ext.mapExactFunctor L y).comp (Abelian.Ext.mk₀ φ.hom) (add_zero N) :=
by
  intro C D _ _ _ _ _ L R _ _ adj _ _ P A φ I N
  letI : HasExt C := HasExt.standard C
  letI : HasExt D := HasExt.standard D
  intro hN hθ hH m hfin hcard
  classical
  obtain ⟨M, rfl⟩ : ∃ M, N = M + 1 := ⟨N - 1, by omega⟩
  let K := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  have hKd : ∀ i j, K.d i j = R.map (I.cocomplex.d i j) := fun _ _ => rfl
  have hKX : ∀ (a b : ℕ) (h : a = b), (K.XIsoOfEq h).hom = R.map (I.cocomplex.XIsoOfEq h).hom := by
    intro a b h
    subst h
    simp only [HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, CategoryTheory.Functor.map_id]
    rfl
  have hK : ∀ j, Injective (K.X j) := fun j => by
    haveI := I.injective j
    exact Injective.injective_of_adjoint adj (I.cocomplex.X j)
  obtain ⟨J⟩ : Nonempty (InjectiveResolution P) := ⟨InjectiveResolution.of P⟩
  have s1 : ∀ (h : I.ι.f 0 ≫ I.cocomplex.d 0 1 = 0),
      I.extMk (I.ι.f 0) 1 rfl h = Abelian.Ext.mk₀ (𝟙 A) := by
    intro h
    have := HasDerivedCategory.standard C
    have hz : ∀ (K' : CochainComplex C ℤ),
        ((shiftFunctorZero' (CochainComplex C ℤ) (0:ℤ) rfl).inv.app K').f 0 = 𝟙 _ := by
      intro K'
      simp [shiftFunctorZero', CochainComplex.shiftFunctorZero_inv_app_f]
    have key : ∀ hf', (CochainComplex.HomComplex.Cocycle.equivHomShift.symm
        (CochainComplex.HomComplex.Cocycle.fromSingleMk
          (I.ι.f 0 ≫ (I.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv)
          (zero_add _) ((1 : ℕ) : ℤ) (by simp) hf') :
          ShiftedHom ((CochainComplex.singleFunctor C 0).obj
            (((CochainComplex.single₀ C).obj A).X 0)) I.cochainComplex ((0 : ℕ) : ℤ)) =
          ShiftedHom.mk₀ _ rfl I.ι' := by
      intro hf'
      apply HomologicalComplex.from_single_hom_ext
      rw [CochainComplex.HomComplex.Cocycle.equivHomShift_symm_apply]
      simp [ShiftedHom.mk₀,
        CochainComplex.HomComplex.Cochain.rightShift_v _ _ _ _ 0 0 (add_zero 0) 0 (add_zero 0),
        InjectiveResolution.ι'_f_zero, CochainComplex.HomComplex.Cochain.fromSingleMk_v]
      erw [hz]
      simp
    apply Abelian.Ext.ext
    rw [InjectiveResolution.extMk_hom]
    erw [key]
    erw [ShiftedHom.map_mk₀, ShiftedHom.mk₀_comp_mk₀, ShiftedHom.mk₀_comp_mk₀, Abelian.Ext.mk₀_hom]
    congr 1
    simp
  have liftInj : ∀ {X Y Z W : D} (f : X ⟶ Y) (g' : Y ⟶ Z) (hfg : f ≫ g' = 0),
      (ShortComplex.mk f g' hfg).Exact → Injective W → ∀ (u : Y ⟶ W), f ≫ u = 0 →
      ∃ v : Z ⟶ W, g' ≫ v = u := by
    intro X Y Z W f g' hfg hex hW u hu
    haveI : Mono (Limits.cokernel.desc f g' hfg) := hex.mono_cokernelDesc
    refine ⟨Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g' hfg), ?_⟩
    calc g' ≫ Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g' hfg)
        = (Limits.cokernel.π f ≫ Limits.cokernel.desc f g' hfg) ≫
            Injective.factorThru (Limits.cokernel.desc f u hu) (Limits.cokernel.desc f g' hfg) := by
          rw [Limits.cokernel.π_desc]
      _ = u := by rw [Category.assoc, Injective.comp_factorThru, Limits.cokernel.π_desc]
  have hcI : ∀ {Y : C} {k m' : ℕ} (hm' : k + 1 = m') (f₁ f₂ : Y ⟶ I.cocomplex.X k)
      (h₁ : f₁ ≫ I.cocomplex.d k m' = 0) (h₂ : f₂ ≫ I.cocomplex.d k m' = 0),
      f₁ = f₂ → I.extMk f₁ m' hm' h₁ = I.extMk f₂ m' hm' h₂ := by
    intro Y k m' hm' f₁ f₂ h₁ h₂ e
    subst e
    rfl
  have hsq : ∀ r : ℤ, (r = 1 ∨ r = -1) → r * r = 1 := by
    rintro r (rfl | rfl) <;> norm_num
  have hLz : ∀ {Y Z : D} {k : ℕ} (r : ℤ) (x : Abelian.Ext Y Z k),
      Abelian.Ext.mapExactFunctor L (r • x) = r • Abelian.Ext.mapExactFunctor L x := by
    intro Y Z k r x
    have := map_zsmul (L.mapExtAddHom Y Z k) r x
    rwa [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply] at this
  have hzc : ∀ {X Y Z : C} {a b c : ℕ} (r : ℤ) (x : Abelian.Ext X Y a) (y : Abelian.Ext Y Z b)
      (h : a + b = c), (r • x).comp y h = r • x.comp y h := by
    intro X Y Z a b c r x y h
    have := map_zsmul ((Abelian.Ext.bilinearComp X Y Z a b c h).flip y) r x
    simpa only [AddMonoidHom.flip_apply, Abelian.Ext.bilinearComp_apply_apply] using this
  have hφ0z : ∀ k, adj.homEquiv P (I.cocomplex.X k) 0 = 0 := fun k => by
    rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have hhe_sub : ∀ {k : ℕ} (a b : L.obj P ⟶ I.cocomplex.X k),
      adj.homEquiv P _ (a - b) = adj.homEquiv P _ a - adj.homEquiv P _ b := by
    intro k a b
    simp only [Adjunction.homEquiv_unit, Functor.map_sub, Preadditive.comp_sub]
  obtain ⟨ιA, hιA⟩ : ∃ x : A ⟶ I.cocomplex.X 0, x = I.ι.f 0 := ⟨I.ι.f 0, rfl⟩
  have hιA0 : ιA ≫ I.cocomplex.d 0 1 = 0 := by
    rw [hιA]
    exact I.ι_f_zero_comp_complex_d
  haveI hιAm : Mono ιA := by
    rw [hιA]
    first
      | exact (inferInstance : Mono (I.ι.f 0))
      | exact Limits.mono_of_isLimit_fork I.isLimitKernelFork
  obtain ⟨θ, hθe⟩ : ∃ x : P ⟶ R.obj A, x = adj.unit.app P ≫ R.map φ.hom := ⟨_, rfl⟩
  obtain ⟨θinv, hθ1, hθ2⟩ : ∃ y : R.obj A ⟶ P, θ ≫ y = 𝟙 P ∧ y ≫ θ = 𝟙 (R.obj A) := by
    rw [hθe]
    exact hθ.out
  have hg : (φ.hom ≫ ιA) ≫ I.cocomplex.d 0 (0 + 1) = 0 := by
    show (φ.hom ≫ ιA) ≫ I.cocomplex.d 0 1 = 0
    rw [Category.assoc, hιA0, Limits.comp_zero]
  obtain ⟨φ0, hφ0e⟩ : ∃ x : P ⟶ K.X 0, x = adj.homEquiv _ _ (φ.hom ≫ ιA) := ⟨_, rfl⟩
  have hφ0def : φ0 = θ ≫ R.map ιA := by
    rw [hφ0e, hθe, Adjunction.homEquiv_unit, Functor.map_comp, Category.assoc]
  have hφ0 : φ0 ≫ K.d 0 1 = 0 := by
    rw [hφ0def, hKd, Category.assoc, ← Functor.map_comp, hιA0,
      Functor.map_zero, Limits.comp_zero]
  have hmono : Mono φ0 := by
    rw [hφ0def]
    haveI : R.IsRightAdjoint := adj.isRightAdjoint
    haveI : Mono θ := ⟨fun a b hab => by
      have := congrArg (· ≫ θinv) hab
      simpa only [Category.assoc, hθ1, Category.comp_id] using this⟩
    infer_instance
  have hex0 : (ShortComplex.mk φ0 (K.d 0 1) hφ0).Exact := by
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro T x hx
    have hx' : (adj.homEquiv T (I.cocomplex.X 0)).symm x ≫ I.cocomplex.d 0 1 = 0 := by
      rw [← adj.homEquiv_naturality_right_symm]
      have : x ≫ R.map (I.cocomplex.d 0 1) = 0 := hx
      rw [this, Adjunction.homEquiv_counit, Functor.map_zero, Limits.zero_comp]
    obtain ⟨y0, hy⟩ := Limits.KernelFork.IsLimit.lift' I.isLimitKernelFork _ hx'
    obtain ⟨y, hyy⟩ : ∃ y : L.obj T ⟶ A, y = y0 := ⟨y0, rfl⟩
    have hy' : y ≫ ιA = (adj.homEquiv T (I.cocomplex.X 0)).symm x := by
      rw [hyy, hιA]
      exact hy
    refine ⟨T, 𝟙 T, inferInstance, adj.homEquiv _ _ y ≫ θinv, ?_⟩
    have key : (adj.homEquiv T A y ≫ θinv) ≫ φ0 = adj.homEquiv T (I.cocomplex.X 0) (y ≫ ιA) := by
      rw [hφ0def, Category.assoc, ← Category.assoc θinv, hθ2, Category.id_comp,
        adj.homEquiv_naturality_right]
    rw [hy', Equiv.apply_symm_apply] at key
    exact (Category.id_comp _).trans key.symm
  have hexK : ∀ k : ℕ, k + 1 ≤ M →
      (ShortComplex.mk (K.d k (k + 1)) (K.d (k + 1) (k + 1 + 1)) (K.d_comp_d _ _ _)).Exact := by
    intro k hk
    have h1 : K.ExactAt (k + 1) :=
      (HomologicalComplex.exactAt_iff_isZero_homology K (k + 1)).mpr
        (hH (k + 1) (by omega) (by omega))
    exact (HomologicalComplex.exactAt_iff' K k (k + 1) (k + 1 + 1) (CochainComplex.prev_nat_succ k)
      (CochainComplex.next ℕ (k + 1))).mp h1
  have chainLift : ∀ (n : ℕ) (φ' : P ⟶ K.X n), φ' ≫ K.d n (n + 1) = 0 →
      ∃ ψ : (k : ℕ) → (J.cocomplex.X k ⟶ K.X (n + k)), J.ι.f 0 ≫ ψ 0 = φ' ∧
        ∀ k, ψ k ≫ K.d (n + k) (n + k + 1) = J.cocomplex.d k (k + 1) ≫ ψ (k + 1) := by
    intro n φ' hφ'
    let T : ℕ → Type _ := fun k => {p : (J.cocomplex.X k ⟶ K.X (n + k)) ×
        (J.cocomplex.X (k + 1) ⟶ K.X (n + (k + 1))) //
      p.1 ≫ K.d (n + k) (n + (k + 1)) = J.cocomplex.d k (k + 1) ≫ p.2}
    have hstep : ∀ (k : ℕ) (p : T k), ∃ c : J.cocomplex.X (k + 2) ⟶ K.X (n + (k + 2)),
        J.cocomplex.d (k + 1) (k + 2) ≫ c = p.1.2 ≫ K.d (n + (k + 1)) (n + (k + 2)) := by
      intro k p
      have hu : J.cocomplex.d k (k + 1) ≫ (p.1.2 ≫ K.d (n + (k + 1)) (n + (k + 2))) = 0 := by
        rw [← Category.assoc, ← p.2, Category.assoc, K.d_comp_d, Limits.comp_zero]
      exact liftInj _ _ _ (J.exact_succ k) (hK _) _ hu
    choose c hc using hstep
    have hbase : ∃ p : T 0, J.ι.f 0 ≫ p.1.1 = φ' := by
      let ι0 : P ⟶ J.cocomplex.X 0 := J.ι.f 0
      haveI : Mono ι0 := (inferInstance : Mono (J.ι.f 0))
      haveI := hK (n + 0)
      let ψ0 : J.cocomplex.X 0 ⟶ K.X (n + 0) := Injective.factorThru φ' ι0
      have hψ0 : ι0 ≫ ψ0 = φ' := Injective.comp_factorThru _ _
      have hu : J.ι.f 0 ≫ (ψ0 ≫ K.d (n + 0) (n + (0 + 1))) = 0 := by
        rw [← Category.assoc]
        exact (congrArg (· ≫ K.d (n + 0) (n + (0 + 1))) hψ0).trans hφ'
      obtain ⟨v, hv⟩ := liftInj _ _ _ J.exact₀ (hK _) _ hu
      exact ⟨⟨(ψ0, v), hv.symm⟩, hψ0⟩
    obtain ⟨p0, hp0⟩ := hbase
    let F : (k : ℕ) → T k := fun k => Nat.rec (motive := T) p0
      (fun k p => ⟨(p.1.2, c k p), (hc k p).symm⟩) k
    refine ⟨fun k => (F k).1.1, hp0, fun k => ?_⟩
    have h1 := (F k).2
    have h2 : (F (k + 1)).1.1 = (F k).1.2 := by
      show (Nat.rec (motive := T) p0 (fun k p => ⟨(p.1.2, c k p), (hc k p).symm⟩) (k + 1)).1.1 = _
      rfl
    show (F k).1.1 ≫ K.d (n + k) (n + (k + 1)) = J.cocomplex.d k (k + 1) ≫ (F (k + 1)).1.1
    rw [h2]
    exact h1
  obtain ⟨ψ, hψ0, hψ⟩ := chainLift 0 φ0 hφ0
  obtain ⟨ψ', hψ'e⟩ : ∃ ψ' : (k : ℕ) → (J.cocomplex.X k ⟶ K.X k),
      ∀ k, ψ' k = ψ k ≫ (K.XIsoOfEq (Nat.zero_add k)).hom := ⟨_, fun _ => rfl⟩
  have hψ'0 : J.ι.f 0 ≫ ψ' 0 = φ0 := by
    rw [hψ'e, ← Category.assoc, hψ0]
    first
      | exact Category.comp_id φ0
      | simp
  have hψ' : ∀ k, ψ' k ≫ K.d k (k + 1) = J.cocomplex.d k (k + 1) ≫ ψ' (k + 1) := by
    intro k
    have e1 : ∀ (a b : ℕ) (h : a = b) (h' : a + 1 = b + 1),
        (K.XIsoOfEq h).hom ≫ K.d b (b + 1) = K.d a (a + 1) ≫ (K.XIsoOfEq h').hom := by
      intro a b h h'
      subst h
      simp
    have e2 : ψ' (k + 1) = ψ (k + 1) ≫ (K.XIsoOfEq (show 0 + k + 1 = k + 1 by omega)).hom :=
      hψ'e (k + 1)
    rw [e2, hψ'e k, Category.assoc, e1 (0 + k) k (Nat.zero_add k) (by omega), ← Category.assoc,
      hψ k, Category.assoc]
  let Tχ : ℕ → Type _ := fun k => {p : (K.X k ⟶ J.cocomplex.X k) ×
      (K.X (k + 1) ⟶ J.cocomplex.X (k + 1)) //
    k ≤ M → p.1 ≫ J.cocomplex.d k (k + 1) = K.d k (k + 1) ≫ p.2}
  have hstepχ : ∀ (k : ℕ) (p : Tχ k), ∃ c : K.X (k + 1 + 1) ⟶ J.cocomplex.X (k + 1 + 1),
      k + 1 ≤ M → p.1.2 ≫ J.cocomplex.d (k + 1) (k + 1 + 1) = K.d (k + 1) (k + 1 + 1) ≫ c := by
    intro k p
    by_cases hk : k + 1 ≤ M
    · have hp : p.1.1 ≫ J.cocomplex.d k (k + 1) = K.d k (k + 1) ≫ p.1.2 := p.2 (by omega)
      have hu : K.d k (k + 1) ≫ (p.1.2 ≫ J.cocomplex.d (k + 1) (k + 1 + 1)) = 0 := by
        rw [← Category.assoc, ← hp, Category.assoc, J.cocomplex.d_comp_d, Limits.comp_zero]
      obtain ⟨v, hv⟩ := liftInj _ _ _ (hexK k hk) (J.injective _) _ hu
      exact ⟨v, fun _ => hv.symm⟩
    · exact ⟨0, fun h => absurd h hk⟩
  choose cχ hcχ using hstepχ
  have hbaseχ : ∃ p : Tχ 0, φ0 ≫ p.1.1 = J.ι.f 0 := by
    let ι0 : P ⟶ J.cocomplex.X 0 := J.ι.f 0
    haveI := J.injective 0
    haveI := hmono
    let χ0 : K.X 0 ⟶ J.cocomplex.X 0 := Injective.factorThru ι0 φ0
    have hχ0 : φ0 ≫ χ0 = ι0 := Injective.comp_factorThru _ _
    have hu : φ0 ≫ (χ0 ≫ J.cocomplex.d 0 1) = 0 := by
      rw [← Category.assoc, hχ0]
      exact J.ι_f_zero_comp_complex_d
    obtain ⟨v, hv⟩ := liftInj _ _ _ hex0 (J.injective _) _ hu
    exact ⟨⟨(χ0, v), fun _ => hv.symm⟩, hχ0⟩
  obtain ⟨q0, hq0⟩ := hbaseχ
  let Fχ : (k : ℕ) → Tχ k := fun k => Nat.rec (motive := Tχ) q0
    (fun k p => ⟨(p.1.2, cχ k p), hcχ k p⟩) k
  obtain ⟨χ, hχe⟩ : ∃ χ : (k : ℕ) → (K.X k ⟶ J.cocomplex.X k), ∀ k, χ k = (Fχ k).1.1 :=
    ⟨_, fun _ => rfl⟩
  have hχ0 : φ0 ≫ χ 0 = J.ι.f 0 := by
    rw [hχe]
    exact hq0
  have hχ : ∀ k, k ≤ M → χ k ≫ J.cocomplex.d k (k + 1) = K.d k (k + 1) ≫ χ (k + 1) := by
    intro k hk
    have h2 : (Fχ (k + 1)).1.1 = (Fχ k).1.2 := by
      show (Nat.rec (motive := Tχ) q0 (fun k p => ⟨(p.1.2, cχ k p), hcχ k p⟩) (k + 1)).1.1 = _
      rfl
    rw [hχe, hχe, h2]
    exact (Fχ k).2 hk
  obtain ⟨u, hue⟩ : ∃ u : (k : ℕ) → (K.X k ⟶ K.X k), ∀ k, u k = 𝟙 _ - χ k ≫ ψ' k :=
    ⟨_, fun _ => rfl⟩
  have hφχψ : φ0 ≫ χ 0 ≫ ψ' 0 = φ0 := by
    rw [← Category.assoc, hχ0]
    exact hψ'0
  have hu0 : φ0 ≫ u 0 = 0 := by
    rw [hue 0, Preadditive.comp_sub, Category.comp_id, hφχψ, sub_self]
  have hucomm : ∀ k, k ≤ M → u k ≫ K.d k (k + 1) = K.d k (k + 1) ≫ u (k + 1) := by
    intro k hk
    rw [hue, hue, Preadditive.sub_comp, Preadditive.comp_sub, Category.id_comp, Category.comp_id,
      Category.assoc, hψ' k, ← Category.assoc (χ k), hχ k hk, Category.assoc]
  let Tσ : ℕ → Type _ := fun k => {p : (K.X (k + 1) ⟶ K.X k) × (K.X (k + 1 + 1) ⟶ K.X (k + 1)) //
    k + 1 ≤ M → K.d (k + 1) (k + 1 + 1) ≫ p.2 = u (k + 1) - p.1 ≫ K.d k (k + 1)}
  have hstepσ : ∀ (k : ℕ) (p : Tσ k), ∃ c : K.X (k + 1 + 1 + 1) ⟶ K.X (k + 1 + 1),
      k + 1 + 1 ≤ M → K.d (k + 1 + 1) (k + 1 + 1 + 1) ≫ c =
        u (k + 1 + 1) - p.1.2 ≫ K.d (k + 1) (k + 1 + 1) := by
    intro k p
    by_cases hk : k + 1 + 1 ≤ M
    · have hp : K.d (k + 1) (k + 1 + 1) ≫ p.1.2 = u (k + 1) - p.1.1 ≫ K.d k (k + 1) :=
        p.2 (by omega)
      have hc1 : u (k + 1) ≫ K.d (k + 1) (k + 1 + 1) = K.d (k + 1) (k + 1 + 1) ≫ u (k + 1 + 1) :=
        hucomm (k + 1) (by omega)
      have hu : K.d (k + 1) (k + 1 + 1) ≫ (u (k + 1 + 1) - p.1.2 ≫ K.d (k + 1) (k + 1 + 1)) = 0 := by
        rw [Preadditive.comp_sub, ← Category.assoc, hp, Preadditive.sub_comp, Category.assoc,
          K.d_comp_d, Limits.comp_zero, sub_zero, hc1, sub_self]
      obtain ⟨v, hv⟩ := liftInj _ _ _ (hexK (k + 1) hk) (hK _) _ hu
      exact ⟨v, fun _ => hv⟩
    · exact ⟨0, fun h => absurd h hk⟩
  choose cσ hcσ using hstepσ
  have hbaseσ : ∃ p : Tσ 0, K.d 0 1 ≫ p.1.1 = u 0 := by
    obtain ⟨σ0, hσ0⟩ := liftInj _ _ _ hex0 (hK 0) (u 0) hu0
    by_cases h1 : 1 ≤ M
    · have hc0 : u 0 ≫ K.d 0 1 = K.d 0 1 ≫ u 1 := hucomm 0 (by omega)
      have hv : K.d 0 1 ≫ (u 1 - σ0 ≫ K.d 0 1) = 0 := by
        rw [Preadditive.comp_sub, ← Category.assoc, hσ0, hc0, sub_self]
      obtain ⟨σ1, hσ1⟩ := liftInj _ _ _ (hexK 0 (by omega)) (hK 1) _ hv
      exact ⟨⟨(σ0, σ1), fun _ => hσ1⟩, hσ0⟩
    · exact ⟨⟨(σ0, 0), fun h => absurd h (by omega)⟩, hσ0⟩
  obtain ⟨r0, hr0⟩ := hbaseσ
  let Fσ : (k : ℕ) → Tσ k := fun k => Nat.rec (motive := Tσ) r0
    (fun k p => ⟨(p.1.2, cσ k p), hcσ k p⟩) k
  obtain ⟨σ, hσe⟩ : ∃ σ : (k : ℕ) → (K.X (k + 1) ⟶ K.X k), ∀ k, σ k = (Fσ k).1.1 :=
    ⟨_, fun _ => rfl⟩
  have hσ0 : K.d 0 1 ≫ σ 0 = u 0 := by
    rw [hσe]
    exact hr0
  have hσs : ∀ k, k + 1 ≤ M →
      K.d (k + 1) (k + 1 + 1) ≫ σ (k + 1) = u (k + 1) - σ k ≫ K.d k (k + 1) := by
    intro k hk
    have h2 : (Fσ (k + 1)).1.1 = (Fσ k).1.2 := by
      show (Nat.rec (motive := Tσ) r0 (fun k p => ⟨(p.1.2, cσ k p), hcσ k p⟩) (k + 1)).1.1 = _
      rfl
    rw [hσe, hσe, h2]
    exact (Fσ k).2 hk

  have hAM : K.d M (M + 1) ≫ σ M ≫ K.d M (M + 1) = K.d M (M + 1) ≫ u (M + 1) := by
    have hc := hucomm M le_rfl
    rcases Nat.eq_zero_or_pos M with h0 | hpos
    · obtain rfl := h0
      have hc' : u 0 ≫ K.d 0 1 = K.d 0 1 ≫ u 1 := hc
      show K.d 0 1 ≫ σ 0 ≫ K.d 0 1 = K.d 0 1 ≫ u 1
      rw [← Category.assoc, hσ0, hc']
    · obtain ⟨k, rfl⟩ : ∃ k, M = k + 1 := ⟨M - 1, by omega⟩
      have hs' := hσs k le_rfl
      rw [← Category.assoc, hs', Preadditive.sub_comp, Category.assoc, K.d_comp_d,
        Limits.comp_zero, sub_zero, hc]

  have hclass : ∀ {Y : D} (c c' : P ⟶ K.X (M + 1)) (hc : c ≫ K.d (M + 1) (M + 1 + 1) = 0)
      (hc' : c' ≫ K.d (M + 1) (M + 1 + 1) = 0) (g : K.X (M + 1) ⟶ Y), K.d M (M + 1) ≫ g = 0 →
      K.liftCycles c (M + 1 + 1) (by simp) hc ≫ K.homologyπ (M + 1) =
        K.liftCycles c' (M + 1 + 1) (by simp) hc' ≫ K.homologyπ (M + 1) → c ≫ g = c' ≫ g := by
    intro Y c c' hc hc' g hg heq
    have hk : K.toCycles M (M + 1) ≫ (K.iCycles (M + 1) ≫ g) = 0 := by
      rw [← Category.assoc, HomologicalComplex.toCycles_i, hg]
    obtain ⟨g', hg'⟩ := Limits.CokernelCofork.IsColimit.desc'
      (K.homologyIsCokernel M (M + 1) (CochainComplex.prev_nat_succ M)) _ hk
    have hg2 : K.homologyπ (M + 1) ≫ g' = K.iCycles (M + 1) ≫ g := hg'
    calc c ≫ g = K.liftCycles c (M + 1 + 1) (by simp) hc ≫ K.iCycles (M + 1) ≫ g := by
          rw [← Category.assoc, HomologicalComplex.liftCycles_i]
      _ = (K.liftCycles c (M + 1 + 1) (by simp) hc ≫ K.homologyπ (M + 1)) ≫ g' := by
          rw [← hg2, Category.assoc]
      _ = (K.liftCycles c' (M + 1 + 1) (by simp) hc' ≫ K.homologyπ (M + 1)) ≫ g' := by
          rw [heq]
      _ = c' ≫ g := by
          rw [Category.assoc, hg2, ← Category.assoc, HomologicalComplex.liftCycles_i]

  have hg' : (φ.hom ≫ I.ι.f 0) ≫ I.cocomplex.d 0 (0 + 1) = 0 := by
    rw [← hιA]
    exact hg
  have hφ0e' : φ0 = adj.homEquiv _ _ (φ.hom ≫ I.ι.f 0) := by
    rw [hφ0e, hιA]
  have hcls : I.extMk (φ.hom ≫ I.ι.f 0) (0 + 1) rfl hg' = Abelian.Ext.mk₀ φ.hom := by
    have := InjectiveResolution.mk₀_comp_extMk I (I.ι.f 0) 1 rfl I.ι_f_zero_comp_complex_d φ.hom
    rw [s1 I.ι_f_zero_comp_complex_d] at this
    exact this.symm.trans (Abelian.Ext.comp_mk₀_id _)
  obtain ⟨s, hs, H⟩ := wc_lh_extMk_comp_transport L R adj P A I J 0 (φ.hom ≫ I.ι.f 0) hg' ψ
    (hψ0.trans hφ0e') hψ (M + 1)

  have hrep : ∀ x : Abelian.Ext (L.obj P) A (M + 1), ∃ f : L.obj P ⟶ I.cocomplex.X (M + 1),
      ∃ hf : f ≫ I.cocomplex.d (M + 1) (M + 1 + 1) = 0, I.extMk f (M + 1 + 1) rfl hf = x :=
    fun x => I.extMk_surjective x (M + 1 + 1) rfl
  choose F hF hFx using hrep
  have hcc : ∀ x, adj.homEquiv _ _ (F x) ≫ K.d (M + 1) (M + 1 + 1) = 0 := by
    intro x
    rw [hKd, ← adj.homEquiv_naturality_right, hF x, hφ0z]
  obtain ⟨Θ, hΘdef⟩ : ∃ Θ : Abelian.Ext (L.obj P) A (M + 1) → (P ⟶ K.homology (M + 1)),
      ∀ x, Θ x = K.liftCycles (adj.homEquiv _ _ (F x)) (M + 1 + 1) (by simp) (hcc x) ≫
        K.homologyπ (M + 1) := ⟨_, fun _ => rfl⟩
  have key : ∀ x x' : Abelian.Ext (L.obj P) A (M + 1), Θ x = Θ x' →
      ∃ y : Abelian.Ext P P (M + 1), x = x' + (Abelian.Ext.mapExactFunctor L y).comp
        (Abelian.Ext.mk₀ φ.hom) (add_zero (M + 1)) := by
    intro x x' hΘ
    rw [hΘdef, hΘdef] at hΘ
    obtain ⟨c, hcdef⟩ : ∃ c : P ⟶ K.X (M + 1),
        c = adj.homEquiv _ _ (F x) - adj.homEquiv _ _ (F x') := ⟨_, rfl⟩
    have hkill : ∀ {Y : D} (g : K.X (M + 1) ⟶ Y), K.d M (M + 1) ≫ g = 0 → c ≫ g = 0 := by
      intro Y g hg0
      rw [hcdef, Preadditive.sub_comp, sub_eq_zero]
      exact hclass _ _ (hcc x) (hcc x') g hg0 hΘ
    obtain ⟨β, hβdef⟩ : ∃ β : P ⟶ J.cocomplex.X (M + 1), β = c ≫ χ (M + 1) := ⟨_, rfl⟩
    have hβ : β ≫ J.cocomplex.d (M + 1) (M + 1 + 1) = 0 := by
      rw [hβdef, Category.assoc]
      apply hkill
      rw [← Category.assoc, ← hχ M le_rfl, Category.assoc, J.cocomplex.d_comp_d, Limits.comp_zero]
    have hcu : c ≫ u (M + 1) = (c ≫ σ M) ≫ K.d M (M + 1) := by
      have h := hkill (u (M + 1) - σ M ≫ K.d M (M + 1))
        (by rw [Preadditive.comp_sub, hAM, sub_self])
      rw [Preadditive.comp_sub, sub_eq_zero] at h
      rw [h, Category.assoc]
    obtain ⟨f, hfdef⟩ : ∃ f : L.obj P ⟶ I.cocomplex.X (M + 1), f = F x - F x' := ⟨_, rfl⟩
    have hf : f ≫ I.cocomplex.d (M + 1) (M + 1 + 1) = 0 := by
      rw [hfdef, Preadditive.sub_comp, hF, hF, sub_zero]
    have hfc : adj.homEquiv _ _ f = c := by
      rw [hfdef, hhe_sub, hcdef]
    obtain ⟨T, hTdef⟩ : ∃ T : L.obj P ⟶ I.cocomplex.X (M + 1),
        T = (adj.homEquiv _ _).symm (β ≫ ψ (M + 1)) ≫
          (I.cocomplex.XIsoOfEq (Nat.zero_add (M + 1))).hom := ⟨_, rfl⟩
    have hTe : adj.homEquiv _ _ T = β ≫ ψ' (M + 1) := by
      rw [hTdef, adj.homEquiv_naturality_right, Equiv.apply_symm_apply, hψ'e, hKX, Category.assoc]
    have hfT : f - T = (adj.homEquiv _ _).symm (c ≫ σ M) ≫ I.cocomplex.d M (M + 1) := by
      rw [← adj.homEquiv_naturality_right_symm]
      apply (adj.homEquiv P (I.cocomplex.X (M + 1))).injective
      rw [Equiv.apply_symm_apply, ← hKd, ← hcu, hhe_sub, hTe, hfc, hue, Preadditive.comp_sub,
        hβdef, Category.assoc, Category.comp_id]
    have hT : T ≫ I.cocomplex.d (M + 1) (M + 1 + 1) = 0 := by
      rw [← sub_sub_cancel f T, hfT, Preadditive.sub_comp, hf, Category.assoc,
        HomologicalComplex.d_comp_d, Limits.comp_zero, sub_zero]
    have hTI : ((adj.homEquiv _ _).symm (β ≫ ψ (M + 1)) ≫
        (I.cocomplex.XIsoOfEq (Nat.zero_add (M + 1))).hom) ≫
        I.cocomplex.d (M + 1) (M + 1 + 1) = 0 := by
      rw [← hTdef]
      exact hT
    have hext' : I.extMk f (M + 1 + 1) rfl hf = I.extMk T (M + 1 + 1) rfl hT := by
      rw [← sub_eq_zero, I.sub_extMk]
      exact (I.extMk_eq_zero_iff _ (M + 1 + 1) rfl _ M rfl).mpr ⟨_, hfT.symm⟩
    have hext : I.extMk f (M + 1 + 1) rfl hf = I.extMk ((adj.homEquiv _ _).symm (β ≫ ψ (M + 1)) ≫
        (I.cocomplex.XIsoOfEq (Nat.zero_add (M + 1))).hom) (M + 1 + 1) rfl hTI :=
      hext'.trans (hcI rfl _ _ _ _ hTdef)
    have hxx : x - x' = I.extMk f (M + 1 + 1) rfl hf := by
      rw [← hFx x, ← hFx x', I.sub_extMk]
      exact hcI rfl _ _ _ _ hfdef.symm
    have H1 := H (M + 1) (add_zero (M + 1)) (Nat.zero_add (M + 1)) β hβ hTI
    refine ⟨s • J.extMk β (M + 1 + 1) rfl hβ, ?_⟩
    rw [hLz, hzc, ← hcls, H1, smul_smul, hsq s hs, one_smul, ← hext, ← hxx]
    abel

  haveI := hfin
  letI : Fintype (P ⟶ K.homology (M + 1)) := Fintype.ofFinite _
  haveI : Nonempty (Abelian.Ext (L.obj P) A (M + 1)) := ⟨0⟩
  refine ⟨Finset.univ.image (Function.invFun Θ), ?_, ?_⟩
  · calc (Finset.univ.image (Function.invFun Θ)).card
        ≤ (Finset.univ : Finset (P ⟶ K.homology (M + 1))).card := Finset.card_image_le
      _ = Nat.card (P ⟶ K.homology (M + 1)) := by rw [Finset.card_univ, Nat.card_eq_fintype_card]
      _ ≤ m := hcard
  · intro x
    refine ⟨Function.invFun Θ (Θ x), Finset.mem_image_of_mem _ (Finset.mem_univ _), ?_⟩
    have hinv : Θ (Function.invFun Θ (Θ x)) = Θ x := Function.invFun_eq ⟨x, rfl⟩
    exact key x _ hinv.symm

theorem wc_et_punct_push_unit_iso : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → 1 ≤ c → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcEtPullData (U.ι ≫ p) ℓ), IsIso (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing S ℓ)) ≫ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (U.ι ≫ p)) _ _ D.cont D.φ).map D.μ.hom) :=
by
  classical
  intro K _ _ S fS m _ c P p q z0 hP hz0p hz0q hc U hU ℓ _ D

  obtain ⟨τ, hτ⟩ : ∃ τ : S ⟶ (U : Scheme.{u}), τ ≫ U.ι ≫ p = 𝟙 S := by
    let i₀ : Fin c := ⟨0, by omega⟩
    let e : MvPolynomial (Fin c) K →+* K := MvPolynomial.eval (fun i => if i = i₀ then 1 else 0)
    have he : e.comp (algebraMap K (MvPolynomial (Fin c) K)) = RingHom.id K := by
      ext r
      simp [e, MvPolynomial.algebraMap_eq]
    have hpt : Spec.map (CommRingCat.ofHom e) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) = 𝟙 _ := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, he]
      simp
    let τP : S ⟶ P := hP.lift (𝟙 S) (fS ≫ Spec.map (CommRingCat.ofHom e))
      (by rw [Category.assoc, hpt, Category.comp_id, Category.id_comp])
    have hτp : τP ≫ p = 𝟙 S := hP.lift_fst _ _ _
    have hτq : τP ≫ q = fS ≫ Spec.map (CommRingCat.ofHom e) := hP.lift_snd _ _ _
    have hrange : Set.range τP ⊆ Set.range U.ι := by
      rw [Scheme.Opens.range_ι, hU]
      rintro _ ⟨s, rfl⟩ ⟨s', hs'⟩
      have e1 : (z0 ≫ p) s' = (τP ≫ p) s := by
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hs']
      rw [hz0p, hτp] at e1
      have h1 : s' = s := by simpa using e1
      subst h1
      have e2 : (z0 ≫ q) s' = (τP ≫ q) s' := by
        rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hs']
      rw [hz0q, hτq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e2
      have e3 : (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff :
            MvPolynomial (Fin c) K →+* K)) (fS s')).asIdeal =
          (Spec.map (CommRingCat.ofHom e) (fS s')).asIdeal := by rw [e2]
      have hm : (MvPolynomial.X i₀ : MvPolynomial (Fin c) K) ∈
          (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff :
            MvPolynomial (Fin c) K →+* K)) (fS s')).asIdeal := by
        show MvPolynomial.constantCoeff (MvPolynomial.X i₀ : MvPolynomial (Fin c) K) ∈ (fS s').asIdeal
        rw [MvPolynomial.constantCoeff_X]
        exact Ideal.zero_mem _
      rw [e3] at hm
      have hm' : e (MvPolynomial.X i₀) ∈ (fS s').asIdeal := hm
      have h1 : e (MvPolynomial.X i₀) = 1 := by simp [e]
      rw [h1] at hm'
      exact (fS s').isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hm')
    refine ⟨IsOpenImmersion.lift U.ι τP hrange, ?_⟩
    rw [← Category.assoc, IsOpenImmersion.lift_fac, hτp]

  have hfib : ∀ (V : Scheme.{u}) (g : V ⟶ S) (A : Type (u+1))
      (h : LocallyConstant ↥(Limits.pullback g (U.ι ≫ p)) A)
      (x y : ↥(Limits.pullback g (U.ι ≫ p))),
      Limits.pullback.fst g (U.ι ≫ p) x = Limits.pullback.fst g (U.ι ≫ p) y → h x = h y := by
    intro V g A h x y hxy
    obtain ⟨v, hv⟩ : ∃ v, Limits.pullback.fst g (U.ι ≫ p) x = v := ⟨_, rfl⟩
    have hx : x ∈ Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst g (U.ι ≫ p))) := by
      rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecResidueField]
      exact hv
    have hy : y ∈ Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst g (U.ι ≫ p))) := by
      rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecResidueField]
      exact hxy.symm.trans hv

    let φ : CommRingCat.of K ⟶ V.residueField v :=
      Spec.preimage ((V.fromSpecResidueField v ≫ g) ≫ fS)
    letI : Algebra K (V.residueField v) := φ.hom.toAlgebra
    have hφ : Spec.map (CommRingCat.ofHom (algebraMap K (V.residueField v))) =
        (V.fromSpecResidueField v ≫ g) ≫ fS := by
      show Spec.map (CommRingCat.ofHom φ.hom) = _
      rw [CommRingCat.ofHom_hom]
      exact Spec.map_preimage _
    haveI : IsDomain (TensorProduct K (V.residueField v) (MvPolynomial (Fin c) K)) :=
      MulEquiv.isDomain (MvPolynomial (Fin c) (V.residueField v))
        (MvPolynomial.algebraTensorAlgEquiv (σ := Fin c) K
          (V.residueField v)).toRingEquiv.toMulEquiv
    let eG : Limits.pullback (V.fromSpecResidueField v ≫ g) p ≅
        Spec (.of (TensorProduct K (V.residueField v) (MvPolynomial (Fin c) K))) :=
      (IsPullback.paste_vert (IsPullback.of_hasPullback (V.fromSpecResidueField v ≫ g) p)
          hP).isoPullback ≪≫
        Limits.pullback.congrHom hφ.symm rfl ≪≫
        pullbackSpecIso K (V.residueField v) (MvPolynomial (Fin c) K)
    haveI : IrreducibleSpace ↥(Limits.pullback (V.fromSpecResidueField v ≫ g) p) :=
      Function.Surjective.irreducibleSpace eG.inv.continuous
        (fun z => ⟨eG.hom z, Scheme.hom_inv_apply eG z⟩)

    haveI : IsOpenImmersion (Limits.pullback.fst
        (Limits.pullback.snd (V.fromSpecResidueField v ≫ g) p) U.ι) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion)
        (IsPullback.of_hasPullback (Limits.pullback.snd (V.fromSpecResidueField v ≫ g) p) U.ι).flip
        inferInstance
    have hpre : IsPreirreducible (Set.univ : Set ↥(Limits.pullback
        (Limits.pullback.snd (V.fromSpecResidueField v ≫ g) p) U.ι)) := by
      have h0 := (IrreducibleSpace.isIrreducible_univ
        ↥(Limits.pullback (V.fromSpecResidueField v ≫ g) p)).isPreirreducible.preimage
        (Scheme.Hom.isOpenEmbedding (Limits.pullback.fst
          (Limits.pullback.snd (V.fromSpecResidueField v ≫ g) p) U.ι))
      rwa [Set.preimage_univ] at h0
    let e : Limits.pullback (Limits.pullback.snd (V.fromSpecResidueField v ≫ g) p) U.ι ≅
        Limits.pullback (V.fromSpecResidueField v) (Limits.pullback.fst g (U.ι ≫ p)) :=
      Limits.pullbackLeftPullbackSndIso (V.fromSpecResidueField v ≫ g) p U.ι ≪≫
        (Limits.pullbackRightPullbackFstIso g (U.ι ≫ p) (V.fromSpecResidueField v)).symm
    have hrange : Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst g (U.ι ≫ p))) =
        (e.hom ≫ Limits.pullback.snd (V.fromSpecResidueField v)
          (Limits.pullback.fst g (U.ι ≫ p))) '' Set.univ := by
      ext z
      constructor
      · rintro ⟨a, rfl⟩
        exact ⟨e.inv a, trivial, by rw [Scheme.Hom.comp_apply, Scheme.inv_hom_apply]⟩
      · rintro ⟨b, _, rfl⟩
        exact ⟨e.hom b, by rw [Scheme.Hom.comp_apply]⟩
    have hirr := hpre.image _ (Scheme.Hom.continuous (e.hom ≫ Limits.pullback.snd
      (V.fromSpecResidueField v) (Limits.pullback.fst g (U.ι ≫ p)))).continuousOn
    rw [← hrange] at hirr
    exact h.isLocallyConstant.apply_eq_of_isPreconnected hirr.isPreconnected hx hy

  have hsec : ∀ (V : S.Etale), ∃ σ : V.left ⟶ Limits.pullback V.hom (U.ι ≫ p),
      σ ≫ Limits.pullback.fst V.hom (U.ι ≫ p) = 𝟙 V.left := by
    intro V
    exact ⟨Limits.pullback.lift (𝟙 V.left) (V.hom ≫ τ)
      (by rw [Category.id_comp, Category.assoc, hτ]; exact (Category.comp_id _).symm),
      Limits.pullback.lift_fst _ _ _⟩
  have hbij : ∀ V : S.Etale, Function.Bijective (LocallyConstant.comapAddMonoidHom
      ⟨Limits.pullback.fst V.hom (U.ι ≫ p), (Limits.pullback.fst V.hom (U.ι ≫ p)).continuous⟩ :
      LocallyConstant V.left (ULift.{u+1} (ZMod ℓ)) →+
        LocallyConstant ↥(Limits.pullback V.hom (U.ι ≫ p)) (ULift.{u+1} (ZMod ℓ))) := by
    intro V
    obtain ⟨σ, hσ⟩ := hsec V
    have hcσ : ∀ v, Limits.pullback.fst V.hom (U.ι ≫ p) (σ v) = v := by
      intro v
      rw [← Scheme.Hom.comp_apply, hσ]
      rfl
    refine ⟨fun a b hab => LocallyConstant.comap_injective _ (fun v => ⟨σ v, hcσ v⟩) hab,
      fun h => ⟨h.comap ⟨σ, σ.continuous⟩, ?_⟩⟩
    apply LocallyConstant.ext
    intro w
    show h (σ (Limits.pullback.fst V.hom (U.ι ≫ p) w)) = h w
    exact hfib V.left V.hom _ h _ _ (hcσ _)
  let Ψ : wcEtLC S (ULift.{u+1} (ZMod ℓ)) ≅ wcLCPb (U.ι ≫ p) (ULift.{u+1} (ZMod ℓ)) :=
    NatIso.ofComponents (fun V => (AddEquiv.ofBijective _ (hbij V.unop)).toAddCommGrpIso) (by
      intro V W g
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro h
      apply LocallyConstant.ext
      intro w
      have key : ((wcEtBaseChange (U.ι ≫ p)).map g.unop).left ≫
          Limits.pullback.fst V.unop.hom (U.ι ≫ p) =
          Limits.pullback.fst W.unop.hom (U.ι ≫ p) ≫ g.unop.left := by
        exact Limits.pullback.lift_fst _ _ _
      let h' : LocallyConstant V.unop.left (ULift.{u+1} (ZMod ℓ)) := h
      have key2 := congrArg (fun k => h' (k w)) key
      exact key2.symm)
  obtain ⟨ea⟩ := wc_et_push_const_lc_iso (U.ι ≫ p) (ULift.{u+1} (ZMod ℓ))
    (wc_et_lc_isSheaf _ _) (wc_et_const_to_lc_locBij _ _)
  obtain ⟨φS, hinjS, hsurjS⟩ := wc_et_const_to_lc_locBij S (ULift.{u+1} (ZMod ℓ))
  have hW : (Scheme.smallEtaleTopology S).W φS :=
    (GrothendieckTopology.W_iff_isLocallyBijective (Scheme.smallEtaleTopology S) φS).mpr
      ⟨hinjS, hsurjS⟩
  have hI : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).map φS) :=
    (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology S) φS).mp hW
  let e1 := @asIso _ _ _ _ ((presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).map φS) hI
  let E3 : (wcEtPush (U.ι ≫ p)).obj ((constantSheaf (Scheme.smallEtaleTopology (U : Scheme.{u}))
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) ≅
      (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) :=
    ea.symm ≪≫ ((presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).mapIso Ψ).symm ≪≫
      e1.symm

  haveI := D.cont
  have s4 : ∀ (L : SheafOfModules.{u+1} (wcEtZModRing S ℓ) ⥤
        SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ))
      (R : SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ) ⥤
        SheafOfModules.{u+1} (wcEtZModRing S ℓ))
      (adj : L ⊣ R) (X : SheafOfModules.{u+1} (wcEtZModRing S ℓ))
      (Z : SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ)) (μ : L.obj X ≅ Z)
      (ψ : R.obj Z ≅ X),
      (∀ a b : X ⟶ X, a ≫ b = b ≫ a) → IsIso (adj.unit.app X ≫ R.map μ.hom) := by
    intro L R adj X Z μ ψ hcomm
    obtain ⟨g, hg⟩ := (adj.homEquiv X Z).surjective ψ.inv
    have h1 : adj.unit.app X ≫ R.map μ.hom ≫ R.map (μ.inv ≫ g) = ψ.inv := by
      rw [← R.map_comp, Iso.hom_inv_id_assoc, ← hg, Adjunction.homEquiv_unit]
    have hts : (adj.unit.app X ≫ R.map μ.hom ≫ ψ.hom) ≫
        (ψ.inv ≫ R.map (μ.inv ≫ g) ≫ ψ.hom) = 𝟙 X := by
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      rw [reassoc_of% h1, Iso.inv_hom_id]
    have hst := (hcomm _ _).symm.trans hts
    haveI : IsIso (adj.unit.app X ≫ R.map μ.hom ≫ ψ.hom) := ⟨⟨_, hts, hst⟩⟩
    have e1 : adj.unit.app X ≫ R.map μ.hom =
        (adj.unit.app X ≫ R.map μ.hom ≫ ψ.hom) ≫ ψ.inv := by
      simp
    rw [e1]
    infer_instance

  have s5 : ∀ (V : (S.Etale)ᵒᵖ) (x y : ↑((wcEtZModRing S ℓ).obj.obj V)), x * y = y * x := by
    obtain ⟨α, _, hsurj, _⟩ := wc_et_zmod_ring_locbij S ℓ
    intro V x y
    have hsep := (wcEtZModRing S ℓ).isSeparated
    apply hsep (Opposite.unop V) _ ((Scheme.smallEtaleTopology S).intersection_covering
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology S) α x)
      (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology S) α y))
    intro W g hg
    obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := hg
    rw [map_mul, map_mul, ← ha, ← hb, ← map_mul, ← map_mul]
    congr 1
    exact @mul_comm (ULift.{u+1} (ZMod ℓ)) _ a b
  have s6 : ∀ (a b : SheafOfModules.unit (wcEtZModRing S ℓ) ⟶ SheafOfModules.unit (wcEtZModRing S ℓ)),
      a ≫ b = b ≫ a := by
    intro a b
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    let fa : ↑((wcEtZModRing S ℓ).obj.obj X) →ₗ[↑((wcEtZModRing S ℓ).obj.obj X)]
        ↑((wcEtZModRing S ℓ).obj.obj X) := (a.val.app X).hom
    let fb : ↑((wcEtZModRing S ℓ).obj.obj X) →ₗ[↑((wcEtZModRing S ℓ).obj.obj X)]
        ↑((wcEtZModRing S ℓ).obj.obj X) := (b.val.app X).hom
    have key : ∀ (g : ↑((wcEtZModRing S ℓ).obj.obj X) →ₗ[↑((wcEtZModRing S ℓ).obj.obj X)]
        ↑((wcEtZModRing S ℓ).obj.obj X)) (y : ↑((wcEtZModRing S ℓ).obj.obj X)),
        g y = y * g 1 := by
      intro g y
      have h2 := g.map_smul y 1
      rw [smul_eq_mul, mul_one] at h2
      rw [h2, smul_eq_mul]
    revert x
    change ∀ x : ↑((wcEtZModRing S ℓ).obj.obj X), fb (fa x) = fa (fb x)
    intro x
    rw [key fb (fa x), key fa x, key fa (fb x), key fb x, mul_assoc, mul_assoc, s5 X (fa 1)]

  obtain ⟨E1⟩ := wc_et_toSheaf_pushforward_iso (U.ι ≫ p) ℓ D
  obtain ⟨E2⟩ := wc_et_zmod_unit_toSheaf_iso (U : Scheme.{u}) ℓ
  obtain ⟨E4⟩ := wc_et_zmod_unit_toSheaf_iso S ℓ
  obtain ⟨α, hinj, hsurj, _⟩ := wc_et_zmod_ring_locbij S ℓ
  haveI : (SheafOfModules.toSheaf (wcEtZModRing S ℓ)).Full :=
    (sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology S) (wcEtZModRing S ℓ) ℓ
      α hinj hsurj).1
  let Θ : (SheafOfModules.toSheaf (wcEtZModRing S ℓ)).obj
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (U.ι ≫ p)) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcEtZModRing (U : Scheme.{u}) ℓ))) ≅
      (SheafOfModules.toSheaf (wcEtZModRing S ℓ)).obj (SheafOfModules.unit (wcEtZModRing S ℓ)) :=
    E1.app (SheafOfModules.unit (wcEtZModRing (U : Scheme.{u}) ℓ)) ≪≫
      (wcEtPush (U.ι ≫ p)).mapIso E2 ≪≫ E3 ≪≫ E4.symm
  let ψ := (SheafOfModules.toSheaf (wcEtZModRing S ℓ)).preimageIso Θ
  exact s4 D.Φ _ D.adj _ _ D.μ ψ s6

theorem wc_et_mod_push_homology_zero_of_locKill : ∀ {Y S : Scheme.{u}} (g : Y ⟶ S) (ℓ : ℕ) (D : wcEtPullData g ℓ) (Kc : CochainComplex (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) ℕ) (q : ℕ), wcEtLocKill g (((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).mapHomologicalComplex (ComplexShape.up ℕ)).obj Kc) q (fun _ => True) → letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; Limits.IsZero ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj Kc).homology (q + 1)) :=
by
  intro Y S g ℓ D Kc q hK
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont
    D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive

  have hcov : ∀ (V : S.Etale) (T : Sieve V), (∀ v : V.left, ∃ (V₁ : S.Etale) (c : V₁ ⟶ V),
      T.arrows c ∧ v ∈ Set.range c.left) → T ∈ Scheme.smallEtaleTopology S V := by
    intro V T hT
    change T ∈ Scheme.smallGrothendieckTopology @Etale S V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hT x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have s1 : ∀ (H : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (V : S.Etale) (z : H.obj (Opposite.op V)),
        Presheaf.equalizerSieve (F := H) (X := Opposite.op V) z 0 ∈ Scheme.smallEtaleTopology S V) →
      Limits.IsZero ((presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj H) := by
    intro H hH
    obtain ⟨Z, hZ⟩ := (Limits.HasZeroObject.zero : ∃ Z : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
      Limits.IsZero Z)
    let f : H ⟶ Z := 0
    have hinj : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology S) f := by
      apply Presheaf.IsLocallyInjective.mk
      intro X x y _
      refine GrothendieckTopology.superset_covering _ ?_ (hH X.unop (x - y))
      intro W g' hg
      rw [Presheaf.equalizerSieve_apply] at hg ⊢
      rw [map_sub, map_zero, sub_eq_zero] at hg
      exact hg
    have hsurj : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S) f := by
      apply Presheaf.IsLocallySurjective.mk
      intro U s
      have htop : Presheaf.imageSieve f s = ⊤ := by
        ext W g'
        simp only [Sieve.top_apply, iff_true]
        rw [Presheaf.imageSieve_apply]
        refine ⟨0, ?_⟩
        have : Subsingleton (ToType (Z.obj (Opposite.op W))) :=
          AddCommGrpCat.isZero_iff_subsingleton.mp (hZ.obj _)
        exact Subsingleton.elim _ _
      rw [htop]
      exact (Scheme.smallEtaleTopology S).top_mem U
    have hW : (Scheme.smallEtaleTopology S).W f :=
      (GrothendieckTopology.W_iff_isLocallyBijective _ f).2 ⟨hinj, hsurj⟩
    haveI := (GrothendieckTopology.W_iff _ f).1 hW
    exact Limits.IsZero.of_iso (Functor.map_isZero _ hZ)
      (asIso ((presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).map f))

  have s2 : ∀ (Sc : ShortComplex ((S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})),
      (∀ (V : S.Etale) (c : Sc.X₂.obj (Opposite.op V)), (Sc.g.app (Opposite.op V)).hom c = 0 →
        ∀ v : V.left, ∃ (W : S.Etale) (g' : W ⟶ V) (w : W.left) (e : Sc.X₁.obj (Opposite.op W)),
          g'.left w = v ∧ (Sc.f.app (Opposite.op W)).hom e = (Sc.X₂.map g'.op).hom c) →
      ∀ (V : S.Etale) (z : Sc.homology.obj (Opposite.op V)),
        Presheaf.equalizerSieve (F := Sc.homology) (X := Opposite.op V) z 0 ∈
          Scheme.smallEtaleTopology S V := by
    intro Sc hSc V z
    have hπ : Epi (Sc.homologyπ.app (Opposite.op V)) :=
      (NatTrans.epi_iff_epi_app _).1 inferInstance _
    obtain ⟨k, rfl⟩ := (AddCommGrpCat.epi_iff_surjective _).1 hπ z
    have hι : ∀ X, Function.Injective (ConcreteCategory.hom (Sc.iCycles.app X)) := fun X =>
      (AddCommGrpCat.mono_iff_injective _).1 ((NatTrans.mono_iff_mono_app _).1 inferInstance X)
    have hc : (Sc.g.app (Opposite.op V)).hom ((Sc.iCycles.app (Opposite.op V)).hom k) = 0 := by
      have := congrArg (fun φ => (φ.app (Opposite.op V)).hom k) Sc.iCycles_g
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply, NatTrans.app_zero, AddCommGrpCat.hom_zero,
        AddMonoidHom.zero_apply] at this
      exact this
    apply hcov
    intro v
    obtain ⟨W, g', w, e, hw, he⟩ := hSc V _ hc v
    refine ⟨W, g', ?_, w, hw⟩
    rw [Presheaf.equalizerSieve_apply, map_zero]
    have h1 : ConcreteCategory.hom (Sc.cycles.map g'.op) k =
        ConcreteCategory.hom (Sc.toCycles.app (Opposite.op W)) e := by
      apply hι
      rw [NatTrans.naturality_apply]
      have n2 := congrArg (fun φ => (φ.app (Opposite.op W)).hom e) Sc.toCycles_i
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply] at n2
      exact (he.symm.trans n2.symm)
    rw [← NatTrans.naturality_apply, h1]
    have n3 := congrArg (fun φ => (φ.app (Opposite.op W)).hom e) Sc.toCycles_comp_homologyπ
    simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
      Function.comp_apply] at n3
    simpa using n3

  rw [← HomologicalComplex.exactAt_iff_isZero_homology,
    HomologicalComplex.exactAt_iff' _ q (q + 1) (q + 2) (CochainComplex.prev_nat_succ q)
      (CochainComplex.next ℕ (q + 1))]
  apply Functor.reflects_exact_of_faithful (SheafOfModules.toSheaf.{u+1} (wcEtZModRing S ℓ))
  rw [ShortComplex.exact_iff_isZero_homology]
  let S1 := ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont
    D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj Kc).sc' q (q + 1) (q + 2)).map
      (SheafOfModules.toSheaf.{u+1} (wcEtZModRing S ℓ))
  let Sp := S1.map (sheafToPresheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
  have hloc : ∀ (V : S.Etale) (c : Sp.X₂.obj (Opposite.op V)), (Sp.g.app (Opposite.op V)).hom c = 0 →
      ∀ v : V.left, ∃ (W : S.Etale) (g' : W ⟶ V) (w : W.left) (e : Sp.X₁.obj (Opposite.op W)),
        g'.left w = v ∧ (Sp.f.app (Opposite.op W)).hom e = (Sp.X₂.map g'.op).hom c :=
    fun V c hc v => hK V c hc v trivial
  have hZ := s1 Sp.homology (s2 Sp hloc)
  have e1 : S1.homology ≅ (Sp.map (presheafToSheaf (Scheme.smallEtaleTopology S)
      AddCommGrpCat.{u+1})).homology :=
    ShortComplex.homologyMapIso
      (ShortComplex.mapNatIso S1 (sheafificationNatIso (Scheme.smallEtaleTopology S)
        AddCommGrpCat.{u+1}))
  exact Limits.IsZero.of_iso hZ
    (e1 ≪≫ Sp.mapHomologyIso (presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}))

theorem wc_et_inj_res_cycle_class_local : ∀ {Y : Scheme.{u}} (ℓ : ℕ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (q : ℕ) (T : Y.Etale) (c : (I.cocomplex.X (q + 1)).val.obj (Opposite.op T)), ((I.cocomplex.d (q + 1) (q + 2)).val.app (Opposite.op T)).hom c = 0 → ∃ α : wcEtZModExt T.left ℓ (q + 1), ∀ (T' : Y.Etale) (h : T' ⟶ T) (Dh : wcEtPullData h.left ℓ), wcEtPull Dh (q + 1) α = 0 → ∃ e : (I.cocomplex.X q).val.obj (Opposite.op T'), ((I.cocomplex.d q (q + 1)).val.app (Opposite.op T')).hom e = ((I.cocomplex.X (q + 1)).val.map h.op).hom c :=
by
  intro Y ℓ I q T c hc
  have s3 : ∀ (Z : Scheme.{u}) (N : SheafOfModules.{u+1} (wcEtZModRing Z ℓ)),
      Function.Bijective (fun φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶ N =>
        (φ.val.app (Opposite.op (wcEtTop Z))).hom
          (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op (wcEtTop Z)))) := by
    intro Z N
    let τ : ∀ X : Z.Etale, X ⟶ wcEtTop Z := fun X =>
      MorphismProperty.Over.homMk (X.hom : X.left ⟶ Z) (Category.comp_id _) trivial
    have huniq : ∀ (X : Z.Etale) (a b : X ⟶ wcEtTop Z), a = b := by
      intro X a b
      apply MorphismProperty.Over.Hom.ext
      have ha : a.left = X.hom := (Category.comp_id _).symm.trans (MorphismProperty.Over.w a)
      have hb : b.left = X.hom := (Category.comp_id _).symm.trans (MorphismProperty.Over.w b)
      rw [ha, hb]
    have hcomp : (fun φ : SheafOfModules.unit (wcEtZModRing Z ℓ) ⟶ N =>
        (φ.val.app (Opposite.op (wcEtTop Z))).hom
          (1 : (wcEtZModRing Z ℓ).obj.obj (Opposite.op (wcEtTop Z)))) =
        (fun s : N.val.sections => s.1 (Opposite.op (wcEtTop Z))) ∘
          (SheafOfModules.unitHomEquiv N) := by
      funext φ
      simp only [Function.comp_apply, SheafOfModules.unitHomEquiv_apply_coe]
    rw [hcomp]
    refine Function.Bijective.comp ?_ (SheafOfModules.unitHomEquiv N).bijective
    constructor
    · intro s s' hst
      apply PresheafOfModules.sections_ext
      intro X
      rw [← PresheafOfModules.sections_property s (τ X.unop).op,
        ← PresheafOfModules.sections_property s' (τ X.unop).op]
      simp only at hst
      rw [hst]
    · intro x
      refine ⟨PresheafOfModules.sectionsMk (fun X => (N.val.map (τ X.unop).op).hom x) ?_, ?_⟩
      · intro X X' g
        rw [← PresheafOfModules.map_comp_apply]
        have : (τ X.unop).op ≫ g = (τ X'.unop).op := by
          apply Quiver.Hom.unop_inj
          exact huniq _ _ _
        rw [this]
      · show (N.val.map (τ (wcEtTop Z)).op).hom x = x
        rw [show τ (wcEtTop Z) = 𝟙 (wcEtTop Z) from huniq _ _ _]
        first | (simp; done) | (simp; rfl) | rfl
  have s4 : ∀ {Y₁ Z₁ : Scheme.{u}}
      (Φ : SheafOfModules.{u+1} (wcEtZModRing Y₁ ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z₁ ℓ))
      (V : Z₁.Etale) (W : Y₁.Etale)
      (κ : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y₁ ℓ),
        (Φ.obj M).val.obj (Opposite.op V) ≃ M.val.obj (Opposite.op W)),
      (∀ (M M' : SheafOfModules.{u+1} (wcEtZModRing Y₁ ℓ)) (f : M ⟶ M')
        (x : (Φ.obj M).val.obj (Opposite.op V)),
        κ M' (((Φ.map f).val.app (Opposite.op V)).hom x) =
          (f.val.app (Opposite.op W)).hom (κ M x)) →
      ∀ (P : SheafOfModules.{u+1} (wcEtZModRing Z₁ ℓ)) (eP : P.val.obj (Opposite.op V)),
      (∀ N : SheafOfModules.{u+1} (wcEtZModRing Z₁ ℓ),
        Function.Bijective (fun φ : P ⟶ N => (φ.val.app (Opposite.op V)).hom eP)) →
      ∀ (Q : SheafOfModules.{u+1} (wcEtZModRing Y₁ ℓ)) (eQ : Q.val.obj (Opposite.op W)),
      (∀ M : SheafOfModules.{u+1} (wcEtZModRing Y₁ ℓ),
        Function.Bijective (fun φ : Q ⟶ M => (φ.val.app (Opposite.op W)).hom eQ)) →
      ∃ ρ : P ⟶ Φ.obj Q, κ Q ((ρ.val.app (Opposite.op V)).hom eP) = eQ ∧
        ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y₁ ℓ),
          Function.Bijective (fun f : Q ⟶ M => ρ ≫ Φ.map f) := by
    intro Y₁ Z₁ Φ V W κ hκ P eP hP Q eQ hQ
    obtain ⟨ρ, hρ⟩ := (hP (Φ.obj Q)).2 ((κ Q).symm eQ)
    have hρ' : κ Q ((ρ.val.app (Opposite.op V)).hom eP) = eQ := by
      simp only at hρ
      rw [hρ, Equiv.apply_symm_apply]
    refine ⟨ρ, hρ', fun M => ?_⟩
    have hc : ((κ M) ∘ (fun φ : P ⟶ Φ.obj M => (φ.val.app (Opposite.op V)).hom eP)) ∘
        (fun f : Q ⟶ M => ρ ≫ Φ.map f) = (fun φ : Q ⟶ M => (φ.val.app (Opposite.op W)).hom eQ) := by
      funext f
      simp only [Function.comp_apply, SheafOfModules.comp_val, PresheafOfModules.comp_app,
        ModuleCat.hom_comp, LinearMap.comp_apply]
      rw [hκ, hρ']
    have hb : Function.Bijective
        ((κ M) ∘ (fun φ : P ⟶ Φ.obj M => (φ.val.app (Opposite.op V)).hom eP)) :=
      (κ M).bijective.comp (hP _)
    rw [← Function.Bijective.of_comp_iff' hb, hc]
    exact hQ M
  have s6 : ∀ {S : Scheme.{u}} (T₀ : S.Etale) (E : wcEtPullData (S := S) (S' := T₀.left) T₀.hom ℓ),
      ∃ κ : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing S ℓ)) (V : T₀.left.Etale),
        (E.Φ.obj M).val.obj (Opposite.op V) ≃ M.val.obj (Opposite.op ((wcEtSlice T₀).obj V)),
      (∀ (M M' : SheafOfModules.{u+1} (wcEtZModRing S ℓ)) (f : M ⟶ M') (V : T₀.left.Etale)
        (x : (E.Φ.obj M).val.obj (Opposite.op V)),
        κ M' V (((E.Φ.map f).val.app (Opposite.op V)).hom x) =
          (f.val.app (Opposite.op ((wcEtSlice T₀).obj V))).hom (κ M V x)) ∧
      (∀ (M : SheafOfModules.{u+1} (wcEtZModRing S ℓ)) (V₁ V₂ : T₀.left.Etale) (k : V₁ ⟶ V₂)
        (x : (E.Φ.obj M).val.obj (Opposite.op V₂)),
        κ M V₁ (((E.Φ.obj M).val.map k.op).hom x) =
          (M.val.map ((wcEtSlice T₀).map k).op).hom (κ M V₂ x)) := by
    intro S T₀ E
