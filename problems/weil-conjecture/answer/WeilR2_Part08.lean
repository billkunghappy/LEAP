  have hq₂a : q₂ ≫ a₂ = wcEtGeomPt (wcHalA1 (b ≫ s)) (ã (IsLocalRing.closedPoint B)) :=
    hnorm_a (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ hd₂ q₂ hq₂φ
  have hsep : IsSepClosed ((wcHalA1 (b ≫ s)).residueField (ã (IsLocalRing.closedPoint B))) :=
    wc_hal_a1_closed_point_residue_sepclosed K A' (b ≫ s) (ã (IsLocalRing.closedPoint B)) hclosed hg'x
  obtain ⟨δ, hδa, hδφ⟩ := wc_shdata_lift_from_strictly_local (ã (IsLocalRing.closedPoint B)) hsep
