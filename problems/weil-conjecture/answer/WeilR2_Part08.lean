    sheafToPresheaf (Scheme.smallEtaleTopology (Spec (.of B))) AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft ((Spec (.of A)).Etale)ᵒᵖ ((Spec (.of B)).Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (@Functor.op (Spec (.of A)).Etale _ (Spec (.of B)).Etale _ (wcEtBaseChange z))
  let P := presheafToSheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}
  obtain ⟨hS⟩ := s3 (Spec (.of A)) (F ⋙ W) (W.mapCocone (Limits.colimit.cocone F))
    (fun V hV => s2 ((wcEtBaseChange z).obj V) (s4 V hV))
  have h1 : Limits.IsColimit ((W ⋙ P).mapCocone (Limits.colimit.cocone F)) :=
    hS.ofIsoColimit (Functor.mapCoconeMapCocone _)
  have h2 : Limits.IsColimit ((W ⋙ P).mapCocone (Γc.mapCocone c)) :=
    h1.ofIsoColimit ((Limits.Cocones.functoriality F (W ⋙ P)).mapIso
      ((Limits.colimit.isColimit F).uniqueUpToIso hG))
  have h3 : Limits.IsColimit ((Γc ⋙ (W ⋙ P)).mapCocone c) :=
    h2.ofIsoColimit (Functor.mapCoconeMapCocone _)
  exact ⟨h3⟩

theorem wc_hal_acyc_colim : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] (s : Spec (.of A) ⟶ Spec (.of K)) (L : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush (wcHalA1Proj s)) → Limits.PreservesFiniteLimits L → ∀ (e : L.obj (wcZSh (Spec (.of A))) ≅ wcZSh (wcHalA1 s)) (n : ℕ), (∀ (J : Type (u+1)) [SmallCategory J] [IsFiltered J] (D : J ⥤ Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) (c : Limits.Cocone D), Limits.IsColimit c → (∀ j, wcHalAcyc L e (D.obj j) n) → wcHalAcyc L e c.pt n) ∧ (∀ (F G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}), (F ≅ G) → wcHalAcyc L e F n → wcHalAcyc L e G n) ∧ (∀ (k : ℕ) (F : Fin k → Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}), (∀ i, wcHalAcyc L e (F i) n) → wcHalAcyc L e (⨁ F) n) :=
by
  intro K _ A _ s L hadj hL e n
  obtain ⟨adj⟩ := hadj
  haveI : L.Additive := adj.left_adjoint_additive

  have AFF : ∀ (T : Scheme.{u}) [IsAffine T] (Λ : Type (u+1)) [SmallCategory Λ] [IsFiltered Λ]
      (G : Λ ⥤ Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (c : Limits.Cocone G),
      Limits.IsColimit c →
      (∀ x : wcZSh T ⟶ c.pt, ∃ (i : Λ) (y : wcZSh T ⟶ G.obj i), y ≫ c.ι.app i = x) ∧
      (∀ (i : Λ) (y : wcZSh T ⟶ G.obj i), y ≫ c.ι.app i = 0 →
        ∃ (j : Λ) (f : i ⟶ j), y ≫ G.map f = 0) ∧
      (letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
       ∀ (p : ℕ) (x : Abelian.Ext (wcZSh T) c.pt p),
        ∃ (i : Λ) (y : Abelian.Ext (wcZSh T) (G.obj i) p),
          y.comp (Abelian.Ext.mk₀ (c.ι.app i)) (add_zero p) = x) := by
    intro T _ Λ _ _ G c hc
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
    haveI : EssentiallySmall.{u+1} T.Etale := inferInstance
    haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
      Sheaf.isGrothendieckAbelian_of_essentiallySmall (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}
    have cc : ∀ {A B C' : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}} {p : ℕ}
        (v : Abelian.Ext (wcZSh T) A p) (f : A ⟶ B) (g : B ⟶ C'),
        (v.comp (Abelian.Ext.mk₀ f) (add_zero p)).comp (Abelian.Ext.mk₀ g) (add_zero p) =
          v.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero p) := by
      intro A B C' p v f g
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀]
    have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 T)) :=
      Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
        (fun V m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
    have hTaff : IsAffine (Scheme.Etale.mk (𝟙 T)).left := by
      change IsAffine T
      infer_instance
    have mk0inj : ∀ {F₁ F₂ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}}
        (a b : F₁ ⟶ F₂), Abelian.Ext.mk₀ a = Abelian.Ext.mk₀ b → a = b := by
      intro F₁ F₂ a b h
      apply Abelian.Ext.homEquiv₀.symm.injective
      rw [Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.homEquiv₀_symm_apply]
      exact h
    have nat : ∀ {F₁ F₂ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}}
        (f : F₁ ⟶ F₂) (y : wcZSh T ⟶ F₁),
        (f.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 T)))).hom
          ((Sheaf.H.equiv₀ F₁ hT) (Abelian.Ext.mk₀ y)) =
          (Sheaf.H.equiv₀ F₂ hT) (Abelian.Ext.mk₀ (y ≫ f)) := by
      intro F₁ F₂ f y
      rw [Sheaf.H.equiv₀_naturality hT f, Sheaf.H.map_apply, Abelian.Ext.mk₀_comp_mk₀]
    have Φsurj : ∀ (F₁ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
        (t : F₁.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 T)))),
        ∃ y : wcZSh T ⟶ F₁, (Sheaf.H.equiv₀ F₁ hT) (Abelian.Ext.mk₀ y) = t := by
      intro F₁ t
      refine ⟨Abelian.Ext.homEquiv₀ ((Sheaf.H.equiv₀ F₁ hT).symm t), ?_⟩
      rw [Abelian.Ext.mk₀_homEquiv₀_apply, AddEquiv.apply_symm_apply]
    have Φinj : ∀ {F₁ : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}}
        (a b : wcZSh T ⟶ F₁),
        (Sheaf.H.equiv₀ F₁ hT) (Abelian.Ext.mk₀ a) = (Sheaf.H.equiv₀ F₁ hT) (Abelian.Ext.mk₀ b) →
        a = b := fun a b h => mk0inj a b ((Sheaf.H.equiv₀ _ hT).injective h)
    obtain ⟨hA, hB⟩ := wc_et_sheaf_colimit_cocone_local T Λ G
    obtain ⟨hsurj, hinj⟩ := wc_et_affine_sections_local_cocone T Λ G (Limits.colimit G)
      (Limits.colimit.ι G) (fun i j f => Limits.colimit.w G f) hA hB (Scheme.Etale.mk (𝟙 T)) hTaff
    let E : Limits.colimit G ≅ c.pt := (Limits.colimit.isColimit G).coconePointUniqueUpToIso hc
    have hE : ∀ i, Limits.colimit.ι G i ≫ E.hom = c.ι.app i := fun i =>
      (Limits.colimit.isColimit G).comp_coconePointUniqueUpToIso_hom hc i
    have hE' : ∀ i, c.ι.app i ≫ E.inv = Limits.colimit.ι G i := fun i => by
      rw [← hE i, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    refine ⟨?_, ?_, ?_⟩
    · intro x
      obtain ⟨i, t, ht⟩ := hsurj ((Sheaf.H.equiv₀ (Limits.colimit G) hT) (Abelian.Ext.mk₀ (x ≫ E.inv)))
      obtain ⟨y, rfl⟩ := Φsurj (G.obj i) t
      refine ⟨i, y, ?_⟩
      rw [nat] at ht
      have h1 : y ≫ Limits.colimit.ι G i = x ≫ E.inv := Φinj _ _ ht
      rw [← hE i, ← Category.assoc, h1, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    · intro i y hy
      have h1 : y ≫ Limits.colimit.ι G i = 0 := by
        rw [← hE' i, ← Category.assoc, hy, Limits.zero_comp]
      have h0 : ((Limits.colimit.ι G i).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 T)))).hom
          ((Sheaf.H.equiv₀ (G.obj i) hT) (Abelian.Ext.mk₀ y)) = 0 := by
        rw [nat, h1, Abelian.Ext.mk₀_zero, map_zero]
      obtain ⟨j, f, hf⟩ := hinj i _ h0
      rw [nat] at hf
      refine ⟨j, f, Φinj _ _ ?_⟩
      rw [hf, Abelian.Ext.mk₀_zero, map_zero]
    · have H0 : ∀ (G' : Λ ⥤ Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
          (x : Abelian.Ext (wcZSh T) (Limits.colimit G') 0),
          ∃ (i : Λ) (y : Abelian.Ext (wcZSh T) (G'.obj i) 0),
            y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G' i)) (add_zero 0) = x := by
        intro G' x
        obtain ⟨hA', hB'⟩ := wc_et_sheaf_colimit_cocone_local T Λ G'
        obtain ⟨hsurj', -⟩ := wc_et_affine_sections_local_cocone T Λ G' (Limits.colimit G')
          (Limits.colimit.ι G') (fun i j f => Limits.colimit.w G' f) hA' hB'
          (Scheme.Etale.mk (𝟙 T)) hTaff
        obtain ⟨i, t, ht⟩ := hsurj' ((Sheaf.H.equiv₀ (Limits.colimit G') hT) x)
        refine ⟨i, (Sheaf.H.equiv₀ (G'.obj i) hT).symm t,
          (Sheaf.H.equiv₀ (Limits.colimit G') hT).injective ?_⟩
        have h := Sheaf.H.equiv₀_naturality hT (Limits.colimit.ι G' i)
          ((Sheaf.H.equiv₀ (G'.obj i) hT).symm t)
        rw [AddEquiv.apply_symm_apply, Sheaf.H.map_apply] at h
        rw [← h, ht]
      have Hemb : ∀ G' : Λ ⥤ Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1},
          ∃ (I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (α : G' ⟶ I), Mono α ∧
            ∀ (q : ℕ) (e : Abelian.Ext (wcZSh T) (Limits.colimit I) (q + 1)), e = 0 := by
        intro G'
        obtain ⟨I, α, hα, hinjI⟩ := wc_et_functorial_injective_embedding T Λ G'
        obtain ⟨hA', hB'⟩ := wc_et_sheaf_colimit_cocone_local T Λ I
        exact ⟨I, α, hα, wc_et_affine_colim_injective_acyclic T Λ I hinjI (fun U hU =>
          wc_et_affine_sections_local_cocone T Λ I (Limits.colimit I) (Limits.colimit.ι I)
            (fun i j f => Limits.colimit.w I f) hA' hB' U hU)⟩
      have Blift : ∀ (G' : Λ ⥤ Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (p : ℕ)
          (z : Abelian.Ext (wcZSh T) (Limits.colimit G') p),
          ∃ (i : Λ) (y : Abelian.Ext (wcZSh T) (G'.obj i) p),
            y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G' i)) (add_zero p) = z :=
        wc_ext_filtered_colim_lift _ Λ H0 Hemb
      intro p x
      obtain ⟨i, y, hy⟩ := Blift G p (x.comp (Abelian.Ext.mk₀ E.inv) (add_zero p))
      refine ⟨i, y, ?_⟩
      calc y.comp (Abelian.Ext.mk₀ (c.ι.app i)) (add_zero p)
          = y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G i ≫ E.hom)) (add_zero p) := by rw [hE]
        _ = (y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G i)) (add_zero p)).comp
              (Abelian.Ext.mk₀ E.hom) (add_zero p) := (cc _ _ _).symm
        _ = (x.comp (Abelian.Ext.mk₀ E.inv) (add_zero p)).comp
              (Abelian.Ext.mk₀ E.hom) (add_zero p) := by rw [hy]
        _ = x := by rw [cc, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  have toExt : ∀ (G : Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}) (p : ℕ),
      Subsingleton (wcEtExt (wcHalA1 s) G p) ↔
        Subsingleton (Abelian.Ext (wcZSh (wcHalA1 s)) G p) := fun _ _ => Iff.rfl
  have ccX : ∀ {A B C' : Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}} {p : ℕ}
      (v : Abelian.Ext (wcZSh (wcHalA1 s)) A p) (f : A ⟶ B) (g : B ⟶ C'),
      (v.comp (Abelian.Ext.mk₀ f) (add_zero p)).comp (Abelian.Ext.mk₀ g) (add_zero p) =
        v.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero p) := by
    intro A B C' p v f g
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]

  have hIso : ∀ (F G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}),
      (F ≅ G) → wcHalAcyc L e F n → wcHalAcyc L e G n := by
    intro F G i h
    refine ⟨fun ψ => ?_, fun p h1 h2 => ?_⟩
    · obtain ⟨φ', hφ', huniq⟩ := h.1 (ψ ≫ L.map i.inv)
      have hφ'' : e.inv ≫ L.map φ' = ψ ≫ L.map i.inv := hφ'
      refine ⟨φ' ≫ i.hom, ?_, fun φ₁ hφ₁ => ?_⟩
      · show e.inv ≫ L.map (φ' ≫ i.hom) = ψ
        rw [L.map_comp, ← Category.assoc, hφ'', Category.assoc, ← L.map_comp, Iso.inv_hom_id,
          L.map_id, Category.comp_id]
      · have hφ₁' : e.inv ≫ L.map φ₁ = ψ := hφ₁
        have : φ₁ ≫ i.inv = φ' := huniq _ (by
          show e.inv ≫ L.map (φ₁ ≫ i.inv) = ψ ≫ L.map i.inv
          rw [L.map_comp, ← Category.assoc, hφ₁'])
        rw [← this, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    · haveI := (toExt _ p).1 (h.2 p h1 h2)
      apply (toExt _ p).2
      have hinj : Function.Injective (fun x : Abelian.Ext (wcZSh (wcHalA1 s)) (L.obj G) p =>
          x.comp (Abelian.Ext.mk₀ (L.map i.inv)) (add_zero p)) := by
        intro a b hab
        have hab' := congrArg (fun z => z.comp (Abelian.Ext.mk₀ (L.map i.hom)) (add_zero p)) hab
        simp only [ccX, ← L.map_comp, Iso.inv_hom_id, L.map_id, Abelian.Ext.comp_mk₀_id] at hab'
        exact hab'
      exact hinj.subsingleton

  have hBip : ∀ (k : ℕ) (F : Fin k → Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}),
      (∀ i, wcHalAcyc L e (F i) n) → wcHalAcyc L e (⨁ F) n := by
    intro k F hF
    refine ⟨fun ψ => ?_, fun p h1 h2 => ?_⟩
    · have hex : ∀ j, ∃ φj : wcZSh (Spec (.of A)) ⟶ F j,
          e.inv ≫ L.map φj = ψ ≫ L.map (Limits.biproduct.π F j) :=
        fun j => ((hF j).1 _).exists
      choose φj hφj using hex
      refine ⟨Limits.biproduct.lift φj, ?_, fun φ' hφ' => ?_⟩
      · show e.inv ≫ L.map (Limits.biproduct.lift φj) = ψ
        rw [Limits.biproduct.lift_eq, L.map_sum, Preadditive.comp_sum]
        conv_rhs => rw [← Category.comp_id ψ, ← L.map_id, ← Limits.biproduct.total, L.map_sum,
          Preadditive.comp_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [L.map_comp, L.map_comp, ← Category.assoc, hφj, Category.assoc]
      · have hφ'' : e.inv ≫ L.map φ' = ψ := hφ'
        apply Limits.biproduct.hom_ext
        intro j
        rw [Limits.biproduct.lift_π]
        apply ((hF j).1 (ψ ≫ L.map (Limits.biproduct.π F j))).unique
        · show e.inv ≫ L.map (φ' ≫ Limits.biproduct.π F j) = ψ ≫ L.map (Limits.biproduct.π F j)
          rw [L.map_comp, ← Category.assoc, hφ'']
        · exact hφj j
    · apply (toExt _ p).2
      have hz : ∀ x : Abelian.Ext (wcZSh (wcHalA1 s)) (L.obj (⨁ F)) p, x = 0 := by
        intro x
        have hj : ∀ j, x.comp (Abelian.Ext.mk₀ (L.map (Limits.biproduct.π F j))) (add_zero p) = 0 := by
          intro j
          haveI := (toExt _ p).1 ((hF j).2 p h1 h2)
          exact Subsingleton.elim _ _
        calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id x).symm
          _ = x.comp (Abelian.Ext.mk₀ (L.map (∑ j, Limits.biproduct.π F j ≫
                Limits.biproduct.ι F j))) (add_zero p) := by rw [Limits.biproduct.total, L.map_id]
          _ = ∑ j, (x.comp (Abelian.Ext.mk₀ (L.map (Limits.biproduct.π F j))) (add_zero p)).comp
                (Abelian.Ext.mk₀ (L.map (Limits.biproduct.ι F j))) (add_zero p) := by
              rw [L.map_sum, Abelian.Ext.mk₀_sum, Abelian.Ext.comp_sum]
              refine Finset.sum_congr rfl (fun j _ => ?_)
              rw [ccX, L.map_comp]
          _ = 0 := by simp only [hj, Abelian.Ext.zero_comp, Finset.sum_const_zero]
      exact ⟨fun a b => by rw [hz a, hz b]⟩

  have hCol : ∀ (J : Type (u+1)) [SmallCategory J] [IsFiltered J]
      (D : J ⥤ Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})
      (c : Limits.Cocone D), Limits.IsColimit c → (∀ j, wcHalAcyc L e (D.obj j) n) →
      wcHalAcyc L e c.pt n := by
    intro J _ _ D c hc hD
    haveI : Limits.PreservesColimitsOfSize.{u+1, u+1} L := adj.leftAdjoint_preservesColimits
    have hc' : Limits.IsColimit (L.mapCocone c) := Limits.isColimitOfPreserves L hc
    obtain ⟨hXa, hXb, hXc⟩ := AFF (wcHalA1 s) J (D ⋙ L) (L.mapCocone c) hc'
    obtain ⟨hYa, -, -⟩ := AFF (Spec (.of A)) J D c hc
    refine ⟨fun ψ => ?_, fun p h1 h2 => ?_⟩
    · obtain ⟨i, y, hy⟩ := hXa ψ
      obtain ⟨φi, hφi, -⟩ := (hD i).1 y
      have hφi' : e.inv ≫ L.map φi = y := hφi
      let φ₀ : wcZSh (Spec (.of A)) ⟶ c.pt := φi ≫ c.ι.app i
      have hφ₂ : e.inv ≫ L.map φ₀ = ψ := by
        show e.inv ≫ L.map (φi ≫ c.ι.app i) = ψ
        rw [L.map_comp, ← Category.assoc, hφi']
        exact hy
      refine ⟨φ₀, hφ₂, fun φ₁ hφ₁ => ?_⟩
      have hφ₁' : e.inv ≫ L.map φ₁ = ψ := hφ₁
      rw [← sub_eq_zero]
      have hLδ : e.inv ≫ L.map (φ₁ - φ₀) = 0 := by
        rw [L.map_sub, Preadditive.comp_sub, hφ₁', hφ₂, sub_self]
      obtain ⟨i', χ, hχ⟩ := hYa (φ₁ - φ₀)
      have h0 : (e.inv ≫ L.map χ) ≫ (L.mapCocone c).ι.app i' = 0 := by
        rw [Functor.mapCocone_ι_app, Category.assoc, ← L.map_comp, hχ, hLδ]
      obtain ⟨j, f, hf⟩ := hXb i' (e.inv ≫ L.map χ) h0
      have hf' : e.inv ≫ L.map (χ ≫ D.map f) = e.inv ≫ L.map 0 := by
        rw [L.map_comp, ← Category.assoc, L.map_zero, Limits.comp_zero]
        exact hf
      have hz : χ ≫ D.map f = 0 := ((hD j).1 (e.inv ≫ L.map 0)).unique hf' rfl
      rw [← hχ, ← c.w f, ← Category.assoc, hz, Limits.zero_comp]
    · apply (toExt _ p).2
      have hz : ∀ x : Abelian.Ext (wcZSh (wcHalA1 s)) (L.obj c.pt) p, x = 0 := by
        intro x
        obtain ⟨i, y, hy⟩ := hXc p x
        have hy0 : y = 0 := @Subsingleton.elim _ ((toExt _ p).1 ((hD i).2 p h1 h2)) y 0
        rw [← hy, hy0, Abelian.Ext.zero_comp]
      exact ⟨fun a b => by rw [hz a, hz b]⟩
  exact ⟨hCol, hIso, hBip⟩

theorem wc_hal_geom_push_good_const : ∀ (K : Type u) [Field K] (ℓ : ℕ), ℓ.Prime → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (L : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush (wcHalA1Proj s)) → Limits.PreservesFiniteLimits L → ∀ (e : L.obj (wcZSh (Spec (.of A))) ≅ wcZSh (wcHalA1 s)) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), (∀ n, wcHalAcyc L e ((wcEtPush z).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of Ω))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) n) → ∀ (M : AddCommGrpCat.{u+1}), (∀ m : M, ℓ • m = 0) → ∀ n, wcHalAcyc L e ((wcEtPush z).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of Ω))) AddCommGrpCat.{u+1}).obj M)) n :=
by
  classical
  intro K _ ℓ hℓ A _ _ _ s L hadj hL e Ω _ _ z hΛ M hM n
  let Φ : AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} :=
    constantSheaf (Scheme.smallEtaleTopology (Spec (.of Ω))) AddCommGrpCat.{u+1} ⋙ wcEtPush z
  let Λ : AddCommGrpCat.{u+1} := AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))
  obtain ⟨hcol, hiso, hbip⟩ := wc_hal_acyc_colim K A s L hadj hL e n

  have hs2 : ∀ (S : Set M), S.Finite → ∃ k : ℕ, Nonempty (AddCommGrpCat.of (AddSubgroup.closure S) ≅
      ⨁ (fun _ : Fin k => Λ)) := by
    intro S hS
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    let H := AddSubgroup.closure S
    letI : Module (ZMod ℓ) H := AddCommGroup.zmodModule (fun x : H => Subtype.ext (hM x.1))
    haveI : AddGroup.FG H := by
      rw [AddGroup.fg_iff_addSubgroup_fg]
      exact ⟨hS.toFinset, by rw [hS.coe_toFinset]⟩
    haveI : Finite H := AddCommGroup.finite_of_fg_torsion H (fun x : H =>
      isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨ℓ, hℓ.pos, Subtype.ext (hM x.1)⟩)
    haveI hfin : Module.Finite (ZMod ℓ) H := Module.Finite.of_finite
    haveI hfree : Module.Free (ZMod ℓ) H := Module.Free.of_divisionRing _ _
    let b : Module.Basis (Fin (Module.finrank (ZMod ℓ) H)) (ZMod ℓ) H :=
      @Module.finBasis (ZMod ℓ) H _ _ _ hfree _ hfin
    let e1 : H ≃+ (Fin (Module.finrank (ZMod ℓ) H) → ULift.{u+1} (ZMod ℓ)) :=
      b.equivFun.toAddEquiv.trans (AddEquiv.piCongrRight (fun _ => AddEquiv.ulift.symm))
    exact ⟨_, ⟨e1.toAddCommGrpIso ≪≫
      (AddCommGrpCat.biproductIsoPi (fun _ : Fin (Module.finrank (ZMod ℓ) H) => Λ)).symm⟩⟩

  let D : Finset M ⥤ AddCommGrpCat.{u+1} :=
    { obj := fun S => AddCommGrpCat.of (AddSubgroup.closure (S : Set M))
      map := fun {S T} f => AddCommGrpCat.ofHom (AddSubgroup.inclusion
        (AddSubgroup.closure_mono (Finset.coe_subset.mpr (leOfHom f))))
      map_id := fun S => by ext; rfl
      map_comp := fun f g => by ext; rfl }
  let c : Limits.Cocone D :=
    { pt := M
      ι := { app := fun S => AddCommGrpCat.ofHom (AddSubgroup.closure (S : Set M)).subtype
             naturality := fun S T f => by ext; rfl } }
  have hc : Limits.IsColimit c := by
    haveI : Limits.ReflectsColimitsOfShape (Finset M) (forget AddCommGrpCat.{u+1}) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    refine Limits.isColimitOfReflects (forget AddCommGrpCat.{u+1}) ?_
    refine Limits.Types.FilteredColimit.isColimitOf _ _ ?_ ?_
    · intro x
      exact ⟨{x}, ⟨x, AddSubgroup.subset_closure (by simp)⟩, rfl⟩
    · intro i j xi xj h
      refine ⟨i ∪ j, homOfLE Finset.subset_union_left, homOfLE Finset.subset_union_right, ?_⟩
      apply Subtype.ext
      exact h

  have hstage : ∀ S : Finset M, wcHalAcyc L e ((D ⋙ Φ).obj S) n := by
    intro S
    obtain ⟨k, ⟨eB⟩⟩ := hs2 (S : Set M) S.finite_toSet
    have hB : wcHalAcyc L e (⨁ (fun _ : Fin k => Φ.obj Λ)) n := hbip k _ (fun _ => hΛ n)
    exact hiso _ _ (Φ.mapIso eB ≪≫ Φ.mapBiproduct (fun _ : Fin k => Λ)).symm hB

  obtain ⟨hΦc⟩ := wc_et_const_push_preserves_filtered_colim A Ω z (Finset M) D c hc
  exact hcol (Finset M) (D ⋙ Φ) (Φ.mapCocone c) hΦc hstage

theorem wc_hal_a1_closed_square : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] (s : Spec (.of A) ⟶ Spec (.of K)) (A' : Type u) [CommRing A'] (φ : A →+* A'), Function.Surjective φ → ∃ i' : wcHalA1 (Spec.map (CommRingCat.ofHom φ) ≫ s) ⟶ wcHalA1 s, IsPullback i' (wcHalA1Proj (Spec.map (CommRingCat.ofHom φ) ≫ s)) (wcHalA1Proj s) (Spec.map (CommRingCat.ofHom φ)) ∧ IsClosedImmersion i' ∧ Set.range i' = (wcHalA1Proj s) ⁻¹' Set.range (Spec.map (CommRingCat.ofHom φ)) :=
by
  intro K _ A _ s A' _ φ hφ
  have w : (Limits.pullback.fst (Spec.map (CommRingCat.ofHom φ) ≫ s)
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫
        Spec.map (CommRingCat.ofHom φ)) ≫ s =
      Limits.pullback.snd (Spec.map (CommRingCat.ofHom φ) ≫ s)
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) := by
    rw [Category.assoc]
    exact Limits.pullback.condition
  let i' : wcHalA1 (Spec.map (CommRingCat.ofHom φ) ≫ s) ⟶ wcHalA1 s :=
    Limits.pullback.lift _ _ w
  have hF : i' ≫ wcHalA1Proj s =
      wcHalA1Proj (Spec.map (CommRingCat.ofHom φ) ≫ s) ≫ Spec.map (CommRingCat.ofHom φ) :=
    Limits.pullback.lift_fst _ _ w
  have hS : i' ≫ Limits.pullback.snd s (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
      Limits.pullback.snd (Spec.map (CommRingCat.ofHom φ) ≫ s)
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
    Limits.pullback.lift_snd _ _ w
  have hout : IsPullback
      (i' ≫ Limits.pullback.snd s (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
      (wcHalA1Proj (Spec.map (CommRingCat.ofHom φ) ≫ s))
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))
      (Spec.map (CommRingCat.ofHom φ) ≫ s) := by
    rw [hS]
    exact (IsPullback.of_hasPullback _ _).flip
  have hsq : IsPullback i' (wcHalA1Proj (Spec.map (CommRingCat.ofHom φ) ≫ s)) (wcHalA1Proj s)
      (Spec.map (CommRingCat.ofHom φ)) :=
    IsPullback.of_right hout hF (IsPullback.of_hasPullback _ _).flip
  haveI hiC : IsClosedImmersion (Spec.map (CommRingCat.ofHom φ)) :=
    IsClosedImmersion.spec_of_surjective _ hφ
  refine ⟨i', hsq, MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip hiC, ?_⟩
  have hfac : hsq.isoPullback.hom ≫
      Limits.pullback.fst (wcHalA1Proj s) (Spec.map (CommRingCat.ofHom φ)) = i' :=
    hsq.isoPullback_hom_fst
  rw [← Scheme.Pullback.range_fst, ← hfac]
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨hsq.isoPullback.hom y, by rw [Scheme.Hom.comp_apply]⟩
  · rintro ⟨z, rfl⟩
    refine ⟨hsq.isoPullback.inv z, ?_⟩
    rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply hsq.isoPullback.inv hsq.isoPullback.hom,
      Iso.inv_hom_id]
    rfl

theorem wc_et_sheaf_isZero_of_isEmpty : ∀ (W : Scheme.{u}), IsEmpty ↥W → ∀ (H : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1}), Limits.IsZero H :=
by
  intro W hW H
  have hT : ∀ U : W.Etale, Limits.IsTerminal (H.obj.obj (Opposite.op U)) := by
    intro U
    haveI : IsEmpty ↥U.left := ⟨fun x => isEmptyElim (show W from U.hom.base x)⟩
    apply Sheaf.isTerminalOfBotCover
    letI := Scheme.isJointlySurjectivePreserving (@Etale)
    let 𝒰 : Scheme.Cover (Scheme.precoverage @Etale) U.left :=
      Scheme.Cover.mkOfCovers (P := @Etale) PEmpty (fun i => PEmpty.elim i)
        (fun i => PEmpty.elim i) (fun x => isEmptyElim x) (fun i => PEmpty.elim i)
    letI : Scheme.Cover.Over W 𝒰 :=
      Scheme.Cover.Over.mk (S := W) (𝒰 := 𝒰) (fun i => PEmpty.elim i) (fun i => PEmpty.elim i)
    rw [Scheme.smallEtaleTopology.eq_1]
    refine (Scheme.mem_smallGrothendieckTopology _ _).mpr ⟨𝒰, inferInstance, fun j => PEmpty.elim j, ?_⟩
    intro Y f hf
    obtain ⟨i⟩ := hf
    exact PEmpty.elim i
  rw [Limits.IsZero.iff_id_eq_zero]
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext V
  exact (hT V.unop).hom_ext _ _

theorem wc_et_left_adjoint_closed_push_vanish_off : ∀ {X Y Z : Scheme.{u}} (g : X ⟶ Y) (i : Z ⟶ Y) [IsClosedImmersion i] (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → ∀ (E : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (V : X.Etale) (t : (L.obj ((wcEtPush i).obj E)).obj.obj (Opposite.op V)) (v : V.left), g (V.hom v) ∉ Set.range i → ∃ (V₁ : X.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ (L.obj ((wcEtPush i).obj E)).obj.map c.op t = 0 :=
by
  intro X Y Z g i _ L hadj E V t v hv
  classical
  obtain ⟨adj⟩ := hadj

  have hcl : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  let O : Y.Opens := ⟨(Set.range i)ᶜ, hcl.isOpen_compl⟩
  let O' : X.Opens := g ⁻¹ᵁ O
  let gO : (O' : Scheme.{u}) ⟶ (O : Scheme.{u}) := g ∣_ O
  have hsq : O'.ι ≫ g = gO ≫ O.ι := (morphismRestrict_ι g O).symm
  obtain ⟨Lj, ⟨adjj⟩, -, -⟩ := wc_et_push_left_adjoint O.ι
  obtain ⟨Lj', ⟨adjj'⟩, -, -⟩ := wc_et_push_left_adjoint O'.ι
  obtain ⟨LgO, ⟨adjgO⟩, -, -⟩ := wc_et_push_left_adjoint gO

  have h1 : Limits.IsZero (Lj.obj ((wcEtPush i).obj E)) := by
    obtain ⟨L'', ⟨adj''⟩, -, -⟩ := wc_et_push_left_adjoint (Limits.pullback.fst i O.ι)
    obtain ⟨β⟩ := wc_et_open_push_base_change O.ι i Lj L'' ⟨adjj⟩ ⟨adj''⟩ E
    have hemp : IsEmpty ↥(Limits.pullback i O.ι) := by
      refine ⟨fun z => ?_⟩
      have hz : (Limits.pullback.fst i O.ι ≫ i) z = (Limits.pullback.snd i O.ι ≫ O.ι) z := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hz
      have hmem : O.ι (Limits.pullback.snd i O.ι z) ∈ (O : Set Y) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨_, rfl⟩
      exact hmem ⟨_, hz⟩
    have h0 := wc_et_sheaf_isZero_of_isEmpty _ hemp (L''.obj E)
    obtain ⟨L₂, ⟨adj₂⟩, -, -⟩ := wc_et_push_left_adjoint (Limits.pullback.snd i O.ι)
    haveI : (wcEtPush (Limits.pullback.snd i O.ι)).IsRightAdjoint := adj₂.isRightAdjoint
    haveI : (wcEtPush (Limits.pullback.snd i O.ι)).PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_isRightAdjoint _
    exact Limits.IsZero.of_iso (Functor.map_isZero _ h0) β

  let ν : wcEtPush O'.ι ⋙ wcEtPush g ≅ wcEtPush gO ⋙ wcEtPush O.ι :=
    Classical.choice (wc_et_push_id_comp_iso O'.ι g).2 ≪≫
      eqToIso (congrArg (fun f => wcEtPush f) hsq) ≪≫
      (Classical.choice (wc_et_push_id_comp_iso gO O.ι).2).symm
  let α : L ⋙ Lj' ≅ Lj ⋙ LgO :=
    ((adj.comp adjj').ofNatIsoRight ν).leftAdjointUniq (adjj.comp adjgO)
  haveI : LgO.IsLeftAdjoint := adjgO.isLeftAdjoint
  haveI : LgO.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint LgO
  have h2 : Limits.IsZero (Lj'.obj (L.obj ((wcEtPush i).obj E))) :=
    Limits.IsZero.of_iso (Functor.map_isZero LgO h1) (α.app ((wcEtPush i).obj E))

  have hvO : V.hom v ∈ O' := (Scheme.Hom.mem_preimage g).mpr hv
  obtain ⟨W₀', hW₀aff, hvW₀, hW₀le⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens V.left))
      (show v ∈ V.hom ⁻¹ᵁ O' from (Scheme.Hom.mem_preimage _).mpr hvO)
  let W₀ : V.left.Opens := W₀'
  haveI : IsAffine (W₀ : Scheme.{u}) := hW₀aff
  haveI : Etale V.hom := V.prop
  let V₁ : X.Etale := wcEtOpen X V W₀
  let c : V₁ ⟶ V := wcEtOpenι X V W₀
  have hrange : Set.range ⇑(W₀.ι ≫ V.hom) ⊆ Set.range ⇑O'.ι := by
    rintro _ ⟨w, rfl⟩
    rw [Scheme.Opens.range_ι, Scheme.Hom.comp_apply]
    have hw0 : W₀.ι w ∈ (W₀ : Set V.left) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨w, rfl⟩
    have hw1 : W₀.ι w ∈ V.hom ⁻¹ᵁ O' := hW₀le hw0
    exact (Scheme.Hom.mem_preimage _).mp hw1
  let lam := IsOpenImmersion.lift O'.ι (W₀.ι ≫ V.hom) hrange
  have hlam : lam ≫ O'.ι = W₀.ι ≫ V.hom := IsOpenImmersion.lift_fac _ _ _
  have hlamE : Etale lam := by
    haveI : Etale (lam ≫ O'.ι) := by rw [hlam]; infer_instance
    exact Etale.of_comp lam O'.ι
  let Wu : (O' : Scheme.{u}).Etale := MorphismProperty.Over.mk ⊤ lam hlamE
  obtain ⟨ρ, -, -, -, hlim⟩ := wc_et_pullback_sections_colimit O'.ι Lj' ⟨adjj'⟩
  let D : Discrete PUnit.{u+1} ⥤ X.Etale := (Functor.const _).obj V₁
  have key := hlim Wu (Discrete PUnit.{u+1}) D (fun _ => 𝟙 (W₀ : Scheme.{u}))
    (fun _ => (Category.id_comp _).trans hlam.symm)
    (fun _ => Category.comp_id _)
    (fun T z _ => ⟨z ⟨⟨⟩⟩, fun l => by rcases l with ⟨⟨⟩⟩; exact Category.comp_id _,
      fun z₀ hz₀ => (Category.comp_id z₀).symm.trans (hz₀ ⟨⟨⟩⟩)⟩)
    (fun _ => inferInstanceAs (CompactSpace ↥(W₀ : Scheme.{u})))
    (fun _ => inferInstanceAs (QuasiSeparatedSpace ↥(W₀ : Scheme.{u})))
    (fun _ => inferInstanceAs (IsAffineHom (𝟙 (W₀ : Scheme.{u}))))
    (inferInstanceAs (CompactSpace ↥(W₀ : Scheme.{u})))
    (inferInstanceAs (QuasiSeparatedSpace ↥(W₀ : Scheme.{u})))
  haveI hsub : Subsingleton ((Lj'.obj (L.obj ((wcEtPush i).obj E))).obj.obj (Opposite.op Wu)) := by
    have h3 : Limits.IsZero (Lj'.obj (L.obj ((wcEtPush i).obj E))).obj :=
      Functor.map_isZero (sheafToPresheaf _ _) h2
    exact AddCommGrpCat.isZero_iff_subsingleton.mp (h3.obj (Opposite.op Wu))
  let x : (L.obj ((wcEtPush i).obj E)).obj.obj (Opposite.op V₁) :=
    ((L.obj ((wcEtPush i).obj E)).obj.map c.op).hom t
  obtain ⟨l', t', ht'⟩ := key.2 (L.obj ((wcEtPush i).obj E)) ⟨⟨⟩⟩ x (Subsingleton.elim _ _)
  have hx0 : x = 0 := by
    have e : (L.obj ((wcEtPush i).obj E)).obj.map (D.map t').op = 𝟙 _ := by
      show (L.obj ((wcEtPush i).obj E)).obj.map (𝟙 V₁).op = 𝟙 _
      rw [op_id]
      exact CategoryTheory.Functor.map_id _ _
    rw [e] at ht'
    first
      | exact ht'
      | simpa using ht'
  refine ⟨V₁, c, ?_, hx0⟩
  show v ∈ Set.range W₀.ι
  rw [Scheme.Opens.range_ι]
  exact hvW₀

theorem wc_et_closed_push_adj_isos : ∀ {Z B : Scheme.{u}} (i : Z ⟶ B) [IsClosedImmersion i] (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush i), IsIso adj.counit ∧ ∀ (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), (∀ (V : B.Etale) (s : F.obj.obj (Opposite.op V)) (v : V.left), V.hom v ∉ Set.range i → ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ F.obj.map c.op s = 0) → IsIso (adj.unit.app F) :=
by
  intro Z B i _ L adj
  haveI := wc_et_closed_bc_cover_dense i
    (by intros; exact wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg _ _ _)
  haveI := wc_et_closed_bc_locally_full i
    (by intros; exact wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg _ _ _)
  haveI hcounit : IsIso adj.counit := wc_et_push_counit_iso_of_dense_full i L adj
  refine ⟨hcounit, ?_⟩
  haveI := adj.isRightAdjoint
  haveI := adj.isLeftAdjoint
  haveI : (wcEtPush i).PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint _
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : L.PreservesEpimorphisms := Functor.preservesEpimorphisms_of_isLeftAdjoint L
  have hTc : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  let P : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} → Prop := fun F =>
    ∀ (V : B.Etale) (g : F.obj.obj (Opposite.op V)) (v : V.left), V.hom v ∈ (Set.range i)ᶜ →
      ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ F.obj.map c.op g = 0
  have hPpush : ∀ H, P ((wcEtPush i).obj H) := fun H V g v hv =>
    wc_et_push_vanish_off_range i H hTc V g v hv
  have hPepi : ∀ {F F' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (π : F ⟶ F'),
      Epi π → P F → P F' := fun π hπ hF => wc_et_vanish_off_of_epi (Set.range i)ᶜ π hπ hF
  have hPmono : ∀ F, P F → Mono (adj.unit.app F) := fun F hF =>
    wc_et_unit_mono_of_vanish_off i L adj F hF
  intro F hF
  haveI := hPmono F hF
  have hPC : P (Limits.cokernel (adj.unit.app F)) :=
    hPepi (Limits.cokernel.π (adj.unit.app F)) inferInstance (hPpush _)
  have eL : L.map (adj.unit.app F) = inv (adj.counit.app (L.obj F)) :=
    IsIso.eq_inv_of_inv_hom_id (adj.left_triangle_components F)
  haveI : IsIso (L.map (adj.unit.app F)) := by
    rw [eL]
    exact IsIso.inv_isIso
  have hLπ : L.map (Limits.cokernel.π (adj.unit.app F)) = 0 := by
    rw [← cancel_epi (L.map (adj.unit.app F)), ← L.map_comp, Limits.cokernel.condition,
      L.map_zero, Limits.comp_zero]
  have hLC : Limits.IsZero (L.obj (Limits.cokernel (adj.unit.app F))) :=
    Limits.IsZero.of_epi_eq_zero (L.map (Limits.cokernel.π (adj.unit.app F))) hLπ
  have hRLC : Limits.IsZero ((wcEtPush i).obj (L.obj (Limits.cokernel (adj.unit.app F)))) :=
    (wcEtPush i).map_isZero hLC
  haveI := hPmono _ hPC
  have hC : Limits.IsZero (Limits.cokernel (adj.unit.app F)) :=
    Limits.IsZero.of_mono (adj.unit.app (Limits.cokernel (adj.unit.app F))) hRLC
  have hπ0 : Limits.cokernel.π (adj.unit.app F) = 0 := hC.eq_of_tgt _ _
  haveI : Epi (adj.unit.app F) := Abelian.epi_of_cokernel_π_eq_zero _ hπ0
  exact isIso_of_mono_of_epi _

theorem wc_adj_closed_bc_h0_transfer : ∀ {CY CX CZ CX' : Type*} [Category CY] [Category CX] [Category CZ] [Category CX'] (L : CY ⥤ CX) (G : CX ⥤ CY) (adj : L ⊣ G) (Li : CY ⥤ CZ) (Ri : CZ ⥤ CY) (adji : Li ⊣ Ri) (L' : CZ ⥤ CX') (G' : CX' ⥤ CZ) (adj' : L' ⊣ G') (Li' : CX ⥤ CX') (Ri' : CX' ⥤ CX) (adji' : Li' ⊣ Ri') (ν : Ri' ⋙ G ≅ G' ⋙ Ri), IsIso adji.counit → ∀ (OY : CY) (OZ : CZ) (eZ : Li.obj OY ≅ OZ) (E : CZ), IsIso (adji'.unit.app (L.obj (Ri.obj E))) → Function.Bijective (fun φ : OZ ⟶ E => φ ≫ adj'.unit.app E) → Function.Bijective (fun φ : OY ⟶ Ri.obj E => φ ≫ adj.unit.app (Ri.obj E)) :=
by
  intro CY CX CZ CX' _ _ _ _ L G adj Li Ri adji L' G' adj' Li' Ri' adji' ν hcounit OY OZ eZ E hu hb

  have hpostY : ∀ {X Y Z : CY} (g : Y ⟶ Z), IsIso g →
      Function.Bijective (fun φ : X ⟶ Y => φ ≫ g) := by
    intro X Y Z g hg
    refine ⟨fun a b h => ?_, fun ψ => ⟨ψ ≫ inv g, by simp⟩⟩
    simpa using congrArg (fun t => t ≫ inv g) h
  have hpostZ : ∀ {X Y Z : CZ} (g : Y ⟶ Z), IsIso g →
      Function.Bijective (fun φ : X ⟶ Y => φ ≫ g) := by
    intro X Y Z g hg
    refine ⟨fun a b h => ?_, fun ψ => ⟨ψ ≫ inv g, by simp⟩⟩
    simpa using congrArg (fun t => t ≫ inv g) h
  have := hcounit
  have hε : IsIso (adji.counit.app E) := inferInstance

  have hD0 : Function.Bijective (fun χ : OZ ⟶ Li.obj (Ri.obj E) =>
      χ ≫ adj'.unit.app (Li.obj (Ri.obj E))) := by
    have hk3 : IsIso (G'.map (L'.map (adji.counit.app E))) := inferInstance
    refine (Function.Bijective.of_comp_iff' (hpostZ (X := OZ) _ hk3) _).mp ?_
    have heq : (fun ψ : OZ ⟶ G'.obj (L'.obj (Li.obj (Ri.obj E))) =>
          ψ ≫ G'.map (L'.map (adji.counit.app E))) ∘
        (fun χ : OZ ⟶ Li.obj (Ri.obj E) => χ ≫ adj'.unit.app (Li.obj (Ri.obj E))) =
        (fun φ : OZ ⟶ E => φ ≫ adj'.unit.app E) ∘
          (fun χ : OZ ⟶ Li.obj (Ri.obj E) => χ ≫ adji.counit.app E) := by
      funext χ
      simp only [Function.comp_apply, Category.assoc]
      rw [Adjunction.unit_naturality]
      rfl
    exact (congrArg Function.Bijective heq).mpr (hb.comp (hpostZ _ hε))

  have hΘ : ∀ B : CZ, Function.Bijective
      (fun ψ : OY ⟶ Ri.obj B => eZ.inv ≫ (adji.homEquiv OY B).symm ψ) := by
    intro B
    have h1 : Function.Bijective (fun χ : Li.obj OY ⟶ B => eZ.inv ≫ χ) :=
      ⟨fun a b h => by simpa using congrArg (fun t => eZ.hom ≫ t) h,
        fun c => ⟨eZ.hom ≫ c, by simp⟩⟩
    exact h1.comp (Equiv.bijective _)
  have hC : Function.Bijective (fun ψ : OY ⟶ Ri.obj (Li.obj (Ri.obj E)) =>
      ψ ≫ Ri.map (adj'.unit.app (Li.obj (Ri.obj E)))) := by
    refine (Function.Bijective.of_comp_iff' (hΘ (G'.obj (L'.obj (Li.obj (Ri.obj E))))) _).mp ?_
    have heq : (fun ψ : OY ⟶ Ri.obj (G'.obj (L'.obj (Li.obj (Ri.obj E)))) =>
          eZ.inv ≫ (adji.homEquiv OY (G'.obj (L'.obj (Li.obj (Ri.obj E))))).symm ψ) ∘
        (fun ψ : OY ⟶ Ri.obj (Li.obj (Ri.obj E)) =>
          ψ ≫ Ri.map (adj'.unit.app (Li.obj (Ri.obj E)))) =
        (fun χ : OZ ⟶ Li.obj (Ri.obj E) => χ ≫ adj'.unit.app (Li.obj (Ri.obj E))) ∘
          (fun ψ : OY ⟶ Ri.obj (Li.obj (Ri.obj E)) =>
            eZ.inv ≫ (adji.homEquiv OY (Li.obj (Ri.obj E))).symm ψ) := by
      funext ψ
      simp only [Function.comp_apply, Category.assoc]
      rw [Adjunction.homEquiv_naturality_right_symm]
    exact (congrArg Function.Bijective heq).mpr (hD0.comp (hΘ _))

  have hηi : IsIso (adji.unit.app (Ri.obj E)) := by
    have h := adji.right_triangle_components E
    have h2 : adji.unit.app (Ri.obj E) = inv (Ri.map (adji.counit.app E)) :=
      (cancel_mono (Ri.map (adji.counit.app E))).mp (h.trans (IsIso.inv_hom_id _).symm)
    rw [h2]
    infer_instance

  let α := (adj.comp adji').leftAdjointUniq ((adji.comp adj').ofNatIsoRight ν.symm)
  have hU : adj.unit.app (Ri.obj E) ≫ G.map (adji'.unit.app (L.obj (Ri.obj E))) ≫
      G.map (Ri'.map (α.hom.app (Ri.obj E))) =
      adji.unit.app (Ri.obj E) ≫ Ri.map (adj'.unit.app (Li.obj (Ri.obj E))) ≫
        ν.inv.app (L'.obj (Li.obj (Ri.obj E))) := by
    have h := Adjunction.unit_leftAdjointUniq_hom_app (adj.comp adji')
      ((adji.comp adj').ofNatIsoRight ν.symm) (Ri.obj E)
    rw [Adjunction.comp_unit_app, Adjunction.ofNatIsoRight_unit, NatTrans.comp_app,
      Adjunction.comp_unit_app] at h
    simp only [Category.assoc, Functor.comp_map, Functor.whiskerLeft_app, Iso.symm_hom] at h
    exact h

  have hk1 : IsIso (G.map (adji'.unit.app (L.obj (Ri.obj E))) ≫
      G.map (Ri'.map (α.hom.app (Ri.obj E)))) := inferInstance
  have hk2 : IsIso (ν.inv.app (L'.obj (Li.obj (Ri.obj E)))) := inferInstance
  refine (Function.Bijective.of_comp_iff' (hpostY (X := OY) _ hk1) _).mp ?_
  have heq : (fun ψ : OY ⟶ G.obj (L.obj (Ri.obj E)) => ψ ≫ (G.map (adji'.unit.app (L.obj (Ri.obj E))) ≫
      G.map (Ri'.map (α.hom.app (Ri.obj E))))) ∘
      (fun φ : OY ⟶ Ri.obj E => φ ≫ adj.unit.app (Ri.obj E)) =
      (fun ψ : OY ⟶ Ri.obj (G'.obj (L'.obj (Li.obj (Ri.obj E)))) =>
          ψ ≫ ν.inv.app (L'.obj (Li.obj (Ri.obj E)))) ∘
        ((fun ψ : OY ⟶ Ri.obj (Li.obj (Ri.obj E)) =>
          ψ ≫ Ri.map (adj'.unit.app (Li.obj (Ri.obj E)))) ∘
          (fun φ : OY ⟶ Ri.obj E => φ ≫ adji.unit.app (Ri.obj E))) := by
    funext φ
    simp only [Function.comp_apply, Category.assoc]
    exact congrArg (fun t => φ ≫ t) hU
  exact (congrArg Function.Bijective heq).mpr ((hpostY _ hk2).comp (hC.comp (hpostY _ hηi)))

theorem wc_hal_acyc_closed_push : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] (s : Spec (.of A) ⟶ Spec (.of K)) (L : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush (wcHalA1Proj s)) → Limits.PreservesFiniteLimits L → ∀ (e : L.obj (wcZSh (Spec (.of A))) ≅ wcZSh (wcHalA1 s)) (A' : Type u) [CommRing A'] (φ : A →+* A'), Function.Surjective φ → ∀ (E : Sheaf (Scheme.smallEtaleTopology (Spec (.of A'))) AddCommGrpCat.{u+1}), (Subsingleton A' ∨ ∀ (L' : Sheaf (Scheme.smallEtaleTopology (Spec (.of A'))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (wcHalA1 (Spec.map (CommRingCat.ofHom φ) ≫ s))) AddCommGrpCat.{u+1}), Nonempty (L' ⊣ wcEtPush (wcHalA1Proj (Spec.map (CommRingCat.ofHom φ) ≫ s))) → Limits.PreservesFiniteLimits L' → ∀ (e' : L'.obj (wcZSh (Spec (.of A'))) ≅ wcZSh (wcHalA1 (Spec.map (CommRingCat.ofHom φ) ≫ s))) (n : ℕ), wcHalAcyc L' e' E n) → ∀ n, wcHalAcyc L e ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E) n :=
by
  intro K _ A _ s L hadj _ e A' _ φ hφ E hyp n
  classical
  obtain ⟨adj⟩ := hadj

  haveI hiC : IsClosedImmersion (Spec.map (CommRingCat.ofHom φ)) :=
    IsClosedImmersion.spec_of_surjective _ hφ
  haveI : L.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  obtain ⟨Li, ⟨adji⟩, -, ⟨ei⟩⟩ := wc_et_push_left_adjoint (Spec.map (CommRingCat.ofHom φ))
  haveI : (wcEtPush (Spec.map (CommRingCat.ofHom φ))).IsRightAdjoint := adji.isRightAdjoint
  haveI : (wcEtPush (Spec.map (CommRingCat.ofHom φ))).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint _

  have tr : ∀ {Y : Scheme.{u}} {M N : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}},
      (M ≅ N) → ∀ q : ℕ, Nonempty (wcEtExt Y M q ≃ wcEtExt Y N q) := by
    intro Y M N f q
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    let E' : Abelian.Ext (wcZSh Y) M q ≃ Abelian.Ext (wcZSh Y) N q :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ f.hom) (add_zero q)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ f.inv) (add_zero q)
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
    exact ⟨E'⟩
  rcases hyp with hsub | hyp
  ·
    haveI : IsEmpty ↥(Spec (.of A')) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hsub
    have hE0 : Limits.IsZero E := wc_et_sheaf_isZero_of_isEmpty _ inferInstance E
    have hF0 : Limits.IsZero ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E) :=
      Functor.map_isZero _ hE0
    have hLF0 : Limits.IsZero (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)) :=
      Functor.map_isZero L hF0
    refine ⟨fun ψ => ⟨0, hLF0.eq_of_tgt _ _, fun φ' _ => hF0.eq_of_tgt _ _⟩, fun p _ _ => ?_⟩
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    have key : ∀ z : Abelian.Ext (wcZSh (wcHalA1 s))
        (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)) p, z = 0 := by
      intro z
      calc z = z.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero p) := (Abelian.Ext.comp_mk₀_id z).symm
        _ = z.comp (Abelian.Ext.mk₀ 0) (add_zero p) := by rw [hLF0.eq_of_src (𝟙 _) 0]
        _ = 0 := by rw [Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    exact ⟨fun x y => (key x).trans (key y).symm⟩
  ·
    obtain ⟨L', ⟨adj'⟩, hL', ⟨e'⟩⟩ :=
      wc_et_push_left_adjoint (wcHalA1Proj (Spec.map (CommRingCat.ofHom φ) ≫ s))
    have hE : ∀ m, wcHalAcyc L' e' E m := fun m => hyp L' ⟨adj'⟩ hL' e' m

    have h4 : ∀ {Y X : Scheme.{u}}
        (L₀ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
        (G₀ : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (adj₀ : L₀ ⊣ G₀) (OC : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (OD : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (e₀ : L₀.obj OC ≅ OD)
        (F₀ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
        (∀ ψ : OD ⟶ L₀.obj F₀, ∃! φ₀ : OC ⟶ F₀, e₀.inv ≫ L₀.map φ₀ = ψ) ↔
          Function.Bijective (fun φ₀ : OC ⟶ F₀ => φ₀ ≫ adj₀.unit.app F₀) := by
      intro Y X L₀ G₀ adj₀ OC OD e₀ F₀
      have hfac : ∀ φ₀ : OC ⟶ F₀, e₀.inv ≫ L₀.map φ₀ =
          e₀.inv ≫ (adj₀.homEquiv OC (L₀.obj F₀)).symm (φ₀ ≫ adj₀.unit.app F₀) := by
        intro φ₀
        rw [Adjunction.homEquiv_counit, Functor.map_comp, Category.assoc,
          adj₀.left_triangle_components, Category.comp_id]
      have hM : (fun φ₀ : OC ⟶ F₀ => e₀.inv ≫ L₀.map φ₀) =
          (fun χ : L₀.obj OC ⟶ L₀.obj F₀ => e₀.inv ≫ χ) ∘
            ((adj₀.homEquiv OC (L₀.obj F₀)).symm ∘ (fun φ₀ : OC ⟶ F₀ => φ₀ ≫ adj₀.unit.app F₀)) := by
        funext φ₀
        exact hfac φ₀
      have hb1 : Function.Bijective (fun χ : L₀.obj OC ⟶ L₀.obj F₀ => e₀.inv ≫ χ) := by
        refine ⟨fun a b h => ?_, fun c => ⟨e₀.hom ≫ c, by simp⟩⟩
        simpa using congrArg (fun t => e₀.hom ≫ t) h
      refine (Function.bijective_iff_existsUnique
        (fun φ₀ : OC ⟶ F₀ => e₀.inv ≫ L₀.map φ₀)).symm.trans ?_
      rw [hM, Function.Bijective.of_comp_iff' hb1,
        Function.Bijective.of_comp_iff' (Equiv.bijective _)]

    obtain ⟨i', hsq, hi'C, hrange⟩ := wc_hal_a1_closed_square K A s A' φ hφ
    haveI := hi'C
    haveI : IsFinite i' := inferInstance
    obtain ⟨Li', ⟨adji'⟩, -, -⟩ := wc_et_push_left_adjoint i'

    have hcounit : IsIso adji.counit :=
      (wc_et_closed_push_adj_isos (Spec.map (CommRingCat.ofHom φ)) Li adji).1
    haveI := hcounit

    have hunit : IsIso (adji'.unit.app
        (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E))) := by
      apply (wc_et_closed_push_adj_isos i' Li' adji').2
      intro V t v hv
      rw [hrange] at hv
      exact wc_et_left_adjoint_closed_push_vanish_off (wcHalA1Proj s)
        (Spec.map (CommRingCat.ofHom φ)) L ⟨adj⟩ E V t v hv
    haveI := hunit

    let ν : wcEtPush i' ⋙ wcEtPush (wcHalA1Proj s) ≅
        wcEtPush (wcHalA1Proj (Spec.map (CommRingCat.ofHom φ) ≫ s)) ⋙
          wcEtPush (Spec.map (CommRingCat.ofHom φ)) :=
      Classical.choice (wc_et_push_id_comp_iso i' (wcHalA1Proj s)).2 ≪≫
        eqToIso (congrArg (fun f => wcEtPush f) hsq.w) ≪≫
        (Classical.choice (wc_et_push_id_comp_iso
          (wcHalA1Proj (Spec.map (CommRingCat.ofHom φ) ≫ s))
          (Spec.map (CommRingCat.ofHom φ))).2).symm
    let α : L ⋙ Li' ≅ Li ⋙ L' :=
      (adj.comp adji').leftAdjointUniq ((adji.comp adj').ofNatIsoRight ν.symm)

    have hbijE : Function.Bijective (fun ψ : wcZSh (Spec (.of A')) ⟶ E => ψ ≫ adj'.unit.app E) :=
      (h4 L' _ adj' _ _ e' E).1 (hE 0).1
    have hbijF := wc_adj_closed_bc_h0_transfer L (wcEtPush (wcHalA1Proj s)) adj Li
      (wcEtPush (Spec.map (CommRingCat.ofHom φ))) adji L'
      (wcEtPush (wcHalA1Proj (Spec.map (CommRingCat.ofHom φ) ≫ s))) adj' Li' (wcEtPush i') adji'
      ν hcounit (wcZSh (Spec (.of A))) (wcZSh (Spec (.of A'))) ei E hunit hbijE
    refine ⟨(h4 L (wcEtPush (wcHalA1Proj s)) adj _ _ e _).2 hbijF, ?_⟩

    intro p hp1 hpn
    haveI hsub : Subsingleton (wcEtExt (wcHalA1 (Spec.map (CommRingCat.ofHom φ) ≫ s))
      (L'.obj E) p) := (hE n).2 p hp1 hpn
    obtain ⟨T1⟩ := tr (M := L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E))
      (N := (wcEtPush i').obj (Li'.obj (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E))))
      (asIso (adji'.unit.app (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)))) p
    obtain ⟨T2⟩ := wc_et_finite_push_ext_equiv i'
      (Li'.obj (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E))) p
    obtain ⟨T3⟩ := tr (M := Li'.obj (L.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)))
      (N := L'.obj (Li.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)))
      (α.app ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)) p
    obtain ⟨T4⟩ := tr (M := L'.obj (Li.obj ((wcEtPush (Spec.map (CommRingCat.ofHom φ))).obj E)))
      (N := L'.obj E) (L'.mapIso (asIso (adji.counit.app E))) p
    exact (T1.trans (T2.trans (T3.trans T4))).subsingleton

theorem wc_et_support_subsheaf_functor : ∀ (Y : Scheme.{u}) (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), ∃ (G : Set Y ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ι : ∀ Z : Set Y, G.obj Z ⟶ F), (∀ Z, Mono (ι Z)) ∧ (∀ (Z Z' : Set Y) (h : Z ⟶ Z'), G.map h ≫ ι Z' = ι Z) ∧ (∀ (Z : Set Y) (V : Y.Etale) (t : F.obj.obj (Opposite.op V)), (∀ v : V.left, V.hom v ∉ Z → ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ F.obj.map c.op t = 0) → ∃ g : (G.obj Z).obj.obj (Opposite.op V), ((ι Z).hom.app (Opposite.op V)).hom g = t) ∧ (∀ (Z : Set Y) (V : Y.Etale) (g : (G.obj Z).obj.obj (Opposite.op V)) (v : V.left), V.hom v ∉ Z → ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ (G.obj Z).obj.map c.op g = 0) :=
by
  intro Y F

  have hEtHom : ∀ {A B : Y.Etale} (c : A ⟶ B), Etale c.left := by
    intro A B c
    have hw : c.left ≫ B.hom = A.hom := MorphismProperty.Over.w c
    have h1 : Etale B.hom := B.prop
    have h2 : Etale (c.left ≫ B.hom) := by rw [hw]; exact A.prop
    exact Etale.of_comp c.left B.hom

  have hRef : ∀ (V V₁ V₂ : Y.Etale) (c₁ : V₁ ⟶ V) (c₂ : V₂ ⟶ V) (p₁ : V₁.left) (p₂ : V₂.left),
      c₁.left p₁ = c₂.left p₂ → ∃ (D : Y.Etale) (π₁ : D ⟶ V₁) (π₂ : D ⟶ V₂) (z : D.left),
        π₁ ≫ c₁ = π₂ ≫ c₂ ∧ π₁.left z = p₁ ∧ π₂.left z = p₂ := by
    intro V V₁ V₂ c₁ c₂ p₁ p₂ hp
    haveI : Etale c₂.left := hEtHom c₂
    haveI : Etale V₁.hom := V₁.prop
    let fst := Limits.pullback.fst c₁.left c₂.left
    let snd := Limits.pullback.snd c₁.left c₂.left
    haveI hfst : Etale fst := inferInstance
    let D : Y.Etale := Scheme.Etale.mk (fst ≫ V₁.hom)
    have hw2 : snd ≫ V₂.hom = fst ≫ V₁.hom := by
      rw [← MorphismProperty.Over.w c₂, ← MorphismProperty.Over.w c₁, ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let π₁ : D ⟶ V₁ := MorphismProperty.Over.homMk fst rfl trivial
    let π₂ : D ⟶ V₂ := MorphismProperty.Over.homMk snd hw2 trivial
    have hcomm : π₁ ≫ c₁ = π₂ ≫ c₂ := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback p₁ p₂ hp
    exact ⟨D, π₁, π₂, z, hcomm, hz1, hz2⟩

  let Q : Set Y → ∀ V : Y.Etale, F.obj.obj (Opposite.op V) → Prop := fun Z V t =>
    ∀ v : V.left, V.hom v ∉ Z →
      ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ F.obj.map c.op t = 0

  have hQ0 : ∀ (Z : Set Y) (V : Y.Etale), Q Z V 0 := by
    intro Z V v _
    exact ⟨V, 𝟙 V, ⟨v, rfl⟩, map_zero _⟩
  have hQadd : ∀ (Z : Set Y) (V : Y.Etale) (t t' : F.obj.obj (Opposite.op V)),
      Q Z V t → Q Z V t' → Q Z V (t + t') := by
    intro Z V t t' ht ht' v hv
    obtain ⟨V₁, c₁, ⟨p₁, hp₁⟩, h₁⟩ := ht v hv
    obtain ⟨V₂, c₂, ⟨p₂, hp₂⟩, h₂⟩ := ht' v hv
    obtain ⟨D, π₁, π₂, z, hcomm, hz1, -⟩ := hRef V V₁ V₂ c₁ c₂ p₁ p₂ (hp₁.trans hp₂.symm)
    refine ⟨D, π₁ ≫ c₁, ⟨z, ?_⟩, ?_⟩
    · show (π₁.left ≫ c₁.left) z = v
      rw [Scheme.Hom.comp_apply, hz1, hp₁]
    · have e1 : F.obj.map (π₁ ≫ c₁).op t = 0 := by
        rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, h₁, map_zero]
      have e2 : F.obj.map (π₁ ≫ c₁).op t' = 0 := by
        rw [hcomm, op_comp, Functor.map_comp, ConcreteCategory.comp_apply, h₂, map_zero]
      rw [map_add, e1, e2, add_zero]
  have hQneg : ∀ (Z : Set Y) (V : Y.Etale) (t : F.obj.obj (Opposite.op V)),
      Q Z V t → Q Z V (-t) := by
    intro Z V t ht v hv
    obtain ⟨V₁, c, hv₁, h⟩ := ht v hv
    exact ⟨V₁, c, hv₁, by rw [map_neg, h, neg_zero]⟩
  have hQres : ∀ (Z : Set Y) (V V' : Y.Etale) (f : V' ⟶ V) (t : F.obj.obj (Opposite.op V)),
      Q Z V t → Q Z V' (F.obj.map f.op t) := by
    intro Z V V' f t ht v' hv'
    have hfv : V.hom (f.left v') = V'.hom v' := by
      rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w f]
    obtain ⟨V₁, c, ⟨p, hp⟩, h⟩ := ht (f.left v') (by rw [hfv]; exact hv')
    obtain ⟨D, π₁, π₂, z, hcomm, hz1, -⟩ := hRef V V' V₁ f c v' p hp.symm
    refine ⟨D, π₁, ⟨z, hz1⟩, ?_⟩
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hcomm, op_comp,
      Functor.map_comp, ConcreteCategory.comp_apply, h, map_zero]
  have hQmono : ∀ (Z Z' : Set Y), Z ⊆ Z' → ∀ (V : Y.Etale) (t : F.obj.obj (Opposite.op V)),
      Q Z V t → Q Z' V t := by
    intro Z Z' hZ V t ht v hv
    exact ht v (fun h => hv (hZ h))

  let S : Set Y → ∀ U : (Y.Etale)ᵒᵖ, AddSubgroup (F.obj.obj U) := fun Z U =>
    { carrier := {t | Q Z U.unop t}
      zero_mem' := hQ0 Z U.unop
      add_mem' := fun {a b} ha hb => hQadd Z U.unop a b ha hb
      neg_mem' := fun {a} ha => hQneg Z U.unop a ha }
  let P₀ : Set Y → ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) := fun Z =>
    { obj := fun U => AddCommGrpCat.of (S Z U)
      map := fun {U U'} g => AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
        ((F.obj.map g).hom.comp (S Z U).subtype) (S Z U')
        (fun x => hQres Z U.unop U'.unop g.unop x.1 x.2))
      map_id := fun U => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply Subtype.ext
        change F.obj.map (𝟙 U) x.1 = x.1
        rw [F.obj.map_id]
        rfl
      map_comp := fun {U U' U''} f g => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply Subtype.ext
        change F.obj.map (f ≫ g) x.1 = F.obj.map g (F.obj.map f x.1)
        rw [F.obj.map_comp]
        rfl }
  have hSle : ∀ (Z Z' : Set Y), Z ≤ Z' → ∀ U : (Y.Etale)ᵒᵖ, S Z U ≤ S Z' U := by
    intro Z Z' hZ U t ht
    exact hQmono Z Z' hZ U.unop t ht
  let P : Set Y ⥤ ((Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    { obj := P₀
      map := fun {Z Z'} h =>
        { app := fun U => AddCommGrpCat.ofHom (AddSubgroup.inclusion (hSle Z Z' (leOfHom h) U))
          naturality := fun U U' g => by
            apply AddCommGrpCat.hom_ext
            apply AddMonoidHom.ext
            intro x
            apply Subtype.ext
            rfl }
      map_id := fun Z => by
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply Subtype.ext
        rfl
      map_comp := fun {Z Z' Z''} h h' => by
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply Subtype.ext
        rfl }
  let α : ∀ Z : Set Y, P.obj Z ⟶ F.obj := fun Z =>
    { app := fun U => AddCommGrpCat.ofHom (S Z U).subtype
      naturality := fun _ _ _ => rfl }
  have hinj : ∀ (Z : Set Y) (U : (Y.Etale)ᵒᵖ), Function.Injective ((α Z).app U).hom :=
    fun Z U => AddSubgroup.subtype_injective _
  have hmonoα : ∀ Z : Set Y, Mono (α Z) := by
    intro Z
    haveI : ∀ U, Mono ((α Z).app U) := fun U =>
      (AddCommGrpCat.mono_iff_injective _).mpr (hinj Z U)
    exact NatTrans.mono_of_mono_app (α Z)
  have hcompat : ∀ (Z Z' : Set Y) (h : Z ⟶ Z'), P.map h ≫ α Z' = α Z := by
    intro Z Z' h
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    rfl

  have hkey : ∀ Z : Set Y,
      (sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).unit.app
          (P.obj Z) ≫
        (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (α Z) ≫
            (sheafificationAdjunction (Scheme.smallEtaleTopology Y)
              AddCommGrpCat.{u+1}).counit.app F) = α Z := by
    intro Z
    have h1 := (sheafificationAdjunction (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).unit_naturality (α Z)
    have h2 : (sheafificationAdjunction (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).unit.app F.obj ≫
        (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          ((sheafificationAdjunction (Scheme.smallEtaleTopology Y)
            AddCommGrpCat.{u+1}).counit.app F) = 𝟙 F.obj :=
      (sheafificationAdjunction (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).right_triangle_components F
    rw [Functor.map_comp, ← Category.assoc, h1, Category.assoc, h2, Category.comp_id]
  refine ⟨P ⋙ presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
    fun Z => (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (α Z) ≫
      (sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).counit.app F,
    ?_, ?_, ?_, ?_⟩
  ·
    intro Z
    haveI := hmonoα Z
    infer_instance
  ·
    intro Z Z' h
    show (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (P.map h) ≫
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (α Z') ≫
        (sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).counit.app F
      = _
    rw [← Functor.map_comp_assoc, hcompat]
  ·
    intro Z V t ht
    let p : S Z (Opposite.op V) := ⟨t, ht⟩
    refine ⟨(((sheafificationAdjunction (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).unit.app (P.obj Z)).app (Opposite.op V)).hom p, ?_⟩
    have := congrArg (fun φ => (φ.app (Opposite.op V)).hom p) (hkey Z)
    exact this
  ·
    intro Z V g v hv
    have hSurj : ∀ (V : Y.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology Y V →
        ∀ y : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
      intro V R hR y
      change R ∈ Scheme.smallGrothendieckTopology @Etale Y V at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
      exact ⟨V₁, c, w, hc, hw⟩
    let η := toSheafify (Scheme.smallEtaleTopology Y) (P.obj Z)
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) η :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) η g
    obtain ⟨V', f, v', hf, hfv⟩ := hSurj V _ hI v
    obtain ⟨p, hp⟩ := hf
    have hv' : V'.hom v' ∉ Z := by
      have e : V'.hom v' = V.hom v := by
        rw [← hfv, ← Scheme.Hom.comp_apply, MorphismProperty.Over.w f]
      rw [e]; exact hv
    obtain ⟨V₁, c, ⟨w, hw⟩, hc⟩ := p.2 v' hv'
    have e1 : (P.obj Z).map c.op p = 0 := Subtype.ext hc
    refine ⟨V₁, c ≫ f, ⟨w, ?_⟩, ?_⟩
    · show (c.left ≫ f.left) w = v
      rw [Scheme.Hom.comp_apply, hw, hfv]
    · change (sheafify (Scheme.smallEtaleTopology Y) (P.obj Z)).map (c ≫ f).op g = 0
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, ← hp,
        ← NatTrans.naturality_apply η c.op p, e1, map_zero]

theorem wc_et_closed_unit_iso_of_vanish_off : ∀ {Z B : Scheme.{u}} (i : Z ⟶ B) [IsClosedImmersion i] (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (adj : L ⊣ wcEtPush i) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), (∀ (V : B.Etale) (g : G.obj.obj (Opposite.op V)) (v : V.left), V.hom v ∉ Set.range i → ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ G.obj.map c.op g = 0) → IsIso (adj.unit.app G) :=
by
  intro Z B i _ L adj G hG
  have hTc : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
  haveI := adj.isRightAdjoint
  haveI := adj.isLeftAdjoint
  haveI : (wcEtPush i).PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint _
  haveI : L.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint L
  haveI : L.PreservesEpimorphisms := Functor.preservesEpimorphisms_of_isLeftAdjoint L
  haveI := wc_et_closed_bc_cover_dense i
    (by intros; exact wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg _ _ _)
  haveI := wc_et_closed_bc_locally_full i
    (by intros; exact wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg _ _ _)
  haveI hcounit : IsIso adj.counit := wc_et_push_counit_iso_of_dense_full i L adj
  let P : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} → Prop := fun F =>
    ∀ (V : B.Etale) (g : F.obj.obj (Opposite.op V)) (v : V.left), V.hom v ∈ (Set.range i)ᶜ →
      ∃ (V₁ : B.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ F.obj.map c.op g = 0
  have hPpush : ∀ H, P ((wcEtPush i).obj H) := fun H V g v hv =>
    wc_et_push_vanish_off_range i H hTc V g v hv
  have hPepi : ∀ {F F' : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (π : F ⟶ F'),
      Epi π → P F → P F' := fun π hπ hF => wc_et_vanish_off_of_epi (Set.range i)ᶜ π hπ hF
  have hPmono : ∀ F, P F → Mono (adj.unit.app F) := fun F hF =>
    wc_et_unit_mono_of_vanish_off i L adj F hF
  have hPG : P G := fun V g v hv => hG V g v hv
  haveI := hPmono G hPG
  have hPC : P (Limits.cokernel (adj.unit.app G)) :=
    hPepi (Limits.cokernel.π (adj.unit.app G)) inferInstance (hPpush _)
  have eL : L.map (adj.unit.app G) = inv (adj.counit.app (L.obj G)) :=
    IsIso.eq_inv_of_inv_hom_id (adj.left_triangle_components G)
  haveI : IsIso (L.map (adj.unit.app G)) := by
    rw [eL]
    exact IsIso.inv_isIso
  have hLπ : L.map (Limits.cokernel.π (adj.unit.app G)) = 0 := by
    rw [← cancel_epi (L.map (adj.unit.app G)), ← L.map_comp, Limits.cokernel.condition,
      L.map_zero, Limits.comp_zero]
  have hLC : Limits.IsZero (L.obj (Limits.cokernel (adj.unit.app G))) :=
    Limits.IsZero.of_epi_eq_zero (L.map (Limits.cokernel.π (adj.unit.app G))) hLπ
  have hRLC : Limits.IsZero ((wcEtPush i).obj (L.obj (Limits.cokernel (adj.unit.app G)))) :=
    (wcEtPush i).map_isZero hLC
  haveI := hPmono _ hPC
  have hC : Limits.IsZero (Limits.cokernel (adj.unit.app G)) :=
    Limits.IsZero.of_mono (adj.unit.app (Limits.cokernel (adj.unit.app G))) hRLC
  have hπ0 : Limits.cokernel.π (adj.unit.app G) = 0 := hC.eq_of_tgt _ _
  haveI : Epi (adj.unit.app G) := Abelian.epi_of_cokernel_π_eq_zero _ hπ0
  exact isIso_of_mono_of_epi _

theorem wc_et_generic_vanish_local_support : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}), (∀ (𝔭 : PrimeSpectrum A), 𝔭.asIdeal ∈ minimalPrimes A → Subsingleton ((wcEtStalk (Spec (.of A)) 𝔭).obj F)) → ∀ (V : (Spec (.of A)).Etale) (s : F.obj.obj (Opposite.op V)) (v : V.left), ∃ (V₁ : (Spec (.of A)).Etale) (f : V₁ ⟶ V) (I : Ideal A), v ∈ Set.range f.left ∧ (∀ 𝔮 ∈ minimalPrimes A, ¬ I ≤ 𝔮) ∧ ∀ w : V₁.left, V₁.hom w ∉ PrimeSpectrum.zeroLocus (I : Set A) → ∃ (V₂ : (Spec (.of A)).Etale) (c : V₂ ⟶ V₁), w ∈ Set.range c.left ∧ F.obj.map c.op (F.obj.map f.op s) = 0 :=
by
  intro A _ _ F hgen V s v
  classical

  haveI : IsLocallyNoetherian V.left := by
    haveI : LocallyOfFiniteType V.hom := by
      haveI : Etale V.hom := V.prop
      infer_instance
    haveI : IsLocallyNoetherian ((Functor.fromPUnit (Spec (.of A))).obj V.right) :=
      (inferInstance : IsLocallyNoetherian (Spec (.of A)))
    exact LocallyOfFiniteType.isLocallyNoetherian V.hom
  obtain ⟨W, hW, hvW, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
    (Scheme.isBasis_affineOpens V.left)) (show v ∈ (⊤ : V.left.Opens) from trivial)
  haveI : IsNoetherianRing Γ(V.left, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
  have hNW : TopologicalSpace.NoetherianSpace W := noetherianSpace_of_isAffineOpen W hW
  let V₁ := wcEtOpen (Spec (.of A)) V W
  let f : V₁ ⟶ V := wcEtOpenι (Spec (.of A)) V W
  haveI : TopologicalSpace.NoetherianSpace V₁.left := hNW

  let p : V₁.left → PrimeSpectrum A := fun w => V₁.hom w
  have hp : Continuous p := V₁.hom.continuous
  let s₁ := F.obj.map f.op s
  let N : Set V₁.left := {w | ∃ (V₂ : (Spec (.of A)).Etale) (c : V₂ ⟶ V₁),
    w ∈ Set.range c.left ∧ F.obj.map c.op s₁ = 0}
  have hNopen : IsOpen N := (wc_etale_section_vanishing_open (Spec (.of A)) F V₁ s₁).1
  have hmin : ∀ w : V₁.left, (p w).asIdeal ∈ minimalPrimes A → w ∈ N := fun w hw =>
    wc_et_vanish_off_of_stalks F V₁ s₁ w (hgen (V₁.hom w) hw)

  obtain ⟨S, hSfin, hScl, hSirr, hSeq⟩ :=
    TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hNopen.isClosed_compl
  have hgp : ∀ T : S, ∃ c : V₁.left, IsGenericPoint c T.1 := fun T =>
    QuasiSober.sober (hSirr T.1 T.2) (hScl T.1 T.2)
  choose c hc using hgp
  haveI : Fintype S := hSfin.fintype
  let I : Ideal A := Finset.univ.inf (fun T : S => (p (c T)).asIdeal)
  refine ⟨V₁, f, I, ?_, ?_, ?_⟩
  · change v ∈ Set.range (Scheme.Opens.ι (X := V.left) W)
    rw [Scheme.Opens.range_ι]
    exact hvW
  · intro 𝔮 h𝔮 hle
    obtain ⟨T, -, hT⟩ := (Ideal.IsPrime.inf_le' (Ideal.minimalPrimes_isPrime h𝔮)).mp hle
    have h𝔮' : Minimal (fun q : Ideal A => q.IsPrime ∧ ⊥ ≤ q) 𝔮 := h𝔮
    have heq : (p (c T)).asIdeal = 𝔮 := h𝔮'.eq_of_le ⟨(p (c T)).isPrime, bot_le⟩ hT
    have hcN : c T ∈ N := hmin (c T) (by rw [heq]; exact h𝔮)
    have hcT : c T ∈ T.1 := (hc T).mem
    have hcN' : c T ∈ Nᶜ := by
      rw [hSeq]
      exact Set.mem_sUnion_of_mem hcT T.2
    exact hcN' hcN
  · intro w hw
    by_contra hwN
    have hw' : w ∈ Nᶜ := hwN
    rw [hSeq] at hw'
    obtain ⟨T, hTS, hwT⟩ := Set.mem_sUnion.mp hw'
    have hsp : c ⟨T, hTS⟩ ⤳ w := (hc ⟨T, hTS⟩).specializes hwT
    have hle : p (c ⟨T, hTS⟩) ≤ p w := (PrimeSpectrum.le_iff_specializes _ _).mpr (hsp.map hp)
    apply hw
    change p w ∈ PrimeSpectrum.zeroLocus (I : Set A)
    rw [PrimeSpectrum.mem_zeroLocus]
    have hle' : (p (c ⟨T, hTS⟩)).asIdeal ≤ (p w).asIdeal := hle
    exact (Finset.inf_le (f := fun T : S => (p (c T)).asIdeal) (Finset.mem_univ ⟨T, hTS⟩)).trans hle'

theorem wc_et_filtered_mono_cocone_colimit : ∀ (Y : Scheme.{u}) (J : Type (u+1)) [SmallCategory J] [IsFiltered J] (D : J ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (c : Limits.Cocone D), (∀ j, Mono (c.ι.app j)) → (∀ (V : Y.Etale) (s : c.pt.obj.obj (Opposite.op V)) (v : V.left), ∃ (V₁ : Y.Etale) (f : V₁ ⟶ V) (j : J) (t : (D.obj j).obj.obj (Opposite.op V₁)), v ∈ Set.range f.left ∧ ((c.ι.app j).hom.app (Opposite.op V₁)).hom t = c.pt.obj.map f.op s) → Nonempty (Limits.IsColimit c) :=
by
  intro Y J _ _ D c hmono hloc
  let φ : Limits.colimit D ⟶ c.pt := (Limits.colimit.isColimit D).desc c
  have hφι : ∀ j : J, Limits.colimit.ι D j ≫ φ = c.ι.app j := fun j => Limits.colimit.ι_desc c j
  have hstar : ∀ (j : J) (V : Y.Etale) (t : (D.obj j).obj.obj (Opposite.op V)),
      (φ.hom.app (Opposite.op V)).hom (((Limits.colimit.ι D j).hom.app (Opposite.op V)).hom t) =
        ((c.ι.app j).hom.app (Opposite.op V)).hom t := by
    intro j V t
    rw [← hφι j]
    rfl

  have hepi : Epi φ := by
    apply (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mp
    constructor
    intro U s
    apply wc_etale_jointly_surjective_covers Y U
    intro v
    obtain ⟨V₁, f, j, t, hv, ht⟩ := hloc U s v
    exact ⟨V₁, f, ⟨((Limits.colimit.ι D j).hom.app (Opposite.op V₁)).hom t, (hstar j V₁ t).trans ht⟩, hv⟩

  have hlegs : ∀ (i : J) (W : Y.Etale),
      Function.Injective ((c.ι.app i).hom.app (Opposite.op W)).hom := by
    intro i W
    haveI := hmono i
    haveI : Mono (c.ι.app i).hom :=
      Functor.map_mono (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (c.ι.app i)
    haveI : Mono ((c.ι.app i).hom.app (Opposite.op W)) :=
      (NatTrans.mono_iff_mono_app _).mp inferInstance _
    exact (AddCommGrpCat.mono_iff_injective _).mp inferInstance

  have hmonoφ : Mono φ := by
    haveI : Mono φ.hom := by
      rw [NatTrans.mono_iff_mono_app]
      intro V
      obtain ⟨V⟩ := V
      rw [AddCommGrpCat.mono_iff_injective, injective_iff_map_eq_zero]
      intro s hs
      have hS := (wc_et_sheaf_colimit_cocone_local Y J D).1 V s
      apply Sheaf.isSeparated (Limits.colimit D) V _ hS s 0
      intro V'' f hf
      rw [Sieve.generate_apply] at hf
      obtain ⟨V', h, g, ⟨i, t, hit⟩, rfl⟩ := hf
      have hn : (φ.hom.app (Opposite.op V')).hom (((Limits.colimit D).obj.map g.op).hom s) =
          (c.pt.obj.map g.op).hom ((φ.hom.app (Opposite.op V)).hom s) := by
        have := congrArg (fun m => m.hom s) (φ.hom.naturality g.op)
        exact this
      have hc : ((c.ι.app i).hom.app (Opposite.op V')).hom t = 0 := by
        calc ((c.ι.app i).hom.app (Opposite.op V')).hom t
            = (φ.hom.app (Opposite.op V')).hom
                (((Limits.colimit.ι D i).hom.app (Opposite.op V')).hom t) := (hstar i V' t).symm
          _ = (φ.hom.app (Opposite.op V')).hom (((Limits.colimit D).obj.map g.op).hom s) := by
                rw [hit]
          _ = (c.pt.obj.map g.op).hom ((φ.hom.app (Opposite.op V)).hom s) := hn
          _ = (c.pt.obj.map g.op).hom 0 := congrArg (c.pt.obj.map g.op).hom hs
          _ = 0 := map_zero _
      have ht0 : t = 0 := hlegs i V' (hc.trans (map_zero _).symm)
      have hg0 : ((Limits.colimit D).obj.map g.op).hom s = 0 := by
        rw [← hit, ht0, map_zero]
      rw [map_zero, op_comp, Functor.map_comp]
      show ((Limits.colimit D).obj.map h.op).hom (((Limits.colimit D).obj.map g.op).hom s) = 0
      rw [hg0, map_zero]
    exact Sheaf.Hom.mono_of_presheaf_mono _ _ φ
  haveI := hepi
  haveI := hmonoφ
  haveI hiso : IsIso φ := isIso_of_mono_of_epi φ
  exact ⟨Limits.IsColimit.ofPointIso (Limits.colimit.isColimit D) (i := hiso)⟩

theorem wc_et_generic_vanish_decomp : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (ℓ : ℕ) (Kf : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}), ℓ • 𝟙 Kf = 0 → (∀ (𝔭 : PrimeSpectrum A), 𝔭.asIdeal ∈ minimalPrimes A → Subsingleton ((wcEtStalk (Spec (.of A)) 𝔭).obj Kf)) → ∃ (J : Type (u+1)) (_ : SmallCategory J) (_ : IsFiltered J) (D : J ⥤ Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) (c : Limits.Cocone D), Nonempty (Limits.IsColimit c) ∧ Nonempty (c.pt ≅ Kf) ∧ ∀ j, ∃ (I : Ideal A) (E : Sheaf (Scheme.smallEtaleTopology (Spec (.of (A ⧸ I)))) AddCommGrpCat.{u+1}), (∀ 𝔮 ∈ minimalPrimes A, ¬ I ≤ 𝔮) ∧ ℓ • 𝟙 E = 0 ∧ Nonempty (D.obj j ≅ (wcEtPush (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).obj E) :=
by
  intro A _ _ ℓ Kf hℓ hgen
  classical

  have hP : ∀ (I I' : Ideal A), (∀ 𝔮 ∈ minimalPrimes A, ¬ I ≤ 𝔮) →
      (∀ 𝔮 ∈ minimalPrimes A, ¬ I' ≤ 𝔮) → ∀ 𝔮 ∈ minimalPrimes A, ¬ I ⊓ I' ≤ 𝔮 := by
    intro I I' hI hI' 𝔮 h𝔮 hle
    rcases (Ideal.IsPrime.inf_le (Ideal.minimalPrimes_isPrime h𝔮)).mp hle with h | h
    · exact hI 𝔮 h𝔮 h
    · exact hI' 𝔮 h𝔮 h
  haveI hdir : IsDirectedOrder (ULift.{u+1} {I : Ideal A // ∀ 𝔮 ∈ minimalPrimes A, ¬ I ≤ 𝔮}ᵒᵈ) := by
    refine ⟨fun a b => ⟨ULift.up (OrderDual.toDual ⟨(OrderDual.ofDual a.down).1 ⊓
      (OrderDual.ofDual b.down).1,
      hP _ _ (OrderDual.ofDual a.down).2 (OrderDual.ofDual b.down).2⟩), ?_, ?_⟩⟩
    · exact (inf_le_left : (OrderDual.ofDual a.down).1 ⊓ (OrderDual.ofDual b.down).1 ≤
        (OrderDual.ofDual a.down).1)
    · exact (inf_le_right : (OrderDual.ofDual a.down).1 ⊓ (OrderDual.ofDual b.down).1 ≤
        (OrderDual.ofDual b.down).1)
  haveI hne : Nonempty (ULift.{u+1} {I : Ideal A // ∀ 𝔮 ∈ minimalPrimes A, ¬ I ≤ 𝔮}ᵒᵈ) :=
    ⟨ULift.up (OrderDual.toDual ⟨⊤, fun 𝔮 h𝔮 hle =>
      (Ideal.minimalPrimes_isPrime h𝔮).ne_top (top_le_iff.mp hle)⟩)⟩
  haveI hfilt : IsFiltered (ULift.{u+1} {I : Ideal A // ∀ 𝔮 ∈ minimalPrimes A, ¬ I ≤ 𝔮}ᵒᵈ) :=
    isFiltered_of_directed_le_nonempty _

  have hmono : Monotone (fun j : ULift.{u+1} {I : Ideal A // ∀ 𝔮 ∈ minimalPrimes A, ¬ I ≤ 𝔮}ᵒᵈ =>
      (PrimeSpectrum.zeroLocus ((OrderDual.ofDual j.down).1 : Set A) : Set (Spec (.of A)))) := by
    intro a b hab
    exact PrimeSpectrum.zeroLocus_anti_mono_ideal hab

  obtain ⟨G, ι, hιmono, hcompat, hlift, hvan⟩ := wc_et_support_subsheaf_functor (Spec (.of A)) Kf
  let D := hmono.functor ⋙ G
  let c : Limits.Cocone D :=
    { pt := Kf
      ι := { app := fun j => ι (hmono.functor.obj j)
             naturality := fun j j' f =>
               (hcompat _ _ (hmono.functor.map f)).trans (Category.comp_id _).symm } }

  have hcolim : Nonempty (Limits.IsColimit c) := by
    apply wc_et_filtered_mono_cocone_colimit (Spec (.of A)) _ D c
    · intro j
      exact hιmono _
    · intro V s v
      obtain ⟨V₁, f, I, hv, hI, hvanI⟩ := wc_et_generic_vanish_local_support A Kf hgen V s v
      obtain ⟨g, hg⟩ := hlift (PrimeSpectrum.zeroLocus (I : Set A)) V₁ (Kf.obj.map f.op s) hvanI
      exact ⟨V₁, f, ULift.up (OrderDual.toDual ⟨I, hI⟩), g, hv, hg⟩

  have htors : ∀ Z : Set (Spec (.of A)), ℓ • 𝟙 (G.obj Z) = 0 := by
    intro Z
    haveI := hιmono Z
    rw [← cancel_mono (ι Z), Limits.zero_comp, Preadditive.nsmul_comp, Category.id_comp]
    calc ℓ • ι Z = ι Z ≫ (ℓ • 𝟙 Kf) := by rw [Preadditive.comp_nsmul, Category.comp_id]
      _ = 0 := by rw [hℓ, Limits.comp_zero]
  refine ⟨_, inferInstance, hfilt, D, c, hcolim, ⟨Iso.refl _⟩, ?_⟩

  intro j
  have hrange : Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (OrderDual.ofDual j.down).1))) =
      PrimeSpectrum.zeroLocus (((OrderDual.ofDual j.down).1 : Ideal A) : Set A) := by
    have h1 : ∀ x, (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (OrderDual.ofDual j.down).1))) x =
        PrimeSpectrum.comap (Ideal.Quotient.mk (OrderDual.ofDual j.down).1) x := fun x => rfl
    exact (congrArg Set.range (funext h1)).trans
      ((range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective).trans (by rw [Ideal.mk_ker]))
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (OrderDual.ofDual j.down).1))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (OrderDual.ofDual j.down).1)))
  haveI hiso : IsIso (adj.unit.app (D.obj j)) :=
    wc_et_closed_unit_iso_of_vanish_off _ L adj (D.obj j) (by
      intro V g v hv
      rw [hrange] at hv
      exact hvan _ V g v hv)

  haveI := adj.isRightAdjoint
  haveI := adj.rightAdjoint_preservesLimits.{0, 0}
  haveI : (wcEtPush (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (OrderDual.ofDual j.down).1)))).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint _
  haveI : (wcEtPush (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (OrderDual.ofDual j.down).1)))).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI : L.Additive := adj.left_adjoint_additive
  have h0 : ℓ • 𝟙 (D.obj j) = 0 := htors (hmono.functor.obj j)
  have htE : ℓ • 𝟙 (L.obj (D.obj j)) = 0 := by
    rw [← L.map_id, ← L.map_nsmul, h0, L.map_zero]
  exact ⟨(OrderDual.ofDual j.down).1, L.obj (D.obj j), (OrderDual.ofDual j.down).2, htE,
    ⟨asIso (adj.unit.app (D.obj j))⟩⟩

theorem wc_hal_acyc_of_good_embeddings : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (ℓ : ℕ) (L : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush (wcHalA1Proj s)) → Limits.PreservesFiniteLimits L → ∀ (e : L.obj (wcZSh (Spec (.of A))) ≅ wcZSh (wcHalA1 s)), (∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}, ℓ • 𝟙 F = 0 → ∃ (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) (u : F ⟶ G), ℓ • 𝟙 G = 0 ∧ (∀ n, wcHalAcyc L e G n) ∧ (∀ n, wcHalAcyc L e (Limits.kernel u) n)) → ∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}, ℓ • 𝟙 F = 0 → ∀ n, wcHalAcyc L e F n :=
by
  intro K _ A _ _ _ s ℓ L hadj hL e hgood
  classical
  obtain ⟨adj⟩ := hadj
  haveI := hL
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L := Limits.PreservesColimitsOfSize.preservesFiniteColimits L
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}) :=
    HasExt.standard _

  have H1 : ∀ (F' : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})
      (y : Abelian.Ext (wcZSh (Spec (.of A))) F' 1), y = 0 :=
    fun F' y => @Subsingleton.elim (Abelian.Ext (wcZSh (Spec (.of A))) F' 1)
      (wc_et_strictly_local_ext_vanishing A F' 0) y 0
  have extZ : ∀ (G : Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}) (p : ℕ),
      Subsingleton (wcEtExt (wcHalA1 s) G p) →
      ∀ y : Abelian.Ext (wcZSh (wcHalA1 s)) G p, y = 0 :=
    fun G p h y => @Subsingleton.elim (Abelian.Ext (wcZSh (wcHalA1 s)) G p) h y 0
  have mkSub : ∀ (G : Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}) (p : ℕ),
      (∀ y : Abelian.Ext (wcZSh (wcHalA1 s)) G p, y = 0) →
      Subsingleton (wcEtExt (wcHalA1 s) G p) :=
    fun G p h => ⟨fun a b => (h a).trans (h b).symm⟩

  have LF : ∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})),
      S.ShortExact → ∀ φ₃ : wcZSh (Spec (.of A)) ⟶ S.X₃,
      ∃ φ₂ : wcZSh (Spec (.of A)) ⟶ S.X₂, φ₂ ≫ S.g = φ₃ := by
    intro S hS φ₃
    have h0 : (Abelian.Ext.mk₀ φ₃).comp hS.extClass (zero_add 1) = 0 := H1 _ _
    obtain ⟨x₂, hx₂⟩ :=
      Abelian.Ext.covariant_sequence_exact₃ (wcZSh (Spec (.of A))) hS (Abelian.Ext.mk₀ φ₃) (zero_add 1) h0
    obtain ⟨φ₂, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x₂
    refine ⟨φ₂, (Abelian.Ext.mk₀_bijective _ _).1 ?_⟩
    rw [← Abelian.Ext.mk₀_comp_mk₀]
    exact hx₂

  have inj0_of : ∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}),
      (∀ ψ : wcZSh (wcHalA1 s) ⟶ L.obj F, ∃! φ : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = ψ) →
      ∀ φ : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = 0 → φ = 0 := by
    intro F h φ hφ
    exact (h 0).unique hφ (by rw [Functor.map_zero, Limits.comp_zero])
  have uniq_of : ∀ (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}),
      (∀ φ : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = 0 → φ = 0) →
      ∀ φ φ' : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = e.inv ≫ L.map φ' → φ = φ' := by
    intro F h φ φ' hφ
    rw [← sub_eq_zero]
    apply h
    rw [Functor.map_sub, Preadditive.comp_sub, hφ, sub_self]

  have ses_sub : ∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})),
      S.ShortExact → (∀ φ : wcZSh (Spec (.of A)) ⟶ S.X₃, e.inv ≫ L.map φ = 0 → φ = 0) →
      ∀ n : ℕ, wcHalAcyc L e S.X₂ n → (∀ m : ℕ, m + 1 = n → wcHalAcyc L e S.X₃ m) →
      wcHalAcyc L e S.X₁ n := by
    intro S hS hinj3 n h2 h3
    have hLS := hS.map_of_exact L
    haveI := hS.mono_f
    haveI : Mono (L.map S.f) := hLS.mono_f
    have hfg : L.map S.f ≫ L.map S.g = 0 := by
      rw [← L.map_comp, S.zero, Functor.map_zero]
    have inj2 := inj0_of _ h2.1
    have inj1 : ∀ φ : wcZSh (Spec (.of A)) ⟶ S.X₁, e.inv ≫ L.map φ = 0 → φ = 0 := by
      intro φ hφ
      have h' : φ ≫ S.f = 0 :=
        inj2 _ (by rw [L.map_comp, ← Category.assoc, hφ, Limits.zero_comp])
      rw [← cancel_mono S.f, h', Limits.zero_comp]
    refine ⟨fun ψ => ?_, fun p hp1 hpn => ?_⟩
    · obtain ⟨φ₂, hφ₂, -⟩ := h2.1 (ψ ≫ L.map S.f)
      have hq : φ₂ ≫ S.g = 0 :=
        hinj3 _ (by rw [L.map_comp, ← Category.assoc, hφ₂, Category.assoc, hfg, Limits.comp_zero])
      obtain ⟨φ, hφ⟩ := hS.exact.lift' φ₂ hq
      have hφψ : e.inv ≫ L.map φ = ψ := by
        rw [← cancel_mono (L.map S.f), Category.assoc, ← L.map_comp, hφ, hφ₂]
      exact ⟨φ, hφψ, fun φ' hφ' => uniq_of _ inj1 _ _ (hφ'.trans hφψ.symm)⟩
    · apply mkSub
      intro y
      have hy2 : y.comp (Abelian.Ext.mk₀ (S.map L).f) (add_zero p) = 0 :=
        extZ _ _ (h2.2 p hp1 hpn) _
      obtain ⟨m', rfl⟩ : ∃ m', p = m' + 1 := ⟨p - 1, by omega⟩
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ (wcZSh (wcHalA1 s)) hLS y hy2 rfl
      rw [← hx₃]
      obtain ⟨m, hm⟩ : ∃ m, m + 1 = n := ⟨n - 1, by omega⟩
      have H3 := h3 m hm
      rcases Nat.eq_zero_or_pos m' with h0 | hpos
      · subst h0
        obtain ⟨ψ₃, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x₃
        obtain ⟨φ₃, hφ₃, -⟩ := H3.1 ψ₃
        obtain ⟨φ₂, hφ₂⟩ := LF S hS φ₃
        have hψ : ψ₃ = (e.inv ≫ L.map φ₂) ≫ (S.map L).g := by
          change ψ₃ = (e.inv ≫ L.map φ₂) ≫ L.map S.g
          rw [Category.assoc, ← L.map_comp, hφ₂, hφ₃]
        rw [hψ, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero,
          hLS.comp_extClass, Abelian.Ext.comp_zero]
      · rw [extZ _ _ (H3.2 m' hpos (by omega)) x₃, Abelian.Ext.zero_comp]

  have ses_mid : ∀ (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})),
      S.ShortExact → ∀ n : ℕ, wcHalAcyc L e S.X₁ n → wcHalAcyc L e S.X₃ n →
      wcHalAcyc L e S.X₂ n := by
    intro S hS n h1 h3
    have hLS := hS.map_of_exact L
    haveI := hS.mono_f
    haveI : Mono (L.map S.f) := hLS.mono_f
    haveI : Mono (S.map L).f := hLS.mono_f
    have inj1 := inj0_of _ h1.1
    have inj3 := inj0_of _ h3.1
    have inj2 : ∀ φ : wcZSh (Spec (.of A)) ⟶ S.X₂, e.inv ≫ L.map φ = 0 → φ = 0 := by
      intro δ hδ
      have hq : δ ≫ S.g = 0 :=
        inj3 _ (by rw [L.map_comp, ← Category.assoc, hδ, Limits.zero_comp])
      obtain ⟨κ, hκ⟩ := hS.exact.lift' δ hq
      have hκ0 : e.inv ≫ L.map κ = 0 := by
        rw [← cancel_mono (L.map S.f), Category.assoc, ← L.map_comp, hκ, hδ, Limits.zero_comp]
      rw [← hκ, inj1 κ hκ0, Limits.zero_comp]
    refine ⟨fun ψ => ?_, fun p hp1 hpn => ?_⟩
    · obtain ⟨φ₃, hφ₃, -⟩ := h3.1 (ψ ≫ L.map S.g)
      obtain ⟨φ₂', hφ₂'⟩ := LF S hS φ₃
      have hχ : (ψ - e.inv ≫ L.map φ₂') ≫ (S.map L).g = 0 := by
        change (ψ - e.inv ≫ L.map φ₂') ≫ L.map S.g = 0
        rw [Preadditive.sub_comp, Category.assoc, ← L.map_comp, hφ₂', hφ₃, sub_self]
      obtain ⟨χ, hχ'⟩ := hLS.exact.lift' _ hχ
      obtain ⟨φ₁, hφ₁, -⟩ := h1.1 χ
      have hφψ : e.inv ≫ L.map (φ₂' + φ₁ ≫ S.f) = ψ := by
        rw [Functor.map_add, Preadditive.comp_add, L.map_comp, ← Category.assoc, hφ₁]
        have hχ'' : χ ≫ L.map S.f = ψ - e.inv ≫ L.map φ₂' := hχ'
        rw [hχ'']
        abel
      exact ⟨_, hφψ, fun φ' hφ' => uniq_of _ inj2 _ _ (hφ'.trans hφψ.symm)⟩
    · apply mkSub
      intro y
      have hy3 : y.comp (Abelian.Ext.mk₀ (S.map L).g) (add_zero p) = 0 :=
        extZ _ _ (h3.2 p hp1 hpn) _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ (wcZSh (wcHalA1 s)) hLS y hy3
      rw [← hx₁, extZ _ _ (h1.2 p hp1 hpn) x₁, Abelian.Ext.zero_comp]

  have inj0_good : ∀ {F G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}}
      (u : F ⟶ G), wcHalAcyc L e G 0 → wcHalAcyc L e (Limits.kernel u) 0 →
      ∀ φ : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = 0 → φ = 0 := by
    intro F G u hG hK φ hφ
    have hu : φ ≫ u = 0 :=
      inj0_of _ hG.1 _ (by rw [L.map_comp, ← Category.assoc, hφ, Limits.zero_comp])
    haveI : Mono (L.map (Limits.kernel.ι u)) := inferInstance
    have hy : Limits.kernel.lift u φ hu = 0 := inj0_of _ hK.1 _ (by
      rw [← cancel_mono (L.map (Limits.kernel.ι u)), Category.assoc, ← L.map_comp,
        Limits.kernel.lift_ι, hφ, Limits.zero_comp])
    rw [← Limits.kernel.lift_ι u φ hu, hy, Limits.zero_comp]

  have tors_coker : ∀ {F G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}}
      (u : F ⟶ G), ℓ • 𝟙 G = 0 → ℓ • 𝟙 (Limits.cokernel u) = 0 := by
    intro F G u hG
    rw [← cancel_epi (Limits.cokernel.π u), Preadditive.comp_nsmul, Category.comp_id,
      Limits.comp_zero]
    calc ℓ • Limits.cokernel.π u = (ℓ • 𝟙 G) ≫ Limits.cokernel.π u := by
          rw [Preadditive.nsmul_comp, Category.id_comp]
      _ = 0 := by rw [hG, Limits.zero_comp]
  have hinj : ∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1},
      ℓ • 𝟙 F = 0 → ∀ φ : wcZSh (Spec (.of A)) ⟶ F, e.inv ≫ L.map φ = 0 → φ = 0 := by
    intro F hF
    obtain ⟨G, u, -, hG, hK⟩ := hgood F hF
    exact inj0_good u (hG 0) (hK 0)

  have step : ∀ n : ℕ, (∀ m : ℕ, m + 1 = n →
      ∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1},
        ℓ • 𝟙 F = 0 → wcHalAcyc L e F m) →
      ∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1},
        ℓ • 𝟙 F = 0 → wcHalAcyc L e F n := by
    intro n ih F hF
    obtain ⟨G, u, hGt, hG, hK⟩ := hgood F hF
    have hQ := tors_coker u hGt
    have hS₂ : (ShortComplex.mk (Limits.kernel.ι (Limits.cokernel.π u)) (Limits.cokernel.π u)
        (Limits.kernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk'
        (ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel (Limits.cokernel.π u)))
        (show Mono (Limits.kernel.ι (Limits.cokernel.π u)) from inferInstance)
        (show Epi (Limits.cokernel.π u) from inferInstance)
    have w : Limits.kernel.ι u ≫ Limits.kernel.lift (Limits.cokernel.π u) u
        (Limits.cokernel.condition u) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι (Limits.cokernel.π u)), Category.assoc,
        Limits.kernel.lift_ι, Limits.kernel.condition, Limits.zero_comp]
    have hS₁ : (ShortComplex.mk (Limits.kernel.ι u) (Limits.kernel.lift (Limits.cokernel.π u) u
        (Limits.cokernel.condition u)) w).ShortExact :=
      ShortComplex.ShortExact.mk'
        (ShortComplex.exact_of_f_is_kernel _
          (Limits.isKernelOfComp (Limits.kernel.ι (Limits.cokernel.π u)) u
            (Limits.kernelIsKernel u) w (Limits.kernel.lift_ι _ _ _)))
        (show Mono (Limits.kernel.ι u) from inferInstance)
        (show Epi (Limits.kernel.lift (Limits.cokernel.π u) u (Limits.cokernel.condition u)) from
          inferInstance)
    have hI : wcHalAcyc L e (Limits.kernel (Limits.cokernel.π u)) n :=
      ses_sub _ hS₂ (hinj _ hQ) n (hG n) (fun m hm => ih m hm _ hQ)
    exact ses_mid _ hS₁ n (hK n) hI
  have main : ∀ n : ℕ, ∀ F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1},
      ℓ • 𝟙 F = 0 → wcHalAcyc L e F n := by
    intro n
    induction n with
    | zero => exact step 0 (fun m hm => absurd hm (Nat.succ_ne_zero m))
    | succ n ih =>
      exact step (n + 1) (fun m hm => by
        obtain rfl : m = n := by omega
        exact ih)
  intro F hF n
  exact main n F hF

theorem wc_spec_field_section_eq_of_point_eq : ∀ (K : Type u) [Field K] {W : Scheme.{u}} (q : W ⟶ Spec (.of K)) (t t' : Spec (.of K) ⟶ W), t ≫ q = 𝟙 _ → t' ≫ q = 𝟙 _ → t (IsLocalRing.closedPoint K) = t' (IsLocalRing.closedPoint K) → t = t' :=
by
  intro K _ W q t t' hq hq' hpt
  have key : ∀ (x : W) (a a' : W.residueField x ⟶ CommRingCat.of K),
      Spec.map a ≫ W.fromSpecResidueField x ≫ q = 𝟙 _ →
      Spec.map a' ≫ W.fromSpecResidueField x ≫ q = 𝟙 _ → a = a' := by
    intro x a a' ha ha'
    have hbm : Spec.map (Spec.preimage (W.fromSpecResidueField x ≫ q)) =
        W.fromSpecResidueField x ≫ q := Spec.map_preimage _
    have h1 : Spec.preimage (W.fromSpecResidueField x ≫ q) ≫ a = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, hbm, ha, Spec.map_id]
    have h2 : Spec.preimage (W.fromSpecResidueField x ≫ q) ≫ a' = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, hbm, ha', Spec.map_id]
    have e1 : ∀ k, a.hom ((Spec.preimage (W.fromSpecResidueField x ≫ q)).hom k) = k := by
      intro k
      have := congrArg (fun f => f.hom k) h1
      simpa using this
    have e2 : ∀ k, a'.hom ((Spec.preimage (W.fromSpecResidueField x ≫ q)).hom k) = k := by
      intro k
      have := congrArg (fun f => f.hom k) h2
      simpa using this
    have hinj : Function.Injective a.hom := RingHom.injective a.hom
    have e3 : ∀ y, (Spec.preimage (W.fromSpecResidueField x ≫ q)).hom (a.hom y) = y :=
      fun y => hinj (e1 (a.hom y))
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro y
    calc a.hom y = a'.hom ((Spec.preimage (W.fromSpecResidueField x ≫ q)).hom (a.hom y)) :=
          (e2 _).symm
      _ = a'.hom y := by rw [e3]
  have ht := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K W t
  have ht' := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K W t'
  obtain ⟨a, ha⟩ : ∃ a : W.residueField (t (IsLocalRing.closedPoint K)) ⟶ CommRingCat.of K,
      Spec.map a ≫ W.fromSpecResidueField (t (IsLocalRing.closedPoint K)) = t := ⟨_, ht⟩
  obtain ⟨a', ha'⟩ : ∃ a' : W.residueField (t (IsLocalRing.closedPoint K)) ⟶ CommRingCat.of K,
      Spec.map a' ≫ W.fromSpecResidueField (t (IsLocalRing.closedPoint K)) = t' := by
    rw [hpt]; exact ⟨_, ht'⟩
  have hk : a = a' := key _ a a'
    (by rw [← Category.assoc, ha, hq]) (by rw [← Category.assoc, ha', hq'])
  calc t = Spec.map a ≫ W.fromSpecResidueField (t (IsLocalRing.closedPoint K)) := ha.symm
    _ = Spec.map a' ≫ W.fromSpecResidueField (t (IsLocalRing.closedPoint K)) := by rw [hk]
    _ = t' := ha'

theorem wc_etale_over_field_discrete : ∀ (K : Type u) [Field K] {W : Scheme.{u}} (q : W ⟶ Spec (.of K)) [Etale q], DiscreteTopology W :=
by
  intro K _ W q _
  haveI : LocallyQuasiFinite q := ⟨fun {U} hU {V} hV e => by
    have h := HasRingHomProperty.appLE @Etale q ‹_› ⟨U, hU⟩ ⟨V, hV⟩ e
    letI := (q.appLE U V e).hom.toAlgebra
    haveI := h.toAlgebra
    exact RingHom.quasiFinite_algebraMap.mpr inferInstance⟩
  haveI := IsLocallyArtinian.of_locallyQuasiFinite q
  exact IsLocallyArtinian.discreteTopology

theorem wc_et_geom_germ_lc_hom : (∀ (K : Type u) [Field K] {W : Scheme.{u}} (q : W ⟶ Spec (.of K)) (t t' : Spec (.of K) ⟶ W), t ≫ q = 𝟙 _ → t' ≫ q = 𝟙 _ → t (IsLocalRing.closedPoint K) = t' (IsLocalRing.closedPoint K) → t = t') → (∀ (K : Type u) [Field K] {W : Scheme.{u}} (q : W ⟶ Spec (.of K)) [Etale q], DiscreteTopology W) → ∀ (Y : Scheme.{u}) (y : Y) (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), ∃ (α : F.obj ⟶ wcLCPb (wcEtGeomPt Y y) ((wcEtStalk Y y).obj F)) (pt : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y), ((wcEtBaseChange (wcEtGeomPt Y y)).obj A.right).left), ∀ (A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (s : F.obj.obj (Opposite.op A.right)), (@id (LocallyConstant ((wcEtBaseChange (wcEtGeomPt Y y)).obj A.right).left ((wcEtStalk Y y).obj F)) ((α.app (Opposite.op A.right)).hom s)) (pt A) = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙ F.obj) (Opposite.op A)).hom s :=
by
  intro Hsec Hdisc Y y F
  classical

  have Hlift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g]
      (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) →
      ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s ∧ t (IsLocalRing.closedPoint Ω) = v := by
    intro Ω _ _ V U g _ s v hv
    have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
        U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
      rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
    have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
    generalize Scheme.SpecToEquivOfField Ω U s = p at hs h1
    obtain ⟨u, φ⟩ := p
    simp only at hs h1
    rw [← h1] at hv
    subst hv
    letI : Algebra (U.residueField (g v)) (V.residueField v) := (g.residueFieldMap v).hom.toAlgebra
    haveI : Algebra.IsSeparable (U.residueField (g v)) (V.residueField v) := inferInstance
    haveI : Algebra.IsAlgebraic (U.residueField (g v)) (V.residueField v) :=
      Algebra.IsSeparable.isAlgebraic _ _
    letI : Algebra (U.residueField (g v)) Ω := φ.hom.toAlgebra
    let χ₀ : V.residueField v →ₐ[U.residueField (g v)] Ω :=
      IsAlgClosed.lift (R := U.residueField (g v)) (S := V.residueField v) (M := Ω)
    let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
    have hχ : g.residueFieldMap v ≫ χ = φ := by
      ext r
      exact χ₀.commutes r
    have key : ∀ x : Spec (.of Ω), (Spec.map χ ≫ V.fromSpecResidueField v) x = v := by
      intro x
      rw [Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply _ _
    refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_, key _⟩
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Category.assoc, ← Spec.map_comp, hχ, hs]

  have hsec : ∀ (V : Y.Etale) (w : (Limits.pullback V.hom (wcEtGeomPt Y y) : Scheme.{u})),
      ∃ t : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶
          Limits.pullback V.hom (wcEtGeomPt Y y),
        t ≫ Limits.pullback.snd V.hom (wcEtGeomPt Y y) = 𝟙 _ ∧
          t (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) = w := by
    intro V w
    haveI : Etale (Limits.pullback.snd V.hom (wcEtGeomPt Y y)) :=
      ((wcEtBaseChange (wcEtGeomPt Y y)).obj V).prop
    exact Hlift (AlgebraicClosure (Y.residueField y)) (Limits.pullback.snd V.hom (wcEtGeomPt Y y))
      (𝟙 _) w (Subsingleton.elim (α := Spec (.of (AlgebraicClosure (Y.residueField y)))) _ _)
  choose σ hσ1 hσ2 using hsec

  have huniq : ∀ (V : Y.Etale) (w : (Limits.pullback V.hom (wcEtGeomPt Y y) : Scheme.{u}))
      (τ : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶
          Limits.pullback V.hom (wcEtGeomPt Y y)),
      τ ≫ Limits.pullback.snd V.hom (wcEtGeomPt Y y) = 𝟙 _ →
      τ (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) = w → τ = σ V w :=
    fun V w τ h1 h2 => Hsec _ (Limits.pullback.snd V.hom (wcEtGeomPt Y y)) τ (σ V w) h1
      (hσ1 V w) (h2.trans (hσ2 V w).symm)

  let lam : ∀ V : Y.Etale, (Limits.pullback V.hom (wcEtGeomPt Y y) : Scheme.{u}) →
      (Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ V.left) :=
    fun V w => σ V w ≫ Limits.pullback.fst V.hom (wcEtGeomPt Y y)
  have hlam1 : ∀ (V : Y.Etale) (w : (Limits.pullback V.hom (wcEtGeomPt Y y) : Scheme.{u})),
      lam V w ≫ V.hom = wcEtGeomPt Y y := by
    intro V w
    show (σ V w ≫ Limits.pullback.fst V.hom (wcEtGeomPt Y y)) ≫ V.hom = wcEtGeomPt Y y
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hσ1 V w, Category.id_comp]

  let hm : ∀ (V V' : Y.Etale) (g : V' ⟶ V),
      Limits.pullback V'.hom (wcEtGeomPt Y y) ⟶ Limits.pullback V.hom (wcEtGeomPt Y y) :=
    fun V V' g => Limits.pullback.lift (Limits.pullback.fst V'.hom (wcEtGeomPt Y y) ≫ g.left)
      (Limits.pullback.snd V'.hom (wcEtGeomPt Y y))
      (by rw [Category.assoc, MorphismProperty.Over.w g]; exact Limits.pullback.condition)
  have hm_fst : ∀ (V V' : Y.Etale) (g : V' ⟶ V),
      hm V V' g ≫ Limits.pullback.fst V.hom (wcEtGeomPt Y y) =
        Limits.pullback.fst V'.hom (wcEtGeomPt Y y) ≫ g.left :=
    fun V V' g => Limits.pullback.lift_fst _ _ _
  have hm_snd : ∀ (V V' : Y.Etale) (g : V' ⟶ V),
      hm V V' g ≫ Limits.pullback.snd V.hom (wcEtGeomPt Y y) =
        Limits.pullback.snd V'.hom (wcEtGeomPt Y y) :=
    fun V V' g => Limits.pullback.lift_snd _ _ _
  have hlam2 : ∀ (V V' : Y.Etale) (g : V' ⟶ V)
      (w' : (Limits.pullback V'.hom (wcEtGeomPt Y y) : Scheme.{u})),
      lam V (hm V V' g w') = lam V' w' ≫ g.left := by
    intro V V' g w'
    have key : σ V' w' ≫ hm V V' g = σ V (hm V V' g w') := by
      apply huniq
      · rw [Category.assoc, hm_snd]
        exact hσ1 V' w'
      · first
        | exact (Scheme.Hom.comp_apply _ _ _).trans (congrArg (hm V V' g) (hσ2 V' w'))
        | exact (congrArg (hm V V' g) (hσ2 V' w') : _)
        | (show (hm V V' g) ((σ V' w') (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))) = _
           exact congrArg (hm V V' g) (hσ2 V' w'))
    show σ V (hm V V' g w') ≫ Limits.pullback.fst V.hom (wcEtGeomPt Y y) =
      (σ V' w' ≫ Limits.pullback.fst V'.hom (wcEtGeomPt Y y)) ≫ g.left
    rw [← key, Category.assoc, hm_fst, Category.assoc]

  let ell : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y),
      Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶
        Limits.pullback A.right.hom (wcEtGeomPt Y y) :=
    fun A => Limits.pullback.lift A.hom.left (𝟙 _) (by simpa using Over.w A.hom)
  let pt : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y),
      (Limits.pullback A.right.hom (wcEtGeomPt Y y) : Scheme.{u}) :=
    fun A => ell A (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y)))
  have hlam3 : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y),
      lam A.right (pt A) = A.hom.left := by
    intro A
    have hu : ell A = σ A.right (pt A) := by
      apply huniq
      · exact Limits.pullback.lift_snd _ _ _
      · rfl
    show σ A.right (pt A) ≫ Limits.pullback.fst A.right.hom (wcEtGeomPt Y y) = A.hom.left
    rw [← hu]
    exact Limits.pullback.lift_fst _ _ _

  let nb : ∀ (V : Y.Etale) (w : ((wcEtBaseChange (wcEtGeomPt Y y)).obj V).left),
      StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y) :=
    fun V w => StructuredArrow.mk (Y := V)
      (Over.homMk (lam V w) (hlam1 V w) :
        Over.mk (wcEtGeomPt Y y) ⟶ (Scheme.Etale.forget Y).obj V)
  let germ : ∀ (V : Y.Etale) (w : ((wcEtBaseChange (wcEtGeomPt Y y)).obj V).left),
      F.obj.obj (Opposite.op V) →+ (wcEtStalk Y y).obj F :=
    fun V w => (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
      (Scheme.Etale.forget Y)).op ⋙ F.obj) (Opposite.op (nb V w))).hom
  have hdisc : ∀ V : Y.Etale, DiscreteTopology ((wcEtBaseChange (wcEtGeomPt Y y)).obj V).left := by
    intro V
    haveI : Etale ((wcEtBaseChange (wcEtGeomPt Y y)).obj V).hom :=
      ((wcEtBaseChange (wcEtGeomPt Y y)).obj V).prop
    exact Hdisc (AlgebraicClosure (Y.residueField y)) ((wcEtBaseChange (wcEtGeomPt Y y)).obj V).hom
  let αapp : ∀ V : Y.Etale, F.obj.obj (Opposite.op V) →+
      LocallyConstant ((wcEtBaseChange (wcEtGeomPt Y y)).obj V).left ((wcEtStalk Y y).obj F) :=
    fun V =>
      { toFun := fun s => ⟨fun w => germ V w s,
          @IsLocallyConstant.of_discrete _ _ _ (hdisc V) (fun w => germ V w s)⟩
        map_zero' := by
          apply LocallyConstant.ext
          intro w
          show germ V w 0 = 0
          exact map_zero (germ V w)
        map_add' := by
          intro a b
          apply LocallyConstant.ext
          intro w
          show germ V w (a + b) = germ V w a + germ V w b
          exact map_add (germ V w) a b }
  let α : F.obj ⟶ wcLCPb (wcEtGeomPt Y y) ((wcEtStalk Y y).obj F) :=
    { app := fun V => AddCommGrpCat.ofHom (αapp V.unop)
      naturality := by
        intro V₁ V₂ f
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro s
        apply LocallyConstant.ext
        intro w'
        show germ V₂.unop w' ((F.obj.map f).hom s) =
          germ V₁.unop (hm V₁.unop V₂.unop f.unop w') s
        exact Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
            (Scheme.Etale.forget Y)).op ⋙ F.obj)
          (StructuredArrow.homMk (f := nb V₂.unop w')
            (f' := nb V₁.unop (hm V₁.unop V₂.unop f.unop w')) f.unop
            (Over.OverMorphism.ext (by exact (hlam2 _ _ f.unop w').symm))).op s }
  refine ⟨α, pt, fun A s => ?_⟩
  show germ A.right (pt A) s = _
  let φ : A ⟶ nb A.right (pt A) := StructuredArrow.homMk (𝟙 A.right)
    (Over.OverMorphism.ext (by
      show A.hom.left ≫ ((Scheme.Etale.forget Y).map (𝟙 A.right)).left = lam A.right (pt A)
      rw [CategoryTheory.Functor.map_id, Over.id_left, Category.comp_id, hlam3]))
  have hw := Limits.colimit.w_apply ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
    (Scheme.Etale.forget Y)).op ⋙ F.obj) φ.op s
  have hid : ((((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
      (Scheme.Etale.forget Y)).op ⋙ F.obj).map φ.op).hom s) = s := by
    show (F.obj.map (𝟙 (Opposite.op A.right))).hom s = s
    rw [CategoryTheory.Functor.map_id]
    rfl
  refine Eq.trans hw.symm ?_
  exact congrArg (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y))
    (Scheme.Etale.forget Y)).op ⋙ F.obj) (Opposite.op A)).hom hid

theorem wc_et_stalk_injective_of_eval : ∀ {Y : Scheme.{u}} (y : Y) {F G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (u : F ⟶ G) (ev : ∀ A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y), G.obj.obj (Opposite.op A.right) → (wcEtStalk Y y).obj F), (∀ A, ev A 0 = 0) → (∀ (A : StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (s : F.obj.obj (Opposite.op A.right)), ev A ((u.hom.app (Opposite.op A.right)).hom s) = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)).op ⋙ F.obj) (Opposite.op A)).hom s) → Function.Injective ((wcEtStalk Y y).map u).hom :=
by
  intro Y y F G u ev hev0 hev
  classical
  let X₀ : Over Y := Over.mk (wcEtGeomPt Y y)
  haveI : IsCofiltered (StructuredArrow X₀ (Scheme.Etale.forget Y)) :=
    IsCofiltered.of_hasFiniteLimits _
  haveI : Limits.PreservesFilteredColimitsOfSize.{u, u+1} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
  refine (injective_iff_map_eq_zero _).mpr ?_
  intro x hx
  let DF := (StructuredArrow.proj X₀ (Scheme.Etale.forget Y)).op ⋙ F.obj
  let DG := (StructuredArrow.proj X₀ (Scheme.Etale.forget Y)).op ⋙ G.obj
  let α := Functor.whiskerLeft (StructuredArrow.proj X₀ (Scheme.Etale.forget Y)).op u.hom
  obtain ⟨j, s, rfl⟩ := Limits.Concrete.colimit_exists_rep DF x
  have e1 := Limits.colimit.ι_map_apply α j s
  have h1 : (Limits.colimit.ι DG j).hom ((α.app j).hom s) = (Limits.colimit.ι DG j).hom 0 := by
    rw [map_zero]
    exact e1.symm.trans hx
  obtain ⟨k, f, g, hfg⟩ := Limits.Concrete.colimit_exists_of_rep_eq DG _ _ h1
  rw [map_zero] at hfg
  have e2 := NatTrans.naturality_apply α f s
  have h2 : (α.app k).hom ((DF.map f).hom s) = 0 := e2.trans hfg
  have h3 : (Limits.colimit.ι DF k).hom ((DF.map f).hom s) = 0 := by
    have hk := hev k.unop ((DF.map f).hom s)
    have hk' : ev k.unop ((α.app k).hom ((DF.map f).hom s)) =
        (Limits.colimit.ι DF k).hom ((DF.map f).hom s) := hk
    rw [← hk', h2]
    exact hev0 k.unop
  rw [← Limits.colimit.w_apply DF f s]
  exact h3

theorem wc_et_lc_pb_sheaf_iso : ∀ {X Y : Scheme.{u}} (a : X ⟶ Y) (A : Type (u+1)) [AddCommGroup A], ∃ (h : Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) (wcLCPb a A)), Nonempty ((⟨wcLCPb a A, h⟩ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) ≅ (wcEtPush a).obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of A))) ∧ ∀ ℓ : ℕ, (∀ m : A, ℓ • m = 0) → ℓ • 𝟙 ((wcEtPush a).obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of A))) = 0 :=
by
  intro X Y a A _
  haveI : (wcEtBaseChange a).IsContinuous (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology X) := wc_et_basechange_isContinuous a
  have h : Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) (wcLCPb a A) :=
    Functor.op_comp_isSheaf (wcEtBaseChange a) (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology X) ⟨wcEtLC X A, wc_et_lc_isSheaf X A⟩
  let S : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} := ⟨wcLCPb a A, h⟩
  obtain ⟨e₀⟩ := wc_et_push_const_lc_iso a A (wc_et_lc_isSheaf X A) (wc_et_const_to_lc_locBij X A)
  let e : S ≅ (wcEtPush a).obj ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of A)) := (sheafificationIso S).trans e₀
  refine ⟨h, ⟨e⟩, fun ℓ hA => ?_⟩
  have key : ∀ U (x : S.obj.obj U), ℓ • x = 0 := by
    intro U x
    let y : LocallyConstant ((wcEtBaseChange a).obj U.unop).left A := x
    have hy : ℓ • y = 0 :=
      LocallyConstant.ext fun w => by rw [LocallyConstant.smul_apply]; exact hA (y w)
    exact hy
  have hS : ℓ • 𝟙 S = 0 := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    exact key U x
  calc ℓ • 𝟙 _ = e.inv ≫ (ℓ • 𝟙 S) ≫ e.hom := by
        rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Iso.inv_hom_id]
    _ = 0 := by rw [hS, Limits.zero_comp, Limits.comp_zero]

theorem wc_et_geom_point_skyscraper_embed : ∀ (Y : Scheme.{u}) (ℓ : ℕ) (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), ℓ • 𝟙 F = 0 → ∀ (k : ℕ) (y : Fin k → Y), ∃ (M : Fin k → AddCommGrpCat.{u+1}) (u : F ⟶ ⨁ (fun i => (wcEtPush (wcEtGeomPt Y (y i))).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (AlgebraicClosure (Y.residueField (y i)))))) AddCommGrpCat.{u+1}).obj (M i)))), (∀ i (m : M i), ℓ • m = 0) ∧ ℓ • 𝟙 (⨁ (fun i => (wcEtPush (wcEtGeomPt Y (y i))).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (AlgebraicClosure (Y.residueField (y i)))))) AddCommGrpCat.{u+1}).obj (M i)))) = 0 ∧ ∀ i, Subsingleton ((wcEtStalk Y (y i)).obj (Limits.kernel u)) :=
by
  intro Y ℓ F hF k y
  classical
  have hcomp : ∀ i : Fin k, ∃ (ui : F ⟶ (wcEtPush (wcEtGeomPt Y (y i))).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (AlgebraicClosure (Y.residueField (y i)))))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of ((wcEtStalk Y (y i)).obj F)))),
      Function.Injective ((wcEtStalk Y (y i)).map ui).hom ∧
      (∀ m : AddCommGrpCat.of ((wcEtStalk Y (y i)).obj F), ℓ • m = 0) ∧
      ℓ • 𝟙 ((wcEtPush (wcEtGeomPt Y (y i))).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (AlgebraicClosure (Y.residueField (y i)))))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of ((wcEtStalk Y (y i)).obj F)))) = 0 := by
    intro i

    have hMt : ∀ m : (wcEtStalk Y (y i)).obj F, ℓ • m = 0 := by
      intro m
      haveI hadd : (wcEtStalk Y (y i)).Additive := by
        first
        | infer_instance
        | exact inferInstanceAs (Functor.Additive (_ ⋙ _ ⋙ Limits.colim))
      have h1 : (wcEtStalk Y (y i)).map (ℓ • 𝟙 F) = ℓ • 𝟙 ((wcEtStalk Y (y i)).obj F) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rw [hF, CategoryTheory.Functor.map_zero] at h1
      have h2 := congrArg (fun f => f.hom m) h1
      first
      | simpa using h2.symm
      | (simp only [AddCommGrpCat.hom_zero, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
          AddMonoidHom.zero_apply, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply] at h2
         exact h2.symm)

    obtain ⟨h, ⟨e⟩, htor⟩ := wc_et_lc_pb_sheaf_iso (wcEtGeomPt Y (y i)) ((wcEtStalk Y (y i)).obj F)

    obtain ⟨α, pt, hα⟩ := wc_et_geom_germ_lc_hom wc_spec_field_section_eq_of_point_eq
      wc_etale_over_field_discrete Y (y i) F
    let v : F ⟶ (⟨wcLCPb (wcEtGeomPt Y (y i)) ((wcEtStalk Y (y i)).obj F), h⟩ :
        Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := by
      first
      | exact ObjectProperty.homMk α
      | exact ⟨α⟩

    have hv : Function.Injective ((wcEtStalk Y (y i)).map v).hom :=
      wc_et_stalk_injective_of_eval (y i) v
        (fun A g => (@id (LocallyConstant ((wcEtBaseChange (wcEtGeomPt Y (y i))).obj A.right).left
          ((wcEtStalk Y (y i)).obj F)) g) (pt A))
        (fun A => by
          first
          | rfl
          | simp
          | exact LocallyConstant.zero_apply _)
        (fun A s => hα A s)
    have he : Function.Injective ((wcEtStalk Y (y i)).map e.hom).hom := by
      first
      | exact ((wcEtStalk Y (y i)).mapIso e).addCommGroupIsoToAddEquiv.injective
      | exact (AddCommGrpCat.mono_iff_injective _).mp inferInstance
      | (intro a b hab
         have h1 := congrArg ((wcEtStalk Y (y i)).map e.inv).hom hab
         simpa only [← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp, ← Functor.map_comp,
           Iso.hom_inv_id, Functor.map_id, AddCommGrpCat.hom_id, AddMonoidHom.id_apply] using h1)
    have hinj : Function.Injective ((wcEtStalk Y (y i)).map (v ≫ e.hom)).hom := by
      first
      | (rw [Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp]; exact he.comp hv)
      | (intro a b hab; apply hv; apply he; simpa using hab)
    exact ⟨v ≫ e.hom, hinj, hMt, htor ℓ hMt⟩
  choose uu huinj hMt hTt using hcomp
  refine ⟨fun i => AddCommGrpCat.of ((wcEtStalk Y (y i)).obj F), Limits.biproduct.lift uu, hMt, ?_, ?_⟩
  · refine Limits.biproduct.hom_ext _ _ (fun j => ?_)
    have h2 : Limits.biproduct.π (fun i => (wcEtPush (wcEtGeomPt Y (y i))).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of (AlgebraicClosure (Y.residueField (y i)))))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of ((wcEtStalk Y (y i)).obj F)))) j ≫ (ℓ • 𝟙 _) = 0 := by
      rw [hTt j, Limits.comp_zero]
    first
    | simpa [Preadditive.nsmul_comp, Preadditive.comp_nsmul] using h2
    | (rw [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp]
       rw [Preadditive.comp_nsmul, Category.comp_id] at h2
       exact h2)
  · intro i
    apply wc_et_stalk_kernel_subsingleton
    have h1 := Limits.biproduct.lift_π uu i
    have h2 := huinj i
    rw [← h1] at h2
    first
    | (rw [Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp] at h2
       exact Function.Injective.of_comp h2)
    | (intro a b hab
       apply h2
       simp only [Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
       rw [hab])

theorem wc_quot_strictly_henselian : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsNoetherianRing A] (A' : Type u) [CommRing A'] [Nontrivial A'] (φ : A →+* A'), Function.Surjective φ → ∃ (h : HenselianLocalRing A'), IsSepClosed (@IsLocalRing.ResidueField A' _ h.toIsLocalRing) ∧ IsNoetherianRing A' :=
by
  intro A _ _ _ _ A' _ _ φ hφ
  letI inst : IsLocalRing A' := IsLocalRing.of_surjective' φ hφ
  haveI hloc : IsLocalHom φ := IsLocalHom.of_surjective φ hφ
  let hH : HenselianLocalRing A' :=
    { toIsLocalRing := inst
      is_henselian := by
        intro f hf a₀' h1 h2
        have hlift : f ∈ Polynomial.lifts φ := by
          rw [Polynomial.lifts_iff_coeff_lifts]
          intro n
          exact hφ _
        obtain ⟨F, hFmap, -, hFmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hf
        obtain ⟨a₀, rfl⟩ := hφ a₀'
        have e1 : φ (F.eval a₀) = f.eval (φ a₀) := by
          rw [← hFmap, Polynomial.eval_map_apply]
        have e2 : φ ((Polynomial.derivative F).eval a₀) =
            (Polynomial.derivative f).eval (φ a₀) := by
          rw [← hFmap, Polynomial.derivative_map, Polynomial.eval_map_apply]
        have h1' : F.eval a₀ ∈ IsLocalRing.maximalIdeal A := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro hu
          have hu' := hu.map φ
          rw [e1] at hu'
          exact ((IsLocalRing.mem_maximalIdeal _).mp h1) hu'
        have h2' : IsUnit ((Polynomial.derivative F).eval a₀) := by
          apply isUnit_of_map_unit φ
          rw [e2]
          exact h2
        obtain ⟨a, ha, ham⟩ := HenselianLocalRing.is_henselian F hFmon a₀ h1' h2'
        refine ⟨φ a, ?_, ?_⟩
        · have ha0 : F.eval a = 0 := ha
          show Polynomial.eval (φ a) f = 0
          rw [← hFmap, Polynomial.eval_map_apply, ha0, map_zero]
        · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← map_sub]
          intro hu
          exact ((IsLocalRing.mem_maximalIdeal _).mp ham) (isUnit_of_map_unit φ _ hu) }
  have hSC : IsSepClosed (IsLocalRing.ResidueField A') := by
    let ψ : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField A' :=
      IsLocalRing.ResidueField.map φ
    have hsurj : Function.Surjective ψ := by
      intro y
      obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨c, rfl⟩ := hφ b
      exact ⟨IsLocalRing.residue A c, IsLocalRing.ResidueField.map_residue φ c⟩
    let e : IsLocalRing.ResidueField A ≃+* IsLocalRing.ResidueField A' :=
      RingEquiv.ofBijective ψ ⟨ψ.injective, hsurj⟩
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    let q := p.map (e.symm : IsLocalRing.ResidueField A' →+* IsLocalRing.ResidueField A)
    have hq : q.map (e : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField A') = p := by
      simp only [q, Polynomial.map_map]
      convert Polynomial.map_id
      ext x
      simp
    have hdeg : q.degree ≠ 0 := by
      rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    have hqsep : q.Separable := by
      rw [← Polynomial.separable_map (e : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField A'), hq]
      exact hsep
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root q hdeg hqsep
    refine ⟨e x, ?_⟩
    have hx0 : q.eval x = 0 := hx
    rw [← hq]
    show Polynomial.eval ((e : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField A') x) _ = 0
    rw [Polynomial.eval_map_apply, hx0, map_zero]
  refine ⟨hH, ?_, isNoetherianRing_of_surjective A A' φ hφ⟩
  convert hSC

theorem wc_et_pull_const_zmod : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (L : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → Limits.PreservesFiniteLimits L → ∀ (e : L.obj (wcZSh Y) ≅ wcZSh X) (m : ℕ), (∀ q : ℕ, Nonempty (wcEtCoh X m q ≃ wcEtExt X (L.obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) q)) ∧ m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) = 0 :=
by
  intro X Y g L hadj _ e m
  obtain ⟨adj⟩ := hadj
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits L := Limits.PreservesColimitsOfSize.preservesFiniteColimits L

  let A := AddCommGrpCat.of (ULift.{u+1} ℤ)
  let Q := AddCommGrpCat.of (ULift.{u+1} (ZMod m))
  let f : A ⟶ A := ((m : ℤ)) • 𝟙 A
  let ψ : ULift.{u+1} ℤ →+ ULift.{u+1} (ZMod m) :=
    (AddEquiv.ulift.symm.toAddMonoidHom.comp (Int.castAddHom (ZMod m))).comp
      AddEquiv.ulift.toAddMonoidHom
  have hψ : ∀ x, ψ x = ULift.up ((x.down : ℤ) : ZMod m) := fun x => rfl
  let p : A ⟶ Q := AddCommGrpCat.ofHom ψ
  have hf : ∀ x, f.hom x = (m : ℤ) • x := fun x => rfl
  have w : f ≫ p = 0 := by
    apply AddCommGrpCat.ext
    intro x
    change ψ (f.hom x) = 0
    rw [hf, hψ]
    apply ULift.ext
    change (((((m : ℤ) • x).down : ℤ)) : ZMod m) = 0
    rw [ULift.smul_down]
    simp
  have hepi : Epi p := by
    rw [AddCommGrpCat.epi_iff_surjective]
    intro y
    obtain ⟨z, hz⟩ := ZMod.intCast_surjective y.down
    exact ⟨ULift.up z, by change ψ _ = _; rw [hψ]; exact ULift.ext _ _ hz⟩
  have hc : Limits.IsColimit (Limits.CokernelCofork.ofπ p w) := by
    refine Limits.CokernelCofork.IsColimit.ofπ' p w (fun {B} k hk => ?_)
    let κ : ℤ →+ B := k.hom.comp AddEquiv.ulift.symm.toAddMonoidHom
    have hκ : κ ((m : ℕ) : ℤ) = 0 := by
      have h1 : (f ≫ k).hom (ULift.up 1) = 0 := by rw [hk]; rfl
      change k.hom (ULift.up ((m : ℕ) : ℤ)) = 0
      rw [← h1]
      change _ = k.hom (f.hom (ULift.up 1))
      rw [hf]
      congr 1
      apply ULift.ext
      change ((m : ℕ) : ℤ) = ((m : ℤ) • ULift.up.{u+1} (1 : ℤ)).down
      rw [ULift.smul_down]
      simp
    refine ⟨AddCommGrpCat.ofHom ((ZMod.lift m ⟨κ, hκ⟩).comp AddEquiv.ulift.toAddMonoidHom), ?_⟩
    ext x
    change (ZMod.lift m ⟨κ, hκ⟩) ((x.down : ℤ) : ZMod m) = k.hom x
    rw [ZMod.lift_coe]
    rfl
  let φ : Limits.cokernel f ≅ Q :=
    Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel f) hc
  have key : ∀ {Z : Scheme.{u}} (G : AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      [G.Additive] [Limits.PreservesFiniteColimits G],
      Nonempty (G.obj Q ≅ Limits.cokernel ((m : ℤ) • 𝟙 (G.obj A))) := by
    intro Z G _ _
    have h1 : G.map f = (m : ℤ) • 𝟙 (G.obj A) := by
      rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_id]
    exact ⟨G.mapIso φ.symm ≪≫ Limits.PreservesCokernel.iso G f ≪≫
      Limits.cokernel.mapIso _ _ (Iso.refl _) (Iso.refl _) (by rw [h1]; simp)⟩
  obtain ⟨α⟩ := key (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙ L)
  obtain ⟨β⟩ := key (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
  have hδ : ((m : ℤ) • 𝟙 _) ≫ e.hom = e.hom ≫ ((m : ℤ) • 𝟙 _) := by
    rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, Category.id_comp, Category.comp_id]
  let i : L.obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj Q) ≅
      (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj Q :=
    α ≪≫ Limits.cokernel.mapIso _ _ e e hδ ≪≫ β.symm
  refine ⟨fun q => ?_, ?_⟩
  · letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    let E : Abelian.Ext (wcZSh X) ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj Q) q ≃
        Abelian.Ext (wcZSh X) (L.obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj Q)) q :=
      { toFun := fun x => x.comp (Abelian.Ext.mk₀ i.inv) (add_zero q)
        invFun := fun y => y.comp (Abelian.Ext.mk₀ i.hom) (add_zero q)
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id] }
    exact ⟨E⟩
  · have h0 : (m • 𝟙 Q : Q ⟶ Q) = 0 := by
      apply AddCommGrpCat.ext
      intro x
      change m • x = 0
      apply ULift.ext
      change m • x.down = 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, h0,
      CategoryTheory.Functor.map_zero]

theorem wc_et_affine_line_acyclic_of_local_acyclicity : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) (q : ℕ), Subsingleton (wcEtExt (Spec (.of A)) F (q + 1))) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ℓ : ℕ), ℓ.Prime → (ℓ : Ω) ≠ 0 → Nat.card (wcEtCoh (Spec (.of (Polynomial Ω))) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Spec (.of (Polynomial Ω))) ℓ q)) → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ q)) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] [IsNoetherianRing A] (s : Spec (.of A) ⟶ Spec (.of K)) (q : ℕ), 1 ≤ q → Subsingleton (wcEtCoh (wcHalA1 s) ℓ q) :=
by
  intro K _ _ ℓ hℓ hℓK H1 H2 H3 A _ _ _ _ s q hq
  classical

  have key : ∀ (J : Ideal A) (A' : Type u) [CommRing A'] [Nontrivial A'] (φ : A →+* A'),
      Function.Surjective φ → RingHom.ker φ = J →
      ∀ (s' : Spec (.of A') ⟶ Spec (.of K))
        (L' : Sheaf (Scheme.smallEtaleTopology (Spec (.of A'))) AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.smallEtaleTopology (wcHalA1 s')) AddCommGrpCat.{u+1}),
        Nonempty (L' ⊣ wcEtPush (wcHalA1Proj s')) → Limits.PreservesFiniteLimits L' →
        ∀ (e' : L'.obj (wcZSh (Spec (.of A'))) ≅ wcZSh (wcHalA1 s'))
          (F : Sheaf (Scheme.smallEtaleTopology (Spec (.of A'))) AddCommGrpCat.{u+1}),
          ℓ • 𝟙 F = 0 → ∀ n, wcHalAcyc L' e' F n := by
    intro J
    induction J using WellFoundedGT.induction
    rename_i J ih
    intro A' _ _ φ hφ hker s' L' hadj' hL' e'

    obtain ⟨hH, hS, hN⟩ := wc_quot_strictly_henselian A A' φ hφ
    letI := hH
    haveI := hS
    haveI := hN

    have IH : ∀ (I : Ideal A'), (∀ 𝔮 ∈ minimalPrimes A', ¬ I ≤ 𝔮) → Nontrivial (A' ⧸ I) →
        ∀ (L'' : Sheaf (Scheme.smallEtaleTopology (Spec (.of (A' ⧸ I)))) AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.smallEtaleTopology
            (wcHalA1 (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ s'))) AddCommGrpCat.{u+1}),
        Nonempty (L'' ⊣ wcEtPush (wcHalA1Proj (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ s'))) →
        Limits.PreservesFiniteLimits L'' →
        ∀ (e'' : L''.obj (wcZSh (Spec (.of (A' ⧸ I)))) ≅
            wcZSh (wcHalA1 (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ s')))
          (E : Sheaf (Scheme.smallEtaleTopology (Spec (.of (A' ⧸ I)))) AddCommGrpCat.{u+1}),
          ℓ • 𝟙 E = 0 → ∀ n, wcHalAcyc L'' e'' E n := by
      intro I hI hnt L'' hadj'' hL'' e'' E hE n
      haveI := hnt
      have hlt : J < I.comap φ := by
        rw [← hker]
        have h1 : RingHom.ker φ = (⊥ : Ideal A').comap φ := by
          ext x
          simp [RingHom.mem_ker]
        rw [h1]
        refine lt_of_le_of_ne (Ideal.comap_mono bot_le) ?_
        intro heq
        have hIb : I = ⊥ := (Ideal.comap_injective_of_surjective φ hφ heq).symm
        obtain ⟨𝔮, h𝔮, -⟩ :=
          Ideal.exists_minimalPrimes_le (bot_le : (⊥ : Ideal A') ≤ IsLocalRing.maximalIdeal A')
        exact hI 𝔮 h𝔮 (by rw [hIb]; exact bot_le)
      have hkerI : RingHom.ker ((Ideal.Quotient.mk I).comp φ) = I.comap φ := by
        ext x
        simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
      exact ih (I.comap φ) hlt (A' ⧸ I) ((Ideal.Quotient.mk I).comp φ)
        (Ideal.Quotient.mk_surjective.comp hφ) hkerI _ L'' hadj'' hL'' e'' E hE n

    have hfin := minimalPrimes.finite_of_isNoetherianRing A'
    let S := hfin.toFinset
    let f : Fin S.card ≃ S := S.equivFin.symm
    let y : Fin S.card → Spec (.of A') := fun i =>
      (⟨(f i).1, Ideal.minimalPrimes_isPrime (hfin.mem_toFinset.mp (f i).2)⟩ : PrimeSpectrum A')
    intro F hF
    refine wc_hal_acyc_of_good_embeddings K A' s' ℓ L' hadj' hL' e' ?_ F hF
    intro F₀ hF₀
    obtain ⟨M, uF, hM, hG, hstalk⟩ :=
      wc_et_geom_point_skyscraper_embed (Spec (.of A')) ℓ F₀ hF₀ S.card y
    refine ⟨_, uF, hG, ?_, ?_⟩
    ·
      intro n
      apply (wc_hal_acyc_colim K A' s' L' hadj' hL' e' n).2.2 S.card
      intro i
      have h1 := wc_hal_geom_push_good K ℓ hℓ hℓK H2 H3 A' s' L' hadj' hL' e'
        (AlgebraicClosure ((Spec (.of A')).residueField (y i))) (wcEtGeomPt (Spec (.of A')) (y i))
      exact wc_hal_geom_push_good_const K ℓ hℓ A' s' L' hadj' hL' e'
        (AlgebraicClosure ((Spec (.of A')).residueField (y i))) (wcEtGeomPt (Spec (.of A')) (y i))
        h1 (M i) (hM i) n
    ·
      have hKt : ℓ • 𝟙 (Limits.kernel uF) = 0 := by
        rw [← cancel_mono (Limits.kernel.ι uF), Limits.zero_comp, Preadditive.nsmul_comp,
          Category.id_comp]
        calc ℓ • Limits.kernel.ι uF = Limits.kernel.ι uF ≫ (ℓ • 𝟙 F₀) := by
              rw [Preadditive.comp_nsmul, Category.comp_id]
          _ = 0 := by rw [hF₀, Limits.comp_zero]
      have hgen : ∀ (𝔭 : PrimeSpectrum A'), 𝔭.asIdeal ∈ minimalPrimes A' →
          Subsingleton ((wcEtStalk (Spec (.of A')) 𝔭).obj (Limits.kernel uF)) := by
        intro 𝔭 h𝔭
        have hmem : 𝔭.asIdeal ∈ S := hfin.mem_toFinset.mpr h𝔭
        have hy : y (f.symm ⟨𝔭.asIdeal, hmem⟩) = 𝔭 := by
          apply PrimeSpectrum.ext
          show (f (f.symm ⟨𝔭.asIdeal, hmem⟩)).1 = 𝔭.asIdeal
          rw [Equiv.apply_symm_apply]
        have h2 := hstalk (f.symm ⟨𝔭.asIdeal, hmem⟩)
        rw [hy] at h2
        exact h2
      obtain ⟨J', instJ, instF, D, c, ⟨hc⟩, ⟨ec⟩, hD⟩ :=
        wc_et_generic_vanish_decomp A' ℓ (Limits.kernel uF) hKt hgen
      intro n
      have hDj : ∀ j, wcHalAcyc L' e' (D.obj j) n := by
        intro j
        obtain ⟨I, E, hI, hE, ⟨eD⟩⟩ := hD j
        have h4 := wc_hal_acyc_closed_push K A' s' L' hadj' hL' e' (A' ⧸ I) (Ideal.Quotient.mk I)
          Ideal.Quotient.mk_surjective E (by
            by_cases hsub : Subsingleton (A' ⧸ I)
            · exact Or.inl hsub
            · right
              haveI : Nontrivial (A' ⧸ I) := not_subsingleton_iff_nontrivial.mp hsub
              intro L'' hadj'' hL'' e'' m
              exact IH I hI inferInstance L'' hadj'' hL'' e'' E hE m) n
        exact (wc_hal_acyc_colim K A' s' L' hadj' hL' e' n).2.1 _ _ eD.symm h4
      have hcpt := (wc_hal_acyc_colim K A' s' L' hadj' hL' e' n).1 J' D c hc hDj
      exact (wc_hal_acyc_colim K A' s' L' hadj' hL' e' n).2.1 _ _ ec hcpt

  obtain ⟨L, ⟨adj⟩, hL, ⟨e⟩⟩ := wc_et_push_left_adjoint (wcHalA1Proj s)
  obtain ⟨hE, hΛ⟩ := wc_et_pull_const_zmod (wcHalA1Proj s) L ⟨adj⟩ hL e ℓ
  have hker0 : RingHom.ker (RingHom.id A) = ⊥ := by
    ext x
    simp [RingHom.mem_ker]
  have hac := key ⊥ A (RingHom.id A) Function.surjective_id hker0 s L ⟨adj⟩ hL e _ hΛ q
  haveI := hac.2 q hq le_rfl
  obtain ⟨eq⟩ := hE q
  with_reducible exact eq.subsingleton

theorem wc_et_henselian_affine_line_acyclic : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (q : ℕ), 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback s (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ℓ q) :=
by
  intro K _ _ ℓ hℓ hℓK

  have H3 : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s),
      IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A →
      ∀ (B : Type u) [CommRing B] [HenselianLocalRing B]
        [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
        (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x))
          (Scheme.Etale.forget (wcHalA1 s)))
        (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s),
        wcHalShData x B Λ W' φ a →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)),
        Nat.card (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ 0) = ℓ ∧
        ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ q) := by
    intro A _ _ _ s x hx hxc B _ _ _ Λ _ _ W' φ a hd Ω _ _ z
    refine ⟨wc_et_milnor_fibre_connected K ℓ hℓ hℓK A s x hx hxc B Λ W' φ a hd Ω z,
      fun q hq => ?_⟩
    rcases Nat.lt_or_ge q 2 with h | h
    · obtain rfl : q = 1 := by omega
      exact wc_et_milnor_fibre_h1_vanishing K ℓ hℓ hℓK A s x hx hxc B Λ W' φ a hd Ω z
    · exact wc_et_milnor_fibre_cd_one K ℓ hℓ hℓK A s x hx hxc B Λ W' φ a hd Ω z q h

  have hnoeth := wc_et_affine_line_acyclic_of_local_acyclicity K ℓ hℓ hℓK
    wc_et_strictly_local_ext_vanishing wc_et_algclosed_affine_line_acyclic H3

  exact wc_et_affine_line_acyclic_noetherian_reduction K ℓ hℓ hℓK hnoeth

theorem wc_et_coh_affine_line_invariance : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [LocallyOfFiniteType fX] (q : ℕ), Nonempty (wcEtCoh (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ℓ q ≃ wcEtCoh X ℓ q) :=
by
  classical
  intro K _ _ ℓ hℓ hℓK X fX _ q

  haveI hπaff : IsAffineHom (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback fX _).flip inferInstance

  obtain ⟨L, ⟨adj⟩, hPFL, ⟨eℤ⟩⟩ := wc_et_push_left_adjoint (Limits.pullback.fst fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
  haveI := hPFL
  haveI : L.Additive := adj.left_adjoint_additive
  haveI : (wcEtPush (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))).Additive :=
    adj.right_adjoint_additive
  haveI := wc_et_enough_injectives (Limits.pullback fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  let I := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))

  have hvan : ∀ n : ℕ, 1 ≤ n → Limits.IsZero ((((wcEtPush (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology n) := by
    intro n hn
    apply wc_et_stalks_zero
    intro b
    obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, -, -⟩ :=
      wc_et_geom_strict_henselization b
    obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) b Λ W' hinit I.cocomplex n
    obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) A Λ
      (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt X b)) (Scheme.Etale.forget X)) φ a
      haff hφ hφa hlim ℓ I n
    obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
      ((Limits.pullbackSymmetry (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) a).hom ≫
        (Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) a).hom) ℓ n
    haveI := wc_et_henselian_affine_line_acyclic K ℓ hℓ hℓK A (a ≫ fX) n hn
    exact (E₁.trans (E₂.trans E₃.symm)).subsingleton

  obtain ⟨E₄⟩ := wc_ext_degenerate_leray_equiv L (wcEtPush (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) adj
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) I hvan q

  obtain ⟨e₂⟩ := wc_et_affine_line_push_const_iso K X fX ℓ

  let E₅ : Abelian.Ext (L.obj ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))))
      ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q ≃
      Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q :=
    { toFun := fun x => (Abelian.Ext.mk₀ eℤ.inv).comp x (zero_add q)
      invFun := fun y => (Abelian.Ext.mk₀ eℤ.hom).comp y (zero_add q)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] }
  let E₆ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((wcEtPush (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))).obj
        ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) q ≃
      Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q :=
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ e₂.hom) (add_zero q)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ e₂.inv) (add_zero q)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
  exact ⟨E₅.symm.trans (E₄.symm.trans E₆)⟩

theorem wc_et_affine_space_coh_vanishing : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (n q : ℕ), 1 ≤ q → Subsingleton (wcEtCoh (Spec (.of (MvPolynomial (Fin n) K))) ℓ q) :=
by
  intro K _ _ ℓ hℓ hℓK n
  induction n with
  | zero =>
    intro q hq
    let e₀ : Spec (.of K) ≅ Spec (.of (MvPolynomial (Fin 0) K)) :=
      Scheme.Spec.mapIso ((MvPolynomial.isEmptyRingEquiv K (Fin 0)).toCommRingCatIso.op)
    obtain ⟨E⟩ := wc_et_coh_iso_invariance e₀.hom ℓ q
    have hdim0 : topologicalKrullDim (Spec (.of K)) = 0 := by
      show topologicalKrullDim (PrimeSpectrum K) = 0
      rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim, ringKrullDim_eq_zero_of_field]
    have hdim : topologicalKrullDim (Spec (.of K)) ≤ ((0 : ℕ) : WithBot ℕ∞) := by
      rw [hdim0]; simp
    haveI := wc_et_zero_dim_vanishing K (Spec (.of K)) (𝟙 _) hdim ℓ hℓ.ne_zero q (by omega)
    exact E.subsingleton
  | succ n ih =>
    intro q hq
    let eₙ : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K))))
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≅
        Spec (.of (MvPolynomial (Fin (n + 1)) K)) :=
      pullbackSpecIso K (MvPolynomial (Fin n) K) (Polynomial K) ≪≫
        Scheme.Spec.mapIso (((MvPolynomial.finSuccEquiv K n).trans
          (polyEquivTensor K (MvPolynomial (Fin n) K))).toRingEquiv.toCommRingCatIso.op)
    obtain ⟨E₁⟩ := wc_et_coh_iso_invariance eₙ.hom ℓ q
    haveI : LocallyOfFiniteType
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) := by
      rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
      exact RingHom.finiteType_algebraMap.mpr inferInstance
    obtain ⟨E₂⟩ := wc_et_coh_affine_line_invariance K ℓ hℓ hℓK _
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) q
    haveI := ih q hq
    exact (E₁.trans E₂).subsingleton

theorem wc_proj_linear_auto_iso : ∀ (K : Type u) [Field K] (d : ℕ) (L M : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K), (∀ i, (L i).IsHomogeneous 1) → (∀ i, (M i).IsHomogeneous 1) → (∀ i, MvPolynomial.aeval L (M i) = MvPolynomial.X i) → (∀ i, MvPolynomial.aeval M (L i) = MvPolynomial.X i) → ∃ g : wcProjK K d ⟶ wcProjK K d, IsIso g ∧ ∀ i : Fin (d + 1), g ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X i)) = @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (L i) :=
by
  intro K _ d L M hL hM hLM hML
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have hcc : ∀ (N : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K), (∀ i, (N i).IsHomogeneous 1) →
      ∀ p : MvPolynomial (Fin (d + 1)) K,
        MvPolynomial.constantCoeff (MvPolynomial.aeval N p) = MvPolynomial.constantCoeff p := by
    intro N hN p
    induction p using MvPolynomial.induction_on with
    | C r => rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
    | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
    | mul_X p i hp =>
      have h0 : MvPolynomial.constantCoeff (N i) = 0 := by
        rw [MvPolynomial.constantCoeff_eq]
        exact (hN i).coeff_eq_zero (by simp)
      rw [map_mul, map_mul, map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.constantCoeff_X, h0]

  have hirr : ∀ a : MvPolynomial (Fin (d + 1)) K,
      a ∈ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) ↔
        MvPolynomial.constantCoeff a = 0 := by
    intro a
    rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
    change ((MvPolynomial.decomposition.decompose' a 0 : MvPolynomial (Fin (d + 1)) K)) = 0 ↔ _
    rw [MvPolynomial.decomposition.decompose'_apply, MvPolynomial.homogeneousComponent_zero,
      MvPolynomial.C_eq_zero, MvPolynomial.constantCoeff_eq]

  let Φ : ∀ N : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K, (∀ i, (N i).IsHomogeneous 1) →
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
    fun N hN => GradedRingHom.mk (MvPolynomial.aeval N).toRingHom (fun {n} {x} hx => by
      rw [MvPolynomial.mem_homogeneousSubmodule] at hx ⊢
      simpa using hx.aeval N hN)
  have hΦ : ∀ N hN (x : MvPolynomial (Fin (d + 1)) K), Φ N hN x = MvPolynomial.aeval N x :=
    fun _ _ _ => rfl
  have hinv : ∀ N N' : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K,
      (∀ i, MvPolynomial.aeval N (N' i) = MvPolynomial.X i) →
      ∀ x, MvPolynomial.aeval N (MvPolynomial.aeval N' x) = x := by
    intro N N' h x
    have e : (MvPolynomial.aeval N).comp (MvPolynomial.aeval N') =
        AlgHom.id K (MvPolynomial (Fin (d + 1)) K) :=
      MvPolynomial.algHom_ext (fun i => by
        rw [AlgHom.comp_apply, MvPolynomial.aeval_X, h i, AlgHom.id_apply])
    exact AlgHom.congr_fun e x
  have hcond : ∀ (N N' : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K) (hN : ∀ i, (N i).IsHomogeneous 1),
      (∀ i, (N' i).IsHomogeneous 1) →
      (∀ i, MvPolynomial.aeval N (N' i) = MvPolynomial.X i) →
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) ≤
        HomogeneousIdeal.map (Φ N hN)
          (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)) := by
    intro N N' hN hN' h a ha
    have hb : MvPolynomial.aeval N' a ∈
        HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
      (hirr _).mpr (by rw [hcc N' hN', (hirr a).mp ha])
    rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_map]
    have hm := Ideal.mem_map_of_mem (Φ N hN) (HomogeneousIdeal.mem_iff.mpr hb)
    rwa [hΦ N hN, hinv N N' h] at hm
  have hcomp : ∀ (N N' : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K)
      (hN : ∀ i, (N i).IsHomogeneous 1) (hN' : ∀ i, (N' i).IsHomogeneous 1),
      (∀ i, MvPolynomial.aeval N (N' i) = MvPolynomial.X i) →
      (Φ N hN).comp (Φ N' hN') = GradedRingHom.id _ := by
    intro N N' hN hN' h
    apply GradedRingHom.ext
    intro x
    rw [GradedRingHom.comp_apply, GradedRingHom.id_apply, hΦ N' hN', hΦ N hN, hinv N N' h]
  have key : ∀ (f : MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K →+*ᵍ
        MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) hf,
      f = GradedRingHom.id _ → Proj.map f hf = 𝟙 _ := by
    rintro f hf rfl
    exact Proj.map_id
  have hL' := hcond L M hL hM hLM
  have hM' := hcond M L hM hL hML
  refine ⟨Proj.map (Φ L hL) hL', ⟨Proj.map (Φ M hM) hM', ?_, ?_⟩, ?_⟩
  · rw [← Proj.map_comp]
    exact key _ _ (hcomp L M hL hM hLM)
  · rw [← Proj.map_comp]
    exact key _ _ (hcomp M L hM hL hML)
  · intro i
    rw [Proj.map_preimage_basicOpen, hΦ L hL, MvPolynomial.aeval_X]

theorem wc_proj_rational_point_linear_forms : ∀ (K : Type u) [Field K] (d : ℕ) (x₀ : Spec (.of K) ⟶ wcProjK K d), x₀ ≫ wcProjKStr K d = 𝟙 _ → ∃ L M : Fin (d + 1) → MvPolynomial (Fin (d + 1)) K, (∀ i, (L i).IsHomogeneous 1) ∧ (∀ i, (M i).IsHomogeneous 1) ∧ (∀ i, MvPolynomial.aeval L (M i) = MvPolynomial.X i) ∧ (∀ i, MvPolynomial.aeval M (L i) = MvPolynomial.X i) ∧ ∀ i : Fin (d + 1), i.val < d → x₀ (IsLocalRing.closedPoint K) ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (L i) :=
by
  classical
  intro K _ d x₀ hx₀
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) := MvPolynomial.gradedAlgebra
  have hX : ∀ b : Fin (d + 1), (MvPolynomial.X b : MvPolynomial (Fin (d + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1 :=
    fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K b)

  have hcover : ⨆ i, Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
      (MvPolynomial.X i : MvPolynomial (Fin (d + 1)) K) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top
    rw [HomogeneousIdeal.toIdeal_irrelevant_le]
    intro i hi p hp
    have hp' : p.IsHomogeneous i := (MvPolynomial.mem_homogeneousSubmodule i p).mp hp
    show p ∈ Ideal.span _
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    by_contra hcon
    push_neg at hcon
    have hm0 : m = 0 := Finsupp.ext fun j => hcon j (Set.mem_univ _)
    have h1 := hp' (MvPolynomial.mem_support_iff.mp hm)
    subst hm0
    simp at h1
    omega
  obtain ⟨a, ha⟩ : ∃ a : Fin (d + 1), x₀ (IsLocalRing.closedPoint K) ∈
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
        (MvPolynomial.X a : MvPolynomial (Fin (d + 1)) K) := by
    have h : x₀ (IsLocalRing.closedPoint K) ∈ (⊤ : (wcProjK K d).Opens) := trivial
    rw [← hcover, TopologicalSpace.Opens.mem_iSup] at h
    exact h

  have hrange : Set.range x₀ ⊆ Set.range (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
      (MvPolynomial.X a) (hX a) one_pos) := by
    rintro _ ⟨p, rfl⟩
    rw [show p = IsLocalRing.closedPoint K from Subsingleton.elim (α := PrimeSpectrum K) _ _]
    have h : x₀ (IsLocalRing.closedPoint K) ∈ (Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
      (MvPolynomial.X a) (hX a) one_pos).opensRange := by
      rw [Proj.opensRange_awayι]; exact ha
    exact h
  have hfac := IsOpenImmersion.lift_fac _ _ hrange
  obtain ⟨φ₀, hφ₀⟩ : ∃ φ₀, Spec.map φ₀ = IsOpenImmersion.lift _ _ hrange := ⟨_, Spec.map_preimage _⟩
  have hx₀' : x₀ = Spec.map φ₀ ≫ Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
      (MvPolynomial.X a) (hX a) one_pos := by rw [hφ₀, hfac]

  have hret : ∀ c : K, φ₀.hom (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (Submonoid.powers (MvPolynomial.X a))
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0) c)) = c := by
    have h1 : Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (Submonoid.powers (MvPolynomial.X a))) ≫ φ₀) =
        Spec.map (𝟙 (CommRingCat.of K)) := by
      rw [Spec.map_id, ← hx₀, hx₀']
      simp only [Spec.map_comp, Category.assoc, wcProjKStr]
      rw [Proj.awayι_toSpecZero_assoc]
    have h2 := Spec.map_injective h1
    intro c
    have h3 := congrArg (fun f => f.hom c) h2
    simpa using h3

  have hdet : ∀ (g : MvPolynomial (Fin (d + 1)) K) (hg : g ∈ MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1),
      x₀ (IsLocalRing.closedPoint K) ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) g →
      φ₀.hom (HomogeneousLocalization.Away.isLocalizationElem (hX a) hg) ≠ 0 := by
    intro g hg hmem h0
    have key : ∀ z : Spec (.of K), x₀ z ∈
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) g → False := by
      intro z hz
      rw [hx₀', Scheme.Hom.comp_apply, ← Scheme.Hom.mem_preimage,
        Proj.awayι_preimage_basicOpen _ (hX a) one_pos hg one_pos] at hz
      have hz' := (PrimeSpectrum.mem_basicOpen _ _).mp hz
      apply hz'
      rw [Spec.map_apply]
      exact Ideal.mem_comap.mpr (by rw [h0]; exact zero_mem _)
    exact key _ hmem

  have hshear : ∀ (b : Fin (d + 1)) (c : K) (hg : MvPolynomial.X b - MvPolynomial.C c * MvPolynomial.X a ∈
      MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1),
      HomogeneousLocalization.Away.isLocalizationElem (hX a) hg =
        HomogeneousLocalization.Away.isLocalizationElem (hX a) (hX b) -
          HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0) c) := by
    intro b c hg
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_sub]
    have hC : (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
        (Submonoid.powers (MvPolynomial.X a))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0) c)).val =
        Localization.mk (MvPolynomial.C c) 1 := by
      rw [Localization.mk_one_eq_algebraMap]; rfl
    rw [hC]
    simp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk]
    rw [Localization.sub_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, pow_one, one_mul, mul_one]
    ring

  obtain ⟨σ, hσ⟩ : ∃ σ : Equiv.Perm (Fin (d + 1)), σ = Equiv.swap a (Fin.last d) := ⟨_, rfl⟩
  have hσσ : ∀ i, σ (σ i) = i := fun i => by rw [hσ]; exact Equiv.swap_apply_self _ _ _
  have hσa : σ a = Fin.last d := by rw [hσ]; exact Equiv.swap_apply_left _ _
  have hσl : σ (Fin.last d) = a := by rw [hσ]; exact Equiv.swap_apply_right _ _
  obtain ⟨v, hv⟩ : ∃ v : Fin (d + 1) → K, ∀ b, v b =
      φ₀.hom (HomogeneousLocalization.Away.isLocalizationElem (hX a) (hX b)) := ⟨_, fun _ => rfl⟩
  obtain ⟨w, hwa, hw⟩ : ∃ w : Fin (d + 1) → K, w a = 0 ∧ ∀ b, b ≠ a → w b = v b :=
    ⟨fun b => if b = a then 0 else v b, by simp, fun b hb => by simp [hb]⟩
  refine ⟨fun i => MvPolynomial.X (σ i) - MvPolynomial.C (w (σ i)) * MvPolynomial.X a,
    fun i => MvPolynomial.X (σ i) + MvPolynomial.C (w i) * MvPolynomial.X (Fin.last d),
    fun i => (MvPolynomial.isHomogeneous_X K _).sub (MvPolynomial.isHomogeneous_C_mul_X _ _),
    fun i => (MvPolynomial.isHomogeneous_X K _).add (MvPolynomial.isHomogeneous_C_mul_X _ _), ?_, ?_, ?_⟩
  · intro i
    simp only [map_sub, map_add, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
      MvPolynomial.algebraMap_eq, hσσ, hσl, hwa, map_zero, zero_mul, sub_zero]
    ring
  · intro i
    simp only [map_sub, map_add, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
      MvPolynomial.algebraMap_eq, hσσ, hσa, hwa, map_zero, zero_mul, add_zero]
    ring
  · intro i hi hmem
    have hil : i ≠ Fin.last d := fun h => by rw [h, Fin.val_last] at hi; omega
    have hσi : σ i ≠ a := fun h => hil (by have := congrArg σ h; rw [hσσ, hσa] at this; exact this)
    have hg : MvPolynomial.X (σ i) - MvPolynomial.C (v (σ i)) * MvPolynomial.X a ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule _ _).mpr
        ((MvPolynomial.isHomogeneous_X K _).sub (MvPolynomial.isHomogeneous_C_mul_X _ _))
    have hmem' : x₀ (IsLocalRing.closedPoint K) ∈ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
        (MvPolynomial.X (σ i) - MvPolynomial.C (v (σ i)) * MvPolynomial.X a) := by
      rw [← hw _ hσi]; exact hmem
    apply hdet _ hg hmem'
    rw [hshear (σ i) (v (σ i)) hg, map_sub, hret, hv, sub_self]

theorem wc_proj_coord_point_unique : ∀ (K : Type u) [Field K] (d : ℕ) (y z : wcProjK K d), (∀ i : Fin (d + 1), i.val < d → y ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X i)) → (∀ i : Fin (d + 1), i.val < d → z ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X i)) → y = z :=
by
  classical
  intro K _ d y z hy hz
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) :=
    MvPolynomial.gradedAlgebra
  obtain ⟨I, hI⟩ : ∃ I : Ideal (MvPolynomial (Fin (d + 1)) K),
      I = Ideal.span (MvPolynomial.X '' {i : Fin (d + 1) | i.val < d}) := ⟨_, rfl⟩
  have hlast : ∀ i : Fin (d + 1), i ≠ Fin.last d → i.val < d := by
    intro i hi
    have h1 := Fin.lt_last_iff_ne_last.mpr hi
    rw [Fin.lt_iff_val_lt_val, Fin.val_last] at h1
    exact h1

  have key : ∀ (p : Ideal (MvPolynomial (Fin (d + 1)) K)), p.IsPrime →
      (∀ i : Fin (d + 1), i.val < d → MvPolynomial.X i ∈ p) →
      MvPolynomial.X (Fin.last d) ∉ p →
      ∀ (n : ℕ) (h : MvPolynomial (Fin (d + 1)) K), h.IsHomogeneous n → h ∈ p → h ∈ I := by
    intro p hp hX hXl n h hh hmem
    obtain ⟨e, he⟩ : ∃ e : Fin (d + 1) →₀ ℕ, e = Finsupp.single (Fin.last d) n := ⟨_, rfl⟩
    have hIp : I ≤ p := by
      rw [hI, Ideal.span_le, Set.image_subset_iff]
      intro i hi
      exact hX i hi
    have hr : h - MvPolynomial.monomial e (h.coeff e) ∈ I := by
      rw [hI, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub, MvPolynomial.coeff_monomial] at hm
      have hme : m ≠ e := by
        intro hme'
        rw [hme', if_pos rfl, sub_self] at hm
        exact hm rfl
      rw [if_neg (Ne.symm hme), sub_zero] at hm
      have hdeg : Finsupp.degree m = n := by
        by_contra hne
        exact hm (hh.coeff_eq_zero hne)
      by_contra hno
      push_neg at hno
      apply hme
      have hms : m = Finsupp.single (Fin.last d) (m (Fin.last d)) := by
        ext i
        by_cases hi : i = Fin.last d
        · subst hi; simp
        · rw [Finsupp.single_apply, if_neg (fun h' => hi h'.symm)]
          exact hno i (hlast i hi)
      have hml : m (Fin.last d) = n := by
        have h2 := hdeg
        rw [hms, Finsupp.degree_single] at h2
        exact h2
      calc m = Finsupp.single (Fin.last d) (m (Fin.last d)) := hms
        _ = e := by rw [hml, he]
    have hmono : MvPolynomial.monomial e (h.coeff e) ∈ p := by
      have h3 : MvPolynomial.monomial e (h.coeff e) =
          h - (h - MvPolynomial.monomial e (h.coeff e)) := by ring
      rw [h3]
      exact p.sub_mem hmem (hIp hr)
    have hc0 : h.coeff e = 0 := by
      by_contra hc
      apply hXl
      apply hp.mem_of_pow_mem n
      have h4 : MvPolynomial.X (Fin.last d) ^ n =
          MvPolynomial.C (h.coeff e)⁻¹ * MvPolynomial.monomial e (h.coeff e) := by
        rw [MvPolynomial.C_mul_monomial, inv_mul_cancel₀ hc, he, MvPolynomial.X_pow_eq_monomial]
      rw [h4]
      exact p.mul_mem_left _ hmono
    have h5 : h = h - MvPolynomial.monomial e (h.coeff e) := by
      rw [hc0, map_zero, sub_zero]
    rw [h5]
    exact hr

  have hpt : ∀ x : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K),
      (∀ i : Fin (d + 1), i.val < d → MvPolynomial.X i ∈ x.asHomogeneousIdeal) →
      x.asHomogeneousIdeal.toIdeal = I := by
    intro x hx
    have hXl : MvPolynomial.X (Fin.last d) ∉ x.asHomogeneousIdeal.toIdeal := by
      intro hl
      apply ProjectiveSpectrum.not_irrelevant_le x
      intro a ha
      have hall : ∀ i : Fin (d + 1), MvPolynomial.X i ∈ x.asHomogeneousIdeal.toIdeal := by
        intro i
        by_cases hi : i = Fin.last d
        · rw [hi]; exact hl
        · exact hx i (hlast i hi)
      have ha0 : a.coeff 0 = 0 := by
        rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha
        have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) a 0 :
            MvPolynomial (Fin (d + 1)) K)) = MvPolynomial.homogeneousComponent 0 a :=
          MvPolynomial.decomposition.decompose'_apply a 0
        rw [h6, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at ha
        exact ha
      have hspan : a ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1)))) := by
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        rw [MvPolynomial.mem_support_iff] at hm
        have hm0 : m ≠ 0 := by
          rintro rfl
          exact hm ha0
        obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
        exact ⟨i, Set.mem_univ _, hi⟩
      have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (d + 1)))) ≤
          x.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le, Set.image_subset_iff]
        intro i _
        exact hall i
      exact hle hspan
    have hhom := x.asHomogeneousIdeal.isHomogeneous
    have hp : x.asHomogeneousIdeal.toIdeal.IsPrime := x.isPrime
    apply le_antisymm
    · intro a ha
      rw [← MvPolynomial.sum_homogeneousComponent a]
      apply Ideal.sum_mem
      intro k _
      have h7 := hhom k ha
      have h6 : ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) a k :
          MvPolynomial (Fin (d + 1)) K)) = MvPolynomial.homogeneousComponent k a :=
        MvPolynomial.decomposition.decompose'_apply a k
      rw [h6] at h7
      exact key _ hp hx hXl k _ (MvPolynomial.homogeneousComponent_isHomogeneous k a) h7
    · rw [hI, Ideal.span_le, Set.image_subset_iff]
      intro i hi
      exact hx i hi
  have hy' := hpt y (fun i hi => by
    have h8 := hy i hi
    rw [Proj.mem_basicOpen, not_not] at h8
    exact h8)
  have hz' := hpt z (fun i hi => by
    have h8 := hz i hi
    rw [Proj.mem_basicOpen, not_not] at h8
    exact h8)
  exact ProjectiveSpectrum.ext (HomogeneousIdeal.ext (hy'.trans hz'.symm))

theorem wc_proj_chart_partial_punct_iso : ∀ (K : Type u) [Field K] (d : ℕ) (k : Fin (d + 1)), Nonempty ((@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X k) : Scheme.{u}) ≅ Spec (.of (MvPolynomial (Fin d) K))) ∧ ∀ (W : (wcProjK K d).Opens) (E : (Spec (.of (MvPolynomial (Fin d) K))).Opens), (W : Set (wcProjK K d)) = {y | (∃ i : Fin (d + 1), i.val < k.val ∧ y ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X i)) ∧ y ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X k)} → (E : Set (Spec (.of (MvPolynomial (Fin d) K)))) = {x | ∃ j : Fin d, j.val < k.val ∧ (MvPolynomial.X j : MvPolynomial (Fin d) K) ∉ x.asIdeal} → Nonempty ((W : Scheme.{u}) ≅ (E : Scheme.{u})) :=
by
  intro K _ d k
  letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K))
  obtain ⟨e, he⟩ : ∃ e : MvPolynomial (Fin d) K ≃+* HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X k),
      ∀ j : Fin d, HomogeneousLocalization.val (e (MvPolynomial.X j)) =
        Localization.mk (MvPolynomial.X (k.succAbove j)) ⟨MvPolynomial.X k, Submonoid.mem_powers _⟩ := by
    have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (d + 1) → S) (t : S) (n : ℕ)
        (F : MvPolynomial (Fin (d + 1)) K), F.IsHomogeneous n →
        MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
      intro S _ φ x t n F hF
      conv_lhs => rw [F.as_sum]
      conv_rhs => rw [F.as_sum]
      rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun dd hd => ?_)
      have hdeg : Finsupp.degree dd = n := by
        by_contra h
        exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
      rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
      have hp : (dd.prod fun i e => (t * x i) ^ e) = t ^ n * dd.prod fun i e => x i ^ e := by
        simp only [mul_pow]
        rw [Finsupp.prod_mul]
        congr 1
        rw [← hdeg, Finsupp.degree_apply]
        unfold Finsupp.prod
        rw [Finset.prod_pow_eq_pow_sum]
      rw [hp]
      ring
    have hX : (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K k)
    have hg : ∀ i : Fin d, (MvPolynomial.X (k.succAbove i) : MvPolynomial (Fin (d + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K (1 • 1) := fun i =>
      (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X K _)
    obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin d) K →+*
        HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
          (MvPolynomial.X k),
        (∀ c : K, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (Submonoid.powers (MvPolynomial.X k))
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0) c)) ∧
        (∀ i : Fin d, ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) hX 1
          (MvPolynomial.X (k.succAbove i)) (hg i)) :=
      ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
          (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0)))
        (fun i => HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
          hX 1 (MvPolynomial.X (k.succAbove i)) (hg i)),
        fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
        fun i => by rw [MvPolynomial.eval₂Hom_X']⟩
    obtain ⟨ρt, hρC, hρa, hρs⟩ : ∃ ρt : MvPolynomial (Fin (d + 1)) K →+* MvPolynomial (Fin d) K,
        (∀ c : K, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X k) = 1 ∧
        (∀ i : Fin d, ρt (MvPolynomial.X (k.succAbove i)) = MvPolynomial.X i) :=
      ⟨MvPolynomial.eval₂Hom MvPolynomial.C
          (Fin.insertNth (α := fun _ => MvPolynomial (Fin d) K) k 1 MvPolynomial.X),
        fun c => by rw [MvPolynomial.eval₂Hom_C],
        by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same],
        fun i => by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]⟩
    have hu : IsUnit (ρt (MvPolynomial.X k)) := by rw [hρa]; exact isUnit_one
    have hu1 : (Localization.mk 1 ⟨MvPolynomial.X k, Submonoid.mem_powers _⟩ :
        Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) *
        algebraMap (MvPolynomial (Fin (d + 1)) K)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) (MvPolynomial.X k) = 1 := by
      rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
      exact Localization.mk_self (⟨MvPolynomial.X k, Submonoid.mem_powers _⟩ :
        Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
    obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X k) →+*
        MvPolynomial (Fin d) K,
        (∀ z y, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X k))
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) z =
          algebraMap (MvPolynomial (Fin (d + 1)) K)
            (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) y → ρ z = ρt y) ∧
        (∀ (n : ℕ) (F : MvPolynomial (Fin (d + 1)) K)
          (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K (n • 1)),
          ρ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
            hX n F hF) = ρt F) := by
      refine ⟨(IsLocalization.Away.lift (MvPolynomial.X k) hu :
          Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K) →+*
            MvPolynomial (Fin d) K).comp (algebraMap _ _), ?_, ?_⟩
      · intro z y hzy
        rw [RingHom.comp_apply, hzy, IsLocalization.Away.lift_eq]
      · intro n F hF
        rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk]
        have hs := IsLocalization.mk'_spec
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) F
          (⟨MvPolynomial.X k ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
            Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
        rw [← Localization.mk_eq_mk'_apply] at hs
        have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X k) hu :
          Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K) →+*
            MvPolynomial (Fin d) K) hs
        rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
        simp only [map_pow, hρa, one_pow, mul_one] at hs2
        exact hs2
    have hΨC : ∀ c : K, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X k))
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
          (ψ (MvPolynomial.C c)) =
        algebraMap (MvPolynomial (Fin (d + 1)) K)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) (MvPolynomial.C c) := by
      intro c
      rw [hψC, HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
      have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0) c :
          ↥(MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 0)) : MvPolynomial (Fin (d + 1)) K) =
          MvPolynomial.C c := by
        rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
      rw [← h1]
      rfl
    have hΨX : ∀ i : Fin d, algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X k))
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
          (ψ (MvPolynomial.X i)) =
        (Localization.mk 1 ⟨MvPolynomial.X k, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) *
        algebraMap (MvPolynomial (Fin (d + 1)) K)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
          (MvPolynomial.X (k.succAbove i)) := by
      intro i
      rw [hψX, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
      congr 1
      ext
      simp
    have hcomp : ((algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X k))
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))).comp ψ).comp ρt =
        MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (d + 1)) K)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))).comp MvPolynomial.C)
          (fun j => (Localization.mk 1 ⟨MvPolynomial.X k, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) *
            algebraMap (MvPolynomial (Fin (d + 1)) K)
              (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
              (MvPolynomial.X j)) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.comp_apply, hρC, hΨC, MvPolynomial.eval₂Hom_C,
          RingHom.comp_apply]
      · intro j
        rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
        rcases Fin.eq_self_or_eq_succAbove k j with h | ⟨i, h⟩
        · subst h
          rw [hρa, map_one, map_one, hu1]
        · subst h
          rw [hρs, hΨX]
    have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (d + 1)) K)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))).comp MvPolynomial.C)
          (fun j => algebraMap (MvPolynomial (Fin (d + 1)) K)
              (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
              (MvPolynomial.X j)) =
        algebraMap (MvPolynomial (Fin (d + 1)) K)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro j
        rw [MvPolynomial.eval₂Hom_X']
    have key : ∀ (n : ℕ) (F : MvPolynomial (Fin (d + 1)) K), F.IsHomogeneous n →
        algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X k))
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) (ψ (ρt F)) *
          algebraMap (MvPolynomial (Fin (d + 1)) K)
            (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
            (MvPolynomial.X k ^ n) =
        algebraMap (MvPolynomial (Fin (d + 1)) K)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) F := by
      intro n F hF
      have h1 := RingHom.congr_fun hcomp F
      rw [RingHom.comp_apply, RingHom.comp_apply] at h1
      rw [h1, MvPolynomial.coe_eval₂Hom]
      have hs := scale ((algebraMap (MvPolynomial (Fin (d + 1)) K)
          (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))).comp MvPolynomial.C)
        (fun j => algebraMap (MvPolynomial (Fin (d + 1)) K)
              (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
              (MvPolynomial.X j))
        (Localization.mk 1 ⟨MvPolynomial.X k, Submonoid.mem_powers _⟩) n F hF
      rw [hs, ← MvPolynomial.coe_eval₂Hom, hev, map_pow]
      calc (Localization.mk 1 ⟨MvPolynomial.X k, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) ^ n *
            algebraMap (MvPolynomial (Fin (d + 1)) K)
              (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) F *
            algebraMap (MvPolynomial (Fin (d + 1)) K)
              (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
              (MvPolynomial.X k) ^ n
          = ((Localization.mk 1 ⟨MvPolynomial.X k, Submonoid.mem_powers _⟩ :
            Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) *
            algebraMap (MvPolynomial (Fin (d + 1)) K)
              (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K))
              (MvPolynomial.X k)) ^ n *
            algebraMap (MvPolynomial (Fin (d + 1)) K)
              (Localization.Away (MvPolynomial.X k : MvPolynomial (Fin (d + 1)) K)) F := by ring
        _ = _ := by rw [hu1, one_pow, one_mul]
    have h1 : ψ.comp ρ = RingHom.id _ := by
      apply RingHom.ext
      intro z
      obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
        (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) hX z
      rw [RingHom.comp_apply, hρ2, RingHom.id_apply]
      have hFh : F.IsHomogeneous n := by
        rw [smul_eq_mul, mul_one] at hF
        exact (MvPolynomial.mem_homogeneousSubmodule n F).1 hF
      apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X k))
      rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
        Localization.mk_eq_mk'_apply, IsLocalization.eq_mk'_iff_mul_eq]
      exact key n F hFh
    have h2 : ρ.comp ψ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, hρ1 _ _ (hΨC c), hρC, RingHom.id_apply]
      · intro i
        rw [RingHom.comp_apply, hψX, hρ2, hρs, RingHom.id_apply]
    refine ⟨RingEquiv.ofRingHom ψ ρ h1 h2, fun j => ?_⟩
    rw [RingEquiv.ofRingHom_apply, hψX, HomogeneousLocalization.Away.val_mk]
    congr 1
    ext
    simp
  have hXi : ∀ i : Fin (d + 1), (MvPolynomial.X i : MvPolynomial (Fin (d + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K i)
  let φ := Spec.map e.toCommRingCatIso.inv
  let g := φ ≫ Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X k)
    (hXi k) Nat.one_pos
  haveI : IsOpenImmersion g := inferInstance
  have hrange : Set.range g = (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
      (MvPolynomial.X k) : Set (wcProjK K d)) := by
    rw [← Proj.opensRange_awayι (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
      (MvPolynomial.X k) (hXi k) Nat.one_pos, Scheme.Hom.coe_opensRange]
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨φ x, (Scheme.Hom.comp_apply _ _ _).symm⟩
    · rintro ⟨z, rfl⟩
      obtain ⟨x, hx⟩ := φ.homeomorph.surjective z
      refine ⟨x, ?_⟩
      rw [Scheme.Hom.comp_apply]
      exact congrArg _ hx
  have hcoord : ∀ (j : Fin d) (x : Spec (.of (MvPolynomial (Fin d) K))),
      g x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
        (MvPolynomial.X (k.succAbove j)) ↔ (MvPolynomial.X j : MvPolynomial (Fin d) K) ∉ x.asIdeal := by
    intro j x
    have hel : HomogeneousLocalization.Away.isLocalizationElem (hXi k) (hXi (k.succAbove j)) =
        e (MvPolynomial.X j) := by
      apply HomogeneousLocalization.val_injective
      rw [he j, HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk]
      congr 1
      · simp
      · ext; simp
    rw [← Scheme.Hom.mem_preimage, Scheme.Hom.comp_preimage,
      Proj.awayι_preimage_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (hXi k)
        Nat.one_pos (hXi (k.succAbove j)) Nat.one_pos,
      SpecMap_preimage_basicOpen, hel]
    exact Iff.of_eq (congrArg (fun r => r ∉ x.asIdeal) (e.symm_apply_apply (MvPolynomial.X j)))
  have hsa : ∀ j : Fin d, j.val < k.val → (k.succAbove j).val = j.val := by
    intro j hj
    rw [Fin.succAbove_of_castSucc_lt _ _ (by rw [Fin.lt_def]; simpa using hj)]
    simp
  refine ⟨⟨(IsOpenImmersion.isoOfRangeEq g
    (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K) (MvPolynomial.X k)).ι
    (by rw [hrange, Scheme.Opens.range_ι])).symm⟩, ?_⟩
  intro W E hW hE
  refine ⟨IsOpenImmersion.isoOfRangeEq W.ι (E.ι ≫ g) ?_⟩
  rw [Scheme.Opens.range_ι, hW]
  ext y
  constructor
  · rintro ⟨⟨i, hi, hyi⟩, hyk⟩
    have hyk' : y ∈ Set.range g := by rw [hrange]; exact hyk
    obtain ⟨x, rfl⟩ := hyk'
    have hid : i.val < d := by have := k.isLt; omega
    have hsi : k.succAbove (⟨i.val, hid⟩ : Fin d) = i := Fin.ext (hsa _ hi)
    have hxE : x ∈ (E : Set (Spec (.of (MvPolynomial (Fin d) K)))) := by
      rw [hE]
      exact ⟨⟨i.val, hid⟩, hi, (hcoord _ x).1 (by rw [hsi]; exact hyi)⟩
    refine ⟨⟨x, hxE⟩, ?_⟩
    exact (Scheme.Hom.comp_apply _ _ _).trans (congrArg g (Scheme.Opens.ι_apply E _))
  · rintro ⟨z, rfl⟩
    rw [Scheme.Hom.comp_apply]
    have hx' : E.ι z ∈ (E : Set (Spec (.of (MvPolynomial (Fin d) K)))) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨z, rfl⟩
    generalize E.ι z = x at hx' ⊢
    rw [hE] at hx'
    obtain ⟨j, hj, hxj⟩ := hx'
    refine ⟨⟨k.succAbove j, by rw [hsa j hj]; exact hj, (hcoord j x).2 hxj⟩, ?_⟩
    have : g x ∈ Set.range g := ⟨x, rfl⟩
    rw [hrange] at this
    exact this

theorem wc_ext_two_row_leray_card : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C) (I : InjectiveResolution A), letI := HasExt.standard C; letI := HasExt.standard D; (∀ q : ℕ, 2 ≤ q → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) → ∀ n : ℕ, Finite (Abelian.Ext P (R.obj A) (n + 1)) → Finite (Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1) n) → Finite (Abelian.Ext (L.obj P) A (n + 1)) ∧ Nat.card (Abelian.Ext (L.obj P) A (n + 1)) ≤ Nat.card (Abelian.Ext P (R.obj A) (n + 1)) * Nat.card (Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1) n) :=
by
  intro C D _ _ _ _ L R _ adj _ P A I
  letI : HasExt C := HasExt.standard C
  letI : HasExt D := HasExt.standard D
  intro hH n h1 h2
  classical

  have s1 : ∀ (K : CochainComplex D ℕ) (j : ℕ), ∃ (B : D) (u : K.X j ⟶ B)
      (v : B ⟶ K.cycles (j + 1)) (h1 : K.iCycles j ≫ u = 0) (h2 : v ≫ K.homologyπ (j + 1) = 0),
      (ShortComplex.mk _ _ h1).ShortExact ∧ (ShortComplex.mk _ _ h2).ShortExact ∧
        u ≫ v ≫ K.iCycles (j + 1) = K.d j (j + 1) := by
    intro K j
    have hv : Limits.image.ι (K.d j (j + 1)) ≫ K.d (j + 1) (j + 1 + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d j (j + 1))), Limits.image.fac_assoc,
        K.d_comp_d, Limits.comp_zero]
    let v := K.liftCycles (Limits.image.ι (K.d j (j + 1))) (j + 1 + 1)
      (CochainComplex.next ℕ (j + 1)) hv
    have hvi : v ≫ K.iCycles (j + 1) = Limits.image.ι (K.d j (j + 1)) :=
      K.liftCycles_i _ _ _ _
    have huv : Limits.factorThruImage (K.d j (j + 1)) ≫ v = K.toCycles j (j + 1) := by
      rw [← cancel_mono (K.iCycles (j + 1)), Category.assoc, hvi, Limits.image.fac,
        K.toCycles_i]
    have h1 : K.iCycles j ≫ Limits.factorThruImage (K.d j (j + 1)) = 0 := by
      rw [← cancel_mono (Limits.image.ι (K.d j (j + 1))), Category.assoc, Limits.image.fac,
        Limits.zero_comp]
      exact K.iCycles_d j (j + 1)
    have h2 : v ≫ K.homologyπ (j + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (K.d j (j + 1))), ← Category.assoc, huv,
        Limits.comp_zero]
      exact K.toCycles_comp_homologyπ j (j + 1)
    haveI : Mono v := mono_of_mono_fac hvi
    refine ⟨Limits.image (K.d j (j + 1)), Limits.factorThruImage (K.d j (j + 1)), v, h1, h2,
      ?_, ?_, ?_⟩
    · refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _
        (Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => K.liftCycles g' (j + 1) (CochainComplex.next ℕ j) (by
            rw [← Limits.image.fac (K.d j (j + 1)), ← Category.assoc,
              show g' ≫ Limits.factorThruImage (K.d j (j + 1)) = 0 from hg', Limits.zero_comp]))
          (fun g' hg' => K.liftCycles_i _ _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (K.iCycles j), K.liftCycles_i]
            exact hm))) inferInstance inferInstance
    · have hprev : (ComplexShape.up ℕ).prev (j + 1) = j := by simp
      refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
        (Limits.CokernelCofork.IsColimit.ofπ _ _
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).1)
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (K.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2)
          (fun g' hg' m hm => by
            rw [← cancel_epi (K.homologyπ (j + 1))]
            exact hm.trans (Limits.CokernelCofork.IsColimit.desc'
              (K.homologyIsCokernel j (j + 1) hprev) g' (by
                rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2.symm)))
        inferInstance inferInstance
    · rw [hvi, Limits.image.fac]

  have hZero : ∀ {Y : D} (_ : Limits.IsZero Y) (a : ℕ) (x : Abelian.Ext P Y a), x = 0 := by
    intro Y hY a x
    rw [← Abelian.Ext.comp_mk₀_id x, hY.eq_of_src (𝟙 Y) 0, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]

  have chain : ∀ (K : CochainComplex D ℕ), (∀ j, Injective (K.X j)) →
      (∀ q : ℕ, 2 ≤ q → Limits.IsZero (K.homology q)) → ∀ k : ℕ,
      Finite (Abelian.Ext P (K.cycles 0) (k + 1 + 1)) →
      Finite (Abelian.Ext P (K.homology 1) (k + 1)) →
      Finite (Abelian.Ext P (K.cycles (k + 1)) 1) ∧
        Nat.card (Abelian.Ext P (K.cycles (k + 1)) 1) ≤
          Nat.card (Abelian.Ext P (K.cycles 0) (k + 1 + 1)) *
            Nat.card (Abelian.Ext P (K.homology 1) (k + 1)) := by
    intro K hinj hHK k hf0 hf1
    choose Bo u v h1 h2 hS1 hS2 hfac using s1 K
    have T1 : ∀ (b a : ℕ) (y : Abelian.Ext P (Bo b) (a + 1)),
        y.comp (hS1 b).extClass (rfl : a + 1 + 1 = a + 1 + 1) = 0 → y = 0 := by
      intro b a y hy
      haveI : Injective (ShortComplex.mk _ _ (h1 b)).X₂ := hinj b
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS1 b) y rfl hy
      rw [← hx₂, Abelian.Ext.eq_zero_of_injective x₂, Abelian.Ext.zero_comp]
    have main : ∀ j i : ℕ, i + j = k →
        Finite (Abelian.Ext P (K.cycles (j + 1)) (i + 1)) ∧
          Nat.card (Abelian.Ext P (K.cycles (j + 1)) (i + 1)) ≤
            Nat.card (Abelian.Ext P (K.cycles 0) (k + 1 + 1)) *
              Nat.card (Abelian.Ext P (K.homology 1) (k + 1)) := by
      intro j
      induction j with
      | zero =>
        intro i hi
        rw [show i = k by omega]
        let δ := (hS1 0).extClass.postcomp P (rfl : (k + 1) + 1 = (k + 1) + 1)
        have hδ : Function.Injective δ := by
          rw [injective_iff_map_eq_zero]
          intro y hy
          exact T1 0 k y hy
        haveI : Finite (Abelian.Ext P (Bo 0) (k + 1)) := Finite.of_injective δ hδ
        have hcB : Nat.card (Abelian.Ext P (Bo 0) (k + 1)) ≤
            Nat.card (Abelian.Ext P (K.cycles 0) (k + 1 + 1)) :=
          Nat.card_le_card_of_injective δ hδ
        let α : Abelian.Ext P (Bo 0) (k + 1) →+ Abelian.Ext P (K.cycles (0 + 1)) (k + 1) :=
          (Abelian.Ext.mk₀ (v 0)).postcomp P (add_zero (k + 1))
        let β : Abelian.Ext P (K.cycles (0 + 1)) (k + 1) →+
            Abelian.Ext P (K.homology (0 + 1)) (k + 1) :=
          (Abelian.Ext.mk₀ (K.homologyπ (0 + 1))).postcomp P (add_zero (k + 1))
        have hex : ∀ y, β y = 0 → ∃ x, α x = y := fun y hy =>
          Abelian.Ext.covariant_sequence_exact₂ P (hS2 0) y hy
        haveI : Finite (Abelian.Ext P (K.homology (0 + 1)) (k + 1)) := hf1
        haveI : Nonempty (Abelian.Ext P (K.cycles (0 + 1)) (k + 1)) := ⟨0⟩
        let s := Function.invFun β
        have hs : ∀ y, β (s (β y)) = β y := fun y => Function.invFun_eq ⟨y, rfl⟩
        have ht : ∀ y, ∃ x, α x = y - s (β y) := fun y =>
          hex _ (by rw [map_sub, hs, sub_self])
        choose t ht using ht
        let Ψ : Abelian.Ext P (K.cycles (0 + 1)) (k + 1) →
            Abelian.Ext P (Bo 0) (k + 1) × Abelian.Ext P (K.homology (0 + 1)) (k + 1) :=
          fun y => (t y, β y)
        have hΨ : Function.Injective Ψ := by
          intro y y' hyy
          have ht' : t y = t y' := congrArg Prod.fst hyy
          have hb' : β y = β y' := congrArg Prod.snd hyy
          have e1 : y = α (t y) + s (β y) := by rw [ht y]; exact (sub_add_cancel _ _).symm
          have e2 : y' = α (t y') + s (β y') := by rw [ht y']; exact (sub_add_cancel _ _).symm
          rw [e1, e2, ht', hb']
        refine ⟨Finite.of_injective Ψ hΨ, ?_⟩
        calc Nat.card (Abelian.Ext P (K.cycles (0 + 1)) (k + 1))
            ≤ Nat.card (Abelian.Ext P (Bo 0) (k + 1) ×
                Abelian.Ext P (K.homology (0 + 1)) (k + 1)) :=
              Nat.card_le_card_of_injective Ψ hΨ
          _ = Nat.card (Abelian.Ext P (Bo 0) (k + 1)) *
                Nat.card (Abelian.Ext P (K.homology (0 + 1)) (k + 1)) := Nat.card_prod _ _
          _ ≤ _ := Nat.mul_le_mul hcB le_rfl
      | succ j ih =>
        intro i hi
        obtain ⟨hf, hc⟩ := ih (i + 1) (by omega)
        haveI := hf
        let δ := (hS1 (j + 1)).extClass.postcomp P (rfl : (i + 1) + 1 = (i + 1) + 1)
        have hδ : Function.Injective δ := by
          rw [injective_iff_map_eq_zero]
          intro y hy
          exact T1 (j + 1) i y hy
        haveI : Finite (Abelian.Ext P (Bo (j + 1)) (i + 1)) := Finite.of_injective δ hδ
        have hcB : Nat.card (Abelian.Ext P (Bo (j + 1)) (i + 1)) ≤
            Nat.card (Abelian.Ext P (K.cycles 0) (k + 1 + 1)) *
              Nat.card (Abelian.Ext P (K.homology 1) (k + 1)) :=
          (Nat.card_le_card_of_injective δ hδ).trans hc
        let ν : Abelian.Ext P (Bo (j + 1)) (i + 1) →
            Abelian.Ext P (K.cycles (j + 1 + 1)) (i + 1) :=
          fun y => y.comp (Abelian.Ext.mk₀ (v (j + 1))) (add_zero _)
        have hν : Function.Surjective ν := by
          intro x
          have h0 : x.comp (Abelian.Ext.mk₀ (K.homologyπ (j + 1 + 1))) (add_zero _) = 0 :=
            hZero (hHK (j + 1 + 1) (by omega)) _ _
          exact Abelian.Ext.covariant_sequence_exact₂ P (hS2 (j + 1)) x h0
        exact ⟨Finite.of_surjective ν hν, (Nat.card_le_card_of_surjective ν hν).trans hcB⟩
    exact main k 0 (by omega)

  have core : ∀ (K : CochainComplex D ℕ) (m : ℕ),
      Finite (Abelian.Ext P (K.homology (m + 1)) 0) → Finite (Abelian.Ext P (K.cycles m) 1) →
      ∃ S : Set (P ⟶ K.X (m + 1)), S.Finite ∧
        Nat.card S ≤ Nat.card (Abelian.Ext P (K.homology (m + 1)) 0) *
          Nat.card (Abelian.Ext P (K.cycles m) 1) ∧
        ∀ c : P ⟶ K.X (m + 1), c ≫ K.d (m + 1) (m + 1 + 1) = 0 →
          ∃ c' ∈ S, c' ≫ K.d (m + 1) (m + 1 + 1) = 0 ∧
            ∃ e : P ⟶ K.X m, e ≫ K.d m (m + 1) = c - c' := by
    intro K m hF0 hF1
    obtain ⟨Bo, u, v, h1, h2, hS1, hS2, hfac⟩ := s1 K m
    let Z := {c : P ⟶ K.X (m + 1) // c ≫ K.d (m + 1) (m + 1 + 1) = 0}
    let Θ : Z → Abelian.Ext P (K.homology (m + 1)) 0 := fun c =>
      Abelian.Ext.mk₀ (K.liftCycles c.1 (m + 1 + 1) (CochainComplex.next ℕ (m + 1)) c.2 ≫
        K.homologyπ (m + 1))
    haveI : Nonempty Z := ⟨⟨0, Limits.zero_comp⟩⟩
    let ρ := Function.invFun Θ
    have hρ : ∀ z, Θ (ρ (Θ z)) = Θ z := fun z => Function.invFun_eq ⟨z, rfl⟩
    let Ξ : (P ⟶ Bo) → Abelian.Ext P (K.cycles m) 1 := fun b =>
      (Abelian.Ext.mk₀ b).comp hS1.extClass (zero_add 1)
    haveI : Nonempty (P ⟶ Bo) := ⟨0⟩
    let σ := Function.invFun Ξ
    have hσ : ∀ b, Ξ (σ (Ξ b)) = Ξ b := fun b => Function.invFun_eq ⟨b, rfl⟩
    let F : Abelian.Ext P (K.homology (m + 1)) 0 × Abelian.Ext P (K.cycles m) 1 →
        (P ⟶ K.X (m + 1)) := fun hε =>
      (ρ hε.1).1 + σ hε.2 ≫ v ≫ K.iCycles (m + 1)
    refine ⟨Set.range F, Set.finite_range F, ?_, ?_⟩
    · calc Nat.card (Set.range F)
          ≤ Nat.card (Abelian.Ext P (K.homology (m + 1)) 0 ×
              Abelian.Ext P (K.cycles m) 1) :=
            Nat.card_le_card_of_surjective _ Set.rangeFactorization_surjective
        _ = Nat.card (Abelian.Ext P (K.homology (m + 1)) 0) *
              Nat.card (Abelian.Ext P (K.cycles m) 1) := Nat.card_prod _ _
    intro c hc
    let z : Z := ⟨c, hc⟩
    let w := ρ (Θ z)
    have hwd : w.1 ≫ K.d (m + 1) (m + 1 + 1) = 0 := w.2
    have hmd : (c - w.1) ≫ K.d (m + 1) (m + 1 + 1) = 0 := by
      rw [Preadditive.sub_comp, hc, hwd, sub_zero]
    have hlift : K.liftCycles (c - w.1) (m + 1 + 1) (CochainComplex.next ℕ (m + 1)) hmd =
        K.liftCycles c (m + 1 + 1) (CochainComplex.next ℕ (m + 1)) hc -
          K.liftCycles w.1 (m + 1 + 1) (CochainComplex.next ℕ (m + 1)) hwd := by
      rw [← cancel_mono (K.iCycles (m + 1)), Preadditive.sub_comp, K.liftCycles_i,
        K.liftCycles_i, K.liftCycles_i]
    have hΘ : K.liftCycles (c - w.1) (m + 1 + 1) (CochainComplex.next ℕ (m + 1)) hmd ≫
        K.homologyπ (m + 1) = 0 := by
      have e : Abelian.Ext.mk₀ (K.liftCycles w.1 (m + 1 + 1)
            (CochainComplex.next ℕ (m + 1)) hwd ≫ K.homologyπ (m + 1)) =
          Abelian.Ext.mk₀ (K.liftCycles c (m + 1 + 1) (CochainComplex.next ℕ (m + 1)) hc ≫
            K.homologyπ (m + 1)) := hρ z
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at e
      have e' := Abelian.Ext.homEquiv₀.symm.injective e
      rw [hlift, Preadditive.sub_comp]
      exact sub_eq_zero.mpr e'.symm
    haveI := hS2.mono_f
    let b : P ⟶ Bo := hS2.exact.lift
      (K.liftCycles (c - w.1) (m + 1 + 1) (CochainComplex.next ℕ (m + 1)) hmd) hΘ
    have hb : b ≫ v =
        K.liftCycles (c - w.1) (m + 1 + 1) (CochainComplex.next ℕ (m + 1)) hmd :=
      hS2.exact.lift_f _ _
    have hbm : b ≫ v ≫ K.iCycles (m + 1) = c - w.1 := by
      rw [← Category.assoc, hb, K.liftCycles_i]
    let b₀ := σ (Ξ b)
    have hΞ : (Abelian.Ext.mk₀ (b - b₀)).comp hS1.extClass (zero_add 1) = 0 := by
      have e : (Abelian.Ext.mk₀ b₀).comp hS1.extClass (zero_add 1) =
          (Abelian.Ext.mk₀ b).comp hS1.extClass (zero_add 1) := hσ b
      have hsub : Abelian.Ext.mk₀ (b - b₀) = Abelian.Ext.mk₀ b - Abelian.Ext.mk₀ b₀ := by
        rw [eq_sub_iff_add_eq, ← Abelian.Ext.mk₀_add, sub_add_cancel]
      change (hS1.extClass.postcomp P (zero_add 1)) (Abelian.Ext.mk₀ (b - b₀)) = 0
      rw [hsub, map_sub]
      exact sub_eq_zero.mpr e.symm
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS1
      (Abelian.Ext.mk₀ (b - b₀)) (zero_add 1) hΞ
    let e : P ⟶ K.X m := Abelian.Ext.homEquiv₀ x₂
    have he : e ≫ u = b - b₀ := by
      have h3 : Abelian.Ext.mk₀ (e ≫ u) = Abelian.Ext.mk₀ (b - b₀) := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
        exact hx₂
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h3
      exact Abelian.Ext.homEquiv₀.symm.injective h3
    refine ⟨F (Θ z, Ξ b), ⟨_, rfl⟩, ?_, e, ?_⟩
    · show (w.1 + b₀ ≫ v ≫ K.iCycles (m + 1)) ≫ K.d (m + 1) (m + 1 + 1) = 0
      rw [Preadditive.add_comp, hwd, Category.assoc, Category.assoc, K.iCycles_d,
        Limits.comp_zero, Limits.comp_zero, add_zero]
    · rw [← hfac, ← Category.assoc, he, Preadditive.sub_comp, hbm]
      show c - w.1 - b₀ ≫ v ≫ K.iCycles (m + 1) =
        c - (w.1 + b₀ ≫ v ≫ K.iCycles (m + 1))
      abel

  have hφ0 : ∀ j, (adj.homEquiv P (I.cocomplex.X j)) 0 = 0 := fun j => by
    rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have hφs0 : ∀ j, (adj.homEquiv P (I.cocomplex.X j)).symm 0 = 0 := fun j => by
    rw [Equiv.symm_apply_eq, hφ0]
  have hφsub : ∀ j (f g : L.obj P ⟶ I.cocomplex.X j),
      adj.homEquiv P _ (f - g) = adj.homEquiv P _ f - adj.homEquiv P _ g := fun j f g => by
    simp only [Adjunction.homEquiv_unit, Functor.map_sub, Preadditive.comp_sub]
  have transfer : ∀ (N : ℕ) (S : Set (P ⟶ R.obj (I.cocomplex.X (N + 1)))), S.Finite →
      (∀ c : P ⟶ R.obj (I.cocomplex.X (N + 1)), c ≫ R.map (I.cocomplex.d (N + 1) (N + 1 + 1)) = 0 →
        ∃ c' ∈ S, c' ≫ R.map (I.cocomplex.d (N + 1) (N + 1 + 1)) = 0 ∧
          ∃ e : P ⟶ R.obj (I.cocomplex.X N), e ≫ R.map (I.cocomplex.d N (N + 1)) = c - c') →
      Finite (Abelian.Ext (L.obj P) A (N + 1)) ∧
        Nat.card (Abelian.Ext (L.obj P) A (N + 1)) ≤ Nat.card S := by
    intro N S hS hrep
    let T : Set (P ⟶ R.obj (I.cocomplex.X (N + 1))) :=
      {c' | c' ∈ S ∧ c' ≫ R.map (I.cocomplex.d (N + 1) (N + 1 + 1)) = 0}
    have hT : T.Finite := hS.subset (fun x hx => hx.1)
    haveI := hT.to_subtype
    have hTS : Nat.card T ≤ Nat.card S := Nat.card_mono hS (fun x hx => hx.1)
    let Φ : T → Abelian.Ext (L.obj P) A (N + 1) := fun c' =>
      I.extMk ((adj.homEquiv P _).symm c'.1) (N + 1 + 1) rfl
        (by rw [← adj.homEquiv_naturality_right_symm, c'.2.2, hφs0])
    have hΦ : Function.Surjective Φ := by
      intro α
      obtain ⟨f, hf, rfl⟩ := I.extMk_surjective α (N + 1 + 1) rfl
      have hc : adj.homEquiv P _ f ≫ R.map (I.cocomplex.d (N + 1) (N + 1 + 1)) = 0 := by
        rw [← adj.homEquiv_naturality_right, hf, hφ0]
      obtain ⟨c', hc'S, hc'd, e, he⟩ := hrep (adj.homEquiv P _ f) hc
      refine ⟨⟨c', hc'S, hc'd⟩, ?_⟩
      refine (sub_eq_zero.mp ?_).symm
      rw [I.sub_extMk, I.extMk_eq_zero_iff _ _ _ _ N rfl]
      refine ⟨(adj.homEquiv P _).symm e, ?_⟩
      rw [← adj.homEquiv_naturality_right_symm, Equiv.symm_apply_eq, hφsub, Equiv.apply_symm_apply]
      exact he
    have hfinA : Finite (Abelian.Ext (L.obj P) A (N + 1)) := Finite.of_surjective Φ hΦ
    exact ⟨hfinA, (Nat.card_le_card_of_surjective Φ hΦ).trans hTS⟩

  let Kc := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  have hinj : ∀ j, Injective (Kc.X j) := fun j => by
    haveI := I.injective j
    exact Injective.injective_of_adjoint adj (I.cocomplex.X j)
  haveI : Limits.PreservesFiniteLimits R := by
    haveI := adj.isRightAdjoint
    infer_instance
  let eA : R.obj A ≅ Kc.cycles 0 := asIso (I.toRightDerivedZero' R)
  let eE : ∀ k, Abelian.Ext P (R.obj A) k ≃ Abelian.Ext P (Kc.cycles 0) k := fun k =>
    { toFun := fun x => x.comp (Abelian.Ext.mk₀ eA.hom) (add_zero k)
      invFun := fun y => y.comp (Abelian.Ext.mk₀ eA.inv) (add_zero k)
      left_inv := fun x => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }
  rcases n with _ | k
  · haveI : Finite (Abelian.Ext P (Kc.cycles 0) 1) := Finite.of_equiv _ (eE 1)
    haveI : Finite (Abelian.Ext P (Kc.homology (0 + 1)) 0) := h2
    obtain ⟨S, hS, hcard, hrep⟩ := core Kc 0 inferInstance inferInstance
    obtain ⟨hfin, hc⟩ := transfer 0 S hS hrep
    have c1 : Nat.card (Abelian.Ext P (Kc.cycles 0) 1) =
        Nat.card (Abelian.Ext P (R.obj A) (0 + 1)) := (Nat.card_congr (eE 1)).symm
    refine ⟨hfin, hc.trans (hcard.trans (le_of_eq ?_))⟩
    rw [c1]
    exact mul_comm _ _
  · haveI : Finite (Abelian.Ext P (Kc.cycles 0) (k + 1 + 1)) := Finite.of_equiv _ (eE (k + 1 + 1))
    haveI : Finite (Abelian.Ext P (Kc.homology 1) (k + 1)) := h2
    obtain ⟨hfZ, hcZ⟩ := chain Kc hinj hH k inferInstance inferInstance
    haveI := hfZ
    have hsub : Subsingleton (Abelian.Ext P (Kc.homology (k + 1 + 1)) 0) :=
      ⟨fun a b => (hZero (hH (k + 1 + 1) (by omega)) 0 a).trans
        (hZero (hH (k + 1 + 1) (by omega)) 0 b).symm⟩
    haveI := hsub
    have ha : Nat.card (Abelian.Ext P (Kc.homology (k + 1 + 1)) 0) ≤ 1 :=
      Finite.card_le_one_iff_subsingleton.mpr hsub
    obtain ⟨S, hS, hcard, hrep⟩ := core Kc (k + 1) inferInstance hfZ
    obtain ⟨hfin, hc⟩ := transfer (k + 1) S hS hrep
    have c1 : Nat.card (Abelian.Ext P (Kc.cycles 0) (k + 1 + 1)) =
        Nat.card (Abelian.Ext P (R.obj A) (k + 1 + 1)) := (Nat.card_congr (eE (k + 1 + 1))).symm
    refine ⟨hfin, hc.trans (hcard.trans ?_)⟩
    calc Nat.card (Abelian.Ext P (Kc.homology (k + 1 + 1)) 0) *
          Nat.card (Abelian.Ext P (Kc.cycles (k + 1)) 1)
        ≤ 1 * Nat.card (Abelian.Ext P (Kc.cycles (k + 1)) 1) := Nat.mul_le_mul ha le_rfl
      _ = Nat.card (Abelian.Ext P (Kc.cycles (k + 1)) 1) := one_mul _
      _ ≤ Nat.card (Abelian.Ext P (Kc.cycles 0) (k + 1 + 1)) *
            Nat.card (Abelian.Ext P (Kc.homology 1) (k + 1)) := hcZ
      _ = Nat.card (Abelian.Ext P (R.obj A) (k + 1 + 1)) *
            Nat.card (Abelian.Ext P (Kc.homology 1) (k + 1)) := by rw [c1]

theorem wc_et_gm_push_const_iso : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (m : ℕ), Nonempty ((wcEtPush (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).obj ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≅ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
by
  classical
  intro K _ X fX m

  have s1 : ∀ (V : Scheme.{u}) (fV : V ⟶ Spec (.of K)) (A : Type (u+1))
      (h : LocallyConstant ↥(Limits.pullback fV (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) A)
      (x y : ↥(Limits.pullback fV (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))),
      Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) x =
        Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) y →
      h x = h y := by
    intro V fV A h x y hxy
    obtain ⟨v, hv⟩ : ∃ v, Limits.pullback.fst fV
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) x = v := ⟨_, rfl⟩
    have hx : x ∈ Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) := by
      rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecResidueField]
      exact hv
    have hy : y ∈ Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) := by
      rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecResidueField]
      exact hxy.symm.trans hv
    let φ : CommRingCat.of K ⟶ V.residueField v := Spec.preimage (V.fromSpecResidueField v ≫ fV)
    letI : Algebra K (V.residueField v) := φ.hom.toAlgebra
    have hφ : Spec.map (CommRingCat.ofHom (algebraMap K (V.residueField v))) =
        V.fromSpecResidueField v ≫ fV := by
      show Spec.map (CommRingCat.ofHom φ.hom) = _
      rw [CommRingCat.ofHom_hom]
      exact Spec.map_preimage _
    haveI : IsDomain (TensorProduct K (V.residueField v) (LaurentPolynomial K)) :=
      MulEquiv.isDomain (LaurentPolynomial (V.residueField v))
        (AddMonoidAlgebra.scalarTensorEquiv K (V.residueField v) (M := ℤ)).toMulEquiv
    let ψ : Spec (.of (TensorProduct K (V.residueField v) (LaurentPolynomial K))) ≅
        Limits.pullback (V.fromSpecResidueField v)
          (Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) :=
      ((Limits.pullbackRightPullbackFstIso fV _ (V.fromSpecResidueField v)) ≪≫
        Limits.pullback.congrHom hφ.symm rfl ≪≫
        pullbackSpecIso K (V.residueField v) (LaurentPolynomial K)).symm
    haveI : IrreducibleSpace ↥(Limits.pullback (V.fromSpecResidueField v)
        (Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) :=
      Function.Surjective.irreducibleSpace ψ.hom.continuous
        (fun z => ⟨ψ.inv z, Scheme.inv_hom_apply ψ z⟩)
    have hirr : IsIrreducible (Set.range (Limits.pullback.snd (V.fromSpecResidueField v)
        (Limits.pullback.fst fV (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))) := by
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ _).image _
        (Limits.pullback.snd (V.fromSpecResidueField v) (Limits.pullback.fst fV
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).continuous.continuousOn
    exact h.isLocallyConstant.apply_eq_of_isPreconnected hirr.isPreirreducible.isPreconnected hx hy

  have hz : Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.lift K K ℤ 1).toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) = 𝟙 (Spec (.of K)) := by
    rw [← Spec.map_comp, ← Spec.map_id]
    congr 1
    ext k
    first
      | exact (AddMonoidAlgebra.lift K K ℤ 1).commutes k
      | simp

  have hsec : ∀ (V : X.Etale), ∃ σ : V.left ⟶ Limits.pullback V.hom
      (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))),
      σ ≫ Limits.pullback.fst V.hom
        (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) =
        𝟙 V.left := by
    intro V
    refine ⟨Limits.pullback.lift (𝟙 V.left)
      ((V.hom ≫ fX) ≫ Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.lift K K ℤ 1).toRingHom))
      (by simp only [Category.id_comp, Category.assoc, hz, Category.comp_id]) ≫
      (Limits.pullbackRightPullbackFstIso fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) V.hom).inv, ?_⟩
    rw [Category.assoc, Limits.pullbackRightPullbackFstIso_inv_fst, Limits.pullback.lift_fst]

  have hfib : ∀ (V : X.Etale) (h : LocallyConstant ↥(Limits.pullback V.hom
      (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))
        (ULift.{u+1} (ZMod m)))
      (x y : ↥(Limits.pullback V.hom
        (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))),
      Limits.pullback.fst V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) x =
        Limits.pullback.fst V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) y →
      h x = h y := by
    intro V h x y hxy
    have he : ∀ w, Limits.pullback.fst (V.hom ≫ fX)
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))
        ((Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) V.hom).hom w) =
        Limits.pullback.fst V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) w := by
      intro w
      rw [← Scheme.Hom.comp_apply, Limits.pullbackRightPullbackFstIso_hom_fst]
    have key := s1 V.left (V.hom ≫ fX) _
      (h.comap ⟨(Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) V.hom).inv,
        (Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) V.hom).inv.continuous⟩)
      ((Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) V.hom).hom x)
      ((Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) V.hom).hom y)
      (by rw [he, he, hxy])
    rw [LocallyConstant.coe_comap_apply, LocallyConstant.coe_comap_apply] at key
    simpa only [ContinuousMap.coe_mk, Scheme.hom_inv_apply] using key

  have hbij : ∀ V : X.Etale, Function.Bijective (LocallyConstant.comapAddMonoidHom
      ⟨Limits.pullback.fst V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))),
        (Limits.pullback.fst V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).continuous⟩ :
      LocallyConstant V.left (ULift.{u+1} (ZMod m)) →+ LocallyConstant ↥(Limits.pullback V.hom
          (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))
        (ULift.{u+1} (ZMod m))) := by
    intro V
    obtain ⟨σ, hσ⟩ := hsec V
    have hcσ : ∀ v, Limits.pullback.fst V.hom
        (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) (σ v) = v := by
      intro v
      rw [← Scheme.Hom.comp_apply, hσ]
      rfl
    refine ⟨fun a b hab => LocallyConstant.comap_injective _ (fun v => ⟨σ v, hcσ v⟩) hab,
      fun h => ⟨h.comap ⟨σ, σ.continuous⟩, ?_⟩⟩
    apply LocallyConstant.ext
    intro w
    show h (σ (Limits.pullback.fst V.hom
      (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) w)) = h w
    exact hfib V h _ _ (hcσ _)
  let Ψ : wcEtLC X (ULift.{u+1} (ZMod m)) ≅ wcLCPb (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) (ULift.{u+1} (ZMod m)) :=
    NatIso.ofComponents (fun V => (AddEquiv.ofBijective _ (hbij V.unop)).toAddCommGrpIso) (by
      intro V W g
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro h
      apply LocallyConstant.ext
      intro w
      have key : ((wcEtBaseChange (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).map g.unop).left ≫
          Limits.pullback.fst V.unop.hom (Limits.pullback.fst fX
            (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) =
          Limits.pullback.fst W.unop.hom (Limits.pullback.fst fX
            (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ≫ g.unop.left := by
        exact Limits.pullback.lift_fst _ _ _
      let h' : LocallyConstant V.unop.left (ULift.{u+1} (ZMod m)) := h
      have key2 := congrArg (fun k => h' (k w)) key
      exact key2.symm)
  obtain ⟨ea⟩ := wc_et_push_const_lc_iso (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) (ULift.{u+1} (ZMod m))
    (wc_et_lc_isSheaf _ _) (wc_et_const_to_lc_locBij _ _)
  obtain ⟨φ, hinj, hsurj⟩ := wc_et_const_to_lc_locBij X (ULift.{u+1} (ZMod m))
  have hW : (Scheme.smallEtaleTopology X).W φ :=
    (GrothendieckTopology.W_iff_isLocallyBijective (Scheme.smallEtaleTopology X) φ).mpr
      ⟨hinj, hsurj⟩
  have hI : IsIso ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ) :=
    (GrothendieckTopology.W_iff (Scheme.smallEtaleTopology X) φ).mp hW
  let e1 := @asIso _ _ _ _ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map φ) hI
  exact ⟨ea.symm ≪≫ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).mapIso Ψ).symm ≪≫
    e1.symm⟩

theorem wc_gm_base_change_root_T_laurent : ∀ (K : Type u) [Field K] (X V : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (p : V ⟶ X) (v : V) (ℓ : ℕ) (w : Γ(Limits.pullback p (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))), ⊤)), w ^ ℓ = (Limits.pullback.snd p (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ≫ Limits.pullback.snd fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial K))).inv.hom (LaurentPolynomial.T 1)) → ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (w' : LaurentPolynomial R), w' ^ ℓ = LaurentPolynomial.T 1 :=
by
  intro K _ X V fX p v ℓ w hw
  obtain ⟨σ, hσ⟩ : ∃ σ : CommRingCat.of K ⟶ V.residueField v,
      Spec.map σ = V.fromSpecResidueField v ≫ p ≫ fX :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  obtain ⟨E, hE, hEC⟩ : ∃ E : LaurentPolynomial K →+* LaurentPolynomial (V.residueField v),
      E (LaurentPolynomial.T 1) = LaurentPolynomial.T 1 ∧
      ∀ c : K, E (LaurentPolynomial.C c) = LaurentPolynomial.C (σ.hom c) := by
    refine ⟨LaurentPolynomial.eval₂ (LaurentPolynomial.C.comp σ.hom)
      (LaurentPolynomial.isUnit_T (R := V.residueField v) 1).unit, ?_, ?_⟩
    · rw [LaurentPolynomial.eval₂_T, zpow_one, IsUnit.unit_spec]
    · intro c
      rw [LaurentPolynomial.eval₂_C, RingHom.comp_apply]
  have hstar : CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)) ≫ CommRingCat.ofHom E =
      σ ≫ CommRingCat.ofHom (algebraMap (V.residueField v) (LaurentPolynomial (V.residueField v))) := by
    refine CommRingCat.hom_ext (RingHom.ext fun c => ?_)
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
      LaurentPolynomial.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    exact hEC c
  have h1 : ((Spec.map (CommRingCat.ofHom (algebraMap (V.residueField v)
        (LaurentPolynomial (V.residueField v)))) ≫ V.fromSpecResidueField v) ≫ p) ≫ fX =
      Spec.map (CommRingCat.ofHom E) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) := by
    rw [Category.assoc, Category.assoc, ← hσ, ← Spec.map_comp, ← Spec.map_comp, hstar]
    rfl
  have h2 := (Limits.pullback.lift_fst _ _ h1).symm
  have hzq : Limits.pullback.lift _ _ h2 ≫ (Limits.pullback.snd p (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ≫ Limits.pullback.snd fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) = Spec.map (CommRingCat.ofHom E) := by
    rw [Limits.pullback.lift_snd_assoc, Limits.pullback.lift_snd]
  refine ⟨V.residueField v, inferInstance, inferInstance,
    (Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial (V.residueField v)))).hom.hom
      ((Limits.pullback.lift _ _ h2).appTop.hom w), ?_⟩
  rw [← map_pow, ← map_pow, hw]
  have hcomp := congrArg (fun h => h.hom ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial K))).inv.hom (LaurentPolynomial.T 1)))
    (Scheme.Hom.comp_appTop (Limits.pullback.lift _ _ h2) (Limits.pullback.snd p (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ≫ Limits.pullback.snd fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))))
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hcomp
  rw [← hcomp, hzq]
  have nat := congrArg (fun h => h.hom (LaurentPolynomial.T 1))
    (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom E))
  simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at nat
  rw [← nat, hE]
  exact Iso.inv_hom_id_apply _ _

theorem wc_et_kummer_unit_cocycle : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (Y : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) (ℓ : ℕ), (ℓ : Ω) ≠ 0 → ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (a : (Γ(Y, ⊤))ˣ), ∃ ζ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ I.cocomplex.X 1, ζ ≫ I.cocomplex.d 1 2 = 0 ∧ ∀ (W : Y.Etale) (y : (I.cocomplex.X 0).obj.obj (Opposite.op W)), ((I.cocomplex.d 0 1).hom.app (Opposite.op W)).hom y = (ζ.hom.app (Opposite.op W)).hom (wcConstSec Y (ULift.{u+1} ℤ) W (ULift.up 1)) → ∃ u : (Γ(W.left, ⊤))ˣ, (u : Γ(W.left, ⊤)) ^ ℓ = W.hom.appTop.hom (a : Γ(Y, ⊤)) :=
by
  intro Ω _ _ Y fY ℓ hℓ I a

  have hPBgen : ∀ {A B Q E J₀ J₁ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      (ι : A ⟶ B) (g : B ⟶ Q) (hιg : ι ≫ g = 0), (ShortComplex.mk ι g hιg).ShortExact →
      ∀ (e : A ⟶ E) [IsIso e] (ε : E ⟶ J₀) [Mono ε] (d : J₀ ⟶ J₁) (hεd : ε ≫ d = 0),
      (ShortComplex.mk ε d hεd).Exact → ∀ (φ : B ⟶ J₀) (χ : Q ⟶ J₁),
      ι ≫ φ = e ≫ ε → g ≫ χ = φ ≫ d → IsPullback φ g d χ := by
    intro A B Q E J₀ J₁ ι g hιg hS e _ ε _ d hεd hE φ χ h₁ h₂
    haveI : Mono ι := hS.mono_f
    haveI : Epi g := hS.epi_g
    have w : φ ≫ d = g ≫ χ := h₂.symm
    obtain ⟨c, hc1, hc2⟩ : ∃ c : B ⟶ Limits.pullback d χ,
        c ≫ Limits.pullback.fst d χ = φ ∧ c ≫ Limits.pullback.snd d χ = g :=
      ⟨Limits.pullback.lift φ g w, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    haveI : Mono c := by
      apply Preadditive.mono_of_cancel_zero
      intro Z h hh
      have hφ : h ≫ φ = 0 := by rw [← hc1, ← Category.assoc, hh, Limits.zero_comp]
      have hg : h ≫ g = 0 := by rw [← hc2, ← Category.assoc, hh, Limits.zero_comp]
      obtain ⟨Z', π, hπ, a', ha⟩ := hS.exact.exact_up_to_refinements h hg
      have ha' : π ≫ h = a' ≫ ι := ha
      have hae : a' ≫ e = 0 := by
        rw [← cancel_mono ε, Limits.zero_comp, Category.assoc, ← h₁, ← Category.assoc, ← ha',
          Category.assoc, hφ, Limits.comp_zero]
      have ha0 : a' = 0 := by
        rw [← Category.comp_id a', ← IsIso.hom_inv_id e, ← Category.assoc, hae, Limits.zero_comp]
      rw [ha0, Limits.zero_comp] at ha'
      exact (cancel_epi π).mp (by rw [ha', Limits.comp_zero])
    haveI : Epi c := by
      rw [epi_iff_surjective_up_to_refinements]
      intro Z y
      obtain ⟨Z₁, π₁, hπ₁, b₀, hb₀⟩ :=
        surjective_up_to_refinements_of_epi g (y ≫ Limits.pullback.snd d χ)
      obtain ⟨z, hzdef⟩ : ∃ z : Z₁ ⟶ J₀, z = π₁ ≫ y ≫ Limits.pullback.fst d χ - b₀ ≫ φ := ⟨_, rfl⟩
      have hz : z ≫ d = 0 := by
        rw [hzdef]
        simp only [Preadditive.sub_comp, Category.assoc, Limits.pullback.condition, w]
        rw [reassoc_of% hb₀, sub_self]
      obtain ⟨Z₂, π₂, hπ₂, x₁, hx₁⟩ := hE.exact_up_to_refinements z hz
      have hx₁' : π₂ ≫ z = x₁ ≫ ε := hx₁
      refine ⟨Z₂, π₂ ≫ π₁, epi_comp _ _, π₂ ≫ b₀ + (x₁ ≫ inv e) ≫ ι, ?_⟩
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, hc1, Preadditive.add_comp, h₁, IsIso.inv_hom_id_assoc]
        rw [← hx₁', hzdef, Preadditive.comp_sub]
        abel
      · simp only [Category.assoc, hc2, Preadditive.add_comp, hιg, Limits.comp_zero, add_zero]
        rw [hb₀]
    haveI : IsIso c := isIso_of_mono_of_epi c
    exact IsPullback.of_iso_pullback ⟨w⟩ (asIso c) hc1 hc2

  obtain ⟨ι, hι, hS⟩ := wc_et_kummer_ses_gen Ω Y fY ℓ hℓ
  haveI : Mono ι := hS.mono_f
  haveI : Epi (ℓ • 𝟙 (wcEtGm Y)) := hS.epi_g
  haveI : Injective (I.cocomplex.X 0) := I.injective 0
  obtain ⟨φ, h₁⟩ : ∃ φ : wcEtGm Y ⟶ I.cocomplex.X 0,
      ι ≫ φ = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0
        ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))).inv ≫ I.ι.f 0 :=
    ⟨Injective.factorThru _ ι, Injective.comp_factorThru _ _⟩
  have h0 : ι ≫ φ ≫ I.cocomplex.d 0 1 = 0 := by
    rw [← Category.assoc, h₁, Category.assoc, I.ι_f_zero_comp_complex_d, Limits.comp_zero]
  obtain ⟨χ, hχ⟩ :=
    Limits.CokernelCofork.IsColimit.desc' hS.gIsCokernel (φ ≫ I.cocomplex.d 0 1) h0
  have h₂ : (ℓ • 𝟙 (wcEtGm Y)) ≫ χ = φ ≫ I.cocomplex.d 0 1 := hχ
  have h₃ : χ ≫ I.cocomplex.d 1 2 = 0 := by
    rw [← cancel_epi (ℓ • 𝟙 (wcEtGm Y)), Limits.comp_zero, ← Category.assoc, h₂, Category.assoc,
      I.cocomplex.d_comp_d, Limits.comp_zero]
  have hPB : IsPullback φ (ℓ • 𝟙 (wcEtGm Y)) (I.cocomplex.d 0 1) χ :=
    hPBgen ι _ hι hS _ (I.ι.f 0) (I.cocomplex.d 0 1) I.ι_f_zero_comp_complex_d I.exact₀ φ χ h₁ h₂

  obtain ⟨z, hz⟩ : ∃ z : (wcEtGm Y).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))),
      z = ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).app
        (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom (ULift.up (Additive.ofMul a)) := ⟨_, rfl⟩
  obtain ⟨τ, -, hτ⟩ := wc_et_cocycle_const_map Y (wcEtGm Y) (wcEtGm Y) 0 z (by
    first
    | rfl
    | (change (((sheafToPresheaf _ _).map (0 : wcEtGm Y ⟶ wcEtGm Y)).app _).hom _ = 0
       rw [Functor.map_zero, NatTrans.app_zero, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply])
    | simp)
  refine ⟨τ ≫ χ, by rw [Category.assoc, h₃, Limits.comp_zero], ?_⟩
  intro W y hy
  let q : W ⟶ Scheme.Etale.mk (𝟙 Y) :=
    MorphismProperty.Over.homMk W.hom (Category.comp_id W.hom) trivial
  have hy' : ((I.cocomplex.d 0 1).hom.app (Opposite.op W)).hom y =
      (χ.hom.app (Opposite.op W)).hom (((wcEtGm Y).obj.map q.op).hom z) := by
    rw [← hτ W q]
    exact hy

  have hsec := ((Limits.Types.isPullback_iff _ _ _ _).mp
    ((sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
      (evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W) ⋙
        forget AddCommGrpCat.{u+1}).map_isPullback hPB)).2.2
  obtain ⟨p, hp'⟩ : ∃ p : (wcEtGm Y).obj.obj (Opposite.op W),
      ((ℓ • 𝟙 (wcEtGm Y)).hom.app (Opposite.op W)).hom p = ((wcEtGm Y).obj.map q.op).hom z := by
    obtain ⟨p, -, hp⟩ := hsec y (((wcEtGm Y).obj.map q.op).hom z) hy'
    exact ⟨p, hp⟩

  have hnG : ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (n : ℕ)
      (V : Y.Etale) (x : G.obj.obj (Opposite.op V)),
      ((n • 𝟙 G).hom.app (Opposite.op V)).hom x = n • x := by
    intro G n V x
    induction n with
    | zero => rw [zero_smul, zero_smul]; rfl
    | succ n ih => rw [succ_nsmul, succ_nsmul, ← ih]; rfl
  have hn : ((ℓ • 𝟙 (wcEtGm Y)).hom.app (Opposite.op W)).hom p = ℓ • p := hnG _ ℓ W p

  haveI : IsIso (toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)) :=
    isIso_toSheafify _ (wc_et_gm_pre_isSheaf Y)
  have hbij : ∀ V : (Y.Etale)ᵒᵖ,
      Function.Bijective ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).app V).hom := by
    intro V
    first
    | exact ConcreteCategory.bijective_of_isIso
        ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).app V)
    | exact (asIso ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).app
        V)).addCommGroupIsoToAddEquiv.bijective
  obtain ⟨s', hs'⟩ := (hbij (Opposite.op W)).2 p
  have hnat : ((wcEtGm Y).obj.map q.op).hom z =
      ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).app (Opposite.op W)).hom
        (((wcEtGmPre Y).map q.op).hom (ULift.up (Additive.ofMul a))) := by
    rw [hz]
    exact (congrArg (fun f => AddCommGrpCat.Hom.hom f (ULift.up (Additive.ofMul a)))
      ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).naturality q.op)).symm
  have hkey : ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).app (Opposite.op W)).hom
        (ℓ • s') =
      ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).app (Opposite.op W)).hom
        (((wcEtGmPre Y).map q.op).hom (ULift.up (Additive.ofMul a))) := by
    rw [map_nsmul, hs']
    exact hn.symm.trans (hp'.trans hnat)
  have h4 := (hbij (Opposite.op W)).1 hkey
  obtain ⟨v, hv⟩ : ∃ v : (Γ(W.left, ⊤))ˣ, v = Additive.toMul s'.down := ⟨_, rfl⟩
  refine ⟨v, ?_⟩
  have h5 := congrArg (fun t : (wcEtGmPre Y).obj (Opposite.op W) =>
    ((Additive.toMul t.down : (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤))) h4
  have e2 : (Additive.toMul (ℓ • s').down : (Γ(W.left, ⊤))ˣ) = v ^ ℓ := by
    subst hv
    first
    | rfl
    | exact toMul_nsmul _ _
    | (rw [ULift.smul_down, toMul_nsmul])
  have e3 : ((Additive.toMul (((wcEtGmPre Y).map q.op).hom
      (ULift.up (Additive.ofMul a))).down : (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤)) =
      W.hom.appTop.hom (a : Γ(Y, ⊤)) := by
    first
    | rfl
    | simp [wcEtGmPre, q]
  calc (v : Γ(W.left, ⊤)) ^ ℓ
      = ((v ^ ℓ : (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤)) := (Units.val_pow_eq_pow_val _ _).symm
    _ = ((Additive.toMul (ℓ • s').down : (Γ(W.left, ⊤))ˣ) : Γ(W.left, ⊤)) := by rw [e2]
    _ = _ := h5
    _ = _ := e3

theorem wc_et_const_zmod_hom_of_torsion_section : ∀ (Y : Scheme.{u}) (m : ℕ) (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (z : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))), m • z = 0 → ∃ ψ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ F, (ψ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom (wcConstSec Y (ULift.{u+1} (ZMod m)) (Scheme.Etale.mk (𝟙 Y)) (ULift.up 1)) = z :=
by
  intro Y m F z hz
  let bang : ∀ W : Y.Etale, W ⟶ Scheme.Etale.mk (𝟙 Y) := fun W =>
    MorphismProperty.Over.homMk W.hom (Category.comp_id _) trivial
  have huniq : ∀ (W : Y.Etale) (q : W ⟶ Scheme.Etale.mk (𝟙 Y)), q = bang W := by
    intro W q
    apply MorphismProperty.Over.Hom.ext
    have h := MorphismProperty.Over.w q
    exact (Category.comp_id _).symm.trans h
  let g : ℤ →+ F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))) :=
    zmultiplesHom (F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))) z
  have hg : g (m : ℤ) = 0 := by
    change ((m : ℤ)) • z = 0
    rw [natCast_zsmul, hz]
  let f₀ : ZMod m →+ F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))) := ZMod.lift m ⟨g, hg⟩
  have hf₀ : f₀ 1 = z := by
    have h := ZMod.lift_coe m ⟨g, hg⟩ (1 : ℤ)
    rw [Int.cast_one] at h
    change f₀ 1 = g 1 at h
    rw [h]
    change (1 : ℤ) • z = z
    exact one_zsmul z
  let x : ∀ U : (Y.Etale)ᵒᵖ, F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))) →+ F.obj.obj U :=
    fun U => (F.obj.map (bang U.unop).op).hom
  have hx : ∀ {U U' : (Y.Etale)ᵒᵖ} (f : U ⟶ U') (a : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))),
      (F.obj.map f).hom (x U a) = x U' a := by
    intro U U' f a
    have h1 := congrArg (fun φ => φ.hom a) (F.obj.map_comp (bang U.unop).op f)
    have h2 : (bang U.unop).op ≫ f = (bang U'.unop).op := by
      change (f.unop ≫ bang U.unop).op = (bang U'.unop).op
      rw [huniq _ (f.unop ≫ bang U.unop)]
    rw [h2] at h1
    exact h1.symm
  let η : (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ F.obj :=
    { app := fun U => AddCommGrpCat.ofHom
        (((x U).comp f₀).comp AddEquiv.ulift.toAddMonoidHom)
      naturality := by
        intro U U' f
        apply AddCommGrpCat.ext
        intro n
        change x U' (f₀ n.down) = (F.obj.map f).hom (x U (f₀ n.down))
        rw [hx] }
  let ψ : (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ F :=
    ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology Y) η F.property)
  have hK : toSheafify (Scheme.smallEtaleTopology Y)
      ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ≫ ψ.hom = η :=
    toSheafify_sheafifyLift (Scheme.smallEtaleTopology Y) η F.property
  refine ⟨ψ, ?_⟩
  have h := congrArg (fun φ => (φ.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom
    (ULift.up (1 : ZMod m))) hK
  change (ψ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom
    (((toSheafify (Scheme.smallEtaleTopology Y)
      ((Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).app
        (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom (ULift.up 1)) =
      x (Opposite.op (Scheme.Etale.mk (𝟙 Y))) (f₀ 1) at h
  have hb : bang (Scheme.Etale.mk (𝟙 Y)) = 𝟙 _ := (huniq _ (𝟙 _)).symm
  have hxT : x (Opposite.op (Scheme.Etale.mk (𝟙 Y))) (f₀ 1) = z := by
    change (F.obj.map (bang (Scheme.Etale.mk (𝟙 Y))).op).hom (f₀ 1) = z
    rw [hb, op_id, F.obj.map_id, hf₀]
    rfl
  exact h.trans hxT

theorem wc_et_ext_const_zmod_torsion : ∀ (Y : Scheme.{u}) (m q : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q, m • x = 0 :=
by
  intro Y m q
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro x
  have hG : (m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) :
      AddCommGrpCat.of (ULift.{u+1} (ZMod m)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod m))) = 0 := by
    apply AddCommGrpCat.hom_ext
    rw [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero]
    ext a
    rw [AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
    first
      | (rw [ULift.smul_down, ULift.zero_down, nsmul_eq_mul, ZMod.natCast_self, zero_mul])
      | (change (m • a.down : ZMod m) = 0; rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul])
      | simp
  have hB : (m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) = 0 := by
    rw [show (m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) =
        (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
          (m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id], hG, Functor.map_zero]
  have hmk : ∀ n : ℕ, x.comp (Abelian.Ext.mk₀ (n • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) (add_zero q) = n • x := by
    intro n
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]
  rw [← hmk m, hB, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

theorem wc_et_stalk_map_zero_local : ∀ (B : Scheme.{u}) (b : B) {E F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}} (ψ : E ⟶ F) (e : E.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 B)))), (wcEtStalk B b).map ψ = 0 → ∃ (V : B.Etale) (r : V ⟶ Scheme.Etale.mk (𝟙 B)) (v : V.left), (F.obj.map r.op).hom ((ψ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 B)))).hom e) = 0 :=
by
  intro B b E F ψ e hψ
  have hnat : wcEtGlobalGerm F b ((ψ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 B)))).hom e)
      = ((wcEtStalk B b).map ψ).hom (wcEtGlobalGerm E b e) := by
    have key := Limits.colimit.ι_map
      (Functor.whiskerLeft (StructuredArrow.proj (Over.mk (wcEtGeomPt B b))
        (Scheme.Etale.forget B)).op ψ.hom)
      (Opposite.op (StructuredArrow.mk (Y := Scheme.Etale.mk (𝟙 B))
        (Over.homMk (wcEtGeomPt B b) (by simp))))
    have key2 := congrArg (fun f => AddCommGrpCat.Hom.hom f e) key
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at key2
    exact key2.symm
  have h1 : wcEtGlobalGerm F b ((ψ.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 B)))).hom e) = 0 := by
    rw [hnat, hψ, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply]
  obtain ⟨W, r, w, -, hW⟩ := wc_et_germ_zero_local B b F _ h1
  exact ⟨W, r, w, hW⟩

theorem wc_et_gm_R1_kummer_section : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))), ∃ ψ : (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))) ⟶ (((wcEtPush (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1, ∀ b : X, (wcEtStalk X b).map ψ ≠ 0 :=
by
  intro K _ _ ℓ hℓ hℓK X fX I
  classical

  have s1 : ∀ (R : Type u) [CommRing R] [IsDomain R] (w : LaurentPolynomial R),
      w ^ ℓ ≠ LaurentPolynomial.T 1 := by
    intro R _ _ w hw
    obtain ⟨n, f, hf⟩ := LaurentPolynomial.exists_T_pow w
    have h1 : Polynomial.toLaurent (f ^ ℓ) =
        Polynomial.toLaurent (Polynomial.X ^ (ℓ * n + 1) : Polynomial R) := by
      rw [map_pow, hf, mul_pow, hw, LaurentPolynomial.T_pow, ← LaurentPolynomial.T_add,
        Polynomial.toLaurent_X_pow]
      congr 1
      push_cast
      ring
    have h2 : f ^ ℓ = Polynomial.X ^ (ℓ * n + 1) := Polynomial.toLaurent_injective h1
    have h3 := congrArg Polynomial.natDegree h2
    rw [Polynomial.natDegree_pow, Polynomial.natDegree_X_pow] at h3
    have h4 : ℓ ∣ ℓ * n + 1 := h3 ▸ dvd_mul_right ℓ _
    have h5 : ℓ ∣ 1 := (Nat.dvd_add_right (dvd_mul_right ℓ n)).mp h4
    exact hℓ.one_lt.ne' (Nat.dvd_one.mp h5)
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Limits.pullback fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _

  obtain ⟨ζ, hζ, hroot⟩ := wc_et_kummer_unit_cocycle K
    (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))
    (Limits.pullback.snd fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) ℓ hℓK I
    ((LaurentPolynomial.isUnit_T (R := K) 1).map
      ((Limits.pullback.snd fX (Spec.map (CommRingCat.ofHom
          (algebraMap K (LaurentPolynomial K))))).appTop.hom.comp
        (Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial K))).inv.hom)).unit

  obtain ⟨Θ, hΘ⟩ := wc_et_push_edge_map
    (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ I 1
  obtain ⟨κ, hκ1, hκ2⟩ := hΘ ζ hζ

  have hσ : ℓ • ((((((wcEtPush (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom
      (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homologyπ 1).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 X)))).hom κ) = 0 := by
    rw [← hκ2, ← map_nsmul, wc_et_ext_const_zmod_torsion, map_zero]

  obtain ⟨ψ, hψ⟩ := wc_et_const_zmod_hom_of_torsion_section X ℓ
    ((((wcEtPush (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom
      (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homology 1) _ hσ
  refine ⟨ψ, fun b hb => ?_⟩

  obtain ⟨V, r, v, hV⟩ := wc_et_stalk_map_zero_local X b ψ
    (wcConstSec X (ULift.{u+1} (ZMod ℓ)) (Scheme.Etale.mk (𝟙 X)) (ULift.up 1)) hb
  rw [hψ] at hV

  obtain ⟨W, h, w, y, -, hy⟩ := wc_et_push_cycle_local_boundary
    (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))
    I.cocomplex 1 (Scheme.Etale.mk (𝟙 X)) V r κ _ hV hκ1 v
  have hp : (ComplexShape.up ℕ).prev 1 = 0 := CochainComplex.prev_nat_succ 0
  revert y
  rw [hp]
  intro y hy

  have hc : ((I.cocomplex.X 1).obj.map ((wcEtBaseChange (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).map (h ≫ r)).op).hom
      ((ζ.hom.app (Opposite.op ((wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom
          (algebraMap K (LaurentPolynomial K)))))).obj (Scheme.Etale.mk (𝟙 X))))).hom
        (wcConstSec (Limits.pullback fX (Spec.map (CommRingCat.ofHom
          (algebraMap K (LaurentPolynomial K))))) (ULift.{u+1} ℤ)
          ((wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom
            (algebraMap K (LaurentPolynomial K)))))).obj (Scheme.Etale.mk (𝟙 X))) (ULift.up 1))) =
      (ζ.hom.app (Opposite.op ((wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom
          (algebraMap K (LaurentPolynomial K)))))).obj W))).hom
        (wcConstSec (Limits.pullback fX (Spec.map (CommRingCat.ofHom
          (algebraMap K (LaurentPolynomial K))))) (ULift.{u+1} ℤ)
          ((wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom
            (algebraMap K (LaurentPolynomial K)))))).obj W) (ULift.up 1)) := by
    have e1 := congrArg (fun f => AddCommGrpCat.Hom.hom f
      (wcConstSec (Limits.pullback fX (Spec.map (CommRingCat.ofHom
        (algebraMap K (LaurentPolynomial K))))) (ULift.{u+1} ℤ)
        ((wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom
          (algebraMap K (LaurentPolynomial K)))))).obj (Scheme.Etale.mk (𝟙 X))) (ULift.up 1)))
      (ζ.hom.naturality ((wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom
          (algebraMap K (LaurentPolynomial K)))))).map (h ≫ r)).op)
    have e2 := congrArg (fun f => AddCommGrpCat.Hom.hom f (ULift.up 1 : ULift.{u+1} ℤ))
      ((toSheafify (Scheme.smallEtaleTopology (Limits.pullback fX (Spec.map (CommRingCat.ofHom
          (algebraMap K (LaurentPolynomial K))))))
        ((Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))).naturality
        ((wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom
          (algebraMap K (LaurentPolynomial K)))))).map (h ≫ r)).op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at e1 e2
    rw [← e1]
    congr 1
    exact e2.symm
  have hnat := hy.trans hc

  obtain ⟨u, hu⟩ := hroot _ y hnat

  obtain ⟨R, _, _, w', hw'⟩ := wc_gm_base_change_root_T_laurent K X W.left fX W.hom w ℓ
    (show Γ(Limits.pullback W.hom (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom
      (algebraMap K (LaurentPolynomial K))))), ⊤) from u.1) (by
    first
    | exact hu
    | (rw [Scheme.Hom.comp_appTop]; exact hu)
    | (rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]; exact hu))
  exact s1 R w' hw'

theorem wc_et_zariski_mv_card_le_rev : ∀ (Y : Scheme.{u}) (V A B : Y.Opens), A ⊔ B = V → ∀ (m q : ℕ), Finite (wcEtCoh (A : Scheme.{u}) m q) → Finite (wcEtCoh (B : Scheme.{u}) m q) → Finite (wcEtCoh (V : Scheme.{u}) m (q + 1)) → Finite (wcEtCoh ((A ⊓ B : Y.Opens) : Scheme.{u}) m q) ∧ Nat.card (wcEtCoh ((A ⊓ B : Y.Opens) : Scheme.{u}) m q) ≤ Nat.card (wcEtCoh (A : Scheme.{u}) m q) * Nat.card (wcEtCoh (B : Scheme.{u}) m q) * Nat.card (wcEtCoh (V : Scheme.{u}) m (q + 1)) :=
by
  classical
  intro Y V A B hAB m q hfA hfB hfV



  have count : ∀ {G H P₁ P₂ : Type (u+2)} [AddCommGroup G] [AddCommGroup H] [AddCommGroup P₁]
      [AddCommGroup P₂] (δ : G →+ H) (β₁ : P₁ →+ G) (β₂ : P₂ →+ G),
      Finite H → Finite P₁ → Finite P₂ →
      (∀ x : G, δ x = 0 → ∃ (a : P₁) (b : P₂), β₁ a + β₂ b = x) →
      Finite G ∧ Nat.card G ≤ Nat.card P₁ * Nat.card P₂ * Nat.card H := by
    intro G H P₁ P₂ _ _ _ _ δ β₁ β₂ hH hP₁ hP₂ hex
    let β : P₁ × P₂ →+ G := β₁.coprod β₂
    have hK : δ.ker ≤ β.range := by
      intro x hx
      rw [AddMonoidHom.mem_ker] at hx
      obtain ⟨a, b, hab⟩ := hex x hx
      exact ⟨(a, b), by rw [AddMonoidHom.coprod_apply]; exact hab⟩
    haveI : Finite β.range := Finite.of_surjective _ β.rangeRestrict_surjective
    have h1 : Nat.card β.range ≤ Nat.card (P₁ × P₂) :=
      Nat.card_le_card_of_surjective _ β.rangeRestrict_surjective
    haveI : Finite δ.ker := Finite.of_injective _ (AddSubgroup.inclusion_injective hK)
    have h2 : Nat.card δ.ker ≤ Nat.card β.range := AddSubgroup.card_le_of_le hK
    let e := QuotientAddGroup.quotientKerEquivRange δ
    have hinj : Function.Injective (fun x : δ.range => (x : H)) := Subtype.val_injective
    haveI : Finite δ.range := Finite.of_injective _ hinj
    haveI : Finite (G ⧸ δ.ker) := Finite.of_equiv _ e.toEquiv.symm
    have h3 : Nat.card (G ⧸ δ.ker) ≤ Nat.card H := by
      rw [Nat.card_congr e.toEquiv]
      exact Nat.card_le_card_of_injective _ hinj
    have hc := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup δ.ker
    have hp1 : 0 < Nat.card (G ⧸ δ.ker) := Nat.card_pos
    have hp2 : 0 < Nat.card δ.ker := Nat.card_pos
    refine ⟨Nat.finite_of_card_ne_zero (by rw [hc]; positivity), ?_⟩
    rw [hc]
    calc Nat.card (G ⧸ δ.ker) * Nat.card δ.ker ≤ Nat.card H * Nat.card (P₁ × P₂) :=
          Nat.mul_le_mul h3 (h2.trans h1)
      _ = Nat.card P₁ * Nat.card P₂ * Nat.card H := by rw [Nat.card_prod]; ring



  have s3 : ∀ (X : Scheme.{u}) (W : X.Opens) (p : ℕ), Nonempty ((letI : HasExt (Sheaf
      (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _;
      Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (yoneda.obj ((wcZarToEt X).obj W) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
        ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) p) ≃ wcEtCoh (W : Scheme.{u}) m p) := by
    intro X W p
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    let T : X.Etale := (wcZarToEt X).obj W
    haveI : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology X) := (wc_et_slice_continuous T).1
    haveI : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology X) := (wc_et_slice_continuous T).2
    obtain ⟨Ψ₂⟩ := wc_et_ext_free_slice X T
      ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) p
    letI hExtT : HasExt (Sheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    let γ : (constantSheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ≅
        ((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj
          ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) :=
      (Functor.pushforwardContinuousSheafificationCompatibility (wcEtSlice T) AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).app
        ((Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    let ZcT := (constantSheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))
    have hΨ₃ : Function.Bijective (fun y : Abelian.Ext ZcT
        (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj
          ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
            (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) p =>
        y.comp (Abelian.Ext.mk₀ γ.inv) (add_zero p)) := by
      refine ⟨fun y₁ y₂ hy => ?_, fun z => ⟨z.comp (Abelian.Ext.mk₀ γ.hom) (add_zero p), ?_⟩⟩
      · have hy' := congrArg (fun t => t.comp (Abelian.Ext.mk₀ γ.hom) (add_zero p)) hy
        simp only at hy'
        rwa [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
          Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id,
          Abelian.Ext.comp_mk₀_id] at hy'
      · simp only
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    exact ⟨Ψ₂.trans (Equiv.ofBijective _ hΨ₃)⟩



  have s4 : ∀ (W : Y.Opens) (W' : (V : Scheme.{u}).Opens), W ≤ V →
      (W' : Set (V : Scheme.{u})) = V.ι ⁻¹' (W : Set Y) → ∀ p : ℕ,
      Nonempty (wcEtCoh (W' : Scheme.{u}) m p ≃ wcEtCoh (W : Scheme.{u}) m p) := by
    intro W W' hWV hW' p
    have hr : Set.range (W'.ι ≫ V.ι) = Set.range W.ι := by
      ext x
      rw [Scheme.Opens.range_ι]
      constructor
      · rintro ⟨y, rfl⟩
        rw [Scheme.Hom.comp_apply]
        have hy : W'.ι y ∈ Set.range W'.ι := Set.mem_range_self _
        rw [Scheme.Opens.range_ι, hW'] at hy
        exact hy
      · intro hx
        have hxV : x ∈ Set.range V.ι := by
          rw [Scheme.Opens.range_ι]
          exact hWV hx
        obtain ⟨v, rfl⟩ := hxV
        have hv : v ∈ Set.range W'.ι := by
          rw [Scheme.Opens.range_ι, hW']
          exact hx
        obtain ⟨w, rfl⟩ := hv
        exact ⟨w, Scheme.Hom.comp_apply _ _ _⟩
    let e := IsOpenImmersion.isoOfRangeEq (W'.ι ≫ V.ι) W.ι hr
    obtain ⟨e'⟩ := wc_et_coh_iso_invariance e.hom m p
    exact ⟨e'.symm⟩



  have hAV : A ≤ V := by rw [← hAB]; exact le_sup_left
  have hBV : B ≤ V := by rw [← hAB]; exact le_sup_right
  have hcov : V.ι ⁻¹ᵁ A ⊔ V.ι ⁻¹ᵁ B = ⊤ := by
    rw [← Scheme.Hom.preimage_sup, hAB, Scheme.Opens.ι_preimage_self]
  letI hExt : HasExt (Sheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  obtain ⟨f, g, hfg, hS⟩ := wc_et_free_mayer_vietoris_ses (V : Scheme.{u}) (V.ι ⁻¹ᵁ A)
    (V.ι ⁻¹ᵁ B) hcov

  have gen : ∀ {Z W X' L : Sheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}}
      (a : Z ⟶ W) (b : W ⟶ X') (γ : Abelian.Ext X' L q),
      (Abelian.Ext.mk₀ (a ≫ b)).comp γ (zero_add q) =
        (Abelian.Ext.mk₀ a).comp ((Abelian.Ext.mk₀ b).comp γ (zero_add q)) (zero_add q) := by
    intro Z W X' L a b γ
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have hexact : ∀ x : Abelian.Ext
      ((presheafToSheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}).obj
        (yoneda.obj ((wcZarToEt (V : Scheme.{u})).obj (V.ι ⁻¹ᵁ A ⊓ V.ι ⁻¹ᵁ B)) ⋙
          uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      ((constantSheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q,
      hS.extClass.comp x (Nat.add_comm 1 q) = 0 →
      ∃ a b, (Abelian.Ext.mk₀ (f ≫ Limits.biprod.fst)).comp a (zero_add q) +
        (Abelian.Ext.mk₀ (f ≫ Limits.biprod.snd)).comp b (zero_add q) = x := by
    intro x hx
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS _ x (Nat.add_comm 1 q) hx
    refine ⟨(Abelian.Ext.mk₀ Limits.biprod.inl).comp x₂ (zero_add q),
      (Abelian.Ext.mk₀ Limits.biprod.inr).comp x₂ (zero_add q), ?_⟩
    have e : f = (f ≫ Limits.biprod.fst) ≫ Limits.biprod.inl +
        (f ≫ Limits.biprod.snd) ≫ Limits.biprod.inr := by
      rw [Category.assoc, Category.assoc, ← Preadditive.comp_add, Limits.biprod.total,
        Category.comp_id]
    rw [← gen, ← gen, ← Abelian.Ext.add_comp, ← Abelian.Ext.mk₀_add, ← e]
    exact hx₂

  obtain ⟨eAB⟩ := s3 (V : Scheme.{u}) (V.ι ⁻¹ᵁ A ⊓ V.ι ⁻¹ᵁ B) q
  obtain ⟨eAB'⟩ := s4 (A ⊓ B) (V.ι ⁻¹ᵁ A ⊓ V.ι ⁻¹ᵁ B) (inf_le_left.trans hAV) rfl q
  obtain ⟨eA⟩ := s3 (V : Scheme.{u}) (V.ι ⁻¹ᵁ A) q
  obtain ⟨eA'⟩ := s4 A (V.ι ⁻¹ᵁ A) hAV rfl q
  obtain ⟨eB⟩ := s3 (V : Scheme.{u}) (V.ι ⁻¹ᵁ B) q
  obtain ⟨eB'⟩ := s4 B (V.ι ⁻¹ᵁ B) hBV rfl q
  obtain ⟨hfin, hcard⟩ := count
    (hS.extClass.precomp
      ((constantSheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (Nat.add_comm 1 q))
    ((Abelian.Ext.mk₀ (f ≫ Limits.biprod.fst)).precomp
      ((constantSheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (zero_add q))
    ((Abelian.Ext.mk₀ (f ≫ Limits.biprod.snd)).precomp
      ((constantSheaf (Scheme.smallEtaleTopology (V : Scheme.{u})) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) (zero_add q))
    hfV
    (Finite.of_equiv _ (eA.trans eA').symm)
    (Finite.of_equiv _ (eB.trans eB').symm)
    (fun x h0 => hexact x h0)
  haveI := hfin
  refine ⟨Finite.of_equiv _ (eAB.trans eAB'), ?_⟩
  rw [← Nat.card_congr (eAB.trans eAB'), ← Nat.card_congr (eA.trans eA'),
    ← Nat.card_congr (eB.trans eB')]
  exact hcard

theorem wc_projK_one_affine_chart : ∀ (K : Type u) [Field K] (a : Fin (1 + 1)), ∃ e : (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a) : Scheme.{u}) ≅ Spec (.of (Polynomial K)), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) = (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a)).ι ≫ wcProjKStr K 1 :=
by
  intro K _ a
  show ∃ e : (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a) : Scheme.{u}) ≅ Spec (.of (Polynomial K)), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) = (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a)).ι ≫ (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0))))
  have hrev : a.rev ≠ a := by revert a; decide
  have hcases : ∀ i : Fin (1 + 1), i = a ∨ i = a.rev := by revert a; decide
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have hscale : ∀ {S : Type u} [CommRing S] (f : K →+* S) (x : Fin (1 + 1) → S) (s : S)
      (p : MvPolynomial (Fin (1 + 1)) K) (n : ℕ), p.IsHomogeneous n →
      MvPolynomial.eval₂ f (fun i => s * x i) p = s ^ n * MvPolynomial.eval₂ f x p := by
    intro S _ f x s p n hp
    rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    have hdeg : ∑ i ∈ d.support, d i = n := by
      have h := hp (MvPolynomial.mem_support_iff.mp hd)
      simpa [Finsupp.weight_apply, Finsupp.sum] using h
    simp_rw [mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring
  have hf : (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 1 := by
    rw [MvPolynomial.mem_homogeneousSubmodule]; exact MvPolynomial.isHomogeneous_X K a
  have hb : (MvPolynomial.X a.rev : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (1 • 1) := by
    rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule]
    exact MvPolynomial.isHomogeneous_X K a.rev

  let T : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      (MvPolynomial.X a) :=
    HomogeneousLocalization.Away.mk _ hf 1 (MvPolynomial.X a.rev) hb
  let ι₀ := HomogeneousLocalization.fromZeroRingHom
    (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (Submonoid.powers (MvPolynomial.X a))
  let c₀ := algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)
  let ψ : Polynomial K →+* HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a) :=
    Polynomial.eval₂RingHom (ι₀.comp c₀) T
  let χ₀ : MvPolynomial (Fin (1 + 1)) K →+* Polynomial K :=
    MvPolynomial.eval₂Hom Polynomial.C (fun i => if i = a then 1 else Polynomial.X)
  have hχa : χ₀ (MvPolynomial.X a) = 1 := by simp [χ₀]
  have hχb : χ₀ (MvPolynomial.X a.rev) = Polynomial.X := by simp [χ₀, hrev]
  have hχC : ∀ k, χ₀ (MvPolynomial.C k) = Polynomial.C k := by intro k; simp [χ₀]
  let Λ : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) →+* Polynomial K :=
    IsLocalization.Away.lift (MvPolynomial.X a) (g := χ₀) (by rw [hχa]; exact isUnit_one)
  have hΛ : ∀ p, Λ (algebraMap _ (Localization.Away (MvPolynomial.X a :
      MvPolynomial (Fin (1 + 1)) K)) p) = χ₀ p := fun p => IsLocalization.Away.lift_eq _ _ p
  let χ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      (MvPolynomial.X a) →+* Polynomial K :=
    Λ.comp (algebraMap _ (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)))
  have hΛ1 : ∀ y : Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K),
      Λ (IsLocalization.mk' (Localization.Away (MvPolynomial.X a :
        MvPolynomial (Fin (1 + 1)) K)) 1 y) = 1 := by
    intro y
    have h := congrArg Λ (IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X a :
        MvPolynomial (Fin (1 + 1)) K)) (1 : MvPolynomial (Fin (1 + 1)) K) y)
    rw [map_mul, hΛ, hΛ] at h
    obtain ⟨n, hn⟩ := y.2
    rw [← hn, map_pow, hχa, one_pow, mul_one, map_one] at h
    exact h
  have F1 : ∀ n p hp, χ (HomogeneousLocalization.Away.mk _ hf n p hp) = χ₀ p := by
    intro n p hp
    simp only [χ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
      HomogeneousLocalization.Away.val_mk]
    rw [Localization.mk_eq_mk', IsLocalization.mk'_eq_mul_mk'_one, map_mul, hΛ, hΛ1, mul_one]
  have F0 : ∀ k : K, (ι₀ (c₀ k)).val = algebraMap (MvPolynomial (Fin (1 + 1)) K)
      (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)) (MvPolynomial.C k) := by
    intro k
    rw [← Localization.mk_one_eq_algebraMap]
    rfl
  have hψC : ∀ k, ψ (Polynomial.C k) = ι₀ (c₀ k) := by
    intro k; simp [ψ]
  have hψX : ψ Polynomial.X = T := by simp [ψ]
  have hi : χ.comp ψ = RingHom.id _ := by
    apply Polynomial.ringHom_ext
    · intro k
      rw [RingHom.comp_apply, hψC, RingHom.id_apply]
      simp only [χ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
      rw [F0, hΛ, hχC]
    · rw [RingHom.comp_apply, hψX, RingHom.id_apply, F1, hχb]
  have hii : ψ.comp χ = RingHom.id _ := by
    apply RingHom.ext
    intro y
    obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective _ hf y
    rw [RingHom.comp_apply, F1, RingHom.id_apply]
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk]
    let u : Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
      Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩
    let V : MvPolynomial (Fin (1 + 1)) K →+*
        Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
      (algebraMap _ _).comp (ψ.comp χ₀)
    let W : MvPolynomial (Fin (1 + 1)) K →+*
        Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K) :=
      MvPolynomial.eval₂Hom (algebraMap K _) (fun i : Fin (1 + 1) => u *
        algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)) (MvPolynomial.X i))
    have hKA : ∀ k : K, algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)) (MvPolynomial.C k)
        = algebraMap K _ k := by
      intro k
      rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)),
        MvPolynomial.algebraMap_eq]
    have hVW : V = W := by
      apply MvPolynomial.ringHom_ext
      · intro k
        simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hχC, hψC,
          HomogeneousLocalization.algebraMap_apply]
        rw [F0, hKA]
      · intro i
        rcases hcases i with rfl | rfl
        · simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hχa, map_one, u]
          rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
          exact (Localization.mk_self (⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ :
            Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) K))).symm
        · simp only [V, W, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', hχb, hψX, u,
            HomogeneousLocalization.algebraMap_apply, T, HomogeneousLocalization.Away.val_mk]
          rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
          congr 1
          ext
          simp
    have hval : (ψ (χ₀ p)).val = V p := by
      simp only [V, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
    have hph : p.IsHomogeneous n := by
      have hp' := hp
      rw [smul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule] at hp'
      exact hp'
    have heta : MvPolynomial.eval₂ (algebraMap K (Localization.Away (MvPolynomial.X a :
        MvPolynomial (Fin (1 + 1)) K))) (fun i : Fin (1 + 1) =>
          algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)) (MvPolynomial.X i)) p =
        algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)) p := by
      have h := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (1 + 1)) K)))
        MvPolynomial.C MvPolynomial.X p
      rw [MvPolynomial.eval₂_eta] at h
      rw [h, ← MvPolynomial.algebraMap_eq, ← IsScalarTower.algebraMap_eq]
      rfl
    rw [hval, hVW]
    simp only [W, MvPolynomial.coe_eval₂Hom]
    rw [hscale _ _ u p n hph, heta, ← Localization.mk_one_eq_algebraMap]
    simp only [u]
    rw [Localization.mk_pow, Localization.mk_mul, one_pow, one_mul, mul_one]
    congr 1

  let e2 : Spec (.of (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X a))) ≅
      Spec (.of (Polynomial K)) :=
    { hom := Spec.map (CommRingCat.ofHom ψ)
      inv := Spec.map (CommRingCat.ofHom χ)
      hom_inv_id := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hii]
        exact Spec.map_id _
      inv_hom_id := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hi]
        exact Spec.map_id _ }
  have hcomp : ψ.comp (algebraMap K (Polynomial K)) =
      (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (Submonoid.powers (MvPolynomial.X a))).comp
        (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) := by
    rw [Polynomial.algebraMap_eq]
    exact RingHom.ext hψC
  refine ⟨Proj.basicOpenIsoSpec (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
    (MvPolynomial.X a) hf Nat.one_pos ≪≫ e2, ?_⟩
  rw [Iso.trans_hom, Category.assoc]
  change _ ≫ Spec.map (CommRingCat.ofHom ψ) ≫ _ = _
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp, CommRingCat.ofHom_comp, Spec.map_comp,
    ← Proj.awayι_toSpecZero _ _ hf Nat.one_pos, ← Proj.basicOpenIsoSpec_inv_ι _ _ hf Nat.one_pos]
  simp only [Category.assoc, Iso.hom_inv_id_assoc]

theorem wc_projK_one_overlap_laurent : ∀ (K : Type u) [Field K], ∃ e : ((@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X 0) ⊓ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X 1) : (wcProjK K 1).Opens) : Scheme.{u}) ≅ Spec (.of (LaurentPolynomial K)), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) = (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X 0) ⊓ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X 1) : (wcProjK K 1).Opens).ι ≫ wcProjKStr K 1 :=
by
  intro K _
  letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K))

  have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (1 + 1) → S) (t : S) (n : ℕ)
      (G : MvPolynomial (Fin (1 + 1)) K), G.IsHomogeneous n →
      MvPolynomial.eval₂ φ (fun j => t * x j) G = t ^ n * MvPolynomial.eval₂ φ x G := by
    intro S _ φ x t n G hG
    conv_lhs => rw [G.as_sum]
    conv_rhs => rw [G.as_sum]
    rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    have hdeg : Finsupp.degree d = n := by
      by_contra h
      exact (MvPolynomial.mem_support_iff.mp hd) (hG.coeff_eq_zero h)
    rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
    have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
      simp only [mul_pow]
      rw [Finsupp.prod_mul]
      congr 1
      rw [← hdeg, Finsupp.degree_apply]
      unfold Finsupp.prod
      rw [Finset.prod_pow_eq_pow_sum]
    rw [hp]
    ring
  have alg : ∀ {S : Type u} [CommRing S] (y w a0 a1 g : S) (n : ℕ), w * a0 = 1 →
      y * (w * a1) ^ n = w ^ (n * 2) * g → y * (a0 * a1) ^ n = g := by
    intro S _ y w a0 a1 g n hw hk
    calc y * (a0 * a1) ^ n = (w * a0) ^ n * (y * (a0 * a1) ^ n) := by rw [hw, one_pow, one_mul]
      _ = (y * (w * a1) ^ n) * a0 ^ (n * 2) := by ring
      _ = (w ^ (n * 2) * g) * a0 ^ (n * 2) := by rw [hk]
      _ = (w * a0) ^ (n * 2) * g := by ring
      _ = g := by rw [hw, one_pow, one_mul]

  have hF : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 2 :=
    (MvPolynomial.mem_homogeneousSubmodule 2 _).2
      ((MvPolynomial.isHomogeneous_X K 0).mul (MvPolynomial.isHomogeneous_X K 1))
  have h0 : (MvPolynomial.X 0 ^ 2 : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (1 • 2) := by
    rw [smul_eq_mul]
    exact (MvPolynomial.mem_homogeneousSubmodule _ _).2 ((MvPolynomial.isHomogeneous_X K 0).pow 2)
  have h1 : (MvPolynomial.X 1 ^ 2 : MvPolynomial (Fin (1 + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (1 • 2) := by
    rw [smul_eq_mul]
    exact (MvPolynomial.mem_homogeneousSubmodule _ _).2 ((MvPolynomial.isHomogeneous_X K 1).pow 2)

  have hιinj : Function.Injective (algebraMap (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))
      (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))) := by
    intro a b h
    rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.algebraMap_apply] at h
    exact HomogeneousLocalization.val_injective _ h

  obtain ⟨ρt, hρC, hρ0, hρ1'⟩ : ∃ ρt : MvPolynomial (Fin (1 + 1)) K →+* LaurentPolynomial K,
      (∀ c : K, ρt (MvPolynomial.C c) = LaurentPolynomial.C c) ∧ ρt (MvPolynomial.X 0) = 1 ∧
      ρt (MvPolynomial.X 1) = LaurentPolynomial.T 1 :=
    ⟨MvPolynomial.eval₂Hom LaurentPolynomial.C
        (fun j => if j = 0 then 1 else LaurentPolynomial.T 1),
      fun c => by rw [MvPolynomial.eval₂Hom_C],
      by rw [MvPolynomial.eval₂Hom_X', if_pos rfl],
      by rw [MvPolynomial.eval₂Hom_X', if_neg (by decide)]⟩
  have hρF : ρt (MvPolynomial.X 0 * MvPolynomial.X 1) = LaurentPolynomial.T 1 := by
    rw [map_mul, hρ0, hρ1', one_mul]
  have hu : IsUnit (ρt (MvPolynomial.X 0 * MvPolynomial.X 1)) := by
    rw [hρF]; exact LaurentPolynomial.isUnit_T 1

  obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1) →+*
      LaurentPolynomial K,
      (∀ z y, algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K)) z =
        algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K)) y →
          ρ z = ρt y) ∧
      (∀ (n : ℕ) (G : MvPolynomial (Fin (1 + 1)) K)
        (hG : G ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K (n • 2)),
        ρ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          hF n G hG) * LaurentPolynomial.T (n : ℤ) = ρt G) := by
    refine ⟨(IsLocalization.Away.lift (MvPolynomial.X 0 * MvPolynomial.X 1) hu :
        Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K) →+*
          LaurentPolynomial K).comp (algebraMap _ _), ?_, ?_⟩
    · intro z y hzy
      rw [RingHom.comp_apply, hzy, IsLocalization.Away.lift_eq]
    · intro n G hG
      rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      have hs := IsLocalization.mk'_spec
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K)) G
        (⟨(MvPolynomial.X 0 * MvPolynomial.X 1) ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
          Submonoid.powers (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
      rw [← Localization.mk_eq_mk'_apply] at hs
      have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X 0 * MvPolynomial.X 1) hu :
        Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K) →+*
          LaurentPolynomial K) hs
      rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
      simp only [map_pow, hρF, LaurentPolynomial.T_pow, mul_one] at hs2
      exact hs2

  obtain ⟨w, hw0⟩ : ∃ w : Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 :
      MvPolynomial (Fin (1 + 1)) K),
      w * algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (MvPolynomial.X 0) = 1 := by
    refine ⟨Localization.mk (MvPolynomial.X 1)
      ⟨MvPolynomial.X 0 * MvPolynomial.X 1, Submonoid.mem_powers _⟩, ?_⟩
    rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, mul_one,
      mul_comm (MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K)]
    exact Localization.mk_self (⟨MvPolynomial.X 0 * MvPolynomial.X 1, Submonoid.mem_powers _⟩ :
      Submonoid.powers (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))

  have hιu : algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          hF 1 (MvPolynomial.X 1 ^ 2) h1) =
      w * algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (MvPolynomial.X 1) := by
    rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
      Localization.mk_eq_mk'_apply, IsLocalization.mk'_eq_iff_eq_mul]
    simp only [map_pow, map_mul, pow_one]
    linear_combination (-(algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (MvPolynomial.X 1)) ^ 2) * hw0
  have hιv : algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          hF 1 (MvPolynomial.X 0 ^ 2) h0) *
      (algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (MvPolynomial.X 0) *
      algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (MvPolynomial.X 1)) =
      algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (MvPolynomial.X 0) ^ 2 := by
    rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
      Localization.mk_eq_mk'_apply]
    have hs := IsLocalization.mk'_spec
      (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
      (MvPolynomial.X 0 ^ 2)
      (⟨(MvPolynomial.X 0 * MvPolynomial.X 1) ^ 1, pow_mem (Submonoid.mem_powers _) 1⟩ :
        Submonoid.powers (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
    simp only [map_pow, map_mul, pow_one] at hs ⊢
    exact hs
  obtain ⟨U, hU⟩ : ∃ U : (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))ˣ,
      (U : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1)) =
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          hF 1 (MvPolynomial.X 1 ^ 2) h1 := by
    have huv : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          hF 1 (MvPolynomial.X 1 ^ 2) h1 *
        HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          hF 1 (MvPolynomial.X 0 ^ 2) h0 = 1 := by
      apply hιinj
      rw [map_mul, map_one, hιu]
      linear_combination (-(w * algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
          (MvPolynomial.X 1)) *
          algebraMap (HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))
            (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
            (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
              hF 1 (MvPolynomial.X 0 ^ 2) h0) +
          w * algebraMap (MvPolynomial (Fin (1 + 1)) K)
            (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
            (MvPolynomial.X 0) + 1) * hw0 + w ^ 2 * hιv
    exact ⟨⟨_, _, huv, (mul_comm _ _).trans huv⟩, rfl⟩
  have hρU : ρ (U : HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1)) =
      LaurentPolynomial.T 1 := by
    have h := hρ2 1 _ h1
    rw [map_pow, hρ1', Nat.cast_one, sq (LaurentPolynomial.T 1 : LaurentPolynomial K)] at h
    rw [hU]
    exact (LaurentPolynomial.isUnit_T 1).mul_left_inj.mp h

  obtain ⟨ψ, hψC, hψT⟩ : ∃ ψ : LaurentPolynomial K →+* HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1),
      (∀ c : K, ψ (LaurentPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (Submonoid.powers (MvPolynomial.X 0 * MvPolynomial.X 1))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0) c)) ∧
      (∀ n : ℤ, ψ (LaurentPolynomial.T n) = ((U ^ n : (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))ˣ) :
          HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))) :=
    ⟨LaurentPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (Submonoid.powers (MvPolynomial.X 0 * MvPolynomial.X 1))).comp
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0))) U,
      fun c => by rw [LaurentPolynomial.eval₂_C, RingHom.comp_apply],
      fun n => by rw [LaurentPolynomial.eval₂_T]⟩
  have hΨC : ∀ c : K, algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (ψ (LaurentPolynomial.C c)) =
      algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (MvPolynomial.C c) := by
    intro c
    rw [hψC, HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
    have hc : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) : MvPolynomial (Fin (1 + 1)) K) =
        MvPolynomial.C c := by
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    rw [← hc]
    rfl

  have hρψ : ρ.comp ψ = RingHom.id _ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial K))
    apply Polynomial.ringHom_ext
    · intro a
      rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, RingHom.id_apply,
        LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_C,
        hρ1 _ _ (hΨC a), hρC]
    · rw [RingHom.comp_apply, RingHom.comp_apply, RingHom.comp_apply, RingHom.id_apply,
        LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_X,
        hψT, zpow_one, hρU]

  have hcomp : ((algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))).comp
        ψ).comp ρt =
      MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))).comp
          MvPolynomial.C)
        (fun j => w * algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
          (MvPolynomial.X j)) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, RingHom.comp_apply, hρC, hΨC, MvPolynomial.eval₂Hom_C,
        RingHom.comp_apply]
    · intro j
      rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
      rcases (show ∀ j : Fin (1 + 1), j = 0 ∨ j = 1 by decide) j with rfl | rfl
      · rw [hρ0, map_one, map_one, hw0]
      · rw [hρ1', hψT, zpow_one, hU, hιu]
  have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))).comp
          MvPolynomial.C)
        (fun j => algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
          (MvPolynomial.X j)) =
      algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K)) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    · intro j
      rw [MvPolynomial.eval₂Hom_X']
  have key : ∀ (N : ℕ) (G : MvPolynomial (Fin (1 + 1)) K), G.IsHomogeneous N →
      algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (ψ (ρt G)) =
      w ^ N * algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K)) G := by
    intro N G hG
    have h := RingHom.congr_fun hcomp G
    rw [RingHom.comp_apply, RingHom.comp_apply] at h
    rw [h, MvPolynomial.coe_eval₂Hom]
    have hs := scale ((algebraMap (MvPolynomial (Fin (1 + 1)) K)
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))).comp
          MvPolynomial.C)
      (fun j => algebraMap (MvPolynomial (Fin (1 + 1)) K)
          (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
          (MvPolynomial.X j)) w N G hG
    rw [hs, ← MvPolynomial.coe_eval₂Hom, hev]
  have hψρ : ψ.comp ρ = RingHom.id _ := by
    apply RingHom.ext
    intro z
    obtain ⟨n, G, hG, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) hF z
    rw [RingHom.comp_apply, RingHom.id_apply]
    have hGh : G.IsHomogeneous (n * 2) := by
      rw [smul_eq_mul] at hG
      exact (MvPolynomial.mem_homogeneousSubmodule _ G).1 hG
    have h3 := congrArg (fun t => algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1))
        (Localization.Away (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) K))
        (ψ t)) (hρ2 n G hG)
    simp only [map_mul] at h3
    rw [hψT, zpow_natCast, Units.val_pow_eq_pow_val, hU, map_pow, hιu, key _ G hGh] at h3
    apply hιinj
    rw [HomogeneousLocalization.algebraMap_apply (y := HomogeneousLocalization.Away.mk _ hF n G hG),
      HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply,
      IsLocalization.eq_mk'_iff_mul_eq]
    simp only [map_pow, map_mul]
    exact alg _ _ _ _ _ n hw0 h3
  obtain ⟨e, he⟩ : ∃ e : LaurentPolynomial K ≃+* HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1),
      ∀ c : K, e (LaurentPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (Submonoid.powers (MvPolynomial.X 0 * MvPolynomial.X 1))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0) c) :=
    ⟨RingEquiv.ofRingHom ψ ρ hψρ hρψ, fun c => by rw [RingEquiv.ofRingHom_apply, hψC]⟩

  have hEq : (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X 0) ⊓ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X 1) : (wcProjK K 1).Opens) =
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X 0 * MvPolynomial.X 1) :=
    (Proj.basicOpen_mul _ _ _).symm
  let bO := Proj.basicOpenIsoSpec (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
    (MvPolynomial.X 0 * MvPolynomial.X 1) hF two_pos
  have hι : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      (MvPolynomial.X 0 * MvPolynomial.X 1)).ι =
      bO.hom ≫ Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        (MvPolynomial.X 0 * MvPolynomial.X 1) hF two_pos := by
    rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
  have hring : CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)) ≫
      CommRingCat.ofHom (e : LaurentPolynomial K →+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (MvPolynomial.X 0 * MvPolynomial.X 1)) =
      CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
          (Submonoid.powers (MvPolynomial.X 0 * MvPolynomial.X 1))) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply RingHom.ext
    intro c
    rw [RingHom.comp_apply, RingHom.comp_apply, LaurentPolynomial.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply]
    exact he c
  refine ⟨Scheme.isoOfEq _ hEq ≪≫ bO ≪≫ Scheme.Spec.mapIso e.toCommRingCatIso.op, ?_⟩
  rw [Iso.trans_hom, Iso.trans_hom, Functor.mapIso_hom, Iso.op_hom,
    RingEquiv.toCommRingCatIso_hom, Scheme.Spec_map, Quiver.Hom.unop_op,
    ← Scheme.isoOfEq_hom_ι _ hEq, hι]
  simp only [Category.assoc, wcProjKStr]
  rw [← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero, ← Spec.map_comp,
    ← Spec.map_comp, hring]

theorem wc_et_henselian_P1_coh_card : ∀ (K : Type u) [Field K] [IsAlgClosed K] (m : ℕ), (m : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (q : ℕ), Nat.card (wcEtCoh (Limits.pullback (wcProjKStr K 1) s) m q) = Nat.card (wcEtCoh (wcProjK K 1) m q) :=
by
  intro K _ _ m hmK A _ _ _ s q
  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hmK Nat.cast_zero
  haveI : IsProper (wcProjKStr K 1) := wc_proj_space_isProper K 1
  haveI : IsProper (Limits.pullback.snd (wcProjKStr K 1) s) := inferInstance
  have hint : (algebraMap (IsLocalRing.ResidueField A)
      (AlgebraicClosure (IsLocalRing.ResidueField A))).IsIntegral :=
    fun x => Algebra.IsIntegral.isIntegral x
  obtain ⟨E₁⟩ := wc_et_henselian_closed_fibre_coh A (Limits.pullback (wcProjKStr K 1) s)
    (Limits.pullback.snd (wcProjKStr K 1) s) m hm0 wc_et_henselian_proper_vanishing q
  obtain ⟨E₂⟩ := wc_et_coh_iso_invariance
    (Limits.pullbackLeftPullbackSndIso (wcProjKStr K 1) s
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))).hom m q
  obtain ⟨E₃⟩ := wc_et_coh_purely_inseparable_invariance (IsLocalRing.ResidueField A)
    (AlgebraicClosure (IsLocalRing.ResidueField A)) hint
    (Limits.pullback (wcProjKStr K 1) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ s))
    (Limits.pullback.snd (wcProjKStr K 1)
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ s)) m q
  obtain ⟨E₄⟩ := wc_et_coh_iso_invariance
    (Limits.pullbackLeftPullbackSndIso (wcProjKStr K 1)
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ s)
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
        (AlgebraicClosure (IsLocalRing.ResidueField A)))))).hom m q
  have C₅ := wc_et_alg_closed_field_invariance_card K (wcProjK K 1) (wcProjKStr K 1)
    (AlgebraicClosure (IsLocalRing.ResidueField A))
    (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
        (AlgebraicClosure (IsLocalRing.ResidueField A)))) ≫
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ s)) m hmK q
  rw [Nat.card_congr E₁, ← Nat.card_congr E₂, ← Nat.card_congr E₃, ← Nat.card_congr E₄]
  exact C₅

theorem wc_pp_basicOpen_cover : ∀ (K : Type u) [Field K] (m : ℕ), (⨆ a : Fin (m + 1), @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a)) = ⊤ :=
by
  intro K _ m
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) :=
    MvPolynomial.gradedAlgebra
  refine Proj.iSup_basicOpen_eq_top _ _ ?_
  intro p hp
  have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) 0 p = 0 :=
    (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
      p).mp hp
  have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) 0 p =
      MvPolynomial.homogeneousComponent 0 p :=
    (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
  rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
  rw [← Set.image_univ]
  rw [MvPolynomial.mem_ideal_span_X_image]
  intro e he
  rw [MvPolynomial.mem_support_iff] at he
  have hne : e ≠ 0 := by
    rintro rfl
    exact he h0
  obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
  exact ⟨i, Set.mem_univ i, by simpa using hi⟩

theorem wc_projK_one_stalk_normal : ∀ (K : Type u) [Field K] (x : wcProjK K 1), IsDomain ((wcProjK K 1).presheaf.stalk x) ∧ IsIntegrallyClosed ((wcProjK K 1).presheaf.stalk x) :=
by
  intro K _ x
  have hx : x ∈ (⨆ a : Fin (1 + 1), @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a)) := by
    rw [wc_pp_basicOpen_cover K 1]; trivial
  obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  obtain ⟨φ⟩ := (wc_proj_chart_partial_punct_iso K 1 a).1
  let x' : (@Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X a) : Scheme.{u}) := ⟨x, ha⟩
  haveI : IsIso (φ.hom.stalkMap x') := ((isIso_iff_isIso_stalkMap φ.hom).mp inferInstance).2 x'
  let p : PrimeSpectrum (MvPolynomial (Fin 1) K) := φ.hom x'
  haveI : p.asIdeal.IsPrime := p.isPrime
  let E := (Scheme.Opens.stalkIso _ x').symm ≪≫ (asIso (φ.hom.stalkMap x')).symm ≪≫
    Spec.stalkIso (CommRingCat.of (MvPolynomial (Fin 1) K)) p
  let e := E.commRingCatIsoToRingEquiv
  haveI : IsDomain (Localization.AtPrime p.asIdeal) := inferInstance
  haveI : IsIntegrallyClosed (Localization.AtPrime p.asIdeal) := inferInstance
  exact ⟨MulEquiv.isDomain (Localization.AtPrime p.asIdeal) e.toMulEquiv,
    IsIntegrallyClosed.of_equiv e.symm⟩

theorem wc_et_henselian_gm_coh : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)), Nat.card (wcEtCoh (Limits.pullback s (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ 1) = ℓ ∧ ∀ q : ℕ, 2 ≤ q → Subsingleton (wcEtCoh (Limits.pullback s (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ q) :=
by
  classical
  intro K _ _ ℓ hℓ hℓK A _ _ _ s

  have pb : ∀ {Y Z S T : Scheme.{u}} (y : Y ⟶ S) (z : Z ⟶ S) (s : T ⟶ S) (U : Y.Opens)
      (e : (U : Scheme.{u}) ≅ Z), e.hom ≫ z = U.ι ≫ y →
      Nonempty (((Limits.pullback.fst y s ⁻¹ᵁ U : (Limits.pullback y s).Opens) : Scheme.{u}) ≅
        Limits.pullback s z) := by
    intro Y Z S T y z s U e h
    exact ⟨(pullbackRestrictIsoRestrict (Limits.pullback.fst y s) U).symm ≪≫
      Limits.pullbackSymmetry _ _ ≪≫ Limits.pullbackRightPullbackFstIso y s U.ι ≪≫
      Limits.pullback.congrHom h.symm rfl ≪≫
      (Limits.pullbackRightPullbackFstIso z s e.hom).symm ≪≫
      asIso (Limits.pullback.snd e.hom (Limits.pullback.fst z s)) ≪≫
      Limits.pullbackSymmetry z s⟩

  haveI := wc_proj_space_isProper K 1
  haveI := wc_proj_space_irreducible K 1
  have hdim := wc_proj_space_dim K 1
  have hP2 : Nat.card (wcEtCoh (wcProjK K 1) ℓ 2) = ℓ :=
    wc_et_normal_curve_h2_card K (wcProjK K 1) (wcProjKStr K 1) inferInstance
      (wc_projK_one_stalk_normal K) hdim ℓ hℓ hℓK
  have hP3 : ∀ q, 3 ≤ q → Nat.card (wcEtCoh (wcProjK K 1) ℓ q) = 1 := by
    intro q hq
    haveI := wc_et_proper_curve_vanishing K (wcProjK K 1) (wcProjKStr K 1) ℓ hℓ hℓK hdim.le q
      (by omega)
    have hne : Nonempty (wcEtCoh (wcProjK K 1) ℓ q) := by
      unfold wcEtCoh
      exact ⟨0⟩
    exact Nat.card_eq_one_iff_unique.mpr ⟨inferInstance, hne⟩

  let U : Fin (1 + 1) → (wcProjK K 1).Opens := fun a =>
    @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X a)
  have hU : U 0 ⊔ U 1 = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : x ∈ (⨆ a : Fin (1 + 1), U a) := by
      rw [show (⨆ a : Fin (1 + 1), U a) = ⊤ from wc_pp_basicOpen_cover K 1]
      trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    rw [TopologicalSpace.Opens.mem_sup]
    fin_cases a
    · exact Or.inl ha
    · exact Or.inr ha
  let π := Limits.pullback.fst (wcProjKStr K 1) s
  have hV : π ⁻¹ᵁ U 0 ⊔ π ⁻¹ᵁ U 1 = ⊤ := by
    rw [← Scheme.Hom.preimage_sup, hU, Scheme.Hom.preimage_top]
  have hE : ∀ a : Fin (1 + 1), Nonempty (((π ⁻¹ᵁ U a : (Limits.pullback (wcProjKStr K 1) s).Opens) :
      Scheme.{u}) ≅ Limits.pullback s (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) := by
    intro a
    obtain ⟨e, he⟩ := wc_projK_one_affine_chart K a
    exact pb (wcProjKStr K 1) _ s (U a) e he
  obtain ⟨e₃, he₃⟩ := wc_projK_one_overlap_laurent K
  obtain ⟨EG'⟩ := pb (wcProjKStr K 1) _ s (U 0 ⊓ U 1) e₃ he₃
  have hinf : π ⁻¹ᵁ (U 0 ⊓ U 1) = π ⁻¹ᵁ U 0 ⊓ π ⁻¹ᵁ U 1 := Scheme.Hom.preimage_inf _
  let EG := (Scheme.isoOfEq _ hinf.symm) ≪≫ EG'

  have hVa : ∀ (a : Fin (1 + 1)) (q : ℕ), 1 ≤ q →
      Finite (wcEtCoh ((π ⁻¹ᵁ U a : (Limits.pullback (wcProjKStr K 1) s).Opens) : Scheme.{u}) ℓ q) ∧
      Nat.card (wcEtCoh ((π ⁻¹ᵁ U a : (Limits.pullback (wcProjKStr K 1) s).Opens) : Scheme.{u}) ℓ q)
        ≤ 1 := by
    intro a q hq
    obtain ⟨E⟩ := hE a
    obtain ⟨e⟩ := wc_et_coh_iso_invariance E.hom ℓ q
    haveI := wc_et_henselian_affine_line_acyclic K ℓ hℓ hℓK A s q hq
    haveI : Subsingleton (wcEtCoh ((π ⁻¹ᵁ U a : (Limits.pullback (wcProjKStr K 1) s).Opens) :
        Scheme.{u}) ℓ q) := e.symm.subsingleton
    exact ⟨Finite.of_subsingleton, Finite.card_le_one_iff_subsingleton.mpr inferInstance⟩
  have hTop : ∀ q, Nat.card (wcEtCoh ((⊤ : (Limits.pullback (wcProjKStr K 1) s).Opens) :
      Scheme.{u}) ℓ q) = Nat.card (wcEtCoh (wcProjK K 1) ℓ q) := by
    intro q
    obtain ⟨e⟩ := wc_et_coh_iso_invariance (Scheme.topIso (Limits.pullback (wcProjKStr K 1) s)).hom ℓ q
    rw [← Nat.card_congr e]
    exact wc_et_henselian_P1_coh_card K ℓ hℓK A s q
  have hTopFin : ∀ q, 2 ≤ q →
      Finite (wcEtCoh ((⊤ : (Limits.pullback (wcProjKStr K 1) s).Opens) : Scheme.{u}) ℓ q) := by
    intro q hq
    apply Nat.finite_of_card_ne_zero
    rw [hTop]
    rcases (show q = 2 ∨ 3 ≤ q by omega) with h | h
    · rw [h, hP2]; exact hℓ.ne_zero
    · rw [hP3 q h]; exact one_ne_zero

  have hup : ∀ q, 1 ≤ q →
      Finite (wcEtCoh ((π ⁻¹ᵁ U 0 ⊓ π ⁻¹ᵁ U 1 : (Limits.pullback (wcProjKStr K 1) s).Opens) :
        Scheme.{u}) ℓ q) ∧
      Nat.card (wcEtCoh ((π ⁻¹ᵁ U 0 ⊓ π ⁻¹ᵁ U 1 : (Limits.pullback (wcProjKStr K 1) s).Opens) :
        Scheme.{u}) ℓ q) ≤ Nat.card (wcEtCoh (wcProjK K 1) ℓ (q + 1)) := by
    intro q hq
    obtain ⟨h1, h2⟩ := wc_et_zariski_mv_card_le_rev (Limits.pullback (wcProjKStr K 1) s) ⊤
      (π ⁻¹ᵁ U 0) (π ⁻¹ᵁ U 1) hV ℓ q (hVa 0 q hq).1 (hVa 1 q hq).1 (hTopFin (q + 1) (by omega))
    refine ⟨h1, h2.trans ?_⟩
    rw [hTop]
    calc _ ≤ 1 * 1 * Nat.card (wcEtCoh (wcProjK K 1) ℓ (q + 1)) :=
          Nat.mul_le_mul (Nat.mul_le_mul (hVa 0 q hq).2 (hVa 1 q hq).2) le_rfl
      _ = _ := by ring
  have hG : ∀ q, Nat.card (wcEtCoh (Limits.pullback s (Spec.map (CommRingCat.ofHom
      (algebraMap K (LaurentPolynomial K))))) ℓ q) =
      Nat.card (wcEtCoh ((π ⁻¹ᵁ U 0 ⊓ π ⁻¹ᵁ U 1 : (Limits.pullback (wcProjKStr K 1) s).Opens) :
        Scheme.{u}) ℓ q) := by
    intro q
    obtain ⟨e⟩ := wc_et_coh_iso_invariance EG.hom ℓ q
    exact Nat.card_congr e
  refine ⟨?_, ?_⟩
  ·
    obtain ⟨hf1, hc1⟩ := hup 1 le_rfl
    obtain ⟨_, h2⟩ := wc_et_zariski_mv_card_le (Limits.pullback (wcProjKStr K 1) s) ⊤
      (π ⁻¹ᵁ U 0) (π ⁻¹ᵁ U 1) hV ℓ 1 hf1 (hVa 0 2 (by omega)).1 (hVa 1 2 (by omega)).1
    have htop2 : Nat.card (wcEtCoh ((⊤ : (Limits.pullback (wcProjKStr K 1) s).Opens) :
        Scheme.{u}) ℓ (1 + 1)) = ℓ := by
      rw [hTop]; exact hP2
    rw [htop2] at h2
    have hlo : ℓ ≤ Nat.card (wcEtCoh ((π ⁻¹ᵁ U 0 ⊓ π ⁻¹ᵁ U 1 :
        (Limits.pullback (wcProjKStr K 1) s).Opens) : Scheme.{u}) ℓ 1) := by
      calc ℓ ≤ _ := h2
        _ ≤ Nat.card (wcEtCoh ((π ⁻¹ᵁ U 0 ⊓ π ⁻¹ᵁ U 1 :
            (Limits.pullback (wcProjKStr K 1) s).Opens) : Scheme.{u}) ℓ 1) * (1 * 1) :=
          Nat.mul_le_mul le_rfl (Nat.mul_le_mul (hVa 0 2 (by omega)).2 (hVa 1 2 (by omega)).2)
        _ = _ := by ring
    have hc1' : Nat.card (wcEtCoh ((π ⁻¹ᵁ U 0 ⊓ π ⁻¹ᵁ U 1 :
        (Limits.pullback (wcProjKStr K 1) s).Opens) : Scheme.{u}) ℓ 1) ≤ ℓ := by
      exact hc1.trans (le_of_eq hP2)
    rw [hG]
    exact le_antisymm hc1' hlo
  · intro q hq
    obtain ⟨hf, hc⟩ := hup q (by omega)
    rw [hP3 (q + 1) (by omega)] at hc
    haveI := hf
    haveI : Subsingleton (wcEtCoh ((π ⁻¹ᵁ U 0 ⊓ π ⁻¹ᵁ U 1 :
        (Limits.pullback (wcProjKStr K 1) s).Opens) : Scheme.{u}) ℓ q) :=
      Finite.card_le_one_iff_subsingleton.mp hc
    obtain ⟨e⟩ := wc_et_coh_iso_invariance EG.hom ℓ q
    exact e.subsingleton

theorem wc_et_gm_push_R1_iso : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [LocallyOfFiniteType fX] (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))), Nonempty ((((wcEtPush (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 1 ≅ (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) :=
by
  classical
  intro K _ _ ℓ hℓ hℓK X fX _ I
  haveI : Fact (Nat.Prime ℓ) := ⟨hℓ⟩
  haveI hπaff : IsAffineHom (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback fX _).flip
      inferInstance
  obtain ⟨ψ, hψ⟩ := wc_et_gm_R1_kummer_section K ℓ hℓ hℓK X fX I
  have hbij : ∀ b : X, Function.Bijective ((wcEtStalk X b).map ψ).hom := by
    intro b
    obtain ⟨u0, hu0, -⟩ := wc_et_unit_sigma_stalk X ℓ 1 b
    obtain ⟨eU⟩ := wc_et_zmod_unit_toSheaf_iso X ℓ
    have hS : Nat.card ((wcEtStalk X b).obj ((constantSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) = ℓ := by
      have h1 := Nat.card_eq_of_bijective _ hu0
      have h2 := Nat.card_congr ((wcEtStalk X b).mapIso eU).addCommGroupIsoToAddEquiv.toEquiv
      have h3 := Nat.card_congr ((wcEtStalk X b).mapIso ((SheafOfModules.toSheaf
        (wcEtZModRing X ℓ)).mapIso (Limits.coproductUniqueIso
          (fun _ : Fin 1 => SheafOfModules.unit (wcEtZModRing X ℓ))))).addCommGroupIsoToAddEquiv.toEquiv
      have hc : Nat.card (Fin 1 → ZMod ℓ) = ℓ := by
        simp [Nat.card_pi, Nat.card_zmod]
      exact h2.symm.trans (h3.symm.trans (h1.symm.trans hc))
    obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, -, -⟩ :=
      wc_et_geom_strict_henselization b
    obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) b Λ W' hinit
      I.cocomplex 1
    obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) A Λ
      (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt X b)) (Scheme.Etale.forget X)) φ a
      haff hφ hφa hlim ℓ I 1
    obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
      ((Limits.pullbackSymmetry (Limits.pullback.fst fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) a).hom ≫
        (Limits.pullbackRightPullbackFstIso fX
          (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) a).hom) ℓ 1
    have hT0 := (wc_et_henselian_gm_coh K ℓ hℓ hℓK A (a ≫ fX)).1
    have hT : Nat.card ((wcEtStalk X b).obj ((((wcEtPush (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex).homology 1)) = ℓ := by
      rw [Nat.card_congr (E₁.trans (E₂.trans E₃.symm)), hT0]
    haveI : Finite ((wcEtStalk X b).obj ((((wcEtPush (Limits.pullback.fst fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex).homology 1)) :=
      Nat.finite_of_card_ne_zero (by rw [hT]; exact hℓ.ne_zero)
    haveI : Finite ((wcEtStalk X b).obj ((constantSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) :=
      Nat.finite_of_card_ne_zero (by rw [hS]; exact hℓ.ne_zero)
    have hf0 : ((wcEtStalk X b).map ψ).hom ≠ 0 := fun h =>
      hψ b (AddCommGrpCat.hom_ext (h.trans AddCommGrpCat.hom_zero.symm))
    have hinj : Function.Injective ((wcEtStalk X b).map ψ).hom := by
      rw [← AddMonoidHom.ker_eq_bot_iff]
      have hd : Nat.card ((wcEtStalk X b).map ψ).hom.ker ∣ ℓ := by
        have h := AddSubgroup.card_addSubgroup_dvd_card ((wcEtStalk X b).map ψ).hom.ker
