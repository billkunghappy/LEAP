theorem wc_et_pc_cover_charts : ∀ (K : Type u) [Field K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (c' : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (S1 : Scheme.{u}) (s1 : S1 ⟶ S) (Y1 : Scheme.{u}) (h1 : Y1 ⟶ S1) (w1 : Y1 ⟶ (U : Scheme.{u})), IsPullback w1 h1 (U.ι ≫ p) s1 → ∃ (P' : Scheme.{u}) (p' : P' ⟶ S1) (q' : P' ⟶ Spec (.of (MvPolynomial (Fin c') K))) (z0' : S1 ⟶ P') (U' : P'.Opens) (rab : ((w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) : Y1.Opens) : Scheme.{u}) ⟶ (U' : Scheme.{u})) (tab : ((w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) : Y1.Opens) : Scheme.{u}) ⟶ Spec (.of (LaurentPolynomial K))) (bB : ((w1 ⁻¹ᵁ wcEtPcCovB q U : Y1.Opens) : Scheme.{u}) ⟶ (U' : Scheme.{u})) (tA : ((w1 ⁻¹ᵁ wcEtPcCovA q U : Y1.Opens) : Scheme.{u}) ⟶ Spec (.of (LaurentPolynomial K))), IsPullback p' q' (s1 ≫ fS) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) ∧ z0' ≫ p' = 𝟙 S1 ∧ z0' ≫ q' = (s1 ≫ fS) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K)) ∧ (U' : Set P') = (Set.range z0')ᶜ ∧ IsPullback rab tab (U'.ι ≫ p' ≫ s1 ≫ fS) (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) ∧ rab ≫ U'.ι ≫ p' = (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)).ι ≫ h1 ∧ Y1.homOfLE (show w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) ≤ w1 ⁻¹ᵁ wcEtPcCovB q U from fun _ hy => hy.2) ≫ bB = rab ∧ Y1.homOfLE (show w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) ≤ w1 ⁻¹ᵁ wcEtPcCovA q U from fun _ hy => hy.1) ≫ tA = tab :=
by
  classical
  intro K _ S fS c' P p q z0 hP hz0p hz0q U hU S1 s1 Y1 h1 w1 hY1

  have hs5 : ∀ {V U' S1 W' Ch G Z : Scheme.{u}} (u : U' ⟶ S1) (qw : U' ⟶ W') (f : S1 ⟶ Z)
      (wa : W' ⟶ Z) (ρ : Ch ⟶ W') (ce : Ch ⟶ G) (g : G ⟶ Z) (vh : V ⟶ S1) (θ : V ⟶ Ch),
      IsPullback u qw f wa → IsPullback ρ ce wa g → IsPullback vh θ f (ρ ≫ wa) →
      ∀ (r : V ⟶ U'), r ≫ u = vh → r ≫ qw = θ ≫ ρ → IsPullback r (θ ≫ ce) (u ≫ f) g := by
    intro V U' S1 W' Ch G Z u qw f wa ρ ce g vh θ h1 h2 h3 r hr1 hr2
    have h3' : IsPullback θ (r ≫ u) (ρ ≫ wa) f := by rw [hr1]; exact h3.flip
    have hL : IsPullback θ r ρ qw := IsPullback.of_bot h3' hr2.symm h1.flip
    have := (IsPullback.paste_horiz hL h2.flip).flip
    rwa [← h1.w] at this

  have hs3 : ∀ {S P A Z S1 Y1 N0 : Scheme.{u}} (fS : S ⟶ Z) (aA : A ⟶ Z) (p : P ⟶ S) (q : P ⟶ A),
      IsPullback p q fS aA → ∀ (U : P.Opens) (N : A.Opens), q ⁻¹ᵁ N ≤ U → ∀ (s1 : S1 ⟶ S)
      (h1 : Y1 ⟶ S1) (w1 : Y1 ⟶ (U : Scheme.{u})), IsPullback w1 h1 (U.ι ≫ p) s1 →
      ∀ (k : N0 ⟶ A) [IsOpenImmersion k], Set.range k = (N : Set A) → ∀ (V1 : Y1.Opens),
      V1 = (w1 ≫ U.ι ≫ q) ⁻¹ᵁ N → ∃ θ : (V1 : Scheme.{u}) ⟶ N0, θ ≫ k = V1.ι ≫ w1 ≫ U.ι ≫ q ∧
      IsPullback (V1.ι ≫ h1) θ (s1 ≫ fS) (k ≫ aA) := by
