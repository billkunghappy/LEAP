    (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcEtBaseChange (U.ι ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B))) _ _ Dg.cont Dg.φ)
    Dg.adj (SheafOfModules.unit (wcEtZModRing B ℓ))
    (SheafOfModules.unit (wcEtZModRing (U : Scheme.{u}) ℓ)) Dg.μ I (2 * c - 1) (by omega)
    (wc_et_punct_push_unit_iso K B qB m c (AffineSpace (ULift.{u} (Fin c)) B)
      (AffineSpace (ULift.{u} (Fin c)) B ↘ B) q
      (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) hq hzp hzq hc U hU ℓ Dg)
    (fun n hn1 hnN => wc_et_push_homology_zero_of_local _ ℓ Dg I n hn1
      (wc_et_punct_local_vanishing K B qB m c (AffineSpace (ULift.{u} (Fin c)) B)
        (AffineSpace (ULift.{u} (Fin c)) B ↘ B) q
        (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) hq hzp hzq hc U hU ℓ hℓ
        n hn1 (by omega)))
    ℓ hfin hcard

  refine ⟨T₀.image (fun x => (Abelian.Ext.mk₀ Dg.μ.inv).comp x (zero_add (2 * c - 1))),
    Finset.card_image_le.trans hT₀, ?_⟩
  intro y
  obtain ⟨t, ht, w, hw⟩ := hT₀' ((Abelian.Ext.mk₀ Dg.μ.hom).comp y (zero_add (2 * c - 1)))
  refine ⟨(Abelian.Ext.mk₀ Dg.μ.inv).comp t (zero_add (2 * c - 1)), Finset.mem_image_of_mem _ ht,
    wcEtPull Dπ (2 * c - 1) w, ?_⟩
  rw [← wc_et_pull_comp (AffineSpace (ULift.{u} (Fin c)) B ↘ B) U.ι _ rfl Dπ Dj Dg (2 * c - 1) w]
  have h1 : y = (Abelian.Ext.mk₀ Dg.μ.inv).comp
      ((Abelian.Ext.mk₀ Dg.μ.hom).comp y (zero_add (2 * c - 1))) (zero_add (2 * c - 1)) := by
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
      Abelian.Ext.mk₀_id_comp]
  conv_lhs => rw [h1, hw]
  rw [Abelian.Ext.comp_add]
  rfl

theorem wc_et_affine_bundle_zero_supp_card_le_rank_zero : ∀ (B : Scheme.{u}) [IrreducibleSpace B] (ℓ : ℕ), ℓ ≠ 0 → ∀ (DB : wcEtPullData (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin 0) → Γ(B, ⊤))) ℓ), Finite (wcEtSuppExt DB 0) ∧ Nat.card (wcEtSuppExt DB 0) ≤ ℓ :=
by
  classical
  intro B _ ℓ hℓ DB

  have h1 : AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin 0) → Γ(B, ⊤)) ≫
      (AffineSpace (ULift.{u} (Fin 0)) B ↘ B) = 𝟙 B := AffineSpace.homOfVector_over _ _
  haveI : IsClosedImmersion (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin 0) → Γ(B, ⊤))) := by
    have : IsClosedImmersion (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin 0) → Γ(B, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin 0)) B ↘ B)) := by
      rw [h1]; infer_instance
    exact IsClosedImmersion.of_comp _ (AffineSpace (ULift.{u} (Fin 0)) B ↘ B)

  haveI : Epi (wcEtSuppUnitMap DB) := wc_et_supp_unit_epi _ DB
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (AffineSpace (ULift.{u} (Fin 0)) B) ℓ)) :=
    HasExt.standard _

  let Φ : wcEtSuppExt DB 0 → wcEtZModExt (AffineSpace (ULift.{u} (Fin 0)) B) ℓ 0 :=
    fun x => (Abelian.Ext.mk₀ (wcEtSuppUnitMap DB)).comp x (zero_add 0)
  have hΦ : Function.Injective Φ := by
    intro x y hxy
    obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    have hxy' : Abelian.Ext.mk₀ (wcEtSuppUnitMap DB ≫ f) =
        Abelian.Ext.mk₀ (wcEtSuppUnitMap DB ≫ g) := by
      have e1 := Abelian.Ext.mk₀_comp_mk₀ (wcEtSuppUnitMap DB) f
      have e2 := Abelian.Ext.mk₀_comp_mk₀ (wcEtSuppUnitMap DB) g
      rw [← e1, ← e2]
      exact hxy
    have hfg := (Abelian.Ext.mk₀_bijective _ _).1 hxy'
    rw [(cancel_epi _).1 hfg]

  have h2 : (AffineSpace (ULift.{u} (Fin 0)) B ↘ B) ≫
      AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin 0) → Γ(B, ⊤)) = 𝟙 _ := by
    apply AffineSpace.hom_ext
    · rw [Category.assoc, h1, Category.comp_id, Category.id_comp]
    · intro i
      exact (IsEmpty.false i).elim
  let e : B ≅ AffineSpace (ULift.{u} (Fin 0)) B :=
    { hom := AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin 0) → Γ(B, ⊤))
      inv := AffineSpace (ULift.{u} (Fin 0)) B ↘ B
      hom_inv_id := h1
      inv_hom_id := h2 }
  haveI : IrreducibleSpace (AffineSpace (ULift.{u} (Fin 0)) B) :=
    Function.Surjective.irreducibleSpace (Scheme.homeoOfIso e).continuous
      (Scheme.homeoOfIso e).surjective

  obtain ⟨hfin, hcard⟩ :=
    wc_et_coh_zero_irreducible_card_le (AffineSpace (ULift.{u} (Fin 0)) B) ℓ hℓ
  haveI := hfin
  obtain ⟨E⟩ := wc_et_zmodext_coh_equiv (AffineSpace (ULift.{u} (Fin 0)) B) ℓ 0
  haveI : Finite (wcEtZModExt (AffineSpace (ULift.{u} (Fin 0)) B) ℓ 0) := Finite.of_equiv _ E.symm
  refine ⟨Finite.of_injective Φ hΦ, ?_⟩
  calc Nat.card (wcEtSuppExt DB 0)
      ≤ Nat.card (wcEtZModExt (AffineSpace (ULift.{u} (Fin 0)) B) ℓ 0) :=
        Nat.card_le_card_of_injective Φ hΦ
    _ = Nat.card (wcEtCoh (AffineSpace (ULift.{u} (Fin 0)) B) ℓ 0) := Nat.card_congr E
    _ ≤ ℓ := hcard

theorem wc_et_affine_bundle_slice_injective : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (B : Scheme.{u}) (qB : B ⟶ Spec (.of K)) [IsAffine B] [IrreducibleSpace B] [Smooth qB] (b : Spec (.of K) ⟶ B), b ≫ qB = 𝟙 _ → ∀ (c : ℕ) (DB : wcEtPullData (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) ℓ) (Dσ : wcEtPullData (AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) ≫ b) (fun j : ULift.{u} (Fin c) => AffineSpace.coord (Spec (.of K)) j)) ℓ) (DK : wcEtPullData (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) ℓ) (γ : wcEtSuppObj DK ⟶ Dσ.Φ.obj (wcEtSuppObj DB)), wcEtSuppUnitMap DK ≫ γ = Dσ.μ.inv ≫ Dσ.Φ.map (wcEtSuppUnitMap DB) → Function.Injective (wcEtSuppRestr DB Dσ DK γ (2 * c)) :=
by
  classical
  intro K _ _ ℓ _ hℓ B qB _ _ _ b hb c DB Dσ DK γ hγ
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos

  have hzs : ∀ (S : Scheme.{u}),
      IsClosedImmersion (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤))) := by
    intro S
    have h1 : AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) S ↘ S) = 𝟙 S := AffineSpace.homOfVector_over _ _
    have : IsClosedImmersion (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) S ↘ S)) := by
      rw [h1]; infer_instance
    exact IsClosedImmersion.of_comp _ (AffineSpace (ULift.{u} (Fin c)) S ↘ S)
  haveI := hzs B
  haveI := hzs (Spec (.of K))
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) ℓ)) :=
    HasExt.standard _
  have e1 : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : Γ(Z, ⊤)),
      ConcreteCategory.hom (f ≫ g).appTop x =
        ConcreteCategory.hom f.appTop (ConcreteCategory.hom g.appTop x) := by
    intro X Y Z f g x
    rw [Scheme.Hom.comp_appTop]
    rfl
  have e2 : ∀ {X : Scheme.{u}} (x : Γ(X, ⊤)), ConcreteCategory.hom (𝟙 X : X ⟶ X).appTop x = x := by
    intro X x
    simp

  have hsq : IsPullback qB (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)))
      (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))
      (AffineSpace.map (ULift.{u} (Fin c)) qB) := by
    have hcomm : qB ≫ AffineSpace.homOfVector (𝟙 (Spec (.of K)))
          (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)) =
        AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) ≫
          AffineSpace.map (ULift.{u} (Fin c)) qB := by
      apply AffineSpace.hom_ext
      · rw [Category.assoc, AffineSpace.homOfVector_over, Category.comp_id, Category.assoc,
          AffineSpace.map_over, ← Category.assoc, AffineSpace.homOfVector_over, Category.id_comp]
      · intro i
        simp only [e1, AffineSpace.homOfVector_appTop_coord, AffineSpace.map_appTop_coord,
          Pi.zero_apply, map_zero]
    have hcoord : ∀ (s : Limits.PullbackCone (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
          (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) (AffineSpace.map (ULift.{u} (Fin c)) qB)),
        (s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B)) ≫
          AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤)) = s.snd := by
      intro s
      apply AffineSpace.hom_ext
      · rw [Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]
      · intro i
        have h1 := congrArg (fun φ => ConcreteCategory.hom (Scheme.Hom.appTop φ)
          (AffineSpace.coord (Spec (.of K)) i)) s.condition
        simp only [e1, AffineSpace.homOfVector_appTop_coord, AffineSpace.map_appTop_coord,
          Pi.zero_apply, map_zero] at h1 ⊢
        first
          | exact h1
          | exact h1.symm
    refine IsPullback.mk ⟨hcomm⟩
      ⟨Limits.PullbackCone.IsLimit.mk hcomm
        (fun s => s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B)) ?_ ?_ ?_⟩
    · intro s
      show (s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B)) ≫ qB = s.fst
      rw [Category.assoc, ← AffineSpace.map_over, ← Category.assoc, ← s.condition,
        Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]
    · intro s
      exact hcoord s
    · intro s m _ hm2
      show m = s.snd ≫ (AffineSpace (ULift.{u} (Fin c)) B ↘ B)
      rw [← hm2, Category.assoc, AffineSpace.homOfVector_over, Category.comp_id]

  have hσpr : AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) ≫ b)
      (fun j : ULift.{u} (Fin c) => AffineSpace.coord (Spec (.of K)) j) ≫
        AffineSpace.map (ULift.{u} (Fin c)) qB = 𝟙 _ := by
    apply AffineSpace.hom_ext
    · rw [Category.assoc, AffineSpace.map_over, ← Category.assoc, AffineSpace.homOfVector_over,
        Category.assoc, hb, Category.comp_id, Category.id_comp]
    · intro i
      rw [e1, AffineSpace.map_appTop_coord, AffineSpace.homOfVector_appTop_coord, e2]

  obtain ⟨ω, hω⟩ := wc_et_affine_origin_supp_ext_ne_zero K ℓ hℓ c DK
  obtain ⟨Epr⟩ := wc_et_zmod_pull_data_exists (AffineSpace.map (ULift.{u} (Fin c)) qB) ℓ
  obtain ⟨Eid⟩ := wc_et_zmod_pull_data_exists (𝟙 (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)))) ℓ
  obtain ⟨γpr, hγpr, -⟩ := wc_et_closed_supp_base_change _ (AffineSpace.map (ULift.{u} (Fin c)) qB)
    _ qB hsq DK Epr DB
  obtain ⟨γid, hγid, -⟩ := wc_et_closed_supp_base_change _ _ _ _
    (IsPullback.id_horiz (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
      (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))) DK Eid DK
  have hcomp := wc_et_supp_restr_comp (AffineSpace.map (ULift.{u} (Fin c)) qB) _ _ hσpr DK DB DK
    Epr Dσ Eid γpr γ γid hγpr hγ hγid (wc_et_supp_unit_epi _ DK) (2 * c) ω
  have hinjid := wc_et_supp_restr_etale_excision_injective (𝟙 _) _ _ (𝟙 _)
    (IsPullback.id_horiz (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
      (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))) inferInstance DK Eid DK γid hγid (2 * c)
  have hRt : wcEtSuppRestr DB Dσ DK γ (2 * c) (wcEtSuppRestr DK Epr DB γpr (2 * c) ω) ≠ 0 := by
    intro h0
    apply hω
    apply hinjid
    rw [hcomp, h0, map_zero]

  have hmk : ∀ m : ℕ, Abelian.Ext.mk₀ (m • 𝟙 (SheafOfModules.unit
        (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) ℓ))) =
      m • (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit
        (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) ℓ))) :
        Abelian.Ext
          (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) ℓ))
          (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) ℓ)) 0) := by
    intro m
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
  have hzero : ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) ℓ)) = 0 := by
    have h := (wc_et_zmod_unit_pow_exact (AffineSpace (ULift.{u} (Fin c)) B) ℓ 1 hℓpos).1
    rw [pow_one] at h
    exact h
  have htor : ∀ e : wcEtSuppExt DB (2 * c), ℓ • e = 0 := by
    intro e
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) ℓ)) :=
      HasExt.standard _
    have hlin := map_nsmul (Abelian.Ext.bilinearComp (wcEtSuppObj DB)
      (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) ℓ))
      (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) ℓ))
      (2 * c) 0 (2 * c) (add_zero _) e) ℓ
      (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing (AffineSpace (ULift.{u} (Fin c)) B) ℓ))))
    simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
    rw [Abelian.Ext.comp_mk₀_id] at hlin
    rw [← hlin, ← hmk, hzero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have hcard : Finite (wcEtSuppExt DB (2 * c)) ∧ Nat.card (wcEtSuppExt DB (2 * c)) ≤ ℓ := by
    rcases Nat.eq_zero_or_pos c with hc | hc
    · subst hc
      exact wc_et_affine_bundle_zero_supp_card_le_rank_zero B ℓ hℓpos.ne' DB
    · let U : (AffineSpace (ULift.{u} (Fin c)) B).Opens :=
        ⟨(Set.range (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))))ᶜ,
          (IsClosedImmersion.isClosedEmbedding _).isClosed_range.isOpen_compl⟩
      have hU : (U : Set (AffineSpace (ULift.{u} (Fin c)) B)) =
          (Set.range (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))))ᶜ := rfl
      obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists U.ι ℓ
      have h2c : 2 * c = (2 * c - 1) + 1 := by omega
      have hinj := wc_et_affine_bundle_punct_restr_injective K ℓ hℓ B qB c hc U hU Dj
        ((2 * c - 1) + 1)
      have hT := wc_et_affine_bundle_punct_coker_card K ℓ hℓ B qB b hb c hc U hU Dj
      have hres := wc_et_supp_card_of_restr
        (AffineSpace.homOfVector (𝟙 B) (0 : ULift.{u} (Fin c) → Γ(B, ⊤))) U.ι
        (by rw [Scheme.Opens.range_ι]; exact hU) ℓ hℓpos DB Dj (2 * c - 1) ℓ hinj hT
      rw [h2c]
      exact hres

  obtain ⟨hfin, hle⟩ := hcard
  haveI := hfin
  refine (injective_iff_map_eq_zero _).mpr ?_
  intro x hx
  by_contra hx0
  have hord : addOrderOf x = ℓ := by
    rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd _
        (addOrderOf_dvd_of_nsmul_eq_zero (htor x)) with h | h
    · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) hx0
    · exact h
  have htop : AddSubgroup.zmultiples x = ⊤ :=
    AddSubgroup.eq_top_of_le_card _ (by rw [Nat.card_zmultiples, hord]; exact hle)
  have hmem : wcEtSuppRestr DK Epr DB γpr (2 * c) ω ∈ AddSubgroup.zmultiples x := by
    rw [htop]; exact AddSubgroup.mem_top _
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
  apply hRt
  rw [← hk, map_zsmul, hx, smul_zero]

theorem wc_gl_universal_chart : ∀ (K : Type u) [Field K] (c : ℕ), ∃ (G : Scheme.{u}) (qG : G ⟶ Spec (.of K)) (e : Spec (.of K) ⟶ G) (act pr : AffineSpace (ULift.{u} (Fin c)) G ⟶ AffineSpace (ULift.{u} (Fin c)) (Spec (.of K))), IsAffine G ∧ IrreducibleSpace G ∧ Smooth qG ∧ e ≫ qG = 𝟙 _ ∧ IsPullback qG (AffineSpace.homOfVector (𝟙 G) (0 : ULift.{u} (Fin c) → Γ(G, ⊤))) (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) act ∧ IsPullback qG (AffineSpace.homOfVector (𝟙 G) (0 : ULift.{u} (Fin c) → Γ(G, ⊤))) (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) pr ∧ AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) ≫ e) (fun j : ULift.{u} (Fin c) => AffineSpace.coord (Spec (.of K)) j) ≫ act = 𝟙 _ ∧ AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) ≫ e) (fun j : ULift.{u} (Fin c) => AffineSpace.coord (Spec (.of K)) j) ≫ pr = 𝟙 _ ∧ IsPullback e (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) (AffineSpace.homOfVector (𝟙 G) (0 : ULift.{u} (Fin c) → Γ(G, ⊤))) (AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) ≫ e) (fun j : ULift.{u} (Fin c) => AffineSpace.coord (Spec (.of K)) j)) ∧ ∀ {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (i : Z ⟶ W) (h : Fin c → Γ(W, ⊤)) (A : Matrix (Fin c) (Fin c) Γ(W, ⊤)), IsUnit A.det → wcEtCutOut i h → ∃ (ψ : W ⟶ AffineSpace (ULift.{u} (Fin c)) G) (g : Z ⟶ G), ψ ≫ act = AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => A.mulVec h j.down) ∧ ψ ≫ pr = AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down) ∧ IsPullback g i (AffineSpace.homOfVector (𝟙 G) (0 : ULift.{u} (Fin c) → Γ(G, ⊤))) ψ :=
by
  classical
  intro K _ c

  have s1 : ∀ {S T : Scheme.{u}} (f : S ⟶ T), IsPullback f
      (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)))
      (AffineSpace.homOfVector (𝟙 T) (0 : ULift.{u} (Fin c) → Γ(T, ⊤)))
      (AffineSpace.map (ULift.{u} (Fin c)) f) := by
    intro S T f
    refine IsPullback.of_bot (v₂₁ := AffineSpace (ULift.{u} (Fin c)) S ↘ S)
      (v₂₂ := AffineSpace (ULift.{u} (Fin c)) T ↘ T) (h₃₁ := f) ?_ ?_
      (AffineSpace.isPullback_map f)
    · rw [AffineSpace.homOfVector_over, AffineSpace.homOfVector_over]
      exact IsPullback.id_vert f
    · show f ≫ AffineSpace.homOfVector (𝟙 T) 0 = AffineSpace.homOfVector (𝟙 S) 0 ≫
        AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) S ↘ S ≫ f) (AffineSpace.coord S)
      rw [AffineSpace.comp_homOfVector, AffineSpace.comp_homOfVector, ← Category.assoc,
        AffineSpace.homOfVector_over, Category.comp_id, Category.id_comp]
      congr 1
      funext j
      simp only [Function.comp_apply, Pi.zero_apply, map_zero,
        AffineSpace.homOfVector_appTop_coord]

  have s2 : ∀ {S T X : Scheme.{u}} (q : S ⟶ T) (f : X ⟶ S) (v : ULift.{u} (Fin c) → Γ(X, ⊤)),
      AffineSpace.homOfVector f v ≫ AffineSpace.map (ULift.{u} (Fin c)) q =
