      exact ⟨V₁, c, y, hc, hEt, hy⟩
    let L : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      { obj := fun U => RingCat.of (LocallyConstant U.unop.left (ULift.{u+1} (ZMod m)))
        map := fun g => RingCat.ofHom
          (LocallyConstant.comapRingHom ⟨g.unop.left, g.unop.left.continuous⟩)
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }
    let eL : ∀ V : Y.Etale, (L.obj (Opposite.op V)) ≃+* LocallyConstant V.left (ZMod m) := fun V =>
      { toFun := fun f => (show LocallyConstant V.left (ULift.{u+1} (ZMod m)) from f).map ULift.down
