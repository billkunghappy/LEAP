    have hG2 : ∀ a, X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op a = X.presheaf.map (homOfLE hPV.le).op (X.presheaf.map (homOfLE (le_top : X.basicOpen (f t) ≤ ⊤)).op a) := by
      intro a
      rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    rw [hG1, hG2, hG2, ← map_pow, ← map_mul, hSS]
  have S3 : ∀ (K : Type u) [Field K] (n : ℕ) (V : Scheme.{u}) (fV : V ⟶ Spec (.of K)) (t : Fin (n + 1) → Γ(V, ⊤)),
      Ideal.span (Set.range t) = ⊤ →
      ∃ φ : V ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fV ∧ (∀ J, φ ⁻¹ᵁ wcSgD K n J = V.basicOpen (t J)) ∧
        ∀ J L (O : V.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J), φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) *
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t L) := by
    intro K _ N V fV s hspan
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hX : ∀ J : Fin (N + 1), (MvPolynomial.X J : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun J =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)
    let F : MvPolynomial (Fin (N + 1)) K →+* Γ(V, ⊤) :=
      MvPolynomial.eval₂Hom (fV.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) s
    have hFX : ∀ J, F (MvPolynomial.X J) = s J := fun J => MvPolynomial.eval₂Hom_X' _ _ J
    have hF : (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal.map F = ⊤ := by
      rw [eq_top_iff, ← hspan, Ideal.span_le]
      rintro _ ⟨J, rfl⟩
      rw [← hFX J]
      apply Ideal.mem_map_of_mem
      exact (HomogeneousIdeal.mem_irrelevant_iff _ _).mpr (by
        rw [GradedRing.proj_apply]
        exact DirectSum.decompose_of_mem_ne _ (hX J) one_ne_zero)
    refine ⟨Proj.fromOfGlobalSections _ F hF, ?_, fun J => ?_, fun J L O hO => ?_⟩
    · have h1 := Proj.fromOfGlobalSections_toSpecZero
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) F hF
      have hc : CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
          CommRingCat.ofHom (F.comp (algebraMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)
            (MvPolynomial (Fin (N + 1)) K))) = (Scheme.ΓSpecIso (.of K)).inv ≫ fV.appTop := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro k
        show F (MvPolynomial.C k) = fV.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom k)
        exact MvPolynomial.eval₂Hom_C _ _ k
      have h2 : (Spec (.of K)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv = 𝟙 _ := by
        rw [← Scheme.isoSpec_hom, Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
      calc Proj.fromOfGlobalSections _ F hF ≫ (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0))))
          = (Proj.fromOfGlobalSections _ F hF ≫
              Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)) ≫
              Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) :=
            (Category.assoc _ _ _).symm
        _ = V.toSpecΓ ≫ (Spec.map (CommRingCat.ofHom (F.comp (algebraMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)
              (MvPolynomial (Fin (N + 1)) K)))) ≫
              Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))) := by
            rw [h1, Category.assoc]
        _ = V.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of K)).inv ≫ fV.appTop) := by
            rw [← Spec.map_comp, hc]
        _ = (V.toSpecΓ ≫ Spec.map fV.appTop) ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv := by
            rw [Spec.map_comp, Category.assoc]
        _ = fV ≫ ((Spec (.of K)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv) := by
            rw [← Scheme.toSpecΓ_naturality, Category.assoc]
        _ = fV := by rw [h2, Category.comp_id]
    · rw [← hFX J]
      exact Proj.fromOfGlobalSections_preimage_basicOpen _ F hF Nat.one_pos (hX J)
    · have hy : (MvPolynomial.X L : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := by
        rw [one_smul]
        exact hX L
      have h := s3 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) V F hF Nat.one_pos (hX J) 1
        (MvPolynomial.X L) hy
      rw [hFX, hFX, pow_one] at h
      have e := congrArg (V.presheaf.map (homOfLE hO).op) h
      rw [map_mul, hres, hres] at e
      exact e

  have hAmap : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V : B.Opens) (O1 O2 : A.Opens) (h12 : O2 ≤ O1)
      (e1 : O1 ≤ f ⁻¹ᵁ V) (e2 : O2 ≤ f ⁻¹ᵁ V) (x : Γ(B, V)),
      A.presheaf.map (homOfLE h12).op (f.appLE V O1 e1 x) = f.appLE V O2 e2 x := by
    intro A B f V O1 O2 h12 e1 e2 x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_map]
  have hmapA : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V V' : B.Opens) (O : A.Opens) (hVV : V ≤ V')
      (e : O ≤ f ⁻¹ᵁ V) (e' : O ≤ f ⁻¹ᵁ V') (x : Γ(B, V')),
      f.appLE V O e (B.presheaf.map (homOfLE hVV).op x) = f.appLE V' O e' x := by
    intro A B f V V' O hVV e e' x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]

  have isUnit_of_bo : ∀ (Y : Scheme.{u}) (O : Y.Opens) (x : Γ(Y, O)), Y.basicOpen x = O → IsUnit x := by
    intro Y O x hx
    have hu : IsUnit (Y.presheaf.map (homOfLE (Y.basicOpen_le x)).op x) :=
      RingedSpace.isUnit_res_basicOpen _ _
    rw [← hid Y O le_rfl x, ← hres Y O _ O (Y.basicOpen_le x) hx.ge le_rfl]
    exact hu.map _

  have hov : ∀ (Y : Scheme.{u}) (A B : Y.Opens) (a : Γ(Y, A)) (b : Γ(Y, B)) (v0 : Γ(Y, A ⊓ B)), IsUnit v0 →
      Y.presheaf.map (homOfLE (inf_le_right : A ⊓ B ≤ B)).op b =
        v0 * Y.presheaf.map (homOfLE (inf_le_left : A ⊓ B ≤ A)).op a →
      A ⊓ Y.basicOpen b = B ⊓ Y.basicOpen a := by
    intro Y A B a b v0 hv0 h
    have h2 := congrArg Y.basicOpen h
    rw [Scheme.basicOpen_res, Scheme.basicOpen_mul, Scheme.basicOpen_of_isUnit _ hv0,
      Scheme.basicOpen_res] at h2
    have hb := Y.basicOpen_le b
    have ha := Y.basicOpen_le a
    calc A ⊓ Y.basicOpen b = A ⊓ B ⊓ Y.basicOpen b := by rw [inf_assoc, inf_eq_right.mpr hb]
      _ = A ⊓ B ⊓ (A ⊓ B ⊓ Y.basicOpen a) := h2
      _ = A ⊓ B ⊓ Y.basicOpen a := by rw [← inf_assoc, inf_idem]
      _ = B ⊓ Y.basicOpen a := by rw [inf_comm A B, inf_assoc, inf_eq_right.mpr ha]

  intro K _ X fX _ n m U hU g w hw htr
  have haff : ∀ J : Fin (m + 1), IsAffineOpen (wcSgD K m J) := by
    intro J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) := MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)) Nat.one_pos
  have hgen' : ∀ (J : Fin (m + 1)) (x : Γ(wcProjK K m, wcSgD K m J)), x ∈ Subring.closure
      (Set.range (wcSgE K m J) ∪ Set.range (fun c : Γ(Spec (.of K), ⊤) => (wcProjK K m).presheaf.map
        (homOfLE (le_top : wcSgD K m J ≤ ⊤)).op ((wcProjKStr K m).appTop c))) := by
    intro J x
    refine Subring.closure_mono ?_ (S1 K m J x)
    rintro _ (⟨L, rfl⟩ | ⟨c, rfl⟩)
    · exact Or.inl ⟨L, rfl⟩
    · exact Or.inr ⟨_, rfl⟩
  have hcovD0 : (⨆ a : Fin (m + 1), @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a)) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have hcovD : (⨆ a : Fin (m + 1), wcSgD K m a) = ⊤ := hcovD0

  let DD : ULift.{u} (Fin (n + 1) × Fin (m + 1)) → X.Opens := fun c => X.basicOpen (g c.down.1 c.down.2)
  let V : X.Opens := ⨆ c, DD c
  let W : ULift.{u} (Fin (n + 1) × Fin (m + 1)) → (V : Scheme.{u}).Opens := fun c => V.ι ⁻¹ᵁ DD c
  have hWU : ∀ c, W c ≤ V.ι ⁻¹ᵁ U c.down.1 := fun c =>
    Scheme.Hom.preimage_mono _ (X.basicOpen_le (g c.down.1 c.down.2))
  obtain ⟨s, hs⟩ : ∃ s : ∀ c, Fin (m + 1) → Γ((V : Scheme.{u}), W c), ∀ c l,
      s c l = V.ι.appLE (U c.down.1) (W c) (hWU c) (g c.down.1 l) :=
    ⟨fun c l => V.ι.appLE (U c.down.1) (W c) (hWU c) (g c.down.1 l), fun _ _ => rfl⟩
  have hcovW : (⨆ c, W c) = ⊤ :=
    (Scheme.Hom.preimage_iSup V.ι DD).symm.trans (Scheme.Opens.ι_preimage_self V)
  have hbo : ∀ c l, (V : Scheme.{u}).basicOpen (s c l) =
      W c ⊓ V.ι ⁻¹ᵁ X.basicOpen (g c.down.1 l) := by
    intro c l
    rw [hs]
    exact Scheme.basicOpen_appLE _ _ _ _ _
  have hWk : ∀ c, (V : Scheme.{u}).basicOpen (s c c.down.2) = W c := by
    intro c
    rw [hbo]
    exact inf_idem _
  have hspan : ∀ c, Ideal.span (Set.range (s c)) = ⊤ := fun c =>
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨c.down.2, rfl⟩)
      (isUnit_of_bo _ _ _ (hWk c))
  have eWW : ∀ c c', W c ⊓ W c' ≤ V.ι ⁻¹ᵁ (U c.down.1 ⊓ U c'.down.1) := by
    intro c c'
    rw [Scheme.Hom.preimage_inf]
    exact inf_le_inf (hWU c) (hWU c')
  have hwW : ∀ c c', IsUnit (V.ι.appLE (U c.down.1 ⊓ U c'.down.1) (W c ⊓ W c') (eWW c c')
      (w c.down.1 c'.down.1)) := fun c c' => (hw _ _).map _
  have htrW : ∀ c c' l, (V : Scheme.{u}).presheaf.map (homOfLE (inf_le_right : W c ⊓ W c' ≤ W c')).op (s c' l) =
      V.ι.appLE (U c.down.1 ⊓ U c'.down.1) (W c ⊓ W c') (eWW c c') (w c.down.1 c'.down.1) *
        (V : Scheme.{u}).presheaf.map (homOfLE (inf_le_left : W c ⊓ W c' ≤ W c)).op (s c l) := by
    intro c c' l
    rw [hs c' l, hs c l,
      hAmap V.ι (U c'.down.1) (W c') (W c ⊓ W c') inf_le_right (hWU c') (le_trans inf_le_right (hWU c')),
      hAmap V.ι (U c.down.1) (W c) (W c ⊓ W c') inf_le_left (hWU c) (le_trans inf_le_left (hWU c)),
      ← hmapA V.ι (U c.down.1 ⊓ U c'.down.1) (U c'.down.1) (W c ⊓ W c') inf_le_right (eWW c c')
        (le_trans inf_le_right (hWU c')),
      htr, map_mul,
      hmapA V.ι (U c.down.1 ⊓ U c'.down.1) (U c.down.1) (W c ⊓ W c') inf_le_left (eWW c c')
        (le_trans inf_le_left (hWU c))]

  obtain ⟨γ, hγ, hpre, hrel⟩ := PG (wcProjK K m) (Spec (.of K)) (wcProjKStr K m) (wcSgD K m) (wcSgE K m)
    hcovD (S3 K m) (fun W' g₁ g₂ t' hq hc' hg hg' hr hr' =>
      UQ _ _ _ (wcSgD K m) haff (wcSgE K m) hgen' W' g₁ g₂ t' hq hc' hg hg' hr hr')
    (V : Scheme.{u}) (V.ι ≫ fX) W hcovW s hspan
    (fun c c' => V.ι.appLE (U c.down.1 ⊓ U c'.down.1) (W c ⊓ W c') (eWW c c') (w c.down.1 c'.down.1))
    hwW htrW

  haveI : CompactSpace (V : Scheme.{u}) := by
    have hc : IsCompact ((V : X.Opens) : Set X) := by
      show IsCompact (((⨆ c, DD c : X.Opens)) : Set X)
      rw [TopologicalSpace.Opens.coe_iSup]
      exact isCompact_iUnion (fun c => ((hU c.down.1).basicOpen (g c.down.1 c.down.2)).isCompact)
    exact isCompact_iff_compactSpace.mp hc
  haveI := quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst fX (wcProjKStr K m) ≫ fX)
  refine ⟨(V : Scheme.{u}), Limits.pullback.lift V.ι γ hγ.symm,
    quasiCompact_of_compactSpace _, ?_⟩
  generalize hφ1 : Limits.pullback.lift V.ι γ hγ.symm ≫ Limits.pullback.fst fX (wcProjKStr K m) = φ1
  generalize hφ2 : Limits.pullback.lift V.ι γ hγ.symm ≫ Limits.pullback.snd fX (wcProjKStr K m) = φ2
  rw [Limits.pullback.lift_fst] at hφ1
  rw [Limits.pullback.lift_snd] at hφ2
  subst hφ1 hφ2

  have hb : ∀ J k, V.ι ⁻¹ᵁ U J ⊓ γ ⁻¹ᵁ wcSgD K m k ≤ V.ι ⁻¹ᵁ X.basicOpen (g J k) := by
    intro J k z hz
    have hz' : z ∈ V.ι ⁻¹ᵁ U J ⊓ γ ⁻¹ᵁ wcSgD K m k := hz
    have hzU : z ∈ V.ι ⁻¹ᵁ U J := (TopologicalSpace.Opens.mem_inf.mp hz').1
    have hzD : z ∈ γ ⁻¹ᵁ wcSgD K m k := (TopologicalSpace.Opens.mem_inf.mp hz').2
    have hzW : z ∈ (⨆ c, W c) := by rw [hcovW]; trivial
    obtain ⟨c', hc'⟩ := TopologicalSpace.Opens.mem_iSup.mp hzW
    have h1 : z ∈ γ ⁻¹ᵁ wcSgD K m k ⊓ W c' := TopologicalSpace.Opens.mem_inf.mpr ⟨hzD, hc'⟩
    rw [hpre c' k, hbo c' k] at h1
    have h2 : V.ι z ∈ X.basicOpen (g c'.down.1 k) :=
      (Scheme.Hom.mem_preimage _).mp (TopologicalSpace.Opens.mem_inf.mp h1).2
    have h3 : V.ι z ∈ U J ⊓ X.basicOpen (g c'.down.1 k) :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨(Scheme.Hom.mem_preimage _).mp hzU, h2⟩
    rw [hov X (U J) (U c'.down.1) (g J k) (g c'.down.1 k) (w J c'.down.1) (hw _ _)
      (htr J c'.down.1 k)] at h3
    exact (Scheme.Hom.mem_preimage _).mpr (TopologicalSpace.Opens.mem_inf.mp h3).2

  have hOW : ∀ J k, V.ι ⁻¹ᵁ U J ⊓ γ ⁻¹ᵁ wcSgD K m k = W ⟨(J, k)⟩ := by
    intro J k
    apply le_antisymm
    · exact hb J k
    · apply le_inf (hWU ⟨(J, k)⟩)
      exact (hWk ⟨(J, k)⟩).symm.le.trans ((hpre ⟨(J, k)⟩ k).symm.le.trans inf_le_left)
  refine ⟨hb, ?_, ?_⟩

  · intro J k l
    have e := hrel ⟨(J, k)⟩ k l (V.ι ⁻¹ᵁ U J ⊓ γ ⁻¹ᵁ wcSgD K m k) inf_le_right (hOW J k).le
    have r : ∀ l', (V : Scheme.{u}).presheaf.map (homOfLE (hOW J k).le).op (s ⟨(J, k)⟩ l') =
        V.ι.appLE (U J) (V.ι ⁻¹ᵁ U J ⊓ γ ⁻¹ᵁ wcSgD K m k) inf_le_left (g J l') := by
      intro l'
      rw [hs]
      exact hAmap V.ι (U J) _ _ (hOW J k).le (hWU ⟨(J, k)⟩) inf_le_left (g J l')
    rw [r, r] at e
    exact e

  · intro J k F hF
    have h1 : V.ι.appLE (U J) (W ⟨(J, k)⟩) (hWU ⟨(J, k)⟩) F = 0 := by
      rw [← hAmap V.ι (U J) _ (W ⟨(J, k)⟩) (hOW J k).ge inf_le_left (hWU ⟨(J, k)⟩) F, hF, map_zero]
    have hE : V.ι ''ᵁ (W ⟨(J, k)⟩) = X.basicOpen (g J k) := by
      show V.ι ''ᵁ (V.ι ⁻¹ᵁ X.basicOpen (g J k)) = _
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr (le_iSup DD ⟨(J, k)⟩)
    have hk : V.ι ''ᵁ (W ⟨(J, k)⟩) ≤ U J := hE.le.trans (X.basicOpen_le _)
    rw [Scheme.Opens.ι_appLE] at h1
    calc X.presheaf.map (homOfLE (X.basicOpen_le (g J k))).op F
        = X.presheaf.map (homOfLE hE.ge).op (X.presheaf.map (homOfLE hk).op F) :=
          (hres X (U J) _ _ hk hE.ge _ F).symm
      _ = X.presheaf.map (homOfLE hE.ge).op 0 := congrArg (X.presheaf.map (homOfLE hE.ge).op) h1
      _ = 0 := map_zero _

theorem wc_csd_blowup_model_charts : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [IsSeparated fX] (I : X.IdealSheafData) (n m : ℕ) (U : Fin (n + 1) → X.Opens) (hU : ∀ J, IsAffineOpen (U J)) (g : ∀ J, Fin (m + 1) → Γ(X, U J)) (w : ∀ J L, Γ(X, U J ⊓ U L)), (⨆ J, U J) = ⊤ → (∀ J, I.ideal ⟨U J, hU J⟩ = Ideal.span (Set.range (g J))) → (∀ J L, IsUnit (w J L)) → (∀ J L l, X.presheaf.map (homOfLE (inf_le_right : U J ⊓ U L ≤ U L)).op (g L l) = w J L * X.presheaf.map (homOfLE (inf_le_left : U J ⊓ U L ≤ U J)).op (g J l)) → ∃ (P : Scheme.{u}) (ι : P ⟶ Limits.pullback fX (wcProjKStr K m)), IsClosedImmersion ι ∧ (∀ J k, (ι ≫ Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_left (g J k) ∈ nonZeroDivisors Γ(P, (ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k)) ∧ (∀ J k l, (ι ≫ Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_left (g J l) = (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)).appLE (wcSgD K m k) ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_right (wcSgE K m k l) * (ι ≫ Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_left (g J k)) ∧ (∀ J k (y : Γ(Limits.pullback fX (wcProjKStr K m), Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k)), ι.app (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) y = 0 → ∀ (R : Type u) [CommRing R] (π : Γ(Limits.pullback fX (wcProjKStr K m), Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) →+* R) (c : R) (ρ : Fin (m + 1) → R), (∀ l, π ((Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) inf_le_left (g J l)) = c * ρ l) → (∀ l, π ((Limits.pullback.snd fX (wcProjKStr K m)).appLE (wcSgD K m k) (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) inf_le_right (wcSgE K m k l)) * ρ k = ρ l) → c ∈ nonZeroDivisors R → IsUnit (ρ k) → π y = 0) :=
by
  intro K _ X fX _ I n m U hU g w hcov hI hw htr

  have hres : ∀ (Y : Scheme.{u}) (A B C : Y.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (x : Γ(Y, A)), Y.presheaf.map (homOfLE h2).op (Y.presheaf.map (homOfLE h1).op x) =
        Y.presheaf.map (homOfLE h3).op x := by
    intro Y A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hid : ∀ (Y : Scheme.{u}) (A : Y.Opens) (h : A ≤ A) (x : Γ(Y, A)),
      Y.presheaf.map (homOfLE h).op x = x := by
    intro Y A h x
    rw [show (homOfLE h).op = 𝟙 (Opposite.op A) from rfl, CategoryTheory.Functor.map_id]
    rfl
  have hAmap : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V : B.Opens) (O1 O2 : A.Opens) (h12 : O2 ≤ O1)
      (e1 : O1 ≤ f ⁻¹ᵁ V) (e2 : O2 ≤ f ⁻¹ᵁ V) (x : Γ(B, V)),
