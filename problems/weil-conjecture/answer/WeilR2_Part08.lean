  have PG : ∀ (P S : Scheme.{u}) (q : P ⟶ S) {ι : Type} (D : ι → P.Opens) (ε : ∀ J, ι → Γ(P, D J)),
      (⨆ J, D J) = ⊤ →
      (∀ (V : Scheme.{u}) (fV : V ⟶ S) (t : ι → Γ(V, ⊤)), Ideal.span (Set.range t) = ⊤ →
        ∃ φ : V ⟶ P, φ ≫ q = fV ∧ (∀ J, φ ⁻¹ᵁ D J = V.basicOpen (t J)) ∧
          ∀ J L (O : V.Opens) (hO : O ≤ φ ⁻¹ᵁ D J), φ.appLE (D J) O hO (ε J L) *
            V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
