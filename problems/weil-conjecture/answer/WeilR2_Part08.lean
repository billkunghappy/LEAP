  have hq₂ε : q₂ ≫ ε = ι ≫ qB := by
    rw [hq₂, Category.assoc, hεq, hqB]
  have hqδ : (ι ≫ qB) ≫ δ = q₂ := by
    obtain ⟨-, -, -, -, hlim₂, -⟩ := id hd₂
    have hcompat₂ : ∀ {l l' : Λ₂} (t : l ⟶ l'),
