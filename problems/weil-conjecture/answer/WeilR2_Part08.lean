      exact this
    let desc : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))
        (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))),
        CommRingCat.of (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)) ⟶ s.pt :=
      fun s => CommRingCat.ofHom (IsLocalization.Away.lift (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) (hφu s))
    have hdesc : ∀ s r, (desc s).hom (ι r) = φ s r := by
      intro s r
      exact IsLocalization.Away.lift_eq _ (hφu s) r
    refine IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk comm desc ?_ ?_ ?_)
    · intro s
      ext1
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        rw [hσC, hdesc, hφC]
      · intro i
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        rw [hσX, hdesc, hφS]
    · intro s
      ext1
      apply hLext
      · intro a
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        rw [hεC, hdesc, hφC, hcond]
      · simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        rw [hεT, hdesc, hφ0]
    · intro s m h1 h2
      ext1
      have e1 : ∀ x, m.hom (ι (σ x)) = s.inl.hom x := fun x => by
        have := congrArg (fun f => f.hom x) h1
        simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] using this
      have e2 : ∀ x, m.hom (ε x) = s.inr.hom x := fun x => by
        have := congrArg (fun f => f.hom x) h2
        simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] using this
      apply hLocext
      · intro a
        rw [hdesc, hφC, ← e1, hσC]
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · rw [hdesc, hφ0, ← e2, hεT]
        · rw [hdesc, hφS, ← e1, hσX]

  obtain ⟨ε, hch⟩ := hs2
  have hoa' : Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap]
    simp
  obtain ⟨P', p', q', hP'⟩ : ∃ (P' : Scheme.{u}) (p' : P' ⟶ S1)
      (q' : P' ⟶ Spec (.of (MvPolynomial (Fin c') K))),
      IsPullback p' q' (s1 ≫ fS) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  obtain ⟨z0', hz0p', hz0q'⟩ : ∃ z0' : S1 ⟶ P', z0' ≫ p' = 𝟙 S1 ∧
      z0' ≫ q' = (s1 ≫ fS) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K)) :=
    ⟨hP'.lift (𝟙 S1) ((s1 ≫ fS) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K)))
      (by rw [Category.id_comp, Category.assoc, hoa', Category.comp_id]),
      hP'.lift_fst _ _ _, hP'.lift_snd _ _ _⟩
  obtain ⟨W, hW⟩ : ∃ W : (Spec (.of (MvPolynomial (Fin c') K))).Opens,
      W = ⨆ i : Fin c', PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin c') K) := ⟨_, rfl⟩
  have hU' : ((q' ⁻¹ᵁ W : P'.Opens) : Set P') = (Set.range z0')ᶜ := by
    rw [hW]; exact hs1 S1 (s1 ≫ fS) c' P' p' q' z0' hP' hz0p' hz0q'
  have hU'sq : IsPullback ((q' ⁻¹ᵁ W).ι ≫ p') (q' ∣_ W) (s1 ≫ fS)
      (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) :=
    (IsPullback.paste_vert (isPullback_morphismRestrict q' W) hP'.flip).flip
  obtain ⟨jA, hjA⟩ : ∃ jA : Spec (.of (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K))) ⟶
      Spec (.of (MvPolynomial (Fin (c' + 1)) K)),
      jA = Spec.map (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin (c' + 1)) K)
        (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)))) := ⟨_, rfl⟩
  haveI : IsOpenImmersion jA := by
    rw [hjA]; exact IsOpenImmersion.of_isLocalization (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)
  obtain ⟨Sσ, hSσ⟩ : ∃ Sσ : Spec (.of (MvPolynomial (Fin (c' + 1)) K)) ⟶ Spec (.of (MvPolynomial (Fin c') K)),
      Sσ = Spec.map (CommRingCat.ofHom (MvPolynomial.rename (R := K) (Fin.succ : Fin c' → Fin (c' + 1))).toRingHom) :=
    ⟨_, rfl⟩
  obtain ⟨Sσ', hSσ'⟩ : ∃ Sσ' : Spec (.of (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K))) ⟶
      Spec (.of (MvPolynomial (Fin c') K)),
      Sσ' = Spec.map (CommRingCat.ofHom ((algebraMap (MvPolynomial (Fin (c' + 1)) K) (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K))).comp (MvPolynomial.rename (R := K) (Fin.succ : Fin c' → Fin (c' + 1))).toRingHom)) :=
    ⟨_, rfl⟩
  rw [← hSσ'] at hch
  have E3 : jA ≫ Sσ = Sσ' := by
    rw [hjA, hSσ, hSσ', ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have E3' : (Sσ' ⁻¹ᵁ W).ι ≫ Sσ' = (Sσ' ⁻¹ᵁ W).ι ≫ jA ≫ Sσ := by rw [E3]
  have hpt : ∀ z, Sσ' z = Sσ (jA z) := fun z => by rw [← E3, Scheme.Hom.comp_apply]
  have E2 : Sσ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) =
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    have e : ((MvPolynomial.rename (R := K) (Fin.succ : Fin c' → Fin (c' + 1))).toRingHom).comp
