    (Scheme.Hom.comp_apply qB ã _).trans (congrArg ã (hqBpt _))
  have htpr : (qB ≫ ã) ≫ pr = wcEtGeomPt (wcHalA1 s) x := by
    rw [Category.assoc, hãpr, hqBa]
  obtain ⟨ι, hι⟩ := wc_geomPt_rebase_lift pr x (ã (IsLocalRing.closedPoint B)) hprx (qB ≫ ã) htpt htpr
  have hιgeom : ι ≫ wcEtGeomPt (wcHalA1 s) x =
