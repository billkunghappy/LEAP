  have hgc : gc ≫ I.cocomplex.d 1 (1 + 1) = 0 := by
    rw [hgc_def, Preadditive.nsmul_comp, hg, smul_zero]
  obtain ⟨k, hk_def⟩ : ∃ k : SheafOfModules.unit (wcEtZModRing X ℓ) ⟶ R1.obj (I.cocomplex.X 1),
      k = D1.adj.homEquiv _ _ gc := ⟨_, rfl⟩
  have hk_sm : k = m • D1.adj.homEquiv _ _ g := by
