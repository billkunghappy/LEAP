  refine ⟨Functor.sheafPullbackConstruction.sheafPullback G AddCommGrpCat.{u+1} J K, adj,
    ?_, ?_, ?_, ?_, h5⟩
  · have := hfl
    show Limits.PreservesFiniteLimits (sheafToPresheaf J AddCommGrpCat.{u+1} ⋙ G.op.lan ⋙
