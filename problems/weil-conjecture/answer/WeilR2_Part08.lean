        AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down) := by
      rw [s2, hψq]
    refine ⟨AffineSpace.homOfVector ψG (fun j : ULift.{u} (Fin c) => h j.down), i ≫ ψG, ?_, hpr, ?_⟩
    · rw [← Category.assoc, hchart, s2, hψq, hMA]
    · refine IsPullback.of_right (h₁₂ := qG) (h₂₂ := AffineSpace.map (ULift.{u} (Fin c)) qG)
        (v₁₃ := AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))
        ?_ ?_ hSpr
      · rw [Category.assoc, hψq, hpr]


        obtain ⟨hAff, hI, hker⟩ := hcut
        haveI := hAff
        haveI := hI
        set z := AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))
          with hz
        set φ := AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down) with hφ
        have hb : ∀ {T : Scheme.{u}} (b : T ⟶ W) (j : ULift.{u} (Fin c)),
            (b ≫ φ).appTop.hom (AffineSpace.coord (Spec (.of K)) j) = b.appTop.hom (h j.down) := by
          intro T b j
          rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, hφ,
            AffineSpace.homOfVector_appTop_coord]
        have ha : ∀ {T : Scheme.{u}} (a : T ⟶ Spec (.of K)) (j : ULift.{u} (Fin c)),
            (a ≫ z).appTop.hom (AffineSpace.coord (Spec (.of K)) j) = 0 := by
          intro T a j
          rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, hz,
            AffineSpace.homOfVector_appTop_coord, Pi.zero_apply, map_zero]
        have hzπ : z ≫ (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K)) = 𝟙 _ :=
          AffineSpace.homOfVector_over _ _
        have hφπ : φ ≫ (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K)) = fW :=
          AffineSpace.homOfVector_over _ _
        have hcone1 : ∀ {T : Scheme.{u}} (a : T ⟶ Spec (.of K)) (b : T ⟶ W),
            a ≫ z = b ≫ φ → a = b ≫ fW := by
          intro T a b e
          have e' := congrArg (· ≫ (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K))) e
          simp only [Category.assoc, hzπ, hφπ, Category.comp_id] at e'
          exact e'
        have hcone2 : ∀ {T : Scheme.{u}} (a : T ⟶ Spec (.of K)) (b : T ⟶ W), a ≫ z = b ≫ φ →
            ∀ j : Fin c, b.appTop.hom (h j) = 0 := by
          intro T a b e j
          have e' : (a ≫ z).appTop.hom (AffineSpace.coord (Spec (.of K)) (ULift.up j)) =
              (b ≫ φ).appTop.hom (AffineSpace.coord (Spec (.of K)) (ULift.up j)) := by rw [e]
          rw [ha, hb] at e'
          exact e'.symm
        have hle : ∀ {T : Scheme.{u}} (b : T ⟶ W), (∀ j : Fin c, b.appTop.hom (h j) = 0) →
