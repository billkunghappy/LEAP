by
  classical
  intro X n O I W OW hOW b H c hc0 hc1

  have hcomp : ∀ (F : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {A B C : X.Etale} (f : A ⟶ B)
      (g : B ⟶ C) (x : F.obj (Opposite.op C)),
