      have h := s3 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) V F hF Nat.one_pos (hX J) 1
        (MvPolynomial.X L) hy
      rw [hFX, hFX, pow_one] at h
      have e := congrArg (V.presheaf.map (homOfLE hO).op) h
      rw [map_mul, hres, hres] at e
      exact e

  intro K _ N m
  have hcov : ∀ n : ℕ, (⨆ a : Fin (n + 1), wcSgD K n a) = ⊤ := fun n => wc_pp_basicOpen_cover K n
  have haff : ∀ (n : ℕ) (J : Fin (n + 1)), IsAffineOpen (wcSgD K n J) := by
    intro n J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)) Nat.one_pos
  have hgen' : ∀ (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)), x ∈ Subring.closure
      (Set.range (wcSgE K n J) ∪ Set.range (fun c : Γ(Spec (.of K), ⊤) => (wcProjK K n).presheaf.map
        (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop c))) := by
    intro n J x
    refine Subring.closure_mono ?_ (S1 K n J x)
    rintro _ (⟨L, rfl⟩ | ⟨c, rfl⟩)
    · exact Or.inl ⟨L, rfl⟩
    · exact Or.inr ⟨_, rfl⟩
  have hpg := fun n : ℕ => PG (wcProjK K n) (Spec (.of K)) (wcProjKStr K n) (wcSgD K n) (wcSgE K n)
    (hcov n) (S3 K n) (fun W g g' t hq hc hg hg' hr hr' =>
      UQ _ _ _ (wcSgD K n) (haff n) (wcSgE K n) (hgen' n) W g g' t hq hc hg hg' hr hr')
  obtain ⟨N', e, σ, h, hover, hpre, hcoords⟩ := wc_segre_glue K N m hcov (S2 K) hpg
  exact ⟨N', σ, wc_segre_closed_of_coords K N m N' hcov (S1 K) (S2 K) wc_closed_in_product_chart_gen
    e σ h hover hpre hcoords, hover⟩

theorem wc_csd_blowup_chart_generators : ∀ (K : Type u) [Field K] (N : ℕ) (X : Scheme.{u}) (j : X ⟶ wcProjK K N) (I : X.IdealSheafData), IsClosedImmersion j → ∃ (m : ℕ) (g : ∀ J : Fin (N + 1), Fin (m + 1) → Γ(X, j ⁻¹ᵁ wcSgD K N J)) (w : ∀ J L : Fin (N + 1), Γ(X, j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L)), (∀ (J : Fin (N + 1)) (hJ : IsAffineOpen (j ⁻¹ᵁ wcSgD K N J)), I.ideal ⟨j ⁻¹ᵁ wcSgD K N J, hJ⟩ = Ideal.span (Set.range (g J))) ∧ (∀ J L, IsUnit (w J L)) ∧ (∀ J L (l : Fin (m + 1)), X.presheaf.map (homOfLE (inf_le_right : j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L ≤ j ⁻¹ᵁ wcSgD K N L)).op (g L l) = w J L * X.presheaf.map (homOfLE (inf_le_left : j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L ≤ j ⁻¹ᵁ wcSgD K N J)).op (g J l)) :=
by
  intro K _ N X j I hj
  classical
  haveI := hj
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) := MvPolynomial.gradedAlgebra
  have hX : ∀ k : Fin (N + 1), (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)


  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1), Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
  have L2 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g h : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hh : h ∈ 𝒜 1), (Proj 𝒜).presheaf.map (homOfLE (inf_le_left : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) = (Proj 𝒜).presheaf.map (homOfLE (inf_le_left : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) * (Proj 𝒜).presheaf.map (homOfLE (inf_le_right : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
    intro σ A _ _ _ 𝒜 _ f g h hf hg hh
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) =
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a
        exact this.symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b
        exact this.symm
      rw [e1, e1, e2, ← map_mul]
      congr 1
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _
  have S2 : ∀ (J L i : Fin (N + 1)), wcSgE K N J J = 1 ∧
      (wcProjK K N).basicOpen (wcSgE K N J L) = wcSgD K N J ⊓ wcSgD K N L ∧
      (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op (wcSgE K N J i) =
        (wcProjK K N).presheaf.map (homOfLE (inf_le_left : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N J)).op (wcSgE K N J L) *
        (wcProjK K N).presheaf.map (homOfLE (inf_le_right : wcSgD K N J ⊓ wcSgD K N L ≤ wcSgD K N L)).op (wcSgE K N L i) := by
    intro J L i
    refine ⟨?_, ?_, ?_⟩
    · have h1 : HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX J) 1
          (MvPolynomial.X J) (hX J) = 1 := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
          ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        exact ⟨1, by simp⟩
      show Proj.awayToSection _ _ _ = 1
      rw [h1, map_one]
    · exact (L1 _ (MvPolynomial.X J) (MvPolynomial.X L) (hX J) (hX L)).symm
    · exact L2 _ (MvPolynomial.X J) (MvPolynomial.X L) (MvPolynomial.X i) (hX J) (hX L) (hX i)


  have S1 : ∀ (J : Fin (N + 1)) (x : Γ(wcProjK K N, wcSgD K N J)), ∃ (d : ℕ) (F : MvPolynomial (Fin (N + 1)) K),
      F.IsHomogeneous d ∧ x = MvPolynomial.eval₂ ((Scheme.ΓSpecIso (.of K)).inv ≫ (wcProjKStr K N).appTop ≫
        (wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N J ≤ ⊤)).op).hom (wcSgE K N J) F := by
    intro J x
    have GEN : ∀ (k : Fin (N + 1)) (d : ℕ) (F : MvPolynomial (Fin (N + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
        have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
        simpa using this
      have scale : ∀ {L : Type u} [CommRing L] (χ : K →+* L) (g : Fin (N + 1) → L) (t : L),
          MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
        intro L _ χ g t
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun e he => ?_)
        have hdeg : ∑ i ∈ e.support, e i = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
        simp_rw [mul_pow]
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
        ring
      apply HomogeneousLocalization.val_injective
      rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
        MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      calc _ = MvPolynomial.eval₂
            ((algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K)))).comp
              MvPolynomial.C)
            (fun l => algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K)))
              (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K))) F := by
            congr 1
            funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
        _ = _ := by
            rw [scale]
            have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (N + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K))))
              MvPolynomial.C MvPolynomial.X F
            rw [MvPolynomial.eval₂_eta] at h2
            rw [show (fun l => algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K)))
                (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (N + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K)))) ∘
                MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
              ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
              Localization.r_iff_exists]
            refine ⟨1, ?_⟩
            simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow, ← pow_mul]
    have hι : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).Opens) a,
        U.ι.appTop a = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a) := by
      intro U a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ c : K, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X J)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) c)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).presheaf.map (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)) ≤ ⊤)).op).hom ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0)))).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
      intro c
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X J) (hX J) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)))).hom ≫ Proj.awayToSection _ (MvPolynomial.X J) ≫ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)))).inv y) := by rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X J)) ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hι] at e4
      have hinj : ∀ a b : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).topIso.inv a =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).topIso.inv b → a = b := by
        intro a b h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm
    have hs : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X J) ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x) = x := by
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos) x
      rwa [Proj.basicOpenIsoAway_hom] at this
    obtain ⟨d, F, hF, hmk⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX J)
      ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x)
    refine ⟨d, F, ?_, ?_⟩
    · have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
      simpa using this
    · rw [← hs, ← hmk, ← GEN J d F hF]
      change (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X J)).hom _ = _
      rw [MvPolynomial.eval₂_comp_left]
      congr 1
      · apply RingHom.ext
        intro c
        exact (hconst c).trans rfl


  have s3 : ∀ (U V : X.Opens) (hU : IsAffineOpen U) (hV : IsAffineOpen V) (hVU : V ≤ U) (f : Γ(X, U)),
      X.basicOpen f = V → ∀ s : Γ(X, U), (X.presheaf.map (homOfLE hVU).op).hom s ∈ I.ideal ⟨V, hV⟩ →
        ∃ k : ℕ, f ^ k * s ∈ I.ideal ⟨U, hU⟩ := by
    intro U V hU hV hVU f hf s hs
    letI : Algebra Γ(X, U) Γ(X, V) := (X.presheaf.map (homOfLE hVU).op).hom.toAlgebra
    haveI : IsLocalization.Away f Γ(X, V) := hU.isLocalization_of_eq_basicOpen f (homOfLE hVU) hf.symm
    have hmap := I.map_ideal (U := ⟨V, hV⟩) (V := ⟨U, hU⟩) hVU
    rw [← hmap] at hs
    have hs' : algebraMap Γ(X, U) Γ(X, V) s ∈
        Ideal.map (algebraMap Γ(X, U) Γ(X, V)) (I.ideal ⟨U, hU⟩) := hs
    obtain ⟨m, hm, hk⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers f) Γ(X, V) _ s).mp hs'
    obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hm
    exact ⟨k, hk⟩


  have s4 : ∀ (A A' B : Type u) [CommRing A] [CommRing A'] [CommRing B] (κ : K →+* A) (κ' : K →+* A')
      (ε : Fin (N + 1) → A) (ε' : Fin (N + 1) → A') (ρ : A →+* B) (ρ' : A' →+* B) (u : B),
      ρ.comp κ = ρ'.comp κ' → (∀ i, ρ' (ε' i) = u * ρ (ε i)) → ∀ (d : ℕ) (F : MvPolynomial (Fin (N + 1)) K),
      F.IsHomogeneous d → ρ' (MvPolynomial.eval₂ κ' ε' F) = u ^ d * ρ (MvPolynomial.eval₂ κ ε F) := by
    intro A A' B _ _ _ κ κ' ε ε' ρ ρ' u hκ hε d F hF
    rw [MvPolynomial.eval₂_comp_left, MvPolynomial.eval₂_comp_left, ← hκ]
    have : (⇑ρ' ∘ ε') = fun i => u * ρ (ε i) := funext hε
    rw [this, MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a ha => ?_)
    have hdeg : ∑ i ∈ a.support, a i = d := by
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp ha) (hF.coeff_eq_zero hne)
    simp_rw [mul_pow]
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    simp only [Function.comp_apply]
    ring


  have s5 : ∀ (A : Fin (N + 1) → Type u) [∀ J, CommRing (A J)] (B : Fin (N + 1) → Fin (N + 1) → Type u)
      [∀ J L, CommRing (B J L)] (κ : ∀ J, K →+* A J) (ε : ∀ J, Fin (N + 1) → A J)
      (ρ₁ : ∀ J L, A J →+* B J L) (ρ₂ : ∀ J L, A L →+* B J L) (I : ∀ J, Ideal (A J))
      (I' : ∀ J L, Ideal (B J L)), (∀ J, ε J J = 1) →
      (∀ J (x : A J), ∃ (d : ℕ) (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous d ∧
        x = MvPolynomial.eval₂ (κ J) (ε J) F) →
      (∀ J L (d : ℕ) (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous d →
        ρ₂ J L (MvPolynomial.eval₂ (κ L) (ε L) F) =
          ρ₂ J L (ε L J) ^ d * ρ₁ J L (MvPolynomial.eval₂ (κ J) (ε J) F)) →
      (∀ J L, IsUnit (ρ₂ J L (ε L J))) → (∀ J L, ∀ t ∈ I J, ρ₁ J L t ∈ I' J L) →
      (∀ J L (s : A L), ρ₂ J L s ∈ I' J L → ∃ k : ℕ, ε L J ^ k * s ∈ I L) →
      ∃ (m : ℕ) (g : ∀ J, Fin (m + 1) → A J) (w : ∀ J L, B J L),
        (∀ J, I J = Ideal.span (Set.range (g J))) ∧ (∀ J L, IsUnit (w J L)) ∧
          ∀ J L l, ρ₂ J L (g L l) = w J L * ρ₁ J L (g J l) := by
    intro A _ B _ κ ε ρ₁ ρ₂ I I' H1 H2 H3 H4 H5 H6
    have hfg : ∀ J, ∃ (r : ℕ) (h : Fin r → A J), Submodule.span (A J) (Set.range h) = I J := by
      intro J
      have hsurj : Function.Surjective (MvPolynomial.eval₂Hom (κ J) (ε J)) := by
        intro x
        obtain ⟨d, F, -, hx⟩ := H2 J x
        exact ⟨F, hx.symm⟩
      have := isNoetherianRing_of_surjective _ _ _ hsurj
      exact Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian (I J))
    choose r h hh using hfg
    have hmem : ∀ J k, h J k ∈ I J := fun J k => by
      rw [← hh J]; exact Submodule.subset_span ⟨k, rfl⟩
    have hgen : ∀ J k, ∃ (d : ℕ) (F : MvPolynomial (Fin (N + 1)) K), F.IsHomogeneous d ∧
        h J k = MvPolynomial.eval₂ (κ J) (ε J) F := fun J k => H2 J (h J k)
    choose d F hFh hFe using hgen
    let e : ℕ := Finset.univ.sup (fun t : (Σ J : Fin (N + 1), Fin (r J)) => d t.1 t.2)
    have hde : ∀ J k, d J k ≤ e := fun J k =>
      Finset.le_sup (f := fun t : (Σ J : Fin (N + 1), Fin (r J)) => d t.1 t.2) (Finset.mem_univ ⟨J, k⟩)
    let H : ∀ J, Fin (r J) → MvPolynomial (Fin (N + 1)) K := fun J k =>
      MvPolynomial.X J ^ (e - d J k) * F J k
    have hHh : ∀ J k, (H J k).IsHomogeneous e := by
      intro J k
      have := (MvPolynomial.isHomogeneous_X_pow (R := K) J (e - d J k)).mul (hFh J k)
      rwa [Nat.sub_add_cancel (hde J k)] at this
    have hHe : ∀ J k, MvPolynomial.eval₂ (κ J) (ε J) (H J k) = h J k := by
      intro J k
      simp only [H, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X_pow, H1, one_pow, one_mul]
      exact (hFe J k).symm
    have hclr : ∀ (t : Σ J : Fin (N + 1), Fin (r J)) (L : Fin (N + 1)), ∃ k : ℕ,
        ε L t.1 ^ k * MvPolynomial.eval₂ (κ L) (ε L) (H t.1 t.2) ∈ I L := by
      rintro ⟨J, k⟩ L
      apply H6 J L
      rw [H3 J L e _ (hHh J k), hHe J k]
      exact Ideal.mul_mem_left _ _ (H5 J L _ (hmem J k))
    choose kc hkc using hclr
    let M : ℕ := Finset.univ.sup (fun p : (Σ J : Fin (N + 1), Fin (r J)) × Fin (N + 1) => kc p.1 p.2)
    have hkM : ∀ t L, kc t L ≤ M := fun t L =>
      Finset.le_sup (f := fun p : (Σ J : Fin (N + 1), Fin (r J)) × Fin (N + 1) => kc p.1 p.2)
        (Finset.mem_univ (t, L))
    let G : (Σ J : Fin (N + 1), Fin (r J)) → MvPolynomial (Fin (N + 1)) K := fun t =>
      MvPolynomial.X t.1 ^ M * H t.1 t.2
    have hGh : ∀ t, (G t).IsHomogeneous (M + e) := fun t =>
      (MvPolynomial.isHomogeneous_X_pow (R := K) _ M).mul (hHh t.1 t.2)
    have hP1 : ∀ t L, MvPolynomial.eval₂ (κ L) (ε L) (G t) ∈ I L := by
      intro t L
      have e1 : MvPolynomial.eval₂ (κ L) (ε L) (G t) = ε L t.1 ^ (M - kc t L) *
          (ε L t.1 ^ kc t L * MvPolynomial.eval₂ (κ L) (ε L) (H t.1 t.2)) := by
        simp only [G, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X_pow]
        rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel (hkM t L)]
      rw [e1]
      exact Ideal.mul_mem_left _ _ (hkc t L)
    have hP2 : ∀ J k, MvPolynomial.eval₂ (κ J) (ε J) (G ⟨J, k⟩) = h J k := by
      intro J k
      simp only [G, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X_pow, H1, one_pow, one_mul]
      exact hHe J k
    let eqv := Fintype.equivFin (Σ J : Fin (N + 1), Fin (r J))
    let m := Fintype.card (Σ J : Fin (N + 1), Fin (r J))
    let g : ∀ L, Fin (m + 1) → A L := fun L l =>
      if hl : (l : ℕ) < m then MvPolynomial.eval₂ (κ L) (ε L) (G (eqv.symm ⟨l, hl⟩)) else 0
    refine ⟨m, g, fun J L => ρ₂ J L (ε L J) ^ (M + e), ?_, fun J L => (H4 J L).pow _, ?_⟩
    · intro L
      apply le_antisymm
      · rw [← hh L]
        apply Submodule.span_le.mpr
        rintro _ ⟨k, rfl⟩
        apply Ideal.subset_span
        refine ⟨Fin.castSucc (eqv ⟨L, k⟩), ?_⟩
        have hl : ((Fin.castSucc (eqv ⟨L, k⟩) : Fin (m + 1)) : ℕ) < m := (eqv ⟨L, k⟩).isLt
        simp only [g, dif_pos hl]
        have hx : (⟨((Fin.castSucc (eqv ⟨L, k⟩) : Fin (m + 1)) : ℕ), hl⟩ : Fin m) = eqv ⟨L, k⟩ :=
          Fin.ext rfl
        rw [hx, Equiv.symm_apply_apply]
        exact hP2 L k
      · apply Ideal.span_le.mpr
        rintro _ ⟨l, rfl⟩
        simp only [g]
        split_ifs with hl
        · exact hP1 _ L
        · exact zero_mem _
    · intro J L l
      simp only [g]
      split_ifs with hl
      · exact H3 J L (M + e) _ (hGh _)
      · simp


  have hD : ∀ J : Fin (N + 1), IsAffineOpen (wcSgD K N J) := fun J =>
    Proj.isAffineOpen_basicOpen _ _ (hX J) Nat.one_pos
  have hU : ∀ J : Fin (N + 1), IsAffineOpen (j ⁻¹ᵁ wcSgD K N J) := fun J => (hD J).preimage j
  have hres : ∀ (D D' : (wcProjK K N).Opens) (hDD : D' ≤ D) (W : X.Opens) (hW : W ≤ j ⁻¹ᵁ D')
      (hW' : W ≤ j ⁻¹ᵁ D) (y : Γ(wcProjK K N, D)),
      j.appLE D' W hW ((wcProjK K N).presheaf.map (homOfLE hDD).op y) =
        X.presheaf.map (homOfLE hW').op (j.app D y) := by
    intro D D' hDD W hW hW' y
    rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
    rfl
  let κ : ∀ J : Fin (N + 1), K →+* Γ(X, j ⁻¹ᵁ wcSgD K N J) := fun J =>
    (j.app (wcSgD K N J)).hom.comp ((Scheme.ΓSpecIso (.of K)).inv ≫ (wcProjKStr K N).appTop ≫
      (wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N J ≤ ⊤)).op).hom
  let ε : ∀ J : Fin (N + 1), Fin (N + 1) → Γ(X, j ⁻¹ᵁ wcSgD K N J) := fun J L =>
    j.app (wcSgD K N J) (wcSgE K N J L)
  let ρ₁ : ∀ J L : Fin (N + 1), Γ(X, j ⁻¹ᵁ wcSgD K N J) →+* Γ(X, j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L) :=
    fun J L => (X.presheaf.map (homOfLE (inf_le_left : j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L ≤ j ⁻¹ᵁ wcSgD K N J)).op).hom
  let ρ₂ : ∀ J L : Fin (N + 1), Γ(X, j ⁻¹ᵁ wcSgD K N L) →+* Γ(X, j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L) :=
    fun J L => (X.presheaf.map (homOfLE (inf_le_right : j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L ≤ j ⁻¹ᵁ wcSgD K N L)).op).hom
  have hεJJ : ∀ J, ε J J = 1 := by
    intro J
    show j.app (wcSgD K N J) (wcSgE K N J J) = 1
    rw [(S2 J J J).1, map_one]
  have hgen : ∀ J (x : Γ(X, j ⁻¹ᵁ wcSgD K N J)), ∃ (d : ℕ) (F : MvPolynomial (Fin (N + 1)) K),
      F.IsHomogeneous d ∧ x = MvPolynomial.eval₂ (κ J) (ε J) F := by
    intro J x
    obtain ⟨y, rfl⟩ := Scheme.Hom.app_surjective j (wcSgD K N J) (hD J) x
    obtain ⟨d, F, hF, hy⟩ := S1 J y
    refine ⟨d, F, hF, ?_⟩
    rw [hy]
    exact MvPolynomial.eval₂_comp_left _ _ _ _
  have hbo : ∀ J L, X.basicOpen (ε L J) = j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L := by
    intro J L
    show X.basicOpen (j.app (wcSgD K N L) (wcSgE K N L J)) = _
    rw [← Scheme.preimage_basicOpen, (S2 L J J).2.1, Scheme.Hom.preimage_inf]
    exact inf_comm _ _
  have hκ : ∀ J L, (ρ₁ J L).comp (κ J) = (ρ₂ J L).comp (κ L) := by
    intro J L
    apply RingHom.ext
    intro c
    have h1 := hres ⊤ (wcSgD K N J) le_top (j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L)
      (inf_le_left.trans le_rfl) (le_top)
      ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c))
    have h2 := hres ⊤ (wcSgD K N L) le_top (j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L)
      (inf_le_right.trans le_rfl) (le_top)
      ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c))
    have e1 : (ρ₁ J L).comp (κ J) c = j.appLE (wcSgD K N J) (j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L)
        (inf_le_left.trans le_rfl) ((wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N J ≤ ⊤)).op
          ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c))) := rfl
    have e2 : (ρ₂ J L).comp (κ L) c = j.appLE (wcSgD K N L) (j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L)
        (inf_le_right.trans le_rfl) ((wcProjK K N).presheaf.map (homOfLE (le_top : wcSgD K N L ≤ ⊤)).op
          ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c))) := rfl
    rw [e1, e2, h1, h2]
  have hcoc : ∀ J L i, ρ₂ J L (ε L i) = ρ₂ J L (ε L J) * ρ₁ J L (ε J i) := by
    intro J L i
    have hle : j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L ≤ j ⁻¹ᵁ (wcSgD K N L ⊓ wcSgD K N J) := by
      rw [Scheme.Hom.preimage_inf]; exact (inf_comm _ _).le
    have h := congrArg (fun z => j.appLE (wcSgD K N L ⊓ wcSgD K N J)
      (j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L) hle z) (S2 L J i).2.2
    simp only [map_mul] at h
    rw [hres _ _ _ _ _ (inf_le_right : j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L ≤ j ⁻¹ᵁ wcSgD K N L),
      hres _ _ _ _ _ (inf_le_right : j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L ≤ j ⁻¹ᵁ wcSgD K N L),
      hres _ _ _ _ _ (inf_le_left : j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L ≤ j ⁻¹ᵁ wcSgD K N J)] at h
    exact h
  have hV : ∀ J L, IsAffineOpen (j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L) := by
    intro J L
    rw [← hbo J L]
    exact (hU L).basicOpen _
  have hunit : ∀ J L, IsUnit (ρ₂ J L (ε L J)) := by
    intro J L
    have key : ∀ (W : X.Opens) (_ : X.basicOpen (ε L J) = W) (h : W ≤ j ⁻¹ᵁ wcSgD K N L),
        IsUnit ((X.presheaf.map (homOfLE h).op).hom (ε L J)) := by
      rintro W rfl h
      exact RingedSpace.isUnit_res_basicOpen _ _
    exact key _ (hbo J L) _
  obtain ⟨m, g, w, ha, hb, hc⟩ := s5 (fun J => Γ(X, j ⁻¹ᵁ wcSgD K N J))
    (fun J L => Γ(X, j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L)) κ ε ρ₁ ρ₂
    (fun J => I.ideal ⟨j ⁻¹ᵁ wcSgD K N J, hU J⟩)
    (fun J L => I.ideal ⟨j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L, hV J L⟩)
    hεJJ hgen
    (fun J L d F hF => s4 _ _ _ (κ J) (κ L) (ε J) (ε L) (ρ₁ J L) (ρ₂ J L) (ρ₂ J L (ε L J))
      (hκ J L) (hcoc J L) d F hF)
    hunit
    (fun J L t ht => I.ideal_le_comap_ideal
      (U := ⟨j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L, hV J L⟩) (V := ⟨j ⁻¹ᵁ wcSgD K N J, hU J⟩)
      (inf_le_left : j ⁻¹ᵁ wcSgD K N J ⊓ j ⁻¹ᵁ wcSgD K N L ≤ j ⁻¹ᵁ wcSgD K N J) ht)
    (fun J L s hs => s3 _ _ (hU L) (hV J L) inf_le_right (ε L J) (hbo J L) s hs)
  exact ⟨m, g, w, fun J _ => ha J, hb, hc⟩

theorem wc_csd_product_chart_closure : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (m : ℕ) (U : X.Opens) (k : Fin (m + 1)), IsAffineOpen U → ∀ y : Γ(Limits.pullback fX (wcProjKStr K m), Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k), y ∈ Subring.closure (Set.range ((Limits.pullback.fst fX (wcProjKStr K m)).appLE U (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) inf_le_left).hom ∪ Set.range (fun l => (Limits.pullback.snd fX (wcProjKStr K m)).appLE (wcSgD K m k) (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U ⊓ Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) inf_le_right (wcSgE K m k l))) :=
by
  intro K _ X fX m U k hU y

  have S1 : ∀ (K : Type u) [Field K] (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)),
      x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
        (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
    intro K _ n
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    intro J x
    have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
