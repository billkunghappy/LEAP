            (algebraMap (HomogeneousLocalization.Away 𝒜 t) (Localization.Away t))) (HomogeneousLocalization.Away.mk 𝒜 ht n y hy) * (algebraMap Γ(X, ⊤) (Localization.Away (f t)) (f t)) ^ n = algebraMap Γ(X, ⊤) (Localization.Away (f t)) (f y) := by
      rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk', IsLocalization.map_mk', ← map_pow, ← map_pow f]
      exact IsLocalization.mk'_spec _ _ _
    have hΦ : ∀ a b c : Localization.Away (f t), a * b ^ n = c →
        ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv a) * (((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv b)) ^ n = ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv c) := by
      intro a b c h
      rw [← map_pow, ← map_pow, ← map_mul, ← map_mul, h]
    have h2 := hΦ _ _ _ hD
    rw [s3a, s3a] at h2
    have h1' : (X.basicOpen (f t)).topIso.inv ((Proj.fromOfGlobalSections 𝒜 f hf).appLE (Proj.basicOpen 𝒜 t) (X.basicOpen (f t)) hPV.ge ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy))) = ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv (((IsLocalization.map (Localization.Away (f t)) f hle).comp
            (algebraMap (HomogeneousLocalization.Away 𝒜 t) (Localization.Away t))) (HomogeneousLocalization.Away.mk 𝒜 ht n y hy))) := h1
    rw [← h1'] at h2
    have hι : ∀ a, (X.basicOpen (f t)).ι.appTop a = (X.basicOpen (f t)).topIso.inv (X.presheaf.map (homOfLE (le_top : X.basicOpen (f t) ≤ ⊤)).op a) := by
      intro a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    rw [hι, hι, ← map_pow, ← map_mul] at h2
    have hinj : ∀ a b : Γ(X, X.basicOpen (f t)), (X.basicOpen (f t)).topIso.inv a = (X.basicOpen (f t)).topIso.inv b → a = b := by
      intro a b h
      have h' := congrArg (fun w => (X.basicOpen (f t)).topIso.hom w) h
      simp only [Iso.inv_hom_id_apply] at h'
      exact h'
    have hSS := hinj _ _ h2
    have hG1 : (Proj.fromOfGlobalSections 𝒜 f hf).app (Proj.basicOpen 𝒜 t) ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) = X.presheaf.map (homOfLE hPV.le).op ((Proj.fromOfGlobalSections 𝒜 f hf).appLE (Proj.basicOpen 𝒜 t) (X.basicOpen (f t)) hPV.ge ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy))) := by
      have hh := Scheme.Hom.appLE_map (Proj.fromOfGlobalSections 𝒜 f hf) hPV.ge (homOfLE hPV.le).op
      rw [Scheme.Hom.app_eq_appLE, ← hh]
      rfl
    have hG2 : ∀ a, X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op a = X.presheaf.map (homOfLE hPV.le).op (X.presheaf.map (homOfLE (le_top : X.basicOpen (f t) ≤ ⊤)).op a) := by
      intro a
      rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    rw [hG1, hG2, hG2, ← map_pow, ← map_mul, hSS]
  have S3 : ∀ (K : Type u) [Field K] (n : ℕ) (V : Scheme.{u}) (fV : V ⟶ Spec (.of K)) (t : Fin (n + 1) → Γ(V, ⊤)),
      Ideal.span (Set.range t) = ⊤ →
      ∃ φ : V ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fV ∧ (∀ J, φ ⁻¹ᵁ wcSgD K n J = V.basicOpen (t J)) ∧
        ∀ J L (O : V.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J), φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) *
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t L) := by
    intro K _ N V fV s hspan
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hX : ∀ J : Fin (N + 1), (MvPolynomial.X J : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun J =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)
    let F : MvPolynomial (Fin (N + 1)) K →+* Γ(V, ⊤) :=
      MvPolynomial.eval₂Hom (fV.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) s
    have hFX : ∀ J, F (MvPolynomial.X J) = s J := fun J => MvPolynomial.eval₂Hom_X' _ _ J
    have hF : (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal.map F = ⊤ := by
      rw [eq_top_iff, ← hspan, Ideal.span_le]
      rintro _ ⟨J, rfl⟩
      rw [← hFX J]
      apply Ideal.mem_map_of_mem
      exact (HomogeneousIdeal.mem_irrelevant_iff _ _).mpr (by
        rw [GradedRing.proj_apply]
        exact DirectSum.decompose_of_mem_ne _ (hX J) one_ne_zero)
    refine ⟨Proj.fromOfGlobalSections _ F hF, ?_, fun J => ?_, fun J L O hO => ?_⟩
    · have h1 := Proj.fromOfGlobalSections_toSpecZero
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) F hF
      have hc : CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
          CommRingCat.ofHom (F.comp (algebraMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)
            (MvPolynomial (Fin (N + 1)) K))) = (Scheme.ΓSpecIso (.of K)).inv ≫ fV.appTop := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro k
        show F (MvPolynomial.C k) = fV.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom k)
        exact MvPolynomial.eval₂Hom_C _ _ k
      have h2 : (Spec (.of K)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv = 𝟙 _ := by
        rw [← Scheme.isoSpec_hom, Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
      calc Proj.fromOfGlobalSections _ F hF ≫ (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0))))
          = (Proj.fromOfGlobalSections _ F hF ≫
              Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)) ≫
              Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) :=
            (Category.assoc _ _ _).symm
        _ = V.toSpecΓ ≫ (Spec.map (CommRingCat.ofHom (F.comp (algebraMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)
              (MvPolynomial (Fin (N + 1)) K)))) ≫
              Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))) := by
            rw [h1, Category.assoc]
        _ = V.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of K)).inv ≫ fV.appTop) := by
            rw [← Spec.map_comp, hc]
        _ = (V.toSpecΓ ≫ Spec.map fV.appTop) ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv := by
            rw [Spec.map_comp, Category.assoc]
        _ = fV ≫ ((Spec (.of K)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv) := by
            rw [← Scheme.toSpecΓ_naturality, Category.assoc]
        _ = fV := by rw [h2, Category.comp_id]
    · rw [← hFX J]
      exact Proj.fromOfGlobalSections_preimage_basicOpen _ F hF Nat.one_pos (hX J)
    · have hy : (MvPolynomial.X L : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := by
        rw [one_smul]
        exact hX L
      have h := s3 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) V F hF Nat.one_pos (hX J) 1
        (MvPolynomial.X L) hy
      rw [hFX, hFX, pow_one] at h
      have e := congrArg (V.presheaf.map (homOfLE hO).op) h
      rw [map_mul, hres, hres] at e
      exact e
  have chart : ∀ (K : Type u) [Field K] (N : ℕ), ∃ (C : (wcProjK K N).Opens) (e : Fin (N + 1) → Γ(wcProjK K N, C)), IsAffineOpen C ∧ e 0 = 1 ∧ (∀ t : Γ(wcProjK K N, C), t ∈ Subring.closure (Set.range (((wcProjK K N).presheaf.map (homOfLE (le_top : C ≤ ⊤)).op).hom.comp ((wcProjKStr K N).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)) ∪ Set.range e)) ∧ ∀ (V : Scheme.{u}) (fV : V ⟶ Spec (.of K)) (s : Fin (N + 1) → Γ(V, ⊤)), s 0 = 1 → ∃ (φ : V ⟶ wcProjK K N) (hφ : ⊤ ≤ φ ⁻¹ᵁ C), φ ≫ wcProjKStr K N = fV ∧ ∀ L, φ.appLE C ⊤ hφ (e L) = s L := by
    intro K _ N
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (N + 1), (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    refine ⟨wcSgD K N 0, wcSgE K N 0, ?_, ?_, ?_, ?_⟩
    · exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X 0) (hX 0) Nat.one_pos
    · have h1 : HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX 0) 1
          (MvPolynomial.X 0) (hX 0) = 1 := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
          ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        exact ⟨1, by simp⟩
      show Proj.awayToSection _ _ _ = 1
      rw [h1, map_one]
    · intro t
      refine Subring.closure_mono ?_ (S1 K N 0 t)
      rintro _ (⟨L, rfl⟩ | ⟨c, rfl⟩)
      · exact Or.inr ⟨L, rfl⟩
      · exact Or.inl ⟨c, rfl⟩
    · intro V fV s hs0
      have hspan : Ideal.span (Set.range s) = ⊤ :=
        Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨0, rfl⟩) (by rw [hs0]; exact isUnit_one)
      obtain ⟨φ, hstr, hpre, hrel⟩ := S3 K N V fV s hspan
      have hφ : ⊤ ≤ φ ⁻¹ᵁ wcSgD K N 0 := by
        rw [hpre 0, hs0, Scheme.basicOpen_of_isUnit _ isUnit_one]
      refine ⟨φ, hφ, hstr, fun L => ?_⟩
      have h := hrel 0 L ⊤ hφ
      have hid : ∀ x : Γ(V, ⊤), V.presheaf.map (homOfLE (le_top : (⊤ : V.Opens) ≤ ⊤)).op x = x := by
        intro x
        rw [show (homOfLE (le_top : (⊤ : V.Opens) ≤ ⊤)).op = 𝟙 _ from rfl,
          CategoryTheory.Functor.map_id]
        rfl
      rw [hid, hid, hs0, mul_one] at h
      exact h

  have happTop : ∀ {X' Y' : Scheme.{u}} (g : X' ⟶ Y') (h : (⊤ : X'.Opens) ≤ g ⁻¹ᵁ ⊤),
      g.appLE ⊤ ⊤ h = g.appTop := by
    intro X' Y' g h
    have H : ∀ (V : X'.Opens) (hV : g ⁻¹ᵁ ⊤ = V) (e : V ≤ g ⁻¹ᵁ ⊤),
        HEq (g.appLE ⊤ V e) (g.app ⊤) := by
      intro V hV e
      subst hV
      exact heq_of_eq (Scheme.Hom.app_eq_appLE g (U := ⊤)).symm
    exact eq_of_heq (H ⊤ (Scheme.Hom.preimage_top g) h)

  have s4 : ∀ (V X : Scheme.{u}) [IsAffine V] (φ : V ⟶ X) (C : X.Opens), IsAffineOpen C →
      ∀ (hφ : ⊤ ≤ φ ⁻¹ᵁ C), Function.Surjective (φ.appLE C ⊤ hφ).hom → IsImmersion φ := by
    intro V X _ φ C hC hφ hs
    have hrange : Set.range φ ⊆ Set.range C.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨v, rfl⟩
      exact hφ (show v ∈ (⊤ : V.Opens) from trivial)
    obtain ⟨φ', hfac⟩ : ∃ φ' : V ⟶ C.toScheme, φ' ≫ C.ι = φ :=
      ⟨_, IsOpenImmersion.lift_fac C.ι φ hrange⟩
    subst hfac
    rw [Scheme.Hom.comp_appLE, CommRingCat.hom_comp, RingHom.coe_comp] at hs
    have hs2 := hs.of_comp
    have hs3 := (Scheme.Hom.appLE_congr φ' _ (Scheme.Opens.ι_preimage_self C)
      (Scheme.Hom.preimage_top φ').symm (fun g => Function.Surjective g.hom)).mp hs2
    have hs4 : Function.Surjective φ'.appTop.hom := by
      rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
      exact hs3
    have : IsAffine C.toScheme := hC
    have := IsClosedImmersion.of_surjective_of_isAffine φ' hs4
    exact IsImmersion.comp φ' C.ι

  intro K _ Y f _ A₀ hA₀
  obtain ⟨n, a, ha0, hgen⟩ := gens K Y f A₀ hA₀
  obtain ⟨C, e, hC, -, -, huniv⟩ := chart K n
  have : IsAffine A₀.toScheme := hA₀
  obtain ⟨φ, hφ, hstr, hval⟩ := huniv A₀.toScheme (A₀.ι ≫ f) (fun L => A₀.topIso.inv (a L))
    (by show A₀.topIso.inv (a 0) = 1; rw [ha0, map_one])
  have hkey : ∀ x, (φ.appLE C ⊤ hφ).hom ((wcProjK K n).presheaf.map (homOfLE (le_top : C ≤ ⊤)).op x) =
      φ.appTop x := by
    intro x
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE, happTop]
  have hι : ∀ y, A₀.ι.appTop y = A₀.topIso.inv (Y.presheaf.map (homOfLE (le_top : A₀ ≤ ⊤)).op y) := by
    intro y
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
    erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hK : ∀ c : K, (φ.appLE C ⊤ hφ).hom (((wcProjK K n).presheaf.map (homOfLE (le_top : C ≤ ⊤)).op).hom
      ((wcProjKStr K n).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) =
      A₀.topIso.inv ((Y.presheaf.map (homOfLE (le_top : A₀ ≤ ⊤)).op).hom
        (f.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) := by
    intro c
    rw [← hι]
    have h := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) hstr
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [← h, ← hkey]
    rfl
  have hsurj : Function.Surjective (φ.appLE C ⊤ hφ).hom := by
    intro y
    have hle : Subring.closure ((A₀.topIso.inv.hom) '' (Set.range ((Y.presheaf.map (homOfLE (le_top : A₀ ≤ ⊤)).op).hom.comp (f.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)) ∪ Set.range a)) ≤ (φ.appLE C ⊤ hφ).hom.range := by
      rw [Subring.closure_le]
      rintro _ ⟨z, hz | ⟨L, rfl⟩, rfl⟩
      · obtain ⟨c, rfl⟩ := hz
        exact ⟨_, hK c⟩
      · exact ⟨e L, hval L⟩
    have hy : A₀.topIso.inv (A₀.topIso.hom y) = y := Iso.hom_inv_id_apply _ _
    rw [← RingHom.map_closure] at hle
    exact hle ⟨_, hgen (A₀.topIso.hom y), hy⟩
  have : IsImmersion φ := s4 _ _ φ C hC hφ hsurj
  have : QuasiCompact φ := inferInstance
  refine ⟨n, φ.image, φ.imageι, φ.toImage, inferInstance, inferInstance, ?_, φ.toImage.denseRange⟩
  rw [← Category.assoc, Scheme.Hom.toImage_imageι, hstr]

theorem wc_csd_extension_gives_target : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (A₀ : Y.Opens) (N : ℕ) (P : Scheme.{u}) (j : P ⟶ wcProjK K N) (ι : A₀.toScheme ⟶ P) (φ : P ⟶ Y), IsClosedImmersion j → IsOpenImmersion ι → Dense (Set.range ι) → ι ≫ φ = A₀.ι → j ≫ wcProjKStr K N = φ ≫ f → IsProper φ ∧ IsIso (φ ∣_ A₀) :=
by
  intro K _ Y f _ A₀ N P j ι φ hj hι hd hιφ hcomm
  haveI := hj
  haveI := hι
  haveI : IsProper (wcProjKStr K N) := by
    letI := @MvPolynomial.gradedAlgebra (Fin (N+1)) K _
    letI : IsScalarTower K ((MvPolynomial.homogeneousSubmodule (Fin (N+1)) K) 0)
        (MvPolynomial (Fin (N+1)) K) :=
      IsScalarTower.of_algebraMap_eq (R := K)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (N+1)) K) 0)
        (A := MvPolynomial (Fin (N+1)) K) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (N+1)) K) 0)
        (MvPolynomial (Fin (N+1)) K) :=
      Algebra.FiniteType.of_restrictScalars_finiteType K _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N+1)) K)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (N+1)) K) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (N+1)) K) 0 =>
          (x : MvPolynomial (Fin (N+1)) K)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (N+1)) K).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (N+1)) K).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (N+1)) K).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (N+1)) K) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N+1)) K) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap K ((MvPolynomial.homogeneousSubmodule (Fin (N+1)) K) 0))))
    infer_instance
  have hprop : IsProper φ := by
    haveI : IsProper (φ ≫ f) := by rw [← hcomm]; infer_instance
    exact IsProper.of_comp φ f
  refine ⟨hprop, ?_⟩
  haveI := hprop
  have hrange : Set.range ι ⊆ Set.range (φ ⁻¹ᵁ A₀).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨a, rfl⟩
    have h1 : φ (ι a) = A₀.ι a := by rw [← Scheme.Hom.comp_apply, hιφ]
    have h2 : A₀.ι a ∈ Set.range A₀.ι := ⟨a, rfl⟩
    rw [Scheme.Opens.range_ι] at h2
    show φ (ι a) ∈ A₀
    rw [h1]
    exact h2
  let δ' : A₀.toScheme ⟶ (φ ⁻¹ᵁ A₀).toScheme := IsOpenImmersion.lift (φ ⁻¹ᵁ A₀).ι ι hrange
  have hδ' : δ' ≫ (φ ⁻¹ᵁ A₀).ι = ι := IsOpenImmersion.lift_fac _ _ _
  have hsec : δ' ≫ (φ ∣_ A₀) = 𝟙 _ := by
    rw [← cancel_mono A₀.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hδ', hιφ,
      Category.id_comp]
  haveI : IsSeparated ((φ ∣_ A₀) ≫ A₀.ι) := by rw [morphismRestrict_ι]; infer_instance
  haveI : IsSeparated (φ ∣_ A₀) := IsSeparated.of_comp (φ ∣_ A₀) A₀.ι
  haveI : IsClosedImmersion (δ' ≫ (φ ∣_ A₀)) := by rw [hsec]; infer_instance
  haveI : IsClosedImmersion δ' := IsClosedImmersion.of_comp δ' (φ ∣_ A₀)
  haveI : IsOpenImmersion (δ' ≫ (φ ⁻¹ᵁ A₀).ι) := by rw [hδ']; infer_instance
  haveI : IsOpenImmersion δ' := IsOpenImmersion.of_comp δ' (φ ⁻¹ᵁ A₀).ι
  have hcl : IsClosed (Set.range δ') := δ'.isClosedEmbedding.isClosed_range
  have hpre : Set.range δ' = (φ ⁻¹ᵁ A₀).ι ⁻¹' Set.range ι := by
    ext w
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨a, by rw [← hδ', Scheme.Hom.comp_apply]⟩
    · rintro ⟨a, ha⟩
      refine ⟨a, (φ ⁻¹ᵁ A₀).ι.isOpenEmbedding.injective ?_⟩
      rw [← Scheme.Hom.comp_apply, hδ', ha]
  have hden : Dense (Set.range δ') := by
    rw [hpre]
    exact hd.preimage (φ ⁻¹ᵁ A₀).ι.isOpenEmbedding.isOpenMap
  have huniv : Set.range δ' = Set.univ := by
    rw [← hcl.closure_eq, hden.closure_eq]
  haveI : Surjective δ' := ⟨Set.range_eq_univ.mp huniv⟩
  haveI : IsIso δ' :=
    (isIso_iff_isOpenImmersion_and_surjective δ').mpr ⟨inferInstance, inferInstance⟩
  haveI : IsIso (δ' ≫ (φ ∣_ A₀)) := by rw [hsec]; infer_instance
  exact IsIso.of_isIso_comp_left δ' (φ ∣_ A₀)

theorem wc_segre_glue : ∀ (K : Type u) [Field K] (N m : ℕ),
    (∀ n : ℕ, (⨆ a : Fin (n + 1), wcSgD K n a) = ⊤) →
    (∀ (n : ℕ) (J L j : Fin (n + 1)), wcSgE K n J J = 1 ∧
      (wcProjK K n).basicOpen (wcSgE K n J L) = wcSgD K n J ⊓ wcSgD K n L ∧
      (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n J)).op (wcSgE K n J j) =
        (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n J)).op (wcSgE K n J L) *
        (wcProjK K n).presheaf.map (homOfLE (inf_le_right : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n L)).op (wcSgE K n L j)) →
    (∀ (n : ℕ) (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) {I : Type} (U : I → X.Opens), (⨆ i, U i) = ⊤ →
      ∀ (s : ∀ i, Fin (n + 1) → Γ(X, U i)), (∀ i, Ideal.span (Set.range (s i)) = ⊤) →
      ∀ (w : ∀ i j, Γ(X, U i ⊓ U j)), (∀ i j, IsUnit (w i j)) →
      (∀ i j J, X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) =
        w i j * X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J)) →
      ∃ φ : X ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fX ∧
        (∀ i J, φ ⁻¹ᵁ wcSgD K n J ⊓ U i = X.basicOpen (s i J)) ∧
        ∀ i J L (O : X.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J) (hOi : O ≤ U i),
          φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) * X.presheaf.map (homOfLE hOi).op (s i J) =
            X.presheaf.map (homOfLE hOi).op (s i L)) →
    ∃ (N' : ℕ) (e : Fin (N + 1) × Fin (m + 1) ≃ Fin (N' + 1))
      (σ : Limits.pullback (wcProjKStr K N) (wcProjKStr K m) ⟶ wcProjK K N')
      (h : ∀ b c, wcSgV K N m b c ≤ σ ⁻¹ᵁ wcSgD K N' (e (b, c))),
      σ ≫ wcProjKStr K N' = Limits.pullback.fst (wcProjKStr K N) (wcProjKStr K m) ≫ wcProjKStr K N ∧
      (∀ b c, σ ⁻¹ᵁ wcSgD K N' (e (b, c)) ≤ wcSgV K N m b c) ∧
      ∀ b b2 c c2, σ.appLE (wcSgD K N' (e (b, c))) (wcSgV K N m b c) (h b c)
          (wcSgE K N' (e (b, c)) (e (b2, c2))) =
        (Limits.pullback.fst (wcProjKStr K N) (wcProjKStr K m)).appLE (wcSgD K N b) (wcSgV K N m b c)
            inf_le_left (wcSgE K N b b2) *
          (Limits.pullback.snd (wcProjKStr K N) (wcProjKStr K m)).appLE (wcSgD K m c) (wcSgV K N m b c)
            inf_le_right (wcSgE K m c c2) :=
by
  intro K _ N m HC HS HUP
  have key : ∀ (Pz : Scheme.{u}) (f : Pz ⟶ wcProjK K N) (g : Pz ⟶ wcProjK K m)
      (fX : Pz ⟶ Spec (.of K)) (N' : ℕ) (e : Fin (N + 1) × Fin (m + 1) ≃ Fin (N' + 1)),
      ∃ (σ : Pz ⟶ wcProjK K N')
        (h : ∀ b c, f ⁻¹ᵁ wcSgD K N b ⊓ g ⁻¹ᵁ wcSgD K m c ≤ σ ⁻¹ᵁ wcSgD K N' (e (b, c))),
        σ ≫ wcProjKStr K N' = fX ∧
        (∀ b c, σ ⁻¹ᵁ wcSgD K N' (e (b, c)) ≤ f ⁻¹ᵁ wcSgD K N b ⊓ g ⁻¹ᵁ wcSgD K m c) ∧
        ∀ b b2 c c2, σ.appLE (wcSgD K N' (e (b, c))) (f ⁻¹ᵁ wcSgD K N b ⊓ g ⁻¹ᵁ wcSgD K m c)
            (h b c) (wcSgE K N' (e (b, c)) (e (b2, c2))) =
          f.appLE (wcSgD K N b) (f ⁻¹ᵁ wcSgD K N b ⊓ g ⁻¹ᵁ wcSgD K m c) inf_le_left
              (wcSgE K N b b2) *
            g.appLE (wcSgD K m c) (f ⁻¹ᵁ wcSgD K N b ⊓ g ⁻¹ᵁ wcSgD K m c) inf_le_right
              (wcSgE K m c c2) := by
    intro Pz f g fX N' e

    have cocyc : ∀ (n : ℕ) (q : Pz ⟶ wcProjK K n) (J L : Fin (n + 1)) (W : Pz.Opens)
        (hJ : W ≤ q ⁻¹ᵁ wcSgD K n J) (hL : W ≤ q ⁻¹ᵁ wcSgD K n L),
        (∀ j, q.appLE (wcSgD K n J) W hJ (wcSgE K n J j) =
          q.appLE (wcSgD K n J) W hJ (wcSgE K n J L) * q.appLE (wcSgD K n L) W hL (wcSgE K n L j)) ∧
        q.appLE (wcSgD K n J) W hJ (wcSgE K n J L) * q.appLE (wcSgD K n L) W hL (wcSgE K n L J) = 1 := by
      intro n q J L W hJ hL
      have hM : W ≤ q ⁻¹ᵁ (wcSgD K n J ⊓ wcSgD K n L) := by
        rw [Scheme.Hom.preimage_inf]
        exact le_inf hJ hL
      have K1 : ∀ x, q.appLE (wcSgD K n J) W hJ x = q.appLE _ W hM
          ((wcProjK K n).presheaf.map
            (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n J)).op x) := by
        intro x
        rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
      have K2 : ∀ x, q.appLE (wcSgD K n L) W hL x = q.appLE _ W hM
          ((wcProjK K n).presheaf.map
            (homOfLE (inf_le_right : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n L)).op x) := by
        intro x
        rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
      have hc : ∀ j, q.appLE (wcSgD K n J) W hJ (wcSgE K n J j) =
          q.appLE (wcSgD K n J) W hJ (wcSgE K n J L) *
            q.appLE (wcSgD K n L) W hL (wcSgE K n L j) := by
        intro j
        rw [K1 (wcSgE K n J j), K1 (wcSgE K n J L), K2 (wcSgE K n L j), (HS n J L j).2.2, map_mul]
      refine ⟨hc, ?_⟩
      rw [← hc J, (HS n J L J).1, map_one]

    have hres : ∀ (Y : Scheme.{u}) (q : Pz ⟶ Y) (D : Y.Opens) (A B : Pz.Opens) (hAB : A ≤ B)
        (hB : B ≤ q ⁻¹ᵁ D) (x : Γ(Y, D)),
        Pz.presheaf.map (homOfLE hAB).op (q.appLE D B hB x) = q.appLE D A (hAB.trans hB) x := by
      intro Y q D A B hAB hB x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_map]
    have hid : ∀ (A : Pz.Opens) (y : Γ(Pz, A)), Pz.presheaf.map (homOfLE (le_refl A)).op y = y := by
      intro A y
      change (Pz.presheaf.map (𝟙 (Opposite.op A))) y = y
      rw [CategoryTheory.Functor.map_id]
      rfl

    let U : Fin (N + 1) × Fin (m + 1) → Pz.Opens := fun i =>
      f ⁻¹ᵁ wcSgD K N i.1 ⊓ g ⁻¹ᵁ wcSgD K m i.2
    have hU1 : ∀ i, U i ≤ f ⁻¹ᵁ wcSgD K N i.1 := fun i => inf_le_left
    have hU2 : ∀ i, U i ≤ g ⁻¹ᵁ wcSgD K m i.2 := fun i => inf_le_right
    have hU : (⨆ i, U i) = ⊤ := by
      show (⨆ i : Fin (N + 1) × Fin (m + 1), f ⁻¹ᵁ wcSgD K N i.1 ⊓ g ⁻¹ᵁ wcSgD K m i.2) = ⊤
      refine (iSup_inf_iSup (f := fun b => f ⁻¹ᵁ wcSgD K N b)
        (g := fun c => g ⁻¹ᵁ wcSgD K m c)).symm.trans ?_
      have e1 : f ⁻¹ᵁ (⨆ b, wcSgD K N b) = ⨆ b, f ⁻¹ᵁ wcSgD K N b := by
        rw [Scheme.Hom.preimage_iSup]
      have e2 : g ⁻¹ᵁ (⨆ c, wcSgD K m c) = ⨆ c, g ⁻¹ᵁ wcSgD K m c := by
        rw [Scheme.Hom.preimage_iSup]
      show (⨆ b, f ⁻¹ᵁ wcSgD K N b) ⊓ (⨆ c, g ⁻¹ᵁ wcSgD K m c) = ⊤
      rw [← e1, ← e2, HC N, HC m, Scheme.Hom.preimage_top, Scheme.Hom.preimage_top, inf_top_eq]

    let α : ∀ i, Fin (N + 1) → Γ(Pz, U i) := fun i b2 =>
      f.appLE (wcSgD K N i.1) (U i) (hU1 i) (wcSgE K N i.1 b2)
    let β : ∀ i, Fin (m + 1) → Γ(Pz, U i) := fun i c2 =>
      g.appLE (wcSgD K m i.2) (U i) (hU2 i) (wcSgE K m i.2 c2)
    let s : ∀ i, Fin (N' + 1) → Γ(Pz, U i) := fun i J => α i (e.symm J).1 * β i (e.symm J).2
    have hsAt : ∀ i b c, s i (e (b, c)) = α i b * β i c := by
      intro i b c
      show α i (e.symm (e (b, c))).1 * β i (e.symm (e (b, c))).2 = _
      rw [Equiv.symm_apply_apply]
    have hα1 : ∀ i, α i i.1 = 1 := by
      intro i
      show f.appLE (wcSgD K N i.1) (U i) (hU1 i) (wcSgE K N i.1 i.1) = 1
      rw [(HS N i.1 i.1 i.1).1, map_one]
    have hβ1 : ∀ i, β i i.2 = 1 := by
      intro i
      show g.appLE (wcSgD K m i.2) (U i) (hU2 i) (wcSgE K m i.2 i.2) = 1
      rw [(HS m i.2 i.2 i.2).1, map_one]
    have hs1 : ∀ i, s i (e i) = 1 := by
      intro i
      have h0 := hsAt i i.1 i.2
      rw [hα1, hβ1, mul_one] at h0
      exact h0
    have hspan : ∀ i, Ideal.span (Set.range (s i)) = ⊤ := fun i =>
      Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨e i, rfl⟩) (by rw [hs1 i]; exact isUnit_one)

    have hW1 : ∀ i j, U i ⊓ U j ≤ f ⁻¹ᵁ wcSgD K N i.1 := fun i j => inf_le_left.trans (hU1 i)
    have hW1' : ∀ i j, U i ⊓ U j ≤ f ⁻¹ᵁ wcSgD K N j.1 := fun i j => inf_le_right.trans (hU1 j)
    have hW2 : ∀ i j, U i ⊓ U j ≤ g ⁻¹ᵁ wcSgD K m i.2 := fun i j => inf_le_left.trans (hU2 i)
    have hW2' : ∀ i j, U i ⊓ U j ≤ g ⁻¹ᵁ wcSgD K m j.2 := fun i j => inf_le_right.trans (hU2 j)
    let w : ∀ i j, Γ(Pz, U i ⊓ U j) := fun i j =>
      f.appLE (wcSgD K N j.1) (U i ⊓ U j) (hW1' i j) (wcSgE K N j.1 i.1) *
        g.appLE (wcSgD K m j.2) (U i ⊓ U j) (hW2' i j) (wcSgE K m j.2 i.2)
    have hw : ∀ i j, IsUnit (w i j) := by
      intro i j
      have h1 := (cocyc N f j.1 i.1 (U i ⊓ U j) (hW1' i j) (hW1 i j)).2
      have h2 := (cocyc m g j.2 i.2 (U i ⊓ U j) (hW2' i j) (hW2 i j)).2
      exact (isUnit_iff_exists_inv.mpr ⟨_, h1⟩).mul (isUnit_iff_exists_inv.mpr ⟨_, h2⟩)
    have htrans : ∀ i j J, Pz.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) =
        w i j * Pz.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J) := by
      intro i j J
      show Pz.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op
          (f.appLE (wcSgD K N j.1) (U j) (hU1 j) (wcSgE K N j.1 (e.symm J).1) *
            g.appLE (wcSgD K m j.2) (U j) (hU2 j) (wcSgE K m j.2 (e.symm J).2)) =
        (f.appLE (wcSgD K N j.1) (U i ⊓ U j) (hW1' i j) (wcSgE K N j.1 i.1) *
          g.appLE (wcSgD K m j.2) (U i ⊓ U j) (hW2' i j) (wcSgE K m j.2 i.2)) *
        Pz.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op
          (f.appLE (wcSgD K N i.1) (U i) (hU1 i) (wcSgE K N i.1 (e.symm J).1) *
            g.appLE (wcSgD K m i.2) (U i) (hU2 i) (wcSgE K m i.2 (e.symm J).2))
      rw [map_mul, map_mul, hres, hres, hres, hres,
        (cocyc N f j.1 i.1 _ (hW1' i j) (hW1 i j)).1 (e.symm J).1,
        (cocyc m g j.2 i.2 _ (hW2' i j) (hW2 i j)).1 (e.symm J).2]
      ring

    obtain ⟨σ, U1, U2, U3⟩ := HUP N' Pz fX U hU s hspan w hw htrans
    have h : ∀ b c, f ⁻¹ᵁ wcSgD K N b ⊓ g ⁻¹ᵁ wcSgD K m c ≤ σ ⁻¹ᵁ wcSgD K N' (e (b, c)) := by
      intro b c
      have h1 := U2 (b, c) (e (b, c))
      rw [hs1, Scheme.basicOpen_one] at h1
      exact h1.symm.le.trans inf_le_left
    have hpre : ∀ b c, σ ⁻¹ᵁ wcSgD K N' (e (b, c)) ≤ f ⁻¹ᵁ wcSgD K N b ⊓ g ⁻¹ᵁ wcSgD K m c := by
      intro b c
      calc σ ⁻¹ᵁ wcSgD K N' (e (b, c)) = σ ⁻¹ᵁ wcSgD K N' (e (b, c)) ⊓ ⨆ i, U i := by
            rw [hU, inf_top_eq]
        _ = ⨆ i, σ ⁻¹ᵁ wcSgD K N' (e (b, c)) ⊓ U i := inf_iSup_eq _ _
        _ = ⨆ i, Pz.basicOpen (s i (e (b, c))) := iSup_congr (fun i => U2 i (e (b, c)))
        _ ≤ _ := by
          refine iSup_le (fun i => ?_)
          rw [hsAt, Scheme.basicOpen_mul]
          refine le_inf (inf_le_left.trans ?_) (inf_le_right.trans ?_)
          · show Pz.basicOpen (f.appLE (wcSgD K N i.1) (U i) (hU1 i) (wcSgE K N i.1 b)) ≤ _
            rw [Scheme.basicOpen_appLE, (HS N i.1 b b).2.1]
            exact inf_le_right.trans (Scheme.Hom.preimage_mono _ inf_le_right)
          · show Pz.basicOpen (g.appLE (wcSgD K m i.2) (U i) (hU2 i) (wcSgE K m i.2 c)) ≤ _
            rw [Scheme.basicOpen_appLE, (HS m i.2 c c).2.1]
            exact inf_le_right.trans (Scheme.Hom.preimage_mono _ inf_le_right)
    refine ⟨σ, h, U1, hpre, ?_⟩
    intro b b2 c c2
    have h3 := U3 (b, c) (e (b, c)) (e (b2, c2)) (U (b, c)) (h b c) le_rfl
    rw [hs1, map_one, mul_one, hid, hsAt] at h3
    exact h3
  obtain ⟨σ, h, h1, h2, h3⟩ := key _ (Limits.pullback.fst (wcProjKStr K N) (wcProjKStr K m))
    (Limits.pullback.snd (wcProjKStr K N) (wcProjKStr K m))
    (Limits.pullback.fst (wcProjKStr K N) (wcProjKStr K m) ≫ wcProjKStr K N) (N * m + N + m)
    (finProdFinEquiv.trans (finCongr (by ring)))
  exact ⟨_, _, σ, h, h1, h2, h3⟩

theorem wc_segre_closed_of_coords : ∀ (K : Type u) [Field K] (N m N' : ℕ),
    (∀ n : ℕ, (⨆ a : Fin (n + 1), wcSgD K n a) = ⊤) →
    (∀ (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)), x ∈ Subring.closure
      (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
        (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c))))) →
    (∀ (n : ℕ) (J L j : Fin (n + 1)), wcSgE K n J J = 1 ∧
      (wcProjK K n).basicOpen (wcSgE K n J L) = wcSgD K n J ⊓ wcSgD K n L ∧
      (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n J)).op (wcSgE K n J j) =
        (wcProjK K n).presheaf.map (homOfLE (inf_le_left : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n J)).op (wcSgE K n J L) *
        (wcProjK K n).presheaf.map (homOfLE (inf_le_right : wcSgD K n J ⊓ wcSgD K n L ≤ wcSgD K n L)).op (wcSgE K n L j)) →
    (∀ (S X Y Y' : Scheme.{u}) [IsAffine S] (f : X ⟶ S) (g : Y ⟶ S) (ι : Y' ⟶ Limits.pullback f g) [IsClosedImmersion ι] (U : X.Opens) (C : Y.Opens), IsAffineOpen U → IsAffineOpen C → IsAffineOpen ((ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C) ∧ ∀ t : Γ(Y', (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C), t ∈ Subring.closure (Set.range ((Y'.presheaf.map (homOfLE (inf_le_left : (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C ≤ (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U)).op).hom.comp ((ι ≫ Limits.pullback.fst f g).app U).hom) ∪ Set.range ((Y'.presheaf.map (homOfLE (inf_le_right : (ι ≫ Limits.pullback.fst f g) ⁻¹ᵁ U ⊓ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C ≤ (ι ≫ Limits.pullback.snd f g) ⁻¹ᵁ C)).op).hom.comp ((ι ≫ Limits.pullback.snd f g).app C).hom))) →
    ∀ (e : Fin (N + 1) × Fin (m + 1) ≃ Fin (N' + 1))
      (σ : Limits.pullback (wcProjKStr K N) (wcProjKStr K m) ⟶ wcProjK K N')
      (h : ∀ b c, wcSgV K N m b c ≤ σ ⁻¹ᵁ wcSgD K N' (e (b, c))),
      σ ≫ wcProjKStr K N' = Limits.pullback.fst (wcProjKStr K N) (wcProjKStr K m) ≫ wcProjKStr K N →
      (∀ b c, σ ⁻¹ᵁ wcSgD K N' (e (b, c)) ≤ wcSgV K N m b c) →
      (∀ b b2 c c2, σ.appLE (wcSgD K N' (e (b, c))) (wcSgV K N m b c) (h b c)
          (wcSgE K N' (e (b, c)) (e (b2, c2))) =
        (Limits.pullback.fst (wcProjKStr K N) (wcProjKStr K m)).appLE (wcSgD K N b) (wcSgV K N m b c)
            inf_le_left (wcSgE K N b b2) *
          (Limits.pullback.snd (wcProjKStr K N) (wcProjKStr K m)).appLE (wcSgD K m c) (wcSgV K N m b c)
            inf_le_right (wcSgE K m c c2)) →
      IsClosedImmersion σ :=
by
  intro K _ N m N' hcov hgen hS2 hprod e σ h hover hpre hcoords

  have S1 : ∀ (X Y : Scheme.{u}) (φ : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (hV : V ≤ φ ⁻¹ᵁ U),
      IsAffineOpen U → IsAffineOpen V → φ ⁻¹ᵁ U ≤ V →
      Function.Surjective (φ.appLE U V hV).hom → IsClosedImmersion (φ ∣_ U) := by
    intro X Y φ U V hV hU hVa hle hsurj
    have hEq : V = φ ⁻¹ᵁ U := le_antisymm hV hle
    subst hEq
    have : IsAffine (U : Scheme.{u}) := hU
    have : IsAffine ((φ ⁻¹ᵁ U : X.Opens) : Scheme.{u}) := hVa
    apply IsClosedImmersion.of_surjective_of_isAffine
