  intro K _ _ ℓ hℓ hℓK H3 A _ _ _ s Ω _ _ z O o hfc f
  haveI : Etale O.hom := O.prop

  obtain ⟨B, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hcomp, hφa, hlim, he, hea⟩ :=
    wc_et_geom_strict_henselization (B := wcHalA1 s) (O.hom o)
  have hd : wcHalShData (O.hom o) B Λ W' φ a := ⟨hinit, haff, hcomp, hφa, hlim, e, he, hea⟩
  obtain ⟨A', _, _, _, Λy, _, _, Wy, φy, b, ey, hinity, haffy, hcompy, hφby, hlimy, hey, heay⟩ :=
    wc_et_geom_strict_henselization (wcHalA1Proj s (O.hom o))
  have hdy : wcHalShData (wcHalA1Proj s (O.hom o)) A' Λy Wy φy b :=
    ⟨hinity, haffy, hcompy, hφby, hlimy, ey, hey, heay⟩
  haveI := hinit
  obtain ⟨e', he'⟩ := wc_shdata_normalized_residue (O.hom o) B Λ W' φ a hd
  set qB : Spec (.of (AlgebraicClosure ((wcHalA1 s).residueField (O.hom o)))) ⟶ Spec (.of B) :=
    Spec.map (CommRingCat.ofHom e') ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))
    with hqB_def
  have hqφ : ∀ l, qB ≫ φ l = (W'.obj l).hom.left := by
    intro l; rw [hqB_def, Category.assoc]; exact he' l
  have hqa : qB ≫ a = wcEtGeomPt (wcHalA1 s) (O.hom o) := by
    obtain ⟨l⟩ := IsCofiltered.nonempty (C := Λ)
    rw [← hφa l, ← Category.assoc, hqφ l]
    exact Over.w (W'.obj l).hom
  have hqpt : qB (IsLocalRing.closedPoint (AlgebraicClosure ((wcHalA1 s).residueField (O.hom o)))) =
      IsLocalRing.closedPoint B := by
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue B))) :=
