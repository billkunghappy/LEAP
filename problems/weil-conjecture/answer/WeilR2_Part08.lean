theorem wc_csd_invpull_proj_coords : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (I : X.IdealSheafData) (n m : ℕ) (U : Fin (n + 1) → X.Opens) (hU : ∀ J, IsAffineOpen (U J)) (g : ∀ J, Fin (m + 1) → Γ(X, U J)) (w : ∀ J L, Γ(X, U J ⊓ U L)), (⨆ J, U J) = ⊤ → (∀ J, I.ideal ⟨U J, hU J⟩ = Ideal.span (Set.range (g J))) → (∀ J L, IsUnit (w J L)) → (∀ J L l, X.presheaf.map (homOfLE (inf_le_right : U J ⊓ U L ≤ U L)).op (g L l) = w J L * X.presheaf.map (homOfLE (inf_le_left : U J ⊓ U L ≤ U J)).op (g J l)) → ∀ (T : Scheme.{u}) (h : T ⟶ X), wcCsdInvPull I h → ∃ (φ : T ⟶ wcProjK K m) (Jt : T → Fin (n + 1)) (W : T → T.Opens) (hW : ∀ t, W t ≤ h ⁻¹ᵁ U (Jt t)) (b : ∀ t, Γ(T, W t)) (σ : ∀ t, Fin (m + 1) → Γ(T, W t)), φ ≫ wcProjKStr K m = h ≫ fX ∧ (∀ t, IsAffineOpen (W t) ∧ t ∈ W t ∧ b t ∈ nonZeroDivisors Γ(T, W t)) ∧ (∀ t l, h.appLE (U (Jt t)) (W t) (hW t) (g (Jt t) l) = σ t l * b t) ∧ (∀ t k, φ ⁻¹ᵁ wcSgD K m k ⊓ W t = T.basicOpen (σ t k)) ∧ (∀ t k l (O : T.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K m k) (hOt : O ≤ W t), φ.appLE (wcSgD K m k) O hO (wcSgE K m k l) * T.presheaf.map (homOfLE hOt).op (σ t k) = T.presheaf.map (homOfLE hOt).op (σ t l)) :=
by
  have hres : ∀ (X : Scheme.{u}) (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
