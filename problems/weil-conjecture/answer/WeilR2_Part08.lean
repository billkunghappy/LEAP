    haveI := isIntegral_of_isOpenImmersion (X.basicOpen Y.det).ι
    exact irreducibleSpace_of_isIntegral _
  obtain ⟨G, qG, MG, hGa, hGi, hGs, hdet, huniv⟩ :=
    gen (AffineSpace (ULift.{u} (Fin c × Fin c)) (Spec (.of K)))
      (AffineSpace (ULift.{u} (Fin c × Fin c)) (Spec (.of K)) ↘ Spec (.of K))
      (Matrix.of fun a b => AffineSpace.coord (Spec (.of K))
        (ULift.up.{u} (a, b) : ULift.{u} (Fin c × Fin c)))
