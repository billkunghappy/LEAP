        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) (q + 1)) := hfin1
  haveI : Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) q) := hfin0
  have h1 := Finite.of_equiv _ E₆.symm
  have h2 := Finite.of_equiv _ E₃.symm

  obtain ⟨hF, hC⟩ := wc_ext_two_row_leray_card L (wcEtPush (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) adj
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX
