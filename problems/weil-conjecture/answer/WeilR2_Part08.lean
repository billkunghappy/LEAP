theorem wc_et_open_slice_lan_vanish : ∀ {X : Scheme.{u}} (U : X.Opens) (P : ((U : Scheme.{u}).Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (V : X.Etale), ¬ (∀ x, V.hom x ∈ (U : Set X)) → Subsingleton (((wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)).op.lan.obj P).obj (Opposite.op V)) :=
by
