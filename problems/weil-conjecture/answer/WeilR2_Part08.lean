    intro Y y p
    simp only [wcEtGeomPt, Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply y _
  have hnorm_a : ∀ {Y : Scheme.{u}} (y : Y) (B0 : Type u) [CommRing B0] [IsLocalRing B0]
      (Λ0 : Type u) [SmallCategory Λ0] [IsCofiltered Λ0]
      (W0 : Λ0 ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y))
      (φ0 : ∀ l, Spec (.of B0) ⟶ (W0.obj l).right.left) (a0 : Spec (.of B0) ⟶ Y),
      wcHalShData y B0 Λ0 W0 φ0 a0 →
      ∀ (t : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Spec (.of B0)),
        (∀ l, t ≫ φ0 l = (W0.obj l).hom.left) → t ≫ a0 = wcEtGeomPt Y y := by
    intro Y y B0 _ _ Λ0 _ _ W0 φ0 a0 hd0 t ht
    obtain ⟨-, -, -, hφa0, -, -⟩ := hd0
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ0)
    rw [← hφa0 l₀, ← Category.assoc, ht l₀]
    exact Over.w (W0.obj l₀).hom

  obtain ⟨-, -, -, -, -, ey, -, hey⟩ := id hdy
  obtain ⟨eB, heB⟩ := wc_shdata_normalized_residue x B Λ W' φ a hd
  obtain ⟨qB, hqB⟩ : ∃ qB : Spec (.of (AlgebraicClosure ((wcHalA1 s).residueField x))) ⟶
      Spec (.of B), qB = Spec.map (CommRingCat.ofHom eB) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) := ⟨_, rfl⟩
  have hqBφ : ∀ l, qB ≫ φ l = (W'.obj l).hom.left := by
    intro l
    rw [hqB, Category.assoc]
    exact heB l
  have hqBpt : ∀ p, qB p = IsLocalRing.closedPoint B := by
    intro p
    rw [hqB]
    exact hpt_gen B _ eB p
  have hqBa : qB ≫ a = wcEtGeomPt (wcHalA1 s) x := hnorm_a x B Λ W' φ a hd qB hqBφ
  have haB : a (IsLocalRing.closedPoint B) = x :=
    (congrArg a (hqBpt (IsLocalRing.closedPoint (AlgebraicClosure ((wcHalA1 s).residueField x))))).symm.trans
      ((Scheme.Hom.comp_apply qB a _).symm.trans
        ((congrArg (fun f : Spec (.of (AlgebraicClosure ((wcHalA1 s).residueField x))) ⟶ wcHalA1 s =>
          f (IsLocalRing.closedPoint (AlgebraicClosure ((wcHalA1 s).residueField x)))) hqBa).trans
          (hgeom_pt x _)))

  obtain ⟨ιy, hιy⟩ := wc_geomPt_down_comparison (wcHalA1Proj s) x
  obtain ⟨c₀, hc₀b, hc₀q⟩ := wc_shdata_comparison_map (wcHalA1Proj s) (wcHalA1Proj s x) x ιy hιy
    A' Λy Wy φy b hdy ey hey B Λ W' φ a hd eB heB
  have hc₀pt : c₀ (IsLocalRing.closedPoint B) = IsLocalRing.closedPoint A' := by
    have e1 : qB ≫ c₀ = ιy ≫ Spec.map (CommRingCat.ofHom ey) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue A')) := by
      rw [hqB, Category.assoc, hc₀q]
    have h1 : (qB ≫ c₀) (IsLocalRing.closedPoint (AlgebraicClosure ((wcHalA1 s).residueField x))) =
        IsLocalRing.closedPoint A' :=
      (congrArg (fun f : Spec (.of (AlgebraicClosure ((wcHalA1 s).residueField x))) ⟶ Spec (.of A') =>
          f (IsLocalRing.closedPoint (AlgebraicClosure ((wcHalA1 s).residueField x)))) e1).trans
