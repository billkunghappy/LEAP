theorem wc_csd_graph_map : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [IsSeparated fX] (n m : ℕ) (U : Fin (n + 1) → X.Opens) (hU : ∀ J, IsAffineOpen (U J)) (g : ∀ J, Fin (m + 1) → Γ(X, U J)) (w : ∀ J L, Γ(X, U J ⊓ U L)), (∀ J L, IsUnit (w J L)) → (∀ J L l, X.presheaf.map (homOfLE (inf_le_right : U J ⊓ U L ≤ U L)).op (g L l) = w J L * X.presheaf.map (homOfLE (inf_le_left : U J ⊓ U L ≤ U J)).op (g J l)) → ∃ (Z : Scheme.{u}) (Φ : Z ⟶ Limits.pullback fX (wcProjKStr K m)), QuasiCompact Φ ∧ (∀ J k, (Φ ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (Φ ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k ≤ (Φ ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ X.basicOpen (g J k)) ∧ (∀ J k l, (Φ ≫ Limits.pullback.snd fX (wcProjKStr K m)).appLE (wcSgD K m k) ((Φ ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (Φ ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_right (wcSgE K m k l) * (Φ ≫ Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) ((Φ ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (Φ ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_left (g J k) = (Φ ≫ Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) ((Φ ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (Φ ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_left (g J l)) ∧ (∀ J k (F : Γ(X, U J)), (Φ ≫ Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) ((Φ ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓ (Φ ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) inf_le_left F = 0 → X.presheaf.map (homOfLE (X.basicOpen_le (g J k))).op F = 0) :=
by
  have hres : ∀ (X : Scheme.{u}) (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
      X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op x) =
        X.presheaf.map (homOfLE h3).op x := by
    intro X A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hid : ∀ (Y : Scheme.{u}) (A : Y.Opens) (h : A ≤ A) (x : Γ(Y, A)),
      Y.presheaf.map (homOfLE h).op x = x := by
    intro Y A h x
    rw [show (homOfLE h).op = 𝟙 (Opposite.op A) from rfl, CategoryTheory.Functor.map_id]
    rfl

  have UQ : ∀ (P S : Scheme.{u}) (q : P ⟶ S) {ι : Type} (D : ι → P.Opens), (∀ J, IsAffineOpen (D J)) →
      ∀ (ε : ∀ J, ι → Γ(P, D J)), (∀ J (x : Γ(P, D J)), x ∈ Subring.closure (Set.range (ε J) ∪
        Set.range (fun c : Γ(S, ⊤) => P.presheaf.map (homOfLE (le_top : D J ≤ ⊤)).op (q.appTop c)))) →
      ∀ (W : Scheme.{u}) (g g' : W ⟶ P) (t : ι → Γ(W, ⊤)), g ≫ q = g' ≫ q →
      (⨆ J, W.basicOpen (t J)) = ⊤ →
      ∀ (hg : ∀ J, W.basicOpen (t J) ≤ g ⁻¹ᵁ D J) (hg' : ∀ J, W.basicOpen (t J) ≤ g' ⁻¹ᵁ D J),
      (∀ J L, g.appLE (D J) (W.basicOpen (t J)) (hg J) (ε J L) *
        W.presheaf.map (homOfLE (le_top : W.basicOpen (t J) ≤ ⊤)).op (t J) =
        W.presheaf.map (homOfLE (le_top : W.basicOpen (t J) ≤ ⊤)).op (t L)) →
      (∀ J L, g'.appLE (D J) (W.basicOpen (t J)) (hg' J) (ε J L) *
        W.presheaf.map (homOfLE (le_top : W.basicOpen (t J) ≤ ⊤)).op (t J) =
        W.presheaf.map (homOfLE (le_top : W.basicOpen (t J) ≤ ⊤)).op (t L)) → g = g' := by
    intro P S q ι D hDa ε hgen W g g' t hq hcov hg hg' hr hr'
    have hconst : ∀ (h : W ⟶ P) (U : P.Opens) (V : W.Opens) (e : V ≤ h ⁻¹ᵁ U) (x : Γ(P, ⊤)),
        h.appLE U V e (P.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op x) =
          W.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (h.appTop x) := by
      intro h U V e x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
      rfl
    apply Scheme.Cover.hom_ext (W.openCoverOfIsOpenCover (fun J => W.basicOpen (t J)) hcov)
    refine fun (J : ι) => ?_
    show (W.basicOpen (t J)).ι ≫ g = (W.basicOpen (t J)).ι ≫ g'
    rw [← Scheme.Hom.resLE_comp_ι g (hg J), ← Scheme.Hom.resLE_comp_ι g' (hg' J)]
    congr 1
    haveI : IsAffine (D J) := hDa J
    apply ext_of_isAffine
    show (g.resLE (D J) (W.basicOpen (t J)) (hg J)).app ⊤ =
      (g'.resLE (D J) (W.basicOpen (t J)) (hg' J)).app ⊤
    rw [Scheme.Hom.resLE_app_top, Scheme.Hom.resLE_app_top]
    congr 2
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    refine RingHom.eqOn_set_closure (f := (g.appLE (D J) (W.basicOpen (t J)) (hg J)).hom)
      (g := (g'.appLE (D J) (W.basicOpen (t J)) (hg' J)).hom) ?_ (hgen J x)
    rintro _ (⟨L, rfl⟩ | ⟨c, rfl⟩)
    · have hu : IsUnit (W.presheaf.map (homOfLE (W.basicOpen_le (t J))).op (t J)) :=
        RingedSpace.isUnit_res_basicOpen _ _
      have e1 := hr J L
      rw [← hr' J L] at e1
      exact (hu.mul_left_inj).mp e1
    · have hqc : g.appTop (q.appTop c) = g'.appTop (q.appTop c) := by
        have := congrArg (fun h => (Scheme.Hom.appTop h).hom c) hq
        simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using this
      show (g.appLE (D J) (W.basicOpen (t J)) (hg J)) (P.presheaf.map (homOfLE (le_top : D J ≤ ⊤)).op (q.appTop c)) =
        (g'.appLE (D J) (W.basicOpen (t J)) (hg' J)) (P.presheaf.map (homOfLE (le_top : D J ≤ ⊤)).op (q.appTop c))
      rw [hconst, hconst, hqc]

  have S1 : ∀ (K : Type u) [Field K] (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)),
