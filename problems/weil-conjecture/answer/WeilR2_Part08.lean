  have hid : ∀ {Y : Scheme.{u}} (s : Y ⟶ AffineSpace (ULift.{u} (Fin c)) G),
      (∀ a b, (s ≫ (AffineSpace (ULift.{u} (Fin c)) G ↘ G)).appTop.hom (MG a b) =
