  have cover : ∀ (n k : ℕ) (V : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens), (V : Set (Spec (.of (MvPolynomial (Fin (n + 1)) K)))) = {x | ∃ i : Fin (n + 1), i.val < k + 1 ∧ (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} → ∃ (W : (Spec (.of (MvPolynomial (Fin n) K))).Opens) (A B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens), (W : Set (Spec (.of (MvPolynomial (Fin n) K)))) = {x | ∃ i : Fin n, i.val < k ∧ (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ x.asIdeal} ∧ (A : Set (Spec (.of (MvPolynomial (Fin (n + 1)) K)))) = {x | (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} ∧ (B : Set (Spec (.of (MvPolynomial (Fin (n + 1)) K)))) = {x | ∃ i : Fin n, i.val < k ∧ (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} ∧ A ⊔ B = V ∧ Nonempty ((A : Scheme.{u}) ≅ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ∧ Nonempty ((B : Scheme.{u}) ≅ Limits.pullback ((W : (Spec (.of (MvPolynomial (Fin n) K))).Opens).ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ∧ Nonempty (((A ⊓ B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens) : Scheme.{u}) ≅ Limits.pullback ((W : (Spec (.of (MvPolynomial (Fin n) K))).Opens).ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) := by
    intro n k V hV
    have s2 : ∀ {S X' Y' X₀ Y₀ Z : Scheme.{u}} (f' : X' ⟶ S) (g' : Y' ⟶ S) (i₁ : X₀ ⟶ X')
        (i₂ : Y₀ ⟶ Y') [IsOpenImmersion i₁] [IsOpenImmersion i₂] (ι : Limits.pullback f' g' ≅ Z)
        (U : Z.Opens), (∀ w : ↥(Limits.pullback f' g'), ι.hom w ∈ U ↔
          (Limits.pullback.fst f' g' w ∈ Set.range i₁ ∧ Limits.pullback.snd f' g' w ∈ Set.range i₂)) →
        Nonempty ((U : Scheme.{u}) ≅ Limits.pullback (i₁ ≫ f') (i₂ ≫ g')) := by
      intro S X' Y' X₀ Y₀ Z f' g' i₁ i₂ _ _ ι U h
