theorem wc_et_affine_partial_punct_vanishing : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (n k : ℕ), k ≤ n → ∀ (E : (Spec (.of (MvPolynomial (Fin n) K))).Opens), (E : Set (Spec (.of (MvPolynomial (Fin n) K)))) = {x | ∃ j : Fin n, j.val < k ∧ (MvPolynomial.X j : MvPolynomial (Fin n) K) ∉ x.asIdeal} → ∀ q : ℕ, 2 * k ≤ q → Subsingleton (wcEtCoh (E : Scheme.{u}) ℓ q) :=
by
  classical
  intro K _ _ ℓ hℓ hℓK

  have hempty : ∀ (Y : Scheme.{u}), IsEmpty Y → ∀ (m q : ℕ), Subsingleton (wcEtCoh Y m q) := by
    intro Y hY m q
    have s1 : ∀ V : Y.Etale, IsEmpty V.left := fun V => ⟨fun x => hY.false (V.hom.base x)⟩
    have s2 : ∀ V : Y.Etale, (⊥ : Sieve V) ∈ Scheme.smallEtaleTopology Y V := by
      intro V
