    have GLUE0 : ∀ (X Y : Scheme.{u}) {I : Type u} (U : I → X.Opens), (⨆ i, U i) = ⊤ → ∀ (φ : ∀ i, (U i : Scheme.{u}) ⟶ Y), (∀ i j, X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i) ≫ φ i = X.homOfLE (inf_le_right : U i ⊓ U j ≤ U j) ≫ φ j) → ∃ σ : X ⟶ Y, (∀ i, (U i).ι ≫ σ = φ i) ∧ ∀ (Z : Scheme.{u}) (f g : X ⟶ Z), (∀ i, (U i).ι ≫ f = (U i).ι ≫ g) → f = g := by
      intro X Y I U hU φ hφ
      let 𝒰 := X.openCoverOfIsOpenCover U hU
      refine ⟨𝒰.glueMorphisms φ ?_, fun i => 𝒰.ι_glueMorphisms φ _ i, fun Z f g h => 𝒰.hom_ext f g h⟩
