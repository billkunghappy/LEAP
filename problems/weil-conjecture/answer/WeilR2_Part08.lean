    rw [Matrix.one_apply, Matrix.one_apply]
    split_ifs <;> simp
  have hSpr := s1 qG
  have hSact : IsPullback qG (AffineSpace.homOfVector (𝟙 G) (0 : ULift.{u} (Fin c) → Γ(G, ⊤)))
      (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))
      (Φ MG ≫ AffineSpace.map (ULift.{u} (Fin c)) qG) := by
    have hsq : IsPullback (𝟙 G) (AffineSpace.homOfVector (𝟙 G) (0 : ULift.{u} (Fin c) → Γ(G, ⊤)))
