      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hãpr : ã ≫ pr = a := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hprg, ← Category.assoc, hãg, hc₀b]
    · rw [Category.assoc, hprsnd, hãsnd]
  have hprx : pr (ã (IsLocalRing.closedPoint B)) = x :=
    (Scheme.Hom.comp_apply ã pr _).symm.trans
      ((congrArg (fun f : Spec (.of B) ⟶ wcHalA1 s => f (IsLocalRing.closedPoint B)) hãpr).trans haB)
  have hg'x : wcHalA1Proj (b ≫ s) (ã (IsLocalRing.closedPoint B)) = IsLocalRing.closedPoint A' :=
    (Scheme.Hom.comp_apply ã (wcHalA1Proj (b ≫ s)) _).symm.trans
