    (eX V).apply_symm_apply (t V (eY ((wcEtBaseChange p).obj V) s))
  have hcomap : ∀ (V V' : X.Etale) (g : V' ⟶ V)
      (s : (wcEtZModRing Y' ℓ).obj.obj (Opposite.op ((wcEtBaseChange p).obj V))),
      eY ((wcEtBaseChange p).obj V')
          (((wcEtZModRing Y' ℓ).obj.map ((wcEtBaseChange p).map g).op).hom s) =
        (eY ((wcEtBaseChange p).obj V) s).comap
          ⟨((wcEtBaseChange p).map g).left, ((wcEtBaseChange p).map g).left.continuous⟩ := by
    intro V V' g s
    ext z
    exact heY _ _ _ s z
  have hpull : ∀ (V V' : X.Etale) (g : V' ⟶ V)
      (s : (wcEtZModRing Y' ℓ).obj.obj (Opposite.op ((wcEtBaseChange p).obj V))) (x : V'.left),
      t V' (eY ((wcEtBaseChange p).obj V')
          (((wcEtZModRing Y' ℓ).obj.map ((wcEtBaseChange p).map g).op).hom s)) x =
        t V (eY ((wcEtBaseChange p).obj V) s) (g.left x) := by
    intro V V' g s x
    rw [hcomap]
    exact hnat V V' g _ x
  refine ⟨⟨PresheafOfModules.homMk
    { app := fun V => AddCommGrpCat.ofHom (T V.unop)
      naturality := fun V W f => by
        obtain ⟨V⟩ := V
        obtain ⟨W⟩ := W
        ext m
        change T W (((wcEtZModRing Y' ℓ).obj.map ((wcEtBaseChange p).map f.unop).op).hom m) =
          ((wcEtZModRing X ℓ).obj.map f.unop.op).hom (T V m)
        apply (eX W).injective
        ext x
