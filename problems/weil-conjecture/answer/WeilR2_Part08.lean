    exact (congrArg c₀ (hqBpt _)).symm.trans ((Scheme.Hom.comp_apply qB c₀ _).symm.trans h1)

  have hw : c₀ ≫ (b ≫ s) = (a ≫ Limits.pullback.snd s
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) := by
    rw [← Category.assoc, hc₀b]
    simp only [Category.assoc]
    rw [Limits.pullback.condition]
  obtain ⟨ã, hãg, hãsnd⟩ : ∃ ã : Spec (.of B) ⟶ wcHalA1 (b ≫ s),
      ã ≫ wcHalA1Proj (b ≫ s) = c₀ ∧
      ã ≫ Limits.pullback.snd (b ≫ s) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
