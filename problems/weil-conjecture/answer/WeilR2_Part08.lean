  exact congrArg δ₀' hC6

theorem wc_et_mv_boundary_natural_family : ∀ (ℓ n : ℕ), ∃ δ : ∀ (Z : Scheme.{u}) (A B : Z.Opens), wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ n →+ wcEtZModExt Z ℓ (n + 1), (∀ (Z : Scheme.{u}) (A B : Z.Opens), A ⊔ B = ⊤ → ∀ (a : wcEtZModExt (A : Scheme.{u}) ℓ n) (Da : wcEtPullData (Z.homOfLE (inf_le_left : A ⊓ B ≤ A)) ℓ), δ Z A B (wcEtPull Da n a) = 0) ∧ (∀ (Z : Scheme.{u}) (A B : Z.Opens), A ⊔ B = ⊤ → ∀ (b : wcEtZModExt (B : Scheme.{u}) ℓ n) (Db : wcEtPullData (Z.homOfLE (inf_le_right : A ⊓ B ≤ B)) ℓ), δ Z A B (wcEtPull Db n b) = 0) ∧ (∀ (Z : Scheme.{u}) (A B : Z.Opens), A ⊔ B = ⊤ → ∀ α : wcEtZModExt Z ℓ (n + 1), (∀ DA : wcEtPullData A.ι ℓ, wcEtPull DA (n + 1) α = 0) → (∀ DB : wcEtPullData B.ι ℓ, wcEtPull DB (n + 1) α = 0) → ∃ γ, δ Z A B γ = α) ∧ (∀ (Z Z' : Scheme.{u}) (g : Z' ⟶ Z) (A B : Z.Opens), A ⊔ B = ⊤ → ∀ (γ : wcEtZModExt ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ n) (Dg : wcEtPullData g ℓ) (Dr : wcEtPullData (g ∣_ (A ⊓ B)) ℓ), wcEtPull Dg (n + 1) (δ Z A B γ) = δ Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) (wcEtPull Dr n γ)) :=
by
  classical
  intro ℓ n
  refine ⟨fun Z A B => if h : A ⊔ B = ⊤ then Classical.choose (wc_et_mv_boundary_chosen_data ℓ n Z A B h) else 0,
    ?_, ?_, ?_, ?_⟩
  · intro Z A B h a Da
    show (if h : A ⊔ B = ⊤ then Classical.choose (wc_et_mv_boundary_chosen_data ℓ n Z A B h) else 0) (wcEtPull Da n a) = 0
    rw [dif_pos h]
    exact (wc_et_mv_boundary_kills_restr ℓ n Z A B _
      (Classical.choose_spec (wc_et_mv_boundary_chosen_data ℓ n Z A B h))).1 a Da
  · intro Z A B h b Db
    show (if h : A ⊔ B = ⊤ then Classical.choose (wc_et_mv_boundary_chosen_data ℓ n Z A B h) else 0) (wcEtPull Db n b) = 0
    rw [dif_pos h]
    exact (wc_et_mv_boundary_kills_restr ℓ n Z A B _
      (Classical.choose_spec (wc_et_mv_boundary_chosen_data ℓ n Z A B h))).2 b Db
  · intro Z A B h α hA hB
    show ∃ γ, (if h : A ⊔ B = ⊤ then Classical.choose (wc_et_mv_boundary_chosen_data ℓ n Z A B h) else 0) γ = α
    rw [dif_pos h]
    exact wc_et_mv_boundary_onto ℓ n Z A B _
      (Classical.choose_spec (wc_et_mv_boundary_chosen_data ℓ n Z A B h)) α hA hB
  · intro Z Z' g A B h γ Dg Dr
    have h' : g ⁻¹ᵁ A ⊔ g ⁻¹ᵁ B = ⊤ := by
      rw [← Scheme.Hom.preimage_sup, h, Scheme.Hom.preimage_top]
    show wcEtPull Dg (n + 1) ((if h : A ⊔ B = ⊤ then Classical.choose (wc_et_mv_boundary_chosen_data ℓ n Z A B h) else 0) γ) =
      (if h : g ⁻¹ᵁ A ⊔ g ⁻¹ᵁ B = ⊤ then Classical.choose (wc_et_mv_boundary_chosen_data ℓ n Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) h) else 0) (wcEtPull Dr n γ)
    rw [dif_pos h, dif_pos h']
    exact wc_et_mv_boundary_natural_of_data ℓ n Z Z' g A B _ _
      (Classical.choose_spec (wc_et_mv_boundary_chosen_data ℓ n Z A B h))
      (Classical.choose_spec (wc_et_mv_boundary_chosen_data ℓ n Z' (g ⁻¹ᵁ A) (g ⁻¹ᵁ B) h'))
      γ Dg Dr

theorem wc_et_mv_boundary_local_gen : ∀ {Y₀ : Scheme.{u}} (A₀ B₀ : Y₀.Opens), A₀ ⊔ B₀ = ⊤ → ∀ (ℓ n : ℕ) (ε₀ : wcEtZModExt ((A₀ ⊓ B₀ : Y₀.Opens) : Scheme.{u}) ℓ n), ∃ θ₀ : wcEtZModExt Y₀ ℓ (n + 1), ∀ {S Y : Scheme.{u}} (h : Y ⟶ S) (pr : Y ⟶ Y₀) (α : wcEtZModExt Y ℓ (n + 1)), (∀ DA : wcEtPullData (pr ⁻¹ᵁ A₀).ι ℓ, wcEtPcLocDies ((pr ⁻¹ᵁ A₀).ι ≫ h) ℓ (n + 1) (wcEtPull DA (n + 1) α)) → (∀ DB : wcEtPullData (pr ⁻¹ᵁ B₀).ι ℓ, wcEtPcLocDies ((pr ⁻¹ᵁ B₀).ι ≫ h) ℓ (n + 1) (wcEtPull DB (n + 1) α)) → wcEtMVGenTop h pr ℓ A₀ B₀ n ε₀ → ∀ x : S, ∃ (S' : Scheme.{u}) (s' : S' ⟶ S), Etale s' ∧ x ∈ Set.range s' ∧ ∃ k : ℕ, ∀ (Y' : Scheme.{u}) (h' : Y' ⟶ S') (w' : Y' ⟶ Y), IsPullback w' h' h s' → ∀ (Dw' : wcEtPullData w' ℓ) (Dc : wcEtPullData (w' ≫ pr) ℓ), wcEtPull Dw' (n + 1) α = k • wcEtPull Dc (n + 1) θ₀ :=
by
  classical
  intro Y₀ A₀ B₀ hAB ℓ n ε₀
  obtain ⟨δ, P1A, P1B, P2, P3⟩ := wc_et_mv_boundary_natural_family ℓ n

  have hT : ∀ {Z Z' : Scheme.{u}} (g₁ g₂ : Z' ⟶ Z), g₁ = g₂ → ∀ (D₁ : wcEtPullData g₁ ℓ)
      (D₂ : wcEtPullData g₂ ℓ) (q : ℕ) (y : wcEtZModExt Z ℓ q),
      wcEtPull D₂ q y = wcEtPull D₁ q y := by
    intro Z Z' g₁ g₂ e D₁ D₂ q y
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 Z') ℓ
    rw [wc_et_pull_comp g₁ (𝟙 _) g₂ (by rw [Category.id_comp, e]) D₁ Did D₂ q y,
      ← wc_et_pull_comp g₁ (𝟙 _) g₁ (Category.id_comp _) D₁ Did D₁ q y]
  refine ⟨δ Y₀ A₀ B₀ ε₀, ?_⟩
  intro S Y h pr α HA HB HS

  have hrefine : ∀ {T Z T0 : Scheme.{u}} (g : Z ⟶ T) (s0 : T0 ⟶ T) (β : wcEtZModExt Z ℓ (n + 1)),
      (∀ (Y' : Scheme.{u}) (h' : Y' ⟶ T0) (w' : Y' ⟶ Z), IsPullback w' h' g s0 →
        ∀ D : wcEtPullData w' ℓ, wcEtPull D (n + 1) β = 0) →
      ∀ {W : Scheme.{u}} (w1 : W ⟶ Z) (t1 : W ⟶ T0), w1 ≫ g = t1 ≫ s0 →
        ∀ D : wcEtPullData w1 ℓ, wcEtPull D (n + 1) β = 0 := by
    intro T Z T0 g s0 β hkill W w1 t1 e D
    obtain ⟨Dfst⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst g s0) ℓ
    obtain ⟨Dm⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.lift w1 t1 e) ℓ
    rw [wc_et_pull_comp (Limits.pullback.fst g s0) (Limits.pullback.lift w1 t1 e) w1
      (Limits.pullback.lift_fst _ _ _) Dfst Dm D (n + 1) β,
      hkill _ _ _ (IsPullback.of_hasPullback g s0) Dfst, map_zero]
  intro x
  obtain ⟨DA0⟩ := wc_et_zmod_pull_data_exists (pr ⁻¹ᵁ A₀).ι ℓ
  obtain ⟨DB0⟩ := wc_et_zmod_pull_data_exists (pr ⁻¹ᵁ B₀).ι ℓ
  obtain ⟨SA, sA, hsA, ⟨xa, hxa⟩, killA⟩ := HA DA0 x
  obtain ⟨SB, sB, hsB, ⟨xb, hxb⟩, killB⟩ := HB DB0 x
  haveI := hsA
  haveI := hsB

  obtain ⟨S1, s1, tA, tB, hs1, htA, htB, x1, hx1⟩ : ∃ (S1 : Scheme.{u}) (s1 : S1 ⟶ S)
      (tA : S1 ⟶ SA) (tB : S1 ⟶ SB), Etale s1 ∧ s1 = tA ≫ sA ∧ s1 = tB ≫ sB ∧
      ∃ x1 : S1, s1 x1 = x := by
    obtain ⟨x1, hx1a, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := sA) (g := sB) xa xb
      (hxa.trans hxb.symm)
    exact ⟨_, Limits.pullback.fst sA sB ≫ sA, Limits.pullback.fst sA sB,
      Limits.pullback.snd sA sB, inferInstance, rfl, Limits.pullback.condition, x1,
      by rw [Scheme.Hom.comp_apply, hx1a, hxa]⟩
  haveI := hs1
  obtain ⟨Y1, w1, h1, hsq1⟩ : ∃ (Y1 : Scheme.{u}) (w1 : Y1 ⟶ Y) (h1 : Y1 ⟶ S1),
      IsPullback w1 h1 h s1 := ⟨_, _, _, IsPullback.of_hasPullback h s1⟩
  obtain ⟨D1⟩ := wc_et_zmod_pull_data_exists w1 ℓ

  have hres : ∀ (U : Y.Opens) (SU : Scheme.{u}) (sU : SU ⟶ S) (tU : S1 ⟶ SU), s1 = tU ≫ sU →
      ∀ DU0 : wcEtPullData U.ι ℓ,
      (∀ (Y' : Scheme.{u}) (h' : Y' ⟶ SU) (w' : Y' ⟶ (U : Scheme.{u})), IsPullback w' h' (U.ι ≫ h) sU →
        ∀ D : wcEtPullData w' ℓ, wcEtPull D (n + 1) (wcEtPull DU0 (n + 1) α) = 0) →
      ∀ DU1 : wcEtPullData (w1 ⁻¹ᵁ U).ι ℓ, wcEtPull DU1 (n + 1) (wcEtPull D1 (n + 1) α) = 0 := by
    intro U SU sU tU htU DU0 killU DU1
    obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists ((w1 ⁻¹ᵁ U).ι ≫ w1) ℓ
    obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists (w1 ∣_ U) ℓ
    rw [← wc_et_pull_comp w1 (w1 ⁻¹ᵁ U).ι _ rfl D1 DU1 Dk,
      wc_et_pull_comp U.ι (w1 ∣_ U) _ (morphismRestrict_ι w1 U) DU0 Dr Dk]
    refine hrefine (U.ι ≫ h) sU _ killU (w1 ∣_ U) ((w1 ⁻¹ᵁ U).ι ≫ h1 ≫ tU) ?_ Dr
    calc w1 ∣_ U ≫ U.ι ≫ h = (w1 ⁻¹ᵁ U).ι ≫ w1 ≫ h := by
          rw [← Category.assoc, morphismRestrict_ι, Category.assoc]
      _ = (w1 ⁻¹ᵁ U).ι ≫ h1 ≫ s1 := by rw [hsq1.w]
      _ = ((w1 ⁻¹ᵁ U).ι ≫ h1 ≫ tU) ≫ sU := by rw [htU]; simp only [Category.assoc]
  have hresA := hres (pr ⁻¹ᵁ A₀) SA sA tA htA DA0 killA
  have hresB := hres (pr ⁻¹ᵁ B₀) SB sB tB htB DB0 killB
  have hAB1 : (w1 ≫ pr) ⁻¹ᵁ A₀ ⊔ (w1 ≫ pr) ⁻¹ᵁ B₀ = ⊤ := by
    rw [← Scheme.Hom.preimage_sup, hAB, Scheme.Hom.preimage_top]

  obtain ⟨γ1, hγ1⟩ := P2 Y1 ((w1 ≫ pr) ⁻¹ᵁ A₀) ((w1 ≫ pr) ⁻¹ᵁ B₀) hAB1
    (wcEtPull D1 (n + 1) α) hresA hresB

  obtain ⟨S2, s2, hs2, ⟨x2, hx2⟩, k, split⟩ := HS S1 s1 hs1 Y1 h1 w1 hsq1 γ1 x1
  haveI := hs2
  refine ⟨S2, s2 ≫ s1, inferInstance, ⟨x2, by rw [Scheme.Hom.comp_apply, hx2, hx1]⟩, k, ?_⟩
  intro Y' h' w' hsq' Dw' Dc
  have e : w' ≫ h = (h' ≫ s2) ≫ s1 := by rw [hsq'.w, Category.assoc]
  obtain ⟨w2, hw2a, hw2b⟩ : ∃ w2 : Y' ⟶ Y1, w2 ≫ w1 = w' ∧ w2 ≫ h1 = h' ≫ s2 :=
    ⟨hsq1.lift w' (h' ≫ s2) e, hsq1.lift_fst _ _ _, hsq1.lift_snd _ _ _⟩
  have hsq2 : IsPullback w2 h' h1 s2 :=
    IsPullback.of_right (by rw [hw2a]; exact hsq') hw2b hsq1
  obtain ⟨a, b, hsum⟩ := split Y' h' w2 hsq2
  obtain ⟨Dw2⟩ := wc_et_zmod_pull_data_exists w2 ℓ
  obtain ⟨Dγ⟩ := wc_et_zmod_pull_data_exists (w2 ∣_ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀))) ℓ
  obtain ⟨Da⟩ := wc_et_zmod_pull_data_exists (Y'.homOfLE (show w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀)) ≤
    w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ A₀) from fun _ hy => hy.1)) ℓ
  obtain ⟨Db⟩ := wc_et_zmod_pull_data_exists (Y'.homOfLE (show w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀)) ≤
    w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ B₀) from fun _ hy => hy.2)) ℓ
  obtain ⟨Dε⟩ := wc_et_zmod_pull_data_exists
    (w2 ∣_ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀)) ≫ (w1 ≫ pr) ∣_ (A₀ ⊓ B₀)) ℓ
  have hsig := hsum Dγ Da Db Dε
  have hAB' : w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ A₀) ⊔ w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ B₀) = ⊤ := by
    rw [← Scheme.Hom.preimage_sup, hAB1, Scheme.Hom.preimage_top]

  obtain ⟨δ', hδ'⟩ : ∃ δ' : wcEtZModExt ((w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀)) : Y'.Opens) : Scheme.{u})
      ℓ n →+ wcEtZModExt Y' ℓ (n + 1),
      ∀ y, δ' y = δ Y' (w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ A₀)) (w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ B₀)) y :=
    ⟨δ Y' (w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ A₀)) (w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ B₀)), fun _ => rfl⟩
  have h1' : wcEtPull Dw' (n + 1) α = δ' (wcEtPull Dγ n γ1) := by
    rw [wc_et_pull_comp w1 w2 w' hw2a D1 Dw2 Dw' (n + 1) α, ← hγ1, hδ']
    exact P3 Y1 Y' w2 ((w1 ≫ pr) ⁻¹ᵁ A₀) ((w1 ≫ pr) ⁻¹ᵁ B₀) hAB1 γ1 Dw2 Dγ
  have h2' : δ' (wcEtPull Da n a) = 0 := by
    rw [hδ']
    exact P1A Y' _ _ hAB' a Da
  have h3' : δ' (wcEtPull Db n b) = 0 := by
    rw [hδ']
    exact P1B Y' _ _ hAB' b Db
  obtain ⟨Dr'⟩ := wc_et_zmod_pull_data_exists ((w2 ≫ (w1 ≫ pr)) ∣_ (A₀ ⊓ B₀)) ℓ
  obtain ⟨DG⟩ := wc_et_zmod_pull_data_exists (w2 ≫ (w1 ≫ pr)) ℓ
  have h4' : (wcEtPull Dε n ε₀ : wcEtZModExt ((w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀)) : Y'.Opens) :
      Scheme.{u}) ℓ n) = wcEtPull Dr' n ε₀ :=
    hT _ _ (morphismRestrict_comp w2 (w1 ≫ pr) (A₀ ⊓ B₀)) Dr' Dε n ε₀
  have h5' : δ' (wcEtPull Dr' n ε₀) = wcEtPull DG (n + 1) (δ Y₀ A₀ B₀ ε₀) := by
    first
      | exact (hδ' _).trans (P3 Y₀ Y' (w2 ≫ (w1 ≫ pr)) A₀ B₀ hAB ε₀ DG Dr').symm
      | exact Eq.trans (hδ' (wcEtPull Dr' n ε₀ : wcEtZModExt ((w2 ⁻¹ᵁ ((w1 ≫ pr) ⁻¹ᵁ (A₀ ⊓ B₀)) :
          Y'.Opens) : Scheme.{u}) ℓ n)) (P3 Y₀ Y' (w2 ≫ (w1 ≫ pr)) A₀ B₀ hAB ε₀ DG Dr').symm
      | (erw [hδ']; exact (P3 Y₀ Y' (w2 ≫ (w1 ≫ pr)) A₀ B₀ hAB ε₀ DG Dr').symm)
  have h6' : wcEtPull DG (n + 1) (δ Y₀ A₀ B₀ ε₀) = wcEtPull Dc (n + 1) (δ Y₀ A₀ B₀ ε₀) :=
    (hT (w2 ≫ (w1 ≫ pr)) (w' ≫ pr) (by rw [← Category.assoc, hw2a]) DG Dc (n + 1)
      (δ Y₀ A₀ B₀ ε₀)).symm
  calc wcEtPull Dw' (n + 1) α = δ' (wcEtPull Dγ n γ1) := h1'
    _ = δ' (wcEtPull Da n a + wcEtPull Db n b + k • wcEtPull Dε n ε₀) := congrArg δ' hsig
    _ = δ' (wcEtPull Da n a) + δ' (wcEtPull Db n b) + k • δ' (wcEtPull Dε n ε₀) := by
        rw [map_add, map_add, map_nsmul]
    _ = k • δ' (wcEtPull Dε n ε₀) := by rw [h2', h3', zero_add, zero_add]
    _ = k • δ' (wcEtPull Dr' n ε₀) := congrArg (fun y => k • δ' y) h4'
    _ = k • wcEtPull DG (n + 1) (δ Y₀ A₀ B₀ ε₀) := congrArg (fun y => k • y) h5'
    _ = k • wcEtPull Dc (n + 1) (δ Y₀ A₀ B₀ ε₀) := congrArg (fun y => k • y) h6'

theorem wc_et_punct_top_local_gen : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → 1 ≤ c → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (U₀ : (Spec (.of (MvPolynomial (Fin c) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin c) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))))ᶜ → ∀ (pr : (U : Scheme.{u}) ⟶ (U₀ : Scheme.{u})), pr ≫ U₀.ι = U.ι ≫ q → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∃ ω : wcEtZModExt (U₀ : Scheme.{u}) ℓ (2 * c - 1), ω ≠ 0 ∧ ∀ (Dpr : wcEtPullData pr ℓ) (V : Scheme.{u}) (v : V ⟶ S), Etale v → ∀ (YV : Scheme.{u}) (gV : YV ⟶ V) (w : YV ⟶ (U : Scheme.{u})), IsPullback w gV (U.ι ≫ p) v → ∀ (α : wcEtZModExt YV ℓ (2 * c - 1)) (x : V), ∃ (V' : Scheme.{u}) (v' : V' ⟶ V), Etale v' ∧ x ∈ Set.range v' ∧ ∃ k : ℕ, ∀ (YV' : Scheme.{u}) (gV' : YV' ⟶ V') (w' : YV' ⟶ YV), IsPullback w' gV' gV v' → ∀ (Dw' : wcEtPullData w' ℓ) (Dc : wcEtPullData (w' ≫ w) ℓ), wcEtPull Dw' (2 * c - 1) α = k • wcEtPull Dc (2 * c - 1) (wcEtPull Dpr (2 * c - 1) ω) :=
by
  classical
  intro K _ _ S fS m _ c P p q z0 hP hz0p hz0q hc U hU U₀ hU₀ pr hpr ℓ _ hℓ
  have hoc : ∀ c0 : ℕ, IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c0) K →+* K))) := fun c0 =>
    IsClosedImmersion.spec_of_surjective _
      (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ a⟩)
  obtain ⟨z⟩ : Nonempty (Spec (.of K)) := ⟨IsLocalRing.closedPoint K⟩

  have hcore : ∀ c0 : ℕ, 1 ≤ c0 → ∀ (U₁ : (Spec (.of (MvPolynomial (Fin c0) K))).Opens),
      (U₁ : Set (Spec (.of (MvPolynomial (Fin c0) K)))) = (Set.range (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c0) K →+* K))))ᶜ →
      ∃ ω : wcEtZModExt (U₁ : Scheme.{u}) ℓ (2 * c0 - 1),
        wcEtPunctTopCore K ℓ c0 U₁ (2 * c0 - 1) ω := by
    intro c0 hc0
    induction c0, hc0 using Nat.le_induction with
    | base =>
      intro U₁ hU₁
      show ∃ ω : wcEtZModExt (U₁ : Scheme.{u}) ℓ 1, wcEtPunctTopCore K ℓ 1 U₁ 1 ω
      exact wc_et_punct_top_base_case K ℓ hℓ U₁ hU₁
    | succ c' hc' ih =>
      intro U₁ hU₁
      haveI := hoc c'
      let W₀ : (Spec (.of (MvPolynomial (Fin c') K))).Opens :=
        ⟨(Set.range (Spec.map (CommRingCat.ofHom
            (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K))))ᶜ,
          (IsClosedImmersion.isClosedEmbedding _).isClosed_range.isOpen_compl⟩
      obtain ⟨ω', hω'⟩ := ih W₀ rfl
      obtain ⟨ε₀, hε₀⟩ := wc_et_punct_top_cover_mv_gen K ℓ hℓ c' hc' W₀ rfl ω' hω' U₁ hU₁

      have hsup : wcEtPtCovA0 U₁ ⊔ wcEtPtCovB0 U₁ = ⊤ := by
        rw [eq_top_iff]
        intro y _
        rw [TopologicalSpace.Opens.mem_sup]
        by_contra hcon
        rw [not_or] at hcon
