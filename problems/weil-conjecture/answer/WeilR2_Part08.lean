theorem wc_et_supp_cocycle_open_transport : ∀ {X : Scheme.{u}} (n : ℕ) (O : X.Opens) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing X n))) (W : X.Opens) (OW : (W : Scheme.{u}).Opens), (OW : Set (W : Scheme.{u})) = W.ι ⁻¹' (O : Set X) → ∀ (b : ℕ), (∀ (I' : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (W : Scheme.{u}) n))) (c : ((SheafOfModules.toSheaf (wcEtZModRing (W : Scheme.{u}) n)).obj (I'.cocomplex.X b)).obj.obj (Opposite.op ((wcZarToEt (W : Scheme.{u})).obj ⊤))), (((SheafOfModules.toSheaf (wcEtZModRing (W : Scheme.{u}) n)).obj (I'.cocomplex.X b)).obj.map ((wcZarToEt (W : Scheme.{u})).map (homOfLE (inf_le_left : ⊤ ⊓ OW ≤ ⊤))).op).hom c = 0 → (((SheafOfModules.toSheaf (wcEtZModRing (W : Scheme.{u}) n)).map (I'.cocomplex.d b (b + 1))).hom.app (Opposite.op ((wcZarToEt (W : Scheme.{u})).obj ⊤))).hom c = 0 → ∃ e : ((SheafOfModules.toSheaf (wcEtZModRing (W : Scheme.{u}) n)).obj (I'.cocomplex.X (b - 1))).obj.obj (Opposite.op ((wcZarToEt (W : Scheme.{u})).obj ⊤)), (((SheafOfModules.toSheaf (wcEtZModRing (W : Scheme.{u}) n)).obj (I'.cocomplex.X (b - 1))).obj.map ((wcZarToEt (W : Scheme.{u})).map (homOfLE (inf_le_left : ⊤ ⊓ OW ≤ ⊤))).op).hom e = 0 ∧ (((SheafOfModules.toSheaf (wcEtZModRing (W : Scheme.{u}) n)).map (I'.cocomplex.d (b - 1) b)).hom.app (Opposite.op ((wcZarToEt (W : Scheme.{u})).obj ⊤))).hom e = c) → ∀ c : ((SheafOfModules.toSheaf (wcEtZModRing X n)).obj (I.cocomplex.X b)).obj.obj (Opposite.op ((wcZarToEt X).obj W)), (((SheafOfModules.toSheaf (wcEtZModRing X n)).obj (I.cocomplex.X b)).obj.map ((wcZarToEt X).map (homOfLE (inf_le_left : W ⊓ O ≤ W))).op).hom c = 0 → (((SheafOfModules.toSheaf (wcEtZModRing X n)).map (I.cocomplex.d b (b + 1))).hom.app (Opposite.op ((wcZarToEt X).obj W))).hom c = 0 → ∃ e : ((SheafOfModules.toSheaf (wcEtZModRing X n)).obj (I.cocomplex.X (b - 1))).obj.obj (Opposite.op ((wcZarToEt X).obj W)), (((SheafOfModules.toSheaf (wcEtZModRing X n)).obj (I.cocomplex.X (b - 1))).obj.map ((wcZarToEt X).map (homOfLE (inf_le_lef