  have hT : ∀ (T : X.Etale) (P' : ((T.left).Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (V' : X.Etale),
      IsEmpty (CostructuredArrow (wcEtSlice T).op (Opposite.op V')) →
