  obtain ⟨e, he, heM⟩ := huniv (𝟙 (Spec (.of K))) (1 : Matrix (Fin c) (Fin c) Γ(Spec (.of K), ⊤))
    (by rw [Matrix.det_one]; exact isUnit_one)
  have hσ : AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) ≫ e)
