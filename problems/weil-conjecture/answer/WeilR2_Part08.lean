theorem wc_et_supp_ext_vanish_iff_cocycle : ∀ {Y ZY : Scheme.{u}} (iY : ZY ⟶ Y) [IsClosedImmersion iY] (n : ℕ) (DY : wcEtPullData iY n) (O : Y.Opens), (O : Set Y) = (Set.range iY)ᶜ → wcSuppIn Y (O : Set Y) ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (Limits.kernel (wcEtSuppUnitMap DY))) → ∀ (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y n))) (b : ℕ), (∀ t : wcEtSuppExt DY b, t = 0) ↔ (∀ c : ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (I.cocomplex.X b)).obj.obj (Opposite.op ((wcZarToEt Y).obj ⊤)), (((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (I.cocomplex.X b)).obj.map ((wcZarToEt Y).map (homOfLE (inf_le_left : ⊤ ⊓ O ≤ ⊤))).op).hom c = 0 → (((SheafOfModules.toSheaf (wcEtZModRing Y n)).map (I.cocomplex.d b (b + 1))).hom.app (Opposite.op ((wcZarToEt Y).obj ⊤))).hom c = 0 → ∃ e : ((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (I.cocomplex.X (b - 1))).obj.obj (Opposite.op ((wcZarToEt Y).obj ⊤)), (((SheafOfModules.toSheaf (wcEtZModRing Y n)).obj (I.cocomplex.X (b - 1))).obj.map ((wcZarToEt Y).map (homOfLE (inf_le_left : ⊤ ⊓ O ≤ ⊤))).op).hom e = 0 ∧ (((SheafOfModules.toSheaf (wcEtZModRing Y n)).map (I.cocomplex.d (b - 1) b)).hom.app (Opposite.op ((wcZarToEt Y).obj ⊤))).hom e = c) :=
