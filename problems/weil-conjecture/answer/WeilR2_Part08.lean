      _ = (((ZMod.cast c : ℤ)) : ZMod ℓ) := (ZMod.intCast_zmod_cast c).symm
      _ = _ := (map_intCast (LocallyConstant.evalRingHom y :
          LocallyConstant V₁.left (ZMod ℓ) →+* ZMod ℓ) (ZMod.cast c : ℤ)).symm

  have hcl : ∀ (V : X.Etale) (σ : V.left ⟶ Y') (hσ : σ ≫ p = V.hom),
      IsClosed (Set.range (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ
        (by rw [Category.id_comp, hσ]))) := by
    intro V σ hσ
    haveI : IsClosedImmersion (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ
        (by rw [Category.id_comp, hσ]) ≫ Limits.pullback.fst V.hom p) := by
      rw [Limits.pullback.lift_fst]
      infer_instance
    haveI : IsClosedImmersion (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ
        (by rw [Category.id_comp, hσ])) :=
      IsClosedImmersion.of_comp _ (Limits.pullback.fst V.hom p)
