    exact hinj.bijective_of_nat_card_le (by rw [hT, hS])
  haveI := wc_et_isIso_of_geom_stalks_bijective X ψ hbij
  exact ⟨(asIso ψ).symm⟩

theorem wc_et_gm_push_higher_zero : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [LocallyOfFiniteType fX] (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) (q : ℕ), 2 ≤ q → Limits.IsZero ((((wcEtPush (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) :=
