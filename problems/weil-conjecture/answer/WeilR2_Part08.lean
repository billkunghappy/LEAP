  have hclosed : IsClosed ({ã (IsLocalRing.closedPoint B)} : Set (wcHalA1 (b ≫ s))) :=
    wc_tube_lift_point_closed K A s x hx A' b pr hprg hprsnd (ã (IsLocalRing.closedPoint B)) hprx hg'x

  have htpt : (qB ≫ ã) (IsLocalRing.closedPoint (AlgebraicClosure ((wcHalA1 s).residueField x))) =
