  have S3 : ∀ (K : Type u) [Field K] (n : ℕ) (V : Scheme.{u}) (fV : V ⟶ Spec (.of K)) (t : Fin (n + 1) → Γ(V, ⊤)),
      Ideal.span (Set.range t) = ⊤ →
      ∃ φ : V ⟶ wcProjK K n, φ ≫ wcProjKStr K n = fV ∧ (∀ J, φ ⁻¹ᵁ wcSgD K n J = V.basicOpen (t J)) ∧
        ∀ J L (O : V.Opens) (hO : O ≤ φ ⁻¹ᵁ wcSgD K n J), φ.appLE (wcSgD K n J) O hO (wcSgE K n J L) *
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t J) =
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (t L) := by
    intro K _ N V fV s hspan
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hX : ∀ J : Fin (N + 1), (MvPolynomial.X J : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun J =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)
    let F : MvPolynomial (Fin (N + 1)) K →+* Γ(V, ⊤) :=
      MvPolynomial.eval₂Hom (fV.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) s
    have hFX : ∀ J, F (MvPolynomial.X J) = s J := fun J => MvPolynomial.eval₂Hom_X' _ _ J
    have hF : (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal.map F = ⊤ := by
      rw [eq_top_iff, ← hspan, Ideal.span_le]
      rintro _ ⟨J, rfl⟩
      rw [← hFX J]
      apply Ideal.mem_map_of_mem
      exact (HomogeneousIdeal.mem_irrelevant_iff _ _).mpr (by
        rw [GradedRing.proj_apply]
        exact DirectSum.decompose_of_mem_ne _ (hX J) one_ne_zero)
    refine ⟨Proj.fromOfGlobalSections _ F hF, ?_, fun J => ?_, fun J L O hO => ?_⟩
    · have h1 := Proj.fromOfGlobalSections_toSpecZero
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) F hF
      have hc : CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)) ≫
          CommRingCat.ofHom (F.comp (algebraMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)
            (MvPolynomial (Fin (N + 1)) K))) = (Scheme.ΓSpecIso (.of K)).inv ≫ fV.appTop := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro k
        show F (MvPolynomial.C k) = fV.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom k)
        exact MvPolynomial.eval₂Hom_C _ _ k
      have h2 : (Spec (.of K)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv = 𝟙 _ := by
        rw [← Scheme.isoSpec_hom, Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
      calc Proj.fromOfGlobalSections _ F hF ≫ (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0))))
          = (Proj.fromOfGlobalSections _ F hF ≫
              Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)) ≫
              Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) :=
            (Category.assoc _ _ _).symm
        _ = V.toSpecΓ ≫ (Spec.map (CommRingCat.ofHom (F.comp (algebraMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)
              (MvPolynomial (Fin (N + 1)) K)))) ≫
              Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))) := by
            rw [h1, Category.assoc]
        _ = V.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of K)).inv ≫ fV.appTop) := by
            rw [← Spec.map_comp, hc]
        _ = (V.toSpecΓ ≫ Spec.map fV.appTop) ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv := by
            rw [Spec.map_comp, Category.assoc]
        _ = fV ≫ ((Spec (.of K)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv) := by
            rw [← Scheme.toSpecΓ_naturality, Category.assoc]
        _ = fV := by rw [h2, Category.comp_id]
    · rw [← hFX J]
      exact Proj.fromOfGlobalSections_preimage_basicOpen _ F hF Nat.one_pos (hX J)
    · have hy : (MvPolynomial.X L : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := by
        rw [one_smul]
        exact hX L
      have h := s3 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) V F hF Nat.one_pos (hX J) 1
        (MvPolynomial.X L) hy
      rw [hFX, hFX, pow_one] at h
      have e := congrArg (V.presheaf.map (homOfLE hO).op) h
      rw [map_mul, hres, hres] at e
      exact e

  have hAmap : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V : B.Opens) (O1 O2 : A.Opens) (h12 : O2 ≤ O1)
      (e1 : O1 ≤ f ⁻¹ᵁ V) (e2 : O2 ≤ f ⁻¹ᵁ V) (x : Γ(B, V)),
      A.presheaf.map (homOfLE h12).op (f.appLE V O1 e1 x) = f.appLE V O2 e2 x := by
    intro A B f V O1 O2 h12 e1 e2 x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_map]
  have hmapA : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V V' : B.Opens) (O : A.Opens) (hVV : V ≤ V')
      (e : O ≤ f ⁻¹ᵁ V) (e' : O ≤ f ⁻¹ᵁ V') (x : Γ(B, V')),
      f.appLE V O e (B.presheaf.map (homOfLE hVV).op x) = f.appLE V' O e' x := by
    intro A B f V V' O hVV e e' x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]

  have RU : ∀ (R : Type u) [CommRing R] (m : ℕ) (σ σ' c c' : Fin (m + 1) → R) (w β β' : R),
      IsUnit w → β ∈ nonZeroDivisors R → ∑ l, c l * σ l = 1 → ∑ l, c' l * σ' l = 1 →
      (∀ l, σ' l * β' = w * (σ l * β)) → ∃ v : R, IsUnit v ∧ ∀ l, σ' l = v * σ l := by
    intro R _ m σ σ' c c' w β β' hw hβ hc hc' hrel
    obtain ⟨wi, hwi⟩ := hw.exists_left_inv
    have h1 : β' = (w * ∑ l, c' l * σ l) * β := by
      calc β' = (∑ l, c' l * σ' l) * β' := by rw [hc', one_mul]
        _ = ∑ l, c' l * (σ' l * β') := by
            rw [Finset.sum_mul]; exact Finset.sum_congr rfl (fun l _ => by ring)
        _ = ∑ l, c' l * (w * (σ l * β)) := Finset.sum_congr rfl (fun l _ => by rw [hrel l])
        _ = _ := by
            rw [Finset.mul_sum, Finset.sum_mul]; exact Finset.sum_congr rfl (fun l _ => by ring)
    have hrel' : ∀ l, σ l * β = wi * (σ' l * β') := fun l => by
      rw [hrel l, ← mul_assoc, hwi, one_mul]
    have h2 : β = (wi * ∑ l, c l * σ' l) * β' := by
      calc β = (∑ l, c l * σ l) * β := by rw [hc, one_mul]
        _ = ∑ l, c l * (σ l * β) := by
            rw [Finset.sum_mul]; exact Finset.sum_congr rfl (fun l _ => by ring)
        _ = ∑ l, c l * (wi * (σ' l * β')) := Finset.sum_congr rfl (fun l _ => by rw [hrel' l])
        _ = _ := by
            rw [Finset.mul_sum, Finset.sum_mul]; exact Finset.sum_congr rfl (fun l _ => by ring)
    generalize w * ∑ l, c' l * σ l = u at h1
    generalize wi * ∑ l, c l * σ' l = u' at h2
    have h3 : u' * u = 1 := by
      have h0 : (u' * u - 1) * β = 0 := by
        rw [sub_mul, one_mul, mul_assoc, ← h1, ← h2, sub_self]
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hβ).mp h0)
    have h4 : ∀ l, σ' l * u = w * σ l := by
      intro l
      apply (mul_cancel_right_mem_nonZeroDivisors hβ).mp
      rw [mul_assoc (σ' l), ← h1, hrel l, mul_assoc]
    refine ⟨w * u', hw.mul (isUnit_iff_exists_inv.mpr ⟨u, h3⟩), fun l => ?_⟩
    calc σ' l = σ' l * (u' * u) := by rw [h3, mul_one]
      _ = (σ' l * u) * u' := by ring
      _ = w * u' * σ l := by rw [h4 l]; ring

  intro K _ X fX I n m U hU g w hcov hI hw htr T h hP

  have NZR : ∀ (W O : T.Opens) (hOW : O ≤ W), IsAffineOpen W → ∀ b : Γ(T, W),
      b ∈ nonZeroDivisors Γ(T, W) → T.presheaf.map (homOfLE hOW).op b ∈ nonZeroDivisors Γ(T, O) := by
    intro W O hOW hW b hb
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    refine TopCat.Presheaf.section_ext T.sheaf O x 0 (fun p hp => ?_)
    obtain ⟨f, hfO, hpf⟩ := hW.exists_basicOpen_le (V := O) ⟨p, hp⟩ (hOW hp)
    letI : Algebra Γ(T, W) Γ(T, T.basicOpen f) :=
      (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom.toAlgebra
    have hL : IsLocalization.Away f Γ(T, T.basicOpen f) := hW.isLocalization_basicOpen f
    have hy0 : T.presheaf.map (homOfLE hfO).op x = 0 := by
      obtain ⟨⟨z, s⟩, hz⟩ := IsLocalization.surj (Submonoid.powers f)
        (T.presheaf.map (homOfLE hfO).op x)
      have hab : ∀ a : Γ(T, W), algebraMap Γ(T, W) Γ(T, T.basicOpen f) a =
          T.presheaf.map (homOfLE (T.basicOpen_le f)).op a := fun a => rfl
      have h1 : algebraMap Γ(T, W) Γ(T, T.basicOpen f) (z * b) = 0 := by
        have e : algebraMap Γ(T, W) Γ(T, T.basicOpen f) (z * b) =
            T.presheaf.map (homOfLE hfO).op (x * T.presheaf.map (homOfLE hOW).op b) *
              algebraMap Γ(T, W) Γ(T, T.basicOpen f) (s : Γ(T, W)) := by
          rw [map_mul, ← hz, hab b, ← hres T W O _ hOW hfO (T.basicOpen_le f) b, map_mul]
          ring
        rw [e, hx, map_zero, zero_mul]
      obtain ⟨c, hc⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers f) _ _).mp h1
      have h2 : (c : Γ(T, W)) * z = 0 := by
        apply (mul_right_mem_nonZeroDivisors_eq_zero_iff hb).mp
        rw [mul_assoc]; exact hc
      have h3 : algebraMap Γ(T, W) Γ(T, T.basicOpen f) z = 0 := by
        have hu := IsLocalization.map_units Γ(T, T.basicOpen f) c
        apply (hu.mul_right_eq_zero).mp
        rw [← map_mul, h2, map_zero]
      have hu := IsLocalization.map_units Γ(T, T.basicOpen f) s
      rw [h3] at hz
      exact (hu.mul_left_eq_zero).mp hz
    have hg := TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE hfO) p hpf x
    rw [hy0, map_zero] at hg
    exact hg.symm.trans (map_zero _).symm

  have hpt : ∀ t : T, ∃ J, h t ∈ U J := by
    intro t
    have hx : h t ∈ (⨆ J, U J) := by rw [hcov]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp hx
  choose Jt hJt using hpt

  have LOC : ∀ t : T, ∃ (W : T.Opens) (_ : IsAffineOpen W) (hW : W ≤ h ⁻¹ᵁ U (Jt t)) (b : Γ(T, W)),
      t ∈ W ∧ b ∈ nonZeroDivisors Γ(T, W) ∧
      Ideal.map (h.appLE (U (Jt t)) W hW).hom (I.ideal ⟨U (Jt t), hU (Jt t)⟩) = Ideal.span {b} := by
    intro t
    obtain ⟨U₁, V₁, e₁, a₁, htV, -, hnzd, hId⟩ := hP t
    have hD0 : h t ∈ U₁.1 ⊓ U (Jt t) := TopologicalSpace.Opens.mem_inf.mpr ⟨e₁ htV, hJt t⟩
    obtain ⟨D, hDa, hDt, hDsub⟩ := exists_isAffineOpen_mem_and_subset hD0
    have hDU₁ : D ≤ U₁.1 := fun x hx => (TopologicalSpace.Opens.mem_inf.mp (hDsub hx)).1
    have hDU : D ≤ U (Jt t) := fun x hx => (TopologicalSpace.Opens.mem_inf.mp (hDsub hx)).2
    have htVD : t ∈ V₁.1 ⊓ h ⁻¹ᵁ D := TopologicalSpace.Opens.mem_inf.mpr ⟨htV, hDt⟩
    obtain ⟨f, hfle, htf⟩ := V₁.2.exists_basicOpen_le (V := V₁.1 ⊓ h ⁻¹ᵁ D) ⟨t, htVD⟩ htV
    have hWV : T.basicOpen f ≤ V₁.1 := le_trans hfle inf_le_left
    have eD : T.basicOpen f ≤ h ⁻¹ᵁ D := le_trans hfle inf_le_right
    have hW : T.basicOpen f ≤ h ⁻¹ᵁ U (Jt t) := le_trans eD (Scheme.Hom.preimage_mono h hDU)
    have e₁' : T.basicOpen f ≤ h ⁻¹ᵁ U₁.1 := le_trans eD (Scheme.Hom.preimage_mono h hDU₁)
    refine ⟨T.basicOpen f, V₁.2.basicOpen f, hW,
      T.presheaf.map (homOfLE hWV).op ((h.appLE U₁.1 V₁.1 e₁).hom a₁), htf,
      NZR _ _ hWV V₁.2 _ hnzd, ?_⟩
    have key : ∀ (Y : X.affineOpens) (hDY : D ≤ Y.1) (eY : T.basicOpen f ≤ h ⁻¹ᵁ Y.1),
        Ideal.map (h.appLE Y.1 (T.basicOpen f) eY).hom (I.ideal Y) =
          Ideal.map (h.appLE D (T.basicOpen f) eD).hom (I.ideal ⟨D, hDa⟩) := by
      intro Y hDY eY
      have hfac : h.appLE Y.1 (T.basicOpen f) eY =
          X.presheaf.map (homOfLE hDY).op ≫ h.appLE D (T.basicOpen f) eD :=
        (Scheme.Hom.map_appLE h eD (homOfLE hDY).op).symm
      rw [hfac, CommRingCat.hom_comp, ← Ideal.map_map]
      congr 1
      exact I.map_ideal (U := ⟨D, hDa⟩) (V := Y) hDY
    have k1 : Ideal.map (h.appLE (U (Jt t)) (T.basicOpen f) hW).hom (I.ideal ⟨U (Jt t), hU (Jt t)⟩) =
        Ideal.map (h.appLE D (T.basicOpen f) eD).hom (I.ideal ⟨D, hDa⟩) :=
      key ⟨U (Jt t), hU (Jt t)⟩ hDU hW
    have k2 : Ideal.map (h.appLE U₁.1 (T.basicOpen f) e₁').hom (I.ideal U₁) =
        Ideal.map (h.appLE D (T.basicOpen f) eD).hom (I.ideal ⟨D, hDa⟩) := key U₁ hDU₁ e₁'
    have hfac2 : h.appLE U₁.1 (T.basicOpen f) e₁' =
        h.appLE U₁.1 V₁.1 e₁ ≫ T.presheaf.map (homOfLE hWV).op :=
      (Scheme.Hom.appLE_map h e₁ (homOfLE hWV).op).symm
    rw [k1, ← k2, hfac2, CommRingCat.hom_comp, ← Ideal.map_map, hId, Ideal.map_span,
      Set.image_singleton]
    try rfl
  choose W hWa hW b htW hbnzd hId using LOC

  have COF : ∀ t, ∃ σ c : Fin (m + 1) → Γ(T, W t),
      (∀ l, h.appLE (U (Jt t)) (W t) (hW t) (g (Jt t) l) = σ l * b t) ∧ ∑ l, c l * σ l = 1 := by
    intro t
    have H := hId t
    rw [hI (Jt t), Ideal.map_span, ← Set.range_comp] at H
    have hσ : ∀ l, ∃ s, s * b t = h.appLE (U (Jt t)) (W t) (hW t) (g (Jt t) l) := by
      intro l
      have hm : (h.appLE (U (Jt t)) (W t) (hW t)).hom (g (Jt t) l) ∈ Ideal.span {b t} := by
        rw [← H]; exact Ideal.subset_span ⟨l, rfl⟩
      exact Ideal.mem_span_singleton'.mp hm
    choose σ hσ using hσ
    have hb : b t ∈ Ideal.span (Set.range ((h.appLE (U (Jt t)) (W t) (hW t)).hom ∘ g (Jt t))) := by
      rw [H]; exact Ideal.mem_span_singleton_self _
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hb
    refine ⟨σ, c, fun l => (hσ l).symm, ?_⟩
    have e : (∑ l, c l * σ l - 1) * b t = 0 := by
      rw [sub_mul, one_mul, Finset.sum_mul, sub_eq_zero]
      conv_rhs => rw [← hc]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      show c l * σ l * b t = c l * h.appLE (U (Jt t)) (W t) (hW t) (g (Jt t) l)
      rw [mul_assoc, hσ l]
    exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff (hbnzd t)).mp e)
  choose σ c hσ hc using COF

  have TU : ∀ t t', ∃ v : Γ(T, W t ⊓ W t'), IsUnit v ∧ ∀ l,
      T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (σ t' l) =
        v * T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (σ t l) := by
    intro t t'
    have e : W t ⊓ W t' ≤ h ⁻¹ᵁ (U (Jt t) ⊓ U (Jt t')) := by
      rw [Scheme.Hom.preimage_inf]; exact inf_le_inf (hW t) (hW t')
    have PT : ∀ l, T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op
          (h.appLE (U (Jt t')) (W t') (hW t') (g (Jt t') l)) =
        h.appLE (U (Jt t) ⊓ U (Jt t')) (W t ⊓ W t') e (w (Jt t) (Jt t')) *
          T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op
            (h.appLE (U (Jt t)) (W t) (hW t) (g (Jt t) l)) := by
      intro l
      rw [hAmap h (U (Jt t')) (W t') (W t ⊓ W t') inf_le_right (hW t') (le_trans inf_le_right (hW t')),
        hAmap h (U (Jt t)) (W t) (W t ⊓ W t') inf_le_left (hW t) (le_trans inf_le_left (hW t)),
        ← hmapA h (U (Jt t) ⊓ U (Jt t')) (U (Jt t')) (W t ⊓ W t') inf_le_right e
          (le_trans inf_le_right (hW t')),
        htr, map_mul,
        hmapA h (U (Jt t) ⊓ U (Jt t')) (U (Jt t)) (W t ⊓ W t') inf_le_left e
          (le_trans inf_le_left (hW t))]
    have PT' : ∀ l, T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (σ t' l) *
          T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (b t') =
        h.appLE (U (Jt t) ⊓ U (Jt t')) (W t ⊓ W t') e (w (Jt t) (Jt t')) *
          (T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (σ t l) *
            T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (b t)) := by
      intro l
      have h0 := PT l
      rw [hσ t' l, hσ t l, map_mul, map_mul] at h0
      exact h0
    have hc1 : ∑ l, T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (c t l) *
        T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (σ t l) = 1 := by
      have h0 := congrArg (fun x => T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op x) (hc t)
      simpa only [map_sum, map_mul, map_one] using h0
    have hc2 : ∑ l, T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (c t' l) *
        T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (σ t' l) = 1 := by
      have h0 := congrArg (fun x => T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op x) (hc t')
      simpa only [map_sum, map_mul, map_one] using h0
    obtain ⟨v, hv, hvr⟩ := RU Γ(T, W t ⊓ W t') m
      (fun l => T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (σ t l))
      (fun l => T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (σ t' l))
      (fun l => T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (c t l))
      (fun l => T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (c t' l))
      (h.appLE (U (Jt t) ⊓ U (Jt t')) (W t ⊓ W t') e (w (Jt t) (Jt t')))
      (T.presheaf.map (homOfLE (inf_le_left : W t ⊓ W t' ≤ W t)).op (b t))
      (T.presheaf.map (homOfLE (inf_le_right : W t ⊓ W t' ≤ W t')).op (b t'))
      ((hw (Jt t) (Jt t')).map _) (NZR _ _ inf_le_left (hWa t) _ (hbnzd t)) hc1 hc2 PT'
    exact ⟨v, hv, hvr⟩
  choose v hv hvr using TU

  have haff : ∀ J : Fin (m + 1), IsAffineOpen (wcSgD K m J) := by
    intro J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) := MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)) Nat.one_pos
  have hgen' : ∀ (J : Fin (m + 1)) (x : Γ(wcProjK K m, wcSgD K m J)), x ∈ Subring.closure
      (Set.range (wcSgE K m J) ∪ Set.range (fun c : Γ(Spec (.of K), ⊤) => (wcProjK K m).presheaf.map
        (homOfLE (le_top : wcSgD K m J ≤ ⊤)).op ((wcProjKStr K m).appTop c))) := by
    intro J x
    refine Subring.closure_mono ?_ (S1 K m J x)
    rintro _ (⟨L, rfl⟩ | ⟨c, rfl⟩)
    · exact Or.inl ⟨L, rfl⟩
    · exact Or.inr ⟨_, rfl⟩
  have hcovW : (⨆ t, W t) = ⊤ :=
    eq_top_iff.mpr (fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, htW x⟩)
  have hspan : ∀ t, Ideal.span (Set.range (σ t)) = ⊤ := fun t =>
    Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_span_range_iff_exists_fun.mpr ⟨c t, hc t⟩) isUnit_one
  have hcovD0 : (⨆ a : Fin (m + 1), @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a)) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have hcovD : (⨆ a : Fin (m + 1), wcSgD K m a) = ⊤ := hcovD0
  obtain ⟨φ, hφ, hpre, hrel⟩ := PG (wcProjK K m) (Spec (.of K)) (wcProjKStr K m) (wcSgD K m) (wcSgE K m)
    hcovD (S3 K m) (fun W' g₁ g₂ t' hq hc' hg hg' hr hr' =>
      UQ _ _ _ (wcSgD K m) haff (wcSgE K m) hgen' W' g₁ g₂ t' hq hc' hg hg' hr hr')
    T (h ≫ fX) W hcovW σ hspan v hv hvr
  exact ⟨φ, Jt, W, hW, b, σ, hφ, fun t => ⟨hWa t, htW t, hbnzd t⟩, hσ, hpre, hrel⟩

theorem wc_csd_closed_lift_of_cover : ∀ (P Q T : Scheme.{u}) (ι : P ⟶ Q) (h : T ⟶ Q) {κ : Type u} (C : κ → Q.Opens), IsClosedImmersion ι → (∀ c, IsAffineOpen (C c)) → (⨆ c, C c) = ⊤ → (∀ c (y : Γ(Q, C c)), ι.app (C c) y = 0 → h.app (C c) y = 0) → ∃ h' : T ⟶ P, h' ≫ ι = h :=
by
  intro P Q T ι h κ C hι hC hcov hvan
  haveI := hι
  have nat : ∀ {V W : Q.Opens} (hle : V ≤ W) (z : Γ(Q, W)),
      h.app V (Q.presheaf.map (homOfLE hle).op z) =
        T.presheaf.map (homOfLE (h.preimage_mono hle)).op (h.app W z) := by
    intro V W hle z
    rw [← CategoryTheory.comp_apply, Scheme.Hom.naturality, CategoryTheory.comp_apply]
    rfl
  have H : ι.ker ≤ h.ker := by
    show ι.ker ≤ Scheme.IdealSheafData.ofIdeals (fun U => RingHom.ker (h.app U).hom)
    rw [Scheme.IdealSheafData.le_ofIdeals_iff]
    intro U y hy
    change (h.app U.1) y = 0
    refine TopCat.Presheaf.section_ext T.sheaf _ _ _ (fun t ht => ?_)
    have hqU : h.base t ∈ U.1 := ht
    have hq : h.base t ∈ (⨆ c, C c) := by rw [hcov]; trivial
    obtain ⟨c, hqC⟩ := TopologicalSpace.Opens.mem_iSup.mp hq
    obtain ⟨f, hf, hqf⟩ := U.2.exists_basicOpen_le (V := U.1 ⊓ C c) ⟨h.base t, ⟨hqU, hqC⟩⟩ hqU
    let D : Q.affineOpens := Q.affineBasicOpen f
    have hDU : D ≤ U := Q.basicOpen_le f
    have hDU0 : (D : Q.Opens) ≤ U.1 := Q.basicOpen_le f
    have hDC : (D : Q.Opens) ≤ C c := hf.trans inf_le_right
    let Cc : Q.affineOpens := ⟨C c, hC c⟩
    have hDC' : D ≤ Cc := hDC
    have key : h.app D.1 (Q.presheaf.map (homOfLE hDU0).op y) = 0 := by
      have h1 : Q.presheaf.map (homOfLE hDU0).op y ∈ ι.ker.ideal D := by
        rw [← ι.ker.map_ideal hDU]
        exact Ideal.mem_map_of_mem _ hy
      rw [← ι.ker.map_ideal hDC'] at h1
      have h2 : Q.presheaf.map (homOfLE hDU0).op y ∈ RingHom.ker (h.app D.1).hom := by
        refine (Ideal.map_le_iff_le_comap.mpr (fun z hz => ?_)) h1
        rw [Ideal.mem_comap, RingHom.mem_ker]
        have hz0 : ι.app (C c) z = 0 := Scheme.Hom.ideal_ker_le ι Cc hz
        have hz1 := hvan c z hz0
        have := nat hDC z
        rw [hz1, map_zero] at this
        exact this
      exact h2
    have htD : t ∈ h ⁻¹ᵁ D.1 := hqf
    have hg := TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE (h.preimage_mono hDU0)) t htD
      (h.app U.1 y)
    rw [← nat hDU0 y, key, map_zero] at hg
    exact hg.symm.trans (map_zero _).symm
  exact ⟨IsClosedImmersion.lift ι h H, IsClosedImmersion.lift_fac ι h H⟩

theorem wc_csd_nzd_restrict : ∀ (T : Scheme.{u}) (W O : T.Opens) (hOW : O ≤ W), IsAffineOpen W → ∀ b : Γ(T, W), b ∈ nonZeroDivisors Γ(T, W) → T.presheaf.map (homOfLE hOW).op b ∈ nonZeroDivisors Γ(T, O) :=
by
  intro T W O hOW hW b hb
  rw [mem_nonZeroDivisors_iff_right]
  intro x hx
  refine TopCat.Presheaf.section_ext T.sheaf _ _ _ (fun t ht => ?_)
  have hst := congrArg (T.presheaf.germ O t ht) hx
  rw [map_mul, map_zero, TopCat.Presheaf.germ_res_apply] at hst
  have hnz' : T.presheaf.germ W t (hOW ht) b ∈ nonZeroDivisors (T.presheaf.stalk t) := by
    letI := TopCat.Presheaf.algebra_section_stalk T.presheaf (⟨t, hOW ht⟩ : W)
    haveI := hW.isLocalization_stalk ⟨t, hOW ht⟩
    have hnz := IsLocalization.map_nonZeroDivisors_le
        (hW.primeIdealOf ⟨t, hOW ht⟩).asIdeal.primeCompl
        (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))
        (Submonoid.mem_map_of_mem
          (algebraMap Γ(T, W) (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))) hb)
    exact hnz
  show T.presheaf.germ O t ht x = T.presheaf.germ O t ht 0
  rw [map_zero]
  exact mem_nonZeroDivisors_iff_right.mp hnz' _ hst

theorem wc_csd_proj_uniq_of_relations : ∀ (K : Type u) [Field K] (n : ℕ) (T : Scheme.{u}) (W : T.Opens) (g g' : T ⟶ wcProjK K n) (t : Fin (n + 1) → Γ(T, W)), g ≫ wcProjKStr K n = g' ≫ wcProjKStr K n → (⨆ J, T.basicOpen (t J)) = W → (∀ J L (O : T.Opens) (hO : O ≤ g ⁻¹ᵁ wcSgD K n J) (hOW : O ≤ W), g.appLE (wcSgD K n J) O hO (wcSgE K n J L) * T.presheaf.map (homOfLE hOW).op (t J) = T.presheaf.map (homOfLE hOW).op (t L)) → (∀ J L (O : T.Opens) (hO : O ≤ g' ⁻¹ᵁ wcSgD K n J) (hOW : O ≤ W), g'.appLE (wcSgD K n J) O hO (wcSgE K n J L) * T.presheaf.map (homOfLE hOW).op (t J) = T.presheaf.map (homOfLE hOW).op (t L)) → W.ι ≫ g = W.ι ≫ g' :=
by
  intro K _ n T W g g' t hq hcov hr hr'

  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1), Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]

  have hBO : ∀ J L : Fin (n + 1), (wcProjK K n).basicOpen (wcSgE K n J L) = wcSgD K n J ⊓ wcSgD K n L := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    intro J L
    exact (L1 _ (MvPolynomial.X J) (MvPolynomial.X L) (hX J) (hX L)).symm
  have haffD : ∀ k, IsAffineOpen (wcSgD K n k) := by
    intro k
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X k)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)) Nat.one_pos

  have S1 : ∀ (K : Type u) [Field K] (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)),
      x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
        (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
    intro K _ n
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    intro J x
    have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
        have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
        simpa using this
      have scale : ∀ {L : Type u} [CommRing L] (χ : K →+* L) (g : Fin (n + 1) → L) (t : L),
          MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
        intro L _ χ g t
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun e he => ?_)
        have hdeg : ∑ i ∈ e.support, e i = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
        simp_rw [mul_pow]
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
        ring
      apply HomogeneousLocalization.val_injective
      rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
        MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      calc _ = MvPolynomial.eval₂
            ((algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))).comp
              MvPolynomial.C)
            (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
              (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))) F := by
            congr 1
            funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
        _ = _ := by
            rw [scale]
            have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))))
              MvPolynomial.C MvPolynomial.X F
            rw [MvPolynomial.eval₂_eta] at h2
            rw [show (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
                (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))) ∘
                MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
              ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
              Localization.r_iff_exists]
            refine ⟨1, ?_⟩
            simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow, ← pow_mul]
    have hι : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).Opens) a,
        U.ι.appTop a = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a) := by
      intro U a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ c : K, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (Submonoid.powers (MvPolynomial.X J)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)) ≤ ⊤)).op).hom ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
      intro c
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X J) (hX J) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).hom ≫ Proj.awayToSection _ (MvPolynomial.X J) ≫ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) := by rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X J)) ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hι] at e4
      have hinj : ∀ a b : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv a =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv b → a = b := by
        intro a b h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm
    have hs : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X J) ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x) = x := by
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos) x
      rwa [Proj.basicOpenIsoAway_hom] at this
    obtain ⟨d, F, hF, hmk⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J)
      ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x)
    rw [← hs, ← hmk, ← GEN J d F hF]
    change (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom _ ∈ _
    rw [MvPolynomial.eval₂_comp_left]
    apply MvPolynomial.eval₂_mem
    · intro i _
      apply Subring.subset_closure
      right
      exact ⟨F.coeff i, (hconst (F.coeff i)).symm⟩
    · intro l
      apply Subring.subset_closure
      left
      exact ⟨l, rfl⟩

  have hle : ∀ (h : T ⟶ wcProjK K n), (∀ J L (O : T.Opens) (hO : O ≤ h ⁻¹ᵁ wcSgD K n J) (hOW : O ≤ W),
      h.appLE (wcSgD K n J) O hO (wcSgE K n J L) * T.presheaf.map (homOfLE hOW).op (t J) =
        T.presheaf.map (homOfLE hOW).op (t L)) → ∀ J, T.basicOpen (t J) ≤ h ⁻¹ᵁ wcSgD K n J := by
    intro h hrel J x hx
    have hxW : x ∈ W := T.basicOpen_le (t J) hx
    have hcovD : (⨆ k, wcSgD K n k) = ⊤ := by
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
        MvPolynomial.gradedAlgebra
      refine Proj.iSup_basicOpen_eq_top _ _ ?_
      intro p hp
      have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          p).mp hp
      have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0 p =
          MvPolynomial.homogeneousComponent 0 p :=
        (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
      rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ]
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro e he
      rw [MvPolynomial.mem_support_iff] at he
      have hne : e ≠ 0 := by
        rintro rfl
        exact he h0
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
      exact ⟨i, Set.mem_univ i, by simpa using hi⟩
    obtain ⟨k, hk⟩ : ∃ k, h x ∈ wcSgD K n k := by
      have : h x ∈ (⨆ k, wcSgD K n k) := by rw [hcovD]; trivial
      exact TopologicalSpace.Opens.mem_iSup.mp this
    have e := hrel k J (h ⁻¹ᵁ wcSgD K n k ⊓ W) inf_le_left inf_le_right
    have e2 := congrArg T.basicOpen e
    simp only [Scheme.basicOpen_mul, Scheme.basicOpen_res, Scheme.basicOpen_appLE, hBO] at e2
    have hxO : x ∈ (h ⁻¹ᵁ wcSgD K n k ⊓ W) ⊓ T.basicOpen (t J) := ⟨⟨hk, hxW⟩, hx⟩
    rw [← e2] at hxO
    exact (show h ⁻¹ᵁ (wcSgD K n k ⊓ wcSgD K n J) ≤ h ⁻¹ᵁ wcSgD K n J from
      fun y hy => hy.2) hxO.1.2
  have hB := hle g hr
  have hB' := hle g' hr'

  have hchart : ∀ J, (T.basicOpen (t J)).ι ≫ g = (T.basicOpen (t J)).ι ≫ g' := by
    intro J
    have hconst : ∀ (h : T ⟶ wcProjK K n) (U : (wcProjK K n).Opens) (V : T.Opens) (e : V ≤ h ⁻¹ᵁ U)
        (x : Γ(wcProjK K n, ⊤)),
        h.appLE U V e ((wcProjK K n).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op x) =
          T.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (h.appTop x) := by
      intro h U V e x
      rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
      rfl
    rw [← Scheme.Hom.resLE_comp_ι g (hB J), ← Scheme.Hom.resLE_comp_ι g' (hB' J)]
    congr 1
    haveI : IsAffine (wcSgD K n J) := haffD J
    apply ext_of_isAffine
    show (g.resLE (wcSgD K n J) (T.basicOpen (t J)) (hB J)).app ⊤ =
      (g'.resLE (wcSgD K n J) (T.basicOpen (t J)) (hB' J)).app ⊤
    rw [Scheme.Hom.resLE_app_top, Scheme.Hom.resLE_app_top]
    congr 2
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro x
    refine RingHom.eqOn_set_closure (f := (g.appLE (wcSgD K n J) (T.basicOpen (t J)) (hB J)).hom)
      (g := (g'.appLE (wcSgD K n J) (T.basicOpen (t J)) (hB' J)).hom) ?_ (S1 K n J x)
    rintro _ (⟨L, rfl⟩ | ⟨c, rfl⟩)
    · have hu : IsUnit (T.presheaf.map (homOfLE (T.basicOpen_le (t J))).op (t J)) :=
        RingedSpace.isUnit_res_basicOpen _ _
      have e1 := hr J L _ (hB J) (T.basicOpen_le (t J))
      rw [← hr' J L _ (hB' J) (T.basicOpen_le (t J))] at e1
      exact (hu.mul_left_inj).mp e1
    · have hqc : g.appTop ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)) =
          g'.appTop ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)) := by
        have := congrArg (fun h => (Scheme.Hom.appTop h).hom ((Scheme.ΓSpecIso (.of K)).inv c)) hq
        simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using this
      show (g.appLE (wcSgD K n J) (T.basicOpen (t J)) (hB J))
          ((wcProjK K n).presheaf.map (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op
            ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c))) =
        (g'.appLE (wcSgD K n J) (T.basicOpen (t J)) (hB' J))
          ((wcProjK K n).presheaf.map (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op
            ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))
      rw [hconst, hconst, hqc]

  have hV : (⨆ J, W.ι ⁻¹ᵁ T.basicOpen (t J)) = ⊤ := by
    rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Opens.ι_preimage_self]
  apply Scheme.Cover.hom_ext (W.toScheme.openCoverOfIsOpenCover (fun J => W.ι ⁻¹ᵁ T.basicOpen (t J)) hV)
  refine fun (J : Fin (n + 1)) => ?_
  show (W.ι ⁻¹ᵁ T.basicOpen (t J)).ι ≫ W.ι ≫ g = (W.ι ⁻¹ᵁ T.basicOpen (t J)).ι ≫ W.ι ≫ g'
  rw [← Category.assoc, ← Category.assoc,
    ← Scheme.Hom.resLE_comp_ι W.ι (le_rfl : W.ι ⁻¹ᵁ T.basicOpen (t J) ≤ W.ι ⁻¹ᵁ T.basicOpen (t J)),
    Category.assoc, Category.assoc, hchart J]

theorem wc_csd_blowup_model : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [IsSeparated fX] (I : X.IdealSheafData) (n m : ℕ) (U : Fin (n + 1) → X.Opens) (hU : ∀ J, IsAffineOpen (U J)) (g : ∀ J, Fin (m + 1) → Γ(X, U J)) (w : ∀ J L, Γ(X, U J ⊓ U L)), (⨆ J, U J) = ⊤ → (∀ J, I.ideal ⟨U J, hU J⟩ = Ideal.span (Set.range (g J))) → (∀ J L, IsUnit (w J L)) → (∀ J L l, X.presheaf.map (homOfLE (inf_le_right : U J ⊓ U L ≤ U L)).op (g L l) = w J L * X.presheaf.map (homOfLE (inf_le_left : U J ⊓ U L ≤ U J)).op (g J l)) → ∃ (P : Scheme.{u}) (r : P ⟶ X) (ι : P ⟶ Limits.pullback fX (wcProjKStr K m)), IsClosedImmersion ι ∧ ι ≫ Limits.pullback.fst fX (wcProjKStr K m) = r ∧ wcCsdIsBlowup I r :=
by
  intro K _ X fX _ I n m U hU g w hcov hI hw htr
  obtain ⟨P, ι, hι, P1, P2, P3⟩ :=
    wc_csd_blowup_model_charts K X fX I n m U hU g w hcov hI hw htr
  haveI := hι
  have hres : ∀ (Y : Scheme.{u}) (A B C : Y.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (x : Γ(Y, A)), Y.presheaf.map (homOfLE h2).op (Y.presheaf.map (homOfLE h1).op x) =
        Y.presheaf.map (homOfLE h3).op x := by
    intro Y A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hAmap : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V : B.Opens) (O1 O2 : A.Opens) (h12 : O2 ≤ O1)
      (e1 : O1 ≤ f ⁻¹ᵁ V) (e2 : O2 ≤ f ⁻¹ᵁ V) (x : Γ(B, V)),
      A.presheaf.map (homOfLE h12).op (f.appLE V O1 e1 x) = f.appLE V O2 e2 x := by
    intro A B f V O1 O2 h12 e1 e2 x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_map]
  have hmapA : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (V V' : B.Opens) (O : A.Opens) (hVV : V ≤ V')
      (e : O ≤ f ⁻¹ᵁ V) (e' : O ≤ f ⁻¹ᵁ V') (x : Γ(B, V')),
      f.appLE V O e (B.presheaf.map (homOfLE hVV).op x) = f.appLE V' O e' x := by
    intro A B f V V' O hVV e e' x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.map_appLE]
  have hcompA : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (k : B ⟶ C) (V : C.Opens) (V' : B.Opens)
      (O : A.Opens) (e1 : V' ≤ k ⁻¹ᵁ V) (e2 : O ≤ f ⁻¹ᵁ V') (e3 : O ≤ (f ≫ k) ⁻¹ᵁ V)
      (x : Γ(C, V)), f.appLE V' O e2 (k.appLE V V' e1 x) = (f ≫ k).appLE V O e3 x := by
    intro A B C f k V V' O e1 e2 e3 x
    rw [← CategoryTheory.comp_apply, Scheme.Hom.appLE_comp_appLE]
  have hsub : ∀ {A B : Scheme.{u}} (f f' : A ⟶ B), f = f' → ∀ (V : B.Opens) (O : A.Opens)
      (e : O ≤ f ⁻¹ᵁ V) (e' : O ≤ f' ⁻¹ᵁ V) (x : Γ(B, V)), f.appLE V O e x = f'.appLE V O e' x := by
    intro A B f f' hff
    subst hff
    intro V O e e' x
    rfl
  have hcovD : (⨆ k, wcSgD K m k) = ⊤ := wc_pp_basicOpen_cover K m
  have haffD : ∀ k, IsAffineOpen (wcSgD K m k) := by
    intro k
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) :=
      MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X k)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)) Nat.one_pos
  have hpt : ∀ x : X, ∃ J, x ∈ U J := by
    intro x
    have hx : x ∈ (⨆ J, U J) := by rw [hcov]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp hx
  have hptD : ∀ y : wcProjK K m, ∃ k, y ∈ wcSgD K m k := by
    intro y
    have hy : y ∈ (⨆ k, wcSgD K m k) := by rw [hcovD]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp hy
  have hPaff : ∀ J k, IsAffineOpen ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J ⊓
      (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) := fun J k =>
    (wc_closed_in_product_chart_gen (Spec (.of K)) X (wcProjK K m) P fX (wcProjKStr K m) ι
      (U J) (wcSgD K m k) (hU J) (haffD k)).1
  have hQaff : ∀ J k, IsAffineOpen (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓
      Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) := by
    intro J k
    have h0 := (wc_closed_in_product_chart_gen (Spec (.of K)) X (wcProjK K m) _ fX (wcProjKStr K m)
      (𝟙 _) (U J) (wcSgD K m k) (hU J) (haffD k)).1
    rwa [Category.id_comp, Category.id_comp] at h0
  refine ⟨P, ι ≫ Limits.pullback.fst fX (wcProjKStr K m), ι, hι, rfl, ?_, ?_⟩
  · intro p
    obtain ⟨J, hJ⟩ := hpt ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) p)
    obtain ⟨k, hk⟩ := hptD ((ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) p)
    refine ⟨⟨U J, hU J⟩, ⟨_, hPaff J k⟩, inf_le_left, g J k,
      TopologicalSpace.Opens.mem_inf.mpr ⟨hJ, hk⟩, ?_, P1 J k, ?_⟩
    · rw [hI]; exact Ideal.subset_span ⟨k, rfl⟩
    · rw [hI, Ideal.map_span]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨_, ⟨l, rfl⟩, rfl⟩
        exact Ideal.mem_span_singleton'.mpr ⟨_, (P2 J k l).symm⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.subset_span ⟨g J k, ⟨k, rfl⟩, rfl⟩
  · intro T h hh
    obtain ⟨φ, Jt, W, hW, b, σ, hφ, hWb, hgσ, hpre, hrel⟩ :=
      wc_csd_invpull_proj_coords K X fX I n m U hU g w hcov hI hw htr T h hh
    obtain ⟨ht, hht1, hht2⟩ : ∃ ht : T ⟶ Limits.pullback fX (wcProjKStr K m),
        ht ≫ Limits.pullback.fst fX (wcProjKStr K m) = h ∧
          ht ≫ Limits.pullback.snd fX (wcProjKStr K m) = φ :=
      ⟨Limits.pullback.lift h φ hφ.symm, Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    subst hht2
    subst hht1
    have hvan : ∀ (J : Fin (n + 1)) (k : Fin (m + 1))
        (y : Γ(Limits.pullback fX (wcProjKStr K m), Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓
          Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k)),
        ι.app (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓
          Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) y = 0 →
        ht.app (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓
          Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) y = 0 := by
      intro J k y hy
      refine TopCat.Presheaf.section_ext T.sheaf _ _ _ (fun t htC => ?_)
      set O := ht ⁻¹ᵁ (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓
          Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) ⊓ W t with hOdef
      have hO_C : O ≤ ht ⁻¹ᵁ (Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U J ⊓
          Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m k) := inf_le_left
      have hO_W : O ≤ W t := inf_le_right
      have hO_J : O ≤ (ht ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U J := by
        refine le_trans hO_C ?_
        rw [Scheme.Hom.comp_preimage]
        exact Scheme.Hom.preimage_mono _ inf_le_left
      have hO_D : O ≤ (ht ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k := by
        refine le_trans hO_C ?_
        rw [Scheme.Hom.comp_preimage]
        exact Scheme.Hom.preimage_mono _ inf_le_right
      have hO_J' : O ≤ (ht ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U (Jt t) :=
        hO_W.trans (hW t)
      have hO_JJ : O ≤ (ht ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ (U (Jt t) ⊓ U J) := by
        rw [Scheme.Hom.preimage_inf]; exact le_inf hO_J' hO_J
      have key : T.presheaf.map (homOfLE hO_C).op (ht.app _ y) = 0 := by
        rw [Scheme.Hom.app_eq_appLE, hAmap ht _ _ O hO_C le_rfl hO_C y]
        refine P3 J k y hy _ (ht.appLE _ O hO_C).hom
          ((ht ≫ Limits.pullback.fst fX (wcProjKStr K m)).appLE (U (Jt t) ⊓ U J) O hO_JJ
              (w (Jt t) J) * T.presheaf.map (homOfLE hO_W).op (b t))
          (fun l => T.presheaf.map (homOfLE hO_W).op (σ t l)) ?_ ?_ ?_ ?_
        · intro l
          show (ht.appLE _ O hO_C) ((Limits.pullback.fst fX (wcProjKStr K m)).appLE (U J) _
            inf_le_left (g J l)) = _ * T.presheaf.map (homOfLE hO_W).op (σ t l)
          rw [hcompA ht (Limits.pullback.fst fX (wcProjKStr K m)) (U J) _ O inf_le_left hO_C hO_J
              (g J l),
            ← hmapA (ht ≫ Limits.pullback.fst fX (wcProjKStr K m)) (U (Jt t) ⊓ U J) (U J) O
              inf_le_right hO_JJ hO_J (g J l),
            htr (Jt t) J l, map_mul,
            hmapA (ht ≫ Limits.pullback.fst fX (wcProjKStr K m)) (U (Jt t) ⊓ U J) (U (Jt t)) O
              inf_le_left hO_JJ hO_J' (g (Jt t) l),
            ← hAmap (ht ≫ Limits.pullback.fst fX (wcProjKStr K m)) (U (Jt t)) (W t) O hO_W (hW t)
              hO_J' (g (Jt t) l),
            hgσ t l, map_mul]
          ring
        · intro l
          show (ht.appLE _ O hO_C) ((Limits.pullback.snd fX (wcProjKStr K m)).appLE (wcSgD K m k) _
            inf_le_right (wcSgE K m k l)) * T.presheaf.map (homOfLE hO_W).op (σ t k) =
              T.presheaf.map (homOfLE hO_W).op (σ t l)
          rw [hcompA ht (Limits.pullback.snd fX (wcProjKStr K m)) (wcSgD K m k) _ O inf_le_right
            hO_C hO_D (wcSgE K m k l)]
          exact hrel t k l O hO_D hO_W
        · exact mul_mem_nonZeroDivisors.mpr ⟨((hw (Jt t) J).map _).mem_nonZeroDivisors,
            wc_csd_nzd_restrict T (W t) O hO_W (hWb t).1 (b t) (hWb t).2.2⟩
        · have hOB : O ≤ T.basicOpen (σ t k) := by
            rw [← hpre t k]; exact le_inf hO_D hO_W
          have hu : IsUnit (T.presheaf.map (homOfLE (T.basicOpen_le (σ t k))).op (σ t k)) :=
            RingedSpace.isUnit_res_basicOpen _ _
          show IsUnit (T.presheaf.map (homOfLE hO_W).op (σ t k))
          rw [← hres T (W t) (T.basicOpen (σ t k)) O (T.basicOpen_le _) hOB hO_W]
          exact hu.map _
      have hg := TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE hO_C) t
        (TopologicalSpace.Opens.mem_inf.mpr ⟨htC, (hWb t).2.1⟩) (ht.app _ y)
      rw [key, map_zero] at hg
      exact hg.symm.trans (map_zero _).symm
    have hrelφ : ∀ h₀ : T ⟶ P, h₀ ≫ ι ≫ Limits.pullback.fst fX (wcProjKStr K m) =
        ht ≫ Limits.pullback.fst fX (wcProjKStr K m) → ∀ (t : T) (k l : Fin (m + 1)) (O : T.Opens)
        (hO : O ≤ (h₀ ≫ ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k)
        (hOW : O ≤ W t),
        (h₀ ≫ ι ≫ Limits.pullback.snd fX (wcProjKStr K m)).appLE (wcSgD K m k) O hO
            (wcSgE K m k l) * T.presheaf.map (homOfLE hOW).op (σ t k) =
          T.presheaf.map (homOfLE hOW).op (σ t l) := by
      intro h₀ e₀ t k l O hO hOW
      have A : O ≤ (h₀ ≫ ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U (Jt t) := by
        rw [e₀]; exact hOW.trans (hW t)
      have hO₁ : O ≤ h₀ ⁻¹ᵁ ((ι ≫ Limits.pullback.fst fX (wcProjKStr K m)) ⁻¹ᵁ U (Jt t) ⊓
          (ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ⁻¹ᵁ wcSgD K m k) := by
        rw [Scheme.Hom.preimage_inf, ← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage]
        exact le_inf A hO
      have e := congrArg (h₀.appLE _ O hO₁) (P2 (Jt t) k l)
      rw [map_mul, hcompA h₀ _ _ _ O _ hO₁ A, hcompA h₀ _ _ _ O _ hO₁ A,
        hcompA h₀ _ _ _ O _ hO₁ hO,
        hsub _ _ e₀ _ O A (hOW.trans (hW t)), hsub _ _ e₀ _ O A (hOW.trans (hW t)),
        ← hAmap _ _ (W t) O hOW (hW t) (hOW.trans (hW t)),
        ← hAmap _ _ (W t) O hOW (hW t) (hOW.trans (hW t)),
        hgσ, hgσ, map_mul, map_mul, ← mul_assoc] at e
      exact (mul_cancel_right_mem_nonZeroDivisors
        (wc_csd_nzd_restrict T (W t) O hOW (hWb t).1 (b t) (hWb t).2.2)).mp e.symm
    have huniq : ∀ h₁ h₂ : T ⟶ P, h₁ ≫ ι ≫ Limits.pullback.fst fX (wcProjKStr K m) =
        ht ≫ Limits.pullback.fst fX (wcProjKStr K m) →
        h₂ ≫ ι ≫ Limits.pullback.fst fX (wcProjKStr K m) =
        ht ≫ Limits.pullback.fst fX (wcProjKStr K m) → h₁ = h₂ := by
      intro h₁ h₂ e₁ e₂
      rw [← cancel_mono ι]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, e₁, e₂]
      · simp only [Category.assoc]
        have hWcov : (⨆ t, W t) = ⊤ :=
          eq_top_iff.mpr (fun x _ => TopologicalSpace.Opens.mem_iSup.mpr ⟨x, (hWb x).2.1⟩)
        apply Scheme.Cover.hom_ext (T.openCoverOfIsOpenCover W hWcov)
        refine fun (t : T) => ?_
        show (W t).ι ≫ h₁ ≫ ι ≫ Limits.pullback.snd fX (wcProjKStr K m) =
          (W t).ι ≫ h₂ ≫ ι ≫ Limits.pullback.snd fX (wcProjKStr K m)
        have k1 : ∀ h₀ : T ⟶ P, h₀ ≫ ι ≫ Limits.pullback.fst fX (wcProjKStr K m) =
            ht ≫ Limits.pullback.fst fX (wcProjKStr K m) →
            (h₀ ≫ ι ≫ Limits.pullback.snd fX (wcProjKStr K m)) ≫ wcProjKStr K m =
              ht ≫ Limits.pullback.fst fX (wcProjKStr K m) ≫ fX := by
          intro h₀ e₀
          rw [Category.assoc, Category.assoc, ← Limits.pullback.condition, ← Category.assoc ι,
            ← Category.assoc h₀, e₀, Category.assoc]
        have hsup : (⨆ k, T.basicOpen (σ t k)) = W t := by
          rw [← iSup_congr (hpre t), ← iSup_inf_eq, ← Scheme.Hom.preimage_iSup, hcovD,
            Scheme.Hom.preimage_top, top_inf_eq]
        exact wc_csd_proj_uniq_of_relations K m T (W t) _ _ (σ t)
          (by rw [k1 h₁ e₁, k1 h₂ e₂]) hsup (hrelφ h₁ e₁ t) (hrelφ h₂ e₂ t)
    have hcovQ : (⨆ c : ULift.{u} (Fin (n + 1) × Fin (m + 1)),
        Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U c.down.1 ⊓
          Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m c.down.2) = ⊤ := by
      refine eq_top_iff.mpr (fun q _ => ?_)
      obtain ⟨J, hJ⟩ := hpt (Limits.pullback.fst fX (wcProjKStr K m) q)
      obtain ⟨k, hk⟩ := hptD (Limits.pullback.snd fX (wcProjKStr K m) q)
      exact TopologicalSpace.Opens.mem_iSup.mpr
        ⟨⟨(J, k)⟩, TopologicalSpace.Opens.mem_inf.mpr ⟨hJ, hk⟩⟩
    obtain ⟨h', hh'⟩ := wc_csd_closed_lift_of_cover P _ T ι ht
      (fun c : ULift.{u} (Fin (n + 1) × Fin (m + 1)) =>
        Limits.pullback.fst fX (wcProjKStr K m) ⁻¹ᵁ U c.down.1 ⊓
          Limits.pullback.snd fX (wcProjKStr K m) ⁻¹ᵁ wcSgD K m c.down.2)
      hι (fun c => hQaff c.down.1 c.down.2) hcovQ (fun c y hy => hvan c.down.1 c.down.2 y hy)
    have hex : h' ≫ ι ≫ Limits.pullback.fst fX (wcProjKStr K m) =
        ht ≫ Limits.pullback.fst fX (wcProjKStr K m) := by
      rw [← Category.assoc, hh']
    exact ⟨h', hex, fun h₂ hh₂ => huniq h₂ h' hh₂ hex⟩

theorem wc_csd_tower_projective : ∀ (K : Type u) [Field K] (n : ℕ) (B : Scheme.{u}) (jB : B ⟶ wcProjK K n) (U : B.Opens) (X : Scheme.{u}) (q : X ⟶ B), IsClosedImmersion jB → wcCsdAdmTower B U X q → ∃ (N : ℕ) (j : X ⟶ wcProjK K N), IsClosedImmersion j ∧ j ≫ wcProjKStr K N = q ≫ jB ≫ wcProjKStr K n :=
by
  intro K _ n B jB U X q hjB htow

  have huniq : ∀ {Y Y' P : Scheme.{u}} (I : Y.IdealSheafData) (r : Y' ⟶ Y) (r₀ : P ⟶ Y),
      wcCsdIsBlowup I r → wcCsdIsBlowup I r₀ → ∃ α : Y' ⟶ P, α ≫ r₀ = r ∧ IsIso α := by
    intro Y Y' P I r r₀ hr hr₀
    obtain ⟨hr1, hr2⟩ := hr
    obtain ⟨hr₀1, hr₀2⟩ := hr₀
    obtain ⟨α, hα, -⟩ := hr₀2 Y' r hr1
    obtain ⟨β, hβ, -⟩ := hr2 P r₀ hr₀1
    obtain ⟨_, _, hu⟩ := hr2 Y' r hr1
    obtain ⟨_, _, hu₀⟩ := hr₀2 P r₀ hr₀1
    have h1 : α ≫ β = 𝟙 Y' :=
      (hu (α ≫ β) (by show (α ≫ β) ≫ r = r; rw [Category.assoc, hβ, hα])).trans
        (hu (𝟙 Y') (Category.id_comp r)).symm
    have h2 : β ≫ α = 𝟙 P :=
      (hu₀ (β ≫ α) (by show (β ≫ α) ≫ r₀ = r₀; rw [Category.assoc, hα, hβ])).trans
        (hu₀ (𝟙 P) (Category.id_comp r₀)).symm
    exact ⟨α, hα, ⟨⟨β, h1, h2⟩⟩⟩

  have hexist : ∀ (N : ℕ) (Y : Scheme.{u}) (j : Y ⟶ wcProjK K N) (I : Y.IdealSheafData),
      IsClosedImmersion j → ∃ (M : ℕ) (P : Scheme.{u}) (r₀ : P ⟶ Y) (j₀ : P ⟶ wcProjK K M),
        wcCsdIsBlowup I r₀ ∧ IsClosedImmersion j₀ ∧
          j₀ ≫ wcProjKStr K M = r₀ ≫ j ≫ wcProjKStr K N := by
    intro N Y j I hj
    haveI := hj
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
      MvPolynomial.gradedAlgebra
    haveI : IsProper (wcProjKStr K N) := wc_proj_space_isProper K N
    haveI : IsSeparated (j ≫ wcProjKStr K N) := inferInstance
    have hX : ∀ k : Fin (N + 1), (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    have hU : ∀ J : Fin (N + 1), IsAffineOpen (j ⁻¹ᵁ wcSgD K N J) := fun J =>
      IsAffineOpen.preimage (Proj.isAffineOpen_basicOpen _ _ (hX J) Nat.one_pos) j
    have h2 : (⨆ J : Fin (N + 1), wcSgD K N J) = ⊤ := wc_pp_basicOpen_cover K N
    have hcov : (⨆ J : Fin (N + 1), j ⁻¹ᵁ wcSgD K N J) = ⊤ := by
      rw [← Scheme.Hom.preimage_iSup, h2]
      first
        | rfl
        | exact Scheme.Hom.preimage_top j
        | simp
    obtain ⟨m, g, w, hg, hw, htr⟩ := wc_csd_blowup_chart_generators K N Y j I hj
    obtain ⟨P, r₀, ι, hι, hιr, hbl⟩ := wc_csd_blowup_model K Y (j ≫ wcProjKStr K N) I N m
      (fun J => j ⁻¹ᵁ wcSgD K N J) hU g w hcov (fun J => hg J (hU J)) hw htr
    haveI := hι
    haveI : MorphismProperty.IsStableUnderComposition @IsClosedImmersion :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hμ : IsClosedImmersion (Limits.pullback.map (j ≫ wcProjKStr K N) (wcProjKStr K m)
        (wcProjKStr K N) (wcProjKStr K m) j (𝟙 _) (𝟙 _) (by simp) (by simp)) :=
      MorphismProperty.pullbackMap (P := @IsClosedImmersion) hj inferInstance rfl
        (Category.id_comp _).symm
    haveI := hμ
    obtain ⟨M, σ, hσ, hσs⟩ := wc_pp_segre K N m
    haveI := hσ
    have hσs' : σ ≫ wcProjKStr K M =
        Limits.pullback.fst (wcProjKStr K N) (wcProjKStr K m) ≫ wcProjKStr K N := hσs
    have hμf : Limits.pullback.map (j ≫ wcProjKStr K N) (wcProjKStr K m)
        (wcProjKStr K N) (wcProjKStr K m) j (𝟙 _) (𝟙 _) (by simp) (by simp) ≫
          Limits.pullback.fst (wcProjKStr K N) (wcProjKStr K m) =
        Limits.pullback.fst (j ≫ wcProjKStr K N) (wcProjKStr K m) ≫ j :=
      Limits.pullback.lift_fst _ _ _
    refine ⟨M, P, r₀, ι ≫ Limits.pullback.map (j ≫ wcProjKStr K N) (wcProjKStr K m)
        (wcProjKStr K N) (wcProjKStr K m) j (𝟙 _) (𝟙 _) (by simp) (by simp) ≫ σ,
      hbl, inferInstance, ?_⟩
    rw [Category.assoc, Category.assoc, hσs', ← Category.assoc _
      (Limits.pullback.fst (wcProjKStr K N) (wcProjKStr K m)), hμf, Category.assoc,
      ← Category.assoc ι, hιr]

  induction htow with
  | base => exact ⟨n, jB, hjB, (Category.id_comp _).symm⟩
  | @step X₀ X' q₀ I r _ _ hbl ih =>
    obtain ⟨N, j, hj, hjq⟩ := ih
    obtain ⟨M, P, r₀, j₀, hbl₀, hj₀, hj₀s⟩ := hexist N X₀ j I hj
    obtain ⟨α, hα, hαi⟩ := huniq I r r₀ hbl hbl₀
    haveI := hj₀
    haveI := hαi
    refine ⟨M, α ≫ j₀, inferInstance, ?_⟩
    rw [Category.assoc, hj₀s, ← Category.assoc α r₀, hα, Category.assoc r q₀, hjq]

theorem wc_csd_blowup_iso_off_center : ∀ (X X' : Scheme.{u}) (I : X.IdealSheafData) (r : X' ⟶ X) (W : X.Opens), wcCsdIsBlowup I r → (I.support : Set X) ∩ (W : Set X) = ∅ → IsIso (r ∣_ W) :=
by
  intro X X' I r W hb hW
  obtain ⟨-, hUniq⟩ := hb

  have H : ∀ (T : Scheme.{u}) (h : T ⟶ X), (∀ t : T, h t ∉ (I.support : Set X)) →
      wcCsdInvPull I h := by
    intro T h hh t
    obtain ⟨U₀, hU₀, hxU₀, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := h t) trivial
    have hns : h t ∉ X.zeroLocus (U := U₀) (I.ideal ⟨U₀, hU₀⟩ : Set Γ(X, U₀)) := by
      rw [← Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U₀, hU₀⟩) hxU₀]
      exact hh t
    rw [Scheme.mem_zeroLocus_iff] at hns
    push_neg at hns
    obtain ⟨a, haI, hxa⟩ := hns
    have htD : t ∈ h ⁻¹ᵁ X.basicOpen a := (Scheme.Hom.mem_preimage h).mpr hxa
    obtain ⟨V₀, hV₀, htV₀, hV₀sub⟩ := exists_isAffineOpen_mem_and_subset htD
    have hVD : V₀ ≤ h ⁻¹ᵁ X.basicOpen a := hV₀sub
    have hVU : V₀ ≤ h ⁻¹ᵁ U₀ := hVD.trans (Scheme.Hom.preimage_mono h (X.basicOpen_le a))
    refine ⟨⟨U₀, hU₀⟩, ⟨V₀, hV₀⟩, hVU, a, htV₀, haI, ?_⟩
    have hbo : T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) = V₀ := by
      rw [Scheme.basicOpen_appLE]
      exact inf_eq_left.mpr hVD
    have hunit : IsUnit ((h.appLE U₀ V₀ hVU).hom a) := by
      apply RingedSpace.isUnit_of_isUnit_germ T.toRingedSpace V₀
      intro y hy
      have hy' : y ∈ T.basicOpen ((h.appLE U₀ V₀ hVU).hom a) := by rw [hbo]; exact hy
      exact (T.mem_basicOpen _ y hy).mp hy'
    refine ⟨hunit.mem_nonZeroDivisors, ?_⟩
    rw [Ideal.span_singleton_eq_top.mpr hunit]
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ haI) hunit
  have memι : ∀ (V : X'.Opens) (z : V.toScheme), V.ι z ∈ V := by
    intro V z
    have hz : V.ι z ∈ Set.range V.ι := ⟨z, rfl⟩
    rwa [Scheme.Opens.range_ι] at hz
  have memW : ∀ y : W.toScheme, W.ι y ∈ W := by
    intro y
    have hy : W.ι y ∈ Set.range W.ι := ⟨y, rfl⟩
    rwa [Scheme.Opens.range_ι] at hy
  have hWav : ∀ y : W.toScheme, W.ι y ∉ (I.support : Set X) := by
    intro y hy
    have hmem : W.ι y ∈ (I.support : Set X) ∩ (W : Set X) := ⟨hy, memW y⟩
    rw [hW] at hmem
    exact hmem
  obtain ⟨s, hs, -⟩ := hUniq W.toScheme W.ι (H _ _ hWav)
  have hrange : Set.range s ⊆ Set.range (r ⁻¹ᵁ W).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨y, rfl⟩
    show s y ∈ r ⁻¹ᵁ W
    rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, hs]
    exact memW y
  haveI : Mono W.ι := IsOpenImmersion.mono W.ι
  haveI : Mono (r ⁻¹ᵁ W).ι := IsOpenImmersion.mono (r ⁻¹ᵁ W).ι
  let s' := IsOpenImmersion.lift (r ⁻¹ᵁ W).ι s hrange
  have hs' : s' ≫ (r ⁻¹ᵁ W).ι = s := IsOpenImmersion.lift_fac _ _ _
  have h4 : s' ≫ (r ∣_ W) = 𝟙 _ := by
    rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, reassoc_of% hs', hs,
      Category.id_comp]
  have hιav : ∀ z : (r ⁻¹ᵁ W).toScheme, ((r ⁻¹ᵁ W).ι ≫ r) z ∉ (I.support : Set X) := by
    intro z hz
    have hz1 : (r ⁻¹ᵁ W).ι z ∈ r ⁻¹ᵁ W := memι (r ⁻¹ᵁ W) z
    rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply] at hz1
    have hmem : ((r ⁻¹ᵁ W).ι ≫ r) z ∈ (I.support : Set X) ∩ (W : Set X) := ⟨hz, hz1⟩
    rw [hW] at hmem
    exact hmem
  have hh := H _ _ hιav
  have h5 : (r ∣_ W) ≫ s' = 𝟙 _ := by
    rw [← cancel_mono (r ⁻¹ᵁ W).ι, Category.id_comp]
    apply (hUniq _ _ hh).unique
    · simp only [Category.assoc]
      rw [reassoc_of% hs', hs, morphismRestrict_ι]
    · rfl
  exact IsIso.mk ⟨s', h5, h4⟩

theorem wc_csd_dense_preimage_transfer : ∀ (X X' : Scheme.{u}) (r : X' ⟶ X) (W V : X.Opens), V ≤ W → Dense (V : Set X) → IsIso (r ∣_ W) → Dense ((r ⁻¹ᵁ W : X'.Opens) : Set X') → Dense ((r ⁻¹ᵁ V : X'.Opens) : Set X') :=
by
  intro X X' r W V _ hV hiso hW
  haveI : IsIso (r ∣_ W) := hiso
  have hj : IsOpenImmersion ((r ⁻¹ᵁ W).ι ≫ r) := by
    rw [← morphismRestrict_ι]; infer_instance
  have hopen : IsOpenMap ((r ⁻¹ᵁ W).ι ≫ r) := ((r ⁻¹ᵁ W).ι ≫ r).isOpenEmbedding.isOpenMap
  rw [dense_iff_inter_open] at hV hW ⊢
  intro O hO hOne
  obtain ⟨x', hx'O, hx'W⟩ := hW O hO hOne
  let y : (r ⁻¹ᵁ W).toScheme := ⟨x', hx'W⟩
  have hy : (r ⁻¹ᵁ W).ι y = x' := rfl
  have hyO : y ∈ (r ⁻¹ᵁ W).ι ⁻¹' O := by
    show (r ⁻¹ᵁ W).ι y ∈ O
    rw [hy]; exact hx'O
  have hT : IsOpen (((r ⁻¹ᵁ W).ι ≫ r) '' ((r ⁻¹ᵁ W).ι ⁻¹' O)) :=
    hopen _ (hO.preimage (r ⁻¹ᵁ W).ι.continuous)
  obtain ⟨z, ⟨y₁, hy₁O, rfl⟩, hzV⟩ := hV _ hT ⟨((r ⁻¹ᵁ W).ι ≫ r) y, y, hyO, rfl⟩
  refine ⟨(r ⁻¹ᵁ W).ι y₁, hy₁O, ?_⟩
  show r ((r ⁻¹ᵁ W).ι y₁) ∈ V
  rw [← Scheme.Hom.comp_apply]
  exact hzV

theorem wc_csd_invpull_compl_schem_dense : ∀ (X X' : Scheme.{u}) (I : X.IdealSheafData) (r : X' ⟶ X) (W : X.Opens), wcCsdInvPull I r → (W : Set X) = (I.support : Set X)ᶜ → (∀ O : X'.Opens, Function.Injective (X'.presheaf.map (homOfLE (inf_le_left : O ⊓ r ⁻¹ᵁ W ≤ O)).op)) ∧ Dense ((r ⁻¹ᵁ W : X'.Opens) : Set X') :=
by
  intro X X' I r W hinv hW

  have hloc : ∀ y : X', ∃ (V : X'.affineOpens) (c : Γ(X', V.1)), y ∈ V.1 ∧
      c ∈ nonZeroDivisors Γ(X', V.1) ∧ X'.basicOpen c ≤ r ⁻¹ᵁ W := by
    intro y
    obtain ⟨U, V, hVU, a, hyV, haI, hnzd, -⟩ := hinv y
    refine ⟨V, _, hyV, hnzd, ?_⟩
    rw [Scheme.basicOpen_appLE]
    intro x hx
    have hx2 : r x ∈ X.basicOpen a := hx.2
    show r x ∈ (W : Set X)
    rw [hW]
    intro hsupp
    have hU : r x ∈ (U.1 : Set X) := X.basicOpen_le a hx2
    have hz := (Scheme.IdealSheafData.mem_support_iff_of_mem hU).mp hsupp
    exact (X.mem_zeroLocus_iff _ _).mp hz a haI hx2

  have hcomp : ∀ {A B C : X'.Opens} (i : Opposite.op A ⟶ Opposite.op B)
      (j : Opposite.op B ⟶ Opposite.op C) (z : Γ(X', A)),
      (X'.presheaf.map j).hom ((X'.presheaf.map i).hom z) = (X'.presheaf.map (i ≫ j)).hom z := by
    intro A B C i j z
    rw [Functor.map_comp]
    rfl

  have hinj : ∀ O : X'.Opens,
      Function.Injective (X'.presheaf.map (homOfLE (inf_le_left : O ⊓ r ⁻¹ᵁ W ≤ O)).op) := by
    intro O
    have key : ∀ s : Γ(X', O),
        (X'.presheaf.map (homOfLE (inf_le_left : O ⊓ r ⁻¹ᵁ W ≤ O)).op).hom s = 0 → s = 0 := by
      intro s hs
      apply TopCat.Presheaf.section_ext X'.sheaf O s 0
      intro x hxO
      obtain ⟨V, c, hxV, hc, hcW⟩ := hloc x
      obtain ⟨f, hfO, hxf⟩ := V.2.exists_basicOpen_le (V := O) ⟨x, hxO⟩ hxV
      have hDV : X'.basicOpen f ≤ V.1 := X'.basicOpen_le f
      have hDaff : IsAffineOpen (X'.basicOpen f) := V.2.basicOpen f
      obtain ⟨c', hc'def⟩ : ∃ c' : Γ(X', X'.basicOpen f),
          c' = (X'.presheaf.map (homOfLE hDV).op).hom c := ⟨_, rfl⟩
      have hc' : c' ∈ nonZeroDivisors Γ(X', X'.basicOpen f) := by
        have := V.2.isLocalization_basicOpen f
        rw [hc'def]
        exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers f) Γ(X', X'.basicOpen f)
          ⟨c, hc, rfl⟩
      have hc'eq : X'.basicOpen c' = X'.basicOpen f ⊓ X'.basicOpen c := by
        rw [hc'def]
        exact X'.basicOpen_res c (homOfLE hDV).op
      have hle : X'.basicOpen c' ≤ O ⊓ r ⁻¹ᵁ W := by
        rw [hc'eq]
        exact le_inf (inf_le_left.trans hfO) (inf_le_right.trans hcW)
      obtain ⟨t, ht_def⟩ : ∃ t : Γ(X', X'.basicOpen f),
          t = (X'.presheaf.map (homOfLE hfO).op).hom s := ⟨_, rfl⟩
      have ht : (X'.presheaf.map (homOfLE (X'.basicOpen_le c')).op).hom t = 0 := by
        have e : (X'.presheaf.map (homOfLE (X'.basicOpen_le c')).op).hom t =
            (X'.presheaf.map (homOfLE hle).op).hom
              ((X'.presheaf.map (homOfLE (inf_le_left : O ⊓ r ⁻¹ᵁ W ≤ O)).op).hom s) := by
          rw [ht_def, hcomp, hcomp]
          rfl
        rw [e, hs, map_zero]
      obtain ⟨n, hn⟩ :=
        exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isAffineOpen X' hDaff t c' ht
      have ht0 : t = 0 := (mul_left_mem_nonZeroDivisors_eq_zero_iff (pow_mem hc' n)).mp hn
      have hg := TopCat.Presheaf.germ_res_apply X'.presheaf (homOfLE hfO) x hxf s
      show (X'.presheaf.germ O x hxO).hom s = (X'.presheaf.germ O x hxO).hom 0
      rw [map_zero]
      erw [← hg]
      rw [← ht_def, ht0, map_zero]
    intro a b hab
    have h0 := key (a - b) (by
      rw [map_sub]
      exact sub_eq_zero.mpr hab)
    exact sub_eq_zero.mp h0

  refine ⟨hinj, ?_⟩
  rw [dense_iff_inter_open]
  intro U hU hne
  by_contra hempty
  rw [Set.not_nonempty_iff_eq_empty] at hempty
  let O : X'.Opens := ⟨U, hU⟩
  have hbot : O ⊓ r ⁻¹ᵁ W = ⊥ := TopologicalSpace.Opens.ext hempty
  have : Nonempty O := (Scheme.Opens.nonempty_iff O).mpr hne
  have hnt : Nontrivial Γ(X', O) := X'.component_nontrivial O
  have hsub : Subsingleton Γ(X', O ⊓ r ⁻¹ᵁ W) := by
    rw [hbot]; infer_instance
  apply (one_ne_zero : (1 : Γ(X', O)) ≠ 0)
  apply hinj O
  exact Subsingleton.elim _ _

theorem wc_csd_bl_chart_algebra : ∀ (A : CommRingCat.{u}) [IsNoetherianRing A] (I : Ideal A) (a : A), a ∈ I → ∃ (R : CommRingCat.{u}) (φ : A ⟶ R), IsNoetherianRing R ∧ φ.hom a ∈ nonZeroDivisors R ∧ Ideal.map φ.hom I = Ideal.span {φ.hom a} ∧ ∀ (B : CommRingCat.{u}) (ρ : A ⟶ B), ρ.hom a ∈ nonZeroDivisors B → Ideal.map ρ.hom I = Ideal.span {ρ.hom a} → ∃! ψ : R ⟶ B, φ ≫ ψ = ρ :=
by
  intro A _ I a ha
  classical

  obtain ⟨s, hsfin, hs⟩ : ∃ s : Set A, s.Finite ∧ Ideal.span s = I := by
    obtain ⟨t, ht⟩ := (_root_.IsNoetherian.noetherian I : I.FG)
    exact ⟨t, t.finite_toSet, ht⟩
  have hsI : ∀ g ∈ s, g ∈ I := fun g hg => by
    rw [← hs]; exact Ideal.subset_span hg

  obtain ⟨L, _, _, _⟩ : ∃ (L : Type u) (_ : CommRing L) (_ : Algebra A L),
      IsLocalization.Away a L :=
    ⟨Localization.Away a, inferInstance, inferInstance, inferInstance⟩
  obtain ⟨inv, hinv⟩ : ∃ inv : L, algebraMap A L a * inv = 1 :=
    ⟨_, IsLocalization.Away.mul_invSelf a⟩
  obtain ⟨T, hTfin, hTK, hTmem⟩ : ∃ T : Set L, T.Finite ∧
      (∀ t ∈ T, ∃ g ∈ s, t * algebraMap A L a = algebraMap A L g) ∧
      ∀ g ∈ s, algebraMap A L g * inv ∈ T := by
    refine ⟨(fun g => algebraMap A L g * inv) '' s, hsfin.image _, ?_, fun g hg => ⟨g, hg, rfl⟩⟩
    rintro t ⟨g, hg, rfl⟩
    refine ⟨g, hg, ?_⟩
    show algebraMap A L g * inv * algebraMap A L a = algebraMap A L g
    rw [mul_assoc, mul_comm inv, hinv, mul_one]
  obtain ⟨R₀, hR₀⟩ : ∃ R₀ : Subalgebra A L, R₀ = Algebra.adjoin A T := ⟨_, rfl⟩

  have hR₀noeth : IsNoetherianRing R₀ := by
    have hfg : R₀.FG := Subalgebra.fg_def.mpr ⟨T, hTfin, hR₀.symm⟩
    have : Algebra.FiniteType A R₀ := (Subalgebra.fg_iff_finiteType R₀).mp hfg
    exact Algebra.FiniteType.isNoetherianRing A R₀
  have hmemR : ∀ x, x ∈ Algebra.adjoin A T → x ∈ R₀ := fun x hx => by rw [hR₀]; exact hx
  refine ⟨CommRingCat.of R₀, CommRingCat.ofHom (algebraMap A R₀), hR₀noeth, ?_, ?_, ?_⟩

  · show algebraMap A R₀ a ∈ nonZeroDivisors R₀
    rw [mem_nonZeroDivisors_iff]
    have key : ∀ z : R₀, algebraMap A R₀ a * z = 0 → z = 0 := by
      intro z hz
      apply Subtype.ext
      show (z : L) = 0
      have h1 : algebraMap A L a * (z : L) = 0 := congrArg Subtype.val hz
      calc (z : L) = (algebraMap A L a * inv) * z := by rw [hinv, one_mul]
        _ = inv * (algebraMap A L a * z) := by ring
        _ = 0 := by rw [h1, mul_zero]
    exact ⟨key, fun z hz => key z (by rw [mul_comm]; exact hz)⟩

  · show Ideal.map (algebraMap A R₀) I = Ideal.span {algebraMap A R₀ a}
    apply le_antisymm
    · rw [← hs, Ideal.map_span, Ideal.span_le]
      rintro _ ⟨g, hg, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_span_singleton']
      refine ⟨⟨algebraMap A L g * inv, hmemR _ (Algebra.subset_adjoin (hTmem g hg))⟩, ?_⟩
      apply Subtype.ext
      show algebraMap A L g * inv * algebraMap A L a = algebraMap A L g
      rw [mul_assoc, mul_comm inv, hinv, mul_one]
    · rw [Ideal.span_singleton_le_iff_mem]
      exact Ideal.mem_map_of_mem _ ha

  · intro B ρ hnz hid

    have uniq : ∀ ψ₁ ψ₂ : R₀ →+* B, (∀ x, ψ₁ (algebraMap A R₀ x) = ρ.hom x) →
        (∀ x, ψ₂ (algebraMap A R₀ x) = ρ.hom x) → ψ₁ = ψ₂ := by
      intro ψ₁ ψ₂ h1 h2
      ext ⟨z, hz⟩
      have hz' : z ∈ Algebra.adjoin A T := by rw [← hR₀]; exact hz
      revert hz
      induction hz' using Algebra.adjoin_induction with
      | mem x hx =>
        intro hz
        obtain ⟨g, hg, hxg⟩ := hTK x hx
        have e : (⟨x, hz⟩ : R₀) * algebraMap A R₀ a = algebraMap A R₀ g := Subtype.ext hxg
        have e1 := congrArg ψ₁ e
        have e2 := congrArg ψ₂ e
        simp only [map_mul, h1] at e1
        simp only [map_mul, h2] at e2
        have h0 := (mem_nonZeroDivisors_iff.mp hnz).2 (ψ₁ ⟨x, hz⟩ - ψ₂ ⟨x, hz⟩)
          (by rw [sub_mul, e1, e2, sub_self])
        exact sub_eq_zero.mp h0
      | algebraMap r =>
        intro hz
        have e : (⟨algebraMap A L r, hz⟩ : R₀) = algebraMap A R₀ r := rfl
        rw [e, h1, h2]
      | add x y hx hy ihx ihy =>
        intro hz
        have e : (⟨x + y, hz⟩ : R₀) = ⟨x, hmemR x hx⟩ + ⟨y, hmemR y hy⟩ := rfl
        rw [e, map_add, map_add, ihx, ihy]
      | mul x y hx hy ihx ihy =>
        intro hz
        have e : (⟨x * y, hz⟩ : R₀) = ⟨x, hmemR x hx⟩ * ⟨y, hmemR y hy⟩ := rfl
        rw [e, map_mul, map_mul, ihx, ihy]

    obtain ⟨LB, _, _, _⟩ : ∃ (LB : Type u) (_ : CommRing LB) (_ : Algebra B LB),
        IsLocalization.Away (ρ.hom a) LB :=
      ⟨Localization.Away (ρ.hom a), inferInstance, inferInstance, inferInstance⟩
    have hιB : Function.Injective (algebraMap B LB) :=
      IsLocalization.injective LB (Submonoid.powers_le.mpr hnz)
    have hu : IsUnit ((algebraMap B LB).comp ρ.hom a) :=
      IsLocalization.Away.algebraMap_isUnit (ρ.hom a)
    let ρ' : L →+* LB := IsLocalization.Away.lift a hu
    have hρ' : ∀ x, ρ' (algebraMap A L x) = algebraMap B LB (ρ.hom x) :=
      fun x => IsLocalization.Away.lift_eq a hu x
    have hu' : IsUnit (algebraMap B LB (ρ.hom a)) := hu
    have hrange : ∀ z, z ∈ Algebra.adjoin A T → ∃ b : B, algebraMap B LB b = ρ' z := by
      intro z hz
      induction hz using Algebra.adjoin_induction with
      | mem x hx =>
        obtain ⟨g, hg, hxg⟩ := hTK x hx
        have hgm : ρ.hom g ∈ Ideal.span {ρ.hom a} := by
          rw [← hid]; exact Ideal.mem_map_of_mem _ (hsI g hg)
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hgm
        refine ⟨c, ?_⟩
        have e1 : algebraMap B LB c * algebraMap B LB (ρ.hom a) = algebraMap B LB (ρ.hom g) := by
          rw [← map_mul, hc]
        have e2 : ρ' x * algebraMap B LB (ρ.hom a) = algebraMap B LB (ρ.hom g) := by
          rw [← hρ', ← hρ', ← map_mul, hxg]
        exact hu'.mul_left_inj.mp (e1.trans e2.symm)
      | algebraMap r => exact ⟨ρ.hom r, (hρ' r).symm⟩
      | add x y _ _ hx hy =>
        obtain ⟨b1, hb1⟩ := hx
        obtain ⟨b2, hb2⟩ := hy
        exact ⟨b1 + b2, by rw [map_add, map_add, hb1, hb2]⟩
      | mul x y _ _ hx hy =>
        obtain ⟨b1, hb1⟩ := hx
        obtain ⟨b2, hb2⟩ := hy
        exact ⟨b1 * b2, by rw [map_mul, map_mul, hb1, hb2]⟩
    choose f hf using hrange
    have hf' : ∀ z : R₀, algebraMap B LB (f z.1 (by rw [← hR₀]; exact z.2)) = ρ' z.1 :=
      fun z => hf _ _
    let ψ₀ : R₀ →+* B :=
      { toFun := fun z => f z.1 (by rw [← hR₀]; exact z.2)
        map_one' := hιB (by rw [hf']; simp)
        map_mul' := fun x y => hιB (by simp only [hf', map_mul]; simp)
        map_zero' := hιB (by rw [hf']; simp)
        map_add' := fun x y => hιB (by simp only [hf', map_add]; simp) }
    have hψ₀ : ∀ z : R₀, algebraMap B LB (ψ₀ z) = ρ' z.1 := fun z => hf' z
    have hψ₀alg : ∀ x, ψ₀ (algebraMap A R₀ x) = ρ.hom x := fun x =>
      hιB (by rw [hψ₀]; exact hρ' x)
    refine ⟨CommRingCat.ofHom ψ₀, ?_, ?_⟩
    · apply CommRingCat.hom_ext
      apply RingHom.ext
      intro x
      exact hψ₀alg x
    · intro ψ' hψ'
      apply CommRingCat.hom_ext
      show ψ'.hom = ψ₀
      apply uniq
      · intro x
        have := congrArg (fun φ' => φ'.hom x) hψ'
        exact this
      · exact hψ₀alg

theorem wc_csd_glue_local_universal : ∀ (X : Scheme.{u}) (K : Type u) (Y : K → Scheme.{u}) (p : ∀ k, Y k ⟶ X) (P : ∀ T : Scheme.{u}, (T ⟶ X) → Prop) (G : K → ∀ T : Scheme.{u}, (T ⟶ X) → Prop), (∀ (T T' : Scheme.{u}) (j : T' ⟶ T) [IsOpenImmersion j] (h : T ⟶ X), P T h → P T' (j ≫ h)) → (∀ (T : Scheme.{u}) (h : T ⟶ X), (∀ t : T, ∃ W : T.Opens, t ∈ W ∧ P W.toScheme (W.ι ≫ h)) → P T h) → (∀ (k : K) (T T' : Scheme.{u}) (j : T' ⟶ T) [IsOpenImmersion j] (h : T ⟶ X), G k T h → G k T' (j ≫ h)) → (∀ (k : K) (T : Scheme.{u}) (h : T ⟶ X), (∀ t : T, ∃ W : T.Opens, t ∈ W ∧ G k W.toScheme (W.ι ≫ h)) → G k T h) → (∀ (T : Scheme.{u}) (h : T ⟶ X), P T h → ∀ t : T, ∃ (k : K) (W : T.Opens), t ∈ W ∧ G k W.toScheme (W.ι ≫ h)) → (∀ k, G k (Y k) (p k)) → (∀ (k : K) (T : Scheme.{u}) (h : T ⟶ X), G k T h → P T h) → (∀ (k : K) (T : Scheme.{u}) (h : T ⟶ X), G k T h → ∃! c : T ⟶ Y k, c ≫ p k = h) → (∀ (k : K) (T : Scheme.{u}) (c : T ⟶ Y k), P T (c ≫ p k) → G k T (c ≫ p k)) → (∀ (k : K) (T T' : Scheme.{u}) (h : T ⟶ X) (g : T' ⟶ T), P T h → G k T' (g ≫ h) → ∀ t' : T', ∃ W : T.Opens, g t' ∈ W ∧ G k W.toScheme (W.ι ≫ h)) → ∃ (X' : Scheme.{u}) (r : X' ⟶ X) (s : ∀ k, Y k ⟶ X'), (P X' r ∧ ∀ (T : Scheme.{u}) (h : T ⟶ X), P T h → ∃! h' : T ⟶ X', h' ≫ r = h) ∧ (∀ k, IsOpenImmersion (s k)) ∧ (∀ k, s k ≫ r = p k) ∧ ∀ x : X', ∃ (k : K) (y : Y k), s k y = x :=
by
  intro X K Y p P G hPres hPloc hGres hGloc hCov hGp hGP hRep hInto hOpen
  classical

  have hUniq : ∀ (k : K) (T : Scheme.{u}) (c c' : T ⟶ Y k), P T (c ≫ p k) →
      c ≫ p k = c' ≫ p k → c = c' :=
    fun k T c c' hP he => (hRep k T _ (hInto k T c hP)).unique rfl he.symm

  obtain ⟨V, t, hVtop, hiv, hii, hLand⟩ : ∃ (V : ∀ k l : K, (Y k).Opens)
      (t : ∀ k l : K, (V k l).toScheme ⟶ (V l k).toScheme), (∀ k, V k k = ⊤) ∧
      (∀ k l, G l (V k l).toScheme ((V k l).ι ≫ p k)) ∧
      (∀ k l, t k l ≫ (V l k).ι ≫ p l = (V k l).ι ≫ p k) ∧
      (∀ (k l : K) (T : Scheme.{u}) (d : T ⟶ Y k), G l T (d ≫ p k) → ∀ x : T, d x ∈ V k l) := by
    have hH : ∀ (l : K) (T T' : Scheme.{u}) (h : T ⟶ X) (W : T.Opens) (a : T' ⟶ T)
        [IsOpenImmersion a], (∀ x, a x ∈ W) → G l W.toScheme (W.ι ≫ h) → G l T' (a ≫ h) := by
      intro l T T' h W a _ ha hW
      have H' : Set.range a ⊆ Set.range W.ι := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨x, rfl⟩
        exact ha x
      have hb := IsOpenImmersion.lift_fac W.ι a H'
      have : IsOpenImmersion (IsOpenImmersion.lift W.ι a H' ≫ W.ι) := by
        rw [hb]; infer_instance
      have : IsOpenImmersion (IsOpenImmersion.lift W.ι a H') := IsOpenImmersion.of_comp _ W.ι
      have := hGres l W.toScheme T' (IsOpenImmersion.lift W.ι a H') (W.ι ≫ h) hW
      rwa [← Category.assoc, hb] at this
    obtain ⟨V, hV⟩ : ∃ V : ∀ k l : K, (Y k).Opens,
        V = fun k l => sSup {W : (Y k).Opens | G l W.toScheme (W.ι ≫ p k)} := ⟨_, rfl⟩
    have hle : ∀ k l (W : (Y k).Opens), G l W.toScheme (W.ι ≫ p k) → W ≤ V k l := by
      intro k l W hW
      rw [hV]
      exact le_sSup hW
    have hmem : ∀ k l (y : Y k), y ∈ V k l →
        ∃ W : (Y k).Opens, G l W.toScheme (W.ι ≫ p k) ∧ y ∈ W := by
      intro k l y hy
      rw [hV] at hy
      exact TopologicalSpace.Opens.mem_sSup.mp hy
    have hiv : ∀ k l, G l (V k l).toScheme ((V k l).ι ≫ p k) := by
      intro k l
      apply hGloc
      intro v
      obtain ⟨W, hW, hvW⟩ := hmem k l v.1 v.2
      refine ⟨(V k l).ι ⁻¹ᵁ W, ?_, ?_⟩
      · show (V k l).ι v ∈ W
        exact hvW
      · rw [← Category.assoc]
        apply hH l (Y k) _ (p k) W
        · intro x
          exact x.2
        · exact hW
    have hVtop : ∀ k, V k k = ⊤ := by
      intro k
      apply eq_top_iff.mpr
      apply hle
      exact hGres k (Y k) _ (⊤ : (Y k).Opens).ι (p k) (hGp k)
    have hLand : ∀ (k l : K) (T : Scheme.{u}) (d : T ⟶ Y k), G l T (d ≫ p k) →
        ∀ x : T, d x ∈ V k l := by
      intro k l T d hd x
      obtain ⟨W, hxW, hW⟩ := hOpen l (Y k) T (p k) d (hGP k _ _ (hGp k)) hd x
      exact hle k l W hW hxW
    have hf : ∀ k l, ∃ f : (V k l).toScheme ⟶ Y l, f ≫ p l = (V k l).ι ≫ p k :=
      fun k l => (hRep l _ _ (hiv k l)).exists
    choose f hf using hf
    have hfl : ∀ k l, Set.range (f k l) ⊆ Set.range (V l k).ι := by
      intro k l
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      refine hLand l k _ (f k l) ?_ x
      rw [hf k l]
      exact hGres k (Y k) _ (V k l).ι (p k) (hGp k)
    refine ⟨V, fun k l => IsOpenImmersion.lift (V l k).ι (f k l) (hfl k l), hVtop, hiv, ?_, hLand⟩
    intro k l
    rw [← Category.assoc, IsOpenImmersion.lift_fac, hf]

  obtain ⟨X', r, s, hso, hsr, hsurj, hglue⟩ : ∃ (X' : Scheme.{u}) (r : X' ⟶ X)
      (s : ∀ k, Y k ⟶ X'), (∀ k, IsOpenImmersion (s k)) ∧ (∀ k, s k ≫ r = p k) ∧
      (∀ x : X', ∃ (k : K) (y : Y k), s k y = x) ∧
      (∀ k l, t k l ≫ (V l k).ι ≫ s l = (V k l).ι ≫ s k) := by
    have hlandt : ∀ k l m, Set.range (Limits.pullback.fst (V k l).ι (V k m).ι ≫ t k l ≫ (V l k).ι) ⊆
        Set.range (V l m).ι := by
      intro k l m
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      refine hLand l m _ _ ?_ x
      have e : (Limits.pullback.fst (V k l).ι (V k m).ι ≫ t k l ≫ (V l k).ι) ≫ p l =
          Limits.pullback.snd (V k l).ι (V k m).ι ≫ (V k m).ι ≫ p k := by
        rw [Category.assoc, Category.assoc, hii, Limits.pullback.condition_assoc]
      rw [e]
      exact hGres m _ _ _ _ (hiv k m)
    obtain ⟨a0, ha0⟩ : ∃ a0 : ∀ k l m, Limits.pullback (V k l).ι (V k m).ι ⟶ (V l m).toScheme,
        ∀ k l m, a0 k l m ≫ (V l m).ι =
          Limits.pullback.fst (V k l).ι (V k m).ι ≫ t k l ≫ (V l k).ι :=
      ⟨fun k l m => IsOpenImmersion.lift (V l m).ι _ (hlandt k l m),
        fun k l m => IsOpenImmersion.lift_fac _ _ _⟩
    obtain ⟨t', ht'1, ht'2⟩ : ∃ t' : ∀ k l m, Limits.pullback (V k l).ι (V k m).ι ⟶
        Limits.pullback (V l m).ι (V l k).ι,
        (∀ k l m, t' k l m ≫ Limits.pullback.fst (V l m).ι (V l k).ι = a0 k l m) ∧
        (∀ k l m, t' k l m ≫ Limits.pullback.snd (V l m).ι (V l k).ι =
          Limits.pullback.fst (V k l).ι (V k m).ι ≫ t k l) :=
      ⟨fun k l m => Limits.pullback.lift (a0 k l m)
          (Limits.pullback.fst (V k l).ι (V k m).ι ≫ t k l)
          (by rw [ha0, Category.assoc]),
        fun k l m => Limits.pullback.lift_fst _ _ _, fun k l m => Limits.pullback.lift_snd _ _ _⟩
    have hX2 : ∀ k l m, t' k l m ≫ Limits.pullback.fst (V l m).ι (V l k).ι ≫ (V l m).ι ≫ p l =
        Limits.pullback.fst (V k l).ι (V k m).ι ≫ (V k l).ι ≫ p k := by
      intro k l m
      rw [← Category.assoc (t' k l m), ht'1, ← Category.assoc (a0 k l m), ha0]
      simp only [Category.assoc, hii]
    have hfid : ∀ k, IsIso (V k k).ι := by
      intro k
      rw [isIso_iff_isOpenImmersion_and_surjective]
      refine ⟨inferInstance, ⟨fun y => ?_⟩⟩
      have : y ∈ Set.range (V k k).ι := by
        rw [Scheme.Opens.range_ι, hVtop k]
        trivial
      exact this
    have htid : ∀ k, t k k = 𝟙 _ := by
      intro k
      apply (cancel_mono (V k k).ι).mp
      rw [Category.id_comp]
      apply hUniq k
      · rw [Category.assoc, hii]
        exact hGP k _ _ (hiv k k)
      · rw [Category.assoc, hii]
    have hcoc : ∀ k l m, t' k l m ≫ t' l m k ≫ t' m k l = 𝟙 _ := by
      intro k l m
      have hPξ : P _ (Limits.pullback.fst (V k l).ι (V k m).ι ≫ (V k l).ι ≫ p k) := by
        rw [← Category.assoc]
        exact hGP l _ _ (hGres l _ _ (Limits.pullback.fst (V k l).ι (V k m).ι) _ (hiv k l))
      apply Limits.pullback.hom_ext
      · apply (cancel_mono (V k l).ι).mp
        apply hUniq k
        · simp only [Category.assoc, hX2]
          exact hPξ
        · simp only [Category.assoc, Category.id_comp, hX2]
      · apply (cancel_mono (V k m).ι).mp
        apply hUniq k
        · simp only [Category.assoc, ← Limits.pullback.condition_assoc, hX2]
          exact hPξ
        · simp only [Category.assoc, Category.id_comp, ← Limits.pullback.condition_assoc, hX2]
    let D0 : CategoryTheory.GlueData Scheme.{u} :=
      { J := K
        U := Y
        V := fun x => (V x.1 x.2).toScheme
        f := fun k l => (V k l).ι
        f_mono := fun k l => (inferInstance : Mono (V k l).ι)
        f_hasPullback := fun k l m => (inferInstance : Limits.HasPullback (V k l).ι (V k m).ι)
        f_id := hfid
        t := t
        t_id := htid
        t' := t'
        t_fac := ht'2
        cocycle := hcoc }
    let D : Scheme.GlueData.{u} :=
      { toGlueData := D0
        f_open := fun k l => (inferInstance : IsOpenImmersion (V k l).ι) }
    haveI hDm : Limits.HasMulticoequalizer D.diagram :=
      (fun (E : Scheme.GlueData.{u}) =>
        (inferInstance : Limits.HasMulticoequalizer E.diagram)) D
    have hDι : ∀ k, IsOpenImmersion (D.ι k) := fun k =>
      (fun (E : Scheme.GlueData.{u}) (i : E.J) => (inferInstance : IsOpenImmersion (E.ι i))) D k
    have hr : ∀ a : (Limits.MultispanShape.prod D.J).L,
        D.diagram.fst a ≫ (fun k => p k) ((Limits.MultispanShape.prod D.J).fst a) =
          D.diagram.snd a ≫ (fun k => p k) ((Limits.MultispanShape.prod D.J).snd a) := by
      rintro ⟨k, l⟩
      show (V k l).ι ≫ p k = (t k l ≫ (V l k).ι) ≫ p l
      rw [Category.assoc, hii]
    refine ⟨D.glued, Limits.Multicoequalizer.desc D.diagram X (fun k => p k) hr, fun k => D.ι k,
      hDι, fun k => ?_, fun x => D.ι_jointly_surjective x,
      fun k l => D.glue_condition k l⟩
    exact Limits.Multicoequalizer.π_desc D.diagram X (fun k => p k) hr k

  have hSep : ∀ (T : Scheme.{u}) (h' h'' : T ⟶ X'), P T (h' ≫ r) → h' ≫ r = h'' ≫ r →
      h' = h'' := by
    intro T h' h'' hP he
    apply Scheme.hom_ext_of_forall
    intro τ
    obtain ⟨k, y, hy⟩ := hsurj (h' τ)
    obtain ⟨l, y', hy'⟩ := hsurj (h'' τ)
    have := hso k
    have := hso l
    let U : T.Opens := h' ⁻¹ᵁ (s k).opensRange ⊓ h'' ⁻¹ᵁ (s l).opensRange
    have hτ : τ ∈ U := TopologicalSpace.Opens.mem_inf.mpr
      ⟨(Scheme.Hom.mem_opensRange.mpr ⟨y, hy⟩ : h' τ ∈ (s k).opensRange),
        (Scheme.Hom.mem_opensRange.mpr ⟨y', hy'⟩ : h'' τ ∈ (s l).opensRange)⟩
    refine ⟨U, hτ, ?_⟩
    have H1 : Set.range (U.ι ≫ h') ⊆ Set.range (s k) := by
      rintro _ ⟨u, rfl⟩
      have hu : h' u.1 ∈ (s k).opensRange := (TopologicalSpace.Opens.mem_inf.mp u.2).1
      exact Scheme.Hom.mem_opensRange.mp hu
    have H2 : Set.range (U.ι ≫ h'') ⊆ Set.range (s l) := by
      rintro _ ⟨u, rfl⟩
      have hu : h'' u.1 ∈ (s l).opensRange := (TopologicalSpace.Opens.mem_inf.mp u.2).2
      exact Scheme.Hom.mem_opensRange.mp hu
    obtain ⟨d', hd'⟩ : ∃ d' : U.toScheme ⟶ Y k, d' ≫ s k = U.ι ≫ h' :=
      ⟨_, IsOpenImmersion.lift_fac _ _ H1⟩
    obtain ⟨d'', hd''⟩ : ∃ d'' : U.toScheme ⟶ Y l, d'' ≫ s l = U.ι ≫ h'' :=
      ⟨_, IsOpenImmersion.lift_fac _ _ H2⟩
    have e1 : d' ≫ p k = U.ι ≫ h' ≫ r := by
      rw [← hsr k, ← Category.assoc d', hd', Category.assoc]
    have e2 : d'' ≫ p l = U.ι ≫ h' ≫ r := by
      rw [← hsr l, ← Category.assoc d'', hd'', Category.assoc, he]
    have hPU : P U.toScheme (U.ι ≫ h' ≫ r) := hPres T U.toScheme U.ι (h' ≫ r) hP
    have hGl : G l U.toScheme (d' ≫ p k) := by
      have := hInto l U.toScheme d'' (by rw [e2]; exact hPU)
      rwa [e2, ← e1] at this
    obtain ⟨d0, hd0⟩ : ∃ d0 : U.toScheme ⟶ (V k l).toScheme, d0 ≫ (V k l).ι = d' := by
      refine ⟨IsOpenImmersion.lift (V k l).ι d' ?_, IsOpenImmersion.lift_fac _ _ _⟩
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      exact hLand k l _ d' hGl x
    have hU : d0 ≫ t k l ≫ (V l k).ι = d'' := by
      apply hUniq l
      · simp only [Category.assoc]
        rw [hii, ← Category.assoc d0, hd0, e1]
        exact hPU
      · simp only [Category.assoc]
        rw [hii, ← Category.assoc d0, hd0, e1, e2]
    calc U.ι ≫ h' = d' ≫ s k := hd'.symm
      _ = d0 ≫ (V k l).ι ≫ s k := by rw [← Category.assoc, hd0]
      _ = d0 ≫ t k l ≫ (V l k).ι ≫ s l := by rw [hglue]
      _ = d'' ≫ s l := by rw [← hU]; simp only [Category.assoc]
      _ = U.ι ≫ h'' := hd''

  have hPr : P X' r := by
    apply hPloc
    intro x
    obtain ⟨k, y, hy⟩ := hsurj x
    have := hso k
    refine ⟨(s k).opensRange, Scheme.Hom.mem_opensRange.mpr ⟨y, hy⟩, ?_⟩
    have e : (s k).opensRange.ι = (s k).isoOpensRange.inv ≫ s k := by
      rw [Iso.eq_inv_comp, Scheme.Hom.isoOpensRange_hom_ι]
    rw [e, Category.assoc, hsr k]
    exact hPres (Y k) _ (s k).isoOpensRange.inv (p k) (hGP k _ _ (hGp k))
  refine ⟨X', r, s, ⟨hPr, ?_⟩, hso, hsr, hsurj⟩
  intro T h hP
  choose κ W hmem hG using hCov T h hP
  have hc : ∀ τ, ∃ c : (W τ).toScheme ⟶ Y (κ τ), c ≫ p (κ τ) = (W τ).ι ≫ h :=
    fun τ => (hRep _ _ _ (hG τ)).exists
  choose c hc using hc
  have hfa : ∀ τ, (c τ ≫ s (κ τ)) ≫ r = (W τ).ι ≫ h := fun τ => by
    rw [Category.assoc, hsr, hc]
  let 𝒰 : T.OpenCover := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) T
    (fun τ => (W τ).toScheme) (fun τ => (W τ).ι) (fun x => ⟨x, ⟨x, hmem x⟩, rfl⟩)
  have hcompat0 : ∀ a b : T, Limits.pullback.fst (W a).ι (W b).ι ≫ (c a ≫ s (κ a)) =
      Limits.pullback.snd (W a).ι (W b).ι ≫ (c b ≫ s (κ b)) := by
    intro a b
    apply hSep
    · rw [Category.assoc, hfa a, ← Category.assoc]
      exact hPres T _ (Limits.pullback.fst (W a).ι (W b).ι ≫ (W a).ι) h hP
    · have ea : c a ≫ s (κ a) ≫ r = (W a).ι ≫ h := by rw [← Category.assoc]; exact hfa a
      have eb : c b ≫ s (κ b) ≫ r = (W b).ι ≫ h := by rw [← Category.assoc]; exact hfa b
      simp only [Category.assoc]
      rw [ea, eb]
      exact Limits.pullback.condition_assoc h
  have hcompat : ∀ a b : 𝒰.I₀, Limits.pullback.fst (𝒰.f a) (𝒰.f b) ≫ (c a ≫ s (κ a)) =
      Limits.pullback.snd (𝒰.f a) (𝒰.f b) ≫ (c b ≫ s (κ b)) := fun a b => hcompat0 a b
  have hfac : 𝒰.glueMorphisms (fun τ => c τ ≫ s (κ τ)) hcompat ≫ r = h := by
    apply 𝒰.hom_ext
    intro τ
    have e := Scheme.Cover.ι_glueMorphisms 𝒰 (fun τ => c τ ≫ s (κ τ)) hcompat τ
    rw [← Category.assoc, e]
    exact hfa τ
  exact ⟨_, hfac, fun y hy => hSep T y _ (by rw [hy]; exact hP) (hy.trans hfac.symm)⟩

theorem wc_csd_chart_open_imm : ∀ (X T T' : Scheme.{u}) (I : X.IdealSheafData) (j : T' ⟶ T) [IsOpenImmersion j] (h : T ⟶ X) (U : X.affineOpens) (a : Γ(X, U.1)) (t' : T'), wcCsdChartAt I h U a (j t') ↔ wcCsdChartAt I (j ≫ h) U a t' :=
by
  intro X T T' I j _ h U a t'
  have hmapcomp : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (σ : B ⟶ C) (J : Ideal A) (x : A),
      Ideal.map φ.hom J = Ideal.span {φ.hom x} →
      Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom x} := by
    intro A B C φ σ J x hx
    rw [CommRingCat.hom_comp, ← Ideal.map_map, hx, Ideal.map_span, Set.image_singleton]
    try rfl
  have hiso : ∀ {A B C : CommRingCat.{u}} (ρ : A ⟶ B) (σ : B ⟶ C) [IsIso σ] (J : Ideal A) (x : A),
      ρ.hom x ∈ nonZeroDivisors B → Ideal.map ρ.hom J = Ideal.span {ρ.hom x} →
      (ρ ≫ σ).hom x ∈ nonZeroDivisors C ∧
        Ideal.map (ρ ≫ σ).hom J = Ideal.span {(ρ ≫ σ).hom x} := by
    intro A B C ρ σ _ J x hN hI
    refine ⟨?_, hmapcomp ρ σ J x hI⟩
    rw [← MulEquivClass.map_nonZeroDivisors (asIso σ).commRingCatIsoToRingEquiv]
    exact ⟨ρ.hom x, hN, rfl⟩
  have happ : ∀ (W : T.Opens) (V : T'.Opens) (e : V ≤ j ⁻¹ᵁ W), j ''ᵁ V = W →
      IsIso (j.appLE W V e) := by
    intro W V e hW
    subst hW
    have : j.appLE (j ''ᵁ V) V e = (j.appIso V).hom := by
      rw [Scheme.Hom.appIso_hom]
      rfl
    rw [this]
    infer_instance
  constructor
  · rintro ⟨V, e, hjt, hN, hI⟩
    have hjr : j t' ∈ j.opensRange := ⟨t', rfl⟩
    obtain ⟨f, hfO, hft⟩ := V.2.exists_basicOpen_le (V := V.1 ⊓ j.opensRange) ⟨j t', hjt, hjr⟩ hjt
    have hDR : T.basicOpen f ≤ j.opensRange := hfO.trans inf_le_right
    have eD : T.basicOpen f ≤ h ⁻¹ᵁ U.1 := (T.basicOpen_le f).trans e
    have hfac1 : h.appLE U.1 V.1 e ≫ T.presheaf.map (homOfLE (T.basicOpen_le f)).op =
        h.appLE U.1 (T.basicOpen f) eD := Scheme.Hom.appLE_map _ _ _
    have := V.2.isLocalization_basicOpen f
    have hN1 : (h.appLE U.1 (T.basicOpen f) eD).hom a ∈ nonZeroDivisors Γ(T, T.basicOpen f) := by
      rw [← hfac1]
      exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers f) Γ(T, T.basicOpen f)
        ⟨_, hN, rfl⟩
    have hI1 := hmapcomp _ (T.presheaf.map (homOfLE (T.basicOpen_le f)).op) _ _ hI
    rw [hfac1] at hI1
    have hV' : IsAffineOpen (j ⁻¹ᵁ T.basicOpen f) :=
      (V.2.basicOpen f).preimage_of_isOpenImmersion j hDR
    have e' : j ⁻¹ᵁ T.basicOpen f ≤ (j ≫ h) ⁻¹ᵁ U.1 := fun y hy => eD hy
    have hfac2 := Scheme.Hom.appLE_comp_appLE j h U.1 (T.basicOpen f) (j ⁻¹ᵁ T.basicOpen f)
      eD le_rfl
    have himg : j ''ᵁ (j ⁻¹ᵁ T.basicOpen f) = T.basicOpen f := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
      exact inf_eq_right.mpr hDR
    have := happ _ _ (le_rfl : j ⁻¹ᵁ T.basicOpen f ≤ j ⁻¹ᵁ T.basicOpen f) himg
    obtain ⟨g1, g2⟩ := hiso (h.appLE U.1 (T.basicOpen f) eD)
      (j.appLE (T.basicOpen f) (j ⁻¹ᵁ T.basicOpen f) le_rfl) (I.ideal U) a hN1 hI1
    rw [hfac2] at g1 g2
    exact ⟨⟨_, hV'⟩, e', hft, g1, g2⟩
  · rintro ⟨V', e', ht', hN', hI'⟩
    have hV0 : IsAffineOpen (j ''ᵁ V'.1) := V'.2.image_of_isOpenImmersion j
    have hj : j t' ∈ j ''ᵁ V'.1 := ⟨t', ht', rfl⟩
    have e0 : j ''ᵁ V'.1 ≤ h ⁻¹ᵁ U.1 := by
      rintro _ ⟨y, hy, rfl⟩
      exact e' hy
    have ej : V'.1 ≤ j ⁻¹ᵁ (j ''ᵁ V'.1) := fun y hy => ⟨y, hy, rfl⟩
    have hfac := Scheme.Hom.appLE_comp_appLE j h U.1 (j ''ᵁ V'.1) V'.1 e0 ej
    have := happ (j ''ᵁ V'.1) V'.1 ej rfl
    have heq : h.appLE U.1 (j ''ᵁ V'.1) e0 =
        (j ≫ h).appLE U.1 V'.1 e' ≫ inv (j.appLE (j ''ᵁ V'.1) V'.1 ej) := by
      rw [← hfac, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
    obtain ⟨g1, g2⟩ := hiso _ (inv (j.appLE (j ''ᵁ V'.1) V'.1 ej)) (I.ideal U) a hN' hI'
    rw [← heq] at g1 g2
    exact ⟨⟨_, hV0⟩, e0, hj, g1, g2⟩

theorem wc_csd_invpull_generator_chart : ∀ (X T : Scheme.{u}) (I : X.IdealSheafData) (h : T ⟶ X), wcCsdInvPull I h → ∀ (U : X.affineOpens) (n : ℕ) (b : Fin n → Γ(X, U.1)), Ideal.span (Set.range b) = I.ideal U → ∀ t : T, h t ∈ U.1 → ∃ j : Fin n, wcCsdChartAt I h U (b j) t :=
by
  intro X T I h hP U n b hb t hU
  classical

  have LC : ∀ (U' : X.Opens) (V : T.Opens) (hV : IsAffineOpen V) (e : V ≤ h ⁻¹ᵁ U')
      (J : Ideal Γ(X, U')) (ε f : Γ(T, V)), ε ∈ nonZeroDivisors Γ(T, V) →
      Ideal.map (h.appLE U' V e).hom J = Ideal.span {ε} →
      ∃ (e' : T.basicOpen f ≤ h ⁻¹ᵁ U') (r : Γ(T, V) →+* Γ(T, T.basicOpen f)),
        r ε ∈ nonZeroDivisors Γ(T, T.basicOpen f) ∧ IsUnit (r f) ∧
        Ideal.map (h.appLE U' (T.basicOpen f) e').hom J = Ideal.span {r ε} ∧
        ∀ x : Γ(X, U'), (h.appLE U' (T.basicOpen f) e').hom x = r ((h.appLE U' V e).hom x) := by
    intro U' V hV e J ε f hε hJ
    have e' : T.basicOpen f ≤ h ⁻¹ᵁ U' := (T.basicOpen_le f).trans e
    have hform : ∀ x : Γ(X, U'), (h.appLE U' (T.basicOpen f) e').hom x =
        (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom ((h.appLE U' V e).hom x) := by
      intro x
      rw [← Scheme.Hom.appLE_map h e (homOfLE (T.basicOpen_le f)).op]
      rfl
    refine ⟨e', (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom, ?_, ?_, ?_, hform⟩
    · exact @IsLocalization.map_nonZeroDivisors_le _ _ (Submonoid.powers f) _ _ _
        (hV.isLocalization_basicOpen f) _ (Submonoid.mem_map_of_mem _ hε)
    · exact @IsLocalization.Away.algebraMap_isUnit _ _ _ _ _ f (hV.isLocalization_basicOpen f)
    · have hcomp : (h.appLE U' (T.basicOpen f) e').hom =
          (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom.comp (h.appLE U' V e).hom :=
        RingHom.ext hform
      rw [hcomp, ← Ideal.map_map, hJ, Ideal.map_span, Set.image_singleton]

  have LD : ∀ (U₀ D : X.affineOpens) (W : T.Opens) (eU : W ≤ h ⁻¹ᵁ U₀.1) (eD : W ≤ h ⁻¹ᵁ D.1),
      D ≤ U₀ → Ideal.map (h.appLE U₀.1 W eU).hom (I.ideal U₀) =
        Ideal.map (h.appLE D.1 W eD).hom (I.ideal D) := by
    intro U₀ D W eU eD hDU
    rw [← I.map_ideal hDU, Ideal.map_map]
    congr 1
    rw [← CommRingCat.hom_comp, Scheme.Hom.map_appLE]

  obtain ⟨U₁, V₁, e₁, a₁, htV₁, -, hε₁, hJ₁⟩ := hP t
  have hU₁ : h t ∈ U₁.1 := e₁ htV₁
  obtain ⟨D₀, hD₀, hxD₀, hD₀sub⟩ :=
    exists_isAffineOpen_mem_and_subset (x := h t) (U := U.1 ⊓ U₁.1) ⟨hU, hU₁⟩
  let D : X.affineOpens := ⟨D₀, hD₀⟩
  have hDU : D ≤ U := show D₀ ≤ U.1 from fun x hx => (hD₀sub hx).1
  have hDU₁ : D ≤ U₁ := show D₀ ≤ U₁.1 from fun x hx => (hD₀sub hx).2
  have htVD : t ∈ V₁.1 ⊓ h ⁻¹ᵁ D.1 := ⟨htV₁, hxD₀⟩
  obtain ⟨f, hf, htf⟩ := V₁.2.exists_basicOpen_le (V := V₁.1 ⊓ h ⁻¹ᵁ D.1) ⟨t, htVD⟩ htV₁
  have htf' : t ∈ T.basicOpen f := htf
  have hV₂ : IsAffineOpen (T.basicOpen f) := V₁.2.basicOpen f
  have eD : T.basicOpen f ≤ h ⁻¹ᵁ D.1 := hf.trans inf_le_right
  have eU : T.basicOpen f ≤ h ⁻¹ᵁ U.1 := fun x hx => hDU (eD hx)
  obtain ⟨eU₁, r₁, hε₂, -, hJ₂, -⟩ := LC U₁.1 V₁.1 V₁.2 e₁ (I.ideal U₁) _ f hε₁ hJ₁
  generalize r₁ ((h.appLE U₁.1 V₁.1 e₁).hom a₁) = ε₂ at hε₂ hJ₂
  have hJ : Ideal.map (h.appLE U.1 (T.basicOpen f) eU).hom (I.ideal U) = Ideal.span {ε₂} := by
    rw [LD U D _ eU eD hDU, ← LD U₁ D _ eU₁ eD hDU₁, hJ₂]

  have hJb : Ideal.span (Set.range (fun j => (h.appLE U.1 (T.basicOpen f) eU).hom (b j))) =
      Ideal.span {ε₂} := by
    rw [← hJ, ← hb, Ideal.map_span, ← Set.range_comp]
    rfl
  have hy : ∀ j, ∃ y, y * ε₂ = (h.appLE U.1 (T.basicOpen f) eU).hom (b j) := by
    intro j
    apply Ideal.mem_span_singleton'.mp
    rw [← hJb]
    exact Ideal.subset_span ⟨j, rfl⟩
  choose y hy using hy
  have hεmem : ε₂ ∈ Ideal.span (Set.range (fun j => (h.appLE U.1 (T.basicOpen f) eU).hom (b j))) := by
    rw [hJb]; exact Ideal.mem_span_singleton_self ε₂
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hεmem
  have hcy : ∑ j, c j * y j = 1 := by
    have h1 : (∑ j, c j * y j) * ε₂ = ε₂ := by
      rw [Finset.sum_mul]
      simp_rw [mul_assoc, hy]
      exact hc
    have h0 : (∑ j, c j * y j - 1) * ε₂ = 0 := by rw [sub_mul, h1, one_mul, sub_self]
    exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hε₂).mp h0)

  obtain ⟨j, hj⟩ : ∃ j, t ∈ T.basicOpen (y j) := by
    by_contra hcon
    push_neg at hcon
    have hm : ∀ j, (T.presheaf.germ (T.basicOpen f) t htf').hom (c j * y j) ∈
        IsLocalRing.maximalIdeal (T.presheaf.stalk t) := by
      intro j
      rw [map_mul]
      apply Ideal.mul_mem_left
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen T (y j) t htf']
      exact hcon j
    have h1 := Ideal.sum_mem (IsLocalRing.maximalIdeal (T.presheaf.stalk t))
      (t := Finset.univ) (fun j _ => hm j)
    rw [← map_sum, hcy, map_one] at h1
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)

  obtain ⟨e'', r, hε₃, hu, hJ₃, hform⟩ :=
    LC U.1 (T.basicOpen f) hV₂ eU (I.ideal U) ε₂ (y j) hε₂ hJ
  refine ⟨j, ⟨T.basicOpen (y j), hV₂.basicOpen (y j)⟩, e'', hj, ?_, ?_⟩
  · show (h.appLE U.1 (T.basicOpen (y j)) e'').hom (b j) ∈ nonZeroDivisors Γ(T, T.basicOpen (y j))
    rw [hform, ← hy j, map_mul]
    exact mul_mem_nonZeroDivisors.mpr ⟨hu.mem_nonZeroDivisors, hε₃⟩
  · show Ideal.map (h.appLE U.1 (T.basicOpen (y j)) e'').hom (I.ideal U) =
      Ideal.span {(h.appLE U.1 (T.basicOpen (y j)) e'').hom (b j)}
    rw [hJ₃, hform, ← hy j, map_mul, Ideal.span_singleton_mul_left_unit hu]

theorem wc_csd_chart_global_sections : ∀ (X T : Scheme.{u}) (I : X.IdealSheafData) (h : T ⟶ X) (U : X.affineOpens) (a : Γ(X, U.1)), a ∈ I.ideal U → (∀ t : T, wcCsdChartAt I h U a t) → ∀ (e : ⊤ ≤ h ⁻¹ᵁ U.1), (h.appLE U.1 ⊤ e).hom a ∈ nonZeroDivisors Γ(T, ⊤) ∧ Ideal.map (h.appLE U.1 ⊤ e).hom (I.ideal U) = Ideal.span {(h.appLE U.1 ⊤ e).hom a} :=
by
  intro X T I h U a ha hch e
  classical

  have L1 : ∀ (V : T.Opens), IsAffineOpen V → ∀ (x : T) (hx : x ∈ V) (g : Γ(T, V)),
      g ∈ nonZeroDivisors Γ(T, V) →
        (T.presheaf.germ V x hx).hom g ∈ nonZeroDivisors (T.presheaf.stalk x) := by
    intro V hV x hx g hg
    letI := TopCat.Presheaf.algebra_section_stalk T.presheaf (⟨x, hx⟩ : V)
    have h1 := @IsLocalization.map_nonZeroDivisors_le _ _
      (hV.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl _ _ _ (hV.isLocalization_stalk ⟨x, hx⟩)
      _ ⟨g, hg, rfl⟩
    rw [TopCat.Presheaf.stalk_open_algebraMap] at h1
    exact h1

  have L2 : ∀ (W : T.Opens) (s : Γ(T, W)), (∀ (x : T) (hx : x ∈ W),
      (T.presheaf.germ W x hx).hom s ∈ nonZeroDivisors (T.presheaf.stalk x)) →
        s ∈ nonZeroDivisors Γ(T, W) := by
    intro W s hs
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    apply TopCat.Presheaf.section_ext T.sheaf W y 0
    intro x hx
    have h1 : (T.presheaf.germ W x hx).hom y * (T.presheaf.germ W x hx).hom s = 0 := by
      rw [← map_mul, hy, map_zero]
    have h2 := (mem_nonZeroDivisors_iff_right.mp (hs x hx)) _ h1
    rw [map_zero]
    exact h2

  have hres : ∀ (V : T.Opens) (eV : V ≤ h ⁻¹ᵁ U.1) (z : Γ(X, U.1)),
      (T.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom ((h.appLE U.1 ⊤ e).hom z) =
        (h.appLE U.1 V eV).hom z := by
    intro V eV z
    have := Scheme.Hom.appLE_map h e (homOfLE (le_top : V ≤ ⊤)).op
    rw [← this]
    rfl
  have hresres : ∀ (W' W : T.Opens) (i : W' ⟶ W) (z : Γ(T, ⊤)),
      (T.presheaf.map i.op).hom ((T.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom z) =
        (T.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op).hom z := by
    intro W' W i z
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
    rfl

  have L3 : ∀ (s f : Γ(T, ⊤)), (∀ W : T.Opens,
      (T.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom s ∈ nonZeroDivisors Γ(T, W)) →
      (∀ x : T, ∃ (W : T.Opens) (_ : x ∈ W) (c : Γ(T, W)),
        c * (T.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom s =
          (T.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom f) → f ∈ Ideal.span {s} := by
    intro s f hs hloc
    choose W hxW c hc using hloc
    have hcov : (⊤ : T.Opens) ≤ iSup W := by
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hxW x⟩
    have hcompat : TopCat.Presheaf.IsCompatible T.sheaf.obj W c := by
      intro i j
      change (T.presheaf.map (TopologicalSpace.Opens.infLELeft (W i) (W j)).op).hom (c i) =
        (T.presheaf.map (TopologicalSpace.Opens.infLERight (W i) (W j)).op).hom (c j)
      have hnzO := hs (W i ⊓ W j)
      rw [mem_nonZeroDivisors_iff_right] at hnzO
      apply sub_eq_zero.mp
      apply hnzO
      rw [sub_mul]
      apply sub_eq_zero.mpr
      have k1 := congrArg (T.presheaf.map (TopologicalSpace.Opens.infLELeft (W i) (W j)).op).hom
        (hc i)
      have k2 := congrArg (T.presheaf.map (TopologicalSpace.Opens.infLERight (W i) (W j)).op).hom
        (hc j)
      rw [map_mul] at k1 k2
      rw [hresres] at k1
      rw [hresres] at k1
      rw [hresres] at k2
      rw [hresres] at k2
      rw [k1, k2]
    obtain ⟨g0, hg0, -⟩ := TopCat.Sheaf.existsUnique_gluing' T.sheaf W ⊤
      (fun i => homOfLE le_top) hcov c hcompat
    obtain ⟨g, hg⟩ : ∃ g : Γ(T, ⊤), ∀ i,
        (T.presheaf.map (homOfLE (le_top : W i ≤ ⊤)).op).hom g = c i := ⟨g0, hg0⟩
    have hgs : g * s = f := by
      apply TopCat.Sheaf.eq_of_locally_eq' T.sheaf W ⊤ (fun i => homOfLE le_top) hcov
      intro i
      change (T.presheaf.map (homOfLE (le_top : W i ≤ ⊤)).op).hom (g * s) =
        (T.presheaf.map (homOfLE (le_top : W i ≤ ⊤)).op).hom f
      rw [map_mul, ← hc i, hg i]
    exact Ideal.mem_span_singleton'.mpr ⟨g, hgs⟩

  choose V eV hxV hnz hid using hch
  have G : ∀ x : T, (T.presheaf.germ ⊤ x trivial).hom ((h.appLE U.1 ⊤ e).hom a) ∈
      nonZeroDivisors (T.presheaf.stalk x) := by
    intro x
    have e1 : (T.presheaf.germ ⊤ x trivial).hom ((h.appLE U.1 ⊤ e).hom a) =
        (T.presheaf.germ (V x).1 x (hxV x)).hom ((h.appLE U.1 (V x).1 (eV x)).hom a) := by
      rw [← hres (V x).1 (eV x) a]
      exact (TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE (le_top : (V x).1 ≤ ⊤)) x
        (hxV x) _).symm
    rw [e1]
    exact L1 (V x).1 (V x).2 x (hxV x) _ (hnz x)
  have hi : (h.appLE U.1 ⊤ e).hom a ∈ nonZeroDivisors Γ(T, ⊤) := L2 ⊤ _ (fun x _ => G x)
  have hall : ∀ W : T.Opens, (T.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
      ((h.appLE U.1 ⊤ e).hom a) ∈ nonZeroDivisors Γ(T, W) := by
    intro W
    apply L2
    intro x hx
    have e1 : (T.presheaf.germ W x hx).hom ((T.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
        ((h.appLE U.1 ⊤ e).hom a)) = (T.presheaf.germ ⊤ x trivial).hom ((h.appLE U.1 ⊤ e).hom a) :=
      TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE (le_top : W ≤ ⊤)) x hx _
    rw [e1]
    exact G x
  refine ⟨hi, le_antisymm ?_ ?_⟩
  · rw [Ideal.map_le_iff_le_comap]
    intro b hb
    rw [Ideal.mem_comap]
    apply L3 _ _ hall
    intro x
    have hmem : (h.appLE U.1 (V x).1 (eV x)).hom b ∈
        Ideal.span {(h.appLE U.1 (V x).1 (eV x)).hom a} := by
      rw [← hid x]
      exact Ideal.mem_map_of_mem _ hb
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
    refine ⟨(V x).1, hxV x, c, ?_⟩
    rw [hres _ (eV x), hres _ (eV x)]
    exact hc
  · rw [Ideal.span_singleton_le_iff_mem]
    exact Ideal.mem_map_of_mem _ ha

theorem wc_csd_chart_spec_maps : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U) (R : CommRingCat.{u}) (φ : Γ(X, U) ⟶ R), (∀ (e : ⊤ ≤ (Spec.map φ ≫ hU.fromSpec) ⁻¹ᵁ U), (Spec.map φ ≫ hU.fromSpec).appLE U ⊤ e = φ ≫ (Scheme.ΓSpecIso R).inv) ∧ (∀ (T : Scheme.{u}) (h : T ⟶ X) (e : ⊤ ≤ h ⁻¹ᵁ U) (c : T ⟶ Spec R), c ≫ Spec.map φ ≫ hU.fromSpec = h ↔ φ ≫ (Scheme.ΓSpecIso R).inv ≫ c.appTop = h.appLE U ⊤ e) ∧ (∀ (T : Scheme.{u}) (ψ : R ⟶ Γ(T, ⊤)), ∃! c : T ⟶ Spec R, (Scheme.ΓSpecIso R).inv ≫ c.appTop = ψ) :=
by
  intro X U hU R φ
  have hb : ∀ (e₁ : (⊤ : (Spec Γ(X, U)).Opens) ≤ hU.fromSpec ⁻¹ᵁ U),
      hU.fromSpec.appLE U ⊤ e₁ = (Scheme.ΓSpecIso Γ(X, U)).inv := by
    intro e₁
    rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
    have hid : ∀ (f : Opposite.op (⊤ : (Spec Γ(X, U)).Opens) ⟶ Opposite.op ⊤),
        (Spec Γ(X, U)).presheaf.map f = 𝟙 _ := by
      intro f
      rw [show f = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _),
        CategoryTheory.Functor.map_id]
    rw [hid, Category.comp_id]
  have K : ∀ (T : Scheme.{u}) (k : T ⟶ Spec Γ(X, U)) (e : ⊤ ≤ (k ≫ hU.fromSpec) ⁻¹ᵁ U),
      (k ≫ hU.fromSpec).appLE U ⊤ e = (Scheme.ΓSpecIso Γ(X, U)).inv ≫ k.appTop := by
    intro T k e
    have e₁ : (⊤ : (Spec Γ(X, U)).Opens) ≤ hU.fromSpec ⁻¹ᵁ U := hU.fromSpec_preimage_self.ge
    have e₂ : (⊤ : T.Opens) ≤ k ⁻¹ᵁ ⊤ := le_top
    rw [← Scheme.Hom.appLE_comp_appLE k hU.fromSpec U ⊤ ⊤ e₁ e₂, hb e₁]
    congr 1
    exact Scheme.Hom.appLE_eq_app k
  refine ⟨?_, ?_, ?_⟩
  · intro e
    rw [K _ _ e, ← Scheme.ΓSpecIso_inv_naturality]
  · intro T h e c
    have H : Set.range h ⊆ Set.range hU.fromSpec := by
      rintro _ ⟨t, rfl⟩
      rw [hU.range_fromSpec]
      exact e (show t ∈ (⊤ : T.Opens) from trivial)
    obtain ⟨l, rfl⟩ : ∃ l, l ≫ hU.fromSpec = h :=
      ⟨IsOpenImmersion.lift hU.fromSpec h H, IsOpenImmersion.lift_fac _ _ _⟩
    rw [K T l e, ← Category.assoc, cancel_mono, ← Category.assoc,
      Scheme.ΓSpecIso_inv_naturality, Category.assoc, Iso.cancel_iso_inv_left,
      ← Scheme.Hom.comp_appTop]
    exact ⟨fun H => H ▸ rfl, fun H => ext_of_isAffine H⟩
  · intro T ψ
    have hex : (Scheme.ΓSpecIso R).inv ≫ (T.toSpecΓ ≫ Spec.map ψ).appTop = ψ := by
      rw [Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop, ← Category.assoc,
        ← Scheme.ΓSpecIso_inv_naturality, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    refine ⟨T.toSpecΓ ≫ Spec.map ψ, hex, ?_⟩
    intro c' hc'
    exact ext_of_isAffine ((Iso.cancel_iso_inv_left _ _ _).mp (hc'.trans hex.symm))

theorem wc_csd_good_locus_open : ∀ (X T T' : Scheme.{u}) (I : X.IdealSheafData) (h : T ⟶ X) (g : T' ⟶ T) (U : X.affineOpens) (a b : Γ(X, U.1)) (t' : T'), a ∈ I.ideal U → wcCsdChartAt I h U b (g t') → wcCsdChartAt I (g ≫ h) U a t' → wcCsdChartAt I h U a (g t') :=
by
  intro X T T' I h g U a b t' ha H1 H2
  obtain ⟨V, e, hgV, hε, hρ⟩ := H1
  obtain ⟨V', e', ht', hA', hρ'⟩ := H2
  have hmap : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (χ : B ⟶ C) (J : Ideal A) (y : B),
      Ideal.map φ.hom J = Ideal.span {y} →
      Ideal.map (φ ≫ χ).hom J = Ideal.span {χ.hom y} := by
    intro A B C φ χ J y hy
    rw [CommRingCat.hom_comp, ← Ideal.map_map, hy, Ideal.map_span, Set.image_singleton]

  have hmem : (h.appLE U.1 V.1 e).hom a ∈ Ideal.span {(h.appLE U.1 V.1 e).hom b} := by
    rw [← hρ]; exact Ideal.mem_map_of_mem _ ha
  obtain ⟨c0, hc0⟩ := Ideal.mem_span_singleton'.mp hmem

  have htO : t' ∈ V'.1 ⊓ g ⁻¹ᵁ V.1 := ⟨ht', (g.mem_preimage).mpr hgV⟩
  obtain ⟨f, hfO, hft⟩ := V'.2.exists_basicOpen_le (V := V'.1 ⊓ g ⁻¹ᵁ V.1) ⟨t', htO⟩ ht'
  have iD : T'.basicOpen f ≤ V'.1 := T'.basicOpen_le f
  have eg : T'.basicOpen f ≤ g ⁻¹ᵁ V.1 := hfO.trans inf_le_right
  have F1 : (g ≫ h).appLE U.1 V'.1 e' ≫ T'.presheaf.map (homOfLE iD).op =
      (g ≫ h).appLE U.1 (T'.basicOpen f) (iD.trans e') := Scheme.Hom.appLE_map _ _ _
  have F2 : h.appLE U.1 V.1 e ≫ g.appLE V.1 (T'.basicOpen f) eg =
      (g ≫ h).appLE U.1 (T'.basicOpen f) (iD.trans e') :=
    Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _
  have hloc := V'.2.isLocalization_basicOpen f
  generalize (g ≫ h).appLE U.1 (T'.basicOpen f) (iD.trans e') = ψ at F1 F2
  have hN : ψ.hom a ∈ nonZeroDivisors Γ(T', T'.basicOpen f) := by
    rw [← F1]
    exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers f) Γ(T', T'.basicOpen f)
      ⟨((g ≫ h).appLE U.1 V'.1 e').hom a, hA', rfl⟩
  have G1 : Ideal.map ψ.hom (I.ideal U) = Ideal.span {ψ.hom a} := by
    rw [← F1, hmap _ _ _ _ hρ', CommRingCat.hom_comp, RingHom.comp_apply]
  have G2 : Ideal.map ψ.hom (I.ideal U) =
      Ideal.span {(g.appLE V.1 (T'.basicOpen f) eg).hom ((h.appLE U.1 V.1 e).hom b)} := by
    rw [← F2]; exact hmap _ _ _ _ hρ

  have hσε : (g.appLE V.1 (T'.basicOpen f) eg).hom ((h.appLE U.1 V.1 e).hom b) ∈
      Ideal.span {ψ.hom a} := by
    rw [← G1, G2]; exact Ideal.subset_span (Set.mem_singleton _)
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hσε
  have hψa : ψ.hom a = (g.appLE V.1 (T'.basicOpen f) eg).hom c0 *
      (g.appLE V.1 (T'.basicOpen f) eg).hom ((h.appLE U.1 V.1 e).hom b) := by
    rw [← F2, CommRingCat.hom_comp, RingHom.comp_apply, ← hc0, map_mul]
  have h0 : (1 - (g.appLE V.1 (T'.basicOpen f) eg).hom c0 * w) * ψ.hom a = 0 := by
    linear_combination hψa - (g.appLE V.1 (T'.basicOpen f) eg).hom c0 * hw
  have h1 := (mul_right_mem_nonZeroDivisors_eq_zero_iff hN).mp h0
  have hunit : IsUnit ((g.appLE V.1 (T'.basicOpen f) eg).hom c0) :=
    IsUnit.of_mul_eq_one w (by linear_combination -h1)

  have hB : T'.basicOpen f ⊓ g ⁻¹ᵁ T.basicOpen c0 = T'.basicOpen f :=
    (Scheme.basicOpen_appLE g (T'.basicOpen f) V.1 eg c0).symm.trans
      (Scheme.basicOpen_of_isUnit T' hunit)
  have h3 : t' ∈ T'.basicOpen f ⊓ g ⁻¹ᵁ T.basicOpen c0 := by rw [hB]; exact hft
  have hgW : g t' ∈ T.basicOpen c0 := (g.mem_preimage).mp h3.2

  have iW : T.basicOpen c0 ≤ V.1 := T.basicOpen_le c0
  have eW : T.basicOpen c0 ≤ h ⁻¹ᵁ U.1 := iW.trans e
  have FW : h.appLE U.1 V.1 e ≫ T.presheaf.map (homOfLE iW).op =
      h.appLE U.1 (T.basicOpen c0) eW := Scheme.Hom.appLE_map _ _ _
  have hlocW := V.2.isLocalization_basicOpen c0
  have U1 : IsUnit ((T.presheaf.map (homOfLE iW).op).hom c0) :=
    IsLocalization.Away.algebraMap_isUnit (S := Γ(T, T.basicOpen c0)) c0
  have U2 : (T.presheaf.map (homOfLE iW).op).hom ((h.appLE U.1 V.1 e).hom b) ∈
      nonZeroDivisors Γ(T, T.basicOpen c0) :=
    IsLocalization.map_nonZeroDivisors_le (Submonoid.powers c0) Γ(T, T.basicOpen c0)
      ⟨(h.appLE U.1 V.1 e).hom b, hε, rfl⟩
  refine ⟨⟨T.basicOpen c0, V.2.basicOpen c0⟩, eW, hgW, ?_, ?_⟩
  · show (h.appLE U.1 (T.basicOpen c0) eW).hom a ∈ nonZeroDivisors Γ(T, T.basicOpen c0)
    rw [← FW, CommRingCat.hom_comp, RingHom.comp_apply, ← hc0, map_mul]
    exact mul_mem_nonZeroDivisors.mpr ⟨U1.mem_nonZeroDivisors, U2⟩
  · show Ideal.map (h.appLE U.1 (T.basicOpen c0) eW).hom (I.ideal U) =
      Ideal.span {(h.appLE U.1 (T.basicOpen c0) eW).hom a}
    rw [← FW, hmap _ _ _ _ hρ, CommRingCat.hom_comp, RingHom.comp_apply, ← hc0, map_mul,
      Ideal.span_singleton_mul_left_unit U1]

theorem wc_csd_blowup_exists_noeth : ∀ (X : Scheme.{u}) [IsNoetherian X] (I : X.IdealSheafData), ∃ (X' : Scheme.{u}) (r : X' ⟶ X), wcCsdIsBlowup I r ∧ IsNoetherian X' :=
by
  intro X _ I
  classical

  have hmapcomp : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (σ : B ⟶ C) (J : Ideal A) (x : A),
      Ideal.map φ.hom J = Ideal.span {φ.hom x} →
      Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom x} := by
    intro A B C φ σ J x h
    rw [CommRingCat.hom_comp, ← Ideal.map_map, h, Ideal.map_span, Set.image_singleton]
    try rfl
  have hL5a : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (σ : B ⟶ C) (J : Ideal A) (x y : A),
      Ideal.map φ.hom J = Ideal.span {φ.hom x} → (φ ≫ σ).hom y ∈ nonZeroDivisors C →
      Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom y} →
      (φ ≫ σ).hom x ∈ nonZeroDivisors C ∧
        Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom x} := by
    intro A B C φ σ J x y hx hy hJy
    have hJx := hmapcomp φ σ J x hx
    refine ⟨?_, hJx⟩
    have hm : (φ ≫ σ).hom y ∈ Ideal.span {(φ ≫ σ).hom x} := by
      rw [← hJx, hJy]; exact Ideal.subset_span (Set.mem_singleton _)
    obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp hm
    rw [← hv] at hy
    exact (mul_mem_nonZeroDivisors.mp hy).2
  have hisoNZD : ∀ {B C : CommRingCat.{u}} (ε : B ≅ C) (y : B), y ∈ nonZeroDivisors B →
      ε.hom.hom y ∈ nonZeroDivisors C := by
    intro B C ε y hy
    rw [← MulEquivClass.map_nonZeroDivisors ε.commRingCatIsoToRingEquiv]
    exact ⟨y, hy, rfl⟩
  have hInv : ∀ {T : Scheme.{u}} (h : T ⟶ X), wcCsdInvPull I h ↔
      ∀ t : T, ∃ (U : X.affineOpens) (a : Γ(X, U.1)), a ∈ I.ideal U ∧ wcCsdChartAt I h U a t := by
    intro T h
    unfold wcCsdInvPull
    constructor
    · intro H t
      obtain ⟨U, V, e, a, ht, ha, h1, h2⟩ := H t
      exact ⟨U, a, ha, V, e, ht, h1, h2⟩
    · intro H t
      obtain ⟨U, a, ha, V, e, ht, h1, h2⟩ := H t
      exact ⟨U, V, e, a, ht, ha, h1, h2⟩

  have main : ∀ (K : Type u) [Finite K] (Uk : K → X.affineOpens) (ak : ∀ k, Γ(X, (Uk k).1)),
      (∀ k, ak k ∈ I.ideal (Uk k)) →
      (∀ (T : Scheme.{u}) (h : T ⟶ X), wcCsdInvPull I h → ∀ t : T,
        ∃ k, wcCsdChartAt I h (Uk k) (ak k) t) →
      (∀ U : X.affineOpens, ∃ (n : ℕ) (b : Fin n → Γ(X, U.1)),
        Ideal.span (Set.range b) = I.ideal U) →
      ∃ (X' : Scheme.{u}) (r : X' ⟶ X), wcCsdIsBlowup I r ∧ IsNoetherian X' := by
    intro K _ Uk ak hak hcovK hfg
    choose n b hb using hfg
    have hUa : ∀ k, IsAffineOpen (Uk k).1 := fun k => (Uk k).2
    have hchart : ∀ k, ∃ (R : CommRingCat.{u}) (φ : Γ(X, (Uk k).1) ⟶ R), IsNoetherianRing R ∧
        φ.hom (ak k) ∈ nonZeroDivisors R ∧
        Ideal.map φ.hom (I.ideal (Uk k)) = Ideal.span {φ.hom (ak k)} ∧
        ∀ (B : CommRingCat.{u}) (ρ : Γ(X, (Uk k).1) ⟶ B), ρ.hom (ak k) ∈ nonZeroDivisors B →
          Ideal.map ρ.hom (I.ideal (Uk k)) = Ideal.span {ρ.hom (ak k)} →
          ∃! ψ : R ⟶ B, φ ≫ ψ = ρ := by
      intro k
      haveI := IsLocallyNoetherian.component_noetherian (Uk k)
      exact wc_csd_bl_chart_algebra Γ(X, (Uk k).1) (I.ideal (Uk k)) (ak k) (hak k)
    choose R φ hRn hnz hid hUP using hchart
    have htopk : ∀ k, (⊤ : (Spec (R k)).Opens) ≤
        (Spec.map (φ k) ≫ (hUa k).fromSpec) ⁻¹ᵁ (Uk k).1 := by
      intro k x _
      show (Spec.map (φ k) ≫ (hUa k).fromSpec) x ∈ ((Uk k).1 : Set X)
      rw [Scheme.Hom.comp_apply, ← (hUa k).range_fromSpec]
      exact ⟨_, rfl⟩
    have hL4c := fun k => wc_csd_chart_spec_maps X (Uk k).1 (hUa k) (R k) (φ k)

    have hPres : ∀ (T T' : Scheme.{u}) (j : T' ⟶ T) [IsOpenImmersion j] (h : T ⟶ X),
        wcCsdInvPull I h → wcCsdInvPull I (j ≫ h) := by
      intro T T' j _ h hP
      rw [hInv] at hP ⊢
      intro t'
      obtain ⟨U, a, ha, hc⟩ := hP (j t')
      exact ⟨U, a, ha, (wc_csd_chart_open_imm X T T' I j h U a t').mp hc⟩

    have hPloc : ∀ (T : Scheme.{u}) (h : T ⟶ X),
        (∀ t : T, ∃ W : T.Opens, t ∈ W ∧ wcCsdInvPull I (W.ι ≫ h)) → wcCsdInvPull I h := by
      intro T h H
      rw [hInv]
      intro t
      obtain ⟨W, htW, hW⟩ := H t
      rw [hInv] at hW
      obtain ⟨U, a, ha, hc⟩ := hW ⟨t, htW⟩
      exact ⟨U, a, ha, (wc_csd_chart_open_imm X T W.toScheme I W.ι h U a ⟨t, htW⟩).mpr hc⟩

    have hGres : ∀ (k : K) (T T' : Scheme.{u}) (j : T' ⟶ T) [IsOpenImmersion j] (h : T ⟶ X),
        (∀ t : T, wcCsdChartAt I h (Uk k) (ak k) t) →
        ∀ t' : T', wcCsdChartAt I (j ≫ h) (Uk k) (ak k) t' := by
      intro k T T' j _ h hG t'
      exact (wc_csd_chart_open_imm X T T' I j h (Uk k) (ak k) t').mp (hG (j t'))

    have hGloc : ∀ (k : K) (T : Scheme.{u}) (h : T ⟶ X),
        (∀ t : T, ∃ W : T.Opens, t ∈ W ∧
          ∀ w : W.toScheme, wcCsdChartAt I (W.ι ≫ h) (Uk k) (ak k) w) →
        ∀ t : T, wcCsdChartAt I h (Uk k) (ak k) t := by
      intro k T h H t
      obtain ⟨W, htW, hW⟩ := H t
      exact (wc_csd_chart_open_imm X T W.toScheme I W.ι h (Uk k) (ak k) ⟨t, htW⟩).mpr
        (hW ⟨t, htW⟩)

    have hCov : ∀ (T : Scheme.{u}) (h : T ⟶ X), wcCsdInvPull I h → ∀ t : T,
        ∃ (k : K) (W : T.Opens), t ∈ W ∧
          ∀ w : W.toScheme, wcCsdChartAt I (W.ι ≫ h) (Uk k) (ak k) w := by
      intro T h hP t
      obtain ⟨k, V, e, htV, h1, h2⟩ := hcovK T h hP t
      refine ⟨k, V.1, htV, fun w => ?_⟩
      exact (wc_csd_chart_open_imm X T V.1.toScheme I V.1.ι h (Uk k) (ak k) w).mp
        ⟨V, e, w.2, h1, h2⟩

    have hGp : ∀ k (y : Spec (R k)),
        wcCsdChartAt I (Spec.map (φ k) ≫ (hUa k).fromSpec) (Uk k) (ak k) y := by
      intro k y
      refine ⟨⟨⊤, isAffineOpen_top _⟩, htopk k, trivial, ?_, ?_⟩
      · show ((Spec.map (φ k) ≫ (hUa k).fromSpec).appLE (Uk k).1 ⊤ (htopk k)).hom (ak k) ∈
          nonZeroDivisors Γ(Spec (R k), ⊤)
        rw [(hL4c k).1 (htopk k)]
        exact hisoNZD (Scheme.ΓSpecIso (R k)).symm _ (hnz k)
      · show Ideal.map ((Spec.map (φ k) ≫ (hUa k).fromSpec).appLE (Uk k).1 ⊤ (htopk k)).hom
            (I.ideal (Uk k)) =
          Ideal.span {((Spec.map (φ k) ≫ (hUa k).fromSpec).appLE (Uk k).1 ⊤ (htopk k)).hom (ak k)}
        rw [(hL4c k).1 (htopk k)]
        exact hmapcomp (φ k) _ _ _ (hid k)

    have hGP : ∀ (k : K) (T : Scheme.{u}) (h : T ⟶ X),
        (∀ t : T, wcCsdChartAt I h (Uk k) (ak k) t) → wcCsdInvPull I h := by
      intro k T h hG
      rw [hInv]
      intro t
      exact ⟨Uk k, ak k, hak k, hG t⟩

    have hRep : ∀ (k : K) (T : Scheme.{u}) (h : T ⟶ X),
        (∀ t : T, wcCsdChartAt I h (Uk k) (ak k) t) →
        ∃! c : T ⟶ Spec (R k), c ≫ Spec.map (φ k) ≫ (hUa k).fromSpec = h := by
      intro k T h hG
      have e : (⊤ : T.Opens) ≤ h ⁻¹ᵁ (Uk k).1 := by
        intro t _
        obtain ⟨V, eV, htV, -, -⟩ := hG t
        exact eV htV
      obtain ⟨hnzT, hidT⟩ := wc_csd_chart_global_sections X T I h (Uk k) (ak k) (hak k) hG e
      obtain ⟨ψ, hψ, hψu⟩ := hUP k _ (h.appLE (Uk k).1 ⊤ e) hnzT hidT
      obtain ⟨c, hc, hcu⟩ := (hL4c k).2.2 T ψ
      refine ⟨c, ((hL4c k).2.1 T h e c).mpr (by rw [hc]; exact hψ), fun c' hc' => ?_⟩
      exact hcu c' (hψu _ (((hL4c k).2.1 T h e c').mp hc'))

    have hInto : ∀ (k : K) (T : Scheme.{u}) (c : T ⟶ Spec (R k)),
        wcCsdInvPull I (c ≫ Spec.map (φ k) ≫ (hUa k).fromSpec) →
        ∀ t : T, wcCsdChartAt I (c ≫ Spec.map (φ k) ≫ (hUa k).fromSpec) (Uk k) (ak k) t := by
      intro k T c hP t
      obtain ⟨j, V, e, htV, hnzb, hidb⟩ := wc_csd_invpull_generator_chart X T I _ hP (Uk k)
        (n (Uk k)) (b (Uk k)) (hb (Uk k)) t
        (htopk k (show c t ∈ (⊤ : (Spec (R k)).Opens) from trivial))
      have e2 : V.1 ≤ c ⁻¹ᵁ ⊤ := fun _ _ => trivial
      have hc : (c ≫ Spec.map (φ k) ≫ (hUa k).fromSpec).appLE (Uk k).1 V.1 e =
          φ k ≫ ((Scheme.ΓSpecIso (R k)).inv ≫ c.appLE ⊤ V.1 e2) := by
        rw [← Scheme.Hom.appLE_comp_appLE c (Spec.map (φ k) ≫ (hUa k).fromSpec) (Uk k).1 ⊤ V.1
          (htopk k) e2, (hL4c k).1 (htopk k), Category.assoc]
      rw [hc] at hnzb hidb
      obtain ⟨h1, h2⟩ := hL5a (φ k) _ _ (ak k) _ (hid k) hnzb hidb
      exact ⟨V, e, htV, by rw [hc]; exact h1, by rw [hc]; exact h2⟩

    have hOpen : ∀ (k : K) (T T' : Scheme.{u}) (h : T ⟶ X) (g : T' ⟶ T), wcCsdInvPull I h →
        (∀ t' : T', wcCsdChartAt I (g ≫ h) (Uk k) (ak k) t') →
        ∀ t' : T', ∃ W : T.Opens, g t' ∈ W ∧
          ∀ w : W.toScheme, wcCsdChartAt I (W.ι ≫ h) (Uk k) (ak k) w := by
      intro k T T' h g hP hG t'
      have hmem : h (g t') ∈ (Uk k).1 := by
        obtain ⟨V, eV, htV, -, -⟩ := hG t'
        exact eV htV
      obtain ⟨j, hcb⟩ := wc_csd_invpull_generator_chart X T I h hP (Uk k) (n (Uk k)) (b (Uk k))
        (hb (Uk k)) (g t') hmem
      obtain ⟨W, eW, hgW, h1, h2⟩ :=
        wc_csd_good_locus_open X T T' I h g (Uk k) (ak k) _ t' (hak k) hcb (hG t')
      refine ⟨W.1, hgW, fun w => ?_⟩
      exact (wc_csd_chart_open_imm X T W.1.toScheme I W.1.ι h (Uk k) (ak k) w).mp
        ⟨W, eW, w.2, h1, h2⟩

    obtain ⟨X', r, s, hbl, hso, -, hsurj⟩ := wc_csd_glue_local_universal X K (fun k => Spec (R k))
      (fun k => Spec.map (φ k) ≫ (hUa k).fromSpec) (fun T h => wcCsdInvPull I h)
      (fun k T h => ∀ t : T, wcCsdChartAt I h (Uk k) (ak k) t)
      hPres hPloc hGres hGloc hCov hGp hGP hRep hInto hOpen
    refine ⟨X', r, hbl, ?_⟩

    have hcomp : CompactSpace X' := by
      constructor
      have hU : (Set.univ : Set X') = ⋃ k, Set.range (s k) := by
        ext x
        simp only [Set.mem_univ, Set.mem_iUnion, Set.mem_range, true_iff]
        exact hsurj x
      rw [hU]
      exact isCompact_iUnion fun k => isCompact_range (s k).continuous
    have hloc : IsLocallyNoetherian X' := by
      rw [isLocallyNoetherian_iff_openCover (Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) K
        (fun k => Spec (R k)) s hsurj hso)]
      intro k
      haveI := hRn k
      show IsLocallyNoetherian (Spec (R k))
      infer_instance
    exact { toIsLocallyNoetherian := hloc, toCompactSpace := hcomp }

  have hcover : (Set.univ : Set X) ⊆ ⋃ U : X.affineOpens, (U.1 : Set X) := by
    intro x _
    obtain ⟨W, hW, hxW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
    exact Set.mem_iUnion.mpr ⟨⟨W, hW⟩, hxW⟩
  obtain ⟨S, hS⟩ := isCompact_univ.elim_finite_subcover (fun U : X.affineOpens => (U.1 : Set X))
    (fun U => U.1.isOpen) hcover
  have hcov : ∀ x : X, ∃ U ∈ S, x ∈ U.1 := by
    intro x
    have hx := hS (Set.mem_univ x)
    simp only [Set.mem_iUnion] at hx
    obtain ⟨U, hU, hxU⟩ := hx
    exact ⟨U, hU, hxU⟩
  have hfg : ∀ U : X.affineOpens, ∃ (n : ℕ) (b : Fin n → Γ(X, U.1)),
      Ideal.span (Set.range b) = I.ideal U := by
    intro U
    haveI := IsLocallyNoetherian.component_noetherian U
    exact Submodule.fg_iff_exists_fin_generating_family.mp
      (_root_.IsNoetherian.noetherian (I.ideal U))
  choose n b hb using hfg
  refine main (Σ U : S, Fin (n U.1)) (fun k => k.1.1) (fun k => b k.1.1 k.2) ?_ ?_
    (fun U => ⟨n U, b U, hb U⟩)
  · intro k
    show b k.1.1 k.2 ∈ I.ideal k.1.1
    rw [← hb k.1.1]
    exact Ideal.subset_span ⟨k.2, rfl⟩
  · intro T h hP t
    obtain ⟨U, hUS, hmem⟩ := hcov (h t)
    obtain ⟨j, hj⟩ := wc_csd_invpull_generator_chart X T I h hP U (n U) (b U) (hb U) t hmem
    exact ⟨⟨⟨U, hUS⟩, j⟩, hj⟩

theorem wc_csd_comap_ideal_affine : ∀ (X Y : Scheme.{u}) (J : Y.IdealSheafData) (π : X ⟶ Y) (U : Y.affineOpens) (W : X.affineOpens) (e : W.1 ≤ π ⁻¹ᵁ U.1), (J.comap π).ideal W = Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) :=
by
  intro X Y J π U W e
  rw [Scheme.IdealSheafData.comap, Scheme.Hom.ker_apply]
  apply le_antisymm
  · have hW : IsAffineOpen W.1 := W.2
    have hU : IsAffineOpen U.1 := U.2
    set IB := Ideal.map (π.appLE U.1 W.1 e).hom (J.ideal U) with hIB
    have H : J.ideal U ≤ Ideal.comap (π.appLE U.1 W.1 e).hom IB := Ideal.le_comap_map
    let ψ : (Γ(Y, U.1) ⧸ J.ideal U) →+* (Γ(X, W.1) ⧸ IB) :=
      Ideal.quotientMap IB (π.appLE U.1 W.1 e).hom H
    let t : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X :=
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec
    let g : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ J.subscheme :=
      Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U
    have hw : t ≫ π = g ≫ J.subschemeι := by
      show (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ≫ π =
        (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι
      have hc := J.subschemeCover_map_subschemeι U
      rw [J.glueDataObjι_ι U] at hc
      have hg : (Spec.map (CommRingCat.ofHom ψ) ≫ J.subschemeCover.f U) ≫ J.subschemeι =
          Spec.map (CommRingCat.ofHom ψ) ≫
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (J.ideal U))) ≫ hU.fromSpec) :=
        (Category.assoc _ _ _).trans (congrArg (Spec.map (CommRingCat.ofHom ψ) ≫ ·) hc)
      rw [hg, Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec π hU hW e]
      rw [← Category.assoc, ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp]
      congr 2
    let l := Limits.pullback.lift t g hw
    have hl : l ≫ Limits.pullback.fst π J.subschemeι = t := Limits.pullback.lift_fst _ _ _
    intro b hb
    rw [RingHom.mem_ker] at hb
    have e0 : ⊤ ≤ t ⁻¹ᵁ W.1 := by
      intro p _
      show hW.fromSpec ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) p) ∈ (W.1 : Set X)
      rw [← hW.range_fromSpec]
      exact ⟨_, rfl⟩
    have h1 : ∀ (e : ⊤ ≤ (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec) ⁻¹ᵁ W.1),
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB)) ≫ hW.fromSpec).appLE W.1 ⊤ e =
          CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
      have hb : ∀ (e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1),
          hW.fromSpec.appLE W.1 ⊤ e₁ = (Scheme.ΓSpecIso Γ(X, W.1)).inv := by
        intro e₁
        rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc, ← Functor.map_comp]
        have hid : ∀ (f : Opposite.op (⊤ : (Spec Γ(X, W.1)).Opens) ⟶ Opposite.op ⊤),
            (Spec Γ(X, W.1)).presheaf.map f = 𝟙 _ := by
          intro f
          rw [show f = 𝟙 _ from Quiver.Hom.unop_inj (Subsingleton.elim _ _),
            CategoryTheory.Functor.map_id]
        rw [hid, Category.comp_id]
      intro e
      have e₁ : (⊤ : (Spec Γ(X, W.1)).Opens) ≤ hW.fromSpec ⁻¹ᵁ W.1 :=
        hW.fromSpec_preimage_self.ge
      have e₂ : (⊤ : (Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB))).Opens) ≤
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))) ⁻¹ᵁ ⊤ := le_top
      rw [← Scheme.Hom.appLE_comp_appLE _ hW.fromSpec W.1 ⊤ ⊤ e₁ e₂, hb e₁]
      have happ : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appLE ⊤ ⊤ e₂ =
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IB))).appTop :=
        Scheme.Hom.appLE_eq_app _
      rw [happ, ← Scheme.ΓSpecIso_inv_naturality]
    have key : ∀ (s : Spec (CommRingCat.of (Γ(X, W.1) ⧸ IB)) ⟶ X) (hs : s = t)
        (e1 : ⊤ ≤ s ⁻¹ᵁ W.1), s.appLE W.1 ⊤ e1 =
          CommRingCat.ofHom (Ideal.Quotient.mk IB) ≫ (Scheme.ΓSpecIso _).inv := by
      rintro s rfl e1
      exact h1 e1
    have e2 : ⊤ ≤ (l ≫ Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 := by
      rw [hl]; exact e0
    have h2 := key _ hl e2
    rw [Scheme.Hom.comp_appLE] at h2
    have h3 := congrArg (fun f => f.hom b) h2
    simp only [CommRingCat.comp_apply, hb, map_zero] at h3
    have h4 := congrArg (Scheme.ΓSpecIso (CommRingCat.of (Γ(X, W.1) ⧸ IB))).hom.hom h3
    simp only [map_zero, Iso.inv_hom_id_apply] at h4
    exact (Ideal.Quotient.eq_zero_iff_mem).mp h4.symm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker]
    have hP := Limits.pullback.condition (f := π) (g := J.subschemeι)
    have key : ∀ (s : Limits.pullback π J.subschemeι ⟶ Y)
        (hs : Limits.pullback.fst π J.subschemeι ≫ π = s)
        (e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤ s ⁻¹ᵁ U.1),
        ((Limits.pullback.fst π J.subschemeι).app W.1).hom ((π.appLE U.1 W.1 e).hom a) =
          (s.appLE U.1 _ e1).hom a := by
      rintro s rfl e1
      rw [Scheme.Hom.app_eq_appLE, ← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
    have e1 : (Limits.pullback.fst π J.subschemeι) ⁻¹ᵁ W.1 ≤
        (Limits.pullback.snd π J.subschemeι ≫ J.subschemeι) ⁻¹ᵁ U.1 := by
      rw [← hP]; intro x hx; exact e hx
    rw [key _ hP e1, Scheme.Hom.comp_appLE, CommRingCat.comp_apply]
    have h0 : (J.subschemeι.app U.1).hom a = 0 := by
      rw [← RingHom.mem_ker, Scheme.IdealSheafData.ker_subschemeι_app]; exact ha
    rw [h0, map_zero]

theorem wc_csd_invpull_local_generator : ∀ (Y T : Scheme.{u}) (J : Y.IdealSheafData) (h : T ⟶ Y) (U : Y.affineOpens) (V : T.affineOpens) (e : V.1 ≤ h ⁻¹ᵁ U.1) (ε : Γ(T, V.1)) (t : T), t ∈ V.1 → ε ∈ nonZeroDivisors Γ(T, V.1) → Ideal.map (h.appLE U.1 V.1 e).hom (J.ideal U) = Ideal.span {ε} → ∃ (V' : T.affineOpens) (e' : V'.1 ≤ h ⁻¹ᵁ U.1) (b : Γ(Y, U.1)), t ∈ V'.1 ∧ b ∈ J.ideal U ∧ (h.appLE U.1 V'.1 e').hom b ∈ nonZeroDivisors Γ(T, V'.1) ∧ Ideal.map (h.appLE U.1 V'.1 e').hom (J.ideal U) = Ideal.span {(h.appLE U.1 V'.1 e').hom b} :=
by
  intro Y T J h U V e ε t ht hε hmap
  classical

  have hεmem : ε ∈ Submodule.span Γ(T, V.1)
      ((h.appLE U.1 V.1 e).hom '' (J.ideal U : Set Γ(Y, U.1))) := by
    change ε ∈ Ideal.map (h.appLE U.1 V.1 e).hom (J.ideal U)
    rw [hmap]
    exact Ideal.mem_span_singleton_self ε
  obtain ⟨n, c, g, hcg⟩ := Submodule.mem_span_set'.mp hεmem
  have hg : ∀ i, ∃ a, a ∈ J.ideal U ∧ (h.appLE U.1 V.1 e).hom a = (g i : Γ(T, V.1)) :=
    fun i => (g i).2
  choose a ha hga using hg

  have hy : ∀ i, ∃ y, y * ε = (h.appLE U.1 V.1 e).hom (a i) := by
    intro i
    apply Ideal.mem_span_singleton'.mp
    rw [← hmap]
    exact Ideal.mem_map_of_mem _ (ha i)
  choose y hy using hy

  have hcy : ∑ i, c i * y i = 1 := by
    have h1 : (∑ i, c i * y i) * ε = ε := by
      rw [Finset.sum_mul]
      simp_rw [mul_assoc, hy, hga]
      simpa [smul_eq_mul] using hcg
    have h0 : (∑ i, c i * y i - 1) * ε = 0 := by rw [sub_mul, h1, one_mul, sub_self]
    exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hε).mp h0)

  obtain ⟨j, hj⟩ : ∃ j, t ∈ T.basicOpen (y j) := by
    by_contra hcon
    push_neg at hcon
    have hm : ∀ j, (T.presheaf.germ V.1 t ht).hom (c j * y j) ∈
        IsLocalRing.maximalIdeal (T.presheaf.stalk t) := by
      intro j
      rw [map_mul]
      apply Ideal.mul_mem_left
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen T (y j) t ht]
      exact hcon j
    have h1 := Ideal.sum_mem (IsLocalRing.maximalIdeal (T.presheaf.stalk t))
      (t := Finset.univ) (fun j _ => hm j)
    rw [← map_sum, hcy, map_one] at h1
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
      (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)

  have e' : T.basicOpen (y j) ≤ h ⁻¹ᵁ U.1 := (T.basicOpen_le (y j)).trans e
  have hform : ∀ x : Γ(Y, U.1), (h.appLE U.1 (T.basicOpen (y j)) e').hom x =
      (T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom ((h.appLE U.1 V.1 e).hom x) := by
    intro x
    rw [← Scheme.Hom.appLE_map h e (homOfLE (T.basicOpen_le (y j))).op]
    rfl
  have hcomp : (h.appLE U.1 (T.basicOpen (y j)) e').hom =
      (T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom.comp (h.appLE U.1 V.1 e).hom :=
    RingHom.ext hform
  have hε' : (T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom ε ∈
      nonZeroDivisors Γ(T, T.basicOpen (y j)) :=
    @IsLocalization.map_nonZeroDivisors_le _ _ (Submonoid.powers (y j)) _ _ _
      (V.2.isLocalization_basicOpen (y j)) _ (Submonoid.mem_map_of_mem _ hε)
  have hu : IsUnit ((T.presheaf.map (homOfLE (T.basicOpen_le (y j))).op).hom (y j)) :=
    @IsLocalization.Away.algebraMap_isUnit _ _ _ _ _ (y j) (V.2.isLocalization_basicOpen (y j))

  refine ⟨⟨T.basicOpen (y j), V.2.basicOpen (y j)⟩, e', a j, hj, ha j, ?_, ?_⟩
  · show (h.appLE U.1 (T.basicOpen (y j)) e').hom (a j) ∈ nonZeroDivisors Γ(T, T.basicOpen (y j))
    rw [hform, ← hy j, map_mul]
    exact mul_mem_nonZeroDivisors.mpr ⟨hu.mem_nonZeroDivisors, hε'⟩
  · show Ideal.map (h.appLE U.1 (T.basicOpen (y j)) e').hom (J.ideal U) =
      Ideal.span {(h.appLE U.1 (T.basicOpen (y j)) e').hom (a j)}
    rw [hform (a j), ← hy j, map_mul, Ideal.span_singleton_mul_left_unit hu, hcomp,
      ← Ideal.map_map, hmap, Ideal.map_span, Set.image_singleton]

theorem wc_csd_invpull_chart_shrink : ∀ (X T : Scheme.{u}) (I : X.IdealSheafData) (r : T ⟶ X) (t : T) (W₀ : X.affineOpens) (V₀ : T.affineOpens) (e₀ : V₀.1 ≤ r ⁻¹ᵁ W₀.1) (a : Γ(X, W₀.1)), t ∈ V₀.1 → (r.appLE W₀.1 V₀.1 e₀).hom a ∈ nonZeroDivisors Γ(T, V₀.1) → Ideal.map (r.appLE W₀.1 V₀.1 e₀).hom (I.ideal W₀) = Ideal.span {(r.appLE W₀.1 V₀.1 e₀).hom a} → ∀ (O : X.Opens), r t ∈ O → ∃ (W : X.affineOpens) (V : T.affineOpens) (e : V.1 ≤ r ⁻¹ᵁ W.1) (ε : Γ(T, V.1)), W.1 ≤ O ∧ t ∈ V.1 ∧ ε ∈ nonZeroDivisors Γ(T, V.1) ∧ Ideal.map (r.appLE W.1 V.1 e).hom (I.ideal W) = Ideal.span {ε} :=
by
  intro X T I r t W₀ V₀ e₀ a ht hnzd hspan O hO
  obtain ⟨f, hfO, hxf⟩ := W₀.2.exists_basicOpen_le (V := O) ⟨r t, hO⟩ (e₀ ht)
  have hD : T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f) = V₀.1 ⊓ r ⁻¹ᵁ X.basicOpen f :=
    Scheme.basicOpen_appLE _ _ _ _ _
  have e : (T.affineBasicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)).1 ≤
      r ⁻¹ᵁ (X.affineBasicOpen f).1 := by
    show T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f) ≤ r ⁻¹ᵁ X.basicOpen f
    rw [hD]; exact inf_le_right
  have htV : t ∈ (T.affineBasicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)).1 := by
    show t ∈ T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)
    rw [hD]; exact ⟨ht, hxf⟩
  let resT := T.presheaf.map (homOfLE (T.basicOpen_le ((r.appLE W₀.1 V₀.1 e₀).hom f))).op
  refine ⟨X.affineBasicOpen f, T.affineBasicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f), e,
    resT.hom ((r.appLE W₀.1 V₀.1 e₀).hom a), hfO, htV, ?_, ?_⟩
  · have hloc := V₀.2.isLocalization_basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)
    exact IsLocalization.map_nonZeroDivisors_le (Submonoid.powers ((r.appLE W₀.1 V₀.1 e₀).hom f))
      Γ(T, T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)) (Submonoid.mem_map_of_mem _ hnzd)
  · have e' : T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f) ≤ r ⁻¹ᵁ X.basicOpen f := e
    let resX := X.presheaf.map (homOfLE (X.basicOpen_le f)).op
    have h1 : Ideal.map resX.hom (I.ideal W₀) = I.ideal (X.affineBasicOpen f) :=
      I.map_ideal_basicOpen W₀ f
    show Ideal.map (r.appLE (X.basicOpen f) (T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
      (I.ideal (X.affineBasicOpen f)) = _
    calc Ideal.map (r.appLE (X.basicOpen f) (T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
          (I.ideal (X.affineBasicOpen f))
        = Ideal.map (r.appLE (X.basicOpen f) (T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)) e').hom
          (Ideal.map resX.hom (I.ideal W₀)) := by rw [h1]; rfl
      _ = Ideal.map (resX ≫ r.appLE (X.basicOpen f)
            (T.basicOpen ((r.appLE W₀.1 V₀.1 e₀).hom f)) e').hom (I.ideal W₀) := by
          rw [Ideal.map_map]; rfl
      _ = Ideal.map (r.appLE W₀.1 V₀.1 e₀ ≫ resT).hom (I.ideal W₀) := by
          rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
      _ = Ideal.map resT.hom (Ideal.map (r.appLE W₀.1 V₀.1 e₀).hom (I.ideal W₀)) := by
          rw [CommRingCat.hom_comp, Ideal.map_map]
      _ = _ := by rw [hspan, Ideal.map_span, Set.image_singleton]; rfl

theorem wc_csd_tower_refine : ∀ (K : Type u) [Field K] (n : ℕ) (B : Scheme.{u}) (jB : B ⟶ wcProjK K n) (U' : B.Opens) (k : ℕ) (X : Fin k → Scheme.{u}) (q : ∀ i, X i ⟶ B), IsClosedImmersion jB → (∀ i, wcCsdAdmTower B U' (X i) (q i)) → ∃ (X' : Scheme.{u}) (q' : X' ⟶ B) (π : ∀ i, X' ⟶ X i), wcCsdAdmTower B U' X' q' ∧ ∀ i, π i ≫ q i = q' :=
by
  classical
  intro K _ n B jB U' k X q hjB htow

  have hBn : AlgebraicGeometry.IsNoetherian B := by
    haveI := hjB
    haveI := wc_proj_space_isProper K n
    haveI : IsProper (jB ≫ wcProjKStr K n) := inferInstance
    haveI : IsLocallyNoetherian B := LocallyOfFiniteType.isLocallyNoetherian (jB ≫ wcProjKStr K n)
    haveI : CompactSpace B := QuasiCompact.compactSpace_of_compactSpace (jB ≫ wcProjKStr K n)
    exact { toIsLocallyNoetherian := ‹_›, toCompactSpace := ‹_› }

  have htrans : ∀ {X'' X₂ T : Scheme.{u}} (J : X₂.IdealSheafData) (b : X'' ⟶ X₂) (r : T ⟶ X''),
      wcCsdInvPull (J.comap b) r → wcCsdInvPull J (r ≫ b) := by
    intro X'' X₂ T J b r h t
    obtain ⟨W₀, V₀, e₀, a, ht, -, hnzd, hspan⟩ := h t
    obtain ⟨U, hU, hbU, -⟩ := exists_isAffineOpen_mem_and_subset (x := b (r t)) (U := ⊤) trivial
    obtain ⟨W, V, e, ε, hWO, htV, hε, hmap⟩ :=
      wc_csd_invpull_chart_shrink X'' T (J.comap b) r t W₀ V₀ e₀ a ht hnzd hspan (b ⁻¹ᵁ U) hbU
    have eW : W.1 ≤ b ⁻¹ᵁ (⟨U, hU⟩ : X₂.affineOpens).1 := hWO
    rw [wc_csd_comap_ideal_affine X'' X₂ J b ⟨U, hU⟩ W eW, Ideal.map_map] at hmap
    have e'' : V.1 ≤ (r ≫ b) ⁻¹ᵁ (⟨U, hU⟩ : X₂.affineOpens).1 := by
      intro x hx
      exact eW (e hx)
    have hcomp : (r.appLE W.1 V.1 e).hom.comp (b.appLE U W.1 eW).hom =
        ((r ≫ b).appLE U V.1 e'').hom := by
      rw [← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
    rw [hcomp] at hmap
    obtain ⟨V', e', b₀, htV', hb₀, hnzd', hspan'⟩ :=
      wc_csd_invpull_local_generator X₂ T J (r ≫ b) ⟨U, hU⟩ V e'' ε t htV hε hmap
    exact ⟨⟨U, hU⟩, V', e', b₀, htV', hb₀, hnzd', hspan'⟩

  have hsupp : ∀ {X'' X₂ : Scheme.{u}} (J : X₂.IdealSheafData) (b : X'' ⟶ X₂) (q₂ : X₂ ⟶ B)
      (q'' : X'' ⟶ B), b ≫ q₂ = q'' →
      (J.support : Set X₂) ∩ ((q₂ ⁻¹ᵁ U' : X₂.Opens) : Set X₂) = ∅ →
      ((J.comap b).support : Set X'') ∩ ((q'' ⁻¹ᵁ U' : X''.Opens) : Set X'') = ∅ := by
    intro X'' X₂ J b q₂ q'' hbq hJ
    rw [Scheme.IdealSheafData.support_comap]
    apply Set.eq_empty_of_forall_notMem
    rintro x ⟨hx, hx'⟩
    have hmem : b x ∈ (J.support : Set X₂) ∩ ((q₂ ⁻¹ᵁ U' : X₂.Opens) : Set X₂) := by
      refine ⟨hx, ?_⟩
      show q₂ (b x) ∈ U'
      rw [← Scheme.Hom.comp_apply, hbq]
      exact hx'
    rw [hJ] at hmem
    exact hmem

  have hpair : ∀ {X₂ : Scheme.{u}} {q₂ : X₂ ⟶ B}, wcCsdAdmTower B U' X₂ q₂ →
      ∀ (X0 : Scheme.{u}) (q0 : X0 ⟶ B), wcCsdAdmTower B U' X0 q0 →
        AlgebraicGeometry.IsNoetherian X0 →
      ∃ (X' : Scheme.{u}) (q' : X' ⟶ B) (a : X' ⟶ X0) (b : X' ⟶ X₂),
        wcCsdAdmTower B U' X' q' ∧ AlgebraicGeometry.IsNoetherian X' ∧ a ≫ q0 = q' ∧
          b ≫ q₂ = q' := by
    intro X₂ q₂ h₂
    induction h₂ with
    | base =>
      intro X0 q0 h0 hn0
      exact ⟨X0, q0, 𝟙 X0, q0, h0, hn0, Category.id_comp q0, Category.comp_id q0⟩
    | step q₂ J r _ hJ hb ih =>
      intro X0 q0 h0 hn0
      obtain ⟨X'', q'', a, b, h'', hn'', ha, hb'⟩ := ih X0 q0 h0 hn0
      haveI := hn''
      obtain ⟨X''', r'', hbl, hn'''⟩ := wc_csd_blowup_exists_noeth X'' (J.comap b)
      have htow3 : wcCsdAdmTower B U' X''' (r'' ≫ q'') :=
        wcCsdAdmTower.step q'' (J.comap b) r'' h'' (hsupp J b q₂ q'' hb' hJ) hbl
      obtain ⟨b'', hb''1, -⟩ := hb.2 X''' (r'' ≫ b) (htrans J b r'' hbl.1)
      refine ⟨X''', r'' ≫ q'', r'' ≫ a, b'', htow3, hn''', ?_, ?_⟩
      · rw [Category.assoc, ha]
      · rw [← Category.assoc, hb''1, Category.assoc, hb']

  have hall : ∀ (k : ℕ) (X : Fin k → Scheme.{u}) (q : ∀ i, X i ⟶ B),
      (∀ i, wcCsdAdmTower B U' (X i) (q i)) →
      ∃ (X' : Scheme.{u}) (q' : X' ⟶ B) (π : ∀ i, X' ⟶ X i), wcCsdAdmTower B U' X' q' ∧
        AlgebraicGeometry.IsNoetherian X' ∧ ∀ i, π i ≫ q i = q' := by
    intro k
    induction k with
    | zero =>
      intro X q _
      exact ⟨B, 𝟙 B, fun i => i.elim0, wcCsdAdmTower.base, hBn, fun i => i.elim0⟩
    | succ k ih =>
      intro X q htw
      obtain ⟨X'', q'', π'', h'', hn'', hπ''⟩ :=
        ih (fun j => X j.castSucc) (fun j => q j.castSucc) (fun j => htw j.castSucc)
      obtain ⟨X', q', a, b, h', hn', ha, hb⟩ := hpair (htw (Fin.last k)) X'' q'' h'' hn''
      refine ⟨X', q', fun i => Fin.lastCases (motive := fun i => X' ⟶ X i) b
        (fun j => a ≫ π'' j) i, h', hn', ?_⟩
      intro i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · dsimp only
        rw [Fin.lastCases_last]
        exact hb
      · dsimp only
        rw [Fin.lastCases_castSucc, Category.assoc, hπ'' j, ha]
  obtain ⟨X', q', π, h', -, hπ⟩ := hall k X q htow
  exact ⟨X', q', π, h', hπ⟩

theorem wc_csd_pqd_separation : ∀ (B : Scheme.{u}) [IsNoetherian B] (V U₀ : B.Opens) (Y : Scheme.{u}) (pY : Y ⟶ B) [IsAffineHom pY] [LocallyOfFiniteType pY] (f : U₀.toScheme ⟶ Y), U₀ ≤ V → f ≫ pY = U₀.ι → (∀ y ∈ closure (Set.range f), pY y ∈ V → y ∈ Set.range f) → ∃ (X₁ : Scheme.{u}) (q₁ : X₁ ⟶ B) (h : (q₁ ⁻¹ᵁ U₀).ι ≫ q₁ = ((q₁ ∣_ U₀) ≫ f) ≫ pY), wcCsdAdmTower B V X₁ q₁ ∧ IsNoetherian X₁ ∧ ∀ z ∈ closure (Set.range (Limits.pullback.lift (q₁ ⁻¹ᵁ U₀).ι ((q₁ ∣_ U₀) ≫ f) h)), Limits.pullback.fst q₁ pY z ∉ closure (((q₁ ⁻¹ᵁ V : X₁.Opens) : Set X₁) \ ((q₁ ⁻¹ᵁ U₀ : X₁.Opens) : Set X₁)) :=
by
  classical
  have wc_csd_chart_unit_off_support : ∀ (X T : Scheme.{u}) (I : X.IdealSheafData) (h : T ⟶ X) (U : X.affineOpens) (a : Γ(X, U.1)) (V : T.affineOpens) (e : V.1 ≤ h ⁻¹ᵁ U.1), Ideal.map (h.appLE U.1 V.1 e).hom (I.ideal U) = Ideal.span {(h.appLE U.1 V.1 e).hom a} → ∀ t : T, t ∈ V.1 → h t ∉ (I.support : Set X) → t ∈ T.basicOpen ((h.appLE U.1 V.1 e).hom a) := by
    intro X T I h U a V e hmap t ht hnot
    have htU : h t ∈ U.1 := e ht
    have h1 : h t ∉ X.zeroLocus (I.ideal U : Set Γ(X, U.1)) := fun hz =>
      hnot ((Scheme.IdealSheafData.mem_support_iff_of_mem htU).mpr hz)
    rw [Scheme.mem_zeroLocus_iff] at h1
    push_neg at h1
    obtain ⟨c, hc, hct⟩ := h1
    have hβc : (h.appLE U.1 V.1 e).hom c ∈ Ideal.span {(h.appLE U.1 V.1 e).hom a} := by
      rw [← hmap]; exact Ideal.mem_map_of_mem _ hc
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp hβc
    have h2 : t ∈ T.basicOpen ((h.appLE U.1 V.1 e).hom c) := by
      rw [Scheme.basicOpen_appLE]; exact ⟨ht, hct⟩
    rw [← hd, Scheme.basicOpen_mul] at h2
    exact h2.2
  have wc_csd_idealSheaf_pow : ∀ (X : Scheme.{u}) (I : X.IdealSheafData) (k : ℕ), 0 < k → ∃ K : X.IdealSheafData, (∀ U : X.affineOpens, K.ideal U = I.ideal U ^ k) ∧ (K.support : Set X) = (I.support : Set X) := by
    intro X I k hk
    have key : ∀ (U : X.affineOpens) (𝔞 : Ideal Γ(X, U.1)),
        X.zeroLocus ((𝔞 ^ k : Ideal Γ(X, U.1)) : Set Γ(X, U.1)) = X.zeroLocus (𝔞 : Set Γ(X, U.1)) := by
      intro U 𝔞
      ext x
      simp only [Scheme.mem_zeroLocus_iff, SetLike.mem_coe]
      constructor
      · intro H f hf
        have := H (f ^ k) (Ideal.pow_mem_pow hf k)
        rwa [Scheme.basicOpen_pow _ _ hk] at this
      · intro H f hf
        exact H f (Ideal.pow_le_self hk.ne' hf)
    refine ⟨Scheme.IdealSheafData.mk (fun U => I.ideal U ^ k) (fun U f => by
        rw [Ideal.map_pow, I.map_ideal_basicOpen]; rfl) I.supportSet (by
        rw [I.supportSet_eq_iInter_zeroLocus]
        exact Set.iInter_congr (fun U => (key U _).symm)), fun U => rfl, ?_⟩
    ext x
    simp only [SetLike.mem_coe, Scheme.IdealSheafData.mem_support_iff]
    exact forall_congr' (fun U => Iff.of_eq (congrArg (x ∈ ·) (key U (I.ideal U))))
  have wc_csd_sep_radical_power : ∀ (B Y : Scheme.{u}) (pY : Y ⟶ B) (I₁ I₂ : B.IdealSheafData) (Z : Set Y) (U : B.affineOpens), IsAffineOpen (pY ⁻¹ᵁ U.1) → (I₂.ideal U).FG → IsClosed Z → (∀ y ∈ Z, pY y ∈ (I₁.support : Set B) → pY y ∈ (I₂.support : Set B)) → ∃ k : ℕ, ∀ s ∈ I₂.ideal U ^ k, ∃ x₀ ∈ Ideal.map (pY.app U.1).hom (I₁.ideal U ^ 2), ∃ g : Γ(Y, pY ⁻¹ᵁ U.1), (∀ y ∈ Z, y ∈ pY ⁻¹ᵁ U.1 → y ∉ Y.basicOpen g) ∧ (pY.app U.1).hom s = x₀ + g := by
    intro B Y pY I₁ I₂ Z U hU' hfg hZ hZ1
    let IZ : Ideal Γ(Y, pY ⁻¹ᵁ U.1) :=
      { carrier := {g | ∀ y ∈ Z, y ∈ pY ⁻¹ᵁ U.1 → y ∉ Y.basicOpen g}
        add_mem' := by
          intro a b ha hb y hy hyU hab
          rcases Y.basicOpen_add_le a b hab with h | h
          · exact ha y hy hyU h
          · exact hb y hy hyU h
        zero_mem' := by
          intro y _ _ h
          rw [Scheme.basicOpen_zero] at h
          exact h
        smul_mem' := by
          intro c a ha y hy hyU h
          rw [smul_eq_mul, Scheme.basicOpen_mul] at h
          exact ha y hy hyU h.2 }
    have hIZ : ∀ g, g ∈ IZ ↔ ∀ y ∈ Z, y ∈ pY ⁻¹ᵁ U.1 → y ∉ Y.basicOpen g := fun g => Iff.rfl
    have hrad : Ideal.map (pY.app U.1).hom (I₂.ideal U) ≤
        (Ideal.map (pY.app U.1).hom (I₁.ideal U ^ 2) ⊔ IZ).radical := by
      rw [Ideal.radical_eq_sInf]
      refine le_sInf ?_
      rintro P ⟨hMP, hP⟩
      let pt : PrimeSpectrum Γ(Y, pY ⁻¹ᵁ U.1) := ⟨P, hP⟩
      have hyU : hU'.fromSpec pt ∈ pY ⁻¹ᵁ U.1 := by
        have : hU'.fromSpec pt ∈ Set.range hU'.fromSpec := ⟨pt, rfl⟩
        rwa [hU'.range_fromSpec] at this
      have hstar : ∀ r, hU'.fromSpec pt ∈ Y.basicOpen r ↔ r ∉ P := by
        intro r
        change pt ∈ hU'.fromSpec ⁻¹ᵁ Y.basicOpen r ↔ _
        rw [hU'.fromSpec_preimage_basicOpen r]
        exact PrimeSpectrum.mem_basicOpen r pt
      have hyZ : hU'.fromSpec pt ∈ Z := by
        by_contra hyZ
        let W : Y.Opens := pY ⁻¹ᵁ U.1 ⊓ ⟨Zᶜ, hZ.isOpen_compl⟩
        obtain ⟨r, hrW, hyr⟩ := hU'.exists_basicOpen_le (V := W) ⟨hU'.fromSpec pt, hyU, hyZ⟩ hyU
        have hrIZ : r ∈ IZ := by
          intro y' hy' _ hy'r
          exact (hrW hy'r).2 hy'
        exact (hstar r).mp hyr (hMP (Ideal.mem_sup_right hrIZ))
      have hpyU : pY (hU'.fromSpec pt) ∈ U.1 := hyU
      have hsupp1 : pY (hU'.fromSpec pt) ∈ (I₁.support : Set B) := by
        refine (Scheme.IdealSheafData.mem_support_iff_of_mem hpyU).mpr ?_
        rw [Scheme.mem_zeroLocus_iff]
        intro c hc hcb
        have h1 : (pY.app U.1).hom c ^ 2 ∈ P := by
          rw [← map_pow]
          exact hMP (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ (Ideal.pow_mem_pow hc 2)))
        have h2 : (pY.app U.1).hom c ∈ P := hP.mem_of_pow_mem 2 h1
        have h3 : hU'.fromSpec pt ∈ pY ⁻¹ᵁ B.basicOpen c := hcb
        rw [Scheme.preimage_basicOpen] at h3
        exact (hstar _).mp h3 h2
      have hsupp2 := hZ1 _ hyZ hsupp1
      rw [Ideal.map_le_iff_le_comap]
      intro c hc
      show (pY.app U.1).hom c ∈ P
      by_contra hcP
      have h3 := (hstar _).mpr hcP
      rw [← Scheme.preimage_basicOpen] at h3
      have h4 : pY (hU'.fromSpec pt) ∈ B.basicOpen c := h3
      have h5 := (Scheme.IdealSheafData.mem_support_iff_of_mem hpyU).mp hsupp2
      exact (Scheme.mem_zeroLocus_iff _ _ _).mp h5 c hc h4
    obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad (hfg.map (pY.app U.1).hom)
    refine ⟨n, fun s hs => ?_⟩
    have hmem : (pY.app U.1).hom s ∈ Ideal.map (pY.app U.1).hom (I₁.ideal U ^ 2) ⊔ IZ := by
      apply hn
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hs
    obtain ⟨x₀, hx₀, g, hg, hsum⟩ := Submodule.mem_sup.mp hmem
    exact ⟨x₀, hx₀, g, (hIZ g).mp hg, hsum.symm⟩
