  have hE : (Abelian.Ext.mk₀ (D1.Φ.map ρ ≫ D1.μ.hom)).comp (wcEtPull D2 1 β) (zero_add 1) = 0 := by
    rw [← Abelian.Ext.mk₀_comp_mk₀_assoc, ← hext, InjectiveResolution.mk₀_comp_extMk]
