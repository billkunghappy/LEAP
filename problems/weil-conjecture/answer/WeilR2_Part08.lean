  have hι : m • (Kc.liftCycles (D1.adj.homEquiv _ _ g) (1 + 1) (by simp) hf ≫
      Kc.homologyπ 1) = Kc.liftCycles k (1 + 1) (by simp) hkc ≫ Kc.homologyπ 1 := by
