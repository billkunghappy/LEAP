    have key : ∀ {T : Scheme.{u}} (a : T ⟶ S1) (b : T ⟶ N0), a ≫ s1 ≫ fS = b ≫ k ≫ aA →
        ∃ l : T ⟶ (V1 : Scheme.{u}), l ≫ V1.ι ≫ h1 = a ∧ l ≫ θ = b := by
      intro T a b hab
      obtain ⟨m, hmp, hmq⟩ : ∃ m : T ⟶ P, m ≫ p = a ≫ s1 ∧ m ≫ q = b ≫ k :=
        ⟨hP.lift (a ≫ s1) (b ≫ k) (by simpa only [Category.assoc] using hab),
          hP.lift_fst _ _ _, hP.lift_snd _ _ _⟩
      have hmr : Set.range m ⊆ Set.range U.ι := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨t, rfl⟩
        apply hN
        show q (m t) ∈ N
        rw [← Scheme.Hom.comp_apply, hmq, Scheme.Hom.comp_apply]
        exact hkN _
      obtain ⟨m', hm'⟩ : ∃ m' : T ⟶ (U : Scheme.{u}), m' ≫ U.ι = m :=
        ⟨IsOpenImmersion.lift U.ι m hmr, IsOpenImmersion.lift_fac _ _ _⟩
      obtain ⟨y, hyw, hyh⟩ : ∃ y : T ⟶ Y1, y ≫ w1 = m' ∧ y ≫ h1 = a :=
        ⟨hY1.lift m' a (by rw [← Category.assoc, hm', hmp]), hY1.lift_fst _ _ _,
          hY1.lift_snd _ _ _⟩
      have hyr : Set.range y ⊆ Set.range V1.ι := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨t, rfl⟩
        show y t ∈ V1
        rw [hmem, ← Scheme.Hom.comp_apply, ← Category.assoc, hyw, ← Category.assoc, hm', hmq,
          Scheme.Hom.comp_apply]
        exact hkN _
      refine ⟨IsOpenImmersion.lift V1.ι y hyr, ?_, ?_⟩
      · rw [← Category.assoc, IsOpenImmersion.lift_fac, hyh]
      · rw [← cancel_mono k, Category.assoc, hθk, ← Category.assoc, IsOpenImmersion.lift_fac,
          ← Category.assoc, hyw, ← Category.assoc, hm', hmq]
    have huniq : ∀ {T : Scheme.{u}} (l l' : T ⟶ (V1 : Scheme.{u})),
        l ≫ V1.ι ≫ h1 = l' ≫ V1.ι ≫ h1 → l ≫ θ = l' ≫ θ → l = l' := by
      intro T l l' e1 e2
      rw [← cancel_mono V1.ι]
      apply hY1.hom_ext
      · rw [← cancel_mono U.ι]
        apply hP.hom_ext
        · simp only [Category.assoc]
          rw [hYw, reassoc_of% e1]
        · simp only [Category.assoc]
          rw [← hθk, reassoc_of% e2]
      · simpa only [Category.assoc] using e1
    exact IsPullback.mk ⟨comm⟩ ⟨Limits.PullbackCone.IsLimit.mk comm
      (fun c => (key c.fst c.snd c.condition).choose)
      (fun c => (key c.fst c.snd c.condition).choose_spec.1)
      (fun c => (key c.fst c.snd c.condition).choose_spec.2)
      (fun c m hm1 hm2 => huniq _ _ ((hm1.trans (key c.fst c.snd c.condition).choose_spec.1.symm))
        (hm2.trans (key c.fst c.snd c.condition).choose_spec.2.symm))⟩

  have hs1 : ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S)
      (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P),
      IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) →
      z0 ≫ p = 𝟙 S →
      z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) →
      ((q ⁻¹ᵁ (⨆ i : Fin c, PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin c) K)) : P.Opens) : Set P) = (Set.range z0)ᶜ := by
    intro S fS c P p q z0 hP hz0p hz0q
    have hoa : Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) = 𝟙 _ := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap]
      simp
    have hz0sq : IsPullback z0 fS q (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) := by
      refine IsPullback.of_right ?_ hz0q hP
      rw [hz0p, hoa]
      exact IsPullback.id_horiz fS
    ext x
    rw [Set.mem_compl_iff]
    constructor
    · rintro hx ⟨s, hs⟩
      have hx' : q x ∈ (⨆ i : Fin c, PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin c) K)) := hx
      obtain ⟨i, hi⟩ := (TopologicalSpace.Opens.mem_iSup).mp hx'
      have hi' : (MvPolynomial.X i : MvPolynomial (Fin c) K) ∉ (q x).asIdeal := hi
      apply hi'
      have e : q x = Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) (fS s) := by
        rw [← hs, ← Scheme.Hom.comp_apply, hz0q, Scheme.Hom.comp_apply]
      rw [e]
      show MvPolynomial.constantCoeff (MvPolynomial.X i : MvPolynomial (Fin c) K) ∈ (fS s).asIdeal
      rw [MvPolynomial.constantCoeff_X]
      exact Ideal.zero_mem _
    · intro hx
      by_contra hcon
      apply hx
      have hX : ∀ i : Fin c, (MvPolynomial.X i : MvPolynomial (Fin c) K) ∈ (q x).asIdeal := by
        intro i
        by_contra hi
        exact hcon ((TopologicalSpace.Opens.mem_iSup (s := fun i : Fin c =>
          PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin c) K)) (x := q x)).mpr ⟨i, hi⟩)
      have hker : RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K) ≤ (q x).asIdeal := by
        intro f hf
        have hspan : f ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin c))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro mm hmm
          have hm0 : mm ≠ 0 := by
            rintro rfl
            rw [RingHom.mem_ker, MvPolynomial.constantCoeff_eq] at hf
            exact (MvPolynomial.mem_support_iff.mp hmm) hf
          obtain ⟨i, hi⟩ : ∃ i, mm i ≠ 0 := by
            by_contra hcon
            exact hm0 (Finsupp.ext fun a => by
              by_contra ha
              exact hcon ⟨a, ha⟩)
          exact ⟨i, Set.mem_univ _, hi⟩
        refine (Ideal.span_le.mpr ?_) hspan
        rintro _ ⟨i, -, rfl⟩
        exact hX i
      have hmax := RingHom.ker_isMaximal_of_surjective
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)
        (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ a⟩)
      have e1 := hmax.eq_of_le (q x).isPrime.ne_top hker
      have e2 := hmax.eq_of_le (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))
          (fS (p x))).isPrime.ne_top (fun f hf => by
            show MvPolynomial.constantCoeff f ∈ (fS (p x)).asIdeal
            rw [RingHom.mem_ker.mp hf]
            exact Ideal.zero_mem _)
      have hzo : q x = Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) (fS (p x)) :=
        PrimeSpectrum.ext (e1.symm.trans e2)
      obtain ⟨t, ht, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := q)
        (g := Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) x (fS (p x)) hzo
      refine ⟨hz0sq.isoPullback.inv t, ?_⟩
      rw [← Scheme.Hom.comp_apply, hz0sq.isoPullback_inv_fst, ht]

  have hs2 : ∃ ε : LaurentPolynomial K →+* Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K), IsPullback (Spec.map (CommRingCat.ofHom ((algebraMap (MvPolynomial (Fin (c' + 1)) K) (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K))).comp (MvPolynomial.rename (R := K) (Fin.succ : Fin c' → Fin (c' + 1))).toRingHom))) (Spec.map (CommRingCat.ofHom ε)) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) := by
    let ι := algebraMap (MvPolynomial (Fin (c' + 1)) K) (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K))
    let σ : MvPolynomial (Fin c') K →+* MvPolynomial (Fin (c' + 1)) K :=
      (MvPolynomial.rename (R := K) (Fin.succ : Fin c' → Fin (c' + 1))).toRingHom
    have hσC : ∀ r, σ (MvPolynomial.C r) = MvPolynomial.C r := fun r => MvPolynomial.rename_C _ r
    have hσX : ∀ i, σ (MvPolynomial.X i) = MvPolynomial.X i.succ := fun i => MvPolynomial.rename_X _ i
    have hιK : ∀ a : K, ι (MvPolynomial.C a) = algebraMap K (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)) a := by
      intro a
      rw [IsScalarTower.algebraMap_apply K (MvPolynomial (Fin (c' + 1)) K)]
      rfl
    let g0 : Polynomial K →+* Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) :=
      Polynomial.eval₂RingHom (algebraMap K _) (ι (MvPolynomial.X 0))
    have hg0 : IsUnit (g0 Polynomial.X) := by
      simp only [g0, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      exact IsLocalization.Away.algebraMap_isUnit _
    let ε : LaurentPolynomial K →+* Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) :=
      IsLocalization.Away.lift (Polynomial.X : Polynomial K) hg0
    have hε : ∀ f, ε (algebraMap (Polynomial K) (LaurentPolynomial K) f) = g0 f :=
      IsLocalization.Away.lift_eq _ hg0
    have hεT : ε (LaurentPolynomial.T 1) = ι (MvPolynomial.X 0) := by
      rw [← Polynomial.toLaurent_X, ← LaurentPolynomial.algebraMap_eq_toLaurent, hε]
      simp [g0]
    have hεC : ∀ a, ε (LaurentPolynomial.C a) = ι (MvPolynomial.C a) := by
      intro a
      rw [← Polynomial.toLaurent_C, ← LaurentPolynomial.algebraMap_eq_toLaurent, hε, hιK]
      simp [g0]
    have hLC : ∀ a : K, algebraMap K (LaurentPolynomial K) a = LaurentPolynomial.C a := by
      intro a
      rw [LaurentPolynomial.algebraMap_apply]
      rfl
    have hLext : ∀ {T : Type u} [CommRing T] (j k : LaurentPolynomial K →+* T),
        (∀ a, j (LaurentPolynomial.C a) = k (LaurentPolynomial.C a)) →
        j (LaurentPolynomial.T 1) = k (LaurentPolynomial.T 1) → j = k := by
      intro T _ j k hC hT
      apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial K))
      apply Polynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_C]
        exact hC a
      · simp only [RingHom.comp_apply, LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_X]
        exact hT
    have hLocext : ∀ {T : Type u} [CommRing T]
        (j k : Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) →+* T),
        (∀ a, j (ι (MvPolynomial.C a)) = k (ι (MvPolynomial.C a))) →
        (∀ i, j (ι (MvPolynomial.X i)) = k (ι (MvPolynomial.X i))) → j = k := by
      intro T _ j k hC hX
      apply IsLocalization.ringHom_ext (Submonoid.powers (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K))
      apply MvPolynomial.ringHom_ext
      · intro a; exact hC a
      · intro i; exact hX i
    refine ⟨ε, ?_⟩
    apply isPullback_SpecMap_of_isPushout
    have comm : CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)) ≫ CommRingCat.ofHom (ι.comp σ) =
        CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)) ≫ CommRingCat.ofHom ε := by
      rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      ext a
      simp only [RingHom.comp_apply]
      rw [hLC, hεC]
      show ι (σ (MvPolynomial.C a)) = _
      rw [hσC]
    let φ : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))
        (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))), MvPolynomial (Fin (c' + 1)) K →+* s.pt :=
      fun s => MvPolynomial.eval₂Hom (s.inl.hom.comp MvPolynomial.C)
        (Fin.cases (s.inr.hom (LaurentPolynomial.T 1)) (fun i => s.inl.hom (MvPolynomial.X i)))
    have hφC : ∀ s r, φ s (MvPolynomial.C r) = s.inl.hom (MvPolynomial.C r) := by
      intro s r
      simp [φ]
    have hφ0 : ∀ s, φ s (MvPolynomial.X 0) = s.inr.hom (LaurentPolynomial.T 1) := by
      intro s
      simp [φ]
    have hφS : ∀ s (i : Fin c'), φ s (MvPolynomial.X i.succ) = s.inl.hom (MvPolynomial.X i) := by
      intro s i
      simp [φ]
    have hφu : ∀ s, IsUnit (φ s (MvPolynomial.X 0)) := by
      intro s
      rw [hφ0]
      exact (LaurentPolynomial.isUnit_T 1).map _
    have hcond : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))
        (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))), ∀ a : K,
        s.inl.hom (MvPolynomial.C a) = s.inr.hom (LaurentPolynomial.C a) := by
      intro s a
      have := congrArg (fun f => f.hom a) s.condition
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at this
