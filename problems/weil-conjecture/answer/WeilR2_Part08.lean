      · refine hm2.trans ?_
        refine Eq.trans ?_ (Category.assoc _ _ _).symm
        refine Eq.trans ?_ (congrArg _ hm₁2).symm
        exact hN2.symm
    have hκN : κ = (D'.map t₂ ≫ μ) ≫ κ₁ := by
      apply Limits.pullback.hom_ext
      · refine hκ1.trans ?_
        refine Eq.trans ?_ (Category.assoc _ _ _).symm
        refine Eq.trans ?_ (congrArg _ hκ₁1).symm
        refine Eq.trans ?_ (Category.assoc _ _ _)
        refine Eq.trans ?_ (congrArg (fun g => g ≫ h₁) hN1).symm
        exact ((congrArg (fun g => _ ≫ g) (Category.assoc _ _ _).symm).trans
          (Category.assoc _ _ _).symm)
      · refine hκ2.trans ?_
        refine Eq.trans ?_ (Category.assoc _ _ _).symm
        refine Eq.trans ?_ (congrArg _ hκ₁2).symm
        refine Eq.trans ?_ (Category.assoc _ _ _)
        exact (congrArg (fun g => g ≫ Limits.pullback.snd (wcHalA1Proj s) z) hN2).symm
    rw [hmN, hκN]
    exact ht₂ _ q rfl

theorem wc_hal_geom_push_base_change : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ q)) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (L : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (wcHalA1 s)) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush (wcHalA1Proj s)) → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nonempty (L.obj ((wcEtPush z).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of Ω))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) ≅ (wcEtPush (Limits.pullback.fst (wcHalA1Proj s) z)).obj ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback (wcHalA1Proj s) z)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) :=
by
  classical
  intro K _ _ ℓ hℓ hℓK H3 A _ _ _ s L hadj Ω _ _ z
  set G := (wcEtPush z).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of Ω)))
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) with hGdef
  set H := (wcEtPush (Limits.pullback.fst (wcHalA1Proj s) z)).obj ((constantSheaf
    (Scheme.smallEtaleTopology (Limits.pullback (wcHalA1Proj s) z)) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) with hHdef
  haveI hcont := wc_et_basechange_isContinuous (wcHalA1Proj s)
  obtain ⟨ρ, hρU, -⟩ := wc_et_adjoint_univ_transport (wcHalA1Proj s) L hadj
  obtain ⟨eG0, heG0⟩ := wc_fnp_push_const_sections_lc (Spec (.of A)) (Spec (.of Ω)) z ℓ
  obtain ⟨eH0, heH0⟩ := wc_fnp_push_const_sections_lc (wcHalA1 s)
    (Limits.pullback (wcHalA1Proj s) z) (Limits.pullback.fst (wcHalA1Proj s) z) ℓ

  have hbcf : ∀ {Y Z : Scheme.{u}} (p : Z ⟶ Y) {V V' : Y.Etale} (c : V' ⟶ V),
      ((wcEtBaseChange p).map c).left ≫ Limits.pullback.fst V.hom p =
        Limits.pullback.fst V'.hom p ≫ c.left := by
    intro Y Z p V V' c
    first
      | exact Limits.pullback.lift_fst _ _ _
      | simp [wcEtBaseChange]
  have hbcs : ∀ {Y Z : Scheme.{u}} (p : Z ⟶ Y) {V V' : Y.Etale} (c : V' ⟶ V),
      ((wcEtBaseChange p).map c).left ≫ Limits.pullback.snd V.hom p =
        Limits.pullback.snd V'.hom p := by
    intro Y Z p V V' c
    first
      | exact Limits.pullback.lift_snd _ _ _
      | exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
      | simp [wcEtBaseChange]

  obtain ⟨eG, mz, hmz1, hmz2, heG⟩ : ∃ (e : ∀ V : (Spec (.of A)).Etale,
      G.obj.obj (Opposite.op V) ≃+ LocallyConstant ↥(Limits.pullback V.hom z) (ZMod ℓ))
      (mz : ∀ (V V' : (Spec (.of A)).Etale), (V' ⟶ V) →
        (Limits.pullback V'.hom z ⟶ Limits.pullback V.hom z)),
      (∀ (V V' : (Spec (.of A)).Etale) (c : V' ⟶ V),
        mz V V' c ≫ Limits.pullback.fst V.hom z = Limits.pullback.fst V'.hom z ≫ c.left) ∧
      (∀ (V V' : (Spec (.of A)).Etale) (c : V' ⟶ V),
        mz V V' c ≫ Limits.pullback.snd V.hom z = Limits.pullback.snd V'.hom z) ∧
      ∀ (V V' : (Spec (.of A)).Etale) (c : V' ⟶ V) (x : G.obj.obj (Opposite.op V))
        (q : ↥(Limits.pullback V'.hom z)),
        e V' ((G.obj.map c.op) x) q = e V x (mz V V' c q) :=
    ⟨eG0, fun V V' c => ((wcEtBaseChange z).map c).left, fun V V' c => hbcf z c,
      fun V V' c => hbcs z c, fun V V' c x q => heG0 V V' c x q⟩
  obtain ⟨eH, mf, hmf1, hmf2, heH⟩ : ∃ (e : ∀ O : (wcHalA1 s).Etale,
      H.obj.obj (Opposite.op O) ≃+
        LocallyConstant ↥(Limits.pullback O.hom (Limits.pullback.fst (wcHalA1Proj s) z)) (ZMod ℓ))
      (mf : ∀ (O O' : (wcHalA1 s).Etale), (O' ⟶ O) →
        (Limits.pullback O'.hom (Limits.pullback.fst (wcHalA1Proj s) z) ⟶
          Limits.pullback O.hom (Limits.pullback.fst (wcHalA1Proj s) z))),
      (∀ (O O' : (wcHalA1 s).Etale) (d : O' ⟶ O),
        mf O O' d ≫ Limits.pullback.fst O.hom (Limits.pullback.fst (wcHalA1Proj s) z) =
          Limits.pullback.fst O'.hom (Limits.pullback.fst (wcHalA1Proj s) z) ≫ d.left) ∧
      (∀ (O O' : (wcHalA1 s).Etale) (d : O' ⟶ O),
        mf O O' d ≫ Limits.pullback.snd O.hom (Limits.pullback.fst (wcHalA1Proj s) z) =
          Limits.pullback.snd O'.hom (Limits.pullback.fst (wcHalA1Proj s) z)) ∧
      ∀ (O O' : (wcHalA1 s).Etale) (d : O' ⟶ O) (y : H.obj.obj (Opposite.op O))
        (q : ↥(Limits.pullback O'.hom (Limits.pullback.fst (wcHalA1Proj s) z))),
        e O' ((H.obj.map d.op) y) q = e O y (mf O O' d q) :=
    ⟨eH0, fun O O' d => ((wcEtBaseChange (Limits.pullback.fst (wcHalA1Proj s) z)).map d).left,
      fun O O' d => hbcf (Limits.pullback.fst (wcHalA1Proj s) z) d,
      fun O O' d => hbcs (Limits.pullback.fst (wcHalA1Proj s) z) d,
      fun O O' d y q => heH0 O O' d y q⟩

  obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : ∀ (V : (Spec (.of A)).Etale) (O : (wcHalA1 s).Etale)
      (h : O.left ⟶ V.left), h ≫ V.hom = O.hom ≫ wcHalA1Proj s →
        (Limits.pullback O.hom (Limits.pullback.fst (wcHalA1Proj s) z) ⟶
          Limits.pullback V.hom z),
      (∀ (V : (Spec (.of A)).Etale) (O : (wcHalA1 s).Etale) (h : O.left ⟶ V.left)
        (hh : h ≫ V.hom = O.hom ≫ wcHalA1Proj s),
        κ V O h hh ≫ Limits.pullback.fst V.hom z =
          Limits.pullback.fst O.hom (Limits.pullback.fst (wcHalA1Proj s) z) ≫ h) ∧
      (∀ (V : (Spec (.of A)).Etale) (O : (wcHalA1 s).Etale) (h : O.left ⟶ V.left)
        (hh : h ≫ V.hom = O.hom ≫ wcHalA1Proj s),
        κ V O h hh ≫ Limits.pullback.snd V.hom z =
          Limits.pullback.snd O.hom (Limits.pullback.fst (wcHalA1Proj s) z) ≫
            Limits.pullback.snd (wcHalA1Proj s) z) :=
    ⟨fun V O h hh => Limits.pullback.lift
        (Limits.pullback.fst O.hom (Limits.pullback.fst (wcHalA1Proj s) z) ≫ h)
        (Limits.pullback.snd O.hom (Limits.pullback.fst (wcHalA1Proj s) z) ≫
          Limits.pullback.snd (wcHalA1Proj s) z)
        (by
          first
            | (rw [Category.assoc, hh, Limits.pullback.condition_assoc, Limits.pullback.condition,
                Category.assoc])
            | (simp only [Category.assoc, hh, Limits.pullback.condition_assoc,
                Limits.pullback.condition]; done)
            | simp [hh, Limits.pullback.condition, Limits.pullback.condition_assoc]),
      fun _ _ _ _ => Limits.pullback.lift_fst _ _ _,
      fun _ _ _ _ => Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨κc, hκc⟩ : ∃ κc : ∀ (V : (Spec (.of A)).Etale) (O : (wcHalA1 s).Etale)
      (h : O.left ⟶ V.left), h ≫ V.hom = O.hom ≫ wcHalA1Proj s →
        C(↥(Limits.pullback O.hom (Limits.pullback.fst (wcHalA1Proj s) z)),
          ↥(Limits.pullback V.hom z)),
      ∀ (V : (Spec (.of A)).Etale) (O : (wcHalA1 s).Etale) (h : O.left ⟶ V.left)
        (hh : h ≫ V.hom = O.hom ≫ wcHalA1Proj s)
        (q : ↥(Limits.pullback O.hom (Limits.pullback.fst (wcHalA1Proj s) z))),
        κc V O h hh q = κ V O h hh q :=
    ⟨fun V O h hh => ⟨fun q => κ V O h hh q, (κ V O h hh).continuous⟩,
      fun _ _ _ _ _ => rfl⟩

  have hκnat : ∀ (V V' : (Spec (.of A)).Etale) (c : V' ⟶ V) (O O' : (wcHalA1 s).Etale)
      (d : O' ⟶ O) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ wcHalA1Proj s)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ wcHalA1Proj s),
      h' ≫ c.left = d.left ≫ h →
        mf O O' d ≫ κ V O h hh = κ V' O' h' hh' ≫ mz V V' c := by
    intro V V' c O O' d h hh h' hh' hc
    apply Limits.pullback.hom_ext
    · first
        | (rw [Category.assoc, Category.assoc, hκ1, hmz1, ← Category.assoc, hmf1,
            ← Category.assoc, hκ1, Category.assoc, Category.assoc, hc])
        | (simp only [Category.assoc, hκ1, hmz1, reassoc_of% (hmf1 O O' d),
            reassoc_of% (hκ1 V' O' h' hh'), reassoc_of% hc])
    · first
        | (rw [Category.assoc, Category.assoc, hκ2, hmz2, hκ2, ← Category.assoc, hmf2])
        | (simp only [Category.assoc, hκ2, hmz2, reassoc_of% (hmf2 O O' d)])
  have hpt : ∀ (V V' : (Spec (.of A)).Etale) (c : V' ⟶ V) (O O' : (wcHalA1 s).Etale)
      (d : O' ⟶ O) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ wcHalA1Proj s)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ wcHalA1Proj s),
      h' ≫ c.left = d.left ≫ h →
        ∀ q, mz V V' c (κ V' O' h' hh' q) = κ V O h hh (mf O O' d q) := by
    intro V V' c O O' d h hh h' hh' hc q
    have e := hκnat V V' c O O' d h hh h' hh' hc
    first
      | (rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, e])
      | exact (congrArg (fun φ : Limits.pullback O'.hom (Limits.pullback.fst (wcHalA1Proj s) z) ⟶
          Limits.pullback V.hom z => φ q) e).symm

  obtain ⟨ρ', hρ'⟩ : ∃ ρ' : ∀ (V : (Spec (.of A)).Etale) (O : (wcHalA1 s).Etale)
      (h : O.left ⟶ V.left), h ≫ V.hom = O.hom ≫ wcHalA1Proj s →
        (G.obj.obj (Opposite.op V) →+ H.obj.obj (Opposite.op O)),
      ∀ (V : (Spec (.of A)).Etale) (O : (wcHalA1 s).Etale) (h : O.left ⟶ V.left)
        (hh : h ≫ V.hom = O.hom ≫ wcHalA1Proj s) (x : G.obj.obj (Opposite.op V)),
        ρ' V O h hh x = (eH O).symm (LocallyConstant.comap (κc V O h hh) (eG V x)) :=
    ⟨fun V O h hh => (eH O).symm.toAddMonoidHom.comp
        ((LocallyConstant.comapAddMonoidHom (κc V O h hh)).comp (eG V).toAddMonoidHom),
      fun _ _ _ _ _ => rfl⟩
  obtain ⟨σ, hσ⟩ : ∃ σ : wcEtTransport (wcHalA1Proj s) G H, σ.ρ = ρ' :=
    ⟨{ ρ := ρ'
       nat := by
        intro V V' c O O' d h hh h' hh' hc x
        rw [hρ', hρ']
        apply (eH O').injective
        rw [AddEquiv.apply_symm_apply]
        ext q
        rw [LocallyConstant.coe_comap_apply, hκc]
        refine Eq.trans ?_ (heH O O' d _ q).symm
        rw [AddEquiv.apply_symm_apply, LocallyConstant.coe_comap_apply, hκc]
        refine (heG V V' c x _).trans ?_
        exact congrArg (eG V x) (hpt V V' c O O' d h hh h' hh' hc q) }, rfl⟩

  obtain ⟨β, hβ, -⟩ := hρU G H σ

  haveI hmono : Mono β := by
    refine wc_et_univ_transport_mono_crit (wcHalA1Proj s) G (L.obj G) H (ρ G) (hρU G) β ?_
    intro V O h hh x hx
    rw [hβ, hσ, hρ'] at hx
    have hx2 : LocallyConstant.comap (κc V O h hh) (eG V x) = 0 := by
      have h1 := congrArg (eH O) hx
      rwa [AddEquiv.apply_symm_apply, map_zero] at h1
    have hx' : ∀ q, eG V x (κ V O h hh q) = 0 := by
      intro q
      have h2 := DFunLike.congr_fun hx2 q
      rw [LocallyConstant.coe_comap_apply, hκc] at h2
      exact h2
    obtain ⟨W₁, c, h₁, hcomp, hh₁, hvan⟩ := wc_hal_bc_lc_injective K A s Ω z ℓ V O h hh
      (eG V x) (κ V O h hh) (hκ1 V O h hh) (hκ2 V O h hh) hx'
    refine ⟨W₁, c, h₁, hh₁, hcomp, ?_⟩
    apply (eG W₁).injective
    rw [map_zero]
    ext q
    refine (heG V W₁ c x q).trans ?_
    exact hvan (mz V W₁ c) (hmz1 V W₁ c) (hmz2 V W₁ c) q

  haveI : LocallyOfFiniteType (wcHalA1Proj s) := by
    have hπ : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
      HasRingHomProperty.Spec_iff.mpr (RingHom.finiteType_algebraMap.mpr inferInstance)
    exact MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
      (IsPullback.of_hasPullback s _).flip hπ
  haveI hepi : Epi β := by
    apply Preadditive.epi_of_isZero_cokernel
    apply wc_et_zero_of_fibre_closed_stalks (wcHalA1Proj s)
    intro x hfc
    apply wc_r2gc_stalk_coker_subsingleton
    apply wc_bfpi_stalk_surj_of_local_surj
    intro O s₀ o ho
    subst ho
    obtain ⟨O₁, c, o₁, W, h, hh, d, hc₁, hagree⟩ :=
      wc_hal_bc_lc_local_surj K ℓ hℓ hℓK H3 A s Ω z O o hfc (eH O s₀)
    refine ⟨O₁, c, o₁, (ρ G).ρ W O₁ h hh ((eG W).symm d), hc₁, ?_⟩
    rw [hβ, hσ, hρ']
    apply (eH O₁).injective
    rw [AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    ext q
    rw [LocallyConstant.coe_comap_apply, hκc]
    refine Eq.trans ?_ (heH O O₁ c s₀ q).symm
    exact (hagree (mf O O₁ c) (κ W O₁ h hh) (hmf1 O O₁ c) (hmf2 O O₁ c) (hκ1 W O₁ h hh)
      (hκ2 W O₁ h hh) q).symm
  haveI := isIso_of_mono_of_epi β
  exact ⟨asIso β⟩

theorem wc_vnr_evaluation_surjective : ∀ (P : Scheme.{u}) [IsAffine P], (∀ f : Γ(P, ⊤), ∃ t : Γ(P, ⊤), f * f * t = f) → ∀ (p : P), Function.Surjective (P.evaluation ⊤ p trivial).hom :=
by
  intro P _ hR p
  have hU := isAffineOpen_top P
  let x₀ : (⊤ : P.Opens) := ⟨p, trivial⟩
  letI : Algebra Γ(P, ⊤) (P.presheaf.stalk p) := TopCat.Presheaf.algebra_section_stalk P.presheaf x₀
  haveI hL := hU.isLocalization_stalk x₀
  have hg : Function.Surjective (P.presheaf.germ ⊤ p trivial).hom := by
    intro z
    obtain ⟨⟨r, s⟩, hz⟩ := IsLocalization.surj (hU.primeIdealOf x₀).asIdeal.primeCompl z
    obtain ⟨t, ht⟩ := hR (s : Γ(P, ⊤))
    have hu := IsLocalization.map_units (P.presheaf.stalk p) s
    have hφ : algebraMap Γ(P, ⊤) (P.presheaf.stalk p) = (P.presheaf.germ ⊤ p trivial).hom :=
      TopCat.Presheaf.stalk_open_algebraMap _ x₀
    rw [hφ] at hz hu
    simp only at hz
    refine ⟨r * t, ?_⟩
    have h1 : (P.presheaf.germ ⊤ p trivial).hom (s : Γ(P, ⊤)) *
        ((P.presheaf.germ ⊤ p trivial).hom (s : Γ(P, ⊤)) * (P.presheaf.germ ⊤ p trivial).hom t) =
        (P.presheaf.germ ⊤ p trivial).hom (s : Γ(P, ⊤)) * 1 := by
      rw [mul_one, ← map_mul, ← map_mul, ← mul_assoc, ht]
    have h2 := hu.mul_left_cancel h1
    calc (P.presheaf.germ ⊤ p trivial).hom (r * t)
        = (P.presheaf.germ ⊤ p trivial).hom r * (P.presheaf.germ ⊤ p trivial).hom t := map_mul _ _ _
      _ = z * (P.presheaf.germ ⊤ p trivial).hom (s : Γ(P, ⊤)) *
          (P.presheaf.germ ⊤ p trivial).hom t := by rw [hz]
      _ = z * ((P.presheaf.germ ⊤ p trivial).hom (s : Γ(P, ⊤)) *
          (P.presheaf.germ ⊤ p trivial).hom t) := mul_assoc _ _ _
      _ = z := by rw [h2, mul_one]
  intro y
  obtain ⟨w, rfl⟩ := P.residue_surjective p y
  obtain ⟨g, rfl⟩ := hg w
  exact ⟨g, rfl⟩

theorem wc_vnr_factor_fromSpecResidueField : ∀ (P : Scheme.{u}) [IsAffine P], (∀ f : Γ(P, ⊤), ∃ t : Γ(P, ⊤), f * f * t = f) → ∀ (p : P), Function.Surjective (P.evaluation ⊤ p trivial).hom → ∀ (T' : Scheme.{u}) (ζ : T' ⟶ P), (∀ e : Γ(P, ⊤), e * e = e → p ∈ P.basicOpen e → ∀ x : T', ζ x ∈ P.basicOpen e) → ∃ z₀ : T' ⟶ Spec (P.residueField p), z₀ ≫ P.fromSpecResidueField p = ζ :=
by
  intro P _ hR p hsurj T' ζ hζ
  have hker : ∀ f : Γ(P, ⊤), (P.evaluation ⊤ p trivial).hom f = 0 → ζ.appTop.hom f = 0 := by
    intro f hf
    obtain ⟨t, ht⟩ := hR f
    have he : (f * t) * (f * t) = f * t := by
      calc (f * t) * (f * t) = (f * f * t) * t := by ring
        _ = f * t := by rw [ht]
    have hfe : f * (f * t) = f := by rw [← mul_assoc, ht]
    have h1e : (1 - f * t) * (1 - f * t) = 1 - f * t := by
      calc (1 - f * t) * (1 - f * t) = 1 - f * t - f * t + (f * t) * (f * t) := by ring
        _ = 1 - f * t := by rw [he]; ring
    have hp : p ∈ P.basicOpen (1 - f * t) := by
      refine (Scheme.evaluation_ne_zero_iff_mem_basicOpen P (U := ⊤) p trivial (1 - f * t)).mp ?_
      have h1 : (P.evaluation ⊤ p trivial).hom (1 - f * t) = 1 := by
        rw [map_sub, map_one, map_mul, hf, zero_mul, sub_zero]
      intro h0
      have h2 : (P.evaluation ⊤ p trivial).hom (1 - f * t) = 0 := h0
      rw [h1] at h2
      exact one_ne_zero h2
    have hall := hζ (1 - f * t) h1e hp
    have hg : ζ.appTop.hom (f * t) * ζ.appTop.hom (f * t) = ζ.appTop.hom (f * t) := by
      rw [← map_mul, he]
    have hgx : ∀ x : T', x ∈ T'.basicOpen (1 - ζ.appTop.hom (f * t)) := by
      intro x
      have h2 : x ∈ ζ ⁻¹ᵁ P.basicOpen (1 - f * t) := hall x
      rw [Scheme.preimage_basicOpen_top] at h2
      have h3 : ζ.appTop.hom (1 - f * t) = 1 - ζ.appTop.hom (f * t) := by
        rw [map_sub, map_one]
      rw [← h3]
      exact h2
    have hg0 : ζ.appTop.hom (f * t) = 0 := by
      apply TopCat.Presheaf.section_ext T'.sheaf ⊤
      intro x hx
      have hu := (Scheme.mem_basicOpen_top T' (1 - ζ.appTop.hom (f * t)) x).mp (hgx x)
      have hmul : (T'.presheaf.germ ⊤ x trivial).hom (ζ.appTop.hom (f * t)) *
          (T'.presheaf.germ ⊤ x trivial).hom (1 - ζ.appTop.hom (f * t)) = 0 := by
        rw [← map_mul, mul_sub, mul_one, hg, sub_self, map_zero]
      have h4 := (IsUnit.mul_left_eq_zero hu).mp hmul
      have h5 : (T'.presheaf.germ ⊤ x trivial).hom (ζ.appTop.hom (f * t)) =
          (T'.presheaf.germ ⊤ x trivial).hom 0 := by
        rw [map_zero]; exact h4
      exact h5
    rw [← hfe, map_mul, hg0, mul_zero]
  have hker' : RingHom.ker (P.evaluation ⊤ p trivial).hom ≤ RingHom.ker ζ.appTop.hom := by
    intro f hf
    rw [RingHom.mem_ker] at hf ⊢
    exact hker f hf
  let ψ := ((P.evaluation ⊤ p trivial).hom.liftOfSurjective hsurj) ⟨ζ.appTop.hom, hker'⟩
  have hψ : ψ.comp (P.evaluation ⊤ p trivial).hom = ζ.appTop.hom :=
    RingHom.liftOfSurjective_comp _ _ _
  let ψc : P.residueField p ⟶ Γ(T', ⊤) := CommRingCat.ofHom ψ
  have hL : P.evaluation ⊤ p trivial ≫ ψc = ζ.appTop := by
    apply CommRingCat.hom_ext
    exact hψ
  refine ⟨T'.toSpecΓ ≫ Spec.map ψc, ?_⟩
  rw [← cancel_mono P.toSpecΓ]
  have hres : P.fromSpecResidueField p ≫ P.toSpecΓ = Spec.map (P.evaluation ⊤ p trivial) := by
    rw [Scheme.fromSpecResidueField, Category.assoc, Scheme.fromSpecStalk_toSpecΓ,
      ← Spec.map_comp]
    exact congrArg Spec.map (P.germ_residue (U := ⊤) p trivial)
  have hS : Spec.map ψc ≫ Spec.map (P.evaluation ⊤ p trivial) = Spec.map ζ.appTop := by
    rw [← hL]
    exact (Spec.map_comp _ _).symm
  rw [Category.assoc, Category.assoc, hres, hS, Scheme.toSpecΓ_naturality]

theorem wc_vnr_point_clopen_limit : ∀ (P : Scheme.{u}) [IsAffine P] (p : P), (∀ (T' : Scheme.{u}) (ζ : T' ⟶ P), (∀ e : Γ(P, ⊤), e * e = e → p ∈ P.basicOpen e → ∀ x : T', ζ x ∈ P.basicOpen e) → ∃ z₀ : T' ⟶ Spec (P.residueField p), z₀ ≫ P.fromSpecResidueField p = ζ) → ∃ (Λ : Type u) (_ : SmallCategory Λ) (_ : IsCofiltered Λ) (W : Λ ⥤ P.Etale) (E : Λ → Γ(P, ⊤)) (φ : ∀ l, Spec (P.residueField p) ⟶ (W.obj l).left), (∀ l, IsAffine (W.obj l).left) ∧ (∀ l, IsOpenImmersion (W.obj l).hom) ∧ (∀ l, E l * E l = E l) ∧ (∀ l, p ∈ P.basicOpen (E l)) ∧ (∀ l, Set.range (W.obj l).hom = (P.basicOpen (E l) : Set P)) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') ∧ (∀ l, φ l ≫ (W.obj l).hom = P.fromSpecResidueField p) ∧ (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (P.residueField p), ∀ l, z₀ ≫ φ l = z l) :=
by
  intro P _ p hfac
  let Λ : Type u := {e : Γ(P, ⊤) // e * e = e ∧ p ∈ P.basicOpen e}
  letI : Preorder Λ := Preorder.lift (fun e : Λ => P.basicOpen e.1)
  have hmem : ∀ a b : Λ, (a.1 * b.1) * (a.1 * b.1) = a.1 * b.1 ∧
      p ∈ P.basicOpen (a.1 * b.1) := by
    intro a b
    refine ⟨?_, ?_⟩
    · rw [mul_mul_mul_comm, a.2.1, b.2.1]
    · rw [Scheme.basicOpen_mul]
      exact ⟨a.2.2, b.2.2⟩
  haveI : IsCodirectedOrder Λ := ⟨fun a b => ⟨⟨a.1 * b.1, hmem a b⟩, by
      show P.basicOpen (a.1 * b.1) ≤ P.basicOpen a.1
      rw [Scheme.basicOpen_mul]
      exact inf_le_left, by
      show P.basicOpen (a.1 * b.1) ≤ P.basicOpen b.1
      rw [Scheme.basicOpen_mul]
      exact inf_le_right⟩⟩
  let l₁ : Λ := ⟨1, mul_one 1, by rw [Scheme.basicOpen_one]; trivial⟩
  haveI : Nonempty Λ := ⟨l₁⟩
  haveI hcof : IsCofiltered Λ := isCofiltered_of_directed_ge_nonempty Λ
  let W : Λ ⥤ P.Etale :=
    { obj := fun l => Scheme.Etale.mk (P.basicOpen l.1).ι
      map := fun {l l'} t => MorphismProperty.Over.homMk
        (P.homOfLE (show P.basicOpen l.1 ≤ P.basicOpen l'.1 from leOfHom t))
        (P.homOfLE_ι _) trivial
      map_id := fun l => by
        apply MorphismProperty.Over.Hom.ext
        exact Scheme.homOfLE_rfl P _
      map_comp := fun {l₁ l₂ l₃} f g => by
        apply MorphismProperty.Over.Hom.ext
        exact (Scheme.homOfLE_homOfLE P
          (show P.basicOpen l₁.1 ≤ P.basicOpen l₂.1 from leOfHom f)
          (show P.basicOpen l₂.1 ≤ P.basicOpen l₃.1 from leOfHom g)).symm }
  have hWw : ∀ {l l' : Λ} (t : l ⟶ l'), (W.map t).left ≫ (W.obj l').hom = (W.obj l).hom :=
    fun t => MorphismProperty.Over.w (W.map t)
  have hM : ∀ l, Mono (W.obj l).hom := fun l =>
    show Mono (P.basicOpen l.1).ι from inferInstance
  have H : ∀ l : Λ, Set.range (P.fromSpecResidueField p) ⊆ Set.range (P.basicOpen l.1).ι := by
    intro l
    rw [Scheme.range_fromSpecResidueField, Scheme.Opens.range_ι, Set.singleton_subset_iff]
    exact l.2.2
  let φ0 : ∀ l : Λ, Spec (P.residueField p) ⟶ (P.basicOpen l.1).toScheme := fun l =>
    @IsOpenImmersion.lift _ _ _ (P.basicOpen l.1).ι (P.fromSpecResidueField p)
      (Scheme.Opens.instIsOpenImmersionι _) (H l)
  have hφ0 : ∀ l : Λ, φ0 l ≫ (P.basicOpen l.1).ι = P.fromSpecResidueField p := fun l =>
    @IsOpenImmersion.lift_fac _ _ _ (P.basicOpen l.1).ι (P.fromSpecResidueField p)
      (Scheme.Opens.instIsOpenImmersionι _) (H l)
  let φ : ∀ l, Spec (P.residueField p) ⟶ (W.obj l).left := φ0
  have hφ : ∀ l, φ l ≫ (W.obj l).hom = P.fromSpecResidueField p := hφ0
  have hc : ∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l' := by
    intro l l' t
    haveI := hM l'
    rw [← cancel_mono (W.obj l').hom, Category.assoc, hWw, hφ, hφ]
  have hlim : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left),
      (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') →
      ∃! z₀ : T ⟶ Spec (P.residueField p), ∀ l, z₀ ≫ φ l = z l := by
    intro T z hz
    have hind : ∀ l, z l ≫ (W.obj l).hom = z l₁ ≫ (W.obj l₁).hom := by
      intro l
      have ha : z l ≫ (W.obj l).hom =
          z (IsCofiltered.min l l₁) ≫ (W.obj (IsCofiltered.min l l₁)).hom := by
        rw [← hz (IsCofiltered.minToLeft l l₁), Category.assoc, hWw]
      have hb : z l₁ ≫ (W.obj l₁).hom =
          z (IsCofiltered.min l l₁) ≫ (W.obj (IsCofiltered.min l l₁)).hom := by
        rw [← hz (IsCofiltered.minToRight l l₁), Category.assoc, hWw]
      rw [ha, hb]
    have hland : ∀ e : Γ(P, ⊤), e * e = e → p ∈ P.basicOpen e →
        ∀ x : T, (z l₁ ≫ (W.obj l₁).hom) x ∈ P.basicOpen e := by
      intro e he hp x
      rw [← hind ⟨e, he, hp⟩, Scheme.Hom.comp_apply]
      have hr := Set.mem_range_self (f := (P.basicOpen e).ι) (z ⟨e, he, hp⟩ x)
      rw [Scheme.Opens.range_ι] at hr
      exact hr
    obtain ⟨z₀, hz₀⟩ := hfac T (z l₁ ≫ (W.obj l₁).hom) hland
    refine ⟨z₀, fun l => ?_, fun y hy => ?_⟩
    · haveI := hM l
      rw [← cancel_mono (W.obj l).hom, Category.assoc, hφ, hz₀, hind l]
    · rw [← cancel_mono (P.fromSpecResidueField p), hz₀, ← hφ l₁, ← Category.assoc, hy]
  refine ⟨Λ, inferInstance, hcof, W, fun l => l.1, φ, fun l => ?_, fun l => ?_,
    fun l => l.2.1, fun l => l.2.2, fun l => ?_, hc, hφ, hlim⟩
  · exact show IsAffine (Scheme.Etale.mk (P.basicOpen l.1).ι).left from
      (isAffineOpen_top P).basicOpen l.1
  · exact show IsOpenImmersion (P.basicOpen l.1).ι from inferInstance
  · exact Scheme.Opens.range_ι _

theorem wc_et_local_death_clopen_nbhd : ∀ (P T : Scheme.{u}) (h : T ⟶ P) [IsAffineHom h] (p : P) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ P.Etale) (E : Λ → Γ(P, ⊤)) (φ : ∀ l, Spec (P.residueField p) ⟶ (W.obj l).left), (∀ l, IsAffine (W.obj l).left) → (∀ l, IsOpenImmersion (W.obj l).hom) → (∀ l, Set.range (W.obj l).hom = (P.basicOpen (E l) : Set P)) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = P.fromSpecResidueField p) → (∀ (T₀ : Scheme.{u}) (z : ∀ l, T₀ ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T₀ ⟶ Spec (P.residueField p), ∀ l, z₀ ≫ φ l = z l) → ∀ (m q : ℕ), 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback h (P.fromSpecResidueField p)) m q) → ∀ (J : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (z : (J.cocomplex.X q).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 T)))), ((J.cocomplex.d q (q + 1)).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 T)))).hom z = 0 → ∃ (l : Λ) (β : (J.cocomplex.X (q - 1)).obj.obj (Opposite.op (Scheme.Etale.mk (h ⁻¹ᵁ P.basicOpen (E l)).ι))), ∀ g : Scheme.Etale.mk (h ⁻¹ᵁ P.basicOpen (E l)).ι ⟶ Scheme.Etale.mk (𝟙 T), ((J.cocomplex.d (q - 1) q).hom.app (Opposite.op (Scheme.Etale.mk (h ⁻¹ᵁ P.basicOpen (E l)).ι))).hom β = ((J.cocomplex.X q).obj.map g.op).hom z :=
by
  intro P T h _ p Λ _ _ W E φ hA hO hrg hc hφ hlim m q hq hfib J z hz
  classical

  have TU : ∀ (V : T.Etale) (a b : V ⟶ Scheme.Etale.mk (𝟙 T)), a = b := by
    intro V a b
    apply MorphismProperty.Over.Hom.ext
    have ha : a.left ≫ (Scheme.Etale.mk (𝟙 T)).hom = V.hom := by
      first
        | exact MorphismProperty.Over.w a
        | simpa using a.w
    have hb : b.left ≫ (Scheme.Etale.mk (𝟙 T)).hom = V.hom := by
      first
        | exact MorphismProperty.Over.w b
        | simpa using b.w
    change a.left ≫ 𝟙 T = V.hom at ha
    change b.left ≫ 𝟙 T = V.hom at hb
    exact (Category.comp_id a.left).symm.trans (ha.trans (hb.symm.trans (Category.comp_id b.left)))

  have N : ∀ (i j : ℕ) {V V' : T.Etale} (k : V ⟶ V')
      (x : (J.cocomplex.X i).obj.obj (Opposite.op V')),
      ((J.cocomplex.d i j).hom.app (Opposite.op V)).hom (((J.cocomplex.X i).obj.map k.op).hom x) =
      ((J.cocomplex.X j).obj.map k.op).hom (((J.cocomplex.d i j).hom.app (Opposite.op V')).hom x) := by
    intro i j V V' k x
    have key := congrArg (fun ψ => ψ.hom x) ((J.cocomplex.d i j).hom.naturality k.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at key
    exact key

  have Fn : ∀ (i : ℕ) {V V' V'' : T.Etale} (k₁ : V ⟶ V') (k₂ : V' ⟶ V'')
      (x : (J.cocomplex.X i).obj.obj (Opposite.op V'')),
      ((J.cocomplex.X i).obj.map k₁.op).hom (((J.cocomplex.X i).obj.map k₂.op).hom x) =
      ((J.cocomplex.X i).obj.map (k₁ ≫ k₂).op).hom x := by
    intro i V V' V'' k₁ k₂ x
    rw [op_comp, Functor.map_comp]
    rfl

  have s3 : ∀ (V : P.Etale) (U : P.Opens), IsOpenImmersion V.hom → Set.range V.hom = (U : Set P) →
      Nonempty (Scheme.Etale.mk (h ⁻¹ᵁ U).ι ⟶ (wcEtBaseChange h).obj V) := by
    intro V U hV hU
    have hsub : Set.range ((h ⁻¹ᵁ U).ι ≫ h) ⊆ Set.range V.hom := by
      rintro _ ⟨x, rfl⟩
      rw [hU]
      have hx : (h ⁻¹ᵁ U).ι x ∈ ((h ⁻¹ᵁ U : T.Opens) : Set T) := by
        rw [← Scheme.Opens.range_ι (h ⁻¹ᵁ U)]
        exact ⟨x, rfl⟩
      first
        | exact hx
        | simpa [Scheme.Hom.comp_apply] using hx
    let k := IsOpenImmersion.lift V.hom ((h ⁻¹ᵁ U).ι ≫ h) hsub
    have hk : k ≫ V.hom = (h ⁻¹ᵁ U).ι ≫ h := IsOpenImmersion.lift_fac _ _ _
    let κ₀ : (h ⁻¹ᵁ U : Scheme) ⟶ Limits.pullback V.hom h := Limits.pullback.lift k (h ⁻¹ᵁ U).ι hk
    exact ⟨MorphismProperty.Over.homMk κ₀ (Limits.pullback.lift_snd _ _ _) trivial⟩

  have s2 : ∀ (G : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1} ⥤ (Λᵒᵖ ⥤ AddCommGrpCat.{u+1}))
      [(G ⋙ Limits.colim).PreservesZeroMorphisms]
      (C : HomologicalComplex (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) (ComplexShape.up ℕ)),
      Subsingleton ((((G ⋙ Limits.colim).mapHomologicalComplex (ComplexShape.up ℕ)).obj C).homology q) →
      ∀ (l : Λ) (x : (G.obj (C.X q)).obj (Opposite.op l)),
        ((G.map (C.d q (q + 1))).app (Opposite.op l)).hom x = 0 →
        ∃ (l' : Λ) (t : l' ⟶ l) (β : (G.obj (C.X (q - 1))).obj (Opposite.op l')),
          ((G.map (C.d (q - 1) q)).app (Opposite.op l')).hom β = ((G.obj (C.X q)).map t.op).hom x := by
    intro G _ C hH l x hx
    let K := ((G ⋙ Limits.colim).mapHomologicalComplex (ComplexShape.up ℕ)).obj C
    have hex : K.ExactAt q := by
      rw [HomologicalComplex.exactAt_iff_isZero_homology]
      exact AddCommGrpCat.isZero_of_subsingleton _
    rw [HomologicalComplex.exactAt_iff' K (q - 1) q (q + 1)
      ((ComplexShape.up ℕ).prev_eq' (show q - 1 + 1 = q by omega))
      ((ComplexShape.up ℕ).next_eq' rfl), ShortComplex.ab_exact_iff] at hex
    haveI := Limits.preservesFilteredColimitsOfSize_shrink.{u, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
    have hd : ∀ (i j : ℕ) (n : Λᵒᵖ) (w : (G.obj (C.X i)).obj n),
        (K.d i j).hom ((Limits.colimit.ι (G.obj (C.X i)) n).hom w) =
          (Limits.colimit.ι (G.obj (C.X j)) n).hom (((G.map (C.d i j)).app n).hom w) := by
      intro i j n w
      have e1 : Limits.colimit.ι (G.obj (C.X i)) n ≫ K.d i j =
          (G.map (C.d i j)).app n ≫ Limits.colimit.ι (G.obj (C.X j)) n :=
        Limits.colimit.ι_map (G.map (C.d i j)) n
      exact congrArg (fun f => f.hom w) e1
    obtain ⟨y, hy⟩ := hex ((Limits.colimit.ι (G.obj (C.X q)) (Opposite.op l)).hom x) (by
      change (K.d q (q + 1)).hom ((Limits.colimit.ι (G.obj (C.X q)) (Opposite.op l)).hom x) = 0
      rw [hd, hx, map_zero])
    obtain ⟨j₀, β₁, hβ₁⟩ := Limits.Concrete.colimit_exists_rep (G.obj (C.X (q - 1))) y
    have heq : (Limits.colimit.ι (G.obj (C.X q)) j₀).hom (((G.map (C.d (q - 1) q)).app j₀).hom β₁) =
        (Limits.colimit.ι (G.obj (C.X q)) (Opposite.op l)).hom x := by
      have h1 := hd (q - 1) q j₀ β₁
      have h2 := congrArg (fun w => (K.d (q - 1) q).hom w) hβ₁
      exact h1.symm.trans (h2.trans hy)
    obtain ⟨k, f, g, hfg⟩ := (Limits.Concrete.colimit_rep_eq_iff_exists (G.obj (C.X q))
      (i := j₀) (j := Opposite.op l) (((G.map (C.d (q - 1) q)).app j₀).hom β₁) x).1 heq
    refine ⟨k.unop, g.unop, ((G.obj (C.X (q - 1))).map f).hom β₁, ?_⟩
    have nat := congrArg (fun ψ => ψ.hom β₁) ((G.map (C.d (q - 1) q)).naturality f)
    exact nat.trans hfg

  obtain ⟨e⟩ := wc_et_limit_push_homology_affine h (↑(P.residueField p)) Λ W φ
    (P.fromSpecResidueField p) hA hc hφ hlim m J q
  have hH := @Equiv.subsingleton _ _ e hfib
  obtain ⟨l₀⟩ : Nonempty Λ := IsCofiltered.nonempty
  let ρ : ∀ V : T.Etale, V ⟶ Scheme.Etale.mk (𝟙 T) := fun V =>
    MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
  obtain ⟨l', t, β₀, hβ₀⟩ := s2 (sheafToPresheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft (P.Etale)ᵒᵖ (T.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (@Functor.op P.Etale _ T.Etale _ (wcEtBaseChange h)) ⋙
      (Functor.whiskeringLeft Λᵒᵖ (P.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj W.op)
    J.cocomplex hH l₀
    (((J.cocomplex.X q).obj.map (ρ ((wcEtBaseChange h).obj (W.obj l₀))).op).hom z) (by
      change ((J.cocomplex.d q (q + 1)).hom.app
          (Opposite.op ((wcEtBaseChange h).obj (W.obj l₀)))).hom
        (((J.cocomplex.X q).obj.map (ρ ((wcEtBaseChange h).obj (W.obj l₀))).op).hom z) = 0
      rw [N, hz, map_zero])
  have hβ₀' : ((J.cocomplex.d (q - 1) q).hom.app
      (Opposite.op ((wcEtBaseChange h).obj (W.obj l')))).hom β₀ =
      ((J.cocomplex.X q).obj.map ((wcEtBaseChange h).map (W.map t) ≫
        ρ ((wcEtBaseChange h).obj (W.obj l₀))).op).hom z := by
    rw [← Fn]
    exact hβ₀
  obtain ⟨κ⟩ := s3 (W.obj l') (P.basicOpen (E l')) (hO l') (hrg l')
  refine ⟨l', ((J.cocomplex.X (q - 1)).obj.map κ.op).hom β₀, fun g => ?_⟩
  rw [N, hβ₀', Fn, TU _ (κ ≫ _) g]

theorem wc_affine_idempotent_disjoint_refinement : ∀ (P : Scheme.{u}) [IsAffine P] (V : P → Γ(P, ⊤)), (∀ p, V p * V p = V p) → (∀ p, p ∈ P.basicOpen (V p)) → ∃ (n : ℕ) (pt : Fin n → P) (O : Fin n → P.Opens), (∀ i j, i ≠ j → ∀ x : P, x ∈ O i → x ∈ O j → False) ∧ (∀ x : P, ∃ i, x ∈ O i) ∧ ∀ i, ∀ x : P, x ∈ O i → x ∈ P.basicOpen (V (pt i)) :=
by
  classical
  intro P _ V hidem hmem
  have hcompl : ∀ (e : Γ(P, ⊤)), e * e = e → IsOpen ((P.basicOpen e : Set P)ᶜ) := by
    intro e he
    have hset : ((P.basicOpen e : Set P)ᶜ) = (P.basicOpen (1 - e) : Set P) := by
      ext x
      simp only [Set.mem_compl_iff, SetLike.mem_coe, Scheme.mem_basicOpen_top]
      rw [map_sub, map_one]
      set g := (P.presheaf.germ ⊤ x trivial).hom e with hg
      have hgg : g * g = g := by rw [hg, ← map_mul, he]
      constructor
      · intro hn
        exact (IsLocalRing.isUnit_or_isUnit_one_sub_self g).resolve_left hn
      · intro h1 hu
        have h0 : g * (1 - g) = 0 := by rw [mul_sub, mul_one, hgg, sub_self]
        have h2 := hu.mul h1
        rw [h0] at h2
        exact not_isUnit_zero h2
    rw [hset]
    exact (P.basicOpen (1 - e)).isOpen
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x : P => (P.basicOpen (V x) : Set P))
    (fun x => IsOpen.mem_nhds (P.basicOpen (V x)).isOpen (hmem x))
  let n := t.card
  let pt : Fin n → P := fun i => ((t.equivFin.symm i : t) : P)
  let U : Fin n → Set P := fun i => (P.basicOpen (V (pt i)) : Set P)
  have hUo : ∀ i, IsOpen (U i) := fun i => (P.basicOpen (V (pt i))).isOpen
  have hUc : ∀ i, IsOpen (U i)ᶜ := fun i => hcompl _ (hidem _)
  have hcov : ∀ x : P, ∃ i, x ∈ U i := by
    intro x
    have hx : x ∈ ⋃ y ∈ t, (P.basicOpen (V y) : Set P) := by rw [ht]; trivial
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp hx
    refine ⟨t.equivFin ⟨y, hy⟩, ?_⟩
    show x ∈ (P.basicOpen (V (((t.equivFin.symm (t.equivFin ⟨y, hy⟩)) : t) : P)) : Set P)
    rw [Equiv.symm_apply_apply]
    exact hxy
  let O : Fin n → Set P := fun i => U i ∩ ⋂ (j : {j : Fin n // j < i}), (U j.1)ᶜ
  have hOo : ∀ i, IsOpen (O i) := fun i =>
    (hUo i).inter (isOpen_iInter_of_finite (fun j => hUc j.1))
  refine ⟨n, pt, fun i => ⟨O i, hOo i⟩, ?_, ?_, ?_⟩
  · intro i j hij x hxi hxj
    have hxi' : x ∈ O i := hxi
    have hxj' : x ∈ O j := hxj
    rcases lt_or_gt_of_ne hij with h | h
    · exact (Set.mem_iInter.mp hxj'.2 ⟨i, h⟩) hxi'.1
    · exact (Set.mem_iInter.mp hxi'.2 ⟨j, h⟩) hxj'.1
  · intro x
    have hex := hcov x
    refine ⟨Fin.find (fun k => x ∈ U k) hex, ?_⟩
    show x ∈ O _
    refine ⟨Fin.find_spec hex, Set.mem_iInter.mpr fun j => ?_⟩
    exact Fin.find_min hex j.2
  · intro i x hx
    exact hx.1

theorem wc_et_disjoint_open_cover_coboundary : ∀ (Y : Scheme.{u}) (A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (d : A ⟶ B) (n : ℕ) (O : Fin n → Y.Opens), (∀ i j, i ≠ j → ∀ y : Y, y ∈ O i → y ∈ O j → False) → (∀ y : Y, ∃ i, y ∈ O i) → ∀ (z : B.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))) (β : ∀ i, A.obj.obj (Opposite.op (Scheme.Etale.mk (O i).ι))), (∀ i (g : Scheme.Etale.mk (O i).ι ⟶ Scheme.Etale.mk (𝟙 Y)), (d.hom.app (Opposite.op (Scheme.Etale.mk (O i).ι))).hom (β i) = (B.obj.map g.op).hom z) → ∃ b : A.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))), (d.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom b = z :=
by
  intro Y A B d n O hdisj hcov z β hβ
  classical

  have bij : ∀ {S : Scheme.{u}} (T : S.Etale) (m : ℕ) (Ti : Fin m → S.Etale) (t : ∀ i, Ti i ⟶ T),
      (∀ i, IsOpenImmersion (t i).left) →
      (∀ i j, i ≠ j → Disjoint (Set.range (t i).left) (Set.range (t j).left)) →
      (∀ x : T.left, ∃ i, x ∈ Set.range (t i).left) →
      ∀ (F : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}),
      Function.Bijective (fun (s : F.obj.obj (Opposite.op T)) (i : Fin m) =>
        (F.obj.map (t i).op).hom s) := by
    intro S T m Ti t hopen hdisj hcov F
    have s1 : ∀ W : S.Etale, IsEmpty W.left → Subsingleton (F.obj.obj (Opposite.op W)) := by
      intro W hW
      have hbot : (⊥ : Sieve W) ∈ Scheme.smallEtaleTopology S W := by
        change (⊥ : Sieve W) ∈ Scheme.smallGrothendieckTopology @Etale S W
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro x
        exact isEmptyElim x
      exact AddCommGrpCat.isZero_iff_subsingleton.mp (Sheaf.isTerminalOfBotCover F W hbot).isZero
    have s2 : Sieve.generate (Presieve.ofArrows Ti t) ∈ Scheme.smallEtaleTopology S T := by
      change Sieve.generate (Presieve.ofArrows Ti t) ∈ Scheme.smallGrothendieckTopology @Etale S T
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨i, y, hy⟩ := hcov x
      haveI := hopen i
      have hmem : (Sieve.generate (Presieve.ofArrows Ti t)).arrows (t i) :=
        Sieve.le_generate (Presieve.ofArrows Ti t) (Ti i) (t i) (Presieve.ofArrows.mk i)
      exact ⟨Ti i, t i, y, hmem, inferInstance, hy⟩
    let P := F.obj ⋙ forget AddCommGrpCat
    have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology S) P :=
      (isSheaf_iff_isSheaf_of_type _ _).1
        ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology S) F.obj
          (forget AddCommGrpCat)).1 F.cond)
    have s3 := (Presieve.isSheafFor_arrows_iff P t).1 (hP.isSheafFor _ s2)
    have s4 : ∀ x : ∀ i, P.obj (Opposite.op (Ti i)), Presieve.Arrows.Compatible P t x := by
      intro x i j Z gi gj h
      have hl : gi.left ≫ (t i).left = gj.left ≫ (t j).left := by
        have h1 : (Scheme.Etale.forget S ⋙ Over.forget S).map gi ≫
            (Scheme.Etale.forget S ⋙ Over.forget S).map (t i) =
            (Scheme.Etale.forget S ⋙ Over.forget S).map gj ≫
            (Scheme.Etale.forget S ⋙ Over.forget S).map (t j) := by
          rw [← Functor.map_comp, ← Functor.map_comp, h]
        exact h1
      by_cases hij : i = j
      · subst hij
        haveI := hopen i
        have hg : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          exact (cancel_mono (t i).left).1 hl
        rw [hg]
      · haveI : IsEmpty Z.left := ⟨fun z => by
          have hz : (t i).left (gi.left z) = (t j).left (gj.left z) := by
            rw [← Scheme.Hom.comp_apply, hl, Scheme.Hom.comp_apply]
          exact Set.disjoint_left.1 (hdisj i j hij) ⟨_, rfl⟩ ⟨_, hz.symm⟩⟩
        exact @Subsingleton.elim _ (s1 Z inferInstance) _ _
    refine ⟨fun s s' hss => ?_, fun x => ?_⟩
    · obtain ⟨s0, _, huniq⟩ := s3 (fun i => (F.obj.map (t i).op).hom s) (s4 _)
      exact (huniq s (fun i => rfl)).trans (huniq s' (fun i => (congrFun hss i).symm)).symm
    · obtain ⟨s, hs, _⟩ := s3 x (s4 x)
      exact ⟨s, funext hs⟩

  let t : ∀ i, Scheme.Etale.mk (O i).ι ⟶ Scheme.Etale.mk (𝟙 Y) := fun i =>
    MorphismProperty.Over.homMk (O i).ι (Category.comp_id _) trivial
  have hrange : ∀ i, Set.range (t i).left = (O i : Set Y) := fun i => Scheme.Opens.range_ι (O i)
  have hopen : ∀ i, IsOpenImmersion (t i).left := fun i => by
    change IsOpenImmersion (O i).ι
    infer_instance
  have hdisj' : ∀ i j, i ≠ j → Disjoint (Set.range (t i).left) (Set.range (t j).left) := by
    intro i j hij
    rw [hrange, hrange]
    exact Set.disjoint_left.mpr (fun y hi hj => hdisj i j hij y hi hj)
  have hcov' : ∀ x : (Scheme.Etale.mk (𝟙 Y)).left, ∃ i, x ∈ Set.range (t i).left := by
    intro x
    obtain ⟨i, hi⟩ := hcov x
    refine ⟨i, ?_⟩
    rw [hrange]
    exact hi
  obtain ⟨b, hb⟩ := (bij _ n _ t hopen hdisj' hcov' A).2 β
  refine ⟨b, ?_⟩
  apply (bij _ n _ t hopen hdisj' hcov' B).1
  funext i
  have key := congrArg (fun φ => φ.hom b) (d.hom.naturality (t i).op)
  simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at key
  have hbi : (A.obj.map (t i).op).hom b = β i := congrFun hb i
  show (B.obj.map (t i).op).hom ((d.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom b) =
    (B.obj.map (t i).op).hom z
  rw [← key, hbi, hβ i (t i)]

theorem wc_et_coh_vanish_of_vnr_fibres : ∀ (P T : Scheme.{u}) [IsAffine P] [IsAffine T] (h : T ⟶ P), (∀ f : Γ(P, ⊤), ∃ t : Γ(P, ⊤), f * f * t = f) → ∀ (m q : ℕ), 1 ≤ q → (∀ p : P, Subsingleton (wcEtCoh (Limits.pullback h (P.fromSpecResidueField p)) m q)) → Subsingleton (wcEtCoh T m q) :=
by
  intro P T _ _ h hR m q hq hfib
  haveI : IsAffineHom h := isAffineHom_of_isAffine h
  haveI := wc_et_enough_injectives T
  let J := InjectiveResolution.of ((constantSheaf (Scheme.smallEtaleTopology T)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))

  have TU : ∀ (V : T.Etale) (a b : V ⟶ Scheme.Etale.mk (𝟙 T)), a = b := by
    intro V a b
    apply MorphismProperty.Over.Hom.ext
    have ha : a.left ≫ (Scheme.Etale.mk (𝟙 T)).hom = V.hom := by
      first
        | exact MorphismProperty.Over.w a
        | simpa using a.w
    have hb : b.left ≫ (Scheme.Etale.mk (𝟙 T)).hom = V.hom := by
      first
        | exact MorphismProperty.Over.w b
        | simpa using b.w
    change a.left ≫ 𝟙 T = V.hom at ha
    change b.left ≫ 𝟙 T = V.hom at hb
    exact (Category.comp_id a.left).symm.trans (ha.trans (hb.symm.trans (Category.comp_id b.left)))
  rw [wc_et_coh_subsingleton_iff_injres_cocycles T m q J]
  intro z hz

  have hloc : ∀ p : P, ∃ (e : Γ(P, ⊤)) (_ : e * e = e) (_ : p ∈ P.basicOpen e)
      (β : (J.cocomplex.X (q - 1)).obj.obj
        (Opposite.op (Scheme.Etale.mk (h ⁻¹ᵁ P.basicOpen e).ι))),
      ∀ g : Scheme.Etale.mk (h ⁻¹ᵁ P.basicOpen e).ι ⟶ Scheme.Etale.mk (𝟙 T),
        ((J.cocomplex.d (q - 1) q).hom.app
          (Opposite.op (Scheme.Etale.mk (h ⁻¹ᵁ P.basicOpen e).ι))).hom β =
        ((J.cocomplex.X q).obj.map g.op).hom z := by
    intro p
    have hs3 := wc_vnr_evaluation_surjective P hR p
    have hs4 := wc_vnr_factor_fromSpecResidueField P hR p hs3
    obtain ⟨Λ, _, _, W, E, φ, hA, hO, hE, hp, hrg, hc, hφ, hlim⟩ :=
      wc_vnr_point_clopen_limit P p hs4
    obtain ⟨l, β, hβ⟩ := wc_et_local_death_clopen_nbhd P T h p Λ W E φ hA hO hrg hc hφ hlim
      m q hq (hfib p) J z hz
    exact ⟨E l, hE l, hp l, β, hβ⟩
  choose V hVi hVm β hβ using hloc

  obtain ⟨n, pt, O, hdisj, hcov, hsub⟩ :=
    wc_affine_idempotent_disjoint_refinement P V hVi hVm
  let O' : Fin n → T.Opens := fun i => h ⁻¹ᵁ O i
  have hle : ∀ i, O' i ≤ h ⁻¹ᵁ P.basicOpen (V (pt i)) := by
    intro i x hx
    exact hsub i (h x) hx
  let r : ∀ i, Scheme.Etale.mk (O' i).ι ⟶
      Scheme.Etale.mk (h ⁻¹ᵁ P.basicOpen (V (pt i))).ι := fun i =>
    MorphismProperty.Over.homMk (T.homOfLE (hle i)) (T.homOfLE_ι _) trivial
  let β' : ∀ i, (J.cocomplex.X (q - 1)).obj.obj (Opposite.op (Scheme.Etale.mk (O' i).ι)) :=
    fun i => ((J.cocomplex.X (q - 1)).obj.map (r i).op).hom (β (pt i))

  apply wc_et_disjoint_open_cover_coboundary T (J.cocomplex.X (q - 1)) (J.cocomplex.X q)
    (J.cocomplex.d (q - 1) q) n O'
    (fun i j hij x hxi hxj => hdisj i j hij (h x) hxi hxj) (fun x => hcov (h x)) z β'
  intro i g
  let g₀ : Scheme.Etale.mk (h ⁻¹ᵁ P.basicOpen (V (pt i))).ι ⟶ Scheme.Etale.mk (𝟙 T) :=
    MorphismProperty.Over.homMk (h ⁻¹ᵁ P.basicOpen (V (pt i))).ι
      (by
        change (h ⁻¹ᵁ P.basicOpen (V (pt i))).ι ≫ 𝟙 T = (h ⁻¹ᵁ P.basicOpen (V (pt i))).ι
        exact Category.comp_id _) trivial
  have key := congrArg (fun φ => φ.hom (β (pt i)))
    ((J.cocomplex.d (q - 1) q).hom.naturality (r i).op)
  simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at key
  calc ((J.cocomplex.d (q - 1) q).hom.app (Opposite.op (Scheme.Etale.mk (O' i).ι))).hom (β' i)
      = ((J.cocomplex.X q).obj.map (r i).op).hom
          (((J.cocomplex.d (q - 1) q).hom.app
            (Opposite.op (Scheme.Etale.mk (h ⁻¹ᵁ P.basicOpen (V (pt i))).ι))).hom
            (β (pt i))) := key
    _ = ((J.cocomplex.X q).obj.map (r i).op).hom
          (((J.cocomplex.X q).obj.map g₀.op).hom z) := by rw [hβ (pt i) g₀]
    _ = ((J.cocomplex.X q).obj.map (r i ≫ g₀).op).hom z := by
          rw [op_comp, Functor.map_comp]; rfl
    _ = ((J.cocomplex.X q).obj.map g.op).hom z := by rw [TU _ (r i ≫ g₀) g]

theorem wc_hal_milnor_tube_acyclic : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ q)) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)) (x : wcHalA1 s), (∀ x' : wcHalA1 s, wcHalA1Proj s x' = wcHalA1Proj s x → x ⤳ x' → x' = x) → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ q) :=
by
  classical
  intro K _ _ ℓ hℓ hℓK H3 A _ _ _ s Ω _ _ z x hx B _ _ _ Λ _ _ W' φ a hd q hq

  obtain ⟨A', _, _, _, Λy, _, _, Wy, φy, b, ey, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (wcHalA1Proj s x)
  have hdy : wcHalShData (wcHalA1Proj s x) A' Λy Wy φy b := ⟨h1, h2, h3, h4, h5, ey, h6, h7⟩

  obtain ⟨ã, hã, hcl, hcp, hiso⟩ :=
    wc_tube_milnor_identification K A s x hx B Λ W' φ a hd A' Λy Wy φy b hdy
  obtain ⟨B₂, _, _, _, Λ₂, _, _, W₂, φ₂, a₂, e₂, k1, k2, k3, k4, k5, k6, k7⟩ :=
    wc_et_geom_strict_henselization (ã (IsLocalRing.closedPoint B))
  have hd₂ : wcHalShData (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ :=
    ⟨k1, k2, k3, k4, k5, e₂, k6, k7⟩
  obtain ⟨θ, hθ⟩ := hiso B₂ Λ₂ W₂ φ₂ a₂ hd₂
  have hc : (ã ≫ wcHalA1Proj (b ≫ s)) ≫ b = a ≫ wcHalA1Proj s := by
    rw [Category.assoc]; exact hã

  let j : Limits.pullback (a ≫ wcHalA1Proj s) z ≅
      Limits.pullback (ã ≫ wcHalA1Proj (b ≫ s)) (Limits.pullback.fst b z) :=
    Limits.pullback.congrHom hc.symm rfl ≪≫
      (Limits.pullbackRightPullbackFstIso b z (ã ≫ wcHalA1Proj (b ≫ s))).symm
  obtain ⟨E⟩ := wc_et_coh_iso_invariance j.inv ℓ q

  have hP := wc_shens_geom_fibre_vnr_algclosed A (wcHalA1Proj s x) A' Λy Wy φy b hdy Ω z

  have hT' : Subsingleton (wcEtCoh (Limits.pullback (ã ≫ wcHalA1Proj (b ≫ s))
      (Limits.pullback.fst b z)) ℓ q) := by
    apply wc_et_coh_vanish_of_vnr_fibres (Limits.pullback b z) _
      (Limits.pullback.snd (ã ≫ wcHalA1Proj (b ≫ s)) (Limits.pullback.fst b z)) hP.1 ℓ q hq
    intro p
    haveI : IsAlgClosed ((Limits.pullback b z).residueField p) := hP.2 p
    let w : Spec (.of ((Limits.pullback b z).residueField p)) ⟶ Spec (.of A') :=
      (Limits.pullback b z).fromSpecResidueField p ≫ Limits.pullback.fst b z
    have hH := (H3 A' (b ≫ s) (ã (IsLocalRing.closedPoint B)) hcl hcp B₂ Λ₂ W₂ φ₂ a₂ hd₂
      ((Limits.pullback b z).residueField p) w).2 q hq
    let i₁ : Limits.pullback (Limits.pullback.snd (ã ≫ wcHalA1Proj (b ≫ s))
          (Limits.pullback.fst b z)) ((Limits.pullback b z).fromSpecResidueField p) ≅
        Limits.pullback (ã ≫ wcHalA1Proj (b ≫ s)) w :=
      Limits.pullbackLeftPullbackSndIso (ã ≫ wcHalA1Proj (b ≫ s)) (Limits.pullback.fst b z)
        ((Limits.pullback b z).fromSpecResidueField p)
    let i₂ : Limits.pullback (ã ≫ wcHalA1Proj (b ≫ s)) w ≅
        Limits.pullback (θ.hom ≫ a₂ ≫ wcHalA1Proj (b ≫ s)) w :=
      Limits.pullback.congrHom hθ.symm rfl
    let m₃ : Limits.pullback (θ.hom ≫ a₂ ≫ wcHalA1Proj (b ≫ s)) w ⟶
        Limits.pullback (a₂ ≫ wcHalA1Proj (b ≫ s)) w :=
      Limits.pullback.map (θ.hom ≫ a₂ ≫ wcHalA1Proj (b ≫ s)) w (a₂ ≫ wcHalA1Proj (b ≫ s)) w
        θ.hom (𝟙 _) (𝟙 _) (by simp) (by simp)
    haveI : IsIso m₃ := Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
    obtain ⟨E'⟩ := wc_et_coh_iso_invariance (i₁.hom ≫ i₂.hom ≫ m₃) ℓ q
    haveI := hH
