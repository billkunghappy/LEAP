  have hbd : ∀ {A : SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX
        (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ)} (m : ℕ)
      (x : A ⟶ I.cocomplex.X m) (hx : x ≫ I.cocomplex.d m (m + 1) = 0)
