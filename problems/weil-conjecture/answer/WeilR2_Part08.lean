      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] }

  haveI : Finite (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
