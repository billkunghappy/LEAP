theorem wc_et_push_homology_zero_of_local : ∀ {Y S : Scheme.{u}} (g : Y ⟶ S) (ℓ : ℕ) (D : wcEtPullData g ℓ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing Y ℓ))) (n : ℕ), 1 ≤ n → (∀ (V : Scheme.{u}) (v : V ⟶ S), Etale v → ∀ (YV : Scheme.{u}) (gV : YV ⟶ V) (w : YV ⟶ Y), IsPullback w gV g v → ∀ (α : wcEtZModExt YV ℓ n) (x : V), ∃ (V' : Scheme.{u}) (v' : V' ⟶ V), Etale v' ∧ x ∈ Set.range v' ∧ ∀ (YV' : Scheme.{u}) (gV' : YV' ⟶ V') (w' : YV' ⟶ YV), IsPullback w' gV' gV v' → ∀ (Dw' : wcEtPullData w' ℓ), wcEtPull Dw' n α = 0) → letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; Limits.IsZero ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange g) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology n) :=
by
  intro Y S g ℓ D I n hn H
