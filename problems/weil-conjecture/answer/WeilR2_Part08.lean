    refine ⟨X.basicOpen Y.det, (X.basicOpen Y.det).ι ≫ pX,
      Y.map (X.basicOpen Y.det).ι.appTop.hom, inferInstance, ?_, inferInstance, hunit, huniv⟩
    obtain ⟨ψ₀, -, -⟩ := huniv (𝟙 (Spec (.of K))) (1 : Matrix (Fin c) (Fin c) Γ(Spec (.of K), ⊤))
      (by rw [Matrix.det_one]; exact isUnit_one)
    haveI : Nonempty (X.basicOpen Y.det : Scheme.{u}) :=
