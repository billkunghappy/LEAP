import WeilR2_Part07
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_tube_lift_point_closed : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), (∀ x' : wcHalA1 s, wcHalA1Proj s x' = wcHalA1Proj s x → x ⤳ x' → x' = x) → ∀ (A' : Type u) [CommRing A'] [IsLocalRing A'] (b : Spec (.of A') ⟶ Spec (.of A)) (pr : wcHalA1 (b ≫ s) ⟶ wcHalA1 s), pr ≫ wcHalA1Proj s = wcHalA1Proj (b ≫ s) ≫ b → pr ≫ Limits.pullback.snd s (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) = Limits.pullback.snd (b ≫ s) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) → ∀ x'' : wcHalA1 (b ≫ s), pr x'' = x → wcHalA1Proj (b ≫ s) x'' = IsLocalRing.closedPoint A' → IsClosed ({x''} : Set (wcHalA1 (b ≫ s))) :=
by
  classical
  intro K _ A _ s x hx A' _ _ b pr hprg hprsnd x'' hprx hx''

  have coords : ∀ (R : Type u) [CommRing R] (sR : Spec (.of R) ⟶ Spec (.of K)),
      ∃ e : Limits.pullback sR (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≅
          Spec (.of (Polynomial R)),
        e.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R)) =
          Limits.pullback.fst sR (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ∧
        e.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (Spec.preimage sR).hom)) =
          Limits.pullback.snd sR (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    intro R _ sR
    let φ : K →+* R := (Spec.preimage sR).hom
    letI : Algebra K R := φ.toAlgebra
    have h₁ : Spec.map (CommRingCat.ofHom (algebraMap K R)) = sR := by
      rw [RingHom.algebraMap_toAlgebra]
      simp only [φ, CommRingCat.ofHom_hom, Spec.map_preimage]
    let E₁ : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K R)))
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≅
        Limits.pullback sR (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
      Limits.pullback.congrHom h₁ rfl
    let E₂ := pullbackSpecIso K R (Polynomial K)
    let ψ : Polynomial R ≃+* TensorProduct K R (Polynomial K) := (polyEquivTensor K R).toRingEquiv
    let E₃ : Spec (.of (TensorProduct K R (Polynomial K))) ≅ Spec (.of (Polynomial R)) :=
      { hom := Spec.map (CommRingCat.ofHom (ψ : Polynomial R →+* _))
        inv := Spec.map (CommRingCat.ofHom (ψ.symm : _ →+* Polynomial R))
        hom_inv_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.comp_symm,
            CommRingCat.ofHom_id, Spec.map_id]
        inv_hom_id := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.symm_comp,
            CommRingCat.ofHom_id, Spec.map_id] }
    refine ⟨E₁.symm ≪≫ E₂ ≪≫ E₃, ?_, ?_⟩
    · have hC : (ψ : Polynomial R →+* TensorProduct K R (Polynomial K)).comp
          (Polynomial.C : R →+* Polynomial R) =
          (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct K R (Polynomial K)) := by
        ext a
        simp [ψ, polyEquivTensor_apply]
      have h3 : E₃.hom ≫ Spec.map (CommRingCat.ofHom Polynomial.C) =
          Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
        show Spec.map (CommRingCat.ofHom (ψ : Polynomial R →+* TensorProduct K R (Polynomial K))) ≫ _ = _
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hC]
      have h4 : E₂.hom ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
          Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K R)))
            (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
        pullbackSpecIso_hom_fst K R (Polynomial K)
      show (E₁.inv ≫ E₂.hom ≫ E₃.hom) ≫ _ = _
      rw [Category.assoc, Category.assoc, h3, h4]
      simp only [E₁, Iso.symm_hom, Limits.pullback.congrHom_inv]
      exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
    · have hR : (ψ : Polynomial R →+* TensorProduct K R (Polynomial K)).comp
          (Polynomial.mapRingHom φ) =
          ((Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] TensorProduct K R (Polynomial K)) :
            Polynomial K →+* TensorProduct K R (Polynomial K)) := by
        apply Polynomial.ringHom_ext
        · intro k
          rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C]
          have e1 : (Polynomial.C (φ k) : Polynomial R) = algebraMap K (Polynomial R) k := by
            rw [Polynomial.algebraMap_apply, RingHom.algebraMap_toAlgebra]
          have e2 : (Polynomial.C k : Polynomial K) = algebraMap K (Polynomial K) k := by
            rw [Polynomial.algebraMap_eq]
          rw [e1, e2]
          show polyEquivTensor K R (algebraMap K (Polynomial R) k) =
            Algebra.TensorProduct.includeRight (algebraMap K (Polynomial K) k)
          rw [AlgEquiv.commutes, AlgHom.commutes]
        · rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X]
          show polyEquivTensor K R Polynomial.X = Algebra.TensorProduct.includeRight Polynomial.X
          rw [polyEquivTensor_apply, Polynomial.eval₂_X, Algebra.TensorProduct.includeRight_apply]
      have h3 : E₃.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom φ)) =
          Spec.map (CommRingCat.ofHom
            ((Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] TensorProduct K R (Polynomial K)) :
              Polynomial K →+* TensorProduct K R (Polynomial K))) := by
        show Spec.map (CommRingCat.ofHom (ψ : Polynomial R →+* TensorProduct K R (Polynomial K))) ≫ _ = _
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hR]
      have h4 : E₂.hom ≫ Spec.map (CommRingCat.ofHom
            ((Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] TensorProduct K R (Polynomial K)) :
              Polynomial K →+* TensorProduct K R (Polynomial K))) =
          Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K R)))
            (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) :=
        pullbackSpecIso_hom_snd K R (Polynomial K)
      show (E₁.inv ≫ E₂.hom ≫ E₃.hom) ≫ _ = _
      rw [Category.assoc, Category.assoc, h3, h4]
      simp only [E₁, Iso.symm_hom, Limits.pullback.congrHom_inv]
      exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)

  let φ : K →+* A := (Spec.preimage s).hom
  let β : A →+* A' := (Spec.preimage b).hom
  have hβ : Spec.map (CommRingCat.ofHom β) = b := by
    simp only [β, CommRingCat.ofHom_hom, Spec.map_preimage]
  obtain ⟨e, he1, he2⟩ := coords A s
  obtain ⟨e', he1', he2'⟩ := coords A' (b ≫ s)
  have hpre : (Spec.preimage (b ≫ s)).hom = β.comp φ := by
    rw [Spec.preimage_comp, CommRingCat.hom_comp]
  rw [hpre] at he2'

  have he1inv : e.inv ≫ Limits.pullback.fst s
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
      Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) := by
    rw [Iso.inv_comp_eq]
    exact he1.symm
  have he2inv : e.inv ≫ Limits.pullback.snd s
      (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) =
      Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom φ)) := by
    rw [Iso.inv_comp_eq]
    exact he2.symm
  have hsq : pr ≫ e.hom = e'.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom β)) := by
    rw [← Iso.eq_comp_inv]
    apply Limits.pullback.hom_ext
    · have h1 : Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom β)) ≫
          Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) =
          Spec.map (CommRingCat.ofHom (Polynomial.C : A' →+* Polynomial A')) ≫ b := by
        rw [← hβ, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← CommRingCat.ofHom_comp, Polynomial.mapRingHom_comp_C]
      simp only [Category.assoc, he1inv, h1]
      rw [← Category.assoc, he1']
      exact hprg
    · have h2 : Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom β)) ≫
          Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom φ)) =
          Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (β.comp φ))) := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, Polynomial.mapRingHom_comp]
      simp only [Category.assoc, he2inv, h2]
      rw [he2']
      exact hprsnd

  let y' : PrimeSpectrum (Polynomial A') := e'.hom x''
  let y : PrimeSpectrum (Polynomial A) := e.hom x
  have hP'm : y'.asIdeal.comap Polynomial.C = IsLocalRing.maximalIdeal A' := by
    have h : (Spec.map (CommRingCat.ofHom Polynomial.C)) (e'.hom x'') = wcHalA1Proj (b ≫ s) x'' := by
      rw [← Scheme.Hom.comp_apply, he1']
    rw [hx'', Spec.map_apply] at h
    exact congrArg PrimeSpectrum.asIdeal h
  have hP : y.asIdeal = Ideal.comap (Polynomial.mapRingHom β) y'.asIdeal := by
    have h : e.hom (pr x'') =
        Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom β)) (e'.hom x'') := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hsq]
    rw [hprx, Spec.map_apply] at h
    exact congrArg PrimeSpectrum.asIdeal h

  have dich : ∀ (P : Ideal (Polynomial A')), P.IsPrime →
      Ideal.comap Polynomial.C P = IsLocalRing.maximalIdeal A' →
      P.IsMaximal ∨ P = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A') := by
    intro P hP0 hPm
    have hρs : Function.Surjective (Polynomial.mapRingHom (IsLocalRing.residue A')) :=
      Polynomial.map_surjective _ IsLocalRing.residue_surjective
    have hker : RingHom.ker (Polynomial.mapRingHom (IsLocalRing.residue A')) =
        Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A') := by
      rw [Polynomial.ker_mapRingHom, IsLocalRing.ker_residue]
    have hle : Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A') ≤ P := by
      rw [Ideal.map_le_iff_le_comap, hPm]
    by_cases heq : P = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A')
    · exact Or.inr heq
    · left
      have hkle : RingHom.ker (Polynomial.mapRingHom (IsLocalRing.residue A')) ≤ P := by
        rw [hker]; exact hle
      haveI := hP0
      have hpr : (Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue A')) P).IsPrime :=
        Ideal.map_isPrime_of_surjective hρs hkle
      have hne : Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue A')) P ≠ ⊥ := by
        intro h0
        rw [Ideal.map_eq_bot_iff_le_ker, hker] at h0
        exact heq (le_antisymm h0 hle)
      haveI hmax : (Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue A')) P).IsMaximal :=
        hpr.isMaximal hne
      have hc : Ideal.comap (Polynomial.mapRingHom (IsLocalRing.residue A'))
          (Ideal.map (Polynomial.mapRingHom (IsLocalRing.residue A')) P) = P := by
        rw [Ideal.comap_map_of_surjective _ hρs, ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr hkle]
      rw [← hc]
      exact Ideal.comap_isMaximal_of_surjective _ hρs
  rcases dich y'.asIdeal y'.isPrime hP'm with hmax | hP'eq
  ·
    have hyc : IsClosed ({y'} : Set (PrimeSpectrum (Polynomial A'))) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal y').mpr hmax
    apply (Homeomorph.isClosed_image (Scheme.homeoOfIso e')).mp
    rw [Set.image_singleton, Scheme.coe_homeoOfIso]
    exact hyc
  ·
    exfalso
    let 𝔭 : Ideal A := Ideal.comap β (IsLocalRing.maximalIdeal A')
    have h𝔭 : 𝔭.IsPrime := by
      show (Ideal.comap β (IsLocalRing.maximalIdeal A')).IsPrime
      infer_instance
    have s5 : Ideal.comap (Polynomial.mapRingHom β)
        (Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A')) = Ideal.map Polynomial.C 𝔭 := by
      ext f
      rw [Ideal.mem_comap, Ideal.mem_map_C_iff, Ideal.mem_map_C_iff]
      simp only [Polynomial.coe_mapRingHom, Polynomial.coeff_map, 𝔭, Ideal.mem_comap]
    have hPeq : y.asIdeal = Ideal.map Polynomial.C 𝔭 := by
      rw [hP, hP'eq, s5]
    let Q : Ideal (Polynomial A) := Ideal.comap (Polynomial.constantCoeff : Polynomial A →+* A) 𝔭
    have hQ : Q.IsPrime := by
      haveI := h𝔭
      show (Ideal.comap (Polynomial.constantCoeff : Polynomial A →+* A) 𝔭).IsPrime
      infer_instance
    have hcc : ∀ a : A, Polynomial.constantCoeff (Polynomial.C a) = a := fun a => by
      rw [Polynomial.constantCoeff_apply, Polynomial.coeff_C_zero]
    have hQc : Ideal.comap Polynomial.C Q = 𝔭 := by
      ext a
      simp only [Q, Ideal.mem_comap, hcc]
    have hPc : Ideal.comap Polynomial.C (Ideal.map Polynomial.C 𝔭) = 𝔭 := by
      ext a
      rw [Ideal.mem_comap, Ideal.mem_map_C_iff]
      constructor
      · intro h
        have h0 := h 0
        rwa [Polynomial.coeff_C_zero] at h0
      · intro h n
        rw [Polynomial.coeff_C]
        split_ifs
        · exact h
        · exact 𝔭.zero_mem
    have hPQ : Ideal.map Polynomial.C 𝔭 ≤ Q := by
      rw [Ideal.map_le_iff_le_comap, hQc]
    have hXQ : (Polynomial.X : Polynomial A) ∈ Q := by
      show Polynomial.constantCoeff Polynomial.X ∈ 𝔭
      rw [Polynomial.constantCoeff_apply, Polynomial.coeff_X_zero]
      exact 𝔭.zero_mem
    have hXP : (Polynomial.X : Polynomial A) ∉ Ideal.map Polynomial.C 𝔭 := by
      intro h
      have h1 := (Ideal.mem_map_C_iff.mp h) 1
      rw [Polynomial.coeff_X_one] at h1
      exact h𝔭.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
    let yQ : PrimeSpectrum (Polynomial A) := ⟨Q, hQ⟩
    let x' : wcHalA1 s := (Scheme.homeoOfIso e).symm yQ
    have hx'e : e.hom x' = yQ := by
      have h := (Scheme.homeoOfIso e).apply_symm_apply yQ
      rw [Scheme.coe_homeoOfIso] at h
      exact h
    have hsp : x ⤳ x' := by
      apply ((Scheme.homeoOfIso e).isInducing.specializes_iff).mp
      rw [Scheme.coe_homeoOfIso]
      show e.hom x ⤳ e.hom x'
      rw [hx'e]
      apply (PrimeSpectrum.le_iff_specializes y yQ).mp
      show y.asIdeal ≤ Q
      rw [hPeq]
      exact hPQ
    have hg : ∀ z : wcHalA1 s, wcHalA1Proj s z =
        Spec.map (CommRingCat.ofHom (Polynomial.C : A →+* Polynomial A)) (e.hom z) := by
      intro z
      rw [← Scheme.Hom.comp_apply, he1]
    have hfib : wcHalA1Proj s x' = wcHalA1Proj s x := by
      have hQ' : (e.hom x').asIdeal = Q := congrArg PrimeSpectrum.asIdeal hx'e
      rw [hg x', hg x, Spec.map_apply, Spec.map_apply]
      apply PrimeSpectrum.ext
      change Ideal.comap Polynomial.C (e.hom x').asIdeal = Ideal.comap Polynomial.C y.asIdeal
      rw [hQ', hPeq, hQc, hPc]
    have hxx : x' = x := hx x' hfib hsp
    have hyy : yQ = y := by
      rw [← hx'e, hxx]
    have hQP : Q = y.asIdeal := congrArg PrimeSpectrum.asIdeal hyy
    rw [hPeq] at hQP
    exact hXP (hQP ▸ hXQ)

theorem wc_tube_milnor_identification : ∀ (K : Type u) [Field K] (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), (∀ x' : wcHalA1 s, wcHalA1Proj s x' = wcHalA1Proj s x → x ⤳ x' → x' = x) → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] (Λy : Type u) [SmallCategory Λy] [IsCofiltered Λy] (Wy : Λy ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of A)) (wcHalA1Proj s x))) (Scheme.Etale.forget (Spec (.of A)))) (φy : ∀ l, Spec (.of A') ⟶ (Wy.obj l).right.left) (b : Spec (.of A') ⟶ Spec (.of A)), wcHalShData (wcHalA1Proj s x) A' Λy Wy φy b → ∃ ã : Spec (.of B) ⟶ wcHalA1 (b ≫ s), ã ≫ wcHalA1Proj (b ≫ s) ≫ b = a ≫ wcHalA1Proj s ∧ IsClosed ({ã (IsLocalRing.closedPoint B)} : Set (wcHalA1 (b ≫ s))) ∧ wcHalA1Proj (b ≫ s) (ã (IsLocalRing.closedPoint B)) = IsLocalRing.closedPoint A' ∧ ∀ (B₂ : Type u) [CommRing B₂] [HenselianLocalRing B₂] [IsSepClosed (IsLocalRing.ResidueField B₂)] (Λ₂ : Type u) [SmallCategory Λ₂] [IsCofiltered Λ₂] (W₂ : Λ₂ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 (b ≫ s)) (ã (IsLocalRing.closedPoint B)))) (Scheme.Etale.forget (wcHalA1 (b ≫ s)))) (φ₂ : ∀ l, Spec (.of B₂) ⟶ (W₂.obj l).right.left) (a₂ : Spec (.of B₂) ⟶ wcHalA1 (b ≫ s)), wcHalShData (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ → ∃ θ : Spec (.of B) ≅ Spec (.of B₂), θ.hom ≫ a₂ ≫ wcHalA1Proj (b ≫ s) = ã ≫ wcHalA1Proj (b ≫ s) :=
by
  classical

  have wc_geomPt_down_comparison : ∀ {Y Z : Scheme.{u}} (h : Z ⟶ Y) (z : Z), ∃ ι : Spec (.of (AlgebraicClosure (Z.residueField z))) ⟶ Spec (.of (AlgebraicClosure (Y.residueField (h z)))), ι ≫ wcEtGeomPt Y (h z) = wcEtGeomPt Z z ≫ h := by
    intro Y Z h z
    let μ : Y.residueField (h z) →+* AlgebraicClosure (Z.residueField z) :=
      (algebraMap (Z.residueField z) (AlgebraicClosure (Z.residueField z))).comp
        (h.residueFieldMap z).hom
    letI : Algebra (Y.residueField (h z)) (AlgebraicClosure (Z.residueField z)) := μ.toAlgebra
    let σ : AlgebraicClosure (Y.residueField (h z)) →ₐ[Y.residueField (h z)]
        AlgebraicClosure (Z.residueField z) := IsAlgClosed.lift
    have hσ : (σ : AlgebraicClosure (Y.residueField (h z)) →+* AlgebraicClosure (Z.residueField z)).comp
        (algebraMap (Y.residueField (h z)) (AlgebraicClosure (Y.residueField (h z)))) = μ := by
      ext r
      exact σ.commutes r
    refine ⟨Spec.map (CommRingCat.ofHom (σ : AlgebraicClosure (Y.residueField (h z)) →+*
      AlgebraicClosure (Z.residueField z))), ?_⟩
    simp only [wcEtGeomPt]
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hσ]
    show Spec.map (CommRingCat.ofHom ((algebraMap (Z.residueField z)
        (AlgebraicClosure (Z.residueField z))).comp (h.residueFieldMap z).hom)) ≫ _ = _
    rw [CommRingCat.ofHom_comp, CommRingCat.ofHom_hom, Spec.map_comp, Category.assoc,
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, Category.assoc]

  have wc_geomPt_rebase_lift : ∀ {Y Z : Scheme.{u}} (h : Z ⟶ Y) (y : Y) (z : Z), h z = y → ∀ t : Spec (.of (AlgebraicClosure (Y.residueField y))) ⟶ Z, t (IsLocalRing.closedPoint (AlgebraicClosure (Y.residueField y))) = z → t ≫ h = wcEtGeomPt Y y → ∃ j : Spec (.of (AlgebraicClosure (Z.residueField z))) ⟶ Spec (.of (AlgebraicClosure (Y.residueField y))), j ≫ t = wcEtGeomPt Z z := by
    have factor : ∀ (B Y : Scheme.{u}) (h : Y ⟶ B) (b : B) (y : Y) (hy : h y = b)
        (t : Spec (.of (AlgebraicClosure (B.residueField b))) ⟶ Y),
        t ≫ h = wcEtGeomPt B b →
        t (IsLocalRing.closedPoint (AlgebraicClosure (B.residueField b))) = y →
        ∃ φ : Y.residueField y ⟶ CommRingCat.of (AlgebraicClosure (B.residueField b)),
          t = Spec.map φ ≫ Y.fromSpecResidueField y ∧
          (Scheme.residueFieldCongr hy.symm).hom ≫ h.residueFieldMap y ≫ φ =
            CommRingCat.ofHom (algebraMap (B.residueField b) (AlgebraicClosure (B.residueField b))) := by
      intro B Y h b y hy t ht e
      subst e
      refine ⟨Scheme.descResidueField (Scheme.stalkClosedPointTo t), ?_, ?_⟩
      · exact (Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField _ Y t).symm
      · apply Spec.map_injective
        rw [← cancel_mono (B.fromSpecResidueField b)]
        rw [Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc,
          Scheme.residueFieldCongr_fromSpecResidueField,
          Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, ← Category.assoc,
          Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField]
        exact ht
    intro Y Z h y z hy t htz ht
    obtain ⟨φ, hφ1, hφ2⟩ := factor Y Z h y z hy t ht htz
    let ρ : Y.residueField y →+* Z.residueField z :=
      ((Scheme.residueFieldCongr hy.symm).hom ≫ h.residueFieldMap z).hom
    have hρ : φ.hom.comp ρ = algebraMap (Y.residueField y) (AlgebraicClosure (Y.residueField y)) :=
      congrArg CommRingCat.Hom.hom ((Category.assoc _ _ _).trans hφ2)
    letI : Algebra (Z.residueField z) (AlgebraicClosure (Y.residueField y)) := φ.hom.toAlgebra
    have hAlg : Algebra.IsAlgebraic (Z.residueField z) (AlgebraicClosure (Y.residueField y)) := by
      refine ⟨fun w => ?_⟩
      obtain ⟨p, hp0, hpx⟩ := Algebra.IsAlgebraic.isAlgebraic (R := Y.residueField y) w
      refine ⟨p.map ρ, (Polynomial.map_ne_zero_iff ρ.injective).mpr hp0, ?_⟩
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      rw [Polynomial.aeval_def] at hpx
      change Polynomial.eval₂ (φ.hom.comp ρ) w p = 0
      rw [hρ]
      exact hpx
    let σ : AlgebraicClosure (Y.residueField y) →ₐ[Z.residueField z]
        AlgebraicClosure (Z.residueField z) := IsAlgClosed.lift
    have hσ : (σ : AlgebraicClosure (Y.residueField y) →+* AlgebraicClosure (Z.residueField z)).comp
        φ.hom = algebraMap (Z.residueField z) (AlgebraicClosure (Z.residueField z)) := by
      ext r
      exact σ.commutes r
    refine ⟨Spec.map (CommRingCat.ofHom (σ : AlgebraicClosure (Y.residueField y) →+*
      AlgebraicClosure (Z.residueField z))), ?_⟩
    rw [hφ1, ← Category.assoc, ← Spec.map_comp]
    simp only [wcEtGeomPt]
    congr 2
    apply CommRingCat.hom_ext
    exact hσ

  have wc_shdata_hom_ext_local : ∀ {Y : Scheme.{u}} (y : Y) (B0 : Type u) [CommRing B0] [IsLocalRing B0] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y y)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B0) ⟶ (W'.obj l).right.left) (a0 : Spec (.of B0) ⟶ Y), wcHalShData y B0 Λ W' φ a0 → ∀ (R : Type u) [CommRing R] [IsLocalRing R] (δ₁ δ₂ : Spec (.of R) ⟶ Spec (.of B0)) (Ω' : Type u) [Field Ω'] (π : Spec (.of Ω') ⟶ Spec (.of R)), π (IsLocalRing.closedPoint Ω') = IsLocalRing.closedPoint R → δ₁ ≫ a0 = δ₂ ≫ a0 → π ≫ δ₁ = π ≫ δ₂ → δ₁ = δ₂ := by
    intro Y y B0 _ _ Λ _ _ W' φ a0 hd R _ _ δ₁ δ₂ Ω' _ π hπ hδa hδπ
    obtain ⟨-, -, hcomp, hφa, hlim, -⟩ := hd
    have s0 : ∀ {P E S : Scheme.{u}} (ee : E ⟶ S) [Etale ee] (aa bb : P ⟶ E), aa ≫ ee = bb ≫ ee →
        ∀ (Ω : Type u) [Field Ω] (pp : Spec (.of Ω) ⟶ P), pp ≫ aa = pp ≫ bb →
        ∃ U : P.Opens, pp (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ aa = U.ι ≫ bb := by
      intro P E S ee _ aa bb hab Ω _ pp hπ
      let c : P ⟶ Limits.pullback ee ee := Limits.pullback.lift aa bb hab
      have hcf : c ≫ Limits.pullback.fst ee ee = aa := Limits.pullback.lift_fst _ _ _
      have hcs : c ≫ Limits.pullback.snd ee ee = bb := Limits.pullback.lift_snd _ _ _
      have hkey : pp ≫ c = (pp ≫ aa) ≫ Limits.pullback.diagonal ee := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
        · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
            hπ]
      have hpt : ∀ w : Spec (.of Ω), c (pp w) = Limits.pullback.diagonal ee (aa (pp w)) := by
        intro w
        rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
      refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange, ?_, ?_⟩
      · show c (pp (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal ee).opensRange
        rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
        exact ⟨_, (hpt _).symm⟩
      · set U := c ⁻¹ᵁ (Limits.pullback.diagonal ee).opensRange with hU
        have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal ee) := by
          rintro _ ⟨x, rfl⟩
          have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
          rw [Scheme.Opens.range_ι] at hx0
          have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal ee).opensRange := hx0
          rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
          rw [Scheme.Hom.comp_apply]
          exact hx'
        obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal ee = U.ι ≫ c :=
          ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal ee) (U.ι ≫ c) hrange⟩
        have h1 : U.ι ≫ aa = t := by
          calc U.ι ≫ aa = (U.ι ≫ c) ≫ Limits.pullback.fst ee ee := by rw [Category.assoc, hcf]
            _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.fst ee ee := by rw [ht]
            _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
        have h2 : U.ι ≫ bb = t := by
          calc U.ι ≫ bb = (U.ι ≫ c) ≫ Limits.pullback.snd ee ee := by rw [Category.assoc, hcs]
            _ = (t ≫ Limits.pullback.diagonal ee) ≫ Limits.pullback.snd ee ee := by rw [ht]
            _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
        rw [h1, h2]
    have s6 : ∀ {Z V : Scheme.{u}} (h : V ⟶ Z) [Etale h] (g₁ g₂ : Spec (.of R) ⟶ V),
        g₁ ≫ h = g₂ ≫ h → π ≫ g₁ = π ≫ g₂ → g₁ = g₂ := by
      intro Z V h _ g₁ g₂ hh hg
      obtain ⟨U, hU, hUeq⟩ := s0 h g₁ g₂ hh _ π hg
      have hU' : IsLocalRing.closedPoint R ∈ U := by
        rw [← hπ]
        exact hU
      have hsub : Set.range ⇑(𝟙 (Spec (.of R))) ⊆ Set.range ⇑U.ι := by
        intro x _
        rw [Scheme.Opens.range_ι]
        exact (IsLocalRing.specializes_closedPoint (R := R) x).mem_open U.isOpen hU'
      have hk := IsOpenImmersion.lift_fac U.ι (𝟙 _) hsub
      calc g₁ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₁ := by
            rw [hk, Category.id_comp]
        _ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ g₂ := by
            simp only [Category.assoc, hUeq]
        _ = g₂ := by rw [hk, Category.id_comp]
    have hl : ∀ l, δ₁ ≫ φ l = δ₂ ≫ φ l := by
      intro l
      haveI : Etale (W'.obj l).right.hom := (W'.obj l).right.prop
      apply s6 (W'.obj l).right.hom
      · simp only [Category.assoc, hφa]
        exact hδa
      · rw [← Category.assoc, hδπ, Category.assoc]
    have hz : ∀ {l l' : Λ} (t : l ⟶ l'), (δ₁ ≫ φ l) ≫ (W'.map t).right.left = δ₁ ≫ φ l' := by
      intro l l' t
      rw [Category.assoc, hcomp]
    exact (hlim (Spec (.of R)) (fun l => δ₁ ≫ φ l) hz).unique (fun l => rfl) (fun l => (hl l).symm)
  intro K _ A _ _ _ s x hx B _ _ _ Λ _ _ W' φ a hd A' _ _ _ Λy _ _ Wy φy b hdy

  have hres_pt : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      (p : Spec (.of (IsLocalRing.ResidueField R))),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) p = IsLocalRing.closedPoint R := by
    intro R _ _ p
    exact (Spec.map_apply _ _).trans (IsLocalRing.PrimeSpectrum.comap_residue R p)
  have hpt_gen : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Ω : Type u) [Field Ω]
      (e : IsLocalRing.ResidueField R →+* Ω) (p : Spec (.of Ω)),
      (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) p =
        IsLocalRing.closedPoint R := by
    intro R _ _ Ω _ e p
    rw [Scheme.Hom.comp_apply]
    exact hres_pt R _
  have hgeom_pt : ∀ {Y : Scheme.{u}} (y : Y) (p : Spec (.of (AlgebraicClosure (Y.residueField y)))),
