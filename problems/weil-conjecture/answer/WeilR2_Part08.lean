                Set (PrimeSpectrum (Polynomial K))) := hx
          rw [← hr] at h1
          obtain ⟨y, hy⟩ := h1
          exact ⟨y, hy⟩
      · have h : (algebraMap (Polynomial K) (LaurentPolynomial K)).comp (algebraMap K (Polynomial K)) =
            algebraMap K (LaurentPolynomial K) := by
          refine RingHom.ext fun k => ?_
          simp [LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_C,
            LaurentPolynomial.algebraMap_apply]
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]
    have s1 : ∃ ι : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≅ Spec (.of (MvPolynomial (Fin (n + 1)) K)), ι.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin (n + 1)) K).toRingHom) = Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ∧ ι.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K)).toRingHom) = Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
