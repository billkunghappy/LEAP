theorem wc_et_punct_push_top_iso : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → 1 ≤ c → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (D : wcEtPullData (U.ι ≫ p) ℓ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (U : Scheme.{u}) ℓ))), letI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (U.ι ≫ p)) _ _ D.cont D.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D.adj D.additive; Nonempty ((((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (U.ι ≫ p)) _ _ D.cont D.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (2 * c - 1) ≅ SheafOfModules.unit (wcEtZModRing S ℓ)) :=
