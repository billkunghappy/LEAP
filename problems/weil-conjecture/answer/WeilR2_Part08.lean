    · rw [Category.assoc, hãsnd, ← Category.assoc, hεa, Category.assoc, hprsnd]
  have hεδ : ε ≫ δ = 𝟙 _ := by
    apply wc_shdata_hom_ext_local (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ hd₂ B₂ (ε ≫ δ)
      (𝟙 _) _ q₂ hq₂pt
    · rw [Category.assoc, hδa, hεã, Category.id_comp]
    · rw [← Category.assoc, hq₂ε, hqδ, Category.comp_id]
  refine ⟨⟨δ, ε, hδε, hεδ⟩, ?_⟩
  show δ ≫ a₂ ≫ wcHalA1Proj (b ≫ s) = ã ≫ wcHalA1Proj (b ≫ s)
  rw [← Category.assoc, hδa]

theorem wc_hal_bc_tube_fibre_card : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ q)) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), (∀ x' : wcHalA1 s, wcHalA1Proj s x' = wcHalA1Proj s x → x ⤳ x' → x' = x) → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] (Λy : Type u) [SmallCategory Λy] [IsCofiltered Λy] (Wy : Λy ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of A)) (wcHalA1Proj s x))) (Scheme.Etale.forget (Spec (.of A)))) (φy : ∀ l, Spec (.of A') ⟶ (Wy.obj l).right.left) (b : Spec (.of A') ⟶ Spec (.of A)), wcHalShData (wcHalA1Proj s x) A' Λy Wy φy b → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), ∃ c₀ : Spec (.of B) ⟶ Spec (.of A'), c₀ ≫ b = a ≫ wcHalA1Proj s ∧ ∀ (τ : Limits.pullback a (Limits.pullback.fst (wcHalA1Proj s) z) ⟶ Limits.pullback b z), τ ≫ Limits.pullback.fst b z = Limits.pullback.fst a (Limits.pullback.fst (wcHalA1Proj s) z) ≫ c₀ → τ ≫ Limits.pullback.snd b z = Limits.pullback.snd a (Limits.pullback.fst (wcHalA1Proj s) z) ≫ Limits.pullback.snd (wcHalA1Proj s) z → ∀ p : ↥(Limits.pullback b z), Nat.card (wcEtCoh (Limits.pullback τ ((Limits.pullback b z).fromSpecResidueField p)) ℓ 0) = ℓ :=
by
  classical
  intro K _ _ ℓ hℓ hℓK H3 A _ _ _ s x hx B _ _ _ Λ _ _ W' φ a hd A' _ _ _ Λy _ _ Wy φy b hdy
    Ω _ _ z
  obtain ⟨ã, hã, hcl, hcp, hiso⟩ :=
    wc_tube_milnor_identification K A s x hx B Λ W' φ a hd A' Λy Wy φy b hdy
  obtain ⟨B₂, _, _, _, Λ₂, _, _, W₂, φ₂, a₂, e₂, k1, k2, k3, k4, k5, k6, k7⟩ :=
    wc_et_geom_strict_henselization (ã (IsLocalRing.closedPoint B))
  have hd₂ : wcHalShData (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ :=
    ⟨k1, k2, k3, k4, k5, e₂, k6, k7⟩
  obtain ⟨θ, hθ⟩ := hiso B₂ Λ₂ W₂ φ₂ a₂ hd₂
  have hc : (ã ≫ wcHalA1Proj (b ≫ s)) ≫ b = a ≫ wcHalA1Proj s := by
    rw [Category.assoc]; exact hã
  have hP := wc_shens_geom_fibre_vnr_algclosed A (wcHalA1Proj s x) A' Λy Wy φy b hdy Ω z
  refine ⟨ã ≫ wcHalA1Proj (b ≫ s), hc, ?_⟩
  intro τ hτ1 hτ2 p

  have hbig : IsPullback
      (Limits.pullback.snd a (Limits.pullback.fst (wcHalA1Proj s) z) ≫
        Limits.pullback.snd (wcHalA1Proj s) z)
      (Limits.pullback.fst a (Limits.pullback.fst (wcHalA1Proj s) z)) z
      (a ≫ wcHalA1Proj s) :=
    IsPullback.paste_horiz (IsPullback.of_hasPullback a _).flip
      (IsPullback.of_hasPullback (wcHalA1Proj s) z).flip
  have hbig' : IsPullback (τ ≫ Limits.pullback.snd b z)
      (Limits.pullback.fst a (Limits.pullback.fst (wcHalA1Proj s) z)) z
      ((ã ≫ wcHalA1Proj (b ≫ s)) ≫ b) := by
    rw [hτ2, hc]; exact hbig
  have hsq : IsPullback τ (Limits.pullback.fst a (Limits.pullback.fst (wcHalA1Proj s) z))
      (Limits.pullback.fst b z) (ã ≫ wcHalA1Proj (b ≫ s)) :=
    IsPullback.of_right hbig' hτ1 (IsPullback.of_hasPullback b z).flip
  haveI : IsAlgClosed ((Limits.pullback b z).residueField p) := hP.2 p
  let w : Spec (.of ((Limits.pullback b z).residueField p)) ⟶ Spec (.of A') :=
    (Limits.pullback b z).fromSpecResidueField p ≫ Limits.pullback.fst b z
  have hfib : IsPullback
      (Limits.pullback.snd τ ((Limits.pullback b z).fromSpecResidueField p))
      (Limits.pullback.fst τ ((Limits.pullback b z).fromSpecResidueField p) ≫
        Limits.pullback.fst a (Limits.pullback.fst (wcHalA1Proj s) z))
      w (ã ≫ wcHalA1Proj (b ≫ s)) :=
    IsPullback.paste_vert (IsPullback.of_hasPullback τ _).flip hsq
  let i₀ : Limits.pullback τ ((Limits.pullback b z).fromSpecResidueField p) ≅
      Limits.pullback (ã ≫ wcHalA1Proj (b ≫ s)) w :=
    hfib.flip.isoPullback
  let i₁ : Limits.pullback (ã ≫ wcHalA1Proj (b ≫ s)) w ≅
      Limits.pullback (θ.hom ≫ a₂ ≫ wcHalA1Proj (b ≫ s)) w :=
    Limits.pullback.congrHom hθ.symm rfl
  let m₃ : Limits.pullback (θ.hom ≫ a₂ ≫ wcHalA1Proj (b ≫ s)) w ⟶
      Limits.pullback (a₂ ≫ wcHalA1Proj (b ≫ s)) w :=
    Limits.pullback.map (θ.hom ≫ a₂ ≫ wcHalA1Proj (b ≫ s)) w (a₂ ≫ wcHalA1Proj (b ≫ s)) w
      θ.hom (𝟙 _) (𝟙 _) (by simp) (by simp)
  haveI : IsIso m₃ := Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
  have hH := (H3 A' (b ≫ s) (ã (IsLocalRing.closedPoint B)) hcl hcp B₂ Λ₂ W₂ φ₂ a₂ hd₂
    ((Limits.pullback b z).residueField p) w).1
  obtain ⟨E⟩ := wc_et_coh_iso_invariance (i₀.hom ≫ i₁.hom ≫ m₃) ℓ 0
  exact (Nat.card_congr E).symm.trans hH

theorem wc_et_coh0_card_prime_connected : ∀ (T : Scheme.{u}) (ℓ : ℕ), ℓ.Prime → Nat.card (wcEtCoh T ℓ 0) = ℓ → ConnectedSpace T :=
by
  intro T ℓ hℓ hcard
  have htop : ∀ (X : Type u) [TopologicalSpace X],
      Nat.card (LocallyConstant X (ZMod ℓ)) = ℓ → ConnectedSpace X := by
    intro X _ hX
    have h2 : 2 ≤ ℓ := hℓ.two_le
    haveI : NeZero ℓ := ⟨by omega⟩
    haveI hfin : Finite (LocallyConstant X (ZMod ℓ)) := Nat.finite_of_card_ne_zero (by omega)
    rw [connectedSpace_iff_clopen]
    refine ⟨?_, ?_⟩
    · by_contra hne
      rw [not_nonempty_iff] at hne
      haveI : Subsingleton (LocallyConstant X (ZMod ℓ)) :=
        ⟨fun f g => LocallyConstant.ext (fun x => isEmptyElim x)⟩
      have h1 : Nat.card (LocallyConstant X (ZMod ℓ)) = 1 := Nat.card_unique
      omega
    · intro s hs
      by_contra hcon
      rw [not_or] at hcon
      obtain ⟨p, hp⟩ := Set.nonempty_iff_ne_empty.mpr hcon.1
      obtain ⟨q, hq⟩ := (Set.ne_univ_iff_exists_notMem s).mp hcon.2
      let χ₁ := LocallyConstant.charFn (ZMod ℓ) hs
      let χ₂ := LocallyConstant.charFn (ZMod ℓ) hs.compl
      let Φ : ZMod ℓ × ZMod ℓ → LocallyConstant X (ZMod ℓ) := fun ab => ab.1 • χ₁ + ab.2 • χ₂
      have hp' : ∀ ab, Φ ab p = ab.1 := by
        intro ab
        simp [Φ, χ₁, χ₂, LocallyConstant.coe_charFn, hp]
      have hq' : ∀ ab, Φ ab q = ab.2 := by
        intro ab
        simp [Φ, χ₁, χ₂, LocallyConstant.coe_charFn, hq]
      have hinj : Function.Injective Φ := by
        intro a b hab
        have e1 := hp' a
        have e2 := hp' b
        have e3 := hq' a
        have e4 := hq' b
        rw [hab] at e1 e3
        exact Prod.ext (e1.symm.trans e2) (e3.symm.trans e4)
      have hle := Nat.card_le_card_of_injective Φ hinj
      rw [Nat.card_prod, Nat.card_zmod, hX] at hle
      nlinarith
  let T₀ : T.Etale := Scheme.Etale.mk (𝟙 T)
  have hT₀ : Limits.IsTerminal T₀ :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨ε, -, -⟩ := wc_et_const_hom_sections_equiv T T₀ hT₀
  obtain ⟨e, -⟩ := wc_et_const_zmod_sections_locallyConstant T ℓ
    (fun V S hS x hx => wc_et_locallyConstant_glue T V S hS ℓ x hx)
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
  have h1 : Nat.card (wcEtCoh T ℓ 0) = Nat.card (LocallyConstant T (ZMod ℓ)) := by
    unfold wcEtCoh
    rw [Nat.card_congr Abelian.Ext.homEquiv₀, Nat.card_congr (ε _), Nat.card_congr (e T₀).toEquiv]
    rfl
  exact htop T (h1 ▸ hcard)

theorem wc_absflat_affine_t2 : ∀ (P : Scheme.{u}) [IsAffine P], (∀ f : Γ(P, ⊤), ∃ t : Γ(P, ⊤), f * f * t = f) → T2Space P :=
by
  intro P _ hreg
  have key : ∀ (R : Type u) [CommRing R], (∀ f : R, ∃ t : R, f * f * t = f) →
      T2Space (PrimeSpectrum R) := by
    intro R _ hR
    have sep : ∀ (p q : PrimeSpectrum R) (f : R), f ∈ p.asIdeal → f ∉ q.asIdeal →
        ∃ U V : Set (PrimeSpectrum R), IsOpen U ∧ IsOpen V ∧ p ∈ U ∧ q ∈ V ∧ Disjoint U V := by
      intro p q f hfp hfq
      obtain ⟨t, ht⟩ := hR f
      obtain ⟨e, he⟩ : ∃ e : R, e = f * t := ⟨_, rfl⟩
      have hee : e * e = e := by
        rw [he]
        calc (f * t) * (f * t) = (f * f * t) * t := by ring
          _ = f * t := by rw [ht]
      have hfe : f * e = f := by rw [he, ← mul_assoc]; exact ht
      have hep : e ∈ p.asIdeal := by rw [he]; exact p.asIdeal.mul_mem_right t hfp
      have heq : e ∉ q.asIdeal := fun h => hfq (by rw [← hfe]; exact q.asIdeal.mul_mem_left f h)
      have h1p : (1 - e) ∉ p.asIdeal := by
        intro h
        apply p.isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have := p.asIdeal.add_mem hep h
        simpa using this
      refine ⟨(PrimeSpectrum.basicOpen (1 - e) : Set (PrimeSpectrum R)),
        (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum R)),
        (PrimeSpectrum.basicOpen (1 - e)).isOpen, (PrimeSpectrum.basicOpen e).isOpen, ?_, ?_, ?_⟩
      · simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]; exact h1p
      · simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]; exact heq
      rw [Set.disjoint_left]
      intro z hz1 hz2
      simp only [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hz1 hz2
      have h0 : (1 - e) * e ∈ z.asIdeal := by
        have h00 : (1 - e) * e = 0 := by rw [sub_mul, one_mul, hee, sub_self]
        rw [h00]; exact z.asIdeal.zero_mem
      rcases z.isPrime.mem_or_mem h0 with h | h
      · exact hz1 h
      · exact hz2 h
    constructor
    intro x y hxy
    have hne : x.asIdeal ≠ y.asIdeal := fun h => hxy (PrimeSpectrum.ext h)
    by_cases hle : x.asIdeal ≤ y.asIdeal
    · have hnle : ¬ y.asIdeal ≤ x.asIdeal := fun h => hne (le_antisymm hle h)
      obtain ⟨f, hfy, hfx⟩ := Set.not_subset.mp hnle
      obtain ⟨U, V, hU, hV, hyU, hxV, hd⟩ := sep y x f hfy hfx
      exact ⟨V, U, hV, hU, hxV, hyU, hd.symm⟩
    · obtain ⟨f, hfx, hfy⟩ := Set.not_subset.mp hle
      exact sep x y f hfx hfy
  haveI : T2Space (Spec Γ(P, ⊤)) := key _ hreg
  exact (Scheme.homeoOfIso P.isoSpec).symm.t2Space

theorem wc_lc_descend_connected_fibres : ∀ {T P : Type u} [TopologicalSpace T] [TopologicalSpace P] [CompactSpace T] [T2Space P] (π : T → P), Continuous π → Function.Surjective π → (∀ p : P, IsPreconnected (π ⁻¹' {p})) → ∀ {M : Type v} (g : LocallyConstant T M), ∃ gbar : LocallyConstant P M, ∀ t, gbar (π t) = g t :=
by
  intro T P _ _ _ _ π hπc hsurj hfib M g
  classical
  have hfac : ∀ t, g (Function.surjInv hsurj (π t)) = g t := by
    intro t
    apply g.apply_eq_of_isPreconnected (hfib (π t))
    · show π (Function.surjInv hsurj (π t)) ∈ ({π t} : Set P)
      rw [Function.surjInv_eq hsurj]
      exact Set.mem_singleton _
    · show π t ∈ ({π t} : Set P)
      exact Set.mem_singleton _
  have hq : Topology.IsQuotientMap π := (hπc.isClosedMap).isQuotientMap hπc hsurj
  refine ⟨⟨fun p => g (Function.surjInv hsurj p), ?_⟩, fun t => hfac t⟩
  rw [IsLocallyConstant.iff_isOpen_fiber]
  intro m
  have hpre : π ⁻¹' ((fun p => g (Function.surjInv hsurj p)) ⁻¹' {m}) = {t | g t = m} := by
    ext t
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq, hfac]
  have hcl : IsClopen {t | g t = m} := g.isLocallyConstant.isClopen_fiber m
  rw [← hpre] at hcl
  exact (hq.isClopen_preimage.mp hcl).isOpen

theorem wc_lc_descend_affine_limit_stage : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ Scheme.{u}) (P : Scheme.{u}) [IsAffine P] (π : ∀ l, P ⟶ D.obj l), (∀ l, IsAffine (D.obj l)) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ D.map t = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ D.map t = z l') → ∃! z₀ : T ⟶ P, ∀ l, z₀ ≫ π l = z l) → ∀ (M : Type) (g : LocallyConstant P M), ∃ (l : Λ) (d : LocallyConstant (D.obj l) M), ∀ p : P, d (π l p) = g p :=
by
  intro Λ _ _ D P _ π haff hπ hlim M g
  classical
  haveI := haff
  haveI hAH : ∀ {i j : Λ} (f : i ⟶ j), IsAffineHom (D.map f) := fun {i j} f =>
    @isAffineHom_of_isAffine _ _ (D.map f) (haff i) (haff j)

  let c : Limits.Cone D :=
    { pt := P, π := { app := π, naturality := fun k k' t => by simp [hπ t] } }
  have hc : Limits.IsLimit c :=
    Limits.IsLimit.ofExistsUnique (fun s => hlim s.pt s.π.app (fun t => s.w t))

  have s2 : ∀ (X : Scheme.{u}) (e : Γ(X, ⊤)), IsIdempotentElem e →
      IsClopen (X.basicOpen e : Set X) := by
    intro X e he
    have h1 : X.basicOpen e ⊓ X.basicOpen (1 - e) = ⊥ := by
      rw [← Scheme.basicOpen_mul]
      have : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he.eq, sub_self]
      rw [this, Scheme.basicOpen_zero]
    have h2 : (⊤ : X.Opens) ≤ X.basicOpen e ⊔ X.basicOpen (1 - e) := by
      have := Scheme.basicOpen_add_le X e (1 - e)
      rwa [add_sub_cancel, Scheme.basicOpen_one] at this
    have hcpl : (X.basicOpen e : Set X)ᶜ = (X.basicOpen (1 - e) : Set X) := by
      ext x
      simp only [Set.mem_compl_iff, SetLike.mem_coe]
      constructor
      · intro hx
        have hx2 : x ∈ X.basicOpen e ⊔ X.basicOpen (1 - e) := h2 (show x ∈ (⊤ : X.Opens) from trivial)
        rcases (TopologicalSpace.Opens.mem_sup.mp hx2) with h | h
        · exact absurd h hx
        · exact h
      · intro hy hx
        have hxy : x ∈ X.basicOpen e ⊓ X.basicOpen (1 - e) := ⟨hx, hy⟩
        rw [h1] at hxy
        simpa using hxy
    refine ⟨?_, (X.basicOpen e).isOpen⟩
    rw [← isOpen_compl_iff, hcpl]
    exact (X.basicOpen (1 - e)).isOpen

  have s1 : ∀ (X : Scheme.{u}) [IsAffine X] (U : Set X), IsClopen U →
      ∃ e : Γ(X, ⊤), IsIdempotentElem e ∧ (X.basicOpen e : Set X) = U := by
    intro X _ U hU
    let h : X ≃ₜ Spec Γ(X, ⊤) := Scheme.homeoOfIso X.isoSpec
    have hU' : IsClopen (h.symm ⁻¹' U) := hU.preimage h.symm.continuous
    obtain ⟨e, he, heU⟩ := PrimeSpectrum.isClopen_iff.mp hU'
    refine ⟨e, he, ?_⟩
    ext x
    have hx : h x = X.toSpecΓ x := by
      rw [Scheme.homeoOfIso_apply, Scheme.isoSpec_hom]
    have key : x ∈ (X.basicOpen e : Set X) ↔ h x ∈ h.symm ⁻¹' U := by
      rw [heU, hx, ← Scheme.toSpecΓ_preimage_basicOpen]; exact Iff.rfl
    rw [key, Set.mem_preimage, Homeomorph.symm_apply_apply]

  have lift : ∀ e : Γ(P, ⊤), IsIdempotentElem e →
      ∃ (l : Λ) (t : Γ(D.obj l, ⊤)), IsIdempotentElem t ∧ (π l).appTop t = e := by
    intro e he
    obtain ⟨l₀, t₀, ht₀⟩ := exists_appTop_π_eq_of_isAffine_of_isLimit D c hc e
    have ht₀' : (π l₀).appTop t₀ = e := ht₀
    have h1 : (π l₀).app ⊤ (t₀ * t₀) = (π l₀).app ⊤ t₀ := by
      change (π l₀).appTop (t₀ * t₀) = (π l₀).appTop t₀
      rw [map_mul, ht₀', he.eq]
    have hcpt : IsCompact ((⊤ : (D.obj l₀).Opens) : Set (D.obj l₀)) := by
      rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ
    obtain ⟨j, f, hf⟩ := exists_app_map_eq_map_of_isLimit D c hc hcpt (t₀ * t₀) t₀ h1
    refine ⟨j, (D.map f).appTop t₀, ?_, ?_⟩
    · change (D.map f).appTop t₀ * (D.map f).appTop t₀ = (D.map f).appTop t₀
      rw [← map_mul]
      exact hf
    · have h3 : (π j ≫ D.map f).appTop t₀ = e := by rw [hπ f]; exact ht₀'
      rw [Scheme.Hom.comp_appTop] at h3
      exact h3
  rcases isEmpty_or_nonempty P with hP | ⟨⟨p₀⟩⟩
  ·
    have hex : ∃ l, IsEmpty (D.obj l) := by
      by_contra hne
      haveI : ∀ l, Nonempty (D.obj l) := fun l => not_isEmpty_iff.mp (fun h => hne ⟨l, h⟩)
      have hn : Nonempty c.pt := Scheme.nonempty_of_isLimit D c hc
      exact hP.false hn.some
    obtain ⟨l, hl⟩ := hex
    exact ⟨l, ⟨fun x => (hl.false x).elim, IsLocallyConstant.of_constant _
      (fun x _ => (hl.false x).elim)⟩, fun p => (hP.false p).elim⟩
  · haveI : Nonempty M := ⟨g p₀⟩

    have desc : ∀ m : M, ∃ (l : Λ) (W : Set (D.obj l)), IsClopen W ∧
        ∀ p : P, π l p ∈ W ↔ g p = m := by
      intro m
      have hU : IsClopen {p : P | g p = m} := g.isLocallyConstant.isClopen_fiber m
      obtain ⟨e, he, heU⟩ := s1 P {p : P | g p = m} hU
      obtain ⟨l, t, ht, hte⟩ := lift e he
      refine ⟨l, ((D.obj l).basicOpen t : Set (D.obj l)), s2 _ t ht, fun p => ?_⟩
      have h1 : π l p ∈ ((D.obj l).basicOpen t : Set (D.obj l)) ↔
          p ∈ (P.basicOpen e : Set P) := by
        rw [← hte, ← Scheme.Hom.preimage_basicOpen_top]
        exact Iff.rfl
      have h2 : p ∈ (P.basicOpen e : Set P) ↔ g p = m := by
        rw [heU]; exact Iff.rfl
      exact h1.trans h2
    choose L W hWc hWp using desc
    obtain ⟨S, hS⟩ := IsCofiltered.inf_objs_exists ((g.range_finite.toFinset).image L)
    have hSm : ∀ m ∈ Set.range g, Nonempty (S ⟶ L m) := fun m hm =>
      hS (Finset.mem_image_of_mem L (g.range_finite.mem_toFinset.mpr hm))
    let fm : ∀ m ∈ Set.range g, S ⟶ L m := fun m hm => (hSm m hm).some
    let ι := Set.range g
    haveI : Finite ι := g.range_finite.to_subtype
    let W' : ι → Set (D.obj S) := fun i => ⇑(D.map (fm i.1 i.2)) ⁻¹' W i.1
    have hW'c : ∀ i, IsClopen (W' i) := fun i =>
      (hWc i.1).preimage (D.map (fm i.1 i.2)).continuous
    have hW'p : ∀ (i : ι) (p : P), π S p ∈ W' i ↔ g p = i.1 := by
      intro i p
      show D.map (fm i.1 i.2) (π S p) ∈ W i.1 ↔ _
      rw [← Scheme.Hom.comp_apply, hπ]
      exact hWp i.1 p
    let sig : D.obj S → (ι → Prop) := fun x i => x ∈ W' i
    have hsig : IsLocallyConstant sig := by
      rw [IsLocallyConstant.iff_exists_open]
      intro x
      refine ⟨⋂ i, (if x ∈ W' i then W' i else (W' i)ᶜ),
        isOpen_iInter_of_finite (fun i => ?_), ?_, ?_⟩
      · split_ifs
        · exact (hW'c i).isOpen
        · exact (hW'c i).compl.isOpen
      · rw [Set.mem_iInter]
        intro i
        split_ifs with h
        · exact h
        · exact h
      · intro x' hx'
        rw [Set.mem_iInter] at hx'
        funext i
        have hi := hx' i
        apply propext
        split_ifs at hi with h
        · exact iff_of_true hi h
        · exact iff_of_false hi h
    let H : (ι → Prop) → M := fun s =>
      if h : ∃ i, s i then (h.choose).1 else Classical.arbitrary M
    refine ⟨S, ⟨H ∘ sig, hsig.comp H⟩, fun p => ?_⟩
    have hex : ∃ i, sig (π S p) i := ⟨⟨g p, p, rfl⟩, (hW'p _ p).mpr rfl⟩
    show H (sig (π S p)) = g p
    simp only [H, dif_pos hex]
    exact ((hW'p _ p).mp hex.choose_spec).symm

theorem wc_et_baseChange_limit_cone : ∀ {X' Y' : Scheme.{u}} (h : X' ⟶ Y') (A : Type u) [CommRing A] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ Y'.Etale) (φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left) (a : Spec (.of A) ⟶ Y'), (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) → ∀ (XZ : Scheme.{u}) (p : XZ ⟶ X') (hZ : XZ ⟶ Spec (.of A)), IsPullback p hZ h a → ∃ π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange h).obj l).left, (∀ l, π l ≫ ((W ⋙ wcEtBaseChange h).obj l).hom = p) ∧ (∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom h = hZ ≫ φ l) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange h).map t).left = π l') ∧ ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange h).obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange h).map t).left = z l') → ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l :=
by
  intro X' Y' h A _ Λ _ _ W φ a hφ hφa hlim XZ p hZ hpb
  have M1 : ∀ {l l' : Λ} (t : l ⟶ l'),
      ((W ⋙ wcEtBaseChange h).map t).left ≫ Limits.pullback.fst (W.obj l').hom h =
        Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left := by
    intro l l' t
    exact Limits.pullback.lift_fst _ _ _
  have M2 : ∀ {l l' : Λ} (t : l ⟶ l'),
      ((W ⋙ wcEtBaseChange h).map t).left ≫ Limits.pullback.snd (W.obj l').hom h =
        Limits.pullback.snd (W.obj l).hom h := by
    intro l l' t
    exact Limits.pullback.lift_snd _ _ _
  have hw : p ≫ h = hZ ≫ a := hpb.w
  have wl : ∀ l, (hZ ≫ φ l) ≫ (W.obj l).hom = p ≫ h := by
    intro l
    rw [Category.assoc, hφa l, hw]
  let π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange h).obj l).left := fun l =>
    Limits.pullback.lift (hZ ≫ φ l) p (wl l)
  have P1 : ∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom h = hZ ≫ φ l := fun l =>
    Limits.pullback.lift_fst _ _ _
  have P2 : ∀ l, π l ≫ Limits.pullback.snd (W.obj l).hom h = p := fun l =>
    Limits.pullback.lift_snd _ _ _
  have C2 : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange h).map t).left = π l' := by
    intro l l' t
    refine Limits.pullback.hom_ext (f := (W.obj l').hom) (g := h) ?_ ?_
    · calc (π l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫ Limits.pullback.fst (W.obj l').hom h
          = π l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
              Limits.pullback.fst (W.obj l').hom h) := Category.assoc _ _ _
        _ = π l ≫ (Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left) := whisker_eq _ (M1 t)
        _ = (π l ≫ Limits.pullback.fst (W.obj l).hom h) ≫ (W.map t).left :=
            (Category.assoc _ _ _).symm
        _ = (hZ ≫ φ l) ≫ (W.map t).left := eq_whisker (P1 l) _
        _ = hZ ≫ φ l' := by rw [Category.assoc, hφ t]
        _ = π l' ≫ Limits.pullback.fst (W.obj l').hom h := (P1 l').symm
    · calc (π l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫ Limits.pullback.snd (W.obj l').hom h
          = π l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
              Limits.pullback.snd (W.obj l').hom h) := Category.assoc _ _ _
        _ = π l ≫ Limits.pullback.snd (W.obj l).hom h := whisker_eq _ (M2 t)
        _ = p := P2 l
        _ = π l' ≫ Limits.pullback.snd (W.obj l').hom h := (P2 l').symm
  have C3 : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange h).obj l).left),
      (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange h).map t).left = z l') →
      ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l := by
    intro T z hz
    have hs : ∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ Limits.pullback.snd (W.obj l).hom h =
        z l' ≫ Limits.pullback.snd (W.obj l').hom h := by
      intro l l' t
      calc z l ≫ Limits.pullback.snd (W.obj l).hom h
          = z l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
              Limits.pullback.snd (W.obj l').hom h) := (whisker_eq _ (M2 t)).symm
        _ = (z l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫
              Limits.pullback.snd (W.obj l').hom h := (Category.assoc _ _ _).symm
        _ = z l' ≫ Limits.pullback.snd (W.obj l').hom h := eq_whisker (hz t) _
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hX : ∀ l, z l ≫ Limits.pullback.snd (W.obj l).hom h =
        z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := fun l =>
      (hs (IsCofiltered.minToLeft l l₀)).symm.trans (hs (IsCofiltered.minToRight l l₀))
    have hf : ∀ {l l' : Λ} (t : l ⟶ l'), (z l ≫ Limits.pullback.fst (W.obj l).hom h) ≫
        (W.map t).left = z l' ≫ Limits.pullback.fst (W.obj l').hom h := by
      intro l l' t
      calc (z l ≫ Limits.pullback.fst (W.obj l).hom h) ≫ (W.map t).left
          = z l ≫ (Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left) := Category.assoc _ _ _
        _ = z l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
              Limits.pullback.fst (W.obj l').hom h) := whisker_eq _ (M1 t).symm
        _ = (z l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫
              Limits.pullback.fst (W.obj l').hom h := (Category.assoc _ _ _).symm
        _ = z l' ≫ Limits.pullback.fst (W.obj l').hom h := eq_whisker (hz t) _
    obtain ⟨y, hy, hyu⟩ := hlim T (fun l => z l ≫ Limits.pullback.fst (W.obj l).hom h) hf
    have hy' : ∀ l, y ≫ φ l = z l ≫ Limits.pullback.fst (W.obj l).hom h := hy
    have hxy : (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) ≫ h = y ≫ a := by
      calc (z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) ≫ h
          = z l₀ ≫ (Limits.pullback.snd (W.obj l₀).hom h ≫ h) := Category.assoc _ _ _
        _ = z l₀ ≫ (Limits.pullback.fst (W.obj l₀).hom h ≫ (W.obj l₀).hom) :=
            whisker_eq _ Limits.pullback.condition.symm
        _ = (z l₀ ≫ Limits.pullback.fst (W.obj l₀).hom h) ≫ (W.obj l₀).hom :=
            (Category.assoc _ _ _).symm
        _ = (y ≫ φ l₀) ≫ (W.obj l₀).hom := eq_whisker (hy' l₀).symm _
        _ = y ≫ a := by rw [Category.assoc, hφa l₀]
    obtain ⟨z₀, hz₀p, hz₀Z⟩ : ∃ z₀ : T ⟶ XZ,
        z₀ ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h ∧ z₀ ≫ hZ = y :=
      ⟨hpb.lift _ y hxy, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
    refine ⟨z₀, fun l => ?_, fun z' hz' => ?_⟩
    · refine Limits.pullback.hom_ext (f := (W.obj l).hom) (g := h) ?_ ?_
      · calc (z₀ ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom h
            = z₀ ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom h) := Category.assoc _ _ _
          _ = z₀ ≫ (hZ ≫ φ l) := whisker_eq _ (P1 l)
          _ = (z₀ ≫ hZ) ≫ φ l := (Category.assoc _ _ _).symm
          _ = y ≫ φ l := eq_whisker hz₀Z _
          _ = z l ≫ Limits.pullback.fst (W.obj l).hom h := hy' l
      · calc (z₀ ≫ π l) ≫ Limits.pullback.snd (W.obj l).hom h
            = z₀ ≫ (π l ≫ Limits.pullback.snd (W.obj l).hom h) := Category.assoc _ _ _
          _ = z₀ ≫ p := whisker_eq _ (P2 l)
          _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := hz₀p
          _ = z l ≫ Limits.pullback.snd (W.obj l).hom h := (hX l).symm
    · have e1 : z' ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := by
        calc z' ≫ p = z' ≫ (π l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h) :=
              whisker_eq _ (P2 l₀).symm
          _ = (z' ≫ π l₀) ≫ Limits.pullback.snd (W.obj l₀).hom h := (Category.assoc _ _ _).symm
          _ = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := eq_whisker (hz' l₀) _
      have e2 : z' ≫ hZ = y := by
        apply hyu
        intro l
        calc (z' ≫ hZ) ≫ φ l = z' ≫ (hZ ≫ φ l) := Category.assoc _ _ _
          _ = z' ≫ (π l ≫ Limits.pullback.fst (W.obj l).hom h) := whisker_eq _ (P1 l).symm
          _ = (z' ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom h := (Category.assoc _ _ _).symm
          _ = z l ≫ Limits.pullback.fst (W.obj l).hom h := eq_whisker (hz' l) _
      exact hpb.hom_ext (e1.trans hz₀p.symm) (e2.trans hz₀Z.symm)
  exact ⟨π, P2, P1, C2, C3⟩

theorem wc_local_etale_hom_ext : ∀ (R : Type u) [CommRing R] [IsLocalRing R] {E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (α β : Spec (.of R) ⟶ E), α ≫ e = β ≫ e → ∀ (Ω' : Type u) [Field Ω'] (π : Spec (.of Ω') ⟶ Spec (.of R)), π (IsLocalRing.closedPoint Ω') = IsLocalRing.closedPoint R → π ≫ α = π ≫ β → α = β :=
by
  intro R _ _ E S e _ α β hab Ω' _ π hpt hπ
  classical
  let c : Spec (.of R) ⟶ Limits.pullback e e := Limits.pullback.lift α β hab
  have hcf : c ≫ Limits.pullback.fst e e = α := Limits.pullback.lift_fst _ _ _
  have hcs : c ≫ Limits.pullback.snd e e = β := Limits.pullback.lift_snd _ _ _
  have hkey : π ≫ c = (π ≫ α) ≫ Limits.pullback.diagonal e := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
    · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
        hπ]
  have hptw : ∀ w : Spec (.of Ω'), c (π w) = Limits.pullback.diagonal e (α (π w)) := by
    intro w
    rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
  set U := c ⁻¹ᵁ (Limits.pullback.diagonal e).opensRange with hU
  have hmem : π (IsLocalRing.closedPoint Ω') ∈ U := by
    show c (π (IsLocalRing.closedPoint Ω')) ∈ (Limits.pullback.diagonal e).opensRange
    rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
    exact ⟨_, (hptw _).symm⟩
  have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal e) := by
    rintro _ ⟨x, rfl⟩
    have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι] at hx0
    have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal e).opensRange := hx0
    rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
    rw [Scheme.Hom.comp_apply]
    exact hx'
  obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal e = U.ι ≫ c :=
    ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal e) (U.ι ≫ c) hrange⟩
  have h1 : U.ι ≫ α = t := by
    calc U.ι ≫ α = (U.ι ≫ c) ≫ Limits.pullback.fst e e := by rw [Category.assoc, hcf]
      _ = (t ≫ Limits.pullback.diagonal e) ≫ Limits.pullback.fst e e := by rw [ht]
      _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
  have h2 : U.ι ≫ β = t := by
    calc U.ι ≫ β = (U.ι ≫ c) ≫ Limits.pullback.snd e e := by rw [Category.assoc, hcs]
      _ = (t ≫ Limits.pullback.diagonal e) ≫ Limits.pullback.snd e e := by rw [ht]
      _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
  have hUeq : U.ι ≫ α = U.ι ≫ β := by rw [h1, h2]
  have hU' : IsLocalRing.closedPoint R ∈ U := by
    rw [← hpt]
    exact hmem
  have hsub : Set.range ⇑(𝟙 (Spec (.of R))) ⊆ Set.range ⇑U.ι := by
    intro x _
    rw [Scheme.Opens.range_ι]
    exact (IsLocalRing.specializes_closedPoint (R := R) x).mem_open U.isOpen hU'
  have hk := IsOpenImmersion.lift_fac U.ι (𝟙 _) hsub
  calc α = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ α := by
        rw [hk, Category.id_comp]
    _ = (IsOpenImmersion.lift U.ι (𝟙 _) hsub ≫ U.ι) ≫ β := by
        simp only [Category.assoc, hUeq]
    _ = β := by rw [hk, Category.id_comp]

theorem wc_hal_bc_lc_local_surj : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → (∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (x : wcHalA1 s), IsClosed ({x} : Set (wcHalA1 s)) → wcHalA1Proj s x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (wcHalA1 s) x)) (Scheme.Etale.forget (wcHalA1 s))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ wcHalA1 s), wcHalShData x B Λ W' φ a → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), Nat.card (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ 0) = ℓ ∧ ∀ q : ℕ, 1 ≤ q → Subsingleton (wcEtCoh (Limits.pullback (a ≫ wcHalA1Proj s) z) ℓ q)) → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (s : Spec (.of A) ⟶ Spec (.of K)) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)) (O : (wcHalA1 s).Etale) (o : O.left), (∀ x' : wcHalA1 s, wcHalA1Proj s x' = wcHalA1Proj s (O.hom o) → O.hom o ⤳ x' → x' = O.hom o) → ∀ (f : LocallyConstant ↥(Limits.pullback O.hom (Limits.pullback.fst (wcHalA1Proj s) z)) (ZMod ℓ)), ∃ (O₁ : (wcHalA1 s).Etale) (c : O₁ ⟶ O) (o₁ : O₁.left) (W : (Spec (.of A)).Etale) (h : O₁.left ⟶ W.left) (hh : h ≫ W.hom = O₁.hom ≫ wcHalA1Proj s) (d : LocallyConstant ↥(Limits.pullback W.hom z) (ZMod ℓ)), c.left o₁ = o ∧ ∀ (m : Limits.pullback O₁.hom (Limits.pullback.fst (wcHalA1Proj s) z) ⟶ Limits.pullback O.hom (Limits.pullback.fst (wcHalA1Proj s) z)) (κ : Limits.pullback O₁.hom (Limits.pullback.fst (wcHalA1Proj s) z) ⟶ Limits.pullback W.hom z), m ≫ Limits.pullback.fst O.hom (Limits.pullback.fst (wcHalA1Proj s) z) = Limits.pullback.fst O₁.hom (Limits.pullback.fst (wcHalA1Proj s) z) ≫ c.left → m ≫ Limits.pullback.snd O.hom (Limits.pullback.fst (wcHalA1Proj s) z) = Limits.pullback.snd O₁.hom (Limits.pullback.fst (wcHalA1Proj s) z) → κ ≫ Limits.pullback.fst W.hom z = Limits.pullback.fst O₁.hom (Limits.pullback.fst (wcHalA1Proj s) z) ≫ h → κ ≫ Limits.pullback.snd W.hom z = Limits.pullback.snd O₁.hom (Limits.pullback.fst (wcHalA1Proj s) z) ≫ Limits.pullback.snd (wcHalA1Proj s) z → ∀ q, f (m q) = d (κ q) :=
by
