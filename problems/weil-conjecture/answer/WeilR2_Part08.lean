  rw [hι] at hstalk
  obtain ⟨V, v0, hv0, hV⟩ := wc_et_stalk_zero_kpoint K X fX ℓ _ _ x hstalk

  obtain ⟨T, h, t, e, ht, he⟩ := wc_et_mod_homology_local_boundary X (wcEtZModRing X ℓ) Kc 1 k hkc
