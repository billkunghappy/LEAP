        ∀ (hg : ∀ J, W.basicOpen (t J) ≤ g ⁻¹ᵁ D J) (hg' : ∀ J, W.basicOpen (t J) ≤ g' ⁻¹ᵁ D J),
        (∀ J L, g.appLE (D J) (W.basicOpen (t J)) (hg J) (ε J L) *
          W.presheaf.map (homOfLE (le_top : W.basicOpen (t J) ≤ ⊤)).op (t J) =
          W.presheaf.map (homOfLE (le_top : W.basicOpen (t J) ≤ ⊤)).op (t L)) →
        (∀ J L, g'.appLE (D J) (W.basicOpen (t J)) (hg' J) (ε J L) *
          W.presheaf.map (homOfLE (le_top : W.basicOpen (t J) ≤ ⊤)).op (t J) =
          W.presheaf.map (homOfLE (le_top : W.basicOpen (t J) ≤ ⊤)).op (t L)) → g = g') →
      ∀ (X : Scheme.{u}) (fX : X ⟶ S) {I : Type u} (U : I → X.Opens), (⨆ i, U i) = ⊤ →
      ∀ (s : ∀ i, ι → Γ(X, U i)), (∀ i, Ideal.span (Set.range (s i)) = ⊤) →
      ∀ (w : ∀ i j, Γ(X, U i ⊓ U j)), (∀ i j, IsUnit (w i j)) →
      (∀ i j J, X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) =
        w i j * X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J)) →
      ∃ φ : X ⟶ P, φ ≫ q = fX ∧ (∀ i J, φ ⁻¹ᵁ D J ⊓ U i = X.basicOpen (s i J)) ∧
        ∀ i J L (O : X.Opens) (hO : O ≤ φ ⁻¹ᵁ D J) (hOi : O ≤ U i),
