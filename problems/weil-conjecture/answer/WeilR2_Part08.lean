  have gen : ∀ (X : Scheme.{u}) [IsAffine X] [AlgebraicGeometry.IsIntegral X] (pX : X ⟶ Spec (.of K))
      [Smooth pX] (Y : Matrix (Fin c) (Fin c) Γ(X, ⊤)),
