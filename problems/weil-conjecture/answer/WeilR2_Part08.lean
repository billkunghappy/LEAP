          (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX)
          (Abelian.Ext.mapExactFunctor
            (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ) u')).comp z
            (add_zero q))
        (Abelian.Ext.mapExactFunctor_mk₀ _ _))
  refine (congrArg (fun z => (Abelian.Ext.mk₀ (ι.app (wcEtSuppObj Dy'))).comp z (zero_add q)) e1).trans ?_
  refine (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm.trans ?_
  refine (congrArg (fun z => z.comp (Abelian.Ext.mk₀
    ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX).map τ)) (add_zero q))
    key.symm).trans ?_
  refine (Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ _).trans ?_
  refine (congrArg (fun z => (Abelian.Ext.mapExactFunctor (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcEtSliceOf T.left s hsE) _ _ hcY ψY) u').comp z (add_zero q))
    (Abelian.Ext.mk₀_comp_mk₀ _ _)).trans ?_
  refine (congrArg (fun z => z.comp (Abelian.Ext.mk₀ (ι.app (SheafOfModules.unit (wcEtZModRing Y' ℓ)) ≫
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX).map τ)) (add_zero q))
    hu'').trans ?_
  refine (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).trans ?_
  refine congrArg (fun z => (Abelian.Ext.mk₀ (ι.app (wcEtSuppObj Dy'))).comp z (zero_add q)) ?_
  refine (Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ _).trans ?_
  refine (congrArg (fun z => (Abelian.Ext.mapExactFunctor
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtSlice T) _ _ hcX ψX) v).comp z (add_zero q))
    ((Abelian.Ext.mk₀_comp_mk₀ _ _).trans
      (congrArg Abelian.Ext.mk₀ (@IsIso.inv_hom_id _ _ _ _ _ hcI)))).trans ?_
  exact Abelian.Ext.comp_mk₀_id _

theorem wc_et_finite_trace_point_class : ∀ (K : Type u) [Field K] [IsAlgClosed K] (d : ℕ) (Y' : Scheme.{u}) (p : Y' ⟶ wcProjK K d), IsFinite p → IrreducibleSpace Y' → topologicalKrullDim Y' = (d : WithBot ℕ∞) → ∀ (y₀' : Spec (.of K) ⟶ Y') (W : Y'.Opens), y₀' (IsLocalRing.closedPoint K) ∈ W → Etale (W.ι ≫ p) → (y₀' ≫ p) ≫ wcProjKStr K d = 𝟙 _ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (Dy' : wcEtPullData y₀' ℓ) (Dx : wcEtPullData (y₀' ≫ p) ℓ), ∃ Tr : wcEtZModExt Y' ℓ (2 * d) →+ wcEtZModExt (wcProjK K d) ℓ (2 * d), ∀ v : wcEtSuppExt Dx (2 * d), ∃ u' : wcEtSuppExt Dy' (2 * d), Tr (wcEtSuppClass Dy' (2 * d) u') = wcEtSuppClass Dx (2 * d) v :=
by
  classical
  intro K _ _ d Y' p hpfin hirr hdim y₀' W hW hWet hx₀ ℓ _ hℓ Dy' Dx
  haveI : IsFinite p := hpfin
  haveI := wc_proj_space_isProper K d
  haveI : IsClosedImmersion ((y₀' ≫ p) ≫ wcProjKStr K d) := by rw [hx₀]; infer_instance
  haveI : IsClosedImmersion (y₀' ≫ p) := IsClosedImmersion.of_comp (y₀' ≫ p) (wcProjKStr K d)
  haveI : IsClosedImmersion y₀' := IsClosedImmersion.of_comp y₀' p
  obtain ⟨Dp⟩ := wc_et_zmod_pull_data_exists p ℓ
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (wcProjK K d) ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)) := HasExt.standard _
  haveI := Dp.additive
  haveI hadd : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont
      Dp.φ).Additive := Adjunction.right_adjoint_additive Dp.adj
  haveI hlim : Limits.PreservesFiniteLimits (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcEtBaseChange p) _ _ Dp.cont Dp.φ) := by
    haveI := Dp.adj.rightAdjoint_preservesLimits
    infer_instance
  haveI hcolim : Limits.PreservesFiniteColimits (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcEtBaseChange p) _ _ Dp.cont Dp.φ) := wc_et_finite_push_modules_exact p ℓ Dp
  have hWne : Nonempty W := ⟨⟨_, hW⟩⟩
  obtain ⟨τ, hτ⟩ := wc_et_finite_trace_sheet_normalised K d Y' p hpfin hirr hdim W hWne hWet ℓ Dp
  obtain ⟨T, t₀, s, hs, hsheet⟩ := wc_finite_etale_point_local_sheet K (wcProjK K d) Y' p hpfin
    y₀' W hW hWet inferInstance
  obtain ⟨κ, hκ⟩ := wc_et_supp_obj_comp_iso y₀' p Dy' Dp Dx
  have hsurj := wc_et_trace_sheet_supp_surj K (wcProjK K d) Y' p y₀' ℓ hℓ Dp Dy' τ hτ T t₀ s hs
    hsheet (2 * d)
  refine ⟨((Abelian.Ext.mk₀ (wcEtSuppUnitMap Dp)).precomp
      (SheafOfModules.unit (wcEtZModRing (wcProjK K d) ℓ)) (zero_add (2 * d))).comp
    (((Abelian.Ext.mk₀ τ).postcomp ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _
        Dp.cont Dp.φ).obj (SheafOfModules.unit (wcEtZModRing Y' ℓ))) (add_zero (2 * d))).comp
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).mapExtAddHom
        (SheafOfModules.unit (wcEtZModRing Y' ℓ)) (SheafOfModules.unit (wcEtZModRing Y' ℓ))
        (2 * d))), ?_⟩
  intro v
  obtain ⟨u', hu'⟩ := hsurj ((Abelian.Ext.mk₀ κ.inv).comp v (zero_add (2 * d)))
  refine ⟨u', ?_⟩
  beta_reduce at hu'
  show (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dp)).comp
      ((Abelian.Ext.mapExactFunctor (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _
          Dp.cont Dp.φ) ((Abelian.Ext.mk₀ (wcEtSuppUnitMap Dy')).comp u' (zero_add (2 * d)))).comp
        (Abelian.Ext.mk₀ τ) (add_zero (2 * d))) (zero_add (2 * d)) =
    (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dx)).comp v (zero_add (2 * d))
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.comp_assoc_of_third_deg_zero, hu', Abelian.Ext.mk₀_comp_mk₀_assoc]
  refine (Abelian.Ext.mk₀_comp_mk₀_assoc (wcEtSuppUnitMap Dp)
    ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).map
      (wcEtSuppUnitMap Dy') ≫ κ.inv) v).trans ?_
  have key : wcEtSuppUnitMap Dp ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).map
        (wcEtSuppUnitMap Dy') ≫ κ.inv = wcEtSuppUnitMap Dx := by
    refine (Category.assoc (wcEtSuppUnitMap Dp)
      ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange p) _ _ Dp.cont Dp.φ).map
        (wcEtSuppUnitMap Dy')) κ.inv).symm.trans ?_
    rw [← hκ, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  exact congrArg (fun f => (Abelian.Ext.mk₀ f).comp v (zero_add (2 * d))) key

theorem wc_et_supp_kernel_kill : ∀ {X Y Y' X' : Scheme.{u}} {n : ℕ} (i : X ⟶ Y) [IsClosedImmersion i] (f : Y' ⟶ Y) (i' : X' ⟶ Y') (g : X' ⟶ X), IsPullback g i' i f → ∀ (D : wcEtPullData i n) (Df : wcEtPullData f n) (D' : wcEtPullData i' n), Limits.kernel.ι (wcEtSuppUnitMap D') ≫ Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D) = 0 :=
by

  have wc_et_zmod_ring_locbij : ∀ (Y : Scheme.{u}) (n : ℕ),
      ∃ α : (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing Y n).obj,
        Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) α ∧
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α ∧
        ∀ V, ((n : ℕ) : ↑((wcEtZModRing Y n).obj.obj V)) = 0 := by
    intro Y n
    let P : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
    let α : P ⟶ (wcEtZModRing Y n).obj := toSheafify (Scheme.smallEtaleTopology Y) P
    refine ⟨α, Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Y) P,
      Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Y) P, ?_⟩
    intro V
    have h0 : ((n : ℕ) : ULift.{u+1} (ZMod n)) = 0 :=
      ULift.ext _ _ (by rw [ULift.down_natCast, ZMod.natCast_self, ULift.zero_down])
    have h1 := map_natCast (α.app V).hom n
    have h2 : (α.app V).hom ((n : ℕ) : ULift.{u+1} (ZMod n)) = 0 := by
      rw [h0]; exact map_zero _
    exact h1.symm.trans h2

  have covsurj : ∀ (S : Scheme.{u}) (V : S.Etale) (R : Sieve V),
      R ∈ Scheme.smallEtaleTopology S V → ∀ x : V.left,
      ∃ (Y : S.Etale) (f : Y ⟶ V) (y : Y.left), R.arrows f ∧ f.left y = x := by
    intro S V R h x
    haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
    have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V R).mp (e ▸ h)
    obtain ⟨Y, f, y, h1, _, h3⟩ := h' x
    exact ⟨Y, f, y, h1, h3⟩
  have botcov : ∀ (S : Scheme.{u}) (V : S.Etale), IsEmpty V.left →
      (⊥ : Sieve V) ∈ Scheme.smallEtaleTopology S V := by
    intro S V hV
    haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
    have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V
      (⊥ : Sieve V)).mpr (fun x => (IsEmpty.false x).elim)
    rw [show Scheme.smallEtaleTopology S = _ from e]
    exact h'

  have sep : ∀ (S : Scheme.{u}) (n : ℕ) (M : SheafOfModules.{u+1} (wcEtZModRing S n))
      (W : S.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology S W →
      ∀ x : ↑(M.val.obj (Opposite.op W)),
      (∀ (Q : S.Etale) (g : Q ⟶ W), R.arrows g → (M.val.map g.op).hom x = 0) → x = 0 := by
    intro S n M W R hR x h
    have hs := ((SheafOfModules.toSheaf _).obj M).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology S) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x 0
      (fun Q g hg => (h Q g hg).trans (map_zero ((M.val.map g.op).hom)).symm)
  have zeroEmpty : ∀ (S : Scheme.{u}) (n : ℕ) (M : SheafOfModules.{u+1} (wcEtZModRing S n))
      (V : S.Etale), IsEmpty V.left → ∀ x : ↑(M.val.obj (Opposite.op V)), x = 0 := by
    intro S n M V hV x
    exact sep S n M V ⊥ (botcov S V hV) x (fun Q g hg => hg.elim)

  have twist : ∀ {S T : Scheme.{u}} {j : T ⟶ S} {n : ℕ} (E : wcEtPullData j n),
      ∃ e : SheafOfModules.unit (wcEtZModRing T n) ⟶ SheafOfModules.unit (wcEtZModRing T n),
        wcEtSuppUnitMap E ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ).map e
          = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ := by
    intro S T j n E
    refine ⟨E.μ.inv ≫ (E.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ), ?_⟩
    dsimp only [wcEtSuppUnitMap, wcEtSuppObj]
    rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc,
      ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]

  have intcast_eq : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
      (α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj)
      (c : ULift.{u+1} (ZMod n)),
      (α.app (Opposite.op V)).hom c = (((c.down.cast : ℤ)) : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) := by
    intro S n V α c
    have hc : c = (((c.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
      apply ULift.ext
      rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
    conv_lhs => rw [hc]
    exact map_intCast (α.app (Opposite.op V)).hom _

  have comm : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
      (x y : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))), x * y = y * x := by
    intro S n V x y
    obtain ⟨α, hinj, hsurj, -⟩ := wc_et_zmod_ring_locbij S n
    have key := sep S n (SheafOfModules.unit (wcEtZModRing S n)) V
      (Presheaf.imageSieve α x) (Presheaf.imageSieve_mem _ α x) (x * y - y * x) (by
        rintro Q g ⟨c, hc⟩
        change ((wcEtZModRing S n).obj.map g.op).hom (x * y - y * x) = 0
        rw [map_sub, map_mul, map_mul, ← hc, intcast_eq, Int.cast_comm, sub_self])
    exact sub_eq_zero.mp key

  have intzero : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale) (k : ℤ),
      (k : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) = 0 → (k : ZMod n) = 0 ∨ IsEmpty V.left := by
    intro S n V k hk
    by_cases hV : IsEmpty V.left
    · exact Or.inr hV
    · left
      obtain ⟨x⟩ := not_isEmpty_iff.mp hV
      obtain ⟨α, hinj, hsurj, -⟩ := wc_et_zmod_ring_locbij S n
      have h1 : (α.app (Opposite.op V)).hom ((k : ULift.{u+1} (ZMod n))) =
          (α.app (Opposite.op V)).hom (0 : ULift.{u+1} (ZMod n)) := by
        rw [map_intCast, map_zero]; exact hk
      have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology S) α _ _ h1
      obtain ⟨Q, g, _, hg, _⟩ := covsurj S V _ hmem x
      have h2 : ((k : ULift.{u+1} (ZMod n))) = 0 := hg
      have h3 := congrArg ULift.down h2
      rw [ULift.down_intCast] at h3
      exact h3

  have crux : ∀ {S S' : Scheme.{u}} {j : S' ⟶ S} {n : ℕ} (E : wcEtPullData j n)
      {N : SheafOfModules.{u+1} (wcEtZModRing S n)} (w : SheafOfModules.unit (wcEtZModRing S n) ⟶ N)
      (V : S.Etale), (w.val.app (Opposite.op V)).hom (1 : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) = 0 →
      ((E.μ.inv ≫ E.Φ.map w).val.app (Opposite.op ((wcEtBaseChange j).obj V))).hom
        (1 : ↑((wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange j).obj V)))) = 0 := by
    intro S S' j n E N w V hw
    set FV := (wcEtBaseChange j).obj V with hFV
    let η1 : ↑((E.Φ.obj (SheafOfModules.unit (wcEtZModRing S n))).val.obj (Opposite.op FV)) :=
      ((E.adj.unit.app (SheafOfModules.unit (wcEtZModRing S n))).val.app (Opposite.op V)).hom
        (1 : ↑((wcEtZModRing S n).obj.obj (Opposite.op V)))
    have hA : ((E.Φ.map w).val.app (Opposite.op FV)).hom η1 = 0 := by
      have h2 := congrArg (fun h => (h.val.app (Opposite.op V)).hom
        (1 : ↑((wcEtZModRing S n).obj.obj (Opposite.op V)))) (E.adj.unit_naturality w)
      change ((E.Φ.map w).val.app (Opposite.op FV)).hom η1 =
        ((E.adj.unit.app N).val.app (Opposite.op V)).hom ((w.val.app (Opposite.op V)).hom
          (1 : ↑((wcEtZModRing S n).obj.obj (Opposite.op V)))) at h2
      rw [h2, hw, map_zero]
      rfl
    obtain ⟨e, he⟩ := twist E
    let s : ↑((wcEtZModRing S' n).obj.obj (Opposite.op FV)) := (E.μ.hom.val.app (Opposite.op FV)).hom η1
    let t : ↑((wcEtZModRing S' n).obj.obj (Opposite.op FV)) := (e.val.app (Opposite.op FV)).hom
      (1 : ↑((wcEtZModRing S' n).obj.obj (Opposite.op FV)))
    have hst : s * t = 1 := by
      have h2 := congrArg (fun h => (h.val.app (Opposite.op V)).hom
        (1 : ↑((wcEtZModRing S n).obj.obj (Opposite.op V)))) he
      change (e.val.app (Opposite.op FV)).hom s =
        (E.φ.hom.app (Opposite.op V)).hom (1 : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) at h2
      rw [map_one] at h2
      have h3 : (e.val.app (Opposite.op FV)).hom s = s * t := by
        have := (e.val.app (Opposite.op FV)).hom.map_smul s (1 : ↑((wcEtZModRing S' n).obj.obj (Opposite.op FV)))
        exact (congrArg (e.val.app (Opposite.op FV)).hom (mul_one s).symm).trans this
      exact h3.symm.trans h2
    have hts : t * s = 1 := (comm S' n FV t s).trans hst
    have hinv : (E.μ.inv.val.app (Opposite.op FV)).hom s = η1 := by
      have h2 := congrArg (fun h => (h.val.app (Opposite.op FV)).hom η1) E.μ.hom_inv_id
      exact h2
    have h1 : (E.μ.inv.val.app (Opposite.op FV)).hom
        (1 : ↑((wcEtZModRing S' n).obj.obj (Opposite.op FV))) = t • η1 := by
      have h4 := (E.μ.inv.val.app (Opposite.op FV)).hom.map_smul t s
      have h5 : (E.μ.inv.val.app (Opposite.op FV)).hom
          (1 : ↑((wcEtZModRing S' n).obj.obj (Opposite.op FV))) =
          (E.μ.inv.val.app (Opposite.op FV)).hom (t * s) := congrArg _ hts.symm
      rw [← hinv]
      exact h5.trans h4
    change ((E.Φ.map w).val.app (Opposite.op FV)).hom ((E.μ.inv.val.app (Opposite.op FV)).hom
      (1 : ↑((wcEtZModRing S' n).obj.obj (Opposite.op FV)))) = 0
    rw [h1, LinearMap.map_smul, hA, smul_zero]
  intro X Y Y' X' n i _ f i' g hsq D Df D'

  have avoid : ∀ (Q : Y'.Etale), IsEmpty ((wcEtBaseChange i').obj Q).left →
      ∀ q : Q.left, f (Q.hom q) ∉ Set.range ⇑i := by
    intro Q hQ q ⟨x, hx⟩
    have hQ' : IsEmpty ↥(Limits.pullback Q.hom i') := hQ
    obtain ⟨z, -, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := i) (g := f) x (Q.hom q) hx
    have hx' : i' (hsq.isoPullback.inv z) = Q.hom q := by
      rw [← Scheme.Hom.comp_apply, hsq.isoPullback_inv_snd, hz2]
    obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := Q.hom) (g := i') q _ hx'.symm
    exact hQ'.false w

  let Uo : Y.Opens := ⟨(Set.range ⇑i)ᶜ, (i.isClosedEmbedding.isClosed_range).isOpen_compl⟩
  let U : Y.Etale := wcEtOpen Y (wcEtTop Y) Uo
  have hUhom : ∀ a, U.hom a = Uo.ι a := fun a => by
    change (Uo.ι ≫ 𝟙 Y) a = _
    rw [Category.comp_id]
  have hU1 : ((wcEtSuppUnitMap D).val.app (Opposite.op U)).hom
      (1 : ↑((wcEtZModRing Y n).obj.obj (Opposite.op U))) = 0 := by
    have hE : IsEmpty ((wcEtBaseChange i).obj U).left := by
      change IsEmpty ↥(Limits.pullback U.hom i)
      refine ⟨fun p => ?_⟩
      have hc : (Limits.pullback.fst U.hom i ≫ U.hom) p = (Limits.pullback.snd U.hom i ≫ i) p := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hUhom] at hc
      have hmem : Uo.ι (Limits.pullback.fst U.hom i p) ∈ Set.range Uo.ι := ⟨_, rfl⟩
      rw [Scheme.Opens.range_ι] at hmem
      exact hmem ⟨_, hc.symm⟩
    exact zeroEmpty X n (SheafOfModules.unit (wcEtZModRing X n)) _ hE _
  have lift : ∀ (Q : Y'.Etale), (∀ q : Q.left, f (Q.hom q) ∉ Set.range ⇑i) →
      Nonempty (Q ⟶ (wcEtBaseChange f).obj U) := by
    intro Q hQ
    have hr : Set.range ⇑(Q.hom ≫ f) ⊆ Set.range ⇑Uo.ι := by
      rintro _ ⟨q, rfl⟩
      rw [Scheme.Opens.range_ι]
      show (Q.hom ≫ f) q ∈ (Set.range ⇑i)ᶜ
      rw [Scheme.Hom.comp_apply]
      exact hQ q
    have hl : IsOpenImmersion.lift Uo.ι (Q.hom ≫ f) hr ≫ U.hom = Q.hom ≫ f := by
      change IsOpenImmersion.lift Uo.ι (Q.hom ≫ f) hr ≫ (Uo.ι ≫ 𝟙 Y) = _
      rw [Category.comp_id, IsOpenImmersion.lift_fac]
    obtain ⟨l, hl'⟩ : ∃ l : Q.left ⟶ U.left, l ≫ U.hom = Q.hom ≫ f := ⟨_, hl⟩
    refine ⟨MorphismProperty.Over.homMk
      (Limits.pullback.lift l Q.hom hl' : Q.left ⟶ Limits.pullback U.hom f)
      ?_ trivial⟩
    exact Limits.pullback.lift_snd _ _ _

  have hv1 : ∀ (Q : Y'.Etale), IsEmpty ((wcEtBaseChange i').obj Q).left →
      ((Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)).val.app (Opposite.op Q)).hom
        (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q))) = 0 := by
    intro Q hQ
    obtain ⟨κ⟩ := lift Q (avoid Q hQ)
    have h := crux Df (wcEtSuppUnitMap D) U hU1
    have hn := PresheafOfModules.naturality_apply (Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)).val κ.op
      (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op ((wcEtBaseChange f).obj U))))
    have h1 : ((wcEtZModRing Y' n).obj.map κ.op).hom
        (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op ((wcEtBaseChange f).obj U)))) = 1 := map_one _
    change ((Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)).val.app (Opposite.op Q)).hom
        (((wcEtZModRing Y' n).obj.map κ.op).hom
          (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op ((wcEtBaseChange f).obj U))))) = _ at hn
    rw [h1] at hn
    rw [hn]
    erw [h]
    exact map_zero _

  have vk : ∀ (Q : Y'.Etale) (k : ℤ),
      ((wcEtSuppUnitMap D').val.app (Opposite.op Q)).hom
        (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q))) = 0 →
      ((Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)).val.app (Opposite.op Q)).hom
        (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q))) = 0 := by
    intro Q k hk
    obtain ⟨e', he'⟩ := twist D'
    have h2 := congrArg (fun h => (h.val.app (Opposite.op Q)).hom
      (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q)))) he'
    change (e'.val.app (Opposite.op ((wcEtBaseChange i').obj Q))).hom
      (((wcEtSuppUnitMap D').val.app (Opposite.op Q)).hom
        (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q)))) =
      (D'.φ.hom.app (Opposite.op Q)).hom (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q))) at h2
    rw [hk] at h2
    have h3 : (D'.φ.hom.app (Opposite.op Q)).hom (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q))) = 0 :=
      h2.symm.trans (LinearMap.map_zero _)
    rw [map_intCast] at h3
    rcases intzero X' n ((wcEtBaseChange i').obj Q) k h3 with hk0 | hE
    · obtain ⟨m, rfl⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd k n).mp hk0
      obtain ⟨α, -, -, hn⟩ := wc_et_zmod_ring_locbij Y' n
      have h0 : (((n : ℤ) * m : ℤ) : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q))) = 0 := by
        rw [Int.cast_mul, Int.cast_natCast, hn, zero_mul]
      exact (congrArg ((Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)).val.app (Opposite.op Q)).hom h0).trans
        (LinearMap.map_zero _)
    · have hl := (congrArg ((Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)).val.app (Opposite.op Q)).hom
        (mul_one (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q)))).symm).trans
        (((Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)).val.app (Opposite.op Q)).hom.map_smul
          (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q))) (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q))))
      rw [hl, hv1 Q hE, smul_zero]

  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro W
  obtain ⟨W⟩ := W
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro y
  let a : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op W)) :=
    ((Limits.kernel.ι (wcEtSuppUnitMap D')).val.app (Opposite.op W)).hom y
  have hρa : ((wcEtSuppUnitMap D').val.app (Opposite.op W)).hom a = 0 := by
    have h := congrArg (fun h => (h.val.app (Opposite.op W)).hom y)
      (Limits.kernel.condition (wcEtSuppUnitMap D'))
    exact h
  change ((Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)).val.app (Opposite.op W)).hom a = 0
  obtain ⟨α, hinj, hsurj, -⟩ := wc_et_zmod_ring_locbij Y' n
  refine sep Y' n (Df.Φ.obj (wcEtSuppObj D)) W (Presheaf.imageSieve α a)
    (Presheaf.imageSieve_mem _ α a) _ ?_
  rintro Q g ⟨c, hc⟩
  have hk : ((SheafOfModules.unit (wcEtZModRing Y' n)).val.map g.op).hom a =
      ((c.down.cast : ℤ) : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q))) :=
    hc.symm.trans (intcast_eq Y' n Q α c)
  have hnat := PresheafOfModules.naturality_apply (Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)).val g.op a
  have hnat' := PresheafOfModules.naturality_apply (wcEtSuppUnitMap D').val g.op a
  rw [hk] at hnat hnat'
  have h0 : ((wcEtSuppUnitMap D').val.app (Opposite.op Q)).hom
      ((c.down.cast : ℤ) : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op Q))) = 0 := by
    refine hnat'.trans ?_
    change ((wcEtSuppObj D').val.map g.op).hom (((wcEtSuppUnitMap D').val.app (Opposite.op W)).hom a) = 0
    rw [hρa]
    exact map_zero _
  exact hnat.symm.trans (vk Q _ h0)

theorem wc_et_closed_supp_base_change : ∀ {X Y Y' X' : Scheme.{u}} {n : ℕ} (i : X ⟶ Y) [IsClosedImmersion i] (f : Y' ⟶ Y) (i' : X' ⟶ Y') (g : X' ⟶ X), IsPullback g i' i f → ∀ (D : wcEtPullData i n) (Df : wcEtPullData f n) (D' : wcEtPullData i' n), ∃ γ : wcEtSuppObj D' ⟶ Df.Φ.obj (wcEtSuppObj D), wcEtSuppUnitMap D' ≫ γ = Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D) ∧ Epi (wcEtSuppUnitMap D') :=
by
  intro X Y Y' X' n i _ f i' g hsq D Df D'
  haveI : IsClosedImmersion i' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq ‹_›
  haveI hE : Epi (wcEtSuppUnitMap D') := wc_et_supp_unit_epi i' D'
  have hK := wc_et_supp_kernel_kill i f i' g hsq D Df D'
  exact ⟨Abelian.epiDesc (wcEtSuppUnitMap D') (Df.μ.inv ≫ Df.Φ.map (wcEtSuppUnitMap D)) hK,
    Abelian.comp_epiDesc _ _ _, hE⟩

theorem wc_et_supp_restr_comp : ∀ {Y Y₁ Y₂ X X₁ X₂ : Scheme.{u}} {n : ℕ} {i : X ⟶ Y} {i₁ : X₁ ⟶ Y₁} {i₂ : X₂ ⟶ Y₂} (f₁ : Y₁ ⟶ Y) (f₂ : Y₂ ⟶ Y₁) (f₁₂ : Y₂ ⟶ Y), f₂ ≫ f₁ = f₁₂ → ∀ (D : wcEtPullData i n) (D₁ : wcEtPullData i₁ n) (D₂ : wcEtPullData i₂ n) (E₁ : wcEtPullData f₁ n) (E₂ : wcEtPullData f₂ n) (E₁₂ : wcEtPullData f₁₂ n) (γ₁ : wcEtSuppObj D₁ ⟶ E₁.Φ.obj (wcEtSuppObj D)) (γ₂ : wcEtSuppObj D₂ ⟶ E₂.Φ.obj (wcEtSuppObj D₁)) (γ₁₂ : wcEtSuppObj D₂ ⟶ E₁₂.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D₁ ≫ γ₁ = E₁.μ.inv ≫ E₁.Φ.map (wcEtSuppUnitMap D) → wcEtSuppUnitMap D₂ ≫ γ₂ = E₂.μ.inv ≫ E₂.Φ.map (wcEtSuppUnitMap D₁) → wcEtSuppUnitMap D₂ ≫ γ₁₂ = E₁₂.μ.inv ≫ E₁₂.Φ.map (wcEtSuppUnitMap D) → Epi (wcEtSuppUnitMap D₂) → ∀ (k : ℕ) (θ : wcEtSuppExt D k), wcEtSuppRestr D E₁₂ D₂ γ₁₂ k θ = wcEtSuppRestr D₁ E₂ D₂ γ₂ k (wcEtSuppRestr D E₁ D₁ γ₁ k θ) :=
by
  classical
  intro Y Y₁ Y₂ X X₁ X₂ n i i₁ i₂ f₁ f₂ f₁₂ hf D D₁ D₂ E₁ E₂ E₁₂ γ₁ γ₂ γ₁₂ h₁ h₂ h₁₂ hepi k θ
  subst hf

  have s1 : ∀ (X' : Scheme.{u}) (T : Sheaf (Scheme.smallEtaleTopology X') RingCat.{u+1})
      (a b : wcEtZModRing X' n ⟶ T), a = b := by
    intro X' T a b
    have key : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod n) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod n →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    apply Sheaf.hom_ext
    apply sheafify_hom_ext (Scheme.smallEtaleTopology X') _ _ T.cond
    apply NatTrans.ext
    funext V
    apply RingCat.hom_ext
    exact key _ _

  have s2 : ∀ (X' : Scheme.{u}) (V : (X'.Etale)ᵒᵖ) (a b : ↑((wcEtZModRing X' n).obj.obj V)),
      a * b = b * a := by
    intro X' V a b
    obtain ⟨α, hsurj⟩ : ∃ α : (Functor.const (X'.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtZModRing X' n).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X') α :=
      ⟨toSheafify (Scheme.smallEtaleTopology X')
          ((Functor.const (X'.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))),
        Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology X') _⟩
    haveI := hsurj
    have hsep := Sheaf.isSeparated (wcEtZModRing X' n)
    induction V using Opposite.rec with
    | op V =>
    refine hsep V _ (GrothendieckTopology.intersection_covering _
      (Presheaf.imageSieve_mem _ α a) (Presheaf.imageSieve_mem _ α b)) (a * b) (b * a) ?_
    intro W h hh
    have hh' : (Presheaf.imageSieve α a).arrows h ∧ (Presheaf.imageSieve α b).arrows h := hh
    obtain ⟨⟨t₁, ht₁⟩, ⟨t₂, ht₂⟩⟩ := hh'
    have hc : t₁ * t₂ = t₂ * t₁ := @mul_comm (ULift.{u+1} (ZMod n)) _ t₁ t₂
    rw [map_mul, map_mul, ← ht₁, ← ht₂, ← map_mul, ← map_mul]
    exact congrArg _ hc

  have hmap : ∀ {A B : Scheme.{u}} (h : A ⟶ B) {V V' : B.Etale} (u : V ⟶ V'),
      ((wcEtBaseChange h).map u).left ≫ Limits.pullback.fst V'.hom h =
        Limits.pullback.fst V.hom h ≫ u.left ∧
      ((wcEtBaseChange h).map u).left ≫ Limits.pullback.snd V'.hom h =
        Limits.pullback.snd V.hom h := by
    intro A B h V V' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsnd : ∀ V : Y.Etale, (Limits.pullbackLeftPullbackSndIso V.hom f₁ f₂).symm.hom ≫
      Limits.pullback.snd (Limits.pullback.snd V.hom f₁) f₂ =
        Limits.pullback.snd V.hom (f₂ ≫ f₁) := by
    intro V
    rw [Iso.symm_hom, Iso.inv_comp_eq, Limits.pullbackLeftPullbackSndIso_hom_snd]
  choose c hc using fun V : Y.Etale =>
    (⟨MorphismProperty.Over.isoMk (A := (wcEtBaseChange (f₂ ≫ f₁)).obj V)
        (B := (wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂).obj V)
        (Limits.pullbackLeftPullbackSndIso V.hom f₁ f₂).symm (hsnd V),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcEtBaseChange (f₂ ≫ f₁)).obj V ≅ (wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂).obj V,
        c.hom.left = (Limits.pullbackLeftPullbackSndIso V.hom f₁ f₂).inv)
  have natc : ∀ {V V' : Y.Etale} (u : V ⟶ V'),
      (wcEtBaseChange (f₂ ≫ f₁)).map u ≫ (c V').hom =
        (c V).hom ≫ (wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂).map u := by
    intro V V' u
    have key : ∀ (L : Limits.pullback V.hom (f₂ ≫ f₁) ⟶ Limits.pullback V'.hom (f₂ ≫ f₁))
        (M1 : Limits.pullback V.hom f₁ ⟶ Limits.pullback V'.hom f₁)
        (M2 : Limits.pullback (Limits.pullback.snd V.hom f₁) f₂ ⟶
          Limits.pullback (Limits.pullback.snd V'.hom f₁) f₂),
        L ≫ Limits.pullback.fst V'.hom (f₂ ≫ f₁) = Limits.pullback.fst V.hom (f₂ ≫ f₁) ≫ u.left →
        L ≫ Limits.pullback.snd V'.hom (f₂ ≫ f₁) = Limits.pullback.snd V.hom (f₂ ≫ f₁) →
        M1 ≫ Limits.pullback.fst V'.hom f₁ = Limits.pullback.fst V.hom f₁ ≫ u.left →
        M1 ≫ Limits.pullback.snd V'.hom f₁ = Limits.pullback.snd V.hom f₁ →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd V'.hom f₁) f₂ =
          Limits.pullback.fst (Limits.pullback.snd V.hom f₁) f₂ ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd V'.hom f₁) f₂ =
          Limits.pullback.snd (Limits.pullback.snd V.hom f₁) f₂ →
        L ≫ (Limits.pullbackLeftPullbackSndIso V'.hom f₁ f₂).inv =
          (Limits.pullbackLeftPullbackSndIso V.hom f₁ f₂).inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst V.hom f₁ f₂)]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcEtBaseChange (f₂ ≫ f₁)).map u).left ≫ (c V').hom.left =
      (c V).hom.left ≫ ((wcEtBaseChange f₂).map ((wcEtBaseChange f₁).map u)).left
    rw [hc V, hc V']
    exact key _ _ _ (hmap (f₂ ≫ f₁) u).1 (hmap (f₂ ≫ f₁) u).2 (hmap f₁ u).1 (hmap f₁ u).2
      (hmap f₂ ((wcEtBaseChange f₁).map u)).1 (hmap f₂ ((wcEtBaseChange f₁).map u)).2
  let α : wcEtBaseChange (f₂ ≫ f₁) ≅ wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂ :=
    NatIso.ofComponents c natc

  haveI := E₁.cont
  haveI := E₂.cont
  haveI := E₁₂.cont
  haveI : (wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂).IsContinuous (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Y₂) :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology Y₁) _
  let τr := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y₂)).app (wcEtZModRing Y₂ n)
  let φfg : wcEtZModRing Y n ⟶ ((wcEtBaseChange f₁ ⋙ wcEtBaseChange f₂).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y₂)).obj
        (wcEtZModRing Y₂ n) :=
    E₁.φ ≫ ((wcEtBaseChange f₁).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Y₁)).map E₂.φ
  have hcompat : φfg ≫ τr = E₁₂.φ := s1 Y _ _ _
  let ι : SheafOfModules.pushforward E₂.φ ⋙ SheafOfModules.pushforward E₁.φ ≅
      SheafOfModules.pushforward E₁₂.φ :=
    SheafOfModules.pushforwardComp E₁.φ E₂.φ ≪≫
      SheafOfModules.pushforwardNatIso φfg α ≪≫ SheafOfModules.pushforwardCongr hcompat
  have τi : E₁₂.Φ ≅ E₁.Φ ⋙ E₂.Φ := E₁₂.adj.leftAdjointUniq ((E₁.adj.comp E₂.adj).ofNatIsoRight ι)

  have hext : ∀ e : SheafOfModules.unit (wcEtZModRing Y₂ n) ⟶
      SheafOfModules.unit (wcEtZModRing Y₂ n),
      ∃ m : 𝟭 (SheafOfModules.{u+1} (wcEtZModRing Y₂ n)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcEtZModRing Y₂ n)),
        m.app (SheafOfModules.unit (wcEtZModRing Y₂ n)) = e := by
    intro e
    have hcomm : ∀ (V : (Y₂.Etale)ᵒᵖ) (a b : (wcEtZModRing Y₂ n).obj.obj V), a * b = b * a :=
      s2 Y₂
    let R := wcEtZModRing Y₂ n
    let s := (SheafOfModules.unit R).unitHomEquiv e
    let σ : ∀ V : (Y₂.Etale)ᵒᵖ, R.obj.obj V := fun V => (s.1 V : R.obj.obj V)
    have hσ : ∀ {V W : (Y₂.Etale)ᵒᵖ} (f : V ⟶ W), (R.obj.map f).hom (σ V) = σ W :=
      fun f => PresheafOfModules.sections_property s f
    let L : ∀ (M : SheafOfModules.{u+1} R) (V : (Y₂.Etale)ᵒᵖ), M.val.obj V ⟶ M.val.obj V :=
      fun M V => ModuleCat.ofHom
        { toFun := fun x => σ V • x
          map_add' := fun x y => smul_add _ _ _
          map_smul' := fun r x => by
            simp only [RingHom.id_apply, smul_smul]
            rw [hcomm V] }
    let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
      ⟨PresheafOfModules.Hom.mk (L M) (by
        intro V W f
        ext x
        show σ W • (M.val.map f).hom x = (M.val.map f).hom (σ V • x)
        rw [PresheafOfModules.map_smul, hσ])⟩
    refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
    · intro M N g
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro V
      ext x
      show σ V • (g.val.app V).hom x = (g.val.app V).hom (σ V • x)
      exact ((g.val.app V).hom.map_smul _ _).symm
    · apply (SheafOfModules.unit R).unitHomEquiv.injective
      apply PresheafOfModules.sections_ext
      intro V
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show σ V • (1 : R.obj.obj V) = s.1 V
      rw [smul_eq_mul, mul_one]

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y₁ n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y₂ n)) := HasExt.standard _
  haveI := E₁.additive
  haveI := E₁.presLim
  haveI := E₁.presColim
  haveI := E₂.additive
  haveI := E₂.presLim
  haveI := E₂.presColim
  haveI := E₁₂.additive
  haveI := E₁₂.presLim
  haveI := E₁₂.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing Y₂ n)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing Y₂ n)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing Y₂ n)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
  show (Abelian.Ext.mk₀ γ₁₂).comp ((Abelian.Ext.mapExactFunctor E₁₂.Φ θ).comp
      (Abelian.Ext.mk₀ E₁₂.μ.hom) (add_zero k)) (zero_add k) =
    (Abelian.Ext.mk₀ γ₂).comp ((Abelian.Ext.mapExactFunctor E₂.Φ
      ((Abelian.Ext.mk₀ γ₁).comp ((Abelian.Ext.mapExactFunctor E₁.Φ θ).comp
        (Abelian.Ext.mk₀ E₁.μ.hom) (add_zero k)) (zero_add k))).comp
      (Abelian.Ext.mk₀ E₂.μ.hom) (add_zero k)) (zero_add k)

  have hR : (Abelian.Ext.mk₀ γ₂).comp ((Abelian.Ext.mapExactFunctor E₂.Φ
      ((Abelian.Ext.mk₀ γ₁).comp ((Abelian.Ext.mapExactFunctor E₁.Φ θ).comp
        (Abelian.Ext.mk₀ E₁.μ.hom) (add_zero k)) (zero_add k))).comp
      (Abelian.Ext.mk₀ E₂.μ.hom) (add_zero k)) (zero_add k) =
      (Abelian.Ext.mk₀ (γ₂ ≫ E₂.Φ.map γ₁)).comp
        ((Abelian.Ext.mapExactFunctor (E₁.Φ ⋙ E₂.Φ) θ).comp
          (Abelian.Ext.mk₀ (E₂.Φ.map E₁.μ.hom ≫ E₂.μ.hom)) (add_zero k)) (zero_add k) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]

  have nat' : (Abelian.Ext.mapExactFunctor E₁₂.Φ θ).comp
      (Abelian.Ext.mk₀ (τi.hom.app (SheafOfModules.unit (wcEtZModRing Y n)))) (add_zero k) =
      (Abelian.Ext.mk₀ (τi.hom.app (wcEtSuppObj D))).comp
        (Abelian.Ext.mapExactFunctor (E₁.Φ ⋙ E₂.Φ) θ) (zero_add k) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp θ τi.hom
  have step1 : (Abelian.Ext.mapExactFunctor E₁₂.Φ θ).comp (Abelian.Ext.mk₀ E₁₂.μ.hom)
      (add_zero k) =
      ((Abelian.Ext.mk₀ (τi.hom.app (wcEtSuppObj D))).comp
        (Abelian.Ext.mapExactFunctor (E₁.Φ ⋙ E₂.Φ) θ) (zero_add k)).comp
        (Abelian.Ext.mk₀ (τi.inv.app (SheafOfModules.unit (wcEtZModRing Y n)) ≫ E₁₂.μ.hom))
        (add_zero k) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  have hL : (Abelian.Ext.mk₀ γ₁₂).comp ((Abelian.Ext.mapExactFunctor E₁₂.Φ θ).comp
      (Abelian.Ext.mk₀ E₁₂.μ.hom) (add_zero k)) (zero_add k) =
      (Abelian.Ext.mk₀ (γ₁₂ ≫ τi.hom.app (wcEtSuppObj D))).comp
        ((Abelian.Ext.mapExactFunctor (E₁.Φ ⋙ E₂.Φ) θ).comp
          (Abelian.Ext.mk₀ (τi.inv.app (SheafOfModules.unit (wcEtZModRing Y n)) ≫ E₁₂.μ.hom))
          (add_zero k)) (zero_add k) := by
    rw [step1, h4, h2]

  have hμ1 : ∀ {Z : SheafOfModules.{u+1} (wcEtZModRing Y₂ n)}
      (h : E₂.Φ.obj (E₁.Φ.obj (SheafOfModules.unit (wcEtZModRing Y n))) ⟶ Z),
      E₂.Φ.map E₁.μ.hom ≫ E₂.Φ.map E₁.μ.inv ≫ h = h := by
    intro Z h
    rw [← Category.assoc, ← E₂.Φ.map_comp, Iso.hom_inv_id, E₂.Φ.map_id, Category.id_comp]
  obtain ⟨m, hm⟩ := hext (E₁₂.μ.inv ≫ τi.hom.app (SheafOfModules.unit (wcEtZModRing Y n)) ≫
    E₂.Φ.map E₁.μ.hom ≫ E₂.μ.hom)
  have hb : τi.inv.app (SheafOfModules.unit (wcEtZModRing Y n)) ≫ E₁₂.μ.hom =
      (E₂.Φ.map E₁.μ.hom ≫ E₂.μ.hom) ≫ (E₂.μ.inv ≫ E₂.Φ.map E₁.μ.inv ≫
        τi.inv.app (SheafOfModules.unit (wcEtZModRing Y n)) ≫ E₁₂.μ.hom) := by
    rw [Category.assoc, Iso.hom_inv_id_assoc, hμ1]
  have hec : m.app (SheafOfModules.unit (wcEtZModRing Y₂ n)) ≫ (E₂.μ.inv ≫ E₂.Φ.map E₁.μ.inv ≫
      τi.inv.app (SheafOfModules.unit (wcEtZModRing Y n)) ≫ E₁₂.μ.hom) =
        𝟙 (SheafOfModules.unit (wcEtZModRing Y₂ n)) := by
    rw [hm]
    simp only [Category.assoc]
    rw [Iso.hom_inv_id_assoc, hμ1, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
    rfl

  have hnat : wcEtSuppUnitMap D₂ ≫ m.app (wcEtSuppObj D₂) =
      m.app (SheafOfModules.unit (wcEtZModRing Y₂ n)) ≫ wcEtSuppUnitMap D₂ := by
    have := m.naturality (wcEtSuppUnitMap D₂)
    simp only [Functor.id_map] at this
    exact this
  have ha : γ₁₂ ≫ τi.hom.app (wcEtSuppObj D) = m.app (wcEtSuppObj D₂) ≫ (γ₂ ≫ E₂.Φ.map γ₁) := by
    rw [← cancel_epi (wcEtSuppUnitMap D₂), reassoc_of% h₁₂, τi.hom.naturality, Functor.comp_map,
      reassoc_of% hnat, reassoc_of% h₂, ← E₂.Φ.map_comp, h₁, E₂.Φ.map_comp, hm]
    simp only [Category.assoc]
    rw [Iso.hom_inv_id_assoc, hμ1]

  have hcen : ∀ (z : Abelian.Ext (wcEtSuppObj D₂) (SheafOfModules.unit (wcEtZModRing Y₂ n)) k),
      (Abelian.Ext.mk₀ (m.app (wcEtSuppObj D₂))).comp z (zero_add k) =
        z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcEtZModRing Y₂ n)))) (add_zero k) := by
    intro z
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm
  have gen2 : ∀ {P Q : SheafOfModules.{u+1} (wcEtZModRing Y₂ n)} (a' : wcEtSuppObj D₂ ⟶ P)
      (y : Abelian.Ext P Q k) (b' : Q ⟶ SheafOfModules.unit (wcEtZModRing Y₂ n))
      (c' : SheafOfModules.unit (wcEtZModRing Y₂ n) ⟶ SheafOfModules.unit (wcEtZModRing Y₂ n)),
      m.app (SheafOfModules.unit (wcEtZModRing Y₂ n)) ≫ c' =
        𝟙 (SheafOfModules.unit (wcEtZModRing Y₂ n)) →
      (Abelian.Ext.mk₀ (m.app (wcEtSuppObj D₂) ≫ a')).comp
        (y.comp (Abelian.Ext.mk₀ (b' ≫ c')) (add_zero k)) (zero_add k) =
      (Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero k)) (zero_add k) := by
    intro P Q a' y b' c' hmc
    rw [← h3 y b' c', ← h2 (m.app (wcEtSuppObj D₂)) a',
      ← h4 a' (y.comp (Abelian.Ext.mk₀ b') (add_zero k)) c',
      ← h4 (m.app (wcEtSuppObj D₂))
        ((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero k)) (zero_add k)) c',
      hcen, h3, hmc]
    exact Abelian.Ext.comp_mk₀_id _
  rw [hL, hR, ha, hb]
  exact gen2 _ _ _ _ hec

theorem wc_et_slice_restrict_preserves_injective : ∀ {X : Scheme.{u}} (T : X.Etale) (n : ℕ) [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (ψ : wcEtZModRing T.left n ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X n)) (I : SheafOfModules.{u+1} (wcEtZModRing X n)) [Injective I], Injective ((SheafOfModules.pushforward.{u+1} ψ).obj I) :=
by
  intro X T n hF ψ I hI
  let tX := SheafOfModules.toSheaf.{u+1} (wcEtZModRing X n)
  let tV := SheafOfModules.toSheaf.{u+1} (wcEtZModRing T.left n)
  let P := (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
  let j := (wcEtSlice T).sheafPullback AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
  let adj : j ⊣ P := (wcEtSlice T).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)
  haveI := wc_et_slice_lan_finite_limits T
  haveI hjm : j.PreservesMonomorphisms := inferInstance
  haveI htVm : tV.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape tV
  obtain ⟨αX, hiX, hsX, -⟩ := wc_et_zmod_ring_locbij X n
  obtain ⟨hFullX, hessX⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology X)
    (wcEtZModRing X n) n αX hiX hsX
  obtain ⟨αV, hiV, hsV, hnV⟩ := wc_et_zmod_ring_locbij T.left n
  obtain ⟨hFullV, -⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology T.left)
    (wcEtZModRing T.left n) n αV hiV hsV
  haveI := hFullX
  haveI := hFullV
  haveI : P.Additive := Functor.additive_of_preserves_binary_products P
  haveI : j.Additive := adj.left_adjoint_additive

  have htorsV : ∀ A : SheafOfModules.{u+1} (wcEtZModRing T.left n), n • 𝟙 (tV.obj A) = 0 := by
    intro A
    have hx : ∀ (k : ℕ) (U : (T.left.Etale)ᵒᵖ) (x : (tV.obj A).obj.obj U),
        ((((k + 1) • 𝟙 (tV.obj A)).hom.app U).hom x) = (k + 1) • x := by
      intro k U x
      induction k with
      | zero => simp
      | succ k ih =>
        rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply, ih,
          succ_nsmul (n := k + 1)]
        simp
    have hn0 : ∀ (U : (T.left.Etale)ᵒᵖ) (x : (tV.obj A).obj.obj U), n • x = 0 := by
      intro U x
      let y : A.val.obj U := x
      have h1 : ((n : ↑((wcEtZModRing T.left n).obj.obj U)) • y) = n • y :=
        Nat.cast_smul_eq_nsmul _ n y
      rw [hnV U, zero_smul] at h1
      exact h1.symm
    have hff : n • 𝟙 (tV.obj A) + 𝟙 (tV.obj A) = 𝟙 (tV.obj A) := by
      rw [← succ_nsmul]
      apply Sheaf.hom_ext
      ext U x
      rw [hx, succ_nsmul, hn0, zero_add]
      all_goals first | rfl | simp
    exact add_eq_right.mp hff
  have hess : ∀ A : SheafOfModules.{u+1} (wcEtZModRing T.left n),
      tX.essImage (j.obj (tV.obj A)) := by
    intro A
    apply hessX
    rw [← j.map_id, ← Functor.map_nsmul, htorsV, Functor.map_zero]
  let κ : tV.obj ((SheafOfModules.pushforward.{u+1} ψ).obj I) ≅ P.obj (tX.obj I) := Iso.refl _
  constructor
  intro A B g m hm
  let a := (hess A).getIso
  let b := (hess B).getIso
  let c : tX.obj (hess A).witness ⟶ tX.obj (hess B).witness := a.hom ≫ j.map (tV.map m) ≫ b.inv
  haveI : Mono c := by
    haveI : Mono (tV.map m) := tV.map_mono m
    haveI : Mono (j.map (tV.map m)) := j.map_mono _
    dsimp only [c]
    infer_instance
  let m₁ := tX.preimage c
  haveI : Mono m₁ := tX.mono_of_mono_map (by rw [Functor.map_preimage]; infer_instance)
  let gb := (adj.homEquiv (tV.obj A) (tX.obj I)).symm (tV.map g ≫ κ.hom)
  let g₁ := tX.preimage (a.hom ≫ gb)
  let k₁ := Injective.factorThru g₁ m₁
  refine ⟨tV.preimage (adj.homEquiv (tV.obj B) (tX.obj I) (b.inv ≫ tX.map k₁) ≫ κ.inv), ?_⟩
  apply tV.map_injective
  have e1 : j.map (tV.map m) ≫ b.inv = a.inv ≫ tX.map m₁ := by
    simp only [m₁, Functor.map_preimage, c, Iso.inv_hom_id_assoc]
  have e2 : j.map (tV.map m) ≫ b.inv ≫ tX.map k₁ = gb := by
    rw [← Category.assoc, e1, Category.assoc, ← tX.map_comp, Injective.comp_factorThru,
      Functor.map_preimage, Iso.inv_hom_id_assoc]
  rw [tV.map_comp, Functor.map_preimage, ← Category.assoc,
    ← Adjunction.homEquiv_naturality_left, e2]
  simp only [gb, Equiv.apply_symm_apply, κ, Iso.refl_hom, Iso.refl_inv]
  first
    | exact (Category.comp_id _).trans (Category.comp_id _)
    | (erw [Category.comp_id, Category.comp_id])
    | rfl

theorem wc_et_slice_restrict_supp_hom_injective : ∀ {X Z Z' : Scheme.{u}} {n : ℕ} (T : X.Etale) [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (ψ : wcEtZModRing T.left n ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X n)) (i : Z ⟶ X) [IsClosedImmersion i] (i' : Z' ⟶ T.left) (g : Z' ⟶ Z), IsPullback g i' i T.hom → IsIso g → ∀ (D : wcEtPullData i n) (D' : wcEtPullData i' n) (μ : (SheafOfModules.pushforward.{u+1} ψ).obj (SheafOfModules.unit (wcEtZModRing X n)) ≅ SheafOfModules.unit (wcEtZModRing T.left n)) (γ : wcEtSuppObj D' ⟶ (SheafOfModules.pushforward.{u+1} ψ).obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = μ.inv ≫ (SheafOfModules.pushforward.{u+1} ψ).map (wcEtSuppUnitMap D) → ∀ N : SheafOfModules.{u+1} (wcEtZModRing X n), Function.Injective (fun f : wcEtSuppObj D ⟶ N => γ ≫ (SheafOfModules.pushforward.{u+1} ψ).map f) :=
by

  have rhoEpi : ∀ {X' Y' : Scheme.{u}} {n : ℕ} (i' : X' ⟶ Y') [IsClosedImmersion i']
      (D' : wcEtPullData i' n), Epi (wcEtSuppUnitMap D') := by
    intro X' Y' n i' _ D'
    classical

    have hcov : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), (∀ v : V.left, ∃ (W : S.Etale)
        (f : W ⟶ V) (w : W.left), T.arrows f ∧ Etale f.left ∧ f.left w = v) →
        T ∈ Scheme.smallEtaleTopology S V := by
      intro S V T h
      change T ∈ Scheme.smallGrothendieckTopology @Etale S V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mpr h
    have hcov' : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), T ∈ Scheme.smallEtaleTopology S V →
        ∀ v : V.left, ∃ (W : S.Etale) (f : W ⟶ V) (w : W.left),
          T.arrows f ∧ Etale f.left ∧ f.left w = v := by
      intro S V T hT
      change T ∈ Scheme.smallGrothendieckTopology @Etale S V at hT
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hT
      exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mp hT

    have hsep : Presheaf.IsSeparated (Scheme.smallEtaleTopology X') (wcEtZModRing X' n).obj :=
      Sheaf.isSeparated (wcEtZModRing X' n)
    have hempty : ∀ (Q : X'.Etale), IsEmpty Q.left →
        ∀ a b : ↑((wcEtZModRing X' n).obj.obj (Opposite.op Q)), a = b := by
      intro Q hQ a b
      exact hsep Q ⊥ (hcov X' Q ⊥ (fun v => isEmptyElim v)) a b (fun _ _ h => False.elim h)

    obtain ⟨α, hαs⟩ : ∃ α : (Functor.const (X'.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtZModRing X' n).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X') α :=
      ⟨toSheafify _ _, Presheaf.isLocallySurjective_toSheafify' _ _⟩
    have hnat : ∀ {A B : X'.Etale} (r : A ⟶ B) (b : ULift.{u+1} (ZMod n)),
        ((wcEtZModRing X' n).obj.map r.op).hom (α.app (Opposite.op B) b) =
          α.app (Opposite.op A) b := by
      intro A B r b
      have h := congrArg (fun φ => φ.hom b) (α.naturality r.op)
      exact h.symm
    have hcomp : ∀ {A B C : X'.Etale} (f : A ⟶ B) (h : B ⟶ C)
        (z : ↑((wcEtZModRing X' n).obj.obj (Opposite.op C))),
        ((wcEtZModRing X' n).obj.map f.op).hom (((wcEtZModRing X' n).obj.map h.op).hom z) =
          ((wcEtZModRing X' n).obj.map (f ≫ h).op).hom z := by
      intro A B C f h z
      rw [op_comp, Functor.map_comp]
      rfl

    have hbc : ∀ {V W : Y'.Etale} (ι : W ⟶ V), ((wcEtBaseChange i').map ι).left ≫
        Limits.pullback.fst V.hom i' = Limits.pullback.fst W.hom i' ≫ ι.left := by
      intro V W ι
      exact Limits.pullback.lift_fst _ _ _

    have hres : ∀ (V : Y'.Etale) (v : V.left)
        (x : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V)))),
        ∃ (O : V.left.Opens) (_ : v ∈ O) (k : ℤ),
          ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom x =
            (k : ↑((wcEtZModRing X' n).obj.obj
              (Opposite.op ((wcEtBaseChange i').obj (wcEtOpen Y' V O))))) := by
      intro V v x
      have hj : Topology.IsClosedEmbedding (Limits.pullback.fst V.hom i') :=
        IsClosedImmersion.isClosedEmbedding _
      have hjO : ∀ (O : V.left.Opens) (y : ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).left),
          Limits.pullback.fst V.hom i' (((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left y) ∈ O := by
        intro O y
        have h : Limits.pullback.fst V.hom i' (((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left y) =
            O.ι (Limits.pullback.fst (wcEtOpen Y' V O).hom i' y) :=
          congrArg (fun φ => φ.base y) (hbc (wcEtOpenι Y' V O))
        rw [h]
        have hm := Set.mem_range_self (f := ⇑O.ι) (Limits.pullback.fst (wcEtOpen Y' V O).hom i' y)
        rw [Scheme.Opens.range_ι] at hm
        exact hm
      by_cases hv : ∃ u, Limits.pullback.fst V.hom i' u = v
      · obtain ⟨u, rfl⟩ := hv
        have hS := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X') α
          (U := Opposite.op ((wcEtBaseChange i').obj V)) x
        obtain ⟨U₁, g, u₁, ⟨a, ha⟩, hEt, hu₁⟩ := hcov' X' _ _ hS u
        have hG : IsOpen (Set.range g.left) := g.left.isOpenMap.isOpen_range
        obtain ⟨O₁, hO₁, hpre⟩ := hj.isInducing.isOpen_iff.mp hG
        let O : V.left.Opens := ⟨O₁, hO₁⟩
        have hvO : Limits.pullback.fst V.hom i' u ∈ O := by
          show Limits.pullback.fst V.hom i' u ∈ O₁
          rw [← Set.mem_preimage, hpre]
          exact ⟨u₁, hu₁⟩
        refine ⟨O, hvO, ((a.down).cast : ℤ), ?_⟩
        have hak : (((a.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) = a :=
          ULift.ext _ _ (by rw [ULift.down_intCast]; exact ZMod.intCast_zmod_cast _)
        rw [← map_intCast (α.app (Opposite.op ((wcEtBaseChange i').obj (wcEtOpen Y' V O)))).hom, hak]

        let T : Sieve ((wcEtBaseChange i').obj (wcEtOpen Y' V O)) :=
          { arrows := fun Q q => ∃ r : Q ⟶ U₁, r ≫ g = q ≫ (wcEtBaseChange i').map (wcEtOpenι Y' V O)
            downward_closed := fun {Q Q'} {q} hq h' => by
              obtain ⟨r, hr⟩ := hq
              exact ⟨h' ≫ r, by rw [Category.assoc, hr, Category.assoc]⟩ }
        have hT : T ∈ Scheme.smallEtaleTopology X' ((wcEtBaseChange i').obj (wcEtOpen Y' V O)) := by
          apply hcov
          intro y
          have hy : ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left y ∈ Set.range g.left := by
            rw [← hpre]
            exact hjO O y
          obtain ⟨u₂, hu₂⟩ := hy
          have hW : Etale ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).hom :=
            ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).prop
          let Q : X'.Etale := MorphismProperty.Over.mk ⊤
            (Limits.pullback.fst ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left ≫
              ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).hom) (by infer_instance)
          let q : Q ⟶ (wcEtBaseChange i').obj (wcEtOpen Y' V O) :=
            MorphismProperty.Over.homMk
              (Limits.pullback.fst ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left) rfl trivial
          have hc : Limits.pullback.snd ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left ≫
              U₁.hom = Q.hom := by
            change _ = Limits.pullback.fst _ _ ≫ ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).hom
            rw [← MorphismProperty.Over.w g, ← MorphismProperty.Over.w
              ((wcEtBaseChange i').map (wcEtOpenι Y' V O)), ← Category.assoc, ← Category.assoc,
              Limits.pullback.condition]
          let r : Q ⟶ U₁ := MorphismProperty.Over.homMk
            (Limits.pullback.snd ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left) hc trivial
          obtain ⟨z, hz₁, hz₂⟩ := Scheme.Pullback.exists_preimage_pullback
            (f := ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left) (g := g.left) y u₂ hu₂.symm
          refine ⟨Q, q, z, ⟨r, ?_⟩, ?_, hz₁⟩
          · apply MorphismProperty.Over.Hom.ext
            exact Limits.pullback.condition.symm
          · show Etale (Limits.pullback.fst ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left)
            infer_instance
        refine hsep _ T hT _ _ (fun Q q hq => ?_)
        obtain ⟨r, hr⟩ := hq
        rw [hcomp, ← hr, ← hcomp, ← ha, hnat, hnat]
      · refine ⟨⟨(Set.range (Limits.pullback.fst V.hom i'))ᶜ, hj.isClosed_range.isOpen_compl⟩,
          fun h => hv h, 0, ?_⟩
        apply hempty
        refine ⟨fun y => ?_⟩
        exact hjO _ y ⟨_, rfl⟩

    let ρV : ∀ W : Y'.Etale, ↑((wcEtZModRing Y' n).obj.obj (Opposite.op W)) →+
        ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj W))) :=
      fun W => ((wcEtSuppUnitMap D').val.app (Opposite.op W)).hom.toAddMonoidHom

    have huntw : ∀ V : Y'.Etale, ∃ s t : ↑((wcEtZModRing X' n).obj.obj
        (Opposite.op ((wcEtBaseChange i').obj V))), ρV V 1 = s ∧ s * t = 1 := by
      intro V
      haveI := D'.cont
      let c := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange i') _ _
        D'.cont D'.φ
      let e := D'.μ.inv ≫ (D'.adj.homEquiv _ _).symm c
      have h0 : wcEtSuppUnitMap D' = D'.adj.homEquiv _ _ D'.μ.hom :=
        (D'.adj.homEquiv_unit _ _ _).symm
      have h1 : (D'.adj.homEquiv _ _ D'.μ.hom) ≫ (@SheafOfModules.pushforward _ _ _ _ _ _
          (wcEtBaseChange i') _ _ D'.cont D'.φ).map e = c := by
        rw [← Adjunction.homEquiv_naturality_right, Iso.hom_inv_id_assoc,
          Equiv.apply_symm_apply]
      let eF : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) →
          ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) :=
        fun y => (e.val.app (Opposite.op ((wcEtBaseChange i').obj V))).hom y
      let cV : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)) →
          ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) :=
        fun y => (c.val.app (Opposite.op V)).hom y
      have h3 : cV 1 = 1 :=
        (SheafOfModules.unitToPushforwardObjUnit_val_app_apply D'.φ
          (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))).trans
          (map_one (D'.φ.hom.app (Opposite.op V)).hom)
      have h2' : eF (ρV V 1) = cV 1 := by
        have hA := congrArg (fun φ : SheafOfModules.unit (wcEtZModRing Y' n) ⟶ wcEtSuppObj D' =>
          ((φ ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i') _ _ D'.cont
            D'.φ).map e).val.app (Opposite.op V)).hom
            (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))) h0
        have hB := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom
          (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))) h1
        exact hA.trans hB
      have h2 : eF (ρV V 1) = 1 := h2'.trans h3
      have h4 : ∀ y, eF y = y * eF 1 := by
        intro y
        have h := (e.val.app (Opposite.op ((wcEtBaseChange i').obj V))).hom.map_smul y
          (1 : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))))
        exact (congrArg eF (mul_one y).symm).trans h
      exact ⟨ρV V 1, eF 1, rfl, (h4 _).symm.trans h2⟩

    have hrefl : (SheafOfModules.toSheaf (wcEtZModRing Y' n)).ReflectsEpimorphisms :=
      Functor.reflectsEpimorphisms_of_faithful _
    apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcEtZModRing Y' n))
    haveI : Sheaf.IsLocallySurjective
        ((SheafOfModules.toSheaf (wcEtZModRing Y' n)).map (wcEtSuppUnitMap D')) := by
      refine Presheaf.IsLocallySurjective.mk (fun {V} m => ?_)
      apply hcov
      intro v
      let m' : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) := m
      obtain ⟨s, t, hs, hst⟩ := huntw V
      obtain ⟨O, hvO, k, hk⟩ := hres V v (t * m')
      have hm : m' = s * (t * m') := by rw [← mul_assoc, hst, one_mul]
      refine ⟨wcEtOpen Y' V O, wcEtOpenι Y' V O, ⟨v, hvO⟩,
        ⟨(k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))), ?_⟩, ?_, rfl⟩
      · change ρV (wcEtOpen Y' V O)
            (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
          ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom m'
        have e1 : ρV (wcEtOpen Y' V O)
            (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
            (k : ↑((wcEtZModRing X' n).obj.obj
              (Opposite.op ((wcEtBaseChange i').obj (wcEtOpen Y' V O))))) *
              ρV (wcEtOpen Y' V O) 1 := by
          have hk1 : (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
              k • (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) :=
            (Int.smul_one_eq_cast k).symm
          rw [hk1, map_zsmul, zsmul_eq_mul]
        have e2 : ρV (wcEtOpen Y' V O) 1 =
            ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom
              (ρV V 1) := by
          have h := PresheafOfModules.naturality_apply (wcEtSuppUnitMap D').val
            (wcEtOpenι Y' V O).op (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))
          have h1' : ((wcEtZModRing Y' n).obj.map (wcEtOpenι Y' V O).op).hom
              (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V))) = 1 := map_one _
          exact (congrArg (ρV (wcEtOpen Y' V O)) h1'.symm).trans h
        rw [e1, e2, hs, hm, map_mul, hk]
        exact Int.cast_comm _ _
      · show Etale O.ι
        infer_instance
    exact Sheaf.epi_of_isLocallySurjective _

  have hcov : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), (∀ v : V.left, ∃ (W : S.Etale)
      (f : W ⟶ V) (w : W.left), T.arrows f ∧ Etale f.left ∧ f.left w = v) →
      T ∈ Scheme.smallEtaleTopology S V := by
    intro S V T h
    change T ∈ Scheme.smallGrothendieckTopology @Etale S V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mpr h

  have sep : ∀ (S : Scheme.{u}) (n : ℕ) (M : SheafOfModules.{u+1} (wcEtZModRing S n))
      (W : S.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology S W →
      ∀ x : ↑(M.val.obj (Opposite.op W)),
      (∀ (Q : S.Etale) (g : Q ⟶ W), R.arrows g → (M.val.map g.op).hom x = 0) → x = 0 := by
    intro S n M W R hR x h
    have hs := ((SheafOfModules.toSheaf _).obj M).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology S) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x 0
      (fun Q g hg => (h Q g hg).trans (map_zero ((M.val.map g.op).hom)).symm)
  have zeroEmpty : ∀ (S : Scheme.{u}) (n : ℕ) (M : SheafOfModules.{u+1} (wcEtZModRing S n))
      (V : S.Etale), IsEmpty V.left → ∀ x : ↑(M.val.obj (Opposite.op V)), x = 0 := by
    intro S n M V hV x
    exact sep S n M V ⊥ (hcov S V ⊥ (fun v => isEmptyElim v)) x (fun Q g hg => hg.elim)
  intro X Z Z' n T _ ψ i _ i' g hpb hg D D' μ γ hγ N f₁ f₂ hf
  have hf' : γ ≫ (SheafOfModules.pushforward.{u+1} ψ).map f₁ =
      γ ≫ (SheafOfModules.pushforward.{u+1} ψ).map f₂ := hf
  haveI : Epi (wcEtSuppUnitMap D) := rhoEpi i D

  have hRw : (SheafOfModules.pushforward.{u+1} ψ).map (wcEtSuppUnitMap D ≫ f₁) =
      (SheafOfModules.pushforward.{u+1} ψ).map (wcEtSuppUnitMap D ≫ f₂) := by
    have key : ∀ f : wcEtSuppObj D ⟶ N, (SheafOfModules.pushforward.{u+1} ψ).map
        (wcEtSuppUnitMap D ≫ f) = μ.hom ≫ wcEtSuppUnitMap D' ≫ γ ≫
          (SheafOfModules.pushforward.{u+1} ψ).map f := by
      intro f
      rw [Functor.map_comp, reassoc_of% hγ, Iso.hom_inv_id_assoc]
    rw [key, key, hf']

  have hnatw : ∀ (w : SheafOfModules.unit (wcEtZModRing X n) ⟶ N) {P Q : X.Etale} (h : Q ⟶ P),
      (N.val.map h.op).hom ((w.val.app (Opposite.op P)).hom
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op P)))) =
      (w.val.app (Opposite.op Q)).hom (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) := by
    intro w P Q h
    have hn := PresheafOfModules.naturality_apply w.val h.op
      (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op P)))
    have h1 : ((wcEtZModRing X n).obj.map h.op).hom
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op P))) = 1 := map_one _
    change (w.val.app (Opposite.op Q)).hom (((wcEtZModRing X n).obj.map h.op).hom
      (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op P)))) = _ at hn
    rw [h1] at hn
    exact hn.symm

  have hV1 : ((wcEtSuppUnitMap D ≫ f₁).val.app
        (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))).hom
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))) =
      ((wcEtSuppUnitMap D ≫ f₂).val.app
        (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))).hom
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))) := by
    have h := congrArg (fun φ => (φ.val.app (Opposite.op (wcEtTop T.left))).hom
      (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))))) hRw
    exact h

  have hzero : ∀ (Q : X.Etale), (∀ q : Q.left, Q.hom q ∉ Set.range ⇑i) →
      ∀ f : wcEtSuppObj D ⟶ N, ((wcEtSuppUnitMap D ≫ f).val.app (Opposite.op Q)).hom
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) = 0 := by
    intro Q hQ f
    have hE : IsEmpty ((wcEtBaseChange i).obj Q).left := by
      change IsEmpty ↥(Limits.pullback Q.hom i)
      refine ⟨fun p => ?_⟩
      have hc : (Limits.pullback.fst Q.hom i ≫ Q.hom) p = (Limits.pullback.snd Q.hom i ≫ i) p := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hc
      exact hQ _ ⟨_, hc.symm⟩
    have h0 : ((wcEtSuppUnitMap D).val.app (Opposite.op Q)).hom
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) = 0 :=
      zeroEmpty Z n (SheafOfModules.unit (wcEtZModRing Z n)) _ hE _
    change (f.val.app (Opposite.op Q)).hom (((wcEtSuppUnitMap D).val.app (Opposite.op Q)).hom
      (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q)))) = 0
    rw [h0, map_zero]

  have hrange : Set.range ⇑i ⊆ Set.range ⇑T.hom := by
    rintro _ ⟨z, rfl⟩
    obtain ⟨z', hz'⟩ := (Scheme.homeoOfIso (asIso g)).surjective z
    rw [Scheme.homeoOfIso_apply] at hz'
    have hw : (g ≫ i) z' = (i' ≫ T.hom) z' := by rw [hpb.w]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hw
    refine ⟨i' z', ?_⟩
    rw [← hw, ← hz']
    rfl

  let S : Sieve (wcEtTop X) :=
    { arrows := fun {Q} _ => Nonempty (Q ⟶ (wcEtSlice T).obj (wcEtTop T.left)) ∨
        ∀ q : Q.left, Q.hom q ∉ Set.range ⇑i
      downward_closed := fun {Q Q'} {k} hk h' => by
        rcases hk with hk | hk
        · obtain ⟨h⟩ := hk
          exact Or.inl ⟨h' ≫ h⟩
        · right
          intro q hq
          apply hk (h'.left q)
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w h']
          exact hq }
  have hS : S ∈ Scheme.smallEtaleTopology X (wcEtTop X) := by
    apply hcov
    intro x
    by_cases hx : x ∈ Set.range ⇑i
    · obtain ⟨v, hv⟩ := hrange hx
      refine ⟨(wcEtSlice T).obj (wcEtTop T.left),
        MorphismProperty.Over.homMk ((wcEtSlice T).obj (wcEtTop T.left)).hom
          (by exact Category.comp_id _) trivial, v, Or.inl ⟨𝟙 _⟩,
        ((wcEtSlice T).obj (wcEtTop T.left)).prop, ?_⟩
      change (𝟙 T.left ≫ T.hom) v = x
      rw [Category.id_comp]
      exact hv
    · let Uo : X.Opens := ⟨(Set.range ⇑i)ᶜ, (i.isClosedEmbedding.isClosed_range).isOpen_compl⟩
      let U : X.Etale := wcEtOpen X (wcEtTop X) Uo
      refine ⟨U, MorphismProperty.Over.homMk U.hom (by exact Category.comp_id _) trivial,
        ⟨x, hx⟩, Or.inr ?_, U.prop, ?_⟩
      · intro q hq
        have hm : Uo.ι q ∈ Set.range Uo.ι := ⟨_, rfl⟩
        rw [Scheme.Opens.range_ι] at hm
        apply hm
        change (Uo.ι ≫ 𝟙 X) q ∈ Set.range ⇑i at hq
        rwa [Category.comp_id] at hq
      · change (Uo.ι ≫ 𝟙 X) ⟨x, hx⟩ = x
        rw [Category.comp_id, Scheme.Opens.ι_apply]

  have htop : ((wcEtSuppUnitMap D ≫ f₁).val.app (Opposite.op (wcEtTop X))).hom
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op (wcEtTop X)))) =
      ((wcEtSuppUnitMap D ≫ f₂).val.app (Opposite.op (wcEtTop X))).hom
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op (wcEtTop X)))) := by
    refine sub_eq_zero.mp (sep X n N (wcEtTop X) S hS _ ?_)
    intro Q k hk
    have hQ : ((wcEtSuppUnitMap D ≫ f₁).val.app (Opposite.op Q)).hom
          (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) =
        ((wcEtSuppUnitMap D ≫ f₂).val.app (Opposite.op Q)).hom
          (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) := by
      rcases hk with hk | hk
      · obtain ⟨h⟩ := hk
        rw [← hnatw _ h, ← hnatw _ h, hV1]
      · rw [hzero Q hk, hzero Q hk]
    rw [map_sub, hnatw, hnatw]
    exact sub_eq_zero.mpr hQ

  have hw : wcEtSuppUnitMap D ≫ f₁ = wcEtSuppUnitMap D ≫ f₂ := by
    apply N.unitHomEquiv.injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    obtain ⟨V⟩ := V
    have t : V ⟶ wcEtTop X := MorphismProperty.Over.homMk V.hom (by exact Category.comp_id _) trivial
    rw [← hnatw _ t, ← hnatw _ t, htop]
  exact (cancel_epi (wcEtSuppUnitMap D)).mp hw

theorem wc_et_supp_unit_ker_kill_of_vanish : ∀ {X Z : Scheme.{u}} {n : ℕ} (i : Z ⟶ X) [IsClosedImmersion i] (D : wcEtPullData i n) (N : SheafOfModules.{u+1} (wcEtZModRing X n)) (w : SheafOfModules.unit (wcEtZModRing X n) ⟶ N), (∀ U : X.Etale, IsEmpty ((wcEtBaseChange i).obj U).left → (w.val.app (Opposite.op U)).hom (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op U))) = 0) → Limits.kernel.ι (wcEtSuppUnitMap D) ≫ w = 0 :=
by
  have wc_et_zmod_ring_locbij : ∀ (Y : Scheme.{u}) (n : ℕ),
      ∃ α : (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing Y n).obj,
        Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) α ∧
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) α ∧
        ∀ V, ((n : ℕ) : ↑((wcEtZModRing Y n).obj.obj V)) = 0 := by
    intro Y n
    let P : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      (Functor.const (Y.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
    let α : P ⟶ (wcEtZModRing Y n).obj := toSheafify (Scheme.smallEtaleTopology Y) P
    refine ⟨α, Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Y) P,
      Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Y) P, ?_⟩
    intro V
    have h0 : ((n : ℕ) : ULift.{u+1} (ZMod n)) = 0 :=
      ULift.ext _ _ (by rw [ULift.down_natCast, ZMod.natCast_self, ULift.zero_down])
    have h1 := map_natCast (α.app V).hom n
    have h2 : (α.app V).hom ((n : ℕ) : ULift.{u+1} (ZMod n)) = 0 := by
      rw [h0]; exact map_zero _
    exact h1.symm.trans h2
  have covsurj : ∀ (S : Scheme.{u}) (V : S.Etale) (R : Sieve V),
      R ∈ Scheme.smallEtaleTopology S V → ∀ x : V.left,
      ∃ (Y : S.Etale) (f : Y ⟶ V) (y : Y.left), R.arrows f ∧ f.left y = x := by
    intro S V R h x
    haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
    have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V R).mp (e ▸ h)
    obtain ⟨Y, f, y, h1, _, h3⟩ := h' x
    exact ⟨Y, f, y, h1, h3⟩
  have sep : ∀ (S : Scheme.{u}) (n : ℕ) (M : SheafOfModules.{u+1} (wcEtZModRing S n))
      (W : S.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology S W →
      ∀ x : ↑(M.val.obj (Opposite.op W)),
      (∀ (Q : S.Etale) (g : Q ⟶ W), R.arrows g → (M.val.map g.op).hom x = 0) → x = 0 := by
    intro S n M W R hR x h
    have hs := ((SheafOfModules.toSheaf _).obj M).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology S) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x 0
      (fun Q g hg => (h Q g hg).trans (map_zero ((M.val.map g.op).hom)).symm)
  have twist : ∀ {S T : Scheme.{u}} {j : T ⟶ S} {n : ℕ} (E : wcEtPullData j n),
      ∃ e : SheafOfModules.unit (wcEtZModRing T n) ⟶ SheafOfModules.unit (wcEtZModRing T n),
        wcEtSuppUnitMap E ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ).map e
          = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ := by
    intro S T j n E
    refine ⟨E.μ.inv ≫ (E.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ), ?_⟩
    dsimp only [wcEtSuppUnitMap, wcEtSuppObj]
    rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc,
      ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]
  have intcast_eq : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
      (α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj)
      (c : ULift.{u+1} (ZMod n)),
      (α.app (Opposite.op V)).hom c = (((c.down.cast : ℤ)) : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) := by
    intro S n V α c
    have hc : c = (((c.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
      apply ULift.ext
      rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
    conv_lhs => rw [hc]
    exact map_intCast (α.app (Opposite.op V)).hom _
  have intzero : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale) (k : ℤ),
      (k : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) = 0 → (k : ZMod n) = 0 ∨ IsEmpty V.left := by
    intro S n V k hk
    by_cases hV : IsEmpty V.left
    · exact Or.inr hV
    · left
      obtain ⟨x⟩ := not_isEmpty_iff.mp hV
      obtain ⟨α, hinj, hsurj, -⟩ := wc_et_zmod_ring_locbij S n
      have h1 : (α.app (Opposite.op V)).hom ((k : ULift.{u+1} (ZMod n))) =
          (α.app (Opposite.op V)).hom (0 : ULift.{u+1} (ZMod n)) := by
        rw [map_intCast, map_zero]; exact hk
      have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology S) α _ _ h1
      obtain ⟨Q, g, _, hg, _⟩ := covsurj S V _ hmem x
      have h2 : ((k : ULift.{u+1} (ZMod n))) = 0 := hg
      have h3 := congrArg ULift.down h2
      rw [ULift.down_intCast] at h3
      exact h3
  intro X Z n i _ D N w hv1

  have vk : ∀ (Q : X.Etale) (k : ℤ),
      ((wcEtSuppUnitMap D).val.app (Opposite.op Q)).hom
        (k : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) = 0 →
      (w.val.app (Opposite.op Q)).hom
        (k : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) = 0 := by
    intro Q k hk
    obtain ⟨e', he'⟩ := twist D
    have h2 := congrArg (fun h => (h.val.app (Opposite.op Q)).hom
      (k : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q)))) he'
    change (e'.val.app (Opposite.op ((wcEtBaseChange i).obj Q))).hom
      (((wcEtSuppUnitMap D).val.app (Opposite.op Q)).hom
        (k : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q)))) =
      (D.φ.hom.app (Opposite.op Q)).hom (k : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) at h2
    rw [hk] at h2
    have h3 : (D.φ.hom.app (Opposite.op Q)).hom (k : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) = 0 :=
      h2.symm.trans (LinearMap.map_zero _)
    rw [map_intCast] at h3
    rcases intzero Z n ((wcEtBaseChange i).obj Q) k h3 with hk0 | hE
    · obtain ⟨m, rfl⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd k n).mp hk0
      obtain ⟨α, -, -, hn⟩ := wc_et_zmod_ring_locbij X n
      have h0 : (((n : ℤ) * m : ℤ) : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) = 0 := by
        rw [Int.cast_mul, Int.cast_natCast, hn, zero_mul]
      exact (congrArg (w.val.app (Opposite.op Q)).hom h0).trans
        (LinearMap.map_zero _)
    · have hl := (congrArg (w.val.app (Opposite.op Q)).hom
        (mul_one (k : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q)))).symm).trans
        ((w.val.app (Opposite.op Q)).hom.map_smul
          (k : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))))
      rw [hl, hv1 Q hE, smul_zero]

  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro W
  obtain ⟨W⟩ := W
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro y
  let a : ↑((wcEtZModRing X n).obj.obj (Opposite.op W)) :=
    ((Limits.kernel.ι (wcEtSuppUnitMap D)).val.app (Opposite.op W)).hom y
  have hρa : ((wcEtSuppUnitMap D).val.app (Opposite.op W)).hom a = 0 := by
    have h := congrArg (fun h => (h.val.app (Opposite.op W)).hom y)
      (Limits.kernel.condition (wcEtSuppUnitMap D))
    exact h
  change (w.val.app (Opposite.op W)).hom a = 0
  obtain ⟨α, hinj, hsurj, -⟩ := wc_et_zmod_ring_locbij X n
  refine sep X n N W (Presheaf.imageSieve α a)
    (Presheaf.imageSieve_mem _ α a) _ ?_
  rintro Q g ⟨c, hc⟩
  have hk : ((SheafOfModules.unit (wcEtZModRing X n)).val.map g.op).hom a =
      ((c.down.cast : ℤ) : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) :=
    hc.symm.trans (intcast_eq X n Q α c)
  have hnat := PresheafOfModules.naturality_apply w.val g.op a
  have hnat' := PresheafOfModules.naturality_apply (wcEtSuppUnitMap D).val g.op a
  rw [hk] at hnat hnat'
  have h0 : ((wcEtSuppUnitMap D).val.app (Opposite.op Q)).hom
      ((c.down.cast : ℤ) : ↑((wcEtZModRing X n).obj.obj (Opposite.op Q))) = 0 := by
    refine hnat'.trans ?_
    change ((wcEtSuppObj D).val.map g.op).hom (((wcEtSuppUnitMap D).val.app (Opposite.op W)).hom a) = 0
    rw [hρa]
    exact map_zero _
  exact hnat.symm.trans (vk Q _ h0)

theorem wc_et_restrict_unit_hom_ext : ∀ {X : Scheme.{u}} (T : X.Etale) (n : ℕ) [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (ψ : wcEtZModRing T.left n ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X n)) (M : SheafOfModules.{u+1} (wcEtZModRing T.left n)) (d₁ d₂ : (SheafOfModules.pushforward.{u+1} ψ).obj (SheafOfModules.unit (wcEtZModRing X n)) ⟶ M), (d₁.val.app (Opposite.op (wcEtTop T.left))).hom (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))) = (d₂.val.app (Opposite.op (wcEtTop T.left))).hom (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))) → d₁ = d₂ :=
by
  intro X T n _ ψ M d₁ d₂ h1
  classical
  have hcov : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), (∀ v : V.left, ∃ (W : S.Etale)
      (f : W ⟶ V) (w : W.left), T.arrows f ∧ Etale f.left ∧ f.left w = v) →
      T ∈ Scheme.smallEtaleTopology S V := by
    intro S V T h
    change T ∈ Scheme.smallGrothendieckTopology @Etale S V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mpr h
  have hcov' : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), T ∈ Scheme.smallEtaleTopology S V →
      ∀ v : V.left, ∃ (W : S.Etale) (f : W ⟶ V) (w : W.left),
        T.arrows f ∧ Etale f.left ∧ f.left w = v := by
    intro S V T hT
    change T ∈ Scheme.smallGrothendieckTopology @Etale S V at hT
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hT
    exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mp hT
  have hlift : ∀ (W : T.left.Etale) (S : Sieve ((wcEtSlice T).obj W)),
      S ∈ Scheme.smallEtaleTopology X ((wcEtSlice T).obj W) →
      Sieve.functorPullback (wcEtSlice T) S ∈ Scheme.smallEtaleTopology T.left W := by
    intro W S hS
    apply hcov
    intro w
    obtain ⟨Q', f, q, hf, hEtf, hq⟩ := hcov' X _ S hS w
    haveI : Etale f.left := hEtf
    have hWe : Etale W.hom := W.prop
    haveI hsc : MorphismProperty.IsStableUnderComposition @Etale :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hcomp : Etale (f.left ≫ W.hom) :=
      MorphismProperty.comp_mem @Etale f.left W.hom hEtf hWe
    have hw : f.left ≫ (W.hom ≫ T.hom) = Q'.hom := MorphismProperty.Over.w f
    let Q'' : T.left.Etale := MorphismProperty.Over.mk ⊤ (f.left ≫ W.hom) hcomp
    let g : Q'' ⟶ W := MorphismProperty.Over.homMk f.left rfl trivial
    let ι : (wcEtSlice T).obj Q'' ⟶ Q' := MorphismProperty.Over.homMk (𝟙 Q'.left) (by
        change 𝟙 Q'.left ≫ Q'.hom = (f.left ≫ W.hom) ≫ T.hom
        rw [Category.id_comp]
        exact hw.symm.trans (Category.assoc f.left W.hom T.hom).symm) trivial
    have hfac : (wcEtSlice T).map g = ι ≫ f := by
      apply MorphismProperty.Over.Hom.ext
      change f.left = 𝟙 Q'.left ≫ f.left
      rw [Category.id_comp]
    refine ⟨Q'', g, q, ?_, hEtf, hq⟩
    change S.arrows ((wcEtSlice T).map g)
    rw [hfac]
    exact S.downward_closed hf ι
  have sep : ∀ (W : T.left.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology T.left W →
      ∀ x y : ↑(M.val.obj (Opposite.op W)),
      (∀ (Q : T.left.Etale) (g : Q ⟶ W), R.arrows g →
        (M.val.map g.op).hom x = (M.val.map g.op).hom y) → x = y := by
    intro W R hR x y h
    have hs := ((SheafOfModules.toSheaf _).obj M).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology T.left) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x y (fun Q g hg => h Q g hg)
  let tU : ∀ Q : T.left.Etale, Q ⟶ wcEtTop T.left := fun Q =>
    MorphismProperty.Over.homMk Q.hom (by exact Category.comp_id _) trivial
  have H1 : ∀ Q : T.left.Etale, (d₁.val.app (Opposite.op Q)).hom
      (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj Q)))) =
      (d₂.val.app (Opposite.op Q)).hom
      (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj Q)))) := by
    intro Q
    have key : ∀ d : (SheafOfModules.pushforward.{u+1} ψ).obj
        (SheafOfModules.unit (wcEtZModRing X n)) ⟶ M,
        (d.val.app (Opposite.op Q)).hom
          (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj Q)))) =
        (M.val.map (tU Q).op).hom ((d.val.app (Opposite.op (wcEtTop T.left))).hom
          (1 : ↑((wcEtZModRing X n).obj.obj
            (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))))) := by
      intro d
      have hn := PresheafOfModules.naturality_apply d.val (tU Q).op
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))))
      have h1' : ((wcEtZModRing X n).obj.map ((wcEtSlice T).map (tU Q)).op).hom
          (1 : ↑((wcEtZModRing X n).obj.obj
            (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))) = 1 := map_one _
      change (d.val.app (Opposite.op Q)).hom
        (((wcEtZModRing X n).obj.map ((wcEtSlice T).map (tU Q)).op).hom
          (1 : ↑((wcEtZModRing X n).obj.obj
            (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))))) = _ at hn
      rw [h1'] at hn
      exact hn
    rw [key d₁, key d₂, h1]
  obtain ⟨α, hαs⟩ : ∃ α : (Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
      (wcEtZModRing X n).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) α :=
    ⟨toSheafify _ _, Presheaf.isLocallySurjective_toSheafify' _ _⟩
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro W
  rcases W with ⟨W⟩
  ext a
  let a' : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj W))) := a
  refine sep W (Sieve.functorPullback (wcEtSlice T) (Presheaf.imageSieve α a'))
    (hlift W _ (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X) α a'))
    _ _ ?_
  intro Q g hg
  obtain ⟨c, hc⟩ := hg
  obtain ⟨m, hcm⟩ : ∃ m : ℤ, ((m : ℤ) : ULift.{u+1} (ZMod n)) = c :=
    ⟨(c.down).cast, ULift.ext _ _ (by rw [ULift.down_intCast]; exact ZMod.intCast_zmod_cast _)⟩
  have hα : (α.app (Opposite.op ((wcEtSlice T).obj Q))).hom c =
      (m : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj Q)))) := by
    rw [← hcm]
    exact map_intCast (α.app (Opposite.op ((wcEtSlice T).obj Q))).hom m
  have hres : ((wcEtZModRing X n).obj.map ((wcEtSlice T).map g).op).hom a' =
      (m : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj Q)))) :=
    hc.symm.trans hα
  have hj : ∀ d : (SheafOfModules.pushforward.{u+1} ψ).obj
      (SheafOfModules.unit (wcEtZModRing X n)) ⟶ M,
      (M.val.map g.op).hom ((d.val.app (Opposite.op W)).hom a) =
        m • (d.val.app (Opposite.op Q)).hom
          (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj Q)))) := by
    intro d
    rw [← PresheafOfModules.naturality_apply]
    change (d.val.app (Opposite.op Q)).hom
      (((wcEtZModRing X n).obj.map ((wcEtSlice T).map g).op).hom a') = _
    rw [hres]
    have e : (m : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj Q)))) =
        m • (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj Q)))) :=
      (Int.smul_one_eq_cast m).symm
    rw [e]
    exact map_zsmul (d.val.app (Opposite.op Q)).hom m _
  rw [hj d₁, hj d₂, H1]

theorem wc_et_slice_section_compat : ∀ {X Z Z' : Scheme.{u}} {n : ℕ} (T : X.Etale) (i : Z ⟶ X) [IsClosedImmersion i] (i' : Z' ⟶ T.left) (g : Z' ⟶ Z), IsPullback g i' i T.hom → IsIso g → ∀ (N : SheafOfModules.{u+1} (wcEtZModRing X n)) (t : ↑(N.val.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))), (∀ (Q : X.Etale) (a : Q ⟶ (wcEtSlice T).obj (wcEtTop T.left)), (∀ q : Q.left, Q.hom q ∉ Set.range ⇑i) → (N.val.map a.op).hom t = 0) → ∀ (Q : X.Etale) (a b : Q ⟶ (wcEtSlice T).obj (wcEtTop T.left)), (N.val.map a.op).hom t = (N.val.map b.op).hom t :=
by
  intro X Z Z' n T i _ i' g hpb hg N t hP' Q a b


  have agree : ∀ (e : Z ⟶ T.left), IsPullback (𝟙 Z) e i T.hom → ∀ (W : X.Etale)
      (lam lam' : W.left ⟶ T.left), lam ≫ T.hom = W.hom → lam' ≫ T.hom = W.hom →
      ∃ S ∈ Scheme.smallEtaleTopology X W, ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g →
        g.left ≫ lam = g.left ≫ lam' ∨ ∀ w : W'.left, W'.hom w ∉ Set.range i := by
    intro e hP W lam lam' hl hl'
    haveI : Etale W.hom := W.prop
    haveI : Etale T.hom := T.prop
    have hjs : ∀ (S : Sieve W), (∀ v : W.left, ∃ (V₁ : X.Etale)
        (c : V₁ ⟶ W), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X W := by
      intro S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale X W
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ W.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale W.hom := W.prop
        have h2 : Etale (c.left ≫ W.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left W.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hw0 : e ≫ T.hom = i := (hP.toCommSq.w).symm.trans (Category.id_comp i)
    have hP'' : IsPullback (𝟙 Z) e (e ≫ T.hom) T.hom := hw0 ▸ hP
    have capp : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (x : A), (f ≫ g) x = g (f x) :=
      fun f g x => Scheme.Hom.comp_apply f g x
    have s1 : ∀ (t : T.left) (z : Z), T.hom t = i z → t = e z := by
      intro t z h
      obtain ⟨q, hq1, hq2⟩ :=
        Scheme.Pullback.exists_preimage_pullback (f := i) (g := T.hom) z t h.symm
      have h3 : (hP.isoPullback.inv ≫ e) q = Limits.pullback.snd i T.hom q := by
        rw [hP.isoPullback_inv_snd]
      have h4 : (hP.isoPullback.inv ≫ 𝟙 Z) q = Limits.pullback.fst i T.hom q := by
        rw [hP.isoPullback_inv_fst]
      rw [capp] at h3 h4
      have h5 : hP.isoPullback.inv q = z := h4.trans hq1
      rw [← hq2, ← h3, h5]
    have s2 : ∀ (p : ↥(Limits.pullback T.hom T.hom)) (z : Z),
        Limits.pullback.fst T.hom T.hom p = e z → p = Limits.pullback.diagonal T.hom (e z) := by
      intro p z hp
      let κ : Limits.pullback e (Limits.pullback.fst T.hom T.hom) ≅ Z :=
        Limits.pullbackRightPullbackFstIso T.hom T.hom e ≪≫ hP''.isoPullback.symm
      have hb : κ.hom = Limits.pullback.fst e (Limits.pullback.fst T.hom T.hom) := by
        have h1 : hP''.isoPullback.inv = Limits.pullback.fst (e ≫ T.hom) T.hom := by
          rw [← hP''.isoPullback_inv_fst, Category.comp_id]
        show (Limits.pullbackRightPullbackFstIso T.hom T.hom e).hom ≫ hP''.isoPullback.inv = _
        rw [h1, Limits.pullbackRightPullbackFstIso_hom_fst]
      have hinj : ∀ y₁ y₂ : ↥(Limits.pullback e (Limits.pullback.fst T.hom T.hom)),
          Limits.pullback.fst e (Limits.pullback.fst T.hom T.hom) y₁ =
          Limits.pullback.fst e (Limits.pullback.fst T.hom T.hom) y₂ → y₁ = y₂ := by
        intro y₁ y₂ h
        rw [← hb] at h
        calc y₁ = κ.inv (κ.hom y₁) := (Scheme.hom_inv_apply κ y₁).symm
          _ = κ.inv (κ.hom y₂) := by rw [h]
          _ = y₂ := Scheme.hom_inv_apply κ y₂
      obtain ⟨y, hy1, hy2⟩ := Scheme.Pullback.exists_preimage_pullback (f := e)
        (g := Limits.pullback.fst T.hom T.hom) z p hp.symm
      have H : 𝟙 Z ≫ e =
          (e ≫ Limits.pullback.diagonal T.hom) ≫ Limits.pullback.fst T.hom T.hom := by
        rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id, Category.id_comp]
      obtain ⟨y', hy'1, hy'2⟩ : ∃ y' : Z ⟶ Limits.pullback e (Limits.pullback.fst T.hom T.hom),
          y' ≫ Limits.pullback.fst e (Limits.pullback.fst T.hom T.hom) = 𝟙 Z ∧
          y' ≫ Limits.pullback.snd e (Limits.pullback.fst T.hom T.hom) =
            e ≫ Limits.pullback.diagonal T.hom :=
        ⟨Limits.pullback.lift (𝟙 Z) (e ≫ Limits.pullback.diagonal T.hom) H,
          Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
      have h3 : (y' ≫ Limits.pullback.fst e (Limits.pullback.fst T.hom T.hom)) z = (𝟙 Z) z := by
        rw [hy'1]
      have h4 : (y' ≫ Limits.pullback.snd e (Limits.pullback.fst T.hom T.hom)) z =
          (e ≫ Limits.pullback.diagonal T.hom) z := by
        rw [hy'2]
      rw [capp] at h3
      rw [capp, capp] at h4
      have hyy : y = y' z := hinj _ _ (hy1.trans h3.symm)
      rw [← hy2, hyy]
      exact h4
    obtain ⟨π, hπ1, hπ2⟩ : ∃ π : W.left ⟶ Limits.pullback T.hom T.hom,
        π ≫ Limits.pullback.fst T.hom T.hom = lam ∧ π ≫ Limits.pullback.snd T.hom T.hom = lam' :=
      ⟨Limits.pullback.lift lam lam' (hl.trans hl'.symm), Limits.pullback.lift_fst _ _ _,
        Limits.pullback.lift_snd _ _ _⟩
    let E : W.left.Opens := ⟨π ⁻¹' Set.range (Limits.pullback.diagonal T.hom),
      ((Limits.pullback.diagonal T.hom).isOpenEmbedding.isOpen_range).preimage π.continuous⟩
    have hEagr : E.ι ≫ lam = E.ι ≫ lam' := by
      have hsubr : Set.range (E.ι ≫ π) ⊆ Set.range (Limits.pullback.diagonal T.hom) := by
        rintro _ ⟨u, rfl⟩
        have hu : E.ι u = u.1 := Scheme.Opens.ι_apply E u
        obtain ⟨y, hy⟩ := u.2
        exact ⟨y, hy.trans ((congrArg π hu).symm.trans (capp _ _ _).symm)⟩
      obtain ⟨m, hm⟩ : ∃ m, m ≫ Limits.pullback.diagonal T.hom = E.ι ≫ π :=
        ⟨_, IsOpenImmersion.lift_fac _ _ hsubr⟩
      have ha : E.ι ≫ lam = m := by
        rw [← hπ1, ← Category.assoc, ← hm, Category.assoc, Limits.pullback.diagonal_fst,
          Category.comp_id]
      have hb : E.ι ≫ lam' = m := by
        rw [← hπ2, ← Category.assoc, ← hm, Category.assoc, Limits.pullback.diagonal_snd,
          Category.comp_id]
      rw [ha, hb]
    let S : Sieve W :=
      { arrows := fun W' g => g.left ≫ lam = g.left ≫ lam' ∨ ∀ w : W'.left, W'.hom w ∉ Set.range i
        downward_closed := by
          intro W' W'' g hg h
          have hw : h.left ≫ W'.hom = W''.hom := MorphismProperty.Over.w h
          rcases hg with hg | hmiss
          · left
            show (h.left ≫ g.left) ≫ lam = (h.left ≫ g.left) ≫ lam'
            rw [Category.assoc, Category.assoc, hg]
          · right
            intro w hw'
            apply hmiss (h.left w)
            have he : W'.hom (h.left w) = W''.hom w := by
              rw [← hw, Scheme.Hom.comp_apply]
            rw [he]
            exact hw' }
    refine ⟨S, hjs S ?_, fun _ g hg => hg⟩
    intro w
    by_cases hw : W.hom w ∈ Set.range i
    · obtain ⟨z, hz⟩ := hw
      have h1 : lam w = e z := by
        apply s1 _ z
        have he : T.hom (lam w) = W.hom w := by rw [← hl, Scheme.Hom.comp_apply]
        rw [he]
        exact hz.symm
      have h2 : Limits.pullback.fst T.hom T.hom (π w) = e z := by
        have he : (π ≫ Limits.pullback.fst T.hom T.hom) w = lam w := by rw [hπ1]
        rw [Scheme.Hom.comp_apply] at he
        rw [he, h1]
      have hwE : w ∈ E := by
        show π w ∈ Set.range (Limits.pullback.diagonal T.hom)
        exact ⟨_, (s2 (π w) z h2).symm⟩
      refine ⟨Scheme.Etale.mk (E.ι ≫ W.hom), MorphismProperty.Over.homMk E.ι rfl trivial, ?_,
        ⟨w, hwE⟩, ?_⟩
      · left
        exact hEagr
      · exact Scheme.Opens.ι_apply E ⟨w, hwE⟩
    · have hZ : IsClosed (Set.range i) := i.isClosedEmbedding.isClosed_range
      let U₀ : W.left.Opens :=
        ⟨W.hom ⁻¹' (Set.range i)ᶜ, hZ.isOpen_compl.preimage W.hom.continuous⟩
      have hwU : w ∈ U₀ := hw
      refine ⟨Scheme.Etale.mk (U₀.ι ≫ W.hom), MorphismProperty.Over.homMk U₀.ι rfl trivial, ?_,
        ⟨w, hwU⟩, ?_⟩
      · right
        intro u h
        have hu : U₀.ι u = u.1 := Scheme.Opens.ι_apply U₀ u
        have heq : (U₀.ι ≫ W.hom) u = W.hom u.1 := (capp U₀.ι W.hom u).trans (congrArg W.hom hu)
        have h' : W.hom u.1 ∈ Set.range i := by rw [← heq]; exact h
        exact u.2 h'
      · exact Scheme.Opens.ι_apply U₀ ⟨w, hwU⟩

  haveI : IsIso g := hg
  have hP : IsPullback (𝟙 Z) (inv g ≫ i') i T.hom :=
    IsPullback.of_iso hpb (asIso g) (Iso.refl Z) (Iso.refl T.left) (Iso.refl X)
      (by simp) (by simp) (by simp) (by simp)
  have ha : a.left ≫ T.hom = Q.hom :=
    (congrArg (fun k => a.left ≫ k) (Category.id_comp T.hom)).symm.trans (MorphismProperty.Over.w a)
  have hb : b.left ≫ T.hom = Q.hom :=
    (congrArg (fun k => b.left ≫ k) (Category.id_comp T.hom)).symm.trans (MorphismProperty.Over.w b)
  obtain ⟨S, hS, hSprop⟩ := agree (inv g ≫ i') hP Q a.left b.left ha hb

  have sep : ∀ (W : X.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology X W →
      ∀ x : ↑(N.val.obj (Opposite.op W)),
      (∀ (Q' : X.Etale) (k : Q' ⟶ W), R.arrows k → (N.val.map k.op).hom x = 0) → x = 0 := by
    intro W R hR x h
    have hs := ((SheafOfModules.toSheaf _).obj N).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x 0
      (fun Q' k hk => (h Q' k hk).trans (map_zero ((N.val.map k.op).hom)).symm)
  obtain ⟨ta, hta⟩ : ∃ ta : ↑(N.val.obj (Opposite.op Q)), ta = (N.val.map a.op).hom t :=
    ⟨_, rfl⟩
  obtain ⟨tb, htb⟩ : ∃ tb : ↑(N.val.obj (Opposite.op Q)), tb = (N.val.map b.op).hom t :=
    ⟨_, rfl⟩
  have hx := sep Q S hS (ta - tb) (by
    intro W' k hk
    have e1 : (N.val.map (k ≫ a).op).hom t = (N.val.map k.op).hom ta := by
      rw [hta, op_comp, PresheafOfModules.map_comp_apply]
    have e2 : (N.val.map (k ≫ b).op).hom t = (N.val.map k.op).hom tb := by
      rw [htb, op_comp, PresheafOfModules.map_comp_apply]
    have key : (N.val.map k.op).hom ta = (N.val.map k.op).hom tb := by
      rcases hSprop k hk with h | h
      · have hkab : k ≫ a = k ≫ b := MorphismProperty.Over.Hom.ext (by exact h)
        rw [← e1, ← e2, hkab]
      · have h1 := hP' W' (k ≫ a) h
        have h2 := hP' W' (k ≫ b) h
        rw [← e1, ← e2]
        exact h1.trans h2.symm
    exact (map_sub (N.val.map k.op).hom ta tb).trans (sub_eq_zero.mpr key))
  have hfin : ta = tb := sub_eq_zero.mp hx
  rw [← hta, ← htb]
  exact hfin

theorem wc_et_slice_restrict_supp_hom_surjective : ∀ {X Z Z' : Scheme.{u}} {n : ℕ} (T : X.Etale) [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)] (ψ : wcEtZModRing T.left n ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X n)) (i : Z ⟶ X) [IsClosedImmersion i] (i' : Z' ⟶ T.left) (g : Z' ⟶ Z), IsPullback g i' i T.hom → IsIso g → ∀ (D : wcEtPullData i n) (D' : wcEtPullData i' n) (μ : (SheafOfModules.pushforward.{u+1} ψ).obj (SheafOfModules.unit (wcEtZModRing X n)) ≅ SheafOfModules.unit (wcEtZModRing T.left n)) (γ : wcEtSuppObj D' ⟶ (SheafOfModules.pushforward.{u+1} ψ).obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = μ.inv ≫ (SheafOfModules.pushforward.{u+1} ψ).map (wcEtSuppUnitMap D) → ∀ N : SheafOfModules.{u+1} (wcEtZModRing X n), Function.Surjective (fun f : wcEtSuppObj D ⟶ N => γ ≫ (SheafOfModules.pushforward.{u+1} ψ).map f) :=
by

  have rhoEpi : ∀ {X' Y' : Scheme.{u}} {n : ℕ} (i' : X' ⟶ Y') [IsClosedImmersion i']
      (D' : wcEtPullData i' n), Epi (wcEtSuppUnitMap D') := by
    intro X' Y' n i' _ D'
    classical

    have hcov : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), (∀ v : V.left, ∃ (W : S.Etale)
        (f : W ⟶ V) (w : W.left), T.arrows f ∧ Etale f.left ∧ f.left w = v) →
        T ∈ Scheme.smallEtaleTopology S V := by
      intro S V T h
      change T ∈ Scheme.smallGrothendieckTopology @Etale S V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mpr h
    have hcov' : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), T ∈ Scheme.smallEtaleTopology S V →
        ∀ v : V.left, ∃ (W : S.Etale) (f : W ⟶ V) (w : W.left),
          T.arrows f ∧ Etale f.left ∧ f.left w = v := by
      intro S V T hT
      change T ∈ Scheme.smallGrothendieckTopology @Etale S V at hT
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hT
      exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mp hT

    have hsep : Presheaf.IsSeparated (Scheme.smallEtaleTopology X') (wcEtZModRing X' n).obj :=
      Sheaf.isSeparated (wcEtZModRing X' n)
    have hempty : ∀ (Q : X'.Etale), IsEmpty Q.left →
        ∀ a b : ↑((wcEtZModRing X' n).obj.obj (Opposite.op Q)), a = b := by
      intro Q hQ a b
      exact hsep Q ⊥ (hcov X' Q ⊥ (fun v => isEmptyElim v)) a b (fun _ _ h => False.elim h)

    obtain ⟨α, hαs⟩ : ∃ α : (Functor.const (X'.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtZModRing X' n).obj, Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X') α :=
      ⟨toSheafify _ _, Presheaf.isLocallySurjective_toSheafify' _ _⟩
    have hnat : ∀ {A B : X'.Etale} (r : A ⟶ B) (b : ULift.{u+1} (ZMod n)),
        ((wcEtZModRing X' n).obj.map r.op).hom (α.app (Opposite.op B) b) =
          α.app (Opposite.op A) b := by
      intro A B r b
      have h := congrArg (fun φ => φ.hom b) (α.naturality r.op)
      exact h.symm
    have hcomp : ∀ {A B C : X'.Etale} (f : A ⟶ B) (h : B ⟶ C)
        (z : ↑((wcEtZModRing X' n).obj.obj (Opposite.op C))),
        ((wcEtZModRing X' n).obj.map f.op).hom (((wcEtZModRing X' n).obj.map h.op).hom z) =
          ((wcEtZModRing X' n).obj.map (f ≫ h).op).hom z := by
      intro A B C f h z
      rw [op_comp, Functor.map_comp]
      rfl

    have hbc : ∀ {V W : Y'.Etale} (ι : W ⟶ V), ((wcEtBaseChange i').map ι).left ≫
        Limits.pullback.fst V.hom i' = Limits.pullback.fst W.hom i' ≫ ι.left := by
      intro V W ι
      exact Limits.pullback.lift_fst _ _ _

    have hres : ∀ (V : Y'.Etale) (v : V.left)
        (x : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V)))),
        ∃ (O : V.left.Opens) (_ : v ∈ O) (k : ℤ),
          ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom x =
            (k : ↑((wcEtZModRing X' n).obj.obj
              (Opposite.op ((wcEtBaseChange i').obj (wcEtOpen Y' V O))))) := by
      intro V v x
      have hj : Topology.IsClosedEmbedding (Limits.pullback.fst V.hom i') :=
        IsClosedImmersion.isClosedEmbedding _
      have hjO : ∀ (O : V.left.Opens) (y : ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).left),
          Limits.pullback.fst V.hom i' (((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left y) ∈ O := by
        intro O y
        have h : Limits.pullback.fst V.hom i' (((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left y) =
            O.ι (Limits.pullback.fst (wcEtOpen Y' V O).hom i' y) :=
          congrArg (fun φ => φ.base y) (hbc (wcEtOpenι Y' V O))
        rw [h]
        have hm := Set.mem_range_self (f := ⇑O.ι) (Limits.pullback.fst (wcEtOpen Y' V O).hom i' y)
        rw [Scheme.Opens.range_ι] at hm
        exact hm
      by_cases hv : ∃ u, Limits.pullback.fst V.hom i' u = v
      · obtain ⟨u, rfl⟩ := hv
        have hS := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X') α
          (U := Opposite.op ((wcEtBaseChange i').obj V)) x
        obtain ⟨U₁, g, u₁, ⟨a, ha⟩, hEt, hu₁⟩ := hcov' X' _ _ hS u
        have hG : IsOpen (Set.range g.left) := g.left.isOpenMap.isOpen_range
        obtain ⟨O₁, hO₁, hpre⟩ := hj.isInducing.isOpen_iff.mp hG
        let O : V.left.Opens := ⟨O₁, hO₁⟩
        have hvO : Limits.pullback.fst V.hom i' u ∈ O := by
          show Limits.pullback.fst V.hom i' u ∈ O₁
          rw [← Set.mem_preimage, hpre]
          exact ⟨u₁, hu₁⟩
        refine ⟨O, hvO, ((a.down).cast : ℤ), ?_⟩
        have hak : (((a.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) = a :=
          ULift.ext _ _ (by rw [ULift.down_intCast]; exact ZMod.intCast_zmod_cast _)
        rw [← map_intCast (α.app (Opposite.op ((wcEtBaseChange i').obj (wcEtOpen Y' V O)))).hom, hak]

        let T : Sieve ((wcEtBaseChange i').obj (wcEtOpen Y' V O)) :=
          { arrows := fun Q q => ∃ r : Q ⟶ U₁, r ≫ g = q ≫ (wcEtBaseChange i').map (wcEtOpenι Y' V O)
            downward_closed := fun {Q Q'} {q} hq h' => by
              obtain ⟨r, hr⟩ := hq
              exact ⟨h' ≫ r, by rw [Category.assoc, hr, Category.assoc]⟩ }
        have hT : T ∈ Scheme.smallEtaleTopology X' ((wcEtBaseChange i').obj (wcEtOpen Y' V O)) := by
          apply hcov
          intro y
          have hy : ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left y ∈ Set.range g.left := by
            rw [← hpre]
            exact hjO O y
          obtain ⟨u₂, hu₂⟩ := hy
          have hW : Etale ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).hom :=
            ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).prop
          let Q : X'.Etale := MorphismProperty.Over.mk ⊤
            (Limits.pullback.fst ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left ≫
              ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).hom) (by infer_instance)
          let q : Q ⟶ (wcEtBaseChange i').obj (wcEtOpen Y' V O) :=
            MorphismProperty.Over.homMk
              (Limits.pullback.fst ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left) rfl trivial
          have hc : Limits.pullback.snd ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left ≫
              U₁.hom = Q.hom := by
            change _ = Limits.pullback.fst _ _ ≫ ((wcEtBaseChange i').obj (wcEtOpen Y' V O)).hom
            rw [← MorphismProperty.Over.w g, ← MorphismProperty.Over.w
              ((wcEtBaseChange i').map (wcEtOpenι Y' V O)), ← Category.assoc, ← Category.assoc,
              Limits.pullback.condition]
          let r : Q ⟶ U₁ := MorphismProperty.Over.homMk
            (Limits.pullback.snd ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left) hc trivial
          obtain ⟨z, hz₁, hz₂⟩ := Scheme.Pullback.exists_preimage_pullback
            (f := ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left) (g := g.left) y u₂ hu₂.symm
          refine ⟨Q, q, z, ⟨r, ?_⟩, ?_, hz₁⟩
          · apply MorphismProperty.Over.Hom.ext
            exact Limits.pullback.condition.symm
          · show Etale (Limits.pullback.fst ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).left g.left)
            infer_instance
        refine hsep _ T hT _ _ (fun Q q hq => ?_)
        obtain ⟨r, hr⟩ := hq
        rw [hcomp, ← hr, ← hcomp, ← ha, hnat, hnat]
      · refine ⟨⟨(Set.range (Limits.pullback.fst V.hom i'))ᶜ, hj.isClosed_range.isOpen_compl⟩,
          fun h => hv h, 0, ?_⟩
        apply hempty
        refine ⟨fun y => ?_⟩
        exact hjO _ y ⟨_, rfl⟩

    let ρV : ∀ W : Y'.Etale, ↑((wcEtZModRing Y' n).obj.obj (Opposite.op W)) →+
        ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj W))) :=
      fun W => ((wcEtSuppUnitMap D').val.app (Opposite.op W)).hom.toAddMonoidHom

    have huntw : ∀ V : Y'.Etale, ∃ s t : ↑((wcEtZModRing X' n).obj.obj
        (Opposite.op ((wcEtBaseChange i').obj V))), ρV V 1 = s ∧ s * t = 1 := by
      intro V
      haveI := D'.cont
      let c := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange i') _ _
        D'.cont D'.φ
      let e := D'.μ.inv ≫ (D'.adj.homEquiv _ _).symm c
      have h0 : wcEtSuppUnitMap D' = D'.adj.homEquiv _ _ D'.μ.hom :=
        (D'.adj.homEquiv_unit _ _ _).symm
      have h1 : (D'.adj.homEquiv _ _ D'.μ.hom) ≫ (@SheafOfModules.pushforward _ _ _ _ _ _
          (wcEtBaseChange i') _ _ D'.cont D'.φ).map e = c := by
        rw [← Adjunction.homEquiv_naturality_right, Iso.hom_inv_id_assoc,
          Equiv.apply_symm_apply]
      let eF : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) →
          ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) :=
        fun y => (e.val.app (Opposite.op ((wcEtBaseChange i').obj V))).hom y
      let cV : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)) →
          ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) :=
        fun y => (c.val.app (Opposite.op V)).hom y
      have h3 : cV 1 = 1 :=
        (SheafOfModules.unitToPushforwardObjUnit_val_app_apply D'.φ
          (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))).trans
          (map_one (D'.φ.hom.app (Opposite.op V)).hom)
      have h2' : eF (ρV V 1) = cV 1 := by
        have hA := congrArg (fun φ : SheafOfModules.unit (wcEtZModRing Y' n) ⟶ wcEtSuppObj D' =>
          ((φ ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i') _ _ D'.cont
            D'.φ).map e).val.app (Opposite.op V)).hom
            (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))) h0
        have hB := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom
          (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))) h1
        exact hA.trans hB
      have h2 : eF (ρV V 1) = 1 := h2'.trans h3
      have h4 : ∀ y, eF y = y * eF 1 := by
        intro y
        have h := (e.val.app (Opposite.op ((wcEtBaseChange i').obj V))).hom.map_smul y
          (1 : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))))
        exact (congrArg eF (mul_one y).symm).trans h
      exact ⟨ρV V 1, eF 1, rfl, (h4 _).symm.trans h2⟩

    have hrefl : (SheafOfModules.toSheaf (wcEtZModRing Y' n)).ReflectsEpimorphisms :=
      Functor.reflectsEpimorphisms_of_faithful _
    apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcEtZModRing Y' n))
    haveI : Sheaf.IsLocallySurjective
        ((SheafOfModules.toSheaf (wcEtZModRing Y' n)).map (wcEtSuppUnitMap D')) := by
      refine Presheaf.IsLocallySurjective.mk (fun {V} m => ?_)
      apply hcov
      intro v
      let m' : ↑((wcEtZModRing X' n).obj.obj (Opposite.op ((wcEtBaseChange i').obj V))) := m
      obtain ⟨s, t, hs, hst⟩ := huntw V
      obtain ⟨O, hvO, k, hk⟩ := hres V v (t * m')
      have hm : m' = s * (t * m') := by rw [← mul_assoc, hst, one_mul]
      refine ⟨wcEtOpen Y' V O, wcEtOpenι Y' V O, ⟨v, hvO⟩,
        ⟨(k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))), ?_⟩, ?_, rfl⟩
      · change ρV (wcEtOpen Y' V O)
            (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
          ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom m'
        have e1 : ρV (wcEtOpen Y' V O)
            (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
            (k : ↑((wcEtZModRing X' n).obj.obj
              (Opposite.op ((wcEtBaseChange i').obj (wcEtOpen Y' V O))))) *
              ρV (wcEtOpen Y' V O) 1 := by
          have hk1 : (k : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) =
              k • (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op (wcEtOpen Y' V O)))) :=
            (Int.smul_one_eq_cast k).symm
          rw [hk1, map_zsmul, zsmul_eq_mul]
        have e2 : ρV (wcEtOpen Y' V O) 1 =
            ((wcEtZModRing X' n).obj.map ((wcEtBaseChange i').map (wcEtOpenι Y' V O)).op).hom
              (ρV V 1) := by
          have h := PresheafOfModules.naturality_apply (wcEtSuppUnitMap D').val
            (wcEtOpenι Y' V O).op (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V)))
          have h1' : ((wcEtZModRing Y' n).obj.map (wcEtOpenι Y' V O).op).hom
              (1 : ↑((wcEtZModRing Y' n).obj.obj (Opposite.op V))) = 1 := map_one _
          exact (congrArg (ρV (wcEtOpen Y' V O)) h1'.symm).trans h
        rw [e1, e2, hs, hm, map_mul, hk]
        exact Int.cast_comm _ _
      · show Etale O.ι
        infer_instance
    exact Sheaf.epi_of_isLocallySurjective _

  have hcov : ∀ (S : Scheme.{u}) (V : S.Etale) (T : Sieve V), (∀ v : V.left, ∃ (W : S.Etale)
      (f : W ⟶ V) (w : W.left), T.arrows f ∧ Etale f.left ∧ f.left w = v) →
      T ∈ Scheme.smallEtaleTopology S V := by
    intro S V T h
    change T ∈ Scheme.smallGrothendieckTopology @Etale S V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V T).mpr h

  have sep : ∀ (S : Scheme.{u}) (n : ℕ) (M : SheafOfModules.{u+1} (wcEtZModRing S n))
      (W : S.Etale) (R : Sieve W), R ∈ Scheme.smallEtaleTopology S W →
      ∀ x : ↑(M.val.obj (Opposite.op W)),
      (∀ (Q : S.Etale) (g : Q ⟶ W), R.arrows g → (M.val.map g.op).hom x = 0) → x = 0 := by
    intro S n M W R hR x h
    have hs := ((SheafOfModules.toSheaf _).obj M).cond
    have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology S) _
      (forget AddCommGrpCat.{u+1})).1 hs
    exact (h2.isSeparated W R hR) x 0
      (fun Q g hg => (h Q g hg).trans (map_zero ((M.val.map g.op).hom)).symm)
  have zeroEmpty : ∀ (S : Scheme.{u}) (n : ℕ) (M : SheafOfModules.{u+1} (wcEtZModRing S n))
      (V : S.Etale), IsEmpty V.left → ∀ x : ↑(M.val.obj (Opposite.op V)), x = 0 := by
    intro S n M V hV x
    exact sep S n M V ⊥ (hcov S V ⊥ (fun v => isEmptyElim v)) x (fun Q g hg => hg.elim)
  classical
  intro X Z Z' n T _ ψ i _ i' g hpb hg D D' μ γ hγ N h
  haveI : Epi (wcEtSuppUnitMap D) := rhoEpi i D
  haveI : IsClosedImmersion i' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpb inferInstance
  haveI : Epi (wcEtSuppUnitMap D') := rhoEpi i' D'

  have hrange : Set.range ⇑i ⊆ Set.range ⇑T.hom := by
    rintro _ ⟨z, rfl⟩
    obtain ⟨z', hz'⟩ := (Scheme.homeoOfIso (asIso g)).surjective z
    rw [Scheme.homeoOfIso_apply] at hz'
    have hw : (g ≫ i) z' = (i' ≫ T.hom) z' := by rw [hpb.w]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hw
    refine ⟨i' z', ?_⟩
    rw [← hw, ← hz']
    rfl

  obtain ⟨w', hw'⟩ : ∃ w' : (SheafOfModules.pushforward.{u+1} ψ).obj
      (SheafOfModules.unit (wcEtZModRing X n)) ⟶ (SheafOfModules.pushforward.{u+1} ψ).obj N,
      w' = μ.hom ≫ wcEtSuppUnitMap D' ≫ h := ⟨_, rfl⟩
  obtain ⟨t, ht⟩ : ∃ t : ↑(N.val.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))),
      t = (w'.val.app (Opposite.op (wcEtTop T.left))).hom
        (1 : ↑((wcEtZModRing X n).obj.obj
          (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))) := ⟨_, rfl⟩

  have hP' : ∀ (Q : X.Etale) (a : Q ⟶ (wcEtSlice T).obj (wcEtTop T.left)),
      (∀ q : Q.left, Q.hom q ∉ Set.range ⇑i) → (N.val.map a.op).hom t = 0 := by
    intro Q a hQ
    have ha : a.left ≫ T.hom = Q.hom := by
      have h1 : a.left ≫ (𝟙 T.left ≫ T.hom) = Q.hom := MorphismProperty.Over.w a
      exact (congrArg (fun k => a.left ≫ k) (Category.id_comp T.hom)).symm.trans h1
    have hEt : Etale a.left :=
      MorphismProperty.of_postcomp @Etale a.left T.hom T.prop (by rw [ha]; exact Q.prop)
    let W' : T.left.Etale := MorphismProperty.Over.mk ⊤ a.left hEt
    let kₐ : W' ⟶ wcEtTop T.left :=
      MorphismProperty.Over.homMk a.left (by exact Category.comp_id _) trivial
    let ι : Q ⟶ (wcEtSlice T).obj W' := MorphismProperty.Over.homMk (𝟙 Q.left) (by
        change 𝟙 Q.left ≫ (a.left ≫ T.hom) = Q.hom
        rw [Category.id_comp, ha]) trivial
    have hfac : a = ι ≫ (wcEtSlice T).map kₐ := by
      apply MorphismProperty.Over.Hom.ext
      change a.left = 𝟙 Q.left ≫ a.left
      rw [Category.id_comp]
    have hk : (N.val.map ((wcEtSlice T).map kₐ).op).hom t =
        (w'.val.app (Opposite.op W')).hom
          (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj W')))) := by
      rw [ht]
      have hn := PresheafOfModules.naturality_apply w'.val kₐ.op
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))))
      have h1 : ((wcEtZModRing X n).obj.map ((wcEtSlice T).map kₐ).op).hom
          (1 : ↑((wcEtZModRing X n).obj.obj
            (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))) = 1 := map_one _
      change (w'.val.app (Opposite.op W')).hom
        (((wcEtZModRing X n).obj.map ((wcEtSlice T).map kₐ).op).hom
          (1 : ↑((wcEtZModRing X n).obj.obj
            (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))))) = _ at hn
      rw [h1] at hn
      exact hn.symm
    have hE : IsEmpty ((wcEtBaseChange i').obj W').left := by
      change IsEmpty ↥(Limits.pullback a.left i')
      refine ⟨fun p => ?_⟩
      have hc0 : Limits.pullback.fst a.left i' ≫ a.left = Limits.pullback.snd a.left i' ≫ i' :=
        Limits.pullback.condition
      have e1 : a.left (Limits.pullback.fst a.left i' p) = i' (Limits.pullback.snd a.left i' p) :=
        (Scheme.Hom.comp_apply _ _ _).symm.trans
          ((congrArg (fun φ : Limits.pullback a.left i' ⟶ T.left => φ p) hc0).trans
            (Scheme.Hom.comp_apply _ _ _))
      have e2 : (a.left ≫ T.hom) (Limits.pullback.fst a.left i' p) =
          Q.hom (Limits.pullback.fst a.left i' p) :=
        congrArg (fun φ : Q.left ⟶ X => φ (Limits.pullback.fst a.left i' p)) ha
      have e3 : (g ≫ i) (Limits.pullback.snd a.left i' p) =
          (i' ≫ T.hom) (Limits.pullback.snd a.left i' p) :=
        congrArg (fun φ : Z' ⟶ X => φ (Limits.pullback.snd a.left i' p)) hpb.w
      refine hQ (Limits.pullback.fst a.left i' p) ⟨g (Limits.pullback.snd a.left i' p), ?_⟩
      calc i (g (Limits.pullback.snd a.left i' p))
          = (g ≫ i) (Limits.pullback.snd a.left i' p) := (Scheme.Hom.comp_apply _ _ _).symm
        _ = (i' ≫ T.hom) (Limits.pullback.snd a.left i' p) := e3
        _ = T.hom (i' (Limits.pullback.snd a.left i' p)) := Scheme.Hom.comp_apply _ _ _
        _ = T.hom (a.left (Limits.pullback.fst a.left i' p)) :=
          congrArg (fun y => T.hom y) e1.symm
        _ = (a.left ≫ T.hom) (Limits.pullback.fst a.left i' p) := (Scheme.Hom.comp_apply _ _ _).symm
        _ = Q.hom (Limits.pullback.fst a.left i' p) := e2
    have h0 : ((wcEtSuppUnitMap D').val.app (Opposite.op W')).hom
        ((μ.hom.val.app (Opposite.op W')).hom
          (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj W'))))) = 0 :=
      zeroEmpty Z' n (SheafOfModules.unit (wcEtZModRing Z' n)) _ hE _
    have hw0 : (w'.val.app (Opposite.op W')).hom
        (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj W')))) = 0 := by
      rw [hw']
      change (h.val.app (Opposite.op W')).hom (((wcEtSuppUnitMap D').val.app (Opposite.op W')).hom
        ((μ.hom.val.app (Opposite.op W')).hom
          (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj W')))))) = 0
      rw [h0, map_zero]
    rw [hfac, op_comp, PresheafOfModules.map_comp_apply, hk, hw0]
    exact map_zero _

  have hC := wc_et_slice_section_compat T i i' g hpb hg N t hP'

  let S : Sieve (wcEtTop X) :=
    { arrows := fun {Q} _ => Nonempty (Q ⟶ (wcEtSlice T).obj (wcEtTop T.left)) ∨
        ∀ q : Q.left, Q.hom q ∉ Set.range ⇑i
      downward_closed := fun {Q Q'} {k} hk h' => by
        rcases hk with hk | hk
        · obtain ⟨h⟩ := hk
          exact Or.inl ⟨h' ≫ h⟩
        · right
          intro q hq
          apply hk (h'.left q)
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w h']
          exact hq }
  have hS : S ∈ Scheme.smallEtaleTopology X (wcEtTop X) := by
    apply hcov
    intro x
    by_cases hx : x ∈ Set.range ⇑i
    · obtain ⟨v, hv⟩ := hrange hx
      refine ⟨(wcEtSlice T).obj (wcEtTop T.left),
        MorphismProperty.Over.homMk ((wcEtSlice T).obj (wcEtTop T.left)).hom
          (by exact Category.comp_id _) trivial, v, Or.inl ⟨𝟙 _⟩,
        ((wcEtSlice T).obj (wcEtTop T.left)).prop, ?_⟩
      change (𝟙 T.left ≫ T.hom) v = x
      rw [Category.id_comp]
      exact hv
    · let Uo : X.Opens := ⟨(Set.range ⇑i)ᶜ, (i.isClosedEmbedding.isClosed_range).isOpen_compl⟩
      let U : X.Etale := wcEtOpen X (wcEtTop X) Uo
      refine ⟨U, MorphismProperty.Over.homMk U.hom (by exact Category.comp_id _) trivial,
        ⟨x, hx⟩, Or.inr ?_, U.prop, ?_⟩
      · intro q hq
        have hm : Uo.ι q ∈ Set.range Uo.ι := ⟨_, rfl⟩
        rw [Scheme.Opens.range_ι] at hm
        apply hm
        change (Uo.ι ≫ 𝟙 X) q ∈ Set.range ⇑i at hq
        rwa [Category.comp_id] at hq
      · change (Uo.ι ≫ 𝟙 X) ⟨x, hx⟩ = x
        rw [Category.comp_id, Scheme.Opens.ι_apply]
  let xf : ∀ Q : X.Etale, ↑(N.val.obj (Opposite.op Q)) := fun Q =>
    if hQ : Nonempty (Q ⟶ (wcEtSlice T).obj (wcEtTop T.left)) then
      (N.val.map hQ.some.op).hom t else 0
  have hxa : ∀ (Q : X.Etale) (a : Q ⟶ (wcEtSlice T).obj (wcEtTop T.left)),
      xf Q = (N.val.map a.op).hom t := by
    intro Q a
    have hne : Nonempty (Q ⟶ (wcEtSlice T).obj (wcEtTop T.left)) := ⟨a⟩
    simp only [xf]
    exact (dif_pos hne).trans (hC Q _ a)
  have hx0 : ∀ Q : X.Etale, (∀ q : Q.left, Q.hom q ∉ Set.range ⇑i) → xf Q = 0 := by
    intro Q hQ
    by_cases hne : Nonempty (Q ⟶ (wcEtSlice T).obj (wcEtTop T.left))
    · rw [hxa Q hne.some]
      exact hP' Q _ hQ
    · simp only [xf]
      exact dif_neg hne
  have hres : ∀ {Q Q' : X.Etale} (l : Q' ⟶ Q),
      (Nonempty (Q ⟶ (wcEtSlice T).obj (wcEtTop T.left)) ∨
        ∀ q : Q.left, Q.hom q ∉ Set.range ⇑i) →
      (N.val.map l.op).hom (xf Q) = xf Q' := by
    intro Q Q' l hQ
    rcases hQ with hQ | hQ
    · obtain ⟨a⟩ := hQ
      rw [hxa Q a, hxa Q' (l ≫ a), op_comp, PresheafOfModules.map_comp_apply]
    · have hQ' : ∀ q : Q'.left, Q'.hom q ∉ Set.range ⇑i := by
        intro q hq
        apply hQ (l.left q)
        rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w l]
        exact hq
      rw [hx0 Q hQ, hx0 Q' hQ']
      exact map_zero _

  have hsh := ((SheafOfModules.toSheaf _).obj N).cond
  have h2 := (Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) _
    (forget AddCommGrpCat.{u+1})).1 hsh
  have h3 := ((isSheaf_iff_isSheaf_of_type _ _).1 h2) S hS
  let x : Presieve.FamilyOfElements
      (((SheafOfModules.toSheaf _).obj N).val ⋙ forget AddCommGrpCat.{u+1}) S.arrows :=
    fun Q _ _ => xf Q
  have hx : x.Compatible := by
    rw [Presieve.compatible_iff_sieveCompatible]
    intro Q Q' k l hk
    exact (hres l hk).symm
  obtain ⟨s, hs⟩ : ∃ s : ↑(N.val.obj (Opposite.op (wcEtTop X))),
      ∀ (Q : X.Etale) (k : Q ⟶ wcEtTop X), S.arrows k → (N.val.map k.op).hom s = xf Q :=
    ⟨h3.amalgamate x hx, fun Q k hk => h3.valid_glue hx k hk⟩

  let tU : ∀ Q : X.Etale, Q ⟶ wcEtTop X := fun Q =>
    MorphismProperty.Over.homMk Q.hom (by exact Category.comp_id _) trivial
  have htU : ∀ {Q Q' : X.Etale} (l : Q' ⟶ Q), l ≫ tU Q = tU Q' := by
    intro Q Q' l
    apply MorphismProperty.Over.Hom.ext
    exact MorphismProperty.Over.w l
  let σ : N.sections := ⟨fun U => (N.val.map (tU U.unop).op).hom s, by
    intro U U' f
    change (N.val.map f).hom ((N.val.map (tU U.unop).op).hom s) = (N.val.map (tU U'.unop).op).hom s
    have hU' : (tU U.unop).op ≫ f = (tU U'.unop).op := by
      rw [← htU f.unop, op_comp, Quiver.Hom.op_unop]
    rw [← PresheafOfModules.map_comp_apply, hU']⟩
  obtain ⟨w, hw⟩ : ∃ w : SheafOfModules.unit (wcEtZModRing X n) ⟶ N, N.unitHomEquiv w = σ :=
    ⟨N.unitHomEquiv.symm σ, Equiv.apply_symm_apply _ _⟩
  have hwv : ∀ U : X.Etale, (w.val.app (Opposite.op U)).hom
      (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op U))) = (N.val.map (tU U).op).hom s := by
    intro U
    have e := SheafOfModules.unitHomEquiv_apply_coe N w (Opposite.op U)
    rw [hw] at e
    exact e.symm
  have hid : (N.val.map (𝟙 (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))).hom t = t := by
    first
      | (simp; done)
      | (simp; exact rfl)
      | (rw [← PresheafOfModules.presheaf_map_apply_coe, CategoryTheory.Functor.map_id]; rfl)
  have hV1 : (N.val.map (tU ((wcEtSlice T).obj (wcEtTop T.left))).op).hom s = t := by
    rw [hs ((wcEtSlice T).obj (wcEtTop T.left)) (tU ((wcEtSlice T).obj (wcEtTop T.left)))
      (Or.inl ⟨𝟙 _⟩), hxa _ (𝟙 _), op_id]
    exact hid

  have hker : Limits.kernel.ι (wcEtSuppUnitMap D) ≫ w = 0 := by
    apply wc_et_supp_unit_ker_kill_of_vanish i D N w
    intro U hU
    have hav : ∀ q : U.left, U.hom q ∉ Set.range ⇑i := by
      rintro q ⟨z, hz⟩
      obtain ⟨p, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := U.hom) (g := i) q z hz.symm
      exact hU.false p
    rw [hwv U, hs U (tU U) (Or.inr hav), hx0 U hav]
  let f := Abelian.epiDesc (wcEtSuppUnitMap D) w hker
  have hf : wcEtSuppUnitMap D ≫ f = w := Abelian.comp_epiDesc _ _ _

  have hRw : (SheafOfModules.pushforward.{u+1} ψ).map w = w' := by
    apply wc_et_restrict_unit_hom_ext T n ψ
    refine Eq.trans ?_ ht
    change (w.val.app (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left)))).hom
      (1 : ↑((wcEtZModRing X n).obj.obj (Opposite.op ((wcEtSlice T).obj (wcEtTop T.left))))) = t
    rw [hwv, hV1]

  refine ⟨f, ?_⟩
  show γ ≫ (SheafOfModules.pushforward.{u+1} ψ).map f = h
  have key : μ.hom ≫ wcEtSuppUnitMap D' ≫ γ ≫ (SheafOfModules.pushforward.{u+1} ψ).map f =
      μ.hom ≫ wcEtSuppUnitMap D' ≫ h := by
    rw [reassoc_of% hγ, Iso.hom_inv_id_assoc, ← Functor.map_comp, hf, hRw, hw']
  exact (cancel_epi (wcEtSuppUnitMap D')).mp ((cancel_epi μ.hom).mp key)

theorem wc_et_supp_restr_etale_excision_injective : ∀ {X V Z Z' : Scheme.{u}} {n : ℕ} (φ : V ⟶ X) [Etale φ] (i : Z ⟶ X) [IsClosedImmersion i] (i' : Z' ⟶ V) (g : Z' ⟶ Z), IsPullback g i' i φ → IsIso g → ∀ (D : wcEtPullData i n) (E : wcEtPullData φ n) (D' : wcEtPullData i' n) (γ : wcEtSuppObj D' ⟶ E.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D) → ∀ q : ℕ, Function.Injective (wcEtSuppRestr D E D' γ q) :=
by
  classical
  intro X V Z Z' n φ hφ i hi i' g hpb hg D E D' γ hγ q

  suffices main : ∀ (T : X.Etale) {Z₁ : Scheme.{u}} (i₁ : Z₁ ⟶ T.left) (g₁ : Z₁ ⟶ Z),
      IsPullback g₁ i₁ i T.hom → IsIso g₁ →
      ∀ (E₁ : wcEtPullData (S := X) (S' := T.left) T.hom n) (D₁ : wcEtPullData i₁ n)
        (γ₁ : wcEtSuppObj D₁ ⟶ E₁.Φ.obj (wcEtSuppObj D)),
      wcEtSuppUnitMap D₁ ≫ γ₁ = E₁.μ.inv ≫ E₁.Φ.map (wcEtSuppUnitMap D) →
      Function.Injective (wcEtSuppRestr D E₁ D₁ γ₁ q) from
    main (MorphismProperty.Over.mk ⊤ φ hφ) i' g hpb hg E D' γ hγ
  intro T Z₁ i₁ g₁ hpb₁ hg₁ E₁ D₁ γ₁ hγ₁
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T.left n)) := HasExt.standard _
  haveI := E₁.additive
  haveI := E₁.presLim
  haveI := E₁.presColim
  haveI hEI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X n)) :=
    sheafOfModules_enoughInjectives _ _
  haveI hcont := (wc_et_slice_continuous T).1

  obtain ⟨ψ, ⟨e⟩⟩ := wc_et_etale_pull_restrict_iso T n E₁

  let R := SheafOfModules.pushforward.{u+1} ψ
  let γ' : wcEtSuppObj D₁ ⟶ R.obj (wcEtSuppObj D) := γ₁ ≫ e.hom.app (wcEtSuppObj D)
  let μ' : R.obj (SheafOfModules.unit (wcEtZModRing X n)) ≅
      SheafOfModules.unit (wcEtZModRing T.left n) :=
    (e.app (SheafOfModules.unit (wcEtZModRing X n))).symm ≪≫ E₁.μ
  have hnat : ∀ {A B : SheafOfModules.{u+1} (wcEtZModRing X n)} (f : A ⟶ B),
      E₁.Φ.map f ≫ e.hom.app B = e.hom.app A ≫ R.map f := fun f => e.hom.naturality f
  have hnat' : ∀ {A B : SheafOfModules.{u+1} (wcEtZModRing X n)} (f : A ⟶ B),
      R.map f ≫ e.inv.app B = e.inv.app A ≫ E₁.Φ.map f := fun f => e.inv.naturality f
  have hγ' : wcEtSuppUnitMap D₁ ≫ γ' = μ'.inv ≫ R.map (wcEtSuppUnitMap D) := by
    calc wcEtSuppUnitMap D₁ ≫ γ' = (wcEtSuppUnitMap D₁ ≫ γ₁) ≫ e.hom.app (wcEtSuppObj D) :=
          (Category.assoc _ _ _).symm
      _ = (E₁.μ.inv ≫ E₁.Φ.map (wcEtSuppUnitMap D)) ≫ e.hom.app (wcEtSuppObj D) := by rw [hγ₁]
      _ = E₁.μ.inv ≫ (E₁.Φ.map (wcEtSuppUnitMap D) ≫ e.hom.app (wcEtSuppObj D)) :=
          Category.assoc _ _ _
      _ = E₁.μ.inv ≫ (e.hom.app _ ≫ R.map (wcEtSuppUnitMap D)) := by rw [hnat]
      _ = μ'.inv ≫ R.map (wcEtSuppUnitMap D) := (Category.assoc _ _ _).symm

  have hhom : ∀ N : SheafOfModules.{u+1} (wcEtZModRing X n),
      Function.Bijective (fun f : wcEtSuppObj D ⟶ N => γ₁ ≫ E₁.Φ.map f) := by
    intro N
    have hinj := wc_et_slice_restrict_supp_hom_injective T ψ i i₁ g₁ hpb₁ hg₁ D D₁ μ' γ' hγ' N
    have hsurj := wc_et_slice_restrict_supp_hom_surjective T ψ i i₁ g₁ hpb₁ hg₁ D D₁ μ' γ' hγ' N
    have hhi : ∀ (A : SheafOfModules.{u+1} (wcEtZModRing X n)),
        e.hom.app A ≫ e.inv.app A = 𝟙 _ := fun A => e.hom_inv_id_app A
    have hih : ∀ (A : SheafOfModules.{u+1} (wcEtZModRing X n)),
        e.inv.app A ≫ e.hom.app A = 𝟙 _ := fun A => e.inv_hom_id_app A
    have hfac : ∀ f : wcEtSuppObj D ⟶ N,
        γ₁ ≫ E₁.Φ.map f = (γ' ≫ R.map f) ≫ e.inv.app N := by
      intro f
      calc γ₁ ≫ E₁.Φ.map f = γ₁ ≫ (𝟙 _ ≫ E₁.Φ.map f) := by rw [Category.id_comp]
        _ = γ₁ ≫ ((e.hom.app (wcEtSuppObj D) ≫ e.inv.app (wcEtSuppObj D)) ≫ E₁.Φ.map f) := by
            rw [hhi]
        _ = γ₁ ≫ (e.hom.app (wcEtSuppObj D) ≫ (e.inv.app (wcEtSuppObj D) ≫ E₁.Φ.map f)) := by
            rw [Category.assoc]
        _ = γ₁ ≫ (e.hom.app (wcEtSuppObj D) ≫ (R.map f ≫ e.inv.app N)) := by rw [hnat']
        _ = (γ' ≫ R.map f) ≫ e.inv.app N := by
            simp only [γ', Category.assoc]
    have hcanc : ∀ a b : wcEtSuppObj D₁ ⟶ R.obj N, a ≫ e.inv.app N = b ≫ e.inv.app N → a = b := by
      intro a b hab
      calc a = a ≫ 𝟙 _ := (Category.comp_id a).symm
        _ = a ≫ (e.inv.app N ≫ e.hom.app N) := by rw [hih]
        _ = (a ≫ e.inv.app N) ≫ e.hom.app N := (Category.assoc _ _ _).symm
        _ = (b ≫ e.inv.app N) ≫ e.hom.app N := by rw [hab]
        _ = b ≫ (e.inv.app N ≫ e.hom.app N) := Category.assoc _ _ _
        _ = b ≫ 𝟙 _ := by rw [hih]
        _ = b := Category.comp_id b
    refine ⟨fun f₁ f₂ h => hinj (hcanc _ _ ?_), fun h => ?_⟩
    · have h' : γ₁ ≫ E₁.Φ.map f₁ = γ₁ ≫ E₁.Φ.map f₂ := h
      rw [hfac, hfac] at h'
      exact h'
    · obtain ⟨f, hf⟩ := hsurj (h ≫ e.hom.app N)
      refine ⟨f, ?_⟩
      have hf' : γ' ≫ R.map f = h ≫ e.hom.app N := hf
      show γ₁ ≫ E₁.Φ.map f = h
      calc γ₁ ≫ E₁.Φ.map f = (γ' ≫ R.map f) ≫ e.inv.app N := hfac f
        _ = (h ≫ e.hom.app N) ≫ e.inv.app N := by rw [hf']
        _ = h ≫ (e.hom.app N ≫ e.inv.app N) := Category.assoc _ _ _
        _ = h ≫ 𝟙 _ := by rw [hhi]
        _ = h := Category.comp_id h

  have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing X n)) [Injective I] (k : ℕ)
      (x : Abelian.Ext (wcEtSuppObj D₁) (E₁.Φ.obj I) (k + 1)), x = 0 := by
    intro I _ k x
    have hRI : Injective (R.obj I) := wc_et_slice_restrict_preserves_injective T n ψ I
    haveI : Injective (E₁.Φ.obj I) := Injective.of_iso (e.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective x

  have hΨ := ext_transfer_of_corep E₁.Φ (wcEtSuppObj D) (wcEtSuppObj D₁) γ₁ hhom hvan
    (SheafOfModules.unit (wcEtZModRing X n)) q
  have key : ∀ θ : wcEtSuppExt D q, wcEtSuppRestr D E₁ D₁ γ₁ q θ =
      ((Abelian.Ext.mk₀ γ₁).comp (Abelian.Ext.mapExactFunctor E₁.Φ θ) (zero_add q)).comp
        (Abelian.Ext.mk₀ E₁.μ.hom) (add_zero q) := by
    intro θ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero]
    rfl
  intro θ₁ θ₂ h
  apply hΨ.1
  have h2 := congrArg (fun x => x.comp (Abelian.Ext.mk₀ E₁.μ.inv) (add_zero q))
    ((key θ₁).symm.trans (h.trans (key θ₂)))
  simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
    Abelian.Ext.comp_mk₀_id] at h2
  exact h2

theorem wc_et_supp_restr_etale_excision_surjective : ∀ {X V Z Z' : Scheme.{u}} {n : ℕ} (φ : V ⟶ X) [Etale φ] (i : Z ⟶ X) [IsClosedImmersion i] (i' : Z' ⟶ V) (g : Z' ⟶ Z), IsPullback g i' i φ → IsIso g → ∀ (D : wcEtPullData i n) (E : wcEtPullData φ n) (D' : wcEtPullData i' n) (γ : wcEtSuppObj D' ⟶ E.Φ.obj (wcEtSuppObj D)), wcEtSuppUnitMap D' ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap D) → ∀ q : ℕ, Function.Surjective (wcEtSuppRestr D E D' γ q) :=
by
  classical
  intro X V Z Z' n φ hφ i hi i' g hpb hg D E D' γ hγ q

  suffices main : ∀ (T : X.Etale) {Z₁ : Scheme.{u}} (i₁ : Z₁ ⟶ T.left) (g₁ : Z₁ ⟶ Z),
      IsPullback g₁ i₁ i T.hom → IsIso g₁ →
      ∀ (E₁ : wcEtPullData (S := X) (S' := T.left) T.hom n) (D₁ : wcEtPullData i₁ n)
        (γ₁ : wcEtSuppObj D₁ ⟶ E₁.Φ.obj (wcEtSuppObj D)),
      wcEtSuppUnitMap D₁ ≫ γ₁ = E₁.μ.inv ≫ E₁.Φ.map (wcEtSuppUnitMap D) →
      Function.Surjective (wcEtSuppRestr D E₁ D₁ γ₁ q) from
    main (MorphismProperty.Over.mk ⊤ φ hφ) i' g hpb hg E D' γ hγ
  intro T Z₁ i₁ g₁ hpb₁ hg₁ E₁ D₁ γ₁ hγ₁
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T.left n)) := HasExt.standard _
  haveI := E₁.additive
  haveI := E₁.presLim
  haveI := E₁.presColim
  haveI hEI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X n)) :=
    sheafOfModules_enoughInjectives _ _
  haveI hcont := (wc_et_slice_continuous T).1

  obtain ⟨ψ, ⟨e⟩⟩ := wc_et_etale_pull_restrict_iso T n E₁

  let R := SheafOfModules.pushforward.{u+1} ψ
  let γ' : wcEtSuppObj D₁ ⟶ R.obj (wcEtSuppObj D) := γ₁ ≫ e.hom.app (wcEtSuppObj D)
  let μ' : R.obj (SheafOfModules.unit (wcEtZModRing X n)) ≅
      SheafOfModules.unit (wcEtZModRing T.left n) :=
    (e.app (SheafOfModules.unit (wcEtZModRing X n))).symm ≪≫ E₁.μ
  have hnat : ∀ {A B : SheafOfModules.{u+1} (wcEtZModRing X n)} (f : A ⟶ B),
      E₁.Φ.map f ≫ e.hom.app B = e.hom.app A ≫ R.map f := fun f => e.hom.naturality f
  have hnat' : ∀ {A B : SheafOfModules.{u+1} (wcEtZModRing X n)} (f : A ⟶ B),
      R.map f ≫ e.inv.app B = e.inv.app A ≫ E₁.Φ.map f := fun f => e.inv.naturality f
  have hγ' : wcEtSuppUnitMap D₁ ≫ γ' = μ'.inv ≫ R.map (wcEtSuppUnitMap D) := by
    calc wcEtSuppUnitMap D₁ ≫ γ' = (wcEtSuppUnitMap D₁ ≫ γ₁) ≫ e.hom.app (wcEtSuppObj D) :=
          (Category.assoc _ _ _).symm
      _ = (E₁.μ.inv ≫ E₁.Φ.map (wcEtSuppUnitMap D)) ≫ e.hom.app (wcEtSuppObj D) := by rw [hγ₁]
      _ = E₁.μ.inv ≫ (E₁.Φ.map (wcEtSuppUnitMap D) ≫ e.hom.app (wcEtSuppObj D)) :=
          Category.assoc _ _ _
      _ = E₁.μ.inv ≫ (e.hom.app _ ≫ R.map (wcEtSuppUnitMap D)) := by rw [hnat]
      _ = μ'.inv ≫ R.map (wcEtSuppUnitMap D) := (Category.assoc _ _ _).symm

  have hhom : ∀ N : SheafOfModules.{u+1} (wcEtZModRing X n),
      Function.Bijective (fun f : wcEtSuppObj D ⟶ N => γ₁ ≫ E₁.Φ.map f) := by
    intro N
    have hinj := wc_et_slice_restrict_supp_hom_injective T ψ i i₁ g₁ hpb₁ hg₁ D D₁ μ' γ' hγ' N
    have hsurj := wc_et_slice_restrict_supp_hom_surjective T ψ i i₁ g₁ hpb₁ hg₁ D D₁ μ' γ' hγ' N
    have hhi : ∀ (A : SheafOfModules.{u+1} (wcEtZModRing X n)),
        e.hom.app A ≫ e.inv.app A = 𝟙 _ := fun A => e.hom_inv_id_app A
    have hih : ∀ (A : SheafOfModules.{u+1} (wcEtZModRing X n)),
        e.inv.app A ≫ e.hom.app A = 𝟙 _ := fun A => e.inv_hom_id_app A
    have hfac : ∀ f : wcEtSuppObj D ⟶ N,
        γ₁ ≫ E₁.Φ.map f = (γ' ≫ R.map f) ≫ e.inv.app N := by
      intro f
      calc γ₁ ≫ E₁.Φ.map f = γ₁ ≫ (𝟙 _ ≫ E₁.Φ.map f) := by rw [Category.id_comp]
        _ = γ₁ ≫ ((e.hom.app (wcEtSuppObj D) ≫ e.inv.app (wcEtSuppObj D)) ≫ E₁.Φ.map f) := by
            rw [hhi]
        _ = γ₁ ≫ (e.hom.app (wcEtSuppObj D) ≫ (e.inv.app (wcEtSuppObj D) ≫ E₁.Φ.map f)) := by
            rw [Category.assoc]
        _ = γ₁ ≫ (e.hom.app (wcEtSuppObj D) ≫ (R.map f ≫ e.inv.app N)) := by rw [hnat']
        _ = (γ' ≫ R.map f) ≫ e.inv.app N := by
            simp only [γ', Category.assoc]
    have hcanc : ∀ a b : wcEtSuppObj D₁ ⟶ R.obj N, a ≫ e.inv.app N = b ≫ e.inv.app N → a = b := by
      intro a b hab
      calc a = a ≫ 𝟙 _ := (Category.comp_id a).symm
        _ = a ≫ (e.inv.app N ≫ e.hom.app N) := by rw [hih]
        _ = (a ≫ e.inv.app N) ≫ e.hom.app N := (Category.assoc _ _ _).symm
        _ = (b ≫ e.inv.app N) ≫ e.hom.app N := by rw [hab]
        _ = b ≫ (e.inv.app N ≫ e.hom.app N) := Category.assoc _ _ _
        _ = b ≫ 𝟙 _ := by rw [hih]
        _ = b := Category.comp_id b
    refine ⟨fun f₁ f₂ h => hinj (hcanc _ _ ?_), fun h => ?_⟩
    · have h' : γ₁ ≫ E₁.Φ.map f₁ = γ₁ ≫ E₁.Φ.map f₂ := h
      rw [hfac, hfac] at h'
      exact h'
    · obtain ⟨f, hf⟩ := hsurj (h ≫ e.hom.app N)
      refine ⟨f, ?_⟩
      have hf' : γ' ≫ R.map f = h ≫ e.hom.app N := hf
      show γ₁ ≫ E₁.Φ.map f = h
      calc γ₁ ≫ E₁.Φ.map f = (γ' ≫ R.map f) ≫ e.inv.app N := hfac f
        _ = (h ≫ e.hom.app N) ≫ e.inv.app N := by rw [hf']
        _ = h ≫ (e.hom.app N ≫ e.inv.app N) := Category.assoc _ _ _
        _ = h ≫ 𝟙 _ := by rw [hhi]
        _ = h := Category.comp_id h

  have hvan : ∀ (I : SheafOfModules.{u+1} (wcEtZModRing X n)) [Injective I] (k : ℕ)
      (x : Abelian.Ext (wcEtSuppObj D₁) (E₁.Φ.obj I) (k + 1)), x = 0 := by
    intro I _ k x
    have hRI : Injective (R.obj I) := wc_et_slice_restrict_preserves_injective T n ψ I
    haveI : Injective (E₁.Φ.obj I) := Injective.of_iso (e.app I).symm hRI
    exact Abelian.Ext.eq_zero_of_injective x

  have hΨ := ext_transfer_of_corep E₁.Φ (wcEtSuppObj D) (wcEtSuppObj D₁) γ₁ hhom hvan
    (SheafOfModules.unit (wcEtZModRing X n)) q
  have key : ∀ θ : wcEtSuppExt D q, wcEtSuppRestr D E₁ D₁ γ₁ q θ =
      ((Abelian.Ext.mk₀ γ₁).comp (Abelian.Ext.mapExactFunctor E₁.Φ θ) (zero_add q)).comp
        (Abelian.Ext.mk₀ E₁.μ.hom) (add_zero q) := by
    intro θ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero]
    rfl

  intro w
  obtain ⟨θ, hθ⟩ := hΨ.2 (w.comp (Abelian.Ext.mk₀ E₁.μ.inv) (add_zero q))
  refine ⟨θ, ?_⟩
  have hθ' : (Abelian.Ext.mk₀ γ₁).comp (Abelian.Ext.mapExactFunctor E₁.Φ θ) (zero_add q) =
      w.comp (Abelian.Ext.mk₀ E₁.μ.inv) (add_zero q) := hθ
  rw [key, hθ', Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
    Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

theorem wc_et_supp_class_pull_iso_near_point : ∀ (K : Type u) [Field K] (Y Y' : Scheme.{u}) (π : Y' ⟶ Y) (y₀ : Spec (.of K) ⟶ Y) (y₀' : Spec (.of K) ⟶ Y'), y₀' ≫ π = y₀ → IsClosedImmersion y₀ → ∀ (A : Y.Opens), y₀ (IsLocalRing.closedPoint K) ∈ A → IsIso (π ∣_ A) → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Dπ : wcEtPullData π ℓ) (Dy : wcEtPullData y₀ ℓ) (Dy' : wcEtPullData y₀' ℓ) (k : ℕ) (u' : wcEtSuppExt Dy' k), ∃ u : wcEtSuppExt Dy k, wcEtPull Dπ k (wcEtSuppClass Dy k u) = wcEtSuppClass Dy' k u' :=
by
  classical
  intro K _ Y Y' π y₀ y₀' hy hcl A hA hiso ℓ _ Dπ Dy Dy' k u'
  haveI := hcl
  haveI := hiso

  have hsub : ∀ x : Spec (.of K), x = IsLocalRing.closedPoint K := fun x => Subsingleton.elim _ _
  have hrA : Set.range y₀ ⊆ Set.range A.ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι, hsub x]
    exact hA
  have hrA' : Set.range y₀' ⊆ Set.range (π ⁻¹ᵁ A).ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι, SetLike.mem_coe, Scheme.Hom.mem_preimage]
    have h1 : (y₀' ≫ π) x ∈ A := by
      rw [hy, hsub x]
      exact hA
    first
      | exact h1
      | simpa using h1
  obtain ⟨iA, hiA⟩ : ∃ iA : Spec (.of K) ⟶ (A : Scheme.{u}), iA ≫ A.ι = y₀ :=
    ⟨IsOpenImmersion.lift A.ι y₀ hrA, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨iA', hiA'⟩ : ∃ iA' : Spec (.of K) ⟶ ((π ⁻¹ᵁ A : Y'.Opens) : Scheme.{u}),
      iA' ≫ (π ⁻¹ᵁ A).ι = y₀' :=
    ⟨IsOpenImmersion.lift (π ⁻¹ᵁ A).ι y₀' hrA', IsOpenImmersion.lift_fac _ _ _⟩
  have hcomp : iA' ≫ (π ∣_ A) = iA := by
    rw [← cancel_mono A.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hiA', hy, hiA]
  have sqj : IsPullback (𝟙 (Spec (.of K))) iA' y₀' (π ⁻¹ᵁ A).ι :=
    IsPullback.of_horiz_isIso_mono ⟨by rw [Category.id_comp, hiA']⟩
  have sq12 : IsPullback (𝟙 (Spec (.of K))) iA' y₀ (π ∣_ A ≫ A.ι) :=
    IsPullback.of_horiz_isIso_mono ⟨by rw [Category.id_comp, ← Category.assoc, hcomp, hiA]⟩
  have sqπ : IsPullback (𝟙 (Spec (.of K))) y₀' y₀ π := by
    have s : IsPullback (𝟙 (Spec (.of K))) iA' iA (π ∣_ A) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.id_comp, hcomp]⟩
    have h := IsPullback.paste_vert s (isPullback_morphismRestrict π A)
    rw [hiA', hiA] at h
    exact h
  haveI hcl' : IsClosedImmersion y₀' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) sqπ hcl

  obtain ⟨E₂⟩ := wc_et_zmod_pull_data_exists (π ⁻¹ᵁ A).ι ℓ
  obtain ⟨E₁₂⟩ := wc_et_zmod_pull_data_exists (π ∣_ A ≫ A.ι) ℓ
  obtain ⟨DA'⟩ := wc_et_zmod_pull_data_exists iA' ℓ
  obtain ⟨γ₁, hγ₁, -⟩ := wc_et_closed_supp_base_change y₀ π y₀' (𝟙 _) sqπ Dy Dπ Dy'
  obtain ⟨γ₂, hγ₂, -⟩ := wc_et_closed_supp_base_change y₀' (π ⁻¹ᵁ A).ι iA' (𝟙 _) sqj Dy' E₂ DA'
  obtain ⟨γ₁₂, hγ₁₂, hepi⟩ :=
    wc_et_closed_supp_base_change y₀ (π ∣_ A ≫ A.ι) iA' (𝟙 _) sq12 Dy E₁₂ DA'
  have hstar := wc_et_supp_restr_comp π (π ⁻¹ᵁ A).ι (π ∣_ A ≫ A.ι) (morphismRestrict_ι π A).symm
    Dy Dy' DA' Dπ E₂ E₁₂ γ₁ γ₂ γ₁₂ hγ₁ hγ₂ hγ₁₂ hepi k
  have hinj := wc_et_supp_restr_etale_excision_injective (π ⁻¹ᵁ A).ι y₀' iA' (𝟙 _) sqj
    inferInstance Dy' E₂ DA' γ₂ hγ₂ k
  have hsurj := wc_et_supp_restr_etale_excision_surjective (π ∣_ A ≫ A.ι) y₀ iA' (𝟙 _) sq12
    inferInstance Dy E₁₂ DA' γ₁₂ hγ₁₂ k

  have hnat : ∀ θ : wcEtSuppExt Dy k, wcEtPull Dπ k (wcEtSuppClass Dy k θ) =
      wcEtSuppClass Dy' k (wcEtSuppRestr Dy Dπ Dy' γ₁ k θ) := by
    intro θ
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y' ℓ)) := HasExt.standard _
    haveI := Dπ.additive
    haveI := Dπ.presLim
    haveI := Dπ.presColim
    show (Abelian.Ext.mk₀ Dπ.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor Dπ.Φ
          ((Abelian.Ext.mk₀ (wcEtSuppUnitMap Dy)).comp θ (zero_add k))).comp
          (Abelian.Ext.mk₀ Dπ.μ.hom) (add_zero k)) (zero_add k) =
      (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dy')).comp
        ((Abelian.Ext.mk₀ γ₁).comp
          ((Abelian.Ext.mapExactFunctor Dπ.Φ θ).comp (Abelian.Ext.mk₀ Dπ.μ.hom) (add_zero k))
          (zero_add k)) (zero_add k)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (Dπ.Φ.map (wcEtSuppUnitMap Dy)))
        (Abelian.Ext.mapExactFunctor Dπ.Φ θ) (Abelian.Ext.mk₀ Dπ.μ.hom)
        (zero_add k) (add_zero k) (by omega),
      Abelian.Ext.mk₀_comp_mk₀_assoc, ← hγ₁, ← Abelian.Ext.mk₀_comp_mk₀_assoc]

  obtain ⟨θ, hθ⟩ := hsurj (wcEtSuppRestr Dy' E₂ DA' γ₂ k u')
  refine ⟨θ, ?_⟩
  rw [hnat]
  congr 1
  apply hinj
  rw [← hstar, hθ]

theorem wc_et_point_supp_class_nonzero : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (y₀ : Spec (.of K) ⟶ Y), y₀ ≫ f = 𝟙 _ → ∀ (Dy : wcEtPullData y₀ ℓ), ∃ u : wcEtSuppExt Dy (2 * d), wcEtSuppClass Dy (2 * d) u ≠ 0 :=
by
  classical
  intro K _ _ Y f _ d _ _ ℓ _ hℓ y₀ hy₀ Dy
  have hp : ℓ.Prime := Fact.out

  obtain ⟨N, Y', π, j, y₀', A, V, _hπ, hj, hjπ, hirr, hdim', hy₀', hA, hAiso, hV, hVsm⟩ :=
    wc_chow_cover_iso_near_point K Y f d y₀ hy₀

  obtain ⟨p, W, hpfin, hpStr, hW, hWet⟩ :=
    wc_proj_generic_projection_etale_at_point K N d Y' j hj hdim' y₀' V hV hVsm

  have hx₀ : (y₀' ≫ p) ≫ wcProjKStr K d = 𝟙 _ := by
    rw [Category.assoc, hpStr, hjπ, ← Category.assoc, hy₀', hy₀]

  obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists π ℓ
  obtain ⟨Dy'⟩ := wc_et_zmod_pull_data_exists y₀' ℓ
  obtain ⟨Dx⟩ := wc_et_zmod_pull_data_exists (y₀' ≫ p) ℓ

  have hPnz : ∃ v : wcEtSuppExt Dx (2 * d), wcEtSuppClass Dx (2 * d) v ≠ 0 := by
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (wcProjK K d) ℓ)) := HasExt.standard _
    haveI := wc_proj_space_isProper K d
    haveI := wc_proj_space_irreducible K d
    have hcard := wc_et_top_coh_card_ge K (wcProjK K d) (wcProjKStr K d) d
      (wc_proj_space_dim K d) ℓ hp hℓ 1 le_rfl
    rw [pow_one] at hcard
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv (wcProjK K d) ℓ (2 * d)
    have hpos : 0 < Nat.card (wcEtCoh (wcProjK K d) ℓ (2 * d)) := lt_of_lt_of_le hp.pos hcard
    haveI : Finite (wcEtCoh (wcProjK K d) ℓ (2 * d)) := (Nat.card_pos_iff.mp hpos).2
    haveI : Nontrivial (wcEtCoh (wcProjK K d) ℓ (2 * d)) :=
      Finite.one_lt_card_iff_nontrivial.mp (lt_of_lt_of_le hp.one_lt hcard)
    haveI : Nontrivial (wcEtZModExt (wcProjK K d) ℓ (2 * d)) := e.nontrivial
    obtain ⟨c, hc⟩ := exists_ne (0 : wcEtZModExt (wcProjK K d) ℓ (2 * d))
    haveI : IsClosedImmersion ((y₀' ≫ p) ≫ wcProjKStr K d) := by rw [hx₀]; infer_instance
    haveI : IsClosedImmersion (y₀' ≫ p) := IsClosedImmersion.of_comp (y₀' ≫ p) (wcProjKStr K d)
    have hcl : IsClosed (Set.range (y₀' ≫ p)) := (y₀' ≫ p).isClosedEmbedding.isClosed_range
    obtain ⟨U, hU⟩ : ∃ U : (wcProjK K d).Opens,
        (U : Set (wcProjK K d)) = (Set.range (y₀' ≫ p))ᶜ :=
      ⟨⟨(Set.range (y₀' ≫ p))ᶜ, hcl.isOpen_compl⟩, rfl⟩

    obtain ⟨hepi, ⟨iso⟩⟩ := wc_et_point_supp_unit_map_epi_ker K (wcProjK K d) (wcProjKStr K d) ℓ
      (y₀' ≫ p) hx₀ Dx
    rw [← hU] at iso

    obtain ⟨eU⟩ := wc_et_extzero_module_ext_open_coh (wcProjK K d) U ℓ hp.pos
      (Limits.kernel (wcEtSuppUnitMap Dx)) ⟨iso⟩ (2 * d)
    haveI := wc_et_proj_punctured_top_vanishing K d ℓ hp hℓ (y₀' ≫ p) hx₀ U hU
    haveI := eU.subsingleton
    have hzero : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap Dx))).comp c
        (zero_add _) = 0 := Subsingleton.elim _ _

    have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap Dx)) (wcEtSuppUnitMap Dx)
        (Limits.kernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS _ c hzero
    refine ⟨x₃, ?_⟩
    show (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dx)).comp x₃ (zero_add _) ≠ 0
    rw [hx₃]
    exact hc
  obtain ⟨v, hv⟩ := hPnz

  obtain ⟨Tr, hTr⟩ := wc_et_finite_trace_point_class K d Y' p hpfin hirr hdim' y₀' W hW hWet hx₀
    ℓ hℓ Dy' Dx
  obtain ⟨u', hu'⟩ := hTr v
  have hu'0 : wcEtSuppClass Dy' (2 * d) u' ≠ 0 := by
    intro h
    apply hv
    rw [← hu', h, map_zero]

  haveI : IsClosedImmersion (y₀ ≫ f) := by rw [hy₀]; infer_instance
  haveI : IsClosedImmersion y₀ := IsClosedImmersion.of_comp y₀ f
  obtain ⟨u, hu⟩ := wc_et_supp_class_pull_iso_near_point K Y Y' π y₀ y₀' hy₀' inferInstance A hA
    hAiso ℓ Dπ Dy Dy' (2 * d) u'
  refine ⟨u, fun h => hu'0 ?_⟩
  rw [← hu, h, map_zero]

theorem wc_et_affine_space_top_coh_vanishing : ∀ (K : Type u) [Field K] [IsAlgClosed K] (d : ℕ), 1 ≤ d → ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → Subsingleton (wcEtCoh (Spec (.of (MvPolynomial (Fin d) K))) ℓ (2 * d)) :=
by
  intro K _ _ d hd ℓ hℓ hℓK
  exact wc_et_affine_space_coh_vanishing K ℓ hℓ hℓK d (2 * d) (by omega)

theorem wc_punct_affine_cover_iso : ∀ (K : Type u) [Field K] (n : ℕ) (V : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens), (V : Set (Spec (.of (MvPolynomial (Fin (n + 1)) K)))) = {x | ∃ i : Fin (n + 1), (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} → ∃ (W : (Spec (.of (MvPolynomial (Fin n) K))).Opens) (A B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens), (W : Set (Spec (.of (MvPolynomial (Fin n) K)))) = {x | ∃ i : Fin n, (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ x.asIdeal} ∧ (A : Set (Spec (.of (MvPolynomial (Fin (n + 1)) K)))) = {x | (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} ∧ (B : Set (Spec (.of (MvPolynomial (Fin (n + 1)) K)))) = {x | ∃ i : Fin n, (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} ∧ A ⊔ B = V ∧ Nonempty ((A : Scheme.{u}) ≅ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ∧ Nonempty ((B : Scheme.{u}) ≅ Limits.pullback ((W : (Spec (.of (MvPolynomial (Fin n) K))).Opens).ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ∧ Nonempty (((A ⊓ B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens) : Scheme.{u}) ≅ Limits.pullback ((W : (Spec (.of (MvPolynomial (Fin n) K))).Opens).ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) :=
by
  intro K _ n V hV

  have s2 : ∀ {S X' Y' X₀ Y₀ Z : Scheme.{u}} (f' : X' ⟶ S) (g' : Y' ⟶ S) (i₁ : X₀ ⟶ X')
      (i₂ : Y₀ ⟶ Y') [IsOpenImmersion i₁] [IsOpenImmersion i₂] (ι : Limits.pullback f' g' ≅ Z)
      (U : Z.Opens), (∀ w : ↥(Limits.pullback f' g'), ι.hom w ∈ U ↔
        (Limits.pullback.fst f' g' w ∈ Set.range i₁ ∧ Limits.pullback.snd f' g' w ∈ Set.range i₂)) →
      Nonempty ((U : Scheme.{u}) ≅ Limits.pullback (i₁ ≫ f') (i₂ ≫ g')) := by
    intro S X' Y' X₀ Y₀ Z f' g' i₁ i₂ _ _ ι U h
    let m := Limits.pullback.map (i₁ ≫ f') (i₂ ≫ g') f' g' i₁ i₂ (𝟙 S) (Category.comp_id _)
      (Category.comp_id _)
    have : IsOpenImmersion m :=
      MorphismProperty.pullbackMap (P := @IsOpenImmersion) (inferInstance : IsOpenImmersion i₁)
        (inferInstance : IsOpenImmersion i₂) rfl rfl
    have hm := Scheme.Pullback.range_map (i₁ ≫ f') (i₂ ≫ g') f' g' i₁ i₂ (𝟙 S)
      (Category.comp_id _) (Category.comp_id _)
    have hr : Set.range (m ≫ ι.hom) = (U : Set Z) := by
      ext z
      constructor
      · rintro ⟨v, rfl⟩
        rw [Scheme.Hom.comp_apply]
        have hv : m v ∈ Set.range m := ⟨v, rfl⟩
        rw [hm] at hv
        exact (h (m v)).2 hv
      · intro hz
        have h1 : ι.hom (ι.inv z) ∈ U := by rw [Scheme.inv_hom_apply]; exact hz
        have h2 := (h _).1 h1
        have h3 : ι.inv z ∈ Set.range m := by rw [hm]; exact h2
        obtain ⟨v, hv⟩ := h3
        exact ⟨v, by rw [Scheme.Hom.comp_apply, hv, Scheme.inv_hom_apply]⟩
    exact ⟨IsOpenImmersion.isoOfRangeEq U.ι (m ≫ ι.hom)
      (by rw [Scheme.Opens.range_ι]; exact hr.symm)⟩

  have s3 : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) ∧ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) = {x | (Polynomial.X : Polynomial K) ∉ x.asIdeal} ∧ Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K))) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) = Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) := by
    refine ⟨IsOpenImmersion.of_isLocalization (Polynomial.X : Polynomial K), ?_, ?_⟩
    · have hr := PrimeSpectrum.localization_away_comap_range (LaurentPolynomial K)
        (Polynomial.X : Polynomial K)
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        have h1 : PrimeSpectrum.comap (algebraMap (Polynomial K) (LaurentPolynomial K)) y ∈
            Set.range (PrimeSpectrum.comap (algebraMap (Polynomial K) (LaurentPolynomial K))) :=
          ⟨y, rfl⟩
        rw [hr] at h1
        exact (PrimeSpectrum.mem_basicOpen _ _).1 h1
      · intro hx
        have h1 : (x : PrimeSpectrum (Polynomial K)) ∈
            ((PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) :
              Set (PrimeSpectrum (Polynomial K))) := hx
        rw [← hr] at h1
        obtain ⟨y, hy⟩ := h1
        exact ⟨y, hy⟩
    · have h : (algebraMap (Polynomial K) (LaurentPolynomial K)).comp (algebraMap K (Polynomial K)) =
          algebraMap K (LaurentPolynomial K) := by
        refine RingHom.ext fun k => ?_
        simp [LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_C,
          LaurentPolynomial.algebraMap_apply]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]

  have s1 : ∃ ι : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≅ Spec (.of (MvPolynomial (Fin (n + 1)) K)), ι.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin (n + 1)) K).toRingHom) = Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ∧ ι.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K)).toRingHom) = Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    let Ψ : MvPolynomial (Fin (n + 1)) K ≃ₐ[K]
        TensorProduct K (MvPolynomial (Fin n) K) (Polynomial K) :=
      (MvPolynomial.finSuccEquiv K n).trans (polyEquivTensor K (MvPolynomial (Fin n) K))
    have hX0 : Ψ (MvPolynomial.X 0) = 1 ⊗ₜ Polynomial.X := by
      simp [Ψ, MvPolynomial.finSuccEquiv_X_zero, polyEquivTensor_apply]
    have hXs : ∀ j : Fin n, Ψ (MvPolynomial.X j.succ) = MvPolynomial.X j ⊗ₜ 1 := by
      intro j
      simp [Ψ, MvPolynomial.finSuccEquiv_X_succ, polyEquivTensor_apply]
    have I1 : (Ψ.toRingEquiv.toRingHom).comp
        (MvPolynomial.rename Fin.succ :
          MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin (n + 1)) K).toRingHom =
        Algebra.TensorProduct.includeLeftRingHom := by
      have : (Ψ.toAlgHom.comp (MvPolynomial.rename Fin.succ)) =
          (Algebra.TensorProduct.includeLeft : MvPolynomial (Fin n) K →ₐ[K] _) := by
        apply MvPolynomial.algHom_ext
        intro j
        simp [hXs]
      refine RingHom.ext fun x => ?_
      have hx := AlgHom.congr_fun this x
      simpa using hx
    have I2 : (Ψ.toRingEquiv.toRingHom).comp
        (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K)).toRingHom =
        (Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] _).toRingHom := by
      have : (Ψ.toAlgHom.comp (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K))) =
          (Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] _) := by
        apply Polynomial.algHom_ext
        simp [hX0]
      refine RingHom.ext fun x => ?_
      have hx := AlgHom.congr_fun this x
      simpa using hx
    let e : Spec (.of (TensorProduct K (MvPolynomial (Fin n) K) (Polynomial K))) ≅
        Spec (.of (MvPolynomial (Fin (n + 1)) K)) :=
      Scheme.Spec.mapIso (Ψ.toRingEquiv.toCommRingCatIso).op
    have he : e.hom = Spec.map (CommRingCat.ofHom Ψ.toRingEquiv.toRingHom) := rfl
    refine ⟨pullbackSpecIso K _ _ ≪≫ e, ?_, ?_⟩
    · rw [Iso.trans_hom, Category.assoc, he, ← Spec.map_comp, ← CommRingCat.ofHom_comp, I1]
      exact pullbackSpecIso_hom_fst K _ _
    · rw [Iso.trans_hom, Category.assoc, he, ← Spec.map_comp, ← CommRingCat.ofHom_comp, I2]
      exact pullbackSpecIso_hom_snd K _ _

  obtain ⟨ι, e₁, e₂⟩ := s1
  obtain ⟨hj, hjr, hjq⟩ := s3
  have hAo : IsOpen {x : Spec (.of (MvPolynomial (Fin (n + 1)) K)) |
      (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} :=
    PrimeSpectrum.isOpen_basicOpen (a := (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K))
  have hBo : IsOpen {x : Spec (.of (MvPolynomial (Fin (n + 1)) K)) |
      ∃ i : Fin n, (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} := by
    have : {x : Spec (.of (MvPolynomial (Fin (n + 1)) K)) |
        ∃ i : Fin n, (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} =
        ⋃ i : Fin n, {x : Spec (.of (MvPolynomial (Fin (n + 1)) K)) |
          (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} := by
      ext x; simp
    rw [this]
    exact isOpen_iUnion fun i =>
      PrimeSpectrum.isOpen_basicOpen (a := (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K))
  have hWo : IsOpen {x : Spec (.of (MvPolynomial (Fin n) K)) |
      ∃ i : Fin n, (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ x.asIdeal} := by
    have : {x : Spec (.of (MvPolynomial (Fin n) K)) |
        ∃ i : Fin n, (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ x.asIdeal} =
        ⋃ i : Fin n, {x : Spec (.of (MvPolynomial (Fin n) K)) |
          (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ x.asIdeal} := by
      ext x; simp
    rw [this]
    exact isOpen_iUnion fun i =>
      PrimeSpectrum.isOpen_basicOpen (a := (MvPolynomial.X i : MvPolynomial (Fin n) K))
  let A : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens := ⟨_, hAo⟩
  let B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens := ⟨_, hBo⟩
  let W : (Spec (.of (MvPolynomial (Fin n) K))).Opens := ⟨_, hWo⟩
  have hA : ∀ y, y ∈ A ↔ (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∉ y.asIdeal :=
    fun y => Iff.rfl
  have hB : ∀ y, y ∈ B ↔
      ∃ i : Fin n, (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∉ y.asIdeal :=
    fun y => Iff.rfl
  have hW : ∀ y, y ∈ (W : Set (Spec (.of (MvPolynomial (Fin n) K)))) ↔
      ∃ i : Fin n, (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ y.asIdeal :=
    fun y => Iff.rfl
  have hAB : ∀ y, y ∈ A ⊓ B ↔ y ∈ A ∧ y ∈ B := fun y => Iff.rfl

  have star : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (x : Spec (.of S)) (r : R),
      r ∈ (Spec.map (CommRingCat.ofHom φ) x).asIdeal ↔ φ r ∈ x.asIdeal := by
    intro R S _ _ φ x r
    exact Iff.rfl
  have C1 : ∀ (w : ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) (i : Fin n),
      (MvPolynomial.X i : MvPolynomial (Fin n) K) ∈ (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) w).asIdeal ↔
        (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∈ (ι.hom w).asIdeal := by
    intro w i
    rw [← e₁, Scheme.Hom.comp_apply, star]
    simp [MvPolynomial.rename_X]
  have C2 : ∀ (w : ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))),
      (Polynomial.X : Polynomial K) ∈ (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) w).asIdeal ↔
        (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∈ (ι.hom w).asIdeal := by
    intro w
    rw [← e₂, Scheme.Hom.comp_apply, star]
    simp [Polynomial.aeval_X]
  refine ⟨W, A, B, rfl, rfl, rfl, ?_, ?_, ?_, ?_⟩
  · apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_sup, hV]
    ext x
    exact (Fin.exists_fin_succ (P := fun i =>
      (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal)).symm
  · obtain ⟨eA⟩ := s2 _ _ (𝟙 _) _ ι A (by
      intro w
      rw [hA, hjr, Set.mem_setOf_eq, C2]
      exact ⟨fun h => ⟨Scheme.Hom.surjective _ _, h⟩, fun h => h.2⟩)
    exact ⟨eA ≪≫ Limits.pullback.congrHom (Category.id_comp _) hjq⟩
  · obtain ⟨eB⟩ := s2 _ _ W.ι (𝟙 _) ι B (by
      intro w
      rw [hB, Scheme.Opens.range_ι, hW]
      simp only [C1]
      exact ⟨fun h => ⟨h, Scheme.Hom.surjective _ _⟩, fun h => h.1⟩)
    exact ⟨eB ≪≫ Limits.pullback.congrHom rfl (Category.id_comp _)⟩
  · obtain ⟨eAB⟩ := s2 _ _ W.ι _ ι (A ⊓ B) (by
      intro w
      rw [hAB, hA, hB, Scheme.Opens.range_ι, hW, hjr, Set.mem_setOf_eq, C2]
      simp only [C1]
      exact and_comm)
    exact ⟨eAB ≪≫ Limits.pullback.congrHom rfl hjq⟩

theorem wc_et_punctured_affine_coh_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (d : ℕ), 1 ≤ d → ∀ (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (U : (Spec (.of (MvPolynomial (Fin d) K))).Opens), (U : Set (Spec (.of (MvPolynomial (Fin d) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K))))ᶜ → Finite (wcEtCoh U ℓ (2 * d - 1)) ∧ Nat.card (wcEtCoh U ℓ (2 * d - 1)) ≤ ℓ :=
by
  classical
  intro K _ _ d hd ℓ hℓ hℓK U hU
  have hℓ1 : 1 ≤ ℓ := hℓ.one_lt.le

  have hLFT : ∀ n : ℕ,
      LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) := by
    intro n
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
    exact RingHom.finiteType_algebraMap.mpr inferInstance

  have transE : ∀ {X Y : Scheme.{u}} (q c : ℕ), Nonempty (wcEtCoh X ℓ q ≃ wcEtCoh Y ℓ q) →
      (Finite (wcEtCoh Y ℓ q) ∧ Nat.card (wcEtCoh Y ℓ q) ≤ c) →
      Finite (wcEtCoh X ℓ q) ∧ Nat.card (wcEtCoh X ℓ q) ≤ c := by
    intro X Y q c ⟨e⟩ ⟨h1, h2⟩
    exact ⟨Finite.of_equiv _ e.symm, by rw [Nat.card_congr e]; exact h2⟩
  have transp : ∀ {X Y : Scheme.{u}} (e : X ≅ Y) (q c : ℕ),
      (Finite (wcEtCoh Y ℓ q) ∧ Nat.card (wcEtCoh Y ℓ q) ≤ c) →
      Finite (wcEtCoh X ℓ q) ∧ Nat.card (wcEtCoh X ℓ q) ≤ c := by
    intro X Y e q c h
    obtain ⟨e'⟩ := wc_et_coh_iso_invariance e.hom ℓ q
    exact transE q c ⟨e'.symm⟩ h
  have sub_bd : ∀ (X : Scheme.{u}) (q : ℕ), Subsingleton (wcEtCoh X ℓ q) →
      Finite (wcEtCoh X ℓ q) ∧ Nat.card (wcEtCoh X ℓ q) ≤ 1 := by
    intro X q h
    exact ⟨Finite.of_subsingleton, Finite.card_le_one_iff_subsingleton.mpr h⟩
  have bd_sub : ∀ (X : Scheme.{u}) (q : ℕ),
      (Finite (wcEtCoh X ℓ q) ∧ Nat.card (wcEtCoh X ℓ q) ≤ 1) → Subsingleton (wcEtCoh X ℓ q) := by
    intro X q ⟨h1, h2⟩
    exact Finite.card_le_one_iff_subsingleton.mp h2

  have aff_bd : ∀ n q : ℕ, 1 ≤ q →
      Finite (wcEtCoh (Spec (.of (MvPolynomial (Fin n) K))) ℓ q) ∧
        Nat.card (wcEtCoh (Spec (.of (MvPolynomial (Fin n) K))) ℓ q) ≤ 1 :=
    fun n q hq => sub_bd _ q (wc_et_affine_space_coh_vanishing K ℓ hℓ hℓK n q hq)
  have aff0 : ∀ n : ℕ,
      Finite (wcEtCoh (Spec (.of (MvPolynomial (Fin n) K))) ℓ 0) ∧
        Nat.card (wcEtCoh (Spec (.of (MvPolynomial (Fin n) K))) ℓ 0) ≤ ℓ :=
    fun n => wc_et_coh_zero_irreducible_card_le _ ℓ hℓ.ne_zero
  have fin_aff : ∀ n q : ℕ, Finite (wcEtCoh (Spec (.of (MvPolynomial (Fin n) K))) ℓ q) := by
    intro n q
    rcases Nat.eq_zero_or_pos q with h | h
    · subst h; exact (aff0 n).1
    · exact (aff_bd n q h).1

  have key : ∀ n : ℕ, 1 ≤ n → ∀ V : (Spec (.of (MvPolynomial (Fin n) K))).Opens,
      (V : Set (Spec (.of (MvPolynomial (Fin n) K)))) =
        {x | ∃ i : Fin n, (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ x.asIdeal} →
      (Finite (wcEtCoh V ℓ (2 * n - 1)) ∧ Nat.card (wcEtCoh V ℓ (2 * n - 1)) ≤ ℓ) ∧
        ∀ q, 2 * n ≤ q → Subsingleton (wcEtCoh V ℓ q) := by
    intro n hn
    induction n, hn using Nat.le_induction with
    | base =>
      intro V hV
      obtain ⟨W, A, B, _, _, hB, hAB, ⟨eA⟩, _, _⟩ := wc_punct_affine_cover_iso K 0 V hV
      have hB0 : B = ⊥ := by
        apply TopologicalSpace.Opens.ext
        rw [hB, TopologicalSpace.Opens.coe_bot]
        ext x
        simp
      rw [hB0, sup_bot_eq] at hAB
      subst hAB
      haveI := hLFT 0
      have gm : ∀ q : ℕ, Finite (wcEtCoh A ℓ (q + 1)) ∧
          Nat.card (wcEtCoh A ℓ (q + 1)) ≤
            Nat.card (wcEtCoh (Spec (.of (MvPolynomial (Fin 0) K))) ℓ (q + 1)) *
              Nat.card (wcEtCoh (Spec (.of (MvPolynomial (Fin 0) K))) ℓ q) := by
        intro q
        apply transp eA
        exact wc_et_coh_gm_product_card_le K ℓ hℓ hℓK _
          (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 0) K)))) q
          (fin_aff 0 (q + 1)) (fin_aff 0 q)
      refine ⟨?_, ?_⟩
      · show Finite (wcEtCoh A ℓ (0 + 1)) ∧ Nat.card (wcEtCoh A ℓ (0 + 1)) ≤ ℓ
        obtain ⟨h1, h2⟩ := gm 0
        refine ⟨h1, h2.trans ?_⟩
        calc _ ≤ 1 * ℓ := Nat.mul_le_mul (aff_bd 0 (0 + 1) le_rfl).2 (aff0 0).2
          _ = ℓ := one_mul ℓ
      · intro q hq
        obtain ⟨p, rfl⟩ : ∃ p, q = p + 1 + 1 := ⟨q - 2, by omega⟩
        obtain ⟨h1, h2⟩ := gm (p + 1)
        apply bd_sub
        refine ⟨h1, h2.trans ?_⟩
        calc _ ≤ 1 * 1 := Nat.mul_le_mul (aff_bd 0 _ (by omega)).2 (aff_bd 0 _ (by omega)).2
          _ = 1 := rfl
    | succ n hn ih =>
      intro V hV
      obtain ⟨W, A, B, hW, _, _, hAB, ⟨eA⟩, ⟨eB⟩, ⟨eAB⟩⟩ := wc_punct_affine_cover_iso K n V hV
      obtain ⟨⟨hW1f, hW1c⟩, hW2⟩ := ih W hW
      haveI := hLFT n
      have hWs : ∀ p, 2 * n ≤ p →
          Finite (wcEtCoh W ℓ p) ∧ Nat.card (wcEtCoh W ℓ p) ≤ 1 :=
        fun p hp => sub_bd W p (hW2 p hp)
      have hWb : ∀ p, 2 * n - 1 ≤ p →
          Finite (wcEtCoh W ℓ p) ∧ Nat.card (wcEtCoh W ℓ p) ≤ ℓ := by
        intro p hp
        rcases Nat.eq_or_lt_of_le hp with h | h
        · subst h; exact ⟨hW1f, hW1c⟩
        · obtain ⟨h1, h2⟩ := hWs p (by omega)
          exact ⟨h1, h2.trans hℓ1⟩
      have main : ∀ p, 2 * n ≤ p + 1 →
          Finite (wcEtCoh V ℓ (p + 1 + 1)) ∧
            Nat.card (wcEtCoh V ℓ (p + 1 + 1)) ≤ Nat.card (wcEtCoh W ℓ p) := by
        intro p hp
        have hA' : Finite (wcEtCoh A ℓ (p + 1 + 1)) ∧
            Nat.card (wcEtCoh A ℓ (p + 1 + 1)) ≤ 1 := by
          have h := wc_et_coh_gm_product_card_le K ℓ hℓ hℓK _
            (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (p + 1)
            (aff_bd n _ (by omega)).1 (aff_bd n _ (by omega)).1
          apply transp eA
          refine ⟨h.1, h.2.trans ?_⟩
          calc _ ≤ 1 * 1 := Nat.mul_le_mul (aff_bd n _ (by omega)).2 (aff_bd n _ (by omega)).2
            _ = 1 := rfl
        have hB' : Finite (wcEtCoh B ℓ (p + 1 + 1)) ∧
            Nat.card (wcEtCoh B ℓ (p + 1 + 1)) ≤ 1 := by
          apply transp eB
          apply transE _ _ (wc_et_coh_affine_line_invariance K ℓ hℓ hℓK W
            (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K))))
            (p + 1 + 1))
          exact hWs _ (by omega)
        have hAB' : Finite (wcEtCoh (A ⊓ B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens)
              ℓ (p + 1)) ∧
            Nat.card (wcEtCoh (A ⊓ B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens)
              ℓ (p + 1)) ≤ Nat.card (wcEtCoh W ℓ p) := by
          have h := wc_et_coh_gm_product_card_le K ℓ hℓ hℓK W
            (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) p
            (hWs _ hp).1 (hWb p (by omega)).1
          apply transp eAB
          refine ⟨h.1, h.2.trans ?_⟩
          calc _ ≤ 1 * Nat.card (wcEtCoh W ℓ p) := Nat.mul_le_mul (hWs _ hp).2 le_rfl
            _ = _ := one_mul _
        have h := wc_et_zariski_mv_card_le _ V A B hAB ℓ (p + 1) hAB'.1 hA'.1 hB'.1
        refine ⟨h.1, h.2.trans ?_⟩
        calc _ ≤ Nat.card (wcEtCoh W ℓ p) * (1 * 1) :=
              Nat.mul_le_mul hAB'.2 (Nat.mul_le_mul hA'.2 hB'.2)
          _ = _ := by simp
      refine ⟨?_, ?_⟩
      · have e : 2 * (n + 1) - 1 = (2 * n - 1) + 1 + 1 := by omega
        rw [e]
        obtain ⟨h1, h2⟩ := main (2 * n - 1) (by omega)
        exact ⟨h1, h2.trans hW1c⟩
      · intro q hq
        obtain ⟨p, rfl⟩ : ∃ p, q = p + 1 + 1 := ⟨q - 2, by omega⟩
        obtain ⟨h1, h2⟩ := main p (by omega)
        exact bd_sub _ _ ⟨h1, h2.trans (hWs p (by omega)).2⟩

  have hU' : (U : Set (Spec (.of (MvPolynomial (Fin d) K)))) =
      {x | ∃ i : Fin d, (MvPolynomial.X i : MvPolynomial (Fin d) K) ∉ x.asIdeal} := by
    rw [hU]
    ext x
    rw [Set.mem_compl_iff, wc_affine_origin_range_iff, Set.mem_setOf_eq, not_forall]
  exact (key d hd U hU').1

theorem wc_et_point_supp_ext_card_le : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [IsProper f] (d : ℕ) [SmoothOfRelativeDimension d f] [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (y₀ : Spec (.of K) ⟶ Y), y₀ ≫ f = 𝟙 _ → ∀ (Dy : wcEtPullData y₀ ℓ), Finite (wcEtSuppExt Dy (2 * d)) ∧ Nat.card (wcEtSuppExt Dy (2 * d)) ≤ ℓ :=
by
  classical
  intro K _ _ Y f _ d _ _ ℓ _ hℓ y₀ hy₀ Dy
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hℓ0 : ℓ ≠ 0 := hℓpos.ne'
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  rcases Nat.eq_zero_or_pos d with hd | hd
  ·
    subst hd
    show Finite (wcEtSuppExt Dy 0) ∧ Nat.card (wcEtSuppExt Dy 0) ≤ ℓ
    obtain ⟨hepi, _⟩ := wc_et_point_supp_unit_map_epi_ker K Y f ℓ y₀ hy₀ Dy
    obtain ⟨_, hcard⟩ := wc_et_coh_zero_irreducible_card_le Y ℓ hℓ0
    obtain ⟨e⟩ := wc_et_zmodext_coh_equiv Y ℓ 0
    haveI : Finite (wcEtZModExt Y ℓ 0) := Finite.of_equiv _ e.symm
    have hc : Nat.card (wcEtZModExt Y ℓ 0) ≤ ℓ := by rw [Nat.card_congr e]; exact hcard
    have hinj : Function.Injective (fun x : wcEtSuppExt Dy 0 =>
        ((Abelian.Ext.mk₀ (wcEtSuppUnitMap Dy)).comp x (zero_add 0) : wcEtZModExt Y ℓ 0)) := by
      intro x x' hxx
      obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
      obtain ⟨g', rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x'
      simp only [Abelian.Ext.mk₀_comp_mk₀] at hxx
      have h1 := (Abelian.Ext.mk₀_bijective _ _).1 hxx
      rw [cancel_epi] at h1
      rw [h1]
    exact ⟨Finite.of_injective _ hinj, (Nat.card_le_card_of_injective _ hinj).trans hc⟩
  ·
    obtain ⟨V, ι, hι, v₀, φ, hv₀ι, hφet, hv₀φ, hfib⟩ :=
      wc_smooth_rational_point_etale_chart K Y f d y₀ hy₀
    haveI := hι
    haveI := hφet
    have hopK : Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K)) ≫
        Spec.map (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin d) K)) = 𝟙 _ := by
      rw [← Spec.map_comp, ← Spec.map_id]
      congr 1
      ext x
      simp
    haveI : IsClosedImmersion y₀ := by
      haveI : IsClosedImmersion (y₀ ≫ f) := by rw [hy₀]; infer_instance
      exact IsClosedImmersion.of_comp y₀ f
    haveI : IsClosedImmersion v₀ := by
      haveI : IsClosedImmersion (v₀ ≫ ι ≫ f) := by
        rw [← Category.assoc, hv₀ι, hy₀]; infer_instance
      exact IsClosedImmersion.of_comp v₀ (ι ≫ f)
    haveI : IsClosedImmersion
        (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K))) := by
      haveI : IsClosedImmersion
          (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K)) ≫
            Spec.map (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin d) K))) := by
        rw [hopK]; infer_instance
      exact IsClosedImmersion.of_comp _
        (Spec.map (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin d) K)))
    have hfibι : ∀ v : V, ι v = y₀ (IsLocalRing.closedPoint K) → v = v₀ (IsLocalRing.closedPoint K) := by
      intro v hv
      apply ι.isOpenEmbedding.injective
      rw [hv, ← hv₀ι]
      rfl
    obtain ⟨Dv⟩ := wc_et_zmod_pull_data_exists v₀ ℓ
    obtain ⟨Do⟩ := wc_et_zmod_pull_data_exists
      (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K))) ℓ
    obtain ⟨e1⟩ := wc_et_point_supp_ext_etale_excision K Y V ι y₀ v₀ hv₀ι hfibι ℓ Dy Dv (2 * d)
    obtain ⟨e2⟩ := wc_et_point_supp_ext_etale_excision K (Spec (.of (MvPolynomial (Fin d) K))) V φ
      _ v₀ hv₀φ hfib ℓ Do Dv (2 * d)
    let eE : wcEtSuppExt Dy (2 * d) ≃ wcEtSuppExt Do (2 * d) := e1.trans e2.symm
    suffices hA : Finite (wcEtSuppExt Do (2 * d)) ∧ Nat.card (wcEtSuppExt Do (2 * d)) ≤ ℓ by
      obtain ⟨h1, h2⟩ := hA
      exact ⟨Finite.of_equiv _ eE.symm, by rw [Nat.card_congr eE]; exact h2⟩

    letI : HasExt (SheafOfModules.{u+1}
        (wcEtZModRing (Spec (.of (MvPolynomial (Fin d) K))) ℓ)) := HasExt.standard _
    obtain ⟨hepi, ⟨eN⟩⟩ := wc_et_point_supp_unit_map_epi_ker K (Spec (.of (MvPolynomial (Fin d) K)))
      (Spec.map (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial (Fin d) K))) ℓ _ hopK Do
    have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap Do)) (wcEtSuppUnitMap Do)
        (Limits.kernel.condition (wcEtSuppUnitMap Do))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap Do)) inferInstance hepi
    have hclosed : IsClosed (Set.range
        (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K)))) :=
      (Scheme.Hom.isClosedEmbedding _).isClosed_range
    let U₀ : (Spec (.of (MvPolynomial (Fin d) K))).Opens :=
      ⟨(Set.range (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin d) K →+* K))))ᶜ, hclosed.isOpen_compl⟩
    obtain ⟨eU⟩ := wc_et_extzero_module_ext_open_coh (Spec (.of (MvPolynomial (Fin d) K))) U₀ ℓ hℓpos
      (Limits.kernel (wcEtSuppUnitMap Do)) ⟨eN⟩ (2 * d - 1)
    obtain ⟨hfinU, hcardU⟩ :=
      wc_et_punctured_affine_coh_card_le K d hd ℓ (Fact.out : Nat.Prime ℓ) hℓ U₀ rfl
    haveI := hfinU
    haveI := Finite.of_equiv _ eU.symm
    have hn : 1 + (2 * d - 1) = 2 * d := by omega
    have hsurj : Function.Surjective (fun x₁ : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap Do))
        (SheafOfModules.unit (wcEtZModRing (Spec (.of (MvPolynomial (Fin d) K))) ℓ)) (2 * d - 1) =>
          hS.extClass.comp x₁ hn) := by
      intro x₃
      have h0 : (Abelian.Ext.mk₀ (wcEtSuppUnitMap Do)).comp x₃ (zero_add _) = 0 := by
        obtain ⟨e⟩ := wc_et_zmodext_coh_equiv (Spec (.of (MvPolynomial (Fin d) K))) ℓ (2 * d)
        haveI := wc_et_affine_space_top_coh_vanishing K d hd ℓ (Fact.out : Nat.Prime ℓ) hℓ
        haveI : Subsingleton (wcEtZModExt (Spec (.of (MvPolynomial (Fin d) K))) ℓ (2 * d)) :=
          e.subsingleton
        exact (show ∀ a b : wcEtZModExt (Spec (.of (MvPolynomial (Fin d) K))) ℓ (2 * d), a = b from
          fun a b => Subsingleton.elim a b) _ _
      exact Abelian.Ext.contravariant_sequence_exact₃ hS _ x₃ h0 hn
    refine ⟨Finite.of_surjective _ hsurj, ?_⟩
    calc Nat.card (wcEtSuppExt Do (2 * d)) ≤ _ := Nat.card_le_card_of_surjective _ hsurj
      _ = Nat.card (wcEtCoh U₀ ℓ (2 * d - 1)) := Nat.card_congr eU
      _ ≤ ℓ := hcardU

theorem wc_et_zero_section_cutout_pullback : ∀ (K : Type u) [Field K] {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (i : Z ⟶ W) {c : ℕ} (h : Fin c → Γ(W, ⊤)), wcEtCutOut i h → IsPullback (i ≫ fW) i (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) :=
by
  intro K _ W Z fW i c h hc
  obtain ⟨hA, hI, hker⟩ := hc
  haveI := hA
  haveI := hI
  set z := AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))
    with hz
  set φ := AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down) with hφ
  have hb : ∀ {T : Scheme.{u}} (b : T ⟶ W) (j : ULift.{u} (Fin c)),
      (b ≫ φ).appTop.hom (AffineSpace.coord (Spec (.of K)) j) = b.appTop.hom (h j.down) := by
    intro T b j
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, hφ,
      AffineSpace.homOfVector_appTop_coord]
  have ha : ∀ {T : Scheme.{u}} (a : T ⟶ Spec (.of K)) (j : ULift.{u} (Fin c)),
      (a ≫ z).appTop.hom (AffineSpace.coord (Spec (.of K)) j) = 0 := by
    intro T a j
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, hz,
      AffineSpace.homOfVector_appTop_coord, Pi.zero_apply, map_zero]
  have hzπ : z ≫ (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K)) = 𝟙 _ :=
    AffineSpace.homOfVector_over _ _
  have hφπ : φ ≫ (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K)) = fW :=
    AffineSpace.homOfVector_over _ _
  have hcone1 : ∀ {T : Scheme.{u}} (a : T ⟶ Spec (.of K)) (b : T ⟶ W),
      a ≫ z = b ≫ φ → a = b ≫ fW := by
    intro T a b e
    have e' := congrArg (· ≫ (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K))) e
    simp only [Category.assoc, hzπ, hφπ, Category.comp_id] at e'
    exact e'
  have hcone2 : ∀ {T : Scheme.{u}} (a : T ⟶ Spec (.of K)) (b : T ⟶ W), a ≫ z = b ≫ φ →
      ∀ j : Fin c, b.appTop.hom (h j) = 0 := by
    intro T a b e j
    have e' : (a ≫ z).appTop.hom (AffineSpace.coord (Spec (.of K)) (ULift.up j)) =
        (b ≫ φ).appTop.hom (AffineSpace.coord (Spec (.of K)) (ULift.up j)) := by rw [e]
    rw [ha, hb] at e'
    exact e'.symm
  have hle : ∀ {T : Scheme.{u}} (b : T ⟶ W), (∀ j : Fin c, b.appTop.hom (h j) = 0) →
      i.ker ≤ b.ker := by
    intro T b hbj
    rw [Scheme.ker_of_isAffine i, Scheme.ker_of_isAffine b, Scheme.IdealSheafData.le_def]
    intro U
    rw [Scheme.IdealSheafData.ofIdealTop_ideal, Scheme.IdealSheafData.ofIdealTop_ideal]
    apply Ideal.map_mono
    rw [hker, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact hbj j
  have hcomm : (i ≫ fW) ≫ z = i ≫ φ := by
    apply AffineSpace.hom_ext
    · rw [Category.assoc, hzπ, Category.comp_id, Category.assoc, hφπ]
    · intro j
      rw [ha, hb]
      have hmem : h j.down ∈ RingHom.ker i.appTop.hom := by
        rw [hker]; exact Ideal.subset_span ⟨j.down, rfl⟩
      exact (RingHom.mem_ker.mp hmem).symm
  refine IsPullback.of_isLimit (Limits.PullbackCone.IsLimit.mk hcomm
    (fun s => IsClosedImmersion.lift i s.snd (hle s.snd (hcone2 s.fst s.snd s.condition)))
    ?_ ?_ ?_)
  · intro s
    rw [← Category.assoc, IsClosedImmersion.lift_fac]
    exact (hcone1 s.fst s.snd s.condition).symm
  · intro s
    exact IsClosedImmersion.lift_fac _ _ _
  · intro s m _ hm2
    rw [← cancel_mono i, hm2, IsClosedImmersion.lift_fac]

theorem wc_pp_dehomogenize_ringEquiv : ∀ (K : Type u) [Field K] (m : ℕ) (a : Fin (m + 1)), letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)); ∃ e : MvPolynomial (Fin m) K ≃+* HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a), ∀ c : K, e (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (Submonoid.powers (MvPolynomial.X a)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c) :=
by
  intro K _ m a
  letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K))

  have scale : ∀ {S : Type u} [CommRing S] (φ : K →+* S) (x : Fin (m + 1) → S) (t : S) (n : ℕ)
      (F : MvPolynomial (Fin (m + 1)) K), F.IsHomogeneous n →
      MvPolynomial.eval₂ φ (fun j => t * x j) F = t ^ n * MvPolynomial.eval₂ φ x F := by
    intro S _ φ x t n F hF
    conv_lhs => rw [F.as_sum]
    conv_rhs => rw [F.as_sum]
    rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    have hdeg : Finsupp.degree d = n := by
      by_contra h
      exact (MvPolynomial.mem_support_iff.mp hd) (hF.coeff_eq_zero h)
    rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
    have hp : (d.prod fun i e => (t * x i) ^ e) = t ^ n * d.prod fun i e => x i ^ e := by
      simp only [mul_pow]
      rw [Finsupp.prod_mul]
      congr 1
      rw [← hdeg, Finsupp.degree_apply]
      unfold Finsupp.prod
      rw [Finset.prod_pow_eq_pow_sum]
    rw [hp]
    ring
  have hX : (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K a)
  have hg : ∀ i : Fin m, (MvPolynomial.X (a.succAbove i) : MvPolynomial (Fin (m + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K (1 • 1) := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X K _)

  obtain ⟨ψ, hψC, hψX⟩ : ∃ ψ : MvPolynomial (Fin m) K →+*
      HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
        (MvPolynomial.X a),
      (∀ c : K, ψ (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (Submonoid.powers (MvPolynomial.X a))
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c)) ∧
      (∀ i : Fin m, ψ (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) hX 1
        (MvPolynomial.X (a.succAbove i)) (hg i)) :=
    ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (Submonoid.powers (MvPolynomial.X a))).comp
        (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)))
      (fun i => HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
        hX 1 (MvPolynomial.X (a.succAbove i)) (hg i)),
      fun c => by rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply],
      fun i => by rw [MvPolynomial.eval₂Hom_X']⟩

  obtain ⟨ρt, hρC, hρa, hρs⟩ : ∃ ρt : MvPolynomial (Fin (m + 1)) K →+* MvPolynomial (Fin m) K,
      (∀ c : K, ρt (MvPolynomial.C c) = MvPolynomial.C c) ∧ ρt (MvPolynomial.X a) = 1 ∧
      (∀ i : Fin m, ρt (MvPolynomial.X (a.succAbove i)) = MvPolynomial.X i) :=
    ⟨MvPolynomial.eval₂Hom MvPolynomial.C
        (Fin.insertNth (α := fun _ => MvPolynomial (Fin m) K) a 1 MvPolynomial.X),
      fun c => by rw [MvPolynomial.eval₂Hom_C],
      by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_same],
      fun i => by rw [MvPolynomial.eval₂Hom_X', Fin.insertNth_apply_succAbove]⟩
  have hu : IsUnit (ρt (MvPolynomial.X a)) := by rw [hρa]; exact isUnit_one

  have hu1 : (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
      Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) *
      algebraMap (MvPolynomial (Fin (m + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) (MvPolynomial.X a) = 1 := by
    rw [← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
    exact Localization.mk_self (⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
      Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))

  obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) →+*
      MvPolynomial (Fin m) K,
      (∀ z y, algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a))
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) z =
        algebraMap (MvPolynomial (Fin (m + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) y → ρ z = ρt y) ∧
      (∀ (n : ℕ) (F : MvPolynomial (Fin (m + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K (n • 1)),
        ρ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
          hX n F hF) = ρt F) := by
    refine ⟨(IsLocalization.Away.lift (MvPolynomial.X a) hu :
        Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K) →+*
          MvPolynomial (Fin m) K).comp (algebraMap _ _), ?_, ?_⟩
    · intro z y hzy
      rw [RingHom.comp_apply, hzy, IsLocalization.Away.lift_eq]
    · intro n F hF
      rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      have hs := IsLocalization.mk'_spec
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) F
        (⟨MvPolynomial.X a ^ n, pow_mem (Submonoid.mem_powers _) n⟩ :
          Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))
      rw [← Localization.mk_eq_mk'_apply] at hs
      have hs2 := congrArg (IsLocalization.Away.lift (MvPolynomial.X a) hu :
        Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K) →+*
          MvPolynomial (Fin m) K) hs
      rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq] at hs2
      simp only [map_pow, hρa, one_pow, mul_one] at hs2
      exact hs2

  have hΨC : ∀ c : K, algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a))
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))
        (ψ (MvPolynomial.C c)) =
      algebraMap (MvPolynomial (Fin (m + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) (MvPolynomial.C c) := by
    intro c
    rw [hψC, HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
    have h1 : ((algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)) : MvPolynomial (Fin (m + 1)) K) =
        MvPolynomial.C c := by
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    rw [← h1]
    rfl

  have hΨX : ∀ i : Fin m, algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a))
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))
        (ψ (MvPolynomial.X i)) =
      (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
        Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) *
      algebraMap (MvPolynomial (Fin (m + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))
        (MvPolynomial.X (a.succAbove i)) := by
    intro i
    rw [hψX, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
      ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, one_mul, mul_one]
    congr 1
    ext
    simp

  have hcomp : ((algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a))
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))).comp ψ).comp ρt =
      MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (m + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))).comp MvPolynomial.C)
        (fun j => (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) *
          algebraMap (MvPolynomial (Fin (m + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))
            (MvPolynomial.X j)) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, RingHom.comp_apply, hρC, hΨC, MvPolynomial.eval₂Hom_C,
        RingHom.comp_apply]
    · intro j
      rw [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, RingHom.comp_apply]
      rcases Fin.eq_self_or_eq_succAbove a j with h | ⟨i, h⟩
      · subst h
        rw [hρa, map_one, map_one, hu1]
      · subst h
        rw [hρs, hΨX]

  have hev : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin (m + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))).comp MvPolynomial.C)
        (fun j => algebraMap (MvPolynomial (Fin (m + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))
            (MvPolynomial.X j)) =
      algebraMap (MvPolynomial (Fin (m + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    · intro j
      rw [MvPolynomial.eval₂Hom_X']

  have key : ∀ (n : ℕ) (F : MvPolynomial (Fin (m + 1)) K), F.IsHomogeneous n →
      algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a))
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) (ψ (ρt F)) *
        algebraMap (MvPolynomial (Fin (m + 1)) K)
          (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))
          (MvPolynomial.X a ^ n) =
      algebraMap (MvPolynomial (Fin (m + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) F := by
    intro n F hF
    have h1 := RingHom.congr_fun hcomp F
    rw [RingHom.comp_apply, RingHom.comp_apply] at h1
    rw [h1, MvPolynomial.coe_eval₂Hom]
    have hs := scale ((algebraMap (MvPolynomial (Fin (m + 1)) K)
        (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))).comp MvPolynomial.C)
      (fun j => algebraMap (MvPolynomial (Fin (m + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))
            (MvPolynomial.X j))
      (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩) n F hF
    rw [hs, ← MvPolynomial.coe_eval₂Hom, hev, map_pow]
    calc (Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) ^ n *
          algebraMap (MvPolynomial (Fin (m + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) F *
          algebraMap (MvPolynomial (Fin (m + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))
            (MvPolynomial.X a) ^ n
        = ((Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
          Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) *
          algebraMap (MvPolynomial (Fin (m + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K))
            (MvPolynomial.X a)) ^ n *
          algebraMap (MvPolynomial (Fin (m + 1)) K)
            (Localization.Away (MvPolynomial.X a : MvPolynomial (Fin (m + 1)) K)) F := by ring
      _ = _ := by rw [hu1, one_pow, one_mul]

  have h1 : ψ.comp ρ = RingHom.id _ := by
    apply RingHom.ext
    intro z
    obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) hX z
    rw [RingHom.comp_apply, hρ2, RingHom.id_apply]
    have hFh : F.IsHomogeneous n := by
      rw [smul_eq_mul, mul_one] at hF
      exact (MvPolynomial.mem_homogeneousSubmodule n F).1 hF
    apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X a))
    rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
      Localization.mk_eq_mk'_apply, IsLocalization.eq_mk'_iff_mul_eq]
    exact key n F hFh

  have h2 : ρ.comp ψ = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro c
      rw [RingHom.comp_apply, hρ1 _ _ (hΨC c), hρC, RingHom.id_apply]
    · intro i
      rw [RingHom.comp_apply, hψX, hρ2, hρs, RingHom.id_apply]
  refine ⟨RingEquiv.ofRingHom ψ ρ h1 h2, fun c => ?_⟩
  rw [RingEquiv.ofRingHom_apply, hψC]

theorem wc_pp_chart_iso : ∀ (K : Type u) [Field K] (m : ℕ) (a : Fin (m + 1)), letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)); ∀ (e : MvPolynomial (Fin m) K ≃+* HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a)), (∀ c : K, e (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (Submonoid.powers (MvPolynomial.X a)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c)) → ∃ φ : (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a) : Scheme.{u}) ≅ AffineSpace (ULift.{u} (Fin m)) (Spec (.of K)), (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra (MvPolynomial.X a)).ι ≫ (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0)))) = φ.hom ≫ (AffineSpace (ULift.{u} (Fin m)) (Spec (.of K)) ↘ Spec (.of K)) :=
by
  intro K _ m a
  letI := (MvPolynomial.gradedAlgebra : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K))
  intro e he
  have hX : MvPolynomial.X a ∈ MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)
  let e' : MvPolynomial (ULift.{u} (Fin m)) K ≃+* HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (MvPolynomial.X a) :=
    (MvPolynomial.renameEquiv K (Equiv.ulift.{u} (α := Fin m))).toRingEquiv.trans e
  have he' : ∀ c : K, e' (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K) (Submonoid.powers (MvPolynomial.X a))
      (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K 0) c) := by
    intro c
    rw [← he c]
    show e ((MvPolynomial.renameEquiv K (Equiv.ulift.{u} (α := Fin m))) (MvPolynomial.C c)) = _
    rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_C]
  let bO := Proj.basicOpenIsoSpec (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
    (MvPolynomial.X a) hX Nat.one_pos
  have hι : (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X a)).ι =
      bO.hom ≫ Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) K)
        (MvPolynomial.X a) hX Nat.one_pos := by
    rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
  refine ⟨bO ≪≫ Scheme.Spec.mapIso e'.toCommRingCatIso.op ≪≫
    (AffineSpace.SpecIso (ULift.{u} (Fin m)) (CommRingCat.of K)).symm, ?_⟩
  rw [Iso.trans_hom, Iso.trans_hom, Iso.symm_hom, Functor.mapIso_hom, Iso.op_hom,
    RingEquiv.toCommRingCatIso_hom, Scheme.Spec_map, Quiver.Hom.unop_op, hι]
  simp only [Category.assoc, AffineSpace.SpecIso_inv_over]
  rw [← Category.assoc (Proj.awayι _ _ _ _), Proj.awayι_toSpecZero, ← Spec.map_comp,
    ← Spec.map_comp]
  congr 2
  ext c
  exact congrArg HomogeneousLocalization.val (he' c).symm

theorem wc_et_affine_origin_supp_ext_ne_zero : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (c : ℕ) (D0 : wcEtPullData (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) ℓ), ∃ ω : wcEtSuppExt D0 (2 * c), ω ≠ 0 :=
by
  classical
  intro K _ _ ℓ _ hℓ c D0
  have hp : ℓ.Prime := Fact.out

  obtain ⟨e, he⟩ := wc_pp_dehomogenize_ringEquiv K c 0
  obtain ⟨φ, hφ⟩ := wc_pp_chart_iso K c 0 e he

  let ψ : AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ⟶ wcProjK K c :=
    φ.inv ≫ (@Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (c + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X (0 : Fin (c + 1)))).ι
  haveI hψo : IsOpenImmersion ψ := by dsimp only [ψ]; infer_instance
  haveI hψe : Etale ψ := inferInstance
  haveI hψm : Mono ψ := inferInstance
  have hψ : ψ ≫ wcProjKStr K c = AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) := by
    dsimp only [ψ]
    rw [Category.assoc]
    erw [hφ]
    rw [Iso.inv_hom_id_assoc]
  let z := AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))
  let x₀ : Spec (.of K) ⟶ wcProjK K c := z ≫ ψ
  have hx₀ : x₀ ≫ wcProjKStr K c = 𝟙 _ := by
    dsimp only [x₀]
    rw [Category.assoc, hψ]
    exact AffineSpace.homOfVector_over _ _
  haveI := wc_proj_space_isProper K c
  haveI : IsClosedImmersion (x₀ ≫ wcProjKStr K c) := by rw [hx₀]; infer_instance
  haveI hx₀ci : IsClosedImmersion x₀ := IsClosedImmersion.of_comp x₀ (wcProjKStr K c)

  have hsq : IsPullback (𝟙 (Spec (.of K))) z x₀ ψ := by
    have h1 : IsPullback (𝟙 (Spec (.of K))) z z (𝟙 _) := IsPullback.of_id_fst
    have h2 : IsPullback (𝟙 _) (𝟙 _) ψ ψ := (mono_iff_isPullback ψ).mp inferInstance
    have h3 := h1.paste_vert h2
    rw [Category.comp_id] at h3
    exact h3

  obtain ⟨Dx⟩ := wc_et_zmod_pull_data_exists x₀ ℓ
  obtain ⟨Eψ⟩ := wc_et_zmod_pull_data_exists ψ ℓ
  obtain ⟨γ, hγ, -⟩ := wc_et_closed_supp_base_change x₀ ψ z (𝟙 _) hsq Dx Eψ D0

  have hinj := wc_et_supp_restr_etale_excision_injective ψ x₀ z (𝟙 _) hsq inferInstance
    Dx Eψ D0 γ hγ (2 * c)

  have hPnz : ∃ v : wcEtSuppExt Dx (2 * c), wcEtSuppClass Dx (2 * c) v ≠ 0 := by
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (wcProjK K c) ℓ)) := HasExt.standard _
    haveI := wc_proj_space_irreducible K c
    have hcard := wc_et_top_coh_card_ge K (wcProjK K c) (wcProjKStr K c) c
      (wc_proj_space_dim K c) ℓ hp hℓ 1 le_rfl
    rw [pow_one] at hcard
    obtain ⟨e₁⟩ := wc_et_zmodext_coh_equiv (wcProjK K c) ℓ (2 * c)
    have hpos : 0 < Nat.card (wcEtCoh (wcProjK K c) ℓ (2 * c)) := lt_of_lt_of_le hp.pos hcard
    haveI : Finite (wcEtCoh (wcProjK K c) ℓ (2 * c)) := (Nat.card_pos_iff.mp hpos).2
    haveI : Nontrivial (wcEtCoh (wcProjK K c) ℓ (2 * c)) :=
      Finite.one_lt_card_iff_nontrivial.mp (lt_of_lt_of_le hp.one_lt hcard)
    haveI : Nontrivial (wcEtZModExt (wcProjK K c) ℓ (2 * c)) := e₁.nontrivial
    obtain ⟨c₀, hc₀⟩ := exists_ne (0 : wcEtZModExt (wcProjK K c) ℓ (2 * c))
    have hcl : IsClosed (Set.range x₀) := x₀.isClosedEmbedding.isClosed_range
    obtain ⟨U, hU⟩ : ∃ U : (wcProjK K c).Opens,
        (U : Set (wcProjK K c)) = (Set.range x₀)ᶜ :=
      ⟨⟨(Set.range x₀)ᶜ, hcl.isOpen_compl⟩, rfl⟩
    obtain ⟨hepi, ⟨iso⟩⟩ := wc_et_point_supp_unit_map_epi_ker K (wcProjK K c) (wcProjKStr K c) ℓ
      x₀ hx₀ Dx
    rw [← hU] at iso
    obtain ⟨eU⟩ := wc_et_extzero_module_ext_open_coh (wcProjK K c) U ℓ hp.pos
      (Limits.kernel (wcEtSuppUnitMap Dx)) ⟨iso⟩ (2 * c)
    haveI := wc_et_proj_punctured_top_vanishing K c ℓ hp hℓ x₀ hx₀ U hU
    haveI := eU.subsingleton
    have hzero : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap Dx))).comp c₀
        (zero_add _) = 0 := Subsingleton.elim _ _
    have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap Dx)) (wcEtSuppUnitMap Dx)
        (Limits.kernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hepi
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS _ c₀ hzero
    refine ⟨x₃, ?_⟩
    show (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dx)).comp x₃ (zero_add _) ≠ 0
    rw [hx₃]
    exact hc₀
  obtain ⟨v, hv⟩ := hPnz
  have hv0 : v ≠ 0 := by
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (wcProjK K c) ℓ)) := HasExt.standard _
    intro h
    apply hv
    rw [h]
    show (Abelian.Ext.mk₀ (wcEtSuppUnitMap Dx)).comp (0 : wcEtSuppExt Dx (2 * c)) (zero_add _) = 0
    rw [Abelian.Ext.comp_zero]

  refine ⟨wcEtSuppRestr Dx Eψ D0 γ (2 * c) v, fun h => hv0 (hinj ?_)⟩
  rw [h, map_zero]

theorem wc_smooth_cutout_point_etale_nbhd : ∀ (K : Type u) [Field K] [IsAlgClosed K] {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (i : Z ⟶ W) (c : ℕ) (h : Fin c → Γ(W, ⊤)), SmoothOfRelativeDimension c fW → SmoothOfRelativeDimension 0 (i ≫ fW) → wcEtCutOut i h → ∀ z : Z, ∃ V : W.Opens, i z ∈ V ∧ Etale (V.ι ≫ AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) ∧ IsIso ((i ⁻¹ᵁ V).ι ≫ i ≫ fW) :=
by
  classical

  have s1 : ∀ (K : Type u) [Field K] {W : Scheme.{u}} [IsAffine W] (fW : W ⟶ Spec (.of K)) (c : ℕ), SmoothOfRelativeDimension c fW → ∀ w : W, ∃ g₀ : Γ(W, ⊤), w ∈ W.basicOpen g₀ ∧ RingHom.IsStandardSmoothOfRelativeDimension c ((algebraMap Γ(W, ⊤) Γ(W, W.basicOpen g₀)).comp fW.appTop.hom) := by
    intro K _ W _ fW c hsm w
    obtain ⟨U, hU, V, hV, hwV, e, hstd⟩ :=
      @SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension c _ _ fW hsm w
    have hUtop : U = ⊤ := by
      have hw : fW w ∈ U := e hwV
      ext x
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      rw [Subsingleton.elim x (fW w)]
      exact hw
    subst hUtop
    obtain ⟨_, ⟨g₀, rfl⟩, hwg, hle⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (isBasis_basicOpen W)) hwV
    refine ⟨g₀, hwg, ?_⟩
    have hbo : W.basicOpen (W.presheaf.map (homOfLE le_top).op g₀ : Γ(W, V)) = W.basicOpen g₀ := by
      rw [Scheme.basicOpen_res]
      exact inf_eq_right.mpr hle
    have hloc := hV.isLocalization_of_eq_basicOpen (W.presheaf.map (homOfLE le_top).op g₀)
      (homOfLE hle) hbo.symm
    letI : Algebra Γ(W, V) Γ(W, W.basicOpen g₀) := (W.presheaf.map (homOfLE hle).op).hom.toAlgebra
    have h0 := @RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway _ _ _ _ _
      _ hloc
    have h1 := h0.comp hstd
    rw [zero_add] at h1
    convert h1 using 1
    ext x
    change W.presheaf.map (homOfLE le_top).op (fW.appTop x) =
      W.presheaf.map (homOfLE hle).op ((fW.appLE ⊤ V e) x)
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
    simp only [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    first
      | (rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map])
      | (erw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map])

  have s2 : ∀ (R A B : Type u) [CommRing R] [CommRing A] [CommRing B] [Algebra R A] [Algebra.FiniteType R A] {ι : Type u} [Fintype ι] (h : ι → A) (ε : A →+* B), Function.Surjective ε → RingHom.ker ε = Ideal.span (Set.range h) → (ε.comp (algebraMap R A)).FormallyUnramified → ∃ r : A, ε r = 1 ∧ ∀ m : Ω[A⁄R], r • m ∈ Submodule.span A (Set.range fun j => KaehlerDifferential.D R A (h j)) := by
    intro R A B _ _ _ _ _ ι _ h ε hsurj hker hunr
    letI : Algebra A B := ε.toAlgebra
    letI : Algebra R B := (ε.comp (algebraMap R A)).toAlgebra
    haveI : IsScalarTower R A B := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.FormallyUnramified R B := RingHom.formallyUnramified_algebraMap.mp hunr
    haveI : Subsingleton Ω[B⁄R] := Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    set I : Ideal A := RingHom.ker (algebraMap A B) with hI
    have hIε : I = RingHom.ker ε := rfl
    set N : Submodule A Ω[A⁄R] :=
      Submodule.span A (Set.range fun j => KaehlerDifferential.D R A (h j)) with hN
    have hsurjA : Function.Surjective (algebraMap A B) := hsurj
    have hb : ∀ a : A, KaehlerDifferential.D R A a ∈ N ⊔ I • (⊤ : Submodule A Ω[A⁄R]) := by
      intro a
      have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R A B hsurjA
      have h0 : KaehlerDifferential.mapBaseChange R A B (1 ⊗ₜ KaehlerDifferential.D R A a) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨y, hy⟩ := (hex _).mp h0
      obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective I y
      rw [KaehlerDifferential.kerCotangentToTensor_toCotangent] at hy
      have hxI : (x : A) ∈ Ideal.span (Set.range h) := by rw [← hker]; exact x.2
      obtain ⟨cc, hcc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hxI
      let eq : (A ⧸ I) ≃ₐ[A] B :=
        Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId A B) hsurjA
      let Φ : TensorProduct A B Ω[A⁄R] →ₗ[A] Ω[A⁄R] ⧸ (I • (⊤ : Submodule A Ω[A⁄R])) :=
        (TensorProduct.quotTensorEquivQuotSMul Ω[A⁄R] I).toLinearMap ∘ₗ
          (LinearEquiv.rTensor Ω[A⁄R] eq.symm.toLinearEquiv).toLinearMap
      have hΦ : ∀ m : Ω[A⁄R], Φ (1 ⊗ₜ m) = Submodule.Quotient.mk m := by
        intro m
        simp only [Φ, LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
          LinearEquiv.rTensor_tmul, AlgEquiv.toLinearEquiv_apply, map_one]
        rw [← map_one (Ideal.Quotient.mk I), TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul]
      have h1 : KaehlerDifferential.D R A a - KaehlerDifferential.D R A x ∈
          I • (⊤ : Submodule A Ω[A⁄R]) := by
        have := congrArg Φ hy
        rw [hΦ, hΦ] at this
        exact (Submodule.Quotient.eq _).mp this.symm
      have hDx : KaehlerDifferential.D R A x = ∑ j, cc j • KaehlerDifferential.D R A (h j) +
          ∑ j, h j • KaehlerDifferential.D R A (cc j) := by
        rw [← hcc, map_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Derivation.leibniz]
      have h2 : ∑ j, cc j • KaehlerDifferential.D R A (h j) ∈ N :=
        Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))
      have h3 : ∑ j, h j • KaehlerDifferential.D R A (cc j) ∈ I • (⊤ : Submodule A Ω[A⁄R]) := by
        refine Submodule.sum_mem _ (fun j _ => Submodule.smul_mem_smul ?_ Submodule.mem_top)
        rw [hIε, hker]
        exact Ideal.subset_span ⟨j, rfl⟩
      have e : KaehlerDifferential.D R A a = ∑ j, cc j • KaehlerDifferential.D R A (h j) +
          ((KaehlerDifferential.D R A a - KaehlerDifferential.D R A x) +
            ∑ j, h j • KaehlerDifferential.D R A (cc j)) := by
        rw [hDx]; abel
      rw [e]
      exact Submodule.add_mem_sup h2 (Submodule.add_mem _ h1 h3)
    haveI : Algebra.EssFiniteType R A := Algebra.EssFiniteType.of_finiteType R A
    haveI : Module.Finite A Ω[A⁄R] := KaehlerDifferential.finite R A
    have hle : (⊤ : Submodule A Ω[A⁄R]) ≤ N ⊔ I • (⊤ : Submodule A Ω[A⁄R]) := by
      intro m _
      have hm : m ∈ Submodule.span A (Set.range (KaehlerDifferential.D R A)) := by
        rw [KaehlerDifferential.span_range_derivation]; exact Submodule.mem_top
      refine Submodule.span_le.mpr ?_ hm
      rintro _ ⟨a, rfl⟩
      exact hb a
    obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup
      (Module.finite_def.mp inferInstance) le_rfl hle
    refine ⟨r, ?_, fun m => hr (Submodule.smul_mem_pointwise_smul m r ⊤ Submodule.mem_top)⟩
    have : ε (r - 1) = 0 := hr1
    rw [map_sub, map_one, sub_eq_zero] at this
    exact this

  have s3 : ∀ (R A : Type u) [CommRing R] [CommRing A] [Algebra R A] [Nontrivial A] (c : ℕ), RingHom.IsStandardSmoothOfRelativeDimension c (algebraMap R A) → ∀ {ι : Type u} [Fintype ι], Fintype.card ι = c → ∀ h : ι → A, Submodule.span A (Set.range fun j => KaehlerDifferential.D R A (h j)) = ⊤ → RingHom.Etale (MvPolynomial.eval₂Hom (algebraMap R A) h) := by
    intro R A _ _ _ _ c hstd ι _ hcard h hspan
    haveI : Algebra.IsStandardSmoothOfRelativeDimension c R A :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap c).mp hstd
    haveI : Algebra.IsStandardSmooth R A :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth c
    let P := MvPolynomial ι R
    letI : Algebra P A := (MvPolynomial.eval₂Hom (algebraMap R A) h).toAlgebra
    haveI : IsScalarTower R P A := IsScalarTower.of_algebraMap_eq (fun x => by
      change algebraMap R A x = MvPolynomial.eval₂Hom (algebraMap R A) h (MvPolynomial.C x)
      rw [MvPolynomial.eval₂Hom_C])
    have hmapD : ∀ j, KaehlerDifferential.mapBaseChange R P A
        (1 ⊗ₜ KaehlerDifferential.D R P (MvPolynomial.X j)) = KaehlerDifferential.D R A (h j) := by
      intro j
      rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
      congr 1
      change MvPolynomial.eval₂Hom (algebraMap R A) h (MvPolynomial.X j) = h j
      exact MvPolynomial.eval₂Hom_X' _ _ _
    have hrange : LinearMap.range (KaehlerDifferential.mapBaseChange R P A) = ⊤ := by
      rw [eq_top_iff, ← hspan, Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      exact ⟨_, hmapD j⟩
    have hsurjB : Function.Surjective (KaehlerDifferential.mapBaseChange R P A) :=
      LinearMap.range_eq_top.mp hrange
    haveI hsub : Subsingleton Ω[A⁄P] := by
      constructor
      intro x y
      obtain ⟨x', rfl⟩ := KaehlerDifferential.map_surjective R P A x
      obtain ⟨y', rfl⟩ := KaehlerDifferential.map_surjective R P A y
      have hx : KaehlerDifferential.map R P A A x' = 0 := by
        obtain ⟨t, rfl⟩ := hsurjB x'
        exact (KaehlerDifferential.exact_mapBaseChange_map R P A).apply_apply_eq_zero t
      have hy : KaehlerDifferential.map R P A A y' = 0 := by
        obtain ⟨t, rfl⟩ := hsurjB y'
        exact (KaehlerDifferential.exact_mapBaseChange_map R P A).apply_apply_eq_zero t
      rw [hx, hy]
    haveI hunr : Algebra.FormallyUnramified P A := Algebra.FormallyUnramified.mk hsub
    haveI : Module.Free A Ω[A⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    haveI : Algebra.EssFiniteType R A := Algebra.EssFiniteType.of_finiteType R A
    haveI : Module.Finite A Ω[A⁄R] := KaehlerDifferential.finite R A
    have hfr : Module.finrank A Ω[A⁄R] = c :=
      Module.finrank_eq_of_rank_eq
        (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential c)
    let b2 : Module.Basis (Fin c) A Ω[A⁄R] := Module.finBasisOfFinrankEq A Ω[A⁄R] hfr
    let b1 : Module.Basis ι A (TensorProduct P A Ω[P⁄R]) :=
      (KaehlerDifferential.mvPolynomialBasis R ι).baseChange A
    let e : ι ≃ Fin c := Fintype.equivFinOfCardEq hcard
    let L : Ω[A⁄R] ≃ₗ[A] TensorProduct P A Ω[P⁄R] := b2.equiv b1 e.symm
    haveI : Module.Finite A (TensorProduct P A Ω[P⁄R]) := Module.Finite.of_basis b1
    have hinjB : Function.Injective (KaehlerDifferential.mapBaseChange R P A) := by
      have hs : Function.Surjective (L.toLinearMap ∘ₗ KaehlerDifferential.mapBaseChange R P A) :=
        L.surjective.comp hsurjB
      have hi := OrzechProperty.injective_of_surjective_endomorphism _ hs
      intro x y hxy
      exact hi (by simp only [LinearMap.coe_comp, Function.comp_apply, hxy])
    have hδinj : Function.Injective (Algebra.H1Cotangent.δ R P A) := by
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro x hx
      obtain ⟨y, hy⟩ := ((Algebra.H1Cotangent.exact_map_δ R P A) x).mp hx
      rw [← hy, Subsingleton.elim y 0, map_zero]
      exact Submodule.zero_mem _
    haveI hH1 : Subsingleton (Algebra.H1Cotangent P A) := by
      constructor
      intro x y
      have hx : Algebra.H1Cotangent.δ R P A x = 0 :=
        hinjB ((Algebra.H1Cotangent.exact_δ_mapBaseChange R P A).apply_apply_eq_zero x |>.trans
          (map_zero _).symm)
      have hy : Algebra.H1Cotangent.δ R P A y = 0 :=
        hinjB ((Algebra.H1Cotangent.exact_δ_mapBaseChange R P A).apply_apply_eq_zero y |>.trans
          (map_zero _).symm)
      exact hδinj (hx.trans hy.symm)
    haveI : Module.Projective A Ω[A⁄P] := Module.Projective.of_free
    haveI hsm : Algebra.FormallySmooth P A := Algebra.FormallySmooth.mk inferInstance hH1
    haveI : Algebra.FormallyEtale P A :=
      Algebra.FormallyEtale.iff_formallyUnramified_and_formallySmooth.mpr ⟨hunr, hsm⟩
    haveI : Algebra.FinitePresentation P A :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R P A
    haveI : Algebra.Etale P A := Algebra.Etale.mk
    exact RingHom.etale_algebraMap.mpr inferInstance

  have s4 : ∀ (R A A₁ : Type u) [CommRing R] [CommRing A] [CommRing A₁] [Algebra R A] [Algebra A A₁] [Algebra R A₁] [IsScalarTower R A A₁] (g : A) [IsLocalization.Away g A₁] {ι : Type u} (h : ι → A) (r : A), r ∣ g → (∀ m : Ω[A⁄R], r • m ∈ Submodule.span A (Set.range fun j => KaehlerDifferential.D R A (h j))) → Submodule.span A₁ (Set.range fun j => KaehlerDifferential.D R A₁ (algebraMap A A₁ (h j))) = ⊤ := by
    intro R A A₁ _ _ _ _ _ _ _ g _ ι h r hrg hr
    set N₁ := Submodule.span A₁ (Set.range fun j => KaehlerDifferential.D R A₁ (algebraMap A A₁ (h j)))
      with hN₁
    have hgu : IsUnit (algebraMap A A₁ g) := IsLocalization.Away.algebraMap_isUnit g
    have hru : IsUnit (algebraMap A A₁ r) := by
      obtain ⟨t, rfl⟩ := hrg
      rw [map_mul] at hgu
      exact isUnit_of_mul_isUnit_left hgu
    have hsmul : ∀ (a : A) (y : Ω[A₁⁄R]), a • y = algebraMap A A₁ a • y :=
      fun a y => (algebraMap_smul A₁ a y).symm
    have hle : Submodule.span A (Set.range fun j => KaehlerDifferential.D R A (h j)) ≤
        (N₁.restrictScalars A).comap (KaehlerDifferential.map R R A A₁) := by
      rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      simp only [SetLike.mem_coe, Submodule.mem_comap, Submodule.restrictScalars_mem]
      rw [KaehlerDifferential.map_D]
      exact Submodule.subset_span ⟨j, rfl⟩
    have hμ : ∀ m : Ω[A⁄R], KaehlerDifferential.map R R A A₁ m ∈ N₁ := by
      intro m
      have h1 := hle (hr m)
      simp only [Submodule.mem_comap, Submodule.restrictScalars_mem, map_smul] at h1
      rw [hsmul] at h1
      exact (Submodule.smul_mem_iff_of_isUnit N₁ hru).mp h1
    rw [eq_top_iff]
    intro x _
    obtain ⟨⟨m, s⟩, hs⟩ := IsLocalizedModule.surj (Submonoid.powers g)
      (KaehlerDifferential.map R R A A₁) x
    have hs' : (s : A) • x = KaehlerDifferential.map R R A A₁ m := hs
    have hsu : IsUnit (algebraMap A A₁ (s : A)) := by
      obtain ⟨n, hn⟩ := s.2
      rw [← hn, map_pow]; exact hgu.pow n
    rw [← Submodule.smul_mem_iff_of_isUnit N₁ hsu, ← hsmul, hs']
    exact hμ m

  have s5 : ∀ (R A : Type u) [CommRing R] [CommRing A] (σ : R →+* A) (c : ℕ) (g₀ r : A) (A₀ : Type u) [CommRing A₀] [Algebra A A₀] [IsLocalization.Away g₀ A₀] (A₁ : Type u) [CommRing A₁] [Algebra A A₁] [IsLocalization.Away (g₀ * r) A₁], RingHom.IsStandardSmoothOfRelativeDimension c ((algebraMap A A₀).comp σ) → RingHom.IsStandardSmoothOfRelativeDimension c ((algebraMap A A₁).comp σ) := by
    intro R A _ _ σ c g₀ r A₀ _ _ _ A₁ _ _ _ hstd
    let L := Localization.Away (algebraMap A A₀ r)
    haveI : IsLocalization.Away (g₀ * r) L := IsLocalization.Away.mul' A₀ L g₀ r
    let e : L ≃ₐ[A] A₁ := IsLocalization.algEquiv (Submonoid.powers (g₀ * r)) L A₁
    have h1 : RingHom.IsStandardSmoothOfRelativeDimension (0 + c)
        ((algebraMap A₀ L).comp ((algebraMap A A₀).comp σ)) :=
      (RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
        (algebraMap A A₀ r)).comp hstd
    rw [zero_add] at h1
    have h2 := RingHom.isStandardSmoothOfRelativeDimension_respectsIso.1 _ e.toRingEquiv h1
    convert h2 using 1
    ext x
    change algebraMap A A₁ (σ x) = e (algebraMap A₀ L (algebraMap A A₀ (σ x)))
    rw [← IsScalarTower.algebraMap_apply, AlgEquiv.commutes]

  have s6 : ∀ {W S : Scheme.{u}} [IsAffine W] [IsAffine S] (fW : W ⟶ S) {ι : Type u} (h : ι → Γ(W, ⊤)) (g : Γ(W, ⊤)), RingHom.Etale ((algebraMap Γ(W, ⊤) Γ(W, W.basicOpen g)).comp (MvPolynomial.eval₂Hom fW.appTop.hom h)) → Etale ((W.basicOpen g).ι ≫ AffineSpace.homOfVector fW h) := by
    intro W S _ _ fW ι h g hE
    rw [HasRingHomProperty.iff_of_isAffine (P := @Etale), Scheme.Hom.comp_appTop,
      CommRingCat.hom_comp]
    set ψ : MvPolynomial ι Γ(S, ⊤) →+* Γ(AffineSpace ι S, ⊤) :=
      MvPolynomial.eval₂Hom (AffineSpace ι S ↘ S).appTop.hom (AffineSpace.coord S) with hψ
    have hiso : IsIso (CommRingCat.ofHom ψ) := by
      have h1 := AffineSpace.isoOfIsAffine_hom_appTop (n := ι) S
      haveI : IsIso (Scheme.Hom.appTop (AffineSpace.isoOfIsAffine ι S).hom) :=
        (Scheme.Γ.mapIso (AffineSpace.isoOfIsAffine ι S).op).isIso_hom
      have : IsIso ((Scheme.ΓSpecIso (CommRingCat.of (MvPolynomial ι Γ(S, ⊤)))).hom ≫
          CommRingCat.ofHom ψ) := by
        rw [← h1]; infer_instance
      exact IsIso.of_isIso_comp_left (Scheme.ΓSpecIso _).hom _
    have hbij : Function.Bijective ψ := ConcreteCategory.bijective_of_isIso (CommRingCat.ofHom ψ)
    let e : MvPolynomial ι Γ(S, ⊤) ≃+* Γ(AffineSpace ι S, ⊤) := RingEquiv.ofBijective ψ hbij
    let t : Γ(W, W.basicOpen g) ≃+* Γ(W.basicOpen g, ⊤) :=
      ((W.basicOpen g).topIso.symm).commRingCatIsoToRingEquiv
    have hπ : ∀ r, (AffineSpace.homOfVector fW h).appTop.hom ((AffineSpace ι S ↘ S).appTop.hom r) =
        fW.appTop.hom r := by
      intro r
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, AffineSpace.homOfVector_over]
    have hmor : (W.basicOpen g).ι.appTop ≫ (W.basicOpen g).topIso.hom =
        W.presheaf.map (homOfLE le_top : W.basicOpen g ⟶ ⊤).op := by
      first
        | (erw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom, ← Functor.map_comp]; rfl)
        | (rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom, ← Functor.map_comp]; rfl)
    have hι : ∀ x, (W.basicOpen g).ι.appTop.hom x =
        t (algebraMap Γ(W, ⊤) Γ(W, W.basicOpen g) x) := by
      intro x
      apply (W.basicOpen g).topIso.commRingCatIsoToRingEquiv.injective
      change (W.basicOpen g).topIso.hom ((W.basicOpen g).ι.appTop x) =
        (W.basicOpen g).topIso.hom ((W.basicOpen g).topIso.inv (W.presheaf.map (homOfLE le_top).op x))
      rw [← CommRingCat.comp_apply (W.basicOpen g).topIso.inv, Iso.inv_hom_id, CommRingCat.id_apply,
        ← CommRingCat.comp_apply, hmor]
    have hcomp : (((W.basicOpen g).ι.appTop.hom).comp
        (AffineSpace.homOfVector fW h).appTop.hom).comp ψ
        = (t.toRingHom.comp (algebraMap Γ(W, ⊤) Γ(W, W.basicOpen g))).comp
          (MvPolynomial.eval₂Hom fW.appTop.hom h) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [hψ, RingHom.coe_comp, Function.comp_apply, MvPolynomial.eval₂Hom_C]
        rw [hπ, hι]; rfl
      · intro i
        simp only [hψ, RingHom.coe_comp, Function.comp_apply, MvPolynomial.eval₂Hom_X']
        rw [AffineSpace.homOfVector_appTop_coord, hι]; rfl
    have h1 := RingHom.Etale.respectsIso.1 _ t hE
    rw [← RingHom.comp_assoc] at h1
    have h2 := RingHom.Etale.respectsIso.2 _ e.symm h1
    rw [← hcomp] at h2
    convert h2 using 1
    ext x
    simp only [RingHom.coe_comp, Function.comp_apply]
    congr 2
    exact (e.apply_symm_apply x).symm

  have fib_iso : ∀ {V B : Scheme.{u}} (φ : V ⟶ B) [Etale φ] (v : V), ∃ U : V.Opens, v ∈ U ∧ ∀ w ∈ U, φ w = φ v → w = v := by
    intro V B φ _ v
    haveI hlqf : LocallyQuasiFinite φ := by
      rw [HasRingHomProperty.iff_appLE (P := @LocallyQuasiFinite)]
      intro U W e
      have h := HasRingHomProperty.appLE @Etale φ ‹Etale φ› U W e
      letI := (φ.appLE U W e).hom.toAlgebra
      haveI : Algebra.Etale _ _ := RingHom.Etale.toAlgebra h
      exact RingHom.quasiFinite_algebraMap.mpr inferInstance
    haveI hd : DiscreteTopology ↑(φ ⁻¹' {φ v}) := (φ.fiberHomeo (φ v)).discreteTopology
    have hv : φ v ∈ ({φ v} : Set B) := Set.mem_singleton _
    have hopen : IsOpen ({⟨v, hv⟩} : Set ↑(φ ⁻¹' {φ v})) := isOpen_discrete _
    obtain ⟨t, ht, hteq⟩ := isOpen_induced_iff.mp hopen
    refine ⟨⟨t, ht⟩, ?_, ?_⟩
    · have : (⟨v, hv⟩ : ↑(φ ⁻¹' {φ v})) ∈ Subtype.val ⁻¹' t := by
        rw [hteq]; exact Set.mem_singleton _
      exact this
    · intro w hwU hw
      have hw' : w ∈ φ ⁻¹' {φ v} := by
        simp only [Set.mem_preimage, Set.mem_singleton_iff]; exact hw
      have : (⟨w, hw'⟩ : ↑(φ ⁻¹' {φ v})) ∈ Subtype.val ⁻¹' t := hwU
      rw [hteq, Set.mem_singleton_iff] at this
      exact congrArg Subtype.val this
  have lift_pt : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {V U : Scheme.{u}} (g : V ⟶ U) [Etale g]
      (s : Spec (.of Ω) ⟶ U) (v : V), g v = s (IsLocalRing.closedPoint Ω) →
      ∃ t : Spec (.of Ω) ⟶ V, t ≫ g = s ∧ t (IsLocalRing.closedPoint Ω) = v := by
    intro Ω _ _ V U g _ s v hv
    have hs : s = Spec.map (Scheme.SpecToEquivOfField Ω U s).2 ≫
        U.fromSpecResidueField (Scheme.SpecToEquivOfField Ω U s).1 := by
      rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]
    have h1 : (Scheme.SpecToEquivOfField Ω U s).1 = s (IsLocalRing.closedPoint Ω) := rfl
    generalize Scheme.SpecToEquivOfField Ω U s = p at hs h1
    obtain ⟨u, φ⟩ := p
    simp only at hs h1
    rw [← h1] at hv
    subst hv
    letI : Algebra (U.residueField (g v)) (V.residueField v) := (g.residueFieldMap v).hom.toAlgebra
    haveI : Algebra.IsSeparable (U.residueField (g v)) (V.residueField v) := inferInstance
    haveI : Algebra.IsAlgebraic (U.residueField (g v)) (V.residueField v) :=
      Algebra.IsSeparable.isAlgebraic _ _
    letI : Algebra (U.residueField (g v)) Ω := φ.hom.toAlgebra
    let χ₀ : V.residueField v →ₐ[U.residueField (g v)] Ω :=
      IsAlgClosed.lift (R := U.residueField (g v)) (S := V.residueField v) (M := Ω)
    let χ : V.residueField v ⟶ CommRingCat.of Ω := CommRingCat.ofHom χ₀.toRingHom
    have hχ : g.residueFieldMap v ≫ χ = φ := by
      ext r
      exact χ₀.commutes r
    have key : ∀ x : Spec (.of Ω), (Spec.map χ ≫ V.fromSpecResidueField v) x = v := by
      intro x
      rw [Scheme.Hom.comp_apply]
      exact Scheme.fromSpecResidueField_apply _ _
    refine ⟨Spec.map χ ≫ V.fromSpecResidueField v, ?_, key _⟩
    rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
      ← Category.assoc, ← Spec.map_comp, hχ, hs]
  have sec_open : ∀ {Y P E : Scheme.{u}} (π : P ⟶ E) [Etale π] (j : Y ⟶ E) [IsOpenImmersion j] (σ : Y ⟶ P), σ ≫ π = j → IsOpenImmersion σ := by
    intro Y P E π _ j _ σ h
    haveI : IsOpenImmersion (σ ≫ π) := by rw [h]; infer_instance
    haveI hL : IsOpenImmersion (Limits.pullback.lift (𝟙 Y) σ (by simp) :
        Y ⟶ Limits.pullback (σ ≫ π) π) :=
      MorphismProperty.of_isPullback (P := @IsOpenImmersion)
        (Limits.pullback_lift_diagonal_isPullback σ π)
        (FormallyUnramified.isOpenImmersion_diagonal π)
    have e : (Limits.pullback.lift (𝟙 Y) σ (by simp) : Y ⟶ Limits.pullback (σ ≫ π) π) ≫
        Limits.pullback.snd (σ ≫ π) π = σ := Limits.pullback.lift_snd _ _ _
    rw [← e]
    infer_instance

  have s7 : ∀ (K : Type u) [Field K] [IsAlgClosed K] {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (i : Z ⟶ W) [IsClosedImmersion i], SmoothOfRelativeDimension 0 (i ≫ fW) → ∀ (z : Z) (V : W.Opens), i z ∈ V → ∃ V' : W.Opens, V' ≤ V ∧ i z ∈ V' ∧ IsIso ((i ⁻¹ᵁ V').ι ≫ i ≫ fW) := by
    intro K _ _ W Z fW i _ hsm0 z V hzV
    haveI het : Etale (i ≫ fW) := (Etale.iff_smoothOfRelativeDimension_zero _).mpr hsm0
    obtain ⟨U, hzU, hU⟩ := fib_iso (i ≫ fW) z
    have hall : ∀ x ∈ U, x = z := fun x hx => hU x hx (Subsingleton.elim _ _)
    haveI hUoi : IsOpenImmersion U.ι := Scheme.Opens.instIsOpenImmersionι U
    haveI hUet : Etale U.ι := @Etale.instOfIsOpenImmersion _ _ U.ι hUoi
    haveI hUqet : Etale (U.ι ≫ i ≫ fW) := Etale.etale_comp U.ι (i ≫ fW)
    obtain ⟨t, ht, -⟩ := lift_pt K (U.ι ≫ i ≫ fW) (𝟙 _) ⟨z, hzU⟩ (Subsingleton.elim _ _)
    haveI hidoi : IsOpenImmersion (𝟙 (Spec (.of K))) := IsOpenImmersion.of_isIso _
    haveI : IsOpenImmersion t := @sec_open _ _ _ (U.ι ≫ i ≫ fW) hUqet (𝟙 _) hidoi t ht
    have hsurj : Surjective t := by
      constructor
      intro u
      refine ⟨IsLocalRing.closedPoint K, ?_⟩
      apply Subtype.ext
      rw [hall u.1 u.2, hall _ (t (IsLocalRing.closedPoint K)).2]
    haveI : IsIso t := (isIso_iff_isOpenImmersion_and_surjective t).mpr ⟨inferInstance, hsurj⟩
    haveI hUiso : IsIso (U.ι ≫ i ≫ fW) := IsIso.of_isIso_fac_left ht
    have hcl : IsClosed (i '' (U : Set Z)ᶜ) :=
      (IsClosedImmersion.isClosedEmbedding i).isClosedMap _ U.isOpen.isClosed_compl
    have hinj : Function.Injective i := (IsClosedImmersion.isClosedEmbedding i).injective
    let O : W.Opens := ⟨(i '' (U : Set Z)ᶜ)ᶜ, hcl.isOpen_compl⟩
    refine ⟨V ⊓ O, inf_le_left, ⟨hzV, ?_⟩, ?_⟩
    · rintro ⟨y, hy, hyz⟩
      exact hy (hinj hyz ▸ hzU)
    have heq : i ⁻¹ᵁ (V ⊓ O) = U := by
      ext x
      change (i x ∈ V ∧ i x ∈ O) ↔ x ∈ U
      constructor
      · rintro ⟨-, hx⟩
        by_contra hxU
        exact hx ⟨x, hxU, rfl⟩
      · intro hx
        refine ⟨?_, ?_⟩
        · rw [hall x hx]; exact hzV
        · rintro ⟨y, hy, hyx⟩
          exact hy (hinj hyx ▸ hx)
    rw [← Scheme.isoOfEq_hom_ι Z heq, Category.assoc]
    infer_instance

  intro K _ _ W Z fW i c h hsm hsm0 hc z
  obtain ⟨hWaff, hi, hker⟩ := hc
  haveI := hWaff
  haveI := hi
  obtain ⟨hZaff, hsurj⟩ := IsClosedImmersion.isAffine_surjective_of_isAffine i
  haveI := hZaff
  have het : Etale (i ≫ fW) := (Etale.iff_smoothOfRelativeDimension_zero _).mpr hsm0
  have hEt : RingHom.Etale ((i ≫ fW).appTop.hom) := HasRingHomProperty.appTop @Etale _ het
  have hunr : (i.appTop.hom.comp fW.appTop.hom).FormallyUnramified := by
    have e : (i ≫ fW).appTop.hom = i.appTop.hom.comp fW.appTop.hom := by
      rw [Scheme.Hom.comp_appTop]; rfl
    rw [← e]; exact hEt.formallyUnramified
  haveI := hsm
  haveI hsmfW : Smooth fW := SmoothOfRelativeDimension.smooth c fW
  haveI hlfp : LocallyOfFinitePresentation fW := @instLocallyOfFinitePresentationOfSmooth _ _ fW hsmfW
  haveI hlft : LocallyOfFiniteType fW :=
    @instLocallyOfFiniteTypeOfLocallyOfFinitePresentation _ _ fW hlfp
  have hft : fW.appTop.hom.FiniteType :=
    HasRingHomProperty.appTop @LocallyOfFiniteType fW hlft
  letI : Algebra Γ(Spec (.of K), ⊤) Γ(W, ⊤) := fW.appTop.hom.toAlgebra
  haveI : Algebra.FiniteType Γ(Spec (.of K), ⊤) Γ(W, ⊤) := RingHom.finiteType_algebraMap.mp hft
  let h' : ULift.{u} (Fin c) → Γ(W, ⊤) := fun j => h j.down
  have hrange : Set.range h' = Set.range h := ULift.down_surjective.range_comp h
  obtain ⟨r, hr1, hr⟩ := s2 Γ(Spec (.of K), ⊤) Γ(W, ⊤) Γ(Z, ⊤) h'
    i.appTop.hom hsurj (by rw [hrange]; exact hker) hunr
  have hwr : i z ∈ W.basicOpen r := by
    have : z ∈ i ⁻¹ᵁ W.basicOpen r := by
      rw [Scheme.preimage_basicOpen_top]
      change z ∈ Z.basicOpen (i.appTop.hom r)
      rw [hr1, Scheme.basicOpen_of_isUnit _ isUnit_one]
      trivial
    exact this
  obtain ⟨g₀, hwg₀, hstd₀⟩ := s1 K fW c hsm (i z)
  have hwg : i z ∈ W.basicOpen (g₀ * r) := by
    rw [Scheme.basicOpen_mul]; exact ⟨hwg₀, hwr⟩
  haveI : IsLocalization.Away g₀ Γ(W, W.basicOpen g₀) :=
    (isAffineOpen_top W).isLocalization_basicOpen g₀
  haveI : IsLocalization.Away (g₀ * r) Γ(W, W.basicOpen (g₀ * r)) :=
    (isAffineOpen_top W).isLocalization_basicOpen (g₀ * r)
  have hstd₁ := s5 Γ(Spec (.of K), ⊤) Γ(W, ⊤) fW.appTop.hom c g₀ r
    Γ(W, W.basicOpen g₀) Γ(W, W.basicOpen (g₀ * r)) hstd₀
  haveI : Nonempty (W.basicOpen (g₀ * r)) := ⟨⟨i z, hwg⟩⟩
  haveI : Nontrivial Γ(W, W.basicOpen (g₀ * r)) := Scheme.component_nontrivial W _
  letI : Algebra Γ(Spec (.of K), ⊤) Γ(W, W.basicOpen (g₀ * r)) :=
    ((algebraMap Γ(W, ⊤) Γ(W, W.basicOpen (g₀ * r))).comp fW.appTop.hom).toAlgebra
  haveI : IsScalarTower Γ(Spec (.of K), ⊤) Γ(W, ⊤) Γ(W, W.basicOpen (g₀ * r)) :=
    IsScalarTower.of_algebraMap_eq' rfl
  have hspan := s4 Γ(Spec (.of K), ⊤) Γ(W, ⊤)
    Γ(W, W.basicOpen (g₀ * r)) (g₀ * r) h' r (Dvd.intro_left g₀ rfl) hr
  have hEt₁ := s3 Γ(Spec (.of K), ⊤) Γ(W, W.basicOpen (g₀ * r)) c
    hstd₁ (by simp) _ hspan
  have hEt₂ : RingHom.Etale ((algebraMap Γ(W, ⊤) Γ(W, W.basicOpen (g₀ * r))).comp
      (MvPolynomial.eval₂Hom fW.appTop.hom h')) := by
    rw [MvPolynomial.comp_eval₂Hom]; exact hEt₁
  have hEtD := s6 fW h' (g₀ * r) hEt₂
  obtain ⟨V', hle, hzV', hiso⟩ := s7 K fW i hsm0 z _ hwg
  refine ⟨V', hzV', ?_, hiso⟩
  haveI := hEtD
  rw [← Scheme.homOfLE_ι W hle, Category.assoc]
  haveI hHet : Etale (W.homOfLE hle) :=
    @Etale.instOfIsOpenImmersion _ _ (W.homOfLE hle) (instIsOpenImmersionHomOfLE W hle)
  exact Etale.etale_comp (W.homOfLE hle) _

theorem wc_et_open_restr_ker_corep : ∀ {X Z U : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (j : U ⟶ X) [IsOpenImmersion j], Set.range j = (Set.range i)ᶜ → ∀ (n : ℕ), 0 < n → ∀ (D : wcEtPullData i n) (Dj : wcEtPullData j n) (Y : SheafOfModules.{u+1} (wcEtZModRing X n)), Function.Bijective (fun f : Limits.kernel (wcEtSuppUnitMap D) ⟶ Y => 𝟙 (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))) ≫ Dj.Φ.map f) :=
by
  classical
  intro X Z U i _ j _ hc n _ D Dj Y
  let T : X.Etale := MorphismProperty.Over.mk ⊤ j (inferInstance : Etale j)
  haveI hcT : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology X) := (wc_et_slice_continuous T).1
  obtain ⟨ψ, ⟨e⟩⟩ := wc_et_etale_pull_restrict_iso T n Dj
  haveI : Mono j := IsOpenImmersion.mono j

  have hM : ∀ (W : X.Etale) (lam lam' : W.left ⟶ T.left), lam ≫ T.hom = W.hom →
      lam' ≫ T.hom = W.hom → lam = lam' := by
    intro W lam lam' h1 h2
    exact (cancel_mono j).1 (h1.trans h2.symm)
  have mc : ∀ (F : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {A B C : X.Etale} (f : A ⟶ B) (h : B ⟶ C)
      (x : ↑(F.obj (Opposite.op C))), F.map (f ≫ h).op x = F.map f.op (F.map h.op x) := by
    intro F A B C f h x
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl
  have mi : ∀ (F : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {A : X.Etale}
      (x : ↑(F.obj (Opposite.op A))), F.map (𝟙 A).op x = x := by
    intro F A x
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  have hHK : ∀ (W : X.Etale)
      (s : ↑((Limits.kernel (wcEtSuppUnitMap D)).val.presheaf.obj (Opposite.op W))),
      ∃ S ∈ Scheme.smallEtaleTopology X W, ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g →
        (Limits.kernel (wcEtSuppUnitMap D)).val.presheaf.map g.op s = 0 ∨
          ∃ lam : W'.left ⟶ T.left, lam ≫ T.hom = W'.hom := by
    intro W s
    refine ⟨_, wc_et_supp_unit_ker_suppIn i n D W s, ?_⟩
    rintro W' g ⟨V'', h, g0, hPr, rfl⟩
    rcases hPr with h0 | hfree
    · left
      have h0' : (Limits.kernel (wcEtSuppUnitMap D)).val.presheaf.map g0.op s = 0 := h0
      rw [mc _ h g0, h0', map_zero]
    · right
      have hsub : Set.range V''.hom ⊆ Set.range j := by
        rintro _ ⟨x, rfl⟩
        rw [hc]
        exact hfree x
      obtain ⟨l, hl⟩ : ∃ l : V''.left ⟶ U, l ≫ j = V''.hom :=
        ⟨_, @IsOpenImmersion.lift_fac _ _ _ j V''.hom ‹IsOpenImmersion j› hsub⟩
      refine ⟨(h.left ≫ l : W'.left ⟶ U), ?_⟩
      show (h.left ≫ l) ≫ j = W'.hom
      rw [Category.assoc, hl]
      exact MorphismProperty.Over.w h
  revert hHK
  generalize Limits.kernel (wcEtSuppUnitMap D) = K
  intro hHK

  have hfac : ∀ (V : X.Etale) (lam : V.left ⟶ T.left), lam ≫ T.hom = V.hom →
      ∃ (U0 : T.left.Etale) (e : (wcEtSlice T).obj U0 ≅ V), ∀ (U' : T.left.Etale)
        (k : V ⟶ (wcEtSlice T).obj U'), ∃ b : U0 ⟶ U', k = e.inv ≫ (wcEtSlice T).map b := by
    intro V lam hlam
    have hEt : Etale lam :=
      MorphismProperty.of_postcomp @Etale lam T.hom T.prop (by rw [hlam]; exact V.prop)
    refine ⟨MorphismProperty.Over.mk ⊤ lam hEt,
      MorphismProperty.Over.isoMk (Iso.refl V.left) ((Category.id_comp _).trans hlam.symm), ?_⟩
    intro U' k
    have hk : k.left ≫ U'.hom = lam :=
      hM V _ _ ((Category.assoc _ _ _).trans (MorphismProperty.Over.w k)) hlam
    refine ⟨MorphismProperty.Over.homMk k.left hk trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact (Category.id_comp _).symm

  have key : ∀ (P Q : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Presheaf.IsSheaf (Scheme.smallEtaleTopology X) Q →
      ∀ (θ : ∀ U : T.left.Etale, ↑(P.obj (Opposite.op ((wcEtSlice T).obj U))) →+
          ↑(Q.obj (Opposite.op ((wcEtSlice T).obj U)))),
      (∀ (W : X.Etale) (s : ↑(P.obj (Opposite.op W))), ∃ S ∈ Scheme.smallEtaleTopology X W,
        ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g →
          P.map g.op s = 0 ∨ ∃ lam : W'.left ⟶ T.left, lam ≫ T.hom = W'.hom) →
      (∀ (U U' : T.left.Etale) (b : U' ⟶ U) (x : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U)))),
        Q.map ((wcEtSlice T).map b).op (θ U x) = θ U' (P.map ((wcEtSlice T).map b).op x)) →
      ∃ φ : P ⟶ Q, ∀ (U : T.left.Etale) (x : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U)))),
        φ.app (Opposite.op ((wcEtSlice T).obj U)) x = θ U x := by
    intro P Q hQ θ hHP hnat
    have hzero : ∀ (U : T.left.Etale) (V : X.Etale) (k : V ⟶ (wcEtSlice T).obj U)
        (x : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U)))), P.map k.op x = 0 →
        Q.map k.op (θ U x) = 0 := by
      intro U V k x hx
      have hlam : (k.left ≫ U.hom) ≫ T.hom = V.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w k)
      obtain ⟨U₀, e, he⟩ := hfac V _ hlam
      obtain ⟨b, hb⟩ := he U k
      have hb' : (wcEtSlice T).map b = e.hom ≫ k := by rw [hb, Iso.hom_inv_id_assoc]
      rw [hb, mc Q e.inv ((wcEtSlice T).map b), hnat U U₀ b x, hb', mc P e.hom k, hx,
        map_zero, map_zero, map_zero]
    have hcompat : ∀ (V : X.Etale) (U₁ U₂ : T.left.Etale) (j₁ : V ⟶ (wcEtSlice T).obj U₁)
        (j₂ : V ⟶ (wcEtSlice T).obj U₂) (x₁ : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U₁))))
        (x₂ : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U₂)))),
        P.map j₁.op x₁ = P.map j₂.op x₂ → Q.map j₁.op (θ U₁ x₁) = Q.map j₂.op (θ U₂ x₂) := by
      intro V U₁ U₂ j₁ j₂ x₁ x₂ hx
      have h₁ : (j₁.left ≫ U₁.hom) ≫ T.hom = V.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w j₁)
      obtain ⟨U, e, he⟩ := hfac V _ h₁
      obtain ⟨b₁, hb₁⟩ := he U₁ j₁
      obtain ⟨b₂, hb₂⟩ := he U₂ j₂
      have hb₁' : (wcEtSlice T).map b₁ = e.hom ≫ j₁ := by rw [hb₁, Iso.hom_inv_id_assoc]
      have hb₂' : (wcEtSlice T).map b₂ = e.hom ≫ j₂ := by rw [hb₂, Iso.hom_inv_id_assoc]
      rw [hb₁, hb₂, mc Q e.inv ((wcEtSlice T).map b₁), mc Q e.inv ((wcEtSlice T).map b₂),
        hnat U₁ U b₁ x₁, hnat U₂ U b₂ x₂, hb₁', hb₂', mc P e.hom j₁, mc P e.hom j₂, hx]
    obtain ⟨Good, hGood⟩ : ∃ Good : ∀ W : X.Etale, ↑(P.obj (Opposite.op W)) →
        ↑(Q.obj (Opposite.op W)) → Prop, ∀ W s u, Good W s u ↔
          ((∀ (U : T.left.Etale) (k : (wcEtSlice T).obj U ⟶ W), Q.map k.op u = θ U (P.map k.op s)) ∧
            ∀ (V : X.Etale) (k : V ⟶ W), P.map k.op s = 0 → Q.map k.op u = 0) :=
      ⟨_, fun _ _ _ => Iff.rfl⟩
    have huniq : ∀ W s u u', Good W s u → Good W s u' → u = u' := by
      intro W s u u' hu hu'
      rw [hGood] at hu hu'
      obtain ⟨S, hS, hSc⟩ := hHP W s
      refine hQ.isSeparated W S hS u u' ?_
      intro W' g hg
      rcases hSc g hg with h0 | ⟨lam, hlam⟩
      · rw [hu.2 W' g h0, hu'.2 W' g h0]
      · obtain ⟨U, e, -⟩ := hfac W' lam hlam
        rw [← Iso.inv_hom_id_assoc e g, mc Q e.inv (e.hom ≫ g) u, mc Q e.inv (e.hom ≫ g) u',
          hu.1 U (e.hom ≫ g), hu'.1 U (e.hom ≫ g)]
    have hres : ∀ (W W' : X.Etale) (f : W' ⟶ W) s u, Good W s u →
        Good W' (P.map f.op s) (Q.map f.op u) := by
      intro W W' f s u hu
      rw [hGood] at hu ⊢
      refine ⟨fun U k => ?_, fun V k hk => ?_⟩
      · rw [← mc Q k f, ← mc P k f]; exact hu.1 U (k ≫ f)
      · rw [← mc P k f] at hk
        rw [← mc Q k f]; exact hu.2 V (k ≫ f) hk
    have hrg : ∀ (U : T.left.Etale) (x : ↑(P.obj (Opposite.op ((wcEtSlice T).obj U))))
        (V : X.Etale) (h : V ⟶ (wcEtSlice T).obj U),
        Good V (P.map h.op x) (Q.map h.op (θ U x)) := by
      intro U x V h
      rw [hGood]
      refine ⟨fun Ua k => ?_, fun Va k hk => ?_⟩
      · rw [← mc Q k h, ← mc P k h]
        have hc' := hcompat _ U Ua (k ≫ h) (𝟙 _) x (P.map (k ≫ h).op x) (mi P _).symm
        rw [hc', mi Q]
      · rw [← mc P k h] at hk
        rw [← mc Q k h]; exact hzero U Va (k ≫ h) x hk
    have hloc : ∀ (W' : X.Etale) (t : ↑(P.obj (Opposite.op W'))),
        (t = 0 ∨ ∃ lam : W'.left ⟶ T.left, lam ≫ T.hom = W'.hom) → ∃ u, Good W' t u := by
      intro W' t ht
      rcases ht with h0 | ⟨lam, hlam⟩
      · refine ⟨0, ?_⟩
        rw [hGood, h0]
        refine ⟨fun U k => ?_, fun V k _ => ?_⟩
        · simp only [map_zero]
        · simp only [map_zero]
      · obtain ⟨U, e, -⟩ := hfac W' lam hlam
        refine ⟨Q.map e.inv.op (θ U (P.map e.hom.op t)), ?_⟩
        have h := hrg U (P.map e.hom.op t) W' e.inv
        rwa [← mc P e.inv e.hom, Iso.inv_hom_id, mi P] at h
    have hglue : ∀ (W : X.Etale) (s : ↑(P.obj (Opposite.op W))), ∃ u, Good W s u := by
      intro W s
      obtain ⟨S, hS, hSc⟩ := hHP W s
      have hfam : ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W), S.arrows g → ∃ u, Good W' (P.map g.op s) u :=
        fun W' g hg => hloc W' _ (hSc g hg)
      choose u hu using hfam
      have hQt : Presieve.IsSheafFor (Q ⋙ forget AddCommGrpCat.{u+1}) S.arrows :=
        (isSheaf_iff_isSheaf_of_type _ _).mp
          (GrothendieckTopology.HasSheafCompose.isSheaf _ hQ) S hS
      let xf : Presieve.FamilyOfElements (Q ⋙ forget AddCommGrpCat.{u+1}) S.arrows :=
        fun W' g hg => u g hg
      have hx : xf.Compatible := by
        intro W₁ W₂ W₀ g₁ g₂ f₁ f₂ h₁ h₂ hcomm
        have e1 := hres _ _ g₁ _ _ (hu f₁ h₁)
        have e2 := hres _ _ g₂ _ _ (hu f₂ h₂)
        rw [← mc P g₁ f₁, hcomm, mc P g₂ f₂] at e1
        exact huniq _ _ _ _ e1 e2
      obtain ⟨y, hy⟩ : ∃ y : ↑(Q.obj (Opposite.op W)), ∀ ⦃W' : X.Etale⦄ (g : W' ⟶ W)
          (hg : S.arrows g), Q.map g.op y = u g hg :=
        ⟨hQt.amalgamate xf hx, fun W' g hg => hQt.valid_glue hx g hg⟩
      refine ⟨y, ?_⟩
      rw [hGood]
      refine ⟨fun Ua k => ?_, fun Va k hVa => ?_⟩
      · refine hQ.isSeparated _ (S.pullback k)
          ((Scheme.smallEtaleTopology X).pullback_stable k hS) _ _ ?_
        intro V' m hm
        have g1 := hu (m ≫ k) hm
        have g2 := hrg Ua (P.map k.op s) V' m
        rw [← mc P m k] at g2
        rw [← mc Q m k y, hy (m ≫ k) hm]
        exact huniq _ _ _ _ g1 g2
      · refine hQ.isSeparated _ (S.pullback k)
          ((Scheme.smallEtaleTopology X).pullback_stable k hS) _ _ ?_
        intro V' m hm
        have g1 := hu (m ≫ k) hm
        rw [hGood] at g1
        have h0 : P.map (m ≫ k).op s = 0 := by rw [mc P m k, hVa, map_zero]
        have h1 := g1.2 V' (𝟙 V') (by rw [mi P]; exact h0)
        rw [mi Q] at h1
        rw [← mc Q m k y, hy (m ≫ k) hm, h1, map_zero]
    choose φf hφf using hglue
    have hnatφ : ∀ (W W' : X.Etale) (f : W' ⟶ W) (s : ↑(P.obj (Opposite.op W))),
        φf W' (P.map f.op s) = Q.map f.op (φf W s) :=
      fun W W' f s => huniq _ _ _ _ (hφf W' (P.map f.op s)) (hres W W' f s _ (hφf W s))
    have hzeroφ : ∀ W, φf W 0 = 0 := by
      intro W
      apply huniq W 0 _ _ (hφf W 0)
      rw [hGood]
      refine ⟨fun U k => ?_, fun V k _ => ?_⟩
      · simp only [map_zero]
      · simp only [map_zero]
    have hchart : ∀ (W' : X.Etale) (lam : W'.left ⟶ T.left), lam ≫ T.hom = W'.hom →
        ∀ a b : ↑(P.obj (Opposite.op W')), φf W' (a + b) = φf W' a + φf W' b := by
      intro W' lam hlam a b
      obtain ⟨U, e, -⟩ := hfac W' lam hlam
      have key1 : ∀ t, φf W' t = Q.map e.inv.op (θ U (P.map e.hom.op t)) := by
        intro t
        have h1 := ((hGood _ _ _).mp (hφf W' t)).1 U e.hom
        rw [← h1, ← mc Q e.inv e.hom, Iso.inv_hom_id, mi Q]
      rw [key1 (a + b), key1 a, key1 b]
      simp only [map_add]
    have hadd : ∀ W (s s' : ↑(P.obj (Opposite.op W))), φf W (s + s') = φf W s + φf W s' := by
      intro W s s'
      obtain ⟨S₁, hS₁, hSc₁⟩ := hHP W s
      obtain ⟨S₂, hS₂, hSc₂⟩ := hHP W s'
      refine hQ.isSeparated W (S₁ ⊓ S₂)
        ((Scheme.smallEtaleTopology X).intersection_covering hS₁ hS₂) _ _ ?_
      intro W' g hg
      have hg' : S₁.arrows g ∧ S₂.arrows g := hg
      rw [map_add, ← hnatφ W W' g, ← hnatφ W W' g, ← hnatφ W W' g, map_add]
      rcases hSc₁ g hg'.1 with h1 | ⟨lam, hlam⟩
      · rcases hSc₂ g hg'.2 with h2 | ⟨lam, hlam⟩
        · rw [h1, h2, add_zero, hzeroφ, add_zero]
        · exact hchart W' lam hlam _ _
      · exact hchart W' lam hlam _ _
    refine ⟨{ app := fun A => AddCommGrpCat.ofHom (AddMonoidHom.mk' (φf A.unop) (hadd A.unop))
              naturality := ?_ }, ?_⟩
    · intro A B f
      ext s
      exact hnatφ A.unop B.unop f.unop s
    · intro U x
      have h := (hGood _ _ _).mp (hφf ((wcEtSlice T).obj U) x)
      have h1 := h.1 U (𝟙 _)
      rw [mi Q, mi P] at h1
      exact h1

  have hinj : Function.Injective (fun f : K ⟶ Y => (SheafOfModules.pushforward.{u+1} ψ).map f) := by
    intro f f' hff
    have s1 : ∀ (U0 : T.left.Etale) (m : K.val.obj (Opposite.op ((wcEtSlice T).obj U0))),
        f.val.app (Opposite.op ((wcEtSlice T).obj U0)) m =
          f'.val.app (Opposite.op ((wcEtSlice T).obj U0)) m := by
      intro U0 m
      have hff' : (SheafOfModules.pushforward ψ).map f = (SheafOfModules.pushforward ψ).map f' := hff
      have h1 := PresheafOfModules.pushforward_map_app_apply ψ.hom f.val (Opposite.op U0) m
      have h2 := PresheafOfModules.pushforward_map_app_apply ψ.hom f'.val (Opposite.op U0) m
      rw [← SheafOfModules.pushforward_map_val] at h1 h2
      rw [hff'] at h1
      exact h1.symm.trans h2
    have keyI : ∀ (W : X.Etale) (s : K.val.obj (Opposite.op W)),
        f.val.app (Opposite.op W) s = f'.val.app (Opposite.op W) s := by
      intro W s
      obtain ⟨S, hS, hSc⟩ := hHK W s
      refine Presheaf.IsSheaf.isSeparated Y.isSheaf W S hS
        (f.val.app (Opposite.op W) s) (f'.val.app (Opposite.op W) s) ?_
      intro W' g hg
      have e1 := PresheafOfModules.presheaf_map_apply_coe Y.val g.op (f.val.app (Opposite.op W) s)
      have e2 := PresheafOfModules.presheaf_map_apply_coe Y.val g.op (f'.val.app (Opposite.op W) s)
      refine (e1.trans ?_).trans e2.symm
      rcases hSc g hg with h0 | ⟨lam, hlam⟩
      · have h0' : (ConcreteCategory.hom (K.val.map g.op)) s = 0 :=
          (PresheafOfModules.presheaf_map_apply_coe K.val g.op s).symm.trans h0
        have hz : ∀ x : K.val.obj (Opposite.op W'), x = 0 →
            f.val.app (Opposite.op W') x = f'.val.app (Opposite.op W') x := by
          intro x hx
          rw [hx, map_zero, map_zero]
        rw [← PresheafOfModules.naturality_apply, ← PresheafOfModules.naturality_apply]
        exact hz _ h0'
      · have hEt : Etale lam :=
          MorphismProperty.of_postcomp @Etale lam T.hom T.prop (by rw [hlam]; exact W'.prop)
        let U0 : T.left.Etale := MorphismProperty.Over.mk ⊤ lam hEt
        let e : (wcEtSlice T).obj U0 ≅ W' :=
          MorphismProperty.Over.isoMk (Iso.refl W'.left) ((Category.id_comp _).trans hlam.symm)
        have hg' : g = e.inv ≫ (e.hom ≫ g) := (Iso.inv_hom_id_assoc e g).symm
        have h := s1 U0 (K.val.map (e.hom ≫ g).op s)
        rw [PresheafOfModules.naturality_apply, PresheafOfModules.naturality_apply] at h
        rw [hg', op_comp, PresheafOfModules.map_comp_apply, PresheafOfModules.map_comp_apply, h]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro W
    ext s
    exact keyI W.unop s

  have hsurj : Function.Surjective
      (fun f : K ⟶ Y => (SheafOfModules.pushforward.{u+1} ψ).map f) := by
    intro g
    have hQY : Presheaf.IsSheaf (Scheme.smallEtaleTopology X) Y.val.presheaf := Y.isSheaf
    obtain ⟨φ, hφ⟩ := key K.val.presheaf Y.val.presheaf hQY
      (fun U0 => (g.val.app (Opposite.op U0)).hom.toAddMonoidHom) hHK
      (fun U0 U' b x => (PresheafOfModules.naturality_apply g.val b.op x).symm)
    let α : (Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶
        (wcEtZModRing X n).obj :=
      toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))))
    haveI hsurjα : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) α :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hint : ∀ (V : (X.Etale)ᵒᵖ) (t : ULift.{u+1} (ZMod n)), ∃ k : ℤ,
        ConcreteCategory.hom (α.app V) t = (k : (wcEtZModRing X n).obj.obj V) := by
      intro V t
      refine ⟨(t.down.cast : ℤ), ?_⟩
      have ht : t = (((t.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
        apply ULift.ext
        rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
      conv_lhs => rw [ht]
      exact map_intCast (ConcreteCategory.hom (α.app V)) _
    obtain ⟨f, hfx⟩ : ∃ f : K ⟶ Y, ∀ (V : (X.Etale)ᵒᵖ) (x : ↑(K.val.obj V)),
        f.val.app V x = φ.app V x := by
      refine ⟨⟨PresheafOfModules.homMk φ ?_⟩, fun V x => rfl⟩
      intro V r m
      let φX : ∀ V, K.val.obj V → Y.val.obj V := fun V x => (φ.app V).hom x
      have nat : ∀ (V W : (X.Etale)ᵒᵖ) (h : V ⟶ W) (x : K.val.obj V),
          Y.val.map h (φX V x) = φX W (K.val.map h x) := by
        intro V W h x
        exact (ConcreteCategory.congr_hom (φ.naturality h) x).symm
      have hadd : ∀ V (k : ℤ) (x : K.val.obj V), φX V (k • x) = k • φX V x :=
        fun V k x => map_zsmul (φ.app V).hom k x
      show φX V (r • m) = r • φX V m
      refine Presheaf.IsSheaf.isSeparated Y.isSheaf V.unop _
        (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X) α r) _ _ ?_
      intro W h hh
      obtain ⟨t, ht⟩ := hh
      obtain ⟨k, hk⟩ := hint (Opposite.op W) t
      have hr : ConcreteCategory.hom ((wcEtZModRing X n).obj.map h.op) r =
          (k : (wcEtZModRing X n).obj.obj (Opposite.op W)) :=
        ht.symm.trans hk
      show Y.val.map h.op (φX V (r • m)) = Y.val.map h.op (r • φX V m)
      rw [nat, K.val.map_smul, Y.val.map_smul, nat, hr]
      have h1 : ∀ x : K.val.obj (Opposite.op W),
          ((k : (wcEtZModRing X n).obj.obj (Opposite.op W)) • x) = k • x :=
        fun x => Int.cast_smul_eq_zsmul _ _ _
      have h2 : ∀ x : Y.val.obj (Opposite.op W),
          ((k : (wcEtZModRing X n).obj.obj (Opposite.op W)) • x) = k • x :=
        fun x => Int.cast_smul_eq_zsmul _ _ _
      exact (congrArg (φX _) (h1 _)).trans ((hadd _ k _).trans (h2 _).symm)
    refine ⟨f, ?_⟩
    show (SheafOfModules.pushforward.{u+1} ψ).map f = g
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro U0
    ext m
    have h1 := PresheafOfModules.pushforward_map_app_apply ψ.hom f.val U0 m
    rw [← SheafOfModules.pushforward_map_val] at h1
    refine h1.trans ?_
    exact (hfx _ m).trans (hφ U0.unop m)

  constructor
  · intro f₁ f₂ h
    have h' : Dj.Φ.map f₁ = Dj.Φ.map f₂ := by
      simpa only [Category.id_comp] using h
    apply hinj
    show (SheafOfModules.pushforward.{u+1} ψ).map f₁ = (SheafOfModules.pushforward.{u+1} ψ).map f₂
    have n1 := e.hom.naturality f₁
    have n2 := e.hom.naturality f₂
    rw [← cancel_epi (e.hom.app K), ← n1, ← n2, h']
  · intro h
    obtain ⟨f, hf⟩ := hsurj (e.inv.app K ≫ h ≫ e.hom.app Y)
    refine ⟨f, ?_⟩
    have hf' : (SheafOfModules.pushforward.{u+1} ψ).map f = e.inv.app K ≫ h ≫ e.hom.app Y := hf
    have n1 := e.hom.naturality f
    show 𝟙 _ ≫ Dj.Φ.map f = h
    rw [Category.id_comp]
    have h3 : e.hom.app K ≫ (SheafOfModules.pushforward.{u+1} ψ).map f = h ≫ e.hom.app Y :=
      (congrArg (fun t => e.hom.app K ≫ t) hf').trans (Iso.hom_inv_id_app_assoc e K _)
    exact (cancel_mono (e.hom.app Y)).1 (n1.trans h3)

theorem wc_et_open_pull_preserves_injective : ∀ {X U : Scheme.{u}} (j : U ⟶ X) [IsOpenImmersion j] (n : ℕ) (Dj : wcEtPullData j n) (I : SheafOfModules.{u+1} (wcEtZModRing X n)), Injective I → Injective (Dj.Φ.obj I) :=
by
  classical
  intro X U j _ n Dj I hI
  have s1 : ∀ (Y : Scheme.{u}) (m : ℕ) (S : Sheaf (Scheme.smallEtaleTopology Y) RingCat.{u+1})
      (a b : wcEtZModRing Y m ⟶ S), a = b := by
    intro Y m S a b
    apply ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) RingCat.{u+1}).homEquiv
      ((Functor.const _).obj (RingCat.of (ULift.{u+1} (ZMod m)))) S).injective
    apply NatTrans.ext
    funext W
    apply RingCat.hom_ext
    have key : ∀ f g : ULift.{u+1} (ZMod m) →+* (S.obj.obj W), f = g := by
      intro f g
      have h0 := RingHom.ext_zmod (f.comp (ULift.ringEquiv.{0, u+1} (R := ZMod m)).symm.toRingHom)
        (g.comp (ULift.ringEquiv.{0, u+1} (R := ZMod m)).symm.toRingHom)
      ext x
      exact congrArg (fun k => k x.down) h0
    exact key _ _
  have s1' : ∀ (Y : Scheme.{u}) (m : ℕ) (P : (Y.Etale)ᵒᵖ ⥤ RingCat.{u+1})
      (hP : Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) P)
      (a b : (wcEtZModRing Y m).obj ⟶ P), a = b := by
    intro Y m P hP a b
    have h := s1 Y m ⟨P, hP⟩ (ObjectProperty.homMk a) (ObjectProperty.homMk b)
    exact congrArg (fun f => f.hom) h
  let T : X.Etale := MorphismProperty.Over.mk ⊤ j (inferInstance : Etale j)
  haveI hc : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology X) := (wc_et_slice_continuous T).1
  haveI hcc : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology X) := (wc_et_slice_continuous T).2
  obtain ⟨ψ, -⟩ := wc_et_slice_zmod_restrict_unit T n
  haveI := Dj.cont
  haveI hDc : (wcEtBaseChange T.hom).IsContinuous (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology T.left) := Dj.cont
  haveI hcU : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology U)
      (Scheme.smallEtaleTopology X) := hc
  haveI hccU : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology U)
      (Scheme.smallEtaleTopology X) := hcc
  have adjS : wcEtSlice T ⊣ wcEtBaseChange T.hom := by
    letI : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) T.hom :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u})
        T.hom :=
      (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
        (inferInstance : P.IsStableUnderBaseChangeAlong T.hom)) (@Etale : MorphismProperty Scheme.{u})
    exact @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ @Etale ⊤ _ _ _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ T.hom _ _ _ T.prop trivial
  haveI hGF : (wcEtBaseChange T.hom ⋙ wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology X)
      (Scheme.smallEtaleTopology X) :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology T.left) _
  have adj : SheafOfModules.pushforward.{u+1} ψ ⊣
      @SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ Dj.cont Dj.φ := by
    refine SheafOfModules.pushforwardPushforwardAdj adjS ψ Dj.φ ?_ ?_
    · exact s1' X n _ (((wcEtBaseChange T.hom ⋙ wcEtSlice T).sheafPushforwardContinuous
        RingCat.{u+1} (Scheme.smallEtaleTopology X) (Scheme.smallEtaleTopology X)).obj
          (wcEtZModRing X n)).property _ _
    · exact s1' T.left n (wcEtZModRing T.left n).obj (wcEtZModRing T.left n).property _ _
  let e := Adjunction.leftAdjointUniq Dj.adj adj
  have hρI : Injective ((SheafOfModules.pushforward.{u+1} ψ).obj I) :=
    wc_et_slice_module_restrict_injective T n ψ I hI
  exact Injective.of_iso (e.app I).symm hρI

theorem wc_et_supp_card_of_restr : ∀ {X Z U : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (j : U ⟶ X) [IsOpenImmersion j], Set.range j = (Set.range i)ᶜ → ∀ (n : ℕ), 0 < n → ∀ (D : wcEtPullData i n) (Dj : wcEtPullData j n) (s m : ℕ), Function.Injective (wcEtPull Dj (s + 1)) → (∃ T : Finset (wcEtZModExt U n s), T.card ≤ m ∧ ∀ y : wcEtZModExt U n s, ∃ t ∈ T, ∃ w : wcEtZModExt X n s, y = t + wcEtPull Dj s w) → Finite (wcEtSuppExt D (s + 1)) ∧ Nat.card (wcEtSuppExt D (s + 1)) ≤ m :=
by
  classical
  intro X Z U i _ j _ hc n hn D Dj s m hinj hT
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing U n)) := HasExt.standard _
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim

  haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
      (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ

  have hB0 : Limits.IsZero (Dj.Φ.obj (wcEtSuppObj D)) := by
    have hsq := IsPullback.of_hasPullback i j
    haveI : IsClosedImmersion (Limits.pullback.snd i j) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    have hE : IsEmpty ↥(Limits.pullback i j : Scheme.{u}) := by
      apply Scheme.isEmpty_of_commSq hsq.toCommSq
      rw [hc]
      exact disjoint_compl_right
    obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i j) n
    obtain ⟨γ, hγ, _⟩ := wc_et_closed_supp_base_change i j (Limits.pullback.snd i j)
      (Limits.pullback.fst i j) hsq D Dj D'
    have hZ' : Limits.IsZero (wcEtSuppObj D') := by
      rw [Limits.IsZero.iff_id_eq_zero]
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro W
      haveI := wc_et_closed_supp_obj_vanish (Limits.pullback.snd i j) n D' W.unop
        (fun _ ⟨p, _⟩ => hE.false p)
      exact (ModuleCat.isZero_of_subsingleton _).eq_of_src _ _
    have h0 : Dj.μ.inv ≫ Dj.Φ.map (wcEtSuppUnitMap D) = 0 := by
      rw [← hγ, hZ'.eq_of_src γ 0, Limits.comp_zero]
    haveI : Dj.Φ.IsLeftAdjoint := Dj.adj.isLeftAdjoint
    haveI : Epi (Dj.Φ.map (wcEtSuppUnitMap D)) := Dj.Φ.map_epi _
    exact Limits.IsZero.of_epi_eq_zero _ h0

  have hconj : ∀ (k : ℕ) (y : Abelian.Ext (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n)))
      (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n))) k),
      ((Abelian.Ext.mk₀ Dj.μ.hom).comp ((Abelian.Ext.mk₀ Dj.μ.inv).comp
        (y.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k)) (zero_add k)).comp
        (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero k) = y := by
    intro k y
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  have hpull : ∀ (k : ℕ) (x : wcEtZModExt X n k), wcEtPull Dj k x = (Abelian.Ext.mk₀ Dj.μ.inv).comp
      ((Dj.Φ.mapExtAddHom (SheafOfModules.unit (wcEtZModRing X n))
        (SheafOfModules.unit (wcEtZModRing X n)) k x).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k))
      (zero_add k) := fun _ _ => rfl
  have hM_inj : Function.Injective (Dj.Φ.mapExtAddHom (SheafOfModules.unit (wcEtZModRing X n))
        (SheafOfModules.unit (wcEtZModRing X n)) (s + 1)) := by
    intro x₁ x₂ hx
    apply hinj
    rw [hpull, hpull, hx]

  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X n)) :=
    sheafOfModules_enoughInjectives _ _
  have hKbij : ∀ k : ℕ, Function.Bijective (fun β : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D))
      (SheafOfModules.unit (wcEtZModRing X n)) k => Abelian.Ext.mapExactFunctor Dj.Φ β) := by
    intro k
    have h := ext_transfer_of_corep Dj.Φ (Limits.kernel (wcEtSuppUnitMap D))
      (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))) (𝟙 _)
      (fun Y => wc_et_open_restr_ker_corep i j hc n hn D Dj Y)
      (fun I _ m e => by
        haveI : Injective (Dj.Φ.obj I) :=
          wc_et_open_pull_preserves_injective j n Dj I inferInstance
        exact Abelian.Ext.eq_zero_of_injective e)
      (SheafOfModules.unit (wcEtZModRing X n)) k
    simpa only [Abelian.Ext.mk₀_id_comp] using h

  have hSΦ := hS.map_of_exact Dj.Φ
  haveI : IsIso (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
    hSΦ.isIso_f_iff.mpr hB0

  let Ψ : Abelian.Ext (Limits.kernel (wcEtSuppUnitMap D)) (SheafOfModules.unit (wcEtZModRing X n)) s →
      Abelian.Ext (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n)))
        (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n))) s := fun x =>
    (Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
      (Abelian.Ext.mapExactFunctor Dj.Φ x) (zero_add s)
  have hΨe : ∀ x, (Abelian.Ext.mk₀ (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)))).comp (Ψ x)
      (zero_add s) = Abelian.Ext.mapExactFunctor Dj.Φ x := by
    intro x
    show (Abelian.Ext.mk₀ (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)))).comp
      ((Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
        (Abelian.Ext.mapExactFunctor Dj.Φ x) (zero_add s)) (zero_add s) = _
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id,
      Abelian.Ext.mk₀_id_comp]
  have hΨinj : Function.Injective Ψ := by
    intro x x' h
    apply (hKbij s).1
    show Abelian.Ext.mapExactFunctor Dj.Φ x = Abelian.Ext.mapExactFunctor Dj.Φ x'
    rw [← hΨe x, ← hΨe x', h]
  have hΨsurj : Function.Surjective Ψ := by
    intro z
    obtain ⟨x, hx⟩ := (hKbij s).2
      ((Abelian.Ext.mk₀ (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)))).comp z (zero_add s))
    refine ⟨x, ?_⟩
    have hx' : Abelian.Ext.mapExactFunctor Dj.Φ x =
        (Abelian.Ext.mk₀ (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D)))).comp z (zero_add s) := hx
    show (Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
      (Abelian.Ext.mapExactFunctor Dj.Φ x) (zero_add s) = z
    rw [hx', ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  have hΨadd : ∀ x x', Ψ (x + x') = Ψ x + Ψ x' := by
    intro x x'
    show (Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
      (Abelian.Ext.mapExactFunctor Dj.Φ (x + x')) (zero_add s) =
      (Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
        (Abelian.Ext.mapExactFunctor Dj.Φ x) (zero_add s) +
      (Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
        (Abelian.Ext.mapExactFunctor Dj.Φ x') (zero_add s)
    rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]
  have hΨκ : ∀ w : Abelian.Ext (SheafOfModules.unit (wcEtZModRing X n))
      (SheafOfModules.unit (wcEtZModRing X n)) s,
      Ψ ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp w (zero_add s)) =
        Abelian.Ext.mapExactFunctor Dj.Φ w := by
    intro w
    show (Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
      (Abelian.Ext.mapExactFunctor Dj.Φ
        ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp w (zero_add s))) (zero_add s) = _
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id,
      Abelian.Ext.mk₀_id_comp]

  have h1 : 1 + s = s + 1 := by omega
  have hδκ : ∀ w : Abelian.Ext (SheafOfModules.unit (wcEtZModRing X n))
      (SheafOfModules.unit (wcEtZModRing X n)) s,
      hS.extClass.comp ((Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp w
        (zero_add s)) h1 = 0 := by
    intro w
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero]
    have hz := hS.extClass_comp
    rw [hz, Abelian.Ext.zero_comp]

  have hδsurj : ∀ θ : Abelian.Ext (wcEtSuppObj D) (SheafOfModules.unit (wcEtZModRing X n)) (s + 1),
      ∃ x, hS.extClass.comp x h1 = θ := by
    intro θ
    have hA : (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp θ (zero_add (s + 1)) = 0 := by
      apply hM_inj
      have hθ0 : Abelian.Ext.mapExactFunctor Dj.Φ θ = 0 := by
        rw [← Abelian.Ext.mk₀_id_comp (Abelian.Ext.mapExactFunctor Dj.Φ θ),
          (Limits.IsZero.iff_id_eq_zero _).mp hB0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
      rw [map_zero, Functor.mapExtAddHom_apply, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, hθ0, Abelian.Ext.comp_zero]
    exact Abelian.Ext.contravariant_sequence_exact₃ hS
      (SheafOfModules.unit (wcEtZModRing X n)) θ hA (n₀ := s) h1

  obtain ⟨T, hTcard, hTcov⟩ := hT
  let dd : wcEtZModExt U n s → Abelian.Ext (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n)))
      (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n))) s := fun t =>
    ((Abelian.Ext.mk₀ Dj.μ.hom).comp t (zero_add s)).comp (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero s)
  have hddadd : ∀ a b, dd (a + b) = dd a + dd b := by
    intro a b
    show ((Abelian.Ext.mk₀ Dj.μ.hom).comp (a + b) (zero_add s)).comp
      (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero s) =
      ((Abelian.Ext.mk₀ Dj.μ.hom).comp a (zero_add s)).comp (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero s) +
      ((Abelian.Ext.mk₀ Dj.μ.hom).comp b (zero_add s)).comp (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero s)
    rw [Abelian.Ext.comp_add, Abelian.Ext.add_comp]
  have hcov : ∀ y : Abelian.Ext (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n)))
      (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n))) s,
      ∃ t ∈ T, ∃ w : wcEtZModExt X n s, y = dd t + Abelian.Ext.mapExactFunctor Dj.Φ w := by
    intro y
    obtain ⟨t, ht, w, hw⟩ := hTcov ((Abelian.Ext.mk₀ Dj.μ.inv).comp
      (y.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero s)) (zero_add s))
    refine ⟨t, ht, w, ?_⟩
    have e1 : dd ((Abelian.Ext.mk₀ Dj.μ.inv).comp
        (y.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero s)) (zero_add s)) = y := hconj s y
    have e2 : dd (wcEtPull Dj s w) = Abelian.Ext.mapExactFunctor Dj.Φ w := by
      rw [hpull, Functor.mapExtAddHom_apply]
      exact hconj s _
    rw [← e1, hw, hddadd, e2]

  let G : ↥T → Abelian.Ext (wcEtSuppObj D) (SheafOfModules.unit (wcEtZModRing X n)) (s + 1) :=
    fun t => hS.extClass.comp (Function.surjInv hΨsurj (dd t.1)) h1
  have hG : Function.Surjective G := by
    intro θ
    obtain ⟨x₁, hx₁⟩ := hδsurj θ
    obtain ⟨t, ht, w, hw⟩ := hcov (Ψ x₁)
    refine ⟨⟨t, ht⟩, ?_⟩
    have hx : x₁ = Function.surjInv hΨsurj (dd t) +
        (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp w (zero_add s) := by
      apply hΨinj
      rw [hΨadd, hΨκ, Function.surjInv_eq hΨsurj, hw]
    show hS.extClass.comp (Function.surjInv hΨsurj (dd t)) h1 = θ
    rw [← hx₁, hx, Abelian.Ext.comp_add, hδκ, add_zero]
  haveI : Finite ↥T := inferInstance
  refine ⟨Finite.of_surjective G hG, ?_⟩
  calc Nat.card (wcEtSuppExt D (s + 1)) ≤ Nat.card ↥T := Nat.card_le_card_of_surjective G hG
    _ = T.card := Nat.card_eq_finsetCard T
    _ ≤ m := hTcard

theorem wc_affine_space_succ_factor : ∀ (K : Type u) [Field K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) [LocallyOfFiniteType fS] (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin (c + 1)) K))), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c + 1)) K)))) → ∃ (P' : Scheme.{u}) (p' : P' ⟶ S) (q' : P' ⟶ Spec (.of (MvPolynomial (Fin c) K))) (e : P ⟶ Limits.pullback (p' ≫ fS) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))), IsPullback p' q' fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) ∧ LocallyOfFiniteType (p' ≫ fS) ∧ IsIso e ∧ (e ≫ Limits.pullback.fst (p' ≫ fS) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ≫ p' = p :=
by
  intro K _ S fS _ c P p q hpb

  have s3 : ∀ {S Y W V Z P' : Scheme.{u}} (fS : S ⟶ Z) (g : Y ⟶ Z) (h : W ⟶ Z) (a : V ⟶ Y)
      (b : V ⟶ W) (p' : P' ⟶ S) (q' : P' ⟶ Y), IsPullback p' q' fS g → IsPullback a b g h →
      ∃ r : Limits.pullback (p' ≫ fS) h ⟶ V,
        IsPullback (Limits.pullback.fst (p' ≫ fS) h ≫ p') r fS (a ≫ g) := by
    intro S Y W V Z P' fS g h a b p' q' hA hab
    refine ⟨hab.lift (Limits.pullback.fst (p' ≫ fS) h ≫ q') (Limits.pullback.snd (p' ≫ fS) h) ?_, ?_⟩
    · rw [Category.assoc, ← hA.w]
      exact Limits.pullback.condition
    · refine IsPullback.paste_horiz ?_ hA
      refine IsPullback.of_bot ?_ (hab.lift_fst _ _ _).symm hab
      rw [hab.lift_snd, ← hA.w]
      exact IsPullback.of_hasPullback _ _

  have s2 : ∃ (a : Spec (.of (MvPolynomial (Fin (c + 1)) K)) ⟶ Spec (.of (MvPolynomial (Fin c) K)))
      (b : Spec (.of (MvPolynomial (Fin (c + 1)) K)) ⟶ Spec (.of (Polynomial K))),
      IsPullback a b (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))
        (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ∧
      a ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) =
        Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c + 1)) K))) := by
    have h1 := CommRingCat.isPushout_tensorProduct K (MvPolynomial (Fin c) K) (Polynomial K)
    have h2 := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ h1
    let Φ : MvPolynomial (Fin (c + 1)) K ≃ₐ[K]
        TensorProduct K (MvPolynomial (Fin c) K) (Polynomial K) :=
      (MvPolynomial.finSuccEquiv K c).trans (polyEquivTensor K (MvPolynomial (Fin c) K))
    let φi := Φ.toRingEquiv.toCommRingCatIso
    let E := asIso (Spec.map φi.hom)
    refine ⟨E.inv ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom :
          MvPolynomial (Fin c) K →+* TensorProduct K (MvPolynomial (Fin c) K) (Polynomial K))),
      E.inv ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight :
          Polynomial K →ₐ[K] TensorProduct K (MvPolynomial (Fin c) K) (Polynomial K)).toRingHom),
      ?_, ?_⟩
    · refine IsPullback.of_iso h2 E (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp
      · simp
      · simp
    · have hring : CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)) ≫
          CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
            MvPolynomial (Fin c) K →+* TensorProduct K (MvPolynomial (Fin c) K) (Polynomial K)) =
          CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c + 1)) K)) ≫ φi.hom := by
        ext x
        change (Algebra.TensorProduct.includeLeftRingHom :
            MvPolynomial (Fin c) K →+* TensorProduct K (MvPolynomial (Fin c) K) (Polynomial K))
            (algebraMap K (MvPolynomial (Fin c) K) x) = Φ (algebraMap K _ x)
        rw [Φ.commutes, Algebra.TensorProduct.algebraMap_apply]
        rfl
      rw [Category.assoc, ← Spec.map_comp, hring, Spec.map_comp]
      simp [E]
  obtain ⟨a, b, hab, hag⟩ := s2
  have hA := IsPullback.of_hasPullback fS
    (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))
  have hgc : LocallyOfFiniteType
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) := by
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
    exact RingHom.finiteType_algebraMap.mpr inferInstance
  have : LocallyOfFiniteType (Limits.pullback.fst fS
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hA.flip hgc
  have hlft : LocallyOfFiniteType (Limits.pullback.fst fS
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) ≫ fS) :=
    locallyOfFiniteType_comp _ _
  obtain ⟨r, hQ⟩ := s3 fS _ (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) a b _ _
    hA hab
  rw [hag] at hQ
  refine ⟨_, _, _, (hpb.isoIsPullback _ _ hQ).hom, hA, hlft, inferInstance, ?_⟩
  rw [Category.assoc]
  exact IsPullback.isoIsPullback_hom_fst _ _ hpb hQ

theorem wc_ext_map_bijective_of_degenerate_leray : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] [R.Additive] (adj : L ⊣ R) (A : D) (B : C) (μ : L.obj A ≅ B), IsIso (adj.unit.app A) → ∀ (I : InjectiveResolution B), (∀ q : ℕ, 1 ≤ q → Limits.IsZero (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) → letI := HasExt.standard C; letI := HasExt.standard D; ∀ k : ℕ, Function.Bijective (((Abelian.Ext.mk₀ μ.inv).precomp _ (zero_add k)).comp (((Abelian.Ext.mk₀ μ.hom).postcomp _ (add_zero k)).comp (L.mapExtAddHom A A k))) :=
by
  intro C D _ _ _ _ L R _ _ _ _ adj A B μ hη I hI k
  letI instC : HasExt C := HasExt.standard C
  letI instD : HasExt D := HasExt.standard D
  haveI := adj.rightAdjoint_preservesLimits
  haveI : L.PreservesMonomorphisms := inferInstance
  haveI := hη

  let τ : ∀ (Y : C) (m : ℕ), Abelian.Ext A (R.obj Y) m →+ Abelian.Ext (L.obj A) Y m :=
    fun Y m => AddMonoidHom.mk'
      (fun α => (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp])
  have hτ : ∀ (Y : C) (m : ℕ) (α : Abelian.Ext A (R.obj Y) m),
      τ Y m α = (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m) := fun _ _ _ => rfl

  have s1a : ∀ {Y Y' : C} (g : Y ⟶ Y') (m : ℕ) (v : Abelian.Ext A (R.obj Y) m),
      τ Y' m (v.comp (Abelian.Ext.mk₀ (R.map g)) (add_zero m)) =
        (τ Y m v).comp (Abelian.Ext.mk₀ g) (add_zero m) := by
    intro Y Y' g m v
    have e1 : L.map (R.map g) ≫ adj.counit.app Y' = adj.counit.app Y ≫ g :=
      adj.counit_naturality g
    rw [hτ, hτ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, e1,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]

  have s1b : ∀ (S : ShortComplex C) (hS : S.ShortExact) (hRS : (S.map R).ShortExact) (m : ℕ)
      (z : Abelian.Ext A (S.map R).X₃ m),
      (Abelian.Ext.mapExactFunctor L (z.comp hRS.extClass rfl)).comp
          (Abelian.Ext.mk₀ (adj.counit.app S.X₁)) (add_zero (m + 1)) =
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (adj.counit.app S.X₃))
          (add_zero m)).comp hS.extClass rfl := by
    intro S hS hRS m z
    have h₁ : ((S.map R).map L).ShortExact := hRS.map_of_exact L
    have hnat : h₁.extClass.comp (Abelian.Ext.mk₀ (adj.counit.app S.X₁)) (add_zero 1) =
        (Abelian.Ext.mk₀ (adj.counit.app S.X₃)).comp hS.extClass (zero_add 1) :=
      h₁.extClass_naturality hS
        { τ₁ := adj.counit.app S.X₁
          τ₂ := adj.counit.app S.X₂
          τ₃ := adj.counit.app S.X₃
          comm₁₂ := (adj.counit_naturality S.f).symm
          comm₂₃ := (adj.counit_naturality S.g).symm }
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
      Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 1) (by omega), hnat]

  have base : ∀ Y : C, Function.Bijective (τ Y 0) := by
    intro Y
    have e : ⇑(τ Y 0) = fun x =>
        Abelian.Ext.mk₀ ((adj.homEquiv A Y).symm (Abelian.Ext.homEquiv₀ x)) := by
      funext x
      conv_lhs => rw [← Abelian.Ext.mk₀_homEquiv₀_apply x]
      rw [hτ, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        Adjunction.homEquiv_counit]
    rw [e]
    exact (Abelian.Ext.mk₀_bijective _ _).comp
      ((adj.homEquiv A Y).symm.bijective.comp Abelian.Ext.homEquiv₀.bijective)

  have postC : ∀ {X Y Y' : C} (ψ : Y ≅ Y') (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)) := by
    intro X Y Y' ψ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => x.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have postD : ∀ {X Y Y' : D} (ψ : Y ≅ Y') (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)) := by
    intro X Y Y' ψ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => x.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have preC : ∀ {X X' Y : C} (φ : X' ≅ X) (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => (Abelian.Ext.mk₀ φ.hom).comp x (zero_add n)) := by
    intro X X' Y φ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => (Abelian.Ext.mk₀ φ.inv).comp x (zero_add n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · dsimp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]

  obtain ⟨Y, f, g, w, hS, hRS, ⟨e⟩⟩ : ∃ (Y : ℕ → C) (f : ∀ n, Y n ⟶ I.cocomplex.X n)
      (g : ∀ n, I.cocomplex.X n ⟶ Y (n + 1)) (w : ∀ n, f n ≫ g n = 0),
      (∀ n, (ShortComplex.mk (f n) (g n) (w n)).ShortExact) ∧
      (∀ n, ((ShortComplex.mk (f n) (g n) (w n)).map R).ShortExact) ∧ Nonempty (B ≅ Y 0) := by
    have hw : ∀ n, Limits.kernel.ι (I.cocomplex.d n (n + 1)) ≫
        Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2)) = 0 := by
      intro n
      rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))), Category.assoc,
        Limits.kernel.lift_ι, Limits.zero_comp]
      exact Limits.kernel.condition _
    have hSE : ∀ n, (ShortComplex.mk (Limits.kernel.ι (I.cocomplex.d n (n + 1)))
        (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2))) (hw n)).ShortExact := by
      intro n
      have hex : (I.cocomplex.sc' n (n + 1) (n + 2)).Exact :=
        (I.cocomplex.exactAt_iff' n (n + 1) (n + 2) (by simp) (by simp)).1
          (I.cocomplex_exactAt_succ n)
      rw [ShortComplex.exact_iff_epi_kernel_lift] at hex
      have hlim : Limits.IsLimit (Limits.KernelFork.ofι
          (Limits.kernel.ι (I.cocomplex.d n (n + 1))) (hw n)) :=
        Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => Limits.kernel.lift _ g' (by
            rw [← Limits.kernel.lift_ι (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
              (I.cocomplex.d_comp_d n (n + 1) (n + 2)), ← Category.assoc, hg', Limits.zero_comp]))
          (fun g' hg' => Limits.kernel.lift_ι _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d n (n + 1))), hm,
              Limits.kernel.lift_ι])
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · exact ShortComplex.exact_of_f_is_kernel _ hlim
      · exact (inferInstance : Mono (Limits.kernel.ι (I.cocomplex.d n (n + 1))))
      · exact hex
    refine ⟨fun n => Limits.kernel (I.cocomplex.d n (n + 1)),
      fun n => Limits.kernel.ι (I.cocomplex.d n (n + 1)),
      fun n => Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
        (I.cocomplex.d_comp_d n (n + 1) (n + 2)), hw, hSE, ?_, ?_⟩
    · intro n
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · exact (hSE n).exact.map_of_mono_of_preservesKernel R (hSE n).mono_f inferInstance
      · exact (inferInstance : Mono (R.map (Limits.kernel.ι (I.cocomplex.d n (n + 1)))))
      · have hex' : (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).sc'
            n (n + 1) (n + 2)).Exact :=
          (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).exactAt_iff'
            n (n + 1) (n + 2) (by simp) (by simp)).1
            ((((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).exactAt_iff_isZero_homology
              (n + 1)).2 (hI (n + 1) (by omega)))
        rw [ShortComplex.exact_iff_epi_kernel_lift] at hex'
        have hep : Epi (Limits.kernel.lift (R.map (I.cocomplex.d (n + 1) (n + 2)))
            (R.map (I.cocomplex.d n (n + 1)))
            (by rw [← R.map_comp, I.cocomplex.d_comp_d, R.map_zero])) := hex'
        have hfac : R.map (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2))
            (I.cocomplex.d n (n + 1)) (I.cocomplex.d_comp_d n (n + 1) (n + 2))) =
            Limits.kernel.lift (R.map (I.cocomplex.d (n + 1) (n + 2)))
              (R.map (I.cocomplex.d n (n + 1)))
              (by rw [← R.map_comp, I.cocomplex.d_comp_d, R.map_zero]) ≫
            inv (Limits.kernelComparison (I.cocomplex.d (n + 1) (n + 2)) R) := by
          rw [IsIso.eq_comp_inv, ← cancel_mono (Limits.kernel.ι _), Category.assoc,
            Limits.kernelComparison_comp_ι, ← R.map_comp, Limits.kernel.lift_ι,
            Limits.kernel.lift_ι]
        show Epi (R.map (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2))
            (I.cocomplex.d n (n + 1)) (I.cocomplex.d_comp_d n (n + 1) (n + 2))))
        rw [hfac]
        exact epi_comp _ _
    · have h0 := I.exact₀.fIsKernel
      exact ⟨(HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 B).symm ≪≫
        Limits.IsLimit.conePointUniqueUpToIso h0 (Limits.limit.isLimit _)⟩

  have hJ : ∀ n, Injective (I.cocomplex.X n) := I.injective
  have hRJ : ∀ n, Injective (R.obj (I.cocomplex.X n)) := fun n => by
    haveI := hJ n
    exact Injective.injective_of_adjoint adj _
  have hJsurj : ∀ (n m : ℕ) (u : Abelian.Ext (L.obj A) (I.cocomplex.X n) m),
      ∃ v, τ (I.cocomplex.X n) m v = u := by
    intro n m u
    cases m with
    | zero => exact (base _).2 u
    | succ m' =>
      haveI := hJ n
      exact ⟨0, by rw [map_zero]; exact (Abelian.Ext.eq_zero_of_injective u).symm⟩
  have s1b' : ∀ (n m : ℕ) (z : Abelian.Ext A (R.obj (Y (n + 1))) m),
      τ (Y n) (m + 1) (z.comp (hRS n).extClass rfl) = (τ (Y (n + 1)) m z).comp (hS n).extClass rfl :=
    fun n m z => s1b _ (hS n) (hRS n) m z
  have tower : ∀ m n, Function.Bijective (τ (Y n) m) := by
    intro m
    induction m with
    | zero => intro n; exact base (Y n)
    | succ m ih =>
      intro n
      constructor
      · rw [injective_iff_map_eq_zero]
        intro w' hw'
        haveI := hRJ n
        have h0 : w'.comp (Abelian.Ext.mk₀ (R.map (f n))) (add_zero _) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨z', hz'⟩ : ∃ z' : Abelian.Ext A (R.obj (Y (n + 1))) m,
            z'.comp (hRS n).extClass rfl = w' :=
          Abelian.Ext.covariant_sequence_exact₁ A (hRS n) w' h0 rfl
        have h1 : (τ (Y (n + 1)) m z').comp (hS n).extClass rfl = 0 := by
          rw [← s1b' n m z', hz']
          exact hw'
        obtain ⟨u, hu⟩ : ∃ u : Abelian.Ext (L.obj A) (I.cocomplex.X n) m,
            u.comp (Abelian.Ext.mk₀ (g n)) (add_zero m) = τ (Y (n + 1)) m z' :=
          Abelian.Ext.covariant_sequence_exact₃ (L.obj A) (hS n) _ rfl h1
        obtain ⟨v, hv⟩ := hJsurj n m u
        have hz2 : z' = v.comp (Abelian.Ext.mk₀ (R.map (g n))) (add_zero m) := by
          apply (ih (n + 1)).1
          rw [s1a, hv]
          exact hu.symm
        have hc : (Abelian.Ext.mk₀ (R.map (g n))).comp (hRS n).extClass (zero_add 1) = 0 :=
          (hRS n).comp_extClass
        rw [← hz', hz2, Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 1) (by omega), hc,
          Abelian.Ext.comp_zero]
      · intro x
        haveI := hJ n
        have h0 : x.comp (Abelian.Ext.mk₀ (f n)) (add_zero _) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨y', hy'⟩ : ∃ y' : Abelian.Ext (L.obj A) (Y (n + 1)) m,
            y'.comp (hS n).extClass rfl = x :=
          Abelian.Ext.covariant_sequence_exact₁ (L.obj A) (hS n) x h0 rfl
        obtain ⟨z', hz'⟩ := (ih (n + 1)).2 y'
        exact ⟨z'.comp (hRS n).extClass rfl, by rw [s1b' n m z', hz', hy']⟩

  have hτB : Function.Bijective (τ B k) := by
    have hc : (fun x : Abelian.Ext (L.obj A) B k => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero k)) ∘
        (τ B k) = (τ (Y 0) k) ∘
          (fun v : Abelian.Ext A (R.obj B) k => v.comp (Abelian.Ext.mk₀ (R.map e.hom)) (add_zero k)) := by
      funext v
      exact (s1a e.hom k v).symm
    have h2 : Function.Bijective ((fun x : Abelian.Ext (L.obj A) B k =>
        x.comp (Abelian.Ext.mk₀ e.hom) (add_zero k)) ∘ (τ B k)) := by
      rw [hc]
      exact (tower k 0).comp (postD (R.mapIso e) k)
    exact (Function.Bijective.of_comp_iff' (postC e k) (τ B k)).1 h2

  have key : L.map (adj.unit.app A ≫ R.map μ.hom) ≫ adj.counit.app B = μ.hom := by
    have e2 : L.map (R.map μ.hom) ≫ adj.counit.app B = adj.counit.app (L.obj A) ≫ μ.hom :=
      adj.counit_naturality μ.hom
    have e3 : L.map (adj.unit.app A) ≫ adj.counit.app (L.obj A) = 𝟙 _ :=
      adj.left_triangle_components A
    rw [L.map_comp, Category.assoc, e2, ← Category.assoc]
    erw [e3]
    exact Category.id_comp _
  let ν : A ≅ R.obj B := asIso (adj.unit.app A) ≪≫ R.mapIso μ
  have hb : Function.Bijective (fun β : Abelian.Ext A A k => (Abelian.Ext.mk₀ μ.inv).comp
      (τ B k (β.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero k))) (zero_add k)) :=
    (preC μ.symm k).comp (hτB.comp (postD ν k))
  convert hb using 1
  funext β
  show (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor L β).comp
      (Abelian.Ext.mk₀ μ.hom) (add_zero k)) (zero_add k) =
    (Abelian.Ext.mk₀ μ.inv).comp
      (τ B k (β.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero k))) (zero_add k)
  rw [hτ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 0) (by omega), Abelian.Ext.mk₀_comp_mk₀,
    key]

theorem wc_et_affine_line_unit_iso : ∀ (K : Type u) [Field K] (T : Scheme.{u}) (fT : T ⟶ Spec (.of K)) (ℓ : ℕ) (D : wcEtPullData (Limits.pullback.fst fT (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))))) ℓ), IsIso (D.adj.unit.app (SheafOfModules.unit (wcEtZModRing T ℓ))) :=
by
  classical
  intro K _ T fT ℓ D

  have hA : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] {J : GrothendieckTopology C}
      {K : GrothendieckTopology D} (F : C ⥤ D) [F.IsContinuous J K] (R : Sheaf J RingCat.{u+1})
      (S : Sheaf K RingCat.{u+1}) (φ : R ⟶ (F.sheafPushforwardContinuous RingCat.{u+1} J K).obj S)
      (Φ : SheafOfModules.{u+1} R ⥤ SheafOfModules.{u+1} S)
      (adj : Φ ⊣ SheafOfModules.pushforward.{u+1} φ),
      (Φ.obj (SheafOfModules.unit R) ≅ SheafOfModules.unit S) →
      (∀ (X : Dᵒᵖ) (a b : S.obj.obj X), a * b = b * a) →
      (∀ X : Cᵒᵖ, Function.Bijective (φ.hom.app X).hom) →
      IsIso (adj.unit.app (SheafOfModules.unit R)) := by
    intro C D _ _ J K F _ R S φ Φ adj μ hcomm hbij
    let ψ : SheafOfModules.unit R ⟶
        (SheafOfModules.pushforward.{u+1} φ).obj (SheafOfModules.unit S) :=
      adj.homEquiv _ _ μ.hom
    have hψ : ψ = adj.unit.app _ ≫ (SheafOfModules.pushforward.{u+1} φ).map μ.hom :=
      adj.homEquiv_unit _ _ μ.hom
    let ψX : ∀ X : Cᵒᵖ, R.obj.obj X → S.obj.obj (Opposite.op (F.obj X.unop)) :=
      fun X r => (ψ.val.app X).hom r
    let φX : ∀ X : Cᵒᵖ, R.obj.obj X →+* S.obj.obj (Opposite.op (F.obj X.unop)) :=
      fun X => (φ.hom.app X).hom
    have hlin : ∀ (X : Cᵒᵖ) (r : R.obj.obj X), ψX X r = φX X r * ψX X 1 := by
      intro X r
      calc ψX X r = ψX X (r * 1) := by rw [mul_one]
        _ = φX X r * ψX X 1 := (ψ.val.app X).hom.map_smul r (1 : R.obj.obj X)
    let s : ((SheafOfModules.pushforward.{u+1} φ).obj (SheafOfModules.unit S)).sections :=
      PresheafOfModules.sectionsMk
        (M := ((SheafOfModules.pushforward.{u+1} φ).obj (SheafOfModules.unit S)).val)
        (fun X => (1 : S.obj.obj (Opposite.op (F.obj X.unop))))
        (fun _ _ h => map_one (S.obj.map (F.map h.unop).op).hom)
    let f : SheafOfModules.unit R ⟶
        (SheafOfModules.pushforward.{u+1} φ).obj (SheafOfModules.unit S) :=
      (SheafOfModules.unitHomEquiv _).symm s
    have hf1 : ∀ X, ((f.val.app X).hom (1 : R.obj.obj X) :
        S.obj.obj (Opposite.op (F.obj X.unop))) = (1 : S.obj.obj (Opposite.op (F.obj X.unop))) := by
      intro X
      have h1 := SheafOfModules.unitHomEquiv_apply_coe
        ((SheafOfModules.pushforward.{u+1} φ).obj (SheafOfModules.unit S)) f X
      have h2 : ((SheafOfModules.pushforward.{u+1} φ).obj
          (SheafOfModules.unit S)).unitHomEquiv f = s := Equiv.apply_symm_apply _ _
      rw [h2] at h1
      exact h1.symm.trans rfl
    let g : SheafOfModules.unit S ⟶ SheafOfModules.unit S := μ.inv ≫ (adj.homEquiv _ _).symm f
    have hg : ψ ≫ (SheafOfModules.pushforward.{u+1} φ).map g = f := by
      show adj.homEquiv _ _ μ.hom ≫ (SheafOfModules.pushforward.{u+1} φ).map g = f
      rw [← Adjunction.homEquiv_naturality_right]
      simp only [g, Iso.hom_inv_id_assoc, Equiv.apply_symm_apply]
    let gW : ∀ W : Dᵒᵖ, S.obj.obj W → S.obj.obj W := fun W m => (g.val.app W).hom m
    have hev : ∀ X : Cᵒᵖ, gW (Opposite.op (F.obj X.unop)) (ψX X 1) = 1 := by
      intro X
      have h : ((f.val.app X).hom (1 : R.obj.obj X) : S.obj.obj (Opposite.op (F.obj X.unop))) =
          gW (Opposite.op (F.obj X.unop)) (ψX X 1) := by
        rw [← hg]; rfl
      exact h.symm.trans (hf1 X)
    have hglin : ∀ (W : Dᵒᵖ) (m : S.obj.obj W), gW W m = m * gW W 1 := by
      intro W m
      calc gW W m = gW W (m * 1) := by rw [mul_one]
        _ = m * gW W 1 := (g.val.app W).hom.map_smul m (1 : S.obj.obj W)
    have hψbij : ∀ X : Cᵒᵖ, Function.Bijective (ψ.val.app X).hom := by
      intro X
      let sX : S.obj.obj (Opposite.op (F.obj X.unop)) := ψX X 1
      let cX : S.obj.obj (Opposite.op (F.obj X.unop)) := gW (Opposite.op (F.obj X.unop)) 1
      have hsc : sX * cX = 1 := (hglin _ sX).symm.trans (hev X)
      have hcs : cX * sX = 1 := (hcomm _ cX sX).trans hsc
      have hb : Function.Bijective (ψX X) := by
        constructor
        · intro a b hab
          apply (hbij X).1
          have h : φX X a * sX = φX X b * sX := by
            rw [← hlin, ← hlin]; exact hab
          have h2 := congrArg (· * cX) h
          simp only [mul_assoc, hsc, mul_one] at h2
          exact h2
        · intro y
          obtain ⟨r, hr⟩ := (hbij X).2 (y * cX)
          refine ⟨r, ?_⟩
          have e := hlin X r
          have hr' : φX X r = y * cX := hr
          rw [hr', mul_assoc, hcs, mul_one] at e
          exact e
      exact hb
    have hiso : IsIso ψ := by
      have h1 : ∀ X, IsIso (((PresheafOfModules.toPresheaf R.obj).map ψ.val).app X) := by
        intro X
        exact (ConcreteCategory.isIso_iff_bijective _).mpr (hψbij X)
      have : IsIso ((PresheafOfModules.toPresheaf R.obj).map ψ.val) :=
        NatIso.isIso_of_isIso_app _
      have : IsIso ψ.val := isIso_of_reflects_iso ψ.val (PresheafOfModules.toPresheaf R.obj)
      have : IsIso ((SheafOfModules.forget R).map ψ) := (inferInstance : IsIso ψ.val)
      exact isIso_of_reflects_iso ψ (SheafOfModules.forget R)
    have h2 : IsIso (adj.unit.app (SheafOfModules.unit R) ≫
        (SheafOfModules.pushforward.{u+1} φ).map μ.hom) := hψ ▸ hiso
    exact IsIso.of_isIso_comp_right _ ((SheafOfModules.pushforward.{u+1} φ).map μ.hom)

  have hglue : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), S ∈ Scheme.smallEtaleTopology Y V → ∀ (m : ℕ) (x : ∀ (V' : Y.Etale) (g : V' ⟶ V), S.arrows g → LocallyConstant V'.left (ZMod m)), (∀ (V' V'' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (h : V'' ⟶ V') (w : V''.left), x V'' (h ≫ g) (S.downward_closed hg h) w = x V' g hg (h.left w)) → ∃! f : LocallyConstant V.left (ZMod m), ∀ (V' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (v : V'.left), f (g.left v) = x V' g hg v := by
    intro Y V S hS m x hx
    have hEt : ∀ (A B : Y.Etale) (g : A ⟶ B), Etale g.left := by
      intro A B g
      haveI : Etale B.hom := B.prop
      have hw : g.left ≫ B.hom = A.hom := MorphismProperty.Over.w g
      haveI : Etale (g.left ≫ B.hom) := by
        rw [hw]
        exact A.prop
      exact Etale.of_comp g.left B.hom
    have hOpen : ∀ (A B : Y.Etale) (g : A ⟶ B), IsOpenMap g.left := by
      intro A B g
      haveI := hEt A B g
      exact g.left.isOpenMap
    have hsurj : ∀ v : V.left, ∃ (V' : Y.Etale) (g : V' ⟶ V) (v' : V'.left),
        S.arrows g ∧ g.left v' = v := by
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      intro v
      obtain ⟨V', g, v', hg, -, hv⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V S).mp hS v
      exact ⟨V', g, v', hg, hv⟩
    have hcongr : ∀ (Q : Y.Etale) (k k' : Q ⟶ V) (_ : k = k') (hk : S.arrows k)
        (hk' : S.arrows k') (w : Q.left), x Q k hk w = x Q k' hk' w := by
      intro Q k k' e hk hk' w
      subst e
      rfl
    have hagree : ∀ (V₁ V₂ : Y.Etale) (g₁ : V₁ ⟶ V) (g₂ : V₂ ⟶ V) (hg₁ : S.arrows g₁)
        (hg₂ : S.arrows g₂) (v₁ : V₁.left) (v₂ : V₂.left), g₁.left v₁ = g₂.left v₂ →
        x V₁ g₁ hg₁ v₁ = x V₂ g₂ hg₂ v₂ := by
      intro V₁ V₂ g₁ g₂ hg₁ hg₂ v₁ v₂ hv
      haveI : Etale g₂.left := hEt V₂ V g₂
      haveI : Etale V₁.hom := V₁.prop
      let Q : Y.Etale := MorphismProperty.Over.mk ⊤
        (Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom)
        (inferInstance : Etale (Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom))
      let h₁ : Q ⟶ V₁ := MorphismProperty.Over.homMk (Limits.pullback.fst g₁.left g₂.left) rfl trivial
      have hc : Limits.pullback.snd g₁.left g₂.left ≫ V₂.hom = Q.hom := by
        change Limits.pullback.snd g₁.left g₂.left ≫ V₂.hom =
          Limits.pullback.fst g₁.left g₂.left ≫ V₁.hom
        rw [← MorphismProperty.Over.w g₂, ← MorphismProperty.Over.w g₁, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let h₂ : Q ⟶ V₂ := MorphismProperty.Over.homMk (Limits.pullback.snd g₁.left g₂.left) hc trivial
      obtain ⟨c₁, hc₁⟩ : ∃ c : Q ⟶ V, c = h₁ ≫ g₁ := ⟨_, rfl⟩
      obtain ⟨c₂, hc₂⟩ : ∃ c : Q ⟶ V, c = h₂ ≫ g₂ := ⟨_, rfl⟩
      have hc12 : c₁ = c₂ := by
        apply MorphismProperty.Over.Hom.ext
        rw [hc₁, hc₂]
        change Limits.pullback.fst g₁.left g₂.left ≫ g₁.left =
          Limits.pullback.snd g₁.left g₂.left ≫ g₂.left
        exact Limits.pullback.condition
      obtain ⟨w, hw₁, hw₂⟩ := Scheme.Pullback.exists_preimage_pullback v₁ v₂ hv
      have k1 : h₁.left w = v₁ := hw₁
