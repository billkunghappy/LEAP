    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Limits.pullback fX
