theorem wc_et_lc_trace_sheaf_map : ∀ {X Y' : Scheme.{u}} {p : Y' ⟶ X} [IsSeparated p] {ℓ : ℕ} (Dp : wcEtPullData p ℓ) (t : ∀ V : X.Etale, LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod ℓ) →+ LocallyConstant V.left (ZMod ℓ)), (∀ (V V' : X.Etale) (g : V' ⟶ V) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod ℓ)) (x : V'.left), t V' (f.comap ⟨((wcEtBaseChange p).map g).left, ((wcEtBaseChange p).map g).left.continuous⟩) x = t V f (g.left x)) → (∀ (V : X.Etale) (σ : V.left ⟶ Y') (hσ : σ ≫ p = V.hom) (f : LocallyConstant ((wcEtBaseChange p).obj V).left (ZMod ℓ)), (∀ z, z ∈ interior (Set.range (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ (by rw [Category.id_comp, hσ]))) → f z = 1) → (∀ z, z ∉ Set.range (Limits.pullback.lift (f := V.hom) (g := p) (𝟙 V.left) σ (by rw [Category.id_comp, hσ])) → f z = 0) → t V f = 1) → ∃ τ : wcEtSuppObj Dp ⟶ SheafOfModules.unit (wcEtZModRing X ℓ), wcEtSheetNorm Dp τ :=
by
  intro X Y' p _ ℓ Dp t hnat hnorm

  have hglue : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), S ∈ Scheme.smallEtaleTopology Y V → ∀ (m : ℕ) (x : ∀ (V' : Y.Etale) (g : V' ⟶ V), S.arrows g → LocallyConstant V'.left (ZMod m)), (∀ (V' V'' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (h : V'' ⟶ V') (w : V''.left), x V'' (h ≫ g) (S.downward_closed hg h) w = x V' g hg (h.left w)) → ∃! f : LocallyConstant V.left (ZMod m), ∀ (V' : Y.Etale) (g : V' ⟶ V) (hg : S.arrows g) (v : V'.left), f (g.left v) = x V' g hg v := by
    intro Y V S hS m x hx
    have hEt : ∀ (A B : Y.Etale) (g : A ⟶ B), Etale g.left := by
      intro A B g
