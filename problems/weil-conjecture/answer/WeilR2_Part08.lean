      have hm := Scheme.Pullback.range_map (i₁ ≫ f') (i₂ ≫ g') f' g' i₁ i₂ (𝟙 S)
        (Category.comp_id _) (Category.comp_id _)
      have hr : Set.range (m ≫ ι.hom) = (U : Set Z) := by
        ext z
        constructor
        · rintro ⟨v, rfl⟩
          rw [Scheme.Hom.comp_apply]
          have hv : m v ∈ Set.range m := ⟨v, rfl⟩
          rw [hm] at hv
          exact (h (m v)).2 hv
        · intro hz
          have h1 : ι.hom (ι.inv z) ∈ U := by rw [Scheme.inv_hom_apply]; exact hz
          have h2 := (h _).1 h1
