theorem wc_et_open_slice_lan_counit_bij : ∀ {X : Scheme.{u}} (U : X.Opens) (K : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (V : X.Etale), (∀ x, V.hom x ∈ (U : Set X)) → Function.Bijective ((((wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)).op.lanAdjunction AddCommGrpCat.{u+1}).counit.app K).app (Opposite.op V)).hom :=
by
  intro X U K V hV

  haveI hFaith : (wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)).Faithful := by
    refine ⟨fun {W W'} g g' h => ?_⟩
    apply MorphismProperty.Over.Hom.ext
    exact congrArg (fun k => k.left) h

  haveI hFull : (wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)).Full := by
    refine ⟨fun {W W'} f => ?_⟩
    have hw := MorphismProperty.Over.w f
    have h1 : (f.left ≫ W'.hom) ≫ U.ι = W.hom ≫ U.ι :=
      (Category.assoc _ _ _).trans hw
    have h2 : f.left ≫ W'.hom = W.hom := (cancel_mono U.ι).mp h1
    refine ⟨MorphismProperty.Over.homMk f.left h2 trivial, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    rfl

  have hr : Set.range V.hom ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    exact hV x
  let a : V.left ⟶ (U : Scheme.{u}) := IsOpenImmersion.lift U.ι V.hom hr
  have ha : a ≫ U.ι = V.hom := IsOpenImmersion.lift_fac U.ι V.hom hr
  haveI : Etale (a ≫ U.ι) := by rw [ha]; exact V.prop
  have haE : Etale a := Etale.of_comp a U.ι
  let V₀ : (U : Scheme.{u}).Etale := MorphismProperty.Over.mk ⊤ a haE
  let e : (wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)).obj V₀ ≅ V :=
    MorphismProperty.Over.isoMk (Iso.refl V.left) (by
      show 𝟙 V.left ≫ V.hom = a ≫ U.ι
      rw [Category.id_comp, ha])


  let adj := (wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)).op.lanAdjunction AddCommGrpCat.{u+1}
  let c := adj.counit.app K
  have htri : (adj.unit.app ((wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)).op ⋙ K)).app (Opposite.op V₀) ≫
      c.app ((wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)).op.obj (Opposite.op V₀)) = 𝟙 _ :=
    NatTrans.congr_app (adj.right_triangle_components K) (Opposite.op V₀)
  haveI hiso0 : IsIso (c.app ((wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)).op.obj (Opposite.op V₀))) :=
    IsIso.of_isIso_fac_left htri
  have hnat := c.naturality e.symm.op.hom
  haveI : IsIso (c.app (Opposite.op ((wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)).obj V₀))) := hiso0
  haveI : IsIso (((𝟭 ((X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1})).obj K).map e.symm.op.hom) :=
    inferInstanceAs (IsIso (K.map e.symm.op.hom))
  haveI hiso : IsIso (c.app (Opposite.op V)) := IsIso.of_isIso_fac_left hnat
  exact ConcreteCategory.bijective_of_isIso (c.app (Opposite.op V))

theorem wc_sheafPullback_extzero_of_lan : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (J : GrothendieckTopology C) (K : GrothendieckTopology D) (G : C ⥤ D) [G.IsContinuous J K] [∀ P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}, G.op.HasLeftKanExtension P] [HasSheafify K AddCommGrpCat.{u+1}] [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (Q : D → Prop), Limits.PreservesFiniteLimits (G.op.lan : (Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ (Dᵒᵖ ⥤ AddCommGrpCat.{u+1})) → (∀ (P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (V : D), ¬ Q V → Subsingleton ((G.op.lan.obj P).obj (Opposite.op V))) → (∀ (P : Dᵒᵖ ⥤ AddCommGrpCat.{u+1}) (V : D), Q V → Function.Bijective (((G.op.lanAdjunction AddCommGrpCat.{u+1}).counit.app P).app (Opposite.op V)).hom) → ∃ (Lab : Sheaf J AddCommGrpCat.{u+1} ⥤ Sheaf K AddCommGrpCat.{u+1}) (adj : Lab ⊣ G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K), Limits.PreservesFiniteLimits Lab ∧ (∀ M, Mono (adj.counit.app M)) ∧ (∀ (A : Sheaf J AddCommGrpCat.{u+1}) (V : D) (s : (Lab.obj A).obj.obj (Opposite.op V)), Sieve.generate (fun (V' : D) (g : V' ⟶ V) => (Lab.obj A).obj.map g.op s = 0 ∨ Q V') ∈ K V) ∧ (∀ M : Sheaf K AddCommGrpCat.{u+1}, (∀ (V : D) (s : M.obj.obj (Opposite.op V)), Sieve.generate (fun (V' : D) (g : V' ⟶ V) => M.obj.map g.op s = 0 ∨ Q V') ∈ K V) → Epi (adj.counit.app M)) ∧ (∀ (M : Sheaf K AddCommGrpCat.{u+1}) (V : D), Q V → Function.Surjective ((adj.counit.app M).hom.app (Opposite.op V)).hom) :=
by
  intro C D _ _ J K G _ _ _ _ Q hfl hvan hbij
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous G AddCommGrpCat.{u+1} J K

  have hcounit : ∀ M : Sheaf K AddCommGrpCat.{u+1}, adj.counit.app M =
      (presheafToSheaf K AddCommGrpCat.{u+1}).map
        ((G.op.lanAdjunction AddCommGrpCat.{u+1}).counit.app M.obj) ≫
        (sheafificationAdjunction K AddCommGrpCat.{u+1}).counit.app M := by
    intro M
    have h := Adjunction.map_restrictFullyFaithful_counit_app
      ((G.op.lanAdjunction AddCommGrpCat.{u+1}).comp (sheafificationAdjunction K AddCommGrpCat.{u+1}))
      (fullyFaithfulSheafToPresheaf J AddCommGrpCat.{u+1}) (Functor.FullyFaithful.id _)
      (L := Functor.sheafPullbackConstruction.sheafPullback G AddCommGrpCat.{u+1} J K)
      (R := G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)
      (Iso.refl _) (Iso.refl _) M
    simp only [Functor.id_map, Iso.refl_inv, NatTrans.id_app,
      Adjunction.comp_counit_app] at h
    refine h.trans ?_
    erw [CategoryTheory.Functor.map_id, Category.id_comp, Category.id_comp]

  have hstar : ∀ M : Sheaf K AddCommGrpCat.{u+1},
      toSheafify K (G.op.lan.obj (G.op ⋙ M.obj)) ≫ (adj.counit.app M).hom =
        (G.op.lanAdjunction AddCommGrpCat.{u+1}).counit.app M.obj := by
    intro M
    rw [hcounit M]
    change toSheafify K _ ≫ (sheafToPresheaf K AddCommGrpCat.{u+1}).map (_ ≫ _) = _
    rw [Functor.map_comp, ← Category.assoc]
    change (toSheafify K _ ≫ sheafifyMap K _) ≫ _ = _
    rw [← toSheafify_naturality, Category.assoc]
    have ht := (sheafificationAdjunction K AddCommGrpCat.{u+1}).right_triangle_components M
    rw [sheafificationAdjunction_unit_app] at ht
    erw [ht]
