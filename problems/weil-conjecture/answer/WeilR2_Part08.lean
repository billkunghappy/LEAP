  refine ⟨G, qG, e, Φ MG ≫ AffineSpace.map (ULift.{u} (Fin c)) qG, AffineSpace.map (ULift.{u} (Fin c)) qG,
    hGa, hGi, hGs, he, hSact, hSpr, ?_, ?_, ?_, ?_⟩
  · rw [hσ, ← Category.assoc, hσΦ, hσpr]
  · rw [hσ, hσpr]
  · rw [hσ]
    exact s1 e
  · intro W Z fW i h A hA hcut
    obtain ⟨ψG, hψq, hψM⟩ := huniv fW A hA
    have hMA : MG.map ψG.appTop.hom = A := Matrix.ext fun a b => hψM a b
    have hpr : AffineSpace.homOfVector ψG (fun j : ULift.{u} (Fin c) => h j.down) ≫
