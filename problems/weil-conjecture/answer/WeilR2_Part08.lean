      RingHom.ext fun a => (MvPolynomial.rename (R := K) (Fin.succ : Fin c' → Fin (c' + 1))).commutes a
    rw [hSσ, ← Spec.map_comp, ← CommRingCat.ofHom_comp, e]

  obtain ⟨O0, hO0⟩ : ∃ O0 : (Spec (.of (MvPolynomial (Fin (c' + 1)) K))).Opens,
      O0 = PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) := ⟨_, rfl⟩
  obtain ⟨OB, hOB⟩ : ∃ OB : (Spec (.of (MvPolynomial (Fin (c' + 1)) K))).Opens,
      OB = ⨆ i : Fin c', PrimeSpectrum.basicOpen (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K) :=
    ⟨_, rfl⟩
  have hVAB : w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) = (w1 ≫ U.ι ≫ q) ⁻¹ᵁ (O0 ⊓ OB) := by
    subst hO0; subst hOB; rfl
  have hVA : w1 ⁻¹ᵁ wcEtPcCovA q U = (w1 ≫ U.ι ≫ q) ⁻¹ᵁ O0 := by subst hO0; rfl
  have hVB : w1 ⁻¹ᵁ wcEtPcCovB q U = (w1 ≫ U.ι ≫ q) ⁻¹ᵁ OB := by subst hOB; rfl
  have hNle : ∀ N : (Spec (.of (MvPolynomial (Fin (c' + 1)) K))).Opens,
      N ≤ (⨆ i : Fin (c' + 1), PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin (c' + 1)) K)) →
      q ⁻¹ᵁ N ≤ U := by
    intro N hN x hx
    have h1' := hs1 S fS (c' + 1) P p q z0 hP hz0p hz0q
    have hx' : x ∈ ((q ⁻¹ᵁ (⨆ i : Fin (c' + 1), PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin (c' + 1)) K)) : P.Opens) : Set P) := hN hx
    rw [h1', ← hU] at hx'
    exact hx'
  have hO0le : O0 ≤ ⨆ i : Fin (c' + 1), PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin (c' + 1)) K) := by
    subst hO0
    exact le_iSup (fun i : Fin (c' + 1) => PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin (c' + 1)) K)) 0
  have hOBle : OB ≤ ⨆ i : Fin (c' + 1), PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin (c' + 1)) K) := by
    subst hOB
    exact iSup_le fun i => le_iSup (fun i : Fin (c' + 1) => PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial (Fin (c' + 1)) K)) i.succ
  have hrA : Set.range jA = (O0 : Set (Spec (.of (MvPolynomial (Fin (c' + 1)) K)))) := by
    subst hjA hO0
    exact PrimeSpectrum.localization_away_comap_range _ _
  have hpre : Sσ ⁻¹ᵁ W = OB := by
    apply le_antisymm
    · intro x hx
      have hx' : Sσ x ∈ W := hx
      rw [hW] at hx'
      obtain ⟨i, hi⟩ := (TopologicalSpace.Opens.mem_iSup).mp hx'
      rw [hOB]
      refine (TopologicalSpace.Opens.mem_iSup).mpr ⟨i, ?_⟩
      have hi' : (MvPolynomial.X i : MvPolynomial (Fin c') K) ∉ (Sσ x).asIdeal := hi
      rw [hSσ] at hi'
      show (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K) ∉ x.asIdeal
      intro hmem
      apply hi'
      show (MvPolynomial.rename (R := K) (Fin.succ : Fin c' → Fin (c' + 1))) (MvPolynomial.X i) ∈ x.asIdeal
      rw [MvPolynomial.rename_X]
      exact hmem
    · intro x hx
      rw [hOB] at hx
      obtain ⟨i, hi⟩ := (TopologicalSpace.Opens.mem_iSup).mp hx
      have hi' : (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K) ∉ x.asIdeal := hi
      show Sσ x ∈ W
      rw [hW]
      refine (TopologicalSpace.Opens.mem_iSup).mpr ⟨i, ?_⟩
      show (MvPolynomial.X i : MvPolynomial (Fin c') K) ∉ (Sσ x).asIdeal
      rw [hSσ]
      intro hmem
      apply hi'
      have hmem' : (MvPolynomial.rename (R := K) (Fin.succ : Fin c' → Fin (c' + 1))) (MvPolynomial.X i) ∈ x.asIdeal := hmem
      rwa [MvPolynomial.rename_X] at hmem'
  have hrN : Set.range ((Sσ' ⁻¹ᵁ W).ι ≫ jA) =
      ((O0 ⊓ OB : (Spec (.of (MvPolynomial (Fin (c' + 1)) K))).Opens) : Set (Spec (.of (MvPolynomial (Fin (c' + 1)) K)))) := by
    rw [TopologicalSpace.Opens.coe_inf]
    ext y
    rw [Set.mem_inter_iff]
    constructor
    · rintro ⟨v, rfl⟩
      rw [Scheme.Hom.comp_apply]
      refine ⟨?_, ?_⟩
      · rw [← hrA]; exact ⟨_, rfl⟩
      · have hv : (Sσ' ⁻¹ᵁ W).ι v ∈ Set.range (Sσ' ⁻¹ᵁ W).ι := ⟨v, rfl⟩
        rw [Scheme.Opens.range_ι] at hv
        have hv2 : Sσ' ((Sσ' ⁻¹ᵁ W).ι v) ∈ W := hv
        rw [hpt] at hv2
        have hv3 : jA ((Sσ' ⁻¹ᵁ W).ι v) ∈ Sσ ⁻¹ᵁ W := hv2
        rw [hpre] at hv3
        exact hv3
    · rintro ⟨hy0, hyB⟩
      have hy : y ∈ Set.range jA := by rw [hrA]; exact hy0
      obtain ⟨z, rfl⟩ := hy
      have hz : z ∈ Sσ' ⁻¹ᵁ W := by
        show Sσ' z ∈ W
        rw [hpt]
        rw [← hpre] at hyB
        exact hyB
      have hz' : z ∈ Set.range (Sσ' ⁻¹ᵁ W).ι := by rw [Scheme.Opens.range_ι]; exact hz
      obtain ⟨w, hw⟩ := hz'
      exact ⟨w, by rw [Scheme.Hom.comp_apply, hw]⟩

  obtain ⟨θ, hθ, hθsq⟩ := hs3 fS _ p q hP U (O0 ⊓ OB) (hNle _ (inf_le_left.trans hO0le)) s1 h1 w1 hY1
    ((Sσ' ⁻¹ᵁ W).ι ≫ jA) hrN (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)) hVAB
  obtain ⟨θA, hθA, -⟩ := hs3 fS _ p q hP U O0 (hNle _ hO0le) s1 h1 w1 hY1 jA hrA
    (w1 ⁻¹ᵁ wcEtPcCovA q U) hVA
  obtain ⟨θB, hθB, hθBsq⟩ := hs3 fS _ p q hP U OB (hNle _ hOBle) s1 h1 w1 hY1 OB.ι
    (Scheme.Opens.range_ι OB) (w1 ⁻¹ᵁ wcEtPcCovB q U) hVB
  have hρsq : IsPullback (Sσ' ∣_ W) ((Sσ' ⁻¹ᵁ W).ι ≫ Spec.map (CommRingCat.ofHom ε))
      (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))))
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) :=
    IsPullback.paste_vert (isPullback_morphismRestrict Sσ' W) hch

  obtain ⟨bB, hbB1, hbB2⟩ : ∃ bB : ((w1 ⁻¹ᵁ wcEtPcCovB q U : Y1.Opens) : Scheme.{u}) ⟶
      ((q' ⁻¹ᵁ W : P'.Opens) : Scheme.{u}),
      bB ≫ (q' ⁻¹ᵁ W).ι ≫ p' = (w1 ⁻¹ᵁ wcEtPcCovB q U).ι ≫ h1 ∧
      bB ≫ q' ∣_ W = θB ≫ Sσ.resLE W OB hpre.ge :=
    ⟨hU'sq.lift ((w1 ⁻¹ᵁ wcEtPcCovB q U).ι ≫ h1) (θB ≫ Sσ.resLE W OB hpre.ge) (by
      rw [hθBsq.w]
      simp only [Category.assoc]
      rw [Scheme.Hom.resLE_comp_ι_assoc, E2]), hU'sq.lift_fst _ _ _, hU'sq.lift_snd _ _ _⟩
  have hVB' : w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) ≤ w1 ⁻¹ᵁ wcEtPcCovB q U := fun _ hy => hy.2
  have hVA' : w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) ≤ w1 ⁻¹ᵁ wcEtPcCovA q U := fun _ hy => hy.1
  have h6 : (Y1.homOfLE hVB' ≫ bB) ≫ (q' ⁻¹ᵁ W).ι ≫ p' =
      (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)).ι ≫ h1 := by
    rw [Category.assoc, hbB1, Scheme.homOfLE_ι_assoc]
  have hI1 : Y1.homOfLE hVA' ≫ θA = θ ≫ (Sσ' ⁻¹ᵁ W).ι := by
    rw [← cancel_mono jA]
    simp only [Category.assoc]
    rw [hθA, Scheme.homOfLE_ι_assoc, hθ]
  have hI2 : (Y1.homOfLE hVB' ≫ bB) ≫ q' ∣_ W = θ ≫ Sσ' ∣_ W := by
    rw [← cancel_mono W.ι]
    simp only [Category.assoc]
    rw [reassoc_of% hbB2, Scheme.Hom.resLE_comp_ι, reassoc_of% hθB, Scheme.homOfLE_ι_assoc,
      morphismRestrict_ι, E3', reassoc_of% hθ]

  have hE : Sσ' ∣_ W ≫ W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) =
      ((Sσ' ⁻¹ᵁ W).ι ≫ jA) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    rw [morphismRestrict_ι_assoc, reassoc_of% E3']
    simp only [Category.assoc]
    rw [E2]
  have hθsq' : IsPullback ((w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)).ι ≫ h1) θ (s1 ≫ fS)
      (Sσ' ∣_ W ≫ W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) := by
    rw [hE]; exact hθsq
  have h5 := hs5 ((q' ⁻¹ᵁ W).ι ≫ p') (q' ∣_ W) (s1 ≫ fS)
    (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Sσ' ∣_ W)
    ((Sσ' ⁻¹ᵁ W).ι ≫ Spec.map (CommRingCat.ofHom ε))
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))
    ((w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)).ι ≫ h1) θ hU'sq hρsq hθsq' _ h6 hI2
  refine ⟨P', p', q', z0', q' ⁻¹ᵁ W, Y1.homOfLE hVB' ≫ bB,
    Y1.homOfLE hVA' ≫ θA ≫ Spec.map (CommRingCat.ofHom ε), bB, θA ≫ Spec.map (CommRingCat.ofHom ε),
    hP', hz0p', hz0q', hU', ?_, h6, rfl, rfl⟩
  rw [← Category.assoc (Y1.homOfLE hVA'), hI1]
  simpa only [Category.assoc] using h5

theorem wc_et_punct_cover_local_surj : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (c' : ℕ), 1 ≤ c' → wcEtPunctCore K ℓ c' → ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (n : ℕ), 1 ≤ n → n ≤ 2 * c' → wcEtPcMVSurj (U.ι ≫ p) ℓ (wcEtPcCovA q U) (wcEtPcCovB q U) (n - 1) :=
by
  classical
  intro K _ _ ℓ _ hℓ c' hc' hCore S fS m _ P p q z0 hP hz0p hz0q U hU n hn1 hn2

  have hmul : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n) (a b c : ℕ)
      (hc : a + b = c) (x : wcEtZModExt S n a) (y : wcEtZModExt S n b),
      wcEtPull D c (wcEtZModCup S n a b c hc x y) =
        wcEtZModCup S' n a b c hc (wcEtPull D a x) (wcEtPull D b y) := by
    intro S S' g n D a b c hc x y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hc)).comp (Abelian.Ext.mk₀ D.μ.hom)
          (add_zero c)) (zero_add c) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        (zero_add a)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) hc
    rw [Abelian.Ext.mapExactFunctor_comp]
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) (zero_add b) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b) := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.hom) (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (add_zero 0) (zero_add b) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    symm
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (zero_add a) hc (by omega),
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x) (Abelian.Ext.mk₀ D.μ.hom)
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (add_zero a) (zero_add b) (by omega),
      e1,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x)
        (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) hc (add_zero b)
        (by omega)]

  have hres : ∀ {Y1 Y2 : Scheme.{u}} (w2 : Y2 ⟶ Y1) {O O' : Y1.Opens} (h : O ≤ O')
      (h' : w2 ⁻¹ᵁ O ≤ w2 ⁻¹ᵁ O'), Y2.homOfLE h' ≫ w2 ∣_ O' = w2 ∣_ O ≫ Y1.homOfLE h := by
    intro Y1 Y2 w2 O O' h h'
    rw [← cancel_mono O'.ι]
    simp only [Category.assoc, morphismRestrict_ι, Scheme.homOfLE_ι]
    rw [← Category.assoc, Scheme.homOfLE_ι]

  have hsmA : SmoothOfRelativeDimension c'
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) := by
    have h1 : Algebra.IsStandardSmoothOfRelativeDimension c' K (MvPolynomial (Fin c') K) := by
      have := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K (Fin c')
      rwa [Nat.card_fin] at this
    have h2 : RingHom.IsStandardSmoothOfRelativeDimension c'
        (algebraMap K (MvPolynomial (Fin c') K)) :=
      (RingHom.isStandardSmoothOfRelativeDimension_algebraMap c').mpr h1
    exact (HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension c')).mpr
      (RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _ h2)

  have hH0 : ∀ (S1 : Scheme.{u}) (fS1 : S1 ⟶ Spec (.of K)) (m1 : ℕ)
      [SmoothOfRelativeDimension m1 fS1] (P1 : Scheme.{u}) (p1 : P1 ⟶ S1)
      (q1 : P1 ⟶ Spec (.of (MvPolynomial (Fin c') K))) (z1 : S1 ⟶ P1),
      IsPullback p1 q1 fS1 (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) →
      z1 ≫ p1 = 𝟙 S1 →
      z1 ≫ q1 = fS1 ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K)) →
      ∀ (U1 : P1.Opens), (U1 : Set P1) = (Set.range z1)ᶜ →
      ∀ (D : wcEtPullData (U1.ι ≫ p1) ℓ) (w : wcEtZModExt (U1 : Scheme.{u}) ℓ 0),
      ∃ l0 : wcEtZModExt S1 ℓ 0, wcEtPull D 0 l0 = w := by
    intro S1 fS1 m1 _ P1 p1 q1 z1 hP1 hz1p hz1q U1 hU1 D w
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S1 ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U1 : Scheme.{u}) ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (U1.ι ≫ p1)) _ _ D.cont
        D.φ).Additive := Adjunction.right_adjoint_additive D.adj
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing S1 ℓ)) :=
      sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology S1) (wcEtZModRing S1 ℓ)
    haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing (U1 : Scheme.{u}) ℓ)) :=
      sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology (U1 : Scheme.{u}))
        (wcEtZModRing (U1 : Scheme.{u}) ℓ)
    let I := injectiveResolution (SheafOfModules.unit (wcEtZModRing (U1 : Scheme.{u}) ℓ))
    have hsurj := wc_ext_truncated_leray_surj D.Φ
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcEtBaseChange (U1.ι ≫ p1)) _ _ D.cont D.φ)
      D.adj (SheafOfModules.unit (wcEtZModRing S1 ℓ))
      (SheafOfModules.unit (wcEtZModRing (U1 : Scheme.{u}) ℓ)) D.μ I 0
      (wc_et_punct_push_unit_iso K S1 fS1 m1 c' P1 p1 q1 z1 hP1 hz1p hz1q hc' U1 hU1 ℓ D)
      (fun n hn1 hnN => absurd hnN (by omega)) 0 le_rfl
    obtain ⟨b, hb⟩ := hsurj ((Abelian.Ext.mk₀ D.μ.hom).comp w (zero_add 0))
    refine ⟨b, ?_⟩
    beta_reduce at hb
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ b).comp
      (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0)) (zero_add 0) = w
    rw [hb, ← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
      Abelian.Ext.mk₀_id_comp]
  obtain ⟨κ, hκ⟩ := wc_et_gm_kunneth_surj K ℓ hℓ

  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  rw [Nat.add_sub_cancel]
  intro S1 s1 hs1 Y1 h1 w1 hY1 γ x
  have hVA : w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) ≤ w1 ⁻¹ᵁ wcEtPcCovA q U := fun _ hy => hy.1
  have hVB : w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U) ≤ w1 ⁻¹ᵁ wcEtPcCovB q U := fun _ hy => hy.2

  suffices hsuff : ∃ (a1 : wcEtZModExt ((w1 ⁻¹ᵁ wcEtPcCovA q U : Y1.Opens) : Scheme.{u}) ℓ k)
      (b1 : wcEtZModExt ((w1 ⁻¹ᵁ wcEtPcCovB q U : Y1.Opens) : Scheme.{u}) ℓ k)
      (S2 : Scheme.{u}) (s2 : S2 ⟶ S1), Etale s2 ∧ x ∈ Set.range s2 ∧
      ∀ (Y2 : Scheme.{u}) (h2 : Y2 ⟶ S2) (w2 : Y2 ⟶ Y1), IsPullback w2 h2 h1 s2 →
      ∀ (Dγ : wcEtPullData (w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))) ℓ)
        (DA : wcEtPullData (Y1.homOfLE hVA) ℓ) (DB : wcEtPullData (Y1.homOfLE hVB) ℓ),
      wcEtPull Dγ k γ = wcEtPull Dγ k (wcEtPull DA k a1 + wcEtPull DB k b1) by
    obtain ⟨a1, b1, S2, s2, hs2, hx, hall⟩ := hsuff
    refine ⟨S2, s2, hs2, hx, fun Y2 h2 w2 hY2 => ?_⟩
    obtain ⟨DwA⟩ := wc_et_zmod_pull_data_exists (w2 ∣_ (w1 ⁻¹ᵁ wcEtPcCovA q U)) ℓ
    obtain ⟨DwB⟩ := wc_et_zmod_pull_data_exists (w2 ∣_ (w1 ⁻¹ᵁ wcEtPcCovB q U)) ℓ
    obtain ⟨DA⟩ := wc_et_zmod_pull_data_exists (Y1.homOfLE hVA) ℓ
    obtain ⟨DB⟩ := wc_et_zmod_pull_data_exists (Y1.homOfLE hVB) ℓ
    obtain ⟨DcA⟩ := wc_et_zmod_pull_data_exists
      (w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)) ≫ Y1.homOfLE hVA) ℓ
    obtain ⟨DcB⟩ := wc_et_zmod_pull_data_exists
      (w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)) ≫ Y1.homOfLE hVB) ℓ
    refine ⟨wcEtPull DwA k a1, wcEtPull DwB k b1, fun Dγ Da Db => ?_⟩
    rw [hall Y2 h2 w2 hY2 Dγ DA DB, map_add, ← wc_et_pull_comp _ _ _ rfl DA Dγ DcA,
      ← wc_et_pull_comp _ _ _ rfl DB Dγ DcB,
      wc_et_pull_comp _ _ _ (hres w2 hVA (fun _ hy => hy.1)) DwA Da DcA,
      wc_et_pull_comp _ _ _ (hres w2 hVB (fun _ hy => hy.2)) DwB Db DcB]

  obtain ⟨P', p', q', z0', U', rab, tab, bB, tA, hP', hz0p', hz0q', hU', hsq, hrab, hbB, htA⟩ :=
    wc_et_pc_cover_charts K S fS c' P p q z0 hP hz0p hz0q U hU S1 s1 Y1 h1 w1 hY1
  haveI := hs1
  haveI i1 : SmoothOfRelativeDimension (0 + m) (s1 ≫ fS) := inferInstance
  haveI i2 : SmoothOfRelativeDimension c' p' :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension c') hP'.flip hsmA
  haveI i3 : SmoothOfRelativeDimension (c' + (0 + m)) (p' ≫ s1 ≫ fS) := inferInstance
  haveI i4 : SmoothOfRelativeDimension (0 + (c' + (0 + m))) (U'.ι ≫ p' ≫ s1 ≫ fS) :=
    inferInstance
  obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists rab ℓ
  obtain ⟨Dt⟩ := wc_et_zmod_pull_data_exists tab ℓ
  obtain ⟨DbB⟩ := wc_et_zmod_pull_data_exists bB ℓ
  have hK := hκ (U' : Scheme.{u}) (U'.ι ≫ p' ≫ s1 ≫ fS) (0 + (c' + (0 + m))) _ rab tab hsq Dr Dt
  obtain _ | _ | j := k
  ·
    obtain ⟨γ0, hγ0⟩ := hK.1 γ
    refine ⟨0, wcEtPull DbB 0 γ0, S1, 𝟙 S1, inferInstance, ⟨x, rfl⟩,
      fun Y2 h2 w2 hY2 Dγ DA DB => ?_⟩
    rw [map_zero, zero_add, ← wc_et_pull_comp bB _ rab hbB DbB DB Dr, ← hγ0]
  ·
    obtain ⟨γ0, γ1, hγ⟩ := hK.2 0 γ
    obtain ⟨DU'⟩ := wc_et_zmod_pull_data_exists (U'.ι ≫ p') ℓ
    obtain ⟨l0, hl0⟩ := hH0 S1 (s1 ≫ fS) (0 + m) P' p' q' z0' hP' hz0p' hz0q' U' hU' DU' γ1
    obtain ⟨DlA⟩ := wc_et_zmod_pull_data_exists ((w1 ⁻¹ᵁ wcEtPcCovA q U).ι ≫ h1) ℓ
    obtain ⟨DtA⟩ := wc_et_zmod_pull_data_exists tA ℓ
    obtain ⟨DV1h⟩ := wc_et_zmod_pull_data_exists
      ((w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)).ι ≫ h1) ℓ
    refine ⟨wcEtZModCup _ ℓ 0 1 (0 + 1) rfl (wcEtPull DlA 0 l0) (wcEtPull DtA 1 κ),
      wcEtPull DbB (0 + 1) γ0, S1, 𝟙 S1, inferInstance, ⟨x, rfl⟩,
      fun Y2 h2 w2 hY2 Dγ DA DB => ?_⟩
    refine congrArg (wcEtPull Dγ (0 + 1)) ?_
    have e1 : Y1.homOfLE hVA ≫ (w1 ⁻¹ᵁ wcEtPcCovA q U).ι ≫ h1 =
        (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)).ι ≫ h1 := Scheme.homOfLE_ι_assoc _ _ _
    rw [hγ, hmul DA, ← wc_et_pull_comp _ _ _ e1 DlA DA DV1h,
      wc_et_pull_comp _ _ _ hrab DU' Dr DV1h, hl0, ← wc_et_pull_comp _ _ _ htA DtA DA Dt,
      ← wc_et_pull_comp _ _ _ hbB DbB DB Dr]
    exact add_comm _ _
  ·
    obtain ⟨γ0, γ1, hγ⟩ := hK.2 (j + 1) γ
    obtain ⟨S2, s2, hs2, hx, hkill⟩ := hCore S1 (s1 ≫ fS) (0 + m) P' p' q' z0' hP' hz0p' hz0q'
      U' hU' (j + 1) (by omega) (by omega) γ1 x
    refine ⟨0, wcEtPull DbB (j + 1 + 1) γ0, S2, s2, hs2, hx, fun Y2 h2 w2 hY2 Dγ DA DB => ?_⟩
    have hz : wcEtPull Dγ (j + 1) (wcEtPull Dr (j + 1) γ1) = 0 := by
      have hZ := IsPullback.of_hasPullback (U'.ι ≫ p') s2
      have hw : (w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))) ≫ rab ≫ U'.ι ≫ p' =
          (w2 ⁻¹ᵁ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))).ι ≫ h2 ≫ s2 := by
        rw [hrab, morphismRestrict_ι_assoc, hY2.w]
      obtain ⟨φ, hφ⟩ : ∃ φ : ((w2 ⁻¹ᵁ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U)) : Y2.Opens) :
          Scheme.{u}) ⟶ Limits.pullback (U'.ι ≫ p') s2,
          φ ≫ Limits.pullback.fst (U'.ι ≫ p') s2 =
            (w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))) ≫ rab :=
        ⟨Limits.pullback.lift _ ((w2 ⁻¹ᵁ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))).ι ≫ h2)
          (by simpa only [Category.assoc] using hw), Limits.pullback.lift_fst _ _ _⟩
      obtain ⟨Dfst⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.fst (U'.ι ≫ p') s2) ℓ
      obtain ⟨Dφ⟩ := wc_et_zmod_pull_data_exists φ ℓ
      obtain ⟨Dc⟩ := wc_et_zmod_pull_data_exists
        ((w2 ∣_ (w1 ⁻¹ᵁ (wcEtPcCovA q U ⊓ wcEtPcCovB q U))) ≫ rab) ℓ
      rw [← wc_et_pull_comp _ _ _ rfl Dr Dγ Dc, wc_et_pull_comp _ _ _ hφ Dfst Dφ Dc,
        hkill _ (Limits.pullback.snd (U'.ι ≫ p') s2) (Limits.pullback.fst (U'.ι ≫ p') s2) hZ Dfst,
        map_zero]
    rw [map_zero, zero_add, ← wc_et_pull_comp bB _ rab hbB DbB DB Dr, hγ, map_add, hmul Dγ, hz,
      map_zero, AddMonoidHom.zero_apply, add_zero]

theorem wc_et_punct_local_vanishing : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → 1 ≤ c → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (n : ℕ), 1 ≤ n → n + 2 ≤ 2 * c → ∀ (V : Scheme.{u}) (v : V ⟶ S), Etale v → ∀ (YV : Scheme.{u}) (gV : YV ⟶ V) (w : YV ⟶ (U : Scheme.{u})), IsPullback w gV (U.ι ≫ p) v → ∀ (α : wcEtZModExt YV ℓ n) (x : V), ∃ (V' : Scheme.{u}) (v' : V' ⟶ V), Etale v' ∧ x ∈ Set.range v' ∧ ∀ (YV' : Scheme.{u}) (gV' : YV' ⟶ V') (w' : YV' ⟶ YV), IsPullback w' gV' gV v' → ∀ (Dw' : wcEtPullData w' ℓ), wcEtPull Dw' n α = 0 :=
by
  classical
  intro K _ _ S fS m _ c P p q z0 hP hz0p hz0q hc U hU ℓ _ hℓ n hn1 hn2 V v hv YV gV w hsq α x

  have hcore : ∀ c0 : ℕ, 1 ≤ c0 → wcEtPunctCore K ℓ c0 := by
    intro c0 hc0
    induction c0, hc0 using Nat.le_induction with
    | base =>
      intro S1 fS1 m1 _ P1 p1 q1 z1 _ _ _ U1 _ n1 hn1' hn2' α1
      exfalso
      omega
    | succ c' hc' ih =>
      intro S1 fS1 m1 _ P1 p1 q1 z1 hP1 hz1p hz1q U1 hU1 n1 hn1' hn2' α1
      have hoa : Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)) ≫
          Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) = 𝟙 _ := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap]
        simp
      have hz1sq : IsPullback z1 fS1 q1 (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K))) := by
        refine IsPullback.of_right ?_ hz1q hP1
        rw [hz1p, hoa]
        exact IsPullback.id_horiz fS1

      have hsup : wcEtPcCovA q1 U1 ⊔ wcEtPcCovB q1 U1 = ⊤ := by
        rw [eq_top_iff]
        intro y _
        rw [TopologicalSpace.Opens.mem_sup]
        by_contra hcon
        rw [not_or] at hcon
        obtain ⟨hyA, hyB⟩ := hcon
        have hX : ∀ i : Fin (c' + 1),
            (MvPolynomial.X i : MvPolynomial (Fin (c' + 1)) K) ∈ ((U1.ι ≫ q1) y).asIdeal := by
          intro i
          by_contra hi
          rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨j, rfl⟩
          · exact hyA hi
          · apply hyB
            exact (TopologicalSpace.Opens.mem_iSup (s := fun i : Fin c' =>
              PrimeSpectrum.basicOpen (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K))
              (x := (U1.ι ≫ q1) y)).mpr ⟨j, hi⟩
        have hker : RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K) ≤
            ((U1.ι ≫ q1) y).asIdeal := by
          intro f hf
          have hspan : f ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (c' + 1)))) := by
            rw [MvPolynomial.mem_ideal_span_X_image]
            intro mm hmm
            have hm0 : mm ≠ 0 := by
              rintro rfl
              rw [RingHom.mem_ker, MvPolynomial.constantCoeff_eq] at hf
              exact (MvPolynomial.mem_support_iff.mp hmm) hf
            obtain ⟨i, hi⟩ : ∃ i, mm i ≠ 0 := by
              by_contra hcon
              exact hm0 (Finsupp.ext fun a => by
                by_contra ha
                exact hcon ⟨a, ha⟩)
            exact ⟨i, Set.mem_univ _, hi⟩
          refine (Ideal.span_le.mpr ?_) hspan
          rintro _ ⟨i, -, rfl⟩
          exact hX i
        have hmax := RingHom.ker_isMaximal_of_surjective
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)
          (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ a⟩)
        have e1 := hmax.eq_of_le ((U1.ι ≫ q1) y).isPrime.ne_top hker
        have e2 := hmax.eq_of_le (Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K))
            (fS1 (p1 (U1.ι y)))).isPrime.ne_top (fun f hf => by
              show MvPolynomial.constantCoeff f ∈ (fS1 (p1 (U1.ι y))).asIdeal
              rw [RingHom.mem_ker.mp hf]
              exact Ideal.zero_mem _)
        have hzo : q1 (U1.ι y) = Spec.map (CommRingCat.ofHom
            (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K))
              (fS1 (p1 (U1.ι y))) := by
          rw [← Scheme.Hom.comp_apply U1.ι q1 y]
          exact PrimeSpectrum.ext (e1.symm.trans e2)
        obtain ⟨t, ht, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := q1)
          (g := Spec.map (CommRingCat.ofHom
            (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)))
          (U1.ι y) (fS1 (p1 (U1.ι y))) hzo
        have hmemU : U1.ι y ∈ (U1 : Set P1) := by
          rw [← Scheme.Opens.range_ι]
          exact ⟨y, rfl⟩
        rw [hU1] at hmemU
        have h1 : (hz1sq.isoPullback.inv ≫ z1) t = U1.ι y := by
          rw [hz1sq.isoPullback_inv_fst, ht]
        rw [Scheme.Hom.comp_apply] at h1
        exact hmemU ⟨_, h1⟩
      obtain ⟨hA, hB⟩ := wc_et_punct_cover_restr_dies K S1 fS1 m1 c' P1 p1 q1 z1 hP1 hz1p hz1q hc'
        U1 hU1 ℓ hℓ n1 hn1' α1
      exact wc_et_zariski_mv_local_kill (U1.ι ≫ p1) ℓ (wcEtPcCovA q1 U1) (wcEtPcCovB q1 U1) hsup
        n1 hn1' α1 hA hB
        (wc_et_punct_cover_local_surj K ℓ hℓ c' hc' ih S1 fS1 m1 P1 p1 q1 z1 hP1 hz1p hz1q U1 hU1
          n1 hn1' (by omega))

  haveI := hv
  haveI hsm : SmoothOfRelativeDimension m (v ≫ fS) := by
    have h0 : SmoothOfRelativeDimension (0 + m) (v ≫ fS) := inferInstance
    rwa [zero_add] at h0
  have hPV0 : IsPullback (Limits.pullback.fst p v) (Limits.pullback.snd p v) p v :=
    IsPullback.of_hasPullback p v
  have hPV : IsPullback (Limits.pullback.snd p v) (Limits.pullback.fst p v ≫ q) (v ≫ fS)
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) :=
    IsPullback.paste_vert hPV0.flip hP
  let z0V : V ⟶ Limits.pullback p v := Limits.pullback.lift (v ≫ z0) (𝟙 V)
    (by rw [Category.assoc, hz0p, Category.comp_id, Category.id_comp])
  have hz0V1 : z0V ≫ Limits.pullback.fst p v = v ≫ z0 := Limits.pullback.lift_fst _ _ _
  have hz0Vp : z0V ≫ Limits.pullback.snd p v = 𝟙 V := Limits.pullback.lift_snd _ _ _
  have hz0Vq : z0V ≫ (Limits.pullback.fst p v ≫ q) = (v ≫ fS) ≫ Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) := by
    rw [← Category.assoc, hz0V1, Category.assoc, hz0q, Category.assoc]
  have hsq2 : IsPullback z0V v (Limits.pullback.fst p v) z0 := by
    refine IsPullback.of_right ?_ hz0V1 hPV0.flip
    rw [hz0Vp, hz0p]
    exact IsPullback.id_horiz v
  let UV : (Limits.pullback p v).Opens := Limits.pullback.fst p v ⁻¹ᵁ U
  have hUV : (UV : Set (Limits.pullback p v : Scheme.{u})) = (Set.range z0V)ᶜ := by
    ext y
    have key : Limits.pullback.fst p v y ∈ Set.range z0 ↔ y ∈ Set.range z0V := by
      constructor
      · rintro ⟨s, hs⟩
        obtain ⟨t, ht, -⟩ := Scheme.Pullback.exists_preimage_pullback
          (f := Limits.pullback.fst p v) (g := z0) y s hs.symm
        have h1 : (hsq2.isoPullback.inv ≫ z0V) t = y := by
          rw [hsq2.isoPullback_inv_fst, ht]
        rw [Scheme.Hom.comp_apply] at h1
        exact ⟨_, h1⟩
      · rintro ⟨t, rfl⟩
        refine ⟨v t, ?_⟩
        rw [← Scheme.Hom.comp_apply v z0, ← Scheme.Hom.comp_apply z0V (Limits.pullback.fst p v),
          hz0V1]
    have hy : y ∈ (UV : Set (Limits.pullback p v : Scheme.{u})) ↔ Limits.pullback.fst p v y ∈ (U : Set P) :=
      Iff.rfl
    rw [hy, hU, Set.mem_compl_iff, Set.mem_compl_iff, key]
  have hUVsq : IsPullback (Limits.pullback.fst p v ∣_ U) (UV.ι ≫ Limits.pullback.snd p v)
      (U.ι ≫ p) v :=
    IsPullback.paste_vert (isPullback_morphismRestrict (Limits.pullback.fst p v) U) hPV0
  let e : YV ≅ (UV : Scheme.{u}) := IsPullback.isoIsPullback _ _ hsq hUVsq
  have he : e.hom ≫ UV.ι ≫ Limits.pullback.snd p v = gV :=
    IsPullback.isoIsPullback_hom_snd _ _ hsq hUVsq
  obtain ⟨De⟩ := wc_et_zmod_pull_data_exists e.inv ℓ
  obtain ⟨V', v', hv', hxv', hkill⟩ := hcore c hc V (v ≫ fS) m (Limits.pullback p v)
    (Limits.pullback.snd p v) (Limits.pullback.fst p v ≫ q) z0V hPV hz0Vp hz0Vq UV hUV n hn1 hn2
    (wcEtPull De n α) x
  refine ⟨V', v', hv', hxv', ?_⟩
  intro YV' gV' w' hsq' Dw'
  have hiso : IsPullback e.hom gV (UV.ι ≫ Limits.pullback.snd p v) (𝟙 V) :=
    IsPullback.of_horiz_isIso ⟨by rw [he, Category.comp_id]⟩
  have hsq'' : IsPullback (w' ≫ e.hom) gV' (UV.ι ≫ Limits.pullback.snd p v) v' := by
    have h3 := IsPullback.paste_horiz hsq' hiso
    rwa [Category.comp_id] at h3
  obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (w' ≫ e.hom) ℓ
  rw [wc_et_pull_comp e.inv (w' ≫ e.hom) w' (by rw [Category.assoc, e.hom_inv_id, Category.comp_id])
    De D' Dw' n α]
  exact hkill YV' gV' (w' ≫ e.hom) hsq'' D'

theorem pushforward_homology_local_basis {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
    {J : GrothendieckTopology C} {K : GrothendieckTopology D} (G : C ⥤ D) [G.IsContinuous J K]
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    [HasSheafify K AddCommGrpCat.{u+1}] [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (S : Sheaf J RingCat.{u+1}) (R : Sheaf K RingCat.{u+1})
    (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{u+1} J K).obj R)
    [(SheafOfModules.pushforward.{u+1} φ).Additive]
    (Kc : CochainComplex (SheafOfModules.{u+1} R) ℕ) (q m : ℕ)
    (f : Fin m → (SheafOfModules.unit R ⟶ Kc.X q))
    (hcyc : ∀ a, f a ≫ Kc.d q (q + 1) = 0)
    (hgen : ∀ (W : C) (s : (Kc.X q).val.obj (Opposite.op (G.obj W))),
        ((Kc.d q (q + 1)).val.app (Opposite.op (G.obj W))).hom s = 0 →
        Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ (c : Fin m → S.obj.obj (Opposite.op W'))
            (y : (Kc.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op (G.obj W'))),
            ((Kc.X q).val.map (G.map g).op).hom s =
              ∑ a, ((f a).val.app (Opposite.op (G.obj W'))).hom
                ((φ.hom.app (Opposite.op W')).hom (c a)) +
              ((Kc.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op (G.obj W'))).hom y) ∈ J W)
    (hind : ∀ (W : C) (c : Fin m → S.obj.obj (Opposite.op W))
        (y : (Kc.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op (G.obj W))),
        ∑ a, ((f a).val.app (Opposite.op (G.obj W))).hom ((φ.hom.app (Opposite.op W)).hom (c a)) =
          ((Kc.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op (G.obj W))).hom y →
        Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∀ a, (S.obj.map g.op).hom (c a) = 0) ∈ J W) :
    ∃ ι : Fin m → (SheafOfModules.unit S ⟶
        (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj Kc).homology q),
      (∀ (W : C) (c : Fin m → S.obj.obj (Opposite.op W)),
        ∑ a, ((ι a).val.app (Opposite.op W)).hom (c a) = 0 → c = 0) ∧
      (∀ (W : C) (h : ((((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex
            (ComplexShape.up ℕ)).obj Kc).homology q).val.obj (Opposite.op W)),
        Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ c : Fin m → S.obj.obj (Opposite.op W'),
          (((((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex
            (ComplexShape.up ℕ)).obj Kc).homology q).val.map g.op).hom h =
            ∑ a, ((ι a).val.app (Opposite.op W')).hom (c a)) ∈ J W) :=
by
  classical

  have hcomp : ∀ {M N L : SheafOfModules.{u+1} S} (p : M ⟶ N) (p' : N ⟶ L) (V : Cᵒᵖ)
      (x : M.val.obj V), ((p ≫ p').val.app V).hom x = (p'.val.app V).hom ((p.val.app V).hom x) :=
    fun _ _ _ _ => rfl
  have hnat : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) {W W' : C} (g : W' ⟶ W)
      (x : M.val.obj (Opposite.op W)),
      (p.val.app (Opposite.op W')).hom ((M.val.map g.op).hom x) =
        (N.val.map g.op).hom ((p.val.app (Opposite.op W)).hom x) :=
    fun p _ _ g x => PresheafOfModules.naturality_apply p.val g.op x
  have hMmap : ∀ {M : SheafOfModules.{u+1} S} {W Y Z : C} (h₀ : Y ⟶ W) (g' : Z ⟶ Y)
      (x : M.val.obj (Opposite.op W)),
      (M.val.map (g' ≫ h₀).op).hom x = (M.val.map g'.op).hom ((M.val.map h₀.op).hom x) := by
    intro M W Y Z h₀ g' x
    rw [op_comp, PresheafOfModules.map_comp]
    rfl
  have hSmap : ∀ {W Y Z : C} (h₀ : Y ⟶ W) (g' : Z ⟶ Y) (x : S.obj.obj (Opposite.op W)),
      (S.obj.map (g' ≫ h₀).op).hom x = (S.obj.map g'.op).hom ((S.obj.map h₀.op).hom x) := by
    intro W Y Z h₀ g' x
    rw [op_comp, Functor.map_comp]
    rfl

  have hmono : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) [Mono p] (W : C),
      Function.Injective (p.val.app (Opposite.op W)).hom := by
    intro M N p _ W
    have h1 : Mono ((SheafOfModules.forget.{u+1} S ⋙
        PresheafOfModules.evaluation.{u+1} S.obj (Opposite.op W)).map p) := Functor.map_mono _ p
    exact (ModuleCat.mono_iff_injective _).1 h1


  have hTS : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} S) := by
    constructor
    intro I _ _
    constructor
    intro K
    let adj := PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 S.obj)
    haveI : IsIso adj.counit := inferInstance
    haveI hP : Limits.PreservesColimitsOfShape I
        (PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ⋙ SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesColimitsOfShape_of_natIso
        (PresheafOfModules.sheafificationCompToSheaf (J := J) (𝟙 S.obj)).symm
    let K₀ := K ⋙ (SheafOfModules.forget S ⋙ PresheafOfModules.restrictScalars (𝟙 S.obj))
    let c₀ := Limits.colimit.cocone K₀
    let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
    have ht : Limits.IsColimit
        ((PresheafOfModules.sheafification (J := J) (𝟙 S.obj)).mapCocone c₀) :=
      Limits.isColimitOfPreserves _ h₀
    have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} S).mapCocone
        ((PresheafOfModules.sheafification (J := J) (𝟙 S.obj)).mapCocone c₀)) :=
      Limits.IsColimit.ofIsoColimit
        (Limits.isColimitOfPreserves
          (PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ⋙ SheafOfModules.toSheaf.{u+1} S) h₀)
        (Functor.mapCoconeMapCocone c₀).symm
    haveI : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 S.obj))
        (SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
    let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ≅ K :=
      Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫
        Functor.rightUnitor K
    exact Limits.preservesColimit_of_iso_diagram _ e

  have hepi : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) [Epi p] (W : C)
      (s : N.val.obj (Opposite.op W)),
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ t : M.val.obj (Opposite.op W'),
        (p.val.app (Opposite.op W')).hom t = (N.val.map g.op).hom s) ∈ J W := by
    intro M N p _ W s
    have := hTS
    have h1 : Epi ((SheafOfModules.toSheaf.{u+1} S).map p) := inferInstance
    have h2 := (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1}
      ((SheafOfModules.toSheaf.{u+1} S).map p)).2 h1
    have : Presheaf.IsLocallySurjective J ((SheafOfModules.toSheaf.{u+1} S).map p).hom := h2
    have h3 := Presheaf.imageSieve_mem J ((SheafOfModules.toSheaf.{u+1} S).map p).hom
      (U := Opposite.op W) s
    refine J.superset_covering ?_ h3
    intro W' g hg
    obtain ⟨t, ht⟩ := hg
    exact ⟨_, 𝟙 _, g, ⟨t, ht⟩, Category.id_comp _⟩

  have hker : ∀ (T : ShortComplex (SheafOfModules.{u+1} S)), T.Exact → Mono T.f → ∀ (W : C)
      (x₂ : T.X₂.val.obj (Opposite.op W)), (T.g.val.app (Opposite.op W)).hom x₂ = 0 →
      ∃ x₁ : T.X₁.val.obj (Opposite.op W), (T.f.val.app (Opposite.op W)).hom x₁ = x₂ := by
    intro T hT hf W x₂ hx
    have hE := hT.map_of_mono_of_preservesKernel (SheafOfModules.forget.{u+1} S ⋙
      PresheafOfModules.evaluation.{u+1} S.obj (Opposite.op W)) hf inferInstance
    exact (ShortComplex.moduleCat_exact_iff _).1 hE x₂ hx

  have hexact : ∀ (T : ShortComplex (SheafOfModules.{u+1} S)), T.Exact → ∀ (W : C)
      (x₂ : T.X₂.val.obj (Opposite.op W)), (T.g.val.app (Opposite.op W)).hom x₂ = 0 →
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ x₁ : T.X₁.val.obj (Opposite.op W'),
        (T.f.val.app (Opposite.op W')).hom x₁ = (T.X₂.val.map g.op).hom x₂) ∈ J W := by
    intro T hT W x₂ hx
    obtain ⟨z, hz⟩ := hker (ShortComplex.mk T.iCycles T.g T.iCycles_g)
      (ShortComplex.exact_of_f_is_kernel _ T.cyclesIsKernel) inferInstance W x₂ hx
    have := hT.epi_toCycles
    refine J.superset_covering ?_ (hepi T.toCycles W z)
    rw [Sieve.generate_le_iff]
    rintro W' g ⟨t, ht⟩
    apply Sieve.le_generate
    refine ⟨t, ?_⟩
    rw [← T.toCycles_i, hcomp, ht, hnat]
    exact congrArg _ hz

  have htrans : ∀ (W : C) (P₁ P₂ : Presieve W), Sieve.generate P₁ ∈ J W →
      (∀ (Y : C) (g₀ : Y ⟶ W), P₁ g₀ →
        Sieve.generate (fun (Y' : C) (g' : Y' ⟶ Y) => P₂ (g' ≫ g₀)) ∈ J Y) →
      Sieve.generate P₂ ∈ J W := by
    intro W P₁ P₂ h1 h2
    refine J.transitive h1 _ ?_
    intro Y' f hf
    obtain ⟨Y, k, g₀, hg₀, rfl⟩ := hf
    have h3 : Sieve.generate (fun (Y'' : C) (g' : Y'' ⟶ Y) => P₂ (g' ≫ g₀)) ≤
        (Sieve.generate P₂).pullback g₀ := by
      rw [Sieve.generate_le_iff]
      intro Y'' g' hg'
      exact ⟨_, 𝟙 _, g' ≫ g₀, hg', Category.id_comp _⟩
    have h4 := J.superset_covering h3 (h2 Y g₀ hg₀)
    rw [Sieve.pullback_comp]
    exact J.pullback_stable k h4

  have hsep : ∀ (W : C) (x : S.obj.obj (Opposite.op W)),
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => (S.obj.map g.op).hom x = 0) ∈ J W → x = 0 := by
    intro W x hx
    apply (Sheaf.isSeparated S) W _ hx x 0
    intro Y f hf
    obtain ⟨Z, k, k₀, hk₀, rfl⟩ := hf
    show (S.obj.map (k ≫ k₀).op).hom x = (S.obj.map (k ≫ k₀).op).hom 0
    rw [map_zero, hSmap, hk₀, map_zero]

  have hinjG : ∀ (P : CochainComplex (SheafOfModules.{u+1} S) ℕ)
      (g : Fin m → (SheafOfModules.unit S ⟶ P.X q)) (hg : ∀ a, g a ≫ P.d q (q + 1) = 0),
      (∀ (W : C) (c : Fin m → S.obj.obj (Opposite.op W))
        (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op W)),
        ∑ a, ((g a).val.app (Opposite.op W)).hom (c a) =
          ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op W)).hom y →
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∀ a, (S.obj.map h.op).hom (c a) = 0) ∈ J W) →
      ∀ (W : C) (c : Fin m → S.obj.obj (Opposite.op W)),
        ∑ a, (((P.liftCycles (g a) (q + 1) (by simp) (hg a) ≫ P.homologyπ q).val.app
          (Opposite.op W)).hom (c a)) = 0 → c = 0 := by
    intro P g hg H2 W c hc
    have hLi : ∀ a (V : Cᵒᵖ) (x : (SheafOfModules.unit S).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.liftCycles (g a) (q + 1) (by simp) (hg a)).val.app V).hom x) =
        ((g a).val.app V).hom x := by
      intro a V x
      rw [← hcomp, P.liftCycles_i]
    have hTi : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) =
        ((P.d ((ComplexShape.up ℕ).prev q) q).val.app V).hom y := by
      intro V y
      rw [← hcomp, P.toCycles_i]
    obtain ⟨z, hz⟩ : ∃ z : (P.cycles q).val.obj (Opposite.op W), z =
        ∑ a, ((P.liftCycles (g a) (q + 1) (by simp) (hg a)).val.app (Opposite.op W)).hom (c a) :=
      ⟨_, rfl⟩
    have hπz : ((P.homologyπ q).val.app (Opposite.op W)).hom z = 0 := by
      rw [hz, map_sum, ← hc]
      rfl
    have hTex := ShortComplex.exact_of_g_is_cokernel
      (ShortComplex.mk (P.toCycles ((ComplexShape.up ℕ).prev q) q) (P.homologyπ q)
        (P.toCycles_comp_homologyπ _ q)) (P.homologyIsCokernel _ q rfl)
    have hP₂ : Sieve.generate (fun (W' : C) (k : W' ⟶ W) =>
        ∀ a, (S.obj.map k.op).hom (c a) = 0) ∈ J W := by
      apply htrans W _ _ (hexact _ hTex W z hπz)
      rintro Y h₀ ⟨y, hy⟩
      have hd : ∑ a, ((g a).val.app (Opposite.op Y)).hom ((S.obj.map h₀.op).hom (c a)) =
          ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op Y)).hom y := by
        rw [← hTi]
        erw [hy]
        rw [hnat, hz, map_sum, map_sum]
        apply Finset.sum_congr rfl
        intro a _
        exact (hnat (g a) h₀ (c a)).trans (congrArg _ (hLi a _ (c a)).symm)
      refine J.superset_covering ?_ (H2 Y _ y hd)
      rw [Sieve.generate_le_iff]
      intro Z g' hg'
      apply Sieve.le_generate
      intro a
      rw [hSmap]
      exact hg' a
    funext a
    apply hsep W (c a)
    refine J.superset_covering ?_ hP₂
    rw [Sieve.generate_le_iff]
    intro Z k hk
    apply Sieve.le_generate
    exact hk a

  have hlocG : ∀ (P : CochainComplex (SheafOfModules.{u+1} S) ℕ)
      (g : Fin m → (SheafOfModules.unit S ⟶ P.X q)) (hg : ∀ a, g a ≫ P.d q (q + 1) = 0),
      (∀ (W : C) (s : (P.X q).val.obj (Opposite.op W)),
        ((P.d q (q + 1)).val.app (Opposite.op W)).hom s = 0 →
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∃ (c : Fin m → S.obj.obj (Opposite.op W'))
            (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op W')),
            ((P.X q).val.map h.op).hom s =
              ∑ a, ((g a).val.app (Opposite.op W')).hom (c a) +
              ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op W')).hom y) ∈ J W) →
      ∀ (W : C) (x : (P.homology q).val.obj (Opposite.op W)),
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∃ c : Fin m → S.obj.obj (Opposite.op W'),
          ((P.homology q).val.map h.op).hom x =
            ∑ a, (((P.liftCycles (g a) (q + 1) (by simp) (hg a) ≫ P.homologyπ q).val.app
              (Opposite.op W')).hom (c a))) ∈ J W := by
    intro P g hg H3 W x
    have hLi : ∀ a (V : Cᵒᵖ) (x : (SheafOfModules.unit S).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.liftCycles (g a) (q + 1) (by simp) (hg a)).val.app V).hom x) =
        ((g a).val.app V).hom x := by
      intro a V x
      rw [← hcomp, P.liftCycles_i]
    have hTi : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) =
        ((P.d ((ComplexShape.up ℕ).prev q) q).val.app V).hom y := by
      intro V y
      rw [← hcomp, P.toCycles_i]
    have hTπ : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.homologyπ q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) = 0 := by
      intro V y
      rw [← hcomp, P.toCycles_comp_homologyπ]
      rfl
    apply htrans W _ _ (hepi (P.homologyπ q) W x)
    rintro Y h₀ ⟨z, hz⟩
    have hs : ((P.d q (q + 1)).val.app (Opposite.op Y)).hom
        (((P.iCycles q).val.app (Opposite.op Y)).hom z) = 0 := by
      rw [← hcomp, P.iCycles_d]
      rfl
    refine J.superset_covering ?_ (H3 Y _ hs)
    rw [Sieve.generate_le_iff]
    rintro Z h' ⟨c, y, hcy⟩
    apply Sieve.le_generate
    refine ⟨c, ?_⟩
    have hw : ((P.cycles q).val.map h'.op).hom z =
        ∑ a, ((P.liftCycles (g a) (q + 1) (by simp) (hg a)).val.app (Opposite.op Z)).hom (c a) +
          ((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op Z)).hom y := by
      apply hmono (P.iCycles q) Z
      rw [map_add, map_sum, hnat, hcy, hTi]
      congr 1
      apply Finset.sum_congr rfl
      intro a _
      exact (hLi a _ (c a)).symm
    rw [hMmap, ← hz, ← hnat, hw, map_add, map_sum, hTπ, add_zero]
    rfl

  obtain ⟨g, hgdef⟩ : ∃ g : Fin m → (SheafOfModules.unit S ⟶
      (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj Kc).X q),
      g = fun a => SheafOfModules.unitToPushforwardObjUnit φ ≫
        (SheafOfModules.pushforward.{u+1} φ).map (f a) := ⟨_, rfl⟩
  have hgsec : ∀ a (W : C) (x : S.obj.obj (Opposite.op W)),
      ((g a).val.app (Opposite.op W)).hom x =
        ((f a).val.app (Opposite.op (G.obj W))).hom ((φ.hom.app (Opposite.op W)).hom x) := by
    intro a W x
    rw [hgdef]
    rfl
  have hg : ∀ a, g a ≫ (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj Kc).d q (q + 1) = 0 := by
    intro a
    rw [hgdef]
    dsimp only
    rw [Functor.mapHomologicalComplex_obj_d, Category.assoc, ← Functor.map_comp, hcyc,
      Functor.map_zero, Limits.comp_zero]
  refine ⟨fun a => (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj Kc).liftCycles (g a) (q + 1) (by simp) (hg a) ≫
      (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj Kc).homologyπ q, hinjG _ g hg ?_, hlocG _ g hg ?_⟩
  · intro W c y h
    apply hind W c y
    exact (Finset.sum_congr rfl fun a _ => (hgsec a W (c a)).symm).trans h
  · intro W s hs
    refine J.superset_covering ?_ (hgen W s hs)
    rw [Sieve.generate_le_iff]
    rintro W' k ⟨c, y, hcy⟩
    apply Sieve.le_generate
    refine ⟨c, y, ?_⟩
    rw [Finset.sum_congr rfl fun a _ => hgsec a W' (c a)]
    exact hcy

theorem wc_et_zmod_section_locally_nat : ∀ (S : Scheme.{u}) (ℓ : ℕ) [NeZero ℓ] (W : S.Etale) (c : ↑((wcEtZModRing S ℓ).obj.obj (Opposite.op W))), Sieve.generate (fun (W' : S.Etale) (g' : W' ⟶ W) => ∃ k : ℕ, ((wcEtZModRing S ℓ).obj.map g'.op).hom c = ((k : ℕ) : ↑((wcEtZModRing S ℓ).obj.obj (Opposite.op W')))) ∈ Scheme.smallEtaleTopology S W :=
by
  intro S ℓ _ W c
  obtain ⟨α, -, hsurj, -⟩ := wc_et_zmod_ring_locbij S ℓ
  haveI := hsurj
  refine (Scheme.smallEtaleTopology S).superset_covering ?_
    (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology S) α (U := Opposite.op W) c)
  rintro W' g' ⟨t, ht⟩
  apply Sieve.le_generate
  refine ⟨(ULift.down t : ZMod ℓ).val, ?_⟩
  have ht' : t = (((ULift.down t : ZMod ℓ).val : ℕ) : ULift.{u+1} (ZMod ℓ)) :=
    ULift.ext _ _ (ZMod.natCast_zmod_val (ULift.down t : ZMod ℓ)).symm
  rw [← ht]
  conv_lhs => rw [ht']
  exact map_natCast (α.app (Opposite.op W')).hom _

theorem wc_et_mod_isIso_of_inj_locsurj : ∀ {X : Scheme.{u}} {R : Sheaf (Scheme.smallEtaleTopology X) RingCat.{u+1}} {M N : SheafOfModules.{u+1} R} (f : M ⟶ N), (∀ W : X.Etale, Function.Injective (f.val.app (Opposite.op W)).hom) → (∀ (W : X.Etale) (s : N.val.obj (Opposite.op W)), Sieve.generate (fun (W' : X.Etale) (g : W' ⟶ W) => ∃ t : M.val.obj (Opposite.op W'), (f.val.app (Opposite.op W')).hom t = (N.val.map g.op).hom s) ∈ Scheme.smallEtaleTopology X W) → IsIso f :=
by
  intro X R M N f H1 H2
  have hi : Sheaf.IsLocallyInjective ((SheafOfModules.toSheaf R).map f) :=
    (Sheaf.isLocallyInjective_sheafToPresheaf_map_iff _).mp
      (Presheaf.isLocallyInjective_of_injective _ _ (fun W a b h => H1 W.unop h))
  have hs : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf R).map f) :=
    (Sheaf.isLocallySurjective_sheafToPresheaf_map_iff _).mp
      ⟨fun {W} s => (Scheme.smallEtaleTopology X).superset_covering
        ((Sieve.generate_le_iff _ _).mpr (fun W' g hg => hg)) (H2 W s)⟩
  haveI : IsIso ((SheafOfModules.toSheaf R).map f) :=
    (Sheaf.isLocallyBijective_iff_isIso _).mp ⟨hi, hs⟩
  exact isIso_of_reflects_iso f (SheafOfModules.toSheaf R)

theorem wc_et_slice_corep_transfer_natural : ∀ {Y : Scheme.{u}} (ℓ : ℕ) (T T' : Y.Etale) (h : T' ⟶ T) (hV : Etale h.left) [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)] [(wcEtSlice T').IsContinuous (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology Y)] [(wcEtSliceOf T'.left h.left hV).IsContinuous (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology T.left)] (ψT : wcEtZModRing T.left ℓ ⟶ ((wcEtSlice T).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).obj (wcEtZModRing Y ℓ)) (ψT' : wcEtZModRing T'.left ℓ ⟶ ((wcEtSlice T').sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology Y)).obj (wcEtZModRing Y ℓ)) (ψV : wcEtZModRing T'.left ℓ ⟶ ((wcEtSliceOf T'.left h.left hV).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology T.left)).obj (wcEtZModRing T.left ℓ)) [(SheafOfModules.pushforward.{u+1} ψT).Additive] [Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} ψT)] [Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} ψT)] [(SheafOfModules.pushforward.{u+1} ψT').Additive] [Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} ψT')] [Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} ψT')] [(SheafOfModules.pushforward.{u+1} ψV).Additive] [Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} ψV)] [Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} ψV)] [IsIso (SheafOfModules.unitToPushforwardObjUnit ψT)] [IsIso (SheafOfModules.unitToPushforwardObjUnit ψT')] [IsIso (SheafOfModules.unitToPushforwardObjUnit ψV)] (Q Q' : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (e : Q.val.obj (Opposite.op T)) (e' : Q'.val.obj (Opposite.op T')) (r : Q' ⟶ Q), (r.val.app (Opposite.op T')).hom e' = (Q.val.map h.op).hom e → ∀ (ι : (wcEtSlice T).obj (wcEtTop T.left) ⟶ T) (ι' : (wcEtSlice T').obj (wcEtTop T'.left) ⟶ T'), ι.left = 𝟙 T.left → ι'.left = 𝟙 T'.left → ∀ (ε : SheafOfModules.unit (wcEtZModRing T.left ℓ) ⟶ (SheafOfModules.pushforward.{u+1} ψT).obj Q) (ε' : SheafOfModules.unit (wcEtZModRing T'.left ℓ) ⟶ (SheafOfModules.pushforward.{u+1} ψT').obj Q'), (ε.val.app (Opposite.op (wcEtTop T.left))).hom (1 : (wcEtZModRing T.left ℓ).obj.obj (Opposite.op (wcEtTop T.left))) = (Q.val.map ι.op).hom e → (ε'.val.app (Opposite.op (wcEtTop T'.left))).hom (1 : (wcEtZModRing T'.left ℓ).obj.obj (Opposite.op (wcEtTop T'.left))) = (Q'.val.map ι'.op).hom e' → ∀ (n : ℕ), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T.left ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T'.left ℓ)) := HasExt.standard _; ∀ (β : Abelian.Ext Q (SheafOfModules.unit (wcEtZModRing Y ℓ)) n), (Abelian.Ext.mk₀ (SheafOfModules.unitToPushforwardObjUnit ψV)).comp ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψV) ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψT) β).comp (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψT))) (add_zero n)) (zero_add n))).comp (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψV))) (add_zero n)) (zero_add n) = (Abelian.Ext.mk₀ ε').comp ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψT') ((Abelian.Ext.mk₀ r).comp β (zero_add n))).comp (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψT'))) (add_zero n)) (zero_add n) :=
by
  classical
  intro Y ℓ T T' h hV hcT hcT' hcV ψT ψT' ψV iTa iTl iTc iT'a iT'l iT'c iVa iVl iVc kT kT' kV
    Q Q' e e' r hr ι ι' hι hι' ε ε' hε hε' n β
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T.left ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing T'.left ℓ)) := HasExt.standard _

  have s1 : ∀ (N : SheafOfModules.{u+1} (wcEtZModRing T'.left ℓ))
      (φ₁ φ₂ : SheafOfModules.unit (wcEtZModRing T'.left ℓ) ⟶ N),
      (φ₁.val.app (Opposite.op (wcEtTop T'.left))).hom
          (1 : (wcEtZModRing T'.left ℓ).obj.obj (Opposite.op (wcEtTop T'.left))) =
        (φ₂.val.app (Opposite.op (wcEtTop T'.left))).hom
          (1 : (wcEtZModRing T'.left ℓ).obj.obj (Opposite.op (wcEtTop T'.left))) → φ₁ = φ₂ := by
    intro N φ₁ φ₂ h12
    let τ : ∀ X : T'.left.Etale, X ⟶ wcEtTop T'.left := fun X =>
      MorphismProperty.Over.homMk (X.hom : X.left ⟶ T'.left) (Category.comp_id _) trivial
    apply (SheafOfModules.unitHomEquiv N).injective
    apply PresheafOfModules.sections_ext
    intro X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    have e1 := PresheafOfModules.naturality_apply φ₁.val (τ X.unop).op
      (1 : (wcEtZModRing T'.left ℓ).obj.obj (Opposite.op (wcEtTop T'.left)))
    have e2 := PresheafOfModules.naturality_apply φ₂.val (τ X.unop).op
      (1 : (wcEtZModRing T'.left ℓ).obj.obj (Opposite.op (wcEtTop T'.left)))
    have u1 := PresheafOfModules.unit_map_one (wcEtZModRing T'.left ℓ).obj (τ X.unop).op
    have e1' : (φ₁.val.app X).hom (1 : (wcEtZModRing T'.left ℓ).obj.obj X) =
        (N.val.map (τ X.unop).op).hom ((φ₁.val.app (Opposite.op (wcEtTop T'.left))).hom
          (1 : (wcEtZModRing T'.left ℓ).obj.obj (Opposite.op (wcEtTop T'.left)))) := by
      refine Eq.trans ?_ e1
      congr 1
      exact u1.symm
    have e2' : (φ₂.val.app X).hom (1 : (wcEtZModRing T'.left ℓ).obj.obj X) =
        (N.val.map (τ X.unop).op).hom ((φ₂.val.app (Opposite.op (wcEtTop T'.left))).hom
          (1 : (wcEtZModRing T'.left ℓ).obj.obj (Opposite.op (wcEtTop T'.left)))) := by
      refine Eq.trans ?_ e2
      congr 1
      exact u1.symm
    exact e1'.trans ((congrArg _ h12).trans e2'.symm)

  have hringU : ∀ (X : Scheme.{u}) (R : Sheaf (Scheme.smallEtaleTopology X) RingCat.{u+1})
      (a b : wcEtZModRing X ℓ ⟶ R), a = b := by
    intro X R a b
    have key : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod ℓ) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod ℓ)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod ℓ)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod ℓ →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    apply Sheaf.hom_ext
    apply sheafify_hom_ext (Scheme.smallEtaleTopology X) _ _ R.cond
    apply NatTrans.ext
    funext V
    apply RingCat.hom_ext
    exact key _ _

  let α : wcEtSlice T' ⟶ wcEtSliceOf T'.left h.left hV ⋙ wcEtSlice T :=
    { app := fun W => MorphismProperty.Over.homMk (𝟙 W.left) (by
          show 𝟙 W.left ≫ ((W.hom ≫ h.left) ≫ T.hom) = W.hom ≫ T'.hom
          rw [Category.id_comp, Category.assoc, MorphismProperty.Over.w h]) trivial
      naturality := by
        intro W W' k
        apply MorphismProperty.Over.Hom.ext
        show k.left ≫ 𝟙 W'.left = 𝟙 W.left ≫ k.left
        rw [Category.comp_id, Category.id_comp] }
  haveI hcomp : (wcEtSliceOf T'.left h.left hV ⋙ wcEtSlice T).IsContinuous
      (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology Y) :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology T.left) _
  let φfg : wcEtZModRing T'.left ℓ ⟶ ((wcEtSliceOf T'.left h.left hV ⋙ wcEtSlice T).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology Y)).obj
        (wcEtZModRing Y ℓ) :=
    ψV ≫ ((wcEtSliceOf T'.left h.left hV).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology T.left)).map ψT
  have hring : φfg ≫ (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
      (Scheme.smallEtaleTopology T'.left) (Scheme.smallEtaleTopology Y)).app (wcEtZModRing Y ℓ) = ψT' :=
    hringU _ _ _ _
  let ωh : SheafOfModules.pushforward.{u+1} ψT ⋙ SheafOfModules.pushforward.{u+1} ψV ⟶
      SheafOfModules.pushforward.{u+1} ψT' :=
    (SheafOfModules.pushforwardComp ψV ψT).hom ≫ SheafOfModules.pushforwardNatTrans φfg α ≫
      (SheafOfModules.pushforwardCongr hring).hom
  have hωsec : ∀ (M : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (W : T'.left.Etale)
      (x : M.val.obj (Opposite.op ((wcEtSliceOf T'.left h.left hV ⋙ wcEtSlice T).obj W))),
      ((ωh.app M).val.app (Opposite.op W)).hom x = (M.val.map (α.app W).op).hom x :=
    fun _ _ _ => rfl

  let X₁ : T.left.Etale := (wcEtSliceOf T'.left h.left hV).obj (wcEtTop T'.left)
  let t : X₁ ⟶ wcEtTop T.left := MorphismProperty.Over.homMk X₁.hom (Category.comp_id _) trivial
  have l1 : (((SheafOfModules.unitToPushforwardObjUnit ψV).val.app (Opposite.op (wcEtTop T'.left))).hom
      (1 : (wcEtZModRing T'.left ℓ).obj.obj (Opposite.op (wcEtTop T'.left)))) =
      (1 : (wcEtZModRing T.left ℓ).obj.obj (Opposite.op X₁)) :=
    (SheafOfModules.unitToPushforwardObjUnit_val_app_apply ψV _).trans
      (map_one (ψV.hom.app (Opposite.op (wcEtTop T'.left))).hom)
  have lT : ((SheafOfModules.unitToPushforwardObjUnit ψT).val.app (Opposite.op X₁)).hom
      (1 : (wcEtZModRing T.left ℓ).obj.obj (Opposite.op X₁)) =
      (1 : (wcEtZModRing Y ℓ).obj.obj (Opposite.op ((wcEtSlice T).obj X₁))) :=
    (SheafOfModules.unitToPushforwardObjUnit_val_app_apply ψT _).trans
      (map_one (ψT.hom.app (Opposite.op X₁)).hom)
  have lT' : ((SheafOfModules.unitToPushforwardObjUnit ψT').val.app (Opposite.op (wcEtTop T'.left))).hom
      (1 : (wcEtZModRing T'.left ℓ).obj.obj (Opposite.op (wcEtTop T'.left))) =
      (1 : (wcEtZModRing Y ℓ).obj.obj (Opposite.op ((wcEtSlice T').obj (wcEtTop T'.left)))) :=
    (SheafOfModules.unitToPushforwardObjUnit_val_app_apply ψT' _).trans
      (map_one (ψT'.hom.app (Opposite.op (wcEtTop T'.left))).hom)
  have l2 : (ε.val.app (Opposite.op X₁)).hom (1 : (wcEtZModRing T.left ℓ).obj.obj (Opposite.op X₁)) =
      (Q.val.map ((wcEtSlice T).map t).op).hom ((Q.val.map ι.op).hom e) :=
    (congrArg (ε.val.app (Opposite.op X₁)).hom (PresheafOfModules.unit_map_one _ t.op).symm).trans
      ((PresheafOfModules.naturality_apply ε.val t.op _).trans
        (congrArg (((SheafOfModules.pushforward.{u+1} ψT).obj Q).val.map t.op).hom hε))
  have l3 : (((SheafOfModules.pushforward.{u+1} ψT').map r).val.app (Opposite.op (wcEtTop T'.left))).hom
      ((ε'.val.app (Opposite.op (wcEtTop T'.left))).hom
        (1 : (wcEtZModRing T'.left ℓ).obj.obj (Opposite.op (wcEtTop T'.left)))) =
      (Q.val.map ι'.op).hom ((Q.val.map h.op).hom e) :=
    (congrArg (r.val.app (Opposite.op ((wcEtSlice T').obj (wcEtTop T'.left)))).hom hε').trans
      ((PresheafOfModules.naturality_apply r.val ι'.op e').trans
        (congrArg (Q.val.map ι'.op).hom hr))
  have hmor : (ι.op ≫ ((wcEtSlice T).map t).op) ≫ (α.app (wcEtTop T'.left)).op = h.op ≫ ι'.op := by
    apply Quiver.Hom.unop_inj
    apply MorphismProperty.Over.Hom.ext
    show 𝟙 T'.left ≫ (t.left ≫ ι.left) = ι'.left ≫ h.left
    rw [hι, hι']
    show 𝟙 T'.left ≫ ((𝟙 T'.left ≫ h.left) ≫ 𝟙 T.left) = 𝟙 T'.left ≫ h.left
    simp

  have hi : (SheafOfModules.unitToPushforwardObjUnit ψV ≫ (SheafOfModules.pushforward.{u+1} ψV).map ε) ≫
      ωh.app Q = ε' ≫ (SheafOfModules.pushforward.{u+1} ψT').map r := by
    apply s1
    refine Eq.trans ?_ l3.symm
    refine (hωsec Q (wcEtTop T'.left) _).trans ?_
    refine (congrArg (Q.val.map (α.app (wcEtTop T'.left)).op).hom
      ((congrArg (ε.val.app (Opposite.op X₁)).hom l1).trans l2)).trans ?_
    rw [← PresheafOfModules.map_comp_apply Q.val ι.op ((wcEtSlice T).map t).op e,
      ← PresheafOfModules.map_comp_apply Q.val (ι.op ≫ ((wcEtSlice T).map t).op)
        (α.app (wcEtTop T'.left)).op e,
      ← PresheafOfModules.map_comp_apply Q.val h.op ι'.op e, hmor]
  have hii : (SheafOfModules.unitToPushforwardObjUnit ψV ≫
      (SheafOfModules.pushforward.{u+1} ψV).map (SheafOfModules.unitToPushforwardObjUnit ψT)) ≫
      ωh.app (SheafOfModules.unit (wcEtZModRing Y ℓ)) = SheafOfModules.unitToPushforwardObjUnit ψT' := by
    apply s1
    refine (hωsec _ (wcEtTop T'.left) _).trans ?_
    refine (congrArg ((SheafOfModules.unit (wcEtZModRing Y ℓ)).val.map (α.app (wcEtTop T'.left)).op).hom
      ((congrArg ((SheafOfModules.unitToPushforwardObjUnit ψT).val.app (Opposite.op X₁)).hom l1).trans
        lT)).trans ?_
    exact (PresheafOfModules.unit_map_one _ _).trans lT'.symm
  have hB : ωh.app (SheafOfModules.unit (wcEtZModRing Y ℓ)) ≫ inv (SheafOfModules.unitToPushforwardObjUnit ψT') =
      (SheafOfModules.pushforward.{u+1} ψV).map (inv (SheafOfModules.unitToPushforwardObjUnit ψT)) ≫
        inv (SheafOfModules.unitToPushforwardObjUnit ψV) := by
    have hii' : ωh.app (SheafOfModules.unit (wcEtZModRing Y ℓ)) =
        inv (SheafOfModules.unitToPushforwardObjUnit ψV ≫
          (SheafOfModules.pushforward.{u+1} ψV).map (SheafOfModules.unitToPushforwardObjUnit ψT)) ≫
          SheafOfModules.unitToPushforwardObjUnit ψT' := by
      rw [IsIso.eq_inv_comp]
      exact hii
    rw [hii', Category.assoc, IsIso.hom_inv_id, Category.comp_id, IsIso.inv_comp, Functor.map_inv]

  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing T'.left ℓ)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing T'.left ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing T'.left ℓ)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
  have hL1 : Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψV)
      ((Abelian.Ext.mk₀ ε).comp ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψT) β).comp
        (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψT))) (add_zero n)) (zero_add n)) =
      (Abelian.Ext.mk₀ ((SheafOfModules.pushforward.{u+1} ψV).map ε)).comp
        ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψT ⋙
          SheafOfModules.pushforward.{u+1} ψV) β).comp
          (Abelian.Ext.mk₀ ((SheafOfModules.pushforward.{u+1} ψV).map
            (inv (SheafOfModules.unitToPushforwardObjUnit ψT)))) (add_zero n)) (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_mapExactFunctor]
  have hR1 : Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψT')
      ((Abelian.Ext.mk₀ r).comp β (zero_add n)) =
      (Abelian.Ext.mk₀ ((SheafOfModules.pushforward.{u+1} ψT').map r)).comp
        (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψT') β) (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
  have hnat := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp β ωh
  have hRHS : (Abelian.Ext.mk₀ ε').comp ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψT')
      ((Abelian.Ext.mk₀ r).comp β (zero_add n))).comp
        (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψT'))) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (ε' ≫ (SheafOfModules.pushforward.{u+1} ψT').map r)).comp
        ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψT') β).comp
          (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψT'))) (add_zero n)) (zero_add n) := by
    rw [hR1, h4, h2]
  rw [hRHS, hL1, h4, h3, h2, ← hB, ← h3, hnat, h4, h2, hi]

theorem wc_et_pull_data_slice_normalized : ∀ {X : Scheme.{u}} (ℓ : ℕ) (V : X.Etale) [(wcEtSlice V).IsContinuous (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology X)] (ψ : wcEtZModRing V.left ℓ ⟶ ((wcEtSlice V).sheafPushforwardContinuous RingCat.{u+1} (Scheme.smallEtaleTopology V.left) (Scheme.smallEtaleTopology X)).obj (wcEtZModRing X ℓ)) [(SheafOfModules.pushforward.{u+1} ψ).Additive] [Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} ψ)] [Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} ψ)] [IsIso (SheafOfModules.unitToPushforwardObjUnit ψ)], ∃ D : wcEtPullData (S := X) (S' := V.left) V.hom ℓ, ∀ (i : ℕ) (x : wcEtZModExt X ℓ i), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _; letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing V.left ℓ)) := HasExt.standard _; wcEtPull D i x = (Abelian.Ext.mk₀ (SheafOfModules.unitToPushforwardObjUnit ψ)).comp ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} ψ) x).comp (Abelian.Ext.mk₀ (inv (SheafOfModules.unitToPushforwardObjUnit ψ))) (add_zero i)) (zero_add i) :=
by
    intro X ℓ V hcV ψ iA iL iC iK
    have hringU : ∀ (R : Sheaf (Scheme.smallEtaleTopology V.left) RingCat.{u+1})
        (a b : wcEtZModRing V.left ℓ ⟶ R), a = b := by
      intro R a b
      have key : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod ℓ) →+* R), ψ = ψ' := by
        intro R _ ψ ψ'
        have h : ψ.comp (ULift.ringEquiv (R := ZMod ℓ)).symm.toRingHom =
            ψ'.comp (ULift.ringEquiv (R := ZMod ℓ)).symm.toRingHom := Subsingleton.elim _ _
        ext z
        have h' := congrArg (fun φ : ZMod ℓ →+* R => φ (ULift.ringEquiv z)) h
        simpa using h'
      apply Sheaf.hom_ext
      apply sheafify_hom_ext (Scheme.smallEtaleTopology V.left) _ _ R.cond
      apply NatTrans.ext
      funext W
      apply RingCat.hom_ext
      exact key _ _
    obtain ⟨D₀⟩ := wc_et_zmod_pull_data_exists V.hom ℓ
    obtain ⟨ψ'', ⟨θ⟩⟩ := wc_et_etale_pull_restrict_iso V ℓ D₀
    have hψ : ψ'' = ψ := hringU _ _ _
    subst hψ
    have hgen : ∀ (D : wcEtPullData (S := X) (S' := V.left) V.hom ℓ) (i : ℕ)
        (x : wcEtZModExt X ℓ i),
        letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _
        letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing V.left ℓ)) := HasExt.standard _
        haveI := D.additive
        haveI := D.presLim
        haveI := D.presColim
        wcEtPull D i x = (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero i)) (zero_add i) := fun _ _ _ => rfl
    refine ⟨{ D₀ with μ := θ.app (SheafOfModules.unit (wcEtZModRing X ℓ)) ≪≫ (asIso (SheafOfModules.unitToPushforwardObjUnit ψ'')).symm }, ?_⟩
    intro i x
    have h := hgen { D₀ with μ := θ.app (SheafOfModules.unit (wcEtZModRing X ℓ)) ≪≫ (asIso (SheafOfModules.unitToPushforwardObjUnit ψ'')).symm } i x
    dsimp only at h ⊢
    simp only [Iso.trans_inv, Iso.trans_hom, Iso.symm_inv, Iso.symm_hom, asIso_hom, asIso_inv,
      Iso.app_inv, Iso.app_hom] at h
    refine h.trans ?_
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing V.left ℓ)) := HasExt.standard _
    haveI := D₀.additive
    haveI := D₀.presLim
    haveI := D₀.presColim
    have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing V.left ℓ)} {a : ℕ}
        (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
        (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
          (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
      intro A B C' D' a f g z
      rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
    have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing V.left ℓ)} {a : ℕ}
        (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
        (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
          z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
      intro A B C' D' a z f g
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcEtZModRing V.left ℓ)} {a : ℕ}
        (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
        ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
          (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
      intro A B C' D' a f z g
      exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
    have hnat := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.hom
    have hk : (SheafOfModules.unitToPushforwardObjUnit ψ'' ≫
        θ.inv.app (SheafOfModules.unit (wcEtZModRing X ℓ))) ≫
        θ.hom.app (SheafOfModules.unit (wcEtZModRing X ℓ)) =
        SheafOfModules.unitToPushforwardObjUnit ψ'' := by
