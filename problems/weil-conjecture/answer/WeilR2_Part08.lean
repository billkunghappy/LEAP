        refine RingHom.ext fun x => ?_
        have hx := AlgHom.congr_fun this x
        simpa using hx
      let e : Spec (.of (TensorProduct K (MvPolynomial (Fin n) K) (Polynomial K))) ≅
          Spec (.of (MvPolynomial (Fin (n + 1)) K)) :=
        Scheme.Spec.mapIso (Ψ.toRingEquiv.toCommRingCatIso).op
      have he : e.hom = Spec.map (CommRingCat.ofHom Ψ.toRingEquiv.toRingHom) := rfl
      refine ⟨pullbackSpecIso K _ _ ≪≫ e, ?_, ?_⟩
      · rw [Iso.trans_hom, Category.assoc, he, ← Spec.map_comp, ← CommRingCat.ofHom_comp, I1]
        exact pullbackSpecIso_hom_fst K _ _
      · rw [Iso.trans_hom, Category.assoc, he, ← Spec.map_comp, ← CommRingCat.ofHom_comp, I2]
        exact pullbackSpecIso_hom_snd K _ _
    obtain ⟨ι, e₁, e₂⟩ := s1
    obtain ⟨hj, hjr, hjq⟩ := s3
    have hAo : IsOpen {x : Spec (.of (MvPolynomial (Fin (n + 1)) K)) |
        (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} :=
      PrimeSpectrum.isOpen_basicOpen (a := (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K))
    have hBo : IsOpen {x : Spec (.of (MvPolynomial (Fin (n + 1)) K)) |
        ∃ i : Fin n, i.val < k ∧ (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} := by
      have : {x : Spec (.of (MvPolynomial (Fin (n + 1)) K)) |
          ∃ i : Fin n, i.val < k ∧ (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} =
          ⋃ i : Fin n, ⋃ (_ : i.val < k), {x : Spec (.of (MvPolynomial (Fin (n + 1)) K)) |
            (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal} := by
        ext x; simp
      rw [this]
      exact isOpen_iUnion fun i => isOpen_iUnion fun _ =>
        PrimeSpectrum.isOpen_basicOpen (a := (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K))
    have hWo : IsOpen {x : Spec (.of (MvPolynomial (Fin n) K)) |
        ∃ i : Fin n, i.val < k ∧ (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ x.asIdeal} := by
      have : {x : Spec (.of (MvPolynomial (Fin n) K)) |
          ∃ i : Fin n, i.val < k ∧ (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ x.asIdeal} =
          ⋃ i : Fin n, ⋃ (_ : i.val < k), {x : Spec (.of (MvPolynomial (Fin n) K)) |
            (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ x.asIdeal} := by
        ext x; simp
      rw [this]
      exact isOpen_iUnion fun i => isOpen_iUnion fun _ =>
        PrimeSpectrum.isOpen_basicOpen (a := (MvPolynomial.X i : MvPolynomial (Fin n) K))
    let A : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens := ⟨_, hAo⟩
    let B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens := ⟨_, hBo⟩
    let W : (Spec (.of (MvPolynomial (Fin n) K))).Opens := ⟨_, hWo⟩
    have hA : ∀ y, y ∈ A ↔ (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∉ y.asIdeal :=
      fun y => Iff.rfl
    have hB : ∀ y, y ∈ B ↔
        ∃ i : Fin n, i.val < k ∧ (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∉ y.asIdeal :=
      fun y => Iff.rfl
    have hW : ∀ y, y ∈ (W : Set (Spec (.of (MvPolynomial (Fin n) K)))) ↔
        ∃ i : Fin n, i.val < k ∧ (MvPolynomial.X i : MvPolynomial (Fin n) K) ∉ y.asIdeal :=
      fun y => Iff.rfl
    have hAB : ∀ y, y ∈ A ⊓ B ↔ y ∈ A ∧ y ∈ B := fun y => Iff.rfl
    have star : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (x : Spec (.of S)) (r : R),
        r ∈ (Spec.map (CommRingCat.ofHom φ) x).asIdeal ↔ φ r ∈ x.asIdeal := by
      intro R S _ _ φ x r
      exact Iff.rfl
    have C1 : ∀ (w : ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))) (i : Fin n),
        (MvPolynomial.X i : MvPolynomial (Fin n) K) ∈ (Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) w).asIdeal ↔
          (MvPolynomial.X i.succ : MvPolynomial (Fin (n + 1)) K) ∈ (ι.hom w).asIdeal := by
      intro w i
      rw [← e₁, Scheme.Hom.comp_apply, star]
      simp [MvPolynomial.rename_X]
    have C2 : ∀ (w : ↥(Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))))),
        (Polynomial.X : Polynomial K) ∈ (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) w).asIdeal ↔
          (MvPolynomial.X 0 : MvPolynomial (Fin (n + 1)) K) ∈ (ι.hom w).asIdeal := by
      intro w
      rw [← e₂, Scheme.Hom.comp_apply, star]
      simp [Polynomial.aeval_X]
    refine ⟨W, A, B, rfl, rfl, rfl, ?_, ?_, ?_, ?_⟩
    · apply TopologicalSpace.Opens.ext
      rw [TopologicalSpace.Opens.coe_sup, hV]
      ext x
      rw [Set.mem_union, SetLike.mem_coe, SetLike.mem_coe, hA, hB, Set.mem_setOf_eq]
      constructor
      · rintro (h | ⟨i, hi, h⟩)
        · exact ⟨0, by simp, h⟩
        · refine ⟨i.succ, ?_, h⟩
          have := Fin.val_succ i
          omega
      · rintro ⟨i, hi, h⟩
        rcases (Fin.exists_fin_succ (P := fun i : Fin (n + 1) => i.val < k + 1 ∧
            (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) K) ∉ x.asIdeal)).mp ⟨i, hi, h⟩ with
          ⟨_, h0⟩ | ⟨j, hj, hj'⟩
        · exact Or.inl h0
        · refine Or.inr ⟨j, ?_, hj'⟩
          have := Fin.val_succ j
          omega
    · obtain ⟨eA⟩ := s2 _ _ (𝟙 _) _ ι A (by
        intro w
        rw [hA, hjr, Set.mem_setOf_eq, C2]
        exact ⟨fun h => ⟨Scheme.Hom.surjective _ _, h⟩, fun h => h.2⟩)
      exact ⟨eA ≪≫ Limits.pullback.congrHom (Category.id_comp _) hjq⟩
    · obtain ⟨eB⟩ := s2 _ _ W.ι (𝟙 _) ι B (by
        intro w
        rw [hB, Scheme.Opens.range_ι, hW]
        simp only [C1]
        exact ⟨fun h => ⟨h, Scheme.Hom.surjective _ _⟩, fun h => h.1⟩)
      exact ⟨eB ≪≫ Limits.pullback.congrHom rfl (Category.id_comp _)⟩
    · obtain ⟨eAB⟩ := s2 _ _ W.ι _ ι (A ⊓ B) (by
        intro w
        rw [hAB, hA, hB, Scheme.Opens.range_ι, hW, hjr, Set.mem_setOf_eq, C2]
        simp only [C1]
        exact and_comm)
      exact ⟨eAB ≪≫ Limits.pullback.congrHom rfl hjq⟩

  have hLFT : ∀ n : ℕ,
      LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) := by
    intro n
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
    exact RingHom.finiteType_algebraMap.mpr inferInstance

  have sub_of_card : ∀ (X : Scheme.{u}) (q : ℕ), Finite (wcEtCoh X ℓ q) →
      Nat.card (wcEtCoh X ℓ q) ≤ 1 → Subsingleton (wcEtCoh X ℓ q) :=
    fun X q _ h => Finite.card_le_one_iff_subsingleton.mp h
  have card1 : ∀ (X : Scheme.{u}) (q : ℕ), Subsingleton (wcEtCoh X ℓ q) →
      Nat.card (wcEtCoh X ℓ q) ≤ 1 := by
    intro X q h
    haveI := h
    exact Finite.card_le_one_iff_subsingleton.mpr h
  have transS : ∀ {X Y : Scheme.{u}} (e : X ≅ Y) (q : ℕ), Subsingleton (wcEtCoh Y ℓ q) →
      Subsingleton (wcEtCoh X ℓ q) := by
    intro X Y e q h
    obtain ⟨e'⟩ := wc_et_coh_iso_invariance e.hom ℓ q
    haveI := h
    exact e'.symm.subsingleton

  have key : ∀ k n : ℕ, k ≤ n → ∀ (E : (Spec (.of (MvPolynomial (Fin n) K))).Opens),
      (E : Set (Spec (.of (MvPolynomial (Fin n) K)))) =
        {x | ∃ j : Fin n, j.val < k ∧ (MvPolynomial.X j : MvPolynomial (Fin n) K) ∉ x.asIdeal} →
      ∀ q : ℕ, 2 * k ≤ q → Subsingleton (wcEtCoh (E : Scheme.{u}) ℓ q) := by
    intro k
    induction k with
    | zero =>
      intro n _ E hE q _
      apply hempty
      refine ⟨fun y => ?_⟩
      obtain ⟨y, hy⟩ := y
      have hy' : y ∈ (E : Set (Spec (.of (MvPolynomial (Fin n) K)))) := hy
      rw [hE] at hy'
      obtain ⟨j, hj, _⟩ := hy'
      omega
    | succ k ih =>
      intro n' hk E hE q' hq'
      obtain ⟨n, rfl⟩ : ∃ n, n' = n + 1 := ⟨n' - 1, by omega⟩
      obtain ⟨p, rfl⟩ : ∃ p, q' = p + 1 + 1 := ⟨q' - 2, by omega⟩
      obtain ⟨W, A, B, hW, _, _, hAB, ⟨eA⟩, ⟨eB⟩, ⟨eAB⟩⟩ := cover n k E hE
      have hWs : ∀ r, 2 * k ≤ r → Subsingleton (wcEtCoh (W : Scheme.{u}) ℓ r) :=
        fun r hr => ih n (by omega) W hW r hr
      haveI := hLFT n

      have hAB' : Subsingleton (wcEtCoh
          ((A ⊓ B : (Spec (.of (MvPolynomial (Fin (n + 1)) K))).Opens) : Scheme.{u}) ℓ (p + 1)) := by
        have h1 := hWs (p + 1) (by omega)
        have h2 := hWs p (by omega)
        haveI := h1
        haveI := h2
        have h := wc_et_coh_gm_product_card_le K ℓ hℓ hℓK (W : Scheme.{u})
          (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) p
          Finite.of_subsingleton Finite.of_subsingleton
        apply transS eAB
        apply sub_of_card _ _ h.1
        calc _ ≤ _ := h.2
          _ ≤ 1 * 1 := Nat.mul_le_mul (card1 _ _ h1) (card1 _ _ h2)

      have hA' : Subsingleton (wcEtCoh (A : Scheme.{u}) ℓ (p + 1 + 1)) := by
        have h1 := wc_et_affine_space_coh_vanishing K ℓ hℓ hℓK n (p + 1 + 1) (by omega)
        have h2 := wc_et_affine_space_coh_vanishing K ℓ hℓ hℓK n (p + 1) (by omega)
        haveI := h1
        haveI := h2
        have h := wc_et_coh_gm_product_card_le K ℓ hℓ hℓK _
          (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (p + 1)
          Finite.of_subsingleton Finite.of_subsingleton
        apply transS eA
        apply sub_of_card _ _ h.1
        calc _ ≤ _ := h.2
          _ ≤ 1 * 1 := Nat.mul_le_mul (card1 _ _ h1) (card1 _ _ h2)

      have hB' : Subsingleton (wcEtCoh (B : Scheme.{u}) ℓ (p + 1 + 1)) := by
        apply transS eB
        obtain ⟨e⟩ := wc_et_coh_affine_line_invariance K ℓ hℓ hℓK (W : Scheme.{u})
          (W.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)))) (p + 1 + 1)
        haveI := hWs (p + 1 + 1) (by omega)
        exact e.subsingleton

      haveI := hAB'
      haveI := hA'
      haveI := hB'
      have h := wc_et_zariski_mv_card_le _ E A B hAB ℓ (p + 1)
        Finite.of_subsingleton Finite.of_subsingleton Finite.of_subsingleton
      apply sub_of_card _ _ h.1
      calc _ ≤ _ := h.2
        _ ≤ 1 * (1 * 1) :=
          Nat.mul_le_mul (card1 _ _ hAB') (Nat.mul_le_mul (card1 _ _ hA') (card1 _ _ hB'))
  intro n k hk E hE q hq
  exact key k n hk E hE q hq

theorem wc_et_proj_punctured_top_vanishing : ∀ (K : Type u) [Field K] [IsAlgClosed K] (d ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (x₀ : Spec (.of K) ⟶ wcProjK K d), x₀ ≫ wcProjKStr K d = 𝟙 _ → ∀ (U : (wcProjK K d).Opens), (U : Set (wcProjK K d)) = (Set.range x₀)ᶜ → Subsingleton (wcEtCoh U ℓ (2 * d)) :=
by
  classical
  intro K _ _ d ℓ hℓ hℓK x₀ hx₀ U hU

  have hempty : ∀ (Y : Scheme.{u}), IsEmpty Y → ∀ (m q : ℕ), Subsingleton (wcEtCoh Y m q) := by
    intro Y hY m q
    have s1 : ∀ V : Y.Etale, IsEmpty V.left := fun V => ⟨fun x => hY.false (V.hom.base x)⟩
    have s2 : ∀ V : Y.Etale, (⊥ : Sieve V) ∈ Scheme.smallEtaleTopology Y V := by
      intro V
      change (⊥ : Sieve V) ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      exact ((s1 V).false x).elim
    have s4 : ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, Limits.IsZero G := by
      intro G
      have h : Limits.IsZero G.obj :=
        Functor.isZero G.obj (fun X => (Sheaf.isTerminalOfBotCover G X.unop (s2 X.unop)).isZero)
      exact Limits.IsZero.of_full_of_faithful_of_isZero
        (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) G h
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hB := s4 ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    have hsub : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}},
        Limits.IsZero B → Subsingleton (Abelian.Ext A B q) := by
      intro A B hB
      have hx : ∀ x : Abelian.Ext A B q, x = 0 := by
        intro x
        rw [← Abelian.Ext.comp_mk₀_id x, hB.eq_of_src (𝟙 B) 0, Abelian.Ext.mk₀_zero,
          Abelian.Ext.comp_zero]
      exact ⟨fun x y => (hx x).trans (hx y).symm⟩
    haveI := hsub (A := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) hB
    unfold wcEtCoh
    infer_instance

  let P : Fin (d + 1) → (wcProjK K d).Opens := fun i =>
    @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X i)
  let Vk : ℕ → (wcProjK K d).Opens := fun k => ⨆ (i : Fin (d + 1)) (_ : i.val < k), P i
  have hmemV : ∀ (k : ℕ) (y : wcProjK K d), y ∈ Vk k ↔ ∃ i : Fin (d + 1), i.val < k ∧ y ∈ P i := by
    intro k y
    simp only [Vk, TopologicalSpace.Opens.mem_iSup, exists_prop]

  have hclaim : ∀ k : ℕ, k ≤ d → ∀ q : ℕ, 2 * k ≤ q →
      Subsingleton (wcEtCoh ((Vk k : (wcProjK K d).Opens) : Scheme.{u}) ℓ q) := by
    intro k
    induction k with
    | zero =>
      intro _ q _
      apply hempty
      refine ⟨fun y => ?_⟩
      obtain ⟨y, hy⟩ := y
      obtain ⟨i, hi, _⟩ := (hmemV 0 y).mp hy
      omega
    | succ k ih =>
      intro hk q' hq'
      obtain ⟨q, rfl⟩ : ∃ q, q' = q + 1 := ⟨q' - 1, by omega⟩
      obtain ⟨κ, hκ⟩ : ∃ κ : Fin (d + 1), κ.val = k := ⟨⟨k, by omega⟩, rfl⟩
      have hAB : Vk k ⊔ P κ = Vk (k + 1) := by
        apply SetLike.ext
        intro y
        rw [← SetLike.mem_coe, TopologicalSpace.Opens.coe_sup, Set.mem_union, SetLike.mem_coe,
          SetLike.mem_coe, hmemV, hmemV]
        constructor
        · rintro (⟨i, hi, hy⟩ | hy)
          · exact ⟨i, by omega, hy⟩
          · exact ⟨κ, by omega, hy⟩
        · rintro ⟨i, hi, hy⟩
          by_cases h : i.val < k
          · exact Or.inl ⟨i, h, hy⟩
          · have hiκ : i = κ := Fin.ext (by omega)
            rw [hiκ] at hy
            exact Or.inr hy
      have hWset : ((Vk k ⊓ P κ : (wcProjK K d).Opens) : Set (wcProjK K d)) =
          {y | (∃ i : Fin (d + 1), i.val < κ.val ∧ y ∈ P i) ∧ y ∈ P κ} := by
        ext y
        rw [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff, SetLike.mem_coe, SetLike.mem_coe,
          hmemV, hκ]
        exact Iff.rfl
      let E : (Spec (.of (MvPolynomial (Fin d) K))).Opens :=
        ⨆ (j : {j : Fin d // j.val < k}),
          PrimeSpectrum.basicOpen (MvPolynomial.X j.1 : MvPolynomial (Fin d) K)
      have hEset : (E : Set (Spec (.of (MvPolynomial (Fin d) K)))) =
          {x | ∃ j : Fin d, j.val < k ∧ (MvPolynomial.X j : MvPolynomial (Fin d) K) ∉ x.asIdeal} := by
        ext x
        rw [SetLike.mem_coe]
        refine (TopologicalSpace.Opens.mem_iSup (s := fun j : {j : Fin d // j.val < k} =>
          PrimeSpectrum.basicOpen (MvPolynomial.X j.1 : MvPolynomial (Fin d) K))).trans ?_
        constructor
        · rintro ⟨⟨j, hj⟩, hx⟩
          exact ⟨j, hj, (PrimeSpectrum.mem_basicOpen _ _).mp hx⟩
        · rintro ⟨j, hj, hx⟩
          exact ⟨⟨j, hj⟩, (PrimeSpectrum.mem_basicOpen _ _).mpr hx⟩
      have hEset' : (E : Set (Spec (.of (MvPolynomial (Fin d) K)))) =
          {x | ∃ j : Fin d, j.val < κ.val ∧ (MvPolynomial.X j : MvPolynomial (Fin d) K) ∉ x.asIdeal} := by
        rw [hκ]; exact hEset
      obtain ⟨⟨eB⟩, hWE⟩ := wc_proj_chart_partial_punct_iso K d κ
      obtain ⟨eW⟩ := hWE (Vk k ⊓ P κ) E hWset hEset'
      have h1 : Subsingleton (wcEtCoh ((Vk k ⊓ P κ : (wcProjK K d).Opens) : Scheme.{u}) ℓ q) := by
        obtain ⟨e⟩ := wc_et_coh_iso_invariance eW.hom ℓ q
        haveI := wc_et_affine_partial_punct_vanishing K ℓ hℓ hℓK d k (by omega) E hEset q (by omega)
        exact e.symm.subsingleton
      have h2 : Subsingleton (wcEtCoh ((Vk k : (wcProjK K d).Opens) : Scheme.{u}) ℓ (q + 1)) :=
        ih (by omega) (q + 1) (by omega)
      have h3 : Subsingleton (wcEtCoh ((P κ : (wcProjK K d).Opens) : Scheme.{u}) ℓ (q + 1)) := by
        obtain ⟨e⟩ := wc_et_coh_iso_invariance eB.hom ℓ (q + 1)
        haveI := wc_et_affine_space_coh_vanishing K ℓ hℓ hℓK d (q + 1) (by omega)
        exact e.symm.subsingleton
      obtain ⟨hfin, hcard⟩ := wc_et_zariski_mv_card_le (wcProjK K d) (Vk (k + 1)) (Vk k) (P κ) hAB
        ℓ q Finite.of_subsingleton Finite.of_subsingleton Finite.of_subsingleton
      haveI := hfin
      apply Finite.card_le_one_iff_subsingleton.mp
      have ha := Finite.card_le_one_iff_subsingleton.mpr h1
      have hb := Finite.card_le_one_iff_subsingleton.mpr h2
      have hc := Finite.card_le_one_iff_subsingleton.mpr h3
      calc _ ≤ _ := hcard
        _ ≤ 1 * (1 * 1) := Nat.mul_le_mul ha (Nat.mul_le_mul hb hc)

  obtain ⟨L, M, hL, hM, hLM, hML, hvan⟩ := wc_proj_rational_point_linear_forms K d x₀ hx₀
  obtain ⟨g, hg, hpre⟩ := wc_proj_linear_auto_iso K d L M hL hM hLM hML
  haveI := hg
  have hrange : ∀ y, y ∈ Set.range x₀ ↔ y = x₀ (IsLocalRing.closedPoint K) := by
    intro y
    constructor
    · rintro ⟨p, rfl⟩
      rw [show p = IsLocalRing.closedPoint K from Subsingleton.elim (α := PrimeSpectrum K) _ _]
    · rintro rfl
      exact ⟨_, rfl⟩
  have hy0 : ∀ i : Fin (d + 1), i.val < d → g (x₀ (IsLocalRing.closedPoint K)) ∉ P i := by
    intro i hi hmem
    apply hvan i hi
    rw [← hpre i, Scheme.Hom.mem_preimage]
    exact hmem
  have hUeq : U = g ⁻¹ᵁ (Vk d) := by
    apply SetLike.ext
    intro y
    rw [← SetLike.mem_coe, hU, Set.mem_compl_iff, hrange, Scheme.Hom.mem_preimage, hmemV]
    constructor
    · intro hne
      by_contra hno
      push_neg at hno
      exact hne (g.isOpenEmbedding.injective (wc_proj_coord_point_unique K d _ _ hno hy0))
    · rintro ⟨i, hi, hgy⟩ rfl
      exact hy0 i hi hgy
  subst hUeq
  obtain ⟨e⟩ := wc_et_coh_iso_invariance (g ∣_ (Vk d)) ℓ (2 * d)
