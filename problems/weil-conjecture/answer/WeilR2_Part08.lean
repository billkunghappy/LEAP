  have hs1 : ∀ (Y : Scheme.{u}) (m : ℕ), ∃ e : ∀ V : Y.Etale, (wcEtZModRing Y m).obj.obj (Opposite.op V) ≃+* LocallyConstant V.left (ZMod m), ∀ (V V' : Y.Etale) (g : V' ⟶ V) (s : (wcEtZModRing Y m).obj.obj (Opposite.op V)) (x : V'.left), e V' (((wcEtZModRing Y m).obj.map g.op).hom s) x = e V s (g.left x) := by
    intro Y m
