theorem wc_et_kummer_local_thom : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∃ T : wcEtLocThom K ℓ, wcEtThomGL T ∧ wcEtThomNat T ∧ wcEtThomPt T :=
by
  classical
  intro K _ _ ℓ _ hℓ

  have hzs : ∀ (S : Scheme.{u}) (c : ℕ),
      IsClosedImmersion (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤))) := by
    intro S c
    have h1 : AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) S ↘ S) = 𝟙 S := AffineSpace.homOfVector_over _ _
    have : IsClosedImmersion (AffineSpace.homOfVector (𝟙 S) (0 : ULift.{u} (Fin c) → Γ(S, ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) S ↘ S)) := by
      rw [h1]; infer_instance
    exact IsClosedImmersion.of_comp _ (AffineSpace (ULift.{u} (Fin c)) S ↘ S)

  obtain ⟨D0, ω, hω⟩ : ∃ (D0 : ∀ c : ℕ, wcEtPullData (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
      (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) ℓ) (ω : ∀ c, wcEtSuppExt (D0 c) (2 * c)),
      ∀ c, ω c ≠ 0 :=
    ⟨fun c => Classical.choice (wc_et_zmod_pull_data_exists _ ℓ),
      fun c => Classical.choose (wc_et_affine_origin_supp_ext_ne_zero K ℓ hℓ c _),
      fun c => Classical.choose_spec (wc_et_affine_origin_supp_ext_ne_zero K ℓ hℓ c _)⟩

  obtain ⟨T, hT⟩ : ∃ T : wcEtLocThom K ℓ, ∀ {W Z : Scheme.{u}} (fW : W ⟶ Spec (.of K)) (i : Z ⟶ W)
      (D : wcEtPullData i ℓ) (c : ℕ) (h : Fin c → Γ(W, ⊤)), wcEtCutOut i h →
      ∃ (E : wcEtPullData (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) ℓ)
        (γ : wcEtSuppObj D ⟶ E.Φ.obj (wcEtSuppObj (D0 c))),
        wcEtSuppUnitMap D ≫ γ = E.μ.inv ≫ E.Φ.map (wcEtSuppUnitMap (D0 c)) ∧
        Epi (wcEtSuppUnitMap D) ∧ T fW i D c h = wcEtSuppRestr (D0 c) E D γ (2 * c) (ω c) := by
    refine ⟨fun {W Z} fW i D c h => if hc : wcEtCutOut i h then
      wcEtSuppRestr (D0 c) (Classical.choice (wc_et_zmod_pull_data_exists
          (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) ℓ)) D
        (Classical.choose (@wc_et_closed_supp_base_change _ _ _ _ _ _ (hzs _ c)
          (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) i (i ≫ fW)
          (wc_et_zero_section_cutout_pullback K fW i h hc) (D0 c)
          (Classical.choice (wc_et_zmod_pull_data_exists
            (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) ℓ)) D))
        (2 * c) (ω c) else 0, ?_⟩
    intro W Z fW i D c h hc
    have hs := Classical.choose_spec (@wc_et_closed_supp_base_change _ _ _ _ _ _ (hzs _ c)
          (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) i (i ≫ fW)
          (wc_et_zero_section_cutout_pullback K fW i h hc) (D0 c)
          (Classical.choice (wc_et_zmod_pull_data_exists
            (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) ℓ)) D)
    refine ⟨_, _, hs.1, hs.2, ?_⟩
    exact dif_pos hc

  have hle : ∀ {R : Type u} [CommRing R] {c : ℕ} (B : Matrix (Fin c) (Fin c) R) (v : Fin c → R),
      Ideal.span (Set.range (B.mulVec v)) ≤ Ideal.span (Set.range v) := by
    intro R _ c B v
    rw [Ideal.span_le]
    rintro _ ⟨a, rfl⟩
    simp only [Matrix.mulVec, dotProduct]
    exact Ideal.sum_mem _ (fun b _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨b, rfl⟩))
  refine ⟨T, ?_, ?_, ?_⟩
  ·
    intro W Z fW i D c h A hA hgood
    obtain ⟨n, _, _, _, hc⟩ := hgood
    have hspan : Ideal.span (Set.range (A.mulVec h)) = Ideal.span (Set.range h) := by
      apply le_antisymm (hle A h)
      have hh : h = A⁻¹.mulVec (A.mulVec h) := by
        rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul A hA, Matrix.one_mulVec]
      calc Ideal.span (Set.range h) = Ideal.span (Set.range (A⁻¹.mulVec (A.mulVec h))) := by
            rw [← hh]
        _ ≤ _ := hle _ _
    have hc' : wcEtCutOut i (A.mulVec h) := ⟨hc.1, hc.2.1, hc.2.2.trans hspan.symm⟩
    obtain ⟨G, qG, e, act, pr, hGa, hGi, hGs, he, hact, hpr, hσa, hσp, hσ, huniv⟩ :=
      wc_gl_universal_chart K c
    obtain ⟨ψ, gψ, hψa, hψp, hψ⟩ := huniv fW i h A hA hc
    obtain ⟨E1, γ1, hγ1, hep, hT1⟩ := hT fW i D c _ hc'
    obtain ⟨E2, γ2, hγ2, -, hT2⟩ := hT fW i D c h hc
    change T fW i D c (A.mulVec h) = T fW i D c h
    rw [hT1, hT2]
    haveI := hzs (Spec (.of K)) c
    haveI := hzs G c
    haveI := hc.2.1
    obtain ⟨DG⟩ := wc_et_zmod_pull_data_exists
      (AffineSpace.homOfVector (𝟙 G) (0 : ULift.{u} (Fin c) → Γ(G, ⊤))) ℓ
    obtain ⟨Eψ⟩ := wc_et_zmod_pull_data_exists ψ ℓ
    obtain ⟨Eact⟩ := wc_et_zmod_pull_data_exists act ℓ
    obtain ⟨Epr⟩ := wc_et_zmod_pull_data_exists pr ℓ
    obtain ⟨γψ, hγψ, -⟩ := wc_et_closed_supp_base_change _ ψ i gψ hψ DG Eψ D
    obtain ⟨γa, hγa, -⟩ := wc_et_closed_supp_base_change _ act _ qG hact (D0 c) Eact DG
    obtain ⟨γp, hγp, -⟩ := wc_et_closed_supp_base_change _ pr _ qG hpr (D0 c) Epr DG
    rw [wc_et_supp_restr_comp act ψ _ hψa (D0 c) DG D Eact Eψ E1 γa γψ γ1 hγa hγψ hγ1 hep
        (2 * c) (ω c),
      wc_et_supp_restr_comp pr ψ _ hψp (D0 c) DG D Epr Eψ E2 γp γψ γ2 hγp hγψ hγ2 hep
        (2 * c) (ω c)]
    refine congrArg (wcEtSuppRestr DG Eψ D γψ (2 * c)) ?_
    obtain ⟨Eσ⟩ := wc_et_zmod_pull_data_exists
      (AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K) ≫ e)
        (fun j : ULift.{u} (Fin c) => AffineSpace.coord (Spec (.of K)) j)) ℓ
    obtain ⟨Eid⟩ := wc_et_zmod_pull_data_exists (𝟙 (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)))) ℓ
    obtain ⟨γσ, hγσ, hepK⟩ := wc_et_closed_supp_base_change _ _ _ e hσ DG Eσ (D0 c)
    obtain ⟨γid, hγid, -⟩ := wc_et_closed_supp_base_change _ _ _ _
      (IsPullback.id_horiz (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
        (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))) (D0 c) Eid (D0 c)
    have h1 := wc_et_supp_restr_comp act _ _ hσa (D0 c) DG (D0 c) Eact Eσ Eid γa γσ γid hγa hγσ hγid
      hepK (2 * c) (ω c)
    have h2 := wc_et_supp_restr_comp pr _ _ hσp (D0 c) DG (D0 c) Epr Eσ Eid γp γσ γid hγp hγσ hγid
      hepK (2 * c) (ω c)
    haveI := hGa
    haveI := hGi
    haveI := hGs
    exact wc_et_affine_bundle_slice_injective K ℓ hℓ G qG e he c DG Eσ (D0 c) γσ hγσ
      (h1.symm.trans h2)
  ·
    intro W Z W' Z' fW fW' f hf i i' g hsq D Df D' γ hγ c h hgood hgood'
    obtain ⟨n, _, _, _, hc⟩ := hgood
    obtain ⟨n', _, _, _, hc'⟩ := hgood'
    obtain ⟨E, γ1, hγ1, -, hT1⟩ := hT fW i D c h hc
    obtain ⟨E', γ12, hγ12, hep', hT2⟩ := hT fW' i' D' c _ hc'
    change wcEtSuppRestr D Df D' γ (2 * c) (T fW i D c h) =
      T fW' i' D' c (fun j => f.appTop.hom (h j))
    rw [hT1, hT2]
    have hcomp : f ≫ AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down) =
        AffineSpace.homOfVector fW' (fun j : ULift.{u} (Fin c) => f.appTop.hom (h j.down)) := by
      rw [AffineSpace.comp_homOfVector, hf]
      rfl
    exact (wc_et_supp_restr_comp _ f _ hcomp (D0 c) D D' E Df E' γ1 γ γ12 hγ1 hγ hγ12 hep'
      (2 * c) (ω c)).symm
  ·
    intro W Z fW i D c h hsm hsm0 hc hne hzero
    obtain ⟨z⟩ := hne
    obtain ⟨V, -, het, hiso⟩ := wc_smooth_cutout_point_etale_nbhd K fW i c h hsm hsm0 hc z
    obtain ⟨E, γ1, hγ1, -, hT1⟩ := hT fW i D c h hc
    haveI := hc.2.1
    haveI := hzs (Spec (.of K)) c
    have sq1 : IsPullback (i ⁻¹ᵁ V).ι (i ∣_ V) i V.ι := (isPullback_morphismRestrict i V).flip
    have sq3 := sq1.paste_horiz (wc_et_zero_section_cutout_pullback K fW i h hc)
    obtain ⟨D2⟩ := wc_et_zmod_pull_data_exists (i ∣_ V) ℓ
    obtain ⟨EV⟩ := wc_et_zmod_pull_data_exists V.ι ℓ
    obtain ⟨EVφ⟩ := wc_et_zmod_pull_data_exists
      (V.ι ≫ AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) ℓ
    obtain ⟨γ2, hγ2, hep2⟩ := wc_et_closed_supp_base_change i V.ι (i ∣_ V) (i ⁻¹ᵁ V).ι sq1 D EV D2
    obtain ⟨γ12, hγ12, -⟩ := wc_et_closed_supp_base_change _ _ (i ∣_ V) _ sq3 (D0 c) EVφ D2
    have hcomp := wc_et_supp_restr_comp
      (AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down)) V.ι _ rfl
      (D0 c) D D2 E EV EVφ γ1 γ2 γ12 hγ1 hγ2 hγ12 hep2 (2 * c) (ω c)
    have hzero' : T fW i D c h = 0 := hzero
    rw [← hT1, hzero', map_zero] at hcomp
    haveI := het
    have hinj := wc_et_supp_restr_etale_excision_injective
      (V.ι ≫ AffineSpace.homOfVector fW (fun j : ULift.{u} (Fin c) => h j.down))
      (AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)))
      (i ∣_ V) _ sq3 hiso (D0 c) EVφ D2 γ12 hγ12 (2 * c)
    exact hω c (hinj (hcomp.trans (map_zero _).symm))

theorem wc_smooth_pair_local_cutout : ∀ (K : Type u) [Field K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n c : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension (n - c) (i ≫ fX)], c ≤ n → ∀ z : Z, ∃ W : X.Opens, IsAffineOpen W ∧ i z ∈ W ∧ ∃ h : Fin c → Γ(↑W, ⊤), wcEtCutOut (i ∣_ W) h :=
by

  have s1 : ∀ (K : Type u) [Field K] (X Z : Scheme.{u}) (fX : X ⟶ Spec (.of K)) (n m : ℕ) [SmoothOfRelativeDimension n fX] (i : Z ⟶ X) [IsClosedImmersion i] [SmoothOfRelativeDimension m (i ≫ fX)] (z : Z), ∃ (W₀ : X.Opens) (_ : IsAffineOpen W₀) (e : W₀ ≤ fX ⁻¹ᵁ ⊤), i z ∈ W₀ ∧ RingHom.IsStandardSmoothOfRelativeDimension n (fX.appLE ⊤ W₀ e).hom ∧ RingHom.IsStandardSmoothOfRelativeDimension m ((i.app W₀).hom.comp (fX.appLE ⊤ W₀ e).hom) := by
    have s1a : ∀ (K : Type u) [Field K] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m f] (y : Y), ∃ (V : Y.Opens) (_ : IsAffineOpen V) (e : V ≤ f ⁻¹ᵁ ⊤), y ∈ V ∧ RingHom.IsStandardSmoothOfRelativeDimension m (f.appLE ⊤ V e).hom := by
      intro K _ Y f m _ y
      obtain ⟨U, hU, V, hV, hyV, e₀, hstd⟩ :=
        SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := m) (f := f) y
      have hfy : f y ∈ U := (Scheme.Hom.mem_preimage f).mp (e₀ hyV)
      haveI : Subsingleton ↥(Spec (.of K)) := inferInstanceAs (Subsingleton (PrimeSpectrum K))
      have hUtop : U = ⊤ := by
        rw [eq_top_iff]
        intro p _
        rw [Subsingleton.elim p (f y)]
        exact hfy
      refine ⟨V, hV, by rw [Scheme.Hom.preimage_top]; exact le_top, hyV, ?_⟩
      exact (Scheme.Hom.appLE_congr f e₀ hUtop rfl
        (fun φ => RingHom.IsStandardSmoothOfRelativeDimension m φ.hom)).mp hstd
    have s1b : ∀ {Y : Scheme.{u}} {R : Type u} [CommRing R] (V V' : Y.Opens), IsAffineOpen V → ∀ (s : Γ(Y, V)) (hle : V' ≤ V), V' = Y.basicOpen s → ∀ (m : ℕ) (φ : R →+* Γ(Y, V)), RingHom.IsStandardSmoothOfRelativeDimension m φ → RingHom.IsStandardSmoothOfRelativeDimension m ((Y.presheaf.map (homOfLE hle).op).hom.comp φ) := by
      intro Y R _ V V' hV s hle hV' m φ hφ
      letI : Algebra Γ(Y, V) Γ(Y, V') := (Y.presheaf.map (homOfLE hle).op).hom.toAlgebra
      haveI : IsLocalization.Away s Γ(Y, V') := hV.isLocalization_of_eq_basicOpen s (homOfLE hle) hV'
      have h0 := RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
        (Rᵣ := Γ(Y, V')) s
      have := h0.comp hφ
      rw [zero_add] at this
      exact this
    have s1c : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (V : X.Opens) (V' : Z.Opens), IsAffineOpen V → IsAffineOpen V' → ∀ z : Z, i z ∈ V → z ∈ V' → ∃ (s : Γ(X, V)) (t : Γ(Z, V')), i z ∈ X.basicOpen s ∧ i ⁻¹ᵁ X.basicOpen s = Z.basicOpen t := by
      intro X Z i _ V V' hV hV' z hzV hzV'
      have hpre : IsAffineOpen (i ⁻¹ᵁ V) := hV.preimage i
      obtain ⟨f, t, hft, hzf⟩ := exists_basicOpen_le_affine_inter hpre hV' z
        ⟨(Scheme.Hom.mem_preimage i).mpr hzV, hzV'⟩
      obtain ⟨s, rfl⟩ := (isClosedImmersion_iff_isAffineHom.mp inferInstance).2 V hV f
      refine ⟨s, t, ?_, ?_⟩
      · exact (Scheme.Hom.mem_preimage i).mp (by rw [Scheme.preimage_basicOpen]; exact hzf)
      · rw [Scheme.preimage_basicOpen]; exact hft
    intro K _ X Z fX n m _ i _ _ z
    obtain ⟨V, hV, eV, hzV, stdV⟩ := s1a K X fX n (i z)
    obtain ⟨V', hV', eV', hzV', stdV'⟩ := s1a K Z (i ≫ fX) m z
    obtain ⟨s, t, hs, hpre⟩ := s1c i V V' hV hV' z hzV hzV'
    have etop : ∀ {Y : Scheme.{u}} (f : Y ⟶ Spec (.of K)) (W : Y.Opens), W ≤ f ⁻¹ᵁ ⊤ :=
      fun f W => by rw [Scheme.Hom.preimage_top]; exact le_top
    refine ⟨X.basicOpen s, hV.basicOpen s, etop fX _, hs, ?_, ?_⟩
    · have h1 := Scheme.Hom.appLE_map fX eV (homOfLE (X.basicOpen_le s)).op
      have h2 := s1b V (X.basicOpen s) hV s (X.basicOpen_le s) rfl n _ stdV
      rw [← CommRingCat.hom_comp, h1] at h2
      exact h2
    · have h3 : (i.app (X.basicOpen s)).hom.comp (fX.appLE ⊤ (X.basicOpen s) (etop fX _)).hom =
          ((i ≫ fX).appLE ⊤ (i ⁻¹ᵁ X.basicOpen s) (etop _ _)).hom := by
        rw [← CommRingCat.hom_comp, ← Scheme.Hom.appLE_eq_app, Scheme.Hom.appLE_comp_appLE]
      rw [h3]
      refine (Scheme.Hom.appLE_congr (i ≫ fX) (etop _ _) rfl hpre
        (fun φ => RingHom.IsStandardSmoothOfRelativeDimension m φ.hom)).mpr ?_
      have h4 := Scheme.Hom.appLE_map (i ≫ fX) eV' (homOfLE (Z.basicOpen_le t)).op
      have h5 := s1b V' (Z.basicOpen t) hV' t (Z.basicOpen_le t) rfl m _ stdV'
      rw [← CommRingCat.hom_comp, h4] at h5
      exact h5

  have s3a : ∀ (A k M N Q : Type u) [CommRing A] [Field k] [Algebra A k] [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N] [AddCommGroup Q] [Module A Q] (f : M →ₗ[A] N) (g : N →ₗ[A] Q) (l : N →ₗ[A] M), Function.Exact f g → Function.Surjective g → l ∘ₗ f = LinearMap.id → Module.Finite k (TensorProduct A k N) → Module.Finite k (TensorProduct A k M) ∧ Module.finrank k (TensorProduct A k M) + Module.finrank k (TensorProduct A k Q) = Module.finrank k (TensorProduct A k N) := by
    intro A k M N Q _ _ _ _ _ _ _ _ _ f g l hfg hg hl hN
    let e := ((Function.Exact.splitInjectiveEquiv hfg hg) ⟨l, hl⟩).1
    let E : TensorProduct A k N ≃ₗ[k] TensorProduct A k M × TensorProduct A k Q :=
      (LinearEquiv.baseChange A k N (M × Q) e).trans (TensorProduct.prodRight A k k M Q)
    haveI : Module.Finite k (TensorProduct A k M × TensorProduct A k Q) := Module.Finite.equiv E
    haveI : Module.Finite k (TensorProduct A k M) :=
      Module.Finite.of_surjective (LinearMap.fst k (TensorProduct A k M) (TensorProduct A k Q))
        LinearMap.fst_surjective
    haveI : Module.Finite k (TensorProduct A k Q) :=
      Module.Finite.of_surjective (LinearMap.snd k (TensorProduct A k M) (TensorProduct A k Q))
        LinearMap.snd_surjective
    refine ⟨inferInstance, ?_⟩
    rw [E.finrank_eq, Module.finrank_prod]

  have s3b : ∀ (A B k F : Type u) [CommRing A] [CommRing B] [Field k] [Algebra A B] [Algebra A k] [AddCommGroup F] [Module A F] [Module B F] [IsScalarTower A B F], Function.Surjective (algebraMap A B) → RingHom.ker (algebraMap A B) ≤ RingHom.ker (algebraMap A k) → ∀ r : ℕ, Module.Free B F → Module.Finite B F → Module.finrank B F = r → Module.Finite k (TensorProduct A k F) ∧ Module.finrank k (TensorProduct A k F) = r := by
    intro A B k F _ _ _ _ _ _ _ _ _ hsurj hker r _ _ hr
    haveI : Nontrivial B := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      have h1 : (1 : A) ∈ RingHom.ker (algebraMap A B) := by
        rw [RingHom.mem_ker, map_one]; exact h01.symm
      have h2 := hker h1
      rw [RingHom.mem_ker, map_one] at h2
      exact one_ne_zero h2
    let β : B →+* k := (algebraMap A B).liftOfSurjective hsurj ⟨algebraMap A k, hker⟩
    have hβ : ∀ x : A, β (algebraMap A B x) = algebraMap A k x := fun x =>
      RingHom.liftOfSurjective_comp_apply _ _ _ x
    let βA : B →ₗ[A] k :=
      { toFun := β
        map_add' := map_add β
        map_smul' := fun x b => by
          simp only [RingHom.id_apply, Algebra.smul_def, map_mul, hβ] }
    have hβA : ∀ b, βA b = β b := fun _ => rfl
    let μ : TensorProduct A k B →ₗ[k] k := LinearMap.liftBaseChange k βA
    let ν : k →ₗ[k] TensorProduct A k B := LinearMap.toSpanSingleton k _ ((1 : k) ⊗ₜ[A] (1 : B))
    have h₁ : μ ∘ₗ ν = LinearMap.id := by
      apply LinearMap.ext_ring
      show LinearMap.liftBaseChange k βA ((1 : k) • ((1 : k) ⊗ₜ[A] (1 : B))) = 1
      rw [one_smul, LinearMap.liftBaseChange_tmul, hβA, map_one, one_smul]
    have h₂ : ν ∘ₗ μ = LinearMap.id := by
      apply LinearMap.ext; intro t
      induction t using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]
      | tmul a b =>
        obtain ⟨x, rfl⟩ := hsurj b
        show (LinearMap.liftBaseChange k βA (a ⊗ₜ[A] algebraMap A B x)) • ((1 : k) ⊗ₜ[A] (1 : B)) =
          a ⊗ₜ[A] algebraMap A B x
        rw [LinearMap.liftBaseChange_tmul, hβA, hβ, TensorProduct.smul_tmul', smul_eq_mul,
          smul_eq_mul, mul_one, mul_comm, ← Algebra.smul_def, TensorProduct.smul_tmul,
          Algebra.algebraMap_eq_smul_one]
      | add s t hs ht => rw [map_add, hs, ht, map_add]
    let μe : TensorProduct A k B ≃ₗ[k] k := LinearEquiv.ofLinear μ ν h₁ h₂
    let b := Module.finBasisOfFinrankEq B F hr
    let E₁ : F ≃ₗ[A] (Fin r → B) := b.equivFun.restrictScalars A
    let E : TensorProduct A k F ≃ₗ[k] (Fin r → k) :=
      ((LinearEquiv.baseChange A k _ _ E₁).trans (TensorProduct.piRight A k k (fun _ : Fin r => B))).trans
        (LinearEquiv.piCongrRight (fun _ => μe))
    haveI : Module.Finite k (TensorProduct A k F) := Module.Finite.equiv E.symm
    exact ⟨inferInstance, by rw [E.finrank_eq, Module.finrank_fin_fun]⟩

  have s3 : ∀ (R A B : Type u) [CommRing R] [CommRing A] [CommRing B] (φ : R →+* A) (π : A →+* B) (n m : ℕ), Function.Surjective π → RingHom.IsStandardSmoothOfRelativeDimension n φ → RingHom.IsStandardSmoothOfRelativeDimension m (π.comp φ) → ∀ (k : Type u) [Field k] [Algebra A k], RingHom.ker π ≤ RingHom.ker (algebraMap A k) → (RingHom.ker π).FG ∧ Module.Finite k (TensorProduct A k (RingHom.ker π).Cotangent) ∧ Module.finrank k (TensorProduct A k (RingHom.ker π).Cotangent) + m = n := by
    intro R A B _ _ _ φ π n m hπ hstdA hstdB k _ _ hker
    letI : Algebra R A := φ.toAlgebra
    letI : Algebra A B := π.toAlgebra
    letI : Algebra R B := (π.comp φ).toAlgebra
    haveI : IsScalarTower R A B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI hA : Algebra.IsStandardSmoothOfRelativeDimension n R A := hstdA
    haveI hB : Algebra.IsStandardSmoothOfRelativeDimension m R B := hstdB
    haveI : Algebra.IsStandardSmooth R A := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI : Algebra.IsStandardSmooth R B := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth m
    have hsurj : Function.Surjective (algebraMap A B) := hπ
    have hkerA : RingHom.ker (algebraMap A B) ≤ RingHom.ker (algebraMap A k) := hker
    haveI : Nontrivial B := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      have h1 : (1 : A) ∈ RingHom.ker π := by
        rw [RingHom.mem_ker, map_one]; exact h01.symm
      have h2 := hker h1
      rw [RingHom.mem_ker, map_one] at h2
      exact one_ne_zero h2
    haveI : Nontrivial A := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      have := congrArg π h01
      rw [map_zero, map_one] at this
      exact zero_ne_one this
    have hFG : (RingHom.ker π).FG := by
      haveI : Algebra.FinitePresentation R A := Algebra.IsStandardSmooth.finitePresentation
      haveI : Algebra.FinitePresentation R B := Algebra.IsStandardSmooth.finitePresentation
      exact Algebra.FinitePresentation.ker_fG_of_surjective (IsScalarTower.toAlgHom R A B) hπ
    have hex := KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange R A B hsurj
    have hgs := KaehlerDifferential.mapBaseChange_surjective R A B hsurj
    haveI : Algebra.FormallySmooth R B := inferInstance
    obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := R) (A := B) (P := A)
      hsurj).mp inferInstance
    have hrA : Module.finrank A Ω[A⁄R] = n :=
      Module.finrank_eq_of_rank_eq (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential n)
    have hrB : Module.finrank B Ω[B⁄R] = m :=
      Module.finrank_eq_of_rank_eq (Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential m)
    haveI : Module.Free A Ω[A⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    haveI : Module.Free B Ω[B⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hrN : Module.finrank B (TensorProduct A B Ω[A⁄R]) = n := by
      rw [Module.finrank_baseChange, hrA]
    obtain ⟨hNfin, hNr⟩ := s3b A B k (TensorProduct A B Ω[A⁄R]) hsurj hkerA n inferInstance
      inferInstance hrN
    obtain ⟨-, hQr⟩ := s3b A B k Ω[B⁄R] hsurj hkerA m inferInstance inferInstance hrB
    obtain ⟨hMfin, hMr⟩ := s3a A k _ _ _ (KaehlerDifferential.kerCotangentToTensor R A B)
      ((KaehlerDifferential.mapBaseChange R A B).restrictScalars A) l hex hgs hl hNfin
    rw [hNr, hQr] at hMr
    exact ⟨hFG, hMfin, hMr⟩

  have s4 : ∀ (A k M : Type u) [CommRing A] [Field k] [Algebra A k] [AddCommGroup M] [Module A M] (c : ℕ), Module.Finite k (TensorProduct A k M) → Module.finrank k (TensorProduct A k M) = c → ∃ m : Fin c → M, Submodule.span k (Set.range fun j => (1 : k) ⊗ₜ[A] m j) = ⊤ := by
    intro A k M _ _ _ _ _ c hfin hc
    have hS : Submodule.span k (Set.range fun x : M => (1 : k) ⊗ₜ[A] x) = ⊤ := by
      rw [eq_top_iff]
      rintro t -
      induction t using TensorProduct.induction_on with
      | zero => exact zero_mem _
      | tmul a x =>
        have : a ⊗ₜ[A] x = a • ((1 : k) ⊗ₜ[A] x) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [this]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨x, rfl⟩)
      | add x y hx hy => exact add_mem hx hy
    obtain ⟨T, hTS, hTspan, hTli⟩ := exists_linearIndependent k (Set.range fun x : M => (1 : k) ⊗ₜ[A] x)
    have hTfin : T.Finite := LinearIndependent.setFinite hTli
    haveI : Fintype T := hTfin.fintype
    have hTtop : Submodule.span k T = ⊤ := hTspan.trans hS
    let b : Module.Basis T k (TensorProduct A k M) :=
      Module.Basis.mk hTli (le_of_eq (by rw [Subtype.range_coe, hTtop]))
    have hcard : Fintype.card T = c := by rw [← hc, Module.finrank_eq_card_basis b]
    let σ := Fintype.equivFinOfCardEq hcard
    have hx : ∀ t : T, ∃ x : M, (1 : k) ⊗ₜ[A] x = t := fun t => hTS t.2
    choose x hx using hx
    refine ⟨fun j => x (σ.symm j), ?_⟩
    have : Set.range (fun j => (1 : k) ⊗ₜ[A] x (σ.symm j)) = T := by
      ext t; constructor
      · rintro ⟨j, rfl⟩; show (1 : k) ⊗ₜ[A] x (σ.symm j) ∈ T; rw [hx]; exact (σ.symm j).2
      · intro ht
        refine ⟨σ ⟨t, ht⟩, ?_⟩
        show (1 : k) ⊗ₜ[A] x (σ.symm (σ ⟨t, ht⟩)) = t
        rw [Equiv.symm_apply_apply, hx]
    rw [this, hTtop]

  have s5 : ∀ (A : Type u) [CommRing A] (I : Ideal A), I.FG → ∀ (q : Ideal A) [q.IsPrime], I ≤ q → ∀ (c : ℕ) (h : Fin c → ↥I), Submodule.span q.ResidueField (Set.range fun j => (1 : q.ResidueField) ⊗ₜ[A] I.toCotangent (h j)) = ⊤ → ∃ g : A, g ∉ q ∧ ∀ a ∈ I, g * a ∈ Ideal.span (Set.range fun j => (h j : A)) := by
    intro A _ I hFG q _ hIq c h hspan
    obtain ⟨N', hN'⟩ : ∃ N' : Submodule A I,
        N' = Submodule.comap I.subtype (Ideal.span (Set.range fun j => (h j : A))) := ⟨_, rfl⟩
    haveI : Module.Finite A I := Module.Finite.iff_fg.mpr hFG
    haveI : Module.Finite A (I ⧸ N') :=
      Module.Finite.of_surjective N'.mkQ (Submodule.mkQ_surjective _)
    have hzero : ∀ (r : A), r ∈ I → ∀ (y : I ⧸ N'), r • ((1 : q.ResidueField) ⊗ₜ[A] y) = 0 := by
      intro r hr y
      rw [TensorProduct.smul_tmul', Algebra.smul_def, mul_one,
        (Ideal.algebraMap_residueField_eq_zero).mpr (hIq hr), TensorProduct.zero_tmul]
    let φ₀ : I →ₗ[A] TensorProduct A q.ResidueField (I ⧸ N') :=
      (TensorProduct.mk A q.ResidueField (I ⧸ N') 1) ∘ₗ N'.mkQ
    have hφ₀ : I • (⊤ : Submodule A I) ≤ LinearMap.ker φ₀ := by
      rw [Submodule.smul_le]
      intro r hr y _
      rw [LinearMap.mem_ker, map_smul]
      exact hzero r hr _
    obtain ⟨ψ₀, hψdef⟩ : ∃ ψ₀ : I.Cotangent →ₗ[A] TensorProduct A q.ResidueField (I ⧸ N'),
        ψ₀ = (I • (⊤ : Submodule A I)).liftQ φ₀ hφ₀ := ⟨_, rfl⟩
    have hψ₀ : ∀ x : I, ψ₀ (I.toCotangent x) = (1 : q.ResidueField) ⊗ₜ[A] N'.mkQ x := by
      intro x; rw [hψdef]; rfl
    obtain ⟨Ψ, hΨdef⟩ : ∃ Ψ : TensorProduct A q.ResidueField I.Cotangent →ₗ[q.ResidueField]
        TensorProduct A q.ResidueField (I ⧸ N'), Ψ = LinearMap.liftBaseChange q.ResidueField ψ₀ :=
      ⟨_, rfl⟩
    have hΨ1 : ∀ x : I, Ψ ((1 : q.ResidueField) ⊗ₜ[A] I.toCotangent x) =
        (1 : q.ResidueField) ⊗ₜ[A] N'.mkQ x := by
      intro x; rw [hΨdef, LinearMap.liftBaseChange_tmul, one_smul, hψ₀]
    have hΨ : Ψ = 0 := by
      apply LinearMap.ext_on_range hspan
      intro j
      show Ψ ((1 : q.ResidueField) ⊗ₜ[A] I.toCotangent (h j)) = 0
      rw [hΨ1]
      have : N'.mkQ (h j) = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, hN', Submodule.mem_comap]
        exact Submodule.subset_span ⟨j, rfl⟩
      rw [this, TensorProduct.tmul_zero]
    have hall : ∀ s : TensorProduct A q.ResidueField (I ⧸ N'), s = 0 := by
      intro s
      induction s using TensorProduct.induction_on with
      | zero => rfl
      | tmul a y =>
        obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective N' y
        have h1 : (1 : q.ResidueField) ⊗ₜ[A] N'.mkQ x = 0 := by
          rw [← hΨ1, hΨ, LinearMap.zero_apply]
        rw [show a ⊗ₜ[A] N'.mkQ x = a • ((1 : q.ResidueField) ⊗ₜ[A] N'.mkQ x) by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one], h1, smul_zero]
      | add x y hx hy => rw [hx, hy, add_zero]
    have hsub : Subsingleton (TensorProduct A q.ResidueField (I ⧸ N')) :=
      ⟨fun s t => by rw [hall s, hall t]⟩
    have hnotmem : (⟨q, inferInstance⟩ : PrimeSpectrum A) ∉ Module.support A (I ⧸ N') := by
      rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct]
      exact not_nontrivial_iff_subsingleton.mpr hsub
    rw [Module.mem_support_iff_of_finite] at hnotmem
    obtain ⟨g, hgann, hgq⟩ := SetLike.not_le_iff_exists.mp hnotmem
    refine ⟨g, hgq, fun a ha => ?_⟩
    have h1 : g • N'.mkQ ⟨a, ha⟩ = 0 := Module.mem_annihilator.mp hgann _
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, hN',
      Submodule.mem_comap] at h1
    exact h1

  have s6 : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (W₀ : X.Opens), IsAffineOpen W₀ → ∀ (g : Γ(X, W₀)) (c : ℕ) (h : Fin c → Γ(X, W₀)), (∀ j, (i.app W₀).hom (h j) = 0) → (∀ a : Γ(X, W₀), (i.app W₀).hom a = 0 → g * a ∈ Ideal.span (Set.range h)) → ∀ (e : ⊤ ≤ (X.basicOpen g).ι ⁻¹ᵁ W₀), IsAffine ↑(X.basicOpen g) ∧ IsClosedImmersion (i ∣_ X.basicOpen g) ∧ RingHom.ker (i ∣_ X.basicOpen g).appTop.hom = Ideal.span (Set.range (fun j => ((X.basicOpen g).ι.appLE W₀ ⊤ e).hom (h j))) := by
    intro X Z i _ W₀ hW₀ g c h h0 hg e
    have trio : ∀ {Y : Scheme.{u}} (V V' : Y.Opens), IsAffineOpen V → ∀ (s : Γ(Y, V)), V' = Y.basicOpen s → ∀ (e : ⊤ ≤ V'.ι ⁻¹ᵁ V), IsUnit ((V'.ι.appLE V ⊤ e).hom s) ∧ (∀ b : Γ(V', ⊤), ∃ (m : ℕ) (a : Γ(Y, V)), b * (V'.ι.appLE V ⊤ e).hom s ^ m = (V'.ι.appLE V ⊤ e).hom a) ∧ (∀ a : Γ(Y, V), (V'.ι.appLE V ⊤ e).hom a = 0 → ∃ k : ℕ, s ^ k * a = 0) := by
      intro Y V V' hV s hV' e
      have hle : V'.ι ''ᵁ ⊤ ≤ V := by rw [Scheme.Opens.ι_image_top, hV']; exact Y.basicOpen_le s
      letI : Algebra Γ(Y, V) Γ(Y, V'.ι ''ᵁ ⊤) := (Y.presheaf.map (homOfLE hle).op).hom.toAlgebra
      haveI : IsLocalization.Away s Γ(Y, V'.ι ''ᵁ ⊤) :=
        hV.isLocalization_of_eq_basicOpen s (homOfLE hle) (by rw [Scheme.Opens.ι_image_top, hV'])
      have hψeq : (V'.ι.appLE V ⊤ e).hom = algebraMap Γ(Y, V) Γ(Y, V'.ι ''ᵁ ⊤) := by
        rw [RingHom.algebraMap_toAlgebra, Scheme.Opens.ι_appLE]
        rfl
      refine ⟨?_, ?_, ?_⟩
      · have := IsLocalization.Away.algebraMap_isUnit (S := Γ(Y, V'.ι ''ᵁ ⊤)) s
        rw [← hψeq] at this
        exact this
      · intro b
        obtain ⟨m, a, hb⟩ := IsLocalization.Away.surj (S := Γ(Y, V'.ι ''ᵁ ⊤)) s b
        rw [← hψeq] at hb
        exact ⟨m, a, hb⟩
      · intro a ha
        have ha' : algebraMap Γ(Y, V) Γ(Y, V'.ι ''ᵁ ⊤) a = 0 := by rw [← hψeq]; exact ha
        obtain ⟨⟨_, k, rfl⟩, hk⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers s) Γ(Y, V'.ι ''ᵁ ⊤) a).mp ha'
        exact ⟨k, hk⟩
    obtain ⟨hu, hs, -⟩ := trio W₀ (X.basicOpen g) hW₀ g rfl e
    have hZa : IsAffineOpen (i ⁻¹ᵁ W₀) := hW₀.preimage i
    have e' : ⊤ ≤ (i ⁻¹ᵁ X.basicOpen g).ι ⁻¹ᵁ (i ⁻¹ᵁ W₀) := by
      intro s _
      rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage]
      apply X.basicOpen_le g
      have : (i ⁻¹ᵁ X.basicOpen g).ι s ∈ Set.range (i ⁻¹ᵁ X.basicOpen g).ι := ⟨s, rfl⟩
      rw [Scheme.Opens.range_ι] at this
      exact (Scheme.Hom.mem_preimage i).mp this
    obtain ⟨-, -, hρ⟩ := trio (i ⁻¹ᵁ W₀) (i ⁻¹ᵁ X.basicOpen g) hZa ((i.app W₀).hom g)
      (Scheme.preimage_basicOpen i g) e'
    have hcomm : ∀ a, (i ∣_ X.basicOpen g).appTop.hom (((X.basicOpen g).ι.appLE W₀ ⊤ e).hom a) =
        ((i ⁻¹ᵁ X.basicOpen g).ι.appLE (i ⁻¹ᵁ W₀) ⊤ e').hom ((i.app W₀).hom a) := by
      intro a
      have key : ∀ (f f' : ↑(i ⁻¹ᵁ X.basicOpen g) ⟶ X), f = f' → ∀ e₁ e₂,
          f.appLE W₀ ⊤ e₁ = f'.appLE W₀ ⊤ e₂ := by
        rintro f _ rfl e₁ e₂; rfl
      have h1 := Scheme.Hom.appLE_comp_appLE (i ∣_ X.basicOpen g) (X.basicOpen g).ι W₀ ⊤ ⊤ e
        (le_of_eq (Scheme.Hom.preimage_top _).symm)
      have h2 : (i ∣_ X.basicOpen g).appLE ⊤ ⊤ (le_of_eq (Scheme.Hom.preimage_top _).symm) =
          (i ∣_ X.basicOpen g).appTop := Scheme.Hom.appLE_eq_app _
      have h3 := Scheme.Hom.appLE_comp_appLE (i ⁻¹ᵁ X.basicOpen g).ι i W₀ (i ⁻¹ᵁ W₀) ⊤ le_rfl e'
      have h4 : i.appLE W₀ (i ⁻¹ᵁ W₀) le_rfl = i.app W₀ := Scheme.Hom.appLE_eq_app _
      rw [h2] at h1
      rw [h4] at h3
      have hcat : (X.basicOpen g).ι.appLE W₀ ⊤ e ≫ (i ∣_ X.basicOpen g).appTop =
          i.app W₀ ≫ (i ⁻¹ᵁ X.basicOpen g).ι.appLE (i ⁻¹ᵁ W₀) ⊤ e' := by
        rw [h1, h3]
        exact key _ _ (morphismRestrict_ι i _) _ _
      have := congrArg (fun φ => φ.hom a) hcat
      exact this
    refine ⟨hW₀.basicOpen g, inferInstance, ?_⟩
    apply le_antisymm
    · intro b hb
      rw [RingHom.mem_ker] at hb
      obtain ⟨m, a, hma⟩ := hs b
      have hρa : ((i ⁻¹ᵁ X.basicOpen g).ι.appLE (i ⁻¹ᵁ W₀) ⊤ e').hom ((i.app W₀).hom a) = 0 := by
        rw [← hcomm, ← hma, map_mul, hb, zero_mul]
      obtain ⟨k, hk⟩ := hρ _ hρa
      have hk' : (i.app W₀).hom (g ^ k * a) = 0 := by rw [map_mul, map_pow]; exact hk
      have hga := hg _ hk'
      have h1 : ((X.basicOpen g).ι.appLE W₀ ⊤ e).hom (g * (g ^ k * a)) ∈
          Ideal.span (Set.range fun j => ((X.basicOpen g).ι.appLE W₀ ⊤ e).hom (h j)) := by
        have := Ideal.mem_map_of_mem ((X.basicOpen g).ι.appLE W₀ ⊤ e).hom hga
        rw [Ideal.map_span, ← Set.range_comp] at this
        exact this
      have h2 : ((X.basicOpen g).ι.appLE W₀ ⊤ e).hom (g * (g ^ k * a)) =
          b * ((X.basicOpen g).ι.appLE W₀ ⊤ e).hom g ^ (m + k + 1) := by
        rw [map_mul, map_mul, map_pow, ← hma]; ring
      rw [h2] at h1
      exact (Ideal.mul_unit_mem_iff_mem _ (hu.pow _)).mp h1
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, hcomm, h0 j, map_zero]

  intro K _ X Z fX n c _ i _ _ hcn z
  obtain ⟨W₀, hW₀, e, hz, hstdA, hstdB⟩ := s1 K X Z fX n (n - c) i z
  have hπ : Function.Surjective (i.app W₀).hom :=
    (isClosedImmersion_iff_isAffineHom.mp inferInstance).2 W₀ hW₀
  let q : Ideal Γ(X, W₀) := RingHom.ker (X.evaluation W₀ (i z) hz).hom
  haveI : q.IsPrime := RingHom.ker_isPrime _

  have hIq : RingHom.ker (i.app W₀).hom ≤ q := by
    intro a ha
    rw [RingHom.mem_ker] at ha
    show (X.evaluation W₀ (i z) hz).hom a = 0
    rw [Scheme.evaluation_eq_zero_iff_notMem_basicOpen]
    intro hmem
    have hz' : z ∈ i ⁻¹ᵁ X.basicOpen a := (Scheme.Hom.mem_preimage i).mpr hmem
    rw [Scheme.preimage_basicOpen, ha, Scheme.basicOpen_zero] at hz'
    exact hz'
  have hker : RingHom.ker (i.app W₀).hom ≤ RingHom.ker (algebraMap Γ(X, W₀) q.ResidueField) := by
    rw [Ideal.ker_algebraMap_residueField]; exact hIq
  obtain ⟨hFG, hfin, hrank⟩ := s3 _ _ _ (fX.appLE ⊤ W₀ e).hom (i.app W₀).hom n (n - c) hπ hstdA
    hstdB q.ResidueField hker
  have hc : Module.finrank q.ResidueField (TensorProduct Γ(X, W₀) q.ResidueField
      (RingHom.ker (i.app W₀).hom).Cotangent) = c := by omega
  obtain ⟨mgen, hspan⟩ := s4 _ q.ResidueField _ c hfin hc
  choose h₀ hh₀ using fun j => Ideal.toCotangent_surjective _ (mgen j)
  have hspan' : Submodule.span q.ResidueField (Set.range fun j => (1 : q.ResidueField) ⊗ₜ[Γ(X, W₀)]
      (RingHom.ker (i.app W₀).hom).toCotangent (h₀ j)) = ⊤ := by
    simp only [hh₀]; exact hspan
  obtain ⟨g, hgq, hgI⟩ := s5 _ _ hFG q hIq c h₀ hspan'
  have e₂ : ⊤ ≤ (X.basicOpen g).ι ⁻¹ᵁ W₀ := by
    intro s _
    rw [Scheme.Hom.mem_preimage]
    apply X.basicOpen_le g
    have : (X.basicOpen g).ι s ∈ Set.range (X.basicOpen g).ι := ⟨s, rfl⟩
    rw [Scheme.Opens.range_ι] at this
    exact this
  obtain ⟨hWa, hcl, hkerW⟩ := s6 i W₀ hW₀ g c (fun j => (h₀ j : Γ(X, W₀)))
    (fun j => RingHom.mem_ker.mp (h₀ j).2) (fun a ha => hgI a (RingHom.mem_ker.mpr ha)) e₂
  refine ⟨X.basicOpen g, hW₀.basicOpen g, ?_, _, hWa, hcl, hkerW⟩
  by_contra hn
  apply hgq
  show (X.evaluation W₀ (i z) hz).hom g = 0
  exact (Scheme.evaluation_eq_zero_iff_notMem_basicOpen _ _ _ _).mpr hn

theorem wc_et_supp_ext_empty : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) (n : ℕ) (D : wcEtPullData i n), IsEmpty Z → ∀ q : ℕ, Subsingleton (wcEtSuppExt D q) :=
by
  intro X Z i n D hZ q
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X n)) := HasExt.standard _

  have hbot : ∀ U : Z.Etale, (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology Z U := by
    intro U
    have : IsEmpty U.left := ⟨fun x => hZ.false (U.hom.base x)⟩
    have : MorphismProperty.IsStableUnderComposition @Etale :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    unfold Scheme.smallEtaleTopology
    rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology (Q := @Etale) Z le_rfl]
    exact (Scheme.mem_toGrothendieck_smallPretopology _ _).2 (fun x => isEmptyElim x)

  have hzero : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Z n), Limits.IsZero M := by
    intro M
    have hs : ∀ U : (Z.Etale)ᵒᵖ, Subsingleton (M.val.obj U) := by
      intro U
      have ht := Sheaf.isTerminalOfBotCover
        ((SheafOfModules.toSheaf (wcEtZModRing Z n)).obj M) U.unop (hbot U.unop)
      exact AddCommGrpCat.subsingleton_of_isZero ht.isZero
    rw [Limits.IsZero.iff_id_eq_zero]
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro U
    ext m
    exact Subsingleton.elim _ _

  have hP : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).IsRightAdjoint :=
    D.adj.isRightAdjoint
  have hPz : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange i) _ _ D.cont D.φ).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint _
  have hobj : Limits.IsZero (wcEtSuppObj D) :=
    Functor.map_isZero _ (hzero (SheafOfModules.unit (wcEtZModRing Z n)))
  have hall : ∀ e : wcEtSuppExt D q, e = 0 := by
    intro e
    rw [← Abelian.Ext.mk₀_id_comp e, hobj.eq_of_src (𝟙 _) 0, Abelian.Ext.mk₀_zero,
      Abelian.Ext.zero_comp]
  exact ⟨fun a b => (hall a).trans (hall b).symm⟩

theorem wc_sheafOfModules_injective_restriction_surjective : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}] (R : Sheaf J RingCat.{u+1}) (I : SheafOfModules.{u+1} R) [Injective I] {U V : C} (m : U ⟶ V) [Mono m], Function.Surjective (((SheafOfModules.toSheaf R).obj I).obj.map m.op).hom :=
by
  intro C _ J _ _ R I _ U V m _
  let adj := (PresheafOfModules.freeAdjunction.{u+1} R.obj).comp
    (PresheafOfModules.sheafificationAdjunction (𝟙 R.obj))
  have hfree : Mono ((PresheafOfModules.free.{u+1} R.obj).map (uliftYoneda.{u+1}.map m)) := by
    rw [PresheafOfModules.mono_iff_surjective]
    intro X
    have h1 : Mono ((uliftYoneda.{u+1}.map m).app X) :=
      (NatTrans.mono_iff_mono_app _).mp inferInstance X
    have h2 : Function.Injective ((uliftYoneda.{u+1}.map m).app X) := (mono_iff_injective _).mp h1
    rw [PresheafOfModules.free_map_app]
    exact Finsupp.mapDomain_injective h2
  have hL : Mono ((PresheafOfModules.free.{u+1} R.obj ⋙
      PresheafOfModules.sheafification (𝟙 R.obj)).map (uliftYoneda.{u+1}.map m)) := by
    rw [Functor.comp_map]
    exact Functor.map_mono _ _
  intro x
  let b := (adj.homEquiv (uliftYoneda.{u+1}.obj U) I).symm (uliftYonedaEquiv.symm x)
  let c := Injective.factorThru b ((PresheafOfModules.free.{u+1} R.obj ⋙
      PresheafOfModules.sheafification (𝟙 R.obj)).map (uliftYoneda.{u+1}.map m))
  have hc : _ ≫ c = b := Injective.comp_factorThru b _
  have key : uliftYoneda.{u+1}.map m ≫ adj.homEquiv _ I c = uliftYonedaEquiv.symm x := by
    rw [← Adjunction.homEquiv_naturality_left, hc, Equiv.apply_symm_apply]
  refine ⟨uliftYonedaEquiv (adj.homEquiv _ I c), ?_⟩
  have nat := uliftYonedaEquiv_naturality (adj.homEquiv _ I c) m.op
  have e2 : uliftYonedaEquiv (uliftYoneda.{u+1}.map m ≫ adj.homEquiv _ I c) = x := by
    rw [key]; exact Equiv.apply_symm_apply _ _
  exact nat.trans e2

theorem wc_zar_flasque_supp_local_to_global : ∀ (T : Type u) [TopologicalSpace T] (K : CochainComplex ((TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ℕ), (∀ p, Presheaf.IsSheaf (Opens.grothendieckTopology T) (K.X p)) → (∀ (p : ℕ) (W' W : TopologicalSpace.Opens T) (h : W' ≤ W), Function.Surjective ((K.X p).map (homOfLE h).op).hom) → ∀ (O : TopologicalSpace.Opens T) (s : ℕ), (∀ b : ℕ, b ≤ s → ∀ (V : TopologicalSpace.Opens T) (x : T), x ∈ V → ∃ W : TopologicalSpace.Opens T, W ≤ V ∧ x ∈ W ∧ ∀ c : (K.X b).obj (Opposite.op W), ((K.X b).map (homOfLE (inf_le_left : W ⊓ O ≤ W)).op).hom c = 0 → ((K.d b (b + 1)).app (Opposite.op W)).hom c = 0 → ∃ e : (K.X (b - 1)).obj (Opposite.op W), ((K.X (b - 1)).map (homOfLE (inf_le_left : W ⊓ O ≤ W)).op).hom e = 0 ∧ ((K.d (b - 1) b).app (Opposite.op W)).hom e = c) → ∀ c : (K.X s).obj (Opposite.op ⊤), ((K.X s).map (homOfLE (inf_le_left : ⊤ ⊓ O ≤ ⊤)).op).hom c = 0 → ((K.d s (s + 1)).app (Opposite.op ⊤)).hom c = 0 → ∃ e : (K.X (s - 1)).obj (Opposite.op ⊤), ((K.X (s - 1)).map (homOfLE (inf_le_left : ⊤ ⊓ O ≤ ⊤)).op).hom e = 0 ∧ ((K.d (s - 1) s).app (Opposite.op ⊤)).hom e = c :=
by
  intro T _ K hsh hfl O s hloc
  classical

  have rr : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      {A₁ A₂ A₃ : TopologicalSpace.Opens T} (f₁ : A₁ ⟶ A₂) (f₂ : A₂ ⟶ A₃)
      (x : P.obj (Opposite.op A₃)),
      (P.map f₁.op).hom ((P.map f₂.op).hom x) =
        (P.map (homOfLE ((leOfHom f₁).trans (leOfHom f₂))).op).hom x := by
    intro P A₁ A₂ A₃ f₁ f₂ x
    change (P.map f₂.op ≫ P.map f₁.op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have rr2 : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      {A B C D : TopologicalSpace.Opens T} (f₁ : A ⟶ B) (f₂ : B ⟶ D) (g₁ : A ⟶ C) (g₂ : C ⟶ D)
      (x : P.obj (Opposite.op D)),
      (P.map f₁.op).hom ((P.map f₂.op).hom x) = (P.map g₁.op).hom ((P.map g₂.op).hom x) := by
    intro P A B C D f₁ f₂ g₁ g₂ x
    rw [rr, rr]
  have rid : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      {A : TopologicalSpace.Opens T} (f : A ⟶ A) (x : P.obj (Opposite.op A)),
      (P.map f.op).hom x = x := by
    intro P A f x
    obtain rfl : f = 𝟙 A := Subsingleton.elim _ _
    simp
  have nat : ∀ {P R : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (g : P ⟶ R)
      {A A' : TopologicalSpace.Opens T} (f : A ⟶ A') (x : P.obj (Opposite.op A')),
      (g.app (Opposite.op A)).hom ((P.map f.op).hom x) =
        (R.map f.op).hom ((g.app (Opposite.op A')).hom x) := by
    intro P R g A A' f x
    change (P.map f.op ≫ g.app _).hom x = (g.app _ ≫ R.map f.op).hom x
    rw [g.naturality]

  have glue : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Presheaf.IsSheaf (Opens.grothendieckTopology T) P →
      ∀ (κ : Type (u+1)) (V : κ → TopologicalSpace.Opens T)
        (sf : ∀ i, P.obj (Opposite.op (V i))),
      (∀ i j, (P.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op).hom (sf i) =
        (P.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op).hom (sf j)) →
      ∃ x : P.obj (Opposite.op (iSup V)),
        (∀ i, (P.map (homOfLE (le_iSup V i)).op).hom x = sf i) ∧
        ∀ x' : P.obj (Opposite.op (iSup V)),
          (∀ i, (P.map (homOfLE (le_iSup V i)).op).hom x' = sf i) → x' = x := by
    intro P hP κ V sf hc
    have hPt := GrothendieckTopology.HasSheafCompose.isSheaf
      (J := Opens.grothendieckTopology T) (F := forget AddCommGrpCat.{u+1}) P hP
    obtain ⟨x, hx, hu⟩ := TopCat.Presheaf.IsSheaf.isSheafUniqueGluing_types
      (X := TopCat.of T) (F := P ⋙ forget AddCommGrpCat.{u+1}) hPt sf hc
    exact ⟨x, hx, hu⟩
  have sep : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Presheaf.IsSheaf (Opens.grothendieckTopology T) P →
      ∀ (κ : Type (u+1)) (V : κ → TopologicalSpace.Opens T) (U' : TopologicalSpace.Opens T)
        (hV : ∀ i, V i ≤ U'), U' ≤ iSup V → ∀ (x₁ x₂ : P.obj (Opposite.op U')),
      (∀ i, (P.map (homOfLE (hV i)).op).hom x₁ = (P.map (homOfLE (hV i)).op).hom x₂) →
      x₁ = x₂ := by
    intro P hP κ V U' hV hU x₁ x₂ h
    obtain rfl : iSup V = U' := le_antisymm (iSup_le hV) hU
    obtain ⟨x, _, hu⟩ := glue P hP κ V (fun i => (P.map (homOfLE (le_iSup V i)).op).hom x₂)
      (fun i j => by rw [rr, rr])
    rw [hu x₁ h, hu x₂ (fun i => rfl)]

  have s1 : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Presheaf.IsSheaf (Opens.grothendieckTopology T) P →
      ∀ (U : TopologicalSpace.Opens T) (c : P.obj (Opposite.op U)),
      (∀ x ∈ U, ∃ (W : TopologicalSpace.Opens T) (h : W ≤ U), x ∈ W ∧
        (P.map (homOfLE h).op).hom c = 0) → c = 0 := by
    intro P hP U c hc
    choose W hWU hxW hz using hc
    refine sep P hP (ULift.{u+1} {x // x ∈ U}) (fun i => W i.down.1 i.down.2) U
      (fun i => hWU i.down.1 i.down.2) ?_ c 0 ?_
    · intro x hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨x, hx⟩⟩, hxW x hx⟩
    · intro i
      rw [hz, map_zero]

  have s2 : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Presheaf.IsSheaf (Opens.grothendieckTopology T) P →
      (∀ (W' W : TopologicalSpace.Opens T) (h : W' ≤ W), Function.Surjective (P.map (homOfLE h).op).hom) →
      ∀ (W' W : TopologicalSpace.Opens T) (h : W' ≤ W) (σ : P.obj (Opposite.op W')),
      (P.map (homOfLE (inf_le_left : W' ⊓ O ≤ W')).op).hom σ = 0 →
      ∃ τ : P.obj (Opposite.op W), (P.map (homOfLE (inf_le_left : W ⊓ O ≤ W)).op).hom τ = 0 ∧
        (P.map (homOfLE h).op).hom τ = σ := by
    intro P hP hPf W' W h σ hσ
    have hAB : ∀ (A : TopologicalSpace.Opens T) (hA1 : A ≤ W') (hA2 : A ≤ W' ⊓ O),
        (P.map (homOfLE hA1).op).hom σ = 0 := by
      intro A hA1 hA2
      have e := rr P (homOfLE hA2) (homOfLE (inf_le_left : W' ⊓ O ≤ W')) σ
      rw [hσ, map_zero] at e
      exact e.symm
    let Uf : ULift.{u+1} Bool → TopologicalSpace.Opens T := fun i => cond i.down W' (W ⊓ O)
    let sf : ∀ i : ULift.{u+1} Bool, P.obj (Opposite.op (Uf i)) := fun i =>
      match i with
      | ⟨true⟩ => σ
      | ⟨false⟩ => 0
    have hc : ∀ i j, (P.map (homOfLE (inf_le_left : Uf i ⊓ Uf j ≤ Uf i)).op).hom (sf i) =
        (P.map (homOfLE (inf_le_right : Uf i ⊓ Uf j ≤ Uf j)).op).hom (sf j) := by
      rintro ⟨_ | _⟩ ⟨_ | _⟩
      · rfl
      · change (P.map (homOfLE (inf_le_left : (W ⊓ O) ⊓ W' ≤ W ⊓ O)).op).hom 0 =
          (P.map (homOfLE (inf_le_right : (W ⊓ O) ⊓ W' ≤ W')).op).hom σ
        rw [map_zero, hAB ((W ⊓ O) ⊓ W') inf_le_right
          (le_inf inf_le_right (inf_le_left.trans inf_le_right))]
      · change (P.map (homOfLE (inf_le_left : W' ⊓ (W ⊓ O) ≤ W')).op).hom σ =
          (P.map (homOfLE (inf_le_right : W' ⊓ (W ⊓ O) ≤ W ⊓ O)).op).hom 0
        rw [map_zero, hAB (W' ⊓ (W ⊓ O)) inf_le_left
          (le_inf inf_le_left (inf_le_right.trans inf_le_right))]
      · rfl
    obtain ⟨τ₀, hτ₀, -⟩ := glue P hP _ Uf sf hc
    have hU₀ : iSup Uf ≤ W := iSup_le (by rintro ⟨_ | _⟩; exacts [inf_le_left, h])
    obtain ⟨τ, hτ⟩ := hPf _ _ hU₀ τ₀
    refine ⟨τ, ?_, ?_⟩
    · have e := hτ₀ ⟨false⟩
      rw [← hτ, rr] at e
      exact e
    · have e := hτ₀ ⟨true⟩
      rw [← hτ, rr] at e
      exact e

  have s3 : ∀ {P R : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (g : P ⟶ R)
      (SB : ∀ U : TopologicalSpace.Opens T, AddSubgroup (P.obj (Opposite.op U))),
      Presheaf.IsSheaf (Opens.grothendieckTopology T) P →
      Presheaf.IsSheaf (Opens.grothendieckTopology T) R →
      (∀ (U V : TopologicalSpace.Opens T) (h : U ≤ V) (a : P.obj (Opposite.op V)),
        a ∈ SB V → (P.map (homOfLE h).op).hom a ∈ SB U) →
      (∀ (U : TopologicalSpace.Opens T) (a : P.obj (Opposite.op U)),
        (∀ x ∈ U, ∃ (W : TopologicalSpace.Opens T) (h : W ≤ U), x ∈ W ∧
          (P.map (homOfLE h).op).hom a ∈ SB W) → a ∈ SB U) →
      (∀ (U V : TopologicalSpace.Opens T) (h : U ≤ V) (a : P.obj (Opposite.op U)),
        a ∈ SB U → (g.app (Opposite.op U)).hom a = 0 →
        ∃ a' : P.obj (Opposite.op V), a' ∈ SB V ∧ (g.app (Opposite.op V)).hom a' = 0 ∧
          (P.map (homOfLE h).op).hom a' = a) →
      ∀ (U : TopologicalSpace.Opens T) (q : R.obj (Opposite.op U)),
      (∀ x ∈ U, ∃ (W : TopologicalSpace.Opens T) (h : W ≤ U), x ∈ W ∧
        ∃ b : P.obj (Opposite.op W), b ∈ SB W ∧
          (g.app (Opposite.op W)).hom b = (R.map (homOfLE h).op).hom q) →
      ∃ b : P.obj (Opposite.op U), b ∈ SB U ∧ (g.app (Opposite.op U)).hom b = q := by
    intro P R g SB hP hR H1 H2 H3 U q H4
    have memglue : ∀ (κ : Type (u+1)) (V : κ → TopologicalSpace.Opens T)
        (x : P.obj (Opposite.op (iSup V))),
        (∀ i, (P.map (homOfLE (le_iSup V i)).op).hom x ∈ SB (V i)) → x ∈ SB (iSup V) := by
      intro κ V x hx
      apply H2
      intro y hy
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
      exact ⟨V i, le_iSup V i, hi, hx i⟩
    have extend : ∀ (V : TopologicalSpace.Opens T) (hV : V ≤ U) (t : P.obj (Opposite.op V)),
        t ∈ SB V → (g.app (Opposite.op V)).hom t = (R.map (homOfLE hV).op).hom q →
        ∀ (W : TopologicalSpace.Opens T) (hW : W ≤ U) (b : P.obj (Opposite.op W)), b ∈ SB W →
        (g.app (Opposite.op W)).hom b = (R.map (homOfLE hW).op).hom q →
        ∃ (V' : TopologicalSpace.Opens T) (h₁ : V ≤ V') (h₂ : W ≤ V') (h₃ : V' ≤ U)
          (t' : P.obj (Opposite.op V')),
          t' ∈ SB V' ∧ (P.map (homOfLE h₁).op).hom t' = t ∧
            (g.app (Opposite.op V')).hom t' = (R.map (homOfLE h₃).op).hom q := by
      intro V hV t htS ht W hW b hbS hb
      have pV : V ⊓ W ≤ V := inf_le_left
      have pW : V ⊓ W ≤ W := inf_le_right
      have hδS : (P.map (homOfLE pV).op).hom t - (P.map (homOfLE pW).op).hom b ∈ SB (V ⊓ W) :=
        sub_mem (H1 _ _ pV t htS) (H1 _ _ pW b hbS)
      have hgd : (g.app (Opposite.op (V ⊓ W))).hom
          ((P.map (homOfLE pV).op).hom t - (P.map (homOfLE pW).op).hom b) = 0 := by
        rw [map_sub, nat g, nat g, ht, hb, rr, rr, sub_eq_zero]
      obtain ⟨a', ha'S, ha'g, ha'⟩ := H3 _ _ pW _ hδS hgd
      have hgb' : (g.app (Opposite.op W)).hom (b + a') = (R.map (homOfLE hW).op).hom q := by
        rw [map_add, ha'g, add_zero, hb]
      have hb'D : (P.map (homOfLE pW).op).hom (b + a') = (P.map (homOfLE pV).op).hom t := by
        rw [map_add, ha']
        abel
      let Uf : ULift.{u+1} Bool → TopologicalSpace.Opens T := fun i => cond i.down V W
      let sf : ∀ i : ULift.{u+1} Bool, P.obj (Opposite.op (Uf i)) := fun i =>
        match i with
        | ⟨true⟩ => t
        | ⟨false⟩ => b + a'
      have hc : ∀ i j, (P.map (homOfLE (inf_le_left : Uf i ⊓ Uf j ≤ Uf i)).op).hom (sf i) =
          (P.map (homOfLE (inf_le_right : Uf i ⊓ Uf j ≤ Uf j)).op).hom (sf j) := by
        rintro ⟨_ | _⟩ ⟨_ | _⟩
        · rfl
        · have e := congrArg (fun x => (P.map
            (homOfLE (le_inf inf_le_right inf_le_left : W ⊓ V ≤ V ⊓ W)).op).hom x) hb'D
          simp only [rr] at e
          exact e
        · exact hb'D.symm
        · rfl
      obtain ⟨x, hx, -⟩ := glue P hP _ Uf sf hc
      have h₃ : iSup Uf ≤ U := iSup_le (by rintro ⟨_ | _⟩; exacts [hW, hV])
      refine ⟨iSup Uf, le_iSup Uf ⟨true⟩, le_iSup Uf ⟨false⟩, h₃, x, ?_, hx ⟨true⟩, ?_⟩
      · apply memglue
        rintro ⟨_ | _⟩
        · rw [hx]; exact add_mem hbS ha'S
        · rw [hx]; exact htS
      · apply sep R hR _ Uf (iSup Uf) (le_iSup Uf) le_rfl
        intro i
        rw [← nat g, hx i, rr]
        rcases i with ⟨_ | _⟩
        · exact hgb'
        · exact ht
    let Pt := Σ (V : {V : TopologicalSpace.Opens T // V ≤ U}),
      {t : P.obj (Opposite.op V.1) // t ∈ SB V.1 ∧
        (g.app (Opposite.op V.1)).hom t = (R.map (homOfLE V.2).op).hom q}
    let r : Pt → Pt → Prop := fun a b =>
      ∃ h : a.1.1 ≤ b.1.1, (P.map (homOfLE h).op).hom b.2.1 = a.2.1
    have rtrans : ∀ {a b c : Pt}, r a b → r b c → r a c := by
      rintro a b c ⟨h₁, e₁⟩ ⟨h₂, e₂⟩
      refine ⟨h₁.trans h₂, ?_⟩
      rw [← e₁, ← e₂, rr]
    have hbound : ∀ c : Set Pt, IsChain r c → ∃ ub, ∀ a ∈ c, r a ub := by
      intro c hc
      let V : c → TopologicalSpace.Opens T := fun i => i.1.1.1
      have hV : ∀ i, V i ≤ U := fun i => i.1.1.2
      let t : ∀ i : c, P.obj (Opposite.op (V i)) := fun i => i.1.2.1
      have hcomp : ∀ i j : c, (P.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op).hom (t i) =
          (P.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op).hom (t j) := by
        intro i j
        by_cases hij : i = j
        · subst hij; rfl
        · rcases hc i.2 j.2 (fun h => hij (Subtype.ext h)) with ⟨h, e⟩ | ⟨h, e⟩
          · show (P.map _).hom i.1.2.1 = (P.map _).hom j.1.2.1
            rw [← e, rr]
          · show (P.map _).hom i.1.2.1 = (P.map _).hom j.1.2.1
            rw [← e, rr]
      obtain ⟨x, hx, -⟩ := glue P hP c V t hcomp
      have hxS : x ∈ SB (iSup V) := memglue c V x (fun i => by rw [hx i]; exact i.1.2.2.1)
      have hgx : (g.app (Opposite.op (iSup V))).hom x =
          (R.map (homOfLE (iSup_le hV)).op).hom q := by
        apply sep R hR c V (iSup V) (le_iSup V) le_rfl
        intro i
        rw [← nat g, hx i, rr]
        exact i.1.2.2.2
      exact ⟨⟨⟨iSup V, iSup_le hV⟩, ⟨x, hxS, hgx⟩⟩, fun a ha => ⟨le_iSup V ⟨a, ha⟩, hx ⟨a, ha⟩⟩⟩
    obtain ⟨m, hm⟩ := exists_maximal_of_chains_bounded hbound rtrans
    rcases m with ⟨⟨V₀, hV₀⟩, t₀, ht₀S, ht₀⟩
    have hUV : U ≤ V₀ := by
      intro x hxU
      by_contra hx
      obtain ⟨W, hW, hxW, b, hbS, hb⟩ := H4 x hxU
      obtain ⟨V', h₁, h₂, h₃, t', ht'S, ht'1, ht'2⟩ := extend V₀ hV₀ t₀ ht₀S ht₀ W hW b hbS hb
      obtain ⟨h, -⟩ := hm ⟨⟨V', h₃⟩, t', ht'S, ht'2⟩ ⟨h₁, ht'1⟩
      exact hx (h (h₂ hxW))
    refine ⟨(P.map (homOfLE hUV).op).hom t₀, H1 _ _ hUV t₀ ht₀S, ?_⟩
    rw [nat g, ht₀, rr, rid]

  have d00 : ∀ (W : TopologicalSpace.Opens T) (e : (K.X 0).obj (Opposite.op W)),
      ((K.d 0 0).app (Opposite.op W)).hom e = 0 := by
    intro W e
    rw [K.shape 0 0 (by simp)]
    simp
  have dd : ∀ (p : ℕ) (W : TopologicalSpace.Opens T) (e : (K.X p).obj (Opposite.op W)),
      ((K.d (p + 1) (p + 1 + 1)).app (Opposite.op W)).hom
        (((K.d p (p + 1)).app (Opposite.op W)).hom e) = 0 := by
    intro p W e
    change ((K.d p (p + 1) ≫ K.d (p + 1) (p + 1 + 1)).app (Opposite.op W)).hom e = 0
    rw [K.d_comp_d]
    simp
  have suppres : ∀ (p : ℕ) (A B : TopologicalSpace.Opens T) (h : A ≤ B)
      (x : (K.X p).obj (Opposite.op B)),
      ((K.X p).map (homOfLE (inf_le_left : B ⊓ O ≤ B)).op).hom x = 0 →
      ((K.X p).map (homOfLE (inf_le_left : A ⊓ O ≤ A)).op).hom
        (((K.X p).map (homOfLE h).op).hom x) = 0 := by
    intro p A B h x hx
    rw [rr2 (K.X p) (homOfLE (inf_le_left : A ⊓ O ≤ A)) (homOfLE h)
      (homOfLE (inf_le_inf_right O h : A ⊓ O ≤ B ⊓ O)) (homOfLE (inf_le_left : B ⊓ O ≤ B)),
      hx, map_zero]

  have g1 : ∀ (U : TopologicalSpace.Opens T) (z : (K.X 0).obj (Opposite.op U)),
      ((K.X 0).map (homOfLE (inf_le_left : U ⊓ O ≤ U)).op).hom z = 0 →
      ((K.d 0 (0 + 1)).app (Opposite.op U)).hom z = 0 → z = 0 := by
    intro U z hz1 hz2
    apply s1 (K.X 0) (hsh 0) U z
    intro x hx
    obtain ⟨W, hWU, hxW, hW⟩ := hloc 0 (Nat.zero_le s) U x hx
    refine ⟨W, hWU, hxW, ?_⟩
    obtain ⟨e, -, he⟩ := hW (((K.X 0).map (homOfLE hWU).op).hom z) (suppres 0 W U hWU z hz1)
      (by rw [nat (K.d 0 (0 + 1)), hz2, map_zero])
    rw [← he]
    exact d00 W e

  have exact_step : ∀ a, a + 1 ≤ s →
      (∀ (W' W : TopologicalSpace.Opens T) (h : W' ≤ W) (z : (K.X a).obj (Opposite.op W')),
        ((K.X a).map (homOfLE (inf_le_left : W' ⊓ O ≤ W')).op).hom z = 0 →
        ((K.d a (a + 1)).app (Opposite.op W')).hom z = 0 →
        ∃ z' : (K.X a).obj (Opposite.op W),
          ((K.X a).map (homOfLE (inf_le_left : W ⊓ O ≤ W)).op).hom z' = 0 ∧
          ((K.d a (a + 1)).app (Opposite.op W)).hom z' = 0 ∧
          ((K.X a).map (homOfLE h).op).hom z' = z) →
      ∀ (U : TopologicalSpace.Opens T) (q : (K.X (a + 1)).obj (Opposite.op U)),
      ((K.X (a + 1)).map (homOfLE (inf_le_left : U ⊓ O ≤ U)).op).hom q = 0 →
      ((K.d (a + 1) (a + 1 + 1)).app (Opposite.op U)).hom q = 0 →
      ∃ e : (K.X a).obj (Opposite.op U),
        ((K.X a).map (homOfLE (inf_le_left : U ⊓ O ≤ U)).op).hom e = 0 ∧
        ((K.d a (a + 1)).app (Opposite.op U)).hom e = q := by
    intro a has hF U q hq1 hq2
    obtain ⟨b, hb1, hb2⟩ := s3 (K.d a (a + 1))
      (fun V => ((K.X a).map (homOfLE (inf_le_left : V ⊓ O ≤ V)).op).hom.ker)
      (hsh a) (hsh (a + 1))
      (fun U' V h x hx => AddMonoidHom.mem_ker.mpr
        (suppres a U' V h x (AddMonoidHom.mem_ker.mp hx)))
      (fun U' x hx => by
        apply AddMonoidHom.mem_ker.mpr
        apply s1 (K.X a) (hsh a) (U' ⊓ O)
        intro y hy
        obtain ⟨W, hWU, hyW, hW⟩ := hx y (TopologicalSpace.Opens.mem_inf.mp hy).1
        have hW' := AddMonoidHom.mem_ker.mp hW
        refine ⟨W ⊓ O, inf_le_inf_right O hWU,
          TopologicalSpace.Opens.mem_inf.mpr ⟨hyW, (TopologicalSpace.Opens.mem_inf.mp hy).2⟩, ?_⟩
        rw [rr2 (K.X a) _ _ (homOfLE (inf_le_left : W ⊓ O ≤ W)) (homOfLE hWU)]
        exact hW')
      (fun U' V h x hx hdx => by
        obtain ⟨z', h1, h2, h3⟩ := hF U' V h x (AddMonoidHom.mem_ker.mp hx) hdx
        exact ⟨z', AddMonoidHom.mem_ker.mpr h1, h2, h3⟩)
      U q
      (fun x hx => by
        obtain ⟨W, hWU, hxW, hW⟩ := hloc (a + 1) has U x hx
        obtain ⟨e, he1, he2⟩ := hW (((K.X (a + 1)).map (homOfLE hWU).op).hom q)
          (suppres (a + 1) W U hWU q hq1)
          (by rw [nat (K.d (a + 1) (a + 1 + 1)), hq2, map_zero])
