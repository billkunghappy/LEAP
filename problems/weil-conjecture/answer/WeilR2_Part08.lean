theorem wc_et_unit_map_isIso_of_stalks : ∀ (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) (φ : SheafOfModules.unit (wcEtZModRing Y ℓ) ⟶ N), (∀ (y : Y) (c : ZMod ℓ), (wcEtStalk Y y).map ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map (c.val • φ)) = 0 → c = 0) → (∀ y : Y, Finite ((wcEtStalk Y y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N)) ∧ Nat.card ((wcEtStalk Y y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj N)) = ℓ) → IsIso (Limits.Sigma.desc (fun _ : Fin 1 => φ)) :=
by
  intro Y ℓ _ N φ h5 h4
  have h5' : ∀ (y : Y) (c : Fin 1 → ZMod ℓ), (wcEtStalk Y y).map
      ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map
        (∑ i, (c i).val • (fun _ : Fin 1 => φ) i)) = 0 → c = 0 := by
    intro y c h
    have e : (∑ i, (c i).val • (fun _ : Fin 1 => φ) i) = (c 0).val • φ := Fin.sum_univ_one _
    rw [e] at h
    have hc0 := h5 y (c 0) h
    funext i
    rw [Fin.fin_one_eq_zero i]
    exact hc0
  have hcardF : Nat.card (Fin 1 → ZMod ℓ) = ℓ := by
    rw [Nat.card_fun, Nat.card_zmod, Nat.card_fin, pow_one]
  have hstalk : ∀ y : Y, Function.Bijective ((wcEtStalk Y y).map
      ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map
        (Limits.Sigma.desc (fun _ : Fin 1 => φ)))).hom := by
    intro y
    obtain ⟨u0, hΨ, hu0⟩ := wc_et_unit_sigma_stalk Y ℓ 1 y
    obtain ⟨hfin, hcard⟩ := h4 y
    have hcomp : ∀ c : Fin 1 → ZMod ℓ,
        (∑ i, (c i).val •
          Limits.Sigma.ι (fun _ : Fin 1 => SheafOfModules.unit (wcEtZModRing Y ℓ)) i) ≫
          Limits.Sigma.desc (fun _ : Fin 1 => φ) = ∑ i, (c i).val • (fun _ : Fin 1 => φ) i := by
      intro c
      rw [Preadditive.sum_comp]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Preadditive.nsmul_comp, Limits.Sigma.ι_desc]
    have hA : ∀ c : Fin 1 → ZMod ℓ,
        ((wcEtStalk Y y).map ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map
          (Limits.Sigma.desc (fun _ : Fin 1 => φ)))).hom (((wcEtStalk Y y).map
            ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map (∑ i, (c i).val •
              Limits.Sigma.ι (fun _ : Fin 1 => SheafOfModules.unit (wcEtZModRing Y ℓ)) i))).hom
                u0) = 0 → c = 0 := by
      intro c hc
      apply h5' y c
      apply hu0
      rw [← hcomp c, Functor.map_comp, Functor.map_comp]
      exact hc
    have hinj : Function.Injective ((wcEtStalk Y y).map
        ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map
          (Limits.Sigma.desc (fun _ : Fin 1 => φ)))).hom := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨c, hc⟩ := hΨ.2 x
      obtain ⟨c0, hc0⟩ := hΨ.2 0
      beta_reduce at hc hc0
      have h0 : c0 = 0 := hA c0 (by rw [hc0, map_zero])
      have h1 : c = 0 := hA c (by rw [hc]; exact hx)
      rw [← hc, h1, ← h0, hc0]
    have hcF : Nat.card ((wcEtStalk Y y).obj ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj
        (∐ fun _ : Fin 1 => SheafOfModules.unit (wcEtZModRing Y ℓ)))) =
        Nat.card (Fin 1 → ZMod ℓ) :=
      (Nat.card_eq_of_bijective _ hΨ).symm
    haveI := hfin
    exact hinj.bijective_of_nat_card_le (le_of_eq (by rw [hcard, hcF, hcardF]))
  haveI : IsIso ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map
      (Limits.Sigma.desc (fun _ : Fin 1 => φ))) :=
    wc_et_isIso_of_geom_stalks_bijective Y _ hstalk
  exact isIso_of_reflects_iso _ (SheafOfModules.toSheaf (wcEtZModRing Y ℓ))

theorem wc_et_const_zmod_stalk_card : ∀ (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (y : Y), Finite ((wcEtStalk Y y).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) ∧ Nat.card ((wcEtStalk Y y).obj ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) = ℓ :=
by
  intro Y ℓ _ y
  obtain ⟨u0, hΨ, -⟩ := wc_et_unit_sigma_stalk Y ℓ 1 y
  obtain ⟨e2⟩ := wc_et_zmod_unit_toSheaf_iso Y ℓ
  let e1 := (SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).mapIso
    (Limits.coproductUniqueIso (fun _ : Fin 1 => SheafOfModules.unit (wcEtZModRing Y ℓ)))
  let A := Iso.addCommGroupIsoToAddEquiv ((wcEtStalk Y y).mapIso (e1 ≪≫ e2))
  have hcard1 : Nat.card (Fin 1 → ZMod ℓ) = ℓ := by
    rw [Nat.card_congr (Equiv.funUnique (Fin 1) (ZMod ℓ)), Nat.card_zmod]
  have hC : Nat.card ((wcEtStalk Y y).obj ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) = ℓ := by
    rw [← Nat.card_congr A.toEquiv, ← Nat.card_eq_of_bijective _ hΨ, hcard1]
  refine ⟨?_, hC⟩
  apply Nat.finite_of_card_ne_zero
  rw [hC]
  exact (Fact.out : Nat.Prime ℓ).ne_zero

theorem wc_et_gm_class_stalk_injective : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (fX : X ⟶ Spec (.of K)) [LocallyOfFiniteType fX] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (κ : wcEtZModExt (Spec (.of (LaurentPolynomial K))) ℓ 1), (∀ c : ZMod ℓ, c.val • κ = 0 → c = 0) → ∀ (D1 : wcEtPullData (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ) (D2 : wcEtPullData (Limits.pullback.snd fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ) (I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ))) (g : D1.Φ.obj (SheafOfModules.unit (wcEtZModRing X ℓ)) ⟶ I.cocomplex.X 1) (hg : g ≫ I.cocomplex.d 1 (1 + 1) = 0), letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ)) := HasExt.standard _; letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _ D1.cont D1.φ).Additive := @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive; I.extMk g (1 + 1) rfl hg = (Abelian.Ext.mk₀ D1.μ.hom).comp (wcEtPull D2 1 κ) (zero_add 1) → ∀ (hf : D1.adj.homEquiv _ _ g ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d 1 (1 + 1) = 0) (x : X) (c : ZMod ℓ), (wcEtStalk X x).map ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).map (c.val • ((((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles (D1.adj.homEquiv _ _ g) (1 + 1) (by simp) hf ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _ D1.cont D1.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ 1))) = 0 → c = 0 :=
by
  classical
  intro K _ _ X fX _ ℓ _ hℓ κ hκ D1 D2 I g hg hgE hf x c hstalk
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))) ℓ)) := HasExt.standard _
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _
      D1.cont D1.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive
  haveI := D1.additive
  haveI := D1.presLim
  haveI := D1.presColim
  set R1 := (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange (Limits.pullback.fst fX
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))))) _ _
    D1.cont D1.φ) with hR1
  set Kc := ((R1.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) with hKc

  set m : ℕ := c.val with hm
  obtain ⟨gc, hgc_def⟩ : ∃ gc : D1.Φ.obj (SheafOfModules.unit (wcEtZModRing X ℓ)) ⟶ I.cocomplex.X 1,
      gc = m • g := ⟨_, rfl⟩
  obtain ⟨β, hβ_def⟩ : ∃ β : wcEtZModExt (Spec (.of (LaurentPolynomial K))) ℓ 1,
