    refine ⟨(toSheafify K (G.op.lan.obj (G.op ⋙ M.obj))).app (Opposite.op V) t, ?_⟩
    have h2 := ConcreteCategory.congr_hom (NatTrans.congr_app (hstar M) (Opposite.op V)) t
