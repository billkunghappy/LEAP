  have hσpr : AffineSpace.map (ULift.{u} (Fin c)) e ≫ AffineSpace.map (ULift.{u} (Fin c)) qG = 𝟙 _ := by
    rw [← AffineSpace.map_comp, he, AffineSpace.map_id]
  have hσΦ : AffineSpace.map (ULift.{u} (Fin c)) e ≫ Φ MG = AffineSpace.map (ULift.{u} (Fin c)) e := by
    apply hid
