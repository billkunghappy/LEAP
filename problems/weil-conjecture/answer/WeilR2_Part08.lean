  have s8 : ∀ (F₀ F₁ F₂ : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (d₀ : F₀ ⟶ F₁) (d₁ : F₁ ⟶ F₂)
      {T T₁ T₂ T₃ : X.Etale} (s : T₃ ⟶ T) (r : T₂ ⟶ T₁) (a : T₁ ⟶ T) (a' : T ⟶ T₁)
      (β : T₂ ⟶ T₃) (β' : T₃ ⟶ T₂), a' ≫ a = 𝟙 T → r ≫ a = β ≫ s → s ≫ a' = β' ≫ r →
      (∀ c : F₁.obj (Opposite.op T₁), (F₁.map r.op).hom c = 0 →
        (d₁.app (Opposite.op T₁)).hom c = 0 →
        ∃ e : F₀.obj (Opposite.op T₁), (F₀.map r.op).hom e = 0 ∧
          (d₀.app (Opposite.op T₁)).hom e = c) →
      ∀ c : F₁.obj (Opposite.op T), (F₁.map s.op).hom c = 0 →
        (d₁.app (Opposite.op T)).hom c = 0 →
        ∃ e : F₀.obj (Opposite.op T), (F₀.map s.op).hom e = 0 ∧
          (d₀.app (Opposite.op T)).hom e = c := by
    intro F₀ F₁ F₂ d₀ d₁ T T₁ T₂ T₃ s r a a' β β' h1 h2 h3 hH c hc0 hc1
    obtain ⟨e₁, he0, he1⟩ := hH ((F₁.map a.op).hom c)
      (by rw [← hcomp, h2, hcomp, hc0, map_zero]) (by rw [hnat, hc1, map_zero])
    refine ⟨(F₀.map a'.op).hom e₁, ?_, ?_⟩
    · rw [← hcomp, h3, hcomp, he0, map_zero]
    · rw [hnat, he1, ← hcomp, h1]
      simp

  have s5 : ∀ {U V : X.Etale}, IsOpenImmersion U.hom → ∀ (f g : V ⟶ U), f = g := by
    intro U V hU f g
    apply MorphismProperty.Over.Hom.ext
    exact (cancel_mono U.hom).1 ((MorphismProperty.Over.w f).trans (MorphismProperty.Over.w g).symm)
  have s6 : ∀ (U V : X.Etale), IsOpenImmersion U.hom → Set.range V.hom ⊆ Set.range U.hom →
      Nonempty (V ⟶ U) := by
    intro U V hU h
    exact ⟨MorphismProperty.Over.homMk (IsOpenImmersion.lift U.hom V.hom h)
      (IsOpenImmersion.lift_fac _ _ _) trivial⟩

  let T : X.Etale := (wcZarToEt X).obj W
  haveI := (wc_et_slice_continuous T).1
  haveI := (wc_et_slice_continuous T).2
  obtain ⟨ψ, ⟨μ⟩⟩ := wc_et_slice_zmod_restrict_unit T n
  obtain ⟨hA, hL, hR⟩ := wc_et_slice_module_restrict_exact T n ψ
  haveI := hA
  haveI := hL
  haveI := hR
  let P := SheafOfModules.pushforward.{u+1} ψ
  haveI : P.PreservesHomology := P.preservesHomologyOfExact
  let isoPart : (CochainComplex.single₀ (SheafOfModules.{u+1} (wcEtZModRing T.left n))).obj
        (SheafOfModules.unit (wcEtZModRing T.left n)) ⟶
      (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj
        ((CochainComplex.single₀ (SheafOfModules.{u+1} (wcEtZModRing X n))).obj
          (SheafOfModules.unit (wcEtZModRing X n))) :=
    (CochainComplex.single₀ _).map μ.inv ≫
      (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℕ) 0).inv.app
        (SheafOfModules.unit (wcEtZModRing X n))
  haveI : QuasiIso isoPart := quasiIso_of_isIso isoPart
  haveI : QuasiIso ((P.mapHomologicalComplex (ComplexShape.up ℕ)).map I.ι) :=
    HomologicalComplex.quasiIso_map_of_preservesHomology I.ι P
  have hqi : QuasiIso (isoPart ≫ (P.mapHomologicalComplex (ComplexShape.up ℕ)).map I.ι) :=
    quasiIso_comp _ _
  let J : InjectiveResolution (SheafOfModules.unit (wcEtZModRing (W : Scheme.{u}) n)) :=
    { cocomplex := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
      injective := fun p => wc_et_slice_module_restrict_injective T n ψ _ (I.injective p)
      hasHomology := inferInstance
      ι := isoPart ≫ (P.mapHomologicalComplex (ComplexShape.up ℕ)).map I.ι
      quasiIso := hqi }

  let T₁ : X.Etale := (wcEtSlice T).obj ((wcZarToEt (W : Scheme.{u})).obj ⊤)
  let T₂ : X.Etale := (wcEtSlice T).obj ((wcZarToEt (W : Scheme.{u})).obj (⊤ ⊓ OW))
  let T₃ : X.Etale := (wcZarToEt X).obj (W ⊓ O)
  let r : T₂ ⟶ T₁ := (wcEtSlice T).map ((wcZarToEt (W : Scheme.{u})).map
    (homOfLE (inf_le_left : ⊤ ⊓ OW ≤ ⊤)))
  let s : T₃ ⟶ T := (wcZarToEt X).map (homOfLE (inf_le_left : W ⊓ O ≤ W))
  let F₀ := ((SheafOfModules.toSheaf (wcEtZModRing X n)).obj (I.cocomplex.X (b - 1))).obj
  let F₁ := ((SheafOfModules.toSheaf (wcEtZModRing X n)).obj (I.cocomplex.X b)).obj
  let F₂ := ((SheafOfModules.toSheaf (wcEtZModRing X n)).obj (I.cocomplex.X (b + 1))).obj
  let d₀ : F₀ ⟶ F₁ := ((SheafOfModules.toSheaf (wcEtZModRing X n)).map (I.cocomplex.d (b - 1) b)).hom
  let d₁ : F₁ ⟶ F₂ := ((SheafOfModules.toSheaf (wcEtZModRing X n)).map (I.cocomplex.d b (b + 1))).hom
  have hJ : ∀ c : F₁.obj (Opposite.op T₁), (F₁.map r.op).hom c = 0 →
      (d₁.app (Opposite.op T₁)).hom c = 0 →
      ∃ e : F₀.obj (Opposite.op T₁), (F₀.map r.op).hom e = 0 ∧
        (d₀.app (Opposite.op T₁)).hom e = c :=
    fun c h1 h2 => H J c h1 h2

  have hT : IsOpenImmersion T.hom := by
    show IsOpenImmersion W.ι
    infer_instance
  have hT₁ : IsOpenImmersion T₁.hom := by
    show IsOpenImmersion ((⊤ : (W : Scheme.{u}).Opens).ι ≫ W.ι)
    infer_instance
  have hT₂ : IsOpenImmersion T₂.hom := by
    show IsOpenImmersion ((⊤ ⊓ OW : (W : Scheme.{u}).Opens).ι ≫ W.ι)
    infer_instance
  have hT₃ : IsOpenImmersion T₃.hom := by
    show IsOpenImmersion (W ⊓ O).ι
    infer_instance

  have rng : ∀ (V : (W : Scheme.{u}).Opens),
      Set.range (V.ι ≫ W.ι) = W.ι '' (V : Set (W : Scheme.{u})) := by
    intro V
    ext y
    constructor
    · rintro ⟨p, rfl⟩
      refine ⟨V.ι p, ?_, ?_⟩
      · rw [← Scheme.Opens.range_ι V]
        exact ⟨p, rfl⟩
      · rw [Scheme.Hom.comp_apply]
    · rintro ⟨x, hx, rfl⟩
      have hx' : x ∈ Set.range V.ι := by rw [Scheme.Opens.range_ι]; exact hx
      obtain ⟨p, rfl⟩ := hx'
      exact ⟨p, by rw [Scheme.Hom.comp_apply]⟩
  have rT : Set.range T.hom = (W : Set X) := Scheme.Opens.range_ι W
  have rT₃ : Set.range T₃.hom = ((W ⊓ O : X.Opens) : Set X) := Scheme.Opens.range_ι (W ⊓ O)
  have rT₁' : Set.range ((⊤ : (W : Scheme.{u}).Opens).ι ≫ W.ι) = (W : Set X) := by
    rw [rng, TopologicalSpace.Opens.coe_top, Set.image_univ, Scheme.Opens.range_ι]
  have rT₁ : Set.range T₁.hom = (W : Set X) := rT₁'
  have rT₂' : Set.range ((⊤ ⊓ OW : (W : Scheme.{u}).Opens).ι ≫ W.ι) =
      ((W ⊓ O : X.Opens) : Set X) := by
    rw [rng]
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      rw [TopologicalSpace.Opens.coe_inf] at hx
      obtain ⟨_, hx2⟩ := hx
      rw [hOW] at hx2
      rw [TopologicalSpace.Opens.coe_inf]
      refine Set.mem_inter ?_ hx2
      rw [← Scheme.Opens.range_ι W]
      exact ⟨x, rfl⟩
    · intro hy
      rw [TopologicalSpace.Opens.coe_inf] at hy
      obtain ⟨hyW, hyO⟩ := hy
      have hy' : y ∈ Set.range W.ι := by rw [Scheme.Opens.range_ι]; exact hyW
      obtain ⟨x, rfl⟩ := hy'
      refine ⟨x, ?_, rfl⟩
      rw [TopologicalSpace.Opens.coe_inf]
      refine Set.mem_inter (by rw [TopologicalSpace.Opens.coe_top]; exact Set.mem_univ x) ?_
      rw [hOW]
      exact hyO
  have rT₂ : Set.range T₂.hom = ((W ⊓ O : X.Opens) : Set X) := rT₂'
  obtain ⟨a⟩ := s6 T T₁ hT (by rw [rT₁, rT])
  obtain ⟨a'⟩ := s6 T₁ T hT₁ (by rw [rT₁, rT])
  obtain ⟨β⟩ := s6 T₃ T₂ hT₃ (by rw [rT₂, rT₃])
  obtain ⟨β'⟩ := s6 T₂ T₃ hT₂ (by rw [rT₂, rT₃])
  exact s8 F₀ F₁ F₂ d₀ d₁ s r a a' β β' (s5 hT _ _) (s5 hT _ _) (s5 hT₁ _ _) hJ c hc0 hc1

theorem wc_et_supp_vanish_of_basis : ∀ {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (n s : ℕ) (D : wcEtPullData i n), (∀ (V : X.Opens) (x : X), x ∈ V → ∃ W : X.Opens, W ≤ V ∧ x ∈ W ∧ ∀ (ZW : Scheme.{u}) (iW : ZW ⟶ W) (gW : ZW ⟶ Z), IsPullback gW iW i W.ι → ∀ (DW : wcEtPullData iW n) (s' : ℕ), s' ≤ s → ∀ t : wcEtSuppExt DW s', t = 0) → ∀ θ : wcEtSuppExt D s, θ = 0 :=
by
  classical
  intro X Z i _ n s D hH θ
  let O : X.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X n)) :=
    sheafOfModules_enoughInjectives (Scheme.smallEtaleTopology X) (wcEtZModRing X n)
  let I : InjectiveResolution (SheafOfModules.unit (wcEtZModRing X n)) :=
    injectiveResolution (SheafOfModules.unit (wcEtZModRing X n))
  let K : CochainComplex ((TopologicalSpace.Opens X)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ℕ :=
    ((SheafOfModules.toSheaf (wcEtZModRing X n) ⋙
      sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft (X.Opens)ᵒᵖ (X.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (wcZarToEt X).op).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  refine (wc_et_supp_ext_vanish_iff_cocycle i n D O rfl (wc_et_supp_unit_ker_suppIn i n D) I s).mpr
    (wc_zar_flasque_supp_local_to_global (↥X) K ?_ ?_ O s ?_) θ
  ·
    intro p
    haveI := (wc_zarToEt_props X).1
    exact Functor.op_comp_isSheaf (wcZarToEt X) (Opens.grothendieckTopology X)
      (Scheme.smallEtaleTopology X) ((SheafOfModules.toSheaf _).obj (I.cocomplex.X p))
  ·
    intro p W' W h
    haveI := (wc_zarToEt_props X).2.2 W' W h
    haveI := I.injective p
    exact wc_sheafOfModules_injective_restriction_surjective (Scheme.smallEtaleTopology X)
      (wcEtZModRing X n) (I.cocomplex.X p) ((wcZarToEt X).map (homOfLE h))
  ·
    intro b hb V x hx
    obtain ⟨W, hWV, hxW, hW⟩ := hH V x hx
    refine ⟨W, hWV, hxW, ?_⟩
    have sq : IsPullback (Limits.pullback.snd W.ι i) (Limits.pullback.fst W.ι i) i W.ι :=
      (IsPullback.of_hasPullback W.ι i).flip
    haveI : IsClosedImmersion (Limits.pullback.fst W.ι i) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) sq inferInstance
    let DW := (wc_et_zmod_pull_data_exists (Limits.pullback.fst W.ι i) n).some
    let OW : (W : Scheme.{u}).Opens := ⟨(Set.range (Limits.pullback.fst W.ι i))ᶜ,
      (Limits.pullback.fst W.ι i).isClosedEmbedding.isClosed_range.isOpen_compl⟩
    have hOW : (OW : Set (W : Scheme.{u})) = W.ι ⁻¹' (O : Set X) := by
      show (Set.range (Limits.pullback.fst W.ι i))ᶜ = W.ι ⁻¹' (Set.range i)ᶜ
      rw [Scheme.Pullback.range_fst, Set.preimage_compl]
    have hvan : ∀ t : wcEtSuppExt DW b, t = 0 := hW _ _ _ sq DW b hb
    exact wc_et_supp_cocycle_open_transport n O I W OW hOW b (fun I' =>
      (wc_et_supp_ext_vanish_iff_cocycle (Limits.pullback.fst W.ι i) n DW OW rfl
        (wc_et_supp_unit_ker_suppIn (Limits.pullback.fst W.ι i) n DW) I' b).mp hvan)

