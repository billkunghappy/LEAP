          A ab.down.1 ab.down.2), AffineSpace.homOfVector_over _ _,
        fun a b => AffineSpace.homOfVector_appTop_coord _ _ _⟩)

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : Matrix (Fin c) (Fin c) Γ(G, ⊤) →
      (AffineSpace (ULift.{u} (Fin c)) G ⟶ AffineSpace (ULift.{u} (Fin c)) G), ∀ P, Φ P =
      AffineSpace.homOfVector (AffineSpace (ULift.{u} (Fin c)) G ↘ G)
        (fun j : ULift.{u} (Fin c) => ((P.map (AffineSpace (ULift.{u} (Fin c)) G ↘ G).appTop.hom).mulVec
          (fun b : Fin c => AffineSpace.coord G (ULift.up.{u} b))) j.down) := ⟨_, fun _ => rfl⟩
  have hF : ∀ (P : Matrix (Fin c) (Fin c) Γ(G, ⊤)) {Y : Scheme.{u}}
