      · obtain ⟨t, ht⟩ := h5 M V' hQ (M.obj.map g.op s)
        exact ⟨t, ht⟩
    exact Sheaf.epi_of_isLocallySurjective _

theorem wc_et_open_extzero_module_package : ∀ {X : Scheme.{u}} (U : X.Opens) (ℓ : ℕ) (E : wcEtPullData U.ι ℓ), ∃ (L : SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing X ℓ)) (adj : L ⊣ E.Φ), Limits.PreservesFiniteLimits L ∧ (∀ N : SheafOfModules.{u+1} (wcEtZModRing X ℓ), Mono (adj.counit.app N)) ∧ (∀ N' : SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ), wcSuppIn X (U : Set X) ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj (L.obj N'))) ∧ (∀ K : SheafOfModules.{u+1} (wcEtZModRing X ℓ), wcSuppIn X (U : Set X) ((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).obj K) → Epi (adj.counit.app K)) ∧ (∀ (K : SheafOfModules.{u+1} (wcEtZModRing X ℓ)) (V : X.Etale), (∀ x, V.hom x ∈ U) → Function.Surjective ((((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).map (adj.counit.app K)).hom.app (Opposite.op V)).hom)) :=
by
  intro X U ℓ E

  obtain ⟨hc, hcc⟩ := wc_et_slice_continuous
    (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)
  haveI hc' : (wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) :
      X.Etale)).IsContinuous (Scheme.smallEtaleTopology (U : Scheme.{u}))
      (Scheme.smallEtaleTopology X) := hc
  haveI hcc' : (wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) :
      X.Etale)).IsCocontinuous (Scheme.smallEtaleTopology (U : Scheme.{u}))
      (Scheme.smallEtaleTopology X) := hcc

  obtain ⟨φ₀, ⟨θ⟩⟩ := @wc_et_open_pull_data_restr_iso X U ℓ E hc'

  obtain ⟨Lab, adjab, pflab, monoab, suppab, epiab, surjab⟩ :=
    @wc_sheafPullback_extzero_of_lan _ _ _ _ (Scheme.smallEtaleTopology (U : Scheme.{u}))
      (Scheme.smallEtaleTopology X)
      (wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) : X.Etale)) hc'
      _ _ _
      (fun V : X.Etale => ∀ x, V.hom x ∈ (U : Set X))
      (wc_et_slice_lan_finite_limits _) (wc_et_open_slice_lan_vanish U)
      (wc_et_open_slice_lan_counit_bij U)
  let tX := SheafOfModules.toSheaf.{u+1} (wcEtZModRing X ℓ)
  let tU := SheafOfModules.toSheaf.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ)
  let P := (wcEtSlice (MorphismProperty.Over.mk ⊤ U.ι (inferInstance : Etale U.ι) :
    X.Etale)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology (U : Scheme.{u})) (Scheme.smallEtaleTopology X)

  obtain ⟨αX, hiX, hsX, -⟩ := wc_et_zmod_ring_locbij X ℓ
  obtain ⟨hFullX, hessX⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology X)
    (wcEtZModRing X ℓ) ℓ αX hiX hsX
  obtain ⟨αU, hiU, hsU, hnU⟩ := wc_et_zmod_ring_locbij (U : Scheme.{u}) ℓ
  obtain ⟨hFullU, -⟩ := sheafOfModules_toSheaf_torsion_equiv
    (Scheme.smallEtaleTopology (U : Scheme.{u})) (wcEtZModRing (U : Scheme.{u}) ℓ) ℓ αU hiU hsU
  haveI := hFullX
  haveI := hFullU
  haveI := pflab
  haveI : Lab.IsLeftAdjoint := adjab.isLeftAdjoint
  haveI : Lab.Additive := Functor.additive_of_preserves_binary_products Lab

  let comm2 : tX ⋙ P ≅ E.Φ ⋙ tU :=
    NatIso.ofComponents (fun M => tU.mapIso (θ.app M).symm) (fun {M N} f => by
      have h := congrArg tU.map (θ.inv.naturality f)
      rw [tU.map_comp, tU.map_comp] at h
      exact h)

  have htorsU : ∀ A : SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ),
      ℓ • 𝟙 (tU.obj A) = 0 := by
    intro A
    have hx : ∀ (k : ℕ) (W : ((U : Scheme.{u}).Etale)ᵒᵖ) (x : (tU.obj A).obj.obj W),
        ((((k + 1) • 𝟙 (tU.obj A)).hom.app W).hom x) = (k + 1) • x := by
      intro k W x
      induction k with
      | zero => simp
      | succ k ih =>
        rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply, ih,
          succ_nsmul (n := k + 1)]
        simp
    have hn0 : ∀ (W : ((U : Scheme.{u}).Etale)ᵒᵖ) (x : (tU.obj A).obj.obj W), ℓ • x = 0 := by
      intro W x
      let y : A.val.obj W := x
      have h1 : ((ℓ : ↑((wcEtZModRing (U : Scheme.{u}) ℓ).obj.obj W)) • y) = ℓ • y :=
        Nat.cast_smul_eq_nsmul _ ℓ y
      rw [hnU W, zero_smul] at h1
      exact h1.symm
    have hff : ℓ • 𝟙 (tU.obj A) + 𝟙 (tU.obj A) = 𝟙 (tU.obj A) := by
      rw [← succ_nsmul]
      apply Sheaf.hom_ext
      ext W x
      rw [hx, succ_nsmul, hn0, zero_add]
      all_goals first | rfl | simp
    exact add_eq_right.mp hff
  have hess : ∀ A : SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ),
      tX.essImage (Lab.obj (tU.obj A)) := by
    intro A
    apply hessX
    rw [← Lab.map_id, ← Functor.map_nsmul, htorsU, Functor.map_zero]

  let hffU := Functor.FullyFaithful.ofFullyFaithful tU
  let hffX := Functor.FullyFaithful.ofFullyFaithful tX
  let L := Functor.essImage.liftFunctor (tU ⋙ Lab) tX hess
  let comm1 : tU ⋙ Lab ≅ L ⋙ tX := (Functor.essImage.liftFunctorCompIso (tU ⋙ Lab) tX hess).symm
  let adj : L ⊣ E.Φ := adjab.restrictFullyFaithful hffU hffX comm1 comm2
  have hcounit : ∀ K : SheafOfModules.{u+1} (wcEtZModRing X ℓ),
      tX.map (adj.counit.app K) =
        comm1.inv.app (E.Φ.obj K) ≫ Lab.map (comm2.inv.app K) ≫ adjab.counit.app (tX.obj K) :=
    fun K => Adjunction.map_restrictFullyFaithful_counit_app adjab hffU hffX comm1 comm2 K

  have hiso : ∀ (G G' : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), (G ≅ G') →
      wcSuppIn X (U : Set X) G → wcSuppIn X (U : Set X) G' := by
    intro G G' e hG V s'
    let s := (e.inv.hom.app (Opposite.op V)) s'
    have hs : (e.hom.hom.app (Opposite.op V)) s = s' := by
      change ((e.inv ≫ e.hom).hom.app (Opposite.op V)) s' = s'
      rw [e.inv_hom_id]
      rfl
    refine GrothendieckTopology.superset_covering _ ?_ (hG V s)
    rw [Sieve.generate_le_iff]
    intro V' g hg
    apply Sieve.le_generate
    rcases hg with hg | hg
    · left
      rw [← hs]
      have h2 := ConcreteCategory.congr_hom (e.hom.hom.naturality g.op) s
      simp only [ConcreteCategory.comp_apply] at h2
      rw [← h2, hg, map_zero]
    · right
      exact hg
  refine ⟨L, adj, ?_, ?_, ?_, ?_, ?_⟩
  ·
    haveI : Limits.PreservesFiniteLimits (tU ⋙ Lab) := Limits.comp_preservesFiniteLimits _ _
    haveI : Limits.PreservesFiniteLimits (L ⋙ tX) := Limits.preservesFiniteLimits_of_natIso comm1
    exact Limits.preservesFiniteLimits_of_reflects_of_preserves L tX
  ·
    intro N
    apply tX.mono_of_mono_map
    rw [hcounit]
    have m3 : Mono (adjab.counit.app (tX.obj N)) := monoab (tX.obj N)
    have m1 : Mono (comm1.inv.app (E.Φ.obj N)) :=
      @IsIso.mono_of_iso _ _ _ _ _ (Iso.isIso_inv (comm1.app (E.Φ.obj N)))
    have m2 : Mono (Lab.map (comm2.inv.app N)) :=
      @IsIso.mono_of_iso _ _ _ _ _ (Iso.isIso_hom (Lab.mapIso (comm2.app N).symm))
    exact @mono_comp _ _ _ _ _ _ m1 _ (@mono_comp _ _ _ _ _ _ m2 _ m3)
  ·
    intro N'
    have h0 : wcSuppIn X (U : Set X) (Lab.obj (tU.obj N')) := suppab (tU.obj N')
    exact hiso _ _ (comm1.app N') h0
  ·
    intro K hK
    apply tX.epi_of_epi_map
    rw [hcounit]
    have e3 : Epi (adjab.counit.app (tX.obj K)) := epiab (tX.obj K) hK
    have e1 : Epi (comm1.inv.app (E.Φ.obj K)) :=
      @IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_inv (comm1.app (E.Φ.obj K)))
    have e2 : Epi (Lab.map (comm2.inv.app K)) :=
      @IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom (Lab.mapIso (comm2.app K).symm))
    exact @epi_comp _ _ _ _ _ _ e1 _ (@epi_comp _ _ _ _ _ _ e2 _ e3)
  ·
    intro K V hV
    have h3 := surjab (tX.obj K) V hV
    have hA : Function.Bijective ((comm1.inv.app (E.Φ.obj K)).hom.app (Opposite.op V)).hom :=
      ConcreteCategory.bijective_of_isIso
        (((sheafToPresheaf _ _).mapIso (comm1.app (E.Φ.obj K)).symm).app (Opposite.op V)).hom
    have hB : Function.Bijective ((Lab.map (comm2.inv.app K)).hom.app (Opposite.op V)).hom :=
      ConcreteCategory.bijective_of_isIso
        (((sheafToPresheaf _ _).mapIso (Lab.mapIso (comm2.app K).symm)).app (Opposite.op V)).hom
    rw [hcounit]
    exact h3.comp (hB.surjective.comp hA.surjective)

theorem wc_et_mod_suppIn_calculus : ∀ (Y : Scheme.{u}) (ℓ : ℕ) (W W' : Set Y) (F G : SheafOfModules.{u+1} (wcEtZModRing Y ℓ)), (wcSuppIn Y W ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj F) → W ⊆ W' → wcSuppIn Y W' ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj F)) ∧ (∀ m : G ⟶ F, Mono m → wcSuppIn Y W ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj F) → wcSuppIn Y W ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj G)) ∧ (wcSuppIn Y W ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj F) → wcSuppIn Y W' ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj F) → wcSuppIn Y (W ∩ W') ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).obj F)) :=
by
  intro Y ℓ W W' F G
  unfold wcSuppIn
  refine ⟨?_, ?_, ?_⟩
  · intro hF hWW' V s
    refine (Scheme.smallEtaleTopology Y).superset_covering ?_ (hF V s)
    apply Sieve.generate_mono
    intro V' g hg
    rcases hg with h0 | hland
    · exact Or.inl h0
    · exact Or.inr (fun x => hWW' (hland x))
  · intro m hm hF V s
    have hmono : Mono ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map m) :=
      Functor.map_mono _ m
    have hmono2 : Mono ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map m).hom :=
      (Sheaf.Hom.mono_iff_presheaf_mono _ _ _).mp hmono
    have hinj := fun V' : Y.Etale => (AddCommGrpCat.mono_iff_injective _).mp
      ((NatTrans.mono_iff_mono_app _).mp hmono2 (Opposite.op V'))
    refine (Scheme.smallEtaleTopology Y).superset_covering ?_
      (hF V (((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map m).hom.app (Opposite.op V) s))
    apply Sieve.generate_mono
    intro V' g hg
    rcases hg with h0 | hland
    · left
      apply hinj V'
      have hnat := NatTrans.naturality_apply
        ((SheafOfModules.toSheaf (wcEtZModRing Y ℓ)).map m).hom g.op s
      rw [hnat, map_zero]
      exact h0
    · exact Or.inr hland
  · intro h1 h2 V s
    refine (Scheme.smallEtaleTopology Y).superset_covering ?_
      ((Scheme.smallEtaleTopology Y).intersection_covering (h1 V s) (h2 V s))
    intro V'' g hg
    rw [Sieve.inter_apply] at hg
    obtain ⟨hA, hB⟩ := hg
    rw [Sieve.generate_apply] at hA hB
    obtain ⟨V1, k1, g1, hg1, e1⟩ := hA
    obtain ⟨V2, k2, g2, hg2, e2⟩ := hB
    apply Sieve.le_generate
    rcases hg1 with h0 | hl1
    · left
      subst e1
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, h0, map_zero]
    · rcases hg2 with h0 | hl2
      · left
        subst e2
        rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, h0, map_zero]
      · right
        intro x
        have hx1 : V''.hom x = V1.hom (k1.left x) := by
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w k1]
        have hx2 : V''.hom x = V2.hom (k2.left x) := by
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w k2]
        refine ⟨?_, ?_⟩
        · rw [hx1]; exact hl1 _
        · rw [hx2]; exact hl2 _

theorem wc_et_mod_desc_epi_of_open_cover : ∀ {X : Scheme.{u}} {ℓ : ℕ} (A B : X.Opens), A ⊔ B = ⊤ → ∀ (N K₁ K₂ : SheafOfModules.{u+1} (wcEtZModRing X ℓ)) (c₁ : K₁ ⟶ N) (c₂ : K₂ ⟶ N), (∀ V : X.Etale, (∀ x, V.hom x ∈ A) → Function.Surjective ((((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).map c₁).hom.app (Opposite.op V)).hom)) → (∀ V : X.Etale, (∀ x, V.hom x ∈ B) → Function.Surjective ((((SheafOfModules.toSheaf (wcEtZModRing X ℓ)).map c₂).hom.app (Opposite.op V)).hom)) → Epi (Limits.biprod.desc c₁ c₂) :=
by
  intro X ℓ A B hAB N K₁ K₂ c₁ c₂ hA hB
  apply Preadditive.epi_of_cancel_zero
  intro P h hh
  have h1 : c₁ ≫ h = 0 := by
    rw [← Limits.biprod.inl_desc c₁ c₂, Category.assoc, hh, Limits.comp_zero]
  have h2 : c₂ ≫ h = 0 := by
    rw [← Limits.biprod.inr_desc c₁ c₂, Category.assoc, hh, Limits.comp_zero]
  set T := SheafOfModules.toSheaf (wcEtZModRing X ℓ) with hT
  have hF1 : T.map c₁ ≫ T.map h = 0 := by rw [← T.map_comp, h1, T.map_zero]
  have hF2 : T.map c₂ ≫ T.map h = 0 := by rw [← T.map_comp, h2, T.map_zero]
  have z1 : ∀ (V' : X.Etale) (t : (T.obj K₁).obj.obj (Opposite.op V')),
      ((T.map h).hom.app (Opposite.op V')).hom
        (((T.map c₁).hom.app (Opposite.op V')).hom t) = 0 := by
    intro V' t
    have e : ((T.map h).hom.app (Opposite.op V')).hom
        (((T.map c₁).hom.app (Opposite.op V')).hom t) =
        ((T.map c₁ ≫ T.map h).hom.app (Opposite.op V')).hom t := rfl
    rw [e, hF1]
    rfl
  have z2 : ∀ (V' : X.Etale) (t : (T.obj K₂).obj.obj (Opposite.op V')),
      ((T.map h).hom.app (Opposite.op V')).hom
        (((T.map c₂).hom.app (Opposite.op V')).hom t) = 0 := by
    intro V' t
    have e : ((T.map h).hom.app (Opposite.op V')).hom
        (((T.map c₂).hom.app (Opposite.op V')).hom t) =
        ((T.map c₂ ≫ T.map h).hom.app (Opposite.op V')).hom t := rfl
    rw [e, hF2]
    rfl
  apply T.map_injective
  rw [T.map_zero]
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext V
  obtain ⟨V⟩ := V
  apply AddCommGrpCat.ext
  intro s
  suffices key : ConcreteCategory.hom ((T.map h).hom.app (Opposite.op V)) s = 0 by
    rw [key]
    rfl

  let S : Sieve V :=
    { arrows := fun V' _ => (∀ x, V'.hom x ∈ A) ∨ (∀ x, V'.hom x ∈ B)
      downward_closed := by
        intro V' V'' g hg k
        have hw : k.left ≫ V'.hom = V''.hom := MorphismProperty.Over.w k
        rcases hg with hg | hg
        · left
          intro x
          rw [← hw, Scheme.Hom.comp_apply]
          exact hg _
        · right
          intro x
          rw [← hw, Scheme.Hom.comp_apply]
          exact hg _ }
  have hS : S ∈ Scheme.smallEtaleTopology X V := by
    change S ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro v
    have hv : V.hom v ∈ A ⊔ B := by
      rw [hAB]
      exact TopologicalSpace.Opens.mem_top _
    have key : ∀ W : X.Opens, V.hom v ∈ W → ∃ (V₁ : X.Etale) (f : V₁ ⟶ V) (y : V₁.left),
        (∀ x, V₁.hom x ∈ W) ∧ Etale f.left ∧ f.left y = v := by
      intro W hW
      haveI : Etale V.hom := V.prop
      let U := V.hom ⁻¹ᵁ W
      let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (U.ι ≫ V.hom) inferInstance
      let f : V₁ ⟶ V := MorphismProperty.Over.homMk U.ι rfl trivial
      refine ⟨V₁, f, ⟨v, (Scheme.Hom.mem_preimage V.hom).mpr hW⟩, ?_, ?_, ?_⟩
      · intro x
        let x' : U := x
        have hx : V.hom x'.1 ∈ W := (Scheme.Hom.mem_preimage V.hom).mp x'.2
        have e1 : U.ι x' = x'.1 := Scheme.Opens.ι_apply U x'
        have e2 : (U.ι ≫ V.hom) x' = V.hom (U.ι x') := Scheme.Hom.comp_apply U.ι V.hom x'
        have e3 : (U.ι ≫ V.hom) x' = V.hom x'.1 := e2.trans (congrArg V.hom e1)
        have h3 : (U.ι ≫ V.hom) x' ∈ W := e3 ▸ hx
        exact h3
      · show Etale U.ι
        infer_instance
      · show U.ι ⟨v, (Scheme.Hom.mem_preimage V.hom).mpr hW⟩ = v
        exact Scheme.Opens.ι_apply _ _
    rcases TopologicalSpace.Opens.mem_sup.mp hv with hA' | hB'
    · obtain ⟨V₁, f, y, hy1, hy2, hy3⟩ := key A hA'
      exact ⟨V₁, f, y, Or.inl hy1, hy2, hy3⟩
    · obtain ⟨V₁, f, y, hy1, hy2, hy3⟩ := key B hB'
      exact ⟨V₁, f, y, Or.inr hy1, hy2, hy3⟩
  refine Sheaf.isSeparated (T.obj P) V S hS _ 0 ?_
  intro V' g hg
  rw [map_zero, ← NatTrans.naturality_apply (T.map h).hom g.op s]
  rcases hg with hg | hg
  · obtain ⟨t, ht⟩ := hA V' hg (ConcreteCategory.hom ((T.obj N).obj.map g.op) s)
    have := z1 V' t
    rw [ht] at this
    exact this
  · obtain ⟨t, ht⟩ := hB V' hg (ConcreteCategory.hom ((T.obj N).obj.map g.op) s)
    have := z2 V' t
    rw [ht] at this
    exact this

theorem wc_et_zariski_mv_unit_ses : ∀ {Z : Scheme.{u}} (ℓ : ℕ) (A B : Z.Opens), A ⊔ B = ⊤ → ∀ (EA : wcEtPullData A.ι ℓ) (EB : wcEtPullData B.ι ℓ) (EC : wcEtPullData (A ⊓ B).ι ℓ), ∃ (LA : SheafOfModules.{u+1} (wcEtZModRing (A : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adjA : LA ⊣ EA.Φ) (LB : SheafOfModules.{u+1} (wcEtZModRing (B : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adjB : LB ⊣ EB.Φ) (LC : SheafOfModules.{u+1} (wcEtZModRing ((A ⊓ B : Z.Opens) : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adjC : LC ⊣ EC.Φ), Limits.PreservesFiniteLimits LA ∧ Limits.PreservesFiniteLimits LB ∧ Limits.PreservesFiniteLimits LC ∧ (∀ N, Mono (adjA.counit.app N)) ∧ (∀ N, Mono (adjB.counit.app N)) ∧ (∀ N, Mono (adjC.counit.app N)) ∧ ∃ (u : LC.obj (EC.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) ⟶ LA.obj (EA.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) (v : LC.obj (EC.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) ⟶ LB.obj (EB.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))), u ≫ adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) = adjC.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ∧ v ≫ adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) = adjC.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ∧ ∃ w : Limits.biprod.lift u (-v) ≫ Limits.biprod.desc (adjA.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) (adjB.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) = 0, (ShortComplex.mk _ _ w).ShortExact :=
by
  intro Z ℓ A B hAB EA EB EC
  obtain ⟨LA, adjA, pflA, monoA, suppA, epiA, surjA⟩ := wc_et_open_extzero_module_package A ℓ EA
  obtain ⟨LB, adjB, pflB, monoB, suppB, epiB, surjB⟩ := wc_et_open_extzero_module_package B ℓ EB
  obtain ⟨LW, adjW, pflW, monoW, suppW, epiW, surjW⟩ :=
    wc_et_open_extzero_module_package (A ⊓ B) ℓ EC

  let PA : SheafOfModules.{u+1} (wcEtZModRing Z ℓ) → Prop := fun K =>
    wcSuppIn Z (A : Set Z) ((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj K)
  let PB : SheafOfModules.{u+1} (wcEtZModRing Z ℓ) → Prop := fun K =>
    wcSuppIn Z (B : Set Z) ((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj K)
  let PW : SheafOfModules.{u+1} (wcEtZModRing Z ℓ) → Prop := fun K =>
    wcSuppIn Z ((A ⊓ B : Z.Opens) : Set Z) ((SheafOfModules.toSheaf (wcEtZModRing Z ℓ)).obj K)
  have hLA : ∀ X, PA (LA.obj X) := suppA
  have hLB : ∀ X, PB (LB.obj X) := suppB
  have hLW : ∀ X, PW (LW.obj X) := suppW
  have subA : ∀ (K G : SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (m : G ⟶ K), Mono m → PA K → PA G :=
    fun K G m hm hK => (wc_et_mod_suppIn_calculus Z ℓ (A : Set Z) (A : Set Z) K G).2.1 m hm hK
  have subB : ∀ (K G : SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (m : G ⟶ K), Mono m → PB K → PB G :=
    fun K G m hm hK => (wc_et_mod_suppIn_calculus Z ℓ (B : Set Z) (B : Set Z) K G).2.1 m hm hK
  have hWA : ∀ K, PW K → PA K := fun K hK =>
    (wc_et_mod_suppIn_calculus Z ℓ ((A ⊓ B : Z.Opens) : Set Z) (A : Set Z) K K).1 hK
      (by rw [TopologicalSpace.Opens.coe_inf]; exact Set.inter_subset_left)
  have hWB : ∀ K, PW K → PB K := fun K hK =>
    (wc_et_mod_suppIn_calculus Z ℓ ((A ⊓ B : Z.Opens) : Set Z) (B : Set Z) K K).1 hK
      (by rw [TopologicalSpace.Opens.coe_inf]; exact Set.inter_subset_right)
  have hABW : ∀ K, PA K → PB K → PW K := fun K hKA hKB => by
    have h3 := (wc_et_mod_suppIn_calculus Z ℓ (A : Set Z) (B : Set Z) K K).2.2 hKA hKB
    show wcSuppIn Z ((A ⊓ B : Z.Opens) : Set Z) _
    rw [TopologicalSpace.Opens.coe_inf]
    exact h3

  let N := SheafOfModules.unit (wcEtZModRing Z ℓ)
  have hg : Epi (Limits.biprod.desc (adjA.counit.app N) (adjB.counit.app N)) :=
    wc_et_mod_desc_epi_of_open_cover A B hAB _ _ _ _ _ (surjA N) (surjB N)
  haveI : Mono (adjA.counit.app N) := monoA N
  haveI : Mono (adjB.counit.app N) := monoB N
  haveI : Mono (adjW.counit.app N) := monoW N
  have facA : ∀ K, PA K → ∀ h : K ⟶ N,
      ∃ h' : K ⟶ LA.obj (EA.Φ.obj N), h' ≫ adjA.counit.app N = h := by
    intro K hK h
    haveI := monoA K
    haveI := epiA K hK
    haveI : IsIso (adjA.counit.app K) := isIso_of_mono_of_epi _
    refine ⟨inv (adjA.counit.app K) ≫ LA.map (EA.Φ.map h), ?_⟩
    have hn : LA.map (EA.Φ.map h) ≫ adjA.counit.app N = adjA.counit.app K ≫ h :=
      adjA.counit.naturality h
    rw [Category.assoc, hn, IsIso.inv_hom_id_assoc]
  have facB : ∀ K, PB K → ∀ h : K ⟶ N,
      ∃ h' : K ⟶ LB.obj (EB.Φ.obj N), h' ≫ adjB.counit.app N = h := by
    intro K hK h
    haveI := monoB K
    haveI := epiB K hK
    haveI : IsIso (adjB.counit.app K) := isIso_of_mono_of_epi _
    refine ⟨inv (adjB.counit.app K) ≫ LB.map (EB.Φ.map h), ?_⟩
    have hn : LB.map (EB.Φ.map h) ≫ adjB.counit.app N = adjB.counit.app K ≫ h :=
      adjB.counit.naturality h
    rw [Category.assoc, hn, IsIso.inv_hom_id_assoc]
  have facW : ∀ K, PW K → ∀ h : K ⟶ N,
      ∃ h' : K ⟶ LW.obj (EC.Φ.obj N), h' ≫ adjW.counit.app N = h := by
    intro K hK h
    haveI := monoW K
    haveI := epiW K hK
    haveI : IsIso (adjW.counit.app K) := isIso_of_mono_of_epi _
    refine ⟨inv (adjW.counit.app K) ≫ LW.map (EC.Φ.map h), ?_⟩
    have hn : LW.map (EC.Φ.map h) ≫ adjW.counit.app N = adjW.counit.app K ≫ h :=
      adjW.counit.naturality h
    rw [Category.assoc, hn, IsIso.inv_hom_id_assoc]
  obtain ⟨u, hu⟩ := facA _ (hWA _ (hLW _)) (adjW.counit.app N)
  obtain ⟨v, hv⟩ := facB _ (hWB _ (hLW _)) (adjW.counit.app N)
  have w : Limits.biprod.lift u (-v) ≫
      Limits.biprod.desc (adjA.counit.app N) (adjB.counit.app N) = 0 := by
    rw [Limits.biprod.lift_desc, hu, Preadditive.neg_comp, hv, add_neg_cancel]
  haveI : Mono u := mono_of_mono_fac hu
  haveI hf_mono : Mono (Limits.biprod.lift u (-v)) :=
    mono_of_mono_fac (Limits.biprod.lift_fst u (-v))
  have hPbA : PA (Limits.pullback (adjA.counit.app N) (adjB.counit.app N)) :=
    subA _ _ (Limits.pullback.fst _ _) inferInstance (hLA _)
  have hPbB : PB (Limits.pullback (adjA.counit.app N) (adjB.counit.app N)) :=
    subB _ _ (Limits.pullback.snd _ _) inferInstance (hLB _)
  obtain ⟨j, hj⟩ := facW _ (hABW _ hPbA hPbB)
    (Limits.pullback.fst (adjA.counit.app N) (adjB.counit.app N) ≫ adjA.counit.app N)
  have hker : Limits.IsLimit (Limits.KernelFork.ofι (Limits.biprod.lift u (-v)) w) := by
    refine Limits.KernelFork.IsLimit.ofι' _ _ (fun {T} k hk => ?_)
    have hk' : (k ≫ Limits.biprod.fst) ≫ adjA.counit.app N =
        (-(k ≫ Limits.biprod.snd)) ≫ adjB.counit.app N := by
      have e : k = Limits.biprod.lift (k ≫ Limits.biprod.fst) (k ≫ Limits.biprod.snd) := by
        apply Limits.biprod.hom_ext <;> simp
      rw [e, Limits.biprod.lift_desc] at hk
      rw [Preadditive.neg_comp]
      exact eq_neg_of_add_eq_zero_left hk
    refine ⟨Limits.pullback.lift _ _ hk' ≫ j, ?_⟩
    have hl : Limits.pullback.lift _ _ hk' ≫ j ≫ adjW.counit.app N =
        k ≫ Limits.biprod.fst ≫ adjA.counit.app N := by
      rw [hj, Limits.pullback.lift_fst_assoc, Category.assoc]
    apply Limits.biprod.hom_ext
    · simp only [Category.assoc, Limits.biprod.lift_fst]
      rw [← cancel_mono (adjA.counit.app N)]
      simp only [Category.assoc, hu, hl]
    · simp only [Category.assoc, Limits.biprod.lift_snd, Preadditive.comp_neg]
      rw [neg_eq_iff_eq_neg, ← cancel_mono (adjB.counit.app N)]
      simp only [Category.assoc, hv, hl, Preadditive.neg_comp]
      simpa only [Category.assoc, Preadditive.neg_comp] using hk'
  have hex : (ShortComplex.mk _ _ w).Exact := ShortComplex.exact_of_f_is_kernel _ hker
  exact ⟨LA, adjA, LB, adjB, LW, adjW, pflA, pflB, pflW, monoA, monoB, monoW, u, v, hu, hv, w,
    ShortComplex.ShortExact.mk' hex hf_mono hg⟩

theorem wc_et_pull_data_comp_iso : ∀ {S S' S'' : Scheme.{u}} {n : ℕ} (f : S' ⟶ S) (g : S'' ⟶ S') (k : S'' ⟶ S), g ≫ f = k → ∀ (Df : wcEtPullData f n) (Dg : wcEtPullData g n) (Dk : wcEtPullData k n), Nonempty (Dk.Φ ≅ Df.Φ ⋙ Dg.Φ) :=
by
  classical
  intro S S' S'' n f g k hk Df Dg Dk
  subst hk

  have s1 : ∀ (X : Scheme.{u}) (T : Sheaf (Scheme.smallEtaleTopology X) RingCat.{u+1})
      (a b : wcEtZModRing X n ⟶ T), a = b := by
    intro X T a b
    have key : ∀ {R : Type (u+1)} [Semiring R] (ψ ψ' : ULift.{u+1} (ZMod n) →+* R), ψ = ψ' := by
      intro R _ ψ ψ'
      have h : ψ.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom =
          ψ'.comp (ULift.ringEquiv (R := ZMod n)).symm.toRingHom := Subsingleton.elim _ _
      ext z
      have h' := congrArg (fun φ : ZMod n →+* R => φ (ULift.ringEquiv z)) h
      simpa using h'
    apply Sheaf.hom_ext
    apply sheafify_hom_ext (Scheme.smallEtaleTopology X) _ _ T.cond
    apply NatTrans.ext
    funext V
    apply RingCat.hom_ext
    exact key _ _

  have hmap : ∀ {A B : Scheme.{u}} (h : A ⟶ B) {V V' : B.Etale} (u : V ⟶ V'),
      ((wcEtBaseChange h).map u).left ≫ Limits.pullback.fst V'.hom h =
        Limits.pullback.fst V.hom h ≫ u.left ∧
      ((wcEtBaseChange h).map u).left ≫ Limits.pullback.snd V'.hom h =
        Limits.pullback.snd V.hom h := by
    intro A B h V V' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsnd : ∀ V : S.Etale, (Limits.pullbackLeftPullbackSndIso V.hom f g).symm.hom ≫
      Limits.pullback.snd (Limits.pullback.snd V.hom f) g = Limits.pullback.snd V.hom (g ≫ f) := by
    intro V
    rw [Iso.symm_hom, Iso.inv_comp_eq, Limits.pullbackLeftPullbackSndIso_hom_snd]
  choose c hc using fun V : S.Etale =>
    (⟨MorphismProperty.Over.isoMk (A := (wcEtBaseChange (g ≫ f)).obj V)
        (B := (wcEtBaseChange f ⋙ wcEtBaseChange g).obj V)
        (Limits.pullbackLeftPullbackSndIso V.hom f g).symm (hsnd V),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcEtBaseChange (g ≫ f)).obj V ≅ (wcEtBaseChange f ⋙ wcEtBaseChange g).obj V,
        c.hom.left = (Limits.pullbackLeftPullbackSndIso V.hom f g).inv)
  have nat : ∀ {V V' : S.Etale} (u : V ⟶ V'),
      (wcEtBaseChange (g ≫ f)).map u ≫ (c V').hom =
        (c V).hom ≫ (wcEtBaseChange f ⋙ wcEtBaseChange g).map u := by
    intro V V' u
    have key : ∀ (L : Limits.pullback V.hom (g ≫ f) ⟶ Limits.pullback V'.hom (g ≫ f))
        (M1 : Limits.pullback V.hom f ⟶ Limits.pullback V'.hom f)
        (M2 : Limits.pullback (Limits.pullback.snd V.hom f) g ⟶
          Limits.pullback (Limits.pullback.snd V'.hom f) g),
        L ≫ Limits.pullback.fst V'.hom (g ≫ f) = Limits.pullback.fst V.hom (g ≫ f) ≫ u.left →
        L ≫ Limits.pullback.snd V'.hom (g ≫ f) = Limits.pullback.snd V.hom (g ≫ f) →
        M1 ≫ Limits.pullback.fst V'.hom f = Limits.pullback.fst V.hom f ≫ u.left →
        M1 ≫ Limits.pullback.snd V'.hom f = Limits.pullback.snd V.hom f →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd V'.hom f) g =
          Limits.pullback.fst (Limits.pullback.snd V.hom f) g ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd V'.hom f) g =
          Limits.pullback.snd (Limits.pullback.snd V.hom f) g →
        L ≫ (Limits.pullbackLeftPullbackSndIso V'.hom f g).inv =
          (Limits.pullbackLeftPullbackSndIso V.hom f g).inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst V.hom f g)]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcEtBaseChange (g ≫ f)).map u).left ≫ (c V').hom.left =
      (c V).hom.left ≫ ((wcEtBaseChange g).map ((wcEtBaseChange f).map u)).left
    rw [hc V, hc V']
    exact key _ _ _ (hmap (g ≫ f) u).1 (hmap (g ≫ f) u).2 (hmap f u).1 (hmap f u).2
      (hmap g ((wcEtBaseChange f).map u)).1 (hmap g ((wcEtBaseChange f).map u)).2
  let α : wcEtBaseChange (g ≫ f) ≅ wcEtBaseChange f ⋙ wcEtBaseChange g := NatIso.ofComponents c nat

  haveI := Df.cont
  haveI := Dg.cont
  haveI := Dk.cont
  haveI : (wcEtBaseChange f ⋙ wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S'') :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology S') _
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S'')).app (wcEtZModRing S'' n)
  let φfg : wcEtZModRing S n ⟶ ((wcEtBaseChange f ⋙ wcEtBaseChange g).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S'')).obj
        (wcEtZModRing S'' n) :=
    Df.φ ≫ ((wcEtBaseChange f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')).map Dg.φ
  have hcompat : φfg ≫ τ = Dk.φ := s1 S _ _ _
  let ι : SheafOfModules.pushforward Dg.φ ⋙ SheafOfModules.pushforward Df.φ ≅
      SheafOfModules.pushforward Dk.φ :=
    SheafOfModules.pushforwardComp Df.φ Dg.φ ≪≫
      SheafOfModules.pushforwardNatIso φfg α ≪≫ SheafOfModules.pushforwardCongr hcompat
  exact ⟨Dk.adj.leftAdjointUniq ((Df.adj.comp Dg.adj).ofNatIsoRight ι)⟩

theorem wc_abelian_mv_extclass_base_change : ∀ {C D : Type*} [Category C] [Abelian C] [HasExt C] [Category D] [Abelian D] [HasExt D] (F : C ⥤ D) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F] {NA NB NC Λ : C} (cA : NA ⟶ Λ) (cB : NB ⟶ Λ) (cC : NC ⟶ Λ) (u : NC ⟶ NA) (v : NC ⟶ NB) (w : Limits.biprod.lift u (-v) ≫ Limits.biprod.desc cA cB = 0) (hS : (ShortComplex.mk _ _ w).ShortExact) {NA' NB' NC' Λ' : D} (cA' : NA' ⟶ Λ') (cB' : NB' ⟶ Λ') (cC' : NC' ⟶ Λ') (u' : NC' ⟶ NA') (v' : NC' ⟶ NB') (w' : Limits.biprod.lift u' (-v') ≫ Limits.biprod.desc cA' cB' = 0) (hS' : (ShortComplex.mk _ _ w').ShortExact), u ≫ cA = cC → v ≫ cB = cC → u' ≫ cA' = cC' → v' ≫ cB' = cC' → ∀ (μ : F.obj Λ ≅ Λ') (κA : NA' ⟶ F.obj NA) (κB : NB' ⟶ F.obj NB) (κC : NC' ⟶ F.obj NC), Mono (F.map cA ≫ μ.hom) → Mono (F.map cB ≫ μ.hom) → κA ≫ F.map cA ≫ μ.hom = cA' → κB ≫ F.map cB ≫ μ.hom = cB' → κC ≫ F.map cC ≫ μ.hom = cC' → ∀ (k : ℕ) (x : Abelian.Ext NC Λ k), (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor F (hS.extClass.comp x (add_comm 1 k))).comp (Abelian.Ext.mk₀ μ.hom) (add_zero (k + 1))) (zero_add (k + 1)) = hS'.extClass.comp ((Abelian.Ext.mk₀ κC).comp ((Abelian.Ext.mapExactFunctor F x).comp (Abelian.Ext.mk₀ μ.hom) (add_zero k)) (zero_add k)) (add_comm 1 k) :=
by
  intro C D _ _ _ _ _ _ F _ _ _ NA NB NC Λ cA cB cC u v w hS NA' NB' NC' Λ' cA' cB' cC' u' v' w' hS'
    hu hv hu' hv' μ κA κB κC hmA hmB hκA hκB hκC k x
  have hFS : ((ShortComplex.mk _ _ w).map F).ShortExact := hS.map_of_exact F
  have hA : u' ≫ κA = κC ≫ F.map u := by
    rw [← cancel_mono (F.map cA ≫ μ.hom)]
    simp only [Category.assoc]
    rw [hκA, hu', ← F.map_comp_assoc, hu, hκC]
  have hB : v' ≫ κB = κC ≫ F.map v := by
    rw [← cancel_mono (F.map cB ≫ μ.hom)]
    simp only [Category.assoc]
    rw [hκB, hv', ← F.map_comp_assoc, hv, hκC]
  have sq1 : κC ≫ F.map (Limits.biprod.lift u (-v)) = Limits.biprod.lift u' (-v') ≫
      Limits.biprod.desc (κA ≫ F.map Limits.biprod.inl) (κB ≫ F.map Limits.biprod.inr) := by
    rw [Limits.biprod.lift_desc, Limits.biprod.lift_eq]
    simp only [F.map_add, F.map_comp, F.map_neg, Preadditive.comp_add, Preadditive.neg_comp,
      Preadditive.comp_neg, ← Category.assoc, hA, hB]
  have sq2 : Limits.biprod.desc (κA ≫ F.map Limits.biprod.inl) (κB ≫ F.map Limits.biprod.inr) ≫
      F.map (Limits.biprod.desc cA cB) = Limits.biprod.desc cA' cB' ≫ μ.inv := by
    apply Limits.biprod.hom_ext'
    · rw [Limits.biprod.inl_desc_assoc, Limits.biprod.inl_desc_assoc, Category.assoc, ← F.map_comp,
        Limits.biprod.inl_desc, ← hκA]
      simp
    · rw [Limits.biprod.inr_desc_assoc, Limits.biprod.inr_desc_assoc, Category.assoc, ← F.map_comp,
        Limits.biprod.inr_desc, ← hκB]
      simp
  let φ : ShortComplex.mk _ _ w' ⟶ (ShortComplex.mk _ _ w).map F :=
    ShortComplex.homMk κC _ μ.inv sq1 sq2
  have hnat : hS'.extClass.comp (Abelian.Ext.mk₀ κC) (add_zero 1) =
      (Abelian.Ext.mk₀ μ.inv).comp hFS.extClass (zero_add 1) :=
    hS'.extClass_naturality hFS φ
  have hext : Abelian.Ext.mapExactFunctor F hS.extClass = hFS.extClass :=
    Abelian.Ext.mapExactFunctor_extClass F hS
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.comp_assoc_of_third_deg_zero, hext,
    ← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_comm 1 k) (by omega), ← hnat,
    Abelian.Ext.comp_assoc_of_second_deg_zero]

theorem wc_et_extzero_counit_lift : ∀ {Z Z' : Scheme.{u}} (ℓ : ℕ) (U : Z.Opens) (U' : Z'.Opens) (h' : (U' : Scheme.{u}) ⟶ (U : Scheme.{u})) (E : wcEtPullData U.ι ℓ) (E' : wcEtPullData U'.ι ℓ) (Dh' : wcEtPullData h' ℓ) (L : SheafOfModules.{u+1} (wcEtZModRing (U : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z ℓ)) (adj : L ⊣ E.Φ) (L' : SheafOfModules.{u+1} (wcEtZModRing (U' : Scheme.{u}) ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z' ℓ)) (adj' : L' ⊣ E'.Φ) (F : SheafOfModules.{u+1} (wcEtZModRing Z ℓ) ⥤ SheafOfModules.{u+1} (wcEtZModRing Z' ℓ)) (μF : F.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)) ≅ SheafOfModules.unit (wcEtZModRing Z' ℓ)) (θ : F ⋙ E'.Φ ≅ E.Φ ⋙ Dh'.Φ), Mono (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) → ∃ κ : L'.obj (E'.Φ.obj (SheafOfModules.unit (wcEtZModRing Z' ℓ))) ⟶ F.obj (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))), κ ≫ F.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫ μF.hom = adj'.counit.app (SheafOfModules.unit (wcEtZModRing Z' ℓ)) :=
by
  intro Z Z' ℓ U U' h' E E' Dh' L adj L' adj' F μF θ _
  have h1 : adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) ≫
      E.Φ.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ))) =
      𝟙 (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) :=
    adj.right_triangle_components (SheafOfModules.unit (wcEtZModRing Z ℓ))
  have hn : Dh'.Φ.map (E.Φ.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) ≫
      θ.inv.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) =
      θ.inv.app (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) ≫
        E'.Φ.map (F.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) :=
    θ.inv.naturality (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))
  obtain ⟨σ, hσdef⟩ : ∃ σ : E'.Φ.obj (F.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))) ⟶
      E'.Φ.obj (F.obj (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))),
      σ = θ.hom.app (SheafOfModules.unit (wcEtZModRing Z ℓ)) ≫
        Dh'.Φ.map (adj.unit.app (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) ≫
          θ.inv.app (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ)))) := ⟨_, rfl⟩
  have hσ : σ ≫ E'.Φ.map (F.map (adj.counit.app (SheafOfModules.unit (wcEtZModRing Z ℓ)))) =
      𝟙 _ := by
    rw [hσdef, Category.assoc, Category.assoc, ← hn, ← CategoryTheory.Functor.map_comp_assoc,
      h1]
    erw [CategoryTheory.Functor.map_id, Category.id_comp]
    exact θ.hom_inv_id_app (SheafOfModules.unit (wcEtZModRing Z ℓ))
  obtain ⟨s, hsdef⟩ : ∃ s : E'.Φ.obj (SheafOfModules.unit (wcEtZModRing Z' ℓ)) ⟶
      E'.Φ.obj (F.obj (L.obj (E.Φ.obj (SheafOfModules.unit (wcEtZModRing Z ℓ))))),
      s = E'.Φ.map μF.inv ≫ σ := ⟨_, rfl⟩
