  have hloc : ∀ (V : X.Etale) (r : (wcEtZModRing X ℓ).obj.obj (Opposite.op V)) (x : V.left),
      ∃ (V₁ : X.Etale) (j : V₁ ⟶ V) (x₁ : V₁.left) (k : ℤ), j.left x₁ = x ∧
        ((wcEtZModRing X ℓ).obj.map j.op).hom r =
          (k : (wcEtZModRing X ℓ).obj.obj (Opposite.op V₁)) ∧ (k : ZMod ℓ) = eX V r x := by
    intro V r x
    let a := eX V r
    let c := a x
    let O : V.left.Opens := ⟨{y | a y = c}, a.isLocallyConstant.isOpen_fiber c⟩
    let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (O.ι ≫ V.hom)
      (by haveI : Etale V.hom := V.prop; infer_instance)
    let j : V₁ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
    have hx : x ∈ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      exact (rfl : a x = c)
    obtain ⟨x₁, hx₁⟩ := hx
    refine ⟨V₁, j, x₁, (ZMod.cast c : ℤ), hx₁, ?_, ZMod.intCast_zmod_cast c⟩
    apply (eX V₁).injective
    ext y
