theorem wc_et_punct_top_class_indep : ∀ (K : Type u) [Field K] [IsAlgClosed K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (U₀ : (Spec (.of (MvPolynomial (Fin c) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin c) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))))ᶜ → ∀ (pr : (U : Scheme.{u}) ⟶ (U₀ : Scheme.{u})), pr ≫ U₀.ι = U.ι ≫ q → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (j : ℕ) (ω : wcEtZModExt (U₀ : Scheme.{u}) ℓ j), ω ≠ 0 → ∀ (Dpr : wcEtPullData pr ℓ) (V : Scheme.{u}) (v : V ⟶ S), Etale v → Nonempty V → ∀ (YV : Scheme.{u}) (gV : YV ⟶ V) (w : YV ⟶ (U : Scheme.{u})), IsPullback w gV (U.ι ≫ p) v → ∀ (Dw : wcEtPullData w ℓ) (k : ℕ), k • wcEtPull Dw j (wcEtPull Dpr j ω) = 0 → ℓ ∣ k :=
by
  classical
  intro K _ _ S fS m _ c P p q z0 hP hz0p hz0q U hU U₀ hU₀ pr hpr ℓ _ j ω hω Dpr V v hv hV YV gV w
    hYV Dw k hk
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos

  haveI := hv
  haveI := SmoothOfRelativeDimension.smooth m fS
  have hsec0 : ∀ (Y : Scheme.{u}) (f : Y ⟶ Spec (.of K)) [LocallyOfFiniteType f], Nonempty Y →
      ∃ y₀ : Spec (.of K) ⟶ Y, y₀ ≫ f = 𝟙 _ := by
    intro Y f _ hY
    obtain ⟨y⟩ := hY
    obtain ⟨V, hV, hyV, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
    have e : V ≤ f ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have hφ := Scheme.Hom.finiteType_appLE f (isAffineOpen_top _) hV e
    have : Nonempty V := ⟨⟨y, hyV⟩⟩
    have : Nontrivial Γ(Y, V) := Scheme.component_nontrivial Y V
    obtain ⟨m, hm⟩ := Ideal.exists_maximal Γ(Y, V)
    letI : Field (Γ(Y, V) ⧸ m) := Ideal.Quotient.field m
    let π : Γ(Y, V) →+* Γ(Y, V) ⧸ m := Ideal.Quotient.mk m
    let ι : K →+* Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
    have hι : Function.Surjective ι := by
      intro x
      refine ⟨(Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom x, ?_⟩
      show ((Scheme.ΓSpecIso (CommRingCat.of K)).hom ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).inv).hom x = x
      rw [Iso.hom_inv_id]; rfl
    let χ : K →+* Γ(Y, V) ⧸ m := π.comp ((f.appLE ⊤ V e).hom.comp ι)
    have hχ : χ.FiniteType :=
      (RingHom.FiniteType.of_surjective π Ideal.Quotient.mk_surjective).comp
        (hφ.comp (RingHom.FiniteType.of_surjective ι hι))
    letI : Algebra K (Γ(Y, V) ⧸ m) := χ.toAlgebra
    have : Algebra.FiniteType K (Γ(Y, V) ⧸ m) := hχ
    have : Module.Finite K (Γ(Y, V) ⧸ m) := finite_of_finite_type_of_isJacobsonRing K _
    have : Algebra.IsIntegral K (Γ(Y, V) ⧸ m) := Algebra.IsIntegral.of_finite K _
    have hbij : Function.Bijective χ := IsAlgClosed.algebraMap_bijective_of_isIntegral
    let ρ : Γ(Y, V) ⟶ CommRingCat.of K :=
      CommRingCat.ofHom ((RingEquiv.ofBijective χ hbij).symm.toRingHom.comp π)
    have key : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ f.appLE ⊤ V e ≫ ρ = 𝟙 _ := by
      ext k
      exact (RingEquiv.ofBijective χ hbij).symm_apply_apply k
    refine ⟨Spec.map ρ ≫ hV.fromSpec, ?_⟩
    rw [Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec f (isAffineOpen_top _) hV e,
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp, ← Spec.map_comp,
      Category.assoc, key, Spec.map_id]
  obtain ⟨v₀, hv₀⟩ := hsec0 V (v ≫ fS) hV
  have hs : (v₀ ≫ v) ≫ fS = 𝟙 _ := by rw [Category.assoc]; exact hv₀

  have h2 : ((Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) ≫ (v₀ ≫ v)) ≫ fS
      = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) := by
    rw [Category.assoc, hs, Category.comp_id, Category.id_comp]
  let σ₀ := hP.lift _ _ h2
  have hσ₀p : σ₀ ≫ p = Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) ≫ (v₀ ≫ v) :=
    hP.lift_fst _ _ h2
  have hσ₀q : σ₀ ≫ q = 𝟙 _ := hP.lift_snd _ _ h2

  have h3 : Set.range (U₀.ι ≫ σ₀) ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι, hU]
    rintro _ ⟨y, rfl⟩ ⟨t, ht⟩
    have hx : U₀.ι y = q (σ₀ (U₀.ι y)) := by
      rw [← Scheme.Hom.comp_apply, hσ₀q]; rfl
    have hx2 : q (σ₀ (U₀.ι y)) = Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) (fS t) := by
      rw [← Scheme.Hom.comp_apply U₀.ι σ₀, ← ht, ← Scheme.Hom.comp_apply, hz0q,
        Scheme.Hom.comp_apply]
    have hmem : U₀.ι y ∈ (U₀ : Set (Spec (.of (MvPolynomial (Fin c) K)))) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩
    rw [hU₀] at hmem
    exact hmem ⟨fS t, by rw [hx, hx2]⟩
  let σ₁ : (U₀ : Scheme.{u}) ⟶ (U : Scheme.{u}) := IsOpenImmersion.lift U.ι (U₀.ι ≫ σ₀) h3
  have hσ₁ : σ₁ ≫ U.ι = U₀.ι ≫ σ₀ := IsOpenImmersion.lift_fac _ _ _

  have h4 : σ₁ ≫ (U.ι ≫ p) = (U₀.ι ≫ Spec.map (CommRingCat.ofHom
      (algebraMap K (MvPolynomial (Fin c) K))) ≫ v₀) ≫ v := by
    rw [← Category.assoc, hσ₁, Category.assoc, hσ₀p]
    simp only [Category.assoc]
  let σ := hYV.lift _ _ h4
  have hσw : σ ≫ w = σ₁ := hYV.lift_fst _ _ h4

  have hsec : σ ≫ (w ≫ pr) = 𝟙 (U₀ : Scheme.{u}) := by
    apply (cancel_mono U₀.ι).mp
    rw [Category.assoc, Category.assoc, hpr, ← Category.assoc σ w, hσw, ← Category.assoc, hσ₁,
      Category.assoc, hσ₀q, Category.comp_id, Category.id_comp]

  obtain ⟨Dσ⟩ := wc_et_zmod_pull_data_exists σ ℓ
  obtain ⟨Dwp⟩ := wc_et_zmod_pull_data_exists (w ≫ pr) ℓ
  obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 (U₀ : Scheme.{u})) ℓ
  have e1 := wc_et_pull_comp pr w (w ≫ pr) rfl Dpr Dw Dwp j ω
  have e2 := wc_et_pull_comp (w ≫ pr) σ (𝟙 _) hsec Dwp Dσ Did j ω
  have hkω : k • ω = 0 := by
    apply wc_et_pull_id_injective Did j (k • ω)
    rw [map_nsmul, e2, e1, ← map_nsmul, hk, map_zero]

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (U₀ : Scheme.{u}) ℓ)) := HasExt.standard _
  have hmk : ∀ n : ℕ, Abelian.Ext.mk₀ (n • 𝟙 (SheafOfModules.unit
        (wcEtZModRing (U₀ : Scheme.{u}) ℓ))) =
      n • (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit
        (wcEtZModRing (U₀ : Scheme.{u}) ℓ))) :
        Abelian.Ext
          (SheafOfModules.unit (wcEtZModRing (U₀ : Scheme.{u}) ℓ))
          (SheafOfModules.unit (wcEtZModRing (U₀ : Scheme.{u}) ℓ)) 0) := by
    intro n
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ n ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
  have hzero : ℓ • 𝟙 (SheafOfModules.unit (wcEtZModRing (U₀ : Scheme.{u}) ℓ)) = 0 := by
    have h := (wc_et_zmod_unit_pow_exact (U₀ : Scheme.{u}) ℓ 1 hℓpos).1
    rw [pow_one] at h
    exact h
  have htor : ℓ • ω = 0 := by
    have hlin := map_nsmul (Abelian.Ext.bilinearComp
      (SheafOfModules.unit (wcEtZModRing (U₀ : Scheme.{u}) ℓ))
      (SheafOfModules.unit (wcEtZModRing (U₀ : Scheme.{u}) ℓ))
      (SheafOfModules.unit (wcEtZModRing (U₀ : Scheme.{u}) ℓ))
      j 0 j (add_zero _) ω) ℓ
      (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing (U₀ : Scheme.{u}) ℓ))))
    simp only [Abelian.Ext.bilinearComp_apply_apply] at hlin
    rw [Abelian.Ext.comp_mk₀_id] at hlin
    rw [← hlin, ← hmk, hzero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have hord : addOrderOf ω = ℓ := by
    rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd _
        (addOrderOf_dvd_of_nsmul_eq_zero htor) with h | h
    · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) hω
    · exact h
  exact hord ▸ addOrderOf_dvd_of_nsmul_eq_zero hkω

theorem wc_et_supp_vanish_of_restr : ∀ {X Z U : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i] (j : U ⟶ X) [IsOpenImmersion j], Set.range j = (Set.range i)ᶜ → ∀ (n : ℕ), 0 < n → ∀ (D : wcEtPullData i n) (Dj : wcEtPullData j n) (s : ℕ), (∀ s' : ℕ, s' + 1 = s → Function.Surjective (wcEtPull Dj s')) → Function.Injective (wcEtPull Dj s) → ∀ θ : wcEtSuppExt D s, θ = 0 :=
by
  classical
  intro X Z U i _ j _ hc n hn D Dj s hsurj hinj θ
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing X n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing U n)) := HasExt.standard _
  haveI := Dj.additive
  haveI := Dj.presLim
  haveI := Dj.presColim

  haveI hπ : Epi (wcEtSuppUnitMap D) := wc_et_supp_unit_epi i D
  have hS : (ShortComplex.mk (Limits.kernel.ι (wcEtSuppUnitMap D)) (wcEtSuppUnitMap D)
      (Limits.kernel.condition (wcEtSuppUnitMap D))).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (wcEtSuppUnitMap D)) inferInstance hπ

  have hB0 : Limits.IsZero (Dj.Φ.obj (wcEtSuppObj D)) := by
    have hsq := IsPullback.of_hasPullback i j
    haveI : IsClosedImmersion (Limits.pullback.snd i j) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq inferInstance
    have hE : IsEmpty ↥(Limits.pullback i j : Scheme.{u}) := by
      apply Scheme.isEmpty_of_commSq hsq.toCommSq
      rw [hc]
      exact disjoint_compl_right
    obtain ⟨D'⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd i j) n
    obtain ⟨γ, hγ, _⟩ := wc_et_closed_supp_base_change i j (Limits.pullback.snd i j)
      (Limits.pullback.fst i j) hsq D Dj D'
    have hZ' : Limits.IsZero (wcEtSuppObj D') := by
      rw [Limits.IsZero.iff_id_eq_zero]
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro W
      haveI := wc_et_closed_supp_obj_vanish (Limits.pullback.snd i j) n D' W.unop
        (fun _ ⟨p, _⟩ => hE.false p)
      exact (ModuleCat.isZero_of_subsingleton _).eq_of_src _ _
    have h0 : Dj.μ.inv ≫ Dj.Φ.map (wcEtSuppUnitMap D) = 0 := by
      rw [← hγ, hZ'.eq_of_src γ 0, Limits.comp_zero]
    haveI : Dj.Φ.IsLeftAdjoint := Dj.adj.isLeftAdjoint
    haveI : Epi (Dj.Φ.map (wcEtSuppUnitMap D)) := Dj.Φ.map_epi _
    exact Limits.IsZero.of_epi_eq_zero _ h0

  have hconj : ∀ (k : ℕ) (y : Abelian.Ext (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n)))
      (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n))) k),
      ((Abelian.Ext.mk₀ Dj.μ.hom).comp ((Abelian.Ext.mk₀ Dj.μ.inv).comp
        (y.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k)) (zero_add k)).comp
        (Abelian.Ext.mk₀ Dj.μ.inv) (add_zero k) = y := by
    intro k y
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.mk₀_id_comp, Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  have hpull : ∀ (k : ℕ) (x : wcEtZModExt X n k), wcEtPull Dj k x = (Abelian.Ext.mk₀ Dj.μ.inv).comp
      ((Dj.Φ.mapExtAddHom (SheafOfModules.unit (wcEtZModRing X n))
        (SheafOfModules.unit (wcEtZModRing X n)) k x).comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k))
      (zero_add k) := fun _ _ => rfl
  have hcinj : ∀ (k : ℕ) (y₁ y₂ : Abelian.Ext (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n)))
      (Dj.Φ.obj (SheafOfModules.unit (wcEtZModRing X n))) k),
      (Abelian.Ext.mk₀ Dj.μ.inv).comp (y₁.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k) =
      (Abelian.Ext.mk₀ Dj.μ.inv).comp (y₂.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k) →
      y₁ = y₂ := by
    intro k y₁ y₂ h
    rw [← hconj k y₁, h, hconj k y₂]
  have hM_surj : ∀ k : ℕ, Function.Surjective (wcEtPull Dj k) →
      Function.Surjective (Dj.Φ.mapExtAddHom (SheafOfModules.unit (wcEtZModRing X n))
        (SheafOfModules.unit (wcEtZModRing X n)) k) := by
    intro k h y
    obtain ⟨x, hx⟩ := h ((Abelian.Ext.mk₀ Dj.μ.inv).comp
      (y.comp (Abelian.Ext.mk₀ Dj.μ.hom) (add_zero k)) (zero_add k))
    exact ⟨x, hcinj k _ _ (by rw [← hpull]; exact hx)⟩
  have hM_inj : ∀ k : ℕ, Function.Injective (wcEtPull Dj k) →
      Function.Injective (Dj.Φ.mapExtAddHom (SheafOfModules.unit (wcEtZModRing X n))
        (SheafOfModules.unit (wcEtZModRing X n)) k) := by
    intro k h x₁ x₂ hx
    apply h
    rw [hpull, hpull, hx]

  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcEtZModRing X n)) :=
    sheafOfModules_enoughInjectives _ _
  have hKinj : ∀ k : ℕ, Function.Injective (Dj.Φ.mapExtAddHom
      (Limits.kernel (wcEtSuppUnitMap D)) (SheafOfModules.unit (wcEtZModRing X n)) k) := by
    intro k
    have h := ext_transfer_of_corep Dj.Φ (Limits.kernel (wcEtSuppUnitMap D))
      (Dj.Φ.obj (Limits.kernel (wcEtSuppUnitMap D))) (𝟙 _)
      (fun Y => wc_et_open_restr_ker_corep i j hc n hn D Dj Y)
      (fun I _ m e => by
        haveI : Injective (Dj.Φ.obj I) :=
          wc_et_open_pull_preserves_injective j n Dj I inferInstance
        exact Abelian.Ext.eq_zero_of_injective e)
      (SheafOfModules.unit (wcEtZModRing X n)) k
    intro a b hab
    apply h.1
    simp only [Abelian.Ext.mk₀_id_comp]
    rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply] at hab
    exact hab

  have hA : (Abelian.Ext.mk₀ (wcEtSuppUnitMap D)).comp θ (zero_add s) = 0 := by
    apply hM_inj s hinj
    have hθ0 : Abelian.Ext.mapExactFunctor Dj.Φ θ = 0 := by
      rw [← Abelian.Ext.mk₀_id_comp (Abelian.Ext.mapExactFunctor Dj.Φ θ),
        (Limits.IsZero.iff_id_eq_zero _).mp hB0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
    rw [map_zero, Functor.mapExtAddHom_apply, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, hθ0, Abelian.Ext.comp_zero]
  cases s with
  | zero =>
    rw [← Abelian.Ext.mk₀_addEquiv₀_apply θ] at hA ⊢
    rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at hA
    have ht : Abelian.Ext.addEquiv₀ θ = 0 :=
      (cancel_epi (wcEtSuppUnitMap D)).mp (by rw [hA, Limits.comp_zero])
    rw [ht, Abelian.Ext.mk₀_zero]
  | succ s' =>
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS
      (SheafOfModules.unit (wcEtZModRing X n)) θ hA (n₀ := s') (by omega)
    have hSΦ := hS.map_of_exact Dj.Φ
    haveI : IsIso (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))) :=
      hSΦ.isIso_f_iff.mpr hB0
    obtain ⟨x₂, hx₂⟩ := hM_surj s' (hsurj s' rfl)
      ((Abelian.Ext.mk₀ (inv (Dj.Φ.map (Limits.kernel.ι (wcEtSuppUnitMap D))))).comp
        (Abelian.Ext.mapExactFunctor Dj.Φ x₁) (zero_add s'))
    rw [Functor.mapExtAddHom_apply] at hx₂
    have hx₃ : (Abelian.Ext.mk₀ (Limits.kernel.ι (wcEtSuppUnitMap D))).comp x₂ (zero_add s') = x₁ := by
      apply hKinj s'
      rw [Functor.mapExtAddHom_apply, Functor.mapExtAddHom_apply, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, hx₂, ← Abelian.Ext.comp_assoc_of_second_deg_zero,
        Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [← hx₁, ← hx₃, ← Abelian.Ext.comp_assoc_of_second_deg_zero]
    have hz := hS.extClass_comp
    rw [hz, Abelian.Ext.zero_comp]

theorem wc_et_punctured_affine_top_ne_zero : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (c : ℕ), 1 ≤ c → ∀ (U₀ : (Spec (.of (MvPolynomial (Fin c) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin c) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))))ᶜ → ∃ ω : wcEtZModExt (U₀ : Scheme.{u}) ℓ (2 * c - 1), ω ≠ 0 :=
by
  classical
  intro K _ _ ℓ _ hℓ c hc U₀ hU₀
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos

  haveI hzs : IsClosedImmersion (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
      (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) := by
    have h1 : AffineSpace.homOfVector (𝟙 (Spec (.of K))) (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K)) = 𝟙 _ :=
      AffineSpace.homOfVector_over _ _
    have : IsClosedImmersion (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
        (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤)) ≫
        (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K))) := by
      rw [h1]; infer_instance
    exact IsClosedImmersion.of_comp _ (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K)) ↘ Spec (.of K))

  obtain ⟨q, hP, hzq⟩ := wc_affine_space_ulift_mvpoly_zero_pullback K (Spec (.of K)) (𝟙 _) c
  rw [Category.id_comp] at hzq
  haveI : IsIso q := hP.isIso_snd_of_isIso
  have hqinj : Function.Injective q := by
    intro a b hab
    have ha : (q ≫ inv q) a = a := by simp
    have hb : (q ≫ inv q) b = b := by simp
    rw [← ha, ← hb, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hab]

  have hiso_inj : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) [IsIso h] (Dhi : wcEtPullData (inv h) ℓ)
      (i : ℕ) (y : wcEtZModExt X ℓ i), wcEtPull Dhi i y = 0 → y = 0 := by
    intro X Y h _ Dhi i y hy
    obtain ⟨Dh⟩ := wc_et_zmod_pull_data_exists h ℓ
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 X) ℓ
    apply wc_et_pull_id_injective Did i y
    rw [wc_et_pull_comp (inv h) h (𝟙 X) (IsIso.hom_inv_id h) Dhi Dh Did i y, hy, map_zero]

  have hU' : Set.range (q ⁻¹ᵁ U₀).ι = (Set.range (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
      (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))))ᶜ := by
    rw [Scheme.Opens.range_ι]
    ext x
    change q x ∈ (U₀ : Set _) ↔ _
    rw [hU₀, Set.mem_compl_iff, Set.mem_compl_iff, not_iff_not]
    constructor
    · rintro ⟨y, hy⟩
      refine ⟨y, hqinj ?_⟩
      rw [← Scheme.Hom.comp_apply, hzq]
      exact hy
    · rintro ⟨y, rfl⟩
      exact ⟨y, by rw [← Scheme.Hom.comp_apply, hzq]⟩

  by_contra hne
  push_neg at hne
  obtain ⟨D0⟩ := wc_et_zmod_pull_data_exists (AffineSpace.homOfVector (𝟙 (Spec (.of K)))
      (0 : ULift.{u} (Fin c) → Γ(Spec (.of K), ⊤))) ℓ
  obtain ⟨Dj⟩ := wc_et_zmod_pull_data_exists (q ⁻¹ᵁ U₀).ι ℓ
  obtain ⟨Dgi⟩ := wc_et_zmod_pull_data_exists (inv (q ∣_ U₀)) ℓ
  obtain ⟨Dqi⟩ := wc_et_zmod_pull_data_exists (inv q) ℓ
  have hsurj : ∀ s' : ℕ, s' + 1 = 2 * c → Function.Surjective (wcEtPull Dj s') := by
    intro s' hs' y
    obtain rfl : s' = 2 * c - 1 := by omega
    refine ⟨0, ?_⟩
    rw [map_zero]
    exact (hiso_inj (q ∣_ U₀) Dgi _ y (hne _)).symm
  haveI hsubA : Subsingleton (wcEtZModExt (Spec (.of (MvPolynomial (Fin c) K))) ℓ (2 * c)) := by
    haveI := wc_et_affine_space_coh_vanishing K ℓ (Fact.out) hℓ c (2 * c) (by omega)
    exact (wc_et_zmodext_coh_equiv _ ℓ (2 * c)).some.subsingleton
  haveI hsubX : Subsingleton (wcEtZModExt (AffineSpace (ULift.{u} (Fin c)) (Spec (.of K))) ℓ (2 * c)) :=
    ⟨fun a b => by
      rw [hiso_inj q Dqi _ a (Subsingleton.elim _ _), hiso_inj q Dqi _ b (Subsingleton.elim _ _)]⟩
  have hinj2 : Function.Injective (wcEtPull Dj (2 * c)) := Function.injective_of_subsingleton _
  have hvan := wc_et_supp_vanish_of_restr _ (q ⁻¹ᵁ U₀).ι hU' ℓ hℓpos D0 Dj (2 * c) hsurj hinj2
  obtain ⟨θ, hθ⟩ := wc_et_affine_origin_supp_ext_ne_zero K ℓ hℓ c D0
  exact hθ (hvan θ)

theorem wc_punct_line_laurent_iso : ∀ (K : Type u) [Field K] (U₀ : (Spec (.of (MvPolynomial (Fin 1) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin 1) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K))))ᶜ → ∃ e : (U₀ : Scheme.{u}) ≅ Spec (.of (LaurentPolynomial K)), e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) = U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K))) :=
by
  intro K _ U₀ hU₀
  classical
  let φ : MvPolynomial (Fin 1) K →ₐ[K] LaurentPolynomial K :=
    MvPolynomial.aeval (fun _ : Fin 1 => (LaurentPolynomial.T 1 : LaurentPolynomial K))
  have hφX : φ (MvPolynomial.X 0) = LaurentPolynomial.T 1 := MvPolynomial.aeval_X _ _

  let ψ : MvPolynomial (Fin 1) K →ₐ[K] Polynomial K :=
    MvPolynomial.aeval (fun _ : Fin 1 => (Polynomial.X : Polynomial K))
  let χ : Polynomial K →ₐ[K] MvPolynomial (Fin 1) K := Polynomial.aeval (MvPolynomial.X 0)
  have hχψ : χ.comp ψ = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [Fin.fin_one_eq_zero i]
    simp [χ, ψ]
  have hφψ : Polynomial.toLaurentAlg.comp ψ = φ := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [ψ, φ, Polynomial.toLaurent_X]
  have hinj : Function.Injective φ := by
    intro a b hab
    have h1 : Polynomial.toLaurent (ψ a) = Polynomial.toLaurent (ψ b) := by
      rw [← Polynomial.toLaurentAlg_apply, ← Polynomial.toLaurentAlg_apply, ← AlgHom.comp_apply,
        ← AlgHom.comp_apply, hφψ]
      exact hab
    have h3 := congrArg χ (Polynomial.toLaurent_injective h1)
    have ha : χ (ψ a) = a := by
      rw [← AlgHom.comp_apply, hχψ]; rfl
    have hb : χ (ψ b) = b := by
      rw [← AlgHom.comp_apply, hχψ]; rfl
    rw [ha, hb] at h3
    exact h3
  have hpol : ∀ f : Polynomial K,
      φ (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) f) = Polynomial.toLaurent f := by
    intro f
    have h : φ.comp (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 1) K)) =
        Polynomial.toLaurentAlg := by
      apply Polynomial.algHom_ext
      rw [AlgHom.comp_apply, Polynomial.aeval_X, hφX, Polynomial.toLaurentAlg_apply,
        Polynomial.toLaurent_X]
    rw [← Polynomial.toLaurentAlg_apply, ← h, AlgHom.comp_apply]

  letI : Algebra (MvPolynomial (Fin 1) K) (LaurentPolynomial K) := φ.toRingHom.toAlgebra
  have halg : ∀ a, algebraMap (MvPolynomial (Fin 1) K) (LaurentPolynomial K) a = φ a :=
    fun _ => rfl
  haveI hloc : IsLocalization.Away (MvPolynomial.X 0 : MvPolynomial (Fin 1) K)
      (LaurentPolynomial K) := by
    apply IsLocalization.Away.mk
    · rw [halg, hφX]; exact LaurentPolynomial.isUnit_T 1
    · intro s
      obtain ⟨n, f, hf⟩ := LaurentPolynomial.exists_T_pow s
      refine ⟨n, Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) f, ?_⟩
      rw [halg, halg, hφX, hpol, hf, LaurentPolynomial.T_pow, mul_one]
    · intro a b h
      exact ⟨0, by rw [hinj h]⟩

  have hs3 : (U₀ : Set (Spec (.of (MvPolynomial (Fin 1) K)))) =
      ((PrimeSpectrum.basicOpen (MvPolynomial.X 0 : MvPolynomial (Fin 1) K)) :
        Set (PrimeSpectrum (MvPolynomial (Fin 1) K))) := by
    rw [hU₀]
    ext p
    change p ∉ _ ↔ (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) ∉ p.asIdeal
    rw [not_iff_not]
    constructor
    · rintro ⟨z, rfl⟩
      change MvPolynomial.constantCoeff (MvPolynomial.X 0 : MvPolynomial (Fin 1) K) ∈ z.asIdeal
      rw [MvPolynomial.constantCoeff_X]
      exact Ideal.zero_mem _
    · intro hX
      have hker : RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K) ≤
          p.asIdeal := by
        intro f hf
        rw [RingHom.mem_ker] at hf
        have hspan : f ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin 1))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro mm hmm
          have hm0 : mm ≠ 0 := by
            rintro rfl
            rw [MvPolynomial.constantCoeff_eq] at hf
            exact (MvPolynomial.mem_support_iff.mp hmm) hf
          obtain ⟨i, hi⟩ : ∃ i, mm i ≠ 0 := by
            by_contra hcon
            exact hm0 (Finsupp.ext fun a => by
              by_contra ha
              exact hcon ⟨a, ha⟩)
          exact ⟨i, Set.mem_univ _, hi⟩
        refine (Ideal.span_le.mpr ?_) hspan
        rintro _ ⟨i, -, rfl⟩
        rw [Fin.fin_one_eq_zero i]
        exact hX
      have hmax := RingHom.ker_isMaximal_of_surjective
        (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K)
        (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ a⟩)
      have e1 := hmax.eq_of_le p.isPrime.ne_top hker
      refine ⟨(⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum K), ?_⟩
      apply PrimeSpectrum.ext
      rw [← e1]
      ext f
      change MvPolynomial.constantCoeff f ∈ (⊥ : Ideal K) ↔ _
      rw [RingHom.mem_ker, Ideal.mem_bot]

  have hr : Set.range U₀.ι = Set.range (Spec.map (CommRingCat.ofHom
      (algebraMap (MvPolynomial (Fin 1) K) (LaurentPolynomial K)))) := by
    rw [Scheme.Opens.range_ι, hs3, ← PrimeSpectrum.localization_away_comap_range
      (LaurentPolynomial K) (MvPolynomial.X 0 : MvPolynomial (Fin 1) K)]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨y, rfl⟩
    · rintro ⟨y, rfl⟩
      exact ⟨y, rfl⟩
  haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap (MvPolynomial (Fin 1) K) (LaurentPolynomial K)))) :=
    IsOpenImmersion.of_isLocalization (MvPolynomial.X 0 : MvPolynomial (Fin 1) K)
  refine ⟨IsOpenImmersion.isoOfRangeEq U₀.ι _ hr, ?_⟩
  have hfac := IsOpenImmersion.isoOfRangeEq_hom_fac U₀.ι _ hr
  have hcomp : Spec.map (CommRingCat.ofHom
      (algebraMap (MvPolynomial (Fin 1) K) (LaurentPolynomial K))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin 1) K))) =
      Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    exact φ.comp_algebraMap
  conv_rhs => rw [← hfac]
  rw [Category.assoc, hcomp]

theorem wc_punct_bundle_restrict_isPullback : ∀ (K : Type u) [Field K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (U₀ : (Spec (.of (MvPolynomial (Fin c) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin c) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))))ᶜ → ∀ (pr : (U : Scheme.{u}) ⟶ (U₀ : Scheme.{u})), pr ≫ U₀.ι = U.ι ≫ q → IsPullback (U.ι ≫ p) pr fS (U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) :=
by
  intro K _ S fS c P p q z0 hP hz0p hz0q U hU U₀ hU₀
  have hog : Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap]
    simp
  have hsec : IsPullback z0 fS q (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) := by
    refine IsPullback.of_right ?_ hz0q hP
    rw [hz0p, hog]
    exact IsPullback.id_horiz fS
  have key : ∀ x : P, q x ∈ Set.range (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) ↔ x ∈ Set.range z0 := by
    intro x
    constructor
    · rintro ⟨t, ht⟩
      obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := q)
        (g := Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) x t ht.symm
      have h1 : (hsec.isoPullback.inv ≫ z0) w = x := by
        rw [hsec.isoPullback_inv_fst, hw]
      rw [Scheme.Hom.comp_apply] at h1
      exact ⟨_, h1⟩
    · rintro ⟨s, rfl⟩
      refine ⟨fS s, ?_⟩
      rw [← Scheme.Hom.comp_apply fS, ← Scheme.Hom.comp_apply z0 q, hz0q]
  have hUeq : U = q ⁻¹ᵁ U₀ := by
    apply TopologicalSpace.Opens.ext
    rw [Scheme.Hom.coe_preimage, hU, hU₀]
    ext x
    simp only [Set.mem_compl_iff, Set.mem_preimage]
    exact not_congr (key x).symm
  subst hUeq
  intro pr hpr
  have hpr' : pr = q ∣_ U₀ := by
    rw [← cancel_mono U₀.ι, hpr, morphismRestrict_ι]
  subst hpr'
  exact IsPullback.paste_horiz (isPullback_morphismRestrict q U₀).flip hP

theorem wc_smooth_field_exists_irreducible_open_nbhd : ∀ (K : Type u) [Field K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (x : S), ∃ N : S.Opens, x ∈ N ∧ IrreducibleSpace (N : Scheme.{u}) :=
by
  classical

  have hs2 : ∀ (B : Type u) [CommRing B] [IsDomain B] [UniqueFactorizationMonoid B]
      (F g : Polynomial B), F.Monic →
      (∃ (p₁ p₂ : Polynomial B) (n : ℕ), Polynomial.derivative F * p₁ + F * p₂ = g ^ n) →
      ∀ (Q : Ideal (Localization.Away (AdjoinRoot.mk F g))), Q.IsPrime →
      ∃ h : Localization.Away (AdjoinRoot.mk F g), h ∉ Q ∧
        ∃ Q₀ : Ideal (Localization.Away (AdjoinRoot.mk F g)), Q₀.IsPrime ∧ h ∉ Q₀ ∧
          ∀ Q'' : Ideal (Localization.Away (AdjoinRoot.mk F g)), Q''.IsPrime → h ∉ Q'' → Q₀ ≤ Q'' := by
    intro B _ _ _ F g hF hcond Q hQ
    obtain ⟨p₁, p₂, n, hpn⟩ := hcond
    let ψ : Polynomial B →+* Localization.Away (AdjoinRoot.mk F g) :=
      (algebraMap (AdjoinRoot F) (Localization.Away (AdjoinRoot.mk F g))).comp (AdjoinRoot.mk F)
    have ψF : ψ F = 0 := by simp [ψ, AdjoinRoot.mk_self]
    have ψg : IsUnit (ψ g) := IsLocalization.Away.algebraMap_isUnit (AdjoinRoot.mk F g)
    have ψsurj : ∀ t : Localization.Away (AdjoinRoot.mk F g), ∃ k : ℕ, ∃ a : Polynomial B,
        t * (ψ g) ^ k = ψ a := by
      intro t
      obtain ⟨⟨a', ⟨_, k, rfl⟩⟩, ha⟩ :=
        IsLocalization.surj (Submonoid.powers (AdjoinRoot.mk F g)) t
      obtain ⟨a, rfl⟩ := AdjoinRoot.mk_surjective a'
      exact ⟨k, a, by simpa [ψ, map_pow] using ha⟩

    have stepB : ∀ (π F₁ : Polynomial B), F = π * F₁ → ∀ 𝔭 : Ideal (Polynomial B), 𝔭.IsPrime →
        π ∈ 𝔭 → F₁ ∈ 𝔭 → g ∈ 𝔭 := by
      intro π F₁ hF1 𝔭 h𝔭 hπ hF₁
      apply h𝔭.mem_of_pow_mem n
      rw [← hpn, hF1, Polynomial.derivative_mul]
      exact 𝔭.add_mem
        (𝔭.mul_mem_right _ (𝔭.add_mem (𝔭.mul_mem_left _ hF₁) (𝔭.mul_mem_right _ hπ)))
        (𝔭.mul_mem_right _ (𝔭.mul_mem_right _ hπ))
    have h𝔮 : (Q.comap ψ).IsPrime := Ideal.comap_isPrime ψ Q
    have hF𝔮 : F ∈ Q.comap ψ := by
      rw [Ideal.mem_comap, ψF]; exact Q.zero_mem
    have hg𝔮 : g ∉ Q.comap ψ := fun h => Ideal.notMem_of_isUnit Q ψg h
    have hF0 : F ≠ 0 := hF.ne_zero

    obtain ⟨π, hπmem, hπ𝔮⟩ : ∃ π ∈ UniqueFactorizationMonoid.factors F, π ∈ Q.comap ψ := by
      obtain ⟨u, hu⟩ := UniqueFactorizationMonoid.factors_prod hF0
      have hprod : (UniqueFactorizationMonoid.factors F).prod ∈ Q.comap ψ := by
        have h1 : (UniqueFactorizationMonoid.factors F).prod * (u : Polynomial B) ∈ Q.comap ψ := by
          rw [hu]; exact hF𝔮
        rcases h𝔮.mem_or_mem h1 with h | h
        · exact h
        · exact absurd h (Ideal.notMem_of_isUnit _ u.isUnit)
      exact (h𝔮.multiset_prod_mem_iff_exists_mem _).mp hprod
    have hπprime : Prime π := UniqueFactorizationMonoid.prime_of_factor π hπmem
    obtain ⟨F₁, hF₁⟩ := UniqueFactorizationMonoid.dvd_of_mem_factors hπmem
    have hπg : ¬ π ∣ g := by
      rintro ⟨c, hc⟩
      apply hg𝔮
      have hmem : π * c ∈ Q.comap ψ := Ideal.mul_mem_right _ _ hπ𝔮
      rw [← hc] at hmem
      exact hmem

    refine ⟨ψ F₁, ?_, ?_⟩
    · intro hmem
      exact hg𝔮 (stepB π F₁ hF₁ _ h𝔮 hπ𝔮 hmem)

    have hspan : (Ideal.span {π} : Ideal (Polynomial B)).IsPrime :=
      (Ideal.span_singleton_prime hπprime.ne_zero).mpr hπprime
    have : IsDomain (Polynomial B ⧸ Ideal.span {π}) := Ideal.Quotient.isDomain _
    let θ : Polynomial B →+* FractionRing (Polynomial B ⧸ Ideal.span {π}) :=
      (algebraMap (Polynomial B ⧸ Ideal.span {π})
        (FractionRing (Polynomial B ⧸ Ideal.span {π}))).comp (Ideal.Quotient.mk _)
    have θ0 : ∀ a, θ a = 0 ↔ π ∣ a := by
      intro a
      simp only [θ, RingHom.comp_apply]
      rw [map_eq_zero_iff _ (IsFractionRing.injective _ _), Ideal.Quotient.eq_zero_iff_mem,
        Ideal.mem_span_singleton]
    have θF : ∀ a ∈ (Ideal.span {F} : Ideal (Polynomial B)), θ a = 0 := by
      intro a ha
      rw [θ0]
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [hF₁]
      exact ⟨c * F₁, by ring⟩
    let χ₀ : AdjoinRoot F →+* FractionRing (Polynomial B ⧸ Ideal.span {π}) :=
      Ideal.Quotient.lift (Ideal.span {F}) θ θF
    have χ₀mk : ∀ a, χ₀ (AdjoinRoot.mk F a) = θ a := fun a => rfl
    have hχ₀g : IsUnit (χ₀ (AdjoinRoot.mk F g)) := by
      rw [χ₀mk]
      exact Ne.isUnit (fun h => hπg ((θ0 g).mp h))
    let χ : Localization.Away (AdjoinRoot.mk F g) →+*
        FractionRing (Polynomial B ⧸ Ideal.span {π}) :=
      IsLocalization.Away.lift (AdjoinRoot.mk F g) hχ₀g
    have χψ : ∀ a, χ (ψ a) = θ a := by
      intro a
      simp only [χ, ψ, RingHom.comp_apply]
      rw [IsLocalization.Away.lift_eq]
      exact χ₀mk a
    refine ⟨RingHom.ker χ, RingHom.ker_isPrime χ, ?_, ?_⟩
    ·
      rw [RingHom.mem_ker, χψ, θ0]
      intro hdvd
      apply hπg
      have h1 : π ∈ (Ideal.span {π} : Ideal (Polynomial B)) := Ideal.mem_span_singleton_self π
      have h2 : F₁ ∈ (Ideal.span {π} : Ideal (Polynomial B)) := Ideal.mem_span_singleton.mpr hdvd
      exact Ideal.mem_span_singleton.mp (stepB π F₁ hF₁ _ hspan h1 h2)
    ·
      intro Q'' hQ'' hhQ''
      have hπQ : ψ π ∈ Q'' := by
        have h0 : ψ π * ψ F₁ ∈ Q'' := by
          rw [← map_mul, ← hF₁, ψF]; exact Q''.zero_mem
        rcases hQ''.mem_or_mem h0 with h | h
        · exact h
        · exact absurd h hhQ''
      intro t ht
      rw [RingHom.mem_ker] at ht
      obtain ⟨k, a, hka⟩ := ψsurj t
      have hθa : θ a = 0 := by
        rw [← χψ, ← hka, map_mul, ht, zero_mul]
      obtain ⟨b, rfl⟩ := (θ0 a).mp hθa
      have hmem : t * (ψ g) ^ k ∈ Q'' := by
        rw [hka, map_mul]; exact Q''.mul_mem_right _ hπQ
      rcases hQ''.mem_or_mem hmem with h | h
      · exact h
      · exact absurd h (Ideal.notMem_of_isUnit _ (ψg.pow k))

  have hs3 : ∀ (B R : Type u) [CommRing B] [IsDomain B] [UniqueFactorizationMonoid B] [CommRing R]
      (φ : B →+* R), φ.Etale → ∀ (Q : Ideal R), Q.IsPrime →
      ∃ h : R, h ∉ Q ∧ ∃ Q₀ : Ideal R, Q₀.IsPrime ∧ h ∉ Q₀ ∧
        ∀ Q'' : Ideal R, Q''.IsPrime → h ∉ Q'' → Q₀ ≤ Q'' := by
    intro B R _ _ _ _ φ hφ Q hQ
    letI := φ.toAlgebra
    have : Algebra.Etale B R := hφ
    obtain ⟨f, hfQ, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := B) Q
    obtain ⟨P⟩ := hstd.nonempty_standardEtalePresentation
    let e : Localization.Away (AdjoinRoot.mk P.f P.g) ≃+* Localization.Away f :=
      (P.equivAwayAdjoinRoot.symm.trans
        (AlgEquiv.ofBijective (P.lift P.x P.hasMap) P.lift_bijective)).toRingEquiv
    let ι := algebraMap R (Localization.Away f)
    have hu : IsUnit (ι f) := IsLocalization.Away.algebraMap_isUnit f
    have locPrime : ∀ I : Ideal R, I.IsPrime → f ∉ I →
        (I.map ι).IsPrime ∧ (I.map ι).comap ι = I := by
      intro I hI hfI
      have hdisj : Disjoint (Submonoid.powers f : Set R) I :=
        (Ideal.disjoint_powers_iff_notMem f hI.isRadical).mpr hfI
      exact ⟨IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f) _ I hI hdisj,
        IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f) _ hI hdisj⟩
    obtain ⟨hQf, hQfc⟩ := locPrime Q hQ hfQ
    have hQ' : (Ideal.comap e (Q.map ι)).IsPrime := Ideal.comap_isPrime e _
    obtain ⟨h', hh'Q, Q₀', hQ₀', hh'Q₀', hmin'⟩ := hs2 B P.f P.g P.monic_f P.cond _ hQ'
    obtain ⟨⟨a, ⟨_, k, rfl⟩⟩, ha⟩ := IsLocalization.surj (Submonoid.powers f) (e h')
    simp only at ha
    have hfQ₀ : ∀ I : Ideal (Localization.Away f), I.IsPrime → ∀ j : ℕ, ι (f ^ j) ∉ I := by
      intro I hI j
      rw [map_pow]
      exact Ideal.notMem_of_isUnit I (hu.pow j)
    refine ⟨a * f, ?_, Ideal.comap ι (Ideal.comap e.symm Q₀'), ?_, ?_, ?_⟩
    · intro hmem
      rcases hQ.mem_or_mem hmem with h | h
      · apply hh'Q
        rw [Ideal.mem_comap]
        have h2 : ι a ∈ Q.map ι := Ideal.mem_map_of_mem ι h
        rw [← ha] at h2
        rcases hQf.mem_or_mem h2 with h3 | h3
        · exact h3
        · exact absurd h3 (hfQ₀ _ hQf k)
      · exact hfQ h
    · exact Ideal.comap_isPrime ι _
    · intro hmem
      rw [Ideal.mem_comap, Ideal.mem_comap] at hmem
      have hQ₀'' : (Ideal.comap e.symm Q₀').IsPrime := Ideal.comap_isPrime e.symm _
      have hmem' : e h' * ι (f ^ (k + 1)) ∈ Ideal.comap e.symm Q₀' := by
        rw [pow_succ, map_mul, ← mul_assoc, ha, ← map_mul]
        exact hmem
      rcases hQ₀''.mem_or_mem hmem' with h | h
      · apply hh'Q₀'
        rw [Ideal.mem_comap, RingEquiv.symm_apply_apply] at h
        exact h
      · exact hfQ₀ _ hQ₀'' (k + 1) h
    · intro Q'' hQ'' hnot
      have hfQ'' : f ∉ Q'' := fun h => hnot (Q''.mul_mem_left a h)
      have haQ'' : a ∉ Q'' := fun h => hnot (Q''.mul_mem_right f h)
      obtain ⟨hQ''f, hQ''fc⟩ := locPrime Q'' hQ'' hfQ''
      have hcomap : (Ideal.comap e (Q''.map ι)).IsPrime := Ideal.comap_isPrime e _
      have hh'not : h' ∉ Ideal.comap e (Q''.map ι) := by
        intro hm
        rw [Ideal.mem_comap] at hm
        apply haQ''
        rw [← hQ''fc, Ideal.mem_comap, ← ha]
        exact Ideal.mul_mem_right _ _ hm
      have hle := hmin' _ hcomap hh'not
      intro y hy
      rw [Ideal.mem_comap, Ideal.mem_comap] at hy
      have := hle hy
      rw [Ideal.mem_comap, RingEquiv.apply_symm_apply] at this
      rw [← hQ''fc, Ideal.mem_comap]
      exact this

  have hs4 : ∀ (S : Scheme.{u}) (V : S.Opens) (hV : IsAffineOpen V) (x : S) (hx : x ∈ V)
      (h : Γ(S, V)), h ∉ (hV.primeIdealOf ⟨x, hx⟩).asIdeal → ∀ (Q₀ : Ideal Γ(S, V)), Q₀.IsPrime →
      h ∉ Q₀ → (∀ Q'' : Ideal Γ(S, V), Q''.IsPrime → h ∉ Q'' → Q₀ ≤ Q'') →
      ∃ N : S.Opens, x ∈ N ∧ IrreducibleSpace (N : Scheme.{u}) := by
    intro S V hV x hx h hh Q₀ hQ₀ hhQ₀ hmin
    have hpre : hV.fromSpec ⁻¹ᵁ S.basicOpen h = PrimeSpectrum.basicOpen h :=
      hV.fromSpec_preimage_basicOpen h
    refine ⟨S.basicOpen h, ?_, ?_⟩
    · have e1 : hV.fromSpec (hV.primeIdealOf ⟨x, hx⟩) = x := hV.fromSpec_primeIdealOf ⟨x, hx⟩
      rw [← e1]
      show hV.primeIdealOf ⟨x, hx⟩ ∈ hV.fromSpec ⁻¹ᵁ S.basicOpen h
      rw [hpre]; exact hh
    · apply isIrreducible_iff_irreducibleSpace.mp
      have himage : hV.fromSpec '' (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum Γ(S, V))) =
          (S.basicOpen h : Set S) := by
        ext z
        constructor
        · rintro ⟨y, hy, rfl⟩
          have : y ∈ hV.fromSpec ⁻¹ᵁ S.basicOpen h := by rw [hpre]; exact hy
          exact this
        · intro hz
          have hzV : z ∈ (V : Set S) := S.basicOpen_le h hz
          rw [← hV.range_fromSpec] at hzV
          obtain ⟨y, rfl⟩ := hzV
          refine ⟨y, ?_, rfl⟩
          have : y ∈ hV.fromSpec ⁻¹ᵁ S.basicOpen h := hz
          rw [hpre] at this
          exact this
      rw [← himage]
      apply IsIrreducible.image _ _ hV.fromSpec.continuous.continuousOn
      let q₀ : PrimeSpectrum Γ(S, V) := ⟨Q₀, hQ₀⟩
      refine ⟨⟨q₀, hhQ₀⟩, ?_⟩
      refine (isIrreducible_singleton (x := q₀)).closure.isPreirreducible.open_subset
        (PrimeSpectrum.isOpen_basicOpen) ?_
      intro y hy
      rw [← specializes_iff_mem_closure, ← PrimeSpectrum.le_iff_specializes]
      exact hmin y.asIdeal y.isPrime hy

  intro K _ S fS m _ x
  obtain ⟨U, hU, V, hV, hxV, e, hstd⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (f := fS) (n := m) x
  obtain ⟨g, -, hg⟩ := hstd.exists_etale_mvPolynomial
  have hUtop : U = ⊤ := by
    rw [eq_top_iff]
    intro y _
    have : y = fS x := Subsingleton.elim _ _
    rw [this]; exact e hxV
  subst hUtop
  let ι : K ≃+* Γ(Spec (.of K), ⊤) :=
    (Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv.symm
  have hφ : (g.comp (MvPolynomial.mapEquiv (Fin m) ι).toRingHom).Etale :=
    RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.of_bijective (MvPolynomial.mapEquiv (Fin m) ι).bijective) hg

  obtain ⟨h, hhQ, Q₀, hQ₀, hhQ₀, hmin⟩ := hs3 (MvPolynomial (Fin m) K) Γ(S, V) _ hφ
    (hV.primeIdealOf ⟨x, hxV⟩).asIdeal (hV.primeIdealOf ⟨x, hxV⟩).isPrime
  exact hs4 S V hV x hxV h hhQ Q₀ hQ₀ hhQ₀ hmin

theorem wc_et_h0_irreducible_nsmul_one : ∀ (Y : Scheme.{u}) [IrreducibleSpace Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (b : wcEtZModExt Y ℓ 0), ∃ k : ℕ, b = k • (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) : wcEtZModExt Y ℓ 0) :=
by
  intro Y _ ℓ _ b
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Y ℓ)) := HasExt.standard _
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hℓ0 : ℓ ≠ 0 := hℓpos.ne'
  obtain ⟨hfin, hcard⟩ := wc_et_coh_zero_irreducible_card_le Y ℓ hℓ0
  obtain ⟨e⟩ := wc_et_zmodext_coh_equiv Y ℓ 0
  haveI : Finite (wcEtZModExt Y ℓ 0) := Finite.of_equiv _ e.symm
  have hc : Nat.card (wcEtZModExt Y ℓ 0) ≤ ℓ := by rw [Nat.card_congr e]; exact hcard
  have hmk : ∀ m : ℕ, Abelian.Ext.mk₀ (m • 𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) =
      m • Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) := by
    intro m
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
  have htor : ℓ • (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) :
      wcEtZModExt Y ℓ 0) = 0 := by
    have h := (wc_et_zmod_unit_pow_exact Y ℓ 1 hℓpos).1
    rw [pow_one] at h
    rw [← hmk, h, Abelian.Ext.mk₀_zero]
  by_cases h1 : (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) :
      wcEtZModExt Y ℓ 0) = 0
  · refine ⟨0, ?_⟩
    rw [zero_smul]
    calc b = b.comp (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))))
          (add_zero 0) := (Abelian.Ext.comp_mk₀_id b).symm
      _ = 0 := by rw [h1, Abelian.Ext.comp_zero]
  · have hord : addOrderOf (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) :
        wcEtZModExt Y ℓ 0) = ℓ := by
      rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd _
          (addOrderOf_dvd_of_nsmul_eq_zero htor) with h | h
      · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) h1
      · exact h
    have htop : AddSubgroup.zmultiples (Abelian.Ext.mk₀
        (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) : wcEtZModExt Y ℓ 0) = ⊤ :=
      AddSubgroup.eq_top_of_le_card _ (by rw [Nat.card_zmultiples, hord]; exact hc)
    have hmem : b ∈ AddSubgroup.zmultiples (Abelian.Ext.mk₀
        (𝟙 (SheafOfModules.unit (wcEtZModRing Y ℓ))) : wcEtZModExt Y ℓ 0) := by
      rw [htop]; exact AddSubgroup.mem_top _
    rw [← mem_multiples_iff_mem_zmultiples] at hmem
    obtain ⟨k, hk⟩ := (AddSubmonoid.mem_multiples_iff _ _).mp hmem
    exact ⟨k, hk.symm⟩

theorem wc_et_punct_top_base_case : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (U₀ : (Spec (.of (MvPolynomial (Fin 1) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin 1) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin 1) K →+* K))))ᶜ → ∃ ω : wcEtZModExt (U₀ : Scheme.{u}) ℓ 1, wcEtPunctTopCore K ℓ 1 U₀ 1 ω :=
by
  classical
  intro K _ _ ℓ _ hℓ U₀ hU₀

  have hmul : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n) (a b c : ℕ)
      (hc : a + b = c) (x : wcEtZModExt S n a) (y : wcEtZModExt S n b),
      wcEtPull D c (wcEtZModCup S n a b c hc x y) =
        wcEtZModCup S' n a b c hc (wcEtPull D a x) (wcEtPull D b y) := by
    intro S S' g n D a b c hc x y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hc)).comp (Abelian.Ext.mk₀ D.μ.hom)
          (add_zero c)) (zero_add c) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        (zero_add a)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) hc
    rw [Abelian.Ext.mapExactFunctor_comp]
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) (zero_add b) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b) := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.hom) (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (add_zero 0) (zero_add b) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    symm
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (zero_add a) hc (by omega),
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x) (Abelian.Ext.mk₀ D.μ.hom)
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (add_zero a) (zero_add b) (by omega),
      e1,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x)
        (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) hc (add_zero b)
        (by omega)]

  have hone : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n),
      wcEtPull D 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S n)))) =
        @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
          (𝟙 (SheafOfModules.unit (wcEtZModRing S' n))) := by
    intro S S' g n D
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ
          (Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S n))))).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0)) (zero_add 0) =
      Abelian.Ext.mk₀ (𝟙 (SheafOfModules.unit (wcEtZModRing S' n)))
    rw [Abelian.Ext.mapExactFunctor_mk₀, CategoryTheory.Functor.map_id, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀, Category.id_comp, Iso.inv_hom_id]

  have hlunit : ∀ (S : Scheme.{u}) (n : ℕ) (z : wcEtZModExt S n 1),
      wcEtZModCup S n 0 1 (0 + 1) rfl (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S n)))) z = z := by
    intro S n z
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    simp only [wcEtZModCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.mk₀_id_comp z

  obtain ⟨e, he⟩ := wc_punct_line_laurent_iso K U₀ hU₀
  obtain ⟨κ, hκ⟩ := wc_et_gm_kunneth_surj K ℓ hℓ
  obtain ⟨Deh⟩ := wc_et_zmod_pull_data_exists e.hom ℓ
  refine ⟨wcEtPull Deh 1 κ, ?_⟩
  intro S fS m _ P p q z0 hP hz0p hz0q U hU pr hpr α x

  have hU₀sq := wc_punct_bundle_restrict_isPullback K S fS 1 P p q z0 hP hz0p hz0q U hU U₀ hU₀
    pr hpr
  have hQ : IsPullback (U.ι ≫ p) (pr ≫ e.hom) fS
      (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) := by
    refine IsPullback.of_iso hU₀sq (Iso.refl _) (Iso.refl _) e (Iso.refl _) ?_ ?_ ?_ ?_
    · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
    · simp only [Iso.refl_hom, Category.id_comp]
    · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
    · rw [Iso.refl_hom, Category.comp_id]
      exact he.symm
  obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists (U.ι ≫ p) ℓ
  obtain ⟨Dt⟩ := wc_et_zmod_pull_data_exists (pr ≫ e.hom) ℓ
  obtain ⟨γ0, γ1, hα⟩ := (hκ S fS m _ (U.ι ≫ p) (pr ≫ e.hom) hQ Dr Dt).2 0 α

  obtain ⟨N, hxN, hNirr⟩ := wc_smooth_field_exists_irreducible_open_nbhd K S fS m x
  haveI := hNirr
  obtain ⟨DN⟩ := wc_et_zmod_pull_data_exists N.ι ℓ
  obtain ⟨k, hk1⟩ := wc_et_h0_irreducible_nsmul_one (N : Scheme.{u}) ℓ (wcEtPull DN 0 γ1)
  obtain ⟨S1, s1, hs1, hx1, hkill⟩ := wc_et_zmodext_pos_locally_zero (N : Scheme.{u}) ℓ
    (Fact.out : Nat.Prime ℓ).ne_zero 1 le_rfl (wcEtPull DN (0 + 1) γ0) ⟨x, hxN⟩
  haveI := hs1
  refine ⟨S1, s1 ≫ N.ι, inferInstance, ?_, k, ?_⟩
  · obtain ⟨y, hy⟩ := hx1
    refine ⟨y, ?_⟩
    rw [Scheme.Hom.comp_apply, hy]
    rfl
  · intro Y' h' w' hsq Dw' Dc
    obtain ⟨Ds1⟩ := wc_et_zmod_pull_data_exists s1 ℓ
    obtain ⟨Ds'⟩ := wc_et_zmod_pull_data_exists (s1 ≫ N.ι) ℓ
    obtain ⟨Dh'⟩ := wc_et_zmod_pull_data_exists h' ℓ
    obtain ⟨Dwr⟩ := wc_et_zmod_pull_data_exists (w' ≫ U.ι ≫ p) ℓ
    obtain ⟨Dwt⟩ := wc_et_zmod_pull_data_exists (w' ≫ pr ≫ e.hom) ℓ
    have E0 : wcEtPull Ds' (0 + 1) γ0 = 0 := by
      rw [wc_et_pull_comp N.ι s1 (s1 ≫ N.ι) rfl DN Ds1 Ds' (0 + 1) γ0]
      exact hkill Ds1
    have E1 : wcEtPull Ds' 0 γ1 = k • (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (𝟙 (SheafOfModules.unit (wcEtZModRing S1 ℓ))) : wcEtZModExt S1 ℓ 0) := by
      rw [wc_et_pull_comp N.ι s1 (s1 ≫ N.ι) rfl DN Ds1 Ds' 0 γ1, hk1, map_nsmul, hone Ds1]
    have E3 : ∀ (i : ℕ) (β : wcEtZModExt S ℓ i),
        wcEtPull Dw' i (wcEtPull Dr i β) = wcEtPull Dh' i (wcEtPull Ds' i β) := by
      intro i β
      rw [← wc_et_pull_comp (U.ι ≫ p) w' (w' ≫ U.ι ≫ p) rfl Dr Dw' Dwr i β,
        wc_et_pull_comp (s1 ≫ N.ι) h' (w' ≫ U.ι ≫ p) hsq.w.symm Ds' Dh' Dwr i β]
    have E4 : wcEtPull Dw' 1 (wcEtPull Dt 1 κ) = wcEtPull Dwt 1 κ :=
      (wc_et_pull_comp (pr ≫ e.hom) w' (w' ≫ pr ≫ e.hom) rfl Dt Dw' Dwt 1 κ).symm
    have E5 : wcEtPull Dc 1 (wcEtPull Deh 1 κ) = wcEtPull Dwt 1 κ :=
      (wc_et_pull_comp e.hom (w' ≫ pr) (w' ≫ pr ≫ e.hom) (Category.assoc _ _ _) Deh Dc Dwt
        1 κ).symm
    have key : wcEtPull Dw' (0 + 1) α = k • wcEtPull Dwt 1 κ := by
      rw [hα, map_add, hmul Dw' 0 1 (0 + 1) rfl, E3, E3, E0, E1, E4, map_zero,
        map_nsmul, hone Dh', map_nsmul, AddMonoidHom.nsmul_apply, hlunit]
      exact zero_add _
    rw [E5]
    exact key

theorem wc_et_ptcov_kchart : ∀ (K : Type u) [Field K] (c' : ℕ) (W₀ : (Spec (.of (MvPolynomial (Fin c') K))).Opens), (W₀ : Set (Spec (.of (MvPolynomial (Fin c') K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K))))ᶜ → ∀ (U₀ : (Spec (.of (MvPolynomial (Fin (c' + 1)) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin (c' + 1)) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K))))ᶜ → ∃ (rab₀ : ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ⟶ (W₀ : Scheme.{u})) (tab₀ : ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ⟶ Spec (.of (LaurentPolynomial K))) (rb₀ : ((wcEtPtCovB0 U₀ : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ⟶ (W₀ : Scheme.{u})), IsPullback rab₀ tab₀ (W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K)))) ∧ (U₀ : Scheme.{u}).homOfLE (show wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ ≤ wcEtPtCovB0 U₀ from inf_le_right) ≫ rb₀ = rab₀ ∧ rb₀ ≫ W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) = (wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) :=
by
  intro K _ c' W₀ hW₀ U₀ hU₀

  have star : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (x : Spec (.of S)) (r : R),
      r ∈ (Spec.map (CommRingCat.ofHom φ) x).asIdeal ↔ φ r ∈ x.asIdeal := by
    intro R S _ _ φ x r
    exact Iff.rfl

  have L0 : ∀ (c : ℕ) (y : Spec (.of (MvPolynomial (Fin c) K))),
      y ∈ Set.range (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) ↔
      ∀ i : Fin c, (MvPolynomial.X i : MvPolynomial (Fin c) K) ∈ y.asIdeal := by
    intro c y
    constructor
    · rintro ⟨t, rfl⟩ i
      rw [star, MvPolynomial.constantCoeff_X]
      exact Ideal.zero_mem _
    · intro hX
      have hker : RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K) ≤
          y.asIdeal := by
        intro f hf
        have hspan : f ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin c))) := by
          rw [MvPolynomial.mem_ideal_span_X_image]
          intro mm hmm
          have hm0 : mm ≠ 0 := by
            rintro rfl
            rw [RingHom.mem_ker, MvPolynomial.constantCoeff_eq] at hf
            exact (MvPolynomial.mem_support_iff.mp hmm) hf
          obtain ⟨i, hi⟩ : ∃ i, mm i ≠ 0 := by
            by_contra hcon
            exact hm0 (Finsupp.ext fun a => by
              by_contra ha
              exact hcon ⟨a, ha⟩)
          exact ⟨i, Set.mem_univ _, hi⟩
        refine (Ideal.span_le.mpr ?_) hspan
        rintro _ ⟨i, -, rfl⟩
        exact hX i
      have hmax := RingHom.ker_isMaximal_of_surjective
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)
        (fun a => ⟨MvPolynomial.C a, MvPolynomial.constantCoeff_C _ a⟩)
      have e1 := hmax.eq_of_le y.isPrime.ne_top hker
      let z : Spec (.of K) := IsLocalRing.closedPoint K
      have e2 := hmax.eq_of_le (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) z).isPrime.ne_top
          (fun f hf => by
            show MvPolynomial.constantCoeff f ∈ z.asIdeal
            rw [RingHom.mem_ker.mp hf]
            exact Ideal.zero_mem _)
      exact ⟨z, PrimeSpectrum.ext (e2.symm.trans e1)⟩

  have s2 : ∀ {Z X Y S X₀ Y₀ N : Scheme.{u}} (ρ : Z ⟶ X) (τ : Z ⟶ Y) (f : X ⟶ S) (g : Y ⟶ S),
      IsPullback ρ τ f g → ∀ (i₁ : X₀ ⟶ X) (i₂ : Y₀ ⟶ Y) (ιN : N ⟶ Z) [IsOpenImmersion i₁]
      [IsOpenImmersion i₂] [IsOpenImmersion ιN],
      (∀ z : Z, ρ z ∈ Set.range i₁ → τ z ∈ Set.range i₂ → z ∈ Set.range ιN) →
      ∀ (r : N ⟶ X₀) (t : N ⟶ Y₀), r ≫ i₁ = ιN ≫ ρ → t ≫ i₂ = ιN ≫ τ →
      IsPullback r t (i₁ ≫ f) (i₂ ≫ g) := by
    intro Z X Y S X₀ Y₀ N ρ τ f g h i₁ i₂ ιN _ _ _ hR r t hr ht
    let m := Limits.pullback.map (i₁ ≫ f) (i₂ ≫ g) f g i₁ i₂ (𝟙 S) (Category.comp_id _)
      (Category.comp_id _)
    have : IsOpenImmersion m :=
      MorphismProperty.pullbackMap (P := @IsOpenImmersion) (inferInstance : IsOpenImmersion i₁)
        (inferInstance : IsOpenImmersion i₂) rfl rfl
    have hm := Scheme.Pullback.range_map (i₁ ≫ f) (i₂ ≫ g) f g i₁ i₂ (𝟙 S)
      (Category.comp_id _) (Category.comp_id _)
    have hm1 : m ≫ Limits.pullback.fst f g = Limits.pullback.fst (i₁ ≫ f) (i₂ ≫ g) ≫ i₁ :=
      Limits.pullback.lift_fst _ _ _
    have hm2 : m ≫ Limits.pullback.snd f g = Limits.pullback.snd (i₁ ≫ f) (i₂ ≫ g) ≫ i₂ :=
      Limits.pullback.lift_snd _ _ _
    have hrange : Set.range ιN = Set.range (m ≫ h.isoPullback.inv) := by
      ext z
      constructor
      · rintro ⟨n, rfl⟩
        have k1 : (ιN ≫ h.isoPullback.hom ≫ Limits.pullback.fst f g) n = i₁ (r n) := by
          rw [h.isoPullback_hom_fst, ← hr, Scheme.Hom.comp_apply]
        have k2 : (ιN ≫ h.isoPullback.hom ≫ Limits.pullback.snd f g) n = i₂ (t n) := by
          rw [h.isoPullback_hom_snd, ← ht, Scheme.Hom.comp_apply]
        simp only [Scheme.Hom.comp_apply] at k1 k2
        have h3 : h.isoPullback.hom (ιN n) ∈ Set.range m := by
          rw [hm]
          exact ⟨⟨r n, k1.symm⟩, ⟨t n, k2.symm⟩⟩
        obtain ⟨v, hv⟩ := h3
        exact ⟨v, by rw [Scheme.Hom.comp_apply, hv, Scheme.hom_inv_apply]⟩
      · rintro ⟨v, rfl⟩
        have k1 : (m ≫ h.isoPullback.inv ≫ ρ) v =
            (Limits.pullback.fst (i₁ ≫ f) (i₂ ≫ g) ≫ i₁) v := by
          rw [h.isoPullback_inv_fst, hm1]
        have k2 : (m ≫ h.isoPullback.inv ≫ τ) v =
            (Limits.pullback.snd (i₁ ≫ f) (i₂ ≫ g) ≫ i₂) v := by
          rw [h.isoPullback_inv_snd, hm2]
        simp only [Scheme.Hom.comp_apply] at k1 k2
        apply hR
        · rw [Scheme.Hom.comp_apply, k1]
          exact ⟨_, rfl⟩
        · rw [Scheme.Hom.comp_apply, k2]
          exact ⟨_, rfl⟩
    obtain ⟨φ, hφ⟩ : ∃ φ : N ≅ Limits.pullback (i₁ ≫ f) (i₂ ≫ g),
        φ.hom ≫ m ≫ h.isoPullback.inv = ιN :=
      ⟨_, IsOpenImmersion.isoOfRangeEq_hom_fac ιN (m ≫ h.isoPullback.inv) hrange⟩
    have hfst : φ.hom ≫ Limits.pullback.fst (i₁ ≫ f) (i₂ ≫ g) = r := by
      rw [← cancel_mono i₁, Category.assoc, ← hm1, hr]
      calc _ = (φ.hom ≫ m ≫ h.isoPullback.inv) ≫ ρ := by
            simp only [Category.assoc, IsPullback.isoPullback_inv_fst]
        _ = ιN ≫ ρ := by rw [hφ]
    have hsnd : φ.hom ≫ Limits.pullback.snd (i₁ ≫ f) (i₂ ≫ g) = t := by
      rw [← cancel_mono i₂, Category.assoc, ← hm2, ht]
      calc _ = (φ.hom ≫ m ≫ h.isoPullback.inv) ≫ τ := by
            simp only [Category.assoc, IsPullback.isoPullback_inv_snd]
        _ = ιN ≫ τ := by rw [hφ]
    refine IsPullback.of_iso_pullback ⟨?_⟩ φ hfst hsnd
    rw [reassoc_of% hr, reassoc_of% ht, h.toCommSq.w]

  have s3 : IsOpenImmersion (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) ∧ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) = {x | (Polynomial.X : Polynomial K) ∉ x.asIdeal} ∧ Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K))) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K))) = Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))) := by
    refine ⟨IsOpenImmersion.of_isLocalization (Polynomial.X : Polynomial K), ?_, ?_⟩
    · have hr := PrimeSpectrum.localization_away_comap_range (LaurentPolynomial K)
        (Polynomial.X : Polynomial K)
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        have h1 : PrimeSpectrum.comap (algebraMap (Polynomial K) (LaurentPolynomial K)) y ∈
            Set.range (PrimeSpectrum.comap (algebraMap (Polynomial K) (LaurentPolynomial K))) :=
          ⟨y, rfl⟩
        rw [hr] at h1
        exact (PrimeSpectrum.mem_basicOpen _ _).1 h1
      · intro hx
        have h1 : (x : PrimeSpectrum (Polynomial K)) ∈
            ((PrimeSpectrum.basicOpen (Polynomial.X : Polynomial K)) :
              Set (PrimeSpectrum (Polynomial K))) := hx
        rw [← hr] at h1
        obtain ⟨y, hy⟩ := h1
        exact ⟨y, hy⟩
    · have h : (algebraMap (Polynomial K) (LaurentPolynomial K)).comp (algebraMap K (Polynomial K)) =
          algebraMap K (LaurentPolynomial K) := by
        refine RingHom.ext fun k => ?_
        simp [LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_C,
          LaurentPolynomial.algebraMap_apply]
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]

  have s1 : ∃ ι : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ≅ Spec (.of (MvPolynomial (Fin (c' + 1)) K)), ι.hom ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) = Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) ∧ ι.hom ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) = Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    let Ψ : MvPolynomial (Fin (c' + 1)) K ≃ₐ[K]
        TensorProduct K (MvPolynomial (Fin c') K) (Polynomial K) :=
      (MvPolynomial.finSuccEquiv K c').trans (polyEquivTensor K (MvPolynomial (Fin c') K))
    have hX0 : Ψ (MvPolynomial.X 0) = 1 ⊗ₜ Polynomial.X := by
      simp [Ψ, MvPolynomial.finSuccEquiv_X_zero, polyEquivTensor_apply]
    have hXs : ∀ j : Fin c', Ψ (MvPolynomial.X j.succ) = MvPolynomial.X j ⊗ₜ 1 := by
      intro j
      simp [Ψ, MvPolynomial.finSuccEquiv_X_succ, polyEquivTensor_apply]
    have I1 : (Ψ.toRingEquiv.toRingHom).comp
        (MvPolynomial.rename Fin.succ :
          MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom =
        Algebra.TensorProduct.includeLeftRingHom := by
      have : (Ψ.toAlgHom.comp (MvPolynomial.rename Fin.succ)) =
          (Algebra.TensorProduct.includeLeft : MvPolynomial (Fin c') K →ₐ[K] _) := by
        apply MvPolynomial.algHom_ext
        intro j
        simp [hXs]
      refine RingHom.ext fun x => ?_
      have hx := AlgHom.congr_fun this x
      simpa using hx
    have I2 : (Ψ.toRingEquiv.toRingHom).comp
        (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom =
        (Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] _).toRingHom := by
      have : (Ψ.toAlgHom.comp (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K))) =
          (Algebra.TensorProduct.includeRight : Polynomial K →ₐ[K] _) := by
        apply Polynomial.algHom_ext
        simp [hX0]
      refine RingHom.ext fun x => ?_
      have hx := AlgHom.congr_fun this x
      simpa using hx
    let e : Spec (.of (TensorProduct K (MvPolynomial (Fin c') K) (Polynomial K))) ≅
        Spec (.of (MvPolynomial (Fin (c' + 1)) K)) :=
      Scheme.Spec.mapIso (Ψ.toRingEquiv.toCommRingCatIso).op
    have he : e.hom = Spec.map (CommRingCat.ofHom Ψ.toRingEquiv.toRingHom) := rfl
    refine ⟨pullbackSpecIso K _ _ ≪≫ e, ?_, ?_⟩
    · rw [Iso.trans_hom, Category.assoc, he, ← Spec.map_comp, ← CommRingCat.ofHom_comp, I1]
      exact pullbackSpecIso_hom_fst K _ _
    · rw [Iso.trans_hom, Category.assoc, he, ← Spec.map_comp, ← CommRingCat.ofHom_comp, I2]
      exact pullbackSpecIso_hom_snd K _ _
  obtain ⟨ι, e₁, e₂⟩ := s1
  obtain ⟨hj, hjr, hjq⟩ := s3
  haveI := hj

  have hσ' : ι.inv ≫ Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) = Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) := by
    rw [← e₁, Iso.inv_hom_id_assoc]
  have hε' : ι.inv ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) = Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) := by
    rw [← e₂, Iso.inv_hom_id_assoc]
  have hpb : IsPullback (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) (Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom)) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K)))) (Spec.map (CommRingCat.ofHom (algebraMap K (Polynomial K)))) := by
    refine IsPullback.of_iso_pullback ⟨?_⟩ ι.symm hσ' hε'
    rw [← hσ', ← hε', Category.assoc, Category.assoc, Limits.pullback.condition]

  have C1 : ∀ (y : Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (i : Fin c'),
      (MvPolynomial.X i : MvPolynomial (Fin c') K) ∈ (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) y).asIdeal ↔
        (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K) ∈ y.asIdeal := by
    intro y i
    rw [star]
    simp [MvPolynomial.rename_X]
  have C2 : ∀ (y : Spec (.of (MvPolynomial (Fin (c' + 1)) K))),
      (Polynomial.X : Polynomial K) ∈ (Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) y).asIdeal ↔
        (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) ∈ y.asIdeal := by
    intro y
    rw [star]
    simp [Polynomial.aeval_X]

  have hAmem : ∀ u : (U₀ : Scheme.{u}), u ∈ wcEtPtCovA0 U₀ ↔
      (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K) ∉ (U₀.ι u).asIdeal := fun u => Iff.rfl
  have hBmem : ∀ u : (U₀ : Scheme.{u}), u ∈ wcEtPtCovB0 U₀ ↔
      ∃ i : Fin c', (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K) ∉ (U₀.ι u).asIdeal :=
    fun u => TopologicalSpace.Opens.mem_iSup (s := fun i : Fin c' =>
      PrimeSpectrum.basicOpen (MvPolynomial.X i.succ : MvPolynomial (Fin (c' + 1)) K)) (x := U₀.ι u)
  have hNmem : ∀ u : (U₀ : Scheme.{u}), u ∈ wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ ↔
      u ∈ wcEtPtCovA0 U₀ ∧ u ∈ wcEtPtCovB0 U₀ := fun u => Iff.rfl

  have hB : Set.range ((wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom)) ⊆ Set.range W₀.ι := by
    rintro _ ⟨b, rfl⟩
    have hb : (wcEtPtCovB0 U₀).ι b ∈ Set.range (wcEtPtCovB0 U₀).ι := ⟨b, rfl⟩
    rw [Scheme.Opens.range_ι] at hb
    obtain ⟨i, hi⟩ := (hBmem _).1 hb
    rw [Scheme.Opens.range_ι, hW₀, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply,
      Set.mem_compl_iff]
    intro hmem
    exact hi ((C1 _ i).1 ((L0 c' _).1 hmem i))
  obtain ⟨rb₀, hrb⟩ : ∃ rb₀ : ((wcEtPtCovB0 U₀ : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ⟶ (W₀ : Scheme.{u}),
      rb₀ ≫ W₀.ι = (wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hB⟩

  have hA : Set.range ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom)) ⊆ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) := by
    rintro _ ⟨n, rfl⟩
    have hn : (wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι n ∈
        Set.range (wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι := ⟨n, rfl⟩
    rw [Scheme.Opens.range_ι] at hn
    have h0 := (hAmem _).1 ((hNmem _).1 hn).1
    rw [hjr, Set.mem_setOf_eq, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, C2]
    exact h0
  obtain ⟨tab₀, htb⟩ : ∃ tab₀ : ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ⟶ Spec (.of (LaurentPolynomial K)),
      tab₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K))) = (wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) :=
    ⟨_, IsOpenImmersion.lift_fac _ _ hA⟩

  have hσa : Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c') K))) = Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K))) := by
    have h : (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom.comp (algebraMap K (MvPolynomial (Fin c') K)) = algebraMap K (MvPolynomial (Fin (c' + 1)) K) :=
      RingHom.ext fun k => by simp
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]
  refine ⟨(U₀ : Scheme.{u}).homOfLE (show wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ ≤ wcEtPtCovB0 U₀ from inf_le_right) ≫ rb₀, tab₀, rb₀, ?_, rfl, ?_⟩
  ·
    have hRange : ∀ z : Spec (.of (MvPolynomial (Fin (c' + 1)) K)),
        Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) z ∈ Set.range W₀.ι →
        Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) z ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K)))) →
        z ∈ Set.range ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι) := by
      intro z hz1 hz2
      rw [Scheme.Opens.range_ι, hW₀, Set.mem_compl_iff, L0] at hz1
      push_neg at hz1
      obtain ⟨i, hi⟩ := hz1
      rw [C1] at hi
      rw [hjr, Set.mem_setOf_eq, C2] at hz2
      obtain ⟨u, rfl⟩ : z ∈ Set.range U₀.ι := by
        rw [Scheme.Opens.range_ι, hU₀, Set.mem_compl_iff, L0]
        exact fun h => hz2 (h 0)
      obtain ⟨n, rfl⟩ : u ∈ Set.range (wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι := by
        rw [Scheme.Opens.range_ι]
        exact (hNmem u).2 ⟨(hAmem u).2 hz2, (hBmem u).2 ⟨i, hi⟩⟩
      exact ⟨n, by rw [Scheme.Hom.comp_apply]⟩
    have hr1 : ((U₀ : Scheme.{u}).homOfLE (show wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ ≤ wcEtPtCovB0 U₀ from inf_le_right) ≫ rb₀) ≫ W₀.ι = ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι) ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin c') K →ₐ[K] MvPolynomial (Fin (c' + 1)) K).toRingHom) := by
      simp only [Category.assoc, hrb, Scheme.homOfLE_ι_assoc]
    have ht1 : tab₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap (Polynomial K) (LaurentPolynomial K))) = ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι) ≫ Spec.map (CommRingCat.ofHom (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin (c' + 1)) K)).toRingHom) := by
      rw [htb, Category.assoc]
    have hP := s2 _ _ _ _ hpb W₀.ι _ ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀).ι ≫ U₀.ι) hRange _ _ hr1 ht1
    rw [hjq] at hP
    exact hP
  ·
    rw [← Category.assoc rb₀, hrb]
    simp only [Category.assoc, hσa]

theorem wc_et_bd_level_exists : ∀ (K : Type u) [Field K] (c : ℕ) (W₀ : (Spec (.of (MvPolynomial (Fin c) K))).Opens), (W₀ : Set (Spec (.of (MvPolynomial (Fin c) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))))ᶜ → ∀ (T : Scheme.{u}) (t : T ⟶ Spec (.of K)), ∃ (P' : Scheme.{u}) (p' : P' ⟶ T) (q' : P' ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0' : T ⟶ P') (U' : P'.Opens) (pr' : (U' : Scheme.{u}) ⟶ (W₀ : Scheme.{u})), IsPullback p' q' t (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) ∧ z0' ≫ p' = 𝟙 T ∧ z0' ≫ q' = t ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) ∧ (U' : Set P') = (Set.range z0')ᶜ ∧ pr' ≫ W₀.ι = U'.ι ≫ q' :=
by
  classical
  intro K _ c W₀ hW₀ T t
  have hoa : Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap]
    simp
  have hP := IsPullback.of_hasPullback t
    (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))
  let z0' : T ⟶ Limits.pullback t
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) :=
    Limits.pullback.lift (𝟙 T) (t ≫ Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)))
      (by rw [Category.id_comp, Category.assoc, hoa, Category.comp_id])
  have hz0p : z0' ≫ Limits.pullback.fst t
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) = 𝟙 T :=
    Limits.pullback.lift_fst _ _ _
  have hz0q : z0' ≫ Limits.pullback.snd t
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) =
      t ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) :=
    Limits.pullback.lift_snd _ _ _
  have hzsq : IsPullback z0' t (Limits.pullback.snd t
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))))
      (Spec.map (CommRingCat.ofHom
        (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) := by
    refine IsPullback.of_right ?_ hz0q hP
    rw [hz0p, hoa]
    exact IsPullback.id_horiz t
  refine ⟨_, _, _, z0', Limits.pullback.snd t
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) ⁻¹ᵁ W₀,
    Limits.pullback.snd t
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) ∣_ W₀,
    hP, hz0p, hz0q, ?_, morphismRestrict_ι _ _⟩
  ext y
  have hy : y ∈ ((Limits.pullback.snd t
      (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) ⁻¹ᵁ W₀ :
        (Limits.pullback t
          (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))))).Opens) :
        Set _) ↔
      Limits.pullback.snd t
        (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) y ∈
        (W₀ : Set (Spec (.of (MvPolynomial (Fin c) K)))) := Iff.rfl
  rw [hy, hW₀, Set.mem_compl_iff, Set.mem_compl_iff]
  apply not_congr
  constructor
  · rintro ⟨k, hk⟩
    obtain ⟨s, hs, -⟩ := Scheme.exists_preimage_of_isPullback hzsq y k hk.symm
    exact ⟨s, hs⟩
  · rintro ⟨s, rfl⟩
    refine ⟨t s, ?_⟩
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hz0q]

theorem wc_et_bd_punct_isPullback : ∀ (K : Type u) [Field K] (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (c : ℕ) (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin c) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (U₀ : (Spec (.of (MvPolynomial (Fin c) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin c) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))))ᶜ → ∀ (pr : (U : Scheme.{u}) ⟶ (U₀ : Scheme.{u})), pr ≫ U₀.ι = U.ι ≫ q → IsPullback pr (U.ι ≫ p) (U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) fS :=
by
  intro K _ S fS c P p q z0 hP hz0p hz0q U hU U₀ hU₀ pr hpr
  have hoπ : Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K))) = 𝟙 _ := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.constantCoeff_comp_algebraMap]
    simp
  have hsq : IsPullback z0 fS q (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) := by
    refine IsPullback.of_right ?_ hz0q hP
    rw [hz0p, hoπ]
    exact IsPullback.id_horiz fS
  have hrange : ∀ x : P, x ∈ Set.range z0 ↔ q x ∈ Set.range (Spec.map (CommRingCat.ofHom
      (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) := by
    intro x
    constructor
    · rintro ⟨s, rfl⟩
      refine ⟨fS s, ?_⟩
      rw [← Scheme.Hom.comp_apply fS, ← Scheme.Hom.comp_apply z0 q, hz0q]
    · rintro ⟨t, ht⟩
      obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := q)
        (g := Spec.map (CommRingCat.ofHom
          (MvPolynomial.constantCoeff : MvPolynomial (Fin c) K →+* K))) x t ht.symm
      have h1 : (hsq.isoPullback.inv ≫ z0) w = x := by
        rw [hsq.isoPullback_inv_fst, hw]
      rw [Scheme.Hom.comp_apply] at h1
      exact ⟨_, h1⟩
  have hUeq : q ⁻¹ᵁ U₀ = U := by
    apply TopologicalSpace.Opens.ext
    ext x
    show q x ∈ (U₀ : Set _) ↔ x ∈ (U : Set P)
    rw [hU₀, hU, Set.mem_compl_iff, Set.mem_compl_iff, hrange]
  have hU' : IsPullback pr U.ι U₀.ι q :=
    IsOpenImmersion.isPullback pr U.ι U₀.ι q hpr.symm
      (by rw [Scheme.Opens.opensRange_ι, Scheme.Opens.opensRange_ι, hUeq])
  exact hU'.paste_vert hP.flip

theorem wc_et_open_chart_base_change : ∀ {Y₀ W G Sk T Y1 P' : Scheme.{u}} (aY : Y₀ ⟶ Sk) (aW : W ⟶ Sk) (g : G ⟶ Sk) (N₀ B₀ : Y₀.Opens) (hNB : N₀ ≤ B₀) (rab₀ : (N₀ : Scheme.{u}) ⟶ W) (tab₀ : (N₀ : Scheme.{u}) ⟶ G) (rb₀ : (B₀ : Scheme.{u}) ⟶ W), IsPullback rab₀ tab₀ aW g → Y₀.homOfLE hNB ≫ rb₀ = rab₀ → rb₀ ≫ aW = B₀.ι ≫ aY → ∀ (t : T ⟶ Sk) (h1 : Y1 ⟶ T) (g1 : Y1 ⟶ Y₀), IsPullback g1 h1 aY t → ∀ (p' : P' ⟶ T) (pr' : P' ⟶ W), IsPullback pr' p' aW t → ∃ (rab : ((g1 ⁻¹ᵁ N₀ : Y1.Opens) : Scheme.{u}) ⟶ P') (bB : ((g1 ⁻¹ᵁ B₀ : Y1.Opens) : Scheme.{u}) ⟶ P'), IsPullback rab ((g1 ∣_ N₀) ≫ tab₀) (p' ≫ t) g ∧ rab ≫ pr' = (g1 ∣_ N₀) ≫ rab₀ ∧ Y1.homOfLE (show g1 ⁻¹ᵁ N₀ ≤ g1 ⁻¹ᵁ B₀ from fun _ hy => hNB hy) ≫ bB = rab ∧ rab ≫ p' = (g1 ⁻¹ᵁ N₀).ι ≫ h1 :=
by
  intro Y₀ W G Sk T Y1 P' aY aW g N₀ B₀ hNB rab₀ tab₀ rb₀ H1 H2 H3 t h1 g1 H4 p' pr' H5
  have hle : g1 ⁻¹ᵁ N₀ ≤ g1 ⁻¹ᵁ B₀ := fun _ hy => hNB hy
  have s1 : (g1 ∣_ B₀ ≫ rb₀) ≫ aW = ((g1 ⁻¹ᵁ B₀).ι ≫ h1) ≫ t := by
    rw [Category.assoc, H3, ← Category.assoc, morphismRestrict_ι, Category.assoc,
      H4.toCommSq.w, Category.assoc]
  let bB := H5.lift (g1 ∣_ B₀ ≫ rb₀) ((g1 ⁻¹ᵁ B₀).ι ≫ h1) s1
  have hbB1 : bB ≫ pr' = g1 ∣_ B₀ ≫ rb₀ := H5.lift_fst _ _ _
  have hbB2 : bB ≫ p' = (g1 ⁻¹ᵁ B₀).ι ≫ h1 := H5.lift_snd _ _ _
  let rab := Y1.homOfLE hle ≫ bB
  have s4 : Y1.homOfLE hle ≫ (g1 ∣_ B₀) = (g1 ∣_ N₀) ≫ Y₀.homOfLE hNB := by
    rw [← cancel_mono B₀.ι]
    simp only [Category.assoc, morphismRestrict_ι, Scheme.homOfLE_ι, Scheme.homOfLE_ι_assoc]
  have hb : rab ≫ pr' = (g1 ∣_ N₀) ≫ rab₀ := by
    show (Y1.homOfLE hle ≫ bB) ≫ pr' = _
    rw [Category.assoc, hbB1, ← Category.assoc, s4, Category.assoc, H2]
  have hd : rab ≫ p' = (g1 ⁻¹ᵁ N₀).ι ≫ h1 := by
    show (Y1.homOfLE hle ≫ bB) ≫ p' = _
    rw [Category.assoc, hbB2, Scheme.homOfLE_ι_assoc]
  have s7 : rab₀ ≫ aW = N₀.ι ≫ aY := by
    rw [← H2, Category.assoc, H3, ← Category.assoc, Scheme.homOfLE_ι]
  have s8 : IsPullback (g1 ∣_ N₀) ((g1 ⁻¹ᵁ N₀).ι ≫ h1) (N₀.ι ≫ aY) t :=
    IsPullback.paste_vert (isPullback_morphismRestrict g1 N₀) H4
  have s9 : IsPullback (g1 ∣_ N₀) rab rab₀ pr' := by
    refine IsPullback.of_bot ?_ hb.symm H5
    rw [hd, s7]
    exact s8
  have s10 := IsPullback.paste_vert s9.flip H1
  rw [H5.toCommSq.w] at s10
  exact ⟨rab, bB, s10, hb, rfl, hd⟩

theorem wc_mvpoly_spec_smooth_reldim : ∀ (K : Type u) [Field K] (c : ℕ), SmoothOfRelativeDimension c (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin c) K)))) :=
by
  intro K _ c
  rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension c), CommRingCat.hom_ofHom]
  apply RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso
  rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
  have h := Algebra.IsStandardSmoothOfRelativeDimension.mvPolynomial K (Fin c)
  rwa [Nat.card_fin] at h

theorem wc_et_punct_top_cover_mv_gen : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : K) ≠ 0 → ∀ (c' : ℕ), 1 ≤ c' → ∀ (W₀ : (Spec (.of (MvPolynomial (Fin c') K))).Opens), (W₀ : Set (Spec (.of (MvPolynomial (Fin c') K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin c') K →+* K))))ᶜ → ∀ (ω' : wcEtZModExt (W₀ : Scheme.{u}) ℓ (2 * c' - 1)), wcEtPunctTopCore K ℓ c' W₀ (2 * c' - 1) ω' → ∀ (U₀ : (Spec (.of (MvPolynomial (Fin (c' + 1)) K))).Opens), (U₀ : Set (Spec (.of (MvPolynomial (Fin (c' + 1)) K)))) = (Set.range (Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K))))ᶜ → ∃ ε₀ : wcEtZModExt ((wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀ : (U₀ : Scheme.{u}).Opens) : Scheme.{u}) ℓ (2 * c'), ∀ (S : Scheme.{u}) (fS : S ⟶ Spec (.of K)) (m : ℕ) [SmoothOfRelativeDimension m fS] (P : Scheme.{u}) (p : P ⟶ S) (q : P ⟶ Spec (.of (MvPolynomial (Fin (c' + 1)) K))) (z0 : S ⟶ P), IsPullback p q fS (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c' + 1)) K)))) → z0 ≫ p = 𝟙 S → z0 ≫ q = fS ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff : MvPolynomial (Fin (c' + 1)) K →+* K)) → ∀ (U : P.Opens), (U : Set P) = (Set.range z0)ᶜ → ∀ (pr : (U : Scheme.{u}) ⟶ (U₀ : Scheme.{u})), pr ≫ U₀.ι = U.ι ≫ q → wcEtMVGenTop (U.ι ≫ p) pr ℓ (wcEtPtCovA0 U₀) (wcEtPtCovB0 U₀) (2 * c') ε₀ :=
by
  classical
  intro K _ _ ℓ _ hℓ c' hc' W₀ hW₀ ω' hω' U₀ hU₀
  obtain ⟨c'', rfl⟩ : ∃ c'', c' = c'' + 1 := ⟨c' - 1, by omega⟩

  have hdeg1 : 2 * (c'' + 1) - 1 = 2 * c'' + 1 := by omega
  have hdeg2 : 2 * (c'' + 1) = 2 * c'' + 1 + 1 := by omega
  revert ω'
  rw [hdeg1, hdeg2]
  intro ω' hω'

  have hmul : ∀ {S S' : Scheme.{u}} {g : S' ⟶ S} {n : ℕ} (D : wcEtPullData g n) (a b c : ℕ)
      (hc : a + b = c) (x : wcEtZModExt S n a) (y : wcEtZModExt S n b),
      wcEtPull D c (wcEtZModCup S n a b c hc x y) =
        wcEtZModCup S' n a b c hc (wcEtPull D a x) (wcEtPull D b y) := by
    intro S S' g n D a b c hc x y
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hc)).comp (Abelian.Ext.mk₀ D.μ.hom)
          (add_zero c)) (zero_add c) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        (zero_add a)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) hc
    rw [Abelian.Ext.mapExactFunctor_comp]
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (zero_add b)) (zero_add b) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b) := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.hom) (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
        (add_zero 0) (zero_add b) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    symm
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a))
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (zero_add a) hc (by omega),
      Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x) (Abelian.Ext.mk₀ D.μ.hom)
        ((Abelian.Ext.mk₀ D.μ.inv).comp
          ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b))
          (zero_add b)) (add_zero a) (zero_add b) (by omega),
      e1,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor D.Φ x)
        (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) hc (add_zero b)
        (by omega)]

  have hind : ∀ {S S' : Scheme.{u}} (f f' : S' ⟶ S), f = f' → ∀ (D : wcEtPullData f ℓ)
      (D' : wcEtPullData f' ℓ) (i : ℕ) (x : wcEtZModExt S ℓ i),
      wcEtPull D' i x = wcEtPull D i x := by
    intro S S' f f' hff D D' i x
    obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 S') ℓ
    rw [wc_et_pull_comp f (𝟙 S') f' (by rw [Category.id_comp, hff]) D Did D',
      ← wc_et_pull_comp f (𝟙 S') f (Category.id_comp f) D Did D]

  obtain ⟨κ, hκ⟩ := wc_et_gm_kunneth_surj K ℓ hℓ
  obtain ⟨rab₀, tab₀, rb₀, hN, hrab₀, hrb₀⟩ := wc_et_ptcov_kchart K (c'' + 1) W₀ hW₀ U₀ hU₀
  obtain ⟨Dr₀⟩ := wc_et_zmod_pull_data_exists rab₀ ℓ
  obtain ⟨Dt₀⟩ := wc_et_zmod_pull_data_exists tab₀ ℓ
  refine ⟨wcEtZModCup _ ℓ (2 * c'' + 1) 1 (2 * c'' + 1 + 1) rfl
    (wcEtPull Dr₀ (2 * c'' + 1) ω') (wcEtPull Dt₀ 1 κ), ?_⟩
  intro S fS m _ P p q z0 hP hz0p hz0q U hU pr hpr
  intro S1 s1 hs1 Y1 h1 w1 hY1 γ x
  haveI := hs1
  have hU' := wc_et_bd_punct_isPullback K S fS (c'' + 1 + 1) P p q z0 hP hz0p hz0q U hU U₀ hU₀
    pr hpr
  have hY := IsPullback.paste_horiz hY1 hU'
  obtain ⟨P', p', q', z0', U', pr', hP'0, hz0p', hz0q', hU'c, hpr'⟩ :=
    wc_et_bd_level_exists K (c'' + 1) W₀ hW₀ S1 (s1 ≫ fS)
  have hP' := wc_et_bd_punct_isPullback K S1 (s1 ≫ fS) (c'' + 1) P' p' q' z0' hP'0 hz0p' hz0q'
    U' hU'c W₀ hW₀ pr' hpr'
  obtain ⟨rab, bB, hsq, hrabpr, hbB, hrabp⟩ := wc_et_open_chart_base_change
    (U₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c'' + 1 + 1)) K))))
    (W₀.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin (c'' + 1)) K))))
    (Spec.map (CommRingCat.ofHom (algebraMap K (LaurentPolynomial K))))
    (wcEtPtCovA0 U₀ ⊓ wcEtPtCovB0 U₀) (wcEtPtCovB0 U₀) inf_le_right rab₀ tab₀ rb₀ hN hrab₀ hrb₀
    (s1 ≫ fS) h1 (w1 ≫ pr) hY (U'.ι ≫ p') pr' hP'
