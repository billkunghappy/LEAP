      ((P.comap Polynomial.C).primeCompl.map Polynomial.C) (Localization.AtPrime 𝔓) 𝔓
    have e : (𝔓.comap (algebraMap (Polynomial R)
        (Polynomial (Localization.AtPrime (P.comap Polynomial.C))))).primeCompl = P.primeCompl := by
