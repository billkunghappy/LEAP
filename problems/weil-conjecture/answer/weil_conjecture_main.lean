  intro k _ _ S Y _ _ sS g m τ W mD Dc N I O a hτ S'' _ ρ D'' H C _ π₅ A hM hπ c i₀ hi₀ num den
    hlink hRdom hRic hG0
  classical
  have H' := H
  obtain ⟨⟨hS, hY, hss, hmono, hτs, hW, hWsm, hWgc, hreg, hcomps, hWD, hO, hstr, hC1, hC2⟩,
