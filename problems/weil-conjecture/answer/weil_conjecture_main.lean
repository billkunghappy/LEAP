  have hg𝔫 : algebraMap (AdicCompletion (IsLocalRing.maximalIdeal Oy) Oy)
      (Algebra.adjoin (AdicCompletion (IsLocalRing.maximalIdeal Oy) Oy) {u, y'}) g ∈ 𝔫 :=
