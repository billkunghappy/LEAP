    intro G
    refine Polynomial.induction_on' G ?_ ?_
    · intro p₁ p₂ hp₁ hp₂
      obtain ⟨F₁, hF₁⟩ := hp₁
      obtain ⟨F₂, hF₂⟩ := hp₂
