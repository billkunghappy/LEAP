  set ζ : Fin 3 ⊕ ({o // o ∈ O} ⊕ Fin e) → MvPolynomial (Fin 3) (MvPowerSeries (Fin (n + 2)) K) :=
    Sum.elim (![MvPolynomial.C (MvPowerSeries.X (Fin.addNat l₀ 2)), MvPolynomial.X 0,
