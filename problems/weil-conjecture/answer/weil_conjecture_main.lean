    refine (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P) P d).mp ?_
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hdm
