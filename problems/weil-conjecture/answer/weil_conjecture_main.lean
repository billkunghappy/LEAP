      (C.presheaf.germ (A ⁻¹ᵁ wcSgD k N i₀) (genericPoint C) hA₀).hom
        ((A.app (wcSgD k N i₀)).hom (wcSgE k N i₀ k₀)) *
      (C.presheaf.germ (A ⁻¹ᵁ wcSgD k N k₀) (genericPoint C) hAk).hom
        ((A.app (wcSgD k N k₀)).hom (wcSgE k N k₀ j)) := by
