    by_cases hEq : Q = Ideal.map Polynomial.C (IsLocalRing.maximalIdeal A)
    · refine ⟨∅, by simp, ?_, fun h => absurd h (by simp)⟩
      rw [Finset.coe_empty, Ideal.span_empty, sup_bot_eq]
