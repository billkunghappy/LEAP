    simpa [morphismRestrict_base_coe] using this
  haveI : Nonempty (Limits.pullback.fst g ρ ⁻¹ᵁ O).toScheme := ⟨⟨y₀, hy₀O⟩⟩
  haveI : Nonempty (π₅ ⁻¹ᵁ (Limits.pullback.fst g ρ ⁻¹ᵁ O)).toScheme :=
