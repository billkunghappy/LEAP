    intro i
    rw [hWu0, star2, hwt]

  have G5 : Tr z = gc U0 * ∏ l, gc (T0 l) ^ ℓ l := by
    have hB : β.hom ((vt : Γ(Y₂, V)) * (g (MvPolynomial.X 0) - g (MvPolynomial.C a))) =
        β.hom κ₀ * (Ideal.Quotient.mk (wcpaDjGslcIdeal g a τ)) Polynomial.X * ∏ l, β.hom (ρT l) ^ ℓ l := by
      rw [map_mul, ← hrel]
