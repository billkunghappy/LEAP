  have hζJ : ∀ i, ζ i ∈ Ideal.span (Set.range g) ⊔ Ideal.span (Set.range ζ) := fun i =>
    Ideal.mem_sup_right (Ideal.subset_span ⟨i, rfl⟩)
  have hgJ : ∀ i, g i ∈ Ideal.span (Set.range g) ⊔ Ideal.span (Set.range ζ) := fun i =>
