      IsLocalRing.maximalIdeal B := by
    show ∑ j, (Nl.map φ).adjugate a j * ((Nl.map φ).mulVec y) j ∈ IsLocalRing.maximalIdeal B
    exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (hw j))
