    exact (hK _).mpr ⟨⟨_, Algebra.subset_adjoin ⟨l, rfl⟩⟩, hgen l hl _ hspec, hspec⟩
  have hKs : ∀ a ∈ IsLocalRing.maximalIdeal A,
      Ideal.Quotient.mk (Ideal.span {x * y - v * s ^ w}) (a * s) ∈ K := by
