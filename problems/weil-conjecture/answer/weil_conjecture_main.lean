    obtain ⟨Q₀, hQ₀, e₀, -, hc, hX⟩ := wcpa_dj_scr_fibre_loc A E r f a φ zE
      (IsLocalRing.maximalIdeal A) hspanle le_rfl hloc hz1 hrel hfrac hker
    refine ⟨Q₀, hQ₀, e₀.toRingHom.comp (Ideal.Quotient.mk _),
