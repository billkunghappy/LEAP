        rw [← Spec.map_comp, hβ]; rfl
      rw [e1, Category.assoc, ← Category.assoc (Spec.map (CommRingCat.ofHom (algebraMap (Polynomial Γ(Y₂, V) ⧸ wcpaDjGslcIdeal g a τ) L)))
