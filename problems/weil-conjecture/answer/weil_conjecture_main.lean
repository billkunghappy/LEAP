          have h4 : (τ' l ≫ π₅) (Limits.pullback.snd g ρ (π₅ c)) =
              wcpaDjStcLift g ρ τ hτ l (Limits.pullback.snd g ρ (π₅ c)) := by rw [hτ' l]
          rw [Scheme.Hom.comp_apply] at h4
