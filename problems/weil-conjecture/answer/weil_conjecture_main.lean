    simp only [map_mul, map_prod, map_pow, hT0]

  have hP : ∀ G : Polynomial Γ(Y₂, V), ∃ F : Polynomial (Y₂.presheaf.stalk ((Spec.map β ≫ hV.fromSpec) c')),
