          Fin.insertNth (α := fun _ => MvPolynomial (Fin r) (O ⧸ IsLocalRing.maximalIdeal O))
            a 1 MvPolynomial.X l)) A''
    (fun j hj => (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q') Q' _).mpr
      (hwQ j hj)) hnuF
  choose q wF hcard hwF𝔪 hspanF using hce
  obtain ⟨u, hu⟩ := wcpa_dj_sfp_lift_gens B (Localization.AtPrime Q')
    ((IsLocalRing.maximalIdeal O).map φ) e' (r + 1) (fun j => ∑ l, φ (Nl j l) * y l) _ A'' q wF
    hK𝔪 hevj (fun j hj => (hA''iff j).mp hj) hwF𝔪 hspanF

  have hdF : ringKrullDim (Localization.AtPrime Q') = ((A''.card + q : ℕ) : WithBot ℕ∞) := by
    rw [← @IsRegularLocalRing.spanFinrank_maximalIdeal _ _ hFreg, ← hcard]
  have hdB𝔪 : ringKrullDim (B ⧸ (IsLocalRing.maximalIdeal O).map φ) =
      ringKrullDim (Localization.AtPrime Q') := ringKrullDim_eq_of_ringEquiv e'
  refine ⟨j₀, A'', q, u, fun h => hj₀ ((hA''iff j₀).mp h), hA''iff, ?_, hu⟩
  rw [hDim, hdB𝔪, hdF, ← Nat.cast_add]
  congr 1
  omega

theorem wcpa_dj_scr_completion_coords : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (n r : ℕ) (s : Fin n → AdicCompletion (IsLocalRing.maximalIdeal O) O) (A₀ : Finset (Fin n)) (hA : A₀.card = r + 1) (x : Fin (r + 1) → O) (a : Fin (r + 1)) (φ : O →+* B) (y : Fin (r + 1) → B) (Nh : Matrix (Fin (r + 1)) (Fin (r + 1)) (AdicCompletion (IsLocalRing.maximalIdeal O) O)) (Nl : Matrix (Fin (r + 1)) (Fin (r + 1)) O) (j₀ : Fin (r + 1)) (A'' : Finset (Fin (r + 1))) (q : ℕ) (u : Fin q → B), IsRegularLocalRing O → (n : WithBot ℕ∞) = ringKrullDim O → Ideal.span (Set.range s) = (IsLocalRing.maximalIdeal O).map (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) → (∀ l, x l ∈ IsLocalRing.maximalIdeal O) → (∀ j, s (A₀.orderEmbOfFin hA j) = ∑ l, Nh j l * algebraMap O _ (x l)) → (∀ j l, Nh j l - algebraMap O _ (Nl j l) ∈ IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal O) O)) → (∀ c : O, φ c ∈ IsLocalRing.maximalIdeal B ↔ c ∈ IsLocalRing.maximalIdeal O) → φ (x a) ∈ nonZeroDivisors B → (∀ l, φ (x l) = φ (x a) * y l) → j₀ ∉ A'' → (∀ j, j ∈ A'' ↔ ∑ l, φ (Nl j l) * y l ∈ IsLocalRing.maximalIdeal B) → ringKrullDim B = ((1 + (n - (r + 1)) + A''.card + q : ℕ) : WithBot ℕ∞) → IsLocalRing.maximalIdeal B = Ideal.map φ (IsLocalRing.maximalIdeal O) ⊔ Ideal.span ((fun j => ∑ l, φ (Nl j l) * y l) '' (A'' : Set (Fin (r + 1)))) ⊔ Ideal.span (Set.range u) → ∃ (φh : AdicCompletion (IsLocalRing.maximalIdeal O) O →+* AdicCompletion (IsLocalRing.maximalIdeal B) B) (n' : ℕ) (s' : Fin n' → AdicCompletion (IsLocalRing.maximalIdeal B) B) (τ : Fin n → Fin n') (e : Fin n') (A' : Finset (Fin n')), (∀ c : O, φh (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) c) = algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ c)) ∧ (n' : WithBot ℕ∞) = ringKrullDim B ∧ Ideal.span (Set.range s') = (IsLocalRing.maximalIdeal B).map (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)) ∧ (∀ j, j ∉ A₀ → s' (τ j) = φh (s j)) ∧ Set.InjOn τ (↑A₀)ᶜ ∧ e ∉ τ '' (↑A₀)ᶜ ∧ e ∉ A' ∧ Disjoint (A' : Set (Fin n')) (τ '' (↑A₀)ᶜ) ∧ A'.card ≤ r ∧ Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ (x a))) (s' e) ∧ ∀ h : B, Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ (x a) ^ (r + 1) * h)) (φh (∏ j ∈ A₀, s j)) → Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) h) (∏ k ∈ A', s' k) :=
by
  intro O _ _ _ B _ _ _ n r s A₀ hA x a φ y Nh Nl j₀ A'' q u _ _ hs hx hNh hNhl hloc hnzd hy hj₀
    hA'' hdim hmax
  classical

  have L2 : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P],
      IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P) =
        (IsLocalRing.maximalIdeal P).map
          (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) := by
    intro P _ _ _
    have hsup : (IsLocalRing.maximalIdeal P).map
        (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) ≤
        IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P) := by
      rw [Ideal.map_le_iff_le_comap]
      intro p hp
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have h1 := hu.map (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal P) 1)
      have hp1 : p ∈ IsLocalRing.maximalIdeal P ^ 1 := by rw [pow_one]; exact hp
      rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.mpr hp1,
        isUnit_zero_iff, Ideal.Quotient.zero_eq_one_iff, pow_one] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal P).ne_top h1
    refine le_antisymm ?_ hsup
    intro c hc
    obtain ⟨p, hp⟩ : ∃ p : P, c - algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p ∈
        Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
          (IsLocalRing.maximalIdeal P ^ 1) := by
      have hfg : (IsLocalRing.maximalIdeal P).FG := IsNoetherian.noetherian _
      have hmem1 : ∀ b : AdicCompletion (IsLocalRing.maximalIdeal P) P,
          AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1 b = 0 →
          b ∈ Ideal.map (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P))
            (IsLocalRing.maximalIdeal P ^ 1) := by
        intro b hb
        have h1 := AdicCompletion.pow_smul_top_eq_ker_eval (M := P) (n := 1) hfg
        have h2 := Ideal.smul_top_eq_map (S := AdicCompletion (IsLocalRing.maximalIdeal P) P)
          (IsLocalRing.maximalIdeal P ^ 1)
        have h3 := SetLike.ext_iff.mp (h2.symm.trans h1) b
        rw [Submodule.restrictScalars_mem, LinearMap.mem_ker] at h3
        exact h3.mpr hb
      have hof : ∀ p : P, AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1
          (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p) =
          Submodule.Quotient.mk p := by
        intro p
        change AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1
          (AdicCompletion.of (IsLocalRing.maximalIdeal P) P p) = _
        rw [AdicCompletion.eval_of]
        rfl
      obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _
        (AdicCompletion.eval (IsLocalRing.maximalIdeal P) P 1 c)
      refine ⟨p, hmem1 _ ?_⟩
      rw [map_sub, hof, hp, sub_self]
    rw [pow_one] at hp
    have hpm : p ∈ IsLocalRing.maximalIdeal P := by
      by_contra hpn
      have hu : IsUnit p := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hpn; exact hpn
      have hmem : algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p ∈
          IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P) := by
        have h2 := sub_mem hc (hsup hp)
        rwa [sub_sub_cancel] at h2
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hmem
      exact hmem (hu.map _)
    have h3 := add_mem hp
      (Ideal.mem_map_of_mem (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) hpm)
    rwa [sub_add_cancel] at h3

  have hφm : (IsLocalRing.maximalIdeal O).map φ ≤ IsLocalRing.maximalIdeal B := by
    rw [Ideal.map_le_iff_le_comap]
    intro c hc
    exact (hloc c).mpr hc
  obtain ⟨φh, hφh⟩ : ∃ φh : AdicCompletion (IsLocalRing.maximalIdeal O) O →+*
      AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ c : O,
      φh (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) c) =
        algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ c) := by
    have hk : ∀ k : ℕ, IsLocalRing.maximalIdeal O ^ k ≤
        (IsLocalRing.maximalIdeal B ^ k).comap φ := fun k => by
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
      exact Ideal.pow_right_mono hφm k
    let f : (k : ℕ) → AdicCompletion (IsLocalRing.maximalIdeal O) O →+*
        B ⧸ IsLocalRing.maximalIdeal B ^ k := fun k =>
      (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ k) φ (hk k)).comp
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) k).toRingHom
    have hf : ∀ {m k : ℕ} (hle : m ≤ k),
        (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f k) = f m := by
      intro m k hle
      refine RingHom.ext fun z => ?_
      obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective (IsLocalRing.maximalIdeal O) O z
      show Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle
          (Ideal.quotientMap _ φ (hk k) (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) k
            (AdicCompletion.mk _ _ c))) =
        Ideal.quotientMap _ φ (hk m) (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) m
          (AdicCompletion.mk _ _ c))
      rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk,
        ← AdicCompletion.Ideal.mk_eq_mk _ hle c, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      rfl
    refine ⟨AdicCompletion.liftRingHom (IsLocalRing.maximalIdeal B) f hf, fun c => ?_⟩
    apply AdicCompletion.ext_evalₐ
    intro k
    rw [AdicCompletion.evalₐ_liftRingHom]
    show Ideal.quotientMap _ φ (hk k) (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) k
      (algebraMap O _ c)) = _
    rw [AlgHom.commutes, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.algebraMap_eq, Ideal.quotientMap_mk]

  obtain ⟨ζ, hζ⟩ : ∃ ζ : AdicCompletion (IsLocalRing.maximalIdeal B) B,
      ζ = algebraMap B _ (φ (x a)) := ⟨_, rfl⟩
  obtain ⟨t, ht⟩ : ∃ t : Fin n → AdicCompletion (IsLocalRing.maximalIdeal B) B,
      ∀ j, t j = φh (s j) := ⟨_, fun _ => rfl⟩
  obtain ⟨V, hV⟩ : ∃ V : Fin (r + 1) → AdicCompletion (IsLocalRing.maximalIdeal B) B,
      ∀ k, V k = ∑ l, φh (Nh k l) * algebraMap B _ (y l) := ⟨_, fun _ => rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : Fin (r + 1) → AdicCompletion (IsLocalRing.maximalIdeal B) B,
      ∀ k, W k = algebraMap B _ (∑ l, φ (Nl k l) * y l) := ⟨_, fun _ => rfl⟩

  have hφhι : φh.comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) =
      (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)).comp φ := RingHom.ext hφh
  have hrt : Set.range t = φh '' Set.range s := by
    ext z; constructor
    · rintro ⟨j, rfl⟩; exact ⟨s j, ⟨j, rfl⟩, (ht j).symm⟩
    · rintro ⟨_, ⟨j, rfl⟩, rfl⟩; exact ⟨j, ht j⟩
  have hK1 : Ideal.span (Set.range t) = Ideal.map φh
      (Ideal.map (algebraMap O _) (IsLocalRing.maximalIdeal O)) := by
    rw [hrt, ← Ideal.map_span, hs]
  have hK : Ideal.span (Set.range t) = Ideal.map
      (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B))
      (Ideal.map φ (IsLocalRing.maximalIdeal O)) := by
    rw [hK1, Ideal.map_map, hφhι, ← Ideal.map_map]
  have hKO : ∀ d ∈ IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal O) O),
      φh d ∈ Ideal.span (Set.range t) := by
    intro d hd
    rw [L2 O] at hd
    rw [hK1]
    exact Ideal.mem_map_of_mem _ hd
  have hKm : Ideal.span (Set.range t) ≤
      IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal B) B) := by
    rw [hK, L2 B]
    exact Ideal.map_mono hφm
  have hζK : ζ ∈ Ideal.span (Set.range t) := by
    rw [hK, hζ]
    exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ (hx a))
  have htV : ∀ k, t (A₀.orderEmbOfFin hA k) = ζ * V k := by
    intro k
    rw [ht, hNh k, map_sum, hV, Finset.mul_sum]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [map_mul, hφh, hy l, map_mul, hζ]; ring
  have hVW : ∀ k, V k - W k ∈ Ideal.span (Set.range t) := by
    intro k
    have hdiff : V k - W k = ∑ l, φh (Nh k l - algebraMap O _ (Nl k l)) *
        algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (y l) := by
      rw [hV, hW, map_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [map_sub, hφh, map_mul, sub_mul]
    rw [hdiff]
    exact Ideal.sum_mem _ fun l _ => Ideal.mul_mem_right _ _ (hKO _ (hNhl k l))
  have hVunit : ∀ k, k ∉ A'' → IsUnit (V k) := by
    intro k hk
    have hv : IsUnit (∑ l, φ (Nl k l) * y l) := by
      have h0 := (hA'' k).not.mp hk
      rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at h0
    have hWu : IsUnit (W k) := by rw [hW]; exact hv.map _
    by_contra hVn
    have hVm : V k ∈ IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal B) B) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hVn
    have hWm : W k ∈ IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal B) B) := by
      have h0 := sub_mem hVm (hKm (hVW k))
      rwa [sub_sub_cancel] at h0
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hWm
    exact hWm hWu
  have hcancel : ∀ z₁ z₂ : AdicCompletion (IsLocalRing.maximalIdeal B) B,
      ζ ^ (r + 1) * z₁ = ζ ^ (r + 1) * z₂ → z₁ = z₂ := by
    intro z₁ z₂ hz
    have h1 : IsSMulRegular (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ (x a)) :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors hnzd
    have hreg' := h1.pow (r + 1)
    have h2 : (φ (x a) ^ (r + 1)) • z₁ = (φ (x a) ^ (r + 1)) • z₂ := by
      rw [Algebra.smul_def, Algebra.smul_def, map_pow, ← hζ]; exact hz
    exact hreg' h2

  obtain ⟨c, hc⟩ : ∃ c, A₀ᶜ.card = c := ⟨_, rfl⟩
  have hcn : c = n - (r + 1) := by rw [← hc, Finset.card_compl, Fintype.card_fin, hA]
  obtain ⟨s', hs'⟩ : ∃ s' : Fin (1 + c + A''.card + q) →
      AdicCompletion (IsLocalRing.maximalIdeal B) B,
      s' = Fin.append (Fin.append (Fin.append (fun _ : Fin 1 => ζ)
        (fun i : Fin c => t ((A₀ᶜ.orderIsoOfFin hc i : Fin n))))
        (fun i : Fin A''.card => V ((A''.orderIsoOfFin rfl i : Fin (r + 1)))))
        (fun i : Fin q => algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (u i)) :=
    ⟨_, rfl⟩
  let e : Fin (1 + c + A''.card + q) :=
    Fin.castAdd q (Fin.castAdd A''.card (Fin.castAdd c (0 : Fin 1)))
  let it : Fin c → Fin (1 + c + A''.card + q) := fun i =>
    Fin.castAdd q (Fin.castAdd A''.card (Fin.natAdd 1 i))
  let iV : Fin A''.card → Fin (1 + c + A''.card + q) := fun i =>
    Fin.castAdd q (Fin.natAdd (1 + c) i)
  let iw : Fin q → Fin (1 + c + A''.card + q) := fun i => Fin.natAdd (1 + c + A''.card) i
  have hve : (e : ℕ) = 0 := by simp [e]
  have hvit : ∀ i, (it i : ℕ) = 1 + i := by intro i; simp [it]
  have hviV : ∀ i, (iV i : ℕ) = 1 + c + i := by intro i; simp [iV]
  have hs'e : s' e = ζ := by rw [hs']; simp [e]
  have hs'it : ∀ i, s' (it i) = t ((A₀ᶜ.orderIsoOfFin hc i : Fin n)) := by
    intro i; rw [hs']; simp [it]
  have hs'iV : ∀ i, s' (iV i) = V ((A''.orderIsoOfFin rfl i : Fin (r + 1))) := by
    intro i; rw [hs']; simp [iV]
  have hs'iw : ∀ i, s' (iw i) =
      algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (u i) := by
    intro i; rw [hs']; simp [iw]
  let τ : Fin n → Fin (1 + c + A''.card + q) := fun j =>
    if hj : j ∈ A₀ then e else it ((A₀ᶜ.orderIsoOfFin hc).symm ⟨j, Finset.mem_compl.mpr hj⟩)
  have hτ : ∀ j (hj : j ∉ A₀),
      τ j = it ((A₀ᶜ.orderIsoOfFin hc).symm ⟨j, Finset.mem_compl.mpr hj⟩) := by
    intro j hj; simp only [τ, dif_neg hj]
  have hs'τ : ∀ j, j ∉ A₀ → s' (τ j) = t j := by
    intro j hj
    rw [hτ j hj, hs'it, OrderIso.apply_symm_apply]
  have hτlt : ∀ j, j ∉ A₀ → 1 ≤ (τ j : ℕ) ∧ (τ j : ℕ) < 1 + c := by
    intro j hj
    rw [hτ j hj, hvit]
    have := ((A₀ᶜ.orderIsoOfFin hc).symm ⟨j, Finset.mem_compl.mpr hj⟩).isLt
    exact ⟨by omega, by omega⟩
  let A' : Finset (Fin (1 + c + A''.card + q)) := Finset.univ.image iV
  have hiVinj : Function.Injective iV := by
    intro i₁ i₂ h
    have h0 := congrArg Fin.val h
    rw [hviV, hviV] at h0
    exact Fin.ext (by omega)
  have hA'mem : ∀ z ∈ A', 1 + c ≤ (z : ℕ) := by
    intro z hz
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hz
    rw [hviV]; omega
  refine ⟨φh, 1 + c + A''.card + q, s', τ, e, A', hφh, ?_, ?_,
    fun j hj => (hs'τ j hj).trans (ht j), ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hdim, hcn]
  ·
    have hmapB := congrArg
      (Ideal.map (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B))) hmax
    rw [hmapB, Ideal.map_sup, Ideal.map_sup, Ideal.map_span, Ideal.map_span, ← hK]
    have hζL : ζ ∈ Ideal.span (Set.range s') := by
      rw [← hs'e]; exact Ideal.subset_span ⟨e, rfl⟩
    have htL : Ideal.span (Set.range t) ≤ Ideal.span (Set.range s') := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      by_cases hj : j ∈ A₀
      · have hjr : j ∈ Set.range (A₀.orderEmbOfFin hA) := by
          rw [Finset.range_orderEmbOfFin]; exact hj
        obtain ⟨k, rfl⟩ := hjr
        rw [htV]
        exact Ideal.mul_mem_right _ _ hζL
      · rw [← hs'τ j hj]
        exact Ideal.subset_span ⟨τ j, rfl⟩
    have hVL : ∀ k ∈ A'', V k ∈ Ideal.span (Set.range s') := by
      intro k hk
      have hk' : V k = s' (iV ((A''.orderIsoOfFin rfl).symm ⟨k, hk⟩)) := by
        rw [hs'iV, OrderIso.apply_symm_apply]
      rw [hk']; exact Ideal.subset_span ⟨_, rfl⟩
    have hVR : ∀ k ∈ A'', V k ∈ Ideal.span (Set.range t) ⊔
        Ideal.span (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) ''
          ((fun j => ∑ l, φ (Nl j l) * y l) '' (A'' : Set (Fin (r + 1))))) ⊔
        Ideal.span (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) ''
          Set.range u) := by
      intro k hk
      have hWmem : W k ∈ Ideal.span (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) ''
          ((fun j => ∑ l, φ (Nl j l) * y l) '' (A'' : Set (Fin (r + 1))))) := by
        rw [hW]
        exact Ideal.subset_span (Set.mem_image_of_mem _
          (Set.mem_image_of_mem _ (Finset.mem_coe.mpr hk)))
      have hsplit : V k = W k + (V k - W k) := by ring
      rw [hsplit]
      exact add_mem (Ideal.mem_sup_left (Ideal.mem_sup_right hWmem))
        (Ideal.mem_sup_left (Ideal.mem_sup_left (hVW k)))
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      rw [hs']
      induction i using Fin.addCases with
      | left i =>
        induction i using Fin.addCases with
        | left i =>
          induction i using Fin.addCases with
          | left i =>
            simp only [Fin.append_left]
            exact Ideal.mem_sup_left (Ideal.mem_sup_left hζK)
          | right i =>
            simp only [Fin.append_left, Fin.append_right]
            exact Ideal.mem_sup_left (Ideal.mem_sup_left (Ideal.subset_span ⟨_, rfl⟩))
        | right i =>
          simp only [Fin.append_left, Fin.append_right]
          exact hVR _ (A''.orderIsoOfFin rfl i).2
      | right i =>
        simp only [Fin.append_right]
        exact Ideal.mem_sup_right (Ideal.subset_span (Set.mem_image_of_mem _ ⟨i, rfl⟩))
    · refine sup_le (sup_le htL ?_) ?_
      · rw [Ideal.span_le]
        rintro _ ⟨_, ⟨k, hk, rfl⟩, rfl⟩
        have hk2 : algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)
            (∑ l, φ (Nl k l) * y l) = V k - (V k - W k) := by rw [hW]; ring
        rw [hk2]
        exact sub_mem (hVL k hk) (htL (hVW k))
      · rw [Ideal.span_le]
        rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
        rw [← hs'iw]
        exact Ideal.subset_span ⟨_, rfl⟩
  ·
    intro j₁ hj₁ j₂ hj₂ h
    have hj₁' : j₁ ∉ A₀ := hj₁
    have hj₂' : j₂ ∉ A₀ := hj₂
    rw [hτ j₁ hj₁', hτ j₂ hj₂'] at h
    have h1 := congrArg Fin.val h
    rw [hvit, hvit] at h1
    have h2 : (A₀ᶜ.orderIsoOfFin hc).symm ⟨j₁, Finset.mem_compl.mpr hj₁'⟩ =
        (A₀ᶜ.orderIsoOfFin hc).symm ⟨j₂, Finset.mem_compl.mpr hj₂'⟩ := Fin.ext (by omega)
    exact congrArg Subtype.val ((A₀ᶜ.orderIsoOfFin hc).symm.injective h2)
  · rintro ⟨j, hj, hje⟩
    have h1 := (hτlt j hj).1
    rw [hje, hve] at h1; omega
  · intro he
    have h1 := hA'mem e he
    rw [hve] at h1; omega
  · rw [Set.disjoint_left]
    rintro z hz ⟨j, hj, rfl⟩
    have h1 := hA'mem _ (Finset.mem_coe.mp hz)
    have h2 := (hτlt j hj).2
    omega
  · have hsub : A'' ⊆ Finset.univ.erase j₀ := fun k hk =>
      Finset.mem_erase.mpr ⟨fun h => hj₀ (h ▸ hk), Finset.mem_univ _⟩
    have h1 := Finset.card_le_card hsub
    rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Fintype.card_fin] at h1
    have h2 : A'.card ≤ A''.card := by
      refine Finset.card_image_le.trans ?_
      rw [Finset.card_univ, Fintype.card_fin]
    omega
  · rw [hs'e, hζ]
  · intro h hh
    rw [map_mul, map_pow, ← hζ, map_prod] at hh
    have hprodA : ∏ j ∈ A₀, φh (s j) = ζ ^ (r + 1) * ∏ k, V k := by
      have e1 : ∏ j ∈ A₀, φh (s j) = ∏ k, t (A₀.orderEmbOfFin hA k) := by
        rw [← Finset.prod_coe_sort A₀]
        refine (Equiv.prod_comp (A₀.orderIsoOfFin hA).toEquiv
          (fun j : A₀ => φh (s j))).symm.trans ?_
        refine Finset.prod_congr rfl fun k _ => ?_
        rw [ht]
        simp [Finset.coe_orderIsoOfFin_apply]
      rw [e1]
      simp only [htV]
      rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    rw [hprodA, ← Finset.prod_mul_prod_compl A'' V] at hh
    have hU : IsUnit (∏ k ∈ A''ᶜ, V k) :=
      Finset.prod_induction V IsUnit (fun _ _ h1 h2 => h1.mul h2) isUnit_one
        (fun k hk => hVunit k (Finset.mem_compl.mp hk))
    obtain ⟨w, hw⟩ := hh
    have h1 : algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) h * ↑w =
        (∏ k ∈ A'', V k) * ∏ k ∈ A''ᶜ, V k := hcancel _ _ (by rw [← hw]; ring)
    have hassoc : Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) h)
        ((∏ k ∈ A'', V k) * ∏ k ∈ A''ᶜ, V k) := ⟨w, h1⟩
    have hprodA' : ∏ k ∈ A', s' k = ∏ k ∈ A'', V k := by
      rw [Finset.prod_image (fun i₁ _ i₂ _ h => hiVinj h)]
      simp only [hs'iV]
      rw [← Finset.prod_coe_sort A'' V]
      exact Equiv.prod_comp (A''.orderIsoOfFin rfl).toEquiv (fun k : A'' => V k)
    rw [hprodA']
    exact hassoc.trans (associated_mul_unit_left _ _ hU)

theorem wcpa_dj_sfb_chart_regular : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] (𝔭 : Ideal A) [𝔭.IsPrime] (O : Type u) [CommRing O] [IsLocalRing O] [Algebra A O] [IsLocalization.AtPrime O 𝔭] (n r : ℕ) (s : Fin n → AdicCompletion (IsLocalRing.maximalIdeal O) O) (A₀ : Finset (Fin n)) (f : Fin (r + 1) → A), IsRegularLocalRing O → (n : WithBot ℕ∞) = ringKrullDim O → Ideal.span (Set.range s) = (IsLocalRing.maximalIdeal O).map (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) → A₀.card = r + 1 → Ideal.span (Set.range fun l => algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) (algebraMap A O (f l))) = Ideal.span (s '' (A₀ : Set (Fin n))) → (∀ l, f l ≠ 0) ∧ ∀ (a : Fin (r + 1)) (𝔮 : Ideal (wcpaDjChart A f a)) [𝔮.IsPrime] (B : Type u) [CommRing B] [IsLocalRing B] [Algebra (wcpaDjChart A f a) B] [IsLocalization.AtPrime B 𝔮] (φ : O →+* B), 𝔮.comap (algebraMap A (wcpaDjChart A f a)) = 𝔭 → (∀ c : A, φ (algebraMap A O c) = algebraMap (wcpaDjChart A f a) B (algebraMap A (wcpaDjChart A f a) c)) → IsRegularLocalRing B ∧ ∃ (φh : AdicCompletion (IsLocalRing.maximalIdeal O) O →+* AdicCompletion (IsLocalRing.maximalIdeal B) B) (n' : ℕ) (s' : Fin n' → AdicCompletion (IsLocalRing.maximalIdeal B) B) (τ : Fin n → Fin n') (e : Fin n') (A' : Finset (Fin n')), (∀ c : O, φh (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) c) = algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (φ c)) ∧ (n' : WithBot ℕ∞) = ringKrullDim B ∧ Ideal.span (Set.range s') = (IsLocalRing.maximalIdeal B).map (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)) ∧ (∀ j, j ∉ A₀ → s' (τ j) = φh (s j)) ∧ Set.InjOn τ (↑A₀)ᶜ ∧ e ∉ τ '' (↑A₀)ᶜ ∧ e ∉ A' ∧ Disjoint (A' : Set (Fin n')) (τ '' (↑A₀)ᶜ) ∧ A'.card ≤ r ∧ Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (algebraMap (wcpaDjChart A f a) B (algebraMap A (wcpaDjChart A f a) (f a)))) (s' e) ∧ ∀ h : B, Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (algebraMap (wcpaDjChart A f a) B (algebraMap A (wcpaDjChart A f a) (f a)) ^ (r + 1) * h)) (φh (∏ j ∈ A₀, s j)) → Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) h) (∏ k ∈ A', s' k) :=
by
  intro A _ _ _ 𝔭 _ O _ _ _ _ n r s A₀ f hreg hn hs hA hspan
  haveI : IsNoetherianRing O := IsLocalization.isNoetherianRing 𝔭.primeCompl O inferInstance
  set x : Fin (r + 1) → O := fun l => algebraMap A O (f l) with hxdef
  obtain ⟨hx, hli⟩ := wcpa_dj_scr_params O n r s A₀ x hreg hn hs hA hspan
  have hx0 : ∀ l, x l ≠ 0 := by
    intro l h
    apply hli.ne_zero l
    have h' : (⟨x l, hx l⟩ : IsLocalRing.maximalIdeal O) = 0 := Subtype.ext h
    rw [h', map_zero]
  have hf0 : ∀ l, f l ≠ 0 := fun l h => hx0 l (by simp only [hxdef, h, map_zero])
  refine ⟨hf0, ?_⟩
  intro a 𝔮 _ B _ _ _ _ φ hcomap hφ
  obtain ⟨hBdom, hBnoeth, hφinj, hφloc, y, hya, hy, hfrac⟩ :=
    wcpa_dj_scr_chart_present A 𝔭 O r f a 𝔮 B φ (hf0 a) hcomap hφ
  haveI := hBdom
  haveI := hBnoeth
  haveI := hreg
  have hwr : RingTheory.Sequence.IsWeaklyRegular O (List.ofFn x) :=
    wcpa_dj_scr_weakly_regular O (r + 1) (fun l => ⟨x l, hx l⟩) hli
  have hqr := wcpa_dj_scr_quasi_regular O (r + 1) x hwr
  have hξ0 : φ (x a) ≠ 0 := fun h => hx0 a (hφinj (h.trans (map_zero φ).symm))
  have hnzd : ∀ b : B, φ (x a) * b = 0 → b = 0 := fun b hb =>
    (mul_eq_zero.mp hb).resolve_left hξ0
  have hker := wcpa_dj_scr_chart_kernel O B r x a φ y hφinj hnzd hya hy hqr
  have hBreg := wcpa_dj_scr_chart_B_regular O B r x a φ y hreg hx hli hφinj hφloc hya hy hfrac hker
  obtain ⟨Mh, Nh, Nl, -, hNh, hNhl, hNl⟩ :=
    wcpa_dj_scr_matrices O n r s A₀ x hA hreg hn hs hspan
  obtain ⟨j₀, A'', q, u, hj₀, hA'', hdim, hmax⟩ :=
    wcpa_dj_scr_fibre_params O B n r x a φ y Nl hreg hn hx hli hBreg
      (mem_nonZeroDivisors_of_ne_zero hξ0) hφloc hya hy hfrac hker hNl
  have hξeq : algebraMap (wcpaDjChart A f a) B (algebraMap A (wcpaDjChart A f a) (f a)) =
      φ (x a) := (hφ (f a)).symm
  rw [hξeq]
  exact ⟨hBreg, wcpa_dj_scr_completion_coords O B n r s A₀ hA x a φ y Nh Nl j₀ A'' q u hreg hn hs
    hx hNh hNhl hφloc (mem_nonZeroDivisors_of_ne_zero hξ0) hy hj₀ hA'' hdim hmax⟩

theorem wcpa_dj_sfb_exceptional_locus : ∀ {Y Y' : Scheme.{u}} (π : Y' ⟶ Y) (C : Set Y) (hC : IsClosed C) (U : Y.affineOpens) (r : ℕ) (f : Fin (r + 1) → Γ(Y, U)), Ideal.span (Set.range f) = (Scheme.IdealSheafData.vanishingIdeal ⟨C, hC⟩).ideal U → ∀ (V : Y'.Opens) (hVU : V ≤ π ⁻¹ᵁ (U : Y.Opens)) (a : Fin (r + 1)), (∀ l, ∃ c : Γ(Y', V), (π.appLE U V hVU).hom (f l) = (π.appLE U V hVU).hom (f a) * c) → ∀ (y : Y') (hy : y ∈ V), (π y ∈ C ↔ Y'.presheaf.germ V y hy ((π.appLE U V hVU).hom (f a)) ∈ IsLocalRing.maximalIdeal (Y'.presheaf.stalk y)) :=
by
  intro Y Y' π C hC U r f hspan V hVU a hdiv y hy
  have hp : π y ∈ (U : Y.Opens) := hVU hy
  have hcompat : ∀ s : Γ(Y, U), (π.stalkMap y).hom (Y.presheaf.germ U (π y) hp s) =
      Y'.presheaf.germ V y hy ((π.appLE U V hVU).hom s) := by
    intro s
    rw [Scheme.Hom.germ_stalkMap_apply]
    rw [← TopCat.Presheaf.germ_res_apply Y'.presheaf (homOfLE hVU) y hy]
    rfl
  have hloc : ∀ b, (π.stalkMap y).hom b ∈ IsLocalRing.maximalIdeal (Y'.presheaf.stalk y) ↔
      b ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (π y)) := by
    intro b
    simp only [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact (isUnit_map_iff (π.stalkMap y).hom b).not
  have hC1 : π y ∈ C ↔ ∀ l, Y.presheaf.germ U (π y) hp (f l) ∈
      IsLocalRing.maximalIdeal (Y.presheaf.stalk (π y)) := by
    have e1 : π y ∈ C ↔
        π y ∈ ((Scheme.IdealSheafData.vanishingIdeal ⟨C, hC⟩).support : Set Y) := by
      rw [Scheme.IdealSheafData.coe_support_vanishingIdeal]; rfl
    rw [e1, SetLike.mem_coe, Scheme.IdealSheafData.mem_support_iff_of_mem hp,
      Scheme.mem_zeroLocus_iff, ← hspan]
    constructor
    · intro h l
      have := h (f l) (Ideal.subset_span ⟨l, rfl⟩)
      rw [Scheme.mem_basicOpen _ _ _ hp] at this
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact this
    · intro h g hg
      rw [Scheme.mem_basicOpen _ _ _ hp]
      have hle : Ideal.span (Set.range f) ≤ Ideal.comap (Y.presheaf.germ U (π y) hp).hom
          (IsLocalRing.maximalIdeal (Y.presheaf.stalk (π y))) := by
        rw [Ideal.span_le]; rintro _ ⟨l, rfl⟩; exact h l
      have := hle hg
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at this
      exact this
  rw [hC1]
  constructor
  · intro h; rw [← hcompat, hloc]; exact h a
  · intro h l
    rw [← hloc, hcompat]
    obtain ⟨c, hc⟩ := hdiv l
    rw [hc, map_mul]
    exact Ideal.mul_mem_right _ _ h

theorem wcpa_dj_sfb_power_mem : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] (n R : ℕ) (s : Fin n → AdicCompletion (IsLocalRing.maximalIdeal O) O) (A₀ : Finset (Fin n)) (x : Fin R → O) (g : O), A₀.card = R → Ideal.span (Set.range fun r => algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) (x r)) = Ideal.span (s '' (A₀ : Set (Fin n))) → Associated (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) (g)) (∏ j ∈ A₀, s j) → g ∈ (Ideal.span (Set.range x)) ^ R :=
by
  intro O _ _ _ n R s A₀ x g hcard hspan hassoc
  have hprod : (∏ j ∈ A₀, s j) ∈ Ideal.span (s '' (A₀ : Set (Fin n))) ^ A₀.card := by
    rw [← Finset.prod_const]
    apply Ideal.prod_mem_prod
    intro j hj
    exact Ideal.subset_span (Set.mem_image_of_mem s (Finset.mem_coe.mpr hj))
  have hg1 : algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) g ∈
      Ideal.span (s '' (A₀ : Set (Fin n))) ^ A₀.card := by
    obtain ⟨u, hu⟩ := hassoc
    have : algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) g =
        (∏ j ∈ A₀, s j) * ↑u⁻¹ := by rw [← hu, Units.mul_inv_cancel_right]
    rw [this]; exact Ideal.mul_mem_right _ _ hprod
  have hmap : Ideal.map (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))
      (Ideal.span (Set.range x)) = Ideal.span (s '' (A₀ : Set (Fin n))) := by
    rw [← hspan, Ideal.map_span, ← Set.range_comp]; rfl
  have hg2 : algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) g ∈
      Ideal.map (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))
        ((Ideal.span (Set.range x)) ^ R) := by
    rw [Ideal.map_pow, hmap, ← hcard]; exact hg1
  generalize (Ideal.span (Set.range x)) ^ R = K at hg2 ⊢
  have hsup : ∀ k : ℕ, g ∈ K ⊔ IsLocalRing.maximalIdeal O ^ k := by
    intro k
    let e : AdicCompletion (IsLocalRing.maximalIdeal O) O →+* O ⧸ IsLocalRing.maximalIdeal O ^ k :=
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) k).toRingHom
    have h1 : e.comp (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O)) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ k) := by
      ext a
      simp only [RingHom.comp_apply, e]
      exact (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) k).commutes a
    have h2 := Ideal.mem_map_of_mem e hg2
    rw [Ideal.map_map, h1] at h2
    have h3 : e (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) g) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal O ^ k) g := by
      rw [← RingHom.comp_apply, h1]
    rw [h3, Ideal.mem_quotient_iff_mem_sup] at h2
    exact h2
  have hKrull := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := O ⧸ K)
    (IsLocalRing.maximalIdeal O) (IsLocalRing.maximalIdeal.isMaximal O).ne_top
  have hmem : (Ideal.Quotient.mk K g) ∈
      ⨅ i : ℕ, IsLocalRing.maximalIdeal O ^ i • (⊤ : Submodule O (O ⧸ K)) := by
    rw [Submodule.mem_iInf]
    intro i
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (hsup i)
    have : Ideal.Quotient.mk K g = b • Ideal.Quotient.mk K 1 := by
      rw [← hab, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr ha, zero_add, Algebra.smul_def,
        Ideal.Quotient.algebraMap_eq, ← map_mul, mul_one]
    rw [this]
    exact Submodule.smul_mem_smul hb Submodule.mem_top
  rw [hKrull, Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem] at hmem
  exact hmem

theorem wcpa_dj_sfb_avoid : ∀ (X : Scheme.{u}) (w : X) (ξ h : X.presheaf.stalk w) (n' : ℕ) (s' : Fin n' → AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk w)) (X.presheaf.stalk w)) (e : Fin n') (A' : Finset (Fin n')), IsRegularLocalRing (X.presheaf.stalk w) → (n' : WithBot ℕ∞) = ringKrullDim (X.presheaf.stalk w) → Ideal.span (Set.range s') = (IsLocalRing.maximalIdeal (X.presheaf.stalk w)).map (algebraMap _ _) → e ∉ A' → Associated (algebraMap _ (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk w)) (X.presheaf.stalk w)) ξ) (s' e) → Associated (algebraMap _ (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk w)) (X.presheaf.stalk w)) h) (∏ k ∈ A', s' k) → ∀ (z'' : X) (hz : z'' ⤳ w), (X.presheaf.stalkSpecializes hz).hom h ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z'') → ∃ (z₃ : X) (h₃ : z₃ ⤳ w), z₃ ⤳ z'' ∧ (X.presheaf.stalkSpecializes h₃).hom h ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z₃) ∧ (X.presheaf.stalkSpecializes h₃).hom ξ ∉ IsLocalRing.maximalIdeal (X.presheaf.stalk z₃) :=
by
  intro X w ξ h n' s' e A' hreg hdim hspan heA hξ hh z'' hz hmem
  classical

  have s1 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (n' : ℕ)
      (s' : Fin n' → AdicCompletion (IsLocalRing.maximalIdeal B) B), IsRegularLocalRing B →
      (n' : WithBot ℕ∞) = ringKrullDim B →
      Ideal.span (Set.range s') = (IsLocalRing.maximalIdeal B).map
        (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)) →
      (∀ k, Prime (s' k)) ∧ (∀ k l, k ≠ l → ¬ s' k ∣ s' l) := by
    intro B _ _ _ n' s' _ hdim hspan
    haveI hN : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal B) B) :=
      wc_hnas_completion_noetherian B
    have hmax : IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal B) B) =
        Ideal.span (Set.range s') := by
      rw [hspan, AdicCompletion.maximalIdeal_eq_map]
    have hd : ringKrullDim (AdicCompletion (IsLocalRing.maximalIdeal B) B) = ringKrullDim B :=
      wc_lfi_flat_local_dim_eq B _ AdicCompletion.maximalIdeal_eq_map.symm
    have h1 : (Ideal.span (Set.range s')).spanFinrank ≤ (Set.range s').ncard :=
      Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range s')
    have h2 : (Set.range s').ncard ≤ n' := by
      rw [← Set.image_univ]
      refine (Set.ncard_image_le (Set.toFinite _)).trans ?_
      rw [Set.ncard_univ, Nat.card_fin]
    have hrk : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal
        (AdicCompletion (IsLocalRing.maximalIdeal B) B)) : ℕ) : WithBot ℕ∞) ≤
        ringKrullDim (AdicCompletion (IsLocalRing.maximalIdeal B) B) := by
      rw [hd, ← hdim, hmax]
      exact_mod_cast h1.trans h2
    haveI := IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ hrk
    obtain ⟨-, hp, hnd⟩ := wcpa_dj_bko_regular_params _ n' s' (hdim.trans hd.symm) hmax.symm
    exact ⟨hp, hnd⟩

  have s2 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (ξ h : B) (n' : ℕ)
      (s' : Fin n' → AdicCompletion (IsLocalRing.maximalIdeal B) B) (e : Fin n')
      (A' : Finset (Fin n')), (∀ k, Prime (s' k)) → (∀ k l, k ≠ l → ¬ s' k ∣ s' l) → e ∉ A' →
      Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) ξ) (s' e) →
      Associated (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) h)
        (∏ k ∈ A', s' k) →
      ∀ P : Ideal B, P.IsPrime → h ∈ P →
        ∃ P' : Ideal B, P'.IsPrime ∧ P' ≤ P ∧ h ∈ P' ∧ ξ ∉ P' := by
    intro B _ _ _ ξ h n' s' e A' hp hnd heA hξ hh P hP hhP
    haveI : Module.FaithfullyFlat B (AdicCompletion (IsLocalRing.maximalIdeal B) B) :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    obtain ⟨Q, hQ, hQP⟩ := Ideal.exists_isPrime_liesOver_of_faithfullyFlat
      (B := AdicCompletion (IsLocalRing.maximalIdeal B) B) P
    haveI := hQ
    have hPQ : P = Q.comap (algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B)) :=
      hQP.over
    have hιh : algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) h ∈ Q := by
      rw [hPQ] at hhP; exact hhP
    obtain ⟨u, hu⟩ := hh
    have hprod : ∏ k ∈ A', s' k ∈ Q := by rw [← hu]; exact Q.mul_mem_right _ hιh
    obtain ⟨k, hkA, hkQ⟩ := (Ideal.IsPrime.prod_mem_iff).mp hprod
    refine ⟨(Ideal.span {s' k}).comap (algebraMap B _), ?_, ?_, ?_, ?_⟩
    · haveI := (Ideal.span_singleton_prime (hp k).ne_zero).mpr (hp k)
      exact Ideal.comap_isPrime _ _
    · rw [hPQ]; exact Ideal.comap_mono ((Ideal.span_singleton_le_iff_mem _).mpr hkQ)
    · rw [Ideal.mem_comap, Ideal.mem_span_singleton]
      exact (Associated.dvd_iff_dvd_right ⟨u, hu⟩).mpr (Finset.dvd_prod_of_mem s' hkA)
    · rw [Ideal.mem_comap, Ideal.mem_span_singleton]
      intro hd
      have hke : k ≠ e := fun h' => heA (h' ▸ hkA)
      exact hnd k e hke ((Associated.dvd_iff_dvd_right hξ).mp hd)

  have s3 : ∀ (P' : Ideal (X.presheaf.stalk w)), P'.IsPrime →
      P' ≤ Ideal.comap (X.presheaf.stalkSpecializes hz).hom
        (IsLocalRing.maximalIdeal (X.presheaf.stalk z'')) →
      ∃ (z₃ : X) (h₃ : z₃ ⤳ w), z₃ ⤳ z'' ∧ ∀ a : X.presheaf.stalk w,
        (X.presheaf.stalkSpecializes h₃).hom a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk z₃) ↔
          a ∈ P' := by
    intro P' hP' hle
    obtain ⟨h₃, hiff⟩ := wcpa_dj_mn_generization X w ⟨P', hP'⟩
    refine ⟨_, h₃, ?_, hiff⟩
    let q : PrimeSpectrum (X.presheaf.stalk w) :=
      ⟨Ideal.comap (X.presheaf.stalkSpecializes hz).hom
        (IsLocalRing.maximalIdeal (X.presheaf.stalk z'')), Ideal.comap_isPrime _ _⟩
    have hq0 : (Spec.map (X.presheaf.stalkSpecializes hz))
        (IsLocalRing.closedPoint (X.presheaf.stalk z'')) = q := rfl
    have e0 := congrArg (fun k : Spec (X.presheaf.stalk z'') ⟶ X =>
      k (IsLocalRing.closedPoint (X.presheaf.stalk z'')))
      (Scheme.SpecMap_stalkSpecializes_fromSpecStalk hz)
    simp only [Scheme.fromSpecStalk_closedPoint] at e0
    have hzA : X.fromSpecStalk w ((Spec.map (X.presheaf.stalkSpecializes hz))
        (IsLocalRing.closedPoint (X.presheaf.stalk z''))) = z'' := e0
    have hz0 : X.fromSpecStalk w q = z'' := by
      calc X.fromSpecStalk w q = X.fromSpecStalk w ((Spec.map (X.presheaf.stalkSpecializes hz))
            (IsLocalRing.closedPoint (X.presheaf.stalk z''))) := by rw [hq0]
        _ = z'' := hzA
    have hq : (⟨P', hP'⟩ : PrimeSpectrum (X.presheaf.stalk w)) ≤ q := hle
    have hsp := ((PrimeSpectrum.le_iff_specializes _ _).mp hq).map (X.fromSpecStalk w).continuous
    rw [hz0] at hsp
    exact hsp

  haveI := hreg
  obtain ⟨hp, hnd⟩ := s1 _ n' s' hreg hdim hspan
  obtain ⟨P', hP', hP'le, hhP', hξP'⟩ := s2 _ ξ h n' s' e A' hp hnd heA hξ hh
    (Ideal.comap (X.presheaf.stalkSpecializes hz).hom
      (IsLocalRing.maximalIdeal (X.presheaf.stalk z''))) (Ideal.comap_isPrime _ _)
    (Ideal.mem_comap.mpr hmem)
  obtain ⟨z₃, h₃, h3z, hiff⟩ := s3 P' hP' hP'le
  exact ⟨z₃, h₃, h3z, (hiff h).2 hhP', fun H => hξP' ((hiff ξ).1 H)⟩

theorem wcpa_dj_sf_blowup_step : ∀ (k : Type u) [Field k] (Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] (sZ : Z ⟶ Spec (.of k)) (m : ℕ) (Dc : Fin m → Set Z) (μ : Fin m → Z → ℕ) (R : ℕ) (i₀ : Fin m), wcpaDjIsProjOver k sZ → (∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) → wcpaDjCompNC Z m Dc μ → 2 ≤ R → (∀ i z, μ i z ≤ R) → ∃ (Z' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Z') (π : Z' ⟶ Z) (Dc' : Fin (m + 1) → Set Z') (μ' : Fin (m + 1) → Z' → ℕ), IsProper π ∧ Surjective π ∧ (∃ V : Z.Opens, V ≠ ⊥ ∧ IsIso (π ∣_ V)) ∧ (∀ w : Z', IsRegularLocalRing (Z'.presheaf.stalk w)) ∧ wcpaDjIsProjOver k (π ≫ sZ) ∧ wcpaDjCompNC Z' (m + 1) Dc' μ' ∧ ⇑π ⁻¹' (⋃ i, Dc i) ⊆ ⋃ i, Dc' i ∧ (∀ w, μ' (Fin.last m) w ≤ 1) ∧ (∀ (i : Fin m) w, μ' i.castSucc w ≤ μ i (π w)) ∧ (∀ w, μ' i₀.castSucc w < R) :=
by
  intro k _ Z _ sZ m Dc μ R i₀ hproj hreg hC hR hle
  classical
  haveI hsZp : IsProper sZ := wcpa_dj_proj_proper k sZ hproj
  have hNC : ∀ z : Z, ∃ (n : ℕ) (J : Fin m → Finset (Fin n)),
      wcpaDjNCData Z m Dc z n J ∧ ∀ i, (J i).card = μ i z := by
    intro z
    obtain ⟨n, s, g, J, hn, hs, hdisj, hout, hin⟩ := hC.2 z
    refine ⟨n, J, ⟨s, g, hn, hs, hdisj, fun i hi => (hout i hi).1,
      fun i hi => ⟨(hin i hi).2.1, (hin i hi).2.2⟩⟩, ?_⟩
    intro i
    by_cases hi : z ∈ Dc i
    · exact (hin i hi).1
    · rw [(hout i hi).1, (hout i hi).2]; rfl
  have hfin : ∀ (Z' : Scheme.{u}) (Dc' : Fin (m + 1) → Set Z')
      (Q : Z' → (Fin (m + 1) → ℕ) → Prop), (∀ i, IsClosed (Dc' i)) →
      (∀ w, ∃ (n : ℕ) (J : Fin (m + 1) → Finset (Fin n)),
        wcpaDjNCData Z' (m + 1) Dc' w n J ∧ Q w (fun i => (J i).card)) →
      ∃ μ' : Fin (m + 1) → Z' → ℕ, wcpaDjCompNC Z' (m + 1) Dc' μ' ∧
        ∀ w, Q w (fun i => μ' i w) := by
    intro Z' Dc' Q hcl hP
    choose n J hJ hQ using hP
    refine ⟨fun i w => (J w i).card, ⟨hcl, fun w => ?_⟩, hQ⟩
    obtain ⟨s, g, h1, h2, h3, h4, h5⟩ := hJ w
    refine ⟨n w, s, g, J w, h1, h2, h3, fun i hi => ⟨h4 i hi, ?_⟩,
      fun i hi => ⟨rfl, (h5 i hi).1, (h5 i hi).2⟩⟩
    show (J w i).card = 0
    rw [h4 i hi]; rfl
  set C : Set Z := {z : Z | z ∈ Dc i₀ ∧ μ i₀ z = R} with hCdef
  have hoff : ∀ z, z ∉ C → μ i₀ z < R := by
    intro z hz
    by_cases hd : z ∈ Dc i₀
    · have h1 := hle i₀ z
      have hne : μ i₀ z ≠ R := fun h => hz ⟨hd, h⟩
      omega
    · obtain ⟨n, s, g, J, -, -, -, hout, -⟩ := hC.2 z
      rw [(hout i₀ hd).2]; omega
  have hcentre := wcpa_dj_sf_centre k Z sZ m Dc μ R i₀ hreg hC hle
  have hCcl : IsClosed C := hcentre.1
  have hgen : genericPoint Z ∉ C := by
    rintro ⟨hd, hμ⟩
    obtain ⟨n, s, g, J, hn, -, -, -, hin⟩ := hC.2 (genericPoint Z)
    have h0 : ringKrullDim (Z.presheaf.stalk (genericPoint Z)) = 0 := by
      change ringKrullDim Z.functionField = 0
      exact ringKrullDim_eq_zero_of_field _
    rw [h0] at hn
    have hn0 : n = 0 := by exact_mod_cast hn
    subst hn0
    have hc := (hin i₀ hd).1
    rw [Finset.eq_empty_of_isEmpty (J i₀), Finset.card_empty] at hc
    omega
  have hIsupp : ((Scheme.IdealSheafData.vanishingIdeal ⟨C, hCcl⟩ : Z.IdealSheafData).support :
      Set Z) = C := Scheme.IdealSheafData.coe_support_vanishingIdeal _
  have hsuppne : ((Scheme.IdealSheafData.vanishingIdeal ⟨C, hCcl⟩ : Z.IdealSheafData).support :
      Set Z) ≠ Set.univ := by
    rw [hIsupp]; intro h; apply hgen; rw [h]; trivial
  obtain ⟨Z', iZ', π, hπp, hπs, hπproj, hπiso, hcharts⟩ :=
    wcpa_dj_rn_blowup k Z sZ (Scheme.IdealSheafData.vanishingIdeal ⟨C, hCcl⟩) hproj hsuppne
  haveI := iZ'
  set V0 : Z.Opens := ⟨((Scheme.IdealSheafData.vanishingIdeal ⟨C, hCcl⟩ :
      Z.IdealSheafData).support : Set Z)ᶜ, (Scheme.IdealSheafData.vanishingIdeal ⟨C, hCcl⟩ :
      Z.IdealSheafData).support.isClosed.isOpen_compl⟩ with hV0
  have hset : (V0 : Set Z) = Cᶜ := by
    show ((Scheme.IdealSheafData.vanishingIdeal ⟨C, hCcl⟩ :
      Z.IdealSheafData).support : Set Z)ᶜ = Cᶜ
    rw [hIsupp]
  let Dc' : Fin (m + 1) → Set Z' := Fin.snoc (α := fun _ => Set Z')
    (fun l => closure (⇑π ⁻¹' Dc l ∩ ⇑π ⁻¹' Cᶜ)) (⇑π ⁻¹' C)
  have hDcast : ∀ l, Dc' l.castSucc = closure (⇑π ⁻¹' Dc l ∩ ⇑π ⁻¹' Cᶜ) := by
    intro l; simp only [Dc', Fin.snoc_castSucc]
  have hDlast : Dc' (Fin.last m) = ⇑π ⁻¹' C := by
    simp only [Dc', Fin.snoc_last]
  have hcl : ∀ i, IsClosed (Dc' i) := by
    intro i
    induction i using Fin.lastCases with
    | last => rw [hDlast]; exact hCcl.preimage π.continuous
    | cast i => rw [hDcast]; exact isClosed_closure
  have hK : ∀ l, Dc' l.castSucc ∩ ⇑π ⁻¹' Cᶜ = ⇑π ⁻¹' Dc l ∩ ⇑π ⁻¹' Cᶜ := by
    intro l
    rw [hDcast]
    apply Set.Subset.antisymm
    · rintro x ⟨hx1, hx2⟩
      refine ⟨?_, hx2⟩
      have h3 := closure_mono
        (Set.inter_subset_left : ⇑π ⁻¹' Dc l ∩ ⇑π ⁻¹' Cᶜ ⊆ ⇑π ⁻¹' Dc l) hx1
      rwa [((hC.1 l).preimage π.continuous).closure_eq] at h3
    · intro x hx
      exact ⟨subset_closure hx, hx.2⟩
  have hon : ∀ w, π w ∈ C → ∃ (n : ℕ) (J : Fin (m + 1) → Finset (Fin n)),
      wcpaDjNCData Z' (m + 1) Dc' w n J ∧ ((J (Fin.last m)).card ≤ 1 ∧
        (∀ i : Fin m, (J i.castSucc).card ≤ μ i (π w)) ∧
        (J i₀.castSucc).card < R ∧ IsRegularLocalRing (Z'.presheaf.stalk w)) := by
    intro w hw
    obtain ⟨r, rfl⟩ : ∃ r, R = r + 1 := ⟨R - 1, by omega⟩
    obtain ⟨hd, hμ⟩ := hw
    obtain ⟨n, s, g, J, hn, hs, hdisj, hout, hin⟩ := hC.2 (π w)
    have hcardJ : ∀ i, (J i).card = μ i (π w) := by
      intro i
      by_cases hi : π w ∈ Dc i
      · exact (hin i hi).1
      · rw [(hout i hi).1, (hout i hi).2]; rfl
    have hA₀ : (J i₀).card = r + 1 := (hin i₀ hd).1.trans hμ
    obtain ⟨x, hxspan, hxι⟩ := hcentre.2 (π w) ⟨hd, hμ⟩ n s (g i₀) (J i₀) hn hs hA₀
      (hin i₀ hd).2.1 (hin i₀ hd).2.2
    haveI := hreg (π w)
    haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian sZ
    haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace sZ
    haveI : IsNoetherian Z := {}
    have hgx := wcpa_dj_sfb_power_mem (Z.presheaf.stalk (π w)) n (r + 1) s (J i₀) x (g i₀) hA₀ hxι
      (hin i₀ hd).2.1
    obtain ⟨U, hzU, f, G, hfspan, hgerm_f, hGg, hGpow, hGiff⟩ :=
      wcpa_dj_sfb_local_generators Z C (Dc i₀) hCcl (hC.1 i₀) (π w) (r + 1) x (g i₀) ⟨hd, hμ⟩
        hxspan hgx (hin i₀ hd).2.2
    haveI : Nonempty (U : Z.Opens) := ⟨⟨π w, hzU⟩⟩
    haveI := IsLocallyNoetherian.component_noetherian U
    letI : Algebra Γ(Z, (U : Z.Opens)) (Z.presheaf.stalk (π w)) :=
      TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨π w, hzU⟩
    haveI : IsLocalization.AtPrime (Z.presheaf.stalk (π w)) (U.2.primeIdealOf ⟨π w, hzU⟩).asIdeal :=
      U.2.isLocalization_stalk ⟨π w, hzU⟩
    have hspan5 : Ideal.span (Set.range fun l => algebraMap (Z.presheaf.stalk (π w))
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (π w))) (Z.presheaf.stalk (π w)))
        (algebraMap Γ(Z, (U : Z.Opens)) (Z.presheaf.stalk (π w)) (f l))) =
        Ideal.span (s '' (J i₀ : Set (Fin n))) := by
      rw [← hxι]
      have e1 : (Set.range fun l => algebraMap (Z.presheaf.stalk (π w))
          (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (π w))) (Z.presheaf.stalk (π w)))
          (algebraMap Γ(Z, (U : Z.Opens)) (Z.presheaf.stalk (π w)) (f l))) =
          (algebraMap (Z.presheaf.stalk (π w))
          (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (π w))) (Z.presheaf.stalk (π w)))) ''
          Set.range (fun l => Z.presheaf.germ (U : Z.Opens) (π w) hzU (f l)) := by
        rw [← Set.range_comp]; rfl
      have e2 : (Set.range fun l => algebraMap (Z.presheaf.stalk (π w))
          (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (π w))) (Z.presheaf.stalk (π w)))
          (x l)) = (algebraMap (Z.presheaf.stalk (π w))
          (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk (π w))) (Z.presheaf.stalk (π w)))) ''
          Set.range x := by
        rw [← Set.range_comp]; rfl
      rw [e1, e2, ← Ideal.map_span, ← Ideal.map_span, hgerm_f]
    obtain ⟨hfne, hchart⟩ := wcpa_dj_sfb_chart_regular Γ(Z, (U : Z.Opens))
      (U.2.primeIdealOf ⟨π w, hzU⟩).asIdeal (Z.presheaf.stalk (π w)) n r s (J i₀) f (hreg _) hn hs
      hA₀ hspan5
    obtain ⟨V, hVsup, hVi⟩ := hcharts U r f hfspan hfne
    have hwU : w ∈ π ⁻¹ᵁ (U : Z.Opens) := hzU
    rw [← hVsup] at hwU
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hwU
    obtain ⟨hVU, hVaff, e, he⟩ := hVi a
    obtain ⟨𝔮, h𝔮, alg, hloc𝔮, hcomap, hgerm_e, hstalk⟩ :=
      wcpa_dj_sfb_chart_stalk π (U : Z.Opens) U.2 (V a) hVaff hVU (wcpaDjChart Γ(Z, (U : Z.Opens)) f a)
        e he w ha
    letI := alg
    obtain ⟨hregw, φh, n', s', τ, e₀, A', hφh, hn', hs', hτ, hτinj, he₀τ, he₀A', hA'τ, hA'card,
      hξ, hstrict⟩ := hchart a 𝔮 (Z'.presheaf.stalk w) (π.stalkMap w).hom hcomap
        (fun c => (hstalk c).symm)

    have hsm : ∀ (y : Z') (hy : y ∈ V a) (c : Γ(Z, (U : Z.Opens))),
        (π.stalkMap y).hom (Z.presheaf.germ (U : Z.Opens) (π y) (hVU hy) c) =
          Z'.presheaf.germ (V a) y hy ((π.appLE (U : Z.Opens) (V a) hVU).hom c) := by
      intro y hy c
      obtain ⟨_, _, alg', _, _, hge', hst'⟩ :=
        wcpa_dj_sfb_chart_stalk π (U : Z.Opens) U.2 (V a) hVaff hVU
          (wcpaDjChart Γ(Z, (U : Z.Opens)) f a) e he y hy
      letI := alg'
      rw [← hst' c, ← he c, hge']
    have hloc_map : ∀ (y : Z') (b : Z.presheaf.stalk (π y)),
        (π.stalkMap y).hom b ∈ IsLocalRing.maximalIdeal (Z'.presheaf.stalk y) ↔
          b ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk (π y)) := by
      intro y b
      simp only [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact (isUnit_map_iff (π.stalkMap y).hom b).not
    have hcomm : ∀ (y z'' : Z') (h : z'' ⤳ y) (b : Z.presheaf.stalk (π y)),
        (Z'.presheaf.stalkSpecializes h).hom ((π.stalkMap y).hom b) =
          (π.stalkMap z'').hom ((Z.presheaf.stalkSpecializes (h.map π.continuous)).hom b) :=
      fun y z'' h b => (Scheme.Hom.stalkSpecializes_stalkMap_apply π z'' y h b).symm
    have hspec : ∀ (y : Z') (hy : y ∈ V a) (z'' : Z') (h : z'' ⤳ y) (b : Γ(Z', V a)),
        (Z'.presheaf.stalkSpecializes h).hom (Z'.presheaf.germ (V a) y hy b) =
          Z'.presheaf.germ (V a) z'' (h.mem_open (V a).isOpen hy) b :=
      fun y hy z'' h b => TopCat.Presheaf.germ_stalkSpecializes_apply Z'.presheaf hy h b
    have hdivA : ∀ l, ∃ t : Γ(Z', V a), (π.appLE (U : Z.Opens) (V a) hVU).hom (f l) =
        (π.appLE (U : Z.Opens) (V a) hVU).hom (f a) * t := by
      intro l
      refine ⟨e.symm ⟨IsLocalization.mk' (Localization.Away (f a)) (f l)
        (⟨f a, Submonoid.mem_powers _⟩ : Submonoid.powers (f a)), Algebra.subset_adjoin ⟨l, rfl⟩⟩, ?_⟩
      apply e.injective
      rw [map_mul, RingEquiv.apply_symm_apply, he, he]
      apply Subtype.ext
      simp only [MulMemClass.coe_mul, Subalgebra.coe_algebraMap]
      exact (IsLocalization.mk'_spec' (Localization.Away (f a)) (f l) _).symm
    have hIle : Ideal.map (π.appLE (U : Z.Opens) (V a) hVU).hom (Ideal.span (Set.range f)) ≤
        Ideal.span {(π.appLE (U : Z.Opens) (V a) hVU).hom (f a)} := by
      rw [Ideal.map_span, Ideal.span_le]
      rintro _ ⟨_, ⟨l, rfl⟩, rfl⟩
      obtain ⟨t, ht⟩ := hdivA l
      rw [SetLike.mem_coe, ht]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    have hGm : (π.appLE (U : Z.Opens) (V a) hVU).hom G ∈
        Ideal.span {(π.appLE (U : Z.Opens) (V a) hVU).hom (f a) ^ (r + 1)} := by
      rw [← Ideal.span_singleton_pow]
      refine Ideal.pow_right_mono hIle (r + 1) ?_
      rw [← Ideal.map_pow]
      exact Ideal.mem_map_of_mem _ hGpow
    obtain ⟨H, hH⟩ := Ideal.mem_span_singleton'.mp hGm
    have hGH : (π.appLE (U : Z.Opens) (V a) hVU).hom G =
        (π.appLE (U : Z.Opens) (V a) hVU).hom (f a) ^ (r + 1) * H := by
      rw [← hH, mul_comm]
    have hexc := wcpa_dj_sfb_exceptional_locus π C hCcl U r f hfspan (V a) hVU a hdivA
    set ξ : Z'.presheaf.stalk w := Z'.presheaf.germ (V a) w ha
      ((π.appLE (U : Z.Opens) (V a) hVU).hom (f a)) with hξdef
    have hξeq : algebraMap (wcpaDjChart Γ(Z, (U : Z.Opens)) f a) (Z'.presheaf.stalk w)
        (algebraMap Γ(Z, (U : Z.Opens)) (wcpaDjChart Γ(Z, (U : Z.Opens)) f a) (f a)) = ξ := by
      rw [← he (f a), hgerm_e]
    have hξ' : Associated (algebraMap (Z'.presheaf.stalk w) (AdicCompletion
        (IsLocalRing.maximalIdeal (Z'.presheaf.stalk w)) (Z'.presheaf.stalk w)) ξ) (s' e₀) := by
      rw [← hξeq]; exact hξ
    have hchar : ∀ (y : Z') (hy : y ∈ V a), π y ∈ Dc i₀ ↔
        Z'.presheaf.germ (V a) y hy ((π.appLE (U : Z.Opens) (V a) hVU).hom (f a)) ^ (r + 1) *
          Z'.presheaf.germ (V a) y hy H ∈ IsLocalRing.maximalIdeal (Z'.presheaf.stalk y) := by
      intro y hy
      rw [hGiff (π y) (hVU hy), ← hloc_map y, hsm y hy G, hGH, map_mul, map_pow]
    have hDsub : ∀ l, Dc' l.castSucc ⊆ ⇑π ⁻¹' Dc l := by
      intro l; rw [hDcast]
      exact closure_minimal Set.inter_subset_left ((hC.1 l).preimage π.continuous)

    let K : Fin m → Finset (Fin n') := fun l => if l = i₀ then A' else (J l).image τ
    let Kf : Fin (m + 1) → Finset (Fin n') := Fin.snoc (α := fun _ => Finset (Fin n')) K {e₀}
    let J' : Fin (m + 1) → Finset (Fin n') := fun i => if w ∈ Dc' i then Kf i else ∅
    let gK : Fin m → Z'.presheaf.stalk w := fun l =>
      if l = i₀ then Z'.presheaf.germ (V a) w ha H else (π.stalkMap w).hom (g l)
    let g' : Fin (m + 1) → Z'.presheaf.stalk w := Fin.snoc (α := fun _ => Z'.presheaf.stalk w) gK ξ
    have hKf_last : Kf (Fin.last m) = {e₀} := by simp only [Kf, Fin.snoc_last]
    have hKf_cast : ∀ l, Kf l.castSucc = K l := by intro l; simp only [Kf, Fin.snoc_castSucc]
    have hg_last : g' (Fin.last m) = ξ := by simp only [g', Fin.snoc_last]
    have hg_cast : ∀ l, g' l.castSucc = gK l := by intro l; simp only [g', Fin.snoc_castSucc]
    have hJl : ∀ l, l ≠ i₀ → ∀ j ∈ J l, j ∉ J i₀ :=
      fun l hl j hj => Finset.disjoint_left.mp (hdisj l i₀ hl) hj
    have hKne : ∀ l, l ≠ i₀ → K l = (J l).image τ := fun l hl => if_neg hl
    have hK0 : K i₀ = A' := if_pos rfl
    have he₀K : ∀ l, e₀ ∉ K l := by
      intro l
      by_cases hl : l = i₀
      · rw [hl, hK0]; exact he₀A'
      · rw [hKne l hl]
        intro hm
        obtain ⟨j, hj, hje⟩ := Finset.mem_image.mp hm
        exact he₀τ ⟨j, hJl l hl j hj, hje⟩
    have hKdisj : ∀ i l, i ≠ l → Disjoint (K i) (K l) := by
      have hA'img : ∀ l, l ≠ i₀ → Disjoint A' ((J l).image τ) := by
        intro l hl
        rw [Finset.disjoint_left]
        intro k hkA hkI
        obtain ⟨j, hj, hjk⟩ := Finset.mem_image.mp hkI
        exact Set.disjoint_left.mp hA'τ (Finset.mem_coe.mpr hkA) ⟨j, hJl l hl j hj, hjk⟩
      intro i l hil
      by_cases hi : i = i₀
      · have hl : l ≠ i₀ := fun h => hil (hi.trans h.symm)
        rw [hi, hK0, hKne l hl]; exact hA'img l hl
      · by_cases hl : l = i₀
        · rw [hl, hK0, hKne i hi]; exact (hA'img i hi).symm
        · rw [hKne i hi, hKne l hl, Finset.disjoint_left]
          intro k hk1 hk2
          obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hk1
          obtain ⟨j', hj', hjj⟩ := Finset.mem_image.mp hk2
          have : j' = j := hτinj (hJl l hl j' hj') (hJl i hi j hj) hjj
          subst this
          exact Finset.disjoint_left.mp (hdisj i l hil) hj hj'
    have hKfdisj : ∀ i l, i ≠ l → Disjoint (Kf i) (Kf l) := by
      intro i l hil
      induction i using Fin.lastCases with
      | last =>
        induction l using Fin.lastCases with
        | last => exact absurd rfl hil
        | cast l => rw [hKf_last, hKf_cast]; exact Finset.disjoint_singleton_left.mpr (he₀K l)
      | cast i =>
        induction l using Fin.lastCases with
        | last => rw [hKf_last, hKf_cast]; exact Finset.disjoint_singleton_right.mpr (he₀K i)
        | cast l =>
          rw [hKf_cast, hKf_cast]
          exact hKdisj i l (fun h => hil (by rw [h]))
    have hJ'sub : ∀ i, J' i ⊆ Kf i := by
      intro i
      by_cases hi : w ∈ Dc' i
      · simp only [J', if_pos hi, subset_refl]
      · simp only [J', if_neg hi]; exact Finset.empty_subset _

    have hcl_other : ∀ l, l ≠ i₀ → w ∈ Dc' l.castSucc →
        Associated (algebraMap (Z'.presheaf.stalk w) (AdicCompletion
          (IsLocalRing.maximalIdeal (Z'.presheaf.stalk w)) (Z'.presheaf.stalk w)) (gK l))
          (∏ k ∈ K l, s' k) ∧ ∀ (z'' : Z') (h : z'' ⤳ w), (z'' ∈ Dc' l.castSucc ↔
            (Z'.presheaf.stalkSpecializes h).hom (gK l) ∈
              IsLocalRing.maximalIdeal (Z'.presheaf.stalk z'')) := by
      intro l hl hwl
      have hgl : gK l = (π.stalkMap w).hom (g l) := if_neg hl
      have hzl : π w ∈ Dc l := hDsub l hwl
      have hinj : Set.InjOn τ (J l : Set (Fin n)) := hτinj.mono (fun j hj => hJl l hl j hj)
      have hassoc : Associated (algebraMap (Z'.presheaf.stalk w) (AdicCompletion
          (IsLocalRing.maximalIdeal (Z'.presheaf.stalk w)) (Z'.presheaf.stalk w))
          ((π.stalkMap w).hom (g l))) (∏ k ∈ (J l).image τ, s' k) := by
        rw [← hφh, Finset.prod_image hinj]
        have h1 := (hin l hzl).2.1.map φh
        rw [map_prod, Finset.prod_congr rfl (fun j hj => (hτ j (hJl l hl j hj)).symm)] at h1
        exact h1
      rw [hgl, hKne l hl]
      refine ⟨hassoc, fun z'' h => ⟨fun hz'' => ?_, fun hmem => ?_⟩⟩
      · rw [hcomm, hloc_map]
        exact ((hin l hzl).2.2 _ _).mp (hDsub l hz'')
      · have he₀I : e₀ ∉ (J l).image τ := by rw [← hKne l hl]; exact he₀K l
        obtain ⟨z₃, h₃, h3'', hh3, hξ3⟩ := wcpa_dj_sfb_avoid Z' w ξ ((π.stalkMap w).hom (g l)) n' s'
          e₀ ((J l).image τ) hregw hn' hs' he₀I hξ' hassoc z'' h hmem
        have hz3V : z₃ ∈ V a := h₃.mem_open (V a).isOpen ha
        have hz3D : π z₃ ∈ Dc l := by
          rw [hcomm, hloc_map] at hh3
          exact ((hin l hzl).2.2 _ _).mpr hh3
        have hz3C : π z₃ ∉ C := by
          rw [hξdef, hspec w ha z₃ h₃] at hξ3
          exact fun hc => hξ3 ((hexc z₃ hz3V).mp hc)
        rw [hDcast]
        exact h3''.mem_closed isClosed_closure (subset_closure ⟨hz3D, hz3C⟩)

    have hcl_zero : w ∈ Dc' i₀.castSucc →
        Associated (algebraMap (Z'.presheaf.stalk w) (AdicCompletion
          (IsLocalRing.maximalIdeal (Z'.presheaf.stalk w)) (Z'.presheaf.stalk w)) (gK i₀))
          (∏ k ∈ K i₀, s' k) ∧ ∀ (z'' : Z') (h : z'' ⤳ w), (z'' ∈ Dc' i₀.castSucc ↔
            (Z'.presheaf.stalkSpecializes h).hom (gK i₀) ∈
              IsLocalRing.maximalIdeal (Z'.presheaf.stalk z'')) := by
      intro _
      have hg0 : gK i₀ = Z'.presheaf.germ (V a) w ha H := if_pos rfl
      have hφg : (π.stalkMap w).hom (g i₀) = ξ ^ (r + 1) * Z'.presheaf.germ (V a) w ha H := by
        rw [← hGg, hsm w ha G, hGH, map_mul, map_pow]
      have hassoc0 : Associated (algebraMap (Z'.presheaf.stalk w) (AdicCompletion
          (IsLocalRing.maximalIdeal (Z'.presheaf.stalk w)) (Z'.presheaf.stalk w))
          (Z'.presheaf.germ (V a) w ha H)) (∏ k ∈ A', s' k) :=
        hstrict _ (by rw [hξeq, ← hφg, ← hφh]; exact (hin i₀ hd).2.1.map φh)
      rw [hg0, hK0]
      refine ⟨hassoc0, fun z'' h => ⟨fun hz'' => ?_, fun hmem => ?_⟩⟩
      · have hzV : z'' ∈ V a := h.mem_open (V a).isOpen ha
        rw [hspec w ha z'' h]
        by_contra hnot
        have hu : IsUnit (Z'.presheaf.germ (V a) z'' hzV H) := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hnot; exact hnot
        have hbo : z'' ∈ Z'.basicOpen H := (Scheme.mem_basicOpen Z' H z'' hzV).mpr hu
        rw [hDcast] at hz''
        obtain ⟨y, hyB, hyS⟩ := mem_closure_iff.mp hz'' _ (Z'.basicOpen H).isOpen hbo
        have hyV : y ∈ V a := Z'.basicOpen_le H hyB
        have huy : IsUnit (Z'.presheaf.germ (V a) y hyV H) :=
          (Scheme.mem_basicOpen Z' H y hyV).mp hyB
        have hξy : IsUnit (Z'.presheaf.germ (V a) y hyV
            ((π.appLE (U : Z.Opens) (V a) hVU).hom (f a))) := by
          have h1 := (hexc y hyV).not.mp hyS.2
          rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at h1
        have hp := (hchar y hyV).mp hyS.1
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hp
        exact hp ((hξy.pow _).mul huy)
      · obtain ⟨z₃, h₃, h3'', hh3, hξ3⟩ := wcpa_dj_sfb_avoid Z' w ξ (Z'.presheaf.germ (V a) w ha H)
          n' s' e₀ A' hregw hn' hs' he₀A' hξ' hassoc0 z'' h hmem
        have hz3V : z₃ ∈ V a := h₃.mem_open (V a).isOpen ha
        rw [hspec w ha z₃ h₃] at hh3
        rw [hξdef, hspec w ha z₃ h₃] at hξ3
        have hz3C : π z₃ ∉ C := fun hc => hξ3 ((hexc z₃ hz3V).mp hc)
        have hz3D : π z₃ ∈ Dc i₀ := (hchar z₃ hz3V).mpr (Ideal.mul_mem_left _ _ hh3)
        rw [hDcast]
        exact h3''.mem_closed isClosed_closure (subset_closure ⟨hz3D, hz3C⟩)
    refine ⟨n', J', ⟨s', g', hn', hs', ?_, ?_, ?_⟩, ?_, ?_, ?_, hregw⟩
    · intro i l hil
      exact (hKfdisj i l hil).mono (hJ'sub i) (hJ'sub l)
    · intro i hi
      simp only [J', if_neg hi]
    · intro i hi
      have hJi : J' i = Kf i := if_pos hi
      rw [hJi]
      induction i using Fin.lastCases with
      | last =>
        rw [hKf_last, hg_last, Finset.prod_singleton]
        refine ⟨hξ', fun z'' h => ?_⟩
        rw [hDlast, hξdef, hspec w ha z'' h]
        exact hexc z'' _
      | cast l =>
        rw [hKf_cast, hg_cast]
        by_cases hl : l = i₀
        · subst hl; exact hcl_zero hi
        · exact hcl_other l hl hi
    · have : J' (Fin.last m) ⊆ {e₀} := hKf_last ▸ hJ'sub (Fin.last m)
      exact (Finset.card_le_card this).trans (by simp)
    · intro i
      refine (Finset.card_le_card (hJ'sub i.castSucc)).trans ?_
      rw [hKf_cast]
      by_cases hi : i = i₀
      · rw [hi, hK0, hμ]; omega
      · rw [hKne i hi, ← hcardJ i]; exact Finset.card_image_le
    · refine lt_of_le_of_lt (Finset.card_le_card (hJ'sub i₀.castSucc)) ?_
      rw [hKf_cast, hK0]; omega
  have hpt : ∀ w, ∃ (n : ℕ) (J : Fin (m + 1) → Finset (Fin n)),
      wcpaDjNCData Z' (m + 1) Dc' w n J ∧ ((J (Fin.last m)).card ≤ 1 ∧
        (∀ i : Fin m, (J i.castSucc).card ≤ μ i (π w)) ∧
        (J i₀.castSucc).card < R ∧ IsRegularLocalRing (Z'.presheaf.stalk w)) := by
    intro w
    by_cases hw : π w ∈ C
    · exact hon w hw
    · obtain ⟨n, J, hJ, hcard⟩ := hNC (π w)
      have hmem : π w ∈ V0 := by
        show π w ∈ (V0 : Set Z)
        rw [hset]; exact hw
      have hpre : ∀ i, Dc' i.castSucc ∩ ⇑π ⁻¹' (V0 : Set Z) =
          ⇑π ⁻¹' (Dc i) ∩ ⇑π ⁻¹' (V0 : Set Z) := by
        intro i; rw [hset]; exact hK i
      have hlast : w ∉ Dc' (Fin.last m) := by
        rw [hDlast]; exact hw
      obtain ⟨hJ', hr'⟩ :=
        wcpa_dj_sfb_offcentre π V0 m Dc Dc' w n J hπiso hmem hpre hlast hJ (hreg _)
      refine ⟨n, _, hJ', ?_, ?_, ?_, hr'⟩
      · simp
      · intro i; simp only [Fin.snoc_castSucc, hcard, le_refl]
      · simp only [Fin.snoc_castSucc, hcard]; exact hoff _ hw
  obtain ⟨μ', hμ'C, hμ'Q⟩ := hfin Z' Dc' (fun w ν => ν (Fin.last m) ≤ 1 ∧
    (∀ i : Fin m, ν i.castSucc ≤ μ i (π w)) ∧ ν i₀.castSucc < R ∧
    IsRegularLocalRing (Z'.presheaf.stalk w)) hcl hpt
  refine ⟨Z', iZ', π, Dc', μ', hπp, hπs, ⟨V0, ?_, hπiso⟩, fun w => (hμ'Q w).2.2.2, hπproj,
    hμ'C, ?_, fun w => (hμ'Q w).1, fun i w => (hμ'Q w).2.1 i, fun w => (hμ'Q w).2.2.1⟩
  · rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    refine ⟨genericPoint Z, ?_⟩
    show genericPoint Z ∈ (V0 : Set Z)
    rw [hset]; exact hgen
  · intro w hw
    simp only [Set.mem_preimage, Set.mem_iUnion] at hw ⊢
    obtain ⟨l, hl⟩ := hw
    by_cases hwC : π w ∈ C
    · refine ⟨Fin.last m, ?_⟩
      rw [hDlast]; exact hwC
    · refine ⟨l.castSucc, ?_⟩
      rw [hDcast]
      exact subset_closure ⟨hl, hwC⟩

theorem wcpa_dj_rn_strictify : ∀ (k : Type u) [Field k] (Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] (sZ : Z ⟶ Spec (.of k)) (B : Set Z), wcpaDjIsProjOver k sZ → (∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) → wcpaDjFmlNCSet Z B → B ≠ Set.univ → ∃ (Z' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Z') (φ : Z' ⟶ Z), IsProper φ ∧ Surjective φ ∧ (∃ V : Z.Opens, V ≠ ⊥ ∧ IsFinite (φ ∣_ V)) ∧ (∀ z : Z', IsRegularLocalRing (Z'.presheaf.stalk z)) ∧ wcpaDjIsProjOver k (φ ≫ sZ) ∧ ∃ B' : Set Z', wcpaDjZarNCSet Z' B' ∧ ⇑φ ⁻¹' B ⊆ B' :=
by
  intro k _ Z _ sZ B hproj hreg hB _
  classical
  have key : ∀ (R N : ℕ) (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (sY : Y ⟶ Spec (.of k))
      (m : ℕ) (Dc : Fin m → Set Y) (μ : Fin m → Y → ℕ) (S : Finset (Fin m)),
      wcpaDjIsProjOver k sY → (∀ y : Y, IsRegularLocalRing (Y.presheaf.stalk y)) →
      wcpaDjCompNC Y m Dc μ → (∀ i y, μ i y ≤ R) → (∀ i y, μ i y = R → i ∈ S) → S.card ≤ N →
      ∃ (Y' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y') (φ : Y' ⟶ Y), IsProper φ ∧
        Surjective φ ∧ (∃ V : Y.Opens, V ≠ ⊥ ∧ IsFinite (φ ∣_ V)) ∧
        (∀ y : Y', IsRegularLocalRing (Y'.presheaf.stalk y)) ∧ wcpaDjIsProjOver k (φ ≫ sY) ∧
        ∃ B' : Set Y', wcpaDjZarNCSet Y' B' ∧ ⇑φ ⁻¹' (⋃ i, Dc i) ⊆ B' := by
    intro R
    induction R using Nat.strong_induction_on with
    | _ R ihR =>
      intro N
      induction N using Nat.strong_induction_on with
      | _ N ihN =>
        intro Y _ sY m Dc μ S hYp hYr hC hle hS hSN
        by_cases hR : R ≤ 1
        · refine ⟨Y, inferInstance, 𝟙 Y, inferInstance, inferInstance, ⟨⊤, ?_, inferInstance⟩,
            hYr, ?_, ⋃ i, Dc i,
            wcpa_dj_sf_terminal Y m Dc μ hYr hC (fun i y => (hle i y).trans hR), ?_⟩
          · rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
            obtain ⟨y⟩ := (inferInstance : Nonempty Y)
            exact ⟨y, trivial⟩
          · rw [Category.id_comp]; exact hYp
          · intro y hy; simpa using hy
        · push_neg at hR
          by_cases hatt : ∃ i y, μ i y = R
          · obtain ⟨i₀, y₀, hi₀⟩ := hatt
            have hi₀S : i₀ ∈ S := hS i₀ y₀ hi₀
            obtain ⟨Y₁, iY₁, π, Dc', μ', hπp, hπs, ⟨V, hV, hVi⟩, hY₁r, hY₁p, hC', hsub, hlast,
              hcast, hi₀'⟩ := wcpa_dj_sf_blowup_step k Y sY m Dc μ R i₀ hYp hYr hC (by omega) hle
            haveI := iY₁
            have hle' : ∀ i w, μ' i w ≤ R := by
              intro i w
              induction i using Fin.lastCases with
              | last => exact (hlast w).trans (by omega)
              | cast i => exact (hcast i w).trans (hle i (π w))
            obtain ⟨S', hS'⟩ : ∃ S' : Finset (Fin (m + 1)),
                S' = (S.erase i₀).map Fin.castSuccEmb := ⟨_, rfl⟩
            have hS'att : ∀ i w, μ' i w = R → i ∈ S' := by
              intro i w h
              induction i using Fin.lastCases with
              | last => have := hlast w; omega
              | cast i =>
                have h1 := hcast i w
                have h2 := hle i (π w)
                have hne : i ≠ i₀ := by
                  intro hii
                  rw [hii] at h
                  have := hi₀' w
                  omega
                have hiS : i ∈ S := hS i (π w) (by omega)
                rw [hS']
                exact Finset.mem_map_of_mem _ (Finset.mem_erase.mpr ⟨hne, hiS⟩)
            have hS'card : S'.card < N := by
              rw [hS', Finset.card_map, Finset.card_erase_of_mem hi₀S]
              have := Finset.card_pos.mpr ⟨i₀, hi₀S⟩
              omega
            obtain ⟨Y₂, iY₂, φ', hφ'p, hφ's, hφ'f, hY₂r, hY₂p, B', hB', hsub'⟩ :=
              ihN S'.card hS'card Y₁ (π ≫ sY) (m + 1) Dc' μ' S' hY₁p hY₁r hC' hle' hS'att le_rfl
            haveI := iY₂
            have hVf : IsFinite (π ∣_ V) := by haveI := hVi; infer_instance
            obtain ⟨hsurj, hfin⟩ := wcpa_dj_alteration_comp π φ' hπp hπs hφ's ⟨V, hV, hVf⟩ hφ'f
            refine ⟨Y₂, iY₂, φ' ≫ π, ?_, hsurj, hfin, hY₂r, ?_, B', hB', ?_⟩
            · haveI := hπp; haveI := hφ'p; infer_instance
            · rw [Category.assoc]; exact hY₂p
            · intro y hy
              apply hsub'
              apply hsub
              rw [Set.mem_preimage, Scheme.Hom.comp_apply] at hy
              exact hy
          · push_neg at hatt
            have hle1 : ∀ i y, μ i y ≤ R - 1 := fun i y => by
              have := hle i y; have := hatt i y; omega
            exact ihR (R - 1) (by omega) m Y sY m Dc μ Finset.univ hYp hYr hC hle1
              (fun i _ _ => Finset.mem_univ i) (by simp)
  obtain ⟨m, Dc, μ, M, hC, hBeq, hM⟩ := wcpa_dj_sf_components k Z sZ B hproj hreg hB
  obtain ⟨Z', iZ', φ, h1, h2, h3, h4, h5, B', hB', hsub⟩ :=
    key M m Z sZ m Dc μ Finset.univ hproj hreg hC hM (fun i _ _ => Finset.mem_univ i) (by simp)
  refine ⟨Z', iZ', φ, h1, h2, h3, h4, h5, B', hB', ?_⟩
  rw [hBeq]
  exact hsub

theorem wcpa_dj_tr_resolve_nc : ∀ (k : Type u) [Field k] [Finite k] (S Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y] (sS : S ⟶ Spec (.of k)) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens) (D : Set S), wcpaDjIsProjOver k sS → wcpaDjIsProjOver k (g ≫ sS) → wcpaDjSplitSemistable g → wcpaDjSections g m τ → SmoothOfRelativeDimension 1 (g ∣_ W) → (W : Set S)ᶜ ⊆ D → (∀ p : S, IsRegularLocalRing (S.presheaf.stalk p)) → wcpaDjSNCSet S D → ∃ (Z : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Z) (φ : Z ⟶ Y), IsProper φ ∧ Surjective φ ∧ (∃ V : Y.Opens, V ≠ ⊥ ∧ IsFinite (φ ∣_ V)) ∧ (∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) ∧ wcpaDjIsProjOver k (φ ≫ g ≫ sS) ∧ ∃ B : Set Z, wcpaDjZarNCSet Z B ∧ ⇑φ ⁻¹' (⇑g ⁻¹' D ∪ ⋃ j, Set.range ⇑(τ j)) ⊆ B :=
by
  intro k _ _ S Y _ _ sS g m τ W D hS hY hss hsec hsm hW hreg hD
  classical

  obtain ⟨mD, Dc, hDc, hDeq, hloc⟩ := id hD
  have hDcl : IsClosed D := by
    rw [hDeq]
    exact isClosed_iUnion_of_finite hDc
  have hgen : ∀ i, genericPoint S ∉ Dc i := by
    intro i hi
    obtain ⟨n, t, hn, -, a, -, -⟩ := hloc (genericPoint S)
    have h0 : ringKrullDim (S.presheaf.stalk (genericPoint S)) = 0 := by
      change ringKrullDim S.functionField = 0
      exact ringKrullDim_eq_zero_of_field _
    rw [h0] at hn
    have hn0 : n = 0 := by exact_mod_cast hn
    subst hn0
    exact Fin.elim0 (a ⟨i, hi⟩)
  have hDne : D ≠ Set.univ := by
    intro h
    have hmem : genericPoint S ∈ D := by rw [h]; trivial
    rw [hDeq, Set.mem_iUnion] at hmem
    obtain ⟨i, hi⟩ := hmem
    exact hgen i hi

  have hMN := wcpa_dj_rn_monomial_nodes S Y g W D hss hsm hW hreg hD

  obtain ⟨Z₁, iZ₁, φ₁, hp₁, hs₁, hf₁, hr₁, hproj₁, B₁, hB₁, hsub₁⟩ :=
    wcpa_dj_rn_toroidal_snc k S Y sS g m τ D hS hY hss.1 hss.2.1 hsec hDcl hDne hreg hMN hD
  haveI := iZ₁

  have hB₁ne : B₁ ≠ Set.univ := by
    intro h
    obtain ⟨-, hloc₁⟩ := hB₁
    obtain ⟨n, s, J, f, hn, -, hass, hiff⟩ := hloc₁ (genericPoint Z₁)
    have h0 : ringKrullDim (Z₁.presheaf.stalk (genericPoint Z₁)) = 0 := by
      change ringKrullDim Z₁.functionField = 0
      exact ringKrullDim_eq_zero_of_field _
    rw [h0] at hn
    have hn0 : n = 0 := by exact_mod_cast hn
    subst hn0
    rw [Finset.eq_empty_of_isEmpty J, Finset.prod_empty] at hass
    have hu := (associated_one_iff_isUnit.mp hass).map
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal (Z₁.presheaf.stalk (genericPoint Z₁))) 1)
    have hmem : genericPoint Z₁ ∈ B₁ := by rw [h]; trivial
    have hf := (hiff (genericPoint Z₁) (specializes_refl _)).mp hmem
    rw [TopCat.Presheaf.stalkSpecializes_refl] at hf
    have hf1 : f ∈ IsLocalRing.maximalIdeal (Z₁.presheaf.stalk (genericPoint Z₁)) ^ 1 := by
      rw [pow_one]; exact hf
    rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.mpr hf1,
      isUnit_zero_iff, Ideal.Quotient.zero_eq_one_iff, pow_one] at hu
    exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top hu

  obtain ⟨Z, iZ, φ₂, hp₂, hs₂, hf₂, hr₂, hproj₂, B, hB, hsub₂⟩ :=
    wcpa_dj_rn_strictify k Z₁ (φ₁ ≫ g ≫ sS) B₁ hproj₁ hr₁ hB₁ hB₁ne
  haveI := iZ
  obtain ⟨hsurj, hfin⟩ := wcpa_dj_alteration_comp φ₁ φ₂ hp₁ hs₁ hs₂ hf₁ hf₂
  refine ⟨Z, iZ, φ₂ ≫ φ₁, ?_, hsurj, hfin, hr₂, ?_, B, hB, ?_⟩
  · haveI := hp₁
    haveI := hp₂
    infer_instance
  · rw [Category.assoc]
    exact hproj₂
  · intro z hz
    rw [Set.mem_preimage, Scheme.Hom.comp_apply] at hz
    exact hsub₂ (hsub₁ hz)

theorem wcpa_dj_tr_nc_is_snc : ∀ (k : Type u) [Field k] (Z : Scheme.{u}) (sZ : Z ⟶ Spec (.of k)) (B : Set Z), wcpaDjIsProjOver k sZ → wcpaDjZarNCSet Z B → wcpaDjSNCSet Z B :=
by
  classical

  have s1 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (n : ℕ)
      (t : Fin n → R), (n : WithBot ℕ∞) = ringKrullDim R →
      Ideal.span (Set.range t) = IsLocalRing.maximalIdeal R →
      ∀ j : Fin n, IsRegularLocalRing (R ⧸ Ideal.span {t j}) := by
    intro R _ _ _ n t hdim hspan j
    set I := Ideal.span {t j} with hI
    have htj : t j ∈ IsLocalRing.maximalIdeal R := hspan ▸ Ideal.subset_span ⟨j, rfl⟩
    have hIm : I ≤ IsLocalRing.maximalIdeal R := (Ideal.span_singleton_le_iff_mem _).mpr htj
    have hIne : I ≠ ⊤ := fun h =>
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_le_iff.mp (h ▸ hIm))
    haveI : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hIne
    haveI : IsLocalRing (R ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    haveI : IsNoetherianRing (R ⧸ I) := Ideal.Quotient.isNoetherianRing I
    have hk : Ideal.comap (Ideal.Quotient.mk I) ⊥ = I := by
      rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
    have hmax : IsLocalRing.maximalIdeal (R ⧸ I) =
        Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal R) := by
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk I)
        Ideal.Quotient.mk_surjective (IsLocalRing.maximalIdeal.isMaximal R) with h | h
      · exfalso
        have := Ideal.comap_map_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
          (IsLocalRing.maximalIdeal R)
        rw [h, Ideal.comap_top, hk, sup_eq_left.mpr hIm] at this
        exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top this.symm
      · exact (IsLocalRing.eq_maximalIdeal h).symm
    set S : Finset (R ⧸ I) := (Finset.univ.erase j).image (fun i => Ideal.Quotient.mk I (t i))
      with hS
    have hspanS : IsLocalRing.maximalIdeal (R ⧸ I) = Ideal.span (S : Set (R ⧸ I)) := by
      rw [hmax, ← hspan, Ideal.map_span]
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro x ⟨r, ⟨i, rfl⟩, rfl⟩
        by_cases hij : i = j
        · subst hij
          have : Ideal.Quotient.mk I (t i) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [this]
          exact (Ideal.span _).zero_mem
        · apply Ideal.subset_span
          rw [hS, Finset.coe_image]
          exact ⟨i, by simp [hij], rfl⟩
      · apply Ideal.span_mono
        intro x hx
        rw [hS, Finset.coe_image] at hx
        obtain ⟨i, _, rfl⟩ := hx
        exact ⟨t i, ⟨i, rfl⟩, rfl⟩
    have hsf : Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ I)) ≤ n - 1 := by
      rw [hspanS]
      refine (Submodule.spanFinrank_span_le_ncard_of_finite (S.finite_toSet)).trans ?_
      rw [Set.ncard_coe_finset]
      refine Finset.card_image_le.trans ?_
      rw [Finset.card_erase_of_mem (Finset.mem_univ j), Finset.card_univ, Fintype.card_fin]
    have hd1 := ringKrullDim_le_spanFinrank_maximalIdeal (R ⧸ I)
    have hjac : (({t j} : Finset R) : Set R) ⊆ (Ring.jacobson R : Set R) := by
      rw [Finset.coe_singleton, Set.singleton_subset_iff, ← Ideal.jacobson_bot]
      exact IsLocalRing.maximalIdeal_le_jacobson ⊥ htj
    have hd2 := ringKrullDim_le_ringKrullDim_quotient_add_card ({t j} : Finset R) hjac
    rw [Finset.coe_singleton, Finset.card_singleton, ← hdim] at hd2
    change (n : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ I) + ((1 : ℕ) : WithBot ℕ∞) at hd2
    have h0 : (0 : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ I) := ringKrullDim_nonneg_of_nontrivial
    have hne_bot : ringKrullDim (R ⧸ I) ≠ ⊥ := by
      intro h
      rw [h] at h0
      exact absurd h0 (by simp)
    obtain ⟨e, he⟩ := WithBot.ne_bot_iff_exists.mp hne_bot
    rw [← he] at hd1 hd2
    have he_top : e ≠ ⊤ := by
      rintro rfl
      have h' : ((⊤ : ℕ∞) : WithBot ℕ∞) ≤
          ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ I)) : ℕ∞) : WithBot ℕ∞) := hd1
      rw [WithBot.coe_le_coe] at h'
      exact absurd h' (by simp)
    obtain ⟨d, rfl⟩ := ENat.ne_top_iff_exists.mp he_top
    have ed : ((d : ℕ∞) : WithBot ℕ∞) = (d : WithBot ℕ∞) := by norm_cast
    rw [ed] at hd1 hd2
    have hd1' : d ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ I)) := by
      exact_mod_cast hd1
    have hd2' : n ≤ d + 1 := by exact_mod_cast hd2
    have hn := j.pos
    have hfin : Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ I)) = d := by omega
    refine IsRegularLocalRing.mk ?_
    rw [← he, ed, hfin]

  have s3 : ∀ (X : Scheme.{u}) (y : X) (P : Ideal (X.presheaf.stalk y)), P.IsPrime →
      ∃ η : X, η ⤳ y ∧ ∀ (y' : X) (h : y' ⤳ y), (η ⤳ y' ↔ P ≤ Ideal.comap
        (X.presheaf.stalkSpecializes h).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk y'))) := by
    intro X y P hP
    have hind : Topology.IsInducing (X.fromSpecStalk y) :=
      (Scheme.Hom.isEmbedding (X.fromSpecStalk y)).isInducing
    let p : Spec (X.presheaf.stalk y) := (⟨P, hP⟩ : PrimeSpectrum (X.presheaf.stalk y))
    refine ⟨X.fromSpecStalk y p, ?_, ?_⟩
    · have : X.fromSpecStalk y p ∈ Set.range (X.fromSpecStalk y) := ⟨_, rfl⟩
      rw [Scheme.range_fromSpecStalk] at this
      exact this
    · intro y' h
      let c : Spec (X.presheaf.stalk y') := IsLocalRing.closedPoint (X.presheaf.stalk y')
      let q : Spec (X.presheaf.stalk y) := Spec.map (X.presheaf.stalkSpecializes h) c
      have hfq : X.fromSpecStalk y q = y' := by
        have := Scheme.Hom.comp_apply (Spec.map (X.presheaf.stalkSpecializes h))
          (X.fromSpecStalk y) c
        rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk] at this
        rw [← this]
        exact Scheme.fromSpecStalk_closedPoint
      have hqI : (q : PrimeSpectrum (X.presheaf.stalk y)).asIdeal = Ideal.comap
          (X.presheaf.stalkSpecializes h).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk y')) := by
        have e1 : q = PrimeSpectrum.comap (X.presheaf.stalkSpecializes h).hom c :=
          Spec.map_apply (X.presheaf.stalkSpecializes h) c
        rw [e1, PrimeSpectrum.comap_asIdeal]
        rfl
      have key : p ⤳ q ↔ P ≤ Ideal.comap
          (X.presheaf.stalkSpecializes h).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk y')) := by
        rw [← hqI]
        exact (PrimeSpectrum.le_iff_specializes (⟨P, hP⟩ : PrimeSpectrum (X.presheaf.stalk y))
          (q : PrimeSpectrum (X.presheaf.stalk y))).symm.trans
          (PrimeSpectrum.asIdeal_le_asIdeal _ _).symm
      rw [← key, ← hind.specializes_iff, hfq]

  have s4 : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X]
      [QuasiSober X] (B : Set X), IsClosed B → ∃ (m : ℕ) (Dc : Fin m → Set X) (ξ : Fin m → X),
      (∀ i, IsClosed (Dc i)) ∧ B = ⋃ i, Dc i ∧ (∀ i w, ξ i ⤳ w ↔ w ∈ Dc i) ∧
      (∀ i i', Dc i ⊆ Dc i' → i = i') := by
    intro X _ _ _ B hB
    obtain ⟨S, hSf, hScl, hSirr, hBS⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hB
    set S' : Set (Set X) := {t | t ∈ S ∧ Maximal (· ∈ S) t} with hS'
    have hS'f : S'.Finite := hSf.subset (fun t ht => ht.1)
    haveI := hS'f.fintype
    let e := Fintype.equivFin S'
    refine ⟨Fintype.card S', fun i => (e.symm i).1,
      fun i => (hSirr _ (e.symm i).2.1).genericPoint, fun i => hScl _ (e.symm i).2.1, ?_, ?_, ?_⟩
    · ext x
      simp only [Set.mem_iUnion]
      constructor
      · intro hx
        rw [hBS] at hx
        obtain ⟨t, ht, hxt⟩ := Set.mem_sUnion.mp hx
        obtain ⟨t', htt', ht'max⟩ := hSf.exists_le_maximal ht
        refine ⟨e ⟨t', ht'max.prop, ht'max⟩, ?_⟩
        rw [Equiv.symm_apply_apply]
        exact htt' hxt
      · rintro ⟨i, hi⟩
        rw [hBS]
        exact Set.mem_sUnion.mpr ⟨_, (e.symm i).2.1, hi⟩
    · intro i w
      exact isGenericPoint_iff_specializes.mp
        ((hSirr _ (e.symm i).2.1).isGenericPoint_genericPoint (hScl _ (e.symm i).2.1)) w
    · intro i i' hii'
      have h1 := (e.symm i).2.2.2 (e.symm i').2.1 hii'
      have : e.symm i = e.symm i' := Subtype.ext (le_antisymm hii' h1)
      exact e.symm.injective this

  have s5 : ∀ (X : Type u) [TopologicalSpace X] [T0Space X] (m n : ℕ) (Dc : Fin m → Set X)
      (ξ : Fin m → X) (y : X) (Q : (y' : X) → y' ⤳ y → Fin n → Prop) (η : Fin n → X)
      (J : Finset (Fin n)), (∀ i w, ξ i ⤳ w ↔ w ∈ Dc i) → (∀ i i', Dc i ⊆ Dc i' → i = i') →
      (∀ j, η j ⤳ y) → (∀ j (y' : X) (h : y' ⤳ y), (η j ⤳ y' ↔ Q y' h j)) →
      (∀ (y' : X) (h : y' ⤳ y), (y' ∈ ⋃ i, Dc i ↔ ∃ j ∈ J, Q y' h j)) →
      ∃ a : {i : Fin m // y ∈ Dc i} → Fin n, Function.Injective a ∧
        ∀ (i : {i : Fin m // y ∈ Dc i}) (y' : X) (h : y' ⤳ y), (y' ∈ Dc i.1 ↔ Q y' h (a i)) := by
    intro X _ _ m n Dc ξ y Q η J hξ hinc hηy hη hB
    have gi : ∀ i : {i : Fin m // y ∈ Dc i}, ξ i.1 ⤳ y := fun i => (hξ i.1 y).mpr i.2
    have hex : ∀ i : {i : Fin m // y ∈ Dc i}, ∃ j ∈ J, Q (ξ i.1) (gi i) j := by
      intro i
      apply (hB (ξ i.1) (gi i)).mp
      exact Set.mem_iUnion.mpr ⟨i.1, (hξ i.1 (ξ i.1)).mp specializes_rfl⟩
    choose a haJ ha using hex
    have hA : ∀ i, ξ i.1 = η (a i) := by
      intro i
      have h1 : η (a i) ⤳ ξ i.1 := (hη (a i) (ξ i.1) (gi i)).mpr (ha i)
      have h2 : η (a i) ∈ ⋃ i, Dc i := (hB (η (a i)) (hηy (a i))).mpr
        ⟨a i, haJ i, (hη (a i) (η (a i)) (hηy (a i))).mp specializes_rfl⟩
      obtain ⟨i', hi'⟩ := Set.mem_iUnion.mp h2
      have hsub : Dc i.1 ⊆ Dc i' := by
        intro w hw
        exact (hξ i' w).mp ((((hξ i' (η (a i))).mpr hi').trans h1).trans ((hξ i.1 w).mpr hw))
      have hii' := hinc _ _ hsub
      rw [← hii'] at hi'
      exact (((hξ i.1 _).mpr hi').antisymm h1).eq
    refine ⟨a, ?_, ?_⟩
    · intro i₁ i₂ h12
      have he : ξ i₁.1 = ξ i₂.1 := by rw [hA i₁, hA i₂, h12]
      apply Subtype.ext
      apply hinc
      intro w hw
      have : ξ i₁.1 ⤳ w := (hξ i₁.1 w).mpr hw
      rw [he] at this
      exact (hξ i₂.1 w).mp this
    · intro i y' h
      rw [← hη (a i) y' h, ← hA i]
      exact (hξ i.1 y').symm

  intro k _ Z sZ B hproj hNC
  obtain ⟨hBcl, hNC⟩ := hNC
  haveI : IsProper sZ := wcpa_dj_proj_proper k sZ hproj
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian sZ
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace sZ
  haveI : AlgebraicGeometry.IsNoetherian Z := {}
  obtain ⟨m, Dc, ξ, hcl, hBU, hξ, hinc⟩ := s4 Z B hBcl
  refine ⟨m, Dc, hcl, hBU, fun y => ?_⟩
  obtain ⟨n, t, hdim, hspan, J, hiff⟩ := hNC y
  have hprime : ∀ j, (Ideal.span {t j}).IsPrime := fun j => by
    haveI hreg := s1 _ n t hdim hspan j
    haveI hdom := wcpa_regular_isDomain _ wcpa_rs_quotient_regular hreg
    exact (Ideal.Quotient.isDomain_iff_prime _).mp hdom
  choose η hηy hη' using fun j => s3 Z y _ (hprime j)
  refine ⟨n, t, hdim, hspan, ?_⟩
  exact s5 Z m n Dc ξ y
    (fun y' h j => (Z.presheaf.stalkSpecializes h).hom (t j) ∈
      IsLocalRing.maximalIdeal (Z.presheaf.stalk y')) η J hξ hinc hηy
    (fun j y' h => (hη' j y' h).trans
      ((Ideal.span_singleton_le_iff_mem _).trans Ideal.mem_comap))
    (fun y' h => by rw [← hBU]; exact hiff y' h)

theorem wcpa_dj_toroidal_resolution : ∀ (k : Type u) [Field k] [Finite k] (P' P'' C : Scheme.{u})
    [AlgebraicGeometry.IsIntegral P'] [AlgebraicGeometry.IsIntegral P'']
    [AlgebraicGeometry.IsIntegral C]
    (sP' : P' ⟶ Spec (.of k)) (sP'' : P'' ⟶ Spec (.of k)) (β : P'' ⟶ P') (g : C ⟶ P')
    (m : ℕ) (τ : Fin m → (P' ⟶ C)) (U' : P'.Opens) (D : Set P''),
    β ≫ sP' = sP'' → wcpaDjIsProjOver k sP' → wcpaDjIsProjOver k sP'' →
    wcpaDjIsProjOver k (g ≫ sP') →
    wcpaDjSplitSemistable g → wcpaDjSections g m τ → U' ≠ ⊥ →
    SmoothOfRelativeDimension 1 (g ∣_ U') → GeometricallyConnected (g ∣_ U') →
    (∀ p : P'', IsRegularLocalRing (P''.presheaf.stalk p)) →
    IsProper β → Surjective β → (∃ V : P'.Opens, V ≠ ⊥ ∧ IsFinite (β ∣_ V)) →
    wcpaDjSNCSet P'' D → ⇑β ⁻¹' ((U' : Set P')ᶜ) ⊆ D →
    ∃ (Z : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Z) (sZ : Z ⟶ Spec (.of k)) (ψ : Z ⟶ C),
      ψ ≫ g ≫ sP' = sZ ∧ IsProper sZ ∧ (∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) ∧
      IsProper ψ ∧ Surjective ψ ∧ (∃ V : C.Opens, V ≠ ⊥ ∧ IsFinite (ψ ∣_ V)) ∧
      wcpaDjIsProjOver k sZ ∧ ∃ DZ : Set Z, wcpaDjSNCSet Z DZ ∧
        ⇑ψ ⁻¹' ((⋃ j, Set.range ⇑(τ j)) ∪ ⇑g ⁻¹' ((U' : Set P')ᶜ)) ⊆ DZ :=
by
  intro k _ _ P' P'' C _ _ _ sP' sP'' β g m τ U' D hβ hP'proj hP''proj hCproj hss hsec hU'ne
    hU'sm hU'gc hreg'' hβprop hβsurj hβfin hD hDE
  classical

  haveI hC''int : AlgebraicGeometry.IsIntegral (Limits.pullback g β) :=
    wcpa_dj_tr_basechange_integral P' P'' C β g U' hss.1 hβsurj hU'ne hU'sm hU'gc
  obtain ⟨hprprop, hprsurj, hprfin⟩ :=
    wcpa_dj_tr_basechange_alteration P' P'' C β g hss.1 hβprop hβsurj hβfin
  have hss'' := wcpa_dj_tr_basechange_semistable P' P'' C β g hss
  obtain ⟨τ'', hsec'', hτpre⟩ := wcpa_dj_tr_basechange_sections P' P'' C β g m τ hsec
  have hsm'' := wcpa_dj_tr_basechange_smooth P' P'' C β g U' hU'sm
  have hC''proj := wcpa_dj_tr_basechange_proj k P' P'' C sP' sP'' β g hβ hP'proj hP''proj hCproj
  have hW : ((β ⁻¹ᵁ U' : P''.Opens) : Set P'')ᶜ ⊆ D := by
    intro p hp
    exact hDE hp

  obtain ⟨Z, iZ, φ₁, hφ₁prop, hφ₁surj, hφ₁fin, hregZ, hZproj, B, hB, hφ₁B⟩ :=
    wcpa_dj_tr_resolve_nc k P'' (Limits.pullback g β) sP'' (Limits.pullback.snd g β) m τ''
      (β ⁻¹ᵁ U') D hP''proj hC''proj hss'' hsec'' hsm'' hW hreg'' hD
  haveI := iZ

  have hBsnc : wcpaDjSNCSet Z B :=
    wcpa_dj_tr_nc_is_snc k Z (φ₁ ≫ Limits.pullback.snd g β ≫ sP'') B hZproj hB
  have heq : φ₁ ≫ Limits.pullback.snd g β ≫ sP'' =
      (φ₁ ≫ Limits.pullback.fst g β) ≫ g ≫ sP' := by
    rw [← hβ, ← Category.assoc (Limits.pullback.snd g β), ← Limits.pullback.condition]
    simp only [Category.assoc]
  have hZproj' : wcpaDjIsProjOver k ((φ₁ ≫ Limits.pullback.fst g β) ≫ g ≫ sP') := by
    rw [← heq]; exact hZproj
  have hsZprop : IsProper ((φ₁ ≫ Limits.pullback.fst g β) ≫ g ≫ sP') :=
    wcpa_dj_proj_proper k _ hZproj'
  have hψprop : IsProper (φ₁ ≫ Limits.pullback.fst g β) := by
    haveI := hφ₁prop
    haveI := hprprop
    infer_instance
  obtain ⟨hψsurj, hψfin⟩ :=
    wcpa_dj_alteration_comp (Limits.pullback.fst g β) φ₁ hprprop hprsurj hφ₁surj hprfin hφ₁fin
  refine ⟨Z, iZ, (φ₁ ≫ Limits.pullback.fst g β) ≫ g ≫ sP',
    φ₁ ≫ Limits.pullback.fst g β, rfl, hsZprop, hregZ, hψprop, hψsurj, hψfin, hZproj',
    B, hBsnc, ?_⟩
  intro z hz
  rw [Set.mem_preimage, Scheme.Hom.comp_apply] at hz
  have hmem : φ₁ z ∈ ⇑(Limits.pullback.snd g β) ⁻¹' D ∪ ⋃ j, Set.range ⇑(τ'' j) := by
    rcases hz with h | h
    · exact Or.inr (hτpre h)
    · left
      have hcond : (Limits.pullback.snd g β ≫ β) (φ₁ z) =
          (Limits.pullback.fst g β ≫ g) (φ₁ z) := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hcond
      apply hDE
      show β (Limits.pullback.snd g β (φ₁ z)) ∈ (U' : Set P')ᶜ
      rw [hcond]
      exact h
  exact hφ₁B hmem

theorem wcpa_dejong_regular_projective_alteration : ∀ (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ)
    [SmoothOfRelativeDimension d X.hom],
    ∃ (Z : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Z) (sZ : Z ⟶ Spec (.of F)) (_ : IsProper sZ)
      (_ : ∀ z : Z, IsRegularLocalRing (Z.presheaf.stalk z)) (φ : Z ⟶ X.left),
      φ ≫ X.hom = sZ ∧ Surjective φ ∧ (∃ V : X.left.Opens, V ≠ ⊥ ∧ IsFinite (φ ∣_ V)) ∧
      ∃ (N : ℕ) (jZ : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion jZ ∧
        jZ ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0))) = sZ :=
by
  intro F _ _ X _ _ d _
  classical

  haveI hirr : IrreducibleSpace X.left :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (𝟙 (Spec (.of F))) (𝟙 X.left) X.hom
      IsPullback.of_id_fst
  haveI hstred : ∀ x : X.left, _root_.IsReduced (X.left.presheaf.stalk x) := fun x => by
    haveI := wcpa_smooth_stalk_isDomain F X.left X.hom d x
    infer_instance
  haveI hred : IsReduced X.left := isReduced_of_isReduced_stalk X.left
  haveI hint : AlgebraicGeometry.IsIntegral X.left :=
    isIntegral_of_irreducibleSpace_of_isReduced X.left

  obtain ⟨n, hn⟩ := wcpa_dj_dim_finite F X.left X.hom

  have hQ : ∀ n : ℕ, ∀ (k : Type u) [Field k] [Finite k] (Y : Scheme.{u})
      [AlgebraicGeometry.IsIntegral Y] (sY : Y ⟶ Spec (.of k)) [IsProper sY],
      topologicalKrullDim Y = ((n : ℕ) : WithBot ℕ∞) →
      ∀ E : Set Y, IsClosed E → E ≠ Set.univ → wcpaDjSNCAlteration k Y sY E := by
    intro n
    induction n with
    | zero =>
      intro k _ _ Y _ sY _ hY E hE hEne
      exact wcpa_dj_base_case k Y sY hY E hE hEne
    | succ n ih =>
      intro k _ _ Y _ sY _ hY E hE hEne

      obtain ⟨X₀, P₀, iX₀, iP₀, α₀, sP₀, f₀, hf₀, hX₀, hP₀, hα₀p, hα₀s, hα₀f, hP₀d,
        U₀, hU₀, hU₀sm, hU₀gc⟩ := wcpa_dj_curve_fibration k Y sY n hY
      haveI := iX₀
      haveI := iP₀
      obtain ⟨X₁, P, iX₁, iP, α, sP, f, hfα, hX₁proj, hPproj, hαprop, hαsurj, hαfin, hPdim,
        U, hU, hUsm, hUgc, hGS⟩ := wcpa_dj_cf_gs_upgrade k Y sY n hY X₀ P₀ α₀ sP₀ f₀ hf₀ hX₀ hP₀
          hα₀p hα₀s hα₀f hP₀d U₀ hU₀ hU₀sm hU₀gc
      haveI := iX₁
      haveI := iP

      have hTcl : IsClosed (⇑α ⁻¹' E) := hE.preimage α.continuous
      have hTne : ⇑α ⁻¹' E ≠ Set.univ := by
        intro hT
        apply hEne
        apply Set.eq_univ_of_forall
        intro x
        haveI := hαsurj
        obtain ⟨y, hy⟩ := α.surjective x
        have hy' : y ∈ ⇑α ⁻¹' E := by rw [hT]; exact Set.mem_univ y
        rw [← hy]
        exact hy'

      have hfproj : wcpaDjIsProjOver k (f ≫ sP) := by rw [hfα]; exact hX₁proj
      obtain ⟨P', iP', sP', β₀, hβ₀, hP'proj, hβ₀prop, hβ₀surj, hβ₀fin, C, iC, g, h, hgh, hCproj,
        hss, hhprop, hhsurj, hhfin, U', m, τ, hU'ne, hU'sm, hU'gc, hsec, hT⟩ :=
        wcpa_dj_semistable_reduction k X₁ P sP f hfproj hPproj U hU hUsm hUgc hGS n hPdim ih
          (⇑α ⁻¹' E) hTcl hTne
      haveI := iP'
      haveI := iC

      haveI hsPprop : IsProper sP := wcpa_dj_proj_proper k sP hPproj
      haveI hsP'prop : IsProper sP' := wcpa_dj_proj_proper k sP' hP'proj
      have hP'dim : topologicalKrullDim P' = ((n : ℕ) : WithBot ℕ∞) :=
        (wcpa_dj_alteration_dim_eq k P' P sP' sP β₀ hβ₀ hβ₀surj hβ₀fin).trans hPdim

      have hE'cl : IsClosed ((U' : Set P')ᶜ) := U'.isOpen.isClosed_compl
      have hE'ne : (U' : Set P')ᶜ ≠ Set.univ := by
        intro h0
        obtain ⟨p, hp⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U').mp hU'ne
        have hp' : p ∈ (U' : Set P')ᶜ := by rw [h0]; exact Set.mem_univ p
        exact hp' hp
      obtain ⟨P'', iP'', sP'', β, hβ, hsP''prop, hreg'', hβprop, hβsurj, hβfin, hP''proj,
        D, hD, hDE⟩ := ih k P' sP' hP'dim _ hE'cl hE'ne
      haveI := iP''

      obtain ⟨Z, iZ, sZ, ψ, hψ, hsZprop, hregZ, hψprop, hψsurj, hψfin, hZproj, DZ, hDZ, hψD⟩ :=
        wcpa_dj_toroidal_resolution k P' P'' C sP' sP'' β g m τ U' D hβ hP'proj hP''proj hCproj
          hss hsec hU'ne hU'sm hU'gc hreg'' hβprop hβsurj hβfin hD hDE

      obtain ⟨hhαsurj, hhαfin⟩ := wcpa_dj_alteration_comp α h hαprop hαsurj hhsurj hαfin hhfin
      have hhαprop : IsProper (h ≫ α) := by
        haveI := hhprop
        haveI := hαprop
        infer_instance
      obtain ⟨hφsurj, hφfin⟩ :=
        wcpa_dj_alteration_comp (h ≫ α) ψ hhαprop hhαsurj hψsurj hhαfin hψfin
      have hφprop : IsProper (ψ ≫ h ≫ α) := by
        haveI := hψprop
        haveI := hhαprop
        infer_instance
      refine ⟨Z, iZ, sZ, ψ ≫ h ≫ α, ?_, hsZprop, hregZ, hφprop, hφsurj, hφfin, hZproj, DZ, hDZ, ?_⟩
      · rw [Category.assoc, Category.assoc, ← hfα, ← Category.assoc h f sP, hgh, Category.assoc,
          hβ₀, hψ]
      · intro z hz
        have hz' : ψ z ∈ ⇑h ⁻¹' (⇑α ⁻¹' E) := by
          rw [Set.mem_preimage, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hz
          exact hz
        exact hψD (hT hz')

  have hne : (∅ : Set X.left) ≠ Set.univ := by
    intro h0
    obtain ⟨x⟩ := (inferInstance : Nonempty X.left)
    have hx : x ∈ (∅ : Set X.left) := by rw [h0]; exact Set.mem_univ x
    exact hx
  obtain ⟨Z, iZ, sZ, φ, hφ, hsZ, hreg, _, hsurj, hfin, ⟨N, jZ, hjZ, hjZeq⟩, _⟩ :=
    hQ n F X.left X.hom hn ∅ isClosed_empty hne
  exact ⟨Z, iZ, sZ, hsZ, hreg, φ, hφ, hsurj, hfin, N, jZ, hjZ, hjZeq⟩

theorem wcpa_smooth_descend_finite_separable : ∀ (F F' : Type u) [Field F] [Finite F] [Field F']
    [Algebra F F'] [FiniteDimensional F F'] (Z : Scheme.{u}) (t : Z ⟶ Spec (.of F')) (d : ℕ),
    SmoothOfRelativeDimension d (t ≫ Spec.map (CommRingCat.ofHom (algebraMap F F'))) →
    SmoothOfRelativeDimension d t :=
by
  intro F F' _ _ _ _ _ Z t d hf
  set g := Spec.map (CommRingCat.ofHom (algebraMap F F')) with hg
  haveI : FormallyUnramified g := HasRingHomProperty.Spec_iff.mpr (by
    rw [CommRingCat.hom_ofHom]
    exact RingHom.formallyUnramified_algebraMap.mpr (Algebra.FormallyUnramified.of_isSeparable F F'))
  haveI : LocallyOfFiniteType g := HasRingHomProperty.Spec_iff.mpr (by
    rw [CommRingCat.hom_ofHom]
    exact RingHom.finiteType_algebraMap.mpr inferInstance)
  haveI hγ : IsOpenImmersion (Limits.pullback.lift (𝟙 Z) t (by simp) :
      Z ⟶ Limits.pullback (t ≫ g) g) :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion)
      (Limits.pullback_lift_diagonal_isPullback t g)
      (FormallyUnramified.isOpenImmersion_diagonal g)
  haveI : SmoothOfRelativeDimension d (Limits.pullback.snd (t ≫ g) g) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback _ _) hf
  have key := smoothOfRelativeDimension_comp 0 d
    (Limits.pullback.lift (𝟙 Z) t (by simp) : Z ⟶ Limits.pullback (t ≫ g) g)
    (Limits.pullback.snd (t ≫ g) g)
  rw [Limits.pullback.lift_snd, Nat.zero_add] at key
  exact key

theorem wcpa_lift_surjective : ∀ (F F' : Type u) [Field F] [Field F'] [Algebra F F']
    [FiniteDimensional F F'] (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom]
    [IsProper X.hom] (Z : Scheme.{u}) [IrreducibleSpace Z] (t : Z ⟶ Spec (.of F')) [IsProper t]
    (φ : Z ⟶ X.left) [Surjective φ]
    (hφ : φ ≫ X.hom = t ≫ Spec.map (CommRingCat.ofHom (algebraMap F F'))),
    Surjective (Limits.pullback.lift φ t hφ) :=
by
  intro F F' _ _ _ _ X _ _ Z _ t _ φ _ hφ
  set g := Spec.map (CommRingCat.ofHom (algebraMap F F')) with hg
  set ψ := Limits.pullback.lift φ t hφ with hψ
  haveI hgfin : IsFinite g :=
    (IsFinite.SpecMap_iff (CommRingCat.ofHom (algebraMap F F'))).mpr
      (RingHom.finite_algebraMap.mpr inferInstance)
  haveI hfst : IsFinite (Limits.pullback.fst X.hom g) :=
    MorphismProperty.of_isPullback (P := @IsFinite) (IsPullback.of_hasPullback X.hom g).flip hgfin
  haveI hirr : IrreducibleSpace (Limits.pullback X.hom g : Scheme.{u}) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom) g
      (Limits.pullback.fst X.hom g) (Limits.pullback.snd X.hom g)
      (IsPullback.of_hasPullback X.hom g)
  haveI : IsProper (ψ ≫ Limits.pullback.snd X.hom g) := by
    rw [hψ, Limits.pullback.lift_snd]; infer_instance
  haveI : IsProper ψ := IsProper.of_comp ψ (Limits.pullback.snd X.hom g)
  have hclosed : IsClosed (Set.range ψ) := ψ.isClosedMap.isClosed_range
  have hfib : ∀ a b : (Limits.pullback X.hom g : Scheme.{u}), a ⤳ b →
      Limits.pullback.fst X.hom g a = Limits.pullback.fst X.hom g b → a = b := by
    intro a b hab he
    haveI : DiscreteTopology ↑(Limits.pullback.fst X.hom g ⁻¹'
        {Limits.pullback.fst X.hom g b}) :=
      ((Limits.pullback.fst X.hom g).fiberHomeo (Limits.pullback.fst X.hom g b)).discreteTopology
    let a' : ↑(Limits.pullback.fst X.hom g ⁻¹' {Limits.pullback.fst X.hom g b}) := ⟨a, he⟩
    let b' : ↑(Limits.pullback.fst X.hom g ⁻¹' {Limits.pullback.fst X.hom g b}) := ⟨b, rfl⟩
    have h1 : a' ⤳ b' := Topology.IsInducing.subtypeVal.specializes_iff.mp hab
    exact congrArg Subtype.val h1.eq
  refine ⟨fun y => ?_⟩
  obtain ⟨z, hz⟩ := φ.surjective
    (Limits.pullback.fst X.hom g (genericPoint (Limits.pullback X.hom g : Scheme.{u})))
  have hz' : Limits.pullback.fst X.hom g (ψ z) =
      Limits.pullback.fst X.hom g (genericPoint (Limits.pullback X.hom g : Scheme.{u})) := by
    rw [← Scheme.Hom.comp_apply, hψ, Limits.pullback.lift_fst]; exact hz
  have hη : genericPoint (Limits.pullback X.hom g : Scheme.{u}) = ψ z :=
    hfib _ (ψ z) (genericPoint_specializes _) hz'.symm
  exact (genericPoint_specializes y).mem_closed hclosed ⟨z, hη.symm⟩

theorem wcpa_smooth_dim_eq : ∀ (F : Type u) [Field F] [PerfectField F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] (sZ : Z ⟶ Spec (.of F)) (e : ℕ)
    [SmoothOfRelativeDimension e sZ] (φ : Z ⟶ X.left), φ ≫ X.hom = sZ → Surjective φ →
    ∀ V : X.left.Opens, V ≠ ⊥ → IsFinite (φ ∣_ V) → e = d :=
by
  intro F _ _ X _ d _ Z _ sZ e _ φ hφ hsurj V hV hfin
  subst hφ
  haveI := hsurj
  classical

  have chart : ∀ (W : Scheme.{u}) (s : W ⟶ Spec (.of F)) (n : ℕ) [SmoothOfRelativeDimension n s]
      (w : W) (O : W.Opens), w ∈ O → ∃ U : W.Opens, IsAffineOpen U ∧ w ∈ U ∧ U ≤ O ∧
      RingHom.IsStandardSmoothOfRelativeDimension n ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        s.appTop ≫ W.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom := by
    intro W s n _ w O hwO
    obtain ⟨U₀, hU₀, V₀, hV₀, hwV₀, e₀, hst⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := s) w
    have hU₀top : U₀ = ⊤ := by
      have hsw : s w ∈ U₀ := e₀ hwV₀
      exact eq_top_iff.mpr (fun y _ => by rwa [Subsingleton.elim y (s w)])
    subst hU₀top
    obtain ⟨f, hfle, hwf⟩ := hV₀.exists_basicOpen_le (V := V₀ ⊓ O) ⟨w, ⟨hwV₀, hwO⟩⟩ hwV₀
    have hloc : RingHom.IsStandardSmoothOfRelativeDimension 0
        (W.presheaf.map (homOfLE (W.basicOpen_le f)).op).hom := by
      haveI := hV₀.isLocalization_basicOpen f
      exact Algebra.IsStandardSmoothOfRelativeDimension.localization_away f
    have hiso : RingHom.IsStandardSmoothOfRelativeDimension 0
        (Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom :=
      RingHom.IsStandardSmoothOfRelativeDimension.equiv
        (Scheme.ΓSpecIso (CommRingCat.of F)).symm.commRingCatIsoToRingEquiv
    have hcomp := hloc.comp (hst.comp hiso)
    have hn : 0 + (n + 0) = n := by omega
    rw [hn] at hcomp
    refine ⟨W.basicOpen f, hV₀.basicOpen f, hwf, hfle.trans inf_le_right, ?_⟩
    have heq : (W.presheaf.map (homOfLE (W.basicOpen_le f)).op).hom.comp
        ((s.appLE ⊤ V₀ e₀).hom.comp (Scheme.ΓSpecIso (CommRingCat.of F)).inv.hom) =
        ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
          W.presheaf.map (homOfLE (le_top : W.basicOpen f ≤ ⊤)).op).hom := by
      rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp]
      congr 1
      simp only [Scheme.Hom.appLE, Category.assoc, ← Functor.map_comp]
      rfl
    rw [← heq]
    exact hcomp

  have trdeg_eq : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [IsDomain B]
      [Algebra F A] [Algebra F B] [Algebra A B] [IsScalarTower F A B] [FaithfulSMul A B]
      [Algebra.IsAlgebraic A B], Algebra.trdeg F A = Algebra.trdeg F B := by
    intro A B _ _ _ _ _ _ _ _ _ _
    haveI : FaithfulSMul F A :=
      (faithfulSMul_iff_algebraMap_injective F A).mpr (algebraMap F A).injective
    rw [← trdeg_add_eq F A (A := B), (trdeg_eq_zero_iff (R := A) (A := B)).mpr inferInstance,
      add_zero]

  haveI : ∀ x : X.left, _root_.IsReduced (X.left.presheaf.stalk x) := fun x => by
    haveI := wcpa_smooth_stalk_isDomain F X.left X.hom d x
    exact isReduced_of_noZeroDivisors
  haveI : IsReduced X.left := isReduced_of_isReduced_stalk X.left
  haveI : IrreducibleSpace X.left := by
    haveI := irreducibleSpace_of_isIntegral Z
    exact Function.Surjective.irreducibleSpace φ.continuous φ.surjective
  haveI : IsIntegral X.left := isIntegral_of_irreducibleSpace_of_isReduced X.left

  obtain ⟨x, hxV⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV
  obtain ⟨U, hUaff, hxU, hUV, hUsm⟩ := chart X.left X.hom d x V hxV
  haveI : Nonempty U := ⟨⟨x, hxU⟩⟩
  haveI : IsDomain Γ(X.left, U) := IsIntegral.component_integral U
  letI algA : Algebra F Γ(X.left, U) := ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        X.hom.appTop ≫ X.left.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra
  haveI : Algebra.IsStandardSmoothOfRelativeDimension d F Γ(X.left, U) := hUsm
  have hA : Algebra.trdeg F Γ(X.left, U) = d := wcpa_sde_trdeg_standard_smooth F Γ(X.left, U) d

  have hfinU : IsAffineOpen (φ ⁻¹ᵁ U) ∧ (φ.app U).hom.Finite := by
    have hU' : IsAffineOpen (V.ι ⁻¹ᵁ U) :=
      hUaff.preimage_of_isOpenImmersion V.ι (by rw [Scheme.Opens.opensRange_ι]; exact hUV)
    have himg : V.ι ''ᵁ (V.ι ⁻¹ᵁ U) = U := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hUV
    constructor
    · have h1 : IsAffineOpen ((φ ⁻¹ᵁ V).ι ''ᵁ ((φ ∣_ V) ⁻¹ᵁ (V.ι ⁻¹ᵁ U))) :=
        (IsAffineHom.isAffine_preimage _ hU').image_of_isOpenImmersion (φ ⁻¹ᵁ V).ι
      rw [image_morphismRestrict_preimage, himg] at h1
      exact h1
    · have h1 := IsFinite.finite_app (φ ∣_ V) (V.ι ⁻¹ᵁ U) hU'
      rw [morphismRestrict_app] at h1
      have key : ∀ (W' : X.left.Opens), W' = U → (φ.app W').hom.Finite → (φ.app U).hom.Finite := by
        rintro _ rfl h
        exact h
      refine key _ himg ?_
      have hiso2 : ∀ {R S T : CommRingCat.{u}} (f : R ⟶ S) (g : S ⟶ T) [IsIso g],
          (f ≫ g).hom.Finite → f.hom.Finite := by
        intro R S T f g _ h
        have e1 : f = (f ≫ g) ≫ inv g := by simp
        rw [e1, CommRingCat.hom_comp]
        exact RingHom.Finite.comp
          (RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso (inv g)).2) h
      refine @hiso2 _ _ _ _ _ ?_ h1
      exact Functor.map_isIso _ _

  obtain ⟨z, hz⟩ := φ.surjective x
  have hzU : z ∈ φ ⁻¹ᵁ U := by rw [Scheme.Hom.mem_preimage, hz]; exact hxU
  haveI : Nonempty (φ ⁻¹ᵁ U) := ⟨⟨z, hzU⟩⟩
  haveI : IsDomain Γ(Z, φ ⁻¹ᵁ U) := IsIntegral.component_integral _

  have hinj : Function.Injective (φ.app U).hom := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    rw [← basicOpen_eq_bot_iff]
    have ha' : (ConcreteCategory.hom (φ.app U)) a = 0 := ha
    have h1 : φ ⁻¹ᵁ X.left.basicOpen a = ⊥ := by
      rw [Scheme.preimage_basicOpen, ha']
      exact Scheme.basicOpen_zero _ _
    rw [eq_bot_iff]
    intro y hy
    obtain ⟨z', rfl⟩ := φ.surjective y
    have hz' : z' ∈ φ ⁻¹ᵁ X.left.basicOpen a := hy
    rw [h1] at hz'
    exact absurd hz' (by simp)

  letI algB : Algebra F Γ(Z, φ ⁻¹ᵁ U) := ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        (φ ≫ X.hom).appTop ≫ Z.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ U ≤ ⊤)).op).hom.toAlgebra
  letI algAB : Algebra Γ(X.left, U) Γ(Z, φ ⁻¹ᵁ U) := (φ.app U).hom.toAlgebra
  haveI : IsScalarTower F Γ(X.left, U) Γ(Z, φ ⁻¹ᵁ U) := IsScalarTower.of_algebraMap_eq' (by
    show ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        (φ ≫ X.hom).appTop ≫ Z.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ U ≤ ⊤)).op).hom =
      (φ.app U).hom.comp ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        X.hom.appTop ≫ X.left.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
    rw [← CommRingCat.hom_comp]
    congr 1
    rw [Scheme.Hom.comp_appTop]
    simp only [Category.assoc]
    rw [Scheme.Hom.naturality]
    rfl)

  haveI : FaithfulSMul Γ(X.left, U) Γ(Z, φ ⁻¹ᵁ U) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  haveI : Module.Finite Γ(X.left, U) Γ(Z, φ ⁻¹ᵁ U) := hfinU.2
  haveI : Algebra.IsIntegral Γ(X.left, U) Γ(Z, φ ⁻¹ᵁ U) := Algebra.IsIntegral.of_finite _ _
  haveI : Algebra.IsAlgebraic Γ(X.left, U) Γ(Z, φ ⁻¹ᵁ U) := Algebra.IsIntegral.isAlgebraic
  have hB : Algebra.trdeg F Γ(Z, φ ⁻¹ᵁ U) = d :=
    (trdeg_eq Γ(X.left, U) Γ(Z, φ ⁻¹ᵁ U)).symm.trans hA

  letI algK : Algebra F Z.functionField := ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        (φ ≫ X.hom).appTop ≫
        Z.presheaf.germ ⊤ (genericPoint Z) (by trivial)).hom.toAlgebra
  have s4 : ∀ (U₁ : Z.Opens) [Nonempty U₁], IsAffineOpen U₁ →
      @Algebra.trdeg F Γ(Z, U₁) _ _ ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        (φ ≫ X.hom).appTop ≫ Z.presheaf.map (homOfLE (le_top : U₁ ≤ ⊤)).op).hom.toAlgebra =
      Algebra.trdeg F Z.functionField := by
    intro U₁ _ hU₁
    letI : Algebra F Γ(Z, U₁) := ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        (φ ≫ X.hom).appTop ≫ Z.presheaf.map (homOfLE (le_top : U₁ ≤ ⊤)).op).hom.toAlgebra
    haveI := functionField_isFractionRing_of_isAffineOpen Z U₁ hU₁
    haveI : IsDomain Γ(Z, U₁) := IsIntegral.component_integral _
    haveI : IsScalarTower F Γ(Z, U₁) Z.functionField := IsScalarTower.of_algebraMap_eq' (by
      show ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ (φ ≫ X.hom).appTop ≫
          Z.presheaf.germ ⊤ (genericPoint Z) (by trivial)).hom =
        (Z.germToFunctionField U₁).hom.comp ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
          (φ ≫ X.hom).appTop ≫ Z.presheaf.map (homOfLE (le_top : U₁ ≤ ⊤)).op).hom
      rw [← CommRingCat.hom_comp]
      congr 1
      simp only [Category.assoc, Scheme.germToFunctionField, TopCat.Presheaf.germ_res])
    haveI : FaithfulSMul Γ(Z, U₁) Z.functionField :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (IsFractionRing.injective _ _)
    haveI : Algebra.IsAlgebraic Γ(Z, U₁) Z.functionField :=
      IsLocalization.isAlgebraic Z.functionField (nonZeroDivisors Γ(Z, U₁))
    exact trdeg_eq Γ(Z, U₁) Z.functionField

  obtain ⟨U₂, hU₂aff, hzU₂, -, hU₂sm⟩ := chart Z (φ ≫ X.hom) e z (φ ⁻¹ᵁ U) hzU
  haveI : Nonempty U₂ := ⟨⟨z, hzU₂⟩⟩
  have hE : @Algebra.trdeg F Γ(Z, U₂) _ _ ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        (φ ≫ X.hom).appTop ≫ Z.presheaf.map (homOfLE (le_top : U₂ ≤ ⊤)).op).hom.toAlgebra = e := by
    letI : Algebra F Γ(Z, U₂) := ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫
        (φ ≫ X.hom).appTop ≫ Z.presheaf.map (homOfLE (le_top : U₂ ≤ ⊤)).op).hom.toAlgebra
    haveI : IsDomain Γ(Z, U₂) := IsIntegral.component_integral _
    haveI : Algebra.IsStandardSmoothOfRelativeDimension e F Γ(Z, U₂) := hU₂sm
    exact wcpa_sde_trdeg_standard_smooth F Γ(Z, U₂) e
  have hfinal : (e : Cardinal.{u}) = (d : Cardinal.{u}) := by
    rw [← hE, s4 U₂ hU₂aff, ← s4 (φ ⁻¹ᵁ U) hfinU.1]
    exact hB
  exact_mod_cast hfinal

theorem wc_projective_alteration (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom] :
    ∃ (F' : Type u) (_ : Field F') (_ : Finite F') (_ : Algebra F F') (_ : FiniteDimensional F F')
      (Y : Over (Spec (.of F'))) (_ : GeometricallyIrreducible Y.hom) (_ : IsProper Y.hom)
      (_ : SmoothOfRelativeDimension d Y.hom)
      (π : Y.left ⟶ Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F')))),
      π ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))) = Y.hom ∧
      Surjective π ∧
      (∃ V : (Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F')))).Opens,
        V ≠ ⊥ ∧ IsFinite (π ∣_ V)) ∧
      ∃ (N : ℕ) (j : Y.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion j ∧
        j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) = Y.hom :=
by
  classical

  obtain ⟨Z, hZint, sZ, hsZ, hreg, φ, hφX, hφsurj, ⟨V, hV0, hVfin⟩, N, jZ, hjZ, hjZeq⟩ :=
    wcpa_dejong_regular_projective_alteration F X d
  haveI := hZint
  haveI := hsZ
  haveI := hφsurj

  obtain ⟨e, he⟩ := wcpa_regular_smooth F Z sZ hreg
  haveI := he
  have hed : e = d := wcpa_smooth_dim_eq F X d Z sZ e φ hφX hφsurj V hV0 hVfin
  have hsmF : SmoothOfRelativeDimension d sZ := hed ▸ he

  obtain ⟨F', iF', iAlg, iFD, t, ht, htiso⟩ := wcpa_stein_field F Z sZ
  haveI hF'fin : Finite F' := Module.finite_of_finite F

  haveI : IsProper (t ≫ Spec.map (CommRingCat.ofHom (algebraMap F F'))) := by
    rw [ht]; exact hsZ
  haveI htprop : IsProper t := IsProper.of_comp t (Spec.map (CommRingCat.ofHom (algebraMap F F')))
  haveI htsm : SmoothOfRelativeDimension d t :=
    wcpa_smooth_descend_finite_separable F F' Z t d (by rw [ht]; exact hsmF)
  haveI hZne : Nonempty Z := IsIntegral.nonempty
  haveI hgc : GeometricallyConnected t := wcpa_geom_connected_of_global_sections F' Z t htiso
  have hgi : GeometricallyIrreducible t := by
    refine ⟨?_⟩
    intro K _ y W fst snd hpb
    haveI : ConnectedSpace W := GeometricallyConnected.geometrically_connectedSpace y fst snd hpb
    haveI : SmoothOfRelativeDimension d snd :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d) hpb htsm
    haveI : LocallyOfFiniteType snd :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hpb
        (inferInstance : LocallyOfFiniteType t)
    haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian snd
    exact wcpa_irreducible_of_connected_domain_stalks W (wcpa_smooth_stalk_isDomain K W snd d)
  have hφ : φ ≫ X.hom = t ≫ Spec.map (CommRingCat.ofHom (algebraMap F F')) := hφX.trans ht.symm
  refine ⟨F', iF', hF'fin, iAlg, iFD, Over.mk t, hgi, htprop, htsm,
    Limits.pullback.lift φ t hφ, ?_, ?_, ?_, ?_⟩
  · exact Limits.pullback.lift_snd _ _ _
  · exact wcpa_lift_surjective F F' X Z t φ hφ
  ·
    refine ⟨Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))) ⁻¹ᵁ V,
      ?_, ?_⟩
    · rw [TopologicalSpace.Opens.ne_bot_iff_nonempty] at hV0 ⊢
      obtain ⟨x, hx⟩ := hV0
      obtain ⟨w, hw⟩ :=
        (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F')))).surjective x
      refine ⟨w, ?_⟩
      show w ∈ Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))) ⁻¹ᵁ V
      rw [Scheme.Hom.mem_preimage, hw]
      exact hx
    · have h1 : IsFinite ((Limits.pullback.lift φ t hφ ≫
          Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F')))) ∣_ V) := by
        rw [Limits.pullback.lift_fst]; exact hVfin
      rw [morphismRestrict_comp] at h1
      exact @IsFinite.of_comp _ _ _ _
        (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F F'))) ∣_ V) h1 _
  ·
    obtain ⟨eP, heiso, heP⟩ := wcpa_proj_base_change F F' N
    have hj' := hjZeq.trans ht.symm
    haveI : IsClosedImmersion (Limits.pullback.lift jZ t hj') := by
      haveI : IsClosedImmersion (Limits.pullback.lift jZ t hj' ≫ Limits.pullback.fst _ _) := by
        rw [Limits.pullback.lift_fst]; exact hjZ
      exact IsClosedImmersion.of_comp _ (Limits.pullback.fst _ _)
    haveI := heiso
    refine ⟨N, Limits.pullback.lift jZ t hj' ≫ eP, inferInstance, ?_⟩
    rw [Category.assoc, heP]
    exact Limits.pullback.lift_snd _ _ _

theorem wc_purity (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    ∀ i ≤ 2 * d, ∀ (r : ℕ) (e : wcCoh F X h ℓ i ≃+ (Fin r → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ i), e (wcCohScalar F X h ℓ i c x) = c • e x) →
      ∀ μ ∈ (wcAddEquivMatrix e (wcCohFrob F X h ℓ i)).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
      ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ, ‖ι μ‖ = √((Nat.card F : ℝ) ^ i) :=
by
  classical

  have s6 : ∀ (F₀ : Type u) [Field F₀] [Finite F₀] (X₀ : Over (Spec (.of F₀)))
      (h₀ : WeaklyEtale (Limits.pullback.fst X₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F₀ (AlgebraicClosure F₀))))))
      (i : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F₀ X₀ h₀ ℓ i),
      wcCohFrob F₀ X₀ h₀ ℓ i (wcCohScalar F₀ X₀ h₀ ℓ i c x) =
        wcCohScalar F₀ X₀ h₀ ℓ i c (wcCohFrob F₀ X₀ h₀ ℓ i x) := by
    intro F₀ _ _ X₀ h₀ i c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp
        (x.comp (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)) (zero_add i) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp x (zero_add i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega)).symm

  have s4 : ∀ {r r' : ℕ} (m : ℕ) (A : Matrix (Fin r) (Fin r) ℚ_[ℓ])
      (B : Matrix (Fin r') (Fin r') ℚ_[ℓ]) (P : Matrix (Fin r') (Fin r) ℚ_[ℓ]),
      (∀ v : Fin r → ℚ_[ℓ], P.mulVec v = 0 → v = 0) → P * A ^ m = B * P →
      ∀ μ ∈ A.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
        μ ^ m ∈ B.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro r r' m A B P hP hPA μ hμ
    set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    have hker : LinearMap.ker (Matrix.toLin' P) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro v hv
      exact hP v (by rwa [Matrix.toLin'_apply] at hv)
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hQP : LinearMap.toMatrix' g * P = 1 := by
      have := congrArg LinearMap.toMatrix' hg
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    have hQPL : (LinearMap.toMatrix' g).map f * P.map f = 1 := by
      rw [← Matrix.map_mul, hQP, Matrix.map_one _ (map_zero f) (map_one f)]
    have hPAL : P.map f * A.map f ^ m = B.map f * P.map f := by
      rw [← Matrix.map_pow, ← Matrix.map_mul, ← Matrix.map_mul, hPA]
    rw [Polynomial.mem_aroots] at hμ
    obtain ⟨_, hμ⟩ := hμ
    have hdet : (Matrix.scalar (Fin r) μ - A.map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hμ
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hAv : (A.map f).mulVec v = μ • v := by
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hAkv : ∀ k : ℕ, (A.map f ^ k).mulVec v = μ ^ k • v := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ (A.map f), ← Matrix.mulVec_mulVec, hAv, Matrix.mulVec_smul, ih, smul_smul,
          ← pow_succ']
    have hw0 : (P.map f).mulVec v ≠ 0 := by
      intro hw
      apply hv0
      have e1 : ((LinearMap.toMatrix' g).map f).mulVec ((P.map f).mulVec v) = v := by
        rw [Matrix.mulVec_mulVec, hQPL, Matrix.one_mulVec]
      rw [← e1, hw, Matrix.mulVec_zero]
    have hBw : (B.map f).mulVec ((P.map f).mulVec v) = μ ^ m • (P.map f).mulVec v := by
      rw [Matrix.mulVec_mulVec, ← hPAL, ← Matrix.mulVec_mulVec, hAkv, Matrix.mulVec_smul]
    have hdet' : (Matrix.scalar (Fin r') (μ ^ m) - B.map f).det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨(P.map f).mulVec v, hw0, ?_⟩
      rw [Matrix.sub_mulVec, hBw, Matrix.scalar_apply, sub_eq_zero]
      ext x
      simp [Matrix.mulVec_diagonal]
    rw [Polynomial.mem_aroots]
    refine ⟨(Matrix.charpoly_monic B).ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Matrix.charpoly_map, Matrix.eval_charpoly]
    exact hdet'

  have s5 : ∀ {V V' : Type (u+1)} [AddCommGroup V] [AddCommGroup V'] {r r' : ℕ}
      (e : V ≃+ (Fin r → ℚ_[ℓ])) (e' : V' ≃+ (Fin r' → ℚ_[ℓ]))
      (s : ℚ_[ℓ] → V →+ V) (s' : ℚ_[ℓ] → V' →+ V')
      (he : ∀ (c : ℚ_[ℓ]) (x : V), e (s c x) = c • e x)
      (he' : ∀ (c : ℚ_[ℓ]) (x : V'), e' (s' c x) = c • e' x)
      (Φ : V →+ V) (Φ' : V' →+ V')
      (hΦ : ∀ (c : ℚ_[ℓ]) (x : V), Φ (s c x) = s c (Φ x))
      (hΦ' : ∀ (c : ℚ_[ℓ]) (x : V'), Φ' (s' c x) = s' c (Φ' x))
      (ψ : V →+ V') (hψ : Function.Injective ψ)
      (hψs : ∀ (c : ℚ_[ℓ]) (x : V), ψ (s c x) = s' c (ψ x))
      (m : ℕ) (hψΦ : ∀ x : V, ψ ((⇑Φ)^[m] x) = Φ' (ψ x)),
      ∃ P : Matrix (Fin r') (Fin r) ℚ_[ℓ], (∀ v : Fin r → ℚ_[ℓ], P.mulVec v = 0 → v = 0) ∧
        P * (wcAddEquivMatrix e Φ) ^ m = wcAddEquivMatrix e' Φ' * P := by
    intro V V' _ _ r r' e e' s s' he he' Φ Φ' hΦ hΦ' ψ hψ hψs m hψΦ
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) = s c (e.symm v) := fun c v =>
      e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have hes' : ∀ (c : ℚ_[ℓ]) (v : Fin r' → ℚ_[ℓ]), e'.symm (c • v) = s' c (e'.symm v) :=
      fun c v => e'.injective (by rw [he', AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let LA : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      { toFun := fun v => e (Φ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hΦ, he, RingHom.id_apply] }
    let LB : (Fin r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => e' (Φ' (e'.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes', hΦ', he', RingHom.id_apply] }
    let LP : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => e' (ψ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hψs, he', RingHom.id_apply] }
    have hA : wcAddEquivMatrix e Φ = LinearMap.toMatrix' LA := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hB : wcAddEquivMatrix e' Φ' = LinearMap.toMatrix' LB := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hAk : ∀ (k : ℕ) (v : Fin r → ℚ_[ℓ]),
        ((wcAddEquivMatrix e Φ) ^ k).mulVec v = e ((⇑Φ)^[k] (e.symm v)) := by
      intro k
      induction k with
      | zero => intro v; simp
      | succ k ih =>
        intro v
        rw [pow_succ', ← Matrix.mulVec_mulVec, ih, hA, LinearMap.toMatrix'_mulVec]
        show e (Φ (e.symm (e ((⇑Φ)^[k] (e.symm v))))) = _
        rw [AddEquiv.symm_apply_apply, Function.iterate_succ_apply']
    refine ⟨LinearMap.toMatrix' LP, ?_, ?_⟩
    · intro v hv
      rw [LinearMap.toMatrix'_mulVec] at hv
      change e' (ψ (e.symm v)) = 0 at hv
      have h1 : ψ (e.symm v) = 0 := e'.injective (hv.trans (map_zero e').symm)
      have h2 : e.symm v = 0 := hψ (h1.trans (map_zero ψ).symm)
      rw [← AddEquiv.apply_symm_apply e v, h2, map_zero]
    · apply Matrix.toLin'.injective
      apply LinearMap.ext
      intro v
      rw [Matrix.toLin'_apply, Matrix.toLin'_apply, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        hAk, hB, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec]
      show e' (ψ (e.symm (e ((⇑Φ)^[m] (e.symm v))))) = e' (Φ' (e'.symm (e' (ψ (e.symm v)))))
      rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hψΦ]

  intro i hi r e he μ hμ ι
  obtain ⟨F', _, _, _, _, Y, _, _, _, π, hπ, hsurj, hgf, N, j, hj, hjY⟩ :=
    wc_projective_alteration F X d
  set m := Module.finrank F F' with hmdef
  have hm : 0 < m := Module.finrank_pos
  have hq' : Nat.card F' = Nat.card F ^ m := Module.natCard_eq_pow_finrank
  have hℓ' : ¬ ℓ ∣ Nat.card F' := by
    rw [hq']
    intro hd
    exact hℓ ((Fact.out : ℓ.Prime).dvd_of_dvd_pow hd)
  have h' : WeaklyEtale (Limits.pullback.fst Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F')
  obtain ⟨ψ, hψ, hψs, hψΦ⟩ := wc_pullback_injective F X d ℓ hℓ h F' Y π hπ hsurj hgf h' i
  obtain ⟨r', e', he'⟩ := wc_coh_finite F' Y d ℓ hℓ' h' i
  obtain ⟨P, hPinj, hPA⟩ := s5 e e' (wcCohScalar F X h ℓ i) (wcCohScalar F' Y h' ℓ i) he he'
    (wcCohFrob F X h ℓ i) (wcCohFrob F' Y h' ℓ i) (s6 F X h i) (s6 F' Y h' i) ψ hψ hψs m hψΦ
  have hμm := s4 m _ _ P hPinj hPA μ hμ
  have hY := wc_purity_projective F' Y d N j hj hjY ℓ hℓ' h' i hi r' e' he' (μ ^ m) hμm ι
  rw [map_pow, norm_pow, hq', Nat.cast_pow] at hY
  have hqi : (0 : ℝ) ≤ (Nat.card F : ℝ) ^ i := by positivity
  have hy : √((Nat.card F : ℝ) ^ i) ^ m = √(((Nat.card F : ℝ) ^ m) ^ i) := by
    have e1 : (√((Nat.card F : ℝ) ^ i) ^ m) ^ 2 = ((Nat.card F : ℝ) ^ i) ^ m := by
      rw [← pow_mul, mul_comm, pow_mul, Real.sq_sqrt hqi]
    have e2 : (√(((Nat.card F : ℝ) ^ m) ^ i)) ^ 2 = ((Nat.card F : ℝ) ^ i) ^ m := by
      rw [Real.sq_sqrt (by positivity), ← pow_mul, ← pow_mul, mul_comm]
    exact (pow_left_inj₀ (by positivity) (Real.sqrt_nonneg _) two_ne_zero).mp (e1.trans e2.symm)
  exact (pow_left_inj₀ (norm_nonneg _) (Real.sqrt_nonneg _) hm.ne').mp (hY.trans hy.symm)

theorem ladic_frobenius_pure_trace_matrices (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom] : ∃ (ℓ : ℕ) (_ : Fact (Nat.Prime ℓ)) (r : ℕ → ℕ) (M : ∀ i, Matrix (Fin (r i)) (Fin (r i)) ℚ_[ℓ]), (∀ i ≤ 2 * d, ∀ μ ∈ (M i).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]), ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ, ‖ι μ‖ = √((Nat.card F : ℝ) ^ i)) ∧ ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E], (Nat.card (.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℚ_[ℓ]) = ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((M i) ^ Module.finrank F E).trace :=
by
  classical

  obtain ⟨ℓ, hle, hp⟩ := Nat.exists_infinite_primes (Nat.card F + 1)
  haveI hfact : Fact (Nat.Prime ℓ) := ⟨hp⟩
  have hq : 0 < Nat.card F := Finite.card_pos
  have hℓ : ¬ ℓ ∣ Nat.card F := fun hd => by
    have := Nat.le_of_dvd hq hd
    omega

  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)

  choose r e he using wc_coh_finite F X d ℓ hℓ h

  refine ⟨ℓ, hfact, r, fun i => wcAddEquivMatrix (e i) (wcCohFrob F X h ℓ i), ?_, ?_⟩
  · intro i hi μ hμ ι
    exact wc_purity F X d ℓ hℓ h i hi (r i) (e i) (he i) μ hμ ι
  · intro E _ _ _
    exact wc_trace_formula F X d ℓ hℓ h (wc_coh_vanishing F X d ℓ hℓ h) r _
      (fun i _ => ⟨e i, he i, rfl⟩) E

theorem pure_virtual_eigenvalue_family (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    (d : ℕ) [SmoothOfRelativeDimension d X.hom] :
    ∃ B : ℕ → Multiset ℂ,
      (∀ i ≤ 2 * d, ∀ β ∈ B i, ∀ φ : ℂ ≃+* ℂ, ‖φ β‖ = √((Nat.card F : ℝ) ^ i)) ∧
      ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
        (Nat.card (.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℂ) =
        ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((B i).map (· ^ Module.finrank F E)).sum :=
by
  classical
  obtain ⟨ℓ, hℓ, r, M, hpure, htr⟩ := ladic_frobenius_pure_trace_matrices F X d
  haveI := hℓ

  have s1 : Nonempty (AlgebraicClosure ℚ_[ℓ] ≃+* ℂ) := by
    have h1 : Cardinal.mk ℚ_[ℓ] ≤ Cardinal.mk (PadicSeq ℓ) :=
      Cardinal.mk_le_of_surjective (f := Padic.mk)
        (fun x => Quotient.inductionOn x (fun s => ⟨s, rfl⟩))
    have h2 : Cardinal.mk (PadicSeq ℓ) ≤ Cardinal.mk (ℕ → ℚ) := Cardinal.mk_subtype_le _
    have h3 : Cardinal.mk (ℕ → ℚ) = Cardinal.continuum := by
      rw [← Cardinal.power_def, Cardinal.mkRat, Cardinal.mk_nat, Cardinal.aleph0_power_aleph0]
    have hup : Cardinal.mk ℚ_[ℓ] ≤ Cardinal.continuum := h1.trans (h2.trans h3.le)
    have hlo : Cardinal.continuum ≤ Cardinal.mk ℚ_[ℓ] :=
      continuum_le_cardinal_of_nontriviallyNormedField ℚ_[ℓ]
    have hK1 : Cardinal.mk (AlgebraicClosure ℚ_[ℓ]) ≤ Cardinal.continuum := by
      refine (Algebra.IsAlgebraic.cardinalMk_le_max ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])).trans ?_
      exact max_le hup Cardinal.aleph0_le_continuum
    have hK2 : Cardinal.continuum ≤ Cardinal.mk (AlgebraicClosure ℚ_[ℓ]) :=
      hlo.trans (Cardinal.mk_le_of_injective (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])).injective)
    have hK : Cardinal.mk (AlgebraicClosure ℚ_[ℓ]) = Cardinal.continuum := le_antisymm hK1 hK2
    apply IsAlgClosed.ringEquiv_of_equiv_of_charZero
    · rw [hK]; exact Cardinal.aleph0_lt_continuum
    · exact Cardinal.eq.mp (hK.trans Cardinal.mk_complex.symm)
  obtain ⟨ι₀⟩ := s1
  set j : ℚ_[ℓ] →+* ℂ :=
    (ι₀ : AlgebraicClosure ℚ_[ℓ] →+* ℂ).comp (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) with hj
  refine ⟨fun i => ((M i).map j).charpoly.roots, ?_, ?_⟩
  ·
    intro i hi β hβ φ
    have hp0 : (M i).charpoly ≠ 0 := (Matrix.charpoly_monic (M i)).ne_zero
    have hβ' : β ∈ ((M i).charpoly.map j).roots := by
      rw [← Matrix.charpoly_map]; exact hβ
    have hev : Polynomial.eval₂ j β (M i).charpoly = 0 :=
      (Polynomial.mem_roots_map hp0).mp hβ'
    set μ := ι₀.symm β with hμ
    have hιμ : ι₀ μ = β := RingEquiv.apply_symm_apply ι₀ β
    have haev : Polynomial.aeval μ (M i).charpoly = 0 := by
      apply ι₀.injective
      rw [map_zero, Polynomial.aeval_def]
      have := Polynomial.hom_eval₂ (M i).charpoly
        (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])) (ι₀ : AlgebraicClosure ℚ_[ℓ] →+* ℂ) μ
      simp only [RingHom.coe_coe] at this
      rw [this, hιμ]
      exact hev
    have hμroot : μ ∈ (M i).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) :=
      Polynomial.mem_aroots.mpr ⟨hp0, haev⟩
    have := hpure i hi μ hμroot (ι₀.trans φ)
    rw [RingEquiv.trans_apply, hιμ] at this
    exact this
  ·
    intro E _ _ _
    have h := congrArg j (htr E)
    rw [map_natCast] at h
    rw [h, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, map_pow, map_neg, map_one, AddMonoidHom.map_trace, Matrix.map_pow,
      matrix_trace_pow_eq_sum_roots_pow]

theorem point_count_purity (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    (d : ℕ) [SmoothOfRelativeDimension d X.hom] (m : ℂ →₀ ℤ) (hm0 : (0 : ℂ) ∉ m.support)
    (hmE : ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
        (Nat.card (.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℂ) =
        ∑ α ∈ m.support, (m α : ℂ) * α ^ Module.finrank F E) :
    ∀ α ∈ m.support, ∃ i ≤ 2 * d, 0 < (-1 : ℤ) ^ i * m α ∧
      ∀ φ : ℂ ≃+* ℂ, ‖φ α‖ = √((Nat.card F : ℝ) ^ i) :=
by
  classical

  have hq : 2 ≤ Nat.card F := Finite.one_lt_card

  have hext : ∀ n : ℕ, 1 ≤ n → ∃ (E : Type u) (_ : Field E) (_ : Algebra F E),
      FiniteDimensional F E ∧ Module.finrank F E = n := by
    intro n hn
    haveI : Fact (Nat.Prime (ringChar F)) := ⟨CharP.char_is_prime F (ringChar F)⟩
    haveI : NeZero n := ⟨by omega⟩
    refine ⟨ULift.{u} (FiniteField.Extension F (ringChar F) n), inferInstance, inferInstance,
      ?_, ?_⟩
    · exact Module.Finite.equiv (ULift.moduleEquiv (R := F)).symm
    · rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := F))]
      exact FiniteField.finrank_extension F (ringChar F) n

  obtain ⟨B, hBpure, hBtr⟩ := pure_virtual_eigenvalue_family F X d
  have hqpos : (0 : ℝ) < (Nat.card F : ℝ) := by exact_mod_cast (by omega : 0 < Nat.card F)

  have hB0 : ∀ i ≤ 2 * d, (0 : ℂ) ∉ B i := by
    intro i hi h0
    have h1 := hBpure i hi 0 h0 (RingEquiv.refl ℂ)
    rw [RingEquiv.refl_apply, norm_zero] at h1
    have h2 : (0 : ℝ) < √((Nat.card F : ℝ) ^ i) := Real.sqrt_pos.mpr (pow_pos hqpos i)
    linarith

  have hpow : ∀ n : ℕ, 1 ≤ n → ∑ α ∈ m.support, (m α : ℂ) * α ^ n =
      ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((B i).map (· ^ n)).sum := by
    intro n hn
    obtain ⟨E, _, _, _, hE⟩ := hext n hn
    have h1 := hmE E
    have h2 := hBtr E
    rw [hE] at h1 h2
    rw [← h1, h2]

  have s1 : ∀ (T : Finset ℂ) (c : ℂ → ℂ), (0 : ℂ) ∉ T →
      (∀ n : ℕ, 1 ≤ n → ∑ β ∈ T, c β * β ^ n = 0) → ∀ β ∈ T, c β = 0 := by
    intro T
    induction T using Finset.induction_on with
    | empty => intro c _ _ β hβ; simp at hβ
    | insert a T' haT ih =>
      intro c h0 H
      have ha0 : a ≠ 0 := fun h => h0 (by rw [← h]; exact Finset.mem_insert_self a T')
      have h0' : (0 : ℂ) ∉ T' := fun h => h0 (Finset.mem_insert_of_mem h)
      have H' : ∀ n : ℕ, 1 ≤ n → c a * a ^ n + ∑ β ∈ T', c β * β ^ n = 0 := by
        intro n hn
        have := H n hn
        rwa [Finset.sum_insert haT] at this
      have hc' : ∀ β ∈ T', c β * (β - a) = 0 := by
        apply ih (fun β => c β * (β - a)) h0'
        intro n hn
        have e1 := H' (n + 1) (by omega)
        have e2 := H' n hn
        have key : ∑ β ∈ T', c β * (β - a) * β ^ n
            = (c a * a ^ (n + 1) + ∑ β ∈ T', c β * β ^ (n + 1))
              - a * (c a * a ^ n + ∑ β ∈ T', c β * β ^ n) := by
          rw [mul_add, Finset.mul_sum]
          have : ∑ β ∈ T', c β * (β - a) * β ^ n
              = ∑ β ∈ T', (c β * β ^ (n + 1) - a * (c β * β ^ n)) := by
            apply Finset.sum_congr rfl
            intro β _
            ring
          rw [this, Finset.sum_sub_distrib]
          ring
        rw [key, e1, e2]
        ring
      have hcT : ∀ β ∈ T', c β = 0 := by
        intro β hβ
        have hne : β - a ≠ 0 := sub_ne_zero.mpr (fun h => haT (by rw [← h]; exact hβ))
        exact (mul_eq_zero.mp (hc' β hβ)).resolve_right hne
      have e1 := H' 1 le_rfl
      rw [Finset.sum_eq_zero (fun β hβ => by rw [hcT β hβ, zero_mul]), add_zero, pow_one] at e1
      have hca : c a = 0 := (mul_eq_zero.mp e1).resolve_right ha0
      intro β hβ
      rcases Finset.mem_insert.mp hβ with h | h
      · rw [h]; exact hca
      · exact hcT β h

  have hS : ∀ α : ℂ, m α = ∑ i ∈ Finset.Iic (2 * d), (-1 : ℤ) ^ i * ((B i).count α : ℤ) := by
    set U := (Finset.Iic (2 * d)).biUnion (fun i => (B i).toFinset) with hU
    set T := m.support ∪ U with hT
    have hT0 : (0 : ℂ) ∉ T := by
      intro h
      rcases Finset.mem_union.mp h with h | h
      · exact hm0 h
      · obtain ⟨i, hi, h0⟩ := Finset.mem_biUnion.mp h
        exact hB0 i (Finset.mem_Iic.mp hi) (Multiset.mem_toFinset.mp h0)
    have hBT : ∀ i ∈ Finset.Iic (2 * d), ∀ n : ℕ, ((B i).map (· ^ n)).sum
        = ∑ β ∈ T, ((B i).count β : ℂ) * β ^ n := by
      intro i hi n
      rw [Finset.sum_multiset_map_count]
      simp only [nsmul_eq_mul]
      apply Finset.sum_subset
      · intro β hβ
        exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨i, hi, hβ⟩)
      · intro β _ hβ
        rw [Multiset.count_eq_zero.mpr (fun h => hβ (Multiset.mem_toFinset.mpr h))]
        simp
    have hST : ∀ n : ℕ, ∑ α ∈ m.support, (m α : ℂ) * α ^ n = ∑ β ∈ T, (m β : ℂ) * β ^ n := by
      intro n
      apply Finset.sum_subset Finset.subset_union_left
      intro β _ hβ
      rw [Finsupp.notMem_support_iff.mp hβ]
      simp
    have hcT : ∀ β ∈ T, ((m β : ℂ) - ∑ i ∈ Finset.Iic (2 * d),
        (-1) ^ i * ((B i).count β : ℂ)) = 0 := by
      refine s1 T (fun β => (m β : ℂ) - ∑ i ∈ Finset.Iic (2 * d),
        (-1) ^ i * ((B i).count β : ℂ)) hT0 ?_
      intro n hn
      have h := hpow n hn
      have h' : ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((B i).map (· ^ n)).sum
          = ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ∑ β ∈ T, ((B i).count β : ℂ) * β ^ n :=
        Finset.sum_congr rfl (fun i hi => by rw [hBT i hi n])
      have e : ∑ β ∈ T, (∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((B i).count β : ℂ)) * β ^ n
          = ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ∑ β ∈ T, ((B i).count β : ℂ) * β ^ n := by
        simp only [Finset.sum_mul, Finset.mul_sum]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun β _ => by ring))
      simp only [sub_mul, Finset.sum_sub_distrib]
      rw [e, ← hST n, h, h', sub_self]
    intro α
    by_cases hα : α ∈ T
    · have h := hcT α hα
      rw [sub_eq_zero] at h
      exact_mod_cast h
    · have hαS : α ∉ m.support := fun h => hα (Finset.mem_union_left _ h)
      rw [Finsupp.notMem_support_iff.mp hαS]
      symm
      apply Finset.sum_eq_zero
      intro i hi
      rw [Multiset.count_eq_zero.mpr (fun h => hα (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨i, hi, Multiset.mem_toFinset.mpr h⟩)))]
      simp

  intro α hα
  have hmα : m α ≠ 0 := Finsupp.mem_support_iff.mp hα
  have hsum := hS α
  rw [hsum] at hmα
  obtain ⟨i, hi, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hmα
  have hcnt : (B i).count α ≠ 0 := by
    intro h
    apply hne
    rw [h]
    simp
  have hαB : α ∈ B i := Multiset.count_ne_zero.mp hcnt
  have hi' : i ≤ 2 * d := Finset.mem_Iic.mp hi
  have huniq : ∀ j ∈ Finset.Iic (2 * d), j ≠ i → (B j).count α = 0 := by
    intro j hj hji
    apply Multiset.count_eq_zero.mpr
    intro hαj
    apply hji
    have e1 := hBpure j (Finset.mem_Iic.mp hj) α hαj (RingEquiv.refl ℂ)
    have e2 := hBpure i hi' α hαB (RingEquiv.refl ℂ)
    rw [e1] at e2
    have e3 : (Nat.card F : ℝ) ^ j = (Nat.card F : ℝ) ^ i :=
      (Real.sqrt_inj (by positivity) (by positivity)).mp e2
    have e4 : Nat.card F ^ j = Nat.card F ^ i := by exact_mod_cast e3
    exact Nat.pow_right_injective hq e4
  have hcollapse : m α = (-1 : ℤ) ^ i * ((B i).count α : ℤ) := by
    rw [hsum, Finset.sum_eq_single_of_mem i hi]
    intro j hj hji
    rw [huniq j hj hji]
    simp
  refine ⟨i, hi', ?_, fun φ => hBpure i hi' α hαB φ⟩
  rw [hcollapse, ← mul_assoc, ← mul_pow]
  have h1 : ((-1 : ℤ) * (-1)) ^ i = 1 := by norm_num
  rw [h1, one_mul]
  exact_mod_cast Multiset.count_pos.mpr hαB

theorem etale_frobenius_poincare_data (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    (d : ℕ) [SmoothOfRelativeDimension d X.hom] :
    ∃ (ℓ : ℕ) (_ : Fact (Nat.Prime ℓ)) (V : ℕ → Type u) (_ : ∀ i, AddCommGroup (V i))
      (_ : ∀ i, Module ℚ_[ℓ] (V i)) (_ : ∀ i, FiniteDimensional ℚ_[ℓ] (V i))
      (Φ : ∀ i, V i →ₗ[ℚ_[ℓ]] V i) (B : ∀ i, V i →ₗ[ℚ_[ℓ]] V (2 * d - i) →ₗ[ℚ_[ℓ]] ℚ_[ℓ]),
      (∀ i ≤ 2 * d, ∀ x y, B i (Φ i x) (Φ (2 * d - i) y) = ((Nat.card F : ℚ_[ℓ]) ^ d) * B i x y) ∧
      (∀ i ≤ 2 * d, ∀ x, (∀ y, B i x y = 0) → x = 0) ∧
      (∀ i ≤ 2 * d, ∀ y, (∀ x, B i x y = 0) → y = 0) ∧
      ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
        (Nat.card (.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℚ_[ℓ]) =
        ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * LinearMap.trace ℚ_[ℓ] (V i) (Φ i ^ Module.finrank F E) :=
by
  classical

  obtain ⟨ℓ, hle, hp⟩ := Nat.exists_infinite_primes (Nat.card F + 1)
  haveI hfact : Fact (Nat.Prime ℓ) := ⟨hp⟩
  have hq : 0 < Nat.card F := Finite.card_pos
  have hℓ : ¬ ℓ ∣ Nat.card F := fun hd => by
    have := Nat.le_of_dvd hq hd
    omega

  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)

  choose r e he using wc_coh_finite F X d ℓ hℓ h
  obtain ⟨hone, htop⟩ := wc_top_coh_frobenius F X d ℓ hℓ h
  let M : ∀ i, Matrix (Fin (r i)) (Fin (r i)) ℚ_[ℓ] :=
    fun i => wcAddEquivMatrix (e i) (wcCohFrob F X h ℓ i)

  have hPex : ∀ i, ∃ P : Matrix (Fin (r i)) (Fin (r (2 * d - i))) ℚ_[ℓ], i ≤ 2 * d →
      (M i).transpose * P * M (2 * d - i) = ((Nat.card F : ℚ_[ℓ]) ^ d) • P ∧
      (∀ v : Fin (r i) → ℚ_[ℓ], Matrix.vecMul v P = 0 → v = 0) ∧
      (∀ w : Fin (r (2 * d - i)) → ℚ_[ℓ], P.mulVec w = 0 → w = 0) := by
    intro i
    by_cases hi : i ≤ 2 * d
    · obtain ⟨P, hP⟩ := wc_poincare_duality F X d ℓ hℓ h hone htop i hi (r i) (r (2 * d - i))
        (e i) (e (2 * d - i)) (he i) (he (2 * d - i))
      exact ⟨P, fun _ => hP⟩
    · exact ⟨0, fun h' => absurd h' hi⟩
  choose P hP using hPex

  let u : ∀ i, ULift.{u} (Fin (r i) → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin (r i) → ℚ_[ℓ]) :=
    fun i => ULift.moduleEquiv
  let Φ : ∀ i, ULift.{u} (Fin (r i) → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ULift.{u} (Fin (r i) → ℚ_[ℓ]) :=
    fun i => (u i).symm.conj (Matrix.toLin' (M i))
  let B : ∀ i, ULift.{u} (Fin (r i) → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]]
      ULift.{u} (Fin (r (2 * d - i)) → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ] := fun i =>
    (Matrix.toLinearMap₂' ℚ_[ℓ] (P i)).compl₁₂ (u i).toLinearMap (u (2 * d - i)).toLinearMap
  have hΦ : ∀ i (x : ULift.{u} (Fin (r i) → ℚ_[ℓ])), (Φ i x).down = Matrix.mulVec (M i) x.down := by
    intro i x
    rfl
  have hB : ∀ i (x : ULift.{u} (Fin (r i) → ℚ_[ℓ])) (y : ULift.{u} (Fin (r (2 * d - i)) → ℚ_[ℓ])),
      B i x y = dotProduct x.down (Matrix.mulVec (P i) y.down) := by
    intro i x y
    simp only [B, LinearMap.compl₁₂_apply, Matrix.toLinearMap₂'_apply']
    rfl
  have hpow : ∀ i (n : ℕ), Φ i ^ n = (u i).symm.conj (Matrix.toLin' (M i ^ n)) := by
    intro i n
    induction n with
    | zero =>
      rw [pow_zero, pow_zero, Matrix.toLin'_one, LinearEquiv.conj_id, Module.End.one_eq_id]
    | succ n ih =>
      rw [pow_succ, ih, pow_succ, Matrix.toLin'_mul, Module.End.mul_eq_comp,
        LinearEquiv.conj_comp]
  refine ⟨ℓ, hfact, fun i => ULift.{u} (Fin (r i) → ℚ_[ℓ]), fun i => inferInstance,
    fun i => inferInstance, fun i => Module.Finite.equiv (u i).symm, Φ, B, ?_, ?_, ?_, ?_⟩
  ·
    intro i hi x y
    rw [hB, hΦ, hΦ, hB, ← Matrix.vecMul_transpose (M i) x.down, ← Matrix.dotProduct_mulVec,
      Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, (hP i hi).1, Matrix.smul_mulVec,
      dotProduct_smul, smul_eq_mul]
  ·
    intro i hi x hx
    have hv : Matrix.vecMul x.down (P i) = 0 := by
      funext k
      have hk := hx ⟨Pi.single k 1⟩
      rw [hB, Matrix.dotProduct_mulVec] at hk
      simpa [dotProduct_single] using hk
    exact ULift.ext _ _ ((hP i hi).2.1 _ hv)
  ·
    intro i hi y hy
    have hw : (P i).mulVec y.down = 0 := by
      funext j
      have hj := hy ⟨Pi.single j 1⟩
      rw [hB] at hj
      simpa [single_dotProduct] using hj
    exact ULift.ext _ _ ((hP i hi).2.2 _ hw)
  ·
    intro E _ _ _
    rw [wc_trace_formula F X d ℓ hℓ h (wc_coh_vanishing F X d ℓ hℓ h) r M
      (fun i _ => ⟨e i, he i, rfl⟩) E]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hpow, LinearMap.trace_conj', Matrix.trace_toLin'_eq]

theorem frobenius_duality_matrices (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    (d : ℕ) [SmoothOfRelativeDimension d X.hom] :
    ∃ (r : ℕ → ℕ) (M : ∀ i, Matrix (Fin (r i)) (Fin (r i)) ℂ)
      (P : ∀ i, Matrix (Fin (r i)) (Fin (r (2 * d - i))) ℂ),
      (∀ i ≤ 2 * d, (M i).transpose * P i * M (2 * d - i) = ((Nat.card F : ℂ) ^ d) • P i ∧
        (∀ v : Fin (r i) → ℂ, Matrix.vecMul v (P i) = 0 → v = 0) ∧
        (∀ w : Fin (r (2 * d - i)) → ℂ, (P i).mulVec w = 0 → w = 0)) ∧
      ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
        (Nat.card (.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℂ) =
        ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((M i) ^ Module.finrank F E).trace :=
by
  classical
  obtain ⟨ℓ, hℓ, V, _, _, _, Φ, B, hcomp, hL, hR, htr⟩ := etale_frobenius_poincare_data F X d
  haveI := hℓ

  have hσ : Nonempty (ℚ_[ℓ] →+* ℂ) := by
    have ha : Cardinal.continuum ≤ Cardinal.mk ℚ_[ℓ] :=
      continuum_le_cardinal_of_nontriviallyNormedField ℚ_[ℓ]
    have hb : Cardinal.mk ℚ_[ℓ] ≤ Cardinal.continuum := by
      have hr : ∀ (x : ℚ_[ℓ]) (k : ℕ), ∃ r : ℚ, ‖x - r‖ < 1 / ((k : ℝ) + 1) := by
        intro x k
        exact Padic.rat_dense ℓ x (by positivity)
      choose r hr using hr
      have hinj : Function.Injective r := by
        intro x y hxy
        by_contra hne
        have hδ : 0 < ‖x - y‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hne)
        obtain ⟨k, hk⟩ := exists_nat_gt (2 / ‖x - y‖)
        have h1 := hr x k
        have h2 := hr y k
        rw [hxy] at h1
        have h3 : ‖x - y‖ ≤ ‖x - (r y k : ℚ_[ℓ])‖ + ‖y - (r y k : ℚ_[ℓ])‖ := by
          calc ‖x - y‖ = ‖(x - (r y k : ℚ_[ℓ])) - (y - (r y k : ℚ_[ℓ]))‖ := by ring_nf
            _ ≤ _ := norm_sub_le _ _
        have hk1 : (0:ℝ) < (k:ℝ) + 1 := by positivity
        have h4 : ‖x - y‖ < 2 / ((k:ℝ) + 1) := by
          have : 1 / ((k:ℝ)+1) + 1 / ((k:ℝ)+1) = 2 / ((k:ℝ)+1) := by ring
          linarith
        rw [div_lt_iff₀ hδ] at hk
        rw [lt_div_iff₀ hk1] at h4
        nlinarith
      have := Cardinal.mk_le_of_injective hinj
      calc Cardinal.mk ℚ_[ℓ] ≤ Cardinal.mk (ℕ → ℚ) := this
        _ = Cardinal.continuum := by
          rw [← Cardinal.power_def, Cardinal.mk_eq_aleph0 ℚ, Cardinal.mk_eq_aleph0 ℕ,
            Cardinal.aleph0_power_aleph0]
    have hQ : Cardinal.mk ℚ_[ℓ] = Cardinal.continuum := le_antisymm hb ha
    have hK1 : Cardinal.mk ℚ_[ℓ] ≤ Cardinal.mk (AlgebraicClosure ℚ_[ℓ]) :=
      Cardinal.mk_le_of_injective (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])).injective
    have hK2 : Cardinal.mk (AlgebraicClosure ℚ_[ℓ]) ≤ max (Cardinal.mk ℚ_[ℓ]) Cardinal.aleph0 :=
      Algebra.IsAlgebraic.cardinalMk_le_max ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])
    rw [hQ, max_eq_left Cardinal.aleph0_le_continuum] at hK2
    rw [hQ] at hK1
    have hK : Cardinal.mk (AlgebraicClosure ℚ_[ℓ]) = Cardinal.mk ℂ := by
      rw [Cardinal.mk_complex]; exact le_antisymm hK2 hK1
    have heq : Nonempty (AlgebraicClosure ℚ_[ℓ] ≃ ℂ) := Cardinal.eq.mp hK
    have hlt : Cardinal.aleph0 < Cardinal.mk (AlgebraicClosure ℚ_[ℓ]) := by
      rw [le_antisymm hK2 hK1]; exact Cardinal.aleph0_lt_continuum
    obtain ⟨e⟩ := IsAlgClosed.ringEquiv_of_equiv_of_charZero hlt heq
    exact ⟨e.toRingHom.comp (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))⟩
  obtain ⟨σ⟩ := hσ

  have hinv : ∀ (m n : ℕ) (P : Matrix (Fin m) (Fin n) ℚ_[ℓ]),
      (∀ v : Fin m → ℚ_[ℓ], Matrix.vecMul v P = 0 → v = 0) →
      (∀ w : Fin n → ℚ_[ℓ], P.mulVec w = 0 → w = 0) →
      ∃ Q : Matrix (Fin n) (Fin m) ℚ_[ℓ], P * Q = 1 ∧ Q * P = 1 := by
    intro m n P hv hw
    have h1 : Function.Injective (Matrix.mulVecLin P) := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro w hw'; exact hw w hw'
    have h2 : Function.Injective (Matrix.vecMulLinear P) := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro v hv'; exact hv v hv'
    have ha := LinearMap.finrank_le_finrank_of_injective h1
    have hb := LinearMap.finrank_le_finrank_of_injective h2
    simp only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at ha hb
    obtain rfl := le_antisymm hb ha
    have hu : IsUnit P := (Matrix.mulVec_injective_iff_isUnit).mp h1
    have hd : IsUnit P.det := (Matrix.isUnit_iff_isUnit_det P).mp hu
    exact ⟨P⁻¹, Matrix.mul_nonsing_inv P hd, Matrix.nonsing_inv_mul P hd⟩

  set c : ℚ_[ℓ] := (Nat.card F : ℚ_[ℓ]) ^ d with hc
  let r : ℕ → ℕ := fun i => Module.finrank ℚ_[ℓ] (V i)
  let b : ∀ i, Module.Basis (Fin (r i)) ℚ_[ℓ] (V i) := fun i => Module.finBasis ℚ_[ℓ] (V i)
  let M0 : ∀ i, Matrix (Fin (r i)) (Fin (r i)) ℚ_[ℓ] :=
    fun i => LinearMap.toMatrix (b i) (b i) (Φ i)
  let P0 : ∀ i, Matrix (Fin (r i)) (Fin (r (2 * d - i))) ℚ_[ℓ] :=
    fun i => LinearMap.toMatrix₂ (b i) (b (2 * d - i)) (B i)
  have hpair0 : ∀ i ≤ 2 * d, (M0 i).transpose * P0 i * M0 (2 * d - i) = c • P0 i := by
    intro i hi
    have hcB : (B i).compl₁₂ (Φ i) (Φ (2 * d - i)) = c • B i := by
      apply LinearMap.ext₂
      intro x y
      rw [LinearMap.compl₁₂_apply, hcomp i hi x y]
      rfl
    have := congrArg (LinearMap.toMatrix₂ (b i) (b (2 * d - i))) hcB
    rw [LinearMap.toMatrix₂_compl₁₂ (b i) (b (2 * d - i)), map_smul] at this
    exact this
  have hL0 : ∀ i ≤ 2 * d, ∀ v : Fin (r i) → ℚ_[ℓ], Matrix.vecMul v (P0 i) = 0 → v = 0 := by
    intro i hi v hv
    have hx : ∀ j, B i ((b i).equivFun.symm v) (b (2 * d - i) j) = 0 := by
      intro j
      have h := congrFun hv j
      simp only [Matrix.vecMul, dotProduct, P0, LinearMap.toMatrix₂_apply, Pi.zero_apply] at h
      rw [Module.Basis.equivFun_symm_apply, map_sum, LinearMap.sum_apply]
      simpa [map_smul, LinearMap.smul_apply] using h
    have hB0 : B i ((b i).equivFun.symm v) = 0 :=
      (b (2 * d - i)).ext (fun j => by rw [hx j]; rfl)
    have h0 := hL i hi _ (fun y => by rw [hB0]; rfl)
    exact (LinearEquiv.map_eq_zero_iff (b i).equivFun.symm).mp h0
  have hR0 : ∀ i ≤ 2 * d, ∀ w : Fin (r (2 * d - i)) → ℚ_[ℓ], (P0 i).mulVec w = 0 → w = 0 := by
    intro i hi w hw
    have hx : ∀ k, (B i).flip ((b (2 * d - i)).equivFun.symm w) (b i k) = 0 := by
      intro k
      have h := congrFun hw k
      simp only [Matrix.mulVec, dotProduct, P0, LinearMap.toMatrix₂_apply, Pi.zero_apply] at h
      rw [LinearMap.flip_apply, Module.Basis.equivFun_symm_apply, map_sum]
      simpa [map_smul, mul_comm] using h
    have hB0 : (B i).flip ((b (2 * d - i)).equivFun.symm w) = 0 :=
      (b i).ext (fun k => by rw [hx k]; rfl)
    have h0 := hR i hi _ (fun x => by
      have := LinearMap.congr_fun hB0 x
      rw [LinearMap.flip_apply] at this
      exact this)
    exact (LinearEquiv.map_eq_zero_iff (b (2 * d - i)).equivFun.symm).mp h0
  have htrM : ∀ i n, ((M0 i) ^ n).trace = LinearMap.trace ℚ_[ℓ] (V i) (Φ i ^ n) := by
    intro i n
    rw [LinearMap.trace_eq_matrix_trace ℚ_[ℓ] (b i), LinearMap.toMatrix_pow]

  have hmap1 : ∀ (m : ℕ), (1 : Matrix (Fin m) (Fin m) ℚ_[ℓ]).map σ = 1 := fun m =>
    Matrix.map_one σ (map_zero σ) (map_one σ)
  refine ⟨r, fun i => (M0 i).map σ, fun i => (P0 i).map σ, ?_, ?_⟩
  · intro i hi
    obtain ⟨Q, hPQ, hQP⟩ := hinv _ _ (P0 i) (hL0 i hi) (hR0 i hi)
    have hPQσ : (P0 i).map σ * Q.map σ = 1 := by rw [← Matrix.map_mul, hPQ, hmap1]
    have hQPσ : Q.map σ * (P0 i).map σ = 1 := by rw [← Matrix.map_mul, hQP, hmap1]
    refine ⟨?_, ?_, ?_⟩
    · have h := congrArg (fun A => A.map σ) (hpair0 i hi)
      simp only [Matrix.map_mul, Matrix.transpose_map] at h
      rw [h]
      ext k j
      simp [Matrix.map_apply, Matrix.smul_apply, hc, map_pow, map_natCast]
    · intro v hv
      calc v = Matrix.vecMul v ((P0 i).map σ * Q.map σ) := by rw [hPQσ, Matrix.vecMul_one]
        _ = Matrix.vecMul (Matrix.vecMul v ((P0 i).map σ)) (Q.map σ) := by
          rw [Matrix.vecMul_vecMul]
        _ = 0 := by rw [hv, Matrix.zero_vecMul]
    · intro w hw
      calc w = (Q.map σ * (P0 i).map σ).mulVec w := by rw [hQPσ, Matrix.one_mulVec]
        _ = (Q.map σ).mulVec (((P0 i).map σ).mulVec w) := by rw [Matrix.mulVec_mulVec]
        _ = 0 := by rw [hw, Matrix.mulVec_zero]
  · intro E _ _ _
    have h := congrArg σ (htr E)
    rw [map_natCast] at h
    rw [h, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, map_pow, map_neg, map_one, ← htrM i, ← Matrix.map_pow]
    simp [Matrix.trace, Matrix.diag, map_sum]

theorem charpoly_eq_of_compatible_pairing {ι κ : Type} [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ] (A : Matrix ι ι ℂ) (B : Matrix κ κ ℂ) (P : Matrix ι κ ℂ)
    (c : ℂ) (hc : c ≠ 0) (hv : ∀ v : ι → ℂ, Matrix.vecMul v P = 0 → v = 0)
    (hw : ∀ w : κ → ℂ, P.mulVec w = 0 → w = 0) (h : A.transpose * P * B = c • P) :
    IsUnit A ∧ B.charpoly = (c • A⁻¹).charpoly :=
by
  classical

  have hu : IsUnit A := by
    rw [← Matrix.mulVec_injective_iff_isUnit]
    have hker : ∀ u : ι → ℂ, A.mulVec u = 0 → u = 0 := by
      intro u hu0
      apply hv
      have h1 : Matrix.vecMul u (A.transpose * P * B) = c • Matrix.vecMul u P := by
        rw [h, Matrix.vecMul_smul]
      have h2 : Matrix.vecMul u (A.transpose * P * B) = 0 := by
        rw [← Matrix.vecMul_vecMul, ← Matrix.vecMul_vecMul, Matrix.vecMul_transpose, hu0,
          Matrix.zero_vecMul, Matrix.zero_vecMul]
      rw [h2] at h1
      exact (smul_eq_zero.mp h1.symm).resolve_left hc
    intro x y hxy
    exact sub_eq_zero.mp (hker (x - y) (by rw [Matrix.mulVec_sub, hxy, sub_self]))
  refine ⟨hu, ?_⟩

  have hcard : Fintype.card ι = Fintype.card κ := by
    apply le_antisymm
    · have hinj : Function.Injective P.vecMulLinear :=
        (injective_iff_map_eq_zero _).mpr
          (fun a ha => hv a (by rw [Matrix.vecMulLinear_apply] at ha; exact ha))
      have := LinearMap.finrank_le_finrank_of_injective hinj
      simpa [Module.finrank_fintype_fun_eq_card] using this
    · have hinj : Function.Injective P.mulVecLin :=
        (injective_iff_map_eq_zero _).mpr
          (fun a ha => hw a (by rw [Matrix.mulVecLin_apply] at ha; exact ha))
      have := LinearMap.finrank_le_finrank_of_injective hinj
      simpa [Module.finrank_fintype_fun_eq_card] using this

  let e : ι ≃ κ := Fintype.equivOfCardEq hcard
  obtain ⟨Q, hQdef⟩ : ∃ Q : Matrix ι ι ℂ, Q = P.submatrix id e := ⟨_, rfl⟩
  obtain ⟨B', hB'def⟩ : ∃ B' : Matrix ι ι ℂ, B' = B.submatrix e e := ⟨_, rfl⟩
  have hQ : IsUnit Q := by
    rw [← Matrix.mulVec_injective_iff_isUnit]
    have hker : ∀ u : ι → ℂ, Q.mulVec u = 0 → u = 0 := by
      intro u hu0
      have hs := Matrix.submatrix_mulVec_equiv P u id e
      rw [← hQdef, hu0] at hs
      have h1 : P.mulVec (u ∘ e.symm) = 0 := by
        funext i
        exact (congrFun hs i).symm
      have h2 := hw _ h1
      funext i
      have := congrFun h2 (e i)
      simpa using this
    intro x y hxy
    exact sub_eq_zero.mp (hker (x - y) (by rw [Matrix.mulVec_sub, hxy, sub_self]))
  have hEq : A.transpose * Q * B' = c • Q := by
    have e1 : A.transpose * Q = (A.transpose * P).submatrix id e := by
      rw [hQdef, Matrix.submatrix_mul _ _ id id e Function.bijective_id, Matrix.submatrix_id_id]
    rw [e1, hB'def, Matrix.submatrix_mul_equiv, h, hQdef]
    ext i j
    simp
  have hB : B'.charpoly = B.charpoly := by
    have := Matrix.charpoly_reindex e.symm B
    rw [Matrix.reindex_apply, Equiv.symm_symm] at this
    rw [hB'def]
    exact this

  have hAd : IsUnit A.transpose.det := by
    rw [Matrix.det_transpose]; exact (Matrix.isUnit_iff_isUnit_det A).mp hu
  have hQd : IsUnit Q.det := (Matrix.isUnit_iff_isUnit_det Q).mp hQ
  have ha : Q * B' = (c • A.transpose⁻¹) * Q := by
    calc Q * B' = A.transpose⁻¹ * (A.transpose * Q * B') := by
          rw [Matrix.mul_assoc, ← Matrix.mul_assoc A.transpose⁻¹, Matrix.nonsing_inv_mul _ hAd,
            Matrix.one_mul]
      _ = (c • A.transpose⁻¹) * Q := by rw [hEq, Matrix.mul_smul, Matrix.smul_mul]
  have hb : B' = Q⁻¹ * ((c • A.transpose⁻¹) * Q) := by
    rw [← ha, ← Matrix.mul_assoc, Matrix.nonsing_inv_mul _ hQd, Matrix.one_mul]
  rw [← hB, hb, Matrix.charpoly_mul_comm, Matrix.mul_assoc, Matrix.mul_nonsing_inv _ hQd,
    Matrix.mul_one, ← Matrix.transpose_nonsing_inv, ← Matrix.transpose_smul,
    Matrix.charpoly_transpose]

theorem roots_charpoly_smul_inv {ι : Type} [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℂ)
    (c : ℂ) (hc : c ≠ 0) (hA : IsUnit A) :
    (c • A⁻¹).charpoly.roots = A.charpoly.roots.map (c / ·) ∧ (0 : ℂ) ∉ A.charpoly.roots :=
by
  classical
  set R := A.charpoly.roots with hR
  have hdetu : IsUnit A.det := (Matrix.isUnit_iff_isUnit_det A).mp hA
  have hdet : A.det ≠ 0 := hdetu.ne_zero
  have hdetR : A.det = R.prod := Matrix.det_eq_prod_roots_charpoly A
  have hRprod : R.prod ≠ 0 := hdetR ▸ hdet
  have h0 : (0 : ℂ) ∉ R := fun h => hRprod (Multiset.prod_eq_zero h)
  have hcard : Multiset.card R = Fintype.card ι := by
    rw [hR, IsAlgClosed.card_roots_eq_natDegree, Matrix.charpoly_natDegree_eq_dim]
  have heval : ∀ x : ℂ, A.charpoly.eval x = (R.map (fun a => x - a)).prod := fun x =>
    Polynomial.Splits.eval_eq_prod_roots_of_monic (IsAlgClosed.splits _)
      (Matrix.charpoly_monic A) x
  have hevalM : ∀ (M : Matrix ι ι ℂ) (t : ℂ),
      M.charpoly.eval t = (t • (1 : Matrix ι ι ℂ) - M).det := by
    intro M t
    rw [Matrix.eval_charpoly, Matrix.smul_one_eq_diagonal]
    rfl
  have s1 : ∀ t : ℂ, (t • A - c • (1 : Matrix ι ι ℂ)).det
      = (R.map (fun a => t * a - c)).prod := by
    intro t
    by_cases ht : t = 0
    · subst ht
      rw [zero_smul, zero_sub, ← neg_smul, Matrix.det_smul, Matrix.det_one, mul_one]
      rw [Multiset.map_congr rfl (fun a _ => by rw [zero_mul, zero_sub] :
        ∀ a ∈ R, (0 : ℂ) * a - c = -c)]
      rw [Multiset.map_const', Multiset.prod_replicate, hcard]
    · have hmat : t • A - c • (1 : Matrix ι ι ℂ)
          = (-t) • ((c / t) • (1 : Matrix ι ι ℂ) - A) := by
        rw [smul_sub, smul_smul, neg_mul, mul_div_cancel₀ c ht, neg_smul, neg_smul]
        abel
      rw [hmat, Matrix.det_smul, ← hevalM, heval, ← hcard, ← Multiset.prod_replicate,
        ← Multiset.map_const', ← Multiset.prod_map_mul]
      congr 1
      apply Multiset.map_congr rfl
      intro a _
      rw [show -t * (c / t - a) = -(t * (c / t)) + t * a by ring, mul_div_cancel₀ c ht]
      ring
  have hinvA : A⁻¹ * A = 1 := Matrix.nonsing_inv_mul A hdetu
  have s3 : ∀ t : ℂ, (c • A⁻¹).charpoly.eval t = (R.map (fun a => t - c / a)).prod := by
    intro t
    rw [hevalM]
    have hm : (t • (1 : Matrix ι ι ℂ) - c • A⁻¹) * A = t • A - c • (1 : Matrix ι ι ℂ) := by
      rw [sub_mul, smul_mul_assoc, smul_mul_assoc, one_mul, hinvA]
    have hd := congrArg Matrix.det hm
    rw [Matrix.det_mul, s1, hdetR] at hd
    have hRid : R.prod = (R.map (fun a => a)).prod := by rw [Multiset.map_id']
    have key : (R.map (fun a => t - c / a)).prod * R.prod
        = (R.map (fun a => t * a - c)).prod := by
      rw [hRid, ← Multiset.prod_map_mul]
      congr 1
      apply Multiset.map_congr rfl
      intro a ha
      have ha0 : a ≠ 0 := fun h => h0 (h ▸ ha)
      field_simp
    exact mul_right_cancel₀ hRprod (hd.trans key.symm)
  have hpoly : (c • A⁻¹).charpoly
      = ((R.map (c / ·)).map (fun b => Polynomial.X - Polynomial.C b)).prod := by
    apply Polynomial.funext
    intro t
    rw [s3, Polynomial.eval_multiset_prod, Multiset.map_map, Multiset.map_map]
    congr 1
    apply Multiset.map_congr rfl
    intro a _
    simp
  refine ⟨?_, h0⟩
  rw [hpoly, Polynomial.roots_multiset_prod_X_sub_C]

theorem point_count_functional_equation (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    (d : ℕ) [SmoothOfRelativeDimension d X.hom] (m : ℂ →₀ ℤ) (hm0 : (0 : ℂ) ∉ m.support)
    (hmE : ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
        (Nat.card (.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℂ) =
        ∑ α ∈ m.support, (m α : ℂ) * α ^ Module.finrank F E) :
    ∀ α : ℂ, α ≠ 0 → m ((Nat.card F : ℂ) ^ d / α) = m α :=
by
  classical
  intro α _
  have hq : 2 ≤ Nat.card F := Finite.one_lt_card
  set c : ℂ := (Nat.card F : ℂ) ^ d with hc_def
  have hc : c ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr (by omega))

  obtain ⟨r, M, P, hpair, htr⟩ := frobenius_duality_matrices F X d
  set R : ℕ → Multiset ℂ := fun i => (M i).charpoly.roots with hR

  have hRi : ∀ i ≤ 2 * d, R (2 * d - i) = (R i).map (c / ·) ∧ (0 : ℂ) ∉ R i := by
    intro i hi
    obtain ⟨h1, h2, h3⟩ := hpair i hi
    obtain ⟨hu, hch⟩ :=
      charpoly_eq_of_compatible_pairing (M i) (M (2 * d - i)) (P i) c hc h2 h3 h1
    obtain ⟨hr, h0⟩ := roots_charpoly_smul_inv (M i) c hc hu
    refine ⟨?_, h0⟩
    simp only [hR]
    rw [hch, hr]

  have hext : ∀ n : ℕ, 1 ≤ n → ∃ (E : Type u) (_ : Field E) (_ : Algebra F E),
      FiniteDimensional F E ∧ Module.finrank F E = n := by
    intro n hn
    haveI : Fact (Nat.Prime (ringChar F)) := ⟨CharP.char_is_prime F (ringChar F)⟩
    haveI : NeZero n := ⟨by omega⟩
    refine ⟨ULift.{u} (FiniteField.Extension F (ringChar F) n), inferInstance, inferInstance,
      ?_, ?_⟩
    · exact Module.Finite.equiv (ULift.moduleEquiv (R := F)).symm
    · rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := F))]
      exact FiniteField.finrank_extension F (ringChar F) n

  have hpow : ∀ n : ℕ, 1 ≤ n → ∑ β ∈ m.support, (m β : ℂ) * β ^ n =
      ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((R i).map (· ^ n)).sum := by
    intro n hn
    obtain ⟨E, _, _, _, hE⟩ := hext n hn
    rw [← hE, ← hmE E, htr E]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [matrix_trace_pow_eq_sum_roots_pow]

  have key : ∀ (T : Finset ℂ), (0 : ℂ) ∉ T → ∀ g : ℂ → ℂ,
      (∀ n : ℕ, 1 ≤ n → ∑ β ∈ T, g β * β ^ n = 0) → ∀ β ∈ T, g β = 0 := by
    intro T
    induction T using Finset.induction_on with
    | empty => intro _ g _ β hβ; simp at hβ
    | insert a T' haT' ih =>
      intro h0 g hg
      have ha0 : a ≠ 0 := fun h => h0 (h ▸ Finset.mem_insert_self _ _)
      have h0' : (0 : ℂ) ∉ T' := fun h => h0 (Finset.mem_insert_of_mem h)
      have hg' : ∀ n : ℕ, 1 ≤ n → ∑ β ∈ T', (g β * (β - a)) * β ^ n = 0 := by
        intro n hn
        have h1 := hg (n+1) (by omega)
        have h2 := hg n hn
        rw [Finset.sum_insert haT'] at h1 h2
        have e : ∑ β ∈ T', (g β * (β - a)) * β ^ n
            = (g a * a ^ (n+1) + ∑ β ∈ T', g β * β ^ (n+1))
              - a * (g a * a ^ n + ∑ β ∈ T', g β * β ^ n) := by
          rw [mul_add, Finset.mul_sum]
          have e2 : ∑ β ∈ T', (g β * (β - a)) * β ^ n
              = ∑ β ∈ T', g β * β ^ (n+1) - ∑ β ∈ T', a * (g β * β ^ n) := by
            rw [← Finset.sum_sub_distrib]
            exact Finset.sum_congr rfl (fun β _ => by ring)
          rw [e2]; ring
        rw [e, h1, h2]; ring
      have hT' := ih h0' _ hg'
      have hT'0 : ∀ β ∈ T', g β = 0 := by
        intro β hβ
        have hne : β - a ≠ 0 := sub_ne_zero.mpr (fun h => haT' (h ▸ hβ))
        exact (mul_eq_zero.mp (hT' β hβ)).resolve_right hne
      have h1 := hg 1 le_rfl
      rw [Finset.sum_insert haT',
        Finset.sum_eq_zero (fun β hβ => by rw [hT'0 β hβ, zero_mul])] at h1
      have hga : g a = 0 := by
        simp only [pow_one, add_zero] at h1
        exact (mul_eq_zero.mp h1).resolve_right ha0
      intro β hβ
      rcases Finset.mem_insert.mp hβ with rfl | hβ
      · exact hga
      · exact hT'0 β hβ
  have hmcount : ∀ β : ℂ,
      m β = ∑ i ∈ Finset.Iic (2 * d), (-1 : ℤ) ^ i * ((R i).count β : ℤ) := by
    set T := m.support ∪ (Finset.Iic (2 * d)).biUnion (fun i => (R i).toFinset) with hT
    have hT0 : (0 : ℂ) ∉ T := by
      intro h
      rcases Finset.mem_union.mp h with h | h
      · exact hm0 h
      · obtain ⟨i, hi, h0⟩ := Finset.mem_biUnion.mp h
        exact (hRi i (Finset.mem_Iic.mp hi)).2 (Multiset.mem_toFinset.mp h0)
    have hA : ∀ n : ℕ, ∑ β ∈ T, (m β : ℂ) * β ^ n = ∑ β ∈ m.support, (m β : ℂ) * β ^ n := by
      intro n
      symm
      apply Finset.sum_subset Finset.subset_union_left
      intro β _ hβ
      rw [Finsupp.notMem_support_iff.mp hβ]; simp
    have hB : ∀ n : ℕ, ∀ i ∈ Finset.Iic (2 * d),
        ((R i).map (· ^ n)).sum = ∑ β ∈ T, ((R i).count β : ℂ) * β ^ n := by
      intro n i hi
      rw [Finset.sum_multiset_map_count]
      simp only [nsmul_eq_mul]
      apply Finset.sum_subset
      · intro β hβ
        exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨i, hi, hβ⟩)
      · intro β _ hβ
        rw [Multiset.count_eq_zero.mpr (fun h => hβ (Multiset.mem_toFinset.mpr h))]
        simp
    have hg := key T hT0
      (fun β => (m β : ℂ) - ∑ i ∈ Finset.Iic (2 * d), (-1 : ℂ) ^ i * ((R i).count β : ℂ))
      (by
        intro n hn
        have e : ∑ β ∈ T, ((m β : ℂ) -
              ∑ i ∈ Finset.Iic (2 * d), (-1 : ℂ) ^ i * ((R i).count β : ℂ)) * β ^ n
            = ∑ β ∈ T, (m β : ℂ) * β ^ n -
              ∑ i ∈ Finset.Iic (2 * d), (-1 : ℂ) ^ i *
                ∑ β ∈ T, ((R i).count β : ℂ) * β ^ n := by
          simp only [sub_mul, Finset.sum_sub_distrib, Finset.sum_mul, Finset.mul_sum]
          congr 1
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun β _ => by ring))
        rw [e, hA, hpow n hn, sub_eq_zero]
        refine Finset.sum_congr rfl (fun i hi => ?_)
        rw [hB n i hi])
    intro β
    by_cases hβ : β ∈ T
    · have h := hg β hβ
      simp only [sub_eq_zero] at h
      exact_mod_cast h
    · have hm : m β = 0 :=
        Finsupp.notMem_support_iff.mp (fun h => hβ (Finset.mem_union_left _ h))
      rw [hm]
      symm
      apply Finset.sum_eq_zero
      intro i hi
      rw [Multiset.count_eq_zero.mpr (fun h => hβ (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨i, hi, Multiset.mem_toFinset.mpr h⟩)))]
      simp

  have hinv : ∀ β : ℂ, c / (c / β) = β := by
    intro β
    by_cases hβ : β = 0
    · simp [hβ]
    · field_simp
  have hinj : Function.Injective (fun x : ℂ => c / x) := by
    intro x y h
    have h' := congrArg (fun z => c / z) h
    simp only [hinv] at h'
    exact h'
  have hcnt : ∀ i ≤ 2 * d, ∀ β, (R (2 * d - i)).count β = (R i).count (c / β) := by
    intro i hi β
    rw [(hRi i hi).1]
    conv_lhs => rw [← hinv β]
    exact Multiset.count_map_eq_count' _ _ hinj _
  have hsign : ∀ i ≤ 2 * d, (-1 : ℤ) ^ (2 * d - i) = (-1) ^ i := by
    intro i hi
    rw [neg_one_pow_eq_pow_mod_two, neg_one_pow_eq_pow_mod_two (n := i)]
    congr 1
    omega
  rw [hmcount, hmcount]
  apply Finset.sum_nbij' (fun i => 2 * d - i) (fun i => 2 * d - i)
  · intro i hi
    simp only [Finset.mem_Iic, Finset.coe_Iic, Set.mem_Iic] at hi ⊢
    omega
  · intro i hi
    simp only [Finset.mem_Iic, Finset.coe_Iic, Set.mem_Iic] at hi ⊢
    omega
  · intro i hi
    simp only [Finset.mem_Iic, Finset.coe_Iic, Set.mem_Iic] at hi
    omega
  · intro i hi
    simp only [Finset.mem_Iic, Finset.coe_Iic, Set.mem_Iic] at hi
    omega
  · intro i hi
    have hi' : i ≤ 2 * d := by
      simpa only [Finset.mem_Iic, Finset.coe_Iic, Set.mem_Iic] using hi
    rw [hsign i hi', hcnt i hi']

theorem isIntegral_of_int_power_sums (m : ℂ →₀ ℤ) (hm0 : (0 : ℂ) ∉ m.support)
    (hint : ∀ n : ℕ, 1 ≤ n → ∃ k : ℤ, ∑ α ∈ m.support, (m α : ℂ) * α ^ n = k) :
    ∀ α ∈ m.support, IsIntegral ℤ α :=
by
  classical
  intro α hα
  set S := m.support with hS
  set P : Polynomial ℂ := ∏ β ∈ S.erase α, (Polynomial.X - Polynomial.C β) with hP
  set Q : ℂ := ∏ β ∈ S.erase α, (α - β) with hQ
  have hα0 : α ≠ 0 := fun h => hm0 (h ▸ hα)
  have hcα : (m α : ℂ) ≠ 0 := by
    have := (Finsupp.mem_support_iff.mp hα)
    exact_mod_cast this
  have hQ0 : Q ≠ 0 := by
    rw [hQ, Finset.prod_ne_zero_iff]
    intro β hβ
    exact sub_ne_zero.mpr (Finset.ne_of_mem_erase hβ).symm
  have hPeval : ∀ β, P.eval β = ∏ γ ∈ S.erase α, (β - γ) := by
    intro β
    rw [hP, Polynomial.eval_prod]
    simp
  have iso : ∀ n : ℕ, ∑ k ∈ Finset.range (P.natDegree + 1),
      P.coeff k * ∑ β ∈ S, (m β : ℂ) * β ^ (n + k) = (m α : ℂ) * α ^ n * Q := by
    intro n
    calc ∑ k ∈ Finset.range (P.natDegree + 1), P.coeff k * ∑ β ∈ S, (m β : ℂ) * β ^ (n + k)
        = ∑ β ∈ S, (m β : ℂ) * β ^ n *
            ∑ k ∈ Finset.range (P.natDegree + 1), P.coeff k * β ^ k := by
          simp_rw [Finset.mul_sum]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun β _ => Finset.sum_congr rfl fun k _ => ?_
          rw [pow_add]; ring
      _ = ∑ β ∈ S, (m β : ℂ) * β ^ n * P.eval β := by
          refine Finset.sum_congr rfl fun β _ => ?_
          rw [Polynomial.eval_eq_sum_range]
      _ = (m α : ℂ) * α ^ n * P.eval α := by
          refine Finset.sum_eq_single α ?_ ?_
          · intro β hβ hne
            rw [hPeval, Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨hne, hβ⟩) (sub_self β),
              mul_zero]
          · intro h; exact absurd hα h
      _ = (m α : ℂ) * α ^ n * Q := by rw [hPeval]
  set γ : ℂ := ((m α : ℂ) * Q)⁻¹ with hγ
  set G : Finset ℂ := (Finset.range (P.natDegree + 1)).image (fun k => γ * P.coeff k) with hG
  have hspan : ∀ n : ℕ, 1 ≤ n → α ^ n ∈ Submodule.span ℤ (G : Set ℂ) := by
    intro n hn
    have h1 : α ^ n = ∑ k ∈ Finset.range (P.natDegree + 1),
        (∑ β ∈ S, (m β : ℂ) * β ^ (n + k)) * (γ * P.coeff k) := by
      have : α ^ n = γ * ((m α : ℂ) * α ^ n * Q) := by
        rw [hγ]; field_simp
      rw [this, ← iso n, Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      ring
    rw [h1]
    refine Submodule.sum_mem _ fun k hk => ?_
    obtain ⟨z, hz⟩ := hint (n + k) (by omega)
    rw [hz, ← zsmul_eq_mul]
    exact Submodule.smul_mem _ z
      (Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hk)))
  let N : Submodule ℤ ℂ := Submodule.span ℤ (Set.range (fun n : ℕ => α ^ (n + 1)))
  have hNle : N ≤ Submodule.span ℤ (G : Set ℂ) := by
    rw [Submodule.span_le]
    rintro _ ⟨n, rfl⟩
    exact hspan (n + 1) (by omega)
  have hNfg : N.FG := Submodule.FG.of_le (Submodule.fg_span G.finite_toSet) hNle
  have hαN : α ∈ N := Submodule.subset_span ⟨0, by simp⟩
  have hNbot : N ≠ ⊥ := by
    intro h
    have h' : α ∈ (⊥ : Submodule ℤ ℂ) := h ▸ hαN
    rw [Submodule.mem_bot] at h'
    exact hα0 h'
  have hsmul : ∀ x ∈ N, α • x ∈ N := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨n, rfl⟩ := hy
      exact Submodule.subset_span ⟨n + 1, by simp only [smul_eq_mul]; ring⟩
    | zero => simp
    | add x y _ _ hx hy => rw [smul_add]; exact N.add_mem hx hy
    | smul a x _ hx => rw [smul_comm]; exact N.smul_mem a hx
  exact isIntegral_of_smul_mem_submodule N hNbot hNfg α hsmul

theorem galois_invariant_of_int_power_sums (m : ℂ →₀ ℤ) (hm0 : (0 : ℂ) ∉ m.support)
    (hint : ∀ n : ℕ, 1 ≤ n → ∃ k : ℤ, ∑ α ∈ m.support, (m α : ℂ) * α ^ n = k) :
    ∀ (φ : ℂ ≃+* ℂ) (α : ℂ), m (φ α) = m α :=
by
  classical

  have key : ∀ (T : Finset ℂ), (0 : ℂ) ∉ T → ∀ c : ℂ → ℂ,
      (∀ n : ℕ, 1 ≤ n → ∑ β ∈ T, c β * β ^ n = 0) → ∀ β ∈ T, c β = 0 := by
    intro T
    induction T using Finset.induction_on with
    | empty => intro _ c _ β hβ; simp at hβ
    | insert a T' haT' ih =>
      intro h0 c hc
      have ha0 : a ≠ 0 := fun h => h0 (h ▸ Finset.mem_insert_self _ _)
      have h0' : (0 : ℂ) ∉ T' := fun h => h0 (Finset.mem_insert_of_mem h)
      have hc' : ∀ n : ℕ, 1 ≤ n → ∑ β ∈ T', (c β * (β - a)) * β ^ n = 0 := by
        intro n hn
        have h1 := hc (n+1) (by omega)
        have h2 := hc n hn
        rw [Finset.sum_insert haT'] at h1 h2
        have e : ∑ β ∈ T', (c β * (β - a)) * β ^ n
            = (c a * a ^ (n+1) + ∑ β ∈ T', c β * β ^ (n+1))
              - a * (c a * a ^ n + ∑ β ∈ T', c β * β ^ n) := by
          rw [mul_add, Finset.mul_sum]
          have e2 : ∑ β ∈ T', (c β * (β - a)) * β ^ n
              = ∑ β ∈ T', c β * β ^ (n+1) - ∑ β ∈ T', a * (c β * β ^ n) := by
            rw [← Finset.sum_sub_distrib]
            exact Finset.sum_congr rfl (fun β _ => by ring)
          rw [e2]; ring
        rw [e, h1, h2]; ring
      have hT' := ih h0' _ hc'
      have hT'0 : ∀ β ∈ T', c β = 0 := by
        intro β hβ
        have hne : β - a ≠ 0 := sub_ne_zero.mpr (fun h => haT' (h ▸ hβ))
        exact (mul_eq_zero.mp (hT' β hβ)).resolve_right hne
      have h1 := hc 1 le_rfl
      rw [Finset.sum_insert haT',
        Finset.sum_eq_zero (fun β hβ => by rw [hT'0 β hβ, zero_mul])] at h1
      have hca : c a = 0 := by
        simp only [pow_one, add_zero] at h1
        exact (mul_eq_zero.mp h1).resolve_right ha0
      intro β hβ
      rcases Finset.mem_insert.mp hβ with rfl | hβ
      · exact hca
      · exact hT'0 β hβ
  intro φ α
  set S := m.support with hS
  set T := S ∪ S.image φ with hT
  have hT0 : (0 : ℂ) ∉ T := by
    intro h
    rcases Finset.mem_union.mp h with h | h
    · exact hm0 h
    · obtain ⟨γ, hγ, hγ0⟩ := Finset.mem_image.mp h
      have : γ = 0 := (map_eq_zero_iff φ φ.injective).mp hγ0
      exact hm0 (this ▸ hγ)
  have hA : ∀ n : ℕ, ∑ α ∈ S, (m α : ℂ) * α ^ n = ∑ β ∈ T, (m β : ℂ) * β ^ n := by
    intro n
    apply Finset.sum_subset Finset.subset_union_left
    intro β _ hβ
    rw [Finsupp.notMem_support_iff.mp hβ]; simp
  have hB : ∀ n : ℕ, ∑ α ∈ S, (m α : ℂ) * (φ α) ^ n
      = ∑ β ∈ T, (m (φ.symm β) : ℂ) * β ^ n := by
    intro n
    have e1 : ∑ β ∈ S.image φ, (m (φ.symm β) : ℂ) * β ^ n
        = ∑ α ∈ S, (m α : ℂ) * (φ α) ^ n := by
      rw [Finset.sum_image (fun x _ y _ h => φ.injective h)]
      simp
    rw [← e1]
    apply Finset.sum_subset Finset.subset_union_right
    intro β _ hβ
    have : φ.symm β ∉ S := by
      intro h
      exact hβ (Finset.mem_image.mpr ⟨φ.symm β, h, by simp⟩)
    rw [Finsupp.notMem_support_iff.mp this]; simp
  have hC : ∀ n : ℕ, 1 ≤ n →
      ∑ α ∈ S, (m α : ℂ) * (φ α) ^ n = ∑ α ∈ S, (m α : ℂ) * α ^ n := by
    intro n hn
    obtain ⟨k, hk⟩ := hint n hn
    have h := congrArg φ hk
    rw [map_sum, map_intCast] at h
    simp only [map_mul, map_pow, map_intCast] at h
    rw [h, hk]
  have hcz := key T hT0 (fun β => (m β : ℂ) - (m (φ.symm β) : ℂ)) (by
    intro n hn
    simp only [sub_mul, Finset.sum_sub_distrib]
    rw [← hA, ← hB, hC n hn, sub_self])
  have hmT : ∀ β ∈ T, m β = m (φ.symm β) := by
    intro β hβ
    have h := hcz β hβ
    exact_mod_cast sub_eq_zero.mp h
  by_cases hα : α ∈ S
  · have hmem : φ α ∈ T := Finset.mem_union_right _ (Finset.mem_image_of_mem _ hα)
    rw [hmT _ hmem, RingEquiv.symm_apply_apply]
  · have hα0 : m α = 0 := Finsupp.notMem_support_iff.mp hα
    rw [hα0]
    by_contra hne
    have hmem : φ α ∈ S := Finsupp.mem_support_iff.mpr hne
    have h := hmT _ (Finset.mem_union_left _ hmem)
    rw [RingEquiv.symm_apply_apply, hα0] at h
    exact hne h

theorem weight_zero_of_asymptotic (q d : ℕ) (m : ℂ →₀ ℤ) (hq : 2 ≤ q)
    (hm0 : (0 : ℂ) ∉ m.support)
    (hw : ∀ α ∈ m.support, ∃ i ≤ 2 * d, ‖α‖ = √((q : ℝ) ^ i))
    (hdual : ∀ α : ℂ, α ≠ 0 → m ((q : ℂ) ^ d / α) = m α)
    (htend : Filter.Tendsto (fun n : ℕ => (∑ α ∈ m.support, (m α : ℂ) * α ^ n) / (q : ℂ) ^ (d * n))
      Filter.atTop (nhds 1)) :
    m 1 = 1 ∧ ∀ α ∈ m.support, ‖α‖ = 1 → α = 1 :=
by
  classical

  have s1 : ∀ g : ℂ, ‖g‖ ≤ 1 → Filter.Tendsto
      (fun N : ℕ => (N : ℝ)⁻¹ • ∑ n ∈ Finset.range N, g ^ n) Filter.atTop
      (nhds (if g = 1 then (1 : ℂ) else 0)) := by
    intro g hg
    by_cases h1 : g = 1
    · subst h1
      rw [if_pos rfl]
      apply tendsto_const_nhds.congr'
      filter_upwards [Filter.eventually_ge_atTop 1] with N hN
      have hN' : (N : ℝ) ≠ 0 := by
        have : (1 : ℝ) ≤ N := by exact_mod_cast hN
        linarith
      simp only [one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
      rw [Complex.real_smul]
      push_cast
      have hN'' : (N : ℂ) ≠ 0 := by exact_mod_cast hN'
      field_simp
    · rw [if_neg h1]
      have hpos : 0 < ‖g - 1‖ := norm_pos_iff.mpr (sub_ne_zero.mpr h1)
      apply squeeze_zero_norm (a := fun N : ℕ => (2 / ‖g - 1‖) / (N : ℝ))
      · intro N
        rw [norm_smul, geom_sum_eq h1, norm_div, Real.norm_eq_abs, abs_inv, Nat.abs_cast,
          div_eq_inv_mul (2 / ‖g - 1‖)]
        have hb : ‖g ^ N - 1‖ ≤ 2 := by
          calc ‖g ^ N - 1‖ ≤ ‖g ^ N‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
            _ ≤ 1 + 1 := by
                rw [norm_pow, norm_one]
                gcongr
                exact pow_le_one₀ (norm_nonneg _) hg
            _ = 2 := by norm_num
        exact mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right hb hpos.le)
          (inv_nonneg.mpr (Nat.cast_nonneg N))
      · exact tendsto_const_div_atTop_nhds_zero_nat (2 / ‖g - 1‖)

  have s2 : ∀ (w : ℕ → ℂ) (L g : ℂ), Filter.Tendsto w Filter.atTop (nhds L) → ‖g‖ ≤ 1 →
      Filter.Tendsto (fun N : ℕ => (N : ℝ)⁻¹ • ∑ n ∈ Finset.range N, (w n - L) * g ^ n)
        Filter.atTop (nhds 0) := by
    intro w L g hwL hg
    apply Filter.Tendsto.cesaro_smul
    have h0 : Filter.Tendsto (fun n => ‖w n - L‖) Filter.atTop (nhds 0) :=
      tendsto_iff_norm_sub_tendsto_zero.mp hwL
    apply squeeze_zero_norm _ h0
    intro n
    rw [norm_mul, norm_pow]
    calc ‖w n - L‖ * ‖g‖ ^ n ≤ ‖w n - L‖ * 1 := by
          gcongr
          exact pow_le_one₀ (norm_nonneg _) hg
      _ = ‖w n - L‖ := mul_one _

  have s7 : ∀ β : ℂ, β ≠ 0 → (∀ α ∈ m.support, ‖α‖ ≤ ‖β‖) → Filter.Tendsto
      (fun N : ℕ => (N : ℝ)⁻¹ • ∑ n ∈ Finset.range N, ∑ α ∈ m.support, (m α : ℂ) * (α / β) ^ n)
      Filter.atTop (nhds (m β : ℂ)) := by
    intro β hβ hle
    have heq : (fun N : ℕ => (N : ℝ)⁻¹ • ∑ n ∈ Finset.range N,
        ∑ α ∈ m.support, (m α : ℂ) * (α / β) ^ n) = fun N : ℕ => ∑ α ∈ m.support,
        (m α : ℂ) * ((N : ℝ)⁻¹ • ∑ n ∈ Finset.range N, (α / β) ^ n) := by
      funext N
      rw [Finset.sum_comm, Finset.smul_sum]
      refine Finset.sum_congr rfl fun α _ => ?_
      rw [← Finset.mul_sum, mul_smul_comm]
    rw [heq]
    have hlim : Filter.Tendsto (fun N : ℕ => ∑ α ∈ m.support,
        (m α : ℂ) * ((N : ℝ)⁻¹ • ∑ n ∈ Finset.range N, (α / β) ^ n)) Filter.atTop
        (nhds (∑ α ∈ m.support, (m α : ℂ) * (if α / β = 1 then 1 else 0))) := by
      apply tendsto_finset_sum
      intro α hα
      apply Filter.Tendsto.const_mul
      apply s1
      rw [norm_div]
      exact div_le_one_of_le₀ (hle α hα) (norm_nonneg _)
    have hval : (∑ α ∈ m.support, (m α : ℂ) * (if α / β = 1 then 1 else 0)) = (m β : ℂ) := by
      simp only [div_eq_one_iff_eq hβ, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq']
      split_ifs with h
      · rfl
      · rw [Finsupp.notMem_support_iff.mp h]; simp
    rw [hval] at hlim
    exact hlim

  simp only [pow_mul] at htend
  set R : ℂ := (q : ℂ) ^ d with hRdef
  have hqpos : (0 : ℝ) < q := by exact_mod_cast (by omega : 0 < q)
  have hnR : ‖R‖ = (q : ℝ) ^ d := by rw [hRdef, norm_pow, Complex.norm_natCast]
  have hRpos : 0 < ‖R‖ := by rw [hnR]; positivity
  have hR0 : R ≠ 0 := norm_pos_iff.mp hRpos
  have hle : ∀ α ∈ m.support, ‖α‖ ≤ ‖R‖ := by
    intro α hα
    obtain ⟨i, hi, hn⟩ := hw α hα
    rw [hn, hnR]
    have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast (by omega : 1 ≤ q)
    calc √((q : ℝ) ^ i) ≤ √((q : ℝ) ^ (2 * d)) :=
          Real.sqrt_le_sqrt (pow_le_pow_right₀ hq1 hi)
      _ = (q : ℝ) ^ d := by rw [mul_comm, pow_mul, Real.sqrt_sq (by positivity)]
  set w : ℕ → ℂ := fun n => (∑ α ∈ m.support, (m α : ℂ) * α ^ n) / R ^ n with hw_def
  have hwt : Filter.Tendsto w Filter.atTop (nhds 1) := htend

  have s5 : ∀ β : ℂ, ‖β‖ = ‖R‖ → (m β : ℂ) = if β = R then 1 else 0 := by
    intro β hβn
    have hβ0 : β ≠ 0 := by rw [← norm_pos_iff, hβn]; exact hRpos
    have hg : ‖R / β‖ ≤ 1 := by rw [norm_div, hβn, div_self hRpos.ne']
    have hb := s7 β hβ0 (fun α hα => hβn ▸ hle α hα)
    have hid : ∀ n : ℕ, ∑ α ∈ m.support, (m α : ℂ) * (α / β) ^ n =
        (w n - 1) * (R / β) ^ n + (R / β) ^ n := by
      intro n
      have hRn : R ^ n ≠ 0 := pow_ne_zero _ hR0
      have hβn' : β ^ n ≠ 0 := pow_ne_zero _ hβ0
      rw [show (w n - 1) * (R / β) ^ n + (R / β) ^ n = w n * (R / β) ^ n by ring]
      simp only [hw_def, div_pow, Finset.sum_div, Finset.sum_mul]
      refine Finset.sum_congr rfl fun α _ => ?_
      field_simp
    have hc : Filter.Tendsto (fun N : ℕ => (N : ℝ)⁻¹ • ∑ n ∈ Finset.range N,
        ∑ α ∈ m.support, (m α : ℂ) * (α / β) ^ n) Filter.atTop
        (nhds (0 + if R / β = 1 then (1 : ℂ) else 0)) := by
      have := (s2 w 1 (R / β) hwt hg).add (s1 (R / β) hg)
      refine this.congr (fun N => ?_)
      rw [← smul_add, ← Finset.sum_add_distrib]
      simp only [hid]
    have hu := tendsto_nhds_unique hb hc
    rw [hu, zero_add]
    by_cases h : β = R
    · rw [if_pos h, if_pos ((div_eq_one_iff_eq hβ0).mpr h.symm)]
    · rw [if_neg h, if_neg (fun h' => h ((div_eq_one_iff_eq hβ0).mp h').symm)]

  have hRR := s5 R rfl
  rw [if_pos rfl] at hRR
  have hmR : m R = 1 := by exact_mod_cast hRR
  refine ⟨?_, ?_⟩
  · have h1 := hdual R hR0
    rw [div_self hR0] at h1
    rw [h1, hmR]
  · intro α hα hα1
    have hα0 : α ≠ 0 := by rw [← norm_pos_iff, hα1]; norm_num
    have hd := hdual α hα0
    have hβn : ‖R / α‖ = ‖R‖ := by rw [norm_div, hα1, div_one]
    have h5 := s5 (R / α) hβn
    have hne : m α ≠ 0 := Finsupp.mem_support_iff.mp hα
    by_cases h : R / α = R
    · rw [div_eq_iff hα0] at h
      exact mul_left_cancel₀ hR0 (h.symm.trans (mul_one R).symm)
    · rw [if_neg h, hd] at h5
      exact absurd (by exact_mod_cast h5) hne

theorem assemble_weil_multisets (q d : ℕ) (m : ℂ →₀ ℤ) (hq : 2 ≤ q)
    (hm0 : (0 : ℂ) ∉ m.support)
    (hpure : ∀ α ∈ m.support, ∃ i ≤ 2 * d, 0 < (-1 : ℤ) ^ i * m α ∧
      ∀ φ : ℂ ≃+* ℂ, ‖φ α‖ = √((q : ℝ) ^ i))
    (hw0 : m 1 = 1 ∧ ∀ α ∈ m.support, ‖α‖ = 1 → α = 1)
    (hdual : ∀ α : ℂ, α ≠ 0 → m ((q : ℂ) ^ d / α) = m α)
    (hintegral : ∀ α ∈ m.support, IsIntegral ℤ α)
    (hgal : ∀ (φ : ℂ ≃+* ℂ) (α : ℂ), m (φ α) = m α) :
    ∃ A : ℕ → Multiset ℂ, A 0 = {1} ∧
      (∀ i ≤ 2 * d, A (2 * d - i) = (A i).map ((q : ℂ) ^ d / · : ℂ → ℂ) ∧
        (∀ φ : ℂ ≃+* ℂ, (A i).map φ = A i) ∧
        ∀ α ∈ A i, IsIntegral ℤ α ∧ ‖α‖ = √((q : ℝ) ^ i)) ∧
      ∀ n : ℕ, ∑ α ∈ m.support, (m α : ℂ) * α ^ n =
        ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((A i).map (· ^ n)).sum :=
by
  classical
  have hq0 : (0 : ℝ) < q := by exact_mod_cast (show 0 < q by omega)

  have huniq : ∀ i j : ℕ, √((q : ℝ) ^ i) = √((q : ℝ) ^ j) → i = j := by
    intro i j h
    rw [Real.sqrt_inj (pow_pos hq0 i).le (pow_pos hq0 j).le] at h
    have h' : ((q ^ i : ℕ) : ℝ) = ((q ^ j : ℕ) : ℝ) := by push_cast; exact h
    exact Nat.pow_right_injective hq (Nat.cast_inj.mp h')

  have s1 : ∀ (S : Finset ℂ) (c : ℂ → ℕ) (n : ℕ),
      ((∑ α ∈ S, Multiset.replicate (c α) α).map (· ^ n)).sum = ∑ α ∈ S, (c α : ℂ) * α ^ n := by
    intro S c n
    induction S using Finset.induction_on with
    | empty => simp
    | insert a S ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, Multiset.map_add, Multiset.sum_add, ih,
        Multiset.map_replicate, Multiset.sum_replicate, nsmul_eq_mul]

  have hmapsum : ∀ (S : Finset ℂ) (c : ℂ → ℕ) (τ : ℂ → ℂ),
      (∑ α ∈ S, Multiset.replicate (c α) α).map τ = ∑ α ∈ S, Multiset.replicate (c α) (τ α) := by
    intro S c τ
    induction S using Finset.induction_on with
    | empty => simp
    | insert a S ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, Multiset.map_add, ih, Multiset.map_replicate]

  have s2 : ∀ (S T : Finset ℂ) (c : ℂ → ℕ) (τ σ : ℂ → ℂ), (∀ α ∈ S, τ α ∈ T) →
      (∀ β ∈ T, σ β ∈ S) → (∀ α ∈ S, σ (τ α) = α) → (∀ β ∈ T, τ (σ β) = β) →
      (∀ α ∈ S, c (τ α) = c α) →
      (∑ α ∈ S, Multiset.replicate (c α) α).map τ = ∑ β ∈ T, Multiset.replicate (c β) β := by
    intro S T c τ σ hτ hσ hστ hτσ hc
    rw [hmapsum]
    exact Finset.sum_nbij' τ σ hτ hσ hστ hτσ (fun α hα => by rw [hc α hα])

  have s3 : ∀ i, i ≤ 2 * d → ∀ α : ℂ, ‖α‖ = √((q : ℝ) ^ i) →
      ‖(q : ℂ) ^ d / α‖ = √((q : ℝ) ^ (2 * d - i)) := by
    intro i hi α hα
    rw [norm_div, norm_pow, Complex.norm_natCast, hα]
    have hb : 0 < √((q : ℝ) ^ i) := Real.sqrt_pos.mpr (pow_pos hq0 i)
    rw [div_eq_iff hb.ne', ← Real.sqrt_mul (pow_pos hq0 _).le, ← pow_add, Nat.sub_add_cancel hi,
      pow_mul', Real.sqrt_sq (pow_pos hq0 _).le]

  obtain ⟨S, hS⟩ : ∃ S : ℕ → Finset ℂ,
      ∀ i, S i = m.support.filter (fun α => ‖α‖ = √((q : ℝ) ^ i)) := ⟨_, fun _ => rfl⟩
  have hmemS : ∀ i α, α ∈ S i ↔ m α ≠ 0 ∧ ‖α‖ = √((q : ℝ) ^ i) := by
    intro i α
    rw [hS, Finset.mem_filter, Finsupp.mem_support_iff]
  have hne0 : ∀ α, m α ≠ 0 → α ≠ 0 := by
    rintro α h rfl
    exact hm0 (Finsupp.mem_support_iff.mpr h)
  have hqd : (q : ℂ) ^ d ≠ 0 := pow_ne_zero _ (by exact_mod_cast (show q ≠ 0 by omega))
  refine ⟨fun i => ∑ α ∈ S i, Multiset.replicate (m α).natAbs α, ?_, ?_, ?_⟩
  ·
    have hS0 : S 0 = {1} := by
      ext α
      rw [hmemS, Finset.mem_singleton, pow_zero, Real.sqrt_one]
      constructor
      · rintro ⟨h1, h2⟩
        exact hw0.2 α (Finsupp.mem_support_iff.mpr h1) h2
      · rintro rfl
        exact ⟨by rw [hw0.1]; norm_num, norm_one⟩
    show ∑ α ∈ S 0, Multiset.replicate (m α).natAbs α = {1}
    rw [hS0, Finset.sum_singleton, hw0.1]
    rfl
  · intro i hi
    refine ⟨?_, ?_, ?_⟩
    ·
      refine (s2 (S i) (S (2 * d - i)) (fun α => (m α).natAbs) (fun x => (q : ℂ) ^ d / x)
        (fun x => (q : ℂ) ^ d / x) ?_ ?_ ?_ ?_ ?_).symm
      · intro α hα
        rw [hmemS] at hα ⊢
        obtain ⟨h1, h2⟩ := hα
        exact ⟨by rw [hdual α (hne0 α h1)]; exact h1, s3 i hi α h2⟩
      · intro β hβ
        rw [hmemS] at hβ ⊢
        obtain ⟨h1, h2⟩ := hβ
        have := s3 (2 * d - i) (by omega) β h2
        rw [show 2 * d - (2 * d - i) = i by omega] at this
        exact ⟨by rw [hdual β (hne0 β h1)]; exact h1, this⟩
      · intro α _
        exact div_div_cancel₀ hqd
      · intro β _
        exact div_div_cancel₀ hqd
      · intro α hα
        rw [hmemS] at hα
        show (m ((q : ℂ) ^ d / α)).natAbs = (m α).natAbs
        rw [hdual α (hne0 α hα.1)]
    ·
      intro φ
      refine s2 (S i) (S i) (fun α => (m α).natAbs) φ φ.symm ?_ ?_ ?_ ?_ ?_
      · intro α hα
        rw [hmemS] at hα ⊢
        obtain ⟨h1, h2⟩ := hα
        obtain ⟨j, -, -, hj⟩ := hpure α (Finsupp.mem_support_iff.mpr h1)
        have hr := hj (RingEquiv.refl ℂ)
        rw [RingEquiv.refl_apply] at hr
        refine ⟨by rw [hgal]; exact h1, ?_⟩
        rw [hj φ, ← hr, h2]
      · intro β hβ
        rw [hmemS] at hβ ⊢
        obtain ⟨h1, h2⟩ := hβ
        have hm : m β = m (φ.symm β) := by
          have := hgal φ (φ.symm β)
          rwa [RingEquiv.apply_symm_apply] at this
        have h1' : m (φ.symm β) ≠ 0 := by rw [← hm]; exact h1
        obtain ⟨j, -, -, hj⟩ := hpure (φ.symm β) (Finsupp.mem_support_iff.mpr h1')
        have hr := hj (RingEquiv.refl ℂ)
        rw [RingEquiv.refl_apply] at hr
        have hφ := hj φ
        rw [RingEquiv.apply_symm_apply] at hφ
        exact ⟨h1', by rw [hr, ← hφ, h2]⟩
      · intro α _
        exact φ.symm_apply_apply α
      · intro β _
        exact φ.apply_symm_apply β
      · intro α _
        show (m (φ α)).natAbs = (m α).natAbs
        rw [hgal]
    ·
      intro α hα
      obtain ⟨β, hβ, hαβ⟩ := Multiset.mem_sum.mp hα
      rw [Multiset.mem_replicate] at hαβ
      rw [hαβ.2]
      rw [hmemS] at hβ
      exact ⟨hintegral β (Finsupp.mem_support_iff.mpr hβ.1), hβ.2⟩
  ·
    intro n
    have hR : ∑ i ∈ Finset.Iic (2 * d), (-1 : ℂ) ^ i *
        ((∑ α ∈ S i, Multiset.replicate (m α).natAbs α).map (· ^ n)).sum =
        ∑ i ∈ Finset.Iic (2 * d), ∑ α ∈ m.support,
          if ‖α‖ = √((q : ℝ) ^ i) then (-1 : ℂ) ^ i * (((m α).natAbs : ℂ) * α ^ n) else 0 := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [s1 (S i) (fun α => (m α).natAbs) n, hS, Finset.mul_sum, Finset.sum_filter]
    show ∑ α ∈ m.support, (m α : ℂ) * α ^ n = ∑ i ∈ Finset.Iic (2 * d), (-1 : ℂ) ^ i *
        ((∑ α ∈ S i, Multiset.replicate (m α).natAbs α).map (· ^ n)).sum
    rw [hR, Finset.sum_comm]
    refine Finset.sum_congr rfl (fun α hα => ?_)
    obtain ⟨i₀, hi₀, hpos, hφ⟩ := hpure α hα
    have hn : ‖α‖ = √((q : ℝ) ^ i₀) := by
      have := hφ (RingEquiv.refl ℂ)
      rwa [RingEquiv.refl_apply] at this
    rw [Finset.sum_eq_single_of_mem i₀ (Finset.mem_Iic.mpr hi₀)
      (fun j _ hj => if_neg (fun h => hj (huniq _ _ (h.symm.trans hn)))), if_pos hn]
    have key : (-1 : ℤ) ^ i₀ * ((m α).natAbs : ℤ) = m α := by
      rcases neg_one_pow_eq_or ℤ i₀ with h | h <;> rw [h] at hpos ⊢
      · rw [one_mul] at hpos ⊢
        exact Int.natAbs_of_nonneg hpos.le
      · rw [neg_one_mul] at hpos ⊢
        rw [Int.ofNat_natAbs_of_nonpos (by linarith)]
        ring
    have key' : ((((-1 : ℤ) ^ i₀ * ((m α).natAbs : ℤ) : ℤ)) : ℂ) = (m α : ℂ) := by rw [key]
    rw [Int.cast_mul, Int.cast_pow, Int.cast_neg, Int.cast_one, Int.cast_natCast] at key'
    rw [← mul_assoc, key']

theorem weil_conjectures (F : Type*) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    (d : ℕ) [SmoothOfRelativeDimension d X.hom] :
    ∃ A : ℕ → Multiset ℂ, A 0 = {1} ∧
      (∀ i ≤ 2 * d, A (2 * d - i) = (A i).map (Nat.card F ^ d / · : ℂ → ℂ) ∧
        (∀ φ : ℂ ≃+* ℂ, (A i).map φ = A i) ∧
        ∀ α ∈ A i, IsIntegral ℤ α ∧ ‖α‖ = √(Nat.card F ^ i)) ∧
      ∀ (E : Type _) [Field E] [Algebra F E] [FiniteDimensional F E],
        Nat.card (.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) =
        ∑ i ∈ Finset.Iic (2 * d), (-1) ^ i * ((A i).map (· ^ Module.finrank F E)).sum :=
by
  classical

  have hq : 2 ≤ Nat.card F := Finite.one_lt_card

  have hext : ∀ n : ℕ, 1 ≤ n → ∃ (E : Type u_1) (_ : Field E) (_ : Algebra F E),
      FiniteDimensional F E ∧ Module.finrank F E = n := by
    intro n hn
    haveI : Fact (Nat.Prime (ringChar F)) := ⟨CharP.char_is_prime F (ringChar F)⟩
    haveI : NeZero n := ⟨by omega⟩
    refine ⟨ULift.{u_1} (FiniteField.Extension F (ringChar F) n), inferInstance, inferInstance,
      ?_, ?_⟩
    · exact Module.Finite.equiv (ULift.moduleEquiv (R := F)).symm
    · rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := F))]
      exact FiniteField.finrank_extension F (ringChar F) n

  obtain ⟨m, hm0, hmE⟩ := point_count_virtual_eigenvalues F X d

  have hint : ∀ n : ℕ, 1 ≤ n → ∃ k : ℤ, ∑ α ∈ m.support, (m α : ℂ) * α ^ n = k := by
    intro n hn
    obtain ⟨E, _, _, _, hE⟩ := hext n hn
    refine ⟨(Nat.card (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℤ), ?_⟩
    rw [Int.cast_natCast, hmE E, hE]
  have hintegral := isIntegral_of_int_power_sums m hm0 hint
  have hgal := galois_invariant_of_int_power_sums m hm0 hint

  have hpure := point_count_purity F X d m hm0 hmE
  have hdual := point_count_functional_equation F X d m hm0 hmE

  have htend : Filter.Tendsto
      (fun n : ℕ => (∑ α ∈ m.support, (m α : ℂ) * α ^ n) / (Nat.card F : ℂ) ^ (d * n))
      Filter.atTop (nhds 1) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨n₀, hn₀⟩ := lang_weil_asymptotic F X d ε hε
    refine ⟨max n₀ 1, fun n hn => ?_⟩
    obtain ⟨E, _, _, _, hE⟩ := hext n (le_trans (le_max_right _ _) hn)
    have h1 := hn₀ E (by rw [hE]; exact le_trans (le_max_left _ _) hn)
    rw [← hE, ← hmE E, Complex.dist_eq]
    generalize Nat.card (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) = N
      at h1 ⊢
    generalize Module.finrank F E = k at h1 ⊢
    have key : ((N : ℂ) / (Nat.card F : ℂ) ^ (d * k) - 1)
        = (((N : ℝ) / (Nat.card F : ℝ) ^ (d * k) - 1 : ℝ) : ℂ) := by
      push_cast; ring
    rw [key, Complex.norm_real, Real.norm_eq_abs]
    exact h1

  have hnorm : ∀ α ∈ m.support, ∃ i ≤ 2 * d, ‖α‖ = √((Nat.card F : ℝ) ^ i) := by
    intro α hα
    obtain ⟨i, hi, _, hφ⟩ := hpure α hα
    exact ⟨i, hi, by simpa using hφ (RingEquiv.refl ℂ)⟩
  have hw0 := weight_zero_of_asymptotic (Nat.card F) d m hq hm0 hnorm hdual htend

  obtain ⟨A, hA0, hA, htr⟩ :=
    assemble_weil_multisets (Nat.card F) d m hq hm0 hpure hw0 hdual hintegral hgal
  refine ⟨A, hA0, hA, ?_⟩
  intro E _ _ _
  rw [hmE E, htr]

#print axioms weil_conjectures
