  obtain ⟨bm, hbmA, hbm0, hbm1⟩ : ∃ bm : wcpaDjLcB (AdicCompletion (IsLocalRing.maximalIdeal O₀) O₀) h →+*
      Algebra.adjoin (AdicCompletion (IsLocalRing.maximalIdeal Oy) Oy) {u, y'},
