    letI : Algebra Γ((Spec (CommRingCat.of (Polynomial Γ(Y₂, V) ⧸ wcpaDjGslcIdeal g a τ))), ⊤) ((Spec (CommRingCat.of (Polynomial Γ(Y₂, V) ⧸ wcpaDjGslcIdeal g a τ))).presheaf.stalk c') :=
