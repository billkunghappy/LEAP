        (Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ l, σ l ^ b l}))
        Ideal.Quotient.mk_surjective
        (K := IsLocalRing.maximalIdeal (A ⧸ Ideal.span {x * y - v * ∏ l, σ l ^ b l}))
