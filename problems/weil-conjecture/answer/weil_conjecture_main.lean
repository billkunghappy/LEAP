        (T := Q.primeCompl)
        (Localization.AtPrime (Q.comap ((MvPolynomial.finSuccEquiv C k).symm :
          Polynomial (MvPolynomial (Fin k) C) →+* MvPolynomial (Fin (k + 1)) C)))
        (Localization.AtPrime Q)
        (MvPolynomial.finSuccEquiv C k).symm.toRingEquiv ?_⟩
      ext x
