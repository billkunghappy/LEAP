theorem wcpa_dj_stc_ktc_res_surj : ∀ (P Yr : Type u) [CommRing P] [IsLocalRing P]
    [IsNoetherianRing P] [CommRing Yr] [IsLocalRing Yr] [IsNoetherianRing Yr] (γ : P →+* Yr)
