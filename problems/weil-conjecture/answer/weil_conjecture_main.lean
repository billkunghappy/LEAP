    · rw [Ideal.comap_comap, Ideal.comap_comap, MvPolynomial.finSuccEquiv_comp_C_eq_C]
    · refine ⟨IsLocalization.ringEquivOfRingEquiv (M := (Q.comap ((MvPolynomial.finSuccEquiv C k).symm :
