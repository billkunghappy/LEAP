    intro b
    change _ ∈ 𝔫 ↔ _
    rw [← hBmax]
    simp only [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff]
  have hJ : 𝔫 ≤ (⊥ : Ideal (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime P))
