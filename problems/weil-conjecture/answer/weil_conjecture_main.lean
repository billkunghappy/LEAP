    (∀ c, (∃ i ∈ I, a c ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i)) →
      O.ι c ∈ (⋃ j, Set.range ⇑(τ j)) ∪ ⇑g ⁻¹' ((W : Set S)ᶜ)) →
    ∃ d B : ℕ, 1 ≤ d ∧
      ∀ (S'' : Scheme.{u}) [AlgebraicGeometry.IsIntegral S''] (ρ : S'' ⟶ S) (D'' : Set S''),
        wcpaDjIsProjOver k (ρ ≫ sS) → IsProper ρ → Surjective ρ →
        (∃ V : S.Opens, V ≠ ⊥ ∧ IsFinite (ρ ∣_ V)) →
        (∀ s : S'', IsRegularLocalRing (S''.presheaf.stalk s)) → wcpaDjSNCSet S'' D'' →
        ⇑ρ ⁻¹' (⋃ i, Dc i) ⊆ D'' → wcpaDjKummerOrd ρ mD Dc D'' d B →
        ∃ (C : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral C) (g' : C ⟶ S'') (π : C ⟶ Y)
          (A : C ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
            MvPolynomial.gradedAlgebra),
          π ≫ g = g' ≫ ρ ∧ wcpaDjIsProjOver k (g' ≫ ρ ≫ sS) ∧ wcpaDjSemistable g' ∧
          IsProper π ∧ Surjective π ∧ (∃ V : Y.Opens, V ≠ ⊥ ∧ IsFinite (π ∣_ V)) ∧
          A ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) =
            g' ≫ ρ ≫ sS ∧
          (π ⁻¹ᵁ O).ι ≫ A = (π ∣_ O) ≫ a ∧
          ∃ (U' : S''.Opens) (m' : ℕ) (τ' : Fin m' → (S'' ⟶ C)),
            U' ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (g' ∣_ U') ∧
            GeometricallyConnected (g' ∣_ U') ∧ wcpaDjSections g' m' τ' ∧
            ⇑π ⁻¹' ((⋃ j, Set.range ⇑(τ j)) ∪ ⇑g ⁻¹' ((W : Set S)ᶜ)) ⊆
              (⋃ j, Set.range ⇑(τ' j)) ∪ ⇑g' ⁻¹' ((U' : Set S'')ᶜ) :=
by
  intro k _ _ S Y _ _ sS g m τ W mD Dc N I O a hS hY hss hmono hτ hW hWsm hWgc hreg hcomps
    hWD hO hstr hC1 hC2
  obtain ⟨B₀, hB₀⟩ := wcpa_dj_stc_kummer_mono k S Y sS g m τ W mD Dc N I O a hS hY hss hmono
    hτ hW hWsm hWgc hreg hcomps hWD hO hstr hC1 hC2
  refine ⟨(2 * B₀).factorial, 8 * B₀ ^ 2 + 4 * B₀ + 1, Nat.factorial_pos _, ?_⟩
  intro S'' _ ρ D'' hρS hρp hρs hρf hreg'' hsnc'' hD'' hK
  have hτ' : ∀ j, τ j ≫ g = 𝟙 S := hτ.1
  apply wcpa_dj_stc_graph_closure k S Y sS g m τ W mD Dc N I O a hτ' hS hY hss hmono hτ hW
    hWsm hWgc hreg hcomps hWD hO hstr hC1 hC2 S'' ρ D'' hρS hρp hρs hρf hreg'' hsnc'' hD''
  intro i₀ hi₀ y
  obtain ⟨n, t, J, α, r, β₀, c₀, M, hα, hβ, hc, hd, hcmp, hmd⟩ :=
    hB₀ _ _ S'' ρ D'' hτ' hρS hρp hρs hρf hreg'' hsnc'' hD'' hK i₀ hi₀ y
  obtain ⟨h1, h2⟩ := wcpa_dj_stc_order_arith B₀ r n I α β₀ c₀ M (fun i _ => hα i)
    (fun i _ j => hβ i j) hc hd hcmp
  exact ⟨n, t, J, α, _, _, hmd, h1, h2⟩

theorem wcpa_dj_ssfi_toroidal_extend : ∀ (k : Type u) [Field k] [Finite k] (S Y : Scheme.{u})
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    (sS : S ⟶ Spec (.of k)) (gY : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (W : S.Opens)
    (Dset : Set S) (nP N : ℕ) (I : Finset (Fin (N + 1)))
    (a : (gY ⁻¹ᵁ W).toScheme ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra),
    wcpaDjIsProjOver k sS → wcpaDjIsProjOver k (gY ≫ sS) → wcpaDjSemistable gY →
    wcpaDjSections gY m τ → W ≠ ⊥ → SmoothOfRelativeDimension 1 (gY ∣_ W) →
    GeometricallyConnected (gY ∣_ W) →
    (∀ s : S, IsRegularLocalRing (S.presheaf.stalk s)) →
    topologicalKrullDim S = (nP : WithBot ℕ∞) → wcpaDjAltIH.{u} nP →
    wcpaDjSNCSet S Dset → (W : Set S)ᶜ ⊆ Dset →
    a ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) =
      (gY ⁻¹ᵁ W).ι ≫ gY ≫ sS →
    (∀ c (i : Fin (N + 1)), i ∉ I →
      a c ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i)) →
    (∀ c, (∃ i ∈ I, a c ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i)) →
      (gY ⁻¹ᵁ W).ι c ∈ ⋃ j, Set.range ⇑(τ j)) →
    ∃ (P' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P') (sP' : P' ⟶ Spec (.of k))
      (ρ' : P' ⟶ S),
      ρ' ≫ sS = sP' ∧ wcpaDjIsProjOver k sP' ∧ IsProper ρ' ∧ Surjective ρ' ∧
      (∃ V : S.Opens, V ≠ ⊥ ∧ IsFinite (ρ' ∣_ V)) ∧
      ∃ (C : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral C) (g : C ⟶ P') (π : C ⟶ Y)
        (A : C ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          MvPolynomial.gradedAlgebra),
        π ≫ gY = g ≫ ρ' ∧ wcpaDjIsProjOver k (g ≫ sP') ∧ wcpaDjSemistable g ∧
        IsProper π ∧ Surjective π ∧ (∃ V : Y.Opens, V ≠ ⊥ ∧ IsFinite (π ∣_ V)) ∧
        A ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) = g ≫ sP' ∧
        (π ⁻¹ᵁ (gY ⁻¹ᵁ W)).ι ≫ A = (π ∣_ (gY ⁻¹ᵁ W)) ≫ a ∧
        ∃ (U' : P'.Opens) (m' : ℕ) (τ' : Fin m' → (P' ⟶ C)),
          U' ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (g ∣_ U') ∧ GeometricallyConnected (g ∣_ U') ∧
          wcpaDjSections g m' τ' ∧
          ⇑π ⁻¹' ((⋃ j, Set.range ⇑(τ j)) ∪ ⇑gY ⁻¹' ((W : Set S)ᶜ)) ⊆
            (⋃ j, Set.range ⇑(τ' j)) ∪ ⇑g ⁻¹' ((U' : Set P')ᶜ) :=
by
  intro k _ _ S Y _ _ sS gY m τ W Dset nP N I a hS hY hss hτ hW hWsm hWgc hreg hdim hIH _hsnc
    _hWD hstr hC1 hC2
  obtain ⟨S₁, iS₁, ρ₁, Y₁, iY₁, g₁, π₁, W₁, D₁, m₁, τ₁, hρ₁p, hρ₁s, hρ₁f, hS₁, hreg₁, hdim₁,
    hsnc₁, hW₁D, hW₁, hW₁le, hY₁, hss₁, hmono₁, hτ₁, hW₁sm, hW₁gc, hsq₁, hπ₁p, hπ₁s, hπ₁f,
    hcont₁⟩ := wcpa_dj_ste_prepare k S Y sS gY m τ W nP hS hY hss hτ hW hWsm hWgc hdim hIH
  haveI := iS₁
  haveI := iY₁
  obtain ⟨mD, Dc, hDcl, hD₁eq, hDloc⟩ := hsnc₁
  subst hD₁eq
  have hcomps : wcpaDjSNCComps S₁ mD Dc := ⟨hDcl, hDloc⟩

  have hO : g₁ ⁻¹ᵁ W₁ ≤ π₁ ⁻¹ᵁ (gY ⁻¹ᵁ W) := by
    intro y hy
    rw [Scheme.Hom.mem_preimage] at hy
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage]
    have e : (π₁ ≫ gY) y = (g₁ ≫ ρ₁) y := by rw [hsq₁]
    simp only [Scheme.Hom.comp_apply] at e
    rw [e]
    have h1 := hW₁le hy
    rw [Scheme.Hom.mem_preimage] at h1
    exact h1
  have hstr₁ : ((π₁ ∣_ (gY ⁻¹ᵁ W)) ≫ a) ≫ @Proj.toSpecZero _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) =
      (π₁ ⁻¹ᵁ (gY ⁻¹ᵁ W)).ι ≫ g₁ ≫ ρ₁ ≫ sS := by
    rw [Category.assoc, hstr, morphismRestrict_ι_assoc, ← Category.assoc π₁ gY sS, hsq₁,
      Category.assoc]
  have hc1 : ∀ c (i : Fin (N + 1)), i ∉ I →
      ((π₁ ∣_ (gY ⁻¹ᵁ W)) ≫ a) c ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i) := by
    intro c i hi
    rw [Scheme.Hom.comp_apply]
    exact hC1 _ i hi
  have hc2 : ∀ c, (∃ i ∈ I, ((π₁ ∣_ (gY ⁻¹ᵁ W)) ≫ a) c ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i)) →
      (π₁ ⁻¹ᵁ (gY ⁻¹ᵁ W)).ι c ∈ (⋃ j, Set.range ⇑(τ₁ j)) ∪ ⇑g₁ ⁻¹' ((W₁ : Set S₁)ᶜ) := by
    intro c ⟨i, hi, h⟩
    rw [Scheme.Hom.comp_apply] at h
    have h2 := hC2 _ ⟨i, hi, h⟩
    have e : ((π₁ ∣_ (gY ⁻¹ᵁ W)) ≫ (gY ⁻¹ᵁ W).ι) c =
        ((π₁ ⁻¹ᵁ (gY ⁻¹ᵁ W)).ι ≫ π₁) c := by rw [morphismRestrict_ι]
    simp only [Scheme.Hom.comp_apply] at e
    apply hcont₁
    rw [Set.mem_preimage]
    left
    rw [← e]
    exact h2
  obtain ⟨d, B, hd, hcore⟩ := wcpa_dj_ste_toroidal_core k S₁ Y₁ (ρ₁ ≫ sS) g₁ m₁ τ₁ W₁ mD Dc N I
    (π₁ ⁻¹ᵁ (gY ⁻¹ᵁ W)) ((π₁ ∣_ (gY ⁻¹ᵁ W)) ≫ a) hS₁ hY₁ hss₁ hmono₁ hτ₁ hW₁ hW₁sm hW₁gc hreg₁
    hcomps hW₁D hO hstr₁ hc1 hc2
  obtain ⟨S'', iS'', ρ, D'', hS'', hρp, hρs, hρf, hreg'', hsnc'', hD'', hK⟩ :=
    wcpa_dj_ste_base_kummer k S₁ (ρ₁ ≫ sS) nP mD Dc d B hS₁ hreg₁ hdim₁ hIH hcomps hd
  haveI := iS''
  obtain ⟨C, iC, g', π₅, A, hsq, hCproj, hgss, hπ₅p, hπ₅s, hπ₅f, hAstr, hAagree, U', m', τ',
    hU', hU'sm, hU'gc, hτ', hcont⟩ := hcore S'' ρ D'' hS'' hρp hρs hρf hreg'' hsnc'' hD'' hK
  haveI := iC
  haveI := hρp
  haveI := hρ₁p
  haveI := hπ₅p
  haveI := hπ₁p
  obtain ⟨hβs, hβf⟩ := wcpa_dj_alteration_comp ρ₁ ρ hρ₁p hρ₁s hρs hρ₁f hρf
  obtain ⟨hπs, hπf⟩ := wcpa_dj_alteration_comp π₁ π₅ hπ₁p hπ₁s hπ₅s hπ₁f hπ₅f
  refine ⟨S'', iS'', (ρ ≫ ρ₁) ≫ sS, ρ ≫ ρ₁, rfl, ?_, inferInstance, hβs, hβf, C, iC, g',
    π₅ ≫ π₁, A, ?_, ?_, hgss, inferInstance, hπs, hπf, ?_, ?_, U', m', τ', hU', hU'sm, hU'gc,
    hτ', ?_⟩
  · rw [Category.assoc]; exact hS''
  · simp only [Category.assoc, hsq₁]
    rw [← Category.assoc, hsq, Category.assoc]
  · simpa only [Category.assoc] using hCproj
  · rw [hAstr]; simp only [Category.assoc]
  · rw [morphismRestrict_comp]
    first
      | exact hAagree.trans (Category.assoc _ _ _).symm
      | (erw [Category.assoc]; exact hAagree)
      | simpa only [Category.assoc] using hAagree
  · intro c hc
    have h1 : π₁ (π₅ c) ∈ (⋃ j, Set.range ⇑(τ j)) ∪ ⇑gY ⁻¹' ((W : Set S)ᶜ) := by
      rw [Set.mem_preimage, Scheme.Hom.comp_apply] at hc
      exact hc
    exact hcont (hcont₁ h1)

theorem wcpa_dj_ssfi_lift_alteration : ∀ (k : Type u) [Field k] (X₃ P₂ S Y P' C : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X₃] [AlgebraicGeometry.IsIntegral P₂]
    [AlgebraicGeometry.IsIntegral S] [AlgebraicGeometry.IsIntegral Y]
    [AlgebraicGeometry.IsIntegral C]
    (sP₂ : P₂ ⟶ Spec (.of k)) (f₃ : X₃ ⟶ P₂) (sS : S ⟶ Spec (.of k)) (ρ : S ⟶ P₂) (gY : Y ⟶ S)
    (W : S.Opens) (ψ : (gY ⁻¹ᵁ W).toScheme ⟶ X₃) (sP' : P' ⟶ Spec (.of k)) (ρ' : P' ⟶ S)
    (g : C ⟶ P') (π : C ⟶ Y) (N : ℕ)
    (j₃ : X₃ ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra)
    (A : C ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra),
    wcpaDjIsProjOver k (f₃ ≫ sP₂) → wcpaDjIsProjOver k sP₂ → Flat f₃ →
    ρ ≫ sP₂ = sS → IsProper ρ → Surjective ρ → (∃ V : P₂.Opens, V ≠ ⊥ ∧ IsFinite (ρ ∣_ V)) →
    W ≠ ⊥ → IsPullback ψ (gY ∣_ W) f₃ (W.ι ≫ ρ) → Flat gY →
    ρ' ≫ sS = sP' → IsProper ρ' → Surjective ρ' → (∃ V : S.Opens, V ≠ ⊥ ∧ IsFinite (ρ' ∣_ V)) →
    π ≫ gY = g ≫ ρ' → wcpaDjIsProjOver k (g ≫ sP') →
    IsProper π → Surjective π → (∃ V : Y.Opens, V ≠ ⊥ ∧ IsFinite (π ∣_ V)) →
    IsClosedImmersion j₃ →
    j₃ ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) = f₃ ≫ sP₂ →
    A ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) = g ≫ sP' →
    (π ⁻¹ᵁ (gY ⁻¹ᵁ W)).ι ≫ A = (π ∣_ (gY ⁻¹ᵁ W)) ≫ ψ ≫ j₃ →
    ∃ h₄ : C ⟶ X₃, h₄ ≫ f₃ = g ≫ ρ' ≫ ρ ∧ IsProper h₄ ∧ Surjective h₄ ∧
      (∃ V : X₃.Opens, V ≠ ⊥ ∧ IsFinite (h₄ ∣_ V)) ∧
      ∀ (c : C) (hc : π c ∈ gY ⁻¹ᵁ W), h₄ c = ψ ⟨π c, hc⟩ :=
by
  intro k _ X₃ P₂ S Y P' C _ _ _ _ _ sP₂ f₃ sS ρ gY W ψ sP' ρ' g π N j₃ A hf hP hflat hρ hρp hρs
    hρf hW hpb hgYflat hρ' _hρ'p _hρ's _hρ'f hπg hC _hπp hπs hπf hj₃ hj₃eq hAeq hAagree
  classical
  haveI := hρp
  haveI := hρs
  haveI := hπs
  haveI := hj₃

  have rmono : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (U U₁ : B.Opens), U ≤ U₁ →
      IsFinite (f ∣_ U₁) → IsFinite (f ∣_ U) := by
    intro A B f U U₁ hUV h
    have hR : MorphismProperty.RespectsIso (@IsFinite : MorphismProperty Scheme.{u}) :=
      MorphismProperty.respectsIso_of_isStableUnderComposition
        (fun _ _ f (_ : MorphismProperty.isomorphisms Scheme f) => (inferInstance : IsFinite f))
    have heq : U₁.ι ''ᵁ (U₁.ι ⁻¹ᵁ U) = U := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hUV
    have e := morphismRestrictRestrict f U₁ (U₁.ι ⁻¹ᵁ U) ≪≫ morphismRestrictEq f heq
    exact (MorphismProperty.arrow_mk_iso_iff (@IsFinite : MorphismProperty Scheme.{u}) e).mp
      inferInstance

  have hgen : ∀ (T : Scheme.{u}) [IrreducibleSpace T] (U : T.Opens), U ≠ ⊥ →
      genericPoint T ∈ U := by
    intro T _ U hU
    obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    exact (genericPoint_specializes x).mem_open U.isOpen hx

  have hflatgen : ∀ {T T' : Scheme.{u}} [AlgebraicGeometry.IsIntegral T]
      [AlgebraicGeometry.IsIntegral T'] (f : T ⟶ T'), Flat f →
      f (genericPoint T) = genericPoint T' := by
    intro T T' _ _ f hfl
    haveI := hfl
    have hG : GeneralizingMap f := Flat.generalizingMap f
    obtain ⟨x', hx', hfx'⟩ := hG (genericPoint_specializes (f (genericPoint T)))
    have hx'eq : x' = genericPoint T := (hx'.antisymm (genericPoint_specializes x')).eq
    rw [← hx'eq]
    exact hfx'

  have hfib : ∀ {T Z : Scheme.{u}} (q : T ⟶ Z) (V : Z.Opens), IsFinite (q ∣_ V) →
      ∀ (a b : T), q a ∈ V → q a = q b → a ⤳ b → a = b := by
    intro T Z q V hq a b ha hab hsp
    have hb : q b ∈ V := by rw [← hab]; exact ha
    let a' : (q ⁻¹ᵁ V).toScheme := ⟨a, ha⟩
    let b' : (q ⁻¹ᵁ V).toScheme := ⟨b, hb⟩
    have hab' : (q ∣_ V) a' = (q ∣_ V) b' := by
      apply Subtype.ext
      exact (morphismRestrict_base_coe q V a').trans
        (hab.trans (morphismRestrict_base_coe q V b').symm)
    have hsp' : a' ⤳ b' := by
      apply ((q ⁻¹ᵁ V).ι.isOpenEmbedding.isInducing.specializes_iff).mp
      have e1 : (q ⁻¹ᵁ V).ι a' = a := Scheme.Opens.ι_apply _ _
      have e2 : (q ⁻¹ᵁ V).ι b' = b := Scheme.Opens.ι_apply _ _
      rw [e1, e2]
      exact hsp
    haveI : DiscreteTopology ((q ∣_ V) ⁻¹' {(q ∣_ V) a'}) :=
      ((q ∣_ V).isDiscrete_preimage_singleton ((q ∣_ V) a')).to_subtype
    have hsp'' : (⟨a', rfl⟩ : ((q ∣_ V) ⁻¹' {(q ∣_ V) a'})) ⤳ ⟨b', hab'.symm⟩ :=
      (subtype_specializes_iff _ _).mpr hsp'
    have habeq : a' = b' := congrArg Subtype.val hsp''.eq
    exact congrArg Subtype.val habeq

  have hopen : ∀ {T Z : Scheme.{u}} (h : T ⟶ Z) (O : T.Opens) (V : Z.Opens), h ⁻¹ᵁ V ≤ O →
      (IsFinite ((O.ι ≫ h) ∣_ V) ↔ IsFinite (h ∣_ V)) := by
    intro T Z h O V hle
    rw [morphismRestrict_comp]
    have hiso : IsIso (O.ι ∣_ (h ⁻¹ᵁ V)) := by
      rw [isIso_iff_isOpenImmersion_and_epi_base]
      refine ⟨inferInstance, ?_⟩
      rw [TopCat.epi_iff_surjective]
      intro x
      have hxO : (x.1 : T) ∈ O := hle x.2
      have hmem : (⟨x.1, hxO⟩ : O.toScheme) ∈ O.ι ⁻¹ᵁ (h ⁻¹ᵁ V) := by
        show O.ι ⟨x.1, hxO⟩ ∈ h ⁻¹ᵁ V
        rw [Scheme.Opens.ι_apply]
        exact x.2
      refine ⟨⟨⟨x.1, hxO⟩, hmem⟩, ?_⟩
      apply Subtype.ext
      exact (morphismRestrict_base_coe O.ι (h ⁻¹ᵁ V) ⟨⟨x.1, hxO⟩, hmem⟩).trans
        (Scheme.Opens.ι_apply _ _)
    haveI := hiso
    have hfe : IsFinite (O.ι ∣_ (h ⁻¹ᵁ V)) := by
      have h0 : IsFinite (inv (inv (O.ι ∣_ (h ⁻¹ᵁ V)))) := inferInstance
      simpa only [IsIso.inv_inv] using h0
    constructor
    · intro H
      have e : h ∣_ V = inv (O.ι ∣_ (h ⁻¹ᵁ V)) ≫ (O.ι ∣_ (h ⁻¹ᵁ V) ≫ h ∣_ V) :=
        (IsIso.inv_hom_id_assoc _ _).symm
      rw [e]
      exact MorphismProperty.comp_mem (@IsFinite) _ _ inferInstance H
    · intro H
      exact MorphismProperty.comp_mem (@IsFinite) _ _ hfe H

  have hpbfin : ∀ {Pp X Yy Z : Scheme.{u}} (fst : Pp ⟶ X) (snd : Pp ⟶ Yy) (f : X ⟶ Z)
      (g' : Yy ⟶ Z), IsPullback fst snd f g' → ∀ (V : Z.Opens), IsFinite (g' ∣_ V) →
      IsFinite (fst ∣_ (f ⁻¹ᵁ V)) := by
    intro Pp X Yy Z fst snd f g' H V hV
    have h1 := (isPullback_morphismRestrict fst (f ⁻¹ᵁ V)).paste_vert H
    rw [← morphismRestrict_ι f V] at h1
    have h2 := IsPullback.of_bot' h1 (isPullback_morphismRestrict g' V)
    exact MorphismProperty.of_isPullback (P := @IsFinite) h2.flip hV

  have hηX₃ : f₃ (genericPoint X₃) = genericPoint P₂ := hflatgen f₃ hflat
  have hηY : gY (genericPoint Y) = genericPoint S := hflatgen gY hgYflat
  have hηS : ρ (genericPoint S) = genericPoint P₂ := by
    have h1 := (genericPoint_spec S).image ρ.continuous
    simp only [Set.image_univ_of_surjective ρ.surjective, closure_univ] at h1
    exact h1.eq (genericPoint_spec P₂)
  have hηSW : genericPoint S ∈ W := hgen S W hW
  have hηYG : genericPoint Y ∈ gY ⁻¹ᵁ W := by
    rw [Scheme.Hom.mem_preimage, hηY]
    exact hηSW

  have projP : ∀ {Y₀ : Scheme.{u}} (s : Y₀ ⟶ Spec (.of k)), wcpaDjIsProjOver k s → IsProper s := by
    intro Y₀ s hs
    obtain ⟨N₀, j, hj, rfl⟩ := hs
    haveI := hj
    haveI hst : IsScalarTower k (↥(MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k 0))
        (MvPolynomial (Fin (N₀ + 1)) k) :=
      IsScalarTower.of_algebraMap_eq
        (S := ↥(MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k 0)) (fun c => by
          rw [SetLike.GradeZero.algebraMap_apply]
          exact (SetLike.GradeZero.coe_algebraMap
            (MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k) c).symm)
    haveI : Algebra.FiniteType (↥(MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k 0))
        (MvPolynomial (Fin (N₀ + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k _ _
    haveI : IsProper (@Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k) MvPolynomial.gradedAlgebra) :=
      inferInstance
    have hkey : ∀ c : k, ((algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k 0))
        c : ↥(MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k 0)) :
          MvPolynomial (Fin (N₀ + 1)) k) = MvPolynomial.C c := by
      intro c
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have hbij : Function.Bijective
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k 0))) := by
      constructor
      · intro a b hab
        have h1 := congrArg (fun x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k 0) =>
          (x : MvPolynomial (Fin (N₀ + 1)) k)) hab
        simp only [hkey] at h1
        exact MvPolynomial.C_injective _ _ h1
      · intro p
        have hp : (p : MvPolynomial (Fin (N₀ + 1)) k).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
        have htd : (p : MvPolynomial (Fin (N₀ + 1)) k).totalDegree = 0 :=
          Nat.le_zero.mp hp.totalDegree_le
        refine ⟨(p : MvPolynomial (Fin (N₀ + 1)) k).coeff 0, Subtype.ext ?_⟩
        rw [hkey]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp htd).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) k 0)))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    infer_instance
  haveI hsP₂p : IsProper sP₂ := projP sP₂ hP
  generalize hπN : (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) = πN
    at hj₃eq hAeq
  obtain ⟨e₃, he₃fst, he₃snd⟩ : ∃ e : X₃ ⟶ Limits.pullback πN sP₂,
      e ≫ Limits.pullback.fst πN sP₂ = j₃ ∧ e ≫ Limits.pullback.snd πN sP₂ = f₃ :=
    ⟨Limits.pullback.lift j₃ f₃ hj₃eq, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  haveI : IsClosedImmersion e₃ := by
    haveI : IsClosedImmersion (e₃ ≫ Limits.pullback.fst πN sP₂) := by
      rw [he₃fst]; exact hj₃
    exact IsClosedImmersion.of_comp e₃ (Limits.pullback.fst πN sP₂)
  have hA : A ≫ πN = (g ≫ ρ' ≫ ρ) ≫ sP₂ := by
    rw [hAeq, ← hρ', ← hρ]
    simp only [Category.assoc]
  obtain ⟨a, hafst, hasnd⟩ : ∃ a : C ⟶ Limits.pullback πN sP₂,
      a ≫ Limits.pullback.fst πN sP₂ = A ∧ a ≫ Limits.pullback.snd πN sP₂ = g ≫ ρ' ≫ ρ :=
    ⟨Limits.pullback.lift A (g ≫ ρ' ≫ ρ) hA, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hagree : (π ⁻¹ᵁ (gY ⁻¹ᵁ W)).ι ≫ a = (π ∣_ (gY ⁻¹ᵁ W)) ≫ ψ ≫ e₃ := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, hafst, he₃fst]
      exact hAagree
    · simp only [Category.assoc, hasnd, he₃snd]
      rw [hpb.w, morphismRestrict_ι_assoc, morphismRestrict_ι_assoc, reassoc_of% hπg]
  obtain ⟨c₀, hc₀⟩ := π.surjective (genericPoint Y)
  have hOdense : Dense ((π ⁻¹ᵁ (gY ⁻¹ᵁ W) : C.Opens) : Set C) :=
    (π ⁻¹ᵁ (gY ⁻¹ᵁ W)).isOpen.dense ⟨c₀, by
      show π c₀ ∈ gY ⁻¹ᵁ W
      rw [hc₀]
      exact hηYG⟩
  have hrange : Set.range ⇑a ⊆ Set.range ⇑e₃ := by
    have hsub : ⇑a '' ((π ⁻¹ᵁ (gY ⁻¹ᵁ W) : C.Opens) : Set C) ⊆ Set.range ⇑e₃ := by
      rintro _ ⟨c, hc, rfl⟩
      refine ⟨ψ ((π ∣_ (gY ⁻¹ᵁ W)) ⟨c, hc⟩), ?_⟩
      have h1 : ((π ⁻¹ᵁ (gY ⁻¹ᵁ W)).ι ≫ a) ⟨c, hc⟩ =
          ((π ∣_ (gY ⁻¹ᵁ W)) ≫ ψ ≫ e₃) ⟨c, hc⟩ := by rw [hagree]
      simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply] at h1
      exact h1.symm
    rintro _ ⟨c, rfl⟩
    have hcl : c ∈ closure ((π ⁻¹ᵁ (gY ⁻¹ᵁ W) : C.Opens) : Set C) := by
      rw [hOdense.closure_eq]; trivial
    have h2 := image_closure_subset_closure_image a.continuous ⟨c, hcl, rfl⟩
    exact closure_minimal hsub e₃.isClosedEmbedding.isClosed_range h2
  have hlift : ∃ b : C ⟶ X₃, b ≫ e₃ = a := by
    have H : Scheme.Hom.ker e₃ ≤ Scheme.Hom.ker a := by
      rw [Scheme.Hom.ker.eq_1 a, Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U s hs
      rw [Scheme.Hom.ker_apply, RingHom.mem_ker] at hs
      rw [RingHom.mem_ker]
      apply eq_zero_of_basicOpen_eq_bot
      rw [← Scheme.Hom.preimage_basicOpen]
      have hj : e₃ ⁻¹ᵁ (Limits.pullback πN sP₂).basicOpen s = ⊥ := by
        rw [Scheme.Hom.preimage_basicOpen, hs, Scheme.basicOpen_zero]
      rw [← TopologicalSpace.Opens.not_nonempty_iff_eq_bot]
      rintro ⟨x, hx⟩
      obtain ⟨c, hc⟩ := hrange ⟨x, rfl⟩
      have hc' : c ∈ e₃ ⁻¹ᵁ (Limits.pullback πN sP₂).basicOpen s := by
        show e₃ c ∈ (Limits.pullback πN sP₂).basicOpen s
        rw [hc]
        exact hx
      rw [hj] at hc'
      exact hc'
    exact ⟨IsClosedImmersion.lift e₃ a H, IsClosedImmersion.lift_fac e₃ a H⟩
  obtain ⟨h₄, hh₄e⟩ := hlift
  have hfac : h₄ ≫ f₃ = g ≫ ρ' ≫ ρ := by
    rw [← he₃snd, ← Category.assoc, hh₄e, hasnd]
  have hagreeH : (π ⁻¹ᵁ (gY ⁻¹ᵁ W)).ι ≫ h₄ = (π ∣_ (gY ⁻¹ᵁ W)) ≫ ψ := by
    rw [← cancel_mono e₃, Category.assoc, hh₄e, hagree, Category.assoc]
  have hpt : ∀ (c : C) (hc : π c ∈ gY ⁻¹ᵁ W), h₄ c = ψ ⟨π c, hc⟩ := by
    intro c hc
    have hcO : c ∈ π ⁻¹ᵁ (gY ⁻¹ᵁ W) := hc
    have h1 : ((π ⁻¹ᵁ (gY ⁻¹ᵁ W)).ι ≫ h₄) ⟨c, hcO⟩ =
        ((π ∣_ (gY ⁻¹ᵁ W)) ≫ ψ) ⟨c, hcO⟩ := by rw [hagreeH]
    have h2 : h₄ c = ψ ((π ∣_ (gY ⁻¹ᵁ W)) ⟨c, hcO⟩) := h1
    refine h2.trans ?_
    exact congrArg (fun t => ψ t) (Subtype.ext (morphismRestrict_base_coe π (gY ⁻¹ᵁ W) ⟨c, hcO⟩))

  haveI : IsProper (g ≫ sP') := projP _ hC
  haveI : IsProper (f₃ ≫ sP₂) := projP _ hf
  haveI hh₄p : IsProper h₄ := by
    have e : h₄ ≫ f₃ ≫ sP₂ = g ≫ sP' := by
      rw [← Category.assoc, hfac, ← hρ', ← hρ]
      simp only [Category.assoc]
    haveI : IsProper (h₄ ≫ f₃ ≫ sP₂) := by rw [e]; infer_instance
    exact IsProper.of_comp h₄ (f₃ ≫ sP₂)

  obtain ⟨z', hz'1, _⟩ := Scheme.Pullback.exists_preimage_pullback (f := f₃) (g := W.ι ≫ ρ)
    (genericPoint X₃) (⟨genericPoint S, hηSW⟩ : W.toScheme) (by
      show f₃ (genericPoint X₃) = ρ (genericPoint S)
      rw [hηX₃, hηS])
  have hψz : ψ (hpb.isoPullback.inv z') = genericPoint X₃ := by
    have e := Scheme.Hom.comp_apply hpb.isoPullback.inv ψ z'
    rw [IsPullback.isoPullback_inv_fst] at e
    exact e.symm.trans hz'1
  obtain ⟨c₁, hc₁⟩ := π.surjective ((gY ⁻¹ᵁ W).ι (hpb.isoPullback.inv z'))
  have hcG₁ : π c₁ ∈ gY ⁻¹ᵁ W := by
    rw [hc₁]
    exact (hpb.isoPullback.inv z').2
  have hsurj : Surjective h₄ := by
    have hηmem : genericPoint X₃ ∈ Set.range ⇑h₄ := by
      refine ⟨c₁, (hpt c₁ hcG₁).trans ?_⟩
      refine Eq.trans ?_ hψz
      exact congrArg (fun t => ψ t) (Subtype.ext (hc₁.trans (Scheme.Opens.ι_apply _ _)))
    refine ⟨fun x => ?_⟩
    exact (genericPoint_specializes x).mem_closed h₄.isClosedMap.isClosed_range hηmem

  obtain ⟨Vρ, hVρ0, hVρfin⟩ := hρf
  obtain ⟨Vπ, hVπ0, hVπfin⟩ := hπf
  have hKs : IsClosed (ρ '' (W : Set S)ᶜ) := ρ.isClosedMap _ W.isOpen.isClosed_compl
  have hnotK : genericPoint P₂ ∉ ρ '' (W : Set S)ᶜ := by
    rintro ⟨z, hz, hzη⟩
    have hηV : genericPoint P₂ ∈ Vρ := hgen P₂ Vρ hVρ0
    have hzeq := hfib ρ Vρ hVρfin (genericPoint S) z (by rw [hηS]; exact hηV)
      (hηS.trans hzη.symm) (genericPoint_specializes z)
    rw [← hzeq] at hz
    exact hz hηSW
  let V₁ : P₂.Opens := Vρ ⊓ ⟨(ρ '' (W : Set S)ᶜ)ᶜ, hKs.isOpen_compl⟩
  have hV₁le : ρ ⁻¹ᵁ V₁ ≤ W := by
    intro y hy
    have hy' : ρ y ∈ V₁ := hy
    by_contra hyW
    exact (TopologicalSpace.Opens.mem_inf.mp hy').2 ⟨y, hyW, rfl⟩
  have hηV₁ : genericPoint P₂ ∈ V₁ :=
    TopologicalSpace.Opens.mem_inf.mpr ⟨hgen P₂ Vρ hVρ0, hnotK⟩
  have hρV₁ : IsFinite (ρ ∣_ V₁) := rmono ρ V₁ Vρ inf_le_left hVρfin
  have hG2 : IsFinite ((W.ι ≫ ρ) ∣_ V₁) := (hopen ρ W V₁ hV₁le).mpr hρV₁
  have hG3 : IsFinite (ψ ∣_ (f₃ ⁻¹ᵁ V₁)) := hpbfin ψ (gY ∣_ W) f₃ (W.ι ≫ ρ) hpb V₁ hG2
  let ηG : (gY ⁻¹ᵁ W).toScheme := ⟨genericPoint Y, hηYG⟩
  have hG4 : ∀ t : (gY ⁻¹ᵁ W).toScheme, ψ t = genericPoint X₃ → t = ηG := by
    intro t ht
    have hsp : ηG ⤳ t := by
      apply ((gY ⁻¹ᵁ W).ι.isOpenEmbedding.isInducing.specializes_iff).mp
      have e1 : (gY ⁻¹ᵁ W).ι ηG = genericPoint Y := Scheme.Opens.ι_apply _ _
      rw [e1]
      exact genericPoint_specializes _
    have hψη : ψ ηG = genericPoint X₃ := by
      have h1 : ψ ηG ⤳ genericPoint X₃ := by
        rw [← ht]
        exact hsp.map ψ.continuous
      exact (h1.antisymm (genericPoint_specializes _)).eq
    have hmem : ψ ηG ∈ f₃ ⁻¹ᵁ V₁ := by
      show f₃ (ψ ηG) ∈ V₁
      rw [hψη, hηX₃]
      exact hηV₁
    exact (hfib ψ (f₃ ⁻¹ᵁ V₁) hG3 ηG t hmem (hψη.trans ht.symm) hsp).symm
  have hKB : IsClosed (⇑h₄ '' ((π ⁻¹ᵁ ((gY ⁻¹ᵁ W) ⊓ Vπ) : C.Opens) : Set C)ᶜ) :=
    h₄.isClosedMap _ (π ⁻¹ᵁ ((gY ⁻¹ᵁ W) ⊓ Vπ)).isOpen.isClosed_compl
  let V₂ : X₃.Opens := f₃ ⁻¹ᵁ V₁ ⊓ ⟨(⇑h₄ '' ((π ⁻¹ᵁ ((gY ⁻¹ᵁ W) ⊓ Vπ) : C.Opens) : Set C)ᶜ)ᶜ,
    hKB.isOpen_compl⟩
  have hO_of : ∀ c : C, f₃ (h₄ c) ∈ V₁ → π c ∈ gY ⁻¹ᵁ W := by
    intro c hc
    have e1 : f₃ (h₄ c) = ρ (ρ' (g c)) := by
      rw [← Scheme.Hom.comp_apply h₄ f₃ c, hfac]
      simp only [Scheme.Hom.comp_apply]
    have e2 : gY (π c) = ρ' (g c) := by
      rw [← Scheme.Hom.comp_apply π gY c, hπg]
      simp only [Scheme.Hom.comp_apply]
    show gY (π c) ∈ W
    rw [e2]
    apply hV₁le
    show ρ (ρ' (g c)) ∈ V₁
    rw [← e1]
    exact hc
  have hηV₂ : genericPoint X₃ ∈ V₂ := by
    refine TopologicalSpace.Opens.mem_inf.mpr ⟨?_, ?_⟩
    · show f₃ (genericPoint X₃) ∈ V₁
      rw [hηX₃]
      exact hηV₁
    · intro hx
      obtain ⟨c, hcB, hcη⟩ := hx
      have hcG : π c ∈ gY ⁻¹ᵁ W := hO_of c (by rw [hcη, hηX₃]; exact hηV₁)
      have hz : (⟨π c, hcG⟩ : (gY ⁻¹ᵁ W).toScheme) = ηG := hG4 _ ((hpt c hcG).symm.trans hcη)
      have hπc : π c = genericPoint Y := congrArg Subtype.val hz
      exact hcB (show π c ∈ (gY ⁻¹ᵁ W) ⊓ Vπ by
        rw [hπc]
        exact TopologicalSpace.Opens.mem_inf.mpr ⟨hηYG, hgen Y Vπ hVπ0⟩)
  have hnotB : ∀ c : C, h₄ c ∈ V₂ → π c ∈ (gY ⁻¹ᵁ W) ⊓ Vπ := by
    intro c hc
    by_contra hcn
    exact (TopologicalSpace.Opens.mem_inf.mp hc).2 ⟨c, hcn, rfl⟩
  have hG7 : h₄ ⁻¹ᵁ V₂ ≤ π ⁻¹ᵁ (gY ⁻¹ᵁ W) := by
    intro c hc
    exact (TopologicalSpace.Opens.mem_inf.mp (hnotB c hc)).1
  have hG8 : (gY ⁻¹ᵁ W).ι ''ᵁ (ψ ⁻¹ᵁ V₂) ≤ Vπ := by
    intro y hy
    have hy' : y ∈ ((gY ⁻¹ᵁ W).ι ''ᵁ (ψ ⁻¹ᵁ V₂) : Set Y) := hy
    rw [Scheme.Hom.coe_image] at hy'
    obtain ⟨t, ht, rfl⟩ := hy'
    obtain ⟨c, hc⟩ := π.surjective ((gY ⁻¹ᵁ W).ι t)
    have hcG : π c ∈ gY ⁻¹ᵁ W := by
      rw [hc]
      exact t.2
    have h1 : h₄ c ∈ V₂ := by
      rw [hpt c hcG]
      have ht' : (⟨π c, hcG⟩ : (gY ⁻¹ᵁ W).toScheme) = t :=
        Subtype.ext (hc.trans (Scheme.Opens.ι_apply _ _))
      rw [ht']
      exact ht
    have h2 := (TopologicalSpace.Opens.mem_inf.mp (hnotB c h1)).2
    rw [hc] at h2
    exact h2
  have hψV₂ : IsFinite (ψ ∣_ V₂) := rmono ψ V₂ (f₃ ⁻¹ᵁ V₁) inf_le_left hG3
  have hπV : IsFinite (π ∣_ ((gY ⁻¹ᵁ W).ι ''ᵁ (ψ ⁻¹ᵁ V₂))) := rmono π _ Vπ hG8 hVπfin
  have hR : MorphismProperty.RespectsIso (@IsFinite : MorphismProperty Scheme.{u}) :=
    MorphismProperty.respectsIso_of_isStableUnderComposition
      (fun _ _ f (_ : MorphismProperty.isomorphisms Scheme f) => (inferInstance : IsFinite f))
  have hπGV : IsFinite ((π ∣_ (gY ⁻¹ᵁ W)) ∣_ (ψ ⁻¹ᵁ V₂)) :=
    (MorphismProperty.arrow_mk_iso_iff (@IsFinite : MorphismProperty Scheme.{u})
      (morphismRestrictRestrict π (gY ⁻¹ᵁ W) (ψ ⁻¹ᵁ V₂))).mpr hπV
  have hcomp : IsFinite (((π ∣_ (gY ⁻¹ᵁ W)) ≫ ψ) ∣_ V₂) := by
    rw [morphismRestrict_comp]
    exact MorphismProperty.comp_mem (@IsFinite) _ _ hπGV hψV₂
  have hfinal : IsFinite (h₄ ∣_ V₂) := by
    rw [← hagreeH] at hcomp
    exact (hopen h₄ _ V₂ hG7).mp hcomp
  exact ⟨h₄, hfac, hh₄p, hsurj,
    ⟨V₂, (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨_, hηV₂⟩, hfinal⟩, hpt⟩

theorem wcpa_dj_ssf_temkin_stable_ih : ∀ (k : Type u) [Field k] [Finite k] (X₃ P₂ : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X₃] [AlgebraicGeometry.IsIntegral P₂] (sP₂ : P₂ ⟶ Spec (.of k))
    (f₃ : X₃ ⟶ P₂), wcpaDjIsProjOver k (f₃ ≫ sP₂) → wcpaDjIsProjOver k sP₂ → Flat f₃ →
    ∀ U₂ : P₂.Opens, U₂ ≠ ⊥ → SmoothOfRelativeDimension 1 (f₃ ∣_ U₂) →
    GeometricallyConnected (f₃ ∣_ U₂) →
    ∀ (n : ℕ) (σ : Fin n → (P₂ ⟶ X₃)), (∀ i, σ i ≫ f₃ = 𝟙 P₂) →
    (∀ (i j : Fin n) (p : P₂), p ∈ U₂ → i ≠ j → σ i p ≠ σ j p) →
    ∀ (D : Scheme.{u}) (ιD : D ⟶ X₃), IsClosedImmersion ιD → AlgebraicGeometry.IsReduced D →
    Flat (ιD ≫ f₃) → Set.range ⇑ιD = ⋃ i, Set.range ⇑(σ i) →
    ∀ nP : ℕ, topologicalKrullDim P₂ = (nP : WithBot ℕ∞) → wcpaDjAltIH.{u} nP →
    ∃ (P' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P') (sP' : P' ⟶ Spec (.of k))
      (β₄ : P' ⟶ P₂),
      β₄ ≫ sP₂ = sP' ∧ wcpaDjIsProjOver k sP' ∧ IsProper β₄ ∧ Surjective β₄ ∧
      (∃ V : P₂.Opens, V ≠ ⊥ ∧ IsFinite (β₄ ∣_ V)) ∧
      ∃ (C : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral C) (g : C ⟶ P') (h₄ : C ⟶ X₃),
        h₄ ≫ f₃ = g ≫ β₄ ∧ wcpaDjIsProjOver k (g ≫ sP') ∧ wcpaDjSemistable g ∧
        IsProper h₄ ∧ Surjective h₄ ∧ (∃ V : X₃.Opens, V ≠ ⊥ ∧ IsFinite (h₄ ∣_ V)) ∧
        ∃ (U' : P'.Opens) (m : ℕ) (τ : Fin m → (P' ⟶ C)),
          U' ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (g ∣_ U') ∧ GeometricallyConnected (g ∣_ U') ∧
          wcpaDjSections g m τ ∧
          ⇑h₄ ⁻¹' ((⋃ i, Set.range ⇑(σ i)) ∪ ⇑f₃ ⁻¹' ((U₂ : Set P₂)ᶜ)) ⊆
            (⋃ i, Set.range ⇑(τ i)) ∪ ⇑g ⁻¹' ((U' : Set P')ᶜ) :=
by
  intro k _ _ X₃ P₂ _ _ sP₂ f₃ hf hP hflat U₂ hU₂ hU₂sm hU₂gc n σ hσ hσd D ιD hιD hDred hDflat
    hDrange nP hdim hIH
  obtain ⟨S, iS, sS, ρ, Y, iY, gY, W, Dset, m, τ, ψ, hρ, hS, hρp, hρs, hρf, hreg, hSdim, hsnc,
    hWD, hY, hss, hτ, hW, hWU, hWsm, hWgc, hpb, hψσ, N, j₃, I, hj₃, hj₃eq, hI1, hI2⟩ :=
    wcpa_dj_ssfi_regular_model k X₃ P₂ sP₂ f₃ hf hP hflat U₂ hU₂ hU₂sm hU₂gc n σ hσ hσd nP hdim hIH
  haveI := iS
  haveI := iY
  have hstr : (ψ ≫ j₃) ≫ @Proj.toSpecZero _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) =
      (gY ⁻¹ᵁ W).ι ≫ gY ≫ sS := by
    rw [Category.assoc, hj₃eq, ← Category.assoc ψ f₃, hpb.w, ← hρ]
    simp only [Category.assoc]
    rw [morphismRestrict_ι_assoc]
  have hc1 : ∀ c (i : Fin (N + 1)), i ∉ I →
      (ψ ≫ j₃) c ∉ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i) := by
    intro c i hi
    rw [Scheme.Hom.comp_apply]
    exact hI1 (ψ c) i hi
  have hc2 : ∀ c, (∃ i ∈ I, (ψ ≫ j₃) c ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i)) →
      (gY ⁻¹ᵁ W).ι c ∈ ⋃ j, Set.range ⇑(τ j) := by
    intro c ⟨i, hi, h⟩
    rw [Scheme.Hom.comp_apply] at h
    exact hI2 c ⟨i, hi, h⟩
  obtain ⟨P', iP', sP', ρ', hρ', hP', hρ'p, hρ's, hρ'f, C, iC, g, π, A, hπg, hC, hgss, hπp, hπs,
    hπf, hAstr, hAagree, U', m', τ', hU', hU'sm, hU'gc, hτ', hTB⟩ :=
    wcpa_dj_ssfi_toroidal_extend k S Y sS gY m τ W Dset nP N I (ψ ≫ j₃) hS hY hss hτ hW hWsm
      hWgc hreg hSdim hIH hsnc hWD hstr hc1 hc2
  haveI := iP'
  haveI := iC
  haveI := hρp
  haveI := hρ'p
  have hgYflat : Flat gY := by
    unfold wcpaDjSemistable at hss
    exact hss.1
  obtain ⟨h₄, hh, hh₄p, hh₄s, hh₄f, hh₄ψ⟩ :=
    wcpa_dj_ssfi_lift_alteration k X₃ P₂ S Y P' C sP₂ f₃ sS ρ gY W ψ sP' ρ' g π N j₃ A hf hP
      hflat hρ hρp hρs hρf hW hpb hgYflat hρ' hρ'p hρ's hρ'f hπg hC hπp hπs hπf hj₃ hj₃eq
      hAstr hAagree
  obtain ⟨hβs, hβf⟩ := wcpa_dj_alteration_comp ρ ρ' hρp hρs hρ's hρf hρ'f
  refine ⟨P', iP', sP', ρ' ≫ ρ, ?_, hP', inferInstance, hβs, hβf, C, iC, g, h₄, hh, hC, hgss,
    hh₄p, hh₄s, hh₄f, U', m', τ', hU', hU'sm, hU'gc, hτ', ?_⟩
  · rw [Category.assoc, hρ, hρ']
  · intro c hc
    apply hTB
    show π c ∈ (⋃ j, Set.range ⇑(τ j)) ∪ ⇑gY ⁻¹' ((W : Set S)ᶜ)
    by_cases hcW : π c ∈ gY ⁻¹ᵁ W
    · have e := hh₄ψ c hcW
      rcases (Set.mem_union _ _ _).mp hc with hσ' | hU
      · left
        have hσ'' : ψ ⟨π c, hcW⟩ ∈ ⋃ i, Set.range ⇑(σ i) := by
          rw [← e]; exact hσ'
        exact hψσ ⟨π c, hcW⟩ hσ''
      · exfalso
        have hU' : f₃ (h₄ c) ∉ (U₂ : Set P₂) := hU
        apply hU'
        have key : f₃ (ψ ⟨π c, hcW⟩) = ρ (gY (π c)) := by
          have h1 : (ψ ≫ f₃) ⟨π c, hcW⟩ = ((gY ⁻¹ᵁ W).ι ≫ gY ≫ ρ) ⟨π c, hcW⟩ := by
            rw [hpb.w, morphismRestrict_ι_assoc]
          simp only [Scheme.Hom.comp_apply] at h1
          exact h1
        rw [e, key]
        exact hWU hcW
    · right
      exact hcW

theorem wcpa_dj_semistable_reduction : ∀ (k : Type u) [Field k] [Finite k] (X₁ P : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X₁] [AlgebraicGeometry.IsIntegral P] (sP : P ⟶ Spec (.of k))
    (f : X₁ ⟶ P), wcpaDjIsProjOver k (f ≫ sP) → wcpaDjIsProjOver k sP →
    ∀ U : P.Opens, U ≠ ⊥ → SmoothOfRelativeDimension 1 (f ∣_ U) → GeometricallyConnected (f ∣_ U) →
    wcpaDjGS f → ∀ nP : ℕ, topologicalKrullDim P = (nP : WithBot ℕ∞) → wcpaDjAltIH.{u} nP →
    ∀ T : Set X₁, IsClosed T → T ≠ Set.univ →
    ∃ (P' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral P') (sP' : P' ⟶ Spec (.of k))
      (β₀ : P' ⟶ P),
      β₀ ≫ sP = sP' ∧ wcpaDjIsProjOver k sP' ∧ IsProper β₀ ∧ Surjective β₀ ∧
      (∃ V : P.Opens, V ≠ ⊥ ∧ IsFinite (β₀ ∣_ V)) ∧
      ∃ (C : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral C) (g : C ⟶ P') (h : C ⟶ X₁),
        h ≫ f = g ≫ β₀ ∧ wcpaDjIsProjOver k (g ≫ sP') ∧ wcpaDjSplitSemistable g ∧
        IsProper h ∧ Surjective h ∧ (∃ V : X₁.Opens, V ≠ ⊥ ∧ IsFinite (h ∣_ V)) ∧
        ∃ (U' : P'.Opens) (m : ℕ) (τ : Fin m → (P' ⟶ C)),
          U' ≠ ⊥ ∧ SmoothOfRelativeDimension 1 (g ∣_ U') ∧ GeometricallyConnected (g ∣_ U') ∧
          wcpaDjSections g m τ ∧
          ⇑h ⁻¹' T ⊆ (⋃ j, Set.range ⇑(τ j)) ∪ ⇑g ⁻¹' ((U' : Set P')ᶜ) :=
by
  intro k _ _ X₁ P _ _ sP f hf hP U hU hUsm hUgc _hGS nP hPdim hIH T hTcl hTne
  obtain ⟨P₁, iP₁, sP₁, β₁, hβ₁, hP₁, hβ₁p, hβ₁s, hβ₁f, X₂, iX₂, f₂, α₂, hαf, hX₂, hα₂p, hα₂s,
    hα₂f, U₁, n, σ, hU₁, hU₁sm, hU₁gc, _hn, hσ, hσd, hT₁⟩ :=
    wcpa_dj_ss_marked_sections k X₁ P sP f hf hP U hU hUsm hUgc T hTcl hTne
  haveI := iP₁
  haveI := iX₂
  obtain ⟨P₂, iP₂, sP₂, β₂, hβ₂, hP₂, hβ₂p, hβ₂s, hβ₂f, X₃, iX₃, f₃, α₃, hα₃f, hX₃, hflat,
    hα₃p, hα₃s, hα₃f', U₂, σ', D, ιD, hU₂, hU₂sm, hU₂gc, hσ', hσ'd, hιD, hDred, hDflat,
    hDrange, hT₂⟩ :=
    wcpa_dj_ssf_flatten k X₂ P₁ sP₁ f₂ hX₂ hP₁ U₁ hU₁ hU₁sm hU₁gc n σ hσ hσd
  haveI := iP₂
  haveI := iX₃
  haveI hsPp : IsProper sP := wcpa_dj_proj_proper k sP hP
  haveI hsP₁p : IsProper sP₁ := wcpa_dj_proj_proper k sP₁ hP₁
  haveI hsP₂p : IsProper sP₂ := wcpa_dj_proj_proper k sP₂ hP₂
  have hP₂dim : topologicalKrullDim P₂ = (nP : WithBot ℕ∞) :=
    (wcpa_dj_alteration_dim_eq k P₂ P₁ sP₂ sP₁ β₂ hβ₂ hβ₂s hβ₂f).trans
      ((wcpa_dj_alteration_dim_eq k P₁ P sP₁ sP β₁ hβ₁ hβ₁s hβ₁f).trans hPdim)
  obtain ⟨P', iP', sP', β₄, hβ₄, hP', hβ₄p, hβ₄s, hβ₄f, C, iC, g, h₄, hhg, hC, hss, hh₄p, hh₄s,
    hh₄f, U', m, τ, hU', hU'sm, hU'gc, hτ, hT₃⟩ :=
    wcpa_dj_ssf_temkin_stable_ih k X₃ P₂ sP₂ f₃ hX₃ hP₂ hflat U₂ hU₂ hU₂sm hU₂gc n σ' hσ' hσ'd
      D ιD hιD hDred hDflat hDrange nP hP₂dim hIH
  haveI := iP'
  haveI := iC
  obtain ⟨P'', iP'', sP'', β₃, hβ₃, hP'', hβ₃p, hβ₃s, hβ₃f, C'', iC'', g'', h₃, hhg₃, hC'',
    hsplit, hh₃p, hh₃s, hh₃f, U'', m'', τ'', hU'', hU''sm, hU''gc, hτ'', hT₄⟩ :=
    wcpa_dj_ss_split k C P' sP' g hC hP' hss U' hU' hU'sm hU'gc m τ hτ
  haveI := iP''
  haveI := iC''
  haveI := hβ₁p
  haveI := hβ₂p
  haveI := hβ₃p
  haveI := hβ₄p
  haveI := hα₂p
  haveI := hα₃p
  haveI := hh₄p
  haveI := hh₃p

  have hβ21p : IsProper (β₂ ≫ β₁) := inferInstance
  obtain ⟨hβ21s, hβ21f⟩ := wcpa_dj_alteration_comp β₁ β₂ hβ₁p hβ₁s hβ₂s hβ₁f hβ₂f
  have hβ421p : IsProper (β₄ ≫ β₂ ≫ β₁) := inferInstance
  obtain ⟨hβ421s, hβ421f⟩ := wcpa_dj_alteration_comp (β₂ ≫ β₁) β₄ hβ21p hβ21s hβ₄s hβ21f hβ₄f
  obtain ⟨hβ0s, hβ0f⟩ :=
    wcpa_dj_alteration_comp (β₄ ≫ β₂ ≫ β₁) β₃ hβ421p hβ421s hβ₃s hβ421f hβ₃f

  have hh32p : IsProper (α₃ ≫ α₂) := inferInstance
  obtain ⟨hh32s, hh32f⟩ := wcpa_dj_alteration_comp α₂ α₃ hα₂p hα₂s hα₃s hα₂f hα₃f'
  have hh432p : IsProper (h₄ ≫ α₃ ≫ α₂) := inferInstance
  obtain ⟨hh432s, hh432f⟩ := wcpa_dj_alteration_comp (α₃ ≫ α₂) h₄ hh32p hh32s hh₄s hh32f hh₄f
  obtain ⟨hh0s, hh0f⟩ :=
    wcpa_dj_alteration_comp (h₄ ≫ α₃ ≫ α₂) h₃ hh432p hh432s hh₃s hh432f hh₃f
  refine ⟨P'', iP'', sP'', β₃ ≫ β₄ ≫ β₂ ≫ β₁, ?_, hP'', inferInstance, hβ0s, hβ0f,
    C'', iC'', g'', h₃ ≫ h₄ ≫ α₃ ≫ α₂, ?_, hC'', hsplit, inferInstance, hh0s, hh0f,
    U'', m'', τ'', hU'', hU''sm, hU''gc, hτ'', ?_⟩
  · rw [Category.assoc, Category.assoc, Category.assoc, hβ₁, hβ₂, hβ₄, hβ₃]
  · have e1 : α₃ ≫ α₂ ≫ f = f₃ ≫ β₂ ≫ β₁ := by
      rw [hαf, ← Category.assoc, hα₃f, Category.assoc]
    have e2 : h₄ ≫ α₃ ≫ α₂ ≫ f = g ≫ β₄ ≫ β₂ ≫ β₁ := by
      rw [e1, ← Category.assoc, hhg, Category.assoc]
    have e3 : h₃ ≫ h₄ ≫ α₃ ≫ α₂ ≫ f = g'' ≫ β₃ ≫ β₄ ≫ β₂ ≫ β₁ := by
      rw [e2, ← Category.assoc, hhg₃, Category.assoc]
    simpa only [Category.assoc] using e3
  · intro x hx
    have hx1 : α₃ (h₄ (h₃ x)) ∈ ⇑α₂ ⁻¹' T := by
      simpa only [Set.mem_preimage, Scheme.Hom.comp_apply] using hx
    have hx2 : h₄ (h₃ x) ∈ ⇑α₃ ⁻¹' ((⋃ i, Set.range ⇑(σ i)) ∪ ⇑f₂ ⁻¹' ((U₁ : Set P₁)ᶜ)) :=
      hT₁ hx1
    have hx3 : h₃ x ∈ ⇑h₄ ⁻¹' ((⋃ i, Set.range ⇑(σ' i)) ∪ ⇑f₃ ⁻¹' ((U₂ : Set P₂)ᶜ)) := hT₂ hx2
    have hx4 : x ∈ ⇑h₃ ⁻¹' ((⋃ i, Set.range ⇑(τ i)) ∪ ⇑g ⁻¹' ((U' : Set P')ᶜ)) := hT₃ hx3
    exact hT₄ hx4

theorem wcpa_dj_sp_torpt_of_params : ∀ (Z : Scheme.{u}) (B : Set Z) (z : Z) (n : ℕ) (w : Fin n → Z.presheaf.stalk z) (J : Finset (Fin n)), (n : WithBot ℕ∞) = ringKrullDim (Z.presheaf.stalk z) → Ideal.span (Set.range w) = IsLocalRing.maximalIdeal (Z.presheaf.stalk z) → (∀ (z' : Z) (hz : z' ⤳ z), (z' ∈ B ↔ ∃ j ∈ J, (Z.presheaf.stalkSpecializes hz).hom (w j) ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z'))) → wcpaDjTorPt Z B z :=
by
  intro Z B z n w J hdim hspan hB
  classical
  refine ⟨n, n, fun j => algebraMap (Z.presheaf.stalk z)
      (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) (w j),
    fun j => if j ∈ J then w j else 1, fun j => if j ∈ J then {j} else ∅,
    hdim, ?_, ?_, ?_, ?_⟩
  · rw [← hspan, Ideal.map_span, ← Set.range_comp]
    rfl
  · intro i i' hii'
    dsimp only
    split_ifs
    · exact Finset.disjoint_singleton.mpr hii'
    · exact Finset.disjoint_empty_right _
    · exact Finset.disjoint_empty_left _
    · exact Finset.disjoint_empty_left _
  · intro i
    dsimp only
    split_ifs with hi
    · rw [Finset.prod_singleton]
      all_goals exact Associated.refl _
    · rw [Finset.prod_empty, map_one]
      all_goals exact Associated.refl _
  · intro z' hz
    rw [hB z' hz]
    constructor
    · rintro ⟨j, hj, hmem⟩
      refine ⟨j, ?_⟩
      dsimp only
      rw [if_pos hj]
      exact hmem
    · rintro ⟨i, hmem⟩
      dsimp only at hmem
      by_cases hi : i ∈ J
      · rw [if_pos hi] at hmem
        exact ⟨i, hi, hmem⟩
      · rw [if_neg hi, map_one] at hmem
        exact absurd hmem (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one)

theorem wcpa_dj_ts_smooth_pt : ∀ (S Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (D : Set S) (y : Y), IsProper g → wcpaDjSections g m τ → (∀ p : S, IsRegularLocalRing (S.presheaf.stalk p)) → wcpaDjSNCSet S D → (∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) → wcpaDjTorPt Y (⇑g ⁻¹' D ∪ ⋃ j, Set.range ⇑(τ j)) y :=
by
  intro S Y _ g m τ D y hprop hsec hreg hD hy
  classical
  haveI := hprop
  obtain ⟨hτg, hdisj, -⟩ := hsec
  obtain ⟨mD, Dc, hDc, hDeq, hloc⟩ := hD
  subst hDeq
  obtain ⟨n, t, hn, ht, a, -, hiff⟩ := hloc (g y)
  haveI := hreg (g y)

  obtain ⟨hNoeth, Q, hQ, β, hQc, hβc, hβl, hβf, hβm⟩ :=
    wcpa_dj_sp_smooth_stalk_model S Y g y inferInstance hy
  haveI := hNoeth
  haveI := hQ

  obtain ⟨e, f, he1, he0, hspanQ, hdimQ⟩ :=
    wcpa_dj_sp_poly_prime_params (S.presheaf.stalk (g y)) n t hn ht Q hQc

  obtain ⟨hspanO, hdimO⟩ := wcpa_dj_sp_flat_unram_params (Localization.AtPrime Q)
    (Y.presheaf.stalk y) β hβl hβf hβm (n + e) _ hspanQ hdimQ
  obtain ⟨w, hw⟩ : ∃ w : Fin (n + e) → Y.presheaf.stalk y,
      w = Fin.append (fun i => (g.stalkMap y).hom (t i))
        (fun k => β (algebraMap (Polynomial (S.presheaf.stalk (g y))) (Localization.AtPrime Q)
          (f k))) := ⟨_, rfl⟩
  have hspanO' : Ideal.span (Set.range w) = IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
    rw [← hspanO]
    congr 2
    funext i
    rw [hw]
    induction i using Fin.addCases with
    | left i =>
      simp only [Fin.append_left]
      exact (RingHom.congr_fun hβc (t i)).symm
    | right k =>
      simp only [Fin.append_right]

  have hDpart := wcpa_dj_sp_snc_pullback_iff S Y g y mD Dc n t a hDc hiff

  have hcl : ∀ j, IsClosed (Set.range ⇑(τ j)) := fun j =>
    (wcpa_dj_sp_section_stalk S Y g (τ j) (g y) inferInstance (hτg j)).1
  by_cases hA : ∃ j p₀, τ j p₀ = y
  swap
  ·
    push_neg at hA
    have hnot : ∀ (z' : Y), z' ⤳ y → ∀ j, z' ∉ Set.range ⇑(τ j) := by
      intro z' hz j hz'
      obtain ⟨p, hp⟩ := hz.mem_closed (hcl j) hz'
      exact hA j p hp
    refine wcpa_dj_sp_torpt_of_params Y _ y (n + e) w
      (Finset.univ.image (fun i => Fin.castAdd e (a i))) hdimO hspanO' ?_
    intro z' hz
    have hD' := hDpart z' hz
    rw [Set.mem_union]
    constructor
    · rintro (h | h)
      · obtain ⟨i, hi⟩ := hD'.mp h
        refine ⟨Fin.castAdd e (a i), Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩, ?_⟩
        rw [hw, Fin.append_left]
        exact hi
      · obtain ⟨j, hj⟩ := Set.mem_iUnion.mp h
        exact absurd hj (hnot z' hz j)
    · rintro ⟨k, hk, hk'⟩
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hk
      rw [hw, Fin.append_left] at hk'
      exact Or.inl (hD'.mpr ⟨i, hk'⟩)
  ·
    obtain ⟨j, p₀, rfl⟩ := hA
    obtain ⟨-, ψ, hψ, hψiff⟩ := wcpa_dj_sp_section_stalk S Y g (τ j) p₀ inferInstance (hτg j)

    have he : e = 1 := by
      rcases Nat.lt_or_ge e 1 with h | h
      · exfalso
        have he0' : e = 0 := by omega
        refine wcpa_dj_sp_no_retraction _ Q (he0 he0') (ψ.comp β) ?_
        rw [RingHom.comp_assoc, hβc, hψ]
      · omega
    subst he

    obtain ⟨hspan'', hker⟩ := wcpa_dj_sp_retraction_kernel (S.presheaf.stalk (g (τ j p₀)))
      (Y.presheaf.stalk (τ j p₀)) (g.stalkMap (τ j p₀)).hom ψ hψ n 1 t
      (fun k => β (algebraMap (Polynomial (S.presheaf.stalk (g (τ j p₀))))
        (Localization.AtPrime Q) (f k))) ht (by rw [hw] at hspanO'; exact hspanO')
    obtain ⟨wd, hwd⟩ : ∃ wd : Fin 1 → Y.presheaf.stalk (τ j p₀),
        wd = fun k => β (algebraMap (Polynomial (S.presheaf.stalk (g (τ j p₀))))
            (Localization.AtPrime Q) (f k)) -
          (g.stalkMap (τ j p₀)).hom (ψ (β (algebraMap (Polynomial (S.presheaf.stalk (g (τ j p₀))))
            (Localization.AtPrime Q) (f k)))) := ⟨_, rfl⟩
    have hker' : RingHom.ker ψ = Ideal.span (Set.range wd) := by
      rw [hwd]; exact hker
    have hspanW : Ideal.span (Set.range (Fin.append (fun i => (g.stalkMap (τ j p₀)).hom (t i)) wd)) =
        IsLocalRing.maximalIdeal (Y.presheaf.stalk (τ j p₀)) := by
      rw [hwd]; exact hspan''
    have hsecIff : ∀ (z' : Y) (hz : z' ⤳ τ j p₀), (z' ∈ ⋃ j', Set.range ⇑(τ j') ↔
        (Y.presheaf.stalkSpecializes hz).hom (wd 0) ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk z')) := by
      intro z' hz
      constructor
      · intro h
        obtain ⟨j', hj'⟩ := Set.mem_iUnion.mp h
        by_cases hjj : j' = j
        · subst hjj
          have hmem : wd 0 ∈ RingHom.ker ψ := by
            rw [hker']; exact Ideal.subset_span ⟨0, rfl⟩
          exact Ideal.mem_comap.mp ((hψiff z' hz).mp hj' hmem)
        · exfalso
          obtain ⟨q, hq⟩ := hz.mem_closed (hcl j') hj'
          exact hdisj j' j q p₀ hjj hq
      · intro h
        refine Set.mem_iUnion.mpr ⟨j, (hψiff z' hz).mpr ?_⟩
        rw [hker', Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        rw [Fin.fin_one_eq_zero k]
        exact SetLike.mem_coe.mpr (Ideal.mem_comap.mpr h)
    refine wcpa_dj_sp_torpt_of_params Y _ (τ j p₀) (n + 1)
      (Fin.append (fun i => (g.stalkMap (τ j p₀)).hom (t i)) wd)
      ((Finset.univ.image (fun i => Fin.castAdd 1 (a i))) ∪ {Fin.natAdd n 0}) hdimO hspanW ?_
    intro z' hz
    have hD' := hDpart z' hz
    have hS' := hsecIff z' hz
    rw [Set.mem_union]
    constructor
    · rintro (h | h)
      · obtain ⟨i, hi⟩ := hD'.mp h
        refine ⟨Fin.castAdd 1 (a i), Finset.mem_union_left _
          (Finset.mem_image.mpr ⟨i, Finset.mem_univ _, rfl⟩), ?_⟩
        rw [Fin.append_left]
        exact hi
      · refine ⟨Fin.natAdd n 0, Finset.mem_union_right _ (Finset.mem_singleton_self _), ?_⟩
        rw [Fin.append_right]
        exact hS'.mp h
    · rintro ⟨k, hk, hk'⟩
      rcases Finset.mem_union.mp hk with hk | hk
      · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hk
        rw [Fin.append_left] at hk'
        exact Or.inl (hD'.mpr ⟨i, hk'⟩)
      · rw [Finset.mem_singleton.mp hk, Fin.append_right] at hk'
        exact Or.inr (hS'.mpr hk')

theorem wcpa_dj_npr_psr_complete : ∀ (Λ : Type u) [CommRing Λ] (I₀ : Ideal Λ), IsAdicComplete I₀ Λ → IsAdicComplete (Ideal.map (MvPowerSeries.C : Λ →+* MvPowerSeries (Fin 2) Λ) I₀ ⊔ Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1}) (MvPowerSeries (Fin 2) Λ) :=
by
  intro Λ _ I₀ hc
  classical
  set I : Ideal (MvPowerSeries (Fin 2) Λ) := Ideal.map (MvPowerSeries.C : Λ →+* MvPowerSeries (Fin 2) Λ) I₀ ⊔ Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} with hI

  let Φ : ℕ → Ideal (MvPowerSeries (Fin 2) Λ) := fun k =>
    { carrier := {f | ∀ e : Fin 2 →₀ ℕ, MvPowerSeries.coeff e f ∈ I₀ ^ (k - (e 0 + e 1))}
      add_mem' := by
        intro a b ha hb e
        rw [LinearMap.map_add]; exact Ideal.add_mem _ (ha e) (hb e)
      zero_mem' := by
        intro e; rw [LinearMap.map_zero]; exact Ideal.zero_mem _
      smul_mem' := by
        intro g f hf e
        rw [smul_eq_mul, MvPowerSeries.coeff_mul]
        refine Ideal.sum_mem _ (fun q hq => ?_)
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hq
        have h0 : q.1 0 + q.2 0 = e 0 := by rw [← hq, Finsupp.add_apply]
        have h1 : q.1 1 + q.2 1 = e 1 := by rw [← hq, Finsupp.add_apply]
        exact Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right (by omega) (hf q.2)) }
  have hΦ : ∀ k f, f ∈ Φ k ↔ ∀ e : Fin 2 →₀ ℕ, MvPowerSeries.coeff e f ∈ I₀ ^ (k - (e 0 + e 1)) :=
    fun k f => Iff.rfl
  have htop : ∀ (J : Ideal Λ) (x : Λ), x ∈ J ^ 0 := by
    intro J x; rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top

  have hmul : ∀ a b, Φ a * Φ b ≤ Φ (a + b) := by
    intro a b
    rw [Ideal.mul_le]
    intro r hr s hs
    refine (hΦ _ _).2 fun e => ?_
    rw [MvPowerSeries.coeff_mul]
    refine Ideal.sum_mem _ (fun q hq => ?_)
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hq
    have h0 : q.1 0 + q.2 0 = e 0 := by rw [← hq, Finsupp.add_apply]
    have h1 : q.1 1 + q.2 1 = e 1 := by rw [← hq, Finsupp.add_apply]
    have hm := Ideal.mul_mem_mul ((hΦ _ _).1 hr q.1) ((hΦ _ _).1 hs q.2)
    rw [← pow_add] at hm
    exact Ideal.pow_le_pow_right (by omega) hm

  have hgen : I ≤ Φ 1 := by
    rw [hI]
    refine sup_le ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro c hc
      rw [Ideal.mem_comap]
      refine (hΦ _ _).2 fun e => ?_
      rw [MvPowerSeries.coeff_C]
      split_ifs with he
      · subst he; simpa using hc
      · exact Ideal.zero_mem _
    · rw [Ideal.span_le]
      intro x hx
      have hX : ∀ i : Fin 2, MvPowerSeries.X i ∈ Φ 1 := by
        intro i
        refine (hΦ _ _).2 fun e => ?_
        rw [MvPowerSeries.coeff_X]
        split_ifs with he
        · subst he
          have h2 : (Finsupp.single i 1 : Fin 2 →₀ ℕ) 0 + (Finsupp.single i 1 : Fin 2 →₀ ℕ) 1 = 1 := by
            fin_cases i <;> simp
          rw [h2, Nat.sub_self]
          exact htop _ _
        · exact Ideal.zero_mem _
      rcases hx with rfl | rfl
      · exact hX 0
      · exact hX 1

  have s1 : ∀ k, I ^ k ≤ Φ k := by
    intro k
    induction k with
    | zero =>
      intro f _
      refine (hΦ _ _).2 fun e => ?_
      rw [Nat.zero_sub]; exact htop _ _
    | succ k ih =>
      rw [pow_succ]
      exact (Ideal.mul_mono ih hgen).trans (hmul k 1)
  have hXI : ∀ i : Fin 2, MvPowerSeries.X i ∈ I := by
    intro i
    rw [hI]
    refine Submodule.mem_sup_right (Ideal.subset_span ?_)
    fin_cases i <;> simp

  have s2 : ∀ k f, f ∈ Φ k → f ∈ I ^ k := by
    intro k
    induction k with
    | zero => intro f _; rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
    | succ k ih =>
      intro f hf
      have hf' := (hΦ _ _).1 hf
      let T0 : MvPowerSeries (Fin 2) Λ := fun e => MvPowerSeries.coeff (e + Finsupp.single 0 1) f
      let T1 : MvPowerSeries (Fin 2) Λ := fun e =>
        if e 0 = 0 then MvPowerSeries.coeff (e + Finsupp.single 1 1) f else 0
      have hT0 : ∀ e, MvPowerSeries.coeff e T0 = MvPowerSeries.coeff (e + Finsupp.single 0 1) f :=
        fun e => rfl
      have hT1 : ∀ e, MvPowerSeries.coeff e T1 =
          if e 0 = 0 then MvPowerSeries.coeff (e + Finsupp.single 1 1) f else 0 := fun e => rfl
      have hs0 : ∀ e : Fin 2 →₀ ℕ, (e + Finsupp.single 0 1 : Fin 2 →₀ ℕ) 0 + (e + Finsupp.single 0 1 : Fin 2 →₀ ℕ) 1
          = e 0 + e 1 + 1 := by
        intro e; simp; omega
      have hs1 : ∀ e : Fin 2 →₀ ℕ, (e + Finsupp.single 1 1 : Fin 2 →₀ ℕ) 0 + (e + Finsupp.single 1 1 : Fin 2 →₀ ℕ) 1
          = e 0 + e 1 + 1 := by
        intro e; simp; omega
      have hid : f = MvPowerSeries.C (MvPowerSeries.coeff 0 f) + MvPowerSeries.X 0 * T0 +
          MvPowerSeries.X 1 * T1 := by
        refine MvPowerSeries.ext fun e => ?_
        rw [map_add, map_add, MvPowerSeries.coeff_C, MvPowerSeries.X_def, MvPowerSeries.X_def,
          MvPowerSeries.coeff_monomial_mul, MvPowerSeries.coeff_monomial_mul, hT0, hT1]
        have hsub1 : (e - Finsupp.single 1 1 : Fin 2 →₀ ℕ) 0 = e 0 := by simp
        by_cases h0 : e 0 = 0
        · have hn0 : ¬ (Finsupp.single (0 : Fin 2) 1 ≤ e) := fun h => by
            have := Finsupp.single_le_iff.1 h; omega
          by_cases h1 : e 1 = 0
          · have he : e = 0 := by
              ext i; fin_cases i
              · exact h0
              · exact h1
            subst he
            simp
          · have he : e ≠ 0 := fun he => h1 (by rw [he]; rfl)
            rw [if_neg he, if_neg hn0, if_pos (Finsupp.single_le_iff.2 (by omega)), hsub1, if_pos h0,
              tsub_add_cancel_of_le (Finsupp.single_le_iff.2 (by omega))]
            simp
        · have he : e ≠ 0 := fun he => h0 (by rw [he]; rfl)
          rw [if_neg he, if_pos (Finsupp.single_le_iff.2 (by omega)),
            tsub_add_cancel_of_le (Finsupp.single_le_iff.2 (by omega))]
          by_cases h1 : Finsupp.single (1 : Fin 2) 1 ≤ e
          · rw [if_pos h1, hsub1, if_neg h0]; simp
          · rw [if_neg h1]; simp
      rw [hid]
      refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_
      · have hc0 : MvPowerSeries.coeff 0 f ∈ I₀ ^ (k + 1) := by simpa using hf' 0
        have := Ideal.mem_map_of_mem (MvPowerSeries.C : Λ →+* MvPowerSeries (Fin 2) Λ) hc0
        rw [Ideal.map_pow] at this
        rw [hI]
        exact Ideal.pow_right_mono le_sup_left _ this
      · rw [pow_succ']
        refine Ideal.mul_mem_mul (hXI 0) (ih _ ((hΦ _ _).2 fun e => ?_))
        have := hf' (e + Finsupp.single 0 1)
        rw [hs0, show k + 1 - (e 0 + e 1 + 1) = k - (e 0 + e 1) by omega] at this
        rw [hT0]; exact this
      · rw [pow_succ']
        refine Ideal.mul_mem_mul (hXI 1) (ih _ ((hΦ _ _).2 fun e => ?_))
        rw [hT1]
        split_ifs with h0
        · have := hf' (e + Finsupp.single 1 1)
          rw [hs1, show k + 1 - (e 0 + e 1 + 1) = k - (e 0 + e 1) by omega] at this
          exact this
        · exact Ideal.zero_mem _

  have smod : ∀ {R : Type u} [CommRing R] (J : Ideal R) (n : ℕ) (x y : R),
      x ≡ y [SMOD J ^ n • (⊤ : Submodule R R)] ↔ x - y ∈ J ^ n := by
    intro R _ J n x y
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top]
  have hH : IsHausdorff I₀ Λ := hc.toIsHausdorff
  have hP : IsPrecomplete I₀ Λ := hc.toIsPrecomplete
  have hA : IsHausdorff I (MvPowerSeries (Fin 2) Λ) := by
    refine ⟨fun x hx => ?_⟩
    refine MvPowerSeries.ext fun e => ?_
    rw [map_zero]
    refine IsHausdorff.haus' (I := I₀) _ (fun j => ?_)
    refine (smod I₀ j _ _).2 ?_
    have h1 := (smod I _ _ _).1 (hx (j + (e 0 + e 1)))
    rw [sub_zero] at h1
    have h2 := (hΦ _ _).1 (s1 _ h1) e
    rw [Nat.add_sub_cancel] at h2
    rw [sub_zero]; exact h2
  have hB : IsPrecomplete I (MvPowerSeries (Fin 2) Λ) := by
    refine ⟨fun F hF => ?_⟩
    have hcoef : ∀ e : Fin 2 →₀ ℕ, ∃ L : Λ, ∀ j,
        MvPowerSeries.coeff e (F (j + (e 0 + e 1))) ≡ L [SMOD I₀ ^ j • (⊤ : Submodule Λ Λ)] := by
      intro e
      refine IsPrecomplete.prec' (I := I₀) (fun j => MvPowerSeries.coeff e (F (j + (e 0 + e 1))))
        (fun {m n} hmn => ?_)
      refine (smod I₀ m _ _).2 ?_
      have h1 := (smod I _ _ _).1 (hF (show m + (e 0 + e 1) ≤ n + (e 0 + e 1) by omega))
      have h2 := (hΦ _ _).1 (s1 _ h1) e
      rw [map_sub, Nat.add_sub_cancel] at h2
      exact h2
    choose L hL using hcoef
    let L' : MvPowerSeries (Fin 2) Λ := L
    have hL' : ∀ e, MvPowerSeries.coeff e L' = L e := fun e => rfl
    refine ⟨L', fun n => ?_⟩
    refine (smod I _ _ _).2 (s2 n _ ((hΦ _ _).2 fun e => ?_))
    rw [LinearMap.map_sub, hL']
    by_cases hn : n ≤ e 0 + e 1
    · rw [Nat.sub_eq_zero_of_le hn]; exact htop _ _
    · have h := (smod I₀ _ _ _).1 (hL e (n - (e 0 + e 1)))
      rw [Nat.sub_add_cancel (by omega)] at h
      exact h
  exact { toIsHausdorff := hA, toIsPrecomplete := hB }

theorem wcpa_dj_npr_boundary_iff : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (D : Set S) (y : Y) (n : ℕ) (t : Fin n → S.presheaf.stalk (g y)) (J : Finset (Fin n)), IsProper g → wcpaDjSections g m τ → (¬ ∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) → (∀ (p' : S) (h : p' ⤳ g y), (p' ∈ D ↔ ∃ j ∈ J, (S.presheaf.stalkSpecializes h).hom (t j) ∈ IsLocalRing.maximalIdeal (S.presheaf.stalk p'))) → ∀ (z' : Y) (hz : z' ⤳ y), (z' ∈ ⇑g ⁻¹' D ∪ ⋃ j, Set.range ⇑(τ j) ↔ ∃ j ∈ J, (Y.presheaf.stalkSpecializes hz).hom ((g.stalkMap y).hom (t j)) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z')) :=
by
  intro S Y g m τ D y n t J hprop hsec hns hiff z' hz
  have hnot : ∀ j, z' ∉ Set.range ⇑(τ j) := by
    intro j hz'
    haveI : IsClosedImmersion (τ j ≫ g) := by rw [hsec.1 j]; infer_instance
    haveI := IsClosedImmersion.of_comp (τ j) g
    have hcl : IsClosed (Set.range ⇑(τ j)) := (τ j).isClosedEmbedding.isClosed_range
    obtain ⟨p₁, hp₁⟩ := hz.mem_closed hcl hz'
    obtain ⟨W, hW, hsm⟩ := hsec.2.2 j p₁
    rw [hp₁] at hW
    exact hns ⟨W, hW, hsm⟩
  have hL : z' ∈ ⇑g ⁻¹' D ∪ ⋃ j, Set.range ⇑(τ j) ↔ g z' ∈ D := by
    constructor
    · rintro (h | h)
      · exact h
      · obtain ⟨j, hj⟩ := Set.mem_iUnion.mp h
        exact absurd hj (hnot j)
    · intro h
      exact Or.inl h
  have hgz : g z' ⤳ g y := hz.map g.continuous
  rw [hL, hiff (g z') hgz]
  apply exists_congr
  intro j
  apply and_congr_right
  intro _
  have key := Scheme.Hom.stalkSpecializes_stalkMap_apply g z' y hz (t j)
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, IsLocalRing.mem_maximalIdeal,
    mem_nonunits_iff, ← key, isUnit_map_iff (g.stalkMap z').hom]

theorem wcpa_dj_ts_node_pt_sgl : ∀ (S Y : Scheme.{u}) (g : Y ⟶ S) (m : ℕ) (τ : Fin m → (S ⟶ Y)) (D : Set S) (y : Y), IsProper g → wcpaDjSections g m τ → (∀ p : S, IsRegularLocalRing (S.presheaf.stalk p)) → wcpaDjMonoNodeForm g D → (¬ ∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ g)) → wcpaDjTorNodeSgl Y (⇑g ⁻¹' D ∪ ⋃ j, Set.range ⇑(τ j)) y :=
by
  intro S Y g m τ D y hprop hsec hreg hMN hns
  classical
  rcases hMN y with hsm | ⟨n, t, J, a, hn, hspan, hiff, ha, e₀, hcomp⟩
  · exact absurd hsm hns
  haveI hRnoeth : IsNoetherianRing (S.presheaf.stalk (g y)) := by
    haveI := hreg (g y)
    infer_instance
  obtain ⟨hRloc, hRnoeth', hRcomp, hRgen, hRdim⟩ :=
    wcpa_dj_npr_completion_data (S.presheaf.stalk (g y)) n t hn hspan
  haveI := hRloc
  haveI := hRnoeth'
  haveI hAloc : IsLocalRing (MvPowerSeries (Fin 2)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y)))) := MvPowerSeries.instIsLocalRing
  haveI hAnoeth : IsNoetherianRing (MvPowerSeries (Fin 2)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y)))) :=
    MvPowerSeries.isNoetherianRing
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))) (S.presheaf.stalk (g y)))
  have hmax := wcpa_dj_npr_psr_maximalIdeal
    (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))) (S.presheaf.stalk (g y)))
  have hgens : Ideal.span ({MvPowerSeries.X 0, MvPowerSeries.X 1} ∪ Set.range (fun l =>
      (MvPowerSeries.C : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
          (S.presheaf.stalk (g y)) →+* MvPowerSeries (Fin 2)
            (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
              (S.presheaf.stalk (g y))))
        (algebraMap (S.presheaf.stalk (g y))
          (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
            (S.presheaf.stalk (g y))) (t l)))) =
      IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2)
        (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
          (S.presheaf.stalk (g y)))) := by
    rw [hmax, hRgen, Ideal.map_span, Ideal.span_union, sup_comm, ← Set.range_comp]
    rfl
  have hdimA := wcpa_dj_npr_psr_dim_ge
    (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))) (S.presheaf.stalk (g y)))
    n hRdim.le
  have hGfin : ({MvPowerSeries.X 0, MvPowerSeries.X 1} ∪ Set.range (fun l =>
      (MvPowerSeries.C : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
          (S.presheaf.stalk (g y)) →+* MvPowerSeries (Fin 2)
            (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
              (S.presheaf.stalk (g y))))
        (algebraMap (S.presheaf.stalk (g y))
          (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
            (S.presheaf.stalk (g y))) (t l)))).Finite :=
    ((Set.finite_singleton _).insert _).union (Set.finite_range _)
  have hrange : ∀ {β : Type u} (f : Fin n → β), (Set.range f).ncard ≤ n := by
    intro β f
    rw [← Set.image_univ]
    calc _ ≤ (Set.univ : Set (Fin n)).ncard := Set.ncard_image_le Set.finite_univ
      _ = n := by rw [Set.ncard_univ, Nat.card_fin]
  have hcard : ({MvPowerSeries.X 0, MvPowerSeries.X 1} ∪ Set.range (fun l =>
      (MvPowerSeries.C : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
          (S.presheaf.stalk (g y)) →+* MvPowerSeries (Fin 2)
            (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
              (S.presheaf.stalk (g y))))
        (algebraMap (S.presheaf.stalk (g y))
          (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
            (S.presheaf.stalk (g y))) (t l)))).ncard ≤ n + 2 := by
    refine (Set.ncard_union_le _ _).trans ?_
    have h2 : ({MvPowerSeries.X 0, MvPowerSeries.X 1} : Set (MvPowerSeries (Fin 2)
        (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
          (S.presheaf.stalk (g y))))).ncard ≤ 2 := by
      refine (Set.ncard_insert_le _ _).trans ?_
      rw [Set.ncard_singleton]
    have h3 := hrange (fun l =>
      (MvPowerSeries.C : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
          (S.presheaf.stalk (g y)) →+* MvPowerSeries (Fin 2)
            (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
              (S.presheaf.stalk (g y))))
        (algebraMap (S.presheaf.stalk (g y))
          (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
            (S.presheaf.stalk (g y))) (t l)))
    omega
  have hsf : Submodule.spanFinrank (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y))))) ≤ n + 2 := by
    rw [← hgens]
    exact (Submodule.spanFinrank_span_le_ncard_of_finite hGfin).trans hcard
  have hup := ringKrullDim_le_spanFinrank_maximalIdeal (MvPowerSeries (Fin 2)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y))))
  have hdimeq : ((n + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim (MvPowerSeries (Fin 2)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y)))) :=
    le_antisymm hdimA (hup.trans (Nat.mono_cast hsf))
  have hregA : IsRegularLocalRing (MvPowerSeries (Fin 2)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y)))) :=
    IsRegularLocalRing.mk (le_antisymm ((Nat.mono_cast hsf).trans hdimA) hup)
  have hcompA : IsAdicComplete (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y))))) (MvPowerSeries (Fin 2)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
        (S.presheaf.stalk (g y)))) := by
    rw [hmax]
    exact wcpa_dj_npr_psr_complete _ _ hRcomp
  have hI : Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - MvPowerSeries.C (∏ j,
      (algebraMap (S.presheaf.stalk (g y)) (AdicCompletion (IsLocalRing.maximalIdeal
        (S.presheaf.stalk (g y))) (S.presheaf.stalk (g y))) (t j)) ^ a j)} =
      Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1 - 1 * ∏ l,
        ((MvPowerSeries.C : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
          (S.presheaf.stalk (g y)) →+* MvPowerSeries (Fin 2)
            (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
              (S.presheaf.stalk (g y))))
          (algebraMap (S.presheaf.stalk (g y))
            (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
              (S.presheaf.stalk (g y))) (t l))) ^ a l} := by
    simp only [one_mul, map_prod, map_pow]
  refine ⟨n, J.card, MvPowerSeries (Fin 2)
      (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y))) (S.presheaf.stalk (g y))),
    inferInstance, hregA, hcompA, MvPowerSeries.X 0, MvPowerSeries.X 1, 1,
    fun l => (MvPowerSeries.C : AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
          (S.presheaf.stalk (g y)) →+* MvPowerSeries (Fin 2)
            (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
              (S.presheaf.stalk (g y))))
        (algebraMap (S.presheaf.stalk (g y))
          (AdicCompletion (IsLocalRing.maximalIdeal (S.presheaf.stalk (g y)))
            (S.presheaf.stalk (g y))) (t l)),
    a, e₀.trans (Ideal.quotEquivOfEq hI),
    fun i => (g.stalkMap y).hom (t (J.equivFin.symm i).1),
    fun i => {(J.equivFin.symm i).1}, isUnit_one, hdimeq, hgens, ?_, ?_, ?_, ?_, ?_⟩
  · intro i i' hii'
    exact Finset.disjoint_singleton.mpr (fun h => hii' (J.equivFin.symm.injective (Subtype.ext h)))
  · intro i
    exact (Finset.card_singleton _).le
  · intro l hl
    refine ⟨J.equivFin ⟨l, ha l hl⟩, ?_⟩
    have he : (J.equivFin.symm (J.equivFin ⟨l, ha l hl⟩)).1 = l := by
      rw [Equiv.symm_apply_apply]
    show l ∈ ({(J.equivFin.symm (J.equivFin ⟨l, ha l hl⟩)).1} : Finset (Fin n))
    rw [he]
    exact Finset.mem_singleton_self l
  · intro i
    have key := RingHom.congr_fun hcomp (t (J.equivFin.symm i).1)
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at key
    rw [Finset.prod_singleton, RingEquiv.trans_apply, key, Ideal.quotEquivOfEq_mk]
  · intro z' hz
    rw [wcpa_dj_npr_boundary_iff S Y g m τ D y n t J hprop hsec hns hiff z' hz]
    constructor
    · rintro ⟨j, hj, hmem⟩
      refine ⟨J.equivFin ⟨j, hj⟩, ?_⟩
      have he : (J.equivFin.symm (J.equivFin ⟨j, hj⟩)).1 = j := by
        rw [Equiv.symm_apply_apply]
      show (Y.presheaf.stalkSpecializes hz).hom
          ((g.stalkMap y).hom (t (J.equivFin.symm (J.equivFin ⟨j, hj⟩)).1)) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk z')
      rw [he]
      exact hmem
    · rintro ⟨i, hmem⟩
      exact ⟨(J.equivFin.symm i).1, (J.equivFin.symm i).2, hmem⟩

theorem wcpa_dj_rts_terminal : ∀ (Z : Scheme.{u}) (B : Set Z) (z : Z), wcpaDjTorNodeSgl Z B z → IsRegularLocalRing (Z.presheaf.stalk z) → wcpaDjTorPt Z B z :=
by
  classical

  have hcard : ∀ {α : Type u} {k : ℕ} (g : Fin k → α), (Set.range g).ncard ≤ k := by
    intro α k g
    rw [← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]

  have hS10 : ∀ (Ô A : Type u) [CommRing Ô] [CommRing A] (ε : A →+* Ô) (n₀ : ℕ) (x y v : A)
      (σ : Fin (n₀ + 1) → A) (l₀ : Fin (n₀ + 1)), IsUnit (ε v) →
      ε x * ε y = ε v * ε (σ l₀) →
      Ideal.span (Set.range (fun j => ε ((Fin.cons x (Fin.cons y (fun k => σ (l₀.succAbove k))) :
        Fin (n₀ + 2) → A) j))) = Ideal.map ε (Ideal.span ({x, y} ∪ Set.range σ)) := by
    intro Ô A _ _ ε n₀ x y v σ l₀ hv hrel
    have hL : Ideal.span (Set.range (fun j => ε ((Fin.cons x (Fin.cons y (fun k => σ (l₀.succAbove k))) :
        Fin (n₀ + 2) → A) j))) = Ideal.map ε (Ideal.span (Set.range
          (Fin.cons x (Fin.cons y (fun k => σ (l₀.succAbove k))) : Fin (n₀ + 2) → A))) := by
      rw [Ideal.map_span, ← Set.range_comp]
      rfl
    rw [hL]
    have hw2 : ∀ k : Fin n₀, (Fin.cons x (Fin.cons y (fun k => σ (l₀.succAbove k))) :
        Fin (n₀ + 2) → A) k.succ.succ = σ (l₀.succAbove k) := fun k => rfl
    apply le_antisymm
    · apply Ideal.map_mono
      apply Ideal.span_mono
      rintro _ ⟨j, rfl⟩
      refine Fin.cases ?_ (fun j' => Fin.cases ?_ (fun k => ?_) j') j
      · exact Or.inl (Set.mem_insert x {y})
      · exact Or.inl (Set.mem_insert_of_mem x rfl)
      · rw [hw2]; exact Or.inr ⟨_, rfl⟩
    · rw [Ideal.map_le_iff_le_comap]
      have hmem : ∀ j, ε ((Fin.cons x (Fin.cons y (fun k => σ (l₀.succAbove k))) :
          Fin (n₀ + 2) → A) j) ∈ Ideal.map ε (Ideal.span (Set.range
            (Fin.cons x (Fin.cons y (fun k => σ (l₀.succAbove k))) : Fin (n₀ + 2) → A))) :=
        fun j => Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨j, rfl⟩)
      apply Ideal.span_le.mpr
      rintro g (hg | ⟨l, rfl⟩)
      · rcases hg with rfl | hg
        · exact hmem 0
        · rw [Set.mem_singleton_iff] at hg
          subst hg
          exact hmem (Fin.succ 0)
      · show σ l ∈ Ideal.comap ε (Ideal.map ε (Ideal.span (Set.range
            (Fin.cons x (Fin.cons y (fun k => σ (l₀.succAbove k))) : Fin (n₀ + 2) → A))))
        rw [Ideal.mem_comap]
        by_cases hl : l = l₀
        · subst hl
          obtain ⟨u, hu⟩ := hv
          have : ε (σ l) = ↑u⁻¹ * (ε x * ε y) := by
            rw [hrel, ← hu, ← mul_assoc, Units.inv_mul, one_mul]
          rw [this]
          exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_right _ _ (hmem 0))
        · obtain ⟨k, rfl⟩ := Fin.exists_succAbove_eq hl
          have := hmem k.succ.succ
          rwa [hw2] at this
  have hS11 : ∀ (Ô A : Type u) [CommRing Ô] [CommRing A] (ε : A →+* Ô) (n₀ : ℕ) (x y v : A)
      (σ : Fin (n₀ + 1) → A) (l₀ : Fin (n₀ + 1)), IsUnit (ε v) →
      ε x * ε y = ε v * ε (σ l₀) → ∀ (q : ℕ) (J : Fin q → Finset (Fin (n₀ + 1)))
      (c : Fin q → Ô), (∀ i i', i ≠ i' → Disjoint (J i) (J i')) →
      (∀ i, Associated (c i) (ε (∏ l ∈ J i, σ l))) →
      ∃ J' : Fin q → Finset (Fin (n₀ + 2)), (∀ i i', i ≠ i' → Disjoint (J' i) (J' i')) ∧
        ∀ i, Associated (c i) (∏ j ∈ J' i,
          ε ((Fin.cons x (Fin.cons y (fun k => σ (l₀.succAbove k))) : Fin (n₀ + 2) → A) j)) := by
    intro Ô A _ _ ε n₀ x y v σ l₀ hv hrel q J c hdisj hass
    set w : Fin (n₀ + 2) → A := Fin.cons x (Fin.cons y (fun k => σ (l₀.succAbove k))) with hw
    set g : Fin (n₀ + 2) → Fin (n₀ + 1) := Fin.cons l₀ (Fin.cons l₀ l₀.succAbove) with hg
    refine ⟨fun i => Finset.univ.filter (fun j => g j ∈ J i), ?_, ?_⟩
    · intro i i' hii'
      rw [Finset.disjoint_left]
      intro j hj hj'
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj hj'
      exact Finset.disjoint_left.mp (hdisj i i' hii') hj hj'
    · intro i
      have hG : ∀ l, Associated (ε (σ l))
          (∏ j ∈ Finset.univ.filter (fun j => g j = l), ε (w j)) := by
        intro l
        rw [Finset.prod_filter, Fin.prod_univ_succ, Fin.prod_univ_succ]
        have e0 : g 0 = l₀ := rfl
        have e1 : g (Fin.succ 0) = l₀ := rfl
        have e2 : ∀ k : Fin n₀, g k.succ.succ = l₀.succAbove k := fun k => rfl
        have f0 : w 0 = x := rfl
        have f1 : w (Fin.succ 0) = y := rfl
        have f2 : ∀ k : Fin n₀, w k.succ.succ = σ (l₀.succAbove k) := fun k => rfl
        simp only [e0, e1, e2, f0, f1, f2]
        by_cases hl : l = l₀
        · subst hl
          have hne : ∀ k : Fin n₀, ¬ (l.succAbove k = l) := fun k => Fin.succAbove_ne l k
          simp only [hne, if_false, Finset.prod_const_one, if_true, mul_one]
          obtain ⟨u, hu⟩ := hv
          rw [hrel, ← hu]
          exact (associated_unit_mul_left _ _ u.isUnit).symm
        · have hl' : ¬ (l₀ = l) := fun h => hl h.symm
          simp only [hl', if_false, one_mul]
          obtain ⟨k₀, rfl⟩ := Fin.exists_succAbove_eq hl
          rw [Finset.prod_eq_single k₀]
          · simp
          · intro k _ hk
            rw [if_neg]
            intro h
            exact hk (Fin.succAbove_right_injective h)
          · intro h; exact absurd (Finset.mem_univ k₀) h
      refine (hass i).trans ?_
      rw [map_prod]
      rw [← Finset.prod_fiberwise_of_maps_to (s := Finset.univ.filter (fun j => g j ∈ J i))
        (t := J i) (g := g) (fun j hj => (Finset.mem_filter.mp hj).2)]
      apply Associated.prod
      intro l hl
      refine (hG l).trans ?_
      rw [Finset.filter_filter]
      apply Associated.of_eq
      apply Finset.prod_congr _ (fun _ _ => rfl)
      ext j
      simp only [Finset.mem_filter, Finset.mem_univ, true_and]
      constructor
      · intro h; exact ⟨h ▸ hl, h⟩
      · intro h; exact h.2

  have hS13 : ∀ (Ô A : Type u) [CommRing Ô] [CommRing A] (ε : A →+* Ô) (n : ℕ) (x y : A)
      (σ : Fin n → A) (q : ℕ) (J : Fin q → Finset (Fin n)) (c : Fin q → Ô),
      (∀ i i', i ≠ i' → Disjoint (J i) (J i')) →
      (∀ i, Associated (c i) (ε (∏ l ∈ J i, σ l))) →
      (∃ J' : Fin q → Finset (Fin (n + 2)), (∀ i i', i ≠ i' → Disjoint (J' i) (J' i')) ∧
        ∀ i, Associated (c i) (∏ j ∈ J' i, ε ((Fin.cons x (Fin.cons y σ) : Fin (n + 2) → A) j))) ∧
      Ideal.span (Set.range (fun j => ε ((Fin.cons x (Fin.cons y σ) : Fin (n + 2) → A) j))) =
        Ideal.map ε (Ideal.span ({x, y} ∪ Set.range σ)) := by
    intro Ô A _ _ ε n x y σ q J c hdisj hass
    refine ⟨⟨fun i => (J i).map ((Fin.succEmb _).trans (Fin.succEmb _)),
      fun i i' hii' => ?_, fun i => ?_⟩, ?_⟩
    · rw [Finset.disjoint_map]; exact hdisj i i' hii'
    · rw [Finset.prod_map]
      refine (hass i).trans (Associated.of_eq ?_)
      rw [map_prod]
      rfl
    · rw [Ideal.map_span]
      congr 1
      rw [show (fun j => ε ((Fin.cons x (Fin.cons y σ) : Fin (n + 2) → A) j)) =
        ⇑ε ∘ (Fin.cons x (Fin.cons y σ) : Fin (n + 2) → A) from rfl, Set.range_comp,
        Fin.range_cons, Fin.range_cons, Set.insert_union, Set.singleton_union]

  have main : ∀ (Ô A : Type u) [CommRing Ô] [IsLocalRing Ô] [IsNoetherianRing Ô] [CommRing A]
      [IsRegularLocalRing A] (n q d : ℕ) (x y v : A) (σ : Fin n → A) (b : Fin n → ℕ)
      (e : Ô ≃+* A ⧸ Ideal.span {x * y - v * ∏ l, σ l ^ b l}) (c : Fin q → Ô)
      (J : Fin q → Finset (Fin n)) (u : Fin d → Ô), IsUnit v →
      ((n + 2 : ℕ) : WithBot ℕ∞) = ringKrullDim A →
      Ideal.span ({x, y} ∪ Set.range σ) = IsLocalRing.maximalIdeal A →
      (∀ i i', i ≠ i' → Disjoint (J i) (J i')) →
      (∀ i, Associated (e (c i))
        (Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ l, σ l ^ b l}) (∏ l ∈ J i, σ l))) →
      (d : WithBot ℕ∞) = ringKrullDim Ô →
      Ideal.span (Set.range u) = IsLocalRing.maximalIdeal Ô →
      ∃ (n' : ℕ) (s : Fin n' → Ô) (J' : Fin q → Finset (Fin n')),
        (n' : WithBot ℕ∞) = ringKrullDim Ô ∧ Ideal.span (Set.range s) = IsLocalRing.maximalIdeal Ô ∧
        (∀ i i', i ≠ i' → Disjoint (J' i) (J' i')) ∧ ∀ i, Associated (c i) (∏ j ∈ J' i, s j) := by
    intro Ô A _ _ _ _ _ n q d x y v σ b e c J u hv hdimA hspan hdisj hass hdÔ hu
    let ε : A →+* Ô :=
      e.symm.toRingHom.comp (Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ l, σ l ^ b l}))
    have hεapp : ∀ a, ε a = e.symm (Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ l, σ l ^ b l}) a) :=
      fun a => rfl
    have hεsurj : Function.Surjective ε := e.symm.surjective.comp Ideal.Quotient.mk_surjective
    have hker : RingHom.ker ε = Ideal.span {x * y - v * ∏ l, σ l ^ b l} := by
      ext a
      rw [RingHom.mem_ker, hεapp, EmbeddingLike.map_eq_zero_iff, Ideal.Quotient.eq_zero_iff_mem]
    have hεf : ε (x * y - v * ∏ l, σ l ^ b l) = 0 := by
      rw [← RingHom.mem_ker, hker]; exact Ideal.mem_span_singleton_self _
    have hassε : ∀ i, Associated (c i) (ε (∏ l ∈ J i, σ l)) := by
      intro i
      have := (hass i).map e.symm
      rw [RingEquiv.symm_apply_apply] at this
      exact this
    have hx : x ∈ IsLocalRing.maximalIdeal A :=
      hspan ▸ Ideal.subset_span (Or.inl (Set.mem_insert x {y}))
    have hy : y ∈ IsLocalRing.maximalIdeal A :=
      hspan ▸ Ideal.subset_span (Or.inl (Set.mem_insert_of_mem x rfl))
    have hσ : ∀ l, σ l ∈ IsLocalRing.maximalIdeal A :=
      fun l => hspan ▸ Ideal.subset_span (Or.inr ⟨l, rfl⟩)
    have hM : Ideal.comap ε (IsLocalRing.maximalIdeal Ô) = IsLocalRing.maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal (Ideal.comap_isMaximal_of_surjective ε hεsurj)
    have hM' : Ideal.map ε (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal Ô := by
      rw [← hM, Ideal.map_comap_of_surjective ε hεsurj]
    have hfm : x * y - v * ∏ l, σ l ^ b l ∈ IsLocalRing.maximalIdeal A := by
      rw [← hM, Ideal.mem_comap, hεf]; exact zero_mem _
    have hA_bound : ∀ (k : ℕ) (g : Fin k → A),
        Ideal.span (Set.range g) = IsLocalRing.maximalIdeal A → n + 2 ≤ k := by
      intro k g hg
      have h1 : (IsLocalRing.maximalIdeal A).spanFinrank ≤ (Set.range g).ncard := by
        rw [← hg]; exact Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range g)
      have h3 : (((IsLocalRing.maximalIdeal A).spanFinrank : ℕ) : WithBot ℕ∞) =
          ((n + 2 : ℕ) : WithBot ℕ∞) := by
        rw [hdimA]; exact IsRegularLocalRing.spanFinrank_maximalIdeal
      have h4 : (IsLocalRing.maximalIdeal A).spanFinrank = n + 2 := by exact_mod_cast h3
      have := hcard g
      omega
    have hÔ_bound : ∀ (k : ℕ) (g : Fin k → Ô),
        Ideal.span (Set.range g) = IsLocalRing.maximalIdeal Ô → d ≤ k := by
      intro k g hg
      have h1 : (IsLocalRing.maximalIdeal Ô).spanFinrank ≤ k := by
        rw [← hg]
        exact (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range g)).trans (hcard g)
      have h2 := Ideal.height_le_spanFinrank (IsLocalRing.maximalIdeal Ô)
        (inferInstance : (IsLocalRing.maximalIdeal Ô).IsMaximal).ne_top
      have h3 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := Ô)
      rw [← hdÔ] at h3
      have h4 : (IsLocalRing.maximalIdeal Ô).height = (d : ℕ∞) := by exact_mod_cast h3
      have h5 : (d : ℕ∞) ≤ (k : ℕ∞) := h4 ▸ h2.trans (by exact_mod_cast h1)
      exact_mod_cast h5

    choose a ha using fun j => hεsurj (u j)
    have hmapa : IsLocalRing.maximalIdeal Ô = Ideal.map ε (Ideal.span (Set.range a)) := by
      rw [← hu, Ideal.map_span, ← Set.range_comp]
      have : (⇑ε ∘ a) = u := funext ha
      rw [this]
    have ha_mem : ∀ j, a j ∈ IsLocalRing.maximalIdeal A := by
      intro j
      rw [← hM, Ideal.mem_comap, ha, ← hu]
      exact Ideal.subset_span ⟨j, rfl⟩
    have hle : IsLocalRing.maximalIdeal A ≤
        Ideal.span (Set.range a) ⊔ Ideal.span {x * y - v * ∏ l, σ l ^ b l} := by
      intro m hm
      rw [← hM, Ideal.mem_comap, hmapa] at hm
      have := Ideal.comap_map_of_surjective ε hεsurj (Ideal.span (Set.range a))
      rw [← RingHom.ker_eq_comap_bot, hker] at this
      rw [← this]
      exact hm
    have hspanA : Ideal.span (Set.range (Fin.cons (x * y - v * ∏ l, σ l ^ b l) a :
        Fin (d + 1) → A)) = IsLocalRing.maximalIdeal A := by
      rw [Fin.range_cons, Ideal.span_insert]
      apply le_antisymm
      · exact sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hfm)
          (Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact ha_mem j))
      · exact hle.trans (le_of_eq (sup_comm _ _))
    have hlow : n + 1 ≤ d := by have := hA_bound _ _ hspanA; omega
    rcases Nat.lt_or_ge (∑ l, b l) 2 with hlt | hge
    · rcases Nat.lt_or_ge (∑ l, b l) 1 with h0 | h1
      ·
        exfalso
        have hb0 : ∀ l, b l = 0 := fun l =>
          (Finset.sum_eq_zero_iff.mp (by omega)) l (Finset.mem_univ l)
        have hprod : ∏ l, σ l ^ b l = 1 :=
          Finset.prod_eq_one (fun l _ => by rw [hb0 l, pow_zero])
        have hvm : v ∈ IsLocalRing.maximalIdeal A := by
          have hv' : v = x * y - (x * y - v * ∏ l, σ l ^ b l) := by rw [hprod]; ring
          rw [hv']
          exact sub_mem (Ideal.mul_mem_right _ _ hx) hfm
        exact ((IsLocalRing.mem_maximalIdeal v).mp hvm) hv
      ·
        obtain ⟨l₀, -, hl₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero (by omega : ∑ l, b l ≠ 0)
        have hbl₀ : b l₀ = 1 := by
          have := Finset.single_le_sum (fun l _ => Nat.zero_le (b l)) (Finset.mem_univ l₀)
          omega
        have hb0 : ∀ l, l ≠ l₀ → b l = 0 := by
          intro l hl
          have h2 : ∑ i ∈ ({l, l₀} : Finset _), b i ≤ ∑ i, b i :=
            Finset.sum_le_sum_of_subset (Finset.subset_univ _)
          rw [Finset.sum_pair hl] at h2
          omega
        obtain ⟨n₀, rfl⟩ : ∃ n₀, n = n₀ + 1 := ⟨n - 1, by have := l₀.pos; omega⟩
        have hprod : ∏ l, σ l ^ b l = σ l₀ := by
          rw [Finset.prod_eq_single_of_mem l₀ (Finset.mem_univ _)
            (fun l _ hl => by rw [hb0 l hl, pow_zero]), hbl₀, pow_one]
        have hrel : ε x * ε y = ε v * ε (σ l₀) := by
          have := hεf
          rw [hprod, map_sub, map_mul, map_mul, sub_eq_zero] at this
          exact this
        have hv' : IsUnit (ε v) := hv.map ε
        have hs := hS10 Ô A ε n₀ x y v σ l₀ hv' hrel
        rw [hspan, hM'] at hs
        have hdn : d = n₀ + 2 := by have := hÔ_bound _ _ hs; omega
        obtain ⟨J', hJ'd, hJ'a⟩ := hS11 Ô A ε n₀ x y v σ l₀ hv' hrel q J c hdisj hassε
        exact ⟨n₀ + 2, _, J', by rw [← hdÔ, hdn], hs, hJ'd, hJ'a⟩
    ·
      have hf2 : x * y - v * ∏ l, σ l ^ b l ∈ IsLocalRing.maximalIdeal A ^ 2 := by
        refine Ideal.sub_mem _ ?_ ?_
        · rw [pow_two]; exact Ideal.mul_mem_mul hx hy
        · apply Ideal.mul_mem_left
          have h1 : ∏ l, σ l ^ b l ∈ ∏ l : Fin n, IsLocalRing.maximalIdeal A ^ b l :=
            Ideal.prod_mem_prod (fun l _ => Ideal.pow_mem_pow (hσ l) _)
          rw [Finset.prod_pow_eq_pow_sum] at h1
          exact Ideal.pow_le_pow_right hge h1
      have hle2 : IsLocalRing.maximalIdeal A ≤
          Ideal.span (Set.range a) ⊔ IsLocalRing.maximalIdeal A • IsLocalRing.maximalIdeal A := by
        refine hle.trans (sup_le_sup_left ?_ _)
        rw [Ideal.span_singleton_le_iff_mem, Ideal.smul_eq_mul, ← pow_two]
        exact hf2
      have hfg : (IsLocalRing.maximalIdeal A).FG := IsNoetherian.noetherian _
      have hle3 : IsLocalRing.maximalIdeal A ≤ Ideal.span (Set.range a) :=
        Submodule.le_of_le_smul_of_le_jacobson_bot hfg
          (IsLocalRing.maximalIdeal_le_jacobson _) hle2
      have hm_eq : Ideal.span (Set.range a) = IsLocalRing.maximalIdeal A :=
        le_antisymm (Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact ha_mem j)) hle3
      have hd2 : n + 2 ≤ d := hA_bound d a hm_eq
      obtain ⟨⟨J', hJ'd, hJ'a⟩, hs⟩ := hS13 Ô A ε n x y σ q J c hdisj hassε
      rw [hspan, hM'] at hs
      have hdn : d = n + 2 := by have := hÔ_bound _ _ hs; omega
      exact ⟨n + 2, _, J', by rw [← hdÔ, hdn], hs, hJ'd, hJ'a⟩
  intro Z B z hnode hreg
  obtain ⟨n, q, A, iA, iAreg, _, x, y, v, σ, b, e, h, J, hv, hdimA, hspan, hdisj, _, _, hass,
    hiff⟩ := hnode
  obtain ⟨d, t, hd, ht⟩ : ∃ (d : ℕ) (t : Fin d → Z.presheaf.stalk z),
      (d : WithBot ℕ∞) = ringKrullDim (Z.presheaf.stalk z) ∧
      Ideal.span (Set.range t) = IsLocalRing.maximalIdeal (Z.presheaf.stalk z) := by
    have hfg : (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)).FG := IsNoetherian.noetherian _
    obtain ⟨S, hS, hSspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hfg
    have hfin : S.Finite := Set.finite_of_encard_eq_coe hS
    obtain ⟨d, f, hf⟩ := hfin.fin_embedding
    have hd : d = (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)).spanFinrank := by
      have h1 : S.ncard = d := by
        rw [← hf, Set.ncard_range_of_injective f.injective, Nat.card_eq_fintype_card,
          Fintype.card_fin]
      have h2 := hfin.cast_ncard_eq
      rw [hS, h1] at h2
      exact_mod_cast h2
    refine ⟨d, f, ?_, ?_⟩
    · rw [hd]; exact IsRegularLocalRing.spanFinrank_maximalIdeal
    · rw [hf]; exact hSspan
  obtain ⟨iloc, iNoeth, _, hmÔ, hdÔ⟩ := wcpa_dj_npr_completion_data (Z.presheaf.stalk z) d t hd ht
  obtain ⟨n', s, J', h1, h2, h3, h4⟩ := main _ A n q d x y v σ b e
    (fun i => algebraMap _ _ (h i)) J (fun i => algebraMap _ _ (t i)) hv hdimA hspan hdisj hass
    hdÔ hmÔ.symm
  refine ⟨n', q, s, h, J', ?_, ?_, h3, h4, hiff⟩
  · rw [h1, ← hdÔ, hd]
  · rw [h2, hmÔ, ← ht, Ideal.map_span, ← Set.range_comp]
    rfl

theorem wcpa_dj_rnb_blowup_charts : ∀ (k : Type u) [Field k] (Y P : Scheme.{u}) (sY : Y ⟶ Spec (.of k)) (I : Y.IdealSheafData) (π : P ⟶ Y), IsSeparated sY → wcCsdIsBlowup I π → ∀ (U : Y.affineOpens) (r : ℕ) (f : Fin (r + 1) → Γ(Y, U)), Ideal.span (Set.range f) = I.ideal U → ∃ V : Fin (r + 1) → P.Opens, (⨆ i, V i) = π ⁻¹ᵁ (U : Y.Opens) ∧ ∀ i, ∃ hV : V i ≤ π ⁻¹ᵁ (U : Y.Opens), IsAffineOpen (V i) ∧ ∃ e : Γ(P, V i) ≃+* (Algebra.adjoin Γ(Y, U) (Set.range fun l => IsLocalization.mk' (Localization.Away (f i)) (f l) (⟨f i, Submonoid.mem_powers _⟩ : Submonoid.powers (f i)))), ∀ a : Γ(Y, U), e ((π.appLE (U : Y.Opens) (V i) hV).hom a) = algebraMap Γ(Y, U) _ a :=
by
  intro k _ Y P sY I π hsep hbl U r f hf
  classical

  have n6 : ∀ (X : Scheme.{u}) [IsAffine X] (J : X.IdealSheafData) (T : Ideal Γ(X, ⊤)),
      J.ideal ⟨⊤, isAffineOpen_top X⟩ = T → J = Scheme.IdealSheafData.ofIdealTop T := by
    intro X _ J T h
    subst h
    rw [← Scheme.IdealSheafData.equivOfIsAffine_symm_apply,
      ← Scheme.IdealSheafData.equivOfIsAffine_apply]
    exact (Scheme.IdealSheafData.equivOfIsAffine.symm_apply_apply J).symm

  have n5 : ∀ (Y : Scheme.{u}) (U : Y.Opens),
      Function.Bijective (U.ι.appLE U ⊤ (Scheme.Opens.ι_preimage_self U).ge).hom := by
    intro Y U
    rw [Scheme.Opens.ι_appLE]
    have key : ∀ {V W : Y.Opens} (h : V ≤ W), V = W →
        Function.Bijective (Y.presheaf.map (homOfLE h).op).hom := by
      intro V W h e
      subst e
      have : homOfLE h = 𝟙 V := Subsingleton.elim _ _
      rw [this, op_id, Y.presheaf.map_id, CommRingCat.hom_id, RingHom.coe_id]
      exact Function.bijective_id
    exact key _ (Scheme.Opens.ι_image_top U)

  have n4 : ∀ (P0 Y' Y : Scheme.{u}) (κ : P0 ⟶ Y') [IsOpenImmersion κ] (π : Y' ⟶ Y)
      (ρ : P0 ⟶ Y) (U : Y.Opens) (W : P0.Opens), κ ≫ π = ρ → ∀ (hW : W ≤ ρ ⁻¹ᵁ U)
      (hV : κ ''ᵁ W ≤ π ⁻¹ᵁ U) (a : Γ(Y, U)),
      (κ.appIso W).hom.hom ((π.appLE U (κ ''ᵁ W) hV).hom a) = (ρ.appLE U W hW).hom a := by
    intro P0 Y' Y κ _ π ρ U W hκ hW hV a
    subst hκ
    have : π.appLE U (κ ''ᵁ W) hV ≫ (κ.appIso W).hom = (κ ≫ π).appLE U W hW := by
      rw [Scheme.Hom.appIso_hom, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map,
        Scheme.Hom.appLE_comp_appLE]
    exact congrArg (fun h => h.hom a) this

  have n1 : ∀ (A A0 B : Type u) [CommRing A] [CommRing A0] [CommRing B] (τ : A →+* A0) (r : ℕ)
      (f : Fin (r + 1) → A) (a : Fin (r + 1)) (φ : A0 →+* B) (t : Fin (r + 1) → B)
      (ψ : B →+* Localization.Away (τ (f a))), Function.Bijective τ → Function.Injective ψ →
      (∀ x, ψ (φ x) = algebraMap A0 (Localization.Away (τ (f a))) x) →
      (∀ j, φ (τ (f j)) = t j * φ (τ (f a))) →
      (∀ b : B, b ∈ Subring.closure (Set.range φ ∪ Set.range t)) →
      ∃ e : B ≃+* (Algebra.adjoin A (Set.range fun l => IsLocalization.mk'
        (Localization.Away (f a)) (f l) (⟨f a, Submonoid.mem_powers _⟩ : Submonoid.powers (f a)))),
        ∀ x : A, e (φ (τ x)) = algebraMap A _ x := by
    intro A A0 B _ _ _ τ r f a φ t ψ hτ hψ hψφ hc3 hgen
    set T := RingEquiv.ofBijective τ hτ with hT
    have hTa : ∀ x, T x = τ x := fun x => rfl
    have hH : Submonoid.map T.symm.toMonoidHom (Submonoid.powers (τ (f a))) =
        Submonoid.powers (f a) := by
      rw [Submonoid.map_powers]
      congr 1
      rw [← hTa]
      exact T.symm_apply_apply (f a)
    let κ := IsLocalization.ringEquivOfRingEquiv (Localization.Away (τ (f a)))
      (Localization.Away (f a)) T.symm hH
    have hκ : ∀ y, κ (algebraMap A0 _ y) = algebraMap A _ (T.symm y) := fun y =>
      IsLocalization.ringEquivOfRingEquiv_eq hH y
    let Ψ : B →+* Localization.Away (f a) := κ.toRingHom.comp ψ
    have hΨinj : Function.Injective Ψ := κ.injective.comp hψ
    have hΨφ : ∀ x : A, Ψ (φ (τ x)) = algebraMap A _ x := by
      intro x
      show κ (ψ (φ (τ x))) = _
      rw [hψφ, hκ, ← hTa, T.symm_apply_apply]
    have hΨt : ∀ j, Ψ (t j) = IsLocalization.mk' (Localization.Away (f a)) (f j)
        (⟨f a, Submonoid.mem_powers _⟩ : Submonoid.powers (f a)) := by
      intro j
      rw [IsLocalization.eq_mk'_iff_mul_eq]
      show Ψ (t j) * algebraMap A _ (f a) = algebraMap A _ (f j)
      rw [← hΨφ, ← hΨφ, ← map_mul, ← hc3]
    set S := Algebra.adjoin A (Set.range fun l => IsLocalization.mk' (Localization.Away (f a))
        (f l) (⟨f a, Submonoid.mem_powers _⟩ : Submonoid.powers (f a))) with hS
    have hmem : ∀ b, Ψ b ∈ S := by
      intro b
      have hle : Subring.closure (Set.range φ ∪ Set.range t) ≤ S.toSubring.comap Ψ := by
        rw [Subring.closure_le]
        rintro _ (⟨y, rfl⟩ | ⟨j, rfl⟩)
        · show Ψ (φ y) ∈ S
          obtain ⟨x, rfl⟩ := hτ.2 y
          rw [hΨφ]; exact S.algebraMap_mem x
        · show Ψ (t j) ∈ S
          rw [hΨt]; exact Algebra.subset_adjoin ⟨j, rfl⟩
      exact hle (hgen b)
    have hsurj : S.toSubring ≤ Ψ.range := by
      rw [Algebra.adjoin_eq_ring_closure, Subring.closure_le]
      rintro _ (⟨x, rfl⟩ | ⟨j, rfl⟩)
      · exact ⟨φ (τ x), hΨφ x⟩
      · exact ⟨t j, hΨt j⟩
    refine ⟨RingEquiv.ofBijective (Ψ.codRestrict S hmem) ⟨?_, ?_⟩, ?_⟩
    · intro x y h
      apply hΨinj
      exact congrArg Subtype.val h
    · rintro ⟨s, hs⟩
      obtain ⟨b, hb⟩ := hsurj hs
      exact ⟨b, Subtype.ext hb⟩
    · intro x
      apply Subtype.ext
      show Ψ (φ (τ x)) = _
      rw [hΨφ]
      rfl

  have n2 : ∀ (X X' : Scheme.{u}) [IsAffine X] (r : X' ⟶ X) (W : X'.Opens) (c : Γ(X, ⊤))
      (e : W ≤ r ⁻¹ᵁ ⊤), IsAffineOpen W → (r.appLE ⊤ W e).hom c ∈ nonZeroDivisors Γ(X', W) →
      r ⁻¹ᵁ X.basicOpen c ≤ W → IsIso (r ∣_ X.basicOpen c) →
      ∃ ψ : Γ(X', W) →+* Localization.Away c, Function.Injective ψ ∧
        ∀ x : Γ(X, ⊤), ψ ((r.appLE ⊤ W e).hom x) =
          algebraMap Γ(X, ⊤) (Localization.Away c) x := by
    intro X X' _ r W c e hW hnzd hOW hiso
    set D := X.basicOpen c with hD
    set D' := D.ι ''ᵁ ⊤ with hD'
    have hDD : D' = D := Scheme.Opens.ι_image_top D
    have hOW' : r ⁻¹ᵁ D' ≤ W := by rw [hDD]; exact hOW
    have hisoD : IsIso (r.app D') := by
      have h1 : IsIso ((r ∣_ D).app ⊤) := inferInstance
      rw [morphismRestrict_app] at h1
      exact @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (Functor.map_isIso _ _) h1
    have hbo : r ⁻¹ᵁ D' = X'.basicOpen ((r.appLE ⊤ W e).hom c) := by
      rw [Scheme.basicOpen_appLE, hDD]
      exact (inf_eq_right.mpr hOW).symm
    let ρ : Γ(X', W) →+* Γ(X', r ⁻¹ᵁ D') := (X'.presheaf.map (homOfLE hOW').op).hom
    have hρinj : Function.Injective ρ := by
      letI : Algebra Γ(X', W) Γ(X', r ⁻¹ᵁ D') := ρ.toAlgebra
      haveI : IsLocalization.Away ((r.appLE ⊤ W e).hom c) Γ(X', r ⁻¹ᵁ D') :=
        hW.isLocalization_of_eq_basicOpen _ (homOfLE hOW') hbo
      exact IsLocalization.injective (M := Submonoid.powers ((r.appLE ⊤ W e).hom c))
        Γ(X', r ⁻¹ᵁ D') (Submonoid.powers_le.mpr hnzd)
    let res : Γ(X, ⊤) →+* Γ(X, D') := (X.presheaf.map (homOfLE le_top : D' ⟶ ⊤).op).hom
    letI : Algebra Γ(X, ⊤) Γ(X, D') := res.toAlgebra
    haveI : IsLocalization.Away c Γ(X, D') :=
      (isAffineOpen_top X).isLocalization_of_eq_basicOpen c (homOfLE le_top) hDD
    let lam := IsLocalization.algEquiv (Submonoid.powers c) Γ(X, D') (Localization.Away c)
    let e1 := (asIso (r.app D')).commRingCatIsoToRingEquiv
    have he1 : ∀ y, e1 y = (r.app D').hom y := fun y => rfl
    have hcomm : ∀ x, ρ ((r.appLE ⊤ W e).hom x) = e1 (res x) := by
      intro x
      rw [he1]
      have : r.appLE ⊤ W e ≫ X'.presheaf.map (homOfLE hOW').op =
          X.presheaf.map (homOfLE le_top : D' ⟶ ⊤).op ≫ r.app D' := by
        rw [Scheme.Hom.appLE_map, Scheme.Hom.app_eq_appLE, Scheme.Hom.map_appLE]
      exact congrArg (fun h => h.hom x) this
    refine ⟨lam.toRingEquiv.toRingHom.comp (e1.symm.toRingHom.comp ρ), ?_, ?_⟩
    · exact lam.injective.comp (e1.symm.injective.comp hρinj)
    · intro x
      show lam (e1.symm (ρ _)) = _
      rw [hcomm, RingEquiv.symm_apply_apply]
      exact lam.commutes x

  haveI hUaff : IsAffine U.1.toScheme := U.2
  obtain ⟨PU, ιU, κ', -, hκoi, hκ, hrange, hblU, hidl, -⟩ :=
    wc_beq_affine_blowup_model k Y sY hsep I U r f hf.symm P π hbl
  haveI := hκoi
  have hJ := n6 U.1.toScheme (I.comap U.1.ι) _ hidl
  rw [hJ] at hblU
  obtain ⟨W, t, hc1, hc2, hc3, hc4, hc5, hc6⟩ := wc_bp_blowup_charts (wcBeqGU U f)
    (ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)) hblU
  have hrng : κ'.opensRange = π ⁻¹ᵁ (U : Y.Opens) := by
    apply TopologicalSpace.Opens.ext
    apply Set.ext
    intro x
    rw [Scheme.Hom.coe_opensRange]
    exact hrange x
  have hcov : (⨆ i, κ' ''ᵁ W i) = π ⁻¹ᵁ (U : Y.Opens) := by
    rw [← Scheme.Hom.image_iSup, hc1, Scheme.Hom.image_top_eq_opensRange, hrng]
  have hV : ∀ i, κ' ''ᵁ W i ≤ π ⁻¹ᵁ (U : Y.Opens) := fun i =>
    (κ'.image_le_opensRange (W i)).trans hrng.le
  have hle : ∀ a, (ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)) ⁻¹ᵁ
      (U.1.toScheme).basicOpen (wcBeqGU U f a) ≤ W a := by
    intro a x hx
    have hx' : x ∈ ⨆ l, W l := by rw [hc1]; trivial
    obtain ⟨k', hk⟩ := TopologicalSpace.Opens.mem_iSup.mp hx'
    have h1 : x ∈ PU.basicOpen (((ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY)
        (wcProjKStr k r)).appLE ⊤ (W k') (by simp)).hom (wcBeqGU U f a)) := by
      have e := Scheme.basicOpen_appLE (ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r))
        (W k') ⊤ (by simp) (wcBeqGU U f a)
      exact (congrArg (fun O : PU.Opens => x ∈ O) e).mpr ⟨hk, hx⟩
    rw [hc3 k' a, Scheme.basicOpen_mul] at h1
    exact hc6 k' a h1.1
  refine ⟨fun i => κ' ''ᵁ W i, hcov, fun i => ⟨hV i, (hc2 i).image_of_isOpenImmersion κ', ?_⟩⟩
  have hdisj : ((Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range (wcBeqGU U f)))).support
      : Set U.1.toScheme) ∩ ((U.1.toScheme).basicOpen (wcBeqGU U f i) : Set U.1.toScheme) = ∅ := by
    rw [Set.eq_empty_iff_forall_notMem]
    rintro x ⟨hx1, hx2⟩
    rw [Scheme.IdealSheafData.coe_support_ofIdealTop] at hx1
    exact (Scheme.mem_zeroLocus_iff _ _ x).mp hx1 (wcBeqGU U f i)
      (Ideal.subset_span ⟨i, rfl⟩) hx2
  have hiso := wc_csd_blowup_iso_off_center U.1.toScheme PU _
    (ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)) _ hblU hdisj
  obtain ⟨ψ, hψinj, hψ⟩ := n2 U.1.toScheme PU
    (ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)) (W i) (wcBeqGU U f i)
    (by simp) (hc2 i) (hc4 i) (hle i) hiso
  obtain ⟨e₀, he₀⟩ := n1 Γ(Y, U) Γ(U.1.toScheme, ⊤) Γ(PU, W i)
    (U.1.ι.appLE U.1 ⊤ (Scheme.Opens.ι_preimage_self U.1).ge).hom r f i
    ((ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)).appLE ⊤ (W i) (by simp)).hom
    (t i) ψ (n5 Y U.1) hψinj hψ (hc3 i) (hc5 i)
  have hκρ : κ' ≫ π = (ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)) ≫ U.1.ι :=
    hκ.trans (Category.assoc _ _ _).symm
  have hW : W i ≤ ((ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)) ≫ U.1.ι) ⁻¹ᵁ
      (U : Y.Opens) := by
    intro x _
    show U.1.ι ((ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)) x) ∈ U.1
    exact ((ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)) x).2
  have hρa : ∀ a : Γ(Y, U),
      (((ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)) ≫ U.1.ι).appLE
        (U : Y.Opens) (W i) hW).hom a =
      ((ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)).appLE ⊤ (W i) (by simp)).hom
        ((U.1.ι.appLE U.1 ⊤ (Scheme.Opens.ι_preimage_self U.1).ge).hom a) := by
    intro a
    have h := (Scheme.Hom.appLE_comp_appLE
      (ιU ≫ Limits.pullback.fst (U.1.ι ≫ sY) (wcProjKStr k r)) U.1.ι U.1 ⊤ (W i)
      (Scheme.Opens.ι_preimage_self U.1).ge (by simp)).symm
    exact congrArg (fun h => h.hom a) h
  refine ⟨(κ'.appIso (W i)).commRingCatIsoToRingEquiv.trans e₀, ?_⟩
  intro a
  show e₀ ((κ'.appIso (W i)).hom.hom ((π.appLE (U : Y.Opens) (κ' ''ᵁ W i) (hV i)).hom a)) = _
  rw [n4 PU P Y κ' π _ (U : Y.Opens) (W i) hκρ hW (hV i) a, hρa, he₀]

theorem wcpa_dj_rnb_integral_of_charts : ∀ (P Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (r : P ⟶ Y) (U₀ : Y.Opens), U₀ ≠ ⊥ → IsIso (r ∣_ U₀) → (∀ p : P, ∃ (V : P.Opens) (s : Γ(P, V)), p ∈ V ∧ IsAffineOpen V ∧ IsDomain Γ(P, V) ∧ s ≠ 0 ∧ P.basicOpen s ≤ r ⁻¹ᵁ U₀) → AlgebraicGeometry.IsIntegral P :=
by
  intro P Y _ r U₀ hU₀ hiso hloc
  classical
  have s2 : ∀ (V : P.Opens), IsAffineOpen V → IsDomain Γ(P, V) → IsIrreducible (V : Set P) := by
    intro V hV hdom
    have h1 := IrreducibleSpace.isIrreducible_univ (Spec Γ(P, V))
    have h2 := h1.image hV.fromSpec hV.fromSpec.continuous.continuousOn
    rwa [Set.image_univ, hV.range_fromSpec] at h2
  have s3 : ∀ (V : P.Opens) (s : Γ(P, V)), IsAffineOpen V → IsDomain Γ(P, V) → s ≠ 0 →
      ((P.basicOpen s : P.Opens) : Set P).Nonempty := by
    intro V s hV hdom hs
    let 𝔭 : PrimeSpectrum Γ(P, V) := ⟨⊥, Ideal.isPrime_bot⟩
    have hmem : 𝔭 ∈ hV.fromSpec ⁻¹ᵁ P.basicOpen s := by
      rw [hV.fromSpec_preimage_basicOpen]
      exact (PrimeSpectrum.mem_basicOpen s 𝔭).mpr (by simpa [𝔭] using hs)
    exact ⟨hV.fromSpec 𝔭, hmem⟩
  have s4 : ∀ (V : P.Opens) (p : P), p ∈ V → IsAffineOpen V → IsDomain Γ(P, V) →
      IsDomain (P.presheaf.stalk p) := by
    intro V p hp hV hdom
    letI : Algebra Γ(P, V) (P.presheaf.stalk p) :=
      TopCat.Presheaf.algebra_section_stalk P.presheaf ⟨p, hp⟩
    haveI := hV.isLocalization_stalk ⟨p, hp⟩
    exact IsLocalization.isDomain_of_le_nonZeroDivisors (P.presheaf.stalk p)
      (M := (hV.primeIdealOf ⟨p, hp⟩).asIdeal.primeCompl) (Ideal.primeCompl_le_nonZeroDivisors _)
  have s5 : IsIrreducible ((r ⁻¹ᵁ U₀ : P.Opens) : Set P) := by
    obtain ⟨u, hu⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U₀).mp hU₀
    haveI : Nonempty U₀ := ⟨⟨u, hu⟩⟩
    haveI : Nonempty (r ⁻¹ᵁ U₀).toScheme := ⟨(r ∣_ U₀).homeomorph.symm ⟨u, hu⟩⟩
    haveI : AlgebraicGeometry.IsIntegral (r ⁻¹ᵁ U₀).toScheme :=
      isIntegral_of_isOpenImmersion (r ∣_ U₀)
    have h1 := IrreducibleSpace.isIrreducible_univ (r ⁻¹ᵁ U₀).toScheme
    have h2 := h1.image (r ⁻¹ᵁ U₀).ι (r ⁻¹ᵁ U₀).ι.continuous.continuousOn
    rwa [Set.image_univ, Scheme.Opens.range_ι] at h2
  set O : Set P := ((r ⁻¹ᵁ U₀ : P.Opens) : Set P) with hO
  have hOo : IsOpen O := (r ⁻¹ᵁ U₀).isOpen
  have hall : ∀ p : P, p ∈ closure O := by
    intro p
    obtain ⟨V, s, hp, hV, hdom, hs, hle⟩ := hloc p
    obtain ⟨x, hx⟩ := s3 V s hV hdom hs
    by_contra hpc
    have hpre := (s2 V hV hdom).isPreirreducible
    obtain ⟨y, _, hyc, hyO⟩ := hpre (closure O)ᶜ O isClosed_closure.isOpen_compl hOo
      ⟨p, hp, hpc⟩ ⟨x, P.basicOpen_le s hx, hle hx⟩
    exact hyc (subset_closure hyO)
  have hcl : closure O = Set.univ := Set.eq_univ_of_forall hall
  have hirr : IsIrreducible (Set.univ : Set P) := hcl ▸ s5.closure
  haveI : IrreducibleSpace P := (irreducibleSpace_def P).mpr hirr
  haveI : ∀ x : P, _root_.IsReduced (P.presheaf.stalk x) := by
    intro x
    obtain ⟨V, s, hx, hV, hdom, -, -⟩ := hloc x
    haveI := s4 V x hx hV hdom
    infer_instance
  haveI := isReduced_of_isReduced_stalk P
  exact isIntegral_of_irreducibleSpace_of_isReduced P

theorem wcpa_dj_rnb_nonzero_generators : ∀ (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] [IsLocallyNoetherian Y] (I : Y.IdealSheafData) (U : Y.affineOpens), genericPoint Y ∉ (I.support : Set Y) → ((U : Y.Opens) : Set Y).Nonempty → ∃ (r : ℕ) (f : Fin (r + 1) → Γ(Y, U)), Ideal.span (Set.range f) = I.ideal U ∧ ∀ i, f i ≠ 0 :=
by
  intro Y _ _ I U hη hU
  classical
  haveI : IsNoetherianRing Γ(Y, U) := IsLocallyNoetherian.component_noetherian U
  obtain ⟨n, s, hs⟩ :=
    (Submodule.fg_iff_exists_fin_generating_family).mp (IsNoetherian.noetherian (I.ideal U))
  have hηU : genericPoint Y ∈ ((U : Y.Opens) : Set Y) := by
    rw [(genericPoint_spec Y).mem_open_set_iff (U : Y.Opens).isOpen]
    simpa using hU
  have hJ : I.ideal U ≠ ⊥ := by
    intro hJ
    apply hη
    have hz : genericPoint Y ∈ Y.zeroLocus (I.ideal U : Set Γ(Y, U)) := by
      rw [Scheme.mem_zeroLocus_iff]
      intro g hg
      rw [hJ] at hg
      have hg0 : g = 0 := (Submodule.mem_bot _).mp hg
      rw [hg0, Scheme.basicOpen_zero]
      simp
    have hmem : genericPoint Y ∈
        Y.zeroLocus (I.ideal U : Set Γ(Y, U)) ∩ ((U : Y.Opens) : Set Y) := ⟨hz, hηU⟩
    rw [← Scheme.IdealSheafData.coe_support_inter] at hmem
    exact hmem.1
  obtain ⟨a, haJ, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
  refine ⟨n, Fin.cons a (fun i => if s i = 0 then a else s i), ?_, ?_⟩
  · apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      induction i using Fin.cases with
      | zero => simpa using haJ
      | succ j =>
        simp only [Fin.cons_succ]
        split_ifs
        · exact haJ
        · rw [← hs]; exact Submodule.subset_span ⟨j, rfl⟩
    · rw [← hs, Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      by_cases h : s j = 0
      · rw [h]; exact zero_mem _
      · apply Ideal.subset_span
        exact ⟨j.succ, by simp [h]⟩
  · intro i
    induction i using Fin.cases with
    | zero => simpa using ha0
    | succ j =>
      simp only [Fin.cons_succ]
      split_ifs with h
      · exact ha0
      · exact h

theorem wcpa_dj_rnb_chart_domain : ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] (r : ℕ) (f : Fin (r + 1) → A) (i : Fin (r + 1)) (φ : A →+* B) (e : B ≃+* (Algebra.adjoin A (Set.range fun l => IsLocalization.mk' (Localization.Away (f i)) (f l) (⟨f i, Submonoid.mem_powers _⟩ : Submonoid.powers (f i))))), (∀ a, e (φ a) = algebraMap A _ a) → f i ≠ 0 → IsDomain B ∧ φ (f i) ≠ 0 :=
by
  intro A B _ _ _ r f i φ e he hfi
  haveI hL : IsDomain (Localization.Away (f i)) :=
    IsLocalization.Away.isDomain (Localization.Away (f i)) hfi
  haveI hS : IsDomain (Algebra.adjoin A (Set.range fun l => IsLocalization.mk'
      (Localization.Away (f i)) (f l)
      (⟨f i, Submonoid.mem_powers _⟩ : Submonoid.powers (f i)))) := inferInstance
  refine ⟨MulEquiv.isDomain _ e.toMulEquiv, ?_⟩
  intro h
  have h1 := he (f i)
  rw [h, map_zero] at h1
  have h2 := congrArg Subtype.val h1
  have h3 : (0 : Localization.Away (f i)) = algebraMap A (Localization.Away (f i)) (f i) := h2
  exact (IsLocalization.map_units (Localization.Away (f i))
    (⟨f i, Submonoid.mem_powers _⟩ : Submonoid.powers (f i))).ne_zero h3.symm

theorem wcpa_dj_rn_blowup : ∀ (k : Type u) [Field k] (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (sY : Y ⟶ Spec (.of k)) (I : Y.IdealSheafData), wcpaDjIsProjOver k sY → (I.support : Set Y) ≠ Set.univ → ∃ (Y' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y') (π : Y' ⟶ Y), IsProper π ∧ Surjective π ∧ wcpaDjIsProjOver k (π ≫ sY) ∧ IsIso (π ∣_ (⟨(I.support : Set Y)ᶜ, I.support.isClosed.isOpen_compl⟩ : Y.Opens)) ∧ ∀ (U : Y.affineOpens) (r : ℕ) (f : Fin (r + 1) → Γ(Y, U)), Ideal.span (Set.range f) = I.ideal U → (∀ i, f i ≠ 0) → ∃ V : Fin (r + 1) → Y'.Opens, (⨆ i, V i) = π ⁻¹ᵁ (U : Y.Opens) ∧ ∀ i, ∃ hV : V i ≤ π ⁻¹ᵁ (U : Y.Opens), IsAffineOpen (V i) ∧ ∃ e : Γ(Y', V i) ≃+* (Algebra.adjoin Γ(Y, U) (Set.range fun l => IsLocalization.mk' (Localization.Away (f i)) (f l) (⟨f i, Submonoid.mem_powers _⟩ : Submonoid.powers (f i)))), ∀ a : Γ(Y, U), e ((π.appLE (U : Y.Opens) (V i) hV).hom a) = algebraMap Γ(Y, U) _ a :=
by
  intro k _ Y _ sY I hproj hsupp
  classical
  haveI hsYp : IsProper sY := wcpa_dj_proj_proper k sY hproj
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY

  have hproj' := hproj
  obtain ⟨N, j, hj, -⟩ := hproj'
  haveI := hj
  obtain ⟨m, g, w, hgen, hunit, hcoc⟩ := wc_csd_blowup_chart_generators k N Y j I hj
  have hUa : ∀ J, IsAffineOpen (j ⁻¹ᵁ wcSgD k N J) := fun J =>
    IsAffineOpen.preimage (Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k J))
      one_pos) j
  have hcover : (⨆ J, j ⁻¹ᵁ wcSgD k N J) = ⊤ := by
    have h0 : (⨆ J, wcSgD k N J) = ⊤ := wc_pp_basicOpen_cover k N
    rw [← Scheme.Hom.preimage_iSup, h0, Scheme.Hom.preimage_top]
  obtain ⟨P, r, ιb, hιb, hιbr, hbl⟩ := wc_csd_blowup_model k Y sY I N m
    (fun J => j ⁻¹ᵁ wcSgD k N J) hUa g w hcover (fun J => hgen J (hUa J)) hunit hcoc
  haveI := hιb

  haveI := wc_proj_space_isProper k m
  haveI hrp : IsProper r := by rw [← hιbr]; infer_instance

  set U₀ : Y.Opens := ⟨(I.support : Set Y)ᶜ, I.support.isClosed.isOpen_compl⟩ with hU₀def
  have hη : genericPoint Y ∉ (I.support : Set Y) := by
    intro h
    apply hsupp
    apply Set.eq_univ_of_forall
    intro y
    exact ((genericPoint_spec Y).specializes (Set.mem_univ y)).mem_closed I.support.isClosed h
  have hηU : genericPoint Y ∈ (U₀ : Set Y) := hη
  have hU₀ : U₀ ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨_, hηU⟩
  haveI hiso : IsIso (r ∣_ U₀) :=
    wc_csd_blowup_iso_off_center Y P I r U₀ hbl (Set.inter_compl_self _)

  have hcharts := wcpa_dj_rnb_blowup_charts k Y P sY I r inferInstance hbl

  have hloc : ∀ p : P, ∃ (V : P.Opens) (s : Γ(P, V)), p ∈ V ∧ IsAffineOpen V ∧
      IsDomain Γ(P, V) ∧ s ≠ 0 ∧ P.basicOpen s ≤ r ⁻¹ᵁ U₀ := by
    intro p
    obtain ⟨W, hW, hpW, -⟩ := exists_isAffineOpen_mem_and_subset
      (show r p ∈ (⊤ : Y.Opens) from trivial)
    let U : Y.affineOpens := ⟨W, hW⟩
    obtain ⟨n, f, hspan, hf0⟩ := wcpa_dj_rnb_nonzero_generators Y I U hη ⟨r p, hpW⟩
    obtain ⟨V, hVsup, hVi⟩ := hcharts U n f hspan
    have hpV : p ∈ r ⁻¹ᵁ (U : Y.Opens) := hpW
    rw [← hVsup] at hpV
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hpV
    obtain ⟨hV, hVaff, e, he⟩ := hVi a
    haveI : Nonempty (U : Y.Opens) := ⟨⟨r p, hpW⟩⟩
    haveI := IsIntegral.component_integral (X := Y) (U : Y.Opens)
    obtain ⟨hdom, hs0⟩ := wcpa_dj_rnb_chart_domain Γ(Y, U) Γ(P, V a) n f a
      (r.appLE (U : Y.Opens) (V a) hV).hom e he (hf0 a)
    refine ⟨V a, (r.appLE (U : Y.Opens) (V a) hV).hom (f a), ha, hVaff, hdom, hs0, ?_⟩
    rw [Scheme.basicOpen_appLE]
    intro x hx
    have hx2 : r x ∈ Y.basicOpen (f a) := hx.2
    show r x ∈ (U₀ : Set Y)
    intro hsx
    have hxU : r x ∈ ((U : Y.Opens) : Set Y) := Y.basicOpen_le (f a) hx2
    have hmem : r x ∈ (I.support : Set Y) ∩ ((U : Y.Opens) : Set Y) := ⟨hsx, hxU⟩
    rw [Scheme.IdealSheafData.coe_support_inter] at hmem
    have hfa : f a ∈ (I.ideal U : Set Γ(Y, U)) := by
      rw [← hspan]; exact Ideal.subset_span ⟨a, rfl⟩
    exact (Scheme.mem_zeroLocus_iff Y _ (r x)).mp hmem.1 (f a) hfa hx2
  haveI hPint : AlgebraicGeometry.IsIntegral P :=
    wcpa_dj_rnb_integral_of_charts P Y r U₀ hU₀ hiso hloc

  have hsub : (U₀ : Set Y) ⊆ Set.range ⇑r := by
    intro u hu
    obtain ⟨w', hw'⟩ := (r ∣_ U₀).surjective ⟨u, hu⟩
    have hw1 : r w'.1 = u := by
      have := congrArg Subtype.val hw'
      rw [morphismRestrict_base_coe] at this
      exact this
    exact ⟨w'.1, hw1⟩
  have hsurj : Surjective r := by
    have hcl : IsClosed (Set.range ⇑r) := r.isClosedMap.isClosed_range
    have hd : Dense (U₀ : Set Y) := U₀.isOpen.dense ⟨_, hηU⟩
    have hc : closure (U₀ : Set Y) ⊆ Set.range ⇑r := hcl.closure_subset_iff.mpr hsub
    rw [hd.closure_eq] at hc
    exact ⟨fun x => hc (Set.mem_univ x)⟩

  have hPk : wcpaDjIsProjOver k (wcProjKStr k m ≫ 𝟙 (Spec (.of k))) := by
    unfold wcpaDjIsProjOver
    exact ⟨m, 𝟙 _, inferInstance, by rw [Category.id_comp, Category.comp_id]⟩
  have hP8 := wcpa_dj_ssm_proj_fibre_product k Y (Spec (.of k)) (wcProjK k m) P (𝟙 _) sY
    (wcProjKStr k m) ιb inferInstance (by rwa [Category.comp_id]) hPk hιb
  have heq : ιb ≫ Limits.pullback.snd sY (wcProjKStr k m) ≫ wcProjKStr k m ≫
      𝟙 (Spec (.of k)) = r ≫ sY := by
    rw [Category.comp_id, ← Limits.pullback.condition, ← hιbr]
    simp only [Category.assoc]
  rw [heq] at hP8
  exact ⟨P, hPint, r, hrp, hsurj, hP8, hiso, fun U n f hspan _ => hcharts U n f hspan⟩

theorem wcpa_dj_rtsx_pt_basic : ∀ (Z : Scheme.{u}) [IsLocallyNoetherian Z] (B : Set Z) (z : Z), (wcpaDjTorPt Z B z → IsRegularLocalRing (Z.presheaf.stalk z)) ∧ (wcpaDjTorNodeSgl Z B z → z ∈ B) :=
by
  classical

  have hA : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P] (n : ℕ)
      (s : Fin n → AdicCompletion (IsLocalRing.maximalIdeal P) P),
      (n : WithBot ℕ∞) = ringKrullDim P →
      Ideal.span (Set.range s) = (IsLocalRing.maximalIdeal P).map
        (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) →
      IsRegularLocalRing P := by
    intro P _ _ _ n s hn hspan
    let φ : AdicCompletion (IsLocalRing.maximalIdeal P) P →+* P ⧸ IsLocalRing.maximalIdeal P ^ 2 :=
      (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal P) 2).toRingHom
    let mk : P →+* P ⧸ IsLocalRing.maximalIdeal P ^ 2 :=
      Ideal.Quotient.mk (IsLocalRing.maximalIdeal P ^ 2)
    have hφι : φ.comp (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) = mk := by
      ext p
      show (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal P) 2)
        (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p) = _
      rw [AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
    choose t ht using fun j =>
      Ideal.Quotient.mk_surjective (I := IsLocalRing.maximalIdeal P ^ 2) (φ (s j))
    have hmk : Function.Surjective mk := Ideal.Quotient.mk_surjective
    have hmap : (Ideal.span (Set.range t)).map mk = (IsLocalRing.maximalIdeal P).map mk := by
      rw [Ideal.map_span, ← Set.range_comp]
      have e1 : (⇑mk ∘ t) = ⇑φ ∘ s := funext ht
      rw [e1, Set.range_comp, ← Ideal.map_span, hspan, Ideal.map_map, hφι]
    have hcm : ∀ I : Ideal P, (I.map mk).comap mk = I ⊔ IsLocalRing.maximalIdeal P ^ 2 := by
      intro I
      rw [Ideal.comap_map_of_surjective' mk hmk]
      show I ⊔ RingHom.ker (Ideal.Quotient.mk (IsLocalRing.maximalIdeal P ^ 2)) = _
      rw [Ideal.mk_ker]
    have hm2 : IsLocalRing.maximalIdeal P ^ 2 ≤ IsLocalRing.maximalIdeal P :=
      Ideal.pow_le_self two_ne_zero
    have hle : Ideal.span (Set.range t) ≤ IsLocalRing.maximalIdeal P := by
      calc Ideal.span (Set.range t) ≤ ((Ideal.span (Set.range t)).map mk).comap mk :=
            Ideal.le_comap_map
        _ = IsLocalRing.maximalIdeal P := by rw [hmap, hcm, sup_eq_left.mpr hm2]
    have hge : IsLocalRing.maximalIdeal P ≤
        Ideal.span (Set.range t) ⊔ IsLocalRing.maximalIdeal P • IsLocalRing.maximalIdeal P := by
      have : IsLocalRing.maximalIdeal P ≤ ((IsLocalRing.maximalIdeal P).map mk).comap mk :=
        Ideal.le_comap_map
      rw [← hmap, hcm, pow_two] at this
      rw [Ideal.smul_eq_mul]
      exact this
    have hFG : (IsLocalRing.maximalIdeal P).FG := IsNoetherian.noetherian _
    have hnak : IsLocalRing.maximalIdeal P ≤ Ideal.span (Set.range t) :=
      Submodule.le_of_le_smul_of_le_jacobson_bot hFG (IsLocalRing.maximalIdeal_le_jacobson _) hge
    have heq : IsLocalRing.maximalIdeal P = Ideal.span (Set.range t) := le_antisymm hnak hle
    apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
    rw [← hn, heq]
    have h1 : (Submodule.span P (Set.range t)).spanFinrank ≤ (Set.range t).ncard :=
      Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range t)
    have h2 : (Set.range t).ncard ≤ n := by
      rw [← Set.image_univ]
      calc (t '' Set.univ).ncard ≤ (Set.univ : Set (Fin n)).ncard :=
            Set.ncard_image_le Set.finite_univ
        _ = n := by rw [Set.ncard_univ, Nat.card_fin]
    exact_mod_cast h1.trans h2

  have hB : ∀ (P : Type u) [CommRing P] [IsLocalRing P] (A : Type u) [CommRing A] [IsLocalRing A]
      (n q : ℕ) (x y v : A) (σ : Fin n → A) (b : Fin n → ℕ)
      (e : AdicCompletion (IsLocalRing.maximalIdeal P) P ≃+*
        (A ⧸ Ideal.span {x * y - v * ∏ l, σ l ^ b l}))
      (h : Fin q → P) (J : Fin q → Finset (Fin n)), IsUnit v →
      Ideal.span ({x, y} ∪ Set.range σ) = IsLocalRing.maximalIdeal A →
      (∀ l, b l ≠ 0 → ∃ i, l ∈ J i) →
      (∀ i, Associated (e (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) (h i)))
        (Ideal.Quotient.mk _ (∏ l ∈ J i, σ l))) →
      ∃ i, h i ∈ IsLocalRing.maximalIdeal P := by
    intro P _ _ A _ _ n q x y v σ b e h J hv hmax hcov hass
    have hÔ : Nontrivial (AdicCompletion (IsLocalRing.maximalIdeal P) P) := by
      have : Nontrivial (P ⧸ IsLocalRing.maximalIdeal P ^ 1) := by
        rw [pow_one]
        exact Ideal.Quotient.nontrivial_iff.mpr (IsLocalRing.maximalIdeal.isMaximal P).ne_top
      exact (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal P) 1).toRingHom.domain_nontrivial
    have hQ : Nontrivial (A ⧸ Ideal.span {x * y - v * ∏ l, σ l ^ b l}) := e.injective.nontrivial
    have hIne : Ideal.span {x * y - v * ∏ l, σ l ^ b l} ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp hQ
    have hFm : x * y - v * ∏ l, σ l ^ b l ∈ IsLocalRing.maximalIdeal A :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr
        (fun hu => hIne (Ideal.span_singleton_eq_top.mpr hu)))
    have hx : x ∈ IsLocalRing.maximalIdeal A := by
      rw [← hmax]
      exact Ideal.subset_span (Set.mem_union_left _ (Set.mem_insert x _))
    have hσ : ∀ l, σ l ∈ IsLocalRing.maximalIdeal A := by
      intro l
      rw [← hmax]
      exact Ideal.subset_span (Set.mem_union_right _ ⟨l, rfl⟩)
    have hb : ∃ l, b l ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      have hprod : ∏ l, σ l ^ b l = 1 := Finset.prod_eq_one (fun l _ => by rw [hcon l, pow_zero])
      have hvm : v ∈ IsLocalRing.maximalIdeal A := by
        have e1 : v = x * y - (x * y - v * ∏ l, σ l ^ b l) := by rw [hprod]; ring
        rw [e1]
        exact sub_mem (Ideal.mul_mem_right _ _ hx) hFm
      exact (IsLocalRing.mem_maximalIdeal v).mp hvm hv
    obtain ⟨l₀, hl₀⟩ := hb
    obtain ⟨i, hi⟩ := hcov l₀ hl₀
    have hprodm : ∏ l ∈ J i, σ l ∈ IsLocalRing.maximalIdeal A :=
      Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem σ hi) (hσ l₀)
    have hIle : Ideal.span {x * y - v * ∏ l, σ l ^ b l} ≤ IsLocalRing.maximalIdeal A :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hFm)
    have hnu : ¬ IsUnit (Ideal.Quotient.mk (Ideal.span {x * y - v * ∏ l, σ l ^ b l})
        (∏ l ∈ J i, σ l)) := by
      intro hu
      obtain ⟨u, hu⟩ := hu.exists_right_inv
      obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective u
      have h1 : (∏ l ∈ J i, σ l) * c - 1 ∈ Ideal.span {x * y - v * ∏ l, σ l ^ b l} := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [map_sub, map_mul, hu, map_one, sub_self]
      have h2 : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
        have h3 := sub_mem (Ideal.mul_mem_right c _ hprodm) (hIle h1)
        simpa using h3
      exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
    refine ⟨i, ?_⟩
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    apply hnu
    exact (hass i).isUnit_iff.mp ((hu.map (algebraMap P _)).map e)

  intro Z _ B z
  refine ⟨?_, ?_⟩
  · rintro ⟨n, q, s, h, J, hn, hspan, -, -, -⟩
    exact hA (Z.presheaf.stalk z) n s hn hspan
  · rintro ⟨n, q, A, _, _, _, x, y, v, σ, b, e, h, J, hv, -, hmax, -, -, hcov, hass, hBz⟩
    obtain ⟨i, hi⟩ := hB (Z.presheaf.stalk z) A n q x y v σ b e h J hv hmax hcov hass
    refine (hBz z (specializes_refl z)).mpr ⟨i, ?_⟩
    rw [TopCat.Presheaf.stalkSpecializes_refl]
    simpa using hi

theorem wcpa_dj_rss_poly_field_regular : ∀ (k : Type u) [Field k] (n : ℕ) (Q : Ideal (MvPolynomial (Fin n) k)) [Q.IsPrime], IsRegularLocalRing (Localization.AtPrime Q) :=
by
  intro k _ n Q _

  have TRANS : PLift (∀ (S : Type u) [CommRing S] (S' : Type u) [CommRing S'], (S ≃+* S') → (∀ (𝔔 : Ideal (S)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (S')) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    intro S _ S' _ e hS 𝔔 _
    have : (𝔔.comap (e : S →+* S')).IsPrime := Ideal.comap_isPrime _ _
    have h := hS (𝔔.comap (e : S →+* S'))
    have H : (𝔔.comap (e : S →+* S')).primeCompl.map e.toMonoidHom = 𝔔.primeCompl := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · intro hx
        refine ⟨e.symm x, ?_, ?_⟩
        · change e (e.symm x) ∉ 𝔔
          simpa using hx
        · simp
    exact IsRegularLocalRing.of_ringEquiv (IsLocalization.ringEquivOfRingEquiv
      (Localization.AtPrime (𝔔.comap (e : S →+* S'))) (Localization.AtPrime 𝔔) e H)⟩

  have FF : PLift (∀ (A : Type u) [CommRing A] [IsLocalRing A], IsField A → IsRegularLocalRing A) := ⟨by
    intro A _ _ hA
    have hm : IsLocalRing.maximalIdeal A = ⊥ := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hA
    have : IsNoetherianRing A := by
      letI := hA.toField
      infer_instance
    exact ⟨by simp [hm, ringKrullDim_eq_zero_of_isField hA]⟩⟩

  have PFR : PLift (∀ (κ : Type u) [Field κ], (∀ (𝔔 : Ideal (Polynomial κ)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    intro κ _ 𝔔 _
    have : IsNoetherianRing (Localization.AtPrime 𝔔) :=
      IsLocalization.isNoetherianRing 𝔔.primeCompl (Localization.AtPrime 𝔔) inferInstance
    by_cases h : 𝔔 = ⊥
    · subst h
      apply FF.down
      rw [IsLocalRing.isField_iff_maximalIdeal_eq, ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_bot]
    · have := IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (Polynomial κ) h
        (Localization.AtPrime 𝔔)
      obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (Localization.AtPrime 𝔔)
      refine ⟨?_⟩
      rw [hϖ.maximalIdeal_eq, IsDiscreteValuationRing.ringKrullDim_eq_one]
      rw [show Ideal.span {ϖ} = (Localization.AtPrime 𝔔) ∙ ϖ from rfl,
        Submodule.spanFinrank_singleton hϖ.ne_zero]
      rfl⟩

  have FIBRE0 := PLift.up (wc_fgu_flat_fibre_ascent wc_hnas_pfc_regular_flat_ascent)

  have MVPOLY0 : PLift (∀ (n : ℕ) (D : Type u) [CommRing D] [IsNoetherianRing D], (∀ (𝔔 : Ideal (D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (MvPolynomial (Fin n) D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔))) := ⟨by
    have POLY0 : ∀ (D : Type u) [CommRing D] [IsNoetherianRing D], (∀ (𝔔 : Ideal (D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) → (∀ (𝔔 : Ideal (Polynomial D)) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) := by
      intro D _ _ hD
      refine FIBRE0.down D (Polynomial D) hD ?_
      intro 𝔮 _
      exact TRANS.down _ _ (polyEquivTensor' D 𝔮.ResidueField).toRingEquiv (PFR.down _)
    intro n
    induction n with
    | zero =>
      intro D _ _ hD
      exact TRANS.down _ _ (MvPolynomial.isEmptyRingEquiv D (Fin 0)).symm hD
    | succ n ih =>
      intro D _ _ hD
      exact TRANS.down _ _ (MvPolynomial.finSuccEquiv D n).symm.toRingEquiv (POLY0 _ (ih D hD))⟩

  have REGk : ∀ (𝔔 : Ideal k) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔) := by
    intro 𝔔 _
    have h : 𝔔 = ⊥ := Ideal.eq_bot_of_prime 𝔔
    subst h
    apply FF.down
    rw [IsLocalRing.isField_iff_maximalIdeal_eq, ← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_bot]

  exact MVPOLY0.down n k REGk Q

theorem wcpa_dj_rss_quot_localization : ∀ (R A : Type u) [CommRing R] [CommRing A] (π : R →+* A), Function.Surjective π → ∀ (p : Ideal A) [p.IsPrime], Nonempty ((Localization.AtPrime (p.comap π) ⧸ Ideal.map (algebraMap R (Localization.AtPrime (p.comap π))) (RingHom.ker π)) ≃+* Localization.AtPrime p) :=
by
  intro R A _ _ π hπ p _
  classical
  let L : Localization.AtPrime (p.comap π) →+* Localization.AtPrime p :=
    Localization.localRingHom (p.comap π) p π rfl
  have hle : Ideal.map (algebraMap R (Localization.AtPrime (p.comap π))) (RingHom.ker π) ≤
      RingHom.ker L := by
    rw [Ideal.map_le_iff_le_comap]
    intro y hy
    rw [Ideal.mem_comap, RingHom.mem_ker]
    rw [RingHom.mem_ker] at hy
    simp only [L, Localization.localRingHom_to_map, hy, map_zero]
  have hL : ∀ x ∈ Ideal.map (algebraMap R (Localization.AtPrime (p.comap π))) (RingHom.ker π),
      L x = 0 := fun x hx => hle hx
  let Φ := Ideal.Quotient.lift _ L hL
  have hsurj : Function.Surjective Φ := by
    apply Ideal.Quotient.lift_surjective_of_surjective
    intro z
    obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl z
    obtain ⟨r, hr⟩ := hπ a
    obtain ⟨t, ht⟩ := hπ (s : A)
    have htQ : t ∈ (p.comap π).primeCompl := by
      show t ∉ p.comap π
      rw [Ideal.mem_comap, ht]; exact s.2
    refine ⟨IsLocalization.mk' (Localization.AtPrime (p.comap π)) r ⟨t, htQ⟩, ?_⟩
    simp only [L, Localization.localRingHom_mk']
    subst hr
    congr 1
    exact Subtype.ext ht
  have hinj : Function.Injective Φ := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective w
    have hw' : L x = 0 := hw
    obtain ⟨⟨r, t⟩, rfl⟩ := IsLocalization.mk'_surjective (p.comap π).primeCompl x
    simp only [L, Localization.localRingHom_mk'] at hw'
    rw [IsLocalization.mk'_eq_zero_iff] at hw'
    obtain ⟨m, hm⟩ := hw'
    obtain ⟨u, hu⟩ := hπ (m : A)
    have huQ : u ∈ (p.comap π).primeCompl := by
      show u ∉ p.comap π
      rw [Ideal.mem_comap, hu]; exact m.2
    have hur : r * u ∈ RingHom.ker π := by
      rw [RingHom.mem_ker, map_mul, hu, mul_comm]; exact hm
    rw [Ideal.Quotient.eq_zero_iff_mem]
    show IsLocalization.mk' (Localization.AtPrime (p.comap π)) r t ∈ _
    rw [← IsLocalization.mk'_cancel (M := (p.comap π).primeCompl) r t ⟨u, huQ⟩,
      IsLocalization.mk'_eq_mul_mk'_one]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hur)
  exact ⟨RingEquiv.ofBijective Φ ⟨hinj, hsurj⟩⟩

theorem wcpa_dj_rss_left_inverse_minor : ∀ (K : Type u) [Field K] (h S : ℕ) (M : Matrix (Fin S) (Fin h) K) (Λ : Matrix (Fin h) (Fin S) K), Λ * M = 1 → ∃ τ : Fin h → Fin S, (M.submatrix τ id).det ≠ 0 :=
by
  intro K _ h S M Λ hΛ
  classical
  set W : Submodule K (Fin h → K) := Submodule.span K (Set.range M) with hWdef
  have hWtop : W = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro v
    have hv : v = Matrix.vecMul (Matrix.vecMul v Λ) M := by
      rw [Matrix.vecMul_vecMul, hΛ, Matrix.vecMul_one]
    rw [hv, Matrix.vecMul_eq_sum]
    exact Submodule.sum_mem _ (fun s _ =>
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨s, rfl⟩))
  have hW : Module.finrank K W = h := by
    rw [hWtop, finrank_top, Module.finrank_fin_fun]
  obtain ⟨f, hf, -, hli⟩ := Submodule.exists_fun_fin_finrank_span_eq K (Set.range M)
  choose σ hσ using hf
  refine ⟨fun j => σ (Fin.cast hW.symm j), ?_⟩
  have hrows : LinearIndependent K (M.submatrix (fun j => σ (Fin.cast hW.symm j)) id).row := by
    have h1 : (M.submatrix (fun j => σ (Fin.cast hW.symm j)) id).row = f ∘ Fin.cast hW.symm := by
      funext j c
      simp [Matrix.row, Matrix.submatrix, hσ]
    rw [h1]
    exact hli.comp _ (Fin.cast_injective _)
  have hu := Matrix.linearIndependent_rows_iff_isUnit.mp hrows
  exact ((Matrix.isUnit_iff_isUnit_det _).mp hu).ne_zero

theorem wcpa_dj_rss_coeff_section : ∀ (k : Type u) [Field k] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra k B], ∃ σ : IsLocalRing.ResidueField B →+* B ⧸ IsLocalRing.maximalIdeal B ^ 2, ∀ b : B, σ (IsLocalRing.residue B b) - Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) b ∈ Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2)) (IsLocalRing.maximalIdeal B) :=
by
  intro k _ B _ _ _ _
  classical

  have s1 : ∀ (K : Type u) [Field K] [CharZero K], Algebra.FormallySmooth ℚ K := by
    intro K _ _
    obtain ⟨s, hs⟩ := exists_isTranscendenceBasis ℚ K
    let L := IntermediateField.adjoin ℚ (Set.range (Subtype.val : s → K))
    haveI : Algebra.IsAlgebraic L K := hs.isAlgebraic_field
    haveI : Algebra.IsSeparable L K := Algebra.IsAlgebraic.isSeparable_of_perfectField
    haveI : Algebra.FormallyEtale L K := Algebra.FormallyEtale.of_isSeparable L K
    let v : s → L := fun i => ⟨i.1, IntermediateField.subset_adjoin _ _ ⟨i, rfl⟩⟩
    have hv : AlgebraicIndependent ℚ v := by
      apply AlgebraicIndependent.of_comp L.val
      exact hs.1
    have hvtop : IntermediateField.adjoin ℚ (Set.range v) = ⊤ := by
      apply IntermediateField.lift_injective L
      rw [IntermediateField.lift_adjoin, IntermediateField.lift_top, ← Set.range_comp]
      rfl
    haveI : Algebra.FormallySmooth ℚ L := Algebra.FormallySmooth.of_algebraicIndependent hv hvtop
    exact Algebra.FormallySmooth.comp ℚ L K

  have s2 : ∀ (R : Type) [CommRing R] (D : Type u) [CommRing D] [Algebra R D] (K : Type u)
      [Field K] [Algebra R K] [Algebra.FormallySmooth R K] (g : D →ₐ[R] K),
      Function.Surjective g → (∀ x y : D, g x = 0 → g y = 0 → x * y = 0) →
      ∃ σ : K →ₐ[R] D, ∀ x, g (σ x) = x := by
    intro R _ D _ _ K _ _ _ g hg hsq
    have hnil : IsNilpotent (RingHom.ker (g : D →+* K)) := by
      refine ⟨2, ?_⟩
      rw [pow_two, Ideal.zero_eq_bot, eq_bot_iff]
      refine Ideal.mul_le.mpr fun x hx y hy => ?_
      rw [RingHom.mem_ker] at hx hy
      rw [Ideal.mem_bot]
      exact hsq x y hx hy
    exact ⟨Algebra.FormallySmooth.liftOfSurjective (AlgHom.id R K) g hg hnil,
      fun x => Algebra.FormallySmooth.liftOfSurjective_apply _ _ _ _ x⟩

  have H : ∀ a ∈ IsLocalRing.maximalIdeal B ^ 2, IsLocalRing.residue B a = 0 := fun a ha =>
    (IsLocalRing.residue_eq_zero_iff a).mpr (Ideal.pow_le_self two_ne_zero ha)
  let g : B ⧸ IsLocalRing.maximalIdeal B ^ 2 →+* IsLocalRing.ResidueField B :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal B ^ 2) (IsLocalRing.residue B) H
  have hgs : Function.Surjective g :=
    Ideal.Quotient.lift_surjective_of_surjective _ H IsLocalRing.residue_surjective
  have hgmk : ∀ b, g (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) b) =
      IsLocalRing.residue B b := fun b => Ideal.Quotient.lift_mk _ _ _
  have hker : ∀ d, g d = 0 → d ∈ Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2))
      (IsLocalRing.maximalIdeal B) := by
    intro d hd
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective d
    rw [hgmk, IsLocalRing.residue_eq_zero_iff] at hd
    exact Ideal.mem_map_of_mem _ hd
  have hsq : ∀ x y, g x = 0 → g y = 0 → x * y = 0 := by
    intro x y hx hy
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [hgmk, IsLocalRing.residue_eq_zero_iff] at hx hy
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, pow_two]
    exact Ideal.mul_mem_mul hx hy

  have hsec : ∃ σ : IsLocalRing.ResidueField B →+* B ⧸ IsLocalRing.maximalIdeal B ^ 2,
      ∀ x, g (σ x) = x := by
    haveI hnt : Nontrivial (B ⧸ IsLocalRing.maximalIdeal B ^ 2) :=
      Ideal.Quotient.nontrivial_iff.mpr (ne_top_of_le_ne_top
        (IsLocalRing.maximalIdeal.isMaximal B).ne_top (Ideal.pow_le_self two_ne_zero))
    let ιD : k →+* B ⧸ IsLocalRing.maximalIdeal B ^ 2 :=
      (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2)).comp (algebraMap k B)
    let ικ : k →+* IsLocalRing.ResidueField B := (IsLocalRing.residue B).comp (algebraMap k B)
    have hιD : Function.Injective ιD := ιD.injective
    have hικ : Function.Injective ικ := ικ.injective
    rcases CharP.char_is_prime_or_zero k (ringChar k) with hp | hp
    · haveI : Fact (ringChar k).Prime := ⟨hp⟩
      haveI : CharP (B ⧸ IsLocalRing.maximalIdeal B ^ 2) (ringChar k) :=
        charP_of_injective_ringHom hιD _
      haveI : CharP (IsLocalRing.ResidueField B) (ringChar k) :=
        charP_of_injective_ringHom hικ _
      letI := ZMod.algebra (B ⧸ IsLocalRing.maximalIdeal B ^ 2) (ringChar k)
      letI := ZMod.algebra (IsLocalRing.ResidueField B) (ringChar k)
      haveI := wc_pfc_p_field_formally_smooth (ringChar k) (IsLocalRing.ResidueField B)
      have hc : ∀ r : ZMod (ringChar k), g (algebraMap (ZMod (ringChar k)) _ r) =
          algebraMap (ZMod (ringChar k)) (IsLocalRing.ResidueField B) r := fun r =>
        RingHom.congr_fun (RingHom.ext_zmod (g.comp (algebraMap _ _)) (algebraMap _ _)) r
      let gA : (B ⧸ IsLocalRing.maximalIdeal B ^ 2) →ₐ[ZMod (ringChar k)]
          IsLocalRing.ResidueField B := AlgHom.mk g hc
      obtain ⟨σA, hσA⟩ := s2 (ZMod (ringChar k)) _ _ gA hgs hsq
      exact ⟨σA.toRingHom, hσA⟩
    · haveI : CharZero k := (CharP.charP_zero_iff_charZero k).mp (ringChar.of_eq hp)
      haveI : CharZero (IsLocalRing.ResidueField B) := charZero_of_injective_ringHom hικ
      letI : Algebra ℚ (B ⧸ IsLocalRing.maximalIdeal B ^ 2) := (ιD.comp (Rat.castHom k)).toAlgebra
      haveI := s1 (IsLocalRing.ResidueField B)
      obtain ⟨σA, hσA⟩ := s2 ℚ _ _ (RingHom.toRatAlgHom g) hgs hsq
      exact ⟨σA.toRingHom, hσA⟩
  obtain ⟨σ, hσ⟩ := hsec
  refine ⟨σ, fun b => hker _ ?_⟩
  rw [map_sub, hσ, hgmk, sub_self]

theorem wcpa_dj_rss_dual_derivations : (∀ (k : Type u) [Field k] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra k B], ∃ σ : IsLocalRing.ResidueField B →+* B ⧸ IsLocalRing.maximalIdeal B ^ 2, ∀ b : B, σ (IsLocalRing.residue B b) - Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) b ∈ Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2)) (IsLocalRing.maximalIdeal B)) → ∀ (k : Type u) [Field k] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra k B] (h : ℕ) (x : Fin h → IsLocalRing.maximalIdeal B), LinearIndependent (IsLocalRing.ResidueField B) (fun i => (IsLocalRing.maximalIdeal B).toCotangent (x i)) → ∃ δ : Fin h → Derivation ℤ B (IsLocalRing.ResidueField B), ∀ i j, δ j (x i) = if i = j then 1 else 0 :=
by
  intro H k _ B _ _ _ _ h x hli
  obtain ⟨σ, hσ⟩ := H k B

  have hder : ∀ f : IsLocalRing.CotangentSpace B →ₗ[IsLocalRing.ResidueField B]
      IsLocalRing.ResidueField B, ∃ δ : Derivation ℤ B (IsLocalRing.ResidueField B),
      ∀ (y : B) (hy : y ∈ IsLocalRing.maximalIdeal B),
        δ y = f ((IsLocalRing.maximalIdeal B).toCotangent ⟨y, hy⟩) := by
    intro f
    have hlift : ∀ b : B, ∃ y ∈ IsLocalRing.maximalIdeal B,
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) y =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) b - σ (IsLocalRing.residue B b) := by
      intro b
      have h := neg_mem (hσ b)
      rw [neg_sub] at h
      exact (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp h
    choose xb hxm hxq using hlift
    obtain ⟨δ₀, hδ₀⟩ : ∃ δ₀ : B → IsLocalRing.ResidueField B, ∀ b,
        δ₀ b = f ((IsLocalRing.maximalIdeal B).toCotangent ⟨xb b, hxm b⟩) := ⟨_, fun _ => rfl⟩
    have hC : ∀ (b y : B) (hy : y ∈ IsLocalRing.maximalIdeal B),
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) y =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) b - σ (IsLocalRing.residue B b) →
        δ₀ b = f ((IsLocalRing.maximalIdeal B).toCotangent ⟨y, hy⟩) := by
      intro b y hy h
      rw [hδ₀]
      congr 1
      rw [Ideal.toCotangent_eq]
      exact Ideal.Quotient.eq.mp ((hxq b).trans h.symm)
    have hadd : ∀ a b, δ₀ (a + b) = δ₀ a + δ₀ b := by
      intro a b
      rw [hC (a + b) (xb a + xb b) (add_mem (hxm a) (hxm b))
        (by simp only [map_add, hxq]; ring), hδ₀, hδ₀]
      have e : (⟨xb a + xb b, add_mem (hxm a) (hxm b)⟩ : IsLocalRing.maximalIdeal B) =
          ⟨xb a, hxm a⟩ + ⟨xb b, hxm b⟩ := rfl
      rw [e, map_add, map_add]
    have hleib : ∀ a b, δ₀ (a * b) = a • δ₀ b + b • δ₀ a := by
      intro a b
      have hy : a * xb b + b * xb a ∈ IsLocalRing.maximalIdeal B :=
        add_mem (Ideal.mul_mem_left _ a (hxm b)) (Ideal.mul_mem_left _ b (hxm a))
      have hzero : Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) (xb a * xb b) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem, pow_two]
        exact Ideal.mul_mem_mul (hxm a) (hxm b)
      have hq : Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) (a * xb b + b * xb a) =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ 2) (a * b) -
            σ (IsLocalRing.residue B (a * b)) := by
        rw [map_mul, hxq, hxq] at hzero
        simp only [map_add, map_mul, hxq]
        linear_combination hzero
      rw [hC (a * b) _ hy hq, hδ₀, hδ₀]
      have e : (⟨a * xb b + b * xb a, hy⟩ : IsLocalRing.maximalIdeal B) =
          a • ⟨xb b, hxm b⟩ + b • ⟨xb a, hxm a⟩ := rfl
      rw [e, map_add, map_smul, map_smul, map_add, LinearMap.map_smul_of_tower,
        LinearMap.map_smul_of_tower]
    let D : B →ₗ[ℤ] IsLocalRing.ResidueField B := (AddMonoidHom.mk' δ₀ hadd).toIntLinearMap
    refine ⟨Derivation.mk' D (fun a b => hleib a b), ?_⟩
    intro y hy
    show δ₀ y = _
    exact hC y y hy (by rw [(IsLocalRing.residue_eq_zero_iff y).mpr hy, map_zero, sub_zero])

  have hdual : ∃ φ : Fin h → (IsLocalRing.CotangentSpace B →ₗ[IsLocalRing.ResidueField B]
      IsLocalRing.ResidueField B), ∀ i j,
      φ j ((IsLocalRing.maximalIdeal B).toCotangent (x i)) = if i = j then 1 else 0 := by
    have hext : ∀ j : Fin h, ∃ g : IsLocalRing.CotangentSpace B →ₗ[IsLocalRing.ResidueField B]
        IsLocalRing.ResidueField B,
        g ∘ₗ (Submodule.span (IsLocalRing.ResidueField B)
          (Set.range (fun i => (IsLocalRing.maximalIdeal B).toCotangent (x i)))).subtype =
          (Finsupp.lapply j) ∘ₗ hli.repr := fun j => LinearMap.exists_extend _
    choose φ hφ using hext
    refine ⟨φ, fun i j => ?_⟩
    let w : Submodule.span (IsLocalRing.ResidueField B)
        (Set.range (fun i => (IsLocalRing.maximalIdeal B).toCotangent (x i))) :=
      ⟨(IsLocalRing.maximalIdeal B).toCotangent (x i), Submodule.subset_span ⟨i, rfl⟩⟩
    calc φ j ((IsLocalRing.maximalIdeal B).toCotangent (x i))
        = (φ j ∘ₗ (Submodule.span (IsLocalRing.ResidueField B)
          (Set.range (fun i => (IsLocalRing.maximalIdeal B).toCotangent (x i)))).subtype) w := rfl
      _ = ((Finsupp.lapply j) ∘ₗ hli.repr) w := by rw [hφ j]
      _ = (hli.repr w) j := rfl
      _ = (Finsupp.single i (1 : IsLocalRing.ResidueField B)) j := by
          rw [hli.repr_eq_single i w rfl]
      _ = if i = j then 1 else 0 := Finsupp.single_apply

  obtain ⟨φ, hφ⟩ := hdual
  choose δ hδ using fun j => hder (φ j)
  refine ⟨δ, fun i j => ?_⟩
  rw [hδ j (x i) (x i).2]
  exact hφ i j

theorem wcpa_dj_rss_derivation_span : ∀ (k : Type u) [Field k] (n h : ℕ) (f : Fin h → MvPolynomial (Fin n) k), ∃ (S : ℕ) (E : Fin S → Derivation ℤ (MvPolynomial (Fin n) k) (MvPolynomial (Fin n) k)), ∀ (M : Type u) [AddCommGroup M] [Module (MvPolynomial (Fin n) k) M] (ε : Derivation ℤ (MvPolynomial (Fin n) k) M), ∃ c : Fin S → M, ∀ i, ε (f i) = ∑ l, E l (f i) • c l :=
by
  intro k _ n h f
  classical

  have hcoeffDer : ∀ d : Derivation ℤ k k, ∃ D : Derivation ℤ (MvPolynomial (Fin n) k)
      (MvPolynomial (Fin n) k), ∀ p α, (D p).coeff α = d (p.coeff α) := by
    intro d
    obtain ⟨D0, hD0⟩ : ∃ D0 : MvPolynomial (Fin n) k → MvPolynomial (Fin n) k,
        ∀ p α, (D0 p).coeff α = d (p.coeff α) := by
      refine ⟨fun p => ∑ β ∈ p.support, MvPolynomial.monomial β (d (p.coeff β)), fun p α => ?_⟩
      simp only [MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial, Finset.sum_ite_eq']
      split_ifs with hα
      · rfl
      · rw [MvPolynomial.notMem_support_iff.mp hα, map_zero]
    refine ⟨
      { toFun := D0
        map_add' := ?_
        map_smul' := ?_
        map_one_eq_zero' := ?_
        leibniz' := ?_ }, hD0⟩
    · intro p q
      ext α
      simp only [MvPolynomial.coeff_add, hD0, map_add]
    · intro z p
      ext α
      simp only [RingHom.id_apply, MvPolynomial.coeff_smul, hD0, map_zsmul]
    · apply MvPolynomial.ext
      intro α
      change (D0 1).coeff α = (0 : MvPolynomial (Fin n) k).coeff α
      rw [hD0, MvPolynomial.coeff_one, MvPolynomial.coeff_zero]
      split_ifs <;> simp
    · intro p q
      change D0 (p * q) = p • D0 q + q • D0 p
      rw [smul_eq_mul, smul_eq_mul, mul_comm q]
      ext α
      simp only [MvPolynomial.coeff_add, MvPolynomial.coeff_mul, hD0, map_sum,
        Derivation.leibniz, smul_eq_mul, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun x _ => by ring

  let F₀ : Finset k := Finset.univ.biUnion (fun i => (f i).support.image (fun α => (f i).coeff α))
  have hF₀ : ∀ i, ∀ α ∈ (f i).support, (f i).coeff α ∈ F₀ := by
    intro i α hα
    exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, Finset.mem_image_of_mem _ hα⟩
  let D₀ : Derivation ℤ k (KaehlerDifferential ℤ k) := KaehlerDifferential.D ℤ k
  let W : Submodule k (KaehlerDifferential ℤ k) :=
    Submodule.span k (F₀.image D₀ : Set (KaehlerDifferential ℤ k))
  haveI : FiniteDimensional k W := FiniteDimensional.span_finset k _
  let t := Module.finrank k W
  let b := Module.finBasis k W
  have hext : ∀ m : Fin t, ∃ g : KaehlerDifferential ℤ k →ₗ[k] k, g.comp W.subtype = b.coord m :=
    fun m => LinearMap.exists_extend (b.coord m)
  choose lam hlam using hext
  let dk : Fin t → Derivation ℤ k k := fun m => (lam m).compDer D₀
  have hstar : ∀ a ∈ F₀, D₀ a = ∑ m, dk m a • (b m : KaehlerDifferential ℤ k) := by
    intro a ha
    have hmem : D₀ a ∈ W :=
      Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ ha))
    have h1 := b.sum_repr ⟨D₀ a, hmem⟩
    have h2 := congrArg (Submodule.subtype W) h1
    rw [map_sum] at h2
    simp only [map_smul, Submodule.subtype_apply] at h2
    rw [← h2]
    refine Finset.sum_congr rfl fun m _ => ?_
    congr 1
    rw [← Module.Basis.coord_apply, ← hlam m]
    rfl

  choose Dm hDm using fun m => hcoeffDer (dk m)
  refine ⟨n + t, Fin.append (fun j => (MvPolynomial.pderiv j).restrictScalars ℤ) Dm, ?_⟩
  intro M _ _ ε
  letI : Module k M := Module.compHom M (algebraMap k (MvPolynomial (Fin n) k))
  haveI : IsScalarTower k (MvPolynomial (Fin n) k) M :=
    IsScalarTower.of_algebraMap_smul (fun _ _ => rfl)
  let δ' : Derivation ℤ k M := ε.compAlgebraMap k
  let L := δ'.liftKaehlerDifferential
  let μ : Fin t → M := fun m => L (b m)
  have hC : ∀ a ∈ F₀, ε (MvPolynomial.C a) =
      ∑ m, (MvPolynomial.C (dk m a) : MvPolynomial (Fin n) k) • μ m := by
    intro a ha
    have e1 : ε (MvPolynomial.C a) = L (D₀ a) := by
      rw [show L (D₀ a) = δ' a from δ'.liftKaehlerDifferential_comp_D a]
      show ε (MvPolynomial.C a) = ε (algebraMap k _ a)
      rw [MvPolynomial.algebraMap_eq]
    rw [e1, hstar a ha, map_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [map_smul]
    show algebraMap k (MvPolynomial (Fin n) k) (dk m a) • μ m = _
    rw [MvPolynomial.algebraMap_eq]
  let c : Fin (n + t) → M := Fin.append (fun j => ε (MvPolynomial.X j)) μ
  refine ⟨c, fun i => ?_⟩
  have hsplit : ∀ p : MvPolynomial (Fin n) k,
      ∑ l, (Fin.append (fun j => (MvPolynomial.pderiv j).restrictScalars ℤ) Dm :
        Fin (n + t) → Derivation ℤ (MvPolynomial (Fin n) k) (MvPolynomial (Fin n) k)) l p • c l =
      ∑ j, MvPolynomial.pderiv j p • ε (MvPolynomial.X j) + ∑ m, Dm m p • μ m := by
    intro p
    rw [Fin.sum_univ_add]
    simp [c, Fin.append_left, Fin.append_right]
  rw [hsplit]
  let T : Subring (MvPolynomial (Fin n) k) :=
    { carrier := {p | ε p = ∑ j, MvPolynomial.pderiv j p • ε (MvPolynomial.X j) +
          ∑ m, Dm m p • μ m}
      mul_mem' := by
        intro p q hp hq
        simp only [Set.mem_setOf_eq] at hp hq ⊢
        rw [Derivation.leibniz, hp, hq]
        simp only [Derivation.leibniz, smul_add, Finset.smul_sum, add_smul, smul_eq_mul,
          mul_smul, Finset.sum_add_distrib]
        abel
      one_mem' := by simp
      add_mem' := by
        intro p q hp hq
        simp only [Set.mem_setOf_eq] at hp hq ⊢
        rw [map_add, hp, hq]
        simp only [map_add, add_smul, Finset.sum_add_distrib]
        abel
      zero_mem' := by simp
      neg_mem' := by
        intro p hp
        simp only [Set.mem_setOf_eq] at hp ⊢
        rw [map_neg, hp]
        simp only [map_neg, neg_smul, Finset.sum_neg_distrib, neg_add] }
  have hX : ∀ j, MvPolynomial.X j ∈ T := by
    intro j
    have h0 : ∀ m, Dm m (MvPolynomial.X j) = 0 := by
      intro m
      ext α
      rw [hDm, MvPolynomial.coeff_X', MvPolynomial.coeff_zero]
      split_ifs <;> simp
    show ε (MvPolynomial.X j) = ∑ j', MvPolynomial.pderiv j' (MvPolynomial.X j) •
      ε (MvPolynomial.X j') + ∑ m, Dm m (MvPolynomial.X j) • μ m
    simp [h0, MvPolynomial.pderiv_X, Pi.single_apply]
  have hCa : ∀ a ∈ F₀, MvPolynomial.C a ∈ T := by
    intro a ha
    have h0 : ∀ m, Dm m (MvPolynomial.C a) = MvPolynomial.C (dk m a) := by
      intro m
      ext α
      rw [hDm, MvPolynomial.coeff_C, MvPolynomial.coeff_C]
      split_ifs <;> simp
    show ε (MvPolynomial.C a) = ∑ j', MvPolynomial.pderiv j' (MvPolynomial.C a) •
      ε (MvPolynomial.X j') + ∑ m, Dm m (MvPolynomial.C a) • μ m
    simp only [h0, MvPolynomial.pderiv_C, zero_smul, Finset.sum_const_zero, zero_add]
    exact hC a ha
  have hfi : f i ∈ T := by
    rw [MvPolynomial.as_sum (f i)]
    refine sum_mem fun α hα => ?_
    rw [MvPolynomial.monomial_eq]
    refine mul_mem (hCa _ (hF₀ i α hα)) ?_
    rw [Finsupp.prod]
    exact prod_mem fun j _ => pow_mem (hX j) _
  exact hfi

theorem wcpa_dj_rss_jacobian_hard_select : (∀ (k : Type u) [Field k] (n : ℕ) (Q : Ideal (MvPolynomial (Fin n) k)) [Q.IsPrime], IsRegularLocalRing (Localization.AtPrime Q)) → (∀ (R A : Type u) [CommRing R] [CommRing A] (π : R →+* A), Function.Surjective π → ∀ (p : Ideal A) [p.IsPrime], Nonempty ((Localization.AtPrime (p.comap π) ⧸ Ideal.map (algebraMap R (Localization.AtPrime (p.comap π))) (RingHom.ker π)) ≃+* Localization.AtPrime p)) → ∀ (k : Type u) [Field k] (n : ℕ) (A : Type u) [CommRing A] (π : MvPolynomial (Fin n) k →+* A), Function.Surjective π → ∀ (p : Ideal A) [p.IsPrime], IsRegularLocalRing (Localization.AtPrime p) → ∃ (h : ℕ) (f : Fin h → MvPolynomial (Fin n) k) (c : MvPolynomial (Fin n) k) (x : Fin h → IsLocalRing.maximalIdeal (Localization.AtPrime (p.comap π))), (∀ i, π (f i) = 0) ∧ π c ∉ p ∧ (∀ g, π g = 0 → c * g ∈ Ideal.span (Set.range f)) ∧ (∀ i, (x i : Localization.AtPrime (p.comap π)) = algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (p.comap π)) (f i)) ∧ LinearIndependent (IsLocalRing.ResidueField (Localization.AtPrime (p.comap π))) (fun i => (IsLocalRing.maximalIdeal (Localization.AtPrime (p.comap π))).toCotangent (x i)) :=
by
  classical

  have s4 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (m : ℕ) (g : Fin m → B)
      (hg : ∀ j, g j ∈ IsLocalRing.maximalIdeal B),
      (∀ y ∈ Ideal.span (Set.range g), y ∈ IsLocalRing.maximalIdeal B ^ 2 →
        y ∈ IsLocalRing.maximalIdeal B * Ideal.span (Set.range g)) →
      ∃ (h : ℕ) (a : Fin h → Fin m),
        LinearIndependent (IsLocalRing.ResidueField B)
          (fun i => (IsLocalRing.maximalIdeal B).toCotangent ⟨g (a i), hg (a i)⟩) ∧
        Ideal.span (Set.range g) ≤ Ideal.span (Set.range (fun i => g (a i))) := by
    intro B _ _ m g hg hcon
    let v : Fin m → (IsLocalRing.maximalIdeal B).Cotangent :=
      fun j => (IsLocalRing.maximalIdeal B).toCotangent ⟨g j, hg j⟩
    obtain ⟨κ, a', ha'inj, hspan, hli⟩ := exists_linearIndependent' (IsLocalRing.ResidueField B) v
    haveI : Finite κ := Finite.of_injective a' ha'inj
    letI : Fintype κ := Fintype.ofFinite κ
    let e : Fin (Fintype.card κ) ≃ κ := (Fintype.equivFin κ).symm
    refine ⟨Fintype.card κ, a' ∘ e, hli.comp e e.injective, ?_⟩
    have hspan' : Submodule.span (IsLocalRing.ResidueField B) (Set.range (v ∘ (a' ∘ e))) =
        Submodule.span (IsLocalRing.ResidueField B) (Set.range v) := by
      rw [show v ∘ (a' ∘ e) = (v ∘ a') ∘ e from rfl, e.surjective.range_comp, hspan]
    apply Submodule.le_of_le_smul_of_le_jacobson_bot (Submodule.fg_span (Set.finite_range g))
      (IsLocalRing.maximalIdeal_le_jacobson ⊥)
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    have hvj : v j ∈ Submodule.span (IsLocalRing.ResidueField B) (Set.range (v ∘ (a' ∘ e))) := by
      rw [hspan']; exact Submodule.subset_span ⟨j, rfl⟩
    obtain ⟨t, ht⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hvj
    choose b hb using fun i => IsLocalRing.residue_surjective (t i)
    have hsum_mem : ∑ i, b i * g ((a' ∘ e) i) ∈ IsLocalRing.maximalIdeal B :=
      Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hg _))
    have hy𝔪 : g j - ∑ i, b i * g ((a' ∘ e) i) ∈ IsLocalRing.maximalIdeal B :=
      Ideal.sub_mem _ (hg j) hsum_mem
    have hcot : (IsLocalRing.maximalIdeal B).toCotangent ⟨_, hy𝔪⟩ = 0 := by
      have hel : (⟨_, hy𝔪⟩ : IsLocalRing.maximalIdeal B) =
          ⟨g j, hg j⟩ - ∑ i, b i • (⟨g ((a' ∘ e) i), hg _⟩ : IsLocalRing.maximalIdeal B) := by
        ext
        simp [smul_eq_mul]
      rw [hel, map_sub, map_sum]
      simp only [map_smul]
      show v j - ∑ i, b i • v ((a' ∘ e) i) = 0
      rw [← ht, sub_eq_zero]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← hb i, ← IsLocalRing.ResidueField.algebraMap_eq, algebraMap_smul]
      rfl
    have hyGs : g j - ∑ i, b i * g ((a' ∘ e) i) ∈ Ideal.span (Set.range g) :=
      Ideal.sub_mem _ (Ideal.subset_span ⟨j, rfl⟩)
        (Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨_, rfl⟩))
    have hy2 := (Ideal.toCotangent_eq_zero _ _).mp hcot
    have hy := hcon _ hyGs hy2
    have h1 : ∑ i, b i * g ((a' ∘ e) i) ∈ Ideal.span (Set.range (fun i => g ((a' ∘ e) i))) :=
      Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
    have h2 : g j - ∑ i, b i * g ((a' ∘ e) i) ∈
        IsLocalRing.maximalIdeal B • Ideal.span (Set.range g) := by
      rw [Ideal.smul_eq_mul]; exact hy
    have h3 := Submodule.add_mem_sup h1 h2
    rw [add_sub_cancel] at h3
    exact h3

  have s5 : ∀ (R : Type u) [CommRing R] (Q : Ideal R) [Q.IsPrime] (m h : ℕ) (g : Fin m → R)
      (f : Fin h → R), (∀ j, algebraMap R (Localization.AtPrime Q) (g j) ∈
        Ideal.span (Set.range (fun i => algebraMap R (Localization.AtPrime Q) (f i)))) →
      ∃ c : R, c ∉ Q ∧ ∀ y ∈ Ideal.span (Set.range g), c * y ∈ Ideal.span (Set.range f) := by
    intro R _ Q _ m h g f hgf
    have hmap : Ideal.span (Set.range (fun i => algebraMap R (Localization.AtPrime Q) (f i))) =
        Ideal.map (algebraMap R (Localization.AtPrime Q)) (Ideal.span (Set.range f)) := by
      rw [Ideal.map_span, ← Set.range_comp]; rfl
    have hj : ∀ j, ∃ c : R, c ∉ Q ∧ c * g j ∈ Ideal.span (Set.range f) := by
      intro j
      have h1 := hgf j
      rw [hmap, IsLocalization.mem_map_algebraMap_iff Q.primeCompl] at h1
      obtain ⟨⟨z, s⟩, hzs⟩ := h1
      rw [← map_mul, IsLocalization.eq_iff_exists Q.primeCompl] at hzs
      obtain ⟨u, hu⟩ := hzs
      refine ⟨u * s, Q.primeCompl.mul_mem u.2 s.2, ?_⟩
      have hh : (u : R) * s * g j = u * z := by rw [← hu]; ring
      rw [hh]
      exact Ideal.mul_mem_left _ _ z.2
    choose c hcQ hcg using hj
    refine ⟨∏ j, c j, Submonoid.prod_mem Q.primeCompl (fun j _ => hcQ j), ?_⟩
    intro y hy
    obtain ⟨r, rfl⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hy
    rw [Finset.mul_sum]
    refine Ideal.sum_mem _ fun j _ => ?_
    rw [← Finset.prod_erase_mul Finset.univ c (Finset.mem_univ j)]
    have hh : (∏ x ∈ Finset.univ.erase j, c x) * c j * (r j * g j) =
        (r j * ∏ x ∈ Finset.univ.erase j, c x) * (c j * g j) := by ring
    rw [hh]
    exact Ideal.mul_mem_left _ _ (hcg j)

  intro HP HQ k _ n A _ π hπ p _ hAp
  haveI hB : IsRegularLocalRing (Localization.AtPrime (p.comap π)) := HP k n (p.comap π)
  obtain ⟨e⟩ := HQ _ A π hπ p
  haveI hBJ : IsRegularLocalRing (Localization.AtPrime (p.comap π) ⧸
      Ideal.map (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (p.comap π)))
        (RingHom.ker π)) := IsRegularLocalRing.of_ringEquiv e.symm
  have hconorm := wcpa_regular_quotient_conormal (Localization.AtPrime (p.comap π))
    (fun T _ hT => wcpa_regular_isDomain T wcpa_rs_quotient_regular hT)
    wcpa_rs_quotient_regular _ hBJ
  obtain ⟨m, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (Ideal.fg_of_isNoetherianRing (RingHom.ker π))
  have hgI : Ideal.span (Set.range g) = RingHom.ker π := hg
  have hgker : ∀ j, π (g j) = 0 := fun j => by
    have hm : g j ∈ RingHom.ker π := by rw [← hgI]; exact Ideal.subset_span ⟨j, rfl⟩
    exact RingHom.mem_ker.mp hm
  have hG : ∀ j, algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (p.comap π)) (g j) ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime (p.comap π)) := fun j =>
    (IsLocalization.AtPrime.to_map_mem_maximal_iff _ (p.comap π) (g j)).mpr
      (by rw [Ideal.mem_comap, hgker j]; exact p.zero_mem)
  have hJ : Ideal.map (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (p.comap π)))
      (RingHom.ker π) = Ideal.span (Set.range (fun j =>
        algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime (p.comap π)) (g j))) := by
    rw [← hgI, Ideal.map_span, ← Set.range_comp]; rfl
  rw [hJ] at hconorm
  obtain ⟨h, a, hli, hspan⟩ := s4 _ m _ hG hconorm
  obtain ⟨c, hcQ, hc⟩ := s5 _ (p.comap π) m h g (fun i => g (a i))
    (fun j => hspan (Ideal.subset_span ⟨j, rfl⟩))
  refine ⟨h, fun i => g (a i), c, fun i => ⟨_, hG (a i)⟩, fun i => hgker (a i),
    fun hc' => hcQ (Ideal.mem_comap.mpr hc'), fun g' hg' => hc g' ?_, fun i => rfl, hli⟩
  rw [hgI]
  exact RingHom.mem_ker.mpr hg'

theorem wcpa_dj_rss_jacobian_hard_det : (∀ (k : Type u) [Field k] (B : Type u) [CommRing B] [IsLocalRing B] [IsNoetherianRing B] [Algebra k B] (h : ℕ) (x : Fin h → IsLocalRing.maximalIdeal B), LinearIndependent (IsLocalRing.ResidueField B) (fun i => (IsLocalRing.maximalIdeal B).toCotangent (x i)) → ∃ δ : Fin h → Derivation ℤ B (IsLocalRing.ResidueField B), ∀ i j, δ j (x i) = if i = j then 1 else 0) → (∀ (k : Type u) [Field k] (n h : ℕ) (f : Fin h → MvPolynomial (Fin n) k), ∃ (S : ℕ) (E : Fin S → Derivation ℤ (MvPolynomial (Fin n) k) (MvPolynomial (Fin n) k)), ∀ (M : Type u) [AddCommGroup M] [Module (MvPolynomial (Fin n) k) M] (ε : Derivation ℤ (MvPolynomial (Fin n) k) M), ∃ c : Fin S → M, ∀ i, ε (f i) = ∑ l, E l (f i) • c l) → (∀ (K : Type u) [Field K] (h S : ℕ) (M : Matrix (Fin S) (Fin h) K) (Λ : Matrix (Fin h) (Fin S) K), Λ * M = 1 → ∃ τ : Fin h → Fin S, (M.submatrix τ id).det ≠ 0) → ∀ (k : Type u) [Field k] (n h : ℕ) (Q : Ideal (MvPolynomial (Fin n) k)) [Q.IsPrime] (f : Fin h → MvPolynomial (Fin n) k) (x : Fin h → IsLocalRing.maximalIdeal (Localization.AtPrime Q)), (∀ i, (x i : Localization.AtPrime Q) = algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime Q) (f i)) → LinearIndependent (IsLocalRing.ResidueField (Localization.AtPrime Q)) (fun i => (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).toCotangent (x i)) → ∃ D : Fin h → Derivation ℤ (MvPolynomial (Fin n) k) (MvPolynomial (Fin n) k), (Matrix.of fun i j => D j (f i)).det ∉ Q :=
by
  intro Hδ HE Hτ k _ n h Q _ f x hx hli
  classical

  have hres : ∀ (B : Type u) [CommRing B] [IsLocalRing B] [Algebra (MvPolynomial (Fin n) k) B]
      (d : Derivation ℤ B (IsLocalRing.ResidueField B)),
      ∃ e : Derivation ℤ (MvPolynomial (Fin n) k) (IsLocalRing.ResidueField B),
        ∀ r, e r = d (algebraMap (MvPolynomial (Fin n) k) B r) := by
    intro B _ _ _ d
    refine ⟨Derivation.mk'
      ((d : B →ₗ[ℤ] IsLocalRing.ResidueField B).comp
        (algebraMap (MvPolynomial (Fin n) k) B).toAddMonoidHom.toIntLinearMap) ?_, fun r => rfl⟩
    intro a b
    show d (algebraMap (MvPolynomial (Fin n) k) B (a * b)) =
      a • d (algebraMap (MvPolynomial (Fin n) k) B b) +
      b • d (algebraMap (MvPolynomial (Fin n) k) B a)
    rw [map_mul, Derivation.leibniz]
    simp only [Algebra.smul_def]
    rfl
  obtain ⟨δ, hδ⟩ := Hδ k (Localization.AtPrime Q) h x hli
  have hε0 : ∀ j, ∃ e : Derivation ℤ (MvPolynomial (Fin n) k)
      (IsLocalRing.ResidueField (Localization.AtPrime Q)),
      ∀ r, e r = δ j (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime Q) r) :=
    fun j => hres _ (δ j)
  choose ε hεdef using hε0
  have hε : ∀ i j, ε j (f i) = if i = j then 1 else 0 := by
    intro i j
    rw [hεdef, ← hx i]
    exact hδ i j
  obtain ⟨S, E, hE⟩ := HE k n h f
  have hc0 : ∀ j, ∃ c : Fin S → IsLocalRing.ResidueField (Localization.AtPrime Q),
      ∀ i, ε j (f i) = ∑ l, E l (f i) • c l := fun j => hE _ (ε j)
  choose c hc using hc0
  let M : Matrix (Fin S) (Fin h) (IsLocalRing.ResidueField (Localization.AtPrime Q)) :=
    Matrix.of fun l i => algebraMap (MvPolynomial (Fin n) k)
      (IsLocalRing.ResidueField (Localization.AtPrime Q)) (E l (f i))
  let Λ : Matrix (Fin h) (Fin S) (IsLocalRing.ResidueField (Localization.AtPrime Q)) :=
    Matrix.of fun j l => c j l
  have hΛM : Λ * M = 1 := by
    ext j i
    rw [Matrix.mul_apply, Matrix.one_apply]
    have e := hc j i
    rw [hε i j] at e
    simp only [Algebra.smul_def] at e
    simp only [Λ, M, Matrix.of_apply]
    rw [Finset.sum_congr rfl (fun l _ => mul_comm _ _), ← e]
    by_cases hij : i = j
    · subst hij; simp
    · simp [hij, Ne.symm hij]
  obtain ⟨τ, hτ⟩ := Hτ _ h S M Λ hΛM
  refine ⟨fun j => E (τ j), ?_⟩
  intro hmem
  apply hτ
  have h1 : algebraMap (MvPolynomial (Fin n) k) (IsLocalRing.ResidueField (Localization.AtPrime Q))
      (Matrix.of fun i j => E (τ j) (f i)).det = 0 := by
    show IsLocalRing.residue _ (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime Q) _) = 0
    rw [IsLocalRing.residue_eq_zero_iff,
      IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q]
    exact hmem
  rw [RingHom.map_det] at h1
  rw [← Matrix.det_transpose]
  convert h1 using 2
  ext i j
  simp [M, RingHom.mapMatrix_apply]

theorem wcpa_dj_rss_jacobian_easy : (∀ (k : Type u) [Field k] (n : ℕ) (Q : Ideal (MvPolynomial (Fin n) k)) [Q.IsPrime], IsRegularLocalRing (Localization.AtPrime Q)) → (∀ (R A : Type u) [CommRing R] [CommRing A] (π : R →+* A), Function.Surjective π → ∀ (p : Ideal A) [p.IsPrime], Nonempty ((Localization.AtPrime (p.comap π) ⧸ Ideal.map (algebraMap R (Localization.AtPrime (p.comap π))) (RingHom.ker π)) ≃+* Localization.AtPrime p)) → ∀ (k : Type u) [Field k] (n : ℕ) (A : Type u) [CommRing A] (π : MvPolynomial (Fin n) k →+* A), Function.Surjective π → ∀ (h : ℕ) (f : Fin h → MvPolynomial (Fin n) k) (c : MvPolynomial (Fin n) k) (D : Fin h → Derivation ℤ (MvPolynomial (Fin n) k) (MvPolynomial (Fin n) k)), (∀ i, π (f i) = 0) → (∀ g, π g = 0 → c * g ∈ Ideal.span (Set.range f)) → ∀ (p : Ideal A) [p.IsPrime], π c ∉ p → π (Matrix.of fun i j => D j (f i)).det ∉ p → IsRegularLocalRing (Localization.AtPrime p) :=
by
  intro hpoly hquot k _ n A _ π hπ h f c D hf hc p _ hcp hdet
  classical
  let Q : Ideal (MvPolynomial (Fin n) k) := p.comap π
  haveI hQprime : Q.IsPrime := Ideal.IsPrime.comap π
  haveI hBreg : IsRegularLocalRing (Localization.AtPrime Q) := hpoly k n Q
  let ι := algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime Q)
  have hfQ : ∀ i, f i ∈ Q := fun i => by
    show π (f i) ∈ p
    rw [hf i]; exact p.zero_mem
  have hcQ : c ∉ Q := hcp
  have hdetQ : (Matrix.of fun i j => D j (f i)).det ∉ Q := hdet

  have heq : Ideal.span (Set.range (fun i => ι (f i))) = Ideal.map ι (RingHom.ker π) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact Ideal.mem_map_of_mem ι (RingHom.mem_ker.mpr (hf i))
    · rw [Ideal.map_le_iff_le_comap]
      intro g hg
      rw [Ideal.mem_comap]
      have h1 : ι (c * g) ∈ Ideal.span (Set.range (fun i => ι (f i))) := by
        have h0 := Ideal.mem_map_of_mem ι (hc g (RingHom.mem_ker.mp hg))
        rw [Ideal.map_span, ← Set.range_comp] at h0
        exact h0
      have hu : IsUnit (ι c) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime Q) Q c).mpr hcQ
      obtain ⟨u, hu'⟩ := hu
      have h2 : ι g = ↑u⁻¹ * ι (c * g) := by
        rw [map_mul, ← hu', ← mul_assoc, Units.inv_mul, one_mul]
      rw [h2]
      exact Ideal.mul_mem_left _ _ h1

  let x : Fin h → IsLocalRing.maximalIdeal (Localization.AtPrime Q) := fun i =>
    ⟨ι (f i), (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q
      (f i)).mpr (hfQ i)⟩

  have hext : ∀ j, ∃ E : Derivation ℤ (Localization.AtPrime Q) (Localization.AtPrime Q),
      ∀ t, E (ι t) = ι (D j t) := fun j =>
    (wc_hnas_pfc_gcl_derivation_extend (MvPolynomial (Fin n) k)).2 Q.primeCompl (D j)
  choose D' hD' using hext

  have hDm2 : ∀ (E : Derivation ℤ (Localization.AtPrime Q) (Localization.AtPrime Q))
      (z : Localization.AtPrime Q),
      z ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) ^ 2 →
      E z ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
    intro E z hz
    rw [pow_two] at hz
    refine Submodule.mul_induction_on hz ?_ ?_
    · intro a ha b hb
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_right _ _ hb)
    · intro a b ha hb
      rw [map_add]
      exact Ideal.add_mem _ ha hb

  let M : Matrix (Fin h) (Fin h) (IsLocalRing.ResidueField (Localization.AtPrime Q)) :=
    Matrix.of fun i j => IsLocalRing.residue (Localization.AtPrime Q) (D' j (ι (f i)))
  have hMdet : M.det ≠ 0 := by
    have hM : M = ((IsLocalRing.residue (Localization.AtPrime Q)).comp ι).mapMatrix
        (Matrix.of fun i j => D j (f i)) := by
      ext i j
      simp [M, hD', ι]
    rw [hM, ← RingHom.map_det, RingHom.comp_apply]
    intro h0
    rw [IsLocalRing.residue_eq_zero_iff,
      IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime Q) Q] at h0
    exact hdetQ h0

  have hli : LinearIndependent (IsLocalRing.ResidueField (Localization.AtPrime Q))
      (fun i => (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).toCotangent (x i)) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    choose b hb using fun i => IsLocalRing.residue_surjective (g i)
    have hsum : (IsLocalRing.maximalIdeal (Localization.AtPrime Q)).toCotangent
        (∑ i, b i • x i) = 0 := by
      rw [map_sum, ← hg]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_smul, ← hb i]
      exact (IsScalarTower.algebraMap_smul (IsLocalRing.ResidueField (Localization.AtPrime Q))
        (b i) ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).toCotangent (x i))).symm
    rw [Ideal.toCotangent_eq_zero] at hsum
    have hy : ∑ i, b i * ι (f i) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) ^ 2 := by
      have e : ((∑ i, b i • x i : IsLocalRing.maximalIdeal (Localization.AtPrime Q)) :
          Localization.AtPrime Q) = ∑ i, b i * ι (f i) := by
        rw [Submodule.coe_sum]
        rfl
      rw [← e]
      exact hsum
    have hj : ∀ j, ∑ i, g i * M i j = 0 := by
      intro j
      have h1 := hDm2 (D' j) _ hy
      have hexp : D' j (∑ i, b i * ι (f i)) =
          ∑ i, b i * D' j (ι (f i)) + ∑ i, ι (f i) * D' j (b i) := by
        rw [← Finset.sum_add_distrib]
        induction (Finset.univ : Finset (Fin h)) using Finset.induction_on with
        | empty => simp
        | insert a s has ih =>
          rw [Finset.sum_insert has, Finset.sum_insert has, map_add, ih, Derivation.leibniz,
            smul_eq_mul, smul_eq_mul]
          try ring
      rw [hexp] at h1
      have h2 : ∑ i, ι (f i) * D' j (b i) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime Q) :=
        Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (x i).2
      have h3 := Ideal.sub_mem _ h1 h2
      rw [add_sub_cancel_right, ← IsLocalRing.residue_eq_zero_iff, map_sum] at h3
      simpa [M, map_mul, hb] using h3
    have hv : Matrix.vecMul g M = 0 := by
      funext j
      simp only [Matrix.vecMul, dotProduct, Pi.zero_apply]
      exact hj j
    have hg0 := Matrix.eq_zero_of_vecMul_eq_zero hMdet hv
    intro i
    rw [hg0]
    rfl

  have hQreg := (wcpa_rs_quotient_regular (Localization.AtPrime Q) h x hli).1
  have hspan : Ideal.span (Set.range (fun i =>
      ((x i : IsLocalRing.maximalIdeal (Localization.AtPrime Q)) : Localization.AtPrime Q))) =
      Ideal.map ι (RingHom.ker π) := heq
  obtain ⟨e₂⟩ := hquot (MvPolynomial (Fin n) k) A π hπ p
  let e : (Localization.AtPrime Q ⧸ Ideal.span (Set.range (fun i =>
      ((x i : IsLocalRing.maximalIdeal (Localization.AtPrime Q)) : Localization.AtPrime Q)))) ≃+*
      Localization.AtPrime p := (Ideal.quotEquivOfEq hspan).trans e₂
  haveI := hQreg
  refine IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime Q ⧸ Ideal.span (Set.range
    (fun i => ((x i : IsLocalRing.maximalIdeal (Localization.AtPrime Q)) :
      Localization.AtPrime Q)))) ?_
  exact e

theorem wcpa_dj_rtsx_sing_struct : ∀ (k : Type u) [Field k] (Y : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] (sY : Y ⟶ Spec (.of k)), wcpaDjIsProjOver k sY → IsLocallyNoetherian Y ∧ IsClosed (wcpaDjSing Y) ∧ (wcpaDjSingGen Y).Finite ∧ ∀ y ∈ wcpaDjSing Y, ∃ γ ∈ wcpaDjSingGen Y, γ ⤳ y :=
by
  intro k _ Y _ sY hproj
  classical

  haveI hP : IsProper sY := wcpa_dj_proj_proper k sY hproj
  haveI hLN : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian sY
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace sY
  haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk

  have htop : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X]
      [QuasiSober X] [T0Space X] (S : Set X), IsClosed S →
      {γ | γ ∈ S ∧ ∀ γ' ∈ S, γ' ⤳ γ → γ' = γ}.Finite ∧
        ∀ y ∈ S, ∃ γ ∈ {γ | γ ∈ S ∧ ∀ γ' ∈ S, γ' ⤳ γ → γ' = γ}, γ ⤳ y := by
    intro X _ _ _ _ S hS
    obtain ⟨T, hTirr, hT⟩ := TopologicalSpace.NoetherianSpace.exists_finset_irreducible
      (⟨S, hS⟩ : TopologicalSpace.Closeds X)
    have hSeq : ∀ z, z ∈ S ↔ ∃ Z ∈ T, z ∈ (Z : Set X) := by
      intro z
      have h1 := congrArg (fun C : TopologicalSpace.Closeds X => z ∈ (C : Set X)) hT
      simp only [TopologicalSpace.Closeds.coe_finset_sup, Finset.sup_set_eq_biUnion] at h1
      simpa using h1
    have hgen : ∀ Z ∈ T, ∃ η, IsGenericPoint η (Z : Set X) := fun Z hZ =>
      QuasiSober.sober (hTirr ⟨Z, hZ⟩) Z.isClosed
    rcases isEmpty_or_nonempty X with hX | hX
    · exact ⟨Set.Finite.subset Set.finite_empty (fun x _ => isEmptyElim x),
        fun y => isEmptyElim y⟩
    choose! η hη using hgen
    have hηS : ∀ Z ∈ T, η Z ∈ S := fun Z hZ => (hSeq _).mpr ⟨Z, hZ, (hη Z hZ).mem⟩
    refine ⟨?_, ?_⟩
    · apply (T.image η).finite_toSet.subset
      rintro γ ⟨hγS, hmin⟩
      obtain ⟨Z, hZ, hγZ⟩ := (hSeq γ).mp hγS
      have h1 : η Z = γ := hmin (η Z) (hηS Z hZ) ((hη Z hZ).specializes hγZ)
      rw [Finset.coe_image]
      exact ⟨Z, hZ, h1⟩
    · intro y hy
      have hne : (T.filter (fun Z : TopologicalSpace.Closeds X => y ∈ (Z : Set X))).Nonempty := by
        obtain ⟨Z, hZ, hyZ⟩ := (hSeq y).mp hy
        exact ⟨Z, Finset.mem_filter.mpr ⟨hZ, hyZ⟩⟩
      obtain ⟨Z, hZmax⟩ := Finset.exists_maximal hne
      have hZT : Z ∈ T := (Finset.mem_filter.mp hZmax.1).1
      have hyZ : y ∈ (Z : Set X) := (Finset.mem_filter.mp hZmax.1).2
      refine ⟨η Z, ⟨hηS Z hZT, ?_⟩, (hη Z hZT).specializes hyZ⟩
      intro γ' hγ'S hsp
      obtain ⟨Z', hZ'T, hγ'Z'⟩ := (hSeq γ').mp hγ'S
      have hηZ' : η Z ∈ (Z' : Set X) := hsp.mem_closed Z'.isClosed hγ'Z'
      have hle : Z ≤ Z' := by
        intro w hw
        exact ((hη Z hZT).specializes hw).mem_closed Z'.isClosed hηZ'
      have hyZ' : y ∈ (Z' : Set X) := hle hyZ
      have hle' : Z' ≤ Z := hZmax.2 (Finset.mem_filter.mpr ⟨hZ'T, hyZ'⟩) hle
      have hγ'Z : γ' ∈ (Z : Set X) := hle' hγ'Z'
      exact (hsp.antisymm ((hη Z hZT).specializes hγ'Z)).eq

  have htrans : ∀ (X : Scheme.{u}), (∀ U : X.Opens, IsAffineOpen U → IsOpen {p : PrimeSpectrum Γ(X, U) |
      IsRegularLocalRing (Localization.AtPrime p.asIdeal)}) →
      IsOpen {x : X | IsRegularLocalRing (X.presheaf.stalk x)} := by
    intro X H
    rw [isOpen_iff_forall_mem_open]
    intro x hx
    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    have key : ∀ z : U, IsRegularLocalRing (X.presheaf.stalk z) ↔
        IsRegularLocalRing (Localization.AtPrime (hU.primeIdealOf z).asIdeal) := by
      intro z
      have := hU.isLocalization_stalk z
      let e := IsLocalization.algEquiv (hU.primeIdealOf z).asIdeal.primeCompl
        (X.presheaf.stalk z) (Localization.AtPrime (hU.primeIdealOf z).asIdeal)
      constructor
      · intro h; exact IsRegularLocalRing.of_ringEquiv e.toRingEquiv
      · intro h; exact IsRegularLocalRing.of_ringEquiv e.toRingEquiv.symm
    have hemb := hU.fromSpec.isOpenEmbedding
    refine ⟨hU.fromSpec '' {p : PrimeSpectrum Γ(X, U) |
      IsRegularLocalRing (Localization.AtPrime p.asIdeal)}, ?_, hemb.isOpenMap _ (H U hU), ?_⟩
    · rintro _ ⟨p, hp, rfl⟩
      have hmem : hU.fromSpec p ∈ U := by
        rw [← SetLike.mem_coe, ← hU.range_fromSpec]; exact ⟨p, rfl⟩
      have hpi : hU.primeIdealOf ⟨hU.fromSpec p, hmem⟩ = p :=
        hemb.injective (hU.fromSpec_primeIdealOf ⟨hU.fromSpec p, hmem⟩)
      have := (key ⟨hU.fromSpec p, hmem⟩).mpr (by rw [hpi]; exact hp)
      exact this
    · exact ⟨hU.primeIdealOf ⟨x, hxU⟩, (key ⟨x, hxU⟩).mp hx, hU.fromSpec_primeIdealOf _⟩

  have H1 := wcpa_dj_rss_jacobian_hard_select wcpa_dj_rss_poly_field_regular
    wcpa_dj_rss_quot_localization
  have H1b := wcpa_dj_rss_jacobian_hard_det
    (wcpa_dj_rss_dual_derivations wcpa_dj_rss_coeff_section) wcpa_dj_rss_derivation_span
    wcpa_dj_rss_left_inverse_minor
  have H2 := wcpa_dj_rss_jacobian_easy wcpa_dj_rss_poly_field_regular
    wcpa_dj_rss_quot_localization

  have hregopen : ∀ (k₀ : Type u) [Field k₀] (A : Type u) [CommRing A] (φ : k₀ →+* A),
      φ.FiniteType → IsOpen {p : PrimeSpectrum A |
        IsRegularLocalRing (Localization.AtPrime p.asIdeal)} := by
    intro k₀ _ A _ φ hφ
    letI := φ.toAlgebra
    obtain ⟨n, ψ, hψ⟩ := (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k₀) (S := A)).mp hφ
    have hψ' : Function.Surjective ψ.toRingHom := hψ
    rw [isOpen_iff_forall_mem_open]
    intro p hp
    obtain ⟨h, f, c, x, hf0, hc, hcI, hx, hli⟩ := H1 k₀ n A ψ.toRingHom hψ' p.asIdeal hp
    obtain ⟨D, hD⟩ := H1b k₀ n h (p.asIdeal.comap ψ.toRingHom) f x hx hli
    rw [Ideal.mem_comap] at hD
    refine ⟨PrimeSpectrum.basicOpen
      (ψ.toRingHom c * ψ.toRingHom (Matrix.of fun i j => D j (f i)).det),
      ?_, PrimeSpectrum.isOpen_basicOpen, ?_⟩
    · intro p' hp'
      rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hp'
      have h1 : ψ.toRingHom c ∉ p'.asIdeal := fun h => hp' (p'.asIdeal.mul_mem_right _ h)
      have h2 : ψ.toRingHom (Matrix.of fun i j => D j (f i)).det ∉ p'.asIdeal :=
        fun h => hp' (p'.asIdeal.mul_mem_left _ h)
      exact H2 k₀ n A ψ.toRingHom hψ' h f c D hf0 hcI p'.asIdeal h1 h2
    · rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
      exact fun h => (p.isPrime.mem_or_mem h).elim hc hD

  have hft : ∀ U : Y.Opens, IsAffineOpen U → IsOpen {p : PrimeSpectrum Γ(Y, U) |
      IsRegularLocalRing (Localization.AtPrime p.asIdeal)} := by
    intro U hU
    have hsurj : Function.Surjective (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom :=
      (Scheme.ΓSpecIso (CommRingCat.of k)).commRingCatIsoToRingEquiv.symm.surjective
    exact hregopen k Γ(Y, U)
      ((sY.appLE ⊤ U (by simp)).hom.comp (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom)
      (RingHom.FiniteType.comp
        (HasRingHomProperty.appLE @LocallyOfFiniteType sY inferInstance
          ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ (by simp))
        (RingHom.FiniteType.of_surjective _ hsurj))
  have hopen := htrans Y hft
  have hcl : IsClosed (wcpaDjSing Y) := hopen.isClosed_compl

  obtain ⟨h3, h4⟩ := htop Y (wcpaDjSing Y) hcl
  exact ⟨hLN, hcl, h3, h4⟩

theorem wcpa_dj_rtsx_low_weight_regular : ∀ (Z : Scheme.{u}) [IsLocallyNoetherian Z] (B : Set Z) (z : Z) (w : ℕ), wcpaDjTorNodeSglWt Z B z w → w ≤ 1 → IsRegularLocalRing (Z.presheaf.stalk z) :=
by
  classical
  intro Z _ B z w hW hw
  obtain ⟨n, q, A, iA, hAreg, hAc, x, y, v, σ, b, e, h, J, hv, hdim, hspan, -, -, -, -, -, hsum⟩ :=
    hW
  haveI hAnoeth : IsNoetherianRing A := hAreg.toIsNoetherian
  have hxm : x ∈ IsLocalRing.maximalIdeal A := by
    rw [← hspan]; exact Ideal.subset_span (Or.inl (Set.mem_insert x _))
  have hym : y ∈ IsLocalRing.maximalIdeal A := by
    rw [← hspan]; exact Ideal.subset_span (Or.inl (Set.mem_insert_of_mem x rfl))
  have hσm : ∀ l, σ l ∈ IsLocalRing.maximalIdeal A := fun l => by
    rw [← hspan]; exact Ideal.subset_span (Or.inr ⟨l, rfl⟩)
  set F := x * y - v * ∏ l, σ l ^ b l with hF
  haveI hRnt : Nontrivial (A ⧸ Ideal.span {F}) := e.injective.nontrivial
  have hFne : Ideal.span {F} ≠ ⊤ := Ideal.Quotient.nontrivial_iff.mp hRnt
  rcases (by omega : w = 0 ∨ w = 1) with hw0 | hw1
  ·
    exfalso
    subst hw0
    have hb0 : ∀ l, b l = 0 := fun l => Finset.sum_eq_zero_iff.mp hsum l (Finset.mem_univ l)
    have hprod : ∏ l, σ l ^ b l = 1 :=
      Finset.prod_eq_one (fun l _ => by rw [hb0 l, pow_zero])
    have hFm : F ∉ IsLocalRing.maximalIdeal A := by
      intro hFm
      have hveq : v = x * y - F := by rw [hF, hprod]; ring
      have hvm : v ∈ IsLocalRing.maximalIdeal A := by
        rw [hveq]; exact sub_mem (Ideal.mul_mem_right y _ hxm) hFm
      exact ((IsLocalRing.mem_maximalIdeal v).mp hvm) hv
    have hFu : IsUnit F := by
      by_contra hc
      exact hFm ((IsLocalRing.mem_maximalIdeal F).mpr hc)
    exact hFne (Ideal.span_singleton_eq_top.mpr hFu)
  · subst hw1

    obtain ⟨l0, -, hl0⟩ := Finset.exists_ne_zero_of_sum_ne_zero (by rw [hsum]; exact one_ne_zero)
    have hsplit := Finset.add_sum_erase Finset.univ b (Finset.mem_univ l0)
    rw [hsum] at hsplit
    have hbl0 : b l0 = 1 := by omega
    have hrest : ∑ l ∈ Finset.univ.erase l0, b l = 0 := by omega
    have hbl : ∀ l, l ≠ l0 → b l = 0 := fun l hl =>
      Finset.sum_eq_zero_iff.mp hrest l (Finset.mem_erase.mpr ⟨hl, Finset.mem_univ l⟩)
    have hprod : ∏ l, σ l ^ b l = σ l0 := by
      rw [Finset.prod_eq_single l0 (fun l _ hl => by rw [hbl l hl, pow_zero])
        (fun h' => absurd (Finset.mem_univ l0) h'), hbl0, pow_one]
    have hFeq : F = x * y - v * σ l0 := by rw [hF, hprod]
    have hFm : F ∈ IsLocalRing.maximalIdeal A := by
      rw [hFeq]
      exact sub_mem (Ideal.mul_mem_right y _ hxm) (Ideal.mul_mem_left _ v (hσm l0))

    set R := A ⧸ Ideal.span {F} with hRdef
    let mk : A →+* R := Ideal.Quotient.mk (Ideal.span {F})
    have hmk : Function.Surjective mk := Ideal.Quotient.mk_surjective
    haveI hRloc : IsLocalRing R := IsLocalRing.of_surjective' mk hmk
    haveI hRnoeth : IsNoetherianRing R := Ideal.Quotient.isNoetherianRing _
    obtain ⟨u, hu⟩ := hv.exists_left_inv
    have hkey : mk (σ l0) = mk u * mk y * mk x := by
      rw [← map_mul, ← map_mul]
      apply Ideal.Quotient.eq.mpr
      have : σ l0 - u * y * x = (-u) * F := by
        rw [hFeq]; linear_combination (-σ l0) * hu
      rw [this]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self F)
    let S : Finset R :=
      insert (mk x) (insert (mk y) ((Finset.univ.erase l0).image (fun l => mk (σ l))))
    have hmapmax : IsLocalRing.maximalIdeal R = Ideal.map mk (IsLocalRing.maximalIdeal A) :=
      (IsLocalRing.map_maximalIdeal_of_surjective mk hmk).symm
    have hmaxS : IsLocalRing.maximalIdeal R = Ideal.span (S : Set R) := by
      apply le_antisymm
      · rw [hmapmax, ← hspan, Ideal.map_span, Ideal.span_le]
        rintro _ ⟨a, ha, rfl⟩
        simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff,
          Set.mem_range] at ha
        rcases ha with (rfl | rfl) | ⟨l, rfl⟩
        · exact Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_insert_self _ _))
        · exact Ideal.subset_span (Finset.mem_coe.mpr
            (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)))
        · by_cases hl : l = l0
          · subst hl
            show mk (σ l) ∈ Ideal.span (S : Set R)
            rw [hkey]
            exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Finset.mem_coe.mpr
              (Finset.mem_insert_self _ _)))
          · exact Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_insert_of_mem
              (Finset.mem_insert_of_mem (Finset.mem_image.mpr
                ⟨l, Finset.mem_erase.mpr ⟨hl, Finset.mem_univ _⟩, rfl⟩))))
      · rw [Ideal.span_le]
        intro g hg
        rw [Finset.mem_coe, Finset.mem_insert, Finset.mem_insert, Finset.mem_image] at hg
        rw [hmapmax]
        rcases hg with rfl | rfl | ⟨l, -, rfl⟩
        · exact Ideal.mem_map_of_mem mk hxm
        · exact Ideal.mem_map_of_mem mk hym
        · exact Ideal.mem_map_of_mem mk (hσm l)
    have hn : 1 ≤ n := Fin.pos l0
    have hcard : S.card ≤ n + 1 := by
      change (insert (mk x) (insert (mk y)
        ((Finset.univ.erase l0).image (fun l => mk (σ l))))).card ≤ n + 1
      have h1 := Finset.card_insert_le (mk x)
        (insert (mk y) ((Finset.univ.erase l0).image (fun l => mk (σ l))))
      have h2 := Finset.card_insert_le (mk y) ((Finset.univ.erase l0).image (fun l => mk (σ l)))
      have h3 := Finset.card_image_le (s := Finset.univ.erase l0) (f := fun l => mk (σ l))
      have h4 : (Finset.univ.erase l0).card = n - 1 := by
        rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Fintype.card_fin]
      omega
    have hsf : (IsLocalRing.maximalIdeal R).spanFinrank ≤ n + 1 := by
      rw [hmaxS]
      refine (Submodule.spanFinrank_span_le_ncard_of_finite S.finite_toSet).trans ?_
      rw [Set.ncard_coe_finset]
      exact hcard

    have hK := ringKrullDim_le_ringKrullDim_quotient_add_card ({F} : Finset A) (by
      intro a ha
      rw [Finset.coe_singleton, Set.mem_singleton_iff] at ha
      rw [ha, IsLocalRing.ringJacobson_eq_maximalIdeal]
      exact hFm)
    rw [Finset.coe_singleton, Finset.card_singleton] at hK
    have hle : ((n + 2 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim R + ((1 : ℕ) : WithBot ℕ∞) :=
      hdim ▸ hK
    have hdimR : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim R := by
      generalize ringKrullDim R = d at hle ⊢
      induction d using WithBot.recBotCoe with
      | bot => simp at hle
      | coe d =>
        induction d using ENat.recTopCoe with
        | top => exact WithBot.coe_le_coe.mpr le_top
        | coe d =>
          have h1 : ((n + 2 : ℕ) : WithBot ℕ∞) ≤ (((d + 1 : ℕ) : ℕ∞) : WithBot ℕ∞) := by
            simpa using hle
          have h2 : ((n + 2 : ℕ) : ℕ∞) ≤ ((d + 1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp h1
          have h3 : n + 2 ≤ d + 1 := by exact_mod_cast h2
          exact WithBot.coe_le_coe.mpr (by exact_mod_cast (by omega : n + 1 ≤ d))
    have hRreg : IsRegularLocalRing R :=
      IsRegularLocalRing.of_spanFinrank_maximalIdeal_le R
        (le_trans (by exact_mod_cast hsf) hdimR)

    have hCreg : IsRegularLocalRing
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) :=
      IsRegularLocalRing.of_ringEquiv e.symm
    haveI : IsNoetherianRing
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) :=
      isNoetherianRing_of_surjective R _ e.symm.toRingHom e.symm.surjective
    exact wc_hnas_pfc_regular_flat_descent (Z.presheaf.stalk z)
      (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) hCreg

theorem wcpa_dj_rtsx_offE : ∀ {Y Y' : Scheme.{u}} (π : Y' ⟶ Y) (V : Y.Opens) (B : Set Y), IsIso (π ∣_ V) → (∀ y ∈ (V : Set Y), ∃ y' : Y', π y' = y) ∧ Set.InjOn ⇑π (⇑π ⁻¹' (V : Set Y)) ∧ ∀ y' : Y', π y' ∈ V → ((IsRegularLocalRing (Y'.presheaf.stalk y') ↔ IsRegularLocalRing (Y.presheaf.stalk (π y'))) ∧ ringKrullDim (Y'.presheaf.stalk y') = ringKrullDim (Y.presheaf.stalk (π y')) ∧ (wcpaDjTorPt Y' (⇑π ⁻¹' B) y' ↔ wcpaDjTorPt Y B (π y')) ∧ (wcpaDjTorNodeSgl Y' (⇑π ⁻¹' B) y' ↔ wcpaDjTorNodeSgl Y B (π y')) ∧ (∀ w, wcpaDjTorNodeSglWt Y' (⇑π ⁻¹' B) y' w ↔ wcpaDjTorNodeSglWt Y B (π y') w) ∧ (y' ∈ wcpaDjSingGen Y' ↔ π y' ∈ wcpaDjSingGen Y)) :=
by
  intro Y Y' π V B hiso
  classical

  have hC : ∀ {T : Type u} [CommRing T] (K : Ideal T) {m n : ℕ} (h : m ≤ n)
      (x : AdicCompletion K T),
      Ideal.Quotient.factorPow K h (AdicCompletion.evalₐ K n x) = AdicCompletion.evalₐ K m x := by
    intro T _ K m n h x
    obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective K T x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    show Ideal.Quotient.mk (K ^ m) _ = Ideal.Quotient.mk (K ^ m) _
    rw [Ideal.Quotient.eq]
    have := AdicCompletion.AdicCauchySequence.mk_eq_mk h a
    rw [Submodule.Quotient.eq] at this
    simpa using this

  have hmap : ∀ {R S : Type u} [CommRing R] [CommRing S] (I : Ideal R) (J : Ideal S)
      (φ : R →+* S), I ≤ J.comap φ → ∃ Φ : AdicCompletion I R →+* AdicCompletion J S,
        ∀ (n : ℕ) (x : AdicCompletion I R) (r : R),
          AdicCompletion.evalₐ I n x = Ideal.Quotient.mk (I ^ n) r →
          AdicCompletion.evalₐ J n (Φ x) = Ideal.Quotient.mk (J ^ n) (φ r) := by
    intro R S _ _ I J φ hle
    have hlen : ∀ n : ℕ, I ^ n ≤ (J ^ n).comap φ := fun n =>
      (Ideal.pow_right_mono hle n).trans (Ideal.le_comap_pow φ n)
    refine ⟨AdicCompletion.liftRingHom J (fun n => (Ideal.quotientMap (J ^ n) φ (hlen n)).comp
      (AdicCompletion.evalₐ I n).toRingHom) ?_, ?_⟩
    · intro m n hmn
      refine RingHom.ext fun x => ?_
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n x)
      have hm : AdicCompletion.evalₐ I m x = Ideal.Quotient.mk (I ^ m) r := by
        rw [← hC I hmn x, ← hr]; rfl
      change Ideal.Quotient.factorPow J hmn
          (Ideal.quotientMap (J ^ n) φ (hlen n) (AdicCompletion.evalₐ I n x)) =
        Ideal.quotientMap (J ^ m) φ (hlen m) (AdicCompletion.evalₐ I m x)
      rw [← hr, hm, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
      rfl
    · intro n x r hr
      rw [AdicCompletion.evalₐ_liftRingHom]
      change Ideal.quotientMap (J ^ n) φ (hlen n) (AdicCompletion.evalₐ I n x) = _
      rw [hr, Ideal.quotientMap_mk]
  have hadic : ∀ {R S : Type u} [CommRing R] [CommRing S] (I : Ideal R) (J : Ideal S)
      (φ : R ≃+* S), Ideal.map φ I = J →
      ∃ Φ : AdicCompletion I R ≃+* AdicCompletion J S, ∀ r : R,
        Φ (algebraMap R (AdicCompletion I R) r) = algebraMap S (AdicCompletion J S) (φ r) := by
    intro R S _ _ I J φ hJ
    have h1 : I ≤ J.comap (φ : R →+* S) := by
      rw [← hJ]; exact Ideal.le_comap_map
    have h2 : J ≤ I.comap (φ.symm : S →+* R) := by
      have e : Ideal.map φ.symm J = I := by rw [← hJ]; exact Ideal.map_of_equiv φ
      rw [← e]; exact Ideal.le_comap_map
    obtain ⟨Φ₀, hΦ₀⟩ := hmap I J (φ : R →+* S) h1
    obtain ⟨Ψ₀, hΨ₀⟩ := hmap J I (φ.symm : S →+* R) h2
    have hΨΦ : ∀ x, Ψ₀ (Φ₀ x) = x := by
      intro x
      refine AdicCompletion.ext_evalₐ fun n => ?_
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I n x)
      rw [hΨ₀ n _ (φ r) (hΦ₀ n x r hr.symm), ← hr]
      simp
    have hΦΨ : ∀ x, Φ₀ (Ψ₀ x) = x := by
      intro x
      refine AdicCompletion.ext_evalₐ fun n => ?_
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ J n x)
      rw [hΦ₀ n _ (φ.symm r) (hΨ₀ n x r hr.symm), ← hr]
      simp
    refine ⟨RingEquiv.ofRingHom Φ₀ Ψ₀ (RingHom.ext hΦΨ) (RingHom.ext hΨΦ), fun r => ?_⟩
    refine AdicCompletion.ext_evalₐ fun n => ?_
    change AdicCompletion.evalₐ J n (Φ₀ (algebraMap R (AdicCompletion I R) r)) = _
    rw [hΦ₀ n _ r ((AdicCompletion.evalₐ I n).commutes r), AlgHom.commutes]
    rfl
  have singD : ∀ {Z : Scheme.{u}} {z : Z},
      z ∈ wcpaDjSing Z ↔ ¬ IsRegularLocalRing (Z.presheaf.stalk z) := Iff.rfl
  have genD : ∀ {Z : Scheme.{u}} {z : Z}, z ∈ wcpaDjSingGen Z ↔
      (z ∈ wcpaDjSing Z ∧ ∀ γ' ∈ wcpaDjSing Z, γ' ⤳ z → γ' = z) := Iff.rfl

  have torpt1 : ∀ {Z Z' : Scheme.{u}} (z : Z) (z' : Z') (B : Set Z) (B' : Set Z')
      (φ : Z.presheaf.stalk z ≃+* Z'.presheaf.stalk z')
      (Φ : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z) ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk z')) (Z'.presheaf.stalk z')),
      (∀ r : Z.presheaf.stalk z, Φ (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) r) =
        algebraMap (Z'.presheaf.stalk z')
          (AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk z')) (Z'.presheaf.stalk z'))
          (φ r)) →
      (∀ (q : ℕ) (h : Fin q → Z.presheaf.stalk z),
        (∀ (w : Z) (hw : w ⤳ z), (w ∈ B ↔ ∃ i, (Z.presheaf.stalkSpecializes hw).hom (h i) ∈
          IsLocalRing.maximalIdeal (Z.presheaf.stalk w))) →
        (∀ (w' : Z') (hw : w' ⤳ z'), (w' ∈ B' ↔ ∃ i, (Z'.presheaf.stalkSpecializes hw).hom
          (φ (h i)) ∈ IsLocalRing.maximalIdeal (Z'.presheaf.stalk w')))) →
      wcpaDjTorPt Z B z → wcpaDjTorPt Z' B' z' := by
    intro Z Z' z z' B B' φ Φ hc hsp hT
    obtain ⟨n, q, s, h, J, hn, hspan, hdisj, hass, hcl⟩ := hT
    refine ⟨n, q, fun j => Φ (s j), fun i => φ (h i), J,
      hn.trans (ringKrullDim_eq_of_ringEquiv φ), ?_, hdisj, ?_, hsp q h hcl⟩
    · have hc' : (Φ : _ →+* _).comp (algebraMap (Z.presheaf.stalk z)
          (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))) =
          (algebraMap (Z'.presheaf.stalk z')
          (AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk z'))
            (Z'.presheaf.stalk z'))).comp (φ : _ →+* _) := RingHom.ext hc
      have e1 : Ideal.span (Set.range fun j => Φ (s j)) =
          Ideal.map (Φ : _ →+* _) (Ideal.span (Set.range s)) := by
        rw [Ideal.map_span, ← Set.range_comp]; rfl
      rw [e1, hspan, Ideal.map_map, hc', ← Ideal.map_map]
      congr 1
      exact IsLocalRing.map_ringEquiv_maximalIdeal φ
    · intro i
      have := (hass i).map Φ
      rw [hc, map_prod] at this
      exact this

  have node1 : ∀ {Z Z' : Scheme.{u}} (z : Z) (z' : Z') (B : Set Z) (B' : Set Z')
      (φ : Z.presheaf.stalk z ≃+* Z'.presheaf.stalk z')
      (Φ : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z) ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk z')) (Z'.presheaf.stalk z')),
      (∀ r : Z.presheaf.stalk z, Φ (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) r) =
        algebraMap (Z'.presheaf.stalk z')
          (AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk z')) (Z'.presheaf.stalk z'))
          (φ r)) →
      (∀ (q : ℕ) (h : Fin q → Z.presheaf.stalk z),
        (∀ (w : Z) (hw : w ⤳ z), (w ∈ B ↔ ∃ i, (Z.presheaf.stalkSpecializes hw).hom (h i) ∈
          IsLocalRing.maximalIdeal (Z.presheaf.stalk w))) →
        (∀ (w' : Z') (hw : w' ⤳ z'), (w' ∈ B' ↔ ∃ i, (Z'.presheaf.stalkSpecializes hw).hom
          (φ (h i)) ∈ IsLocalRing.maximalIdeal (Z'.presheaf.stalk w')))) →
      wcpaDjTorNodeSgl Z B z → wcpaDjTorNodeSgl Z' B' z' := by
    intro Z Z' z z' B B' φ Φ hc hsp hT
    obtain ⟨n, q, A, i1, i2, i3, x, y, v, σ, b, e, h, J, H1, H2, H3, H4, H5, H6, H7, H8⟩ := hT
    refine ⟨n, q, A, i1, i2, i3, x, y, v, σ, b, Φ.symm.trans e, fun i => φ (h i), J,
      H1, H2, H3, H4, H5, H6, ?_, hsp q h H8⟩
    intro i
    have e2 : Φ.symm (algebraMap (Z'.presheaf.stalk z')
        (AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk z')) (Z'.presheaf.stalk z'))
        (φ (h i))) = algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))
        (h i) := by
      rw [RingEquiv.symm_apply_eq, hc]
    rw [RingEquiv.trans_apply, e2]
    exact H7 i

  have wt1 : ∀ {Z Z' : Scheme.{u}} (z : Z) (z' : Z') (B : Set Z) (B' : Set Z')
      (φ : Z.presheaf.stalk z ≃+* Z'.presheaf.stalk z')
      (Φ : AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z) ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk z')) (Z'.presheaf.stalk z')),
      (∀ r : Z.presheaf.stalk z, Φ (algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)) r) =
        algebraMap (Z'.presheaf.stalk z')
          (AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk z')) (Z'.presheaf.stalk z'))
          (φ r)) →
      (∀ (q : ℕ) (h : Fin q → Z.presheaf.stalk z),
        (∀ (w : Z) (hw : w ⤳ z), (w ∈ B ↔ ∃ i, (Z.presheaf.stalkSpecializes hw).hom (h i) ∈
          IsLocalRing.maximalIdeal (Z.presheaf.stalk w))) →
        (∀ (w' : Z') (hw : w' ⤳ z'), (w' ∈ B' ↔ ∃ i, (Z'.presheaf.stalkSpecializes hw).hom
          (φ (h i)) ∈ IsLocalRing.maximalIdeal (Z'.presheaf.stalk w')))) →
      ∀ w, wcpaDjTorNodeSglWt Z B z w → wcpaDjTorNodeSglWt Z' B' z' w := by
    intro Z Z' z z' B B' φ Φ hc hsp w hT
    obtain ⟨n, q, A, i1, i2, i3, x, y, v, σ, b, e, h, J, H1, H2, H3, H4, H5, H6, H7, H8, H9⟩ := hT
    refine ⟨n, q, A, i1, i2, i3, x, y, v, σ, b, Φ.symm.trans e, fun i => φ (h i), J,
      H1, H2, H3, H4, H5, H6, ?_, hsp q h H8, H9⟩
    intro i
    have e2 : Φ.symm (algebraMap (Z'.presheaf.stalk z')
        (AdicCompletion (IsLocalRing.maximalIdeal (Z'.presheaf.stalk z')) (Z'.presheaf.stalk z'))
        (φ (h i))) = algebraMap (Z.presheaf.stalk z)
        (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z))
        (h i) := by
      rw [RingEquiv.symm_apply_eq, hc]
    rw [RingEquiv.trans_apply, e2]
    exact H7 i

  let H := Scheme.Hom.homeomorph (π ∣_ V)
  have hH : ∀ x : (π ⁻¹ᵁ V).toScheme, (H x).1 = π x.1 := fun x => by
    rw [Scheme.Hom.homeomorph_apply]; exact morphismRestrict_base_coe π V x
  have hsurj : ∀ y ∈ (V : Set Y), ∃ y' : Y', π y' = y := by
    intro y hy
    exact ⟨(H.symm ⟨y, hy⟩).1,
      (hH (H.symm ⟨y, hy⟩)).symm.trans (congrArg Subtype.val (H.apply_symm_apply ⟨y, hy⟩))⟩
  have hinj : Set.InjOn ⇑π (⇑π ⁻¹' (V : Set Y)) := by
    intro a ha b hb hab
    have e : H ⟨a, ha⟩ = H ⟨b, hb⟩ :=
      Subtype.ext ((hH ⟨a, ha⟩).trans (hab.trans (hH ⟨b, hb⟩).symm))
    have e2 := congrArg Subtype.val (H.injective e)
    exact e2
  have hlift : ∀ y' : Y', π y' ∈ V → ∀ w : Y, w ⤳ π y' → ∃ w' : Y', w' ⤳ y' ∧ π w' = w := by
    intro y' hy w hw
    have hwV : w ∈ V := V.isOpen.stableUnderGeneralization hw hy
    have h2 : H.symm ⟨w, hwV⟩ ⤳ H.symm ⟨π y', hy⟩ :=
      Specializes.map (Topology.IsInducing.subtypeVal.specializes_iff.mp hw) H.symm.continuous
    have e1 : H.symm ⟨π y', hy⟩ = ⟨y', hy⟩ :=
      H.injective ((H.apply_symm_apply ⟨π y', hy⟩).trans (Subtype.ext (hH ⟨y', hy⟩).symm))
    refine ⟨(H.symm ⟨w, hwV⟩).1, ?_, ?_⟩
    · rw [e1] at h2
      exact h2.map continuous_subtype_val
    · exact (hH (H.symm ⟨w, hwV⟩)).symm.trans
        (congrArg Subtype.val (H.apply_symm_apply ⟨w, hwV⟩))

  have hst : ∀ a : Y', π a ∈ V → IsIso (π.stalkMap a) := by
    intro a ha
    have h1 : IsIso ((π ∣_ V).stalkMap (⟨a, ha⟩ : (π ⁻¹ᵁ V).toScheme)) :=
      ((isIso_iff_isIso_stalkMap (π ∣_ V)).mp hiso).2 _
    exact (MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms CommRingCat)
      (morphismRestrictStalkMap π V ⟨a, ha⟩)).mp h1
  have hreg : ∀ a : Y', π a ∈ V → (IsRegularLocalRing (Y'.presheaf.stalk a) ↔
      IsRegularLocalRing (Y.presheaf.stalk (π a))) := by
    intro a ha
    have := hst a ha
    constructor
    · intro h
      have := h
      exact IsRegularLocalRing.of_ringEquiv (asIso (π.stalkMap a)).commRingCatIsoToRingEquiv.symm
    · intro h
      have := h
      exact IsRegularLocalRing.of_ringEquiv (asIso (π.stalkMap a)).commRingCatIsoToRingEquiv

  have hE : ∀ (w' z' : Y') (hw : w' ⤳ z') (x : Y.presheaf.stalk (π z')),
      (Y'.presheaf.stalkSpecializes hw).hom ((π.stalkMap z').hom x) =
      (π.stalkMap w').hom ((Y.presheaf.stalkSpecializes (hw.map π.continuous)).hom x) := by
    intro w' z' hw x
    have h1 := Scheme.Hom.stalkSpecializes_stalkMap π w' z' hw
    have h2 := congrArg (fun g => (CommRingCat.Hom.hom g) x) h1
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    exact h2.symm
  have hM : ∀ (w' : Y') (y : Y.presheaf.stalk (π w')),
      (π.stalkMap w').hom y ∈ IsLocalRing.maximalIdeal (Y'.presheaf.stalk w') ↔
        y ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk (π w')) := by
    intro w' y
    rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal]
    exact map_mem_nonunits_iff _ _
  have hspec : ∀ y' : Y', π y' ∈ V → ∀ (q : ℕ) (h : Fin q → Y.presheaf.stalk (π y')),
      ((∀ (w' : Y') (hw : w' ⤳ y'), (w' ∈ ⇑π ⁻¹' B ↔ ∃ i, (Y'.presheaf.stalkSpecializes hw).hom
        ((π.stalkMap y').hom (h i)) ∈ IsLocalRing.maximalIdeal (Y'.presheaf.stalk w'))) ↔
       (∀ (w : Y) (hw : w ⤳ π y'), (w ∈ B ↔ ∃ i, (Y.presheaf.stalkSpecializes hw).hom (h i) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk w)))) := by
    intro y' hy q h
    constructor
    · intro H' w hw
      obtain ⟨w', hw', rfl⟩ := hlift y' hy w hw
      have h3 := H' w' hw'
      simp only [hE, hM] at h3
      exact h3
    · intro H w' hw
      have h3 := H (π w') (hw.map π.continuous)
      simp only [hE, hM]
      exact h3

  refine ⟨hsurj, hinj, fun y' hy => ?_⟩
  have := hst y' hy
  let φ : Y.presheaf.stalk (π y') ≃+* Y'.presheaf.stalk y' :=
    (asIso (π.stalkMap y')).commRingCatIsoToRingEquiv
  have hφ : ∀ r, φ r = (π.stalkMap y').hom r := fun r => rfl
  have hφφ : ∀ x, (π.stalkMap y').hom (φ.symm x) = x := fun x => φ.apply_symm_apply x
  obtain ⟨Φ, hc⟩ := hadic (IsLocalRing.maximalIdeal (Y.presheaf.stalk (π y')))
    (IsLocalRing.maximalIdeal (Y'.presheaf.stalk y')) φ (IsLocalRing.map_ringEquiv_maximalIdeal φ)
  have hcs : ∀ r', Φ.symm (algebraMap (Y'.presheaf.stalk y')
      (AdicCompletion (IsLocalRing.maximalIdeal (Y'.presheaf.stalk y')) (Y'.presheaf.stalk y')) r') =
      algebraMap (Y.presheaf.stalk (π y'))
      (AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk (π y'))) (Y.presheaf.stalk (π y')))
      (φ.symm r') := by
    intro r'
    rw [RingEquiv.symm_apply_eq, hc, RingEquiv.apply_symm_apply]
  have hfw : ∀ (q : ℕ) (h : Fin q → Y.presheaf.stalk (π y')),
      (∀ (w : Y) (hw : w ⤳ π y'), (w ∈ B ↔ ∃ i, (Y.presheaf.stalkSpecializes hw).hom (h i) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk w))) →
      (∀ (w' : Y') (hw : w' ⤳ y'), (w' ∈ ⇑π ⁻¹' B ↔ ∃ i, (Y'.presheaf.stalkSpecializes hw).hom
        (φ (h i)) ∈ IsLocalRing.maximalIdeal (Y'.presheaf.stalk w'))) := by
    intro q h H0
    simp only [hφ]
    exact (hspec y' hy q h).mpr H0
  have hbw : ∀ (q : ℕ) (h : Fin q → Y'.presheaf.stalk y'),
      (∀ (w' : Y') (hw : w' ⤳ y'), (w' ∈ ⇑π ⁻¹' B ↔ ∃ i, (Y'.presheaf.stalkSpecializes hw).hom
        (h i) ∈ IsLocalRing.maximalIdeal (Y'.presheaf.stalk w'))) →
      (∀ (w : Y) (hw : w ⤳ π y'), (w ∈ B ↔ ∃ i, (Y.presheaf.stalkSpecializes hw).hom
        (φ.symm (h i)) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk w))) := by
    intro q h H0
    refine (hspec y' hy q (fun i => φ.symm (h i))).mp ?_
    simp only [hφφ]
    exact H0
  have hP : ∀ w' : Y', w' ⤳ y' → π w' ∈ V := fun w' hw =>
    V.isOpen.stableUnderGeneralization (hw.map π.continuous) hy
  refine ⟨hreg y' hy, (ringKrullDim_eq_of_ringEquiv φ).symm,
    ⟨fun h => torpt1 y' (π y') (⇑π ⁻¹' B) B φ.symm Φ.symm hcs hbw h,
      fun h => torpt1 (π y') y' B (⇑π ⁻¹' B) φ Φ hc hfw h⟩,
    ⟨fun h => node1 y' (π y') (⇑π ⁻¹' B) B φ.symm Φ.symm hcs hbw h,
      fun h => node1 (π y') y' B (⇑π ⁻¹' B) φ Φ hc hfw h⟩,
    fun w => ⟨fun h => wt1 y' (π y') (⇑π ⁻¹' B) B φ.symm Φ.symm hcs hbw w h,
      fun h => wt1 (π y') y' B (⇑π ⁻¹' B) φ Φ hc hfw w h⟩, ?_⟩

  constructor
  · intro hG
    obtain ⟨hS, hmin⟩ := genD.mp hG
    refine genD.mpr ⟨singD.mpr fun hr => singD.mp hS ((hreg y' hy).mpr hr), ?_⟩
    intro γ' hγ' hsp
    obtain ⟨w', hw', rfl⟩ := hlift y' hy γ' hsp
    have hw'S : w' ∈ wcpaDjSing Y' :=
      singD.mpr fun hr => singD.mp hγ' ((hreg w' (hP w' hw')).mp hr)
    rw [hmin w' hw'S hw']
  · intro hG
    obtain ⟨hS, hmin⟩ := genD.mp hG
    refine genD.mpr ⟨singD.mpr fun hr => singD.mp hS ((hreg y' hy).mp hr), ?_⟩
    intro w' hw' hsp
    have hwV := hP w' hsp
    have hπS : π w' ∈ wcpaDjSing Y :=
      singD.mpr fun hr => singD.mp hw' ((hreg w' hwV).mpr hr)
    exact hinj hwV hy (hmin (π w') hπS (hsp.map π.continuous))

theorem wcpa_dj_sfc_radical_extend_geom : ∀ (k : Type u) [Field k] (Z : Scheme.{u}) (sZ : Z ⟶ Spec (.of k)) [LocallyOfFiniteType sZ] (z : Z) (𝔭 : Ideal (Z.presheaf.stalk z)), 𝔭.IsRadical → (𝔭.map (algebraMap (Z.presheaf.stalk z) (AdicCompletion (IsLocalRing.maximalIdeal (Z.presheaf.stalk z)) (Z.presheaf.stalk z)))).IsRadical :=
by
  intro k _ Z sZ _ z 𝔭 h𝔭
  classical

  have s3 : ∀ (P B : Type u) [CommRing P] [CommRing B] [Algebra P B] [IsNoetherianRing P]
      [Module.Flat P B],
      (∀ (𝔭 : Ideal P) [𝔭.IsPrime], _root_.IsReduced (TensorProduct P 𝔭.ResidueField B)) →
      ∀ (I : Ideal P), I.IsRadical → (I.map (algebraMap P B)).IsRadical := by
    intro P B _ _ _ _ _ hfib I hI
    have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing P I
    haveI : Fintype I.minimalPrimes := hfin.fintype
    have hpr : ∀ q : I.minimalPrimes, (q : Ideal P).IsPrime := fun q => q.2.1.1
    have hle : ∀ q : I.minimalPrimes, I ≤ (q : Ideal P) := fun q => q.2.1.2
    have hd : ∀ (q : I.minimalPrimes) (b : B), b ∈ I.map (algebraMap P B) →
        (1 : (q : Ideal P).ResidueField) ⊗ₜ[P] b = 0 := by
      intro q b hb
      haveI := hpr q
      have hsub : I.map (algebraMap P B) ≤ RingHom.ker
          (Algebra.TensorProduct.includeRight (R := P) (A := (q : Ideal P).ResidueField)
            (B := B)).toRingHom := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        rw [Ideal.mem_comap, RingHom.mem_ker]
        show (1 : (q : Ideal P).ResidueField) ⊗ₜ[P] algebraMap P B a = 0
        rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul,
          ← Algebra.algebraMap_eq_smul_one,
          (Ideal.algebraMap_residueField_eq_zero).mpr (hle q ha), TensorProduct.zero_tmul]
      exact hsub hb
    let ρ : P ⧸ I →ₐ[P] ((q : I.minimalPrimes) → (q : Ideal P).ResidueField) :=
      Ideal.Quotient.liftₐ I (AlgHom.pi fun q => Algebra.ofId P (q : Ideal P).ResidueField) (by
        intro a ha
        funext q
        haveI := hpr q
        exact (Ideal.algebraMap_residueField_eq_zero).mpr (hle q ha))
    have hρ : Function.Injective ρ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [Ideal.Quotient.eq_zero_iff_mem]
      have hrad : a ∈ I.radical := by
        rw [← Ideal.sInf_minimalPrimes, Submodule.mem_sInf]
        intro q hq
        haveI : Ideal.IsPrime q := hpr ⟨q, hq⟩
        have := congrFun hx ⟨q, hq⟩
        exact (Ideal.algebraMap_residueField_eq_zero).mp this
      exact hI hrad
    have hinj := Module.Flat.lTensor_preserves_injective_linearMap (M := B) ρ.toLinearMap hρ
    have hc : ∀ b : B, (∀ q : I.minimalPrimes, (1 : (q : Ideal P).ResidueField) ⊗ₜ[P] b = 0) →
        b ∈ I.map (algebraMap P B) := by
      intro b hb
      have h1 : (ρ.toLinearMap.lTensor B) (b ⊗ₜ[P] (1 : P ⧸ I)) = 0 := by
        rw [LinearMap.lTensor_tmul]
        apply (Algebra.TensorProduct.piRight P P B
          (fun q : I.minimalPrimes => (q : Ideal P).ResidueField)).injective
        rw [map_zero, Algebra.TensorProduct.piRight_tmul]
        funext q
        rw [Pi.zero_apply, AlgHom.toLinearMap_apply, map_one, Pi.one_apply]
        have := Algebra.TensorProduct.comm_tmul P (1 : (q : Ideal P).ResidueField) b
        rw [hb q, map_zero] at this
        exact this.symm
      have h2 : b ⊗ₜ[P] (1 : P ⧸ I) = 0 := hinj (h1.trans (map_zero _).symm)
      have h3 := Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk B I b
      rw [h2, ← map_zero (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I)] at h3
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      exact (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).injective h3
    intro x ⟨n, hn⟩
    apply hc
    intro q
    haveI := hpr q
    have h1 := hd q _ hn
    have h2 : ((1 : (q : Ideal P).ResidueField) ⊗ₜ[P] x) ^ n = 0 := by
      rw [← h1, Algebra.TensorProduct.tmul_pow, one_pow]
    exact IsReduced.eq_zero _ ⟨n, h2⟩

  have s4 : ∀ (T : Type u) [CommRing T],
      (∀ (𝔔 : Ideal T) [𝔔.IsPrime], IsRegularLocalRing (Localization.AtPrime 𝔔)) →
      _root_.IsReduced T := by
    intro T _ hT
    refine isReduced_ofLocalizationMaximal T (fun J hJ => ?_)
    haveI : J.IsPrime := hJ.isPrime
    haveI := wcpa_regular_isDomain (Localization.AtPrime J) wcpa_rs_quotient_regular (hT J)
    infer_instance

  have trunc : ∀ {X : Type u} [CommRing X] (I : Ideal X) {m k : ℕ} (hle : m ≤ k)
      (x : AdicCompletion I X),
      Ideal.Quotient.factorPow I hle (AdicCompletion.evalₐ I k x) =
        AdicCompletion.evalₐ I m x := by
    intro X _ I m k hle x
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective I X x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk]
    have h1 := AdicCompletion.AdicCauchySequence.mk_eq_mk (I := I) (M := X) hle f
    have h2 := (Submodule.Quotient.eq _).mp h1
    change Ideal.Quotient.mk (I ^ m) (f k) = Ideal.Quotient.mk (I ^ m) (f m)
    rw [Ideal.Quotient.eq]
    simpa [smul_eq_mul, Ideal.mul_top] using h2
  have evAlg : ∀ {X : Type u} [CommRing X] (I : Ideal X) (k : ℕ) (a : X),
      AdicCompletion.evalₐ I k (algebraMap X (AdicCompletion I X) a) =
        Ideal.Quotient.mk (I ^ k) a := by
    intro X _ I k a
    rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]
    rfl
  have hlev : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (f : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B,
        ∀ (k : ℕ) (x : AdicCompletion (IsLocalRing.maximalIdeal A) A) (a : A),
          AdicCompletion.evalₐ _ k x = Ideal.Quotient.mk _ a →
          AdicCompletion.evalₐ _ k (Φ x) = Ideal.Quotient.mk _ (f a) := by
    intro A B _ _ _ _ f
    have hle : ∀ k, IsLocalRing.maximalIdeal A ^ k ≤
        Ideal.comap f.toRingHom (IsLocalRing.maximalIdeal B ^ k) := by
      intro k
      rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow,
        IsLocalRing.map_maximalIdeal_of_surjective f.toRingHom f.surjective]
    let ιb : ∀ k, A ⧸ IsLocalRing.maximalIdeal A ^ k →+* B ⧸ IsLocalRing.maximalIdeal B ^ k :=
      fun k => Ideal.quotientMap _ f.toRingHom (hle k)
    have hιb : ∀ k (a : A), ιb k (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (f a) :=
      fun k a => Ideal.quotientMap_mk
    refine ⟨AdicCompletion.liftRingHom (IsLocalRing.maximalIdeal B)
      (fun k => (ιb k).comp (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) k).toRingHom)
      ?_, ?_⟩
    · intro m k hmk
      refine RingHom.ext fun x => ?_
      change Ideal.Quotient.factorPow _ hmk (ιb k (AdicCompletion.evalₐ _ k x)) =
        ιb m (AdicCompletion.evalₐ _ m x)
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) k x)
      rw [← trunc _ hmk x, ← ha, hιb]
      rfl
    · intro k x a hx
      rw [AdicCompletion.evalₐ_liftRingHom]
      change ιb k (AdicCompletion.evalₐ _ k x) = _
      rw [hx, hιb]
  have hcmp : ∀ (P O : Type u) [CommRing P] [CommRing O] [IsLocalRing P] [IsLocalRing O]
      (e : P ≃+* O), ∃ (Φ : AdicCompletion (IsLocalRing.maximalIdeal P) P →+*
        AdicCompletion (IsLocalRing.maximalIdeal O) O)
        (Ψ : AdicCompletion (IsLocalRing.maximalIdeal O) O →+*
          AdicCompletion (IsLocalRing.maximalIdeal P) P),
        Φ.comp (algebraMap P _) = (algebraMap O _).comp e.toRingHom ∧
        Ψ.comp (algebraMap O _) = (algebraMap P _).comp e.symm.toRingHom ∧
        ∀ x, Φ (Ψ x) = x := by
    intro P O _ _ _ _ e
    obtain ⟨Φ, hΦ⟩ := hlev P O e
    obtain ⟨Ψ, hΨ⟩ := hlev O P e.symm
    refine ⟨Φ, Ψ, ?_, ?_, ?_⟩
    · refine RingHom.ext fun p => ?_
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [RingHom.comp_apply, RingHom.comp_apply, hΦ k _ p (evAlg _ k p), evAlg]
      rfl
    · refine RingHom.ext fun p => ?_
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [RingHom.comp_apply, RingHom.comp_apply, hΨ k _ p (evAlg _ k p), evAlg]
      rfl
    · intro x
      apply AdicCompletion.ext_evalₐ
      intro k
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal O) k x)
      rw [hΦ k _ _ (hΨ k x b hb.symm), hb.symm, RingEquiv.apply_symm_apply]

  have hSurj : ∀ (B : Type u) [CommRing B] (S : Type u) [CommRing S] (f : B →+* S),
      Function.Surjective f → wcGRing B → wcGRing S :=
    wc_hnas_pfc_gring_of_surjective wc_hnas_pfc_completion_surj_base_change
  have hPoly : ∀ (B : Type u) [CommRing B], wcGRing B → wcGRing (Polynomial B) :=
    wc_hnas_pfc_gring_polynomial wc_hnas_pfc_regular_flat_ascent
      wc_hnas_pfc_regular_flat_descent wc_hnas_pfc_regular_localization
      wc_hnas_pfc_completion_surj_base_change
      (wc_hnas_pfc_gring_complete_local wc_hnas_pfc_regular_flat_ascent
        wc_hnas_pfc_regular_flat_descent wc_hnas_pfc_regular_localization
        wc_hnas_pfc_completion_surj_base_change)
      (wc_hnas_pfc_poly_complete_fibres wc_hnas_pfc_regular_flat_ascent
        wc_hnas_pfc_regular_flat_descent wc_hnas_pfc_regular_localization
        wc_hnas_pfc_completion_surj_base_change)
  have hGk : wcGRing k := by
    unfold wcGRing
    refine ⟨inferInstance, ?_⟩
    intro 𝔪 _ Λ _ _ hΛ 𝔓 _ L _ _ _ _ _ 𝔔 _
    have hm : IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪) = ⊥ := by
      rw [← Localization.AtPrime.map_eq_maximalIdeal, eq_bot_iff, Ideal.map_le_iff_le_comap]
      intro a ha
      have h0 : a = 0 := by
        have h𝔪 : 𝔪 = ⊥ := Ideal.eq_bot_of_prime 𝔪
        rw [h𝔪] at ha
        exact (Ideal.mem_bot).mp ha
      rw [h0, Ideal.mem_comap, map_zero]
      exact Ideal.zero_mem _
    exact wc_hnas_pfc_fibres_of_field (Localization.AtPrime 𝔪) hm Λ hΛ 𝔓 L 𝔔
  have claim : ∀ n : ℕ, wcGRing (MvPolynomial (Fin n) k) := by
    intro n
    induction n with
    | zero =>
      exact hSurj k _ (MvPolynomial.isEmptyRingEquiv k (Fin 0)).symm.toRingHom
        (MvPolynomial.isEmptyRingEquiv k (Fin 0)).symm.surjective hGk
    | succ n ih =>
      exact hSurj _ _ (MvPolynomial.finSuccEquiv k n).symm.toRingEquiv.toRingHom
        (MvPolynomial.finSuccEquiv k n).symm.surjective (hPoly _ ih)

  obtain ⟨W, hW, hzW, -⟩ := exists_isAffineOpen_mem_and_subset
    (show z ∈ (⊤ : Z.Opens) from trivial)
  have hft : RingHom.FiniteType (sZ.appLE ⊤ W le_top).hom :=
    HasRingHomProperty.appLE @LocallyOfFiniteType sZ inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨W, hW⟩ le_top
  have hinvs : Function.Surjective (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom := by
    intro y
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom y, ?_⟩
    simp
  have hφ : RingHom.FiniteType ((sZ.appLE ⊤ W le_top).hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom) :=
    hft.comp (RingHom.FiniteType.of_surjective _ hinvs)
  letI : Algebra k Γ(Z, W) := ((sZ.appLE ⊤ W le_top).hom.comp
      (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom).toAlgebra
  haveI : Algebra.FiniteType k Γ(Z, W) := hφ
  obtain ⟨n, g, hg⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
    (inferInstance : Algebra.FiniteType k Γ(Z, W))
  have hGR : wcGRing Γ(Z, W) := hSurj _ _ g.toRingHom hg (claim n)
  haveI : IsNoetherianRing Γ(Z, W) := hGR.1
  set 𝔮 : Ideal Γ(Z, W) := (hW.primeIdealOf ⟨z, hzW⟩).asIdeal with h𝔮def
  letI : Algebra Γ(Z, W) (Z.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hzW⟩
  haveI : IsLocalization.AtPrime (Z.presheaf.stalk z) 𝔮 := hW.isLocalization_stalk ⟨z, hzW⟩
  let e : Localization.AtPrime 𝔮 ≃+* Z.presheaf.stalk z :=
    (IsLocalization.algEquiv 𝔮.primeCompl (Localization.AtPrime 𝔮)
      (Z.presheaf.stalk z)).toRingEquiv

  have hfib : ∀ (𝔓 : Ideal (Localization.AtPrime 𝔮)) [𝔓.IsPrime],
      _root_.IsReduced (TensorProduct (Localization.AtPrime 𝔮) 𝔓.ResidueField
        (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮))
          (Localization.AtPrime 𝔮))) := by
    intro 𝔓 _
    have hred := s4 (TensorProduct (Localization.AtPrime 𝔮) 𝔓.ResidueField
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮))
        (Localization.AtPrime 𝔮)))
      (fun 𝔔 _ => hGR.2 𝔮 _ ⟨AlgEquiv.refl⟩ 𝔓 𝔓.ResidueField 𝔔)
    exact hred

  set 𝔭' : Ideal (Localization.AtPrime 𝔮) := 𝔭.comap e.toRingHom with h𝔭'def
  have hJ := s3 (Localization.AtPrime 𝔮)
    (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮))
      (Localization.AtPrime 𝔮)) hfib 𝔭' (h𝔭.comap e.toRingHom)

  obtain ⟨Φ, Ψ, hΦ, hΨ, hΦΨ⟩ := hcmp (Localization.AtPrime 𝔮) (Z.presheaf.stalk z) e
  intro x ⟨m, hm⟩
  have h1 : Ψ x ∈ 𝔭'.map (algebraMap (Localization.AtPrime 𝔮)
      (AdicCompletion (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮))
        (Localization.AtPrime 𝔮))) := by
    apply hJ
    refine ⟨m, ?_⟩
    rw [← map_pow]
    have h2 := Ideal.mem_map_of_mem Ψ hm
    rw [Ideal.map_map, hΨ, ← Ideal.map_map] at h2
    refine Ideal.map_mono ?_ h2
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, h𝔭'def, Ideal.mem_comap]
    simpa using ha
  have h3 := Ideal.mem_map_of_mem Φ h1
  rw [hΦΨ, Ideal.map_map, hΦ, ← Ideal.map_map] at h3
  exact Ideal.map_mono Ideal.map_comap_le h3

theorem wcpa_dj_rtsxc_ci_stalk_loc_regular : ∀ (X : Scheme.{u}) (x z : X) (h : x ⤳ z), IsRegularLocalRing (X.presheaf.stalk x) ↔ IsRegularLocalRing (Localization.AtPrime (Ideal.comap (X.presheaf.stalkSpecializes h).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x)))) :=
by
  intro X x z h
  letI : Algebra (X.presheaf.stalk z) (X.presheaf.stalk x) :=
    (X.presheaf.stalkSpecializes h).hom.toAlgebra
  have isLoc : ∀ (X : Scheme.{u}) (x z : X) (h : x ⤳ z),
      letI := (X.presheaf.stalkSpecializes h).hom.toAlgebra
      IsLocalization.AtPrime (X.presheaf.stalk x)
        ((IsLocalRing.maximalIdeal (X.presheaf.stalk x)).comap
          (X.presheaf.stalkSpecializes h).hom) := by
    intro X x z h
    have key : ∀ (A R S : Type u) [CommRing A] [CommRing R] [CommRing S] [IsLocalRing S]
        (gR : A →+* R) (gS : A →+* S) (φ : R →+* S), φ.comp gR = gS →
        ∀ (P Q : Ideal A) [P.IsPrime] [Q.IsPrime],
        @IsLocalization.AtPrime A _ R _ gR.toAlgebra P _ →
        @IsLocalization.AtPrime A _ S _ gS.toAlgebra Q _ →
        letI := φ.toAlgebra; IsLocalization.AtPrime S ((IsLocalRing.maximalIdeal S).comap φ) := by
      intro A R S _ _ _ _ gR gS φ hcomp P Q _ _ hR hS
      letI : Algebra A R := gR.toAlgebra
      letI : Algebra A S := gS.toAlgebra
      letI : Algebra R S := φ.toAlgebra
      have hc : ∀ a, φ (gR a) = gS a := fun a => by rw [← hcomp]; rfl
      haveI : IsScalarTower A R S := IsScalarTower.of_algebraMap_eq (fun a => (hc a).symm)
      have hle : P.primeCompl ≤ Q.primeCompl := by
        intro a ha haQ
