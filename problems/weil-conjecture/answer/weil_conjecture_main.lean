    simp only [Set.union_empty, Set.singleton_union]

  have hnzd : ∀ k : Fin 3, (![Ideal.Quotient.mk (Ideal.span {x * y - v * s ^ w}) x,
        Ideal.Quotient.mk (Ideal.span {x * y - v * s ^ w}) y,
