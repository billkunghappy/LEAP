  have hA' : π₅ ≫ Limits.pullback.snd g ρ ≫ ρ ≫ sS = A ≫ wcProjKStr k N := hA
  obtain ⟨VC, hVC, hcV, hint⟩ := wcpa_dj_glt_ccg_chart_integral k N (Limits.pullback g ρ) C
    (Limits.pullback.snd g ρ ≫ ρ ≫ sS) π₅ A hA' hLfin k₀ c hc
