  rw [key, e1] at hmem
  have h1 : Nl.det ∈ IsLocalRing.maximalIdeal O := (hφ _).mp hmem
  have e2 : (Nl.map (IsLocalRing.residue O)).det = IsLocalRing.residue O Nl.det :=
