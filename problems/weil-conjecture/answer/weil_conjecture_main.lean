  obtain ⟨sU, hsU⟩ : ∃ sU : Fin n → Γ(Y₂, V)ˣ, ∀ l, ((sU l : Γ(Y₂, V)ˣ) : Γ(Y₂, V)) =
      (h.appLE U V hle).hom (ss l) := ⟨fun l => (hss l).unit, fun l => (hss l).unit_spec⟩
  obtain ⟨κ₀, hκ₀⟩ : ∃ κ₀ : Γ(Y₂, V)ˣ, κ₀ = vt * ∏ l, sU l ^ ℓ l := ⟨_, rfl⟩
  obtain ⟨ρT, hρT⟩ : ∃ ρT : Fin n → Γ(Y₂, V), ∀ l, ρT l =
