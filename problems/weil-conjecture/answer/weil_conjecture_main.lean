theorem wcpa_dj_glt_st_twist_ideals : ∀ (D : Type u) [CommRing D] [IsLocalRing D] [IsNoetherianRing D]
    (P : Ideal (Polynomial (AdicCompletion (IsLocalRing.maximalIdeal D) D))) [P.IsPrime],
