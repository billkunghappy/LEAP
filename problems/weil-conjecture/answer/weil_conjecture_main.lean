      (∀ i ∈ I, wcpaDjStcRatioLink (wcpaDjStcRatioSec k (Limits.pullback.fst g ρ ⁻¹ᵁ O)
          ((Limits.pullback.fst g ρ ∣_ O) ≫ a) i₀ i) (π₅ c) (num i) (den i)) →
