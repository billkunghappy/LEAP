  have hclosed' : ∀ k : Fin (n + 2), Ideal.Quotient.mk (wcpaDjP2mIdeal K n V b) (MvPowerSeries.X k) ∈
      P'.comap (algebraMap (wcpaDjP2mRing K n V b)
        (wcpaDjChartAlg (wcpaDjP2mRing K n V b) (fun l => e₁ (φ l)) i)) := by
