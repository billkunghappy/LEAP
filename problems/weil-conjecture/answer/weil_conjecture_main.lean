    let x : ↥(π₅ ⁻¹ᵁ (Limits.pullback.fst g ρ ⁻¹ᵁ O)).toScheme := ⟨genericPoint C, hξO⟩
    have e : A ((π₅ ⁻¹ᵁ (Limits.pullback.fst g ρ ⁻¹ᵁ O)).ι x) =
