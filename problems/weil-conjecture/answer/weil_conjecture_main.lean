  obtain ⟨l₀, m₀, hlm, hTeq⟩ := Finset.card_eq_two.mp hT
  have hbl : b l₀ = 1 := hb l₀ (by rw [hTeq]; simp)
  have hbm : b m₀ = 1 := hb m₀ (by rw [hTeq]; simp)

  have hccG : MvPowerSeries.constantCoeff (MvPowerSeries.X 0 * MvPowerSeries.X 1 -
