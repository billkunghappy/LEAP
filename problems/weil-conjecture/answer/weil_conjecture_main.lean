          (wcpaDjChartGen _ _ 2 1) rfl (hψnzd 2) (hψnzd 1)
          (IsLocalization.mk'_spec (Localization.Away _) _ _) h1
        haveI := hQ₁prime
        haveI := wcpa_dj_rtsxs_d_axis_chart_regular A n x y v σ b l₀ 1 Q₁ hv hdimA hspanA hb
