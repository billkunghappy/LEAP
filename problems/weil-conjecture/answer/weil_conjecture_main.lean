  have hC' : IsRegularLocalRing (O ⧸ Ideal.span (Set.range x)) := hC
  haveI := hC'
  have hM : (IsLocalRing.maximalIdeal O).map (Ideal.Quotient.mk (Ideal.span (Set.range x))) =
