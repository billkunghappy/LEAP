      haveI : IsRegularLocalRing (Localization.AtPrime Q) :=
        IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime Q₀) Θ₀.symm
      exact hnotreg (IsRegularLocalRing.of_ringEquiv (R := Localization.AtPrime Q) Θ.symm)
  ·
    exfalso
