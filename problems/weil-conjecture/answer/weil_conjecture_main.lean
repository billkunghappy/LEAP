        exact ⟨εB.toMulEquiv.isDomain, IsIntegrallyClosed.of_equiv εB.symm⟩
      · haveI := hPI
        obtain ⟨hD, hIC⟩ := wcpa_dj_glt_cc_lc_smooth_normal O₀ hreg P hP
        haveI := hD
        haveI := hIC
