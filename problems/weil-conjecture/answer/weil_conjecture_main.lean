  have hgen : ∀ l : Fin 3, l ≠ 2 → ∀ c' : wcpaDjChartAlg (A ⧸ Ideal.span {x * y - v * s ^ w})
      ![Ideal.Quotient.mk (Ideal.span {x * y - v * s ^ w}) x,
