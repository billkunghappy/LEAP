  classical
  intro j 𝔔 _ h𝔔
  have hgam : ∀ (B : Type u) [CommRing B] [IsLocalRing B]
      [Algebra (wcpaDjChartAlg (wcpaDjP1Ring A x y v σ b) (wcpaDjP2Gen A x y v σ b l l') j) B]
