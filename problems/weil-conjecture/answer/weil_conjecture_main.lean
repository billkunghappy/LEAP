        (IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime Q')
          (Localization.AtPrime (Q'.comap (θ.symm : A₂ →+* A₁))) θ hmap).symm
  have dq : ∀ (A : Type u) [CommRing A] (I : Ideal A) (x : A) (y : A ⧸ I),
