  obtain ⟨Tr, hTr⟩ : ∃ Tr : Y₂.presheaf.stalk (σ p) →+* (Spec (CommRingCat.of (Polynomial Γ(Y₂, V) ⧸ wcpaDjGslcIdeal g a τ))).presheaf.stalk c',
