        IsLocalRing.maximalIdeal (Y.presheaf.stalk (π y')) ^ 1) :=
      Ideal.Quotient.nontrivial_iff.mpr (by
        rw [pow_one]; exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top)
