theorem wcpa_dj_rtsxc_p1_node (A : Type u) [CommRing A] [IsRegularLocalRing A]
    [IsAdicComplete (IsLocalRing.maximalIdeal A) A] (n : ℕ) (x y v : A) (σ : Fin n → A)
