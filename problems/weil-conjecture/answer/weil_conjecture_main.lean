  refine ⟨?_, ?_⟩
  · have h0 : den ≠ 0 := nonZeroDivisors.ne_zero hden
    have h1 : (f.stalkMap y').hom den ≠ 0 := (map_ne_zero_iff _ hinj).mpr h0
    exact mem_nonZeroDivisors_of_ne_zero h1
