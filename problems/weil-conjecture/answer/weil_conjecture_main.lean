      rfl
    | add p q hp hq =>
      rw [map_add, Subalgebra.coe_add, hp, hq, MvPolynomial.eval₂_add]
    | mul_X p n hp =>
      rw [map_mul, Subalgebra.coe_mul, hp, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, hθX]
      congr 1
      fin_cases n <;> rfl
  have hZT : ∀ q, θ q = 0 ↔ MvPolynomial.eval₂ φ u q = 0 := by
    intro q
