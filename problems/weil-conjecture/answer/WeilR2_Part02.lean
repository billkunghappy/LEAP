import WeilR2_Part01
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_cech_acyclic_of_ring_model : ∀ (Y : Scheme.{u}) (U V : Y.Etale) (g : V ⟶ U) (κ M : Type u) [Field κ] [Field M] [Algebra κ M] (R : ∀ n : ℕ, Γ((Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g)).left, ⊤) →+* ((Fin (n + 1) → Gal(M/κ)) → M)), (∀ n, Function.Injective (R n)) → (∀ (n : ℕ) (s : Γ((Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g)).left, ⊤)) (σ : Gal(M/κ)) (h : Fin (n + 1) → Gal(M/κ)), R n s (fun l => σ * h l) = σ (R n s h)) → (∀ (n : ℕ) (ψ : (Fin (n + 1) → Gal(M/κ)) → Mˣ), (∀ (σ : Gal(M/κ)) (h : Fin (n + 1) → Gal(M/κ)), ψ (fun l => σ * h l) = σ • ψ h) → ∃ r : (Γ((Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g)).left, ⊤))ˣ, ∀ h, R n (r : Γ((Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g)).left, ⊤)) h = (ψ h : M)) → (∀ (n m : ℕ) (ρ : Fin (m + 1) → Fin (n + 1)) (q : Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g) ⟶ Limits.widePullback U (fun _ : Fin (m + 1) => V) (fun _ => g)), (∀ l : Fin (m + 1), q ≫ Limits.WidePullback.π (fun _ : Fin (m + 1) => g) l = Limits.WidePullback.π (fun _ : Fin (n + 1) => g) (ρ l)) → ∀ (s : Γ((Limits.widePullback U (fun _ : Fin (m + 1) => V) (fun _ => g)).left, ⊤)) (h : Fin (n + 1) → Gal(M/κ)), R n (q.left.appTop s) h = R m s (fun l => h (ρ l))) → wcGrpCohVanish Gal(M/κ) Mˣ → wcCechAcyclic (wcEtGmPre Y) (fun _ : Fin 1 => V) (fun _ => g) :=
by
  intro Y U V g κ M _ _ _ R h1 h2 h3 h4 hv
  let W : ℕ → Y.Etale := fun n => Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g)
  let Φ : ∀ n : ℕ, (Γ((W n).left, ⊤))ˣ →* ((Fin (n + 1) → Gal(M/κ)) → Mˣ) :=
    fun n => MulEquiv.piUnits.toMonoidHom.comp (Units.map (R n).toMonoidHom)
  have hΦinj : ∀ n, Function.Injective (Φ n) := by
    intro n a b hab
    apply Units.ext
    apply h1 n
    funext h
    exact congrArg (fun F => ((F h : Mˣ) : M)) hab
  let D : ∀ p : ℕ, Fin (p + 2) → ((Γ((W p).left, ⊤))ˣ →* (Γ((W (p + 1)).left, ⊤))ˣ) :=
    fun p j => Units.map (wcCechFace (fun _ : Fin 1 => V) (fun _ => g)
      (fun _ : Fin (p + 2) => (0 : Fin 1)) j).left.appTop.hom.toMonoidHom
  have hD : ∀ (p : ℕ) (j : Fin (p + 2)) (w : (Γ((W p).left, ⊤))ˣ) (h : Fin (p + 1 + 1) → Gal(M/κ)),
      Φ (p + 1) (D p j w) h = Φ p w (fun l => h (j.succAbove l)) := by
    intro p j w h
    apply Units.ext
    exact h4 (p + 1) p j.succAbove (wcCechFace (fun _ : Fin 1 => V) (fun _ => g)
      (fun _ : Fin (p + 2) => (0 : Fin 1)) j)
      (fun l => Limits.WidePullback.lift_π _ _ _ _ l)
      (w : Γ((W p).left, ⊤)) h
  let E : ∀ X : Y.Etale, (wcEtGmPre Y).obj (Opposite.op X) ≃+ Additive (Γ(X.left, ⊤))ˣ :=
    fun X => AddEquiv.ulift
  have hsum : ∀ (X : Y.Etale) (n : ℕ) (z : Fin n → ℤ) (x : Fin n → (wcEtGmPre Y).obj (Opposite.op X)),
      Additive.toMul (E X (∑ j, z j • x j)) = ∏ j, (Additive.toMul (E X (x j))) ^ z j := by
    intro X n z x
    rw [map_sum, toMul_sum]
    simp only [map_zsmul, toMul_zsmul]
  intro p c hc
  let u : (Γ((W (p + 1)).left, ⊤))ˣ := Additive.toMul (E (W (p + 1)) (c (fun _ => 0)))
  have hu : ∏ j : Fin (p + 3), (D (p + 1) j u) ^ ((-1 : ℤ) ^ (j : ℕ)) = 1 := by
    have e1 := congrArg (fun x => Additive.toMul (E (W (p + 2)) x)) (hc (fun _ => 0))
    have e2 := hsum (W (p + 2)) (p + 3) (fun j => (-1 : ℤ) ^ (j : ℕ))
      (fun j => (wcEtGmPre Y).map (wcCechFace (fun _ : Fin 1 => V) (fun _ => g)
        (fun _ : Fin (p + 3) => (0 : Fin 1)) j).op (c (fun _ => 0)))
    exact e2.symm.trans (e1.trans (by simp only [map_zero, toMul_zero]))
  let φ : (Fin (p + 2) → Gal(M/κ)) → Mˣ := Φ (p + 1) u
  have hφe : ∀ (σ : Gal(M/κ)) (h : Fin (p + 2) → Gal(M/κ)), φ (fun l => σ * h l) = σ • φ h := by
    intro σ h
    apply Units.ext
    exact h2 (p + 1) (u : Γ((W (p + 1)).left, ⊤)) σ h
  have hφc : ∀ h : Fin (p + 3) → Gal(M/κ),
      ∏ j : Fin (p + 3), φ (fun l => h (j.succAbove l)) ^ ((-1 : ℤ) ^ (j : ℕ)) = 1 := by
    intro h
    have e := congrArg (fun w => Φ (p + 1 + 1) w h) hu
    simp only [map_prod, map_zpow, map_one, Finset.prod_apply, Pi.pow_apply, Pi.one_apply,
      hD] at e
    exact e
  obtain ⟨ψ, hψe, hψd⟩ := hv p φ hφe hφc
  obtain ⟨r, hr⟩ := h3 p ψ hψe
  have hΦr : Φ p r = ψ := by
    funext h
    apply Units.ext
    exact hr h
  have hcob : ∏ j : Fin (p + 2), (D p j r) ^ ((-1 : ℤ) ^ (j : ℕ)) = u := by
    apply hΦinj (p + 1)
    funext h
    simp only [map_prod, map_zpow, Finset.prod_apply, Pi.pow_apply, hD, hΦr]
    exact hψd h
  refine ⟨fun σ => (E (W p)).symm (Additive.ofMul r), ?_⟩
  intro τ
  obtain rfl : τ = fun _ => 0 := Subsingleton.elim _ _
  refine (E (W (p + 1))).injective (Additive.toMul.injective ?_)
  refine (hsum (W (p + 1)) (p + 2) (fun j => (-1 : ℤ) ^ (j : ℕ))
      (fun j => (wcEtGmPre Y).map (wcCechFace (fun _ : Fin 1 => V) (fun _ => g)
        (fun _ : Fin (p + 2) => (0 : Fin 1)) j).op ((E (W p)).symm (Additive.ofMul r)))).trans ?_
  exact hcob

theorem wc_et_gm_cech_galois : ∀ (Y : Scheme.{u}) (U V : Y.Etale) (g : V ⟶ U) (κ M : Type u) [Field κ] [Field M] [Algebra κ M] [FiniteDimensional κ M] [IsGalois κ M] (a : Spec (.of κ) ⟶ U.left) (e : V.left ≅ Spec (.of M)), Mono a → e.inv ≫ g.left = Spec.map (CommRingCat.ofHom (algebraMap κ M)) ≫ a → wcGrpCohVanish Gal(M/κ) Mˣ → wcCechAcyclic (wcEtGmPre Y) (fun _ : Fin 1 => V) (fun _ => g) :=
by
  intro Y U V g κ M _ _ _ _ _ a e ha he hv

  have s5ii : ∀ (Z : Scheme.{u}) (R : CommRingCat.{u}) (z : Z ⟶ Spec R),
      Z.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso R).inv ≫ z.appTop) = z := by
    intro Z R z
    rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
      ← SpecMap_ΓSpecIso_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
  have s5n : ∀ (Z : Scheme.{u}) (R R' : CommRingCat.{u}) (ψ : R' ⟶ R) (z : Z ⟶ Spec R),
      (Scheme.ΓSpecIso R').inv ≫ (z ≫ Spec.map ψ).appTop =
        ψ ≫ (Scheme.ΓSpecIso R).inv ≫ z.appTop := by
    intro Z R R' ψ z
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
      Category.assoc]

  have hικ' : ∀ (n : ℕ) (l : Fin (n + 1)) (c : κ),
      wcGalEqvIncl κ M (n + 1) l (algebraMap κ M c) =
        wcGalEqvIncl κ M (n + 1) 0 (algebraMap κ M c) := fun n l c =>
    Subtype.ext (funext fun h => ((h l).commutes c).trans ((h 0).commutes c).symm)
  have hικ : ∀ (n : ℕ) (l : Fin (n + 1)),
      CommRingCat.ofHom (algebraMap κ M) ≫ CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l) =
        CommRingCat.ofHom (algebraMap κ M) ≫ CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) 0) := by
    intro n l
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    exact hικ' n l c

  have hJ : ∀ (n : ℕ) (Z : Scheme.{u}) (m m' : Z ⟶ Spec (.of (wcGalEqv κ M (n + 1)))),
      (∀ l : Fin (n + 1), m ≫ Spec.map (CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l)) ≫ e.inv =
        m' ≫ Spec.map (CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l)) ≫ e.inv) → m = m' := by
    intro n Z m m' hmm
    have h1 : ∀ l : Fin (n + 1), CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l) ≫
        ((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫ m.appTop) =
        CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l) ≫
        ((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫ m'.appTop) := by
      intro l
      have h := hmm l
      rw [← Category.assoc, ← Category.assoc] at h
      have h' := (cancel_mono e.inv).1 h
      rw [← s5n Z _ _ (CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l)) m,
        ← s5n Z _ _ (CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l)) m', h']
    obtain ⟨Λ, -, huniq⟩ := wc_galEqv_universal κ M n Γ(Z, ⊤)
      (fun l => (CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l) ≫
        ((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫ m.appTop)).hom)
      (fun l c => congrArg ((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫
        m.appTop).hom (hικ' n l c))
    have e1 : ((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫ m.appTop).hom = Λ :=
      huniq _ (fun l x => rfl)
    have e2 : ((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫ m'.appTop).hom = Λ :=
      huniq _ (fun l x => (congrArg (fun φ => φ.hom x) (h1 l)).symm)
    calc m = _ := (s5ii Z _ m).symm
      _ = _ := by rw [CommRingCat.hom_ext (e1.trans e2.symm)]
      _ = m' := s5ii Z _ m'

  have hX : ∀ (n : ℕ) (Z : Scheme.{u}) (y : Fin (n + 1) → (Z ⟶ V.left)),
      (∀ l, y l ≫ g.left = y 0 ≫ g.left) → ∃ m : Z ⟶ Spec (.of (wcGalEqv κ M (n + 1))),
        ∀ l, m ≫ Spec.map (CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l)) ≫ e.inv = y l := by
    intro n Z y hy
    have hagree : ∀ l, CommRingCat.ofHom (algebraMap κ M) ≫
        ((Scheme.ΓSpecIso (CommRingCat.of M)).inv ≫ (y l ≫ e.hom).appTop) =
        CommRingCat.ofHom (algebraMap κ M) ≫
        ((Scheme.ΓSpecIso (CommRingCat.of M)).inv ≫ (y 0 ≫ e.hom).appTop) := by
      intro l
      have key : (y l ≫ e.hom) ≫ Spec.map (CommRingCat.ofHom (algebraMap κ M)) =
          (y 0 ≫ e.hom) ≫ Spec.map (CommRingCat.ofHom (algebraMap κ M)) := by
        apply (cancel_mono a).1
        simp only [Category.assoc]
        rw [← he, Iso.hom_inv_id_assoc]
        exact hy l
      rw [← s5n Z _ _ (CommRingCat.ofHom (algebraMap κ M)) (y l ≫ e.hom),
        ← s5n Z _ _ (CommRingCat.ofHom (algebraMap κ M)) (y 0 ≫ e.hom), key]
    obtain ⟨Λ, hΛ, -⟩ := wc_galEqv_universal κ M n Γ(Z, ⊤)
      (fun l => ((Scheme.ΓSpecIso (CommRingCat.of M)).inv ≫ (y l ≫ e.hom).appTop).hom)
      (fun l c => congrArg (fun φ => φ.hom c) (hagree l))
    refine ⟨Z.toSpecΓ ≫ Spec.map (CommRingCat.ofHom Λ), fun l => ?_⟩
    have hc : CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l) ≫ CommRingCat.ofHom Λ =
        (Scheme.ΓSpecIso (CommRingCat.of M)).inv ≫ (y l ≫ e.hom).appTop := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro x
      exact hΛ l x
    rw [Category.assoc, ← Category.assoc (Spec.map _), ← Spec.map_comp, hc, ← Category.assoc,
      s5ii, Category.assoc, Iso.hom_inv_id, Category.comp_id]

  have hL : ∀ n : ℕ, Limits.IsLimit ((Scheme.Etale.forget Y ⋙ Over.forget Y).mapCone
      (Limits.limit.cone (Limits.WidePullbackShape.wideCospan U (fun _ : Fin (n + 1) => V)
        (fun _ => g)))) :=
    fun n => Limits.isLimitOfPreserves _ (Limits.limit.isLimit _)
  have hbase : ∀ n : ℕ, (Limits.WidePullback.base (fun _ : Fin (n + 1) => g)).left =
      (Limits.WidePullback.π (fun _ : Fin (n + 1) => g) 0).left ≫ g.left := by
    intro n
    rw [← Limits.WidePullback.π_arrow (fun _ : Fin (n + 1) => g) 0]
    rfl
  have hπ : ∀ (n : ℕ) (l : Fin (n + 1)),
      (Limits.WidePullback.π (fun _ : Fin (n + 1) => g) l).left ≫ g.left =
        (Limits.WidePullback.π (fun _ : Fin (n + 1) => g) 0).left ≫ g.left := by
    intro n l
    rw [← hbase]
    change ((Limits.WidePullback.π (fun _ : Fin (n + 1) => g) l) ≫ g).left = _
    rw [Limits.WidePullback.π_arrow]
  have hWext : ∀ (n : ℕ) (Z : Scheme.{u})
      (m m' : Z ⟶ (Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g)).left),
      (∀ l, m ≫ (Limits.WidePullback.π (fun _ : Fin (n + 1) => g) l).left =
        m' ≫ (Limits.WidePullback.π (fun _ : Fin (n + 1) => g) l).left) → m = m' := by
    intro n Z m m' hmm
    refine (hL n).hom_ext (fun j => ?_)
    cases j with
    | none =>
      change m ≫ (Limits.WidePullback.base (fun _ : Fin (n + 1) => g)).left =
        m' ≫ (Limits.WidePullback.base (fun _ : Fin (n + 1) => g)).left
      rw [hbase, ← Category.assoc, ← Category.assoc, hmm 0]
    | some l => exact hmm l
  have hlift : ∀ (n : ℕ) (Z : Scheme.{u}) (y : Fin (n + 1) → (Z ⟶ V.left)),
      (∀ l, y l ≫ g.left = y 0 ≫ g.left) →
      ∃ m : Z ⟶ (Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g)).left,
        ∀ l, m ≫ (Limits.WidePullback.π (fun _ : Fin (n + 1) => g) l).left = y l := by
    intro n Z y hy
    exact ⟨(hL n).lift (Limits.WidePullbackShape.mkCone
      (F := Limits.WidePullbackShape.wideCospan U (fun _ : Fin (n + 1) => V) (fun _ => g) ⋙
        (Scheme.Etale.forget Y ⋙ Over.forget Y)) (y 0 ≫ g.left) y (fun j => hy j)),
      fun l => (hL n).fac _ (some l)⟩

  have hθ : ∀ n : ℕ, ∃ θi : Spec (.of (wcGalEqv κ M (n + 1))) ⟶
        (Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g)).left,
      ∃ θh : (Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g)).left ⟶
        Spec (.of (wcGalEqv κ M (n + 1))),
      θh ≫ θi = 𝟙 _ ∧ θi ≫ θh = 𝟙 _ ∧ ∀ l, θi ≫ (Limits.WidePullback.π (fun _ : Fin (n + 1) => g) l).left =
        Spec.map (CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l)) ≫ e.inv := by
    intro n
    obtain ⟨θi, hθi⟩ := hlift n (Spec (.of (wcGalEqv κ M (n + 1))))
      (fun l => Spec.map (CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) l)) ≫ e.inv) (by
        intro l
        simp only [Category.assoc, he]
        rw [← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp, hικ n l])
    obtain ⟨θh, hθh⟩ := hX n (Limits.widePullback U (fun _ : Fin (n + 1) => V) (fun _ => g)).left
      (fun l => (Limits.WidePullback.π (fun _ : Fin (n + 1) => g) l).left) (hπ n)
    refine ⟨θi, θh, ?_, ?_, hθi⟩
    · apply hWext
      intro l
      rw [Category.assoc, hθi, hθh, Category.id_comp]
    · apply hJ
      intro l
      rw [Category.assoc, hθh, hθi, Category.id_comp]
  choose θi θh hθ1 hθ2 hθ3 using hθ
  have hinvL : ∀ n, ((θi n).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).hom) ≫
      ((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫ (θh n).appTop) = 𝟙 _ := by
    intro n
    rw [Category.assoc, Iso.hom_inv_id_assoc, ← Scheme.Hom.comp_appTop, hθ1 n,
      Scheme.Hom.id_appTop]
  have hinvR : ∀ n, ((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫ (θh n).appTop) ≫
      ((θi n).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).hom) = 𝟙 _ := by
    intro n
    rw [Category.assoc, ← Category.assoc (θh n).appTop, ← Scheme.Hom.comp_appTop, hθ2 n,
      Scheme.Hom.id_appTop, Category.id_comp, Iso.inv_hom_id]

  refine wc_cech_acyclic_of_ring_model Y U V g κ M
    (fun n => (wcGalEqv κ M (n + 1)).subtype.comp
      ((θi n).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).hom).hom)
    ?_ ?_ ?_ ?_ hv
  · intro n s s' hss
    have h1 : ((θi n).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).hom).hom s =
        ((θi n).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).hom).hom s' :=
      Subtype.val_injective hss
    have h2 := congrArg ((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫
      (θh n).appTop).hom h1
    have e1 := congrArg (fun φ => φ.hom s) (hinvL n)
    have e2 := congrArg (fun φ => φ.hom s') (hinvL n)
    exact e1.symm.trans (h2.trans e2)
  · intro n s σ h
    exact (((θi n).appTop ≫
      (Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).hom).hom s).2 σ h
  · intro n ψ hψ
    have mkF : ∀ χ : (Fin (n + 1) → Gal(M/κ)) → Mˣ,
        (∀ (σ : Gal(M/κ)) (h : Fin (n + 1) → Gal(M/κ)), χ (fun l => σ * h l) = σ • χ h) →
        (fun h => (χ h : M)) ∈ wcGalEqv κ M (n + 1) := by
      intro χ hχ σ h
      show (χ (fun l => σ * h l) : M) = σ (χ h : M)
      rw [hχ σ h]
      rfl
    have hψ' : ∀ (σ : Gal(M/κ)) (h : Fin (n + 1) → Gal(M/κ)),
        (ψ (fun l => σ * h l))⁻¹ = σ • (ψ h)⁻¹ := by
      intro σ h
      rw [hψ σ h]
      exact (smul_inv' σ (ψ h)).symm
    let u : (wcGalEqv κ M (n + 1))ˣ :=
      ⟨⟨_, mkF ψ hψ⟩, ⟨_, mkF (fun h => (ψ h)⁻¹) hψ'⟩,
        Subtype.ext (funext fun h => Units.mul_inv (ψ h)),
        Subtype.ext (funext fun h => Units.inv_mul (ψ h))⟩
    refine ⟨Units.map ((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫
      (θh n).appTop).hom.toMonoidHom u, fun h => ?_⟩
    have e2 : ((θi n).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).hom).hom
        (((Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).inv ≫ (θh n).appTop).hom
          (u : wcGalEqv κ M (n + 1))) = u :=
      congrArg (fun φ => φ.hom (u : wcGalEqv κ M (n + 1))) (hinvR n)
    exact congrArg (fun x : wcGalEqv κ M (n + 1) => (x : (Fin (n + 1) → Gal(M/κ)) → M) h) e2
  · intro n m ρ q hq s h
    let Φ : wcGalEqv κ M (m + 1) →+* wcGalEqv κ M (n + 1) :=
      { toFun := fun F => ⟨fun h => (F : (Fin (m + 1) → Gal(M/κ)) → M) (fun l => h (ρ l)),
          fun σ h => F.2 σ (fun l => h (ρ l))⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hclaim : θi n ≫ q.left = Spec.map (CommRingCat.ofHom Φ) ≫ θi m := by
      apply hWext
      intro l
      have hql : q.left ≫ (Limits.WidePullback.π (fun _ : Fin (m + 1) => g) l).left =
          (Limits.WidePullback.π (fun _ : Fin (n + 1) => g) (ρ l)).left := by
        change (q ≫ Limits.WidePullback.π (fun _ : Fin (m + 1) => g) l).left = _
        rw [hq l]
      have hΦι : CommRingCat.ofHom (wcGalEqvIncl κ M (m + 1) l) ≫ CommRingCat.ofHom Φ =
          CommRingCat.ofHom (wcGalEqvIncl κ M (n + 1) (ρ l)) := rfl
      rw [Category.assoc, hql, hθ3, Category.assoc, hθ3, ← Category.assoc, ← Spec.map_comp, hΦι]
    have hmor : q.left.appTop ≫ (θi n).appTop ≫
        (Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (n + 1)))).hom =
        ((θi m).appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of (wcGalEqv κ M (m + 1)))).hom) ≫
          CommRingCat.ofHom Φ := by
      rw [← Category.assoc, ← Scheme.Hom.comp_appTop, hclaim, Scheme.Hom.comp_appTop,
        Category.assoc, Scheme.ΓSpecIso_naturality, Category.assoc]
    exact congrArg (fun φ => ((φ.hom s : wcGalEqv κ M (n + 1)) :
      (Fin (n + 1) → Gal(M/κ)) → M) h) hmor

theorem wc_ncl_prime_layer_coset_reps : ∀ (Q : Type u) [Group Q] (K K' : Subgroup Q), K' ≤ K → (K'.subgroupOf K).Normal → (K'.relIndex K).Prime → ∀ σ ∈ K, σ ∉ K' → σ ^ (K'.relIndex K) ∈ K' ∧ (∀ k ∈ K, ∃ i < K'.relIndex K, (σ ^ i)⁻¹ * k ∈ K') ∧ (∀ i < K'.relIndex K, ∀ j < K'.relIndex K, (σ ^ i)⁻¹ * σ ^ j ∈ K' → i = j) ∧ (∀ n ∈ K', ∀ k ∈ K, k⁻¹ * n * k ∈ K') :=
by
  intro Q _ K K' hK hnorm hl σ hσK hσK'
  classical
  obtain ⟨s, rfl⟩ : ∃ s : K, (s : Q) = σ := ⟨⟨σ, hσK⟩, rfl⟩
  haveI : (K'.subgroupOf K).Normal := hnorm
  haveI : Fact (K'.relIndex K).Prime := ⟨hl⟩
  have hcard : Nat.card (K ⧸ K'.subgroupOf K) = K'.relIndex K := by
    rw [← Subgroup.index_eq_card]; rfl
  haveI : Finite (K ⧸ K'.subgroupOf K) :=
    Nat.finite_of_card_ne_zero (by rw [hcard]; exact hl.ne_zero)
  have hT : ∀ x : K, ((x : K ⧸ K'.subgroupOf K) = 1 ↔ (x : Q) ∈ K') := by
    intro x
    rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
  have hs1 : (s : K ⧸ K'.subgroupOf K) ≠ 1 := by
    rw [Ne, hT]; exact hσK'
  have hspow : (s : K ⧸ K'.subgroupOf K) ^ (K'.relIndex K) = 1 := by
    rw [← hcard]; exact pow_card_eq_one'
  have hord : orderOf (s : K ⧸ K'.subgroupOf K) = K'.relIndex K := orderOf_eq_prime hspow hs1
  refine ⟨?_, ?_, ?_, ?_⟩
  · have h := (hT (s ^ K'.relIndex K)).mp (by rw [QuotientGroup.mk_pow]; exact hspow)
    simpa using h
  · intro k hk
    have htop := zpowers_eq_top_of_prime_card hcard hs1
    have hmem : ((⟨k, hk⟩ : K) : K ⧸ K'.subgroupOf K) ∈
        Subgroup.zpowers (s : K ⧸ K'.subgroupOf K) := by
      rw [htop]; exact Subgroup.mem_top _
    rw [mem_zpowers_iff_mem_range_orderOf, Finset.mem_image] at hmem
    obtain ⟨i, hi, hieq⟩ := hmem
    rw [Finset.mem_range, hord] at hi
    refine ⟨i, hi, ?_⟩
    have h := (hT ((s ^ i)⁻¹ * ⟨k, hk⟩)).mp (by
      rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv, QuotientGroup.mk_pow, hieq, inv_mul_cancel])
    simpa using h
  · intro i hi j hj hij
    have h1 : ((s ^ i)⁻¹ * s ^ j : K) ∈ K'.subgroupOf K := by
      rw [Subgroup.mem_subgroupOf]; simpa using hij
    have h2 : ((s ^ i : K) : K ⧸ K'.subgroupOf K) = ((s ^ j : K) : K ⧸ K'.subgroupOf K) :=
      QuotientGroup.eq.mpr h1
    rw [QuotientGroup.mk_pow, QuotientGroup.mk_pow] at h2
    exact pow_injOn_Iio_orderOf (by rw [Set.mem_Iio, hord]; exact hi)
      (by rw [Set.mem_Iio, hord]; exact hj) h2
  · intro n hn k hk
    have hn' : (⟨n, hK hn⟩ : K) ∈ K'.subgroupOf K := by
      rw [Subgroup.mem_subgroupOf]; exact hn
    have h := hnorm.conj_mem' _ hn' ⟨k, hk⟩
    rw [Subgroup.mem_subgroupOf] at h
    simpa using h

theorem wc_ncl_cyclic_layer_cocycle : ∀ (Q A : Type u) [Group Q] [CommGroup A] [MulDistribMulAction Q A] (K K' : Subgroup Q) (l : ℕ) (σ : Q), 1 < l → K' ≤ K → σ ∈ K → σ ^ l ∈ K' → (∀ k ∈ K, ∃ i < l, (σ ^ i)⁻¹ * k ∈ K') → (∀ i < l, ∀ j < l, (σ ^ i)⁻¹ * σ ^ j ∈ K' → i = j) → (∀ n ∈ K', ∀ k ∈ K, k⁻¹ * n * k ∈ K') → ∀ b : A, (∀ n ∈ K', n • b = b) → ∏ i ∈ Finset.range l, (σ ^ i) • b = 1 → ∃ f : Q → A, (∀ k ∈ K, ∀ k' ∈ K, f (k * k') = k • f k' * f k) ∧ f σ = b ∧ ∀ n ∈ K', f n = 1 :=
by
  intro Q A _ _ _ K K' l σ hl hK hσ ha hb hc hd b hbinv hN
  classical
  set P : ℕ → A := fun i => ∏ m ∈ Finset.range i, (σ ^ m) • b with hP

  have s2 : ∀ i j : ℕ, P i * (σ ^ i) • P j = P (i + j) := by
    intro i j
    simp only [hP]
    rw [Finset.prod_range_add, Finset.smul_prod']
    congr 1
    refine Finset.prod_congr rfl (fun m _ => ?_)
    rw [smul_smul, ← pow_add]

  have s3 : ∀ n ∈ K', ∀ i : ℕ, n • P i = P i := by
    intro n hn i
    simp only [hP]
    rw [Finset.smul_prod']
    refine Finset.prod_congr rfl (fun m _ => ?_)
    have hm : σ ^ m ∈ K := K.pow_mem hσ m
    have h1 : (σ ^ m)⁻¹ * n * σ ^ m ∈ K' := hd n hn (σ ^ m) hm
    have h2 : n * σ ^ m = σ ^ m * ((σ ^ m)⁻¹ * n * σ ^ m) := by
      generalize σ ^ m = x
      group
    rw [smul_smul, h2, mul_smul, hbinv _ h1]

  have s4 : ∀ (k k' : Q) (i j : ℕ), (σ ^ i)⁻¹ * k ∈ K' → (σ ^ j)⁻¹ * k' ∈ K' →
      (σ ^ (i + j))⁻¹ * (k * k') ∈ K' ∧
        (l ≤ i + j → (σ ^ (i + j - l))⁻¹ * (k * k') ∈ K') := by
    intro k k' i j hn hn'
    have hj : σ ^ j ∈ K := K.pow_mem hσ j
    have h1 : (σ ^ (i + j))⁻¹ * (k * k') =
        ((σ ^ j)⁻¹ * ((σ ^ i)⁻¹ * k) * σ ^ j) * ((σ ^ j)⁻¹ * k') := by
      rw [pow_add]
      generalize σ ^ i = x
      generalize σ ^ j = y
      group
    have p1 : (σ ^ (i + j))⁻¹ * (k * k') ∈ K' := by
      rw [h1]; exact K'.mul_mem (hd _ hn _ hj) hn'
    refine ⟨p1, fun hle => ?_⟩
    have e : σ ^ (i + j) = σ ^ (i + j - l) * σ ^ l := by
      rw [← pow_add, Nat.sub_add_cancel hle]
    rw [e] at p1
    generalize σ ^ (i + j - l) = x at p1 ⊢
    have h2 : x⁻¹ * (k * k') = σ ^ l * ((x * σ ^ l)⁻¹ * (k * k')) := by
      generalize σ ^ l = y
      group
    rw [h2]; exact K'.mul_mem ha p1
  have gid : ∀ a c x : Q, a⁻¹ * c = (a⁻¹ * x) * (c⁻¹ * x)⁻¹ := by
    intro a c x; group
  let f : Q → A := fun q => if hq : q ∈ K then P (Classical.choose (hb q hq)) else 1

  have U : ∀ (q : Q) (hq : q ∈ K) (i : ℕ), i < l → (σ ^ i)⁻¹ * q ∈ K' → f q = P i := by
    intro q hq i hi hiq
    obtain ⟨hcl, hcq⟩ := Classical.choose_spec (hb q hq)
    have hci : (σ ^ Classical.choose (hb q hq))⁻¹ * σ ^ i ∈ K' := by
      rw [gid _ _ q]; exact K'.mul_mem hcq (K'.inv_mem hiq)
    have hcc := hc _ hcl i hi hci
    show (if hq : q ∈ K then P (Classical.choose (hb q hq)) else 1) = P i
    rw [dif_pos hq, hcc]
  have hP0 : P 0 = 1 := by simp [hP]
  have hPl : P l = 1 := hN

  have W : ∀ r, P (l + r) = P r := by
    intro r
    rw [← s2 l r, hPl, one_mul, s3 _ ha r]
  refine ⟨f, ?_, ?_, ?_⟩
  · intro k hk k' hk'
    obtain ⟨hil, hik⟩ := Classical.choose_spec (hb k hk)
    obtain ⟨hjl, hjk⟩ := Classical.choose_spec (hb k' hk')
    generalize Classical.choose (hb k hk) = i at hil hik
    generalize Classical.choose (hb k' hk') = j at hjl hjk
    rw [U k hk i hil hik, U k' hk' j hjl hjk]
    have hkP : k • P j = (σ ^ i) • P j := by
      calc k • P j = (σ ^ i * ((σ ^ i)⁻¹ * k)) • P j := by rw [mul_inv_cancel_left]
        _ = (σ ^ i) • (((σ ^ i)⁻¹ * k) • P j) := mul_smul _ _ _
        _ = (σ ^ i) • P j := by rw [s3 _ hik]
    rw [hkP, mul_comm, s2 i j]
    obtain ⟨h1, h2⟩ := s4 k k' i j hik hjk
    have hkk : k * k' ∈ K := K.mul_mem hk hk'
    by_cases hlt : i + j < l
    · exact U _ hkk _ hlt h1
    · push_neg at hlt
      rw [U _ hkk (i + j - l) (by omega) (h2 hlt), ← W]
      congr 1
      omega
  · rw [U σ hσ 1 hl (by rw [pow_one, inv_mul_cancel]; exact K'.one_mem)]
    simp [hP]
  · intro n hn
    rw [U n (hK hn) 0 (by omega) (by rw [pow_zero, inv_one, one_mul]; exact hn), hP0]

theorem wc_ncl_hilbert90_subgroup : ∀ (E M : Type u) [Field E] [Field M] [Algebra E M] [FiniteDimensional E M] (K : Subgroup Gal(M/E)) (f : Gal(M/E) → Mˣ), (∀ k ∈ K, ∀ k' ∈ K, f (k * k') = k • f k' * f k) → ∃ β : Mˣ, ∀ k ∈ K, k • β / β = f k :=
by
  intro E M _ _ _ _ K f hf
  let F : IntermediateField E M := IntermediateField.fixedField K
  haveI : FiniteDimensional F M := IntermediateField.finiteDimensional_right F
  have hK : F.fixingSubgroup = K := IntermediateField.fixingSubgroup_fixedField K
  let e := IntermediateField.fixingSubgroupEquiv F
  have hact0 : ∀ (σ : F.fixingSubgroup) (u : Mˣ),
      (e σ) • u = (σ : Gal(M/E)) • u := by
    intro σ u
    apply Units.ext
    rfl
  have hact : ∀ (τ : Gal(M/F)) (u : Mˣ),
      τ • u = ((e.symm τ : F.fixingSubgroup) : Gal(M/E)) • u := by
    intro τ u
    have h1 := hact0 (e.symm τ) u
    rw [e.apply_symm_apply] at h1
    exact h1
  have hmem : ∀ τ : Gal(M/F), ((e.symm τ : F.fixingSubgroup) : Gal(M/E)) ∈ K := by
    intro τ
    rw [← hK]
    exact (e.symm τ).2
  let g : Gal(M/F) → Mˣ := fun τ => f ((e.symm τ : F.fixingSubgroup) : Gal(M/E))
  have hg : groupCohomology.IsMulCocycle₁ g := by
    intro τ₁ τ₂
    show f ((e.symm (τ₁ * τ₂) : F.fixingSubgroup) : Gal(M/E)) =
      τ₁ • f ((e.symm τ₂ : F.fixingSubgroup) : Gal(M/E)) *
        f ((e.symm τ₁ : F.fixingSubgroup) : Gal(M/E))
    rw [map_mul, Subgroup.coe_mul, hf _ (hmem τ₁) _ (hmem τ₂), hact]
  obtain ⟨β, hβ⟩ := groupCohomology.isMulCoboundary₁_of_isMulCocycle₁_of_aut_to_units g hg
  refine ⟨β, fun k hk => ?_⟩
  have hk' : k ∈ F.fixingSubgroup := by
    rw [hK]
    exact hk
  have h2 := hβ (e ⟨k, hk'⟩)
  rw [hact] at h2
  have h3 : e.symm (e ⟨k, hk'⟩) = ⟨k, hk'⟩ := e.symm_apply_apply _
  change ((e.symm (e ⟨k, hk'⟩) : F.fixingSubgroup) : Gal(M/E)) • β / β =
    f ((e.symm (e ⟨k, hk'⟩) : F.fixingSubgroup) : Gal(M/E)) at h2
  rw [h3] at h2
  exact h2

theorem wc_ncl_fixed_layer_isGalois : ∀ (E M : Type u) [Field E] [Field M] [Algebra E M] [FiniteDimensional E M] [IsGalois E M] (K K' : Subgroup Gal(M/E)) (h : IntermediateField.fixedField K ≤ IntermediateField.fixedField K'), (∀ n ∈ K', ∀ k ∈ K, k⁻¹ * n * k ∈ K') → IsGalois (IntermediateField.fixedField K) (IntermediateField.extendScalars h) :=
by
  intro E M _ _ _ _ _ K K' h hconj
  have hsep : Algebra.IsSeparable (IntermediateField.fixedField K)
      (IntermediateField.extendScalars h) :=
    Algebra.isSeparable_tower_bot_of_isSeparable (IntermediateField.fixedField K)
      (IntermediateField.extendScalars h) M
  have hk : ∀ τ : Gal(M/(IntermediateField.fixedField K)), τ.restrictScalars E ∈ K := by
    intro τ
    have hmem : τ.restrictScalars E ∈ (IntermediateField.fixedField K).fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro y hy
      exact τ.commutes ⟨y, hy⟩
    exact (IntermediateField.fixingSubgroup_fixedField K).le hmem
  have hnorm : Normal (IntermediateField.fixedField K) (IntermediateField.extendScalars h) := by
    rw [IntermediateField.normal_iff_forall_map_le']
    intro τ z hz
    obtain ⟨x, hx0, rfl⟩ := hz
    have hx : x ∈ IntermediateField.extendScalars h := hx0
    rw [IntermediateField.mem_extendScalars] at hx ⊢
    rw [IntermediateField.mem_fixedField_iff] at hx ⊢
    intro n hn
    have h1 := hx _ (hconj n hn (τ.restrictScalars E) (hk τ))
    have h3 : (τ.restrictScalars E) ((τ.restrictScalars E)⁻¹ (n ((τ.restrictScalars E) x))) =
        n ((τ.restrictScalars E) x) := by
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    change n ((τ.restrictScalars E) x) = (τ.restrictScalars E) x
    calc n ((τ.restrictScalars E) x)
        = (τ.restrictScalars E) ((τ.restrictScalars E)⁻¹ (n ((τ.restrictScalars E) x))) := h3.symm
      _ = (τ.restrictScalars E) x := by
        rw [show (τ.restrictScalars E)⁻¹ (n ((τ.restrictScalars E) x)) =
          ((τ.restrictScalars E)⁻¹ * n * τ.restrictScalars E) x from rfl, h1]
  exact isGalois_iff.mpr ⟨hsep, hnorm⟩

theorem wc_ncl_layer_norm_eq_prod : ∀ (E M : Type u) [Field E] [Field M] [Algebra E M] [FiniteDimensional E M] [IsGalois E M] (K K' : Subgroup Gal(M/E)) (h : IntermediateField.fixedField K ≤ IntermediateField.fixedField K') [IsGalois (IntermediateField.fixedField K) (IntermediateField.extendScalars h)] (l : ℕ) (σ : Gal(M/E)), σ ∈ K → (∀ k ∈ K, ∃ i < l, (σ ^ i)⁻¹ * k ∈ K') → (∀ i < l, ∀ j < l, (σ ^ i)⁻¹ * σ ^ j ∈ K' → i = j) → ∀ y : IntermediateField.extendScalars h, ((Algebra.norm (IntermediateField.fixedField K) y : IntermediateField.fixedField K) : M) = ∏ i ∈ Finset.range l, (σ ^ i) (y : M) :=
by
  intro E M _ _ _ _ _ K K' h _ l σ hσ hb hc y
  classical

  have hres : ∀ k ∈ K, ∃ ρ : Gal(IntermediateField.extendScalars h/IntermediateField.fixedField K),
      ∀ z : IntermediateField.extendScalars h,
        ((ρ z : IntermediateField.extendScalars h) : M) = k (z : M) := by
    intro k hk
    have hk' : ∀ x : IntermediateField.fixedField K,
        k.toRingEquiv (algebraMap (IntermediateField.fixedField K) M x) =
          algebraMap (IntermediateField.fixedField K) M x := by
      intro x
      exact (IntermediateField.mem_fixedField_iff K (x : M)).mp x.2 k hk
    let τ : M ≃ₐ[IntermediateField.fixedField K] M := AlgEquiv.ofRingEquiv (f := k.toRingEquiv) hk'
    refine ⟨τ.restrictNormal (IntermediateField.extendScalars h), fun z => ?_⟩
    have e := AlgEquiv.restrictNormal_commutes τ (IntermediateField.extendScalars h) z
    exact e

  have hlift : ∀ ρ : Gal(IntermediateField.extendScalars h/IntermediateField.fixedField K),
      ∃ k ∈ K, ∀ z : IntermediateField.extendScalars h,
        ((ρ z : IntermediateField.extendScalars h) : M) = k (z : M) := by
    intro ρ
    let τ : Gal(M/IntermediateField.fixedField K) := ρ.liftNormal M
    refine ⟨τ.restrictScalars E, ?_, fun z => ?_⟩
    · have hmem : τ.restrictScalars E ∈ (IntermediateField.fixedField K).fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        rw [AlgEquiv.restrictScalars_apply]
        exact τ.commutes ⟨x, hx⟩
      rwa [IntermediateField.fixingSubgroup_fixedField] at hmem
    · rw [AlgEquiv.restrictScalars_apply]
      exact (AlgEquiv.liftNormal_commutes ρ M z).symm

  have hagree : ∀ a b : Gal(M/E), (∀ z : IntermediateField.extendScalars h, a (z : M) = b (z : M)) →
      a⁻¹ * b ∈ K' := by
    intro a b hab
    have hmem : a⁻¹ * b ∈ (IntermediateField.fixedField K').fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      have hx' : a x = b x := hab ⟨x, (IntermediateField.mem_extendScalars h).mpr hx⟩
      rw [AlgEquiv.mul_apply, ← hx', AlgEquiv.aut_inv, AlgEquiv.symm_apply_apply]
    rwa [IntermediateField.fixingSubgroup_fixedField] at hmem

  have e3 : ((Algebra.norm (IntermediateField.fixedField K) y : IntermediateField.fixedField K) : M) =
      ∏ ρ : Gal(IntermediateField.extendScalars h/IntermediateField.fixedField K),
        ((ρ y : IntermediateField.extendScalars h) : M) :=
    (congrArg (fun z : IntermediateField.extendScalars h => (z : M))
      (Algebra.norm_eq_prod_automorphisms (IntermediateField.fixedField K) y)).trans
      (IntermediateField.coe_prod (IntermediateField.extendScalars h)
        (fun ρ : Gal(IntermediateField.extendScalars h/IntermediateField.fixedField K) => ρ y))

  choose R hR using fun i : ℕ => hres (σ ^ i) (K.pow_mem hσ i)

  rw [e3]
  symm
  apply Finset.prod_nbij R
  · intro a _
    exact Finset.mem_univ _
  · intro i hi j hj hij
    have hi' := Finset.mem_range.mp (Finset.mem_coe.mp hi)
    have hj' := Finset.mem_range.mp (Finset.mem_coe.mp hj)
    apply hc i hi' j hj'
    apply hagree
    intro z
    rw [← hR i z, ← hR j z, hij]
  · intro ρ _
    obtain ⟨k, hk, hkz⟩ := hlift ρ
    obtain ⟨i, hi, hn⟩ := hb k hk
    refine ⟨i, Finset.mem_coe.mpr (Finset.mem_range.mpr hi), ?_⟩
    apply AlgEquiv.ext
    intro z
    apply Subtype.ext
    rw [hR i z, hkz z]
    have hz : (z : M) ∈ IntermediateField.fixedField K' :=
      (IntermediateField.mem_extendScalars h).mp z.2
    have hfix := (IntermediateField.mem_fixedField_iff K' (z : M)).mp hz _ hn
    calc (σ ^ i) (z : M) = (σ ^ i) (((σ ^ i)⁻¹ * k) (z : M)) := by rw [hfix]
      _ = k (z : M) := by rw [← AlgEquiv.mul_apply, mul_inv_cancel_left]
  · intro a _
    exact (hR a y).symm

theorem wc_norm_surj_cyclic_layers : ∀ (L : Type u) [Field L], (∀ (E : Type u) [Field E] [Algebra L E], Algebra.IsAlgebraic L E → ∀ (F : Type u) [Field F] [Algebra E F] [FiniteDimensional E F], Function.Surjective (Algebra.norm E (S := F))) → ∀ (E M : Type u) [Field E] [Field M] [Algebra L E] [Algebra E M], Algebra.IsAlgebraic L E → FiniteDimensional E M → IsGalois E M → wcCyclicLayerCond Gal(M/E) Mˣ :=
by
  intro L _ hn E M _ _ _ _ hLE hfd hgal
  haveI := hfd
  haveI := hgal
  intro K K' hK hnorm hl σ hσK hσK'
  obtain ⟨ha, hb, hc, hd⟩ :=
    wc_ncl_prime_layer_coset_reps Gal(M/E) K K' hK hnorm hl σ hσK hσK'
  have h : IntermediateField.fixedField K ≤ IntermediateField.fixedField K' :=
    IntermediateField.fixedField_le hK
  haveI hGal : IsGalois (IntermediateField.fixedField K) (IntermediateField.extendScalars h) :=
    wc_ncl_fixed_layer_isGalois E M K K' h hd
  have hNS : Function.Surjective
      (Algebra.norm (IntermediateField.fixedField K) (S := IntermediateField.extendScalars h)) := by
    letI : Algebra L (IntermediateField.fixedField K) :=
      ((algebraMap E (IntermediateField.fixedField K)).comp (algebraMap L E)).toAlgebra
    haveI : IsScalarTower L E (IntermediateField.fixedField K) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI := hLE
    exact hn (IntermediateField.fixedField K)
      (Algebra.IsAlgebraic.trans L E (IntermediateField.fixedField K))
      (IntermediateField.extendScalars h)
  refine ⟨fun a ha_inv => ?_, fun b hb_inv hN => ?_⟩
  ·
    have haF : (a : M) ∈ IntermediateField.fixedField K := by
      rw [IntermediateField.mem_fixedField_iff]
      intro k hk
      exact congrArg Units.val (ha_inv k hk)
    obtain ⟨y, hy⟩ := hNS ⟨(a : M), haF⟩
    have hy0 : (y : M) ≠ 0 := by
      intro h0
      have hy00 : y = 0 := Subtype.ext h0
      rw [hy00, Algebra.norm_zero] at hy
      have := congrArg Subtype.val hy
      exact a.ne_zero this.symm
    have hyK' : ∀ n ∈ K', n (y : M) = (y : M) := by
      have hy1 : (y : M) ∈ IntermediateField.fixedField K' :=
        (IntermediateField.mem_extendScalars h).mp y.2
      exact (IntermediateField.mem_fixedField_iff _ _).mp hy1
    refine ⟨Units.mk0 (y : M) hy0, fun n hn' => Units.ext (hyK' n hn'), ?_⟩
    apply Units.ext
    rw [Units.coe_prod]
    have e := wc_ncl_layer_norm_eq_prod E M K K' h (K'.relIndex K) σ hσK hb hc y
    rw [hy] at e
    exact e.symm
  ·
    obtain ⟨f, hf, hfσ, hf1⟩ := wc_ncl_cyclic_layer_cocycle Gal(M/E) Mˣ K K' (K'.relIndex K) σ
      hl.one_lt hK hσK ha hb hc hd b hb_inv hN
    obtain ⟨β, hβ⟩ := wc_ncl_hilbert90_subgroup E M K f hf
    refine ⟨β, fun n hn' => ?_, ?_⟩
    · have := hβ n (hK hn')
      rw [hf1 n hn'] at this
      exact div_eq_one.mp this
    · rw [← hfσ, ← hβ σ hσK, div_eq_mul_inv]

theorem wc_grp_coh_vanish_pgroup : ∀ (Q : Type u) (B : Type u) [Group Q] [Finite Q] [CommGroup B] [MulDistribMulAction Q B], wcCyclicLayerCond Q B → ∀ (p : ℕ) [Fact p.Prime] (P : Subgroup Q), IsPGroup p P → wcGrpCohVanish P B :=
by
  intro Q B _ _ _ _ hc p hp
  classical

  have hv : ∀ (n : ℕ) (j : Fin (n + 1)) (k : Fin n),
      ((j.succAbove k : Fin (n + 1)) : ℕ) = if (k : ℕ) < (j : ℕ) then (k : ℕ) else (k : ℕ) + 1 := by
    intro n j k
    unfold Fin.succAbove
    split_ifs with h1 h2 h2 <;> simp_all [Fin.lt_def]

  have s1 : ∀ (X : Type u) (m : ℕ) (φ : (Fin (m + 1) → X) → B) (x : Fin (m + 3) → X),
      wcCobd (m + 1) (wcCobd m φ) x = 1 := by
    intro X m φ x
    have hsign : ∀ a b c d : ℕ, c + d = a + b + 1 →
        (-1 : ℤ) ^ c * (-1 : ℤ) ^ d = -((-1 : ℤ) ^ a * (-1 : ℤ) ^ b) := by
      intro a b c d h
      rw [← pow_add, ← pow_add, h, pow_succ]
      ring
    have hsign' : ∀ a b c d : ℕ, c + d + 1 = a + b →
        (-1 : ℤ) ^ c * (-1 : ℤ) ^ d = -((-1 : ℤ) ^ a * (-1 : ℤ) ^ b) := by
      intro a b c d h
      rw [← pow_add, ← pow_add, ← h, pow_succ]
      ring
    unfold wcCobd
    simp_rw [← Finset.prod_zpow, ← zpow_mul]
    rw [← Finset.prod_product']
    refine Finset.prod_involution
      (fun a _ => if h : (a.2 : ℕ) < (a.1 : ℕ) then
        (a.2.castSucc, a.1.pred (fun h0 => by simp [h0] at h))
        else (a.2.succ, a.1.castPred (fun h0 => by
          have h1 := congrArg Fin.val h0
          simp at h1
          have := a.2.isLt
          omega))) ?_ ?_ ?_ ?_
    · rintro ⟨j, i⟩ -
      dsimp only
      split_ifs with h
      · have hij : (i : ℕ) < (j : ℕ) := h
        have hb : (fun l => x ((i.castSucc).succAbove
            ((j.pred (fun h0 => by simp [h0] at h)).succAbove l))) =
            (fun l => x (j.succAbove (i.succAbove l))) := by
          funext l
          congr 1
          apply Fin.ext
          rw [hv, hv, hv, hv]
          simp only [Fin.val_castSucc, Fin.val_pred]
          split_ifs <;> omega
        rw [hb, hsign' (i : ℕ) (j : ℕ) ((j.pred (fun h0 => by simp [h0] at h) : ℕ))
          (i.castSucc : ℕ) (by simp only [Fin.val_castSucc, Fin.val_pred]; omega)]
        rw [zpow_neg, mul_inv_cancel]
      · have hij : (j : ℕ) ≤ (i : ℕ) := not_lt.mp h
        have hb : (fun l => x ((i.succ).succAbove ((j.castPred (fun h0 => by
              have h1 := congrArg Fin.val h0
              simp at h1
              have := i.isLt
              omega)).succAbove l))) =
            (fun l => x (j.succAbove (i.succAbove l))) := by
          funext l
          congr 1
          apply Fin.ext
          rw [hv, hv, hv, hv]
          simp only [Fin.val_succ, Fin.coe_castPred]
          by_cases h1 : (l : ℕ) < (i : ℕ) <;> by_cases h2 : (l : ℕ) < (j : ℕ) <;>
            simp only [h1, h2, ite_true, ite_false] <;> split_ifs <;> omega
        rw [hb, hsign (i : ℕ) (j : ℕ) ((j.castPred (fun h0 => by
              have h1 := congrArg Fin.val h0
              simp at h1
              have := i.isLt
              omega) : ℕ)) (i.succ : ℕ)
          (by simp only [Fin.val_succ, Fin.coe_castPred]; omega)]
        rw [zpow_neg, mul_inv_cancel]
    · rintro ⟨j, i⟩ - -
      dsimp only
      split_ifs with h
      · intro he
        have := congrArg (fun a => (a.1 : ℕ)) he
        simp only [Fin.val_castSucc] at this
        omega
      · intro he
        have := congrArg (fun a => (a.1 : ℕ)) he
        simp only [Fin.val_succ] at this
        omega
    · intro a _
      exact Finset.mem_univ _
    · rintro ⟨j, i⟩ -
      dsimp only
      by_cases h : (i : ℕ) < (j : ℕ)
      · rw [dif_pos h]
        dsimp only
        rw [dif_neg (by simp only [Fin.val_castSucc, Fin.val_pred]; omega)]
        ext <;> simp
      · rw [dif_neg h]
        dsimp only
        rw [dif_pos (by simp only [Fin.coe_castPred, Fin.val_succ]; omega)]
        ext <;> simp

  have s2 : ∀ (X : Type u) (t : X → X) (q : ℕ) (Φ : (Fin (q + 2) → X) → B)
      (g : Fin (q + 2) → X), wcCobd q (wcPrism t q Φ) g * wcPrism t (q + 1) (wcCobd (q + 1) Φ) g =
        Φ (fun k => t (g k)) * (Φ g)⁻¹ := by
    intro X t q Φ g
    let δ : ℕ → ℕ → ℕ := fun j l => if l < j then l else l + 1
    let Pr : ℕ → (ℕ → X) → ℕ → X := fun i H m => if m ≤ i then H m else t (H (m - 1))
    let Mx : ℕ → (ℕ → X) → ℕ → X := fun i H m => if m < i then H m else t (H m)
    have R1 : ∀ (n : ℕ) (φ : (Fin (n + 1) → X) → B) (H : ℕ → X),
        wcCobd n φ (fun k => H k) =
          ∏ j ∈ Finset.range (n + 2), φ (fun l => H (δ j l)) ^ ((-1 : ℤ) ^ j) := by
      intro n φ H
      rw [← Fin.prod_univ_eq_prod_range
        (fun j => φ (fun l : Fin (n + 1) => H (δ j l)) ^ ((-1 : ℤ) ^ j))]
      unfold wcCobd
      refine Finset.prod_congr rfl fun j _ => ?_
      refine congrArg (· ^ _) (congrArg φ (funext fun l => ?_))
      show H ((j.succAbove l : Fin (n + 2)) : ℕ) = H (δ j l)
      rw [hv]
    have R2 : ∀ (q' : ℕ) (Φ' : (Fin (q' + 2) → X) → B) (H : ℕ → X),
        wcPrism t q' Φ' (fun k => H k) =
          ∏ i ∈ Finset.range (q' + 1), Φ' (fun k => Pr i H k) ^ ((-1 : ℤ) ^ i) := by
      intro q' Φ' H
      rw [← Fin.prod_univ_eq_prod_range
        (fun i => Φ' (fun k : Fin (q' + 2) => Pr i H k) ^ ((-1 : ℤ) ^ i))]
      unfold wcPrism
      refine Finset.prod_congr rfl fun i _ => ?_
      refine congrArg (· ^ _) (congrArg Φ' (funext fun k => ?_))
      show (if h : (k : ℕ) ≤ (i : ℕ) then H k else t (H ((k : ℕ) - 1))) = Pr i H k
      by_cases h : (k : ℕ) ≤ (i : ℕ) <;> simp [Pr, h]
    have eA : ∀ (i k : ℕ) (H : ℕ → X), k < i + 1 →
        (fun m => Pr (i + 1) H (δ k m)) = Pr i (fun m => H (δ k m)) := by
      intro i k H hk
      funext m
      simp only [Pr, δ]
      split_ifs <;> first | omega | rfl | (congr 1; omega) | (congr 2; omega)
    have eD : ∀ (i x : ℕ) (H : ℕ → X),
        (fun m => Pr i H (δ (i + (2 + x)) m)) = Pr i (fun m => H (δ (i + 1 + x) m)) := by
      intro i x H
      funext m
      simp only [Pr, δ]
      split_ifs <;> first | omega | rfl | (congr 1; omega) | (congr 2; omega)
    have eB : ∀ (i : ℕ) (H : ℕ → X), (fun m => Pr i H (δ i m)) = Mx i H := by
      intro i H
      funext m
      simp only [Pr, δ, Mx]
      split_ifs <;> first | omega | rfl
    have eC : ∀ (i : ℕ) (H : ℕ → X), (fun m => Pr i H (δ (i + 1) m)) = Mx (i + 1) H := by
      intro i H
      funext m
      simp only [Pr, δ, Mx]
      split_ifs <;> first | omega | rfl
    have key : ∀ (Ψ : (ℕ → X) → B) (G : ℕ → X) (n : ℕ),
        (∏ j ∈ Finset.range (n + 2), ∏ i ∈ Finset.range (n + 1),
            Ψ (Pr i (fun m => G (δ j m))) ^ ((-1 : ℤ) ^ (i + j))) *
          (∏ i ∈ Finset.range (n + 2), ∏ k ∈ Finset.range (n + 3),
            Ψ (fun m => Pr i G (δ k m)) ^ ((-1 : ℤ) ^ (k + i))) =
        Ψ (Mx 0 G) * (Ψ (Mx (n + 2) G))⁻¹ := by
      intro Ψ G n
      have hA : ∀ i k, k < i + 1 →
          Ψ (fun m => Pr (i + 1) G (δ k m)) ^ ((-1 : ℤ) ^ (k + (i + 1))) =
          (Ψ (Pr i (fun m => G (δ k m))) ^ ((-1 : ℤ) ^ (i + k)))⁻¹ := by
        intro i k hk
        rw [eA i k G hk, ← zpow_neg]
        congr 1
        rw [show k + (i + 1) = (i + k) + 1 by ring, pow_succ, mul_neg_one]
      have hD : ∀ i x, Ψ (fun m => Pr i G (δ (i + (2 + x)) m)) ^ ((-1 : ℤ) ^ (i + (2 + x) + i)) =
          (Ψ (Pr i (fun m => G (δ (i + 1 + x) m))) ^ ((-1 : ℤ) ^ (i + (i + 1 + x))))⁻¹ := by
        intro i x
        rw [eD i x G, ← zpow_neg]
        congr 1
        rw [show i + (2 + x) + i = (i + (i + 1 + x)) + 1 by ring, pow_succ, mul_neg_one]
      have hB : ∀ i, Ψ (fun m => Pr i G (δ i m)) ^ ((-1 : ℤ) ^ (i + i)) *
          Ψ (fun m => Pr i G (δ (i + 1) m)) ^ ((-1 : ℤ) ^ (i + 1 + i)) =
          Ψ (Mx i G) / Ψ (Mx (i + 1) G) := by
        intro i
        rw [eB i G, eC i G, div_eq_mul_inv]
        congr 1
        · rw [← two_mul, pow_mul]; norm_num
        · rw [show i + 1 + i = 2 * i + 1 by ring, pow_succ, pow_mul]; norm_num
      have hsplit : ∀ i ∈ Finset.range (n + 2), ∏ k ∈ Finset.range (n + 3),
          Ψ (fun m => Pr i G (δ k m)) ^ ((-1 : ℤ) ^ (k + i)) =
          (∏ k ∈ Finset.range i, Ψ (fun m => Pr i G (δ k m)) ^ ((-1 : ℤ) ^ (k + i))) *
          ((Ψ (fun m => Pr i G (δ i m)) ^ ((-1 : ℤ) ^ (i + i)) *
            Ψ (fun m => Pr i G (δ (i + 1) m)) ^ ((-1 : ℤ) ^ (i + 1 + i))) *
           ∏ x ∈ Finset.range (n + 1 - i),
            Ψ (fun m => Pr i G (δ (i + (2 + x)) m)) ^ ((-1 : ℤ) ^ (i + (2 + x) + i))) := by
        intro i hi
        rw [Finset.mem_range] at hi
        rw [show n + 3 = i + (2 + (n + 1 - i)) by omega, Finset.prod_range_add,
          Finset.prod_range_add, Finset.prod_range_succ, Finset.prod_range_one, add_zero]
      have hF1 : (∏ j ∈ Finset.range (n + 2), ∏ i ∈ Finset.range (n + 1),
            Ψ (Pr i (fun m => G (δ j m))) ^ ((-1 : ℤ) ^ (i + j))) =
          (∏ i ∈ Finset.range (n + 1), ∏ j ∈ Finset.range (i + 1),
            Ψ (Pr i (fun m => G (δ j m))) ^ ((-1 : ℤ) ^ (i + j))) *
          (∏ i ∈ Finset.range (n + 1), ∏ x ∈ Finset.range (n + 1 - i),
            Ψ (Pr i (fun m => G (δ (i + 1 + x) m))) ^ ((-1 : ℤ) ^ (i + (i + 1 + x)))) := by
        rw [Finset.prod_comm, ← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl fun i hi => ?_
        rw [Finset.mem_range] at hi
        rw [show n + 2 = (i + 1) + (n + 1 - i) by omega, Finset.prod_range_add]
      have hF2 : (∏ i ∈ Finset.range (n + 2), ∏ k ∈ Finset.range (n + 3),
            Ψ (fun m => Pr i G (δ k m)) ^ ((-1 : ℤ) ^ (k + i))) =
          (∏ i ∈ Finset.range (n + 1), ∏ j ∈ Finset.range (i + 1),
            Ψ (Pr i (fun m => G (δ j m))) ^ ((-1 : ℤ) ^ (i + j)))⁻¹ *
          (Ψ (Mx 0 G) / Ψ (Mx (n + 2) G) *
          (∏ i ∈ Finset.range (n + 1), ∏ x ∈ Finset.range (n + 1 - i),
            Ψ (Pr i (fun m => G (δ (i + 1 + x) m))) ^ ((-1 : ℤ) ^ (i + (i + 1 + x))))⁻¹) := by
        rw [Finset.prod_congr rfl hsplit, Finset.prod_mul_distrib, Finset.prod_mul_distrib]
        congr 1
        · conv_lhs => rw [Finset.prod_range_succ']
          rw [Finset.prod_range_zero, mul_one, ← Finset.prod_inv_distrib]
          refine Finset.prod_congr rfl fun i _ => ?_
          rw [← Finset.prod_inv_distrib]
          exact Finset.prod_congr rfl fun k hk => hA i k (Finset.mem_range.mp hk)
        · congr 1
          · exact (Finset.prod_congr rfl fun i _ => hB i).trans
              (Finset.prod_range_div' (fun i => Ψ (Mx i G)) (n + 2))
          · conv_lhs => rw [Finset.prod_range_succ]
            rw [Nat.sub_self, Finset.prod_range_zero, mul_one, ← Finset.prod_inv_distrib]
            refine Finset.prod_congr rfl fun i _ => ?_
            rw [← Finset.prod_inv_distrib]
            exact Finset.prod_congr rfl fun x _ => hD i x
      rw [hF1, hF2, div_eq_mul_inv]
      generalize (∏ i ∈ Finset.range (n + 1), ∏ j ∈ Finset.range (i + 1),
            Ψ (Pr i (fun m => G (δ j m))) ^ ((-1 : ℤ) ^ (i + j))) = Y1
      generalize (∏ i ∈ Finset.range (n + 1), ∏ x ∈ Finset.range (n + 1 - i),
            Ψ (Pr i (fun m => G (δ (i + 1 + x) m))) ^ ((-1 : ℤ) ^ (i + (i + 1 + x)))) = Y2
      generalize Ψ (Mx 0 G) * (Ψ (Mx (n + 2) G))⁻¹ = C
      rw [mul_comm Y1 Y2, mul_assoc, mul_inv_cancel_left, mul_comm C, mul_inv_cancel_left]
    let G : ℕ → X := fun m => if h : m < q + 2 then g ⟨m, h⟩ else g 0
    have hg : g = fun k : Fin (q + 2) => G k := funext fun k => by
      show g k = if h : (k : ℕ) < q + 2 then g ⟨k, h⟩ else g 0
      rw [dif_pos k.isLt]
    rw [hg]
    rw [R1 q (wcPrism t q Φ) G, R2 (q + 1) (wcCobd (q + 1) Φ) G]
    have e1 : ∀ j, wcPrism t q Φ (fun l => G (δ j l)) =
        ∏ i ∈ Finset.range (q + 1), Φ (fun k => Pr i (fun m => G (δ j m)) k) ^ ((-1 : ℤ) ^ i) :=
      fun j => R2 q Φ (fun m => G (δ j m))
    have e2 : ∀ i, wcCobd (q + 1) Φ (fun k => Pr i G k) =
        ∏ k ∈ Finset.range (q + 3), Φ (fun l => Pr i G (δ k l)) ^ ((-1 : ℤ) ^ k) :=
      fun i => R1 (q + 1) Φ (Pr i G)
    simp only [e1, e2, ← Finset.prod_zpow, ← zpow_mul, ← pow_add]
    have hk := key (fun H => Φ (fun k => H k)) G q
    beta_reduce at hk
    rw [hk]
    have m0 : (fun k : Fin (q + 2) => Mx 0 G k) = fun k : Fin (q + 2) => t (G k) := by
      funext k
      simp [Mx]
    have m2 : (fun k : Fin (q + 2) => Mx (q + 2) G k) = fun k : Fin (q + 2) => G k := by
      funext k
      simp [Mx, k.isLt]
    rw [m0, m2]

  have s3 : ∀ (P N : Subgroup Q), N ≤ P → wcGrpCohVanish N B →
      ∀ (a : ℕ) (f : (Fin (a + 2) → P) → B),
      (∀ ν ∈ N.subgroupOf P, ∀ x : Fin (a + 2) → P, f (fun i => ν * x i) = ν • f x) →
      (∀ x, wcCobd (a + 1) f x = 1) → ∃ f' : (Fin (a + 1) → P) → B,
        (∀ ν ∈ N.subgroupOf P, ∀ x : Fin (a + 1) → P, f' (fun i => ν * x i) = ν • f' x) ∧
        ∀ x, wcCobd a f' x = f x := by
    intro P N hNP hN a f hf hcoc
    let r : P → P := fun z => (Quotient.mk (QuotientGroup.rightRel (N.subgroupOf P)) z).out
    have hr : ∀ z, z * (r z)⁻¹ ∈ N.subgroupOf P := fun z =>
      QuotientGroup.rightRel_apply.mp
        (Quotient.exact (Quotient.out_eq (Quotient.mk (QuotientGroup.rightRel (N.subgroupOf P)) z)))
    have hrν : ∀ ν ∈ N.subgroupOf P, ∀ z, r (ν * z) = r z := by
      intro ν hν z
      have hq : Quotient.mk (QuotientGroup.rightRel (N.subgroupOf P)) (ν * z) =
          Quotient.mk (QuotientGroup.rightRel (N.subgroupOf P)) z := by
        apply Quotient.sound
        apply QuotientGroup.rightRel_apply.mpr
        rw [mul_inv_rev, mul_inv_cancel_left]
        exact (N.subgroupOf P).inv_mem hν
      show (Quotient.mk _ (ν * z)).out = (Quotient.mk _ z).out
      rw [hq]
    let t : P → P := fun z => z * (r z)⁻¹
    have htν : ∀ ν ∈ N.subgroupOf P, ∀ z, t (ν * z) = ν * t z := by
      intro ν hν z
      show ν * z * (r (ν * z))⁻¹ = ν * (z * (r z)⁻¹)
      rw [hrν ν hν z, mul_assoc]
    let ρ : P → N := fun z => ⟨((t z : P) : Q), Subgroup.mem_subgroupOf.mp (hr z)⟩
    let fN : (Fin (a + 2) → N) → B := fun h => f (fun i => Subgroup.inclusion hNP (h i))
    obtain ⟨ψ₀, hψ₀eq, hψ₀d⟩ := hN a fN (fun g h => by
        show f (fun i => Subgroup.inclusion hNP (g * h i)) =
          g • f (fun i => Subgroup.inclusion hNP (h i))
        simp only [map_mul]
        exact hf (Subgroup.inclusion hNP g) (Subgroup.mem_subgroupOf.mpr g.2) _)
      (fun h => hcoc (fun i => Subgroup.inclusion hNP (h i)))
    let ψ₁ : (Fin (a + 1) → P) → B := fun x => ψ₀ (fun i => ρ (x i))
    have hψ₁eq : ∀ ν ∈ N.subgroupOf P, ∀ x : Fin (a + 1) → P,
        ψ₁ (fun i => ν * x i) = ν • ψ₁ x := by
      intro ν hν x
      have hρ : ∀ z, ρ (ν * z) = ⟨(ν : Q), Subgroup.mem_subgroupOf.mp hν⟩ * ρ z := by
        intro z
        apply Subtype.ext
        show ((t (ν * z) : P) : Q) = (ν : Q) * ((t z : P) : Q)
        rw [htν ν hν z]
        rfl
      show ψ₀ (fun i => ρ (ν * x i)) = ν • ψ₀ (fun i => ρ (x i))
      simp only [hρ]
      exact hψ₀eq _ _
    have hψ₁d : ∀ x, wcCobd a ψ₁ x = f (fun k => t (x k)) := fun x => hψ₀d (fun i => ρ (x i))
    have hW : ∀ x, wcCobd a (wcPrism t a f) x = f (fun k => t (x k)) * (f x)⁻¹ := by
      intro x
      have h := s2 P t a f x
      have h1 : wcPrism t (a + 1) (wcCobd (a + 1) f) x = 1 := by
        simp only [wcPrism, hcoc, one_zpow, Finset.prod_const_one]
      rw [h1, mul_one] at h
      exact h
    refine ⟨fun x => ψ₁ x * (wcPrism t a f x)⁻¹, fun ν hν x => ?_, fun x => ?_⟩
    · have hPeq : wcPrism t a f (fun i => ν * x i) = ν • wcPrism t a f x := by
        simp only [wcPrism, Finset.smul_prod']
        refine Finset.prod_congr rfl fun i _ => ?_
        rw [smul_zpow', ← hf ν hν]
        congr 2
        funext k
        split_ifs
        · rfl
        · exact htν ν hν _
      show ψ₁ (fun i => ν * x i) * (wcPrism t a f (fun i => ν * x i))⁻¹ =
        ν • (ψ₁ x * (wcPrism t a f x)⁻¹)
      rw [hψ₁eq ν hν x, hPeq, smul_mul', smul_inv']
    · have hm : wcCobd a (fun x => ψ₁ x * (wcPrism t a f x)⁻¹) x =
          wcCobd a ψ₁ x * (wcCobd a (wcPrism t a f) x)⁻¹ := by
        simp only [wcCobd, mul_zpow, inv_zpow, Finset.prod_mul_distrib, Finset.prod_inv_distrib]
      rw [hm, hψ₁d, hW, mul_inv, inv_inv, mul_inv_cancel_left]

  have s4 : ∀ (G : Type u) [Group G] [MulDistribMulAction G B] (N : Subgroup G),
      (∀ (a : ℕ) (f : (Fin (a + 2) → G) → B),
        (∀ ν ∈ N, ∀ x : Fin (a + 2) → G, f (fun i => ν * x i) = ν • f x) →
        (∀ x, wcCobd (a + 1) f x = 1) → ∃ f' : (Fin (a + 1) → G) → B,
          (∀ ν ∈ N, ∀ x : Fin (a + 1) → G, f' (fun i => ν * x i) = ν • f' x) ∧
          ∀ x, wcCobd a f' x = f x) →
      ∀ (m : ℕ) (F : (Fin (m + 2) → G) → G → B), wcLayerCochain N (m + 1) F →
      (∀ x y, wcLayerDh (m + 1) F x y = 1) → ∃ F' : (Fin (m + 1) → G) → G → B,
        wcLayerCochain N m F' ∧ ∀ x y, wcLayerDh m F' x y = F x y := by
    intro G _ _ N hV m F hF hD
    obtain ⟨f', hf'eq, hf'd⟩ := hV m (fun x => F x 1) (fun ν hν x => by
        have h1 := hF.1 ν x 1
        rw [mul_one] at h1
        have h2 := hF.2 (fun i => ν * x i) 1 ν hν
        rw [one_mul] at h2
        rw [← h2, h1]) (fun x => hD x 1)
    refine ⟨fun x y => y • f' (fun i => y⁻¹ * x i), ⟨fun g x y => ?_, fun x y ν hν => ?_⟩,
      fun x y => ?_⟩
    · simp only [mul_inv_rev, mul_assoc, inv_mul_cancel_left, mul_smul]
    · have h := hf'eq ν⁻¹ (N.inv_mem hν) (fun i => y⁻¹ * x i)
      simp only [mul_inv_rev, mul_assoc] at h ⊢
      rw [h, mul_smul, smul_inv_smul]
    · show wcCobd m (fun x' => y • f' (fun i => y⁻¹ * x' i)) x = F x y
      have hd := hf'd (fun i => y⁻¹ * x i)
      unfold wcCobd at hd ⊢
      simp_rw [← smul_zpow', ← Finset.smul_prod']
      rw [hd]
      have h1 := hF.1 y (fun i => y⁻¹ * x i) 1
      simp only [mul_inv_cancel_left, mul_one] at h1
      exact h1.symm

  have s5 : ∀ (G : Type u) [Group G] [MulDistribMulAction G B] (N : Subgroup G) (σ : G) (l : ℕ),
      (∀ g : G, ∃ i < l, (σ ^ i)⁻¹ * g ∈ N) → ∀ (m : ℕ) (F : (Fin (m + 1) → G) → G → B),
      wcLayerCochain N m F → (∀ x y, wcLayerT σ F x y = 1) → ∀ x y, F x y = F x 1 := by
    intro G _ _ N σ l hCov m F hF hT x y
    have h1 : ∀ w, F x (w * σ) = F x w := fun w => mul_inv_eq_one.mp (hT x w)
    have h2 : ∀ i : ℕ, F x (σ ^ i) = F x 1 := by
      intro i
      induction i with
      | zero => rw [pow_zero]
      | succ i ih => rw [pow_succ, h1, ih]
    obtain ⟨i, -, hi⟩ := hCov y
    rw [← mul_inv_cancel_left (σ ^ i) y, hF.2 x _ _ hi, h2]

  have s6 : ∀ (G : Type u) [Group G] (N : Subgroup G) (σ : G) (l : ℕ),
      (∀ g : G, ∃ i < l, (σ ^ i)⁻¹ * g ∈ N) → (∀ i < l, σ ^ i ∈ N → i = 0) →
      ∃ k : G → ℕ, (∀ z, k z < l) ∧ (∀ z, (σ ^ k z)⁻¹ * z ∈ N) ∧
        ∀ (z : G) (i : ℕ), i < l → (σ ^ i)⁻¹ * z ∈ N → k z = i := by
    intro G _ N σ l hCov hU
    have key : ∀ (z : G) (i j : ℕ), i < l → (σ ^ i)⁻¹ * z ∈ N → (σ ^ j)⁻¹ * z ∈ N → j ≤ i →
        j = i := by
      intro z i j hi hzi hzj hji
      have hmem : σ ^ (i - j) ∈ N := by
        have hm := N.mul_mem hzj (N.inv_mem hzi)
        have hsplit : σ ^ i = σ ^ j * σ ^ (i - j) := by rw [← pow_add, Nat.add_sub_cancel' hji]
        rw [hsplit] at hm
        simpa only [mul_inv_rev, inv_inv, mul_assoc, mul_inv_cancel_left,
          inv_mul_cancel_left] using hm
      have := hU (i - j) (by omega) hmem
      omega
    refine ⟨fun z => Nat.find (hCov z), fun z => (Nat.find_spec (hCov z)).1,
      fun z => (Nat.find_spec (hCov z)).2, ?_⟩
    intro z i hi hzi
    exact key z i _ hi hzi (Nat.find_spec (hCov z)).2 (Nat.find_min' (hCov z) ⟨hi, hzi⟩)

  have s7 : ∀ (G : Type u) [Group G] [MulDistribMulAction G B] (N : Subgroup G) (σ : G) (l : ℕ)
      (k : G → ℕ), N.Normal → σ ^ l ∈ N → (∀ z, k z < l) → (∀ z, (σ ^ k z)⁻¹ * z ∈ N) →
      (∀ (z : G) (i : ℕ), i < l → (σ ^ i)⁻¹ * z ∈ N → k z = i) →
      ∀ (m : ℕ) (F : (Fin (m + 1) → G) → G → B), wcLayerCochain N m F →
      (∀ x y, wcLayerN σ l F x y = 1) → ∃ F' : (Fin (m + 1) → G) → G → B,
        wcLayerCochain N m F' ∧ ∀ x y, wcLayerT σ F' x y = F x y := by
    intro G _ _ N σ l k hN hσl hk1 hk2 hk3 m F hF hNF
    have kk1 : ∀ z ν, ν ∈ N → k (z * ν) = k z := by
      intro z ν hν
      apply hk3 _ _ (hk1 z)
      rw [← mul_assoc]
      exact N.mul_mem (hk2 z) hν
    have kk2 : ∀ z, k z + 1 < l → k (z * σ) = k z + 1 := by
      intro z hz
      apply hk3 _ _ hz
      have h := hN.conj_mem _ (hk2 z) σ⁻¹
      have e : σ⁻¹ * ((σ ^ k z)⁻¹ * z) * σ⁻¹⁻¹ = (σ ^ (k z + 1))⁻¹ * (z * σ) := by
        rw [pow_succ]; group
      rwa [e] at h
    have kk3 : ∀ z, k z + 1 = l → k (z * σ) = 0 := by
      intro z hz
      apply hk3 _ _ (by omega)
      have h := N.mul_mem hσl (hN.conj_mem _ (hk2 z) σ⁻¹)
      have e : σ ^ l * (σ⁻¹ * ((σ ^ k z)⁻¹ * z) * σ⁻¹⁻¹) = (σ ^ 0)⁻¹ * (z * σ) := by
        rw [← hz, pow_succ]; group
      rwa [e] at h
    have kk4 : ∀ x z, F x z = F x (x 0 * σ ^ k ((x 0)⁻¹ * z)) := by
      intro x z
      have h := hF.2 x (x 0 * σ ^ k ((x 0)⁻¹ * z)) _ (hk2 ((x 0)⁻¹ * z))
      rw [← h]
      congr 1
      group
    refine ⟨fun x y => ∏ j ∈ Finset.range (k ((x 0)⁻¹ * y)), F x (x 0 * σ ^ j),
      ⟨fun g x y => ?_, fun x y ν hν => ?_⟩, fun x y => ?_⟩
    · have hc : (g * x 0)⁻¹ * (g * y) = (x 0)⁻¹ * y := by group
      simp only [hc, Finset.smul_prod']
      refine Finset.prod_congr rfl fun j _ => ?_
      rw [← hF.1 g x (x 0 * σ ^ j), mul_assoc]
    · simp only
      rw [← mul_assoc, kk1 _ ν hν]
    · show (∏ j ∈ Finset.range (k ((x 0)⁻¹ * (y * σ))), F x (x 0 * σ ^ j)) *
        (∏ j ∈ Finset.range (k ((x 0)⁻¹ * y)), F x (x 0 * σ ^ j))⁻¹ = F x y
      rw [← mul_assoc]
      set z := (x 0)⁻¹ * y with hz
      rw [kk4 x y, ← hz]
      rcases Nat.lt_or_ge (k z + 1) l with hlt | hge
      · rw [kk2 z hlt, Finset.prod_range_succ, mul_comm, ← mul_assoc, inv_mul_cancel, one_mul]
      · have heq : k z + 1 = l := le_antisymm (hk1 z) hge
        rw [kk3 z heq, Finset.prod_range_zero, one_mul]
        have hn := hNF x (x 0)
        change ∏ i ∈ Finset.range l, F x (x 0 * σ ^ i) = 1 at hn
        rw [← heq, Finset.prod_range_succ] at hn
        exact inv_eq_of_mul_eq_one_right hn

  have s8 : ∀ (G : Type u) [Group G] [MulDistribMulAction G B] (N : Subgroup G) (σ : G) (l : ℕ)
      (k : G → ℕ), (∀ z, k z < l) → (∀ z, (σ ^ k z)⁻¹ * z ∈ N) →
      (∀ (z : G) (i : ℕ), i < l → (σ ^ i)⁻¹ * z ∈ N → k z = i) →
      ∀ (m : ℕ) (F : (Fin (m + 1) → G) → G → B), wcLayerCochain N m F →
      (∀ x y, wcLayerT σ F x y = 1) → ∃ F' : (Fin (m + 1) → G) → G → B,
        wcLayerCochain N m F' ∧ ∀ x y, wcLayerN σ l F' x y = F x y := by
    intro G _ _ N σ l k hk1 hk2 hk3 m F hF hT
    have h1 : ∀ x w, F x (w * σ) = F x w := fun x w => mul_inv_eq_one.mp (hT x w)
    have h2 : ∀ x w (i : ℕ), F x (w * σ ^ i) = F x w := by
      intro x w i
      induction i with
      | zero => rw [pow_zero, mul_one]
      | succ i ih => rw [pow_succ, ← mul_assoc, h1, ih]
    refine ⟨fun x y => if (x 0)⁻¹ * y ∈ N then F x y else 1,
      ⟨fun g x y => ?_, fun x y ν hν => ?_⟩, fun x y => ?_⟩
    · have hc : (g * x 0)⁻¹ * (g * y) = (x 0)⁻¹ * y := by group
      simp only [hc]
      split_ifs
      · exact hF.1 g x y
      · exact (smul_one g).symm
    · have hc : (x 0)⁻¹ * (y * ν) ∈ N ↔ (x 0)⁻¹ * y ∈ N := by
        rw [← mul_assoc]
        exact ⟨fun h => by simpa using N.mul_mem h (N.inv_mem hν), fun h => N.mul_mem h hν⟩
      simp only [hc, hF.2 x y ν hν]
    · show ∏ i ∈ Finset.range l, (if (x 0)⁻¹ * (y * σ ^ i) ∈ N then F x (y * σ ^ i) else 1) =
        F x y
      set z := (x 0)⁻¹ * y with hz
      have hmem : ∀ i, (x 0)⁻¹ * (y * σ ^ i) ∈ N ↔ (σ ^ i)⁻¹ * z⁻¹ ∈ N := by
        intro i
        rw [← N.inv_mem_iff]
        simp only [hz, mul_inv_rev, inv_inv, mul_assoc]
      rw [Finset.prod_eq_single (k z⁻¹)]
      · rw [if_pos ((hmem _).mpr (hk2 _)), h2]
      · intro i hi hne
        rw [if_neg]
        intro hin
        exact hne (hk3 _ i (Finset.mem_range.mp hi) ((hmem i).mp hin)).symm
      · intro hn
        exact absurd (Finset.mem_range.mpr (hk1 _)) hn

  have s9 : ∀ (G : Type u) [Group G] [MulDistribMulAction G B] (N : Subgroup G)
      (F : (Fin 1 → G) → G → B), wcLayerCochain N 0 F → (∀ x y, wcLayerDh 0 F x y = 1) →
      ∃ β : B, (∀ ν ∈ N, ν • β = β) ∧ ∀ x y, F x y = y • β := by
    intro G _ _ N F hF hD
    have hind : ∀ (u v y : G), F (fun _ => u) y = F (fun _ => v) y := by
      intro u v y
      have e0 : (fun l : Fin 1 => (![v, u] : Fin 2 → G) ((0 : Fin 2).succAbove l)) =
          fun _ => u := by
        funext l; fin_cases l; rfl
      have e1 : (fun l : Fin 1 => (![v, u] : Fin 2 → G) ((1 : Fin 2).succAbove l)) =
          fun _ => v := by
        funext l; fin_cases l; rfl
      have hh := hD ![v, u] y
      change ∏ j : Fin 2, F (fun l => (![v, u] : Fin 2 → G) (j.succAbove l)) y ^
        ((-1 : ℤ) ^ (j : ℕ)) = 1 at hh
      rw [Fin.prod_univ_two, e0, e1] at hh
      simp only [Fin.val_zero, Fin.val_one, pow_zero, pow_one, zpow_one, zpow_neg] at hh
      exact mul_inv_eq_one.mp hh
    have hx : ∀ x : Fin 1 → G, x = fun _ => x 0 := fun x =>
      funext fun i => by rw [Subsingleton.elim i 0]
    have heq : ∀ y, F (fun _ => y) y = y • F (fun _ => 1) 1 := by
      intro y
      have hh := hF.1 y (fun _ => 1) 1
      simp only [mul_one] at hh
      exact hh
    refine ⟨F (fun _ => 1) 1, fun ν hν => ?_, fun x y => ?_⟩
    · rw [← heq ν]
      have hh := hF.2 (fun _ => ν) 1 ν hν
      rw [one_mul] at hh
      rw [hh, hind ν 1 1]
    · rw [hx x, hind (x 0) y y, heq y]

  have s10 : ∀ (G : Type u) [Group G] [MulDistribMulAction G B] (N : Subgroup G) (σ : G) (l : ℕ),
      N.Normal → σ ^ l ∈ N → (∀ g : G, ∃ i < l, (σ ^ i)⁻¹ * g ∈ N) →
      (∀ (m : ℕ) (φ : (Fin (m + 1) → G) → B) (x : Fin (m + 3) → G),
        wcCobd (m + 1) (wcCobd m φ) x = 1) →
      (∀ (m : ℕ) (F : (Fin (m + 2) → G) → G → B), wcLayerCochain N (m + 1) F →
        (∀ x y, wcLayerDh (m + 1) F x y = 1) → ∃ F' : (Fin (m + 1) → G) → G → B,
          wcLayerCochain N m F' ∧ ∀ x y, wcLayerDh m F' x y = F x y) →
      (∀ (m : ℕ) (F : (Fin (m + 1) → G) → G → B), wcLayerCochain N m F →
        (∀ x y, wcLayerT σ F x y = 1) → ∀ x y, F x y = F x 1) →
      (∀ (m : ℕ) (F : (Fin (m + 1) → G) → G → B), wcLayerCochain N m F →
        (∀ x y, wcLayerN σ l F x y = 1) → ∃ F' : (Fin (m + 1) → G) → G → B,
          wcLayerCochain N m F' ∧ ∀ x y, wcLayerT σ F' x y = F x y) →
      (∀ (m : ℕ) (F : (Fin (m + 1) → G) → G → B), wcLayerCochain N m F →
        (∀ x y, wcLayerT σ F x y = 1) → ∃ F' : (Fin (m + 1) → G) → G → B,
          wcLayerCochain N m F' ∧ ∀ x y, wcLayerN σ l F' x y = F x y) →
      (∀ F : (Fin 1 → G) → G → B, wcLayerCochain N 0 F → (∀ x y, wcLayerDh 0 F x y = 1) →
        ∃ β : B, (∀ ν ∈ N, ν • β = β) ∧ ∀ x y, F x y = y • β) →
      (∀ a : B, (∀ g : G, g • a = a) → ∃ b : B, (∀ ν ∈ N, ν • b = b) ∧
        ∏ i ∈ Finset.range l, (σ ^ i) • b = a) →
      (∀ b : B, (∀ ν ∈ N, ν • b = b) → ∏ i ∈ Finset.range l, (σ ^ i) • b = 1 →
        ∃ c : B, (∀ ν ∈ N, ν • c = c) ∧ b = (σ • c) * c⁻¹) →
      wcGrpCohVanish G B := by
    intro G _ _ N σ l hNrm hσl hCov DD Row Col0 KN KT Edge Nm H90
    have mulP : ∀ {m : ℕ} {F1 F2 : (Fin (m + 1) → G) → G → B}, wcLayerCochain N m F1 →
        wcLayerCochain N m F2 → wcLayerCochain N m (fun x y => F1 x y * (F2 x y)⁻¹) := by
      intro m F1 F2 h1 h2
      refine ⟨fun g x y => ?_, fun x y ν hν => ?_⟩
      · beta_reduce
        rw [h1.1, h2.1, smul_mul', smul_inv']
      · beta_reduce
        rw [h1.2 x y ν hν, h2.2 x y ν hν]
    have TP : ∀ {m : ℕ} {F : (Fin (m + 1) → G) → G → B}, wcLayerCochain N m F →
        wcLayerCochain N m (wcLayerT σ F) := by
      intro m F h
      refine ⟨fun g x y => ?_, fun x y ν hν => ?_⟩
      · simp only [wcLayerT]
        rw [mul_assoc, h.1, h.1, smul_mul', smul_inv']
      · simp only [wcLayerT]
        have hc : σ⁻¹ * ν * σ ∈ N := by simpa using hNrm.conj_mem ν hν σ⁻¹
        rw [h.2 x y ν hν, show y * ν * σ = y * σ * (σ⁻¹ * ν * σ) by group, h.2 x _ _ hc]
    have NP : ∀ {m : ℕ} {F : (Fin (m + 1) → G) → G → B}, wcLayerCochain N m F →
        wcLayerCochain N m (wcLayerN σ l F) := by
      intro m F h
      refine ⟨fun g x y => ?_, fun x y ν hν => ?_⟩
      · simp only [wcLayerN, Finset.smul_prod']
        refine Finset.prod_congr rfl fun i _ => ?_
        rw [mul_assoc, h.1]
      · simp only [wcLayerN]
        refine Finset.prod_congr rfl fun i _ => ?_
        have hc : (σ ^ i)⁻¹ * ν * σ ^ i ∈ N := by simpa using hNrm.conj_mem ν hν (σ ^ i)⁻¹
        rw [show y * ν * σ ^ i = y * σ ^ i * ((σ ^ i)⁻¹ * ν * σ ^ i) by group, h.2 x _ _ hc]
    have DhP : ∀ {m : ℕ} {F : (Fin (m + 1) → G) → G → B}, wcLayerCochain N m F →
        wcLayerCochain N (m + 1) (wcLayerDh m F) := by
      intro m F h
      refine ⟨fun g x y => ?_, fun x y ν hν => ?_⟩
      · simp only [wcLayerDh, wcCobd, Finset.smul_prod', smul_zpow']
        refine Finset.prod_congr rfl fun j _ => ?_
        rw [h.1 g (fun l => x (j.succAbove l)) y]
      · simp only [wcLayerDh, wcCobd]
        refine Finset.prod_congr rfl fun j _ => ?_
        rw [h.2 _ y ν hν]
    have dhT : ∀ {m : ℕ} (F : (Fin (m + 1) → G) → G → B),
        wcLayerDh m (wcLayerT σ F) = wcLayerT σ (wcLayerDh m F) := by
      intro m F
      funext x y
      simp only [wcLayerDh, wcLayerT, wcCobd, mul_zpow, inv_zpow, Finset.prod_mul_distrib,
        Finset.prod_inv_distrib]
    have dhN : ∀ {m : ℕ} (F : (Fin (m + 1) → G) → G → B),
        wcLayerDh m (wcLayerN σ l F) = wcLayerN σ l (wcLayerDh m F) := by
      intro m F
      funext x y
      simp only [wcLayerDh, wcLayerN, wcCobd, ← Finset.prod_zpow]
      rw [Finset.prod_comm]
    have dhMul : ∀ {m : ℕ} (F1 F2 : (Fin (m + 1) → G) → G → B),
        wcLayerDh m (fun x y => F1 x y * (F2 x y)⁻¹) =
          fun x y => wcLayerDh m F1 x y * (wcLayerDh m F2 x y)⁻¹ := by
      intro m F1 F2
      funext x y
      simp only [wcLayerDh, wcCobd, mul_zpow, inv_zpow, Finset.prod_mul_distrib,
        Finset.prod_inv_distrib]
    have TMul : ∀ {m : ℕ} (F1 F2 : (Fin (m + 1) → G) → G → B),
        wcLayerT σ (fun x y => F1 x y * (F2 x y)⁻¹) =
          fun x y => wcLayerT σ F1 x y * (wcLayerT σ F2 x y)⁻¹ := by
      intro m F1 F2
      funext x y
      simp only [wcLayerT, mul_inv, inv_inv]
      ac_rfl
    have NMul : ∀ {m : ℕ} (F1 F2 : (Fin (m + 1) → G) → G → B),
        wcLayerN σ l (fun x y => F1 x y * (F2 x y)⁻¹) =
          fun x y => wcLayerN σ l F1 x y * (wcLayerN σ l F2 x y)⁻¹ := by
      intro m F1 F2
      funext x y
      simp only [wcLayerN, Finset.prod_mul_distrib, Finset.prod_inv_distrib]
    have TNT : ∀ {m : ℕ} {F : (Fin (m + 1) → G) → G → B}, wcLayerCochain N m F →
        ∀ x y, wcLayerN σ l (wcLayerT σ F) x y = 1 := by
      intro m F h x y
      simp only [wcLayerN, wcLayerT]
      have e : ∀ i, F x (y * σ ^ i * σ) * (F x (y * σ ^ i))⁻¹ =
          (fun i => F x (y * σ ^ i)) (i + 1) / (fun i => F x (y * σ ^ i)) i := by
        intro i
        show _ = F x (y * σ ^ (i + 1)) / F x (y * σ ^ i)
        rw [pow_succ, ← mul_assoc, div_eq_mul_inv]
      rw [Finset.prod_congr rfl (fun i _ => e i),
        Finset.prod_range_div (fun i => F x (y * σ ^ i)) l]
      show F x (y * σ ^ l) / F x (y * σ ^ 0) = 1
      rw [pow_zero, mul_one, h.2 x y _ hσl, div_self']
    have NTN : ∀ {m : ℕ} {F : (Fin (m + 1) → G) → G → B}, wcLayerCochain N m F →
        ∀ x y, wcLayerT σ (wcLayerN σ l F) x y = 1 := by
      intro m F h x y
      simp only [wcLayerN, wcLayerT]
      rw [← div_eq_mul_inv, ← Finset.prod_div_distrib]
      have e : ∀ i, F x (y * σ * σ ^ i) / F x (y * σ ^ i) =
          (fun i => F x (y * σ ^ i)) (i + 1) / (fun i => F x (y * σ ^ i)) i := by
        intro i
        show _ = F x (y * σ ^ (i + 1)) / F x (y * σ ^ i)
        rw [pow_succ', mul_assoc]
      rw [Finset.prod_congr rfl (fun i _ => e i),
        Finset.prod_range_div (fun i => F x (y * σ ^ i)) l]
      show F x (y * σ ^ l) / F x (y * σ ^ 0) = 1
      rw [pow_zero, mul_one, h.2 x y _ hσl, div_self']
    have eP : ∀ {m : ℕ} (c : B), (∀ ν ∈ N, ν • c = c) →
        wcLayerCochain N m (fun (_ : Fin (m + 1) → G) (y : G) => y • c) :=
      fun c hc => ⟨fun g x y => mul_smul g y c, fun x y ν hν => by
        beta_reduce
        rw [mul_smul, hc ν hν]⟩
    have eDh : ∀ (c : B) (x : Fin (0 + 2) → G) (y : G),
        wcLayerDh 0 (fun (_ : Fin (0 + 1) → G) (y : G) => y • c) x y = 1 := by
      intro c x y
      show ∏ j : Fin 2, (y • c) ^ ((-1 : ℤ) ^ (j : ℕ)) = 1
      rw [Fin.prod_univ_two]
      simp
    have C : ∀ m : ℕ,
        (∀ E : (Fin (m + 1) → G) → G → B, wcLayerCochain N m E →
          (∀ x y, wcLayerDh m (wcLayerT σ E) x y = 1) →
          ∃ E', wcLayerCochain N m E' ∧ (∀ x y, wcLayerT σ E' x y = 1) ∧
            wcLayerDh m E' = wcLayerDh m E) ∧
        (∀ E : (Fin (m + 1) → G) → G → B, wcLayerCochain N m E →
          (∀ x y, wcLayerDh m (wcLayerN σ l E) x y = 1) →
          ∃ E', wcLayerCochain N m E' ∧ (∀ x y, wcLayerN σ l E' x y = 1) ∧
            wcLayerDh m E' = wcLayerDh m E) := by
      intro m
      induction m with
      | zero =>
        refine ⟨fun E hE hd => ?_, fun E hE hd => ?_⟩
        · obtain ⟨β, hβN, hβ⟩ := Edge _ (TP hE) hd
          have hprod : ∏ i ∈ Finset.range l, (σ ^ i) • β = 1 := by
            have h := TNT hE (fun _ => 1) 1
            simp only [wcLayerN, hβ, one_mul] at h
            exact h
          obtain ⟨c, hcN, hc⟩ := H90 β hβN hprod
          refine ⟨fun x y => E x y * (y • c)⁻¹, mulP hE (eP c hcN), fun x y => ?_, ?_⟩
          · rw [TMul E (fun _ y => y • c)]
            show wcLayerT σ E x y *
              (wcLayerT σ (fun (_ : Fin (0 + 1) → G) (y : G) => y • c) x y)⁻¹ = 1
            rw [hβ x y, hc]
            simp only [wcLayerT]
            rw [smul_mul', smul_inv', mul_smul, mul_inv_cancel]
          · rw [dhMul E (fun _ y => y • c)]
            funext x y
            show wcLayerDh 0 E x y *
              (wcLayerDh 0 (fun (_ : Fin (0 + 1) → G) (y : G) => y • c) x y)⁻¹ =
                wcLayerDh 0 E x y
            rw [eDh, inv_one, mul_one]
        · obtain ⟨β, hβN, hβ⟩ := Edge _ (NP hE) hd
          have hσβ : σ • β = β := by
            have h := NTN hE (fun _ => 1) 1
            simp only [wcLayerT, hβ, one_mul, one_smul] at h
            exact mul_inv_eq_one.mp h
          have hpow : ∀ i : ℕ, (σ ^ i) • β = β := by
            intro i
            induction i with
            | zero => rw [pow_zero, one_smul]
            | succ i ih => rw [pow_succ, mul_smul, hσβ, ih]
          have hinv : ∀ g : G, g • β = β := by
            intro g
            obtain ⟨i, -, hi⟩ := hCov g
            rw [← mul_inv_cancel_left (σ ^ i) g, mul_smul, hβN _ hi, hpow]
          obtain ⟨b, hbN, hb⟩ := Nm β hinv
          refine ⟨fun x y => E x y * (y • b)⁻¹, mulP hE (eP b hbN), fun x y => ?_, ?_⟩
          · rw [NMul E (fun _ y => y • b)]
            show wcLayerN σ l E x y *
              (wcLayerN σ l (fun (_ : Fin (0 + 1) → G) (y : G) => y • b) x y)⁻¹ = 1
            rw [hβ x y]
            simp only [wcLayerN, mul_smul]
            rw [← Finset.smul_prod', hb, mul_inv_cancel]
          · rw [dhMul E (fun _ y => y • b)]
            funext x y
            show wcLayerDh 0 E x y *
              (wcLayerDh 0 (fun (_ : Fin (0 + 1) → G) (y : G) => y • b) x y)⁻¹ =
                wcLayerDh 0 E x y
            rw [eDh, inv_one, mul_one]
      | succ m ih =>
        refine ⟨fun E hE hd => ?_, fun E hE hd => ?_⟩
        · obtain ⟨D, hD, hDd⟩ := Row m (wcLayerT σ E) (TP hE) hd
          have hDf : wcLayerDh m D = wcLayerT σ E := funext fun x => funext fun y => hDd x y
          have hNd : ∀ x y, wcLayerDh m (wcLayerN σ l D) x y = 1 := by
            intro x y
            rw [dhN, hDf]
            exact TNT hE x y
          obtain ⟨D', hD', hD'N, hD'd⟩ := ih.2 D hD hNd
          obtain ⟨D'', hD'', hD''T⟩ := KN m D' hD' hD'N
          have hD''f : wcLayerT σ D'' = D' := funext fun x => funext fun y => hD''T x y
          refine ⟨fun x y => E x y * (wcLayerDh m D'' x y)⁻¹, mulP hE (DhP hD''),
            fun x y => ?_, ?_⟩
          · rw [TMul E (wcLayerDh m D''), ← dhT, hD''f, hD'd, hDf]
            exact mul_inv_cancel _
          · rw [dhMul E (wcLayerDh m D'')]
            funext x y
            show wcLayerDh (m + 1) E x y * (wcLayerDh (m + 1) (wcLayerDh m D'') x y)⁻¹ =
              wcLayerDh (m + 1) E x y
            rw [show wcLayerDh (m + 1) (wcLayerDh m D'') x y = 1 from
              DD m (fun x' => D'' x' y) x, inv_one, mul_one]
        · obtain ⟨D, hD, hDd⟩ := Row m (wcLayerN σ l E) (NP hE) hd
          have hDf : wcLayerDh m D = wcLayerN σ l E := funext fun x => funext fun y => hDd x y
          have hTd : ∀ x y, wcLayerDh m (wcLayerT σ D) x y = 1 := by
            intro x y
            rw [dhT, hDf]
            exact NTN hE x y
          obtain ⟨D', hD', hD'T, hD'd⟩ := ih.1 D hD hTd
          obtain ⟨D'', hD'', hD''N⟩ := KT m D' hD' hD'T
          have hD''f : wcLayerN σ l D'' = D' := funext fun x => funext fun y => hD''N x y
          refine ⟨fun x y => E x y * (wcLayerDh m D'' x y)⁻¹, mulP hE (DhP hD''),
            fun x y => ?_, ?_⟩
          · rw [NMul E (wcLayerDh m D''), ← dhN, hD''f, hD'd, hDf]
            exact mul_inv_cancel _
          · rw [dhMul E (wcLayerDh m D'')]
            funext x y
            show wcLayerDh (m + 1) E x y * (wcLayerDh (m + 1) (wcLayerDh m D'') x y)⁻¹ =
              wcLayerDh (m + 1) E x y
            rw [show wcLayerDh (m + 1) (wcLayerDh m D'') x y = 1 from
              DD m (fun x' => D'' x' y) x, inv_one, mul_one]
    intro pp φ hφ hcoc
    let F0 : (Fin (pp + 2) → G) → G → B := fun x _ => φ x
    have hF0 : wcLayerCochain N (pp + 1) F0 := ⟨fun g x _ => hφ g x, fun _ _ _ _ => rfl⟩
    obtain ⟨D, hD, hDd⟩ := Row pp F0 hF0 (fun x _ => hcoc x)
    have hDf : wcLayerDh pp D = F0 := funext fun x => funext fun y => hDd x y
    have hTd : ∀ x y, wcLayerDh pp (wcLayerT σ D) x y = 1 := by
      intro x y
      rw [dhT, hDf]
      exact mul_inv_cancel _
    obtain ⟨E', hE', hE'T, hE'd⟩ := (C pp).1 D hD hTd
    refine ⟨fun x => E' x 1, fun g x => ?_, fun h => ?_⟩
    · show E' (fun l => g * x l) 1 = g • E' x 1
      rw [← Col0 pp E' hE' hE'T (fun l => g * x l) (g * 1), hE'.1 g x 1]
    · show wcLayerDh pp E' h 1 = φ h
      rw [hE'd, hDf]

  have he : ∀ (a : B) (m : ℕ), (∏ j ∈ Finset.range (2 * m), a ^ ((-1 : ℤ) ^ j) = 1) ∧
      ∏ j ∈ Finset.range (2 * m + 1), a ^ ((-1 : ℤ) ^ j) = a := by
    intro a m
    induction m with
    | zero => simp
    | succ m ih =>
      have h2 : ∏ j ∈ Finset.range (2 * (m + 1)), a ^ ((-1 : ℤ) ^ j) = 1 := by
        rw [show 2 * (m + 1) = (2 * m + 1) + 1 by ring, Finset.prod_range_succ, ih.2,
          Odd.neg_one_pow ⟨m, rfl⟩, zpow_neg_one, mul_inv_cancel]
      refine ⟨h2, ?_⟩
      rw [Finset.prod_range_succ, h2, Even.neg_one_pow ⟨m + 1, by ring⟩, zpow_one, one_mul]
  have s11 : ∀ (G : Type u) [Group G] [MulDistribMulAction G B], Subsingleton G →
      wcGrpCohVanish G B := by
    intro G _ _ hG pp φ hφ hcoc
    have hφc : ∀ h, φ h = φ (fun _ => 1) := fun h => by
      rw [show h = (fun _ => 1) from funext fun _ => Subsingleton.elim _ _]
    generalize φ (fun _ => 1) = a at hφc
    have hcoc1 := hcoc (fun _ => 1)
    simp only [hφc] at hcoc1
    have hr3 : ∏ j : Fin (pp + 3), a ^ ((-1 : ℤ) ^ (j : ℕ)) =
        ∏ j ∈ Finset.range (pp + 3), a ^ ((-1 : ℤ) ^ j) :=
      Fin.prod_univ_eq_prod_range (fun j => a ^ ((-1 : ℤ) ^ j)) (pp + 3)
    have hr2 : ∏ j : Fin (pp + 2), a ^ ((-1 : ℤ) ^ (j : ℕ)) =
        ∏ j ∈ Finset.range (pp + 2), a ^ ((-1 : ℤ) ^ j) :=
      Fin.prod_univ_eq_prod_range (fun j => a ^ ((-1 : ℤ) ^ j)) (pp + 2)
    rw [hr3] at hcoc1
    rcases Nat.even_or_odd pp with ⟨m, hm⟩ | ⟨m, hm⟩
    · rw [show pp + 3 = 2 * (m + 1) + 1 by omega, (he a (m + 1)).2] at hcoc1
      refine ⟨fun _ => 1, fun g h => (smul_one g).symm, fun h => ?_⟩
      rw [hφc h, hcoc1]
      simp
    · refine ⟨fun _ => a, fun g h => by rw [Subsingleton.elim g 1, one_smul], fun h => ?_⟩
      rw [hφc h, hr2, show pp + 2 = 2 * (m + 1) + 1 by omega, (he a (m + 1)).2]

  have s12 : ∀ (P : Subgroup Q), IsPGroup p P → Nat.card P ≠ 1 → ∃ N : Subgroup Q, N ≤ P ∧
      Nat.card N < Nat.card P ∧ (N.subgroupOf P).Normal ∧ N.relIndex P = p := by
    intro P hP h1
    obtain ⟨n, hn⟩ := hP.exists_card_eq
    obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := by
      cases n with
      | zero => exact absurd (by simpa using hn) h1
      | succ n' => exact ⟨n', rfl⟩
    obtain ⟨K, hK⟩ := Sylow.exists_subgroup_card_pow_prime (G := P) p (n := n')
      (by rw [hn]; exact pow_dvd_pow p (Nat.le_succ n'))
    have hKidx : K.index = p := by
      have hh := K.card_mul_index
      rw [hK, hn, pow_succ] at hh
      exact Nat.eq_of_mul_eq_mul_left (pow_pos hp.out.pos n') hh
    have hcoatom : ∀ H : Subgroup P, K < H → H = ⊤ := by
      intro H hKH
      have hlt := Subgroup.card_lt_of_lt hKH
      have hdvd : Nat.card H ∣ p ^ (n' + 1) := hn ▸ Subgroup.card_subgroup_dvd_card H
      obtain ⟨j, hj, hHj⟩ := (Nat.dvd_prime_pow hp.out).mp hdvd
      rw [hK, hHj] at hlt
      have hj' : n' < j := (Nat.pow_lt_pow_iff_right hp.out.one_lt).mp hlt
      apply Subgroup.eq_top_of_card_eq
      rw [hHj, hn, show j = n' + 1 by omega]
    have hKnorm : K.Normal := by
      have := hP.isNilpotent
      have hKtop : K < ⊤ := by
        refine lt_of_le_of_ne le_top fun h => ?_
        rw [h, Subgroup.index_top] at hKidx
        exact hp.out.one_lt.ne hKidx
      have hh := Group.normalizerCondition_of_isNilpotent K hKtop
      exact Subgroup.normalizer_eq_top_iff.mp (hcoatom _ hh)
    have hsub : (K.map P.subtype).subgroupOf P = K :=
      Subgroup.comap_map_eq_self_of_injective P.subtype_injective K
    refine ⟨K.map P.subtype, Subgroup.map_subtype_le K, ?_, ?_, ?_⟩
    · rw [Subgroup.card_map_of_injective P.subtype_injective, hK, hn]
      exact Nat.pow_lt_pow_right hp.out.one_lt (Nat.lt_succ_self n')
    · rw [hsub]; exact hKnorm
    · show ((K.map P.subtype).subgroupOf P).index = p
      rw [hsub, hKidx]

  have s13 : ∀ (G : Type u) [Group G] (N : Subgroup G) (σ : G) (l : ℕ), N.Normal → N.index = l →
      l.Prime → σ ∉ N → σ ^ l ∈ N ∧ (∀ g : G, ∃ i < l, (σ ^ i)⁻¹ * g ∈ N) ∧
        (∀ i < l, σ ^ i ∈ N → i = 0) := by
    intro G _ N σ l hN hidx hl hσ
    have hcard : Nat.card (G ⧸ N) = l := by rw [← hidx]; exact (Subgroup.index_eq_card N).symm
    have : Finite (G ⧸ N) := Nat.finite_of_card_ne_zero (by rw [hcard]; exact hl.ne_zero)
    have hord : orderOf (σ : G ⧸ N) = l := by
      have hd : orderOf (σ : G ⧸ N) ∣ l := hcard ▸ orderOf_dvd_natCard _
      rcases (Nat.dvd_prime hl).mp hd with h | h
      · exfalso; apply hσ
        rw [orderOf_eq_one_iff, QuotientGroup.eq_one_iff] at h
        exact h
      · exact h
    refine ⟨?_, ?_, ?_⟩
    · rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow, ← hord, pow_orderOf_eq_one]
    · intro g
      have htop : Subgroup.zpowers (σ : G ⧸ N) = ⊤ :=
        Subgroup.eq_top_of_card_eq _ (by rw [Nat.card_zpowers, hord, hcard])
      have hg : (g : G ⧸ N) ∈ Subgroup.zpowers (σ : G ⧸ N) := htop ▸ Subgroup.mem_top _
      obtain ⟨z, hz⟩ := Subgroup.mem_zpowers_iff.mp hg
      have hl0 : (0 : ℤ) < l := by exact_mod_cast hl.pos
      have h0 := Int.emod_nonneg z hl0.ne'
      have h1 := Int.emod_lt_of_pos z hl0
      refine ⟨(z % l).toNat, ?_, ?_⟩
      · generalize z % (l : ℤ) = r at h0 h1
        omega
      · rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_mul, QuotientGroup.mk_inv,
          QuotientGroup.mk_pow, inv_mul_eq_one, ← hz, ← zpow_natCast, Int.toNat_of_nonneg h0]
        conv_lhs => rw [← hord]
        rw [zpow_mod_orderOf]
    · intro i hi hσi
      have h1 : (σ : G ⧸ N) ^ i = 1 := by
        rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]; exact hσi
      have hdvd := orderOf_dvd_of_pow_eq_one h1
      rw [hord] at hdvd
      exact Nat.eq_zero_of_dvd_of_lt hdvd hi

  suffices H : ∀ n, ∀ P : Subgroup Q, Nat.card P = n → IsPGroup p P → wcGrpCohVanish P B by
    intro P hP
    exact H _ P rfl hP
  intro n
  induction n using Nat.strong_induction_on with
  | _ n IH =>
  intro P hn hP
  by_cases h1 : Nat.card P = 1
  · exact s11 P (Nat.card_eq_one_iff_unique.mp h1).1
  obtain ⟨N, hNP, hcard, hnorm, hrel⟩ := s12 P hP h1
  have hN : wcGrpCohVanish N B := IH _ (by rw [← hn]; exact hcard) N rfl (hP.to_le hNP)
  obtain ⟨σ, hσP, hσN⟩ : ∃ σ ∈ P, σ ∉ N := by
    by_contra hcon
    have hcon' : P ≤ N := fun x hx => by
      by_contra hxN
      exact hcon ⟨x, hx, hxN⟩
    have hPN : P = N := le_antisymm hcon' hNP
    rw [hPN] at hcard
    exact lt_irrefl _ hcard
  obtain ⟨hNm, hH90⟩ := hc P N hNP hnorm (by rw [hrel]; exact hp.out) σ hσP hσN
  rw [hrel] at hNm hH90
  let σ' : P := ⟨σ, hσP⟩
  have hσ'H : σ' ∉ N.subgroupOf P := hσN
  have hidx : (N.subgroupOf P).index = p := hrel
  obtain ⟨hσl, hCov, hUniq⟩ := s13 P (N.subgroupOf P) σ' p hnorm hidx hp.out hσ'H
  obtain ⟨k, hk1, hk2, hk3⟩ := s6 P (N.subgroupOf P) σ' p hCov hUniq
  have hpow : ∀ (i : ℕ) (b : B), (σ' ^ i) • b = (σ ^ i) • b := fun i b => by
    rw [Subgroup.smul_def, Subgroup.coe_pow]
  have hNm' : ∀ a : B, (∀ g : P, g • a = a) → ∃ b : B, (∀ ν ∈ N.subgroupOf P, ν • b = b) ∧
      ∏ i ∈ Finset.range p, (σ' ^ i) • b = a := by
    intro a ha
    obtain ⟨b, hb, hb'⟩ := hNm a (fun h hh => ha ⟨h, hh⟩)
    refine ⟨b, fun ν hν => hb ν hν, ?_⟩
    simp only [hpow]
    exact hb'
  have hH90' : ∀ b : B, (∀ ν ∈ N.subgroupOf P, ν • b = b) →
      ∏ i ∈ Finset.range p, (σ' ^ i) • b = 1 →
      ∃ c : B, (∀ ν ∈ N.subgroupOf P, ν • c = c) ∧ b = (σ' • c) * c⁻¹ := by
    intro b hb hprod
    obtain ⟨c, hc1, hc2⟩ := hH90 b (fun n hn => hb ⟨n, hNP hn⟩ hn)
      (by simpa only [hpow] using hprod)
    exact ⟨c, fun ν hν => hc1 ν hν, hc2⟩
  have hRow := s4 P (N.subgroupOf P) (s3 P N hNP hN)
  exact s10 P (N.subgroupOf P) σ' p hnorm hσl hCov
    (fun m φ x => s1 P m φ x) hRow (s5 P (N.subgroupOf P) σ' p hCov)
    (s7 P (N.subgroupOf P) σ' p k hnorm hσl hk1 hk2 hk3)
    (s8 P (N.subgroupOf P) σ' p k hk1 hk2 hk3)
    (s9 P (N.subgroupOf P)) hNm' hH90'

theorem wc_grp_coh_vanish_of_sylow : ∀ (Q : Type u) (B : Type u) [Group Q] [Finite Q] [CommGroup B] [MulDistribMulAction Q B], (∀ (p : ℕ) [Fact p.Prime] (P : Sylow p Q), wcGrpCohVanish (P : Subgroup Q) B) → wcGrpCohVanish Q B :=
by
  intro Q B _ _ _ _ hSyl n φ hφ hcoc0
  have hcoc : ∀ h : Fin (n + 3) → Q, wcCobd (n + 1) φ h = 1 := hcoc0

  have cmul : ∀ (α β : (Fin (n + 1) → Q) → B) (h : Fin (n + 2) → Q),
      wcCobd n (fun x => α x * β x) h = wcCobd n α h * wcCobd n β h := by
    intro α β h
    unfold wcCobd
    simp only [mul_zpow, Finset.prod_mul_distrib]
  have cinv : ∀ (α : (Fin (n + 1) → Q) → B) (h : Fin (n + 2) → Q),
      wcCobd n (fun x => (α x)⁻¹) h = (wcCobd n α h)⁻¹ := by
    intro α h
    unfold wcCobd
    simp only [inv_zpow, Finset.prod_inv_distrib]
  have cone : ∀ (h : Fin (n + 2) → Q), wcCobd n (fun _ => (1 : B)) h = 1 := by
    intro h
    unfold wcCobd
    simp only [one_zpow, Finset.prod_const_one]
  have cprod : ∀ (C : Type u) [Fintype C] (F : C → (Fin (n + 1) → Q) → B) (h : Fin (n + 2) → Q),
      wcCobd n (fun x => ∏ c, F c x) h = ∏ c, wcCobd n (F c) h := by
    intro C _ F h
    unfold wcCobd
    simp only [← Finset.prod_zpow]
    exact Finset.prod_comm
  have csmul : ∀ (g : Q) (F : (Fin (n + 1) → Q) → B) (h : Fin (n + 2) → Q),
      wcCobd n (fun x => g • F x) h = g • wcCobd n F h := by
    intro g F h
    unfold wcCobd
    rw [Finset.smul_prod']
    simp only [smul_zpow']

  let I : AddSubgroup ℤ :=
    { carrier := {m | ∃ ψ : (Fin (n + 1) → Q) → B,
        (∀ (g : Q) (h : Fin (n + 1) → Q), ψ (fun l => g * h l) = g • ψ h) ∧
        ∀ h : Fin (n + 2) → Q, wcCobd n ψ h = φ h ^ m}
      zero_mem' := ⟨fun _ => 1, fun g h => (smul_one g).symm, fun h => by
        rw [cone, zpow_zero]⟩
      add_mem' := by
        rintro a b ⟨ψ₁, e₁, d₁⟩ ⟨ψ₂, e₂, d₂⟩
        refine ⟨fun x => ψ₁ x * ψ₂ x, fun g h => ?_, fun h => ?_⟩
        · simp only [e₁, e₂, smul_mul']
        · rw [cmul, d₁, d₂, zpow_add]
      neg_mem' := by
        rintro a ⟨ψ, e, d⟩
        refine ⟨fun x => (ψ x)⁻¹, fun g h => ?_, fun h => ?_⟩
        · simp only [e, smul_inv']
        · rw [cinv, d, zpow_neg] }

  have s5 : (∀ (p : ℕ) [Fact p.Prime] (P : Sylow p Q), ((P : Subgroup Q).index : ℤ) ∈ I) →
      (1 : ℤ) ∈ I := by
    intro hI
    obtain ⟨a, ha⟩ := Int.subgroup_cyclic I
    have hdiv : ∀ (p : ℕ) [Fact p.Prime] (P : Sylow p Q), a.natAbs ∣ (P : Subgroup Q).index := by
      intro p _ P
      have hm := hI p P
      rw [ha, AddSubgroup.mem_closure_singleton] at hm
      obtain ⟨k, hk⟩ := hm
      have : a ∣ ((P : Subgroup Q).index : ℤ) := ⟨k, by rw [← hk, smul_eq_mul, mul_comm]⟩
      exact Int.natCast_dvd_natCast.mp (Int.natAbs_dvd.mpr this)
    by_cases h1 : a.natAbs = 1
    · have haI : a ∈ I := by rw [ha]; exact AddSubgroup.subset_closure rfl
      rcases Int.natAbs_eq_iff.mp h1 with h | h
      · rw [h] at haI; exact_mod_cast haI
      · have := I.neg_mem haI
        rw [h, neg_neg] at this
        exact_mod_cast this
    · exfalso
      haveI : Fact (Nat.Prime a.natAbs.minFac) := ⟨Nat.minFac_prime h1⟩
      obtain ⟨P⟩ : Nonempty (Sylow a.natAbs.minFac Q) := inferInstance
      exact Sylow.not_dvd_index P (Nat.dvd_trans (Nat.minFac_dvd _) (hdiv _ P))

  have t2 : ∀ (X : Type u) (A : Type u) [CommGroup A] (t : X → X) (q : ℕ)
      (Φ : (Fin (q + 2) → X) → A) (g : Fin (q + 2) → X),
      wcCobd q (wcPrism t q Φ) g * wcPrism t (q + 1) (wcCobd (q + 1) Φ) g =
        Φ (fun k => t (g k)) * (Φ g)⁻¹ := by
    intro X A _ t q Φ g
    have hv : ∀ (n : ℕ) (j : Fin (n + 1)) (k : Fin n),
        ((j.succAbove k : Fin (n + 1)) : ℕ) = if (k : ℕ) < (j : ℕ) then (k : ℕ) else (k : ℕ) + 1 := by
      intro n j k
      unfold Fin.succAbove
      split_ifs with h1 h2 h2 <;> simp_all [Fin.lt_def]
    let δ : ℕ → ℕ → ℕ := fun j l => if l < j then l else l + 1
    let Pr : ℕ → (ℕ → X) → ℕ → X := fun i H m => if m ≤ i then H m else t (H (m - 1))
    let Mx : ℕ → (ℕ → X) → ℕ → X := fun i H m => if m < i then H m else t (H m)
    have R1 : ∀ (n : ℕ) (φ : (Fin (n + 1) → X) → A) (H : ℕ → X),
        wcCobd n φ (fun k => H k) =
          ∏ j ∈ Finset.range (n + 2), φ (fun l => H (δ j l)) ^ ((-1 : ℤ) ^ j) := by
      intro n φ H
      rw [← Fin.prod_univ_eq_prod_range (fun j => φ (fun l : Fin (n + 1) => H (δ j l)) ^ ((-1 : ℤ) ^ j))]
      unfold wcCobd
      refine Finset.prod_congr rfl fun j _ => ?_
      refine congrArg (· ^ _) (congrArg φ (funext fun l => ?_))
      show H ((j.succAbove l : Fin (n + 2)) : ℕ) = H (δ j l)
      rw [hv]
    have R2 : ∀ (q' : ℕ) (Φ' : (Fin (q' + 2) → X) → A) (H : ℕ → X),
        wcPrism t q' Φ' (fun k => H k) =
          ∏ i ∈ Finset.range (q' + 1), Φ' (fun k => Pr i H k) ^ ((-1 : ℤ) ^ i) := by
      intro q' Φ' H
      rw [← Fin.prod_univ_eq_prod_range (fun i => Φ' (fun k : Fin (q' + 2) => Pr i H k) ^ ((-1 : ℤ) ^ i))]
      unfold wcPrism
      refine Finset.prod_congr rfl fun i _ => ?_
      refine congrArg (· ^ _) (congrArg Φ' (funext fun k => ?_))
      show (if h : (k : ℕ) ≤ (i : ℕ) then H k else t (H ((k : ℕ) - 1))) = Pr i H k
      by_cases h : (k : ℕ) ≤ (i : ℕ) <;> simp [Pr, h]
    have eA : ∀ (i k : ℕ) (H : ℕ → X), k < i + 1 →
        (fun m => Pr (i + 1) H (δ k m)) = Pr i (fun m => H (δ k m)) := by
      intro i k H hk
      funext m
      simp only [Pr, δ]
      split_ifs <;> first | omega | rfl | (congr 1; omega) | (congr 2; omega)
    have eD : ∀ (i x : ℕ) (H : ℕ → X),
        (fun m => Pr i H (δ (i + (2 + x)) m)) = Pr i (fun m => H (δ (i + 1 + x) m)) := by
      intro i x H
      funext m
      simp only [Pr, δ]
      split_ifs <;> first | omega | rfl | (congr 1; omega) | (congr 2; omega)
    have eB : ∀ (i : ℕ) (H : ℕ → X), (fun m => Pr i H (δ i m)) = Mx i H := by
      intro i H
      funext m
      simp only [Pr, δ, Mx]
      split_ifs <;> first | omega | rfl | (congr 1; omega) | (congr 2; omega)
    have eC : ∀ (i : ℕ) (H : ℕ → X), (fun m => Pr i H (δ (i + 1) m)) = Mx (i + 1) H := by
      intro i H
      funext m
      simp only [Pr, δ, Mx]
      split_ifs <;> first | omega | rfl | (congr 1; omega) | (congr 2; omega)
    have key : ∀ (Ψ : (ℕ → X) → A) (G : ℕ → X) (n : ℕ),
        (∏ j ∈ Finset.range (n + 2), ∏ i ∈ Finset.range (n + 1),
            Ψ (Pr i (fun m => G (δ j m))) ^ ((-1 : ℤ) ^ (i + j))) *
          (∏ i ∈ Finset.range (n + 2), ∏ k ∈ Finset.range (n + 3),
            Ψ (fun m => Pr i G (δ k m)) ^ ((-1 : ℤ) ^ (k + i))) =
        Ψ (Mx 0 G) * (Ψ (Mx (n + 2) G))⁻¹ := by
      intro Ψ G n
      have hA : ∀ i k, k < i + 1 → Ψ (fun m => Pr (i + 1) G (δ k m)) ^ ((-1 : ℤ) ^ (k + (i + 1))) =
          (Ψ (Pr i (fun m => G (δ k m))) ^ ((-1 : ℤ) ^ (i + k)))⁻¹ := by
        intro i k hk
        rw [eA i k G hk, ← zpow_neg]
        congr 1
        rw [show k + (i + 1) = (i + k) + 1 by ring, pow_succ, mul_neg_one]
      have hD : ∀ i x, Ψ (fun m => Pr i G (δ (i + (2 + x)) m)) ^ ((-1 : ℤ) ^ (i + (2 + x) + i)) =
          (Ψ (Pr i (fun m => G (δ (i + 1 + x) m))) ^ ((-1 : ℤ) ^ (i + (i + 1 + x))))⁻¹ := by
        intro i x
        rw [eD i x G, ← zpow_neg]
        congr 1
        rw [show i + (2 + x) + i = (i + (i + 1 + x)) + 1 by ring, pow_succ, mul_neg_one]
      have hB : ∀ i, Ψ (fun m => Pr i G (δ i m)) ^ ((-1 : ℤ) ^ (i + i)) *
          Ψ (fun m => Pr i G (δ (i + 1) m)) ^ ((-1 : ℤ) ^ (i + 1 + i)) =
          Ψ (Mx i G) / Ψ (Mx (i + 1) G) := by
        intro i
        rw [eB i G, eC i G, div_eq_mul_inv]
        congr 1
        · rw [← two_mul, pow_mul]; norm_num
        · rw [show i + 1 + i = 2 * i + 1 by ring, pow_succ, pow_mul]; norm_num
      have hsplit : ∀ i ∈ Finset.range (n + 2), ∏ k ∈ Finset.range (n + 3),
          Ψ (fun m => Pr i G (δ k m)) ^ ((-1 : ℤ) ^ (k + i)) =
          (∏ k ∈ Finset.range i, Ψ (fun m => Pr i G (δ k m)) ^ ((-1 : ℤ) ^ (k + i))) *
          ((Ψ (fun m => Pr i G (δ i m)) ^ ((-1 : ℤ) ^ (i + i)) *
            Ψ (fun m => Pr i G (δ (i + 1) m)) ^ ((-1 : ℤ) ^ (i + 1 + i))) *
           ∏ x ∈ Finset.range (n + 1 - i),
            Ψ (fun m => Pr i G (δ (i + (2 + x)) m)) ^ ((-1 : ℤ) ^ (i + (2 + x) + i))) := by
        intro i hi
        rw [Finset.mem_range] at hi
        rw [show n + 3 = i + (2 + (n + 1 - i)) by omega, Finset.prod_range_add,
          Finset.prod_range_add, Finset.prod_range_succ, Finset.prod_range_one, add_zero]
      have hF1 : (∏ j ∈ Finset.range (n + 2), ∏ i ∈ Finset.range (n + 1),
            Ψ (Pr i (fun m => G (δ j m))) ^ ((-1 : ℤ) ^ (i + j))) =
          (∏ i ∈ Finset.range (n + 1), ∏ j ∈ Finset.range (i + 1),
            Ψ (Pr i (fun m => G (δ j m))) ^ ((-1 : ℤ) ^ (i + j))) *
          (∏ i ∈ Finset.range (n + 1), ∏ x ∈ Finset.range (n + 1 - i),
            Ψ (Pr i (fun m => G (δ (i + 1 + x) m))) ^ ((-1 : ℤ) ^ (i + (i + 1 + x)))) := by
        rw [Finset.prod_comm, ← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl fun i hi => ?_
        rw [Finset.mem_range] at hi
        rw [show n + 2 = (i + 1) + (n + 1 - i) by omega, Finset.prod_range_add]
      have hF2 : (∏ i ∈ Finset.range (n + 2), ∏ k ∈ Finset.range (n + 3),
            Ψ (fun m => Pr i G (δ k m)) ^ ((-1 : ℤ) ^ (k + i))) =
          (∏ i ∈ Finset.range (n + 1), ∏ j ∈ Finset.range (i + 1),
            Ψ (Pr i (fun m => G (δ j m))) ^ ((-1 : ℤ) ^ (i + j)))⁻¹ *
          (Ψ (Mx 0 G) / Ψ (Mx (n + 2) G) *
          (∏ i ∈ Finset.range (n + 1), ∏ x ∈ Finset.range (n + 1 - i),
            Ψ (Pr i (fun m => G (δ (i + 1 + x) m))) ^ ((-1 : ℤ) ^ (i + (i + 1 + x))))⁻¹) := by
        rw [Finset.prod_congr rfl hsplit, Finset.prod_mul_distrib, Finset.prod_mul_distrib]
        congr 1
        · conv_lhs => rw [Finset.prod_range_succ']
          rw [Finset.prod_range_zero, mul_one, ← Finset.prod_inv_distrib]
          refine Finset.prod_congr rfl fun i _ => ?_
          rw [← Finset.prod_inv_distrib]
          exact Finset.prod_congr rfl fun k hk => hA i k (Finset.mem_range.mp hk)
        · congr 1
          · exact (Finset.prod_congr rfl fun i _ => hB i).trans
              (Finset.prod_range_div' (fun i => Ψ (Mx i G)) (n + 2))
          · conv_lhs => rw [Finset.prod_range_succ]
            rw [Nat.sub_self, Finset.prod_range_zero, mul_one, ← Finset.prod_inv_distrib]
            refine Finset.prod_congr rfl fun i _ => ?_
            rw [← Finset.prod_inv_distrib]
            exact Finset.prod_congr rfl fun x _ => hD i x
      rw [hF1, hF2, div_eq_mul_inv]
      generalize (∏ i ∈ Finset.range (n + 1), ∏ j ∈ Finset.range (i + 1),
            Ψ (Pr i (fun m => G (δ j m))) ^ ((-1 : ℤ) ^ (i + j))) = Y1
      generalize (∏ i ∈ Finset.range (n + 1), ∏ x ∈ Finset.range (n + 1 - i),
            Ψ (Pr i (fun m => G (δ (i + 1 + x) m))) ^ ((-1 : ℤ) ^ (i + (i + 1 + x)))) = Y2
      generalize Ψ (Mx 0 G) * (Ψ (Mx (n + 2) G))⁻¹ = C
      rw [mul_comm Y1 Y2, mul_assoc, mul_inv_cancel_left, mul_comm C, mul_inv_cancel_left]
    let G : ℕ → X := fun m => if h : m < q + 2 then g ⟨m, h⟩ else g 0
    have hg : g = fun k : Fin (q + 2) => G k := funext fun k => by
      show g k = if h : (k : ℕ) < q + 2 then g ⟨k, h⟩ else g 0
      rw [dif_pos k.isLt]
    rw [hg]
    rw [R1 q (wcPrism t q Φ) G, R2 (q + 1) (wcCobd (q + 1) Φ) G]
    have e1 : ∀ j, wcPrism t q Φ (fun l => G (δ j l)) =
        ∏ i ∈ Finset.range (q + 1), Φ (fun k => Pr i (fun m => G (δ j m)) k) ^ ((-1 : ℤ) ^ i) :=
      fun j => R2 q Φ (fun m => G (δ j m))
    have e2 : ∀ i, wcCobd (q + 1) Φ (fun k => Pr i G k) =
        ∏ k ∈ Finset.range (q + 3), Φ (fun l => Pr i G (δ k l)) ^ ((-1 : ℤ) ^ k) :=
      fun i => R1 (q + 1) Φ (Pr i G)
    simp only [e1, e2, ← Finset.prod_zpow, ← zpow_mul, ← pow_add]
    have hk := key (fun H => Φ (fun k => H k)) G q
    beta_reduce at hk
    rw [hk]
    have m0 : (fun k : Fin (q + 2) => Mx 0 G k) = fun k : Fin (q + 2) => t (G k) := by
      funext k
      simp [Mx]
    have m2 : (fun k : Fin (q + 2) => Mx (q + 2) G k) = fun k : Fin (q + 2) => G k := by
      funext k
      simp [Mx, k.isLt]
    rw [m0, m2]

  have hb : ∀ H : Subgroup Q, wcGrpCohVanish H B → ((H.index : ℕ) : ℤ) ∈ I := by
    intro H hV
    let C := Quotient (QuotientGroup.rightRel H)
    haveI : Finite C := Quotient.finite _
    letI : Fintype C := Fintype.ofFinite C
    let s : C → Q := fun c => c.out
    let ρ : Q → Q := fun g => (Quotient.mk (QuotientGroup.rightRel H) g : C).out
    have A1 : ∀ g, g * (ρ g)⁻¹ ∈ H := fun g =>
      QuotientGroup.rightRel_apply.mp (Quotient.mk_out (s := QuotientGroup.rightRel H) g)
    have A2 : ∀ h ∈ H, ∀ g, ρ (h * g) = ρ g := by
      intro h hh g
      show (Quotient.mk (QuotientGroup.rightRel H) (h * g) : C).out =
        (Quotient.mk (QuotientGroup.rightRel H) g : C).out
      congr 1
      apply Quotient.sound
      apply QuotientGroup.rightRel_apply.mpr
      rw [mul_inv_rev, mul_inv_cancel_left]
      exact H.inv_mem hh
    have A3 : ∀ x : Q, ∃ π : C ≃ C, ∀ c, s (π c) = ρ (s c * x) := by
      intro x
      let f : C → C := fun c => Quotient.mk (QuotientGroup.rightRel H) (c.out * x)
      have hf : Function.Injective f := by
        intro a b hab
        have h1 := QuotientGroup.rightRel_apply.mp (Quotient.exact hab)
        have h2 : b.out * a.out⁻¹ ∈ H := by
          have e : b.out * x * (a.out * x)⁻¹ = b.out * a.out⁻¹ := by group
          rw [← e]; exact h1
        rw [← Quotient.out_eq a, ← Quotient.out_eq b]
        exact Quotient.sound (QuotientGroup.rightRel_apply.mpr h2)
      exact ⟨Equiv.ofBijective f (Finite.injective_iff_bijective.mp hf), fun c => rfl⟩
    have hcard : Fintype.card C = H.index := by
      rw [← Nat.card_eq_fintype_card]
      exact Nat.card_congr (QuotientGroup.quotientRightRelEquivQuotientLeftRel H)

    let φH : (Fin (n + 2) → H) → B := fun x => φ (fun l => (x l : Q))
    have hφH : ∀ (g : H) (h : Fin (n + 2) → H), φH (fun l => g * h l) = g • φH h :=
      fun g h => hφ (g : Q) (fun l => (h l : Q))
    obtain ⟨ψH, hψe, hψd⟩ := hV n φH hφH (fun h => hcoc (fun l => (h l : Q)))
    let r : Q → H := fun y => ⟨y * (ρ y)⁻¹, A1 y⟩
    have hR : ∀ (h' : Q) (hh : h' ∈ H) (y : Q), r (h' * y) = ⟨h', hh⟩ * r y := by
      intro h' hh y
      apply Subtype.ext
      show h' * y * (ρ (h' * y))⁻¹ = h' * (y * (ρ y)⁻¹)
      rw [A2 h' hh y, mul_assoc]

    let Ψ : (Fin (n + 1) → Q) → B := fun g => ∏ c, (s c)⁻¹ • ψH (fun l => r (s c * g l))
    have hΨe : ∀ (x : Q) (g : Fin (n + 1) → Q), Ψ (fun l => x * g l) = x • Ψ g := by
      intro x g
      obtain ⟨π, hπ⟩ := A3 x
      have key : ∀ c, (s c)⁻¹ • ψH (fun l => r (s c * (x * g l))) =
          x • ((s (π c))⁻¹ • ψH (fun l => r (s (π c) * g l))) := by
        intro c
        have hh : s c * x * (ρ (s c * x))⁻¹ ∈ H := A1 _
        have e1 : ∀ l, s c * (x * g l) = (s c * x * (ρ (s c * x))⁻¹) * (s (π c) * g l) := by
          intro l; rw [hπ c]; group
        have e2 : (fun l => r (s c * (x * g l))) = fun l => ⟨_, hh⟩ * r (s (π c) * g l) := by
          funext l; rw [e1 l, hR _ hh]
        rw [e2, hψe ⟨_, hh⟩ (fun l => r (s (π c) * g l))]
        change (s c)⁻¹ • ((s c * x * (ρ (s c * x))⁻¹) • ψH (fun l => r (s (π c) * g l))) =
          x • ((s (π c))⁻¹ • ψH (fun l => r (s (π c) * g l)))
        rw [← mul_smul, ← mul_smul, hπ c]
        congr 1
        group
      show ∏ c, (s c)⁻¹ • ψH (fun l => r (s c * (x * g l))) =
        x • ∏ c, (s c)⁻¹ • ψH (fun l => r (s c * g l))
      rw [Finset.smul_prod', Finset.prod_congr rfl (fun c _ => key c)]
      exact Equiv.prod_comp π (fun c => x • ((s c)⁻¹ • ψH (fun l => r (s c * g l))))
    have hΨd : ∀ h : Fin (n + 2) → Q,
        wcCobd n Ψ h = ∏ c, φ (fun l => h l * (ρ (s c * h l))⁻¹) := by
      intro h
      refine (cprod C (fun c x => (s c)⁻¹ • ψH (fun l => r (s c * x l))) h).trans ?_
      refine Finset.prod_congr rfl (fun c _ => ?_)
      refine (csmul (s c)⁻¹ (fun y => ψH (fun l => r (s c * y l))) h).trans ?_
      have e : wcCobd n (fun y => ψH (fun l => r (s c * y l))) h =
          φ (fun l => ((r (s c * h l) : H) : Q)) := hψd (fun l => r (s c * h l))
      rw [e, ← hφ]
      congr 1
      funext l
      show (s c)⁻¹ * (s c * h l * (ρ (s c * h l))⁻¹) = h l * (ρ (s c * h l))⁻¹
      group

    let t : C → Q → Q := fun c y => y * (ρ (s c * y))⁻¹
    have hT : ∀ (x : Q) (π : C ≃ C), (∀ c, s (π c) = ρ (s c * x)) →
        ∀ c y, t c (x * y) = x * t (π c) y := by
      intro x π hπ c y
      have hh : s c * x * (ρ (s c * x))⁻¹ ∈ H := A1 _
      have e1 : s c * (x * y) = (s c * x * (ρ (s c * x))⁻¹) * (s (π c) * y) := by
        rw [hπ c]; group
      show x * y * (ρ (s c * (x * y)))⁻¹ = x * (y * (ρ (s (π c) * y))⁻¹)
      rw [e1, A2 _ hh, mul_assoc]
    have hPe : ∀ (x : Q) (π : C ≃ C), (∀ c, s (π c) = ρ (s c * x)) → ∀ c (g : Fin (n + 1) → Q),
        wcPrism (t c) n φ (fun l => x * g l) = x • wcPrism (t (π c)) n φ g := by
      intro x π hπ c g
      unfold wcPrism
      rw [Finset.smul_prod']
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [smul_zpow', ← hφ]
      refine congrArg (· ^ _) (congrArg φ (funext fun k => ?_))
      dsimp only
      split_ifs
      · rfl
      · exact hT x π hπ c _
    let Θ : (Fin (n + 1) → Q) → B := fun g => ∏ c, wcPrism (t c) n φ g
    have hΘe : ∀ (x : Q) (g : Fin (n + 1) → Q), Θ (fun l => x * g l) = x • Θ g := by
      intro x g
      obtain ⟨π, hπ⟩ := A3 x
      show ∏ c, wcPrism (t c) n φ (fun l => x * g l) = x • ∏ c, wcPrism (t c) n φ g
      rw [Finset.smul_prod', Finset.prod_congr rfl (fun c _ => hPe x π hπ c g)]
      exact Equiv.prod_comp π (fun c => x • wcPrism (t c) n φ g)
    have hΘd : ∀ h : Fin (n + 2) → Q, wcCobd n Θ h =
        (∏ c, φ (fun l => h l * (ρ (s c * h l))⁻¹)) * (φ h ^ Fintype.card C)⁻¹ := by
      intro h
      refine (cprod C (fun c => wcPrism (t c) n φ) h).trans ?_
      have hz : wcCobd (n + 1) φ = fun _ => 1 := funext hcoc
      have e : ∀ c, wcCobd n (wcPrism (t c) n φ) h = φ (fun l => t c (h l)) * (φ h)⁻¹ := by
        intro c
        have h0 := t2 Q B (t c) n φ h
        rw [hz] at h0
        have h1 : wcPrism (t c) (n + 1) (fun _ : Fin (n + 3) → Q => (1 : B)) h = 1 := by
          unfold wcPrism
          simp only [one_zpow, Finset.prod_const_one]
        rw [h1, mul_one] at h0
        exact h0
      rw [Finset.prod_congr rfl (fun c _ => e c), Finset.prod_mul_distrib, Finset.prod_inv_distrib,
        Finset.prod_const, Finset.card_univ]

    show ∃ ψ : (Fin (n + 1) → Q) → B,
        (∀ (g : Q) (h : Fin (n + 1) → Q), ψ (fun l => g * h l) = g • ψ h) ∧
        ∀ h : Fin (n + 2) → Q, wcCobd n ψ h = φ h ^ ((H.index : ℕ) : ℤ)
    refine ⟨fun x => Ψ x * (Θ x)⁻¹, fun g h => ?_, fun h => ?_⟩
    · show Ψ (fun l => g * h l) * (Θ (fun l => g * h l))⁻¹ = g • (Ψ h * (Θ h)⁻¹)
      rw [hΨe, hΘe, smul_mul', smul_inv']
    · rw [cmul Ψ (fun x => (Θ x)⁻¹) h, cinv Θ h, hΨd, hΘd, ← hcard, zpow_natCast,
        mul_inv_rev, inv_inv, mul_comm (φ h ^ Fintype.card C), mul_inv_cancel_left]
  have hI : (1 : ℤ) ∈ I := s5 (fun p _ P => hb (P : Subgroup Q) (hSyl p P))
  obtain ⟨ψ, hψe, hψd⟩ : ∃ ψ : (Fin (n + 1) → Q) → B,
      (∀ (g : Q) (h : Fin (n + 1) → Q), ψ (fun l => g * h l) = g • ψ h) ∧
      ∀ h : Fin (n + 2) → Q, wcCobd n ψ h = φ h ^ (1 : ℤ) := hI
  refine ⟨ψ, hψe, fun h => ?_⟩
  have h1 := hψd h
  rw [zpow_one] at h1
  exact h1

theorem wc_et_gm_field_vanishing_of_norm_surj : ∀ (L : Type u) [Field L],
    (∀ (E : Type u) [Field E] [Algebra L E], Algebra.IsAlgebraic L E →
      ∀ (F : Type u) [Field F] [Algebra E F] [FiniteDimensional E F],
        Function.Surjective (Algebra.norm E (S := F))) →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L)))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm (Spec (.of L)))
        (q + 1)) :=
by
  intro L _ hn
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  intro q
  haveI := wc_et_enough_injectives (Spec (.of L))

  have G8 : ∀ (Q : Type u) (B : Type u) [Group Q] [Finite Q] [CommGroup B]
      [MulDistribMulAction Q B], wcCyclicLayerCond Q B → wcGrpCohVanish Q B :=
    fun Q B _ _ _ _ hc => wc_grp_coh_vanish_of_sylow Q B
      (fun p _ P => wc_grp_coh_vanish_pgroup Q B hc p (P : Subgroup Q) P.isPGroup')

  have H1 : ∀ (U : (Spec (.of L)).Etale) (k : ℕ) (V : Fin k → (Spec (.of L)).Etale)
      (f : ∀ i, V i ⟶ U), wcEtGalCov L U k V f →
      Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.smallEtaleTopology (Spec (.of L)) U := by
    intro U k V f hc
    apply wc_etale_jointly_surjective_covers _ U
    intro v
    obtain ⟨i, w, hw⟩ := hc.2.1 v
    exact ⟨V i, f i, Sieve.le_generate (Presieve.ofArrows V f) (V i) (f i)
      (Presieve.ofArrows.mk i), ⟨w, hw⟩⟩

  have H2 : ∀ (U : (Spec (.of L)).Etale) (k : ℕ) (V : Fin k → (Spec (.of L)).Etale)
      (f : ∀ i, V i ⟶ U), wcEtGalCov L U k V f → ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k),
      IsAffine (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l))).left := by
    intro U k V f hc p σ
    exact wc_et_widePullback_affine _ U V f hc.1 (fun i => by
      obtain ⟨κ, M, _, _, _, _, a, e, -⟩ := hc.2.2.2 i
      exact IsAffine.of_isIso e.hom) p σ

  have H3 : ∀ (U : (Spec (.of L)).Etale), IsAffine U.left →
      ∀ R ∈ Scheme.smallEtaleTopology (Spec (.of L)) U, ∃ (k : ℕ)
        (V : Fin k → (Spec (.of L)).Etale) (f : ∀ i, V i ⟶ U),
        wcEtGalCov L U k V f ∧ ∀ i, R.arrows (f i) :=
    wc_et_field_galois_refinement L

  have H5 : ∀ (U : (Spec (.of L)).Etale) (k : ℕ) (V : Fin k → (Spec (.of L)).Etale)
      (f : ∀ i, V i ⟶ U), wcEtGalCov L U k V f →
      wcCechAcyclic (wcEtGm (Spec (.of L))).obj V f := by
    intro U k V f hc
    apply wc_cech_acyclic_of_disjoint _ _ U V f hc.2.2.1
    intro i
    obtain ⟨κ, M, _, _, _, _, a, e, halg, hfd, hgal, ha, he⟩ := hc.2.2.2 i
    haveI := hfd
    haveI := hgal
    have hiso := isIso_toSheafify (Scheme.smallEtaleTopology (Spec (.of L)))
      (wc_et_gm_pre_isSheaf (Spec (.of L)))
    exact wc_cechAcyclic_of_iso
      (@asIso _ _ _ _ (toSheafify (Scheme.smallEtaleTopology (Spec (.of L)))
        (wcEtGmPre (Spec (.of L)))) hiso)
      _ _ (wc_et_gm_cech_galois _ U (V i) (f i) κ M a e ha he
        (G8 _ _ (wc_norm_surj_cyclic_layers L hn κ M halg hfd hgal)))

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 (Spec (.of L)))) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  exact wc_et_cartan_criterion_const (Spec (.of L)) (fun U => IsAffine U.left) (wcEtGalCov L)
    H1 H2 H3 _ hT (show IsAffine (Spec (.of L)) from inferInstance) (wcEtGm (Spec (.of L))) H5 q

theorem wc_tsen_mvpoly_origin_height : ∀ (k : Type u) [Field k] (σ : Type) [Fintype σ],
    (Fintype.card σ : ℕ∞) ≤
      (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial σ k →+* k)).height :=
by
  intro k _ σ _
  classical
  set n := Fintype.card σ with hn
  let e : σ ≃ Fin n := Fintype.equivFin σ
  let φ : ℕ → (MvPolynomial σ k →ₐ[k] MvPolynomial σ k) := fun j =>
    MvPolynomial.aeval (fun t : σ =>
      if ((e t : Fin n) : ℕ) < j then (0 : MvPolynomial σ k) else MvPolynomial.X t)
  have hφX : ∀ j t, φ j (MvPolynomial.X t) =
      if ((e t : Fin n) : ℕ) < j then 0 else MvPolynomial.X t := by
    intro j t
    simp only [φ, MvPolynomial.aeval_X]
  let P : ℕ → Ideal (MvPolynomial σ k) := fun j => RingHom.ker (φ j)
  have hPprime : ∀ j, (P j).IsPrime := fun j => RingHom.ker_isPrime (φ j)
  set m₀ := RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial σ k →+* k) with hm₀
  have hm₀prime : m₀.IsPrime := RingHom.ker_isPrime _
  have hcc : ∀ j f, MvPolynomial.constantCoeff (φ j f) = MvPolynomial.constantCoeff f := by
    intro j f
    have hext : (MvPolynomial.constantCoeff : MvPolynomial σ k →+* k).comp (φ j).toRingHom =
        MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp
      · intro t
        rw [RingHom.comp_apply]
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hφX]
        split_ifs <;> simp
    exact RingHom.congr_fun hext f
  have hPm : ∀ j, P j ≤ m₀ := by
    intro j f hf
    rw [RingHom.mem_ker] at hf ⊢
    rw [← hcc j f, hf, map_zero]
  have hcomp : ∀ j, (φ (j + 1)).comp (φ j) = φ (j + 1) := by
    intro j
    apply MvPolynomial.algHom_ext
    intro t
    rw [AlgHom.comp_apply, hφX j t, hφX (j + 1) t]
    split_ifs with h1 h2 h2
    · simp
    · omega
    · rw [hφX, if_pos h2]
    · rw [hφX, if_neg h2]
  have hmono : ∀ j, P j ≤ P (j + 1) := by
    intro j f hf
    simp only [P, RingHom.mem_ker] at hf ⊢
    rw [← hcomp j, AlgHom.comp_apply, hf, map_zero]
  have hstrict : ∀ j, j < n → P j < P (j + 1) := by
    intro j hj
    refine lt_of_le_of_ne (hmono j) ?_
    intro heq
    have he : ((e (e.symm ⟨j, hj⟩) : Fin n) : ℕ) = j := by simp
    have h1 : MvPolynomial.X (e.symm ⟨j, hj⟩) ∈ P (j + 1) := by
      simp only [P, RingHom.mem_ker]
      rw [hφX, if_pos (by omega)]
    rw [← heq] at h1
    simp only [P, RingHom.mem_ker] at h1
    rw [hφX, if_neg (by omega)] at h1
    exact MvPolynomial.X_ne_zero _ h1
  let q : Fin (n + 1) → PrimeSpectrum (MvPolynomial σ k) := fun i => ⟨P i.val, hPprime i.val⟩
  have hq : StrictMono q := by
    rw [Fin.strictMono_iff_lt_succ]
    intro i
    rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
    show P (i.castSucc : ℕ) < P (i.succ : ℕ)
    rw [Fin.val_castSucc, Fin.val_succ]
    exact hstrict i i.isLt
  let L : LTSeries (PrimeSpectrum (MvPolynomial σ k)) := LTSeries.mk n q hq
  let x : PrimeSpectrum (MvPolynomial σ k) := ⟨m₀, hm₀prime⟩
  have hlast : L.last ≤ x := by
    rw [← PrimeSpectrum.asIdeal_le_asIdeal]
    exact hPm n
  have h1 := Order.length_le_height hlast
  have h2 := PrimeSpectrum.height_eq_orderHeight x
  calc (n : ℕ∞) = (L.length : ℕ∞) := rfl
    _ ≤ Order.height x := h1
    _ = m₀.height := h2.symm

theorem wc_tsen_alg_closed_few_equations : ∀ (k : Type u) [Field k] [IsAlgClosed k],
    (∀ (σ : Type) [Fintype σ], (Fintype.card σ : ℕ∞) ≤
      (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial σ k →+* k)).height) →
    ∀ (σ ι : Type) [Fintype σ] [Fintype ι] (g : ι → MvPolynomial σ k),
      Fintype.card ι < Fintype.card σ → (∀ i, MvPolynomial.constantCoeff (g i) = 0) →
      ∃ y : σ → k, y ≠ 0 ∧ ∀ i, MvPolynomial.eval y (g i) = 0 :=
by
  intro k _ _ hH σ ι _ _ g hlt hg0
  classical
  by_contra hcon
  push_neg at hcon
  have hstar : ∀ y : σ → k, (∀ i, MvPolynomial.eval y (g i) = 0) → y = 0 := by
    intro y h
    by_contra hy
    obtain ⟨i, hi⟩ := hcon y hy
    exact hi (h i)
  set m := RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial σ k →+* k) with hm_def
  set I : Ideal (MvPolynomial σ k) := Ideal.span (Set.range g) with hI_def
  have hN := MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := k) (σ := σ) I
  have hZ : MvPolynomial.zeroLocus k I ⊆ {0} := by
    intro x hx
    rw [MvPolynomial.mem_zeroLocus_iff] at hx
    apply hstar
    intro i
    have := hx (g i) (Ideal.subset_span ⟨i, rfl⟩)
    simpa [MvPolynomial.aeval_eq_eval] using this
  have hmrad : m ≤ I.radical := by
    rw [← hN]
    refine le_trans ?_ (MvPolynomial.vanishingIdeal_anti_mono hZ)
    intro p hp
    rw [MvPolynomial.mem_vanishingIdeal_iff]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    rw [MvPolynomial.aeval_zero]
    simp [RingHom.mem_ker.mp hp]
  have : m.IsPrime := RingHom.ker_isPrime _
  have hIm : I ≤ m := by
    rw [hI_def, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact RingHom.mem_ker.mpr (hg0 i)
  obtain ⟨P, hP, -⟩ := Ideal.exists_minimalPrimes_le hIm
  have hPprime : P.IsPrime := hP.1.1
  have hIP : I ≤ P := hP.1.2
  have hmP : m ≤ P := hmrad.trans ((Ideal.IsPrime.radical_le_iff hPprime).mpr hIP)
  have h1 : m.height ≤ P.height := Ideal.height_mono hmP
  have h2 := Ideal.height_le_spanRank_toENat_of_mem_minimalPrimes I P hP
  have h3 : (Submodule.spanRank I) ≤ (Fintype.card ι : Cardinal) := by
    refine (Submodule.spanRank_span_le_card (Set.range g)).trans ?_
    have := Cardinal.mk_range_le_lift (f := g)
    rw [Cardinal.mk_fintype ι, Cardinal.lift_natCast] at this
    exact Cardinal.lift_le_nat_iff.mp this
  have h4 : Cardinal.toENat (Submodule.spanRank I) ≤ (Fintype.card ι : ℕ∞) :=
    Cardinal.toENat_le_natCast.mpr h3
  have h5 := (hH σ).trans (h1.trans (h2.trans h4))
  have h6 : Fintype.card σ ≤ Fintype.card ι := by exact_mod_cast h5
  omega

theorem wc_tsen_polynomial_ring_c1 : ∀ (k : Type u) [Field k],
    (∀ (σ ι : Type) [Fintype σ] [Fintype ι] (g : ι → MvPolynomial σ k),
      Fintype.card ι < Fintype.card σ → (∀ i, MvPolynomial.constantCoeff (g i) = 0) →
      ∃ y : σ → k, y ≠ 0 ∧ ∀ i, MvPolynomial.eval y (g i) = 0) →
    ∀ (n d : ℕ) (F : MvPolynomial (Fin n) (Polynomial k)), F.IsHomogeneous d → 0 < d → d < n →
      ∃ x : Fin n → Polynomial k, x ≠ 0 ∧ MvPolynomial.eval x F = 0 :=
by
  intro k _ H n d F hF hd hdn
  classical

  have s2 : ∀ (r N : ℕ) (x : Fin n → Polynomial k), (∀ s, (F.coeff s).natDegree ≤ r) →
      (∀ i, (x i).natDegree ≤ N) → (MvPolynomial.eval x F).natDegree ≤ r + d * N := by
    intro r N x hr hx
    rw [MvPolynomial.eval_eq']
    apply Polynomial.natDegree_sum_le_of_forall_le
    intro s hs
    have hdeg : ∑ i, s i = d := by
      by_contra h
      apply (MvPolynomial.mem_support_iff.mp hs)
      apply hF.coeff_eq_zero
      rw [Finsupp.degree_eq_sum]
      exact h
    apply Polynomial.natDegree_mul_le_of_le (hr s)
    calc (∏ i, x i ^ s i).natDegree ≤ ∑ i, (x i ^ s i).natDegree :=
          Polynomial.natDegree_prod_le _ _
      _ ≤ ∑ i, s i * N :=
          Finset.sum_le_sum (fun i _ => Polynomial.natDegree_pow_le_of_le _ (hx i))
      _ = d * N := by rw [← Finset.sum_mul, hdeg]

  have s3 : ∀ (N l : ℕ), ∃ G : MvPolynomial (Fin n × Fin (N + 1)) k,
      ∀ a : Fin n × Fin (N + 1) → k, MvPolynomial.eval a G =
        (MvPolynomial.eval (fun i => ∑ j : Fin (N + 1), Polynomial.C (a (i, j)) *
          Polynomial.X ^ (j : ℕ)) F).coeff l := by
    intro N l
    let ψ : Polynomial k →+* Polynomial (MvPolynomial (Fin n × Fin (N + 1)) k) :=
      Polynomial.mapRingHom MvPolynomial.C
    let ξ : Fin n → Polynomial (MvPolynomial (Fin n × Fin (N + 1)) k) :=
      fun i => ∑ j : Fin (N + 1), Polynomial.C (MvPolynomial.X (i, j)) * Polynomial.X ^ (j : ℕ)
    refine ⟨(MvPolynomial.eval₂ ψ ξ F).coeff l, fun a => ?_⟩
    let ρ : Polynomial (MvPolynomial (Fin n × Fin (N + 1)) k) →+* Polynomial k :=
      Polynomial.mapRingHom (MvPolynomial.eval a)
    have h1 : MvPolynomial.eval a ((MvPolynomial.eval₂ ψ ξ F).coeff l) =
        (ρ (MvPolynomial.eval₂ ψ ξ F)).coeff l := by
      simp only [ρ, Polynomial.coe_mapRingHom, Polynomial.coeff_map]
    rw [h1, MvPolynomial.eval₂_comp_left]
    have h2 : ρ.comp ψ = RingHom.id _ := by
      refine RingHom.ext fun p => Polynomial.ext fun m => ?_
      simp [ρ, ψ, Polynomial.coeff_map]
    have h3 : (ρ ∘ ξ) = fun i => ∑ j : Fin (N + 1), Polynomial.C (a (i, j)) *
        Polynomial.X ^ (j : ℕ) := by
      funext i
      simp [ρ, ξ, Polynomial.map_sum]
    rw [h2, h3]
    rfl

  have s4 : ∀ (N : ℕ) (a : Fin n × Fin (N + 1) → k),
      (∀ i, (∑ j : Fin (N + 1), Polynomial.C (a (i, j)) * Polynomial.X ^ (j : ℕ)).natDegree ≤ N) ∧
      (a ≠ 0 → (fun i => ∑ j : Fin (N + 1), Polynomial.C (a (i, j)) *
        Polynomial.X ^ (j : ℕ)) ≠ 0) := by
    intro N a
    refine ⟨fun i => ?_, fun ha h => ?_⟩
    · apply Polynomial.natDegree_sum_le_of_forall_le
      intro j _
      exact (Polynomial.natDegree_C_mul_X_pow_le _ _).trans (Nat.lt_succ_iff.mp j.is_lt)
    · apply ha
      funext p
      obtain ⟨i, j⟩ := p
      have := congrArg (fun f => (f i).coeff (j : ℕ)) h
      simp only [Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow, Pi.zero_apply,
        Polynomial.coeff_zero] at this
      rw [Finset.sum_eq_single j] at this
      · simpa using this
      · intro b _ hb
        rw [if_neg]
        exact fun h' => hb (Fin.ext h'.symm)
      · simp

  set r := F.support.sup (fun s => (F.coeff s).natDegree) with hr_def
  have hr : ∀ s, (F.coeff s).natDegree ≤ r := by
    intro s
    by_cases hs : s ∈ F.support
    · exact Finset.le_sup (f := fun s => (F.coeff s).natDegree) hs
    · rw [MvPolynomial.notMem_support_iff.mp hs, Polynomial.natDegree_zero]
      exact Nat.zero_le _
  set N := r + 1 with hN
  choose G hGspec using fun l : Fin (d * N + r + 1) => s3 N l
  have hconst : ∀ l, MvPolynomial.constantCoeff (G l) = 0 := by
    intro l
    rw [← MvPolynomial.eval_zero, hGspec]
    have h0 : (fun i => ∑ j : Fin (N + 1),
        Polynomial.C ((0 : Fin n × Fin (N + 1) → k) (i, j)) * Polynomial.X ^ (j : ℕ)) = 0 := by
      funext i
      simp
    rw [h0, MvPolynomial.eval_zero, MvPolynomial.constantCoeff_eq, hF.coeff_eq_zero,
      Polynomial.coeff_zero]
    intro h
    simp at h
    omega
  have hcount : Fintype.card (Fin (d * N + r + 1)) < Fintype.card (Fin n × Fin (N + 1)) := by
    simp only [Fintype.card_prod, Fintype.card_fin]
    have h1 : (d + 1) * (N + 1) ≤ n * (N + 1) := Nat.mul_le_mul_right _ hdn
    nlinarith
  obtain ⟨y, hy0, hy⟩ := H (Fin n × Fin (N + 1)) (Fin (d * N + r + 1)) G hcount hconst
  obtain ⟨hdegx, hne⟩ := s4 N y
  refine ⟨_, hne hy0, ?_⟩
  ext m
  rw [Polynomial.coeff_zero]
  by_cases hm : m < d * N + r + 1
  · exact (hGspec ⟨m, hm⟩ y).symm.trans (hy ⟨m, hm⟩)
  · apply Polynomial.coeff_eq_zero_of_natDegree_lt
    have := s2 r N _ hr hdegx
    omega

theorem wc_tsen_rational_function_field_c1 : ∀ (Ω : Type u) [Field Ω],
    (∀ (n d : ℕ) (F : MvPolynomial (Fin n) (Polynomial Ω)), F.IsHomogeneous d → 0 < d → d < n →
      ∃ x : Fin n → Polynomial Ω, x ≠ 0 ∧ MvPolynomial.eval x F = 0) →
    ∀ (K : Type u) [Field K] [Algebra Ω K] (t : K), Transcendental Ω t →
      wcIsC1 (IntermediateField.adjoin Ω {t}) :=
by
  classical
  intro Ω _ hyp K _ _ t ht n f hhom hpos hlt
  let φ : Polynomial Ω →+* IntermediateField.adjoin Ω {t} :=
    (Polynomial.aeval (IntermediateField.AdjoinSimple.gen Ω t)).toRingHom
  have hcoe : ∀ P : Polynomial Ω,
      ((φ P : IntermediateField.adjoin Ω {t}) : K) = Polynomial.aeval t P := by
    intro P
    exact IntermediateField.AdjoinSimple.coe_aeval_gen_apply Ω t P
  have hinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro P hP
    have h1 : Polynomial.aeval t P = 0 := by
      rw [← hcoe, hP]; rfl
    exact (transcendental_iff_injective.mp ht) (h1.trans (map_zero _).symm)
  have hfrac : ∀ c : IntermediateField.adjoin Ω {t},
      ∃ Q R : Polynomial Ω, φ Q ≠ 0 ∧ φ Q * c = φ R := by
    intro c
    obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff Ω (c : K)).mp c.2
    by_cases hs : Polynomial.aeval t s = 0
    · refine ⟨1, 0, by simp, ?_⟩
      have hc : c = 0 := by
        apply Subtype.ext
        rw [hrs, hs, div_zero]; rfl
      rw [hc, mul_zero, map_zero]
    · refine ⟨s, r, ?_, ?_⟩
      · intro h
        apply hs
        rw [← hcoe, h]; rfl
      · apply Subtype.ext
        rw [IntermediateField.coe_mul, hcoe, hcoe, hrs, mul_div_cancel₀ _ hs]
  choose Qf Rf hQ hR using hfrac
  set q : IntermediateField.adjoin Ω {t} := ∏ c ∈ f.coeffs, φ (Qf c) with hqdef
  have hq : q ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun c _ => hQ c)
  have hrange : MvPolynomial.C q * f ∈ Set.range (MvPolynomial.map φ) := by
    rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
    intro b hb
    rw [Finset.mem_coe, MvPolynomial.mem_coeffs_iff] at hb
    obtain ⟨m, _, rfl⟩ := hb
    rw [MvPolynomial.coeff_C_mul]
    by_cases hc : f.coeff m = 0
    · exact ⟨0, by rw [hc, mul_zero, map_zero]⟩
    · have hmem : f.coeff m ∈ f.coeffs := MvPolynomial.coeff_mem_coeffs m hc
      refine ⟨(∏ c ∈ f.coeffs.erase (f.coeff m), Qf c) * Rf (f.coeff m), ?_⟩
      rw [map_mul, map_prod, ← hR, hqdef, ← Finset.mul_prod_erase _ _ hmem]
      ring
  obtain ⟨G, hG⟩ := hrange
  have hGhom : G.IsHomogeneous f.totalDegree := by
    apply MvPolynomial.IsHomogeneous.of_map hinj
    rw [hG]
    exact hhom.C_mul q
  obtain ⟨x, hx0, hx⟩ := hyp n f.totalDegree G hGhom hpos hlt
  refine ⟨φ ∘ x, ?_, ?_⟩
  · intro h
    apply hx0
    funext i
    apply hinj
    rw [Pi.zero_apply, map_zero]
    exact congrFun h i
  · have h1 := MvPolynomial.map_eval φ x G
    rw [hx, map_zero, hG, MvPolynomial.eval_mul, MvPolynomial.eval_C] at h1
    exact (mul_eq_zero.mp h1.symm).resolve_left hq

theorem wc_tsen_norm_form_poly : ∀ (F : Type u) [Field F] (E : Type u) [Field E] [Algebra F E]
    [FiniteDimensional F E] (σ : Type) [Fintype σ] (d : ℕ) (G : MvPolynomial σ E),
    G.IsHomogeneous d →
    ∃ N : MvPolynomial σ F, N.IsHomogeneous (d * Module.finrank F E) ∧
      ∀ y : σ → F, MvPolynomial.eval y N =
        Algebra.norm F (MvPolynomial.eval (algebraMap F E ∘ y) G) :=
by
  intro F _ E _ _ _ σ _ d G hG
  classical
  let b := Module.finBasis F E
  let M : Matrix (Fin (Module.finrank F E)) (Fin (Module.finrank F E)) (MvPolynomial σ F) :=
    fun a a' => ∑ s ∈ G.support,
      MvPolynomial.monomial s (Algebra.leftMulMatrix b (G.coeff s) a a')
  have hM : ∀ a a', (M a a').IsHomogeneous d := by
    intro a a'
    apply MvPolynomial.IsHomogeneous.sum
    intro s hs
    apply MvPolynomial.isHomogeneous_monomial
    have h := hG (MvPolynomial.mem_support_iff.mp hs)
    rw [Finsupp.degree_eq_weight_one]
    exact h
  have hdet : M.det.IsHomogeneous (d * Module.finrank F E) := by
    rw [Matrix.det_apply']
    apply MvPolynomial.IsHomogeneous.sum
    intro π _
    have hc : ((((Equiv.Perm.sign π : ℤˣ) : ℤ)) : MvPolynomial σ F)
        = MvPolynomial.C ((((Equiv.Perm.sign π : ℤˣ) : ℤ)) : F) :=
      (map_intCast (MvPolynomial.C : F →+* MvPolynomial σ F) _).symm
    have h1 : ((((Equiv.Perm.sign π : ℤˣ) : ℤ)) : MvPolynomial σ F).IsHomogeneous 0 := by
      rw [hc]; exact MvPolynomial.isHomogeneous_C _ _
    have h2 := MvPolynomial.IsHomogeneous.prod Finset.univ (fun i => M (π i) i) (fun _ => d)
      (fun i _ => hM (π i) i)
    have h3 := h1.mul h2
    convert h3 using 1
    simp [Finset.sum_const, Finset.card_univ, mul_comm]
  refine ⟨M.det, hdet, fun y => ?_⟩
  rw [Algebra.norm_eq_matrix_det b, RingHom.map_det]
  congr 1
  ext a a'
  rw [RingHom.mapMatrix_apply, Matrix.map_apply]
  simp only [M, map_sum, MvPolynomial.eval_monomial]
  rw [MvPolynomial.eval_eq' (algebraMap F E ∘ y) G, map_sum, Matrix.sum_apply]
  apply Finset.sum_congr rfl
  intro s _
  have hP : ∏ i, (algebraMap F E ∘ y) i ^ s i = algebraMap F E (∏ i, y i ^ s i) := by
    simp [map_prod, map_pow]
  rw [hP, ← Algebra.commutes, ← Algebra.smul_def, map_smul, Matrix.smul_apply,
    smul_eq_mul, Finsupp.prod_pow]
  ring

theorem wc_tsen_finite_ext_c1 : ∀ (F : Type u) [Field F] (E : Type u) [Field E] [Algebra F E]
    [FiniteDimensional F E],
    (∀ (σ : Type) [Fintype σ] (d : ℕ) (G : MvPolynomial σ E), G.IsHomogeneous d →
      ∃ N : MvPolynomial σ F, N.IsHomogeneous (d * Module.finrank F E) ∧
        ∀ y : σ → F, MvPolynomial.eval y N =
          Algebra.norm F (MvPolynomial.eval (algebraMap F E ∘ y) G)) →
    wcIsC1 F → wcIsC1 E :=
by
  intro F _ E _ _ _ hNorm hF
  unfold wcIsC1 at hF ⊢
  intro n f hf hpos hlt
  classical
  have hm0 : 0 < Module.finrank F E := Module.finrank_pos
  have hpos' : 0 < f.totalDegree * Module.finrank F E := Nat.mul_pos hpos hm0
  have hlt' : f.totalDegree * Module.finrank F E < n * Module.finrank F E :=
    Nat.mul_lt_mul_of_pos_right hlt hm0
  let b := Module.finBasis F E
  let ℓ : Fin n → MvPolynomial (Fin n × Fin (Module.finrank F E)) E :=
    fun i => ∑ j, MvPolynomial.C (b j) * MvPolynomial.X (i, j)
  have hℓ : ∀ i, (ℓ i).IsHomogeneous 1 := fun i =>
    MvPolynomial.IsHomogeneous.sum _ _ _ (fun j _ => MvPolynomial.isHomogeneous_C_mul_X _ _)
  have hG : (MvPolynomial.aeval ℓ f).IsHomogeneous f.totalDegree := by
    have := hf.aeval ℓ hℓ
    simpa using this
  have hGev : ∀ y : Fin n × Fin (Module.finrank F E) → F,
      MvPolynomial.eval (algebraMap F E ∘ y) (MvPolynomial.aeval ℓ f) =
      MvPolynomial.eval (fun i => ∑ j, y (i, j) • b j) f := by
    intro y
    have key : ∀ p : MvPolynomial (Fin n) E,
        MvPolynomial.eval (algebraMap F E ∘ y) (MvPolynomial.aeval ℓ p) =
        MvPolynomial.eval (fun i => ∑ j, y (i, j) • b j) p := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => simp
      | add p q hp hq => simp only [map_add, hp, hq]
      | mul_X p i hp =>
        simp only [map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.eval_X]
        congr 1
        simp [ℓ, Algebra.smul_def, mul_comm]
    exact key f
  obtain ⟨N, hN, hNev⟩ := hNorm (Fin n × Fin (Module.finrank F E)) f.totalDegree _ hG
  have hcard : Fintype.card (Fin n × Fin (Module.finrank F E)) = n * Module.finrank F E := by
    simp
  obtain ⟨y, hy0, hy⟩ : ∃ y : Fin n × Fin (Module.finrank F E) → F,
      y ≠ 0 ∧ MvPolynomial.eval y N = 0 := by
    by_cases hN0 : N = 0
    · have s : Fin n × Fin (Module.finrank F E) := (⟨0, by omega⟩, ⟨0, hm0⟩)
      exact ⟨fun _ => 1, fun h => one_ne_zero (congrFun h s), by rw [hN0, map_zero]⟩
    · let e := Fintype.equivFin (Fin n × Fin (Module.finrank F E))
      have hN' : (MvPolynomial.rename e N).IsHomogeneous (f.totalDegree * Module.finrank F E) :=
        hN.rename_isHomogeneous
      have hN'0 : MvPolynomial.rename e N ≠ 0 := fun h =>
        hN0 (MvPolynomial.rename_injective e e.injective (by rw [h, map_zero]))
      have htd : (MvPolynomial.rename e N).totalDegree = f.totalDegree * Module.finrank F E :=
        hN'.totalDegree hN'0
      obtain ⟨v, hv0, hv⟩ := hF _ (MvPolynomial.rename e N) (by rw [htd]; exact hN')
        (by rw [htd]; exact hpos') (by rw [htd, hcard]; exact hlt')
      refine ⟨v ∘ e, fun h => hv0 (funext fun k => ?_), ?_⟩
      · have := congrFun h (e.symm k)
        simpa using this
      · rw [← MvPolynomial.eval_rename]; exact hv
  have hnorm0 : Algebra.norm F (MvPolynomial.eval (fun i => ∑ j, y (i, j) • b j) f) = 0 := by
    rw [← hGev y, ← hNev y, hy]
  have hfx := (Algebra.norm_eq_zero_iff).mp hnorm0
  refine ⟨fun i => ∑ j, y (i, j) • b j, ?_, hfx⟩
  intro h
  apply hy0
  funext ⟨i, j⟩
  have h1 := congrFun h i
  simp only [Pi.zero_apply] at h1
  exact Fintype.linearIndependent_iff.mp b.linearIndependent (fun j' => y (i, j')) h1 j

theorem wc_tsen_algebraic_union_c1 : ∀ (F : Type u) [Field F] (L : Type u) [Field L] [Algebra F L],
    Algebra.IsAlgebraic F L →
    (∀ E : IntermediateField F L, FiniteDimensional F E → wcIsC1 E) → wcIsC1 L :=
by
  intro F _ L _ _ hAlg hE n f hhom hpos hlt
  classical
  have hf0 : f ≠ 0 := by
    rintro rfl
    rw [MvPolynomial.totalDegree_zero] at hpos
    exact lt_irrefl 0 hpos
  set E : IntermediateField F L := IntermediateField.adjoin F (f.coeffs : Set L) with hEdef
  have hFD : FiniteDimensional F E := by
    rw [hEdef]
    exact IntermediateField.finiteDimensional_adjoin
      (fun x _ => (hAlg.isAlgebraic x).isIntegral)
  have hC1 : wcIsC1 E := hE E hFD
  have hsub : (f.coeffs : Set L) ⊆ Set.range (algebraMap E L) := by
    intro c hc
    have hcE : c ∈ E := IntermediateField.subset_adjoin F _ hc
    exact ⟨⟨c, hcE⟩, rfl⟩
  obtain ⟨fE, hmap⟩ := (MvPolynomial.mem_range_map_iff_coeffs_subset).mpr hsub
  have hinj : Function.Injective (algebraMap E L) := (algebraMap E L).injective
  have hhomE : fE.IsHomogeneous f.totalDegree := by
    apply MvPolynomial.IsHomogeneous.of_map hinj
    rw [hmap]; exact hhom
  have hfE0 : fE ≠ 0 := by
    rintro rfl
    apply hf0
    rw [← hmap, map_zero]
  have hdeg : fE.totalDegree = f.totalDegree := hhomE.totalDegree hfE0
  obtain ⟨w, hw0, hw⟩ := hC1 n fE (by rw [hdeg]; exact hhomE) (by rw [hdeg]; exact hpos)
    (by rw [hdeg]; exact hlt)
  refine ⟨(algebraMap E L) ∘ w, ?_, ?_⟩
  · intro h
    apply hw0
    funext i
    apply hinj
    have := congrFun h i
    simpa using this
  · rw [← hmap, ← MvPolynomial.map_eval, hw, map_zero]

theorem wc_tsen_algebraic_c1 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (K : Type u) [Field K]
    [Algebra Ω K] (t : K), Algebra.IsAlgebraic (IntermediateField.adjoin Ω {t}) K →
    ∀ (L : Type u) [Field L] [Algebra K L], Algebra.IsAlgebraic K L → wcIsC1 L :=
by
  intro Ω _ _ K _ _ t hK L _ _ hKL

  have hAC : ∀ (k : Type u) [Field k] [IsAlgClosed k], wcIsC1 k := by
    intro k _ _ n f hf hpos hlt
    obtain ⟨y, hy0, hy⟩ := wc_tsen_alg_closed_few_equations k
      (fun σ _ => wc_tsen_mvpoly_origin_height k σ) (Fin n) Unit (fun _ => f)
      (by simp only [Fintype.card_unit, Fintype.card_fin]; omega)
      (by
        intro _
        rw [MvPolynomial.constantCoeff_eq]
        exact hf.coeff_eq_zero (by simp only [map_zero]; omega))
    exact ⟨y, hy0, hy ()⟩

  have hF : wcIsC1 (IntermediateField.adjoin Ω {t}) := by
    by_cases ht : Transcendental Ω t
    · exact wc_tsen_rational_function_field_c1 Ω
        (wc_tsen_polynomial_ring_c1 Ω (wc_tsen_alg_closed_few_equations Ω
          (fun σ _ => wc_tsen_mvpoly_origin_height Ω σ))) K t ht
    · have ht' : IsAlgebraic Ω t := not_not.mp ht
      haveI : FiniteDimensional Ω (IntermediateField.adjoin Ω {t}) :=
        IntermediateField.adjoin.finiteDimensional ht'.isIntegral
      have hsurj : Function.Surjective (algebraMap Ω (IntermediateField.adjoin Ω {t})) := by
        intro x
        have hx : IsIntegral Ω x := IsIntegral.of_finite Ω x
        have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hx)
        obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω x hdeg
        exact ⟨c, hc⟩
      haveI : IsAlgClosed (IntermediateField.adjoin Ω {t}) :=
        IsAlgClosed.of_ringEquiv Ω _
          (RingEquiv.ofBijective _ ⟨(algebraMap Ω _).injective, hsurj⟩)
      exact hAC _

  haveI := hK
  haveI := hKL
  have hFL : Algebra.IsAlgebraic (IntermediateField.adjoin Ω {t}) L :=
    Algebra.IsAlgebraic.trans _ K L

  exact wc_tsen_algebraic_union_c1 _ L hFL (fun E hE => by
    haveI := hE
    exact wc_tsen_finite_ext_c1 _ E (wc_tsen_norm_form_poly _ E) hF)

theorem wc_curve_function_field_trdeg_one : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IsIntegral X],
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∃ (φ : Ω →+* X.functionField) (t : X.functionField),
      letI := φ.toAlgebra
      Algebra.IsAlgebraic (IntermediateField.adjoin Ω {t}) X.functionField :=
by
  intro Ω _ _ X fX _ _ hdim
  classical

  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S],
      Function.Injective (algebraMap R S) → ringKrullDim R ≤ ringKrullDim S := by
    intro R S _ _ _ _ hinj
    haveI : FaithfulSMul R S := (faithfulSMul_iff_algebraMap_injective R S).mpr hinj
    have key : ∀ (n : ℕ) (p : LTSeries (PrimeSpectrum R)), p.length = n →
        ∃ q : LTSeries (PrimeSpectrum S), q.length = n ∧
          PrimeSpectrum.comap (algebraMap R S) q.last = p.last := by
      intro n
      induction n with
      | zero =>
        intro p _
        obtain ⟨Q, hQ⟩ := Algebra.IsIntegral.comap_surjective R S p.last
        exact ⟨RelSeries.singleton _ Q, rfl, hQ⟩
      | succ n ih =>
        intro p hp
        obtain ⟨q', hq'len, hq'⟩ := ih p.eraseLast (by simp [hp])
        have hlt : p.eraseLast.last < p.last := p.eraseLast_last_rel_last (by omega)
        have hI : Ideal.under R q'.last.asIdeal ≤ p.last.asIdeal := by
          have e : Ideal.under R q'.last.asIdeal = p.eraseLast.last.asIdeal := by
            rw [← hq']; rfl
          rw [e]
          exact hlt.le
        obtain ⟨Q, hQI, hQp, hQ⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
          p.last.asIdeal q'.last.asIdeal hI
        let Q' : PrimeSpectrum S := ⟨Q, hQp⟩
        have hQ' : PrimeSpectrum.comap (algebraMap R S) Q' = p.last := by
          ext1
          exact hQ
        have hlt' : q'.last < Q' := by
          refine lt_of_le_of_ne (show q'.last.asIdeal ≤ Q from hQI) ?_
          intro heq
          apply hlt.ne
          rw [← hq', ← hQ', heq]
        refine ⟨q'.snoc Q' hlt', ?_, ?_⟩
        · rw [RelSeries.snoc_length, hq'len]
        · rw [RelSeries.last_snoc]
          exact hQ'
    show Order.krullDim (PrimeSpectrum R) ≤ Order.krullDim (PrimeSpectrum S)
    refine iSup_le fun p => ?_
    obtain ⟨q, hq, -⟩ := key p.length p rfl
    exact Order.le_krullDim_iff.mpr ⟨q, hq⟩

  obtain ⟨x⟩ : Nonempty X := inferInstance
  obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
  haveI : Nonempty W := ⟨⟨x, hxW⟩⟩
  haveI : IsDomain Γ(X, W) := IsIntegral.component_integral W
  let ψ : Ω →+* Γ(X, W) :=
    (fX.appLE ⊤ W (by simp)).hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
  have hψ : ψ.FiniteType := by
    refine RingHom.FiniteType.comp (fX.finiteType_appLE (isAffineOpen_top _) hW _)
      (RingHom.FiniteType.of_surjective _ ?_)
    intro y
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y, ?_⟩
    change ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom y = y
    rw [Iso.hom_inv_id]
    rfl
  letI : Algebra Ω Γ(X, W) := ψ.toAlgebra
  haveI : Algebra.FiniteType Ω Γ(X, W) := hψ
  haveI := functionField_isFractionRing_of_isAffineOpen X W hW
  let φ : Ω →+* X.functionField := (algebraMap Γ(X, W) X.functionField).comp ψ

  obtain ⟨s, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg Ω Γ(X, W)
  letI : Algebra (MvPolynomial (Fin s) Ω) Γ(X, W) := g.toRingHom.toAlgebra
  haveI : Algebra.IsIntegral (MvPolynomial (Fin s) Ω) Γ(X, W) :=
    ⟨RingHom.Finite.to_isIntegral hgfin⟩

  have hs : s ≤ 1 := by
    have h2 := s2 (MvPolynomial (Fin s) Ω) Γ(X, W) hginj
    have h1 : ringKrullDim Γ(X, W) ≤ topologicalKrullDim X := by
      have e := IsHomeomorph.topologicalKrullDim_eq _
        (Scheme.homeoOfIso hW.isoSpec).isHomeomorph
      rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
      exact le_trans (le_of_eq e.symm) (topologicalKrullDim_subspace_le X (W : Set X))
    have h3 : ringKrullDim (MvPolynomial (Fin s) Ω) = ((s : ℕ) : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
        ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
      rfl
    have h4 : ((s : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
      h3 ▸ (h2.trans (h1.trans hdim.le))
    exact_mod_cast h4

  let t : X.functionField :=
    if h : 0 < s then algebraMap Γ(X, W) X.functionField (g (MvPolynomial.X ⟨0, h⟩)) else 0
  refine ⟨φ, t, ?_⟩
  letI : Algebra Ω X.functionField := φ.toAlgebra
  show Algebra.IsAlgebraic (IntermediateField.adjoin Ω {t}) X.functionField
  let τ : IntermediateField.adjoin Ω {t} := ⟨t, IntermediateField.mem_adjoin_simple_self Ω t⟩
  let h : MvPolynomial (Fin s) Ω →+* IntermediateField.adjoin Ω {t} :=
    (MvPolynomial.aeval (fun _ => τ)).toRingHom
  have hcomm : (algebraMap (IntermediateField.adjoin Ω {t}) X.functionField).comp h =
      (algebraMap Γ(X, W) X.functionField).comp (algebraMap (MvPolynomial (Fin s) Ω) Γ(X, W)) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      change algebraMap (IntermediateField.adjoin Ω {t}) X.functionField
          (MvPolynomial.aeval (fun _ => τ) (MvPolynomial.C r)) =
        algebraMap Γ(X, W) X.functionField (g (MvPolynomial.C r))
      rw [MvPolynomial.aeval_C, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      rfl
    · intro i
      have hpos : 0 < s := Fin.pos i
      have hi : i = ⟨0, hpos⟩ := Fin.ext (by have := i.isLt; show i.val = 0; omega)
      subst hi
      change algebraMap (IntermediateField.adjoin Ω {t}) X.functionField
          (MvPolynomial.aeval (fun _ => τ) (MvPolynomial.X _)) =
        algebraMap Γ(X, W) X.functionField (g (MvPolynomial.X _))
      rw [MvPolynomial.aeval_X]
      show t = _
      simp only [t, dif_pos hpos]
  have hint : ∀ a : Γ(X, W), IsIntegral (IntermediateField.adjoin Ω {t})
      (algebraMap Γ(X, W) X.functionField a) := fun a =>
    IsIntegral.map_of_comp_eq h _ hcomm (Algebra.IsIntegral.isIntegral a)
  refine ⟨fun z => ?_⟩
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := Γ(X, W)) z
  have ha : algebraMap Γ(X, W) X.functionField a ∈
      algebraicClosure (IntermediateField.adjoin Ω {t}) X.functionField :=
    mem_algebraicClosure_iff.mpr (hint a).isAlgebraic
  have hb : algebraMap Γ(X, W) X.functionField b ∈
      algebraicClosure (IntermediateField.adjoin Ω {t}) X.functionField :=
    mem_algebraicClosure_iff.mpr (hint b).isAlgebraic
  exact mem_algebraicClosure_iff.mp (IntermediateField.div_mem _ ha hb)

theorem wc_c1_norm_surjective : ∀ (L : Type u) [Field L], wcIsC1 L →
    ∀ (F : Type u) [Field F] [Algebra L F] [FiniteDimensional L F],
      Function.Surjective (Algebra.norm L (S := F)) :=
by
  intro L _ hC1 F _ _ _ a
  classical

  have s1 : ∀ {σ : Type} (k : ℕ) (A : Matrix (Fin k) (Fin k) (MvPolynomial σ L)),
      (∀ i j, (A i j).IsHomogeneous 1) → A.det.IsHomogeneous k := by
    intro σ k A hA
    rw [Matrix.det_apply]
    apply MvPolynomial.IsHomogeneous.sum
    intro τ _
    have hp : (∏ i, A (τ i) i).IsHomogeneous k := by
      have := MvPolynomial.IsHomogeneous.prod Finset.univ (fun i => A (τ i) i) (fun _ => 1)
        (fun i _ => hA (τ i) i)
      simpa using this
    rcases Int.units_eq_one_or (Equiv.Perm.sign τ) with h | h
    · rw [h, one_smul]; exact hp
    · rw [h, Units.neg_smul, one_smul]; exact hp.neg

  have s2 : ∀ (m : ℕ) (b : Module.Basis (Fin m) L F) (σ : Type) (e : Fin m → σ) (w : σ → L),
      MvPolynomial.eval w (Matrix.det (Matrix.of fun i j : Fin m =>
        ∑ k : Fin m, MvPolynomial.X (e k) * MvPolynomial.C (Algebra.leftMulMatrix b (b k) i j))) =
      Algebra.norm L (∑ k : Fin m, w (e k) • b k) := by
    intro m b σ e w
    rw [RingHom.map_det, Algebra.norm_eq_matrix_det b]
    congr 1
    ext i j
    simp [RingHom.mapMatrix_apply, Matrix.map_apply, map_sum, Matrix.sum_apply, Matrix.smul_apply]
  by_cases ha : a = 0
  · exact ⟨0, by rw [ha, Algebra.norm_zero]⟩
  obtain ⟨n, hn_def⟩ : ∃ n, Module.finrank L F = n := ⟨_, rfl⟩
  have hn : 0 < n := hn_def ▸ Module.finrank_pos
  let b : Module.Basis (Fin n) L F := Module.finBasisOfFinrankEq L F hn_def
  let NF : MvPolynomial (Fin (n + 1)) L := Matrix.det (Matrix.of fun i j : Fin n =>
    ∑ k : Fin n, MvPolynomial.X (Fin.castSucc k) * MvPolynomial.C (Algebra.leftMulMatrix b (b k) i j))
  let f : MvPolynomial (Fin (n + 1)) L := NF - MvPolynomial.C a * MvPolynomial.X (Fin.last n) ^ n
  have hNF : NF.IsHomogeneous n := by
    apply s1
    intro i j
    simp only [Matrix.of_apply]
    apply MvPolynomial.IsHomogeneous.sum
    intro k _
    simpa using (MvPolynomial.isHomogeneous_X L (Fin.castSucc k)).mul
      (MvPolynomial.isHomogeneous_C (Fin (n + 1)) (Algebra.leftMulMatrix b (b k) i j))
  have hf : f.IsHomogeneous n :=
    hNF.sub ((MvPolynomial.isHomogeneous_X_pow (Fin.last n) n).C_mul a)
  have hevalf : ∀ w : Fin (n + 1) → L, MvPolynomial.eval w f =
      Algebra.norm L (∑ k : Fin n, w (Fin.castSucc k) • b k) - a * w (Fin.last n) ^ n := by
    intro w
    have := s2 n b (Fin (n + 1)) Fin.castSucc w
    simp only [f, map_sub, map_mul, map_pow, MvPolynomial.eval_C, MvPolynomial.eval_X]
    rw [← this]
  have hf0 : f ≠ 0 := by
    intro h
    have h1 := hevalf (Pi.single (Fin.last n) 1)
    have h0 : ∀ k : Fin n, (Pi.single (Fin.last n) (1 : L) : Fin (n + 1) → L) (Fin.castSucc k) = 0 :=
      fun k => Pi.single_eq_of_ne (Fin.castSucc_ne_last k) _
    rw [h, map_zero] at h1
    simp only [h0, zero_smul, Finset.sum_const_zero, Algebra.norm_zero, Pi.single_eq_same, one_pow,
      mul_one, zero_sub] at h1
    exact ha (neg_eq_zero.mp h1.symm)
  have htd : f.totalDegree = n := hf.totalDegree hf0
  obtain ⟨v, hv0, hv⟩ := hC1 (n + 1) f (by rw [htd]; exact hf) (by rw [htd]; exact hn)
    (by rw [htd]; omega)
  rw [hevalf] at hv
  have hc0 : v (Fin.last n) ≠ 0 := by
    intro hc0
    rw [hc0, zero_pow hn.ne', mul_zero, sub_zero] at hv
    have hz0 := (Algebra.norm_eq_zero_iff).mp hv
    have hli := Fintype.linearIndependent_iff.mp b.linearIndependent
      (fun k => v (Fin.castSucc k)) hz0
    apply hv0
    funext i
    induction i using Fin.lastCases with
    | last => exact hc0
    | cast k => exact hli k
  have hNz := sub_eq_zero.mp hv
  refine ⟨algebraMap L F (v (Fin.last n))⁻¹ * ∑ k : Fin n, v (Fin.castSucc k) • b k, ?_⟩
  rw [map_mul, Algebra.norm_algebraMap, hn_def, hNz, ← mul_assoc, mul_comm _ a, mul_assoc,
    ← mul_pow, inv_mul_cancel₀ hc0, one_pow, mul_one]

theorem wc_et_gm_tsen_vanishing : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm X) (q + 2)) :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q

  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI := hirr
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  have hnorm' : ∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x) := fun x => (hnorm x).2

  obtain ⟨φ, t, ht⟩ := wc_curve_function_field_trdeg_one Ω X fX hdim
  letI := φ.toAlgebra
  have hL : ∀ (L : Type u) [Field L] [Algebra X.functionField L],
      Algebra.IsAlgebraic X.functionField L →
      letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of L))) AddCommGrpCat.{u+1}) :=
        HasExt.standard _
      ∀ q : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of L)))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtGm (Spec (.of L)))
        (q + 1)) := by
    intro L _ _ hKL
    refine wc_et_gm_field_vanishing_of_norm_surj L ?_
    intro E _ _ hLE F _ _ _
    letI : Algebra X.functionField E :=
      ((algebraMap L E).comp (algebraMap X.functionField L)).toAlgebra
    haveI : IsScalarTower X.functionField L E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI := hKL
    haveI := hLE
    exact wc_c1_norm_surjective E (wc_tsen_algebraic_c1 Ω X.functionField t ht E
      (Algebra.IsAlgebraic.trans X.functionField L E)) F

  have hj := wc_et_gm_generic_push_acyclic Ω X fX hnorm' hdim hL
  have hQ := wc_et_gm_divisor_coker_acyclic Ω X fX hnorm' hdim

  haveI := wc_et_gm_to_generic_mono X
  let ι := wcEtGmToAt X (genericPoint X)
  let S := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
  have hS : S.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance

  have h0 : ∀ e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) S.X₁ (q + 2), e = 0 := by
    intro e
    have hx : e.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
      @Subsingleton.elim _ (hj (q + 1)) _ 0
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS e hx (n₀ := q + 1) rfl
    have hx0 : x₃ = 0 := @Subsingleton.elim _ (hQ q) _ _
    rw [← hx₃, hx0, Abelian.Ext.zero_comp]
  exact ⟨fun a b => (h0 a).trans (h0 b).symm⟩

theorem wc_curve_dedekind_affine_open : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∃ U : X.Opens, IsAffineOpen U ∧ ((U : Set X)ᶜ).Finite ∧ IsDedekindDomain Γ(X, U) :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim
  classical
  haveI := hirr
  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian fX
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace fX
  haveI : AlgebraicGeometry.IsNoetherian X := ⟨⟩
  have hdim1 : topologicalKrullDim X ≤ 1 := by rw [hdim, Nat.cast_one]
  obtain ⟨x₀⟩ : Nonempty X := IrreducibleSpace.toNonempty
  obtain ⟨U, hUaff, hx₀, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
    (show x₀ ∈ (⊤ : X.Opens) from trivial)
  have hU : IsAffineOpen U := hUaff

  have hfin : ((U : Set X)ᶜ).Finite := by
    obtain ⟨S, hSf, hScl, hSirr, hSeq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible
        (U.isOpen.isClosed_compl)
    rw [hSeq]
    refine hSf.sUnion fun C hC => ?_
    have hCsub : C ⊆ (U : Set X)ᶜ := by
      rw [hSeq]; exact Set.subset_sUnion_of_mem hC
    have key : ∀ y ∈ C, closure {y} = C := by
      intro y hy
      have hle : closure {y} ⊆ C :=
        closure_minimal (Set.singleton_subset_iff.mpr hy) (hScl C hC)
      by_contra hne
      let a : TopologicalSpace.IrreducibleCloseds X :=
        ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
      let c : TopologicalSpace.IrreducibleCloseds X := ⟨C, hSirr C hC, hScl C hC⟩
      let t : TopologicalSpace.IrreducibleCloseds X :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩
      have hac : a < c := lt_of_le_of_ne hle
        (fun h => hne (congrArg TopologicalSpace.IrreducibleCloseds.carrier h))
      have hct : c < t := lt_of_le_of_ne (Set.subset_univ C) (fun h => by
        have hx : x₀ ∈ TopologicalSpace.IrreducibleCloseds.carrier c := by
          rw [h]; trivial
        exact hCsub hx hx₀)
      have hK : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ 1 := hdim1
      rcases Order.krullDim_le_one_iff.mp hK c with h | h
      · exact not_isMin_of_lt hac h
      · exact not_isMax_of_lt hct h
    refine Set.Subsingleton.finite fun y hy z hz => ?_
    exact (inseparable_iff_closure_eq.mpr ((key y hy).trans (key z hz).symm)).eq

  haveI : Nonempty U := ⟨⟨x₀, hx₀⟩⟩
  haveI hdom : IsDomain Γ(X, U) := IsIntegral.component_integral U
  haveI hnoeth : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  have hA : ringKrullDim Γ(X, U) ≤ 1 := by
    have e1 := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim Γ(X, U)
    have e2 := (Scheme.homeoOfIso hU.isoSpec).isHomeomorph.topologicalKrullDim_eq
    have e3 := topologicalKrullDim_subspace_le X (U : Set X)
    rw [← e1]
    calc topologicalKrullDim (PrimeSpectrum Γ(X, U)) = topologicalKrullDim U := e2.symm
      _ ≤ topologicalKrullDim X := e3
      _ ≤ 1 := hdim1
  haveI : Ring.KrullDimLE 1 Γ(X, U) := Ring.krullDimLE_iff.mpr (by rw [Nat.cast_one]; exact hA)
  have hstalk : ∀ x : U, IsIntegrallyClosed (Localization.AtPrime (hU.primeIdealOf x).asIdeal) := by
    intro x
    haveI := (hnorm (x : X)).2
    let e := @IsLocalization.algEquiv _ _ (hU.primeIdealOf x).asIdeal.primeCompl
      (X.presheaf.stalk (x : X)) _ _ (hU.isLocalization_stalk x)
      (Localization.AtPrime (hU.primeIdealOf x).asIdeal) _ _ _
    exact IsIntegrallyClosed.of_equiv e.toRingEquiv
  have hloc : ∀ (p : Ideal Γ(X, U)) [p.IsPrime], IsIntegrallyClosed (Localization.AtPrime p) := by
    intro p hp
    let q : PrimeSpectrum Γ(X, U) := ⟨p, hp⟩
    have hxU : hU.fromSpec q ∈ (U : Set X) := hU.range_fromSpec ▸ Set.mem_range_self q
    have hq : hU.primeIdealOf ⟨hU.fromSpec q, hxU⟩ = q :=
      hU.fromSpec.isOpenEmbedding.isEmbedding.injective
        (hU.fromSpec_primeIdealOf ⟨hU.fromSpec q, hxU⟩)
    have h1 := hstalk ⟨hU.fromSpec q, hxU⟩
    rw [hq] at h1
    exact h1
  have hDed : IsDedekindDomain Γ(X, U) := by
    rw [isDedekindDomain_iff Γ(X, U) (FractionRing Γ(X, U))]
    haveI : IsIntegrallyClosed Γ(X, U) := IsIntegrallyClosed.of_localization_maximal
      (fun p _ hpm => by haveI := hpm.isPrime; exact hloc p)
    exact ⟨hdom, hnoeth, ⟨fun hp0 hp => hp.isMaximal_of_ne_bot hp0⟩,
      fun hx => IsIntegrallyClosed.isIntegral_iff.mp hx⟩
  exact ⟨U, hU, hfin, hDed⟩

theorem wc_zar_flasque_ext_one_vanish : ∀ (X : Scheme.{u})
    (F : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}),
    (∀ (V W : X.Opens) (h : W ≤ V), Function.Surjective (F.obj.map (homOfLE h).op)) →
    letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _
    Subsingleton (Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) F 1) :=
by
  intro X F hF
  letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _

  have flg : ∀ (T : Type u) [TopologicalSpace T]
      {F B Q : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u}} (ι : F ⟶ B) (g : B ⟶ Q),
      Presheaf.IsSheaf (Opens.grothendieckTopology T) B →
      Presheaf.IsSheaf (Opens.grothendieckTopology T) Q →
      (∀ (U : TopologicalSpace.Opens T) (a : F.obj (Opposite.op U)),
        g.app (Opposite.op U) (ι.app (Opposite.op U) a) = 0) →
      (∀ (U : TopologicalSpace.Opens T) (b : B.obj (Opposite.op U)), g.app (Opposite.op U) b = 0 →
        ∃ a, ι.app (Opposite.op U) a = b) →
      (∀ (U V : TopologicalSpace.Opens T) (h : U ≤ V), Function.Surjective (F.map (homOfLE h).op)) →
      (∀ (U : TopologicalSpace.Opens T) (q : Q.obj (Opposite.op U)) (x : T), x ∈ U →
        ∃ (W : TopologicalSpace.Opens T) (h : W ≤ U), x ∈ W ∧ ∃ b : B.obj (Opposite.op W),
          g.app (Opposite.op W) b = Q.map (homOfLE h).op q) →
      ∀ U : TopologicalSpace.Opens T, Function.Surjective (g.app (Opposite.op U)) := by
    intro T _ F B Q ι g hB hQ h0 hex hfl hloc
    have rr : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u})
        {A₁ A₂ A₃ : TopologicalSpace.Opens T} (f₁ : A₁ ⟶ A₂) (f₂ : A₂ ⟶ A₃)
        (s : P.obj (Opposite.op A₃)),
        P.map f₁.op (P.map f₂.op s) = P.map (homOfLE ((leOfHom f₁).trans (leOfHom f₂))).op s := by
      intro P A₁ A₂ A₃ f₁ f₂ s
      rw [← Functor.map_comp_apply]
      rfl
    have natg : ∀ {A A' : TopologicalSpace.Opens T} (f : A ⟶ A') (s : B.obj (Opposite.op A')),
        g.app (Opposite.op A) (B.map f.op s) = Q.map f.op (g.app (Opposite.op A') s) :=
      fun f s => NatTrans.naturality_apply g f.op s
    have natι : ∀ {A A' : TopologicalSpace.Opens T} (f : A ⟶ A') (s : F.obj (Opposite.op A')),
        ι.app (Opposite.op A) (F.map f.op s) = B.map f.op (ι.app (Opposite.op A') s) :=
      fun f s => NatTrans.naturality_apply ι f.op s
    have glue : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u}),
        Presheaf.IsSheaf (Opens.grothendieckTopology T) P →
        ∀ (κ : Type u) (V : κ → TopologicalSpace.Opens T)
          (sf : ∀ i, P.obj (Opposite.op (V i))),
        (∀ i j, P.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op (sf i) =
          P.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op (sf j)) →
        ∃ s : P.obj (Opposite.op (iSup V)),
          (∀ i, P.map (homOfLE (le_iSup V i)).op s = sf i) ∧
          ∀ s' : P.obj (Opposite.op (iSup V)),
            (∀ i, P.map (homOfLE (le_iSup V i)).op s' = sf i) → s' = s := by
      intro P hP κ V sf hc
      have hPt := GrothendieckTopology.HasSheafCompose.isSheaf
        (J := Opens.grothendieckTopology T) (F := forget AddCommGrpCat.{u}) P hP
      obtain ⟨s, hs, hu⟩ := TopCat.Presheaf.IsSheaf.isSheafUniqueGluing_types
        (X := TopCat.of T) (F := P ⋙ forget AddCommGrpCat.{u}) hPt sf hc
      exact ⟨s, hs, hu⟩
    have sep : ∀ (P : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u}),
        Presheaf.IsSheaf (Opens.grothendieckTopology T) P →
        ∀ (κ : Type u) (V : κ → TopologicalSpace.Opens T)
          (s₁ s₂ : P.obj (Opposite.op (iSup V))),
        (∀ i, P.map (homOfLE (le_iSup V i)).op s₁ = P.map (homOfLE (le_iSup V i)).op s₂) →
        s₁ = s₂ := by
      intro P hP κ V s₁ s₂ h
      obtain ⟨s, _, hu⟩ := glue P hP κ V (fun i => P.map (homOfLE (le_iSup V i)).op s₂)
        (fun i j => by rw [rr, rr])
      rw [hu s₁ h, hu s₂ (fun i => rfl)]
    intro U q
    have extend : ∀ (V : TopologicalSpace.Opens T) (hV : V ≤ U) (t : B.obj (Opposite.op V)),
        g.app (Opposite.op V) t = Q.map (homOfLE hV).op q →
        ∀ (W : TopologicalSpace.Opens T) (hW : W ≤ U) (b : B.obj (Opposite.op W)),
        g.app (Opposite.op W) b = Q.map (homOfLE hW).op q →
        ∃ (V' : TopologicalSpace.Opens T) (h₁ : V ≤ V') (h₂ : W ≤ V') (h₃ : V' ≤ U)
          (t' : B.obj (Opposite.op V')),
          B.map (homOfLE h₁).op t' = t ∧ g.app (Opposite.op V') t' = Q.map (homOfLE h₃).op q := by
      intro V hV t ht W hW b hb
      have pV : V ⊓ W ≤ V := inf_le_left
      have pW : V ⊓ W ≤ W := inf_le_right
      have hgd : g.app (Opposite.op (V ⊓ W))
          (B.map (homOfLE pV).op t - B.map (homOfLE pW).op b) = 0 := by
        rw [map_sub, natg, natg, ht, hb, rr, rr, sub_eq_zero]
      obtain ⟨a, ha⟩ := hex _ _ hgd
      obtain ⟨a', ha'⟩ := hfl _ _ pW a
      have hgb' : g.app (Opposite.op W) (b + ι.app (Opposite.op W) a') =
          Q.map (homOfLE hW).op q := by
        rw [map_add, h0, add_zero, hb]
      have hb'D : B.map (homOfLE pW).op (b + ι.app (Opposite.op W) a') =
          B.map (homOfLE pV).op t := by
        rw [map_add, ← natι, ha', ha]
        abel
      let Uf : ULift.{u} Bool → TopologicalSpace.Opens T := fun i => cond i.down V W
      let sf : ∀ i : ULift.{u} Bool, B.obj (Opposite.op (Uf i)) := fun i =>
        match i with
        | ⟨true⟩ => t
        | ⟨false⟩ => b + ι.app (Opposite.op W) a'
      have hc : ∀ i j, B.map (homOfLE (inf_le_left : Uf i ⊓ Uf j ≤ Uf i)).op (sf i) =
          B.map (homOfLE (inf_le_right : Uf i ⊓ Uf j ≤ Uf j)).op (sf j) := by
        rintro ⟨_ | _⟩ ⟨_ | _⟩
        · rfl
        · have e := congrArg (fun x => (B.map
            (homOfLE (le_inf inf_le_right inf_le_left : W ⊓ V ≤ V ⊓ W)).op) x) hb'D
          simp only [rr] at e
          exact e
        · exact hb'D.symm
        · rfl
      obtain ⟨s, hs, -⟩ := glue B hB (ULift.{u} Bool) Uf sf hc
      have h₃ : iSup Uf ≤ U := iSup_le (by rintro ⟨_ | _⟩; exacts [hW, hV])
      refine ⟨iSup Uf, le_iSup Uf ⟨true⟩, le_iSup Uf ⟨false⟩, h₃, s, hs ⟨true⟩, ?_⟩
      apply sep Q hQ _ Uf
      intro i
      rw [← natg, hs i, rr]
      rcases i with ⟨_ | _⟩
      · exact hgb'
      · exact ht
    let Pt := Σ (V : {V : TopologicalSpace.Opens T // V ≤ U}),
      {t : B.obj (Opposite.op V.1) // g.app (Opposite.op V.1) t = Q.map (homOfLE V.2).op q}
    let r : Pt → Pt → Prop := fun a b =>
      ∃ h : a.1.1 ≤ b.1.1, B.map (homOfLE h).op b.2.1 = a.2.1
    have rtrans : ∀ {a b c : Pt}, r a b → r b c → r a c := by
      rintro a b c ⟨h₁, e₁⟩ ⟨h₂, e₂⟩
      refine ⟨h₁.trans h₂, ?_⟩
      rw [← e₁, ← e₂, rr]
    have hbound : ∀ c : Set Pt, IsChain r c → ∃ ub, ∀ a ∈ c, r a ub := by
      intro c hc
      let V : c → TopologicalSpace.Opens T := fun i => i.1.1.1
      have hV : ∀ i, V i ≤ U := fun i => i.1.1.2
      let t : ∀ i : c, B.obj (Opposite.op (V i)) := fun i => i.1.2.1
      have hcomp : ∀ i j : c, B.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op (t i) =
          B.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op (t j) := by
        intro i j
        by_cases hij : i = j
        · subst hij; rfl
        · rcases hc i.2 j.2 (fun h => hij (Subtype.ext h)) with ⟨h, e⟩ | ⟨h, e⟩
          · show B.map _ i.1.2.1 = B.map _ j.1.2.1
            rw [← e, rr]
          · show B.map _ i.1.2.1 = B.map _ j.1.2.1
            rw [← e, rr]
      obtain ⟨s, hs, -⟩ := glue B hB c V t hcomp
      have hgs : g.app (Opposite.op (iSup V)) s = Q.map (homOfLE (iSup_le hV)).op q := by
        apply sep Q hQ c V
        intro i
        rw [← natg, hs i, rr]
        exact i.1.2.2
      exact ⟨⟨⟨iSup V, iSup_le hV⟩, ⟨s, hgs⟩⟩, fun a ha => ⟨le_iSup V ⟨a, ha⟩, hs ⟨a, ha⟩⟩⟩
    obtain ⟨m, hm⟩ := exists_maximal_of_chains_bounded hbound rtrans
    rcases m with ⟨⟨V₀, hV₀⟩, t₀, ht₀⟩
    have hUV : U ≤ V₀ := by
      intro x hxU
      by_contra hx
      obtain ⟨W, hW, hxW, b, hb⟩ := hloc U q x hxU
      obtain ⟨V', h₁, h₂, h₃, t', ht'1, ht'2⟩ := extend V₀ hV₀ t₀ ht₀ W hW b hb
      obtain ⟨h, -⟩ := hm ⟨⟨V', h₃⟩, t', ht'2⟩ ⟨h₁, ht'1⟩
      exact hx (h (h₂ hxW))
    refine ⟨B.map (homOfLE hUV).op t₀, ?_⟩
    rw [natg, ht₀, rr]
    show Q.map (𝟙 (Opposite.op U)) q = q
    exact Functor.map_id_apply Q _ q

  let P := (constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let j : F ⟶ Injective.under F := Injective.ι F
  let g : Injective.under F ⟶ Limits.cokernel j := Limits.cokernel.π j
  have hfg : j ≫ g = 0 := Limits.cokernel.condition j
  have hS : (ShortComplex.mk j g hfg).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel j) (Injective.ι_mono F) inferInstance
  haveI := hS.mono_f

  have hex : ∀ (U : X.Opens) (b : (Injective.under F).obj.obj (Opposite.op U)),
      g.hom.app (Opposite.op U) b = 0 → ∃ a, j.hom.app (Opposite.op U) a = b := by
    intro U b hb
    have hE := hS.exact.map_of_mono_of_preservesKernel
      (sheafToPresheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u} ⋙
        (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U))
      hS.mono_f inferInstance
    obtain ⟨a, ha⟩ := (ShortComplex.ab_exact_iff _).mp hE b hb
    exact ⟨a, ha⟩
  have h0 : ∀ (U : X.Opens) (a : F.obj.obj (Opposite.op U)),
      g.hom.app (Opposite.op U) (j.hom.app (Opposite.op U) a) = 0 := by
    intro U a
    have := congrArg (fun φ : F ⟶ Limits.cokernel j => φ.hom.app (Opposite.op U) a) hfg
    simpa using this

  haveI hls : Sheaf.IsLocallySurjective g :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat g).mpr inferInstance
  have hloc : ∀ (U : X.Opens) (q : (Limits.cokernel j).obj.obj (Opposite.op U)) (x : X), x ∈ U →
      ∃ (W : X.Opens) (h : W ≤ U), x ∈ W ∧ ∃ b : (Injective.under F).obj.obj (Opposite.op W),
        g.hom.app (Opposite.op W) b = (Limits.cokernel j).obj.map (homOfLE h).op q := by
    intro U q x hx
    have hS' : Presheaf.imageSieve g.hom q ∈ Opens.grothendieckTopology X U :=
      Presheaf.imageSieve_mem (Opens.grothendieckTopology X) g.hom q
    obtain ⟨V, f, ⟨t, ht⟩, hxV⟩ := (Opens.mem_grothendieckTopology X).1 hS' x hx
    exact ⟨V, leOfHom f, hxV, t, ht⟩
  have hsurj := flg X j.hom g.hom (Injective.under F).cond
    (Limits.cokernel j).cond h0 hex (fun U V h => hF V U h) hloc ⊤

  have key : ∀ x : Abelian.Ext P F 1, x = 0 := by
    intro x
    have hx0 : x.comp (Abelian.Ext.mk₀ j) (add_zero 1) = 0 :=
      Abelian.Ext.eq_zero_of_injective (n := 0) _
    obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x hx0 (zero_add 1)
    have hT : Limits.IsTerminal (⊤ : X.Opens) := Limits.isTerminalTop
    let eB := Sheaf.H.equiv₀ (Injective.under F) hT
    let eQ := Sheaf.H.equiv₀ (Limits.cokernel j) hT
    obtain ⟨b, hb⟩ := hsurj (eQ y)
    have hn : (g.hom.app (Opposite.op ⊤)) b =
        eQ ((eB.symm b).comp (Abelian.Ext.mk₀ g) (add_zero 0)) := by
      have := Sheaf.H.equiv₀_naturality hT g (eB.symm b)
      rw [AddEquiv.apply_symm_apply] at this
      exact this
    have hy' : y = (eB.symm b).comp (Abelian.Ext.mk₀ g) (add_zero 0) :=
      eQ.injective (hb.symm.trans hn)
    rw [← hy, hy']
    change ((eB.symm b).comp (Abelian.Ext.mk₀ g) (add_zero 0)).comp hS.extClass (zero_add 1) = 0
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
      hS.comp_extClass, Abelian.Ext.comp_zero]
  refine ⟨fun a b => ?_⟩
  rw [key a, key b]

theorem wc_curve_points_closed_opens_compact : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    (∀ S : Set X, S.Finite → genericPoint X ∉ S → IsClosed S) ∧
    (∀ V : X.Opens, IsCompact (V : Set X)) :=
by
  intro Ω _ X fX _ _ hdim
  haveI := LocallyOfFiniteType.isLocallyNoetherian fX
  haveI := QuasiCompact.compactSpace_of_compactSpace fX
  haveI : AlgebraicGeometry.IsNoetherian X := AlgebraicGeometry.IsNoetherian.mk
  haveI : TopologicalSpace.NoetherianSpace X := inferInstance
  have hmm : ∀ A : TopologicalSpace.IrreducibleCloseds X, IsMin A ∨ IsMax A := by
    have h1 : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ 1 := by
      rw [← topologicalKrullDim.eq_1]
      rw [hdim]
      simp
    exact Order.krullDim_le_one_iff.mp h1
  have hpt : ∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X) := by
    intro y hy
    let A : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Top : TopologicalSpace.IrreducibleCloseds X :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩
    have hA : IsMin A := by
      rcases hmm A with h | h
      · exact h
      · exfalso
        have hle : A ≤ Top := by
          rw [← SetLike.coe_subset_coe]
          exact Set.subset_univ _
        have hTA : Top ≤ A := h hle
        rw [← SetLike.coe_subset_coe] at hTA
        have hcl : closure ({y} : Set X) = Set.univ :=
          Set.eq_univ_of_univ_subset hTA
        have hg : IsGenericPoint y (Set.univ : Set X) := (isGenericPoint_def).mpr hcl
        exact hy (hg.eq (genericPoint_spec X))
    rw [← closure_subset_iff_isClosed]
    intro z hz
    have hyz : y ⤳ z := specializes_iff_mem_closure.mpr hz
    let B : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure {z}, isIrreducible_singleton.closure, isClosed_closure⟩
    have hBA : B ≤ A := by
      rw [← SetLike.coe_subset_coe]
      exact hyz.closure_subset
    have hAB : A ≤ B := hA hBA
    rw [← SetLike.coe_subset_coe] at hAB
    have hy' : y ∈ closure ({z} : Set X) := hAB (subset_closure (Set.mem_singleton y))
    have hzy : z ⤳ y := specializes_iff_mem_closure.mpr hy'
    have := (hyz.antisymm hzy).eq
    rw [Set.mem_singleton_iff]
    exact this.symm
  refine ⟨fun S hS hη => ?_, fun V => TopologicalSpace.NoetherianSpace.isCompact _⟩
  rw [← Set.biUnion_of_singleton S]
  refine hS.isClosed_biUnion (fun y hyS => hpt y ?_)
  rintro rfl
  exact hη hyS

theorem wc_zarGm_sections_units : ∀ (X : Scheme.{u}), ∃ φ : ∀ V : X.Opens,
    (wcZarGm X).obj.obj (Opposite.op V) ≃+ Additive (Γ(X, V))ˣ,
    ∀ (V W : X.Opens) (hWV : W ≤ V) (g : (wcZarGm X).obj.obj (Opposite.op V)),
      φ W ((wcZarGm X).obj.map (homOfLE hWV).op g) =
        Additive.ofMul (Units.map (X.presheaf.map (homOfLE hWV).op).hom.toMonoidHom
          (Additive.toMul (φ V g))) :=
by
  intro X
  have h1 : Presheaf.IsSheaf (Opens.grothendieckTopology X)
      (X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units) :=
    Presheaf.isSheaf_comp_of_isSheaf (Opens.grothendieckTopology X)
      X.presheaf (forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units) X.sheaf.property
  have h2 : Presheaf.IsSheaf (Opens.grothendieckTopology X)
      ((X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units) ⋙ forget CommGrpCat.{u}) :=
    (Presheaf.isSheaf_iff_isSheaf_forget (Opens.grothendieckTopology X) _
      (forget CommGrpCat.{u})).1 h1
  have hZ : Presheaf.IsSheaf (Opens.grothendieckTopology X)
      (X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
        CommGrpCat.toAddCommGrp) :=
    (Presheaf.isSheaf_iff_isSheaf_forget (Opens.grothendieckTopology X)
      (X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
        CommGrpCat.toAddCommGrp) (forget AddCommGrpCat.{u})).2 h2
  let e := @asIso _ _ _ _ (toSheafify (Opens.grothendieckTopology X)
      (X.presheaf ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
        CommGrpCat.toAddCommGrp)) (isIso_toSheafify _ hZ)
  refine ⟨fun V => (Iso.addCommGroupIsoToAddEquiv (e.app (Opposite.op V))).symm,
    fun V W hWV g => ?_⟩
  simp only [Iso.addCommGroupIsoToAddEquiv_symm_apply]
  exact NatTrans.naturality_apply e.inv (homOfLE hWV).op g

theorem wc_curve_stalk_dvr : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    [IsProper fX] [IsIntegral X], (∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x)) →
    (∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X)) →
    ∀ x : X, x ≠ genericPoint X → IsDiscreteValuationRing (X.presheaf.stalk x) :=
by
  intro Ω _ X fX _ _ hnorm hcl x hx
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian fX
  have hinj : Function.Injective (X.fromSpecStalk x) :=
    (X.fromSpecStalk x).isEmbedding.injective
  have hc : X.fromSpecStalk x (IsLocalRing.closedPoint (X.presheaf.stalk x)) = x :=
    Scheme.fromSpecStalk_closedPoint
  have hgen : ∀ p, X.fromSpecStalk x p ⤳ x := by
    intro p
    have h : X.fromSpecStalk x p ∈ Set.range (X.fromSpecStalk x) := ⟨p, rfl⟩
    rw [Scheme.range_fromSpecStalk] at h
    exact h
  have heta : ∀ y : X, genericPoint X ⤳ y := fun y =>
    (genericPoint_spec X).specializes (Set.mem_univ y)
  have hdich : ∀ p, X.fromSpecStalk x p = x ∨ X.fromSpecStalk x p = genericPoint X := by
    intro p
    by_cases h : X.fromSpecStalk x p = genericPoint X
    · exact Or.inr h
    · left
      have := (hgen p).mem_closed (hcl _ h) (Set.mem_singleton _)
      exact (Set.mem_singleton_iff.mp this).symm
  have hx' : ∀ p, X.fromSpecStalk x p = x → p.asIdeal = IsLocalRing.maximalIdeal _ := by
    intro p hp
    have : p = IsLocalRing.closedPoint (X.presheaf.stalk x) := hinj (hp.trans hc.symm)
    rw [this]
    rfl
  have heta' : ∀ p, X.fromSpecStalk x p = genericPoint X → p.asIdeal = ⊥ := by
    intro p hp
    let b : PrimeSpectrum (X.presheaf.stalk x) := ⟨⊥, Ideal.isPrime_bot⟩
    have hbp : b ⤳ p := (PrimeSpectrum.le_iff_specializes b p).mp bot_le
    have h1 : X.fromSpecStalk x b ⤳ X.fromSpecStalk x p :=
      hbp.map (X.fromSpecStalk x).continuous
    rw [hp] at h1
    have h2 : X.fromSpecStalk x b = genericPoint X := (h1.antisymm (heta _)).eq
    have : b = p := hinj (h2.trans hp.symm)
    rw [← this]
  have hm : IsLocalRing.maximalIdeal (X.presheaf.stalk x) ≠ ⊥ := by
    intro hm
    have h : genericPoint X ∈ Set.range (X.fromSpecStalk x) := by
      rw [Scheme.range_fromSpecStalk]
      exact heta x
    obtain ⟨p, hp⟩ := h
    have hle : p.asIdeal ≤ IsLocalRing.maximalIdeal _ :=
      IsLocalRing.le_maximalIdeal p.isPrime.ne_top
    rw [hm, le_bot_iff] at hle
    have : p = IsLocalRing.closedPoint (X.presheaf.stalk x) := by
      apply PrimeSpectrum.ext
      rw [hle]
      exact hm.symm
    apply hx
    rw [← hc, ← this, hp]
  have hnf : ¬ IsField (X.presheaf.stalk x) := by
    rw [IsLocalRing.isField_iff_maximalIdeal_eq]
    exact hm
  have huniq : ∃! P : Ideal (X.presheaf.stalk x), P ≠ ⊥ ∧ P.IsPrime := by
    refine ⟨IsLocalRing.maximalIdeal _, ⟨hm, (IsLocalRing.maximalIdeal.isMaximal _).isPrime⟩, ?_⟩
    rintro P ⟨hP0, hP⟩
    rcases hdich ⟨P, hP⟩ with h | h
    · exact hx' ⟨P, hP⟩ h
    · exact absurd (heta' ⟨P, hP⟩ h) hP0
  have key : IsDiscreteValuationRing (X.presheaf.stalk x) ↔
      (IsIntegrallyClosed (X.presheaf.stalk x) ∧
        ∃! P : Ideal (X.presheaf.stalk x), P ≠ ⊥ ∧ P.IsPrime) :=
    (IsDiscreteValuationRing.TFAE (X.presheaf.stalk x) hnf).out 1 4
  exact key.mpr ⟨hnorm x, huniq⟩

theorem wc_integral_hartogs_sections : ∀ (X : Scheme.{u}) [IsIntegral X] (V : X.Opens) [Nonempty V]
    (ℓ : X.functionField),
    (∀ x : V, ∃ t : X.presheaf.stalk (x : X),
      algebraMap (X.presheaf.stalk (x : X)) X.functionField t = ℓ) →
    ∃ s : Γ(X, V), (X.germToFunctionField V).hom s = ℓ :=
by
  intro X _ V _ ℓ hℓ
  have hspec : ∀ x : X, genericPoint X ⤳ x := fun x =>
    (genericPoint_spec X).specializes (Set.mem_univ x)
  have key : ∀ (U U' : X.Opens) (i : U ⟶ U') (x : X) (hx : x ∈ U) (hx' : x ∈ U')
      (s : Γ(X, U')),
      (X.presheaf.germ U x hx).hom ((X.presheaf.map i.op).hom s) =
        (X.presheaf.germ U' x hx').hom s := by
    intro U U' i x hx hx' s
    exact TopCat.Presheaf.germ_res_apply X.presheaf i x hx s
  have hloc : ∀ x : V, ∃ (W : X.Opens) (_ : W ≤ V) (_ : (x : X) ∈ W)
      (hη : genericPoint X ∈ W) (s : Γ(X, W)),
      (X.presheaf.germ W (genericPoint X) hη).hom s = ℓ := by
    intro x
    obtain ⟨t, ht⟩ := hℓ x
    obtain ⟨W', hxW', s', hs'⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf t
    have hηW' : genericPoint X ∈ W' := (hspec x).mem_open W'.isOpen hxW'
    have hηV : genericPoint X ∈ V := (hspec x).mem_open V.isOpen x.2
    have hηWV : genericPoint X ∈ W' ⊓ V := ⟨hηW', hηV⟩
    refine ⟨W' ⊓ V, inf_le_right, ⟨hxW', x.2⟩, hηWV,
      (X.presheaf.map (homOfLE inf_le_left : W' ⊓ V ⟶ W').op).hom s', ?_⟩
    have e1 := key (W' ⊓ V) W' (homOfLE inf_le_left) (genericPoint X) hηWV hηW' s'
    have e2 : (X.presheaf.germ W' (genericPoint X) hηW').hom s' =
        (X.presheaf.stalkSpecializes (hspec x)).hom ((X.presheaf.germ W' (x : X) hxW').hom s') :=
      (TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hxW' (hspec x) s').symm
    rw [e1, e2, ← ht]
    have e3 : (X.presheaf.germ W' (x : X) hxW').hom s' = t := hs'
    rw [e3]
    rfl
  choose W hWV hxW hηW sf hsf using hloc
  have hcover : V ≤ iSup W := fun x hx =>
    TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxW ⟨x, hx⟩⟩
  have hcompat : TopCat.Presheaf.IsCompatible X.sheaf.obj W sf := by
    intro i j
    have hij : genericPoint X ∈ W i ⊓ W j := ⟨hηW i, hηW j⟩
    apply germ_injective_of_isIntegral X (genericPoint X) hij
    have a1 := key (W i ⊓ W j) (W i) (TopologicalSpace.Opens.infLELeft (W i) (W j))
      (genericPoint X) hij (hηW i) (sf i)
    have a2 := key (W i ⊓ W j) (W j) (TopologicalSpace.Opens.infLERight (W i) (W j))
      (genericPoint X) hij (hηW j) (sf j)
    exact a1.trans ((hsf i).trans ((hsf j).symm.trans a2.symm))
  obtain ⟨s, hs, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf W V
    (fun i => homOfLE (hWV i)) hcover sf hcompat
  obtain ⟨x₀⟩ := ‹Nonempty V›
  have hηV : genericPoint X ∈ V := (hspec x₀.1).mem_open V.isOpen x₀.2
  let i₀ : V := ⟨genericPoint X, hηV⟩
  let s₀ : Γ(X, V) := s
  refine ⟨s₀, ?_⟩
  calc (X.germToFunctionField V).hom s₀ = (X.presheaf.germ V (genericPoint X) hηV).hom s₀ := rfl
    _ = (X.presheaf.germ (W i₀) (genericPoint X) (hηW i₀)).hom
          ((X.presheaf.map (homOfLE (hWV i₀)).op).hom s₀) :=
        (key (W i₀) V (homOfLE (hWV i₀)) (genericPoint X) (hηW i₀) hηV s₀).symm
    _ = (X.presheaf.germ (W i₀) (genericPoint X) (hηW i₀)).hom (sf i₀) := congrArg _ (hs i₀)
    _ = ℓ := hsf i₀

theorem wc_dedekind_affine_points : ∀ (X : Scheme.{u}) [IrreducibleSpace X] (U : X.Opens)
    [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U),
    genericPoint X ∈ U ∧
    Function.Injective (fun v : IsDedekindDomain.HeightOneSpectrum Γ(X, U) =>
      (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X)) ∧
    (∀ v : IsDedekindDomain.HeightOneSpectrum Γ(X, U),
      (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) ∈ U ∧
      (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) ≠ genericPoint X) ∧
    ∀ x ∈ U, x ≠ genericPoint X → ∃ v : IsDedekindDomain.HeightOneSpectrum Γ(X, U),
      (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) = x :=
by
  intro X _ U _ hU
  classical
  haveI : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
  have hinj : Function.Injective hU.fromSpec :=
    hU.fromSpec.isOpenEmbedding.isEmbedding.injective
  have hrange : Set.range hU.fromSpec = (U : Set X) := hU.range_fromSpec
  let p₀ : PrimeSpectrum Γ(X, U) := ⟨⊥, Ideal.isPrime_bot⟩
  have hmem : ∀ p, hU.fromSpec p ∈ U := fun p => by
    have h : hU.fromSpec p ∈ Set.range hU.fromSpec := ⟨p, rfl⟩
    rw [hrange] at h
    exact h
  have hη : genericPoint X ∈ U :=
    ((genericPoint_spec X).mem_open_set_iff U.isOpen).mpr ⟨hU.fromSpec p₀, trivial, hmem p₀⟩
  have hpre : ∀ x ∈ U, ∃ q, hU.fromSpec q = x := fun x hx => by
    have h : x ∈ Set.range hU.fromSpec := by rw [hrange]; exact hx
    exact h
  have hp₀ : hU.fromSpec p₀ = genericPoint X := by
    obtain ⟨q, hq⟩ := hpre _ hη
    have h1 : p₀ ⤳ q := (PrimeSpectrum.le_iff_specializes p₀ q).mp
      (show (⊥ : Ideal Γ(X, U)) ≤ q.asIdeal from bot_le)
    have h2 : hU.fromSpec p₀ ⤳ hU.fromSpec q := h1.map hU.fromSpec.continuous
    rw [hq] at h2
    exact (h2.antisymm (genericPoint_specializes _)).eq
  refine ⟨hη, ?_, fun v => ⟨hmem _, ?_⟩, ?_⟩
  · intro v w h
    have h' := congrArg PrimeSpectrum.asIdeal (hinj h)
    exact IsDedekindDomain.HeightOneSpectrum.ext h'
  · intro h
    rw [← hp₀] at h
    have h' := congrArg PrimeSpectrum.asIdeal (hinj h)
    exact v.ne_bot h'
  · intro x hx hxη
    obtain ⟨q, rfl⟩ := hpre x hx
    have hq : q.asIdeal ≠ ⊥ := fun h => hxη (by
      have e : q = p₀ := PrimeSpectrum.ext h
      rw [e, hp₀])
    exact ⟨⟨q.asIdeal, q.isPrime, hq⟩, rfl⟩

theorem dvr_count_spanSingleton : ∀ (R : Type u) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [IsDedekindDomain R]
    (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
    (w : IsDedekindDomain.HeightOneSpectrum R) (f : K), f ≠ 0 →
    ((∃ r : R, algebraMap R K r = f) ↔
      0 ≤ FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) f)) ∧
    ∀ ϖ : R, Irreducible ϖ →
      FractionalIdeal.count K w
        (FractionalIdeal.spanSingleton (nonZeroDivisors R) (algebraMap R K ϖ)) = 1 :=
by
  classical
  intro R _ _ _ _ K _ _ _ w f hf
  have hinj : Function.Injective (algebraMap R K) := IsFractionRing.injective R K

  have s2 : ∀ ϖ : R, Irreducible ϖ → ∀ (v : Rˣ) (n : ℕ),
      FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R)
        (algebraMap R K ((v : R) * ϖ ^ n))) = n := by
    intro ϖ hϖ v n
    have ha : w.asIdeal = Ideal.span {ϖ} := by
      rw [IsLocalRing.eq_maximalIdeal w.isMaximal]
      exact (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have hb : FractionalIdeal.spanSingleton (nonZeroDivisors R) (algebraMap R K ((v : R) * ϖ ^ n))
        = ((w.asIdeal : FractionalIdeal (nonZeroDivisors R) K)) ^ n := by
      rw [← FractionalIdeal.coeIdeal_span_singleton, Ideal.span_singleton_mul_left_unit v.isUnit,
        ← Ideal.span_singleton_pow, FractionalIdeal.coeIdeal_pow, ha]
    rw [hb, FractionalIdeal.count_pow, FractionalIdeal.count_maximal, if_pos rfl, mul_one]

  have s3 : ∀ ϖ : R, Irreducible ϖ → ∃ (v : Rˣ) (m k : ℕ),
      f * algebraMap R K (ϖ ^ k) = algebraMap R K ((v : R) * ϖ ^ m) := by
    intro ϖ hϖ
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := R) f
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    have hφb : algebraMap R K b ≠ 0 := (map_ne_zero_iff _ hinj).mpr hb0
    have ha0 : a ≠ 0 := by
      rintro rfl
      apply hf
      rw [← hab, map_zero, zero_div]
    obtain ⟨m, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha0 hϖ
    obtain ⟨k, u', hu'⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hϖ
    refine ⟨u * u'⁻¹, m, k, ?_⟩
    have e1 : f * algebraMap R K b = algebraMap R K a := by
      rw [← hab, div_mul_cancel₀ _ hφb]
    have e2 : algebraMap R K (u' : R) * algebraMap R K ((u'⁻¹ : Rˣ) : R) = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    rw [hu, hu'] at e1
    simp only [map_mul, map_pow, Units.val_mul] at e1 ⊢
    linear_combination (algebraMap R K ((u'⁻¹ : Rˣ) : R)) * e1
      - f * (algebraMap R K ϖ) ^ k * e2
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · rintro ⟨r, rfl⟩
    rw [← FractionalIdeal.coeIdeal_span_singleton]
    exact FractionalIdeal.count_coe_nonneg K w _
  · intro hc
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    obtain ⟨v, m, k, hvmk⟩ := s3 ϖ hϖ
    have hP : algebraMap R K (ϖ ^ k) ≠ 0 :=
      (map_ne_zero_iff _ hinj).mpr (pow_ne_zero k hϖ.ne_zero)
    have hI : FractionalIdeal.spanSingleton (nonZeroDivisors R) f ≠ 0 := fun h =>
      hf (FractionalIdeal.spanSingleton_eq_zero_iff.mp h)
    have hJ : FractionalIdeal.spanSingleton (nonZeroDivisors R) (algebraMap R K (ϖ ^ k)) ≠ 0 :=
      fun h => hP (FractionalIdeal.spanSingleton_eq_zero_iff.mp h)
    have hmul := FractionalIdeal.count_mul K w hI hJ
    rw [FractionalIdeal.spanSingleton_mul_spanSingleton, hvmk, s2 ϖ hϖ v m] at hmul
    have hk := s2 ϖ hϖ 1 k
    rw [Units.val_one, one_mul] at hk
    rw [hk] at hmul
    have hkm : k ≤ m := by omega
    refine ⟨(v : R) * ϖ ^ (m - k), ?_⟩
    apply mul_right_cancel₀ hP
    rw [hvmk, ← map_mul, mul_assoc, ← pow_add, Nat.sub_add_cancel hkm]
  · intro ϖ hϖ
    have := s2 ϖ hϖ 1 1
    rwa [Units.val_one, one_mul, pow_one, Nat.cast_one] at this

theorem dedekind_count_localization : ∀ (A : Type u) [CommRing A] [IsDedekindDomain A]
    (v : IsDedekindDomain.HeightOneSpectrum A)
    (R : Type u) [CommRing R] [IsDomain R] [IsDedekindDomain R] [Algebra A R]
    [IsLocalization.AtPrime R v.asIdeal]
    (K : Type u) [Field K] [Algebra A K] [Algebra R K] [IsScalarTower A R K]
    [IsFractionRing A K] [IsFractionRing R K]
    (w : IsDedekindDomain.HeightOneSpectrum R) (f : FractionRing A), f ≠ 0 →
    FractionalIdeal.count K w
        (FractionalIdeal.spanSingleton (nonZeroDivisors R) (FractionRing.algEquiv A K f)) =
      FractionalIdeal.count (FractionRing A) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors A) f) :=
by
  intro A _ _ v R _ _ _ _ _ K _ _ _ _ _ _ w f hf
  classical

  have s1 : ∀ (B : Type u) [CommRing B] [IsDedekindDomain B] (F : Type u) [Field F] [Algebra B F]
      [IsFractionRing B F] (v : IsDedekindDomain.HeightOneSpectrum B) (x y : F), x ≠ 0 → y ≠ 0 →
      FractionalIdeal.count F v (FractionalIdeal.spanSingleton (nonZeroDivisors B) (x / y)) =
        FractionalIdeal.count F v (FractionalIdeal.spanSingleton (nonZeroDivisors B) x) -
        FractionalIdeal.count F v (FractionalIdeal.spanSingleton (nonZeroDivisors B) y) := by
    intro B _ _ F _ _ _ v x y hx hy
    have h1 : FractionalIdeal.spanSingleton (nonZeroDivisors B) (x / y) ≠ 0 :=
      FractionalIdeal.spanSingleton_ne_zero_iff.mpr (div_ne_zero hx hy)
    have h2 : FractionalIdeal.spanSingleton (nonZeroDivisors B) y ≠ 0 :=
      FractionalIdeal.spanSingleton_ne_zero_iff.mpr hy
    have h3 := FractionalIdeal.count_mul F v h1 h2
    rw [FractionalIdeal.spanSingleton_mul_spanSingleton, div_mul_cancel₀ x hy] at h3
    rw [h3]; ring

  have s2 : ∀ (I : Ideal A), I ≠ ⊥ → ∃ (n : ℕ) (J : Ideal A),
      (n : ℤ) = FractionalIdeal.count (FractionRing A) v
        (I : FractionalIdeal (nonZeroDivisors A) (FractionRing A)) ∧
      I = v.asIdeal ^ n * J ∧ ¬ J ≤ v.asIdeal := by
    intro I hI
    have hI0 : I ≠ 0 := hI
    have hcount := FractionalIdeal.count_coe (FractionRing A) v hI0
    have hm : Associates.mk I ≠ 0 := Associates.mk_ne_zero.mpr hI0
    have hp : Irreducible (Associates.mk v.asIdeal) :=
      Associates.irreducible_mk.mpr v.prime.irreducible
    have key : ∀ k, v.asIdeal ^ k ∣ I ↔
        k ≤ (Associates.mk v.asIdeal).count (Associates.mk I).factors := by
      intro k
      rw [← Associates.prime_pow_dvd_iff_le hm hp, ← Associates.mk_pow,
        Associates.mk_le_mk_iff_dvd]
    generalize hn : (Associates.mk v.asIdeal).count (Associates.mk I).factors = n at key hcount
    obtain ⟨J, hJ⟩ := (key n).mpr le_rfl
    refine ⟨n, J, hcount.symm, hJ, ?_⟩
    intro hle
    have hvJ : v.asIdeal ∣ J := Ideal.dvd_iff_le.mpr hle
    have hd : v.asIdeal ^ (n + 1) ∣ I := by
      have h2 : v.asIdeal ^ n * v.asIdeal ∣ v.asIdeal ^ n * J := mul_dvd_mul_left _ hvJ
      rw [← pow_succ, ← hJ] at h2
      exact h2
    have := (key (n + 1)).mp hd
    omega

  have : IsLocalRing R := IsLocalization.AtPrime.isLocalRing R v.asIdeal
  have s3 : Ideal.map (algebraMap A R) v.asIdeal = w.asIdeal := by
    rw [IsLocalization.AtPrime.map_eq_maximalIdeal v.asIdeal R]
    exact (IsLocalRing.eq_maximalIdeal w.isMaximal).symm
  have s4 : ∀ J : Ideal A, ¬ J ≤ v.asIdeal → Ideal.map (algebraMap A R) J = ⊤ := by
    intro J hJ
    obtain ⟨j, hj, hjv⟩ := SetLike.not_le_iff_exists.mp hJ
    have hu : IsUnit (algebraMap A R j) :=
      (IsLocalization.AtPrime.isUnit_to_map_iff R v.asIdeal j).mpr hjv
    exact Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ hj) hu

  have s5 : ∀ a : A, a ≠ 0 →
      FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R)
        (algebraMap R K (algebraMap A R a))) =
      FractionalIdeal.count (FractionRing A) v (FractionalIdeal.spanSingleton (nonZeroDivisors A)
        (algebraMap A (FractionRing A) a)) := by
    intro a ha
    have hI : Ideal.span {a} ≠ ⊥ := by rwa [Ne, Ideal.span_singleton_eq_bot]
    obtain ⟨n, J, hn, hIJ, hJ⟩ := s2 _ hI
    rw [← FractionalIdeal.coeIdeal_span_singleton, ← FractionalIdeal.coeIdeal_span_singleton, ← hn]
    have hspan : Ideal.span {algebraMap A R a} = w.asIdeal ^ n := by
      rw [← Set.image_singleton, ← Ideal.map_span, hIJ, Ideal.map_mul, Ideal.map_pow, s3,
        s4 J hJ, Ideal.mul_top]
    rw [hspan, FractionalIdeal.coeIdeal_pow, FractionalIdeal.count_pow,
      FractionalIdeal.count_self]
    simp

  obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (A := A) f
  have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
  have hx0 : x ≠ 0 := by
    rintro rfl
    simp at hf
  have e1 : FractionRing.algEquiv A K
      (algebraMap A (FractionRing A) x / algebraMap A (FractionRing A) y) =
      algebraMap R K (algebraMap A R x) / algebraMap R K (algebraMap A R y) := by
    rw [map_div₀, AlgEquiv.commutes, AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply]
  have inj := IsFractionRing.injective A (FractionRing A)
  have injK := IsFractionRing.injective A K
  have nz : ∀ a : A, a ≠ 0 → algebraMap R K (algebraMap A R a) ≠ 0 := by
    intro a ha h
    rw [← IsScalarTower.algebraMap_apply] at h
    exact ha (injK (h.trans (map_zero _).symm))
  have nzL : ∀ a : A, a ≠ 0 → algebraMap A (FractionRing A) a ≠ 0 :=
    fun a ha h => ha (inj (h.trans (map_zero _).symm))
  rw [e1, s1 R K w _ _ (nz x hx0) (nz y hy0), s1 A (FractionRing A) v _ _ (nzL x hx0) (nzL y hy0),
    s5 x hx0, s5 y hy0]

theorem wc_curve_ord_units_data : ∀ (X : Scheme.{u}) [IsIntegral X],
    (∀ x : X, x ≠ genericPoint X → IsDiscreteValuationRing (X.presheaf.stalk x)) →
    (∀ (V : X.Opens) [Nonempty V] (ℓ : X.functionField),
      (∀ x : V, ∃ t : X.presheaf.stalk (x : X),
        algebraMap (X.presheaf.stalk (x : X)) X.functionField t = ℓ) →
      ∃ s : Γ(X, V), (X.germToFunctionField V).hom s = ℓ) →
    (∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [IsDedekindDomain R]
      (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
      (w : IsDedekindDomain.HeightOneSpectrum R) (f : K), f ≠ 0 →
      ((∃ r : R, algebraMap R K r = f) ↔
        0 ≤ FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) f)) ∧
      ∀ ϖ : R, Irreducible ϖ →
        FractionalIdeal.count K w
          (FractionalIdeal.spanSingleton (nonZeroDivisors R) (algebraMap R K ϖ)) = 1) →
    (∀ (A : Type u) [CommRing A] [IsDedekindDomain A] (v : IsDedekindDomain.HeightOneSpectrum A)
      (R : Type u) [CommRing R] [IsDomain R] [IsDedekindDomain R] [Algebra A R]
      [IsLocalization.AtPrime R v.asIdeal]
      (K : Type u) [Field K] [Algebra A K] [Algebra R K] [IsScalarTower A R K]
      [IsFractionRing A K] [IsFractionRing R K]
      (w : IsDedekindDomain.HeightOneSpectrum R) (f : FractionRing A), f ≠ 0 →
      FractionalIdeal.count K w
          (FractionalIdeal.spanSingleton (nonZeroDivisors R) (FractionRing.algEquiv A K f)) =
        FractionalIdeal.count (FractionRing A) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors A) f)) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    (genericPoint X ∈ U ∧
      Function.Injective (fun v : IsDedekindDomain.HeightOneSpectrum Γ(X, U) =>
        (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X)) ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum Γ(X, U),
        (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) ∈ U ∧
        (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) ≠ genericPoint X) ∧
      ∀ x ∈ U, x ≠ genericPoint X → ∃ v : IsDedekindDomain.HeightOneSpectrum Γ(X, U),
        (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) = x) →
    ∃ (ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ)
      (ι : ∀ V : X.Opens, Additive (Γ(X, V))ˣ →+ Additive (FractionRing Γ(X, U))ˣ),
      (∀ m, ord (genericPoint X) m = 0) ∧
      (∀ m, {x | ord x m ≠ 0}.Finite) ∧
      (∀ x, x ≠ genericPoint X → ∃ m, ord x m = 1) ∧
      (∀ (V W : X.Opens) (hWV : W ≤ V), (W : Set X).Nonempty → ∀ g : (Γ(X, V))ˣ,
        ι W (Additive.ofMul (Units.map (X.presheaf.map (homOfLE hWV).op).hom.toMonoidHom g)) =
          ι V (Additive.ofMul g)) ∧
      (∀ V : X.Opens, (V : Set X).Nonempty → Function.Injective (ι V)) ∧
      (∀ V : X.Opens, (V : Set X).Nonempty →
        ∀ m, (∃ g, ι V g = m) ↔ ∀ x ∈ V, ord x m = 0) ∧
      ∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U)) (f : (FractionRing Γ(X, U))ˣ),
        ord (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩) (Additive.ofMul f) =
          FractionalIdeal.count (FractionRing Γ(X, U)) v
            (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U))) :=
by
  intro X _ hDVR hHart hS6 hS7 U _ hU hfin hP5
  classical
  haveI : Nonempty U := ⟨⟨genericPoint X, hP5.1⟩⟩
  letI : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  let E : Additive (FractionRing Γ(X, U))ˣ ≃+ Additive (X.functionField)ˣ :=
    MulEquiv.toAdditive (Units.mapEquiv (FractionRing.algEquiv Γ(X, U) X.functionField).toMulEquiv)

  have s1 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
      (w : IsDedekindDomain.HeightOneSpectrum R), ∃ o : Additive Kˣ →+ ℤ,
      (∀ f : Kˣ, o (Additive.ofMul f) =
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K))) ∧
      (∃ f : Kˣ, o (Additive.ofMul f) = 1) ∧
      ∀ f : Kˣ, o (Additive.ofMul f) = 0 ↔
        (∃ r : R, algebraMap R K r = (f : K)) ∧ ∃ r : R, algebraMap R K r = ((f⁻¹ : Kˣ) : K) := by
    intro R _ _ _ K _ _ _ w
    have hc_mul : ∀ f g : Kˣ,
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R)
          ((Additive.toMul (Additive.ofMul f + Additive.ofMul g) : Kˣ) : K)) =
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K)) +
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (g : K)) := by
      intro f g
      rw [toMul_add, toMul_ofMul, toMul_ofMul, Units.val_mul,
        ← FractionalIdeal.spanSingleton_mul_spanSingleton]
      exact FractionalIdeal.count_mul K w
        (FractionalIdeal.spanSingleton_ne_zero_iff.mpr f.ne_zero)
        (FractionalIdeal.spanSingleton_ne_zero_iff.mpr g.ne_zero)
    have hc_inv : ∀ f : Kˣ,
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R)
          ((f⁻¹ : Kˣ) : K)) =
        - FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K)) := by
      intro f
      rw [Units.val_inv_eq_inv_val, ← FractionalIdeal.spanSingleton_inv]
      exact FractionalIdeal.count_inv K w _
    refine ⟨AddMonoidHom.mk' (fun m => FractionalIdeal.count K w
      (FractionalIdeal.spanSingleton (nonZeroDivisors R) ((Additive.toMul m : Kˣ) : K)))
      (fun a b => hc_mul (Additive.toMul a) (Additive.toMul b)), fun f => rfl, ?_, ?_⟩
    · obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
      have h0 : algebraMap R K ϖ ≠ 0 := by
        intro h
        apply hϖ.ne_zero
        apply IsFractionRing.injective R K
        rw [h, map_zero]
      refine ⟨Units.mk0 _ h0, ?_⟩
      exact (hS6 R K w _ h0).2 ϖ hϖ
    · intro f
      have h1 := (hS6 R K w (f : K) f.ne_zero).1
      have h2 := (hS6 R K w ((f⁻¹ : Kˣ) : K) (f⁻¹).ne_zero).1
      have h3 := hc_inv f
      change FractionalIdeal.count K w
          (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K)) = 0 ↔ _
      rw [h1, h2, h3]
      constructor
      · intro h
        exact ⟨by omega, by omega⟩
      · rintro ⟨ha, hb⟩
        omega

  have K0 : ∀ (V : X.Opens) [Nonempty V] (x : X) (hx : x ∈ V) (s : Γ(X, V)),
      algebraMap (X.presheaf.stalk x) X.functionField ((X.presheaf.germ V x hx).hom s) =
        (X.germToFunctionField V).hom s := by
    intro V _ x hx s
    exact TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hx _ s

  have s2 : ∀ (V : X.Opens) [Nonempty V] (f : (X.functionField)ˣ),
      (∃ g : (Γ(X, V))ˣ, (X.germToFunctionField V).hom (g : Γ(X, V)) = (f : X.functionField)) ↔
      ∀ x : V, (x : X) ≠ genericPoint X →
        (∃ t : X.presheaf.stalk (x : X),
          algebraMap (X.presheaf.stalk (x : X)) X.functionField t = (f : X.functionField)) ∧
        ∃ t : X.presheaf.stalk (x : X),
          algebraMap (X.presheaf.stalk (x : X)) X.functionField t =
            ((f⁻¹ : (X.functionField)ˣ) : X.functionField) := by
    intro V _ f
    constructor
    · rintro ⟨g, hg⟩ x _
      refine ⟨⟨(X.presheaf.germ V x x.2).hom (g : Γ(X, V)), ?_⟩,
        ⟨(X.presheaf.germ V x x.2).hom ((g⁻¹ : (Γ(X, V))ˣ) : Γ(X, V)), ?_⟩⟩
      · rw [K0, hg]
      · rw [K0, map_units_inv, hg, Units.val_inv_eq_inv_val]
    · intro H
      have hall : ∀ ℓ : X.functionField, (∀ x : V, (x : X) ≠ genericPoint X →
          ∃ t : X.presheaf.stalk (x : X),
            algebraMap (X.presheaf.stalk (x : X)) X.functionField t = ℓ) →
          ∃ s : Γ(X, V), (X.germToFunctionField V).hom s = ℓ := by
        intro ℓ hℓ
        apply hHart V ℓ
        intro x
        by_cases hx : (x : X) = genericPoint X
        · obtain ⟨x, hxV⟩ := x
          simp only at hx
          subst hx
          refine ⟨ℓ, ?_⟩
          show (X.presheaf.stalkSpecializes _).hom ℓ = ℓ
          rw [TopCat.Presheaf.stalkSpecializes_refl]
          rfl
        · exact hℓ x hx
      obtain ⟨s, hs⟩ := hall f (fun x hx => (H x hx).1)
      obtain ⟨s', hs'⟩ := hall ((f⁻¹ : (X.functionField)ˣ) : X.functionField)
        (fun x hx => (H x hx).2)
      have h1 : s * s' = 1 := by
        apply Scheme.germToFunctionField_injective X V
        rw [map_mul, map_one, hs, hs', Units.mul_inv]
      exact ⟨⟨s, s', h1, by rw [mul_comm]; exact h1⟩, hs⟩

  have s3 : ∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U))
      [IsDedekindDomain (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩))]
      (w : IsDedekindDomain.HeightOneSpectrum
        (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)))
      (f : FractionRing Γ(X, U)), f ≠ 0 →
      FractionalIdeal.count X.functionField w
          (FractionalIdeal.spanSingleton
            (nonZeroDivisors (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)))
            (FractionRing.algEquiv Γ(X, U) X.functionField f)) =
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) f) := by
    intro v _ w f hf
    have hxU : (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) ∈ U := (hP5.2.2.1 v).1
    let xU : U := ⟨_, hxU⟩
    have hp : hU.primeIdealOf xU = ⟨v.asIdeal, v.isPrime⟩ := by
      apply hU.fromSpec.injective
      rw [hU.fromSpec_primeIdealOf xU]
    letI : Algebra Γ(X, U) (X.presheaf.stalk (xU : X)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf xU
    haveI : IsLocalization.AtPrime (X.presheaf.stalk (xU : X)) v.asIdeal := by
      have := hU.isLocalization_stalk xU
      rw [hp] at this
      exact this
    haveI : IsScalarTower Γ(X, U) (X.presheaf.stalk (xU : X)) X.functionField :=
      functionField_isScalarTower X U xU
    exact hS7 Γ(X, U) v (X.presheaf.stalk (xU : X)) X.functionField w f hf

  have hloc : ∀ x : X, (hx : x ≠ genericPoint X) → ∃ o : Additive (X.functionField)ˣ →+ ℤ,
      (∃ f : (X.functionField)ˣ, o (Additive.ofMul f) = 1) ∧
      (∀ f : (X.functionField)ˣ, o (Additive.ofMul f) = 0 ↔
        (∃ r : X.presheaf.stalk x, algebraMap _ X.functionField r = (f : X.functionField)) ∧
        ∃ r : X.presheaf.stalk x,
          algebraMap _ X.functionField r = ((f⁻¹ : (X.functionField)ˣ) : X.functionField)) ∧
      (haveI := hDVR x hx
       ∃ w : IsDedekindDomain.HeightOneSpectrum (X.presheaf.stalk x),
        ∀ f : (X.functionField)ˣ, o (Additive.ofMul f) =
          FractionalIdeal.count X.functionField w
            (FractionalIdeal.spanSingleton (nonZeroDivisors (X.presheaf.stalk x))
              (f : X.functionField))) := by
    intro x hx
    haveI := hDVR x hx
    let w : IsDedekindDomain.HeightOneSpectrum (X.presheaf.stalk x) :=
      ⟨IsLocalRing.maximalIdeal _, (IsLocalRing.maximalIdeal.isMaximal _).isPrime,
        IsDiscreteValuationRing.not_a_field _⟩
    obtain ⟨o, h1, h2, h3⟩ := s1 (X.presheaf.stalk x) X.functionField w
    exact ⟨o, h2, h3, w, h1⟩
  choose o ho using hloc
  let ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ := fun x =>
    if hx : x = genericPoint X then 0 else (o x hx).comp E.toAddMonoidHom
  let ι : ∀ V : X.Opens, Additive (Γ(X, V))ˣ →+ Additive (FractionRing Γ(X, U))ˣ := fun V =>
    if hV : (V : Set X).Nonempty then
      haveI : Nonempty V := ⟨⟨hV.some, hV.some_mem⟩⟩
      E.symm.toAddMonoidHom.comp
        (MonoidHom.toAdditive (Units.map (X.germToFunctionField V).hom.toMonoidHom))
    else 0
  have hord : ∀ x (hx : x ≠ genericPoint X) m, ord x m = o x hx (E m) := by
    intro x hx m
    show (if h : x = genericPoint X then 0 else (o x h).comp E.toAddMonoidHom) m = _
    rw [dif_neg hx]
    rfl
  have hι : ∀ (V : X.Opens) [Nonempty V] (g : (Γ(X, V))ˣ), ι V (Additive.ofMul g) =
      E.symm (Additive.ofMul (Units.map (X.germToFunctionField V).hom.toMonoidHom g)) := by
    intro V hne g
    obtain ⟨y⟩ := hne
    have hV : (V : Set X).Nonempty := ⟨y.1, y.2⟩
    show (if hV : (V : Set X).Nonempty then
      haveI : Nonempty V := ⟨⟨hV.some, hV.some_mem⟩⟩
      E.symm.toAddMonoidHom.comp
        (MonoidHom.toAdditive (Units.map (X.germToFunctionField V).hom.toMonoidHom))
      else 0) (Additive.ofMul g) = _
    rw [dif_pos hV]
    rfl
  have P1 : ∀ m, ord (genericPoint X) m = 0 := by
    intro m
    show (if h : genericPoint X = genericPoint X then 0
      else (o (genericPoint X) h).comp E.toAddMonoidHom) m = 0
    rw [dif_pos rfl]
    rfl
  have P7 : ∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U)) (f : (FractionRing Γ(X, U))ˣ),
      ord (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩) (Additive.ofMul f) =
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U))) := by
    intro v f
    have hx := (hP5.2.2.1 v).2
    rw [hord _ hx]
    haveI := hDVR _ hx
    obtain ⟨w, hw⟩ := (ho _ hx).2.2
    rw [show E (Additive.ofMul f) = Additive.ofMul (Additive.toMul (E (Additive.ofMul f))) from rfl,
      hw]
    exact s3 v w (f : FractionRing Γ(X, U)) f.ne_zero
  have P2 : ∀ m, {x | ord x m ≠ 0}.Finite := by
    intro m
    have hfin2 : {v : IsDedekindDomain.HeightOneSpectrum Γ(X, U) |
        ¬ FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U))
            ((Additive.toMul m : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U))) = 0}.Finite :=
      Filter.eventually_cofinite.mp (FractionalIdeal.finite_factors _)
    refine (hfin.union (hfin2.image (fun v => (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X)))).subset ?_
    intro x hx
    simp only [Set.mem_setOf_eq] at hx
    by_cases hxU : x ∈ U
    · right
      have hxη : x ≠ genericPoint X := by
        rintro rfl
        exact hx (P1 m)
      obtain ⟨v, rfl⟩ := hP5.2.2.2 x hxU hxη
      refine ⟨v, ?_, rfl⟩
      simp only [Set.mem_setOf_eq]
      rw [← P7 v (Additive.toMul m)]
      exact hx
    · left
      exact hxU
  have P3 : ∀ x, x ≠ genericPoint X → ∃ m, ord x m = 1 := by
    intro x hx
    obtain ⟨f, hf⟩ := (ho x hx).1
    refine ⟨E.symm (Additive.ofMul f), ?_⟩
    rw [hord x hx, AddEquiv.apply_symm_apply]
    exact hf
  have P4 : ∀ (V W : X.Opens) (hWV : W ≤ V), (W : Set X).Nonempty → ∀ g : (Γ(X, V))ˣ,
      ι W (Additive.ofMul (Units.map (X.presheaf.map (homOfLE hWV).op).hom.toMonoidHom g)) =
        ι V (Additive.ofMul g) := by
    intro V W hWV hW g
    obtain ⟨y, hy⟩ := hW
    haveI : Nonempty W := ⟨⟨y, hy⟩⟩
    haveI : Nonempty V := ⟨⟨y, hWV hy⟩⟩
    rw [hι W, hι V]
    congr 2
    apply Units.ext
    show (X.germToFunctionField W).hom ((X.presheaf.map (homOfLE hWV).op).hom (g : Γ(X, V))) =
      (X.germToFunctionField V).hom (g : Γ(X, V))
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hWV) (genericPoint X) _
      (g : Γ(X, V))
  have P5 : ∀ V : X.Opens, (V : Set X).Nonempty → Function.Injective (ι V) := by
    intro V hV a b hab
    obtain ⟨y, hy⟩ := hV
    haveI : Nonempty V := ⟨⟨y, hy⟩⟩
    have ha := hι V (Additive.toMul a)
    have hb := hι V (Additive.toMul b)
    rw [ofMul_toMul] at ha hb
    rw [ha, hb] at hab
    have h2 := E.symm.injective hab
    have h3 := Additive.ofMul.injective h2
    exact Additive.toMul.injective
      (Units.map_injective (Scheme.germToFunctionField_injective X V) h3)
  have P6 : ∀ V : X.Opens, (V : Set X).Nonempty →
      ∀ m, (∃ g, ι V g = m) ↔ ∀ x ∈ V, ord x m = 0 := by
    intro V hV m
    obtain ⟨y, hy⟩ := hV
    haveI : Nonempty V := ⟨⟨y, hy⟩⟩
    have step1 : (∃ g, ι V g = m) ↔ ∃ g : (Γ(X, V))ˣ,
        Units.map (X.germToFunctionField V).hom.toMonoidHom g = Additive.toMul (E m) := by
      constructor
      · rintro ⟨g, hg⟩
        refine ⟨Additive.toMul g, ?_⟩
        have h1 := hι V (Additive.toMul g)
        rw [ofMul_toMul, hg] at h1
        rw [h1, AddEquiv.apply_symm_apply, toMul_ofMul]
      · rintro ⟨g, hg⟩
        refine ⟨Additive.ofMul g, ?_⟩
        rw [hι, hg, ofMul_toMul, AddEquiv.symm_apply_apply]
    have step2 : (∃ g : (Γ(X, V))ˣ,
        Units.map (X.germToFunctionField V).hom.toMonoidHom g = Additive.toMul (E m)) ↔
        ∃ g : (Γ(X, V))ˣ, (X.germToFunctionField V).hom (g : Γ(X, V)) =
          ((Additive.toMul (E m) : (X.functionField)ˣ) : X.functionField) :=
      exists_congr (fun g => Units.ext_iff)
    rw [step1, step2, s2 V]
    constructor
    · intro H x hxV
      by_cases hx : x = genericPoint X
      · subst hx
        exact P1 m
      · rw [hord x hx, show E m = Additive.ofMul (Additive.toMul (E m)) from rfl,
          (ho x hx).2.1]
        exact H ⟨x, hxV⟩ hx
    · intro H x hx
      rw [← (ho x hx).2.1, ← show E m = Additive.ofMul (Additive.toMul (E m)) from rfl,
        ← hord x hx]
      exact H x x.2
  exact ⟨ord, ι, P1, P2, P3, P4, P5, P6, P7⟩

theorem wc_abstract_divisor_ses : ∀ (T : Type u) [TopologicalSpace T] (η : T)
    (M : Type u) [AddCommGroup M] (ord : T → M →+ ℤ)
    (G : Sheaf (Opens.grothendieckTopology T) AddCommGrpCat.{u})
    (ι : ∀ V : TopologicalSpace.Opens T, G.obj.obj (Opposite.op V) →+ M),
    (∀ V : TopologicalSpace.Opens T, (V : Set T).Nonempty → η ∈ V) →
    (∀ V : TopologicalSpace.Opens T, IsCompact (V : Set T)) →
    (∀ S : Set T, S.Finite → η ∉ S → IsClosed S) →
    (∀ m, ord η m = 0) →
    (∀ m, {x | ord x m ≠ 0}.Finite) →
    (∀ x, x ≠ η → ∃ m, ord x m = 1) →
    (∀ (V W : TopologicalSpace.Opens T) (hWV : W ≤ V), (W : Set T).Nonempty →
      ∀ g, ι W (G.obj.map (homOfLE hWV).op g) = ι V g) →
    (∀ V : TopologicalSpace.Opens T, (V : Set T).Nonempty → Function.Injective (ι V)) →
    (∀ V : TopologicalSpace.Opens T, (V : Set T).Nonempty →
      ∀ m, (∃ g, ι V g = m) ↔ ∀ x ∈ V, ord x m = 0) →
    ∃ (K D : Sheaf (Opens.grothendieckTopology T) AddCommGrpCat.{u}) (i : G ⟶ K) (d : K ⟶ D)
      (h : i ≫ d = 0),
      (ShortComplex.mk i d h).ShortExact ∧
      (∀ (V W : TopologicalSpace.Opens T) (hWV : W ≤ V),
        Function.Surjective (K.obj.map (homOfLE hWV).op)) ∧
      ∃ (eK : K.obj.obj (Opposite.op ⊤) ≃+ M) (eD : D.obj.obj (Opposite.op ⊤) →+ (T →₀ ℤ)),
        Function.Injective eD ∧ (∀ n : T →₀ ℤ, n η = 0 → ∃ w, eD w = n) ∧
        (∀ w, eD w η = 0) ∧
        ∀ s x, eD (d.hom.app (Opposite.op ⊤) s) x = ord x (eK s) :=
by
  intro T _ η M _ ord G ι H1 H2 H3 H4 H5 H6 H7 H8 H9
  classical

  have sky : ∃ (K : Sheaf (Opens.grothendieckTopology T) AddCommGrpCat.{u})
      (e : ∀ V : TopologicalSpace.Opens T, η ∈ V → (K.obj.obj (Opposite.op V) ≃+ M)),
      (∀ V : TopologicalSpace.Opens T, η ∉ V → Subsingleton (K.obj.obj (Opposite.op V))) ∧
      (∀ (V W : TopologicalSpace.Opens T) (hWV : W ≤ V) (hW : η ∈ W)
        (s : K.obj.obj (Opposite.op V)),
        e W hW (K.obj.map (homOfLE hWV).op s) = e V (hWV hW) s) ∧
      ∀ (F : Sheaf (Opens.grothendieckTopology T) AddCommGrpCat.{u})
        (ψ : ∀ V : TopologicalSpace.Opens T, F.obj.obj (Opposite.op V) →+ M),
        (∀ (V W : TopologicalSpace.Opens T) (hWV : W ≤ V), η ∈ W →
          ∀ g, ψ W (F.obj.map (homOfLE hWV).op g) = ψ V g) →
        ∃ i : F ⟶ K, ∀ (V : TopologicalSpace.Opens T) (h : η ∈ V)
          (g : F.obj.obj (Opposite.op V)), e V h (i.hom.app (Opposite.op V) g) = ψ V g := by
    let K₀ : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      { obj := fun V => AddCommGrpCat.of (PLift (η ∈ V.unop) → M)
        map := fun {V W} f => AddCommGrpCat.ofHom
          { toFun := fun s p => s ⟨leOfHom f.unop p.down⟩
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }
    have hK₀ : Presheaf.IsSheaf (Opens.grothendieckTopology T) K₀ := by
      change TopCat.Presheaf.IsSheaf (X := TopCat.of T) K₀
      rw [TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing]
      intro κ U sf hsf
      have key : ∀ i j (hi : η ∈ U i) (hj : η ∈ U j),
          (sf i : PLift (η ∈ U i) → M) ⟨hi⟩ = (sf j : PLift (η ∈ U j) → M) ⟨hj⟩ := by
        intro i j hi hj
        have h1 := hsf i j
        exact congrFun h1 ⟨⟨hi, hj⟩⟩
      refine ⟨(fun p => (sf (TopologicalSpace.Opens.mem_iSup.mp p.down).choose :
          PLift (η ∈ U _) → M) ⟨(TopologicalSpace.Opens.mem_iSup.mp p.down).choose_spec⟩ :
          PLift (η ∈ iSup U) → M), ?_, ?_⟩
      · intro i
        funext p
        exact key _ _ _ _
      · intro s hs
        funext p
        obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp p.down
        have h1 := congrFun (hs j) ⟨hj⟩
        exact h1.trans (key _ _ _ _)
    refine ⟨⟨K₀, hK₀⟩, fun V h =>
      { toFun := fun s => (s : PLift (η ∈ V) → M) ⟨h⟩
        invFun := fun m => ((fun _ => m : PLift (η ∈ V) → M))
        left_inv := fun s => rfl
        right_inv := fun m => rfl
        map_add' := fun _ _ => rfl }, ?_, ?_, ?_⟩
    · intro V hV
      refine ⟨fun s s' => ?_⟩
      funext p
      exact absurd p.down hV
    · intro V W hWV hW s
      rfl
    · intro F ψ hψ
      refine ⟨ObjectProperty.homMk
        { app := fun V => AddCommGrpCat.ofHom
            { toFun := fun g => ((fun _ => ψ V.unop g : PLift (η ∈ V.unop) → M))
              map_zero' := by funext p; simp
              map_add' := fun a b => by funext p; simp }
          naturality := fun V W f => by
            ext g p
            exact (hψ V.unop W.unop (leOfHom f.unop) p.down g) }, ?_⟩
      intro V h g
      rfl

  have divs : ∃ (D : Sheaf (Opens.grothendieckTopology T) AddCommGrpCat.{u})
      (e : ∀ V : TopologicalSpace.Opens T, D.obj.obj (Opposite.op V) →+ (T →₀ ℤ)),
      (∀ V : TopologicalSpace.Opens T, Function.Injective (e V)) ∧
      (∀ (V : TopologicalSpace.Opens T) (n : T →₀ ℤ),
        (∃ s, e V s = n) ↔ ∀ x, n x ≠ 0 → x ∈ V ∧ x ≠ η) ∧
      (∀ (V W : TopologicalSpace.Opens T) (hWV : W ≤ V) (s : D.obj.obj (Opposite.op V)) (x : T),
        x ∈ W → e W (D.obj.map (homOfLE hWV).op s) x = e V s x) ∧
      ∀ (F : Sheaf (Opens.grothendieckTopology T) AddCommGrpCat.{u})
        (φ : ∀ V : TopologicalSpace.Opens T, F.obj.obj (Opposite.op V) →+ (T →₀ ℤ)),
        (∀ (V : TopologicalSpace.Opens T) (g : F.obj.obj (Opposite.op V)) (x : T),
          φ V g x ≠ 0 → x ∈ V ∧ x ≠ η) →
        (∀ (V W : TopologicalSpace.Opens T) (hWV : W ≤ V) (g : F.obj.obj (Opposite.op V)) (x : T),
          x ∈ W → φ W (F.obj.map (homOfLE hWV).op g) x = φ V g x) →
        ∃ d : F ⟶ D, ∀ (V : TopologicalSpace.Opens T) (g : F.obj.obj (Opposite.op V)),
          e V (d.hom.app (Opposite.op V) g) = φ V g := by
    let DSub : TopologicalSpace.Opens T → AddSubgroup (T →₀ ℤ) := fun V =>
      { carrier := {n | ∀ x, n x ≠ 0 → x ∈ V ∧ x ≠ η}
        zero_mem' := fun x hx => absurd rfl hx
        add_mem' := fun {a b} ha hb x hx => by
          by_cases hax : a x = 0
          · have : b x ≠ 0 := by simpa [hax] using hx
            exact hb x this
          · exact ha x hax
        neg_mem' := fun {a} ha x hx => ha x (by simpa using hx) }
    let resH : ∀ (V W : TopologicalSpace.Opens T), DSub V →+ DSub W := fun V W =>
      ((Finsupp.filterAddHom (· ∈ W)).comp (DSub V).subtype).codRestrict (DSub W)
        (fun n x hx => by
          change (Finsupp.filter (· ∈ W) (n : T →₀ ℤ)) x ≠ 0 at hx
          rw [Finsupp.filter_apply] at hx
          split_ifs at hx with hxW
          · exact ⟨hxW, (n.2 x hx).2⟩
          · exact absurd rfl hx)
    have resH_apply : ∀ (V W : TopologicalSpace.Opens T) (n : DSub V) (x : T),
        ((resH V W n : DSub W) : T →₀ ℤ) x = if x ∈ W then (n : T →₀ ℤ) x else 0 := by
      intro V W n x
      change (Finsupp.filter (· ∈ W) (n : T →₀ ℤ)) x = _
      rw [Finsupp.filter_apply]
    have val_out : ∀ {V : TopologicalSpace.Opens T} (n : DSub V) (x : T), x ∉ V →
        (n : T →₀ ℤ) x = 0 := by
      intro V n x hx
      by_contra hne
      exact hx (n.2 x hne).1
    let D₀ : (TopologicalSpace.Opens T)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      { obj := fun V => AddCommGrpCat.of (DSub V.unop)
        map := fun {V W} _ => AddCommGrpCat.ofHom (resH V.unop W.unop)
        map_id := fun V => by
          ext n x
          change ((resH V.unop V.unop n : DSub V.unop) : T →₀ ℤ) x = (n : T →₀ ℤ) x
          rw [resH_apply]
          split_ifs with hx
          · rfl
          · exact (val_out n x hx).symm
        map_comp := fun {U V W} f g => by
          ext n x
          change ((resH U.unop W.unop n : DSub W.unop) : T →₀ ℤ) x =
            ((resH V.unop W.unop (resH U.unop V.unop n) : DSub W.unop) : T →₀ ℤ) x
          rw [resH_apply, resH_apply, resH_apply]
          split_ifs with h1 h2 <;> first | rfl | exact absurd (leOfHom g.unop h1) h2 }
    have hD₀ : Presheaf.IsSheaf (Opens.grothendieckTopology T) D₀ := by
      change TopCat.Presheaf.IsSheaf (X := TopCat.of T) D₀
      rw [TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing]
      intro κ U nf hnf
      have key : ∀ i j x, x ∈ U i → x ∈ U j →
          ((nf i : DSub (U i)) : T →₀ ℤ) x = ((nf j : DSub (U j)) : T →₀ ℤ) x := by
        intro i j x hi hj
        have h1 := congrArg (fun z : DSub (U i ⊓ U j) => (z : T →₀ ℤ) x) (hnf i j)
        change ((resH (U i) (U i ⊓ U j) (nf i) : DSub (U i ⊓ U j)) : T →₀ ℤ) x =
          ((resH (U j) (U i ⊓ U j) (nf j) : DSub (U i ⊓ U j)) : T →₀ ℤ) x at h1
        rw [resH_apply, resH_apply, if_pos ⟨hi, hj⟩, if_pos ⟨hi, hj⟩] at h1
        exact h1
      let g : T → ℤ := fun x =>
        if h : ∃ i, x ∈ U i then ((nf h.choose : DSub (U _)) : T →₀ ℤ) x else 0
      obtain ⟨t, ht⟩ := (H2 (iSup U)).elim_finite_subcover (fun i => (U i : Set T))
        (fun i => (U i).isOpen) (by
          intro x hx
          obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
          exact Set.mem_iUnion.mpr ⟨i, hi⟩)
      have hgfin : (Function.support g).Finite := by
        refine (Set.Finite.biUnion (t.finite_toSet) (fun i _ =>
          ((nf i : DSub (U i)) : T →₀ ℤ).finite_support)).subset ?_
        intro x hx
        have hx' : g x ≠ 0 := hx
        simp only [g] at hx'
        split_ifs at hx' with h
        · have hxV : x ∈ (iSup U : TopologicalSpace.Opens T) :=
            TopologicalSpace.Opens.mem_iSup.mpr ⟨_, h.choose_spec⟩
          obtain ⟨i₀, hi₀t, hi₀⟩ := Set.mem_iUnion₂.mp (ht hxV)
          refine Set.mem_iUnion₂.mpr ⟨i₀, hi₀t, ?_⟩
          change ((nf i₀ : DSub (U i₀)) : T →₀ ℤ) x ≠ 0
          rw [key i₀ _ x hi₀ h.choose_spec]
          exact hx'
        · exact absurd rfl hx'
      let n : T →₀ ℤ := Finsupp.ofSupportFinite g hgfin
      have hn : ∀ x, n x = g x := fun x => by simp [n, Finsupp.ofSupportFinite_coe]
      have hnmem : n ∈ DSub (iSup U) := by
        intro x hx
        rw [hn] at hx
        simp only [g] at hx
        split_ifs at hx with h
        · exact ⟨TopologicalSpace.Opens.mem_iSup.mpr ⟨_, h.choose_spec⟩, ((nf _).2 x hx).2⟩
        · exact absurd rfl hx
      refine ⟨(⟨n, hnmem⟩ : DSub (iSup U)), ?_, ?_⟩
      · intro i
        apply Subtype.ext
        ext x
        change ((resH (iSup U) (U i) (⟨n, hnmem⟩ : DSub (iSup U)) : DSub (U i)) : T →₀ ℤ) x =
          ((nf i : DSub (U i)) : T →₀ ℤ) x
        rw [resH_apply]
        split_ifs with hx
        · change n x = _
          rw [hn]
          simp only [g]
          rw [dif_pos ⟨i, hx⟩]
          exact key _ _ x (Exists.choose_spec (⟨i, hx⟩ : ∃ i, x ∈ U i)) hx
        · exact (val_out (nf i) x hx).symm
      · intro s hs
        apply Subtype.ext
        ext x
        by_cases hx : x ∈ (iSup U : TopologicalSpace.Opens T)
        · obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
          have h1 := congrArg (fun z : DSub (U i) => (z : T →₀ ℤ) x) (hs i)
          change ((resH (iSup U) (U i) s : DSub (U i)) : T →₀ ℤ) x =
            ((nf i : DSub (U i)) : T →₀ ℤ) x at h1
          rw [resH_apply, if_pos hi] at h1
          change (s : T →₀ ℤ) x = n x
          rw [h1, hn]
          simp only [g]
          rw [dif_pos ⟨i, hi⟩]
          exact key _ _ x hi (Exists.choose_spec (⟨i, hi⟩ : ∃ i, x ∈ U i))
        · change (s : T →₀ ℤ) x = n x
          rw [val_out s x hx]
          exact (val_out (⟨n, hnmem⟩ : DSub (iSup U)) x hx).symm
    refine ⟨⟨D₀, hD₀⟩, fun V => (DSub V).subtype, fun V => Subtype.val_injective, ?_, ?_, ?_⟩
    · intro V n
      constructor
      · rintro ⟨s, rfl⟩
        exact s.2
      · intro h
        exact ⟨⟨n, h⟩, rfl⟩
    · intro V W hWV s x hx
      change ((resH V W s : DSub W) : T →₀ ℤ) x = (s : T →₀ ℤ) x
      rw [resH_apply, if_pos hx]
    · intro F φ hsupp hcompat
      refine ⟨ObjectProperty.homMk
        { app := fun V => AddCommGrpCat.ofHom ((φ V.unop).codRestrict (DSub V.unop) (hsupp V.unop))
          naturality := fun V W f => by
            ext g x
            change (φ W.unop (F.obj.map f g)) x =
              ((resH V.unop W.unop ((φ V.unop).codRestrict (DSub V.unop) (hsupp V.unop) g) :
                DSub W.unop) : T →₀ ℤ) x
            rw [resH_apply]
            split_ifs with hx
            · exact hcompat V.unop W.unop (leOfHom f.unop) g x hx
            · by_contra hne
              exact hx (hsupp _ _ x hne).1 }, ?_⟩
      intro V g
      rfl

  have sloc : ∀ (n : T →₀ ℤ), n η = 0 → ∀ x : T, ∃ W : TopologicalSpace.Opens T, x ∈ W ∧
      ∃ m : M, ∀ y ∈ W, ord y m = n y := by
    intro n hn x
    by_cases hx : n x = 0
    · have hZ : IsClosed (↑n.support : Set T) :=
        H3 _ (Finset.finite_toSet _) (by simpa using hn)
      refine ⟨⟨(↑n.support : Set T)ᶜ, hZ.isOpen_compl⟩,
        (show x ∉ (↑n.support : Set T) by simpa using hx), 0, ?_⟩
      intro y hy
      have hy' : y ∉ (↑n.support : Set T) := hy
      have : n y = 0 := by simpa using hy'
      rw [map_zero, this]
    · have hxη : x ≠ η := fun h => hx (h ▸ hn)
      obtain ⟨m₁, hm₁⟩ := H6 x hxη
      have hordx : ord x (n x • m₁) = n x := by rw [map_zsmul, hm₁, smul_eq_mul, mul_one]
      let Z : Set T := ((↑n.support : Set T) ∪ {y | ord y (n x • m₁) ≠ 0}) \ {x}
      have hZfin : Z.Finite :=
        ((Finset.finite_toSet _).union (H5 (n x • m₁))).subset Set.diff_subset
      have hηZ : η ∉ Z := by
        rintro ⟨h1 | h1, _⟩
        · exact (Finsupp.mem_support_iff.mp h1) hn
        · exact h1 (H4 _)
      have hZ : IsClosed Z := H3 Z hZfin hηZ
      refine ⟨⟨Zᶜ, hZ.isOpen_compl⟩, fun h => h.2 (Set.mem_singleton x), n x • m₁, ?_⟩
      intro y hy
      by_cases hyx : y = x
      · rw [hyx, hordx]
      · have hyZ : y ∉ Z := hy
        have h1 : y ∉ (↑n.support : Set T) := fun h => hyZ ⟨Or.inl h, hyx⟩
        have h2 : ¬ ord y (n x • m₁) ≠ 0 := fun h => hyZ ⟨Or.inr h, hyx⟩
        rw [not_not.mp h2, Finsupp.notMem_support_iff.mp (by simpa using h1)]

  obtain ⟨K, eK', hKsub, hKres, hKuniv⟩ := sky
  obtain ⟨D, eD', hDinj, hDimg, hDres, hDuniv⟩ := divs
  have Dsupp : ∀ (V : TopologicalSpace.Opens T) (s : D.obj.obj (Opposite.op V)) (x : T),
      eD' V s x ≠ 0 → x ∈ V ∧ x ≠ η := fun V s => (hDimg V _).mp ⟨s, rfl⟩
  let dv : M →+ (T →₀ ℤ) :=
    { toFun := fun m => Finsupp.ofSupportFinite (fun x => ord x m) (H5 m)
      map_zero' := by ext x; exact map_zero (ord x)
      map_add' := fun a b => by ext x; exact map_add (ord x) a b }
  have dv_apply : ∀ m x, dv m x = ord x m := fun m x => rfl
  obtain ⟨i, hi⟩ := hKuniv G ι (fun V W hWV hW g => H7 V W hWV ⟨η, hW⟩ g)
  let φ : ∀ V : TopologicalSpace.Opens T, K.obj.obj (Opposite.op V) →+ (T →₀ ℤ) := fun V =>
    if h : η ∈ V then (Finsupp.filterAddHom (· ∈ V)).comp (dv.comp (eK' V h).toAddMonoidHom)
    else 0
  have φ_pos : ∀ (V : TopologicalSpace.Opens T) (h : η ∈ V) (s : K.obj.obj (Opposite.op V))
      (x : T), φ V s x = if x ∈ V then ord x (eK' V h s) else 0 := by
    intro V h s x
    simp only [φ, dif_pos h]
    change (Finsupp.filter (· ∈ V) (dv (eK' V h s))) x = _
    rw [Finsupp.filter_apply, dv_apply]
  have φ_neg : ∀ (V : TopologicalSpace.Opens T), η ∉ V → ∀ s, φ V s = 0 := by
    intro V h s
    simp only [φ, dif_neg h]
    rfl
  have φsupp : ∀ (V : TopologicalSpace.Opens T) (s : K.obj.obj (Opposite.op V)) (x : T),
      φ V s x ≠ 0 → x ∈ V ∧ x ≠ η := by
    intro V s x hx
    by_cases h : η ∈ V
    · rw [φ_pos V h] at hx
      split_ifs at hx with hxV
      · refine ⟨hxV, fun hxe => hx ?_⟩
        rw [hxe]
        exact H4 _
      · exact absurd rfl hx
    · rw [φ_neg V h] at hx
      simp at hx
  have φcompat : ∀ (V W : TopologicalSpace.Opens T) (hWV : W ≤ V)
      (s : K.obj.obj (Opposite.op V)) (x : T),
      x ∈ W → φ W (K.obj.map (homOfLE hWV).op s) x = φ V s x := by
    intro V W hWV s x hx
    have hW : η ∈ W := H1 W ⟨x, hx⟩
    rw [φ_pos W hW, φ_pos V (hWV hW), if_pos hx, if_pos (hWV hx), hKres]
  obtain ⟨d, hd⟩ := hDuniv K φ φsupp φcompat
  have hid : i ≫ d = 0 := by
    apply Sheaf.hom_ext
    ext V g
    obtain ⟨V⟩ := V
    change d.hom.app (Opposite.op V) (i.hom.app (Opposite.op V) g) = 0
    apply hDinj V
    rw [map_zero, hd]
    ext x
    rw [Finsupp.zero_apply]
    by_cases h : η ∈ V
    · rw [φ_pos V h, hi V h]
      split_ifs with hxV
      · exact (H9 V ⟨η, h⟩ (ι V g)).mp ⟨g, rfl⟩ x hxV
      · rfl
    · rw [φ_neg V h]
      rfl
  have hinj : ∀ (V : TopologicalSpace.Opens T) (a : G.obj.obj (Opposite.op V)),
      i.hom.app (Opposite.op V) a = 0 → a = 0 := by
    intro V a ha
    by_cases h : η ∈ V
    · apply H8 V ⟨η, h⟩
      rw [map_zero, ← hi V h, ha, map_zero]
    · have hV : V = ⊥ := by
        rw [eq_bot_iff]
        intro x hx
        exact absurd (H1 V ⟨x, hx⟩) h
      subst hV
      have := AddCommGrpCat.isZero_iff_subsingleton.mp
        (TopCat.Sheaf.isTerminalOfEqEmpty (X := TopCat.of T) G (U := ⊥) rfl).isZero
      exact Subsingleton.elim _ _
  have hmid : ∀ (V : TopologicalSpace.Opens T) (b : K.obj.obj (Opposite.op V)),
      d.hom.app (Opposite.op V) b = 0 → ∃ a, i.hom.app (Opposite.op V) a = b := by
    intro V b hb
    by_cases h : η ∈ V
    · have e1 : φ V b = 0 := by rw [← hd V b, hb, map_zero]
      have h0 : ∀ x ∈ V, ord x (eK' V h b) = 0 := by
        intro x hx
        have := DFunLike.congr_fun e1 x
        rw [φ_pos V h, if_pos hx, Finsupp.zero_apply] at this
        exact this
      obtain ⟨g, hg⟩ := (H9 V ⟨η, h⟩ _).mpr h0
      refine ⟨g, (eK' V h).injective ?_⟩
      rw [hi V h, hg]
    · have := hKsub V h
      exact ⟨0, Subsingleton.elim _ _⟩
  have hloc : ∀ (V : TopologicalSpace.Opens T) (q : D.obj.obj (Opposite.op V)),
      Presheaf.imageSieve d.hom q ∈ Opens.grothendieckTopology T V := by
    intro V q x hxV
    have hnη : eD' V q η = 0 := by
      by_contra hne
      exact (Dsupp V q η hne).2 rfl
    obtain ⟨W, hxW, m, hm⟩ := sloc (eD' V q) hnη x
    have hη : η ∈ W ⊓ V := H1 _ ⟨x, ⟨hxW, hxV⟩⟩
    refine ⟨W ⊓ V, homOfLE inf_le_right, ?_, ⟨hxW, hxV⟩⟩
    rw [Presheaf.imageSieve_apply]
    refine ⟨(eK' (W ⊓ V) hη).symm m, ?_⟩
    apply hDinj (W ⊓ V)
    rw [hd]
    ext y
    rw [φ_pos _ hη, AddEquiv.apply_symm_apply]
    split_ifs with hy
    · rw [hDres V (W ⊓ V) inf_le_right q y hy, hm y hy.1]
    · by_contra hne
      exact hy (Dsupp _ _ y (Ne.symm hne)).1

  have ses : (ShortComplex.mk i d hid).ShortExact := by
    have hmono : Mono i := by
      have : Sheaf.IsLocallyInjective i := (Sheaf.isLocallyInjective_iff_injective i).mpr
        (fun X => (injective_iff_map_eq_zero _).mpr (fun a ha => hinj X.unop a ha))
      exact Sheaf.mono_of_isLocallyInjective i
    have hepi : Epi d := by
      have : Sheaf.IsLocallySurjective d :=
        Presheaf.IsLocallySurjective.mk (fun {U} q => hloc U q)
      exact Sheaf.epi_of_isLocallySurjective d
    have hι : ∀ X, Function.Injective ((Limits.kernel.ι d).hom.app X) := fun X => by
      have h1 : Mono ((sheafToPresheaf (Opens.grothendieckTopology T) AddCommGrpCat.{u}).map
          (Limits.kernel.ι d)) :=
        Functor.map_mono (sheafToPresheaf (Opens.grothendieckTopology T) AddCommGrpCat.{u})
          (Limits.kernel.ι d)
      exact (AddCommGrpCat.mono_iff_injective _).mp ((NatTrans.mono_iff_mono_app _).mp h1 X)
    have hk : Epi (Limits.kernel.lift d i hid) := by
      have : Sheaf.IsLocallySurjective (Limits.kernel.lift d i hid) :=
        Presheaf.isLocallySurjective_of_surjective (Opens.grothendieckTopology T) _ (fun X s => by
          have hb : d.hom.app X ((Limits.kernel.ι d).hom.app X s) = 0 := by
            have h := congrArg (fun ψ => (ψ.hom.app X) s) (Limits.kernel.condition d)
            exact h
          obtain ⟨a, ha⟩ := hmid X.unop _ hb
          refine ⟨a, hι X ?_⟩
          have h := congrArg (fun ψ => (ψ.hom.app X) a) (Limits.kernel.lift_ι d i hid)
          exact h.trans ha)
      exact Sheaf.epi_of_isLocallySurjective _
    exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_epi_kernel_lift _).mpr hk)
      hmono hepi
  have hflas : ∀ (V W : TopologicalSpace.Opens T) (hWV : W ≤ V),
      Function.Surjective (K.obj.map (homOfLE hWV).op) := by
    intro V W hWV s'
    by_cases hW : η ∈ W
    · refine ⟨(eK' V (hWV hW)).symm (eK' W hW s'), (eK' W hW).injective ?_⟩
      rw [hKres, AddEquiv.apply_symm_apply]
    · have := hKsub W hW
      exact ⟨0, Subsingleton.elim _ _⟩
  have hηtop : η ∈ (⊤ : TopologicalSpace.Opens T) := by simp
  refine ⟨K, D, i, d, hid, ses, hflas, eK' ⊤ hηtop, eD' ⊤, hDinj ⊤, ?_, ?_, ?_⟩
  · intro n hn
    exact (hDimg ⊤ n).mpr (fun x hx => ⟨by simp, fun h => hx (h ▸ hn)⟩)
  · intro w
    by_contra h
    exact (Dsupp ⊤ w η h).2 rfl
  · intro s x
    rw [hd, φ_pos ⊤ hηtop, if_pos (by simp)]

theorem wc_zar_divisor_ses : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)], IsAffineOpen U → ((U : Set X)ᶜ).Finite →
    letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _
    ∃ (K D : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) (i : wcZarGm X ⟶ K)
      (d : K ⟶ D) (h : i ≫ d = 0), (ShortComplex.mk i d h).ShortExact ∧
      (∀ (V W : X.Opens) (hWV : W ≤ V), Function.Surjective (K.obj.map (homOfLE hWV).op)) ∧
      ∃ π : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) D 0 →+
          (IsDedekindDomain.HeightOneSpectrum Γ(X, U) →₀ ℤ),
        Function.Surjective π ∧
        (∃ T : Finset (Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
            AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) D 0),
          (∀ t ∈ T, π t = 0) ∧ ∀ y, π y = 0 → y ∈ AddSubgroup.closure (T : Set _)) ∧
        (∀ z : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
            (AddCommGrpCat.of (ULift.{u} ℤ))) K 0, ∃ f : (FractionRing Γ(X, U))ˣ,
          ∀ v, π (z.comp (Abelian.Ext.mk₀ d) (add_zero 0)) v =
            FractionalIdeal.count (FractionRing Γ(X, U)) v
              (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U)))) ∧
        (∀ f : (FractionRing Γ(X, U))ˣ, ∃ z : Abelian.Ext ((constantSheaf
            (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) K 0,
          ∀ v, π (z.comp (Abelian.Ext.mk₀ d) (add_zero 0)) v =
            FractionalIdeal.count (FractionRing Γ(X, U)) v
              (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U)))) :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim U _ hU hfin
  classical
  letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _

  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X

  obtain ⟨hcl, hcpt⟩ := wc_curve_points_closed_opens_compact Ω X fX hdim
  have hpt1 : ∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X) := fun y hy =>
    hcl {y} (Set.finite_singleton y) (fun h => hy (Set.mem_singleton_iff.mp h).symm)
  have hDVR := wc_curve_stalk_dvr Ω X fX (fun x => (hnorm x).2) hpt1
  have hP5 := wc_dedekind_affine_points X U hU
  obtain ⟨ord, ι, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_curve_ord_units_data X hDVR (wc_integral_hartogs_sections X) dvr_count_spanSingleton
      dedekind_count_localization U hU hfin hP5

  obtain ⟨φ, hφ⟩ := wc_zarGm_sections_units X
  let ι' : ∀ V : X.Opens, (wcZarGm X).obj.obj (Opposite.op V) →+
      Additive (FractionRing Γ(X, U))ˣ := fun V => (ι V).comp (φ V).toAddMonoidHom
  have H1 : ∀ V : X.Opens, (V : Set X).Nonempty → genericPoint X ∈ V := fun V hV =>
    ((genericPoint_spec X).mem_open_set_iff V.isOpen).mpr (by rwa [Set.univ_inter])
  have H7 : ∀ (V W : X.Opens) (hWV : W ≤ V), (W : Set X).Nonempty →
      ∀ g, ι' W ((wcZarGm X).obj.map (homOfLE hWV).op g) = ι' V g := by
    intro V W hWV hW g
    show ι W (φ W ((wcZarGm X).obj.map (homOfLE hWV).op g)) = ι V (φ V g)
    rw [hφ V W hWV g, h4 V W hWV hW]
    rfl
  have H8 : ∀ V : X.Opens, (V : Set X).Nonempty → Function.Injective (ι' V) :=
    fun V hV => (h5 V hV).comp (φ V).injective
  have H9 : ∀ V : X.Opens, (V : Set X).Nonempty →
      ∀ m, (∃ g, ι' V g = m) ↔ ∀ x ∈ V, ord x m = 0 := by
    intro V hV m
    rw [← h6 V hV m]
    constructor
    · rintro ⟨g, hg⟩
      exact ⟨φ V g, hg⟩
    · rintro ⟨g', hg'⟩
      refine ⟨(φ V).symm g', ?_⟩
      show ι V (φ V ((φ V).symm g')) = m
      rw [AddEquiv.apply_symm_apply]
      exact hg'

  obtain ⟨K, D, i, d, h, hSES, hflas, eK, eD, heDinj, heDsurj, heDη, hdiv⟩ :=
    wc_abstract_divisor_ses X (genericPoint X) (Additive (FractionRing Γ(X, U))ˣ) ord
      (wcZarGm X) ι' H1 hcpt hcl h1 h2 h3 H7 H8 H9

  let hT : Limits.IsTerminal (⊤ : X.Opens) := Limits.IsTerminal.ofUnique _
  let eD' := eD.comp (Sheaf.H.equiv₀ D hT).toAddMonoidHom
  have heD'inj : Function.Injective eD' := heDinj.comp (Sheaf.H.equiv₀ D hT).injective
  have heD'surj : ∀ n : X →₀ ℤ, n (genericPoint X) = 0 → ∃ w, eD' w = n := by
    intro n hn
    obtain ⟨w0, hw0⟩ := heDsurj n hn
    refine ⟨(Sheaf.H.equiv₀ D hT).symm w0, ?_⟩
    show eD (Sheaf.H.equiv₀ D hT ((Sheaf.H.equiv₀ D hT).symm w0)) = n
    rw [AddEquiv.apply_symm_apply]
    exact hw0
  have heD'η : ∀ w, eD' w (genericPoint X) = 0 := fun w => heDη _

  let pt : IsDedekindDomain.HeightOneSpectrum Γ(X, U) → X :=
    fun v => (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X)
  have hpt : Function.Injective pt := hP5.2.1
  have hptη : ∀ v, pt v ≠ genericPoint X := fun v => (hP5.2.2.1 v).2
  let π := (Finsupp.comapDomain.addMonoidHom hpt).comp eD'
  have hπ : ∀ w v, π w v = eD' w (pt v) := fun w v => rfl
  have hπs : Function.Surjective π := by
    intro n'
    have hn : (Finsupp.mapDomain pt n') (genericPoint X) = 0 :=
      Finsupp.mapDomain_of_notMem_range n' _ (fun ⟨v, hv⟩ => hptη v hv)
    obtain ⟨w, hw⟩ := heD'surj _ hn
    refine ⟨w, Finsupp.ext fun v => ?_⟩
    rw [hπ, hw]
    exact Finsupp.mapDomain_apply_of_injective hpt n' v
  let S : Set X := {y | y ≠ genericPoint X ∧ y ∉ Set.range pt}
  have hS : S.Finite := by
    refine hfin.subset (fun y hy hyU => ?_)
    obtain ⟨v, hv⟩ := hP5.2.2.2 y hyU hy.1
    exact hy.2 ⟨v, hv⟩
  have hgen : ∀ y : X, ∃ w, y ≠ genericPoint X → eD' w = Finsupp.single y 1 := by
    intro y
    by_cases hy : y = genericPoint X
    · exact ⟨0, fun h' => absurd hy h'⟩
    · obtain ⟨w, hw⟩ := heD'surj (Finsupp.single y 1) (by simp [Finsupp.single_apply, hy])
      exact ⟨w, fun _ => hw⟩
  choose g hg using hgen
  let Tk := hS.toFinset.image g
  have hT0 : ∀ t ∈ Tk, π t = 0 := by
    intro t ht
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp ht
    have hy' : y ∈ S := hS.mem_toFinset.mp hy
    refine Finsupp.ext fun v => ?_
    have hne : y ≠ pt v := fun e => hy'.2 ⟨v, e.symm⟩
    rw [Finsupp.zero_apply, hπ, hg y hy'.1, Finsupp.single_apply, if_neg hne]
  have hTk : ∀ y0, π y0 = 0 → y0 ∈ AddSubgroup.closure (Tk : Set _) := by
    intro y0 hy0
    have hmemS : ∀ x ∈ (eD' y0).support, x ∈ S := by
      intro x hx
      have hx' : eD' y0 x ≠ 0 := Finsupp.mem_support_iff.mp hx
      refine ⟨fun e => hx' (e ▸ heD'η y0), ?_⟩
      rintro ⟨v, rfl⟩
      apply hx'
      rw [← hπ, hy0, Finsupp.zero_apply]
    have key : eD' (∑ x ∈ (eD' y0).support, (eD' y0) x • g x) = eD' y0 := by
      have e := Finsupp.sum_single (eD' y0)
      rw [Finsupp.sum] at e
      rw [map_sum]
      refine (Finset.sum_congr rfl (fun x hx => ?_)).trans e
      rw [map_zsmul, hg x (hmemS x hx).1, Finsupp.smul_single_one]
    rw [← heD'inj key]
    refine AddSubgroup.sum_mem _ (fun x hx => AddSubgroup.zsmul_mem _
      (AddSubgroup.subset_closure ?_) _)
    exact Finset.mem_coe.mpr (Finset.mem_image_of_mem g (hS.mem_toFinset.mpr (hmemS x hx)))

  have hchain : ∀ z v, π (z.comp (Abelian.Ext.mk₀ d) (add_zero 0)) v =
      ord (pt v) (eK (Sheaf.H.equiv₀ K hT z)) := by
    intro z v
    rw [hπ]
    show eD (Sheaf.H.equiv₀ D hT (Sheaf.H.map d 0 z)) (pt v) = _
    rw [← Sheaf.H.equiv₀_naturality hT d z, hdiv]
  refine ⟨K, D, i, d, h, hSES, hflas, π, hπs, ⟨Tk, hT0, hTk⟩, ?_, ?_⟩
  · intro z
    refine ⟨Additive.toMul (eK (Sheaf.H.equiv₀ K hT z)), fun v => ?_⟩
    rw [hchain z v]
    exact h7 v _
  · intro f
    refine ⟨(Sheaf.H.equiv₀ K hT).symm (eK.symm (Additive.ofMul f)), fun v => ?_⟩
    rw [hchain, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    exact h7 v f

theorem dedekind_classGroup_divisor_presentation : ∀ (A : Type u) [CommRing A] [IsDedekindDomain A],
    ∃ ψ₀ : (IsDedekindDomain.HeightOneSpectrum A →₀ ℤ) →+ Additive (ClassGroup A),
      Function.Surjective ψ₀ ∧ ∀ n, ψ₀ n = 0 ↔ ∃ f : (FractionRing A)ˣ, ∀ v, n v =
        FractionalIdeal.count (FractionRing A) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors A) (f : FractionRing A)) :=
by
  intro A _ _
  classical
  let K := FractionRing A
  have hv : ∀ v : IsDedekindDomain.HeightOneSpectrum A,
      ((v.asIdeal : FractionalIdeal (nonZeroDivisors A) K)) ≠ 0 :=
    fun v => FractionalIdeal.coeIdeal_ne_zero.mpr v.ne_bot
  let u : IsDedekindDomain.HeightOneSpectrum A → (FractionalIdeal (nonZeroDivisors A) K)ˣ :=
    fun v => Units.mk0 _ (hv v)
  have hu : ∀ v, ((u v : (FractionalIdeal (nonZeroDivisors A) K)ˣ) :
      FractionalIdeal (nonZeroDivisors A) K) = (v.asIdeal : FractionalIdeal (nonZeroDivisors A) K) :=
    fun v => Units.val_mk0 _
  let φ : (IsDedekindDomain.HeightOneSpectrum A →₀ ℤ) →+
      Additive (FractionalIdeal (nonZeroDivisors A) K)ˣ :=
    Finsupp.liftAddHom (fun v => zmultiplesHom (Additive (FractionalIdeal (nonZeroDivisors A) K)ˣ)
      (Additive.ofMul (u v)))
  let Φ : (IsDedekindDomain.HeightOneSpectrum A →₀ ℤ) → (FractionalIdeal (nonZeroDivisors A) K)ˣ :=
    fun n => Additive.toMul (φ n)
  have hΦadd : ∀ f g, Φ (f + g) = Φ f * Φ g := fun f g => by
    simp only [Φ, map_add, toMul_add]
  have hΦzero : Φ 0 = 1 := by simp only [Φ, map_zero, toMul_zero]
  have hΦsingle : ∀ a b, Φ (Finsupp.single a b) = u a ^ b := fun a b => by
    simp only [Φ, φ, Finsupp.liftAddHom_apply_single, zmultiplesHom_apply, toMul_zsmul, toMul_ofMul]
  have hcount : ∀ n v, FractionalIdeal.count K v
      ((Φ n : (FractionalIdeal (nonZeroDivisors A) K)ˣ) : FractionalIdeal (nonZeroDivisors A) K)
        = n v := by
    intro n v
    induction n using Finsupp.induction_linear with
    | zero => rw [hΦzero, Units.val_one, FractionalIdeal.count_one, Finsupp.zero_apply]
    | add f g hf hg =>
      rw [hΦadd, Units.val_mul, FractionalIdeal.count_mul K v (Units.ne_zero _) (Units.ne_zero _),
        hf, hg, Finsupp.add_apply]
    | single a b =>
      rw [hΦsingle, Units.val_zpow_eq_zpow_val, hu, FractionalIdeal.count_zpow]
      by_cases h : a = v
      · subst h
        rw [FractionalIdeal.count_self, Finsupp.single_eq_same, mul_one]
      · rw [FractionalIdeal.count_maximal_coprime K v h, Finsupp.single_eq_of_ne (Ne.symm h),
          mul_zero]
  have huniq : ∀ I J : (FractionalIdeal (nonZeroDivisors A) K)ˣ,
      (∀ v, FractionalIdeal.count K v (I : FractionalIdeal (nonZeroDivisors A) K) =
        FractionalIdeal.count K v (J : FractionalIdeal (nonZeroDivisors A) K)) → I = J := by
    intro I J h
    apply Units.ext
    have e1 := FractionalIdeal.finprod_heightOneSpectrum_factorization' K (Units.ne_zero I)
    have e2 := FractionalIdeal.finprod_heightOneSpectrum_factorization' K (Units.ne_zero J)
    rw [← e1, ← e2]
    exact finprod_congr (fun v => by rw [h v])
  refine ⟨(MonoidHom.toAdditive (ClassGroup.mk K)).comp φ, ?_, ?_⟩
  · intro c
    obtain ⟨I, hI⟩ : ∃ I, ClassGroup.mk K I = Additive.toMul c :=
      ClassGroup.induction K (P := fun x => ∃ I, ClassGroup.mk K I = x) (fun I => ⟨I, rfl⟩) _
    have hfin : (Function.support fun v => FractionalIdeal.count K v
        (I : FractionalIdeal (nonZeroDivisors A) K)).Finite :=
      by
        have h := FractionalIdeal.finite_factors (R := A) (K := K)
          (I : FractionalIdeal (nonZeroDivisors A) K)
        exact Filter.eventually_cofinite.mp h
    let nI := Finsupp.ofSupportFinite _ hfin
    have hnI : Φ nI = I := huniq _ _ (fun v => by
      rw [hcount]
      rfl)
    refine ⟨nI, ?_⟩
    change Additive.ofMul (ClassGroup.mk K (Φ nI)) = c
    rw [hnI, hI, ofMul_toMul]
  · intro n
    have hψ : ((MonoidHom.toAdditive (ClassGroup.mk K)).comp φ) n =
        Additive.ofMul (ClassGroup.mk K (Φ n)) := rfl
    rw [hψ, ofMul_eq_zero, ClassGroup.mk_eq_one_iff, FractionalIdeal.isPrincipal_iff]
    constructor
    · rintro ⟨x, hx⟩
      have hx0 : x ≠ 0 := by
        rintro rfl
        exact Units.ne_zero (Φ n) (by rw [hx, FractionalIdeal.spanSingleton_zero])
      refine ⟨Units.mk0 x hx0, fun v => ?_⟩
      rw [Units.val_mk0, ← hx, hcount]
    · rintro ⟨f, hf⟩
      refine ⟨(f : K), ?_⟩
      have := huniq (Φ n) (toPrincipalIdeal A K f)
        (fun v => by rw [hcount, hf v, coe_toPrincipalIdeal])
      rw [this, coe_toPrincipalIdeal]

theorem wc_curve_ord_data_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∃ ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ord :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin
  classical

  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  have hclosed : ∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X) := fun y hy =>
    (wc_curve_points_closed_opens_compact Ω X fX hdim).1 {y} (Set.finite_singleton y)
      (fun h => hy (Set.mem_singleton_iff.mp h).symm)
  have hDVR : ∀ x : X, x ≠ genericPoint X → IsDiscreteValuationRing (X.presheaf.stalk x) :=
    wc_curve_stalk_dvr Ω X fX (fun x => (hnorm x).2) hclosed
  have hP5 := wc_dedekind_affine_points X U hU
  haveI : Nonempty U := ⟨⟨genericPoint X, hP5.1⟩⟩
  obtain ⟨x₀⟩ : Nonempty X := IrreducibleSpace.toNonempty
  haveI : Nonempty (⊤ : X.Opens) := ⟨⟨x₀, trivial⟩⟩
  letI : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  let α := FractionRing.algEquiv Γ(X, U) X.functionField
  let E : Additive (FractionRing Γ(X, U))ˣ ≃+ Additive (X.functionField)ˣ :=
    MulEquiv.toAdditive (Units.mapEquiv α.toMulEquiv)

  have pkg : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
      (w : IsDedekindDomain.HeightOneSpectrum R), ∃ o : Additive Kˣ →+ ℤ,
      (∀ f : Kˣ, o (Additive.ofMul f) =
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K))) ∧
      (∃ f : Kˣ, o (Additive.ofMul f) = 1) ∧
      (∀ f : Kˣ, 0 ≤ o (Additive.ofMul f) ↔ ∃ r : R, algebraMap R K r = (f : K)) ∧
      (∀ f g h : Kˣ, (h : K) = (f : K) + (g : K) →
        min (o (Additive.ofMul f)) (o (Additive.ofMul g)) ≤ o (Additive.ofMul h)) := by
    intro R _ _ _ K _ _ _ w
    have hc_mul : ∀ f g : Kˣ,
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R)
          ((Additive.toMul (Additive.ofMul f + Additive.ofMul g) : Kˣ) : K)) =
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K)) +
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (g : K)) := by
      intro f g
      rw [toMul_add, toMul_ofMul, toMul_ofMul, Units.val_mul,
        ← FractionalIdeal.spanSingleton_mul_spanSingleton]
      exact FractionalIdeal.count_mul K w
        (FractionalIdeal.spanSingleton_ne_zero_iff.mpr f.ne_zero)
        (FractionalIdeal.spanSingleton_ne_zero_iff.mpr g.ne_zero)
    let o : Additive Kˣ →+ ℤ := AddMonoidHom.mk' (fun m => FractionalIdeal.count K w
      (FractionalIdeal.spanSingleton (nonZeroDivisors R) ((Additive.toMul m : Kˣ) : K)))
      (fun a b => hc_mul (Additive.toMul a) (Additive.toMul b))
    have ho : ∀ f : Kˣ, o (Additive.ofMul f) =
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K)) :=
      fun f => rfl
    have hint : ∀ f : Kˣ, 0 ≤ o (Additive.ofMul f) ↔ ∃ r : R, algebraMap R K r = (f : K) := by
      intro f
      rw [ho]
      exact (dvr_count_spanSingleton R K w (f : K) f.ne_zero).1.symm
    have hmul : ∀ f g : Kˣ,
        o (Additive.ofMul (f * g)) = o (Additive.ofMul f) + o (Additive.ofMul g) := by
      intro f g
      rw [ofMul_mul, map_add]
    have hinv : ∀ f : Kˣ, o (Additive.ofMul f⁻¹) = - o (Additive.ofMul f) := by
      intro f
      rw [ofMul_inv, map_neg]
    have key : ∀ f g h : Kˣ, (h : K) = (f : K) + (g : K) →
        o (Additive.ofMul f) ≤ o (Additive.ofMul g) →
        o (Additive.ofMul f) ≤ o (Additive.ofMul h) := by
      intro f g h hh hle
      have h1 : 0 ≤ o (Additive.ofMul (g * f⁻¹)) := by
        rw [hmul, hinv]; omega
      obtain ⟨r, hr⟩ := (hint _).mp h1
      have h2 : ∃ r : R, algebraMap R K r = ((h * f⁻¹ : Kˣ) : K) := by
        refine ⟨1 + r, ?_⟩
        rw [map_add, map_one, hr]
        simp only [Units.val_mul, hh, add_mul, Units.mul_inv]
      have h3 := (hint _).mpr h2
      rw [hmul, hinv] at h3
      omega
    refine ⟨o, ho, ?_, hint, ?_⟩
    · obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
      have h0 : algebraMap R K ϖ ≠ 0 := by
        intro h
        apply hϖ.ne_zero
        apply IsFractionRing.injective R K
        rw [h, map_zero]
      exact ⟨Units.mk0 _ h0, (dvr_count_spanSingleton R K w _ h0).2 ϖ hϖ⟩
    · intro f g h hh
      rcases le_total (o (Additive.ofMul f)) (o (Additive.ofMul g)) with hle | hle
      · exact (min_le_left _ _).trans (key f g h hh hle)
      · exact (min_le_right _ _).trans (key g f h (by rw [hh, add_comm]) hle)

  haveI hdom : IsDomain Γ(X, ⊤) :=
    @IsIntegral.component_integral X _ ⊤ ⟨⟨x₀, trivial⟩⟩
  let φ : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
  have hφint : φ.IsIntegral := by
    refine RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ ?_)
      (isIntegral_appTop_of_universallyClosed fX)
    intro y
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y, ?_⟩
    change ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom y = y
    rw [Iso.hom_inv_id]
    rfl
  have hsurj : Function.Surjective φ := by
    letI : Algebra Ω Γ(X, ⊤) := φ.toAlgebra
    intro s
    have hs : _root_.IsIntegral Ω s := hφint s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
    exact ⟨c, hc⟩

  have s3 : ∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U))
      [IsDedekindDomain (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩))]
      (w : IsDedekindDomain.HeightOneSpectrum
        (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)))
      (f : FractionRing Γ(X, U)), f ≠ 0 →
      FractionalIdeal.count X.functionField w
          (FractionalIdeal.spanSingleton
            (nonZeroDivisors (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)))
            (FractionRing.algEquiv Γ(X, U) X.functionField f)) =
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) f) := by
    intro v _ w f hf
    have hxU : (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) ∈ U := (hP5.2.2.1 v).1
    let xU : U := ⟨_, hxU⟩
    have hp : hU.primeIdealOf xU = ⟨v.asIdeal, v.isPrime⟩ := by
      apply hU.fromSpec.injective
      rw [hU.fromSpec_primeIdealOf xU]
    letI : Algebra Γ(X, U) (X.presheaf.stalk (xU : X)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf xU
    haveI : IsLocalization.AtPrime (X.presheaf.stalk (xU : X)) v.asIdeal := by
      have := hU.isLocalization_stalk xU
      rw [hp] at this
      exact this
    haveI : IsScalarTower Γ(X, U) (X.presheaf.stalk (xU : X)) X.functionField :=
      functionField_isScalarTower X U xU
    exact dedekind_count_localization Γ(X, U) v (X.presheaf.stalk (xU : X)) X.functionField w f hf
  have hloc : ∀ x : X, (hx : x ≠ genericPoint X) → ∃ o : Additive (X.functionField)ˣ →+ ℤ,
      (∃ f : (X.functionField)ˣ, o (Additive.ofMul f) = 1) ∧
      (∀ f : (X.functionField)ˣ, 0 ≤ o (Additive.ofMul f) ↔
        ∃ r : X.presheaf.stalk x, algebraMap _ X.functionField r = (f : X.functionField)) ∧
      (∀ f g h : (X.functionField)ˣ,
        (h : X.functionField) = (f : X.functionField) + (g : X.functionField) →
        min (o (Additive.ofMul f)) (o (Additive.ofMul g)) ≤ o (Additive.ofMul h)) ∧
      (haveI := hDVR x hx
       ∃ w : IsDedekindDomain.HeightOneSpectrum (X.presheaf.stalk x),
        ∀ f : (X.functionField)ˣ, o (Additive.ofMul f) =
          FractionalIdeal.count X.functionField w
            (FractionalIdeal.spanSingleton (nonZeroDivisors (X.presheaf.stalk x))
              (f : X.functionField))) := by
    intro x hx
    haveI := hDVR x hx
    let w : IsDedekindDomain.HeightOneSpectrum (X.presheaf.stalk x) :=
      ⟨IsLocalRing.maximalIdeal _, (IsLocalRing.maximalIdeal.isMaximal _).isPrime,
        IsDiscreteValuationRing.not_a_field _⟩
    obtain ⟨o, h1, h2, h3, h4⟩ := pkg (X.presheaf.stalk x) X.functionField w
    exact ⟨o, h2, h3, h4, w, h1⟩
  choose o ho using hloc
  let ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ := fun x =>
    if hx : x = genericPoint X then 0 else (o x hx).comp E.toAddMonoidHom
  have hord : ∀ x (hx : x ≠ genericPoint X) m, ord x m = o x hx (E m) := by
    intro x hx m
    show (if h : x = genericPoint X then 0 else (o x h).comp E.toAddMonoidHom) m = _
    rw [dif_neg hx]
    rfl
  have P1 : ∀ m, ord (genericPoint X) m = 0 := by
    intro m
    show (if h : genericPoint X = genericPoint X then 0
      else (o (genericPoint X) h).comp E.toAddMonoidHom) m = 0
    rw [dif_pos rfl]
    rfl
  have P7 : ∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U)) (f : (FractionRing Γ(X, U))ˣ),
      ord (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩) (Additive.ofMul f) =
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U))) := by
    intro v f
    have hx := (hP5.2.2.1 v).2
    rw [hord _ hx]
    haveI := hDVR _ hx
    obtain ⟨w, hw⟩ := (ho _ hx).2.2.2
    rw [show E (Additive.ofMul f) = Additive.ofMul (Additive.toMul (E (Additive.ofMul f))) from rfl,
      hw]
    exact s3 v w (f : FractionRing Γ(X, U)) f.ne_zero
  have P2 : ∀ m, {x | ord x m ≠ 0}.Finite := by
    intro m
    have hfin2 : {v : IsDedekindDomain.HeightOneSpectrum Γ(X, U) |
        ¬ FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U))
            ((Additive.toMul m : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U))) = 0}.Finite :=
      Filter.eventually_cofinite.mp (FractionalIdeal.finite_factors _)
    refine (hfin.union (hfin2.image (fun v => (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X)))).subset ?_
    intro x hx
    simp only [Set.mem_setOf_eq] at hx
    by_cases hxU : x ∈ U
    · right
      have hxη : x ≠ genericPoint X := by
        rintro rfl
        exact hx (P1 m)
      obtain ⟨v, rfl⟩ := hP5.2.2.2 x hxU hxη
      refine ⟨v, ?_, rfl⟩
      simp only [Set.mem_setOf_eq]
      rw [← P7 v (Additive.toMul m)]
      exact hx
    · left
      exact hxU
  have P3 : ∀ x, x ≠ genericPoint X → ∃ m, ord x m = 1 := by
    intro x hx
    obtain ⟨f, hf⟩ := (ho x hx).1
    refine ⟨E.symm (Additive.ofMul f), ?_⟩
    rw [hord x hx, AddEquiv.apply_symm_apply]
    exact hf
  have P5 : ∀ (x : X) (f g h : (FractionRing Γ(X, U))ˣ),
      (h : FractionRing Γ(X, U)) = (f : FractionRing Γ(X, U)) + (g : FractionRing Γ(X, U)) →
      min (ord x (Additive.ofMul f)) (ord x (Additive.ofMul g)) ≤ ord x (Additive.ofMul h) := by
    intro x f g h hh
    by_cases hx : x = genericPoint X
    · subst hx
      rw [P1, P1, P1]
      exact min_le_left 0 0
    · rw [hord x hx, hord x hx, hord x hx]
      have := (ho x hx).2.2.1 (Additive.toMul (E (Additive.ofMul f)))
        (Additive.toMul (E (Additive.ofMul g))) (Additive.toMul (E (Additive.ofMul h))) (by
          show α (h : FractionRing Γ(X, U)) = α (f : FractionRing Γ(X, U)) + α (g : FractionRing Γ(X, U))
          rw [hh, map_add])
      simpa only [ofMul_toMul] using this

  have T1 : ∀ s : Γ(X, ⊤), α (algebraMap Γ(X, U) (FractionRing Γ(X, U))
      ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom s)) = (X.germToFunctionField ⊤).hom s := by
    intro s
    rw [AlgEquiv.commutes]
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE le_top) (genericPoint X) _ s
  have T2 : ∀ (x : X) (s : Γ(X, ⊤)), algebraMap (X.presheaf.stalk x) X.functionField
      ((X.presheaf.germ ⊤ x trivial).hom s) = (X.germToFunctionField ⊤).hom s :=
    fun x s => TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf
      (show x ∈ (⊤ : X.Opens) from trivial) _ s
  have P6 : ∀ f : (FractionRing Γ(X, U))ˣ, (∀ x, 0 ≤ ord x (Additive.ofMul f)) ↔
      ∃ c : Ω, algebraMap Γ(X, U) (FractionRing Γ(X, U))
        ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (φ c)) =
        (f : FractionRing Γ(X, U)) := by
    intro f
    have hloc6 : ∀ x (hx : x ≠ genericPoint X), 0 ≤ ord x (Additive.ofMul f) ↔
        ∃ t : X.presheaf.stalk x, algebraMap _ X.functionField t = α (f : FractionRing Γ(X, U)) := by
      intro x hx
      rw [hord x hx]
      exact (ho x hx).2.1 (Additive.toMul (E (Additive.ofMul f)))
    constructor
    · intro H
      obtain ⟨s, hs⟩ := wc_integral_hartogs_sections X ⊤ (α (f : FractionRing Γ(X, U))) (by
        intro x
        by_cases hx : (x : X) = genericPoint X
        · obtain ⟨x, hxV⟩ := x
          simp only at hx
          subst hx
          refine ⟨α (f : FractionRing Γ(X, U)), ?_⟩
          show (X.presheaf.stalkSpecializes _).hom _ = _
          rw [TopCat.Presheaf.stalkSpecializes_refl]
          rfl
        · exact (hloc6 (x : X) hx).mp (H x))
      obtain ⟨c, rfl⟩ := hsurj s
      refine ⟨c, α.injective ?_⟩
      rw [T1]
      exact hs
    · rintro ⟨c, hc⟩ x
      by_cases hx : x = genericPoint X
      · subst hx
        exact (P1 _).ge
      · rw [hloc6 x hx]
        refine ⟨(X.presheaf.germ ⊤ x trivial).hom (φ c), ?_⟩
        rw [T2, ← hc, T1]
  exact ⟨ord, P1, P7, P2, P3, P5, P6⟩

theorem wc_classGroup_ell_torsion_of_proper_reps : ∀ (X : Scheme.{u}) [IrreducibleSpace X]
    (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ℓ : ℕ, ℓ.Prime → ∀ (ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ),
    (∀ m, ord (genericPoint X) m = 0) →
    (∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U)) (f : (FractionRing Γ(X, U))ˣ),
      ord (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩) (Additive.ofMul f) =
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U)))) →
    ∀ T : Finset (X → ℤ),
    (∀ D : X → ℤ, (∃ f : (FractionRing Γ(X, U))ˣ, ∀ x, (ℓ : ℤ) * D x = ord x (Additive.ofMul f)) →
      ∃ t ∈ T, ∃ h : (FractionRing Γ(X, U))ˣ, ∀ x, D x = t x + ord x (Additive.ofMul h)) →
    Finite {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} :=
by
  intro X _ U _ hU hfin ℓ hℓ ord ho1 ho3 T hT
  classical
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  have hℓ0 : (ℓ : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hℓ.ne_zero
  haveI : Finite ↥((U : Set X)ᶜ) := hfin.to_subtype
  obtain ⟨ψ₀, hψs, hψk⟩ := dedekind_classGroup_divisor_presentation Γ(X, U)
  have hpts := (wc_dedekind_affine_points X U hU).2.2.2
  choose n hn using fun c : {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} => hψs (Additive.ofMul c.1)
  have hn0 : ∀ c : {c : ClassGroup Γ(X, U) // c ^ ℓ = 1}, ψ₀ (ℓ • n c) = 0 := by
    intro c
    rw [map_nsmul, hn c, ← ofMul_pow, c.2, ofMul_one]
  choose f hf using fun c : {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} => (hψk (ℓ • n c)).mp (hn0 c)
  have K1 : ∀ (c : {c : ClassGroup Γ(X, U) // c ^ ℓ = 1}) (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U)),
      ord (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩) (Additive.ofMul (f c)) = (ℓ : ℤ) * n c v := by
    intro c v
    rw [ho3, ← hf c v, Finsupp.smul_apply, nsmul_eq_mul]
  let r : {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} → (↥((U : Set X)ᶜ) → ZMod ℓ) :=
    fun c y => ((ord y.1 (Additive.ofMul (f c)) : ℤ) : ZMod ℓ)
  haveI : Nonempty {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} := ⟨⟨1, one_pow ℓ⟩⟩
  let σ := Function.invFun r
  have K2 : ∀ c, r (σ (r c)) = r c := fun c => Function.invFun_eq ⟨c, rfl⟩
  let F : {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} → (FractionRing Γ(X, U))ˣ :=
    fun c => f c / f (σ (r c))
  have K3 : ∀ c x, ord x (Additive.ofMul (F c)) =
      ord x (Additive.ofMul (f c)) - ord x (Additive.ofMul (f (σ (r c)))) := by
    intro c x
    simp only [F, ofMul_div, map_sub]
  have Dv : ∀ c x, (ℓ : ℤ) ∣ ord x (Additive.ofMul (F c)) := by
    intro c x
    by_cases hη : x = genericPoint X
    · rw [hη, ho1]; exact dvd_zero _
    by_cases hxU : x ∈ U
    · obtain ⟨v, rfl⟩ := hpts x hxU hη
      rw [K3, K1, K1, ← mul_sub]
      exact Dvd.intro _ rfl
    · have hy : x ∈ (U : Set X)ᶜ := hxU
      have h1 := congrFun (K2 c) ⟨x, hy⟩
      have h2 : ((ord x (Additive.ofMul (f (σ (r c)))) : ℤ) : ZMod ℓ) =
          ((ord x (Additive.ofMul (f c)) : ℤ) : ZMod ℓ) := h1
      rw [K3]
      exact (ZMod.intCast_eq_intCast_iff_dvd_sub _ _ _).mp h2
  let D : {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} → X → ℤ :=
    fun c x => ord x (Additive.ofMul (F c)) / (ℓ : ℤ)
  have K4 : ∀ c x, (ℓ : ℤ) * D c x = ord x (Additive.ofMul (F c)) :=
    fun c x => Int.mul_ediv_cancel' (Dv c x)
  choose τ hτT g hg using fun c => hT (D c) ⟨F c, K4 c⟩
  have K6 : ∀ (c : {c : ClassGroup Γ(X, U) // c ^ ℓ = 1})
      (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U)),
      D c (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩) = n c v - n (σ (r c)) v := by
    intro c v
    apply Int.eq_of_mul_eq_mul_left hℓ0
    rw [K4, K3, K1, K1, mul_sub]
  let Φ : {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} → (↥((U : Set X)ᶜ) → ZMod ℓ) × {t // t ∈ T} :=
    fun c => (r c, ⟨τ c, hτT c⟩)
  have hΦ : Function.Injective Φ := by
    intro c c' hcc
    simp only [Φ, Prod.mk.injEq, Subtype.mk.injEq] at hcc
    obtain ⟨hr, hτ⟩ := hcc
    have hσ : σ (r c) = σ (r c') := by rw [hr]
    have hz : ψ₀ (n c - n c') = 0 := by
      rw [hψk]
      refine ⟨g c / g c', fun v => ?_⟩
      rw [← ho3, ofMul_div, map_sub, Finsupp.sub_apply]
      have e1 := K6 c v
      have e2 := K6 c' v
      have e3 := hg c (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)
      have e4 := hg c' (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)
      rw [hσ] at e1
      rw [hτ] at e3
      linarith
    rw [map_sub, sub_eq_zero, hn, hn] at hz
    exact Subtype.ext (Additive.ofMul.injective hz)
  exact Finite.of_injective Φ hΦ

theorem wc_rr_residue_trivial (Ω K I : Type u) [Field Ω] [IsAlgClosed Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w) (hA6 : wcRRFinRank Ω K) :
    wcRRResidue Ω K I w :=
by
  classical
  obtain ⟨A1, -, A3, A4⟩ := hw
  intro i f hf0

  have addval : ∃ V : AddValuation K (WithTop ℤ), ∀ (x : K) (hx : x ≠ 0),
      V x = ((w i (Additive.ofMul (Units.mk0 x hx)) : ℤ) : WithTop ℤ) := by
    let v : K → WithTop ℤ := fun x =>
      if hx : x = 0 then ⊤ else ((w i (Additive.ofMul (Units.mk0 x hx)) : ℤ) : WithTop ℤ)
    have hv : ∀ x (hx : x ≠ 0), v x = ((w i (Additive.ofMul (Units.mk0 x hx)) : ℤ) : WithTop ℤ) :=
      fun x hx => dif_neg hx
    have h0 : v 0 = ⊤ := dif_pos rfl
    have h1 : v 1 = 0 := by
      rw [hv 1 one_ne_zero]
      have : Units.mk0 (1 : K) one_ne_zero = 1 := Units.ext rfl
      rw [this, ofMul_one, map_zero]
      rfl
    have hadd : ∀ x y, min (v x) (v y) ≤ v (x + y) := by
      intro x y
      by_cases hx : x = 0
      · subst hx; rw [zero_add]; exact min_le_right _ _
      by_cases hy : y = 0
      · subst hy; rw [add_zero]; exact min_le_left _ _
      by_cases hxy : x + y = 0
      · rw [hxy, h0]; exact le_top
      rw [hv x hx, hv y hy, hv _ hxy, ← WithTop.coe_min, WithTop.coe_le_coe]
      exact A1 i _ _ _ rfl
    have hmul : ∀ x y, v (x * y) = v x + v y := by
      intro x y
      by_cases hx : x = 0
      · subst hx; rw [zero_mul, h0, top_add]
      by_cases hy : y = 0
      · subst hy; rw [mul_zero, h0, add_top]
      rw [hv x hx, hv y hy, hv _ (mul_ne_zero hx hy)]
      have : Units.mk0 (x * y) (mul_ne_zero hx hy) = Units.mk0 x hx * Units.mk0 y hy :=
        Units.ext rfl
      rw [this, ofMul_mul, map_add]
      rfl
    exact ⟨AddValuation.of v h0 h1 hadd hmul, fun x hx => hv x hx⟩
  obtain ⟨V, hV⟩ := addval

  have hc : ∀ c : Ω, c ≠ 0 → V (algebraMap Ω K c) = 0 := by
    intro c hc0
    have hne : algebraMap Ω K c ≠ 0 := (map_ne_zero _).mpr hc0
    have hne' : algebraMap Ω K c⁻¹ ≠ 0 := (map_ne_zero _).mpr (inv_ne_zero hc0)
    have h1 := (A4 (Units.mk0 _ hne)).mpr ⟨c, rfl⟩ i
    have h2 := (A4 (Units.mk0 _ hne')).mpr ⟨c⁻¹, rfl⟩ i
    have hinv : Units.mk0 _ hne' = (Units.mk0 _ hne)⁻¹ := by
      ext; simp [map_inv₀]
    rw [hinv, ofMul_inv, map_neg] at h2
    rw [hV _ hne]
    have : w i (Additive.ofMul (Units.mk0 _ hne)) = 0 := by omega
    rw [this]
    rfl
  have hc0 : ∀ c : Ω, 0 ≤ V (algebraMap Ω K c) := by
    intro c
    by_cases h : c = 0
    · subst h; rw [map_zero, AddValuation.map_zero]; exact le_top
    · exact (hc c h).ge

  have aeval_nonneg : ∀ x : K, 0 ≤ V x → ∀ r : Polynomial Ω, 0 ≤ V (Polynomial.aeval x r) := by
    intro x hx r
    rw [Polynomial.aeval_eq_sum_range]
    apply AddValuation.map_le_sum
    intro k _
    rw [Algebra.smul_def, AddValuation.map_mul, AddValuation.map_pow]
    exact add_nonneg (hc0 _) (nsmul_nonneg hx _)

  have hVf : V (f : K) = 0 := by
    rw [hV _ f.ne_zero, Units.mk0_val, hf0]
    rfl
  have hVf' : 0 ≤ V (f : K) := by rw [hVf]

  obtain ⟨t₀, ht₀⟩ := A3 i
  have hVt : V (t₀ : K) = ((1 : ℤ) : WithTop ℤ) := by
    rw [hV _ t₀.ne_zero, Units.mk0_val, ht₀]
  have hVt0 : 0 ≤ V (t₀ : K) := by
    rw [hVt]; exact_mod_cast (zero_le_one : (0 : ℤ) ≤ 1)
  have htnot : (t₀ : K) ∉ Set.range (algebraMap Ω K) := by
    rintro ⟨c, hc'⟩
    by_cases c0 : c = 0
    · subst c0; rw [map_zero] at hc'; exact t₀.ne_zero hc'.symm
    · have h := hc c c0
      rw [hc', hVt] at h
      exact absurd h (by exact_mod_cast (one_ne_zero : (1 : ℤ) ≠ 0))

  obtain ⟨n, -, hdep⟩ := hA6 _ htnot
  obtain ⟨p, hp, hrel⟩ := hdep (fun j => (f : K) ^ (j : ℕ))

  have normalize : ∀ (N : ℕ) (p : Fin (n + 1) → Polynomial Ω), ∑ j, (p j).natDegree = N →
      p ≠ 0 → ∑ j, Polynomial.aeval (t₀ : K) (p j) * (f : K) ^ (j : ℕ) = 0 →
      ∃ q : Fin (n + 1) → Polynomial Ω, (∃ j, (q j).coeff 0 ≠ 0) ∧
        ∑ j, Polynomial.aeval (t₀ : K) (q j) * (f : K) ^ (j : ℕ) = 0 := by
    intro N
    induction N using Nat.strong_induction_on with
    | _ N ih =>
      intro p hN hp hrel
      by_cases h : ∃ j, (p j).coeff 0 ≠ 0
      · exact ⟨p, h, hrel⟩
      push_neg at h
      have hpX : ∀ j, p j = (p j).divX * Polynomial.X := by
        intro j
        have := Polynomial.divX_mul_X_add (p j)
        rw [h j, Polynomial.C_0, add_zero] at this
        exact this.symm
      obtain ⟨j₁, hj₁⟩ := Function.ne_iff.mp hp
      have hj₁' : (p j₁).divX ≠ 0 := by
        intro h0; apply hj₁; rw [hpX j₁, h0, zero_mul]; rfl
      have hlt : ∑ j, ((p j).divX).natDegree < N := by
        rw [← hN]
        apply Finset.sum_lt_sum
        · intro j _
          rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one]; omega
        · refine ⟨j₁, Finset.mem_univ _, ?_⟩
          have e := Polynomial.natDegree_mul_X hj₁'
          rw [← hpX j₁] at e
          omega
      have hne : (fun j => (p j).divX) ≠ 0 := by
        intro h0; exact hj₁' (congrFun h0 j₁)
      have hrel' : ∑ j, Polynomial.aeval (t₀ : K) ((p j).divX) * (f : K) ^ (j : ℕ) = 0 := by
        have e : ∑ j, Polynomial.aeval (t₀ : K) (p j) * (f : K) ^ (j : ℕ) =
            (t₀ : K) * ∑ j, Polynomial.aeval (t₀ : K) ((p j).divX) * (f : K) ^ (j : ℕ) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          conv_lhs => rw [hpX j]
          rw [map_mul, Polynomial.aeval_X]
          ring
        rw [e] at hrel
        exact (mul_eq_zero.mp hrel).resolve_left t₀.ne_zero
      exact ih _ hlt (fun j => (p j).divX) rfl hne hrel'
  obtain ⟨q, ⟨j₀, hj₀⟩, hq⟩ := normalize _ p rfl hp hrel

  let Q : Polynomial Ω := ∑ j : Fin (n + 1), Polynomial.C ((q j).coeff 0) * Polynomial.X ^ (j : ℕ)
  have hQcoeff : Q.coeff j₀ = (q j₀).coeff 0 := by
    simp only [Q, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow]
    rw [Finset.sum_eq_single j₀]
    · simp
    · intro j _ hj
      rw [if_neg]
      intro h'
      exact hj (Fin.ext h'.symm)
    · intro h'; exact absurd (Finset.mem_univ _) h'
  have hQ : Q ≠ 0 := by
    intro h0
    apply hj₀
    rw [← hQcoeff, h0, Polynomial.coeff_zero]

  have hkey : Polynomial.aeval (f : K) Q = -((t₀ : K) *
      ∑ j : Fin (n + 1), Polynomial.aeval (t₀ : K) ((q j).divX) * (f : K) ^ (j : ℕ)) := by
    have e1 : Polynomial.aeval (f : K) Q =
        ∑ j : Fin (n + 1), algebraMap Ω K ((q j).coeff 0) * (f : K) ^ (j : ℕ) := by
      simp only [Q, map_sum, map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
    have e2 : ∀ j, algebraMap Ω K ((q j).coeff 0) =
        Polynomial.aeval (t₀ : K) (q j) - (t₀ : K) * Polynomial.aeval (t₀ : K) ((q j).divX) := by
      intro j
      have := congrArg (Polynomial.aeval (t₀ : K)) (Polynomial.divX_mul_X_add (q j))
      rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C] at this
      rw [← this]
      ring
    have e3 : ∑ j : Fin (n + 1), algebraMap Ω K ((q j).coeff 0) * (f : K) ^ (j : ℕ) =
        ∑ j, Polynomial.aeval (t₀ : K) (q j) * (f : K) ^ (j : ℕ) -
          (t₀ : K) * ∑ j, Polynomial.aeval (t₀ : K) ((q j).divX) * (f : K) ^ (j : ℕ) := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [e2 j]
      ring
    rw [e1, e3, hq, zero_sub]

  have hS : 0 ≤ V (∑ j : Fin (n + 1),
      Polynomial.aeval (t₀ : K) ((q j).divX) * (f : K) ^ (j : ℕ)) := by
    apply AddValuation.map_le_sum
    intro j _
    rw [AddValuation.map_mul, AddValuation.map_pow, hVf, nsmul_zero, add_zero]
    exact aeval_nonneg _ hVt0 _
  have hpos : 0 < V (Polynomial.aeval (f : K) Q) := by
    rw [hkey, AddValuation.map_neg, AddValuation.map_mul, hVt]
    calc (0 : WithTop ℤ) < ((1 : ℤ) : WithTop ℤ) := by exact_mod_cast (zero_lt_one : (0 : ℤ) < 1)
      _ ≤ ((1 : ℤ) : WithTop ℤ) + _ := le_add_of_nonneg_right hS

  have peel : ∀ (d : ℕ) (Q : Polynomial Ω), Q.natDegree = d → Q ≠ 0 →
      0 < V (Polynomial.aeval (f : K) Q) → ∃ c : Ω, 0 < V ((f : K) - algebraMap Ω K c) := by
    intro d
    induction d using Nat.strong_induction_on with
    | _ d ih =>
      intro Q hd hQ hpos
      by_cases hd0 : d = 0
      · exfalso
        subst hd0
        have hc' : Q.coeff 0 ≠ 0 := by
          intro h; apply hQ; rw [Polynomial.eq_C_of_natDegree_eq_zero hd, h, Polynomial.C_0]
        rw [Polynomial.eq_C_of_natDegree_eq_zero hd, Polynomial.aeval_C, hc _ hc'] at hpos
        exact lt_irrefl _ hpos
      · obtain ⟨r, hr⟩ := IsAlgClosed.exists_root Q
          (by rw [Polynomial.degree_eq_natDegree hQ, hd]; exact_mod_cast hd0)
        have hmul := (Polynomial.mul_divByMonic_eq_iff_isRoot (a := r) (p := Q)).mpr hr
        have hQ' : Q /ₘ (Polynomial.X - Polynomial.C r) ≠ 0 := by
          intro h; apply hQ; rw [← hmul, h, mul_zero]
        have hdeg : (Q /ₘ (Polynomial.X - Polynomial.C r)).natDegree < d := by
          rw [Polynomial.natDegree_divByMonic _ (Polynomial.monic_X_sub_C r),
            Polynomial.natDegree_X_sub_C]
          omega
        have hval : V (Polynomial.aeval (f : K) Q) = V ((f : K) - algebraMap Ω K r) +
            V (Polynomial.aeval (f : K) (Q /ₘ (Polynomial.X - Polynomial.C r))) := by
          conv_lhs => rw [← hmul]
          rw [map_mul, AddValuation.map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
        by_cases hpr : 0 < V ((f : K) - algebraMap Ω K r)
        · exact ⟨r, hpr⟩
        · have hge : 0 ≤ V ((f : K) - algebraMap Ω K r) := by
            have := aeval_nonneg _ hVf' (Polynomial.X - Polynomial.C r)
            rwa [map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at this
          have heq : V ((f : K) - algebraMap Ω K r) = 0 := le_antisymm (not_lt.mp hpr) hge
          rw [hval, heq, zero_add] at hpos
          exact ih _ hdeg _ rfl hQ' hpos

  obtain ⟨c, hcpos⟩ := peel _ Q rfl hQ hpos
  refine ⟨c, ?_⟩
  by_cases hz : (f : K) - algebraMap Ω K c = 0
  · left; exact sub_eq_zero.mp hz
  · right
    refine ⟨Units.mk0 _ hz, rfl, ?_⟩
    rw [hV _ hz] at hcpos
    exact_mod_cast hcpos

theorem wc_rr_dimension_step (Ω K I : Type u) [Field Ω] [IsAlgClosed Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w) (hR : wcRRResidue Ω K I w) :
    wcRRDim Ω K I w :=
by
  classical
  obtain ⟨A1, -, -, A4⟩ := hw

  have vconst : ∀ i (c : Ω) (hc : algebraMap Ω K c ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ hc)) = 0 := by
    intro i c hc
    have h1 := (A4 (Units.mk0 _ hc)).mpr ⟨c, rfl⟩ i
    have hinv : algebraMap Ω K c⁻¹ ≠ 0 := by rw [map_inv₀]; exact inv_ne_zero hc
    have h2 := (A4 (Units.mk0 _ hinv)).mpr ⟨c⁻¹, rfl⟩ i
    have hmul : Units.mk0 _ hinv = (Units.mk0 _ hc)⁻¹ := by ext; simp [map_inv₀]
    rw [hmul, ofMul_inv, map_neg] at h2
    omega

  have hmem : ∀ (D : I →₀ ℤ) (f : K), f ∈ wcRRL Ω K I w D ↔
      f = 0 ∨ ∃ hf : f ≠ 0, ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf)) + D i := by
    intro D
    let T : Submodule Ω K :=
      { carrier := {f | f = 0 ∨ ∃ hf : f ≠ 0, ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf)) + D i}
        add_mem' := by
          intro f g hf hg
          simp only [Set.mem_setOf_eq] at hf hg ⊢
          rcases hf with rfl | ⟨hf0, hf⟩
          · rw [zero_add]; exact hg
          rcases hg with rfl | ⟨hg0, hg⟩
          · rw [add_zero]; exact Or.inr ⟨hf0, hf⟩
          by_cases hfg : f + g = 0
          · exact Or.inl hfg
          refine Or.inr ⟨hfg, fun i => ?_⟩
          have := A1 i (Units.mk0 f hf0) (Units.mk0 g hg0) (Units.mk0 (f + g) hfg) rfl
          have h1 := hf i
          have h2 := hg i
          rw [min_le_iff] at this
          omega
        zero_mem' := Or.inl rfl
        smul_mem' := by
          intro c f hf
          simp only [Set.mem_setOf_eq] at hf ⊢
          rcases hf with rfl | ⟨hf0, hf⟩
          · left; exact smul_zero c
          by_cases hc : c = 0
          · left; rw [hc, zero_smul]
          have hc' : algebraMap Ω K c ≠ 0 := (map_ne_zero _).mpr hc
          have hcf : c • f ≠ 0 := by rw [Algebra.smul_def]; exact mul_ne_zero hc' hf0
          refine Or.inr ⟨hcf, fun i => ?_⟩
          have e : Units.mk0 (c • f) hcf = Units.mk0 _ hc' * Units.mk0 f hf0 :=
            Units.ext (by simp [Algebra.smul_def])
          rw [e, ofMul_mul, map_add, vconst i c hc', zero_add]
          exact hf i }
    have hT : wcRRL Ω K I w D = T := by
      apply le_antisymm
      · apply Submodule.span_le.mpr
        intro f hf
        exact Or.inr hf
      · intro f hf
        change f = 0 ∨ ∃ hf : f ≠ 0, ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf)) + D i at hf
        rcases hf with rfl | hf
        · exact Submodule.zero_mem _
        · exact Submodule.subset_span hf
    intro f
    rw [hT]
    exact Iff.rfl

  have hstep : ∀ (D : I →₀ ℤ) (P : I),
      wcRRL Ω K I w D ≤ wcRRL Ω K I w (D + Finsupp.single P 1) ∧
      ∃ f₀ : K, wcRRL Ω K I w (D + Finsupp.single P 1) ≤
        wcRRL Ω K I w D ⊔ Submodule.span Ω {f₀} := by
    intro D P
    have hδ : ∀ i, (D + Finsupp.single P (1 : ℤ) : I →₀ ℤ) i = D i + if P = i then 1 else 0 := by
      intro i; rw [Finsupp.add_apply, Finsupp.single_apply]
    have hmono : wcRRL Ω K I w D ≤ wcRRL Ω K I w (D + Finsupp.single P 1) := by
      intro f hf
      rcases (hmem D f).mp hf with rfl | ⟨hf0, hf⟩
      · exact Submodule.zero_mem _
      · refine (hmem _ f).mpr (Or.inr ⟨hf0, fun i => ?_⟩)
        have := hf i
        rw [hδ]
        split_ifs <;> omega
    have hnew : ∀ g, g ∈ wcRRL Ω K I w (D + Finsupp.single P 1) → g ∉ wcRRL Ω K I w D →
        ∃ hg : g ≠ 0, w P (Additive.ofMul (Units.mk0 g hg)) = -D P - 1 ∧
          ∀ i, i ≠ P → 0 ≤ w i (Additive.ofMul (Units.mk0 g hg)) + D i := by
      intro g hg hgn
      rcases (hmem _ g).mp hg with rfl | ⟨hg0, hg⟩
      · exact absurd (Submodule.zero_mem _) hgn
      have hoff : ∀ i, i ≠ P → 0 ≤ w i (Additive.ofMul (Units.mk0 g hg0)) + D i := by
        intro i hi
        have := hg i
        rw [hδ, if_neg (Ne.symm hi), add_zero] at this
        exact this
      refine ⟨hg0, ?_, hoff⟩
      have hP := hg P
      rw [hδ, if_pos rfl] at hP
      by_contra hne
      apply hgn
      refine (hmem D g).mpr (Or.inr ⟨hg0, fun i => ?_⟩)
      by_cases hi : i = P
      · rw [hi]; omega
      · exact hoff i hi
    refine ⟨hmono, ?_⟩
    by_cases hex : ∃ f₀, f₀ ∈ wcRRL Ω K I w (D + Finsupp.single P 1) ∧ f₀ ∉ wcRRL Ω K I w D
    · obtain ⟨f₀, hf₀, hf₀n⟩ := hex
      obtain ⟨hf₀0, hf₀P, -⟩ := hnew f₀ hf₀ hf₀n
      refine ⟨f₀, fun g hg => ?_⟩
      by_cases hgD : g ∈ wcRRL Ω K I w D
      · exact Submodule.mem_sup_left hgD
      obtain ⟨hg0, hgP, -⟩ := hnew g hg hgD
      have hq0 : g * f₀⁻¹ ≠ 0 := mul_ne_zero hg0 (inv_ne_zero hf₀0)
      have hqP : w P (Additive.ofMul (Units.mk0 (g * f₀⁻¹) hq0)) = 0 := by
        have e : Units.mk0 (g * f₀⁻¹) hq0 = Units.mk0 g hg0 * (Units.mk0 f₀ hf₀0)⁻¹ :=
          Units.ext (by simp)
        rw [e, ofMul_mul, ofMul_inv, map_add, map_neg, hgP, hf₀P]
        ring
      obtain ⟨c, hc⟩ := hR P _ hqP
      rcases hc with hc | ⟨h, hh, hhP⟩
      · apply Submodule.mem_sup_right
        rw [Submodule.mem_span_singleton]
        refine ⟨c, ?_⟩
        rw [Algebra.smul_def, ← hc, Units.val_mk0, inv_mul_cancel_right₀ hf₀0]
      · have hrh : g - c • f₀ = (h : K) * f₀ := by
          rw [hh, Units.val_mk0, sub_mul, inv_mul_cancel_right₀ hf₀0, Algebra.smul_def]
        have hr0 : g - c • f₀ ≠ 0 := by rw [hrh]; exact mul_ne_zero h.ne_zero hf₀0
        have hrL : g - c • f₀ ∈ wcRRL Ω K I w (D + Finsupp.single P 1) :=
          Submodule.sub_mem _ hg (Submodule.smul_mem _ c hf₀)
        have hrD : g - c • f₀ ∈ wcRRL Ω K I w D := by
          rcases (hmem _ _).mp hrL with h0 | ⟨hr0', hrv⟩
          · exact absurd h0 hr0
          refine (hmem D _).mpr (Or.inr ⟨hr0, fun i => ?_⟩)
          by_cases hi : i = P
          · rw [hi]
            have e : Units.mk0 (g - c • f₀) hr0 = h * Units.mk0 f₀ hf₀0 :=
              Units.ext (by rw [Units.val_mk0, Units.val_mul, Units.val_mk0, hrh])
            rw [e, ofMul_mul, map_add, hf₀P]
            omega
          · have := hrv i
            rw [hδ, if_neg (Ne.symm hi), add_zero] at this
            exact this
        rw [Submodule.mem_sup]
        exact ⟨g - c • f₀, hrD, c • f₀,
          Submodule.smul_mem _ c (Submodule.mem_span_singleton_self f₀), sub_add_cancel g _⟩
    · refine ⟨0, fun g hg => Submodule.mem_sup_left ?_⟩
      by_contra hgD
      exact hex ⟨g, hg, hgD⟩

  have hmulti : ∀ n : ℕ, ∀ D D' : I →₀ ℤ, D ≤ D' → (D' - D).sum (fun _ k => k) = (n : ℤ) →
      wcRRL Ω K I w D ≤ wcRRL Ω K I w D' ∧
      (FiniteDimensional Ω (wcRRL Ω K I w D) → FiniteDimensional Ω (wcRRL Ω K I w D') ∧
        (Module.finrank Ω (wcRRL Ω K I w D') : ℤ) ≤ Module.finrank Ω (wcRRL Ω K I w D) + n) := by
    intro n
    induction n with
    | zero =>
      intro D D' hDD' hdeg
      have hnn : ∀ i ∈ (D' - D).support, 0 ≤ (D' - D) i := fun i _ => by
        rw [Finsupp.sub_apply]; have := hDD' i; omega
      have h0 : ∑ i ∈ (D' - D).support, (D' - D) i = 0 := hdeg.trans Nat.cast_zero
      have hz := (Finset.sum_eq_zero_iff_of_nonneg hnn).mp h0
      have hE : D' - D = 0 := by
        ext i
        by_cases hi : i ∈ (D' - D).support
        · exact hz i hi
        · exact Finsupp.notMem_support_iff.mp hi
      have hDD : D' = D := sub_eq_zero.mp hE
      subst hDD
      exact ⟨le_rfl, fun h => ⟨h, by simp⟩⟩
    | succ n ih =>
      intro D D' hDD' hdeg
      have hEnn : ∀ i, 0 ≤ (D' - D) i := fun i => by
        rw [Finsupp.sub_apply]; have := hDD' i; omega
      have hEne : D' - D ≠ 0 := by
        intro h0
        rw [h0, Finsupp.sum_zero_index] at hdeg
        omega
      obtain ⟨P, hP⟩ := Finsupp.support_nonempty_iff.mpr hEne
      have hEP : 1 ≤ (D' - D) P := by
        have h1 := hEnn P
        have h2 := Finsupp.mem_support_iff.mp hP
        omega
      have hD''a : D' - Finsupp.single P 1 + Finsupp.single P 1 = D' := sub_add_cancel _ _
      have hDD'' : D ≤ D' - Finsupp.single P 1 := by
        intro i
        rw [Finsupp.sub_apply, Finsupp.single_apply]
        have h1 := hEnn i
        rw [Finsupp.sub_apply] at h1
        split_ifs with h
        · subst h
          rw [Finsupp.sub_apply] at hEP
          omega
        · omega
      have hdeg'' : (D' - Finsupp.single P 1 - D).sum (fun _ k => k) = (n : ℤ) := by
        have e : D' - Finsupp.single P 1 - D = (D' - D) - Finsupp.single P 1 := by abel
        rw [e, Finsupp.sum_sub_index (fun _ _ _ => rfl), Finsupp.sum_single_index rfl, hdeg]
        push_cast
        ring
      obtain ⟨ih1, ih2⟩ := ih D _ hDD'' hdeg''
      obtain ⟨hs1, f₀, hs2⟩ := hstep (D' - Finsupp.single P 1) P
      rw [hD''a] at hs1 hs2
      refine ⟨ih1.trans hs1, fun hfd => ?_⟩
      obtain ⟨hfd'', hrk''⟩ := ih2 hfd
      haveI := hfd''
      haveI hfd' : FiniteDimensional Ω (wcRRL Ω K I w D') := Submodule.finiteDimensional_of_le hs2
      refine ⟨hfd', ?_⟩
      have h1 := Submodule.finrank_mono hs2
      have h2 := Submodule.finrank_add_le_finrank_add_finrank
        (wcRRL Ω K I w (D' - Finsupp.single P 1)) (Submodule.span Ω {f₀})
      have h3 : Module.finrank Ω (Submodule.span Ω {f₀}) ≤ 1 := by
        have := finrank_span_le_card (R := Ω) ({f₀} : Set K)
        simpa using this
      push_cast
      omega

  have hL0 : wcRRL Ω K I w 0 = Submodule.span Ω {(1 : K)} := by
    ext f
    rw [hmem, Submodule.mem_span_singleton]
    constructor
    · rintro (rfl | ⟨hf0, hf⟩)
      · exact ⟨0, zero_smul _ _⟩
      · obtain ⟨c, hc⟩ := (A4 (Units.mk0 f hf0)).mp (fun i => by
          have := hf i
          rw [Finsupp.coe_zero, Pi.zero_apply, add_zero] at this
          exact this)
        exact ⟨c, by rw [Algebra.smul_def, mul_one]; exact hc⟩
    · rintro ⟨c, rfl⟩
      by_cases hc : c • (1 : K) = 0
      · exact Or.inl hc
      · refine Or.inr ⟨hc, fun i => ?_⟩
        have := (A4 (Units.mk0 _ hc)).mpr ⟨c, by rw [Units.val_mk0, Algebra.smul_def, mul_one]⟩ i
        rw [Finsupp.coe_zero, Pi.zero_apply, add_zero]
        exact this
  have hfd0 : FiniteDimensional Ω (wcRRL Ω K I w 0) := by rw [hL0]; infer_instance
  have hdegnn : ∀ D D' : I →₀ ℤ, D ≤ D' → 0 ≤ (D' - D).sum (fun _ k => k) := by
    intro D D' h
    exact Finset.sum_nonneg (fun i _ => by
      show 0 ≤ (D' - D) i
      rw [Finsupp.sub_apply]; have := h i; omega)
  have hgen := fun D D' (h : D ≤ D') =>
    hmulti _ D D' h (Int.toNat_of_nonneg (hdegnn D D' h)).symm
  have hFD : ∀ D, FiniteDimensional Ω (wcRRL Ω K I w D) := by
    intro D
    have h1 := (hgen 0 (D ⊔ 0) le_sup_right).2 hfd0
    haveI := h1.1
    exact Submodule.finiteDimensional_of_le (hgen D (D ⊔ 0) le_sup_left).1
  refine ⟨?_, hFD, fun D D' h => ⟨(hgen D D' h).1, ?_⟩⟩
  · rw [hL0]; exact finrank_span_singleton one_ne_zero
  · have := ((hgen D D' h).2 (hFD D)).2
    rwa [Int.toNat_of_nonneg (hdegnn D D' h)] at this

theorem wc_rr_pole_degree_le (Ω K I : Type u) [Field Ω] [IsAlgClosed Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w) (hinj : Function.Injective w)
    (hR : wcRRResidue Ω K I w) :
    wcRRPole Ω K I w :=
by
  classical
  obtain ⟨A1, A2, A3, A4⟩ := hw

  have hneg1 : ∀ i, w i (Additive.ofMul (-1 : Kˣ)) = 0 := by
    intro i
    have h := congrArg (fun x : Kˣ => w i (Additive.ofMul x)) (neg_one_mul (-1 : Kˣ))
    simp only [neg_neg, ofMul_mul, map_add, ofMul_one, map_zero] at h
    omega
  have hnegv : ∀ i (x : Kˣ), w i (Additive.ofMul (-x)) = w i (Additive.ofMul x) := by
    intro i x
    rw [← neg_one_mul x, ofMul_mul, map_add, hneg1, zero_add]

  have hstrict : ∀ i (a b : Kˣ), w i (Additive.ofMul a) < w i (Additive.ofMul b) →
      ∃ hab : (a : K) + (b : K) ≠ 0,
        w i (Additive.ofMul (Units.mk0 _ hab)) = w i (Additive.ofMul a) := by
    intro i a b hlt
    have hab : (a : K) + (b : K) ≠ 0 := by
      intro h0
      have hb : b = -a := Units.ext (by rw [Units.val_neg]; linear_combination h0)
      rw [hb, hnegv] at hlt
      exact lt_irrefl _ hlt
    refine ⟨hab, le_antisymm ?_ ?_⟩
    · have h1 := A1 i (Units.mk0 _ hab) (-b) a (by rw [Units.val_mk0, Units.val_neg]; ring)
      rw [hnegv] at h1
      omega
    · have h1 := A1 i a b (Units.mk0 _ hab) (by rw [Units.val_mk0])
      omega

  have hsum : ∀ i (J : Type) (s : Finset J) (g : J → K) (j₀ : J), j₀ ∈ s → ∀ h0 : g j₀ ≠ 0,
      (∀ j ∈ s, j ≠ j₀ → ∀ hj : g j ≠ 0,
        w i (Additive.ofMul (Units.mk0 (g j₀) h0)) < w i (Additive.ofMul (Units.mk0 (g j) hj))) →
      ∃ hs : ∑ j ∈ s, g j ≠ 0,
        w i (Additive.ofMul (Units.mk0 _ hs)) = w i (Additive.ofMul (Units.mk0 (g j₀) h0)) := by
    intro i J s g j₀ hj₀ h0 hlt
    have claim : ∀ T : Finset J, (∀ j ∈ T, ∀ hj : g j ≠ 0,
        w i (Additive.ofMul (Units.mk0 (g j₀) h0)) < w i (Additive.ofMul (Units.mk0 (g j) hj))) →
        ∀ hT : ∑ j ∈ T, g j ≠ 0,
        w i (Additive.ofMul (Units.mk0 (g j₀) h0)) < w i (Additive.ofMul (Units.mk0 _ hT)) := by
      intro T
      induction T using Finset.induction_on with
      | empty => intro _ hT; simp at hT
      | insert a T haT ih =>
        intro hall hT
        have e : ∑ j ∈ insert a T, g j = g a + ∑ j ∈ T, g j := Finset.sum_insert haT
        have hall' : ∀ j ∈ T, ∀ hj : g j ≠ 0,
            w i (Additive.ofMul (Units.mk0 (g j₀) h0)) <
              w i (Additive.ofMul (Units.mk0 (g j) hj)) :=
          fun j hj => hall j (Finset.mem_insert_of_mem hj)
        by_cases ha : g a = 0
        · have hT' : ∑ j ∈ T, g j ≠ 0 := by
            intro h; apply hT; rw [e, ha, h, zero_add]
          have hu : Units.mk0 _ hT = Units.mk0 _ hT' :=
            Units.ext (by simp only [Units.val_mk0]; rw [e, ha, zero_add])
          rw [hu]; exact ih hall' hT'
        · by_cases hT0 : ∑ j ∈ T, g j = 0
          · have hu : Units.mk0 _ hT = Units.mk0 _ ha :=
              Units.ext (by simp only [Units.val_mk0]; rw [e, hT0, add_zero])
            rw [hu]; exact hall a (Finset.mem_insert_self a T) ha
          · have h1 := hall a (Finset.mem_insert_self a T) ha
            have h2 := ih hall' hT0
            have h3 := A1 i (Units.mk0 _ ha) (Units.mk0 _ hT0) (Units.mk0 _ hT)
              (by simp only [Units.val_mk0]; exact e)
            omega
    have e : g j₀ + ∑ j ∈ s.erase j₀, g j = ∑ j ∈ s, g j := Finset.add_sum_erase s g hj₀
    by_cases hr : ∑ j ∈ s.erase j₀, g j = 0
    · have hs : ∑ j ∈ s, g j ≠ 0 := by rw [← e, hr, add_zero]; exact h0
      refine ⟨hs, ?_⟩
      have hu : Units.mk0 _ hs = Units.mk0 _ h0 :=
        Units.ext (by simp only [Units.val_mk0]; rw [← e, hr, add_zero])
      rw [hu]
    · have hlt' := claim (s.erase j₀)
        (fun j hj hgj => hlt j (Finset.mem_of_mem_erase hj) (Finset.ne_of_mem_erase hj) hgj) hr
      obtain ⟨hne, hv⟩ := hstrict i (Units.mk0 _ h0) (Units.mk0 _ hr) hlt'
      have hs : ∑ j ∈ s, g j ≠ 0 := by rw [← e]; simpa only [Units.val_mk0] using hne
      refine ⟨hs, ?_⟩
      have hu : Units.mk0 _ hs = Units.mk0 _ hne :=
        Units.ext (by simp only [Units.val_mk0]; rw [← e])
      rw [hu]; exact hv

  have hconst : ∀ i (c : Ω) (hc : algebraMap Ω K c ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ hc)) = 0 := by
    intro i c hc
    have h1 := (A4 (Units.mk0 _ hc)).mpr ⟨c, rfl⟩ i
    have hinv : algebraMap Ω K c⁻¹ ≠ 0 := by rw [map_inv₀]; exact inv_ne_zero hc
    have h2 := (A4 (Units.mk0 _ hinv)).mpr ⟨c⁻¹, rfl⟩ i
    have hmul : Units.mk0 _ hinv = (Units.mk0 _ hc)⁻¹ := by ext; simp [map_inv₀]
    rw [hmul, ofMul_inv, map_neg] at h2
    omega
  have hterm : ∀ i (c : Ω) (x : Kˣ) (m : ℕ) (hc : c ≠ 0) (h : c • (x : K) ^ m ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ h)) = (m : ℤ) * w i (Additive.ofMul x) := by
    intro i c x m hc h
    have hc' : algebraMap Ω K c ≠ 0 := (map_ne_zero _).mpr hc
    have hu : Units.mk0 _ h = Units.mk0 _ hc' * x ^ m := Units.ext (by simp [Algebra.smul_def])
    rw [hu, ofMul_mul, map_add, hconst i c hc', ofMul_pow, map_nsmul, nsmul_eq_mul, zero_add]

  have hpoly : ∀ i (f : Kˣ), w i (Additive.ofMul f) < 0 → ∀ p : Polynomial Ω, p ≠ 0 →
      ∃ h : Polynomial.aeval (f : K) p ≠ 0,
        w i (Additive.ofMul (Units.mk0 _ h)) = (p.natDegree : ℤ) * w i (Additive.ofMul f) := by
    intro i f hf p hp
    have hcd : p.coeff p.natDegree ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hp
    have h0 : p.coeff p.natDegree • (f : K) ^ p.natDegree ≠ 0 := by
      rw [Algebra.smul_def]
      exact mul_ne_zero ((map_ne_zero _).mpr hcd) (pow_ne_zero _ f.ne_zero)
    obtain ⟨hs, hv⟩ := hsum i ℕ (Finset.range (p.natDegree + 1))
      (fun m => p.coeff m • (f : K) ^ m) p.natDegree (Finset.self_mem_range_succ _) h0 (by
        intro m hm hmd hgm
        have hcm : p.coeff m ≠ 0 := by
          intro hc; apply hgm; rw [hc, zero_smul]
        have hml : (m : ℤ) < p.natDegree := by
          have := Finset.mem_range.mp hm; omega
        rw [hterm i _ f _ hcd h0, hterm i _ f _ hcm hgm]
        nlinarith)
    have e := Polynomial.aeval_eq_sum_range (p := p) (f : K)
    have ha : Polynomial.aeval (f : K) p ≠ 0 := by rw [e]; exact hs
    refine ⟨ha, ?_⟩
    have hu : Units.mk0 _ ha = Units.mk0 _ hs := Units.ext (by simp only [Units.val_mk0]; exact e)
    rw [hu, hv, hterm i _ f _ hcd h0]

  have hQ : ∀ ρ σ : Additive Kˣ →+ ℤ, (∃ t : Kˣ, ρ (Additive.ofMul t) = 1) →
      (∃ t : Kˣ, σ (Additive.ofMul t) = 1) →
      (∀ x : Kˣ, 0 ≤ ρ (Additive.ofMul x) → 0 ≤ σ (Additive.ofMul x)) → ρ = σ := by
    rintro ρ σ ⟨t, ht⟩ ⟨t', ht'⟩ hle
    have h0 : ∀ x : Kˣ, ρ (Additive.ofMul x) = 0 → σ (Additive.ofMul x) = 0 := by
      intro x hx
      have a1 := hle x (by omega)
      have a2 := hle x⁻¹ (by rw [ofMul_inv, map_neg]; omega)
      rw [ofMul_inv, map_neg] at a2
      omega
    have hc : 0 ≤ σ (Additive.ofMul t) := hle t (by omega)
    have hlin : ∀ x : Kˣ, σ (Additive.ofMul x) = σ (Additive.ofMul t) * ρ (Additive.ofMul x) := by
      intro x
      have e := h0 (x * t ^ (-(ρ (Additive.ofMul x)))) (by
        rw [ofMul_mul, ofMul_zpow, map_add, map_zsmul, ht, smul_eq_mul]; ring)
      rw [ofMul_mul, ofMul_zpow, map_add, map_zsmul, smul_eq_mul] at e
      linear_combination e
    have h1 : σ (Additive.ofMul t) = 1 :=
      Int.eq_one_of_mul_eq_one_right hc (by rw [← hlin t', ht'])
    apply AddMonoidHom.ext
    intro x
    have := hlin (Additive.toMul x)
    rw [h1, one_mul] at this
    exact this.symm
  have hpair : ∀ i j, i ≠ j →
      ∃ u : Kˣ, 0 < w i (Additive.ofMul u) ∧ w j (Additive.ofMul u) < 0 := by
    intro i j hij
    have hne : w i ≠ w j := hinj.ne hij
    obtain ⟨x, hx1, hx2⟩ : ∃ x : Kˣ, 0 ≤ w i (Additive.ofMul x) ∧ w j (Additive.ofMul x) < 0 := by
      by_contra hc; push_neg at hc; exact hne (hQ _ _ (A3 i) (A3 j) hc)
    obtain ⟨y, hy1, hy2⟩ : ∃ y : Kˣ, 0 ≤ w j (Additive.ofMul y) ∧ w i (Additive.ofMul y) < 0 := by
      by_contra hc; push_neg at hc; exact hne (hQ _ _ (A3 j) (A3 i) hc).symm
    refine ⟨x * y⁻¹, ?_, ?_⟩ <;> rw [ofMul_mul, ofMul_inv, map_add, map_neg] <;> omega

  have hsep : ∀ (k : I) (S : Finset I), k ∉ S →
      ∃ u : Kˣ, 0 < w k (Additive.ofMul u) ∧ ∀ l ∈ S, w l (Additive.ofMul u) < 0 := by
    intro k S
    induction S using Finset.induction_on with
    | empty =>
      intro _
      obtain ⟨t, ht⟩ := A3 k
      exact ⟨t, by omega, fun l hl => absurd hl (Finset.notMem_empty l)⟩
    | insert m S' hmS ih =>
      intro hk
      have hkm : k ≠ m := fun h => hk (h ▸ Finset.mem_insert_self m S')
      have hkS : k ∉ S' := fun h => hk (Finset.mem_insert_of_mem h)
      obtain ⟨u', hu'k, hu'S⟩ := ih hkS
      obtain ⟨u'', hu''k, hu''m⟩ := hpair k m hkm
      by_cases hm : w m (Additive.ofMul u') < 0
      · refine ⟨u', hu'k, fun l hl => ?_⟩
        rcases Finset.mem_insert.mp hl with rfl | hl
        · exact hm
        · exact hu'S l hl
      · push_neg at hm
        obtain ⟨s, hs⟩ : ∃ s : ℕ, s = 1 + ∑ l ∈ S', (w l (Additive.ofMul u'')).natAbs := ⟨_, rfl⟩
        have hs1 : (1 : ℤ) ≤ s := by omega
        have hA : ∀ i, w i (Additive.ofMul (u' ^ s)) = (s : ℤ) * w i (Additive.ofMul u') := by
          intro i; rw [ofMul_pow, map_nsmul, nsmul_eq_mul]
        obtain ⟨hne, hval⟩ := hstrict m u'' (u' ^ s) (by rw [hA]; nlinarith)
        refine ⟨Units.mk0 _ hne, ?_, fun l hl => ?_⟩
        · have h1 := A1 k u'' (u' ^ s) (Units.mk0 _ hne) (by rw [Units.val_mk0])
          rw [hA] at h1
          have : 0 < (s : ℤ) * w k (Additive.ofMul u') := by nlinarith
          omega
        · rcases Finset.mem_insert.mp hl with rfl | hl
          · rw [hval]; exact hu''m
          · have hle : (w l (Additive.ofMul u'')).natAbs ≤
                ∑ l ∈ S', (w l (Additive.ofMul u'')).natAbs :=
              Finset.single_le_sum (f := fun l => (w l (Additive.ofMul u'')).natAbs)
                (fun _ _ => Nat.zero_le _) hl
            have hl1 : w l (Additive.ofMul u') ≤ -1 := by have := hu'S l hl; omega
            have hb : -(s : ℤ) < w l (Additive.ofMul u'') := by omega
            have hsl : (s : ℤ) * w l (Additive.ofMul u') ≤ -(s : ℤ) := by nlinarith
            obtain ⟨hne2, hval2⟩ := hstrict l (u' ^ s) u'' (by rw [hA]; linarith)
            have hu : Units.mk0 _ hne = Units.mk0 _ hne2 :=
              Units.ext (by simp only [Units.val_mk0]; ring)
            rw [hu, hval2, hA]; linarith

  have happrox : ∀ (k : I) (S : Finset I), k ∉ S → ∀ (a : ℕ) (M : ℤ),
      ∃ z : Kˣ, w k (Additive.ofMul z) = a ∧ ∀ l ∈ S, M ≤ w l (Additive.ofMul z) := by
    intro k S hk a M
    obtain ⟨t, ht⟩ := A3 k
    obtain ⟨u, huk, huS⟩ := hsep k S hk
    obtain ⟨N, hN⟩ : ∃ N : ℕ, N = ∑ l ∈ S, (w l (Additive.ofMul t)).natAbs := ⟨_, rfl⟩
    obtain ⟨s, hs⟩ : ∃ s : ℕ, s = 1 + M.natAbs + a * N := ⟨_, rfl⟩
    have hs1 : (1 : ℤ) ≤ s := by omega
    have hA : ∀ i, w i (Additive.ofMul (u ^ s)) = (s : ℤ) * w i (Additive.ofMul u) := by
      intro i; rw [ofMul_pow, map_nsmul, nsmul_eq_mul]
    obtain ⟨hne, hval⟩ := hstrict k 1 (u ^ s) (by rw [hA, ofMul_one, map_zero]; nlinarith)
    rw [ofMul_one, map_zero] at hval
    refine ⟨t ^ a * (Units.mk0 _ hne)⁻¹, ?_, fun l hl => ?_⟩
    · rw [ofMul_mul, ofMul_inv, ofMul_pow, map_add, map_neg, map_nsmul, ht, hval, nsmul_eq_mul]
      ring
    · have hl1 : w l (Additive.ofMul u) ≤ -1 := by have := huS l hl; omega
      have hsl : (s : ℤ) * w l (Additive.ofMul u) ≤ -(s : ℤ) := by nlinarith
      obtain ⟨hne2, hval2⟩ := hstrict l (u ^ s) 1 (by rw [hA, ofMul_one, map_zero]; linarith)
      have hu : Units.mk0 _ hne = Units.mk0 _ hne2 :=
        Units.ext (by simp only [Units.val_mk0]; ring)
      have hle : (w l (Additive.ofMul t)).natAbs ≤ ∑ l ∈ S, (w l (Additive.ofMul t)).natAbs :=
        Finset.single_le_sum (f := fun l => (w l (Additive.ofMul t)).natAbs)
          (fun _ _ => Nat.zero_le _) hl
      have htl : -(N : ℤ) ≤ w l (Additive.ofMul t) := by omega
      have hat : -((a : ℤ) * N) ≤ (a : ℤ) * w l (Additive.ofMul t) := by
        nlinarith [(Nat.cast_nonneg a : (0 : ℤ) ≤ a)]
      have hM : M ≤ (M.natAbs : ℤ) := by omega
      have hs' : (s : ℤ) = 1 + M.natAbs + a * N := by rw [hs]; push_cast; ring
      rw [ofMul_mul, ofMul_inv, ofMul_pow, map_add, map_neg, map_nsmul, nsmul_eq_mul, hu, hval2,
        hA]
      linarith

  intro f n H
  obtain ⟨S, hSdef⟩ : ∃ S : Finset I,
      S = (A2 f).toFinset.filter (fun i => w i (Additive.ofMul f) < 0) := ⟨_, rfl⟩
  have hmemS : ∀ i, i ∈ S ↔ w i (Additive.ofMul f) < 0 := by
    intro i
    rw [hSdef, Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
    constructor
    · exact fun h => h.2
    · intro h; exact ⟨h.ne, h⟩
  have hsupp : Function.support (fun i => max 0 (-(w i (Additive.ofMul f)))) ⊆ (S : Set I) := by
    intro i hi
    rw [Function.mem_support] at hi
    rw [Finset.mem_coe, hmemS]
    omega
  rw [finsum_eq_sum_of_support_subset _ hsupp]
  have hpos : ∀ i ∈ S, 0 < -(w i (Additive.ofMul f)) := fun i hi => by
    have := (hmemS i).mp hi; omega
  have hsumeq : ∑ i ∈ S, max 0 (-(w i (Additive.ofMul f))) =
      ∑ i ∈ S, (-(w i (Additive.ofMul f))) :=
    Finset.sum_congr rfl (fun i hi => by have := hpos i hi; omega)
  rw [hsumeq]
  by_contra hcon
  push_neg at hcon

  obtain ⟨T, hT⟩ : ∃ T : Finset (Σ _ : I, ℕ),
      T = S.sigma (fun i => Finset.range (-(w i (Additive.ofMul f))).toNat) := ⟨_, rfl⟩
  have hTcard : ((T.card : ℕ) : ℤ) = ∑ i ∈ S, (-(w i (Additive.ofMul f))) := by
    rw [hT, Finset.card_sigma, Nat.cast_sum]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    rw [Finset.card_range, Int.toNat_of_nonneg (hpos i hi).le]
  have hcardle : Fintype.card (Fin (n + 1)) ≤ Fintype.card T := by
    rw [Fintype.card_fin, Fintype.card_coe]; omega
  obtain ⟨ι⟩ := Function.Embedding.nonempty_of_card_le hcardle
  obtain ⟨key, hkeydef⟩ : ∃ key : Fin (n + 1) → I × ℕ,
      key = fun j => ((ι j).1.1, (ι j).1.2) := ⟨_, rfl⟩
  have hkey : Function.Injective key := by
    intro a b h
    rw [hkeydef] at h
    simp only [Prod.mk.injEq] at h
    apply ι.injective
    apply Subtype.ext
    exact Sigma.ext h.1 (heq_of_eq h.2)
  have hkeyS : ∀ j, (key j).1 ∈ S ∧ ((key j).2 : ℤ) < -(w (key j).1 (Additive.ofMul f)) := by
    intro j
    have hj : (ι j).1 ∈ S.sigma (fun i => Finset.range (-(w i (Additive.ofMul f))).toNat) :=
      hT ▸ (ι j).2
    rw [Finset.mem_sigma, Finset.mem_range] at hj
    rw [hkeydef]
    exact ⟨hj.1, Int.lt_toNat.mp hj.2⟩

  obtain ⟨M0, hM0⟩ : ∃ M0 : ℤ, M0 = ∑ i ∈ S, (-(w i (Additive.ofMul f))) := ⟨_, rfl⟩
  have hz : ∀ j, ∃ z : Kˣ, w (key j).1 (Additive.ofMul z) = ((key j).2 : ℤ) ∧
      ∀ l ∈ S.erase (key j).1, M0 ≤ w l (Additive.ofMul z) :=
    fun j => happrox (key j).1 (S.erase (key j).1) (Finset.notMem_erase _ _) (key j).2 M0
  choose z hz1 hz2 using hz
  have hz2' : ∀ j, ∀ l ∈ S, l ≠ (key j).1 →
      -(w l (Additive.ofMul f)) ≤ w l (Additive.ofMul (z j)) := by
    intro j l hl hne
    have h1 := hz2 j l (Finset.mem_erase.mpr ⟨hne, hl⟩)
    have h2 : -(w l (Additive.ofMul f)) ≤ ∑ i ∈ S, (-(w i (Additive.ofMul f))) :=
      Finset.single_le_sum (fun i hi => (hpos i hi).le) hl
    omega

  obtain ⟨p, hp, hrel⟩ := H (fun j => (z j : K))
  obtain ⟨j, hj⟩ := Function.ne_iff.mp hp
  obtain ⟨J, hJ⟩ : ∃ J : Finset (Fin (n + 1)), J = Finset.univ.filter (fun j => p j ≠ 0) :=
    ⟨_, rfl⟩
  have hmemJ : ∀ j, j ∈ J ↔ p j ≠ 0 := by intro j; rw [hJ]; simp
  obtain ⟨j₁, hj₁J, hj₁max⟩ := J.exists_max_image (fun j => (p j).natDegree)
    ⟨j, (hmemJ j).mpr hj⟩
  obtain ⟨D, hD⟩ : ∃ D, D = (p j₁).natDegree := ⟨_, rfl⟩
  obtain ⟨i₀, hi₀⟩ : ∃ i₀, i₀ = (key j₁).1 := ⟨_, rfl⟩
  obtain ⟨J₀, hJ₀⟩ : ∃ J₀ : Finset (Fin (n + 1)),
      J₀ = J.filter (fun j => (p j).natDegree = D ∧ (key j).1 = i₀) := ⟨_, rfl⟩
  have hmemJ₀ : ∀ j, j ∈ J₀ ↔ j ∈ J ∧ (p j).natDegree = D ∧ (key j).1 = i₀ := by
    intro j; rw [hJ₀, Finset.mem_filter]
  obtain ⟨j₀, hj₀J₀, hj₀min⟩ := J₀.exists_min_image (fun j => (key j).2)
    ⟨j₁, (hmemJ₀ j₁).mpr ⟨hj₁J, hD.symm, hi₀.symm⟩⟩
  obtain ⟨hj₀J, hj₀D, hj₀i⟩ := (hmemJ₀ j₀).mp hj₀J₀
  have hi₀S : i₀ ∈ S := by rw [hi₀]; exact (hkeyS j₁).1
  have hE : w i₀ (Additive.ofMul f) < 0 := (hmemS i₀).mp hi₀S
  have ha₀ : ((key j₀).2 : ℤ) < -(w i₀ (Additive.ofMul f)) := by
    have := (hkeyS j₀).2; rw [hj₀i] at this; exact this
  have hgval : ∀ j (hpj : p j ≠ 0) (hg : Polynomial.aeval (f : K) (p j) * (z j : K) ≠ 0),
      w i₀ (Additive.ofMul (Units.mk0 _ hg)) =
        ((p j).natDegree : ℤ) * w i₀ (Additive.ofMul f) + w i₀ (Additive.ofMul (z j)) := by
    intro j hpj hg
    obtain ⟨ha, hv⟩ := hpoly i₀ f hE (p j) hpj
    have hu : Units.mk0 _ hg = Units.mk0 _ ha * z j := Units.ext (by simp)
    rw [hu, ofMul_mul, map_add, hv]
  have hzi : ∀ j, (key j).1 = i₀ → w i₀ (Additive.ofMul (z j)) = ((key j).2 : ℤ) := by
    intro j h; rw [← h]; exact hz1 j
  have hg0 : Polynomial.aeval (f : K) (p j₀) * (z j₀ : K) ≠ 0 :=
    mul_ne_zero (hpoly i₀ f hE (p j₀) ((hmemJ j₀).mp hj₀J)).1 (z j₀).ne_zero
  obtain ⟨hs, -⟩ := hsum i₀ (Fin (n + 1)) Finset.univ
    (fun j => Polynomial.aeval (f : K) (p j) * (z j : K)) j₀ (Finset.mem_univ _) hg0 (by
      intro j _ hjne hgj
      have hpj : p j ≠ 0 := by
        intro h0; apply hgj; rw [h0, map_zero, zero_mul]
      have hdle : (p j).natDegree ≤ D := by rw [hD]; exact hj₁max j ((hmemJ j).mpr hpj)
      rw [hgval j₀ ((hmemJ j₀).mp hj₀J) hg0, hgval j hpj hgj, hzi j₀ hj₀i, hj₀D]
      by_cases hki : (key j).1 = i₀
      · rw [hzi j hki]
        by_cases hdD : (p j).natDegree = D
        · have hmin := hj₀min j ((hmemJ₀ j).mpr ⟨(hmemJ j).mpr hpj, hdD, hki⟩)
          have hne2 : (key j₀).2 ≠ (key j).2 := by
            intro heq
            apply hjne
            apply hkey
            exact Prod.ext (hki.trans hj₀i.symm) heq.symm
          have h3 : ((key j₀).2 : ℤ) < ((key j).2 : ℤ) := by
            exact_mod_cast lt_of_le_of_ne hmin hne2
          rw [hdD]
          linarith
        · have hlt' : ((p j).natDegree : ℤ) + 1 ≤ D := by
            have : (p j).natDegree + 1 ≤ D := by omega
            exact_mod_cast this
          nlinarith [mul_le_mul_of_nonpos_right hlt' hE.le,
            (Nat.cast_nonneg (key j).2 : (0 : ℤ) ≤ _)]
      · have h1 := hz2' j i₀ hi₀S (Ne.symm hki)
        have hdle' : ((p j).natDegree : ℤ) ≤ D := by exact_mod_cast hdle
        nlinarith [mul_le_mul_of_nonpos_right hdle' hE.le])
  exact hs hrel

theorem wc_rr_degree_zero (Ω K I : Type u) [Field Ω] [IsAlgClosed Ω] [Field K] [Algebra Ω K]
    (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w) (hA6 : wcRRFinRank Ω K)
    (hD : wcRRDim Ω K I w) (hP : wcRRPole Ω K I w) :
    ∀ f : Kˣ, finsum (fun i => w i (Additive.ofMul f)) = 0 :=
by
  classical

  have s1 : ∀ (g : K) (n : ℕ) (u : Fin n → K),
      (∀ p : Fin n → Polynomial Ω, ∑ j, Polynomial.aeval g (p j) * u j = 0 → p = 0) →
      ∀ m : ℕ, LinearIndependent Ω (fun x : Fin (m + 1) × Fin n => g ^ (x.1 : ℕ) * u x.2) := by
    intro g n u hu m
    rw [Fintype.linearIndependent_iff]
    intro c hc x
    set p : Fin n → Polynomial Ω :=
      fun j => ∑ a : Fin (m+1), Polynomial.monomial (a : ℕ) (c (a, j)) with hp
    have hsum : ∑ j, Polynomial.aeval g (p j) * u j = 0 := by
      have e : ∑ j, Polynomial.aeval g (p j) * u j =
          ∑ x : Fin (m + 1) × Fin n, c x • (g ^ (x.1 : ℕ) * u x.2) := by
        rw [Fintype.sum_prod_type, Finset.sum_comm]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        simp only [hp, map_sum, Polynomial.aeval_monomial, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun a _ => ?_)
        rw [Algebra.smul_def, mul_assoc]
      rw [e, hc]
    have h0 := congrFun (hu p hsum) x.2
    have hcoeff := congrArg (fun q => Polynomial.coeff q (x.1 : ℕ)) h0
    simp only [hp, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial, Pi.zero_apply,
      Polynomial.coeff_zero] at hcoeff
    rw [Finset.sum_eq_single x.1] at hcoeff
    · simpa using hcoeff
    · intro b _ hb; rw [if_neg]; exact fun h => hb (Fin.ext h)
    · intro h; exact absurd (Finset.mem_univ _) h
  have hsupp : ∀ h : Kˣ,
      (Function.support (fun i => max 0 (-(w i (Additive.ofMul h))))).Finite := by
    intro h
    refine (hw.2.1 h).subset ?_
    intro i hi h0
    exact hi (by simp [h0])

  have s2 : ∀ (g : Kˣ) (n : ℕ) (u : Fin n → K),
      (∀ m : ℕ, LinearIndependent Ω
        (fun x : Fin (m + 1) × Fin n => (g : K) ^ (x.1 : ℕ) * u x.2)) →
      (n : ℤ) ≤ finsum (fun i => max 0 (-(w i (Additive.ofMul g)))) := by
    intro g n u hlin
    have hu0 : ∀ j, u j ≠ 0 := by
      intro j
      have := (hlin 0).ne_zero (0, j)
      simpa using this
    let U : Fin n → Kˣ := fun j => Units.mk0 (u j) (hu0 j)
    let B : I →₀ ℤ := Finsupp.ofSupportFinite _ (hsupp g)
    let Cj : Fin n → I →₀ ℤ := fun j => Finsupp.ofSupportFinite _ (hsupp (U j))
    let C : I →₀ ℤ := ∑ j, Cj j
    have hB : ∀ i, B i = max 0 (-(w i (Additive.ofMul g))) := fun i => rfl
    have hCj : ∀ j i, Cj j i = max 0 (-(w i (Additive.ofMul (U j)))) := fun _ _ => rfl
    have hC : ∀ i, C i = ∑ j, Cj j i := fun i => Finsupp.finsetSum_apply _ _ _
    have hCnn : ∀ i, 0 ≤ C i := fun i => by
      rw [hC]; exact Finset.sum_nonneg (fun j _ => by rw [hCj]; exact le_max_left _ _)
    have hBnn : ∀ i, 0 ≤ B i := fun i => by rw [hB]; exact le_max_left _ _
    have hPeq : finsum (fun i => max 0 (-(w i (Additive.ofMul g)))) =
        B.sum (fun _ k => k) := by
      rw [Finsupp.sum]
      apply finsum_eq_sum_of_support_subset
      intro i hi
      rw [Finset.mem_coe, Finsupp.mem_support_iff]
      exact hi
    rw [hPeq]
    have hPnn : 0 ≤ B.sum (fun _ k => k) := Finset.sum_nonneg (fun i _ => hBnn i)
    have hcnn : 0 ≤ C.sum (fun _ k => k) := Finset.sum_nonneg (fun i _ => hCnn i)
    obtain ⟨P, hP⟩ : ∃ P, P = B.sum (fun _ k => k) := ⟨_, rfl⟩
    obtain ⟨c, hc⟩ : ∃ c, c = C.sum (fun _ k => k) := ⟨_, rfl⟩
    rw [← hP] at hPnn ⊢
    rw [← hc] at hcnn
    obtain ⟨m, hm⟩ : ∃ m : ℕ, (m : ℤ) = c + 1 := ⟨c.toNat + 1, by push_cast; omega⟩
    let D : I →₀ ℤ := m • B + C
    have hDi : ∀ i, D i = m * B i + C i := fun i => by
      simp [D, nsmul_eq_mul]
    have hD0 : (0 : I →₀ ℤ) ≤ D := by
      rw [Finsupp.le_def]
      intro i
      rw [hDi, Finsupp.coe_zero, Pi.zero_apply]
      have := hBnn i
      have := hCnn i
      positivity
    have hdegD : D.sum (fun _ k => k) = m * P + c := by
      simp only [D]
      rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
        Finsupp.sum_smul_index' (fun _ => rfl), hP, hc]
      simp only [Finsupp.sum, nsmul_eq_mul, Finset.mul_sum]
    have hmem : ∀ x : Fin (m + 1) × Fin n,
        (g : K) ^ (x.1 : ℕ) * u x.2 ∈ wcRRL Ω K I w D := by
      intro x
      have hne : (g : K) ^ (x.1 : ℕ) * u x.2 ≠ 0 :=
        mul_ne_zero (pow_ne_zero _ g.ne_zero) (hu0 _)
      have hunit : Units.mk0 _ hne = g ^ (x.1 : ℕ) * U x.2 := Units.ext (by simp [U])
      apply Submodule.subset_span
      refine ⟨hne, fun i => ?_⟩
      rw [hunit, ofMul_mul, ofMul_pow, map_add, map_nsmul, hDi, nsmul_eq_mul]
      have h1 : B i ≥ -(w i (Additive.ofMul g)) := by rw [hB]; exact le_max_right _ _
      have h2 : Cj x.2 i ≥ -(w i (Additive.ofMul (U x.2))) := by
        rw [hCj]; exact le_max_right _ _
      have h3 : Cj x.2 i ≤ C i := by
        rw [hC]
        exact Finset.single_le_sum (f := fun j => Cj j i)
          (fun j _ => by rw [hCj]; exact le_max_left _ _) (Finset.mem_univ x.2)
      have ha : ((x.1 : ℕ) : ℤ) ≤ m := by have := x.1.isLt; omega
      have h4 : 0 ≤ ((x.1 : ℕ) : ℤ) * (w i (Additive.ofMul g) + B i) :=
        mul_nonneg (by positivity) (by linarith)
      have h5 : 0 ≤ ((m : ℤ) - ((x.1 : ℕ) : ℤ)) * B i := mul_nonneg (by linarith) (hBnn i)
      nlinarith
    let e' : Fin (m + 1) × Fin n → wcRRL Ω K I w D := fun x => ⟨_, hmem x⟩
    have hli : LinearIndependent Ω e' :=
      LinearIndependent.of_comp (wcRRL Ω K I w D).subtype (hlin m)
    haveI := hD.2.1 D
    have hcard := hli.fintype_card_le_finrank
    rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fin] at hcard
    have hup := (hD.2.2 0 D hD0).2
    rw [hD.1, sub_zero, hdegD] at hup
    have hcard' : (((m + 1) * n : ℕ) : ℤ) ≤ (Module.finrank Ω (wcRRL Ω K I w D) : ℤ) := by
      exact_mod_cast hcard
    push_cast at hcard' hup
    by_contra hcon
    push_neg at hcon
    have h6 : P + 1 ≤ (n : ℤ) := by omega
    have h7 : ((m : ℤ) + 1) * (P + 1) ≤ ((m : ℤ) + 1) * n :=
      mul_le_mul_of_nonneg_left h6 (by positivity)
    have h8 : ((m : ℤ) + 1) * (P + 1) ≤ 1 + ((m : ℤ) * P + c) := by linarith
    rw [hm] at h8
    nlinarith

  have s3 : ∀ (g : Kˣ) (m : ℕ) (v : Fin m → K) (p : Fin m → Polynomial Ω), p ≠ 0 →
      ∑ j, Polynomial.aeval (g : K) (p j) * v j = 0 →
      ∃ q : Fin m → Polynomial Ω, q ≠ 0 ∧
        ∑ j, Polynomial.aeval ((g⁻¹ : Kˣ) : K) (q j) * v j = 0 := by
    intro g m v p hp hv
    set N := Finset.univ.sup (fun j => (p j).natDegree) with hN
    letI : Invertible (g : K) := Units.invertible g
    refine ⟨fun j => Polynomial.reflect N (p j), ?_, ?_⟩
    · obtain ⟨j, hj⟩ := Function.ne_iff.mp hp
      intro h
      apply hj
      have := congrFun h j
      simpa [Polynomial.reflect_eq_zero_iff] using this
    · have key : ∀ j, Polynomial.aeval ((g⁻¹ : Kˣ) : K) (Polynomial.reflect N (p j)) *
          (g : K) ^ N = Polynomial.aeval (g : K) (p j) := by
        intro j
        have := Polynomial.eval₂_reflect_mul_pow (algebraMap Ω K) (g : K) N (p j)
          (Finset.le_sup (f := fun j => (p j).natDegree) (Finset.mem_univ j))
        rw [Polynomial.aeval_def, Polynomial.aeval_def]
        exact this
      have hne : (g : K) ^ N ≠ 0 := pow_ne_zero _ g.ne_zero
      have : (∑ j, Polynomial.aeval ((g⁻¹ : Kˣ) : K) (Polynomial.reflect N (p j)) * v j) *
          (g : K) ^ N = 0 := by
        rw [Finset.sum_mul, ← hv]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [← key j]; ring
      exact (mul_eq_zero.mp this).resolve_right hne
  have hinv : ∀ (f : Kˣ) i, w i (Additive.ofMul f⁻¹) = - w i (Additive.ofMul f) := by
    intro f i; rw [ofMul_inv, map_neg]
  intro f
  by_cases hf : (f : K) ∈ Set.range (algebraMap Ω K)
  ·
    obtain ⟨c, hc⟩ := hf
    have h1 := (hw.2.2.2 f).mpr ⟨c, hc⟩
    have h2 := (hw.2.2.2 f⁻¹).mpr ⟨c⁻¹, by rw [map_inv₀, hc, Units.val_inv_eq_inv_val]⟩
    have h0 : ∀ i, w i (Additive.ofMul f) = 0 := fun i => by
      have e1 := h2 i
      rw [hinv] at e1
      have e2 := h1 i
      omega
    simp [h0]
  ·
    obtain ⟨n, ⟨u, hu⟩, hdep⟩ := hA6 (f : K) hf
    have hPf : finsum (fun i => max 0 (-(w i (Additive.ofMul f)))) = n :=
      le_antisymm (hP f n hdep) (s2 f n u (s1 (f : K) n u hu))
    have hu' : ∀ p : Fin n → Polynomial Ω,
        ∑ j, Polynomial.aeval ((f⁻¹ : Kˣ) : K) (p j) * u j = 0 → p = 0 := by
      intro q hq
      by_contra hq0
      obtain ⟨p, hp0, hp⟩ := s3 f⁻¹ n u q hq0 hq
      rw [inv_inv] at hp
      exact hp0 (hu p hp)
    have hdep' : ∀ v : Fin (n + 1) → K, ∃ p : Fin (n + 1) → Polynomial Ω,
        p ≠ 0 ∧ ∑ j, Polynomial.aeval ((f⁻¹ : Kˣ) : K) (p j) * v j = 0 := by
      intro v
      obtain ⟨p, hp0, hp⟩ := hdep v
      exact s3 f (n + 1) v p hp0 hp
    have hPf' : finsum (fun i => max 0 (-(w i (Additive.ofMul f⁻¹)))) = n :=
      le_antisymm (hP f⁻¹ n hdep') (s2 f⁻¹ n u (s1 _ n u hu'))
    have hpt : ∀ i, w i (Additive.ofMul f) =
        max 0 (-(w i (Additive.ofMul f⁻¹))) - max 0 (-(w i (Additive.ofMul f))) := by
      intro i
      rw [hinv, neg_neg]
      rcases le_total 0 (w i (Additive.ofMul f)) with h | h
      · rw [max_eq_right h, max_eq_left (by linarith)]; ring
      · rw [max_eq_left h, max_eq_right (by linarith)]; ring
    rw [finsum_congr hpt, finsum_sub_distrib (hsupp f⁻¹) (hsupp f), hPf, hPf', sub_self]

theorem wc_rr_abstract_large_degree (Ω K I : Type u) [Field Ω] [IsAlgClosed Ω] [Field K]
    [Algebra Ω K] (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w)
    (hA6 : wcRRFinRank Ω K) (hD : wcRRDim Ω K I w) (hP : wcRRPole Ω K I w)
    (h0 : ∀ f : Kˣ, finsum (fun i => w i (Additive.ofMul f)) = 0) :
    ∃ g c : ℕ, ∀ D : I →₀ ℤ, (c : ℤ) ≤ D.sum (fun _ k => k) →
      FiniteDimensional Ω (wcRRL Ω K I w D) ∧
      (Module.finrank Ω (wcRRL Ω K I w D) : ℤ) = D.sum (fun _ k => k) + 1 - g :=
by
  classical
  obtain ⟨deg, hdeg⟩ : ∃ deg : (I →₀ ℤ) →+ ℤ, ∀ D : I →₀ ℤ, D.sum (fun _ k => k) = deg D :=
    ⟨Finsupp.liftAddHom (fun _ => AddMonoidHom.id ℤ), fun D => by
      rw [Finsupp.liftAddHom_apply]; rfl⟩
  obtain ⟨r, hr⟩ : ∃ r : (I →₀ ℤ) → ℤ, ∀ D, r D = (Module.finrank Ω (wcRRL Ω K I w D) : ℤ) :=
    ⟨_, fun _ => rfl⟩
  have hdegsupp : ∀ D : I →₀ ℤ, deg D = ∑ i ∈ D.support, D i := fun D => by
    rw [← hdeg]; rfl
  have hr0 : r 0 = 1 := by rw [hr, hD.1, Nat.cast_one]

  have hmono : ∀ D D' : I →₀ ℤ, D ≤ D' → deg D + 1 - r D ≤ deg D' + 1 - r D' := by
    intro D D' hle
    have h1 := (hD.2.2 D D' hle).2
    rw [hdeg, map_sub, ← hr, ← hr] at h1
    linarith

  have hne : ∀ E : I →₀ ℤ, 0 < r E → ∃ f : Kˣ, ∀ i, 0 ≤ w i (Additive.ofMul f) + E i := by
    intro E hE
    by_contra hcon
    push_neg at hcon
    have hS : {f : K | ∃ hf : f ≠ 0, ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf)) + E i} = ∅ := by
      ext f
      simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
      rintro ⟨hf, hfi⟩
      obtain ⟨i, hi⟩ := hcon (Units.mk0 f hf)
      exact absurd (hfi i) (not_le.mpr hi)
    have hbot : wcRRL Ω K I w E = ⊥ := by unfold wcRRL; rw [hS, Submodule.span_empty]
    rw [hr, hbot, finrank_bot] at hE
    exact lt_irrefl 0 hE

  have htr : ∀ (h : Kˣ) (D : I →₀ ℤ), ∃ D' : I →₀ ℤ,
      (∀ i, D' i = D i + w i (Additive.ofMul h)) ∧ deg D' = deg D ∧ r D' = r D := by
    intro h D
    let T : I →₀ ℤ := Finsupp.ofSupportFinite (fun i => w i (Additive.ofMul h)) (hw.2.1 h)
    have hT : ∀ i, T i = w i (Additive.ofMul h) := fun i => rfl
    have hTdeg : deg T = 0 := by
      have h1 := h0 h
      rw [finsum_eq_sum_of_support_subset (s := T.support)] at h1
      · rw [hdegsupp]; exact h1
      · intro i hi
        rw [Finset.mem_coe, Finsupp.mem_support_iff, hT]
        exact hi
    let φ : K →ₗ[Ω] K := LinearMap.mulLeft Ω ((h⁻¹ : Kˣ) : K)
    have hφ : ∀ x, φ x = ((h⁻¹ : Kˣ) : K) * x := fun x => rfl
    have hinj : Function.Injective φ := by
      intro a b hab
      rw [hφ, hφ] at hab
      exact mul_left_cancel₀ (Units.ne_zero _) hab
    have himg : φ '' {f : K | ∃ hf : f ≠ 0, ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf)) + D i} =
        {f : K | ∃ hf : f ≠ 0, ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf)) + (D + T) i} := by
      ext g
      simp only [Set.mem_image, Set.mem_setOf_eq]
      constructor
      · rintro ⟨f, ⟨hf, hfi⟩, rfl⟩
        have hne' : φ f ≠ 0 := by rw [hφ]; exact mul_ne_zero (Units.ne_zero _) hf
        refine ⟨hne', fun i => ?_⟩
        have hu : Units.mk0 (φ f) hne' = h⁻¹ * Units.mk0 f hf := Units.ext (by
          rw [Units.val_mk0, Units.val_mul, Units.val_mk0, hφ])
        rw [hu, ofMul_mul, map_add, ofMul_inv, map_neg, Finsupp.add_apply, hT]
        linarith [hfi i]
      · rintro ⟨hg, hgi⟩
        have hhg : (h : K) * g ≠ 0 := mul_ne_zero (Units.ne_zero _) hg
        refine ⟨(h : K) * g, ⟨hhg, fun i => ?_⟩, ?_⟩
        · have hu : Units.mk0 ((h : K) * g) hhg = h * Units.mk0 g hg := Units.ext (by
            rw [Units.val_mk0, Units.val_mul, Units.val_mk0])
          rw [hu, ofMul_mul, map_add]
          have := hgi i
          rw [Finsupp.add_apply, hT] at this
          linarith
        · rw [hφ, ← mul_assoc, Units.inv_mul, one_mul]
    have hmap : Submodule.map φ (wcRRL Ω K I w D) = wcRRL Ω K I w (D + T) := by
      unfold wcRRL; rw [Submodule.map_span, himg]
    refine ⟨D + T, fun i => by rw [Finsupp.add_apply, hT], by rw [map_add, hTdeg, add_zero], ?_⟩
    rw [hr, hr, ← hmap]
    exact_mod_cast (LinearEquiv.finrank_eq (Submodule.equivMapOfInjective φ hinj _)).symm

  have hbound : ∃ γ : ℤ, ∀ D : I →₀ ℤ, deg D + 1 - r D ≤ γ := by
    rcases isEmpty_or_nonempty I with hI | ⟨⟨i₀⟩⟩
    · refine ⟨0, fun D => ?_⟩
      have hD0 : D = 0 := Finsupp.ext (fun i => isEmptyElim i)
      rw [hD0, map_zero, hr0]; norm_num
    · obtain ⟨t, ht⟩ := hw.2.2.1 i₀
      have htnc : (t : K) ∉ Set.range (algebraMap Ω K) := by
        rintro ⟨c, hc⟩
        have h1 := (hw.2.2.2 t).mpr ⟨c, hc⟩ i₀
        have h2 := (hw.2.2.2 t⁻¹).mpr ⟨c⁻¹, by rw [map_inv₀, hc, Units.val_inv_eq_inv_val]⟩ i₀
        rw [ofMul_inv, map_neg] at h2
        omega
      obtain ⟨j₀, hj₀⟩ : ∃ j, w j (Additive.ofMul t) < 0 := by
        by_contra hcon
        push_neg at hcon
        exact htnc ((hw.2.2.2 t).mp hcon)
      obtain ⟨n, ⟨u, hu⟩, hdep⟩ := hA6 (t : K) htnc
      have hPn := hP t n hdep
      have hfinB : ∀ v : Kˣ,
          (Function.support (fun i => max 0 (-(w i (Additive.ofMul v))))).Finite := by
        intro v
        refine (hw.2.1 v).subset ?_
        intro i hi
        simp only [Function.mem_support, ne_eq] at hi
        show w i (Additive.ofMul v) ≠ 0
        intro h
        apply hi
        rw [h]; simp
      let Bv : Kˣ → (I →₀ ℤ) := fun v => Finsupp.ofSupportFinite _ (hfinB v)
      have hu0 : ∀ j, u j ≠ 0 := by
        intro j hj
        have h1 := hu (Pi.single j 1) (by
          refine Finset.sum_eq_zero (fun k _ => ?_)
          by_cases hk : k = j
          · subst hk; simp [hj]
          · simp [hk])
        have h2 := congrFun h1 j
        simp at h2
      let U : Fin n → Kˣ := fun j => Units.mk0 (u j) (hu0 j)
      let B : I →₀ ℤ := Bv t
      let C : I →₀ ℤ := ∑ j : Fin n, Bv (U j)
      have hC : ∀ i, C i = ∑ j : Fin n, Bv (U j) i := fun i => Finsupp.finset_sum_apply _ _ _
      have hBnn : ∀ i, 0 ≤ B i := fun i => le_max_left _ _
      have hCnn : ∀ i, 0 ≤ C i := fun i => by
        rw [hC]; exact Finset.sum_nonneg (fun j _ => le_max_left _ _)
      have hCge : ∀ i j, Bv (U j) i ≤ C i := fun i j => by
        rw [hC]
        exact Finset.single_le_sum (f := fun j => Bv (U j) i) (fun j _ => le_max_left _ _)
          (Finset.mem_univ j)

      have hlb : ∀ m : ℕ, (((m + 1) * n : ℕ) : ℤ) ≤ r (m • B + C) := by
        intro m
        let v : Fin (m + 1) × Fin n → K := fun x => (t : K) ^ (x.1 : ℕ) * u x.2
        have hvmem : ∀ x, v x ∈ {f : K | ∃ hf : f ≠ 0,
            ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 f hf)) + (m • B + C) i} := by
          rintro ⟨a, j⟩
          have hv0 : (t : K) ^ (a : ℕ) * u j ≠ 0 :=
            mul_ne_zero (pow_ne_zero _ (Units.ne_zero _)) (hu0 j)
          refine ⟨hv0, fun i => ?_⟩
          have hunit : Units.mk0 ((t : K) ^ (a : ℕ) * u j) hv0 = t ^ (a : ℕ) * U j :=
            Units.ext (by simp [U])
          change 0 ≤ w i (Additive.ofMul (Units.mk0 ((t : K) ^ (a : ℕ) * u j) hv0)) + (m • B + C) i
          rw [hunit, ofMul_mul, map_add, ofMul_pow, map_nsmul, Finsupp.add_apply,
            Finsupp.smul_apply, nsmul_eq_mul, nsmul_eq_mul]
          have ha : (a : ℕ) ≤ m := Nat.lt_succ_iff.mp a.isLt
          have ha' : ((a : ℕ) : ℤ) ≤ (m : ℤ) := by exact_mod_cast ha
          have hb1 : -(w i (Additive.ofMul t)) ≤ B i := le_max_right _ _
          have hc1 : -(w i (Additive.ofMul (U j))) ≤ C i := (le_max_right _ _).trans (hCge i j)
          have e1 : 0 ≤ ((a : ℕ) : ℤ) * (w i (Additive.ofMul t) + B i) :=
            mul_nonneg (by positivity) (by linarith)
          have e2 : 0 ≤ ((m : ℤ) - ((a : ℕ) : ℤ)) * B i := mul_nonneg (by linarith) (hBnn i)
          nlinarith [e1, e2, hc1]
        have hli : LinearIndependent Ω v := by
          rw [Fintype.linearIndependent_iff]
          intro g hg
          let p : Fin n → Polynomial Ω :=
            fun j => ∑ a : Fin (m + 1), Polynomial.monomial (a : ℕ) (g (a, j))
          have key : ∑ j, Polynomial.aeval (t : K) (p j) * u j = ∑ x, g x • v x := by
            rw [Fintype.sum_prod_type, Finset.sum_comm]
            refine Finset.sum_congr rfl (fun j _ => ?_)
            simp only [p, v, map_sum, Polynomial.aeval_monomial, Finset.sum_mul]
            refine Finset.sum_congr rfl (fun a _ => ?_)
            rw [Algebra.smul_def, mul_assoc]
          have hp0 := hu p (by rw [key, hg])
          rintro ⟨a, j⟩
          have h1 := congrArg (fun q : Fin n → Polynomial Ω => (q j).coeff (a : ℕ)) hp0
          simp only [p, Polynomial.finset_sum_coeff, Polynomial.coeff_monomial, Pi.zero_apply,
            Polynomial.coeff_zero] at h1
          rw [Finset.sum_eq_single a] at h1
          · simpa using h1
          · intro b _ hb
            rw [if_neg]
            intro hab
            exact hb (Fin.ext hab)
          · intro h; exact absurd (Finset.mem_univ a) h
        have hfd := hD.2.1 (m • B + C)
        have hle : Submodule.span Ω (Set.range v) ≤ wcRRL Ω K I w (m • B + C) :=
          Submodule.span_mono (Set.range_subset_iff.mpr hvmem)
        have h1 := Submodule.finrank_mono hle
        rw [finrank_span_eq_card hli, Fintype.card_prod, Fintype.card_fin, Fintype.card_fin] at h1
        rw [hr]
        exact_mod_cast h1
      have hdegB_eq : deg B = finsum (fun i => max 0 (-(w i (Additive.ofMul t)))) := by
        rw [finsum_eq_sum_of_support_subset (s := B.support), hdegsupp]
        · rfl
        · intro i hi
          rw [Finset.mem_coe, Finsupp.mem_support_iff]
          exact hi
      have hβn : deg B ≤ n := by rw [hdegB_eq]; exact hPn
      have hβ1 : 1 ≤ deg B := by
        have hj : B j₀ = -(w j₀ (Additive.ofMul t)) := by
          show max 0 (-(w j₀ (Additive.ofMul t))) = _
          exact max_eq_right (by linarith)
        have hmem : j₀ ∈ B.support := by
          rw [Finsupp.mem_support_iff, hj]; linarith
        rw [hdegsupp]
        have := Finset.single_le_sum (f := fun i => B i) (fun i _ => hBnn i) hmem
        linarith
      have hmult : ∀ m : ℕ, deg (m • B) + 1 - r (m • B) ≤ 1 - n + deg C := by
        intro m
        have hle : m • B ≤ m • B + C := Finsupp.le_def.mpr (fun i => by
          rw [Finsupp.add_apply]; linarith [hCnn i])
        have h1 := (hD.2.2 _ _ hle).2
        rw [hdeg, add_sub_cancel_left, ← hr, ← hr] at h1
        have h2 := hlb m
        rw [map_nsmul, nsmul_eq_mul]
        push_cast at h2
        have h3 : (m : ℤ) * deg B ≤ (m : ℤ) * n := mul_le_mul_of_nonneg_left hβn (by positivity)
        nlinarith
      refine ⟨1 - n + deg C, fun D => ?_⟩
      let A : I →₀ ℤ := Finsupp.mapRange (fun k => max k 0) (by simp) D
      have hA : ∀ i, A i = max (D i) 0 := fun i => Finsupp.mapRange_apply
      have hDA : D ≤ A := Finsupp.le_def.mpr (fun i => by rw [hA]; exact le_max_left _ _)
      have hA0 : ∀ i, 0 ≤ A i := fun i => by rw [hA]; exact le_max_right _ _
      obtain ⟨m, hm⟩ : ∃ m : ℕ, deg A + (1 - n + deg C) ≤ m := ⟨_, Int.self_le_toNat _⟩
      have hmB := hmult m
      rw [map_nsmul, nsmul_eq_mul] at hmB
      have hEle : m • B - A ≤ m • B := Finsupp.le_def.mpr (fun i => by
        rw [Finsupp.sub_apply]; linarith [hA0 i])
      have h1 := (hD.2.2 _ _ hEle).2
      rw [hdeg, sub_sub_cancel, ← hr, ← hr] at h1
      have hmβ : (m : ℤ) ≤ m * deg B := by nlinarith
      have hrE : 0 < r (m • B - A) := by linarith
      obtain ⟨f, hf⟩ := hne _ hrE
      obtain ⟨A', hA'i, hA'deg, hA'r⟩ := htr f⁻¹ A
      have hA'le : A' ≤ m • B := Finsupp.le_def.mpr (fun i => by
        rw [hA'i, ofMul_inv, map_neg]
        have := hf i
        rw [Finsupp.sub_apply] at this
        linarith)
      have e1 := hmono D A hDA
      have e2 := hmono A' (m • B) hA'le
      rw [map_nsmul, nsmul_eq_mul, hA'deg, hA'r] at e2
      linarith

  obtain ⟨γ, hγ⟩ := hbound
  obtain ⟨g₀, ⟨A₀, hA₀⟩, hmax⟩ :=
    Int.exists_greatest_of_bdd (P := fun z => ∃ D : I →₀ ℤ, deg D + 1 - r D = z)
      ⟨γ, fun z ⟨D, hDz⟩ => by rw [← hDz]; exact hγ D⟩ ⟨_, 0, rfl⟩
  have hg₀ : 0 ≤ g₀ := by
    have := hmax _ ⟨0, rfl⟩
    rw [map_zero, hr0] at this
    linarith
  refine ⟨g₀.toNat, (deg A₀ + g₀).toNat, fun D hc => ⟨hD.2.1 D, ?_⟩⟩
  rw [hdeg] at hc ⊢
  rw [Int.toNat_of_nonneg hg₀, ← hr]
  have hc' : deg A₀ + g₀ ≤ deg D := (Int.self_le_toNat _).trans hc
  have hE := hmax _ ⟨D - A₀, rfl⟩
  rw [map_sub] at hE
  obtain ⟨f, hf⟩ := hne (D - A₀) (by linarith)
  obtain ⟨D', hD'i, hD'deg, hD'r⟩ := htr f D
  have hle : A₀ ≤ D' := Finsupp.le_def.mpr (fun i => by
    rw [hD'i]; have := hf i; rw [Finsupp.sub_apply] at this; linarith)
  have e1 := hmono A₀ D' hle
  rw [hD'deg, hD'r, hA₀] at e1
  have e2 := hmax _ ⟨D, rfl⟩
  linarith

theorem wc_curve_true_valuations : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
    ∃ w : {x : X // x ≠ genericPoint X} → Additive (FractionRing Γ(X, U))ˣ →+ ℤ,
      wcValFamily Ω (FractionRing Γ(X, U)) {x : X // x ≠ genericPoint X} w ∧
      Function.Injective w ∧
      (∀ s : {x : X // x ≠ genericPoint X}, s.1 ∈ U →
        ∃ v : IsDedekindDomain.HeightOneSpectrum Γ(X, U),
          (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) = s.1 ∧
          ∀ f : (FractionRing Γ(X, U))ˣ, w s (Additive.ofMul f) =
            FractionalIdeal.count (FractionRing Γ(X, U)) v
              (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U))
                (f : FractionRing Γ(X, U)))) ∧
      (∀ μ : Additive (FractionRing Γ(X, U))ˣ →+ ℤ,
        (∀ a b h : (FractionRing Γ(X, U))ˣ,
          (h : FractionRing Γ(X, U)) = (a : FractionRing Γ(X, U)) + (b : FractionRing Γ(X, U)) →
          min (μ (Additive.ofMul a)) (μ (Additive.ofMul b)) ≤ μ (Additive.ofMul h)) →
        (∃ t, μ t = 1) →
        (∀ (c : Ω) (hc : algebraMap Ω (FractionRing Γ(X, U)) c ≠ 0),
          μ (Additive.ofMul (Units.mk0 _ hc)) = 0) →
        ∃ z, μ = w z) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra

  have s6 : ∀ (G : Type u) [AddCommGroup G] (o μ : G →+ ℤ), (∃ π, o π = 1) → (∃ t, μ t = 1) →
      (∀ m, 0 ≤ o m → 0 ≤ μ m) → μ = o := by
    intro G _ o μ hπ ht hcone
    obtain ⟨π, hπ⟩ := hπ
    obtain ⟨t, ht⟩ := ht
    have hker : ∀ m, o m = 0 → μ m = 0 := by
      intro m hm
      have h1 := hcone m (by omega)
      have h2 := hcone (-m) (by rw [map_neg]; omega)
      rw [map_neg] at h2
      omega
    have hlin : ∀ m, μ m = o m * μ π := by
      intro m
      have := hker (m - (o m) • π) (by rw [map_sub, map_zsmul, hπ, smul_eq_mul, mul_one, sub_self])
      rw [map_sub, map_zsmul, smul_eq_mul, sub_eq_zero] at this
      exact this
    have hc0 : 0 ≤ μ π := hcone π (by rw [hπ]; omega)
    have hc1 : μ π = 1 := Int.eq_one_of_mul_eq_one_left hc0 (by rw [← hlin, ht])
    ext m
    rw [hlin, hc1, mul_one]

  have s5 : ∀ (L : Type u) [Field L] (μ : Additive Lˣ →+ ℤ),
      (∀ a b h : Lˣ, (h : L) = (a : L) + (b : L) →
        min (μ (Additive.ofMul a)) (μ (Additive.ofMul b)) ≤ μ (Additive.ofMul h)) →
      ∃ R : ValuationSubring L, ∀ (g : L) (hg : g ≠ 0),
        g ∈ R ↔ 0 ≤ μ (Additive.ofMul (Units.mk0 g hg)) := by
    intro L _ μ hult
    let ν : L → ℤ := fun g => if hg : g = 0 then 0 else μ (Additive.ofMul (Units.mk0 g hg))
    have hν : ∀ g (hg : g ≠ 0), ν g = μ (Additive.ofMul (Units.mk0 g hg)) :=
      fun g hg => dif_neg hg
    have hmul : ∀ g h (hg : g ≠ 0) (hh : h ≠ 0), ν (g * h) = ν g + ν h := by
      intro g h hg hh
      rw [hν _ (mul_ne_zero hg hh), hν g hg, hν h hh, ← map_add, ← ofMul_mul]
      congr 2
      ext
      simp
    have hone : ν 1 = 0 := by
      rw [hν 1 one_ne_zero]
      have : Units.mk0 (1 : L) one_ne_zero = 1 := by ext; simp
      rw [this, ofMul_one, map_zero]
    have hm1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
    have hnegone : ν (-1) = 0 := by
      have h := hmul (-1) (-1) hm1 hm1
      rw [neg_one_mul, neg_neg, hone] at h
      omega
    have hinv : ∀ g (hg : g ≠ 0), ν g⁻¹ = - ν g := by
      intro g hg
      have h := hmul g g⁻¹ hg (inv_ne_zero hg)
      rw [mul_inv_cancel₀ hg, hone] at h
      omega
    let S : Subring L :=
      { carrier := {g | g = 0 ∨ 0 ≤ ν g}
        mul_mem' := by
          intro a b ha hb
          by_cases ha0 : a = 0
          · left; simp [ha0]
          by_cases hb0 : b = 0
          · left; simp [hb0]
          right
          rcases ha with ha | ha
          · exact absurd ha ha0
          rcases hb with hb | hb
          · exact absurd hb hb0
          rw [hmul a b ha0 hb0]; omega
        one_mem' := Or.inr (by rw [hone])
        add_mem' := by
          intro a b ha hb
          by_cases ha0 : a = 0
          · rw [ha0, zero_add]; exact hb
          by_cases hb0 : b = 0
          · rw [hb0, add_zero]; exact ha
          by_cases hab : a + b = 0
          · left; exact hab
          right
          rcases ha with ha | ha
          · exact absurd ha ha0
          rcases hb with hb | hb
          · exact absurd hb hb0
          have := hult (Units.mk0 a ha0) (Units.mk0 b hb0) (Units.mk0 (a + b) hab) (by simp)
          rw [hν a ha0] at ha
          rw [hν b hb0] at hb
          rw [hν _ hab]
          exact le_trans (le_min ha hb) this
        zero_mem' := Or.inl rfl
        neg_mem' := by
          intro a ha
          by_cases ha0 : a = 0
          · left; simp [ha0]
          right
          rcases ha with ha | ha
          · exact absurd ha ha0
          rw [show -a = -1 * a by ring, hmul (-1) a hm1 ha0, hnegone]; omega }
    refine ⟨⟨S, fun x => ?_⟩, fun g hg => ?_⟩
    · by_cases hx : x = 0
      · left; exact Or.inl hx
      rcases le_total 0 (ν x) with h | h
      · left; exact Or.inr h
      · right; right; rw [hinv x hx]; omega
    · show g = 0 ∨ 0 ≤ ν g ↔ _
      rw [hν g hg]
      constructor
      · rintro (h | h)
        · exact absurd h hg
        · exact h
      · exact Or.inr

  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X

  have s4 : ∀ (R : ValuationSubring X.functionField),
      (∀ c : Ω, (X.presheaf.germ ⊤ (genericPoint X) trivial).hom
        (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c)) ∈ R) →
      (∃ g : X.functionField, g ∉ R) →
      ∃ z : X, z ≠ genericPoint X ∧
        ∀ r : X.presheaf.stalk z, algebraMap (X.presheaf.stalk z) X.functionField r ∈ R := by
    intro R hc hg
    have hF : ∀ y : X, X.fromSpecStalk y ≫ fX = Spec.map ((Scheme.ΓSpecIso (.of Ω)).inv ≫
        fX.appTop ≫ X.presheaf.germ ⊤ y trivial) := by
      intro y
      have h1 := Scheme.toSpecΓ_naturality fX
      have h2 : (Spec (CommRingCat.of Ω)).toSpecΓ = Spec.map (Scheme.ΓSpecIso (.of Ω)).hom := by
        rw [← Scheme.isoSpec_hom, Scheme.isoSpec_Spec_hom]
      have h3 : fX = X.toSpecΓ ≫ Spec.map fX.appTop ≫ Spec.map (Scheme.ΓSpecIso (.of Ω)).inv := by
        rw [← Category.assoc, ← h1, h2, Category.assoc, ← Spec.map_comp, Iso.inv_hom_id,
          Spec.map_id, Category.comp_id]
      calc X.fromSpecStalk y ≫ fX
          = X.fromSpecStalk y ≫ (X.toSpecΓ ≫ Spec.map fX.appTop ≫
              Spec.map (Scheme.ΓSpecIso (.of Ω)).inv) := congrArg _ h3
        _ = _ := by
          rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ, ← Spec.map_comp, ← Spec.map_comp,
            Category.assoc]
    let κ : Ω →+* X.functionField := ((Scheme.ΓSpecIso (.of Ω)).inv ≫
        fX.appTop ≫ X.presheaf.germ ⊤ (genericPoint X) trivial).hom
    let ψ : Ω →+* R := κ.codRestrict R hc
    have hcomm : X.fromSpecStalk (genericPoint X) ≫ fX =
        Spec.map (CommRingCat.ofHom (algebraMap R X.functionField)) ≫
          Spec.map (CommRingCat.ofHom ψ) := by
      rw [hF, ← Spec.map_comp]
      congr 1
    have hVC : ValuativeCriterion fX :=
      (IsProper.eq_valuativeCriterion ▸ (inferInstance : IsProper fX)).1.1.1
    let S₀ : ValuativeCommSq fX :=
      { R := R, K := X.functionField, i₁ := X.fromSpecStalk (genericPoint X),
        i₂ := Spec.map (CommRingCat.ofHom ψ), commSq := ⟨hcomm⟩ }
    obtain ⟨l, hl⟩ : ∃ l : Spec (CommRingCat.of R) ⟶ X,
        Spec.map (CommRingCat.ofHom (algebraMap R X.functionField)) ≫ l =
          X.fromSpecStalk (genericPoint X) := by
      haveI := ValuativeCriterion.existence hVC S₀
      exact ⟨S₀.commSq.lift, S₀.commSq.fac_left⟩
    have key : Scheme.stalkClosedPointTo l ≫ CommRingCat.ofHom (algebraMap R X.functionField) =
        X.presheaf.stalkSpecializes (genericPoint_specializes _) := by
      rw [← Spec.map_inj, Spec.map_comp, ← cancel_mono (X.fromSpecStalk _), Category.assoc,
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hl,
        Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
    have hcont : ∀ r : X.presheaf.stalk (l (IsLocalRing.closedPoint (CommRingCat.of R))),
        algebraMap (X.presheaf.stalk _) X.functionField r ∈ R := by
      intro r
      have h : (CommRingCat.ofHom (algebraMap R X.functionField)).hom
          ((Scheme.stalkClosedPointTo l).hom r) =
          algebraMap (X.presheaf.stalk _) X.functionField r := by
        rw [show (CommRingCat.ofHom (algebraMap R X.functionField)).hom
            ((Scheme.stalkClosedPointTo l).hom r) = (Scheme.stalkClosedPointTo l ≫
              CommRingCat.ofHom (algebraMap R X.functionField)).hom r from rfl, key]
        rfl
      rw [← h]
      exact ((Scheme.stalkClosedPointTo l).hom r).2
    obtain ⟨z, hz⟩ : ∃ z : X, ∀ r : X.presheaf.stalk z,
        algebraMap (X.presheaf.stalk z) X.functionField r ∈ R := ⟨_, hcont⟩
    refine ⟨z, ?_, hz⟩
    rintro rfl
    obtain ⟨g, hgR⟩ := hg
    apply hgR
    have h := hz g
    change (X.presheaf.stalkSpecializes (genericPoint_specializes (genericPoint X))).hom g ∈ R at h
    rw [TopCat.Presheaf.stalkSpecializes_refl] at h
    exact h

  have s3 : ∀ (x x' : X) (hd : IsDomain (X.presheaf.stalk x))
      (hv : ValuationRing (X.presheaf.stalk x)),
      (∀ g : X.functionField,
        (∃ r : X.presheaf.stalk x, algebraMap (X.presheaf.stalk x) X.functionField r = g) ↔
        (∃ r : X.presheaf.stalk x', algebraMap (X.presheaf.stalk x') X.functionField r = g)) →
      x = x' := by
    intro x x' hd hv himg
    haveI := hd
    haveI := hv
    have hinj : ∀ y : X, Function.Injective (algebraMap (X.presheaf.stalk y) X.functionField) :=
      fun y => IsFractionRing.injective _ _
    have hrange : (algebraMap (X.presheaf.stalk x') X.functionField).range =
        (algebraMap (X.presheaf.stalk x) X.functionField).range := by
      ext g
      simp only [RingHom.mem_range]
      exact (himg g).symm
    let e1 := RingEquiv.ofBijective (algebraMap (X.presheaf.stalk x') X.functionField).rangeRestrict
      ⟨fun a b h => hinj x' (congrArg Subtype.val h), RingHom.rangeRestrict_surjective _⟩
    let e2 := RingEquiv.ofBijective (algebraMap (X.presheaf.stalk x) X.functionField).rangeRestrict
      ⟨fun a b h => hinj x (congrArg Subtype.val h), RingHom.rangeRestrict_surjective _⟩
    let e : X.presheaf.stalk x' ≃+* X.presheaf.stalk x :=
      (e1.trans (RingEquiv.subringCongr hrange)).trans e2.symm
    have he : ∀ r', algebraMap (X.presheaf.stalk x) X.functionField (e r') =
        algebraMap (X.presheaf.stalk x') X.functionField r' := by
      intro r'
      have h1 := e2.apply_symm_apply ((RingEquiv.subringCongr hrange) (e1 r'))
      exact congrArg Subtype.val h1
    let ε : X.presheaf.stalk x' ⟶ X.presheaf.stalk x := CommRingCat.ofHom e.toRingHom
    haveI : IsLocalHom ε.hom := ⟨fun a ha => by
      have h1 := ha.map e.symm.toRingHom
      have h2 : e.symm.toRingHom (ε.hom a) = a := e.symm_apply_apply a
      rwa [h2] at h1⟩
    have hεalg : ε ≫ X.presheaf.stalkSpecializes (genericPoint_specializes x) =
        X.presheaf.stalkSpecializes (genericPoint_specializes x') := by
      ext r'
      exact he r'
    have hsq : X.fromSpecStalk (genericPoint X) ≫ fX =
        Spec.map (X.presheaf.stalkSpecializes (genericPoint_specializes x)) ≫
          (X.fromSpecStalk x ≫ fX) := by
      rw [← Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
    let S₀ : ValuativeCommSq fX := @ValuativeCommSq.mk _ _ fX (X.presheaf.stalk x) _ hd hv
      X.functionField _ _ inferInstance (X.fromSpecStalk (genericPoint X))
      (X.fromSpecStalk x ≫ fX) ⟨hsq⟩
    let a : Spec (X.presheaf.stalk x) ⟶ X := X.fromSpecStalk x
    let b : Spec (X.presheaf.stalk x) ⟶ X := Spec.map ε ≫ X.fromSpecStalk x'
    have hal : Spec.map (X.presheaf.stalkSpecializes (genericPoint_specializes x)) ≫ a =
        X.fromSpecStalk (genericPoint X) := Scheme.SpecMap_stalkSpecializes_fromSpecStalk _
    have hbl : Spec.map (X.presheaf.stalkSpecializes (genericPoint_specializes x)) ≫ b =
        X.fromSpecStalk (genericPoint X) := by
      simp only [b]
      rw [← Category.assoc, ← Spec.map_comp, hεalg, Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
    have hbr : b ≫ fX = a ≫ fX := by
      have hA : Spec.map (Spec.preimage (a ≫ fX)) = a ≫ fX := Spec.map_preimage _
      have hB : Spec.map (Spec.preimage (b ≫ fX)) = b ≫ fX := Spec.map_preimage _
      have hcomp : Spec.preimage (a ≫ fX) ≫
          X.presheaf.stalkSpecializes (genericPoint_specializes x) =
          Spec.preimage (b ≫ fX) ≫ X.presheaf.stalkSpecializes (genericPoint_specializes x) := by
        rw [← Spec.map_inj, Spec.map_comp, Spec.map_comp, hA, hB, ← Category.assoc,
          ← Category.assoc, hbl, hal]
      have heq : Spec.preimage (a ≫ fX) = Spec.preimage (b ≫ fX) := by
        ext c
        apply hinj x
        have := congrArg (fun φ => φ.hom c) hcomp
        exact this
      rw [← hA, ← hB, heq]
    have hsub := IsSeparated.valuativeCriterion fX S₀
    let LA : S₀.commSq.LiftStruct := ⟨a, hal, rfl⟩
    let LB : S₀.commSq.LiftStruct := ⟨b, hbl, hbr⟩
    have hab : a = b := congrArg CommSq.LiftStruct.l (Subsingleton.elim LA LB)
    have hx : a (IsLocalRing.closedPoint (X.presheaf.stalk x)) = x :=
      Scheme.fromSpecStalk_closedPoint
    have hx' : b (IsLocalRing.closedPoint (X.presheaf.stalk x)) = x' := by
      have h1 : (Spec.map ε) (IsLocalRing.closedPoint (X.presheaf.stalk x)) =
          IsLocalRing.closedPoint (X.presheaf.stalk x') := Spec_closedPoint
      refine (Scheme.Hom.comp_apply (Spec.map ε) (X.fromSpecStalk x') _).trans ?_
      rw [h1]
      exact Scheme.fromSpecStalk_closedPoint
    rw [← hx, ← hx', hab]

  have hclosed : ∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X) := fun y hy =>
    (wc_curve_points_closed_opens_compact Ω X fX hdim).1 {y} (Set.finite_singleton y)
      (fun h => hy (Set.mem_singleton_iff.mp h).symm)
  have hDVR : ∀ x : X, x ≠ genericPoint X → IsDiscreteValuationRing (X.presheaf.stalk x) :=
    wc_curve_stalk_dvr Ω X fX (fun x => (hnorm x).2) hclosed
  have hP5 := wc_dedekind_affine_points X U hU
  haveI : Nonempty U := ⟨⟨genericPoint X, hP5.1⟩⟩
  obtain ⟨x₀⟩ : Nonempty X := IrreducibleSpace.toNonempty
  haveI : Nonempty (⊤ : X.Opens) := ⟨⟨x₀, trivial⟩⟩
  letI : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  let α := FractionRing.algEquiv Γ(X, U) X.functionField
  let E : Additive (FractionRing Γ(X, U))ˣ ≃+ Additive (X.functionField)ˣ :=
    MulEquiv.toAdditive (Units.mapEquiv α.toMulEquiv)
  have pkg : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
      (K : Type u) [Field K] [Algebra R K] [IsFractionRing R K]
      (w : IsDedekindDomain.HeightOneSpectrum R), ∃ o : Additive Kˣ →+ ℤ,
      (∀ f : Kˣ, o (Additive.ofMul f) =
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K))) ∧
      (∃ f : Kˣ, o (Additive.ofMul f) = 1) ∧
      (∀ f : Kˣ, 0 ≤ o (Additive.ofMul f) ↔ ∃ r : R, algebraMap R K r = (f : K)) ∧
      (∀ f g h : Kˣ, (h : K) = (f : K) + (g : K) →
        min (o (Additive.ofMul f)) (o (Additive.ofMul g)) ≤ o (Additive.ofMul h)) := by
    intro R _ _ _ K _ _ _ w
    have hc_mul : ∀ f g : Kˣ,
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R)
          ((Additive.toMul (Additive.ofMul f + Additive.ofMul g) : Kˣ) : K)) =
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K)) +
        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (g : K)) := by
      intro f g
      rw [toMul_add, toMul_ofMul, toMul_ofMul, Units.val_mul,
        ← FractionalIdeal.spanSingleton_mul_spanSingleton]
      exact FractionalIdeal.count_mul K w
        (FractionalIdeal.spanSingleton_ne_zero_iff.mpr f.ne_zero)
        (FractionalIdeal.spanSingleton_ne_zero_iff.mpr g.ne_zero)
    let o : Additive Kˣ →+ ℤ := AddMonoidHom.mk' (fun m => FractionalIdeal.count K w
      (FractionalIdeal.spanSingleton (nonZeroDivisors R) ((Additive.toMul m : Kˣ) : K)))
      (fun a b => hc_mul (Additive.toMul a) (Additive.toMul b))
