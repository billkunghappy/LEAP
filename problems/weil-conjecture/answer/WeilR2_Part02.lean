    let G : ∀ j : ↥i.1.2 ⊕ ↥i.1.1,
        P (Sum.elim (fun ρ : ↥i.1.2 => ρ.1.1) (fun k : ↥i.1.1 => k.1.1) j) ⟶ P (S i.1.1) :=
