by
  intro Y m K hK
  obtain ⟨η, hη, hnat⟩ := wc_et_free_sheaf_yoneda Y
  let 𝒯 : Type (u+1) := {T : Y.Etale // IsAffine T.left}
  let P : 𝒯 → Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} := fun T =>
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
