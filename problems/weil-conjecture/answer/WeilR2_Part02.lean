      exact mul_comm _ _
    rw [hsum]
    exact map_eq_zero_iff βT βT.injective

  have hιc : ∀ c : Ω, ιd (algebraMap Ω Γ(X, W) c) = wcCurveConst Ω X fX U c := hιconst
  have hιh : ιd hb = (σu : FractionRing Γ(X, U)) * ∑ s, wcCurveConst Ω X fX U (v s) * f s := by
    rw [hhb, map_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [Algebra.smul_def, map_mul, hιc, hhspec]
    ring
  have hc9 := wc_cluster_divisor_reduction (FractionRing Γ(X, U)) X ω M ι (fun j => p j w) σu
    (∑ s, wcCurveConst Ω X fX U (v s) * f s) (ιd hb)
    (fun j => by rw [hσu]; exact hTr _ (hpW j w hwO1)) hιh ((c2' M _).mp (hgmem v))
  have hcard : ∀ r : Fin m, (Finset.univ.filter (fun s => y s = y r)).card =
      (Finset.univ.filter (fun j' => p j' w = p (eι r) w)).card := by
    intro r
    apply Finset.card_equiv eι
    intro s
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact Subtype.ext_iff
  have hmatch : (hb = 0 ∨ ∃ hh : ιd hb ≠ 0, ∀ r : Fin m,
        ((Finset.univ.filter (fun s => y s = y r)).card : ℤ) ≤
          ω' (y r) (Additive.ofMul (Units.mk0 (ιd hb) hh))) ↔
      (ιd hb = 0 ∨ ∃ hu : ιd hb ≠ 0, ∀ j,
        ((Finset.univ.filter (fun j' => p j' w = p j w)).card : ℤ) ≤
          ω (p j w) (Additive.ofMul (Units.mk0 (ιd hb) hu))) := by
    have h0 : hb = 0 ↔ ιd hb = 0 :=
      ⟨fun h => by rw [h, map_zero], fun h => hιinj (by rw [h, map_zero])⟩
    rw [h0]
    refine or_congr Iff.rfl (exists_congr fun hu => ?_)
    constructor
    · intro H j
      have := H (eι.symm j)
      rw [hcard] at this
      change ((Finset.univ.filter (fun j' => p j' w = p (eι (eι.symm j)) w)).card : ℤ) ≤
        ω (p (eι (eι.symm j)) w) (Additive.ofMul (Units.mk0 (ιd hb) hu)) at this
      rw [Equiv.apply_symm_apply] at this
      exact this
    · intro H r
      rw [hcard]
      exact H (eι r)
  exact (c2' _ _).trans (hc9.trans (hmatch.symm.trans (hc8.symm.trans hRHS.symm)))

theorem wc_fixed_pole_newton_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    wcTrueOrd X U ω →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ (a b e c₁ c₂ : ℕ) (M : X →₀ ℤ), M (genericPoint X) = 0 →
    ∀ (n : ℕ) (f : Fin n → FractionRing Γ(X, U)), (∀ s, f s ∈ wcRRSpace Ω X fX U ω M) →
    ∀ w₀ : wcP3 Ω X fX a b e, IsClosed ({w₀} : Set (wcP3 Ω X fX a b e)) →
    ∃ (O : (wcP3 Ω X fX a b e).Opens) (_ : w₀ ∈ O) (k : ℕ)
      (Φ : Fin k → Fin n → Γ(wcP3 Ω X fX a b e, O)),
      ∀ (w : wcP3 Ω X fX a b e) (hw : w ∈ O), IsClosed ({w} : Set (wcP3 Ω X fX a b e)) →
      ∀ v : Fin n → Ω,
        ((∑ s, wcCurveConst Ω X fX U (v s) * f s) ∈ wcRRSpace Ω X fX U ω (M
          - c₁ • wcPowDiv Ω X fX a (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)
              (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
                wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w))
          - c₂ • wcPowDiv Ω X fX b (Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)
              (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
                wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w))
          - wcPowDiv Ω X fX e (Limits.pullback.snd (Limits.pullback.fst (wcPowHom Ω X fX a)
              (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w))) ↔
        ∀ r, ∑ s, ((wcP3 Ω X fX a b e).evaluation O w hw).hom (Φ r s) *
          ((wcP3 Ω X fX a b e).evaluation ⊤ w trivial).hom
            ((Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
                wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
              Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
                wcPowHom Ω X fX a).appTop.hom
              ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (v s))) = 0 :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hω htrue g c hRR a b e c₁ c₂ M hM n f hfM w₀ hw₀c
  classical
  have c2' := wc_rr_space_mem_iff Ω X fX U hU ω hω

  have hKEY : ∀ (T : Scheme.{u}) (gT : T ⟶ Spec (.of Ω)) [LocallyOfFiniteType gT]
      (ι : Type) [Fintype ι] (p : ι → (T ⟶ X)), (∀ j, p j ≫ fX = gT) →
      ∀ w₀ : T, IsClosed ({w₀} : Set T) →
      ∃ (O : T.Opens) (_ : w₀ ∈ O) (k : ℕ) (Φ : Fin k → Fin n → Γ(T, O)),
        ∀ (w : T) (hw : w ∈ O), IsClosed ({w} : Set T) → ∀ v : Fin n → Ω,
          ((∑ s, wcCurveConst Ω X fX U (v s) * f s) ∈
              wcRRSpace Ω X fX U ω (M - ∑ j, Finsupp.single (p j w) (1 : ℤ)) ↔
            ∀ r, ∑ s, (T.evaluation O w hw).hom (Φ r s) *
              (T.evaluation ⊤ w trivial).hom
                (gT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (v s))) = 0) := by
    intro T gT _ ι _ p hp w₀ hw₀

    have hcl : ∀ i : ι, ∃ (O : T.Opens) (_ : w₀ ∈ O) (k : ℕ) (Φ : Fin k → Fin n → Γ(T, O)),
        ∀ (w : T) (hw : w ∈ O), IsClosed ({w} : Set T) → ∀ v : Fin n → Ω,
          ((∑ s, wcCurveConst Ω X fX U (v s) * f s) ∈
              wcRRSpace Ω X fX U ω (M - ∑ j ∈ Finset.univ.filter (fun j => p j w₀ = p i w₀),
                Finsupp.single (p j w) (1 : ℤ)) ↔
            ∀ r, ∑ s, (T.evaluation O w hw).hom (Φ r s) *
              (T.evaluation ⊤ w trivial).hom
                (gT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (v s))) = 0) := by
      intro i
      obtain ⟨O, hO, k, Φ, hΦ⟩ := wc_newton_cluster_chart Ω X fX hnorm hdim
        (wc_curve_etale_chart Ω X fX hnorm hdim) U hU hfin ω hω htrue M hM n f hfM T gT
        {j // p j w₀ = p i w₀} (fun j => p j.1) (fun j => hp j.1) w₀ hw₀
        (fun j j' => j.2.trans j'.2.symm)
      refine ⟨O, hO, k, Φ, fun w hw hwc v => ?_⟩
      have hsum : (∑ j ∈ Finset.univ.filter (fun j => p j w₀ = p i w₀),
            Finsupp.single (p j w) (1 : ℤ)) =
          ∑ j : {j // p j w₀ = p i w₀}, Finsupp.single (p j.1 w) (1 : ℤ) :=
        Finset.sum_subtype _ (fun j => by simp) _
      rw [hsum]
      exact hΦ w hw hwc v

    have hsepO : ∀ i j : ι, ∃ O : T.Opens, w₀ ∈ O ∧
        (p i w₀ ≠ p j w₀ → ∀ w ∈ O, IsClosed ({w} : Set T) → p i w ≠ p j w) := by
      intro i j
      by_cases h : p i w₀ = p j w₀
      · exact ⟨⊤, trivial, fun h' => absurd h h'⟩
      · obtain ⟨O, hO, hO'⟩ :=
          wc_closed_points_separate_open Ω X T fX gT (p i) (p j) (hp i) (hp j) w₀ h
        exact ⟨O, hO, fun _ => hO'⟩
    choose Oc hOc kc Φc hΦc using hcl
    choose Os hOs hOs' using hsepO
    obtain ⟨O, hOdef⟩ : ∃ O : T.Opens,
        (O : Set T) = (⋂ i, (Oc i : Set T)) ∩ ⋂ i, ⋂ j, (Os i j : Set T) :=
      ⟨⟨_, (isOpen_iInter_of_finite fun i => (Oc i).isOpen).inter
        (isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite fun j => (Os i j).isOpen)⟩, rfl⟩
    have hmem : ∀ x, x ∈ O ↔ x ∈ (⋂ i, (Oc i : Set T)) ∩ ⋂ i, ⋂ j, (Os i j : Set T) := by
      intro x
      rw [← hOdef]
      rfl
    have hOc_le : ∀ i, O ≤ Oc i := by
      intro i x hx
      exact Set.mem_iInter.mp ((hmem x).mp hx).1 i
    have hOs_mem : ∀ w ∈ O, ∀ i j, w ∈ Os i j := by
      intro w hw i j
      exact Set.mem_iInter.mp (Set.mem_iInter.mp ((hmem w).mp hw).2 i) j
    have hw₀O : w₀ ∈ O := (hmem w₀).mpr
      ⟨Set.mem_iInter.mpr hOc, Set.mem_iInter.mpr fun i => Set.mem_iInter.mpr fun j => hOs i j⟩
    let eσ := (Fintype.equivFin (Σ i : ι, Fin (kc i))).symm
    refine ⟨O, hw₀O, Fintype.card (Σ i : ι, Fin (kc i)), fun r s =>
      (T.presheaf.map (homOfLE (hOc_le (eσ r).1)).op).hom (Φc (eσ r).1 (eσ r).2 s), ?_⟩
    intro w hw hwc v
    have hev : ∀ (i : ι) (z : Γ(T, Oc i)),
        (T.evaluation O w hw).hom ((T.presheaf.map (homOfLE (hOc_le i)).op).hom z) =
          (T.evaluation (Oc i) w (hOc_le i hw)).hom z := by
      intro i z
      simp [Scheme.evaluation]
    simp only [hev]

    have hRHS : (∀ r : Fin (Fintype.card (Σ i : ι, Fin (kc i))),
          ∑ s, (T.evaluation (Oc (eσ r).1) w (hOc_le (eσ r).1 hw)).hom (Φc (eσ r).1 (eσ r).2 s) *
            (T.evaluation ⊤ w trivial).hom
              (gT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (v s))) = 0) ↔
        ∀ i, ∀ r' : Fin (kc i),
          ∑ s, (T.evaluation (Oc i) w (hOc_le i hw)).hom (Φc i r' s) *
            (T.evaluation ⊤ w trivial).hom
              (gT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (v s))) = 0 := by
      constructor
      · intro h i r'
        have h1 := h (eσ.symm ⟨i, r'⟩)
        rw [Equiv.apply_symm_apply] at h1
        exact h1
      · intro h r
        exact h (eσ r).1 (eσ r).2
    rw [hRHS]

    have hgmem : (∑ s, wcCurveConst Ω X fX U (v s) * f s) ∈ wcRRSpace Ω X fX U ω M := by
      apply Submodule.sum_mem
      intro s _
      exact Submodule.smul_mem _ (v s) (hfM s)
    have hcomb : (∑ s, wcCurveConst Ω X fX U (v s) * f s) ∈
          wcRRSpace Ω X fX U ω (M - ∑ j, Finsupp.single (p j w) (1 : ℤ)) ↔
        ∀ i, (∑ s, wcCurveConst Ω X fX U (v s) * f s) ∈
          wcRRSpace Ω X fX U ω (M - ∑ j ∈ Finset.univ.filter (fun j => p j w₀ = p i w₀),
            Finsupp.single (p j w) (1 : ℤ)) := by
      generalize (∑ s, wcCurveConst Ω X fX U (v s) * f s) = G at hgmem ⊢
      rcases (c2' M G).mp hgmem with h0 | ⟨hg, hgM⟩
      · subst h0
        exact ⟨fun _ _ => (c2' _ 0).mpr (Or.inl rfl), fun _ => (c2' _ 0).mpr (Or.inl rfl)⟩
      · have key : ∀ E : X →₀ ℤ, G ∈ wcRRSpace Ω X fX U ω E ↔
            ∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 G hg)) + E x := by
          intro E
          rw [c2']
          exact ⟨fun h => h.elim (fun h => absurd h hg) (fun ⟨_, h⟩ => h),
            fun h => Or.inr ⟨hg, h⟩⟩
        simp only [key, Finsupp.sub_apply, Finsupp.finsetSum_apply, Finsupp.single_apply]
        constructor
        · intro h i x
          have h1 := h x
          have h2 : (∑ j ∈ Finset.univ.filter (fun j => p j w₀ = p i w₀),
                if p j w = x then (1 : ℤ) else 0) ≤ ∑ j, if p j w = x then (1 : ℤ) else 0 :=
            Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
              (fun j _ _ => by split_ifs <;> norm_num)
          linarith
        · intro h x
          by_cases hx : ∃ i, p i w = x
          · obtain ⟨i, hi⟩ := hx
            have h1 := h i x
            have h2 : (∑ j ∈ Finset.univ.filter (fun j => p j w₀ = p i w₀),
                  if p j w = x then (1 : ℤ) else 0) = ∑ j, if p j w = x then (1 : ℤ) else 0 := by
              apply Finset.sum_filter_of_ne
              intro j _ hj
              have hjx : p j w = x := by
                by_contra hne
                exact hj (if_neg hne)
              by_contra hne
              exact hOs' j i hne w (hOs_mem w hw j i) hwc (hjx.trans hi.symm)
            linarith
          · have h2 : (∑ j, if p j w = x then (1 : ℤ) else 0) = 0 :=
              Finset.sum_eq_zero (fun j _ => if_neg (fun h' => hx ⟨j, h'⟩))
            have h1 := hgM x
            linarith
    exact hcomb.trans (forall_congr' fun i => hΦc i w (hOc_le i hw) hwc v)

  have hpow : ∀ m, LocallyOfFiniteType (wcPowHom Ω X fX m) := by
    intro m
    induction m with
    | zero =>
      show LocallyOfFiniteType (𝟙 (Spec (.of Ω)))
      infer_instance
    | succ m ih =>
      haveI := ih
      show LocallyOfFiniteType (Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowHom Ω X fX m)
      infer_instance
  haveI := hpow a
  haveI := hpow b
  haveI := hpow e
  haveI hLOFT : LocallyOfFiniteType
      (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
        Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a) := inferInstance
  have hcoord : ∀ (m : ℕ) (k : Fin m), wcPowCoord Ω X fX m k ≫ fX = wcPowHom Ω X fX m := by
    intro m
    induction m with
    | zero => intro k; exact k.elim0
    | succ m ih =>
      intro k
      refine Fin.lastCases ?_ (fun i => ?_) k
      · have h1 : wcPowCoord Ω X fX (m + 1) (Fin.last m) =
            Limits.pullback.snd (wcPowHom Ω X fX m) fX := by
          show Fin.lastCases (motive := fun _ => wcPow Ω X fX (m + 1) ⟶ X)
            (Limits.pullback.snd (wcPowHom Ω X fX m) fX)
            (fun i => Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowCoord Ω X fX m i)
            (Fin.last m) = _
          exact Fin.lastCases_last
        rw [h1]
        exact Limits.pullback.condition.symm
      · have h1 : wcPowCoord Ω X fX (m + 1) (Fin.castSucc i) =
            Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowCoord Ω X fX m i := by
          show Fin.lastCases (motive := fun _ => wcPow Ω X fX (m + 1) ⟶ X)
            (Limits.pullback.snd (wcPowHom Ω X fX m) fX)
            (fun i => Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowCoord Ω X fX m i)
            (Fin.castSucc i) = _
          exact Fin.lastCases_castSucc i
        rw [h1]
        exact (Category.assoc _ _ _).trans
          (congrArg (Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ ·) (ih i))
  let pp : ((Fin a × Fin c₁) ⊕ ((Fin b × Fin c₂) ⊕ Fin e)) → (wcP3 Ω X fX a b e ⟶ X) :=
    Sum.elim
      (fun jk => Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
        Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫ wcPowCoord Ω X fX a jk.1)
      (Sum.elim
        (fun jk => Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a)
            (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
          Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫ wcPowCoord Ω X fX b jk.1)
        (fun k => Limits.pullback.snd (Limits.pullback.fst (wcPowHom Ω X fX a)
            (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
          wcPowCoord Ω X fX e k))
  have hp : ∀ j, pp j ≫ fX =
      Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
        Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a := by
    intro j
    rcases j with ⟨k, _⟩ | ⟨k, _⟩ | k
    · simp only [pp, Sum.elim_inl, Category.assoc, hcoord]
    · simp only [pp, Sum.elim_inl, Sum.elim_inr, Category.assoc, hcoord]
      rw [← Limits.pullback.condition]
    · simp only [pp, Sum.elim_inr, Category.assoc, hcoord]
      rw [← Limits.pullback.condition]
  have hprod : ∀ (m c' : ℕ) (F : Fin m → (X →₀ ℤ)), ∑ x : Fin m × Fin c', F x.1 = c' • ∑ k, F k := by
    intro m c' F
    rw [Fintype.sum_prod_type, Finset.smul_sum]
    simp
  have hdiv : ∀ w : wcP3 Ω X fX a b e, (M
          - c₁ • wcPowDiv Ω X fX a (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)
              (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
                wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w))
          - c₂ • wcPowDiv Ω X fX b (Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)
              (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
                wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w))
          - wcPowDiv Ω X fX e (Limits.pullback.snd (Limits.pullback.fst (wcPowHom Ω X fX a)
              (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w)) =
        M - ∑ j, Finsupp.single (pp j w) (1 : ℤ) := by
    intro w
    rw [(wc_pow_coord_facts Ω X fX a _).1, (wc_pow_coord_facts Ω X fX b _).1,
      (wc_pow_coord_facts Ω X fX e _).1, ← hprod a c₁, ← hprod b c₂,
      Fintype.sum_sum_type, Fintype.sum_sum_type]
    simp only [pp, Sum.elim_inl, Sum.elim_inr, Scheme.Hom.comp_apply]
    abel
  obtain ⟨O, hO, k, Φ, hΦ⟩ := hKEY (wcP3 Ω X fX a b e)
    (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
        Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a)
    ((Fin a × Fin c₁) ⊕ ((Fin b × Fin c₂) ⊕ Fin e)) pp hp w₀ hw₀c
  refine ⟨O, hO, k, Φ, fun w hw hwc v => ?_⟩
  rw [hdiv w]
  exact hΦ w hw hwc v

theorem wc_fixed_pole_locus_jacobson_closed : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    wcTrueOrd X U ω →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ (a b e c₁ c₂ : ℕ) (M : X →₀ ℤ), M (genericPoint X) = 0 →
    ∀ w ∈ closure (wcFixedPoleLocus Ω X fX U ω a b e c₁ c₂ M),
      IsClosed ({w} : Set (wcP3 Ω X fX a b e)) →
      w ∈ wcFixedPoleLocus Ω X fX U ω a b e c₁ c₂ M :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hω htrue g c hRR a b e c₁ c₂ M hM w₀ hw₀ hw₀c
  classical
  by_contra hnot

  have hnn : ∀ (m : ℕ) (y : wcPow Ω X fX m) (x : X), 0 ≤ wcPowDiv Ω X fX m y x := by
    intro m
    induction m with
    | zero =>
      intro y x
      have h0 : wcPowDiv Ω X fX 0 y = 0 := rfl
      rw [h0]
      simp
    | succ m ih =>
      intro y x
      have hd : wcPowDiv Ω X fX (m + 1) y =
          wcPowDiv Ω X fX m (Limits.pullback.fst (wcPowHom Ω X fX m) fX y) +
            Finsupp.single (Limits.pullback.snd (wcPowHom Ω X fX m) fX y) 1 := rfl
      rw [hd, Finsupp.add_apply, Finsupp.single_apply]
      have := ih (Limits.pullback.fst (wcPowHom Ω X fX m) fX y) x
      split_ifs <;> omega
  have hle : ∀ (P R E : X →₀ ℤ), (∀ x, 0 ≤ P x) → (∀ x, 0 ≤ R x) → (∀ x, 0 ≤ E x) →
      ∀ x, (M - c₁ • P - c₂ • R - E) x ≤ M x := by
    intro P R E hP hR hE x
    simp only [Finsupp.sub_apply, Finsupp.smul_apply, nsmul_eq_mul]
    have h1 : (0 : ℤ) ≤ (c₁ : ℤ) * P x := mul_nonneg (Nat.cast_nonneg _) (hP x)
    have h2 : (0 : ℤ) ≤ (c₂ : ℤ) * R x := mul_nonneg (Nat.cast_nonneg _) (hR x)
    have h3 := hE x
    linarith

  have hpow : ∀ m, LocallyOfFiniteType (wcPowHom Ω X fX m) := by
    intro m
    induction m with
    | zero =>
      show LocallyOfFiniteType (𝟙 (Spec (.of Ω)))
      infer_instance
    | succ m ih =>
      haveI := ih
      show LocallyOfFiniteType (Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowHom Ω X fX m)
      infer_instance
  haveI := hpow a
  haveI := hpow b
  haveI := hpow e
  haveI hLOFT : LocallyOfFiniteType
      (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
        Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a) := inferInstance

  obtain ⟨n, f, hfM, hfli, hfspan⟩ :=
    wc_fixed_pole_rr_basis Ω X fX hnorm hdim U hU hfin ω hω g c hRR M hM
  obtain ⟨O, hw₀O, k, Φ, hΦ⟩ :=
    wc_fixed_pole_newton_chart Ω X fX hnorm hdim U hU hfin ω hω htrue g c hRR a b e c₁ c₂ M hM
      n f hfM w₀ hw₀c
  have hsurj0 := wc_closed_point_residue_surjective Ω (wcP3 Ω X fX a b e)
    (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
        Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a) w₀ hw₀c

  have hev : ∀ (w : wcP3 Ω X fX a b e) (hw : w ∈ O) (s : Γ(wcP3 Ω X fX a b e, ⊤)),
      ((wcP3 Ω X fX a b e).evaluation O w hw).hom
        (((wcP3 Ω X fX a b e).presheaf.map (homOfLE le_top).op).hom s) =
      ((wcP3 Ω X fX a b e).evaluation ⊤ w trivial).hom s := by
    intro w hw s
    simp [Scheme.evaluation]

  have hinj0 : ∀ x : Fin n → (wcP3 Ω X fX a b e).residueField w₀,
      (Matrix.of fun r s => ((wcP3 Ω X fX a b e).evaluation O w₀ hw₀O).hom (Φ r s)).mulVec x = 0 →
      x = 0 := by
    intro x hx
    choose v hv using fun s => hsurj0 (x s)
    have hxv : x = fun s => ((wcP3 Ω X fX a b e).evaluation ⊤ w₀ trivial).hom
        ((Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
            wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
          Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
            wcPowHom Ω X fX a).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (v s))) :=
      funext fun s => (hv s).symm
    subst hxv
    have hmem := (hΦ w₀ hw₀O hw₀c v).mpr (fun r => congrFun hx r)
    have h0 : ∑ s, wcCurveConst Ω X fX U (v s) * f s = 0 := by
      by_contra hne
      exact hnot ⟨hw₀c, _, hmem, hne⟩
    have hv0 := hfli v h0
    subst hv0
    funext s
    simp

  have hker : LinearMap.ker (Matrix.toLin'
      (Matrix.of fun r s => ((wcP3 Ω X fX a b e).evaluation O w₀ hw₀O).hom (Φ r s))) = ⊥ :=
    LinearMap.ker_eq_bot'.mpr (fun m hm => hinj0 m (by rwa [Matrix.toLin'_apply] at hm))
  obtain ⟨G, hG⟩ := LinearMap.exists_leftInverse_of_injective _ hker
  have hBA : LinearMap.toMatrix' G *
      (Matrix.of fun r s => ((wcP3 Ω X fX a b e).evaluation O w₀ hw₀O).hom (Φ r s)) = 1 := by
    rw [← LinearMap.toMatrix'_toLin'
      (Matrix.of fun r s => ((wcP3 Ω X fX a b e).evaluation O w₀ hw₀O).hom (Φ r s)),
      ← LinearMap.toMatrix'_comp, hG, LinearMap.toMatrix'_id]
  choose bb hbb using fun i j => hsurj0 (LinearMap.toMatrix' G i j)

  let κO : Ω →+* Γ(wcP3 Ω X fX a b e, O) :=
    ((wcP3 Ω X fX a b e).presheaf.map (homOfLE le_top).op).hom.comp
      ((Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
        Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
          wcPowHom Ω X fX a).appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)
  let μ : Γ(wcP3 Ω X fX a b e, O) :=
    ((Matrix.of fun i j => κO (bb i j)) * Matrix.of Φ).det
  have hμ : ∀ (w : wcP3 Ω X fX a b e) (hw : w ∈ O),
      ((wcP3 Ω X fX a b e).evaluation O w hw).hom μ =
        ((Matrix.of fun i j => ((wcP3 Ω X fX a b e).evaluation ⊤ w trivial).hom
          ((Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
              wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
            Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
              wcPowHom Ω X fX a).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (bb i j)))) *
          (Matrix.of fun r s => ((wcP3 Ω X fX a b e).evaluation O w hw).hom (Φ r s))).det := by
    intro w hw
    rw [RingHom.map_det, RingHom.mapMatrix_apply, Matrix.map_mul]
    congr 2
    · ext i j
      simp only [Matrix.map_apply, Matrix.of_apply, κO, RingHom.comp_apply]
      exact hev w hw _
  have hμ0 : ((wcP3 Ω X fX a b e).evaluation O w₀ hw₀O).hom μ ≠ 0 := by
    rw [hμ w₀ hw₀O]
    have hB : (Matrix.of fun i j => ((wcP3 Ω X fX a b e).evaluation ⊤ w₀ trivial).hom
          ((Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
              wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
            Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
              wcPowHom Ω X fX a).appTop.hom
            ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (bb i j)))) =
        LinearMap.toMatrix' G := by
      ext i j
      exact hbb i j
    rw [hB, hBA, Matrix.det_one]
    exact one_ne_zero
  have hw₀B : w₀ ∈ (wcP3 Ω X fX a b e).basicOpen μ :=
    ((wcP3 Ω X fX a b e).evaluation_ne_zero_iff_mem_basicOpen w₀ hw₀O μ).mp hμ0

  obtain ⟨w, hwB, hwΛ⟩ := mem_closure_iff.mp hw₀ _ ((wcP3 Ω X fX a b e).basicOpen μ).isOpen hw₀B
  have hwO : w ∈ O := (wcP3 Ω X fX a b e).basicOpen_le μ hwB
  obtain ⟨hwc, h, hhmem, hh0⟩ := hwΛ
  obtain ⟨v, rfl⟩ := hfspan _ (hle _ _ _ (hnn a _) (hnn b _) (hnn e _)) h hhmem
  have hA := (hΦ w hwO hwc v).mp hhmem
  have hμw : ((wcP3 Ω X fX a b e).evaluation O w hwO).hom μ ≠ 0 :=
    ((wcP3 Ω X fX a b e).evaluation_ne_zero_iff_mem_basicOpen w hwO μ).mpr hwB
  rw [hμ w hwO] at hμw
  have hx := Matrix.eq_zero_of_mulVec_eq_zero hμw (v := fun s =>
      ((wcP3 Ω X fX a b e).evaluation ⊤ w trivial).hom
        ((Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
            wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
          Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
            wcPowHom Ω X fX a).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (v s))))
    (by
      rw [← Matrix.mulVec_mulVec]
      have hz : (Matrix.of fun r s => ((wcP3 Ω X fX a b e).evaluation O w hwO).hom (Φ r s)).mulVec
          (fun s => ((wcP3 Ω X fX a b e).evaluation ⊤ w trivial).hom
            ((Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
                wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
              Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
                wcPowHom Ω X fX a).appTop.hom
              ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (v s)))) = 0 :=
        funext fun r => hA r
      rw [hz, Matrix.mulVec_zero])
  have hv0 : v = 0 := by
    funext s
    have hs := congrFun hx s
    let φ : Ω →+* (wcP3 Ω X fX a b e).residueField w :=
      ((wcP3 Ω X fX a b e).evaluation ⊤ w trivial).hom.comp
        ((Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
            wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
          Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
            wcPowHom Ω X fX a).appTop.hom.comp
          (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)
    have hφ : φ (v s) = φ 0 := by
      rw [map_zero]
      exact hs
    exact φ.injective hφ
  apply hh0
  rw [hv0]
  simp

theorem wc_incidence_aux_divisor_criterion : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ (a b : ℕ) (α β : ℤ) (B : X →₀ ℤ), B (genericPoint X) = 0 →
    ∃ (e : ℕ) (M₁ M₂ : X →₀ ℤ), M₁ (genericPoint X) = 0 ∧ M₂ (genericPoint X) = 0 ∧
      ∀ P R : X →₀ ℤ, P (genericPoint X) = 0 → R (genericPoint X) = 0 →
        (∀ x, 0 ≤ P x) → (∀ x, 0 ≤ R x) →
        P.sum (fun _ k => k) = (a : ℤ) → R.sum (fun _ k => k) = (b : ℤ) →
        ((∃ h : (FractionRing Γ(X, U))ˣ, ∀ x : X,
            α * P x + β * R x + B x + ω x (Additive.ofMul h) = 0) ↔
          ∃ E : X →₀ ℤ, E (genericPoint X) = 0 ∧ (∀ x, 0 ≤ E x) ∧
            E.sum (fun _ k => k) = (e : ℤ) ∧
            (∃ f : FractionRing Γ(X, U),
              f ∈ wcRRSpace Ω X fX U ω (M₁ - α.toNat • P - β.toNat • R - E) ∧ f ≠ 0) ∧
            (∃ f : FractionRing Γ(X, U),
              f ∈ wcRRSpace Ω X fX U ω (M₂ - (-α).toNat • P - (-β).toNat • R - E) ∧ f ≠ 0)) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hω g c hRR a b α β B hBη
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra

  obtain ⟨Q₀, hQ₀⟩ : ∃ Q₀ : X, Q₀ ≠ genericPoint X := by
    by_contra hno
    push_neg at hno
    haveI : Subsingleton X := ⟨fun x y => (hno x).trans (hno y).symm⟩
    haveI : DiscreteTopology X := Subsingleton.discreteTopology
    have h2 := topologicalKrullDim_zero_of_discreteTopology X
    rw [hdim] at h2
    have h3 : (1 : ℕ) ≤ 0 := by exact_mod_cast h2
    omega

  let deg : (X →₀ ℤ) →+ ℤ := Finsupp.liftAddHom (fun _ => AddMonoidHom.id ℤ)
  have hdeg : ∀ D : X →₀ ℤ, D.sum (fun _ k => k) = deg D := fun D => by
    simp only [deg, Finsupp.liftAddHom_apply, AddMonoidHom.id_apply]
    rfl
  have hdegs : ∀ (q : X) (n : ℤ), deg (Finsupp.single q n) = n := fun q n => by
    rw [← hdeg, Finsupp.sum_single_index rfl]
  have hnn : ∀ F : X →₀ ℤ, (∀ x, 0 ≤ F x) → 0 ≤ deg F := by
    intro F hF
    rw [← hdeg]
    exact Finset.sum_nonneg (fun x _ => hF x)
  have hz : ∀ F : X →₀ ℤ, (∀ x, 0 ≤ F x) → deg F = 0 → ∀ x, F x = 0 := by
    intro F hF h0 x
    rw [← hdeg] at h0
    by_cases hx : x ∈ F.support
    · exact (Finset.sum_eq_zero_iff_of_nonneg (fun y _ => hF y)).mp h0 x hx
    · exact Finsupp.notMem_support_iff.mp hx

  let dv : (FractionRing Γ(X, U))ˣ → X →₀ ℤ := fun v =>
    Finsupp.ofSupportFinite (fun x => ω x (Additive.ofMul v)) (hω.2.2.1 (Additive.ofMul v))
  have hdv : ∀ v x, dv v x = ω x (Additive.ofMul v) := fun v x => rfl
  have hωmul : ∀ x (p q : (FractionRing Γ(X, U))ˣ), ω x (Additive.ofMul (p * q)) =
      ω x (Additive.ofMul p) + ω x (Additive.ofMul q) := fun x p q => by
    rw [ofMul_mul, map_add]
  have hωinv : ∀ x (p : (FractionRing Γ(X, U))ˣ), ω x (Additive.ofMul p⁻¹) =
      - ω x (Additive.ofMul p) := fun x p => by
    rw [ofMul_inv, map_neg]

  have hW2 : ∀ (D : X →₀ ℤ) (v : (FractionRing Γ(X, U))ˣ),
      (∀ x, 0 ≤ ω x (Additive.ofMul v) + D x) →
      (v : FractionRing Γ(X, U)) ∈ wcRRSpace Ω X fX U ω D := by
    intro D v hv
    unfold wcRRSpace
    apply Submodule.subset_span
    refine ⟨v.ne_zero, fun x => ?_⟩
    rw [Units.mk0_val]
    exact hv x
  have hW1 : ∀ (D : X →₀ ℤ) (f : FractionRing Γ(X, U)), f ∈ wcRRSpace Ω X fX U ω D → f ≠ 0 →
      ∃ v : (FractionRing Γ(X, U))ˣ, ∀ x, 0 ≤ ω x (Additive.ofMul v) + D x := by
    intro D f hf hf0
    by_contra hno
    push_neg at hno
    apply hf0
    have hbot : wcRRSpace Ω X fX U ω D = ⊥ := by
      unfold wcRRSpace
      rw [Submodule.span_eq_bot]
      rintro y ⟨hy, hy'⟩
      obtain ⟨x, hx⟩ := hno (Units.mk0 y hy)
      exact absurd (hy' x) (not_le.mpr hx)
    rw [hbot] at hf
    exact (Submodule.mem_bot Ω).mp hf

  have hdeg0 : ∀ h : (FractionRing Γ(X, U))ˣ, deg (dv h) = 0 := by
    intro h
    let N : ℕ := c + (deg (dv h)).natAbs
    let E : X →₀ ℤ := Finsupp.single Q₀ (N : ℤ)
    have hEη : E (genericPoint X) = 0 := by
      simp only [E, Finsupp.single_apply, if_neg hQ₀]
    have hE'η : (E + dv h) (genericPoint X) = 0 := by
      rw [Finsupp.add_apply, hEη, hdv, hω.1, add_zero]
    have hEdeg : deg E = N := hdegs _ _
    have hE'deg : deg (E + dv h) = N + deg (dv h) := by rw [map_add, hEdeg]
    have hN : (N : ℤ) = c + |deg (dv h)| := by
      simp only [N, Nat.cast_add, Int.natCast_natAbs]
    have h1 := (hRR E hEη (by rw [hdeg, hEdeg, hN]; linarith [abs_nonneg (deg (dv h))])).2
    have h2 := (hRR (E + dv h) hE'η (by
      rw [hdeg, hE'deg, hN]; linarith [neg_abs_le (deg (dv h))])).2
    let φ : FractionRing Γ(X, U) →ₗ[Ω] FractionRing Γ(X, U) :=
      LinearMap.mulLeft Ω ((h⁻¹ : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U))
    have hφ : ∀ y, φ y = ((h⁻¹ : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U)) * y :=
      fun y => rfl
    have hinj : Function.Injective φ := by
      intro p q hpq
      rw [hφ, hφ] at hpq
      exact mul_left_cancel₀ (Units.ne_zero _) hpq
    have hmap : Submodule.map φ (wcRRSpace Ω X fX U ω E) =
        wcRRSpace Ω X fX U ω (E + dv h) := by
      unfold wcRRSpace
      rw [Submodule.map_span]
      congr 1
      ext f
      simp only [Set.mem_image, Set.mem_setOf_eq]
      constructor
      · rintro ⟨f₀, ⟨hf₀, H⟩, rfl⟩
        have hne : φ f₀ ≠ 0 := by
          rw [hφ]; exact mul_ne_zero (Units.ne_zero _) hf₀
        refine ⟨hne, fun x => ?_⟩
        have hk : Units.mk0 (φ f₀) hne = h⁻¹ * Units.mk0 f₀ hf₀ := by
          ext; simp only [Units.val_mk0, Units.val_mul, hφ]
        rw [hk, hωmul, hωinv, Finsupp.add_apply, hdv]
        linarith [H x]
      · rintro ⟨hf, H⟩
        have hne : (h : FractionRing Γ(X, U)) * f ≠ 0 := mul_ne_zero h.ne_zero hf
        refine ⟨(h : FractionRing Γ(X, U)) * f, ⟨hne, fun x => ?_⟩, ?_⟩
        · have hk : Units.mk0 ((h : FractionRing Γ(X, U)) * f) hne = h * Units.mk0 f hf := by
            ext; simp only [Units.val_mk0, Units.val_mul]
          rw [hk, hωmul]
          have := H x
          rw [Finsupp.add_apply, hdv] at this
          linarith
        · rw [hφ, ← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]
    have hfr : Module.finrank Ω (wcRRSpace Ω X fX U ω E) =
        Module.finrank Ω (wcRRSpace Ω X fX U ω (E + dv h)) := by
      rw [← hmap]
      exact LinearEquiv.finrank_eq (Submodule.equivMapOfInjective φ hinj _)
    rw [hdeg, hEdeg] at h1
    rw [hdeg, hE'deg] at h2
    rw [hfr] at h1
    linarith

  have hlarge : ∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ deg D → (g : ℤ) ≤ deg D →
      ∃ v : (FractionRing Γ(X, U))ˣ, ∀ x, 0 ≤ ω x (Additive.ofMul v) + D x := by
    intro D hDη hc hg
    obtain ⟨_, hr⟩ := hRR D hDη (by rw [hdeg]; exact hc)
    rw [hdeg] at hr
    have hpos : 0 < Module.finrank Ω (wcRRSpace Ω X fX U ω D) := by omega
    haveI := Module.nontrivial_of_finrank_pos hpos
    obtain ⟨y, hy⟩ := exists_ne (0 : wcRRSpace Ω X fX U ω D)
    exact hW1 D y.1 y.2 (fun h0 => hy (Subtype.ext h0))
  have hα := Int.toNat_sub_toNat_neg α
  have hβ := Int.toNat_sub_toNat_neg β
  by_cases ht : α * a + β * b + deg B = 0
  ·
    let N : ℕ := α.toNat * a + β.toNat * b + (c + g)
    let G : X →₀ ℤ := Finsupp.single Q₀ (N : ℤ)
    have hGη : G (genericPoint X) = 0 := by
      simp only [G, Finsupp.single_apply, if_neg hQ₀]
    have hGdeg : deg G = N := hdegs _ _
    refine ⟨c + g, G, G + B, hGη, by rw [Finsupp.add_apply, hGη, hBη, add_zero], ?_⟩
    intro P R hPη hRη _ _ hPd hRd
    rw [hdeg] at hPd hRd
    constructor
    · rintro ⟨h, hh⟩
      have hD₀η : (G - α.toNat • P - β.toNat • R) (genericPoint X) = 0 := by
        simp only [Finsupp.sub_apply, Finsupp.smul_apply, hGη, hPη, hRη, smul_zero, sub_zero]
      have hD₀deg : deg (G - α.toNat • P - β.toNat • R) = ((c + g : ℕ) : ℤ) := by
        rw [map_sub, map_sub, map_nsmul, map_nsmul, hGdeg, hPd, hRd]
        simp only [N, nsmul_eq_mul]
        push_cast
        ring
      obtain ⟨v₀, hv₀⟩ := hlarge _ hD₀η (by rw [hD₀deg]; push_cast; omega)
        (by rw [hD₀deg]; push_cast; omega)
      refine ⟨dv v₀ + (G - α.toNat • P - β.toNat • R), ?_, ?_, ?_,
        ⟨(v₀ : FractionRing Γ(X, U)), hW2 _ v₀ ?_, v₀.ne_zero⟩,
        ⟨((h * v₀ : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U)), hW2 _ _ ?_,
          (h * v₀).ne_zero⟩⟩
      · rw [Finsupp.add_apply, hdv, hω.1, hD₀η, add_zero]
      · intro x
        rw [Finsupp.add_apply, hdv]
        exact hv₀ x
      · rw [hdeg, map_add, hdeg0, hD₀deg, zero_add]
      · intro x
        simp only [Finsupp.sub_apply, Finsupp.add_apply, hdv]
        apply le_of_eq
        ring
      · intro x
        have hx := hh x
        simp only [Finsupp.sub_apply, Finsupp.add_apply, Finsupp.smul_apply, nsmul_eq_mul,
          hdv, hωmul]
        apply le_of_eq
        linear_combination (-1 : ℤ) * hx - P x * hα - R x * hβ
    · rintro ⟨E, hEη, hEnn, hEdeg, ⟨f₁, hf₁, hf₁0⟩, ⟨f₂, hf₂, hf₂0⟩⟩
      obtain ⟨v₁, hv₁⟩ := hW1 _ f₁ hf₁ hf₁0
      obtain ⟨v₂, hv₂⟩ := hW1 _ f₂ hf₂ hf₂0
      rw [hdeg] at hEdeg
      have e1 := hz (dv v₁ + (G - α.toNat • P - β.toNat • R - E))
        (fun x => by rw [Finsupp.add_apply, hdv]; exact hv₁ x) (by
          rw [map_add, hdeg0, map_sub, map_sub, map_sub, map_nsmul, map_nsmul, hGdeg, hPd, hRd,
            hEdeg]
          simp only [N, nsmul_eq_mul]
          push_cast
          ring)
      have e2 := hz (dv v₂ + ((G + B) - (-α).toNat • P - (-β).toNat • R - E))
        (fun x => by rw [Finsupp.add_apply, hdv]; exact hv₂ x) (by
          rw [map_add, hdeg0, map_sub, map_sub, map_sub, map_add, map_nsmul, map_nsmul, hGdeg,
            hPd, hRd, hEdeg]
          simp only [N, nsmul_eq_mul]
          push_cast
          linear_combination ht + (a : ℤ) * hα + (b : ℤ) * hβ)
      refine ⟨v₂ * v₁⁻¹, fun x => ?_⟩
      have h1 := e1 x
      have h2 := e2 x
      simp only [Finsupp.add_apply, Finsupp.sub_apply, Finsupp.smul_apply, nsmul_eq_mul, hdv,
        Finsupp.coe_zero, Pi.zero_apply] at h1 h2
      rw [hωmul, hωinv]
      linear_combination h2 - h1 - P x * hα - R x * hβ
  ·
    refine ⟨1, 0, 0, rfl, rfl, ?_⟩
    intro P R hPη hRη _ _ hPd hRd
    rw [hdeg] at hPd hRd
    apply iff_of_false
    · rintro ⟨h, hh⟩
      apply ht
      have hZ : α • P + β • R + B + dv h = 0 := by
        ext x
        simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, hdv, Finsupp.coe_zero,
          Pi.zero_apply]
        exact hh x
      have := congrArg deg hZ
      rw [map_add, map_add, map_add, map_zsmul, map_zsmul, hdeg0, hPd, hRd, map_zero,
        smul_eq_mul, smul_eq_mul] at this
      linarith
    · rintro ⟨E, hEη, hEnn, hEdeg, ⟨f₁, hf₁, hf₁0⟩, -⟩
      obtain ⟨v, hv⟩ := hW1 _ f₁ hf₁ hf₁0
      have hF := hnn (dv v + (0 - α.toNat • P - β.toNat • R - E))
        (fun x => by rw [Finsupp.add_apply, hdv]; exact hv x)
      rw [hdeg] at hEdeg
      rw [map_add, hdeg0, map_sub, map_sub, map_sub, map_zero, map_nsmul, map_nsmul, hPd, hRd,
        hEdeg, nsmul_eq_mul, nsmul_eq_mul] at hF
      have ha : (0 : ℤ) ≤ (α.toNat : ℤ) * a := by positivity
      have hb : (0 : ℤ) ≤ (β.toNat : ℤ) * b := by positivity
      push_cast at hF
      linarith

theorem wc_incidence_locus_jacobson_closed_true : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    wcTrueOrd X U ω →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ (a b : ℕ) (α β : ℤ) (B : X →₀ ℤ), B (genericPoint X) = 0 →
    ∀ z ∈ closure (wcIncSet Ω X fX U ω a b α β B), IsClosed ({z} : Set (wcP2 Ω X fX a b)) →
      z ∈ wcIncSet Ω X fX U ω a b α β B :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hω htrue g c hRR a b α β B hBη z hz hzc
  classical
  obtain ⟨e, M₁, M₂, hM₁, hM₂, hcrit⟩ :=
    wc_incidence_aux_divisor_criterion Ω X fX hnorm hdim U hU hfin ω hω g c hRR a b α β B hBη
  have hgeo := wc_pow_geometry Ω X fX hnorm hdim
  haveI : IsProper (wcPowHom Ω X fX a) := (hgeo a).2.1
  haveI : IsProper (wcPowHom Ω X fX b) := (hgeo b).2.1
  haveI : IsProper (wcPowHom Ω X fX e) := (hgeo e).2.1
  have hcl : ∀ {A B : Scheme.{u}} (f : A ⟶ B) [UniversallyClosed f] (y : A),
      IsClosed ({y} : Set A) → IsClosed ({f y} : Set B) := by
    intro A B f _ y hy
    rw [← Set.image_singleton]
    exact f.isClosedMap _ hy

  have hηnc : ¬ IsClosed ({genericPoint X} : Set X) := by
    intro h
    have h1 : closure ({genericPoint X} : Set X) = Set.univ :=
      isGenericPoint_def.mp (genericPoint_spec X)
    rw [h.closure_eq] at h1
    haveI : Subsingleton X := ⟨fun x y => by
      have hx : x ∈ ({genericPoint X} : Set X) := h1 ▸ Set.mem_univ x
      have hy : y ∈ ({genericPoint X} : Set X) := h1 ▸ Set.mem_univ y
      rw [Set.mem_singleton_iff] at hx hy
      rw [hx, hy]⟩
    haveI : DiscreteTopology X := Subsingleton.discreteTopology
    have h2 := topologicalKrullDim_zero_of_discreteTopology X
    rw [hdim] at h2
    have h3 : (1 : ℕ) ≤ 0 := by exact_mod_cast h2
    omega

  have hdiv : ∀ (m : ℕ) (y : wcPow Ω X fX m), (∀ x, 0 ≤ wcPowDiv Ω X fX m y x) ∧
      (wcPowDiv Ω X fX m y).sum (fun _ k => k) = (m : ℤ) ∧
      (IsClosed ({y} : Set (wcPow Ω X fX m)) → wcPowDiv Ω X fX m y (genericPoint X) = 0) := by
    intro m
    induction m with
    | zero =>
      intro y
      have h0 : wcPowDiv Ω X fX 0 y = 0 := rfl
      rw [h0]
      exact ⟨fun x => by simp, by simp, fun _ => by simp⟩
    | succ m ih =>
      intro y
      haveI : IsProper (wcPowHom Ω X fX m) := (hgeo m).2.1
      obtain ⟨h1, h2, h3⟩ := ih (Limits.pullback.fst (wcPowHom Ω X fX m) fX y)
      have hd : wcPowDiv Ω X fX (m + 1) y =
          wcPowDiv Ω X fX m (Limits.pullback.fst (wcPowHom Ω X fX m) fX y) +
            Finsupp.single (Limits.pullback.snd (wcPowHom Ω X fX m) fX y) 1 := rfl
      rw [hd]
      refine ⟨fun x => ?_, ?_, fun hy => ?_⟩
      · rw [Finsupp.add_apply, Finsupp.single_apply]
        have := h1 x
        split_ifs <;> omega
      · rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
          Finsupp.sum_single_index rfl, h2]
        omega
      · have hfc := hcl (Limits.pullback.fst (wcPowHom Ω X fX m) fX) y hy
        have hsc := hcl (Limits.pullback.snd (wcPowHom Ω X fX m) fX) y hy
        have hne : Limits.pullback.snd (wcPowHom Ω X fX m) fX y ≠ genericPoint X :=
          fun h => hηnc (h ▸ hsc)
        rw [Finsupp.add_apply, h3 hfc, Finsupp.single_apply, if_neg hne, add_zero]
  haveI : CompactSpace (wcP3 Ω X fX a b e) :=
    QuasiCompact.compactSpace_of_compactSpace
      (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
        wcPowHom Ω X fX a) (wcPowHom Ω X fX e) ≫
        Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a)

  have hS5 : ∀ w ∈ wcFixedPoleLocus Ω X fX U ω a b e α.toNat β.toNat M₁ ∩
      wcFixedPoleLocus Ω X fX U ω a b e (-α).toNat (-β).toNat M₂,
      Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
        wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w ∈ wcIncSet Ω X fX U ω a b α β B := by
    intro w hw
    simp only [wcFixedPoleLocus, Set.mem_inter_iff, Set.mem_setOf_eq] at hw
    obtain ⟨⟨hwc, f₁, hf₁, hf₁0⟩, ⟨-, f₂, hf₂, hf₂0⟩⟩ := hw
    have hzc' := hcl (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a)
      (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e)) w hwc
    have hyc := hcl (Limits.pullback.snd (Limits.pullback.fst (wcPowHom Ω X fX a)
      (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e)) w hwc
    have hpc := hcl (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)) _ hzc'
    have hrc := hcl (Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)) _ hzc'
    obtain ⟨hPnn, hPdeg, hPη⟩ := hdiv a _
    obtain ⟨hRnn, hRdeg, hRη⟩ := hdiv b _
    obtain ⟨hEnn, hEdeg, hEη⟩ := hdiv e _
    simp only [wcIncSet, Set.mem_setOf_eq]
    exact ⟨hzc', (hcrit _ _ (hPη hpc) (hRη hrc) hPnn hRnn hPdeg hRdeg).mpr
      ⟨_, hEη hyc, hEnn, hEdeg, ⟨f₁, hf₁, hf₁0⟩, ⟨f₂, hf₂, hf₂0⟩⟩⟩

  have hS4 : wcIncSet Ω X fX U ω a b α β B ⊆
      (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
        wcPowHom Ω X fX a) (wcPowHom Ω X fX e)) ''
        (wcFixedPoleLocus Ω X fX U ω a b e α.toNat β.toNat M₁ ∩
          wcFixedPoleLocus Ω X fX U ω a b e (-α).toNat (-β).toNat M₂) := by
    intro z' hz'
    simp only [wcIncSet, Set.mem_setOf_eq] at hz'
    obtain ⟨hz'c, h, hh⟩ := hz'
    have hpc := hcl (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)) z' hz'c
    have hrc := hcl (Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX b)) z' hz'c
    obtain ⟨hPnn, hPdeg, hPη⟩ :=
      hdiv a (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) z')
    obtain ⟨hRnn, hRdeg, hRη⟩ :=
      hdiv b (Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) z')
    obtain ⟨E, hEη, hEnn, hEdeg, ⟨f₁, hf₁, hf₁0⟩, ⟨f₂, hf₂, hf₂0⟩⟩ :=
      (hcrit _ _ (hPη hpc) (hRη hrc) hPnn hRnn hPdeg hRdeg).mp ⟨h, hh⟩
    obtain ⟨yE, hyEc, hyE⟩ := wc_pow_closed_point_of_effective Ω X fX hdim e E hEη hEnn hEdeg
    obtain ⟨w₀, hw₀1, hw₀2⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a)
      (g := wcPowHom Ω X fX e) z' yE (Subsingleton.elim _ _)
    have hK : IsClosed ((Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a)
        (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e)) ⁻¹' {z'} ∩
        (Limits.pullback.snd (Limits.pullback.fst (wcPowHom Ω X fX a)
        (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e)) ⁻¹' {yE}) :=
      (hz'c.preimage (Scheme.Hom.continuous _)).inter (hyEc.preimage (Scheme.Hom.continuous _))
    obtain ⟨w, ⟨hw1, hw2⟩, hwc⟩ := hK.exists_closed_singleton ⟨w₀, hw₀1, hw₀2⟩
    have hπw : Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a)
        (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w = z' := hw1
    have hρw : Limits.pullback.snd (Limits.pullback.fst (wcPowHom Ω X fX a)
        (wcPowHom Ω X fX b) ≫ wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w = yE := hw2
    refine ⟨w, ?_, hπw⟩
    simp only [wcFixedPoleLocus, Set.mem_inter_iff, Set.mem_setOf_eq]
    rw [hπw, hρw, hyE]
    exact ⟨⟨hwc, f₁, hf₁, hf₁0⟩, ⟨hwc, f₂, hf₂, hf₂0⟩⟩

  have hsub : closure (wcIncSet Ω X fX U ω a b α β B) ⊆
      (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
        wcPowHom Ω X fX a) (wcPowHom Ω X fX e)) ''
        closure (wcFixedPoleLocus Ω X fX U ω a b e α.toNat β.toNat M₁ ∩
          wcFixedPoleLocus Ω X fX U ω a b e (-α).toNat (-β).toNat M₂) :=
    (closure_mono hS4).trans ((Scheme.Hom.isClosedMap _).closure_image_subset _)
  obtain ⟨w', hw'cl, hw'z⟩ := hsub hz
  have hK : IsClosed (closure (wcFixedPoleLocus Ω X fX U ω a b e α.toNat β.toNat M₁ ∩
        wcFixedPoleLocus Ω X fX U ω a b e (-α).toNat (-β).toNat M₂) ∩
      (Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
        wcPowHom Ω X fX a) (wcPowHom Ω X fX e)) ⁻¹' {z}) :=
    isClosed_closure.inter (hzc.preimage (Scheme.Hom.continuous _))
  obtain ⟨w₁, ⟨hw₁cl, hw₁z⟩, hw₁c⟩ := hK.exists_closed_singleton ⟨w', hw'cl, hw'z⟩
  have hw₁1 := wc_fixed_pole_locus_jacobson_closed Ω X fX hnorm hdim U hU hfin ω hω htrue g c hRR
    a b e α.toNat β.toNat M₁ hM₁ w₁ (closure_mono Set.inter_subset_left hw₁cl) hw₁c
  have hw₁2 := wc_fixed_pole_locus_jacobson_closed Ω X fX hnorm hdim U hU hfin ω hω htrue g c hRR
    a b e (-α).toNat (-β).toNat M₂ hM₂ w₁ (closure_mono Set.inter_subset_right hw₁cl) hw₁c
  have hfin' := hS5 w₁ ⟨hw₁1, hw₁2⟩
  have hπ1 : Limits.pullback.fst (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX b) ≫
      wcPowHom Ω X fX a) (wcPowHom Ω X fX e) w₁ = z := hw₁z
  rw [hπ1] at hfin'
  exact hfin'

theorem wc_curve_effective_rep_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (g : ℤ) ≤ D.sum (fun _ k => k) →
      ∃ h : (FractionRing Γ(X, U))ˣ, ∀ x, 0 ≤ D x + ω x (Additive.ofMul h) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hord g c hRR D hDη hDg
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
  obtain ⟨o1, o2, o3, o4, o5, o6⟩ := hord
  have hA6 := wc_curve_function_field_finite_rank Ω X fX hnorm hdim U hU hfin
  have o6' : ∀ f : (FractionRing Γ(X, U))ˣ, (∀ x, 0 ≤ ω x (Additive.ofMul f)) ↔
      ∃ c : Ω, algebraMap Ω (FractionRing Γ(X, U)) c = (f : FractionRing Γ(X, U)) :=
    fun f => o6 f
  let o : {x : X // x ≠ genericPoint X} → Additive (FractionRing Γ(X, U))ˣ →+ ℤ :=
    fun s => ω s.1
  have ho : wcValFamily Ω (FractionRing Γ(X, U)) _ o := by
    refine ⟨fun s a b h hab => o5 s.1 a b h hab, fun f => ?_, fun s => ?_, fun f => ?_⟩
    · exact Set.Finite.preimage (fun a _ b _ h => Subtype.val_injective h)
        (o3 (Additive.ofMul f))
    · obtain ⟨m, hm⟩ := o4 s.1 s.2; exact ⟨Additive.toMul m, hm⟩
    · refine Iff.trans ?_ (o6' f)
      constructor
      · intro h x
        by_cases hx : x = genericPoint X
        · simp [hx, o1]
        · exact h ⟨x, hx⟩
      · intro h s; exact h s.1
  have hRo := wc_rr_residue_trivial Ω _ _ o ho hA6
  have hDo := wc_rr_dimension_step Ω _ _ o ho hRo
  have hspace : ∀ D'' : X →₀ ℤ, D'' (genericPoint X) = 0 → wcRRSpace Ω X fX U ω D'' =
      wcRRL Ω (FractionRing Γ(X, U)) _ o
        (Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) D'') := by
    intro D'' hD''η
    unfold wcRRSpace wcRRL
    congr 1
    ext f
    constructor
    · rintro ⟨hf, h⟩
      exact ⟨hf, fun s => by rw [Finsupp.subtypeDomain_apply]; exact h s.1⟩
    · rintro ⟨hf, h⟩
      refine ⟨hf, fun x => ?_⟩
      by_cases hx : x = genericPoint X
      · simp [hx, o1, hD''η]
      · have := h ⟨x, hx⟩
        rw [Finsupp.subtypeDomain_apply] at this
        exact this
  by_cases hD0 : D = 0
  · refine ⟨1, fun x => ?_⟩
    simp [hD0]
  obtain ⟨Q, hQ⟩ : ∃ Q, Q ∈ D.support := by
    rcases Finset.eq_empty_or_nonempty D.support with h | h
    · exact absurd (Finsupp.support_eq_empty.mp h) hD0
    · exact h
  have hQη : Q ≠ genericPoint X := by
    rintro rfl
    exact Finsupp.mem_support_iff.mp hQ hDη
  obtain ⟨E, hE⟩ : ∃ E : X →₀ ℤ, E = Finsupp.single Q (c : ℤ) := ⟨_, rfl⟩
  have hEη : E (genericPoint X) = 0 := by
    rw [hE, Finsupp.single_apply, if_neg hQη]
  have hEnn : ∀ x, 0 ≤ E x := by
    intro x; rw [hE, Finsupp.single_apply]; split_ifs <;> omega
  have hEsum : E.sum (fun _ k => k) = (c : ℤ) := by
    rw [hE]; exact Finsupp.sum_single_index rfl
  have hEsupp : ∀ x ∈ E.support, x ≠ genericPoint X := by
    intro x hx hxη
    subst hxη
    exact Finsupp.mem_support_iff.mp hx hEη
  have hD'η : (D + E) (genericPoint X) = 0 := by
    rw [Finsupp.add_apply, hDη, hEη, add_zero]
  have hdegD' : (D + E).sum (fun _ k => k) = D.sum (fun _ k => k) + c := by
    rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl), hEsum]
  obtain ⟨-, hrk⟩ := hRR (D + E) hD'η (by rw [hdegD']; omega)
  have hrk' : (Module.finrank Ω (wcRRL Ω (FractionRing Γ(X, U)) _ o
      (Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) (D + E))) : ℤ) =
      D.sum (fun _ k => k) + c + 1 - g := by
    rw [← hspace (D + E) hD'η, ← hdegD']
    exact hrk
  have hle : Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) D ≤
      Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) (D + E) := by
    refine Finsupp.le_def.mpr fun s => ?_
    rw [Finsupp.subtypeDomain_apply, Finsupp.subtypeDomain_apply, Finsupp.add_apply]
    have := hEnn s.1
    omega
  have hdiff : (Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) (D + E) -
      Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) D).sum (fun _ k => k) = c := by
    rw [← Finsupp.subtypeDomain_sub, add_sub_cancel_left]
    exact (Finsupp.sum_subtypeDomain_index (h := fun _ k => k) hEsupp).trans hEsum
  have hstep : (Module.finrank Ω (wcRRL Ω (FractionRing Γ(X, U)) _ o
      (Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) (D + E))) : ℤ) ≤
      Module.finrank Ω (wcRRL Ω (FractionRing Γ(X, U)) _ o
        (Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) D)) + c := by
    have := (hDo.2.2 _ _ hle).2
    rwa [hdiff] at this
  have hpos : 0 < Module.finrank Ω (wcRRL Ω (FractionRing Γ(X, U)) _ o
      (Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) D)) := by
    omega
  have hne : wcRRL Ω (FractionRing Γ(X, U)) _ o
      (Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) D) ≠ ⊥ := by
    intro hbot
    rw [hbot, finrank_bot] at hpos
    exact lt_irrefl 0 hpos
  obtain ⟨f, hfS, -⟩ : ∃ f ∈ {f : FractionRing Γ(X, U) | ∃ hf : f ≠ 0, ∀ s,
      0 ≤ o s (Additive.ofMul (Units.mk0 f hf)) +
        (Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) D) s}, f ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hne (Submodule.span_eq_bot.mpr hcon)
  obtain ⟨hf0, hf⟩ := hfS
  refine ⟨Units.mk0 f hf0, fun x => ?_⟩
  by_cases hx : x = genericPoint X
  · subst hx
    simp [hDη, o1]
  · have := hf ⟨x, hx⟩
    rw [Finsupp.subtypeDomain_apply] at this
    change 0 ≤ ω x (Additive.ofMul (Units.mk0 f hf0)) + D x at this
    omega

theorem wc_curve_principal_degree_zero : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ (h : (FractionRing Γ(X, U))ˣ) (E : X →₀ ℤ), (∀ x, E x = ω x (Additive.ofMul h)) →
      E.sum (fun _ k => k) = 0 :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hord g c hRR h E hE
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
  have hEη : E (genericPoint X) = 0 := by rw [hE]; exact hord.1 _
  by_cases hE0 : E = 0
  · subst hE0; simp
  obtain ⟨Q₀, hQ₀⟩ := Finsupp.support_nonempty_iff.mpr hE0
  have hQη : Q₀ ≠ genericPoint X := by
    rintro rfl
    exact (Finsupp.mem_support_iff.mp hQ₀) hEη
  set n : ℤ := E.sum (fun _ k => k) with hn
  set M : ℤ := (c : ℤ) + |n| with hM
  set D₁ : X →₀ ℤ := Finsupp.single Q₀ M with hD₁
  set D₂ : X →₀ ℤ := D₁ + E with hD₂
  have hD₁η : D₁ (genericPoint X) = 0 := by
    rw [hD₁, Finsupp.single_apply, if_neg hQη]
  have hD₂η : D₂ (genericPoint X) = 0 := by
    rw [hD₂, Finsupp.add_apply, hD₁η, hEη, add_zero]
  have hdeg₁ : D₁.sum (fun _ k => k) = M := by
    rw [hD₁, Finsupp.sum_single_index rfl]
  have hdeg₂ : D₂.sum (fun _ k => k) = M + n := by
    rw [hD₂, Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl), hdeg₁]
  have hc₁ : (c : ℤ) ≤ D₁.sum (fun _ k => k) := by
    rw [hdeg₁, hM]; linarith [abs_nonneg n]
  have hc₂ : (c : ℤ) ≤ D₂.sum (fun _ k => k) := by
    rw [hdeg₂, hM]; linarith [neg_abs_le n]
  have hR₁ := (hRR D₁ hD₁η hc₁).2
  have hR₂ := (hRR D₂ hD₂η hc₂).2
  let φ : FractionRing Γ(X, U) →ₗ[Ω] FractionRing Γ(X, U) :=
    { toFun := fun f => ((h⁻¹ : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U)) * f
      map_add' := fun a b => mul_add _ a b
      map_smul' := fun r a => by
        simp only [Algebra.smul_def, RingHom.id_apply]; ring }
  have hφ : ∀ f, φ f = ((h⁻¹ : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U)) * f :=
    fun f => rfl
  have hinj : Function.Injective φ := by
    intro a b hab
    rw [hφ, hφ] at hab
    exact mul_left_cancel₀ (Units.ne_zero _) hab
  have himg : φ '' {f : FractionRing Γ(X, U) | ∃ hf : f ≠ 0,
      ∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 f hf)) + D₁ x} =
      {f : FractionRing Γ(X, U) | ∃ hf : f ≠ 0,
      ∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 f hf)) + D₂ x} := by
    ext g
    constructor
    · rintro ⟨f, ⟨hf, hfx⟩, rfl⟩
      have hne : φ f ≠ 0 := by rw [hφ]; exact mul_ne_zero (Units.ne_zero _) hf
      refine ⟨hne, fun x => ?_⟩
      have hu : Units.mk0 (φ f) hne = h⁻¹ * Units.mk0 f hf := Units.ext rfl
      rw [hu, ofMul_mul, map_add, ofMul_inv, map_neg, ← hE, hD₂, Finsupp.add_apply]
      have := hfx x
      linarith
    · rintro ⟨hg, hgx⟩
      have hne : (h : FractionRing Γ(X, U)) * g ≠ 0 := mul_ne_zero (Units.ne_zero _) hg
      refine ⟨(h : FractionRing Γ(X, U)) * g, ⟨hne, fun x => ?_⟩, ?_⟩
      · have hu : Units.mk0 ((h : FractionRing Γ(X, U)) * g) hne = h * Units.mk0 g hg :=
          Units.ext rfl
        rw [hu, ofMul_mul, map_add, ← hE]
        have := hgx x
        rw [hD₂, Finsupp.add_apply] at this
        linarith
      · rw [hφ, ← mul_assoc, Units.inv_mul, one_mul]
  have hmap : Submodule.map φ (wcRRSpace Ω X fX U ω D₁) = wcRRSpace Ω X fX U ω D₂ := by
    unfold wcRRSpace
    rw [Submodule.map_span, himg]
  have hfr : Module.finrank Ω (wcRRSpace Ω X fX U ω D₁) =
      Module.finrank Ω (wcRRSpace Ω X fX U ω D₂) := by
    rw [← hmap]
    exact (Submodule.equivMapOfInjective φ hinj _).finrank_eq
  have hfrZ : (Module.finrank Ω (wcRRSpace Ω X fX U ω D₁) : ℤ) =
      (Module.finrank Ω (wcRRSpace Ω X fX U ω D₂) : ℤ) := by
    exact_mod_cast hfr
  have e1 : (Module.finrank Ω (wcRRSpace Ω X fX U ω D₁) : ℤ) = M + 1 - g := by
    rw [← hdeg₁]; exact hR₁
  have e2 : (Module.finrank Ω (wcRRSpace Ω X fX U ω D₂) : ℤ) = M + n + 1 - g := by
    rw [← hdeg₂]; exact hR₂
  linarith

theorem wc_incidence_closure_dim_ge : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    wcTrueOrd X U ω →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ ℓ : ℕ, ℓ.Prime → ∀ Q : X, Q ≠ genericPoint X → ∀ d : ℕ, 1 ≤ d → g ≤ d →
    ((d + (d - g) : ℕ) : WithBot ℕ∞) ≤
      topologicalKrullDim (closure (wcIncSet Ω X fX U ω d d 1 (-(ℓ : ℤ))
        (Finsupp.single Q (((ℓ : ℤ) - 1) * d)))) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hord _htrue g c hRR ℓ _hℓ Q hQ d _hd1 hgd
  classical
  obtain ⟨a, rfl⟩ := Nat.exists_eq_add_of_le' hgd
  have hgeom := wc_pow_geometry Ω X fX hnorm hdim
  haveI hprop : ∀ m, IsProper (wcPowHom Ω X fX m) := fun m => (hgeom m).2.1
  have hclosed := (wc_curve_points_closed_opens_compact Ω X fX hdim).1
  have hcpt : ∀ m, CompactSpace (wcPow Ω X fX m) := fun m =>
    QuasiCompact.compactSpace_of_compactSpace (wcPowHom Ω X fX m)

  have hηnc : ¬ IsClosed ({genericPoint X} : Set X) := by
    intro h
    have huniv : ({genericPoint X} : Set X) = Set.univ := by
      rw [← h.closure_eq]; exact (genericPoint_spec X).def
    haveI : Subsingleton X := ⟨fun x y => by
      have hx : x ∈ ({genericPoint X} : Set X) := huniv ▸ Set.mem_univ x
      have hy : y ∈ ({genericPoint X} : Set X) := huniv ▸ Set.mem_univ y
      rw [Set.mem_singleton_iff] at hx hy
      rw [hx, hy]⟩
    haveI : Subsingleton (TopologicalSpace.IrreducibleCloseds X) := ⟨fun s t => by
      apply TopologicalSpace.IrreducibleCloseds.ext
      rw [Set.Nonempty.eq_univ s.isIrreducible.nonempty,
        Set.Nonempty.eq_univ t.isIrreducible.nonempty]⟩
    have h0 : topologicalKrullDim X ≤ 0 := Order.krullDim_nonpos_of_subsingleton
    rw [hdim] at h0
    exact absurd h0 (by decide)

  have hcimg : ∀ {A B : Scheme.{u}} (f : A ⟶ B) [UniversallyClosed f] (x : A),
      IsClosed ({x} : Set A) → IsClosed ({f x} : Set B) := by
    intro A B f _ x hx
    rw [← Set.image_singleton]
    exact f.isClosedMap _ hx

  have hdiv : ∀ (m : ℕ) (u : wcPow Ω X fX m), (∀ x, 0 ≤ wcPowDiv Ω X fX m u x) ∧
      (wcPowDiv Ω X fX m u).sum (fun _ k => k) = (m : ℤ) ∧
      (IsClosed ({u} : Set (wcPow Ω X fX m)) → wcPowDiv Ω X fX m u (genericPoint X) = 0) := by
    intro m
    induction m with
    | zero =>
      intro u
      have h0 : wcPowDiv Ω X fX 0 u = 0 := rfl
      rw [h0]
      refine ⟨fun x => by simp, by simp, fun _ => by simp⟩
    | succ m ih =>
      intro z
      obtain ⟨h1, h2, h3⟩ := ih (Limits.pullback.fst (wcPowHom Ω X fX m) fX z)
      have hz : wcPowDiv Ω X fX (m + 1) z =
          wcPowDiv Ω X fX m (Limits.pullback.fst (wcPowHom Ω X fX m) fX z) +
            Finsupp.single (Limits.pullback.snd (wcPowHom Ω X fX m) fX z) 1 := rfl
      rw [hz]
      refine ⟨fun x => ?_, ?_, fun hzc => ?_⟩
      · rw [Finsupp.add_apply]
        have e1 := h1 x
        have e2 : 0 ≤ Finsupp.single (Limits.pullback.snd (wcPowHom Ω X fX m) fX z) (1 : ℤ) x := by
          rw [Finsupp.single_apply]; split_ifs <;> omega
        omega
      · rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
          Finsupp.sum_single_index rfl, h2]
        push_cast
        ring
      · haveI : IsProper (wcPowHom Ω X fX m) := hprop m
        have hsnd : IsClosed ({Limits.pullback.snd (wcPowHom Ω X fX m) fX z} : Set X) :=
          hcimg (Limits.pullback.snd (wcPowHom Ω X fX m) fX) z hzc
        have hfst : IsClosed ({Limits.pullback.fst (wcPowHom Ω X fX m) fX z} :
            Set (wcPow Ω X fX m)) := hcimg (Limits.pullback.fst (wcPowHom Ω X fX m) fX) z hzc
        rw [Finsupp.add_apply, h3 hfst, Finsupp.single_apply, if_neg, add_zero]
        intro he
        apply hηnc
        rw [← he]
        exact hsnd

  have hforget : ∀ g' : ℕ, ∃ F : wcPow Ω X fX (a + g') ⟶ wcPow Ω X fX a,
      F ≫ wcPowHom Ω X fX a = wcPowHom Ω X fX (a + g') ∧
      ∀ (u : wcPow Ω X fX a) (P : X →₀ ℤ), IsClosed ({u} : Set (wcPow Ω X fX a)) →
        P (genericPoint X) = 0 → (∀ x, 0 ≤ P x) → P.sum (fun _ k => k) = (g' : ℤ) →
        ∃ z : wcPow Ω X fX (a + g'), IsClosed ({z} : Set (wcPow Ω X fX (a + g'))) ∧
          F z = u ∧ wcPowDiv Ω X fX (a + g') z = wcPowDiv Ω X fX a u + P := by
    intro g'
    induction g' with
    | zero =>
      refine ⟨𝟙 _, Category.id_comp _, fun u P hu hPη hPnn hPdeg => ⟨u, hu, rfl, ?_⟩⟩
      have hP : P = 0 := by
        have h0 : ∑ a ∈ P.support, P a = 0 := by simpa [Finsupp.sum] using hPdeg
        rw [Finset.sum_eq_zero_iff_of_nonneg (fun a _ => hPnn a)] at h0
        ext y
        by_cases hy : y ∈ P.support
        · exact h0 y hy
        · simpa using Finsupp.notMem_support_iff.mp hy
      rw [hP]
      exact (add_zero (wcPowDiv Ω X fX a u)).symm
    | succ g' ih =>
      obtain ⟨F, hF, hlift⟩ := ih
      refine ⟨Limits.pullback.fst (wcPowHom Ω X fX (a + g')) fX ≫ F, ?_, ?_⟩
      · show (Limits.pullback.fst (wcPowHom Ω X fX (a + g')) fX ≫ F) ≫ wcPowHom Ω X fX a =
          Limits.pullback.fst (wcPowHom Ω X fX (a + g')) fX ≫ wcPowHom Ω X fX (a + g')
        rw [Category.assoc, hF]
      · intro u P hu hPη hPnn hPdeg
        have hsum : ∑ y ∈ P.support, P y ≠ 0 := by
          have : ∑ y ∈ P.support, P y = ((g' + 1 : ℕ) : ℤ) := hPdeg
          rw [this]
          omega
        obtain ⟨x, -, hx⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
        have hx1 : 1 ≤ P x := by have := hPnn x; omega
        have hxη : x ≠ genericPoint X := by
          rintro rfl
          omega
        have hxc : IsClosed ({x} : Set X) :=
          hclosed {x} (Set.finite_singleton x) (fun h => hxη (Set.mem_singleton_iff.mp h).symm)
        set P' := P - Finsupp.single x 1 with hP'
        have hP'η : P' (genericPoint X) = 0 := by
          rw [hP', Finsupp.sub_apply, Finsupp.single_apply, if_neg hxη, hPη, sub_zero]
        have hP'nn : ∀ y, 0 ≤ P' y := by
          intro y
          rw [hP', Finsupp.sub_apply, Finsupp.single_apply]
          split_ifs with h
          · subst h; omega
          · have := hPnn y; omega
        have hP'deg : P'.sum (fun _ k => k) = (g' : ℤ) := by
          rw [hP', Finsupp.sum_sub_index (fun _ _ _ => rfl), Finsupp.sum_single_index rfl, hPdeg]
          push_cast
          ring
        obtain ⟨z', hz'c, hFz', hz'D⟩ := hlift u P' hu hP'η hP'nn hP'deg
        obtain ⟨z₀, hz₀1, hz₀2⟩ := Scheme.Pullback.exists_preimage_pullback
          (f := wcPowHom Ω X fX (a + g')) (g := fX) z' x (Subsingleton.elim _ _)
        haveI : CompactSpace ↥(Limits.pullback (wcPowHom Ω X fX (a + g')) fX : Scheme.{u}) :=
          hcpt (a + g' + 1)
        have hC : IsClosed (Limits.pullback.fst (wcPowHom Ω X fX (a + g')) fX ⁻¹' {z'} ∩
            Limits.pullback.snd (wcPowHom Ω X fX (a + g')) fX ⁻¹' {x}) :=
          (hz'c.preimage (Limits.pullback.fst (wcPowHom Ω X fX (a + g')) fX).continuous).inter
            (hxc.preimage (Limits.pullback.snd (wcPowHom Ω X fX (a + g')) fX).continuous)
        obtain ⟨z, ⟨hz1, hz2⟩, hzc⟩ := hC.exists_closed_singleton ⟨z₀, hz₀1, hz₀2⟩
        rw [Set.mem_preimage, Set.mem_singleton_iff] at hz1 hz2
        refine ⟨z, hzc, ?_, ?_⟩
        · refine (Scheme.Hom.comp_apply
            (Limits.pullback.fst (wcPowHom Ω X fX (a + g')) fX) F z).trans ?_
          rw [hz1, hFz']
        · show wcPowDiv Ω X fX (a + g') (Limits.pullback.fst (wcPowHom Ω X fX (a + g')) fX z) +
            Finsupp.single (Limits.pullback.snd (wcPowHom Ω X fX (a + g')) fX z) 1 = _
          rw [hz1, hz2, hz'D, hP', add_assoc, sub_add_cancel]
  obtain ⟨F, hF, hlift⟩ := hforget g

  let Φ : Limits.pullback (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)) ⟶
      Limits.pullback (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) :=
    Limits.pullback.map (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g))
      (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) F (𝟙 _) (𝟙 _)
      (by rw [Category.comp_id, hF]) (by rw [Category.comp_id, Category.id_comp])
  have hΦ1 : Φ ≫ Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) =
      Limits.pullback.fst (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)) ≫ F :=
    Limits.pullback.lift_fst _ _ _
  have hΦ2 : Φ ≫ Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) =
      Limits.pullback.snd (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)) := by
    have := (Limits.pullback.lift_snd _ _ _ :
      Φ ≫ Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) =
        Limits.pullback.snd (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)) ≫ 𝟙 _)
    rw [this, Category.comp_id]
  have hbig : IsPullback (Φ ≫ Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)))
      (Limits.pullback.fst (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)))
      (wcPowHom Ω X fX (a + g)) (F ≫ wcPowHom Ω X fX a) := by
    rw [hΦ2, hF]
    exact (IsPullback.of_hasPullback _ _).flip
  have hPB : IsPullback Φ (Limits.pullback.fst (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)))
      (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g))) F :=
    IsPullback.of_right hbig hΦ1 (IsPullback.of_hasPullback _ _).flip
  have hliftM : ∀ (w : ↥(Limits.pullback (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) : Scheme.{u}))
      (z : wcPow Ω X fX (a + g)),
      Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) w = F z →
      ∃ m : ↥(Limits.pullback (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)) : Scheme.{u}),
        Φ m = w ∧ Limits.pullback.fst (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)) m = z := by
    intro w z hwz
    obtain ⟨p, hp1, hp2⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g))) (g := F) w z hwz
    refine ⟨hPB.isoPullback.inv p, ?_, ?_⟩
    · have h := Scheme.Hom.comp_apply hPB.isoPullback.inv Φ p
      rw [hPB.isoPullback_inv_fst] at h
      rw [← h, hp1]
    · have h := Scheme.Hom.comp_apply hPB.isoPullback.inv
        (Limits.pullback.fst (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g))) p
      rw [hPB.isoPullback_inv_snd] at h
      rw [← h, hp2]

  have hΦs : Φ ≫ (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) ≫
      wcPowHom Ω X fX a) =
      Limits.pullback.fst (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)) ≫
        wcPowHom Ω X fX (a + g) := by
    rw [← Category.assoc, hΦ1, Category.assoc, hF]
  haveI : UniversallyClosed (Φ ≫ (Limits.pullback.fst (wcPowHom Ω X fX a)
      (wcPowHom Ω X fX (a + g)) ≫ wcPowHom Ω X fX a)) := by
    rw [hΦs]; infer_instance
  haveI : UniversallyClosed Φ := UniversallyClosed.of_comp_of_isSeparated Φ
    (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) ≫ wcPowHom Ω X fX a)
  have hΦc : IsClosedMap Φ := Φ.isClosedMap

  let π : ↥(closure (wcIncSet Ω X fX U ω (a + g) (a + g) 1 (-(ℓ : ℤ))
        (Finsupp.single Q (((ℓ : ℤ) - 1) * ((a + g : ℕ) : ℤ))))) →
      ↥(Limits.pullback (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) : Scheme.{u}) :=
    fun t => Φ t.1
  have hπcont : Continuous π := Φ.continuous.comp continuous_subtype_val
  have hπc : IsClosedMap π := hΦc.comp isClosed_closure.isClosedMap_subtype_val

  have hhit : ∀ w : ↥(Limits.pullback (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) : Scheme.{u}),
      IsClosed ({w} : Set _) → ∃ t, π t = w := by
    intro w hw
    have hu : IsClosed ({Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) w} :
        Set (wcPow Ω X fX a)) := hcimg _ w hw
    have hv : IsClosed ({Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) w} :
        Set (wcPow Ω X fX (a + g))) := hcimg _ w hw
    obtain ⟨-, hu2, hu3⟩ := hdiv a (Limits.pullback.fst (wcPowHom Ω X fX a)
      (wcPowHom Ω X fX (a + g)) w)
    obtain ⟨-, hv2, hv3⟩ := hdiv (a + g) (Limits.pullback.snd (wcPowHom Ω X fX a)
      (wcPowHom Ω X fX (a + g)) w)
    have hsm : ∀ V : X →₀ ℤ, ((ℓ : ℤ) • V).sum (fun _ k => k) = (ℓ : ℤ) * V.sum (fun _ k => k) :=
      fun V => by rw [Finsupp.sum_smul_index' (fun _ => rfl), Finsupp.mul_sum]; rfl
    let D : X →₀ ℤ := (ℓ : ℤ) • wcPowDiv Ω X fX (a + g)
        (Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) w) -
      Finsupp.single Q (((ℓ : ℤ) - 1) * ((a + g : ℕ) : ℤ)) -
      wcPowDiv Ω X fX a (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) w)
    have hDη : D (genericPoint X) = 0 := by
      simp only [D, Finsupp.sub_apply, Finsupp.smul_apply, Finsupp.single_apply, if_neg hQ,
        hu3 hu, hv3 hv]
      simp
    have hDdeg : D.sum (fun _ k => k) = (g : ℤ) := by
      simp only [D]
      rw [Finsupp.sum_sub_index (fun _ _ _ => rfl), Finsupp.sum_sub_index (fun _ _ _ => rfl),
        hsm, hv2, hu2, Finsupp.sum_single_index rfl]
      push_cast
      ring
    obtain ⟨h, hh⟩ := wc_curve_effective_rep_exists Ω X fX hnorm hdim U hU hfin ω hord g c hRR
      D hDη (le_of_eq hDdeg.symm)
    let E : X →₀ ℤ := Finsupp.ofSupportFinite (fun x => ω x (Additive.ofMul h))
      (hord.2.2.1 (Additive.ofMul h))
    have hEx : ∀ x, E x = ω x (Additive.ofMul h) := fun x => rfl
    have hE0 := wc_curve_principal_degree_zero Ω X fX hnorm hdim U hU hfin ω hord g c hRR h E hEx
    have hPη : (D + E) (genericPoint X) = 0 := by
      rw [Finsupp.add_apply, hDη, hEx, hord.1, add_zero]
    have hPnn : ∀ x, 0 ≤ (D + E) x := fun x => by rw [Finsupp.add_apply, hEx]; exact hh x
    have hPdeg : (D + E).sum (fun _ k => k) = (g : ℤ) := by
      rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl), hDdeg, hE0, add_zero]
    obtain ⟨z, hzc, hFz, hzD⟩ := hlift _ (D + E) hu hPη hPnn hPdeg
    obtain ⟨m₀, hm₀1, hm₀2⟩ := hliftM w z hFz.symm
    haveI : CompactSpace ↥(Limits.pullback (wcPowHom Ω X fX (a + g))
        (wcPowHom Ω X fX (a + g)) : Scheme.{u}) :=
      QuasiCompact.compactSpace_of_compactSpace
        (Limits.pullback.fst (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)) ≫
          wcPowHom Ω X fX (a + g))
    have hC : IsClosed (Φ ⁻¹' {w} ∩
        Limits.pullback.fst (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)) ⁻¹' {z}) :=
      (hw.preimage Φ.continuous).inter (hzc.preimage
        (Limits.pullback.fst (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g))).continuous)
    obtain ⟨m, ⟨hm1, hm2⟩, hmc⟩ := hC.exists_closed_singleton ⟨m₀, hm₀1, hm₀2⟩
    rw [Set.mem_preimage, Set.mem_singleton_iff] at hm1 hm2
    have hsnd : Limits.pullback.snd (wcPowHom Ω X fX (a + g)) (wcPowHom Ω X fX (a + g)) m =
        Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) w := by
      have e := Scheme.Hom.comp_apply Φ
        (Limits.pullback.snd (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g))) m
      rw [hΦ2] at e
      rw [e, hm1]
    refine ⟨⟨m, subset_closure ⟨hmc, h⁻¹, fun x => ?_⟩⟩, hm1⟩
    rw [hm2, hsnd, hzD, ofMul_inv, map_neg]
    simp only [D, Finsupp.add_apply, Finsupp.sub_apply, Finsupp.smul_apply, smul_eq_mul, hEx]
    ring

  have hsurj : Function.Surjective π := by
    haveI : JacobsonSpace ↥(Limits.pullback (wcPowHom Ω X fX a)
        (wcPowHom Ω X fX (a + g)) : Scheme.{u}) :=
      LocallyOfFiniteType.jacobsonSpace
        (Limits.pullback.fst (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) ≫ wcPowHom Ω X fX a)
    rw [← Set.range_eq_univ]
    apply Set.eq_univ_of_univ_subset
    rw [← JacobsonSpace.closure_inter_closedPoints isClosed_univ]
    apply closure_minimal _ hπc.isClosed_range
    rintro w ⟨-, hw⟩
    exact hhit w (mem_closedPoints_iff.mp hw)

  have hs1 : ∀ {A B : Type u} [TopologicalSpace A] [TopologicalSpace B] [QuasiSober B]
      (f : A → B), Continuous f → IsClosedMap f → Function.Surjective f →
      topologicalKrullDim B ≤ topologicalKrullDim A := by
    intro A B _ _ _ f hc hcl hs
    have himg : ∀ y : A, f '' closure {y} = closure {f y} := by
      intro y
      rw [← hcl.closure_image_eq_of_continuous hc, Set.image_singleton]
    have key : ∀ p : LTSeries (TopologicalSpace.IrreducibleCloseds B),
        ∃ q : LTSeries (TopologicalSpace.IrreducibleCloseds A), q.length = p.length ∧
          f '' (q.head : Set A) = (p.head : Set B) := by
      intro p
      induction p using RelSeries.inductionOn with
      | singleton C =>
        obtain ⟨w, hw⟩ := QuasiSober.sober C.isIrreducible C.isClosed
        obtain ⟨y, rfl⟩ := hs w
        refine ⟨RelSeries.singleton _ ⟨closure {y}, isIrreducible_singleton.closure,
          isClosed_closure⟩, rfl, ?_⟩
        rw [RelSeries.head_singleton, RelSeries.head_singleton]
        change f '' closure {y} = (C : Set B)
        rw [himg, hw.def]
      | cons p C hx ih =>
        obtain ⟨q', hlen, hq'⟩ := ih
        have hx' : C < p.head := hx
        obtain ⟨w, hw⟩ := QuasiSober.sober C.isIrreducible C.isClosed
        have hle : (C : Set B) ⊆ (p.head : Set B) := SetLike.coe_subset_coe.mpr hx'.le
        have hwp : w ∈ f '' (q'.head : Set A) := by rw [hq']; exact hle hw.mem
        obtain ⟨y, hy, rfl⟩ := hwp
        let Y : TopologicalSpace.IrreducibleCloseds A :=
          ⟨closure {y}, isIrreducible_singleton.closure, isClosed_closure⟩
        have hYimg : f '' (Y : Set A) = (C : Set B) := by
          change f '' closure {y} = (C : Set B)
          rw [himg, hw.def]
        have hYsub : (Y : Set A) ⊆ (q'.head : Set A) :=
          closure_minimal (Set.singleton_subset_iff.mpr hy) q'.head.isClosed
        have hYne : Y ≠ q'.head := by
          intro h
          apply ne_of_lt hx'
          apply TopologicalSpace.IrreducibleCloseds.ext
          rw [← hYimg, ← hq', h]
        have hYlt : Y < q'.head := lt_of_le_of_ne (SetLike.coe_subset_coe.mp hYsub) hYne
        refine ⟨q'.cons Y hYlt, ?_, ?_⟩
        · rw [RelSeries.cons_length, RelSeries.cons_length, hlen]
        · rw [RelSeries.head_cons, RelSeries.head_cons, hYimg]
    show (⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds B)), (p.length : WithBot ℕ∞)) ≤
      Order.krullDim (TopologicalSpace.IrreducibleCloseds A)
    refine iSup_le fun p => ?_
    obtain ⟨q, hq, -⟩ := key p
    rw [← hq]
    exact Order.LTSeries.length_le_krullDim q

  have hdimW := wc_topologicalKrullDim_pullback_field Ω (wcPow Ω X fX a) (wcPow Ω X fX (a + g))
    (wcPowHom Ω X fX a) (wcPowHom Ω X fX (a + g)) a (a + g) (hgeom a).2.2 (hgeom (a + g)).2.2
  have hle := hs1 π hπcont hπc hsurj
  rw [hdimW] at hle
  have hnat : a + g + (a + g - g) = a + (a + g) := by omega
  rw [hnat]
  exact hle

theorem wc_scheme_hauptideal_chain : ∀ (S X' : Scheme.{u}) [IsLocallyNoetherian S] (π : S ⟶ X')
    (z : S), IsClosed ({π z} : Set X') →
    Submodule.IsPrincipal (IsLocalRing.maximalIdeal (X'.presheaf.stalk (π z))) →
    ∀ (C : Set S), IsClosed C → ∀ (w : ℕ) (ch : Fin (w + 2) → Set S), StrictMono ch →
    (∀ k, IsClosed (ch k) ∧ IsIrreducible (ch k) ∧ ch k ⊆ C) → z ∈ ch 0 →
    ∃ ch' : Fin (w + 1) → Set S, StrictMono ch' ∧
      (∀ k, IsClosed (ch' k) ∧ IsIrreducible (ch' k) ∧ ch' k ⊆ C ∩ π ⁻¹' {π z}) ∧ z ∈ ch' 0 :=
by
  intro S X' _ π z hπz hprin C hC w ch hmono hch hz

  set R := S.presheaf.stalk z with hRdef
  set f := S.fromSpecStalk z with hfdef

  have s1 : IsNoetherianRing R := by
    obtain ⟨W, hW, hzW, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z) trivial
    have : IsNoetherianRing Γ(S, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
    letI : Algebra Γ(S, W) (S.presheaf.stalk (⟨z, hzW⟩ : W)) :=
      TopCat.Presheaf.algebra_section_stalk S.presheaf ⟨z, hzW⟩
    have := hW.isLocalization_stalk ⟨z, hzW⟩
    exact IsLocalization.isNoetherianRing (hW.primeIdealOf ⟨z, hzW⟩).asIdeal.primeCompl
      (S.presheaf.stalk (⟨z, hzW⟩ : W)) inferInstance

  have hcl : ∀ a b : PrimeSpectrum R,
      closure {f a} ⊆ closure {f b} ↔ b ≤ a := by
    intro a b
    rw [← specializes_iff_closure_subset, PrimeSpectrum.le_iff_specializes]
    exact (S.fromSpecStalk z).isEmbedding.isInducing.specializes_iff (x := b) (y := a)
  have hpre : ∀ y : S, y ⤳ z → ∃ a : PrimeSpectrum R, f a = y := by
    intro y hy
    have : y ∈ Set.range (S.fromSpecStalk z) := by rw [Scheme.range_fromSpecStalk]; exact hy
    obtain ⟨a, ha⟩ := this
    exact ⟨a, ha⟩
  have hcp : f (IsLocalRing.closedPoint R) = z := Scheme.fromSpecStalk_closedPoint

  have s4 : ∃ P : PrimeSpectrum R, closure {f P} = ch (Fin.last (w + 1)) ∧
      ((w + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ P.asIdeal) := by
    have hgen : ∀ k, ∃ a : PrimeSpectrum R, closure {f a} = ch k := by
      intro k
      have hg := (hch k).2.1.isGenericPoint_genericPoint (hch k).1
      have hzk : z ∈ ch k := hmono.monotone (Fin.zero_le k) hz
      have hsp : (hch k).2.1.genericPoint ⤳ z := by
        rw [specializes_iff_mem_closure, hg.def]; exact hzk
      obtain ⟨a, ha⟩ := hpre _ hsp
      exact ⟨a, by rw [ha]; exact hg.def⟩
    choose p hp using hgen
    have hanti : ∀ j k, j < k → p k < p j := by
      intro j k hjk
      have hsub : ch j ⊆ ch k := (hmono hjk).le
      rw [← hp j, ← hp k, hcl] at hsub
      refine lt_of_le_of_ne hsub ?_
      intro heq
      have : ch j = ch k := by rw [← hp j, ← hp k, heq]
      exact (hmono hjk).ne this
    refine ⟨p (Fin.last (w + 1)), hp _, ?_⟩
    rw [ringKrullDim_quotient]
    have hmem : ∀ j : Fin (w + 1 + 1), p (Fin.rev j) ∈
        PrimeSpectrum.zeroLocus ((p (Fin.last (w + 1))).asIdeal : Set R) := by
      intro j
      rw [PrimeSpectrum.mem_zeroLocus]
      rcases eq_or_lt_of_le (Fin.le_last (Fin.rev j)) with h | h
      · rw [h]
      · exact (hanti _ _ h).le
    let L : LTSeries (PrimeSpectrum.zeroLocus ((p (Fin.last (w + 1))).asIdeal : Set R)) :=
      LTSeries.mk (w + 1) (fun j => ⟨p (Fin.rev j), hmem j⟩) (by
        intro j j' hjj'
        exact hanti _ _ (Fin.rev_lt_rev.mpr hjj'))
    exact Order.LTSeries.length_le_krullDim L
  obtain ⟨P, hP, hdim⟩ := s4

  haveI := hprin
  set ϖ := Submodule.IsPrincipal.generator (IsLocalRing.maximalIdeal (X'.presheaf.stalk (π z)))
    with hϖdef
  have hϖ : IsLocalRing.maximalIdeal (X'.presheaf.stalk (π z)) = Ideal.span {ϖ} :=
    (Ideal.span_singleton_generator _).symm
  set t := (π.stalkMap z).hom ϖ with htdef
  have ht : t ∈ IsLocalRing.maximalIdeal R := by
    have h1 : ϖ ∈ IsLocalRing.maximalIdeal (X'.presheaf.stalk (π z)) :=
      Submodule.IsPrincipal.generator_mem _
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h1 ⊢
    intro hu
    exact h1 (isUnit_of_map_unit (π.stalkMap z).hom ϖ hu)

  have s2 : ∀ (I : Ideal R) (n : ℕ), ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ I) →
      (n : WithBot ℕ∞) ≤ ringKrullDim (R ⧸ (I ⊔ Ideal.span {t})) := by
    intro I n hn
    set tb := Ideal.Quotient.mk I t with htb
    have hj : tb ∈ Ring.jacobson (R ⧸ I) := by
      rw [← Ideal.jacobson_bot, Ideal.mem_jacobson_bot]
      intro y
      obtain ⟨y₀, rfl⟩ := Ideal.Quotient.mk_surjective y
      have h1 : t * y₀ ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_right _ _ ht
      have h2 : -(t * y₀) ∈ nonunits R := by
        rw [← IsLocalRing.mem_maximalIdeal]; exact neg_mem h1
      have h3 := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ h2
      have h4 := h3.map (Ideal.Quotient.mk I)
      convert h4 using 1
      rw [htb]; simp only [map_sub, map_one, map_neg, map_mul]; ring
    have hK := ringKrullDim_le_ringKrullDim_quotient_add_card (R := R ⧸ I) {tb}
      (by rw [Finset.coe_singleton]; exact Set.singleton_subset_iff.mpr hj)
    rw [Finset.card_singleton, Finset.coe_singleton] at hK
    have he : (R ⧸ I) ⧸ Ideal.span {tb} ≃+* R ⧸ (I ⊔ Ideal.span {t}) := by
      have := DoubleQuot.quotQuotEquivQuotSup I (Ideal.span {t})
      rw [Ideal.map_span, Set.image_singleton] at this
      exact this
    rw [he.ringKrullDim] at hK
    have hle := hn.trans hK
    generalize ringKrullDim (R ⧸ (I ⊔ Ideal.span {t})) = D at hle ⊢
    induction D using WithBot.recBotCoe with
    | bot => exact absurd hle (by simp)
    | coe y =>
      induction y using ENat.recTopCoe with
      | top => exact le_top
      | coe k =>
        have : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ((k + 1 : ℕ) : WithBot ℕ∞) := by exact_mod_cast hle
        have : n + 1 ≤ k + 1 := by exact_mod_cast this
        exact_mod_cast (by omega : n ≤ k)
  have hdim' := s2 P.asIdeal w hdim
  set J := P.asIdeal ⊔ Ideal.span {t} with hJ

  have s5 : ∃ Q : Fin (w + 1) → PrimeSpectrum R, (∀ k, J ≤ (Q k).asIdeal) ∧
      (∀ k k', k < k' → Q k' < Q k) ∧ Q 0 = IsLocalRing.closedPoint R := by
    rw [ringKrullDim_quotient] at hdim'
    obtain ⟨l, hl⟩ := Order.le_krullDim_iff.mp hdim'
    have hlm : StrictMono l := l.strictMono
    clear_value J
    revert l
    rw [show w = w from rfl]
    intro l hl hlm
    subst hl
    let L : Fin (l.length + 1) → PrimeSpectrum R := fun j => (l j).1
    have hL : StrictMono L := fun a b hab => hlm hab
    have hLJ : ∀ j, J ≤ (L j).asIdeal := fun j => (PrimeSpectrum.mem_zeroLocus _ _).mp (l j).2
    have hLm : ∀ j, L j ≤ IsLocalRing.closedPoint R :=
      fun j => IsLocalRing.le_maximalIdeal (L j).isPrime.ne_top
    refine ⟨fun k => if k = 0 then IsLocalRing.closedPoint R else L (Fin.rev k), ?_, ?_, ?_⟩
    · intro k
      by_cases hk : k = 0
      · simp only [hk, if_true]
        exact (hLJ 0).trans (hLm 0)
      · simp only [hk, if_false]
        exact hLJ _
    · intro k k' hkk'
      have hk' : k' ≠ 0 := by
        intro h; rw [h] at hkk'; exact (Fin.not_lt_zero k) hkk'
      simp only [hk', if_false]
      by_cases hk : k = 0
      · simp only [hk, if_true]
        refine lt_of_lt_of_le (hL ?_) (hLm (Fin.last _))
        rw [← Fin.rev_zero]
        exact Fin.rev_lt_rev.mpr (hk ▸ hkk')
      · simp only [hk, if_false]
        exact hL (Fin.rev_lt_rev.mpr hkk')
    · simp
  obtain ⟨Q, hQJ, hQanti, hQ0⟩ := s5

  have hT : IsClosed (C ∩ π ⁻¹' {π z}) := hC.inter (hπz.preimage π.continuous)
  refine ⟨fun k => closure {f (Q k)}, ?_, ?_, ?_⟩
  · intro k k' hkk'
    have hlt := hQanti k k' hkk'
    have hsub : closure {f (Q k)} ⊆ closure {f (Q k')} := (hcl _ _).mpr hlt.le
    refine lt_of_le_of_ne hsub ?_
    intro heq
    have heq' : closure {f (Q k)} = closure {f (Q k')} := heq
    have h2 : closure {f (Q k')} ⊆ closure {f (Q k)} := heq'.symm.le
    rw [hcl] at h2
    exact lt_irrefl _ (lt_of_lt_of_le hlt h2)
  · intro k
    refine ⟨isClosed_closure, isIrreducible_singleton.closure, ?_⟩
    refine closure_minimal (Set.singleton_subset_iff.mpr ⟨?_, ?_⟩) hT
    · have hPQ : P ≤ Q k := fun x hx => hQJ k (Ideal.mem_sup_left hx)
      have h1 : closure {f (Q k)} ⊆ closure {f P} := (hcl _ _).mpr hPQ
      rw [hP] at h1
      exact (hch _).2.2 (h1 (subset_closure rfl))
    · have htq : t ∈ (Q k).asIdeal := hQJ k (Ideal.mem_sup_right (Ideal.mem_span_singleton_self t))
      show π (f (Q k)) ∈ ({π z} : Set X')
      rw [Set.mem_singleton_iff]
      have h := Scheme.SpecMap_stalkMap_fromSpecStalk π (x := z)
      let q' : Spec (S.presheaf.stalk z) := Q k
      have h2 : π (S.fromSpecStalk z q') =
          X'.fromSpecStalk (π z) (Spec.map (π.stalkMap z) q') := by
        rw [← Scheme.Hom.comp_apply, ← h, Scheme.Hom.comp_apply]
      change π (S.fromSpecStalk z q') = π z
      rw [h2]
      have hr : Spec.map (π.stalkMap z) q' = IsLocalRing.closedPoint _ := by
        rw [Spec.map_apply]
        apply PrimeSpectrum.ext
        apply le_antisymm
        · exact IsLocalRing.le_maximalIdeal
            (PrimeSpectrum.comap (π.stalkMap z).hom (Q k)).isPrime.ne_top
        · change IsLocalRing.maximalIdeal _ ≤ _
          rw [hϖ, Ideal.span_singleton_le_iff_mem]
          exact htq
      rw [hr, Scheme.fromSpecStalk_closedPoint]
  · show z ∈ closure {f (Q 0)}
    rw [hQ0, hcp]
    exact subset_closure rfl

theorem wc_P2_point_eq_of_closed_coords : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] (d : ℕ) (z z' : wcP2 Ω X fX d d),
    IsClosed ({Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z} :
      Set (wcPow Ω X fX d)) →
    Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z =
      Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z' →
    (∀ j : Fin d, IsClosed ({wcPowCoord Ω X fX d j
      (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z)} : Set X)) →
    (∀ j : Fin d, wcPowCoord Ω X fX d j
      (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z) =
      wcPowCoord Ω X fX d j (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z')) →
    z = z' :=
by
  intro Ω _ _ X fX _ d z z' hfc hfst hcc hceq
  classical

  have hsurj0 : ∀ (Y : Scheme.{u}) (p : Y ⟶ Spec (.of Ω)) [LocallyOfFiniteType p] (y : Y),
      IsClosed ({y} : Set Y) →
      Function.Surjective ((Y.evaluation ⊤ y trivial).hom.comp
        (p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)) := by
    intro Y p _ y hy
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace p
    haveI : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    set g := Y.fromSpecResidueField y ≫ p with hg
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hft : (Spec.preimage g).hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    have hs2 : (Y.fromSpecResidueField y).appTop ≫ (Scheme.ΓSpecIso (Y.residueField y)).hom =
        Y.evaluation ⊤ y trivial := by
      rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
      simp only [Category.assoc]
      erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc, Scheme.germ_residue]
    have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ p.appTop ≫
        Y.evaluation ⊤ y trivial := by
      rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ, hg, Scheme.Hom.comp_appTop,
        Category.assoc, hs2]
    have hφ : (Y.evaluation ⊤ y trivial).hom.comp
        (p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom) =
        (Spec.preimage g).hom := by
      rw [heq]; rfl
    rw [hφ]
    letI : Algebra Ω (Y.residueField y) := (Spec.preimage g).hom.toAlgebra
    haveI : Algebra.FiniteType Ω (Y.residueField y) := hft
    haveI : Module.Finite Ω (Y.residueField y) := finite_of_finite_type_of_isJacobsonRing Ω _
    intro s
    have hs : IsIntegral Ω s := Algebra.IsIntegral.isIntegral s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
    exact ⟨c, hc⟩

  have hres : ∀ (Y : Scheme.{u}) (p : Y ⟶ Spec (.of Ω)) [LocallyOfFiniteType p] (y : Y),
      IsClosed ({y} : Set Y) → IsIso (p.residueFieldMap y) := by
    intro Y p _ y hy
    have hsurj := hsurj0 Y p y hy
    have hnat := Scheme.evaluation_naturality p (V := ⊤) y trivial
    have hsurj' : Function.Surjective (p.residueFieldMap y).hom := by
      intro s
      obtain ⟨c, hc⟩ := hsurj s
      refine ⟨((Spec (.of Ω)).evaluation ⊤ (p y) trivial).hom
        ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c), ?_⟩
      rw [← hc]
      have := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c)) hnat
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      rw [this]
      rfl
    have hinj : Function.Injective (p.residueFieldMap y).hom := RingHom.injective _
    exact (ConcreteCategory.isIso_iff_bijective _).mpr ⟨hinj, hsurj'⟩

  have hsub : ∀ (A B S : Scheme.{u}) (f : A ⟶ S) (g : B ⟶ S) (T : Scheme.Pullback.Triplet f g),
      (IsIso (f.residueFieldMap T.x) ∨ IsIso (g.residueFieldMap T.y)) →
      Subsingleton ↥(Spec T.tensor) := by
    intro A B S f g T h
    rcases h with h | h
    · haveI : IsIso ((S.residueFieldCongr T.hx).inv ≫ f.residueFieldMap T.x) := inferInstance
      have hb := (ConcreteCategory.isIso_iff_bijective
        (Limits.pushout.inr ((S.residueFieldCongr T.hx).inv ≫ f.residueFieldMap T.x)
          ((S.residueFieldCongr T.hy).inv ≫ g.residueFieldMap T.y))).mp
        (Limits.pushout_inr_iso_of_left_iso _ _)
      have hinj := PrimeSpectrum.comap_injective_of_surjective _ hb.2
      exact hinj.subsingleton
    · haveI : IsIso ((S.residueFieldCongr T.hy).inv ≫ g.residueFieldMap T.y) := inferInstance
      have hb := (ConcreteCategory.isIso_iff_bijective
        (Limits.pushout.inl ((S.residueFieldCongr T.hx).inv ≫ f.residueFieldMap T.x)
          ((S.residueFieldCongr T.hy).inv ≫ g.residueFieldMap T.y))).mp
        (Limits.pushout_inl_iso_of_right_iso _ _)
      have hinj := PrimeSpectrum.comap_injective_of_surjective _ hb.2
      exact hinj.subsingleton

  have hpb : ∀ (A B S : Scheme.{u}) (f : A ⟶ S) (g : B ⟶ S) (t t' : ↥(Limits.pullback f g)),
      Limits.pullback.fst f g t = Limits.pullback.fst f g t' →
      Limits.pullback.snd f g t = Limits.pullback.snd f g t' →
      (IsIso (f.residueFieldMap (Limits.pullback.fst f g t')) ∨
        IsIso (g.residueFieldMap (Limits.pullback.snd f g t'))) → t = t' := by
    intro A B S f g t t' h1 h2 hiso
    have hs : Subsingleton ↥(Spec (Scheme.Pullback.Triplet.ofPoint t').tensor) := by
      apply hsub
      rw [Scheme.Pullback.Triplet.ofPoint_x, Scheme.Pullback.Triplet.ofPoint_y]
      exact hiso
    apply Scheme.Pullback.carrierEquiv.injective
    have hT : Scheme.Pullback.Triplet.ofPoint t = Scheme.Pullback.Triplet.ofPoint t' :=
      Scheme.Pullback.Triplet.ext
        (by rw [Scheme.Pullback.Triplet.ofPoint_x, Scheme.Pullback.Triplet.ofPoint_x]; exact h1)
        (by rw [Scheme.Pullback.Triplet.ofPoint_y, Scheme.Pullback.Triplet.ofPoint_y]; exact h2)
    exact Scheme.Pullback.carrierEquiv_eq_iff.mpr ⟨hT, @Subsingleton.elim _ hs _ _⟩

  have hprop : ∀ m : ℕ, IsProper (wcPowHom Ω X fX m) := by
    intro m
    induction m with
    | zero => exact (inferInstance : IsProper (𝟙 (Spec (.of Ω))))
    | succ m ih =>
      haveI := ih
      exact (inferInstance :
        IsProper (Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowHom Ω X fX m))
  have hlast : ∀ (m : ℕ) (r : wcPow Ω X fX (m + 1)),
      wcPowCoord Ω X fX (m + 1) (Fin.last m) r = Limits.pullback.snd (wcPowHom Ω X fX m) fX r := by
    intro m r
    have : wcPowCoord Ω X fX (m + 1) (Fin.last m) = Limits.pullback.snd (wcPowHom Ω X fX m) fX := by
      show Fin.lastCases (motive := fun _ => wcPow Ω X fX (m + 1) ⟶ X)
        (Limits.pullback.snd (wcPowHom Ω X fX m) fX)
        (fun i => Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowCoord Ω X fX m i)
        (Fin.last m) = _
      exact Fin.lastCases_last
    exact congrArg (fun f : wcPow Ω X fX (m + 1) ⟶ X => f r) this
  have hcs : ∀ (m : ℕ) (i : Fin m) (r : wcPow Ω X fX (m + 1)),
      wcPowCoord Ω X fX (m + 1) (Fin.castSucc i) r =
        wcPowCoord Ω X fX m i (Limits.pullback.fst (wcPowHom Ω X fX m) fX r) := by
    intro m i r
    have : wcPowCoord Ω X fX (m + 1) (Fin.castSucc i) =
        Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowCoord Ω X fX m i := by
      show Fin.lastCases (motive := fun _ => wcPow Ω X fX (m + 1) ⟶ X)
        (Limits.pullback.snd (wcPowHom Ω X fX m) fX)
        (fun i => Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowCoord Ω X fX m i)
        (Fin.castSucc i) = _
      exact Fin.lastCases_castSucc i
    exact (congrArg (fun f : wcPow Ω X fX (m + 1) ⟶ X => f r) this).trans
      (Scheme.Hom.comp_apply _ _ _)

  have hpow : ∀ (m : ℕ) (r r' : wcPow Ω X fX m),
      (∀ j : Fin m, IsClosed ({wcPowCoord Ω X fX m j r} : Set X)) →
      (∀ j : Fin m, wcPowCoord Ω X fX m j r = wcPowCoord Ω X fX m j r') → r = r' := by
    intro m
    induction m with
    | zero =>
      intro r r' _ _
      exact @Subsingleton.elim (↥(Spec (.of Ω))) _ r r'
    | succ m ih =>
      intro r r' hc he
      have h1 : Limits.pullback.fst (wcPowHom Ω X fX m) fX r =
          Limits.pullback.fst (wcPowHom Ω X fX m) fX r' :=
        ih _ _ (fun i => by rw [← hcs]; exact hc i.castSucc)
          (fun i => by rw [← hcs, ← hcs]; exact he i.castSucc)
      have h2 : Limits.pullback.snd (wcPowHom Ω X fX m) fX r =
          Limits.pullback.snd (wcPowHom Ω X fX m) fX r' := by
        rw [← hlast, ← hlast]; exact he (Fin.last m)
      have h3 : IsClosed ({Limits.pullback.snd (wcPowHom Ω X fX m) fX r'} : Set X) := by
        rw [← h2, ← hlast]; exact hc (Fin.last m)
      exact hpb _ _ _ (wcPowHom Ω X fX m) fX r r' h1 h2 (Or.inr (hres X fX _ h3))

  have hsnd := hpow d _ _ hcc hceq
  haveI := hprop d
  have hfc' : IsClosed ({Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z'} :
      Set (wcPow Ω X fX d)) := by rw [← hfst]; exact hfc
  exact hpb _ _ _ (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z z' hfst hsnd
    (Or.inl (hres (wcPow Ω X fX d) (wcPowHom Ω X fX d) _ hfc'))

theorem wc_rr_space_basepoint : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    [IrreducibleSpace X] (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U)
    (ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ), wcCurveOrdData Ω X fX U hU ω →
    (∀ D D' : X →₀ ℤ, D ≤ D' → wcRRSpace Ω X fX U ω D ≤ wcRRSpace Ω X fX U ω D') ∧
    ∀ (E : X →₀ ℤ) (p : X),
      ((∀ (f : FractionRing Γ(X, U)) (hf : f ≠ 0),
          (∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 f hf)) + E x) →
          1 ≤ ω p (Additive.ofMul (Units.mk0 f hf)) + E p) →
        wcRRSpace Ω X fX U ω (E - Finsupp.single p 1) = wcRRSpace Ω X fX U ω E) ∧
      ((∃ (f : FractionRing Γ(X, U)) (hf : f ≠ 0),
          (∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 f hf)) + E x) ∧
          ω p (Additive.ofMul (Units.mk0 f hf)) + E p < 1) →
        wcRRSpace Ω X fX U ω (E - Finsupp.single p 1) < wcRRSpace Ω X fX U ω E) :=
by
  intro Ω _ X fX _ U _ hU ω hω
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra

  have hmono : ∀ D D' : X →₀ ℤ, D ≤ D' →
      wcRRSpace Ω X fX U ω D ≤ wcRRSpace Ω X fX U ω D' := by
    intro D D' hDD'
    unfold wcRRSpace
    apply Submodule.span_mono
    rintro f ⟨hf, hb⟩
    refine ⟨hf, fun x => ?_⟩
    have h1 := hb x
    have h2 : D x ≤ D' x := Finsupp.le_def.1 hDD' x
    linarith
  have hsub : ∀ (E : X →₀ ℤ) (p : X), E - Finsupp.single p 1 ≤ E := by
    intro E p
    rw [Finsupp.le_def]
    intro x
    rw [Finsupp.sub_apply, Finsupp.single_apply]
    split_ifs <;> omega

  have hconst : ∀ (c : Ω) (hc : wcCurveConst Ω X fX U c ≠ 0) (x : X),
      ω x (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)) = 0 := by
    intro c hc x
    have h1 : ∀ y, 0 ≤ ω y (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)) := by
      refine (hω.2.2.2.2.2 _).2 ⟨c, ?_⟩
      rfl
    have h2 : ∀ y, 0 ≤ ω y (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)⁻¹) := by
      refine (hω.2.2.2.2.2 _).2 ⟨c⁻¹, ?_⟩
      rw [Units.val_inv_eq_inv_val]
      change wcCurveConst Ω X fX U c⁻¹ = (wcCurveConst Ω X fX U c)⁻¹
      exact map_inv₀ _ c
    have h3 : ω x (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)) +
        ω x (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)⁻¹) = 0 := by
      rw [← map_add, ← ofMul_mul, mul_inv_cancel, ofMul_one, map_zero]
    have e1 := h1 x
    have e2 := h2 x
    omega

  have hbound : ∀ (D : X →₀ ℤ) (g : FractionRing Γ(X, U)), g ∈ wcRRSpace Ω X fX U ω D →
      g = 0 ∨ ∃ hg : g ≠ 0, ∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 g hg)) + D x := by
    intro D g hg
    unfold wcRRSpace at hg
    induction hg using Submodule.span_induction with
    | mem a ha => exact Or.inr ha
    | zero => exact Or.inl rfl
    | add a b _ _ ha hb =>
      rcases ha with rfl | ⟨ha0, ba⟩
      · rw [zero_add]; exact hb
      rcases hb with rfl | ⟨hb0, bb⟩
      · rw [add_zero]; exact Or.inr ⟨ha0, ba⟩
      by_cases hab : a + b = 0
      · exact Or.inl hab
      refine Or.inr ⟨hab, fun x => ?_⟩
      have hu := hω.2.2.2.2.1 x (Units.mk0 a ha0) (Units.mk0 b hb0) (Units.mk0 (a + b) hab)
        (by simp)
      have e1 := ba x
      have e2 := bb x
      rcases min_le_iff.mp hu with h | h <;> linarith
    | smul c a _ ha =>
      rw [show c • a = wcCurveConst Ω X fX U c * a from rfl]
      rcases ha with rfl | ⟨ha0, ba⟩
      · exact Or.inl (mul_zero _)
      by_cases hc : wcCurveConst Ω X fX U c = 0
      · left; rw [hc, zero_mul]
      have hca : wcCurveConst Ω X fX U c * a ≠ 0 := mul_ne_zero hc ha0
      refine Or.inr ⟨hca, fun x => ?_⟩
      have e : Units.mk0 _ hca = Units.mk0 _ hc * Units.mk0 a ha0 := Units.ext (by simp)
      rw [e, ofMul_mul, map_add, hconst c hc x, zero_add]
      exact ba x
  refine ⟨hmono, fun E p => ⟨fun hB => ?_, ?_⟩⟩
  ·
    apply le_antisymm (hmono _ _ (hsub E p))
    unfold wcRRSpace
    apply Submodule.span_le.mpr
    rintro f ⟨hf, bE⟩
    apply Submodule.subset_span
    refine ⟨hf, fun x => ?_⟩
    rw [Finsupp.sub_apply, Finsupp.single_apply]
    split_ifs with hpx
    · subst hpx
      have := hB f hf bE
      linarith
    · have := bE x
      linarith
  ·
    rintro ⟨f, hf, bE, hlt⟩
    rw [SetLike.lt_iff_le_and_exists]
    refine ⟨hmono _ _ (hsub E p), f, ?_, ?_⟩
    · unfold wcRRSpace
      exact Submodule.subset_span ⟨hf, bE⟩
    · intro hmem
      rcases hbound _ f hmem with h0 | ⟨hf', b⟩
      · exact hf h0
      have b' : ∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 f hf)) +
          (E - Finsupp.single p (1 : ℤ) : X →₀ ℤ) x := b
      have := b' p
      rw [Finsupp.sub_apply, Finsupp.single_eq_same] at this
      omega

theorem wc_coord_divisor_split : ∀ {T : Type u} (d : ℕ) (c a : Fin d → T) (I : Finset (Fin d))
    (p : T), (∀ i ∈ I, c i = a i) →
    (∀ x : T, (∑ i ∈ I, Finsupp.single (a i) (1 : ℤ)) x ≤
      (∑ j : Fin d, Finsupp.single (c j) (1 : ℤ)) x) ∧
    (1 ≤ (∑ j : Fin d, Finsupp.single (c j) (1 : ℤ)) p -
        (∑ i ∈ I, Finsupp.single (a i) (1 : ℤ)) p → ∃ j, j ∉ I ∧ c j = p) ∧
    (∀ j, j ∉ I → ∑ i ∈ insert j I, Finsupp.single (Function.update a j p i) (1 : ℤ) =
      (∑ i ∈ I, Finsupp.single (a i) (1 : ℤ)) + Finsupp.single p 1) :=
by
  classical
  intro T d c a I p hca
  have hPart : ∀ x, (∑ i ∈ I, Finsupp.single (a i) (1 : ℤ)) x =
      ∑ i ∈ I, (Finsupp.single (c i) (1 : ℤ)) x := by
    intro x
    rw [Finsupp.finset_sum_apply]
    exact Finset.sum_congr rfl (fun i hi => by rw [hca i hi])
  have hFull : ∀ x, (∑ j : Fin d, Finsupp.single (c j) (1 : ℤ)) x =
      ∑ j : Fin d, (Finsupp.single (c j) (1 : ℤ)) x := by
    intro x
    rw [Finsupp.finset_sum_apply]
  have hnn : ∀ j x, 0 ≤ (Finsupp.single (c j) (1 : ℤ)) x := by
    intro j x
    rw [Finsupp.single_apply]
    split_ifs <;> norm_num
  refine ⟨?_, ?_, ?_⟩
  · intro x
    rw [hPart, hFull]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ I) (fun j _ _ => hnn j x)
  · intro h
    rw [hPart, hFull, ← Finset.sum_add_sum_compl I] at h
    have hne : ∑ j ∈ Iᶜ, (Finsupp.single (c j) (1 : ℤ)) p ≠ 0 := by
      intro h0
      rw [h0] at h
      linarith
    obtain ⟨j, hj, hgj⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
    refine ⟨j, Finset.mem_compl.mp hj, ?_⟩
    by_contra hcp
    rw [Finsupp.single_apply, if_neg hcp] at hgj
    exact hgj rfl
  · intro j hj
    rw [Finset.sum_insert hj, Function.update_self, add_comm]
    congr 1
    exact Finset.sum_congr rfl (fun i hi => by
      have hij : i ≠ j := fun h => hj (h ▸ hi)
      rw [Function.update_of_ne hij])

theorem wc_fibre_linsys_chain_bound : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    wcTrueOrd X U ω →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ (d : ℕ) (y : wcPow Ω X fX d), IsClosed ({y} : Set (wcPow Ω X fX d)) →
    ∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
    ∀ (w : ℕ) (ch : Fin (w + 1) → Set (wcP2 Ω X fX d d)), StrictMono ch →
    (∀ k, IsClosed (ch k) ∧ IsIrreducible (ch k) ∧
      ch k ⊆ closure (wcIncSet Ω X fX U ω d d 0 (-1) D ∩
        (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y})) →
    (w : ℤ) + 1 ≤ (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hω htrue g c hRR d y hy D hDη hDc w ch hmono hch
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra

  have hprop : ∀ m : ℕ, IsProper (wcPowHom Ω X fX m) := by
    intro m
    induction m with
    | zero => exact (inferInstance : IsProper (𝟙 (Spec (.of Ω))))
    | succ m ih =>
      haveI := ih
      exact (inferInstance :
        IsProper (Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowHom Ω X fX m))
  haveI := hprop d
  haveI hJ : JacobsonSpace (wcP2 Ω X fX d d) :=
    LocallyOfFiniteType.jacobsonSpace
      (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫ wcPowHom Ω X fX d)
  haveI hNoeth : IsLocallyNoetherian (wcP2 Ω X fX d d) :=
    LocallyOfFiniteType.isLocallyNoetherian
      (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫ wcPowHom Ω X fX d)
  haveI hCpt : CompactSpace (wcP2 Ω X fX d d) :=
    QuasiCompact.compactSpace_of_compactSpace
      (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫ wcPowHom Ω X fX d)

  have hηnc : ¬ IsClosed ({genericPoint X} : Set X) := by
    intro hc
    have hcl : closure ({genericPoint X} : Set X) = Set.univ := genericPoint_spec X
    have huniv : ∀ x : X, x = genericPoint X := by
      intro x
      have h1 : x ∈ closure ({genericPoint X} : Set X) := by rw [hcl]; trivial
      rw [hc.closure_eq] at h1
      exact h1
    have h1 : ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim X := le_of_eq hdim.symm
    obtain ⟨p, hp⟩ := Order.le_krullDim_iff.mp h1
    have hlt : p 0 < p (Fin.last _) :=
      p.strictMono (Fin.lt_iff_val_lt_val.mpr (by simp [hp]))
    have hall : ∀ s : TopologicalSpace.IrreducibleCloseds X, (s : Set X) = Set.univ := by
      intro s
      obtain ⟨x, hx⟩ := s.isIrreducible.nonempty
      ext z
      simp only [Set.mem_univ, iff_true]
      rw [huniv z, ← huniv x]
      exact hx
    exact hlt.ne (TopologicalSpace.IrreducibleCloseds.ext ((hall _).trans (hall _).symm))

  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  have hclosedpts := (wc_curve_points_closed_opens_compact Ω X fX hdim).1
  have hDVR : ∀ p : X, IsClosed ({p} : Set X) →
      Submodule.IsPrincipal (IsLocalRing.maximalIdeal (X.presheaf.stalk p)) := by
    intro p hp
    have hpη : p ≠ genericPoint X := fun h => hηnc (h ▸ hp)
    haveI := wc_curve_stalk_dvr Ω X fX (fun x => (hnorm x).2)
      (fun y' hy' => hclosedpts {y'} (Set.finite_singleton y')
        (fun h => hy' (Set.mem_singleton_iff.mp h).symm)) p hpη
    exact IsPrincipalIdealRing.principal _

  let co : Fin d → wcP2 Ω X fX d d → X := fun j z =>
    wcPowCoord Ω X fX d j (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z)
  let Φ : Finset (Fin d) → (Fin d → X) → Set (wcP2 Ω X fX d d) := fun I a =>
    wcIncSet Ω X fX U ω d d 0 (-1) D ∩
      (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y} ∩
      {z | ∀ i ∈ I, co i z = a i}
  let A : Finset (Fin d) → (Fin d → X) → (X →₀ ℤ) := fun I a =>
    ∑ i ∈ I, Finsupp.single (a i) (1 : ℤ)
  let ℓ : (X →₀ ℤ) → ℕ := fun E => Module.finrank Ω (wcRRSpace Ω X fX U ω E)
  have hmemΦ : ∀ I a z, z ∈ Φ I a ↔ (z ∈ wcIncSet Ω X fX U ω d d 0 (-1) D ∧
      Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z = y) ∧
      ∀ i ∈ I, co i z = a i := fun I a z => Iff.rfl
  have hRRsp := wc_rr_space_basepoint Ω X fX U hU ω hω

  have hAnn : ∀ I a x, 0 ≤ A I a x := by
    intro I a x
    show 0 ≤ (∑ i ∈ I, Finsupp.single (a i) (1 : ℤ)) x
    rw [Finsupp.finset_sum_apply]
    exact Finset.sum_nonneg (fun i _ => by rw [Finsupp.single_apply]; split_ifs <;> norm_num)
  haveI hFD : FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) := (hRR D hDη hDc).1
  have hFDA : ∀ I a, FiniteDimensional Ω (wcRRSpace Ω X fX U ω (D - A I a)) := by
    intro I a
    have hle : D - A I a ≤ D := Finsupp.le_def.mpr (fun x => by
      rw [Finsupp.sub_apply]; linarith [hAnn I a x])
    exact Submodule.finiteDimensional_of_le (hRRsp.1 _ _ hle)

  have hpos : ∀ (E : X →₀ ℤ) (f : FractionRing Γ(X, U)) (hf : f ≠ 0),
      (∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 f hf)) + E x) →
      FiniteDimensional Ω (wcRRSpace Ω X fX U ω E) → 1 ≤ ℓ E := by
    intro E f hf hfE hfd
    haveI := hfd
    have hmem : f ∈ wcRRSpace Ω X fX U ω E := by
      unfold wcRRSpace
      exact Submodule.subset_span (Set.mem_setOf.mpr ⟨hf, hfE⟩)
    have h1 := Submodule.finrank_mono ((Submodule.span_singleton_le_iff_mem f _).mpr hmem)
    rw [finrank_span_singleton hf] at h1
    exact h1

  have hGen : ∀ (I : Finset (Fin d)) (a : Fin d → X) (z : wcP2 Ω X fX d d)
      (h : (FractionRing Γ(X, U))ˣ), (∀ i ∈ I, co i z = a i) →
      (∀ x, wcPowDiv Ω X fX d (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z) x =
        D x + ω x (Additive.ofMul h)) →
      ∀ x, ω x (Additive.ofMul h) + (D - A I a) x =
          (∑ j : Fin d, Finsupp.single (co j z) (1 : ℤ)) x - A I a x ∧
        0 ≤ ω x (Additive.ofMul h) + (D - A I a) x := by
    intro I a z h hI hR x
    have hsum : (∑ j : Fin d, Finsupp.single (co j z) (1 : ℤ)) =
        wcPowDiv Ω X fX d (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z) :=
      (wc_pow_coord_facts Ω X fX d _).1.symm
    obtain ⟨h4, -, -⟩ := wc_coord_divisor_split d (fun j => co j z) a I x hI
    have e1 : A I a x ≤ (∑ j : Fin d, Finsupp.single (co j z) (1 : ℤ)) x := h4 x
    have e2 := hR x
    have e3 : (∑ j : Fin d, Finsupp.single (co j z) (1 : ℤ)) x =
        wcPowDiv Ω X fX d (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z) x := by
      rw [hsum]
    rw [Finsupp.sub_apply]
    constructor
    · linarith
    · linarith

  have hJC : ∀ (I : Finset (Fin d)) (a : Fin d → X), (∀ i ∈ I, IsClosed ({a i} : Set X)) →
      ∀ z ∈ closure (Φ I a), IsClosed ({z} : Set (wcP2 Ω X fX d d)) → z ∈ Φ I a := by
    intro I a ha z hz hzc
    have hcl2 : IsClosed {r : wcP2 Ω X fX d d | ∀ i ∈ I, co i r = a i} := by
      have : {r : wcP2 Ω X fX d d | ∀ i ∈ I, co i r = a i} = ⋂ i ∈ I,
          (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫
            wcPowCoord Ω X fX d i) ⁻¹' {a i} := by
        ext r
        simp only [Set.mem_setOf_eq, Set.mem_iInter, Set.mem_preimage, Set.mem_singleton_iff,
          Scheme.Hom.comp_apply]
        try rfl
      rw [this]
      exact isClosed_biInter (fun i hi => (ha i hi).preimage (Scheme.Hom.continuous _))
    have hcl : IsClosed ((Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y} ∩
        {r : wcP2 Ω X fX d d | ∀ i ∈ I, co i r = a i}) :=
      (hy.preimage (Scheme.Hom.continuous _)).inter hcl2
    have h1 : z ∈ closure (wcIncSet Ω X fX U ω d d 0 (-1) D) :=
      closure_mono (fun x hx => hx.1.1) hz
    have h2 : z ∈ (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y} ∩
        {r : wcP2 Ω X fX d d | ∀ i ∈ I, co i r = a i} :=
      closure_minimal (s := Φ I a) (fun x hx => Set.mem_inter hx.1.2 hx.2) hcl hz
    exact ⟨⟨wc_incidence_locus_jacobson_closed_true Ω X fX hnorm hdim U hU hfin ω hω htrue g c hRR
      d d 0 (-1) D hDη z h1 hzc, h2.1⟩, h2.2⟩

  have hupd_closed : ∀ (I : Finset (Fin d)) (a : Fin d → X) (j : Fin d) (p : X),
      (∀ i ∈ I, IsClosed ({a i} : Set X)) → IsClosed ({p} : Set X) →
      ∀ i ∈ insert j I, IsClosed ({Function.update a j p i} : Set X) := by
    intro I a j p ha hp i hi
    by_cases hij : i = j
    · subst hij
      rw [Function.update_self]
      exact hp
    · rw [Function.update_of_ne hij]
      exact ha i ((Finset.mem_insert.mp hi).resolve_left hij)
  have hupd_mem : ∀ (I : Finset (Fin d)) (a : Fin d → X) (j : Fin d) (p : X)
      (r : wcP2 Ω X fX d d), j ∉ I → r ∈ Φ I a → co j r = p →
      r ∈ Φ (insert j I) (Function.update a j p) := by
    intro I a j p r hjI hr hrp
    obtain ⟨h1, h2⟩ := (hmemΦ I a r).1 hr
    refine (hmemΦ _ _ r).2 ⟨h1, fun i hi => ?_⟩
    by_cases hij : i = j
    · subst hij
      rw [Function.update_self]
      exact hrp
    · rw [Function.update_of_ne hij]
      exact h2 i ((Finset.mem_insert.mp hi).resolve_left hij)
  have hAupd : ∀ (I : Finset (Fin d)) (a : Fin d → X) (j : Fin d) (p : X), j ∉ I →
      D - A (insert j I) (Function.update a j p) = D - A I a - Finsupp.single p 1 := by
    intro I a j p hj
    obtain ⟨-, -, h3⟩ := wc_coord_divisor_split d a a I p (fun _ _ => rfl)
    show D - (∑ i ∈ insert j I, Finsupp.single (Function.update a j p i) (1 : ℤ)) =
      D - (∑ i ∈ I, Finsupp.single (a i) (1 : ℤ)) - Finsupp.single p 1
    rw [h3 j hj, sub_add_eq_sub_sub]

  have key : ∀ n : ℕ, ∀ (I : Finset (Fin d)) (a : Fin d → X), Iᶜ.card = n →
      (∀ i ∈ I, IsClosed ({a i} : Set X)) →
      ∀ (v : ℕ) (ch : Fin (v + 1) → Set (wcP2 Ω X fX d d)), StrictMono ch →
      (∀ k, IsClosed (ch k) ∧ IsIrreducible (ch k) ∧ ch k ⊆ closure (Φ I a)) →
      (v : ℤ) + 1 ≤ (ℓ (D - A I a) : ℤ) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
    intro I a hIn ha v ch hmono hch
    haveI := hFDA I a
    obtain ⟨z, hz0, hzc⟩ := (hch 0).1.exists_closed_singleton (hch 0).2.1.nonempty
    have hzΦ : z ∈ Φ I a := hJC I a ha z ((hch 0).2.2 hz0) hzc
    obtain ⟨⟨hzinc, hzy⟩, hzI⟩ := (hmemΦ I a z).1 hzΦ
    obtain ⟨-, h, hh⟩ := hzinc
    have hR : ∀ x, wcPowDiv Ω X fX d
        (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z) x =
        D x + ω x (Additive.ofMul h) := fun x => by have := hh x; linarith
    have hGz := hGen I a z h hzI hR
    cases v with
    | zero =>
      have := hpos (D - A I a) (h : FractionRing Γ(X, U)) h.ne_zero
        (fun x => by rw [Units.mk0_val]; exact (hGz x).2) (hFDA I a)
      omega
    | succ v' =>
      by_cases hIu : Iᶜ = ∅
      ·
        have hall : ∀ j, j ∈ I := fun j => by
          by_contra hj
          have hj' : j ∈ Iᶜ := Finset.mem_compl.mpr hj
          rw [hIu] at hj'
          exact Finset.notMem_empty _ hj'
        have hsub : Φ I a ⊆ {z} := by
          intro r hr
          obtain ⟨⟨-, hry⟩, hrI⟩ := (hmemΦ I a r).1 hr
          have hzr := wc_P2_point_eq_of_closed_coords Ω X fX d z r (by rw [hzy]; exact hy)
            (hzy.trans hry.symm)
            (fun j => by
              have e : co j z = a j := hzI j (hall j)
              show IsClosed ({co j z} : Set X)
              rw [e]
              exact ha j (hall j))
            (fun j => (hzI j (hall j)).trans (hrI j (hall j)).symm)
          exact Set.mem_singleton_iff.mpr hzr.symm
        have h01 : ch 0 < ch 1 := hmono (Fin.zero_lt_one : (0 : Fin (v' + 1 + 1)) < 1)
        have hc1 : ch 1 ⊆ {z} := by
          intro r hr
          have hr' := (hch 1).2.2 hr
          rw [← hzc.closure_eq]
          exact closure_mono hsub hr'
        have hc0 : ch 0 = ch 1 := by
          apply le_antisymm h01.le
          intro r hr
          rw [Set.mem_singleton_iff.mp (hc1 hr)]
          exact hz0
        exact absurd hc0 h01.ne
      · obtain ⟨j, hj⟩ := Finset.nonempty_of_ne_empty hIu
        have hjI : j ∉ I := Finset.mem_compl.mp hj
        obtain ⟨a₀, ha₀⟩ : ∃ p, co j z = p := ⟨_, rfl⟩
        have hsndc : IsClosed ({Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z} :
            Set (wcPow Ω X fX d)) := by
          rw [← Set.image_singleton]
          exact (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)).isClosedMap _ hzc
        have ha₀c : IsClosed ({a₀} : Set X) := by
          rw [← ha₀]
          exact (wc_pow_coord_facts Ω X fX d _).2 hsndc j
        by_cases hB : ∀ (f : FractionRing Γ(X, U)) (hf : f ≠ 0),
            (∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 f hf)) + (D - A I a) x) →
            1 ≤ ω a₀ (Additive.ofMul (Units.mk0 f hf)) + (D - A I a) a₀
        ·
          have hcov : Φ I a ⊆ ⋃ j' ∈ Iᶜ, closure (Φ (insert j' I) (Function.update a j' a₀)) := by
            intro r hr
            obtain ⟨⟨hrinc, hry⟩, hrI⟩ := (hmemΦ I a r).1 hr
            obtain ⟨-, hr', hhr⟩ := hrinc
            have hRr : ∀ x, wcPowDiv Ω X fX d
                (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) r) x =
                D x + ω x (Additive.ofMul hr') := fun x => by have := hhr x; linarith
            have hG := hGen I a r hr' hrI hRr
            have h1 := hB (hr' : FractionRing Γ(X, U)) hr'.ne_zero
              (fun x => by rw [Units.mk0_val]; exact (hG x).2)
            rw [Units.mk0_val, (hG a₀).1] at h1
            obtain ⟨-, h4b, -⟩ := wc_coord_divisor_split d (fun j => co j r) a I a₀ hrI
            obtain ⟨j', hj'I, hj'r⟩ := h4b h1
            exact Set.mem_iUnion₂.mpr ⟨j', Finset.mem_compl.mpr hj'I,
              subset_closure (hupd_mem I a j' a₀ r hj'I hr hj'r)⟩
          have hcovc : closure (Φ I a) ⊆
              ⋃ j' ∈ Iᶜ, closure (Φ (insert j' I) (Function.update a j' a₀)) :=
            closure_minimal hcov (isClosed_biUnion_finset (fun _ _ => isClosed_closure))
          obtain ⟨Z, hZ, hZsub⟩ := isIrreducible_iff_sUnion_isClosed.mp (hch (Fin.last _)).2.1
            (Iᶜ.image (fun j' => closure (Φ (insert j' I) (Function.update a j' a₀))))
            (by
              intro Z hZ
              obtain ⟨j', -, rfl⟩ := Finset.mem_image.mp hZ
              exact isClosed_closure)
            (by
              intro r hr
              obtain ⟨j', hj', hrj'⟩ := Set.mem_iUnion₂.mp (hcovc ((hch _).2.2 hr))
              exact Set.mem_sUnion.mpr ⟨_, Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hj'),
                hrj'⟩)
          obtain ⟨j', hj', rfl⟩ := Finset.mem_image.mp hZ
          have hj'I : j' ∉ I := Finset.mem_compl.mp hj'
          have hlt : (insert j' I)ᶜ.card < n := by
            rw [← hIn]
            exact Finset.card_lt_card (Finset.compl_ssubset_compl.mpr (Finset.ssubset_insert hj'I))
          have hih := IH _ hlt (insert j' I) (Function.update a j' a₀) rfl
            (hupd_closed I a j' a₀ ha ha₀c) (v' + 1) ch hmono
            (fun k => ⟨(hch k).1, (hch k).2.1,
              fun r hr => hZsub (hmono.monotone (Fin.le_last k) hr)⟩)
          rw [hAupd I a j' a₀ hj'I] at hih
          have hsp := ((hRRsp.2 (D - A I a) a₀).1 hB)
          have hl : ℓ (D - A I a - Finsupp.single a₀ 1) = ℓ (D - A I a) := by
            show Module.finrank Ω (wcRRSpace Ω X fX U ω (D - A I a - Finsupp.single a₀ 1)) =
              Module.finrank Ω (wcRRSpace Ω X fX U ω (D - A I a))
            rw [hsp]
          rw [hl] at hih
          exact hih
        ·
          push_neg at hB
          have hlt_sp := (hRRsp.2 (D - A I a) a₀).2 hB
          have hlt_l : ℓ (D - A I a - Finsupp.single a₀ 1) < ℓ (D - A I a) :=
            Submodule.finrank_lt_finrank_of_lt hlt_sp
          have hπz : (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫
              wcPowCoord Ω X fX d j) z = a₀ := by
            rw [Scheme.Hom.comp_apply]
            exact ha₀
          have hπzc : IsClosed ({(Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫
              wcPowCoord Ω X fX d j) z} : Set X) := by
            rw [hπz]
            exact ha₀c
          obtain ⟨ch', hmono', hch', -⟩ := wc_scheme_hauptideal_chain (wcP2 Ω X fX d d) X
            (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫ wcPowCoord Ω X fX d j)
            z hπzc (by rw [hπz]; exact hDVR a₀ ha₀c) (closure (Φ I a)) isClosed_closure v' ch
            hmono hch hz0
          have hslice : closure (Φ I a) ∩
              (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫
                wcPowCoord Ω X fX d j) ⁻¹'
                {(Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫
                  wcPowCoord Ω X fX d j) z} ⊆
              closure (Φ (insert j I) (Function.update a j a₀)) := by
            have hFc : IsClosed (closure (Φ I a) ∩
                (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫
                  wcPowCoord Ω X fX d j) ⁻¹'
                  {(Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫
                    wcPowCoord Ω X fX d j) z}) :=
              isClosed_closure.inter (hπzc.preimage (Scheme.Hom.continuous _))
            intro r hr
            rw [← closure_inter_closedPoints hFc] at hr
            refine closure_mono ?_ hr
            rintro s ⟨⟨hs1, hs2⟩, hs3⟩
            have hsc : IsClosed ({s} : Set (wcP2 Ω X fX d d)) := mem_closedPoints_iff.mp hs3
            have hsΦ := hJC I a ha s hs1 hsc
            have e : (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫
                wcPowCoord Ω X fX d j) s = a₀ := (Set.mem_singleton_iff.mp hs2).trans hπz
            rw [Scheme.Hom.comp_apply] at e
            exact hupd_mem I a j a₀ s hjI hsΦ e
          have hlt : (insert j I)ᶜ.card < n := by
            rw [← hIn]
            exact Finset.card_lt_card (Finset.compl_ssubset_compl.mpr (Finset.ssubset_insert hjI))
          have hih := IH _ hlt (insert j I) (Function.update a j a₀) rfl
            (hupd_closed I a j a₀ ha ha₀c) v' ch' hmono'
            (fun k => ⟨(hch' k).1, (hch' k).2.1, fun r hr => hslice ((hch' k).2.2 hr)⟩)
          rw [hAupd I a j a₀ hjI] at hih
          omega

  have hsubΦ : wcIncSet Ω X fX U ω d d 0 (-1) D ∩
      (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y} ⊆
      Φ ∅ (fun _ => genericPoint X) := fun s hs =>
    (hmemΦ _ _ s).2 ⟨⟨hs.1, hs.2⟩, fun i hi => absurd hi (Finset.notMem_empty i)⟩
  have hfin' := key _ ∅ (fun _ => genericPoint X) rfl
    (fun i hi => absurd hi (Finset.notMem_empty i)) w ch hmono
    (fun k => ⟨(hch k).1, (hch k).2.1, Set.Subset.trans (hch k).2.2 (closure_mono hsubΦ)⟩)
  have hA0 : A ∅ (fun _ => genericPoint X) = 0 := by
    show (∑ i ∈ (∅ : Finset (Fin d)), Finsupp.single (genericPoint X) (1 : ℤ)) = 0
    exact Finset.sum_empty
  rw [hA0, sub_zero] at hfin'
  exact hfin'

theorem wc_incidence_fibre_dim_le : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    wcTrueOrd X U ω →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ T : Finset (X →₀ ℤ), (∀ D : X →₀ ℤ,
      (∃ f : (FractionRing Γ(X, U))ˣ, ∀ x, (ℓ : ℤ) * D x = ω x (Additive.ofMul f)) →
      ∃ t ∈ T, ∃ h : (FractionRing Γ(X, U))ˣ, ∀ x, D x = t x + ω x (Additive.ofMul h)) →
    ∀ Q : X, Q ≠ genericPoint X → ∀ d : ℕ, 1 ≤ d → c ≤ d → g ≤ d →
    ∀ y : wcPow Ω X fX d, IsClosed ({y} : Set (wcPow Ω X fX d)) →
      topologicalKrullDim ↥(closure (wcIncSet Ω X fX U ω d d 1 (-(ℓ : ℤ))
          (Finsupp.single Q (((ℓ : ℤ) - 1) * d))) ∩
        (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y}) ≤
        (((d - g : ℕ)) : WithBot ℕ∞) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ℓ hℓ ω hω htrue g c hRR T hT Q hQ d hd1 hdc hdg y hy
  classical

  have hprop : ∀ m : ℕ, IsProper (wcPowHom Ω X fX m) := by
    intro m
    induction m with
    | zero => exact (inferInstance : IsProper (𝟙 (Spec (.of Ω))))
    | succ m ih =>
      haveI := ih
      exact (inferInstance :
        IsProper (Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowHom Ω X fX m))

  have hηnc : ¬ IsClosed ({genericPoint X} : Set X) := by
    intro hc
    have hcl : closure ({genericPoint X} : Set X) = Set.univ := genericPoint_spec X
    have huniv : ∀ x : X, x = genericPoint X := by
      intro x
      have h1 : x ∈ closure ({genericPoint X} : Set X) := by rw [hcl]; trivial
      rw [hc.closure_eq] at h1
      exact h1
    have h1 : ((1 : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim X := le_of_eq hdim.symm
    obtain ⟨p, hp⟩ := Order.le_krullDim_iff.mp h1
    have hlt : p 0 < p (Fin.last _) :=
      p.strictMono (Fin.lt_iff_val_lt_val.mpr (by simp [hp]))
    have hall : ∀ s : TopologicalSpace.IrreducibleCloseds X, (s : Set X) = Set.univ := by
      intro s
      obtain ⟨x, hx⟩ := s.isIrreducible.nonempty
      ext z
      simp only [Set.mem_univ, iff_true]
      rw [huniv z, ← huniv x]
      exact hx
    exact hlt.ne (TopologicalSpace.IrreducibleCloseds.ext ((hall _).trans (hall _).symm))

  have hdiv : ∀ (m : ℕ) (r : wcPow Ω X fX m), IsClosed ({r} : Set (wcPow Ω X fX m)) →
      wcPowDiv Ω X fX m r (genericPoint X) = 0 ∧
        (wcPowDiv Ω X fX m r).sum (fun _ k => k) = (m : ℤ) := by
    intro m
    induction m with
    | zero => intro r _; simp [wcPowDiv]
    | succ m ih =>
      haveI := hprop m
      intro (r : ↥(Limits.pullback (wcPowHom Ω X fX m) fX)) hr
      have hfst : IsClosed ({Limits.pullback.fst (wcPowHom Ω X fX m) fX r} :
          Set (wcPow Ω X fX m)) := by
        rw [← Set.image_singleton]
        exact (Limits.pullback.fst (wcPowHom Ω X fX m) fX).isClosedMap _ hr
      have hsnd : IsClosed ({Limits.pullback.snd (wcPowHom Ω X fX m) fX r} : Set X) := by
        rw [← Set.image_singleton]
        exact (Limits.pullback.snd (wcPowHom Ω X fX m) fX).isClosedMap _ hr
      obtain ⟨h1, h2⟩ := ih _ hfst
      have hne : Limits.pullback.snd (wcPowHom Ω X fX m) fX r ≠ genericPoint X := by
        intro h
        rw [h] at hsnd
        exact hηnc hsnd
      refine ⟨?_, ?_⟩
      · show ((wcPowDiv Ω X fX m (Limits.pullback.fst (wcPowHom Ω X fX m) fX r) +
          Finsupp.single (Limits.pullback.snd (wcPowHom Ω X fX m) fX r) 1 : X →₀ ℤ))
            (genericPoint X) = 0
        rw [Finsupp.add_apply, h1, Finsupp.single_apply, if_neg hne]
        simp
      · show ((wcPowDiv Ω X fX m (Limits.pullback.fst (wcPowHom Ω X fX m) fX r) +
          Finsupp.single (Limits.pullback.snd (wcPowHom Ω X fX m) fX r) 1 : X →₀ ℤ)).sum
            (fun _ k => k) = ((m + 1 : ℕ) : ℤ)
        rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
          Finsupp.sum_single_index rfl, h2]
        push_cast
        ring

  haveI := hprop d
  haveI hJ : JacobsonSpace (wcP2 Ω X fX d d) :=
    LocallyOfFiniteType.jacobsonSpace
      (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫ wcPowHom Ω X fX d)

  have hcover : ∀ (F : Set (wcP2 Ω X fX d d)), IsClosed F →
      ∀ (s : Finset (X →₀ ℤ)) (K : (X →₀ ℤ) → Set (wcP2 Ω X fX d d)),
      (∀ t ∈ s, IsClosed (K t)) → F ⊆ ⋃ t ∈ s, K t →
      (∀ t ∈ s, ∀ (w : ℕ) (ch : Fin (w + 1) → Set (wcP2 Ω X fX d d)), StrictMono ch →
        (∀ k, IsClosed (ch k) ∧ IsIrreducible (ch k) ∧ ch k ⊆ K t ∩ F) → w ≤ d - g) →
      topologicalKrullDim ↥F ≤ ((d - g : ℕ) : WithBot ℕ∞) := by
    intro F hFc s K hK hFK hch
    unfold topologicalKrullDim Order.krullDim
    refine iSup_le fun p => ?_
    let ch : Fin (p.length + 1) → Set (wcP2 Ω X fX d d) :=
      fun k => Subtype.val '' ((p k : Set F))
    have hmono : StrictMono ch := by
      intro a b hab
      exact Subtype.val_injective.image_strictMono
        (show ((p a : Set F)) < (p b : Set F) from p.strictMono hab)
    have hcl : ∀ k, IsClosed (ch k) := fun k => hFc.isClosedMap_subtype_val _ (p k).isClosed
    have hirr : ∀ k, IsIrreducible (ch k) := fun k =>
      (p k).isIrreducible.image _ continuous_subtype_val.continuousOn
    have hsub : ∀ k, ch k ⊆ F := fun k => by
      rintro _ ⟨z, _, rfl⟩
      exact z.2
    have htop : ∀ k, ch k ⊆ ch (Fin.last _) := fun k => hmono.monotone (Fin.le_last k)
    obtain ⟨Z, hZ, hZsub⟩ := isIrreducible_iff_sUnion_isClosed.mp (hirr (Fin.last _))
      (s.image K) (by
        intro Z hZ
        obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hZ
        exact hK t ht) (by
        intro z hz
        obtain ⟨t, ht, hzt⟩ := Set.mem_iUnion₂.mp (hFK (hsub _ hz))
        exact Set.mem_sUnion.mpr ⟨K t, Finset.mem_coe.mpr (Finset.mem_image_of_mem K ht), hzt⟩)
    obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hZ
    have := hch t ht p.length ch hmono
      (fun k => ⟨hcl k, hirr k, fun z hz => ⟨hZsub (htop k hz), hsub k hz⟩⟩)
    exact_mod_cast this

  have hBη : (Finsupp.single Q (((ℓ : ℤ) - 1) * d)) (genericPoint X) = 0 := by
    rw [Finsupp.single_apply, if_neg hQ]
  have hFc : IsClosed (closure (wcIncSet Ω X fX U ω d d 1 (-(ℓ : ℤ))
        (Finsupp.single Q (((ℓ : ℤ) - 1) * d))) ∩
      (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y}) :=
    isClosed_closure.inter (IsClosed.preimage (Scheme.Hom.continuous _) hy)
  by_cases hne : ∃ z₁, z₁ ∈ closure (wcIncSet Ω X fX U ω d d 1 (-(ℓ : ℤ))
        (Finsupp.single Q (((ℓ : ℤ) - 1) * d))) ∩
      (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y} ∧
      IsClosed ({z₁} : Set (wcP2 Ω X fX d d))
  · obtain ⟨z₁, hz₁F, hz₁c⟩ := hne
    obtain ⟨-, h₁, hh₁⟩ := wc_incidence_locus_jacobson_closed_true Ω X fX hnorm hdim U hU hfin
      ω hω htrue g c hRR d d 1 (-(ℓ : ℤ)) _ hBη z₁ hz₁F.1 hz₁c
    have hy₁ : Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z₁ = y := hz₁F.2

    let good : (X →₀ ℤ) → wcP2 Ω X fX d d → Prop := fun t z =>
      z ∈ closure (wcIncSet Ω X fX U ω d d 1 (-(ℓ : ℤ))
        (Finsupp.single Q (((ℓ : ℤ) - 1) * d))) ∩
        (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y} ∧
      IsClosed ({z} : Set (wcP2 Ω X fX d d)) ∧
      ∃ h' : (FractionRing Γ(X, U))ˣ, ∀ x,
        (wcPowDiv Ω X fX d (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z) -
          wcPowDiv Ω X fX d (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z₁)) x =
          t x + ω x (Additive.ofMul h')
    let K : (X →₀ ℤ) → Set (wcP2 Ω X fX d d) := fun t =>
      if h : ∃ z, good t z then
        closure (wcIncSet Ω X fX U ω d d 0 (-1)
          (wcPowDiv Ω X fX d (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)
            (Classical.choose h))) ∩
          (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y})
      else ∅
    have hKc : ∀ t, IsClosed (K t) := by
      intro t
      simp only [K]
      split_ifs
      · exact isClosed_closure
      · exact isClosed_empty
    refine hcover _ hFc T K (fun t _ => hKc t) ?_ ?_
    ·
      have hsubc : closure (wcIncSet Ω X fX U ω d d 1 (-(ℓ : ℤ))
            (Finsupp.single Q (((ℓ : ℤ) - 1) * d))) ∩
          (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y} ∩
          closedPoints (wcP2 Ω X fX d d) ⊆ ⋃ t ∈ T, K t := by
        rintro z ⟨hzF, hzc'⟩
        have hzc : IsClosed ({z} : Set (wcP2 Ω X fX d d)) := mem_closedPoints_iff.mp hzc'
        obtain ⟨-, h, hh⟩ := wc_incidence_locus_jacobson_closed_true Ω X fX hnorm hdim U hU hfin
          ω hω htrue g c hRR d d 1 (-(ℓ : ℤ)) _ hBη z hzF.1 hzc
        have hyz : Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z = y := hzF.2
        obtain ⟨t, ht, h', hh'⟩ := hT
          (wcPowDiv Ω X fX d (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z) -
            wcPowDiv Ω X fX d (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) z₁))
          ⟨h * h₁⁻¹, fun x => by
            have e1 := hh x
            have e2 := hh₁ x
            rw [hyz] at e1
            rw [hy₁] at e2
            rw [Finsupp.sub_apply, ofMul_mul, map_add, ofMul_inv, map_neg]
            linear_combination (-1 : ℤ) * e1 + e2⟩
        have hgood : good t z := ⟨hzF, hzc, h', hh'⟩
        have hex : ∃ z, good t z := ⟨z, hgood⟩
        refine Set.mem_iUnion₂.mpr ⟨t, ht, ?_⟩
        simp only [K, dif_pos hex]
        obtain ⟨-, -, ht', hht'⟩ := Classical.choose_spec hex
        refine subset_closure ⟨?_, hzF.2⟩
        simp only [wcIncSet, Set.mem_setOf_eq]
        refine ⟨hzc, h' * ht'⁻¹, fun x => ?_⟩
        have e1 := hh' x
        have e2 := hht' x
        rw [Finsupp.sub_apply] at e1 e2
        rw [ofMul_mul, map_add, ofMul_inv, map_neg]
        linear_combination (-1 : ℤ) * e1 + e2
      intro z hz
      rw [← closure_inter_closedPoints hFc] at hz
      exact closure_minimal hsubc (isClosed_biUnion_finset (fun t _ => hKc t)) hz
    ·
      intro t _ w ch hmono hch
      by_cases hex : ∃ z, good t z
      · obtain ⟨-, hztc, -, -⟩ := Classical.choose_spec hex
        have hsndc : IsClosed ({Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)
            (Classical.choose hex)} : Set (wcPow Ω X fX d)) := by
          rw [← Set.image_singleton]
          exact (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)).isClosedMap _ hztc
        obtain ⟨hDη, hDdeg⟩ := hdiv d _ hsndc
        have hDc : (c : ℤ) ≤ (wcPowDiv Ω X fX d (Limits.pullback.snd (wcPowHom Ω X fX d)
            (wcPowHom Ω X fX d) (Classical.choose hex))).sum (fun _ k => k) := by
          rw [hDdeg]
          exact_mod_cast hdc
        have hbound := wc_fibre_linsys_chain_bound Ω X fX hnorm hdim U hU hfin ω hω htrue g c hRR
          d y hy _ hDη hDc w ch hmono (fun k => ⟨(hch k).1, (hch k).2.1, by
            have h := (hch k).2.2
            simp only [K, dif_pos hex] at h
            exact fun z hz => (h hz).1⟩)
        have hrr := (hRR _ hDη hDc).2
        rw [hrr, hDdeg] at hbound
        omega
      · exfalso
        have h := (hch 0).2.2
        simp only [K, dif_neg hex] at h
        obtain ⟨z, hz⟩ := (hch 0).2.1.nonempty
        exact (h hz).1
  ·
    refine hcover _ hFc ∅ (fun _ => ∅) (by simp) ?_ (by simp)
    intro z hz
    rw [← closure_inter_closedPoints hFc] at hz
    have hempty : closure (wcIncSet Ω X fX U ω d d 1 (-(ℓ : ℤ))
            (Finsupp.single Q (((ℓ : ℤ) - 1) * d))) ∩
          (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y} ∩
          closedPoints (wcP2 Ω X fX d d) = ∅ :=
      Set.eq_empty_iff_forall_notMem.mpr fun z hz => hne ⟨z, hz.1, mem_closedPoints_iff.mp hz.2⟩
    rw [hempty, closure_empty] at hz
    exact absurd hz (Set.notMem_empty z)

theorem wc_curve_incidence_variety : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ord →
    ∀ Q : X, Q ∉ U →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ord D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ord D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ T : Finset (X →₀ ℤ), (∀ D : X →₀ ℤ,
      (∃ f : (FractionRing Γ(X, U))ˣ, ∀ x, (ℓ : ℤ) * D x = ord x (Additive.ofMul f)) →
      ∃ t ∈ T, ∃ h : (FractionRing Γ(X, U))ˣ, ∀ x, D x = t x + ord x (Additive.ofMul h)) →
    ∃ (d e : ℕ) (Y Z : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) (fZ : Z ⟶ Spec (.of Ω)) (p : Z ⟶ Y),
      1 ≤ d ∧ IrreducibleSpace Y ∧ LocallyOfFiniteType fY ∧ QuasiCompact fY ∧ IsSeparated fY ∧
      IsProper fZ ∧ p ≫ fY = fZ ∧
      topologicalKrullDim Y = ((d : ℕ) : WithBot ℕ∞) ∧
      ((d + e : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim Z ∧
      (∀ y : Y, IsClosed ({y} : Set Y) →
        topologicalKrullDim (p ⁻¹' ({y} : Set Y)) ≤ ((e : ℕ) : WithBot ℕ∞)) ∧
      ∀ F : X →₀ ℤ, F (genericPoint X) = 0 → (∀ x, 0 ≤ F x) → F.sum (fun _ k => k) = d →
        ∃ y : Y, ∀ z : Z, p z = y → ∃ (E : X →₀ ℤ) (h : (FractionRing Γ(X, U))ˣ),
          ∀ x, (ℓ : ℤ) * E x = F x + Finsupp.single Q (((ℓ : ℤ) - 1) * d) x +
            ord x (Additive.ofMul h) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ℓ hℓ ord hord Q hQ g c hRR T hT
  classical
  have hηU : genericPoint X ∈ U := by
    have hx : hU.fromSpec (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum Γ(X, U)) ∈ U := by
      rw [← SetLike.mem_coe, ← hU.range_fromSpec]
      exact ⟨_, rfl⟩
    exact (genericPoint_specializes _).mem_open U.isOpen hx

  obtain ⟨σ, ordT, hσU, hσord, hordT, htrue⟩ :=
    wc_curve_ord_transport Ω X fX hnorm hdim U hU hfin ord hord g c hRR
  have hση : σ (genericPoint X) = genericPoint X := hσU _ hηU
  have hσsη : σ.symm (genericPoint X) = genericPoint X := σ.symm_apply_eq.mpr hση.symm
  have hRRT : ∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ordT D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ordT D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g := by
    intro D' hD'η hD'c
    have hDx : ∀ x, (Finsupp.equivMapDomain σ.symm D') x = D' (σ x) := fun x => by
      rw [Finsupp.equivMapDomain_apply, Equiv.symm_symm]
    have hDη : (Finsupp.equivMapDomain σ.symm D') (genericPoint X) = 0 := by
      rw [hDx, hση, hD'η]
    have hdeg : (Finsupp.equivMapDomain σ.symm D').sum (fun _ k => k) =
        D'.sum (fun _ k => k) := by
      rw [Finsupp.sum_equivMapDomain]
    have hspace : wcRRSpace Ω X fX U ord (Finsupp.equivMapDomain σ.symm D') =
        wcRRSpace Ω X fX U ordT D' := by
      unfold wcRRSpace
      congr 1
      ext f
      simp only [Set.mem_setOf_eq]
      constructor
      · rintro ⟨hf, H⟩
        refine ⟨hf, fun y => ?_⟩
        have := H (σ.symm y)
        rw [hσord, hDx, Equiv.apply_symm_apply] at this
        exact this
      · rintro ⟨hf, H⟩
        refine ⟨hf, fun x => ?_⟩
        rw [hσord, hDx]
        exact H (σ x)
    have h := hRR _ hDη (by rw [hdeg]; exact hD'c)
    rw [hspace, hdeg] at h
    exact h
  have hTT : ∀ D : X →₀ ℤ,
      (∃ f : (FractionRing Γ(X, U))ˣ, ∀ x, (ℓ : ℤ) * D x = ordT x (Additive.ofMul f)) →
      ∃ t ∈ T.image (Finsupp.equivMapDomain σ), ∃ h : (FractionRing Γ(X, U))ˣ,
        ∀ x, D x = t x + ordT x (Additive.ofMul h) := by
    rintro D' ⟨f, hf⟩
    obtain ⟨t, ht, h, hh⟩ := hT (Finsupp.equivMapDomain σ.symm D') ⟨f, fun x => by
      rw [Finsupp.equivMapDomain_apply, Equiv.symm_symm, hf, hσord]⟩
    refine ⟨Finsupp.equivMapDomain σ t, Finset.mem_image_of_mem _ ht, h, fun y => ?_⟩
    have := hh (σ.symm y)
    rw [Finsupp.equivMapDomain_apply, Equiv.symm_symm, Equiv.apply_symm_apply, hσord,
      Equiv.apply_symm_apply] at this
    rw [Finsupp.equivMapDomain_apply]
    exact this
  have hQ'η : σ Q ≠ genericPoint X := by
    intro h
    apply hQ
    rw [σ.injective (h.trans hση.symm)]
    exact hηU

  obtain ⟨d, hd1, hdc, hdg⟩ : ∃ d : ℕ, 1 ≤ d ∧ c ≤ d ∧ g ≤ d :=
    ⟨max c (max g 1), le_trans (le_max_right _ _) (le_max_right _ _), le_max_left _ _,
      le_trans (le_max_left _ _) (le_max_right _ _)⟩

  obtain ⟨hYirr, hYprop, hYdim⟩ := wc_pow_geometry Ω X fX hnorm hdim d
  haveI := hYprop

  let B : X →₀ ℤ := Finsupp.single (σ Q) (((ℓ : ℤ) - 1) * d)
  have hBη : B (genericPoint X) = 0 := by simp [B, Finsupp.single_apply, hQ'η]
  let S₀ := wcIncSet Ω X fX U ordT d d 1 (-(ℓ : ℤ)) B
  let I := Scheme.IdealSheafData.vanishingIdeal
    (⟨closure S₀, isClosed_closure⟩ : TopologicalSpace.Closeds (wcP2 Ω X fX d d))
  have hrange : Set.range I.subschemeι = closure S₀ :=
    (Scheme.IdealSheafData.range_subschemeι I).trans
      (Scheme.IdealSheafData.coe_support_vanishingIdeal _)
  have hZdimEq : topologicalKrullDim I.subscheme = topologicalKrullDim (closure S₀) := by
    rw [IsHomeomorph.topologicalKrullDim_eq _
      (I.subschemeι.isClosedEmbedding.isEmbedding.toHomeomorph).isHomeomorph, hrange]
  haveI : CompactSpace I.subscheme := QuasiCompact.compactSpace_of_compactSpace
    (I.subschemeι ≫ Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫
      wcPowHom Ω X fX d)
  refine ⟨d, d - g, wcPow Ω X fX d, I.subscheme, wcPowHom Ω X fX d,
    I.subschemeι ≫ Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) ≫
      wcPowHom Ω X fX d,
    I.subschemeι ≫ Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d),
    hd1, hYirr, inferInstance, inferInstance, inferInstance, inferInstance,
    by rw [Category.assoc], hYdim, ?_, ?_, ?_⟩
  ·
    rw [hZdimEq]
    exact wc_incidence_closure_dim_ge Ω X fX hnorm hdim U hU hfin ordT hordT htrue g c hRRT
      ℓ hℓ (σ Q) hQ'η d hd1 hdg
  ·
    intro y hy
    have hind : Topology.IsInducing (fun z : (I.subschemeι ≫ Limits.pullback.fst (wcPowHom Ω X fX d)
        (wcPowHom Ω X fX d)) ⁻¹' ({y} : Set (wcPow Ω X fX d)) => I.subschemeι z.1) :=
      I.subschemeι.isClosedEmbedding.isEmbedding.isInducing.comp Topology.IsInducing.subtypeVal
    have hmem : ∀ z : (I.subschemeι ≫ Limits.pullback.fst (wcPowHom Ω X fX d)
        (wcPowHom Ω X fX d)) ⁻¹' ({y} : Set (wcPow Ω X fX d)),
        I.subschemeι z.1 ∈ closure S₀ ∩
          (Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)) ⁻¹' {y} := by
      intro z
      refine ⟨hrange ▸ ⟨z.1, rfl⟩, ?_⟩
      have hz := z.2
      simp only [Set.mem_preimage, Set.mem_singleton_iff] at hz ⊢
      rw [← Scheme.Hom.comp_apply]
      exact hz
    exact (hind.codRestrict hmem).topologicalKrullDim_le.trans
      (wc_incidence_fibre_dim_le Ω X fX hnorm hdim U hU hfin ℓ hℓ ordT hordT htrue g c hRRT
        (T.image (Finsupp.equivMapDomain σ)) hTT (σ Q) hQ'η d hd1 hdc hdg y hy)
  ·
    intro F hFη hFnn hFdeg
    have hF'η : (Finsupp.equivMapDomain σ F) (genericPoint X) = 0 := by
      rw [Finsupp.equivMapDomain_apply, hσsη]; exact hFη
    have hF'nn : ∀ x, 0 ≤ (Finsupp.equivMapDomain σ F) x := fun x => by
      rw [Finsupp.equivMapDomain_apply]; exact hFnn _
    have hF'deg : (Finsupp.equivMapDomain σ F).sum (fun _ k => k) = (d : ℤ) := by
      rw [Finsupp.sum_equivMapDomain]; exact hFdeg
    obtain ⟨y, hyc, hyF⟩ :=
      wc_pow_closed_point_of_effective Ω X fX hdim d _ hF'η hF'nn hF'deg
    refine ⟨y, fun z hz => ?_⟩
    obtain ⟨z', hz'mem, hz'c⟩ :=
      (isClosed_closure : IsClosed (closure ({z} : Set I.subscheme))).exists_closed_singleton
        ⟨z, subset_closure (Set.mem_singleton z)⟩
    have hpz' : (I.subschemeι ≫ Limits.pullback.fst (wcPowHom Ω X fX d)
        (wcPowHom Ω X fX d)) z' = y := by
      have h1 := map_mem_closure (I.subschemeι ≫ Limits.pullback.fst (wcPowHom Ω X fX d)
        (wcPowHom Ω X fX d)).continuous hz'mem
        (Set.mapsTo_singleton.mpr (Set.mem_singleton _))
      rw [hz, hyc.closure_eq] at h1
      exact h1
    have hfst : Limits.pullback.fst (wcPowHom Ω X fX d) (wcPowHom Ω X fX d)
        (I.subschemeι z') = y := by
      rw [← Scheme.Hom.comp_apply]; exact hpz'
    have hz'closed : IsClosed ({I.subschemeι z'} : Set (wcP2 Ω X fX d d)) := by
      rw [← Set.image_singleton]
      exact I.subschemeι.isClosedEmbedding.isClosedMap _ hz'c
    have hz'in : I.subschemeι z' ∈ closure S₀ := hrange ▸ ⟨z', rfl⟩
    obtain ⟨-, h, hh⟩ := wc_incidence_locus_jacobson_closed_true Ω X fX hnorm hdim U hU hfin
      ordT hordT htrue g c hRRT d d 1 (-(ℓ : ℤ)) B hBη _ hz'in hz'closed
    refine ⟨Finsupp.equivMapDomain σ.symm (wcPowDiv Ω X fX d
      (Limits.pullback.snd (wcPowHom Ω X fX d) (wcPowHom Ω X fX d) (I.subschemeι z'))), h,
      fun x => ?_⟩
    have hx := hh (σ x)
    rw [hfst, hyF] at hx
    have h1 : (Finsupp.equivMapDomain σ F) (σ x) = F x := by
      rw [Finsupp.equivMapDomain_apply, Equiv.symm_apply_apply]
    have h2 : B (σ x) = Finsupp.single Q (((ℓ : ℤ) - 1) * d) x :=
      Finsupp.single_apply_left σ.injective Q x (((ℓ : ℤ) - 1) * d)
    rw [h1, h2] at hx
    rw [Finsupp.equivMapDomain_apply, Equiv.symm_symm, hσord x]
    linear_combination (-1 : ℤ) * hx

theorem wc_curve_classGroup_ell_divisible : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)], IsAffineOpen U → ((U : Set X)ᶜ).Finite →
    ∀ ℓ : ℕ, ℓ.Prime → (ℓ : Ω) ≠ 0 →
    ∀ c : ClassGroup Γ(X, U), ∃ d : ClassGroup Γ(X, U), d ^ ℓ = c :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim U _ hU hfin ℓ hℓ hℓΩ
  classical
  haveI := hirr
  obtain ⟨ψ₀, hψs, hψk⟩ := dedekind_classGroup_divisor_presentation Γ(X, U)

  have hgen : ∀ v : IsDedekindDomain.HeightOneSpectrum Γ(X, U),
      ∃ m, ψ₀ (Finsupp.single v 1) = ℓ • ψ₀ m := by
    intro v
    by_cases hB : ((U : Set X)ᶜ).Nonempty
    · obtain ⟨Q, hQ⟩ := hB
      obtain ⟨ord, hord⟩ := wc_curve_ord_data_exists Ω X fX hnorm hdim U hU hfin
      obtain ⟨hηU, hinj, hvU, -⟩ := wc_dedekind_affine_points X U hU
      have hQη : Q ≠ genericPoint X := fun h => hQ (h ▸ hηU)
      obtain ⟨g, c0, hRR⟩ :=
        wc_curve_riemann_roch_large_degree Ω X fX hnorm hdim U hU hfin ord hord
      have htor := wc_curve_classGroup_ell_torsion_finite Ω X fX hirr hnorm hdim U hU hfin ℓ hℓ hℓΩ
      obtain ⟨T, hT⟩ :=
        wc_curve_proper_ell_torsion_reps Ω X fX hnorm hdim U hU hfin ℓ hℓ ord hord htor
      obtain ⟨d, e, Y, Z, fY, fZ, p, hd1, hYirr, hYft, hYqc, hYsep, hZprop, hpcomm, hYdim, hZdim,
        hfib, hlink⟩ :=
        wc_curve_incidence_variety Ω X fX hnorm hdim U hU hfin ℓ hℓ ord hord Q hQ g c0 hRR T hT
      haveI := hYirr
      haveI := hYft
      haveI := hYqc
      haveI := hYsep
      haveI := hZprop
      have hpsurj : Function.Surjective p :=
        closed_points_surjective_of_fibre_dim Ω Y Z fY fZ p hpcomm d e hYdim hZdim hfib
      let xv : X := hU.fromSpec ⟨v.asIdeal, v.isPrime⟩
      let F : X →₀ ℤ := Finsupp.single xv 1 + Finsupp.single Q ((d : ℤ) - 1)
      have hFη : F (genericPoint X) = 0 := by
        simp only [F, Finsupp.add_apply, Finsupp.single_apply]
        rw [if_neg (hvU v).2, if_neg hQη]
        simp
      have hFnn : ∀ x, 0 ≤ F x := by
        intro x
        simp only [F, Finsupp.add_apply, Finsupp.single_apply]
        have hd : (0 : ℤ) ≤ (d : ℤ) - 1 := by omega
        split_ifs <;> omega
      have hFdeg : F.sum (fun _ k => k) = d := by
        simp only [F]
        rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
          Finsupp.sum_single_index rfl, Finsupp.sum_single_index rfl]
        ring
      obtain ⟨y, hy⟩ := hlink F hFη hFnn hFdeg
      obtain ⟨z, hz⟩ := hpsurj y
      obtain ⟨E, h, hE⟩ := hy z hz
      let xw : IsDedekindDomain.HeightOneSpectrum Γ(X, U) → X :=
        fun w => hU.fromSpec ⟨w.asIdeal, w.isPrime⟩
      let m : IsDedekindDomain.HeightOneSpectrum Γ(X, U) →₀ ℤ :=
        Finsupp.comapDomain xw E hinj.injOn
      have hm : ∀ w, m w = E (xw w) := fun w => Finsupp.comapDomain_apply _ _ _ _
      have hker : ψ₀ (Finsupp.single v 1 - ℓ • m) = 0 := by
        rw [hψk]
        refine ⟨h⁻¹, fun w => ?_⟩
        rw [← hord.2.1 w h⁻¹]
        have hneQ : xw w ≠ Q := fun h' => hQ (h' ▸ (hvU w).1)
        have hxw := hE (xw w)
        rw [Finsupp.single_apply, if_neg (Ne.symm hneQ), add_zero] at hxw
        have hFw : F (xw w) = if v = w then 1 else 0 := by
          simp only [F, Finsupp.add_apply, Finsupp.single_apply]
          rw [if_neg (Ne.symm hneQ), add_zero]
          by_cases hvw : v = w
          · subst hvw
            rw [if_pos rfl, if_pos rfl]
          · rw [if_neg hvw, if_neg (fun h' => hvw (hinj h'))]
        rw [Finsupp.sub_apply, Finsupp.smul_apply, hm, Finsupp.single_apply, nsmul_eq_mul,
          hxw, hFw, ofMul_inv, map_neg]
        ring
      refine ⟨m, ?_⟩
      rw [map_sub, map_nsmul, sub_eq_zero] at hker
      exact hker
    · exfalso
      have hUuniv : (U : Set X) = Set.univ :=
        Set.compl_empty_iff.mp (Set.not_nonempty_iff_eq_empty.mp hB)
      have hUtop : U = ⊤ := by
        apply le_antisymm le_top
        intro x _
        have hx : x ∈ (U : Set X) := by rw [hUuniv]; trivial
        exact hx
      subst hUtop
      let φ : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
      have hφint : φ.IsIntegral := by
        refine RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ ?_)
          (isIntegral_appTop_of_universallyClosed fX)
        intro y
        refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y, ?_⟩
        change ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
          (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom y = y
        rw [Iso.hom_inv_id]
        rfl
      have hsurj : Function.Surjective φ := by
        letI : Algebra Ω Γ(X, ⊤) := φ.toAlgebra
        intro s
        have hs : _root_.IsIntegral Ω s := hφint s
        have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
        obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
        exact ⟨c, hc⟩
      obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot v.ne_bot
      obtain ⟨c, rfl⟩ := hsurj a
      have hc0 : c ≠ 0 := by
        rintro rfl
        exact ha0 (map_zero φ)
      have hunit : IsUnit (φ c) := (IsUnit.mk0 c hc0).map φ
      exact v.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ ha hunit)

  have hall : ∀ n, ∃ m, ψ₀ n = ℓ • ψ₀ m := by
    intro n
    induction n using Finsupp.induction_linear with
    | zero => exact ⟨0, by simp⟩
    | add a b ha hb =>
      obtain ⟨m1, h1⟩ := ha
      obtain ⟨m2, h2⟩ := hb
      exact ⟨m1 + m2, by rw [map_add, map_add, h1, h2, smul_add]⟩
    | single v k =>
      obtain ⟨m, hm⟩ := hgen v
      refine ⟨k • m, ?_⟩
      have hk : Finsupp.single v k = k • Finsupp.single v (1 : ℤ) := by
        rw [Finsupp.smul_single, smul_eq_mul, mul_one]
      rw [hk, map_zsmul, hm, map_zsmul, smul_comm]
  intro c
  obtain ⟨n, hn⟩ := hψs (Additive.ofMul c)
  obtain ⟨m, hm⟩ := hall n
  refine ⟨Additive.toMul (ψ₀ m), ?_⟩
  rw [← toMul_nsmul, ← hm, hn, toMul_ofMul]

theorem wc_char_pbasis (Ω K : Type u) [Field Ω] [IsAlgClosed Ω] [Field K] [Algebra Ω K]
    (p : ℕ) [Fact p.Prime] [CharP K p] (hA6 : wcRRFinRank Ω K) (t : K)
    (ht : t ∉ Set.range (algebraMap Ω K)) :
    (∃ y : K, ∀ z : K, z ^ p ≠ y) ∧
      ∀ y : K, (∀ z : K, z ^ p ≠ y) → ∀ g : K,
        ∃! h : Fin p → K, g = ∑ i : Fin p, h i ^ p * y ^ (i : ℕ) :=
by
  classical
  have hp : Fact p.Prime := ‹_›

  have T_s4 : ∀ (Fp : IntermediateField Ω K), (∀ x : K, x ∈ Fp ↔ ∃ z : K, z ^ p = x) →
      Module.finrank Fp K = p → (∃ y : K, ∀ z : K, z ^ p ≠ y) ∧ ∀ y : K,
      (∀ z : K, z ^ p ≠ y) → ∀ g : K, ∃! h : Fin p → K, g = ∑ i : Fin p, h i ^ p * y ^ (i : ℕ) := by
    intro Fp hF hdeg
    have hp1 := hp.out.one_lt
    have finj : ∀ a b : K, a ^ p = b ^ p → a = b := fun a b h =>
      frobenius_inj K p (by rw [frobenius_def, frobenius_def]; exact h)
    constructor
    · by_contra hcon
      push_neg at hcon
      have htop : Fp = ⊤ := by
        rw [eq_top_iff]
        intro x _
        obtain ⟨z, hz⟩ := hcon x
        exact (hF x).2 ⟨z, hz⟩
      subst htop
      rw [← IntermediateField.relfinrank_top_right, IntermediateField.relfinrank_self] at hdeg
      omega
    · intro y hy g
      have hyF : y ∉ Fp := fun h => by
        obtain ⟨z, hz⟩ := (hF y).1 h
        exact hy z hz
      have hypF : y ^ p ∈ Fp := (hF _).2 ⟨y, rfl⟩
      set a : Fp := ⟨y ^ p, hypF⟩ with ha
      have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C a) := by
        apply X_pow_sub_C_irreducible_of_prime hp.out
        intro b hb
        apply hyF
        have h1 : (b : K) ^ p = y ^ p := by
          have := congrArg (fun x : Fp => (x : K)) hb
          simpa [a] using this
        rw [← finj _ _ h1]
        exact b.2
      have hmon : (Polynomial.X ^ p - Polynomial.C a).Monic :=
        Polynomial.monic_X_pow_sub_C a hp.out.ne_zero
      have hev : Polynomial.aeval y (Polynomial.X ^ p - Polynomial.C a) = 0 := by
        simp [a]
      have hmin := minpoly.eq_of_irreducible_of_monic hirr hev hmon
      have hdegm : (minpoly Fp y).natDegree = p := by
        rw [← hmin, Polynomial.natDegree_X_pow_sub_C]
      have hli0 := linearIndependent_pow (K := Fp) y
      have hli : LinearIndependent Fp (fun i : Fin p => y ^ (i : ℕ)) :=
        hli0.comp (Fin.cast hdegm.symm) (Fin.cast_injective _)
      haveI : FiniteDimensional Fp K := Module.finite_of_finrank_pos (by omega)
      have hspan := hli.span_eq_top_of_card_eq_finrank' (by rw [Fintype.card_fin, hdeg])
      have hsmul : ∀ h : Fin p → K, ∑ i : Fin p,
          (⟨h i ^ p, (hF _).2 ⟨h i, rfl⟩⟩ : Fp) • y ^ (i : ℕ) = ∑ i : Fin p, h i ^ p * y ^ (i : ℕ) :=
        fun h => Finset.sum_congr rfl fun i _ => rfl
      have huniq : ∀ h h' : Fin p → K, g = ∑ i : Fin p, h i ^ p * y ^ (i : ℕ) →
          g = ∑ i : Fin p, h' i ^ p * y ^ (i : ℕ) → h = h' := by
        intro h h' e e'
        have hz := (Fintype.linearIndependent_iff.1 hli) (fun i =>
          (⟨h i ^ p, (hF _).2 ⟨h i, rfl⟩⟩ : Fp) - ⟨h' i ^ p, (hF _).2 ⟨h' i, rfl⟩⟩) (by
            simp only [sub_smul, Finset.sum_sub_distrib]
            rw [hsmul h, hsmul h', ← e, ← e', sub_self])
        funext i
        have := congrArg (fun x : Fp => (x : K)) (sub_eq_zero.1 (hz i))
        exact finj _ _ this
      have hg : g ∈ Submodule.span Fp (Set.range fun i : Fin p => y ^ (i : ℕ)) := by
        rw [hspan]; trivial
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun Fp).1 hg
      choose h hh using fun i => (hF (c i : K)).1 (c i).2
      have hrep : g = ∑ i : Fin p, h i ^ p * y ^ (i : ℕ) := by
        rw [← hc]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [hh i]
        rfl
      exact ⟨h, hrep, fun h' e' => huniq _ _ e' hrep⟩

  have T_s2 : ∀ t : K, Transcendental Ω t →
      (IntermediateField.adjoin Ω ({t ^ p} : Set K)).relfinrank
        (IntermediateField.adjoin Ω ({t} : Set K)) = p := by
    intro t ht
    have hp0 : 0 < p := hp.out.pos
    have finj : ∀ a b : K, a ^ p = b ^ p → a = b := fun a b h =>
      frobenius_inj K p (by rw [frobenius_def, frobenius_def]; exact h)
    set E0 := IntermediateField.adjoin Ω ({t ^ p} : Set K) with hE0
    have htE0 : t ∉ E0 := by
      intro hmem
      obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff Ω t).1 hmem
      have hS : Polynomial.aeval (t ^ p) s ≠ 0 := by
        intro h0
        rw [h0, div_zero] at hrs
        exact ht.ne_zero hrs
      have hs0 : s ≠ 0 := by
        rintro rfl
        simp at hS
      have heq : t * Polynomial.aeval (t ^ p) s = Polynomial.aeval (t ^ p) r := by
        rw [eq_div_iff hS] at hrs
        exact hrs
      have hpoly : Polynomial.X * Polynomial.expand Ω p s - Polynomial.expand Ω p r = 0 := by
        have h1 : Polynomial.aeval t
            (Polynomial.X * Polynomial.expand Ω p s - Polynomial.expand Ω p r) = 0 := by
          rw [map_sub, map_mul, Polynomial.aeval_X, Polynomial.expand_aeval, Polynomial.expand_aeval,
            heq, sub_self]
        by_contra hne
        exact ht ⟨_, hne, h1⟩
      have hc := congrArg (fun q => Polynomial.coeff q (s.natDegree * p + 1)) hpoly
      simp only [Polynomial.coeff_sub, Polynomial.coeff_X_mul, Polynomial.coeff_expand_mul hp0,
        Polynomial.coeff_zero] at hc
      rw [Polynomial.coeff_expand hp0, if_neg, sub_zero] at hc
      · exact Polynomial.leadingCoeff_ne_zero.2 hs0 hc
      · intro hd
        have h1 : p ∣ 1 := (Nat.dvd_add_right (dvd_mul_left p _)).1 hd
        exact hp.out.one_lt.ne' (Nat.dvd_one.1 h1)
    have hle : E0 ≤ IntermediateField.adjoin Ω ({t} : Set K) := by
      rw [IntermediateField.adjoin_simple_le_iff]
      exact pow_mem (IntermediateField.mem_adjoin_simple_self Ω t) p
    rw [IntermediateField.relfinrank_eq_finrank_of_le hle, IntermediateField.extendScalars_adjoin hle]
    set a : E0 := ⟨t ^ p, IntermediateField.mem_adjoin_simple_self Ω (t ^ p)⟩ with ha
    have hirr : Irreducible (Polynomial.X ^ p - Polynomial.C a) := by
      apply X_pow_sub_C_irreducible_of_prime hp.out
      intro b hb
      apply htE0
      have h1 : (b : K) ^ p = t ^ p := by
        have := congrArg (fun x : E0 => (x : K)) hb
        simpa [a] using this
      rw [← finj _ _ h1]
      exact b.2
    have hmon : (Polynomial.X ^ p - Polynomial.C a).Monic :=
      Polynomial.monic_X_pow_sub_C a hp.out.ne_zero
    have hev : Polynomial.aeval t (Polynomial.X ^ p - Polynomial.C a) = 0 := by
      simp [a]
    have hmin := minpoly.eq_of_irreducible_of_monic hirr hev hmon
    have hint : IsIntegral E0 t := ⟨_, hmon, by rwa [← Polynomial.aeval_def]⟩
    rw [IntermediateField.adjoin.finrank hint, ← hmin, Polynomial.natDegree_X_pow_sub_C]

  have T_s3 : ∀ (t : K) (Fp : IntermediateField Ω K) (hF : ∀ x : K, x ∈ Fp ↔ ∃ z : K, z ^ p = x)
      (hle : IntermediateField.adjoin Ω ({t ^ p} : Set K) ≤ Fp),
      Module.finrank (IntermediateField.adjoin Ω ({t ^ p} : Set K))
        (IntermediateField.extendScalars hle) =
      Module.finrank (IntermediateField.adjoin Ω ({t} : Set K)) K := by
    intro t Fp hF hle
    have finj : ∀ a b : K, a ^ p = b ^ p → a = b := fun a b h =>
      frobenius_inj K p (by rw [frobenius_def, frobenius_def]; exact h)
    set E0 := IntermediateField.adjoin Ω ({t ^ p} : Set K) with hE0
    set E1 := IntermediateField.adjoin Ω ({t} : Set K) with hE1
    have hA : E1.toSubfield ≤ Subfield.comap (frobenius K p) E0.toSubfield := by
      rw [hE1, IntermediateField.adjoin_toSubfield, Subfield.closure_le]
      rintro x (⟨c, rfl⟩ | hx)
      · show frobenius K p (algebraMap Ω K c) ∈ E0
        rw [frobenius_def, ← map_pow]
        exact E0.algebraMap_mem _
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        show frobenius K p x ∈ E0
        rw [frobenius_def]
        exact IntermediateField.mem_adjoin_simple_self Ω (x ^ p)
    have hB : E0.toSubfield ≤ Subfield.map (frobenius K p) E1.toSubfield := by
      rw [hE0, IntermediateField.adjoin_toSubfield, Subfield.closure_le]
      rintro x (⟨c, rfl⟩ | hx)
      · obtain ⟨c', hc'⟩ := IsAlgClosed.exists_pow_nat_eq c hp.out.pos
        refine Subfield.mem_map.2 ⟨algebraMap Ω K c', E1.algebraMap_mem c', ?_⟩
        rw [frobenius_def, ← map_pow, hc']
      · rw [Set.mem_singleton_iff] at hx
        subst hx
        refine Subfield.mem_map.2 ⟨t, IntermediateField.mem_adjoin_simple_self Ω t, ?_⟩
        rw [frobenius_def]
    have hA' : ∀ z : K, z ∈ E1 → z ^ p ∈ E0 := fun z hz => by
      have := hA hz
      rw [Subfield.mem_comap, frobenius_def] at this
      exact this
    let i : E1 → E0 := fun z => ⟨(z : K) ^ p, hA' z z.2⟩
    have hi : Function.Bijective i := by
      constructor
      · intro a b hab
        exact Subtype.ext (finj _ _ (congrArg Subtype.val hab))
      · intro x
        obtain ⟨z, hz, hzx⟩ := Subfield.mem_map.1 (hB x.2)
        refine ⟨⟨z, hz⟩, Subtype.ext ?_⟩
        show z ^ p = (x : K)
        rw [← hzx, frobenius_def]
    let j0 : K →+ IntermediateField.extendScalars hle :=
      { toFun := fun z => ⟨z ^ p, (IntermediateField.mem_extendScalars hle).2 ((hF _).2 ⟨z, rfl⟩)⟩
        map_zero' := Subtype.ext (zero_pow hp.out.ne_zero)
        map_add' := fun a b => Subtype.ext (add_pow_char a b p) }
    have hj : Function.Bijective j0 := by
      constructor
      · intro a b hab
        exact finj _ _ (congrArg Subtype.val hab)
      · intro x
        obtain ⟨z, hz⟩ := (hF (x : K)).1 ((IntermediateField.mem_extendScalars hle).1 x.2)
        exact ⟨z, Subtype.ext hz⟩
    let j : K ≃+ IntermediateField.extendScalars hle := AddEquiv.ofBijective j0 hj
    have hcompat : ∀ (r : E1) (m : K), j (r • m) = i r • j m := by
      intro r m
      apply Subtype.ext
      change ((r : K) * m) ^ p = (r : K) ^ p * m ^ p
      exact mul_pow _ _ _
    have hrank := rank_eq_of_equiv_equiv i j hi hcompat
    exact (congrArg Cardinal.toNat hrank).symm

  have T_s1 : ∀ f : K, f ∉ Set.range (algebraMap Ω K) →
      FiniteDimensional (IntermediateField.adjoin Ω ({f} : Set K)) K := by
    intro f hf
    classical
    have htr : Transcendental Ω f := by
      intro halg
      have hint := halg.isIntegral
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hint)
      exact hf (minpoly.mem_range_of_degree_eq_one Ω f hdeg)
    obtain ⟨n, ⟨u, hI⟩, hD⟩ := hA6 f hf
    set E := IntermediateField.adjoin Ω ({f} : Set K) with hE
    have hmemE : ∀ r : Polynomial Ω, Polynomial.aeval f r ∈ E := fun r =>
      IntermediateField.algebra_adjoin_le_adjoin Ω _ (Polynomial.aeval_mem_adjoin_singleton Ω f)
    have hspan : ∀ v : K, v ∈ Submodule.span E (Set.range u) := by
      intro v
      obtain ⟨q, hq0, hq⟩ := hD (Fin.cons v u)
      rw [Fin.sum_univ_succ] at hq
      simp only [Fin.cons_zero, Fin.cons_succ] at hq
      have hq0' : q 0 ≠ 0 := by
        intro h0
        apply hq0
        have hs : (fun j : Fin n => q j.succ) = 0 := hI _ (by
          rw [h0, map_zero, zero_mul, zero_add] at hq
          exact hq)
        funext j
        refine Fin.cases ?_ (fun j => congrFun hs j) j
        exact h0
      have ha : Polynomial.aeval f (q 0) ≠ 0 := fun h => htr ⟨q 0, hq0', h⟩
      rw [Submodule.mem_span_range_iff_exists_fun]
      refine ⟨fun j => ⟨-(Polynomial.aeval f (q j.succ)) * (Polynomial.aeval f (q 0))⁻¹,
        E.mul_mem (E.neg_mem (hmemE _)) (E.inv_mem (hmemE _))⟩, ?_⟩
      change ∑ j, (-(Polynomial.aeval f (q j.succ)) * (Polynomial.aeval f (q 0))⁻¹) * u j = v
      have hS : ∑ j, Polynomial.aeval f (q j.succ) * u j = -(Polynomial.aeval f (q 0) * v) := by
        linear_combination hq
      have h2 : ∑ j, (-(Polynomial.aeval f (q j.succ)) * (Polynomial.aeval f (q 0))⁻¹) * u j =
          -(Polynomial.aeval f (q 0))⁻¹ * ∑ j, Polynomial.aeval f (q j.succ) * u j := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
      rw [h2, hS]
      field_simp
    refine Module.finite_def.2 ⟨Finset.univ.image u, ?_⟩
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, eq_top_iff]
    intro v _
    exact hspan v

  have hpp : p.Prime := hp.out
  have htr : Transcendental Ω t := by
    intro halg
    have hint := halg.isIntegral
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hint)
    exact ht (minpoly.mem_range_of_degree_eq_one Ω t hdeg)
  have htp : t ^ p ∉ Set.range (algebraMap Ω K) := by
    rintro ⟨c, hc⟩
    obtain ⟨c', hc'⟩ := IsAlgClosed.exists_pow_nat_eq c hpp.pos
    apply ht
    refine ⟨c', ?_⟩
    apply frobenius_inj K p
    rw [frobenius_def, frobenius_def, ← map_pow, hc', hc]
  have hS : ∀ c : Ω, algebraMap Ω K c ∈ (frobenius K p).fieldRange := by
    intro c
    obtain ⟨c', hc'⟩ := IsAlgClosed.exists_pow_nat_eq c hpp.pos
    exact ⟨algebraMap Ω K c', by rw [frobenius_def, ← map_pow, hc']⟩
  let Fp : IntermediateField Ω K := (frobenius K p).fieldRange.toIntermediateField hS
  have hF : ∀ x : K, x ∈ Fp ↔ ∃ z : K, z ^ p = x := by
    intro x
    change x ∈ (frobenius K p).fieldRange ↔ _
    rw [RingHom.mem_fieldRange]
    simp only [frobenius_def]
  have hle : IntermediateField.adjoin Ω ({t ^ p} : Set K) ≤ Fp := by
    rw [IntermediateField.adjoin_simple_le_iff]
    exact (hF _).2 ⟨t, rfl⟩
  have h01 : IntermediateField.adjoin Ω ({t ^ p} : Set K) ≤
      IntermediateField.adjoin Ω ({t} : Set K) := by
    rw [IntermediateField.adjoin_simple_le_iff]
    exact pow_mem (IntermediateField.mem_adjoin_simple_self Ω t) p
  haveI hfin : FiniteDimensional (IntermediateField.adjoin Ω ({t ^ p} : Set K)) K := T_s1 _ htp
  have hN : 0 < Module.finrank (IntermediateField.adjoin Ω ({t ^ p} : Set K)) K :=
    Module.finrank_pos
  have e1 := IntermediateField.relfinrank_mul_relfinrank h01
    (le_top : IntermediateField.adjoin Ω ({t} : Set K) ≤ ⊤)
  have e2 := IntermediateField.relfinrank_mul_relfinrank hle (le_top : Fp ≤ ⊤)
  rw [T_s2 t htr] at e1
  simp only [IntermediateField.relfinrank_top_right] at e1 e2
  rw [IntermediateField.relfinrank_eq_finrank_of_le hle, T_s3 t Fp hF hle] at e2
  have hn : 0 < Module.finrank (IntermediateField.adjoin Ω ({t} : Set K)) K := by
    rcases Nat.eq_zero_or_pos (Module.finrank (IntermediateField.adjoin Ω ({t} : Set K)) K)
      with h | h
    · rw [h, mul_zero] at e1
      omega
    · exact h
  have hdeg : Module.finrank Fp K = p := by
    apply Nat.eq_of_mul_eq_mul_left hn
    rw [e2, ← e1, mul_comm]
  exact T_s4 Fp hF hdeg

theorem wc_char_derivation_cartier (K : Type u) [Field K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (x : K) (hx : ∀ g : K, ∃! h : Fin p → K, g = ∑ i : Fin p, h i ^ p * x ^ (i : ℕ)) :
    ∃ (D : K →+ K) (C : K →+ K), (∀ a b, D (a * b) = a * D b + b * D a) ∧ D x = 1 ∧
      (∀ y, (⇑D)^[p] y = 0) ∧ (∀ z, D (z ^ p) = 0) ∧
      (∀ g, C g ^ p = -((⇑D)^[p - 1] g)) ∧ (∀ c g, C (c ^ p * g) = c * C g) :=
by
  classical
  have hp : p.Prime := Fact.out
  have hp0 : 0 < p := hp.pos
  have hpK : (p : K) = 0 := CharP.cast_eq_zero K p
  choose co₀ hco₀ huniq using hx
  have U : ∀ g (h : Fin p → K), g = ∑ i : Fin p, h i ^ p * x ^ (i : ℕ) → h = co₀ g :=
    fun g h hh => huniq g h hh

  have co_add : ∀ g g', co₀ (g + g') = co₀ g + co₀ g' := by
    intro g g'
    symm
    apply U
    simp only [Pi.add_apply, add_pow_char, add_mul, Finset.sum_add_distrib]
    rw [← hco₀ g, ← hco₀ g']
  have co_smul : ∀ c g, co₀ (c ^ p * g) = c • co₀ g := by
    intro c g
    symm
    apply U
    simp only [Pi.smul_apply, smul_eq_mul, mul_pow, mul_assoc]
    rw [← Finset.mul_sum, ← hco₀ g]
  have co_mono : ∀ (b : K) (n : ℕ) (i : Fin p), co₀ (b ^ p * x ^ n) i =
      if (i : ℕ) = n % p then b * x ^ (n / p) else 0 := by
    intro b n i
    have key := U (b ^ p * x ^ n)
      (fun i : Fin p => if (i : ℕ) = n % p then b * x ^ (n / p) else 0) ?_
    · exact (congrFun key i).symm
    rw [Finset.sum_eq_single (⟨n % p, Nat.mod_lt n hp0⟩ : Fin p)]
    · dsimp only
      rw [if_pos rfl, mul_pow, ← pow_mul, mul_assoc, ← pow_add, Nat.div_add_mod']
    · intro j _ hj
      have hj' : (j : ℕ) ≠ n % p := fun h => hj (Fin.ext h)
      rw [if_neg hj', zero_pow hp.ne_zero, zero_mul]
    · intro h; exact absurd (Finset.mem_univ _) h

  have Df_add : ∀ g g' : K,
      (∑ i : Fin p, ((i : ℕ) : K) * co₀ (g + g') i ^ p * x ^ ((i : ℕ) - 1)) =
      (∑ i : Fin p, ((i : ℕ) : K) * co₀ g i ^ p * x ^ ((i : ℕ) - 1)) +
      (∑ i : Fin p, ((i : ℕ) : K) * co₀ g' i ^ p * x ^ ((i : ℕ) - 1)) := by
    intro g g'
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [co_add, Pi.add_apply, add_pow_char]
    ring
  obtain ⟨D, hD⟩ : ∃ D : K →+ K, ∀ g,
      D g = ∑ i : Fin p, ((i : ℕ) : K) * co₀ g i ^ p * x ^ ((i : ℕ) - 1) :=
    ⟨AddMonoidHom.mk' (fun g => ∑ i : Fin p, ((i : ℕ) : K) * co₀ g i ^ p * x ^ ((i : ℕ) - 1))
      Df_add, fun g => rfl⟩

  have KF : ∀ (b : K) (n : ℕ), D (b ^ p * x ^ n) = (n : K) * b ^ p * x ^ (n - 1) := by
    intro b n
    rw [hD, Finset.sum_eq_single (⟨n % p, Nat.mod_lt n hp0⟩ : Fin p)]
    · rw [co_mono, if_pos rfl]
      have hn : (n : K) = ((n % p : ℕ) : K) := by
        conv_lhs => rw [← Nat.div_add_mod n p]
        push_cast
        rw [hpK]
        ring
      rw [hn]
      show ((n % p : ℕ) : K) * (b * x ^ (n / p)) ^ p * x ^ (n % p - 1) =
        ((n % p : ℕ) : K) * b ^ p * x ^ (n - 1)
      rcases Nat.eq_zero_or_pos (n % p) with h0 | hpos
      · rw [h0]; simp
      · have he : n - 1 = n / p * p + (n % p - 1) := by
          have := Nat.div_add_mod' n p
          omega
        rw [he, pow_add, pow_mul, mul_pow]
        ring
    · intro j _ hj
      have hj' : (j : ℕ) ≠ n % p := fun h => hj (Fin.ext h)
      rw [co_mono, if_neg hj', zero_pow hp.ne_zero]
      ring
    · intro h; exact absurd (Finset.mem_univ _) h

  have ML : ∀ (α β : K) (i j : ℕ), D (α ^ p * x ^ i * (β ^ p * x ^ j)) =
      α ^ p * x ^ i * D (β ^ p * x ^ j) + β ^ p * x ^ j * D (α ^ p * x ^ i) := by
    intro α β i j
    have e : α ^ p * x ^ i * (β ^ p * x ^ j) = (α * β) ^ p * x ^ (i + j) := by ring
    rw [e, KF, KF, KF]
    rcases i with _ | i <;> rcases j with _ | j <;>
      simp only [Nat.add_sub_cancel, Nat.zero_sub, pow_zero,
        Nat.cast_zero, zero_mul, mul_zero, add_zero, zero_add, Nat.cast_add, Nat.cast_one,
        show ∀ a b : ℕ, a + 1 + (b + 1) - 1 = a + b + 1 from fun a b => by omega] <;> ring

  have leib : ∀ a b, D (a * b) = a * D b + b * D a := by
    intro a b
    obtain ⟨m, hm, hma⟩ : ∃ m : Fin p → K, a = ∑ i, m i ∧
        ∀ i, ∃ α : K, ∃ k : ℕ, m i = α ^ p * x ^ k :=
      ⟨_, hco₀ a, fun i => ⟨_, _, rfl⟩⟩
    obtain ⟨m', hm', hmb⟩ : ∃ m' : Fin p → K, b = ∑ i, m' i ∧
        ∀ i, ∃ α : K, ∃ k : ℕ, m' i = α ^ p * x ^ k :=
      ⟨_, hco₀ b, fun i => ⟨_, _, rfl⟩⟩
    have hML : ∀ i j, D (m i * m' j) = m i * D (m' j) + m' j * D (m i) := by
      intro i j
      obtain ⟨α, k, hk⟩ := hma i
      obtain ⟨β, l, hl⟩ := hmb j
      rw [hk, hl]
      exact ML α β k l
    subst hm hm'
    rw [Finset.sum_mul_sum, map_sum]
    simp only [map_sum, hML, Finset.sum_add_distrib, Finset.mul_sum, Finset.sum_mul]
    congr 1
    exact Finset.sum_comm

  have IF : ∀ (k : ℕ) (b : K) (n : ℕ),
      (⇑D)^[k] (b ^ p * x ^ n) = (n.descFactorial k : K) * b ^ p * x ^ (n - k) := by
    intro k
    induction k with
    | zero => intro b n; simp
    | succ k ih =>
      intro b n
      rw [Function.iterate_succ_apply', ih, mul_assoc, ← nsmul_eq_mul, map_nsmul, KF,
        nsmul_eq_mul, Nat.descFactorial_succ, Nat.sub_sub]
      push_cast
      ring
  have Isum : ∀ (k : ℕ) (f : Fin p → K), (⇑D)^[k] (∑ i, f i) = ∑ i, (⇑D)^[k] (f i) := by
    intro k
    induction k with
    | zero => intro f; simp
    | succ k ih =>
      intro f
      rw [Function.iterate_succ_apply', ih, map_sum]
      simp only [Function.iterate_succ_apply']
  have nil : ∀ y, (⇑D)^[p] y = 0 := by
    intro y
    rw [hco₀ y, Isum]
    apply Finset.sum_eq_zero
    intro i _
    rw [IF, Nat.descFactorial_eq_zero_iff_lt.mpr i.isLt]
    simp

  have wil : (((p - 1).factorial : ℕ) : K) = -1 := by
    have h := ZMod.wilsons_lemma (p := p)
    have h2 := congrArg (ZMod.castHom (dvd_refl p) K) h
    rw [map_natCast, map_neg, map_one] at h2
    exact h2
  obtain ⟨i0, hi0⟩ : ∃ i0 : Fin p, (i0 : ℕ) = p - 1 := ⟨⟨p - 1, Nat.sub_lt hp0 one_pos⟩, rfl⟩
  have cart : ∀ g, (⇑D)^[p - 1] g = -(co₀ g i0 ^ p) := by
    intro g
    conv_lhs => rw [hco₀ g]
    rw [Isum, Finset.sum_eq_single i0]
    · rw [IF, hi0, Nat.descFactorial_self, Nat.sub_self, pow_zero, wil]
      ring
    · intro j _ hj
      have hlt : (j : ℕ) < p - 1 := by
        have h1 := j.isLt
        have h2 : (j : ℕ) ≠ p - 1 := fun h => hj (Fin.ext (h.trans hi0.symm))
        omega
      rw [IF, Nat.descFactorial_eq_zero_iff_lt.mpr hlt]
      simp
    · intro h; exact absurd (Finset.mem_univ _) h
  obtain ⟨C, hC⟩ : ∃ C : K →+ K, ∀ g, C g = co₀ g i0 :=
    ⟨AddMonoidHom.mk' (fun g => co₀ g i0) (fun g g' => by rw [co_add, Pi.add_apply]),
      fun g => rfl⟩
  refine ⟨D, C, leib, ?_, nil, ?_, ?_, ?_⟩
  · have h := KF 1 1
    simpa using h
  · intro z
    have h := KF z 0
    simpa using h
  · intro g
    rw [hC, cart, neg_neg]
  · intro c g
    rw [hC, hC, co_smul, Pi.smul_apply, smul_eq_mul]

theorem wc_char_hochschild (K : Type u) [Field K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (E : K →+ K) (hE : ∀ a b, E (a * b) = a * E b + b * E a) :
    ∀ a g : K, (fun y => E y + a * y)^[p] g = (⇑E)^[p] g + (a ^ p + (⇑E)^[p - 1] a) * g :=
by
  intro a g
  have hp : p.Prime := Fact.out
  have hE1 : E 1 = 0 := by
    have h := hE 1 1
    simp only [one_mul] at h
    linear_combination -h
  have hEn : ∀ (m : ℕ) (x : K), E ((m : K) * x) = (m : K) * E x := by
    intro m x
    rw [← nsmul_eq_mul, map_nsmul, nsmul_eq_mul]
  obtain ⟨L, hL⟩ : ∃ L : K →+ K, ∀ y, L y = E y + a * y :=
    ⟨E + AddMonoidHom.mulLeft a, fun y => rfl⟩
  have hfun : (fun y => E y + a * y) = ⇑L := funext fun y => (hL y).symm
  rw [hfun]
  have hLmul : ∀ (m : ℕ) (x : K), L ((m : K) * x) = (m : K) * L x := by
    intro m x; rw [hL, hL, hEn]; ring
  have hLleib : ∀ x y, L (x * y) = E x * y + x * L y := by
    intro x y; rw [hL, hL, hE]; ring

  have hleib : ∀ (f h : K) (n : ℕ), (⇑L)^[n] (f * h) =
      ∑ k ∈ Finset.range (n + 1), (n.choose k : K) * ((⇑E)^[k] f * (⇑L)^[n - k] h) := by
    intro f h n
    induction n with
    | zero => simp
    | succ n ih =>
      have hc := Finset.sum_choose_succ_mul (fun i j => (⇑E)^[i] f * (⇑L)^[j] h) n
      try simp only at hc
      rw [show n + 1 + 1 = n + 2 from rfl, hc, Function.iterate_succ_apply', ih, map_sum,
        ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun k hk => ?_)
      have hk' : k ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      rw [hLmul, hLleib, show n + 1 - k = (n - k) + 1 by omega,
        Function.iterate_succ_apply' (⇑L) (n - k), Function.iterate_succ_apply' (⇑E) k]
      ring

  obtain ⟨W, hW00, hW0s, hWs0, hWss⟩ : ∃ W : ℕ → ℕ → K, W 0 0 = 1 ∧ (∀ i, W 0 (i + 1) = 0) ∧
      (∀ n, W (n + 1) 0 = E (W n 0)) ∧
      (∀ n i, W (n + 1) (i + 1) = E (W n (i + 1)) + a * W n i) :=
    ⟨fun n => Nat.rec (motive := fun _ => ℕ → K)
      (fun i => Nat.casesOn (motive := fun _ => K) i 1 (fun _ => 0))
      (fun _ w i => Nat.casesOn (motive := fun _ => K) i (E (w 0))
        (fun j => E (w (j + 1)) + a * w j)) n,
      rfl, fun _ => rfl, fun _ => rfl, fun _ _ => rfl⟩
  have hWvan : ∀ n i, n < i → W n i = 0 := by
    intro n
    induction n with
    | zero =>
      intro i hi
      obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
      exact hW0s j
    | succ n ih =>
      intro i hi
      obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
      rw [hWss, ih (j + 1) (by omega), ih j (by omega), map_zero, mul_zero, add_zero]
  have hWdiag : ∀ n, W n n = a ^ n := by
    intro n
    induction n with
    | zero => rw [hW00, pow_zero]
    | succ n ih =>
      rw [hWss, hWvan n (n + 1) (Nat.lt_succ_self n), ih, map_zero, zero_add, pow_succ, mul_comm]
  have hWcol : ∀ n, W (n + 1) 0 = 0 := by
    intro n
    induction n with
    | zero => rw [hWs0, hW00, hE1]
    | succ n ih => rw [hWs0, ih, map_zero]
  have hrow : ∀ n, (⇑L)^[n] 1 = ∑ i ∈ Finset.range (n + 1), W n i := by
    intro n
    induction n with
    | zero => simp [hW00]
    | succ n ih =>
      rw [Function.iterate_succ_apply', ih, map_sum, Finset.sum_range_succ' (fun i => W (n + 1) i)]
      simp only [hWss, hWs0, hL, Finset.sum_add_distrib]
      have h1 := Finset.sum_range_succ (fun i => E (W n i)) (n + 1)
      have h2 := Finset.sum_range_succ' (fun i => E (W n i)) (n + 1)
      rw [hWvan n (n + 1) (Nat.lt_succ_self n), map_zero, add_zero] at h1
      linear_combination h2 - h1

  obtain ⟨B, hB0, hBs⟩ : ∃ B : ℕ → K, B 0 = 0 ∧ ∀ k, B (k + 1) = (⇑E)^[k] a :=
    ⟨fun j => Nat.casesOn (motive := fun _ => K) j 0 (fun k => (⇑E)^[k] a), rfl, fun _ => rfl⟩
  have hEBsum : ∀ (c : ℕ → K) (n : ℕ), ∑ j ∈ Finset.range (n + 1), c j * E (B j) =
      ∑ j ∈ Finset.range (n + 1), c j * B (j + 1) - c 0 * a := by
    intro c n
    rw [Finset.sum_range_succ', Finset.sum_range_succ']
    have hEB : ∀ j, E (B (j + 1)) = B (j + 1 + 1) := fun j => by
      rw [hBs, hBs, Function.iterate_succ_apply']
    have hB1 : B (0 + 1) = a := by rw [hBs, Function.iterate_zero_apply]
    simp only [hEB, hB0, map_zero, hB1]
    ring

  have hD : ∀ n i, ((i + 1 : ℕ) : K) * W n (i + 1) =
      ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * (B j * W (n - j) i) := by
    intro n
    induction n with
    | zero => intro i; simp [hB0, hW0s]
    | succ n ih =>
      intro i
      have hc := Finset.sum_choose_succ_mul (fun j m => B j * W m i) n
      try simp only at hc
      rw [show n + 1 + 1 = n + 2 from rfl, hc]
      have F2 : ((i + 1 : ℕ) : K) * E (W n (i + 1)) =
          ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * (B j * E (W (n - j) i)) +
          ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * (B (j + 1) * W (n - j) i) -
          a * W n i := by
        have h1 := congrArg E (ih i)
        rw [hEn, map_sum] at h1
        rw [h1]
        have h2 := hEBsum (fun j => (n.choose j : K) * W (n - j) i) n
        simp only [Nat.choose_zero_right, Nat.cast_one, one_mul, Nat.sub_zero] at h2
        have h3 : ∑ j ∈ Finset.range (n + 1), E ((n.choose j : K) * (B j * W (n - j) i)) =
            ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * (B j * E (W (n - j) i)) +
            ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * W (n - j) i * E (B j) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [hEn, hE]; ring
        rw [h3, h2]
        have h4 : ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * W (n - j) i * B (j + 1) =
            ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * (B (j + 1) * W (n - j) i) :=
          Finset.sum_congr rfl (fun j _ => by ring)
        rw [h4]; ring
      rw [hWss]
      cases i with
      | zero =>
        have hS1 : ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * (B j * W (n + 1 - j) 0) =
            ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * (B j * E (W (n - j) 0)) := by
          refine Finset.sum_congr rfl (fun j hj => ?_)
          have := Finset.mem_range.mp hj
          rw [show n + 1 - j = n - j + 1 by omega, hWs0]
        rw [hS1]
        push_cast at F2 ⊢
        linear_combination F2
      | succ i' =>
        have hS1 : ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * (B j * W (n + 1 - j) (i' + 1)) =
            ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * (B j * E (W (n - j) (i' + 1))) +
            a * ∑ j ∈ Finset.range (n + 1), (n.choose j : K) * (B j * W (n - j) i') := by
          rw [Finset.mul_sum, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun j hj => ?_)
          have := Finset.mem_range.mp hj
          rw [show n + 1 - j = n - j + 1 by omega, hWss]
          ring
        rw [hS1, ← ih i']
        push_cast at F2 ⊢
        linear_combination F2

  obtain ⟨r, rfl⟩ : ∃ r, p = r + 2 := ⟨p - 2, by have := hp.two_le; omega⟩
  have hcol : ∀ f : ℕ → K, ∑ j ∈ Finset.range (r + 2 + 1), ((r + 2).choose j : K) * f j =
      f 0 + f (r + 2) := by
    intro f
    rw [Finset.sum_range_succ, Finset.sum_range_succ', Finset.sum_eq_zero]
    · simp
    · intro j hj
      have hj' := Finset.mem_range.mp hj
      rw [(CharP.cast_eq_zero_iff K (r + 2) _).mpr (hp.dvd_choose_self (by omega) (by omega)),
        zero_mul]
  have hBp : B (r + 2) = (⇑E)^[r + 1] a := hBs (r + 1)
  have hDp : ∀ i, ((i + 1 : ℕ) : K) * W (r + 2) (i + 1) = (⇑E)^[r + 1] a * W 0 i := by
    intro i
    rw [hD, hcol (fun j => B j * W (r + 2 - j) i)]
    simp [hB0, hBp]
  have hW1 : W (r + 2) 1 = (⇑E)^[r + 1] a := by
    have h := hDp 0
    rw [hW00] at h
    simpa using h
  have hWmid : ∀ j, j < r → W (r + 2) (j + 2) = 0 := by
    intro j hj
    have h := hDp (j + 1)
    rw [hW0s, mul_zero] at h
    have hne : ((j + 1 + 1 : ℕ) : K) ≠ 0 := by
      rw [Ne, CharP.cast_eq_zero_iff K (r + 2)]
      intro hd
      have := Nat.le_of_dvd (by omega) hd
      omega
    exact (mul_eq_zero.mp h).resolve_left hne
  have hz : ∑ i ∈ Finset.range r, W (r + 2) (i + 1 + 1) = 0 :=
    Finset.sum_eq_zero (fun i hi => hWmid i (Finset.mem_range.mp hi))
  have hP : (⇑L)^[r + 2] 1 = a ^ (r + 2) + (⇑E)^[r + 1] a := by
    rw [hrow, Finset.sum_range_succ, hWdiag, Finset.sum_range_succ', hWcol,
      Finset.sum_range_succ', hz]
    have h01 : W (r + 2) (0 + 1) = (⇑E)^[r + 1] a := hW1
    rw [h01]
    ring
  have hmain := hleib g 1 (r + 2)
  rw [mul_one, hcol (fun k => (⇑E)^[k] g * (⇑L)^[r + 2 - k] 1)] at hmain
  simp only [Nat.sub_zero, Nat.sub_self, Function.iterate_zero, id_eq] at hmain
  rw [hmain, hP, show r + 2 - 1 = r + 1 by omega]
  ring

theorem wc_char_jacobson (K : Type u) [Field K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (E : K →+ K) (hE : ∀ a b, E (a * b) = a * E b + b * E a) (hEp : ∀ y, (⇑E)^[p] y = 0)
    (hH : ∀ a g : K, (fun y => E y + a * y)^[p] g = (⇑E)^[p] g + (a ^ p + (⇑E)^[p - 1] a) * g) :
    (∀ y, (⇑E)^[p - 1] (y ^ (p - 1) * E y) = -(E y) ^ p) ∧
      ∀ a : K, a ^ p + (⇑E)^[p - 1] a = 0 → ∃ f : K, f ≠ 0 ∧ E f = a * f :=
by
  classical
  have hp : p.Prime := Fact.out
  have hp1 : p - 1 + 1 = p := Nat.sub_add_cancel hp.one_le
  have hE1 : E 1 = 0 := by
    have h := hE 1 1
    simp only [mul_one, one_mul] at h
    linear_combination -h
  have hpow : ∀ (z : K) (n : ℕ), E (z ^ (n + 1)) = ((n + 1 : ℕ) : K) * z ^ n * E z := by
    intro z n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, hE, ih]
      push_cast; ring
  have hEzp : ∀ z : K, E (z ^ p) = 0 := by
    intro z
    have h := hpow z (p - 1)
    rw [hp1, CharP.cast_eq_zero K p, zero_mul, zero_mul] at h
    exact h
  have hiter : ∀ (z h : K) (m : ℕ), (⇑E)^[m] (z ^ p * h) = z ^ p * (⇑E)^[m] h := by
    intro z h m
    induction m with
    | zero => rfl
    | succ m ih =>
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, hE, hEzp,
        mul_zero, add_zero]
  refine ⟨?_, ?_⟩
  · intro y
    by_cases hy : y = 0
    · subst hy
      rw [map_zero, mul_zero, iterate_map_zero, zero_pow hp.ne_zero, neg_zero]
    · set a : K := -(E y * y⁻¹) with ha
      have hinv : y * y⁻¹ = 1 := mul_inv_cancel₀ hy
      have hLy : E y + a * y = 0 := by
        rw [ha]; linear_combination (-(E y)) * hinv
      have hL0 : ∀ n, (fun y => E y + a * y)^[n] 0 = 0 :=
        fun n => Function.iterate_fixed (by simp) n
      have h2 : (fun y => E y + a * y)^[p] y = 0 := by
        rw [← hp1, Function.iterate_succ_apply]
        show (fun y => E y + a * y)^[p - 1] (E y + a * y) = 0
        rw [hLy]; exact hL0 _
      have hc : (a ^ p + (⇑E)^[p - 1] a) * y = 0 := by
        have h := hH a y
        rw [h2, hEp, zero_add] at h
        exact h.symm
      have hc0 : a ^ p + (⇑E)^[p - 1] a = 0 := (mul_eq_zero.mp hc).resolve_right hy
      have hEa : (⇑E)^[p - 1] a = -a ^ p := by linear_combination hc0
      have hap : a ^ p = -(E y ^ p * (y ^ p)⁻¹) := by
        rw [ha, neg_pow, neg_one_pow_char K p, mul_pow, inv_pow]; ring
      have hyp : y ^ p ≠ 0 := pow_ne_zero _ hy
      have hinv2 : y ^ p * (y ^ p)⁻¹ = 1 := mul_inv_cancel₀ hyp
      have hyp1 : y ^ p = y ^ (p - 1) * y := by rw [← pow_succ, hp1]
      have hrw : y ^ (p - 1) * E y = -(y ^ p * a) := by
        rw [hyp1, ha]; linear_combination (-(y ^ (p - 1) * E y)) * hinv
      calc (⇑E)^[p - 1] (y ^ (p - 1) * E y) = (⇑E)^[p - 1] (-(y ^ p * a)) := by rw [hrw]
        _ = -(y ^ p * (⇑E)^[p - 1] a) := by rw [iterate_map_neg, hiter]
        _ = -(E y) ^ p := by
          rw [hEa, hap, neg_neg]; linear_combination (-(E y ^ p)) * hinv2
  · intro a hc
    set L : K → K := fun y => E y + a * y with hL
    have hLp : ∀ g, L^[p] g = 0 := by
      intro g; rw [hL, hH, hEp, hc, zero_mul, add_zero]
    have hex : ∃ n, L^[n] 1 = 0 := ⟨p, hLp 1⟩
    obtain ⟨k, hk⟩ : ∃ k, Nat.find hex = k + 1 := Nat.exists_eq_succ_of_ne_zero (by
      intro h
      have := Nat.find_spec hex
      rw [h] at this
      simp at this)
    have hg : L^[k] 1 ≠ 0 := Nat.find_min hex (by omega)
    have hLg : L (L^[k] 1) = 0 := by
      have := Nat.find_spec hex
      rw [hk, Function.iterate_succ_apply'] at this
      exact this
    set g := L^[k] 1 with hgdef
    have hEg : E g + a * g = 0 := hLg
    refine ⟨g⁻¹, inv_ne_zero hg, ?_⟩
    have h1 := hE g g⁻¹
    rw [mul_inv_cancel₀ hg, hE1] at h1
    have h3 : g * (E g⁻¹ - a * g⁻¹) = 0 := by
      linear_combination (-1 : K) * h1 - g⁻¹ * hEg
    exact sub_eq_zero.mp ((mul_eq_zero.mp h3).resolve_left hg)

theorem wc_char_local_cartier (K : Type u) [Field K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (D C : K →+ K) (v : Additive Kˣ →+ ℤ) (π : Kˣ)
    (hD : ∀ a b, D (a * b) = a * D b + b * D a) (hDp : ∀ y, (⇑D)^[p] y = 0)
    (hDne : ∃ z, D z ≠ 0) (hDpow : ∀ z, D (z ^ p) = 0)
    (hH : ∀ y, (⇑D)^[p - 1] (y ^ (p - 1) * D y) = -(D y) ^ p)
    (hC : ∀ g, C g ^ p = -((⇑D)^[p - 1] g))
    (hv : ∀ f g h : Kˣ, (h : K) = f + g →
      min (v (Additive.ofMul f)) (v (Additive.ofMul g)) ≤ v (Additive.ofMul h))
    (hπ : v (Additive.ofMul π) = 1)
    (hπb : ∀ g : K, ∃ h : Fin p → K, g = ∑ i : Fin p, h i ^ p * (π : K) ^ (i : ℕ)) :
    D (π : K) ≠ 0 ∧ ∀ δ : ℤ, (∃ hu : D (π : K) ≠ 0, v (Additive.ofMul (Units.mk0 _ hu)) = δ) →
      (∀ g : K, wcValGe K v 0 g → wcValGe K v δ (D g)) ∧
      (∀ (m : ℕ) (g : K), wcValGe K v (δ - m) g → wcValGe K v (δ - m) (C g)) ∧
      C (D π / π) = D π / π ∧
      (∀ f : Kˣ, wcValGe K v δ (D f / f - (v (Additive.ofMul f) : K) * (D π / π))) ∧
      (∀ r : ℤ, wcValGe K v δ ((r : K) * (D π / π)) → (p : ℤ) ∣ r) :=
by
  classical
  have hp : p.Prime := Fact.out
  have hp2 : 2 ≤ p := hp.two_le
  have hp0 : p ≠ 0 := hp.ne_zero

  obtain ⟨V, hVdef⟩ : ∃ V : K → ℤ, V = fun x => if hx : x = 0 then 0 else
      v (Additive.ofMul (Units.mk0 x hx)) := ⟨_, rfl⟩
  have hVe : ∀ x (hx : x ≠ 0), v (Additive.ofMul (Units.mk0 x hx)) = V x := by
    intro x hx; rw [hVdef]; simp only [hx, dite_false]
  have hreg : ∀ k g, wcValGe K v k g ↔ g = 0 ∨ k ≤ V g := by
    intro k g
    unfold wcValGe
    constructor
    · rintro (h | ⟨hg, h⟩)
      · exact Or.inl h
      · exact Or.inr (by rw [← hVe g hg]; exact h)
    · rintro (h | h)
      · exact Or.inl h
      · by_cases hg : g = 0
        · exact Or.inl hg
        · exact Or.inr ⟨hg, by rw [hVe g hg]; exact h⟩
  have hVu : ∀ a : Kˣ, V (a : K) = v (Additive.ofMul a) := by
    intro a; rw [← hVe _ a.ne_zero, Units.mk0_val]
  have hVmul : ∀ a b : K, a ≠ 0 → b ≠ 0 → V (a * b) = V a + V b := by
    intro a b ha hb
    rw [← hVe a ha, ← hVe b hb, ← map_add, ← ofMul_mul, ← hVe (a * b) (mul_ne_zero ha hb)]
    congr 2
    exact Units.ext (by simp)
  have hV1 : V 1 = 0 := by
    have := hVu 1
    rw [Units.val_one, ofMul_one, map_zero] at this
    exact this
  have hVm1 : V (-1) = 0 := by
    have := hVmul (-1) (-1) (by norm_num) (by norm_num)
    rw [neg_one_mul, neg_neg, hV1] at this
    omega
  have hVneg : ∀ a : K, a ≠ 0 → V (-a) = V a := by
    intro a ha
    have := hVmul (-1) a (by norm_num) ha
    rw [neg_one_mul, hVm1, zero_add] at this
    exact this
  have hVpow : ∀ a : K, a ≠ 0 → ∀ n : ℕ, V (a ^ n) = n * V a := by
    intro a ha n
    induction n with
    | zero => simp [hV1]
    | succ n ih =>
      rw [pow_succ, hVmul _ _ (pow_ne_zero _ ha) ha, ih]
      push_cast; ring
  have hVinv : ∀ a : K, a ≠ 0 → V a⁻¹ = - V a := by
    intro a ha
    have := hVmul a a⁻¹ ha (inv_ne_zero ha)
    rw [mul_inv_cancel₀ ha, hV1] at this
    omega
  have hult : ∀ a b : K, a ≠ 0 → b ≠ 0 → a + b ≠ 0 → min (V a) (V b) ≤ V (a + b) := by
    intro a b ha hb hab
    have := hv (Units.mk0 a ha) (Units.mk0 b hb) (Units.mk0 (a + b) hab) (by simp)
    rw [hVe, hVe, hVe] at this
    exact this

  have rzero : ∀ k, wcValGe K v k 0 := fun k => Or.inl rfl
  have radd : ∀ k (a b : K), wcValGe K v k a → wcValGe K v k b → wcValGe K v k (a + b) := by
    intro k a b ha hb
    rw [hreg] at ha hb ⊢
    by_cases hab : a + b = 0
    · exact Or.inl hab
    by_cases ha0 : a = 0
    · rw [ha0, zero_add]; exact hb
    by_cases hb0 : b = 0
    · rw [hb0, add_zero]; exact ha
    have ha' := ha.resolve_left ha0
    have hb' := hb.resolve_left hb0
    have := hult a b ha0 hb0 hab
    right
    rcases min_le_iff.mp this with h | h <;> omega
  have rmul : ∀ k l (a b : K), wcValGe K v k a → wcValGe K v l b →
      wcValGe K v (k + l) (a * b) := by
    intro k l a b ha hb
    rw [hreg] at ha hb ⊢
    by_cases ha0 : a = 0
    · left; rw [ha0, zero_mul]
    by_cases hb0 : b = 0
    · left; rw [hb0, mul_zero]
    right
    rw [hVmul a b ha0 hb0]
    have := ha.resolve_left ha0
    have := hb.resolve_left hb0
    omega
  have rsum : ∀ k (s : Finset (Fin p)) (f : Fin p → K), (∀ i ∈ s, wcValGe K v k (f i)) →
      wcValGe K v k (∑ i ∈ s, f i) := by
    intro k s f hf
    exact Finset.sum_induction _ (wcValGe K v k) (radd k) (rzero k) hf
  have rstrict : ∀ a b : K, a ≠ 0 → b ≠ 0 → V a < V b → a + b ≠ 0 ∧ V (a + b) = V a := by
    intro a b ha hb hab
    have hs : a + b ≠ 0 := by
      intro h0
      have : b = -a := by linear_combination h0
      rw [this, hVneg a ha] at hab
      exact lt_irrefl _ hab
    refine ⟨hs, le_antisymm ?_ ?_⟩
    · have := hult (a + b) (-b) hs (neg_ne_zero.mpr hb) (by rw [add_neg_cancel_right]; exact ha)
      rw [add_neg_cancel_right, hVneg b hb] at this
      rcases min_le_iff.mp this with h | h
      · exact h
      · omega
    · have := hult a b ha hb hs
      rcases min_le_iff.mp this with h | h <;> omega

  have hπ0 : (π : K) ≠ 0 := π.ne_zero
  have hVπ : V (π : K) = 1 := by rw [hVu, hπ]
  have hnatp : ∀ n : ℕ, (n : K) ^ p = n := by
    intro n; rw [← frobenius_def, map_natCast]
  have hintp : ∀ r : ℤ, (r : K) ^ p = r := by
    intro r; rw [← frobenius_def, map_intCast]
  have hVint : ∀ r : ℤ, (r : K) ≠ 0 → V (r : K) = 0 := by
    intro r hr
    have h1 := hVpow (r : K) hr p
    rw [hintp] at h1
    have h2 : ((p : ℤ) - 1) * V (r : K) = 0 := by linear_combination -h1
    rcases mul_eq_zero.mp h2 with h | h
    · omega
    · exact h
  have hVnat : ∀ n : ℕ, (n : K) ≠ 0 → V (n : K) = 0 := by
    intro n hn
    have := hVint (n : ℤ) (by rwa [Int.cast_natCast])
    rwa [Int.cast_natCast] at this

  have hVterm : ∀ c : K, c ≠ 0 → ∀ n : ℕ, V (c ^ p * (π : K) ^ n) = (p : ℤ) * V c + n := by
    intro c hc n
    rw [hVmul _ _ (pow_ne_zero _ hc) (pow_ne_zero _ hπ0), hVpow c hc, hVpow _ hπ0, hVπ, mul_one]
  have hterm : ∀ (h : Fin p → K) (k : ℤ),
      wcValGe K v k (∑ i : Fin p, h i ^ p * (π : K) ^ (i : ℕ)) →
      ∀ i, h i ≠ 0 → k ≤ (p : ℤ) * V (h i) + ((i : ℕ) : ℤ) := by
    intro h k hk i hi
    obtain ⟨e, he⟩ : ∃ e : Fin p → ℤ, ∀ j, e j = (p : ℤ) * V (h j) + ((j : ℕ) : ℤ) :=
      ⟨_, fun j => rfl⟩
    have hiT : i ∈ Finset.univ.filter (fun j => h j ≠ 0) :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩
    obtain ⟨i₀, hi₀T, hmin⟩ := Finset.exists_min_image _ e ⟨i, hiT⟩
    have hi₀ : h i₀ ≠ 0 := (Finset.mem_filter.mp hi₀T).2
    have hdist : ∀ j, h j ≠ 0 → j ≠ i₀ → e i₀ + 1 ≤ e j := by
      intro j hj hji
      have h1 := hmin j (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩)
      have hne : e j ≠ e i₀ := by
        intro heq
        apply hji
        rw [he, he] at heq
        have hdvd : (p : ℤ) ∣ ((i₀ : ℕ) : ℤ) - ((j : ℕ) : ℤ) :=
          ⟨V (h j) - V (h i₀), by rw [mul_sub]; linarith⟩
        have hl1 := i₀.isLt
        have hl2 := j.isLt
        have habs : |((i₀ : ℕ) : ℤ) - ((j : ℕ) : ℤ)| < (p : ℤ) := by
          rw [abs_lt]; constructor <;> omega
        have := Int.eq_zero_of_abs_lt_dvd hdvd habs
        exact Fin.ext (by omega)
      omega
    have ht₀ : h i₀ ^ p * (π : K) ^ (i₀ : ℕ) ≠ 0 :=
      mul_ne_zero (pow_ne_zero _ hi₀) (pow_ne_zero _ hπ0)
    have hVt₀ : V (h i₀ ^ p * (π : K) ^ (i₀ : ℕ)) = e i₀ := by rw [hVterm _ hi₀, he]
    obtain ⟨R, hRdef⟩ : ∃ R, R = ∑ j ∈ Finset.univ.erase i₀, h j ^ p * (π : K) ^ (j : ℕ) :=
      ⟨_, rfl⟩
    have hR : wcValGe K v (e i₀ + 1) R := by
      rw [hRdef]
      apply rsum
      intro j hj
      rw [hreg]
      by_cases hj0 : h j = 0
      · left; rw [hj0, zero_pow hp0, zero_mul]
      · right
        rw [hVterm _ hj0, ← he]
        exact hdist j hj0 (Finset.ne_of_mem_erase hj)
    have hS : ∑ j : Fin p, h j ^ p * (π : K) ^ (j : ℕ) = h i₀ ^ p * (π : K) ^ (i₀ : ℕ) + R := by
      rw [hRdef]; exact (Finset.add_sum_erase _ _ (Finset.mem_univ i₀)).symm
    have hSv : h i₀ ^ p * (π : K) ^ (i₀ : ℕ) + R ≠ 0 ∧
        V (h i₀ ^ p * (π : K) ^ (i₀ : ℕ) + R) = e i₀ := by
      by_cases hR0 : R = 0
      · rw [hR0, add_zero]; exact ⟨ht₀, hVt₀⟩
      · have hR' := ((hreg _ _).mp hR).resolve_left hR0
        rw [← hVt₀]
        exact rstrict _ _ ht₀ hR0 (by omega)
    rw [hS, hreg] at hk
    have hk' := hk.resolve_left hSv.1
    rw [hSv.2] at hk'
    rw [← he i]
    have := hmin i hiT
    omega

  have hD1 : D 1 = 0 := by
    have := hD 1 1
    rw [one_mul, one_mul] at this
    linear_combination -this
  have hDcp : ∀ c y : K, D (c ^ p * y) = c ^ p * D y := by
    intro c y; rw [hD, hDpow, mul_zero, add_zero]
  have hpow' : ∀ (x : K) (n : ℕ), D (x ^ (n + 1)) = ((n + 1 : ℕ) : K) * x ^ n * D x := by
    intro x n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [show x ^ (n + 1 + 1) = x ^ (n + 1) * x from pow_succ _ _, hD, ih]
      push_cast; ring
  have hpowgen : ∀ (x : K) (n : ℕ), D (x ^ n) = (n : K) * x ^ (n - 1) * D x := by
    intro x n
    cases n with
    | zero => simp [hD1]
    | succ n => rw [hpow' x n, Nat.add_sub_cancel]
  have hderiv : ∀ (x : K) (h : Fin p → K), D (∑ i : Fin p, h i ^ p * x ^ (i : ℕ)) =
      ∑ i : Fin p, ((i : ℕ) : K) * h i ^ p * x ^ ((i : ℕ) - 1) * D x := by
    intro x h
    rw [map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hDcp, hpowgen]; ring

  have hitc : ∀ (n : ℕ) (c y : K), (⇑D)^[n] (c ^ p * y) = c ^ p * (⇑D)^[n] y := by
    intro n c y
    induction n with
    | zero => rfl
    | succ n ih => rw [Function.iterate_succ_apply', ih, hDcp, Function.iterate_succ_apply']
  have hitsum : ∀ (n : ℕ) (s : Finset (Fin p)) (f : Fin p → K),
      (⇑D)^[n] (∑ i ∈ s, f i) = ∑ i ∈ s, (⇑D)^[n] (f i) := by
    intro n s f
    induction s using Finset.induction_on with
    | empty => simp [iterate_map_zero]
    | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, iterate_map_add, ih]
  have hvan : ∀ (x : K) (i : ℕ), i + 1 < p → (⇑D)^[p - 1] (x ^ i * D x) = 0 := by
    intro x i hi
    have hne : ((i + 1 : ℕ) : K) ≠ 0 := by
      intro h0
      rw [CharP.cast_eq_zero_iff K p] at h0
      exact absurd (Nat.le_of_dvd (Nat.succ_pos i) h0) (by omega)
    have h1 : ((i + 1 : ℕ) : K) * (⇑D)^[p - 1] (x ^ i * D x) = 0 := by
      rw [← hnatp (i + 1), ← hitc, ← mul_assoc, hnatp (i + 1), ← hpow']
      have := hDp (x ^ (i + 1))
      rwa [show p = (p - 1).succ by omega, Function.iterate_succ_apply] at this
    exact (mul_eq_zero.mp h1).resolve_left hne
  have hcart : ∀ (x : K) (h : Fin p → K) (j : Fin p), (j : ℕ) = p - 1 →
      C (D x * ∑ i : Fin p, h i ^ p * x ^ (i : ℕ)) = D x * h j := by
    intro x h j hj
    have e1 : D x * ∑ i : Fin p, h i ^ p * x ^ (i : ℕ) =
        ∑ i : Fin p, h i ^ p * (x ^ (i : ℕ) * D x) := by
      rw [Finset.mul_sum]; exact Finset.sum_congr rfl (fun i _ => by ring)
    have e2 : (⇑D)^[p - 1] (D x * ∑ i : Fin p, h i ^ p * x ^ (i : ℕ)) =
        h j ^ p * (-(D x) ^ p) := by
      rw [e1, hitsum]
      simp only [hitc]
      rw [Finset.sum_eq_single j]
      · rw [hj, hH]
      · intro i _ hij
        have hlt : (i : ℕ) + 1 < p := by
          have := i.isLt
          have : (i : ℕ) ≠ p - 1 := fun h' => hij (Fin.ext (by omega))
          omega
        rw [hvan x i hlt, mul_zero]
      · intro h'; exact absurd (Finset.mem_univ j) h'
    apply frobenius_inj K p
    rw [frobenius_def, frobenius_def, hC, e2]
    ring

  have hu0 : D (π : K) ≠ 0 := by
    intro h0
    obtain ⟨z, hz⟩ := hDne
    obtain ⟨h, hh⟩ := hπb z
    apply hz
    rw [hh, hderiv]
    exact Finset.sum_eq_zero (fun i _ => by rw [h0, mul_zero])
  refine ⟨hu0, ?_⟩
  rintro δ ⟨hu, hδ⟩
  have hVu' : V (D (π : K)) = δ := by rw [← hVe _ hu]; exact hδ

  have L1 : ∀ g : K, wcValGe K v 0 g → wcValGe K v δ (D g) := by
    intro g hg
    obtain ⟨h, hh⟩ := hπb g
    have ht := hterm h 0 (by rw [← hh]; exact hg)
    rw [hh, hderiv]
    apply rsum
    intro i _
    by_cases hi0 : (i : ℕ) = 0
    · left; rw [hi0, Nat.cast_zero, zero_mul, zero_mul, zero_mul]
    by_cases hhi : h i = 0
    · left; rw [hhi, zero_pow hp0, mul_zero, zero_mul, zero_mul]
    have h1 := ht i hhi
    have hilt : ((i : ℕ) : ℤ) < (p : ℤ) := by exact_mod_cast i.isLt
    have h2 : 0 ≤ V (h i) := by
      by_contra hneg
      push_neg at hneg
      have := mul_le_mul_of_nonneg_left (show V (h i) ≤ -1 by omega)
        (show (0 : ℤ) ≤ p by positivity)
      linarith
    have r1 : wcValGe K v 0 (((i : ℕ) : K)) := by
      rw [hreg]
      by_cases hc : ((i : ℕ) : K) = 0
      · left; exact hc
      · right; exact le_of_eq (hVnat _ hc).symm
    have r2 : wcValGe K v 0 (h i ^ p) := by
      rw [hreg]; right; rw [hVpow _ hhi]; exact mul_nonneg (by positivity) h2
    have r3 : wcValGe K v 0 ((π : K) ^ ((i : ℕ) - 1)) := by
      rw [hreg]; right; rw [hVpow _ hπ0, hVπ]; positivity
    have r4 : wcValGe K v δ (D (π : K)) := by
      rw [hreg]; right; exact le_of_eq hVu'.symm
    have := rmul _ _ _ _ (rmul _ _ _ _ (rmul _ _ _ _ r1 r2) r3) r4
    have e : (0 : ℤ) + 0 + 0 + δ = δ := by ring
    rw [e] at this
    exact this

  have C1 : ∀ (m : ℕ) (g : K), wcValGe K v (δ - m) g → wcValGe K v (δ - m) (C g) := by
    intro m g hg
    by_cases g0 : g = 0
    · left; rw [g0, map_zero]
    obtain ⟨h, hh⟩ := hπb (g * (D (π : K))⁻¹)
    have hgS : g = D (π : K) * ∑ i : Fin p, h i ^ p * (π : K) ^ (i : ℕ) := by
      rw [← hh]; field_simp
    have hS0 : ∑ i : Fin p, h i ^ p * (π : K) ^ (i : ℕ) ≠ 0 := by
      intro h0; apply g0; rw [hgS, h0, mul_zero]
    have hVg : V g = δ + V (∑ i : Fin p, h i ^ p * (π : K) ^ (i : ℕ)) := by
      rw [hgS, hVmul _ _ hu hS0, hVu']
    have hg' := ((hreg _ _).mp hg).resolve_left g0
    let j : Fin p := ⟨p - 1, by omega⟩
    have hj := hterm h (-(m : ℤ)) ((hreg _ _).mpr (Or.inr (by linarith))) j
    rw [hgS, hcart (π : K) h j rfl, hreg]
    by_cases hj0 : h j = 0
    · left; rw [hj0, mul_zero]
    right
    have h1 := hj hj0
    have hjv : (((j : ℕ)) : ℤ) = (p : ℤ) - 1 := by
      show ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1
      omega
    rw [hjv] at h1
    rw [hVmul _ _ hu hj0, hVu']
    by_contra hcon
    push_neg at hcon
    have h4 : V (h j) + m + 1 ≤ 0 := by linarith
    have h5 : (p : ℤ) * (V (h j) + m + 1) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (by positivity) h4
    have h6 : 0 ≤ ((p : ℤ) - 1) * m := mul_nonneg (by omega) (by positivity)
    nlinarith

  have C2 : C (D (π : K) / (π : K)) = D (π : K) / (π : K) := by
    let j : Fin p := ⟨p - 1, by omega⟩
    obtain ⟨hf, hfdef⟩ : ∃ hf : Fin p → K, ∀ i, hf i = if i = j then (π : K)⁻¹ else 0 :=
      ⟨_, fun _ => rfl⟩
    have hsum : ∑ i : Fin p, hf i ^ p * (π : K) ^ (i : ℕ) = (π : K)⁻¹ := by
      rw [Finset.sum_eq_single j]
      · rw [hfdef, if_pos rfl]
        show (π : K)⁻¹ ^ p * (π : K) ^ (p - 1) = (π : K)⁻¹
        obtain ⟨q, hq⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
        rw [hq, Nat.add_sub_cancel, pow_succ, mul_right_comm, ← mul_pow, inv_mul_cancel₀ hπ0,
          one_pow, one_mul]
      · intro i _ hij
        rw [hfdef, if_neg hij, zero_pow hp0, zero_mul]
      · intro h'; exact absurd (Finset.mem_univ j) h'
    have := hcart (π : K) hf j rfl
    rw [hsum, hfdef, if_pos rfl] at this
    rw [div_eq_mul_inv, this]

  have C3 : ∀ f : Kˣ, wcValGe K v δ (D f / f - (v (Additive.ofMul f) : K) * (D π / π)) := by
    intro f
    let dl : Additive Kˣ →+ K := AddMonoidHom.mk'
      (fun a => D ((Additive.toMul a : Kˣ) : K) / ((Additive.toMul a : Kˣ) : K)) (by
        intro a b
        have h1 := (Additive.toMul a).ne_zero
        have h2 := (Additive.toMul b).ne_zero
        simp only [toMul_add, Units.val_mul]
        rw [hD]
        field_simp
        ring)
    have hdl : ∀ a : Kˣ, dl (Additive.ofMul a) = D (a : K) / (a : K) := fun a => rfl
    obtain ⟨n, hn⟩ : ∃ n, n = v (Additive.ofMul f) := ⟨_, rfl⟩
    obtain ⟨w, hw⟩ : ∃ w : Kˣ, w = f * (π ^ n)⁻¹ := ⟨_, rfl⟩
    have hfw : f = w * π ^ n := by rw [hw, inv_mul_cancel_right]
    have hof : Additive.ofMul f = Additive.ofMul w + n • Additive.ofMul π := by
      rw [hfw, ofMul_mul, ofMul_zpow]
    have hvw : v (Additive.ofMul w) = 0 := by
      have := congrArg v hof
      rw [map_add, map_zsmul, hπ, smul_eq_mul, mul_one] at this
      omega
    have hdlf : D (f : K) / f = D (w : K) / w + (n : K) * (D (π : K) / π) := by
      have := congrArg dl hof
      rw [map_add, map_zsmul, hdl, hdl, hdl, zsmul_eq_mul] at this
      exact this
    rw [← hn, hdlf, add_sub_cancel_right, div_eq_mul_inv]
    have rw0 : wcValGe K v 0 (w : K) := (hreg _ _).mpr (Or.inr (le_of_eq (by rw [hVu, hvw])))
    have rwi : wcValGe K v 0 ((w : K)⁻¹) :=
      (hreg _ _).mpr (Or.inr (le_of_eq (by rw [hVinv _ w.ne_zero, hVu, hvw, neg_zero])))
    have := rmul _ _ _ _ (L1 _ rw0) rwi
    rwa [add_zero] at this

  have C4 : ∀ r : ℤ, wcValGe K v δ ((r : K) * (D π / π)) → (p : ℤ) ∣ r := by
    intro r hr
    by_cases hr0 : (r : K) = 0
    · exact (CharP.intCast_eq_zero_iff K p r).mp hr0
    exfalso
    rw [div_eq_mul_inv, hreg] at hr
    have hx : D (π : K) * (π : K)⁻¹ ≠ 0 := mul_ne_zero hu (inv_ne_zero hπ0)
    rcases hr with h | h
    · exact mul_ne_zero hr0 hx h
    · rw [hVmul _ _ hr0 hx, hVmul _ _ hu (inv_ne_zero hπ0), hVint r hr0, hVu', hVinv _ hπ0,
        hVπ] at h
      omega
  exact ⟨L1, C1, C2, C3, C4⟩

theorem wc_char_derivation_regular_ae (Ω A K I : Type u) [Field Ω] [CommRing A] [Field K]
    [Algebra Ω K] (ψ : Ω →+* A) (φ : A →+* K) (hφψ : φ.comp ψ = algebraMap Ω K)
    (hψ : ψ.FiniteType) (w : I → Additive Kˣ →+ ℤ) (hw : wcValFamily Ω K I w)
    (D : K →+ K) (hD : ∀ a b, D (a * b) = a * D b + b * D a)
    (hDc : ∀ c : Ω, D (algebraMap Ω K c) = 0) :
    ∃ Z : Set I, Z.Finite ∧ ∀ i, i ∉ Z → ∀ a : A,
      wcValGe K (w i) 0 (φ a) ∧ wcValGe K (w i) 0 (D (φ a)) :=
by
  classical
  letI : Algebra Ω A := ψ.toAlgebra
  have reg_zero : ∀ i, wcValGe K (w i) 0 0 := fun i => Or.inl rfl
  have reg_add : ∀ i (a b : K), wcValGe K (w i) 0 a → wcValGe K (w i) 0 b →
      wcValGe K (w i) 0 (a + b) := by
    intro i a b ha hb
    by_cases hab : a + b = 0
    · exact Or.inl hab
    rcases ha with ha | ⟨ha0, ha⟩
    · rw [ha, zero_add]; exact hb
    rcases hb with hb | ⟨hb0, hb⟩
    · rw [hb, add_zero]; exact Or.inr ⟨ha0, ha⟩
    refine Or.inr ⟨hab, ?_⟩
    have h := hw.1 i (Units.mk0 a ha0) (Units.mk0 b hb0) (Units.mk0 (a + b) hab) (by simp)
    exact le_trans (le_min ha hb) h
  have reg_mul : ∀ i (a b : K), wcValGe K (w i) 0 a → wcValGe K (w i) 0 b →
      wcValGe K (w i) 0 (a * b) := by
    intro i a b ha hb
    rcases ha with ha | ⟨ha0, ha⟩
    · left; rw [ha, zero_mul]
    rcases hb with hb | ⟨hb0, hb⟩
    · left; rw [hb, mul_zero]
    refine Or.inr ⟨mul_ne_zero ha0 hb0, ?_⟩
    have e : Units.mk0 (a * b) (mul_ne_zero ha0 hb0) = Units.mk0 a ha0 * Units.mk0 b hb0 :=
      Units.ext rfl
    rw [e, ofMul_mul, map_add]
    exact add_nonneg ha hb
  have reg_const : ∀ i (c : Ω), wcValGe K (w i) 0 (algebraMap Ω K c) := by
    intro i c
    by_cases hk : algebraMap Ω K c = 0
    · exact Or.inl hk
    exact Or.inr ⟨hk, (hw.2.2.2 (Units.mk0 _ hk)).mpr ⟨c, rfl⟩ i⟩
  obtain ⟨s, hs⟩ := (show Algebra.FiniteType Ω A from hψ).out
  set T : Set K := (φ '' (s : Set A)) ∪ ((fun a => D (φ a)) '' (s : Set A)) with hT
  have hTfin : T.Finite := (s.finite_toSet.image _).union (s.finite_toSet.image _)
  refine ⟨⋃ t ∈ T, {i | ¬ wcValGe K (w i) 0 t}, ?_, ?_⟩
  · refine hTfin.biUnion fun t _ => ?_
    by_cases ht : t = 0
    · exact Set.finite_empty.subset (fun i hi => hi (Or.inl ht))
    · refine (hw.2.1 (Units.mk0 t ht)).subset (fun i hi => ?_)
      intro h0
      exact hi (Or.inr ⟨ht, le_of_eq h0.symm⟩)
  · intro i hi
    have hgen : ∀ t ∈ T, wcValGe K (w i) 0 t := by
      intro t ht
      by_contra h
      exact hi (Set.mem_biUnion ht h)
    have key : ∀ x ∈ Algebra.adjoin Ω (s : Set A),
        wcValGe K (w i) 0 (φ x) ∧ wcValGe K (w i) 0 (D (φ x)) := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx => exact ⟨hgen _ (Or.inl ⟨x, hx, rfl⟩), hgen _ (Or.inr ⟨x, hx, rfl⟩)⟩
      | algebraMap r =>
        have e : φ (algebraMap Ω A r) = algebraMap Ω K r := by
          rw [← hφψ]; rfl
        rw [e, hDc]
        exact ⟨reg_const i r, reg_zero i⟩
      | add x y _ _ hx hy =>
        rw [map_add, map_add]
        exact ⟨reg_add i _ _ hx.1 hy.1, reg_add i _ _ hx.2 hy.2⟩
      | mul x y _ _ hx hy =>
        rw [map_mul, hD]
        exact ⟨reg_mul i _ _ hx.1 hy.1,
          reg_add i _ _ (reg_mul i _ _ hx.1 hy.2) (reg_mul i _ _ hy.1 hx.2)⟩
    intro a
    exact key a (by rw [hs]; trivial)

theorem wc_dedekind_strong_approx (A : Type u) [CommRing A] [IsDedekindDomain A]
    (S : Finset (IsDedekindDomain.HeightOneSpectrum A))
    (t : IsDedekindDomain.HeightOneSpectrum A → FractionRing A)
    (N : IsDedekindDomain.HeightOneSpectrum A → ℤ) :
    ∃ g : FractionRing A,
      (∀ v ∈ S, g - t v = 0 ∨ N v ≤ FractionalIdeal.count (FractionRing A) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors A) (g - t v))) ∧
      (∀ v ∉ S, g = 0 ∨ 0 ≤ FractionalIdeal.count (FractionRing A) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors A) g)) :=
by
  classical

  have s2 : ∀ (v : IsDedekindDomain.HeightOneSpectrum A) (x y : FractionRing A), x ≠ 0 → y ≠ 0 →
      FractionalIdeal.count (FractionRing A) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors A) (x / y)) =
      FractionalIdeal.count (FractionRing A) v (FractionalIdeal.spanSingleton (nonZeroDivisors A) x) -
      FractionalIdeal.count (FractionRing A) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors A) y) := by
    intro v x y hx hy
    have hxy : x / y ≠ 0 := div_ne_zero hx hy
    have e : FractionalIdeal.spanSingleton (nonZeroDivisors A) x =
        FractionalIdeal.spanSingleton (nonZeroDivisors A) (x / y) *
          FractionalIdeal.spanSingleton (nonZeroDivisors A) y := by
      rw [FractionalIdeal.spanSingleton_mul_spanSingleton, div_mul_cancel₀ x hy]
    rw [e, FractionalIdeal.count_mul (FractionRing A) v
      (FractionalIdeal.spanSingleton_ne_zero_iff.mpr hxy)
      (FractionalIdeal.spanSingleton_ne_zero_iff.mpr hy)]
    ring

  have s1 : ∀ (v : IsDedekindDomain.HeightOneSpectrum A) (a : A) (e : ℕ), a ≠ 0 →
      a ∈ v.asIdeal ^ e →
      (e : ℤ) ≤ FractionalIdeal.count (FractionRing A) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors A) (algebraMap A (FractionRing A) a)) := by
    intro v a e ha hae
    have hle : Ideal.span {a} ≤ v.asIdeal ^ e := (Ideal.span_singleton_le_iff_mem _).mpr hae
    obtain ⟨J, hJ⟩ := Ideal.dvd_iff_le.mpr hle
    have hI : (Ideal.span {a} : Ideal A) ≠ ⊥ := by
      rw [Ne, Ideal.span_singleton_eq_bot]; exact ha
    have hJ0 : J ≠ ⊥ := by
      rintro rfl; apply hI; rw [hJ, Ideal.mul_bot]
    rw [← FractionalIdeal.coeIdeal_span_singleton, hJ, FractionalIdeal.coeIdeal_mul,
      FractionalIdeal.coeIdeal_pow]
    have hv0 : ((v.asIdeal : FractionalIdeal (nonZeroDivisors A) (FractionRing A)) ^ e) ≠ 0 :=
      pow_ne_zero _ (FractionalIdeal.coeIdeal_ne_zero.mpr v.ne_bot)
    rw [FractionalIdeal.count_mul (FractionRing A) v hv0
      (FractionalIdeal.coeIdeal_ne_zero.mpr hJ0), FractionalIdeal.count_pow_self]
    have := FractionalIdeal.count_coe_nonneg (FractionRing A) v J
    omega

  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors A)
    (S.image t)
  have hd0 : algebraMap A (FractionRing A) (b : A) ≠ 0 :=
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors b.2
  have ha : ∀ v ∈ S, ∃ r : A, algebraMap A (FractionRing A) r =
      algebraMap A (FractionRing A) (b : A) * t v := by
    intro v hv
    obtain ⟨r, hr⟩ := hb (t v) (Finset.mem_image_of_mem t hv)
    exact ⟨r, by rw [hr, Algebra.smul_def]⟩
  choose! a ha using ha

  have s2' : ∀ (v : IsDedekindDomain.HeightOneSpectrum A) (x : FractionRing A), x ≠ 0 →
      FractionalIdeal.count (FractionRing A) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors A) (x / algebraMap A (FractionRing A) b)) =
      FractionalIdeal.count (FractionRing A) v (FractionalIdeal.spanSingleton (nonZeroDivisors A) x) -
      FractionalIdeal.count (FractionRing A) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors A) (algebraMap A (FractionRing A) b)) :=
    fun v x hx => s2 v x _ hx hd0
  have hCfin : {w : IsDedekindDomain.HeightOneSpectrum A | FractionalIdeal.count (FractionRing A) w
      (FractionalIdeal.spanSingleton (nonZeroDivisors A) (algebraMap A (FractionRing A) b)) ≠ 0}.Finite := by
    have hff := FractionalIdeal.finite_factors (R := A) (K := FractionRing A)
      (I := FractionalIdeal.spanSingleton (nonZeroDivisors A) (algebraMap A (FractionRing A) b))
    exact Filter.eventually_cofinite.mp hff

  obtain ⟨y, hy⟩ := IsDedekindDomain.exists_forall_sub_mem_ideal (s := S ∪ hCfin.toFinset)
    (fun w : IsDedekindDomain.HeightOneSpectrum A => w.asIdeal)
    (fun w => Int.toNat ((if w ∈ S then N w else 0) + FractionalIdeal.count (FractionRing A) w
      (FractionalIdeal.spanSingleton (nonZeroDivisors A) (algebraMap A (FractionRing A) b))))
    (fun w _ => w.prime) (fun w _ w' _ hne h => hne (IsDedekindDomain.HeightOneSpectrum.ext h))
    (fun w => if (w : IsDedekindDomain.HeightOneSpectrum A) ∈ S then a w else 0)
  have hinj : ∀ z : A, z ≠ 0 → algebraMap A (FractionRing A) z ≠ 0 := fun z hz =>
    (map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).mpr hz

  refine ⟨algebraMap A (FractionRing A) y / algebraMap A (FractionRing A) b, ?_, ?_⟩
  · intro v hv
    have h1 := hy v (Finset.mem_union_left _ hv)
    simp only [hv, ↓reduceIte] at h1
    have htv : t v = algebraMap A (FractionRing A) (a v) / algebraMap A (FractionRing A) b := by
      rw [eq_div_iff hd0, ha v hv]; ring
    have hg : algebraMap A (FractionRing A) y / algebraMap A (FractionRing A) b - t v =
        algebraMap A (FractionRing A) (y - a v) / algebraMap A (FractionRing A) b := by
      rw [htv, map_sub, sub_div]
    rw [hg]
    by_cases hya : y - a v = 0
    · left; rw [hya, map_zero, zero_div]
    · right
      rw [s2' v _ (hinj _ hya)]
      have h2 := s1 v _ _ hya h1
      have h3 := Int.self_le_toNat (N v + FractionalIdeal.count (FractionRing A) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors A) (algebraMap A (FractionRing A) b)))
      linarith
  · intro v hv
    by_cases hy0 : y = 0
    · left; rw [hy0, map_zero, zero_div]
    · right
      rw [s2' v _ (hinj _ hy0)]
      by_cases hvT : v ∈ S ∪ hCfin.toFinset
      · have h1 := hy v hvT
        simp only [hv, ↓reduceIte, sub_zero, zero_add] at h1
        have h2 := s1 v _ _ hy0 h1
        have h3 := Int.self_le_toNat (FractionalIdeal.count (FractionRing A) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors A) (algebraMap A (FractionRing A) b)))
        linarith
      · have hcv : FractionalIdeal.count (FractionRing A) v
            (FractionalIdeal.spanSingleton (nonZeroDivisors A) (algebraMap A (FractionRing A) b)) = 0 := by
          by_contra hcv
          exact hvT (Finset.mem_union_right _ (hCfin.mem_toFinset.mpr hcv))
        have h2 := s1 v y 0 hy0 (by rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top)
        push_cast at h2
        linarith

theorem wc_dedekind_uniformizer_count (A : Type u) [CommRing A] [IsDedekindDomain A]
    (v : IsDedekindDomain.HeightOneSpectrum A) :
    ∃ π : A, π ≠ 0 ∧ FractionalIdeal.count (FractionRing A) v
      (FractionalIdeal.spanSingleton (nonZeroDivisors A) (algebraMap A (FractionRing A) π)) = 1 :=
by
  obtain ⟨π, hπ⟩ := IsDedekindDomain.HeightOneSpectrum.intValuation_exists_uniformizer v
  have hπ0 : π ≠ 0 := by
    rintro rfl
    rw [map_zero] at hπ
    exact WithZero.exp_ne_zero hπ.symm
  refine ⟨π, hπ0, ?_⟩
  have h1 := IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg v hπ0
  rw [hπ, WithZero.exp_inj] at h1
  have hN : ((Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {π})).factors : ℤ) = 1 := by
    omega
  have hJ : Ideal.span {π} ≠ 0 := by
    rw [Ne, Submodule.zero_eq_bot, Ideal.span_singleton_eq_bot]
    exact hπ0
  rw [← FractionalIdeal.coeIdeal_span_singleton, FractionalIdeal.count_coe (FractionRing A) v hJ]
  exact hN

theorem wc_semilinear_lang (Ω V : Type u) [Field Ω] [IsAlgClosed Ω] (p : ℕ) [Fact p.Prime]
    [CharP Ω p] [AddCommGroup V] [Module Ω V] [FiniteDimensional Ω V] (C : V →+ V)
    (hC : ∀ (c : Ω) (v : V), C (c ^ p • v) = c • C v) :
    ∀ β : V, ∃ η : V, η - C η = β :=
by
  classical
  have hp : p.Prime := Fact.out
  have hp2 : 2 ≤ p := hp.two_le

  have s2 : ∀ (m : ℕ) (a : ℕ → Ω), a 0 ≠ 0 → ∃ y : ℕ → Ω, y m ≠ 0 ∧ y 0 ^ p = a 0 * y m ∧
      ∀ i < m, y (i + 1) ^ p = y i + a (i + 1) * y m := by
    intro m a ha
    let s : ℕ → Polynomial Ω := fun j =>
      Nat.rec Polynomial.X (fun k sk => sk ^ p - Polynomial.C (a (m - k)) * Polynomial.X) j
    have hs0 : s 0 = Polynomial.X := rfl
    have hs : ∀ k, s (k + 1) = s k ^ p - Polynomial.C (a (m - k)) * Polynomial.X := fun k => rfl
    have hA : ∀ j, (s j).Monic ∧ (s j).natDegree = p ^ j ∧ (s j).coeff 0 = 0 := by
      intro j
      induction j with
      | zero => exact ⟨by rw [hs0]; exact Polynomial.monic_X,
          by rw [hs0, Polynomial.natDegree_X, pow_zero], by rw [hs0, Polynomial.coeff_X_zero]⟩
      | succ j ih =>
        obtain ⟨hm, hd, hc⟩ := ih
        have hpow : (s j ^ p).natDegree = p ^ (j + 1) := by
          rw [hm.natDegree_pow, hd, pow_succ, mul_comm]
        have hpj : 2 ≤ p ^ (j + 1) := le_trans hp2 (Nat.le_self_pow (by omega) p)
        have hlt : (Polynomial.C (a (m - j)) * Polynomial.X).natDegree < (s j ^ p).natDegree := by
          rw [hpow]
          exact lt_of_le_of_lt ((Polynomial.natDegree_C_mul_le _ _).trans
            Polynomial.natDegree_X_le) (by omega)
        refine ⟨?_, ?_, ?_⟩
        · rw [hs]; exact (hm.pow p).sub_of_left (Polynomial.degree_lt_degree hlt)
        · rw [hs, Polynomial.natDegree_sub_eq_left_of_natDegree_lt hlt, hpow]
        · rw [hs, Polynomial.coeff_sub, Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_pow,
            ← Polynomial.coeff_zero_eq_eval_zero, hc, zero_pow hp.ne_zero,
            Polynomial.coeff_C_mul_X]
          simp
    obtain ⟨_, hGd, hG0⟩ := hA (m + 1)
    have hG1 : (s (m + 1)).coeff 1 = - a 0 := by
      have h1 : Polynomial.X ∣ s m := Polynomial.X_dvd_iff.mpr (hA m).2.2
      have h2 : Polynomial.X ^ 2 ∣ s m ^ p :=
        (pow_dvd_pow Polynomial.X hp2).trans (pow_dvd_pow_of_dvd h1 p)
      have h3 := Polynomial.X_pow_dvd_iff.mp h2 1 (by norm_num)
      rw [hs, Polynomial.coeff_sub, h3, Polynomial.coeff_C_mul_X, Nat.sub_self]
      simp
    set H := (s (m + 1)).divX with hH
    have hH0 : H.coeff 0 = - a 0 := by rw [hH, Polynomial.coeff_divX, hG1]
    have hHd : H.natDegree = p ^ (m + 1) - 1 := by
      rw [hH, Polynomial.natDegree_divX_eq_natDegree_tsub_one, hGd]
    have hpm : 2 ≤ p ^ (m + 1) := le_trans hp2 (Nat.le_self_pow (by omega) p)
    have hHdeg : H.degree ≠ 0 :=
      ne_of_gt (Polynomial.natDegree_pos_iff_degree_pos.mp (by omega))
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_root H hHdeg
    have hz0 : z ≠ 0 := by
      rintro rfl
      have : H.eval 0 = 0 := hz
      rw [← Polynomial.coeff_zero_eq_eval_zero, hH0, neg_eq_zero] at this
      exact ha this
    have hGz : (s (m + 1)).eval z = 0 := by
      have e := Polynomial.X_mul_divX_add (s (m + 1))
      rw [← e, hG0, ← hH]
      have : H.eval z = 0 := hz
      simp [this]
    refine ⟨fun i => (s (m - i)).eval z, ?_, ?_, ?_⟩
    · simp only [Nat.sub_self, hs0, Polynomial.eval_X]; exact hz0
    · simp only [Nat.sub_self, hs0, Polynomial.eval_X, Nat.sub_zero]
      rw [hs, Nat.sub_self] at hGz
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_X] at hGz
      linear_combination hGz
    · intro i hi
      simp only [Nat.sub_self, hs0, Polynomial.eval_X]
      have e1 : m - i = (m - (i + 1)) + 1 := by omega
      have e2 : m - (m - (i + 1)) = i + 1 := by omega
      rw [e1, hs, e2]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_X]
      ring

  have s1 : ∀ (W : Type u) [AddCommGroup W] [Module Ω W] [FiniteDimensional Ω W]
      (T : W → W) (v : W), v ≠ 0 → ∃ m : ℕ,
      LinearIndependent Ω (fun i : Fin (m + 1) => T^[(i : ℕ)] v) ∧
      ∃ a : ℕ → Ω, T^[m + 1] v = ∑ i ∈ Finset.range (m + 1), a i • T^[i] v := by
    intro W _ _ _ T v hv
    let P : ℕ → Prop := fun n => LinearIndependent Ω (fun i : Fin n => T^[(i : ℕ)] v)
    have hex : ∃ n, ¬ P (n + 2) := by
      refine ⟨Module.finrank Ω W, fun h => ?_⟩
      have := h.fintype_card_le_finrank
      simp at this
    obtain ⟨m, hm, hmin⟩ : ∃ m, ¬ P (m + 2) ∧ ∀ k < m, P (k + 2) :=
      ⟨Nat.find hex, Nat.find_spec hex, fun k hk => not_not.mp (Nat.find_min hex hk)⟩
    have hP : P (m + 1) := by
      cases m with
      | zero =>
        show LinearIndependent Ω (fun i : Fin 1 => T^[(i : ℕ)] v)
        rw [linearIndependent_unique_iff]
        simpa using hv
      | succ k => exact hmin k (by omega)
    have hfun : (fun i : Fin (m + 2) => T^[(i : ℕ)] v) =
        (Fin.snoc (fun i : Fin (m + 1) => T^[(i : ℕ)] v) (T^[m + 1] v) : Fin (m + 2) → W) := by
      funext i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · simp
      · simp
    have hm' : ¬ LinearIndependent Ω
        (Fin.snoc (fun i : Fin (m + 1) => T^[(i : ℕ)] v) (T^[m + 1] v) : Fin (m + 2) → W) := by
      rw [← hfun]; exact hm
    rw [linearIndependent_finSnoc] at hm'
    have hmem : T^[m + 1] v ∈
        Submodule.span Ω (Set.range (fun i : Fin (m + 1) => T^[(i : ℕ)] v)) := by
      by_contra h; exact hm' ⟨hP, h⟩
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun Ω).mp hmem
    refine ⟨m, hP, fun n => if h : n < m + 1 then c ⟨n, h⟩ else 0, ?_⟩
    rw [← hc, Finset.sum_range]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    simp [i.isLt]

  have s3a : ∀ (W : Type u) [AddCommGroup W] [Module Ω W] (D : W →+ W),
      (∀ (c : Ω) (v : W), D (c ^ p • v) = c • D v) → ∀ (v : W) (m : ℕ),
      LinearIndependent Ω (fun i : Fin (m + 1) => (⇑D)^[(i : ℕ)] v) → ∀ a : ℕ → Ω,
      (⇑D)^[m + 1] v = ∑ i ∈ Finset.range (m + 1), a i • (⇑D)^[i] v → a 0 = 0 →
      ∃ u : W, u ≠ 0 ∧ D u = 0 := by
    intro W _ _ D hD v m hli a hrel ha
    refine ⟨(⇑D)^[m] v - ∑ j ∈ Finset.range m, (a (j + 1)) ^ p • (⇑D)^[j] v, ?_, ?_⟩
    · intro h0
      rw [Fintype.linearIndependent_iff] at hli
      have key := hli (fun i => if (i : ℕ) = m then 1 else -(a (i + 1)) ^ p) ?_ (Fin.last m)
      · simp at key
      · rw [Fin.sum_univ_castSucc]
        simp only [Fin.val_castSucc, Fin.val_last, ite_true]
        rw [← h0, Finset.sum_range]
        have : ∀ i : Fin m, ((i : ℕ) = m) = False := fun i => by simp [Nat.ne_of_lt i.isLt]
        simp only [this, ite_false, neg_smul, Finset.sum_neg_distrib, one_smul]
        abel
    · rw [map_sub, map_sum]
      simp only [hD]
      have e : D ((⇑D)^[m] v) = (⇑D)^[m + 1] v := (Function.iterate_succ_apply' _ _ _).symm
      rw [e, hrel, Finset.sum_range_succ', ha, zero_smul, add_zero]
      simp only [Function.iterate_succ_apply']
      exact sub_self _

  have s3b : ∀ (W : Type u) [AddCommGroup W] [Module Ω W] (D : W →+ W),
      (∀ (c : Ω) (v : W), D (c ^ p • v) = c • D v) → ∀ (v : W) (m : ℕ),
      LinearIndependent Ω (fun i : Fin (m + 1) => (⇑D)^[(i : ℕ)] v) → ∀ a : ℕ → Ω,
      (⇑D)^[m + 1] v = ∑ i ∈ Finset.range (m + 1), a i • (⇑D)^[i] v →
      ∀ y : ℕ → Ω, y m ≠ 0 → y 0 ^ p = a 0 * y m →
      (∀ i < m, y (i + 1) ^ p = y i + a (i + 1) * y m) → ∃ w : W, w ≠ 0 ∧ D w = w := by
    intro W _ _ D hD v m hli a hrel y hym hy0 hy
    refine ⟨∑ i ∈ Finset.range (m + 1), (y i) ^ p • (⇑D)^[i] v, ?_, ?_⟩
    · intro h0
      rw [Fintype.linearIndependent_iff] at hli
      have key := hli (fun i => (y i) ^ p) ?_ (Fin.last m)
      · simp only [Fin.val_last] at key
        exact hym (pow_eq_zero_iff hp.ne_zero |>.mp key)
      · rw [← h0, Finset.sum_range]
    · have hR : ∑ i ∈ Finset.range (m + 1), (y i) ^ p • (⇑D)^[i] v =
          ∑ i ∈ Finset.range m, (y i + y m * a (i + 1)) • D ((⇑D)^[i] v) + (y m * a 0) • v := by
        rw [Finset.sum_range_succ', hy0, mul_comm (a 0)]
        congr 1
        refine Finset.sum_congr rfl (fun j hj => ?_)
        rw [hy j (Finset.mem_range.mp hj), mul_comm (a (j + 1)), Function.iterate_succ_apply']
      have e : D ((⇑D)^[m] v) = (⇑D)^[m + 1] v := (Function.iterate_succ_apply' _ _ _).symm
      have hL : D (∑ i ∈ Finset.range (m + 1), (y i) ^ p • (⇑D)^[i] v) =
          ∑ i ∈ Finset.range m, (y i + y m * a (i + 1)) • D ((⇑D)^[i] v) + (y m * a 0) • v := by
        rw [map_sum]
        simp only [hD]
        rw [Finset.sum_range_succ, e, hrel, Finset.sum_range_succ', smul_add, Finset.smul_sum]
        simp only [add_smul, Finset.sum_add_distrib, smul_smul, Function.iterate_succ_apply',
          Function.iterate_zero_apply]
        abel
      rw [hL, hR]

  have s4 : ∀ (W : Type u) [AddCommGroup W] [Module Ω W] (D : W →+ W),
      (∀ (c : Ω) (v : W), D (c ^ p • v) = c • D v) → ∀ (w : W) (μ : Ω), D w = μ • w →
      ∀ c : Ω, ∃ t : Ω, t • w - D (t • w) = c • w := by
    intro W _ _ D hD w μ hw c
    have hlt : (Polynomial.C μ * Polynomial.X + Polynomial.C c).degree <
        (Polynomial.X ^ p : Polynomial Ω).degree := by
      rw [Polynomial.degree_X_pow]
      exact lt_of_le_of_lt Polynomial.degree_linear_le (by exact_mod_cast (by omega : 1 < p))
    have hQd : (Polynomial.X ^ p - (Polynomial.C μ * Polynomial.X + Polynomial.C c)).degree ≠ 0 := by
      rw [Polynomial.degree_sub_eq_left_of_degree_lt hlt, Polynomial.degree_X_pow]
      exact_mod_cast hp.ne_zero
    obtain ⟨s, hs⟩ := IsAlgClosed.exists_root _ hQd
    have hs' : s ^ p - (μ * s + c) = 0 := by simpa using hs
    refine ⟨s ^ p, ?_⟩
    rw [hD, hw, smul_smul, ← sub_smul]
    congr 1
    linear_combination hs'

  have eig : ∀ (W : Type u) [AddCommGroup W] [Module Ω W] [FiniteDimensional Ω W] (D : W →+ W),
      (∀ (c : Ω) (v : W), D (c ^ p • v) = c • D v) → ∀ x : W, x ≠ 0 →
      ∃ w : W, w ≠ 0 ∧ ∃ μ : Ω, D w = μ • w := by
    intro W _ _ _ D hD x hx
    obtain ⟨m, hli, a, hrel⟩ := s1 W (⇑D) x hx
    by_cases ha : a 0 = 0
    · obtain ⟨u, hu, hDu⟩ := s3a W D hD x m hli a hrel ha
      exact ⟨u, hu, 0, by rw [hDu, zero_smul]⟩
    · obtain ⟨y, hym, hy0, hy⟩ := s2 m a ha
      obtain ⟨w, hw, hDw⟩ := s3b W D hD x m hli a hrel y hym hy0 hy
      exact ⟨w, hw, 1, by rw [hDw, one_smul]⟩

  have key : ∀ n : ℕ, ∀ (W : Type u) [AddCommGroup W] [Module Ω W] [FiniteDimensional Ω W],
      Module.finrank Ω W = n → ∀ (D : W →+ W), (∀ (c : Ω) (v : W), D (c ^ p • v) = c • D v) →
      ∀ β : W, ∃ η : W, η - D η = β := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
    intro W _ _ _ hn D hD β
    by_cases htriv : ∀ x : W, x = 0
    · exact ⟨0, by rw [map_zero, sub_zero, htriv β]⟩
    push_neg at htriv
    obtain ⟨x, hx⟩ := htriv
    obtain ⟨w, hw, μ, hDw⟩ := eig W D hD x hx
    let L : Submodule Ω W := Submodule.span Ω {w}
    have hstab : L.toAddSubgroup ≤ L.toAddSubgroup.comap D := by
      intro z hz
      have hz' : z ∈ L := hz
      obtain ⟨t, rfl⟩ := Submodule.mem_span_singleton.mp hz'
      obtain ⟨s, rfl⟩ := IsAlgClosed.exists_pow_nat_eq t hp.pos
      show D (s ^ p • w) ∈ L
      rw [hD, hDw, smul_smul]
      exact Submodule.mem_span_singleton.mpr ⟨_, rfl⟩
    let D' : (W ⧸ L) →+ (W ⧸ L) := QuotientAddGroup.map L.toAddSubgroup L.toAddSubgroup D hstab
    have hD'mk : ∀ z : W, D' (Submodule.Quotient.mk z) = Submodule.Quotient.mk (D z) :=
      fun z => rfl
    have hD' : ∀ (c : Ω) (q : W ⧸ L), D' (c ^ p • q) = c • D' q := by
      intro c q
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective L q
      rw [← Submodule.Quotient.mk_smul, hD'mk, hD'mk, hD, Submodule.Quotient.mk_smul]
    have hdim : Module.finrank Ω (W ⧸ L) < n := by
      have h1 := Submodule.finrank_quotient_add_finrank L
      have h2 : Module.finrank Ω L = 1 := finrank_span_singleton hw
      omega
    obtain ⟨ηb, hηb⟩ := IH _ hdim (W ⧸ L) rfl D' hD' (Submodule.Quotient.mk β)
    obtain ⟨η, rfl⟩ := Submodule.Quotient.mk_surjective L ηb
    have hmem : η - D η - β ∈ L := by
      rw [← Submodule.Quotient.mk_eq_zero, Submodule.Quotient.mk_sub, Submodule.Quotient.mk_sub,
        ← hD'mk, hηb, sub_self]
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hmem
    obtain ⟨t, ht⟩ := s4 W D hD w μ hDw c
    refine ⟨η - t • w, ?_⟩
    rw [map_sub, ← sub_eq_zero]
    have e : η - t • w - (D η - D (t • w)) - β = (η - D η - β) - (t • w - D (t • w)) := by abel
    rw [e, ht, hc, sub_self]
  exact key _ V rfl C hC

theorem wc_curve_classGroup_char_divisible : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)], IsAffineOpen U → ((U : Set X)ᶜ).Finite →
    ∀ p : ℕ, p.Prime → (p : Ω) = 0 →
    ∀ c : ClassGroup Γ(X, U), ∃ d : ClassGroup Γ(X, U), d ^ p = c :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim U _ hU hfin p hp hpΩ
  classical
  haveI := hirr
  haveI hpF : Fact p.Prime := ⟨hp⟩

  obtain ⟨ψ₀, hψs, hψk⟩ := dedekind_classGroup_divisor_presentation Γ(X, U)
  suffices hstar : ∀ n : IsDedekindDomain.HeightOneSpectrum Γ(X, U) →₀ ℤ,
      ∃ f : (FractionRing Γ(X, U))ˣ, ∀ v, (p : ℤ) ∣ n v -
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U))) by
    intro c
    obtain ⟨n, hn⟩ := hψs (Additive.ofMul c)
    obtain ⟨f, hf⟩ := hstar n
    have hfin' : (Function.support (fun v : IsDedekindDomain.HeightOneSpectrum Γ(X, U) =>
        (n v - FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U))
            (f : FractionRing Γ(X, U)))) / (p : ℤ))).Finite := by
      have h1 : {v | FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U))
            (f : FractionRing Γ(X, U))) ≠ 0}.Finite :=
        Filter.eventually_cofinite.mp (FractionalIdeal.finite_factors _)
      refine (n.support.finite_toSet.union h1).subset ?_
      intro v hv
      rw [Function.mem_support] at hv
      by_contra hc
      apply hv
      have hc1 : n v = 0 := by
        by_contra h
        exact hc (Or.inl (Finsupp.mem_support_iff.mpr h))
      have hc2 : FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U))
            (f : FractionRing Γ(X, U))) = 0 := by
        by_contra h
        exact hc (Or.inr h)
      rw [hc1, hc2]
      simp
    let e := Finsupp.ofSupportFinite _ hfin'
    have hker : ψ₀ (n - p • e) = 0 := by
      rw [hψk]
      refine ⟨f, fun v => ?_⟩
      rw [Finsupp.sub_apply, Finsupp.smul_apply]
      simp only [e, Finsupp.ofSupportFinite_coe]
      rw [nsmul_eq_mul, Int.mul_ediv_cancel' (hf v)]
      ring
    refine ⟨Additive.toMul (ψ₀ e), ?_⟩
    rw [map_sub, map_nsmul, sub_eq_zero] at hker
    rw [← toMul_nsmul, ← hker, hn, toMul_ofMul]
  intro n
  by_cases hemp : IsEmpty (IsDedekindDomain.HeightOneSpectrum Γ(X, U))
  · exact ⟨1, fun v => (hemp.false v).elim⟩
  rw [not_isEmpty_iff] at hemp
  obtain ⟨v₀⟩ := hemp

  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
  obtain ⟨w, hwF, -, hwU, -⟩ := wc_curve_true_valuations Ω X fX hnorm hdim U hU hfin
  have hpK : ((p : ℕ) : FractionRing Γ(X, U)) = 0 := by
    rw [← map_natCast (algebraMap Ω (FractionRing Γ(X, U))) p, hpΩ, map_zero]
  haveI : CharP (FractionRing Γ(X, U)) p := (CharP.charP_iff_prime_eq_zero hp).mpr hpK
  haveI : CharP Ω p := (CharP.charP_iff_prime_eq_zero hp).mpr hpΩ
  obtain ⟨-, hinjU, hvU, -⟩ := wc_dedekind_affine_points X U hU
  have hA6 := wc_curve_function_field_finite_rank Ω X fX hnorm hdim U hU hfin
  have hR := wc_rr_residue_trivial Ω (FractionRing Γ(X, U)) {x : X // x ≠ genericPoint X} w hwF hA6
  have hDim := wc_rr_dimension_step Ω (FractionRing Γ(X, U)) {x : X // x ≠ genericPoint X} w hwF hR
  let ι : IsDedekindDomain.HeightOneSpectrum Γ(X, U) → {x : X // x ≠ genericPoint X} :=
    fun v => ⟨hU.fromSpec ⟨v.asIdeal, v.isPrime⟩, (hvU v).2⟩
  have hιinj : Function.Injective ι := by
    intro a b h
    have h' : (ι a).1 = (ι b).1 := congrArg Subtype.val h
    exact hinjU h'
  have hwι : ∀ v (f : (FractionRing Γ(X, U))ˣ), w (ι v) (Additive.ofMul f) =
      FractionalIdeal.count (FractionRing Γ(X, U)) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U))) := by
    intro v f
    obtain ⟨v', hv', hf⟩ := hwU (ι v) (hvU v).1
    have : v' = v := @hinjU v' v hv'
    subst this
    exact hf f
  have hBfin : {i : {x : X // x ≠ genericPoint X} | i ∉ Set.range ι}.Finite := by
    refine (Set.Finite.preimage (f := fun i : {x : X // x ≠ genericPoint X} => i.1)
      (fun a _ b _ h => Subtype.ext h) hfin).subset ?_
    intro i hi
    show i.1 ∉ (U : Set X)
    intro hiU
    obtain ⟨v', hv', -⟩ := hwU i hiU
    exact hi ⟨v', Subtype.ext hv'⟩
  have hconst : ∀ i (c : Ω) (hc : algebraMap Ω (FractionRing Γ(X, U)) c ≠ 0),
      w i (Additive.ofMul (Units.mk0 _ hc)) = 0 := by
    intro i c hc
    have h1 := ((hwF.2.2.2 (Units.mk0 _ hc)).mpr ⟨c, rfl⟩) i
    have h2 := ((hwF.2.2.2 (Units.mk0 _ hc)⁻¹).mpr ⟨c⁻¹, by simp [map_inv₀]⟩) i
    rw [ofMul_inv, map_neg] at h2
    omega

  have vge_iff : ∀ (v : Additive (FractionRing Γ(X, U))ˣ →+ ℤ) (k : ℤ)
      (g : FractionRing Γ(X, U)) (hg : g ≠ 0),
      wcValGe _ v k g ↔ k ≤ v (Additive.ofMul (Units.mk0 g hg)) := by
    intro v k g hg
    constructor
    · rintro (h | ⟨hg', h⟩)
      · exact absurd h hg
      · exact h
    · intro h
      exact Or.inr ⟨hg, h⟩
  have vge_add : ∀ i k (a b : FractionRing Γ(X, U)), wcValGe _ (w i) k a →
      wcValGe _ (w i) k b → wcValGe _ (w i) k (a + b) := by
    intro i k a b ha hb
    by_cases hab : a + b = 0
    · exact Or.inl hab
    by_cases ha0 : a = 0
    · rw [ha0, zero_add]; exact hb
    by_cases hb0 : b = 0
    · rw [hb0, add_zero]; exact ha
    rw [vge_iff _ _ _ ha0] at ha
    rw [vge_iff _ _ _ hb0] at hb
    rw [vge_iff _ _ _ hab]
    have := hwF.1 i (Units.mk0 a ha0) (Units.mk0 b hb0) (Units.mk0 (a + b) hab) (by simp)
    omega
  have hneg1 : ∀ i, w i (Additive.ofMul (-1 : (FractionRing Γ(X, U))ˣ)) = 0 := by
    intro i
    have h : w i (Additive.ofMul ((-1 : (FractionRing Γ(X, U))ˣ) * (-1))) = 0 := by
      rw [neg_one_mul, neg_neg, ofMul_one, map_zero]
    rw [ofMul_mul, map_add] at h
    omega
  have vge_neg : ∀ i k (a : FractionRing Γ(X, U)), wcValGe _ (w i) k a →
      wcValGe _ (w i) k (-a) := by
    intro i k a ha
    by_cases ha0 : a = 0
    · rw [ha0, neg_zero]; exact Or.inl rfl
    have hna : -a ≠ 0 := neg_ne_zero.mpr ha0
    rw [vge_iff _ _ _ ha0] at ha
    rw [vge_iff _ _ _ hna]
    have he : Units.mk0 (-a) hna = (-1) * Units.mk0 a ha0 := Units.ext (by simp)
    rw [he, ofMul_mul, map_add, hneg1]
    omega
  have vge_sub : ∀ i k (a b : FractionRing Γ(X, U)), wcValGe _ (w i) k a →
      wcValGe _ (w i) k b → wcValGe _ (w i) k (a - b) := fun i k a b ha hb => by
    rw [sub_eq_add_neg]; exact vge_add i k a (-b) ha (vge_neg i k b hb)
  have vge_const : ∀ i k (c : Ω) (a : FractionRing Γ(X, U)), wcValGe _ (w i) k a →
      wcValGe _ (w i) k (algebraMap Ω (FractionRing Γ(X, U)) c * a) := by
    intro i k c a ha
    by_cases hc : algebraMap Ω (FractionRing Γ(X, U)) c = 0
    · rw [hc, zero_mul]; exact Or.inl rfl
    by_cases ha0 : a = 0
    · rw [ha0, mul_zero]; exact Or.inl rfl
    have hca : algebraMap Ω (FractionRing Γ(X, U)) c * a ≠ 0 := mul_ne_zero hc ha0
    rw [vge_iff _ _ _ ha0] at ha
    rw [vge_iff _ _ _ hca]
    have he : Units.mk0 _ hca = Units.mk0 _ hc * Units.mk0 a ha0 := Units.ext (by simp)
    rw [he, ofMul_mul, map_add, hconst i c hc]
    omega

  obtain ⟨t, ht⟩ := hwF.2.2.1 (ι v₀)
  have htnc : (t : FractionRing Γ(X, U)) ∉
      Set.range (algebraMap Ω (FractionRing Γ(X, U))) := by
    rintro ⟨c, hc⟩
    have hc' : algebraMap Ω (FractionRing Γ(X, U)) c ≠ 0 := by rw [hc]; exact Units.ne_zero _
    have h1 := hconst (ι v₀) c hc'
    have he : Units.mk0 _ hc' = t := Units.ext hc
    rw [he, ht] at h1
    exact one_ne_zero h1
  obtain ⟨⟨x₀, hx₀⟩, hpb⟩ := wc_char_pbasis Ω (FractionRing Γ(X, U)) p hA6 _ htnc
  obtain ⟨D, C, hLeib, hDx, hDp, hDpow, hCart, hCsemi⟩ :=
    wc_char_derivation_cartier (FractionRing Γ(X, U)) p x₀ (hpb x₀ hx₀)
  have hHoch := wc_char_hochschild (FractionRing Γ(X, U)) p D hLeib
  obtain ⟨hH, hJac⟩ := wc_char_jacobson (FractionRing Γ(X, U)) p D hLeib hDp hHoch
  have hDc : ∀ c : Ω, D (algebraMap Ω (FractionRing Γ(X, U)) c) = 0 := by
    intro c
    obtain ⟨c', hc'⟩ := IsAlgClosed.exists_pow_nat_eq c hp.pos
    rw [← hc', map_pow]
    exact hDpow _
  have hx0 : x₀ ≠ 0 := fun h => hx₀ 0 (by rw [h, zero_pow hp.ne_zero])

  have hπex : ∀ i : {x : X // x ≠ genericPoint X}, ∃ π : (FractionRing Γ(X, U))ˣ,
      w i (Additive.ofMul π) = 1 ∧ ∀ v, ι v = i → ∃ a : Γ(X, U),
        algebraMap Γ(X, U) (FractionRing Γ(X, U)) a = π := by
    intro i
    by_cases hi : i ∈ Set.range ι
    · obtain ⟨v, rfl⟩ := hi
      obtain ⟨a, ha0, ha⟩ := wc_dedekind_uniformizer_count Γ(X, U) v
      have hne : algebraMap Γ(X, U) (FractionRing Γ(X, U)) a ≠ 0 :=
        IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero ha0)
      refine ⟨Units.mk0 _ hne, ?_, fun v' _ => ⟨a, rfl⟩⟩
      rw [hwι v, Units.val_mk0, ha]
    · obtain ⟨t', ht'⟩ := hwF.2.2.1 i
      exact ⟨t', ht', fun v hv => absurd ⟨v, hv⟩ hi⟩
  choose π hπ1 hπA using hπex
  have hπnp : ∀ i (z : FractionRing Γ(X, U)), z ^ p ≠ (π i : FractionRing Γ(X, U)) := by
    intro i z hz
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow hp.ne_zero] at hz
      exact Units.ne_zero _ hz.symm
    have he : Units.mk0 z hz0 ^ p = π i := Units.ext (by simp [hz])
    have h1 := hπ1 i
    rw [← he, ofMul_pow, map_nsmul, nsmul_eq_mul] at h1
    have h2 : (p : ℤ) ∣ 1 := ⟨_, h1.symm⟩
    have h3 := Int.eq_one_of_dvd_one (by positivity) h2
    have := hp.one_lt
    omega
  have hDne : ∃ z, D z ≠ 0 := ⟨x₀, by rw [hDx]; exact one_ne_zero⟩
  have hloc := fun i => wc_char_local_cartier (FractionRing Γ(X, U)) p D C (w i) (π i) hLeib hDp
    hDne hDpow hH hCart (hwF.1 i) (hπ1 i) (fun g => (hpb _ (hπnp i) g).exists)
  let δ : {x : X // x ≠ genericPoint X} → ℤ := fun i =>
    w i (Additive.ofMul (Units.mk0 _ (hloc i).1))
  have hl := fun i => (hloc i).2 (δ i) ⟨(hloc i).1, rfl⟩
  obtain ⟨u, hu⟩ : ∃ u : {x : X // x ≠ genericPoint X} → FractionRing Γ(X, U),
      ∀ i, u i = D (π i : FractionRing Γ(X, U)) / (π i : FractionRing Γ(X, U)) := ⟨_, fun i => rfl⟩

  let ψ : Ω →+* Γ(X, U) := (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
    (fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)
  have hψFT : ψ.FiniteType := by
    have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType fX inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
    have h2 : (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom.FiniteType :=
      RingHom.FiniteType.of_surjective _ (fun y =>
        ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y, by
          change ((Scheme.ΓSpecIso _).hom ≫ (Scheme.ΓSpecIso _).inv).hom y = y
          rw [Iso.hom_inv_id]; rfl⟩)
    exact h1.comp h2
  obtain ⟨Z, hZfin, hZ⟩ := wc_char_derivation_regular_ae Ω Γ(X, U) (FractionRing Γ(X, U))
    {x : X // x ≠ genericPoint X} ψ (algebraMap Γ(X, U) (FractionRing Γ(X, U))) rfl hψFT w hwF
    D hLeib hDc
  obtain ⟨Z', hZ'def⟩ : ∃ Z' : Set {x : X // x ≠ genericPoint X},
      Z' = Z ∪ {i | w i (Additive.ofMul (Units.mk0 x₀ hx0)) ≠ 0} := ⟨_, rfl⟩
  have hZ'fin : Z'.Finite := by rw [hZ'def]; exact hZfin.union (hwF.2.1 _)
  have hδ0 : ∀ v, ι v ∉ Z' → δ (ι v) = 0 := by
    intro v hv
    have hvZ : ι v ∉ Z := fun h => hv (by rw [hZ'def]; exact Or.inl h)
    have hvx : w (ι v) (Additive.ofMul (Units.mk0 x₀ hx0)) = 0 := by
      by_contra h
      exact hv (by rw [hZ'def]; exact Or.inr h)
    apply le_antisymm
    · have h1 := (hl (ι v)).1 x₀ (Or.inr ⟨hx0, le_of_eq hvx.symm⟩)
      rw [hDx, vge_iff _ _ _ one_ne_zero] at h1
      have h1' : Units.mk0 (1 : FractionRing Γ(X, U)) one_ne_zero = 1 := Units.ext rfl
      rw [h1', ofMul_one, map_zero] at h1
      exact h1
    · obtain ⟨a, ha⟩ := hπA (ι v) v rfl
      have h2 := (hZ (ι v) hvZ a).2
      rw [ha, vge_iff _ _ _ (hloc (ι v)).1] at h2
      exact h2

  have hpre : (ι ⁻¹' Z').Finite :=
    Set.Finite.preimage (f := ι) (fun a _ b _ h => hιinj h) hZ'fin
  obtain ⟨g, hgS, hgnS⟩ := wc_dedekind_strong_approx Γ(X, U) (n.support ∪ hpre.toFinset)
    (fun v => (n v : FractionRing Γ(X, U)) * u (ι v)) (fun v => δ (ι v))
  have hgv : ∀ v, wcValGe _ (w (ι v)) (δ (ι v)) (g - (n v : FractionRing Γ(X, U)) * u (ι v)) := by
    intro v
    by_cases hvS : v ∈ n.support ∪ hpre.toFinset
    · rcases hgS v hvS with h | h
      · exact Or.inl h
      · by_cases h0 : g - (n v : FractionRing Γ(X, U)) * u (ι v) = 0
        · exact Or.inl h0
        · refine Or.inr ⟨h0, ?_⟩
          rw [hwι v, Units.val_mk0]
          exact h
    · have hn : n v = 0 := by
        by_contra h
        exact hvS (Finset.mem_union_left _ (Finsupp.mem_support_iff.mpr h))
      have hZv : ι v ∉ Z' := fun h => hvS (Finset.mem_union_right _ (hpre.mem_toFinset.mpr h))
      rw [hn, hδ0 v hZv, Int.cast_zero, zero_mul, sub_zero]
      rcases hgnS v hvS with h | h
      · exact Or.inl h
      · by_cases h0 : g = 0
        · exact Or.inl h0
        · refine Or.inr ⟨h0, ?_⟩
          rw [hwι v, Units.val_mk0]
          exact h

  let M : {x : X // x ≠ genericPoint X} → ℕ := fun i =>
    if hg : g = 0 then 0 else if i ∈ Set.range ι then 0 else
      (δ i - w i (Additive.ofMul (Units.mk0 g hg))).toNat
  have hMι : ∀ v, M (ι v) = 0 := by
    intro v
    by_cases hg : g = 0 <;> simp [M, hg]
  have hgM : ∀ i, i ∉ Set.range ι → wcValGe _ (w i) (δ i - M i) g := by
    intro i hi
    by_cases hg : g = 0
    · exact Or.inl hg
    refine Or.inr ⟨hg, ?_⟩
    simp only [M, dif_neg hg, if_neg hi]
    have := Int.self_le_toNat (δ i - w i (Additive.ofMul (Units.mk0 g hg)))
    omega
  let V : Submodule Ω (FractionRing Γ(X, U)) :=
    { carrier := {h | ∀ i, wcValGe _ (w i) (δ i - M i) h}
      add_mem' := fun {a b} ha hb => by
        intro i
        exact vge_add i _ a b (ha i) (hb i)
      zero_mem' := by
        intro i
        exact Or.inl rfl
      smul_mem' := fun c {h} hh => by
        intro i
        rw [Algebra.smul_def]
        exact vge_const i _ c h (hh i) }
  have hmemV : ∀ h, h ∈ V ↔ ∀ i, wcValGe _ (w i) (δ i - M i) h := fun h => Iff.rfl
  have hCV : ∀ h, h ∈ V → C h ∈ V := fun h hh => (hmemV _).mpr fun i =>
    (hl i).2.1 (M i) h ((hmemV h).mp hh i)
  have hEfin : (Function.support (fun i : {x : X // x ≠ genericPoint X} =>
      (((M i : ℤ) - δ i).toNat : ℤ))).Finite := by
    refine (hZ'fin.union hBfin).subset ?_
    intro i hi
    rw [Function.mem_support] at hi
    by_contra hc
    have h1 : i ∉ Z' := fun h => hc (Or.inl h)
    have h2 : i ∈ Set.range ι := by
      by_contra h
      exact hc (Or.inr h)
    obtain ⟨v, rfl⟩ := h2
    apply hi
    rw [hMι v, hδ0 v h1]
    simp
  let E : {x : X // x ≠ genericPoint X} →₀ ℤ := Finsupp.ofSupportFinite _ hEfin
  have hVle : V ≤ wcRRL Ω (FractionRing Γ(X, U)) {x : X // x ≠ genericPoint X} w E := by
    intro h hh
    by_cases h0 : h = 0
    · rw [h0]; exact Submodule.zero_mem _
    refine Submodule.subset_span ?_
    show ∃ hf : h ≠ 0, ∀ i, 0 ≤ w i (Additive.ofMul (Units.mk0 h hf)) + E i
    refine ⟨h0, fun i => ?_⟩
    have h1 := (vge_iff _ _ _ h0).mp ((hmemV h).mp hh i)
    have h2 := Int.self_le_toNat ((M i : ℤ) - δ i)
    simp only [E, Finsupp.ofSupportFinite_coe]
    omega
  haveI := hDim.2.1 E
  haveI : FiniteDimensional Ω V := Submodule.finiteDimensional_of_le hVle
  have hnK : ∀ m : ℤ, (m : FractionRing Γ(X, U)) ^ p = m := fun m => by
    rw [← frobenius_def, map_intCast]
  have hβV : g - C g ∈ V := by
    refine (hmemV _).mpr fun i => ?_
    by_cases hi : i ∈ Set.range ι
    · obtain ⟨v, rfl⟩ := hi
      rw [hMι v, Nat.cast_zero, sub_zero]
      have hC0 := (hl (ι v)).2.1 0
      simp only [Nat.cast_zero, sub_zero] at hC0
      have hρ := hgv v
      have hCnu : C ((n v : FractionRing Γ(X, U)) * u (ι v)) =
          (n v : FractionRing Γ(X, U)) * u (ι v) := by
        rw [hu]
        conv_lhs => rw [← hnK (n v)]
        rw [hCsemi, (hl (ι v)).2.2.1]
      have heq : g - C g = (g - (n v : FractionRing Γ(X, U)) * u (ι v)) -
          C (g - (n v : FractionRing Γ(X, U)) * u (ι v)) := by
        rw [map_sub, hCnu]; ring
      rw [heq]
      exact vge_sub _ _ _ _ hρ (hC0 _ hρ)
    · exact vge_sub _ _ _ _ (hgM i hi) ((hl i).2.1 (M i) g (hgM i hi))

  let CV : V →+ V :=
    { toFun := fun h => ⟨C h, hCV h h.2⟩
      map_zero' := Subtype.ext (map_zero C)
      map_add' := fun a b => Subtype.ext (map_add C (a : FractionRing Γ(X, U))
        (b : FractionRing Γ(X, U))) }
  have hCVsemi : ∀ (c : Ω) (h : V), CV (c ^ p • h) = c • CV h := by
    intro c h
    apply Subtype.ext
    show C ((c ^ p) • (h : FractionRing Γ(X, U))) = c • C h
    rw [Algebra.smul_def, Algebra.smul_def, map_pow, hCsemi]
  obtain ⟨η, hη⟩ := wc_semilinear_lang Ω V p CV hCVsemi ⟨g - C g, hβV⟩
  have hη' : (η : FractionRing Γ(X, U)) - C η = g - C g := congrArg Subtype.val hη

  have hCa : C (g - η) = g - η := by
    rw [map_sub]; linear_combination hη'
  have hJ : (g - η) ^ p + (⇑D)^[p - 1] (g - η) = 0 := by
    have h1 := hCart (g - η)
    rw [hCa] at h1
    rw [h1]; ring
  obtain ⟨f, hf0, hDf⟩ := hJac _ hJ

  refine ⟨Units.mk0 f hf0, fun v => ?_⟩
  have h3 := (hl (ι v)).2.2.2.1 (Units.mk0 f hf0)
  rw [Units.val_mk0] at h3
  have h4 := hgv v
  have h5 : wcValGe _ (w (ι v)) (δ (ι v)) (η : FractionRing Γ(X, U)) := by
    have h1 := (hmemV _).mp η.2 (ι v)
    rw [hMι v, Nat.cast_zero, sub_zero] at h1
    exact h1
  have hlog : D f / f = g - η := by rw [hDf, mul_div_assoc, div_self hf0, mul_one]
  have key : (((w (ι v) (Additive.ofMul (Units.mk0 f hf0)) - n v : ℤ)) : FractionRing Γ(X, U)) *
      u (ι v) = (g - (n v : FractionRing Γ(X, U)) * u (ι v)) -
        (D f / f - (w (ι v) (Additive.ofMul (Units.mk0 f hf0)) : FractionRing Γ(X, U)) * u (ι v))
          - η := by
    rw [hlog]; push_cast; ring
  have h6 : wcValGe _ (w (ι v)) (δ (ι v))
      ((((w (ι v) (Additive.ofMul (Units.mk0 f hf0)) - n v : ℤ)) : FractionRing Γ(X, U)) *
        u (ι v)) := by
    rw [key]
    refine vge_sub _ _ _ _ (vge_sub _ _ _ _ h4 ?_) h5
    rw [hu]
    exact h3
  rw [hu] at h6
  have h7 := (hl (ι v)).2.2.2.2 _ h6
  rw [hwι v] at h7
  rw [dvd_sub_comm]
  exact h7

theorem wc_curve_classGroup_divisible : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)], IsAffineOpen U → ((U : Set X)ᶜ).Finite →
    ∀ n : ℕ, 0 < n → ∀ c : ClassGroup Γ(X, U), ∃ d : ClassGroup Γ(X, U), d ^ n = c :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim U _ hU hfin
  have hprime : ∀ q : ℕ, q.Prime → ∀ c : ClassGroup Γ(X, U),
      ∃ d : ClassGroup Γ(X, U), d ^ q = c := by
    intro q hq c
    by_cases h : (q : Ω) = 0
    · exact wc_curve_classGroup_char_divisible Ω X fX hirr hnorm hdim U hU hfin q hq h c
    · exact wc_curve_classGroup_ell_divisible Ω X fX hirr hnorm hdim U hU hfin q hq h c
  intro n
  induction n using Nat.strong_induction_on with
  | _ n IH =>
    intro hn c
    by_cases h1 : n = 1
    · subst h1
      exact ⟨c, pow_one c⟩
    · obtain ⟨q, hq, hqn⟩ := Nat.exists_prime_and_dvd h1
      obtain ⟨m, rfl⟩ := hqn
      have hm : 0 < m := Nat.pos_of_ne_zero (by rintro rfl; simp at hn)
      have hq2 := hq.two_le
      have hlt : m < q * m := by nlinarith
      obtain ⟨e, he⟩ := hprime q hq c
      obtain ⟨d, hd⟩ := IH m hlt hm e
      exact ⟨d, by rw [mul_comm, pow_mul, hd, he]⟩

theorem wc_zar_pic_curve_ell_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ ℓ : ℕ, ℓ.Prime → (ℓ : Ω) ≠ 0 →
    letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _
    Finite {x : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 // ℓ • x = 0} ∧
    ∃ T : Finset (Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1), ∀ y, ∃ t ∈ T, ∃ z, y = t + ℓ • z :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim ℓ hℓ hℓΩ
  classical
  letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _

  obtain ⟨U, hU, hfin, hDed⟩ := wc_curve_dedekind_affine_open Ω X fX hirr hnorm hdim
  haveI := hDed

  obtain ⟨K, D, i, d, h, hS, hflas, π, hπ, ⟨T, hT0, hTk⟩, hdiv1, hdiv2⟩ :=
    wc_zar_divisor_ses Ω X fX hirr hnorm hdim U hU hfin

  obtain ⟨ψ₀, hψ₀s, hψ₀k⟩ := dedekind_classGroup_divisor_presentation Γ(X, U)

  have hsub : Subsingleton (Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) K 1) :=
    wc_zar_flasque_ext_one_vanish X K hflas

  have s4 : ∀ (P : Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})
      (S : ShortComplex (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u})),
      S.ShortExact → Subsingleton (Abelian.Ext P S.X₂ 1) →
      ∀ (ψ : Abelian.Ext P S.X₃ 0 →+ Additive (ClassGroup Γ(X, U))), Function.Surjective ψ →
      (∀ z : Abelian.Ext P S.X₂ 0, ψ (z.comp (Abelian.Ext.mk₀ S.g) (add_zero 0)) = 0) →
      ∀ T : Finset (Abelian.Ext P S.X₃ 0), (∀ t ∈ T, ψ t = 0) →
      (∀ y, ψ y = 0 → ∃ (z : Abelian.Ext P S.X₂ 0), ∃ n ∈ AddSubgroup.closure (T : Set _),
          y = z.comp (Abelian.Ext.mk₀ S.g) (add_zero 0) + n) →
      ∃ ρ : Abelian.Ext P S.X₁ 1 →+ Additive (ClassGroup Γ(X, U)),
        Function.Surjective ρ ∧ ρ.ker.FG := by
    intro P S hS hsub ψ hψ hg T hT0 hTk
    let δ : Abelian.Ext P S.X₃ 0 →+ Abelian.Ext P S.X₁ 1 := hS.extClass.postcomp P (zero_add 1)
    have hδ : ∀ y, δ y = y.comp hS.extClass (zero_add 1) := fun y => rfl
    have hδs : Function.Surjective δ := by
      intro x
      have h0 : x.comp (Abelian.Ext.mk₀ S.f) (add_zero 1) = 0 := Subsingleton.elim _ _
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x h0 (zero_add 1)
      exact ⟨y, hy⟩
    have hker : δ.ker ≤ ψ.ker := by
      intro y hy
      rw [AddMonoidHom.mem_ker] at hy ⊢
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS y (zero_add 1) hy
      rw [← hz]
      exact hg z
    have hδg : ∀ z : Abelian.Ext P S.X₂ 0,
        δ (z.comp (Abelian.Ext.mk₀ S.g) (add_zero 0)) = 0 := by
      intro z
      rw [hδ, Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
        hS.comp_extClass, Abelian.Ext.comp_zero]
    let ρ : Abelian.Ext P S.X₁ 1 →+ Additive (ClassGroup Γ(X, U)) :=
      δ.liftOfRightInverse (Function.surjInv hδs) (Function.rightInverse_surjInv hδs) ⟨ψ, hker⟩
    have hρ : ∀ y, ρ (δ y) = ψ y := fun y =>
      δ.liftOfRightInverse_comp_apply _ (Function.rightInverse_surjInv hδs) ⟨ψ, hker⟩ y
    refine ⟨ρ, ?_, ?_⟩
    · intro c
      obtain ⟨y, hy⟩ := hψ c
      exact ⟨δ y, by rw [hρ, hy]⟩
    · refine ⟨T.image δ, ?_⟩
      rw [Finset.coe_image, ← AddMonoidHom.map_closure]
      apply le_antisymm
      · rw [AddSubgroup.map_le_iff_le_comap, AddSubgroup.closure_le]
        intro t ht
        change ρ (δ t) = 0
        rw [hρ]
        exact hT0 t ht
      · intro x hx
        obtain ⟨y, rfl⟩ := hδs x
        rw [AddMonoidHom.mem_ker, hρ] at hx
        obtain ⟨z, n, hn, hy⟩ := hTk y hx
        refine ⟨n, hn, ?_⟩
        rw [hy, map_add, hδg, zero_add]

  have s8 : ∀ (G : Type (u+1)) [AddCommGroup G] (ρ : G →+ Additive (ClassGroup Γ(X, U))),
      Function.Surjective ρ → ρ.ker.FG →
      Finite {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} →
      (∀ c : ClassGroup Γ(X, U), ∃ d : ClassGroup Γ(X, U), d ^ ℓ = c) →
      Finite {x : G // ℓ • x = 0} ∧ ∃ T : Finset G, ∀ y, ∃ t ∈ T, ∃ z, y = t + ℓ • z := by
    intro G _ ρ hρ hk hH hD
    have hℓ0 : 0 < ℓ := hℓ.pos
    obtain ⟨S, hS⟩ := hk
    have hNfin : Finite {x : G // x ∈ ρ.ker ∧ ℓ • x = 0} := by
      haveI : AddGroup.FG ρ.ker := (AddGroup.fg_iff_addSubgroup_fg ρ.ker).mpr ⟨S, hS⟩
      haveI : Module.Finite ℤ ρ.ker := Module.Finite.iff_addGroup_fg.mpr inferInstance
      haveI : IsNoetherian ℤ ρ.ker := isNoetherian_of_isNoetherianRing_of_finite ℤ ρ.ker
      haveI : Module.Finite ℤ (Submodule.torsionBy ℤ ρ.ker (ℓ : ℤ)) :=
        Module.Finite.iff_fg.mpr (IsNoetherian.noetherian _)
      haveI : AddGroup.FG (Submodule.torsionBy ℤ ρ.ker (ℓ : ℤ)) :=
        Module.Finite.iff_addGroup_fg.mp inferInstance
      have htor : IsAddTorsion (Submodule.torsionBy ℤ ρ.ker (ℓ : ℤ)) := by
        intro m
        rw [isOfFinAddOrder_iff_nsmul_eq_zero]
        refine ⟨ℓ, hℓ0, ?_⟩
        have h1 := (Submodule.mem_torsionBy_iff (ℓ : ℤ) (m : ρ.ker)).mp m.2
        rw [← natCast_zsmul]
        exact Subtype.ext h1
      haveI : Finite (Submodule.torsionBy ℤ ρ.ker (ℓ : ℤ)) :=
        AddCommGroup.finite_of_fg_isAddTorsion _ htor
      refine Finite.of_injective (fun x : {x : G // x ∈ ρ.ker ∧ ℓ • x = 0} =>
        (⟨⟨x.1, x.2.1⟩, (Submodule.mem_torsionBy_iff _ _).mpr (by
          rw [natCast_zsmul]; exact Subtype.ext x.2.2)⟩ :
          Submodule.torsionBy ℤ ρ.ker (ℓ : ℤ))) ?_
      intro a b hab
      have := congrArg (fun z : Submodule.torsionBy ℤ ρ.ker (ℓ : ℤ) => ((z : ρ.ker) : G)) hab
      exact Subtype.ext this
    have hGfin : Finite {x : G // ℓ • x = 0} := by
      let f : {x : G // ℓ • x = 0} → {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} := fun x =>
        ⟨Additive.toMul (ρ x.1), by rw [← toMul_nsmul, ← map_nsmul, x.2, map_zero, toMul_zero]⟩
      haveI : Nonempty {x : G // ℓ • x = 0} := ⟨⟨0, smul_zero _⟩⟩
      have hσ : ∀ x, f (Function.invFun f (f x)) = f x := fun x => Function.invFun_eq ⟨x, rfl⟩
      have hρσ : ∀ x : {x : G // ℓ • x = 0}, ρ (Function.invFun f (f x)).1 = ρ x.1 := by
        intro x
        have := congrArg Subtype.val (hσ x)
        exact Additive.toMul.injective this
      refine Finite.of_injective (fun x => (f x, (⟨x.1 - (Function.invFun f (f x)).1, by
          rw [AddMonoidHom.mem_ker, map_sub, hρσ x, sub_self], by
          rw [smul_sub, x.2, (Function.invFun f (f x)).2, sub_zero]⟩ :
          {x : G // x ∈ ρ.ker ∧ ℓ • x = 0}))) ?_
      intro x x' hxx
      simp only [Prod.mk.injEq, Subtype.mk.injEq] at hxx
      obtain ⟨h1, h2⟩ := hxx
      rw [h1] at h2
      exact Subtype.ext (sub_left_inj.mp h2)
    refine ⟨hGfin, ?_⟩
    have hℓz : (0 : ℤ) < (ℓ : ℤ) := by exact_mod_cast hℓ0
    have hcomb : ∀ k ∈ AddSubgroup.closure (S : Set G), ∃ c : G → ℤ, k = ∑ s ∈ S, c s • s := by
      intro k hk
      induction hk using AddSubgroup.closure_induction with
      | mem x hx =>
        refine ⟨fun s => if s = x then 1 else 0, ?_⟩
        simp only [ite_smul, one_smul, zero_smul]
        rw [Finset.sum_ite_eq' S x (fun s => s), if_pos (Finset.mem_coe.mp hx)]
      | zero => exact ⟨0, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨c1, rfl⟩ := hx
        obtain ⟨c2, rfl⟩ := hy
        exact ⟨c1 + c2, by simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]⟩
      | neg x _ hx =>
        obtain ⟨c, rfl⟩ := hx
        exact ⟨-c, by simp only [Pi.neg_apply, neg_smul, Finset.sum_neg_distrib]⟩
    refine ⟨(Finset.univ : Finset (S → Fin ℓ)).image (fun r => ∑ s : S, ((r s : ℕ)) • (s : G)),
      fun y => ?_⟩
    obtain ⟨d, hd⟩ := hD (Additive.toMul (ρ y))
    obtain ⟨w, hw⟩ := hρ (Additive.ofMul d)
    have hk : y - ℓ • w ∈ ρ.ker := by
      rw [AddMonoidHom.mem_ker, map_sub, map_nsmul, hw, ← ofMul_pow, hd, ofMul_toMul, sub_self]
    rw [← hS] at hk
    obtain ⟨c, hc⟩ := hcomb _ hk
    let r : S → Fin ℓ := fun s => ⟨(c s % (ℓ : ℤ)).toNat, by
      have h1 := Int.emod_lt_of_pos (c s) hℓz
      have h2 := Int.emod_nonneg (c s) hℓz.ne'
      omega⟩
    refine ⟨∑ s : S, ((r s : ℕ)) • (s : G), Finset.mem_image_of_mem _ (Finset.mem_univ r),
      w + ∑ s ∈ S, (c s / (ℓ : ℤ)) • s, ?_⟩
    have hsplit : ∀ s ∈ S,
        c s • s = (c s % (ℓ : ℤ)).toNat • s + ℓ • ((c s / (ℓ : ℤ)) • s) := by
      intro s _
      rw [← natCast_zsmul, ← natCast_zsmul, smul_smul, ← add_smul]
      congr 1
      rw [Int.toNat_of_nonneg (Int.emod_nonneg _ hℓz.ne'), Int.emod_def]
      ring
    have hsum : ∑ s ∈ S, c s • s =
        ∑ s : S, ((r s : ℕ)) • (s : G) + ℓ • ∑ s ∈ S, (c s / (ℓ : ℤ)) • s := by
      rw [Finset.sum_congr rfl hsplit, Finset.sum_add_distrib, Finset.smul_sum]
      congr 1
      exact (Finset.sum_coe_sort S (fun s => (c s % (ℓ : ℤ)).toNat • s)).symm
    have hy : y = (y - ℓ • w) + ℓ • w := (sub_add_cancel _ _).symm
    rw [hy, hc, hsum, smul_add]
    abel

  let ψ := ψ₀.comp π
  have hψs : Function.Surjective ψ := hψ₀s.comp hπ
  have hg : ∀ z : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) K 0,
      ψ (z.comp (Abelian.Ext.mk₀ d) (add_zero 0)) = 0 := by
    intro z
    obtain ⟨f, hf⟩ := hdiv1 z
    exact (hψ₀k _).mpr ⟨f, hf⟩
  have hTψ : ∀ t ∈ T, ψ t = 0 := by
    intro t ht
    change ψ₀ (π t) = 0
    rw [hT0 t ht, map_zero]
  have hkerψ : ∀ y, ψ y = 0 → ∃ z : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X)
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))) K 0,
      ∃ n ∈ AddSubgroup.closure (T : Set _),
      y = z.comp (Abelian.Ext.mk₀ d) (add_zero 0) + n := by
    intro y hy
    obtain ⟨f, hf⟩ := (hψ₀k (π y)).mp hy
    obtain ⟨z, hz⟩ := hdiv2 f
    refine ⟨z, y - z.comp (Abelian.Ext.mk₀ d) (add_zero 0), hTk _ ?_, by abel⟩
    ext v
    rw [map_sub, Finsupp.sub_apply, hf v, hz v, sub_self, Finsupp.zero_apply]
  obtain ⟨ρ, hρs, hρk⟩ := s4 _ (ShortComplex.mk i d h) hS hsub ψ hψs hg T hTψ hkerψ
  have hH1 := wc_curve_classGroup_ell_torsion_finite Ω X fX hirr hnorm hdim U hU hfin ℓ hℓ hℓΩ
  have hD : ∀ c : ClassGroup Γ(X, U), ∃ e : ClassGroup Γ(X, U), e ^ ℓ = c :=
    wc_curve_classGroup_divisible Ω X fX hirr hnorm hdim U hU hfin ℓ hℓ.pos
  exact s8 _ ρ hρs hρk hH1 hD

theorem wc_et_normal_irreducible_curve_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ ℓ : ℕ, ℓ.Prime → (ℓ : Ω) ≠ 0 → ∀ q : ℕ, Finite (wcEtCoh X ℓ q) :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim ℓ hℓ hℓΩ q
  classical
  haveI := hirr

  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  obtain ⟨x₀⟩ : Nonempty X := IrreducibleSpace.toNonempty
  haveI hdom : IsDomain Γ(X, ⊤) :=
    @IsIntegral.component_integral X _ ⊤ ⟨⟨x₀, trivial⟩⟩
  let φ : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
  have hφint : φ.IsIntegral := by
    refine RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ ?_)
      (isIntegral_appTop_of_universallyClosed fX)
    intro y
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y, ?_⟩
    change ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫ (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom y = y
    rw [Iso.hom_inv_id]
    rfl
  have hsurj : Function.Surjective φ := by
    letI : Algebra Ω Γ(X, ⊤) := φ.toAlgebra
    intro s
    have hs : _root_.IsIntegral Ω s := hφint s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
    exact ⟨c, hc⟩
  have hU1 : Finite {v : (Γ(X, ⊤))ˣ // v ^ ℓ = 1} := by
    refine Finite.of_injective (β := (Polynomial.nthRoots ℓ (1 : Γ(X, ⊤))).toFinset)
      (fun v => ⟨(v.1 : Γ(X, ⊤)), Multiset.mem_toFinset.mpr ((Polynomial.mem_nthRoots hℓ.pos).mpr
        (by rw [← Units.val_pow_eq_pow_val, v.2, Units.val_one]))⟩) ?_
    intro a b hab
    exact Subtype.ext (Units.ext (congrArg Subtype.val hab))
  have hU2 : ∀ v : (Γ(X, ⊤))ˣ, ∃ w : (Γ(X, ⊤))ˣ, w ^ ℓ = v := by
    intro v
    obtain ⟨c, hc⟩ := hsurj v
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [map_zero] at hc
      exact v.ne_zero hc.symm
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq c hℓ.pos
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ.ne_zero] at hz
      exact hc0 hz.symm
    refine ⟨Units.map φ.toMonoidHom (Units.mk0 z hz0), Units.ext ?_⟩
    rw [Units.val_pow_eq_pow_val, Units.coe_map, Units.val_mk0]
    change φ z ^ ℓ = _
    rw [← map_pow, hz, hc]

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}) := HasExt.standard _
  let P := (constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let G := wcEtGm X

  have hA : ∀ (n k : ℕ) (x : Abelian.Ext P G n),
      x.comp (Abelian.Ext.mk₀ (k • 𝟙 G)) (add_zero n) = k • x := by
    intro n k x
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]

  obtain ⟨ι, h, hS⟩ := wc_et_kummer_ses Ω X fX ℓ hℓ hℓΩ
  obtain ⟨e⟩ := wc_et_gm_h0_units X
  obtain ⟨e1⟩ := wc_et_gm_h1_zariski X
  obtain ⟨hZ1, T1, hT1⟩ := wc_zar_pic_curve_ell_finite Ω X fX hirr hnorm hdim ℓ hℓ hℓΩ
  have hV := wc_et_gm_tsen_vanishing Ω X fX hirr hnorm hdim

  have hK : ∀ n, Finite {x : Abelian.Ext P G n // ℓ • x = 0} := by
    intro n
    match n with
    | 0 =>
      refine Finite.of_injective (β := {v : (Γ(X, ⊤))ˣ // v ^ ℓ = 1})
        (fun x => ⟨Additive.toMul (e x.1), by
          rw [← toMul_nsmul, ← map_nsmul, x.2, map_zero, toMul_zero]⟩) ?_
      intro a b hab
      exact Subtype.ext (e.injective (Additive.toMul.injective (congrArg Subtype.val hab)))
    | 1 =>
      refine Finite.of_injective (fun x => (⟨e1 x.1, by rw [← map_nsmul, x.2, map_zero]⟩ :
        {y : Abelian.Ext ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))) (wcZarGm X) 1 // ℓ • y = 0})) ?_
      intro a b hab
      exact Subtype.ext (e1.injective (congrArg Subtype.val hab))
    | m + 2 =>
      haveI := hV m
      haveI : Finite (Abelian.Ext P G (m + 2)) := Finite.of_subsingleton
      exact Finite.of_injective (fun x => x.1) Subtype.val_injective

  have hC : ∀ p, ∃ T : Finset (Abelian.Ext P G p), ∀ y, ∃ t ∈ T, ∃ z, y = t + ℓ • z := by
    intro p
    match p with
    | 0 =>
      refine ⟨{0}, fun y => ?_⟩
      obtain ⟨w, hw⟩ := hU2 (Additive.toMul (e y))
      refine ⟨0, Finset.mem_singleton_self _, e.symm (Additive.ofMul w), ?_⟩
      rw [zero_add, ← map_nsmul, ← ofMul_pow, hw, ofMul_toMul, AddEquiv.symm_apply_apply]
    | 1 =>
      letI : DecidableEq (Abelian.Ext P G 1) := Classical.decEq _
      refine ⟨T1.image e1.symm, fun y => ?_⟩
      obtain ⟨t, ht, z, hz⟩ := hT1 (e1 y)
      refine ⟨e1.symm t, Finset.mem_image_of_mem _ ht, e1.symm z, ?_⟩
      apply e1.injective
      rw [map_add, map_nsmul, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
      exact hz
    | m + 2 =>
      haveI := hV m
      exact ⟨{0}, fun y => ⟨0, Finset.mem_singleton_self _, 0, Subsingleton.elim _ _⟩⟩

  let S := ShortComplex.mk ι (ℓ • 𝟙 (wcEtGm X)) h
  change Finite (Abelian.Ext P S.X₁ q)
  let φf : ∀ n, Abelian.Ext P S.X₁ n →+ Abelian.Ext P S.X₂ n :=
    fun n => (Abelian.Ext.mk₀ S.f).postcomp P (add_zero n)
  have hφK : ∀ n (x : Abelian.Ext P S.X₁ n), ℓ • φf n x = 0 := by
    intro n x
    rw [← hA n ℓ (φf n x)]
    change ((x.comp (Abelian.Ext.mk₀ S.f) (add_zero n)).comp (Abelian.Ext.mk₀ S.g)
      (add_zero n)) = 0
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, S.zero, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  cases q with
  | zero =>
    haveI := hK 0
    have hinj : Function.Injective (φf 0) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = x := ⟨_, Abelian.Ext.mk₀_homEquiv₀_apply x⟩
      have hx' : Abelian.Ext.mk₀ (g ≫ S.f) = Abelian.Ext.mk₀ 0 := by
        rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_zero]
        exact hx
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx'
      have hg : g ≫ S.f = 0 := Abelian.Ext.homEquiv₀.symm.injective hx'
      haveI := hS.mono_f
      rw [Limits.zero_of_comp_mono S.f hg, Abelian.Ext.mk₀_zero]
    refine Finite.of_injective
      (fun x => (⟨φf 0 x, hφK 0 x⟩ : {y : Abelian.Ext P G 0 // ℓ • y = 0})) ?_
    intro x x' hxx
    exact hinj (congrArg Subtype.val hxx)
  | succ p =>
    haveI := hK (p + 1)
    obtain ⟨T, hT⟩ := hC p
    let δ : Abelian.Ext P S.X₃ p →+ Abelian.Ext P S.X₁ (p + 1) :=
      hS.extClass.postcomp P rfl
    have hδg : ∀ z : Abelian.Ext P G p,
        δ (z.comp (Abelian.Ext.mk₀ (ℓ • 𝟙 (wcEtGm X))) (add_zero p)) = 0 := by
      intro z
      change (z.comp (Abelian.Ext.mk₀ S.g) (add_zero p)).comp hS.extClass rfl = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (zero_add 1) (by omega),
        hS.comp_extClass, Abelian.Ext.comp_zero]
    have hker : ∀ x, φf (p + 1) x = 0 → ∃ t ∈ T, δ t = x := by
      intro x hx
      obtain ⟨y, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x hx rfl
      obtain ⟨t, ht, z, hz⟩ := hT y
      refine ⟨t, ht, ?_⟩
      change δ t = δ y
      rw [hz, map_add, ← hA p ℓ z, hδg z, add_zero]
    haveI : Nonempty (Abelian.Ext P S.X₁ (p + 1)) := ⟨0⟩
    let σ : Abelian.Ext P S.X₂ (p + 1) → Abelian.Ext P S.X₁ (p + 1) :=
      Function.invFun (φf (p + 1))
    have hσ : ∀ x, φf (p + 1) (σ (φf (p + 1) x)) = φf (p + 1) x := fun x =>
      Function.invFun_eq ⟨x, rfl⟩
    have hpre : ∀ x, ∃ t ∈ T, δ t = x - σ (φf (p + 1) x) := fun x =>
      hker _ (by rw [map_sub, hσ, sub_self])
    choose τ hτT hτ using hpre
    refine Finite.of_injective (fun x =>
      ((⟨φf (p + 1) x, hφK (p + 1) x⟩ : {y : Abelian.Ext P G (p + 1) // ℓ • y = 0}),
        (⟨τ x, hτT x⟩ : {t // t ∈ T}))) ?_
    intro x x' hxx
    simp only [Prod.mk.injEq, Subtype.mk.injEq] at hxx
    obtain ⟨e1', e2'⟩ := hxx
    have := hτ x
    rw [e2', hτ x', e1'] at this
    exact (sub_left_inj.mp this).symm

theorem wc_ext_adjoint_transfer : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] {D : Type*} [Category D] [Abelian D] [HasExt D] [EnoughInjectives D] (L : C ⥤ D) (R : D ⥤ C) (adj : L ⊣ R) [R.Additive] [Limits.PreservesFiniteLimits R] [Limits.PreservesFiniteColimits R] [L.PreservesMonomorphisms] (X : C) (Y : D) (n : ℕ), Function.Bijective (fun e : Abelian.Ext (L.obj X) Y n => (Abelian.Ext.mk₀ (adj.unit.app X)).comp (Abelian.Ext.mapExactFunctor R e) (zero_add n)) :=
by
  intro C _ _ _ D _ _ _ _ L R adj _ _ _ _ X Y₀ n₀
  let Φ : ∀ (Y : D) (n : ℕ), Abelian.Ext (L.obj X) Y n → Abelian.Ext X (R.obj Y) n :=
    fun Y n e => (Abelian.Ext.mk₀ (adj.unit.app X)).comp (Abelian.Ext.mapExactFunctor R e)
      (zero_add n)
  have hadd : ∀ (Y : D) (n : ℕ) (a b : Abelian.Ext (L.obj X) Y n),
      Φ Y n (a + b) = Φ Y n a + Φ Y n b := by
    intro Y n a b
    simp only [Φ]
    rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]
  have hcomp : ∀ {Q Y : D} {a b c : ℕ} (w : Abelian.Ext (L.obj X) Q a)
      (β : Abelian.Ext Q Y b) (h : a + b = c),
      Φ Y c (w.comp β h) = (Φ Q a w).comp (Abelian.Ext.mapExactFunctor R β) h := by
    intro Q Y a b c w β h
    simp only [Φ]
    rw [Abelian.Ext.mapExactFunctor_comp]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add a) h (by omega)).symm
  have key : ∀ (n : ℕ) (Y : D), Function.Bijective (Φ Y n) := by
    intro n
    induction n with
    | zero =>
      intro Y
      have hmk : ∀ f : L.obj X ⟶ Y,
          Φ Y 0 (Abelian.Ext.mk₀ f) = Abelian.Ext.mk₀ (adj.homEquiv X Y f) := by
        intro f
        simp only [Φ]
        rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Adjunction.homEquiv_unit]
      constructor
      · intro x₁ x₂ h
        have e1 := Abelian.Ext.mk₀_homEquiv₀_apply x₁
        have e2 := Abelian.Ext.mk₀_homEquiv₀_apply x₂
        rw [← e1, ← e2, hmk, hmk] at h
        have h1 := (Abelian.Ext.mk₀_bijective _ _).1 h
        have h2 := (adj.homEquiv X Y).injective h1
        rw [← e1, ← e2, h2]
      · intro z'
        refine ⟨Abelian.Ext.mk₀ ((adj.homEquiv X Y).symm (Abelian.Ext.homEquiv₀ z')), ?_⟩
        rw [hmk, Equiv.apply_symm_apply, Abelian.Ext.mk₀_homEquiv₀_apply]
    | succ n ih =>
      intro Y
      let ι := Injective.ι Y
      let S : ShortComplex D :=
        ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hRS : (S.map R).ShortExact := hS.map_of_exact R
      haveI : Injective S.X₂ := (inferInstance : Injective (Injective.under Y))
      haveI hRI : Injective (R.obj S.X₂) := Injective.injective_of_adjoint adj S.X₂
      haveI : Injective (S.map R).X₂ := hRI
      have bridge : ∀ w : Abelian.Ext (L.obj X) S.X₃ n,
          Φ Y (n + 1) (w.comp hS.extClass rfl) = (Φ S.X₃ n w).comp hRS.extClass rfl := by
        intro w
        rw [hcomp, Abelian.Ext.mapExactFunctor_extClass]
      constructor
      · have hker : ∀ z : Abelian.Ext (L.obj X) Y (n + 1), Φ Y (n + 1) z = 0 → z = 0 := by
          intro z hz
          have h0 : z.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
            Abelian.Ext.eq_zero_of_injective _
          obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₁ (L.obj X) hS z h0 (n₀ := n) rfl
          have h1 : (Φ S.X₃ n w).comp hRS.extClass rfl = 0 := by
            rw [← bridge, hw]; exact hz
          obtain ⟨v', hv'⟩ := Abelian.Ext.covariant_sequence_exact₃ X hRS (Φ S.X₃ n w) rfl h1
          obtain ⟨v, hv⟩ := (ih S.X₂).2 v'
          have hw2 : w = v.comp (Abelian.Ext.mk₀ S.g) (add_zero n) := by
            apply (ih S.X₃).1
            rw [hcomp, Abelian.Ext.mapExactFunctor_mk₀, hv]
            exact hv'.symm
          rw [← hw, hw2, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega),
            hS.comp_extClass, Abelian.Ext.comp_zero]
        intro z₁ z₂ h
        rw [← sub_eq_zero]
        apply hker
        have hsub := map_sub (AddMonoidHom.mk' (Φ Y (n + 1)) (hadd Y (n + 1))) z₁ z₂
        change Φ Y (n + 1) (z₁ - z₂) = Φ Y (n + 1) z₁ - Φ Y (n + 1) z₂ at hsub
        rw [hsub, h, sub_self]
      · intro z'
        have h0 : z'.comp (Abelian.Ext.mk₀ (S.map R).f) (add_zero _) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨w', hw'⟩ := Abelian.Ext.covariant_sequence_exact₁ X hRS z' h0 (n₀ := n) rfl
        obtain ⟨w, hw⟩ := (ih S.X₃).2 w'
        refine ⟨w.comp hS.extClass rfl, ?_⟩
        rw [bridge, hw, hw']
  exact key n₀ Y₀

theorem wc_etale_lift_quotient_alg : ∀ (R : Type u) [CommRing R] (I : Ideal R) (B : Type u) [CommRing B] [Algebra R B] [Algebra (R ⧸ I) B] [IsScalarTower R (R ⧸ I) B] [Algebra.Etale (R ⧸ I) B] (q : Ideal B) [q.IsPrime], ∃ g : B, g ∉ q ∧ ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R'), Algebra.Etale R R' ∧ Nonempty ((R' ⧸ I.map (algebraMap R R')) ≃ₐ[R] Localization.Away g) :=
by
  intro R _ I B _ _ _ _ _ q hq
  classical

  obtain ⟨g, hgq, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R ⧸ I) q
  have := hstd
  obtain ⟨P⟩ := Algebra.IsStandardEtale.nonempty_standardEtalePresentation
    (R := R ⧸ I) (S := Localization.Away g)

  have : Nontrivial B := by
    by_contra hB
    rw [not_nontrivial_iff_subsingleton] at hB
    exact hq.ne_top ((Ideal.eq_top_iff_one q).2
      (by rw [Subsingleton.elim (1 : B) 0]; exact q.zero_mem))
  have : Nontrivial (R ⧸ I) := RingHom.domain_nontrivial (algebraMap (R ⧸ I) B)

  have hsurj : Function.Surjective (Polynomial.map (algebraMap R (R ⧸ I))) :=
    Polynomial.map_surjective _ Ideal.Quotient.mk_surjective
  obtain ⟨F, hFmap, -, hFmonic⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
    (f := algebraMap R (R ⧸ I)) (p := P.f) ((Polynomial.mem_lifts _).2 (hsurj P.f)) P.monic_f
  obtain ⟨G0, hG0⟩ := hsurj P.g
  obtain ⟨E, hEf, hEg⟩ : ∃ E : StandardEtalePair R, E.f = F ∧ E.g = G0 * Polynomial.derivative F :=
    ⟨⟨F, hFmonic, G0 * Polynomial.derivative F, ⟨G0, 0, 1, by ring⟩⟩, rfl, rfl⟩
  have hE : ∀ (T : Type u) [CommRing T] [Algebra R T] [Algebra (R ⧸ I) T]
      [IsScalarTower R (R ⧸ I) T] (t : T), E.HasMap t ↔ P.P.HasMap t := by
    intro T _ _ _ _ t
    have h1 : Polynomial.aeval t E.f = Polynomial.aeval t P.f := by
      rw [hEf, ← hFmap, Polynomial.aeval_map_algebraMap]
    have h2 : Polynomial.aeval t E.g =
        Polynomial.aeval t P.g * Polynomial.aeval t (Polynomial.derivative P.f) := by
      rw [hEg, ← hG0, ← hFmap, Polynomial.derivative_map, Polynomial.aeval_map_algebraMap,
        Polynomial.aeval_map_algebraMap, map_mul]
    simp only [StandardEtalePair.HasMap, h1, h2]
    constructor
    · rintro ⟨hf, hu⟩
      exact ⟨hf, isUnit_of_mul_isUnit_left hu⟩
    · rintro ⟨hf, hu⟩
      refine ⟨hf, hu.mul ?_⟩
      obtain ⟨p1, p2, n, hc⟩ := P.cond
      have hc' := congrArg (Polynomial.aeval t) hc
      rw [map_add, map_mul, map_mul, hf, zero_mul, add_zero, map_pow] at hc'
      exact isUnit_of_mul_isUnit_left (by rw [hc']; exact hu.pow n)

  refine ⟨g, hgq, E.Ring, inferInstance, inferInstance, inferInstance, ?_⟩
  have hφ : E.HasMap P.x := (hE _ P.x).2 P.hasMap
  obtain ⟨φ, hφX⟩ : ∃ φ : E.Ring →ₐ[R] Localization.Away g, φ E.X = P.x :=
    ⟨E.lift P.x hφ, StandardEtalePair.lift_X _ _ _⟩
  have hφI : ∀ a ∈ I.map (algebraMap R E.Ring), φ a = 0 := by
    intro a ha
    have hle : I.map (algebraMap R E.Ring) ≤ RingHom.ker φ := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.commutes,
        IsScalarTower.algebraMap_apply R (R ⧸ I) (Localization.Away g),
        Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem.2 hr, map_zero]
    exact hle ha
  obtain ⟨φb, hφb⟩ : ∃ φb : (E.Ring ⧸ I.map (algebraMap R E.Ring)) →ₐ[R] Localization.Away g,
      ∀ a, φb (Ideal.Quotient.mkₐ R (I.map (algebraMap R E.Ring)) a) = φ a :=
    ⟨Ideal.Quotient.liftₐ _ φ hφI, fun a => rfl⟩
  have hx : E.HasMap (Ideal.Quotient.mkₐ R (I.map (algebraMap R E.Ring)) E.X) := by
    obtain ⟨h1, h2⟩ := StandardEtalePair.hasMap_X (P := E)
    refine And.intro ?_ ?_
    · rw [Polynomial.aeval_algHom_apply, h1, map_zero]
    · rw [Polynomial.aeval_algHom_apply]; exact h2.map _
  have hxP := (hE _ _).1 hx
  obtain ⟨lam, hlam⟩ : ∃ lam : P.Ring →ₐ[R ⧸ I] (E.Ring ⧸ I.map (algebraMap R E.Ring)),
      lam P.X = Ideal.Quotient.mkₐ R (I.map (algebraMap R E.Ring)) E.X :=
    ⟨P.P.lift _ hxP, StandardEtalePair.lift_X _ _ _⟩
  have hkey : P.equivRing P.x = P.X := by
    apply P.equivRing.symm.injective
    rw [AlgEquiv.symm_apply_apply]
    show P.x = (AlgEquiv.ofBijective (P.lift P.x P.hasMap) P.lift_bijective) P.X
    rw [AlgEquiv.ofBijective_apply, StandardEtalePair.lift_X]
  let ψ : Localization.Away g →ₐ[R] (E.Ring ⧸ I.map (algebraMap R E.Ring)) :=
    (lam.comp (P.equivRing : Localization.Away g →ₐ[R ⧸ I] P.Ring)).restrictScalars R
  have h1 : ψ.comp φb = AlgHom.id R _ := by
    apply Ideal.Quotient.algHom_ext R
    apply StandardEtalePair.hom_ext
    show lam (P.equivRing (φb (Ideal.Quotient.mkₐ R (I.map (algebraMap R E.Ring)) E.X))) =
      Ideal.Quotient.mkₐ R (I.map (algebraMap R E.Ring)) E.X
    rw [hφb, hφX, hkey, hlam]
  have h2 : φb.comp ψ = AlgHom.id R _ := by
    let φA : (E.Ring ⧸ I.map (algebraMap R E.Ring)) →ₐ[R ⧸ I] Localization.Away g :=
      { φb.toRingHom with
        commutes' := by
          intro a
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
          have e1 : algebraMap (R ⧸ I) (E.Ring ⧸ I.map (algebraMap R E.Ring))
              (Ideal.Quotient.mk I r) = algebraMap R (E.Ring ⧸ I.map (algebraMap R E.Ring)) r :=
            (IsScalarTower.algebraMap_apply R (R ⧸ I) _ r).symm
          have e2 : algebraMap (R ⧸ I) (Localization.Away g) (Ideal.Quotient.mk I r) =
              algebraMap R (Localization.Away g) r :=
            (IsScalarTower.algebraMap_apply R (R ⧸ I) _ r).symm
          show φb (algebraMap (R ⧸ I) (E.Ring ⧸ I.map (algebraMap R E.Ring))
            (Ideal.Quotient.mk I r)) = _
          rw [e1, e2, φb.commutes] }
    have h3 : φA.comp lam = (P.equivRing.symm : P.Ring →ₐ[R ⧸ I] Localization.Away g) := by
      apply StandardEtalePair.hom_ext
      show φb (lam P.X) = P.equivRing.symm P.X
      rw [hlam, hφb, hφX, ← hkey, AlgEquiv.symm_apply_apply]
    apply AlgHom.ext
    intro s
    have h4 := AlgHom.congr_fun h3 (P.equivRing s)
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgEquiv.symm_apply_apply] at h4
    exact h4
  exact ⟨AlgEquiv.ofAlgHom φb ψ h2 h1⟩

theorem wc_etale_lift_closed_immersion : (∀ (R : Type u) [CommRing R] (I : Ideal R) (B : Type u) [CommRing B] [Algebra R B] [Algebra (R ⧸ I) B] [IsScalarTower R (R ⧸ I) B] [Algebra.Etale (R ⧸ I) B] (q : Ideal B) [q.IsPrime], ∃ g : B, g ∉ q ∧ ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R'), Algebra.Etale R R' ∧ Nonempty ((R' ⧸ I.map (algebraMap R R')) ≃ₐ[R] Localization.Away g)) → ∀ {T V : Scheme.{u}} (j : T ⟶ V) [IsClosedImmersion j] {W : Scheme.{u}} (w : W ⟶ T) [Etale w] (x : W), ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ W) (x' : ↥(Limits.pullback e j)), h ≫ w = Limits.pullback.snd e j ∧ h x' = x :=
by
  intro H T V j _ W w _ x

  have H' : ∀ (A : Type u) [CommRing A] (I : Ideal A) (B : Type u) [CommRing B] [Algebra A B] [Algebra (A ⧸ I) B] [IsScalarTower A (A ⧸ I) B] [Algebra.Etale (A ⧸ I) B] (q : Ideal B) [q.IsPrime], ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra A R'), Algebra.Etale A R' ∧ ∃ (ψ : B →ₐ[A] TensorProduct A R' (A ⧸ I)) (P : Ideal (TensorProduct A R' (A ⧸ I))), P.IsPrime ∧ P.comap ψ = q := by
    intro A _ I B _ _ _ _ _ q _
    obtain ⟨g, hg, R', _, _, hR', ⟨θ⟩⟩ := H A I B q
    let κ := (Algebra.TensorProduct.quotIdealMapEquivTensorQuot R' I).restrictScalars A
    let μ : Localization.Away g ≃ₐ[A] TensorProduct A R' (A ⧸ I) := θ.symm.trans κ
    let lam : B →ₐ[A] Localization.Away g := IsScalarTower.toAlgHom A B (Localization.Away g)
    have hdisj : Disjoint (↑(Submonoid.powers g) : Set B) ↑q :=
      (Ideal.disjoint_powers_iff_notMem g (Ideal.IsPrime.isRadical ‹_›)).mpr hg
    haveI hQ := IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers g)
      (Localization.Away g) q ‹_› hdisj
    have hu := IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers g)
      (Localization.Away g) ‹q.IsPrime› hdisj
    refine ⟨R', inferInstance, inferInstance, hR', (μ : _ →ₐ[A] _).comp lam,
      (q.map (algebraMap B (Localization.Away g))).comap
        (μ.symm : TensorProduct A R' (A ⧸ I) →ₐ[A] Localization.Away g), Ideal.IsPrime.comap _, ?_⟩
    conv_rhs => rw [← hu]
    ext b
    simp only [Ideal.mem_comap, Ideal.under]
    show μ.symm (μ (lam b)) ∈ _ ↔ _
    rw [AlgEquiv.symm_apply_apply]
    rfl

  have hAff : ∀ (A : CommRingCat.{u}) (I : Ideal A) (B : CommRingCat.{u}) (φ : CommRingCat.of (A ⧸ I) ⟶ B), φ.hom.Etale → ∀ y : ↥(Spec B), ∃ (V' : Scheme.{u}) (e : V' ⟶ Spec A) (_ : Etale e) (h : Limits.pullback e (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ⟶ Spec B) (x' : ↥(Limits.pullback e (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))), h ≫ Spec.map φ = Limits.pullback.snd e (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ∧ h x' = y := by
    intro A I B φ hφ y
    letI : Algebra (A ⧸ I) B := φ.hom.toAlgebra
    letI : Algebra A B := (φ.hom.comp (Ideal.Quotient.mk I)).toAlgebra
    haveI : IsScalarTower A (A ⧸ I) B := IsScalarTower.of_algebraMap_eq (fun a => rfl)
    haveI : Algebra.Etale (A ⧸ I) B := RingHom.etale_algebraMap.mp hφ
    haveI := y.isPrime
    obtain ⟨R', _, _, hR', ψ, P, hP, hPq⟩ := H' A I B y.asIdeal
    let e : Spec (CommRingCat.of R') ⟶ Spec A := Spec.map (CommRingCat.ofHom (algebraMap A R'))
    have he : Etale e := HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr hR')
    let τ : Limits.pullback e (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ≅
        Spec (CommRingCat.of (TensorProduct A R' (A ⧸ I))) := pullbackSpecIso A R' (A ⧸ I)
    let pt : ↥(Spec (CommRingCat.of (TensorProduct A R' (A ⧸ I)))) := ⟨P, hP⟩
    refine ⟨_, e, he, τ.hom ≫ Spec.map (CommRingCat.ofHom (ψ : B →+* TensorProduct A R' (A ⧸ I))),
      τ.inv pt, ?_, ?_⟩
    · have h1 : φ ≫ CommRingCat.ofHom (ψ : B →+* TensorProduct A R' (A ⧸ I)) =
          CommRingCat.ofHom ((Algebra.TensorProduct.includeRight :
            A ⧸ I →ₐ[A] TensorProduct A R' (A ⧸ I)) : A ⧸ I →+* TensorProduct A R' (A ⧸ I)) := by
        ext1
        apply Ideal.Quotient.ringHom_ext
        ext a
        exact (ψ.commutes a).trans (Algebra.TensorProduct.includeRight.commutes a).symm
      rw [Category.assoc, ← Spec.map_comp, h1]
      exact pullbackSpecIso_hom_snd A R' (A ⧸ I)
    · rw [Scheme.Hom.comp_apply, Scheme.inv_hom_apply τ pt]
      apply PrimeSpectrum.ext
      exact hPq

  have c3 : ∀ {V : Scheme.{u}} (R : CommRingCat.{u}) (j : Spec R ⟶ V), (∀ (B : CommRingCat.{u}) (φ : R ⟶ B), φ.hom.Etale → ∀ y : ↥(Spec B), ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ Spec B) (x' : ↥(Limits.pullback e j)), h ≫ Spec.map φ = Limits.pullback.snd e j ∧ h x' = y) → ∀ {W : Scheme.{u}} (w : W ⟶ Spec R) [Etale w] (x : W), ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ W) (x' : ↥(Limits.pullback e j)), h ≫ w = Limits.pullback.snd e j ∧ h x' = x := by
    intro V R j hB W w _ x
    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤)
      (TopologicalSpace.Opens.mem_top x)
    haveI := hU.isOpenImmersion_fromSpec
    obtain ⟨y, hy⟩ : x ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hxU
    have hφ : (Spec.preimage (hU.fromSpec ≫ w)).hom.Etale :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mp (by rw [Spec.map_preimage]; infer_instance)
    obtain ⟨V', e, he, h₀, x', hc, hp⟩ := hB _ _ hφ y
    refine ⟨V', e, he, h₀ ≫ hU.fromSpec, x', ?_, ?_⟩
    · rw [Category.assoc, ← hc, Spec.map_preimage]
    · rw [Scheme.Hom.comp_apply, hp, hy]

  have c4 : ∀ {T V V₀ W : Scheme.{u}} (j : T ⟶ V) (a : V₀ ⟶ V) [Etale a] (w : W ⟶ T) (x₀ : ↥(Limits.pullback (Limits.pullback.snd a j) w)), (∃ (V' : Scheme.{u}) (e : V' ⟶ V₀) (_ : Etale e) (h : Limits.pullback e (Limits.pullback.fst a j) ⟶ Limits.pullback (Limits.pullback.snd a j) w) (x' : ↥(Limits.pullback e (Limits.pullback.fst a j))), h ≫ Limits.pullback.fst (Limits.pullback.snd a j) w = Limits.pullback.snd e (Limits.pullback.fst a j) ∧ h x' = x₀) → ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ W) (x' : ↥(Limits.pullback e j)), h ≫ w = Limits.pullback.snd e j ∧ h x' = Limits.pullback.snd (Limits.pullback.snd a j) w x₀ := by
    rintro T V V₀ W j a _ w x₀ ⟨V', e₀, he₀, h₀, x'₀, hcomm, hpt⟩
    haveI := he₀
    let ι := Limits.pullbackRightPullbackFstIso a j e₀
    refine ⟨V', e₀ ≫ a, inferInstance, ι.inv ≫ h₀ ≫ Limits.pullback.snd _ _, ι.hom x'₀, ?_, ?_⟩
    · rw [Category.assoc, Category.assoc, ← Limits.pullback.condition, reassoc_of% hcomm,
        Limits.pullbackRightPullbackFstIso_inv_snd_snd]
    · rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, Scheme.hom_inv_apply, hpt]

  have c5 : ∀ {T T' V W : Scheme.{u}} (j : T ⟶ V) (j' : T' ⟶ V) (ε : T ≅ T'), j = ε.hom ≫ j' → ∀ (w : W ⟶ T) (x : W), (∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j' ⟶ W) (x' : ↥(Limits.pullback e j')), h ≫ w ≫ ε.hom = Limits.pullback.snd e j' ∧ h x' = x) → ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ W) (x' : ↥(Limits.pullback e j)), h ≫ w = Limits.pullback.snd e j ∧ h x' = x := by
    rintro T T' V W j j' ε rfl w x ⟨V', e, he, h₁, x'₁, hcomm, hpt⟩
    let κ : Limits.pullback e (ε.hom ≫ j') ⟶ Limits.pullback e j' :=
      Limits.pullback.lift (Limits.pullback.fst _ _) (Limits.pullback.snd _ _ ≫ ε.hom)
        (by rw [Limits.pullback.condition, Category.assoc])
    let κ' : Limits.pullback e j' ⟶ Limits.pullback e (ε.hom ≫ j') :=
      Limits.pullback.lift (Limits.pullback.fst _ _) (Limits.pullback.snd _ _ ≫ ε.inv)
        (by rw [Limits.pullback.condition]; simp)
    have k1 : κ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ :=
      Limits.pullback.lift_fst _ _ _
    have k2 : κ ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ ε.hom :=
      Limits.pullback.lift_snd _ _ _
    have k1' : κ' ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ :=
      Limits.pullback.lift_fst _ _ _
    have k2' : κ' ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ≫ ε.inv :=
      Limits.pullback.lift_snd _ _ _
    have hκ : κ' ≫ κ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, k1, k1', Category.id_comp]
      · rw [Category.assoc, k2, reassoc_of% k2', Iso.inv_hom_id, Category.comp_id,
          Category.id_comp]
    refine ⟨V', e, he, κ ≫ h₁, κ' x'₁, ?_, ?_⟩
    · rw [← cancel_mono ε.hom]
      simp only [Category.assoc, hcomm, κ, Limits.pullback.lift_snd]
    · rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply κ' κ, hκ]
      simpa using hpt

  obtain ⟨U, hU, hvU, -⟩ := exists_isAffineOpen_mem_and_subset (x := j (w x)) (U := ⊤)
    (TopologicalSpace.Opens.mem_top _)
  haveI := hU.isOpenImmersion_fromSpec
  obtain ⟨u, hu⟩ : j (w x) ∈ Set.range hU.fromSpec := by rw [hU.range_fromSpec]; exact hvU
  obtain ⟨t₀, -, ht₀⟩ := Scheme.Pullback.exists_preimage_pullback (f := hU.fromSpec) (g := j)
    u (w x) hu
  obtain ⟨x₀, -, hx₀⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := Limits.pullback.snd hU.fromSpec j) (g := w) t₀ x ht₀
  obtain ⟨I, ε, hε⟩ := IsClosedImmersion.Spec_iff.mp
    (inferInstance : IsClosedImmersion (Limits.pullback.fst hU.fromSpec j))
  have hW := c3 (CommRingCat.of (Γ(V, U) ⧸ I)) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
    (hAff Γ(V, U) I) (Limits.pullback.fst (Limits.pullback.snd hU.fromSpec j) w ≫ ε.hom) x₀
  have hT := c5 (Limits.pullback.fst hU.fromSpec j) _ ε hε
    (Limits.pullback.fst (Limits.pullback.snd hU.fromSpec j) w) x₀ hW
  have hV := c4 j hU.fromSpec w x₀ hT
  rw [hx₀] at hV
  exact hV

theorem wc_etBaseChange_locSurj : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i], (∀ {T V : Scheme.{u}} (j : T ⟶ V) [IsClosedImmersion j] {W : Scheme.{u}} (w : W ⟶ T) [Etale w] (x : W), ∃ (V' : Scheme.{u}) (e : V' ⟶ V) (_ : Etale e) (h : Limits.pullback e j ⟶ W) (x' : ↥(Limits.pullback e j)), h ≫ w = Limits.pullback.snd e j ∧ h x' = x) → ∀ (P : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (α : P ⟶ G.obj), Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Z) α → Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) (Functor.whiskerLeft (wcEtBaseChange i).op α) :=
by
  intro Y Z i _ LH P G α hα

  have s1 : ∀ (U : Z.Etale), IsEmpty U.left → Subsingleton (G.obj.obj (Opposite.op U)) := by
    intro U hU
    have hbot : (⊥ : Sieve U) ∈ Scheme.smallEtaleTopology Z U := by
      have h0 : Sieve.ofArrows (fun _ : U.left => U) (fun _ => 𝟙 U) ∈
          Scheme.smallEtaleTopology Z U := by
        rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
        apply Set.eq_univ_of_forall
        intro x
        exact isEmptyElim x
      refine GrothendieckTopology.superset_covering _ ?_ h0
      rw [Sieve.ofArrows, Sieve.generate_le_iff]
      intro W f hf
      cases hf with
      | mk x => exact isEmptyElim x
    exact AddCommGrpCat.isZero_iff_subsingleton.mp (Sheaf.isTerminalOfBotCover G U hbot).isZero

  have s2 : ∀ (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V' : Y.Etale) (e : V' ⟶ V),
      S.arrows e ∧ v ∈ Set.range e.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro V S H
    choose V' e he hv using H
    have hT : Sieve.ofArrows V' e ∈ Scheme.smallEtaleTopology Y V := by
      rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
      exact Set.eq_univ_of_forall fun v => Set.mem_iUnion.mpr ⟨v, hv v⟩
    refine GrothendieckTopology.superset_covering _ ?_ hT
    rw [Sieve.ofArrows, Sieve.generate_le_iff]
    intro W f hf
    cases hf with
    | mk v => exact he v

  have s3 : ∀ (V : Y.Etale) (v : V.left), v ∉ Set.range (Limits.pullback.fst V.hom i) →
      ∃ (V' : Y.Etale) (e : V' ⟶ V), v ∈ Set.range e.left ∧
        IsEmpty ((wcEtBaseChange i).obj V').left := by
    intro V v hv
    have hc : IsClosed (Set.range (Limits.pullback.fst V.hom i)) :=
      (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst V.hom i)).isClosed_range
    let O : V.left.Opens := ⟨(Set.range (Limits.pullback.fst V.hom i))ᶜ, hc.isOpen_compl⟩
    have : Etale V.hom := V.prop
    refine ⟨Scheme.Etale.mk (O.ι ≫ V.hom), MorphismProperty.Over.homMk O.ι, ?_, ?_⟩
    · change v ∈ Set.range O.ι
      rw [Scheme.Opens.range_ι]
      exact hv
    · refine ⟨fun z => ?_⟩
      change ↥(Limits.pullback (O.ι ≫ V.hom) i) at z
      have h1 : V.hom (O.ι (Limits.pullback.fst (O.ι ≫ V.hom) i z)) =
          i (Limits.pullback.snd (O.ι ≫ V.hom) i z) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition,
          Scheme.Hom.comp_apply]
      obtain ⟨w, hw, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ h1
      have h2 : O.ι (Limits.pullback.fst (O.ι ≫ V.hom) i z) ∈ (O : Set V.left) := by
        rw [← Scheme.Opens.range_ι O]
        exact ⟨_, rfl⟩
      exact h2 ⟨w, hw⟩

  constructor
  intro V s
  apply s2 V
  intro v
  by_cases hv : v ∈ Set.range (Limits.pullback.fst V.hom i)
  ·
    obtain ⟨y, hy⟩ := hv
    have hR := hα.imageSieve_mem (U := (wcEtBaseChange i).obj V) s
    obtain ⟨𝒰, h𝒰o, h𝒰, hle⟩ := (Scheme.mem_smallGrothendieckTopology _ _).1 hR
    have := h𝒰o
    have : Scheme.JointlySurjective.{u}
        (Scheme.precoverage (@Etale : MorphismProperty Scheme.{u})) :=
      Scheme.instJointlySurjectivePrecoverage
    unfold Scheme.Cover.toPresieveOverProp at hle
    have crux : ∀ {ι : Type u} (X' : ι → Z.Etale)
        (f' : ∀ j, X' j ⟶ (wcEtBaseChange i).obj V),
        Presieve.ofArrows X' f' ≤ (Presheaf.imageSieve α s).arrows →
        ∀ (k : ι), Etale (f' k).left → ∀ z : (X' k).left, (f' k).left z = y →
        ∃ (V' : Y.Etale) (e : V' ⟶ V),
          (Presheaf.imageSieve (Functor.whiskerLeft (wcEtBaseChange i).op α) s).arrows e ∧
          v ∈ Set.range e.left := by
      intro ι X' f' hle k hfk z hz
      obtain ⟨V'', e, he, h, x', hh, hx⟩ :=
        @LH (Limits.pullback V.hom i) V.left (Limits.pullback.fst V.hom i) inferInstance
          (X' k).left (f' k).left hfk z
      have := he
      have : Etale V.hom := V.prop
      let ι := Limits.pullbackRightPullbackFstIso V.hom i e
      have key : ((wcEtBaseChange i).map
          (MorphismProperty.Over.homMk e : Scheme.Etale.mk (e ≫ V.hom) ⟶ V)).left =
          ι.inv ≫ Limits.pullback.snd e (Limits.pullback.fst V.hom i) := by
        apply Limits.pullback.hom_ext
        · exact (Limits.pullback.lift_fst _ _ _).trans ((Category.assoc _ _ _).trans
            (Limits.pullbackRightPullbackFstIso_inv_snd_fst V.hom i e)).symm
        · exact (Limits.pullback.lift_snd _ _ _).trans ((Category.assoc _ _ _).trans
            (Limits.pullbackRightPullbackFstIso_inv_snd_snd V.hom i e)).symm
      have hover : (ι.inv ≫ h) ≫ (X' k).hom = Limits.pullback.snd (e ≫ V.hom) i := by
        calc (ι.inv ≫ h) ≫ (X' k).hom
            = ι.inv ≫ ((h ≫ (f' k).left) ≫ Limits.pullback.snd V.hom i) :=
              (Category.assoc _ _ _).trans (congrArg (ι.inv ≫ ·)
                ((congrArg (h ≫ ·) (MorphismProperty.Over.w (f' k)).symm).trans
                  (Category.assoc _ _ _).symm))
          _ = ι.inv ≫ (Limits.pullback.snd e (Limits.pullback.fst V.hom i) ≫
                Limits.pullback.snd V.hom i) :=
              congrArg (fun m => ι.inv ≫ m ≫ Limits.pullback.snd V.hom i) hh
          _ = Limits.pullback.snd (e ≫ V.hom) i :=
              Limits.pullbackRightPullbackFstIso_inv_snd_snd V.hom i e
      let g : (wcEtBaseChange i).obj (Scheme.Etale.mk (e ≫ V.hom)) ⟶ X' k :=
        MorphismProperty.Over.homMk (ι.inv ≫ h) hover trivial
      have hc : (Presheaf.imageSieve α s).arrows (f' k) := hle _ _ (Presieve.ofArrows.mk k)
      have hRm := (Presheaf.imageSieve α s).downward_closed hc g
      have hcomp : g ≫ f' k = (wcEtBaseChange i).map
          (MorphismProperty.Over.homMk e : Scheme.Etale.mk (e ≫ V.hom) ⟶ V) := by
        apply MorphismProperty.Over.Hom.ext
        refine Eq.trans ?_ key.symm
        show (ι.inv ≫ h) ≫ (f' k).left = _
        exact (Category.assoc _ _ _).trans (congrArg (ι.inv ≫ ·) hh)
      rw [hcomp] at hRm
      refine ⟨Scheme.Etale.mk (e ≫ V.hom), MorphismProperty.Over.homMk e, hRm, ?_⟩
      change v ∈ Set.range e
