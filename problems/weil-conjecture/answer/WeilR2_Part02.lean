    have e : (Limits.Cofan.mk (P V) τ).inj j ≫ Limits.Cofan.IsColimit.desc d G ≫ f = G j ≫ f := by
      rw [← Category.assoc, hfac]
    rw [e, Limits.comp_zero]
    rcases j with ρ | k
    · exact hR ρ
    · exact hA k
  choose V g hgR hgA hgU using hpres
  refine ⟨Λ, inst, ⟨⟨(∅, ∅), fun ρ hρ => by simp at hρ⟩⟩, fun i => S i.1.1, V, g,
    fun i j hij => q i.1.1 j.1.1 (hle hij).1, fun i => ε i.1.1, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i hii
    exact hq1 _ _
  · intro i j k hij hjk hik
    exact hq2 _ _ _ _ _ _
  · intro i j hij
    exact hqε _ _ _
  ·
    intro i
    apply hgU i K (ε i.1.1)
    · intro ρ
      rw [Category.assoc, hqε]
      exact ρ.1.2.2.2
    · intro k
      rw [Preadditive.nsmul_comp, hσε, ← Category.comp_id k.1.2, ← Preadditive.comp_nsmul, hK,
