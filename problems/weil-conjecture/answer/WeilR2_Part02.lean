theorem wc_closed_coker_pushforward : ∀ {Y Z : Scheme.{u}} (i : Z ⟶ Y) [(wcEtBaseChange i).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)] (m : ℕ), (∀ (P : (Z.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (α : P ⟶ G.obj), Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Z) α → Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) (Functor.whiskerLeft (wcEtBaseChange i).op α)) → Nonempty (Limits.cokernel (wcEtExtZeroι Y (Set.range i)ᶜ m) ≅ ((wcEtBaseChange i).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) :=
