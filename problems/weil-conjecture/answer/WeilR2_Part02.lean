  intro C _ _ 𝒯 P K m hK hcop
  classical

  let Gen : Type (u+1) := Σ T : 𝒯, (P T ⟶ K)
  choose S σ hcol using fun A : Finset Gen => hcop (↥A) (fun k => (k.1).1)
  have hext : ∀ (A : Finset Gen) {W : C} (f f' : P (S A) ⟶ W),
      (∀ k : ↥A, σ A k ≫ f = σ A k ≫ f') → f = f' :=
    fun A W f f' hff => Limits.Cofan.IsColimit.hom_ext (hcol A).some f f' hff
  obtain ⟨ε, hσε⟩ : ∃ ε : ∀ A : Finset Gen, P (S A) ⟶ K, ∀ (A : Finset Gen) (k : ↥A), σ A k ≫ ε A = k.1.2 :=
    ⟨fun A => Limits.Cofan.IsColimit.desc (hcol A).some (fun k => k.1.2),
      fun A k => Limits.Cofan.IsColimit.fac (hcol A).some _ k⟩
  obtain ⟨q, hσq⟩ : ∃ q : ∀ A A' : Finset Gen, A ⊆ A' → (P (S A) ⟶ P (S A')),
      ∀ (A A' : Finset Gen) (hA : A ⊆ A') (k : ↥A), σ A k ≫ q A A' hA = σ A' ⟨k.1, hA k.2⟩ :=
    ⟨fun A A' hA => Limits.Cofan.IsColimit.desc (hcol A).some (fun k => σ A' ⟨k.1, hA k.2⟩),
      fun A A' hA k => Limits.Cofan.IsColimit.fac (hcol A).some _ k⟩
  have hq1 : ∀ A (hA : A ⊆ A), q A A hA = 𝟙 _ := fun A hA =>
    hext A _ _ (fun k => (hσq A A hA k).trans (Category.comp_id _).symm)
  have hq2 : ∀ A A' A'' (h1 : A ⊆ A') (h2 : A' ⊆ A'') (h3 : A ⊆ A''),
      q A A' h1 ≫ q A' A'' h2 = q A A'' h3 := fun A A' A'' h1 h2 h3 =>
    hext A _ _ (fun k => by rw [← Category.assoc, hσq, hσq, hσq])
  have hqε : ∀ A A' (hA : A ⊆ A'), q A A' hA ≫ ε A' = ε A := fun A A' hA =>
    hext A _ _ (fun k => by rw [← Category.assoc, hσq, hσε, hσε])

  let Rel : Type (u+1) := Σ T : 𝒯, Σ A : Finset Gen, {r : P T ⟶ P (S A) // r ≫ ε A = 0}

