    intro V' φ O o h hh hv
    rw [← hh, ← Category.assoc, ← hv, Category.assoc, MorphismProperty.Over.w φ]
  haveI : Etale V₁.hom := V₁.prop
  haveI : Etale V₂.hom := V₂.prop

