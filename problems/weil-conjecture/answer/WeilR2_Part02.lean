    simp only [Category.assoc]
    rw [Limits.pullback.condition (f := p) (g := p)]
  have eqp2 : pp ≫ f₀ ≫ φ₂.left = pp ≫ g₀ ≫ b₁ ≫ h₂ := by
    rw [← Category.assoc pp f₀, hpf, hv₂, ← Category.assoc pp g₀, hpg, ← Category.assoc q b₁, hq₂]
  obtain ⟨U₂, hU₂, hU₂e⟩ := hS5 V₂.hom (f₀ ≫ φ₂.left) (g₀ ≫ b₁ ≫ h₂) eq2 Ω pp eqp2
  have hψ' : ((U₁ ⊓ U₂).ι ≫ f₀) ≫ W.hom =
