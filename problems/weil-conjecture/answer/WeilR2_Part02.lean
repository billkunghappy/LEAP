left = o₂ ≫ h₂ → ∃ (W' : X.Etale) (c : W' ⟶ W) (w' : W'.left), c.left w' = v (IsLocalRing.closedPoint Ω) ∧ J.obj.map c.op (J.obj.map φ₁.op η₁) = J.obj.map c.op (J.obj.map φ₂.op η₂) :=
by
  intro hS5 X Y p J G ρ H τ₁ τ₂ σ F1 F2 LI b E Ω _ O₁ O₂ V₁ V₂ h₁ hh₁ h₂ hh₂ η₁ η₂ d₁ d₂ hη₁ hη₂
    o₁ o₂ W φ₁ φ₂ v hv₁ hv₂
  classical
  have hleft : ∀ {S : Scheme.{u}} {Z : S.Etale} (a : Z ⟶ Scheme.Etale.mk (𝟙 S)), a.left = Z.hom :=
    fun a => (Category.comp_id a.left).symm.trans (MorphismProperty.Over.w a)
  have hid : ∀ {S : Scheme.{u}} (F : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
      (A : S.Etale) (x : F.obj.obj (Opposite.op A)), F.obj.map (𝟙 A).op x = x := by
