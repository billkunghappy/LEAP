    rw [map_sub, hσ1, hσ2, E, sub_self]
  obtain ⟨W', c, w', hc, hz⟩ := LI W (Scheme.Etale.mk ((U₁ ⊓ U₂).ι ≫ g₀ ≫ b₂ ≫ a₂))
