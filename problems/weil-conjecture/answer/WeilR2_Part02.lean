  ·
    intro i j hij
    apply hgU i _ (q i.1.1 j.1.1 (hle hij).1 ≫ Limits.cokernel.π (g j))
    · intro ρ
      obtain ⟨t, ht⟩ := hgR j ⟨ρ.1, (hle hij).2 ρ.2⟩
      have e : (ρ.1.2.2.1 ≫ q ρ.1.2.1 i.1.1 (i.2 ρ.1 ρ.2)) ≫ q i.1.1 j.1.1 (hle hij).1
          = t ≫ g j := by
        rw [Category.assoc, hq2 _ _ _ _ _ (j.2 ρ.1 ((hle hij).2 ρ.2))]
