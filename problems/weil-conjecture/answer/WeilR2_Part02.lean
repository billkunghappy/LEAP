    refine Eq.mpr (Presheaf.imageSieve_apply _ _ _ _) ⟨ConcreteCategory.hom
      ((toSheafify (Scheme.smallEtaleTopology Y) (wcEtExtZeroPre Y (Set.range i)ᶜ m)).app
        (Opposite.op V')) (⟨a, ha'⟩ : wcSuppSub.{u} m (∀ x, V'.hom x ∈ (Set.range i)ᶜ)),
