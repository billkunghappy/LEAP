      have h2 : ∃ r : R, algebraMap R K r = ((h * f⁻¹ : Kˣ) : K) := by
        refine ⟨1 + r, ?_⟩
        rw [map_add, map_one, hr]
        simp only [Units.val_mul, hh, add_mul, Units.mul_inv]
      have h3 := (hint _).mpr h2
      rw [hmul, hinv] at h3
      omega
    refine ⟨o, ho, ?_, hint, ?_⟩
    · obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
      have h0 : algebraMap R K ϖ ≠ 0 := by
        intro h
        apply hϖ.ne_zero
        apply IsFractionRing.injective R K
        rw [h, map_zero]
      exact ⟨Units.mk0 _ h0, (dvr_count_spanSingleton R K w _ h0).2 ϖ hϖ⟩
    · intro f g h hh
      rcases le_total (o (Additive.ofMul f)) (o (Additive.ofMul g)) with hle | hle
      · exact (min_le_left _ _).trans (key f g h hh hle)
      · exact (min_le_right _ _).trans (key g f h (by rw [hh, add_comm]) hle)
  haveI hdom : IsDomain Γ(X, ⊤) :=
    @IsIntegral.component_integral X _ ⊤ ⟨⟨x₀, trivial⟩⟩
  let φ : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
  have hφint : φ.IsIntegral := by
    refine RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ ?_)
      (isIntegral_appTop_of_universallyClosed fX)
    intro y
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y, ?_⟩
    change ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom y = y
    rw [Iso.hom_inv_id]
    rfl
  have hsurj : Function.Surjective φ := by
    letI : Algebra Ω Γ(X, ⊤) := φ.toAlgebra
    intro s
    have hs : _root_.IsIntegral Ω s := hφint s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
    exact ⟨c, hc⟩
  have s3loc : ∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U))
      [IsDedekindDomain (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩))]
      (w : IsDedekindDomain.HeightOneSpectrum
        (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)))
      (f : FractionRing Γ(X, U)), f ≠ 0 →
      FractionalIdeal.count X.functionField w
          (FractionalIdeal.spanSingleton
            (nonZeroDivisors (X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)))
            (FractionRing.algEquiv Γ(X, U) X.functionField f)) =
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) f) := by
    intro v _ w f hf
    have hxU : (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) ∈ U := (hP5.2.2.1 v).1
    let xU : U := ⟨_, hxU⟩
    have hp : hU.primeIdealOf xU = ⟨v.asIdeal, v.isPrime⟩ := by
      apply hU.fromSpec.injective
      rw [hU.fromSpec_primeIdealOf xU]
    letI : Algebra Γ(X, U) (X.presheaf.stalk (xU : X)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf xU
    haveI : IsLocalization.AtPrime (X.presheaf.stalk (xU : X)) v.asIdeal := by
      have := hU.isLocalization_stalk xU
      rw [hp] at this
      exact this
    haveI : IsScalarTower Γ(X, U) (X.presheaf.stalk (xU : X)) X.functionField :=
      functionField_isScalarTower X U xU
    exact dedekind_count_localization Γ(X, U) v (X.presheaf.stalk (xU : X)) X.functionField w f hf
  have hloc : ∀ x : X, (hx : x ≠ genericPoint X) → ∃ o : Additive (X.functionField)ˣ →+ ℤ,
      (∃ f : (X.functionField)ˣ, o (Additive.ofMul f) = 1) ∧
      (∀ f : (X.functionField)ˣ, 0 ≤ o (Additive.ofMul f) ↔
        ∃ r : X.presheaf.stalk x, algebraMap _ X.functionField r = (f : X.functionField)) ∧
      (∀ f g h : (X.functionField)ˣ,
        (h : X.functionField) = (f : X.functionField) + (g : X.functionField) →
        min (o (Additive.ofMul f)) (o (Additive.ofMul g)) ≤ o (Additive.ofMul h)) ∧
      (haveI := hDVR x hx
       ∃ w : IsDedekindDomain.HeightOneSpectrum (X.presheaf.stalk x),
        ∀ f : (X.functionField)ˣ, o (Additive.ofMul f) =
          FractionalIdeal.count X.functionField w
            (FractionalIdeal.spanSingleton (nonZeroDivisors (X.presheaf.stalk x))
              (f : X.functionField))) := by
    intro x hx
    haveI := hDVR x hx
    let w : IsDedekindDomain.HeightOneSpectrum (X.presheaf.stalk x) :=
      ⟨IsLocalRing.maximalIdeal _, (IsLocalRing.maximalIdeal.isMaximal _).isPrime,
        IsDiscreteValuationRing.not_a_field _⟩
    obtain ⟨o, h1, h2, h3, h4⟩ := pkg (X.presheaf.stalk x) X.functionField w
    exact ⟨o, h2, h3, h4, w, h1⟩
  choose o ho using hloc
  let ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ := fun x =>
    if hx : x = genericPoint X then 0 else (o x hx).comp E.toAddMonoidHom
  have hord : ∀ x (hx : x ≠ genericPoint X) m, ord x m = o x hx (E m) := by
    intro x hx m
    show (if h : x = genericPoint X then 0 else (o x h).comp E.toAddMonoidHom) m = _
    rw [dif_neg hx]
    rfl
  have P1 : ∀ m, ord (genericPoint X) m = 0 := by
    intro m
    show (if h : genericPoint X = genericPoint X then 0
      else (o (genericPoint X) h).comp E.toAddMonoidHom) m = 0
    rw [dif_pos rfl]
    rfl
  have P7 : ∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U)) (f : (FractionRing Γ(X, U))ˣ),
      ord (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩) (Additive.ofMul f) =
        FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U))) := by
    intro v f
    have hx := (hP5.2.2.1 v).2
    rw [hord _ hx]
    haveI := hDVR _ hx
    obtain ⟨w, hw⟩ := (ho _ hx).2.2.2
    rw [show E (Additive.ofMul f) = Additive.ofMul (Additive.toMul (E (Additive.ofMul f))) from rfl,
      hw]
    exact s3loc v w (f : FractionRing Γ(X, U)) f.ne_zero
  have P2 : ∀ m, {x | ord x m ≠ 0}.Finite := by
    intro m
    have hfin2 : {v : IsDedekindDomain.HeightOneSpectrum Γ(X, U) |
        ¬ FractionalIdeal.count (FractionRing Γ(X, U)) v
          (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U))
            ((Additive.toMul m : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U))) = 0}.Finite :=
      Filter.eventually_cofinite.mp (FractionalIdeal.finite_factors _)
    refine (hfin.union (hfin2.image (fun v => (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X)))).subset ?_
    intro x hx
    simp only [Set.mem_setOf_eq] at hx
    by_cases hxU : x ∈ U
    · right
      have hxη : x ≠ genericPoint X := by
        rintro rfl
        exact hx (P1 m)
      obtain ⟨v, rfl⟩ := hP5.2.2.2 x hxU hxη
      refine ⟨v, ?_, rfl⟩
      simp only [Set.mem_setOf_eq]
      rw [← P7 v (Additive.toMul m)]
      exact hx
    · left
      exact hxU
  have P3 : ∀ x, x ≠ genericPoint X → ∃ m, ord x m = 1 := by
    intro x hx
    obtain ⟨f, hf⟩ := (ho x hx).1
    refine ⟨E.symm (Additive.ofMul f), ?_⟩
    rw [hord x hx, AddEquiv.apply_symm_apply]
    exact hf
  have P5 : ∀ (x : X) (f g h : (FractionRing Γ(X, U))ˣ),
      (h : FractionRing Γ(X, U)) = (f : FractionRing Γ(X, U)) + (g : FractionRing Γ(X, U)) →
      min (ord x (Additive.ofMul f)) (ord x (Additive.ofMul g)) ≤ ord x (Additive.ofMul h) := by
    intro x f g h hh
    by_cases hx : x = genericPoint X
    · subst hx
      rw [P1, P1, P1]
      exact min_le_left 0 0
    · rw [hord x hx, hord x hx, hord x hx]
      have := (ho x hx).2.2.1 (Additive.toMul (E (Additive.ofMul f)))
        (Additive.toMul (E (Additive.ofMul g))) (Additive.toMul (E (Additive.ofMul h))) (by
          show α (h : FractionRing Γ(X, U)) = α (f : FractionRing Γ(X, U)) + α (g : FractionRing Γ(X, U))
          rw [hh, map_add])
      simpa only [ofMul_toMul] using this
  have T1 : ∀ s : Γ(X, ⊤), α (algebraMap Γ(X, U) (FractionRing Γ(X, U))
      ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom s)) = (X.germToFunctionField ⊤).hom s := by
    intro s
    rw [AlgEquiv.commutes]
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE le_top) (genericPoint X) _ s
  have T2 : ∀ (x : X) (s : Γ(X, ⊤)), algebraMap (X.presheaf.stalk x) X.functionField
      ((X.presheaf.germ ⊤ x trivial).hom s) = (X.germToFunctionField ⊤).hom s :=
    fun x s => TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf
      (show x ∈ (⊤ : X.Opens) from trivial) _ s
  have hloc6 : ∀ (f : (FractionRing Γ(X, U))ˣ) x (hx : x ≠ genericPoint X),
      0 ≤ ord x (Additive.ofMul f) ↔
        ∃ t : X.presheaf.stalk x, algebraMap _ X.functionField t = α (f : FractionRing Γ(X, U)) := by
    intro f x hx
    rw [hord x hx]
    exact (ho x hx).2.1 (Additive.toMul (E (Additive.ofMul f)))
  have P6 : ∀ f : (FractionRing Γ(X, U))ˣ, (∀ x, 0 ≤ ord x (Additive.ofMul f)) ↔
      ∃ c : Ω, algebraMap Γ(X, U) (FractionRing Γ(X, U))
        ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (φ c)) =
        (f : FractionRing Γ(X, U)) := by
    intro f
    constructor
    · intro H
      obtain ⟨s, hs⟩ := wc_integral_hartogs_sections X ⊤ (α (f : FractionRing Γ(X, U))) (by
        intro x
        by_cases hx : (x : X) = genericPoint X
        · obtain ⟨x, hxV⟩ := x
          simp only at hx
          subst hx
          refine ⟨α (f : FractionRing Γ(X, U)), ?_⟩
          show (X.presheaf.stalkSpecializes _).hom _ = _
          rw [TopCat.Presheaf.stalkSpecializes_refl]
          rfl
        · exact (hloc6 f (x : X) hx).mp (H x))
      obtain ⟨c, rfl⟩ := hsurj s
      refine ⟨c, α.injective ?_⟩
      rw [T1]
      exact hs
    · rintro ⟨c, hc⟩ x
      by_cases hx : x = genericPoint X
      · subst hx
        exact (P1 _).ge
      · rw [hloc6 f x hx]
        refine ⟨(X.presheaf.germ ⊤ x trivial).hom (φ c), ?_⟩
        rw [T2, ← hc, T1]

  let w : {x : X // x ≠ genericPoint X} → Additive (FractionRing Γ(X, U))ˣ →+ ℤ :=
    fun s => ord s.1
  have hEsymm : ∀ (u : (FractionRing Γ(X, U))ˣ) (g : X.functionField) (hg : g ≠ 0),
      α (u : FractionRing Γ(X, U)) = g → E.symm (Additive.ofMul (Units.mk0 g hg)) =
        Additive.ofMul u := by
    intro u g hg hu
    apply E.injective
    rw [AddEquiv.apply_symm_apply]
    show Additive.ofMul (Units.mk0 g hg) = Additive.ofMul (Units.mapEquiv α.toMulEquiv u)
    congr 1
    ext
    exact hu.symm
  have hαne : ∀ f : (FractionRing Γ(X, U))ˣ, α (f : FractionRing Γ(X, U)) ≠ 0 := fun f h =>
    f.ne_zero (α.injective (h.trans (map_zero α).symm))
  refine ⟨w, ⟨fun s a b h hh => P5 s.1 a b h hh, fun f => ?_, fun s => ?_, fun f => ?_⟩,
    ?_, ?_, ?_⟩
  ·
    exact Set.Finite.preimage (fun a _ b _ h => Subtype.val_injective h) (P2 (Additive.ofMul f))
  ·
    obtain ⟨m, hm⟩ := P3 s.1 s.2
    exact ⟨Additive.toMul m, hm⟩
  ·
    refine Iff.trans ?_ (P6 f)
    constructor
    · intro h x
      by_cases hx : x = genericPoint X
      · rw [hx, P1]
      · exact h ⟨x, hx⟩
    · intro h s
      exact h s.1
  ·
    intro s s' hss
    apply Subtype.ext
    haveI := (hnorm s.1).1
    haveI := hDVR s.1 s.2
    refine s3 s.1 s'.1 (hnorm s.1).1 inferInstance (fun g => ?_)
    by_cases hg : g = 0
    · subst hg
      exact ⟨fun _ => ⟨0, map_zero _⟩, fun _ => ⟨0, map_zero _⟩⟩
    · let f : (FractionRing Γ(X, U))ˣ := Units.mk0 (α.symm g) (fun h => hg (by
        rw [← α.apply_symm_apply g, h, map_zero]))
      have hfg : α (f : FractionRing Γ(X, U)) = g := α.apply_symm_apply g
      rw [← hfg, ← hloc6 f s.1 s.2, ← hloc6 f s'.1 s'.2]
      show 0 ≤ w s (Additive.ofMul f) ↔ 0 ≤ w s' (Additive.ofMul f)
      rw [hss]
  ·
    intro s hs
    obtain ⟨v, hv⟩ := hP5.2.2.2 s.1 hs s.2
    refine ⟨v, hv, fun f => ?_⟩
    show ord s.1 (Additive.ofMul f) = _
    rw [← hv]
    exact P7 v f
  ·
    intro μ h1 h2 h3
    let μ' : Additive (X.functionField)ˣ →+ ℤ := μ.comp E.symm.toAddMonoidHom
    have hμ' : ∀ m, μ' m = μ (E.symm m) := fun m => rfl
    have hult : ∀ a b h : (X.functionField)ˣ, (h : X.functionField) = a + b →
        min (μ' (Additive.ofMul a)) (μ' (Additive.ofMul b)) ≤ μ' (Additive.ofMul h) := by
      intro a b h hh
      have := h1 (Additive.toMul (E.symm (Additive.ofMul a)))
        (Additive.toMul (E.symm (Additive.ofMul b))) (Additive.toMul (E.symm (Additive.ofMul h)))
        (by
          show α.symm (h : X.functionField) = α.symm (a : X.functionField) +
            α.symm (b : X.functionField)
          rw [hh, map_add])
      change min (μ (E.symm (Additive.ofMul a))) (μ (E.symm (Additive.ofMul b))) ≤
        μ (E.symm (Additive.ofMul h))
      simpa only [ofMul_toMul] using this
    obtain ⟨R, hR⟩ := s5 X.functionField μ' hult
    have hconst : ∀ c : Ω, (X.presheaf.germ ⊤ (genericPoint X) trivial).hom
        (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c)) ∈ R := by
      intro c
      have hk : α (algebraMap Ω (FractionRing Γ(X, U)) c) =
          (X.presheaf.germ ⊤ (genericPoint X) trivial).hom
            (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c)) := T1 (φ c)
      by_cases hk0 : (X.presheaf.germ ⊤ (genericPoint X) trivial).hom
          (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c)) = 0
      · rw [hk0]; exact R.zero_mem
      · have hc0 : algebraMap Ω (FractionRing Γ(X, U)) c ≠ 0 := fun h => hk0 (by
          rw [← hk, h, map_zero])
        rw [hR _ hk0, hμ', hEsymm (Units.mk0 _ hc0) _ hk0 hk, h3 c hc0]
    obtain ⟨t, ht⟩ := h2
    have hnot : ∃ g : X.functionField, g ∉ R := by
      refine ⟨α (((Additive.toMul t)⁻¹ : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U)), ?_⟩
      intro hmem
      have hne := hαne (Additive.toMul t)⁻¹
      rw [hR _ hne, hμ', hEsymm _ _ hne rfl, ofMul_inv, ofMul_toMul, map_neg, ht] at hmem
      omega
    obtain ⟨z, hzη, hzR⟩ := s4 R hconst hnot
    refine ⟨⟨z, hzη⟩, ?_⟩
    apply s6 (Additive (FractionRing Γ(X, U))ˣ) (w ⟨z, hzη⟩) μ
    · obtain ⟨m, hm⟩ := P3 z hzη
      exact ⟨m, hm⟩
    · exact ⟨t, ht⟩
    · intro m hm
      obtain ⟨f, rfl⟩ : ∃ f : (FractionRing Γ(X, U))ˣ, Additive.ofMul f = m :=
        ⟨Additive.toMul m, rfl⟩
      obtain ⟨r, hr⟩ := (hloc6 f z hzη).mp hm
      have hmem : α (f : FractionRing Γ(X, U)) ∈ R := by
        rw [← hr]; exact hzR r
      rw [hR _ (hαne f), hμ', hEsymm f _ (hαne f) rfl] at hmem
      exact hmem

theorem wc_curve_function_field_finite_rank : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
    wcRRFinRank Ω (FractionRing Γ(X, U)) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin
  classical

  have key : ∀ (K : Type u) [Field K] [Algebra Ω K] (t : K),
      Algebra.IsAlgebraic (IntermediateField.adjoin Ω ({t} : Set K)) K →
      Algebra.EssFiniteType Ω K → wcRRFinRank Ω K := by
    intro K _ _ t halg hess f hf

    have htr : Transcendental Ω f := by
      intro hal
      apply hf
      have hi : IsIntegral Ω f := hal.isIntegral
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hi)
      exact minpoly.mem_range_of_degree_eq_one Ω f hdeg

    haveI : Algebra.IsAlgebraic (Algebra.adjoin Ω ({t} : Set K)) K :=
      ⟨fun x => IntermediateField.isAlgebraic_adjoin_iff.mp (halg.isAlgebraic x)⟩
    obtain ⟨T, hTt, hT⟩ := exists_isTranscendenceBasis_subset (R := Ω) ({t} : Set K)
    have hTcard := hT.lift_cardinalMk_eq_trdeg
    rw [Cardinal.lift_id, Cardinal.lift_id] at hTcard
    have hT1 : Cardinal.mk T ≤ 1 := by
      have := Cardinal.mk_le_mk_of_subset hTt
      rwa [Cardinal.mk_singleton] at this

    haveI halgF : Algebra.IsAlgebraic (IntermediateField.adjoin Ω ({f} : Set K)) K := by
      refine ⟨fun x => ?_⟩
      by_contra hx
      have hx' : Transcendental (Algebra.adjoin Ω (Set.range (fun _ : PUnit.{u+1} => f))) x := by
        rw [Set.range_const]
        exact fun h => hx (IntermediateField.isAlgebraic_adjoin_iff.mpr h)
      have hind1 : AlgebraicIndependent Ω (fun _ : PUnit.{u+1} => f) :=
        algebraicIndependent_unique_type_iff.mpr htr
      have hind2 := (hind1.option_iff_transcendental x).mpr hx'
      have hle := hind2.lift_cardinalMk_le_trdeg
      rw [Cardinal.lift_id, Cardinal.lift_id, ← hTcard, Cardinal.mk_fintype] at hle
      have h2 : ((2 : ℕ) : Cardinal.{u}) ≤ ((1 : ℕ) : Cardinal.{u}) := by
        have e : Fintype.card (Option PUnit.{u+1}) = 2 := by simp
        rw [e] at hle
        exact_mod_cast hle.trans hT1
      have := Nat.cast_le.mp h2
      omega
    haveI : Algebra.EssFiniteType (IntermediateField.adjoin Ω ({f} : Set K)) K :=
      Algebra.EssFiniteType.of_comp Ω _ K
    haveI : Module.Finite (IntermediateField.adjoin Ω ({f} : Set K)) K :=
      Algebra.finite_of_essFiniteType_of_isAlgebraic
    set F := IntermediateField.adjoin Ω ({f} : Set K) with hF
    let τ : F := ⟨f, IntermediateField.mem_adjoin_simple_self Ω f⟩
    have hτ : ∀ p : Polynomial Ω, ((Polynomial.aeval τ p : F) : K) = Polynomial.aeval f p :=
      fun p => (IntermediateField.aeval_coe F τ p).symm
    refine ⟨Module.finrank F K, ⟨Module.finBasis F K, fun p hp => ?_⟩, fun v => ?_⟩
    · have hli := (Module.finBasis F K).linearIndependent
      have h0 := Fintype.linearIndependent_iff.mp hli (fun j => Polynomial.aeval τ (p j)) (by
        rw [← hp]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Algebra.smul_def, IntermediateField.algebraMap_apply, hτ])
      funext j
      refine (transcendental_iff.mp htr) (p j) ?_
      have := hτ (p j)
      rw [h0 j] at this
      simpa using this.symm
    · have hnli : ¬ LinearIndependent F v := by
        intro hli
        have := hli.fintype_card_le_finrank
        simp at this
      obtain ⟨g, hg, j₀, hj₀⟩ := Fintype.not_linearIndependent_iff.mp hnli
      have hCD : ∀ c : F, ∃ r s : Polynomial Ω, Polynomial.aeval f s ≠ 0 ∧
          (c : K) * Polynomial.aeval f s = Polynomial.aeval f r := by
        intro c
        obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff Ω (c : K)).mp c.2
        by_cases hs : Polynomial.aeval f s = 0
        · refine ⟨0, 1, by simp, ?_⟩
          rw [hrs, hs, div_zero]
          simp
        · exact ⟨r, s, hs, by rw [hrs, div_mul_cancel₀ _ hs]⟩
      choose r s hs hrs using hCD
      have hD : (∏ k, Polynomial.aeval f (s (g k))) ≠ 0 :=
        Finset.prod_ne_zero_iff.mpr fun k _ => hs (g k)
      have hp : ∀ j, Polynomial.aeval f (r (g j) * ∏ k ∈ Finset.univ.erase j, s (g k)) =
          (g j : K) * ∏ k, Polynomial.aeval f (s (g k)) := by
        intro j
        rw [map_mul, map_prod, ← hrs, mul_assoc,
          Finset.mul_prod_erase Finset.univ (fun k => Polynomial.aeval f (s (g k)))
            (Finset.mem_univ j)]
      refine ⟨fun j => r (g j) * ∏ k ∈ Finset.univ.erase j, s (g k), ?_, ?_⟩
      · intro h0
        have h1 := hp j₀
        have e : r (g j₀) * ∏ k ∈ Finset.univ.erase j₀, s (g k) = 0 := congrFun h0 j₀
        rw [e, map_zero] at h1
        have hz : (g j₀ : K) = 0 := by
          rcases mul_eq_zero.mp h1.symm with h | h
          · exact h
          · exact absurd h hD
        exact hj₀ (by exact_mod_cast hz)
      · simp only [hp]
        calc ∑ j, (g j : K) * (∏ k, Polynomial.aeval f (s (g k))) * v j
            = (∏ k, Polynomial.aeval f (s (g k))) * ∑ j, g j • v j := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [Algebra.smul_def, IntermediateField.algebraMap_apply]
              ring
          _ = 0 := by rw [hg, mul_zero]

  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S],
      Function.Injective (algebraMap R S) → ringKrullDim R ≤ ringKrullDim S := by
    intro R S _ _ _ _ hinj
    haveI : FaithfulSMul R S := (faithfulSMul_iff_algebraMap_injective R S).mpr hinj
    have key : ∀ (n : ℕ) (p : LTSeries (PrimeSpectrum R)), p.length = n →
        ∃ q : LTSeries (PrimeSpectrum S), q.length = n ∧
          PrimeSpectrum.comap (algebraMap R S) q.last = p.last := by
      intro n
      induction n with
      | zero =>
        intro p _
        obtain ⟨Q, hQ⟩ := Algebra.IsIntegral.comap_surjective R S p.last
        exact ⟨RelSeries.singleton _ Q, rfl, hQ⟩
      | succ n ih =>
        intro p hp
        obtain ⟨q', hq'len, hq'⟩ := ih p.eraseLast (by simp [hp])
        have hlt : p.eraseLast.last < p.last := p.eraseLast_last_rel_last (by omega)
        have hI : Ideal.under R q'.last.asIdeal ≤ p.last.asIdeal := by
          have e : Ideal.under R q'.last.asIdeal = p.eraseLast.last.asIdeal := by
            rw [← hq']; rfl
          rw [e]
          exact hlt.le
        obtain ⟨Q, hQI, hQp, hQ⟩ := Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime
          p.last.asIdeal q'.last.asIdeal hI
        let Q' : PrimeSpectrum S := ⟨Q, hQp⟩
        have hQ' : PrimeSpectrum.comap (algebraMap R S) Q' = p.last := by
          ext1
          exact hQ
        have hlt' : q'.last < Q' := by
          refine lt_of_le_of_ne (show q'.last.asIdeal ≤ Q from hQI) ?_
          intro heq
          apply hlt.ne
          rw [← hq', ← hQ', heq]
        refine ⟨q'.snoc Q' hlt', ?_, ?_⟩
        · rw [RelSeries.snoc_length, hq'len]
        · rw [RelSeries.last_snoc]
          exact hQ'
    show Order.krullDim (PrimeSpectrum R) ≤ Order.krullDim (PrimeSpectrum S)
    refine iSup_le fun p => ?_
    obtain ⟨q, hq, -⟩ := key p.length p rfl
    exact Order.le_krullDim_iff.mpr ⟨q, hq⟩

  let ψ : Ω →+* Γ(X, U) := (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
    (fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)
  have hψe : ψ = (fX.appLE ⊤ U (by simp)).hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom :=
    rfl
  have hψ : ψ.FiniteType := by
    rw [hψe]
    refine RingHom.FiniteType.comp (fX.finiteType_appLE (isAffineOpen_top _) hU _)
      (RingHom.FiniteType.of_surjective _ ?_)
    intro y
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y, ?_⟩
    change ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom y = y
    rw [Iso.hom_inv_id]
    rfl
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
  have hess : Algebra.EssFiniteType Ω (FractionRing Γ(X, U)) := by
    letI iA : Algebra Ω Γ(X, U) := ψ.toAlgebra
    haveI : Algebra.FiniteType Ω Γ(X, U) := hψ
    haveI : Algebra.EssFiniteType Ω Γ(X, U) := Algebra.EssFiniteType.of_finiteType Ω _
    haveI : Algebra.EssFiniteType Γ(X, U) (FractionRing Γ(X, U)) :=
      Algebra.EssFiniteType.of_isLocalization _ (nonZeroDivisors Γ(X, U))
    exact @Algebra.EssFiniteType.comp Ω Γ(X, U) (FractionRing Γ(X, U)) _ _ _ iA
      (wcCurveConst Ω X fX U).toAlgebra _
      (@IsScalarTower.of_algebraMap_eq Ω Γ(X, U) (FractionRing Γ(X, U)) _ _ _ iA _
        (wcCurveConst Ω X fX U).toAlgebra (fun _ => rfl)) _ _
  letI : Algebra Ω Γ(X, U) := ψ.toAlgebra
  haveI : Algebra.FiniteType Ω Γ(X, U) := hψ

  obtain ⟨s, g, hginj, hgfin⟩ := exists_finite_inj_algHom_of_fg Ω Γ(X, U)
  letI : Algebra (MvPolynomial (Fin s) Ω) Γ(X, U) := g.toRingHom.toAlgebra
  haveI : Algebra.IsIntegral (MvPolynomial (Fin s) Ω) Γ(X, U) :=
    ⟨RingHom.Finite.to_isIntegral hgfin⟩
  have hs : s ≤ 1 := by
    have h2 := s2 (MvPolynomial (Fin s) Ω) Γ(X, U) hginj
    have h1 : ringKrullDim Γ(X, U) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
      Ring.krullDimLE_iff.mp inferInstance
    have h3 : ringKrullDim (MvPolynomial (Fin s) Ω) = ((s : ℕ) : WithBot ℕ∞) := by
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
        ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
      rfl
    have h4 : ((s : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := h3 ▸ (h2.trans h1)
    exact_mod_cast h4
  let t : FractionRing Γ(X, U) :=
    if h : 0 < s then algebraMap Γ(X, U) (FractionRing Γ(X, U)) (g (MvPolynomial.X ⟨0, h⟩)) else 0
  let τ : IntermediateField.adjoin Ω ({t} : Set (FractionRing Γ(X, U))) :=
    ⟨t, IntermediateField.mem_adjoin_simple_self Ω t⟩
  let h : MvPolynomial (Fin s) Ω →+* IntermediateField.adjoin Ω ({t} : Set (FractionRing Γ(X, U))) :=
    (MvPolynomial.aeval (fun _ => τ)).toRingHom
  have hcomm : (algebraMap (IntermediateField.adjoin Ω ({t} : Set (FractionRing Γ(X, U))))
      (FractionRing Γ(X, U))).comp h =
      (algebraMap Γ(X, U) (FractionRing Γ(X, U))).comp
        (algebraMap (MvPolynomial (Fin s) Ω) Γ(X, U)) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      change algebraMap (IntermediateField.adjoin Ω ({t} : Set (FractionRing Γ(X, U))))
          (FractionRing Γ(X, U)) (MvPolynomial.aeval (fun _ => τ) (MvPolynomial.C r)) =
        algebraMap Γ(X, U) (FractionRing Γ(X, U)) (g (MvPolynomial.C r))
      rw [MvPolynomial.aeval_C, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      rfl
    · intro i
      have hpos : 0 < s := Fin.pos i
      have hi : i = ⟨0, hpos⟩ := Fin.ext (by have := i.isLt; show i.val = 0; omega)
      subst hi
      change algebraMap (IntermediateField.adjoin Ω ({t} : Set (FractionRing Γ(X, U))))
          (FractionRing Γ(X, U)) (MvPolynomial.aeval (fun _ => τ) (MvPolynomial.X _)) =
        algebraMap Γ(X, U) (FractionRing Γ(X, U)) (g (MvPolynomial.X _))
      rw [MvPolynomial.aeval_X]
      show t = _
      simp only [t, dif_pos hpos]
  have hint : ∀ a : Γ(X, U), IsIntegral (IntermediateField.adjoin Ω ({t} : Set (FractionRing Γ(X, U))))
      (algebraMap Γ(X, U) (FractionRing Γ(X, U)) a) := fun a =>
    IsIntegral.map_of_comp_eq h _ hcomm (Algebra.IsIntegral.isIntegral a)
  have halg : Algebra.IsAlgebraic (IntermediateField.adjoin Ω ({t} : Set (FractionRing Γ(X, U))))
      (FractionRing Γ(X, U)) := by
    refine ⟨fun z => ?_⟩
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := Γ(X, U)) z
    have ha : algebraMap Γ(X, U) (FractionRing Γ(X, U)) a ∈
        algebraicClosure (IntermediateField.adjoin Ω ({t} : Set (FractionRing Γ(X, U))))
          (FractionRing Γ(X, U)) :=
      mem_algebraicClosure_iff.mpr (hint a).isAlgebraic
    have hb : algebraMap Γ(X, U) (FractionRing Γ(X, U)) b ∈
        algebraicClosure (IntermediateField.adjoin Ω ({t} : Set (FractionRing Γ(X, U))))
          (FractionRing Γ(X, U)) :=
      mem_algebraicClosure_iff.mpr (hint b).isAlgebraic
    exact mem_algebraicClosure_iff.mp (IntermediateField.div_mem _ ha hb)
  exact key (FractionRing Γ(X, U)) t halg hess

theorem wc_curve_riemann_roch_large_degree : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ord →
    ∃ g c : ℕ, ∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ord D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ord D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ord hord
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
  obtain ⟨o1, o2, o3, o4, o5, o6⟩ := hord
  obtain ⟨w, hw, hwinj, hC1, hC2⟩ := wc_curve_true_valuations Ω X fX hnorm hdim U hU hfin
  have hA6 := wc_curve_function_field_finite_rank Ω X fX hnorm hdim U hU hfin
  have o6' : ∀ f : (FractionRing Γ(X, U))ˣ, (∀ x, 0 ≤ ord x (Additive.ofMul f)) ↔
      ∃ c : Ω, algebraMap Ω (FractionRing Γ(X, U)) c = (f : FractionRing Γ(X, U)) :=
    fun f => o6 f

  have hconst : ∀ (x : X) (c : Ω) (hc : algebraMap Ω (FractionRing Γ(X, U)) c ≠ 0),
      ord x (Additive.ofMul (Units.mk0 _ hc)) = 0 := by
    intro x c hc
    have h1 := (o6' (Units.mk0 _ hc)).mpr ⟨c, rfl⟩ x
    have hinv : algebraMap Ω (FractionRing Γ(X, U)) c⁻¹ ≠ 0 := by
      rw [map_inv₀]; exact inv_ne_zero hc
    have h2 := (o6' (Units.mk0 _ hinv)).mpr ⟨c⁻¹, rfl⟩ x
    have hmul : Units.mk0 _ hinv = (Units.mk0 _ hc)⁻¹ := by
      ext; simp [map_inv₀]
    rw [hmul, ofMul_inv, map_neg] at h2
    omega

  have hcm : ∀ s : {x : X // x ≠ genericPoint X}, ∃ z, ord s.1 = w z := by
    intro s
    apply hC2
    · intro a b h hab; exact o5 s.1 a b h hab
    · obtain ⟨m, hm⟩ := o4 s.1 s.2; exact ⟨m, hm⟩
    · intro c hc; exact hconst s.1 c hc
  choose cmap hcmap using hcm

  have hRw := wc_rr_residue_trivial Ω _ _ w hw hA6
  have hDw := wc_rr_dimension_step Ω _ _ w hw hRw
  have hPw := wc_rr_pole_degree_le Ω _ _ w hw hwinj hRw
  have h0w := wc_rr_degree_zero Ω _ _ w hw hA6 hDw hPw
  obtain ⟨gw, cw, hRRw⟩ := wc_rr_abstract_large_degree Ω _ _ w hw hA6 hDw hPw h0w

  have himg : ∀ y, ∃ s, cmap s = y := by
    intro y
    by_contra hne
    push_neg at hne
    have hdeg : (Finsupp.single y ((cw : ℤ) + gw + 1)).sum (fun _ k => k) = (cw : ℤ) + gw + 1 :=
      Finsupp.sum_single_index rfl
    obtain ⟨hfd, hrk⟩ := hRRw (Finsupp.single y ((cw : ℤ) + gw + 1)) (by rw [hdeg]; omega)
    rw [hdeg] at hrk
    have hle : wcRRL Ω (FractionRing Γ(X, U)) _ w (Finsupp.single y ((cw : ℤ) + gw + 1)) ≤
        Submodule.span Ω {(1 : FractionRing Γ(X, U))} := by
      apply Submodule.span_le.mpr
      rintro f ⟨hf, hfD⟩
      have hconstf : ∃ c : Ω, algebraMap Ω (FractionRing Γ(X, U)) c = f := by
        refine (o6' (Units.mk0 f hf)).mp ?_
        intro x
        by_cases hx : x = genericPoint X
        · simp [hx, o1]
        · rw [hcmap ⟨x, hx⟩]
          have hz : cmap ⟨x, hx⟩ ≠ y := hne ⟨x, hx⟩
          have := hfD (cmap ⟨x, hx⟩)
          rwa [Finsupp.single_apply, if_neg (Ne.symm hz), add_zero] at this
      obtain ⟨c, hc⟩ := hconstf
      rw [SetLike.mem_coe, Submodule.mem_span_singleton]
      exact ⟨c, by rw [Algebra.smul_def, mul_one, hc]⟩
    have := Submodule.finrank_mono hle
    rw [finrank_span_singleton one_ne_zero] at this
    omega

  have hfix : ∀ s : {x : X // x ≠ genericPoint X}, s.1 ∈ U → cmap s = s := by
    intro s hs
    apply hwinj
    rw [← hcmap s]
    obtain ⟨v, hv, hwv⟩ := hC1 s hs
    apply AddMonoidHom.ext
    intro m
    obtain ⟨f, rfl⟩ : ∃ f : (FractionRing Γ(X, U))ˣ, Additive.ofMul f = m :=
      ⟨Additive.toMul m, rfl⟩
    rw [hwv f, ← hv, o2 v f]

  haveI hTfin : Finite {s : {x : X // x ≠ genericPoint X} // s.1 ∉ U} := by
    haveI := hfin.to_subtype
    refine Finite.of_injective
      (fun t : {s : {x : X // x ≠ genericPoint X} // s.1 ∉ U} =>
        (⟨t.1.1, t.2⟩ : ((U : Set X)ᶜ : Set X))) ?_
    intro a b hab
    simp only [Subtype.mk.injEq] at hab
    exact Subtype.ext (Subtype.ext hab)
  have hpre : ∀ t : {s : {x : X // x ≠ genericPoint X} // s.1 ∉ U},
      ∃ s : {s : {x : X // x ≠ genericPoint X} // s.1 ∉ U}, cmap s.1 = t.1 := by
    intro t
    obtain ⟨s, hs⟩ := himg t.1
    refine ⟨⟨s, fun hsU => t.2 ?_⟩, hs⟩
    rw [← hs, hfix s hsU]; exact hsU
  choose gpre hgpre using hpre
  have hginj : Function.Injective gpre := by
    intro a b hab
    apply Subtype.ext
    rw [← hgpre a, ← hgpre b, hab]
  have hgsurj := Finite.injective_iff_surjective.mp hginj
  have hout : ∀ s : {x : X // x ≠ genericPoint X}, s.1 ∉ U →
      ∃ t, (gpre t).1 = s ∧ (cmap s).1 ∉ U := by
    intro s hs
    obtain ⟨t, ht⟩ := hgsurj ⟨s, hs⟩
    refine ⟨t, congrArg Subtype.val ht, ?_⟩
    have hct : cmap s = t.1 := by rw [← hgpre t, ht]
    rw [hct]; exact t.2
  have hcinj : Function.Injective cmap := by
    intro a b hab
    by_cases ha : a.1 ∈ U
    · by_cases hb : b.1 ∈ U
      · calc a = cmap a := (hfix a ha).symm
          _ = cmap b := hab
          _ = b := hfix b hb
      · exfalso
        obtain ⟨_, _, h⟩ := hout b hb
        rw [← hab, hfix a ha] at h; exact h ha
    · by_cases hb : b.1 ∈ U
      · exfalso
        obtain ⟨_, _, h⟩ := hout a ha
        rw [hab, hfix b hb] at h; exact h hb
      · obtain ⟨t, ht, _⟩ := hout a ha
        obtain ⟨t', ht', _⟩ := hout b hb
        have htt : t = t' := by
          apply Subtype.ext
          calc t.1 = cmap (gpre t).1 := (hgpre t).symm
            _ = cmap a := by rw [ht]
            _ = cmap b := hab
            _ = cmap (gpre t').1 := by rw [ht']
            _ = t'.1 := hgpre t'
        rw [← ht, ← ht', htt]

  let o : {x : X // x ≠ genericPoint X} → Additive (FractionRing Γ(X, U))ˣ →+ ℤ :=
    fun s => ord s.1
  have hoinj : Function.Injective o := by
    intro a b hab
    have hab' : w (cmap a) = w (cmap b) := by
      rw [← hcmap a, ← hcmap b]; exact hab
    exact hcinj (hwinj hab')
  have ho : wcValFamily Ω (FractionRing Γ(X, U)) _ o := by
    refine ⟨fun s a b h hab => o5 s.1 a b h hab, fun f => ?_, fun s => ?_, fun f => ?_⟩
    · exact Set.Finite.preimage (fun a _ b _ h => Subtype.val_injective h)
        (o3 (Additive.ofMul f))
    · obtain ⟨m, hm⟩ := o4 s.1 s.2; exact ⟨Additive.toMul m, hm⟩
    · refine Iff.trans ?_ (o6' f)
      constructor
      · intro h x
        by_cases hx : x = genericPoint X
        · simp [hx, o1]
        · exact h ⟨x, hx⟩
      · intro h s; exact h s.1
  have hRo := wc_rr_residue_trivial Ω _ _ o ho hA6
  have hDo := wc_rr_dimension_step Ω _ _ o ho hRo
  have hPo := wc_rr_pole_degree_le Ω _ _ o ho hoinj hRo
  have h0o := wc_rr_degree_zero Ω _ _ o ho hA6 hDo hPo
  obtain ⟨g, c, hRRo⟩ := wc_rr_abstract_large_degree Ω _ _ o ho hA6 hDo hPo h0o
  refine ⟨g, c, fun D hDη hc => ?_⟩
  have hdeg : (Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) D).sum (fun _ k => k) =
      D.sum (fun _ k => k) := by
    exact Finsupp.sum_subtypeDomain_index (h := fun _ k => k) (fun x hx hxη => by
      subst hxη
      exact Finsupp.mem_support_iff.mp hx hDη)
  have hspace : wcRRSpace Ω X fX U ord D =
      wcRRL Ω (FractionRing Γ(X, U)) _ o
        (Finsupp.subtypeDomain (fun x => x ≠ genericPoint X) D) := by
    unfold wcRRSpace wcRRL
    congr 1
    ext f
    constructor
    · rintro ⟨hf, h⟩
      exact ⟨hf, fun s => by rw [Finsupp.subtypeDomain_apply]; exact h s.1⟩
    · rintro ⟨hf, h⟩
      refine ⟨hf, fun x => ?_⟩
      by_cases hx : x = genericPoint X
      · simp [hx, o1, hDη]
      · have := h ⟨x, hx⟩
        rw [Finsupp.subtypeDomain_apply] at this
        exact this
  rw [hspace]
  rw [← hdeg] at hc ⊢
  exact hRRo _ hc

theorem wc_curve_good_point_exists : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ord →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ord D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ord D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ ℓ : ℕ, 0 < ℓ → ∀ P : X, P ≠ genericPoint X →
    ∀ (D : X → ℤ) (f : (FractionRing Γ(X, U))ˣ), (∀ x, (ℓ : ℤ) * D x = ord x (Additive.ofMul f)) →
    ∃ (E G : X →₀ ℤ) (f₀ a₀ b₀ u : (FractionRing Γ(X, U))ˣ),
      0 ≤ E ∧ 0 ≤ G ∧ (∀ x, E x = 0 ∨ G x = 0) ∧ a₀ ^ ℓ = f₀ * b₀ ∧
      (∀ x, ord x (Additive.ofMul f₀) =
        (ℓ : ℤ) * E x - Finsupp.single P ((ℓ : ℤ) * ((c : ℤ) + g)) x) ∧
      (∀ x, ord x (Additive.ofMul a₀) = E x + G x - Finsupp.single P (2 * (c : ℤ) + g + 1) x) ∧
      (∀ x, ord x (Additive.ofMul b₀) =
        (ℓ : ℤ) * G x - Finsupp.single P ((ℓ : ℤ) * ((c : ℤ) + 1)) x) ∧
      (∀ x, E x = D x + Finsupp.single P ((c : ℤ) + g) x + ord x (Additive.ofMul u)) ∧
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ord E) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ord G) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ord hord g c hRR ℓ hℓ P hP D f hDf
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
  obtain ⟨o1, o2, o3, o4, o5, o6⟩ := hord
  have hℓz : (ℓ : ℤ) ≠ 0 := by exact_mod_cast hℓ.ne'

  have hconst : ∀ (a : Ω) (ha : algebraMap Ω (FractionRing Γ(X, U)) a ≠ 0) (x : X),
      ord x (Additive.ofMul (Units.mk0 _ ha)) = 0 := by
    intro a ha x
    have h1 : 0 ≤ ord x (Additive.ofMul (Units.mk0 _ ha)) :=
      (o6 (Units.mk0 _ ha)).mpr ⟨a, rfl⟩ x
    have h2 : 0 ≤ ord x (Additive.ofMul (Units.mk0 _ ha)⁻¹) :=
      (o6 (Units.mk0 _ ha)⁻¹).mpr ⟨a⁻¹, by
        rw [Units.val_inv_eq_inv_val, Units.val_mk0,
          ← map_inv₀ (algebraMap Ω (FractionRing Γ(X, U))) a]
        rfl⟩ x
    rw [ofMul_inv, map_neg] at h2
    omega

  have s1 : ∀ (Z : X →₀ ℤ) (y : FractionRing Γ(X, U)), y ∈ wcRRSpace Ω X fX U ord Z →
      ∀ (hy : y ≠ 0) (x : X), 0 ≤ ord x (Additive.ofMul (Units.mk0 y hy)) + Z x := by
    intro Z y hy
    unfold wcRRSpace at hy
    induction hy using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨hz0, hzb⟩ := hz
      intro hy x
      exact hzb x
    | zero => intro h; exact absurd rfl h
    | add a b _ _ ha hb =>
      intro hab x
      by_cases ha0 : a = 0
      · subst ha0
        have hb0 : b ≠ 0 := by simpa using hab
        have e : Units.mk0 (0 + b) hab = Units.mk0 b hb0 := Units.ext (zero_add b)
        rw [e]; exact hb hb0 x
      by_cases hb0 : b = 0
      · subst hb0
        have e : Units.mk0 (a + 0) hab = Units.mk0 a ha0 := Units.ext (add_zero a)
        rw [e]; exact ha ha0 x
      have h5 := o5 x (Units.mk0 a ha0) (Units.mk0 b hb0) (Units.mk0 (a + b) hab) rfl
      have h1 := ha ha0 x
      have h2 := hb hb0 x
      rcases min_le_iff.mp h5 with h | h <;> omega
    | smul r a _ ha =>
      intro hra x
      have hκ : algebraMap Ω (FractionRing Γ(X, U)) r ≠ 0 := by
        intro h; apply hra; rw [Algebra.smul_def, h, zero_mul]
      have ha0 : a ≠ 0 := by
        intro h; apply hra; rw [h, smul_zero]
      have e : Units.mk0 (r • a) hra = Units.mk0 _ hκ * Units.mk0 a ha0 :=
        Units.ext (by simp [Algebra.smul_def])
      rw [e, ofMul_mul, map_add, hconst r hκ x, zero_add]
      exact ha ha0 x

  have hmul : ∀ (φ : (FractionRing Γ(X, U))ˣ) (Z Z' : X →₀ ℤ),
      (∀ x, Z' x = Z x - ord x (Additive.ofMul φ)) →
      ∀ y ∈ wcRRSpace Ω X fX U ord Z,
        (φ : FractionRing Γ(X, U)) * y ∈ wcRRSpace Ω X fX U ord Z' := by
    intro φ Z Z' hZ y hy
    unfold wcRRSpace at hy ⊢
    induction hy using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨hz0, hzb⟩ := hz
      apply Submodule.subset_span
      refine ⟨mul_ne_zero φ.ne_zero hz0, fun x => ?_⟩
      have e : Units.mk0 ((φ : FractionRing Γ(X, U)) * z) (mul_ne_zero φ.ne_zero hz0) =
          φ * Units.mk0 z hz0 := Units.ext rfl
      rw [e, ofMul_mul, map_add, hZ x]
      have := hzb x
      omega
    | zero => rw [mul_zero]; exact Submodule.zero_mem _
    | add a b _ _ ha hb => rw [mul_add]; exact Submodule.add_mem _ ha hb
    | smul r a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ ha
  have hfr : ∀ (φ : (FractionRing Γ(X, U))ˣ) (Z Z' : X →₀ ℤ),
      (∀ x, Z' x = Z x - ord x (Additive.ofMul φ)) →
      FiniteDimensional Ω (wcRRSpace Ω X fX U ord Z') →
      Module.finrank Ω (wcRRSpace Ω X fX U ord Z) ≤
        Module.finrank Ω (wcRRSpace Ω X fX U ord Z') := by
    intro φ Z Z' hZ hfin'
    have hinj : Function.Injective (LinearMap.mulLeft Ω (φ : FractionRing Γ(X, U))) := by
      intro a b hab
      have hab' : (φ : FractionRing Γ(X, U)) * a = (φ : FractionRing Γ(X, U)) * b := hab
      exact mul_left_cancel₀ φ.ne_zero hab'
    have hle : Submodule.map (LinearMap.mulLeft Ω (φ : FractionRing Γ(X, U)))
        (wcRRSpace Ω X fX U ord Z) ≤ wcRRSpace Ω X fX U ord Z' := by
      rintro _ ⟨y, hy, rfl⟩
      exact hmul φ Z Z' hZ y hy
    rw [LinearEquiv.finrank_eq (Submodule.equivMapOfInjective _ hinj _)]
    exact Submodule.finrank_mono hle

  obtain ⟨dv, hdv⟩ : ∃ dv : (FractionRing Γ(X, U))ˣ → X →₀ ℤ,
      ∀ φ x, dv φ x = ord x (Additive.ofMul φ) :=
    ⟨fun φ => Finsupp.ofSupportFinite (fun x => ord x (Additive.ofMul φ))
      (o3 (Additive.ofMul φ)), fun φ x => rfl⟩
  have hdeg_add : ∀ A B : X →₀ ℤ, (A + B).sum (fun _ k => k) =
      A.sum (fun _ k => k) + B.sum (fun _ k => k) :=
    fun A B => Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl)
  have hdeg_sub : ∀ A B : X →₀ ℤ, (A - B).sum (fun _ k => k) =
      A.sum (fun _ k => k) - B.sum (fun _ k => k) :=
    fun A B => Finsupp.sum_sub_index (fun _ _ _ => rfl)
  have hdeg_single : ∀ (x : X) (n : ℤ), (Finsupp.single x n).sum (fun _ k => k) = n :=
    fun x n => Finsupp.sum_single_index rfl
  have hsη : ∀ n : ℤ, Finsupp.single P n (genericPoint X) = 0 := fun n => by simp [hP]

  have hdeg_le : ∀ φ : (FractionRing Γ(X, U))ˣ, (dv φ).sum (fun _ k => k) ≤ 0 := by
    intro φ
    obtain ⟨δ, hδ⟩ : ∃ δ : ℤ, δ = (dv φ).sum (fun _ k => k) := ⟨_, rfl⟩
    rw [← hδ]
    obtain ⟨A, hA⟩ : ∃ A : X →₀ ℤ, A = Finsupp.single P ((c : ℤ) + |δ|) := ⟨_, rfl⟩
    have hAη : A (genericPoint X) = 0 := by rw [hA]; exact hsη _
    have hAdeg : A.sum (fun _ k => k) = (c : ℤ) + |δ| := by rw [hA, hdeg_single]
    have hBη : (A - dv φ) (genericPoint X) = 0 := by
      rw [Finsupp.sub_apply, hAη, hdv, o1, sub_zero]
    have hBdeg : (A - dv φ).sum (fun _ k => k) = (c : ℤ) + |δ| - δ := by
      rw [hdeg_sub, hAdeg, hδ]
    have habs := le_abs_self δ
    have habs0 := abs_nonneg δ
    obtain ⟨hA1, hA2⟩ := hRR A hAη (by rw [hAdeg]; linarith)
    obtain ⟨hB1, hB2⟩ := hRR (A - dv φ) hBη (by rw [hBdeg]; linarith)
    have h := hfr φ A (A - dv φ) (fun x => by rw [Finsupp.sub_apply, hdv]) hB1
    have h' : (Module.finrank Ω (wcRRSpace Ω X fX U ord A) : ℤ) ≤
        Module.finrank Ω (wcRRSpace Ω X fX U ord (A - dv φ)) := by exact_mod_cast h
    rw [hAdeg] at hA2
    rw [hBdeg] at hB2
    linarith
  have hdeg0 : ∀ φ : (FractionRing Γ(X, U))ˣ, (dv φ).sum (fun _ k => k) = 0 := by
    intro φ
    have e : dv φ⁻¹ = 0 - dv φ := by
      ext x
      rw [Finsupp.sub_apply, hdv, hdv, ofMul_inv, map_neg, Finsupp.zero_apply, zero_sub]
    have h1 := hdeg_le φ
    have h2 := hdeg_le φ⁻¹
    rw [e, hdeg_sub, Finsupp.sum_zero_index] at h2
    linarith

  have hg : (g : ℤ) ≤ c + 1 := by
    obtain ⟨_, h2⟩ := hRR (Finsupp.single P (c : ℤ)) (hsη _) (hdeg_single P _).ge
    rw [hdeg_single] at h2
    omega
  have hg0 : (0 : ℤ) ≤ g := Nat.cast_nonneg _
  have hc0 : (0 : ℤ) ≤ c := Nat.cast_nonneg _
  have hpos : ∀ Z : X →₀ ℤ, Z (genericPoint X) = 0 → (c : ℤ) ≤ Z.sum (fun _ k => k) →
      (g : ℤ) ≤ Z.sum (fun _ k => k) → wcRRSpace Ω X fX U ord Z ≠ ⊥ := by
    intro Z hZη hZc hZg hbot
    obtain ⟨_, h2⟩ := hRR Z hZη hZc
    rw [hbot, finrank_bot] at h2
    push_cast at h2
    omega

  have avoid : ∀ (T : Submodule Ω (FractionRing Γ(X, U)))
      (W : X → Submodule Ω (FractionRing Γ(X, U))) (S : Finset X),
      T ≠ ⊥ → (∀ i ∈ S, ¬ T ≤ W i) → ∃ v ∈ T, v ≠ 0 ∧ ∀ i ∈ S, v ∉ W i := by
    intro T W S hT
    have F : ∀ (Wi : Submodule Ω (FractionRing Γ(X, U))) (v w : FractionRing Γ(X, U)),
        (v ∉ Wi ∨ w ∉ Wi) → {t : Ω | v + t • w ∈ Wi}.Subsingleton := by
      intro Wi v w hvw t ht t' ht'
      by_contra hne
      have h1 : (t - t') • w ∈ Wi := by
        have := Wi.sub_mem ht ht'
        rwa [add_sub_add_left_eq_sub, ← sub_smul] at this
      have hw : w ∈ Wi := by
        have := Wi.smul_mem (t - t')⁻¹ h1
        rwa [smul_smul, inv_mul_cancel₀ (sub_ne_zero.mpr hne), one_smul] at this
      have hv : v ∈ Wi := by
        have := Wi.sub_mem ht (Wi.smul_mem t hw)
        rwa [add_sub_cancel_right] at this
      rcases hvw with h | h <;> contradiction
    induction S using Finset.induction_on with
    | empty =>
      intro _
      obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hT
      exact ⟨v, hv, hv0, fun i hi => absurd hi (Finset.notMem_empty i)⟩
    | insert i₀ s hi₀ ih =>
      intro hW
      obtain ⟨v, hvT, hv0, hvs⟩ := ih (fun i hi => hW i (Finset.mem_insert_of_mem hi))
      obtain ⟨w, hwT, hwW⟩ :=
        SetLike.not_le_iff_exists.mp (hW i₀ (Finset.mem_insert_self _ _))
      have hv0' : v ∉ (⊥ : Submodule Ω (FractionRing Γ(X, U))) := by
        rw [Submodule.mem_bot]; exact hv0
      have hbad : ({t : Ω | v + t • w ∈ (⊥ : Submodule Ω (FractionRing Γ(X, U)))} ∪
          (⋃ i ∈ (s : Set X), {t : Ω | v + t • w ∈ W i}) ∪
          {t : Ω | v + t • w ∈ W i₀}).Finite :=
        ((F ⊥ v w (Or.inl hv0')).finite.union
          (Set.Finite.biUnion s.finite_toSet fun i hi =>
            (F (W i) v w (Or.inl (hvs i (Finset.mem_coe.mp hi)))).finite)).union
          (F (W i₀) v w (Or.inr hwW)).finite
      obtain ⟨t, ht⟩ := hbad.infinite_compl.nonempty
      refine ⟨v + t • w, T.add_mem hvT (T.smul_mem t hwT), ?_, ?_⟩
      · intro h0
        apply ht
        refine Or.inl (Or.inl ?_)
        show v + t • w ∈ (⊥ : Submodule Ω (FractionRing Γ(X, U)))
        rw [h0]; exact Submodule.zero_mem _
      · intro i hi hmem
        apply ht
        rcases Finset.mem_insert.mp hi with rfl | hi'
        · exact Or.inr hmem
        · exact Or.inl (Or.inr (Set.mem_biUnion (Finset.mem_coe.mpr hi') hmem))

  have hDη : D (genericPoint X) = 0 := by
    have := hDf (genericPoint X)
    rw [o1] at this
    exact (mul_eq_zero.mp this).resolve_left hℓz
  have hDsupp : (Function.support D).Finite := by
    refine (o3 (Additive.ofMul f)).subset ?_
    intro x hx
    simp only [Function.mem_support] at hx
    simp only [Set.mem_setOf_eq]
    rw [← hDf x]
    exact mul_ne_zero hℓz hx
  obtain ⟨DF, hDF⟩ : ∃ DF : X →₀ ℤ, ∀ x, DF x = D x :=
    ⟨Finsupp.ofSupportFinite D hDsupp, fun x => rfl⟩
  have hDFdeg : DF.sum (fun _ k => k) = 0 := by
    have e : (ℓ : ℤ) • DF = dv f := by
      ext x; rw [Finsupp.smul_apply, smul_eq_mul, hDF, hdv, hDf]
    have h0 := hdeg0 f
    rw [← e, Finsupp.sum_smul_index' (fun _ => rfl)] at h0
    simp only [smul_eq_mul] at h0
    rw [← Finsupp.mul_sum] at h0
    exact (mul_eq_zero.mp h0).resolve_left hℓz

  have hD'η : (DF + Finsupp.single P ((c : ℤ) + g)) (genericPoint X) = 0 := by
    rw [Finsupp.add_apply, hDF, hDη, hsη, add_zero]
  have hD'deg : (DF + Finsupp.single P ((c : ℤ) + g)).sum (fun _ k => k) = (c : ℤ) + g := by
    rw [hdeg_add, hDFdeg, hdeg_single, zero_add]
  obtain ⟨w0, hw0L, hw00⟩ := Submodule.exists_mem_ne_zero_of_ne_bot
    (hpos _ hD'η (by rw [hD'deg]; linarith) (by rw [hD'deg]; linarith))
  have hw0b := s1 _ w0 hw0L hw00
  obtain ⟨u, hu⟩ : ∃ u : (FractionRing Γ(X, U))ˣ, u = Units.mk0 w0 hw00 := ⟨_, rfl⟩
  rw [← hu] at hw0b
  obtain ⟨E, hEdef⟩ : ∃ E : X →₀ ℤ, E = DF + Finsupp.single P ((c : ℤ) + g) + dv u :=
    ⟨_, rfl⟩
  have hEx : ∀ x, E x = D x + Finsupp.single P ((c : ℤ) + g) x + ord x (Additive.ofMul u) := by
    intro x; rw [hEdef, Finsupp.add_apply, Finsupp.add_apply, hDF, hdv]
  have hE0 : 0 ≤ E := by
    rw [Finsupp.le_def]; intro x
    have := hw0b x
    rw [Finsupp.add_apply, hDF] at this
    rw [hEx, Finsupp.zero_apply]; linarith
  have hEη : E (genericPoint X) = 0 := by rw [hEx, hDη, hsη, o1]; rfl
  have hEdeg : E.sum (fun _ k => k) = (c : ℤ) + g := by
    rw [hEdef, hdeg_add, hD'deg, hdeg0, add_zero]
  have hordf0 : ∀ x, ord x (Additive.ofMul (f * u ^ ℓ)) =
      (ℓ : ℤ) * E x - Finsupp.single P ((ℓ : ℤ) * ((c : ℤ) + g)) x := by
    intro x
    rw [ofMul_mul, ofMul_pow, map_add, map_nsmul, nsmul_eq_mul, hEx, ← hDf x,
      Finsupp.single_apply, Finsupp.single_apply]
    split_ifs <;> ring

  obtain ⟨Vd, hVddef⟩ : ∃ V : X →₀ ℤ, V = Finsupp.single P (2 * (c : ℤ) + g + 1) - E :=
    ⟨_, rfl⟩
  have hVdx : ∀ x, Vd x = Finsupp.single P (2 * (c : ℤ) + g + 1) x - E x := by
    intro x; rw [hVddef, Finsupp.sub_apply]
  have hVdη : Vd (genericPoint X) = 0 := by rw [hVdx, hsη, hEη, sub_zero]
  have hVddeg : Vd.sum (fun _ k => k) = (c : ℤ) + 1 := by
    rw [hVddef, hdeg_sub, hdeg_single, hEdeg]; ring
  have hdrop : ∀ x ∈ E.support, ¬ wcRRSpace Ω X fX U ord Vd ≤
      wcRRSpace Ω X fX U ord (Vd - Finsupp.single x 1) := by
    intro x hx hle
    have hxη : x ≠ genericPoint X := by
      rintro rfl; exact (Finsupp.mem_support_iff.mp hx) hEη
    have hη' : (Vd - Finsupp.single x (1 : ℤ)) (genericPoint X) = 0 := by
      rw [Finsupp.sub_apply, hVdη, Finsupp.single_apply, if_neg hxη, sub_zero]
    have hdeg' : (Vd - Finsupp.single x 1).sum (fun _ k => k) = (c : ℤ) := by
      rw [hdeg_sub, hVddeg, hdeg_single]; ring
    obtain ⟨hf1, hf2⟩ := hRR _ hη' hdeg'.ge
    obtain ⟨_, hv2⟩ := hRR Vd hVdη (by rw [hVddeg]; linarith)
    have hm := Submodule.finrank_mono hle
    have h' : (Module.finrank Ω (wcRRSpace Ω X fX U ord Vd) : ℤ) ≤
        Module.finrank Ω (wcRRSpace Ω X fX U ord (Vd - Finsupp.single x 1)) := by
      exact_mod_cast hm
    rw [hdeg'] at hf2
    rw [hVddeg] at hv2
    linarith
  obtain ⟨a', ha'L, ha'0, ha'W⟩ := avoid (wcRRSpace Ω X fX U ord Vd)
    (fun x => wcRRSpace Ω X fX U ord (Vd - Finsupp.single x 1)) E.support
    (hpos Vd hVdη (by rw [hVddeg]; linarith) (by rw [hVddeg]; linarith)) hdrop
  have hab := s1 Vd a' ha'L ha'0
  obtain ⟨a₀, ha₀⟩ : ∃ a₀ : (FractionRing Γ(X, U))ˣ, a₀ = Units.mk0 a' ha'0 := ⟨_, rfl⟩
  rw [← ha₀] at hab
  obtain ⟨G, hGdef⟩ : ∃ G : X →₀ ℤ, G = dv a₀ + Vd := ⟨_, rfl⟩
  have hGx : ∀ x, G x = ord x (Additive.ofMul a₀) + Vd x := by
    intro x; rw [hGdef, Finsupp.add_apply, hdv]
  have hG0 : 0 ≤ G := by
    rw [Finsupp.le_def]; intro x; rw [hGx, Finsupp.zero_apply]; exact hab x
  have hGη : G (genericPoint X) = 0 := by rw [hGx, o1, hVdη]; rfl
  have hGdeg : G.sum (fun _ k => k) = (c : ℤ) + 1 := by
    rw [hGdef, hdeg_add, hdeg0, hVddeg, zero_add]
  have hora0 : ∀ x, ord x (Additive.ofMul a₀) =
      E x + G x - Finsupp.single P (2 * (c : ℤ) + g + 1) x := by
    intro x; rw [hGx, hVdx]; ring
  have hdisj : ∀ x, E x = 0 ∨ G x = 0 := by
    intro x
    by_cases hEx0 : E x = 0
    · exact Or.inl hEx0
    · right
      by_contra hGx0
      have hG1 : 1 ≤ G x := by
        have := (Finsupp.le_def.mp hG0) x
        rw [Finsupp.zero_apply] at this
        omega
      apply ha'W x (Finsupp.mem_support_iff.mpr hEx0)
      show a' ∈ wcRRSpace Ω X fX U ord (Vd - Finsupp.single x 1)
      unfold wcRRSpace
      apply Submodule.subset_span
      refine ⟨ha'0, fun y => ?_⟩
      rw [← ha₀, Finsupp.sub_apply, Finsupp.single_apply]
      have hy := (Finsupp.le_def.mp hG0) y
      rw [Finsupp.zero_apply, hGx] at hy
      split_ifs with hxy
      · subst hxy; rw [hGx] at hG1; linarith
      · linarith
  refine ⟨E, G, f * u ^ ℓ, a₀, a₀ ^ ℓ * (f * u ^ ℓ)⁻¹, u, hE0, hG0, hdisj, ?_, hordf0, hora0,
    ?_, hEx, (hRR E hEη (by rw [hEdeg]; linarith)).1, (hRR G hGη (by rw [hGdeg]; linarith)).1⟩
  · rw [mul_comm (a₀ ^ ℓ), mul_inv_cancel_left]
  · intro x
    rw [ofMul_mul, ofMul_inv, ofMul_pow, map_add, map_neg, map_nsmul, nsmul_eq_mul, hora0, hordf0,
      Finsupp.single_apply, Finsupp.single_apply, Finsupp.single_apply]
    split_ifs <;> ring

theorem wc_curve_good_point_tangent : ∀ (Ω : Type u) [Field Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IrreducibleSpace X]
    (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U)
    (ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ), wcCurveOrdData Ω X fX U hU ord →
    ∀ ℓ : ℕ, 0 < ℓ → (ℓ : Ω) ≠ 0 →
    ∀ (E G BF BA BB : X →₀ ℤ) (f₀ a₀ b₀ : (FractionRing Γ(X, U))ˣ),
    0 ≤ E → 0 ≤ G → (∀ x, E x = 0 ∨ G x = 0) → a₀ ^ ℓ = f₀ * b₀ →
    (∀ x, ord x (Additive.ofMul f₀) = (ℓ : ℤ) * E x - BF x) →
    (∀ x, ord x (Additive.ofMul a₀) = E x + G x - BA x) →
    (∀ x, ord x (Additive.ofMul b₀) = (ℓ : ℤ) * G x - BB x) →
    (1 : FractionRing Γ(X, U)) ∈ wcRRSpace Ω X fX U ord E ∧
    (1 : FractionRing Γ(X, U)) ∈ wcRRSpace Ω X fX U ord G ∧
    (∀ h ∈ wcRRSpace Ω X fX U ord E,
      h ^ ℓ * (f₀ : FractionRing Γ(X, U)) ∈ wcRRSpace Ω X fX U ord BF) ∧
    (∀ h ∈ wcRRSpace Ω X fX U ord E, ∀ k ∈ wcRRSpace Ω X fX U ord G,
      h * k * (a₀ : FractionRing Γ(X, U)) ∈ wcRRSpace Ω X fX U ord BA) ∧
    (∀ k ∈ wcRRSpace Ω X fX U ord G,
      k ^ ℓ * (b₀ : FractionRing Γ(X, U)) ∈ wcRRSpace Ω X fX U ord BB) ∧
    (∀ f' ∈ wcRRSpace Ω X fX U ord BF, ∀ a' ∈ wcRRSpace Ω X fX U ord BA,
      ∀ b' ∈ wcRRSpace Ω X fX U ord BB,
      (ℓ : FractionRing Γ(X, U)) * (a₀ : FractionRing Γ(X, U)) ^ (ℓ - 1) * a' =
        f' * (b₀ : FractionRing Γ(X, U)) + (f₀ : FractionRing Γ(X, U)) * b' →
      f' * (f₀ : FractionRing Γ(X, U))⁻¹ ∈ wcRRSpace Ω X fX U ord E ∧
      b' * (b₀ : FractionRing Γ(X, U))⁻¹ ∈ wcRRSpace Ω X fX U ord G ∧
      (f' = 0 → b' = 0 → a' = 0)) :=
by
  intro Ω _ X fX _ U _ hU ord hord ℓ hℓ hℓΩ E G BF BA BB f₀ a₀ b₀ hE hG hdisj hab hordf hora hordb
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
  obtain ⟨_, _, _, _, hult, hconst⟩ := hord
  have hℓ0 : ℓ ≠ 0 := Nat.pos_iff_ne_zero.mp hℓ

  obtain ⟨vv, hvv⟩ : ∃ vv : X → FractionRing Γ(X, U) → ℤ, ∀ x (f : FractionRing Γ(X, U))
      (hf : f ≠ 0), ord x (Additive.ofMul (Units.mk0 f hf)) = vv x f :=
    ⟨fun x f => if hf : f ≠ 0 then ord x (Additive.ofMul (Units.mk0 f hf)) else 0,
      fun x f hf => by dsimp only; rw [dif_pos hf]⟩
  have vunit : ∀ x (w : (FractionRing Γ(X, U))ˣ),
      vv x (w : FractionRing Γ(X, U)) = ord x (Additive.ofMul w) := by
    intro x w
    rw [← hvv x _ w.ne_zero, Units.mk0_val]
  have vmul : ∀ x (y z : FractionRing Γ(X, U)), y ≠ 0 → z ≠ 0 →
      vv x (y * z) = vv x y + vv x z := by
    intro x y z hy hz
    rw [← hvv x _ (mul_ne_zero hy hz), ← hvv x y hy, ← hvv x z hz]
    have : Units.mk0 (y * z) (mul_ne_zero hy hz) = Units.mk0 y hy * Units.mk0 z hz := by
      ext; simp
    rw [this, ofMul_mul, map_add]
  have vone : ∀ x, vv x (1 : FractionRing Γ(X, U)) = 0 := by
    intro x
    rw [← hvv x 1 one_ne_zero]
    have : Units.mk0 (1 : FractionRing Γ(X, U)) one_ne_zero = 1 := by ext; simp
    rw [this, ofMul_one, map_zero]
  have vpow : ∀ x (y : FractionRing Γ(X, U)) (n : ℕ), y ≠ 0 →
      vv x (y ^ n) = (n : ℤ) * vv x y := by
    intro x y n hy
    induction n with
    | zero => rw [pow_zero, vone]; simp
    | succ n ih =>
      rw [pow_succ, vmul x _ _ (pow_ne_zero _ hy) hy, ih]
      push_cast; ring
  have vinv : ∀ x (y : FractionRing Γ(X, U)) (w : (FractionRing Γ(X, U))ˣ), y ≠ 0 →
      vv x (y * (w : FractionRing Γ(X, U))⁻¹) = vv x y - ord x (Additive.ofMul w) := by
    intro x y w hy
    rw [← Units.val_inv_eq_inv_val, vmul x y _ hy (Units.ne_zero _), vunit, ofMul_inv, map_neg]
    ring
  have vconst : ∀ x (c : Ω), wcCurveConst Ω X fX U c ≠ 0 →
      0 ≤ vv x (wcCurveConst Ω X fX U c) := by
    intro x c hc
    rw [← hvv x _ hc]
    exact (hconst (Units.mk0 _ hc)).mpr ⟨c, rfl⟩ x
  have vult : ∀ x (y z : FractionRing Γ(X, U)), y ≠ 0 → z ≠ 0 → y + z ≠ 0 →
      min (vv x y) (vv x z) ≤ vv x (y + z) := by
    intro x y z hy hz hyz
    rw [← hvv x y hy, ← hvv x z hz, ← hvv x _ hyz]
    exact hult x _ _ _ rfl
  have hℓK : ((ℓ : ℕ) : FractionRing Γ(X, U)) ≠ 0 := by
    rw [← map_natCast (wcCurveConst Ω X fX U)]
    exact (map_ne_zero _).mpr hℓΩ
  have vℓ : ∀ x, 0 ≤ vv x ((ℓ : ℕ) : FractionRing Γ(X, U)) := by
    intro x
    have := vconst x (ℓ : Ω) (by rw [map_natCast]; exact hℓK)
    rwa [map_natCast] at this
  have vneg1 : ∀ x, 0 ≤ vv x (-1 : FractionRing Γ(X, U)) := by
    intro x
    have := vconst x (-1 : Ω) (by rw [map_neg, map_one]; exact neg_ne_zero.mpr one_ne_zero)
    rwa [map_neg, map_one] at this

  have memL : ∀ (D : X →₀ ℤ) (f : FractionRing Γ(X, U)), f ∈ wcRRSpace Ω X fX U ord D ↔
      (f = 0 ∨ ∀ x, 0 ≤ vv x f + D x) := by
    intro D f
    constructor
    · intro hf
      unfold wcRRSpace at hf
      induction hf using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨hy0, hy⟩ := hy
        right
        intro x
        rw [← hvv x y hy0]
        exact hy x
      | zero => left; rfl
      | add y z _ _ hy hz =>
        by_cases hy0 : y = 0
        · rw [hy0, zero_add]; exact hz
        by_cases hz0 : z = 0
        · rw [hz0, add_zero]; exact hy
        by_cases hyz : y + z = 0
        · left; exact hyz
        right
        have hy' := hy.resolve_left hy0
        have hz' := hz.resolve_left hz0
        intro x
        have h1 := vult x y z hy0 hz0 hyz
        have h2 := hy' x
        have h3 := hz' x
        rcases min_le_iff.mp h1 with h | h <;> linarith
      | smul a y _ hy =>
        change (wcCurveConst Ω X fX U a * y = 0) ∨
          ∀ x, 0 ≤ vv x (wcCurveConst Ω X fX U a * y) + D x
        by_cases h0 : wcCurveConst Ω X fX U a * y = 0
        · left; exact h0
        right
        have ha := left_ne_zero_of_mul h0
        have hy0 := right_ne_zero_of_mul h0
        have hy' := hy.resolve_left hy0
        intro x
        rw [vmul x _ _ ha hy0]
        have h1 := vconst x a ha
        have h2 := hy' x
        linarith
    · intro h
      by_cases hf0 : f = 0
      · rw [hf0]; exact Submodule.zero_mem _
      · have h' := h.resolve_left hf0
        apply Submodule.subset_span
        refine ⟨hf0, fun x => ?_⟩
        rw [hvv x f hf0]
        exact h' x
  have hEx : ∀ x, 0 ≤ E x := fun x => by simpa using (Finsupp.le_def.mp hE) x
  have hGx : ∀ x, 0 ≤ G x := fun x => by simpa using (Finsupp.le_def.mp hG) x

  have Bmono : ∀ x (n n' : ℤ) (y : FractionRing Γ(X, U)), n' ≤ n →
      (y = 0 ∨ n ≤ vv x y) → (y = 0 ∨ n' ≤ vv x y) := by
    rintro x n n' y h (h1 | h1)
    · left; exact h1
    · right; linarith
  have Badd : ∀ x (n : ℤ) (y z : FractionRing Γ(X, U)), (y = 0 ∨ n ≤ vv x y) →
      (z = 0 ∨ n ≤ vv x z) → (y + z = 0 ∨ n ≤ vv x (y + z)) := by
    intro x n y z hy hz
    by_cases hy0 : y = 0
    · rw [hy0, zero_add]; exact hz
    by_cases hz0 : z = 0
    · rw [hz0, add_zero]; exact hy
    by_cases hyz : y + z = 0
    · left; exact hyz
    right
    have h0 := vult x y z hy0 hz0 hyz
    have h1 := hy.resolve_left hy0
    have h2 := hz.resolve_left hz0
    rcases min_le_iff.mp h0 with h | h <;> linarith
  have Bmul : ∀ x (n : ℤ) (y : FractionRing Γ(X, U)), (y = 0 ∨ n ≤ vv x y) →
      ((ℓ : FractionRing Γ(X, U)) * y = 0 ∨ n ≤ vv x ((ℓ : FractionRing Γ(X, U)) * y)) := by
    intro x n y hy
    by_cases hy0 : y = 0
    · left; rw [hy0, mul_zero]
    right
    rw [vmul x _ _ hℓK hy0]
    have h1 := hy.resolve_left hy0
    have h2 := vℓ x
    linarith
  have Bneg : ∀ x (n : ℤ) (y : FractionRing Γ(X, U)), (y = 0 ∨ n ≤ vv x y) →
      (-y = 0 ∨ n ≤ vv x (-y)) := by
    intro x n y hy
    by_cases hy0 : y = 0
    · left; rw [hy0, neg_zero]
    right
    rw [neg_eq_neg_one_mul, vmul x _ _ (neg_ne_zero.mpr one_ne_zero) hy0]
    have h1 := hy.resolve_left hy0
    have h2 := vneg1 x
    linarith
  have Bdiv : ∀ (D : X →₀ ℤ) (y : FractionRing Γ(X, U)) (w : (FractionRing Γ(X, U))ˣ) x,
      (y = 0 ∨ ∀ x, 0 ≤ vv x y + D x) →
      (y * (w : FractionRing Γ(X, U))⁻¹ = 0 ∨
        -D x - ord x (Additive.ofMul w) ≤ vv x (y * (w : FractionRing Γ(X, U))⁻¹)) := by
    intro D y w x hy
    by_cases hy0 : y = 0
    · left; rw [hy0, zero_mul]
    right
    rw [vinv x y w hy0]
    have h1 := (hy.resolve_left hy0) x
    linarith
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    refine (memL E 1).mpr (Or.inr fun x => ?_)
    rw [vone]; linarith [hEx x]
  · refine (memL G 1).mpr (Or.inr fun x => ?_)
    rw [vone]; linarith [hGx x]
  · intro h hh
    by_cases h0 : h = 0
    · rw [h0, zero_pow hℓ0, zero_mul]; exact Submodule.zero_mem _
    have hh' := ((memL E h).mp hh).resolve_left h0
    refine (memL BF _).mpr (Or.inr fun x => ?_)
    rw [vmul x _ _ (pow_ne_zero _ h0) f₀.ne_zero, vpow x h ℓ h0, vunit, hordf x]
    have h1 := mul_nonneg (Nat.cast_nonneg ℓ : (0 : ℤ) ≤ ℓ) (hh' x)
    linarith
  · intro h hh k hk
    by_cases h0 : h = 0
    · rw [h0, zero_mul, zero_mul]; exact Submodule.zero_mem _
    by_cases k0 : k = 0
    · rw [k0, mul_zero, zero_mul]; exact Submodule.zero_mem _
    have hh' := ((memL E h).mp hh).resolve_left h0
    have hk' := ((memL G k).mp hk).resolve_left k0
    refine (memL BA _).mpr (Or.inr fun x => ?_)
    rw [vmul x _ _ (mul_ne_zero h0 k0) a₀.ne_zero, vmul x _ _ h0 k0, vunit, hora x]
    linarith [hh' x, hk' x]
  · intro k hk
    by_cases k0 : k = 0
    · rw [k0, zero_pow hℓ0, zero_mul]; exact Submodule.zero_mem _
    have hk' := ((memL G k).mp hk).resolve_left k0
    refine (memL BB _).mpr (Or.inr fun x => ?_)
    rw [vmul x _ _ (pow_ne_zero _ k0) b₀.ne_zero, vpow x k ℓ k0, vunit, hordb x]
    have h1 := mul_nonneg (Nat.cast_nonneg ℓ : (0 : ℤ) ≤ ℓ) (hk' x)
    linarith
  · intro f' hf' a' ha' b' hb' hrel
    have hf₀ := f₀.ne_zero
    have ha₀ := a₀.ne_zero
    have hb₀ := b₀.ne_zero
    have hab' : (a₀ : FractionRing Γ(X, U)) ^ ℓ = (f₀ : FractionRing Γ(X, U)) * b₀ := by
      rw [← Units.val_pow_eq_pow_val, hab, Units.val_mul]
    have hpow : (a₀ : FractionRing Γ(X, U)) ^ (ℓ - 1) * a₀ = (f₀ : FractionRing Γ(X, U)) * b₀ := by
      rw [pow_sub_one_mul hℓ0, hab']
    obtain ⟨s, hs⟩ : ∃ s, s = f' * (f₀ : FractionRing Γ(X, U))⁻¹ := ⟨_, rfl⟩
    obtain ⟨t, ht⟩ : ∃ t, t = b' * (b₀ : FractionRing Γ(X, U))⁻¹ := ⟨_, rfl⟩
    obtain ⟨u, hu⟩ : ∃ u, u = a' * (a₀ : FractionRing Γ(X, U))⁻¹ := ⟨_, rfl⟩
    have hR : (ℓ : FractionRing Γ(X, U)) * u = s + t := by
      apply mul_right_cancel₀ (mul_ne_zero hf₀ hb₀)
      have i1 := mul_inv_cancel₀ hf₀
      have i2 := mul_inv_cancel₀ ha₀
      have i3 := mul_inv_cancel₀ hb₀
      calc (ℓ : FractionRing Γ(X, U)) * u * ((f₀ : FractionRing Γ(X, U)) * b₀)
          = (ℓ : FractionRing Γ(X, U)) * (a₀ : FractionRing Γ(X, U)) ^ (ℓ - 1) * a' := by
            rw [← hpow, hu]
            linear_combination ((ℓ : FractionRing Γ(X, U)) *
              (a₀ : FractionRing Γ(X, U)) ^ (ℓ - 1) * a') * i2
        _ = f' * (b₀ : FractionRing Γ(X, U)) + (f₀ : FractionRing Γ(X, U)) * b' := hrel
        _ = (s + t) * ((f₀ : FractionRing Γ(X, U)) * b₀) := by
            rw [hs, ht]
            linear_combination (-(f' * (b₀ : FractionRing Γ(X, U)))) * i1 -
              ((f₀ : FractionRing Γ(X, U)) * b') * i3
    have key : ∀ x, (s = 0 ∨ -E x ≤ vv x s) ∧ (t = 0 ∨ -G x ≤ vv x t) := by
      intro x
      have Ps := Bdiv BF f' f₀ x ((memL BF f').mp hf')
      have Pt := Bdiv BB b' b₀ x ((memL BB b').mp hb')
      have Pu := Bdiv BA a' a₀ x ((memL BA a').mp ha')
      rw [← hs, hordf x] at Ps
      rw [← ht, hordb x] at Pt
      rw [← hu, hora x] at Pu
      have hE0 := hEx x
      have hG0 := hGx x
      rcases hdisj x with h0 | h0
      · refine ⟨Bmono x _ _ s (by rw [h0]; linarith) Ps, ?_⟩
        have hts : t = (ℓ : FractionRing Γ(X, U)) * u + -s := by rw [hR]; ring
        have := Badd x (-G x) _ _ (Bmul x _ u (Bmono x _ _ u (by rw [h0]; linarith) Pu))
          (Bneg x _ s (Bmono x _ _ s (by rw [h0]; linarith) Ps))
        rw [← hts] at this
        exact this
      · refine ⟨?_, Bmono x _ _ t (by rw [h0]; linarith) Pt⟩
        have hst : s = (ℓ : FractionRing Γ(X, U)) * u + -t := by rw [hR]; ring
        have := Badd x (-E x) _ _ (Bmul x _ u (Bmono x _ _ u (by rw [h0]; linarith) Pu))
          (Bneg x _ t (Bmono x _ _ t (by rw [h0]; linarith) Pt))
        rw [← hst] at this
        exact this
    refine ⟨?_, ?_, ?_⟩
    · rw [← hs]
      apply (memL E s).mpr
      by_cases hs0 : s = 0
      · left; exact hs0
      right
      intro x
      have := (key x).1.resolve_left hs0
      linarith
    · rw [← ht]
      apply (memL G t).mpr
      by_cases ht0 : t = 0
      · left; exact ht0
      right
      intro x
      have := (key x).2.resolve_left ht0
      linarith
    · intro hf0 hb0
      rw [hf0, hb0, zero_mul, mul_zero, add_zero] at hrel
      rcases mul_eq_zero.mp hrel with h | h
      · exact absurd h (mul_ne_zero hℓK (pow_ne_zero _ ha₀))
      · exact h

theorem wc_bc_equations (Ω : Type u) [Field Ω] (K : Type u) [Field K] [Algebra Ω K]
    (ℓ : ℕ) (ιF ιA ιB : Type) [Fintype ιF] [Fintype ιA] [Fintype ιB]
    [DecidableEq ιF] [DecidableEq ιA] [DecidableEq ιB]
    (φ : ιF → K) (α : ιA → K) (β : ιB → K) :
    ∃ (m : ℕ) (F : Fin m → MvPolynomial ((ιF ⊕ ιA) ⊕ ιB) Ω),
      (∀ z : (ιF ⊕ ιA) ⊕ ιB → Ω, (∀ i, MvPolynomial.eval z (F i) = 0) ↔
        (∑ j, z (Sum.inl (Sum.inr j)) • α j) ^ ℓ =
          (∑ j, z (Sum.inl (Sum.inl j)) • φ j) * ∑ j, z (Sum.inr j) • β j) ∧
      (∀ z w : (ιF ⊕ ιA) ⊕ ιB → Ω,
        (∀ i, ∑ s, MvPolynomial.eval z (MvPolynomial.pderiv s (F i)) * w s = 0) ↔
        (ℓ : K) * (∑ j, z (Sum.inl (Sum.inr j)) • α j) ^ (ℓ - 1) *
            (∑ j, w (Sum.inl (Sum.inr j)) • α j) =
          (∑ j, w (Sum.inl (Sum.inl j)) • φ j) * (∑ j, z (Sum.inr j) • β j) +
          (∑ j, z (Sum.inl (Sum.inl j)) • φ j) * (∑ j, w (Sum.inr j) • β j)) :=
by
  classical

  have hlinE : ∀ (ι' : Type) [Fintype ι'] (t : ι' → (ιF ⊕ ιA) ⊕ ιB) (γ : ι' → K)
      (z : (ιF ⊕ ιA) ⊕ ιB → Ω),
      MvPolynomial.eval (algebraMap Ω K ∘ z) (∑ j, MvPolynomial.X (t j) * MvPolynomial.C (γ j)) =
        ∑ j, z (t j) • γ j := by
    intro ι' _ t γ z
    simp only [map_sum, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_C, Function.comp_apply,
      Algebra.smul_def]
  have hlinD : ∀ (ι' : Type) [Fintype ι'] (t : ι' → (ιF ⊕ ιA) ⊕ ιB) (γ : ι' → K)
      (z w : (ιF ⊕ ιA) ⊕ ιB → Ω),
      ∑ s, MvPolynomial.eval (algebraMap Ω K ∘ z)
          (MvPolynomial.pderiv s (∑ j, MvPolynomial.X (t j) * MvPolynomial.C (γ j))) *
          algebraMap Ω K (w s) = ∑ j, w (t j) • γ j := by
    intro ι' _ t γ z w
    have h1 : ∀ s, MvPolynomial.eval (algebraMap Ω K ∘ z)
        (MvPolynomial.pderiv s (∑ j, MvPolynomial.X (t j) * MvPolynomial.C (γ j))) =
        ∑ j, if t j = s then γ j else 0 := by
      intro s
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [mul_comm, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X, Pi.single_apply]
      split_ifs <;> simp
    simp only [h1, Finset.sum_mul, ite_mul, zero_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Finset.sum_ite_eq, if_pos (Finset.mem_univ _), Algebra.smul_def, mul_comm]

  set Pf : MvPolynomial ((ιF ⊕ ιA) ⊕ ιB) K :=
    ∑ j, MvPolynomial.X (Sum.inl (Sum.inl j)) * MvPolynomial.C (φ j) with hPf
  set Pa : MvPolynomial ((ιF ⊕ ιA) ⊕ ιB) K :=
    ∑ j, MvPolynomial.X (Sum.inl (Sum.inr j)) * MvPolynomial.C (α j) with hPa
  set Pb : MvPolynomial ((ιF ⊕ ιA) ⊕ ιB) K :=
    ∑ j, MvPolynomial.X (Sum.inr j) * MvPolynomial.C (β j) with hPb
  set P : MvPolynomial ((ιF ⊕ ιA) ⊕ ιB) K := Pa ^ ℓ - Pf * Pb with hPdef

  obtain ⟨m, b, F, hb, hP⟩ : ∃ (m : ℕ) (b : Fin m → K)
      (F : Fin m → MvPolynomial ((ιF ⊕ ιA) ⊕ ιB) Ω), LinearIndependent Ω b ∧
      P = ∑ i, MvPolynomial.C (b i) * MvPolynomial.map (algebraMap Ω K) (F i) := by
    let S := P.support
    let V := Submodule.span Ω ((fun n => P.coeff n) '' (S : Set _))
    haveI : FiniteDimensional Ω V :=
      FiniteDimensional.span_of_finite Ω ((Finset.finite_toSet S).image _)
    have hc : ∀ n, P.coeff n ∈ V := by
      intro n
      by_cases hn : n ∈ S
      · exact Submodule.subset_span ⟨n, hn, rfl⟩
      · rw [MvPolynomial.notMem_support_iff.mp hn]; exact V.zero_mem
    let bV := Module.finBasis Ω V
    refine ⟨Module.finrank Ω V, fun i => (bV i : K),
      fun i => ∑ n ∈ S, MvPolynomial.monomial n (bV.repr ⟨P.coeff n, hc n⟩ i), ?_, ?_⟩
    · exact bV.linearIndependent.map' V.subtype (Submodule.ker_subtype V)
    · ext n
      have hF : ∀ i : Fin (Module.finrank Ω V),
          (∑ n' ∈ S, MvPolynomial.monomial n'
            (bV.repr ⟨P.coeff n', hc n'⟩ i)).coeff n =
          if n ∈ S then bV.repr ⟨P.coeff n, hc n⟩ i else 0 := by
        intro i
        rw [MvPolynomial.coeff_sum]
        simp only [MvPolynomial.coeff_monomial]
        exact Finset.sum_ite_eq' S n (fun n' => bV.repr ⟨P.coeff n', hc n'⟩ i)
      rw [MvPolynomial.coeff_sum]
      rw [Finset.sum_congr rfl (fun i _ => by
        rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, hF i])]
      by_cases hn : n ∈ S
      · simp only [hn, ite_true]
        have h2 := congrArg Subtype.val (bV.sum_repr ⟨P.coeff n, hc n⟩)
        rw [Submodule.coe_sum] at h2
        simp only [Submodule.coe_smul, Algebra.smul_def] at h2
        refine Eq.trans h2.symm (Finset.sum_congr rfl (fun i _ => ?_))
        rw [mul_comm]
      · simp only [hn, ite_false, map_zero, mul_zero, Finset.sum_const_zero]
        exact MvPolynomial.notMem_support_iff.mp hn

  have hG1 : ∀ z : (ιF ⊕ ιA) ⊕ ιB → Ω, MvPolynomial.eval (algebraMap Ω K ∘ z) P =
      ∑ i, b i * algebraMap Ω K (MvPolynomial.eval z (F i)) := by
    intro z
    rw [hP, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_mul, MvPolynomial.eval_C, MvPolynomial.map_eval]
  have hG2 : ∀ z w : (ιF ⊕ ιA) ⊕ ιB → Ω,
      ∑ s, MvPolynomial.eval (algebraMap Ω K ∘ z) (MvPolynomial.pderiv s P) * algebraMap Ω K (w s) =
      ∑ i, b i * algebraMap Ω K
        (∑ s, MvPolynomial.eval z (MvPolynomial.pderiv s (F i)) * w s) := by
    intro z w
    rw [hP]
    simp only [map_sum, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_map, map_mul,
      MvPolynomial.eval_C, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun s _ => ?_))
    rw [← MvPolynomial.map_eval]
    ring
  have hD : ∀ z w : (ιF ⊕ ιA) ⊕ ιB → Ω,
      ∑ s, MvPolynomial.eval (algebraMap Ω K ∘ z) (MvPolynomial.pderiv s P) * algebraMap Ω K (w s) =
      (ℓ : K) * (MvPolynomial.eval (algebraMap Ω K ∘ z) Pa) ^ (ℓ - 1) *
        (∑ s, MvPolynomial.eval (algebraMap Ω K ∘ z) (MvPolynomial.pderiv s Pa) *
          algebraMap Ω K (w s)) -
      (MvPolynomial.eval (algebraMap Ω K ∘ z) Pf *
        (∑ s, MvPolynomial.eval (algebraMap Ω K ∘ z) (MvPolynomial.pderiv s Pb) *
          algebraMap Ω K (w s)) +
       MvPolynomial.eval (algebraMap Ω K ∘ z) Pb *
        (∑ s, MvPolynomial.eval (algebraMap Ω K ∘ z) (MvPolynomial.pderiv s Pf) *
          algebraMap Ω K (w s))) := by
    intro z w
    rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib,
      ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun s _ => ?_)
    rw [hPdef]
    simp only [map_sub, Derivation.leibniz, Derivation.leibniz_pow, smul_eq_mul, nsmul_eq_mul,
      map_add, map_mul, map_pow, map_natCast]
    ring
  have hLI : ∀ c : Fin m → Ω, (∑ i, b i * algebraMap Ω K (c i) = 0) ↔ ∀ i, c i = 0 := by
    intro c
    constructor
    · intro h
      apply Fintype.linearIndependent_iff.mp hb c
      rw [← h]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def, mul_comm]
    · intro h
      simp [h]
  refine ⟨m, F, fun z => ?_, fun z w => ?_⟩
  · refine (hLI _).symm.trans ?_
    rw [← hG1, hPdef, map_sub, map_pow, map_mul, hPa, hPf, hPb, hlinE, hlinE, hlinE, sub_eq_zero]
  · refine (hLI _).symm.trans ?_
    rw [← hG2, hD, hPa, hPf, hPb, hlinE, hlinE, hlinE, hlinD, hlinD, hlinD, sub_eq_zero]
    constructor <;> intro h <;> rw [h] <;> ring

theorem wc_bc_cone_chain (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (K : Type u) [Field K]
    [Algebra Ω K] (ℓ : ℕ) (hℓ : 0 < ℓ) (ιF ιA ιB : Type) [Fintype ιF] [Fintype ιA] [Fintype ιB]
    [DecidableEq ιF] [DecidableEq ιA] [DecidableEq ιB]
    (VF VA VB : Submodule Ω K) (bF : Module.Basis ιF Ω VF) (bA : Module.Basis ιA Ω VA)
    (bB : Module.Basis ιB Ω VB)
    (SE SG : Submodule Ω K) [FiniteDimensional Ω SE] [FiniteDimensional Ω SG]
    (f₀ a₀ b₀ : K) (hf₀ : f₀ ≠ 0) (hb₀ : b₀ ≠ 0) (hab : a₀ ^ ℓ = f₀ * b₀)
    (h1E : (1 : K) ∈ SE) (h1G : (1 : K) ∈ SG)
    (hconeF : ∀ h ∈ SE, h ^ ℓ * f₀ ∈ VF) (hconeA : ∀ h ∈ SE, ∀ k ∈ SG, h * k * a₀ ∈ VA)
    (hconeB : ∀ k ∈ SG, k ^ ℓ * b₀ ∈ VB)
    (m : ℕ) (F : Fin m → MvPolynomial ((ιF ⊕ ιA) ⊕ ιB) Ω)
    (hF : ∀ z : (ιF ⊕ ιA) ⊕ ιB → Ω,
      (∑ j, z (Sum.inl (Sum.inr j)) • (bA j : K)) ^ ℓ =
        (∑ j, z (Sum.inl (Sum.inl j)) • (bF j : K)) * ∑ j, z (Sum.inr j) • (bB j : K) →
      ∀ i, MvPolynomial.eval z (F i) = 0) :
    ∃ (z : (ιF ⊕ ιA) ⊕ ιB → Ω)
      (c : Fin (Module.finrank Ω SE + Module.finrank Ω SG + 1) →
        PrimeSpectrum (MvPolynomial ((ιF ⊕ ιA) ⊕ ιB) Ω)),
      ∑ j, z (Sum.inl (Sum.inl j)) • (bF j : K) = f₀ ∧
      ∑ j, z (Sum.inl (Sum.inr j)) • (bA j : K) = a₀ ∧
      ∑ j, z (Sum.inr j) • (bB j : K) = b₀ ∧
      StrictMono c ∧ Ideal.span (Set.range F) ≤ (c 0).asIdeal ∧
      (c (Fin.last _)).asIdeal = RingHom.ker (MvPolynomial.eval z) ∧
      ∀ w : (ιF ⊕ ιA) ⊕ ιB → Ω, (c 0).asIdeal ≤ RingHom.ker (MvPolynomial.eval w) →
        ∃ h ∈ SE, ∑ j, w (Sum.inl (Sum.inl j)) • (bF j : K) = h ^ ℓ * f₀ :=
by
  classical
  haveI : Infinite Ω := IsAlgClosed.instInfinite



  have s1 : ∀ (τ ι : Type) [Fintype ι] (V : Submodule Ω K) (b : Module.Basis ι Ω V)
      (P : MvPolynomial τ K), (∀ y : τ → Ω, MvPolynomial.eval (algebraMap Ω K ∘ y) P ∈ V) →
      ∃ Q : ι → MvPolynomial τ Ω,
        (∀ y : τ → Ω, ∑ i, MvPolynomial.eval y (Q i) • (b i : K) =
          MvPolynomial.eval (algebraMap Ω K ∘ y) P) ∧
        ∀ e : ℕ, P.IsHomogeneous e → ∀ i, (Q i).IsHomogeneous e := by
    intro τ ι _ V b P hP
    obtain ⟨W, hW⟩ := Submodule.exists_isCompl V
    let π : K →ₗ[Ω] V := Submodule.linearProjOfIsCompl V W hW
    have hπ : ∀ v : V, π v = v := fun v => Submodule.linearProjOfIsCompl_apply_left hW v
    let L : ι → K →ₗ[Ω] Ω := fun i => (b.coord i).comp π
    have hL : ∀ x : K, ∑ i, L i x • (b i : K) = (π x : K) := by
      intro x
      have h := congrArg Subtype.val (b.sum_repr (π x))
      rw [Submodule.coe_sum] at h
      simp only [Submodule.coe_smul] at h
      exact h
    refine ⟨fun i => ∑ d ∈ P.support, MvPolynomial.monomial d (L i (P.coeff d)), ?_, ?_⟩
    · intro y
      have hmp : ∀ d : τ →₀ ℕ, (algebraMap Ω K) (d.prod fun n k => y n ^ k) =
          d.prod fun n k => (algebraMap Ω K ∘ y) n ^ k := by
        intro d
        simp [Finsupp.prod, map_prod, map_pow]
      have hev : MvPolynomial.eval (algebraMap Ω K ∘ y) P =
          ∑ d ∈ P.support, (d.prod fun n k => y n ^ k) • P.coeff d := by
        conv_lhs => rw [MvPolynomial.as_sum P]
        rw [map_sum]
        apply Finset.sum_congr rfl
        intro d _
        rw [MvPolynomial.eval_monomial, Algebra.smul_def, mul_comm, hmp]
      have hπev : ((π (MvPolynomial.eval (algebraMap Ω K ∘ y) P) : V) : K) =
          MvPolynomial.eval (algebraMap Ω K ∘ y) P :=
        congrArg Subtype.val (hπ ⟨_, hP y⟩)
      calc ∑ i, MvPolynomial.eval y (∑ d ∈ P.support, MvPolynomial.monomial d (L i (P.coeff d)))
              • (b i : K)
          = ∑ i, ∑ d ∈ P.support, (d.prod fun n k => y n ^ k) • (L i (P.coeff d) • (b i : K)) := by
            apply Finset.sum_congr rfl
            intro i _
            rw [map_sum, Finset.sum_smul]
            apply Finset.sum_congr rfl
            intro d _
            rw [MvPolynomial.eval_monomial, mul_comm, mul_smul]
        _ = ∑ d ∈ P.support, (d.prod fun n k => y n ^ k) • ∑ i, L i (P.coeff d) • (b i : K) := by
            rw [Finset.sum_comm]
            simp only [Finset.smul_sum]
        _ = ∑ d ∈ P.support, (d.prod fun n k => y n ^ k) • (π (P.coeff d) : K) := by
            simp only [hL]
        _ = ((π (∑ d ∈ P.support, (d.prod fun n k => y n ^ k) • P.coeff d) : V) : K) := by
            rw [map_sum, Submodule.coe_sum]
            simp only [map_smul, Submodule.coe_smul]
        _ = _ := by rw [← hev, hπev]
    · intro e he i
      apply MvPolynomial.IsHomogeneous.sum
      intro d hd
      exact MvPolynomial.isHomogeneous_monomial _
        (by rw [Finsupp.degree_eq_weight_one]; exact he (MvPolynomial.mem_support_iff.mp hd))



  have s2 : ∀ (σ σ' : Type) [Fintype σ'] (Φ : σ → MvPolynomial σ' Ω),
      (∀ y : σ' → Ω, (∀ i, MvPolynomial.eval y (Φ i) = 0) → y = 0) →
      ∃ N : ℕ, ∀ j : σ', MvPolynomial.X j ^ N ∈ Ideal.span (Set.range Φ) := by
    intro σ σ' _ Φ hzero
    have hrad : ∀ j : σ', MvPolynomial.X j ∈ (Ideal.span (Set.range Φ)).radical := by
      intro j
      rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (K := Ω)]
      have hsub : MvPolynomial.zeroLocus Ω (Ideal.span (Set.range Φ)) ⊆ {0} := by
        intro x hx
        rw [MvPolynomial.mem_zeroLocus_iff] at hx
        rw [Set.mem_singleton_iff]
        apply hzero
        intro i
        exact hx (Φ i) (Ideal.subset_span ⟨i, rfl⟩)
      apply MvPolynomial.vanishingIdeal_anti_mono hsub
      rw [MvPolynomial.mem_vanishingIdeal_singleton_iff, MvPolynomial.aeval_X]
      rfl
    choose n hn using hrad
    refine ⟨Finset.univ.sup n, fun j => ?_⟩
    have hle : n j ≤ Finset.univ.sup n := Finset.le_sup (Finset.mem_univ j)
    rw [← Nat.sub_add_cancel hle, pow_add]
    exact Ideal.mul_mem_left _ _ (hn j)



  have s3 : ∀ (σ σ' : Type) [Fintype σ] [Fintype σ'] [DecidableEq σ']
      (Φ : σ → MvPolynomial σ' Ω) (e : σ → ℕ), (∀ i, 1 ≤ e i) →
      (∀ i, (Φ i).IsHomogeneous (e i)) → ∀ (N : ℕ),
      (∀ j, MvPolynomial.X j ^ N ∈ Ideal.span (Set.range Φ)) →
      (MvPolynomial.aeval (R := Ω) Φ).toRingHom.Finite := by
    intro σ σ' _ _ _ Φ e he hhom N hN
    have HC : ∀ (ψ : MvPolynomial σ' Ω) (k n : ℕ), ψ.IsHomogeneous k →
        ∀ c : MvPolynomial σ' Ω, MvPolynomial.homogeneousComponent n (c * ψ) =
          (if k ≤ n then MvPolynomial.homogeneousComponent (n - k) c else 0) * ψ := by
      intro ψ k n hψ c
      induction c using MvPolynomial.induction_on' with
      | monomial d a =>
        obtain ⟨D, hD⟩ : ∃ D, (MvPolynomial.monomial d a).IsHomogeneous D :=
          ⟨_, MvPolynomial.isHomogeneous_monomial a rfl⟩
        rw [MvPolynomial.homogeneousComponent_of_mem (m := n)
            (by rw [MvPolynomial.mem_homogeneousSubmodule]; exact hD.mul hψ),
          MvPolynomial.homogeneousComponent_of_mem (m := n - k)
            (by rw [MvPolynomial.mem_homogeneousSubmodule]; exact hD)]
        split_ifs <;> first | omega | rfl | simp
      | add p q hp hq =>
        rw [add_mul, map_add, hp, hq]
        split_ifs <;> simp [add_mul]
    have hrep : ∀ j, ∃ g : σ → MvPolynomial σ' Ω, MvPolynomial.X j ^ N = ∑ i, g i * Φ i ∧
        (∀ i, (g i).IsHomogeneous (N - e i)) ∧ (∀ i, N < e i → g i = 0) := by
      intro j
      obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp (hN j)
      refine ⟨fun i => if e i ≤ N then MvPolynomial.homogeneousComponent (N - e i) (c i) else 0,
        ?_, ?_, ?_⟩
      · have hXh : (MvPolynomial.X j ^ N : MvPolynomial σ' Ω).IsHomogeneous N := by
          have := (MvPolynomial.isHomogeneous_X Ω j).pow N
          rwa [one_mul] at this
        have h1 : MvPolynomial.homogeneousComponent N (MvPolynomial.X j ^ N : MvPolynomial σ' Ω) =
            MvPolynomial.X j ^ N := by
          rw [MvPolynomial.homogeneousComponent_of_mem
            (by rw [MvPolynomial.mem_homogeneousSubmodule]; exact hXh), if_pos rfl]
        rw [← h1, ← hc, map_sum]
        apply Finset.sum_congr rfl
        intro i _
        rw [HC (Φ i) (e i) N (hhom i) (c i)]
      · intro i
        dsimp only
        split_ifs
        · exact MvPolynomial.homogeneousComponent_isHomogeneous _ _
        · exact MvPolynomial.isHomogeneous_zero _ _ _
      · intro i hi
        dsimp only
        rw [if_neg (by omega)]
    letI : Algebra (MvPolynomial σ Ω) (MvPolynomial σ' Ω) :=
      (MvPolynomial.aeval (R := Ω) Φ).toRingHom.toAlgebra
    show Module.Finite (MvPolynomial σ Ω) (MvPolynomial σ' Ω)
    let S : Finset (MvPolynomial σ' Ω) := Finset.univ.image (fun m : σ' → Fin N =>
      MvPolynomial.monomial (Finsupp.equivFunOnFinite.symm (fun j => (m j : ℕ))) (1 : Ω))
    let M₀ : Submodule (MvPolynomial σ Ω) (MvPolynomial σ' Ω) := Submodule.span _ (S : Set _)
    have key : ∀ n, ∀ p : MvPolynomial σ' Ω, p.IsHomogeneous n → p ∈ M₀ := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n IH =>
        have hmon : ∀ d : σ' →₀ ℕ, (MvPolynomial.monomial d (1 : Ω)).IsHomogeneous n →
            MvPolynomial.monomial d (1 : Ω) ∈ M₀ := by
          intro d hd
          by_cases hsmall : ∀ j, d j < N
          · apply Submodule.subset_span
            rw [Finset.mem_coe, Finset.mem_image]
            refine ⟨fun j => ⟨d j, hsmall j⟩, Finset.mem_univ _, ?_⟩
            congr 1
            ext j
            simp
          · push_neg at hsmall
            obtain ⟨j, hj⟩ := hsmall
            obtain ⟨g, hg, hgh, hg0⟩ := hrep j
            have hdd : d = (d - Finsupp.single j N) + Finsupp.single j N :=
              (tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr hj)).symm
            have hsplit : MvPolynomial.monomial d (1 : Ω) =
                MvPolynomial.monomial (d - Finsupp.single j N) (1 : Ω) *
                  MvPolynomial.X j ^ N := by
              rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul, one_mul, ← hdd]
            obtain ⟨D', hD'⟩ : ∃ D', (MvPolynomial.monomial (d - Finsupp.single j N)
                (1 : Ω)).IsHomogeneous D' :=
              ⟨_, MvPolynomial.isHomogeneous_monomial _ rfl⟩
            have hn : D' + N = n := by
              have hX := (MvPolynomial.isHomogeneous_X Ω j).pow N
              rw [one_mul] at hX
              have h1 : (MvPolynomial.monomial d (1 : Ω)).IsHomogeneous (D' + N) := by
                rw [hsplit]
                exact hD'.mul hX
              exact h1.inj_right hd (fun h => one_ne_zero (MvPolynomial.monomial_eq_zero.mp h))
            rw [hsplit, hg, Finset.mul_sum]
            apply Submodule.sum_mem
            intro i _
            by_cases hei : N < e i
            · rw [hg0 i hei, zero_mul, mul_zero]
              exact Submodule.zero_mem _
            · push_neg at hei
              have hq : (MvPolynomial.monomial (d - Finsupp.single j N) (1 : Ω) *
                  g i).IsHomogeneous (D' + (N - e i)) := hD'.mul (hgh i)
              have hlt : D' + (N - e i) < n := by
                have := he i
                omega
              have hqM := IH _ hlt _ hq
              have hsm : MvPolynomial.monomial (d - Finsupp.single j N) (1 : Ω) * (g i * Φ i) =
                  (MvPolynomial.X i : MvPolynomial σ Ω) •
                    (MvPolynomial.monomial (d - Finsupp.single j N) (1 : Ω) * g i) := by
                rw [Algebra.smul_def]
                show _ = MvPolynomial.aeval (R := Ω) Φ (MvPolynomial.X i) * _
                rw [MvPolynomial.aeval_X]
                ring
              rw [hsm]
              exact Submodule.smul_mem _ _ hqM
        intro p hp
        rw [MvPolynomial.as_sum p]
        apply Submodule.sum_mem
        intro d hd
        have hcd : p.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        have hmono : (MvPolynomial.monomial d (1 : Ω)).IsHomogeneous n :=
          MvPolynomial.isHomogeneous_monomial _
            (by rw [Finsupp.degree_eq_weight_one]; exact hp hcd)
        have hsm : MvPolynomial.monomial d (p.coeff d) =
            (MvPolynomial.C (p.coeff d) : MvPolynomial σ Ω) •
              MvPolynomial.monomial d (1 : Ω) := by
          rw [Algebra.smul_def]
          show _ = MvPolynomial.aeval (R := Ω) Φ (MvPolynomial.C _) * _
          rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, MvPolynomial.C_mul_monomial,
            mul_one]
        rw [hsm]
        exact Submodule.smul_mem _ _ (hmon d hmono)
    have htop : ∀ p, p ∈ M₀ := by
      intro p
      rw [← MvPolynomial.sum_homogeneousComponent p]
      exact Submodule.sum_mem _
        (fun k _ => key k _ (MvPolynomial.homogeneousComponent_isHomogeneous k p))
    exact ⟨⟨S, eq_top_iff.mpr (fun p _ => htop p)⟩⟩



  have s4 : ∀ (σ σ' : Type) [Fintype σ'] (Φ : σ → MvPolynomial σ' Ω),
      (MvPolynomial.aeval (R := Ω) Φ).toRingHom.IsIntegral →
      (∀ (y : σ' → Ω) (p : MvPolynomial σ Ω), MvPolynomial.eval y (MvPolynomial.aeval Φ p) =
        MvPolynomial.eval (fun i => MvPolynomial.eval y (Φ i)) p) ∧
      (∀ P Q : Ideal (MvPolynomial σ' Ω), P.IsPrime → P < Q →
        Ideal.comap (MvPolynomial.aeval (R := Ω) Φ) P <
          Ideal.comap (MvPolynomial.aeval (R := Ω) Φ) Q) ∧
      (∀ m : Ideal (MvPolynomial σ Ω), m.IsMaximal →
        RingHom.ker (MvPolynomial.aeval (R := Ω) Φ) ≤ m →
        ∃ y : σ' → Ω,
          m = RingHom.ker (MvPolynomial.eval (fun i => MvPolynomial.eval y (Φ i)))) := by
    intro σ σ' _ Φ hint
    have ha : ∀ (y : σ' → Ω) (p : MvPolynomial σ Ω),
        MvPolynomial.eval y (MvPolynomial.aeval Φ p) =
        MvPolynomial.eval (fun i => MvPolynomial.eval y (Φ i)) p := by
      intro y p
      induction p using MvPolynomial.induction_on with
      | C a => rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq, MvPolynomial.eval_C,
          MvPolynomial.eval_C]
      | add p q hp hq => rw [map_add, map_add, hp, hq, map_add]
      | mul_X p i hp => rw [map_mul, map_mul, hp, MvPolynomial.aeval_X, map_mul,
          MvPolynomial.eval_X]
    letI : Algebra (MvPolynomial σ Ω) (MvPolynomial σ' Ω) :=
      (MvPolynomial.aeval (R := Ω) Φ).toRingHom.toAlgebra
    haveI : Algebra.IsIntegral (MvPolynomial σ Ω) (MvPolynomial σ' Ω) :=
      algebraMap_isIntegral_iff.mp hint
    refine ⟨ha, ?_, ?_⟩
    · intro P Q hP hPQ
      exact Ideal.IsIntegral.under_lt_under (R := MvPolynomial σ Ω) hPQ
    · intro m hm hker
      obtain ⟨M, hM, hMm⟩ := Ideal.exists_ideal_over_maximal_of_isIntegral
        (S := MvPolynomial σ' Ω) m hker
      obtain ⟨y, hy⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hM
      refine ⟨y, ?_⟩
      rw [← hMm]
      ext p
      rw [Ideal.under_def, Ideal.mem_comap, hy, MvPolynomial.mem_vanishingIdeal_singleton_iff,
        RingHom.mem_ker]
      change MvPolynomial.eval y (MvPolynomial.aeval Φ p) = 0 ↔ _
      rw [ha]



  have s5 : ∀ (σ' : Type) [Fintype σ'] [DecidableEq σ'] (y₀ : σ' → Ω),
      ∃ c : Fin (Fintype.card σ' + 1) → PrimeSpectrum (MvPolynomial σ' Ω),
        StrictMono c ∧ (c 0).asIdeal = ⊥ ∧
        (c (Fin.last _)).asIdeal = RingHom.ker (MvPolynomial.eval y₀) := by
    intro σ' _ _ y₀
    let ε := Fintype.equivFin σ'
    let ψ : ℕ → MvPolynomial σ' Ω →ₐ[Ω] MvPolynomial σ' Ω := fun t =>
      MvPolynomial.aeval
        (fun j => if ((ε j : ℕ) < t) then MvPolynomial.C (y₀ j) else MvPolynomial.X j)
    let c : Fin (Fintype.card σ' + 1) → PrimeSpectrum (MvPolynomial σ' Ω) := fun t =>
      ⟨RingHom.ker (ψ t), RingHom.ker_isPrime _⟩
    have hcomp : ∀ t, (ψ (t+1)).comp (ψ t) = ψ (t+1) := by
      intro t
      apply MvPolynomial.algHom_ext
      intro j
      simp only [AlgHom.comp_apply, ψ, MvPolynomial.aeval_X]
      by_cases h : (ε j : ℕ) < t
      · have h' : (ε j : ℕ) < t + 1 := by omega
        simp [h, h']
      · simp [h]
    have hle : ∀ t, RingHom.ker (ψ t) ≤ RingHom.ker (ψ (t+1)) := by
      intro t p hp
      rw [RingHom.mem_ker] at hp ⊢
      rw [← hcomp t, AlgHom.comp_apply, hp, map_zero]
    have hlt : ∀ t, t < Fintype.card σ' → RingHom.ker (ψ t) < RingHom.ker (ψ (t+1)) := by
      intro t ht
      rw [SetLike.lt_iff_le_and_exists]
      refine ⟨hle t, ?_⟩
      let j := ε.symm ⟨t, ht⟩
      have hj : (ε j : ℕ) = t := by simp [j]
      refine ⟨MvPolynomial.X j - MvPolynomial.C (y₀ j), ?_, ?_⟩
      · rw [RingHom.mem_ker, map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
        have h' : (ε j : ℕ) < t + 1 := by omega
        simp [h']
      · rw [RingHom.mem_ker, map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
        have h' : ¬ (ε j : ℕ) < t := by omega
        simp only [h', if_false, MvPolynomial.algebraMap_eq]
        intro h
        have := congrArg (MvPolynomial.eval (fun _ => y₀ j + 1)) h
        simp at this
    refine ⟨c, ?_, ?_, ?_⟩
    · rw [Fin.strictMono_iff_lt_succ]
      intro i
      apply (PrimeSpectrum.asIdeal_lt_asIdeal _ _).mp
      show RingHom.ker (ψ (i.castSucc : ℕ)) < RingHom.ker (ψ (i.succ : ℕ))
      rw [Fin.coe_castSucc, Fin.val_succ]
      exact hlt i i.isLt
    · show RingHom.ker (ψ ((0 : Fin (Fintype.card σ' + 1)) : ℕ)) = ⊥
      have h0 : ψ ((0 : Fin (Fintype.card σ' + 1)) : ℕ) = AlgHom.id Ω _ := by
        apply MvPolynomial.algHom_ext
        intro j
        simp [ψ]
      rw [h0]
      ext p
      simp [RingHom.mem_ker]
    · show RingHom.ker (ψ ((Fin.last (Fintype.card σ')) : ℕ)) = _
      have hr : ψ ((Fin.last (Fintype.card σ')) : ℕ) =
          (Algebra.ofId Ω (MvPolynomial σ' Ω)).comp (MvPolynomial.aeval y₀) := by
        apply MvPolynomial.algHom_ext
        intro j
        simp [ψ]
      rw [hr]
      ext p
      simp only [RingHom.mem_ker, AlgHom.comp_apply, Algebra.ofId_apply,
        MvPolynomial.algebraMap_eq, MvPolynomial.C_eq_zero]
      rfl



  let eE := Module.finBasis Ω SE
  let eG := Module.finBasis Ω SG
  let hE : (Fin (Module.finrank Ω SE) ⊕ Fin (Module.finrank Ω SG) → Ω) → K :=
    fun y => ∑ i, y (Sum.inl i) • (eE i : K)
  let kG : (Fin (Module.finrank Ω SE) ⊕ Fin (Module.finrank Ω SG) → Ω) → K :=
    fun y => ∑ i, y (Sum.inr i) • (eG i : K)
  have hEmem : ∀ y, hE y ∈ SE := fun y =>
    Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (eE i).2)
  have kGmem : ∀ y, kG y ∈ SG := fun y =>
    Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (eG i).2)
  let H : MvPolynomial (Fin (Module.finrank Ω SE) ⊕ Fin (Module.finrank Ω SG)) K :=
    ∑ i, MvPolynomial.X (Sum.inl i) * MvPolynomial.C (eE i : K)
  let Kp : MvPolynomial (Fin (Module.finrank Ω SE) ⊕ Fin (Module.finrank Ω SG)) K :=
    ∑ i, MvPolynomial.X (Sum.inr i) * MvPolynomial.C (eG i : K)
  have evH : ∀ y, MvPolynomial.eval (algebraMap Ω K ∘ y) H = hE y := by
    intro y
    simp only [H, hE, map_sum, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_C,
      Function.comp_apply, Algebra.smul_def]
  have evK : ∀ y, MvPolynomial.eval (algebraMap Ω K ∘ y) Kp = kG y := by
    intro y
    simp only [Kp, kG, map_sum, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_C,
      Function.comp_apply, Algebra.smul_def]
  have homH : H.IsHomogeneous 1 := by
    apply MvPolynomial.IsHomogeneous.sum
    intro i _
    simpa using (MvPolynomial.isHomogeneous_X K (Sum.inl i)).mul
      (MvPolynomial.isHomogeneous_C _ (eE i : K))
  have homK : Kp.IsHomogeneous 1 := by
    apply MvPolynomial.IsHomogeneous.sum
    intro i _
    simpa using (MvPolynomial.isHomogeneous_X K (Sum.inr i)).mul
      (MvPolynomial.isHomogeneous_C _ (eG i : K))
  obtain ⟨QF, hQF, hQFh⟩ := s1 _ ιF VF bF
    (H ^ ℓ * MvPolynomial.C f₀) (by
      intro y
      rw [map_mul, map_pow, evH, MvPolynomial.eval_C]
      exact hconeF _ (hEmem y))
  obtain ⟨QA, hQA, hQAh⟩ := s1 _ ιA VA bA
    (H * Kp * MvPolynomial.C a₀) (by
      intro y
      rw [map_mul, map_mul, evH, evK, MvPolynomial.eval_C]
      exact hconeA _ (hEmem y) _ (kGmem y))
  obtain ⟨QB, hQB, hQBh⟩ := s1 _ ιB VB bB
    (Kp ^ ℓ * MvPolynomial.C b₀) (by
      intro y
      rw [map_mul, map_pow, evK, MvPolynomial.eval_C]
      exact hconeB _ (kGmem y))
  have hFh : ∀ j, (QF j).IsHomogeneous ℓ := hQFh ℓ (by
    simpa using (homH.pow ℓ).mul (MvPolynomial.isHomogeneous_C _ f₀))
  have hAh : ∀ j, (QA j).IsHomogeneous 2 := hQAh 2 (by
    simpa using (homH.mul homK).mul (MvPolynomial.isHomogeneous_C _ a₀))
  have hBh : ∀ j, (QB j).IsHomogeneous ℓ := hQBh ℓ (by
    simpa using (homK.pow ℓ).mul (MvPolynomial.isHomogeneous_C _ b₀))
  let Φ : (ιF ⊕ ιA) ⊕ ιB →
      MvPolynomial (Fin (Module.finrank Ω SE) ⊕ Fin (Module.finrank Ω SG)) Ω :=
    Sum.elim (Sum.elim QF QA) QB
  let e : (ιF ⊕ ιA) ⊕ ιB → ℕ := Sum.elim (Sum.elim (fun _ => ℓ) (fun _ => 2)) (fun _ => ℓ)
  have he : ∀ s, 1 ≤ e s := by
    rintro ((s | s) | s)
    · exact hℓ
    · show 1 ≤ 2
      omega
    · exact hℓ
  have hhom : ∀ s, (Φ s).IsHomogeneous (e s) := by
    rintro ((s | s) | s)
    · exact hFh s
    · exact hAh s
    · exact hBh s
  let Φy : (Fin (Module.finrank Ω SE) ⊕ Fin (Module.finrank Ω SG) → Ω) → (ιF ⊕ ιA) ⊕ ιB → Ω :=
    fun y s => MvPolynomial.eval y (Φ s)
  have coneF : ∀ y, ∑ j, Φy y (Sum.inl (Sum.inl j)) • (bF j : K) = hE y ^ ℓ * f₀ := by
    intro y
    have h := hQF y
    rw [map_mul, map_pow, evH, MvPolynomial.eval_C] at h
    exact h
  have coneA : ∀ y, ∑ j, Φy y (Sum.inl (Sum.inr j)) • (bA j : K) = hE y * kG y * a₀ := by
    intro y
    have h := hQA y
    rw [map_mul, map_mul, evH, evK, MvPolynomial.eval_C] at h
    exact h
  have coneB : ∀ y, ∑ j, Φy y (Sum.inr j) • (bB j : K) = kG y ^ ℓ * b₀ := by
    intro y
    have h := hQB y
    rw [map_mul, map_pow, evK, MvPolynomial.eval_C] at h
    exact h
  have hzero : ∀ y : Fin (Module.finrank Ω SE) ⊕ Fin (Module.finrank Ω SG) → Ω,
      (∀ s, MvPolynomial.eval y (Φ s) = 0) → y = 0 := by
    intro y hy
    have h1 : hE y ^ ℓ * f₀ = 0 := by
      rw [← coneF y]
      apply Finset.sum_eq_zero
      intro j _
      rw [show Φy y (Sum.inl (Sum.inl j)) = 0 from hy _, zero_smul]
    have h2 : kG y ^ ℓ * b₀ = 0 := by
      rw [← coneB y]
      apply Finset.sum_eq_zero
      intro j _
      rw [show Φy y (Sum.inr j) = 0 from hy _, zero_smul]
    have h1' : hE y = 0 :=
      (pow_eq_zero_iff (by omega)).mp ((mul_eq_zero.mp h1).resolve_right hf₀)
    have h2' : kG y = 0 :=
      (pow_eq_zero_iff (by omega)).mp ((mul_eq_zero.mp h2).resolve_right hb₀)
    have liE : LinearIndependent Ω (SE.subtype ∘ eE) :=
      eE.linearIndependent.map' SE.subtype (Submodule.ker_subtype SE)
    have liG : LinearIndependent Ω (SG.subtype ∘ eG) :=
      eG.linearIndependent.map' SG.subtype (Submodule.ker_subtype SG)
    have yE := Fintype.linearIndependent_iff.mp liE (fun i => y (Sum.inl i)) h1'
    have yG := Fintype.linearIndependent_iff.mp liG (fun i => y (Sum.inr i)) h2'
    funext s
    rcases s with s | s
    · exact yE s
    · exact yG s
  obtain ⟨N, hN⟩ := s2 _ _ Φ hzero
  have hfin := s3 _ _ Φ e he hhom N hN
  obtain ⟨sa, sb, sc⟩ := s4 _ _ Φ hfin.to_isIntegral
  let y₀ : Fin (Module.finrank Ω SE) ⊕ Fin (Module.finrank Ω SG) → Ω :=
    Sum.elim (fun i => eE.repr ⟨1, h1E⟩ i) (fun i => eG.repr ⟨1, h1G⟩ i)
  have hy0E : hE y₀ = 1 := by
    have h := congrArg Subtype.val (eE.sum_repr ⟨1, h1E⟩)
    rw [Submodule.coe_sum] at h
    simp only [Submodule.coe_smul] at h
    exact h
  have hy0G : kG y₀ = 1 := by
    have h := congrArg Subtype.val (eG.sum_repr ⟨1, h1G⟩)
    rw [Submodule.coe_sum] at h
    simp only [Submodule.coe_smul] at h
    exact h
  obtain ⟨c', hc'mono, hc'0, hc'last⟩ := s5 _ y₀
  have hcast : Module.finrank Ω SE + Module.finrank Ω SG + 1 =
      Fintype.card (Fin (Module.finrank Ω SE) ⊕ Fin (Module.finrank Ω SG)) + 1 := by simp
  let c : Fin (Module.finrank Ω SE + Module.finrank Ω SG + 1) →
      PrimeSpectrum (MvPolynomial ((ιF ⊕ ιA) ⊕ ιB) Ω) := fun t =>
    ⟨Ideal.comap (MvPolynomial.aeval (R := Ω) Φ) (c' (Fin.cast hcast t)).asIdeal, inferInstance⟩
  have hcmono : StrictMono c := by
    intro a b hab
    have h1 : c' (Fin.cast hcast a) < c' (Fin.cast hcast b) := hc'mono hab
    exact (PrimeSpectrum.asIdeal_lt_asIdeal _ _).mp
      (sb _ _ inferInstance ((PrimeSpectrum.asIdeal_lt_asIdeal _ _).mpr h1))
  have hc0 : (c 0).asIdeal = RingHom.ker (MvPolynomial.aeval (R := Ω) Φ) := by
    show Ideal.comap _ (c' (Fin.cast hcast 0)).asIdeal = _
    have h0 : Fin.cast hcast (0 : Fin (Module.finrank Ω SE + Module.finrank Ω SG + 1)) = 0 := by
      ext
      simp
    rw [h0, hc'0]
    exact (RingHom.ker_eq_comap_bot _).symm
  have hclast : (c (Fin.last _)).asIdeal = RingHom.ker (MvPolynomial.eval (Φy y₀)) := by
    show Ideal.comap _ (c' (Fin.cast hcast (Fin.last _))).asIdeal = _
    rw [Fin.cast_last, hc'last]
    ext p
    simp only [Ideal.mem_comap, RingHom.mem_ker]
    rw [sa]
  have hFker : Ideal.span (Set.range F) ≤ (c 0).asIdeal := by
    rw [hc0, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    apply MvPolynomial.funext
    intro y
    rw [sa, map_zero]
    refine hF (Φy y) ?_ i
    rw [coneA y, coneF y, coneB y, mul_pow, mul_pow, hab]
    ring
  refine ⟨Φy y₀, c, ?_, ?_, ?_, hcmono, hFker, hclast, ?_⟩
  · rw [coneF, hy0E, one_pow, one_mul]
  · rw [coneA, hy0E, hy0G, one_mul, one_mul]
  · rw [coneB, hy0G, one_pow, one_mul]
  · intro w hw
    rw [hc0] at hw
    have hmax : (RingHom.ker (MvPolynomial.eval w)).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective _ (fun a => ⟨MvPolynomial.C a, MvPolynomial.eval_C _⟩)
    obtain ⟨y, hy⟩ := sc _ hmax hw
    have hwy : w = Φy y := by
      funext s
      have h1 : MvPolynomial.X s - MvPolynomial.C (w s) ∈ RingHom.ker (MvPolynomial.eval w) := by
        simp [RingHom.mem_ker]
      rw [hy] at h1
      simp only [RingHom.mem_ker, map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C,
        sub_eq_zero] at h1
      exact h1.symm
    refine ⟨hE y, hEmem y, ?_⟩
    rw [hwy]
    exact coneF y

theorem wc_param_height_le_tangent_maps (Ω : Type u) [Field Ω] (σ : Type) [Fintype σ]
    [DecidableEq σ] (m : ℕ) (F : Fin m → MvPolynomial σ Ω) (z : σ → Ω)
    (hz : ∀ i, MvPolynomial.eval z (F i) = 0)
    (ME MG : Type u) [AddCommGroup ME] [Module Ω ME] [AddCommGroup MG] [Module Ω MG]
    (gE : (σ → Ω) →ₗ[Ω] ME) (gG : (σ → Ω) →ₗ[Ω] MG)
    (WE : Submodule Ω ME) (WG : Submodule Ω MG) [FiniteDimensional Ω WE] [FiniteDimensional Ω WG]
    (htan : ∀ v : σ → Ω, (∀ i, ∑ s, MvPolynomial.eval z (MvPolynomial.pderiv s (F i)) * v s = 0) →
      gE v ∈ WE ∧ gG v ∈ WG ∧ (gE v = 0 → gG v = 0 → v = 0)) :
    (Ideal.map (Ideal.Quotient.mk (Ideal.span (Set.range F)))
      (RingHom.ker (MvPolynomial.eval z))).height ≤
      ((Module.finrank Ω WE + Module.finrank Ω WG : ℕ) : ℕ∞) :=
by
  classical

  have s1 : ∀ p : MvPolynomial σ Ω, p - MvPolynomial.C (MvPolynomial.eval z p) -
      ∑ s, MvPolynomial.C (MvPolynomial.eval z (MvPolynomial.pderiv s p)) *
        (MvPolynomial.X s - MvPolynomial.C (z s)) ∈
      RingHom.ker (MvPolynomial.eval z) * RingHom.ker (MvPolynomial.eval z) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
      have := Ideal.add_mem _ hp hq
      convert this using 1
      simp only [map_add, add_mul, Finset.sum_add_distrib]
      ring
    | mul_X p n hp =>
      have hsum : ∀ s, MvPolynomial.C (MvPolynomial.eval z
            (MvPolynomial.pderiv s (p * MvPolynomial.X n))) *
            (MvPolynomial.X s - MvPolynomial.C (z s)) =
          MvPolynomial.C (z n) * (MvPolynomial.C (MvPolynomial.eval z (MvPolynomial.pderiv s p)) *
            (MvPolynomial.X s - MvPolynomial.C (z s))) +
          (if n = s then MvPolynomial.C (MvPolynomial.eval z p) *
            (MvPolynomial.X n - MvPolynomial.C (z n)) else 0) := by
        intro s
        rw [Derivation.leibniz, MvPolynomial.pderiv_X]
        by_cases h : n = s
        · subst h
          simp only [Pi.single_eq_same, smul_eq_mul, map_add, map_mul, MvPolynomial.eval_X,
            map_one, mul_one, if_true]
          ring
        · simp only [Pi.single_apply, h, if_false, smul_eq_mul, map_add, map_mul,
            MvPolynomial.eval_X, map_zero, mul_zero, add_zero, Ne.symm h]
          ring
      rw [Finset.sum_congr rfl (fun s _ => hsum s), Finset.sum_add_distrib, ← Finset.mul_sum,
        Finset.sum_ite_eq]
      simp only [Finset.mem_univ, if_true, MvPolynomial.eval_mul, MvPolynomial.eval_X, map_mul]
      have e : p * MvPolynomial.X n - MvPolynomial.C (MvPolynomial.eval z p) * MvPolynomial.C (z n) -
          (MvPolynomial.C (z n) * ∑ s, MvPolynomial.C (MvPolynomial.eval z (MvPolynomial.pderiv s p)) *
            (MvPolynomial.X s - MvPolynomial.C (z s)) +
          MvPolynomial.C (MvPolynomial.eval z p) * (MvPolynomial.X n - MvPolynomial.C (z n))) =
          (p - MvPolynomial.C (MvPolynomial.eval z p)) * (MvPolynomial.X n - MvPolynomial.C (z n)) +
          MvPolynomial.C (z n) * (p - MvPolynomial.C (MvPolynomial.eval z p) -
            ∑ s, MvPolynomial.C (MvPolynomial.eval z (MvPolynomial.pderiv s p)) *
              (MvPolynomial.X s - MvPolynomial.C (z s))) := by ring
      rw [e]
      refine Ideal.add_mem _ (Ideal.mul_mem_mul ?_ ?_) (Ideal.mul_mem_left _ _ hp)
      · simp [RingHom.mem_ker]
      · simp [RingHom.mem_ker]

  have s2 : ∀ {A : Type u} [CommRing A] (M : Ideal A) [M.IsPrime], M.FG → ∀ s : Set A,
      s ⊆ M → M ≤ Ideal.span s ⊔ M * M → M ∈ (Ideal.span s).minimalPrimes := by
    intro A _ M hM hfg s hs hle
    obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup
      (I := M) (N := Ideal.span s) (N' := M) (P := M) hfg le_rfl (by rwa [Ideal.smul_eq_mul])
    have hrM : r ∉ M := by
      intro h
      apply hM.ne_top
      rw [Ideal.eq_top_iff_one]
      have := M.sub_mem h hr1
      simpa using this
    refine ⟨⟨hM, Ideal.span_le.mpr hs⟩, ?_⟩
    rintro q ⟨hq, hsq⟩ hqM x hx
    have : r * x ∈ q := hsq (hr (Submodule.smul_mem_pointwise_smul x r M hx))
    rcases hq.mem_or_mem this with h | h
    · exact absurd (hqM h) hrM
    · exact h

  have s3 : ∃ (k : ℕ) (u : Fin k → σ → Ω), k ≤ Module.finrank Ω WE + Module.finrank Ω WG ∧
      ∀ w : σ → Ω, ∃ (c : Fin m → Ω) (d : Fin k → Ω),
        w = ∑ i, c i • (fun s => MvPolynomial.eval z (MvPolynomial.pderiv s (F i))) +
          ∑ j, d j • u j := by
    set J : Fin m → σ → Ω := fun i s => MvPolynomial.eval z (MvPolynomial.pderiv s (F i)) with hJ
    set Jm : Matrix (Fin m) σ Ω := Matrix.of J with hJm
    set T := LinearMap.ker Jm.mulVecLin with hTdef
    have hT : ∀ v, v ∈ T ↔ ∀ i, ∑ s, J i s * v s = 0 := by
      intro v
      simp only [hTdef, LinearMap.mem_ker, Matrix.mulVecLin_apply, funext_iff, Matrix.mulVec,
        dotProduct, hJm, Matrix.of_apply, Pi.zero_apply]
    set L := Submodule.span Ω (Set.range J) with hL
    have hrank : Module.finrank Ω L + Module.finrank Ω T = Fintype.card σ := by
      have h1 := LinearMap.finrank_range_add_finrank_ker Jm.mulVecLin
      rw [Module.finrank_fintype_fun_eq_card] at h1
      have h2 : Module.finrank Ω (LinearMap.range Jm.mulVecLin) = Module.finrank Ω L := by
        have := Matrix.rank_eq_finrank_span_row Jm
        rw [Matrix.rank] at this
        exact this
      rw [← h2]; exact h1
    obtain ⟨C, hC⟩ := Submodule.exists_isCompl L
    have hLC := Submodule.finrank_add_eq_of_isCompl hC
    rw [Module.finrank_fintype_fun_eq_card] at hLC
    have hE : ∀ v : T, (gE ∘ₗ T.subtype) v ∈ WE := fun v => (htan v ((hT v).mp v.2)).1
    have hG : ∀ v : T, (gG ∘ₗ T.subtype) v ∈ WG := fun v => (htan v ((hT v).mp v.2)).2.1
    let φ : T →ₗ[Ω] WE × WG :=
      (LinearMap.codRestrict WE (gE ∘ₗ T.subtype) hE).prod
        (LinearMap.codRestrict WG (gG ∘ₗ T.subtype) hG)
    have hφ : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro v hv
      have e1 : gE v = 0 := congrArg Subtype.val (congrArg Prod.fst hv)
      have e2 : gG v = 0 := congrArg Subtype.val (congrArg Prod.snd hv)
      exact Subtype.ext ((htan v ((hT v).mp v.2)).2.2 e1 e2)
    have hTle := LinearMap.finrank_le_finrank_of_injective hφ
    rw [Module.finrank_prod] at hTle
    let bC := Module.finBasis Ω C
    refine ⟨Module.finrank Ω C, fun j => (bC j : σ → Ω), by omega, ?_⟩
    intro w
    have hw : w ∈ L ⊔ C := by rw [hC.sup_eq_top]; trivial
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hw
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun Ω).mp ha
    refine ⟨c, bC.repr ⟨b, hb⟩, ?_⟩
    have hb' : ∑ j, bC.repr ⟨b, hb⟩ j • (bC j : σ → Ω) = b := by
      have := congrArg Subtype.val (bC.sum_repr ⟨b, hb⟩)
      rw [Submodule.coe_sum] at this
      simpa only [Submodule.coe_smul] using this
    rw [hb', hc]

  obtain ⟨k, u, hk, hspan⟩ := s3
  set 𝔪 := RingHom.ker (MvPolynomial.eval z) with h𝔪
  set I := Ideal.span (Set.range F) with hI
  have hIle : I ≤ 𝔪 := Ideal.span_le.mpr (by
    rintro _ ⟨i, rfl⟩
    exact hz i)
  haveI : 𝔪.IsPrime := RingHom.ker_isPrime _
  haveI hMp : (Ideal.map (Ideal.Quotient.mk I) 𝔪).IsPrime :=
    Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      (by rw [Ideal.mk_ker]; exact hIle)
  have hMfg : (Ideal.map (Ideal.Quotient.mk I) 𝔪).FG := IsNoetherian.noetherian _
  set Λ : (σ → Ω) → MvPolynomial σ Ω := fun w =>
    ∑ s, MvPolynomial.C (w s) * (MvPolynomial.X s - MvPolynomial.C (z s)) with hΛ
  have hΛ0 : ∀ w, MvPolynomial.eval z (Λ w) = 0 := by
    intro w
    simp [hΛ]
  have hΛm : ∀ w, Λ w ∈ 𝔪 := fun w => RingHom.mem_ker.mpr (hΛ0 w)
  have hΛd : ∀ w t, MvPolynomial.eval z (MvPolynomial.pderiv t (Λ w)) = w t := by
    intro w t
    simp [hΛ, map_sum, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_X, Pi.single_apply]
  set S := Ideal.span (Set.range (fun j => Λ (u j))) with hS
  have hkey : 𝔪 ≤ I ⊔ S ⊔ 𝔪 * 𝔪 := by
    intro x hx
    have hx0 : MvPolynomial.eval z x = 0 := RingHom.mem_ker.mp hx
    obtain ⟨c, d, hcd⟩ := hspan (fun s => MvPolynomial.eval z (MvPolynomial.pderiv s x))
    set y := x - ∑ i, MvPolynomial.C (c i) * F i - ∑ j, MvPolynomial.C (d j) * Λ (u j) with hy
    have hy0 : MvPolynomial.eval z y = 0 := by
      simp [hy, map_sum, hz, hΛ0, hx0]
    have hyd : ∀ t, MvPolynomial.eval z (MvPolynomial.pderiv t y) = 0 := by
      intro t
      have ht := congrFun hcd t
      simp only [Finset.sum_apply, Pi.add_apply, Pi.smul_apply, smul_eq_mul] at ht
      simp only [hy, map_sub, map_sum, MvPolynomial.pderiv_C_mul, MvPolynomial.eval_mul,
        MvPolynomial.eval_C, hΛd]
      rw [ht]
      ring
    have hysq : y ∈ 𝔪 * 𝔪 := by
      have := s1 y
      simp only [hy0, hyd, map_zero, zero_mul, Finset.sum_const_zero, sub_zero] at this
      exact this
    have hxe : x = y + ∑ i, MvPolynomial.C (c i) * F i + ∑ j, MvPolynomial.C (d j) * Λ (u j) := by
      rw [hy]; ring
    rw [hxe]
    refine Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mem_sup_right hysq) ?_) ?_
    · refine Ideal.mem_sup_left (Ideal.mem_sup_left ?_)
      exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))
    · refine Ideal.mem_sup_left (Ideal.mem_sup_right ?_)
      exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩))
  set s : Set (MvPolynomial σ Ω ⧸ I) := Set.range (fun j => Ideal.Quotient.mk I (Λ (u j))) with hs
  have hmapS : Ideal.map (Ideal.Quotient.mk I) S = Ideal.span s := by
    rw [hS, Ideal.map_span, ← Set.range_comp]
    rfl
  have hle : Ideal.map (Ideal.Quotient.mk I) 𝔪 ≤
      Ideal.span s ⊔ Ideal.map (Ideal.Quotient.mk I) 𝔪 * Ideal.map (Ideal.Quotient.mk I) 𝔪 := by
    have := Ideal.map_mono (f := Ideal.Quotient.mk I) hkey
    rw [Ideal.map_sup, Ideal.map_sup, Ideal.map_mul, Ideal.map_quotient_self, bot_sup_eq,
      hmapS] at this
    exact this
  have hsub : s ⊆ Ideal.map (Ideal.Quotient.mk I) 𝔪 := by
    rintro _ ⟨j, rfl⟩
    exact Ideal.mem_map_of_mem _ (hΛm (u j))
  have hmin := s2 (Ideal.map (Ideal.Quotient.mk I) 𝔪) hMfg s hsub hle
  have hkrull := Ideal.height_le_ncard_of_mem_minimalPrimes_span (Set.finite_range _) hmin
  have hcard : s.ncard ≤ k := by
    rw [hs, ← Set.image_univ]
    refine (Set.ncard_image_le Set.finite_univ).trans ?_
    rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fin]
  refine hkrull.trans ?_
  exact_mod_cast hcard.trans hk

theorem wc_param_spectral_assembly (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (σ J : Type) [Fintype σ] [DecidableEq σ] [Fintype J] [DecidableEq J]
    (I : Ideal (MvPolynomial σ Ω)) (ι : J → σ) (Pt : Type u) (Rel : Pt → Pt → Prop)
    (z : Pt → σ → Ω) (j : Pt → J) (kk : Pt → ℕ)
    (c : ∀ D, Fin (kk D + 1) → PrimeSpectrum (MvPolynomial σ Ω))
    (hz : ∀ D, z D (ι (j D)) ≠ 0) (hc : ∀ D, StrictMono (c D))
    (hI : ∀ D, I ≤ (c D 0).asIdeal)
    (hlast : ∀ D, (c D (Fin.last (kk D))).asIdeal = RingHom.ker (MvPolynomial.eval (z D)))
    (hht : ∀ D, (Ideal.map (Ideal.Quotient.mk I)
      (RingHom.ker (MvPolynomial.eval (z D)))).height ≤ (kk D : ℕ∞))
    (hRel : ∀ D D' (w : σ → Ω), I ≤ RingHom.ker (MvPolynomial.eval w) →
      (c D 0).asIdeal ≤ RingHom.ker (MvPolynomial.eval w) →
      (c D' 0).asIdeal ≤ RingHom.ker (MvPolynomial.eval w) → (∃ i, w (ι i) ≠ 0) → Rel D D') :
    ∃ (R : Type u) (_ : CommRing R) (_ : IsNoetherianRing R) (Q : Pt → PrimeSpectrum R),
      (∀ D D' (m : PrimeSpectrum R), m.asIdeal.IsMaximal → Q D ≤ m → Q D' ≤ m → Rel D D') ∧
      (∀ D, ∃ (k : ℕ) (c : Fin (k + 1) → PrimeSpectrum R), StrictMono c ∧ c 0 = Q D ∧
        (c (Fin.last k)).asIdeal.IsMaximal ∧
        ∀ (j : ℕ) (c' : Fin (j + 1) → PrimeSpectrum R), StrictMono c' →
          c' (Fin.last j) = c (Fin.last k) → j ≤ k) :=
by
  classical

  have chain_le : ∀ (n : ℕ) (e : Fin (n + 1) → PrimeSpectrum (MvPolynomial σ Ω ⧸ I)),
      StrictMono e → (n : ℕ∞) ≤ (e (Fin.last n)).asIdeal.height := by
    intro n
    induction n with
    | zero => intro e _; simp
    | succ n ih =>
      intro e he
      have h1 := ih (fun t => e (Fin.castSucc t)) (he.comp Fin.strictMono_castSucc)
      have hlt : (e (Fin.castSucc (Fin.last n))).asIdeal < (e (Fin.last (n + 1))).asIdeal :=
        (PrimeSpectrum.asIdeal_lt_asIdeal _ _).mpr (he (Fin.castSucc_lt_last _))
      by_contra hcon
      push_neg at hcon
      have h2 : (e (Fin.last (n + 1))).asIdeal.height ≤ (n : ℕ∞) := by
        rw [← ENat.lt_add_one_iff (ENat.coe_ne_top n)]
        exact_mod_cast hcon
      have h3 := (Ideal.height_le_iff.mp h2) _ (e _).isPrime hlt
      exact absurd h1 (not_le.mpr h3)

  have hπs : Function.Surjective (Ideal.Quotient.mk I) := Ideal.Quotient.mk_surjective
  have hπk : RingHom.ker (Ideal.Quotient.mk I) = I := Ideal.mk_ker
  have Q_cm : ∀ p : Ideal (MvPolynomial σ Ω), I ≤ p →
      Ideal.comap (Ideal.Quotient.mk I) (Ideal.map (Ideal.Quotient.mk I) p) = p := by
    intro p hp
    rw [Ideal.comap_map_of_surjective _ hπs, ← RingHom.ker_eq_comap_bot, hπk]
    exact sup_eq_left.mpr hp
  have Q_prime : ∀ p : Ideal (MvPolynomial σ Ω), p.IsPrime → I ≤ p →
      (Ideal.map (Ideal.Quotient.mk I) p).IsPrime := by
    intro p hp hIp
    exact Ideal.map_isPrime_of_surjective hπs (by rw [hπk]; exact hIp)
  have Q_max : ∀ p : Ideal (MvPolynomial σ Ω), p.IsMaximal → I ≤ p →
      (Ideal.map (Ideal.Quotient.mk I) p).IsMaximal := by
    intro p hp hIp
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective _ hπs hp with h | h
    · exfalso
      apply hp.ne_top
      rw [← Q_cm p hIp, h, Ideal.comap_top]
    · exact h
  obtain ⟨x, hx⟩ : ∃ x : J → MvPolynomial σ Ω ⧸ I,
      ∀ i, x i = Ideal.Quotient.mk I (MvPolynomial.X (ι i)) := ⟨_, fun _ => rfl⟩
  obtain ⟨ev, hev⟩ : ∃ ev : ∀ i, (∀ i, Localization.Away (x i)) →+* Localization.Away (x i),
      ∀ i f, ev i f = f i := ⟨fun i => Pi.evalRingHom _ i, fun _ _ => rfl⟩
  obtain ⟨lam, hlam⟩ : ∃ lam : ∀ i, (MvPolynomial σ Ω ⧸ I) →+* Localization.Away (x i),
      ∀ i, lam i = algebraMap (MvPolynomial σ Ω ⧸ I) (Localization.Away (x i)) :=
    ⟨fun i => algebraMap _ _, fun _ => rfl⟩

  have ev_s : ∀ i, Function.Surjective (ev i) := fun i y =>
    ⟨Pi.single (M := fun k => Localization.Away (x k)) i y, by rw [hev]; simp⟩
  have F_ker2 : ∀ i (P : Ideal (Localization.Away (x i)))
      (m : Ideal (∀ i, Localization.Away (x i))),
      Ideal.comap (ev i) P ≤ m → RingHom.ker (ev i) ≤ m := by
    intro i P m hPm y hy
    have e2 : (1 - (Pi.single i (1 : Localization.Away (x i)) : ∀ k, Localization.Away (x k)))
        ∈ m := by
      apply hPm
      rw [Ideal.mem_comap, hev, Pi.sub_apply, Pi.single_eq_same, Pi.one_apply, sub_self]
      exact P.zero_mem
    have hy0 : y * (1 - (Pi.single i (1 : Localization.Away (x i)) :
        ∀ k, Localization.Away (x k))) = y := by
      funext k
      by_cases hk : k = i
      · subst hk
        rw [RingHom.mem_ker, hev] at hy
        simp [hy]
      · simp [Pi.single_eq_of_ne hk]
    rw [← hy0]
    exact m.mul_mem_left y e2
  have F_ker : ∀ i (P : Ideal (Localization.Away (x i)))
      (q : Ideal (∀ i, Localization.Away (x i))),
      P ≠ ⊤ → q.IsPrime → q ≤ Ideal.comap (ev i) P → RingHom.ker (ev i) ≤ q := by
    intro i P q hP hq hqP y hy
    have hy0 : y * (Pi.single i (1 : Localization.Away (x i)) : ∀ k, Localization.Away (x k))
        = 0 := by
      funext k
      by_cases hk : k = i
      · subst hk
        rw [RingHom.mem_ker, hev] at hy
        simp [hy]
      · simp [Pi.single_eq_of_ne hk]
    have hmem : y * (Pi.single i (1 : Localization.Away (x i)) : ∀ k, Localization.Away (x k))
        ∈ q := by rw [hy0]; exact q.zero_mem
    rcases hq.mem_or_mem hmem with h | h
    · exact h
    · exfalso
      apply hP
      have := hqP h
      rw [Ideal.mem_comap, hev, Pi.single_eq_same] at this
      exact (Ideal.eq_top_iff_one _).mpr this
  have F_cm : ∀ i (q : Ideal (∀ i, Localization.Away (x i))), RingHom.ker (ev i) ≤ q →
      Ideal.comap (ev i) (Ideal.map (ev i) q) = q := by
    intro i q hq
    rw [Ideal.comap_map_of_surjective _ (ev_s i), ← RingHom.ker_eq_comap_bot]
    exact sup_eq_left.mpr hq
  have F_mc : ∀ i (P : Ideal (Localization.Away (x i))),
      Ideal.map (ev i) (Ideal.comap (ev i) P) = P := fun i P =>
    Ideal.map_comap_of_surjective _ (ev_s i) P
  have F_diff : ∀ i i' (P : Ideal (Localization.Away (x i)))
      (P' : Ideal (Localization.Away (x i'))) (m : Ideal (∀ i, Localization.Away (x i))),
      P ≠ ⊤ → P' ≠ ⊤ → m ≠ ⊤ →
      Ideal.comap (ev i) P ≤ m → Ideal.comap (ev i') P' ≤ m → i = i' := by
    intro i i' P P' m hP hP' hm h1 h2
    by_contra hne
    apply hm
    rw [Ideal.eq_top_iff_one]
    have e1 : (Pi.single i (1 : Localization.Away (x i)) : ∀ k, Localization.Away (x k)) ∈ m := by
      apply h2
      rw [Ideal.mem_comap, hev, Pi.single_eq_of_ne (Ne.symm hne)]
      exact P'.zero_mem
    have e2 : (1 - (Pi.single i (1 : Localization.Away (x i)) : ∀ k, Localization.Away (x k)))
        ∈ m := by
      apply h1
      rw [Ideal.mem_comap, hev, Pi.sub_apply, Pi.single_eq_same, Pi.one_apply, sub_self]
      exact P.zero_mem
    convert m.add_mem e1 e2 using 1
    ring

  have L_dis : ∀ i (P : Ideal (MvPolynomial σ Ω ⧸ I)), P.IsPrime → x i ∉ P →
      Disjoint (↑(Submonoid.powers (x i)) : Set (MvPolynomial σ Ω ⧸ I)) ↑P := by
    intro i P hP hxP
    rw [Set.disjoint_left]
    intro a ha haP
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp ha
    exact hxP (hP.mem_of_pow_mem n haP)
  have L_um : ∀ i (P : Ideal (MvPolynomial σ Ω ⧸ I)), P.IsPrime → x i ∉ P →
      Ideal.comap (lam i) (Ideal.map (lam i) P) = P := by
    intro i P hP hxP
    rw [hlam]
    exact IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers (x i)) _ hP
      (L_dis i P hP hxP)
  have L_mu : ∀ i (Q : Ideal (Localization.Away (x i))),
      Ideal.map (lam i) (Ideal.comap (lam i) Q) = Q := by
    intro i Q
    rw [hlam]
    exact IsLocalization.map_under (Submonoid.powers (x i)) _ Q
  have L_pm : ∀ i (P : Ideal (MvPolynomial σ Ω ⧸ I)), P.IsPrime → x i ∉ P →
      (Ideal.map (lam i) P).IsPrime := by
    intro i P hP hxP
    rw [hlam]
    exact IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers (x i)) _ P hP
      (L_dis i P hP hxP)
  have L_xn : ∀ i (Q : Ideal (Localization.Away (x i))), Q ≠ ⊤ →
      x i ∉ Ideal.comap (lam i) Q := by
    intro i Q hQ hxQ
    rw [hlam] at hxQ
    exact hQ (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.mp hxQ)
      (IsLocalization.Away.algebraMap_isUnit (x i)))
  have L_maxc : ∀ i (Q : Ideal (Localization.Away (x i))), Q.IsMaximal →
      (Ideal.comap (lam i) Q).IsMaximal := by
    intro i Q hQ
    rw [hlam]
    exact ((IsLocalization.isMaximal_iff_isMaximal_disjoint (Localization.Away (x i)) (x i)
      Q).mp hQ).1
  have L_maxm : ∀ i (P : Ideal (MvPolynomial σ Ω ⧸ I)), P.IsMaximal → x i ∉ P →
      (Ideal.map (lam i) P).IsMaximal := by
    intro i P hP hxP
    rw [hlam]
    haveI := hP
    exact IsLocalization.isMaximal_of_isMaximal_disjoint (Submonoid.powers (x i)) _ P
      (L_dis i P hP.isPrime hxP)

  have T_x : ∀ i (p : Ideal (MvPolynomial σ Ω)), I ≤ p → MvPolynomial.X (ι i) ∉ p →
      x i ∉ Ideal.map (Ideal.Quotient.mk I) p := by
    intro i p hIp hX hxp
    apply hX
    rw [← Q_cm p hIp, Ideal.mem_comap, ← hx]
    exact hxp
  have T_prime : ∀ i (p : Ideal (MvPolynomial σ Ω)), p.IsPrime → I ≤ p →
      MvPolynomial.X (ι i) ∉ p →
      (Ideal.map (lam i) (Ideal.map (Ideal.Quotient.mk I) p)).IsPrime :=
    fun i p hp hIp hX => L_pm i _ (Q_prime p hp hIp) (T_x i p hIp hX)
  have T_rec : ∀ i (p : Ideal (MvPolynomial σ Ω)), p.IsPrime → I ≤ p →
      MvPolynomial.X (ι i) ∉ p →
      Ideal.comap (Ideal.Quotient.mk I) (Ideal.comap (lam i)
        (Ideal.map (lam i) (Ideal.map (Ideal.Quotient.mk I) p))) = p := by
    intro i p hp hIp hX
    rw [L_um i _ (Q_prime p hp hIp) (T_x i p hIp hX), Q_cm p hIp]
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : J → Ideal (MvPolynomial σ Ω) → Ideal (∀ i, Localization.Away (x i)),
      ∀ i p, Θ i p = Ideal.comap (ev i) (Ideal.map (lam i)
        (Ideal.map (Ideal.Quotient.mk I) p)) := ⟨_, fun _ _ => rfl⟩
  have Θ_prime : ∀ i p, p.IsPrime → I ≤ p → MvPolynomial.X (ι i) ∉ p → (Θ i p).IsPrime := by
    intro i p hp hIp hX
    rw [hΘ]
    haveI := T_prime i p hp hIp hX
    infer_instance
  have Θ_mono : ∀ i p p', p ≤ p' → Θ i p ≤ Θ i p' := by
    intro i p p' h
    rw [hΘ, hΘ]
    exact Ideal.comap_mono (Ideal.map_mono (Ideal.map_mono h))
  have Θ_inj : ∀ i p p', p.IsPrime → I ≤ p → MvPolynomial.X (ι i) ∉ p →
      p'.IsPrime → I ≤ p' → MvPolynomial.X (ι i) ∉ p' → Θ i p = Θ i p' → p = p' := by
    intro i p p' hp hIp hX hp' hIp' hX' h
    rw [hΘ, hΘ] at h
    have h2 := congrArg (Ideal.map (ev i)) h
    rw [F_mc, F_mc] at h2
    have h3 := T_rec i p hp hIp hX
    rw [h2, T_rec i p' hp' hIp' hX'] at h3
    exact h3.symm

  have key : ∀ i i' (p p' : Ideal (MvPolynomial σ Ω)), p.IsPrime → I ≤ p →
      MvPolynomial.X (ι i) ∉ p → p'.IsPrime → I ≤ p' → MvPolynomial.X (ι i') ∉ p' →
      ∀ m : Ideal (∀ i, Localization.Away (x i)), m.IsMaximal → Θ i p ≤ m → Θ i' p' ≤ m →
      ∃ w : σ → Ω, I ≤ RingHom.ker (MvPolynomial.eval w) ∧
        p ≤ RingHom.ker (MvPolynomial.eval w) ∧ p' ≤ RingHom.ker (MvPolynomial.eval w) ∧
        ∃ i, w (ι i) ≠ 0 := by
    intro i i' p p' hp hIp hX hp' hIp' hX' m hm h1 h2
    have hii : i = i' := F_diff i i' _ _ m (T_prime i p hp hIp hX).ne_top
      (T_prime i' p' hp' hIp' hX').ne_top hm.ne_top
      (by rw [← hΘ]; exact h1) (by rw [← hΘ]; exact h2)
    rw [← hii] at h2 hX'
    have hker : RingHom.ker (ev i) ≤ m :=
      F_ker2 i _ m (by rw [← hΘ]; exact h1)
    obtain ⟨M, hM⟩ : ∃ M, M = Ideal.map (ev i) m := ⟨_, rfl⟩
    have hmM : Ideal.comap (ev i) M = m := by rw [hM]; exact F_cm i m hker
    have hMmax : M.IsMaximal := by
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective _ (ev_s i) hm with h | h
      · exfalso
        apply hm.ne_top
        rw [← hmM, hM, h, Ideal.comap_top]
      · rw [hM]; exact h
    have hPmax := L_maxc i M hMmax
    have hp''max : (Ideal.comap (Ideal.Quotient.mk I) (Ideal.comap (lam i) M)).IsMaximal := by
      haveI := hPmax
      exact Ideal.comap_isMaximal_of_surjective _ hπs
    obtain ⟨w, hw⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hp''max
    have hw' : Ideal.comap (Ideal.Quotient.mk I) (Ideal.comap (lam i) M) =
        RingHom.ker (MvPolynomial.eval w) := by
      rw [hw]
      ext f
      rw [MvPolynomial.mem_vanishingIdeal_singleton_iff, RingHom.mem_ker]
      rfl
    have hle : ∀ q, Θ i q ≤ m → q ≤ RingHom.ker (MvPolynomial.eval w) := by
      intro q hq
      rw [← hw', ← Ideal.map_le_iff_le_comap, ← Ideal.map_le_iff_le_comap, hM,
        ← F_mc i (Ideal.map (lam i) (Ideal.map (Ideal.Quotient.mk I) q)), ← hΘ]
      exact Ideal.map_mono hq
    refine ⟨w, hIp.trans (hle p h1), hle p h1, hle p' h2, i, ?_⟩
    intro hw0
    apply L_xn i M hMmax.ne_top
    have : MvPolynomial.X (ι i) ∈ RingHom.ker (MvPolynomial.eval w) := by
      rw [RingHom.mem_ker, MvPolynomial.eval_X]; exact hw0
    rw [← hw', Ideal.mem_comap, ← hx] at this
    exact this

  have G_le : ∀ D t, c D t ≤ c D (Fin.last (kk D)) := fun D t => (hc D).monotone (Fin.le_last t)
  have G_I : ∀ D t, I ≤ (c D t).asIdeal := fun D t =>
    (hI D).trans ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr ((hc D).monotone (Fin.zero_le t)))
  have G_X : ∀ D t, MvPolynomial.X (ι (j D)) ∉ (c D t).asIdeal := by
    intro D t hX
    have h1 := (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr (G_le D t) hX
    rw [hlast D, RingHom.mem_ker, MvPolynomial.eval_X] at h1
    exact hz D h1
  have G_max : ∀ D, (RingHom.ker (MvPolynomial.eval (z D))).IsMaximal := fun D =>
    RingHom.ker_isMaximal_of_surjective _ (fun a => ⟨MvPolynomial.C a, MvPolynomial.eval_C _⟩)
  refine ⟨(∀ i, Localization.Away (x i)), inferInstance, inferInstance,
    fun D => ⟨Θ (j D) (c D 0).asIdeal, Θ_prime _ _ (c D 0).isPrime (G_I D 0) (G_X D 0)⟩,
    ?_, ?_⟩
  · intro D D' m hm h1 h2
    rw [← PrimeSpectrum.asIdeal_le_asIdeal] at h1 h2
    obtain ⟨w, hwI, hw1, hw2, hwi⟩ := key (j D) (j D') _ _ (c D 0).isPrime (G_I D 0) (G_X D 0)
      (c D' 0).isPrime (G_I D' 0) (G_X D' 0) m.asIdeal hm h1 h2
    exact hRel D D' w hwI hw1 hw2 hwi
  · intro D
    have hmem : ∀ t, (Θ (j D) (c D t).asIdeal).IsPrime := fun t =>
      Θ_prime _ _ (c D t).isPrime (G_I D t) (G_X D t)
    refine ⟨kk D, fun t => ⟨Θ (j D) (c D t).asIdeal, hmem t⟩, ?_, rfl, ?_, ?_⟩
    · apply Monotone.strictMono_of_injective
      · intro t t' htt
        rw [← PrimeSpectrum.asIdeal_le_asIdeal]
        exact Θ_mono _ _ _ ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr ((hc D).monotone htt))
      · intro t t' htt
        have h1 : Θ (j D) (c D t).asIdeal = Θ (j D) (c D t').asIdeal :=
          congrArg PrimeSpectrum.asIdeal htt
        exact (hc D).injective (PrimeSpectrum.ext (Θ_inj _ _ _ (c D t).isPrime (G_I D t)
          (G_X D t) (c D t').isPrime (G_I D t') (G_X D t') h1))
    · change (Θ (j D) (c D (Fin.last (kk D))).asIdeal).IsMaximal
      have hI' : I ≤ RingHom.ker (MvPolynomial.eval (z D)) := by
        rw [← hlast D]; exact G_I D _
      have hX' : MvPolynomial.X (ι (j D)) ∉ RingHom.ker (MvPolynomial.eval (z D)) := by
        rw [← hlast D]; exact G_X D _
      rw [hΘ, hlast D]
      haveI := L_maxm (j D) _ (Q_max _ (G_max D) hI') (T_x _ _ hI' hX')
      exact Ideal.comap_isMaximal_of_surjective _ (ev_s _)
    · intro n c' hc' hl
      have hN := T_prime (j D) _ (c D (Fin.last (kk D))).isPrime (G_I D _) (G_X D _)
      have hl' : (c' (Fin.last n)).asIdeal = Θ (j D) (c D (Fin.last (kk D))).asIdeal :=
        congrArg PrimeSpectrum.asIdeal hl
      have hker : ∀ t, RingHom.ker (ev (j D)) ≤ (c' t).asIdeal := by
        intro t
        refine F_ker (j D) _ _ hN.ne_top (c' t).isPrime ?_
        rw [← hΘ, ← hl']
        exact (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr (hc'.monotone (Fin.le_last t))
      have hPp : ∀ t, (Ideal.comap (lam (j D)) (Ideal.map (ev (j D)) (c' t).asIdeal)).IsPrime := by
        intro t
        haveI := Ideal.map_isPrime_of_surjective (ev_s (j D)) (hker t)
        infer_instance
      have hrec : ∀ t, Ideal.comap (ev (j D)) (Ideal.map (lam (j D))
          (Ideal.comap (lam (j D)) (Ideal.map (ev (j D)) (c' t).asIdeal))) = (c' t).asIdeal := by
        intro t
        rw [L_mu, F_cm _ _ (hker t)]
      let d : Fin (n + 1) → PrimeSpectrum (MvPolynomial σ Ω ⧸ I) := fun t => ⟨_, hPp t⟩
      have hd : StrictMono d := by
        apply Monotone.strictMono_of_injective
        · intro t t' htt
          rw [← PrimeSpectrum.asIdeal_le_asIdeal]
          exact Ideal.comap_mono (Ideal.map_mono
            ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr (hc'.monotone htt)))
        · intro t t' htt
          have h1 : Ideal.comap (lam (j D)) (Ideal.map (ev (j D)) (c' t).asIdeal) =
              Ideal.comap (lam (j D)) (Ideal.map (ev (j D)) (c' t').asIdeal) :=
            congrArg PrimeSpectrum.asIdeal htt
          apply hc'.injective
          apply PrimeSpectrum.ext
          rw [← hrec t, ← hrec t', h1]
      have hdl : (d (Fin.last n)).asIdeal =
          Ideal.map (Ideal.Quotient.mk I) (c D (Fin.last (kk D))).asIdeal := by
        change Ideal.comap (lam (j D)) (Ideal.map (ev (j D)) (c' (Fin.last n)).asIdeal) = _
        rw [hl', hΘ, F_mc, L_um _ _ (Q_prime _ (c D _).isPrime (G_I D _))
          (T_x _ _ (G_I D _) (G_X D _))]
      have := chain_le n d hd
      rw [hdl, hlast D] at this
      exact_mod_cast this.trans (hht D)

theorem wc_bilinear_cone_parameter_ring (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (K : Type u) [Field K] [Algebra Ω K] (ℓ : ℕ) (hℓ : 0 < ℓ)
    (VF VA VB : Submodule Ω K) (hVF : FiniteDimensional Ω VF) (hVA : FiniteDimensional Ω VA)
    (hVB : FiniteDimensional Ω VB)
    (Pt : Type u) (Rel : Pt → Pt → Prop) (SE SG : Pt → Submodule Ω K)
    (hSE : ∀ D, FiniteDimensional Ω (SE D)) (hSG : ∀ D, FiniteDimensional Ω (SG D))
    (f₀ a₀ b₀ : Pt → K) (hf₀ : ∀ D, f₀ D ≠ 0) (hb₀ : ∀ D, b₀ D ≠ 0)
    (hab : ∀ D, a₀ D ^ ℓ = f₀ D * b₀ D)
    (h1E : ∀ D, (1 : K) ∈ SE D) (h1G : ∀ D, (1 : K) ∈ SG D)
    (hconeF : ∀ D, ∀ h ∈ SE D, h ^ ℓ * f₀ D ∈ VF)
    (hconeA : ∀ D, ∀ h ∈ SE D, ∀ k ∈ SG D, h * k * a₀ D ∈ VA)
    (hconeB : ∀ D, ∀ k ∈ SG D, k ^ ℓ * b₀ D ∈ VB)
    (htan : ∀ D, ∀ f' ∈ VF, ∀ a' ∈ VA, ∀ b' ∈ VB,
      (ℓ : K) * a₀ D ^ (ℓ - 1) * a' = f' * b₀ D + f₀ D * b' →
      f' * (f₀ D)⁻¹ ∈ SE D ∧ b' * (b₀ D)⁻¹ ∈ SG D ∧ (f' = 0 → b' = 0 → a' = 0))
    (hrig : ∀ D D', ∀ h ∈ SE D, ∀ h' ∈ SE D', h ^ ℓ * f₀ D = h' ^ ℓ * f₀ D' →
      h ^ ℓ * f₀ D ≠ 0 → Rel D D') :
    ∃ (R : Type u) (_ : CommRing R) (_ : IsNoetherianRing R) (Q : Pt → PrimeSpectrum R),
      (∀ D D' (m : PrimeSpectrum R), m.asIdeal.IsMaximal → Q D ≤ m → Q D' ≤ m → Rel D D') ∧
      (∀ D, ∃ (k : ℕ) (c : Fin (k + 1) → PrimeSpectrum R), StrictMono c ∧ c 0 = Q D ∧
        (c (Fin.last k)).asIdeal.IsMaximal ∧
        ∀ (j : ℕ) (c' : Fin (j + 1) → PrimeSpectrum R), StrictMono c' →
          c' (Fin.last j) = c (Fin.last k) → j ≤ k) :=
by
  classical
  haveI := hVF
  haveI := hVA
  haveI := hVB
  set bF := Module.finBasis Ω VF with hbF
  set bA := Module.finBasis Ω VA with hbA
  set bB := Module.finBasis Ω VB with hbB

  obtain ⟨m, F, hE1, hE2⟩ := wc_bc_equations Ω K ℓ (Fin (Module.finrank Ω VF))
    (Fin (Module.finrank Ω VA)) (Fin (Module.finrank Ω VB))
    (fun j => (bF j : K)) (fun j => (bA j : K)) (fun j => (bB j : K))
  beta_reduce at hE1 hE2

  have hind : ∀ (V : Submodule Ω K) (n : ℕ) (b : Module.Basis (Fin n) Ω V) (v : Fin n → Ω),
      ∑ j, v j • (b j : K) = 0 → v = 0 := by
    intro V n b v hv
    have h1 : ((b.equivFun.symm v : V) : K) = ∑ j, v j • (b j : K) := by
      rw [Module.Basis.equivFun_symm_apply, Submodule.coe_sum]
      simp only [Submodule.coe_smul]
    have h2 : b.equivFun.symm v = 0 := by
      apply Subtype.ext
      rw [h1, hv]
      rfl
    exact (LinearEquiv.map_eq_zero_iff _).mp h2
  have hmem : ∀ (V : Submodule Ω K) (n : ℕ) (b : Module.Basis (Fin n) Ω V) (v : Fin n → Ω),
      ∑ j, v j • (b j : K) ∈ V := fun V n b v =>
    Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (b j).2)

  have hcone := fun D => @wc_bc_cone_chain Ω _ _ K _ _ ℓ hℓ _ _ _ _ _ _ _ _ _ VF VA VB bF bA bB
    (SE D) (SG D) (hSE D) (hSG D) (f₀ D) (a₀ D) (b₀ D) (hf₀ D) (hb₀ D) (hab D) (h1E D) (h1G D)
    (hconeF D) (hconeA D) (hconeB D) m F (fun z hz => (hE1 z).mpr hz)
  choose z c hzf hza hzb hc hI hlast hpt using hcone

  have hj : ∀ D, ∃ i, z D (Sum.inl (Sum.inl i)) ≠ 0 := by
    intro D
    by_contra hcon
    push_neg at hcon
    apply hf₀ D
    rw [← hzf D]
    simp [hcon]
  choose jj hjj using hj
  have hzF : ∀ D, ∀ i, MvPolynomial.eval (z D) (F i) = 0 := by
    intro D
    apply (hE1 (z D)).mpr
    rw [hzf D, hza D, hzb D]
    exact hab D

  have hht : ∀ D, (Ideal.map (Ideal.Quotient.mk (Ideal.span (Set.range F)))
      (RingHom.ker (MvPolynomial.eval (z D)))).height ≤
      ((Module.finrank Ω (SE D) + Module.finrank Ω (SG D) : ℕ) : ℕ∞) := by
    intro D
    haveI := hSE D
    haveI := hSG D
    let fL : ((Fin (Module.finrank Ω VF) ⊕ Fin (Module.finrank Ω VA)) ⊕
        Fin (Module.finrank Ω VB) → Ω) →ₗ[Ω] K :=
      { toFun := fun v => ∑ j, v (Sum.inl (Sum.inl j)) • (bF j : K)
        map_add' := fun v w => by simp [add_smul, Finset.sum_add_distrib]
        map_smul' := fun r v => by simp [Finset.smul_sum, mul_smul] }
    let bL : ((Fin (Module.finrank Ω VF) ⊕ Fin (Module.finrank Ω VA)) ⊕
        Fin (Module.finrank Ω VB) → Ω) →ₗ[Ω] K :=
      { toFun := fun v => ∑ j, v (Sum.inr j) • (bB j : K)
        map_add' := fun v w => by simp [add_smul, Finset.sum_add_distrib]
        map_smul' := fun r v => by simp [Finset.smul_sum, mul_smul] }
    refine wc_param_height_le_tangent_maps Ω _ m F (z D) (hzF D) K K
      ((LinearMap.mulRight Ω (f₀ D)⁻¹).comp fL) ((LinearMap.mulRight Ω (b₀ D)⁻¹).comp bL)
      (SE D) (SG D) ?_
    intro v hv
    have h := (hE2 (z D) v).mp hv
    rw [hzf D, hza D, hzb D] at h
    obtain ⟨t1, t2, t3⟩ := htan D _ (hmem VF _ bF _) _ (hmem VA _ bA _) _ (hmem VB _ bB _) h
    refine ⟨t1, t2, fun e1 e2 => ?_⟩
    have e1' : (∑ j, v (Sum.inl (Sum.inl j)) • (bF j : K)) = 0 := by
      have : (∑ j, v (Sum.inl (Sum.inl j)) • (bF j : K)) * (f₀ D)⁻¹ = 0 := e1
      exact (mul_eq_zero.mp this).resolve_right (inv_ne_zero (hf₀ D))
    have e2' : (∑ j, v (Sum.inr j) • (bB j : K)) = 0 := by
      have : (∑ j, v (Sum.inr j) • (bB j : K)) * (b₀ D)⁻¹ = 0 := e2
      exact (mul_eq_zero.mp this).resolve_right (inv_ne_zero (hb₀ D))
    have a0 := t3 e1' e2'
    have hvF := hind VF _ bF _ e1'
    have hvA := hind VA _ bA _ a0
    have hvB := hind VB _ bB _ e2'
    funext s
    rcases s with (s | s) | s
    · exact congrFun hvF s
    · exact congrFun hvA s
    · exact congrFun hvB s

  have hRel : ∀ D D' (w : (Fin (Module.finrank Ω VF) ⊕ Fin (Module.finrank Ω VA)) ⊕
      Fin (Module.finrank Ω VB) → Ω),
      Ideal.span (Set.range F) ≤ RingHom.ker (MvPolynomial.eval w) →
      (c D 0).asIdeal ≤ RingHom.ker (MvPolynomial.eval w) →
      (c D' 0).asIdeal ≤ RingHom.ker (MvPolynomial.eval w) →
      (∃ i, w ((fun i => Sum.inl (Sum.inl i)) i) ≠ 0) → Rel D D' := by
    intro D D' w _ h1 h2 hi
    obtain ⟨i, hi⟩ := hi
    obtain ⟨h, hh, eh⟩ := hpt D w h1
    obtain ⟨h', hh', eh'⟩ := hpt D' w h2
    refine hrig D D' h hh h' hh' (eh.symm.trans eh') ?_
    rw [← eh]
    intro h0
    exact hi (congrFun (hind VF _ bF _ h0) i)
  exact wc_param_spectral_assembly Ω _ (Fin (Module.finrank Ω VF)) (Ideal.span (Set.range F))
    (fun i => Sum.inl (Sum.inl i)) Pt Rel z jj
    (fun D => Module.finrank Ω (SE D) + Module.finrank Ω (SG D)) c hjj hc hI hlast hht hRel

theorem wc_curve_ell_torsion_parameter_ring : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ℓ : ℕ, ℓ.Prime → (ℓ : Ω) ≠ 0 →
    ∀ ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ord →
    ∃ (R : Type u) (_ : CommRing R) (_ : IsNoetherianRing R)
      (Q : {D : X → ℤ // ∃ f : (FractionRing Γ(X, U))ˣ,
        ∀ x, (ℓ : ℤ) * D x = ord x (Additive.ofMul f)} → PrimeSpectrum R),
      (∀ D D' (m : PrimeSpectrum R), m.asIdeal.IsMaximal → Q D ≤ m → Q D' ≤ m →
        ∃ h : (FractionRing Γ(X, U))ˣ, ∀ x, D.1 x = D'.1 x + ord x (Additive.ofMul h)) ∧
      (∀ D, ∃ (k : ℕ) (c : Fin (k + 1) → PrimeSpectrum R), StrictMono c ∧ c 0 = Q D ∧
        (c (Fin.last k)).asIdeal.IsMaximal ∧
        ∀ (j : ℕ) (c' : Fin (j + 1) → PrimeSpectrum R), StrictMono c' →
          c' (Fin.last j) = c (Fin.last k) → j ≤ k) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ℓ hℓ hℓΩ ord hord
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
  obtain ⟨g, c, hRR⟩ := wc_curve_riemann_roch_large_degree Ω X fX hnorm hdim U hU hfin ord hord
  have hℓ0 : 0 < ℓ := hℓ.pos
  have hℓ1 : (1 : ℤ) ≤ ℓ := by exact_mod_cast hℓ0
  have hc0 : (0 : ℤ) ≤ c := by positivity
  have hg0 : (0 : ℤ) ≤ g := by positivity

  obtain ⟨P, hP⟩ : ∃ P : X, P ≠ genericPoint X := by
    by_contra hcon
    push_neg at hcon
    haveI : Subsingleton X := ⟨fun a b => (hcon a).trans (hcon b).symm⟩
    have h0 := topologicalKrullDim_zero_of_discreteTopology X
    rw [hdim] at h0
    exact absurd h0 (by decide)
  have hdeg : ∀ n : ℤ, (Finsupp.single P n).sum (fun _ k => k) = n := fun n =>
    Finsupp.sum_single_index rfl
  have hη : ∀ n : ℤ, Finsupp.single P n (genericPoint X) = 0 := fun n => by simp [hP]

  have hVF := (hRR (Finsupp.single P ((ℓ : ℤ) * ((c : ℤ) + g))) (hη _)
    (by rw [hdeg]; nlinarith)).1
  have hVA := (hRR (Finsupp.single P (2 * (c : ℤ) + g + 1)) (hη _)
    (by rw [hdeg]; linarith)).1
  have hVB := (hRR (Finsupp.single P ((ℓ : ℤ) * ((c : ℤ) + 1))) (hη _)
    (by rw [hdeg]; nlinarith)).1

  have hgp := fun D : {D : X → ℤ // ∃ f : (FractionRing Γ(X, U))ˣ,
      ∀ x, (ℓ : ℤ) * D x = ord x (Additive.ofMul f)} =>
    wc_curve_good_point_exists Ω X fX hnorm hdim U hU hfin ord hord g c hRR ℓ hℓ0 P hP
      D.1 D.2.choose D.2.choose_spec
  choose E G f₀ a₀ b₀ u hE hG hdisj hab hordf hora hordb hEu hfinE hfinG using hgp

  have htg := fun D => wc_curve_good_point_tangent Ω X fX U hU ord hord ℓ hℓ0 hℓΩ (E D) (G D)
    (Finsupp.single P ((ℓ : ℤ) * ((c : ℤ) + g))) (Finsupp.single P (2 * (c : ℤ) + g + 1))
    (Finsupp.single P ((ℓ : ℤ) * ((c : ℤ) + 1))) (f₀ D) (a₀ D) (b₀ D) (hE D) (hG D) (hdisj D)
    (hab D) (hordf D) (hora D) (hordb D)
  refine wc_bilinear_cone_parameter_ring Ω (FractionRing Γ(X, U)) ℓ hℓ0
    (wcRRSpace Ω X fX U ord (Finsupp.single P ((ℓ : ℤ) * ((c : ℤ) + g))))
    (wcRRSpace Ω X fX U ord (Finsupp.single P (2 * (c : ℤ) + g + 1)))
    (wcRRSpace Ω X fX U ord (Finsupp.single P ((ℓ : ℤ) * ((c : ℤ) + 1))))
    hVF hVA hVB _
    (fun D D' => ∃ h : (FractionRing Γ(X, U))ˣ, ∀ x, D.1 x = D'.1 x + ord x (Additive.ofMul h))
    (fun D => wcRRSpace Ω X fX U ord (E D)) (fun D => wcRRSpace Ω X fX U ord (G D))
    hfinE hfinG
    (fun D => (f₀ D : FractionRing Γ(X, U))) (fun D => (a₀ D : FractionRing Γ(X, U)))
    (fun D => (b₀ D : FractionRing Γ(X, U)))
    (fun D => Units.ne_zero _) (fun D => Units.ne_zero _)
    (fun D => by
      change ((a₀ D : FractionRing Γ(X, U))) ^ ℓ = (f₀ D : FractionRing Γ(X, U)) * b₀ D
      rw [← Units.val_pow_eq_pow_val, hab D, Units.val_mul])
    (fun D => (htg D).1) (fun D => (htg D).2.1) (fun D => (htg D).2.2.1)
    (fun D => (htg D).2.2.2.1) (fun D => (htg D).2.2.2.2.1) (fun D => (htg D).2.2.2.2.2) ?_

  intro D D' h _ h' _ heq hne
  have hz : (0 : FractionRing Γ(X, U)) ^ ℓ = 0 := zero_pow hℓ0.ne'
  have h0 : h ≠ 0 := by
    rintro rfl
    apply hne
    simp only [hz, zero_mul]
  have h0' : h' ≠ 0 := by
    rintro rfl
    apply hne
    rw [heq]
    simp only [hz, zero_mul]
  have hUeq : (Units.mk0 h h0) ^ ℓ * f₀ D = (Units.mk0 h' h0') ^ ℓ * f₀ D' := by
    ext
    simp only [Units.val_mul, Units.val_pow_eq_pow_val, Units.val_mk0]
    exact heq
  refine ⟨Units.mk0 h' h0' * u D' * (Units.mk0 h h0 * u D)⁻¹, fun x => ?_⟩
  have e1 := congrArg (fun z => ord x (Additive.ofMul z)) hUeq
  simp only [ofMul_mul, ofMul_pow, map_add, map_nsmul, nsmul_eq_mul] at e1
  rw [hordf D x, hordf D' x, hEu D x, hEu D' x] at e1
  simp only [ofMul_mul, ofMul_inv, map_add, map_neg]
  have key : (ℓ : ℤ) * (D.1 x - (D'.1 x + (ord x (Additive.ofMul (Units.mk0 h' h0')) +
      ord x (Additive.ofMul (u D')) + -(ord x (Additive.ofMul (Units.mk0 h h0)) +
      ord x (Additive.ofMul (u D)))))) = 0 := by
    linear_combination e1
  have hℓz : (ℓ : ℤ) ≠ 0 := by exact_mod_cast hℓ0.ne'
  have := (mul_eq_zero.mp key).resolve_left hℓz
  linarith

theorem wc_curve_classGroup_ell_torsion_finite : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX], IrreducibleSpace X →
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)], IsAffineOpen U → ((U : Set X)ᶜ).Finite →
    ∀ ℓ : ℕ, ℓ.Prime → (ℓ : Ω) ≠ 0 → Finite {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} :=
by
  intro Ω _ _ X fX _ hirr hnorm hdim U _ hU hfin ℓ hℓ hℓΩ
  classical
  haveI := hirr

  obtain ⟨ord, hord⟩ := wc_curve_ord_data_exists Ω X fX hnorm hdim U hU hfin

  obtain ⟨R, _, _, Q, hQ1, hQ2⟩ :=
    wc_curve_ell_torsion_parameter_ring Ω X fX hnorm hdim U hU hfin ℓ hℓ hℓΩ ord hord

  have hmin : ∀ D, (Q D).asIdeal ∈ minimalPrimes R := by
    intro D
    obtain ⟨k, c, hc, hc0, _, hmax⟩ := hQ2 D
    refine ⟨⟨(Q D).isPrime, bot_le⟩, fun q hq hqle => ?_⟩
    by_contra hne
    let P : PrimeSpectrum R := ⟨q, hq.1⟩
    have hlt : P < c 0 := by
      rw [hc0]
      exact lt_of_le_not_ge hqle hne
    have hlast : Matrix.vecCons P c (Fin.last (k + 1)) = c (Fin.last k) := by
      rw [← Fin.succ_last, Matrix.cons_val_succ]
    have := hmax (k + 1) (Matrix.vecCons P c) (StrictMono.vecCons hc hlt) hlast
    omega

  have hfinR : (Set.range Q).Finite := by
    have h1 : (PrimeSpectrum.asIdeal ⁻¹' minimalPrimes R).Finite :=
      (minimalPrimes.finite_of_isNoetherianRing R).preimage
        (fun a _ b _ hab => PrimeSpectrum.ext hab)
    refine h1.subset ?_
    rintro _ ⟨D, rfl⟩
    exact hmin D

  let pick : PrimeSpectrum R → X → ℤ := fun p => if h : ∃ D, Q D = p then (h.choose).1 else 0
  refine wc_classGroup_ell_torsion_of_proper_reps X U hU hfin ℓ hℓ ord hord.1 hord.2.1
    (hfinR.toFinset.image pick) ?_
  intro D hD
  let D' : {D : X → ℤ // ∃ f : (FractionRing Γ(X, U))ˣ,
      ∀ x, (ℓ : ℤ) * D x = ord x (Additive.ofMul f)} := ⟨D, hD⟩
  have hex : ∃ E, Q E = Q D' := ⟨D', rfl⟩
  have hpick : pick (Q D') = hex.choose.1 := dif_pos hex
  refine ⟨pick (Q D'), Finset.mem_image_of_mem _ (hfinR.mem_toFinset.mpr ⟨D', rfl⟩), ?_⟩
  obtain ⟨k, c, hc, hc0, hcm, _⟩ := hQ2 D'
  have hle : Q D' ≤ c (Fin.last k) := hc0 ▸ hc.monotone (Fin.zero_le _)
  have hle' : Q hex.choose ≤ c (Fin.last k) := by rw [hex.choose_spec]; exact hle
  obtain ⟨h, hh⟩ := hQ1 D' hex.choose (c (Fin.last k)) hcm hle hle'
  rw [hpick]
  exact ⟨h, hh⟩

theorem wc_curve_proper_ell_torsion_reps : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ℓ : ℕ, ℓ.Prime →
    ∀ ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ord →
    Finite {c : ClassGroup Γ(X, U) // c ^ ℓ = 1} →
    ∃ T : Finset (X →₀ ℤ), ∀ D : X →₀ ℤ,
      (∃ f : (FractionRing Γ(X, U))ˣ, ∀ x, (ℓ : ℤ) * D x = ord x (Additive.ofMul f)) →
      ∃ t ∈ T, ∃ h : (FractionRing Γ(X, U))ˣ, ∀ x, D x = t x + ord x (Additive.ofMul h) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ℓ hℓ ord hord htor
  classical
  have hℓ0 : (ℓ : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hℓ.ne_zero
  have hℓpos : 0 < ℓ := hℓ.pos
  obtain ⟨ψ₀, hψs, hψk⟩ := dedekind_classGroup_divisor_presentation Γ(X, U)
  obtain ⟨hηU, hinj, hvU, hpts⟩ := wc_dedekind_affine_points X U hU
  have ho1 := hord.1
  have ho2 := hord.2.1
  have ho3 := hord.2.2.1

  have hη : ∀ D : X →₀ ℤ,
      (∃ f : (FractionRing Γ(X, U))ˣ, ∀ x, (ℓ : ℤ) * D x = ord x (Additive.ofMul f)) →
      D (genericPoint X) = 0 := by
    rintro D ⟨f, hf⟩
    have h1 := hf (genericPoint X)
    rw [ho1] at h1
    exact (mul_eq_zero.mp h1).resolve_left hℓ0

  let divF : (FractionRing Γ(X, U))ˣ → (X →₀ ℤ) := fun h =>
    Finsupp.ofSupportFinite (fun x => ord x (Additive.ofMul h)) (ho3 (Additive.ofMul h))
  have hdivF : ∀ h x, divF h x = ord x (Additive.ofMul h) := fun h x => rfl

  let ρ : (X →₀ ℤ) → (IsDedekindDomain.HeightOneSpectrum Γ(X, U) →₀ ℤ) := fun D =>
    Finsupp.comapDomain (fun v : IsDedekindDomain.HeightOneSpectrum Γ(X, U) =>
      (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X)) D hinj.injOn
  have hρ : ∀ D v, ρ D v = D (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩) := fun D v =>
    Finsupp.comapDomain_apply _ _ _ _

  have hcl : ∀ D : X →₀ ℤ,
      (∃ f : (FractionRing Γ(X, U))ˣ, ∀ x, (ℓ : ℤ) * D x = ord x (Additive.ofMul f)) →
      (Additive.toMul (ψ₀ (ρ D))) ^ ℓ = 1 := by
    rintro D ⟨f, hf⟩
    have h0 : ψ₀ (ℓ • ρ D) = 0 := by
      rw [hψk]
      refine ⟨f, fun v => ?_⟩
      rw [Finsupp.smul_apply, nsmul_eq_mul, hρ, ← ho2 v f]
      exact hf _
    rw [← toMul_nsmul, ← map_nsmul, h0, toMul_zero]
  let Λ := {D : X →₀ ℤ //
    ∃ f : (FractionRing Γ(X, U))ˣ, ∀ x, (ℓ : ℤ) * D x = ord x (Additive.ofMul f)}
  let C := {c : ClassGroup Γ(X, U) // c ^ ℓ = 1}
  let cmap : Λ → C := fun D => ⟨Additive.toMul (ψ₀ (ρ D.1)), hcl D.1 D.2⟩
  haveI : Nonempty Λ := ⟨⟨0, 1, fun x => by simp⟩⟩
  let σ : C → Λ := Function.invFun cmap
  have hσ : ∀ D, cmap (σ (cmap D)) = cmap D := fun D => Function.invFun_eq ⟨D, rfl⟩

  let N : AddSubgroup (X →₀ ℤ) :=
    { carrier := {E | (∃ f : (FractionRing Γ(X, U))ˣ, ∀ x, (ℓ : ℤ) * E x = ord x (Additive.ofMul f))
        ∧ ∀ x, E x ≠ 0 → x ∈ (U : Set X)ᶜ}
      add_mem' := by
        rintro a b ⟨⟨fa, hfa⟩, hsa⟩ ⟨⟨fb, hfb⟩, hsb⟩
        refine ⟨⟨fa * fb, fun x => ?_⟩, fun x hx => ?_⟩
        · rw [Finsupp.add_apply, mul_add, hfa, hfb, ofMul_mul, map_add]
        · by_cases ha : a x = 0
          · apply hsb x
            rw [Finsupp.add_apply, ha, zero_add] at hx
            exact hx
          · exact hsa x ha
      zero_mem' := ⟨⟨1, fun x => by simp⟩, fun x hx => by simp at hx⟩
      neg_mem' := by
        rintro a ⟨⟨fa, hfa⟩, hsa⟩
        refine ⟨⟨fa⁻¹, fun x => ?_⟩, fun x hx => hsa x ?_⟩
        · rw [Finsupp.neg_apply, mul_neg, hfa, ofMul_inv, map_neg]
        · intro h0
          apply hx
          rw [Finsupp.neg_apply, h0, neg_zero] }
  have hNmem : ∀ E, E ∈ N ↔
      (∃ f : (FractionRing Γ(X, U))ˣ, ∀ x, (ℓ : ℤ) * E x = ord x (Additive.ofMul f)) ∧
        ∀ x, E x ≠ 0 → x ∈ (U : Set X)ᶜ := fun E => Iff.rfl

  have hNfg : ∃ S : Finset (X →₀ ℤ), (∀ s ∈ S, s ∈ N) ∧
      ∀ E ∈ N, E ∈ Submodule.span ℤ (↑S : Set (X →₀ ℤ)) := by
    haveI : Finite ↥((U : Set X)ᶜ) := hfin.to_subtype
    let M := AddSubgroup.toIntSubmodule N
    have hMle : M ≤ Finsupp.supported ℤ ℤ ((U : Set X)ᶜ) := by
      intro E hE
      have hE' : E ∈ N := hE
      rw [Finsupp.mem_supported]
      intro x hx
      exact ((hNmem E).mp hE').2 x (Finsupp.mem_support_iff.mp hx)
    haveI : IsNoetherian ℤ (Finsupp.supported ℤ ℤ ((U : Set X)ᶜ)) :=
      isNoetherian_of_linearEquiv
        (Finsupp.supportedEquivFinsupp (M := ℤ) (R := ℤ) ((U : Set X)ᶜ)).symm
    obtain ⟨S, hS⟩ := isNoetherian_submodule.mp inferInstance M hMle
    refine ⟨S, fun s hs => ?_, fun E hE => ?_⟩
    · have h1 : s ∈ M := hS ▸ Submodule.subset_span hs
      exact h1
    · rw [hS]
      exact hE
  obtain ⟨S, hSN, hSspan⟩ := hNfg

  let R : Finset (X →₀ ℤ) := (Finset.univ : Finset (S → Fin ℓ)).image
    (fun r => ∑ s : S, ((r s : ℕ) : ℤ) • (s : X →₀ ℤ))
  have hR : ∀ E ∈ N, ∃ r ∈ R, ∃ w ∈ N, E = r + ℓ • w := by
    intro E hE
    obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.mp (hSspan E hE)
    have hℓz : (0 : ℤ) < ℓ := by exact_mod_cast hℓpos
    let r : S → Fin ℓ := fun s => ⟨(c s % (ℓ : ℤ)).toNat, by
      have h1 := Int.emod_lt_of_pos (c s) hℓz
      have h2 := Int.emod_nonneg (c s) hℓz.ne'
      omega⟩
    refine ⟨∑ s : S, ((r s : ℕ) : ℤ) • (s : X →₀ ℤ), Finset.mem_image_of_mem _ (Finset.mem_univ r),
      ∑ s ∈ S, (c s / (ℓ : ℤ)) • s,
      AddSubgroup.sum_mem _ (fun s hs => AddSubgroup.zsmul_mem _ (hSN s hs) _), ?_⟩
    have hsplit : ∀ s ∈ S,
        c s • s = ((c s % (ℓ : ℤ)).toNat : ℤ) • s + ℓ • ((c s / (ℓ : ℤ)) • s) := by
      intro s _
      rw [← natCast_zsmul, smul_smul, ← add_smul]
      congr 1
      rw [Int.toNat_of_nonneg (Int.emod_nonneg _ hℓz.ne'), Int.emod_def]
      ring
    rw [← hc, Finset.sum_congr rfl hsplit, Finset.sum_add_distrib, Finset.smul_sum]
    congr 1
    exact (Finset.sum_coe_sort S (fun s => ((c s % (ℓ : ℤ)).toNat : ℤ) • s)).symm

  haveI : Fintype C := Fintype.ofFinite C
  let T : Finset (X →₀ ℤ) :=
    Finset.image₂ (· + ·) ((Finset.univ : Finset C).image (fun c => (σ c).1)) R
  refine ⟨T, fun D hD => ?_⟩
  let D₀ : Λ := σ (cmap ⟨D, hD⟩)
  have hc := hσ ⟨D, hD⟩
  have hψeq : ψ₀ (ρ D - ρ D₀.1) = 0 := by
    have h1 := congrArg Subtype.val hc
    have h2 : ψ₀ (ρ D₀.1) = ψ₀ (ρ D) := Additive.toMul.injective h1
    rw [map_sub, h2, sub_self]
  obtain ⟨h, hh⟩ := (hψk _).mp hψeq
  have hD' := hD
  obtain ⟨f, hf⟩ := hD'
  obtain ⟨f₀, hf₀⟩ := D₀.2
  let E : X →₀ ℤ := D - D₀.1 - divF h
  have hEx : ∀ x, E x = D x - D₀.1 x - ord x (Additive.ofMul h) := fun x => by
    simp only [E, Finsupp.sub_apply, hdivF]
  have hE : E ∈ N := by
    rw [hNmem]
    refine ⟨⟨f / f₀ / h ^ ℓ, fun x => ?_⟩, fun x hx => ?_⟩
    · rw [hEx, ofMul_div, ofMul_div, ofMul_pow, map_sub, map_sub, map_nsmul, nsmul_eq_mul,
        ← hf x, ← hf₀ x]
      ring
    · intro hxU
      apply hx
      rw [hEx]
      by_cases hxη : x = genericPoint X
      · subst hxη
        rw [ho1, hη D ⟨f, hf⟩, hη D₀.1 ⟨f₀, hf₀⟩]
        simp
      · obtain ⟨v, rfl⟩ := hpts x hxU hxη
        have h1 := hh v
        rw [Finsupp.sub_apply, hρ, hρ, ← ho2 v h] at h1
        rw [h1]
        ring
  obtain ⟨r, hr, w, hw, hEw⟩ := hR E hE
  obtain ⟨⟨fw, hfw⟩, -⟩ := (hNmem w).mp hw
  refine ⟨D₀.1 + r, Finset.mem_image₂_of_mem
    (Finset.mem_image_of_mem _ (Finset.mem_univ (cmap ⟨D, hD⟩))) hr, h * fw, fun x => ?_⟩
  have e1 : E x = r x + ℓ * w x := by
    rw [hEw, Finsupp.add_apply, Finsupp.smul_apply, nsmul_eq_mul]
  have e2 := hEx x
  rw [Finsupp.add_apply, ofMul_mul, map_add, ← hfw x]
  linarith

theorem closed_points_surjective_of_fibre_dim : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (Y Z : Scheme.{u}) (fY : Y ⟶ Spec (.of Ω)) (fZ : Z ⟶ Spec (.of Ω))
    [IrreducibleSpace Y] [LocallyOfFiniteType fY] [QuasiCompact fY] [IsSeparated fY]
    [IsProper fZ] (p : Z ⟶ Y), p ≫ fY = fZ → ∀ n e : ℕ,
    topologicalKrullDim Y = ((n : ℕ) : WithBot ℕ∞) →
    ((n + e : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim Z →
    (∀ y : Y, IsClosed ({y} : Set Y) →
      topologicalKrullDim (p ⁻¹' ({y} : Set Y)) ≤ ((e : ℕ) : WithBot ℕ∞)) →
    Function.Surjective p :=
by
  classical

  have s4 : ∀ (T : Type u) [TopologicalSpace T] [IrreducibleSpace T] (n k : ℕ),
      topologicalKrullDim T = ((n : ℕ) : WithBot ℕ∞) → ∀ W : Set T, IsClosed W → W ≠ Set.univ →
      ((k : ℕ) : WithBot ℕ∞) ≤ topologicalKrullDim W → k + 1 ≤ n := by
    intro T _ _ n k hT W hW hne hk
    obtain ⟨l, hl⟩ := Order.le_krullDim_iff.mp hk
    let f : TopologicalSpace.IrreducibleCloseds W → TopologicalSpace.IrreducibleCloseds T :=
      fun D => ⟨Subtype.val '' (D : Set W),
        D.isIrreducible.image _ continuous_subtype_val.continuousOn,
        hW.isClosedEmbedding_subtypeVal.isClosedMap _ D.isClosed⟩
    have hf : StrictMono f := by
      intro a b hab
      rw [← SetLike.coe_ssubset_coe] at hab ⊢
      change Subtype.val '' (a : Set W) ⊂ Subtype.val '' (b : Set W)
      refine Set.ssubset_iff_subset_ne.mpr ⟨Set.image_mono hab.subset, fun h => hab.ne ?_⟩
      exact (Set.image_injective.mpr Subtype.val_injective) h
    let top : TopologicalSpace.IrreducibleCloseds T :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ T, isClosed_univ⟩
    have hlast : (l.map f hf).last < top := by
      rw [← SetLike.coe_ssubset_coe]
      refine Set.ssubset_iff_subset_ne.mpr ⟨Set.subset_univ _, ?_⟩
      intro heq
      apply hne
      apply Set.eq_univ_of_univ_subset
      intro x _
      have hx : x ∈ ((l.map f hf).last : Set T) := by
        rw [heq]; trivial
      change x ∈ Subtype.val '' ((l.last : TopologicalSpace.IrreducibleCloseds W) : Set W) at hx
      obtain ⟨w, _, rfl⟩ := hx
      exact w.2
    have h1 := Order.LTSeries.length_le_krullDim ((l.map f hf).snoc top hlast)
    have h2 : ((l.map f hf).snoc top hlast).length = k + 1 := by
      simp [hl]
    rw [h2] at h1
    change _ ≤ topologicalKrullDim T at h1
    rw [hT] at h1
    exact_mod_cast h1

  have s1 : ∀ (X : Scheme.{u}) [CompactSpace X] (k : ℕ),
      (k : WithBot ℕ∞) ≤ topologicalKrullDim X →
      ∃ x : X, IsClosed ({x} : Set X) ∧ (k : WithBot ℕ∞) ≤ ringKrullDim (X.presheaf.stalk x) := by
    intro X _ k hk
    obtain ⟨l, hl⟩ := Order.le_krullDim_iff.mp hk
    obtain ⟨x, hx0, hx⟩ :=
      (l 0).isClosed.exists_closed_singleton (l 0).isIrreducible.nonempty
    have hxi : ∀ i, x ∈ (l i : Set X) := fun i =>
      (SetLike.coe_subset_coe.mpr (l.strictMono.monotone (Fin.zero_le i))) hx0
    have hgen : ∀ i, ∃ P : PrimeSpectrum (X.presheaf.stalk x),
        IsGenericPoint (X.fromSpecStalk x P) (l i : Set X) := by
      intro i
      obtain ⟨ξ, hξ⟩ := QuasiSober.sober (l i).isIrreducible (l i).isClosed
      have hsp : ξ ⤳ x := hξ.specializes (hxi i)
      have hr : ξ ∈ Set.range (X.fromSpecStalk x) := by
        rw [Scheme.range_fromSpecStalk]; exact hsp
      obtain ⟨P, hP⟩ := hr
      exact ⟨P, hP ▸ hξ⟩
    choose P hP using hgen
    have hemb := (X.fromSpecStalk x).isEmbedding.isInducing
    have hmono : StrictMono (fun i => OrderDual.toDual (P i)) := by
      intro i j hij
      have hlt : l i < l j := l.strictMono hij
      change P j < P i
      refine lt_of_le_not_ge ?_ ?_
      · rw [PrimeSpectrum.le_iff_specializes]
        refine hemb.specializes_iff.mp ?_
        rw [specializes_iff_mem_closure, (hP j).def]
        exact (SetLike.coe_subset_coe.mpr hlt.le) (hP i).mem
      · intro hle
        rw [PrimeSpectrum.le_iff_specializes] at hle
        have hle' := hemb.specializes_iff.mpr hle
        rw [specializes_iff_mem_closure, (hP i).def] at hle'
        apply hlt.not_ge
        rw [← SetLike.coe_subset_coe, ← (hP j).def]
        exact closure_minimal (Set.singleton_subset_iff.mpr hle') (l i).isClosed
    refine ⟨x, hx, ?_⟩
    have h := Order.LTSeries.length_le_krullDim
      (LTSeries.mk l.length (fun i => OrderDual.toDual (P i)) hmono :
        LTSeries (PrimeSpectrum (X.presheaf.stalk x))ᵒᵈ)
    rw [Order.krullDim_orderDual] at h
    rw [← hl]
    exact h

  have s2 : ∀ (X : Scheme.{u}) (x : X) (I : Ideal (X.presheaf.stalk x)) (C : Set X),
      (∀ P : PrimeSpectrum (X.presheaf.stalk x), I ≤ P.asIdeal → X.fromSpecStalk x P ∈ C) →
      ringKrullDim (X.presheaf.stalk x ⧸ I) ≤ topologicalKrullDim C := by
    intro X x I C hC
    rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
    have hemb : Topology.IsEmbedding (fun Q : PrimeSpectrum (X.presheaf.stalk x ⧸ I) =>
        X.fromSpecStalk x (PrimeSpectrum.comap (Ideal.Quotient.mk I) Q)) :=
      (X.fromSpecStalk x).isEmbedding.comp
        (PrimeSpectrum.isEmbedding_comap_of_surjective _ _ Ideal.Quotient.mk_surjective)
    have hmem : ∀ Q : PrimeSpectrum (X.presheaf.stalk x ⧸ I),
        X.fromSpecStalk x (PrimeSpectrum.comap (Ideal.Quotient.mk I) Q) ∈ C := by
      intro Q
      apply hC
      intro a ha
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr ha]
      exact Q.asIdeal.zero_mem
    exact (hemb.isInducing.codRestrict hmem).topologicalKrullDim_le

  have s3 : ∀ (R S : Type u) [CommRing R] [CommRing S] [IsNoetherianRing R] [IsNoetherianRing S]
      [IsLocalRing R] [IsLocalRing S] (φ : R →+* S) [IsLocalHom φ], ∃ t : ℕ,
      ringKrullDim (R ⧸ RingHom.ker φ) = (t : WithBot ℕ∞) ∧
      ringKrullDim S ≤ ringKrullDim (S ⧸ Ideal.map φ (IsLocalRing.maximalIdeal R)) + t := by
    intro R S _ _ _ _ _ _ φ _
    haveI : Nontrivial (R ⧸ RingHom.ker φ) :=
      Ideal.Quotient.nontrivial_iff.mpr (RingHom.ker_ne_top φ)
    haveI : IsLocalRing (R ⧸ RingHom.ker φ) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    set φ' := φ.kerLift with hφ'
    have hloc' : ∀ x : R ⧸ RingHom.ker φ, IsUnit (φ' x) → IsUnit x := by
      intro x hx
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [hφ', RingHom.kerLift_mk] at hx
      exact (isUnit_of_map_unit φ r hx).map _
    obtain ⟨tb, hmin, hcard⟩ :=
      Ideal.exists_finset_card_eq_height_of_isNoetherianRing
        (IsLocalRing.maximalIdeal (R ⧸ RingHom.ker φ))
    refine ⟨tb.card, ?_, ?_⟩
    · rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, ← hcard]
      rfl
    · have htb : ∀ t ∈ tb, φ' t ∈ IsLocalRing.maximalIdeal S := by
        intro t ht
        have htm : t ∈ IsLocalRing.maximalIdeal (R ⧸ RingHom.ker φ) :=
          hmin.1.2 (Ideal.subset_span ht)
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at htm ⊢
        exact fun h => htm (hloc' t h)
      set u := tb.image φ' with hu
      have hujac : (u : Set S) ⊆ (Ring.jacobson S : Set S) := by
        intro s hs
        rw [hu, Finset.coe_image] at hs
        obtain ⟨t, ht, rfl⟩ := hs
        rw [← Ideal.jacobson_bot]
        exact IsLocalRing.maximalIdeal_le_jacobson _ (htb t ht)
      have h1 := ringKrullDim_le_ringKrullDim_quotient_add_card u hujac
      have hsub : PrimeSpectrum.zeroLocus (↑(Ideal.span (u : Set S)) : Set S) ⊆
          PrimeSpectrum.zeroLocus
            (↑(Ideal.map φ (IsLocalRing.maximalIdeal R)) : Set S) := by
        intro Q hQ
        rw [PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe] at hQ ⊢
        have hq : Ideal.span (tb : Set (R ⧸ RingHom.ker φ)) ≤ Q.asIdeal.comap φ' := by
          rw [Ideal.span_le]
          intro t ht
          rw [SetLike.mem_coe, Ideal.mem_comap]
          apply hQ
          apply Ideal.subset_span
          rw [hu, Finset.coe_image]
          exact ⟨t, ht, rfl⟩
        have hqm : Q.asIdeal.comap φ' ≤ IsLocalRing.maximalIdeal (R ⧸ RingHom.ker φ) :=
          IsLocalRing.le_maximalIdeal (Ideal.IsPrime.comap φ').ne_top
        have hmq : IsLocalRing.maximalIdeal (R ⧸ RingHom.ker φ) ≤ Q.asIdeal.comap φ' :=
          Minimal.le_of_le (P := fun q : Ideal (R ⧸ RingHom.ker φ) =>
            q.IsPrime ∧ Ideal.span (tb : Set (R ⧸ RingHom.ker φ)) ≤ q) hmin
            ⟨Ideal.IsPrime.comap φ', hq⟩ hqm
        rw [Ideal.map_le_iff_le_comap]
        intro r hr
        have hmk : Ideal.Quotient.mk (RingHom.ker φ) r ∈
            IsLocalRing.maximalIdeal (R ⧸ RingHom.ker φ) := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
          intro h
          have h' := h.map φ'
          rw [hφ', RingHom.kerLift_mk] at h'
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hr
          exact hr (isUnit_of_map_unit φ r h')
        have := hmq hmk
        rw [Ideal.mem_comap, hφ', RingHom.kerLift_mk] at this
        exact this
      have h2 : ringKrullDim (S ⧸ Ideal.span (u : Set S)) ≤
          ringKrullDim (S ⧸ Ideal.map φ (IsLocalRing.maximalIdeal R)) := by
        rw [ringKrullDim_quotient, ringKrullDim_quotient]
        exact Order.krullDim_le_of_strictMono (fun x => ⟨x.1, hsub x.2⟩) (fun a b hab => hab)
      have h3 : (u.card : WithBot ℕ∞) ≤ (tb.card : WithBot ℕ∞) :=
        Nat.mono_cast Finset.card_image_le
      calc ringKrullDim S ≤ ringKrullDim (S ⧸ Ideal.span (u : Set S)) + u.card := h1
        _ ≤ ringKrullDim (S ⧸ Ideal.map φ (IsLocalRing.maximalIdeal R)) + tb.card :=
          add_le_add h2 h3

  intro Ω _ _ Y Z fY fZ _ _ _ _ _ p hcomm n e hY hZ hfib
  haveI : UniversallyClosed (p ≫ fY) := by rw [hcomm]; infer_instance
  haveI : UniversallyClosed p := UniversallyClosed.of_comp_of_isSeparated p fY
  have hpc : IsClosedMap p := p.isClosedMap
  have hW : IsClosed (Set.range p) := hpc.isClosed_range
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian fY
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian fZ
  haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace fZ
  obtain ⟨z, hz, hdimz⟩ := s1 Z (n + e) hZ
  have hy : IsClosed ({p z} : Set Y) := by
    rw [← Set.image_singleton]; exact hpc _ hz
  obtain ⟨t, ht, hS⟩ := s3 _ _ (p.stalkMap z).hom
  have hsq : ∀ Q : PrimeSpectrum (Z.presheaf.stalk z),
      Y.fromSpecStalk (p z) (PrimeSpectrum.comap (p.stalkMap z).hom Q) =
        p (Z.fromSpecStalk z Q) := by
    intro Q
    have h : ∀ x, (Spec.map (p.stalkMap z) ≫ Y.fromSpecStalk (p z)) x =
        (Z.fromSpecStalk z ≫ p) x := fun x => by
      rw [Scheme.SpecMap_stalkMap_fromSpecStalk]
    have h2 := h (show (Spec (Z.presheaf.stalk z) : Scheme) from Q)
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h2
    exact h2
  have hb : ringKrullDim (Z.presheaf.stalk z ⧸ Ideal.map (p.stalkMap z).hom
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk (p z)))) ≤ ((e : ℕ) : WithBot ℕ∞) := by
    refine le_trans (s2 Z z _ (p ⁻¹' ({p z} : Set Y)) ?_) (hfib _ hy)
    intro Q hQ
    rw [Set.mem_preimage, Set.mem_singleton_iff, ← hsq]
    have hc : PrimeSpectrum.comap (p.stalkMap z).hom Q =
        IsLocalRing.closedPoint (Y.presheaf.stalk (p z)) := by
      ext1
      rw [PrimeSpectrum.comap_asIdeal]
      symm
      exact (IsLocalRing.maximalIdeal.isMaximal _).eq_of_le
        (Ideal.IsPrime.comap (p.stalkMap z).hom).ne_top (Ideal.map_le_iff_le_comap.mp hQ)
    rw [hc, Scheme.fromSpecStalk_closedPoint]
  have ha : (t : WithBot ℕ∞) ≤ topologicalKrullDim (Set.range p) := by
    rw [← ht]
    refine s2 Y (p z) (RingHom.ker (p.stalkMap z).hom) _ ?_
    intro P hP
    have hPcl : P ∈ closure (Set.range (PrimeSpectrum.comap (p.stalkMap z).hom)) := by
      rw [PrimeSpectrum.closure_range_comap, PrimeSpectrum.mem_zeroLocus]
      exact hP
    have := map_mem_closure (Y.fromSpecStalk (p z)).continuous hPcl
      (t := Set.range p) (by rintro _ ⟨Q, rfl⟩; exact ⟨_, (hsq Q).symm⟩)
    rwa [hW.closure_eq] at this
  by_contra hns
  have hne : Set.range p ≠ Set.univ := fun h => hns (Set.range_eq_univ.mp h)
  have h4 := s4 Y n t hY _ hW hne ha
  have h5 : ((n + e : ℕ) : WithBot ℕ∞) ≤ ((e + t : ℕ) : WithBot ℕ∞) := by
    calc ((n + e : ℕ) : WithBot ℕ∞) ≤ ringKrullDim (Z.presheaf.stalk z) := hdimz
      _ ≤ _ := hS
      _ ≤ ((e : ℕ) : WithBot ℕ∞) + (t : WithBot ℕ∞) := add_le_add hb le_rfl
      _ = ((e + t : ℕ) : WithBot ℕ∞) := by push_cast; rfl
  have h6 : n + e ≤ e + t := by exact_mod_cast h5
  omega

theorem wc_curve_ord_transport : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ord : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ord →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ord D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ord D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∃ (σ : X ≃ X) (ordT : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ),
      (∀ x ∈ U, σ x = x) ∧ (∀ x, ord x = ordT (σ x)) ∧
      wcCurveOrdData Ω X fX U hU ordT ∧ wcTrueOrd X U ordT :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ord hord g c hRR
  classical
  obtain ⟨C1, C2, C3, C4, C5, C6⟩ := hord

  have s6 : ∀ (G : Type u) [AddCommGroup G] (o μ : G →+ ℤ), (∃ π, o π = 1) → (∃ t, μ t = 1) →
      (∀ m, 0 ≤ o m → 0 ≤ μ m) → μ = o := by
    intro G _ o μ hπ ht hcone
    obtain ⟨π, hπ⟩ := hπ
    obtain ⟨t, ht⟩ := ht
    have hker : ∀ m, o m = 0 → μ m = 0 := by
      intro m hm
      have h1 := hcone m (by omega)
      have h2 := hcone (-m) (by rw [map_neg]; omega)
      rw [map_neg] at h2
      omega
    have hlin : ∀ m, μ m = o m * μ π := by
      intro m
      have := hker (m - (o m) • π) (by rw [map_sub, map_zsmul, hπ, smul_eq_mul, mul_one, sub_self])
      rw [map_sub, map_zsmul, smul_eq_mul, sub_eq_zero] at this
      exact this
    have hc0 : 0 ≤ μ π := hcone π (by rw [hπ]; omega)
    have hc1 : μ π = 1 := Int.eq_one_of_mul_eq_one_left hc0 (by rw [← hlin, ht])
    ext m
    rw [hlin, hc1, mul_one]

  have s5 : ∀ (L : Type u) [Field L] (μ : Additive Lˣ →+ ℤ),
      (∀ a b h : Lˣ, (h : L) = (a : L) + (b : L) →
        min (μ (Additive.ofMul a)) (μ (Additive.ofMul b)) ≤ μ (Additive.ofMul h)) →
      ∃ R : ValuationSubring L, ∀ (g : L) (hg : g ≠ 0),
        g ∈ R ↔ 0 ≤ μ (Additive.ofMul (Units.mk0 g hg)) := by
    intro L _ μ hult
    let ν : L → ℤ := fun g => if hg : g = 0 then 0 else μ (Additive.ofMul (Units.mk0 g hg))
    have hν : ∀ g (hg : g ≠ 0), ν g = μ (Additive.ofMul (Units.mk0 g hg)) :=
      fun g hg => dif_neg hg
    have hmul : ∀ g h (hg : g ≠ 0) (hh : h ≠ 0), ν (g * h) = ν g + ν h := by
      intro g h hg hh
      rw [hν _ (mul_ne_zero hg hh), hν g hg, hν h hh, ← map_add, ← ofMul_mul]
      congr 2
      ext
      simp
    have hone : ν 1 = 0 := by
      rw [hν 1 one_ne_zero]
      have : Units.mk0 (1 : L) one_ne_zero = 1 := by ext; simp
      rw [this, ofMul_one, map_zero]
    have hm1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
    have hnegone : ν (-1) = 0 := by
      have h := hmul (-1) (-1) hm1 hm1
      rw [neg_one_mul, neg_neg, hone] at h
      omega
    have hinv : ∀ g (hg : g ≠ 0), ν g⁻¹ = - ν g := by
      intro g hg
      have h := hmul g g⁻¹ hg (inv_ne_zero hg)
      rw [mul_inv_cancel₀ hg, hone] at h
      omega
    let S : Subring L :=
      { carrier := {g | g = 0 ∨ 0 ≤ ν g}
        mul_mem' := by
          intro a b ha hb
          by_cases ha0 : a = 0
          · left; simp [ha0]
          by_cases hb0 : b = 0
          · left; simp [hb0]
          right
          rcases ha with ha | ha
          · exact absurd ha ha0
          rcases hb with hb | hb
          · exact absurd hb hb0
          rw [hmul a b ha0 hb0]; omega
        one_mem' := Or.inr (by rw [hone])
        add_mem' := by
          intro a b ha hb
          by_cases ha0 : a = 0
          · rw [ha0, zero_add]; exact hb
          by_cases hb0 : b = 0
          · rw [hb0, add_zero]; exact ha
          by_cases hab : a + b = 0
          · left; exact hab
          right
          rcases ha with ha | ha
          · exact absurd ha ha0
          rcases hb with hb | hb
          · exact absurd hb hb0
          have := hult (Units.mk0 a ha0) (Units.mk0 b hb0) (Units.mk0 (a + b) hab) (by simp)
          rw [hν a ha0] at ha
          rw [hν b hb0] at hb
          rw [hν _ hab]
          exact le_trans (le_min ha hb) this
        zero_mem' := Or.inl rfl
        neg_mem' := by
          intro a ha
          by_cases ha0 : a = 0
          · left; simp [ha0]
          right
          rcases ha with ha | ha
          · exact absurd ha ha0
          rw [show -a = -1 * a by ring, hmul (-1) a hm1 ha0, hnegone]; omega }
    refine ⟨⟨S, fun x => ?_⟩, fun g hg => ?_⟩
    · by_cases hx : x = 0
      · left; exact Or.inl hx
      rcases le_total 0 (ν x) with h | h
      · left; exact Or.inr h
      · right; right; rw [hinv x hx]; omega
    · show g = 0 ∨ 0 ≤ ν g ↔ _
      rw [hν g hg]
      constructor
      · rintro (h | h)
        · exact absurd h hg
        · exact h
      · exact Or.inr

  have s2 : ∀ (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
      (K : Type u) [Field K] [Algebra O K] [IsFractionRing O K] (R : Subring K),
      (∀ r : O, algebraMap O K r ∈ R) → (∃ g : K, g ∉ R) →
      ∀ g ∈ R, ∃ r : O, algebraMap O K r = g := by
    intro O _ _ _ K _ _ _ R hOR hne g hg
    obtain ⟨h₀, hh₀⟩ := hne
    by_contra hcon
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
    have hϖ0 : algebraMap O K ϖ ≠ 0 := by
      intro h
      apply hϖ.ne_zero
      apply IsFractionRing.injective O K
      rw [h, map_zero]
    have hg0 : g ≠ 0 := by
      rintro rfl
      exact hcon ⟨0, map_zero _⟩
    obtain ⟨r, hr⟩ : ∃ r : O, algebraMap O K r = g⁻¹ := by
      rcases ValuationRing.isInteger_or_isInteger O g with h | h
      · exact absurd (RingHom.mem_rangeS.mp h) hcon
      · exact RingHom.mem_rangeS.mp h
    have hr0 : r ≠ 0 := by
      rintro rfl
      rw [map_zero] at hr
      exact inv_ne_zero hg0 hr.symm
    obtain ⟨n, u, hru⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr0 hϖ
    have hn : n ≠ 0 := by
      rintro rfl
      apply hcon
      refine ⟨((u⁻¹ : Oˣ) : O), ?_⟩
      have h1 : algebraMap O K (u : O) = g⁻¹ := by rw [← hr, hru, pow_zero, mul_one]
      rw [map_units_inv, h1, inv_inv]
    obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
    have hinvϖ : (algebraMap O K ϖ)⁻¹ ∈ R := by
      have key : g * algebraMap O K (u : O) * algebraMap O K (ϖ ^ k) = (algebraMap O K ϖ)⁻¹ := by
        apply eq_inv_of_mul_eq_one_left
        have h1 : algebraMap O K r = algebraMap O K (u : O) * algebraMap O K ϖ ^ (k + 1) := by
          rw [hru, map_mul, map_pow]
        rw [map_pow, mul_assoc, mul_assoc, ← pow_succ, ← h1, hr, mul_inv_cancel₀ hg0]
      rw [← key]
      exact R.mul_mem (R.mul_mem hg (hOR _)) (hOR _)
    apply hh₀
    rcases ValuationRing.isInteger_or_isInteger O h₀ with h1 | h1
    · obtain ⟨a, ha⟩ := RingHom.mem_rangeS.mp h1
      rw [← ha]
      exact hOR a
    · obtain ⟨a, ha⟩ := RingHom.mem_rangeS.mp h1
      by_cases ha0 : a = 0
      · have : h₀ = 0 := by
          rw [ha0, map_zero] at ha
          exact inv_eq_zero.mp ha.symm
        rw [this]
        exact R.zero_mem
      obtain ⟨m, v, hav⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha0 hϖ
      have : h₀ = algebraMap O K ((v⁻¹ : Oˣ) : O) * ((algebraMap O K ϖ)⁻¹) ^ m := by
        rw [map_units_inv, inv_pow, ← mul_inv, ← map_pow, ← map_mul, ← hav, ha, inv_inv]
      rw [this]
      exact R.mul_mem (hOR _) (R.pow_mem hinvϖ m)

  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X

  have s4 : ∀ (R : ValuationSubring X.functionField),
      (∀ c : Ω, (X.presheaf.germ ⊤ (genericPoint X) trivial).hom
        (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c)) ∈ R) →
      (∃ g : X.functionField, g ∉ R) →
      ∃ z : X, z ≠ genericPoint X ∧
        ∀ r : X.presheaf.stalk z, algebraMap (X.presheaf.stalk z) X.functionField r ∈ R := by
    intro R hc hg
    have hF : ∀ y : X, X.fromSpecStalk y ≫ fX = Spec.map ((Scheme.ΓSpecIso (.of Ω)).inv ≫
        fX.appTop ≫ X.presheaf.germ ⊤ y trivial) := by
      intro y
      have h1 := Scheme.toSpecΓ_naturality fX
      have h2 : (Spec (CommRingCat.of Ω)).toSpecΓ = Spec.map (Scheme.ΓSpecIso (.of Ω)).hom := by
        rw [← Scheme.isoSpec_hom, Scheme.isoSpec_Spec_hom]
      have h3 : fX = X.toSpecΓ ≫ Spec.map fX.appTop ≫ Spec.map (Scheme.ΓSpecIso (.of Ω)).inv := by
        rw [← Category.assoc, ← h1, h2, Category.assoc, ← Spec.map_comp, Iso.inv_hom_id,
          Spec.map_id, Category.comp_id]
      calc X.fromSpecStalk y ≫ fX
          = X.fromSpecStalk y ≫ (X.toSpecΓ ≫ Spec.map fX.appTop ≫
              Spec.map (Scheme.ΓSpecIso (.of Ω)).inv) := congrArg _ h3
        _ = _ := by
          rw [← Category.assoc, Scheme.fromSpecStalk_toSpecΓ, ← Spec.map_comp, ← Spec.map_comp,
            Category.assoc]
    let κ : Ω →+* X.functionField := ((Scheme.ΓSpecIso (.of Ω)).inv ≫
        fX.appTop ≫ X.presheaf.germ ⊤ (genericPoint X) trivial).hom
    let ψ : Ω →+* R := κ.codRestrict R hc
    have hcomm : X.fromSpecStalk (genericPoint X) ≫ fX =
        Spec.map (CommRingCat.ofHom (algebraMap R X.functionField)) ≫
          Spec.map (CommRingCat.ofHom ψ) := by
      rw [hF, ← Spec.map_comp]
      congr 1
    have hVC : ValuativeCriterion fX :=
      (IsProper.eq_valuativeCriterion ▸ (inferInstance : IsProper fX)).1.1.1
    let S₀ : ValuativeCommSq fX :=
      { R := R, K := X.functionField, i₁ := X.fromSpecStalk (genericPoint X),
        i₂ := Spec.map (CommRingCat.ofHom ψ), commSq := ⟨hcomm⟩ }
    obtain ⟨l, hl⟩ : ∃ l : Spec (CommRingCat.of R) ⟶ X,
        Spec.map (CommRingCat.ofHom (algebraMap R X.functionField)) ≫ l =
          X.fromSpecStalk (genericPoint X) := by
      haveI := ValuativeCriterion.existence hVC S₀
      exact ⟨S₀.commSq.lift, S₀.commSq.fac_left⟩
    have key : Scheme.stalkClosedPointTo l ≫ CommRingCat.ofHom (algebraMap R X.functionField) =
        X.presheaf.stalkSpecializes (genericPoint_specializes _) := by
      rw [← Spec.map_inj, Spec.map_comp, ← cancel_mono (X.fromSpecStalk _), Category.assoc,
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk, hl,
        Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
    have hcont : ∀ r : X.presheaf.stalk (l (IsLocalRing.closedPoint (CommRingCat.of R))),
        algebraMap (X.presheaf.stalk _) X.functionField r ∈ R := by
      intro r
      have h : (CommRingCat.ofHom (algebraMap R X.functionField)).hom
          ((Scheme.stalkClosedPointTo l).hom r) =
          algebraMap (X.presheaf.stalk _) X.functionField r := by
        rw [show (CommRingCat.ofHom (algebraMap R X.functionField)).hom
            ((Scheme.stalkClosedPointTo l).hom r) = (Scheme.stalkClosedPointTo l ≫
              CommRingCat.ofHom (algebraMap R X.functionField)).hom r from rfl, key]
        rfl
      rw [← h]
      exact ((Scheme.stalkClosedPointTo l).hom r).2
    obtain ⟨z, hz⟩ : ∃ z : X, ∀ r : X.presheaf.stalk z,
        algebraMap (X.presheaf.stalk z) X.functionField r ∈ R := ⟨_, hcont⟩
    refine ⟨z, ?_, hz⟩
    rintro rfl
    obtain ⟨g, hgR⟩ := hg
    apply hgR
    have h := hz g
    change (X.presheaf.stalkSpecializes (genericPoint_specializes (genericPoint X))).hom g ∈ R at h
    rw [TopCat.Presheaf.stalkSpecializes_refl] at h
    exact h

  have hclosed : ∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X) := fun y hy =>
    (wc_curve_points_closed_opens_compact Ω X fX hdim).1 {y} (Set.finite_singleton y)
      (fun h => hy (Set.mem_singleton_iff.mp h).symm)
  have hDVR : ∀ x : X, x ≠ genericPoint X → IsDiscreteValuationRing (X.presheaf.stalk x) :=
    wc_curve_stalk_dvr Ω X fX (fun x => (hnorm x).2) hclosed
  have hP5 := wc_dedekind_affine_points X U hU
  haveI : Nonempty U := ⟨⟨genericPoint X, hP5.1⟩⟩
  obtain ⟨x₀⟩ : Nonempty X := IrreducibleSpace.toNonempty
  haveI : Nonempty (⊤ : X.Opens) := ⟨⟨x₀, trivial⟩⟩
  letI : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  let α := FractionRing.algEquiv Γ(X, U) X.functionField
  let E : Additive (FractionRing Γ(X, U))ˣ ≃+ Additive (X.functionField)ˣ :=
    MulEquiv.toAdditive (Units.mapEquiv α.toMulEquiv)
  let φ : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
  have T1 : ∀ s : Γ(X, ⊤), α (algebraMap Γ(X, U) (FractionRing Γ(X, U))
      ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom s)) = (X.germToFunctionField ⊤).hom s := by
    intro s
    rw [AlgEquiv.commutes]
    exact TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE le_top) (genericPoint X) _ s
  have hEsymm : ∀ (u : (FractionRing Γ(X, U))ˣ) (g : X.functionField) (hg : g ≠ 0),
      α (u : FractionRing Γ(X, U)) = g → E.symm (Additive.ofMul (Units.mk0 g hg)) =
        Additive.ofMul u := by
    intro u g hg hu
    apply E.injective
    rw [AddEquiv.apply_symm_apply]
    show Additive.ofMul (Units.mk0 g hg) = Additive.ofMul (Units.mapEquiv α.toMulEquiv u)
    congr 1
    ext
    exact hu.symm
  have hαne : ∀ f : (FractionRing Γ(X, U))ˣ, α (f : FractionRing Γ(X, U)) ≠ 0 := fun f h =>
    f.ne_zero (α.injective (h.trans (map_zero α).symm))
  have hηU : genericPoint X ∈ U := hP5.1
  have hgU : ∀ a : Γ(X, U), α (algebraMap Γ(X, U) (FractionRing Γ(X, U)) a) =
      (X.presheaf.germ U (genericPoint X) hηU).hom a := fun a => AlgEquiv.commutes α a

  have s1 : ∀ (x : X) (f : (FractionRing Γ(X, U))ˣ), wcStalkReg X U x f ↔
      ∃ t : X.presheaf.stalk x,
        algebraMap (X.presheaf.stalk x) X.functionField t = α (f : FractionRing Γ(X, U)) := by
    intro x f
    constructor
    · rintro ⟨V, hxV, s, a, b, hb, hfab, hres⟩
      have hηV : genericPoint X ∈ V := (genericPoint_specializes x).mem_open V.isOpen hxV
      have hηVU : genericPoint X ∈ V ⊓ U := ⟨hηV, hηU⟩
      have e1 : algebraMap (X.presheaf.stalk x) X.functionField ((X.presheaf.germ V x hxV).hom s) =
          (X.presheaf.germ V (genericPoint X) hηV).hom s :=
        TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hxV _ s
      have r1 : (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).hom s) =
          (X.presheaf.germ V (genericPoint X) hηV).hom s :=
        TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE inf_le_left) (genericPoint X) hηVU s
      have r2 : ∀ a : Γ(X, U), (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom a) =
          (X.presheaf.germ U (genericPoint X) hηU).hom a := fun a =>
        TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE inf_le_right) (genericPoint X) hηVU a
      have e2 : (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).hom s *
            (X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom b) =
          (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
            ((X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom a) := by
        rw [hres]
      rw [map_mul, r1, r2, r2] at e2
      have e3 : α ((f : FractionRing Γ(X, U)) * algebraMap Γ(X, U) (FractionRing Γ(X, U)) b) =
          α (algebraMap Γ(X, U) (FractionRing Γ(X, U)) a) := by rw [hfab]
      rw [map_mul, hgU, hgU] at e3
      have hb0 : (X.presheaf.germ U (genericPoint X) hηU).hom b ≠ 0 := by
        rw [← hgU]
        intro h
        exact hb (α.injective (h.trans (map_zero α).symm))
      refine ⟨(X.presheaf.germ V x hxV).hom s, ?_⟩
      rw [e1]
      exact mul_right_cancel₀ hb0 (e2.trans e3.symm)
    · rintro ⟨t, ht⟩
      obtain ⟨V, hxV, s, hs⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf t
      have hs' : (X.presheaf.germ V x hxV).hom s = t := hs
      obtain ⟨a, b, hbm, hab⟩ := IsFractionRing.div_surjective Γ(X, U) (f : FractionRing Γ(X, U))
      have hb : algebraMap Γ(X, U) (FractionRing Γ(X, U)) b ≠ 0 :=
        IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hbm
      have hfab : (f : FractionRing Γ(X, U)) * algebraMap Γ(X, U) (FractionRing Γ(X, U)) b =
          algebraMap Γ(X, U) (FractionRing Γ(X, U)) a := by
        rw [← hab, div_mul_cancel₀ _ hb]
      have hηV : genericPoint X ∈ V := (genericPoint_specializes x).mem_open V.isOpen hxV
      have hηVU : genericPoint X ∈ V ⊓ U := ⟨hηV, hηU⟩
      have e1 : algebraMap (X.presheaf.stalk x) X.functionField ((X.presheaf.germ V x hxV).hom s) =
          (X.presheaf.germ V (genericPoint X) hηV).hom s :=
        TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hxV _ s
      have r1 : (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).hom s) =
          (X.presheaf.germ V (genericPoint X) hηV).hom s :=
        TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE inf_le_left) (genericPoint X) hηVU s
      have r2 : ∀ a : Γ(X, U), (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom a) =
          (X.presheaf.germ U (genericPoint X) hηU).hom a := fun a =>
        TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE inf_le_right) (genericPoint X) hηVU a
      refine ⟨V, hxV, s, a, b, hb, hfab, ?_⟩
      have key : (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
          ((X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).hom s *
            (X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom b) =
          (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom
            ((X.presheaf.map (homOfLE (inf_le_right : V ⊓ U ≤ U)).op).hom a) := by
        rw [map_mul, r1, r2, r2, ← e1, hs', ht, ← hgU, ← hgU, ← map_mul, hfab]
      exact germ_injective_of_isIntegral X (genericPoint X) hηVU key

  have hconeU : ∀ (v : IsDedekindDomain.HeightOneSpectrum Γ(X, U)) (f : (FractionRing Γ(X, U))ˣ),
      (0 ≤ FractionalIdeal.count (FractionRing Γ(X, U)) v
        (FractionalIdeal.spanSingleton (nonZeroDivisors Γ(X, U)) (f : FractionRing Γ(X, U))) ↔
      ∃ t : X.presheaf.stalk (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩),
        algebraMap _ X.functionField t = α (f : FractionRing Γ(X, U))) := by
    intro v f
    have hxU : (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩ : X) ∈ U := (hP5.2.2.1 v).1
    have hx := (hP5.2.2.1 v).2
    haveI := hDVR _ hx
    let xU : U := ⟨_, hxU⟩
    have hp : hU.primeIdealOf xU = ⟨v.asIdeal, v.isPrime⟩ := by
      apply hU.fromSpec.injective
      rw [hU.fromSpec_primeIdealOf xU]
    letI : Algebra Γ(X, U) (X.presheaf.stalk (xU : X)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf xU
    haveI : IsLocalization.AtPrime (X.presheaf.stalk (xU : X)) v.asIdeal := by
      have := hU.isLocalization_stalk xU
      rw [hp] at this
      exact this
    haveI : IsScalarTower Γ(X, U) (X.presheaf.stalk (xU : X)) X.functionField :=
      functionField_isScalarTower X U xU
    let w : IsDedekindDomain.HeightOneSpectrum (X.presheaf.stalk (xU : X)) :=
      ⟨IsLocalRing.maximalIdeal _, (IsLocalRing.maximalIdeal.isMaximal _).isPrime,
        IsDiscreteValuationRing.not_a_field _⟩
    rw [← dedekind_count_localization Γ(X, U) v (X.presheaf.stalk (xU : X)) X.functionField w
      (f : FractionRing Γ(X, U)) f.ne_zero]
    exact (dvr_count_spanSingleton (X.presheaf.stalk (xU : X)) X.functionField w _ (hαne f)).1.symm

  have hinner : ∀ u : X, u ∈ U → u ≠ genericPoint X → ∀ f : (FractionRing Γ(X, U))ˣ,
      (0 ≤ ord u (Additive.ofMul f) ↔ ∃ t : X.presheaf.stalk u,
        algebraMap _ X.functionField t = α (f : FractionRing Γ(X, U))) := by
    intro u hu huη f
    obtain ⟨v, rfl⟩ := hP5.2.2.2 u hu huη
    rw [C2 v f]
    exact hconeU v f

  have hinjord : ∀ x₁ x₂ : X, x₁ ≠ genericPoint X → x₂ ≠ genericPoint X → ord x₁ = ord x₂ →
      x₁ = x₂ := by
    intro x₁ x₂ h1 h2 heq
    by_contra hne
    obtain ⟨D₁, hD₁⟩ : ∃ D : X →₀ ℤ, D = Finsupp.single x₁ (c : ℤ) + Finsupp.single x₂ (c : ℤ) :=
      ⟨_, rfl⟩
    obtain ⟨D₂, hD₂⟩ : ∃ D : X →₀ ℤ,
        D = Finsupp.single x₁ (c : ℤ) + Finsupp.single x₂ ((c : ℤ) + 1) := ⟨_, rfl⟩
    have hD₁η : D₁ (genericPoint X) = 0 := by simp [hD₁, Finsupp.single_apply, h1, h2]
    have hD₂η : D₂ (genericPoint X) = 0 := by simp [hD₂, Finsupp.single_apply, h1, h2]
    have hdeg₁ : D₁.sum (fun _ k => k) = 2 * (c : ℤ) := by
      rw [hD₁, Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
        Finsupp.sum_single_index rfl, Finsupp.sum_single_index rfl]
      ring
    have hdeg₂ : D₂.sum (fun _ k => k) = 2 * (c : ℤ) + 1 := by
      rw [hD₂, Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
        Finsupp.sum_single_index rfl, Finsupp.sum_single_index rfl]
      ring
    have hv1 : D₂ x₁ = c := by simp [hD₂, Finsupp.single_apply, Ne.symm hne]
    have hv2 : D₁ x₂ = c := by simp [hD₁, Finsupp.single_apply, hne]
    have hle : ∀ y, D₁ y ≤ D₂ y := by
      intro y
      rw [hD₁, hD₂]
      simp only [Finsupp.add_apply, Finsupp.single_apply]
      split_ifs <;> omega
    have hspace : wcRRSpace Ω X fX U ord D₁ = wcRRSpace Ω X fX U ord D₂ := by
      unfold wcRRSpace
      congr 1
      ext f
      simp only [Set.mem_setOf_eq]
      constructor
      · rintro ⟨hf, H⟩
        refine ⟨hf, fun y => ?_⟩
        have := H y
        have := hle y
        omega
      · rintro ⟨hf, H⟩
        refine ⟨hf, fun y => ?_⟩
        by_cases hy : y = x₂
        · rw [hy, hv2, ← heq]
          have h1' := H x₁
          rw [hv1] at h1'
          exact h1'
        · have hv : D₁ y = D₂ y := by
            rw [hD₁, hD₂]
            simp [Finsupp.single_apply, Ne.symm hy]
          rw [hv]
          exact H y
    have hc1 : (c : ℤ) ≤ D₁.sum (fun _ k => k) := by rw [hdeg₁]; omega
    have hc2 : (c : ℤ) ≤ D₂.sum (fun _ k => k) := by rw [hdeg₂]; omega
    have e1 := (hRR D₁ hD₁η hc1).2
    have e2 := (hRR D₂ hD₂η hc2).2
    rw [hspace, hdeg₁] at e1
    rw [hdeg₂] at e2
    omega

  have hconeeq : ∀ x₁ x₂ : X, x₁ ≠ genericPoint X → x₂ ≠ genericPoint X →
      (∀ f : (FractionRing Γ(X, U))ˣ,
        0 ≤ ord x₁ (Additive.ofMul f) ↔ 0 ≤ ord x₂ (Additive.ofMul f)) → x₁ = x₂ := by
    intro x₁ x₂ h1 h2 H
    apply hinjord x₁ x₂ h1 h2
    refine (s6 _ (ord x₁) (ord x₂) (C4 x₁ h1) (C4 x₂ h2) (fun m hm => ?_)).symm
    exact (H (Additive.toMul m)).mp hm

  have hconst_kill : ∀ (x : X) (c' : Ω) (hc : wcCurveConst Ω X fX U c' ≠ 0),
      ord x (Additive.ofMul (Units.mk0 _ hc)) = 0 := by
    intro x c' hc
    have hA := (C6 (Units.mk0 _ hc)).mpr ⟨c', rfl⟩ x
    have hc' : wcCurveConst Ω X fX U c'⁻¹ ≠ 0 := by rw [map_inv₀]; exact inv_ne_zero hc
    have hinv : (Units.mk0 _ hc)⁻¹ = Units.mk0 _ hc' := by ext; simp [map_inv₀]
    have hB := (C6 (Units.mk0 _ hc')).mpr ⟨c'⁻¹, rfl⟩ x
    rw [← hinv, ofMul_inv, map_neg] at hB
    omega

  have hbound : ∀ x : X, x ∉ U → ∃ z : X, z ≠ genericPoint X ∧ ∀ f : (FractionRing Γ(X, U))ˣ,
      (0 ≤ ord x (Additive.ofMul f) ↔ ∃ t : X.presheaf.stalk z,
        algebraMap _ X.functionField t = α (f : FractionRing Γ(X, U))) := by
    intro x hxU
    have hxη : x ≠ genericPoint X := fun h => hxU (h ▸ hηU)
    let μ' : Additive (X.functionField)ˣ →+ ℤ := (ord x).comp E.symm.toAddMonoidHom
    have hμ' : ∀ m, μ' m = ord x (E.symm m) := fun m => rfl
    have hult : ∀ a b h : (X.functionField)ˣ, (h : X.functionField) = a + b →
        min (μ' (Additive.ofMul a)) (μ' (Additive.ofMul b)) ≤ μ' (Additive.ofMul h) := by
      intro a b h hh
      have := C5 x (Additive.toMul (E.symm (Additive.ofMul a)))
        (Additive.toMul (E.symm (Additive.ofMul b))) (Additive.toMul (E.symm (Additive.ofMul h)))
        (by
          show α.symm (h : X.functionField) = α.symm (a : X.functionField) +
            α.symm (b : X.functionField)
          rw [hh, map_add])
      change min (ord x (E.symm (Additive.ofMul a))) (ord x (E.symm (Additive.ofMul b))) ≤
        ord x (E.symm (Additive.ofMul h))
      simpa only [ofMul_toMul] using this
    obtain ⟨R, hR⟩ := s5 X.functionField μ' hult
    have hconst : ∀ c' : Ω, (X.presheaf.germ ⊤ (genericPoint X) trivial).hom
        (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c')) ∈ R := by
      intro c'
      have hk : α (wcCurveConst Ω X fX U c') =
          (X.presheaf.germ ⊤ (genericPoint X) trivial).hom
            (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c')) := T1 (φ c')
      by_cases hk0 : (X.presheaf.germ ⊤ (genericPoint X) trivial).hom
          (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c')) = 0
      · rw [hk0]; exact R.zero_mem
      · have hc0 : wcCurveConst Ω X fX U c' ≠ 0 := fun h => hk0 (by rw [← hk, h, map_zero])
        rw [hR _ hk0, hμ', hEsymm (Units.mk0 _ hc0) _ hk0 hk, hconst_kill x c' hc0]
    obtain ⟨t, ht⟩ := C4 x hxη
    have hnot : ∃ g : X.functionField, g ∉ R := by
      refine ⟨α (((Additive.toMul t)⁻¹ : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U)), ?_⟩
      intro hmem
      have hne := hαne (Additive.toMul t)⁻¹
      rw [hR _ hne, hμ', hEsymm _ _ hne rfl, ofMul_inv, ofMul_toMul, map_neg, ht] at hmem
      omega
    obtain ⟨z, hzη, hzR⟩ := s4 R hconst hnot
    refine ⟨z, hzη, fun f => ?_⟩
    haveI := hDVR z hzη
    have hmax := s2 (X.presheaf.stalk z) X.functionField R.toSubring hzR hnot
    have hval : ord x (Additive.ofMul f) = μ' (Additive.ofMul (Units.mk0 _ (hαne f))) := by
      rw [hμ', hEsymm f _ (hαne f) rfl]
    rw [hval, ← hR _ (hαne f)]
    constructor
    · intro hmem
      exact hmax _ hmem
    · rintro ⟨r, hr⟩
      rw [← hr]
      exact hzR r

  choose zf hzf using hbound
  let cm : X → X := fun x => if hx : x ∈ U then x else zf x hx
  have hcmU : ∀ x (hx : x ∈ U), cm x = x := fun x hx => dif_pos hx
  have hcmV : ∀ x (hx : x ∉ U), cm x = zf x hx := fun x hx => dif_neg hx
  have hmaps : Set.MapsTo cm (U : Set X)ᶜ (U : Set X)ᶜ := by
    intro x hx hcx
    have hx' : x ∉ U := hx
    rw [hcmV x hx'] at hcx
    have hzη := (hzf x hx').1
    apply hx'
    have : x = zf x hx' := hconeeq x (zf x hx') (fun h => hx' (h ▸ hηU)) hzη
      (fun f => ((hzf x hx').2 f).trans (hinner _ hcx hzη f).symm)
    rw [this]
    exact hcx
  have hinjOn : Set.InjOn cm (U : Set X)ᶜ := by
    intro x₁ hx₁ x₂ hx₂ h
    have hx₁' : x₁ ∉ U := hx₁
    have hx₂' : x₂ ∉ U := hx₂
    rw [hcmV x₁ hx₁', hcmV x₂ hx₂'] at h
    apply hconeeq x₁ x₂ (fun h' => hx₁' (h' ▸ hηU)) (fun h' => hx₂' (h' ▸ hηU))
    intro f
    rw [(hzf x₁ hx₁').2 f, (hzf x₂ hx₂').2 f, h]
  have hbij : Set.BijOn cm (U : Set X)ᶜ (U : Set X)ᶜ :=
    (hfin.injOn_iff_bijOn_of_mapsTo hmaps).mp hinjOn
  have hcmbij : Function.Bijective cm := by
    constructor
    · intro x₁ x₂ h
      by_cases h1 : x₁ ∈ U <;> by_cases h2 : x₂ ∈ U
      · rwa [hcmU x₁ h1, hcmU x₂ h2] at h
      · exfalso
        have := hmaps (show x₂ ∈ (U : Set X)ᶜ from h2)
        rw [← h, hcmU x₁ h1] at this
        exact this h1
      · exfalso
        have := hmaps (show x₁ ∈ (U : Set X)ᶜ from h1)
        rw [h, hcmU x₂ h2] at this
        exact this h2
      · exact hinjOn h1 h2 h
    · intro y
      by_cases hy : y ∈ U
      · exact ⟨y, hcmU y hy⟩
      · obtain ⟨x, _, hxy⟩ := hbij.surjOn (show y ∈ (U : Set X)ᶜ from hy)
        exact ⟨x, hxy⟩
  let σ : X ≃ X := Equiv.ofBijective cm hcmbij
  have hση : σ (genericPoint X) = genericPoint X := hcmU _ hηU
  have hσsU : ∀ x ∈ U, σ.symm x = x := fun x hx => σ.symm_apply_eq.mpr (hcmU x hx).symm
  have hσsη : σ.symm (genericPoint X) = genericPoint X := hσsU _ hηU
  have hσcone : ∀ z : X, z ≠ genericPoint X → ∀ f : (FractionRing Γ(X, U))ˣ,
      (0 ≤ ord (σ.symm z) (Additive.ofMul f) ↔ ∃ t : X.presheaf.stalk z,
        algebraMap _ X.functionField t = α (f : FractionRing Γ(X, U))) := by
    intro z hz f
    have hcz : cm (σ.symm z) = z := σ.apply_symm_apply z
    by_cases hx : σ.symm z ∈ U
    · have hxz : σ.symm z = z := (hcmU _ hx).symm.trans hcz
      rw [hxz]
      exact hinner z (by rw [← hxz]; exact hx) hz f
    · rw [hcmV _ hx] at hcz
      rw [(hzf _ hx).2 f, hcz]

  refine ⟨σ, fun z => ord (σ.symm z), fun x hx => hcmU x hx,
    fun x => (congrArg ord (σ.symm_apply_apply x)).symm, ⟨?_, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
  · intro m
    show ord (σ.symm (genericPoint X)) m = 0
    rw [hσsη]
    exact C1 m
  · intro v f
    show ord (σ.symm (hU.fromSpec ⟨v.asIdeal, v.isPrime⟩)) (Additive.ofMul f) = _
    rw [hσsU _ (hP5.2.2.1 v).1]
    exact C2 v f
  · intro m
    refine ((C3 m).image σ).subset ?_
    intro z hz
    exact ⟨σ.symm z, hz, σ.apply_symm_apply z⟩
  · intro z hz
    have : σ.symm z ≠ genericPoint X := fun h => hz ((σ.symm_apply_eq.mp h).trans hση)
    exact C4 _ this
  · intro z f g' h hh
    exact C5 (σ.symm z) f g' h hh
  · intro f
    refine Iff.trans ?_ (C6 f)
    constructor
    · intro H x
      have := H (σ x)
      simp only [Equiv.symm_apply_apply] at this
      exact this
    · intro H z
      exact H (σ.symm z)
  · intro z hz f
    show 0 ≤ ord (σ.symm z) (Additive.ofMul f) ↔ wcStalkReg X U z f
    rw [hσcone z hz f, s1 z f]

theorem wc_geometricallyIrreducible_of_isAlgClosed : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [AlgebraicGeometry.IsIntegral X]
    [LocallyOfFiniteType fX], GeometricallyIrreducible fX :=
by
  intro Ω _ _ X fX _ _

  have t_pts : ∀ (B : Type u) [CommRing B] [Algebra Ω B] [Algebra.FiniteType Ω B]
      (m : Ideal B), m.IsMaximal → ∃ χ : B →ₐ[Ω] Ω, ∀ b, χ b = 0 ↔ b ∈ m := by
    intro B _ _ _ m hm
    letI := Ideal.Quotient.field m
    haveI : Module.Finite Ω (B ⧸ m) := finite_of_finite_type_of_isJacobsonRing Ω (B ⧸ m)
    haveI : Algebra.IsIntegral Ω (B ⧸ m) := Algebra.IsIntegral.of_finite Ω (B ⧸ m)
    have hbij : Function.Bijective (algebraMap Ω (B ⧸ m)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e := AlgEquiv.ofBijective (Algebra.ofId Ω (B ⧸ m)) hbij
    refine ⟨e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω m), fun b => ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
    constructor
    · intro h
      have := congrArg e h
      simpa using this
    · intro h; rw [h]; simp

  have t_coord : ∀ (B A : Type u) [CommRing B] [CommRing A] [Algebra Ω B] [Algebra Ω A]
      (ι : Type u) (e : Module.Basis ι Ω A) (χ : B →ₐ[Ω] Ω) (u : TensorProduct Ω B A),
      e.repr ((Algebra.TensorProduct.lid Ω A) (Algebra.TensorProduct.map χ (AlgHom.id Ω A) u)) =
        Finsupp.mapRange χ (map_zero χ) ((Algebra.TensorProduct.basis B e).repr u) := by
    intro B A _ _ _ _ ι e χ u
    induction u using TensorProduct.induction_on with
    | zero => simp
    | tmul b a =>
      ext i
      simp [Algebra.TensorProduct.basis_repr_tmul, Algebra.TensorProduct.map_tmul]
    | add x y hx hy =>
      ext i
      have hx' := Finsupp.ext_iff.mp hx i
      have hy' := Finsupp.ext_iff.mp hy i
      simp only [map_add, Finsupp.coe_add, Pi.add_apply, Finsupp.mapRange_apply] at hx' hy' ⊢
      rw [hx', hy']

  have t_s1 : ∀ (B A : Type u) [CommRing B] [CommRing A] [IsDomain B] [IsDomain A]
      [Algebra Ω B] [Algebra Ω A] [Algebra.FiniteType Ω B], IsDomain (TensorProduct Ω B A) := by
    intro B A _ _ _ _ _ _ _
    classical
    haveI : Nontrivial (TensorProduct Ω B A) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain Ω B A
        (algebraMap Ω B).injective (algebraMap Ω A).injective
    let ε := Module.Free.chooseBasis Ω A
    let β := Algebra.TensorProduct.basis B ε
    have key : ∀ u : TensorProduct Ω B A, ∀ m : Ideal B, ∀ χ : B →ₐ[Ω] Ω,
        (∀ b, χ b = 0 ↔ b ∈ m) →
        ((Algebra.TensorProduct.lid Ω A) (Algebra.TensorProduct.map χ (AlgHom.id Ω A) u) = 0 ↔
          Ideal.span (Set.range (β.repr u)) ≤ m) := by
      intro u m χ hχ
      rw [← ε.repr.map_eq_zero_iff, t_coord, Ideal.span_le]
      constructor
      · rintro h _ ⟨i, rfl⟩
        have := Finsupp.ext_iff.mp h i
        simp only [Finsupp.mapRange_apply, Finsupp.coe_zero, Pi.zero_apply] at this
        exact (hχ _).mp this
      · intro h
        ext i
        simp only [Finsupp.mapRange_apply, Finsupp.coe_zero, Pi.zero_apply]
        exact (hχ _).mpr (h ⟨i, rfl⟩)
    haveI : IsJacobsonRing B := isJacobsonRing_of_finiteType (A := Ω)
    have hnz : NoZeroDivisors (TensorProduct Ω B A) := by
      constructor
      intro u v huv
      have hj : (⊥ : Ideal B).jacobson = ⊥ := by
        rw [← Ideal.radical_eq_jacobson, Ideal.radical_bot_of_isReduced]
      have hle : Ideal.span (Set.range (β.repr u)) * Ideal.span (Set.range (β.repr v)) = ⊥ := by
        rw [eq_bot_iff, ← hj]
        intro x hx
        rw [Ideal.jacobson, Ideal.mem_sInf]
        rintro m ⟨-, hm⟩
        obtain ⟨χ, hχ⟩ := t_pts B m hm
        have h0 : (Algebra.TensorProduct.lid Ω A) (Algebra.TensorProduct.map χ (AlgHom.id Ω A) u) *
            (Algebra.TensorProduct.lid Ω A) (Algebra.TensorProduct.map χ (AlgHom.id Ω A) v) = 0 := by
          rw [← map_mul, ← map_mul, huv, map_zero, map_zero]
        rcases mul_eq_zero.mp h0 with h | h
        · exact (Ideal.mul_le_inf.trans (inf_le_left.trans ((key u m χ hχ).mp h))) hx
        · exact (Ideal.mul_le_inf.trans (inf_le_right.trans ((key v m χ hχ).mp h))) hx
      rcases Ideal.mul_eq_bot.mp hle with h | h
      · left
        rw [Ideal.span_eq_bot] at h
        rw [← β.repr.map_eq_zero_iff]
        ext i
        exact h _ ⟨i, rfl⟩
      · right
        rw [Ideal.span_eq_bot] at h
        rw [← β.repr.map_eq_zero_iff]
        ext i
        exact h _ ⟨i, rfl⟩
    exact NoZeroDivisors.to_isDomain _

  have t_s2 : ∀ (T : Type u) [TopologicalSpace T] (ι : Type u) (U : ι → Set T), Nonempty ι →
      (∀ i, IsOpen (U i)) → (∀ i, IsIrreducible (U i)) → (∀ i j, (U i ∩ U j).Nonempty) →
      (∀ t, ∃ i, t ∈ U i) → IrreducibleSpace T := by
    intro T _ ι U hι ho hirr hmeet hcov
    rw [irreducibleSpace_def]
    obtain ⟨i₀⟩ := hι
    refine ⟨?_, ?_⟩
    · obtain ⟨x, -⟩ := (hirr i₀).nonempty
      exact ⟨x, trivial⟩
    · rintro V W hV hW ⟨v, -, hv⟩ ⟨w, -, hw⟩
      obtain ⟨i, hi⟩ := hcov v
      obtain ⟨j, hj⟩ := hcov w
      obtain ⟨a, haUi, haV, haUj⟩ := (hirr i).2 V (U j) hV (ho j) ⟨v, hi, hv⟩ (hmeet i j)
      obtain ⟨b, -, ⟨hbV, -⟩, hbW⟩ :=
        (hirr j).2 (V ∩ U i) W (hV.inter (ho i)) hW ⟨a, haUj, haV, haUi⟩ ⟨w, hj, hw⟩
      exact ⟨b, trivial, hbV, hbW⟩

  have s5 : ∀ (U : X.Opens), IsAffineOpen U → (U : Set X).Nonempty →
      GeometricallyIrreducible (U.ι ≫ fX) := by
    intro U hU hne
    haveI : Nonempty U := (Scheme.Opens.nonempty_iff U).mpr hne
    haveI : IsDomain Γ(X, U) := IsIntegral.component_integral U
    letI : Algebra Ω Γ(X, U) := (Spec.preimage (hU.fromSpec ≫ fX)).hom.toAlgebra
    have e : Spec.map (CommRingCat.ofHom (algebraMap Ω Γ(X, U))) = hU.fromSpec ≫ fX := by
      rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage]
    haveI hft : Algebra.FiniteType Ω Γ(X, U) := by
      have h : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap Ω Γ(X, U)))) := by
        rw [e]; infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)] at h
      exact RingHom.finiteType_algebraMap.mp h
    have hgi : GeometricallyIrreducible (Spec.map (CommRingCat.ofHom (algebraMap Ω Γ(X, U)))) := by
      rw [geometricallyIrreducible_iff, geometrically_iff_of_commRing_of_isClosedUnderIsomorphisms]
      intro K _ _
      haveI := t_s1 Γ(X, U) K
      exact (Homeomorph.irreducibleSpace_iff
        (Scheme.homeoOfIso (pullbackSpecIso Ω Γ(X, U) K))).mpr inferInstance
    rw [e] at hgi
    rw [geometricallyIrreducible_iff] at hgi ⊢
    rw [← hU.isoSpec_inv_ι, Category.assoc] at hgi
    exact (MorphismProperty.cancel_left_of_respectsIso
      (geometrically (fun X : Scheme.{u} => IrreducibleSpace X)) hU.isoSpec.inv (U.ι ≫ fX)).mp hgi
  have haff : ∀ x : X, ∃ U : X.Opens, IsAffineOpen U ∧ x ∈ U := by
    intro x
    obtain ⟨U, hU, hx, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
      (show x ∈ (⊤ : X.Opens) from trivial)
    exact ⟨U, hU, hx⟩

  rw [geometricallyIrreducible_iff, geometrically_iff_of_isClosedUnderIsomorphisms]
  intro K _ y
  refine t_s2 (↥(Limits.pullback fX y : Scheme.{u}))
    {U : X.Opens // IsAffineOpen U ∧ (U : Set X).Nonempty}
    (fun i => ((Limits.pullback.fst fX y ⁻¹ᵁ i.1 : (Limits.pullback fX y : Scheme.{u}).Opens) :
      Set ↥(Limits.pullback fX y : Scheme.{u})))
    ?_ ?_ ?_ ?_ ?_
  · obtain ⟨x⟩ := (inferInstance : Nonempty X)
    obtain ⟨U, hU, hx⟩ := haff x
    exact ⟨⟨U, hU, x, hx⟩⟩
  · intro i
    exact (Limits.pullback.fst fX y ⁻¹ᵁ i.1).isOpen
  · intro i
    haveI := s5 i.1 i.2.1 i.2.2
    have h := GeometricallyIrreducible.geometrically_irreducibleSpace y
      (Limits.pullback.fst fX y ∣_ i.1)
      ((Limits.pullback.fst fX y ⁻¹ᵁ i.1).ι ≫ Limits.pullback.snd fX y)
      (IsPullback.paste_vert (isPullback_morphismRestrict (Limits.pullback.fst fX y) i.1)
        (IsPullback.of_hasPullback fX y))
    exact isIrreducible_iff_irreducibleSpace.mpr h
  · intro i j
    obtain ⟨x, hxU, hxV⟩ := nonempty_preirreducible_inter i.1.isOpen j.1.isOpen i.2.2 j.2.2
    obtain ⟨z, hz⟩ := AlgebraicGeometry.Surjective.surj (f := Limits.pullback.fst fX y) x
    refine ⟨z, ?_, ?_⟩
    · rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, hz]; exact hxU
    · rw [SetLike.mem_coe, Scheme.Hom.mem_preimage, hz]; exact hxV
  · intro z
    obtain ⟨U, hU, hx⟩ := haff (Limits.pullback.fst fX y z)
    exact ⟨⟨U, hU, _, hx⟩, hx⟩

theorem wc_ringKrullDim_tensor_finiteType : ∀ (k A B : Type u) [Field k] [CommRing A] [CommRing B]
    [Algebra k A] [Algebra k B] [Algebra.FiniteType k A] [Algebra.FiniteType k B] [Nontrivial A]
    [Nontrivial B], ringKrullDim (TensorProduct k A B) = ringKrullDim A + ringKrullDim B :=
by
  intro k A B _ _ _ _ _ _ _ _ _
  have s1 : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S), f.IsIntegral →
      ringKrullDim S ≤ ringKrullDim R := by
    intro R S _ _ f hf
    letI := f.toAlgebra
    haveI : Algebra.IsIntegral R S := ⟨hf⟩
    apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap f)
    intro p q hpq
    have h := Ideal.IsIntegral.comap_lt_comap (R := R)
      ((PrimeSpectrum.asIdeal_lt_asIdeal p q).mpr hpq)
    exact (PrimeSpectrum.asIdeal_lt_asIdeal _ _).mp h
  have s2 : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S), f.IsIntegral →
      Function.Injective f → ringKrullDim R ≤ ringKrullDim S := by
    intro R S _ _ f hf hinj
    letI := f.toAlgebra
    haveI : Algebra.IsIntegral R S := ⟨hf⟩
    have C : ∀ p : LTSeries (PrimeSpectrum R), ∃ q : LTSeries (PrimeSpectrum S),
        q.length = p.length ∧ (q.last).asIdeal.comap f = (p.last).asIdeal := by
      intro p
      induction p using RelSeries.inductionOn' with
      | singleton x =>
        have hle : (⊥ : Ideal S).under R ≤ x.asIdeal := by
          rw [Ideal.under_def, RingHom.algebraMap_toAlgebra, Ideal.comap_bot_of_injective f hinj]
          exact bot_le
        obtain ⟨Q, -, hQ, hQx⟩ := Ideal.exists_ideal_over_prime_of_isIntegral x.asIdeal ⊥ hle
        exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQx⟩
      | snoc p x hx ih =>
        obtain ⟨q, hql, hqc⟩ := ih
        have hx' : p.last < x := hx
        have hle : q.last.asIdeal.under R ≤ x.asIdeal := by
          change q.last.asIdeal.comap f ≤ _
          rw [hqc]
          exact hx'.le
        obtain ⟨Q, hQge, hQ, hQx⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime x.asIdeal q.last.asIdeal hle
        have hlt : q.last < ⟨Q, hQ⟩ := by
          refine lt_of_le_of_ne hQge ?_
          intro heq
          have : p.last = x := by
            ext1
            rw [← hqc]
            have hQx' : Q.comap f = x.asIdeal := hQx
            rw [← hQx', heq]
          exact (ne_of_lt hx') this
        refine ⟨q.snoc ⟨Q, hQ⟩ hlt, ?_, ?_⟩
        · simp [hql]
        · simp only [RelSeries.last_snoc]
          exact hQx
    rw [ringKrullDim, Order.krullDim]
    apply iSup_le
    intro p
    obtain ⟨q, hql, -⟩ := C p
    rw [← hql]
    exact Order.LTSeries.length_le_krullDim q
  have dimP : ∀ n : ℕ, ringKrullDim (MvPolynomial (Fin n) k) = ((n : ℕ) : WithBot ℕ∞) := by
    intro n
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, ringKrullDim_eq_zero_of_field,
      Nat.card_fin, zero_add]
  obtain ⟨r, g, hginj, hg⟩ := exists_finite_inj_algHom_of_fg k A
  obtain ⟨s, h, hhinj, hh⟩ := exists_finite_inj_algHom_of_fg k B
  have hA : ringKrullDim A = ((r : ℕ) : WithBot ℕ∞) := by
    rw [← dimP r]
    exact le_antisymm (s1 _ _ g.toRingHom (RingHom.Finite.to_isIntegral hg))
      (s2 _ _ g.toRingHom (RingHom.Finite.to_isIntegral hg) hginj)
  have hB : ringKrullDim B = ((s : ℕ) : WithBot ℕ∞) := by
    rw [← dimP s]
    exact le_antisymm (s1 _ _ h.toRingHom (RingHom.Finite.to_isIntegral hh))
      (s2 _ _ h.toRingHom (RingHom.Finite.to_isIntegral hh) hhinj)
  have hT : ringKrullDim (TensorProduct k A B) =
      ringKrullDim (TensorProduct k (MvPolynomial (Fin r) k) (MvPolynomial (Fin s) k)) := by
    have hfin : (Algebra.TensorProduct.map g h).toRingHom.Finite :=
      RingHom.Finite.tensorProductMap hg hh
    have hinj : Function.Injective (Algebra.TensorProduct.map g h).toRingHom :=
      TensorProduct.map_injective_of_flat_flat g.toLinearMap h.toLinearMap hginj hhinj
    exact le_antisymm (s1 _ _ _ hfin.to_isIntegral) (s2 _ _ _ hfin.to_isIntegral hinj)
  have h3 : ringKrullDim (TensorProduct k (MvPolynomial (Fin r) k) (MvPolynomial (Fin s) k)) =
      ((r : ℕ) : WithBot ℕ∞) + ((s : ℕ) : WithBot ℕ∞) := by
    rw [ringKrullDim_eq_of_ringEquiv
      (MvPolynomial.algebraTensorAlgEquiv k (σ := Fin s) (MvPolynomial (Fin r) k)).toRingEquiv,
      MvPolynomial.ringKrullDim_of_isNoetherianRing_of_finite, dimP, Nat.card_fin]
  rw [hT, h3, hA, hB]

theorem wc_topologicalKrullDim_pullback_field : ∀ (Ω : Type u) [Field Ω] (Y X : Scheme.{u})
    (f : Y ⟶ Spec (.of Ω)) (g : X ⟶ Spec (.of Ω)) [LocallyOfFiniteType f]
    [LocallyOfFiniteType g] (a b : ℕ), topologicalKrullDim Y = ((a : ℕ) : WithBot ℕ∞) →
    topologicalKrullDim X = ((b : ℕ) : WithBot ℕ∞) →
    topologicalKrullDim (Limits.pullback f g : Scheme.{u}) = ((a + b : ℕ) : WithBot ℕ∞) :=
by
  intro Ω _ Y X f g _ _ a b ha hb
  classical

  have wc_topologicalKrullDim_open_cover : ∀ (T : Type u) [TopologicalSpace T] (ι : Type u)
      (Y : ι → Type u) [∀ i, TopologicalSpace (Y i)] (e : ∀ i, Y i → T),
      (∀ i, Topology.IsOpenEmbedding (e i)) → (∀ t, ∃ i y, e i y = t) →
      topologicalKrullDim T = ⨆ i, topologicalKrullDim (Y i) := by
    intro T _ ι Y _ e he hc
    apply le_antisymm
    · rw [topologicalKrullDim.eq_1, Order.krullDim.eq_1]
      apply iSup_le
      intro Z
      obtain ⟨t, ht⟩ := (Z 0).isIrreducible.nonempty
      obtain ⟨i, y, hy⟩ := hc t
      have htk : ∀ k, t ∈ Z k := fun k => Z.monotone (Fin.zero_le k) ht
      let W : Fin (Z.length + 1) → TopologicalSpace.IrreducibleCloseds (Y i) := fun k =>
        ⟨e i ⁻¹' (Z k), (Z k).isIrreducible.preimage (he i) ⟨t, htk k, y, hy⟩,
          (Z k).isClosed.preimage (he i).continuous⟩
      have hF : ∀ k, (Z k : Set T) ⊆ closure ((Z k : Set T) ∩ Set.range (e i)) := by
        intro k x hx
        by_contra hxc
        obtain ⟨z, hzZ, hzO, hzV⟩ := (Z k).isIrreducible.isPreirreducible (Set.range (e i))
          (closure ((Z k : Set T) ∩ Set.range (e i)))ᶜ (he i).isOpen_range
          isClosed_closure.isOpen_compl ⟨t, htk k, y, hy⟩ ⟨x, hx, hxc⟩
        exact hzV (subset_closure ⟨hzZ, hzO⟩)
      have hstep : ∀ k : Fin Z.length, W k.castSucc < W k.succ := by
        intro k
        have hlt : Z k.castSucc < Z k.succ := Z.step k
        have hle0 : (Z k.castSucc : Set T) ⊆ Z k.succ := hlt.le
        refine lt_of_le_of_ne ?_ ?_
        · show (e i ⁻¹' (Z k.castSucc : Set T)) ⊆ e i ⁻¹' (Z k.succ : Set T)
          exact Set.preimage_mono hle0
        · intro heq
          have hle' : (e i ⁻¹' (Z k.succ : Set T)) ⊆ e i ⁻¹' (Z k.castSucc : Set T) := by
            have : (W k.succ : Set (Y i)) = W k.castSucc := by rw [heq]
            exact this.le
          apply (lt_iff_le_not_ge.mp hlt).2
          show (Z k.succ : Set T) ⊆ Z k.castSucc
          have h1 : (Z k.succ : Set T) ∩ Set.range (e i) ⊆ Z k.castSucc := by
            rintro z ⟨hz, y', rfl⟩
            exact hle' hz
          exact (hF k.succ).trans (closure_minimal h1 (Z k.castSucc).isClosed)
      let W' : LTSeries (TopologicalSpace.IrreducibleCloseds (Y i)) := ⟨Z.length, W, hstep⟩
      refine le_iSup_of_le i ?_
      exact Order.LTSeries.length_le_krullDim W'
    · exact iSup_le fun i => (he i).isInducing.topologicalKrullDim_le

  have attain : ∀ (ι : Type u) (α : ι → WithBot ℕ∞) (a : ℕ),
      (⨆ i, α i) = ((a : ℕ) : WithBot ℕ∞) → ∃ i, α i = ((a : ℕ) : WithBot ℕ∞) := by
    intro ι α a hα
    have hc : (if a = 0 then (⊥ : WithBot ℕ∞) else (((a - 1 : ℕ) : WithBot ℕ∞))) < ⨆ i, α i := by
      rw [hα]
      split_ifs with h
      · exact WithBot.bot_lt_coe _
      · exact_mod_cast (by omega : a - 1 < a)
    obtain ⟨i, hi⟩ := lt_iSup_iff.mp hc
    have hle : α i ≤ ((a : ℕ) : WithBot ℕ∞) := (le_iSup α i).trans hα.le
    refine ⟨i, ?_⟩
    generalize α i = x at hi hle ⊢
    induction x using WithBot.recBotCoe with
    | bot => exact absurd hi not_lt_bot
    | coe y =>
      induction y using ENat.recTopCoe with
      | top =>
        exfalso
        have h1 : ((⊤ : ℕ∞) : WithBot ℕ∞) ≤ (((a : ℕ∞)) : WithBot ℕ∞) := by exact_mod_cast hle
        have h2 : (⊤ : ℕ∞) ≤ (a : ℕ∞) := WithBot.coe_le_coe.mp h1
        simp at h2
      | coe m =>
        have h1 : m ≤ a := by exact_mod_cast hle
        have h2 : m = a := by
          split_ifs at hi with h
          · omega
          · have h3 : (((a - 1 : ℕ) : ℕ∞) : WithBot ℕ∞) < (((m : ℕ∞)) : WithBot ℕ∞) := hi
            have h4 : ((a - 1 : ℕ) : ℕ∞) < (m : ℕ∞) := WithBot.coe_lt_coe.mp h3
            have : a - 1 < m := by exact_mod_cast h4
            omega
        subst h2
        rfl
  have hsup : ∀ (ι κ : Type u) (α : ι → WithBot ℕ∞) (β : κ → WithBot ℕ∞) (a b : ℕ),
      (⨆ i, α i) = ((a : ℕ) : WithBot ℕ∞) → (⨆ j, β j) = ((b : ℕ) : WithBot ℕ∞) →
      (⨆ p : ι × κ, (α p.1 + β p.2)) = ((a + b : ℕ) : WithBot ℕ∞) := by
    intro ι κ α β a b hα hβ
    obtain ⟨i₀, hi₀⟩ := attain ι α a hα
    obtain ⟨j₀, hj₀⟩ := attain κ β b hβ
    apply le_antisymm
    · apply iSup_le
      rintro ⟨i, j⟩
      rw [Nat.cast_add]
      exact add_le_add ((le_iSup α i).trans hα.le) ((le_iSup β j).trans hβ.le)
    · rw [Nat.cast_add, ← hi₀, ← hj₀]
      exact le_iSup (fun p : ι × κ => α p.1 + β p.2) (i₀, j₀)

  have key : ∀ (R S : CommRingCat.{u}) (p : Spec R ⟶ Spec (.of Ω)) (q : Spec S ⟶ Spec (.of Ω))
      [LocallyOfFiniteType p] [LocallyOfFiniteType q],
      topologicalKrullDim (Limits.pullback p q : Scheme.{u}) = ringKrullDim R + ringKrullDim S := by
    intro R S p q _ _
    letI : Algebra Ω R := (Spec.preimage p).hom.toAlgebra
    letI : Algebra Ω S := (Spec.preimage q).hom.toAlgebra
    have hp : Spec.map (CommRingCat.ofHom (algebraMap Ω R)) = p := by
      rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage]
    have hq : Spec.map (CommRingCat.ofHom (algebraMap Ω S)) = q := by
      rw [RingHom.algebraMap_toAlgebra, CommRingCat.ofHom_hom, Spec.map_preimage]
    have e : topologicalKrullDim (Limits.pullback p q : Scheme.{u}) =
        ringKrullDim (TensorProduct Ω R S) := by
      rw [IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso
        (Limits.pullback.congrHom hp.symm hq.symm ≪≫ pullbackSpecIso Ω R S)).isHomeomorph]
      exact PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _
    rw [e]
    haveI : Algebra.FiniteType Ω R := RingHom.finiteType_algebraMap.mp
      ((HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp
        (by rw [Spec.map_preimage p]; infer_instance))
    haveI : Algebra.FiniteType Ω S := RingHom.finiteType_algebraMap.mp
      ((HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp
        (by rw [Spec.map_preimage q]; infer_instance))
    rcases subsingleton_or_nontrivial R with hR | hR
    · have : Subsingleton (TensorProduct Ω R S) := by
        apply subsingleton_of_zero_eq_one
        rw [Algebra.TensorProduct.one_def, Subsingleton.elim (1 : R) 0, TensorProduct.zero_tmul]
      rw [ringKrullDim_eq_bot_of_subsingleton, ringKrullDim_eq_bot_of_subsingleton (R := R),
        WithBot.bot_add]
    · rcases subsingleton_or_nontrivial S with hS | hS
      · have : Subsingleton (TensorProduct Ω R S) := by
          apply subsingleton_of_zero_eq_one
          rw [Algebra.TensorProduct.one_def, Subsingleton.elim (1 : S) 0, TensorProduct.tmul_zero]
        rw [ringKrullDim_eq_bot_of_subsingleton, ringKrullDim_eq_bot_of_subsingleton (R := S),
          WithBot.add_bot]
      · exact wc_ringKrullDim_tensor_finiteType Ω R S

  have hY := wc_topologicalKrullDim_open_cover Y Y.affineCover.I₀ (fun i => Y.affineCover.X i)
    (fun i => ⇑(Y.affineCover.f i)) (fun i => (Y.affineCover.f i).isOpenEmbedding)
    (fun t => ⟨Y.affineCover.idx t, Y.affineCover.covers t⟩)
  have hX := wc_topologicalKrullDim_open_cover X X.affineCover.I₀ (fun j => X.affineCover.X j)
    (fun j => ⇑(X.affineCover.f j)) (fun j => (X.affineCover.f j).isOpenEmbedding)
    (fun t => ⟨X.affineCover.idx t, X.affineCover.covers t⟩)
  have hP := wc_topologicalKrullDim_open_cover (Limits.pullback f g : Scheme.{u})
    (Scheme.Pullback.openCoverOfLeftRight Y.affineCover X.affineCover f g).I₀
    (fun ij => (Scheme.Pullback.openCoverOfLeftRight Y.affineCover X.affineCover f g).X ij)
    (fun ij => ⇑((Scheme.Pullback.openCoverOfLeftRight Y.affineCover X.affineCover f g).f ij))
    (fun ij => by
      haveI := (Scheme.Pullback.openCoverOfLeftRight Y.affineCover X.affineCover f g).map_prop ij
      exact ((Scheme.Pullback.openCoverOfLeftRight Y.affineCover X.affineCover f g).f ij).isOpenEmbedding)
    (fun t => ⟨(Scheme.Pullback.openCoverOfLeftRight Y.affineCover X.affineCover f g).idx t,
      (Scheme.Pullback.openCoverOfLeftRight Y.affineCover X.affineCover f g).covers t⟩)
  have hα : (⨆ i : Y.affineCover.I₀, ringKrullDim (Y.affineOpenCover.X i)) =
      ((a : ℕ) : WithBot ℕ∞) := by
    rw [← ha, hY]
    exact iSup_congr (fun i => (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).symm)
  have hβ : (⨆ j : X.affineCover.I₀, ringKrullDim (X.affineOpenCover.X j)) =
      ((b : ℕ) : WithBot ℕ∞) := by
    rw [← hb, hX]
    exact iSup_congr (fun j => (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _).symm)
  have hpiece : ∀ ij : Y.affineCover.I₀ × X.affineCover.I₀,
      topologicalKrullDim ((Scheme.Pullback.openCoverOfLeftRight Y.affineCover X.affineCover f g).X ij)
        = ringKrullDim (Y.affineOpenCover.X ij.1) + ringKrullDim (X.affineOpenCover.X ij.2) :=
    fun ij => by
      have h1 : IsOpenImmersion (Y.affineCover.f ij.1) := Y.affineCover.map_prop _
      have h2 : IsOpenImmersion (X.affineCover.f ij.2) := X.affineCover.map_prop _
      have h3 : LocallyOfFiniteType (Y.affineCover.f ij.1 ≫ f) := inferInstance
      have h4 : LocallyOfFiniteType (X.affineCover.f ij.2 ≫ g) := inferInstance
      exact @key (Y.affineOpenCover.X ij.1) (X.affineOpenCover.X ij.2)
        (Y.affineCover.f ij.1 ≫ f) (X.affineCover.f ij.2 ≫ g) h3 h4
  calc topologicalKrullDim (Limits.pullback f g : Scheme.{u})
      = ⨆ ij : Y.affineCover.I₀ × X.affineCover.I₀,
          topologicalKrullDim ((Scheme.Pullback.openCoverOfLeftRight Y.affineCover X.affineCover f g).X ij) := hP
    _ = ⨆ ij : Y.affineCover.I₀ × X.affineCover.I₀,
          (ringKrullDim (Y.affineOpenCover.X ij.1) + ringKrullDim (X.affineOpenCover.X ij.2)) :=
        iSup_congr hpiece
    _ = ((a + b : ℕ) : WithBot ℕ∞) := hsup _ _ _ _ a b hα hβ

theorem wc_pow_geometry : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ m : ℕ, IrreducibleSpace (wcPow Ω X fX m) ∧ IsProper (wcPowHom Ω X fX m) ∧
      topologicalKrullDim (wcPow Ω X fX m) = ((m : ℕ) : WithBot ℕ∞) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim m
  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  haveI : GeometricallyIrreducible fX := wc_geometricallyIrreducible_of_isAlgClosed Ω X fX
  induction m with
  | zero =>
    refine ⟨?_, ?_, ?_⟩
    · change IrreducibleSpace (Spec (.of Ω))
      infer_instance
    · change IsProper (𝟙 (Spec (.of Ω)))
      infer_instance
    · change topologicalKrullDim (Spec (.of Ω)) = _
      exact (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim Ω).trans
        (ringKrullDim_eq_zero_of_field Ω)
  | succ m IH =>
    obtain ⟨hirr, hprop, hd⟩ := IH
    haveI := hirr
    haveI := hprop
    refine ⟨?_, ?_, ?_⟩
    · change IrreducibleSpace (Limits.pullback (wcPowHom Ω X fX m) fX : Scheme.{u})
      infer_instance
    · change IsProper (Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowHom Ω X fX m)
      infer_instance
    · change topologicalKrullDim (Limits.pullback (wcPowHom Ω X fX m) fX : Scheme.{u}) = _
      exact wc_topologicalKrullDim_pullback_field Ω (wcPow Ω X fX m) X (wcPowHom Ω X fX m) fX
        m 1 hd hdim

theorem wc_pow_closed_point_of_effective : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (m : ℕ) (F : X →₀ ℤ), F (genericPoint X) = 0 → (∀ x, 0 ≤ F x) →
      F.sum (fun _ k => k) = m →
      ∃ y : wcPow Ω X fX m, IsClosed ({y} : Set (wcPow Ω X fX m)) ∧ wcPowDiv Ω X fX m y = F :=
by
  intro Ω _ _ X fX _ _ hdim
  classical
  have hclosed := (wc_curve_points_closed_opens_compact Ω X fX hdim).1
  have hcpt : ∀ m, CompactSpace (wcPow Ω X fX m) := by
    intro m
    induction m with
    | zero => exact (inferInstance : CompactSpace (Spec (.of Ω)))
    | succ m ih =>
      haveI := ih
      exact (QuasiCompact.compactSpace_of_compactSpace
        (Limits.pullback.fst (wcPowHom Ω X fX m) fX) :
          CompactSpace ↥(Limits.pullback (wcPowHom Ω X fX m) fX : Scheme.{u}))
  intro m
  induction m with
  | zero =>
    intro F hFη hFnn hFdeg
    have hF : F = 0 := by
      have h0 : ∑ a ∈ F.support, F a = 0 := by simpa [Finsupp.sum] using hFdeg
      rw [Finset.sum_eq_zero_iff_of_nonneg (fun a _ => hFnn a)] at h0
      ext a
      by_cases ha : a ∈ F.support
      · exact h0 a ha
      · simpa using Finsupp.notMem_support_iff.mp ha
    haveI hne : Nonempty (wcPow Ω X fX 0) := (inferInstance : Nonempty (Spec (.of Ω)))
    haveI hss : Subsingleton (wcPow Ω X fX 0) := (inferInstance : Subsingleton (Spec (.of Ω)))
    obtain ⟨y⟩ := hne
    refine ⟨y, ?_, ?_⟩
    · have : ({y} : Set (wcPow Ω X fX 0)) = Set.univ :=
        Set.eq_univ_of_forall (fun z => Subsingleton.elim z y)
      rw [this]
      exact isClosed_univ
    · rw [hF]
      rfl
  | succ m ih =>
    intro F hFη hFnn hFdeg
    have hsum : ∑ a ∈ F.support, F a ≠ 0 := by
      have : ∑ a ∈ F.support, F a = ((m + 1 : ℕ) : ℤ) := hFdeg
      rw [this]
      omega
    obtain ⟨x, -, hx⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum
    have hx1 : 1 ≤ F x := by have := hFnn x; omega
    have hxη : x ≠ genericPoint X := by
      rintro rfl
      omega
    have hxc : IsClosed ({x} : Set X) :=
      hclosed {x} (Set.finite_singleton x) (fun h => hxη (Set.mem_singleton_iff.mp h).symm)
    set F' := F - Finsupp.single x 1 with hF'
    have hF'η : F' (genericPoint X) = 0 := by
      rw [hF', Finsupp.sub_apply, Finsupp.single_apply, if_neg hxη, hFη, sub_zero]
    have hF'nn : ∀ a, 0 ≤ F' a := by
      intro a
      rw [hF', Finsupp.sub_apply, Finsupp.single_apply]
      split_ifs with h
      · subst h; omega
      · have := hFnn a; omega
    have hF'deg : F'.sum (fun _ k => k) = (m : ℤ) := by
      rw [hF', Finsupp.sum_sub_index (fun _ _ _ => rfl), Finsupp.sum_single_index rfl, hFdeg]
      push_cast
      ring
    obtain ⟨y', hy'c, hy'F⟩ := ih F' hF'η hF'nn hF'deg
    obtain ⟨z₀, hz₀1, hz₀2⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := wcPowHom Ω X fX m) (g := fX) y' x (Subsingleton.elim _ _)
    haveI : CompactSpace ↥(Limits.pullback (wcPowHom Ω X fX m) fX : Scheme.{u}) := hcpt (m + 1)
    have hC : IsClosed (Limits.pullback.fst (wcPowHom Ω X fX m) fX ⁻¹' {y'} ∩
        Limits.pullback.snd (wcPowHom Ω X fX m) fX ⁻¹' {x}) :=
      (hy'c.preimage (Limits.pullback.fst (wcPowHom Ω X fX m) fX).continuous).inter
        (hxc.preimage (Limits.pullback.snd (wcPowHom Ω X fX m) fX).continuous)
    obtain ⟨z, ⟨hz1, hz2⟩, hzc⟩ := hC.exists_closed_singleton ⟨z₀, hz₀1, hz₀2⟩
    rw [Set.mem_preimage, Set.mem_singleton_iff] at hz1 hz2
    refine ⟨z, hzc, ?_⟩
    show wcPowDiv Ω X fX m (Limits.pullback.fst (wcPowHom Ω X fX m) fX z) +
      Finsupp.single (Limits.pullback.snd (wcPowHom Ω X fX m) fX z) 1 = F
    rw [hz1, hz2, hy'F, hF', sub_add_cancel]

theorem wc_fixed_pole_rr_basis : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    ∀ g c : ℕ, (∀ D : X →₀ ℤ, D (genericPoint X) = 0 → (c : ℤ) ≤ D.sum (fun _ k => k) →
      @FiniteDimensional Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) ∧
      (@Module.finrank Ω (wcRRSpace Ω X fX U ω D) _ _
        (@Submodule.module Ω _ _ _ (wcCurveConst Ω X fX U).toAlgebra.toModule _) : ℤ) =
        D.sum (fun _ k => k) + 1 - g) →
    ∀ M : X →₀ ℤ, M (genericPoint X) = 0 →
    ∃ (n : ℕ) (f : Fin n → FractionRing Γ(X, U)),
      (∀ s, f s ∈ wcRRSpace Ω X fX U ω M) ∧
      (∀ v : Fin n → Ω, ∑ s, wcCurveConst Ω X fX U (v s) * f s = 0 → v = 0) ∧
      ∀ D : X →₀ ℤ, (∀ x, D x ≤ M x) → ∀ h ∈ wcRRSpace Ω X fX U ω D,
        ∃ v : Fin n → Ω, h = ∑ s, wcCurveConst Ω X fX U (v s) * f s :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hω g c hRR M hM
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
  have hsmul : ∀ (a : Ω) (y : FractionRing Γ(X, U)), a • y = wcCurveConst Ω X fX U a * y :=
    fun a y => rfl
  have mono : ∀ D D' : X →₀ ℤ, (∀ x, D x ≤ D' x) →
      wcRRSpace Ω X fX U ω D ≤ wcRRSpace Ω X fX U ω D' := by
    intro D D' hDD'
    unfold wcRRSpace
    apply Submodule.span_mono
    rintro f ⟨hf, H⟩
    exact ⟨hf, fun x => le_trans (H x) (by linarith [hDD' x])⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : X, Q ≠ genericPoint X := by
    by_contra hcon
    push_neg at hcon
    haveI : Subsingleton X := ⟨fun x y => by rw [hcon x, hcon y]⟩
    haveI : DiscreteTopology X := Subsingleton.discreteTopology
    have h2 := topologicalKrullDim_zero_of_discreteTopology X
    rw [hdim] at h2
    have h3 : (1 : ℕ) ≤ 0 := by exact_mod_cast h2
    omega
  set N : ℕ := ((c : ℤ) - M.sum (fun _ k => k)).toNat with hN
  set D' : X →₀ ℤ := M + Finsupp.single Q (N : ℤ) with hD'
  have hD'η : D' (genericPoint X) = 0 := by
    simp only [hD', Finsupp.add_apply, Finsupp.single_apply, if_neg hQ, hM, add_zero]
  have hD'deg : (c : ℤ) ≤ D'.sum (fun _ k => k) := by
    rw [hD', Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
      Finsupp.sum_single_index rfl]
    have := Int.self_le_toNat ((c : ℤ) - M.sum (fun _ k => k))
    omega
  have hMD' : ∀ x, M x ≤ D' x := by
    intro x
    simp only [hD', Finsupp.add_apply, Finsupp.single_apply]
    split_ifs <;> omega
  haveI hfd' : FiniteDimensional Ω (wcRRSpace Ω X fX U ω D') := (hRR D' hD'η hD'deg).1
  haveI hfd : FiniteDimensional Ω (wcRRSpace Ω X fX U ω M) :=
    Submodule.finiteDimensional_of_le (mono M D' hMD')
  let b := Module.finBasis Ω (wcRRSpace Ω X fX U ω M)
  refine ⟨Module.finrank Ω (wcRRSpace Ω X fX U ω M),
    fun s => ((b s : wcRRSpace Ω X fX U ω M) : FractionRing Γ(X, U)), fun s => (b s).2, ?_, ?_⟩
  · intro v hv
    have h1 : ((∑ s, v s • b s : wcRRSpace Ω X fX U ω M) : FractionRing Γ(X, U)) = 0 := by
      rw [Submodule.coe_sum]
      simpa only [Submodule.coe_smul, hsmul] using hv
    have h2 : (∑ s, v s • b s : wcRRSpace Ω X fX U ω M) = 0 := Submodule.coe_eq_zero.mp h1
    funext s
    exact Fintype.linearIndependent_iff.mp b.linearIndependent v h2 s
  · intro D hD h hh
    have hhM : h ∈ wcRRSpace Ω X fX U ω M := mono D M hD hh
    refine ⟨fun s => b.repr ⟨h, hhM⟩ s, ?_⟩
    have := congrArg (fun y : wcRRSpace Ω X fX U ω M => (y : FractionRing Γ(X, U)))
      (b.sum_repr ⟨h, hhM⟩)
    simp only [Submodule.coe_sum, Submodule.coe_smul, hsmul] at this
    exact this.symm

theorem wc_closed_point_residue_surjective : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (Y : Scheme.{u}) (p : Y ⟶ Spec (.of Ω)) [LocallyOfFiniteType p] (y : Y),
    IsClosed ({y} : Set Y) →
    Function.Surjective ((Y.evaluation ⊤ y trivial).hom.comp
      (p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)) :=
by
  intro Ω _ _ Y p _ y hy
  haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace p
  haveI : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
    isClosed_singleton_iff_locallyOfFiniteType.mp hy
  set g := Y.fromSpecResidueField y ≫ p with hg
  have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
  have hft : (Spec.preimage g).hom.FiniteType := by
    have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
  have hs2 : (Y.fromSpecResidueField y).appTop ≫ (Scheme.ΓSpecIso (Y.residueField y)).hom =
      Y.evaluation ⊤ y trivial := by
    rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
    simp only [Category.assoc]
    erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
      Iso.inv_hom_id_assoc, Scheme.germ_residue]
  have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ p.appTop ≫
      Y.evaluation ⊤ y trivial := by
    rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ, hg, Scheme.Hom.comp_appTop,
      Category.assoc, hs2]
  have hφ : (Y.evaluation ⊤ y trivial).hom.comp
      (p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom) =
      (Spec.preimage g).hom := by
    rw [heq]; rfl
  rw [hφ]
  letI : Algebra Ω (Y.residueField y) := (Spec.preimage g).hom.toAlgebra
  haveI : Algebra.FiniteType Ω (Y.residueField y) := hft
  haveI : Module.Finite Ω (Y.residueField y) := finite_of_finite_type_of_isJacobsonRing Ω _
  intro s
  have hs : IsIntegral Ω s := Algebra.IsIntegral.isIntegral s
  have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
  obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
  exact ⟨c, hc⟩

theorem wc_pow_coord_facts : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω))
    [IsProper fX] (m : ℕ) (r : wcPow Ω X fX m),
    wcPowDiv Ω X fX m r = ∑ j : Fin m, Finsupp.single (wcPowCoord Ω X fX m j r) (1 : ℤ) ∧
    (IsClosed ({r} : Set (wcPow Ω X fX m)) →
      ∀ j : Fin m, IsClosed ({wcPowCoord Ω X fX m j r} : Set X)) :=
by
  intro Ω _ X fX _
  classical
  have hprop : ∀ m : ℕ, IsProper (wcPowHom Ω X fX m) := by
    intro m
    induction m with
    | zero => exact (inferInstance : IsProper (𝟙 (Spec (.of Ω))))
    | succ m ih =>
      haveI := ih
      exact (inferInstance :
        IsProper (Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowHom Ω X fX m))
  have hlast : ∀ (m : ℕ) (r : wcPow Ω X fX (m + 1)),
      wcPowCoord Ω X fX (m + 1) (Fin.last m) r = Limits.pullback.snd (wcPowHom Ω X fX m) fX r := by
    intro m r
    have : wcPowCoord Ω X fX (m + 1) (Fin.last m) = Limits.pullback.snd (wcPowHom Ω X fX m) fX := by
      show Fin.lastCases (motive := fun _ => wcPow Ω X fX (m + 1) ⟶ X)
        (Limits.pullback.snd (wcPowHom Ω X fX m) fX)
        (fun i => Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowCoord Ω X fX m i)
        (Fin.last m) = _
      exact Fin.lastCases_last
    exact congrArg (fun f : wcPow Ω X fX (m + 1) ⟶ X => f r) this
  have hcs : ∀ (m : ℕ) (i : Fin m) (r : wcPow Ω X fX (m + 1)),
      wcPowCoord Ω X fX (m + 1) (Fin.castSucc i) r =
        wcPowCoord Ω X fX m i (Limits.pullback.fst (wcPowHom Ω X fX m) fX r) := by
    intro m i r
    have : wcPowCoord Ω X fX (m + 1) (Fin.castSucc i) =
        Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowCoord Ω X fX m i := by
      show Fin.lastCases (motive := fun _ => wcPow Ω X fX (m + 1) ⟶ X)
        (Limits.pullback.snd (wcPowHom Ω X fX m) fX)
        (fun i => Limits.pullback.fst (wcPowHom Ω X fX m) fX ≫ wcPowCoord Ω X fX m i)
        (Fin.castSucc i) = _
      exact Fin.lastCases_castSucc i
    exact (congrArg (fun f : wcPow Ω X fX (m + 1) ⟶ X => f r) this).trans
      (Scheme.Hom.comp_apply _ _ _)
  have hA : ∀ (m : ℕ) (r : wcPow Ω X fX m),
      wcPowDiv Ω X fX m r = ∑ j : Fin m, Finsupp.single (wcPowCoord Ω X fX m j r) (1 : ℤ) := by
    intro m
    induction m with
    | zero => intro r; simp [wcPowDiv]
    | succ m ih =>
      intro r
      show wcPowDiv Ω X fX m (Limits.pullback.fst (wcPowHom Ω X fX m) fX r) +
          Finsupp.single (Limits.pullback.snd (wcPowHom Ω X fX m) fX r) 1 = _
      rw [Fin.sum_univ_castSucc, hlast, ih]
      simp only [hcs]
  have hB : ∀ (m : ℕ) (r : wcPow Ω X fX m), IsClosed ({r} : Set (wcPow Ω X fX m)) →
      ∀ j : Fin m, IsClosed ({wcPowCoord Ω X fX m j r} : Set X) := by
    intro m
    induction m with
    | zero => intro r _ j; exact j.elim0
    | succ m ih =>
      haveI := hprop m
      intro r hr j
      have hr' : IsClosed ({(r : ↥(Limits.pullback (wcPowHom Ω X fX m) fX))} :
          Set ↥(Limits.pullback (wcPowHom Ω X fX m) fX)) := hr
      have hfst : IsClosed ({Limits.pullback.fst (wcPowHom Ω X fX m) fX r} :
          Set (wcPow Ω X fX m)) := by
        have h := (Limits.pullback.fst (wcPowHom Ω X fX m) fX).isClosedMap _ hr'
        exact (congrArg IsClosed (Set.image_singleton
          (f := ⇑(Limits.pullback.fst (wcPowHom Ω X fX m) fX))
          (a := (r : ↥(Limits.pullback (wcPowHom Ω X fX m) fX))))).mp h
      have hsnd : IsClosed ({Limits.pullback.snd (wcPowHom Ω X fX m) fX r} : Set X) := by
        have h := (Limits.pullback.snd (wcPowHom Ω X fX m) fX).isClosedMap _ hr'
        exact (congrArg IsClosed (Set.image_singleton
          (f := ⇑(Limits.pullback.snd (wcPowHom Ω X fX m) fX))
          (a := (r : ↥(Limits.pullback (wcPowHom Ω X fX m) fX))))).mp h
      refine Fin.lastCases ?_ (fun i => ?_) j
      · rw [hlast]; exact hsnd
      · rw [hcs]; exact ih _ hfst i
  intro m r
  exact ⟨hA m r, hB m r⟩

theorem wc_rr_space_mem_iff : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) [IrreducibleSpace X]
    (fX : X ⟶ Spec (.of Ω)) (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U)
    (ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ), wcCurveOrdData Ω X fX U hU ω →
    ∀ (D : X →₀ ℤ) (f : FractionRing Γ(X, U)), f ∈ wcRRSpace Ω X fX U ω D ↔
      (f = 0 ∨ ∃ hf : f ≠ 0, ∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 f hf)) + D x) :=
by
  intro Ω _ X _ fX U _ hU ω hω D f
  classical
  letI : Algebra Ω (FractionRing Γ(X, U)) := (wcCurveConst Ω X fX U).toAlgebra
  have hconst : ∀ (c : Ω) (hc : wcCurveConst Ω X fX U c ≠ 0) (x : X),
      ω x (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)) = 0 := by
    intro c hc x
    have h1 : ∀ y, 0 ≤ ω y (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)) := by
      refine (hω.2.2.2.2.2 _).2 ⟨c, ?_⟩
      rfl
    have h2 : ∀ y, 0 ≤ ω y (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)⁻¹) := by
      refine (hω.2.2.2.2.2 _).2 ⟨c⁻¹, ?_⟩
      rw [Units.val_inv_eq_inv_val]
      change wcCurveConst Ω X fX U c⁻¹ = (wcCurveConst Ω X fX U c)⁻¹
      exact map_inv₀ _ c
    have h3 : ω x (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)) +
        ω x (Additive.ofMul (Units.mk0 (wcCurveConst Ω X fX U c) hc)⁻¹) = 0 := by
      rw [← map_add, ← ofMul_mul, mul_inv_cancel, ofMul_one, map_zero]
    have e1 := h1 x
    have e2 := h2 x
    omega
  constructor
  · intro hg
    unfold wcRRSpace at hg
    induction hg using Submodule.span_induction with
    | mem a ha => exact Or.inr ha
    | zero => exact Or.inl rfl
    | add a b _ _ ha hb =>
      rcases ha with rfl | ⟨ha0, ba⟩
      · rw [zero_add]; exact hb
      rcases hb with rfl | ⟨hb0, bb⟩
      · rw [add_zero]; exact Or.inr ⟨ha0, ba⟩
      by_cases hab : a + b = 0
      · exact Or.inl hab
      refine Or.inr ⟨hab, fun x => ?_⟩
      have hu := hω.2.2.2.2.1 x (Units.mk0 a ha0) (Units.mk0 b hb0) (Units.mk0 (a + b) hab)
        (by simp)
      have e1 := ba x
      have e2 := bb x
      rcases min_le_iff.mp hu with h | h <;> linarith
    | smul c a _ ha =>
      rw [show c • a = wcCurveConst Ω X fX U c * a from rfl]
      rcases ha with rfl | ⟨ha0, ba⟩
      · exact Or.inl (mul_zero _)
      by_cases hc : wcCurveConst Ω X fX U c = 0
      · left; rw [hc, zero_mul]
      have hca : wcCurveConst Ω X fX U c * a ≠ 0 := mul_ne_zero hc ha0
      refine Or.inr ⟨hca, fun x => ?_⟩
      have e : Units.mk0 _ hca = Units.mk0 _ hc * Units.mk0 a ha0 := Units.ext (by simp)
      rw [e, ofMul_mul, map_add, hconst c hc x, zero_add]
      exact ba x
  · rintro (rfl | ⟨hf, hb⟩)
    · exact Submodule.zero_mem _
    · unfold wcRRSpace
      exact Submodule.subset_span ⟨hf, hb⟩

theorem wc_closed_points_separate_open : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X T : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsSeparated fX] (gT : T ⟶ Spec (.of Ω))
    [LocallyOfFiniteType gT] (p p' : T ⟶ X), p ≫ fX = gT → p' ≫ fX = gT →
    ∀ w₀ : T, p w₀ ≠ p' w₀ →
      ∃ O : T.Opens, w₀ ∈ O ∧ ∀ w ∈ O, IsClosed ({w} : Set T) → p w ≠ p' w :=
by


  have hres : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (Y : Scheme.{u}) (p : Y ⟶ Spec (.of Ω)) [LocallyOfFiniteType p] (y : Y),
      IsClosed ({y} : Set Y) →
      Function.Surjective ((Y.evaluation ⊤ y trivial).hom.comp
        (p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)) := by
    intro Ω _ _ Y p _ y hy
    haveI : JacobsonSpace Y := LocallyOfFiniteType.jacobsonSpace p
    haveI : LocallyOfFiniteType (Y.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    set g := Y.fromSpecResidueField y ≫ p with hg
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hft : (Spec.preimage g).hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    have hs2 : (Y.fromSpecResidueField y).appTop ≫ (Scheme.ΓSpecIso (Y.residueField y)).hom =
        Y.evaluation ⊤ y trivial := by
      rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
      simp only [Category.assoc]
      erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc, Scheme.germ_residue]
    have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ p.appTop ≫
        Y.evaluation ⊤ y trivial := by
      rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ, hg, Scheme.Hom.comp_appTop,
        Category.assoc, hs2]
    have hφ : (Y.evaluation ⊤ y trivial).hom.comp
        (p.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom) =
        (Spec.preimage g).hom := by
      rw [heq]; rfl
    rw [hφ]
    letI : Algebra Ω (Y.residueField y) := (Spec.preimage g).hom.toAlgebra
    haveI : Algebra.FiniteType Ω (Y.residueField y) := hft
    haveI : Module.Finite Ω (Y.residueField y) := finite_of_finite_type_of_isJacobsonRing Ω _
    intro s
    have hs : IsIntegral Ω s := Algebra.IsIntegral.isIntegral s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
    exact ⟨c, hc⟩

  have L1 : ∀ (X : Scheme.{u}) (K : Type u) [Field K] (a : Spec (.of K) ⟶ X),
      X.evaluation ⊤ (a (IsLocalRing.closedPoint K)) trivial ≫
        Scheme.descResidueField (Scheme.stalkClosedPointTo a) =
      a.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom := by
    intro X K _ a
    have h := Scheme.germ_stalkClosedPointTo a ⊤ trivial
    simp only [Scheme.evaluation, Category.assoc, Scheme.residue_descResidueField, h]
    simp only [Iso.trans_hom, Functor.mapIso_hom, Iso.op_hom, eqToIso.hom, eqToHom_op, eqToHom_map]
    rfl

  have L2 : ∀ (X : Scheme.{u}) (x : X),
      (X.fromSpecResidueField x).appTop ≫ (Scheme.ΓSpecIso (X.residueField x)).hom =
        X.evaluation ⊤ x trivial := by
    intro X x
    rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Category.assoc,
      Scheme.ΓSpecIso_naturality, Scheme.fromSpecStalk_appTop]
    simp
    rfl

  have L3 : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (K : Type u)
      [Field K] (a₁ a₂ : Spec (.of K) ⟶ X), a₁ ≫ fX = a₂ ≫ fX →
      a₁ (IsLocalRing.closedPoint K) = a₂ (IsLocalRing.closedPoint K) →
      Function.Surjective ((Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom.comp
        ((a₁ ≫ fX).appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)) →
      a₁ = a₂ := by
    intro Ω _ X fX K _ a₁ a₂ hf hpt hs
    have key : ∀ (b : Spec (.of K) ⟶ X) (u : Γ(X, ⊤)),
        (Scheme.descResidueField (Scheme.stalkClosedPointTo b)).hom
          ((X.evaluation ⊤ (b (IsLocalRing.closedPoint K)) trivial).hom u) =
        (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom (b.appTop.hom u) := by
      intro b u
      rw [← CommRingCat.comp_apply, L1 X K b, CommRingCat.comp_apply]
    have hcongr : ∀ (y₁ y₂ : X) (e : y₁ = y₂) (u : Γ(X, ⊤)),
        (Scheme.residueFieldCongr e).hom.hom ((X.evaluation ⊤ y₁ trivial).hom u) =
          (X.evaluation ⊤ y₂ trivial).hom u := by
      intro y₁ y₂ e u
      subst e
      simp [Scheme.residueFieldCongr_refl]
    apply (Scheme.SpecToEquivOfField K X).injective
    rw [Scheme.SpecToEquivOfField_eq_iff]
    refine ⟨hpt, ?_⟩
    change Scheme.descResidueField (Scheme.stalkClosedPointTo a₁) =
      (Scheme.residueFieldCongr hpt).hom ≫ Scheme.descResidueField (Scheme.stalkClosedPointTo a₂)
    ext z
    obtain ⟨c, hc⟩ := hs ((Scheme.descResidueField (Scheme.stalkClosedPointTo a₁)).hom z)
    have hc1 : (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom
        (a₁.appTop.hom (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))) =
        (Scheme.descResidueField (Scheme.stalkClosedPointTo a₁)).hom z := by
      rw [← hc, Scheme.Hom.comp_appTop]
      rfl
    have hc2 : (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom
        (a₂.appTop.hom (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))) =
        (Scheme.descResidueField (Scheme.stalkClosedPointTo a₁)).hom z := by
      rw [← hc, hf, Scheme.Hom.comp_appTop]
      rfl
    set u := fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c) with hu
    have hz : (X.evaluation ⊤ (a₁ (IsLocalRing.closedPoint K)) trivial).hom u = z := by
      apply (Scheme.descResidueField (Scheme.stalkClosedPointTo a₁)).hom.injective
      rw [key a₁ u, hc1]
    rw [CommRingCat.comp_apply, ← hz, hcongr _ _ hpt u, key a₂ u, hc2, hz]
  intro Ω _ _ X T fX _ gT _ p p' hp hp' w₀ hw₀
  have hpp : p ≫ fX = p' ≫ fX := hp.trans hp'.symm
  have hq1 : Limits.pullback.lift p p' hpp ≫ Limits.pullback.fst fX fX = p :=
    Limits.pullback.lift_fst _ _ _
  have hq2 : Limits.pullback.lift p p' hpp ≫ Limits.pullback.snd fX fX = p' :=
    Limits.pullback.lift_snd _ _ _
  have hZ : IsClosed (Set.range (Limits.pullback.diagonal fX)) :=
    (Limits.pullback.diagonal fX).isClosedEmbedding.isClosed_range
  refine ⟨⟨Limits.pullback.lift p p' hpp ⁻¹' (Set.range (Limits.pullback.diagonal fX))ᶜ,
    hZ.isOpen_compl.preimage (Limits.pullback.lift p p' hpp).continuous⟩, ?_, ?_⟩
  · intro h
    obtain ⟨x, hx⟩ := h
    apply hw₀
    have e1 : p w₀ = x := by
      rw [← hq1, Scheme.Hom.comp_apply, ← hx, ← Scheme.Hom.comp_apply,
        Limits.pullback.diagonal_fst]
      rfl
    have e2 : p' w₀ = x := by
      rw [← hq2, Scheme.Hom.comp_apply, ← hx, ← Scheme.Hom.comp_apply,
        Limits.pullback.diagonal_snd]
      rfl
    rw [e1, e2]
  · intro w hwO hwc heq
    apply hwO
    have hsurj := hres Ω T gT w hwc
    have h1 : ∀ (q : T ⟶ X) (x : Spec (T.residueField w)),
        (T.fromSpecResidueField w ≫ q) x = q w := by
      intro q x
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    have hL3 : T.fromSpecResidueField w ≫ p = T.fromSpecResidueField w ≫ p' := by
      apply L3 Ω X fX (T.residueField w) (T.fromSpecResidueField w ≫ p)
        (T.fromSpecResidueField w ≫ p')
      · rw [Category.assoc, Category.assoc, hpp]
      · exact (h1 p _).trans (heq.trans (h1 p' _).symm)
      · rw [Category.assoc, hp, Scheme.Hom.comp_appTop]
        convert hsurj using 1
        ext c
        rw [← L2 T w]
        rfl
    have hsq : T.fromSpecResidueField w ≫ Limits.pullback.lift p p' hpp =
        (T.fromSpecResidueField w ≫ p) ≫ Limits.pullback.diagonal fX := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hq1, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [Category.assoc, hq2, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
          hL3]
    have key2 : ∀ x : Spec (T.residueField w),
        (Limits.pullback.diagonal fX) ((T.fromSpecResidueField w ≫ p) x) =
          (Limits.pullback.lift p p' hpp) w := by
      intro x
      rw [← Scheme.Hom.comp_apply, ← hsq, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    exact ⟨_, key2 (IsLocalRing.closedPoint (T.residueField w))⟩

theorem wc_curve_etale_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (x : X), IsClosed ({x} : Set X) → ∀ V : X.Opens, x ∈ V →
      wcEtaleChartAt Ω X fX x V :=
by
  intro Ω _ _ X fX _ _ hnorm hdim x hx V hxV
  classical

  have s2 : ∀ (k : Type u) [Field k] (A : Type u) [CommRing A] [Algebra k A]
      [Algebra.FiniteType k A] (m : Ideal A), m.IsPrime → ∀ t : A, t ∈ m →
      (∀ a : A, ∃ c : k, a - algebraMap k A c ∈ m) →
      (∀ a : A, ∃ (c₀ c : k) (σ w : A), σ ∉ m ∧
        σ * (a - algebraMap k A c₀ - algebraMap k A c * t) = t ^ 2 * w) →
      ∃ E : TensorProduct k A A,
        (∀ a : A, ∃ θ : TensorProduct k A A,
          E * (TensorProduct.tmul k a (1 : A) - TensorProduct.tmul k (1 : A) a) =
            (TensorProduct.tmul k t (1 : A) - TensorProduct.tmul k (1 : A) t) * θ) ∧
        E - 1 ∈ Ideal.span {z : TensorProduct k A A | ∃ a ∈ m,
          z = TensorProduct.tmul k a (1 : A) ∨ z = TensorProduct.tmul k (1 : A) a} := by
    intro k _ A _ _ _ m hm t ht hres hexp
    set L : A →+* TensorProduct k A A := Algebra.TensorProduct.includeLeftRingHom with hL
    set R : A →+* TensorProduct k A A :=
      (Algebra.TensorProduct.includeRight : A →ₐ[k] TensorProduct k A A).toRingHom with hR
    have hLa : ∀ a : A, L a = TensorProduct.tmul k a (1 : A) := fun a => rfl
    have hRa : ∀ a : A, R a = TensorProduct.tmul k (1 : A) a := fun a => rfl
    let d : A → TensorProduct k A A := fun a => L a - R a
    have hd : ∀ a, d a = TensorProduct.tmul k a (1 : A) - TensorProduct.tmul k (1 : A) a :=
      fun a => rfl
    set J : Ideal (TensorProduct k A A) := KaehlerDifferential.ideal k A with hJ
    set N : Ideal (TensorProduct k A A) := Ideal.span {d t} with hN
    set I : Ideal (TensorProduct k A A) := Ideal.span {z : TensorProduct k A A | ∃ a ∈ m,
          z = TensorProduct.tmul k a (1 : A) ∨ z = TensorProduct.tmul k (1 : A) a} with hI
    have hJfg : J.FG := KaehlerDifferential.ideal_fg k A
    have hdJ : ∀ a, d a ∈ J := by
      intro a
      have := KaehlerDifferential.one_smul_sub_smul_one_mem_ideal (R := k) a
      have h2 : d a = -(TensorProduct.tmul k (1 : A) a - TensorProduct.tmul k a (1 : A)) := by
        rw [hd]; abel
      rw [h2]
      exact J.neg_mem this
    have hLI : ∀ a ∈ m, L a ∈ I := fun a ha => Ideal.subset_span ⟨a, ha, Or.inl rfl⟩
    have hRI : ∀ a ∈ m, R a ∈ I := fun a ha => Ideal.subset_span ⟨a, ha, Or.inr rfl⟩
    have hLR : ∀ c : k, L (algebraMap k A c) = R (algebraMap k A c) := by
      intro c
      rw [hLa, hRa, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    have hLalg : ∀ c : k, L (algebraMap k A c) = algebraMap k (TensorProduct k A A) c := by
      intro c
      rw [hLa, Algebra.TensorProduct.algebraMap_apply]
    have hdmul : ∀ x y : A, d (x * y) = L x * d y + d x * R y := by
      intro x y
      simp only [d, map_mul]
      ring
    have key : J ≤ N ⊔ I * J := by
      have hall : ∀ a : A, d a ∈ N ⊔ I * J := by
        intro a
        obtain ⟨c₀, c, σ, w, hσ, hσw⟩ := hexp a
        set u := a - algebraMap k A c₀ - algebraMap k A c * t with hu
        have hum : u ∈ m := by
          have : σ * u ∈ m := by
            rw [hσw]
            exact m.mul_mem_right w (by rw [pow_two]; exact m.mul_mem_left t ht)
          exact (hm.mem_or_mem this).resolve_left hσ
        have hda : d a = d u + algebraMap k (TensorProduct k A A) c * d t := by
          have : a = u + algebraMap k A c₀ + algebraMap k A c * t := by rw [hu]; ring
          rw [this]
          simp only [d, map_add, map_mul, hLR]
          rw [← hLalg]
          rw [hLR]
          ring
        have hstar : L σ * d u = L (t ^ 2) * d w + d t * ((L t + R t) * R w) - d σ * R u := by
          have e1 := hdmul σ u
          have e2 := hdmul (t ^ 2) w
          rw [hσw] at e1
          have e3 : d (t ^ 2) = d t * (L t + R t) := by
            simp only [d, map_pow]; ring
          rw [e3] at e2
          rw [e2] at e1
          linear_combination e1.symm
        have hLσdu : L σ * d u ∈ N ⊔ I * J := by
          rw [hstar]
          refine Ideal.sub_mem _ (Ideal.add_mem _ ?_ ?_) ?_
          · apply Ideal.mem_sup_right
            exact Ideal.mul_mem_mul (hLI _ (by rw [pow_two]; exact m.mul_mem_left t ht)) (hdJ w)
          · apply Ideal.mem_sup_left
            exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
          · apply Ideal.mem_sup_right
            rw [mul_comm (d σ)]
            exact Ideal.mul_mem_mul (hRI u hum) (hdJ σ)
        obtain ⟨e, he⟩ := hres σ
        have he0 : e ≠ 0 := by
          rintro rfl
          apply hσ
          simpa using he
        have hedu : algebraMap k (TensorProduct k A A) e * d u ∈ N ⊔ I * J := by
          have : algebraMap k (TensorProduct k A A) e * d u =
              L σ * d u - L (σ - algebraMap k A e) * d u := by
            rw [map_sub, hLalg]; ring
          rw [this]
          refine Ideal.sub_mem _ hLσdu ?_
          exact Ideal.mem_sup_right (Ideal.mul_mem_mul (hLI _ he) (hdJ u))
        have hdu : d u ∈ N ⊔ I * J := by
          have : d u = algebraMap k (TensorProduct k A A) e⁻¹ *
              (algebraMap k (TensorProduct k A A) e * d u) := by
            rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ he0, map_one, one_mul]
          rw [this]
          exact Ideal.mul_mem_left _ _ hedu
        rw [hda]
        refine Ideal.add_mem _ hdu ?_
        exact Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span rfl))
      conv_lhs => rw [hJ, ← KaehlerDifferential.span_range_eq_ideal]
      rw [Ideal.span_le]
      rintro _ ⟨s, rfl⟩
      have h2 : TensorProduct.tmul k (1 : A) s - TensorProduct.tmul k s (1 : A) = -d s := by
        rw [hd]; abel
      show TensorProduct.tmul k (1 : A) s - TensorProduct.tmul k s (1 : A) ∈ N ⊔ I * J
      rw [h2]
      exact (N ⊔ I * J).neg_mem (hall s)
    obtain ⟨E, hE1, hEJ⟩ := Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup
      (I := I) (N := N) hJfg le_rfl (by rw [Ideal.smul_eq_mul]; exact key)
    refine ⟨E, fun a => ?_, hE1⟩
    have hmem : E * d a ∈ N := hEJ (Submodule.smul_mem_pointwise_smul _ E _ (hdJ a))
    obtain ⟨θ, hθ⟩ := Ideal.mem_span_singleton'.mp hmem
    refine ⟨θ, ?_⟩
    rw [← hd, ← hd, ← hθ, mul_comm]

  have s3 : ∀ (k : Type u) [Field k] (A : Type u) [CommRing A]
      [Algebra k A] (p : Ideal A) [p.IsPrime]
      (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [Algebra A R]
      [IsLocalization.AtPrime R p],
      (∀ a : A, ∃ c : k, a - algebraMap k A c ∈ p) →
      ∃ t : A, t ∈ p ∧ ∀ a : A, ∃ (c₀ c : k) (σ w : A), σ ∉ p ∧
        σ * (a - algebraMap k A c₀ - algebraMap k A c * t) = t ^ 2 * w := by
    intro k _ A _ _ p _ R _ _ _ _ _ hres
    have hmax : ∀ a : A, algebraMap A R a ∈ IsLocalRing.maximalIdeal R ↔ a ∈ p :=
      fun a => IsLocalization.AtPrime.to_map_mem_maximal_iff R p a
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    obtain ⟨⟨t, s₀⟩, hts0⟩ := IsLocalization.mk'_surjective p.primeCompl ϖ
    have hts : IsLocalization.mk' R t s₀ = ϖ := hts0
    have hspec := IsLocalization.mk'_spec R t s₀
    rw [hts] at hspec
    have hunit : IsUnit (algebraMap A R (s₀ : A)) := IsLocalization.map_units R s₀
    have hM : IsLocalRing.maximalIdeal R = Ideal.span {algebraMap A R t} := by
      rw [hϖ.maximalIdeal_eq, ← hspec, Ideal.span_singleton_mul_right_unit hunit]
    have htp : t ∈ p := by
      rw [← hmax, hM]; exact Ideal.subset_span rfl
    have hresR : ∀ r : R, ∃ c : k, r - algebraMap A R (algebraMap k A c) ∈
        IsLocalRing.maximalIdeal R := by
      intro r
      obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl r
      obtain ⟨c₁, hc₁⟩ := hres b
      obtain ⟨c₂, hc₂⟩ := hres (s : A)
      have hc₂0 : c₂ ≠ 0 := by
        rintro rfl
        apply s.2
        simpa using hc₂
      refine ⟨c₁ * c₂⁻¹, ?_⟩
      have hbs : b - algebraMap k A (c₁ * c₂⁻¹) * s ∈ p := by
        have : b - algebraMap k A (c₁ * c₂⁻¹) * s =
            (b - algebraMap k A c₁) - algebraMap k A (c₁ * c₂⁻¹) * (s - algebraMap k A c₂) := by
          have e : algebraMap k A (c₁ * c₂⁻¹) * algebraMap k A c₂ = algebraMap k A c₁ := by
            rw [← map_mul, mul_assoc, inv_mul_cancel₀ hc₂0, mul_one]
          linear_combination -e
        rw [this]
        exact p.sub_mem hc₁ (p.mul_mem_left _ hc₂)
      have hsu : IsUnit (algebraMap A R (s : A)) := IsLocalization.map_units R s
      have key : algebraMap A R (s : A) *
          (IsLocalization.mk' R b s - algebraMap A R (algebraMap k A (c₁ * c₂⁻¹))) =
          algebraMap A R (b - algebraMap k A (c₁ * c₂⁻¹) * s) := by
        rw [mul_sub, IsLocalization.mk'_spec']
        simp only [map_sub, map_mul]
        ring
      have hin : algebraMap A R (s : A) *
          (IsLocalization.mk' R b s - algebraMap A R (algebraMap k A (c₁ * c₂⁻¹))) ∈
          IsLocalRing.maximalIdeal R := by
        rw [key, hmax]; exact hbs
      exact (Ideal.IsPrime.mem_or_mem inferInstance hin).resolve_left
        (fun h => (IsLocalRing.mem_maximalIdeal _).mp h hsu)
    refine ⟨t, htp, fun a => ?_⟩
    obtain ⟨c₀, hc₀⟩ := hres a
    have h1 : algebraMap A R (a - algebraMap k A c₀) ∈ Ideal.span {algebraMap A R t} := by
      rw [← hM, hmax]; exact hc₀
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp h1
    obtain ⟨c, hc⟩ := hresR r
    rw [hM] at hc
    obtain ⟨r', hr'⟩ := Ideal.mem_span_singleton'.mp hc
    obtain ⟨⟨w, s'⟩, hws0⟩ := IsLocalization.mk'_surjective p.primeCompl r'
    have hws : IsLocalization.mk' R w s' = r' := hws0
    have hspec' := IsLocalization.mk'_spec' R w s'
    rw [hws] at hspec'
    have heq : algebraMap A R ((s' : A) * (a - algebraMap k A c₀ - algebraMap k A c * t)) =
        algebraMap A R (t ^ 2 * w) := by
      have e1 : algebraMap A R (a - algebraMap k A c₀ - algebraMap k A c * t) =
          r' * algebraMap A R t * algebraMap A R t := by
        rw [map_sub, ← hr, map_mul]
        linear_combination -(algebraMap A R t) * hr'
      rw [map_mul, e1, map_mul, map_pow, ← hspec']
      ring
    obtain ⟨τ, hτ⟩ := IsLocalization.exists_of_eq (M := p.primeCompl) heq
    refine ⟨c₀, c, (τ : A) * s', τ * w, ?_, ?_⟩
    · exact Ideal.IsPrime.mul_notMem inferInstance τ.2 s'.2
    · rw [mul_assoc, hτ]; ring

  obtain ⟨W', hW'aff, hxW', hW'V⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens) hxV
  have hW : IsAffineOpen W' := hW'aff
  letI instA : Algebra Ω Γ(X, W') := ((X.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op).hom.comp
      (fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)).toAlgebra
  refine ⟨W', hW, hxW', hW'V, ?_⟩

  have hft : Algebra.FiniteType Ω Γ(X, W') := by
    rw [← RingHom.finiteType_algebraMap]
    have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType fX inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨W', hW⟩ le_top
    have h2 : algebraMap Ω Γ(X, W') = (fX.appLE ⊤ W' le_top).hom.comp
        (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom := rfl
    rw [h2]
    refine h1.comp (RingHom.FiniteType.of_surjective _ ?_)
    intro y
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of Ω)).hom.hom y, ?_⟩
    change ((Scheme.ΓSpecIso (CommRingCat.of Ω)).hom ≫
      (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv).hom y = y
    rw [Iso.hom_inv_id]
    rfl
  set m : Ideal Γ(X, W') := (hW.primeIdealOf ⟨x, hxW'⟩).asIdeal with hm
  haveI hmprime : m.IsPrime := (hW.primeIdealOf ⟨x, hxW'⟩).isPrime

  have hev : ∀ a : Γ(X, W'), (X.evaluation W' x hxW').hom a = 0 ↔ a ∈ m := by
    intro a
    have h1 := Scheme.evaluation_eq_zero_iff_notMem_basicOpen X x hxW' a
    have h2 : x ∈ X.basicOpen a ↔ a ∉ m := by
      rw [hm, ← PrimeSpectrum.mem_basicOpen, ← hW.fromSpec_preimage_basicOpen]
      show _ ↔ hW.fromSpec (hW.primeIdealOf ⟨x, hxW'⟩) ∈ X.basicOpen a
      rw [hW.fromSpec_primeIdealOf]
    exact h1.trans (by rw [h2, not_not])

  have hevres : ∀ s : Γ(X, ⊤), (X.evaluation W' x hxW').hom
      ((X.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op).hom s) =
      (X.evaluation ⊤ x trivial).hom s := by
    intro s
    simp [Scheme.evaluation]
  have hresm : ∀ a : Γ(X, W'), ∃ c : Ω, a - algebraMap Ω Γ(X, W') c ∈ m := by
    intro a
    obtain ⟨c, hc⟩ := wc_closed_point_residue_surjective Ω X fX x hx
      ((X.evaluation W' x hxW').hom a)
    refine ⟨c, (hev _).mp ?_⟩
    rw [map_sub]
    have : (X.evaluation W' x hxW').hom (algebraMap Ω Γ(X, W') c) =
        (X.evaluation W' x hxW').hom a := by
      rw [← hc]
      exact hevres _
    rw [this, sub_self]

  haveI : ∀ y : X, _root_.IsReduced (X.presheaf.stalk y) := fun y => by
    haveI := (hnorm y).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  have hcl := (wc_curve_points_closed_opens_compact Ω X fX hdim).1
  have hclosed : ∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X) := by
    intro y hy
    refine hcl {y} (Set.finite_singleton y) ?_
    intro h
    exact hy (Set.mem_singleton_iff.mp h).symm
  have hxη : x ≠ genericPoint X := by
    intro hxe
    have hc1 : closure ({genericPoint X} : Set X) = Set.univ :=
      isGenericPoint_def.mp (genericPoint_spec X)
    rw [← hxe, hx.closure_eq] at hc1
    haveI : Subsingleton X := ⟨fun a b => by
      have ha : a ∈ ({x} : Set X) := hc1 ▸ Set.mem_univ a
      have hb : b ∈ ({x} : Set X) := hc1 ▸ Set.mem_univ b
      rw [Set.mem_singleton_iff] at ha hb
      rw [ha, hb]⟩
    have h0 := topologicalKrullDim_zero_of_discreteTopology X
    rw [hdim] at h0
    exact absurd h0 (by decide)
  have hdvr : IsDiscreteValuationRing (X.presheaf.stalk x) :=
    wc_curve_stalk_dvr Ω X fX (fun y => (hnorm y).2) hclosed x hxη
  letI := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxW'⟩
  haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x) m := hW.isLocalization_stalk ⟨x, hxW'⟩
  obtain ⟨t, htm, hexp⟩ := s3 Ω Γ(X, W') m (X.presheaf.stalk x) hresm
  obtain ⟨E, hchart, hE1⟩ := s2 Ω Γ(X, W') m hmprime t htm hresm hexp
  refine ⟨t, E, hchart, ?_⟩
  have hset : {z : TensorProduct Ω Γ(X, W') Γ(X, W') | ∃ a : Γ(X, W'),
      (X.evaluation W' x hxW').hom a = 0 ∧
        (z = TensorProduct.tmul Ω a (1 : Γ(X, W')) ∨ z = TensorProduct.tmul Ω (1 : Γ(X, W')) a)} =
      {z : TensorProduct Ω Γ(X, W') Γ(X, W') | ∃ a ∈ m,
        z = TensorProduct.tmul Ω a (1 : Γ(X, W')) ∨ z = TensorProduct.tmul Ω (1 : Γ(X, W')) a} := by
    ext z
    simp only [Set.mem_setOf_eq, hev]
  rw [hset]
  exact hE1

theorem wc_closed_point_image_closed : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (T Y : Scheme.{u})
    (gT : T ⟶ Spec (.of Ω)) (gY : Y ⟶ Spec (.of Ω)) [LocallyOfFiniteType gT]
    [LocallyOfFiniteType gY] (q : T ⟶ Y), q ≫ gY = gT → ∀ w : T, IsClosed ({w} : Set T) →
    IsClosed ({q w} : Set Y) :=
by
  intro Ω _ _ T Y gT gY _ _ q hq w hw
  have hT : Function.Surjective ((T.evaluation ⊤ w trivial).hom.comp
      (gT.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)) := by
    haveI : JacobsonSpace T := LocallyOfFiniteType.jacobsonSpace gT
    haveI : LocallyOfFiniteType (T.fromSpecResidueField w) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hw
    set g := T.fromSpecResidueField w ≫ gT with hg
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hft : (Spec.preimage g).hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    have hs2 : (T.fromSpecResidueField w).appTop ≫ (Scheme.ΓSpecIso (T.residueField w)).hom =
        T.evaluation ⊤ w trivial := by
      rw [Scheme.fromSpecResidueField, Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop]
      simp only [Category.assoc]
      erw [CategoryTheory.Functor.map_id, Category.id_comp, Scheme.ΓSpecIso_naturality,
        Iso.inv_hom_id_assoc, Scheme.germ_residue]
    have heq : Spec.preimage g = (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫ gT.appTop ≫
        T.evaluation ⊤ w trivial := by
      rw [Iso.eq_inv_comp, ← Scheme.ΓSpecIso_naturality, hψ, hg, Scheme.Hom.comp_appTop,
        Category.assoc, hs2]
    have hφ : (T.evaluation ⊤ w trivial).hom.comp
        (gT.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom) =
        (Spec.preimage g).hom := by
      rw [heq]; rfl
    rw [hφ]
    letI : Algebra Ω (T.residueField w) := (Spec.preimage g).hom.toAlgebra
    haveI : Algebra.FiniteType Ω (T.residueField w) := hft
    haveI : Module.Finite Ω (T.residueField w) := finite_of_finite_type_of_isJacobsonRing Ω _
    intro s
    have hs : IsIntegral Ω s := Algebra.IsIntegral.isIntegral s
    have hdeg := IsAlgClosed.degree_eq_one_of_irreducible Ω (minpoly.irreducible hs)
    obtain ⟨c, hc⟩ := minpoly.mem_range_of_degree_eq_one Ω s hdeg
    exact ⟨c, hc⟩

  have hY : Function.Surjective ((Y.evaluation ⊤ (q w) trivial).hom.comp
      (gY.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)) := by
    have hcompat : ∀ c : Ω, (q.residueFieldMap w).hom ((Y.evaluation ⊤ (q w) trivial).hom
        (gY.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))) =
        (T.evaluation ⊤ w trivial).hom
          (gT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c)) := by
      intro c
      rw [Scheme.evaluation_naturality_apply q (V := ⊤) w trivial]
      rw [← hq, Scheme.Hom.comp_appTop]
      rfl
    intro a
    obtain ⟨c, hc⟩ := hT ((q.residueFieldMap w).hom a)
    refine ⟨c, (q.residueFieldMap w).hom.injective ?_⟩
    simp only [RingHom.comp_apply] at hc ⊢
    rw [hcompat, hc]

  have s3 : ∀ y : Y, Function.Surjective ((Y.evaluation ⊤ y trivial).hom.comp
      (gY.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)) →
      IsClosed ({y} : Set Y) := by
    intro y hy
    have hev : ∀ (W : Y.Opens) (z : Y) (hz : z ∈ W) (c : Ω),
        (Y.evaluation W z hz).hom ((Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
          (gY.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))) =
        (Y.evaluation ⊤ z trivial).hom
          (gY.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c)) := by
      intro W z hz c
      simp [Scheme.evaluation]
    refine closure_subset_iff_isClosed.mp ?_
    intro y' hy'
    have h : y ⤳ y' := specializes_iff_mem_closure.mpr hy'
    obtain ⟨W, hW, hy'W, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := y') trivial
    have hyW : y ∈ W := h.mem_open W.isOpen hy'W
    have h' : y' ⤳ y := by
      rw [specializes_iff_forall_open]
      intro S hS hyS
      obtain ⟨f, hfO, hyf⟩ := hW.exists_basicOpen_le (V := ⟨S, hS⟩) ⟨y, hyS⟩ hyW
      have hf0 : (Y.evaluation W y hyW).hom f ≠ 0 :=
        (Y.evaluation_ne_zero_iff_mem_basicOpen y hyW f).mpr hyf
      obtain ⟨c, hc⟩ := hy ((Y.evaluation W y hyW).hom f)
      simp only [RingHom.comp_apply] at hc
      set e := (Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
          (gY.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c)) with he
      have ht : (Y.evaluation W y hyW).hom (f - e) = 0 := by
        rw [map_sub, he, hev, hc, sub_self]
      have hyt : y ∉ Y.basicOpen (f - e) :=
        (Y.evaluation_eq_zero_iff_notMem_basicOpen y hyW _).mp ht
      have hy't : y' ∉ Y.basicOpen (f - e) :=
        fun hm => hyt (h.mem_open (Y.basicOpen (f - e)).isOpen hm)
      have ht' : (Y.evaluation W y' hy'W).hom (f - e) = 0 :=
        (Y.evaluation_eq_zero_iff_notMem_basicOpen y' hy'W _).mpr hy't
      rw [map_sub, sub_eq_zero, he, hev] at ht'
      have hc0 : c ≠ 0 := by
        rintro rfl
        apply hf0
        rw [← hc]
        simp
      have hne : (Y.evaluation W y' hy'W).hom f ≠ 0 := by
        rw [ht']
        intro h0
        apply hc0
        apply ((Y.evaluation ⊤ y' trivial).hom.comp
          (gY.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom)).injective
        simpa using h0
      have hmem : y' ∈ Y.basicOpen f := (Y.evaluation_ne_zero_iff_mem_basicOpen y' hy'W f).mp hne
      exact hfO hmem
    exact Set.mem_singleton_iff.mpr (h.antisymm h').eq.symm
  exact s3 (q w) hY

theorem wc_affine_closed_point_separation : ∀ (X : Scheme.{u}) (W : X.Opens), IsAffineOpen W →
    ∀ (y y' : X) (hy : y ∈ W) (hy' : y' ∈ W), IsClosed ({y} : Set X) → y ≠ y' →
    ∃ s : Γ(X, W), (X.evaluation W y hy).hom s = 0 ∧ (X.evaluation W y' hy').hom s ≠ 0 :=
by
  intro X W hW y y' hy hy' hclosed hne
  let V : X.Opens := ⟨({y} : Set X)ᶜ, isOpen_compl_iff.mpr hclosed⟩
  have hy'V : y' ∈ V := fun h => hne (Set.mem_singleton_iff.mp h).symm
  obtain ⟨s, hle, hmem⟩ := hW.exists_basicOpen_le (V := V) ⟨y', hy'V⟩ hy'
  refine ⟨s, ?_, ?_⟩
  · rw [Scheme.evaluation_eq_zero_iff_notMem_basicOpen]
    intro h
    exact (hle h) (Set.mem_singleton y)
  · rw [Scheme.evaluation_ne_zero_iff_mem_basicOpen]
    exact hmem

theorem wc_curve_chart_dictionary : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    wcTrueOrd X U ω →
    ∀ (W : X.Opens), IsAffineOpen W → (W : Set X).Nonempty →
    ∃ ι : Γ(X, W) →+* FractionRing Γ(X, U), Function.Injective ι ∧
      (∀ c : Ω, ι ((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
        (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))) =
          wcCurveConst Ω X fX U c) ∧
      (∀ (y : X) (hy : y ∈ W), IsClosed ({y} : Set X) → ∀ (s : Γ(X, W)) (hs : ι s ≠ 0),
        0 ≤ ω y (Additive.ofMul (Units.mk0 (ι s) hs)) ∧
        (1 ≤ ω y (Additive.ofMul (Units.mk0 (ι s) hs)) ↔ (X.evaluation W y hy).hom s = 0)) ∧
      (∀ (y : X) (hy : y ∈ W), IsClosed ({y} : Set X) → ∃ (s : Γ(X, W)) (hs : ι s ≠ 0),
        (X.evaluation W y hy).hom s = 0 ∧ ω y (Additive.ofMul (Units.mk0 (ι s) hs)) = 1) ∧
      (∀ u : FractionRing Γ(X, U), (∀ y : X, y ∈ W → IsClosed ({y} : Set X) →
        u = 0 ∨ ∃ hu : u ≠ 0, 0 ≤ ω y (Additive.ofMul (Units.mk0 u hu))) →
        ∃ s : Γ(X, W), ι s = u) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim U _ hU hfin ω hω htrue W hW hWne
  classical
  haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := fun x => by
    haveI := (hnorm x).1
    infer_instance
  haveI : AlgebraicGeometry.IsReduced X := isReduced_of_isReduced_stalk X
  haveI : AlgebraicGeometry.IsIntegral X := isIntegral_of_irreducibleSpace_of_isReduced X
  have hηU : genericPoint X ∈ U := (wc_dedekind_affine_points X U hU).1
  haveI : Nonempty U := ⟨⟨_, hηU⟩⟩
  have hmemη : ∀ (V : X.Opens) (x : X), x ∈ V → genericPoint X ∈ V :=
    fun V x hx => (genericPoint_specializes x).mem_open V.isOpen hx
  obtain ⟨y₀, hy₀⟩ := hWne
  have hηW : genericPoint X ∈ W := hmemη W y₀ hy₀
  haveI : Nonempty W := ⟨⟨_, hηW⟩⟩
  have hcl : ∀ y : X, y ≠ genericPoint X → IsClosed ({y} : Set X) := fun y hy =>
    (wc_curve_points_closed_opens_compact Ω X fX hdim).1 {y} (Set.finite_singleton y)
      (fun h => hy (Set.mem_singleton_iff.mp h).symm)
  have hηnc : ¬ IsClosed ({genericPoint X} : Set X) := by
    intro h
    have h1 : closure ({genericPoint X} : Set X) = Set.univ :=
      isGenericPoint_def.mp (genericPoint_spec X)
    rw [h.closure_eq] at h1
    haveI : Subsingleton X := ⟨fun x y => by
      have hx : x ∈ ({genericPoint X} : Set X) := h1 ▸ Set.mem_univ x
      have hy : y ∈ ({genericPoint X} : Set X) := h1 ▸ Set.mem_univ y
      rw [Set.mem_singleton_iff] at hx hy
      rw [hx, hy]⟩
    haveI : DiscreteTopology X := Subsingleton.discreteTopology
    have h2 := topologicalKrullDim_zero_of_discreteTopology X
    rw [hdim] at h2
    have h3 : (1 : ℕ) ≤ 0 := by exact_mod_cast h2
    omega
  letI : IsFractionRing Γ(X, U) X.functionField :=
    functionField_isFractionRing_of_isAffineOpen X U hU
  let α := FractionRing.algEquiv Γ(X, U) X.functionField
  have hαalg : ∀ a : Γ(X, U), α (algebraMap Γ(X, U) (FractionRing Γ(X, U)) a) =
      (X.presheaf.germ U (genericPoint X) hηU).hom a := by
    intro a
    rw [AlgEquiv.commutes]
    rfl
  have hspec : ∀ (V : X.Opens) (x : X) (hx : x ∈ V) (s : Γ(X, V)),
      algebraMap (X.presheaf.stalk x) X.functionField ((X.presheaf.germ V x hx).hom s) =
        (X.presheaf.germ V (genericPoint X) (hmemη V x hx)).hom s :=
    fun V x hx s => TopCat.Presheaf.germ_stalkSpecializes_apply X.presheaf hx _ s
  have hφinj : ∀ x : X, Function.Injective (algebraMap (X.presheaf.stalk x) X.functionField) :=
    fun x => IsFractionRing.injective _ _
  have hinjη : ∀ (V : X.Opens) (hV : genericPoint X ∈ V),
      Function.Injective (X.presheaf.germ V (genericPoint X) hV).hom :=
    fun V hV => germ_injective_of_isIntegral X _ hV
  have hres : ∀ (V V' : X.Opens) (h : V' ≤ V) (hV' : genericPoint X ∈ V') (s : Γ(X, V)),
      (X.presheaf.germ V' (genericPoint X) hV').hom ((X.presheaf.map (homOfLE h).op).hom s) =
        (X.presheaf.germ V (genericPoint X) (h hV')).hom s :=
    fun V V' h hV' s => TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE h) _ hV' s

  have hB : ∀ (x : X) (f : (FractionRing Γ(X, U))ˣ), wcStalkReg X U x f ↔
      ∃ t : X.presheaf.stalk x, algebraMap (X.presheaf.stalk x) X.functionField t =
        α (f : FractionRing Γ(X, U)) := by
    intro x f
    constructor
    · rintro ⟨V, hxV, s, a, b, hb, hfab, hsec⟩
      refine ⟨(X.presheaf.germ V x hxV).hom s, ?_⟩
      rw [hspec]
      have hηVU : genericPoint X ∈ V ⊓ U := ⟨hmemη V x hxV, hηU⟩
      have h1 := congrArg (X.presheaf.germ (V ⊓ U) (genericPoint X) hηVU).hom hsec
      rw [map_mul, hres V (V ⊓ U) inf_le_left hηVU, hres U (V ⊓ U) inf_le_right hηVU,
        hres U (V ⊓ U) inf_le_right hηVU] at h1
      have h2 := congrArg α hfab
      rw [map_mul, hαalg, hαalg] at h2
      have hb' : (X.presheaf.germ U (genericPoint X) hηU).hom b ≠ 0 := by
        rw [← hαalg]
        intro h
        exact hb (α.injective (h.trans (map_zero α).symm))
      exact mul_right_cancel₀ hb' (h1.trans h2.symm)
    · rintro ⟨t, ht⟩
      obtain ⟨V, hxV, s, hs⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf t
      have hsη : (X.presheaf.germ V (genericPoint X) (hmemη V x hxV)).hom s =
          α (f : FractionRing Γ(X, U)) := by
        rw [← hspec V x hxV s, hs]
        exact ht
      obtain ⟨a, b, hb, hab⟩ :=
        IsFractionRing.div_surjective (A := Γ(X, U)) (f : FractionRing Γ(X, U))
      have hb0 : algebraMap Γ(X, U) (FractionRing Γ(X, U)) b ≠ 0 :=
        IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb
      have hηVU : genericPoint X ∈ V ⊓ U := ⟨hmemη V x hxV, hηU⟩
      refine ⟨V, hxV, s, a, b, hb0, ?_, ?_⟩
      · rw [← hab, div_mul_cancel₀ _ hb0]
      · apply hinjη (V ⊓ U) hηVU
        rw [map_mul, hres V (V ⊓ U) inf_le_left hηVU, hres U (V ⊓ U) inf_le_right hηVU,
          hres U (V ⊓ U) inf_le_right hηVU, hsη, ← hαalg b, ← hαalg a, ← map_mul, ← hab,
          div_mul_cancel₀ _ hb0]
  have hT : ∀ x : X, x ≠ genericPoint X → ∀ f : (FractionRing Γ(X, U))ˣ,
      0 ≤ ω x (Additive.ofMul f) ↔ ∃ t : X.presheaf.stalk x,
        algebraMap (X.presheaf.stalk x) X.functionField t = α (f : FractionRing Γ(X, U)) :=
    fun x hx f => (htrue x hx f).trans (hB x f)

  have hunit : ∀ (x : X) (r : X.presheaf.stalk x),
      algebraMap (X.presheaf.stalk x) X.functionField r ≠ 0 →
      ((∃ t : X.presheaf.stalk x, algebraMap (X.presheaf.stalk x) X.functionField t =
        (algebraMap (X.presheaf.stalk x) X.functionField r)⁻¹) ↔ IsUnit r) := by
    intro x r hr
    constructor
    · rintro ⟨t, ht⟩
      have h1 : r * t = 1 := by
        apply hφinj x
        rw [map_mul, ht, mul_inv_cancel₀ hr, map_one]
      exact ⟨⟨r, t, h1, by rw [mul_comm]; exact h1⟩, rfl⟩
    · rintro ⟨v, rfl⟩
      refine ⟨(↑v⁻¹ : X.presheaf.stalk x), ?_⟩
      apply eq_inv_of_mul_eq_one_left
      rw [← map_mul, Units.inv_mul, map_one]
  have hev : ∀ (V : X.Opens) (y : X) (hy : y ∈ V) (s : Γ(X, V)),
      (X.evaluation V y hy).hom s = 0 ↔ ¬ IsUnit ((X.presheaf.germ V y hy).hom s) := by
    intro V y hy s
    rw [← X.mem_basicOpen s y hy, ← X.evaluation_ne_zero_iff_mem_basicOpen y hy s, not_not]

  let ι : Γ(X, W) →+* FractionRing Γ(X, U) :=
    α.symm.toAlgHom.toRingHom.comp (X.presheaf.germ W (genericPoint X) hηW).hom
  have hια : ∀ s : Γ(X, W), α (ι s) = (X.presheaf.germ W (genericPoint X) hηW).hom s :=
    fun s => α.apply_symm_apply _
  have hinj : Function.Injective ι := by
    intro a b h
    apply hinjη W hηW
    rw [← hια, ← hια, h]
  have hii : ∀ c : Ω, ι ((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
      (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))) =
        wcCurveConst Ω X fX U c := by
    intro c
    apply α.injective
    rw [hια, hres ⊤ W le_top hηW]
    change _ = α (algebraMap Γ(X, U) (FractionRing Γ(X, U))
      ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom c))))
    rw [hαalg, hres ⊤ U le_top hηU]
  have hiii : ∀ (y : X) (hy : y ∈ W), IsClosed ({y} : Set X) → ∀ (s : Γ(X, W)) (hs : ι s ≠ 0),
      0 ≤ ω y (Additive.ofMul (Units.mk0 (ι s) hs)) ∧
      (1 ≤ ω y (Additive.ofMul (Units.mk0 (ι s) hs)) ↔ (X.evaluation W y hy).hom s = 0) := by
    intro y hy hyc s hs
    have hyη : y ≠ genericPoint X := fun h => hηnc (h ▸ hyc)
    have hg : α ((Units.mk0 (ι s) hs : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U)) =
        algebraMap (X.presheaf.stalk y) X.functionField ((X.presheaf.germ W y hy).hom s) := by
      rw [Units.val_mk0, hια, hspec]
    have hne : algebraMap (X.presheaf.stalk y) X.functionField
        ((X.presheaf.germ W y hy).hom s) ≠ 0 := by
      rw [← hg]
      intro h
      exact hs (α.injective (h.trans (map_zero α).symm))
    have h0 : 0 ≤ ω y (Additive.ofMul (Units.mk0 (ι s) hs)) :=
      (hT y hyη _).mpr ⟨_, hg.symm⟩
    have hinv : ω y (Additive.ofMul (Units.mk0 (ι s) hs)⁻¹) =
        - ω y (Additive.ofMul (Units.mk0 (ι s) hs)) := by
      rw [ofMul_inv, map_neg]
    have key : 0 ≤ ω y (Additive.ofMul (Units.mk0 (ι s) hs)⁻¹) ↔
        IsUnit ((X.presheaf.germ W y hy).hom s) := by
      rw [hT y hyη, Units.val_inv_eq_inv_val, map_inv₀, hg]
      exact hunit y _ hne
    refine ⟨h0, ?_⟩
    rw [hev]
    constructor
    · intro h1 hu
      have h2 := key.mpr hu
      rw [hinv] at h2
      omega
    · intro hnu
      by_contra h1
      apply hnu
      apply key.mp
      rw [hinv]
      omega
  have hiv : ∀ (y : X) (hy : y ∈ W), IsClosed ({y} : Set X) → ∃ (s : Γ(X, W)) (hs : ι s ≠ 0),
      (X.evaluation W y hy).hom s = 0 ∧ ω y (Additive.ofMul (Units.mk0 (ι s) hs)) = 1 := by
    intro y hy hyc
    have hyη : y ≠ genericPoint X := fun h => hηnc (h ▸ hyc)
    obtain ⟨μ, hμ⟩ := hω.2.2.2.1 y hyη
    obtain ⟨t, ht⟩ := (hT y hyη (Additive.toMul μ)).mp (by
      rw [ofMul_toMul, hμ]
      norm_num)
    let yW : W := ⟨y, hy⟩
    letI : Algebra Γ(X, W) (X.presheaf.stalk (yW : X)) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf yW
    haveI := hW.isLocalization_stalk yW
    obtain ⟨⟨a, d⟩, had⟩ := IsLocalization.mk'_surjective
      (hW.primeIdealOf yW).asIdeal.primeCompl (t : X.presheaf.stalk (yW : X))
    have hspec' : t * (X.presheaf.germ W y hy).hom (d : Γ(X, W)) =
        (X.presheaf.germ W y hy).hom a := by
      rw [← had]
      exact IsLocalization.mk'_spec _ a d
    have hdu : IsUnit ((X.presheaf.germ W y hy).hom (d : Γ(X, W))) :=
      IsLocalization.map_units (X.presheaf.stalk (yW : X)) d
    have hdne : algebraMap (X.presheaf.stalk y) X.functionField
        ((X.presheaf.germ W y hy).hom (d : Γ(X, W))) ≠ 0 :=
      (hdu.map (algebraMap (X.presheaf.stalk y) X.functionField)).ne_zero
    let e : FractionRing Γ(X, U) := α.symm (algebraMap (X.presheaf.stalk y) X.functionField
      ((X.presheaf.germ W y hy).hom (d : Γ(X, W))))
    have hαe : α e = algebraMap (X.presheaf.stalk y) X.functionField
        ((X.presheaf.germ W y hy).hom (d : Γ(X, W))) :=
      α.apply_symm_apply _
    have he0 : e ≠ 0 := by
      intro h
      apply hdne
      rw [← hαe, h, map_zero]
    have hιa : ι a = ((Additive.toMul μ : (FractionRing Γ(X, U))ˣ) : FractionRing Γ(X, U)) * e := by
      apply α.injective
      rw [map_mul, hαe, ← ht, ← map_mul, hspec', hια, hspec]
    have ha0 : ι a ≠ 0 := by
      rw [hιa]
      exact mul_ne_zero (Units.ne_zero _) he0
    have hunits : Units.mk0 (ι a) ha0 = Additive.toMul μ * Units.mk0 e he0 := by
      apply Units.ext
      rw [Units.val_mk0, Units.val_mul, Units.val_mk0]
      exact hιa
    have hE0 : 0 ≤ ω y (Additive.ofMul (Units.mk0 e he0)) :=
      (hT y hyη _).mpr ⟨_, hαe.symm⟩
    have hE1 : 0 ≤ ω y (Additive.ofMul (Units.mk0 e he0)⁻¹) := by
      rw [hT y hyη, Units.val_inv_eq_inv_val, map_inv₀, Units.val_mk0, hαe]
      exact (hunit y _ hdne).mpr hdu
    have hE : ω y (Additive.ofMul (Units.mk0 e he0)) = 0 := by
      rw [ofMul_inv, map_neg] at hE1
      omega
    have hω1 : ω y (Additive.ofMul (Units.mk0 (ι a) ha0)) = 1 := by
      rw [hunits, ofMul_mul, map_add, hE, add_zero, ofMul_toMul]
      exact hμ
    exact ⟨a, ha0, ((hiii y hy hyc a ha0).2).mp hω1.ge, hω1⟩
  have hvi : ∀ u : FractionRing Γ(X, U), (∀ y : X, y ∈ W → IsClosed ({y} : Set X) →
      u = 0 ∨ ∃ hu : u ≠ 0, 0 ≤ ω y (Additive.ofMul (Units.mk0 u hu))) →
      ∃ s : Γ(X, W), ι s = u := by
    intro u hu
    by_cases hu0 : u = 0
    · exact ⟨0, by rw [hu0, map_zero]⟩
    obtain ⟨s, hs⟩ := wc_integral_hartogs_sections X W (α u) (by
      rintro ⟨x, hxW⟩
      by_cases hx : x = genericPoint X
      · subst hx
        obtain ⟨V, hV, s, hs⟩ :=
          TopCat.Presheaf.exists_germ_eq X.presheaf (x := genericPoint X)
            (α u : X.presheaf.stalk (genericPoint X))
        exact ⟨(X.presheaf.germ V _ hV).hom s, (hspec V _ hV s).trans hs⟩
      · rcases hu x hxW (hcl x hx) with h0 | ⟨hu', hω'⟩
        · exact absurd h0 hu0
        · exact (hT x hx (Units.mk0 u hu')).mp hω')
    refine ⟨s, α.injective ?_⟩
    rw [hια]
    exact hs
  exact ⟨ι, hinj, hii, hiii, hiv, hvi⟩

theorem wc_slot_eval_naturality : ∀ (Ω : Type u) [Field Ω] (X T : Scheme.{u})
    (fX : X ⟶ Spec (.of Ω)) (gT : T ⟶ Spec (.of Ω)) (p : T ⟶ X), p ≫ fX = gT →
    ∀ (W : X.Opens) (O : T.Opens) (hOW : O ≤ p ⁻¹ᵁ W),
    (∀ d : Γ(Spec (.of Ω), ⊤), (p.appLE W O hOW).hom
        ((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom (fX.appTop.hom d)) =
      (T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op).hom (gT.appTop.hom d)) ∧
    (∀ (w : T) (hw : w ∈ O) (s : Γ(X, W)) (d : Γ(Spec (.of Ω), ⊤)),
      (X.evaluation W (p w) (hOW hw)).hom s = (X.evaluation ⊤ (p w) trivial).hom (fX.appTop.hom d) →
      (T.evaluation O w hw).hom ((p.appLE W O hOW).hom s) =
        (T.evaluation ⊤ w trivial).hom (gT.appTop.hom d)) :=
by
  intro Ω _ X T fX gT p hp W O hOW
  subst hp
  have hcomp : ∀ d : Γ(Spec (.of Ω), ⊤),
      (p ≫ fX).appTop.hom d = p.appTop.hom (fX.appTop.hom d) := by
    intro d
    rw [Scheme.Hom.comp_appTop]
    rfl
  have k1 : X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ p.appLE W O hOW =
      p.appTop ≫ T.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op := by
    rw [Scheme.Hom.map_appLE]
    rfl
  have hres : ∀ (Z : Scheme.{u}) (V O' : Z.Opens) (h : O' ≤ V) (w : Z) (hw : w ∈ O')
      (z : Γ(Z, V)), (Z.evaluation O' w hw).hom ((Z.presheaf.map (homOfLE h).op).hom z) =
        (Z.evaluation V w (h hw)).hom z := by
    intro Z V O' h w hw z
    simp [Scheme.evaluation]
  have hnat : ∀ (V : X.Opens) (O' : T.Opens) (e : O' ≤ p ⁻¹ᵁ V) (w : T) (hw : w ∈ O')
      (z : Γ(X, V)), (T.evaluation O' w hw).hom ((p.appLE V O' e).hom z) =
        (p.residueFieldMap w).hom ((X.evaluation V (p w) (e hw)).hom z) := by
    intro V O' e w hw z
    have h1 : (p.appLE V O' e).hom z = (T.presheaf.map (homOfLE e).op).hom ((p.app V).hom z) := rfl
    rw [h1, hres T (p ⁻¹ᵁ V) O' e w hw]
    exact (Scheme.evaluation_naturality_apply p w (e hw) z).symm
  refine ⟨fun d => ?_, fun w hw s d H => ?_⟩
  · rw [hcomp]
    exact congrArg (fun f => f.hom (fX.appTop.hom d)) k1
  · rw [hnat W O hOW w hw s, H, hcomp]
    exact Scheme.evaluation_naturality_apply p (V := ⊤) w trivial (fX.appTop.hom d)

theorem wc_newton_tensor_recursion : ∀ (Ω A R : Type u) [Field Ω] [CommRing A] [CommRing R]
    [Algebra Ω A] [Algebra Ω R] (t : A) (E : TensorProduct Ω A A),
    (∀ a : A, ∃ θ : TensorProduct Ω A A,
      E * (TensorProduct.tmul Ω a (1 : A) - TensorProduct.tmul Ω (1 : A) a) =
        (TensorProduct.tmul Ω t (1 : A) - TensorProduct.tmul Ω (1 : A) t) * θ) →
    ∀ (m : ℕ) (φ : Fin m → (A →ₐ[Ω] R)) (h : A), ∃ c : Fin m → R, ∀ e : R →ₐ[Ω] Ω,
      ∃ ρ : Fin (m + 1) → A, ρ 0 = h ∧ ∀ r : Fin m,
        e (c r) = (e.comp (φ r)) (ρ r.castSucc) ∧
        (Algebra.TensorProduct.rid Ω Ω A
            (Algebra.TensorProduct.map (AlgHom.id Ω A) (e.comp (φ r)) E)) *
          (ρ r.castSucc - algebraMap Ω A ((e.comp (φ r)) (ρ r.castSucc))) =
        (t - algebraMap Ω A ((e.comp (φ r)) t)) * ρ r.succ :=
by
  intro Ω A R _ _ _ _ _ t E hE m φ h
  classical

  have s1 : ∀ (ψ : A →ₐ[Ω] R) (z : TensorProduct Ω A R), ∃ y : TensorProduct Ω A R,
      Algebra.TensorProduct.map (AlgHom.id Ω A) ψ E *
        (z - TensorProduct.tmul Ω (1 : A)
          (Algebra.TensorProduct.productMap ψ (AlgHom.id Ω R) z)) =
      (TensorProduct.tmul Ω t (1 : R) - TensorProduct.tmul Ω (1 : A) (ψ t)) * y := by
    intro ψ z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp⟩
    | tmul a s =>
      obtain ⟨θ, hθ⟩ := hE a
      have h1 := congrArg (Algebra.TensorProduct.map (AlgHom.id Ω A) ψ) hθ
      simp only [map_mul, map_sub, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        map_one] at h1
      refine ⟨Algebra.TensorProduct.map (AlgHom.id Ω A) ψ θ * TensorProduct.tmul Ω (1 : A) s, ?_⟩
      have h2 : TensorProduct.tmul Ω a s - TensorProduct.tmul Ω (1 : A)
          (Algebra.TensorProduct.productMap ψ (AlgHom.id Ω R) (TensorProduct.tmul Ω a s)) =
          (TensorProduct.tmul Ω a (1 : R) - TensorProduct.tmul Ω (1 : A) (ψ a)) *
            TensorProduct.tmul Ω (1 : A) s := by
        rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, sub_mul,
          Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul, mul_one,
          one_mul, one_mul]
      rw [h2, ← mul_assoc, h1, mul_assoc]
    | add x y hx hy =>
      obtain ⟨y1, h1⟩ := hx
      obtain ⟨y2, h2⟩ := hy
      refine ⟨y1 + y2, ?_⟩
      rw [map_add, TensorProduct.tmul_add, add_sub_add_comm, mul_add, h1, h2, mul_add]
  choose S hS using s1

  obtain ⟨g, hg0, hgs⟩ : ∃ g : ℕ → TensorProduct Ω A R,
      g 0 = TensorProduct.tmul Ω h (1 : R) ∧
        ∀ r : Fin m, g (r.val + 1) = S (φ r) (g r.val) :=
    ⟨fun n => Nat.rec (TensorProduct.tmul Ω h (1 : R))
      (fun k gk => if hk : k < m then S (φ ⟨k, hk⟩) gk else 0) n, rfl,
      fun r => dif_pos r.isLt⟩
  refine ⟨fun r => Algebra.TensorProduct.productMap (φ r) (AlgHom.id Ω R) (g r.val),
    fun e => ?_⟩

  have hε3 : ∀ (a : A) (s : R), Algebra.TensorProduct.rid Ω Ω A
      (Algebra.TensorProduct.map (AlgHom.id Ω A) e (TensorProduct.tmul Ω a s)) = e s • a := by
    intro a s
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Algebra.TensorProduct.rid_tmul]
  have hε1 : ∀ (ψ : A →ₐ[Ω] R) (z : TensorProduct Ω A R),
      e (Algebra.TensorProduct.productMap ψ (AlgHom.id Ω R) z) =
        (e.comp ψ) (Algebra.TensorProduct.rid Ω Ω A
          (Algebra.TensorProduct.map (AlgHom.id Ω A) e z)) := by
    intro ψ z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul a s =>
      rw [hε3, Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, map_mul,
        map_smul, AlgHom.comp_apply, smul_eq_mul, mul_comm]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add, map_add]
  have hε2 : ∀ (ψ : A →ₐ[Ω] R) (W : TensorProduct Ω A A),
      Algebra.TensorProduct.rid Ω Ω A (Algebra.TensorProduct.map (AlgHom.id Ω A) e
        (Algebra.TensorProduct.map (AlgHom.id Ω A) ψ W)) =
      Algebra.TensorProduct.rid Ω Ω A (Algebra.TensorProduct.map (AlgHom.id Ω A) (e.comp ψ) W) := by
    intro ψ W
    induction W using TensorProduct.induction_on with
    | zero => simp
    | tmul a b =>
      simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgHom.comp_apply]
    | add x y hx hy => simp only [map_add, hx, hy]
  refine ⟨fun i => Algebra.TensorProduct.rid Ω Ω A
    (Algebra.TensorProduct.map (AlgHom.id Ω A) e (g i.val)), ?_, fun r => ⟨?_, ?_⟩⟩
  · show Algebra.TensorProduct.rid Ω Ω A
      (Algebra.TensorProduct.map (AlgHom.id Ω A) e (g 0)) = h
    rw [hg0, hε3, map_one, one_smul]
  · show e (Algebra.TensorProduct.productMap (φ r) (AlgHom.id Ω R) (g r.val)) =
      (e.comp (φ r)) (Algebra.TensorProduct.rid Ω Ω A
        (Algebra.TensorProduct.map (AlgHom.id Ω A) e (g r.castSucc.val)))
    rw [Fin.val_castSucc]
    exact hε1 _ _
  · show Algebra.TensorProduct.rid Ω Ω A
            (Algebra.TensorProduct.map (AlgHom.id Ω A) (e.comp (φ r)) E) *
          (Algebra.TensorProduct.rid Ω Ω A
              (Algebra.TensorProduct.map (AlgHom.id Ω A) e (g r.castSucc.val)) -
            algebraMap Ω A ((e.comp (φ r)) (Algebra.TensorProduct.rid Ω Ω A
              (Algebra.TensorProduct.map (AlgHom.id Ω A) e (g r.castSucc.val))))) =
        (t - algebraMap Ω A ((e.comp (φ r)) t)) * Algebra.TensorProduct.rid Ω Ω A
              (Algebra.TensorProduct.map (AlgHom.id Ω A) e (g r.succ.val))
    rw [Fin.val_castSucc, Fin.val_succ, ← hε1, hgs r]
    have key := congrArg (fun x => Algebra.TensorProduct.rid Ω Ω A
      (Algebra.TensorProduct.map (AlgHom.id Ω A) e x)) (hS (φ r) (g r.val))
    simp only [map_mul, map_sub, hε2, hε3, map_one, one_smul] at key
    rw [AlgHom.comp_apply, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one]
    exact key

theorem wc_chart_coordinate_orders : ∀ (Ω A K P : Type u) [Field Ω] [CommRing A] [Algebra Ω A]
    [Field K] (ι : A →+* K), Function.Injective ι →
    ∀ (ev : P → (A →ₐ[Ω] Ω)) (ω : P → Additive Kˣ →+ ℤ),
    (∀ (y : P) (a : A) (ha : ι a ≠ 0), 0 ≤ ω y (Additive.ofMul (Units.mk0 (ι a) ha))) →
    (∀ (y : P) (a : A) (ha : ι a ≠ 0),
      (1 ≤ ω y (Additive.ofMul (Units.mk0 (ι a) ha)) ↔ ev y a = 0)) →
    (∀ y : P, ∃ (a : A) (ha : ι a ≠ 0), ev y a = 0 ∧
      ω y (Additive.ofMul (Units.mk0 (ι a) ha)) = 1) →
    (∀ y y' : P, y ≠ y' → ∃ a : A, ev y a = 0 ∧ ev y' a ≠ 0) →
    ∀ (t : A) (E : TensorProduct Ω A A),
    (∀ a : A, ∃ θ : TensorProduct Ω A A,
      E * (TensorProduct.tmul Ω a (1 : A) - TensorProduct.tmul Ω (1 : A) a) =
        (TensorProduct.tmul Ω t (1 : A) - TensorProduct.tmul Ω (1 : A) t) * θ) →
    (∀ y : P, Algebra.TensorProduct.lmul' Ω (Algebra.TensorProduct.map (ev y) (ev y) E) ≠ 0 →
      ∃ hne : ι (t - algebraMap Ω A (ev y t)) ≠ 0,
        ω y (Additive.ofMul (Units.mk0 _ hne)) = 1) ∧
    (∀ y y' : P, y ≠ y' →
      Algebra.TensorProduct.lmul' Ω (Algebra.TensorProduct.map (ev y) (ev y') E) ≠ 0 →
      ev y t ≠ ev y' t) :=
by
  intro Ω A K P _ _ _ _ ι hι ev ω H1 H2 H3 H4 t E hDiv
  have hPE : ∀ (φ₁ φ₂ : A →ₐ[Ω] Ω) (Z : TensorProduct Ω A A),
      φ₁ (Algebra.TensorProduct.rid Ω Ω A (Algebra.TensorProduct.map (AlgHom.id Ω A) φ₂ Z)) =
        Algebra.TensorProduct.lmul' Ω (Algebra.TensorProduct.map φ₁ φ₂ Z) := by
    intro φ₁ φ₂ Z
    induction Z using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul a b =>
      simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Algebra.TensorProduct.rid_tmul,
        map_smul, smul_eq_mul, Algebra.TensorProduct.lmul'_apply_tmul]
      ring
    | add x z hx hz => simp only [map_add, hx, hz]
  refine ⟨?_, ?_⟩
  · intro y hχ
    obtain ⟨π, hπ, hevπ, hωπ⟩ := H3 y
    obtain ⟨θ, hθ⟩ := hDiv π
    have hψ1 : ∀ a : A, Algebra.TensorProduct.rid Ω Ω A (Algebra.TensorProduct.map (AlgHom.id Ω A)
        (ev y) (TensorProduct.tmul Ω a (1 : A))) = a := by
      intro a
      rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one, Algebra.TensorProduct.rid_tmul,
        one_smul]
    have hψ2 : ∀ a : A, Algebra.TensorProduct.rid Ω Ω A (Algebra.TensorProduct.map (AlgHom.id Ω A)
        (ev y) (TensorProduct.tmul Ω (1 : A) a)) = algebraMap Ω A (ev y a) := by
      intro a
      rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Algebra.TensorProduct.rid_tmul,
        Algebra.algebraMap_eq_smul_one]
    have h1 := congrArg (fun z => Algebra.TensorProduct.rid Ω Ω A
      (Algebra.TensorProduct.map (AlgHom.id Ω A) (ev y) z)) hθ
    simp only [map_mul, map_sub] at h1
    rw [hψ1, hψ1, hψ2, hψ2, hevπ, map_zero, sub_zero] at h1
    have hev_e : ev y (Algebra.TensorProduct.rid Ω Ω A
        (Algebra.TensorProduct.map (AlgHom.id Ω A) (ev y) E)) ≠ 0 := by
      rw [hPE]; exact hχ
    generalize Algebra.TensorProduct.rid Ω Ω A
        (Algebra.TensorProduct.map (AlgHom.id Ω A) (ev y) E) = e at h1 hev_e
    generalize Algebra.TensorProduct.rid Ω Ω A
        (Algebra.TensorProduct.map (AlgHom.id Ω A) (ev y) θ) = θ' at h1
    have hιe : ι e ≠ 0 := by
      intro h
      apply hev_e
      have : e = 0 := hι (by rw [h, map_zero])
      rw [this, map_zero]
    have hωe : ω y (Additive.ofMul (Units.mk0 (ι e) hιe)) = 0 := by
      have a1 := H1 y e hιe
      have a2 : ¬ (1 ≤ ω y (Additive.ofMul (Units.mk0 (ι e) hιe))) :=
        fun h => hev_e ((H2 y e hιe).mp h)
      omega
    have h2 : ι e * ι π = ι (t - algebraMap Ω A (ev y t)) * ι θ' := by
      rw [← map_mul, ← map_mul, h1]
    have hprod : ι e * ι π ≠ 0 := mul_ne_zero hιe hπ
    rw [h2] at hprod
    obtain ⟨hne, hθ'⟩ := mul_ne_zero_iff.mp hprod
    refine ⟨hne, ?_⟩
    have hU : Units.mk0 (ι e) hιe * Units.mk0 (ι π) hπ =
        Units.mk0 (ι (t - algebraMap Ω A (ev y t))) hne * Units.mk0 (ι θ') hθ' := by
      apply Units.ext
      rw [Units.val_mul, Units.val_mul, Units.val_mk0, Units.val_mk0, Units.val_mk0, Units.val_mk0,
        h2]
    have hω := congrArg (fun u => ω y (Additive.ofMul u)) hU
    simp only [ofMul_mul, map_add] at hω
    have hθnn := H1 y θ' hθ'
    have hc1 : 1 ≤ ω y (Additive.ofMul (Units.mk0 (ι (t - algebraMap Ω A (ev y t))) hne)) := by
      apply (H2 y _ hne).mpr
      rw [map_sub, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
    omega
  · intro y y' hyy' hχ heq
    obtain ⟨a, ha, ha'⟩ := H4 y y' hyy'
    obtain ⟨θ, hθ⟩ := hDiv a
    have h1 := congrArg (fun z => Algebra.TensorProduct.lmul' Ω
      (Algebra.TensorProduct.map (ev y) (ev y') z)) hθ
    simp only [map_mul, map_sub, Algebra.TensorProduct.map_tmul,
      Algebra.TensorProduct.lmul'_apply_tmul, map_one, mul_one, one_mul, ha, heq, sub_self,
      zero_mul, zero_sub] at h1
    rcases mul_eq_zero.mp h1 with h | h
    · exact hχ h
    · exact ha' (neg_eq_zero.mp h)

theorem wc_newton_valued_criterion : ∀ (Ω A K P : Type u) [Field Ω] [CommRing A] [Algebra Ω A]
    [Field K] [DecidableEq P] (ι : A →+* K), Function.Injective ι →
    ∀ (ev : P → (A →ₐ[Ω] Ω)) (ω : P → Additive Kˣ →+ ℤ),
    (∀ (y : P) (a : A) (ha : ι a ≠ 0), 0 ≤ ω y (Additive.ofMul (Units.mk0 (ι a) ha))) →
    (∀ (y : P) (a : A) (ha : ι a ≠ 0),
      (1 ≤ ω y (Additive.ofMul (Units.mk0 (ι a) ha)) ↔ ev y a = 0)) →
    ∀ (t : A) (m : ℕ) (y : Fin m → P) (ubar : Fin m → A) (h : A) (ρ : Fin (m + 1) → A),
    (∀ r s : Fin m, ev (y s) (ubar r) ≠ 0) →
    (∀ r : Fin m, ∃ hne : ι (t - algebraMap Ω A (ev (y r) t)) ≠ 0,
      ω (y r) (Additive.ofMul (Units.mk0 _ hne)) = 1) →
    (∀ r s : Fin m, y s ≠ y r → ev (y s) t ≠ ev (y r) t) →
    ρ 0 = h →
    (∀ r : Fin m, ubar r * (ρ r.castSucc - algebraMap Ω A (ev (y r) (ρ r.castSucc))) =
      (t - algebraMap Ω A (ev (y r) t)) * ρ r.succ) →
    ((∀ r : Fin m, ev (y r) (ρ r.castSucc) = 0) ↔
      (h = 0 ∨ ∃ hh : ι h ≠ 0, ∀ r : Fin m,
        ((Finset.univ.filter (fun s => y s = y r)).card : ℤ) ≤
          ω (y r) (Additive.ofMul (Units.mk0 (ι h) hh)))) :=
by
  intro Ω A K P _ _ _ _ _ ι hι ev ω V1 V2 t

  have hι0 : ∀ a : A, ι a = 0 ↔ a = 0 := fun a => by
    constructor
    · intro h0; exact hι (by rw [h0, map_zero])
    · intro h0; rw [h0, map_zero]
  have dom : ∀ a b : A, a * b = 0 → a = 0 ∨ b = 0 := by
    intro a b hab
    have : ι a * ι b = 0 := by rw [← map_mul, hab, map_zero]
    rcases mul_eq_zero.mp this with h0 | h0
    · exact Or.inl ((hι0 a).mp h0)
    · exact Or.inr ((hι0 b).mp h0)

  have s1 : ∀ (u h ρ₁ : A) (y₀ z : P), ev z u ≠ 0 →
      (∃ hne : ι (t - algebraMap Ω A (ev y₀ t)) ≠ 0,
        ω y₀ (Additive.ofMul (Units.mk0 _ hne)) = 1) →
      (z ≠ y₀ → ev z t ≠ ev y₀ t) → u * h = (t - algebraMap Ω A (ev y₀ t)) * ρ₁ →
      ∀ (hh : ι h ≠ 0) (hρ : ι ρ₁ ≠ 0), ω z (Additive.ofMul (Units.mk0 (ι h) hh)) =
        (if z = y₀ then 1 else 0) + ω z (Additive.ofMul (Units.mk0 (ι ρ₁) hρ)) := by
    intro u h ρ₁ y₀ z hu hT2 h3 heq hh hρ
    obtain ⟨hne, hT⟩ := hT2
    have hu' : ι u ≠ 0 := fun h0 => hu (by rw [(hι0 u).mp h0, map_zero])
    have ou : ω z (Additive.ofMul (Units.mk0 (ι u) hu')) = 0 := by
      have a := V1 z u hu'
      have b : ¬ (1 ≤ ω z (Additive.ofMul (Units.mk0 (ι u) hu'))) :=
        fun h1 => hu ((V2 z u hu').mp h1)
      omega
    have oT : ω z (Additive.ofMul (Units.mk0 _ hne)) = if z = y₀ then 1 else 0 := by
      split_ifs with hz
      · subst hz; exact hT
      · have hev : ev z (t - algebraMap Ω A (ev y₀ t)) ≠ 0 := by
          rw [map_sub, AlgHom.commutes]
          change ev z t - ev y₀ t ≠ 0
          exact sub_ne_zero.mpr (h3 hz)
        have a := V1 z _ hne
        have b : ¬ (1 ≤ ω z (Additive.ofMul (Units.mk0 _ hne))) :=
          fun h1 => hev ((V2 z _ hne).mp h1)
        omega
    have hunits : Units.mk0 (ι u) hu' * Units.mk0 (ι h) hh =
        Units.mk0 _ hne * Units.mk0 (ι ρ₁) hρ := by
      ext
      show ι u * ι h = ι (t - algebraMap Ω A (ev y₀ t)) * ι ρ₁
      rw [← map_mul, ← map_mul, heq]
    have hω := congrArg (fun x => ω z (Additive.ofMul x)) hunits
    simp only [ofMul_mul, map_add] at hω
    rw [ou, oT] at hω
    linarith

  have s2 : ∀ (m : ℕ) (y : Fin (m + 1) → P) (o o' : P → ℤ),
      (∀ r : Fin (m + 1), o (y r) = (if y r = y 0 then 1 else 0) + o' (y r)) →
      (∀ z : P, 0 ≤ o' z) →
      ((∀ r : Fin (m + 1), ((Finset.univ.filter (fun s => y s = y r)).card : ℤ) ≤ o (y r)) ↔
        ∀ r : Fin m, ((Finset.univ.filter (fun s : Fin m => y s.succ = y r.succ)).card : ℤ) ≤
          o' (y r.succ)) := by
    intro m y o o' ho ho'
    have split : ∀ z : P, ((Finset.univ.filter (fun s => y s = z)).card : ℤ) =
        (if z = y 0 then 1 else 0) +
          ((Finset.univ.filter (fun s : Fin m => y s.succ = z)).card : ℤ) := by
      intro z
      rw [Fin.card_filter_univ_succ']
      by_cases hz : y 0 = z
      · rw [if_pos hz, if_pos hz.symm]; push_cast; ring
      · rw [if_neg hz, if_neg (fun h0 => hz h0.symm)]; push_cast; ring
    constructor
    · intro H r
      have h1 := H r.succ
      rw [split, ho] at h1
      linarith
    · intro H r
      rw [split, ho]
      suffices hs : ((Finset.univ.filter (fun s : Fin m => y s.succ = y r)).card : ℤ) ≤ o' (y r) by
        linarith
      by_cases he : (Finset.univ.filter (fun s : Fin m => y s.succ = y r)) = ∅
      · rw [he, Finset.card_empty, Nat.cast_zero]; exact ho' _
      · obtain ⟨s, hs⟩ := Finset.nonempty_iff_ne_empty.mpr he
        have hs' : y s.succ = y r := (Finset.mem_filter.mp hs).2
        rw [← hs']
        exact H s

  intro m
  induction m with
  | zero =>
    intro y ubar h ρ _ _ _ _ _
    constructor
    · intro _
      by_cases h0 : h = 0
      · exact Or.inl h0
      · exact Or.inr ⟨fun h1 => h0 ((hι0 h).mp h1), fun r => r.elim0⟩
    · intro _ r; exact r.elim0
  | succ m IH =>
    intro y ubar h ρ H1 H2 H3 R0 Rec
    have IH' := IH (fun r => y r.succ) (fun r => ubar r.succ) (ρ (Fin.succ 0))
      (fun r => ρ r.succ)
      (fun r s => H1 r.succ s.succ) (fun r => H2 r.succ) (fun r s hne => H3 r.succ s.succ hne)
      rfl
      (fun r => by
        have := Rec r.succ
        rw [← Fin.succ_castSucc] at this
        exact this)
    beta_reduce at IH'
    have Rec0 := Rec 0
    rw [Fin.castSucc_zero, R0] at Rec0
    have hL : (∀ r : Fin (m + 1), ev (y r) (ρ r.castSucc) = 0) ↔
        (ev (y 0) h = 0 ∧ ∀ r : Fin m, ev (y r.succ) (ρ r.castSucc.succ) = 0) := by
      rw [Fin.forall_fin_succ]
      simp only [Fin.succ_castSucc, Fin.castSucc_zero, R0]
    have hu0 : ubar 0 ≠ 0 := fun h0 => H1 0 0 (by rw [h0, map_zero])
    obtain ⟨hT0, _⟩ := H2 0
    have hT0' : t - algebraMap Ω A (ev (y 0) t) ≠ 0 := fun h0 => hT0 (by rw [h0, map_zero])
    have mkstar : ev (y 0) h = 0 →
        ubar 0 * h = (t - algebraMap Ω A (ev (y 0) t)) * ρ (Fin.succ 0) := by
      intro he
      have := Rec0
      rwa [he, map_zero, sub_zero] at this
    have key : ∀ (he : ev (y 0) h = 0) (hh : ι h ≠ 0) (hρ : ι (ρ (Fin.succ 0)) ≠ 0)
        (r : Fin (m + 1)),
        ω (y r) (Additive.ofMul (Units.mk0 (ι h) hh)) = (if y r = y 0 then 1 else 0) +
          ω (y r) (Additive.ofMul (Units.mk0 (ι (ρ (Fin.succ 0))) hρ)) := by
      intro he hh hρ r
      exact s1 (ubar 0) h (ρ (Fin.succ 0)) (y 0) (y r) (H1 0 r) (H2 0) (fun hne => H3 0 r hne)
        (mkstar he) hh hρ
    rw [hL]
    constructor
    · rintro ⟨he, htail⟩
      have star := mkstar he
      rcases IH'.mp htail with hρ0 | ⟨hρ, B'⟩
      · left
        rw [hρ0, mul_zero] at star
        exact (dom _ _ star).resolve_left hu0
      · right
        have hh0 : h ≠ 0 := by
          intro h0
          rw [h0, mul_zero] at star
          rcases dom _ _ star.symm with h1 | h1
          · exact hT0' h1
          · exact hρ (by rw [h1, map_zero])
        have hh : ι h ≠ 0 := fun h1 => hh0 ((hι0 h).mp h1)
        refine ⟨hh, ?_⟩
        exact (s2 m y (fun z => ω z (Additive.ofMul (Units.mk0 (ι h) hh)))
          (fun z => ω z (Additive.ofMul (Units.mk0 (ι (ρ (Fin.succ 0))) hρ)))
          (key he hh hρ) (fun z => V1 z _ hρ)).mpr B'
    · rintro (h0 | ⟨hh, B⟩)
      · have he : ev (y 0) h = 0 := by rw [h0, map_zero]
        refine ⟨he, IH'.mpr (Or.inl ?_)⟩
        have star := mkstar he
        rw [h0, mul_zero] at star
        exact (dom _ _ star.symm).resolve_left hT0'
      · have hc : (1 : ℤ) ≤ ((Finset.univ.filter (fun s => y s = y 0)).card : ℤ) := by
          have : 0 < (Finset.univ.filter (fun s => y s = y 0)).card :=
            Finset.card_pos.mpr ⟨0, Finset.mem_filter.mpr ⟨Finset.mem_univ _, rfl⟩⟩
          omega
        have he : ev (y 0) h = 0 := (V2 (y 0) h hh).mp (le_trans hc (B 0))
        have star := mkstar he
        have hh0 : h ≠ 0 := fun h0 => hh (by rw [h0, map_zero])
        have hρ : ι (ρ (Fin.succ 0)) ≠ 0 := by
          intro h1
          rw [(hι0 _).mp h1, mul_zero] at star
          rcases dom _ _ star with h2 | h2
          · exact hu0 h2
          · exact hh0 h2
        refine ⟨he, IH'.mpr (Or.inr ⟨hρ, ?_⟩)⟩
        exact (s2 m y (fun z => ω z (Additive.ofMul (Units.mk0 (ι h) hh)))
          (fun z => ω z (Additive.ofMul (Units.mk0 (ι (ρ (Fin.succ 0))) hρ)))
          (key he hh hρ) (fun z => V1 z _ hρ)).mp B

theorem wc_cluster_divisor_reduction : ∀ (K X : Type u) [Field K] [DecidableEq X]
    (ω : X → Additive Kˣ →+ ℤ) (M : X →₀ ℤ) (J : Type) [Fintype J] (P : J → X) (σ : Kˣ)
    (g u : K), (∀ j, ω (P j) (Additive.ofMul σ) = M (P j)) → u = (σ : K) * g →
    (g = 0 ∨ ∃ hg : g ≠ 0, ∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 g hg)) + M x) →
    ((g = 0 ∨ ∃ hg : g ≠ 0, ∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 g hg)) +
        (M - ∑ j, Finsupp.single (P j) (1 : ℤ)) x) ↔
      (u = 0 ∨ ∃ hu : u ≠ 0, ∀ j, ((Finset.univ.filter (fun j' => P j' = P j)).card : ℤ) ≤
        ω (P j) (Additive.ofMul (Units.mk0 u hu)))) :=
by
  intro K X _ _ ω M J _ P σ g u hσ hu hL
  have hN : ∀ x, (M - ∑ j, Finsupp.single (P j) (1 : ℤ)) x =
      M x - ((Finset.univ.filter (fun j' => P j' = x)).card : ℤ) := by
    intro x
    rw [Finsupp.sub_apply, Finsupp.finset_sum_apply]
    simp [Finsupp.single_apply, Finset.sum_boole]
  rcases eq_or_ne g 0 with hg0 | hg
  · have hu0 : u = 0 := by rw [hu, hg0, mul_zero]
    exact ⟨fun _ => Or.inl hu0, fun _ => Or.inl hg0⟩
  · have hL' : ∀ x, 0 ≤ ω x (Additive.ofMul (Units.mk0 g hg)) + M x := by
      rcases hL with h | ⟨_, h⟩
      · exact absurd h hg
      · exact h
    have hu0 : u ≠ 0 := by rw [hu]; exact mul_ne_zero σ.ne_zero hg
    have hunit : Units.mk0 u hu0 = σ * Units.mk0 g hg := Units.ext (by simp [hu])
    have hord : ∀ x, ω x (Additive.ofMul (Units.mk0 u hu0)) =
        ω x (Additive.ofMul σ) + ω x (Additive.ofMul (Units.mk0 g hg)) := by
      intro x
      rw [hunit, ofMul_mul, map_add]
    constructor
    · rintro (h | ⟨_, h⟩)
      · exact absurd h hg
      · refine Or.inr ⟨hu0, fun j => ?_⟩
        have h1 := h (P j)
        rw [hN] at h1
        rw [hord, hσ]
        linarith
    · rintro (h | ⟨_, h⟩)
      · exact absurd h hu0
      · refine Or.inr ⟨hg, fun x => ?_⟩
        rw [hN]
        by_cases hx : ∃ j, P j = x
        · obtain ⟨j, rfl⟩ := hx
          have h1 := h j
          rw [hord, hσ] at h1
          linarith
        · have h2 : Finset.univ.filter (fun j' => P j' = x) = ∅ := by
            rw [Finset.filter_eq_empty_iff]
            intro j _ hj
            exact hx ⟨j, hj⟩
          rw [h2, Finset.card_empty, Nat.cast_zero, sub_zero]
          exact hL' x

theorem wc_newton_cluster_chart : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) [IsProper fX] [IrreducibleSpace X],
    (∀ x : X, IsDomain (X.presheaf.stalk x) ∧ IsIntegrallyClosed (X.presheaf.stalk x)) →
    topologicalKrullDim X = ((1 : ℕ) : WithBot ℕ∞) →
    (∀ x : X, IsClosed ({x} : Set X) → ∀ V : X.Opens, x ∈ V → wcEtaleChartAt Ω X fX x V) →
    ∀ (U : X.Opens) [IsDedekindDomain Γ(X, U)] (hU : IsAffineOpen U), ((U : Set X)ᶜ).Finite →
    ∀ ω : X → Additive (FractionRing Γ(X, U))ˣ →+ ℤ, wcCurveOrdData Ω X fX U hU ω →
    wcTrueOrd X U ω →
    ∀ (M : X →₀ ℤ), M (genericPoint X) = 0 →
    ∀ (n : ℕ) (f : Fin n → FractionRing Γ(X, U)), (∀ s, f s ∈ wcRRSpace Ω X fX U ω M) →
    ∀ (T : Scheme.{u}) (gT : T ⟶ Spec (.of Ω)) [LocallyOfFiniteType gT]
      (ι : Type) [Fintype ι] (p : ι → (T ⟶ X)), (∀ j, p j ≫ fX = gT) →
    ∀ w₀ : T, IsClosed ({w₀} : Set T) → (∀ j j', p j w₀ = p j' w₀) →
    ∃ (O : T.Opens) (_ : w₀ ∈ O) (k : ℕ) (Φ : Fin k → Fin n → Γ(T, O)),
      ∀ (w : T) (hw : w ∈ O), IsClosed ({w} : Set T) → ∀ v : Fin n → Ω,
        ((∑ s, wcCurveConst Ω X fX U (v s) * f s) ∈
            wcRRSpace Ω X fX U ω (M - ∑ j, Finsupp.single (p j w) (1 : ℤ)) ↔
          ∀ r, ∑ s, (T.evaluation O w hw).hom (Φ r s) *
            (T.evaluation ⊤ w trivial).hom
              (gT.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom (v s))) = 0) :=
by
  intro Ω _ _ X fX _ _ hnorm hdim hChart U _ hU hfin ω hω htrue M hM n f hfM T gT _ ι _ p hp
    w₀ hw₀ hw₀eq
  classical
  have c2' := wc_rr_space_mem_iff Ω X fX U hU ω hω
  have hgmem : ∀ v : Fin n → Ω, (∑ s, wcCurveConst Ω X fX U (v s) * f s) ∈
      wcRRSpace Ω X fX U ω M := by
    intro v
    apply Submodule.sum_mem
    intro s _
    exact Submodule.smul_mem _ (v s) (hfM s)

