      · obtain ⟨b, w, hb⟩ := H1 z ((e1 z).mpr hz)
        exact ⟨b, w, hb.trans (r1 c' b w)⟩



  have H6 : ∀ x, cm1 _ _ S.g (cm1 _ _ S.f x) = 0 := fun x => funext fun p => hzero _ (x p)
  have H7 : Function.Injective (cm0 _ _ S.f) := fun x y hxy =>
    funext fun i => hinj _ (congrFun hxy i)
  have H8 : Function.Injective (cm1 _ _ S.f) := fun x y hxy =>
    funext fun p => hinj _ (congrFun hxy p)
  have H9 : Function.Injective (cm2 _ _ S.f) := fun x y hxy =>
    funext fun q => hinj _ (congrFun hxy q)
  have H10 : ∀ y, cm0 _ _ S.g y = 0 → ∃ x, cm0 _ _ S.f x = y := by
    intro y hy
    choose x hx using fun i => hex _ (y i) (congrFun hy i)
    exact ⟨x, funext hx⟩
  have H11 : ∀ y, cm1 _ _ S.g y = 0 → ∃ x, cm1 _ _ S.f x = y := by
    intro y hy
    choose x hx using fun p => hex _ (y p) (congrFun hy p)
    exact ⟨x, funext hx⟩
  have H12 : Function.Surjective (cm0 _ _ S.g) := by
    intro y
    choose x hx using fun i => hsurj i (y i)
    exact ⟨x, funext hx⟩
  refine ⟨fun hA hD => (hiff S.X₂).mpr ?_, fun hC hD => (hiff S.X₁).mpr ?_⟩
  · exact dirA _ _ _ _ _ _ _ _ _ (d0 S.X₁) (d1 S.X₁) (d0 S.X₂) (d1 S.X₂) (d0 S.X₃) (d1 S.X₃)
      (cm0 _ _ S.f) (cm1 _ _ S.f) (cm2 _ _ S.f) (cm0 _ _ S.g) (cm1 _ _ S.g) (cm2 _ _ S.g)
      (hc0 _ _ S.f) (hc1 _ _ S.f) (hc0 _ _ S.g) (hc1 _ _ S.g) (hd10 S.X₂) H6 H7 H8 H9 H10 H11 H12
      ((hiff S.X₁).mp hA) ((hiff S.X₃).mp hD)
  · exact dirB _ _ _ _ _ _ _ _ _ (d0 S.X₁) (d1 S.X₁) (d0 S.X₂) (d1 S.X₂) (d0 S.X₃) (d1 S.X₃)
      (cm0 _ _ S.f) (cm1 _ _ S.f) (cm2 _ _ S.f) (cm0 _ _ S.g) (cm1 _ _ S.g) (cm2 _ _ S.g)
      (hc0 _ _ S.f) (hc1 _ _ S.f) (hc0 _ _ S.g) (hc1 _ _ S.g) (hd10 S.X₂) H6 H7 H8 H9 H10 H11 H12
      ((hiff S.X₂).mp hC) ((hiff S.X₃).mp hD)

theorem wc_dev_closeds_generic_point : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsNoetherian X] (Z : Set X), IsClosed Z → Z.Nonempty → ∃ ξ ∈ Z, ∀ y ∈ Z, ξ ∈ closure ({y} : Set X) → y = ξ :=
by
  classical
  intro X _ Z hZ hne
  obtain ⟨S, hSirr, hZS⟩ := TopologicalSpace.NoetherianSpace.exists_finset_irreducible
    (⟨Z, hZ⟩ : TopologicalSpace.Closeds X)
  have hZeq : Z = ⋃ k ∈ S, (k : Set X) := by
    have h := congrArg (fun c : TopologicalSpace.Closeds X => (c : Set X)) hZS
    simpa [TopologicalSpace.Closeds.coe_finset_sup, Finset.sup_set_eq_biUnion] using h
  have hmem : ∀ y ∈ Z, ∃ k' ∈ S, y ∈ (k' : Set X) := by
    intro y hy
    rw [hZeq] at hy
    simpa using hy
  have hSne : S.Nonempty := by
    obtain ⟨y, hy⟩ := hne
    obtain ⟨k', hk', _⟩ := hmem y hy
    exact ⟨k', hk'⟩
  obtain ⟨k, hk⟩ := Finset.exists_maximal hSne
  have hkS : k ∈ S := hk.prop
  have hkirr : IsIrreducible (k : Set X) := hSirr ⟨k, hkS⟩
  have hξ := hkirr.isGenericPoint_genericPoint k.isClosed
  have hkZ : (k : Set X) ⊆ Z := by
    intro x hx
    rw [hZeq]
    exact Set.mem_iUnion₂.mpr ⟨k, hkS, hx⟩
  refine ⟨hkirr.genericPoint, hkZ hξ.mem, ?_⟩
  intro y hy hξy
  obtain ⟨k', hk'S, hyk'⟩ := hmem y hy
  have h1 : closure ({y} : Set X) ⊆ k' :=
    closure_minimal (Set.singleton_subset_iff.mpr hyk') k'.isClosed
  have h2 : (k : Set X) ⊆ k' := by
    rw [← hξ.def]
    exact closure_minimal (Set.singleton_subset_iff.mpr (h1 hξy)) k'.isClosed
  have hkk' : k = k' := hk.eq_of_le hk'S (show k ≤ k' from h2)
  have hyk : y ∈ (k : Set X) := by rw [hkk']; exact hyk'
  have hs1 : hkirr.genericPoint ⤳ y := by
    rw [specializes_iff_mem_closure, hξ.def]; exact hyk
  have hs2 : y ⤳ hkirr.genericPoint := specializes_iff_mem_closure.mpr hξy
  exact (hs2.antisymm hs1).eq

theorem wc_dev_prime_vanish : ∀ (X : Scheme.{u}) (U : X.Opens) (hU : IsAffineOpen U) (ξ : X) (hξ : ξ ∈ U) (a : Γ(X, U)), (∀ x ∈ U, x ∈ closure ({ξ} : Set X) → x ∉ X.basicOpen a) ↔ a ∈ (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal :=
by
  intro X U hU ξ hξ a
  have s1 : ξ ∈ X.basicOpen a ↔ a ∉ (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal := by
    have h1 : hU.fromSpec (hU.primeIdealOf ⟨ξ, hξ⟩) = ξ := hU.fromSpec_primeIdealOf ⟨ξ, hξ⟩
    have h2 : (hU.primeIdealOf ⟨ξ, hξ⟩ : Spec Γ(X, U)) ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen a ↔
        a ∉ (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal := by
      rw [hU.fromSpec_preimage_basicOpen]
      exact PrimeSpectrum.mem_basicOpen _ _
    calc ξ ∈ X.basicOpen a ↔ hU.fromSpec (hU.primeIdealOf ⟨ξ, hξ⟩) ∈ X.basicOpen a := by
          rw [h1]
      _ ↔ (hU.primeIdealOf ⟨ξ, hξ⟩ : Spec Γ(X, U)) ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen a :=
          (Scheme.Hom.mem_preimage _).symm
      _ ↔ a ∉ (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal := h2
  constructor
  · intro H
    by_contra hna
    exact H ξ hξ (subset_closure (Set.mem_singleton ξ)) (s1.mpr hna)
  · intro ha x _ hx hxb
    have hsp : ξ ⤳ x := specializes_iff_mem_closure.mpr hx
    exact s1.mp (hsp.mem_open (X.basicOpen a).isOpen hxb) ha

theorem wc_dev_cokernel_coh : ∀ (X : Scheme.{u}) (F' F : X.Modules) (ι : F' ⟶ F), Mono ι → wcCoherentMod F' → wcCoherentMod F → (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).ShortExact ∧ wcCoherentMod (Limits.cokernel ι) ∧ (∀ V : X.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) ∧ ∀ (S : Set X) (O : X.Opens), IsClosed S → (∀ V : X.Opens, Disjoint (V : Set X) S → ∀ s : Γ(F, V), s = 0) → ((∀ V : X.Opens, Disjoint (V : Set X) S → ∀ s : Γ(F', V), s = 0) ∧ (∀ V : X.Opens, Disjoint (V : Set X) S → ∀ s : Γ(Limits.cokernel ι, V), s = 0) ∧ ((∀ V : X.Opens, V ≤ O → Function.Surjective (Scheme.Modules.Hom.app ι V)) → ∀ V : X.Opens, Disjoint (V : Set X) (S ∩ (O : Set X)ᶜ) → ∀ s : Γ(Limits.cokernel ι, V), s = 0)) :=
by
  intro X F' F ι hmono hF' hF
  have hN : ∀ {M N : X.Modules} (φ : M ⟶ N) {W W' : X.Opens} (hle : W' ≤ W) (x : Γ(M, W)),
      Scheme.Modules.Hom.app φ W' (M.presheaf.map (homOfLE hle).op x) =
        N.presheaf.map (homOfLE hle).op (Scheme.Modules.Hom.app φ W x) :=
    fun φ _ _ hle x =>
      NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf φ) (homOfLE hle).op x
  have hZ : ∀ (S : ShortComplex X.Modules) (V : X.Opens) (x : Γ(S.X₁, V)),
      Scheme.Modules.Hom.app S.g V (Scheme.Modules.Hom.app S.f V x) = 0 := by
    intro S V x
    rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, S.zero,
      Scheme.Modules.Hom.zero_app]
    rfl

  have hqcoh : ∀ (S : ShortComplex X.Modules), S.ShortExact → wcQcoh S.X₁ → wcQcoh S.X₂ →
      wcQcoh S.X₃ := by
    intro S hS h1 h2
    obtain ⟨hinj, hex⟩ := wc_modules_ses_left_exact X S hS
    have hsurj := wc_modules_ses_affine_surj X S hS h1
    intro U hU f
    have hD := hU.basicOpen f
    constructor
    · intro s
      obtain ⟨y, rfl⟩ := hsurj _ hD s
      obtain ⟨n, t, ht⟩ := (h2 U hU f).1 y
      refine ⟨n, Scheme.Modules.Hom.app S.g U t, ?_⟩
      rw [← Scheme.Modules.Hom.app_smul, ht]
      exact hN S.g (X.basicOpen_le f) t
    · intro t ht
      obtain ⟨z, rfl⟩ := hsurj U hU t
      have hz : Scheme.Modules.Hom.app S.g (X.basicOpen f)
          (S.X₂.presheaf.map (homOfLE (X.basicOpen_le f)).op z) = 0 := by
        rw [hN]; exact ht
      obtain ⟨u, hu⟩ := hex _ _ hz
      obtain ⟨m, v, hv⟩ := (h1 U hU f).1 u
      have hw : S.X₂.presheaf.map (homOfLE (X.basicOpen_le f)).op
          (f ^ m • z - Scheme.Modules.Hom.app S.f U v) = 0 := by
        rw [map_sub, Scheme.Modules.map_smul, map_pow, ← hu, ← Scheme.Modules.Hom.app_smul]
        erw [hv]
        rw [← hN, sub_self]
      obtain ⟨k, hk⟩ := (h2 U hU f).2 _ hw
      refine ⟨k + m, ?_⟩
      have := congrArg (Scheme.Modules.Hom.app S.g U) hk
      rw [Scheme.Modules.Hom.app_smul, map_sub, Scheme.Modules.Hom.app_smul, hZ, sub_zero,
        map_zero, smul_smul, ← pow_add] at this
      exact this

  have hvanish : ∀ (S : ShortComplex X.Modules), S.ShortExact → wcQcoh S.X₁ → ∀ (V : X.Opens),
      (∀ x : X, x ∈ V → ∃ W : X.Opens, IsAffineOpen W ∧ x ∈ W ∧ W ≤ V ∧
        ∀ y : Γ(S.X₂, W), ∃ u : Γ(S.X₁, W), Scheme.Modules.Hom.app S.f W u = y) →
      ∀ c : Γ(S.X₃, V), c = 0 := by
    intro S hS h1 V hloc c
    have hsurj := wc_modules_ses_affine_surj X S hS h1
    choose W hWa hxW hWV hWs using fun x : V => hloc x.1 x.2
    have hcov : V ≤ iSup W := by
      intro x hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxW ⟨x, hx⟩⟩
    apply TopCat.Sheaf.eq_of_locally_eq' (⟨S.X₃.presheaf, S.X₃.isSheaf⟩ : TopCat.Sheaf Ab X) W V
      (fun x => homOfLE (hWV x)) hcov
    intro x
    obtain ⟨y, hy⟩ := hsurj (W x) (hWa x) (S.X₃.presheaf.map (homOfLE (hWV x)).op c)
    obtain ⟨u, rfl⟩ := hWs x y
    change S.X₃.presheaf.map (homOfLE (hWV x)).op c = S.X₃.presheaf.map (homOfLE (hWV x)).op 0
    rw [map_zero, ← hy, hZ]
  have hS : (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hmono inferInstance
  obtain ⟨hinj, hex⟩ := wc_modules_ses_left_exact X _ hS
  have hsurj := wc_modules_ses_affine_surj X _ hS hF'.1
  have hbasis : ∀ (V : X.Opens) (x : X), x ∈ V →
      ∃ W : X.Opens, IsAffineOpen W ∧ x ∈ W ∧ W ≤ V := by
    intro V x hx
    obtain ⟨W, hW, hxW, hWV⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens X)) hx
    exact ⟨W, hW, hxW, hWV⟩
  refine ⟨hS, ⟨hqcoh _ hS hF'.1 hF.1, ?_⟩, hinj, ?_⟩
  · intro U hU
    haveI := hF.2 U hU
    exact Module.Finite.of_surjective
      ({ toFun := fun x => Scheme.Modules.Hom.app (Limits.cokernel.π ι) U x,
         map_add' := fun x y => map_add _ x y,
         map_smul' := fun r x => Scheme.Modules.Hom.app_smul (Limits.cokernel.π ι) r x } :
        Γ(F, U) →ₗ[Γ(X, U)] Γ(Limits.cokernel ι, U)) (hsurj U hU)
  · intro S₀ O hS₀ hFS
    have hF'S : ∀ V : X.Opens, Disjoint (V : Set X) S₀ → ∀ s : Γ(F', V), s = 0 := by
      intro V hV s
      apply hinj V
      rw [map_zero]
      exact hFS V hV _
    refine ⟨hF'S, ?_, ?_⟩
    · intro V hV
      apply hvanish _ hS hF'.1 V
      intro x hx
      obtain ⟨W, hW, hxW, hWV⟩ := hbasis V x hx
      refine ⟨W, hW, hxW, hWV, fun y => ⟨0, ?_⟩⟩
      rw [map_zero, hFS W (hV.mono_left hWV) y]
    · intro hO V hV
      apply hvanish _ hS hF'.1 V
      intro x hx
      by_cases hxO : x ∈ O
      · obtain ⟨W, hW, hxW, hWV⟩ := hbasis (V ⊓ O) x ⟨hx, hxO⟩
        exact ⟨W, hW, hxW, hWV.trans inf_le_left, hO W (hWV.trans inf_le_right)⟩
      · have hxS : x ∉ S₀ := fun h => Set.disjoint_left.mp hV hx ⟨h, hxO⟩
        obtain ⟨W, hW, hxW, hWV⟩ := hbasis (V ⊓ ⟨S₀ᶜ, hS₀.isOpen_compl⟩) x ⟨hx, hxS⟩
        refine ⟨W, hW, hxW, hWV.trans inf_le_left, fun y => ⟨0, ?_⟩⟩
        have hWd : Disjoint (W : Set X) S₀ := by
          rw [Set.disjoint_left]
          intro z hz hzS
          exact (hWV hz).2 hzS
        rw [map_zero, hFS W hWd y]

theorem wc_dev_length_additive : ∀ (X : Scheme.{u}) (S : ShortComplex X.Modules) (U : X.Opens) (hU : IsAffineOpen U) (x : X) (hx : x ∈ U), S.ShortExact → wcQcoh S.X₁ → Module.length (Localization.AtPrime (hU.primeIdealOf ⟨x, hx⟩).asIdeal) (LocalizedModule (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl Γ(S.X₂, U)) = Module.length (Localization.AtPrime (hU.primeIdealOf ⟨x, hx⟩).asIdeal) (LocalizedModule (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl Γ(S.X₁, U)) + Module.length (Localization.AtPrime (hU.primeIdealOf ⟨x, hx⟩).asIdeal) (LocalizedModule (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl Γ(S.X₃, U)) :=
by
  intro X S U hU x hx hS hQ
  obtain ⟨hinj, hker⟩ := wc_modules_ses_left_exact X S hS
  have hsurj := wc_modules_ses_affine_surj X S hS hQ U hU
  let fL : Γ(S.X₁, U) →ₗ[Γ(X, U)] Γ(S.X₂, U) :=
    { toFun := (Scheme.Modules.Hom.app S.f U).hom
      map_add' := map_add _
      map_smul' := Scheme.Modules.Hom.app_smul S.f }
  let gL : Γ(S.X₂, U) →ₗ[Γ(X, U)] Γ(S.X₃, U) :=
    { toFun := (Scheme.Modules.Hom.app S.g U).hom
      map_add' := map_add _
      map_smul' := Scheme.Modules.Hom.app_smul S.g }
  have hfinj : Function.Injective fL := hinj U
  have hgsurj : Function.Surjective gL := hsurj
  have hex : Function.Exact fL gL := by
    intro y
    constructor
    · intro hy
      obtain ⟨z, hz⟩ := hker U y hy
      exact ⟨z, hz⟩
    · rintro ⟨z, rfl⟩
      have h1 : Scheme.Modules.Hom.app (S.f ≫ S.g) U z = 0 := by
        rw [S.zero, Scheme.Modules.Hom.zero_app]
        rfl
      rw [Scheme.Modules.Hom.comp_app] at h1
      exact h1
  exact Module.length_eq_add_of_exact
    (LocalizedModule.map (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl fL)
    (LocalizedModule.map (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl gL)
    (LocalizedModule.map_injective _ fL hfinj)
    (LocalizedModule.map_surjective _ gL hgsurj)
    (LocalizedModule.map_exact _ fL gL hex)

theorem wc_dev_length_cyclic_prime : ∀ (A L : Type u) [CommRing A] [AddCommGroup L] [Module A L] (p : Ideal A) [p.IsPrime] (γ : L), (∀ l : L, ∃ a : A, l = a • γ) → (∀ a : A, a • γ = 0 ↔ a ∈ p) → Module.length (Localization.AtPrime p) (LocalizedModule p.primeCompl L) = 1 :=
by
  intro A L _ _ _ p _ γ hgen hann
  rw [Module.length_eq_one_iff, isSimpleModule_iff_toSpanSingleton_surjective]
  refine ⟨?_, ?_⟩
  · refine nontrivial_of_ne (LocalizedModule.mk γ 1) 0 ?_
    intro h
    rw [← LocalizedModule.zero_mk (1 : p.primeCompl), LocalizedModule.mk_eq] at h
    obtain ⟨u, hu⟩ := h
    simp only [one_smul, smul_zero] at hu
    have hu' : (u : A) • γ = 0 := hu
    exact (Ideal.mem_primeCompl_iff.mp u.2) ((hann _).mp hu')
  · intro x hx y
    induction x using LocalizedModule.induction_on with
    | h l s =>
    induction y using LocalizedModule.induction_on with
    | h l' t =>
    obtain ⟨a, rfl⟩ := hgen l
    obtain ⟨b, rfl⟩ := hgen l'
    have ha : a ∈ p.primeCompl := by
      rw [Ideal.mem_primeCompl_iff]
      intro hap
      apply hx
      rw [(hann a).mpr hap, LocalizedModule.zero_mk]
    refine ⟨Localization.mk (b * (s : A)) (⟨a, ha⟩ * t), ?_⟩
    rw [LinearMap.toSpanSingleton_apply, LocalizedModule.mk_smul_mk, LocalizedModule.mk_eq]
    refine ⟨1, ?_⟩
    simp only [one_smul, Submonoid.smul_def, Submonoid.coe_mul, smul_smul]
    congr 1
    ring

theorem wc_dev_generic_finite_assoc : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsNoetherian X] (M : X.Modules) (Z : Set X) (ξ : X) (U : X.Opens) (hU : IsAffineOpen U) (hξ : ξ ∈ U), IsClosed Z → (∀ y ∈ Z, ξ ∈ closure ({y} : Set X) → y = ξ) → wcCoherentMod M → (∀ V : X.Opens, Disjoint (V : Set X) Z → ∀ s : Γ(M, V), s = 0) → Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal) (LocalizedModule (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal.primeCompl Γ(M, U)) ≠ ⊤ ∧ (Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal) (LocalizedModule (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal.primeCompl Γ(M, U)) ≠ 0 → ∃ t : Γ(M, U), ∀ a : Γ(X, U), a • t = 0 ↔ a ∈ (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal) :=
by
  intro X _ M Z ξ U hU hξ hZ hξmax hM hsupp

  have s4 : ∀ (R N : Type u) [CommRing R] [IsNoetherianRing R] [AddCommGroup N] [Module R N]
      [Module.Finite R N], (∀ Q : Ideal R, Q.IsPrime → Module.annihilator R N ≤ Q → Q.IsMaximal) →
      Module.length R N ≠ ⊤ := by
    intro R N _ _ _ _ _ H
    haveI : Ring.KrullDimLE 0 (R ⧸ Module.annihilator R N) := Ring.KrullDimLE.mk₀ (fun P' hP' => by
      have h1 : (P'.comap (Ideal.Quotient.mk (Module.annihilator R N))).IsPrime :=
        Ideal.comap_isPrime _ _
      have h2 : Module.annihilator R N ≤ P'.comap (Ideal.Quotient.mk (Module.annihilator R N)) := by
        intro x hx
        rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
        exact P'.zero_mem
      have h3 := H _ h1 h2
      have h4 := Ideal.map_comap_of_surjective (Ideal.Quotient.mk (Module.annihilator R N))
        Ideal.Quotient.mk_surjective P'
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk (Module.annihilator R N))
          Ideal.Quotient.mk_surjective h3 with h | h
      · rw [h4] at h; exact absurd h hP'.ne_top
      · rwa [h4] at h)
    haveI : IsArtinianRing (R ⧸ Module.annihilator R N) :=
      IsNoetherianRing.isArtinianRing_of_krullDimLE_zero
    letI : Module (R ⧸ Module.annihilator R N) N :=
      Module.IsTorsionBySet.module (Module.isTorsionBySet_annihilator R N)
    haveI : IsScalarTower R (R ⧸ Module.annihilator R N) N :=
      Module.IsTorsionBySet.isScalarTower (S := R) (Module.isTorsionBySet_annihilator R N)
    haveI : Module.Finite (R ⧸ Module.annihilator R N) N :=
      Module.Finite.of_restrictScalars_finite R (R ⧸ Module.annihilator R N) N
    haveI : IsArtinian (R ⧸ Module.annihilator R N) N := isArtinian_of_fg_of_artinian'
    haveI : IsArtinian R N := isArtinian_of_surjective_algebraMap (S := R)
      (R := R ⧸ Module.annihilator R N) Ideal.Quotient.mk_surjective
    haveI : IsNoetherian R N := isNoetherian_of_isNoetherianRing_of_finite R N
    exact Module.length_ne_top_iff.mpr
      (isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨inferInstance, inferInstance⟩)

  have s3 : ∀ (A L : Type u) [CommRing A] [AddCommGroup L] [Module A L] (p : Ideal A) [p.IsPrime],
      (∀ q : Ideal A, q.IsPrime → Module.annihilator A L ≤ q → q ≤ p → q = p) →
      ∀ Q : Ideal (Localization.AtPrime p), Q.IsPrime →
      Module.annihilator (Localization.AtPrime p) (LocalizedModule p.primeCompl L) ≤ Q →
      Q.IsMaximal := by
    intro A L _ _ _ p _ H Q hQ hAnn
    have hq : (Ideal.under A Q).IsPrime := Ideal.comap_isPrime _ _
    have h1 : Module.annihilator A L ≤ Ideal.under A Q := by
      intro a ha
      show algebraMap A (Localization.AtPrime p) a ∈ Q
      apply hAnn
      rw [Module.mem_annihilator]
      intro x
      rw [algebraMap_smul]
      induction x using LocalizedModule.induction_on with
      | h l s => rw [LocalizedModule.smul'_mk, Module.mem_annihilator.mp ha, LocalizedModule.zero_mk]
    have h2 : Ideal.under A Q ≤ p := by
      intro a ha
      by_contra hap
      have hu : IsUnit (algebraMap A (Localization.AtPrime p) a) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff _ p a).mpr hap
      exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ ha hu)
    have h3 := H _ hq h1 h2
    have h4 := IsLocalization.map_under p.primeCompl (Localization.AtPrime p) Q
    rw [h3, Localization.AtPrime.map_eq_maximalIdeal] at h4
    rw [← h4]
    exact IsLocalRing.maximalIdeal.isMaximal _

  have s5 : ∀ (A L : Type u) [CommRing A] [IsNoetherianRing A] [AddCommGroup L] [Module A L]
      [Module.Finite A L] (p : Ideal A) [p.IsPrime],
      (∀ q : Ideal A, q.IsPrime → Module.annihilator A L ≤ q → q ≤ p → q = p) →
      Module.length (Localization.AtPrime p) (LocalizedModule p.primeCompl L) ≠ 0 →
      ∃ t : L, ∀ a : A, a • t = 0 ↔ a ∈ p := by
    intro A L _ _ _ _ _ p hp H hne
    have hnt : Nontrivial (LocalizedModule p.primeCompl L) := by
      rw [← not_subsingleton_iff_nontrivial]
      intro h
      exact hne (Module.length_eq_zero_iff.mpr h)
    have hsupp' : (⟨p, hp⟩ : PrimeSpectrum A) ∈ Module.support A L := Module.mem_support_iff.mpr hnt
    have hAnn : Module.annihilator A L ≤ p := Module.mem_support_iff_of_finite.mp hsupp'
    have hmin : p ∈ (Module.annihilator A L).minimalPrimes := by
      refine ⟨⟨hp, hAnn⟩, fun q hq hqp => (H q hq.1 hq.2 hqp).ge⟩
    have hass := Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes A L hmin
    obtain ⟨x, hx⟩ := (isAssociatedPrime_iff.mp hass).2
    refine ⟨x, fun a => ?_⟩
    rw [hx, Submodule.mem_colon_singleton, Submodule.mem_bot]

  have s1 : ∀ q : PrimeSpectrum Γ(X, U), Module.annihilator Γ(X, U) Γ(M, U) ≤ q.asIdeal →
      hU.fromSpec q ∈ Z := by
    intro q hq
    by_contra hyZ
    have hyU : hU.fromSpec q ∈ U := by
      have h : hU.fromSpec q ∈ Set.range hU.fromSpec := ⟨q, rfl⟩
      rwa [hU.range_fromSpec] at h
    let V : X.Opens := U ⊓ ⟨Zᶜ, hZ.isOpen_compl⟩
    obtain ⟨g, hgV, hyg⟩ := hU.exists_basicOpen_le (V := V) ⟨hU.fromSpec q, ⟨hyU, hyZ⟩⟩ hyU
    have hdisj : Disjoint (X.basicOpen g : Set X) Z := by
      rw [Set.disjoint_left]
      intro x hx hxZ
      exact (hgV hx).2 hxZ
    have hvan := hsupp _ hdisj
    have hgq : g ∉ q.asIdeal := by
      have h : q ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen g := hyg
      rw [hU.fromSpec_preimage_basicOpen] at h
      exact h
    have hsub : Subsingleton (LocalizedModule q.asIdeal.primeCompl Γ(M, U)) := by
      rw [LocalizedModule.subsingleton_iff]
      intro m
      obtain ⟨n, hn⟩ := (hM.1 U hU g).2 m (hvan _)
      exact ⟨g ^ n, fun h => hgq (q.isPrime.mem_of_pow_mem n h), hn⟩
    haveI : Module.Finite Γ(X, U) Γ(M, U) := hM.2 U hU
    have hmem : q ∈ Module.support Γ(X, U) Γ(M, U) := Module.mem_support_iff_of_finite.mpr hq
    rw [Module.mem_support_iff] at hmem
    exact not_nontrivial_iff_subsingleton.mpr hsub hmem

  have hPξ : hU.fromSpec (hU.primeIdealOf ⟨ξ, hξ⟩) = ξ := hU.fromSpec_primeIdealOf ⟨ξ, hξ⟩
  have H : ∀ q : Ideal Γ(X, U), q.IsPrime → Module.annihilator Γ(X, U) Γ(M, U) ≤ q →
      q ≤ (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal → q = (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal := by
    intro q hq hAnn hle
    have hyZ := s1 ⟨q, hq⟩ hAnn
    have hcl : hU.primeIdealOf ⟨ξ, hξ⟩ ∈ closure {(⟨q, hq⟩ : PrimeSpectrum Γ(X, U))} :=
      (PrimeSpectrum.le_iff_mem_closure _ _).mp hle
    have hcl2 : hU.fromSpec (hU.primeIdealOf ⟨ξ, hξ⟩) ∈
        closure {hU.fromSpec (⟨q, hq⟩ : PrimeSpectrum Γ(X, U))} :=
      map_mem_closure hU.fromSpec.continuous hcl (Set.mapsTo_singleton.mpr (Set.mem_singleton _))
    rw [hPξ] at hcl2
    have heq := hξmax _ hyZ hcl2
    rw [← hPξ] at heq
    have := hU.fromSpec.isOpenEmbedding.injective heq
    exact congrArg PrimeSpectrum.asIdeal this

  haveI : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  haveI : Module.Finite Γ(X, U) Γ(M, U) := hM.2 U hU
  haveI : IsNoetherianRing (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal) :=
    IsLocalization.isNoetherianRing (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal.primeCompl _ inferInstance
  haveI : Module.Finite (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal)
      (LocalizedModule (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal.primeCompl Γ(M, U)) :=
    Module.Finite.of_isLocalizedModule (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal.primeCompl
      (LocalizedModule.mkLinearMap (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal.primeCompl Γ(M, U))
  exact ⟨s4 _ _ (s3 _ _ _ H), s5 _ _ _ H⟩

theorem wc_dev_vanish_near : ∀ (X : Scheme.{u}) (M : X.Modules) (Z : Set X) (ξ : X) (U : X.Opens) (hU : IsAffineOpen U) (hξ : ξ ∈ U), IsClosed Z → wcCoherentMod M → (∀ V : X.Opens, Disjoint (V : Set X) Z → ∀ s : Γ(M, V), s = 0) → Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal) (LocalizedModule (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal.primeCompl Γ(M, U)) = 0 → ∃ W : X.Opens, ξ ∈ W ∧ ∀ V : X.Opens, Disjoint (V : Set X) (Z ∩ (W : Set X)ᶜ) → ∀ s : Γ(M, V), s = 0 :=
by
  intro X M Z ξ U hU hξ hZ hM hsupp hlen
  have : Module.Finite Γ(X, U) Γ(M, U) := hM.2 U hU
  have hsub : Subsingleton (LocalizedModule (hU.primeIdealOf ⟨ξ, hξ⟩).asIdeal.primeCompl Γ(M, U)) :=
    Module.length_eq_zero_iff.mp hlen
  have hnot : (hU.primeIdealOf ⟨ξ, hξ⟩) ∉ Module.support Γ(X, U) Γ(M, U) :=
    Module.notMem_support_iff.mpr hsub
  rw [Module.mem_support_iff_of_finite] at hnot
  obtain ⟨u, huAnn, hup⟩ := SetLike.not_le_iff_exists.mp hnot
  have hu : ∀ t : Γ(M, U), u • t = 0 := fun t => Module.mem_annihilator.mp huAnn t
  have hξu : ξ ∈ X.basicOpen u := by
    have h1 : hU.fromSpec (hU.primeIdealOf ⟨ξ, hξ⟩) = ξ := hU.fromSpec_primeIdealOf ⟨ξ, hξ⟩
    have h2 : hU.primeIdealOf ⟨ξ, hξ⟩ ∈ hU.fromSpec ⁻¹ᵁ X.basicOpen u := by
      rw [hU.fromSpec_preimage_basicOpen]
      exact (PrimeSpectrum.mem_basicOpen _ _).mpr hup
    rw [← h1]
    exact h2
  have hzero : ∀ (g : Γ(X, U)) (σ : Γ(M, X.basicOpen (u * g))), σ = 0 := by
    intro g σ
    obtain ⟨n, t, ht⟩ := (hM.1 U hU (u * g)).1 σ
    have hb : IsUnit ((X.presheaf.map (homOfLE (X.basicOpen_le (u * g))).op).hom (u * g)) :=
      RingedSpace.isUnit_res_basicOpen X.toRingedSpace (u * g)
    have hbt : (u * g) • t = 0 := by rw [mul_comm, mul_smul, hu, smul_zero]
    have h3 : ((X.presheaf.map (homOfLE (X.basicOpen_le (u * g))).op).hom (u * g)) ^ (n + 1) • σ
        = 0 := by
      rw [pow_succ', mul_smul, ht, ← Scheme.Modules.map_smul, hbt, map_zero]
    exact (hb.pow (n + 1)).smul_left_cancel.mp (h3.trans (smul_zero _).symm)
  refine ⟨X.basicOpen u, hξu, fun V hV s => ?_⟩
  have hloc : ∀ x : V, ∃ W : X.Opens, x.1 ∈ W ∧ W ≤ V ∧ ∀ t : Γ(M, W), t = 0 := by
    rintro ⟨x, hxV⟩
    by_cases hxu : x ∈ X.basicOpen u
    · have hxU : x ∈ U := X.basicOpen_le u hxu
      obtain ⟨f, hfle, hxf⟩ := hU.exists_basicOpen_le (V := V ⊓ X.basicOpen u) ⟨x, hxV, hxu⟩ hxU
      refine ⟨X.basicOpen (u * f), ?_, ?_, hzero f⟩
      · rw [Scheme.basicOpen_mul]
        exact ⟨hxu, hxf⟩
      · rw [Scheme.basicOpen_mul]
        exact le_trans inf_le_right (le_trans hfle inf_le_left)
    · have hxZ : x ∉ Z := fun hxZ => Set.disjoint_left.mp hV hxV ⟨hxZ, hxu⟩
      refine ⟨V ⊓ ⟨Zᶜ, hZ.isOpen_compl⟩, ⟨hxV, hxZ⟩, inf_le_left, hsupp _ ?_⟩
      exact Set.disjoint_left.mpr (fun y hy hyZ => hy.2 hyZ)
  choose W hxW hWV hW0 using hloc
  have hcov : V ≤ iSup W := by
    intro y hy
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨y, hy⟩, hxW ⟨y, hy⟩⟩
  exact TopCat.Sheaf.eq_of_locally_eq' (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X) W V
    (fun x => homOfLE (hWV x)) hcov s 0 (fun x => (hW0 x _).trans (hW0 x _).symm)

theorem wc_dev_torsionfree_sub : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsNoetherian X] (F : X.Modules) (U : X.Opens), IsAffineOpen U → wcCoherentMod F → ∃ (F' : X.Modules) (ι : F' ⟶ F), Mono ι ∧ wcCoherentMod F' ∧ (∀ (V : X.Opens) (s : Γ(F', V)), F'.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op s = 0 → s = 0) ∧ ∀ V : X.Opens, V ≤ U → Function.Surjective (Scheme.Modules.Hom.app ι V) :=
by
  intro X _ F U _hU hF
  classical

  have hcomp : ∀ (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (s : Γ(F, A)),
      (F.presheaf.map (homOfLE h2).op).hom ((F.presheaf.map (homOfLE h1).op).hom s) =
        (F.presheaf.map (homOfLE (h2.trans h1)).op).hom s := by
    intro A B C h1 h2 s
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl



  have s1 : ∀ (M : X.Modules) (Φ : ∀ V : X.Opens, Γ(M, V) → Prop), (∀ V, Φ V 0) →
      (∀ V s t, Φ V s → Φ V t → Φ V (s + t)) → (∀ V (a : Γ(X, V)) s, Φ V s → Φ V (a • s)) →
      (∀ V W (h : W ≤ V) s, Φ V s → Φ W ((M.presheaf.map (homOfLE h).op).hom s)) →
      (∀ V s, (∀ x ∈ V, ∃ (W : X.Opens) (h : W ≤ V), x ∈ W ∧
        Φ W ((M.presheaf.map (homOfLE h).op).hom s)) → Φ V s) →
      ∃ (N : X.Modules) (ι : N ⟶ M), Mono ι ∧ (∀ V, Function.Injective (Scheme.Modules.Hom.app ι V)) ∧
        ∀ V (s : Γ(M, V)), (∃ t, Scheme.Modules.Hom.app ι V t = s) ↔ Φ V s := by
    intro M Φ h0 hadd hsmul hres hloc
    let S : ∀ V : X.Opens, Submodule Γ(X, V) Γ(M, V) := fun V =>
      { carrier := {s | Φ V s}
        add_mem' := fun ha hb => hadd V _ _ ha hb
        zero_mem' := h0 V
        smul_mem' := fun a _ hs => hsmul V a _ hs }
    let P : (X.Opens)ᵒᵖ ⥤ Ab.{u} :=
      { obj := fun V => AddCommGrpCat.of (S V.unop)
        map := fun {V W} i => AddCommGrpCat.ofHom
          { toFun := fun s => ⟨(M.presheaf.map i).hom s.1, hres V.unop W.unop i.unop.le s.1 s.2⟩
            map_zero' := Subtype.ext (map_zero _)
            map_add' := fun a b => Subtype.ext (map_add _ _ _) }
        map_id := fun V => by
          ext s
          change (M.presheaf.map (𝟙 V)).hom s.1 = s.1
          rw [M.presheaf.map_id]; rfl
        map_comp := fun {V W Z} i j => by
          ext s
          change (M.presheaf.map (i ≫ j)).hom s.1 =
            (M.presheaf.map j).hom ((M.presheaf.map i).hom s.1)
          rw [M.presheaf.map_comp]; rfl }
    letI inst : ∀ V : (X.Opens)ᵒᵖ, Module ↑(X.ringCatSheaf.obj.obj V) ↑(P.obj V) := fun V =>
      (inferInstance : Module Γ(X, V.unop) (S V.unop))
    let Pm : PresheafOfModules X.ringCatSheaf.obj := PresheafOfModules.ofPresheaf P (by
      intro V W f r m
      apply Subtype.ext
      exact Scheme.Modules.map_smul M f.unop r m.1)
    have hsh : TopCat.Presheaf.IsSheaf P := by
      rw [TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing]
      intro ι U sf hcompat
      let sf' : ∀ i, Γ(M, U i) := fun i => (sf i).1
      have hc' : TopCat.Presheaf.IsCompatible M.presheaf U sf' := by
        intro i j
        exact congrArg Subtype.val (hcompat i j)
      obtain ⟨s', hs', huniq⟩ := TopCat.Sheaf.existsUnique_gluing ⟨M.presheaf, M.isSheaf⟩ U sf' hc'
      have hΦ : Φ (iSup U) s' := by
        apply hloc
        intro x hx
        obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
        refine ⟨U i, le_iSup U i, hi, ?_⟩
        have := hs' i
        change (M.presheaf.map (homOfLE (le_iSup U i)).op).hom s' = sf' i at this
        rw [this]
        exact (sf i).2
      exact ⟨⟨s', hΦ⟩, fun i => Subtype.ext (hs' i),
        fun t ht => Subtype.ext (huniq t.1 fun i => congrArg Subtype.val (ht i))⟩
    let N : X.Modules := SheafOfModules.mk Pm hsh
    let φ : P ⟶ M.presheaf :=
      { app := fun V => AddCommGrpCat.ofHom (S V.unop).subtype.toAddMonoidHom
        naturality := fun V W i => rfl }
    let ι : N ⟶ M := ⟨PresheafOfModules.homMk (M₁ := Pm) (M₂ := M.val) φ (fun V r m => rfl)⟩
    have happ : ∀ V (t : Γ(N, V)), Scheme.Modules.Hom.app ι V t = (t : S V).1 := fun V t => rfl
    have hinj : ∀ V, Function.Injective (Scheme.Modules.Hom.app ι V) := by
      intro V a b hab
      rw [happ, happ] at hab
      exact Subtype.ext hab
    refine ⟨N, ι, ?_, hinj, ?_⟩
    · constructor
      intro Z f g hfg
      apply Scheme.Modules.hom_ext
      intro V
      ext s
      apply hinj V
      have := congrArg (fun k => Scheme.Modules.Hom.app k V s) hfg
      simpa [Scheme.Modules.Hom.comp_app] using this
    · intro V s
      constructor
      · rintro ⟨t, rfl⟩
        exact (t : S V).2
      · intro hs
        exact ⟨(⟨s, hs⟩ : S V), rfl⟩



  have s2 : ∀ (A M : Type u) [CommRing A] [IsNoetherianRing A] [AddCommGroup M] [Module A M]
      [Module.Finite A M] (S : Set A), ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n →
      ∀ m ∈ (Ideal.span S) ^ n • (⊤ : Submodule A M), ∀ g : A,
        (∀ c ∈ S, ∃ e : ℕ, (c * g) ^ e • m = 0) → ∃ N : ℕ, g ^ N • m = 0 := by
    intro A M _ _ _ _ _ S
    set J := Ideal.span S with hJ
    let H : Submodule A M :=
      { carrier := {x | ∀ c ∈ J, ∃ e : ℕ, c ^ e • x = 0}
        add_mem' := by
          intro x y hx hy c hc
          obtain ⟨e1, h1⟩ := hx c hc
          obtain ⟨e2, h2⟩ := hy c hc
          refine ⟨e1 + e2, ?_⟩
          rw [smul_add, pow_add, mul_smul, mul_smul, h2, smul_zero, smul_comm (c ^ e1) (c ^ e2) x,
            h1, smul_zero, add_zero]
        zero_mem' := fun c _ => ⟨0, smul_zero _⟩
        smul_mem' := by
          intro a x hx c hc
          obtain ⟨e, he⟩ := hx c hc
          exact ⟨e, by rw [smul_comm, he, smul_zero]⟩ }
    have hHmem : ∀ x, x ∈ H ↔ ∀ c ∈ J, ∃ e : ℕ, c ^ e • x = 0 := fun x => Iff.rfl
    have : IsNoetherian A M := isNoetherian_of_isNoetherianRing_of_finite A M
    obtain ⟨T, hT⟩ := (IsNoetherian.noetherian H : H.FG)
    have hann : ∀ c ∈ J, ∃ e : ℕ, ∀ x ∈ H, c ^ e • x = 0 := by
      intro c hc
      have hTH : ∀ x ∈ T, ∃ e : ℕ, c ^ e • x = 0 := fun x hx =>
        (hHmem x).mp (hT ▸ Submodule.subset_span hx) c hc
      choose! e he using hTH
      refine ⟨T.sup e, fun x hx => ?_⟩
      rw [← hT] at hx
      induction hx using Submodule.span_induction with
      | mem y hy =>
        obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le (Finset.le_sup (f := e) hy)
        rw [hk, pow_add, mul_comm, mul_smul, he y hy, smul_zero]
      | zero => exact smul_zero _
      | add y z _ _ hy hz => rw [smul_add, hy, hz, add_zero]
      | smul a y _ hy => rw [smul_comm, hy, smul_zero]
    have hJrad : J ≤ (Submodule.annihilator H).radical := by
      intro c hc
      obtain ⟨e, he⟩ := hann c hc
      exact ⟨e, Submodule.mem_annihilator.mpr fun x hx => he x hx⟩
    obtain ⟨c₀, hc₀⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hJrad (IsNoetherian.noetherian J)
    obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul J H
    have hbot : ∀ n, k + c₀ ≤ n → J ^ n • (⊤ : Submodule A M) ⊓ H = ⊥ := by
      intro n hn
      rw [hk n (by omega), eq_bot_iff]
      calc J ^ (n - k) • (J ^ k • (⊤ : Submodule A M) ⊓ H) ≤ J ^ (n - k) • H :=
            Submodule.smul_mono le_rfl inf_le_right
        _ ≤ J ^ c₀ • H := Submodule.smul_mono_left (Ideal.pow_le_pow_right (by omega))
        _ ≤ ⊥ := by
            rw [Submodule.smul_le]
            intro r hr x hx
            rw [Submodule.mem_bot]
            exact Submodule.mem_annihilator.mp (hc₀ hr) x hx
    refine ⟨k + c₀, fun n hn m hm g hg => ?_⟩
    let a : ℕ → Ideal A := fun N => LinearMap.ker (LinearMap.toSpanSingleton A M (g ^ N • m))
    have ha : ∀ N c, c ∈ a N ↔ c • g ^ N • m = 0 := fun N c => by
      simp [a, LinearMap.toSpanSingleton_apply]
    have hamono : Monotone a := by
      apply monotone_nat_of_le_succ
      intro N c hc
      rw [ha] at hc ⊢
      rw [pow_succ', mul_smul, smul_comm, hc, smul_zero]
    obtain ⟨N₀, hN₀⟩ := (monotone_stabilizes_iff_noetherian.mpr inferInstance) ⟨a, hamono⟩
    have hSrad : J ≤ (a N₀).radical := by
      rw [hJ, Ideal.span_le]
      intro c hc
      obtain ⟨e, he⟩ := hg c hc
      refine ⟨e, ?_⟩
      have h1 : c ^ e ∈ a (max e N₀) := by
        rw [ha]
        obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le (le_max_left e N₀)
        rw [hd, ← mul_smul, show c ^ e * g ^ (e + d) = g ^ d * (c * g) ^ e by ring, mul_smul, he,
          smul_zero]
      have h2 := hN₀ (max e N₀) (le_max_right _ _)
      simp only [OrderHom.coe_mk] at h2
      rw [h2]
      exact h1
    have hH : g ^ N₀ • m ∈ H := by
      intro c hc
      obtain ⟨e, he⟩ := hSrad hc
      exact ⟨e, (ha N₀ _).mp he⟩
    have hJn : g ^ N₀ • m ∈ J ^ n • (⊤ : Submodule A M) := Submodule.smul_mem _ _ hm
