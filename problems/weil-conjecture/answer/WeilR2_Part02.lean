      Limits.pullback.fst W.hom p ≫ φ.left) =
      π ≫ (Limits.pullback.snd (Limits.pullback.snd W.hom p) O.hom ≫ h) := by
    simp only [← Category.assoc, hπ1, hπ2]
    exact (congrArg (fun t => t ≫ φ.left) Hz1).trans Hv
  obtain ⟨U, hU, hUab⟩ := S5 V₀.hom _ _ hover Ω π hpt
  let V₁ : Y.Etale := wcEtOpen Y P₀' U
  let c : V₁ ⟶ (wcEtBaseChange p).obj W := MorphismProperty.Over.homMk
    (U.ι ≫ Limits.pullback.fst (Limits.pullback.snd W.hom p) O.hom)
    (Category.assoc _ _ _) trivial
  let κ : V₁ ⟶ O := MorphismProperty.Over.homMk
    (U.ι ≫ Limits.pullback.snd (Limits.pullback.snd W.hom p) O.hom)
    ((Category.assoc _ _ _).trans (congrArg (fun t => U.ι ≫ t) PC.symm)) trivial
  have hz : z (IsLocalRing.closedPoint Ω) ∈ Set.range c.left := by
    have hmem : π (IsLocalRing.closedPoint Ω) ∈ Set.range U.ι := by
      rw [Scheme.Opens.range_ι]; exact hU
    obtain ⟨t, ht⟩ := hmem
    refine ⟨t, ?_⟩
    change (U.ι ≫ Limits.pullback.fst (Limits.pullback.snd W.hom p) O.hom) t = _
    rw [Scheme.Hom.comp_apply, ht, ← hπ1]
    exact (Scheme.Hom.comp_apply π _ _).symm
  have Hc : (U.ι ≫ Limits.pullback.fst (Limits.pullback.snd W.hom p) O.hom) ≫
      Limits.pullback.fst W.hom p ≫ φ.left =
      (U.ι ≫ Limits.pullback.snd (Limits.pullback.snd W.hom p) O.hom) ≫ h := by
    simp only [Category.assoc]
    exact hUab

  refine ⟨V₁, c, hz, ?_⟩
  have wc : c.left ≫ Limits.pullback.snd W.hom p = V₁.hom := MorphismProperty.Over.w c
  have hh' : (c.left ≫ Limits.pullback.fst W.hom p) ≫ W.hom = V₁.hom ≫ p :=
    (Category.assoc _ _ _).trans ((congrArg (fun t => c.left ≫ t) e2).trans
      ((Category.assoc _ _ _).symm.trans (congrArg (fun t => t ≫ p) wc)))
  have natA := ρ.nat V₀ W φ O V₁ κ h hh (c.left ≫ Limits.pullback.fst W.hom p) hh'
    ((Category.assoc _ _ _).trans Hc) η
  have natB := ρ.nat W W (𝟙 W) ((wcEtBaseChange p).obj W) V₁ c (Limits.pullback.fst W.hom p)
    Limits.pullback.condition (c.left ≫ Limits.pullback.fst W.hom p) hh'
    (Category.comp_id _) (J.obj.map φ.op η)
  rw [hid] at natB
  rw [map_sub, ← natB, natA, ← hmc, hterm (c ≫ e) (κ ≫ d), hmc, Hb, sub_self]

theorem wc_et_finite_sections_agree_zariski : ∀ {X : Scheme.{u}} (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), (∀ (V : X.Etale) (g : J.obj.obj (Opposite.op V)), IsOpen {v : V.left | ∃ (V₁ : X.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ J.obj.map c.op g = 0} ∧ ∀ (V₁ : X.Etale) (c : V₁ ⟶ V), Set.range c.left ⊆ {v : V.left | ∃ (V₂ : X.Etale) (c₂ : V₂ ⟶ V), v ∈ Set.range c₂.left ∧ J.obj.map c₂.op g = 0} → J.obj.map c.op g = 0) → ∀ (W : X.Etale) (n : ℕ) (s : Fin n → J.obj.obj (Opposite.op W)) (w : W.left), (∀ i k : Fin n, ∃ (W' : X.Etale) (c : W' ⟶ W) (w' : W'.left), c.left w' = w ∧ J.obj.map c.op (s i) = J.obj.map c.op (s k)) → ∃ S : W.left.Opens, w ∈ S ∧ ∀ i k : Fin n, J.obj.map (wcEtOpenι X W S).op (s i) = J.obj.map (wcEtOpenι X W S).op (s k) :=
by
  intro X J hVO W n s w hagree
  let N : Fin n → Fin n → Set W.left := fun i k =>
    {v : W.left | ∃ (V₁ : X.Etale) (c : V₁ ⟶ W), v ∈ Set.range c.left ∧
      J.obj.map c.op (s i - s k) = 0}
  have hNo : ∀ i k, IsOpen (N i k) := fun i k => (hVO W (s i - s k)).1
  have hwN : ∀ i k, w ∈ N i k := by
    intro i k
    obtain ⟨W', c, w', hcw, heq⟩ := hagree i k
    refine ⟨W', c, ⟨w', hcw⟩, ?_⟩
    rw [map_sub, heq, sub_self]
  let S : W.left.Opens :=
    ⟨⋂ p : Fin n × Fin n, N p.1 p.2, isOpen_iInter_of_finite (fun p => hNo p.1 p.2)⟩
  refine ⟨S, ?_, ?_⟩
  · show w ∈ ⋂ p : Fin n × Fin n, N p.1 p.2
    exact Set.mem_iInter.mpr (fun p => hwN p.1 p.2)
  · intro i k
    have hrange : Set.range (wcEtOpenι X W S).left ⊆ N i k := by
      change Set.range S.ι ⊆ N i k
      rw [Scheme.Opens.range_ι]
      exact Set.iInter_subset (fun p : Fin n × Fin n => N p.1 p.2) (i, k)
    have h0 := (hVO W (s i - s k)).2 _ (wcEtOpenι X W S) hrange
    rw [map_sub, sub_eq_zero] at h0
    exact h0

theorem wc_et_finite_descent_local : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) [IsFinite p], Surjective p → ∀ (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ρ : wcEtTransport p J G) (H : Sheaf (Scheme.smallEtaleTopology (Limits.pullback p p)) AddCommGrpCat.{u+1}) (τ₁ : wcEtTransport (Limits.pullback.fst p p) G H) (τ₂ : wcEtTransport (Limits.pullback.snd p p) G H) (σ : wcEtTransport (Limits.pullback.fst p p ≫ p) J H), wcEtTransportFactor rfl ρ τ₁ σ → wcEtTransportFactor Limits.pullback.condition.symm ρ τ₂ σ → (∀ (O : Y.Etale) (g : G.obj.obj (Opposite.op O)) (o : O.left), ∃ (O' : Y.Etale) (d : O' ⟶ O) (o' : O'.left) (V : X.Etale) (h : O'.left ⟶ V.left) (hh : h ≫ V.hom = O'.hom ≫ p) (y : J.obj.obj (Opposite.op V)), d.left o' = o ∧ G.obj.map d.op g = ρ.ρ V O' h hh y) → (∀ (V : X.Etale) (O₂ : (Limits.pullback p p).Etale) (h : O₂.left ⟶ V.left) (hh : h ≫ V.hom = O₂.hom ≫ (Limits.pullback.fst p p ≫ p)) (z : J.obj.obj (Opposite.op V)) (o : O₂.left), σ.ρ V O₂ h hh z = 0 → ∃ (V' : X.Etale) (c : V' ⟶ V) (v' : V'.left), c.left v' = h o ∧ J.obj.map c.op z = 0) → ∀ b : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))), τ₁.ρ (Scheme.Etale.mk (𝟙 Y)) (Scheme.Etale.mk (𝟙 (Limits.pullback p p))) (Limits.pullback.fst p p) ((Category.comp_id _).trans (Category.id_comp _).symm) b = τ₂.ρ (Scheme.Etale.mk (𝟙 Y)) (Scheme.Etale.mk (𝟙 (Limits.pullback p p))) (Limits.pullback.snd p p) ((Category.comp_id _).trans (Category.id_comp _).symm) b → ∀ x : X, ∃ (V : X.Etale) (v : V.left) (s : J.obj.obj (Opposite.op V)) (d : (wcEtBaseChange p).obj V ⟶ Scheme.Etale.mk (𝟙 Y)), V.hom v = x ∧ ρ.ρ V ((wcEtBaseChange p).obj V) (Limits.pullback.fst V.hom p) Limits.pullback.condition s = G.obj.map d.op b :=
by
  intro X Y p _ hp J G ρ H τ₁ τ₂ σ hf₁ hf₂ hLS hLI b hE x
  classical

  have hleft : ∀ {S : Scheme.{u}} {Z : S.Etale} (a : Z ⟶ Scheme.Etale.mk (𝟙 S)), a.left = Z.hom :=
    fun a => (Category.comp_id a.left).symm.trans (MorphismProperty.Over.w a)
  have hterm : ∀ {S : Scheme.{u}} {Z : S.Etale} (a b : Z ⟶ Scheme.Etale.mk (𝟙 S)), a = b :=
    fun a b => MorphismProperty.Over.Hom.ext ((hleft a).trans (hleft b).symm)
  let toT : ∀ {S : Scheme.{u}} (Z : S.Etale), Z ⟶ Scheme.Etale.mk (𝟙 S) :=
    fun Z => MorphismProperty.Over.homMk Z.hom (Category.comp_id _) trivial
  have hmc : ∀ {S : Scheme.{u}} (F : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
      {A B C : S.Etale} (f : B ⟶ A) (g : C ⟶ B) (t : F.obj.obj (Opposite.op A)),
      F.obj.map (g ≫ f).op t = F.obj.map g.op (F.obj.map f.op t) := by
    intro S F A B C f g t
    rw [op_comp, Functor.map_comp]
    rfl

  let Ω := AlgebraicClosure (X.residueField x)
  let xb : Spec (.of Ω) ⟶ X :=
    Spec.map (CommRingCat.ofHom (algebraMap (X.residueField x) Ω)) ≫ X.fromSpecResidueField x
  have hxb : xb (IsLocalRing.closedPoint Ω) = x :=
    (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply x _)

  haveI hfinF := wc_finite_geom_fibre_finite p Ω xb
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin {yb : Spec (.of Ω) ⟶ Y // yb ≫ p = xb}
  obtain ⟨y₀, hy₀⟩ := hp.surj x
  obtain ⟨zb₀, hzb₀, -⟩ := wc_finite_geom_point_lift Ω p xb y₀ (hy₀.trans hxb.symm)
  let i₀ : Fin n := e ⟨zb₀, hzb₀⟩

  choose O d o' V h hh η hdo hη using fun j : Fin n =>
    hLS (Scheme.Etale.mk (𝟙 Y)) b ((e.symm j).1 (IsLocalRing.closedPoint Ω))
  have hlift : ∀ j : Fin n, ∃ t : Spec (.of Ω) ⟶ (O j).left,
      t ≫ (O j).hom = (e.symm j).1 ∧ t (IsLocalRing.closedPoint Ω) = o' j := by
    intro j
    haveI : Etale (O j).hom := (O j).prop
    refine wc_etale_lift_alg_closed_point Ω (O j).hom (e.symm j).1 (o' j) ?_
    rw [← hleft (d j)]
    exact hdo j
  choose ot hot1 hot2 using hlift

  obtain ⟨W, c, φ, v, -, hvc, hvφ⟩ := wc_et_geom_common_refinement (Scheme.Etale.mk (𝟙 X)) n V
    (fun j => toT (V j)) Ω xb (fun j => ot j ≫ h j) (fun j => by
      change (ot j ≫ h j) ≫ (V j).hom = xb
      rw [Category.assoc, hh j, ← Category.assoc, hot1 j]
      exact (e.symm j).2)
  have hvW : v ≫ W.hom = xb := by rw [← hleft c]; exact hvc

  have hagree : ∀ i k : Fin n, ∃ (W' : X.Etale) (c' : W' ⟶ W) (w' : W'.left),
      c'.left w' = v (IsLocalRing.closedPoint Ω) ∧
      J.obj.map c'.op (J.obj.map (φ i).op (η i)) = J.obj.map c'.op (J.obj.map (φ k).op (η k)) :=
    fun i k => wc_descent_reps_agree_near_geom_point wc_etale_maps_agree_near_geom_point p J G ρ H
      τ₁ τ₂ σ hf₁ hf₂ hLI b hE Ω (O i) (O k) (V i) (V k) (h i) (hh i) (h k) (hh k) (η i) (η k)
      (d i) (d k) (hη i) (hη k) (ot i) (ot k) W (φ i) (φ k) v (hvφ i) (hvφ k)
  obtain ⟨S₁, hvS₁, hS₁⟩ := wc_et_finite_sections_agree_zariski J
    (fun V' g => wc_etale_section_vanishing_open X J V' g) W n
    (fun j => J.obj.map (φ j).op (η j)) (v (IsLocalRing.closedPoint Ω)) hagree
  let W₁ : X.Etale := wcEtOpen X W S₁
  let ι₁ : W₁ ⟶ W := wcEtOpenι X W S₁
  let sec : J.obj.obj (Opposite.op W₁) := J.obj.map ι₁.op (J.obj.map (φ i₀).op (η i₀))
  have hsec : ∀ j, J.obj.map (ι₁ ≫ φ j).op (η j) = sec := by
    intro j
    rw [hmc]
    exact hS₁ j i₀
  have hrange : Set.range v ⊆ Set.range S₁.ι := by
    rintro _ ⟨t, rfl⟩
    rw [Scheme.Opens.range_ι]
    have ht : t = IsLocalRing.closedPoint Ω := Subsingleton.elim (α := PrimeSpectrum Ω) _ _
    rw [ht]
    exact hvS₁
  let v₁ : Spec (.of Ω) ⟶ (S₁ : Scheme.{u}) := IsOpenImmersion.lift S₁.ι v hrange
  have hv₁ : v₁ ≫ S₁.ι = v := IsOpenImmersion.lift_fac S₁.ι v hrange
  have hv₁φ : ∀ j, v₁ ≫ (ι₁ ≫ φ j).left = ot j ≫ h j := by
    intro j
    change v₁ ≫ S₁.ι ≫ (φ j).left = _
    rw [← Category.assoc, hv₁, hvφ j]
  have hv₁W : v₁ ≫ W₁.hom = xb := by
    change v₁ ≫ S₁.ι ≫ W.hom = xb
    rw [← Category.assoc, hv₁, hvW]

  let e₁ := toT ((wcEtBaseChange p).obj W₁)
  let gsec : G.obj.obj (Opposite.op ((wcEtBaseChange p).obj W₁)) :=
    G.obj.map e₁.op b - ρ.ρ W₁ ((wcEtBaseChange p).obj W₁) (Limits.pullback.fst W₁.hom p)
      Limits.pullback.condition sec
  have hfib : ∀ z : ((wcEtBaseChange p).obj W₁).left,
      Limits.pullback.fst W₁.hom p z = v₁ (IsLocalRing.closedPoint Ω) →
      ∃ (V₁ : Y.Etale) (c₁ : V₁ ⟶ (wcEtBaseChange p).obj W₁), z ∈ Set.range c₁.left ∧
        G.obj.map c₁.op gsec = 0 := by
    intro z hz
    obtain ⟨zb, hzb1, hzb2⟩ := wc_finite_geom_point_lift Ω (Limits.pullback.fst W₁.hom p) v₁ z hz
    have hyb : (zb ≫ Limits.pullback.snd W₁.hom p) ≫ p = xb := by
      have e1 : (zb ≫ Limits.pullback.snd W₁.hom p) ≫ p =
          (zb ≫ Limits.pullback.fst W₁.hom p) ≫ W₁.hom := by
        rw [Category.assoc, Category.assoc, Limits.pullback.condition]
      exact e1.trans ((congrArg (fun t => t ≫ W₁.hom) hzb1).trans hv₁W)
    obtain ⟨j, hj⟩ : ∃ j : Fin n, (e.symm j).1 = zb ≫ Limits.pullback.snd W₁.hom p :=
      ⟨e ⟨_, hyb⟩, by rw [Equiv.symm_apply_apply]⟩
    have hsnd : zb ≫ Limits.pullback.snd W₁.hom p = ot j ≫ (O j).hom := by
      rw [hot1 j, hj]
    obtain ⟨V₁, c₁, hc₁, hc₁0⟩ := wc_descent_rep_matches_near_geom_point
      wc_etale_maps_agree_near_geom_point p J G ρ b Ω (O j) (V j) (h j) (hh j) (η j) (d j) (hη j)
      (ot j) W₁ (ι₁ ≫ φ j) v₁ (hv₁φ j) zb hzb1 hsnd e₁
    rw [hsec j] at hc₁0
    obtain ⟨t, ht⟩ := hc₁
    exact ⟨V₁, c₁, ⟨t, ht.trans hzb2⟩, hc₁0⟩

  obtain ⟨S₂, hvS₂, hS₂⟩ := wc_finite_fibre_vanishing_zariski_nbhd p G
    (fun O' g => wc_etale_section_vanishing_open Y G O' g) W₁ gsec
    (v₁ (IsLocalRing.closedPoint Ω)) hfib

  let ι₂ : wcEtOpen X W₁ S₂ ⟶ W₁ := wcEtOpenι X W₁ S₂
  obtain ⟨v₂, hv₂⟩ : v₁ (IsLocalRing.closedPoint Ω) ∈ Set.range S₂.ι := by
    rw [Scheme.Opens.range_ι]
    exact hvS₂
  refine ⟨wcEtOpen X W₁ S₂, v₂, J.obj.map ι₂.op sec, toT _, ?_, ?_⟩
  · change (S₂.ι ≫ W₁.hom) v₂ = x
    have e3 := congrArg (fun t => t (IsLocalRing.closedPoint Ω)) hv₁W
    exact (Scheme.Hom.comp_apply _ _ _).trans ((congrArg (fun t => W₁.hom t) hv₂).trans
      ((Scheme.Hom.comp_apply v₁ W₁.hom _).symm.trans (e3.trans hxb)))
  · have h0 : (Limits.pullback.fst (wcEtOpen X W₁ S₂).hom p ≫ ι₂.left) ≫ W₁.hom =
        Limits.pullback.snd (wcEtOpen X W₁ S₂).hom p ≫ p := by
      rw [Category.assoc, MorphismProperty.Over.w ι₂]
      exact Limits.pullback.condition
    have hmap : ((wcEtBaseChange p).map ι₂).left =
        Limits.pullback.lift (Limits.pullback.fst (wcEtOpen X W₁ S₂).hom p ≫ ι₂.left)
          (Limits.pullback.snd (wcEtOpen X W₁ S₂).hom p) h0 := rfl
    have hside : Limits.pullback.fst (wcEtOpen X W₁ S₂).hom p ≫ ι₂.left =
        ((wcEtBaseChange p).map ι₂).left ≫ Limits.pullback.fst W₁.hom p := by
      rw [hmap]
      exact (Limits.pullback.lift_fst _ _ _).symm
    rw [ρ.nat W₁ (wcEtOpen X W₁ S₂) ι₂ ((wcEtBaseChange p).obj W₁)
      ((wcEtBaseChange p).obj (wcEtOpen X W₁ S₂)) ((wcEtBaseChange p).map ι₂)
      (Limits.pullback.fst W₁.hom p) Limits.pullback.condition
      (Limits.pullback.fst (wcEtOpen X W₁ S₂).hom p) Limits.pullback.condition hside sec]
    have h2 := hS₂
    rw [map_sub, sub_eq_zero] at h2
    rw [← h2, ← hmc, hterm ((wcEtBaseChange p).map (wcEtOpenι X W₁ S₂) ≫ e₁) (toT _)]

theorem wc_et_finite_descent_transport : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) [IsFinite p],
    Surjective p → ∀ (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ρ : wcEtTransport p J G),
    wcEtTransportUniv ρ → ∀ b : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))),
    (∀ (H : Sheaf (Scheme.smallEtaleTopology (Limits.pullback p p)) AddCommGrpCat.{u+1})
      (τ₁ : wcEtTransport (Limits.pullback.fst p p) G H)
      (τ₂ : wcEtTransport (Limits.pullback.snd p p) G H)
      (σ : wcEtTransport (Limits.pullback.fst p p ≫ p) J H),
      wcEtTransportFactor rfl ρ τ₁ σ → wcEtTransportFactor Limits.pullback.condition.symm ρ τ₂ σ →
      τ₁.ρ (Scheme.Etale.mk (𝟙 Y)) (Scheme.Etale.mk (𝟙 (Limits.pullback p p)))
          (Limits.pullback.fst p p) ((Category.comp_id _).trans (Category.id_comp _).symm) b =
        τ₂.ρ (Scheme.Etale.mk (𝟙 Y)) (Scheme.Etale.mk (𝟙 (Limits.pullback p p)))
          (Limits.pullback.snd p p) ((Category.comp_id _).trans (Category.id_comp _).symm) b) →
    ∃ s : J.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 X))),
      ρ.ρ (Scheme.Etale.mk (𝟙 X)) (Scheme.Etale.mk (𝟙 Y)) p
        ((Category.comp_id _).trans (Category.id_comp _).symm) s = b :=
by
  intro X Y p _ hp J G ρ hU b hyp
  classical

  have hleft : ∀ {S : Scheme.{u}} {Z : S.Etale} (a : Z ⟶ Scheme.Etale.mk (𝟙 S)), a.left = Z.hom :=
    fun a => (Category.comp_id a.left).symm.trans (MorphismProperty.Over.w a)
  have hterm : ∀ {S : Scheme.{u}} {Z : S.Etale} (a b : Z ⟶ Scheme.Etale.mk (𝟙 S)), a = b :=
    fun a b => MorphismProperty.Over.Hom.ext ((hleft a).trans (hleft b).symm)
  let toT : ∀ {S : Scheme.{u}} (Z : S.Etale), Z ⟶ Scheme.Etale.mk (𝟙 S) :=
    fun Z => MorphismProperty.Over.homMk Z.hom (Category.comp_id _) trivial
  have hmc : ∀ {S : Scheme.{u}} (F : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
      {A B C : S.Etale} (f : B ⟶ A) (g : C ⟶ B) (t : F.obj.obj (Opposite.op A)),
      F.obj.map (g ≫ f).op t = F.obj.map g.op (F.obj.map f.op t) := by
    intro S F A B C f g t
    rw [op_comp, Functor.map_comp]
    rfl

  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcov : ∀ {A B : Scheme.{u}} (g : A ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology A) (wcEtBaseChange g) := by
    intro A B g
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom =
        Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
          Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
        Category.assoc, Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
          Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
  have hsheaf : ∀ {A B : Scheme.{u}} (g : A ⟶ B)
      (H : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}),
      Presheaf.IsSheaf (Scheme.smallEtaleTopology B) ((wcEtBaseChange g).op ⋙ H.obj) := by
    intro A B g H
    haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange g) := ⟨fun K _ _ =>
      haveI : Limits.PreservesLimitsOfShape K (wcEtBaseChange g ⋙ Scheme.Etale.forget A) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget A)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
        (Scheme.Etale.forget A)⟩
    haveI := flat_of_preservesFiniteLimits (wcEtBaseChange g)
    haveI : (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology A) :=
      Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)
    exact Functor.op_comp_isSheaf _ _ _ H

  obtain ⟨H, σ, hσ⟩ := wc_et_pullback_transport_exists (Limits.pullback.fst p p ≫ p) J
  obtain ⟨τ₁, hf₁⟩ := wc_et_transport_compose_exists p (Limits.pullback.fst p p) _ rfl J G ρ hU
    H σ (hsheaf _ H)
  obtain ⟨τ₂, hf₂⟩ := wc_et_transport_compose_exists p (Limits.pullback.snd p p) _
    Limits.pullback.condition.symm J G ρ hU H σ (hsheaf _ H)
  have E := hyp H τ₁ τ₂ σ hf₁ hf₂

  have hloc := wc_et_finite_descent_local p hp J G ρ H τ₁ τ₂ σ hf₁ hf₂
    (wc_et_univ_transport_locally_surjective p J G ρ hU)
    (wc_et_univ_transport_locally_injective _ J H σ hσ) b E
  choose V v s d hv hs using hloc

  have hcompat : ∀ (x y : X) (W : X.Etale) (a : W ⟶ V x) (c : W ⟶ V y),
      J.obj.map a.op (s x) = J.obj.map c.op (s y) := by
    intro x y W a c
    have key : ∀ (z : X) (a : W ⟶ V z),
        ρ.ρ W ((wcEtBaseChange p).obj W) (Limits.pullback.fst W.hom p) Limits.pullback.condition
          (J.obj.map a.op (s z)) = G.obj.map (toT ((wcEtBaseChange p).obj W)).op b := by
      intro z a
      have h0 : (Limits.pullback.fst W.hom p ≫ a.left) ≫ (V z).hom =
          Limits.pullback.snd W.hom p ≫ p := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      have hmap : ((wcEtBaseChange p).map a).left =
          Limits.pullback.lift (Limits.pullback.fst W.hom p ≫ a.left)
            (Limits.pullback.snd W.hom p) h0 := rfl
      have hside : Limits.pullback.fst W.hom p ≫ a.left =
          ((wcEtBaseChange p).map a).left ≫ Limits.pullback.fst (V z).hom p := by
        rw [hmap]
        exact (Limits.pullback.lift_fst _ _ _).symm
      rw [ρ.nat (V z) W a ((wcEtBaseChange p).obj (V z)) ((wcEtBaseChange p).obj W)
        ((wcEtBaseChange p).map a) (Limits.pullback.fst (V z).hom p) Limits.pullback.condition
        (Limits.pullback.fst W.hom p) Limits.pullback.condition hside (s z), hs z,
        hterm (toT _) ((wcEtBaseChange p).map a ≫ d z), hmc]
    have hz : ρ.ρ W ((wcEtBaseChange p).obj W) (Limits.pullback.fst W.hom p)
        Limits.pullback.condition (J.obj.map a.op (s x) - J.obj.map c.op (s y)) = 0 := by
      rw [map_sub, key x a, key y c, sub_self]
    let S : Sieve W :=
      { arrows := fun _ g => J.obj.map g.op (J.obj.map a.op (s x)) =
          J.obj.map g.op (J.obj.map c.op (s y))
        downward_closed := by
          intro W₁ W₂ g hg f
          change J.obj.map (f ≫ g).op _ = J.obj.map (f ≫ g).op _
          rw [hmc, hmc, hg] }
    have hS : S ∈ Scheme.smallEtaleTopology X W := by
      apply hjs
      intro w
      obtain ⟨yy, hyy⟩ := hp.surj (W.hom w)
      obtain ⟨o, ho, -⟩ :=
        Scheme.Pullback.exists_preimage_pullback (f := W.hom) (g := p) w yy hyy.symm
      obtain ⟨W', c', v', hc'v, hc'z⟩ := wc_et_univ_transport_locally_injective p J G ρ hU W
        ((wcEtBaseChange p).obj W) (Limits.pullback.fst W.hom p) Limits.pullback.condition _ o hz
      refine ⟨W', c', ?_, v', hc'v.trans ho⟩
      rw [map_sub, sub_eq_zero] at hc'z
      exact hc'z
    exact J.isSeparated _ S hS _ _ (fun _ g hg => hg)

  obtain ⟨t, ht⟩ := wc_et_glue_pointwise_family X J V s (fun x => ⟨v x, hv x⟩) hcompat
  refine ⟨t, ?_⟩

  let S' : Sieve (Scheme.Etale.mk (𝟙 Y)) :=
    { arrows := fun _ g => G.obj.map g.op (ρ.ρ (Scheme.Etale.mk (𝟙 X)) (Scheme.Etale.mk (𝟙 Y)) p
          ((Category.comp_id _).trans (Category.id_comp _).symm) t) = G.obj.map g.op b
      downward_closed := by
        intro W₁ W₂ g hg f
        change G.obj.map (f ≫ g).op _ = G.obj.map (f ≫ g).op _
        rw [hmc, hmc, hg] }
  have hd : ∀ x : X, S'.arrows (d x) := by
    intro x
    have hside : Limits.pullback.fst (V x).hom p ≫ (toT (V x)).left = (d x).left ≫ p := by
      rw [hleft (toT (V x)), hleft (d x)]
      exact Limits.pullback.condition
    change G.obj.map (d x).op _ = G.obj.map (d x).op b
    have e1 := ρ.nat (Scheme.Etale.mk (𝟙 X)) (V x) (toT (V x)) (Scheme.Etale.mk (𝟙 Y))
      ((wcEtBaseChange p).obj (V x)) (d x) p ((Category.comp_id _).trans (Category.id_comp _).symm)
      (Limits.pullback.fst (V x).hom p) Limits.pullback.condition hside t
    rw [ht x (toT (V x)), hs x] at e1
    exact e1.symm
  have hS' : S' ∈ Scheme.smallEtaleTopology Y (Scheme.Etale.mk (𝟙 Y)) := by
    apply hjs
    intro y
    obtain ⟨o, -, ho2⟩ := Scheme.Pullback.exists_preimage_pullback (f := (V (p y)).hom) (g := p)
      (v (p y)) y (hv (p y))
    refine ⟨_, d (p y), hd (p y), o, ?_⟩
    rw [hleft (d (p y))]
    exact ho2
  exact G.isSeparated _ S' hS' _ _ (fun _ g hg => hg)

theorem wc_et_transport_supp : ∀ {A B : Scheme.{u}} (f : A ⟶ B)
    (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1})
    (G : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}) (ρ : wcEtTransport f F G)
    (W : Set B) (V : B.Etale) (O : A.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ f)
    (x : F.obj.obj (Opposite.op V)),
    wcSuppSec B W F V x → wcSuppSec A (f ⁻¹' W) G O (ρ.ρ V O h hh x) :=
by
  intro A B f F G ρ W V O h hh x hx
  classical
  have key : ∀ (Y : Scheme.{u}) (U : Y.Etale) (S : Sieve U), S ∈ Scheme.smallEtaleTopology Y U →
      ∀ u : U.left, ∃ (U₁ : Y.Etale) (c : U₁ ⟶ U) (u₁ : U₁.left), S.arrows c ∧ c.left u₁ = u := by
    intro Y U S hS u
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y U at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    obtain ⟨U₁, c, u₁, hc, -, hu⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS u
    exact ⟨U₁, c, u₁, hc, hu⟩
  haveI : Etale V.hom := V.prop
  haveI : Etale O.hom := O.prop
  unfold wcSuppSec at hx ⊢
  have cov : ∀ (Y : Scheme.{u}) (U : Y.Etale) (S : Sieve U), (∀ u : U.left, ∃ (U₁ : Y.Etale)
      (c : U₁ ⟶ U), S.arrows c ∧ u ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y U := by
    intro Y U S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y U
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro u
    obtain ⟨U₁, c, hc, y, hy⟩ := hS u
    have hw : c.left ≫ U.hom = U₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale U.hom := U.prop
      have h2 : Etale (c.left ≫ U.hom) := by rw [hw]; exact U₁.prop
      exact Etale.of_comp c.left U.hom
    exact ⟨U₁, c, y, hc, hEt, hy⟩
  apply cov
  intro o
  obtain ⟨V₁, c, v₁, hc, hv₁⟩ := key B V _ hx (h o)
  have hcet : Etale c.left := by
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
    exact Etale.of_comp c.left V.hom
  have hc' : F.obj.map c.op x = 0 ∨ ∀ y, V₁.hom y ∈ W := by
    obtain ⟨V₂, a, g, hg, hag⟩ := hc
    rcases hg with hg | hg
    · left
      rw [← hag, op_comp, Functor.map_comp, ConcreteCategory.comp_apply, hg, map_zero]
    · right
      intro y
      rw [← MorphismProperty.Over.w a, Scheme.Hom.comp_apply]
      exact hg _
  haveI := hcet
  let p₁ := Limits.pullback.fst c.left h
  let p₂ := Limits.pullback.snd c.left h
  let O₁ : A.Etale := Scheme.Etale.mk (p₂ ≫ O.hom)
  let d : O₁ ⟶ O := MorphismProperty.Over.homMk p₂ rfl trivial
  have hh₁ : p₁ ≫ V₁.hom = O₁.hom ≫ f := by
    change p₁ ≫ V₁.hom = (p₂ ≫ O.hom) ≫ f
    rw [← MorphismProperty.Over.w c, ← Category.assoc, Limits.pullback.condition,
      Category.assoc, hh, Category.assoc]
  obtain ⟨z, hz₁, hz₂⟩ :=
    Scheme.Pullback.exists_preimage_pullback (f := c.left) (g := h) v₁ o hv₁
  refine ⟨O₁, d, ?_, ⟨z, hz₂⟩⟩
  apply Sieve.le_generate
  rcases hc' with h0 | hW
  · left
    have := ρ.nat V V₁ c O O₁ d h hh p₁ hh₁ Limits.pullback.condition x
    rw [← this, h0, map_zero]
  · right
    intro y
    have hh₁' : p₁ ≫ V₁.hom = (p₂ ≫ O.hom) ≫ f := hh₁
    have key2 : ∀ y' : (Limits.pullback c.left h : Scheme.{u}), f ((p₂ ≫ O.hom) y') ∈ W := by
      intro y'
      have e : ((p₂ ≫ O.hom) ≫ f) y' = (p₁ ≫ V₁.hom) y' := by rw [hh₁']
      simp only [Scheme.Hom.comp_apply] at e
      simp only [Scheme.Hom.comp_apply]
      rw [e]
      exact hW _
    exact key2 y

theorem wc_suppSec_calculus : ∀ (Y : Scheme.{u}) (W : Set Y)
    (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale),
    (∀ x x' : G.obj.obj (Opposite.op V), wcSuppSec Y W G V x → wcSuppSec Y W G V x' →
      wcSuppSec Y W G V (x + x') ∧ wcSuppSec Y W G V (x - x')) ∧
    (∀ (x : G.obj.obj (Opposite.op V)) (V' : Y.Etale) (c : V' ⟶ V),
      wcSuppSec Y W G V x → wcSuppSec Y W G V' (G.obj.map c.op x)) ∧
    (∀ x : G.obj.obj (Opposite.op V), (∀ v : V.left, ∃ (V' : Y.Etale) (c : V' ⟶ V),
      v ∈ Set.range c.left ∧ wcSuppSec Y W G V' (G.obj.map c.op x)) → wcSuppSec Y W G V x) :=
by
  intro Y W G V
  have hF : ∀ {V V' V'' : Y.Etale} (g : V' ⟶ V) (h : V'' ⟶ V') (b : G.obj.obj (Opposite.op V)),
      G.obj.map (h ≫ g).op b = G.obj.map h.op (G.obj.map g.op b) := by
    intro V V' V'' g h b
    rw [op_comp, Functor.map_comp]
    rfl
  have hP : ∀ {V' V'' : Y.Etale} (h : V'' ⟶ V') (z : V''.left), V''.hom z = V'.hom (h.left z) := by
    intro V' V'' h z
    rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply]
  have s1 : ∀ {V : Y.Etale} (b : G.obj.obj (Opposite.op V)) {V' : Y.Etale} (f : V' ⟶ V),
      (Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        G.obj.map g.op b = 0 ∨ ∀ x, V'.hom x ∈ W)).arrows f →
      (G.obj.map f.op b = 0 ∨ ∀ x, V'.hom x ∈ W) := by
    rintro V b V' f ⟨V₁, h, g, hg, rfl⟩
    rcases hg with hg | hg
    · left; rw [hF, hg, map_zero]
    · right; intro z; rw [hP h z]; exact hg _
  refine ⟨fun x x' hx hx' => ?_, fun x V' c hx => ?_, fun x H => ?_⟩
  · unfold wcSuppSec at hx hx' ⊢
    have hI := (Scheme.smallEtaleTopology Y).intersection_covering hx hx'
    constructor
    · refine (Scheme.smallEtaleTopology Y).superset_covering ?_ hI
      intro V' f hf
      obtain ⟨h1, h2⟩ := hf
      apply Sieve.le_generate
      rcases s1 x f h1 with e1 | e1
      · rcases s1 x' f h2 with e2 | e2
        · left; rw [map_add, e1, e2, add_zero]
        · right; exact e2
      · right; exact e1
    · refine (Scheme.smallEtaleTopology Y).superset_covering ?_ hI
      intro V' f hf
      obtain ⟨h1, h2⟩ := hf
      apply Sieve.le_generate
      rcases s1 x f h1 with e1 | e1
      · rcases s1 x' f h2 with e2 | e2
        · left; rw [map_sub, e1, e2, sub_zero]
        · right; exact e2
      · right; exact e1
  · unfold wcSuppSec at hx ⊢
    refine (Scheme.smallEtaleTopology Y).superset_covering ?_
      ((Scheme.smallEtaleTopology Y).pullback_stable c hx)
    intro V'' g hg
    rw [Sieve.pullback_apply] at hg
    apply Sieve.le_generate
    rcases s1 x (g ≫ c) hg with e | e
    · left; rw [← hF, e]
    · right; exact e
  · unfold wcSuppSec at H ⊢
    have s4 : ∀ {V' : Y.Etale} (c : V' ⟶ V), Sieve.generate (fun (V'' : Y.Etale) (g : V'' ⟶ V') =>
        G.obj.map g.op (G.obj.map c.op x) = 0 ∨ ∀ z, V''.hom z ∈ W) ≤
        Sieve.pullback c (Sieve.generate (fun (V'' : Y.Etale) (g : V'' ⟶ V) =>
        G.obj.map g.op x = 0 ∨ ∀ z, V''.hom z ∈ W)) := by
      intro V' c V'' g hg
      rw [Sieve.pullback_apply]
      apply Sieve.le_generate
      rcases s1 (G.obj.map c.op x) g hg with e | e
      · left; rw [hF, e]
      · right; exact e
    let T : Presieve V := fun V' c => Sieve.generate (fun (V'' : Y.Etale) (g : V'' ⟶ V') =>
        G.obj.map g.op (G.obj.map c.op x) = 0 ∨ ∀ z, V''.hom z ∈ W) ∈ Scheme.smallEtaleTopology Y V'
    have hR : Sieve.generate T ∈ Scheme.smallEtaleTopology Y V := by
      have hJS : ∀ (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V),
          S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
        intro S hS
        change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro z
        obtain ⟨V₁, c, hc, y, hy⟩ := hS z
        have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
        have hEt : Etale c.left := by
          have h1 : Etale V.hom := V.prop
          have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
          exact Etale.of_comp c.left V.hom
        exact ⟨V₁, c, y, hc, hEt, hy⟩
      apply hJS
      intro v
      obtain ⟨V', c, hv, hc⟩ := H v
      exact ⟨V', c, Sieve.le_generate T V' c hc, hv⟩
    refine (Scheme.smallEtaleTopology Y).transitive hR _ ?_
    rintro Z f ⟨V', h, c, hc, rfl⟩
    rw [Sieve.pullback_comp]
    exact (Scheme.smallEtaleTopology Y).pullback_stable h
      ((Scheme.smallEtaleTopology Y).superset_covering (s4 c) hc)

theorem wc_et_gluing_of_zariski_finite : ∀ (R : Type u) [CommRing R] (X : Scheme.{u})
    (fX : X ⟶ Spec (.of R)) [QuasiCompact fX] [QuasiSeparated fX] (W : Set X), IsOpen W →
    (∀ (Y : Scheme.{u}) (p : Y ⟶ X) [IsFinite p]
      (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), wcZarGlueMod Y (p ⁻¹' W) G) →
    (∀ (Y : Scheme.{u}) (p : Y ⟶ X) [IsFinite p]
      (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (b : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))),
        wcSuppSec Y (p ⁻¹' W) G (Scheme.Etale.mk (𝟙 Y)) b → b = 0) →
    ∀ J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}, wcEtGlueMod X W J :=
by
  intro R _ X fX _ _ W hW hZG hINJ J Rsv hR s hcompat
  classical
  have hleft : ∀ {S : Scheme.{u}} {Z : S.Etale} (a : Z ⟶ Scheme.Etale.mk (𝟙 S)), a.left = Z.hom :=
    fun a => (Category.comp_id a.left).symm.trans (MorphismProperty.Over.w a)
  have hterm : ∀ {S : Scheme.{u}} {Z : S.Etale} (a b : Z ⟶ Scheme.Etale.mk (𝟙 S)), a = b :=
    fun a b => MorphismProperty.Over.Hom.ext ((hleft a).trans (hleft b).symm)
  let toT : ∀ {S : Scheme.{u}} (Z : S.Etale), Z ⟶ Scheme.Etale.mk (𝟙 S) :=
    fun Z => MorphismProperty.Over.homMk Z.hom (Category.comp_id _) trivial
  have hcomp : ∀ {A B : Scheme.{u}} {f : A ⟶ B} {V : B.Etale} {Q Q' : A.Etale} (d : Q' ⟶ Q)
      (h : Q.left ⟶ V.left), h ≫ V.hom = Q.hom ≫ f → (d.left ≫ h) ≫ V.hom = Q'.hom ≫ f := by
    intro A B f V Q Q' d h hh
    rw [Category.assoc, hh, ← Category.assoc, MorphismProperty.Over.w d]
  have natV : ∀ {A B : Scheme.{u}} {f : A ⟶ B}
      {F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}}
      {G : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}} (T : wcEtTransport f F G)
      (V V' : B.Etale) (c : V' ⟶ V) (Q : A.Etale) (h : Q.left ⟶ V.left)
      (hh : h ≫ V.hom = Q.hom ≫ f) (h' : Q.left ⟶ V'.left) (hh' : h' ≫ V'.hom = Q.hom ≫ f),
      h' ≫ c.left = h → ∀ x, T.ρ V' Q h' hh' (F.obj.map c.op x) = T.ρ V Q h hh x := by
    intro A B f F G T V V' c Q h hh h' hh' e x
    rw [T.nat V V' c Q Q (𝟙 Q) h hh h' hh' (by rw [e]; exact (Category.id_comp h).symm) x]
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  have natO : ∀ {A B : Scheme.{u}} {f : A ⟶ B}
      {F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}}
      {G : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}} (T : wcEtTransport f F G)
      (V : B.Etale) (Q Q' : A.Etale) (d : Q' ⟶ Q) (h : Q.left ⟶ V.left)
      (hh : h ≫ V.hom = Q.hom ≫ f) (x : F.obj.obj (Opposite.op V)),
      G.obj.map d.op (T.ρ V Q h hh x) = T.ρ V Q' (d.left ≫ h) (hcomp d h hh) x := by
    intro A B f F G T V Q Q' d h hh x
    rw [← T.nat V V (𝟙 V) Q Q' d h hh (d.left ≫ h) (hcomp d h hh)
      (Category.comp_id (d.left ≫ h)) x]
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  have hρeq : ∀ {A B : Scheme.{u}} {f : A ⟶ B}
      {F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}}
      {G : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}} (T : wcEtTransport f F G)
      (V : B.Etale) (Q : A.Etale) (h : Q.left ⟶ V.left) (hh : h ≫ V.hom = Q.hom ≫ f)
      (h' : Q.left ⟶ V.left) (hh' : h' ≫ V.hom = Q.hom ≫ f) (x : F.obj.obj (Opposite.op V)),
      h = h' → T.ρ V Q h hh x = T.ρ V Q h' hh' x := by
    intro A B f F G T V Q h hh h' hh' x e
    subst e
    rfl
  have hsub2 : ∀ {Y' : Scheme.{u}} {W' : Set Y'}
      {G' : Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}} {Q : Y'.Etale}
      (a a' b' : G'.obj.obj (Opposite.op Q)), wcSuppSec Y' W' G' Q (a - a') →
      wcSuppSec Y' W' G' Q (a' - b') → wcSuppSec Y' W' G' Q (a - b') := by
    intro Y' W' G' Q a a' b' h1 h2
    have e : a - b' = (a - a') + (a' - b') := by abel
    rw [e]
    exact ((wc_suppSec_calculus Y' W' G' Q).1 _ _ h1 h2).1
  have hsub3 : ∀ {Y' : Scheme.{u}} {W' : Set Y'}
      {G' : Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}} {Q : Y'.Etale}
      (a a' b b' : G'.obj.obj (Opposite.op Q)), wcSuppSec Y' W' G' Q (a - a') →
      wcSuppSec Y' W' G' Q (b - b') → wcSuppSec Y' W' G' Q (a' - b') →
      wcSuppSec Y' W' G' Q (a - b) := by
    intro Y' W' G' Q a a' b b' h1 h2 h3
    have e : a - b = ((a - a') - (b - b')) + (a' - b') := by abel
    rw [e]
    exact ((wc_suppSec_calculus Y' W' G' Q).1 _ _
      ((wc_suppSec_calculus Y' W' G' Q).1 _ _ h1 h2).2 h3).1
  have hcs : ∀ {Y' : Scheme.{u}} {W' : Set Y'}
      {G' : Sheaf (Scheme.smallEtaleTopology Y') AddCommGrpCat.{u+1}} {Q : Y'.Etale}
      (a a' b b' : G'.obj.obj (Opposite.op Q)), a = a' → b = b' →
      wcSuppSec Y' W' G' Q (a' - b') → wcSuppSec Y' W' G' Q (a - b) := by
    intro Y' W' G' Q a a' b b' h1 h2 h3
    rw [h1, h2]
    exact h3

  have TC : ∀ {A : Scheme.{u}} (fA : A ⟶ X)
      (H : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}) (σ : wcEtTransport fA J H)
      (Q : A.Etale) (V₁ V₂ : X.Etale) (g₁ : V₁ ⟶ Scheme.Etale.mk (𝟙 X))
      (g₂ : V₂ ⟶ Scheme.Etale.mk (𝟙 X)) (h₁ : Rsv.arrows g₁) (h₂ : Rsv.arrows g₂)
      (k₁ : Q.left ⟶ V₁.left) (hk₁ : k₁ ≫ V₁.hom = Q.hom ≫ fA)
      (k₂ : Q.left ⟶ V₂.left) (hk₂ : k₂ ≫ V₂.hom = Q.hom ≫ fA),
      wcSuppSec A (fA ⁻¹' W) H Q
        (σ.ρ V₁ Q k₁ hk₁ (s V₁ g₁ h₁) - σ.ρ V₂ Q k₂ hk₂ (s V₂ g₂ h₂)) := by
    intro A fA H σ Q V₁ V₂ g₁ g₂ h₁ h₂ k₁ hk₁ k₂ hk₂
    haveI : Etale V₁.hom := V₁.prop
    haveI : Etale V₂.hom := V₂.prop
    let P : X.Etale := Scheme.Etale.mk (Limits.pullback.fst V₁.hom V₂.hom ≫ V₁.hom)
    let pr₁ : P ⟶ V₁ := MorphismProperty.Over.homMk (Limits.pullback.fst V₁.hom V₂.hom) rfl trivial
    let pr₂ : P ⟶ V₂ := MorphismProperty.Over.homMk (Limits.pullback.snd V₁.hom V₂.hom)
      Limits.pullback.condition.symm trivial
    have hc := hcompat V₁ V₂ P g₁ g₂ h₁ h₂ pr₁ pr₂ (hterm _ _)
    have hu : Limits.pullback.lift k₁ k₂ (by rw [hk₁, hk₂]) ≫ P.hom = Q.hom ≫ fA := by
      change Limits.pullback.lift k₁ k₂ _ ≫ Limits.pullback.fst V₁.hom V₂.hom ≫ V₁.hom = _
      rw [Limits.pullback.lift_fst_assoc, hk₁]
    have h3 := wc_et_transport_supp fA J H σ W P Q _ hu _ hc
    rw [map_sub] at h3
    exact hcs _ _ _ _ (natV σ V₁ P pr₁ Q k₁ hk₁ _ hu (Limits.pullback.lift_fst _ _ _) _).symm
      (natV σ V₂ P pr₂ Q k₂ hk₂ _ hu (Limits.pullback.lift_snd _ _ _) _).symm h3

  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace fX
  haveI : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated fX
  obtain ⟨n, V, f, hfR, hVaff, hVcov⟩ := wc_et_finite_affine_refinement X
    (Scheme.Etale.mk (𝟙 X)) (by change CompactSpace X; infer_instance) Rsv hR
  obtain ⟨Y, p, hpfin, hpsurj, k, O, j, g, hOcov, hg⟩ :=
    wc_etale_cover_finite_zariski_refinement X ‹_› ‹_› n V hVaff (fun x => by
      obtain ⟨i, hi⟩ := hVcov x
      exact ⟨i, by rw [← hleft (f i)]; exact hi⟩)
  haveI := hpfin
  haveI := hpsurj

  obtain ⟨G, ρ, hρU⟩ := wc_et_pullback_transport_exists p J
  obtain ⟨b, hb⟩ : ∃ b : ∀ α, G.obj.obj (Opposite.op ((wcZarToEt Y).obj (O α))),
      ∀ α, b α = ρ.ρ (V (j α)) ((wcZarToEt Y).obj (O α)) (g α) (hg α)
        (s (V (j α)) (f (j α)) (hfR (j α))) := ⟨_, fun _ => rfl⟩
  have hZGc : ∀ α β, wcSuppSec Y (p ⁻¹' W) G ((wcZarToEt Y).obj (O α ⊓ O β))
      (G.obj.map ((wcZarToEt Y).map (homOfLE inf_le_left)).op (b α) -
        G.obj.map ((wcZarToEt Y).map (homOfLE inf_le_right)).op (b β)) := by
    intro α β
    refine hcs _ _ _ _
      ((congrArg (fun z => G.obj.map ((wcZarToEt Y).map (homOfLE inf_le_left)).op z)
        (hb α)).trans (natO ρ _ _ _ _ _ _ _))
      ((congrArg (fun z => G.obj.map ((wcZarToEt Y).map (homOfLE inf_le_right)).op z)
        (hb β)).trans (natO ρ _ _ _ _ _ _ _)) ?_
    exact TC p G ρ _ _ _ (f (j α)) (f (j β)) (hfR _) (hfR _) _ _ _ _
  obtain ⟨b₀, hb₀⟩ := hZG Y p G k O (fun y _ => hOcov y) b hZGc

  obtain ⟨s₀, hs₀⟩ := wc_et_finite_descent_transport p hpsurj J G ρ hρU b₀ (by
    intro H τ₁ τ₂ σ hf₁ hf₂
    unfold wcEtTransportFactor at hf₁ hf₂
    refine sub_eq_zero.mp (hINJ (Limits.pullback p p) (Limits.pullback.fst p p ≫ p) H _ ?_)
    refine (wc_suppSec_calculus _ _ H _).2.2 _ (fun z => ?_)
    obtain ⟨α, hα⟩ := hOcov (Limits.pullback.fst p p z)
    obtain ⟨β, hβ⟩ := hOcov (Limits.pullback.snd p p z)
    let UN : (Limits.pullback p p).Opens :=
      Limits.pullback.fst p p ⁻¹ᵁ O α ⊓ Limits.pullback.snd p p ⁻¹ᵁ O β
    let N := (wcZarToEt (Limits.pullback p p)).obj UN
    let κ₁ : (UN : Scheme.{u}) ⟶ (O α : Scheme.{u}) :=
      (Limits.pullback.fst p p).resLE (O α) UN inf_le_left
    let κ₂ : (UN : Scheme.{u}) ⟶ (O β : Scheme.{u}) :=
      (Limits.pullback.snd p p).resLE (O β) UN inf_le_right
    have hκ₁ : κ₁ ≫ (O α).ι = UN.ι ≫ Limits.pullback.fst p p := Scheme.Hom.resLE_comp_ι _ _
    have hκ₂ : κ₂ ≫ (O β).ι = UN.ι ≫ Limits.pullback.snd p p := Scheme.Hom.resLE_comp_ι _ _
    refine ⟨N, toT N, ?_, ?_⟩
    · change z ∈ Set.range UN.ι
      rw [Scheme.Opens.range_ι]
      exact ⟨hα, hβ⟩
    have hTY : Limits.pullback.fst p p ≫ (Scheme.Etale.mk (𝟙 Y)).hom =
        (Scheme.Etale.mk (𝟙 (Limits.pullback p p))).hom ≫ Limits.pullback.fst p p :=
      (Category.comp_id _).trans (Category.id_comp _).symm
    have hTY' : Limits.pullback.snd p p ≫ (Scheme.Etale.mk (𝟙 Y)).hom =
        (Scheme.Etale.mk (𝟙 (Limits.pullback p p))).hom ≫ Limits.pullback.snd p p :=
      (Category.comp_id _).trans (Category.id_comp _).symm
    have e1 := natV τ₁ (Scheme.Etale.mk (𝟙 Y)) ((wcZarToEt Y).obj (O α))
      (toT ((wcZarToEt Y).obj (O α))) N ((toT N).left ≫ Limits.pullback.fst p p)
      (hcomp (toT N) _ hTY) κ₁ hκ₁ hκ₁ b₀
    have e2 := natV τ₂ (Scheme.Etale.mk (𝟙 Y)) ((wcZarToEt Y).obj (O β))
      (toT ((wcZarToEt Y).obj (O β))) N ((toT N).left ≫ Limits.pullback.snd p p)
      (hcomp (toT N) _ hTY') κ₂ hκ₂ hκ₂ b₀
    rw [map_sub]
    refine hcs _ _ _ _ ((natO τ₁ _ _ _ (toT N) _ _ b₀).trans e1.symm)
      ((natO τ₂ _ _ _ (toT N) _ _ b₀).trans e2.symm) ?_
    have hWeq : Limits.pullback.snd p p ⁻¹' (p ⁻¹' W) = (Limits.pullback.fst p p ≫ p) ⁻¹' W := by
      rw [Limits.pullback.condition]; rfl
    refine hsub3 _ (τ₁.ρ ((wcZarToEt Y).obj (O α)) N κ₁ hκ₁ (b α)) _
      (τ₂.ρ ((wcZarToEt Y).obj (O β)) N κ₂ hκ₂ (b β)) ?_ ?_ ?_
    · have h1 := wc_et_transport_supp _ G H τ₁ (p ⁻¹' W) ((wcZarToEt Y).obj (O α)) N κ₁ hκ₁ _
        (hb₀ α (toT ((wcZarToEt Y).obj (O α))))
      rw [map_sub] at h1
      exact h1
    · have h2 := wc_et_transport_supp _ G H τ₂ (p ⁻¹' W) ((wcZarToEt Y).obj (O β)) N κ₂ hκ₂ _
        (hb₀ β (toT ((wcZarToEt Y).obj (O β))))
      rw [map_sub, hWeq] at h2
      exact h2
    · refine hcs _ _ _ _
        ((congrArg (τ₁.ρ ((wcZarToEt Y).obj (O α)) N κ₁ hκ₁) (hb α)).trans
          (hf₁ _ _ _ _ _ _ _ _).symm)
        ((congrArg (τ₂.ρ ((wcZarToEt Y).obj (O β)) N κ₂ hκ₂) (hb β)).trans
          (hf₂ _ _ _ _ _ _ _ _).symm) ?_
      exact TC _ H σ N _ _ (f (j α)) (f (j β)) (hfR _) (hfR _) _ _ _ _)

  refine ⟨s₀, fun V' g' hg' => ?_⟩
  haveI : Etale V'.hom := V'.prop
  let Oi : Y.Etale := Scheme.Etale.mk (Limits.pullback.snd V'.hom p)
  refine wc_et_transport_supp_reflect p J G ρ hρU W hW V' Oi (Limits.pullback.fst V'.hom p)
    Limits.pullback.condition _ (fun v => ?_) ?_
  · obtain ⟨y, hy⟩ := Surjective.surj (f := p) (V'.hom v)
    obtain ⟨z, hz, -⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := V'.hom) (g := p) v y hy.symm
    exact ⟨z, hz⟩
  refine (wc_suppSec_calculus _ _ G _).2.2 _ (fun o => ?_)
  obtain ⟨α, hα⟩ := hOcov (Oi.hom o)
  let UM : Oi.left.Opens := Oi.hom ⁻¹ᵁ O α
  let M := wcEtOpen Y Oi UM
  let cM := wcEtOpenι Y Oi UM
  refine ⟨M, cM, ?_, ?_⟩
  · change o ∈ Set.range UM.ι
    rw [Scheme.Opens.range_ι]
    exact hα
  let eM : (UM : Scheme.{u}) ⟶ (O α : Scheme.{u}) := Oi.hom.resLE (O α) UM le_rfl
  have heM : eM ≫ ((wcZarToEt Y).obj (O α)).hom = M.hom := Scheme.Hom.resLE_comp_ι _ _
  let cMα : M ⟶ (wcZarToEt Y).obj (O α) := MorphismProperty.Over.homMk eM heM trivial
  simp only [map_sub]
  refine hcs _ _ _ _ (natO ρ _ _ _ _ _ _ _) (natO ρ _ _ _ _ _ _ _) ?_
  refine hsub2 _ (G.obj.map cMα.op (b α)) _ ?_ ?_
  · have hw : cM.left ≫ Limits.pullback.snd V'.hom p = M.hom := MorphismProperty.Over.w cM
    have k1 : (cM.left ≫ Limits.pullback.fst V'.hom p) ≫ g'.left = M.hom ≫ p :=
      (Category.assoc _ _ _).trans
        ((congrArg (fun t => cM.left ≫ t)
          ((congrArg (fun t => Limits.pullback.fst V'.hom p ≫ t) (hleft g')).trans
            Limits.pullback.condition)).trans
          ((Category.assoc _ _ _).symm.trans (congrArg (fun t => t ≫ p) hw)))
    have hhA : ((cM.left ≫ Limits.pullback.fst V'.hom p) ≫ g'.left) ≫
        (Scheme.Etale.mk (𝟙 X)).hom = M.hom ≫ p :=
      (congrArg (fun t => t ≫ (Scheme.Etale.mk (𝟙 X)).hom) k1).trans (Category.comp_id _)
    have hp : p ≫ (Scheme.Etale.mk (𝟙 X)).hom = (Scheme.Etale.mk (𝟙 Y)).hom ≫ p :=
      (Category.comp_id _).trans (Category.id_comp _).symm
    have ha : ρ.ρ V' M (cM.left ≫ Limits.pullback.fst V'.hom p)
        (hcomp cM _ Limits.pullback.condition) (J.obj.map g'.op s₀) =
        G.obj.map cMα.op (G.obj.map (toT ((wcZarToEt Y).obj (O α))).op b₀) := by
      calc ρ.ρ V' M (cM.left ≫ Limits.pullback.fst V'.hom p)
            (hcomp cM _ Limits.pullback.condition) (J.obj.map g'.op s₀)
          = ρ.ρ (Scheme.Etale.mk (𝟙 X)) M ((cM.left ≫ Limits.pullback.fst V'.hom p) ≫ g'.left)
              hhA s₀ :=
            natV ρ (Scheme.Etale.mk (𝟙 X)) V' g' M _ hhA _ _ rfl s₀
        _ = ρ.ρ (Scheme.Etale.mk (𝟙 X)) M ((toT M).left ≫ p)
              (hcomp (V := Scheme.Etale.mk (𝟙 X)) (toT M) p hp) s₀ :=
            hρeq ρ _ _ _ _ _ _ s₀ k1
        _ = G.obj.map (toT M).op (ρ.ρ (Scheme.Etale.mk (𝟙 X)) (Scheme.Etale.mk (𝟙 Y)) p hp s₀) :=
            (natO ρ (Scheme.Etale.mk (𝟙 X)) (Scheme.Etale.mk (𝟙 Y)) M (toT M) p hp s₀).symm
        _ = G.obj.map (toT M).op b₀ := by rw [hs₀]
        _ = G.obj.map cMα.op (G.obj.map (toT ((wcZarToEt Y).obj (O α))).op b₀) := by
            rw [hterm (toT M) (cMα ≫ toT ((wcZarToEt Y).obj (O α))), op_comp,
              CategoryTheory.Functor.map_comp]
            rfl
    have hr := (wc_suppSec_calculus _ _ G _).2.1 _ M cMα
      (hb₀ α (toT ((wcZarToEt Y).obj (O α))))
    rw [map_sub] at hr
    exact hcs _ _ _ _ ha rfl hr
  · refine hcs _ _ _ _ ((congrArg (fun z => G.obj.map cMα.op z) (hb α)).trans
      (natO ρ _ _ _ _ _ _ _)) rfl ?_
    exact TC p G ρ M _ _ (f (j α)) g' (hfR _) hg' _ _ _ _

theorem wc_spectral_trace_shrinking : ∀ (X : Type u) [TopologicalSpace X] [CompactSpace X]
    [QuasiSeparatedSpace X] [PrespectralSpace X] [QuasiSober X] (Z : Set X), IsClosed Z →
    (∀ y : X, IsConnected (closure {y} ∩ Z)) →
    ∀ (k : ℕ) (O : Fin k → Set X) (N : Fin k → Fin k → Set X),
    (∀ i, IsOpen (O i) ∧ IsCompact (O i)) → (∀ z ∈ Z, ∃ i, z ∈ O i) →
    (∀ i j, IsOpen (N i j)) → (∀ i, O i ⊆ N i i) → (∀ i j, N i j ⊆ N j i) →
    (∀ i j l, N i j ∩ N j l ⊆ N i l) → (∀ i j, Z ∩ (O i ∩ O j) ⊆ N i j) →
    ∃ A : Fin k → Set X, (∀ i, IsOpen (A i)) ∧ (∀ i, A i ⊆ O i) ∧ (∀ y, ∃ i, y ∈ A i) ∧
      ∀ i j, A i ∩ A j ⊆ N i j :=
by
  intro X _ _ _ _ _ Z hZ hconn k O N hO hcov hN hrefl hsymm htrans hZN
  classical

  have hc : @CompactSpace X (constructibleTopology X) := by
    have h1 : IsCompact (Set.univ : Set (WithConstructibleTopology X)) := isCompact_univ
    have h2 := @IsCompact.image _ _ _ (constructibleTopology X) _ _ h1
      (WithTopology.continuous_ofTopology (constructibleTopology X))
    rw [Set.image_univ_of_surjective (WithTopology.ofTopology_surjective _)] at h2
    exact @CompactSpace.mk X (constructibleTopology X) h2

  have s2 : ∀ U : Set X, IsOpen U → @IsOpen X (constructibleTopology X) U := by
    intro U hU
    rw [@isOpen_iff_forall_mem_open X (constructibleTopology X)]
    intro x hx
    obtain ⟨V, ⟨hVo, hVc⟩, hxV, hVU⟩ :=
      PrespectralSpace.isTopologicalBasis.exists_subset_of_mem_open hx hU
    exact ⟨V, hVU, hVc.isOpen_constructibleTopology_of_isOpen hVo, hxV⟩

  have s3 : ∀ E : Set X, @IsClosed X (constructibleTopology X) E →
      StableUnderSpecialization E → IsClosed E := by
    intro E hE hst
    apply isClosed_of_closure_subset
    intro y hy
    let ι := {U : Set X // IsOpen U ∧ IsCompact U ∧ y ∈ U}
    have hEc : @IsCompact X (constructibleTopology X) E :=
      @IsClosed.isCompact X (constructibleTopology X) E hc hE
    obtain ⟨e, heE, heI⟩ := @IsCompact.inter_iInter_nonempty X (constructibleTopology X) E ι hEc
      (fun U => U.1) (fun U => U.2.2.1.isClosed_constructibleTopology_of_isOpen U.2.1) (by
        intro u
        have hVo : IsOpen (⋂ U ∈ u, (U : ι).1) := isOpen_biInter_finset (fun U _ => U.2.1)
        have hyV : y ∈ ⋂ U ∈ u, (U : ι).1 := Set.mem_iInter₂.mpr (fun U _ => U.2.2.2)
        obtain ⟨z, hz1, hz2⟩ := mem_closure_iff.mp hy _ hVo hyV
        exact ⟨z, hz2, hz1⟩)
    have hey : e ⤳ y := by
      rw [specializes_iff_forall_open]
      intro s hs hys
      obtain ⟨V, ⟨hVo, hVc⟩, hyV, hVs⟩ :=
        PrespectralSpace.isTopologicalBasis.exists_subset_of_mem_open hys hs
      exact hVs (Set.mem_iInter.mp heI ⟨V, hVo, hVc, hyV⟩)
    exact hst hey heE

  have s4 : ∀ K : Set X, @IsClosed X (constructibleTopology X) K →
      @IsClosed X (constructibleTopology X) {y | ∃ x ∈ K, y ⤳ x} := by
    intro K hK
    apply @IsClosed.mk X (constructibleTopology X)
    rw [@isOpen_iff_forall_mem_open X (constructibleTopology X)]
    intro y hy
    let ι := {U : Set X // IsOpen U ∧ IsCompact U ∧ y ∉ U}
    have hKc : @IsCompact X (constructibleTopology X) K :=
      @IsClosed.isCompact X (constructibleTopology X) K hc hK
    obtain ⟨t, ht⟩ := @IsCompact.elim_finite_subcover X (constructibleTopology X) K ι hKc
      (fun U => U.1) (fun U => U.2.2.1.isOpen_constructibleTopology_of_isOpen U.2.1) (by
        intro x hx
        have hnx : ¬ y ⤳ x := fun h => hy ⟨x, hx, h⟩
        rw [specializes_iff_forall_open] at hnx
        push_neg at hnx
        obtain ⟨s, hs, hxs, hys⟩ := hnx
        obtain ⟨V, ⟨hVo, hVc⟩, hxV, hVs⟩ :=
          PrespectralSpace.isTopologicalBasis.exists_subset_of_mem_open hxs hs
        exact Set.mem_iUnion.mpr ⟨⟨V, hVo, hVc, fun h => hys (hVs h)⟩, hxV⟩)
    refine ⟨⋂ U ∈ t, ((U : ι).1)ᶜ, ?_, ?_, ?_⟩
    · rintro y' hy' ⟨x, hxK, hyx⟩
      obtain ⟨U, hUt, hxU⟩ := Set.mem_iUnion₂.mp (ht hxK)
      exact (Set.mem_iInter₂.mp hy' U hUt) (hyx.mem_open U.2.1 hxU)
    · exact @isOpen_biInter_finset X ι (constructibleTopology X) t _ (fun U _ =>
        IsCompact.isOpen_constructibleTopology_of_isClosed
          (by rw [compl_compl]; exact U.2.2.1) U.2.1.isClosed_compl)
    · exact Set.mem_iInter₂.mpr (fun U _ => U.2.2.2)

  have W : ∀ (y : X), IsPreconnected (closure {y} ∩ Z) → ∀ (i l m : Fin k) (z z' : X),
      z ∈ closure {y} ∩ Z → z ∈ O l → y ∈ N i l → z' ∈ closure {y} ∩ Z → z' ∈ O m →
      y ∈ N i m := by
    intro y hpc i l m z z' hz hzl hyil hz' hz'm
    by_contra hyim
    have hu : IsOpen (⋃ a, ⋃ (_ : y ∈ N i a), O a) :=
      isOpen_iUnion (fun a => isOpen_iUnion (fun _ => (hO a).1))
    have hv : IsOpen (⋃ a, ⋃ (_ : y ∉ N i a), O a) :=
      isOpen_iUnion (fun a => isOpen_iUnion (fun _ => (hO a).1))
    have hcov' : closure {y} ∩ Z ⊆
        (⋃ a, ⋃ (_ : y ∈ N i a), O a) ∪ (⋃ a, ⋃ (_ : y ∉ N i a), O a) := by
      intro w hw
      obtain ⟨a, ha⟩ := hcov w hw.2
      by_cases h : y ∈ N i a
      · exact Or.inl (Set.mem_iUnion₂.mpr ⟨a, h, ha⟩)
      · exact Or.inr (Set.mem_iUnion₂.mpr ⟨a, h, ha⟩)
    have hdisj : closure {y} ∩ Z ∩
        ((⋃ a, ⋃ (_ : y ∈ N i a), O a) ∩ (⋃ a, ⋃ (_ : y ∉ N i a), O a)) = ∅ := by
      apply Set.eq_empty_iff_forall_notMem.mpr
      rintro w ⟨hw, hwu, hwv⟩
      obtain ⟨a, ha, hwa⟩ := Set.mem_iUnion₂.mp hwu
      obtain ⟨b, hb, hwb⟩ := Set.mem_iUnion₂.mp hwv
      have hab : w ∈ N a b := hZN a b ⟨hw.2, hwa, hwb⟩
      have hyw : y ⤳ w := specializes_iff_mem_closure.mpr hw.1
      have hyab : y ∈ N a b := hyw.mem_open (hN a b) hab
      exact hb (htrans i a b ⟨ha, hyab⟩)
    have hzu : z ∈ (⋃ a, ⋃ (_ : y ∈ N i a), O a) := Set.mem_iUnion₂.mpr ⟨l, hyil, hzl⟩
    have hz'v : z' ∈ (⋃ a, ⋃ (_ : y ∉ N i a), O a) := Set.mem_iUnion₂.mpr ⟨m, hyim, hz'm⟩
    rcases isPreconnected_iff_subset_of_disjoint.mp hpc _ _ hu hv hcov' hdisj with h | h
    · have hmem : z' ∈ closure {y} ∩ Z ∩
          ((⋃ a, ⋃ (_ : y ∈ N i a), O a) ∩ (⋃ a, ⋃ (_ : y ∉ N i a), O a)) :=
        ⟨hz', h hz', hz'v⟩
      rw [hdisj] at hmem
      exact hmem
    · have hmem : z ∈ closure {y} ∩ Z ∩
          ((⋃ a, ⋃ (_ : y ∈ N i a), O a) ∩ (⋃ a, ⋃ (_ : y ∉ N i a), O a)) :=
        ⟨hz, hzu, h hz⟩
      rw [hdisj] at hmem
      exact hmem

  let A : Fin k → Set X := fun i =>
    {y | y ∈ O i ∧ ∀ (l : Fin k) (x : X), x ∈ Z → x ∈ O l → y ⤳ x → y ∈ N i l}
  have hne : ∀ y : X, ∃ z, z ∈ closure {y} ∩ Z := fun y => (hconn y).nonempty
  have hpc : ∀ y : X, IsPreconnected (closure {y} ∩ Z) := fun y => (hconn y).isPreconnected
  have hAO : ∀ i, A i ⊆ O i := fun i y hy => hy.1
  have hAcov : ∀ y, ∃ i, y ∈ A i := by
    intro y
    obtain ⟨z, hz⟩ := hne y
    obtain ⟨l, hzl⟩ := hcov z hz.2
    have hyz : y ⤳ z := specializes_iff_mem_closure.mpr hz.1
    have hyl : y ∈ O l := hyz.mem_open (hO l).1 hzl
    refine ⟨l, hyl, ?_⟩
    intro m x hxZ hxm hyx
    exact W y (hpc y) l l m z x hz hzl (hrefl l hyl)
      ⟨specializes_iff_mem_closure.mp hyx, hxZ⟩ hxm
  have hAN : ∀ i j, A i ∩ A j ⊆ N i j := by
    rintro i j y ⟨hyi, hyj⟩
    obtain ⟨z, hz⟩ := hne y
    obtain ⟨l, hzl⟩ := hcov z hz.2
    have hyz : y ⤳ z := specializes_iff_mem_closure.mpr hz.1
    have h1 : y ∈ N i l := hyi.2 l z hz.2 hzl hyz
    have h2 : y ∈ N l j := hsymm j l (hyj.2 l z hz.2 hzl hyz)
    exact htrans i l j ⟨h1, h2⟩
  have hAgen : ∀ i, StableUnderGeneralization (A i) := by
    intro i y y' hy'y hy
    refine ⟨hy'y.mem_open (hO i).1 hy.1, ?_⟩
    intro l x hxZ hxl hy'x
    obtain ⟨z, hz⟩ := hne y
    obtain ⟨m, hzm⟩ := hcov z hz.2
    have hyz : y ⤳ z := specializes_iff_mem_closure.mpr hz.1
    have h1 : y ∈ N i m := hy.2 m z hz.2 hzm hyz
    have h2 : y' ∈ N i m := hy'y.mem_open (hN i m) h1
    exact W y' (hpc y') i m l z x ⟨specializes_iff_mem_closure.mp (hy'y.trans hyz), hz.2⟩ hzm h2
      ⟨specializes_iff_mem_closure.mp hy'x, hxZ⟩ hxl
  have hZc : @IsClosed X (constructibleTopology X) Z :=
    @IsClosed.mk X (constructibleTopology X) Z (s2 _ hZ.isOpen_compl)
  have hAopen : ∀ i, IsOpen (A i) := by
    intro i
    let S : Fin k → Set X := fun l => {y | ∃ x ∈ Z ∩ O l, y ⤳ x}
    have hcompl : (A i)ᶜ = (O i)ᶜ ∪ ⋃ l, (S l ∩ (N i l)ᶜ) := by
      ext y
      constructor
      · intro h
        by_cases hy : y ∈ O i
        · right
          have h' : ¬ ∀ (l : Fin k) (x : X), x ∈ Z → x ∈ O l → y ⤳ x → y ∈ N i l :=
            fun h'' => h ⟨hy, h''⟩
          push_neg at h'
          obtain ⟨l, x, hxZ, hxl, hyx, hyN⟩ := h'
          exact Set.mem_iUnion.mpr ⟨l, ⟨x, ⟨hxZ, hxl⟩, hyx⟩, hyN⟩
        · left; exact hy
      · intro h h'
        rcases h with h | h
        · exact h h'.1
        · obtain ⟨l, ⟨x, ⟨hxZ, hxl⟩, hyx⟩, hyN⟩ := Set.mem_iUnion.mp h
          exact hyN (h'.2 l x hxZ hxl hyx)
    have hcl : @IsClosed X (constructibleTopology X) (A i)ᶜ := by
      rw [hcompl]
      apply @IsClosed.union X _ _ (constructibleTopology X)
      · exact @IsClosed.mk X (constructibleTopology X) _ (by
          rw [compl_compl]; exact (hO i).2.isOpen_constructibleTopology_of_isOpen (hO i).1)
      · apply @isClosed_iUnion_of_finite X (Fin k) (constructibleTopology X) _
        intro l
        apply @IsClosed.inter X _ _ (constructibleTopology X)
        · exact s4 _ (@IsClosed.inter X _ _ (constructibleTopology X) hZc
            ((hO l).2.isClosed_constructibleTopology_of_isOpen (hO l).1))
        · exact @IsClosed.mk X (constructibleTopology X) _ (by
            rw [compl_compl]; exact s2 _ (hN i l))
    have hst : StableUnderSpecialization (A i)ᶜ :=
      stableUnderSpecialization_compl_iff.mpr (hAgen i)
    exact isClosed_compl_iff.mp (s3 _ hcl hst)
  exact ⟨A, hAopen, hAO, hAcov, hAN⟩

theorem wc_zar_supp_iff_local_vanishing : ∀ (Y : Scheme.{u})
    (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (Z : Set Y), IsClosed Z →
    ∀ (U : Y.Opens) (c : G.obj.obj (Opposite.op ((wcZarToEt Y).obj U))),
    wcSuppSec Y Zᶜ G ((wcZarToEt Y).obj U) c ↔
      ∀ y ∈ U, y ∈ Z → ∃ (W : Y.Opens) (h : W ≤ U), y ∈ W ∧
        G.obj.map ((wcZarToEt Y).map (homOfLE h)).op c = 0 :=
by
  intro Y G Z hZ U c
  classical

  have hEtHom : ∀ {A B : Y.Etale} (c : A ⟶ B), Etale c.left := by
    intro A B c
    have hw : c.left ≫ B.hom = A.hom := MorphismProperty.Over.w c
    have h1 : Etale B.hom := B.prop
    have h2 : Etale (c.left ≫ B.hom) := by rw [hw]; exact A.prop
    exact Etale.of_comp c.left B.hom

  have hcov : ∀ (V : Y.Etale) (S : Sieve V), S ∈ Scheme.smallEtaleTopology Y V ↔
      ∀ x : V.left, ∃ (D : Y.Etale) (f : D ⟶ V) (d : D.left),
        S.arrows f ∧ Etale f.left ∧ f.left d = x := by
    intro V S
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V ↔ _
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    exact @Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _

  have hvan : ∀ (V V₁ : Y.Etale) (g : G.obj.obj (Opposite.op V)) (c : V₁ ⟶ V),
      Set.range c.left ⊆ {v : V.left | ∃ (V₂ : Y.Etale) (c₂ : V₂ ⟶ V),
        v ∈ Set.range c₂.left ∧ G.obj.map c₂.op g = 0} → G.obj.map c.op g = 0 := by
    intro V V₁ g c hsub
    let S : Sieve V₁ :=
      { arrows := fun D d => G.obj.map d.op (G.obj.map c.op g) = 0
        downward_closed := by
          intro D D' d hd e
          change G.obj.map (e ≫ d).op (G.obj.map c.op g) = 0
          rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
          rw [hd, map_zero] }
    have hS : S ∈ Scheme.smallEtaleTopology Y V₁ := by
      apply (hcov V₁ S).mpr
      intro p
      obtain ⟨V₂, c₂, ⟨q₀, hq₀⟩, hc₂⟩ := hsub ⟨p, rfl⟩
      haveI : Etale c₂.left := hEtHom c₂
      haveI : Etale V₁.hom := V₁.prop
      let fst := Limits.pullback.fst c.left c₂.left
      let snd := Limits.pullback.snd c.left c₂.left
      haveI hfst : Etale fst := inferInstance
      let D : Y.Etale := Scheme.Etale.mk (fst ≫ V₁.hom)
      have hw2 : snd ≫ V₂.hom = fst ≫ V₁.hom := by
        rw [← MorphismProperty.Over.w c₂, ← MorphismProperty.Over.w c, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let π₁ : D ⟶ V₁ := MorphismProperty.Over.homMk fst rfl trivial
      let π₂ : D ⟶ V₂ := MorphismProperty.Over.homMk snd hw2 trivial
      have hcomm : π₁ ≫ c = π₂ ≫ c₂ := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.condition
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback p q₀ hq₀.symm
      have hπ₁ : S.arrows π₁ := by
        change G.obj.map π₁.op (G.obj.map c.op g) = 0
        rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hcomm, op_comp,
          Functor.map_comp, ConcreteCategory.comp_apply, hc₂, map_zero]
      exact ⟨D, π₁, z, hπ₁, hfst, hz1⟩
    have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj G).2
    exact (hsh S hS).isSeparatedFor.ext (fun D d hd => by
      change G.obj.map d.op (G.obj.map c.op g) = G.obj.map d.op 0
      rw [map_zero]
      exact hd)

  have hrng : ∀ O : Y.Opens, Set.range ((wcZarToEt Y).obj O).hom = (O : Set Y) :=
    fun O => Scheme.Opens.range_ι O
  have hmem : ∀ (O : Y.Opens) (p : ((wcZarToEt Y).obj O).left),
      ((wcZarToEt Y).obj O).hom p ∈ O := by
    intro O p
    show ((wcZarToEt Y).obj O).hom p ∈ (O : Set Y)
    rw [← hrng O]
    exact ⟨p, rfl⟩
  have hinj : ∀ O : Y.Opens, Function.Injective ((wcZarToEt Y).obj O).hom := by
    intro O
    haveI : IsOpenImmersion ((wcZarToEt Y).obj O).hom := (inferInstance : IsOpenImmersion O.ι)
    exact ((wcZarToEt Y).obj O).hom.isOpenEmbedding.injective
  have hpt : ∀ (O O' : Y.Opens) (h : O ≤ O') (x : ((wcZarToEt Y).obj O').left),
      ((wcZarToEt Y).obj O').hom x ∈ O → ∃ w, ((wcZarToEt Y).map (homOfLE h)).left w = x := by
    intro O O' h x hx
    have hx' : ((wcZarToEt Y).obj O').hom x ∈ (O : Set Y) := hx
    rw [← hrng O] at hx'
    obtain ⟨w, hw⟩ := hx'
    refine ⟨w, hinj O' ?_⟩
    rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w ((wcZarToEt Y).map (homOfLE h)), hw]
  constructor
  ·
    intro hL y hyU hyZ
    unfold wcSuppSec at hL
    have hx0 : ∃ x : ((wcZarToEt Y).obj U).left, ((wcZarToEt Y).obj U).hom x = y := by
      have : y ∈ (U : Set Y) := hyU
      rw [← hrng U] at this
      exact this
    obtain ⟨x, hx⟩ := hx0
    obtain ⟨D, f, d, hf, -, hd⟩ := (hcov _ _).mp hL x
    obtain ⟨D', k, g', hg', hcomp⟩ := hf
    have hq : g'.left (k.left d) = x := by
      rw [← hd, ← hcomp]; rfl
    have hg0 : G.obj.map g'.op c = 0 := by
      rcases hg' with h | h
      · exact h
      · exfalso
        have h1 := h (k.left d)
        have h2 : D'.hom (k.left d) = y := by
          rw [← MorphismProperty.Over.w g', Scheme.Hom.comp_apply, hq, hx]
        rw [h2] at h1
        exact h1 hyZ
    have hRo : IsOpen (Set.range g'.left) := by
      haveI := hEtHom g'
      exact g'.left.isOpenMap.isOpen_range
    have hVo : IsOpenMap ((wcZarToEt Y).obj U).hom := by
      haveI : Etale ((wcZarToEt Y).obj U).hom := ((wcZarToEt Y).obj U).prop
      exact ((wcZarToEt Y).obj U).hom.isOpenMap
    let W : Y.Opens := ⟨((wcZarToEt Y).obj U).hom '' Set.range g'.left, hVo _ hRo⟩
    have hWU : W ≤ U := by
      rintro z ⟨r, -, rfl⟩
      exact hmem U r
    have hyW : y ∈ W := ⟨x, ⟨k.left d, hq⟩, hx⟩
    refine ⟨W, hWU, hyW, ?_⟩
    apply hvan _ _ c ((wcZarToEt Y).map (homOfLE hWU))
    rintro v ⟨w, rfl⟩
    have hw : ((wcZarToEt Y).obj W).hom w ∈ W := hmem W w
    obtain ⟨r, hr, hr'⟩ := hw
    refine ⟨D', g', ?_, hg0⟩
    have : r = ((wcZarToEt Y).map (homOfLE hWU)).left w := by
      apply hinj U
      rw [hr', ← Scheme.Hom.comp_apply, MorphismProperty.Over.w ((wcZarToEt Y).map (homOfLE hWU))]
    rw [← this]
    exact hr
  ·
    intro hR
    unfold wcSuppSec
    apply (hcov _ _).mpr
    intro x
    by_cases hxZ : ((wcZarToEt Y).obj U).hom x ∈ Z
    · obtain ⟨W, h, hyW, hc⟩ := hR _ (hmem U x) hxZ
      obtain ⟨w, hw⟩ := hpt W U h x hyW
      exact ⟨_, (wcZarToEt Y).map (homOfLE h), w,
        ⟨_, 𝟙 _, (wcZarToEt Y).map (homOfLE h), Or.inl hc, Category.id_comp _⟩,
        hEtHom _, hw⟩
    · let Wz : Y.Opens := U ⊓ ⟨Zᶜ, hZ.isOpen_compl⟩
      have hWz : Wz ≤ U := inf_le_left
      have hxW : ((wcZarToEt Y).obj U).hom x ∈ Wz := ⟨hmem U x, hxZ⟩
      obtain ⟨w, hw⟩ := hpt Wz U hWz x hxW
      refine ⟨_, (wcZarToEt Y).map (homOfLE hWz), w,
        ⟨_, 𝟙 _, (wcZarToEt Y).map (homOfLE hWz), Or.inr ?_, Category.id_comp _⟩,
        hEtHom _, hw⟩
      intro p
      exact (hmem Wz p).2

theorem wc_opens_sheaf_glue_of_local_agree : ∀ (X : Type u) [TopologicalSpace X]
    (F : (TopologicalSpace.Opens X)ᵒᵖ ⥤ AddCommGrpCat.{v}),
    Presheaf.IsSheaf (Opens.grothendieckTopology X) F →
    ∀ (k : ℕ) (A : Fin k → TopologicalSpace.Opens X), (∀ x : X, ∃ i, x ∈ A i) →
    ∀ (a : ∀ i, F.obj (Opposite.op (A i))),
    (∀ i j, ∀ x ∈ A i ⊓ A j, ∃ (W : TopologicalSpace.Opens X) (h : W ≤ A i ⊓ A j), x ∈ W ∧
      F.map (homOfLE h).op (F.map (homOfLE inf_le_left).op (a i) -
        F.map (homOfLE inf_le_right).op (a j)) = 0) →
    ∃ s : F.obj (Opposite.op ⊤), ∀ i, F.map (homOfLE le_top).op s = a i :=
by
  intro X _ F hF k A hcov a hLA

  obtain ⟨pt, D1, D2⟩ : ∃ pt : ∀ {M : AddCommGrpCat.{v}}, M → (AddCommGrpCat.of (ULift.{v} ℤ) ⟶ M),
      (∀ {M : AddCommGrpCat.{v}} (m : M), pt m (ULift.up 1 : ULift.{v} ℤ) = m) ∧
      (∀ {M N : AddCommGrpCat.{v}} (m : M) (f : M ⟶ N), pt m ≫ f = pt (f m)) := by
    refine ⟨fun {M} m => AddCommGrpCat.ofHom
      ((zmultiplesHom M m).comp AddEquiv.ulift.toAddMonoidHom), ?_, ?_⟩
    · intro M m
      simp only [AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_comp, Function.comp_apply,
        zmultiplesHom_apply]
      change (1 : ℤ) • m = m
      exact one_smul ℤ m
    · intro M N m f
      ext ⟨n⟩
      simp

  have T1 : ∀ {U V W : TopologicalSpace.Opens X} (hVU : V ≤ U) (hWV : W ≤ V)
      (c : F.obj (Opposite.op U)),
      F.map (homOfLE hWV).op (F.map (homOfLE hVU).op c) =
        F.map (homOfLE (hWV.trans hVU)).op c := by
    intro U V W hVU hWV c
    rw [← ConcreteCategory.comp_apply, ← F.map_comp, ← op_comp]
    rfl

  have loc : ∀ (U : TopologicalSpace.Opens X) (r : F.obj (Opposite.op U)),
      (∀ x ∈ U, ∃ (W : TopologicalSpace.Opens X) (h : W ≤ U), x ∈ W ∧
        F.map (homOfLE h).op r = 0) → r = 0 := by
    intro U r hr
    let S : Sieve U :=
      { arrows := fun V f => F.map f.op r = 0
        downward_closed := by
          intro V W f hf g
          change F.map (g ≫ f).op r = 0
          rw [op_comp, F.map_comp, ConcreteCategory.comp_apply]
          change F.map g.op (F.map f.op r) = 0
          rw [show F.map f.op r = 0 from hf, map_zero] }
    have hS : S ∈ Opens.grothendieckTopology X U := by
      rw [Opens.mem_grothendieckTopology]
      intro x hx
      obtain ⟨W, h, hxW, h0⟩ := hr x hx
      exact ⟨W, homOfLE h, h0, hxW⟩
    have key := hF.hom_ext ⟨S, hS⟩ (pt r) (pt 0) (fun I => by
      rw [D2, D2, map_zero]
      have h0 : F.map I.f.op r = 0 := I.hf
      rw [h0])
    have h3 : (pt r) (ULift.up 1 : ULift.{v} ℤ) = (pt (0 : F.obj (Opposite.op U)))
        (ULift.up 1 : ULift.{v} ℤ) := by rw [key]
    rw [D1, D1] at h3
    exact h3

  have hC : ∀ i j, F.map (homOfLE (inf_le_left : A i ⊓ A j ≤ A i)).op (a i) =
      F.map (homOfLE (inf_le_right : A i ⊓ A j ≤ A j)).op (a j) := by
    intro i j
    exact sub_eq_zero.mp (loc _ _ (hLA i j))

  have K : ∀ (V : TopologicalSpace.Opens X) (i j : Fin k) (hi : V ≤ A i) (hj : V ≤ A j),
      F.map (homOfLE hi).op (a i) = F.map (homOfLE hj).op (a j) := by
    intro V i j hi hj
    calc F.map (homOfLE hi).op (a i)
        = F.map (homOfLE (le_inf hi hj)).op
            (F.map (homOfLE (inf_le_left : A i ⊓ A j ≤ A i)).op (a i)) := (T1 _ _ _).symm
      _ = F.map (homOfLE (le_inf hi hj)).op
            (F.map (homOfLE (inf_le_right : A i ⊓ A j ≤ A j)).op (a j)) := by rw [hC i j]
      _ = F.map (homOfLE hj).op (a j) := T1 _ _ _

  let T : Sieve (⊤ : TopologicalSpace.Opens X) :=
    { arrows := fun V _ => ∃ i, V ≤ A i
      downward_closed := by
        rintro V W f ⟨i, hi⟩ g
        exact ⟨i, (leOfHom g).trans hi⟩ }
  have hT : T ∈ Opens.grothendieckTopology X ⊤ := by
    rw [Opens.mem_grothendieckTopology]
    intro x _
    obtain ⟨i, hi⟩ := hcov x
    exact ⟨A i, homOfLE le_top, ⟨i, le_rfl⟩, hi⟩
  let S : (Opens.grothendieckTopology X).Cover ⊤ := ⟨T, hT⟩
  have hI : ∀ I : S.Arrow, ∃ i, I.Y ≤ A i := fun I => I.hf
  choose ι hι using hI
  let x : ∀ I : S.Arrow, AddCommGrpCat.of (ULift.{v} ℤ) ⟶ F.obj (Opposite.op I.Y) :=
    fun I => pt (F.map (homOfLE (hι I)).op (a (ι I)))
  have hx : ∀ ⦃I₁ I₂ : S.Arrow⦄ (r : I₁.Relation I₂),
      x I₁ ≫ F.map r.g₁.op = x I₂ ≫ F.map r.g₂.op := by
    intro I₁ I₂ r
    show pt (F.map (homOfLE (hι I₁)).op (a (ι I₁))) ≫ F.map r.g₁.op =
      pt (F.map (homOfLE (hι I₂)).op (a (ι I₂))) ≫ F.map r.g₂.op
    rw [D2, D2]
    refine congrArg _ ?_
    rw [show r.g₁ = homOfLE (leOfHom r.g₁) from Subsingleton.elim _ _,
      show r.g₂ = homOfLE (leOfHom r.g₂) from Subsingleton.elim _ _, T1, T1]
    exact K _ _ _ _ _
  refine ⟨hF.amalgamate S x hx (ULift.up 1 : ULift.{v} ℤ), fun i => ?_⟩
  let I0 : S.Arrow := ⟨A i, homOfLE le_top, ⟨i, le_rfl⟩⟩
  have h1 := hF.amalgamate_map S x hx I0
  have hid : F.map (homOfLE (le_refl (A i))).op (a i) = a i := by
    rw [show homOfLE (le_refl (A i)) = 𝟙 (A i) from Subsingleton.elim _ _, op_id, F.map_id]
    rfl
  have h2 : x I0 = pt (a i) :=
    congrArg (@pt (F.obj (Opposite.op (A i))))
      ((K (A i) (ι I0) i (hι I0) le_rfl).trans hid)
  rw [h2] at h1
  have h3 : (hF.amalgamate S x hx ≫ F.map (homOfLE (le_top : A i ≤ ⊤)).op)
      (ULift.up 1 : ULift.{v} ℤ) = (pt (a i)) (ULift.up 1 : ULift.{v} ℤ) := by
    rw [← h1]
    try rfl
  rw [ConcreteCategory.comp_apply, D1] at h3
  exact h3

theorem wc_zariski_spectral_trace_gluing : ∀ (R : Type u) [CommRing R] (Y : Scheme.{u})
    (fY : Y ⟶ Spec (.of R)) [QuasiCompact fY] [QuasiSeparated fY] (Z : Set Y), IsClosed Z →
    (∀ y : Y, IsConnected (closure {y} ∩ Z)) →
    ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, wcZarGlueMod Y Zᶜ G :=
by
  intro R _ Y fY _ _ Z hZ hconn G
  classical
  unfold wcZarGlueMod
  intro k O hcov b hcompat

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace fY
  haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated fY
  obtain ⟨hcont, ⟨hT⟩, -⟩ := wc_zarToEt_props Y
  haveI := hcont
  have hF : Presheaf.IsSheaf (Opens.grothendieckTopology Y) ((wcZarToEt Y).op ⋙ G.obj) :=
    Functor.op_comp_isSheaf _ _ _ G

  have hrr : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V)
      (c : G.obj.obj (Opposite.op ((wcZarToEt Y).obj U))),
      G.obj.map ((wcZarToEt Y).map (homOfLE h2)).op
        (G.obj.map ((wcZarToEt Y).map (homOfLE h1)).op c) =
      G.obj.map ((wcZarToEt Y).map (homOfLE (h2.trans h1))).op c := by
    intro U V W h1 h2 c
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, ← Functor.map_comp]
    rfl
  have hagree : ∀ {U₁ U₂ W W' : Y.Opens} (hU : W ≤ U₁) (hV : W ≤ U₂) (hW : W' ≤ W)
      (c₁ : G.obj.obj (Opposite.op ((wcZarToEt Y).obj U₁)))
      (c₂ : G.obj.obj (Opposite.op ((wcZarToEt Y).obj U₂))),
      G.obj.map ((wcZarToEt Y).map (homOfLE hU)).op c₁ =
        G.obj.map ((wcZarToEt Y).map (homOfLE hV)).op c₂ →
      G.obj.map ((wcZarToEt Y).map (homOfLE (hW.trans hU))).op c₁ =
        G.obj.map ((wcZarToEt Y).map (homOfLE (hW.trans hV))).op c₂ := by
    intro U₁ U₂ W W' hU hV hW c₁ c₂ h
    rw [← hrr hU hW, ← hrr hV hW, h]

  let N : Fin k → Fin k → Set Y := fun i j =>
    {x | ∃ (W : Y.Opens) (hU : W ≤ O i) (hV : W ≤ O j), x ∈ W ∧
      G.obj.map ((wcZarToEt Y).map (homOfLE hU)).op (b i) =
        G.obj.map ((wcZarToEt Y).map (homOfLE hV)).op (b j)}
  have hNo : ∀ i j, IsOpen (N i j) := by
    intro i j
    rw [isOpen_iff_forall_mem_open]
    rintro x ⟨W, hU, hV, hx, heq⟩
    exact ⟨W, fun y hy => ⟨W, hU, hV, hy, heq⟩, W.isOpen, hx⟩
  have hNrefl : ∀ i, (O i : Set Y) ⊆ N i i := fun i x hx => ⟨O i, le_rfl, le_rfl, hx, rfl⟩
  have hNsymm : ∀ i j, N i j ⊆ N j i := by
    rintro i j x ⟨W, hU, hV, hx, heq⟩
    exact ⟨W, hV, hU, hx, heq.symm⟩
  have hNtrans : ∀ i j l, N i j ∩ N j l ⊆ N i l := by
    rintro i j l x ⟨⟨W₁, hU₁, hV₁, hx₁, heq₁⟩, ⟨W₂, hU₂, hV₂, hx₂, heq₂⟩⟩
    refine ⟨W₁ ⊓ W₂, inf_le_left.trans hU₁, inf_le_right.trans hV₂, ⟨hx₁, hx₂⟩, ?_⟩
    have e1 := hagree hU₁ hV₁ (inf_le_left : W₁ ⊓ W₂ ≤ W₁) (b i) (b j) heq₁
    have e2 := hagree hU₂ hV₂ (inf_le_right : W₁ ⊓ W₂ ≤ W₂) (b j) (b l) heq₂
    exact e1.trans e2

  have hH : ∀ i j, Z ∩ ((O i : Set Y) ∩ O j) ⊆ N i j := by
    rintro i j z ⟨hzZ, hzi, hzj⟩
    obtain ⟨W, h, hzW, h0⟩ := (wc_zar_supp_iff_local_vanishing Y G Z hZ (O i ⊓ O j) _).mp
      (hcompat i j) z ⟨hzi, hzj⟩ hzZ
    refine ⟨W, h.trans inf_le_left, h.trans inf_le_right, hzW, ?_⟩
    rw [map_sub, hrr, hrr, sub_eq_zero] at h0
    exact h0

  have hZc : IsCompact Z := hZ.isCompact
  have hcovZ : ∀ z ∈ Z, ∃ i, z ∈ O i := fun z hz => hcov z (fun h => h hz)
  have hloc : ∀ z : Z, ∃ (i : Fin k) (U : Set Y), IsOpen U ∧ IsCompact U ∧ z.1 ∈ U ∧
      U ⊆ O i := by
    intro z
    obtain ⟨i, hi⟩ := hcovZ z.1 z.2
    obtain ⟨U, ⟨hUo, hUc⟩, hzU, hUO⟩ :=
      PrespectralSpace.isTopologicalBasis.exists_subset_of_mem_open hi (O i).isOpen
    exact ⟨i, U, hUo, hUc, hzU, hUO⟩
  choose ι U hUo hUc hzU hUO using hloc
  obtain ⟨t, ht⟩ := hZc.elim_finite_subcover (fun z : Z => U z) (fun z => hUo z)
    (fun z hz => Set.mem_iUnion.mpr ⟨⟨z, hz⟩, hzU ⟨z, hz⟩⟩)
  let O' : Fin k → Set Y := fun i => ⋃ z ∈ t.filter (fun z => ι z = i), U z
  have hO'o : ∀ i, IsOpen (O' i) ∧ IsCompact (O' i) := fun i =>
    ⟨isOpen_biUnion (fun z _ => hUo z),
      (t.filter (fun z => ι z = i)).isCompact_biUnion (fun z _ => hUc z)⟩
  have hO'O : ∀ i, O' i ⊆ O i := by
    intro i x hx
    simp only [O', Set.mem_iUnion] at hx
    obtain ⟨z, hz, hxz⟩ := hx
    have hi := (Finset.mem_filter.mp hz).2
    rw [← hi]
    exact hUO z hxz
  have hO'cov : ∀ z ∈ Z, ∃ i, z ∈ O' i := by
    intro z hz
    have h1 := ht hz
    simp only [Set.mem_iUnion] at h1
    obtain ⟨z', hz't, hzz'⟩ := h1
    refine ⟨ι z', ?_⟩
    simp only [O', Set.mem_iUnion]
    exact ⟨z', Finset.mem_filter.mpr ⟨hz't, rfl⟩, hzz'⟩

  obtain ⟨A, hAo, hAO', hAcov, hAN⟩ := wc_spectral_trace_shrinking Y Z hZ hconn k O' N hO'o
    hO'cov hNo (fun i => (hO'O i).trans (hNrefl i)) hNsymm hNtrans
    (fun i j z hz => hH i j ⟨hz.1, hO'O i hz.2.1, hO'O j hz.2.2⟩)
  have hAO : ∀ i, A i ⊆ O i := fun i => (hAO' i).trans (hO'O i)
  let A' : Fin k → Y.Opens := fun i => ⟨A i, hAo i⟩
  have hA'O : ∀ i, A' i ≤ O i := fun i => hAO i

  obtain ⟨s, hs⟩ := wc_opens_sheaf_glue_of_local_agree Y ((wcZarToEt Y).op ⋙ G.obj) hF k A'
    hAcov (fun i => G.obj.map ((wcZarToEt Y).map (homOfLE (hA'O i))).op (b i)) (by
      intro i j x hx
      obtain ⟨W, hU, hV, hxW, heq⟩ := hAN i j ⟨hx.1, hx.2⟩
      refine ⟨W ⊓ (A' i ⊓ A' j), inf_le_right, ⟨hxW, hx⟩, ?_⟩
      simp only [Functor.comp_map, Functor.op_map, Quiver.Hom.unop_op, map_sub, hrr]
      rw [sub_eq_zero]
      exact hagree hU hV (inf_le_left : W ⊓ (A' i ⊓ A' j) ≤ W) (b i) (b j) heq)

  refine ⟨G.obj.map (hT.from (Scheme.Etale.mk (𝟙 Y))).op s, fun i g => ?_⟩
  have hg : G.obj.map g.op (G.obj.map (hT.from (Scheme.Etale.mk (𝟙 Y))).op s) =
      G.obj.map ((wcZarToEt Y).map (homOfLE (le_top : O i ≤ ⊤))).op s := by
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp,
      hT.hom_ext (g ≫ hT.from _) ((wcZarToEt Y).map (homOfLE le_top))]

  refine (wc_zar_supp_iff_local_vanishing Y G Z hZ (O i) _).mpr ?_
  intro z hzO hzZ
  obtain ⟨m, hzA⟩ := hAcov z
  obtain ⟨W₁, hU₁, hV₁, hzW₁, heq₁⟩ := hH i m ⟨hzZ, hzO, hAO m hzA⟩
  refine ⟨W₁ ⊓ A' m, inf_le_left.trans hU₁, ⟨hzW₁, hzA⟩, ?_⟩
  rw [hg, map_sub, hrr, sub_eq_zero]
  have hsm : G.obj.map ((wcZarToEt Y).map (homOfLE (le_top : A' m ≤ ⊤))).op s =
      G.obj.map ((wcZarToEt Y).map (homOfLE (hA'O m))).op (b m) := hs m
  calc G.obj.map ((wcZarToEt Y).map (homOfLE ((inf_le_left.trans hU₁).trans
          (le_top : O i ≤ ⊤)))).op s
      = G.obj.map ((wcZarToEt Y).map (homOfLE (inf_le_right : W₁ ⊓ A' m ≤ A' m))).op
          (G.obj.map ((wcZarToEt Y).map (homOfLE (le_top : A' m ≤ ⊤))).op s) :=
        (hrr (le_top : A' m ≤ ⊤) (inf_le_right : W₁ ⊓ A' m ≤ A' m) s).symm
    _ = G.obj.map ((wcZarToEt Y).map (homOfLE (inf_le_right : W₁ ⊓ A' m ≤ A' m))).op
          (G.obj.map ((wcZarToEt Y).map (homOfLE (hA'O m))).op (b m)) := by rw [hsm]
    _ = G.obj.map ((wcZarToEt Y).map (homOfLE (inf_le_left.trans hU₁))).op (b i) :=
        (hrr (hA'O m) (inf_le_right : W₁ ⊓ A' m ≤ A' m) (b m)).trans
          (hagree hV₁ hU₁ (inf_le_left : W₁ ⊓ A' m ≤ W₁) (b m) (b i) heq₁.symm)

theorem wc_pullback_quot_affine_sections : ∀ (A : Type u) [CommRing A] (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) (J : Ideal A) (V : R.Opens), IsAffineOpen V → Function.Surjective ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))).app V).hom ∧ ∀ x : Γ(R, V), ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)))).app V).hom x = 0 ↔ x ∈ Ideal.map ((R.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) J :=
by
  intro A _ R g J V hV
  set φV : A →+* Γ(R, V) := (R.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp
    (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) with hφV
  set q := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) with hq
  haveI hqc : IsClosedImmersion q :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

  have s1 : hV.fromSpec ≫ g = Spec.map (CommRingCat.ofHom φV) := by
    have h := IsAffineOpen.SpecMap_appLE_fromSpec g (isAffineOpen_top (Spec (.of A))) hV le_top
    rw [← h, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp]
    rfl

  have s2 : ∀ (C : Type u) [CommRing C] (m : Γ(R, V) →+* C) (k : Spec (.of C) ⟶ R),
      k = Spec.map (CommRingCat.ofHom m) ≫ hV.fromSpec → ∀ y : Γ(R, V),
      (k.app V).hom y = 0 → m y = 0 := by
    intro C _ m k hk y hy
    subst hk
    have gen : ∀ (h : Spec (.of C) ⟶ Spec Γ(R, V)) (W : (Spec Γ(R, V)).Opens) (i : W ≤ ⊤)
        (e : (⊤ : (Spec (.of C)).Opens) ≤ h ⁻¹ᵁ W),
        (Spec Γ(R, V)).presheaf.map (homOfLE i).op ≫ h.app W ≫
          (Spec (.of C)).presheaf.map (homOfLE e).op = h.appTop := by
      intro h W i e
      rw [← Scheme.Hom.appLE, Scheme.Hom.map_appLE]
      rfl
    have e : (⊤ : (Spec (.of C)).Opens) ≤
        (Spec.map (CommRingCat.ofHom m) ≫ hV.fromSpec) ⁻¹ᵁ V := by
      rw [Scheme.Hom.comp_preimage, hV.fromSpec_preimage_self]; exact le_rfl
    have key : (Spec.map (CommRingCat.ofHom m) ≫ hV.fromSpec).app V ≫
        (Spec (.of C)).presheaf.map (homOfLE e).op =
        CommRingCat.ofHom m ≫ (Scheme.ΓSpecIso (.of C)).inv := by
      rw [Scheme.ΓSpecIso_inv_naturality, Scheme.Hom.comp_app, hV.fromSpec_app_self,
        ← gen (Spec.map (CommRingCat.ofHom m)) (hV.fromSpec ⁻¹ᵁ V) le_top e]
      simp only [Category.assoc]
      rfl
    have h2 := congrArg (fun φ => φ.hom y) key
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, hy, map_zero,
      CommRingCat.hom_ofHom] at h2
    have h3 := congrArg (Scheme.ΓSpecIso (.of C)).hom.hom h2
    rw [map_zero, Iso.inv_hom_id_apply] at h3
    exact h3.symm
  refine ⟨Scheme.Hom.app_surjective _ V hV, fun x => ⟨fun hx => ?_, fun hx => ?_⟩⟩
  ·
    let I := Ideal.map φV J
    let π : Γ(R, V) →+* Γ(R, V) ⧸ I := Ideal.Quotient.mk I
    let ψ : A ⧸ J →+* Γ(R, V) ⧸ I := Ideal.quotientMap I φV Ideal.le_comap_map
    have hcomp : ψ.comp (Ideal.Quotient.mk J) = π.comp φV :=
      Ideal.quotientMap_comp_mk Ideal.le_comap_map
    have w : (Spec.map (CommRingCat.ofHom π) ≫ hV.fromSpec) ≫ g =
        Spec.map (CommRingCat.ofHom ψ) ≫ q := by
      rw [Category.assoc, s1, hq, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← CommRingCat.ofHom_comp, hcomp]
    have hk : Limits.pullback.lift _ _ w ≫ Limits.pullback.fst g q =
        Spec.map (CommRingCat.ofHom π) ≫ hV.fromSpec := Limits.pullback.lift_fst _ _ _
    have h : ((Limits.pullback.lift _ _ w ≫ Limits.pullback.fst g q).app V).hom x =
        ((Limits.pullback.lift _ _ w).app (Limits.pullback.fst g q ⁻¹ᵁ V)).hom
          (((Limits.pullback.fst g q).app V).hom x) := by
      rw [Scheme.Hom.comp_app]; rfl
    rw [hx, map_zero] at h
    exact Ideal.Quotient.eq_zero_iff_mem.mp (s2 _ π _ hk x h)
  ·
    have hle : Ideal.map φV J ≤ RingHom.ker ((Limits.pullback.fst g q).app V).hom := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have e1 : (Ideal.Quotient.mk J) a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
      show ((Limits.pullback.fst g q).app V).hom ((R.presheaf.map (homOfLE le_top).op).hom
        (g.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a))) = 0
      rw [← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply]
      have h0 : ((Limits.pullback.fst g q).app ⊤).hom
          (g.appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a)) = 0 := by
        have hc := congrArg (fun φ => (Scheme.Hom.appTop φ).hom
          ((Scheme.ΓSpecIso (.of A)).inv.hom a)) (Limits.pullback.condition (f := g) (g := q))
        simp only [Scheme.Hom.comp_appTop, CommRingCat.comp_apply] at hc
        change ((Limits.pullback.fst g q).appTop).hom _ = 0
        rw [hc, ← CommRingCat.comp_apply ((Scheme.ΓSpecIso (.of A)).inv), hq,
          ← Scheme.ΓSpecIso_inv_naturality, CommRingCat.comp_apply]
        simp [e1]
      rw [h0, map_zero]
    exact RingHom.mem_ker.mp (hle hx)

theorem wc_noeth_span_finite_subfamily : ∀ (B S : Type u) [CommRing B] [IsNoetherianRing B] [CommRing S] (χ : B →+* S) (N₀ : AddSubgroup S), (∀ (b : B) (w : S), w ∈ N₀ → χ b * w ∈ N₀) → ∀ {ι : Type u} (F : ι → S) (k : ℕ) (c : Fin k → S), (∀ i, ∃ (b : Fin k → B) (w : S), w ∈ N₀ ∧ F i = ∑ l, χ (b l) * c l + w) → ∃ (m : ℕ) (s : Fin m → ι), ∀ i, ∃ (b : Fin m → B) (w : S), w ∈ N₀ ∧ F i = ∑ j, χ (b j) * F (s j) + w :=
by
  classical
  intro B S _ _ _ χ N₀ hN ι F k c hF
  choose β w hw hFeq using hF
  have key : ∃ (m : ℕ) (s : Fin m → ι),
      ∀ i, β i ∈ Submodule.span B (Set.range (fun j => β (s j))) := by
    let 𝒜 : Set (Submodule B (Fin k → B)) :=
      {N | ∃ (m : ℕ) (s : Fin m → ι), N = Submodule.span B (Set.range (fun j => β (s j)))}
    have hne : 𝒜.Nonempty := ⟨_, 0, Fin.elim0, rfl⟩
    obtain ⟨M', hM', hmax⟩ :=
      (set_has_maximal_iff_noetherian (R := B) (M := Fin k → B)).mpr inferInstance 𝒜 hne
    obtain ⟨m₀, s₀, rfl⟩ := hM'
    refine ⟨m₀, s₀, fun i => ?_⟩
    have hle : Submodule.span B (Set.range (fun j => β (s₀ j))) ≤
        Submodule.span B (Set.range (fun j => β ((Fin.cons i s₀ : Fin (m₀ + 1) → ι) j))) := by
      apply Submodule.span_mono
      rintro _ ⟨j, rfl⟩
      exact ⟨j.succ, by simp⟩
    have heq := eq_of_le_of_not_lt hle (hmax _ ⟨m₀ + 1, Fin.cons i s₀, rfl⟩)
    rw [heq]
    exact Submodule.subset_span ⟨0, by simp⟩
  obtain ⟨m, s, hs⟩ := key
  refine ⟨m, s, fun i => ?_⟩
  obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp (hs i)
  have hcoord : ∀ l, β i l = ∑ j, a j * β (s j) l := by
    intro l
    rw [← ha, Finset.sum_apply]
    simp [smul_eq_mul]
  have h5 : ∑ l, χ (β i l) * c l = ∑ j, χ (a j) * (∑ l, χ (β (s j) l) * c l) := by
    simp only [hcoord, map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun l _ => by ring))
  refine ⟨a, w i - ∑ j, χ (a j) * w (s j), ?_, ?_⟩
  · exact N₀.sub_mem (hw i) (N₀.sum_mem (fun j _ => hN _ _ (hw (s j))))
  · have hFs : ∑ j, χ (a j) * F (s j) =
        ∑ j, χ (a j) * (∑ l, χ (β (s j) l) * c l) + ∑ j, χ (a j) * w (s j) := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun j _ => by rw [hFeq (s j), mul_add])
    rw [hFs, ← h5, hFeq i]
    abel

theorem wc_struct_mod_coh : ∀ (X : Scheme.{u}), wcCoherentMod (wcStructMod X) :=
by
  intro X
  refine ⟨fun U hU f => ⟨fun s => ?_, fun t ht => ?_⟩, fun U hU => ?_⟩
  · haveI := hU.isLocalization_basicOpen f
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj f (show Γ(X, X.basicOpen f) from s)
    refine ⟨n, a, ?_⟩
    change (algebraMap Γ(X, U) Γ(X, X.basicOpen f) f) ^ n * (show Γ(X, X.basicOpen f) from s) =
      algebraMap Γ(X, U) Γ(X, X.basicOpen f) a
    rw [mul_comm]
    exact ha
  · haveI := hU.isLocalization_basicOpen f
    have ht' : algebraMap Γ(X, U) Γ(X, X.basicOpen f) (show Γ(X, U) from t) = 0 := ht
    obtain ⟨⟨m, hm⟩, hmt⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers f) _ (show Γ(X, U) from t)).mp ht'
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff m f).mp hm
    exact ⟨n, hmt⟩
  · exact Module.Finite.self Γ(X, U)

theorem wc_modules_ses_left_exact : ∀ (X : Scheme.{u}) (S : ShortComplex X.Modules), S.ShortExact → (∀ U : X.Opens, Function.Injective (Scheme.Modules.Hom.app S.f U)) ∧ ∀ (U : X.Opens) (y : Γ(S.X₂, U)), Scheme.Modules.Hom.app S.g U y = 0 → ∃ x, Scheme.Modules.Hom.app S.f U x = y :=
by
  intro X S hS
  refine ⟨fun U => ?_, fun U y hy => ?_⟩
  · exact (AddCommGrpCat.mono_iff_injective _).mp
      (@Functor.map_mono _ _ _ _
        (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
          (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U))
        inferInstance _ _ S.f hS.mono_f)
  · letI : (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
        (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U) :
          X.Modules ⥤ AddCommGrpCat.{u}).PreservesZeroMorphisms :=
      ⟨fun _ _ => Scheme.Modules.Hom.zero_app⟩
    have hE := hS.exact.map_of_mono_of_preservesKernel
      (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
        (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U))
      hS.mono_f (@Limits.PreservesLimitsOfShape.preservesLimit _ _ _ _ _ _
        (SheafOfModules.toSheaf X.ringCatSheaf ⋙ sheafToPresheaf _ _ ⋙
          (evaluation _ AddCommGrpCat.{u}).obj (Opposite.op U))
        (Limits.PreservesFiniteLimits.preservesFiniteLimits Limits.WalkingParallelPair) _)
    obtain ⟨x, hx⟩ := (ShortComplex.ab_exact_iff _).mp hE y hy
    exact ⟨x, hx⟩

theorem wc_modules_epi_local_lift : ∀ (X : Scheme.{u}) (M N : X.Modules) (g : M ⟶ N), Epi g → ∀ (V : X.Opens) (t : Γ(N, V)) (x : X), x ∈ V → ∃ (W : X.Opens) (hWV : W ≤ V) (s : Γ(M, W)), x ∈ W ∧ Scheme.Modules.Hom.app g W s = N.presheaf.map (homOfLE hWV).op t :=
by
  intro X M N g hg V t x hx
  have F1 : ∀ (V₁ V₂ V₃ : X.Opens) (h₁ : V₂ ≤ V₁) (h₂ : V₃ ≤ V₂) (a : Γ(N, V₁)),
      N.presheaf.map (homOfLE h₂).op (N.presheaf.map (homOfLE h₁).op a) =
        N.presheaf.map (homOfLE (le_trans h₂ h₁)).op a := by
    intro V₁ V₂ V₃ h₁ h₂ a
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have F2 : ∀ (W W' : X.Opens) (h : W' ≤ W) (s : Γ(M, W)),
      Scheme.Modules.Hom.app g W' (M.presheaf.map (homOfLE h).op s) =
        N.presheaf.map (homOfLE h).op (Scheme.Modules.Hom.app g W s) :=
    fun W W' h s => NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf g) (homOfLE h).op s
  let L : ∀ V : X.Opens, Γ(N, V) → Prop := fun V t => ∀ x : X, x ∈ V →
    ∃ (W : X.Opens) (hWV : W ≤ V) (s : Γ(M, W)), x ∈ W ∧
      Scheme.Modules.Hom.app g W s = N.presheaf.map (homOfLE hWV).op t
  have h0 : ∀ V : X.Opens, L V 0 := by
    intro V x hx
    exact ⟨V, le_rfl, 0, hx, by rw [map_zero, map_zero]⟩
  have hadd : ∀ (V : X.Opens) (t₁ t₂ : Γ(N, V)), L V t₁ → L V t₂ → L V (t₁ + t₂) := by
    intro V t₁ t₂ h₁ h₂ x hx
    obtain ⟨W₁, hW₁, s₁, hx₁, e₁⟩ := h₁ x hx
    obtain ⟨W₂, hW₂, s₂, hx₂, e₂⟩ := h₂ x hx
    refine ⟨W₁ ⊓ W₂, le_trans inf_le_left hW₁,
      M.presheaf.map (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op s₁ +
        M.presheaf.map (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op s₂, ⟨hx₁, hx₂⟩, ?_⟩
    rw [map_add, F2, F2, e₁, e₂, F1, F1, map_add]
  have hsmul : ∀ (V : X.Opens) (r : Γ(X, V)) (t : Γ(N, V)), L V t → L V (r • t) := by
    intro V r t ht x hx
    obtain ⟨W, hW, s, hxW, e⟩ := ht x hx
    refine ⟨W, hW, X.presheaf.map (homOfLE hW).op r • s, hxW, ?_⟩
    rw [Scheme.Modules.Hom.app_smul, e, Scheme.Modules.map_smul]
  have hres : ∀ (V V' : X.Opens) (h : V' ≤ V) (t : Γ(N, V)), L V t →
      L V' (N.presheaf.map (homOfLE h).op t) := by
    intro V V' h t ht x hx
    obtain ⟨W, hW, s, hxW, e⟩ := ht x (h hx)
    refine ⟨W ⊓ V', inf_le_right, M.presheaf.map (homOfLE (inf_le_left : W ⊓ V' ≤ W)).op s,
      ⟨hxW, hx⟩, ?_⟩
    rw [F2, e, F1, F1]
  have hloc : ∀ (V : X.Opens) (t : Γ(N, V)), (∀ x : X, x ∈ V → ∃ (V' : X.Opens) (h : V' ≤ V),
      x ∈ V' ∧ L V' (N.presheaf.map (homOfLE h).op t)) → L V t := by
    intro V t H x hx
    obtain ⟨V', h, hxV', hL⟩ := H x hx
    obtain ⟨W, hW, s, hxW, e⟩ := hL x hxV'
    exact ⟨W, le_trans hW h, s, hxW, by rw [e, F1]⟩
  have himg : ∀ (V : X.Opens) (s : Γ(M, V)), L V (Scheme.Modules.Hom.app g V s) := by
    intro V s x hx
    refine ⟨V, le_rfl, s, hx, ?_⟩
    rw [show (homOfLE (le_rfl : V ≤ V)) = 𝟙 V from rfl, op_id, CategoryTheory.Functor.map_id]
    rfl
  let S : ∀ V : (X.Opens)ᵒᵖ, Submodule Γ(X, V.unop) Γ(N, V.unop) := fun V =>
    { carrier := {t | L V.unop t}
      zero_mem' := h0 _
      add_mem' := fun {a b} ha hb => hadd _ a b ha hb
      smul_mem' := fun r t ht => hsmul _ r t ht }
  have hmap : ∀ {V V' : (X.Opens)ᵒᵖ} (f : V ⟶ V'),
      S V ≤ Submodule.comap (N.val.restrictₛₗ f) (S V') := by
    intro V V' f t ht
    exact hres V.unop V'.unop (leOfHom f.unop) t ht
  let P₀ : N.val.Submodule := PresheafOfModules.Submodule.mk (M := N.val) S hmap
  let P : SheafOfModules.Submodule (R := X.ringCatSheaf) N := SheafOfModules.Submodule.mk P₀ (by
    intro U s hs
    rw [Opens.mem_grothendieckTopology] at hs
    apply hloc U.unop s
    intro x hx
    obtain ⟨V', f, hf, hxV'⟩ := hs x hx
    exact ⟨V', leOfHom f, hxV', hf⟩)
  haveI : Mono P.ι := SheafOfModules.Submodule.instMonoι P
  let ι : (P.toSheafOfModules : X.Modules) ⟶ N := P.ι
  haveI : @Mono X.Modules _ _ _ ι := SheafOfModules.Submodule.instMonoι P
  have hepi : @Epi X.Modules _ _ _ ι := by
    refine (Preadditive.epi_iff_cancel_zero (C := X.Modules) ι).mpr ?_
    intro R h hh
    have hgh : g ≫ h = 0 := by
      apply Scheme.Modules.hom_ext
      intro W
      apply AddCommGrpCat.ext
      intro s
      have hs : Scheme.Modules.Hom.app g W s ∈ P.obj (Opposite.op W) := himg W s
      have e1 : Scheme.Modules.Hom.app (g ≫ h) W s =
          Scheme.Modules.Hom.app (ι ≫ h) W (show Γ(P.toSheafOfModules, W) from ⟨_, hs⟩) := rfl
      have e2 := congrArg (fun φ => Scheme.Modules.Hom.app φ W
        (show Γ(P.toSheafOfModules, W) from ⟨_, hs⟩)) hh
      refine e1.trans (e2.trans ?_)
      rfl
    exact (Preadditive.epi_iff_cancel_zero g).mp hg R h hgh
  haveI := hepi
  have hiso : @IsIso X.Modules _ _ _ ι := isIso_of_mono_of_epi _
  let eI : (P.toSheafOfModules : X.Modules) ≅ N := @asIso X.Modules _ _ _ ι hiso
  have key : Scheme.Modules.Hom.app ι V (Scheme.Modules.Hom.app eI.inv V t) = t := by
    have e := congrArg (fun φ => Scheme.Modules.Hom.app φ V t) eI.inv_hom_id
    exact e
  have htL : L V t := by
    have hpm : (Scheme.Modules.Hom.app ι V) (Scheme.Modules.Hom.app eI.inv V t) ∈
        P.obj (Opposite.op V) :=
      (show ↥(P.obj (Opposite.op V)) from Scheme.Modules.Hom.app eI.inv V t).2
    rw [key] at hpm
    exact hpm
  exact htL x hx

theorem wc_qcoh_standard_cover_cech_h1 : ∀ (X : Scheme.{u}) (M : X.Modules) (U : X.Opens), IsAffineOpen U → (∀ (V : X.Opens) (hVU : V ≤ U), IsAffineOpen V → ∀ k : Γ(X, U), (∀ e : Γ(M, V ⊓ X.basicOpen k), ∃ (n : ℕ) (w : Γ(M, V)), (X.presheaf.map (homOfLE (le_trans inf_le_left hVU : V ⊓ X.basicOpen k ≤ U)).op k) ^ n • e = M.presheaf.map (homOfLE (inf_le_left : V ⊓ X.basicOpen k ≤ V)).op w) ∧ (∀ z : Γ(M, V), M.presheaf.map (homOfLE (inf_le_left : V ⊓ X.basicOpen k ≤ V)).op z = 0 → ∃ n : ℕ, (X.presheaf.map (homOfLE hVU).op k) ^ n • z = 0)) → ∀ (m : ℕ) (f : Fin m → Γ(X, U)), (∀ x : X, x ∈ U → ∃ i, x ∈ X.basicOpen (f i)) → ∀ e : (∀ p : Fin m × Fin m, Γ(M, X.basicOpen (f p.1) ⊓ X.basicOpen (f p.2))), (∀ i j k : Fin m, M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤ X.basicOpen (f i) ⊓ X.basicOpen (f j))).op (e (i, j)) + M.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤ X.basicOpen (f j) ⊓ X.basicOpen (f k))).op (e (j, k)) = M.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤ X.basicOpen (f i) ⊓ X.basicOpen (f k))).op (e (i, k))) → ∃ w : (∀ i : Fin m, Γ(M, X.basicOpen (f i))), ∀ i j : Fin m, e (i, j) = M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤ X.basicOpen (f i))).op (w i) - M.presheaf.map (homOfLE (inf_le_right : X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤ X.basicOpen (f j))).op (w j) :=
by
  classical
  intro X M U hU hQ m f hcov e hcoc

  have hMr : ∀ {W W' W'' : X.Opens} (h1 : W' ≤ W) (h2 : W'' ≤ W') (h3 : W'' ≤ W) (x : Γ(M, W)),
      M.presheaf.map (homOfLE h2).op (M.presheaf.map (homOfLE h1).op x) =
        M.presheaf.map (homOfLE h3).op x := by
    intro W W' W'' h1 h2 h3 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hXr : ∀ {W W' W'' : X.Opens} (h1 : W' ≤ W) (h2 : W'' ≤ W') (h3 : W'' ≤ W) (x : Γ(X, W)),
      X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op x) =
        X.presheaf.map (homOfLE h3).op x := by
    intro W W' W'' h1 h2 h3 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hsm : ∀ {W W' : X.Opens} (h : W' ≤ W) (r : Γ(X, W)) (x : Γ(M, W)),
      M.presheaf.map (homOfLE h).op (r • x) =
        X.presheaf.map (homOfLE h).op r • M.presheaf.map (homOfLE h).op x :=
    fun h r x => Scheme.Modules.map_smul M (homOfLE h) r x
  have hD : ∀ i, X.basicOpen (f i) ≤ U := fun i => X.basicOpen_le (f i)

  choose n a' hna using fun p : Fin m × Fin m =>
    (hQ (X.basicOpen (f p.1)) (hD p.1) (hU.basicOpen (f p.1)) (f p.2)).1 (e p)
  obtain ⟨N, hnN⟩ : ∃ N : ℕ, ∀ p, n p ≤ N :=
    ⟨∑ p, n p, fun p => Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ p)⟩
  obtain ⟨a, ha⟩ : ∃ a : ∀ p : Fin m × Fin m, Γ(M, X.basicOpen (f p.1)), ∀ p,
      M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f p.1) ⊓ X.basicOpen (f p.2) ≤
        X.basicOpen (f p.1))).op (a p) =
      (X.presheaf.map (homOfLE (le_trans inf_le_left (hD p.1) :
        X.basicOpen (f p.1) ⊓ X.basicOpen (f p.2) ≤ U)).op (f p.2)) ^ N • e p := by
    refine ⟨fun p => (X.presheaf.map (homOfLE (hD p.1)).op (f p.2)) ^ (N - n p) • a' p,
      fun p => ?_⟩
    rw [hsm, map_pow, hXr _ _ (le_trans inf_le_left (hD p.1)), ← hna, smul_smul,
      pow_sub_mul_pow _ (hnN p)]

  obtain ⟨z, hz⟩ : ∃ z : ∀ t : Fin m × Fin m × Fin m,
      Γ(M, X.basicOpen (f t.1) ⊓ X.basicOpen (f t.2.1)), ∀ t, z t =
      M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f t.1) ⊓ X.basicOpen (f t.2.1) ≤
        X.basicOpen (f t.1))).op (a (t.1, t.2.2)) -
      M.presheaf.map (homOfLE (inf_le_right : X.basicOpen (f t.1) ⊓ X.basicOpen (f t.2.1) ≤
        X.basicOpen (f t.2.1))).op (a (t.2.1, t.2.2)) -
      (X.presheaf.map (homOfLE (le_trans inf_le_left (hD t.1) :
        X.basicOpen (f t.1) ⊓ X.basicOpen (f t.2.1) ≤ U)).op (f t.2.2)) ^ N • e (t.1, t.2.1) :=
    ⟨_, fun t => rfl⟩
  have hz0 : ∀ t : Fin m × Fin m × Fin m,
      M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f t.1) ⊓ X.basicOpen (f t.2.1) ⊓
        X.basicOpen (f t.2.2) ≤ X.basicOpen (f t.1) ⊓ X.basicOpen (f t.2.1))).op (z t) = 0 := by
    rintro ⟨i, j, k⟩
    have H : X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤ U :=
      le_trans inf_le_left (le_trans inf_le_left (hD i))
    have e1 : M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓
          X.basicOpen (f k) ≤ X.basicOpen (f i) ⊓ X.basicOpen (f j))).op
          (M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤
            X.basicOpen (f i))).op (a (i, k))) =
        M.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right :
          X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤
            X.basicOpen (f i) ⊓ X.basicOpen (f k))).op
          (M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓ X.basicOpen (f k) ≤
            X.basicOpen (f i))).op (a (i, k))) := by
      rw [hMr _ _ (le_trans inf_le_left (inf_le_left : X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤
        X.basicOpen (f i))), hMr]
    have e2 : M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓
          X.basicOpen (f k) ≤ X.basicOpen (f i) ⊓ X.basicOpen (f j))).op
          (M.presheaf.map (homOfLE (inf_le_right : X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤
            X.basicOpen (f j))).op (a (j, k))) =
        M.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right :
          X.basicOpen (f i) ⊓ X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤
            X.basicOpen (f j) ⊓ X.basicOpen (f k))).op
          (M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f j) ⊓ X.basicOpen (f k) ≤
            X.basicOpen (f j))).op (a (j, k))) := by
      rw [hMr _ _ (le_trans inf_le_left (inf_le_right : X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤
        X.basicOpen (f j))), hMr]
    have hzijk := hz (i, j, k)
    simp only at hzijk
    rw [hzijk, map_sub, map_sub, e1, e2, ha (i, k), ha (j, k), hsm, hsm, hsm, map_pow, map_pow,
      map_pow, hXr _ _ H, hXr _ _ H, hXr _ _ H, ← hcoc i j k, smul_add]
    abel
  have hij : ∀ i j : Fin m, IsAffineOpen (X.basicOpen (f i) ⊓ X.basicOpen (f j)) := by
    intro i j
    rw [← Scheme.basicOpen_mul]
    exact hU.basicOpen _
  choose q hq using fun t : Fin m × Fin m × Fin m =>
    (hQ (X.basicOpen (f t.1) ⊓ X.basicOpen (f t.2.1)) (le_trans inf_le_left (hD t.1))
      (hij t.1 t.2.1) (f t.2.2)).2 (z t) (hz0 t)
  obtain ⟨P', hqP⟩ : ∃ P' : ℕ, ∀ t, q t ≤ P' :=
    ⟨∑ t, q t, fun t => Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ t)⟩
  have hzP : ∀ t : Fin m × Fin m × Fin m,
      (X.presheaf.map (homOfLE (le_trans inf_le_left (hD t.1) :
        X.basicOpen (f t.1) ⊓ X.basicOpen (f t.2.1) ≤ U)).op (f t.2.2)) ^ P' • z t = 0 := by
    intro t
    rw [← pow_sub_mul_pow _ (hqP t), mul_smul, hq t, smul_zero]
  obtain ⟨b, hb⟩ : ∃ b : ∀ p : Fin m × Fin m, Γ(M, X.basicOpen (f p.1)), ∀ i j k : Fin m,
      M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤
        X.basicOpen (f i))).op (b (i, k)) -
      M.presheaf.map (homOfLE (inf_le_right : X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤
        X.basicOpen (f j))).op (b (j, k)) =
      (X.presheaf.map (homOfLE (le_trans inf_le_left (hD i) :
        X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤ U)).op (f k)) ^ (P' + N) • e (i, j) := by
    refine ⟨fun p => (X.presheaf.map (homOfLE (hD p.1)).op (f p.2)) ^ P' • a p,
      fun i j k => ?_⟩
    have hzijk := hz (i, j, k)
    have hzP' := hzP (i, j, k)
    simp only at hzijk hzP'
    have hdiff := sub_eq_iff_eq_add.mp hzijk.symm
    rw [hsm, hsm, map_pow, map_pow, hXr _ _ (le_trans inf_le_left (hD i)),
      hXr _ _ (le_trans inf_le_left (hD i)), ← smul_sub, hdiff,
      smul_add, smul_smul, ← pow_add, hzP', zero_add]

  have hspan : Ideal.span (Set.range f) = ⊤ := by
    rw [← hU.iSup_basicOpen_eq_self_iff]
    apply le_antisymm
    · exact iSup_le (by rintro ⟨_, i, rfl⟩; exact X.basicOpen_le (f i))
    · intro x hx
      obtain ⟨i, hi⟩ := hcov x hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f i, i, rfl⟩, hi⟩
  have hpow : Ideal.span (Set.range (fun k => f k ^ (P' + N))) = ⊤ := by
    have h := Ideal.span_pow_eq_top _ hspan (P' + N)
    rwa [← Set.range_comp] at h
  have h1 : (1 : Γ(X, U)) ∈ Ideal.span (Set.range (fun k => f k ^ (P' + N))) := by
    rw [hpow]; exact Submodule.mem_top
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1

  refine ⟨fun i => ∑ k, X.presheaf.map (homOfLE (hD i)).op (c k) • b (i, k), fun i j => ?_⟩
  have hterm : ∀ k : Fin m,
      M.presheaf.map (homOfLE (inf_le_left : X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤
        X.basicOpen (f i))).op (X.presheaf.map (homOfLE (hD i)).op (c k) • b (i, k)) -
      M.presheaf.map (homOfLE (inf_le_right : X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤
        X.basicOpen (f j))).op (X.presheaf.map (homOfLE (hD j)).op (c k) • b (j, k)) =
      X.presheaf.map (homOfLE (le_trans inf_le_left (hD i) :
        X.basicOpen (f i) ⊓ X.basicOpen (f j) ≤ U)).op (c k * f k ^ (P' + N)) • e (i, j) := by
    intro k
    rw [hsm, hsm, hXr _ _ (le_trans inf_le_left (hD i)), hXr _ _ (le_trans inf_le_left (hD i)),
      ← smul_sub, hb i j k, smul_smul, map_mul, map_pow]
  simp only
  rw [map_sum, map_sum, ← Finset.sum_sub_distrib, Finset.sum_congr rfl (fun k _ => hterm k),
    ← Finset.sum_smul, ← map_sum, hc, map_one, one_smul]

theorem wc_modules_glue_of_cech_h1 : ∀ (X : Scheme.{u}) (S : ShortComplex X.Modules), (∀ V : X.Opens, Function.Injective (Scheme.Modules.Hom.app S.f V)) → (∀ (V : X.Opens) (y : Γ(S.X₂, V)), Scheme.Modules.Hom.app S.g V y = 0 → ∃ x, Scheme.Modules.Hom.app S.f V x = y) → ∀ (U : X.Opens) (m : ℕ) (D : Fin m → X.Opens) (hD : ∀ i, D i ≤ U), (∀ x : X, x ∈ U → ∃ i, x ∈ D i) → (∀ e : (∀ p : Fin m × Fin m, Γ(S.X₁, D p.1 ⊓ D p.2)), (∀ i j k : Fin m, S.X₁.presheaf.map (homOfLE (inf_le_left : D i ⊓ D j ⊓ D k ≤ D i ⊓ D j)).op (e (i, j)) + S.X₁.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : D i ⊓ D j ⊓ D k ≤ D j ⊓ D k)).op (e (j, k)) = S.X₁.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : D i ⊓ D j ⊓ D k ≤ D i ⊓ D k)).op (e (i, k))) → ∃ w : (∀ i : Fin m, Γ(S.X₁, D i)), ∀ i j : Fin m, e (i, j) = S.X₁.presheaf.map (homOfLE (inf_le_left : D i ⊓ D j ≤ D i)).op (w i) - S.X₁.presheaf.map (homOfLE (inf_le_right : D i ⊓ D j ≤ D j)).op (w j)) → ∀ (t : Γ(S.X₃, U)) (s : ∀ i : Fin m, Γ(S.X₂, D i)), (∀ i, Scheme.Modules.Hom.app S.g (D i) (s i) = S.X₃.presheaf.map (homOfLE (hD i)).op t) → ∃ s₀ : Γ(S.X₂, U), Scheme.Modules.Hom.app S.g U s₀ = t :=
by
  intro X S hinj hex U m D hD hcov hH1 t s hs
  have hN : ∀ {M N : X.Modules} (φ : M ⟶ N) {W W' : X.Opens} (hle : W' ≤ W) (x : Γ(M, W)),
      Scheme.Modules.Hom.app φ W' (M.presheaf.map (homOfLE hle).op x) =
        N.presheaf.map (homOfLE hle).op (Scheme.Modules.Hom.app φ W x) :=
    fun φ _ _ hle x =>
      NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf φ) (homOfLE hle).op x
  have hR : ∀ (M : X.Modules) {W W' W'' : X.Opens} (h1 : W' ≤ W) (h2 : W'' ≤ W') (x : Γ(M, W)),
      M.presheaf.map (homOfLE h2).op (M.presheaf.map (homOfLE h1).op x) =
        M.presheaf.map (homOfLE (h2.trans h1)).op x := by
    intro M W W' W'' h1 h2 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hZ : ∀ (V : X.Opens) (x : Γ(S.X₁, V)),
      Scheme.Modules.Hom.app S.g V (Scheme.Modules.Hom.app S.f V x) = 0 := by
    intro V x
    rw [← ConcreteCategory.comp_apply, ← Scheme.Modules.Hom.comp_app, S.zero,
      Scheme.Modules.Hom.zero_app]
    rfl
  let d : ∀ p : Fin m × Fin m, Γ(S.X₂, D p.1 ⊓ D p.2) := fun p =>
    S.X₂.presheaf.map (homOfLE (inf_le_left : D p.1 ⊓ D p.2 ≤ D p.1)).op (s p.1) -
      S.X₂.presheaf.map (homOfLE (inf_le_right : D p.1 ⊓ D p.2 ≤ D p.2)).op (s p.2)
  have hd : ∀ p, Scheme.Modules.Hom.app S.g (D p.1 ⊓ D p.2) (d p) = 0 := by
    intro p
    simp only [d, map_sub, hN, hs, hR]
    exact sub_self _
  choose e he using fun p => hex _ (d p) (hd p)
  have hcoc : ∀ i j k : Fin m, S.X₁.presheaf.map (homOfLE (inf_le_left : D i ⊓ D j ⊓ D k ≤ D i ⊓ D j)).op (e (i, j)) + S.X₁.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : D i ⊓ D j ⊓ D k ≤ D j ⊓ D k)).op (e (j, k)) = S.X₁.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : D i ⊓ D j ⊓ D k ≤ D i ⊓ D k)).op (e (i, k)) := by
    intro i j k
    apply hinj
    simp only [map_add, hN]
    have h1 : Scheme.Modules.Hom.app S.f (D i ⊓ D j) (e (i, j)) = d (i, j) := he (i, j)
    have h2 : Scheme.Modules.Hom.app S.f (D j ⊓ D k) (e (j, k)) = d (j, k) := he (j, k)
    have h3 : Scheme.Modules.Hom.app S.f (D i ⊓ D k) (e (i, k)) = d (i, k) := he (i, k)
    rw [h1, h2, h3]
    simp only [d, map_sub, hR]
    abel
  obtain ⟨w, hw⟩ := hH1 e hcoc
  let s' : ∀ i, Γ(S.X₂, D i) := fun i => s i - Scheme.Modules.Hom.app S.f (D i) (w i)
  have hcompat : TopCat.Presheaf.IsCompatible S.X₂.presheaf D s' := by
    intro i j
    have h1 : Scheme.Modules.Hom.app S.f _ (e (i, j)) = d (i, j) := he (i, j)
    rw [hw i j, map_sub, hN, hN] at h1
    simp only [s', map_sub]
    rw [sub_eq_sub_iff_sub_eq_sub]
    exact h1.symm
  have hU : U ≤ iSup D := by
    intro x hx
    exact TopologicalSpace.Opens.mem_iSup.mpr (hcov x hx)
  obtain ⟨s₀, hs₀, -⟩ := TopCat.Sheaf.existsUnique_gluing'
    (⟨S.X₂.presheaf, S.X₂.isSheaf⟩ : TopCat.Sheaf Ab X) D U (fun i => homOfLE (hD i)) hU s' hcompat
  have hs₀' : ∀ i, S.X₂.presheaf.map (homOfLE (hD i)).op s₀ = s' i := hs₀
  refine ⟨s₀, ?_⟩
  apply TopCat.Sheaf.eq_of_locally_eq' (⟨S.X₃.presheaf, S.X₃.isSheaf⟩ : TopCat.Sheaf Ab X) D U
    (fun i => homOfLE (hD i)) hU
  intro i
  change S.X₃.presheaf.map (homOfLE (hD i)).op (Scheme.Modules.Hom.app S.g U s₀) =
    S.X₃.presheaf.map (homOfLE (hD i)).op t
  rw [← hN, hs₀' i]
  simp only [s', map_sub, hZ, hs, sub_zero]

theorem wc_modules_ses_affine_surj : ∀ (X : Scheme.{u}) (S : ShortComplex X.Modules), S.ShortExact → wcQcoh S.X₁ → ∀ U : X.Opens, IsAffineOpen U → Function.Surjective (Scheme.Modules.Hom.app S.g U) :=
by
  intro X S hS hq U hU t
  haveI : Epi S.g := hS.epi_g
  obtain ⟨hinj, hex⟩ := wc_modules_ses_left_exact X S hS

  have s4 : ∀ (P : X.Opens → Prop), (∀ W W' : X.Opens, W' ≤ W → P W → P W') →
      (∀ x : X, x ∈ U → ∃ W : X.Opens, W ≤ U ∧ x ∈ W ∧ P W) →
      ∃ (m : ℕ) (f : Fin m → Γ(X, U)), (∀ x : X, x ∈ U → ∃ i, x ∈ X.basicOpen (f i)) ∧
        ∀ i, P (X.basicOpen (f i)) := by
    intro P hPmono hPloc
    have hW : ∀ x : U, ∃ h : Γ(X, U), (x : X) ∈ X.basicOpen h ∧ P (X.basicOpen h) := by
      intro x
      obtain ⟨W, _, hxW, hPW⟩ := hPloc x.1 x.2
      obtain ⟨h, hle, hxh⟩ := hU.exists_basicOpen_le (V := W) ⟨x.1, hxW⟩ x.2
      exact ⟨h, hxh, hPmono _ _ hle hPW⟩
    choose h hxh hPh using hW
    obtain ⟨t, ht⟩ := hU.isCompact.elim_finite_subcover (fun x : U => (X.basicOpen (h x) : Set X))
      (fun _ => (X.basicOpen _).isOpen) (fun y hy => Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hxh ⟨y, hy⟩⟩)
    let e := t.equivFin
    refine ⟨t.card, fun i => h (e.symm i).1, ?_, fun i => hPh _⟩
    intro x hx
    have hx' := ht hx
    simp only [Set.mem_iUnion] at hx'
    obtain ⟨y, hy, hxy⟩ := hx'
    refine ⟨e ⟨y, hy⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hxy

  have s3a : ∀ (V : X.Opens) (hVU : V ≤ U), IsAffineOpen V → ∀ k : Γ(X, U),
      (∀ e : Γ(S.X₁, V ⊓ X.basicOpen k), ∃ (n : ℕ) (w : Γ(S.X₁, V)),
        (X.presheaf.map (homOfLE (le_trans inf_le_left hVU : V ⊓ X.basicOpen k ≤ U)).op k) ^ n • e
          = S.X₁.presheaf.map (homOfLE (inf_le_left : V ⊓ X.basicOpen k ≤ V)).op w) ∧
      (∀ z : Γ(S.X₁, V), S.X₁.presheaf.map (homOfLE (inf_le_left : V ⊓ X.basicOpen k ≤ V)).op z = 0 →
        ∃ n : ℕ, (X.presheaf.map (homOfLE hVU).op k) ^ n • z = 0) := by
    intro V hVU hV k
    obtain ⟨hq1, hq2⟩ := hq V hV (X.presheaf.map (homOfLE hVU).op k)
    have hres : X.presheaf.map (homOfLE (X.basicOpen_le (X.presheaf.map (homOfLE hVU).op k))).op
        (X.presheaf.map (homOfLE hVU).op k) =
        X.presheaf.map (homOfLE (le_trans (X.basicOpen_le _) hVU)).op k := by
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
      rfl
    have aux : ∀ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U),
        W = X.basicOpen (X.presheaf.map (homOfLE hVU).op k) →
        (∀ e : Γ(S.X₁, W), ∃ (n : ℕ) (w : Γ(S.X₁, V)),
          (X.presheaf.map (homOfLE hWU).op k) ^ n • e = S.X₁.presheaf.map (homOfLE hWV).op w) ∧
        (∀ z : Γ(S.X₁, V), S.X₁.presheaf.map (homOfLE hWV).op z = 0 →
          ∃ n : ℕ, (X.presheaf.map (homOfLE hVU).op k) ^ n • z = 0) := by
      rintro W hWV hWU rfl
      refine ⟨fun e => ?_, fun z hz => hq2 z hz⟩
      obtain ⟨n, w, hw⟩ := hq1 e
      refine ⟨n, w, ?_⟩
      rw [← hres]
      exact hw
    exact aux (V ⊓ X.basicOpen k) inf_le_left (le_trans inf_le_left hVU)
      (Scheme.basicOpen_res X k (homOfLE hVU).op).symm

  let P : X.Opens → Prop := fun W => ∃ (hWU : W ≤ U) (s : Γ(S.X₂, W)),
    Scheme.Modules.Hom.app S.g W s = S.X₃.presheaf.map (homOfLE hWU).op t
  have hPmono : ∀ W W' : X.Opens, W' ≤ W → P W → P W' := by
    rintro W W' hle ⟨hWU, s, hs⟩
    refine ⟨le_trans hle hWU, S.X₂.presheaf.map (homOfLE hle).op s, ?_⟩
    have e1 : Scheme.Modules.Hom.app S.g W' (S.X₂.presheaf.map (homOfLE hle).op s) =
        S.X₃.presheaf.map (homOfLE hle).op (Scheme.Modules.Hom.app S.g W s) :=
      NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf S.g) (homOfLE hle).op s
    rw [e1, hs, ← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hPloc : ∀ x : X, x ∈ U → ∃ W : X.Opens, W ≤ U ∧ x ∈ W ∧ P W := by
    intro x hx
    obtain ⟨W, hWU, s, hxW, hs⟩ := wc_modules_epi_local_lift X S.X₂ S.X₃ S.g inferInstance U t x hx
    exact ⟨W, hWU, hxW, hWU, s, hs⟩
  obtain ⟨m, f, hcov, hP⟩ := s4 P hPmono hPloc
  choose hle s hs using hP
  have hH1 := wc_qcoh_standard_cover_cech_h1 X S.X₁ U hU s3a m f hcov
  exact wc_modules_glue_of_cech_h1 X S hinj hex U m (fun i => X.basicOpen (f i))
    (fun i => X.basicOpen_le (f i)) hcov hH1 t s hs

theorem wc_cech_h01_two_of_three : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)) (r : ℕ) (V : Fin r → X.Opens) (S : ShortComplex X.Modules), (∀ U : X.Opens, Function.Injective (Scheme.Modules.Hom.app S.f U)) → (∀ (U : X.Opens) (y : Γ(S.X₂, U)), Scheme.Modules.Hom.app S.g U y = 0 → ∃ x, Scheme.Modules.Hom.app S.f U x = y) → (∀ i, Function.Surjective (Scheme.Modules.Hom.app S.g (V i))) → (wcCechH01FG B X h S.X₁ r V → wcCechH01FG B X h S.X₃ r V → wcCechH01FG B X h S.X₂ r V) ∧ (wcCechH01FG B X h S.X₂ r V → wcCechH01FG B X h S.X₃ r V → wcCechH01FG B X h S.X₁ r V) :=
by
  intro B _ _ X h r V S hinj hex hsurj
  classical



  have L1 : ∀ (M Q : Type u) [AddCommGroup M] [Module B M] [AddCommGroup Q] [Module B Q]
      (g : M →ₗ[B] Q) (Z : Submodule B M) (R : Submodule B Q) (k : ℕ) (c : Fin k → Q),
      (∀ z ∈ Z, g z ∈ Submodule.span B (Set.range c) ⊔ R) →
      ∃ (m : ℕ) (e : Fin m → M), (∀ j, e j ∈ Z) ∧
        ∀ z ∈ Z, ∃ (β : Fin m → B) (ρ : Q), ρ ∈ R ∧ g z = ∑ j, β j • g (e j) + ρ := by
    intro M Q _ _ _ _ g Z R k c hZ
    have hT : ((Submodule.span B (Set.range c)).map R.mkQ).FG :=
      (Submodule.fg_span (Set.finite_range c)).map _
    have hle : Z.map (R.mkQ ∘ₗ g) ≤ (Submodule.span B (Set.range c)).map R.mkQ := by
      rintro _ ⟨z, hz, rfl⟩
      obtain ⟨t, ht, ρ, hρ, he⟩ := Submodule.mem_sup.mp (hZ z hz)
      refine ⟨t, ht, ?_⟩
      have h0 : R.mkQ ρ = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]; exact hρ
      rw [LinearMap.comp_apply, ← he, map_add, h0, add_zero]
    obtain ⟨m, s, hs⟩ := Submodule.fg_iff_exists_fin_generating_family.mp (hT.of_le hle)
    have hsN : ∀ j, s j ∈ Z.map (R.mkQ ∘ₗ g) := fun j => hs ▸ Submodule.subset_span ⟨j, rfl⟩
    choose e he hes using fun j => Submodule.mem_map.mp (hsN j)
    refine ⟨m, e, he, fun z hz => ?_⟩
    have hzN : R.mkQ (g z) ∈ Submodule.span B (Set.range s) := by
      rw [hs]; exact ⟨z, hz, rfl⟩
    obtain ⟨β, hβ⟩ := (Submodule.mem_span_range_iff_exists_fun B).mp hzN
    refine ⟨β, g z - ∑ j, β j • g (e j), ?_, by abel⟩
    have h1 : R.mkQ (g z - ∑ j, β j • g (e j)) = 0 := by
      rw [map_sub, map_sum, ← hβ]
      simp only [LinearMap.map_smul]
      rw [sub_eq_zero]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← hes j, LinearMap.comp_apply]
    rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h1
  have span_sum : ∀ {N : Type u} [AddCommGroup N] [Module B N] {k : ℕ} (c : Fin k → N)
      (b : Fin k → B), ∑ l, b l • c l ∈ Submodule.span B (Set.range c) :=
    fun c b => (Submodule.mem_span_range_iff_exists_fun B).mpr ⟨b, rfl⟩



  have dirA : ∀ (A₀ A₁ A₂ C₀ C₁ C₂ D₀ D₁ D₂ : Type u) [AddCommGroup A₀] [Module B A₀] [AddCommGroup A₁] [Module B A₁] [AddCommGroup A₂] [Module B A₂] [AddCommGroup C₀] [Module B C₀] [AddCommGroup C₁] [Module B C₁] [AddCommGroup C₂] [Module B C₂] [AddCommGroup D₀] [Module B D₀] [AddCommGroup D₁] [Module B D₁] [AddCommGroup D₂] [Module B D₂] (dA₀ : A₀ →ₗ[B] A₁) (dA₁ : A₁ →ₗ[B] A₂) (dC₀ : C₀ →ₗ[B] C₁) (dC₁ : C₁ →ₗ[B] C₂) (dD₀ : D₀ →ₗ[B] D₁) (dD₁ : D₁ →ₗ[B] D₂) (f₀ : A₀ →ₗ[B] C₀) (f₁ : A₁ →ₗ[B] C₁) (f₂ : A₂ →ₗ[B] C₂) (g₀ : C₀ →ₗ[B] D₀) (g₁ : C₁ →ₗ[B] D₁) (g₂ : C₂ →ₗ[B] D₂), (∀ x, f₁ (dA₀ x) = dC₀ (f₀ x)) → (∀ x, f₂ (dA₁ x) = dC₁ (f₁ x)) → (∀ x, g₁ (dC₀ x) = dD₀ (g₀ x)) → (∀ x, g₂ (dC₁ x) = dD₁ (g₁ x)) → (∀ x, dC₁ (dC₀ x) = 0) → (∀ x, g₁ (f₁ x) = 0) → Function.Injective f₀ → Function.Injective f₁ → Function.Injective f₂ → (∀ y, g₀ y = 0 → ∃ x, f₀ x = y) → (∀ y, g₁ y = 0 → ∃ x, f₁ x = y) → Function.Surjective g₀ → ((∃ (k : ℕ) (c : Fin k → A₀), ∀ z, dA₀ z = 0 → ∃ b : Fin k → B, z = ∑ l, b l • c l) ∧ (∃ (k : ℕ) (c : Fin k → A₁), ∀ z, dA₁ z = 0 → ∃ (b : Fin k → B) (w : A₀), z = ∑ l, b l • c l + dA₀ w)) → ((∃ (k : ℕ) (c : Fin k → D₀), ∀ z, dD₀ z = 0 → ∃ b : Fin k → B, z = ∑ l, b l • c l) ∧ (∃ (k : ℕ) (c : Fin k → D₁), ∀ z, dD₁ z = 0 → ∃ (b : Fin k → B) (w : D₀), z = ∑ l, b l • c l + dD₀ w)) → ((∃ (k : ℕ) (c : Fin k → C₀), ∀ z, dC₀ z = 0 → ∃ b : Fin k → B, z = ∑ l, b l • c l) ∧ (∃ (k : ℕ) (c : Fin k → C₁), ∀ z, dC₁ z = 0 → ∃ (b : Fin k → B) (w : C₀), z = ∑ l, b l • c l + dC₀ w)) := by
    intro A₀ A₁ A₂ C₀ C₁ C₂ D₀ D₁ D₂ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ dA₀ dA₁ dC₀ dC₁ dD₀ dD₁
      f₀ f₁ f₂ g₀ g₁ g₂ H1 H2 H3 H4 H5 H6 H7 H8 H9 H10 H11 H12 hA hD
    obtain ⟨⟨kA0, cA0, HA0⟩, ⟨kA1, cA1, HA1⟩⟩ := hA
    obtain ⟨⟨kD0, cD0, HD0⟩, ⟨kD1, cD1, HD1⟩⟩ := hD
    constructor
    · obtain ⟨m, e, he, hL⟩ := L1 C₀ D₀ g₀ (LinearMap.ker dC₀) ⊥ kD0 cD0 (by
        intro z hz
        rw [LinearMap.mem_ker] at hz
        obtain ⟨b, hb⟩ := HD0 (g₀ z) (by rw [← H3, hz, map_zero])
        rw [hb]; exact Submodule.mem_sup_left (span_sum cD0 b))
      have he' : ∀ j, dC₀ (e j) = 0 := fun j => LinearMap.mem_ker.mp (he j)
      refine ⟨m + kA0, Fin.append e (fun l => f₀ (cA0 l)), fun z hz => ?_⟩
      obtain ⟨β, ρ, hρ, hgz⟩ := hL z (LinearMap.mem_ker.mpr hz)
      rw [Submodule.mem_bot] at hρ
      subst hρ
      obtain ⟨a, ha⟩ := H10 (z - ∑ j, β j • e j) (by
        rw [map_sub, map_sum, hgz, add_zero]; simp only [map_smul, sub_self])
      have hda : dA₀ a = 0 := by
        apply H8
        rw [H1, ha, map_zero, map_sub, map_sum, hz]
        simp only [map_smul, he', smul_zero, Finset.sum_const_zero, sub_zero]
      obtain ⟨b, hb⟩ := HA0 a hda
      refine ⟨Fin.append β b, ?_⟩
      rw [Fin.sum_univ_add]
