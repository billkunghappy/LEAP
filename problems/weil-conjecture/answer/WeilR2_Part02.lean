theorem wc_descent_rep_matches_near_geom_point : (∀ {P E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (a b : P ⟶ E), a ≫ e = b ≫ e → ∀ (Ω : Type u) [Field Ω] (π : Spec (.of Ω) ⟶ P), π ≫ a = π ≫ b → ∃ U : P.Opens, π (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ a = U.ι ≫ b) → ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ρ : wcEtTransport p J G) (b : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))) (Ω : Type u) [Field Ω] (O : Y.Etale) (V₀ : X.Etale) (h : O.left ⟶ V₀.left) (hh : h ≫ V₀.hom = O.hom ≫ p) (η : J.obj.obj (Opposite.op V₀)) (d : O ⟶ Scheme.Etale.mk (𝟙 Y)), G.obj.map d.op b = ρ.ρ V₀ O h hh η → ∀ (o : Spec (.of Ω) ⟶ O.left) (W : X.Etale) (φ : W ⟶ V₀) (v : Spec (.of Ω) ⟶ W.left), v ≫ φ.left = o ≫ h → ∀ (z : Spec (.of Ω) ⟶ ((wcEtBaseChange p).obj W).left), z ≫ Limits.pullback.fst W.hom p = v → z ≫ Limits.pullback.snd W.hom p = o ≫ O.hom → ∀ e : (wcEtBaseChange p).obj W ⟶ Scheme.Etale.mk (𝟙 Y), ∃ (V₁ : Y.Etale) (c : V₁ ⟶ (wcEtBaseChange p).obj W), z (IsLocalRing.closedPoint Ω) ∈ Set.range c.left ∧ G.obj.map c.op (G.obj.map e.op b - ρ.ρ W ((wcEtBaseChange p).obj W) (Limits.pullback.fst W.hom p) Limits.pullback.condition (J.obj.map φ.op η)) = 0 :=
by
  intro S5 X Y p J G ρ b Ω _ O V₀ h hh η d Hb o W φ v Hv z Hz1 Hz2 e
  classical
  have hleft : ∀ {S : Scheme.{u}} {Z : S.Etale} (a : Z ⟶ Scheme.Etale.mk (𝟙 S)), a.left = Z.hom :=
    fun a => (Category.comp_id a.left).symm.trans (MorphismProperty.Over.w a)
  have hterm : ∀ {S : Scheme.{u}} {Z : S.Etale} (a b : Z ⟶ Scheme.Etale.mk (𝟙 S)), a = b :=
    fun a b => MorphismProperty.Over.Hom.ext ((hleft a).trans (hleft b).symm)
  have hmc : ∀ {S : Scheme.{u}} (F : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
      {A B C : S.Etale} (f : B ⟶ A) (g : C ⟶ B) (t : F.obj.obj (Opposite.op A)),
      F.obj.map (g ≫ f).op t = F.obj.map g.op (F.obj.map f.op t) := by
    intro S F A B C f g t
    rw [op_comp, Functor.map_comp]
    rfl
  have hid : ∀ {S : Scheme.{u}} (F : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
      {A : S.Etale} (t : F.obj.obj (Opposite.op A)), F.obj.map (𝟙 A).op t = t := by
    intro S F A t
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  haveI : Etale W.hom := W.prop
  haveI : Etale O.hom := O.prop
  haveI : Etale V₀.hom := V₀.prop
  have e2 : Limits.pullback.fst W.hom p ≫ W.hom = Limits.pullback.snd W.hom p ≫ p :=
    Limits.pullback.condition
  have PC : Limits.pullback.fst (Limits.pullback.snd W.hom p) O.hom ≫ Limits.pullback.snd W.hom p
      = Limits.pullback.snd (Limits.pullback.snd W.hom p) O.hom ≫ O.hom :=
    Limits.pullback.condition
  let P₀' : Y.Etale := Scheme.Etale.mk
    (Limits.pullback.fst (Limits.pullback.snd W.hom p) O.hom ≫ Limits.pullback.snd W.hom p)
  let π : Spec (.of Ω) ⟶ Limits.pullback (Limits.pullback.snd W.hom p) O.hom :=
    Limits.pullback.lift z o Hz2
  have hπ1 : π ≫ Limits.pullback.fst (Limits.pullback.snd W.hom p) O.hom = z :=
    Limits.pullback.lift_fst _ _ _
  have hπ2 : π ≫ Limits.pullback.snd (Limits.pullback.snd W.hom p) O.hom = o :=
    Limits.pullback.lift_snd _ _ _
  have hover : (Limits.pullback.fst (Limits.pullback.snd W.hom p) O.hom ≫
      Limits.pullback.fst W.hom p ≫ φ.left) ≫ V₀.hom =
      (Limits.pullback.snd (Limits.pullback.snd W.hom p) O.hom ≫ h) ≫ V₀.hom := by
    have e1 : φ.left ≫ V₀.hom = W.hom := MorphismProperty.Over.w φ
