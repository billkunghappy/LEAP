          have : (p₀ ≫ U'.ι) y ∈ Set.range U'.ι := ⟨p₀ y, rfl⟩
          rw [Scheme.Opens.range_ι] at this
          exact this
      · rw [hrφ]
        ext z
        simp only [D, A, Scheme.Hom.coe_preimage, Set.mem_preimage, SetLike.mem_coe,
          TopologicalSpace.Opens.mem_inf, Scheme.Hom.comp_apply]
        constructor
        · exact fun h => h.1
        · intro h
          refine ⟨h, ?_⟩
          have : W.ι (π z) ∈ Set.range W.ι := ⟨π z, rfl⟩
          rw [Scheme.Opens.range_ι] at this
          exact this
    have s_surj : ∀ (X : Scheme.{u}) (U : X.Opens) (V : Scheme.{u}) (q : V ⟶ (U : Scheme.{u})), Surjective q → ∀ (Y : Scheme.{u}) (p : Y ⟶ X) (ι : V ⟶ Y), IsFinite p → IsOpenImmersion ι → ι ≫ p = q ≫ U.ι → Set.range ι = p ⁻¹' (U : Set X) → ∃ (Y' : Scheme.{u}) (p' : Y' ⟶ X) (ι' : V ⟶ Y'), IsFinite p' ∧ Surjective p' ∧ IsOpenImmersion ι' ∧ ι' ≫ p' = q ≫ U.ι ∧ Set.range ι' = p' ⁻¹' (U : Set X) := by
      intro X U V q hq Y p ι hp hι hιp hr
      let K : TopologicalSpace.Closeds X := ⟨(U : Set X)ᶜ, U.isOpen.isClosed_compl⟩
      let I := Scheme.IdealSheafData.vanishingIdeal K
      let i := I.subschemeι
      have hri : Set.range i = (U : Set X)ᶜ := by
        rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
        rfl
      have hU : ∀ u : (U : Scheme.{u}), U.ι u ∈ U := by
        intro u
        have : U.ι u ∈ Set.range U.ι := ⟨u, rfl⟩
        rw [Scheme.Opens.range_ι] at this
        exact this
      have e_inl : ∀ y : Y, (coprod.desc p i) ((coprod.inl : Y ⟶ Y ⨿ I.subscheme) y) = p y := by
        intro y
        rw [← Scheme.Hom.comp_apply, coprod.inl_desc]
      have e_inr : ∀ z : I.subscheme,
          (coprod.desc p i) ((coprod.inr : I.subscheme ⟶ Y ⨿ I.subscheme) z) = i z := by
        intro z
        rw [← Scheme.Hom.comp_apply, coprod.inr_desc]
      have e_v : ∀ v : V, p (ι v) = U.ι (q v) := by
        intro v
        rw [← Scheme.Hom.comp_apply, hιp, Scheme.Hom.comp_apply]
      refine ⟨Y ⨿ I.subscheme, coprod.desc p i, ι ≫ coprod.inl, inferInstance, ?_, inferInstance,
        ?_, ?_⟩
      · constructor
        intro x
        by_cases hx : x ∈ U
        · have : x ∈ Set.range U.ι := by rw [Scheme.Opens.range_ι]; exact hx
          obtain ⟨u, rfl⟩ := this
          obtain ⟨v, rfl⟩ := hq.surj u
          exact ⟨(coprod.inl : Y ⟶ Y ⨿ I.subscheme) (ι v), by rw [e_inl, e_v]⟩
        · have : x ∈ Set.range i := by rw [hri]; exact hx
          obtain ⟨z, rfl⟩ := this
          exact ⟨(coprod.inr : I.subscheme ⟶ Y ⨿ I.subscheme) z, e_inr z⟩
      · rw [Category.assoc, coprod.inl_desc, hιp]
      · ext y
        simp only [Set.mem_range, Set.mem_preimage, SetLike.mem_coe]
        constructor
        · rintro ⟨v, rfl⟩
          rw [Scheme.Hom.comp_apply, e_inl, e_v]
          exact hU _
        · intro hy
          have hc := isCompl_range_inl_inr Y I.subscheme
          have hy2 : y ∈ Set.range (coprod.inl : Y ⟶ Y ⨿ I.subscheme) ⊔
              Set.range (coprod.inr : I.subscheme ⟶ Y ⨿ I.subscheme) := by
            rw [hc.sup_eq_top]; trivial
          rcases hy2 with ⟨y0, rfl⟩ | ⟨z, rfl⟩
          · rw [e_inl] at hy
            have : y0 ∈ Set.range ι := by rw [hr]; exact hy
            obtain ⟨v, rfl⟩ := this
            exact ⟨v, by rw [Scheme.Hom.comp_apply]⟩
          · rw [e_inr] at hy
            have : i z ∈ Set.range i := ⟨z, rfl⟩
            rw [hri] at this
            exact absurd hy this
    have s_core : ∀ (X : Scheme.{u}), CompactSpace X → ∀ (U : X.Opens), IsCompact (U : Set X) → ∀ (V : Scheme.{u}) (q : V ⟶ (U : Scheme.{u})), IsFinite q → (∀ (U' W : X.Opens), IsCompact (U' : Set X) → IsAffineOpen W → ∀ (Y : Scheme.{u}) (p₀ : Y ⟶ (U' : Scheme.{u})), IsFinite p₀ → ∃ (Y' : Scheme.{u}) (p₀' : Y' ⟶ ((U' ⊔ W : X.Opens) : Scheme.{u})) (j : Y ⟶ Y'), IsFinite p₀' ∧ IsOpenImmersion j ∧ j ≫ p₀' ≫ (U' ⊔ W).ι = p₀ ≫ U'.ι ∧ Set.range j = (p₀' ≫ (U' ⊔ W).ι) ⁻¹' (U' : Set X)) → ∃ (Y : Scheme.{u}) (p : Y ⟶ X) (ι : V ⟶ Y), IsFinite p ∧ IsOpenImmersion ι ∧ ι ≫ p = q ≫ U.ι ∧ Set.range ι = p ⁻¹' (U : Set X) := by
      intro X hXc U hU V q hq H
      classical
      have hW : ∀ x : X, ∃ W : X.Opens, IsAffineOpen W ∧ x ∈ W := fun x => by
        obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
        exact ⟨W, hW, hxW⟩
      choose W hWaff hxW using hW
      obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (W x : Set X))
        (fun x => (W x).isOpen.mem_nhds (hxW x))
      have Q : ∀ s : Finset X, ∀ U'' : X.Opens, U'' = U ⊔ ⨆ x ∈ s, W x →
          IsCompact (U'' : Set X) ∧ ∃ (Y : Scheme.{u}) (p₀ : Y ⟶ (U'' : Scheme.{u})) (ι : V ⟶ Y),
            IsFinite p₀ ∧ IsOpenImmersion ι ∧ ι ≫ p₀ ≫ U''.ι = q ≫ U.ι ∧
            Set.range ι = (p₀ ≫ U''.ι) ⁻¹' (U : Set X) := by
        intro s
        induction s using Finset.induction_on with
        | empty =>
          intro U'' hU''
          rw [show (⨆ x ∈ (∅ : Finset X), W x) = ⊥ by simp, sup_bot_eq] at hU''
          subst U''
          refine ⟨hU, V, q, 𝟙 V, hq, inferInstance, Category.id_comp _, ?_⟩
          ext v
          simp only [Set.mem_range, Set.mem_preimage, SetLike.mem_coe]
          constructor
          · intro _
            have : U.ι (q v) ∈ Set.range U.ι := ⟨q v, rfl⟩
            rw [Scheme.Opens.range_ι] at this
            exact this
          · intro _
            exact ⟨v, rfl⟩
        | insert a s ha ih =>
          intro U'' hU''
          have e : U'' = (U ⊔ ⨆ x ∈ s, W x) ⊔ W a := by
            rw [hU'', Finset.iSup_insert]
            ac_rfl
          subst e
          obtain ⟨hc, Y, p₀, ι, hp₀, hι, hιp, hr⟩ := ih _ rfl
          refine ⟨?_, ?_⟩
          · rw [TopologicalSpace.Opens.coe_sup]
            exact hc.union (hWaff a).isCompact
          obtain ⟨Y', p₀', j, hp₀', hj, hjp, hrj⟩ := H _ (W a) hc (hWaff a) Y p₀ hp₀
          refine ⟨Y', p₀', ι ≫ j, hp₀', inferInstance, ?_, ?_⟩
          · rw [Category.assoc, hjp, hιp]
          · have hjpt : ∀ y, ((U ⊔ ⨆ x ∈ s, W x) ⊔ W a).ι (p₀' (j y)) =
                (U ⊔ ⨆ x ∈ s, W x).ι (p₀ y) := fun y => by
              rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, ← hjp]
            ext y
            simp only [Set.mem_range, Set.mem_preimage, SetLike.mem_coe, Scheme.Hom.comp_apply]
            constructor
            · rintro ⟨v, rfl⟩
              rw [hjpt]
              have : ι v ∈ Set.range ι := ⟨v, rfl⟩
              rw [hr] at this
              exact this
            · intro hy
              have hy' : y ∈ Set.range j := by
                rw [hrj]
                exact (SetLike.le_def.mp (le_sup_left : U ≤ U ⊔ ⨆ x ∈ s, W x)) hy
              obtain ⟨y0, rfl⟩ := hy'
              rw [hjpt] at hy
              have : y0 ∈ Set.range ι := by rw [hr]; exact hy
              obtain ⟨v, rfl⟩ := this
              exact ⟨v, rfl⟩
      have htop : (⊤ : X.Opens) = U ⊔ ⨆ x ∈ t, W x := by
        refine le_antisymm ?_ le_top
        intro x _
        have hx : x ∈ ⋃ y ∈ t, (W y : Set X) := by rw [ht]; trivial
        simp only [Set.mem_iUnion] at hx
        obtain ⟨y, hy, hxy⟩ := hx
        exact (SetLike.le_def.mp (le_sup_right : (⨆ x ∈ t, W x) ≤ U ⊔ ⨆ x ∈ t, W x))
          ((SetLike.le_def.mp (le_biSup W hy)) hxy)
      obtain ⟨_, Y, p₀, ι, hp₀, hι, hιp, hr⟩ := Q t ⊤ htop
      have : IsIso (⊤ : X.Opens).ι := by rw [← Scheme.topIso_hom]; infer_instance
      exact ⟨Y, p₀ ≫ (⊤ : X.Opens).ι, ι, inferInstance, hι, hιp, hr⟩
    intro X hXc hXqs U hU V q hq hqs
    obtain ⟨Y, p, ι, hp, hι, hιp, hr⟩ := s_core X hXc U hU V q hq
      (fun U' W hU' hW Y p₀ hp₀ => s_step X hXqs U' W hU' hW Y p₀ hp₀)
    exact s_surj X U V q hqs Y p ι hp hι hιp hr

theorem wc_finite_surjective_combine : ∀ (X : Scheme.{u}) (n m : ℕ) (V : Fin n → X.Etale)
    (Yl : Fin m → Scheme.{u}) (pl : ∀ l, Yl l ⟶ X), (∀ l, IsFinite (pl l)) →
    (∀ l, Surjective (pl l)) → ∀ (kl : Fin m → ℕ) (Ol : ∀ l, Fin (kl l) → (Yl l).Opens)
    (jl : ∀ l, Fin (kl l) → Fin n) (gl : ∀ l α, ((Ol l α : Scheme.{u})) ⟶ (V (jl l α)).left),
    (∀ l α, gl l α ≫ (V (jl l α)).hom = (Ol l α).ι ≫ pl l) →
    (∀ x : X, ∃ l, ∀ y : Yl l, pl l y = x → ∃ α, y ∈ Ol l α) →
    ∃ (Y : Scheme.{u}) (p : Y ⟶ X), IsFinite p ∧ Surjective p ∧
      ∃ (k : ℕ) (O : Fin k → Y.Opens) (j : Fin k → Fin n)
        (g : ∀ α, (O α : Scheme.{u}) ⟶ (V (j α)).left),
        (∀ y : Y, ∃ α, y ∈ O α) ∧ ∀ α, g α ≫ (V (j α)).hom = (O α).ι ≫ p :=
by
  intro X n m V Yl pl hfin hsurj kl Ol jl gl hgl hcov
  classical
  have hR : ∀ (m : ℕ) (Yl : Fin m → Scheme.{u}) (pl : ∀ l, Yl l ⟶ X), (∀ l, IsFinite (pl l)) →
      (∀ l, Surjective (pl l)) → ∃ (Y : Scheme.{u}) (p : Y ⟶ X), IsFinite p ∧ Surjective p ∧
        ∀ l, ∃ q : Y ⟶ Yl l, q ≫ pl l = p := by
    intro m
    induction m with
    | zero =>
      intro Yl pl _ _
      exact ⟨X, 𝟙 X, inferInstance, inferInstance, fun l => l.elim0⟩
    | succ m ih =>
      intro Yl pl hf hs
      obtain ⟨Y', p', hp'f, hp's, hq'⟩ := ih (fun i => Yl i.castSucc) (fun i => pl i.castSucc)
        (fun i => hf _) (fun i => hs _)
      haveI := hp'f
      haveI := hp's
      haveI := hf (Fin.last m)
      haveI := hs (Fin.last m)
      refine ⟨Limits.pullback p' (pl (Fin.last m)), Limits.pullback.fst p' (pl (Fin.last m)) ≫ p',
        inferInstance, inferInstance, fun l => ?_⟩
      induction l using Fin.lastCases with
      | last => exact ⟨Limits.pullback.snd _ _, Limits.pullback.condition.symm⟩
      | cast i =>
        obtain ⟨q', hq'i⟩ := hq' i
        exact ⟨Limits.pullback.fst _ _ ≫ q', (Category.assoc _ _ _).trans (congrArg _ hq'i)⟩
  obtain ⟨Y, p, hpf, hps, hfac⟩ := hR m Yl pl hfin hsurj
  choose q hq using hfac
  let e : (Σ l : Fin m, Fin (kl l)) ≃ Fin (∑ l, kl l) := finSigmaFinEquiv
  let Oσ : (Σ l : Fin m, Fin (kl l)) → Y.Opens := fun s => q s.1 ⁻¹ᵁ Ol s.1 s.2
  let jσ : (Σ l : Fin m, Fin (kl l)) → Fin n := fun s => jl s.1 s.2
  let gσ : ∀ s : (Σ l : Fin m, Fin (kl l)), (Oσ s : Scheme.{u}) ⟶ (V (jσ s)).left :=
    fun s => (q s.1).resLE (Ol s.1 s.2) (q s.1 ⁻¹ᵁ Ol s.1 s.2) le_rfl ≫ gl s.1 s.2
  have hgσ : ∀ s, gσ s ≫ (V (jσ s)).hom = (Oσ s).ι ≫ p := by
    rintro ⟨l, a⟩
    change ((q l).resLE (Ol l a) (q l ⁻¹ᵁ Ol l a) le_rfl ≫ gl l a) ≫ (V (jl l a)).hom =
      (q l ⁻¹ᵁ Ol l a).ι ≫ p
    rw [Category.assoc, hgl l a, ← Category.assoc, Scheme.Hom.resLE_comp_ι, Category.assoc, hq l]
  refine ⟨Y, p, hpf, hps, ∑ l, kl l, fun α => Oσ (e.symm α), fun α => jσ (e.symm α),
    fun α => gσ (e.symm α), ?_, fun α => hgσ _⟩
  intro y
  obtain ⟨l, hl⟩ := hcov (p y)
  have h1 : pl l (q l y) = p y := by rw [← hq l, Scheme.Hom.comp_apply]
  obtain ⟨a, ha⟩ := hl (q l y) h1
  refine ⟨e ⟨l, a⟩, ?_⟩
  show y ∈ Oσ (e.symm (e ⟨l, a⟩))
  rw [Equiv.symm_apply_apply]
  exact ha

theorem wc_etale_cover_finite_zariski_refinement : ∀ (X : Scheme.{u}), CompactSpace X →
    QuasiSeparatedSpace X → ∀ (n : ℕ) (V : Fin n → X.Etale), (∀ i, IsAffine (V i).left) →
    (∀ x : X, ∃ i, x ∈ Set.range (V i).hom) →
    ∃ (Y : Scheme.{u}) (p : Y ⟶ X), IsFinite p ∧ Surjective p ∧
      ∃ (k : ℕ) (O : Fin k → Y.Opens) (j : Fin k → Fin n)
        (g : ∀ α, (O α : Scheme.{u}) ⟶ (V (j α)).left),
        (∀ y : Y, ∃ α, y ∈ O α) ∧ ∀ α, g α ≫ (V (j α)).hom = (O α).ι ≫ p :=
by
  intro X hXc hXqs n V hVaff hVcov
  classical

  have hW : ∀ x : X, ∃ W : X.Opens, IsAffineOpen W ∧ x ∈ W := fun x => by
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    exact ⟨W, hW, hxW⟩
  choose W hWaff hxW using hW
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => (W x : Set X))
    (fun x => (W x).isOpen.mem_nhds (hxW x))
  let Xl : Fin t.card → X.Opens := fun l => W (t.equivFin.symm l)
  have hXlaff : ∀ l, IsAffineOpen (Xl l) := fun l => hWaff _
  have hXlcov : ∀ x : X, ∃ l, x ∈ Xl l := by
    intro x
    have hx : x ∈ ⋃ y ∈ t, (W y : Set X) := by rw [ht]; trivial
    simp only [Set.mem_iUnion] at hx
    obtain ⟨y, hy, hxy⟩ := hx
    refine ⟨t.equivFin ⟨y, hy⟩, ?_⟩
    show x ∈ W (t.equivFin.symm (t.equivFin ⟨y, hy⟩))
    rw [Equiv.symm_apply_apply]
    exact hxy

  haveI hVet : ∀ i, Etale (V i).hom := fun i => (V i).prop
  let V' : ∀ l, Fin n → (Xl l : Scheme.{u}).Etale :=
    fun l i => Scheme.Etale.mk ((V i).hom ∣_ Xl l)
  have hV'c : ∀ l i, CompactSpace (V' l i).left := by
    intro l i
    haveI := hVaff i
    haveI : CompactSpace ((𝟭 Scheme).obj (V i).left) := (inferInstance : CompactSpace (V i).left)
    haveI : QuasiCompact (V i).hom :=
      @quasiCompact_of_compactSpace (V i).left X (V i).hom (inferInstance : CompactSpace (V i).left) hXqs
    have hc := QuasiCompact.isCompact_preimage (f := (V i).hom) _ (Xl l).isOpen
      (hXlaff l).isCompact
    exact isCompact_iff_compactSpace.mp hc
  have hV'cov : ∀ l, ∀ x : (Xl l : Scheme.{u}), ∃ i, x ∈ Set.range (V' l i).hom := by
    intro l x
    obtain ⟨i, v, hv⟩ := hVcov x.1
    have hvU : v ∈ (V i).hom ⁻¹ᵁ Xl l := by
      show (V i).hom v ∈ Xl l
      rw [hv]; exact x.2
    refine ⟨i, ⟨⟨v, hvU⟩, ?_⟩⟩
    apply Subtype.ext
    exact (morphismRestrict_base_coe _ _ _).trans hv

  have hA := fun l => wc_etale_cover_finite_zariski_refinement_affine (Xl l) (hXlaff l) n
    (V' l) (hV'c l) (hV'cov l)
  choose C q hqfin hqsurj k O j g hOcov hg using hA

  have hE := fun l => wc_finite_surjective_extend_from_qc_open X hXc hXqs (Xl l)
    (hXlaff l).isCompact (C l) (q l) (hqfin l) (hqsurj l)
  choose Y p ι hpfin hpsurj hιop hιp hrange using hE

  let Ol : ∀ l, Fin (k l) → (Y l).Opens := fun l α =>
    haveI := hιop l; (ι l) ''ᵁ (O l α)
  let gl : ∀ l α, (Ol l α : Scheme.{u}) ⟶ (V (j l α)).left := fun l α =>
    haveI := hιop l
    ((ι l).isoImage (O l α)).inv ≫ g l α ≫ ((V (j l α)).hom ⁻¹ᵁ Xl l).ι
  have key : ∀ {A Cs Ys : Scheme.{u}} (f : A ⟶ X) (U : X.Opens) (Oo : Cs.Opens)
      (gg : (Oo : Scheme.{u}) ⟶ (f ⁻¹ᵁ U : Scheme.{u})) (qq : Cs ⟶ (U : Scheme.{u}))
      (ιι : Cs ⟶ Ys) [IsOpenImmersion ιι] (pp : Ys ⟶ X),
      gg ≫ (f ∣_ U) = Oo.ι ≫ qq → ιι ≫ pp = qq ≫ U.ι →
      ((ιι.isoImage Oo).inv ≫ gg ≫ (f ⁻¹ᵁ U).ι) ≫ f = (ιι ''ᵁ Oo).ι ≫ pp := by
    intro A Cs Ys f U Oo gg qq ιι _ pp h1 h2
    rw [Category.assoc, Category.assoc, ← morphismRestrict_ι, reassoc_of% h1, ← h2,
      ← Scheme.Hom.isoImage_inv_ι]
    simp only [Category.assoc]
  have hgl : ∀ l α, gl l α ≫ (V (j l α)).hom = (Ol l α).ι ≫ p l := by
    intro l α
    haveI := hιop l
    exact key (V (j l α)).hom (Xl l) (O l α) (g l α) (q l) (ι l) (p l) (hg l α) (hιp l)

  have hcov : ∀ x : X, ∃ l, ∀ y : Y l, p l y = x → ∃ α, y ∈ Ol l α := by
    intro x
    obtain ⟨l, hl⟩ := hXlcov x
    refine ⟨l, fun y hy => ?_⟩
    have hyr : y ∈ Set.range (ι l) := by
      rw [hrange l]
      show p l y ∈ Xl l
      rw [hy]; exact hl
    obtain ⟨c, rfl⟩ := hyr
    obtain ⟨α, hα⟩ := hOcov l c
    exact ⟨α, ⟨c, hα, rfl⟩⟩

  exact wc_finite_surjective_combine X n t.card V Y p hpfin hpsurj k Ol (fun l α => j l α) gl
    hgl hcov

theorem wc_et_pullback_transport_exists : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X)
    (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}),
    ∃ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ρ : wcEtTransport p J G),
      wcEtTransportUniv ρ :=
by
  intro X Y p J
  classical
  let B := wcEtBaseChange p
  let τ := Scheme.smallEtaleTopology Y
  let u : ∀ (V : X.Etale) (O : Y.Etale) (h : O.left ⟶ V.left), h ≫ V.hom = O.hom ≫ p →
      (O ⟶ B.obj V) := fun V O h hh =>
    MorphismProperty.Over.homMk (Limits.pullback.lift h O.hom hh)
      (Limits.pullback.lift_snd _ _ _) trivial
  have hu_fst : ∀ (V : X.Etale) (O : Y.Etale) (h : O.left ⟶ V.left)
      (hh : h ≫ V.hom = O.hom ≫ p),
      (u V O h hh).left ≫ Limits.pullback.fst V.hom p = h :=
    fun V O h hh => Limits.pullback.lift_fst _ _ _
  have hu_snd : ∀ (V : X.Etale) (O : Y.Etale) (h : O.left ⟶ V.left)
      (hh : h ≫ V.hom = O.hom ≫ p),
      (u V O h hh).left ≫ Limits.pullback.snd V.hom p = O.hom :=
    fun V O h hh => Limits.pullback.lift_snd _ _ _
  have hB_fst : ∀ (V V' : X.Etale) (c : V' ⟶ V),
      (B.map c).left ≫ Limits.pullback.fst V.hom p = Limits.pullback.fst V'.hom p ≫ c.left :=
    fun V V' c => Limits.pullback.lift_fst _ _ _
  have hB_snd : ∀ (V V' : X.Etale) (c : V' ⟶ V),
      (B.map c).left ≫ Limits.pullback.snd V.hom p = Limits.pullback.snd V'.hom p :=
    fun V V' c => Limits.pullback.lift_snd _ _ _
  have K1 : ∀ (V V' : X.Etale) (c : V' ⟶ V) (O O' : Y.Etale) (d : O' ⟶ O)
      (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ p),
      h' ≫ c.left = d.left ≫ h → u V' O' h' hh' ≫ B.map c = d ≫ u V O h hh := by
    intro V V' c O O' d h hh h' hh' e
    apply MorphismProperty.Over.Hom.ext
    show (u V' O' h' hh').left ≫ (B.map c).left = d.left ≫ (u V O h hh).left
    apply Limits.pullback.hom_ext
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun t => (u V' O' h' hh').left ≫ t) (hB_fst V V' c)).trans
        ((Category.assoc _ _ _).symm.trans
        ((congrArg (fun t => t ≫ c.left) (hu_fst V' O' h' hh')).trans
        (e.trans ((congrArg (fun t => d.left ≫ t) (hu_fst V O h hh)).symm.trans
        (Category.assoc _ _ _).symm)))))
    · exact (Category.assoc _ _ _).trans
        ((congrArg (fun t => (u V' O' h' hh').left ≫ t) (hB_snd V V' c)).trans
        ((hu_snd V' O' h' hh').trans ((MorphismProperty.Over.w d).symm.trans
        ((congrArg (fun t => d.left ≫ t) (hu_snd V O h hh)).symm.trans
        (Category.assoc _ _ _).symm))))
  have K2 : ∀ V : X.Etale,
      u V (B.obj V) (Limits.pullback.fst V.hom p) Limits.pullback.condition = 𝟙 _ := by
    intro V
    apply MorphismProperty.Over.Hom.ext
    show (u V (B.obj V) (Limits.pullback.fst V.hom p) Limits.pullback.condition).left = 𝟙 _
    apply Limits.pullback.hom_ext
    · exact (hu_fst _ _ _ _).trans (Category.id_comp _).symm
    · exact (hu_snd _ _ _ _).trans (Category.id_comp _).symm
  have star : ∀ (H : Sheaf τ AddCommGrpCat.{u+1}) (S : wcEtTransport p J H) (V : X.Etale)
      (O : Y.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p)
      (x : J.obj.obj (Opposite.op V)),
      S.ρ V O h hh x = (H.obj.map (u V O h hh).op).hom
        (S.ρ V (B.obj V) (Limits.pullback.fst V.hom p) Limits.pullback.condition x) := by
    intro H S V O h hh x
    have e := S.nat V V (𝟙 V) (B.obj V) O (u V O h hh) (Limits.pullback.fst V.hom p)
      Limits.pullback.condition h hh
      ((Category.comp_id h).trans (hu_fst V O h hh).symm) x
    rw [op_id, CategoryTheory.Functor.map_id] at e
    exact e
  let P := B.op.lan.obj J.obj
  let η := B.op.lanUnit.app J.obj
  let G := (presheafToSheaf τ AddCommGrpCat.{u+1}).obj P
  let α₀ : J.obj ⟶ B.op ⋙ G.obj := η ≫ Functor.whiskerLeft B.op (toSheafify τ P)
  let T : wcEtTransport p J G :=
    { ρ := fun V O h hh => (G.obj.map (u V O h hh).op).hom.comp (α₀.app (Opposite.op V)).hom
      nat := by
        intro V V' c O O' d h hh h' hh' e x
        have key : J.obj.map c.op ≫ α₀.app (Opposite.op V') ≫ G.obj.map (u V' O' h' hh').op =
            α₀.app (Opposite.op V) ≫ G.obj.map (u V O h hh).op ≫ G.obj.map d.op := by
          rw [← Category.assoc, α₀.naturality, Category.assoc, Functor.comp_map, Functor.op_map,
            ← G.obj.map_comp, ← G.obj.map_comp, ← op_comp, ← op_comp, Quiver.Hom.unop_op,
            K1 V V' c O O' d h hh h' hh' e]
        exact congrArg (fun f => f.hom x) key }
  have hT : ∀ (V : X.Etale) (x : J.obj.obj (Opposite.op V)),
      T.ρ V (B.obj V) (Limits.pullback.fst V.hom p) Limits.pullback.condition x =
        (α₀.app (Opposite.op V)).hom x := by
    intro V x
    change (G.obj.map (u V (B.obj V) _ _).op).hom ((α₀.app (Opposite.op V)).hom x) = _
    rw [K2, op_id, CategoryTheory.Functor.map_id]
    rfl
  refine ⟨G, T, ?_⟩
  intro G' T'
  let α' : J.obj ⟶ B.op ⋙ G'.obj :=
    { app := fun V => AddCommGrpCat.ofHom (T'.ρ V.unop (B.obj V.unop)
        (Limits.pullback.fst V.unop.hom p) Limits.pullback.condition)
      naturality := by
        intro V₁ V₂ f
        ext x
        exact T'.nat V₁.unop V₂.unop f.unop (B.obj V₁.unop) (B.obj V₂.unop) (B.map f.unop) _
          Limits.pullback.condition _ Limits.pullback.condition (hB_fst _ _ _).symm x }
  let β : P ⟶ G'.obj := P.descOfIsLeftKanExtension η G'.obj α'
  have hβ : η ≫ Functor.whiskerLeft B.op β = α' :=
    P.descOfIsLeftKanExtension_fac η G'.obj α'
  let φ : G ⟶ G' := ObjectProperty.homMk (sheafifyLift τ β G'.cond)
  have hφ : toSheafify τ P ≫ φ.hom = β := toSheafify_sheafifyLift τ β G'.cond
  have hK : α₀ ≫ Functor.whiskerLeft B.op φ.hom = α' := by
    rw [← hβ, ← hφ]
    rfl
  refine ⟨φ, ?_, ?_⟩
  · intro V O h hh x
    have hm : α₀.app (Opposite.op V) ≫ G.obj.map (u V O h hh).op ≫ φ.hom.app (Opposite.op O) =
        α'.app (Opposite.op V) ≫ G'.obj.map (u V O h hh).op := by
      rw [φ.hom.naturality, ← Category.assoc, ← NatTrans.congr_app hK (Opposite.op V)]
      rfl
    rw [star G' T' V O h hh x]
    exact congrArg (fun f => f.hom x) hm
  · intro ψ hψ
    have hK' : α₀ ≫ Functor.whiskerLeft B.op ψ.hom = α' := by
      ext V x
      have := hψ V.unop (B.obj V.unop) (Limits.pullback.fst V.unop.hom p)
        Limits.pullback.condition x
      rw [hT] at this
      exact this
    have h1 : toSheafify τ P ≫ ψ.hom = toSheafify τ P ≫ φ.hom :=
      Functor.hom_ext_of_isLeftKanExtension P η _ _ (hK'.trans hK.symm)
    have h2 : ψ.hom = φ.hom := sheafify_hom_ext τ _ _ G'.cond h1
    exact ObjectProperty.hom_ext _ h2

theorem wc_et_transport_supp_reflect : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X)
    (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
    (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ρ : wcEtTransport p J G),
    wcEtTransportUniv ρ → ∀ (W : Set X), IsOpen W →
    ∀ (V : X.Etale) (O : Y.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p)
      (x : J.obj.obj (Opposite.op V)), (∀ v : V.left, ∃ o : O.left, h o = v) →
      wcSuppSec Y (p ⁻¹' W) G O (ρ.ρ V O h hh x) → wcSuppSec X W J V x :=
by
  intro X Y p J G ρ hρU W hW V O h hh x hsurj hsupp
  classical

  have hcovers : ∀ {Z : Scheme.{u}} {U : Z.Etale} (R : Sieve U),
      R ∈ Scheme.smallEtaleTopology Z U →
      ∀ z : U.left, ∃ (U' : Z.Etale) (f : U' ⟶ U) (y : U'.left), R.arrows f ∧ f.left y = z := by
    intro Z U R hR z
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z U at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨U', f, y, hf, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR z
    exact ⟨U', f, y, hf, hy⟩
  have hjs : ∀ {Z : Scheme.{u}} {U : Z.Etale} (R : Sieve U),
      (∀ z : U.left, ∃ (U' : Z.Etale) (f : U' ⟶ U), R.arrows f ∧ z ∈ Set.range f.left) →
      R ∈ Scheme.smallEtaleTopology Z U := by
    intro Z U R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z U
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro z
    obtain ⟨U', f, hf, y, hy⟩ := hR z
    have hw : f.left ≫ U.hom = U'.hom := MorphismProperty.Over.w f
    have hEt : Etale f.left := by
      have h1 : Etale U.hom := U.prop
      have h2 : Etale (f.left ≫ U.hom) := by rw [hw]; exact U'.prop
      exact Etale.of_comp f.left U.hom
    exact ⟨U', f, y, hf, hEt, hy⟩

  have L1 : ∀ (T : Over X) (V₁ : X.Etale) (a : T ⟶ (Scheme.Etale.forget X).obj V₁)
      (t : J.obj.obj (Opposite.op V₁)),
      ((Scheme.Etale.forget X).op.lan.obj J.obj).map a.op
        (((Scheme.Etale.forget X).op.lanUnit.app J.obj).app (Opposite.op V₁) t) = 0 →
      ∃ (V₂ : X.Etale) (c : V₂ ⟶ V₁) (a' : T ⟶ (Scheme.Etale.forget X).obj V₂),
        a' ≫ (Scheme.Etale.forget X).map c = a ∧ J.obj.map c.op t = 0 := by
    intro T V₁ a t ht
    haveI : RepresentablyFlat (Scheme.Etale.forget X) := flat_of_preservesFiniteLimits _
    haveI : IsCofiltered (StructuredArrow T (Scheme.Etale.forget X)) :=
      RepresentablyFlat.cofiltered T
    haveI hI : IsFiltered (CostructuredArrow (Scheme.Etale.forget X).op (Opposite.op T)) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence (Scheme.Etale.forget X) T)
    haveI : IsFiltered (ULiftHom.{u+1}
        (CostructuredArrow (Scheme.Etale.forget X).op (Opposite.op T))) :=
      IsFiltered.of_equivalence ULiftHom.equiv
    haveI := Limits.preservesColimitsOfShape_of_equiv
      (ULiftHom.equiv (C := CostructuredArrow (Scheme.Etale.forget X).op (Opposite.op T))).symm
      (forget AddCommGrpCat.{u+1})
    let E := Functor.LeftExtension.mk ((Scheme.Etale.forget X).op.leftKanExtension J.obj)
      ((Scheme.Etale.forget X).op.leftKanExtensionUnit J.obj)
    have hc : Limits.IsColimit (E.coconeAt (Opposite.op T)) :=
      (Scheme.Etale.forget X).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit J.obj
        (Opposite.op T)
    let j : CostructuredArrow (Scheme.Etale.forget X).op (Opposite.op T) :=
      CostructuredArrow.mk (Y := Opposite.op V₁) a.op
    let t' : ToType ((CostructuredArrow.proj (Scheme.Etale.forget X).op (Opposite.op T) ⋙
      J.obj).obj j) := t
    have h0 : (E.coconeAt (Opposite.op T)).ι.app j t' =
        (E.coconeAt (Opposite.op T)).ι.app j 0 := by
      rw [map_zero]
      exact ht
    obtain ⟨k, f, g, hfg⟩ := Limits.Concrete.isColimit_exists_of_rep_eq _ hc t' 0 h0
    have hw : (Scheme.Etale.forget X).op.map f.left ≫ k.hom = a.op := CostructuredArrow.w f
    refine ⟨k.left.unop, f.left.unop, k.hom.unop, ?_, ?_⟩
    · apply Quiver.Hom.op_inj
      rw [op_comp]
      exact hw
    · have : J.obj.map f.left t = 0 := by
        refine hfg.trans ?_
        exact map_zero _
      exact this

  let τ := Scheme.smallEtaleTopology Y
  let Lan := (Scheme.Etale.forget X).op.lan.obj J.obj
  let η := (Scheme.Etale.forget X).op.lanUnit.app J.obj
  let PY : Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1} := (Scheme.Etale.forget Y ⋙ Over.map p).op ⋙ Lan
  let G' := (presheafToSheaf τ AddCommGrpCat.{u+1}).obj PY
  let mk : ∀ (V₀ : X.Etale) (O₀ : Y.Etale) (h₀ : O₀.left ⟶ V₀.left), h₀ ≫ V₀.hom = O₀.hom ≫ p →
      ((Scheme.Etale.forget Y ⋙ Over.map p).obj O₀ ⟶ (Scheme.Etale.forget X).obj V₀) :=
    fun V₀ O₀ h₀ hh₀ => Over.homMk h₀ hh₀
  let ρ' : wcEtTransport p J G' :=
    { ρ := fun V₀ O₀ h₀ hh₀ => (η.app (Opposite.op V₀) ≫ Lan.map (mk V₀ O₀ h₀ hh₀).op ≫
        (toSheafify τ PY).app (Opposite.op O₀)).hom
      nat := by
        intro V₀ V' c O₀ O' d h₀ hh₀ h' hh' e x₀
        have hm : mk V' O' h' hh' ≫ (Scheme.Etale.forget X).map c =
            (Scheme.Etale.forget Y ⋙ Over.map p).map d ≫ mk V₀ O₀ h₀ hh₀ := by
          apply Over.OverMorphism.ext
          exact e
        have e1 : J.obj.map c.op ≫ η.app (Opposite.op V') =
            η.app (Opposite.op V₀) ≫ Lan.map ((Scheme.Etale.forget X).map c).op :=
          η.naturality c.op
        have e2 : Lan.map ((Scheme.Etale.forget X).map c).op ≫ Lan.map (mk V' O' h' hh').op =
            Lan.map (mk V₀ O₀ h₀ hh₀).op ≫
              Lan.map ((Scheme.Etale.forget Y ⋙ Over.map p).map d).op := by
          rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp, hm]
        have e3 : Lan.map ((Scheme.Etale.forget Y ⋙ Over.map p).map d).op ≫
            (toSheafify τ PY).app (Opposite.op O') =
            (toSheafify τ PY).app (Opposite.op O₀) ≫ G'.obj.map d.op :=
          (toSheafify τ PY).naturality d.op
        have key : J.obj.map c.op ≫ (η.app (Opposite.op V') ≫ Lan.map (mk V' O' h' hh').op ≫
            (toSheafify τ PY).app (Opposite.op O')) =
            (η.app (Opposite.op V₀) ≫ Lan.map (mk V₀ O₀ h₀ hh₀).op ≫
              (toSheafify τ PY).app (Opposite.op O₀)) ≫ G'.obj.map d.op := by
          simp only [Category.assoc]
          rw [reassoc_of% e1, reassoc_of% e2]
          exact congrArg (fun t => η.app (Opposite.op V₀) ≫ Lan.map (mk V₀ O₀ h₀ hh₀).op ≫ t) e3
        exact congrArg (fun f => f.hom x₀) key }
  obtain ⟨φ, hφ, -⟩ := hρU G' ρ'
  haveI : Presheaf.IsLocallyInjective τ (toSheafify τ PY) :=
    Presheaf.isLocallyInjective_toSheafify' τ PY
  unfold wcSuppSec at hsupp ⊢
  refine hjs _ (fun v => ?_)
  by_cases hv : V.hom v ∈ W
  ·
    let E : V.left.Opens := ⟨V.hom ⁻¹' W, hW.preimage V.hom.continuous⟩
    refine ⟨wcEtOpen X V E, wcEtOpenι X V E, ?_, ?_⟩
    · apply Sieve.le_generate
      right
      intro z
      change (E.ι ≫ V.hom) z ∈ W
      have hz : E.ι z ∈ (E : Set V.left) := by
        rw [← Scheme.Opens.range_ι]
        exact ⟨z, rfl⟩
      have hz' : V.hom (E.ι z) ∈ W := hz
      exact (congrArg (fun t => t ∈ W) (Scheme.Hom.comp_apply E.ι V.hom z)).mpr hz'
    · change v ∈ Set.range E.ι
      rw [Scheme.Opens.range_ι]
      exact hv
  ·
    obtain ⟨o, ho⟩ := hsurj v
    obtain ⟨O₁, d, o₁, hd, hdo⟩ := hcovers _ hsupp o
    obtain ⟨O₂, a, g, hg, hag⟩ := hd
    have hgo : g.left (a.left o₁) = o := by
      have e : a.left ≫ g.left = d.left := congrArg (fun t => t.left) hag
      rw [← Scheme.Hom.comp_apply, e]
      exact hdo
    have hy0 : G.obj.map g.op (ρ.ρ V O h hh x) = 0 := by
      rcases hg with hg | hg
      · exact hg
      · exfalso
        apply hv
        have h1 := hg (a.left o₁)
        have e1 : O₂.hom (a.left o₁) = O.hom o := by
          rw [← hgo, ← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]
        have e2 : V.hom (h o) = p (O.hom o) := by
          rw [← Scheme.Hom.comp_apply h V.hom o, hh, Scheme.Hom.comp_apply]
        rw [Set.mem_preimage, e1, ← e2, ho] at h1
        exact h1
    have hh₂ : (g.left ≫ h) ≫ V.hom = O₂.hom ≫ p := by
      rw [Category.assoc, hh, ← Category.assoc, MorphismProperty.Over.w g]
    have hz0 : ρ'.ρ V O₂ (g.left ≫ h) hh₂ x = 0 := by
      have e := ρ'.nat V V (𝟙 V) O O₂ g h hh (g.left ≫ h) hh₂ (Category.comp_id _) x
      rw [op_id, CategoryTheory.Functor.map_id] at e
      refine e.trans ?_
      rw [← hφ V O h hh x, ← NatTrans.naturality_apply φ.hom g.op, hy0, map_zero]
    let z : ToType (PY.obj (Opposite.op O₂)) :=
      (η.app (Opposite.op V) ≫ Lan.map (mk V O₂ (g.left ≫ h) hh₂).op).hom x
    have hz : (toSheafify τ PY).app (Opposite.op O₂) z =
        (toSheafify τ PY).app (Opposite.op O₂) 0 := by
      rw [map_zero]
      exact hz0
    have hEq := Presheaf.equalizerSieve_mem τ (toSheafify τ PY) z 0 hz
    obtain ⟨O₃, e, o₃, he, heo⟩ := hcovers _ hEq (a.left o₁)
    rw [Presheaf.equalizerSieve_apply, map_zero] at he
    have hm : (e.left ≫ g.left ≫ h) ≫ V.hom = O₃.hom ≫ p := by
      rw [Category.assoc, hh₂, ← Category.assoc, MorphismProperty.Over.w e]
    have hmm : (Scheme.Etale.forget Y ⋙ Over.map p).map e ≫ mk V O₂ (g.left ≫ h) hh₂ =
        mk V O₃ (e.left ≫ g.left ≫ h) hm := by
      apply Over.OverMorphism.ext
      rfl
    have hvan : Lan.map (mk V O₃ (e.left ≫ g.left ≫ h) hm).op (η.app (Opposite.op V) x) = 0 := by
      rw [← hmm, op_comp, Functor.map_comp]
      exact he
    obtain ⟨V₂, c, a', hca, hJ0⟩ := L1 _ V (mk V O₃ (e.left ≫ g.left ≫ h) hm) x hvan
    have hl : a'.left ≫ c.left = e.left ≫ g.left ≫ h := congrArg (fun t => t.left) hca
    refine ⟨V₂, c, ?_, a'.left o₃, ?_⟩
    · apply Sieve.le_generate
      left
      exact hJ0
    · calc c.left (a'.left o₃) = (a'.left ≫ c.left) o₃ := (Scheme.Hom.comp_apply _ _ _).symm
        _ = (e.left ≫ g.left ≫ h) o₃ := congrArg (fun f => f o₃) hl
        _ = (g.left ≫ h) (e.left o₃) := Scheme.Hom.comp_apply _ _ _
        _ = h (g.left (e.left o₃)) := Scheme.Hom.comp_apply _ _ _
        _ = v := (congrArg (fun t => h (g.left t)) heo).trans ((congrArg h hgo).trans ho)

theorem wc_et_transport_compose_exists : ∀ {A Y X : Scheme.{u}} (p : Y ⟶ X) (g : A ⟶ Y) (e : A ⟶ X) (he : g ≫ p = e) (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ρ : wcEtTransport p J G), wcEtTransportUniv ρ → ∀ (H : Sheaf (Scheme.smallEtaleTopology A) AddCommGrpCat.{u+1}) (σ : wcEtTransport e J H), Presheaf.IsSheaf (Scheme.smallEtaleTopology Y) ((wcEtBaseChange g).op ⋙ H.obj) → ∃ τ : wcEtTransport g G H, wcEtTransportFactor he ρ τ σ :=
by
  intro A Y X p g e he J G ρ hU H σ hsh
  classical

  let G' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
    ⟨(wcEtBaseChange g).op ⋙ H.obj, hsh⟩
  have hmcH : ∀ {P Q R : A.Etale} (a : Q ⟶ P) (b : R ⟶ Q) (t : H.obj.obj (Opposite.op P)),
      H.obj.map (b ≫ a).op t = H.obj.map b.op (H.obj.map a.op t) := by
    intro P Q R a b t
    rw [op_comp, Functor.map_comp]
    rfl

  have pf : ∀ (V : X.Etale) (O : Y.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p),
      (Limits.pullback.fst O.hom g ≫ h) ≫ V.hom = ((wcEtBaseChange g).obj O).hom ≫ e := by
    intro V O h hh
    change (Limits.pullback.fst O.hom g ≫ h) ≫ V.hom = Limits.pullback.snd O.hom g ≫ e
    rw [Category.assoc, hh, ← Category.assoc, Limits.pullback.condition, Category.assoc, he]
  let T' : wcEtTransport p J G' :=
    { ρ := fun V O h hh => σ.ρ V ((wcEtBaseChange g).obj O) (Limits.pullback.fst O.hom g ≫ h)
        (pf V O h hh)
      nat := by
        intro V V' c O O' d h hh h' hh' hc x
        refine σ.nat V V' c ((wcEtBaseChange g).obj O) ((wcEtBaseChange g).obj O')
          ((wcEtBaseChange g).map d) _ (pf V O h hh) _ (pf V' O' h' hh') ?_ x
        change (Limits.pullback.fst O'.hom g ≫ h') ≫ c.left =
          Limits.pullback.lift (Limits.pullback.fst O'.hom g ≫ d.left)
              (Limits.pullback.snd O'.hom g)
              (by rw [Category.assoc, MorphismProperty.Over.w d]; exact Limits.pullback.condition) ≫
            (Limits.pullback.fst O.hom g ≫ h)
        rw [Limits.pullback.lift_fst_assoc]
        simp only [Category.assoc]
        rw [hc] }

  obtain ⟨φ, hφ, -⟩ := hU G' T'

  let u : ∀ (O : Y.Etale) (O₂ : A.Etale) (k : O₂.left ⟶ O.left),
      k ≫ O.hom = O₂.hom ≫ g → (O₂ ⟶ (wcEtBaseChange g).obj O) :=
    fun O O₂ k hk => MorphismProperty.Over.homMk (Limits.pullback.lift k O₂.hom hk)
      (Limits.pullback.lift_snd _ _ _) trivial

  have KSI : ∀ (O O' : Y.Etale) (c : O' ⟶ O) (O₂ O₂' : A.Etale) (d : O₂' ⟶ O₂)
      (k : O₂.left ⟶ O.left) (hk : k ≫ O.hom = O₂.hom ≫ g)
      (k' : O₂'.left ⟶ O'.left) (hk' : k' ≫ O'.hom = O₂'.hom ≫ g),
      k' ≫ c.left = d.left ≫ k →
      u O' O₂' k' hk' ≫ (wcEtBaseChange g).map c = d ≫ u O O₂ k hk := by
    intro O O' c O₂ O₂' d k hk k' hk' hc
    apply MorphismProperty.Over.Hom.ext
    change Limits.pullback.lift k' O₂'.hom hk' ≫
        Limits.pullback.lift (Limits.pullback.fst O'.hom g ≫ c.left)
          (Limits.pullback.snd O'.hom g)
          (by rw [Category.assoc, MorphismProperty.Over.w c]; exact Limits.pullback.condition) =
      d.left ≫ Limits.pullback.lift k O₂.hom hk
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst,
        ← Category.assoc, Limits.pullback.lift_fst]
      exact hc
    · rw [Category.assoc, Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd,
        Limits.pullback.lift_snd]
      exact (MorphismProperty.Over.w d).symm

  let τ : wcEtTransport g G H :=
    { ρ := fun O O₂ k hk =>
        (H.obj.map (u O O₂ k hk).op).hom.comp (φ.hom.app (Opposite.op O)).hom
      nat := by
        intro O O' c O₂ O₂' d k hk k' hk' hc γ
        have hn : (φ.hom.app (Opposite.op O')) (G.obj.map c.op γ) =
            H.obj.map ((wcEtBaseChange g).map c).op ((φ.hom.app (Opposite.op O)) γ) :=
          NatTrans.naturality_apply φ.hom c.op γ
        have e1 := hmcH ((wcEtBaseChange g).map c) (u O' O₂' k' hk')
          ((φ.hom.app (Opposite.op O)) γ)
        have e2 := hmcH (u O O₂ k hk) d ((φ.hom.app (Opposite.op O)) γ)
        rw [KSI O O' c O₂ O₂' d k hk k' hk' hc] at e1
        change H.obj.map (u O' O₂' k' hk').op ((φ.hom.app (Opposite.op O')) (G.obj.map c.op γ)) =
          H.obj.map d.op (H.obj.map (u O O₂ k hk).op ((φ.hom.app (Opposite.op O)) γ))
        rw [hn]
        exact e1.symm.trans e2 }

  refine ⟨τ, ?_⟩
  intro V O h hh O₂ k hk x
  have side : (k ≫ h) ≫ (𝟙 V : V ⟶ V).left =
      (u O O₂ k hk).left ≫ (Limits.pullback.fst O.hom g ≫ h) := by
    change (k ≫ h) ≫ 𝟙 V.left = Limits.pullback.lift k O₂.hom hk ≫ Limits.pullback.fst O.hom g ≫ h
    rw [Category.comp_id, Limits.pullback.lift_fst_assoc]
  have hs := σ.nat V V (𝟙 V) ((wcEtBaseChange g).obj O) O₂ (u O O₂ k hk)
    (Limits.pullback.fst O.hom g ≫ h) (pf V O h hh) (k ≫ h)
    (by rw [Category.assoc, hh, ← Category.assoc, hk, Category.assoc, he]) side x
  have hJ : J.obj.map (𝟙 V).op x = x := by
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  rw [hJ] at hs
  refine hs.trans ?_
  have hφ' := hφ V O h hh x
  change H.obj.map (u O O₂ k hk).op (T'.ρ V O h hh x) =
    H.obj.map (u O O₂ k hk).op ((φ.hom.app (Opposite.op O)).hom (ρ.ρ V O h hh x))
  rw [hφ']

theorem wc_et_univ_transport_locally_injective : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ρ : wcEtTransport p J G), wcEtTransportUniv ρ → ∀ (V : X.Etale) (O : Y.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p) (x : J.obj.obj (Opposite.op V)) (o : O.left), ρ.ρ V O h hh x = 0 → ∃ (V' : X.Etale) (c : V' ⟶ V) (v' : V'.left), c.left v' = h o ∧ J.obj.map c.op x = 0 :=
by
  intro X Y p J G ρ hρU V O h hh x o hx0
  classical

  have hcovers : ∀ {Z : Scheme.{u}} {U : Z.Etale} (R : Sieve U),
      R ∈ Scheme.smallEtaleTopology Z U →
      ∀ z : U.left, ∃ (U' : Z.Etale) (f : U' ⟶ U) (y : U'.left), R.arrows f ∧ f.left y = z := by
    intro Z U R hR z
    change R ∈ Scheme.smallGrothendieckTopology @Etale Z U at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨U', f, y, hf, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR z
    exact ⟨U', f, y, hf, hy⟩

  have L1 : ∀ (T : Over X) (V₁ : X.Etale) (a : T ⟶ (Scheme.Etale.forget X).obj V₁)
      (t : J.obj.obj (Opposite.op V₁)),
      ((Scheme.Etale.forget X).op.lan.obj J.obj).map a.op
        (((Scheme.Etale.forget X).op.lanUnit.app J.obj).app (Opposite.op V₁) t) = 0 →
      ∃ (V₂ : X.Etale) (c : V₂ ⟶ V₁) (a' : T ⟶ (Scheme.Etale.forget X).obj V₂),
        a' ≫ (Scheme.Etale.forget X).map c = a ∧ J.obj.map c.op t = 0 := by
    intro T V₁ a t ht
    haveI : RepresentablyFlat (Scheme.Etale.forget X) := flat_of_preservesFiniteLimits _
    haveI : IsCofiltered (StructuredArrow T (Scheme.Etale.forget X)) :=
      RepresentablyFlat.cofiltered T
    haveI hI : IsFiltered (CostructuredArrow (Scheme.Etale.forget X).op (Opposite.op T)) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence (Scheme.Etale.forget X) T)
    haveI : IsFiltered (ULiftHom.{u+1}
        (CostructuredArrow (Scheme.Etale.forget X).op (Opposite.op T))) :=
      IsFiltered.of_equivalence ULiftHom.equiv
    haveI := Limits.preservesColimitsOfShape_of_equiv
      (ULiftHom.equiv (C := CostructuredArrow (Scheme.Etale.forget X).op (Opposite.op T))).symm
      (forget AddCommGrpCat.{u+1})
    let E := Functor.LeftExtension.mk ((Scheme.Etale.forget X).op.leftKanExtension J.obj)
      ((Scheme.Etale.forget X).op.leftKanExtensionUnit J.obj)
    have hc : Limits.IsColimit (E.coconeAt (Opposite.op T)) :=
      (Scheme.Etale.forget X).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit J.obj
        (Opposite.op T)
    let j : CostructuredArrow (Scheme.Etale.forget X).op (Opposite.op T) :=
      CostructuredArrow.mk (Y := Opposite.op V₁) a.op
    let t' : ToType ((CostructuredArrow.proj (Scheme.Etale.forget X).op (Opposite.op T) ⋙
      J.obj).obj j) := t
    have h0 : (E.coconeAt (Opposite.op T)).ι.app j t' =
        (E.coconeAt (Opposite.op T)).ι.app j 0 := by
      rw [map_zero]
      exact ht
    obtain ⟨k, f, g, hfg⟩ := Limits.Concrete.isColimit_exists_of_rep_eq _ hc t' 0 h0
    have hw : (Scheme.Etale.forget X).op.map f.left ≫ k.hom = a.op := CostructuredArrow.w f
    refine ⟨k.left.unop, f.left.unop, k.hom.unop, ?_, ?_⟩
    · apply Quiver.Hom.op_inj
      rw [op_comp]
      exact hw
    · have : J.obj.map f.left t = 0 := by
        refine hfg.trans ?_
        exact map_zero _
      exact this

  let τ := Scheme.smallEtaleTopology Y
  let Lan := (Scheme.Etale.forget X).op.lan.obj J.obj
  let η := (Scheme.Etale.forget X).op.lanUnit.app J.obj
  let PY : Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1} := (Scheme.Etale.forget Y ⋙ Over.map p).op ⋙ Lan
  let G' := (presheafToSheaf τ AddCommGrpCat.{u+1}).obj PY
  let mk : ∀ (V₀ : X.Etale) (O₀ : Y.Etale) (h₀ : O₀.left ⟶ V₀.left), h₀ ≫ V₀.hom = O₀.hom ≫ p →
      ((Scheme.Etale.forget Y ⋙ Over.map p).obj O₀ ⟶ (Scheme.Etale.forget X).obj V₀) :=
    fun V₀ O₀ h₀ hh₀ => Over.homMk h₀ hh₀
  let ρ' : wcEtTransport p J G' :=
    { ρ := fun V₀ O₀ h₀ hh₀ => (η.app (Opposite.op V₀) ≫ Lan.map (mk V₀ O₀ h₀ hh₀).op ≫
        (toSheafify τ PY).app (Opposite.op O₀)).hom
      nat := by
        intro V₀ V' c O₀ O' d h₀ hh₀ h' hh' e x₀
        have hm : mk V' O' h' hh' ≫ (Scheme.Etale.forget X).map c =
            (Scheme.Etale.forget Y ⋙ Over.map p).map d ≫ mk V₀ O₀ h₀ hh₀ := by
          apply Over.OverMorphism.ext
          exact e
        have e1 : J.obj.map c.op ≫ η.app (Opposite.op V') =
            η.app (Opposite.op V₀) ≫ Lan.map ((Scheme.Etale.forget X).map c).op :=
          η.naturality c.op
        have e2 : Lan.map ((Scheme.Etale.forget X).map c).op ≫ Lan.map (mk V' O' h' hh').op =
            Lan.map (mk V₀ O₀ h₀ hh₀).op ≫
              Lan.map ((Scheme.Etale.forget Y ⋙ Over.map p).map d).op := by
          rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp, hm]
        have e3 : Lan.map ((Scheme.Etale.forget Y ⋙ Over.map p).map d).op ≫
            (toSheafify τ PY).app (Opposite.op O') =
            (toSheafify τ PY).app (Opposite.op O₀) ≫ G'.obj.map d.op :=
          (toSheafify τ PY).naturality d.op
        have key : J.obj.map c.op ≫ (η.app (Opposite.op V') ≫ Lan.map (mk V' O' h' hh').op ≫
            (toSheafify τ PY).app (Opposite.op O')) =
            (η.app (Opposite.op V₀) ≫ Lan.map (mk V₀ O₀ h₀ hh₀).op ≫
              (toSheafify τ PY).app (Opposite.op O₀)) ≫ G'.obj.map d.op := by
          simp only [Category.assoc]
          rw [reassoc_of% e1, reassoc_of% e2]
          exact congrArg (fun t => η.app (Opposite.op V₀) ≫ Lan.map (mk V₀ O₀ h₀ hh₀).op ≫ t) e3
        exact congrArg (fun f => f.hom x₀) key }
  obtain ⟨φ, hφ, -⟩ := hρU G' ρ'
  haveI : Presheaf.IsLocallyInjective τ (toSheafify τ PY) :=
    Presheaf.isLocallyInjective_toSheafify' τ PY
  have hz0 : ρ'.ρ V O h hh x = 0 := by
    rw [← hφ V O h hh x, hx0, map_zero]
  let z : ToType (PY.obj (Opposite.op O)) :=
    (η.app (Opposite.op V) ≫ Lan.map (mk V O h hh).op).hom x
  have hz : (toSheafify τ PY).app (Opposite.op O) z =
      (toSheafify τ PY).app (Opposite.op O) 0 := by
    rw [map_zero]
    exact hz0
  have hEq := Presheaf.equalizerSieve_mem τ (toSheafify τ PY) z 0 hz
  obtain ⟨O₃, e, o₃, he, heo⟩ := hcovers _ hEq o
  rw [Presheaf.equalizerSieve_apply, map_zero] at he
  have hm : (e.left ≫ h) ≫ V.hom = O₃.hom ≫ p := by
    rw [Category.assoc, hh, ← Category.assoc, MorphismProperty.Over.w e]
  have hmm : (Scheme.Etale.forget Y ⋙ Over.map p).map e ≫ mk V O h hh =
      mk V O₃ (e.left ≫ h) hm := by
    apply Over.OverMorphism.ext
    rfl
  have hvan : Lan.map (mk V O₃ (e.left ≫ h) hm).op (η.app (Opposite.op V) x) = 0 := by
    rw [← hmm, op_comp, Functor.map_comp]
    exact he
  obtain ⟨V₂, c, a', hca, hJ0⟩ := L1 _ V (mk V O₃ (e.left ≫ h) hm) x hvan
  have hl : a'.left ≫ c.left = e.left ≫ h := congrArg (fun t => t.left) hca
  refine ⟨V₂, c, a'.left o₃, ?_, hJ0⟩
  calc c.left (a'.left o₃) = (a'.left ≫ c.left) o₃ := (Scheme.Hom.comp_apply _ _ _).symm
    _ = (e.left ≫ h) o₃ := congrArg (fun f => f o₃) hl
    _ = h (e.left o₃) := Scheme.Hom.comp_apply _ _ _
    _ = h o := congrArg h heo

theorem wc_et_univ_transport_locally_surjective : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ρ : wcEtTransport p J G), wcEtTransportUniv ρ → ∀ (O : Y.Etale) (g : G.obj.obj (Opposite.op O)) (o : O.left), ∃ (O' : Y.Etale) (d : O' ⟶ O) (o' : O'.left) (V : X.Etale) (h : O'.left ⟶ V.left) (hh : h ≫ V.hom = O'.hom ≫ p) (y : J.obj.obj (Opposite.op V)), d.left o' = o ∧ G.obj.map d.op g = ρ.ρ V O' h hh y :=
by
  intro X Y p J G ρ hU O g o
  classical
  have hcomp : ∀ {V : X.Etale} {Q Q' : Y.Etale} (d : Q' ⟶ Q) (h : Q.left ⟶ V.left),
      h ≫ V.hom = Q.hom ≫ p → (d.left ≫ h) ≫ V.hom = Q'.hom ≫ p := by
    intro V Q Q' d h hh
    rw [Category.assoc, hh, ← Category.assoc, MorphismProperty.Over.w d]
  have natO : ∀ (V : X.Etale) (Q Q' : Y.Etale) (d : Q' ⟶ Q) (h : Q.left ⟶ V.left)
      (hh : h ≫ V.hom = Q.hom ≫ p) (x : J.obj.obj (Opposite.op V)),
      G.obj.map d.op (ρ.ρ V Q h hh x) = ρ.ρ V Q' (d.left ≫ h) (hcomp d h hh) x := by
    intro V Q Q' d h hh x
    rw [← ρ.nat V V (𝟙 V) Q Q' d h hh (d.left ≫ h) (hcomp d h hh)
      (Category.comp_id (d.left ≫ h)) x]
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl
  have natV : ∀ (V V' : X.Etale) (c : V' ⟶ V) (Q : Y.Etale) (h : Q.left ⟶ V.left)
      (hh : h ≫ V.hom = Q.hom ≫ p) (h' : Q.left ⟶ V'.left) (hh' : h' ≫ V'.hom = Q.hom ≫ p),
      h' ≫ c.left = h → ∀ x, ρ.ρ V' Q h' hh' (J.obj.map c.op x) = ρ.ρ V Q h hh x := by
    intro V V' c Q h hh h' hh' e x
    rw [ρ.nat V V' c Q Q (𝟙 Q) h hh h' hh' (by rw [e]; exact (Category.id_comp h).symm) x]
    rw [op_id, CategoryTheory.Functor.map_id]
    rfl

  let S : ∀ Q : Y.Etale, AddSubgroup (G.obj.obj (Opposite.op Q)) := fun Q =>
    { carrier := {g' | ∃ (V : X.Etale) (h : Q.left ⟶ V.left) (hh : h ≫ V.hom = Q.hom ≫ p)
          (y : J.obj.obj (Opposite.op V)), g' = ρ.ρ V Q h hh y}
      zero_mem' := ⟨Scheme.Etale.mk (𝟙 X), Q.hom ≫ p, Category.comp_id _, 0, (map_zero _).symm⟩
      neg_mem' := by
        rintro _ ⟨V, h, hh, y, rfl⟩
        exact ⟨V, h, hh, -y, (map_neg _ _).symm⟩
      add_mem' := by
        rintro _ _ ⟨V₁, h₁, hh₁, y₁, rfl⟩ ⟨V₂, h₂, hh₂, y₂, rfl⟩
        haveI : Etale V₁.hom := V₁.prop
        haveI : Etale V₂.hom := V₂.prop
        let P : X.Etale := Scheme.Etale.mk (Limits.pullback.fst V₁.hom V₂.hom ≫ V₁.hom)
        let pr₁ : P ⟶ V₁ :=
          MorphismProperty.Over.homMk (Limits.pullback.fst V₁.hom V₂.hom) rfl trivial
        let pr₂ : P ⟶ V₂ := MorphismProperty.Over.homMk (Limits.pullback.snd V₁.hom V₂.hom)
          Limits.pullback.condition.symm trivial
        have hu : Limits.pullback.lift h₁ h₂ (by rw [hh₁, hh₂]) ≫ P.hom = Q.hom ≫ p := by
          change Limits.pullback.lift h₁ h₂ _ ≫ Limits.pullback.fst V₁.hom V₂.hom ≫ V₁.hom = _
          rw [Limits.pullback.lift_fst_assoc, hh₁]
        refine ⟨P, _, hu, J.obj.map pr₁.op y₁ + J.obj.map pr₂.op y₂, ?_⟩
        rw [map_add, natV V₁ P pr₁ Q h₁ hh₁ _ hu (Limits.pullback.lift_fst _ _ _),
          natV V₂ P pr₂ Q h₂ hh₂ _ hu (Limits.pullback.lift_snd _ _ _)] }
  have hmem : ∀ (Q : Y.Etale) (g' : G.obj.obj (Opposite.op Q)), g' ∈ S Q ↔
      ∃ (V : X.Etale) (h : Q.left ⟶ V.left) (hh : h ≫ V.hom = Q.hom ≫ p)
        (y : J.obj.obj (Opposite.op V)), g' = ρ.ρ V Q h hh y := fun _ _ => Iff.rfl
  have hstab : ∀ (Q Q' : Y.Etale) (d : Q' ⟶ Q) (g' : G.obj.obj (Opposite.op Q)),
      g' ∈ S Q → G.obj.map d.op g' ∈ S Q' := by
    intro Q Q' d g' hg'
    obtain ⟨V, h, hh, y, rfl⟩ := (hmem Q g').mp hg'
    exact (hmem Q' _).mpr ⟨V, d.left ≫ h, hcomp d h hh, y, natO V Q Q' d h hh y⟩

  let Pf : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    { obj := fun Q => AddCommGrpCat.of (S Q.unop)
      map := fun {Q Q'} d => AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
        ((G.obj.map d).hom.comp (S Q.unop).subtype) (S Q'.unop)
        (fun s => hstab _ _ d.unop _ s.2))
      map_id := fun Q => by
        ext s
        change (G.obj.map (𝟙 Q)) s.1 = s.1
        rw [CategoryTheory.Functor.map_id]
        rfl
      map_comp := fun {Q Q' Q''} d e => by
        ext s
        change (G.obj.map (d ≫ e)) s.1 = (G.obj.map e) ((G.obj.map d) s.1)
        rw [CategoryTheory.Functor.map_comp]
        rfl }
  let α : Pf ⟶ G.obj :=
    { app := fun Q => AddCommGrpCat.ofHom (S Q.unop).subtype
      naturality := fun Q Q' d => by
        ext s
        rfl }
  let Jt := Scheme.smallEtaleTopology Y
  let G' : Sheaf Jt AddCommGrpCat.{u+1} := (presheafToSheaf Jt AddCommGrpCat.{u+1}).obj Pf
  let ι : G' ⟶ G := ObjectProperty.homMk (sheafifyLift Jt α G.property)
  have h1 : ∀ (Q : Y.Etale) (s : S Q),
      (ι.hom.app (Opposite.op Q)).hom (((toSheafify Jt Pf).app (Opposite.op Q)).hom s) = s.1 := by
    intro Q s
    have e := congrArg (fun χ => (χ.app (Opposite.op Q)).hom s) (toSheafify_sheafifyLift Jt α G.property)
    exact e

  let T' : wcEtTransport p J G' :=
    { ρ := fun V Q h hh => ((toSheafify Jt Pf).app (Opposite.op Q)).hom.comp
        (AddMonoidHom.codRestrict (ρ.ρ V Q h hh) (S Q) (fun y => (hmem Q _).mpr ⟨V, h, hh, y, rfl⟩))
      nat := by
        intro V V' c Q Q' d h hh h' hh' hc x
        have e : (⟨ρ.ρ V' Q' h' hh' (J.obj.map c.op x),
            (hmem Q' _).mpr ⟨V', h', hh', _, rfl⟩⟩ : S Q') =
            (Pf.map d.op).hom ⟨ρ.ρ V Q h hh x, (hmem Q _).mpr ⟨V, h, hh, x, rfl⟩⟩ :=
          Subtype.ext (ρ.nat V V' c Q Q' d h hh h' hh' hc x)
        change ((toSheafify Jt Pf).app (Opposite.op Q')).hom _ =
          (G'.obj.map d.op) (((toSheafify Jt Pf).app (Opposite.op Q)).hom _)
        rw [AddMonoidHom.codRestrict_apply, AddMonoidHom.codRestrict_apply, e]
        exact NatTrans.naturality_apply (toSheafify Jt Pf) d.op _ }
  have hcompat : ∀ (V : X.Etale) (Q : Y.Etale) (h : Q.left ⟶ V.left)
      (hh : h ≫ V.hom = Q.hom ≫ p) (x : J.obj.obj (Opposite.op V)),
      (ι.hom.app (Opposite.op Q)).hom (T'.ρ V Q h hh x) = ρ.ρ V Q h hh x := by
    intro V Q h hh x
    exact h1 Q _

  obtain ⟨φ, hφ, -⟩ := hU G' T'
  obtain ⟨ψ, -, hψu⟩ := hU G ρ
  have hret : φ ≫ ι = 𝟙 G := by
    refine (hψu (φ ≫ ι) ?_).trans (hψu (𝟙 G) ?_).symm
    · intro V Q h hh x
      change (ι.hom.app _).hom ((φ.hom.app _).hom _) = _
      rw [hφ]
      exact hcompat V Q h hh x
    · intro V Q h hh x
      rfl
  have hgi : (ι.hom.app (Opposite.op O)).hom ((φ.hom.app (Opposite.op O)).hom g) = g := by
    have e := congrArg (fun χ : G ⟶ G => (χ.hom.app (Opposite.op O)).hom g) hret
    exact e

  haveI : Presheaf.IsLocallySurjective Jt (toSheafify Jt Pf) :=
    Presheaf.isLocallySurjective_toSheafify' _ _
  have hI := Presheaf.imageSieve_mem Jt (toSheafify Jt Pf) (U := Opposite.op O)
    ((φ.hom.app (Opposite.op O)).hom g)
  have hI' : Presheaf.imageSieve (toSheafify Jt Pf) ((φ.hom.app (Opposite.op O)).hom g) ∈
      Scheme.smallGrothendieckTopology @Etale Y O := hI
  rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hI'
  obtain ⟨O', d, o', hd, -, hdo⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hI' o
  have key : ∀ (Q : Y.Etale) (dd : Q ⟶ O) (s' : S Q),
      ((toSheafify Jt Pf).app (Opposite.op Q)).hom s' =
        G'.obj.map dd.op ((φ.hom.app (Opposite.op O)).hom g) →
      G.obj.map dd.op g = s'.1 := by
    intro Q dd s' hs'
    calc G.obj.map dd.op g
        = G.obj.map dd.op ((ι.hom.app (Opposite.op O)).hom ((φ.hom.app (Opposite.op O)).hom g)) := by
          rw [hgi]
      _ = (ι.hom.app (Opposite.op Q)).hom (G'.obj.map dd.op ((φ.hom.app (Opposite.op O)).hom g)) :=
          (NatTrans.naturality_apply ι.hom dd.op _).symm
      _ = (ι.hom.app (Opposite.op Q)).hom (((toSheafify Jt Pf).app (Opposite.op Q)).hom s') := by
          rw [← hs']
      _ = s'.1 := h1 Q s'
  obtain ⟨s, hs⟩ := hd
  obtain ⟨V, h, hh, y, hy⟩ := (hmem O' s.1).mp s.2
  exact ⟨O', d, o', V, h, hh, y, hdo, (key O' d s hs).trans hy⟩

theorem wc_et_glue_pointwise_family : ∀ (X : Scheme.{u}) (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) (V : X → X.Etale) (s : ∀ x, J.obj.obj (Opposite.op (V x))), (∀ x, ∃ v : (V x).left, (V x).hom v = x) → (∀ (x y : X) (W : X.Etale) (a : W ⟶ V x) (c : W ⟶ V y), J.obj.map a.op (s x) = J.obj.map c.op (s y)) → ∃ t : J.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 X))), ∀ (x : X) (d : V x ⟶ Scheme.Etale.mk (𝟙 X)), J.obj.map d.op t = s x :=
by
  intro X J V s hcover hcompat
  have hleft : ∀ {Z : X.Etale} (a : Z ⟶ Scheme.Etale.mk (𝟙 X)), a.left = Z.hom :=
    fun a => (Category.comp_id a.left).symm.trans (MorphismProperty.Over.w a)
  have hterm : ∀ {Z : X.Etale} (a b : Z ⟶ Scheme.Etale.mk (𝟙 X)), a = b :=
    fun a b => MorphismProperty.Over.Hom.ext ((hleft a).trans (hleft b).symm)
  let π : ∀ x : X, V x ⟶ Scheme.Etale.mk (𝟙 X) :=
    fun x => MorphismProperty.Over.homMk (V x).hom (Category.comp_id _) trivial
  let P := J.obj ⋙ forget AddCommGrpCat.{u+1}
  have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology X) P :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      (GrothendieckTopology.HasSheafCompose.isSheaf (F := forget AddCommGrpCat.{u+1}) J.obj J.property)
  have hmem : ∀ x, (Sieve.generate (Presieve.ofArrows V π)).arrows (π x) :=
    fun x => ⟨V x, 𝟙 (V x), π x, Presieve.ofArrows.mk x, Category.id_comp _⟩
  have hcov : Sieve.generate (Presieve.ofArrows V π) ∈
      Scheme.smallEtaleTopology X (Scheme.Etale.mk (𝟙 X)) := by
    change _ ∈ Scheme.smallGrothendieckTopology @Etale X _
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨v, hv⟩ := hcover x
    have hEt : Etale (π x).left := by
      rw [hleft (π x)]
      exact (V x).prop
    have hv' : (π x).left v = x := by
      rw [hleft (π x)]
      exact hv
    exact ⟨V x, π x, v, hmem x, hEt, hv'⟩
  have hsf := hP.isSheafFor _ hcov
  obtain ⟨t, ht, -⟩ := (Presieve.isSheafFor_arrows_iff P π).mp hsf s
    (fun i j Z gi gj _ => hcompat i j Z gi gj)
  refine ⟨t, fun x d => ?_⟩
  rw [hterm d (π x)]
  exact ht x

theorem wc_finite_geom_fibre_finite : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) [IsFinite p] (Ω : Type u) [Field Ω] (xb : Spec (.of Ω) ⟶ X), Finite {yb : Spec (.of Ω) ⟶ Y // yb ≫ p = xb} :=
by
  intro X Y p _ Ω _ xb
  classical
  let Z := Limits.pullback p xb
  let π : Z ⟶ Spec (.of Ω) := Limits.pullback.snd p xb
  haveI : IsFinite π := inferInstance
  haveI hZ : IsAffine Z := isAffine_of_isAffineHom π
  let φ : CommRingCat.of Ω ⟶ Γ(Z, ⊤) := (Scheme.ΓSpecIso (.of Ω)).inv ≫ π.appTop
  have hfin : φ.hom.Finite := by
    have h1 : (π.app ⊤).hom.Finite := Scheme.Hom.finite_app π ⊤ (isAffineOpen_top _)
    have h2 : (Scheme.ΓSpecIso (.of Ω)).inv.hom.Finite := by
      apply RingHom.Finite.of_surjective
      intro y
      refine ⟨(Scheme.ΓSpecIso (.of Ω)).hom y, ?_⟩
      rw [← CommRingCat.comp_apply, Iso.hom_inv_id]
      rfl
    show ((Scheme.ΓSpecIso (.of Ω)).inv ≫ π.appTop).hom.Finite
    rw [CommRingCat.hom_comp]
    exact h1.comp h2
  letI : Algebra Ω Γ(Z, ⊤) := φ.hom.toAlgebra
  haveI : Module.Finite Ω Γ(Z, ⊤) := hfin
  haveI : Finite (Γ(Z, ⊤) →ₐ[Ω] Ω) := inferInstance
  let sec : {yb : Spec (.of Ω) ⟶ Y // yb ≫ p = xb} → (Spec (.of Ω) ⟶ Z) := fun yb =>
    Limits.pullback.lift yb.1 (𝟙 _) (by rw [yb.2, Category.id_comp])
  have hsec : ∀ yb, sec yb ≫ π = 𝟙 _ := fun yb => Limits.pullback.lift_snd _ _ _
  have hfst : ∀ yb, sec yb ≫ Limits.pullback.fst p xb = yb.1 :=
    fun yb => Limits.pullback.lift_fst _ _ _
  have key : ∀ yb, φ ≫ (sec yb).appTop ≫ (Scheme.ΓSpecIso (.of Ω)).hom = 𝟙 _ := by
    intro yb
    have h : π.appTop ≫ (sec yb).appTop = 𝟙 _ := by
      rw [← Scheme.Hom.comp_appTop, hsec, Scheme.Hom.id_appTop]
    simp only [φ, Category.assoc]
    rw [← Category.assoc π.appTop, h, Category.id_comp, Iso.inv_hom_id]
  let χ : {yb : Spec (.of Ω) ⟶ Y // yb ≫ p = xb} → (Γ(Z, ⊤) →ₐ[Ω] Ω) := fun yb =>
    { toRingHom := ((sec yb).appTop ≫ (Scheme.ΓSpecIso (.of Ω)).hom).hom
      commutes' := fun r => by
        change ((sec yb).appTop ≫ (Scheme.ΓSpecIso (.of Ω)).hom).hom (φ.hom r) = r
        rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, key yb]
        rfl }
  have hχ : Function.Injective χ := by
    intro a b hab
    have h1 : (sec a).appTop ≫ (Scheme.ΓSpecIso (.of Ω)).hom =
        (sec b).appTop ≫ (Scheme.ΓSpecIso (.of Ω)).hom := by
      ext c
      exact DFunLike.congr_fun hab c
    have h2 : (sec a).appTop = (sec b).appTop := (cancel_mono _).mp h1
    have h3 : sec a = sec b := ext_of_isAffine h2
    apply Subtype.ext
    rw [← hfst a, ← hfst b, h3]
  exact Finite.of_injective χ hχ

theorem wc_finite_geom_point_lift : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] {Z V : Scheme.{u}} (f : Z ⟶ V) [IsFinite f] (vb : Spec (.of Ω) ⟶ V) (z : Z), f z = vb (IsLocalRing.closedPoint Ω) → ∃ zb : Spec (.of Ω) ⟶ Z, zb ≫ f = vb ∧ zb (IsLocalRing.closedPoint Ω) = z :=
by
  intro Ω _ _ Z V f _ vb z hz
  obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f) (g := vb) z
    (IsLocalRing.closedPoint Ω) hz
  haveI : IsLocallyArtinian (Limits.pullback f vb) :=
    IsLocallyArtinian.of_locallyQuasiFinite (Limits.pullback.snd f vb)
  have hwc : IsClosed ({w} : Set ↥(Limits.pullback f vb)) := isClosed_discrete _
  let σ : Spec (.of Ω) ⟶ Limits.pullback f vb :=
    pointOfClosedPoint (K := Ω) (Limits.pullback.snd f vb) w hwc
  have hσ1 : σ ≫ Limits.pullback.snd f vb = 𝟙 _ := pointOfClosedPoint_comp _ _ _
  have hσ2 : ∀ a : Spec (.of Ω), (σ ≫ Limits.pullback.fst f vb) a = z := by
    intro a
    rw [Scheme.Hom.comp_apply]
    rw [show σ a = w from pointOfClosedPoint_apply _ _ _ a, hw1]
  refine ⟨σ ≫ Limits.pullback.fst f vb, ?_, hσ2 _⟩
  rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hσ1, Category.id_comp]

theorem wc_et_geom_common_refinement : ∀ {X : Scheme.{u}} (U : X.Etale) (n : ℕ) (V : Fin n → X.Etale) (f : ∀ i, V i ⟶ U) (Ω : Type u) [Field Ω] (ub : Spec (.of Ω) ⟶ U.left) (w : ∀ i, Spec (.of Ω) ⟶ (V i).left), (∀ i, w i ≫ (f i).left = ub) → ∃ (W : X.Etale) (c : W ⟶ U) (φ : ∀ i, W ⟶ V i) (v : Spec (.of Ω) ⟶ W.left), (∀ i, φ i ≫ f i = c) ∧ v ≫ c.left = ub ∧ ∀ i, v ≫ (φ i).left = w i :=
by
  intro X U n
  have pair : ∀ (W' V' : X.Etale) (c' : W' ⟶ U) (f' : V' ⟶ U) (Ω : Type u) [Field Ω]
      (ub : Spec (.of Ω) ⟶ U.left) (v' : Spec (.of Ω) ⟶ W'.left) (w' : Spec (.of Ω) ⟶ V'.left),
      v' ≫ c'.left = ub → w' ≫ f'.left = ub →
      ∃ (W : X.Etale) (a : W ⟶ W') (b : W ⟶ V') (v : Spec (.of Ω) ⟶ W.left),
        a ≫ c' = b ≫ f' ∧ v ≫ a.left = v' ∧ v ≫ b.left = w' := by
    intro W' V' c' f' Ω _ ub v' w' h1 h2
    haveI : Etale U.hom := U.prop
    haveI : Etale W'.hom := W'.prop
    haveI : Etale (f'.left ≫ U.hom) := by rw [MorphismProperty.Over.w f']; exact V'.prop
    haveI : Etale f'.left := Etale.of_comp f'.left U.hom
    let W : X.Etale := Scheme.Etale.mk (Limits.pullback.fst c'.left f'.left ≫ W'.hom)
    have hb : Limits.pullback.snd c'.left f'.left ≫ V'.hom = W.hom := by
      change _ = Limits.pullback.fst c'.left f'.left ≫ W'.hom
      rw [← MorphismProperty.Over.w f', ← Category.assoc, ← Limits.pullback.condition,
        Category.assoc, MorphismProperty.Over.w c']
    let a : W ⟶ W' := MorphismProperty.Over.homMk (Limits.pullback.fst c'.left f'.left) rfl trivial
    let b : W ⟶ V' := MorphismProperty.Over.homMk (Limits.pullback.snd c'.left f'.left) hb trivial
    refine ⟨W, a, b, Limits.pullback.lift v' w' (h1.trans h2.symm), ?_, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      show Limits.pullback.fst c'.left f'.left ≫ c'.left =
        Limits.pullback.snd c'.left f'.left ≫ f'.left
      exact Limits.pullback.condition
    · exact Limits.pullback.lift_fst _ _ _
    · exact Limits.pullback.lift_snd _ _ _
  induction n with
  | zero =>
    intro V f Ω _ ub w hw
    refine ⟨U, 𝟙 U, fun i => i.elim0, ub, fun i => i.elim0, ?_, fun i => i.elim0⟩
    show ub ≫ 𝟙 U.left = ub
    exact Category.comp_id _
  | succ n ih =>
    intro V f Ω _ ub w hw
    obtain ⟨W₀, c₀, φ₀, v₀, hφ₀, hv₀, hw₀⟩ := ih (fun i => V i.castSucc) (fun i => f i.castSucc)
      Ω ub (fun i => w i.castSucc) (fun i => hw i.castSucc)
    obtain ⟨W, a, b, v, hab, hva, hvb⟩ := pair W₀ (V (Fin.last n)) c₀ (f (Fin.last n)) Ω ub v₀
      (w (Fin.last n)) hv₀ (hw _)
    refine ⟨W, a ≫ c₀, Fin.lastCases (motive := fun i => W ⟶ V i) b (fun i => a ≫ φ₀ i), v,
      ?_, ?_, ?_⟩
    · intro i
      refine Fin.lastCases ?_ (fun i => ?_) i
      · rw [Fin.lastCases_last]
        exact hab.symm
      · rw [Fin.lastCases_castSucc, Category.assoc, hφ₀ i]
    · show v ≫ a.left ≫ c₀.left = ub
      rw [← Category.assoc, hva, hv₀]
    · intro i
      refine Fin.lastCases ?_ (fun i => ?_) i
      · rw [Fin.lastCases_last]
        exact hvb
      · rw [Fin.lastCases_castSucc]
        show v ≫ a.left ≫ (φ₀ i).left = w i.castSucc
        rw [← Category.assoc, hva, hw₀ i]

theorem wc_etale_maps_agree_near_geom_point : ∀ {P E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (a b : P ⟶ E), a ≫ e = b ≫ e → ∀ (Ω : Type u) [Field Ω] (π : Spec (.of Ω) ⟶ P), π ≫ a = π ≫ b → ∃ U : P.Opens, π (IsLocalRing.closedPoint Ω) ∈ U ∧ U.ι ≫ a = U.ι ≫ b :=
by
  intro P E S e _ a b hab Ω _ π hπ
  let c : P ⟶ Limits.pullback e e := Limits.pullback.lift a b hab
  have hcf : c ≫ Limits.pullback.fst e e = a := Limits.pullback.lift_fst _ _ _
  have hcs : c ≫ Limits.pullback.snd e e = b := Limits.pullback.lift_snd _ _ _
  have hkey : π ≫ c = (π ≫ a) ≫ Limits.pullback.diagonal e := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hcf, Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
    · rw [Category.assoc, hcs, Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id,
        hπ]
  have hpt : ∀ y : Spec (.of Ω), c (π y) = Limits.pullback.diagonal e (a (π y)) := by
    intro y
    rw [← Scheme.Hom.comp_apply, hkey, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
  refine ⟨c ⁻¹ᵁ (Limits.pullback.diagonal e).opensRange, ?_, ?_⟩
  · show c (π (IsLocalRing.closedPoint Ω)) ∈ (Limits.pullback.diagonal e).opensRange
    rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
    exact ⟨_, (hpt _).symm⟩
  · set U := c ⁻¹ᵁ (Limits.pullback.diagonal e).opensRange with hU
    have hrange : Set.range (U.ι ≫ c) ⊆ Set.range (Limits.pullback.diagonal e) := by
      rintro _ ⟨x, rfl⟩
      have hx0 : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι] at hx0
      have hx' : c (U.ι x) ∈ (Limits.pullback.diagonal e).opensRange := hx0
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hx'
      rw [Scheme.Hom.comp_apply]
      exact hx'
    obtain ⟨t, ht⟩ : ∃ t, t ≫ Limits.pullback.diagonal e = U.ι ≫ c :=
      ⟨_, IsOpenImmersion.lift_fac (Limits.pullback.diagonal e) (U.ι ≫ c) hrange⟩
    have h1 : U.ι ≫ a = t := by
      calc U.ι ≫ a = (U.ι ≫ c) ≫ Limits.pullback.fst e e := by rw [Category.assoc, hcf]
        _ = (t ≫ Limits.pullback.diagonal e) ≫ Limits.pullback.fst e e := by rw [ht]
        _ = t := by rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
    have h2 : U.ι ≫ b = t := by
      calc U.ι ≫ b = (U.ι ≫ c) ≫ Limits.pullback.snd e e := by rw [Category.assoc, hcs]
        _ = (t ≫ Limits.pullback.diagonal e) ≫ Limits.pullback.snd e e := by rw [ht]
        _ = t := by rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id]
    rw [h1, h2]

theorem wc_finite_fibre_vanishing_zariski_nbhd : ∀ {X Y : Scheme.{u}} (p : Y ⟶ X) [IsFinite p] (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), (∀ (O : Y.Etale) (g : G.obj.obj (Opposite.op O)), IsOpen {o : O.left | ∃ (O₁ : Y.Etale) (c : O₁ ⟶ O), o ∈ Set.range c.left ∧ G.obj.map c.op g = 0} ∧ ∀ (O₁ : Y.Etale) (c : O₁ ⟶ O), Set.range c.left ⊆ {o : O.left | ∃ (O₂ : Y.Etale) (c₂ : O₂ ⟶ O), o ∈ Set.range c₂.left ∧ G.obj.map c₂.op g = 0} → G.obj.map c.op g = 0) → ∀ (V : X.Etale) (g : G.obj.obj (Opposite.op ((wcEtBaseChange p).obj V))) (v : V.left), (∀ z : ((wcEtBaseChange p).obj V).left, Limits.pullback.fst V.hom p z = v → ∃ (V₁ : Y.Etale) (c : V₁ ⟶ (wcEtBaseChange p).obj V), z ∈ Set.range c.left ∧ G.obj.map c.op g = 0) → ∃ W : V.left.Opens, v ∈ W ∧ G.obj.map ((wcEtBaseChange p).map (wcEtOpenι X V W)).op g = 0 :=
by
  intro X Y p _ G hVO V g v hfib
  obtain ⟨hNopen, hkill⟩ := hVO ((wcEtBaseChange p).obj V) g
  set N : Set ((wcEtBaseChange p).obj V).left :=
    {o | ∃ (O₁ : Y.Etale) (c : O₁ ⟶ (wcEtBaseChange p).obj V), o ∈ Set.range c.left ∧
      G.obj.map c.op g = 0} with hN
  have hcl : IsClosedMap (Limits.pullback.fst V.hom p) :=
    Scheme.Hom.isClosedMap (Limits.pullback.fst V.hom p)
  have hC : IsClosed Nᶜ := hNopen.isClosed_compl
  have hK : IsClosed ((Limits.pullback.fst V.hom p) '' Nᶜ) := hcl _ hC
  let W : V.left.Opens := ⟨((Limits.pullback.fst V.hom p) '' Nᶜ)ᶜ, hK.isOpen_compl⟩
  have hvW : v ∈ W := by
    rintro ⟨z, hzC, hzv⟩
    exact hzC (hfib z hzv)
  refine ⟨W, hvW, hkill _ _ ?_⟩
  have h0 : (Limits.pullback.fst (wcEtOpen X V W).hom p ≫ (wcEtOpenι X V W).left) ≫ V.hom =
      Limits.pullback.snd (wcEtOpen X V W).hom p ≫ p := by
    rw [Category.assoc, MorphismProperty.Over.w (wcEtOpenι X V W)]
    exact Limits.pullback.condition
  have hmap : ((wcEtBaseChange p).map (wcEtOpenι X V W)).left =
      Limits.pullback.lift (Limits.pullback.fst (wcEtOpen X V W).hom p ≫ (wcEtOpenι X V W).left)
        (Limits.pullback.snd (wcEtOpen X V W).hom p) h0 := rfl
  have hside : ((wcEtBaseChange p).map (wcEtOpenι X V W)).left ≫ Limits.pullback.fst V.hom p =
      Limits.pullback.fst (wcEtOpen X V W).hom p ≫ W.ι := by
    rw [hmap]
    exact Limits.pullback.lift_fst _ _ _
  rintro _ ⟨t, rfl⟩
  by_contra hNt
  have e1 : (((wcEtBaseChange p).map (wcEtOpenι X V W)).left ≫ Limits.pullback.fst V.hom p) t =
      (Limits.pullback.fst (wcEtOpen X V W).hom p ≫ W.ι) t := by rw [hside]; rfl
  have e2 : Limits.pullback.fst V.hom p (((wcEtBaseChange p).map (wcEtOpenι X V W)).left t) =
      W.ι (Limits.pullback.fst (wcEtOpen X V W).hom p t) :=
    (Scheme.Hom.comp_apply _ _ _).symm.trans (e1.trans (Scheme.Hom.comp_apply _ _ _))
  have h3 : W.ι (Limits.pullback.fst (wcEtOpen X V W).hom p t) ∈ (W : Set V.left) :=
    (Scheme.Opens.range_ι W).subset ⟨_, rfl⟩
  have hW : Limits.pullback.fst V.hom p (((wcEtBaseChange p).map (wcEtOpenι X V W)).left t)
      ∈ (W : Set V.left) := Eq.mpr (congrArg (· ∈ (W : Set V.left)) e2) h3
  exact hW ⟨_, hNt, rfl⟩

