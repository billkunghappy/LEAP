        FractionalIdeal.count K w (FractionalIdeal.spanSingleton (nonZeroDivisors R) (f : K)) :=
      fun f => rfl
    have hint : ∀ f : Kˣ, 0 ≤ o (Additive.ofMul f) ↔ ∃ r : R, algebraMap R K r = (f : K) := by
      intro f
      rw [ho]
      exact (dvr_count_spanSingleton R K w (f : K) f.ne_zero).1.symm
    have hmul : ∀ f g : Kˣ,
        o (Additive.ofMul (f * g)) = o (Additive.ofMul f) + o (Additive.ofMul g) := by
      intro f g
      rw [ofMul_mul, map_add]
    have hinv : ∀ f : Kˣ, o (Additive.ofMul f⁻¹) = - o (Additive.ofMul f) := by
      intro f
      rw [ofMul_inv, map_neg]
    have key : ∀ f g h : Kˣ, (h : K) = (f : K) + (g : K) →
        o (Additive.ofMul f) ≤ o (Additive.ofMul g) →
        o (Additive.ofMul f) ≤ o (Additive.ofMul h) := by
      intro f g h hh hle
