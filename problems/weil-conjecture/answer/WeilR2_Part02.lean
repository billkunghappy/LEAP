theorem wc_dev_graph_transfer : ∀ (X : Scheme.{u}) (G M : X.Modules) (U : X.Opens) (γ : Γ(G, U)) (t : Γ(M, U)), IsAffineOpen U → wcQcoh G → (∀ a : Γ(X, U), a • γ = 0 → a • t = 0) → ∀ (W : X.Opens) (hWU : W ≤ U) (c : Γ(X, W)), c • G.presheaf.map (homOfLE hWU).op γ = 0 → c • M.presheaf.map (homOfLE hWU).op t = 0 :=
by
  intro X G M U γ t hU hG hAnn W hWU c hc

  have comp : ∀ (N : X.Modules) {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (s : Γ(N, A)), N.presheaf.map (homOfLE h2).op (N.presheaf.map (homOfLE h1).op s) =
        N.presheaf.map (homOfLE h3).op s := by
    intro N A B C h1 h2 h3 s
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl

  have s1 : ∀ (f : Γ(X, U)) (c' : Γ(X, X.basicOpen f)),
      c' • G.presheaf.map (homOfLE (X.basicOpen_le f)).op γ = 0 →
      c' • M.presheaf.map (homOfLE (X.basicOpen_le f)).op t = 0 := by
    intro f c' hc'
    letI := hU.isLocalization_basicOpen f
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (Submonoid.powers f) c'
    have hsu : IsUnit (X.presheaf.map (homOfLE (X.basicOpen_le f)).op (s : Γ(X, U))) :=
      IsLocalization.map_units Γ(X, X.basicOpen f) s
    have hfu : IsUnit (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) :=
      IsLocalization.Away.algebraMap_isUnit f
    change c' * X.presheaf.map (homOfLE (X.basicOpen_le f)).op (s : Γ(X, U)) =
      X.presheaf.map (homOfLE (X.basicOpen_le f)).op a at hs
    have h1 : G.presheaf.map (homOfLE (X.basicOpen_le f)).op (a • γ) = 0 := by
      rw [Scheme.Modules.map_smul, ← hs, mul_comm, mul_smul, hc', smul_zero]
    obtain ⟨N, hN⟩ := (hG U hU f).2 (a • γ) h1
    rw [smul_smul] at hN
    have h2 := hAnn _ hN
    have h3 : M.presheaf.map (homOfLE (X.basicOpen_le f)).op ((f ^ N * a) • t) = 0 := by
      rw [h2, map_zero]
    rw [Scheme.Modules.map_smul, map_mul, mul_smul, map_pow, (hfu.pow N).smul_eq_zero] at h3
    rw [← hsu.smul_eq_zero, smul_smul, mul_comm _ c', hs]
    exact h3

  have s2 : ∀ τ : Γ(M, W), (∀ (f : Γ(X, U)) (h : X.basicOpen f ≤ W),
      M.presheaf.map (homOfLE h).op τ = 0) → τ = 0 := by
    intro τ hτ
    choose f hfle hmem using fun x : W => hU.exists_basicOpen_le x (hWU x.2)
    have hcov : W ≤ ⨆ x, X.basicOpen (f x) := fun y hy =>
      (TopologicalSpace.Opens.mem_iSup).mpr ⟨⟨y, hy⟩, hmem ⟨y, hy⟩⟩
    exact TopCat.Sheaf.eq_of_locally_eq' ⟨M.presheaf, M.isSheaf⟩ (fun x => X.basicOpen (f x)) W
      (fun x => homOfLE (hfle x)) hcov τ 0
      (fun x => (hτ (f x) (hfle x)).trans (map_zero _).symm)

  apply s2
  intro f h
  have hG' : X.presheaf.map (homOfLE h).op c •
      G.presheaf.map (homOfLE (X.basicOpen_le f)).op γ = 0 := by
    have e : G.presheaf.map (homOfLE h).op (c • G.presheaf.map (homOfLE hWU).op γ) = 0 := by
      rw [hc, map_zero]
    rw [Scheme.Modules.map_smul, comp G hWU h (X.basicOpen_le f)] at e
    exact e
  have key := s1 f (X.presheaf.map (homOfLE h).op c) hG'
  rw [Scheme.Modules.map_smul, comp M hWU h (X.basicOpen_le f)]
  exact key

theorem wc_dev_graph_local_gen : ∀ (X : Scheme.{u}) (G : X.Modules) (U : X.Opens) (γ : Γ(G, U)), IsAffineOpen U → wcQcoh G → (∀ g : Γ(G, U), ∃ a : Γ(X, U), g = a • γ) → ∀ (V : X.Opens), V ≤ U → ∀ (g : Γ(G, V)) (x : X), x ∈ V → ∃ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U) (c : Γ(X, W)), IsAffineOpen W ∧ x ∈ W ∧ G.presheaf.map (homOfLE hWV).op g = c • G.presheaf.map (homOfLE hWU).op γ :=
by
  intro X G U γ hU hG hGen V hVU g x hx
  obtain ⟨f, hWV, hxW⟩ := hU.exists_basicOpen_le (V := V) ⟨x, hx⟩ (hVU hx)
  obtain ⟨n, τ, hτ⟩ := (hG U hU f).1 (G.presheaf.map (homOfLE hWV).op g)
  obtain ⟨a, rfl⟩ := hGen τ
  have hu : IsUnit (((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f) ^ n) :=
    (X.toRingedSpace.isUnit_res_basicOpen f).pow n
  have h2 : (G.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (a • γ) =
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a •
        (G.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom γ :=
    Scheme.Modules.map_smul _ _ _ _
  refine ⟨X.basicOpen f, hWV, X.basicOpen_le f,
    ((hu.unit⁻¹ : (Γ(X, X.basicOpen f))ˣ) : Γ(X, X.basicOpen f)) *
      (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a, hU.basicOpen f, hxW, ?_⟩
  change (G.presheaf.map (homOfLE hWV).op).hom g = _ •
    (G.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom γ
  rw [mul_smul, ← h2, ← hτ, smul_smul, hu.val_inv_mul, one_smul]

theorem wc_dev_graph_glue_gen : ∀ (X : Scheme.{u}) (G M : X.Modules) (U : X.Opens) (γ : Γ(G, U)) (t : Γ(M, U)) (Ψ : ∀ V : X.Opens, Γ(G, V) → Γ(M, V) → Prop), (∀ (V : X.Opens) (g : Γ(G, V)) (m : Γ(M, V)), Ψ V g m ↔ ∀ x ∈ V, x ∈ U → ∃ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U) (c : Γ(X, W)), x ∈ W ∧ G.presheaf.map (homOfLE hWV).op g = c • G.presheaf.map (homOfLE hWU).op γ ∧ M.presheaf.map (homOfLE hWV).op m = c • M.presheaf.map (homOfLE hWU).op t) → (∀ (W : X.Opens) (hWU : W ≤ U) (c : Γ(X, W)), c • G.presheaf.map (homOfLE hWU).op γ = 0 → c • M.presheaf.map (homOfLE hWU).op t = 0) → ∀ (V : X.Opens) (g : Γ(G, V)), (∀ x ∈ V, ∃ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U) (c : Γ(X, W)), IsAffineOpen W ∧ x ∈ W ∧ G.presheaf.map (homOfLE hWV).op g = c • G.presheaf.map (homOfLE hWU).op γ) → ∃ m : Γ(M, V), Ψ V g m :=
by
  intro X G M U γ t Ψ hΨ hT V g hloc
  have hR : ∀ (N : X.Modules) {W W' W'' : X.Opens} (h1 : W' ≤ W) (h2 : W'' ≤ W') (x : Γ(N, W)),
      N.presheaf.map (homOfLE h2).op (N.presheaf.map (homOfLE h1).op x) =
        N.presheaf.map (homOfLE (h2.trans h1)).op x := by
    intro N W W' W'' h1 h2 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hS : ∀ (N : X.Modules) {W W' : X.Opens} (h : W' ≤ W) (r : Γ(X, W)) (x : Γ(N, W)),
      N.presheaf.map (homOfLE h).op (r • x) =
        X.presheaf.map (homOfLE h).op r • N.presheaf.map (homOfLE h).op x :=
    fun N W W' h r x => Scheme.Modules.map_smul N (homOfLE h) r x
  choose W hWV hWU c _hA hmem hgW using fun (i : V) => hloc i.1 i.2
  let sf : ∀ i : V, Γ(M, W i) := fun i => c i • M.presheaf.map (homOfLE (hWU i)).op t
  have hcompat : TopCat.Presheaf.IsCompatible M.presheaf W sf := by
    intro i j
    have hOU : W i ⊓ W j ≤ U := le_trans inf_le_left (hWU i)
    have ha : G.presheaf.map (homOfLE (le_trans inf_le_left (hWV i) : W i ⊓ W j ≤ V)).op g =
        X.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op (c i) •
          G.presheaf.map (homOfLE hOU).op γ := by
      have h := congrArg (G.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op) (hgW i)
      rw [hR, hS, hR] at h
      exact h
    have hb : G.presheaf.map (homOfLE (le_trans inf_le_left (hWV i) : W i ⊓ W j ≤ V)).op g =
        X.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op (c j) •
          G.presheaf.map (homOfLE hOU).op γ := by
      have h := congrArg (G.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op) (hgW j)
      rw [hR, hS, hR] at h
      exact h
    have hd := hT _ hOU
      (X.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op (c i) -
        X.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op (c j))
      (by rw [sub_smul, ← ha, ← hb, sub_self])
    rw [sub_smul, sub_eq_zero] at hd
    change M.presheaf.map (homOfLE (inf_le_left : W i ⊓ W j ≤ W i)).op (sf i) =
      M.presheaf.map (homOfLE (inf_le_right : W i ⊓ W j ≤ W j)).op (sf j)
    simp only [sf, hS, hR]
    exact hd
  have hcov : V ≤ iSup W := by
    intro x hx
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hmem ⟨x, hx⟩⟩
  obtain ⟨m, hm, -⟩ := TopCat.Sheaf.existsUnique_gluing'
    (⟨M.presheaf, M.isSheaf⟩ : TopCat.Sheaf Ab X) W V (fun i => homOfLE (hWV i)) hcov sf hcompat
  have hm' : ∀ i, M.presheaf.map (homOfLE (hWV i)).op m = sf i := hm
  refine ⟨m, (hΨ V g m).mpr ?_⟩
  intro x hxV _
  exact ⟨W ⟨x, hxV⟩, hWV _, hWU _, c _, hmem _, hgW _, hm' _⟩

theorem wc_dev_graph_fibre_zero : ∀ (X : Scheme.{u}) (G M : X.Modules) (U : X.Opens) (γ : Γ(G, U)) (t : Γ(M, U)) (Ψ : ∀ V : X.Opens, Γ(G, V) → Γ(M, V) → Prop), (∀ (V : X.Opens) (g : Γ(G, V)) (m : Γ(M, V)), Ψ V g m ↔ ∀ x ∈ V, x ∈ U → ∃ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U) (c : Γ(X, W)), x ∈ W ∧ G.presheaf.map (homOfLE hWV).op g = c • G.presheaf.map (homOfLE hWU).op γ ∧ M.presheaf.map (homOfLE hWV).op m = c • M.presheaf.map (homOfLE hWU).op t) → (∀ (W : X.Opens) (hWU : W ≤ U) (c : Γ(X, W)), c • G.presheaf.map (homOfLE hWU).op γ = 0 → c • M.presheaf.map (homOfLE hWU).op t = 0) → (∀ (W : X.Opens) (hWU : W ≤ U) (c : Γ(X, W)), c • M.presheaf.map (homOfLE hWU).op t = 0 → c • G.presheaf.map (homOfLE hWU).op γ = 0) → (∀ (V : X.Opens) (s : Γ(G, V)), G.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op s = 0 → s = 0) → (∀ (V : X.Opens) (s : Γ(M, V)), M.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op s = 0 → s = 0) → (∀ (V : X.Opens) (μ : Γ(M, V)), Ψ V 0 μ → μ = 0) ∧ (∀ (V : X.Opens) (g : Γ(G, V)), Ψ V g 0 → g = 0) :=
by
  intro X G M U γ t Ψ hΨ hGM hMG hTFG hTFM
  have comp : ∀ (N : X.Modules) {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (s : Γ(N, A)), N.presheaf.map (homOfLE h2).op (N.presheaf.map (homOfLE h1).op s) =
        N.presheaf.map (homOfLE h3).op s := by
    intro N A B C h1 h2 h3 s
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  refine ⟨fun V μ h => ?_, fun V g h => ?_⟩
  · have hx : ∀ x : ↥(V ⊓ U), ∃ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U) (c : Γ(X, W)),
        x.1 ∈ W ∧ G.presheaf.map (homOfLE hWV).op (0 : Γ(G, V)) =
          c • G.presheaf.map (homOfLE hWU).op γ ∧
        M.presheaf.map (homOfLE hWV).op μ = c • M.presheaf.map (homOfLE hWU).op t :=
      fun x => (hΨ V 0 μ).mp h x.1 x.2.1 x.2.2
    choose W hWV hWU c hxW h1 h2 using hx
    have hμ0 : ∀ x, M.presheaf.map (homOfLE (hWV x)).op μ = 0 := by
      intro x
      have e1 : c x • G.presheaf.map (homOfLE (hWU x)).op γ = 0 := by
        rw [← h1 x, map_zero]
      rw [h2 x]
      exact hGM (W x) (hWU x) (c x) e1
    have hcov : V ⊓ U ≤ ⨆ x, W x := fun y hy =>
      (TopologicalSpace.Opens.mem_iSup).mpr ⟨⟨y, hy⟩, hxW ⟨y, hy⟩⟩
    have hres : M.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op μ = 0 :=
      TopCat.Sheaf.eq_of_locally_eq' ⟨M.presheaf, M.isSheaf⟩ W (V ⊓ U)
        (fun x => homOfLE (le_inf (hWV x) (hWU x))) hcov _ 0
        (fun x => ((comp M (inf_le_left : V ⊓ U ≤ V) (le_inf (hWV x) (hWU x)) (hWV x) μ).trans
          (hμ0 x)).trans (map_zero _).symm)
    exact hTFM V μ hres
  · have hx : ∀ x : ↥(V ⊓ U), ∃ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U) (c : Γ(X, W)),
        x.1 ∈ W ∧ G.presheaf.map (homOfLE hWV).op g =
          c • G.presheaf.map (homOfLE hWU).op γ ∧
        M.presheaf.map (homOfLE hWV).op (0 : Γ(M, V)) = c • M.presheaf.map (homOfLE hWU).op t :=
      fun x => (hΨ V g 0).mp h x.1 x.2.1 x.2.2
    choose W hWV hWU c hxW h1 h2 using hx
    have hg0 : ∀ x, G.presheaf.map (homOfLE (hWV x)).op g = 0 := by
      intro x
      have e1 : c x • M.presheaf.map (homOfLE (hWU x)).op t = 0 := by
        rw [← h2 x, map_zero]
      rw [h1 x]
      exact hMG (W x) (hWU x) (c x) e1
    have hcov : V ⊓ U ≤ ⨆ x, W x := fun y hy =>
      (TopologicalSpace.Opens.mem_iSup).mpr ⟨⟨y, hy⟩, hxW ⟨y, hy⟩⟩
    have hres : G.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op g = 0 :=
      TopCat.Sheaf.eq_of_locally_eq' ⟨G.presheaf, G.isSheaf⟩ W (V ⊓ U)
        (fun x => homOfLE (le_inf (hWV x) (hWU x))) hcov _ 0
        (fun x => ((comp G (inf_le_left : V ⊓ U ≤ V) (le_inf (hWV x) (hWU x)) (hWV x) g).trans
          (hg0 x)).trans (map_zero _).symm)
    exact hTFG V g hres

theorem wc_dev_graph_qcoh_ext : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsNoetherian X] (G M : X.Modules) (U : X.Opens) (γ : Γ(G, U)) (t : Γ(M, U)) (Ψ : ∀ V : X.Opens, Γ(G, V) → Γ(M, V) → Prop), (∀ (V : X.Opens) (g : Γ(G, V)) (m : Γ(M, V)), Ψ V g m ↔ ∀ x ∈ V, x ∈ U → ∃ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U) (c : Γ(X, W)), x ∈ W ∧ G.presheaf.map (homOfLE hWV).op g = c • G.presheaf.map (homOfLE hWU).op γ ∧ M.presheaf.map (homOfLE hWV).op m = c • M.presheaf.map (homOfLE hWU).op t) → wcQcoh G → wcQcoh M → (∀ (W : X.Opens) (hWU : W ≤ U) (c : Γ(X, W)), c • G.presheaf.map (homOfLE hWU).op γ = 0 → c • M.presheaf.map (homOfLE hWU).op t = 0) → (∀ (V : X.Opens), V ≤ U → ∀ (g : Γ(G, V)) (x : X), x ∈ V → ∃ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U) (c : Γ(X, W)), IsAffineOpen W ∧ x ∈ W ∧ G.presheaf.map (homOfLE hWV).op g = c • G.presheaf.map (homOfLE hWU).op γ) → ∀ (W : X.Opens), IsAffineOpen W → ∀ (f : Γ(X, W)) (g : Γ(G, X.basicOpen f)) (m : Γ(M, X.basicOpen f)), Ψ (X.basicOpen f) g m → ∃ (n : ℕ) (g' : Γ(G, W)) (m' : Γ(M, W)), Ψ W g' m' ∧ ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f) ^ n • g = (G.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom g' ∧ ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom f) ^ n • m = (M.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom m' :=
by
  intro X _ G M U γ t Ψ hΨ hG hM hTr hLG W hW f g m hΨD
  classical

  have comp : ∀ (N : X.Modules) {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (s : Γ(N, A)), N.presheaf.map (homOfLE h2).op (N.presheaf.map (homOfLE h1).op s) =
        N.presheaf.map (homOfLE h3).op s := by
    intro N A B C h1 h2 h3 s
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have compX : ∀ {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (s : Γ(X, A)), X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op s) =
        X.presheaf.map (homOfLE h3).op s := by
    intro A B C h1 h2 h3 s
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hDW : X.basicOpen f ≤ W := X.basicOpen_le f

  obtain ⟨n₁, g₁, hg₁⟩ := (hG W hW f).1 g
  obtain ⟨n₂, m₁, hm₁⟩ := (hM W hW f).1 m
  have hg₁' : X.presheaf.map (homOfLE (X.basicOpen_le f)).op f ^ n₁ • g =
      G.presheaf.map (homOfLE (X.basicOpen_le f)).op g₁ := hg₁
  have hm₁' : X.presheaf.map (homOfLE (X.basicOpen_le f)).op f ^ n₂ • m =
      M.presheaf.map (homOfLE (X.basicOpen_le f)).op m₁ := hm₁
  obtain ⟨n₀, g₀, m₀, h1, h2⟩ : ∃ (n₀ : ℕ) (g₀ : Γ(G, W)) (m₀ : Γ(M, W)),
      X.presheaf.map (homOfLE (X.basicOpen_le f)).op f ^ n₀ • g =
        G.presheaf.map (homOfLE (X.basicOpen_le f)).op g₀ ∧
      X.presheaf.map (homOfLE (X.basicOpen_le f)).op f ^ n₀ • m =
        M.presheaf.map (homOfLE (X.basicOpen_le f)).op m₀ := by
    refine ⟨n₁ + n₂, f ^ n₂ • g₁, f ^ n₁ • m₁, ?_, ?_⟩
    · rw [Scheme.Modules.map_smul, map_pow, ← hg₁', smul_smul, ← pow_add, add_comm]
    · rw [Scheme.Modules.map_smul, map_pow, ← hm₁', smul_smul, ← pow_add]
  have hΨD' := (hΨ _ g m).mp hΨD

  have key : ∀ x : (W ⊓ U : X.Opens), ∃ (O : X.Opens) (r : ℕ), x.1 ∈ O ∧
      ∃ (hOW : O ≤ W) (hOU : O ≤ U) (c : Γ(X, O)),
        G.presheaf.map (homOfLE hOW).op g₀ = c • G.presheaf.map (homOfLE hOU).op γ ∧
        X.presheaf.map (homOfLE hOW).op f ^ r •
          (M.presheaf.map (homOfLE hOW).op m₀ - c • M.presheaf.map (homOfLE hOU).op t) = 0 := by
    intro x
    obtain ⟨O, hOV, hOU, c, hOaff, hxO, hc⟩ := hLG (W ⊓ U) inf_le_right
      (G.presheaf.map (homOfLE (inf_le_left : W ⊓ U ≤ W)).op g₀) x.1 x.2
    have hOW : O ≤ W := hOV.trans inf_le_left
    rw [comp G (inf_le_left : W ⊓ U ≤ W) hOV hOW] at hc
    have hPO : O ⊓ X.basicOpen f ≤ O := inf_le_left

    have hdef : M.presheaf.map (homOfLE hPO).op
        (M.presheaf.map (homOfLE hOW).op m₀ - c • M.presheaf.map (homOfLE hOU).op t) = 0 := by
      have hyp : ∀ y : (O ⊓ X.basicOpen f : X.Opens), ∃ (W' : X.Opens)
          (hW'D : W' ≤ X.basicOpen f) (hW'U : W' ≤ U) (e : Γ(X, W')), y.1 ∈ W' ∧
          G.presheaf.map (homOfLE hW'D).op g = e • G.presheaf.map (homOfLE hW'U).op γ ∧
          M.presheaf.map (homOfLE hW'D).op m = e • M.presheaf.map (homOfLE hW'U).op t :=
        fun y => hΨD' y.1 (TopologicalSpace.Opens.mem_inf.mp y.2).2
          (hOU (TopologicalSpace.Opens.mem_inf.mp y.2).1)
      choose Wy hWyD hWyU e hyW hge hme using hyp
      have hcov : O ⊓ X.basicOpen f ≤ ⨆ y, (O ⊓ X.basicOpen f ⊓ Wy y) := fun z hz =>
        (TopologicalSpace.Opens.mem_iSup).mpr
          ⟨⟨z, hz⟩, TopologicalSpace.Opens.mem_inf.mpr ⟨hz, hyW ⟨z, hz⟩⟩⟩
      refine TopCat.Sheaf.eq_of_locally_eq' ⟨M.presheaf, M.isSheaf⟩
        (fun y => O ⊓ X.basicOpen f ⊓ Wy y) (O ⊓ X.basicOpen f)
        (fun y => homOfLE inf_le_left) hcov _ 0 ?_
      intro y
      have hQP : O ⊓ X.basicOpen f ⊓ Wy y ≤ O ⊓ X.basicOpen f := inf_le_left
      have hQO : O ⊓ X.basicOpen f ⊓ Wy y ≤ O := hQP.trans hPO
      have hQD : O ⊓ X.basicOpen f ⊓ Wy y ≤ X.basicOpen f := hQP.trans inf_le_right
      have hQW' : O ⊓ X.basicOpen f ⊓ Wy y ≤ Wy y := inf_le_right
      have hQU : O ⊓ X.basicOpen f ⊓ Wy y ≤ U := hQO.trans hOU
      have hQW : O ⊓ X.basicOpen f ⊓ Wy y ≤ W := hQO.trans hOW
      change M.presheaf.map (homOfLE hQP).op (M.presheaf.map (homOfLE hPO).op
        (M.presheaf.map (homOfLE hOW).op m₀ - c • M.presheaf.map (homOfLE hOU).op t)) =
        M.presheaf.map (homOfLE hQP).op 0
      have eg : G.presheaf.map (homOfLE hQW).op g₀ =
          (X.presheaf.map (homOfLE hQW).op f ^ n₀ * X.presheaf.map (homOfLE hQW').op (e y)) •
            G.presheaf.map (homOfLE hQU).op γ := by
        rw [← comp G hDW hQD hQW g₀, ← h1, Scheme.Modules.map_smul, map_pow,
          compX (X.basicOpen_le f) hQD hQW f, ← comp G (hWyD y) hQW' hQD g, hge y,
          Scheme.Modules.map_smul, comp G (hWyU y) hQW' hQU γ, mul_smul]
      have em : M.presheaf.map (homOfLE hQW).op m₀ =
          (X.presheaf.map (homOfLE hQW).op f ^ n₀ * X.presheaf.map (homOfLE hQW').op (e y)) •
            M.presheaf.map (homOfLE hQU).op t := by
        rw [← comp M hDW hQD hQW m₀, ← h2, Scheme.Modules.map_smul, map_pow,
          compX (X.basicOpen_le f) hQD hQW f, ← comp M (hWyD y) hQW' hQD m, hme y,
          Scheme.Modules.map_smul, comp M (hWyU y) hQW' hQU t, mul_smul]
      have ec : G.presheaf.map (homOfLE hQW).op g₀ =
          X.presheaf.map (homOfLE hQO).op c • G.presheaf.map (homOfLE hQU).op γ := by
        rw [← comp G hOW hQO hQW g₀, hc, Scheme.Modules.map_smul, comp G hOU hQO hQU γ]
      have hd : (X.presheaf.map (homOfLE hQO).op c -
          X.presheaf.map (homOfLE hQW).op f ^ n₀ * X.presheaf.map (homOfLE hQW').op (e y)) •
            G.presheaf.map (homOfLE hQU).op γ = 0 := by
        rw [sub_smul, ← ec, ← eg, sub_self]
      have hd' := hTr _ hQU _ hd
      rw [map_zero, comp M hPO hQP hQO, map_sub, Scheme.Modules.map_smul,
        comp M hOW hQO hQW m₀, comp M hOU hQO hQU t, em, ← sub_smul, ← neg_sub, neg_smul, hd',
        neg_zero]

    obtain ⟨r, hr⟩ : ∃ r : ℕ, X.presheaf.map (homOfLE hOW).op f ^ r •
        (M.presheaf.map (homOfLE hOW).op m₀ - c • M.presheaf.map (homOfLE hOU).op t) = 0 := by
      have hbo : X.basicOpen (X.presheaf.map (homOfLE hOW).op f) = O ⊓ X.basicOpen f :=
        Scheme.basicOpen_res X f (homOfLE hOW).op
      have hle : X.basicOpen (X.presheaf.map (homOfLE hOW).op f) ≤ O ⊓ X.basicOpen f := hbo.le
      refine (hM O hOaff (X.presheaf.map (homOfLE hOW).op f)).2 _ ?_
      change M.presheaf.map (homOfLE (X.basicOpen_le _)).op
        (M.presheaf.map (homOfLE hOW).op m₀ - c • M.presheaf.map (homOfLE hOU).op t) = 0
      rw [← comp M hPO hle (X.basicOpen_le _), hdef, map_zero]
    exact ⟨O, r, hxO, hOW, hOU, c, hc, hr⟩

  choose O r hxO hOW hOU c hc hr using key
  obtain ⟨T, hT⟩ := (TopologicalSpace.NoetherianSpace.isCompact
    ((W ⊓ U : X.Opens) : Set X)).elim_finite_subcover (fun i => (O i : Set X))
    (fun i => (O i).isOpen) (fun z hz => Set.mem_iUnion.mpr ⟨⟨z, hz⟩, hxO ⟨z, hz⟩⟩)

  refine ⟨T.sup r + n₀, f ^ (T.sup r) • g₀, f ^ (T.sup r) • m₀, ?_, ?_, ?_⟩
  · refine (hΨ _ _ _).mpr ?_
    intro x hxW hxU
    have hx : x ∈ W ⊓ U := TopologicalSpace.Opens.mem_inf.mpr ⟨hxW, hxU⟩
    obtain ⟨i, hiT, hxi⟩ := Set.mem_iUnion₂.mp (hT hx)
    have hR : X.presheaf.map (homOfLE (hOW i)).op f ^ (T.sup r) •
        (M.presheaf.map (homOfLE (hOW i)).op m₀ -
          c i • M.presheaf.map (homOfLE (hOU i)).op t) = 0 := by
      rw [← pow_sub_mul_pow _ (Finset.le_sup hiT : r i ≤ T.sup r), mul_smul, hr i, smul_zero]
    refine ⟨O i, hOW i, hOU i, X.presheaf.map (homOfLE (hOW i)).op f ^ (T.sup r) * c i, hxi,
      ?_, ?_⟩
    · rw [Scheme.Modules.map_smul, map_pow, hc i, mul_smul]
    · rw [Scheme.Modules.map_smul, map_pow, mul_smul]
      rw [smul_sub, sub_eq_zero] at hR
      exact hR
  · show X.presheaf.map (homOfLE (X.basicOpen_le f)).op f ^ (T.sup r + n₀) • g =
      G.presheaf.map (homOfLE (X.basicOpen_le f)).op (f ^ (T.sup r) • g₀)
    rw [Scheme.Modules.map_smul, map_pow, ← h1, smul_smul, ← pow_add]
  · show X.presheaf.map (homOfLE (X.basicOpen_le f)).op f ^ (T.sup r + n₀) • m =
      M.presheaf.map (homOfLE (X.basicOpen_le f)).op (f ^ (T.sup r) • m₀)
    rw [Scheme.Modules.map_smul, map_pow, ← h2, smul_smul, ← pow_add]

theorem wc_dev_graph_pred_closure : ∀ (X : Scheme.{u}) (G M : X.Modules) (U : X.Opens) (γ : Γ(G, U)) (t : Γ(M, U)) (Ψ : ∀ V : X.Opens, Γ(G, V) → Γ(M, V) → Prop), (∀ (V : X.Opens) (g : Γ(G, V)) (m : Γ(M, V)), Ψ V g m ↔ ∀ x ∈ V, x ∈ U → ∃ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U) (c : Γ(X, W)), x ∈ W ∧ G.presheaf.map (homOfLE hWV).op g = c • G.presheaf.map (homOfLE hWU).op γ ∧ M.presheaf.map (homOfLE hWV).op m = c • M.presheaf.map (homOfLE hWU).op t) → (∀ V, Ψ V 0 0) ∧ (∀ V g m g' m', Ψ V g m → Ψ V g' m' → Ψ V (g + g') (m + m')) ∧ (∀ V (a : Γ(X, V)) g m, Ψ V g m → Ψ V (a • g) (a • m)) ∧ (∀ V W (h : W ≤ V) g m, Ψ V g m → Ψ W (G.presheaf.map (homOfLE h).op g) (M.presheaf.map (homOfLE h).op m)) ∧ (∀ V g m, (∀ x ∈ V, ∃ (W : X.Opens) (h : W ≤ V), x ∈ W ∧ Ψ W (G.presheaf.map (homOfLE h).op g) (M.presheaf.map (homOfLE h).op m)) → Ψ V g m) ∧ Ψ U γ t :=
by
  intro X G M U γ t Ψ hΨ
  have hR : ∀ (N : X.Modules) {W W' W'' : X.Opens} (h1 : W' ≤ W) (h2 : W'' ≤ W') (x : Γ(N, W)),
      N.presheaf.map (homOfLE h2).op (N.presheaf.map (homOfLE h1).op x) =
        N.presheaf.map (homOfLE (h2.trans h1)).op x := by
    intro N W W' W'' h1 h2 x
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have hS : ∀ (N : X.Modules) {W W' : X.Opens} (h : W' ≤ W) (r : Γ(X, W)) (x : Γ(N, W)),
      N.presheaf.map (homOfLE h).op (r • x) =
        X.presheaf.map (homOfLE h).op r • N.presheaf.map (homOfLE h).op x :=
    fun N W W' h r x => Scheme.Modules.map_smul N (homOfLE h) r x
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro V
    refine (hΨ V 0 0).mpr ?_
    intro x hxV hxU
    exact ⟨V ⊓ U, inf_le_left, inf_le_right, 0, ⟨hxV, hxU⟩,
      by rw [map_zero, zero_smul], by rw [map_zero, zero_smul]⟩
  ·
    intro V g m g' m' H1 H2
    refine (hΨ V _ _).mpr ?_
    intro x hxV hxU
    obtain ⟨W₁, h₁V, h₁U, c₁, hx₁, eg₁, em₁⟩ := (hΨ V g m).mp H1 x hxV hxU
    obtain ⟨W₂, h₂V, h₂U, c₂, hx₂, eg₂, em₂⟩ := (hΨ V g' m').mp H2 x hxV hxU
    have hWV : W₁ ⊓ W₂ ≤ V := le_trans inf_le_left h₁V
    have hWU : W₁ ⊓ W₂ ≤ U := le_trans inf_le_left h₁U
    have a1 : G.presheaf.map (homOfLE hWV).op g =
        X.presheaf.map (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op c₁ •
          G.presheaf.map (homOfLE hWU).op γ := by
      have h := congrArg (G.presheaf.map (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op) eg₁
      rw [hR, hS, hR] at h
      exact h
    have b1 : G.presheaf.map (homOfLE hWV).op g' =
        X.presheaf.map (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op c₂ •
          G.presheaf.map (homOfLE hWU).op γ := by
      have h := congrArg (G.presheaf.map (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op) eg₂
      rw [hR, hS, hR] at h
      exact h
    have a2 : M.presheaf.map (homOfLE hWV).op m =
        X.presheaf.map (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op c₁ •
          M.presheaf.map (homOfLE hWU).op t := by
      have h := congrArg (M.presheaf.map (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op) em₁
      rw [hR, hS, hR] at h
      exact h
    have b2 : M.presheaf.map (homOfLE hWV).op m' =
        X.presheaf.map (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op c₂ •
          M.presheaf.map (homOfLE hWU).op t := by
      have h := congrArg (M.presheaf.map (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op) em₂
      rw [hR, hS, hR] at h
      exact h
    refine ⟨W₁ ⊓ W₂, hWV, hWU,
      X.presheaf.map (homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op c₁ +
        X.presheaf.map (homOfLE (inf_le_right : W₁ ⊓ W₂ ≤ W₂)).op c₂, ⟨hx₁, hx₂⟩, ?_, ?_⟩
    · rw [map_add, a1, b1, add_smul]
    · rw [map_add, a2, b2, add_smul]
  ·
    intro V a g m H
    refine (hΨ V _ _).mpr ?_
    intro x hxV hxU
    obtain ⟨W, hWV, hWU, c, hx, eg, em⟩ := (hΨ V g m).mp H x hxV hxU
    refine ⟨W, hWV, hWU, X.presheaf.map (homOfLE hWV).op a * c, hx, ?_, ?_⟩
    · rw [hS, eg, smul_smul]
    · rw [hS, em, smul_smul]
  ·
    intro V W₀ h g m H
    refine (hΨ W₀ _ _).mpr ?_
    intro x hxW₀ hxU
    obtain ⟨W, hWV, hWU, c, hx, eg, em⟩ := (hΨ V g m).mp H x (h hxW₀) hxU
    refine ⟨W ⊓ W₀, inf_le_right, le_trans inf_le_left hWU,
      X.presheaf.map (homOfLE (inf_le_left : W ⊓ W₀ ≤ W)).op c, ⟨hx, hxW₀⟩, ?_, ?_⟩
    · have e := congrArg (G.presheaf.map (homOfLE (inf_le_left : W ⊓ W₀ ≤ W)).op) eg
      rw [hR, hS, hR] at e
      rw [hR]
      exact e
    · have e := congrArg (M.presheaf.map (homOfLE (inf_le_left : W ⊓ W₀ ≤ W)).op) em
      rw [hR, hS, hR] at e
      rw [hR]
      exact e
  ·
    intro V g m H
    refine (hΨ V g m).mpr ?_
    intro x hxV hxU
    obtain ⟨W, h, hxW, HW⟩ := H x hxV
    obtain ⟨W', hW'W, hW'U, c, hx', eg, em⟩ := (hΨ W _ _).mp HW x hxW hxU
    rw [hR] at eg em
    exact ⟨W', le_trans hW'W h, hW'U, c, hx', eg, em⟩
  ·
    refine (hΨ U γ t).mpr ?_
    intro x hxU _
    exact ⟨U, le_rfl, le_rfl, 1, hxU, (one_smul _ _).symm, (one_smul _ _).symm⟩

theorem wc_dev_pair_subsheaf : ∀ (X : Scheme.{u}) (G M : X.Modules) (Ψ : ∀ V : X.Opens, Γ(G, V) → Γ(M, V) → Prop), (∀ V, Ψ V 0 0) → (∀ V g m g' m', Ψ V g m → Ψ V g' m' → Ψ V (g + g') (m + m')) → (∀ V (a : Γ(X, V)) g m, Ψ V g m → Ψ V (a • g) (a • m)) → (∀ V W (h : W ≤ V) g m, Ψ V g m → Ψ W (G.presheaf.map (homOfLE h).op g) (M.presheaf.map (homOfLE h).op m)) → (∀ V g m, (∀ x ∈ V, ∃ (W : X.Opens) (h : W ≤ V), x ∈ W ∧ Ψ W (G.presheaf.map (homOfLE h).op g) (M.presheaf.map (homOfLE h).op m)) → Ψ V g m) → ∃ (E : X.Modules) (α : E ⟶ G) (β : E ⟶ M), (∀ (V : X.Opens) (e e' : Γ(E, V)), Scheme.Modules.Hom.app α V e = Scheme.Modules.Hom.app α V e' → Scheme.Modules.Hom.app β V e = Scheme.Modules.Hom.app β V e' → e = e') ∧ ∀ (V : X.Opens) (g : Γ(G, V)) (m : Γ(M, V)), (∃ e : Γ(E, V), Scheme.Modules.Hom.app α V e = g ∧ Scheme.Modules.Hom.app β V e = m) ↔ Ψ V g m :=
by
  intro X G M Ψ h0 hadd hsmul hres hloc
  classical
  let S : ∀ V : X.Opens, Submodule Γ(X, V) (Γ(G, V) × Γ(M, V)) := fun V =>
    { carrier := {p | Ψ V p.1 p.2}
      add_mem' := fun {a b} ha hb => hadd V a.1 a.2 b.1 b.2 ha hb
      zero_mem' := h0 V
      smul_mem' := fun c p hp => hsmul V c p.1 p.2 hp }
  let P : (X.Opens)ᵒᵖ ⥤ Ab.{u} :=
    { obj := fun V => AddCommGrpCat.of (S V.unop)
      map := fun {V W} i => AddCommGrpCat.ofHom
        { toFun := fun p => ⟨((G.presheaf.map i).hom p.1.1, (M.presheaf.map i).hom p.1.2),
            hres V.unop W.unop i.unop.le p.1.1 p.1.2 p.2⟩
          map_zero' := Subtype.ext (Prod.ext (map_zero _) (map_zero _))
          map_add' := fun a b => Subtype.ext (Prod.ext (map_add _ _ _) (map_add _ _ _)) }
      map_id := fun V => by
        ext p
        · change (G.presheaf.map (𝟙 V)).hom p.1.1 = p.1.1
          rw [G.presheaf.map_id]; rfl
        · change (M.presheaf.map (𝟙 V)).hom p.1.2 = p.1.2
          rw [M.presheaf.map_id]; rfl
      map_comp := fun {V W Z} i j => by
        ext p
        · change (G.presheaf.map (i ≫ j)).hom p.1.1 =
            (G.presheaf.map j).hom ((G.presheaf.map i).hom p.1.1)
          rw [G.presheaf.map_comp]; rfl
        · change (M.presheaf.map (i ≫ j)).hom p.1.2 =
            (M.presheaf.map j).hom ((M.presheaf.map i).hom p.1.2)
          rw [M.presheaf.map_comp]; rfl }
  letI inst : ∀ V : (X.Opens)ᵒᵖ, Module ↑(X.ringCatSheaf.obj.obj V) ↑(P.obj V) := fun V =>
    (inferInstance : Module Γ(X, V.unop) (S V.unop))
  let Pm : PresheafOfModules X.ringCatSheaf.obj := PresheafOfModules.ofPresheaf P (by
    intro V W f r p
    apply Subtype.ext
    exact Prod.ext (Scheme.Modules.map_smul G f.unop r p.1.1)
      (Scheme.Modules.map_smul M f.unop r p.1.2))
  have hsh : TopCat.Presheaf.IsSheaf P := by
    rw [TopCat.Presheaf.isSheaf_iff_isSheafUniqueGluing]
    intro ι U sf hcompat
    let sG : ∀ i, Γ(G, U i) := fun i => (sf i).1.1
    let sM : ∀ i, Γ(M, U i) := fun i => (sf i).1.2
    have hcG : TopCat.Presheaf.IsCompatible G.presheaf U sG := by
      intro i j
      exact congrArg (fun q => q.1.1) (hcompat i j)
    have hcM : TopCat.Presheaf.IsCompatible M.presheaf U sM := by
      intro i j
      exact congrArg (fun q => q.1.2) (hcompat i j)
    obtain ⟨g, hg, huG⟩ := TopCat.Sheaf.existsUnique_gluing ⟨G.presheaf, G.isSheaf⟩ U sG hcG
    obtain ⟨m, hm, huM⟩ := TopCat.Sheaf.existsUnique_gluing ⟨M.presheaf, M.isSheaf⟩ U sM hcM
    have hΨ : Ψ (iSup U) g m := by
      apply hloc
      intro x hx
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      refine ⟨U i, le_iSup U i, hi, ?_⟩
      have e1 := hg i
      have e2 := hm i
      change (G.presheaf.map (homOfLE (le_iSup U i)).op).hom g = sG i at e1
      change (M.presheaf.map (homOfLE (le_iSup U i)).op).hom m = sM i at e2
      change Ψ (U i) ((G.presheaf.map (homOfLE (le_iSup U i)).op).hom g)
        ((M.presheaf.map (homOfLE (le_iSup U i)).op).hom m)
      rw [e1, e2]
      exact (sf i).2
    exact ⟨⟨(g, m), hΨ⟩, fun i => Subtype.ext (Prod.ext (hg i) (hm i)),
      fun t ht => Subtype.ext (Prod.ext (huG t.1.1 fun i => congrArg (fun q => q.1.1) (ht i))
        (huM t.1.2 fun i => congrArg (fun q => q.1.2) (ht i)))⟩
  let E : X.Modules := SheafOfModules.mk Pm hsh
  let φG : P ⟶ G.presheaf :=
    { app := fun V => AddCommGrpCat.ofHom
        ((LinearMap.fst Γ(X, V.unop) Γ(G, V.unop) Γ(M, V.unop)).comp
          (S V.unop).subtype).toAddMonoidHom
      naturality := fun V W i => rfl }
  let φM : P ⟶ M.presheaf :=
    { app := fun V => AddCommGrpCat.ofHom
        ((LinearMap.snd Γ(X, V.unop) Γ(G, V.unop) Γ(M, V.unop)).comp
          (S V.unop).subtype).toAddMonoidHom
      naturality := fun V W i => rfl }
  let α : E ⟶ G := ⟨PresheafOfModules.homMk (M₁ := Pm) (M₂ := G.val) φG (fun V r p => rfl)⟩
  let β : E ⟶ M := ⟨PresheafOfModules.homMk (M₁ := Pm) (M₂ := M.val) φM (fun V r p => rfl)⟩
  have hα : ∀ V (e : Γ(E, V)), Scheme.Modules.Hom.app α V e = (e : S V).1.1 := fun V e => rfl
  have hβ : ∀ V (e : Γ(E, V)), Scheme.Modules.Hom.app β V e = (e : S V).1.2 := fun V e => rfl
  refine ⟨E, α, β, ?_, ?_⟩
  · intro V e e' h1 h2
    rw [hα, hα] at h1
    rw [hβ, hβ] at h2
    exact Subtype.ext (Prod.ext h1 h2)
  · intro V g m
    constructor
    · rintro ⟨e, h1, h2⟩
      rw [hα] at h1
      rw [hβ] at h2
      subst h1 h2
      exact (e : S V).2
    · intro h
      exact ⟨(⟨(g, m), h⟩ : S V), rfl, rfl⟩

theorem wc_dev_graph_sub : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsNoetherian X] (G M : X.Modules) (U : X.Opens) (γ : Γ(G, U)) (t : Γ(M, U)), IsAffineOpen U → wcCoherentMod G → wcCoherentMod M → (∀ (V : X.Opens) (s : Γ(G, V)), G.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op s = 0 → s = 0) → (∀ (V : X.Opens) (s : Γ(M, V)), M.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op s = 0 → s = 0) → (∀ g : Γ(G, U), ∃ a : Γ(X, U), g = a • γ) → (∀ a : Γ(X, U), a • γ = 0 ↔ a • t = 0) → ∃ (E : X.Modules) (α : E ⟶ G) (β : E ⟶ M) (ε : Γ(E, U)), Mono α ∧ Mono β ∧ wcCoherentMod E ∧ (∀ V : X.Opens, V ≤ U → Function.Surjective (Scheme.Modules.Hom.app α V)) ∧ Scheme.Modules.Hom.app α U ε = γ ∧ Scheme.Modules.Hom.app β U ε = t :=
by
  intro X _ G M U γ t hU hG hM hTFG hTFM hGen hAnn

  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ∀ V : X.Opens, Γ(G, V) → Γ(M, V) → Prop, ∀ (V : X.Opens) (g : Γ(G, V)) (m : Γ(M, V)), Ψ V g m ↔ ∀ x ∈ V, x ∈ U → ∃ (W : X.Opens) (hWV : W ≤ V) (hWU : W ≤ U) (c : Γ(X, W)), x ∈ W ∧ G.presheaf.map (homOfLE hWV).op g = c • G.presheaf.map (homOfLE hWU).op γ ∧ M.presheaf.map (homOfLE hWV).op m = c • M.presheaf.map (homOfLE hWU).op t :=
    ⟨_, fun _ _ _ => Iff.rfl⟩

  have hGM := wc_dev_graph_transfer X G M U γ t hU hG.1 (fun a h => (hAnn a).mp h)
  have hMG := wc_dev_graph_transfer X M G U t γ hU hM.1 (fun a h => (hAnn a).mpr h)

  have hLG := wc_dev_graph_local_gen X G U γ hU hG.1 hGen

  obtain ⟨h0, hadd, hsmul, hres, hloc, hγt⟩ := wc_dev_graph_pred_closure X G M U γ t Ψ hΨ
  obtain ⟨E, α, β, hJ, hIm⟩ := wc_dev_pair_subsheaf X G M Ψ h0 hadd hsmul hres hloc

  obtain ⟨Z1, Z2⟩ := wc_dev_graph_fibre_zero X G M U γ t Ψ hΨ hGM hMG hTFG hTFM

  have hnat : ∀ {N : X.Modules} (φ : E ⟶ N) (V W : X.Opens) (h : W ≤ V) (s : Γ(E, V)),
      Scheme.Modules.Hom.app φ W (E.presheaf.map (homOfLE h).op s) =
        N.presheaf.map (homOfLE h).op (Scheme.Modules.Hom.app φ V s) :=
    fun φ V W h s => NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf φ) (homOfLE h).op s

  have hαinj : ∀ V, Function.Injective (Scheme.Modules.Hom.app α V) := by
    intro V e e' h
    apply hJ V e e' h
    have hd : Scheme.Modules.Hom.app α V (e - e') = 0 := by rw [map_sub, h, sub_self]
    have hΨd := (hIm V _ _).mp ⟨e - e', hd, rfl⟩
    have h2 := Z1 V _ hΨd
    rw [map_sub, sub_eq_zero] at h2
    exact h2
  have hβinj : ∀ V, Function.Injective (Scheme.Modules.Hom.app β V) := by
    intro V e e' h
    refine hJ V e e' ?_ h
    have hd : Scheme.Modules.Hom.app β V (e - e') = 0 := by rw [map_sub, h, sub_self]
    have hΨd := (hIm V _ _).mp ⟨e - e', rfl, hd⟩
    have h2 := Z2 V _ hΨd
    rw [map_sub, sub_eq_zero] at h2
    exact h2

  have hmono : ∀ {N : X.Modules} (φ : E ⟶ N),
      (∀ V, Function.Injective (Scheme.Modules.Hom.app φ V)) → Mono φ := by
    intro N φ hφ
    constructor
    intro Z f₁ f₂ h
    apply Scheme.Modules.hom_ext
    intro V
    ext z
    apply hφ V
    have h2 := congrArg (fun k => Scheme.Modules.Hom.app k V z) h
    simp only [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply] at h2
    exact h2

  have hsurj : ∀ V : X.Opens, V ≤ U → Function.Surjective (Scheme.Modules.Hom.app α V) := by
    intro V hVU g
    obtain ⟨m, hm⟩ := wc_dev_graph_glue_gen X G M U γ t Ψ hΨ hGM V g
      (fun x hx => hLG V hVU g x hx)
    obtain ⟨e, he, -⟩ := (hIm V g m).mpr hm
    exact ⟨e, he⟩

  obtain ⟨ε, hε1, hε2⟩ := (hIm U γ t).mpr hγt
  refine ⟨E, α, β, ε, hmono α hαinj, hmono β hβinj, ⟨?_, ?_⟩, hsurj, hε1, hε2⟩
  ·
    intro W hW f
    refine ⟨?_, ?_⟩
    · intro s
      obtain ⟨n, g', m', hΨ', hg', hm'⟩ := wc_dev_graph_qcoh_ext X G M U γ t Ψ hΨ hG.1 hM.1 hGM
        hLG W hW f _ _ ((hIm _ _ _).mp ⟨s, rfl, rfl⟩)
      obtain ⟨e', he'1, he'2⟩ := (hIm W g' m').mpr hΨ'
      refine ⟨n, e', ?_⟩
      apply hJ
      · rw [Scheme.Modules.Hom.app_smul]
        refine hg'.trans ?_
        rw [← he'1]
        exact (hnat α W (X.basicOpen f) (X.basicOpen_le f) e').symm
      · rw [Scheme.Modules.Hom.app_smul]
        refine hm'.trans ?_
        rw [← he'2]
        exact (hnat β W (X.basicOpen f) (X.basicOpen_le f) e').symm
    · intro e he
      have h1 : Scheme.Modules.Hom.app α (X.basicOpen f)
          (E.presheaf.map (homOfLE (X.basicOpen_le f)).op e) = 0 := by
        have he' : E.presheaf.map (homOfLE (X.basicOpen_le f)).op e = 0 := he
        rw [he', map_zero]
      obtain ⟨n, hn⟩ := (hG.1 W hW f).2 (Scheme.Modules.Hom.app α W e)
        ((hnat α W (X.basicOpen f) (X.basicOpen_le f) e).symm.trans h1)
      refine ⟨n, hαinj W ?_⟩
      rw [Scheme.Modules.Hom.app_smul, map_zero]
      exact hn
  ·
    intro W hW
    haveI : IsNoetherianRing Γ(X, W) := IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
    haveI := hG.2 W hW
    haveI : _root_.IsNoetherian Γ(X, W) Γ(G, W) := isNoetherian_of_isNoetherianRing_of_finite _ _
    exact Module.Finite.of_injective
      ({ toFun := Scheme.Modules.Hom.app α W
         map_add' := map_add _
         map_smul' := fun r x => Scheme.Modules.Hom.app_smul α r x } :
        Γ(E, W) →ₗ[Γ(X, W)] Γ(G, W)) (hαinj W)

theorem wc_coherent_devissage : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsNoetherian X] (P : X.Modules → Prop), (∀ M : X.Modules, Limits.IsZero M → P M) → (∀ S : ShortComplex X.Modules, S.ShortExact → wcCoherentMod S.X₁ → wcCoherentMod S.X₂ → wcCoherentMod S.X₃ → P S.X₁ → P S.X₃ → P S.X₂) → (∀ S : ShortComplex X.Modules, S.ShortExact → wcCoherentMod S.X₁ → wcCoherentMod S.X₂ → wcCoherentMod S.X₃ → P S.X₂ → P S.X₃ → P S.X₁) → (∀ T : TopologicalSpace.Closeds X, IsIrreducible (T : Set X) → ∃ G : X.Modules, wcCoherentMod G ∧ wcGenRankOne G T ∧ P G) → ∀ M : X.Modules, wcCoherentMod M → P M :=
by
  intro X _ P h0 hA hB h4

  have hzero : ∀ M : X.Modules, (∀ (V : X.Opens) (s : Γ(M, V)), s = 0) → P M := by
    intro M hM
    apply h0
    rw [Limits.IsZero.iff_id_eq_zero]
    apply Scheme.Modules.hom_ext
    intro V
    ext s
    exact (hM _ _).trans (hM _ _).symm

  have hempty : ∀ (M : X.Modules) (V : X.Opens), (V : Set X) = ∅ → ∀ s : Γ(M, V), s = 0 := by
    intro M V hV s
    have hb : V = ⊥ := by ext x; simp [hV]
    subst hb
    have : Subsingleton Γ(X, ⊥) :=
      CommRingCat.subsingleton_of_isTerminal (TopCat.Sheaf.isTerminalOfEqEmpty X.sheaf rfl)
    rw [← one_smul Γ(X, ⊥) s, Subsingleton.elim (1 : Γ(X, ⊥)) 0, zero_smul]

  haveI hwf : WellFoundedLT (TopologicalSpace.Closeds X) :=
    (TopologicalSpace.Closeds.complOrderIso X).toOrderEmbedding.wellFoundedLT

  have key : ∀ Z : TopologicalSpace.Closeds X, ∀ M : X.Modules, wcCoherentMod M →
      (∀ V : X.Opens, Disjoint (V : Set X) (Z : Set X) → ∀ s : Γ(M, V), s = 0) → P M := by
    intro Z
    apply WellFoundedLT.induction Z
    intro Z IH
    by_cases hZe : (Z : Set X) = ∅
    · intro M _ hsupp
      exact hzero M (fun V s => hsupp V (by rw [hZe]; exact Set.disjoint_empty _) s)
    obtain ⟨ξ, hξZ, hξmax⟩ := wc_dev_closeds_generic_point X (Z : Set X) Z.isClosed
      (Set.nonempty_iff_ne_empty.mpr hZe)
    have hIH : ∀ S : Set X, IsClosed S → S ⊆ (Z : Set X) → ξ ∉ S → ∀ M : X.Modules,
        wcCoherentMod M → (∀ V : X.Opens, Disjoint (V : Set X) S → ∀ s : Γ(M, V), s = 0) →
        P M := by
      intro S hS hSZ hξS M hM hsupp
      exact IH ⟨S, hS⟩ (SetLike.lt_iff_le_and_exists.mpr ⟨hSZ, ξ, hξZ, hξS⟩) M hM hsupp
    have hTZ : closure ({ξ} : Set X) ⊆ (Z : Set X) :=
      closure_minimal (Set.singleton_subset_iff.mpr hξZ) Z.isClosed
    obtain ⟨G, hGc, ⟨hGsupp, U, e, hU, hUT, he_surj, he_ker⟩, hPG⟩ :=
      h4 ⟨closure ({ξ} : Set X), isClosed_closure⟩ isIrreducible_singleton.closure
    have hξU : ξ ∈ U := by
      obtain ⟨x, hxU, hxc⟩ := hUT
      obtain ⟨y, hyU, hy⟩ := mem_closure_iff.mp hxc (U : Set X) U.isOpen hxU
      rw [Set.mem_singleton_iff] at hy
      exact hy ▸ hyU
    have hZ1c : IsClosed ((Z : Set X) ∩ (U : Set X)ᶜ) := Z.isClosed.inter U.isOpen.isClosed_compl
    have hT1c : IsClosed (closure ({ξ} : Set X) ∩ (U : Set X)ᶜ) :=
      isClosed_closure.inter U.isOpen.isClosed_compl

    have inner : ∀ n : ℕ, ∀ M : X.Modules, wcCoherentMod M →
        (∀ V : X.Opens, Disjoint (V : Set X) (Z : Set X) → ∀ s : Γ(M, V), s = 0) →
        Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
          (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl Γ(M, U)) = (n : ℕ∞) →
        P M := by
      intro n
      induction n using Nat.strong_induction_on with
      | _ n IHn =>
      intro M hM hMsupp hlen
      rcases Nat.eq_zero_or_pos n with hn0 | hn
      ·
        subst hn0
        obtain ⟨W, hξW, hW⟩ := wc_dev_vanish_near X M (Z : Set X) ξ U hU hξU Z.isClosed hM hMsupp
          (by rw [hlen]; exact Nat.cast_zero)
        exact hIH ((Z : Set X) ∩ (W : Set X)ᶜ) (Z.isClosed.inter W.isOpen.isClosed_compl)
          Set.inter_subset_left (fun h => h.2 hξW) M hM hW
      ·

        obtain ⟨M', ιM, hιMmono, hM'c, hM'tf, hιMsurj⟩ := wc_dev_torsionfree_sub X M U hU hM
        obtain ⟨hSM, hCMc, hιMinj, hSuppM⟩ := wc_dev_cokernel_coh X M' M ιM hιMmono hM'c hM
        obtain ⟨hM'supp, -, hCMsupp⟩ := hSuppM (Z : Set X) U Z.isClosed hMsupp
        have hCMsupp' := hCMsupp hιMsurj
        have hPCM : P (Limits.cokernel ιM) :=
          hIH _ hZ1c Set.inter_subset_left (fun h => h.2 hξU) _ hCMc hCMsupp'

        have hCM0 : Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
            (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl
              Γ(Limits.cokernel ιM, U)) = 0 := by
          have hsec : ∀ s : Γ(Limits.cokernel ιM, U), s = 0 :=
            hCMsupp' U (Set.disjoint_left.mpr (fun x hx hx' => hx'.2 hx))
          haveI : Subsingleton Γ(Limits.cokernel ιM, U) :=
            ⟨fun a b => (hsec a).trans (hsec b).symm⟩
          exact Module.length_eq_zero_iff.mpr inferInstance
        have hlenM : Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
              (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl Γ(M, U)) =
            Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
              (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl Γ(M', U)) +
            Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
              (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl
                Γ(Limits.cokernel ιM, U)) :=
          wc_dev_length_additive X (ShortComplex.mk ιM (Limits.cokernel.π ιM)
            (Limits.cokernel.condition ιM)) U hU ξ hξU hSM hM'c.1
        have hlenM' : Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
            (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl Γ(M', U)) =
            (n : ℕ∞) := by
          rw [hCM0, add_zero] at hlenM
          rw [← hlenM]
          exact hlen

        obtain ⟨G', ιG, hιGmono, hG'c, hG'tf, hιGsurj⟩ := wc_dev_torsionfree_sub X G U hU hGc
        obtain ⟨hSG, hCGc, hιGinj, hSuppG⟩ := wc_dev_cokernel_coh X G' G ιG hιGmono hG'c hGc
        obtain ⟨hG'supp, -, hCGsupp⟩ := hSuppG (closure ({ξ} : Set X)) U isClosed_closure hGsupp
        have hPCG : P (Limits.cokernel ιG) :=
          hIH _ hT1c (fun x hx => hTZ hx.1) (fun h => h.2 hξU) _ hCGc (hCGsupp hιGsurj)
        have hPG' : P G' := hB (ShortComplex.mk ιG (Limits.cokernel.π ιG)
          (Limits.cokernel.condition ιG)) hSG hG'c hGc hCGc hPG hPCG

        obtain ⟨γ, hγ⟩ := hιGsurj U le_rfl (e 1)
        have hγe : ∀ a : Γ(X, U), e a = Scheme.Modules.Hom.app ιG U (a • γ) := by
          intro a
          rw [Scheme.Modules.Hom.app_smul, hγ, ← map_smul e a 1, smul_eq_mul, mul_one]
        have hγgen : ∀ g : Γ(G', U), ∃ a : Γ(X, U), g = a • γ := by
          intro g
          obtain ⟨a, ha⟩ := he_surj (Scheme.Modules.Hom.app ιG U g)
          exact ⟨a, hιGinj U (by rw [← hγe a, ha])⟩
        have hγann : ∀ a : Γ(X, U), a • γ = 0 ↔ a ∈ (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal := by
          intro a
          constructor
          · intro h
            apply (wc_dev_prime_vanish X U hU ξ hξU a).mp
            apply (he_ker a).mp
            rw [hγe a, h, map_zero]
          · intro h
            have h2 := (he_ker a).mpr ((wc_dev_prime_vanish X U hU ξ hξU a).mpr h)
            rw [hγe a] at h2
            exact hιGinj U (h2.trans (map_zero _).symm)

        obtain ⟨-, ht⟩ := wc_dev_generic_finite_assoc X M' (Z : Set X) ξ U hU hξU Z.isClosed
          hξmax hM'c hM'supp
        obtain ⟨t, htann⟩ := ht (by rw [hlenM']; exact Nat.cast_ne_zero.mpr hn.ne')

        obtain ⟨E, α, β, ε, hαmono, hβmono, hEc, hαsurj, hαε, hβε⟩ :=
          wc_dev_graph_sub X G' M' U γ t hU hG'c hM'c hG'tf hM'tf hγgen
            (fun a => (hγann a).trans (htann a).symm)

        obtain ⟨hSα, hCαc, hαinj, hSuppα⟩ := wc_dev_cokernel_coh X E G' α hαmono hEc hG'c
        obtain ⟨-, -, hCαsupp⟩ := hSuppα (closure ({ξ} : Set X)) U isClosed_closure hG'supp
        have hPCα : P (Limits.cokernel α) :=
          hIH _ hT1c (fun x hx => hTZ hx.1) (fun h => h.2 hξU) _ hCαc (hCαsupp hαsurj)
        have hPE : P E := hB (ShortComplex.mk α (Limits.cokernel.π α)
          (Limits.cokernel.condition α)) hSα hEc hG'c hCαc hPG' hPCα

        have hεgen : ∀ l : Γ(E, U), ∃ a : Γ(X, U), l = a • ε := by
          intro l
          obtain ⟨a, ha⟩ := hγgen (Scheme.Modules.Hom.app α U l)
          exact ⟨a, hαinj U (by rw [ha, Scheme.Modules.Hom.app_smul, hαε])⟩
        have hεann : ∀ a : Γ(X, U), a • ε = 0 ↔ a ∈ (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal := by
          intro a
          rw [← hγann a, ← hαε, ← Scheme.Modules.Hom.app_smul]
          constructor
          · intro h
            rw [h, map_zero]
          · intro h
            exact hαinj U (h.trans (map_zero _).symm)
        have hlenE : Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
            (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl Γ(E, U)) = 1 :=
          wc_dev_length_cyclic_prime Γ(X, U) Γ(E, U) (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal ε
            hεgen hεann

        obtain ⟨hSβ, hCβc, hβinj, hSuppβ⟩ := wc_dev_cokernel_coh X E M' β hβmono hEc hM'c
        obtain ⟨-, hQsupp, -⟩ := hSuppβ (Z : Set X) U Z.isClosed hM'supp
        have hlenQ : Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
              (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl Γ(M', U)) =
            Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
              (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl Γ(E, U)) +
            Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
              (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl
                Γ(Limits.cokernel β, U)) :=
          wc_dev_length_additive X (ShortComplex.mk β (Limits.cokernel.π β)
            (Limits.cokernel.condition β)) U hU ξ hξU hSβ hEc.1
        rw [hlenM', hlenE] at hlenQ
        have hQtop : Module.length (Localization.AtPrime (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal)
            (LocalizedModule (hU.primeIdealOf ⟨ξ, hξU⟩).asIdeal.primeCompl
              Γ(Limits.cokernel β, U)) ≠ ⊤ := by
          intro htop
          rw [htop] at hlenQ
          simp at hlenQ
        obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hQtop
        have hnm : n = 1 + m := by
          have h1 : ((n : ℕ) : ℕ∞) = ((1 + m : ℕ) : ℕ∞) := by
            rw [hlenQ, ← hm]
            push_cast
            rfl
          exact Nat.cast_inj.mp h1
        have hPQ : P (Limits.cokernel β) :=
          IHn m (by omega) (Limits.cokernel β) hCβc hQsupp hm.symm
        have hPM' : P M' := hA (ShortComplex.mk β (Limits.cokernel.π β)
          (Limits.cokernel.condition β)) hSβ hEc hM'c hCβc hPE hPQ

        exact hA (ShortComplex.mk ιM (Limits.cokernel.π ιM) (Limits.cokernel.condition ιM))
          hSM hM'c hM hCMc hPM' hPCM
    intro M hM hsupp
    obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp
      (wc_dev_generic_finite_assoc X M (Z : Set X) ξ U hU hξU Z.isClosed hξmax hM hsupp).1
    exact inner n M hM hsupp hn.symm
  intro M hM
  exact key ⊤ M hM (fun V hV s => hempty M V
    (Set.disjoint_univ.mp (by rwa [TopologicalSpace.Closeds.coe_top] at hV)) s)

theorem wc_pm_segre_coords : ∀ (N : ℕ), ∃ e : ∀ J K : Fin (N + 1), Γ(wcPm.{u} N, wcPmChart.{u} N J), (⨆ J, wcPmChart.{u} N J) = ⊤ ∧ (∀ J K, (wcPm.{u} N).basicOpen (e J K) = wcPmChart.{u} N J ⊓ wcPmChart.{u} N K) ∧ ∀ (Y : Scheme.{u}) (s : Fin (N + 1) → Γ(Y, ⊤)), Ideal.span (Set.range s) = ⊤ → ∃ φ : Y ⟶ wcPm.{u} N, (∀ J, φ ⁻¹ᵁ wcPmChart.{u} N J = Y.basicOpen (s J)) ∧ ∀ J K, φ.app (wcPmChart.{u} N J) (e J K) * Y.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op (s J) = Y.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op (s K) :=
by

  have s3a : ∀ (X : Scheme.{u}) (r a : Γ(X, ⊤)), ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away r))).inv (algebraMap Γ(X, ⊤) (Localization.Away r) a)) = (X.basicOpen r).ι.appTop a := by
    intro X r a
    have h1 : ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom) ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r))) = (X.basicOpen r).ι ≫ X.toSpecΓ := by
      have hm := morphismRestrict_ι X.toSpecΓ (PrimeSpectrum.basicOpen r)
      rw [Category.assoc, Category.assoc, basicOpenIsoSpecAway_hom_SpecMap, hm, ← Category.assoc,
        Scheme.isoOfEq_inv_ι]
    have h2 := congrArg Scheme.Hom.appTop h1
    rw [Scheme.Hom.comp_appTop _ (Spec.map _), Scheme.Hom.comp_appTop (X.basicOpen r).ι,
      Scheme.toSpecΓ_appTop] at h2
    have h3 := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)))
    calc _ = (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)) ≫ (Scheme.ΓSpecIso (.of (Localization.Away r))).inv ≫ ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop) a := rfl
      _ = ((Scheme.ΓSpecIso Γ(X, ⊤)).inv ≫ (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)))).appTop ≫ ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop) a := by
        rw [← Category.assoc, h3, Category.assoc]; rfl
      _ = ((Scheme.ΓSpecIso Γ(X, ⊤)).inv ≫ (Scheme.ΓSpecIso Γ(X, ⊤)).hom ≫ (X.basicOpen r).ι.appTop) a := by
        rw [h2]
      _ = _ := by rw [Iso.inv_hom_id_assoc]

  have s2 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] {f g : A} {d e : ℕ} (hf : f ∈ 𝒜 d) (hg : g ∈ 𝒜 e), 0 < d → 0 < e → (Proj 𝒜).basicOpen ((Proj.awayToSection 𝒜 f).hom (HomogeneousLocalization.Away.isLocalizationElem hf hg)) = Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g := by
    intro σ A _ _ _ 𝒜 _ f g d e hf hg hd he
    have hβ : (Proj.basicOpenToSpec 𝒜 f).app ⊤ ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).inv (HomogeneousLocalization.Away.isLocalizationElem hf hg)) = (Proj.basicOpen 𝒜 f).topIso.inv ((Proj.awayToSection 𝒜 f).hom (HomogeneousLocalization.Away.isLocalizationElem hf hg)) := by
      have hh := Proj.basicOpenToSpec_app_top 𝒜 f
      calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).hom ≫ Proj.awayToSection 𝒜 f ≫ (Proj.basicOpen 𝒜 f).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).inv (HomogeneousLocalization.Away.isLocalizationElem hf hg)) := by rw [← hh]; rfl
        _ = (Proj.basicOpen 𝒜 f).topIso.inv (Proj.awayToSection 𝒜 f ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).hom ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).inv (HomogeneousLocalization.Away.isLocalizationElem hf hg)))) := rfl
        _ = _ := by rw [Iso.inv_hom_id_apply]
    have h3 : (Proj.basicOpen 𝒜 f : Scheme).basicOpen ((Proj.basicOpen 𝒜 f).topIso.inv ((Proj.awayToSection 𝒜 f).hom (HomogeneousLocalization.Away.isLocalizationElem hf hg))) = Proj.basicOpenToSpec 𝒜 f ⁻¹ᵁ PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hf hg) := by
      have hp := Scheme.preimage_basicOpen (Proj.basicOpenToSpec 𝒜 f) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))).inv (HomogeneousLocalization.Away.isLocalizationElem hf hg))
      rw [basicOpen_eq_of_affine] at hp
      rw [hp, ← hβ]
      rfl
    have h4 : Proj.basicOpenToSpec 𝒜 f ⁻¹ᵁ PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hf hg) = (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g := by
      rw [← Proj.awayι_preimage_basicOpen 𝒜 hf hd hg he, ← Proj.basicOpenIsoSpec_inv_ι 𝒜 f hf hd,
        ← Scheme.Hom.comp_preimage, ← Proj.basicOpenIsoSpec_hom 𝒜 f hf hd, ← Category.assoc,
        Iso.hom_inv_id, Category.id_comp]
    rw [← Scheme.Opens.ι_image_basicOpen_topIso_inv, h3, h4, Scheme.Hom.image_preimage_eq_opensRange_inf,
      Scheme.Opens.opensRange_ι]

  have s3 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (X : Scheme.{u}) (f : A →+* Γ(X, ⊤)) (hf : (HomogeneousIdeal.irrelevant 𝒜).toIdeal.map f = ⊤) {t : A} {d : ℕ} (hd : 0 < d) (ht : t ∈ 𝒜 d) (n : ℕ) (y : A) (hy : y ∈ 𝒜 (n • d)), (Proj.fromOfGlobalSections 𝒜 f hf).app (Proj.basicOpen 𝒜 t) ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) * X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op (f t) ^ n = X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op (f y) := by
    intro σ A _ _ _ 𝒜 _ X f hf t d hd ht n y hy
    have key : ∀ {U V : Scheme.{u}} {R L : CommRingCat.{u}} (W : V ⟶ Spec L) (φ₀ : R ⟶ L) (i : U ≅ Spec R) (T : V ⟶ U), T = (W ≫ Spec.map φ₀) ≫ i.inv → ∀ x : R, T.appTop (i.hom.appTop ((Scheme.ΓSpecIso R).inv x)) = W.appTop ((Scheme.ΓSpecIso L).inv (φ₀ x)) := by
      intro U V R L W φ₀ i T hT x
      subst hT
      have e1 : ((W ≫ Spec.map φ₀) ≫ i.inv).appTop = i.inv.appTop ≫ (Spec.map φ₀).appTop ≫ W.appTop := by
        rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
      have e2 : i.hom.appTop ≫ i.inv.appTop = 𝟙 _ := by
        rw [← Scheme.Hom.comp_appTop, Iso.inv_hom_id, Scheme.Hom.id_appTop]
      have e3 := Scheme.ΓSpecIso_inv_naturality φ₀
      calc _ = ((Scheme.ΓSpecIso R).inv ≫ (i.hom.appTop ≫ i.inv.appTop) ≫ (Spec.map φ₀).appTop ≫ W.appTop) x := by
            rw [e1]; rfl
        _ = ((φ₀ ≫ (Scheme.ΓSpecIso L).inv) ≫ W.appTop) x := by
            rw [e2, Category.id_comp, ← Category.assoc, ← e3]
    have resLE_top : ∀ {X Y : Scheme.{u}} (φ : X ⟶ Y) {U : Y.Opens} {V : X.Opens} (e : V ≤ φ ⁻¹ᵁ U) (r : Γ(Y, U)), (φ.resLE U V e).appTop (U.topIso.inv r) = V.topIso.inv (φ.appLE U V e r) := by
      intro X Y φ U V e r
      calc _ = (U.topIso.inv ≫ U.topIso.hom ≫ φ.appLE U V e ≫ V.topIso.inv) r := by
            rw [← Scheme.Hom.resLE_app_top]; rfl
        _ = _ := by rw [Iso.inv_hom_id_assoc]; rfl
    have hPV : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t = X.basicOpen (f t) :=
      Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 f hf hd ht
    have hle : Submonoid.powers t ≤ (Submonoid.powers (f t)).comap f :=
      Submonoid.powers_le.mpr (Submonoid.mem_powers (f t))
    have hT : (Proj.fromOfGlobalSections 𝒜 f hf).resLE (Proj.basicOpen 𝒜 t) (X.basicOpen (f t)) hPV.ge =
        (((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom) ≫
          Spec.map (CommRingCat.ofHom ((IsLocalization.map (Localization.Away (f t)) f hle).comp
            (algebraMap (HomogeneousLocalization.Away 𝒜 t) (Localization.Away t))))) ≫
          (Proj.basicOpenIsoSpec 𝒜 t ht hd).inv := by
      rw [Proj.fromOfGlobalSections_resLE 𝒜 f hf hd ht, Proj.toBasicOpenOfGlobalSections.eq_1]
      simp only [Category.assoc]
    have hi : (Proj.basicOpenIsoSpec 𝒜 t ht hd).hom.appTop ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 t))).inv (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) = (Proj.basicOpen 𝒜 t).topIso.inv ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) := by
      rw [Proj.basicOpenIsoSpec_hom]
      have hh := Proj.basicOpenToSpec_app_top 𝒜 t
      calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 t))).hom ≫ Proj.awayToSection 𝒜 t ≫ (Proj.basicOpen 𝒜 t).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 t))).inv (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) := by rw [← hh]
        _ = (Proj.basicOpen 𝒜 t).topIso.inv (Proj.awayToSection 𝒜 t ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 t))).hom ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 t))).inv (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)))) := rfl
        _ = _ := by rw [Iso.inv_hom_id_apply]
    have h1 := key _ _ _ _ hT (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)
    rw [hi, resLE_top] at h1
    have hD : ((IsLocalization.map (Localization.Away (f t)) f hle).comp
            (algebraMap (HomogeneousLocalization.Away 𝒜 t) (Localization.Away t))) (HomogeneousLocalization.Away.mk 𝒜 ht n y hy) * (algebraMap Γ(X, ⊤) (Localization.Away (f t)) (f t)) ^ n = algebraMap Γ(X, ⊤) (Localization.Away (f t)) (f y) := by
      rw [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk', IsLocalization.map_mk', ← map_pow, ← map_pow f]
      exact IsLocalization.mk'_spec _ _ _
    have hΦ : ∀ a b c : Localization.Away (f t), a * b ^ n = c →
        ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv a) * (((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv b)) ^ n = ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv c) := by
      intro a b c h
      rw [← map_pow, ← map_pow, ← map_mul, ← map_mul, h]
    have h2 := hΦ _ _ _ hD
    rw [s3a, s3a] at h2
    have h1' : (X.basicOpen (f t)).topIso.inv ((Proj.fromOfGlobalSections 𝒜 f hf).appLE (Proj.basicOpen 𝒜 t) (X.basicOpen (f t)) hPV.ge ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy))) = ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen (f t))).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f t) ≫ (basicOpenIsoSpecAway (f t)).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away (f t)))).inv (((IsLocalization.map (Localization.Away (f t)) f hle).comp
            (algebraMap (HomogeneousLocalization.Away 𝒜 t) (Localization.Away t))) (HomogeneousLocalization.Away.mk 𝒜 ht n y hy))) := h1
    rw [← h1'] at h2
    have hι : ∀ a, (X.basicOpen (f t)).ι.appTop a = (X.basicOpen (f t)).topIso.inv (X.presheaf.map (homOfLE (le_top : X.basicOpen (f t) ≤ ⊤)).op a) := by
      intro a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    rw [hι, hι, ← map_pow, ← map_mul] at h2
    have hinj : ∀ a b : Γ(X, X.basicOpen (f t)), (X.basicOpen (f t)).topIso.inv a = (X.basicOpen (f t)).topIso.inv b → a = b := by
      intro a b h
      have h' := congrArg (fun w => (X.basicOpen (f t)).topIso.hom w) h
      simp only [Iso.inv_hom_id_apply] at h'
      exact h'
    have hSS := hinj _ _ h2
    have hG1 : (Proj.fromOfGlobalSections 𝒜 f hf).app (Proj.basicOpen 𝒜 t) ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) = X.presheaf.map (homOfLE hPV.le).op ((Proj.fromOfGlobalSections 𝒜 f hf).appLE (Proj.basicOpen 𝒜 t) (X.basicOpen (f t)) hPV.ge ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy))) := by
      have hh := Scheme.Hom.appLE_map (Proj.fromOfGlobalSections 𝒜 f hf) hPV.ge (homOfLE hPV.le).op
      rw [Scheme.Hom.app_eq_appLE, ← hh]
      rfl
    have hG2 : ∀ a, X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op a = X.presheaf.map (homOfLE hPV.le).op (X.presheaf.map (homOfLE (le_top : X.basicOpen (f t) ≤ ⊤)).op a) := by
      intro a
      rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    rw [hG1, hG2, hG2, ← map_pow, ← map_mul, hSS]

  intro N
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)) :=
    MvPolynomial.gradedAlgebra
  have hX : ∀ J : Fin (N + 1), (MvPolynomial.X J : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ) 1 := fun J =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)
  refine ⟨fun J K => (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ))
      (MvPolynomial.X J)).hom (HomogeneousLocalization.Away.isLocalizationElem (hX J) (hX K)), ?_, ?_, ?_⟩
  ·
    have s1 : ∀ p : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ), MvPolynomial.homogeneousComponent 0 p = 0 →
        p ∈ Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ))) := by
      intro p hp
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m' hm
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hp
      have hm0 : m' ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) hp
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨i, Set.mem_univ i, hi⟩
    exact Proj.iSup_basicOpen_eq_top (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ))
      (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ))
      (fun p hp => s1 p (((MvPolynomial.decomposition.decompose'_apply p 0).symm.trans
        ((HomogeneousIdeal.mem_irrelevant_iff _ p).mp hp))))
  ·
    intro J K
    exact s2 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)) (hX J) (hX K) Nat.one_pos Nat.one_pos
  ·
    intro Y s hspan
    let F : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ) →+* Γ(Y, ⊤) :=
      MvPolynomial.eval₂Hom ((Int.castRingHom Γ(Y, ⊤)).comp (ULift.ringEquiv.{0, u} (R := ℤ)).toRingHom) s
    have hFX : ∀ J, F (MvPolynomial.X J) = s J := fun J => MvPolynomial.eval₂Hom_X' _ _ J
    have hF : (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ))).toIdeal.map F = ⊤ := by
      rw [eq_top_iff, ← hspan, Ideal.span_le]
      rintro _ ⟨J, rfl⟩
      rw [← hFX J]
      apply Ideal.mem_map_of_mem
      exact (HomogeneousIdeal.mem_irrelevant_iff _ _).mpr (by
        rw [GradedRing.proj_apply]
        exact DirectSum.decompose_of_mem_ne _ (hX J) one_ne_zero)
    refine ⟨Proj.fromOfGlobalSections _ F hF, fun J => ?_, fun J K => ?_⟩
    · rw [← hFX J]
      exact Proj.fromOfGlobalSections_preimage_basicOpen _ F hF Nat.one_pos (hX J)
    · have hy : (MvPolynomial.X K : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) ^ 1 ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ) (1 • 1) := by
        rw [pow_one, one_smul]
        exact hX K
      have h := s3 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)) Y F hF Nat.one_pos (hX J) 1
        (MvPolynomial.X K ^ 1) hy
      have e1 : F (MvPolynomial.X K ^ 1) = s K := by rw [map_pow, pow_one, hFX]
      have e3 : ∀ z : Γ(Y, Proj.fromOfGlobalSections _ F hF ⁻¹ᵁ Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)) (MvPolynomial.X J)), z ^ 1 = z :=
        fun z => pow_one z
      rw [e1, hFX J, e3] at h
      exact h

theorem wc_prod_affine_opens_gen : ∀ (X Y : Scheme.{u}) (U : X.Opens) (V : Y.Opens), IsAffineOpen U → IsAffineOpen V → IsAffineOpen ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) ∧ ∀ t : Γ(X ⨯ Y, (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V), t ∈ Subring.closure (Set.range (((X ⨯ Y).presheaf.map (homOfLE (inf_le_left : (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V ≤ (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U)).op).hom.comp ((Limits.prod.fst : X ⨯ Y ⟶ X).app U).hom) ∪ Set.range (((X ⨯ Y).presheaf.map (homOfLE (inf_le_right : (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V ≤ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V)).op).hom.comp ((Limits.prod.snd : X ⨯ Y ⟶ Y).app V).hom)) :=
by
  intro X Y U V hU hV

  have s2 : ∀ (R A B P : CommRingCat.{u}) (f : R ⟶ A) (g : R ⟶ B) (inl : A ⟶ P) (inr : B ⟶ P),
      IsPushout f g inl inr → ∀ x : P, x ∈ Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) := by
    intro R A B P f g inl inr hP x
    let S := Subring.closure (Set.range inl.hom ∪ Set.range inr.hom)
    let inl' : A ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inl.hom S
      (fun a => Subring.subset_closure (Or.inl ⟨a, rfl⟩)))
    let inr' : B ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inr.hom S
      (fun b => Subring.subset_closure (Or.inr ⟨b, rfl⟩)))
    have hw : f ≫ inl' = g ≫ inr' := by
      ext y
      exact ConcreteCategory.congr_hom hP.w y
    let d := hP.desc inl' inr' hw
    have hε : d ≫ CommRingCat.ofHom S.subtype = 𝟙 P := by
      apply hP.hom_ext
      · rw [Category.comp_id, ← Category.assoc, hP.inl_desc]
        ext a
        rfl
      · rw [Category.comp_id, ← Category.assoc, hP.inr_desc]
        ext a
        rfl
    have hx : (S.subtype (d x)) = x := by
      have := ConcreteCategory.congr_hom hε x
      exact this
    rw [← hx]
    exact (d x).property

  have s3 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
      (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
    intro X Y f U V e
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE,
      Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
    erw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]

  have hP : IsPullback
      ((Limits.prod.fst : X ⨯ Y ⟶ X).resLE U ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓
        (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_left)
      ((Limits.prod.snd : X ⨯ Y ⟶ Y).resLE V ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓
        (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_right)
      (Limits.terminal.from (U : Scheme.{u})) (Limits.terminal.from (V : Scheme.{u})) := by
    have comm : (Limits.prod.fst : X ⨯ Y ⟶ X).resLE U ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓
        (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_left ≫ Limits.terminal.from (U : Scheme.{u}) =
        (Limits.prod.snd : X ⨯ Y ⟶ Y).resLE V ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓
        (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_right ≫ Limits.terminal.from (V : Scheme.{u}) :=
      Limits.terminal.hom_ext _ _
    have hrange : ∀ (s : Limits.PullbackCone (Limits.terminal.from (U : Scheme.{u}))
        (Limits.terminal.from (V : Scheme.{u}))),
        Set.range (Limits.prod.lift (s.fst ≫ U.ι) (s.snd ≫ V.ι)) ⊆
          Set.range ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V).ι := by
      intro s
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      refine ⟨?_, ?_⟩
      · show (Limits.prod.fst : X ⨯ Y ⟶ X) (Limits.prod.lift (s.fst ≫ U.ι) (s.snd ≫ V.ι) x) ∈ U
        rw [← Scheme.Hom.comp_apply, Limits.prod.lift_fst, Scheme.Hom.comp_apply]
        have h : U.ι (s.fst x) ∈ Set.range U.ι := ⟨_, rfl⟩
        rwa [Scheme.Opens.range_ι] at h
      · show (Limits.prod.snd : X ⨯ Y ⟶ Y) (Limits.prod.lift (s.fst ≫ U.ι) (s.snd ≫ V.ι) x) ∈ V
        rw [← Scheme.Hom.comp_apply, Limits.prod.lift_snd, Scheme.Hom.comp_apply]
        have h : V.ι (s.snd x) ∈ Set.range V.ι := ⟨_, rfl⟩
        rwa [Scheme.Opens.range_ι] at h
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ comm) ?_
    refine Limits.PullbackCone.IsLimit.mk comm
      (fun s => IsOpenImmersion.lift _ _ (hrange s)) ?_ ?_ ?_
    · intro s
      rw [← cancel_mono U.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
        IsOpenImmersion.lift_fac, Limits.prod.lift_fst]
    · intro s
      rw [← cancel_mono V.ι, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc,
        IsOpenImmersion.lift_fac, Limits.prod.lift_snd]
    · intro s m h1 h2
      apply IsOpenImmersion.lift_uniq
      apply Limits.prod.hom_ext
      · rw [Limits.prod.lift_fst, ← h1, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
      · rw [Limits.prod.lift_snd, ← h2, Category.assoc, Category.assoc, Scheme.Hom.resLE_comp_ι]
  haveI : IsAffine (U : Scheme.{u}) := hU
  haveI : IsAffine (V : Scheme.{u}) := hV
  have hWaff : IsAffineOpen ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓
      (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) := IsAffine.of_isIso hP.isoPullback.hom
  have hgen := s2 _ _ _ _ _ _ _ _ (isPushout_appTop_of_isPullback hP)
  refine ⟨hWaff, fun t => ?_⟩
  have ht : ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V).topIso.hom
      (((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V).topIso.inv t)
      = t := by
    exact ConcreteCategory.congr_hom
      ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V).topIso.inv_hom_id t
  rw [← ht, ← Subring.mem_comap]
  refine (Subring.closure_le.mpr ?_) (hgen _)
  rintro _ (⟨y, rfl⟩ | ⟨z, rfl⟩)
  · rw [SetLike.mem_coe, Subring.mem_comap]
    apply Subring.subset_closure
    left
    refine ⟨U.topIso.hom y, ?_⟩
    have h := ConcreteCategory.congr_hom (s3 _ _ (Limits.prod.fst : X ⨯ Y ⟶ X) U
      ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_left) y
    exact h.symm
  · rw [SetLike.mem_coe, Subring.mem_comap]
    apply Subring.subset_closure
    right
    refine ⟨V.topIso.hom z, ?_⟩
    have h := ConcreteCategory.congr_hom (s3 _ _ (Limits.prod.snd : X ⨯ Y ⟶ Y) V
      ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) inf_le_right) z
    exact h.symm

theorem wc_chow_reduced_trace : ∀ (X : Scheme.{u}) (T : TopologicalSpace.Closeds X) (W : X.Opens), IsAffineOpen W → ∃ (D : Scheme.{u}) (d : D ⟶ (W : Scheme.{u})), IsReduced D ∧ CompactSpace D ∧ IsClosedImmersion d ∧ Set.range (d ≫ W.ι) = (W : Set X) ∩ T :=
by
  intro X T W hW
  set S : Set (PrimeSpectrum Γ(X, W)) := hW.fromSpec ⁻¹' (T : Set X) with hSdef
  set J : Ideal Γ(X, W) := PrimeSpectrum.vanishingIdeal S with hJdef
  let qC : Γ(X, W) ⟶ CommRingCat.of (Γ(X, W) ⧸ J) := CommRingCat.ofHom (Ideal.Quotient.mk J)
  have hSclosed : IsClosed S := T.isClosed.preimage hW.fromSpec.continuous
  have hred : _root_.IsReduced (Γ(X, W) ⧸ J) :=
    (Ideal.isRadical_iff_quotient_reduced J).mp (PrimeSpectrum.isRadical_vanishingIdeal S)
  haveI : IsClosedImmersion (Spec.map qC) :=
    IsClosedImmersion.spec_of_surjective qC Ideal.Quotient.mk_surjective
  refine ⟨Spec (CommRingCat.of (Γ(X, W) ⧸ J)), Spec.map qC ≫ hW.isoSpec.inv, ?_, inferInstance,
    inferInstance, ?_⟩
  · exact (affine_isReduced_iff (CommRingCat.of (Γ(X, W) ⧸ J))).mpr hred
  · have hcomp : (Spec.map qC ≫ hW.isoSpec.inv) ≫ W.ι = Spec.map qC ≫ hW.fromSpec := by
      rw [Category.assoc, IsAffineOpen.isoSpec_inv_ι]
    have hrange1 : Set.range (Spec.map qC) = S := by
      have e1 : Set.range (Spec.map qC) = Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk J)) := by
        ext x
        simp only [Set.mem_range]
        constructor
        · rintro ⟨y, rfl⟩
          exact ⟨y, (Spec.map_apply qC y).symm⟩
        · rintro ⟨y, rfl⟩
          exact ⟨y, Spec.map_apply qC y⟩
      rw [e1, ← (PrimeSpectrum.isClosed_range_comap_of_surjective _ _
        Ideal.Quotient.mk_surjective).closure_eq, PrimeSpectrum.closure_range_comap,
        Ideal.mk_ker, hJdef, PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure,
        hSclosed.closure_eq]
    rw [hcomp]
    have e2 : Set.range (Spec.map qC ≫ hW.fromSpec) = hW.fromSpec '' Set.range (Spec.map qC) := by
      ext x
      simp only [Set.mem_range, Set.mem_image]
      constructor
      · rintro ⟨y, rfl⟩
        exact ⟨Spec.map qC y, ⟨y, rfl⟩, (Scheme.Hom.comp_apply _ _ y).symm⟩
      · rintro ⟨_, ⟨y, rfl⟩, rfl⟩
        exact ⟨y, Scheme.Hom.comp_apply _ _ y⟩
    rw [e2, hrange1]
    show hW.fromSpec '' (hW.fromSpec ⁻¹' (T : Set X)) = _
    rw [Set.image_preimage_eq_inter_range, IsAffineOpen.range_fromSpec, Set.inter_comm]

theorem wc_graph_closure_reduced : ∀ (X P D : Scheme.{u}) [IsReduced D] [CompactSpace D] (ψ : D ⟶ X) (φ : D ⟶ P), IsSeparated (Limits.terminal.from X) → IsSeparated (Limits.terminal.from P) → (∀ (R S C : Scheme.{u}) [IsReduced R] (a : R ⟶ S) (j : C ⟶ S) [IsClosedImmersion j], Set.range a ⊆ Set.range j → ∃ b : R ⟶ C, b ≫ j = a) → ∃ (Z : Scheme.{u}) (p : Z ⟶ X) (g : Z ⟶ P) (δ : D ⟶ Z), IsReduced Z ∧ IsClosedImmersion (Limits.prod.lift p g) ∧ DenseRange δ ∧ δ ≫ p = ψ ∧ δ ≫ g = φ :=
by
  intro X P D _ _ ψ φ _ _ hlift
  classical
  let γ : D ⟶ X ⨯ P := Limits.prod.lift ψ φ
  let Cl : TopologicalSpace.Closeds ↥(X ⨯ P) := ⟨closure (Set.range γ), isClosed_closure⟩
  let I : (X ⨯ P).IdealSheafData := Scheme.IdealSheafData.vanishingIdeal Cl
  let j : I.subscheme ⟶ X ⨯ P := I.subschemeι
  have hrj : Set.range j = closure (Set.range γ) := by
    show Set.range I.subschemeι = _
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  haveI hred : IsReduced I.subscheme := by
    haveI : ∀ i, IsReduced (I.subschemeCover.openCover.X i) := by
      intro U
      change IsReduced (Spec (I.subschemeCover.X U))
      rw [affine_isReduced_iff]
      change _root_.IsReduced (_ ⧸ I.ideal U)
      rw [← Ideal.isRadical_iff_quotient_reduced]
      have hrad : ∀ V : (X ⨯ P).affineOpens,
          ((Scheme.IdealSheafData.vanishingIdeal Cl).ideal V).IsRadical := by
        intro V
        rw [Scheme.IdealSheafData.vanishingIdeal_ideal]
        exact PrimeSpectrum.isRadical_vanishingIdeal _
      exact hrad U
    exact IsReduced.of_openCover I.subscheme I.subschemeCover.openCover
  obtain ⟨δ, hδ⟩ := hlift D (X ⨯ P) I.subscheme γ j (by rw [hrj]; exact subset_closure)
  refine ⟨I.subscheme, j ≫ Limits.prod.fst, j ≫ Limits.prod.snd, δ, hred, ?_, ?_, ?_, ?_⟩
  · have hlg : Limits.prod.lift (j ≫ Limits.prod.fst) (j ≫ Limits.prod.snd) = j := by
      apply Limits.prod.hom_ext <;> simp
    rw [hlg]
    infer_instance
  · have hj : Topology.IsInducing j := j.isClosedEmbedding.isInducing
    rw [denseRange_iff_closure_range, hj.closure_eq_preimage_closure_image]
    have himg : j '' Set.range δ = Set.range γ := by
      rw [← Set.range_comp, ← hδ]
      ext x
      simp [Scheme.Hom.comp_apply]
    rw [himg, ← hrj, Set.preimage_range]
  · rw [← Category.assoc, hδ, Limits.prod.lift_fst]
  · rw [← Category.assoc, hδ, Limits.prod.lift_snd]

theorem wc_chow_chart_generation : ∀ (B : Type u) [CommRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)) (N : ℕ) (e : ∀ J K : Fin (N + 1), Γ(wcPm.{u} N, wcPmChart.{u} N J)) (r : ℕ) (U : Fin (r + 1) → X.Opens) (n : Fin (r + 1) → ℕ) (a : ∀ i, Fin (n i + 1) → Γ(X, U i)) (κ : Fin (N + 1) ≃ (∀ i, Fin (n i + 1))) (Z D : Scheme.{u}) [IsReduced Z] (p : Z ⟶ X) (g : Z ⟶ wcPm.{u} N) (δ : D ⟶ Z) (ψ : D ⟶ X) (φ : D ⟶ wcPm.{u} N) (s : Fin (N + 1) → Γ(D, ⊤)) (hψU : ∀ i, ψ ⁻¹ᵁ U i = ⊤), (∀ (X Y : Scheme.{u}) (U : X.Opens) (V : Y.Opens), IsAffineOpen U → IsAffineOpen V → IsAffineOpen ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) ∧ ∀ t : Γ(X ⨯ Y, (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V), t ∈ Subring.closure (Set.range (((X ⨯ Y).presheaf.map (homOfLE (inf_le_left : (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V ≤ (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U)).op).hom.comp ((Limits.prod.fst : X ⨯ Y ⟶ X).app U).hom) ∪ Set.range (((X ⨯ Y).presheaf.map (homOfLE (inf_le_right : (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V ≤ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V)).op).hom.comp ((Limits.prod.snd : X ⨯ Y ⟶ Y).app V).hom))) → (∀ (Z D : Scheme.{u}) [IsReduced Z] (δ : D ⟶ Z), DenseRange δ → ∀ (V : Z.Opens) (s t : Γ(Z, V)), δ.app V s = δ.app V t → s = t) → δ ≫ p = ψ → δ ≫ g = φ → DenseRange δ → (∀ i, a i 0 = 1) → (∀ K, s K = ∏ i, ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ K i))) → (∀ J, φ ⁻¹ᵁ wcPmChart.{u} N J = D.basicOpen (s J)) → (∀ J K, φ.app (wcPmChart.{u} N J) (e J K) * D.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op (s J) = D.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op (s K)) → (∀ i, IsAffineOpen (U i)) → (∀ i (t : Γ(X, U i)), t ∈ Subring.closure (Set.range ((X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range (a i))) → IsClosedImmersion (Limits.prod.lift p g) → ∀ (i : Fin (r + 1)) (J : Fin (N + 1)), κ J i = 0 → IsAffineOpen (p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J) ∧ ∀ t : Γ(Z, p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J), t ∈ Subring.closure (Set.range ((Z.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op).hom.comp ((p ≫ h).appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range ((Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ g ⁻¹ᵁ wcPmChart.{u} N J)).op).hom.comp (g.app (wcPmChart.{u} N J)).hom)) :=
by
  intro B _ X h N e r U n a κ Z D _ p g δ ψ φ s hψU hprod hdenseinj hδp hδg hδ ha0 hs hφ hrel hU
    hagen hΛ i J hJ
  subst hδp hδg
  classical

  have s1 : ∀ (U : X.Opens) (C : (wcPm.{u} N).Opens), IsAffineOpen U → IsAffineOpen C →
      IsAffineOpen (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) ∧ ∀ t : Γ(Z, p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C), t ∈ Subring.closure
        (Set.range ((Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ p ⁻¹ᵁ U)).op).hom.comp
          (p.app U).hom) ∪
        Set.range ((Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op).hom.comp
          (g.app C).hom)) := by
    intro U C hU hC
    obtain ⟨hO', hgen⟩ := hprod X (wcPm.{u} N) U C hU hC
    obtain ⟨hAff, hsurj⟩ := isClosedImmersion_iff_isAffineHom.mp hΛ
    haveI := hAff
    set O' := (Limits.prod.fst : X ⨯ wcPm.{u} N ⟶ X) ⁻¹ᵁ U ⊓
      (Limits.prod.snd : X ⨯ wcPm.{u} N ⟶ wcPm.{u} N) ⁻¹ᵁ C with hO'def
    have hV : (Limits.prod.lift p g) ⁻¹ᵁ O' = p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C := by
      rw [hO'def, Scheme.Hom.preimage_inf, ← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage,
        Limits.prod.lift_fst, Limits.prod.lift_snd]
    refine ⟨by rw [← hV]; exact hO'.preimage _, fun t => ?_⟩
    have hθs : ∀ (W : Z.Opens) (eW : (Limits.prod.lift p g) ⁻¹ᵁ O' = W),
        Function.Surjective ((Limits.prod.lift p g).appLE O' W eW.ge) := by
      intro W eW
      subst eW
      rw [Scheme.Hom.appLE_eq_app]
      exact hsurj _ hO'
    have gL : ∀ x : Γ(X, U), (Limits.prod.lift p g).appLE O' (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) hV.ge
        ((X ⨯ wcPm.{u} N).presheaf.map (homOfLE (inf_le_left :
          O' ≤ (Limits.prod.fst : X ⨯ wcPm.{u} N ⟶ X) ⁻¹ᵁ U)).op
          ((Limits.prod.fst : X ⨯ wcPm.{u} N ⟶ X).app U x)) =
        Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ p ⁻¹ᵁ U)).op (p.app U x) := by
      intro x
      have aux : ∀ (q : Z ⟶ X) (hq : q = p) (e' : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ q ⁻¹ᵁ U),
          q.appLE U (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) e' =
          p.app U ≫ Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ p ⁻¹ᵁ U)).op := by
        intro q hq e'
        subst hq
        rfl
      have m : (Limits.prod.fst : X ⨯ wcPm.{u} N ⟶ X).app U ≫
          (X ⨯ wcPm.{u} N).presheaf.map (homOfLE (inf_le_left :
            O' ≤ (Limits.prod.fst : X ⨯ wcPm.{u} N ⟶ X) ⁻¹ᵁ U)).op ≫
          (Limits.prod.lift p g).appLE O' (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) hV.ge =
          p.app U ≫ Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ p ⁻¹ᵁ U)).op := by
        rw [Scheme.Hom.map_appLE, Scheme.Hom.app_eq_appLE (Limits.prod.fst : X ⨯ wcPm.{u} N ⟶ X),
          Scheme.Hom.appLE_comp_appLE]
        exact aux _ (Limits.prod.lift_fst p g) _
      exact congrArg (fun f => f.hom x) m
    have gR : ∀ y : Γ(wcPm.{u} N, C), (Limits.prod.lift p g).appLE O' (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) hV.ge
        ((X ⨯ wcPm.{u} N).presheaf.map (homOfLE (inf_le_right :
          O' ≤ (Limits.prod.snd : X ⨯ wcPm.{u} N ⟶ wcPm.{u} N) ⁻¹ᵁ C)).op
          ((Limits.prod.snd : X ⨯ wcPm.{u} N ⟶ wcPm.{u} N).app C y)) =
        Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op (g.app C y) := by
      intro y
      have aux : ∀ (q : Z ⟶ wcPm.{u} N) (hq : q = g) (e' : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ q ⁻¹ᵁ C),
          q.appLE C (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) e' =
          g.app C ≫ Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op := by
        intro q hq e'
        subst hq
        rfl
      have m : (Limits.prod.snd : X ⨯ wcPm.{u} N ⟶ wcPm.{u} N).app C ≫
          (X ⨯ wcPm.{u} N).presheaf.map (homOfLE (inf_le_right :
            O' ≤ (Limits.prod.snd : X ⨯ wcPm.{u} N ⟶ wcPm.{u} N) ⁻¹ᵁ C)).op ≫
          (Limits.prod.lift p g).appLE O' (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C) hV.ge =
          g.app C ≫ Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op := by
        rw [Scheme.Hom.map_appLE,
          Scheme.Hom.app_eq_appLE (Limits.prod.snd : X ⨯ wcPm.{u} N ⟶ wcPm.{u} N),
          Scheme.Hom.appLE_comp_appLE]
        exact aux _ (Limits.prod.lift_snd p g) _
      exact congrArg (fun f => f.hom y) m
    obtain ⟨u, rfl⟩ := hθs _ hV t
    apply Subring.mem_comap.mp
    refine Subring.closure_le.mpr ?_ (hgen u)
    rintro _ (⟨x, rfl⟩ | ⟨y, rfl⟩)
    · exact Subring.mem_comap.mpr (Subring.subset_closure (Or.inl ⟨x, (gL x).symm⟩))
    · exact Subring.mem_comap.mpr (Subring.subset_closure (Or.inr ⟨y, (gR y).symm⟩))

  have s2 : ∀ k : Fin (n i + 1), (δ ≫ g).app (wcPmChart.{u} N J)
      (e J (κ.symm (Function.update (κ J) i k))) =
      (δ ≫ p).appLE (U i) ((δ ≫ g) ⁻¹ᵁ wcPmChart.{u} N J) (le_top.trans (hψU i).ge) (a i k) := by
    intro k
    have hsJ : s J = ∏ l ∈ ({i}ᶜ : Finset (Fin (r + 1))),
        (δ ≫ p).appLE (U l) ⊤ (hψU l).ge (a l (κ J l)) := by
      rw [hs J, Fintype.prod_eq_mul_prod_compl i, hJ, ha0, map_one, one_mul]
    have hsK : s (κ.symm (Function.update (κ J) i k)) =
        (δ ≫ p).appLE (U i) ⊤ (hψU i).ge (a i k) * s J := by
      rw [hs, Fintype.prod_eq_mul_prod_compl i, hsJ, Equiv.apply_symm_apply, Function.update_self]
      congr 1
      apply Finset.prod_congr rfl
      intro l hl
      have hli : l ≠ i := by simpa using hl
      rw [Function.update_of_ne hli]
    have hu : IsUnit (D.presheaf.map (homOfLE (le_top :
        (δ ≫ g) ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op (s J)) := by
      have aux : ∀ (W' : D.Opens) (f : Γ(D, ⊤)), W' = D.basicOpen f →
          IsUnit (D.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op f) := by
        intro W' f hW
        subst hW
        exact RingedSpace.isUnit_res_basicOpen D.toRingedSpace f
      exact aux _ _ (hφ J)
    have hrel' := hrel J (κ.symm (Function.update (κ J) i k))
    rw [hsK, map_mul] at hrel'
    have h1 := hu.mul_right_cancel hrel'
    rw [h1, ← CommRingCat.comp_apply, Scheme.Hom.appLE_map]

  have s3 : ∀ (x : Γ(X, U i)) (y : Γ(wcPm.{u} N, wcPmChart.{u} N J))
      (hle : (δ ≫ g) ⁻¹ᵁ wcPmChart.{u} N J ≤ (δ ≫ p) ⁻¹ᵁ U i),
      (δ ≫ g).app (wcPmChart.{u} N J) y =
        (δ ≫ p).appLE (U i) ((δ ≫ g) ⁻¹ᵁ wcPmChart.{u} N J) hle x →
      Z.presheaf.map (homOfLE (inf_le_left :
          p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ p ⁻¹ᵁ U i)).op (p.app (U i) x) =
        Z.presheaf.map (homOfLE (inf_le_right :
          p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ g ⁻¹ᵁ wcPmChart.{u} N J)).op
          (g.app (wcPmChart.{u} N J) y) := by
    intro x y hle hxy
    apply hdenseinj Z D δ hδ
    have hL : δ ⁻¹ᵁ (p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J) ≤ (δ ≫ p) ⁻¹ᵁ U i :=
      fun z hz => hz.1
    have hR : δ ⁻¹ᵁ (p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J) ≤ (δ ≫ g) ⁻¹ᵁ wcPmChart.{u} N J :=
      fun z hz => hz.2
    have mL : p.app (U i) ≫ Z.presheaf.map (homOfLE (inf_le_left :
          p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ p ⁻¹ᵁ U i)).op ≫
          δ.app (p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J) =
        (δ ≫ p).appLE (U i) _ hL := by
      rw [Scheme.Hom.app_eq_appLE δ, ← Category.assoc]
      exact Scheme.Hom.appLE_comp_appLE δ p (U i) _ _ _ _
    have mR : g.app (wcPmChart.{u} N J) ≫ Z.presheaf.map (homOfLE (inf_le_right :
          p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ g ⁻¹ᵁ wcPmChart.{u} N J)).op ≫
          δ.app (p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J) =
        (δ ≫ g).appLE (wcPmChart.{u} N J) _ hR := by
      rw [Scheme.Hom.app_eq_appLE δ, ← Category.assoc]
      exact Scheme.Hom.appLE_comp_appLE δ g (wcPmChart.{u} N J) _ _ _ _
    have mR' : (δ ≫ g).app (wcPmChart.{u} N J) ≫ D.presheaf.map (homOfLE hR).op =
        (δ ≫ g).appLE (wcPmChart.{u} N J) _ hR := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
    have mL' : (δ ≫ p).appLE (U i) ((δ ≫ g) ⁻¹ᵁ wcPmChart.{u} N J) hle ≫
        D.presheaf.map (homOfLE hR).op = (δ ≫ p).appLE (U i) _ hL :=
      Scheme.Hom.appLE_map _ _ _
    have e1 := congrArg (fun f => f.hom x) (mL.trans mL'.symm)
    have e2 := congrArg (fun f => f.hom y) (mR.trans mR'.symm)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e1 e2
    refine e1.trans ?_
    refine Eq.trans ?_ e2.symm
    exact congrArg (fun z => (D.presheaf.map (homOfLE hR).op).hom z) hxy.symm

  have key : ∀ (W : X.Opens) (b : B),
      p.app W (((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp
        (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) b) =
      ((Z.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ W ≤ ⊤)).op).hom.comp
        ((p ≫ h).appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) b := by
    intro W b
    simp only [RingHom.comp_apply]
    rw [← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply,
      Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    rfl
  have hB : ∀ b : B, Z.presheaf.map (homOfLE (inf_le_left :
      p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ p ⁻¹ᵁ U i)).op
      (p.app (U i) (((X.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom.comp
        (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) b)) =
      ((Z.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op).hom.comp
        ((p ≫ h).appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) b := by
    intro b
    have hm : Z.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ U i ≤ ⊤)).op ≫
        Z.presheaf.map (homOfLE (inf_le_left :
          p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ p ⁻¹ᵁ U i)).op =
        Z.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op := by
      rw [← Functor.map_comp]
      rfl
    rw [key (U i) b]
    exact congrArg (fun f => f.hom (((p ≫ h).appTop.hom.comp
      (Scheme.ΓSpecIso (.of B)).inv.hom) b)) hm
  have hC : IsAffineOpen (wcPmChart.{u} N J) :=
    (@Proj.isAffineOpen_basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)) MvPolynomial.gradedAlgebra
      (MvPolynomial.X J) 1 ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr
        (MvPolynomial.isHomogeneous_X _ J)) one_pos : IsAffineOpen (wcPmChart.{u} N J))
  obtain ⟨hVaff, hgen⟩ := s1 (U i) (wcPmChart.{u} N J) (hU i) hC
  refine ⟨hVaff, fun t => ?_⟩
  have hkey : ∀ k : Fin (n i + 1), Z.presheaf.map (homOfLE (inf_le_left :
          p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ p ⁻¹ᵁ U i)).op (p.app (U i) (a i k)) =
        Z.presheaf.map (homOfLE (inf_le_right :
          p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ g ⁻¹ᵁ wcPmChart.{u} N J)).op
          (g.app (wcPmChart.{u} N J) (e J (κ.symm (Function.update (κ J) i k)))) :=
    fun k => s3 (a i k) _ (le_top.trans (hψU i).ge) (s2 k)
  refine Subring.closure_le.mpr ?_ (hgen t)
  rintro _ (⟨x, rfl⟩ | ⟨y, rfl⟩)
  · apply Subring.mem_comap.mp
    refine Subring.closure_le.mpr ?_ (hagen i x)
    rintro _ (⟨b, rfl⟩ | ⟨k, rfl⟩)
    · exact Subring.mem_comap.mpr (Subring.subset_closure (Or.inl ⟨b, (hB b).symm⟩))
    · exact Subring.mem_comap.mpr (Subring.subset_closure (Or.inr ⟨_, (hkey k).symm⟩))
  · exact Subring.subset_closure (Or.inr ⟨y, rfl⟩)

theorem wc_chow_chart_contained : ∀ (B : Type u) [CommRing B] (X Z D : Scheme.{u}) (h : X ⟶ Spec (.of B)) (N : ℕ) (p : Z ⟶ X) (g : Z ⟶ wcPm.{u} N) (δ : D ⟶ Z) (U : X.Opens) (J : Fin (N + 1)), (∀ (X Y : Scheme.{u}) (U : X.Opens) (V : Y.Opens), IsAffineOpen U → IsAffineOpen V → IsAffineOpen ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) ∧ ∀ t : Γ(X ⨯ Y, (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V), t ∈ Subring.closure (Set.range (((X ⨯ Y).presheaf.map (homOfLE (inf_le_left : (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V ≤ (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U)).op).hom.comp ((Limits.prod.fst : X ⨯ Y ⟶ X).app U).hom) ∪ Set.range (((X ⨯ Y).presheaf.map (homOfLE (inf_le_right : (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V ≤ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V)).op).hom.comp ((Limits.prod.snd : X ⨯ Y ⟶ Y).app V).hom))) → IsSeparated (p ≫ h) → DenseRange δ → (δ ≫ p) ⁻¹ᵁ U = ⊤ → IsAffineOpen (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ wcPmChart.{u} N J) → (∀ t : Γ(Z, p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ wcPmChart.{u} N J), t ∈ Subring.closure (Set.range ((Z.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op).hom.comp ((p ≫ h).appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range ((Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ wcPmChart.{u} N J ≤ g ⁻¹ᵁ wcPmChart.{u} N J)).op).hom.comp (g.app (wcPmChart.{u} N J)).hom))) → g ⁻¹ᵁ wcPmChart.{u} N J ≤ p ⁻¹ᵁ U :=
by
  intro B _ X Z D h N p g δ U J H4 hsep hδ hδU hVaff hgen

  have s2 : ∀ (Z E : Scheme.{u}) (Λ : Z ⟶ E) (O : E.Opens) (V G : Z.Opens) (hVG : V ≤ G)
      (hGO : G ≤ Λ ⁻¹ᵁ O), IsSeparated Λ → IsAffineOpen O → IsAffineOpen V →
      Function.Surjective (Λ.appLE O V (hVG.trans hGO)).hom → IsClosedImmersion (Z.homOfLE hVG) := by
    intro Z E Λ O V G hVG hGO hΛ hO hV hs
    haveI := hΛ
    haveI : IsAffine O := hO
    haveI : IsAffine V := hV
    have hρV : IsClosedImmersion (Λ.resLE O V (hVG.trans hGO)) := by
      apply IsClosedImmersion.of_surjective_of_isAffine
      change Function.Surjective ((Λ.resLE O V (hVG.trans hGO)).app ⊤).hom
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE]
      have e₁ : O.ι ''ᵁ ⊤ = O := Scheme.Opens.ι_image_top O
      have e₂ : V.ι ''ᵁ ((Λ.resLE O V (hVG.trans hGO)) ⁻¹ᵁ ⊤) = V := by
        rw [Scheme.Hom.preimage_top, Scheme.Opens.ι_image_top]
      exact (Scheme.Hom.appLE_congr Λ _ e₁ e₂ (fun φ => Function.Surjective φ.hom)).mpr hs
    haveI : IsSeparated (Λ.resLE O G hGO ≫ O.ι) := by
      rw [Scheme.Hom.resLE_comp_ι]; infer_instance
    haveI : IsSeparated (Λ.resLE O G hGO) := IsSeparated.of_comp _ O.ι
    haveI : IsClosedImmersion (Z.homOfLE hVG ≫ Λ.resLE O G hGO) := by
      rw [Scheme.Hom.map_resLE]; exact hρV
    exact IsClosedImmersion.of_comp _ (Λ.resLE O G hGO)

  have s4 : ∀ (Z D : Scheme.{u}) (δ : D ⟶ Z) (V G : Z.Opens) (hVG : V ≤ G),
      IsClosedImmersion (Z.homOfLE hVG) → DenseRange δ → (∀ x : D, δ x ∈ G → δ x ∈ V) →
      G ≤ V := by
    intro Z D δ V G hVG hci hδ hD z hzG
    by_contra hzV
    have hcl : IsClosed (Set.range (Z.homOfLE hVG)) :=
      (Z.homOfLE hVG).isClosedEmbedding.isClosed_range
    have hrange : ∀ (W : Z.Opens) (y : Z), y ∈ W ↔ y ∈ Set.range W.ι := by
      intro W y
      rw [Scheme.Opens.range_ι]; rfl
    have hmem : ∀ ω : (G : Scheme.{u}), ω ∈ Set.range (Z.homOfLE hVG) ↔ G.ι ω ∈ V := by
      intro ω
      constructor
      · rintro ⟨y, rfl⟩
        rw [← Scheme.Hom.comp_apply, Scheme.homOfLE_ι, hrange]
        exact ⟨y, rfl⟩
      · intro hω
        obtain ⟨y, hy⟩ := (hrange V _).mp hω
        refine ⟨y, G.ι.isOpenEmbedding.injective ?_⟩
        rw [← Scheme.Hom.comp_apply, Scheme.homOfLE_ι, hy]
    have hO : IsOpen (G.ι '' (Set.range (Z.homOfLE hVG))ᶜ) :=
      G.ι.isOpenEmbedding.isOpenMap _ hcl.isOpen_compl
    obtain ⟨ω0, hω0⟩ := (hrange G z).mp hzG
    have hne : (G.ι '' (Set.range (Z.homOfLE hVG))ᶜ).Nonempty :=
      ⟨z, ω0, fun hh => hzV (by rw [← hω0]; exact (hmem _).mp hh), hω0⟩
    obtain ⟨_, ⟨ω, hω, rfl⟩, ⟨x, hx⟩⟩ := hδ.inter_open_nonempty _ hO hne
    apply hω
    rw [hmem, ← hx]
    apply hD
    rw [hx, hrange]
    exact ⟨ω, rfl⟩

  have s3 : ∀ (P : Scheme.{u}) (q : Z ⟶ Spec (.of B)) (g : Z ⟶ P) (C : P.Opens) (V : Z.Opens)
      (hVG : V ≤ g ⁻¹ᵁ C) (hVO : V ≤ (Limits.prod.lift q g) ⁻¹ᵁ
        ((Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
          (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P) ⁻¹ᵁ C)),
      (∀ t : Γ(Z, V), t ∈ Subring.closure (Set.range ((Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp
        (q.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪
          Set.range ((Z.presheaf.map (homOfLE hVG).op).hom.comp (g.app C).hom))) →
      Function.Surjective ((Limits.prod.lift q g).appLE
        ((Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
          (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P) ⁻¹ᵁ C) V hVO).hom := by
    intro P q g C V hVG hVO hg t
    have hA : ∀ (f f' : Z ⟶ Spec (.of B)) (_ : f = f') (e : V ≤ f ⁻¹ᵁ ⊤),
        f.appLE ⊤ V e = f'.appTop ≫ Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op := by
      intro f f' hf e; subst hf; rfl
    have hB : ∀ (f : Z ⟶ P) (_ : f = g) (e : V ≤ f ⁻¹ᵁ C),
        f.appLE C V e = g.app C ≫ Z.presheaf.map (homOfLE hVG).op := by
      intro f hf e; subst hf; rfl
    have h1 : (Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)).app ⊤ ≫
        (Spec (.of B) ⨯ P).presheaf.map (homOfLE (inf_le_left :
          (Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
            (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P) ⁻¹ᵁ C ≤
              (Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)) ⁻¹ᵁ ⊤)).op ≫
        (Limits.prod.lift q g).appLE _ V hVO =
        q.appTop ≫ Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op := by
      rw [Scheme.Hom.map_appLE, ← hA (Limits.prod.lift q g ≫ Limits.prod.fst) q
        (Limits.prod.lift_fst _ _) (by rw [Scheme.Hom.preimage_top]; exact le_top),
        Scheme.Hom.comp_appLE]
    have h2 : (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P).app C ≫
        (Spec (.of B) ⨯ P).presheaf.map (homOfLE (inf_le_right :
          (Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
            (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P) ⁻¹ᵁ C ≤
              (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P) ⁻¹ᵁ C)).op ≫
        (Limits.prod.lift q g).appLE _ V hVO =
        g.app C ≫ Z.presheaf.map (homOfLE hVG).op := by
      rw [Scheme.Hom.map_appLE, ← hB (Limits.prod.lift q g ≫ Limits.prod.snd)
        (Limits.prod.lift_snd _ _) (by rw [Limits.prod.lift_snd]; exact hVG),
        Scheme.Hom.comp_appLE]
    have hle : Subring.closure (Set.range ((Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp
        (q.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪
          Set.range ((Z.presheaf.map (homOfLE hVG).op).hom.comp (g.app C).hom)) ≤
        ((Limits.prod.lift q g).appLE _ V hVO).hom.range := by
      rw [Subring.closure_le]
      rintro _ (⟨b, rfl⟩ | ⟨y, rfl⟩)
      · refine ⟨((Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)).app ⊤ ≫
          (Spec (.of B) ⨯ P).presheaf.map (homOfLE (inf_le_left :
            (Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
              (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P) ⁻¹ᵁ C ≤
                (Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)) ⁻¹ᵁ ⊤)).op).hom
            ((Scheme.ΓSpecIso (.of B)).inv.hom b), ?_⟩
        change ((Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)).app ⊤ ≫
          (Spec (.of B) ⨯ P).presheaf.map _ ≫ (Limits.prod.lift q g).appLE _ V hVO).hom
            ((Scheme.ΓSpecIso (.of B)).inv.hom b) =
          (q.appTop ≫ Z.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
            ((Scheme.ΓSpecIso (.of B)).inv.hom b)
        rw [h1]
      · refine ⟨((Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P).app C ≫
          (Spec (.of B) ⨯ P).presheaf.map (homOfLE (inf_le_right :
            (Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
              (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P) ⁻¹ᵁ C ≤
                (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P) ⁻¹ᵁ C)).op).hom y, ?_⟩
        change ((Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P).app C ≫
          (Spec (.of B) ⨯ P).presheaf.map _ ≫ (Limits.prod.lift q g).appLE _ V hVO).hom y =
          (g.app C ≫ Z.presheaf.map (homOfLE hVG).op).hom y
        rw [h2]
    exact (RingHom.mem_range).mp (hle (hg t))

  have hC : IsAffineOpen (wcPmChart.{u} N J) := by
    unfold wcPmChart
    exact @Proj.isAffineOpen_basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)) MvPolynomial.gradedAlgebra
      (MvPolynomial.X J) 1
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J)) one_pos
  have hO := (H4 (Spec (.of B)) (wcPm.{u} N) ⊤ (wcPmChart.{u} N J)
    (isAffineOpen_top _) hC).1
  have hGO : g ⁻¹ᵁ wcPmChart.{u} N J ≤ (Limits.prod.lift (p ≫ h) g) ⁻¹ᵁ
      ((Limits.prod.fst : Spec (.of B) ⨯ wcPm.{u} N ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
        (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} N ⟶ wcPm.{u} N) ⁻¹ᵁ wcPmChart.{u} N J) := by
    intro z hz
    refine ⟨?_, ?_⟩
    · show (Limits.prod.fst : Spec (.of B) ⨯ wcPm.{u} N ⟶ Spec (.of B))
        (Limits.prod.lift (p ≫ h) g z) ∈ (⊤ : (Spec (.of B)).Opens)
      exact Set.mem_univ _
    · show (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} N ⟶ wcPm.{u} N)
        (Limits.prod.lift (p ≫ h) g z) ∈ wcPmChart.{u} N J
      rw [← Scheme.Hom.comp_apply, Limits.prod.lift_snd]
      exact hz
  have hΛsep : IsSeparated (Limits.prod.lift (p ≫ h) g) := by
    haveI := hsep
    haveI : IsSeparated (Limits.prod.lift (p ≫ h) g ≫ Limits.prod.fst) := by
      rw [Limits.prod.lift_fst]; exact hsep
    exact IsSeparated.of_comp _ Limits.prod.fst
  have hsurj := s3 (wcPm.{u} N) (p ≫ h) g (wcPmChart.{u} N J)
    (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ wcPmChart.{u} N J) inf_le_right (inf_le_right.trans hGO) hgen
  have hci := s2 Z _ (Limits.prod.lift (p ≫ h) g) _ (p ⁻¹ᵁ U ⊓ g ⁻¹ᵁ wcPmChart.{u} N J)
    (g ⁻¹ᵁ wcPmChart.{u} N J) inf_le_right hGO hΛsep hO hVaff hsurj
  have hGV := s4 Z D δ _ _ inf_le_right hci hδ (fun x hx => by
    refine ⟨?_, hx⟩
    have hx' : x ∈ (δ ≫ p) ⁻¹ᵁ U := by rw [hδU]; trivial
    exact hx')
  exact hGV.trans inf_le_left

theorem wc_chow_charts_cover : ∀ (X : Scheme.{u}) (N : ℕ) (e : ∀ J K : Fin (N + 1), Γ(wcPm.{u} N, wcPmChart.{u} N J)) (r : ℕ) (U : Fin (r + 1) → X.Opens) (n : Fin (r + 1) → ℕ) (a : ∀ i, Fin (n i + 1) → Γ(X, U i)) (κ : Fin (N + 1) ≃ (∀ i, Fin (n i + 1))) (Z D : Scheme.{u}) [IsReduced Z] (p : Z ⟶ X) (g : Z ⟶ wcPm.{u} N) (δ : D ⟶ Z) (ψ : D ⟶ X) (φ : D ⟶ wcPm.{u} N) (s : Fin (N + 1) → Γ(D, ⊤)) (hψU : ∀ i, ψ ⁻¹ᵁ U i = ⊤), (∀ (Z D : Scheme.{u}) [IsReduced Z] (δ : D ⟶ Z), DenseRange δ → ∀ (V : Z.Opens) (s t : Γ(Z, V)), δ.app V s = δ.app V t → s = t) → δ ≫ p = ψ → δ ≫ g = φ → DenseRange δ → (∀ i, a i 0 = 1) → (∀ K, s K = ∏ i, ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ K i))) → (∀ J, φ ⁻¹ᵁ wcPmChart.{u} N J = D.basicOpen (s J)) → (∀ J K, φ.app (wcPmChart.{u} N J) (e J K) * D.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op (s J) = D.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ wcPmChart.{u} N J ≤ ⊤)).op (s K)) → (⨆ J, wcPmChart.{u} N J) = ⊤ → (∀ J K, (wcPm.{u} N).basicOpen (e J K) = wcPmChart.{u} N J ⊓ wcPmChart.{u} N K) → (∀ z : Z, ∃ i, p z ∈ U i) → ∀ z : Z, ∃ J : Fin (N + 1), (∃ i, κ J i = 0) ∧ g z ∈ wcPmChart.{u} N J :=
by
  intro X N e r U n a κ Z D _ p g δ ψ φ s hψU hdenseinj hδp hδg hδ ha0 hs hφ hrel hcov hbo hpU z
  classical

  have hunit : ∀ (W : D.Opens) (f : Γ(D, ⊤)), W = D.basicOpen f →
      IsUnit (D.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op f) := by
    intro W f hW
    subst hW
    exact RingedSpace.isUnit_res_basicOpen D.toRingedSpace f

  have s2 : ∀ (ψ' : D ⟶ X) (φ' : D ⟶ wcPm.{u} N) (U' : X.Opens) (C : (wcPm.{u} N).Opens)
      (hU : ψ' ⁻¹ᵁ U' = ⊤) (a' : Γ(X, U')) (b : Γ(wcPm.{u} N, C)), δ ≫ p = ψ' → δ ≫ g = φ' →
      φ'.app C b * D.presheaf.map (homOfLE (le_top : φ' ⁻¹ᵁ C ≤ ⊤)).op (ψ'.appLE U' ⊤ hU.ge a') = 1 →
      Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U' ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op (g.app C b) *
        Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ U' ⊓ g ⁻¹ᵁ C ≤ p ⁻¹ᵁ U')).op (p.app U' a') = 1 := by
    intro ψ' φ' U' C hU a' b hp hg h
    subst hp hg
    apply hdenseinj Z D δ hδ
    rw [map_mul, map_one]
    have hle : δ ⁻¹ᵁ (p ⁻¹ᵁ U' ⊓ g ⁻¹ᵁ C) ≤ (δ ≫ g) ⁻¹ᵁ C := fun x hx => hx.2
    have h2 := congrArg (D.presheaf.map (homOfLE hle).op) h
    rw [map_mul, map_one] at h2
    have k1 : g.app C ≫ Z.presheaf.map (homOfLE (inf_le_right : p ⁻¹ᵁ U' ⊓ g ⁻¹ᵁ C ≤ g ⁻¹ᵁ C)).op ≫
        δ.app (p ⁻¹ᵁ U' ⊓ g ⁻¹ᵁ C) = (δ ≫ g).app C ≫ D.presheaf.map (homOfLE hle).op := by
      simp only [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map, Scheme.Hom.appLE_map_assoc,
        Scheme.Hom.appLE_comp_appLE]
    have k2 : p.app U' ≫ Z.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ U' ⊓ g ⁻¹ᵁ C ≤ p ⁻¹ᵁ U')).op ≫
        δ.app (p ⁻¹ᵁ U' ⊓ g ⁻¹ᵁ C) = (δ ≫ p).appLE U' ⊤ hU.ge ≫
          D.presheaf.map (homOfLE (le_top : (δ ≫ g) ⁻¹ᵁ C ≤ ⊤)).op ≫
          D.presheaf.map (homOfLE hle).op := by
      simp only [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map, Scheme.Hom.appLE_map_assoc,
        Scheme.Hom.appLE_comp_appLE]
    have e1 := congrArg (fun f => (ConcreteCategory.hom f) b) k1
    have e2 := congrArg (fun f => (ConcreteCategory.hom f) a') k2
    simp only [CommRingCat.comp_apply] at e1 e2
    rw [e1, e2]
    exact h2

  obtain ⟨i, hi⟩ := hpU z
  have hgz : g z ∈ (⨆ J, wcPmChart.{u} N J) := by rw [hcov]; trivial
  obtain ⟨J', hJ'⟩ := TopologicalSpace.Opens.mem_iSup.mp hgz
  obtain ⟨J, hκJ⟩ : ∃ J, κ J = Function.update (κ J') i 0 :=
    ⟨κ.symm (Function.update (κ J') i 0), Equiv.apply_symm_apply _ _⟩
  have hJi : κ J i = 0 := by rw [hκJ, Function.update_self]

  have hsJ' : s J' = ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ J' i)) *
      ∏ l ∈ ({i}ᶜ : Finset (Fin (r + 1))), ψ.appLE (U l) ⊤ (hψU l).ge (a l (κ J' l)) := by
    rw [hs J', Fintype.prod_eq_mul_prod_compl i]
  have hsJ : s J =
      ∏ l ∈ ({i}ᶜ : Finset (Fin (r + 1))), ψ.appLE (U l) ⊤ (hψU l).ge (a l (κ J' l)) := by
    rw [hs J, Fintype.prod_eq_mul_prod_compl i, hJi, ha0, map_one, one_mul]
    apply Finset.prod_congr rfl
    intro l hl
    have hli : l ≠ i := by simpa using hl
    rw [hκJ, Function.update_of_ne hli]
  have hr := hrel J' J
  rw [hsJ', hsJ, map_mul] at hr
  have hu := hunit _ _ (hφ J')
  rw [hsJ', map_mul] at hu
  have huc := isUnit_of_mul_isUnit_right hu
  have hD : φ.app (wcPmChart.{u} N J') (e J' J) *
      D.presheaf.map (homOfLE (le_top : φ ⁻¹ᵁ wcPmChart.{u} N J' ≤ ⊤)).op
        (ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ J' i))) = 1 := by
    apply huc.mul_right_cancel
    rw [one_mul, mul_assoc]
    exact hr

  have hZ := s2 ψ φ (U i) (wcPmChart.{u} N J') (hψU i) (a i (κ J' i)) (e J' J) hδp hδg hD
  have hGu := IsUnit.of_mul_eq_one _ hZ
  have hbo' := Scheme.basicOpen_of_isUnit Z hGu
  rw [Scheme.basicOpen_res] at hbo'
  have hzO : z ∈ p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J' := ⟨hi, hJ'⟩
  rw [← hbo'] at hzO
  have hz2 : z ∈ g ⁻¹ᵁ (wcPm.{u} N).basicOpen (e J' J) := by
    rw [Scheme.preimage_basicOpen]
    exact hzO.2
  rw [hbo] at hz2
  exact ⟨J, ⟨i, hJi⟩, hz2.2⟩

theorem wc_closed_immersion_of_charts : ∀ (B : Type u) [CommRing B] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of B)) (N : ℕ) (g : Y ⟶ wcPm.{u} N) (S : Set (Fin (N + 1))), (∀ (X Y : Scheme.{u}) (U : X.Opens) (V : Y.Opens), IsAffineOpen U → IsAffineOpen V → IsAffineOpen ((Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V) ∧ ∀ t : Γ(X ⨯ Y, (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V), t ∈ Subring.closure (Set.range (((X ⨯ Y).presheaf.map (homOfLE (inf_le_left : (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V ≤ (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U)).op).hom.comp ((Limits.prod.fst : X ⨯ Y ⟶ X).app U).hom) ∪ Set.range (((X ⨯ Y).presheaf.map (homOfLE (inf_le_right : (Limits.prod.fst : X ⨯ Y ⟶ X) ⁻¹ᵁ U ⊓ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V ≤ (Limits.prod.snd : X ⨯ Y ⟶ Y) ⁻¹ᵁ V)).op).hom.comp ((Limits.prod.snd : X ⨯ Y ⟶ Y).app V).hom))) → IsClosed (Set.range (Limits.prod.lift q g)) → (∀ y : Y, ∃ J ∈ S, g y ∈ wcPmChart.{u} N J) → (∀ J ∈ S, ∃ (W : Y.Opens) (hW : W ≤ g ⁻¹ᵁ wcPmChart.{u} N J), g ⁻¹ᵁ wcPmChart.{u} N J ≤ W ∧ IsAffineOpen W ∧ ∀ t : Γ(Y, W), t ∈ Subring.closure (Set.range ((Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp (q.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range ((Y.presheaf.map (homOfLE hW).op).hom.comp (g.app (wcPmChart.{u} N J)).hom))) → IsClosedImmersion (Limits.prod.lift q g) :=
by
  intro B _ Y q N g S hprod hcl hcov hch

  have s1 : ∀ (Y E : Scheme.{u}) (f : Y ⟶ E) (O : E.Opens) (W : Y.Opens) (hle : W ≤ f ⁻¹ᵁ O),
      f ⁻¹ᵁ O ≤ W → IsAffineOpen O → IsAffineOpen W →
      Function.Surjective (f.appLE O W hle) → IsClosedImmersion (f ∣_ O) := by
    intro Y E f O W hle hge hO hW hs
    have hWeq : W = f ⁻¹ᵁ O := le_antisymm hle hge
    subst hWeq
    have : IsAffine (O : Scheme.{u}) := hO
    have : IsAffine ((f ⁻¹ᵁ O : Y.Opens) : Scheme.{u}) := hW
    apply IsClosedImmersion.of_surjective_of_isAffine
    rw [Scheme.Hom.appTop, morphismRestrict_app']
    refine (Scheme.Hom.appLE_congr f _ (Scheme.Opens.ι_image_top O).symm ?_
      (fun φ => Function.Surjective φ)).mp hs
    rw [Scheme.Hom.preimage_top, Scheme.Opens.ι_image_top]

  have s2 : ∀ (P : Scheme.{u}) (g : Y ⟶ P) (V : P.Opens) (W : Y.Opens) (hW : W ≤ g ⁻¹ᵁ V)
      (hW' : W ≤ (Limits.prod.lift q g) ⁻¹ᵁ ((Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓ (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P) ⁻¹ᵁ V)),
      (∀ t : Γ(Y, W), t ∈ Subring.closure (Set.range ((Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp (q.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range ((Y.presheaf.map (homOfLE hW).op).hom.comp (g.app V).hom))) →
      Function.Surjective ((Limits.prod.lift q g).appLE ((Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓ (Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P) ⁻¹ᵁ V) W hW') := by
    intro P g V W hW hW' hgen
    have hcongr : ∀ {A : Scheme.{u}} (f₁ f₂ : Y ⟶ A) (U : A.Opens) (h : f₁ = f₂)
        (e₁ : W ≤ f₁ ⁻¹ᵁ U) (e₂ : W ≤ f₂ ⁻¹ᵁ U), f₁.appLE U W e₁ = f₂.appLE U W e₂ := by
      rintro A f₁ f₂ U rfl e₁ e₂; rfl
    intro t
    have hle : Subring.closure (Set.range ((Y.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp (q.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range ((Y.presheaf.map (homOfLE hW).op).hom.comp (g.app V).hom)) ≤ ((Limits.prod.lift q g).appLE _ W hW').hom.range := by
      rw [Subring.closure_le]
      rintro x (⟨b, rfl⟩ | ⟨y, rfl⟩)
      · refine ⟨(Limits.prod.fst : Spec (.of B) ⨯ P ⟶ Spec (.of B)).appLE ⊤ _ inf_le_left
          ((Scheme.ΓSpecIso (.of B)).inv b), ?_⟩
        rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE,
          hcongr _ q _ (Limits.prod.lift_fst q g) _ (by simp)]
        rfl
      · refine ⟨(Limits.prod.snd : Spec (.of B) ⨯ P ⟶ P).appLE V _ inf_le_right y, ?_⟩
        rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE,
          hcongr _ g _ (Limits.prod.lift_snd q g) _ hW]
        rfl
    obtain ⟨x, hx⟩ := hle (hgen t)
    exact ⟨x, hx⟩

  have s3 : ∀ (V : (wcPm.{u} N).Opens), (Limits.prod.lift q g) ⁻¹ᵁ ((Limits.prod.fst : Spec (.of B) ⨯ wcPm.{u} N ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓ (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} N ⟶ wcPm.{u} N) ⁻¹ᵁ V) = g ⁻¹ᵁ V := by
    intro V
    rw [Scheme.Hom.preimage_inf, ← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage,
      Limits.prod.lift_fst, Limits.prod.lift_snd, Scheme.Hom.preimage_top, top_inf_eq]

  have s4 : ∀ J : Fin (N + 1), IsAffineOpen (wcPmChart.{u} N J) := by
    intro J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)) :=
      MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ))
      (MvPolynomial.X J) ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X _ J)) one_pos

  let U : Option S → (Spec (.of B) ⨯ wcPm.{u} N).Opens := fun o => match o with
    | none => ⟨(Set.range (Limits.prod.lift q g))ᶜ, hcl.isOpen_compl⟩
    | some J => (Limits.prod.fst : Spec (.of B) ⨯ wcPm.{u} N ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
        (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} N ⟶ wcPm.{u} N) ⁻¹ᵁ wcPmChart.{u} N J.1
  have hU : iSup U = ⊤ := by
    rw [eq_top_iff]
    intro e _
    by_cases he : e ∈ Set.range (Limits.prod.lift q g)
    · obtain ⟨y, rfl⟩ := he
      obtain ⟨J, hJS, hJ⟩ := hcov y
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨some ⟨J, hJS⟩, ?_⟩
      have hy : y ∈ (Limits.prod.lift q g) ⁻¹ᵁ ((Limits.prod.fst : Spec (.of B) ⨯ wcPm.{u} N ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
          (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} N ⟶ wcPm.{u} N) ⁻¹ᵁ wcPmChart.{u} N J) := by
        rw [s3]; exact hJ
      exact hy
    · exact TopologicalSpace.Opens.mem_iSup.mpr ⟨none, he⟩
  refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion) U hU ?_
  rintro (_ | ⟨J, hJS⟩)
  · haveI : IsEmpty (↑((Limits.prod.lift q g) ⁻¹ᵁ U none) : Scheme.{u}) :=
      ⟨fun x => x.2 ⟨x.1, rfl⟩⟩
    infer_instance
  · obtain ⟨W, hW, hW2, hWaff, hgen⟩ := hch J hJS
    have hpre := s3 (wcPmChart.{u} N J)
    have hle : W ≤ (Limits.prod.lift q g) ⁻¹ᵁ ((Limits.prod.fst : Spec (.of B) ⨯ wcPm.{u} N ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
        (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} N ⟶ wcPm.{u} N) ⁻¹ᵁ wcPmChart.{u} N J) := by
      rw [hpre]; exact hW
    have hge : (Limits.prod.lift q g) ⁻¹ᵁ ((Limits.prod.fst : Spec (.of B) ⨯ wcPm.{u} N ⟶ Spec (.of B)) ⁻¹ᵁ ⊤ ⊓
        (Limits.prod.snd : Spec (.of B) ⨯ wcPm.{u} N ⟶ wcPm.{u} N) ⁻¹ᵁ wcPmChart.{u} N J) ≤ W := by
      rw [hpre]; exact hW2
    have hOaff := (hprod (Spec (.of B)) (wcPm.{u} N) ⊤ (wcPmChart.{u} N J)
      (isAffineOpen_top _) (s4 J)).1
    exact s1 Y _ (Limits.prod.lift q g) _ W hle hge hOaff hWaff
      (s2 (wcPm.{u} N) g (wcPmChart.{u} N J) W hW hle hgen)

theorem wc_chow_projective_model : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)) [IsProper h] (T : TopologicalSpace.Closeds X), IsIrreducible (T : Set X) → ∃ (Z : Scheme.{u}) (p : Z ⟶ X) (m : ℕ) (g : Z ⟶ wcPm.{u} m), IsProper p ∧ Set.range p ⊆ (T : Set X) ∧ IsClosedImmersion (Limits.prod.lift (p ≫ h) g) ∧ IsClosedImmersion (Limits.prod.lift p g) ∧ ∃ U₀ : X.Opens, IsAffineOpen U₀ ∧ ((U₀ : Set X) ∩ T).Nonempty ∧ Function.Surjective (p.app U₀) ∧ ∀ a : Γ(X, U₀), p.app U₀ a = 0 ↔ ∀ x ∈ U₀, x ∈ T → x ∉ X.basicOpen a :=
by
  intro B _ _ X h _ T hT
  classical

  have hlift : ∀ (R S C : Scheme.{u}) [IsReduced R] (a : R ⟶ S) (j : C ⟶ S) [IsClosedImmersion j],
      Set.range a ⊆ Set.range j → ∃ b : R ⟶ C, b ≫ j = a := by
    intro R S C _ a j _ H
    refine ⟨IsClosedImmersion.lift j a ?_, IsClosedImmersion.lift_fac _ _ _⟩
    show _ ≤ Scheme.IdealSheafData.ofIdeals _
    rw [Scheme.IdealSheafData.le_ofIdeals_iff]
    intro V t ht
    have hj : t ∈ RingHom.ker (j.app V.1).hom :=
      Scheme.IdealSheafData.ideal_ofIdeals_le _ V ht
    rw [RingHom.mem_ker] at hj ⊢
    apply eq_zero_of_basicOpen_eq_bot
    rw [← Scheme.preimage_basicOpen]
    have hC : j ⁻¹ᵁ S.basicOpen t = ⊥ := by
      rw [Scheme.preimage_basicOpen, hj, Scheme.basicOpen_zero]
    apply eq_bot_iff.mpr
    intro x hx
    obtain ⟨c, hc⟩ := H ⟨x, rfl⟩
    have : c ∈ j ⁻¹ᵁ S.basicOpen t := by
      show j c ∈ S.basicOpen t
      rw [hc]; exact hx
    rw [hC] at this
    exact this

  have hdenseinj : ∀ (Z D : Scheme.{u}) [IsReduced Z] (δ : D ⟶ Z), DenseRange δ →
      ∀ (V : Z.Opens) (s t : Γ(Z, V)), δ.app V s = δ.app V t → s = t := by
    intro Z D _ δ hδ V s t hst
    rw [← sub_eq_zero]
    apply eq_zero_of_basicOpen_eq_bot
    have h0 : δ.app V (s - t) = 0 := by rw [map_sub, hst, sub_self]
    have hpre : δ ⁻¹ᵁ Z.basicOpen (s - t) = ⊥ := by
      rw [Scheme.preimage_basicOpen, h0, Scheme.basicOpen_zero]
    by_contra hne
    obtain ⟨z, hz⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mp hne
    obtain ⟨_, hzr, ⟨x, rfl⟩⟩ := hδ.inter_open_nonempty (Z.basicOpen (s - t))
      (Z.basicOpen (s - t)).isOpen ⟨z, hz⟩
    have hx : x ∈ δ ⁻¹ᵁ Z.basicOpen (s - t) := hzr
    rw [hpre] at hx
    exact hx
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace h
  have hsepX : IsSeparated (Limits.terminal.from X) := by
    have e : Limits.terminal.from X = h ≫ Limits.terminal.from (Spec (.of B)) :=
      Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance

  obtain ⟨r, U, W, hU, hcovT, hW, hWT, hWU⟩ : ∃ (r : ℕ) (U : Fin (r + 1) → X.Opens) (W : X.Opens),
      (∀ i, IsAffineOpen (U i)) ∧ (∀ x ∈ (T : Set X), ∃ i, x ∈ U i) ∧ IsAffineOpen W ∧
        ((W : Set X) ∩ T).Nonempty ∧ ∀ i, W ≤ U i := by
    have hbasis : ∀ {U : X.Opens} {x : X}, x ∈ U → ∃ U' ∈ X.affineOpens, x ∈ U' ∧ U' ≤ U :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    have hA : ∀ x : X, ∃ A : X.Opens, IsAffineOpen A ∧ x ∈ A := by
      intro x
      obtain ⟨U', hU', hxU', -⟩ := hbasis (show x ∈ (⊤ : X.Opens) from trivial)
      exact ⟨U', hU', hxU'⟩
    choose A hAaff hAmem using hA
    have hTc : IsCompact (T : Set X) := T.isClosed.isCompact
    obtain ⟨t, ht⟩ := hTc.elim_finite_subcover (fun x : (T : Set X) => (A x : Set X))
      (fun _ => (A _).isOpen) (fun y hy => Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hAmem y⟩)
    obtain ⟨y0, hy0⟩ := hT.nonempty
    have htne : t.Nonempty := by
      have := ht hy0
      simp only [Set.mem_iUnion] at this
      obtain ⟨x, hx, _⟩ := this
      exact ⟨x, hx⟩
    obtain ⟨r, hr⟩ : ∃ r, t.card = r + 1 := ⟨t.card - 1, by have := htne.card_pos; omega⟩
    let e := t.equivFinOfCardEq hr
    let U : Fin (r + 1) → X.Opens := fun i => A (e.symm i).1
    have hUT : ∀ i, ((T : Set X) ∩ (U i : Set X)).Nonempty :=
      fun i => ⟨(e.symm i).1.1, (e.symm i).1.2, hAmem _⟩
    have key : ∀ (s : Finset (Fin (r + 1))), ((T : Set X) ∩ (⋂ i ∈ s, (U i : Set X))).Nonempty := by
      intro s
      induction s using Finset.induction_on with
      | empty => simpa using hT.nonempty
      | insert j s hj ih =>
        have h := hT.2 (U j) (⋂ i ∈ s, (U i : Set X)) (U j).isOpen
          (isOpen_biInter_finset (fun i _ => (U i).isOpen)) (hUT j) ih
        simpa [Finset.set_biInter_insert] using h
    obtain ⟨y, hyT, hyU⟩ := key Finset.univ
    simp only [Finset.mem_univ, Set.iInter_true] at hyU
    let O : X.Opens := ⟨⋂ i, (U i : Set X), isOpen_iInter_of_finite (fun i => (U i).isOpen)⟩
    obtain ⟨W, hW, hyW, hWO⟩ := hbasis (show y ∈ O from hyU)
    refine ⟨r, U, W, fun i => hAaff _, ?_, hW, ⟨y, hyW, hyT⟩, ?_⟩
    · intro x hx
      have := ht hx
      simp only [Set.mem_iUnion] at this
      obtain ⟨z, hz, hxz⟩ := this
      refine ⟨e ⟨z, hz⟩, ?_⟩
      show x ∈ A (e.symm (e ⟨z, hz⟩)).1
      rw [Equiv.symm_apply_apply]
      exact hxz
    · intro i x hx
      exact Set.mem_iInter.mp (hWO hx) i

  have hgen2 : ∀ V : X.Opens, IsAffineOpen V → ∃ (n : ℕ) (a : Fin (n + 1) → Γ(X, V)), a 0 = 1 ∧
      ∀ t : Γ(X, V), t ∈ Subring.closure (Set.range ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp
        (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) ∪ Set.range a) := by
    intro V hV
    have h1 := HasRingHomProperty.appLE @LocallyOfFiniteType h inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ le_top
    have h2 : ((X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp h.appTop.hom).FiniteType := h1
    have h3 : (Scheme.ΓSpecIso (.of B)).inv.hom.FiniteType := by
      apply RingHom.FiniteType.of_surjective
      intro x
      exact ⟨(Scheme.ΓSpecIso (.of B)).hom.hom x, by simp⟩
    have hft := RingHom.FiniteType.comp h2 h3
    set ρ := (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp
      (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom) with hρ
    letI := ρ.toAlgebra
    obtain ⟨s, hs⟩ := (hft : Algebra.FiniteType B Γ(X, V)).out
    let a : Fin (s.card + 1) → Γ(X, V) := Fin.cons 1 (fun k => (s.equivFin.symm k).1)
    refine ⟨s.card, a, rfl, fun t => ?_⟩
    have ht : t ∈ (Algebra.adjoin B (s : Set Γ(X, V))).toSubring := by
      rw [hs]; trivial
    rw [Algebra.adjoin_eq_ring_closure] at ht
    refine Subring.closure_mono ?_ ht
    rintro x (hx | hx)
    · exact Or.inl hx
    · refine Or.inr ⟨(s.equivFin ⟨x, hx⟩).succ, ?_⟩
      simp [a]
  have hgen := fun i => hgen2 (U i) (hU i)
  choose n a ha0 hagen using hgen
  have hcard : 0 < Fintype.card (∀ i, Fin (n i + 1)) := Fintype.card_pos
  obtain ⟨N, hN⟩ : ∃ N : ℕ, Fintype.card (∀ i, Fin (n i + 1)) = N + 1 :=
    ⟨_, (Nat.succ_pred_eq_of_pos hcard).symm⟩
  let κ : Fin (N + 1) ≃ (∀ i, Fin (n i + 1)) := (Fintype.equivFinOfCardEq hN).symm
  obtain ⟨D, d, hDred, hDc, hd, hrange⟩ := wc_chow_reduced_trace X T W hW
  haveI := hDred
  haveI := hDc
  haveI := hd
  set ψ : D ⟶ X := d ≫ W.ι with hψdef
  have hψW : ∀ x : D, ψ x ∈ (W : Set X) ∩ T := by
    intro x
    rw [← hrange]
    exact ⟨x, rfl⟩
  have hψU : ∀ i, ψ ⁻¹ᵁ U i = ⊤ := by
    intro i
    apply eq_top_iff.mpr
    intro x _
    exact hWU i (hψW x).1
  let s : Fin (N + 1) → Γ(D, ⊤) := fun K => ∏ i, ψ.appLE (U i) ⊤ (hψU i).ge (a i (κ K i))
  have hs1 : s (κ.symm 0) = 1 := by
    simp only [s, Equiv.apply_symm_apply, Pi.zero_apply, ha0, map_one, Finset.prod_const_one]
  have hspan : Ideal.span (Set.range s) = ⊤ := by
    rw [Ideal.eq_top_iff_one, ← hs1]
    exact Ideal.subset_span ⟨_, rfl⟩
  obtain ⟨e, hcov, hbo, huniv⟩ := wc_pm_segre_coords.{u} N
  obtain ⟨φ, hφ, hrel⟩ := huniv D s hspan

  obtain ⟨hPproper, hfstproper⟩ : IsProper (Limits.terminal.from (wcPm.{u} N)) ∧
      ∀ (Y : Scheme.{u}), IsProper (Limits.prod.fst : Y ⨯ wcPm.{u} N ⟶ Y) := by
    letI 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ)
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hP0 : IsProper (Proj.toSpecZero 𝒜) := by
      letI : IsScalarTower (ULift.{u} ℤ) (𝒜 0) (MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) :=
        IsScalarTower.of_algebraMap_eq (R := ULift.{u} ℤ) (S := 𝒜 0)
          (A := MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) (fun r => rfl)
      haveI : Algebra.FiniteType (𝒜 0) (MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)) :=
        Algebra.FiniteType.of_restrictScalars_finiteType (ULift.{u} ℤ) _ _
      infer_instance
    have hsurj : Function.Surjective (algebraMap (ULift.{u} ℤ) (𝒜 0)) := by
      intro x
      have hx : (x : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)).IsHomogeneous 0 :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).mp x.2
      refine ⟨(x : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)).coeff 0, ?_⟩
      apply Subtype.ext
      have h0 := hx.totalDegree_le
      have h1 : (x : MvPolynomial (Fin (N + 1)) (ULift.{u} ℤ)).totalDegree = 0 := by omega
      rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h1
      rw [h1]
      simp
    let f : Spec (.of (𝒜 0)) ⟶ Spec (.of (ULift.{u} ℤ)) :=
      Spec.map (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ) (𝒜 0)))
    have hf : IsFinite f := by
      rw [IsFinite.SpecMap_iff]
      exact RingHom.Finite.of_surjective _ hsurj
    have hT : IsIso (Limits.terminal.from (Spec (.of (ULift.{u} ℤ)))) := by
      have e : Limits.terminal.from (Spec (.of (ULift.{u} ℤ))) =
          (specULiftZIsTerminal.uniqueUpToIso Limits.terminalIsTerminal).hom :=
        Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    have htop : IsProper (Limits.terminal.from (wcPm.{u} N)) := by
      have e : Limits.terminal.from (wcPm.{u} N) =
          Proj.toSpecZero 𝒜 ≫ f ≫ Limits.terminal.from (Spec (.of (ULift.{u} ℤ))) :=
        Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    refine ⟨htop, fun Y => ?_⟩
    have hpb : IsPullback (Limits.prod.snd : Y ⨯ wcPm.{u} N ⟶ _) Limits.prod.fst
        (Limits.terminal.from (wcPm.{u} N)) (Limits.terminal.from Y) :=
      (IsPullback.of_isLimit_binaryFan_of_isTerminal (Limits.prodIsProd Y (wcPm.{u} N))
        Limits.terminalIsTerminal).flip
    exact MorphismProperty.of_isPullback (P := @IsProper) hpb htop
  haveI := hPproper
  have hsepP : IsSeparated (Limits.terminal.from (wcPm.{u} N)) := inferInstance
  obtain ⟨Z, p, g, δ, hZred, hΛ, hδ, hδp, hδg⟩ :=
    wc_graph_closure_reduced X (wcPm.{u} N) D ψ φ hsepX hsepP hlift
  haveI := hZred
  haveI := hΛ
  have hrangep : Set.range p ⊆ (T : Set X) := by
    have hcl : IsClosed (p ⁻¹' (T : Set X)) := T.isClosed.preimage p.continuous
    have hsub : Set.range δ ⊆ p ⁻¹' (T : Set X) := by
      rintro _ ⟨x, rfl⟩
      show p (δ x) ∈ (T : Set X)
      rw [← Scheme.Hom.comp_apply, hδp]
      exact (hψW x).2
    have huniv' : p ⁻¹' (T : Set X) = Set.univ := by
      apply Set.eq_univ_of_univ_subset
      rw [← hδ.closure_range]
      exact closure_minimal hsub hcl
    rintro _ ⟨z, rfl⟩
    have hz : z ∈ p ⁻¹' (T : Set X) := huniv' ▸ Set.mem_univ z
    exact hz
  have hp : IsProper p := by
    haveI := hfstproper X
    have h1 : IsProper (Limits.prod.lift p g ≫ Limits.prod.fst) := inferInstance
    rwa [Limits.prod.lift_fst] at h1
  haveI := hp
  have hpU : ∀ z : Z, ∃ i, p z ∈ U i := fun z => hcovT (p z) (hrangep ⟨z, rfl⟩)
  have hsepq : IsSeparated (p ≫ h) := inferInstance
  have hclosed : IsClosed (Set.range (Limits.prod.lift (p ≫ h) g)) := by
    haveI := hfstproper (Spec (.of B))
    haveI : IsProper (Limits.prod.lift (p ≫ h) g ≫ Limits.prod.fst) := by
      rw [Limits.prod.lift_fst]
      infer_instance
    haveI : IsProper (Limits.prod.lift (p ≫ h) g) := IsProper.of_comp _ Limits.prod.fst
    have hm := (Limits.prod.lift (p ≫ h) g).isClosedMap
    simpa using hm _ isClosed_univ
  have hcover := wc_chow_charts_cover X N e r U n a κ Z D p g δ ψ φ s hψU hdenseinj
    hδp hδg hδ ha0 (fun K => rfl) hφ hrel hcov hbo hpU
  have hCI : IsClosedImmersion (Limits.prod.lift (p ≫ h) g) := by
    refine wc_closed_immersion_of_charts B Z (p ≫ h) N g {J | ∃ i, κ J i = 0}
      wc_prod_affine_opens_gen hclosed ?_ ?_
    · intro z
      obtain ⟨J, hJ, hz⟩ := hcover z
      exact ⟨J, hJ, hz⟩
    · rintro J ⟨i, hi⟩
      obtain ⟨hVaff, hVgen⟩ := wc_chow_chart_generation B X h N e r U n a κ Z D p g δ ψ φ s hψU
        wc_prod_affine_opens_gen hdenseinj hδp hδg hδ ha0 (fun K => rfl) hφ hrel hU
        hagen hΛ i J hi
      have hle := wc_chow_chart_contained B X Z D h N p g δ (U i) J wc_prod_affine_opens_gen hsepq
        hδ (by rw [hδp]; exact hψU i) hVaff hVgen
      exact ⟨p ⁻¹ᵁ U i ⊓ g ⁻¹ᵁ wcPmChart.{u} N J, inf_le_right, le_inf hle le_rfl, hVaff, hVgen⟩

  have hpW : IsClosedImmersion (p ∣_ W) := by
    let V := p ⁻¹ᵁ W
    haveI : IsReduced (V : Scheme.{u}) := isReduced_of_isOpenImmersion V.ι
    have hrδ : Set.range δ ⊆ Set.range V.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      show p (δ x) ∈ W
      rw [← Scheme.Hom.comp_apply, hδp, Scheme.Hom.comp_apply]
      exact (d x).2
    let δV : D ⟶ (V : Scheme.{u}) := IsOpenImmersion.lift V.ι δ hrδ
    have hδV : δV ≫ V.ι = δ := IsOpenImmersion.lift_fac _ _ _
    let ρ : (V : Scheme.{u}) ⟶ (W : Scheme.{u}) ⨯ wcPm.{u} N := Limits.prod.lift (p ∣_ W) (V.ι ≫ g)
    have hρsep : IsSeparated ρ := by
      have e : ρ ≫ Limits.prod.map W.ι (𝟙 (wcPm.{u} N)) = V.ι ≫ Limits.prod.lift p g := by
        apply Limits.prod.hom_ext
        · simp [ρ, morphismRestrict_ι, V]
        · simp [ρ]
      haveI : IsSeparated (ρ ≫ Limits.prod.map W.ι (𝟙 (wcPm.{u} N))) := by rw [e]; infer_instance
      exact IsSeparated.of_comp ρ (Limits.prod.map W.ι (𝟙 (wcPm.{u} N)))
    have hfstsep : IsSeparated (Limits.prod.fst : (W : Scheme.{u}) ⨯ wcPm.{u} N ⟶ W) := by
      have hpb : IsPullback (Limits.prod.snd : (W : Scheme.{u}) ⨯ wcPm.{u} N ⟶ _) Limits.prod.fst
          (Limits.terminal.from (wcPm.{u} N)) (Limits.terminal.from (W : Scheme.{u})) :=
        (IsPullback.of_isLimit_binaryFan_of_isTerminal (Limits.prodIsProd (W : Scheme.{u}) (wcPm.{u} N))
          Limits.terminalIsTerminal).flip
      exact MorphismProperty.of_isPullback (P := @IsSeparated) hpb hsepP
    let γ : D ⟶ (W : Scheme.{u}) ⨯ wcPm.{u} N := Limits.prod.lift d (δ ≫ g)
    haveI hγ : IsClosedImmersion γ := by
      haveI : IsClosedImmersion (γ ≫ Limits.prod.fst) := by
        rw [Limits.prod.lift_fst]; infer_instance
      exact IsClosedImmersion.of_comp γ Limits.prod.fst
    have hd1 : δV ≫ p ∣_ W = d := by
      rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hδV, hδp]
    have hδVρ : δV ≫ ρ = γ := by
      apply Limits.prod.hom_ext
      · simp [ρ, γ, hd1]
      · simp [ρ, γ, ← Category.assoc, hδV]
    haveI : IsClosedImmersion (δV ≫ ρ) := by rw [hδVρ]; exact hγ
    haveI hδVci : IsClosedImmersion δV := IsClosedImmersion.of_comp δV ρ
    have hdenseV : DenseRange δV := by
      rw [DenseRange, dense_iff_inter_open]
      intro O hO hOne
      have hOZ : IsOpen (V.ι '' O) := V.ι.isOpenEmbedding.isOpenMap O hO
      obtain ⟨_, ⟨y, hyO, rfl⟩, ⟨x, hx⟩⟩ := hδ.inter_open_nonempty _ hOZ (hOne.image _)
      refine ⟨δV x, ?_, ⟨x, rfl⟩⟩
      have : V.ι (δV x) = V.ι y := by rw [← Scheme.Hom.comp_apply, hδV]; exact hx
      rw [V.ι.isOpenEmbedding.injective this]
      exact hyO
    haveI : Surjective δV := by
      constructor
      have hcl : IsClosed (Set.range δV) := δV.isClosedEmbedding.isClosed_range
      have h := hdenseV.closure_range
      rw [hcl.closure_eq] at h
      exact Set.range_eq_univ.mp h
    haveI : IsIso δV := isIso_of_isClosedImmersion_of_surjective δV
    have e : p ∣_ W = inv δV ≫ d := by rw [← hd1, IsIso.inv_hom_id_assoc]
    rw [e]
    infer_instance
  have hpts : ∀ x ∈ W, x ∈ T → x ∈ Set.range p := by
    intro x hxW hxT
    have hx : x ∈ Set.range ψ := by
      rw [hrange]
      exact ⟨hxW, hxT⟩
    obtain ⟨y, rfl⟩ := hx
    exact ⟨δ y, by rw [← Scheme.Hom.comp_apply, hδp]⟩

  have hsurj : Function.Surjective (p.app W) := by
    haveI : IsAffine (W : Scheme.{u}) := hW
    have h0 := (isClosedImmersion_iff_isAffineHom.mp hpW).2 ⊤ (isAffineOpen_top _)
    have hgenS : ∀ (V : X.Opens) (V' : Z.Opens) (e : V' = p ⁻¹ᵁ V),
        Function.Surjective (p.app V ≫ Z.presheaf.map (eqToHom e).op) →
        Function.Surjective (p.app V) := by
      intro V V' e hs
      subst e
      simpa using hs
    have h2 := hgenS _ _ _ (by rw [← morphismRestrict_app]; exact h0)
    have hsub : ∀ (V : X.Opens) (e : V = W), Function.Surjective (p.app V) →
        Function.Surjective (p.app W) := by
      intro V e hs
      subst e
      exact hs
    exact hsub _ (Scheme.Opens.ι_image_top W) h2
  have hker : ∀ a : Γ(X, W), p.app W a = 0 ↔ ∀ x ∈ W, x ∈ T → x ∉ X.basicOpen a := by
    intro a
    constructor
    · intro ha x hxU hxT hxb
      obtain ⟨z, rfl⟩ := hpts x hxU hxT
      have hz : z ∈ p ⁻¹ᵁ X.basicOpen a := hxb
      rw [Scheme.preimage_basicOpen, ha, Scheme.basicOpen_zero] at hz
      exact hz
    · intro H
      apply eq_zero_of_basicOpen_eq_bot
      rw [← Scheme.preimage_basicOpen]
      apply eq_bot_iff.mpr
      intro z hz
      exact (H (p z) (X.basicOpen_le a hz) (hrangep ⟨z, rfl⟩) hz).elim
  exact ⟨Z, p, N, g, hp, hrangep, hCI, hΛ, W, hW, hWT, hsurj, hker⟩

theorem wc_pm_chart_cover : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of A)) (m : ℕ) (g : Y ⟶ wcPm.{u} m), IsClosedImmersion (Limits.prod.lift hY g) → (∀ k, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k)) ∧ ∀ y : Y, ∃ k, y ∈ g ⁻¹ᵁ wcPmChart m k :=
by
  intro A _ Y hY m g hι
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
    MvPolynomial.gradedAlgebra

  have s1 : ∀ p : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ), MvPolynomial.homogeneousComponent 0 p = 0 →
      p ∈ Ideal.span (Set.range (MvPolynomial.X : Fin (m + 1) → MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))) := by
    intro p hp
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m' hm
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hp
    have hm0 : m' ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) hp
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ i, hi⟩

  have hsup := Proj.iSup_basicOpen_eq_top (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
    (MvPolynomial.X : Fin (m + 1) → MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))
    (fun p hp => s1 p (((MvPolynomial.decomposition.decompose'_apply p 0).symm.trans
      ((HomogeneousIdeal.mem_irrelevant_iff _ p).mp hp))))

  have hD : ∀ k : Fin (m + 1), IsAffineOpen (wcPmChart.{u} m k) := fun k =>
    Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
      (MvPolynomial.X k) (m := 1)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)) Nat.one_pos

  haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of A) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasBinaryProduct' (Spec (.of A)) (wcPm.{u} m))
      (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of A))))
  haveI hcomp : IsAffineHom (Limits.prod.lift hY g ≫ Limits.prod.snd) := inferInstance
  have hg : IsAffineHom g := by
    rw [Limits.prod.lift_snd] at hcomp
    exact hcomp
  refine ⟨fun k => (hD k).preimage g, fun y => ?_⟩
  have hy : g y ∈ (⨆ k, wcPmChart.{u} m k) := by
    have e : (⨆ k, wcPmChart.{u} m k) = ⊤ := hsup
    rw [e]
    trivial
  obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
  exact ⟨k, hk⟩

theorem wc_pm_chart_coords : ∀ m : ℕ, ∃ e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k), (∀ k, e k k = 1) ∧ (∀ k l, wcPmChart m k ⊓ wcPmChart m l = (wcPm.{u} m).basicOpen (e k l)) ∧ (∀ k l j, (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k)).op (e k j) = (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k)).op (e k l) * (wcPm.{u} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m l)).op (e l j)) ∧ (∀ k (s : Γ(wcPm.{u} m, wcPmChart m k)), ∃ p : MvPolynomial (Fin (m + 1)) ℤ, MvPolynomial.eval₂ (Int.castRingHom _) (e k) p = s) :=
by
  intro m
  letI : GradedRing (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
    MvPolynomial.gradedAlgebra
  have hX : ∀ k : Fin (m + 1), (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ)) ∈
      MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ) 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)

  have GEN : ∀ (k : Fin (m + 1)) (n : ℕ) (F : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))
      (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ) (n • 1)),
      MvPolynomial.eval₂ (Int.castRingHom (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) (MvPolynomial.X k)))
        (fun l => HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) (hX k) 1
          (MvPolynomial.X l) (hX l))
        (MvPolynomial.map (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).toRingHom F) =
      HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) (hX k) n F hF := by
    intro k n F hF
    have hFh : F.IsHomogeneous n := by
      have := (MvPolynomial.mem_homogeneousSubmodule (n • 1) F).mp hF
      simpa using this
    have scale : ∀ {L : Type u} [CommRing L] (χ : ULift.{u} ℤ →+* L) (g : Fin (m + 1) → L) (t : L),
        MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ n * MvPolynomial.eval₂ χ g F := by
      intro L _ χ g t
      rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      have hdeg : ∑ i ∈ d.support, d i = n := by
        by_contra hne
        exact (MvPolynomial.mem_support_iff.mp hd) (hFh.coeff_eq_zero hne)
      simp_rw [mul_pow]
      rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
      ring
    have hall : ∀ {L : Type u} [CommRing L] (φ ψ : ULift.{u} ℤ →+* L), φ = ψ := by
      intro L _ φ ψ
      have h := RingHom.ext_int (φ.comp (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).symm.toRingHom)
        (ψ.comp (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).symm.toRingHom)
      exact RingHom.ext fun x => RingHom.congr_fun h x.down
    apply HomogeneousLocalization.val_injective
    rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
      MvPolynomial.eval₂_comp_left, MvPolynomial.eval₂_map, HomogeneousLocalization.algebraMap_apply,
      HomogeneousLocalization.Away.val_mk]
    calc _ = MvPolynomial.eval₂
          ((algebraMap (MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))
            (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))))).comp
            MvPolynomial.C)
          (fun l => algebraMap (MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))
            (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))))
            (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
              Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ)))) F := by
          congr 1
          · exact hall _ _
          · funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
      _ = _ := by
          rw [scale]
          have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))
            (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ)))))
            MvPolynomial.C MvPolynomial.X F
          rw [MvPolynomial.eval₂_eta] at h2
          rw [show (fun l => algebraMap (MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))))
              (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ))))) ∘
              MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
            ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
            Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow, ← pow_mul]

  have L1 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1), Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g = (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
    intro σ A _ _ _ 𝒜 _ f g hf hg
    have ha : HomogeneousLocalization.Away.isLocalizationElem hf hg =
        HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg := by
      apply HomogeneousLocalization.val_injective
      simp [HomogeneousLocalization.Away.val_mk]
    have hb : (Proj.basicOpen 𝒜 f).ι ⁻¹ᵁ Proj.basicOpen 𝒜 g =
        (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) := by
      have h1 := Proj.awayι_preimage_basicOpen 𝒜 hf Nat.one_pos hg Nat.one_pos
      rw [← Proj.basicOpenIsoSpec_inv_ι, Scheme.Hom.comp_preimage, ha] at h1
      rw [← h1, ← Scheme.Hom.comp_preimage, Iso.hom_inv_id, Scheme.Hom.id_preimage]
    have hd : (Proj 𝒜).basicOpen (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) =
        (Proj.basicOpen 𝒜 f).ι ''ᵁ ((Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) := by
      have hsp := basicOpen_eq_of_affine (R := CommRingCat.of (HomogeneousLocalization.Away 𝒜 f))
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)
      have h3 : (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg) =
          (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ
          (Spec _).basicOpen ((Scheme.ΓSpecIso _).inv (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) :=
        congrArg (fun V => (Proj.basicOpenIsoSpec 𝒜 f hf Nat.one_pos).hom ⁻¹ᵁ V) hsp.symm
      rw [h3, ← Scheme.Opens.ι_image_basicOpen_topIso_inv, Scheme.preimage_basicOpen_top]
      congr 2
      rw [Proj.basicOpenIsoSpec_hom]
      change _ = ConcreteCategory.hom (Scheme.Hom.app (Proj.basicOpenToSpec 𝒜 f) ⊤) _
      rw [Proj.basicOpenToSpec_app_top]
      exact congrArg (fun y => ConcreteCategory.hom (Proj.basicOpen 𝒜 f).topIso.inv
        (ConcreteCategory.hom (Proj.awayToSection 𝒜 f) y))
        (Iso.inv_hom_id_apply (Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away 𝒜 f)))
          (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)).symm
    rw [hd, ← hb, Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]

  have L2 : ∀ {σ : Type u} {A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (f g h : A) (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1) (hh : h ∈ 𝒜 1), (Proj 𝒜).presheaf.map (homOfLE (inf_le_left : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) = (Proj 𝒜).presheaf.map (homOfLE (inf_le_left : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 f)).op (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) * (Proj 𝒜).presheaf.map (homOfLE (inf_le_right : Proj.basicOpen 𝒜 f ⊓ Proj.basicOpen 𝒜 g ≤ Proj.basicOpen 𝒜 g)).op (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
    intro σ A _ _ _ 𝒜 _ f g h hf hg hh
    have key : ∀ (W : (Proj 𝒜).Opens) (_ : W = Proj.basicOpen 𝒜 (f * g))
        (h₁ : W ≤ Proj.basicOpen 𝒜 f) (h₂ : W ≤ Proj.basicOpen 𝒜 g),
        (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 h hh)) =
          (Proj 𝒜).presheaf.map (homOfLE h₁).op
            (Proj.awayToSection 𝒜 f (HomogeneousLocalization.Away.mk 𝒜 hf 1 g hg)) *
          (Proj 𝒜).presheaf.map (homOfLE h₂).op
            (Proj.awayToSection 𝒜 g (HomogeneousLocalization.Away.mk 𝒜 hg 1 h hh)) := by
      rintro W rfl h₁ h₂
      have e1 : ∀ a, (Proj 𝒜).presheaf.map (homOfLE h₁).op (Proj.awayToSection 𝒜 f a) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hg rfl a) := by
        intro a
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 hg (rfl : f * g = f * g)) a
        exact this.symm
      have e2 : ∀ b, (Proj 𝒜).presheaf.map (homOfLE h₂).op (Proj.awayToSection 𝒜 g b) =
          Proj.awayToSection 𝒜 (f * g) (HomogeneousLocalization.awayMap 𝒜 hf (mul_comm f g) b) := by
        intro b
        have := ConcreteCategory.congr_hom
          (Proj.awayMap_awayToSection 𝒜 (f := g) hf (mul_comm f g)) b
        exact this.symm
      rw [e1, e1, e2, ← map_mul]
      congr 1
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      simp only [Submonoid.coe_mul, pow_one, OneMemClass.coe_one, one_mul]
      ring
    exact key _ (Proj.basicOpen_mul 𝒜 f g).symm _ _

  refine ⟨fun k l => Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
    (MvPolynomial.X k) (HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) (hX k) 1
      (MvPolynomial.X l) (hX l)), ?_, ?_, ?_, ?_⟩
  · intro k
    have h1 : HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) (hX k) 1
        (MvPolynomial.X k) (hX k) = 1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
        ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      exact ⟨1, by simp⟩
    show Proj.awayToSection _ _ _ = 1
    rw [h1, map_one]
  · intro k l
    exact L1 _ (MvPolynomial.X k) (MvPolynomial.X l) (hX k) (hX l)
  · intro k l j
    exact L2 _ (MvPolynomial.X k) (MvPolynomial.X l) (MvPolynomial.X j) (hX k) (hX l) (hX j)
  · intro k s
    have hs : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
        (MvPolynomial.X k) ((Proj.basicOpenIsoAway _ (MvPolynomial.X k) (hX k) Nat.one_pos).inv s) = s := by
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ (MvPolynomial.X k) (hX k) Nat.one_pos) s
      rwa [Proj.basicOpenIsoAway_hom] at this
    obtain ⟨n, F, hF, hmk⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) (hX k)
      ((Proj.basicOpenIsoAway _ (MvPolynomial.X k) (hX k) Nat.one_pos).inv s)
    refine ⟨MvPolynomial.map (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).toRingHom F, ?_⟩
    rw [← hs, ← hmk, ← GEN k n F hF, MvPolynomial.eval₂_comp_left]
    congr 1
    exact RingHom.ext_int _ _

theorem wc_pm_chart_pullback_generation : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of A)) (m : ℕ) (g : Y ⟶ wcPm.{u} m), IsClosedImmersion (Limits.prod.lift hY g) → ∀ (k : Fin (m + 1)) (e : Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k)), (∀ s : Γ(wcPm.{u} m, wcPmChart m k), ∃ p : MvPolynomial (Fin (m + 1)) ℤ, MvPolynomial.eval₂ (Int.castRingHom _) e p = s) → ∀ s : Γ(Y, g ⁻¹ᵁ wcPmChart m k), ∃ p : MvPolynomial (Fin (m + 1)) A, MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ wcPmChart m k ≤ ⊤)).op).hom.comp (hY.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (fun l => g.app (wcPmChart m k) (e l)) p = s :=
by

  have s1 : ∀ (R A B P : CommRingCat.{u}) (f : R ⟶ A) (g : R ⟶ B) (inl : A ⟶ P) (inr : B ⟶ P),
      IsPushout f g inl inr → ∀ x : P, x ∈ Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) := by
    intro R A B P f g inl inr hP x
    let S := Subring.closure (Set.range inl.hom ∪ Set.range inr.hom)
    let inl' : A ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inl.hom S
      (fun a => Subring.subset_closure (Or.inl ⟨a, rfl⟩)))
    let inr' : B ⟶ CommRingCat.of S := CommRingCat.ofHom (RingHom.codRestrict inr.hom S
      (fun b => Subring.subset_closure (Or.inr ⟨b, rfl⟩)))
    have hw : f ≫ inl' = g ≫ inr' := by
      ext y
      exact ConcreteCategory.congr_hom hP.w y
    let d := hP.desc inl' inr' hw
    have hε : d ≫ CommRingCat.ofHom S.subtype = 𝟙 P := by
      apply hP.hom_ext
      · rw [Category.comp_id, ← Category.assoc, hP.inl_desc]
        ext a
        rfl
      · rw [Category.comp_id, ← Category.assoc, hP.inr_desc]
        ext a
        rfl
    have hx : (S.subtype (d x)) = x := by
      have := ConcreteCategory.congr_hom hε x
      exact this
    rw [← hx]
    exact (d x).property

  have s2 : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (D : X.Opens), IsAffineOpen D →
      IsPushout ((Limits.terminal.from X).appTop ≫ X.presheaf.map (homOfLE (le_top : D ≤ ⊤)).op)
        ((Limits.terminal.from (Spec (.of A))).appTop ≫ (Scheme.ΓSpecIso (.of A)).hom)
        ((Limits.prod.snd : Spec (.of A) ⨯ X ⟶ X).app D)
        ((Scheme.ΓSpecIso (.of A)).inv ≫ (Limits.prod.fst : Spec (.of A) ⨯ X ⟶ Spec (.of A)).appTop ≫
          (Spec (.of A) ⨯ X).presheaf.map
            (homOfLE (le_top : (Limits.prod.snd : Spec (.of A) ⨯ X ⟶ X) ⁻¹ᵁ D ≤ ⊤)).op) := by
    intro A _ X D hD
    set P := Spec (.of A) ⨯ X
    set q : P ⟶ X := Limits.prod.snd
    set r : P ⟶ Spec (.of A) := Limits.prod.fst
    have : IsAffine D := hD
    have Sq : IsPullback (q ∣_ D) ((q ⁻¹ᵁ D).ι ≫ r) (D.ι ≫ Limits.terminal.from X)
        (Limits.terminal.from (Spec (.of A))) :=
      IsPullback.paste_vert (isPullback_morphismRestrict q D)
        (IsPullback.of_hasBinaryProduct' (Spec (.of A)) X).flip
    have Po := isPushout_appTop_of_isPullback Sq
    refine IsPushout.of_iso Po (Iso.refl _) D.topIso (Scheme.ΓSpecIso (.of A)) (q ⁻¹ᵁ D).topIso
      ?_ ?_ ?_ ?_
    · rw [Iso.refl_hom, Category.id_comp, Scheme.Hom.comp_appTop, Category.assoc]
      congr 1
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      exact (X.presheaf.map_comp _ _).symm
    · rw [Iso.refl_hom, Category.id_comp]
    · rw [morphismRestrict_appTop, Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
      show (q.app (D.ι ''ᵁ ⊤) ≫ P.presheaf.map (homOfLE (by rw [Scheme.Opens.ι_image_top, Scheme.Opens.ι_image_top]) : (q ⁻¹ᵁ D).ι ''ᵁ ⊤ ⟶ q ⁻¹ᵁ (D.ι ''ᵁ ⊤)).op) ≫ P.presheaf.map (homOfLE (by rw [Scheme.Opens.ι_image_top]) : q ⁻¹ᵁ D ⟶ (q ⁻¹ᵁ D).ι ''ᵁ ⊤).op = X.presheaf.map (homOfLE (by rw [Scheme.Opens.ι_image_top]) : D ⟶ D.ι ''ᵁ ⊤).op ≫ q.app D
      rw [Category.assoc, ← Functor.map_comp, Scheme.Hom.naturality]
      rfl
    · rw [Iso.hom_inv_id_assoc, Scheme.Hom.comp_appTop, Category.assoc]
      congr 1
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      exact (P.presheaf.map_comp _ _).symm

  have s6 : ∀ (X Y T : Scheme.{u}) (ι : X ⟶ Y) (q : Y ⟶ T) (V : Y.Opens) (v : Γ(T, ⊤)),
      X.presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ V ≤ ⊤)).op ((ι ≫ q).appTop v) =
        ι.app V (Y.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (q.appTop v)) := by
    intro X Y T ι q V v
    have h := Scheme.Hom.naturality ι (homOfLE (le_top : V ≤ ⊤)).op
    have h2 := congrArg (fun φ => (CommRingCat.Hom.hom φ) (q.appTop v)) h
    exact h2.symm

  have s3 : ∀ (A : Type u) [CommRing A] (Y P X : Scheme.{u}) (ι : Y ⟶ P) (q : P ⟶ X)
      (r : P ⟶ Spec (.of A)) (g : Y ⟶ X) (hY : Y ⟶ Spec (.of A)) (D : X.Opens),
      IsClosedImmersion ι → ι ≫ q = g → ι ≫ r = hY → IsAffineOpen (q ⁻¹ᵁ D) →
      (∀ t : Γ(P, q ⁻¹ᵁ D), t ∈ Subring.closure (Set.range (q.app D).hom ∪
        Set.range ((P.presheaf.map (homOfLE (le_top : q ⁻¹ᵁ D ≤ ⊤)).op).hom.comp
          (r.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)))) →
      ∀ s : Γ(Y, g ⁻¹ᵁ D), s ∈ Subring.closure (Set.range (g.app D).hom ∪
        Set.range ((Y.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ D ≤ ⊤)).op).hom.comp
          (hY.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom))) := by
    intro A _ Y P X ι q r g hY D hι hq hr hW hgen s
    subst hq
    subst hr
    haveI := hι
    obtain ⟨t, ht⟩ := Scheme.Hom.app_surjective ι (q ⁻¹ᵁ D) hW s
    have hle := (Subring.closure_le (t := Subring.comap (ι.app (q ⁻¹ᵁ D)).hom
      (Subring.closure (Set.range ((ι ≫ q).app D).hom ∪
        Set.range ((Y.presheaf.map (homOfLE (le_top : (ι ≫ q) ⁻¹ᵁ D ≤ ⊤)).op).hom.comp
          ((ι ≫ r).appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)))))).mpr (by
      rintro _ (⟨y, rfl⟩ | ⟨a, rfl⟩)
      · refine Subring.mem_comap.mpr (Subring.subset_closure (Or.inl ⟨y, ?_⟩))
        rw [Scheme.Hom.comp_app]
        rfl
      · refine Subring.mem_comap.mpr (Subring.subset_closure (Or.inr ⟨a, ?_⟩))
        exact s6 Y P (Spec (.of A)) ι r (q ⁻¹ᵁ D) _) (hgen t)
    rw [← ht]
    exact Subring.mem_comap.mp hle

  have s4 : ∀ (A B R : Type u) [CommRing A] [CommRing B] [CommRing R] (n : ℕ) (σ : A →+* R)
      (φ : B →+* R) (e : Fin n → B),
      (∀ b : B, ∃ q : MvPolynomial (Fin n) ℤ, MvPolynomial.eval₂ (Int.castRingHom B) e q = b) →
      ∀ s ∈ Subring.closure (Set.range φ ∪ Set.range σ),
        ∃ p : MvPolynomial (Fin n) A, MvPolynomial.eval₂ σ (fun l => φ (e l)) p = s := by
    intro A B R _ _ _ n σ φ e he s hs
    have hle : Subring.closure (Set.range φ ∪ Set.range σ) ≤
        (MvPolynomial.eval₂Hom σ (fun l => φ (e l))).range := by
      rw [Subring.closure_le]
      rintro _ (⟨b, rfl⟩ | ⟨a, rfl⟩)
      · obtain ⟨q, rfl⟩ := he b
        refine RingHom.mem_range.mpr ⟨MvPolynomial.map (Int.castRingHom A) q, ?_⟩
        have hz : σ.comp (Int.castRingHom A) = φ.comp (Int.castRingHom B) := RingHom.ext_int _ _
        rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_map, hz]
        exact (MvPolynomial.eval₂_comp_left φ (Int.castRingHom B) e q).symm
      · exact RingHom.mem_range.mpr ⟨MvPolynomial.C a, by
          rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C]⟩
    obtain ⟨p, hp⟩ := RingHom.mem_range.mp (hle hs)
    exact ⟨p, hp⟩

  intro A _ Y hY m g hι k e he s
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
    MvPolynomial.gradedAlgebra
  have hD : IsAffineOpen (wcPmChart.{u} m k) :=
    Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
      (MvPolynomial.X k) (m := 1)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)) Nat.one_pos
  haveI hsnd : IsAffineHom (Limits.prod.snd : Spec (.of A) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasBinaryProduct' (Spec (.of A)) (wcPm.{u} m))
      (inferInstance : IsAffineHom (Limits.terminal.from (Spec (.of A))))
  have hW : IsAffineOpen ((Limits.prod.snd : Spec (.of A) ⨯ wcPm.{u} m ⟶ wcPm.{u} m) ⁻¹ᵁ
      wcPmChart.{u} m k) := hD.preimage _
  have hgenP := fun t => s1 _ _ _ _ _ _ _ _ (s2 A (wcPm.{u} m) (wcPmChart.{u} m k) hD) t
  have hgenY := s3 A Y (Spec (.of A) ⨯ wcPm.{u} m) (wcPm.{u} m) (Limits.prod.lift hY g)
    Limits.prod.snd Limits.prod.fst g hY (wcPmChart.{u} m k) hι (Limits.prod.lift_snd hY g)
    (Limits.prod.lift_fst hY g) hW hgenP
  exact s4 A Γ(wcPm.{u} m, wcPmChart m k) Γ(Y, g ⁻¹ᵁ wcPmChart m k) (m + 1) _
    (g.app (wcPmChart m k)).hom e he s (hgenY s)

theorem wc_pm_chart_sys : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of A)) (m : ℕ) (g : Y ⟶ wcPm.{u} m), (∀ k, IsAffineOpen (g ⁻¹ᵁ wcPmChart m k)) → ∀ e : ∀ k : Fin (m + 1), Fin (m + 1) → Γ(wcPm.{u} m, wcPmChart m k), (∀ k, e k k = 1) → (∀ k l, wcPmChart m k ⊓ wcPmChart m l = (wcPm.{u} m).basicOpen (e k l)) → (∀ k l j, (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k)).op (e k j) = (wcPm.{u} m).presheaf.map (homOfLE (inf_le_left : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m k)).op (e k l) * (wcPm.{u} m).presheaf.map (homOfLE (inf_le_right : wcPmChart m k ⊓ wcPmChart m l ≤ wcPmChart m l)).op (e l j)) → (∀ k (s : Γ(Y, g ⁻¹ᵁ wcPmChart m k)), ∃ p : MvPolynomial (Fin (m + 1)) A, MvPolynomial.eval₂ ((Y.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ wcPmChart m k ≤ ⊤)).op).hom.comp (hY.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (fun l => g.app (wcPmChart m k) (e k l)) p = s) → wcChartSys A (m + 1) (fun i => Γ(Y, g ⁻¹ᵁ wcPmChart m i)) (fun i j => Γ(Y, g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j)) (fun i j l => Γ(Y, g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l)) (fun i => (Y.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ wcPmChart m i ≤ ⊤)).op).hom.comp (hY.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (fun i j => (Y.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ≤ ⊤)).op).hom.comp (hY.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (fun i j l => (Y.presheaf.map (homOfLE (le_top : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l ≤ ⊤)).op).hom.comp (hY.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (fun i j => (Y.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m i)).op).hom) (fun i j => (Y.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ≤ g ⁻¹ᵁ wcPmChart m j)).op).hom) (fun i j l => (Y.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom) (fun i j l => (Y.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l)).op).hom) (fun i j l => (Y.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m l)).op).hom) (fun i l => g.app (wcPmChart m i) (e i l)) :=
by
  intro A _ Y hY m g hU e h1 h2 h3 hgen

  have sres : ∀ (X : Scheme.{u}) (U V W : X.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (h3 : W ≤ U)
      (x : Γ(X, U)), (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE h3).op).hom x := by
    intro X U V W h1 h2 h3 x
    change (X.presheaf.map (homOfLE h1).op ≫ X.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have sres2 : ∀ (X : Scheme.{u}) (U V V' W : X.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (h1' : V' ≤ U)
      (h2' : W ≤ V') (x : Γ(X, U)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE h2').op).hom ((X.presheaf.map (homOfLE h1').op).hom x) := by
    intro X U V V' W h1 h2 h1' h2' x
    rw [sres X U V W h1 h2 (le_trans h2 h1) x, sres X U V' W h1' h2' (le_trans h2 h1) x]

  have saway : ∀ (X : Scheme.{u}) (U V : X.Opens) (hVU : V ≤ U), IsAffineOpen U →
      ∀ f : Γ(X, U), V = X.basicOpen f → IsUnit ((X.presheaf.map (homOfLE hVU).op).hom f) ∧
      (∀ s : Γ(X, V), ∃ (N : ℕ) (x : Γ(X, U)), (X.presheaf.map (homOfLE hVU).op).hom f ^ N * s =
        (X.presheaf.map (homOfLE hVU).op).hom x) ∧
      ∀ x : Γ(X, U), (X.presheaf.map (homOfLE hVU).op).hom x = 0 → ∃ N : ℕ, f ^ N * x = 0 := by
    intro X U V hVU hU f hV
    letI := (X.presheaf.map (homOfLE hVU).op).hom.toAlgebra
    haveI := hU.isLocalization_of_eq_basicOpen f (homOfLE hVU) hV
    refine ⟨?_, fun s => ?_, fun x hx => ?_⟩
    · exact IsLocalization.Away.algebraMap_isUnit (S := Γ(X, V)) f
    · obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj (S := Γ(X, V)) f s
      refine ⟨n, a, ?_⟩
      rw [mul_comm]
      exact ha
    · obtain ⟨⟨mm, hm⟩, hmx⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers f) Γ(X, V) x).mp hx
      obtain ⟨n, rfl⟩ := hm
      exact ⟨n, hmx⟩

  have spre : ∀ (Y P : Scheme.{u}) (g : Y ⟶ P) (U V : P.Opens) (f : Γ(P, U)),
      U ⊓ V = P.basicOpen f → g ⁻¹ᵁ U ⊓ g ⁻¹ᵁ V = Y.basicOpen (g.app U f) := by
    intro Y P g U V f h
    rw [← Scheme.Hom.preimage_inf, h, Scheme.preimage_basicOpen]

  have smul : ∀ (Y P : Scheme.{u}) (g : Y ⟶ P) (U V : P.Opens) (x y : Γ(P, U)) (z : Γ(P, V)),
      P.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op x =
        P.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op y *
          P.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op z →
      Y.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ U ⊓ g ⁻¹ᵁ V ≤ g ⁻¹ᵁ U)).op (g.app U x) =
        Y.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ U ⊓ g ⁻¹ᵁ V ≤ g ⁻¹ᵁ U)).op (g.app U y) *
          Y.presheaf.map (homOfLE (inf_le_right : g ⁻¹ᵁ U ⊓ g ⁻¹ᵁ V ≤ g ⁻¹ᵁ V)).op (g.app V z) := by
    intro Y P g U V x y z h
    have nat : ∀ (W W' : P.Opens) (hle : W ≤ W') (w : Γ(P, W')),
        g.app W (P.presheaf.map (homOfLE hle).op w) =
          Y.presheaf.map (homOfLE (g.preimage_mono hle)).op (g.app W' w) := by
      intro W W' hle w
      rw [← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply]
      rfl
    have h' := congrArg (g.app (U ⊓ V)) h
    rw [map_mul, nat, nat, nat] at h'
    exact h'
  refine ⟨fun i j a => ?_, fun i j a => ?_, fun i j l a => ?_, fun i j l a => ?_,
    fun i j l a => ?_, fun i j l x => ?_, fun i j l x => ?_, fun i j l x => ?_, hgen,
    fun i => ?_, fun i j l => ?_, fun i j => ?_, fun i j => ?_, fun i j l => ?_, fun i x => rfl⟩
  · simp only [RingHom.comp_apply]
    exact sres _ _ _ _ _ _ _ _
  · simp only [RingHom.comp_apply]
    exact sres _ _ _ _ _ _ _ _
  · simp only [RingHom.comp_apply]
    exact sres _ _ _ _ _ _ _ _
  · simp only [RingHom.comp_apply]
    exact sres _ _ _ _ _ _ _ _
  · simp only [RingHom.comp_apply]
    exact sres _ _ _ _ _ _ _ _
  · exact sres2 _ _ _ _ _ _ _ _ _ _
  · exact sres2 _ _ _ _ _ _ _ _ _ _
  · exact sres2 _ _ _ _ _ _ _ _ _ _
  · show g.app (wcPmChart m i) (e i i) = 1
    rw [h1, map_one]
  · exact smul Y _ g _ _ (e i l) (e i j) (e j l) (h3 i j l)
  · exact saway Y _ _ inf_le_left (hU i) _ (spre Y _ g _ _ (e i j) (h2 i j))
  · exact saway Y _ _ inf_le_right (hU j) _
      ((inf_comm _ _).trans (spre Y _ g _ _ (e j i) (h2 j i)))
  · have hT : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l ≤
        g ⁻¹ᵁ wcPmChart m i := le_trans inf_le_left inf_le_left
    have hTb : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ⊓ g ⁻¹ᵁ wcPmChart m l =
        Y.basicOpen (g.app (wcPmChart m i) (e i j) * g.app (wcPmChart m i) (e i l)) := by
      rw [Scheme.basicOpen_mul, ← spre Y _ g _ _ (e i j) (h2 i j),
        ← spre Y _ g _ _ (e i l) (h2 i l)]
      exact le_antisymm (le_inf inf_le_left (le_inf (le_trans inf_le_left inf_le_left) inf_le_right))
        (le_inf inf_le_left (le_trans inf_le_right inf_le_right))
    obtain ⟨u, sj, ker⟩ := saway Y _ _ hT (hU i) _ hTb
    have conv : ∀ y : Γ(Y, g ⁻¹ᵁ wcPmChart m i),
        (Y.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ⊓
          g ⁻¹ᵁ wcPmChart m l ≤ g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j)).op).hom
          ((Y.presheaf.map (homOfLE (inf_le_left : g ⁻¹ᵁ wcPmChart m i ⊓ g ⁻¹ᵁ wcPmChart m j ≤
            g ⁻¹ᵁ wcPmChart m i)).op).hom y) = (Y.presheaf.map (homOfLE hT).op).hom y :=
      fun y => sres _ _ _ _ _ _ _ y
    beta_reduce
    refine ⟨?_, fun s => ?_, fun x hx => ?_⟩
    · rw [conv]
      exact u
    · obtain ⟨N, x, hx⟩ := sj s
      refine ⟨N, x, ?_⟩
      rw [conv, conv]
      exact hx
    · rw [conv] at hx
      exact ker x hx

theorem wc_gc_altD_sq_zero : ∀ (A : Type u) [CommRing A] (V : Type u) [AddCommGroup V] [Module A V] (n : ℕ) (z : Finset (Fin n) → V) (τ : Finset (Fin n)), wcAltD (A := A) n (wcAltD (A := A) n z) τ = 0 :=
by
  intro A _ V _ _ n z τ
  classical

  have sign_lt : ∀ i j : Fin n, i ∈ τ → j ∈ τ → j < i →
      (-1 : A) ^ (τ.filter (· < i)).card * (-1 : A) ^ ((τ.erase i).filter (· < j)).card =
      -((-1 : A) ^ (τ.filter (· < j)).card * (-1 : A) ^ ((τ.erase j).filter (· < i)).card) := by
    intro i j hi hj hji
    have h1 : (τ.erase i).filter (· < j) = τ.filter (· < j) := by
      rw [Finset.filter_erase]
      apply Finset.erase_eq_of_notMem
      simp only [Finset.mem_filter, not_and, not_lt]
      intro _
      exact hji.le
    have h2 : ((τ.erase j).filter (· < i)).card + 1 = (τ.filter (· < i)).card := by
      rw [Finset.filter_erase]
      apply Finset.card_erase_add_one
      exact Finset.mem_filter.mpr ⟨hj, hji⟩
    rw [h1, ← h2, pow_succ]
    ring

  have sign : ∀ i j : Fin n, i ∈ τ → j ∈ τ → i ≠ j →
      (-1 : A) ^ (τ.filter (· < i)).card * (-1 : A) ^ ((τ.erase i).filter (· < j)).card =
      -((-1 : A) ^ (τ.filter (· < j)).card * (-1 : A) ^ ((τ.erase j).filter (· < i)).card) := by
    intro i j hi hj hij
    rcases lt_or_gt_of_ne hij with h | h
    · rw [sign_lt j i hj hi h, neg_neg]
    · exact sign_lt i j hi hj h

  simp only [wcAltD, Finset.smul_sum, smul_smul]
  rw [Finset.sum_sigma']
  apply Finset.sum_involution (fun p _ => (⟨p.2, p.1⟩ : Σ _ : Fin n, Fin n))
  · rintro ⟨i, j⟩ hp
    simp only [Finset.mem_sigma, Finset.mem_erase] at hp
    obtain ⟨hi, hji, hj⟩ := hp
    dsimp only
    rw [Finset.erase_right_comm, sign i j hi hj (Ne.symm hji), neg_smul, neg_add_cancel]
  · rintro ⟨i, j⟩ hp _ h
    simp only [Finset.mem_sigma, Finset.mem_erase] at hp
    simp only [Sigma.mk.inj_iff] at h
    exact hp.2.1 h.1
  · rintro ⟨i, j⟩ hp
    simp only [Finset.mem_sigma, Finset.mem_erase] at hp ⊢
    exact ⟨hp.2.2, Ne.symm hp.2.1, hp.1⟩
  · intros
    rfl

theorem wc_gc_laurK_sub_laurC : ∀ (A : Type u) [CommRing A] (n R : ℕ) (d : Fin R → ℕ) (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)) (w : ℤ) (σ : Finset (Fin n)), ∀ x ∈ wcLaurK A n R d K w σ, x ∈ wcLaurC A n R d w σ :=
by
  intro A _ n R d K w σ x hx
  unfold wcLaurK at hx
  simp only [wcLaurC, Set.mem_setOf_eq]
  induction hx using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨k, f, _, hdeg, rfl⟩ := hv
    intro r
    refine Submodule.sum_mem _ (fun m hm => ?_)
    apply Finsupp.single_mem_supported
    rw [Set.mem_setOf_eq]
    refine ⟨?_, ?_⟩
    · have h1 := hdeg r m hm
      rw [Finset.sum_sub_distrib, h1]
      have h2 : ∑ i : Fin n, (if i ∈ σ then (k : ℤ) else 0) = (σ.card : ℤ) * k := by
        rw [Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]
      rw [h2]
      push_cast
      ring
    · intro i hi
      simp only [hi, if_false, sub_zero]
      exact Int.natCast_nonneg _
  | zero => intro r; exact Submodule.zero_mem _
  | add x y _ _ hx hy => intro r; exact Submodule.add_mem _ (hx r) (hy r)
  | smul a x _ hx => intro r; exact Submodule.smul_mem _ a (hx r)

theorem wc_gc_free_reduce_box : ∀ (A : Type u) [CommRing A] (n R : ℕ) (d : Fin R → ℕ) (p : ℕ) (w : ℤ), (∀ (z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) (i0 : Fin n) (s : Finset (Fin n)), wcAltD (A := A) n (fun ρ => if i0 ∈ ρ then 0 else ((-1 : A) ^ (ρ.filter (· < i0)).card) • z (insert i0 ρ)) s + (if i0 ∈ s then 0 else ((-1 : A) ^ (s.filter (· < i0)).card) • wcAltD (A := A) n z (insert i0 s)) = z s) → ∀ z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, (∀ σ, (σ.card = p + 1 → z σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → z σ = 0)) → (∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n z τ = 0) → ∃ y : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, (∀ σ, (σ.card = p → y σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p → y σ = 0)) ∧ (p = 0 → y = 0) ∧ ∀ σ : Finset (Fin n), σ.card = p + 1 → ∀ r, ∀ β ∈ (z σ r - wcAltD (A := A) n y σ r).support, ∑ i, β i = w - d r ∧ ((∀ i, 0 ≤ β i) ∨ (∀ i, β i < 0)) :=
by
  intro A _ n R d p w Hcone z Hval Hcoc
  classical

  obtain ⟨B, hB⟩ : ∃ B : (Fin n → ℤ) → Prop,
      ∀ β, B β ↔ ((∀ j, 0 ≤ β j) ∨ (∀ j, β j < 0)) := ⟨_, fun _ => Iff.rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : Fin n → (Fin n → ℤ) → Prop, ∀ i β, Q i β ↔
      (¬((∀ j, 0 ≤ β j) ∨ (∀ j, β j < 0)) ∧ 0 ≤ β i ∧ ∀ j, j < i → β j < 0) :=
    ⟨_, fun _ _ => Iff.rfl⟩

  have memC : ∀ (σ : Finset (Fin n)) (v : Fin R → (Fin n → ℤ) →₀ A),
      v ∈ wcLaurC A n R d w σ ↔
        ∀ r, ∀ β ∈ (v r).support, ∑ i, β i = w - d r ∧ ∀ i, i ∉ σ → 0 ≤ β i := by
    intro σ v
    simp only [wcLaurC, Set.mem_setOf_eq, Finsupp.mem_supported, Set.subset_def,
      Finset.mem_coe]

  have hpart : ∀ v : (Fin n → ℤ) →₀ A, v = v.filter B + ∑ i : Fin n, v.filter (Q i) := by
    intro v
    ext β
    rw [Finsupp.add_apply, Finsupp.finsetSum_apply]
    simp only [Finsupp.filter_apply]
    by_cases hb : B β
    · rw [if_pos hb, Finset.sum_eq_zero, add_zero]
      intro i _
      rw [if_neg]
      intro hq
      exact ((hQ i β).1 hq).1 ((hB β).1 hb)
    · rw [if_neg hb, zero_add]
      have hb' : ¬((∀ j, 0 ≤ β j) ∨ (∀ j, β j < 0)) := fun h => hb ((hB β).2 h)
      have hne : (Finset.univ.filter (fun i => 0 ≤ β i)).Nonempty := by
        by_contra hcon
        rw [Finset.not_nonempty_iff_eq_empty, Finset.filter_eq_empty_iff] at hcon
        exact hb' (Or.inr fun j => not_le.mp (hcon (Finset.mem_univ j)))
      obtain ⟨i0, hi0mem, hi0min⟩ : ∃ i0 ∈ Finset.univ.filter (fun i => 0 ≤ β i),
          ∀ j ∈ Finset.univ.filter (fun i => 0 ≤ β i), i0 ≤ j :=
        ⟨_, Finset.min'_mem _ hne, fun j hj => Finset.min'_le _ j hj⟩
      have hpos : 0 ≤ β i0 := (Finset.mem_filter.1 hi0mem).2
      have hlt : ∀ j, j < i0 → β j < 0 := by
        intro j hj
        by_contra hcon
        have hjm : j ∈ Finset.univ.filter (fun i => 0 ≤ β i) :=
          Finset.mem_filter.2 ⟨Finset.mem_univ _, not_lt.mp hcon⟩
        exact absurd hj (not_lt_of_ge (hi0min j hjm))
      have hq0 : Q i0 β := (hQ i0 β).2 ⟨hb', hpos, hlt⟩
      rw [Finset.sum_eq_single i0, if_pos hq0]
      · intro i _ hi
        rw [if_neg]
        intro hq
        obtain ⟨_, hqi, hqlt⟩ := (hQ i β).1 hq
        rcases lt_or_gt_of_ne hi with h | h
        · exact absurd hqi (not_le_of_gt (hlt i h))
        · exact absurd hpos (not_le_of_gt (hqlt i0 h))
      · intro h
        exact absurd (Finset.mem_univ i0) h

  have hfilt : ∀ (P : (Fin n → ℤ) → Prop) [DecidablePred P]
      (z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) (τ : Finset (Fin n)) (r : Fin R),
      wcAltD (A := A) n (fun σ r' => (z σ r').filter P) τ r = (wcAltD (A := A) n z τ r).filter P := by
    intro P _ z τ r
    have e : ∀ (s : Finset (Fin n)) (f : Fin n → (Fin n → ℤ) →₀ A),
        (∑ i ∈ s, f i).filter P = ∑ i ∈ s, (f i).filter P :=
      fun s f => map_sum (Finsupp.filterAddHom P) f s
    simp only [wcAltD, Finset.sum_apply, Pi.smul_apply]
    rw [e]
    simp only [Finsupp.filter_smul]

  have hsum : ∀ (H : Fin n → Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) (s : Finset (Fin n)),
      wcAltD (A := A) n (fun ρ => ∑ i, H i ρ) s = ∑ i, wcAltD (A := A) n (H i) s := by
    intro H s
    unfold wcAltD
    simp only [Finset.smul_sum]
    exact Finset.sum_comm

  obtain ⟨zQ, hzQ⟩ : ∃ zQ : Fin n → Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A,
      ∀ i σ r, zQ i σ r = (z σ r).filter (Q i) := ⟨_, fun _ _ _ => rfl⟩
  obtain ⟨H, hH⟩ : ∃ H : Fin n → Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, ∀ i ρ,
      H i ρ = if i ∈ ρ then 0 else ((-1 : A) ^ (ρ.filter (· < i)).card) • zQ i (insert i ρ) :=
    ⟨_, fun _ _ => rfl⟩

  have hoff : ∀ i ρ, ρ.card ≠ p → H i ρ = 0 := by
    intro i ρ hρ
    rw [hH]
    split_ifs with hi
    · rfl
    · have h0 : z (insert i ρ) = 0 :=
        (Hval _).2 (by rw [Finset.card_insert_of_notMem hi]; omega)
      have hz : zQ i (insert i ρ) = 0 := by
        funext r
        rw [hzQ, h0, Pi.zero_apply, Finsupp.filter_zero]
      rw [hz, smul_zero]
  refine ⟨fun ρ => ∑ i, H i ρ, ?_, ?_, ?_⟩
  ·
    intro σ
    constructor
    · intro hσ
      show ∀ r, (∑ i, H i σ) r ∈
        Finsupp.supported A A {β : Fin n → ℤ | ∑ i, β i = w - d r ∧ ∀ i, i ∉ σ → 0 ≤ β i}
      intro r
      rw [Finset.sum_apply]
      refine Submodule.sum_mem _ (fun i _ => ?_)
      rw [hH]
      split_ifs with hi
      · rw [Pi.zero_apply]
        exact Submodule.zero_mem _
      · rw [Pi.smul_apply]
        refine Submodule.smul_mem _ _ ?_
        rw [hzQ, Finsupp.mem_supported]
        intro β hβ
        rw [Finset.mem_coe, Finsupp.support_filter, Finset.mem_filter] at hβ
        obtain ⟨hβz, hβQ⟩ := hβ
        have hv := (memC _ _).1 ((Hval (insert i σ)).1
          (by rw [Finset.card_insert_of_notMem hi, hσ])) r β hβz
        obtain ⟨_, hqi, _⟩ := (hQ i β).1 hβQ
        refine ⟨hv.1, fun j hj => ?_⟩
        by_cases hji : j = i
        · rw [hji]; exact hqi
        · exact hv.2 j (by rw [Finset.mem_insert]; push_neg; exact ⟨hji, hj⟩)
    · intro hσ
      show ∑ i, H i σ = 0
      exact Finset.sum_eq_zero (fun i _ => hoff i σ hσ)
  ·
    intro hp
    funext ρ
    show ∑ i, H i ρ = 0
    refine Finset.sum_eq_zero (fun i _ => ?_)
    by_cases hρ : ρ.card = 0
    · rw [Finset.card_eq_zero] at hρ
      subst hρ
      rw [hH, if_neg (Finset.notMem_empty i)]
      have hz : zQ i (insert i ∅) = 0 := by
        funext r
        rw [hzQ, Pi.zero_apply, Finsupp.filter_eq_zero_iff]
        intro β hq
        by_contra hne
        have hv := (memC _ _).1 ((Hval (insert i ∅)).1 (by simp [hp])) r β
          (Finsupp.mem_support_iff.2 hne)
        obtain ⟨hnb, hqi, _⟩ := (hQ i β).1 hq
        apply hnb
        left
        intro j
        by_cases hji : j = i
        · rw [hji]; exact hqi
        · exact hv.2 j (by simp [hji])
      rw [hz, smul_zero]
    · exact hoff i ρ (by omega)
  ·
    intro s hs r β hβ
    have hcone : ∀ i : Fin n, wcAltD (A := A) n (H i) s = zQ i s := by
      intro i
      have hHi : H i = fun ρ => if i ∈ ρ then 0 else
          ((-1 : A) ^ (ρ.filter (· < i)).card) • zQ i (insert i ρ) := funext (hH i)
      have h := Hcone (zQ i) i s
      have h2 : (if i ∈ s then (0 : Fin R → (Fin n → ℤ) →₀ A) else
          ((-1 : A) ^ (s.filter (· < i)).card) • wcAltD (A := A) n (zQ i) (insert i s)) = 0 := by
        split_ifs with hi
        · rfl
        · have hz0 : wcAltD (A := A) n (zQ i) (insert i s) = 0 := by
            funext r'
            have e : zQ i = fun σ r'' => (z σ r'').filter (Q i) := by
              funext σ r''
              exact hzQ i σ r''
            rw [e, hfilt (Q i) z (insert i s) r',
              Hcoc (insert i s) (by rw [Finset.card_insert_of_notMem hi, hs])]
            exact Finsupp.filter_zero (Q i)
          rw [hz0, smul_zero]
      rw [h2, add_zero] at h
      rw [hHi]
      exact h
    have hdy : wcAltD (A := A) n (fun ρ => ∑ i, H i ρ) s r = ∑ i, (z s r).filter (Q i) := by
      rw [hsum H s, Finset.sum_apply]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hcone i, hzQ]
    have hdiff : z s r - wcAltD (A := A) n (fun ρ => ∑ i, H i ρ) s r = (z s r).filter B := by
      rw [hdy, sub_eq_iff_eq_add]
      exact hpart (z s r)
    rw [hdiff, Finsupp.support_filter, Finset.mem_filter] at hβ
    obtain ⟨hβs, hβB⟩ := hβ
    exact ⟨((memC s (z s)).1 ((Hval s).1 hs) r β hβs).1, (hB β).1 hβB⟩

theorem wc_gc_box_fg : ∀ (A : Type u) [CommRing A] (n R : ℕ) (d : Fin R → ℕ) (p : ℕ) (w : ℤ), ∃ (k : ℕ) (c : Fin k → Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A), ∀ x : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, (∀ σ : Finset (Fin n), σ.card = p + 1 → ∀ r, ∀ β ∈ (x σ r).support, ∑ i, β i = w - d r ∧ ((∀ i, 0 ≤ β i) ∨ (∀ i, β i < 0))) → ∃ a : Fin k → A, ∀ σ : Finset (Fin n), σ.card = p + 1 → x σ = ∑ l, a l • c l σ :=
by
  classical
  intro A _ n R d p w

  have hbox : ∀ (e : ℤ) (β : Fin n → ℤ), ∑ i, β i = e →
      ((∀ i, 0 ≤ β i) ∨ (∀ i, β i < 0)) → ∀ i, |β i| ≤ |e| := by
    intro e β hs hb i
    rcases hb with h | h
    · have h1 : β i ≤ ∑ j, β j := Finset.single_le_sum (fun j _ => h j) (Finset.mem_univ i)
      rw [abs_of_nonneg (h i)]
      linarith [le_abs_self e]
    · have h1 : -β i ≤ ∑ j, -β j :=
        Finset.single_le_sum (f := fun j => -β j) (fun j _ => by linarith [h j]) (Finset.mem_univ i)
      rw [Finset.sum_neg_distrib] at h1
      rw [abs_of_neg (h i)]
      linarith [neg_le_abs e]
  set N : ℤ := |w| + ∑ r, (d r : ℤ) with hN
  set B : Finset (Fin n → ℤ) := Fintype.piFinset (fun _ => Finset.Icc (-N) N) with hB
  set S : Finset (Finset (Fin n)) := Finset.univ.filter (fun σ => σ.card = p + 1) with hS
  set T : Finset ((Finset (Fin n) × Fin R) × (Fin n → ℤ)) := (S ×ˢ Finset.univ) ×ˢ B with hT
  let e := T.equivFin
  let tt : Fin T.card → (Finset (Fin n) × Fin R) × (Fin n → ℤ) := fun l => (e.symm l : _)
  refine ⟨T.card, fun l σ r => if (σ, r) = (tt l).1 then Finsupp.single (tt l).2 (1 : A) else 0, ?_⟩
  intro x hx
  refine ⟨fun l => x (tt l).1.1 (tt l).1.2 (tt l).2, ?_⟩
  intro σ hσ
  funext r
  ext b
  let g : (Finset (Fin n) × Fin R) × (Fin n → ℤ) → A := fun t =>
    x t.1.1 t.1.2 t.2 * (if (σ, r) = t.1 then Finsupp.single t.2 (1 : A) else 0) b
  have hlhs : (∑ l, (fun l => x (tt l).1.1 (tt l).1.2 (tt l).2) l •
      (fun l σ r => if (σ, r) = (tt l).1 then Finsupp.single (tt l).2 (1 : A) else 0) l σ) r b
      = ∑ l, g (tt l) := by
    rw [Finset.sum_apply, Finsupp.finset_sum_apply]
    rfl
  rw [hlhs]
  have hre : ∑ l, g (tt l) = ∑ t ∈ T, g t := by
    rw [← Finset.sum_coe_sort T g]
    exact Equiv.sum_comp e.symm (fun t : T => g t)
  rw [hre, Finset.sum_eq_single ((σ, r), b)]
  · simp [g]
  · rintro ⟨⟨σ', r'⟩, b'⟩ _ ht
    by_cases h : (σ, r) = (σ', r')
    · simp only [g, if_pos h, Finsupp.single_apply]
      rw [if_neg, mul_zero]
      rintro rfl
      exact ht (by rw [h])
    · simp only [g, if_neg h, Finsupp.coe_zero, Pi.zero_apply, mul_zero]
  · intro hnot
    have hb0 : x σ r b = 0 := by
      by_contra hne
      apply hnot
      have hbs : b ∈ (x σ r).support := Finsupp.mem_support_iff.mpr hne
      obtain ⟨hsum, hbx⟩ := hx σ hσ r b hbs
      have hbd := hbox _ b hsum hbx
      rw [hT, Finset.mem_product, Finset.mem_product, hS, Finset.mem_filter, hB,
        Fintype.mem_piFinset]
      refine ⟨⟨⟨Finset.mem_univ _, hσ⟩, Finset.mem_univ _⟩, fun i => ?_⟩
      have h1 := hbd i
      have hd0 : (0 : ℤ) ≤ (d r : ℤ) := Nat.cast_nonneg _
      have h2 : |w - (d r : ℤ)| ≤ |w| + (d r : ℤ) :=
        abs_le.mpr ⟨by linarith [neg_abs_le w], by linarith [le_abs_self w]⟩
      have h3 : (d r : ℤ) ≤ ∑ r', (d r' : ℤ) :=
        Finset.single_le_sum (f := fun j => (d j : ℤ)) (fun j _ => Nat.cast_nonneg (d j))
          (Finset.mem_univ r)
      have h4 : |b i| ≤ N := by rw [hN]; linarith
      rw [Finset.mem_Icc]
      exact abs_le.mp h4
    simp [g, hb0]

theorem wc_gc_graded_presentation : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (n R : ℕ) (d : Fin R → ℕ) (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)), (∀ f ∈ K, ∀ t : ℕ, (fun r => if d r ≤ t then MvPolynomial.homogeneousComponent (t - d r) (f r) else 0) ∈ K) → ∃ (R' : ℕ) (d' : Fin R' → ℕ) (g : Fin R' → Fin R → MvPolynomial (Fin n) A), (∀ j r, (g j r).IsHomogeneous (d' j - d r)) ∧ (∀ j r, d' j < d r → g j r = 0) ∧ (∀ j, g j ∈ K) ∧ ∀ f ∈ K, ∃ h : Fin R' → MvPolynomial (Fin n) A, f = ∑ j, h j • g j :=
by
  intro A _ _ n R d K hK
  have hsum : ∀ (φ : MvPolynomial (Fin n) A) (d₀ T : ℕ), φ.totalDegree + d₀ ≤ T →
      ∑ t ∈ Finset.range (T + 1),
        (if d₀ ≤ t then MvPolynomial.homogeneousComponent (t - d₀) φ else 0) = φ := by
    intro φ d₀ T hT
    ext m
    rw [MvPolynomial.coeff_sum]
    by_cases hm : φ.coeff m = 0
    · rw [hm]
      apply Finset.sum_eq_zero
      intro t _
      split_ifs
      · rw [MvPolynomial.coeff_homogeneousComponent]
        split_ifs <;> simp [hm]
      · simp
    · have hD : Finsupp.degree m ≤ φ.totalDegree := by
        have h1 := MvPolynomial.le_totalDegree (MvPolynomial.mem_support_iff.mpr hm)
        have h2 : Finsupp.degree m = m.sum fun _ e => e := rfl
        rw [h2]; exact h1
      rw [Finset.sum_eq_single (Finsupp.degree m + d₀)]
      · rw [if_pos (by omega), MvPolynomial.coeff_homogeneousComponent]
        rw [if_pos (by omega)]
      · intro t _ ht
        split_ifs with h1
        · rw [MvPolynomial.coeff_homogeneousComponent]
          rw [if_neg]
          intro h3
          apply ht
          omega
        · simp
      · intro h
        exfalso
        apply h
        rw [Finset.mem_range]
        omega
  obtain ⟨q, f, hf⟩ :=
    Submodule.fg_iff_exists_fin_generating_family.mp (IsNoetherian.noetherian K)
  have hfK : ∀ a, f a ∈ K := fun a => hf ▸ Submodule.subset_span ⟨a, rfl⟩
  set T := ∑ a, ∑ r, ((f a r).totalDegree + d r) with hTdef
  have hTle : ∀ a r, (f a r).totalDegree + d r ≤ T := by
    intro a r
    calc (f a r).totalDegree + d r ≤ ∑ r', ((f a r').totalDegree + d r') :=
          Finset.single_le_sum (f := fun r' => (f a r').totalDegree + d r')
            (fun _ _ => Nat.zero_le _) (Finset.mem_univ r)
      _ ≤ T := Finset.single_le_sum (f := fun a' => ∑ r', ((f a' r').totalDegree + d r'))
            (fun _ _ => Nat.zero_le _) (Finset.mem_univ a)
  let π : Fin q → ℕ → Fin R → MvPolynomial (Fin n) A := fun a t r =>
    if d r ≤ t then MvPolynomial.homogeneousComponent (t - d r) (f a r) else 0
  have hrec : ∀ a, ∑ t : Fin (T + 1), π a t = f a := by
    intro a
    funext r
    rw [Finset.sum_apply]
    rw [Fin.sum_univ_eq_sum_range (fun t => π a t r) (T + 1)]
    exact hsum (f a r) (d r) T (hTle a r)
  refine ⟨q * (T + 1), fun j => (finProdFinEquiv.symm j).2,
    fun j => π (finProdFinEquiv.symm j).1 (finProdFinEquiv.symm j).2, ?_, ?_, ?_, ?_⟩
  · intro j r
    simp only [π]
    split_ifs
    · exact MvPolynomial.homogeneousComponent_isHomogeneous _ _
    · exact MvPolynomial.isHomogeneous_zero _ _ _
  · intro j r hlt
    have hlt' : ((finProdFinEquiv.symm j).2 : ℕ) < d r := hlt
    simp only [π]
    rw [if_neg (by omega)]
  · intro j
    exact hK _ (hfK _) _
  · intro x hx
    rw [← hf] at hx
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx
    refine ⟨fun j => c (finProdFinEquiv.symm j).1, ?_⟩
    rw [← hc]
    have e1 : ∑ j : Fin (q * (T + 1)), c (finProdFinEquiv.symm j).1 •
        π (finProdFinEquiv.symm j).1 (finProdFinEquiv.symm j).2 =
        ∑ x : Fin q × Fin (T + 1), c x.1 • π x.1 x.2 :=
      Fintype.sum_equiv finProdFinEquiv.symm _ _ (fun _ => rfl)
    show _ = ∑ j : Fin (q * (T + 1)), c (finProdFinEquiv.symm j).1 •
        π (finProdFinEquiv.symm j).1 (finProdFinEquiv.symm j).2
    rw [e1, Fintype.sum_prod_type]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [← hrec a, Finset.smul_sum]

theorem wc_gc_graded_kernel_hc : ∀ (A : Type u) [CommRing A] (n R R' : ℕ) (d : Fin R → ℕ) (d' : Fin R' → ℕ) (g : Fin R' → Fin R → MvPolynomial (Fin n) A), (∀ j r, (g j r).IsHomogeneous (d' j - d r)) → (∀ j r, d' j < d r → g j r = 0) → ∀ (h : Fin R' → MvPolynomial (Fin n) A) (t : ℕ), (fun r => if d r ≤ t then MvPolynomial.homogeneousComponent (t - d r) ((∑ j, h j • g j) r) else 0) = ∑ j, (if d' j ≤ t then MvPolynomial.homogeneousComponent (t - d' j) (h j) else 0) • g j :=
by
  classical
  intro A _ n R R' d d' g hhom hvan h t
  have hmulhc : ∀ (φ ψ : MvPolynomial (Fin n) A) (i m : ℕ), φ.IsHomogeneous i →
      MvPolynomial.homogeneousComponent m (φ * ψ) =
        if i ≤ m then φ * MvPolynomial.homogeneousComponent (m - i) ψ else 0 := by
    intro φ ψ i m hφ
    let _ := @MvPolynomial.gradedAlgebra (Fin n) A _
    have hdec : ∀ (p : MvPolynomial (Fin n) A) (k : ℕ),
        ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin n) A) p) k :
          MvPolynomial (Fin n) A) = MvPolynomial.homogeneousComponent k p :=
      fun p k => MvPolynomial.decomposition.decompose'_apply p k
    have := DirectSum.coe_decompose_mul_of_left_mem (MvPolynomial.homogeneousSubmodule (Fin n) A)
      (b := ψ) m ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hφ)
    rw [hdec, hdec] at this
    exact this
  funext r
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  by_cases hr : d r ≤ t
  · rw [if_pos hr, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    by_cases hjr : d' j < d r
    · rw [hvan j r hjr, mul_zero, mul_zero, map_zero]
    · rw [mul_comm, hmulhc _ _ _ _ (hhom j r)]
      by_cases hjt : d' j ≤ t
      · rw [if_pos (by omega), if_pos hjt,
          show t - d r - (d' j - d r) = t - d' j by omega, mul_comm]
      · rw [if_neg (by omega), if_neg hjt, zero_mul]
  · rw [if_neg hr]
    symm
    apply Finset.sum_eq_zero
    intro j _
    by_cases hjt : d' j ≤ t
    · rw [hvan j r (by omega), mul_zero]
    · rw [if_neg hjt, zero_mul]

theorem wc_gc_laur_mul : ∀ (A : Type u) [CommRing A] (n : ℕ) (σ : Finset (Fin n)) (k : ℕ) (g h : MvPolynomial (Fin n) A), (∑ m ∈ g.support, g.coeff m • Finsupp.lmapDomain A A (fun β : Fin n → ℤ => β + fun i => ((m i : ℕ) : ℤ))) (∑ m ∈ h.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (h.coeff m)) = ∑ m ∈ (h * g).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((h * g).coeff m) :=
by
  classical
  intro A _ n σ k g h
  have hshift : ∀ m' m : Fin n →₀ ℕ,
      ((fun i => (m' i : ℤ) - if i ∈ σ then (k : ℤ) else 0) + fun i => ((m i : ℕ) : ℤ)) =
        fun i => ((m' + m) i : ℤ) - if i ∈ σ then (k : ℤ) else 0 := by
    intro m' m
    funext i
    simp only [Pi.add_apply, Finsupp.add_apply]
    push_cast
    ring
  have hT : ∀ (m' : Fin n →₀ ℕ) (a : A),
      (∑ m ∈ g.support, g.coeff m • Finsupp.lmapDomain A A
        (fun β : Fin n → ℤ => β + fun i => ((m i : ℕ) : ℤ)))
        (Finsupp.single (fun i => (m' i : ℤ) - if i ∈ σ then (k : ℤ) else 0) a) =
      ∑ m ∈ g.support, Finsupp.single (fun i => ((m' + m) i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        (a * g.coeff m) := by
    intro m' a
    rw [LinearMap.sum_apply]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [LinearMap.smul_apply, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single, hshift,
      Finsupp.smul_single, smul_eq_mul, mul_comm]
  have hp : h * g = ∑ m' ∈ h.support, ∑ m ∈ g.support,
      MvPolynomial.monomial (m' + m) (h.coeff m' * g.coeff m) := by
    conv_lhs => rw [MvPolynomial.as_sum h, MvPolynomial.as_sum g]
    rw [Finset.sum_mul_sum]
    simp_rw [MvPolynomial.monomial_mul_monomial]
  have hcoeff : (h * g).coeff = ∑ m' ∈ h.support, ∑ m ∈ g.support,
      Finsupp.single (m' + m) (h.coeff m' * g.coeff m) := by
    rw [hp]
    ext μ
    simp only [MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial, Finsupp.coe_finsetSum,
      Finset.sum_apply, Finsupp.single_apply]
  have hR : (∑ m ∈ (h * g).support,
      Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((h * g).coeff m)) =
      Finsupp.mapDomain (fun m : Fin n →₀ ℕ => fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        (h * g).coeff := rfl
  rw [map_sum]
  refine (Finset.sum_congr rfl fun m' _ => hT m' (h.coeff m')).trans ?_
  rw [hR, hcoeff, Finsupp.mapDomain_finsetSum]
  refine Finset.sum_congr rfl fun m' _ => ?_
  rw [Finsupp.mapDomain_finsetSum]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [Finsupp.mapDomain_single]

theorem wc_gc_laur_add_inj : ∀ (A : Type u) [CommRing A] (n : ℕ) (σ : Finset (Fin n)) (k : ℕ) (f₁ f₂ : MvPolynomial (Fin n) A), (∑ m ∈ (f₁ + f₂).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((f₁ + f₂).coeff m) = (∑ m ∈ f₁.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f₁.coeff m)) + ∑ m ∈ f₂.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f₂.coeff m)) ∧ ((∑ m ∈ f₁.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f₁.coeff m)) = 0 → f₁ = 0) :=
by
  intro A _ n σ k f₁ f₂
  classical
  set e : (Fin n →₀ ℕ) → (Fin n → ℤ) :=
    fun m i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0 with he
  have hinj : Function.Injective e := by
    intro m m' h
    ext i
    have h' := congrFun h i
    simp only [he] at h'
    exact_mod_cast (sub_left_inj.mp h')
  have hext : ∀ (S : Finset (Fin n →₀ ℕ)) (f : MvPolynomial (Fin n) A), f.support ⊆ S →
      ∑ m ∈ f.support, Finsupp.single (e m) (f.coeff m) =
        ∑ m ∈ S, Finsupp.single (e m) (f.coeff m) := by
    intro S f hS
    apply Finset.sum_subset hS
    intro m _ hm
    rw [MvPolynomial.notMem_support_iff.mp hm, Finsupp.single_zero]
  have hev : ∀ (f : MvPolynomial (Fin n) A) (m₀ : Fin n →₀ ℕ),
      (∑ m ∈ f.support, Finsupp.single (e m) (f.coeff m)) (e m₀) = f.coeff m₀ := by
    intro f m₀
    rw [Finsupp.finset_sum_apply]
    by_cases hm₀ : m₀ ∈ f.support
    · rw [Finset.sum_eq_single m₀]
      · rw [Finsupp.single_eq_same]
      · intro b _ hb
        rw [Finsupp.single_eq_of_ne]
        intro hbe
        exact hb (hinj hbe).symm
      · intro h; exact absurd hm₀ h
    · rw [MvPolynomial.notMem_support_iff.mp hm₀]
      apply Finset.sum_eq_zero
      intro b hb
      rw [Finsupp.single_eq_of_ne]
      intro hbe
      exact hm₀ ((hinj hbe) ▸ hb)
  refine ⟨?_, ?_⟩
  · have h1 : f₁.support ⊆ f₁.support ∪ f₂.support := Finset.subset_union_left
    have h2 : f₂.support ⊆ f₁.support ∪ f₂.support := Finset.subset_union_right
    have h12 : (f₁ + f₂).support ⊆ f₁.support ∪ f₂.support := MvPolynomial.support_add
    rw [hext _ _ h1, hext _ _ h2, hext _ _ h12, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro m _
    rw [MvPolynomial.coeff_add, Finsupp.single_add]
  · intro h
    refine MvPolynomial.ext _ _ (fun m₀ => ?_)
    have := hev f₁ m₀
    rw [h, Finsupp.coe_zero, Pi.zero_apply] at this
    rw [MvPolynomial.coeff_zero]
    exact this.symm

theorem wc_gc_laur_repr : ∀ (A : Type u) [CommRing A] (n R' : ℕ) (e : Fin R' → ℤ) (σ : Finset (Fin n)) (v : Fin R' → (Fin n → ℤ) →₀ A), (∀ j, v j ∈ Finsupp.supported A A {β : Fin n → ℤ | ∑ i, β i = e j ∧ ∀ i, i ∉ σ → 0 ≤ β i}) → ∃ (k : ℕ) (h : Fin R' → MvPolynomial (Fin n) A), (∀ j, v j = ∑ m ∈ (h j).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((h j).coeff m)) ∧ ∀ j, ∀ m ∈ (h j).support, (∑ i, (m i : ℤ)) = e j + k * σ.card :=
by
  intro A _ n R' e σ v hv
  have hsupp : ∀ j, ∀ β ∈ (v j).support, ∑ i, β i = e j ∧ ∀ i, i ∉ σ → 0 ≤ β i := by
    intro j β hβ
    exact (Finsupp.mem_supported A (v j)).mp (hv j) hβ

  have single : ∀ (c : Fin n → ℤ) (w : (Fin n → ℤ) →₀ A), (∀ β ∈ w.support, ∀ i, 0 ≤ β i + c i) →
      ∃ h : MvPolynomial (Fin n) A,
        w = ∑ m ∈ h.support, Finsupp.single (fun i => (m i : ℤ) - c i) (h.coeff m) ∧
        ∀ m ∈ h.support, ∃ β ∈ w.support, ∀ i, (m i : ℤ) = β i + c i := by
    classical
    intro c w hw
    let ν : (Fin n → ℤ) → (Fin n →₀ ℕ) :=
      fun β => Finsupp.equivFunOnFinite.symm (fun i => (β i + c i).toNat)
    have hν : ∀ β i, ν β i = (β i + c i).toNat := fun β i => rfl
    have F1 : ∀ β ∈ w.support, ∀ i, ((ν β i : ℕ) : ℤ) = β i + c i := by
      intro β hβ i
      rw [hν]
      exact Int.toNat_of_nonneg (hw β hβ i)
    have F1' : ∀ β ∈ w.support, (fun i => ((ν β i : ℕ) : ℤ) - c i) = β := by
      intro β hβ
      funext i
      rw [F1 β hβ i]
      ring
    have F2 : Set.InjOn ν (w.support : Set (Fin n → ℤ)) := by
      intro β hβ β' hβ' heq
      funext i
      have h1 := F1 β hβ i
      have h2 := F1 β' hβ' i
      rw [heq] at h1
      linarith
    obtain ⟨h, hh⟩ : ∃ h : MvPolynomial (Fin n) A,
        h = ∑ β ∈ w.support, MvPolynomial.monomial (ν β) (w β) := ⟨_, rfl⟩
    have F3 : ∀ m, h.coeff m = ∑ β ∈ w.support, if ν β = m then w β else 0 := by
      intro m
      rw [hh, MvPolynomial.coeff_sum]
      refine Finset.sum_congr rfl (fun β _ => ?_)
      rw [MvPolynomial.coeff_monomial]
    have F3a : ∀ β₀ ∈ w.support, h.coeff (ν β₀) = w β₀ := by
      intro β₀ hβ₀
      rw [F3, Finset.sum_eq_single β₀]
      · simp
      · intro β hβ hne
        rw [if_neg]
        intro heq
        exact hne (F2 hβ hβ₀ heq)
      · intro h0
        exact absurd hβ₀ h0
    have F3b : ∀ m ∈ h.support, ∃ β ∈ w.support, ν β = m := by
      intro m hm
      rw [MvPolynomial.mem_support_iff, F3] at hm
      obtain ⟨β, hβ, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hm
      refine ⟨β, hβ, ?_⟩
      by_contra hc
      exact hne (if_neg hc)
    refine ⟨h, ?_, ?_⟩
    · have hsub : h.support ⊆ w.support.image ν := by
        intro m hm
        obtain ⟨β, hβ, rfl⟩ := F3b m hm
        exact Finset.mem_image_of_mem ν hβ
      rw [Finset.sum_subset hsub, Finset.sum_image F2]
      · conv_lhs => rw [← Finsupp.sum_single w]
        rw [Finsupp.sum]
        refine Finset.sum_congr rfl (fun β hβ => ?_)
        rw [F1' β hβ, F3a β hβ]
      · intro m _ hm
        rw [MvPolynomial.notMem_support_iff.mp hm, Finsupp.single_zero]
    · intro m hm
      obtain ⟨β, hβ, rfl⟩ := F3b m hm
      exact ⟨β, hβ, F1 β hβ⟩

  obtain ⟨k, hk⟩ : ∃ k : ℕ, ∀ j, ∀ β ∈ (v j).support, ∀ i,
      0 ≤ β i + (if i ∈ σ then (k : ℤ) else 0) := by
    classical
    let U : Finset (Fin n → ℤ) := Finset.univ.biUnion (fun j => (v j).support)
    refine ⟨∑ β ∈ U, ∑ i, (-(β i)).toNat, ?_⟩
    intro j β hβ i
    have hβU : β ∈ U := Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j, hβ⟩
    have h1 : (-(β i)).toNat ≤ ∑ i', (-(β i')).toNat :=
      Finset.single_le_sum (f := fun i' => (-(β i')).toNat) (fun _ _ => Nat.zero_le _)
        (Finset.mem_univ i)
    have h2 : ∑ i', (-(β i')).toNat ≤ ∑ β ∈ U, ∑ i, (-(β i)).toNat :=
      Finset.single_le_sum (f := fun β' : Fin n → ℤ => ∑ i', (-(β' i')).toNat)
        (fun _ _ => Nat.zero_le _) hβU
    have h3 : -(β i) ≤ ((-(β i)).toNat : ℤ) := Int.self_le_toNat _
    have h4 : (((-(β i)).toNat : ℕ) : ℤ) ≤ ((∑ β ∈ U, ∑ i, (-(β i)).toNat : ℕ) : ℤ) := by
      exact_mod_cast h1.trans h2
    split_ifs with hi
    · linarith
    · simpa using (hsupp j β hβ).2 i hi
  choose h hrep hdeg using fun j => single (fun i => if i ∈ σ then (k : ℤ) else 0) (v j) (hk j)
  refine ⟨k, h, fun j => hrep j, ?_⟩
  intro j m hm
  obtain ⟨β, hβ, hmβ⟩ := hdeg j m hm
  have hmβ' : ∀ i, (m i : ℤ) = β i + if i ∈ σ then (k : ℤ) else 0 := hmβ
  rw [Finset.sum_congr rfl (fun i _ => hmβ' i), Finset.sum_add_distrib, (hsupp j β hβ).1,
    Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]
  ring

theorem wc_gc_phi_exact : ∀ (A : Type u) [CommRing A] (n R R' : ℕ) (d : Fin R → ℕ) (d' : Fin R' → ℕ) (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)) (g : Fin R' → Fin R → MvPolynomial (Fin n) A), (∀ (σ : Finset (Fin n)) (k : ℕ) (g h : MvPolynomial (Fin n) A), (∑ m ∈ g.support, g.coeff m • Finsupp.lmapDomain A A (fun β : Fin n → ℤ => β + fun i => ((m i : ℕ) : ℤ))) (∑ m ∈ h.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (h.coeff m)) = ∑ m ∈ (h * g).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((h * g).coeff m)) → (∀ (σ : Finset (Fin n)) (k : ℕ) (f₁ f₂ : MvPolynomial (Fin n) A), (∑ m ∈ (f₁ + f₂).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((f₁ + f₂).coeff m) = (∑ m ∈ f₁.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f₁.coeff m)) + ∑ m ∈ f₂.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f₂.coeff m)) ∧ ((∑ m ∈ f₁.support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (f₁.coeff m)) = 0 → f₁ = 0)) → (∀ (e : Fin R' → ℤ) (σ : Finset (Fin n)) (v : Fin R' → (Fin n → ℤ) →₀ A), (∀ j, v j ∈ Finsupp.supported A A {β : Fin n → ℤ | ∑ i, β i = e j ∧ ∀ i, i ∉ σ → 0 ≤ β i}) → ∃ (k : ℕ) (h : Fin R' → MvPolynomial (Fin n) A), (∀ j, v j = ∑ m ∈ (h j).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((h j).coeff m)) ∧ ∀ j, ∀ m ∈ (h j).support, (∑ i, (m i : ℤ)) = e j + k * σ.card) → (∀ j r, (g j r).IsHomogeneous (d' j - d r)) → (∀ j r, d' j < d r → g j r = 0) → (∀ j, g j ∈ K) → (∀ f ∈ K, ∃ h : Fin R' → MvPolynomial (Fin n) A, f = ∑ j, h j • g j) → (∀ (h : Fin R' → MvPolynomial (Fin n) A) (t : ℕ), (fun r => if d r ≤ t then MvPolynomial.homogeneousComponent (t - d r) ((∑ j, h j • g j) r) else 0) = ∑ j, (if d' j ≤ t then MvPolynomial.homogeneousComponent (t - d' j) (h j) else 0) • g j) → ∀ (w : ℤ) (σ : Finset (Fin n)), (∀ v ∈ wcLaurC A n R' d' w σ, (LinearMap.pi (fun r : Fin R => ∑ j : Fin R', (∑ m ∈ (g j r).support, (g j r).coeff m • Finsupp.lmapDomain A A (fun β : Fin n → ℤ => β + fun i => ((m i : ℕ) : ℤ))).comp (LinearMap.proj j)) : (Fin R' → (Fin n → ℤ) →₀ A) →ₗ[A] (Fin R → (Fin n → ℤ) →₀ A)) v ∈ wcLaurK A n R d K w σ) ∧ (∀ x ∈ wcLaurK A n R d K w σ, ∃ v ∈ wcLaurC A n R' d' w σ, (LinearMap.pi (fun r : Fin R => ∑ j : Fin R', (∑ m ∈ (g j r).support, (g j r).coeff m • Finsupp.lmapDomain A A (fun β : Fin n → ℤ => β + fun i => ((m i : ℕ) : ℤ))).comp (LinearMap.proj j)) : (Fin R' → (Fin n → ℤ) →₀ A) →ₗ[A] (Fin R → (Fin n → ℤ) →₀ A)) v = x) ∧ (∀ v ∈ wcLaurC A n R' d' w σ, (LinearMap.pi (fun r : Fin R => ∑ j : Fin R', (∑ m ∈ (g j r).support, (g j r).coeff m • Finsupp.lmapDomain A A (fun β : Fin n → ℤ => β + fun i => ((m i : ℕ) : ℤ))).comp (LinearMap.proj j)) : (Fin R' → (Fin n → ℤ) →₀ A) →ₗ[A] (Fin R → (Fin n → ℤ) →₀ A)) v = 0 → v ∈ wcLaurK A n R' d' (LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g)) w σ) ∧ (∀ v ∈ wcLaurK A n R' d' (LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g)) w σ, (LinearMap.pi (fun r : Fin R => ∑ j : Fin R', (∑ m ∈ (g j r).support, (g j r).coeff m • Finsupp.lmapDomain A A (fun β : Fin n → ℤ => β + fun i => ((m i : ℕ) : ℤ))).comp (LinearMap.proj j)) : (Fin R' → (Fin n → ℤ) →₀ A) →ₗ[A] (Fin R → (Fin n → ℤ) →₀ A)) v = 0) :=
by
  classical
  intro A _ n R R' d d' K g Hmul Hadd Hrepr hg1 hg2 hg3 hg4 h7 w σ
  set Φ : (Fin R' → (Fin n → ℤ) →₀ A) →ₗ[A] (Fin R → (Fin n → ℤ) →₀ A) :=
    LinearMap.pi (fun r : Fin R => ∑ j : Fin R', (∑ m ∈ (g j r).support, (g j r).coeff m •
      Finsupp.lmapDomain A A (fun β : Fin n → ℤ => β + fun i => ((m i : ℕ) : ℤ))).comp
        (LinearMap.proj j)) with hΦ

  have hLsum : ∀ (k : ℕ) (s : Finset (Fin R')) (p : Fin R' → MvPolynomial (Fin n) A),
      (∑ m ∈ (∑ j ∈ s, p j).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        ((∑ j ∈ s, p j).coeff m)) = ∑ j ∈ s, ∑ m ∈ (p j).support,
          Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((p j).coeff m) := by
    intro k s p
    induction s using Finset.induction_on with
    | empty => simp
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, (Hadd σ k _ _).1, ih]

  have hstar : ∀ (k : ℕ) (h : Fin R' → MvPolynomial (Fin n) A),
      Φ (fun j => ∑ m ∈ (h j).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        ((h j).coeff m)) = fun r => ∑ m ∈ ((∑ j, h j • g j) r).support,
          Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (((∑ j, h j • g j) r).coeff m) := by
    intro k h
    funext r
    have e : (∑ j, h j • g j) r = ∑ j, h j * g j r := by
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    rw [hΦ]
    simp only [LinearMap.pi_apply]
    rw [LinearMap.sum_apply]
    simp only [LinearMap.comp_apply, LinearMap.proj_apply]
    rw [e, hLsum k Finset.univ (fun j => h j * g j r)]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    exact Hmul σ k (g j r) (h j)

  have hdeg2 : ∀ (E : ℤ) (h : Fin R' → MvPolynomial (Fin n) A),
      (∀ j, ∀ m ∈ (h j).support, (∑ i, (m i : ℤ)) = E - d' j) →
      ∀ r, ∀ m ∈ ((∑ j, h j • g j) r).support, (∑ i, (m i : ℤ)) = E - d r := by
    intro E h hh r m hm
    have e : (∑ j, h j • g j) r = ∑ j, h j * g j r := by
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    rw [e] at hm
    obtain ⟨j, -, hj⟩ := Finset.mem_biUnion.mp (MvPolynomial.support_sum hm)
    obtain ⟨m1, hm1, m2, hm2, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul _ _ hj)
    have hne : g j r ≠ 0 := by
      rintro h0
      rw [h0] at hm2
      simp at hm2
    have hle : d r ≤ d' j := by
      by_contra hlt
      exact hne (hg2 j r (by omega))
    have hdeg : Finsupp.degree m2 = d' j - d r := by
      by_contra hc
      exact (MvPolynomial.mem_support_iff.mp hm2) ((hg1 j r).coeff_eq_zero hc)
    have hsum2 : (∑ i, (m2 i : ℤ)) = (d' j : ℤ) - d r := by
      rw [Finsupp.degree_eq_sum] at hdeg
      have h3 := congrArg (fun x : ℕ => (x : ℤ)) hdeg
      simp only [Nat.cast_sum] at h3
      rw [h3, Nat.cast_sub hle]
    have h1 := hh j m1 hm1
    simp only [Finsupp.coe_add, Pi.add_apply, Nat.cast_add, Finset.sum_add_distrib]
    rw [h1, hsum2]
    ring

  have hdeg3 : ∀ (f : Fin R → MvPolynomial (Fin n) A) (D : ℤ),
      (∀ r, ∀ m ∈ (f r).support, (∑ i, (m i : ℤ)) = D - d r) →
      (D < 0 → f = 0) ∧ f = fun r => if d r ≤ D.toNat then
        MvPolynomial.homogeneousComponent (D.toNat - d r) (f r) else 0 := by
    intro f D hf
    have ha : ∀ r, D - d r < 0 → f r = 0 := by
      intro r hr
      rw [← MvPolynomial.support_eq_empty, Finset.eq_empty_iff_forall_notMem]
      intro m hm
      have h1 := hf r m hm
      have h0 : (0 : ℤ) ≤ ∑ i, (m i : ℤ) := Finset.sum_nonneg (fun i _ => Nat.cast_nonneg _)
      omega
    refine ⟨fun hD => funext fun r => ha r (by omega), funext fun r => ?_⟩
    by_cases hD : 0 ≤ D
    · have ht : ((D.toNat : ℕ) : ℤ) = D := Int.toNat_of_nonneg hD
      split_ifs with hle
      · symm
        ext m
        rw [MvPolynomial.coeff_homogeneousComponent]
        split_ifs with hdm
        · rfl
        · by_contra hc
          apply hdm
          have hm' : m ∈ (f r).support := MvPolynomial.mem_support_iff.mpr (fun h => hc h.symm)
          have h1 := hf r m hm'
          rw [Finsupp.degree_eq_sum]
          have h2 : ((∑ i, m i : ℕ) : ℤ) = ((D.toNat - d r : ℕ) : ℤ) := by
            rw [Nat.cast_sum, Nat.cast_sub hle, ht]
            exact h1
          exact_mod_cast h2
      · exact ha r (by omega)
    · split_ifs
      · rw [ha r (by omega), map_zero]
      · exact ha r (by omega)

  have hrep : ∀ v ∈ wcLaurC A n R' d' w σ, ∃ (k : ℕ) (h : Fin R' → MvPolynomial (Fin n) A),
      v = (fun j => ∑ m ∈ (h j).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        ((h j).coeff m)) ∧ ∀ j, ∀ m ∈ (h j).support, (∑ i, (m i : ℤ)) = w + k * σ.card - d' j := by
    intro v hv
    obtain ⟨k, h, h1, h2⟩ := Hrepr (fun j => w - (d' j : ℤ)) σ v hv
    refine ⟨k, h, funext h1, fun j m hm => ?_⟩
    rw [h2 j m hm]
    ring

  have hC : ∀ (k : ℕ) (p : Fin R' → MvPolynomial (Fin n) A),
      (∀ j, ∀ m ∈ (p j).support, (∑ i, (m i : ℤ)) = w + k * σ.card - d' j) →
      (fun j => ∑ m ∈ (p j).support, Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
        ((p j).coeff m)) ∈ wcLaurC A n R' d' w σ := by
    intro k p hp j
    refine Submodule.sum_mem _ (fun m hm => Finsupp.single_mem_supported A _ ?_)
    refine ⟨?_, fun i hi => by simp [hi]⟩
    have hs : (∑ i, (if i ∈ σ then (k : ℤ) else 0)) = σ.card * k := by
      rw [Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]
    rw [Finset.sum_sub_distrib, hs, hp j m hm]
    ring
  refine ⟨fun v hv => ?_, fun x hx => ?_, fun v hv hΦv => ?_, fun v hv => ?_⟩
  ·
    obtain ⟨k, h, rfl, hh⟩ := hrep v hv
    rw [hstar k h]
    exact Submodule.subset_span ⟨k, ∑ j, h j • g j,
      Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (hg3 j)),
      hdeg2 (w + k * σ.card) h hh, rfl⟩
  ·
    unfold wcLaurK at hx
    induction hx using Submodule.span_induction with
    | mem x hx' =>
      obtain ⟨k, f, hfK, hfdeg, rfl⟩ := hx'
      obtain ⟨hneg, htr⟩ := hdeg3 f (w + k * σ.card) hfdeg
      by_cases hD0 : w + (k : ℤ) * σ.card < 0
      · have hf0 := hneg hD0
        refine ⟨0, by intro j; exact Submodule.zero_mem _, ?_⟩
        rw [map_zero, hf0]
        funext r
        simp
      · obtain ⟨h, hfh⟩ := hg4 f hfK
        obtain ⟨t, ht_def⟩ : ∃ t : ℕ, t = (w + (k : ℤ) * σ.card).toNat := ⟨_, rfl⟩
        rw [← ht_def] at htr
        have ht : (t : ℤ) = w + (k : ℤ) * σ.card := by
          rw [ht_def]
          exact Int.toNat_of_nonneg (by omega)
        have hE1 : f = ∑ j, (if d' j ≤ t then MvPolynomial.homogeneousComponent (t - d' j) (h j) else 0) • g j := by
          rw [← h7 h t, ← hfh]
          exact htr
        refine ⟨fun j => ∑ m ∈ (if d' j ≤ t then MvPolynomial.homogeneousComponent (t - d' j) (h j) else 0).support,
          Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)
            ((if d' j ≤ t then MvPolynomial.homogeneousComponent (t - d' j) (h j) else 0).coeff m), ?_, ?_⟩
        · refine hC k (fun j => if d' j ≤ t then
            MvPolynomial.homogeneousComponent (t - d' j) (h j) else 0) ?_
          intro j m hm
          by_cases hj : d' j ≤ t
          · simp only [hj, if_true] at hm
            rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_homogeneousComponent] at hm
            split_ifs at hm with hdm
            · rw [Finsupp.degree_eq_sum] at hdm
              have h2 : ((∑ i, m i : ℕ) : ℤ) = ((t - d' j : ℕ) : ℤ) := by rw [hdm]
              rw [Nat.cast_sum, Nat.cast_sub hj, ht] at h2
              rw [h2]
            · exact absurd rfl hm
          · simp [hj] at hm
        · rw [hstar k (fun j => if d' j ≤ t then MvPolynomial.homogeneousComponent (t - d' j) (h j) else 0),
            ← hE1]
    | zero => exact ⟨0, by intro j; exact Submodule.zero_mem _, map_zero Φ⟩
    | add x y _ _ hx hy =>
      obtain ⟨v1, hv1, e1⟩ := hx
      obtain ⟨v2, hv2, e2⟩ := hy
      exact ⟨v1 + v2, by intro j; exact Submodule.add_mem _ (hv1 j) (hv2 j), by rw [map_add, e1, e2]⟩
    | smul a x _ hx =>
      obtain ⟨v, hv, e⟩ := hx
      exact ⟨a • v, by intro j; exact Submodule.smul_mem _ a (hv j), by rw [map_smul, e]⟩
  ·
    obtain ⟨k, h, rfl, hh⟩ := hrep v hv
    rw [hstar k h] at hΦv
    have hF : ∑ j, h j • g j = 0 := by
      funext r
      exact (Hadd σ k ((∑ j, h j • g j) r) 0).2 (congrFun hΦv r)
    refine Submodule.subset_span ⟨k, h, ?_, hh, rfl⟩
    rw [LinearMap.mem_ker, Fintype.linearCombination_apply]
    exact hF
  ·
    have hle : wcLaurK A n R' d' (LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g)) w σ
        ≤ LinearMap.ker Φ := by
      apply Submodule.span_le.mpr
      rintro _ ⟨k, f, hf, -, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker, hstar k f]
      rw [LinearMap.mem_ker, Fintype.linearCombination_apply] at hf
      rw [hf]
      funext r
      simp
    exact hle hv

theorem wc_gc_step : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (n R R' : ℕ) (d : Fin R → ℕ) (d' : Fin R' → ℕ) (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)) (K' : Submodule (MvPolynomial (Fin n) A) (Fin R' → MvPolynomial (Fin n) A)) (Φ : (Fin R' → (Fin n → ℤ) →₀ A) →ₗ[A] (Fin R → (Fin n → ℤ) →₀ A)) (p : ℕ) (w : ℤ), (∀ (V : Type u) [AddCommGroup V] [Module A V] (N₀ : Submodule A V) (ι : Type u) (F : ι → V) (k : ℕ) (c : Fin k → V), (∀ i, ∃ b : Fin k → A, F i - ∑ l, b l • c l ∈ N₀) → ∃ (m : ℕ) (s : Fin m → ι), ∀ i, ∃ b : Fin m → A, F i - ∑ j, b j • F (s j) ∈ N₀) → (∀ (z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) (τ : Finset (Fin n)), wcAltD (A := A) n (wcAltD (A := A) n z) τ = 0) → (∀ σ, ∀ x ∈ wcLaurK A n R d K w σ, x ∈ wcLaurC A n R d w σ) → (∀ σ, ∀ v ∈ wcLaurC A n R' d' w σ, Φ v ∈ wcLaurK A n R d K w σ) → (∀ σ, ∀ x ∈ wcLaurK A n R d K w σ, ∃ v ∈ wcLaurC A n R' d' w σ, Φ v = x) → (∀ σ, ∀ v ∈ wcLaurC A n R' d' w σ, Φ v = 0 → v ∈ wcLaurK A n R' d' K' w σ) → (∀ σ, ∀ v ∈ wcLaurK A n R' d' K' w σ, Φ v = 0) → wcGradedH A n R' d' K' (p + 1) w → (∃ (k : ℕ) (c : Fin k → Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A), ∀ z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A, (∀ σ, (σ.card = p + 1 → z σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → z σ = 0)) → (∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n z τ = 0) → ∃ (a : Fin k → A) (y : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A), (∀ σ, (σ.card = p → y σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p → y σ = 0)) ∧ (p = 0 → y = 0) ∧ ∀ σ : Finset (Fin n), σ.card = p + 1 → z σ - ∑ l, a l • c l σ - wcAltD (A := A) n y σ = 0) → wcGradedH A n R d K p w :=
by
  classical
  intro A _ _ n R R' d d' K K' Φ p w H11 H2 H3 Hin Hsurj Hker Hker' IH Free
  obtain ⟨kF, cF, hF⟩ := Free

  have dzero : ∀ {V : Type u} [AddCommGroup V] [Module A V] (τ : Finset (Fin n)),
      wcAltD (A := A) n (fun _ => (0 : V)) τ = 0 := by
    intro V _ _ τ
    simp [wcAltD]
  have dadd : ∀ {V : Type u} [AddCommGroup V] [Module A V] (z₁ z₂ : Finset (Fin n) → V)
      (τ : Finset (Fin n)), wcAltD (A := A) n (fun σ => z₁ σ + z₂ σ) τ =
        wcAltD (A := A) n z₁ τ + wcAltD (A := A) n z₂ τ := by
    intro V _ _ z₁ z₂ τ
    simp only [wcAltD, smul_add, Finset.sum_add_distrib]
  have dsub : ∀ {V : Type u} [AddCommGroup V] [Module A V] (z₁ z₂ : Finset (Fin n) → V)
      (τ : Finset (Fin n)), wcAltD (A := A) n (fun σ => z₁ σ - z₂ σ) τ =
        wcAltD (A := A) n z₁ τ - wcAltD (A := A) n z₂ τ := by
    intro V _ _ z₁ z₂ τ
    simp only [wcAltD, smul_sub, Finset.sum_sub_distrib]
  have dsmul : ∀ {V : Type u} [AddCommGroup V] [Module A V] (a : A) (z : Finset (Fin n) → V)
      (τ : Finset (Fin n)), wcAltD (A := A) n (fun σ => a • z σ) τ =
        a • wcAltD (A := A) n z τ := by
    intro V _ _ a z τ
    simp only [wcAltD, Finset.smul_sum]
    exact Finset.sum_congr rfl (fun i _ => smul_comm _ _ _)
  have dsum : ∀ {V : Type u} [AddCommGroup V] [Module A V] (m : ℕ) (b : Fin m → A)
      (zs : Fin m → Finset (Fin n) → V) (τ : Finset (Fin n)),
      wcAltD (A := A) n (fun σ => ∑ j, b j • zs j σ) τ = ∑ j, b j • wcAltD (A := A) n (zs j) τ := by
    intro V _ _ m b zs τ
    simp only [wcAltD, Finset.smul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => smul_comm _ _ _))
  have dmap : ∀ {V W : Type u} [AddCommGroup V] [Module A V] [AddCommGroup W] [Module A W]
      (f : V →ₗ[A] W) (z : Finset (Fin n) → V) (τ : Finset (Fin n)),
      wcAltD (A := A) n (fun σ => f (z σ)) τ = f (wcAltD (A := A) n z τ) := by
    intro V W _ _ _ _ f z τ
    simp only [wcAltD, map_sum, map_smul]
  have dsupp : ∀ {V : Type u} [AddCommGroup V] [Module A V] (q : ℕ) (z : Finset (Fin n) → V),
      (∀ σ : Finset (Fin n), σ.card ≠ q + 1 → z σ = 0) →
      ∀ τ : Finset (Fin n), τ.card ≠ q + 2 → wcAltD (A := A) n z τ = 0 := by
    intro V _ _ q z hz τ hτ
    apply Finset.sum_eq_zero
    intro i hi
    have hpos := Finset.card_pos.mpr ⟨i, hi⟩
    rw [hz (τ.erase i) (by rw [Finset.card_erase_of_mem hi]; omega), smul_zero]

  have hPex : ∀ (R₀ : ℕ) (d₀ : Fin R₀ → ℕ) (σ : Finset (Fin n)),
      ∃ P : Submodule A (Fin R₀ → (Fin n → ℤ) →₀ A), ∀ v, v ∈ P ↔ v ∈ wcLaurC A n R₀ d₀ w σ := by
    intro R₀ d₀ σ
    refine ⟨Submodule.pi Set.univ (fun r => Finsupp.supported A A
      {β : Fin n → ℤ | ∑ i, β i = w - d₀ r ∧ ∀ i, i ∉ σ → 0 ≤ β i}), fun v => ?_⟩
    simp only [Submodule.mem_pi, Set.mem_univ, true_implies]
    exact Iff.rfl
  have hmono : ∀ (R₀ : ℕ) (d₀ : Fin R₀ → ℕ) (σ σ' : Finset (Fin n)), σ ⊆ σ' →
      ∀ v ∈ wcLaurC A n R₀ d₀ w σ, v ∈ wcLaurC A n R₀ d₀ w σ' := by
    intro R₀ d₀ σ σ' hss v hv r
    refine Finsupp.supported_mono ?_ (hv r)
    rintro β ⟨h1, h2⟩
    exact ⟨h1, fun i hi => h2 i (fun h => hi (hss h))⟩

  obtain ⟨N₀, hN₀⟩ : ∃ N₀ : Submodule A (Finset (Fin n) → Fin R' → (Fin n → ℤ) →₀ A), ∀ x,
      x ∈ N₀ ↔ ∃ y : Finset (Fin n) → Fin R' → (Fin n → ℤ) →₀ A,
        (∀ σ, (σ.card = p + 1 → y σ ∈ wcLaurC A n R' d' w σ) ∧ (σ.card ≠ p + 1 → y σ = 0)) ∧
        ∀ σ : Finset (Fin n), σ.card = p + 1 + 1 →
          x σ - wcAltD (A := A) n y σ ∈ wcLaurK A n R' d' K' w σ := by
    let S : Set (Finset (Fin n) → Fin R' → (Fin n → ℤ) →₀ A) :=
      {x | ∃ y : Finset (Fin n) → Fin R' → (Fin n → ℤ) →₀ A,
        (∀ σ, (σ.card = p + 1 → y σ ∈ wcLaurC A n R' d' w σ) ∧ (σ.card ≠ p + 1 → y σ = 0)) ∧
        ∀ σ : Finset (Fin n), σ.card = p + 1 + 1 →
          x σ - wcAltD (A := A) n y σ ∈ wcLaurK A n R' d' K' w σ}
    refine ⟨{ carrier := S, add_mem' := ?_, zero_mem' := ?_, smul_mem' := ?_ },
      fun x => Iff.rfl⟩
    · rintro x₁ x₂ ⟨y₁, hy₁, h₁⟩ ⟨y₂, hy₂, h₂⟩
      refine ⟨fun σ => y₁ σ + y₂ σ, fun σ => ⟨fun hσ => ?_, fun hσ => ?_⟩, fun σ hσ => ?_⟩
      · obtain ⟨P, hP⟩ := hPex R' d' σ
        exact (hP _).mp (P.add_mem ((hP _).mpr ((hy₁ σ).1 hσ)) ((hP _).mpr ((hy₂ σ).1 hσ)))
      · show y₁ σ + y₂ σ = 0
        rw [(hy₁ σ).2 hσ, (hy₂ σ).2 hσ, add_zero]
      · have e : (x₁ + x₂) σ - wcAltD (A := A) n (fun σ => y₁ σ + y₂ σ) σ =
            (x₁ σ - wcAltD (A := A) n y₁ σ) + (x₂ σ - wcAltD (A := A) n y₂ σ) := by
          rw [dadd y₁ y₂ σ, Pi.add_apply]; abel
        rw [e]
        exact add_mem (h₁ σ hσ) (h₂ σ hσ)
    · refine ⟨fun _ => 0, fun σ => ⟨fun _ => ?_, fun _ => rfl⟩, fun σ _ => ?_⟩
      · obtain ⟨P, hP⟩ := hPex R' d' σ
        exact (hP _).mp P.zero_mem
      · have e : (0 : Finset (Fin n) → Fin R' → (Fin n → ℤ) →₀ A) σ -
            wcAltD (A := A) n (fun _ => (0 : Fin R' → (Fin n → ℤ) →₀ A)) σ = 0 := by
          rw [dzero σ]; simp
        rw [e]
        exact Submodule.zero_mem _
    · rintro a x ⟨y, hy, h⟩
      refine ⟨fun σ => a • y σ, fun σ => ⟨fun hσ => ?_, fun hσ => ?_⟩, fun σ hσ => ?_⟩
      · obtain ⟨P, hP⟩ := hPex R' d' σ
        exact (hP _).mp (P.smul_mem a ((hP _).mpr ((hy σ).1 hσ)))
      · show a • y σ = 0
        rw [(hy σ).2 hσ, smul_zero]
      · have e : (a • x) σ - wcAltD (A := A) n (fun σ => a • y σ) σ =
            a • (x σ - wcAltD (A := A) n y σ) := by
          rw [dsmul a y σ, Pi.smul_apply, smul_sub]
        rw [e]
        exact Submodule.smul_mem _ a (h σ hσ)

  obtain ⟨k', c', hIH⟩ := IH
  let ι := {q : (Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A) ×
      (Finset (Fin n) → Fin R' → (Fin n → ℤ) →₀ A) //
    (∀ σ, (σ.card = p + 1 → q.1 σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → q.1 σ = 0)) ∧
    (∀ σ, (σ.card = p + 1 + 1 → q.2 σ ∈ wcLaurC A n R' d' w σ) ∧
      (σ.card ≠ p + 1 + 1 → q.2 σ = 0)) ∧
    (∀ τ : Finset (Fin n), τ.card = p + 1 + 2 →
      wcAltD (A := A) n q.2 τ ∈ wcLaurK A n R' d' K' w τ) ∧
    (∀ τ, Φ (q.2 τ) = wcAltD (A := A) n q.1 τ)}
  have hspan : ∀ i : ι, ∃ b : Fin k' → A, i.1.2 - ∑ l, b l • c' l ∈ N₀ := by
    intro i
    obtain ⟨a', y', hy', _, hrel⟩ := hIH i.1.2 i.2.2.1 i.2.2.2.1
    refine ⟨a', (hN₀ _).mpr ⟨y', hy', fun σ hσ => ?_⟩⟩
    simp only [Pi.sub_apply, Finset.sum_apply, Pi.smul_apply]
    exact hrel σ hσ
  obtain ⟨m, s, hs⟩ := H11 (Finset (Fin n) → Fin R' → (Fin n → ℤ) →₀ A) N₀ ι (fun i => i.1.2)
    k' c' hspan
  refine ⟨kF + m, Fin.append cF (fun j => (s j).1.1), ?_⟩
  intro z hz hcoc

  have hlift : ∀ τ : Finset (Fin n), ∃ v : Fin R' → (Fin n → ℤ) →₀ A,
      (τ.card = p + 2 → v ∈ wcLaurC A n R' d' w τ) ∧ Φ v = wcAltD (A := A) n z τ ∧
        (τ.card ≠ p + 2 → v = 0) := by
    intro τ
    by_cases hτ : τ.card = p + 2
    · obtain ⟨v, hv, hΦ⟩ := Hsurj τ _ (hcoc τ hτ)
      exact ⟨v, fun _ => hv, hΦ, fun h => absurd hτ h⟩
    · refine ⟨0, fun h => absurd h hτ, ?_, fun _ => rfl⟩
      rw [map_zero, dsupp p z (fun σ hσ => (hz σ).2 hσ) τ hτ]
  choose u hu1 hΦu hu0 using hlift
  have hu : ∀ σ, (σ.card = p + 1 + 1 → u σ ∈ wcLaurC A n R' d' w σ) ∧
      (σ.card ≠ p + 1 + 1 → u σ = 0) :=
    fun σ => ⟨fun h => hu1 σ (by omega), fun h => hu0 σ (by omega)⟩
  have hucoc : ∀ ρ : Finset (Fin n), ρ.card = p + 1 + 2 →
      wcAltD (A := A) n u ρ ∈ wcLaurK A n R' d' K' w ρ := by
    intro ρ hρ
    refine Hker ρ _ ?_ ?_
    · obtain ⟨P, hP⟩ := hPex R' d' ρ
      apply (hP _).mp
      simp only [wcAltD]
      apply Submodule.sum_mem
      intro i hi
      apply Submodule.smul_mem
      apply (hP _).mpr
      have hc : (ρ.erase i).card = p + 2 := by rw [Finset.card_erase_of_mem hi]; omega
      exact hmono R' d' _ _ (Finset.erase_subset i ρ) _ (hu1 _ hc)
    · rw [← dmap Φ u ρ, show (fun σ => Φ (u σ)) = wcAltD (A := A) n z from funext hΦu, H2]
  obtain ⟨b, hb⟩ := hs ⟨(z, u), hz, hu, hucoc, hΦu⟩
  have hb' : u - ∑ j, b j • (s j).1.2 ∈ N₀ := hb
  obtain ⟨y', hy', hκ⟩ := (hN₀ _).mp hb'

  obtain ⟨x, hxdef⟩ : ∃ x : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A,
      ∀ σ, x σ = z σ - ∑ j, b j • (s j).1.1 σ - Φ (y' σ) := ⟨_, fun σ => rfl⟩
  have hx : ∀ σ, (σ.card = p + 1 → x σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → x σ = 0) := by
    intro σ
    constructor
    · intro hσ
      obtain ⟨P, hP⟩ := hPex R d σ
      rw [hxdef]
      apply (hP _).mp
      refine sub_mem (sub_mem ((hP _).mpr ((hz σ).1 hσ))
        (sum_mem fun j _ => Submodule.smul_mem _ _ ((hP _).mpr (((s j).2.1 σ).1 hσ))))
        ((hP _).mpr (H3 σ _ (Hin σ _ ((hy' σ).1 hσ))))
    · intro hσ
      have h1 : ∀ j, (s j).1.1 σ = 0 := fun j => ((s j).2.1 σ).2 hσ
      rw [hxdef, (hz σ).2 hσ, (hy' σ).2 hσ]
      simp only [h1, smul_zero, Finset.sum_const_zero, map_zero, sub_zero]
  have hxc : ∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n x τ = 0 := by
    intro τ hτ
    have ex : x = fun σ => z σ - ∑ j, b j • (s j).1.1 σ - Φ (y' σ) := funext hxdef
    have h1 := dsub (fun σ => z σ - ∑ j, b j • (s j).1.1 σ) (fun σ => Φ (y' σ)) τ
    have h2 := dsub z (fun σ => ∑ j, b j • (s j).1.1 σ) τ
    have h3 := dsum m b (fun j => (s j).1.1) τ
    have h4 := dmap Φ y' τ
    rw [ex, h1, h2, h3, h4, ← hΦu τ]
    have hj : ∀ j, wcAltD (A := A) n (s j).1.1 τ = Φ ((s j).1.2 τ) :=
      fun j => ((s j).2.2.2.2 τ).symm
    simp only [hj]
    have hk := Hker' τ _ (hκ τ (by omega))
    simp only [Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, map_sub, map_sum, map_smul] at hk
    exact hk
  obtain ⟨a, y, hy, hy0, hrel⟩ := hF x hx hxc
  refine ⟨Fin.append a b, y, hy, hy0, fun σ hσ => ?_⟩
  rw [Fin.sum_univ_add]
  simp only [Fin.append_left, Fin.append_right]
  have h1 := hrel σ hσ
  rw [hxdef] at h1
  have e : z σ - (∑ i, a i • cF i σ + ∑ j, b j • (s j).1.1 σ) - wcAltD (A := A) n y σ =
      Φ (y' σ) := by
    have h2 : z σ - (∑ i, a i • cF i σ + ∑ j, b j • (s j).1.1 σ) - wcAltD (A := A) n y σ -
        Φ (y' σ) = z σ - ∑ j, b j • (s j).1.1 σ - Φ (y' σ) - ∑ i, a i • cF i σ -
          wcAltD (A := A) n y σ := by abel
    rw [← sub_eq_zero, h2, h1]
  rw [e]
  exact Hin σ _ ((hy' σ).1 hσ)

theorem wc_gc_cone_identity : ∀ (A : Type u) [CommRing A] (V : Type u) [AddCommGroup V] [Module A V] (n : ℕ) (z : Finset (Fin n) → V) (i0 : Fin n) (s : Finset (Fin n)), wcAltD (A := A) n (fun ρ => if i0 ∈ ρ then 0 else ((-1 : A) ^ (ρ.filter (· < i0)).card) • z (insert i0 ρ)) s + (if i0 ∈ s then 0 else ((-1 : A) ^ (s.filter (· < i0)).card) • wcAltD (A := A) n z (insert i0 s)) = z s :=
by
  intro A _ V _ _ n z i0 s
  have hP : ∀ k : ℕ, (-1 : A) ^ k * (-1 : A) ^ k = 1 := fun k => by
    rw [← mul_pow, neg_one_mul, neg_neg, one_pow]

  have hsign : ∀ j ∈ s, i0 ∉ s →
      (-1 : A) ^ (s.filter (· < j)).card * (-1 : A) ^ ((s.erase j).filter (· < i0)).card +
        (-1 : A) ^ (s.filter (· < i0)).card * (-1 : A) ^ ((insert i0 s).filter (· < j)).card
        = 0 := by
    intro j hj hi0
    have hne : j ≠ i0 := fun h => hi0 (h ▸ hj)
    rw [Finset.filter_erase, Finset.filter_insert]
    rcases lt_or_gt_of_ne hne with h | h
    · have hmem : j ∈ s.filter (· < i0) := Finset.mem_filter.mpr ⟨hj, h⟩
      rw [if_neg (not_lt.mpr h.le), Finset.card_erase_of_mem hmem]
      obtain ⟨c, hc⟩ : ∃ c, (s.filter (· < i0)).card = c + 1 :=
        Nat.exists_eq_add_of_le' (Finset.card_pos.mpr ⟨j, hmem⟩)
      rw [hc, Nat.add_sub_cancel, pow_succ]
      ring
    · have hnm : j ∉ s.filter (· < i0) := fun hm => lt_asymm h (Finset.mem_filter.mp hm).2
      have hni : i0 ∉ s.filter (· < j) := fun hm => hi0 (Finset.mem_filter.mp hm).1
      rw [if_pos h, Finset.erase_eq_of_notMem hnm, Finset.card_insert_of_notMem hni, pow_succ]
      ring
  simp only [wcAltD]
  by_cases hi0 : i0 ∈ s
  · rw [if_pos hi0, add_zero, Finset.sum_eq_single_of_mem i0 hi0]
    · have hf : (s.erase i0).filter (· < i0) = s.filter (· < i0) := by
        rw [Finset.filter_erase]
        exact Finset.erase_eq_of_notMem (by simp)
      rw [if_neg (Finset.notMem_erase i0 s), Finset.insert_erase hi0, smul_smul, hf, hP,
        one_smul]
    · intro j _ hj
      rw [if_pos (Finset.mem_erase.mpr ⟨Ne.symm hj, hi0⟩), smul_zero]
  · have hfi : (insert i0 s).filter (· < i0) = s.filter (· < i0) := by
      rw [Finset.filter_insert, if_neg (lt_irrefl i0)]
    rw [if_neg hi0, Finset.sum_insert hi0, Finset.erase_insert hi0, hfi, smul_add, smul_smul,
      hP, one_smul, Finset.smul_sum]
    have h1 : ∀ j ∈ s, ((-1 : A) ^ (s.filter (· < j)).card) •
        (if i0 ∈ s.erase j then 0 else
          ((-1 : A) ^ ((s.erase j).filter (· < i0)).card) • z (insert i0 (s.erase j))) =
        ((-1 : A) ^ (s.filter (· < j)).card * (-1 : A) ^ ((s.erase j).filter (· < i0)).card) •
          z (insert i0 (s.erase j)) := by
      intro j _
      rw [if_neg (fun hm => hi0 (Finset.mem_of_mem_erase hm)), smul_smul]
    have h2 : ∀ j ∈ s, ((-1 : A) ^ (s.filter (· < i0)).card) •
        (((-1 : A) ^ ((insert i0 s).filter (· < j)).card) • z ((insert i0 s).erase j)) =
        ((-1 : A) ^ (s.filter (· < i0)).card * (-1 : A) ^ ((insert i0 s).filter (· < j)).card) •
          z (insert i0 (s.erase j)) := by
      intro j hj
      have hne : i0 ≠ j := fun h => hi0 (h ▸ hj)
      rw [Finset.erase_insert_of_ne hne, smul_smul]
    rw [Finset.sum_congr rfl h1, Finset.sum_congr rfl h2, add_left_comm,
      ← Finset.sum_add_distrib,
      Finset.sum_eq_zero (fun j hj => by rw [← add_smul, hsign j hj hi0, zero_smul]), add_zero]

theorem wc_gc_noeth_subfamily : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (V : Type u) [AddCommGroup V] [Module A V] (N₀ : Submodule A V) (ι : Type u) (F : ι → V) (k : ℕ) (c : Fin k → V), (∀ i, ∃ b : Fin k → A, F i - ∑ l, b l • c l ∈ N₀) → ∃ (m : ℕ) (s : Fin m → ι), ∀ i, ∃ b : Fin m → A, F i - ∑ j, b j • F (s j) ∈ N₀ :=
by
  classical
  intro A _ _ V _ _ N₀ ι F k c hF
  let L : (Fin k → A) →ₗ[A] (V ⧸ N₀) := Fintype.linearCombination A (fun l => N₀.mkQ (c l))
  let P : Submodule A (V ⧸ N₀) := Submodule.span A (Set.range (fun i => N₀.mkQ (F i)))
  have hPL : P ≤ LinearMap.range L := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    obtain ⟨b, hb⟩ := hF i
    refine ⟨b, ?_⟩
    have h0 : N₀.mkQ (F i - ∑ l, b l • c l) = 0 := (Submodule.Quotient.mk_eq_zero N₀).mpr hb
    rw [map_sub, map_sum, sub_eq_zero] at h0
    simp only [map_smul] at h0
    rw [Fintype.linearCombination_apply]
    exact h0.symm
  have hfgS : (Submodule.comap L P).FG := IsNoetherian.noetherian _
  have hPfg : P.FG := by
    have := hfgS.map L
    rwa [Submodule.map_comap_eq_of_le hPL] at this
  obtain ⟨T, hTsub, hTspan⟩ := (Submodule.fg_span_iff_fg_span_finset_subset _).mp hPfg
  have hpre : ∀ q : T, ∃ i, N₀.mkQ (F i) = q := fun q => hTsub q.2
  choose g hg using hpre
  refine ⟨T.card, fun j => g (T.equivFin.symm j), fun i => ?_⟩
  have hle : P ≤ Submodule.span A
      (Set.range (fun j : Fin T.card => N₀.mkQ (F (g (T.equivFin.symm j))))) := by
    change Submodule.span A _ ≤ _
    rw [hTspan, Submodule.span_le]
    intro q hq
    apply Submodule.subset_span
    refine ⟨T.equivFin ⟨q, hq⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hg ⟨q, hq⟩
  have hmem : N₀.mkQ (F i) ∈ P := Submodule.subset_span ⟨i, rfl⟩
  obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp (hle hmem)
  refine ⟨b, ?_⟩
  apply (Submodule.Quotient.mk_eq_zero N₀).mp
  change N₀.mkQ _ = 0
  rw [map_sub, map_sum, sub_eq_zero]
  simp only [map_smul]
  exact hb.symm

theorem wc_graded_cech_fg : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (n R : ℕ) (d : Fin R → ℕ) (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)), (∀ f ∈ K, ∀ t : ℕ, (fun r => if d r ≤ t then MvPolynomial.homogeneousComponent (t - d r) (f r) else 0) ∈ K) → ∀ (p : ℕ) (w : ℤ), wcGradedH A n R d K p w :=
by
  classical
  intro A _ _ n

  have hbase : ∀ (p : ℕ), n ≤ p → ∀ (R : ℕ) (d : Fin R → ℕ)
      (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)) (w : ℤ),
      wcGradedH A n R d K p w := by
    intro p hp R d K w
    refine ⟨0, Fin.elim0, fun z _ _ => ⟨Fin.elim0, 0, fun σ => ⟨fun _ => ?_, fun _ => rfl⟩,
      fun _ => rfl, fun σ hσ => ?_⟩⟩
    · intro r
      exact Submodule.zero_mem _
    · exfalso
      have h1 := Finset.card_le_univ σ
      rw [Fintype.card_fin] at h1
      omega

  have hfree : ∀ (R : ℕ) (d : Fin R → ℕ) (p : ℕ) (w : ℤ), ∃ (k : ℕ)
      (c : Fin k → Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A),
      ∀ z : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A,
        (∀ σ, (σ.card = p + 1 → z σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p + 1 → z σ = 0)) →
        (∀ τ : Finset (Fin n), τ.card = p + 2 → wcAltD (A := A) n z τ = 0) →
        ∃ (a : Fin k → A) (y : Finset (Fin n) → Fin R → (Fin n → ℤ) →₀ A),
          (∀ σ, (σ.card = p → y σ ∈ wcLaurC A n R d w σ) ∧ (σ.card ≠ p → y σ = 0)) ∧
          (p = 0 → y = 0) ∧
          ∀ σ : Finset (Fin n), σ.card = p + 1 →
            z σ - ∑ l, a l • c l σ - wcAltD (A := A) n y σ = 0 := by
    intro R d p w
    obtain ⟨k, c, hc⟩ := wc_gc_box_fg A n R d p w
    refine ⟨k, c, fun z hz hcoc => ?_⟩
    obtain ⟨y, hy, hy0, hbox⟩ := wc_gc_free_reduce_box A n R d p w
      (wc_gc_cone_identity A (Fin R → (Fin n → ℤ) →₀ A) n) z hz hcoc
    obtain ⟨a, ha⟩ := hc (fun σ r => z σ r - wcAltD (A := A) n y σ r) hbox
    refine ⟨a, y, hy, hy0, fun σ hσ => ?_⟩
    have h1 : z σ - wcAltD (A := A) n y σ = ∑ l, a l • c l σ := ha σ hσ
    rw [sub_right_comm, h1, sub_self]

  have Q : ∀ m : ℕ, ∀ p, n ≤ p + m → ∀ (R : ℕ) (d : Fin R → ℕ)
      (K : Submodule (MvPolynomial (Fin n) A) (Fin R → MvPolynomial (Fin n) A)),
      (∀ f ∈ K, ∀ t : ℕ, (fun r => if d r ≤ t then
        MvPolynomial.homogeneousComponent (t - d r) (f r) else 0) ∈ K) →
      ∀ w : ℤ, wcGradedH A n R d K p w := by
    intro m
    induction m with
    | zero =>
      intro p hp R d K _ w
      exact hbase p (by omega) R d K w
    | succ m ih =>
      intro p hp R d K hK w
      obtain ⟨R', d', g, hg1, hg2, hg3, hg4⟩ := wc_gc_graded_presentation A n R d K hK
      have h7 := wc_gc_graded_kernel_hc A n R R' d d' g hg1 hg2

      have hK' : ∀ f ∈ LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g),
          ∀ t : ℕ, (fun j => if d' j ≤ t then
            MvPolynomial.homogeneousComponent (t - d' j) (f j) else 0) ∈
            LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g) := by
        intro f hf t
        simp only [LinearMap.mem_ker, Fintype.linearCombination_apply] at hf ⊢
        rw [← h7 f t, hf]
        funext r
        simp
      have hex := fun σ => wc_gc_phi_exact A n R R' d d' K g (wc_gc_laur_mul A n)
        (wc_gc_laur_add_inj A n) (wc_gc_laur_repr A n R') hg1 hg2 hg3 hg4 h7 w σ
      exact wc_gc_step A n R R' d d' K
        (LinearMap.ker (Fintype.linearCombination (MvPolynomial (Fin n) A) g)) _ p w
        (wc_gc_noeth_subfamily A) (wc_gc_altD_sq_zero A (Fin R → (Fin n → ℤ) →₀ A) n)
        (wc_gc_laurK_sub_laurC A n R d K w)
        (fun σ => (hex σ).1) (fun σ => (hex σ).2.1) (fun σ => (hex σ).2.2.1)
        (fun σ => (hex σ).2.2.2)
        (ih (p + 1) (by omega) R' d' _ hK' w) (hfree R d p w)
  intro R d K hK p w
  exact Q n p (by omega) R d K hK w

theorem wc_chart_theta_surj : ∀ (A : Type u) [CommRing A] (n : ℕ) (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)] (R2 : Fin n → Fin n → Type u) [∀ i j, CommRing (R2 i j)] (R3 : Fin n → Fin n → Fin n → Type u) [∀ i j l, CommRing (R3 i j l)] (α1 : ∀ i, A →+* R1 i) (α2 : ∀ i j, A →+* R2 i j) (α3 : ∀ i j l, A →+* R3 i j l) (ρL : ∀ i j, R1 i →+* R2 i j) (ρR : ∀ i j, R1 j →+* R2 i j) (τ12 : ∀ i j l, R2 i j →+* R3 i j l) (τ23 : ∀ i j l, R2 j l →+* R3 i j l) (τ13 : ∀ i j l, R2 i l →+* R3 i j l) (t : ∀ i : Fin n, Fin n → R1 i), wcChartSys A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t → ∀ (a : Fin n) (σ : Finset (Fin n)) (T : Type u) [CommRing T] (φ : R1 a →+* T), a ∈ σ → IsUnit (φ (∏ i ∈ σ, t a i)) → (∀ s : T, ∃ (N : ℕ) (x : R1 a), φ (∏ i ∈ σ, t a i) ^ N * s = φ x) → ∀ s : T, ∃ v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ, wcLaurEval n (φ.comp (α1 a)) (fun k => φ (t a k)) (v 0) = s :=
by
  classical
  intro A _ n R1 _ R2 _ R3 _ α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys a σ T _ φ ha hU hL s
  obtain ⟨-, -, -, -, -, -, -, -, h9, h10, -⟩ := hsys
  obtain ⟨N, x, hx⟩ := hL s
  obtain ⟨P, hP⟩ := h9 a x
  have hua : (fun k => φ (t a k)) a = 1 := by simp [h10 a]
  have hφg : φ (∏ i ∈ σ, t a i) = ∏ i ∈ σ, (fun k => φ (t a k)) i := map_prod φ (t a) σ
  have hev : φ x = MvPolynomial.eval₂ (φ.comp (α1 a)) (fun k => φ (t a k)) P := by
    rw [← hP]; exact MvPolynomial.hom_eval₂ P (α1 a) φ (t a)
  rw [hφg] at hU hx
  rw [hev] at hx
  generalize (fun k => φ (t a k)) = u at hua hU hx ⊢
  have hunit : ∀ i ∈ σ, IsUnit (u i) := fun i hi =>
    isUnit_of_dvd_unit (Finset.dvd_prod_of_mem u hi) hU

  have s1 : ∀ (S : Finset (Fin n →₀ ℕ)) (β : (Fin n →₀ ℕ) → Fin n → ℤ) (c : (Fin n →₀ ℕ) → A),
      wcLaurEval n (φ.comp (α1 a)) u (∑ m ∈ S, Finsupp.single (β m) (c m)) =
      ∑ m ∈ S, (φ.comp (α1 a)) (c m) *
        ∏ k, (u k ^ (β m k).toNat * Ring.inverse (u k) ^ (-β m k).toNat) := by
    intro S β c
    unfold wcLaurEval
    rw [← Finsupp.sum_finsetSum_index]
    · refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [Finsupp.sum_single_index]
      simp
    · intro b; simp
    · intro b c1 c2; simp [add_mul]

  have s2 : ∀ (w : T) (p q : ℕ), IsUnit w →
      w ^ ((p : ℤ) - (q : ℤ)).toNat * Ring.inverse w ^ (-((p : ℤ) - (q : ℤ))).toNat =
        w ^ p * Ring.inverse w ^ q := by
    intro w p q hw
    have e : w * Ring.inverse w = 1 := Ring.mul_inverse_cancel w hw
    rcases le_total q p with h | h
    · obtain ⟨r, rfl⟩ := Nat.exists_eq_add_of_le h
      have h1 : ((((q + r : ℕ)) : ℤ) - (q : ℤ)).toNat = r := by omega
      have h2 : (-((((q + r : ℕ)) : ℤ) - (q : ℤ))).toNat = 0 := by omega
      rw [h1, h2, pow_zero, mul_one, add_comm q r, pow_add, mul_assoc, ← mul_pow, e, one_pow,
        mul_one]
    · obtain ⟨r, rfl⟩ := Nat.exists_eq_add_of_le h
      have h1 : (((p : ℤ) - (((p + r : ℕ)) : ℤ))).toNat = 0 := by omega
      have h2 : (-((p : ℤ) - (((p + r : ℕ)) : ℤ))).toNat = r := by omega
      rw [h1, h2, pow_zero, one_mul, pow_add, ← mul_assoc, ← mul_pow, e, one_pow, one_mul]
  let γ : (Fin n →₀ ℕ) → Fin n → ℤ := fun m i => (m i : ℤ) - (if i ∈ σ then (N : ℤ) else 0)
  let β : (Fin n →₀ ℕ) → Fin n → ℤ := fun m i => γ m i - (if i = a then ∑ j, γ m j else 0)
  refine ⟨fun _ => ∑ m ∈ P.support, Finsupp.single (β m) (P.coeff m), ?_, ?_⟩
  · simp only [wcLaurC, Set.mem_setOf_eq]
    intro r
    refine Submodule.sum_mem _ (fun m _ => Finsupp.single_mem_supported A _ ?_)
    refine ⟨?_, fun i hi => ?_⟩
    · simp only [β, Finset.sum_sub_distrib, Finset.sum_ite_eq', Finset.mem_univ, if_true]
      simp
    · have hia : i ≠ a := fun h => hi (h ▸ ha)
      simp [β, γ, hi, hia]
  · show wcLaurEval n (φ.comp (α1 a)) u (∑ m ∈ P.support, Finsupp.single (β m) (P.coeff m)) = s
    have hW : ∀ m k, u k ^ (β m k).toNat * Ring.inverse (u k) ^ (-β m k).toNat =
        u k ^ (m k) * (if k ∈ σ then Ring.inverse (u k) ^ N else 1) := by
      intro m k
      by_cases hka : k = a
      · rw [hka, hua]; simp [Ring.inverse_one, ha]
      · by_cases hk : k ∈ σ
        · have hb : β m k = ((m k : ℕ) : ℤ) - (N : ℤ) := by simp [β, γ, hk, hka]
          rw [hb, s2 _ _ _ (hunit k hk), if_pos hk]
        · have hb : β m k = ((m k : ℕ) : ℤ) := by simp [β, γ, hk, hka]
          rw [hb, if_neg hk, mul_one]
          simp
    have hrow : ∀ m, ∏ k, (u k ^ (β m k).toNat * Ring.inverse (u k) ^ (-β m k).toNat) =
        (∏ k, u k ^ (m k)) * ∏ k, (if k ∈ σ then Ring.inverse (u k) ^ N else 1) := by
      intro m
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_congr rfl (fun k _ => hW m k)
    rw [s1, Finset.sum_congr rfl (fun m _ => by rw [hrow m, ← mul_assoc]), ← Finset.sum_mul,
      ← MvPolynomial.eval₂_eq', ← hx, Finset.prod_ite_mem, Finset.univ_inter, ← Finset.prod_pow,
      mul_comm _ s, mul_assoc, ← Finset.prod_mul_distrib]
    rw [Finset.prod_eq_one (fun k hk => by rw [← mul_pow, Ring.mul_inverse_cancel _ (hunit k hk),
      one_pow]), mul_one]

theorem wc_chart_theta_ker : ∀ (A : Type u) [CommRing A] (n : ℕ) (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)] (R2 : Fin n → Fin n → Type u) [∀ i j, CommRing (R2 i j)] (R3 : Fin n → Fin n → Fin n → Type u) [∀ i j l, CommRing (R3 i j l)] (α1 : ∀ i, A →+* R1 i) (α2 : ∀ i j, A →+* R2 i j) (α3 : ∀ i j l, A →+* R3 i j l) (ρL : ∀ i j, R1 i →+* R2 i j) (ρR : ∀ i j, R1 j →+* R2 i j) (τ12 : ∀ i j l, R2 i j →+* R3 i j l) (τ23 : ∀ i j l, R2 j l →+* R3 i j l) (τ13 : ∀ i j l, R2 i l →+* R3 i j l) (t : ∀ i : Fin n, Fin n → R1 i), wcChartSys A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t → ∀ (a : Fin n) (σ : Finset (Fin n)) (T : Type u) [CommRing T] (φ : R1 a →+* T), a ∈ σ → IsUnit (φ (∏ i ∈ σ, t a i)) → (∀ x : R1 a, φ x = 0 → ∃ N : ℕ, (∏ i ∈ σ, t a i) ^ N * x = 0) → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ, (wcLaurEval n (φ.comp (α1 a)) (fun k => φ (t a k)) (v 0) = 0 ↔ v ∈ wcLaurK A n 1 (fun _ => 0) (wcChartJ A n R1 α1 t) 0 σ) :=
by
  classical
  intro A _ n R1 _ R2 _ R3 _ α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys a σ T _ φ ha hU hKer v hv
  obtain ⟨h1, h2, -, -, -, -, -, -, -, -, h11, h12, h13, -, -⟩ := hsys

  have hU' : IsUnit (∏ i ∈ σ, φ (t a i)) := by
    have e := map_prod φ (t a) σ
    rw [e] at hU
    exact hU
  have hunit : ∀ i ∈ σ, IsUnit (φ (t a i)) := fun i hi =>
    isUnit_of_dvd_unit (Finset.dvd_prod_of_mem (fun k => φ (t a k)) hi) hU'
  have hev : ∀ p : MvPolynomial (Fin n) A,
      MvPolynomial.eval₂ (φ.comp (α1 a)) (fun k => φ (t a k)) p =
        φ (MvPolynomial.eval₂ (α1 a) (t a) p) := fun p =>
    (MvPolynomial.hom_eval₂ p (α1 a) φ (t a)).symm

  have s2 : ∀ (w : T) (p q : ℕ), IsUnit w →
      w ^ ((p : ℤ) - (q : ℤ)).toNat * Ring.inverse w ^ (-((p : ℤ) - (q : ℤ))).toNat =
        w ^ p * Ring.inverse w ^ q := by
    intro w p q hw
    have e : w * Ring.inverse w = 1 := Ring.mul_inverse_cancel w hw
    rcases le_total q p with h | h
    · obtain ⟨r, rfl⟩ := Nat.exists_eq_add_of_le h
      have e1 : ((((q + r : ℕ)) : ℤ) - (q : ℤ)).toNat = r := by omega
      have e2 : (-((((q + r : ℕ)) : ℤ) - (q : ℤ))).toNat = 0 := by omega
      rw [e1, e2, pow_zero, mul_one, add_comm q r, pow_add, mul_assoc, ← mul_pow, e, one_pow,
        mul_one]
    · obtain ⟨r, rfl⟩ := Nat.exists_eq_add_of_le h
      have e1 : (((p : ℤ) - (((p + r : ℕ)) : ℤ))).toNat = 0 := by omega
      have e2 : (-((p : ℤ) - (((p + r : ℕ)) : ℤ))).toNat = r := by omega
      rw [e1, e2, pow_zero, one_mul, pow_add, ← mul_assoc, ← mul_pow, e, one_pow, one_mul]
  have s1 : ∀ (u : Fin n → T) (α : A →+* T), (∀ i ∈ σ, IsUnit (u i)) →
      ∀ (k : ℕ) (p : MvPolynomial (Fin n) A),
      wcLaurEval n α u (∑ m ∈ p.support,
        Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) (p.coeff m)) =
      MvPolynomial.eval₂ α u p * ∏ i ∈ σ, Ring.inverse (u i) ^ k := by
    intro u α hu k p
    have hW : ∀ (m : Fin n →₀ ℕ) (i : Fin n),
        u i ^ ((m i : ℤ) - if i ∈ σ then (k : ℤ) else 0).toNat *
          Ring.inverse (u i) ^ (-((m i : ℤ) - if i ∈ σ then (k : ℤ) else 0)).toNat =
        u i ^ (m i) * (if i ∈ σ then Ring.inverse (u i) ^ k else 1) := by
      intro m i
      by_cases hi : i ∈ σ
      · simp only [if_pos hi]
        exact s2 _ _ _ (hu i hi)
      · simp only [if_neg hi, sub_zero, mul_one]
        simp
    unfold wcLaurEval
    rw [← Finsupp.sum_finsetSum_index]
    · rw [MvPolynomial.eval₂_eq', Finset.sum_mul]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [Finsupp.sum_single_index (by simp)]
      beta_reduce
      rw [Finset.prod_congr rfl (fun i _ => hW m i), Finset.prod_mul_distrib, Finset.prod_ite_mem,
        Finset.univ_inter]
      ring
    · intro b; simp
    · intro b c1 c2; simp [add_mul]

  have hJ : ∀ f ∈ wcChartJ A n R1 α1 t, ∀ j, MvPolynomial.eval₂ (α1 j) (t j) (f 0) = 0 := by
    intro f hf j
    unfold wcChartJ at hf
    induction hf using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨e, -, he⟩ := hx
      exact he j
    | zero => simp
    | add x y _ _ hx hy => simp [MvPolynomial.eval₂_add, hx, hy]
    | smul c x _ hx => simp [MvPolynomial.eval₂_mul, hx]

  have hEadd : ∀ x y : (Fin n → ℤ) →₀ A,
      wcLaurEval n (φ.comp (α1 a)) (fun k => φ (t a k)) (x + y) =
        wcLaurEval n (φ.comp (α1 a)) (fun k => φ (t a k)) x +
          wcLaurEval n (φ.comp (α1 a)) (fun k => φ (t a k)) y := by
    intro x y
    unfold wcLaurEval
    exact Finsupp.sum_add_index' (fun _ => by simp) (fun _ _ _ => by rw [map_add, add_mul])
  have hEsmul : ∀ (c : A) (x : (Fin n → ℤ) →₀ A),
      wcLaurEval n (φ.comp (α1 a)) (fun k => φ (t a k)) (c • x) =
        (φ.comp (α1 a)) c * wcLaurEval n (φ.comp (α1 a)) (fun k => φ (t a k)) x := by
    intro c x
    unfold wcLaurEval
    rw [Finsupp.sum_smul_index' (fun _ => by simp), Finsupp.mul_sum]
    refine Finsupp.sum_congr (fun β _ => ?_)
    simp only [smul_eq_mul, map_mul, mul_assoc]
  have hEzero : wcLaurEval n (φ.comp (α1 a)) (fun k => φ (t a k)) 0 = 0 := by
    unfold wcLaurEval
    exact Finsupp.sum_zero_index

  have hback : ∀ x : Fin 1 → (Fin n → ℤ) →₀ A,
      x ∈ wcLaurK A n 1 (fun _ => 0) (wcChartJ A n R1 α1 t) 0 σ →
      wcLaurEval n (φ.comp (α1 a)) (fun k => φ (t a k)) (x 0) = 0 := by
    intro x hx
    unfold wcLaurK at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨k, f, hf, -, rfl⟩ := hy
      show wcLaurEval n (φ.comp (α1 a)) (fun k => φ (t a k)) (∑ m ∈ (f 0).support,
        Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((f 0).coeff m)) = 0
      rw [s1 (fun k => φ (t a k)) (φ.comp (α1 a)) hunit k (f 0), hev, hJ f hf a, map_zero,
        zero_mul]
    | zero => rw [Pi.zero_apply, hEzero]
    | add y z _ _ hy hz => rw [Pi.add_apply, hEadd, hy, hz, add_zero]
    | smul c y _ hy => rw [Pi.smul_apply, hEsmul, hy, mul_zero]

  have hsupp : ∀ β ∈ (v 0).support, ∑ i, β i = 0 ∧ ∀ i, i ∉ σ → 0 ≤ β i := by
    intro β hβ
    simp only [wcLaurC, Set.mem_setOf_eq] at hv
    have h := (Finsupp.mem_supported A (v 0)).mp (hv 0) hβ
    simp only [Set.mem_setOf_eq] at h
    exact ⟨by simpa using h.1, h.2⟩

  have hsdeg : ∀ (p : MvPolynomial (Fin n) A) (D : ℕ), p.IsHomogeneous D →
      ∀ m ∈ p.support, ∑ i, m i = D := by
    intro p D hp m hm
    have := hp (MvPolynomial.mem_support_iff.mp hm)
    rw [← Finsupp.degree_eq_sum, Finsupp.degree_eq_weight_one]
    exact this

  have hF4 : ∀ (j : Fin n) (e : ℕ) (p : MvPolynomial (Fin n) A),
      MvPolynomial.eval₂ (α1 j) (t j) ((∏ i ∈ σ, (MvPolynomial.X i : MvPolynomial (Fin n) A)) ^ e * p)
        = (∏ i ∈ σ, t j i) ^ e * MvPolynomial.eval₂ (α1 j) (t j) p := by
    intro j e p
    rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_pow, MvPolynomial.eval₂_prod]
    simp only [MvPolynomial.eval₂_X]

  have htrans : ∀ (j : Fin n) (p : MvPolynomial (Fin n) A) (D : ℕ), p.IsHomogeneous D →
      ρL a j (MvPolynomial.eval₂ (α1 a) (t a) p) =
        ρL a j (t a j) ^ D * ρR a j (MvPolynomial.eval₂ (α1 j) (t j) p) := by
    intro j p D hp
    have hc1 : (ρL a j).comp (α1 a) = α2 a j := RingHom.ext (h1 a j)
    have hc2 : (ρR a j).comp (α1 j) = α2 a j := RingHom.ext (h2 a j)
    have h11' : (fun i => ρL a j (t a i)) = fun i => ρL a j (t a j) * ρR a j (t j i) :=
      funext fun i => h11 a j i
    rw [MvPolynomial.hom_eval₂, MvPolynomial.hom_eval₂, hc1, hc2, h11', MvPolynomial.eval₂_eq',
      MvPolynomial.eval₂_eq', Finset.mul_sum]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    have hdeg : ∑ i, m i = D := hsdeg p D hp m hm
    rw [Finset.prod_congr rfl (fun i _ => mul_pow (ρL a j (t a j)) (ρR a j (t j i)) (m i)),
      Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring
  constructor
  swap
  · intro hvK
    exact hback v hvK
  intro hE
  have hvfun : v = fun _ => v 0 := funext fun r => by rw [Fin.fin_one_eq_zero r]
  rw [hvfun]
  generalize v 0 = w at hsupp hE ⊢

  obtain ⟨K, hK⟩ : ∃ K : ℕ, ∀ β ∈ w.support, ∑ j, (-β j).toNat ≤ K :=
    ⟨_, fun β hβ => Finset.le_sup (f := fun β : Fin n → ℤ => ∑ j, (-β j).toNat) hβ⟩
  obtain ⟨μ, hμdef⟩ : ∃ μ : ℕ → (Fin n → ℤ) → (Fin n →₀ ℕ), ∀ k β i,
      μ k β i = (β i + if i ∈ σ then (k : ℤ) else 0).toNat :=
    ⟨fun k β => Finsupp.equivFunOnFinite.symm
      (fun i => (β i + if i ∈ σ then (k : ℤ) else 0).toNat),
      fun k β i => Finsupp.equivFunOnFinite_symm_apply_apply _ _⟩
  have hμ : ∀ k, K ≤ k → ∀ β ∈ w.support, ∀ i,
      ((μ k β i : ℕ) : ℤ) = β i + if i ∈ σ then (k : ℤ) else 0 := by
    intro k hk β hβ i
    rw [hμdef]
    apply Int.toNat_of_nonneg
    by_cases hi : i ∈ σ
    · rw [if_pos hi]
      have e1 : (-β i).toNat ≤ ∑ j, (-β j).toNat :=
        Finset.single_le_sum (f := fun j => (-β j).toNat) (fun j _ => Nat.zero_le _)
          (Finset.mem_univ i)
      have e2 := hK β hβ
      omega
    · rw [if_neg hi, add_zero]
      exact (hsupp β hβ).2 i hi
  obtain ⟨F, hFdef⟩ : ∃ F : ℕ → MvPolynomial (Fin n) A, ∀ k,
      F k = ∑ β ∈ w.support, MvPolynomial.monomial (μ k β) (w β) := ⟨_, fun k => rfl⟩

  have hhom : ∀ k, K ≤ k → (F k).IsHomogeneous (k * σ.card) := by
    intro k hk
    rw [hFdef]
    apply MvPolynomial.IsHomogeneous.sum
    intro β hβ
    apply MvPolynomial.isHomogeneous_monomial
    rw [Finsupp.degree_eq_sum]
    have e : ((∑ i, μ k β i : ℕ) : ℤ) = ((k * σ.card : ℕ) : ℤ) := by
      rw [Nat.cast_sum, Finset.sum_congr rfl (fun i _ => hμ k hk β hβ i), Finset.sum_add_distrib,
        (hsupp β hβ).1, Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]
      push_cast
      ring
    exact_mod_cast e

  have hxσ : ∀ e : ℕ, (∏ i ∈ σ, (MvPolynomial.X i : MvPolynomial (Fin n) A)) ^ e =
      MvPolynomial.monomial (∑ i ∈ σ, Finsupp.single i e) 1 := by
    intro e
    rw [MvPolynomial.monomial_sum_one, ← Finset.prod_pow]
    refine Finset.prod_congr rfl (fun i _ => ?_)
    rw [MvPolynomial.X_pow_eq_monomial]
  have hshift : ∀ e : ℕ,
      (∏ i ∈ σ, (MvPolynomial.X i : MvPolynomial (Fin n) A)) ^ e * F K = F (K + e) := by
    intro e
    rw [hFdef, hFdef, hxσ, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun β hβ => ?_)
    have hexp : (∑ i ∈ σ, Finsupp.single i e) + μ K β = μ (K + e) β := by
      ext j
      have e1 := hμ K le_rfl β hβ j
      have e2 := hμ (K + e) (Nat.le_add_right K e) β hβ j
      have e3 : (∑ i ∈ σ, Finsupp.single i e) j = if j ∈ σ then e else 0 := by
        rw [Finsupp.finsetSum_apply]
        simp [Finsupp.single_apply]
      rw [Finsupp.add_apply, e3]
      by_cases hj : j ∈ σ
      · rw [if_pos hj]
        rw [if_pos hj] at e1 e2
        push_cast at e2
        omega
      · rw [if_neg hj]
        rw [if_neg hj] at e1 e2
        omega
    rw [MvPolynomial.monomial_mul_monomial, one_mul, hexp]

  have hΦsub : ∀ (g : (Fin n →₀ ℕ) → Fin n → ℤ) (p : MvPolynomial (Fin n) A)
      (S : Finset (Fin n →₀ ℕ)), p.support ⊆ S →
      ∑ m ∈ p.support, Finsupp.single (g m) (p.coeff m) =
        ∑ m ∈ S, Finsupp.single (g m) (p.coeff m) := by
    intro g p S hS
    exact Finset.sum_subset hS (fun m _ hm => by
      rw [MvPolynomial.notMem_support_iff.mp hm, Finsupp.single_zero])
  have hΦsum : ∀ (g : (Fin n →₀ ℕ) → Fin n → ℤ) (B : Finset (Fin n → ℤ))
      (P : (Fin n → ℤ) → MvPolynomial (Fin n) A),
      ∑ m ∈ (∑ β ∈ B, P β).support, Finsupp.single (g m) ((∑ β ∈ B, P β).coeff m) =
        ∑ β ∈ B, ∑ m ∈ (P β).support, Finsupp.single (g m) ((P β).coeff m) := by
    intro g B P
    rw [hΦsub g _ (B.biUnion fun β => (P β).support) MvPolynomial.support_sum]
    simp only [MvPolynomial.coeff_sum, Finsupp.single_finsetSum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun β hβ =>
      (hΦsub g _ _ (Finset.subset_biUnion_of_mem (fun β => (P β).support) hβ)).symm)
  have hΦmono : ∀ (g : (Fin n →₀ ℕ) → Fin n → ℤ) (s : Fin n →₀ ℕ) (c : A),
      ∑ m ∈ (MvPolynomial.monomial s c).support,
        Finsupp.single (g m) ((MvPolynomial.monomial s c).coeff m) = Finsupp.single (g s) c := by
    intro g s c
    rw [hΦsub g _ {s} MvPolynomial.support_monomial_subset, Finset.sum_singleton,
      MvPolynomial.coeff_monomial, if_pos rfl]
  have hrec : ∀ k, K ≤ k → ∑ m ∈ (F k).support,
      Finsupp.single (fun i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) ((F k).coeff m) = w := by
    intro k hk
    rw [hFdef]
    refine (hΦsum (fun m i => (m i : ℤ) - if i ∈ σ then (k : ℤ) else 0) w.support
      (fun β => MvPolynomial.monomial (μ k β) (w β))).trans ?_
    calc _ = ∑ β ∈ w.support, Finsupp.single β (w β) := by
          refine Finset.sum_congr rfl (fun β hβ => ?_)
          refine (hΦmono _ _ _).trans ?_
          congr 1
          funext i
          beta_reduce
          rw [hμ k hk β hβ i]
          ring
      _ = w := Finsupp.sum_single w

  rw [← hrec K le_rfl, s1 (fun k => φ (t a k)) (φ.comp (α1 a)) hunit K (F K), hev] at hE
  have hP : ∏ i ∈ σ, Ring.inverse (φ (t a i)) ^ K * φ (t a i) ^ K = 1 :=
    Finset.prod_eq_one (fun i hi => by
      rw [← mul_pow, Ring.inverse_mul_cancel _ (hunit i hi), one_pow])
  have hψa : φ (MvPolynomial.eval₂ (α1 a) (t a) (F K)) = 0 := by
    have e := congrArg (fun z => z * ∏ i ∈ σ, φ (t a i) ^ K) hE
    simp only [zero_mul] at e
    rw [mul_assoc, ← Finset.prod_mul_distrib, hP, mul_one] at e
    exact e
  obtain ⟨M, hM⟩ := hKer _ hψa
  have hψh : MvPolynomial.eval₂ (α1 a) (t a) (F (K + M)) = 0 := by
    rw [← hshift M, hF4 a M (F K)]
    exact hM

  have hkill : ∀ j, ∃ N : ℕ, t j a ^ N * MvPolynomial.eval₂ (α1 j) (t j) (F (K + M)) = 0 := by
    intro j
    have e := htrans j (F (K + M)) ((K + M) * σ.card) (hhom (K + M) (Nat.le_add_right K M))
    rw [hψh, map_zero] at e
    have e2 : ρR a j (MvPolynomial.eval₂ (α1 j) (t j) (F (K + M))) = 0 :=
      (((h12 a j).1.pow ((K + M) * σ.card)).mul_right_eq_zero).mp e.symm
    exact (h13 a j).2.2 _ e2
  choose N hN using hkill
  obtain ⟨L, hL⟩ : ∃ L : ℕ, L = ∑ j, N j := ⟨_, rfl⟩
  have hNL : ∀ j, N j ≤ L := fun j => by
    rw [hL]
    exact Finset.single_le_sum (f := N) (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
  have hG : ∀ j, MvPolynomial.eval₂ (α1 j) (t j) (F (K + (M + L))) = 0 := by
    intro j
    rw [← hshift, add_comm M L, pow_add, mul_assoc, hshift M, hF4]
    obtain ⟨r, hr⟩ : t j a ^ N j ∣ (∏ i ∈ σ, t j i) ^ L :=
      (pow_dvd_pow (t j a) (hNL j)).trans (pow_dvd_pow_of_dvd (Finset.dvd_prod_of_mem (t j) ha) L)
    rw [hr, mul_comm (t j a ^ N j) r, mul_assoc, hN j, mul_zero]
  have hGJ : (fun _ : Fin 1 => F (K + (M + L))) ∈ wcChartJ A n R1 α1 t := by
    unfold wcChartJ
    exact Submodule.subset_span ⟨(K + (M + L)) * σ.card, hhom _ (by omega), hG⟩
  unfold wcLaurK
  refine Submodule.subset_span ⟨K + (M + L), fun _ => F (K + (M + L)), hGJ, ?_, ?_⟩
  · intro r m hm
    have e := hsdeg _ _ (hhom (K + (M + L)) (by omega)) m hm
    simp only [Nat.cast_zero, zero_add, sub_zero]
    exact_mod_cast e
  · funext r
    exact (hrec (K + (M + L)) (by omega)).symm

theorem wc_chart_faces_one_two : ∀ (A : Type u) [CommRing A] (n : ℕ) (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)] (R2 : Fin n → Fin n → Type u) [∀ i j, CommRing (R2 i j)] (R3 : Fin n → Fin n → Fin n → Type u) [∀ i j l, CommRing (R3 i j l)] (α1 : ∀ i, A →+* R1 i) (α2 : ∀ i j, A →+* R2 i j) (α3 : ∀ i j l, A →+* R3 i j l) (ρL : ∀ i j, R1 i →+* R2 i j) (ρR : ∀ i j, R1 j →+* R2 i j) (τ12 : ∀ i j l, R2 i j →+* R3 i j l) (τ23 : ∀ i j l, R2 j l →+* R3 i j l) (τ13 : ∀ i j l, R2 i l →+* R3 i j l) (t : ∀ i : Fin n, Fin n → R1 i), wcChartSys A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t → (∀ (a b : Fin n) (v : (Fin n → ℤ) →₀ A), (∀ β ∈ v.support, ∑ k, β k = 0 ∧ ∀ k, k ≠ a → 0 ≤ β k) → ρL a b (wcLaurEval n (α1 a) (t a) v) = wcLaurEval n (α2 a b) (fun k => ρL a b (t a k)) v) ∧ (∀ (a b : Fin n) (v : (Fin n → ℤ) →₀ A), (∀ β ∈ v.support, ∑ k, β k = 0 ∧ ∀ k, k ≠ b → 0 ≤ β k) → ρR a b (wcLaurEval n (α1 b) (t b) v) = wcLaurEval n (α2 a b) (fun k => ρL a b (t a k)) v) :=
by
  intro A _ n R1 _ R2 _ R3 _ α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
  obtain ⟨h1, h2, -, -, -, -, -, -, -, h10, h11, h12, -, -, -⟩ := hsys

  have hnat : ∀ {T T' : Type u} [CommRing T] [CommRing T'] (α : A →+* T) (u : Fin n → T)
      (φ : T →+* T') (v : (Fin n → ℤ) →₀ A),
      (∀ β ∈ v.support, ∀ k, β k < 0 → IsUnit (u k)) →
      φ (wcLaurEval n α u v) = wcLaurEval n (φ.comp α) (fun k => φ (u k)) v := by
    intro T T' _ _ α u φ v hv
    unfold wcLaurEval
    rw [map_finsuppSum]
    refine Finsupp.sum_congr (fun β hβ => ?_)
    rw [map_mul, map_prod, RingHom.comp_apply]
    congr 1
    refine Finset.prod_congr rfl (fun k _ => ?_)
    rw [map_mul, map_pow, map_pow]
    congr 1
    by_cases hk : β k < 0
    · have hu := hv β hβ k hk
      have hφu : IsUnit (φ (u k)) := hu.map φ
      have e : φ (Ring.inverse (u k)) = Ring.inverse (φ (u k)) := by
        apply hφu.mul_left_cancel
        rw [← map_mul, Ring.mul_inverse_cancel _ hu, map_one, Ring.mul_inverse_cancel _ hφu]
      rw [e]
    · have h0 : (-β k).toNat = 0 := Int.toNat_eq_zero.mpr (by omega)
      rw [h0, pow_zero, pow_zero]

  have hscale : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin n → T) (c : T)
      (v : (Fin n → ℤ) →₀ A), IsUnit c → (∀ β ∈ v.support, ∑ k, β k = 0) →
      wcLaurEval n α (fun k => c * u k) v = wcLaurEval n α u v := by
    intro T _ α u c v hc hv
    unfold wcLaurEval
    refine Finsupp.sum_congr (fun β hβ => ?_)
    congr 1
    have hfac : ∀ k, (c * u k) ^ (β k).toNat * Ring.inverse (c * u k) ^ (-β k).toNat =
        (c ^ (β k).toNat * Ring.inverse c ^ (-β k).toNat) *
          (u k ^ (β k).toNat * Ring.inverse (u k) ^ (-β k).toNat) := by
      intro k
      rw [Ring.mul_inverse_rev, mul_pow, mul_pow]
      ring
    rw [Finset.prod_congr rfl (fun k _ => hfac k), Finset.prod_mul_distrib,
      Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, Finset.prod_pow_eq_pow_sum]
    have hpq : ∑ k, (β k).toNat = ∑ k, (-β k).toNat := by
      have h0 := hv β hβ
      have e : ((∑ k, (β k).toNat : ℕ) : ℤ) - ((∑ k, (-β k).toNat : ℕ) : ℤ) = 0 := by
        push_cast
        rw [← Finset.sum_sub_distrib]
        simp only [Int.toNat_sub_toNat_neg]
        exact h0
      omega
    rw [hpq, ← mul_pow, Ring.mul_inverse_cancel _ hc, one_pow, one_mul]
  refine ⟨fun a b v hv => ?_, fun a b v hv => ?_⟩
  · have H : ∀ β ∈ v.support, ∀ k, β k < 0 → IsUnit (t a k) := by
      intro β hβ k hk
      by_cases hka : k = a
      · rw [hka, h10]; exact isUnit_one
      · exact absurd ((hv β hβ).2 k hka) (by omega)
    rw [hnat (α1 a) (t a) (ρL a b) v H]
    have hc : (ρL a b).comp (α1 a) = α2 a b := RingHom.ext (fun x => h1 a b x)
    rw [hc]
  · have H : ∀ β ∈ v.support, ∀ k, β k < 0 → IsUnit (t b k) := by
      intro β hβ k hk
      by_cases hkb : k = b
      · rw [hkb, h10]; exact isUnit_one
      · exact absurd ((hv β hβ).2 k hkb) (by omega)
    rw [hnat (α1 b) (t b) (ρR a b) v H]
    have hc : (ρR a b).comp (α1 b) = α2 a b := RingHom.ext (fun x => h2 a b x)
    rw [hc]
    have hfun : (fun k => ρL a b (t a k)) = fun k => ρL a b (t a b) * ρR a b (t b k) :=
      funext (h11 a b)
    rw [hfun, hscale (α2 a b) (fun k => ρR a b (t b k)) (ρL a b (t a b)) v (h12 a b).1
      (fun β hβ => (hv β hβ).1)]

theorem wc_chart_faces_two_three : ∀ (A : Type u) [CommRing A] (n : ℕ) (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)] (R2 : Fin n → Fin n → Type u) [∀ i j, CommRing (R2 i j)] (R3 : Fin n → Fin n → Fin n → Type u) [∀ i j l, CommRing (R3 i j l)] (α1 : ∀ i, A →+* R1 i) (α2 : ∀ i j, A →+* R2 i j) (α3 : ∀ i j l, A →+* R3 i j l) (ρL : ∀ i j, R1 i →+* R2 i j) (ρR : ∀ i j, R1 j →+* R2 i j) (τ12 : ∀ i j l, R2 i j →+* R3 i j l) (τ23 : ∀ i j l, R2 j l →+* R3 i j l) (τ13 : ∀ i j l, R2 i l →+* R3 i j l) (t : ∀ i : Fin n, Fin n → R1 i), wcChartSys A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t → (∀ (i j l : Fin n) (v : (Fin n → ℤ) →₀ A), (∀ β ∈ v.support, ∑ k, β k = 0 ∧ ∀ k, k ≠ i → k ≠ j → 0 ≤ β k) → τ12 i j l (wcLaurEval n (α2 i j) (fun k => ρL i j (t i k)) v) = wcLaurEval n (α3 i j l) (fun k => τ12 i j l (ρL i j (t i k))) v) ∧ (∀ (i j l : Fin n) (v : (Fin n → ℤ) →₀ A), (∀ β ∈ v.support, ∑ k, β k = 0 ∧ ∀ k, k ≠ i → k ≠ l → 0 ≤ β k) → τ13 i j l (wcLaurEval n (α2 i l) (fun k => ρL i l (t i k)) v) = wcLaurEval n (α3 i j l) (fun k => τ12 i j l (ρL i j (t i k))) v) ∧ (∀ (i j l : Fin n) (v : (Fin n → ℤ) →₀ A), (∀ β ∈ v.support, ∑ k, β k = 0 ∧ ∀ k, k ≠ j → k ≠ l → 0 ≤ β k) → τ23 i j l (wcLaurEval n (α2 j l) (fun k => ρL j l (t j k)) v) = wcLaurEval n (α3 i j l) (fun k => τ12 i j l (ρL i j (t i k))) v) ∧ (∀ (a b : Fin n) (v : (Fin n → ℤ) →₀ A), (∀ β ∈ v.support, ∑ k, β k = 0 ∧ ∀ k, k ≠ a → k ≠ b → 0 ≤ β k) → τ12 a b a (wcLaurEval n (α2 a b) (fun k => ρR a b (t b k)) v) = τ23 a b a (wcLaurEval n (α2 b a) (fun k => ρL b a (t b k)) v)) :=
by
  classical
  intro A _ n R1 _ R2 _ R3 _ α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15⟩ := hsys

  have nat : ∀ {T T' : Type u} [CommRing T] [CommRing T'] (α : A →+* T) (u : Fin n → T)
      (φ : T →+* T') (v : (Fin n → ℤ) →₀ A),
      (∀ β ∈ v.support, ∀ k, β k < 0 → IsUnit (u k)) →
      φ (wcLaurEval n α u v) = wcLaurEval n (φ.comp α) (fun k => φ (u k)) v := by
    intro T T' _ _ α u φ v hv
    unfold wcLaurEval
    rw [map_finsuppSum]
    refine Finsupp.sum_congr (fun β hβ => ?_)
    rw [map_mul, map_prod, RingHom.comp_apply]
    congr 1
    refine Finset.prod_congr rfl (fun k _ => ?_)
    rw [map_mul, map_pow, map_pow]
    congr 1
    by_cases hk : β k < 0
    · have hu := hv β hβ k hk
      have hφu := hu.map φ
      congr 1
      apply hφu.mul_left_cancel
      rw [← map_mul, Ring.mul_inverse_cancel _ hu, map_one, Ring.mul_inverse_cancel _ hφu]
    · have h0 : (-β k).toNat = 0 := Int.toNat_eq_zero.mpr (by omega)
      rw [h0, pow_zero, pow_zero]

  have scale : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin n → T) (c : T)
      (v : (Fin n → ℤ) →₀ A), IsUnit c → (∀ β ∈ v.support, ∑ k, β k = 0) →
      wcLaurEval n α (fun k => c * u k) v = wcLaurEval n α u v := by
    intro T _ α u c v hc hv
    unfold wcLaurEval
    refine Finsupp.sum_congr (fun β hβ => ?_)
    congr 1
    have hk : ∀ k, (c * u k) ^ (β k).toNat * Ring.inverse (c * u k) ^ (-β k).toNat
        = (c ^ (β k).toNat * Ring.inverse c ^ (-β k).toNat) *
          (u k ^ (β k).toNat * Ring.inverse (u k) ^ (-β k).toNat) := by
      intro k
      rw [Ring.mul_inverse_rev]
      ring
    have hsum : ∑ k, (β k).toNat = ∑ k, (-β k).toNat := by
      have h0 := hv β hβ
      have e : ((∑ k, (β k).toNat : ℕ) : ℤ) - ((∑ k, (-β k).toNat : ℕ) : ℤ) = ∑ k, β k := by
        rw [Nat.cast_sum, Nat.cast_sum, ← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl (fun k _ => Int.toNat_sub_toNat_neg (β k))
      omega
    beta_reduce
    rw [Finset.prod_congr rfl (fun k _ => hk k), Finset.prod_mul_distrib,
      Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, Finset.prod_pow_eq_pow_sum, hsum,
      ← mul_pow, Ring.mul_inverse_cancel _ hc, one_pow, one_mul]

  have two : ∀ {T : Type u} [CommRing T] (u : Fin n → T) (p q : Fin n) (v : (Fin n → ℤ) →₀ A),
      (∀ β ∈ v.support, ∑ k, β k = 0 ∧ ∀ k, k ≠ p → k ≠ q → 0 ≤ β k) →
      IsUnit (u p) → IsUnit (u q) → ∀ β ∈ v.support, ∀ k, β k < 0 → IsUnit (u k) := by
    intro T _ u p q v hv hp hq β hβ k hk
    by_cases hkp : k = p
    · rw [hkp]; exact hp
    by_cases hkq : k = q
    · rw [hkq]; exact hq
    exact absurd ((hv β hβ).2 k hkp hkq) (not_le.mpr hk)
  refine ⟨fun i j l v hv => ?_, fun i j l v hv => ?_, fun i j l v hv => ?_, fun a b v hv => ?_⟩
  ·
    have H := two (fun k => ρL i j (t i k)) i j v hv (by simp [h10]) (h12 i j).1
    rw [nat (α2 i j) (fun k => ρL i j (t i k)) (τ12 i j l) v H]
    have hc : (τ12 i j l).comp (α2 i j) = α3 i j l := RingHom.ext (fun a => h3 i j l a)
    rw [hc]
  ·
    have H := two (fun k => ρL i l (t i k)) i l v hv (by simp [h10]) (h12 i l).1
    rw [nat (α2 i l) (fun k => ρL i l (t i k)) (τ13 i j l) v H]
    have hc : (τ13 i j l).comp (α2 i l) = α3 i j l := RingHom.ext (fun a => h5 i j l a)
    rw [hc]
    exact congrArg (fun u => wcLaurEval n (α3 i j l) u v)
      (funext fun k => (h6 i j l (t i k)).symm)
  ·
    have H := two (fun k => ρL j l (t j k)) j l v hv (by simp [h10]) (h12 j l).1
    rw [nat (α2 j l) (fun k => ρL j l (t j k)) (τ23 i j l) v H]
    have hc : (τ23 i j l).comp (α2 j l) = α3 i j l := RingHom.ext (fun a => h4 i j l a)
    rw [hc]
    have hcu : IsUnit (τ12 i j l (ρL i j (t i j))) := by
      have hh := (h14 i j l).1
      rw [map_mul, map_mul] at hh
      exact isUnit_of_mul_isUnit_left hh
    have e2 := scale (α3 i j l) (fun k => τ12 i j l (ρR i j (t j k)))
      (τ12 i j l (ρL i j (t i j))) v hcu (fun β hβ => (hv β hβ).1)
    have hw : (fun k => τ12 i j l (ρL i j (t i k))) =
        (fun k => τ12 i j l (ρL i j (t i j)) * τ12 i j l (ρR i j (t j k))) :=
      funext (fun k => by rw [h11 i j k, map_mul])
    rw [hw, e2]
    exact congrArg (fun u => wcLaurEval n (α3 i j l) u v)
      (funext fun k => (h7 i j l (t j k)).symm)
  ·
    have HL := two (fun k => ρR a b (t b k)) a b v hv (h13 a b).1 (by simp [h10])
    have HR := two (fun k => ρL b a (t b k)) a b v hv (h12 b a).1 (by simp [h10])
    rw [nat (α2 a b) (fun k => ρR a b (t b k)) (τ12 a b a) v HL,
      nat (α2 b a) (fun k => ρL b a (t b k)) (τ23 a b a) v HR]
    have hcL : (τ12 a b a).comp (α2 a b) = α3 a b a := RingHom.ext (fun x => h3 a b a x)
    have hcR : (τ23 a b a).comp (α2 b a) = α3 a b a := RingHom.ext (fun x => h4 a b a x)
    rw [hcL, hcR]
    exact congrArg (fun u => wcLaurEval n (α3 a b a) u v)
      (funext fun k => h7 a b a (t b k))

theorem wc_chart_h0_chase : ∀ (A : Type u) [CommRing A] (n : ℕ) (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)] (R2 : Fin n → Fin n → Type u) [∀ i j, CommRing (R2 i j)] (α1 : ∀ i, A →+* R1 i) (ρL : ∀ i j, R1 i →+* R2 i j) (ρR : ∀ i j, R1 j →+* R2 i j) (K : Submodule (MvPolynomial (Fin n) A) (Fin 1 → MvPolynomial (Fin n) A)) (Θ1 : ∀ i, (Fin 1 → (Fin n → ℤ) →₀ A) → R1 i) (Θ2 : ∀ i j, (Fin 1 → (Fin n → ℤ) →₀ A) → R2 i j), (∀ i v w, Θ1 i (v + w) = Θ1 i v + Θ1 i w) → (∀ i (a : A) v, Θ1 i (a • v) = α1 i a * Θ1 i v) → (∀ i j v w, Θ2 i j (v + w) = Θ2 i j v + Θ2 i j w) → (∀ i (s : R1 i), ∃ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i}, Θ1 i v = s) → (∀ i v, v ∈ wcLaurK A n 1 (fun _ => 0) K 0 {i} → Θ1 i v = 0) → (∀ i j, i < j → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i, j}, Θ2 i j v = 0 → v ∈ wcLaurK A n 1 (fun _ => 0) K 0 {i, j}) → (∀ i j, i < j → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i}, Θ2 i j v = ρL i j (Θ1 i v)) → (∀ i j, i < j → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {j}, Θ2 i j v = ρR i j (Θ1 j v)) → wcGradedH A n 1 (fun _ => 0) K 0 0 → ∃ (k : ℕ) (c : Fin k → ∀ i, R1 i), ∀ z : ∀ i, R1 i, (∀ i j, ρR i j (z j) = ρL i j (z i)) → ∃ b : Fin k → A, z = fun i => ∑ l, α1 i (b l) * c l i :=
by
  classical
  intro A _ n R1 _ R2 _ α1 ρL ρR K Θ1 Θ2 hΘ1add hΘ1smul hΘ2add hsurj hkill hker hF1 hF2 hH0
  let Θ1h : ∀ i, (Fin 1 → (Fin n → ℤ) →₀ A) →+ R1 i := fun i =>
    AddMonoidHom.mk' (Θ1 i) (hΘ1add i)
  let Θ2h : ∀ i j, (Fin 1 → (Fin n → ℤ) →₀ A) →+ R2 i j := fun i j =>
    AddMonoidHom.mk' (Θ2 i j) (hΘ2add i j)
  have hΘ1sub : ∀ i v w, Θ1 i (v - w) = Θ1 i v - Θ1 i w := fun i v w => map_sub (Θ1h i) v w
  have hΘ2sub : ∀ i j v w, Θ2 i j (v - w) = Θ2 i j v - Θ2 i j w := fun i j v w =>
    map_sub (Θ2h i j) v w
  have hΘ1sum : ∀ i (m : ℕ) (f : Fin m → (Fin 1 → (Fin n → ℤ) →₀ A)),
      Θ1 i (∑ l, f l) = ∑ l, Θ1 i (f l) := fun i m f => map_sum (Θ1h i) f Finset.univ
  obtain ⟨k, C, hC⟩ := hH0
  refine ⟨k, fun l i => Θ1 i (C l {i}), ?_⟩
  intro z hz
  choose Zh hZhC hZh using hsurj
  let Z : Finset (Fin n) → Fin 1 → (Fin n → ℤ) →₀ A := fun σ =>
    ∑ j : Fin n, if σ = {j} then Zh j (z j) else 0
  have hZs : ∀ i, Z {i} = Zh i (z i) := by
    intro i
    simp only [Z, Finset.singleton_inj]
    simp
  have hZ0 : ∀ σ : Finset (Fin n), σ.card ≠ 1 → Z σ = 0 := by
    intro σ hσ
    apply Finset.sum_eq_zero
    intro j _
    rw [if_neg]
    rintro rfl
    exact hσ (Finset.card_singleton j)
  have hmono : ∀ (σ σ' : Finset (Fin n)), σ ⊆ σ' → ∀ v,
      v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ → v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ' := by
    intro σ σ' hss v hv r
    refine Finsupp.supported_mono ?_ (hv r)
    rintro β ⟨h1, h2⟩
    exact ⟨h1, fun i hi => h2 i (fun h => hi (hss h))⟩
  have hsubC : ∀ σ v w, v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ →
      w ∈ wcLaurC A n 1 (fun _ => 0) 0 σ → v - w ∈ wcLaurC A n 1 (fun _ => 0) 0 σ := by
    intro σ v w hv hw r
    exact Submodule.sub_mem _ (hv r) (hw r)
  have hpair : ∀ (W : Finset (Fin n) → Fin 1 → (Fin n → ℤ) →₀ A) (a b : Fin n), a < b →
      wcAltD (A := A) n W {a, b} = W {b} - W {a} := by
    intro W a b hab
    have e1 : ({a, b} : Finset (Fin n)).filter (· < a) = ∅ := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton,
        Finset.notMem_empty, iff_false, not_and]
      rintro (rfl | rfl) h
      · exact lt_irrefl _ h
      · exact lt_asymm hab h
    have e2 : ({a, b} : Finset (Fin n)).filter (· < b) = {a} := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton]
      constructor
      · rintro ⟨rfl | rfl, h⟩
        · rfl
        · exact absurd h (lt_irrefl _)
      · rintro rfl
        exact ⟨Or.inl rfl, hab⟩
    have e3 : ({a, b} : Finset (Fin n)).erase a = {b} :=
      Finset.erase_insert (by simpa using hab.ne)
    have e4 : ({a, b} : Finset (Fin n)).erase b = {a} := by
      rw [Finset.erase_insert_of_ne hab.ne, Finset.erase_singleton, Finset.insert_empty]
    unfold wcAltD
    rw [Finset.sum_pair hab.ne, e1, e2, e3, e4, Finset.card_empty, Finset.card_singleton,
      pow_zero, pow_one, one_smul, neg_one_smul]
    exact (sub_eq_add_neg _ _).symm
  have hadm : ∀ τ : Finset (Fin n), τ.card = 0 + 2 →
      wcAltD (A := A) n Z τ ∈ wcLaurK A n 1 (fun _ => 0) K 0 τ := by
    intro τ hτ
    obtain ⟨x, y, hxy, rfl⟩ := Finset.card_eq_two.mp hτ
    have key : ∀ a b : Fin n, a < b →
        wcAltD (A := A) n Z {a, b} ∈ wcLaurK A n 1 (fun _ => 0) K 0 {a, b} := by
      intro a b hab
      rw [hpair Z a b hab, hZs, hZs]
      apply hker a b hab
      · apply hsubC
        · exact hmono {b} {a, b} (by simp) _ (hZhC b (z b))
        · exact hmono {a} {a, b} (by simp) _ (hZhC a (z a))
      · rw [hΘ2sub, hF2 a b hab _ (hZhC b (z b)), hF1 a b hab _ (hZhC a (z a)), hZh, hZh,
          hz a b, sub_self]
    rcases lt_or_gt_of_ne hxy with h | h
    · exact key x y h
    · rw [Finset.pair_comm]
      exact key y x h
  have hZadm : ∀ σ : Finset (Fin n), (σ.card = 0 + 1 → Z σ ∈ wcLaurC A n 1 (fun _ => 0) 0 σ) ∧
      (σ.card ≠ 0 + 1 → Z σ = 0) := by
    intro σ
    refine ⟨fun h => ?_, fun h => hZ0 σ h⟩
    obtain ⟨i, rfl⟩ := Finset.card_eq_one.mp h
    rw [hZs]
    exact hZhC i (z i)
  obtain ⟨a, y, -, hy0, hres⟩ := hC Z hZadm hadm
  have hy : y = 0 := hy0 rfl
  subst hy
  refine ⟨a, ?_⟩
  funext i
  have hmem := hres {i} (Finset.card_singleton i)
  have hd0 : wcAltD (A := A) n (0 : Finset (Fin n) → Fin 1 → (Fin n → ℤ) →₀ A) {i} = 0 := by
    simp [wcAltD]
  rw [hd0, sub_zero, hZs] at hmem
  have h1 := hkill i _ hmem
  rw [hΘ1sub, hZh, hΘ1sum, sub_eq_zero] at h1
  show z i = ∑ l, α1 i (a l) * Θ1 i (C l {i})
  rw [h1]
  refine Finset.sum_congr rfl (fun l _ => ?_)
  exact hΘ1smul i (a l) (C l {i})

theorem wc_chart_h1_chase : ∀ (A : Type u) [CommRing A] (n : ℕ) (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)] (R2 : Fin n → Fin n → Type u) [∀ i j, CommRing (R2 i j)] (R3 : Fin n → Fin n → Fin n → Type u) [∀ i j l, CommRing (R3 i j l)] (α1 : ∀ i, A →+* R1 i) (α2 : ∀ i j, A →+* R2 i j) (α3 : ∀ i j l, A →+* R3 i j l) (ρL : ∀ i j, R1 i →+* R2 i j) (ρR : ∀ i j, R1 j →+* R2 i j) (τ12 : ∀ i j l, R2 i j →+* R3 i j l) (τ23 : ∀ i j l, R2 j l →+* R3 i j l) (τ13 : ∀ i j l, R2 i l →+* R3 i j l) (t : ∀ i : Fin n, Fin n → R1 i) (K : Submodule (MvPolynomial (Fin n) A) (Fin 1 → MvPolynomial (Fin n) A)) (Θ1 : ∀ i, (Fin 1 → (Fin n → ℤ) →₀ A) → R1 i) (Θ2 Θ2' : ∀ i j, (Fin 1 → (Fin n → ℤ) →₀ A) → R2 i j) (Θ3 : ∀ i j l, (Fin 1 → (Fin n → ℤ) →₀ A) → R3 i j l), wcChartSys A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t → (∀ i v w, Θ1 i (v + w) = Θ1 i v + Θ1 i w) → (∀ i j v w, Θ2 i j (v + w) = Θ2 i j v + Θ2 i j w) → (∀ i j (a : A) v, Θ2 i j (a • v) = α2 i j a * Θ2 i j v) → (∀ i j v w, Θ2' i j (v + w) = Θ2' i j v + Θ2' i j w) → (∀ i j (a : A) v, Θ2' i j (a • v) = α2 i j a * Θ2' i j v) → (∀ i j l v w, Θ3 i j l (v + w) = Θ3 i j l v + Θ3 i j l w) → (∀ i j, i < j → ∀ s : R2 i j, ∃ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i, j}, Θ2 i j v = s) → (∀ i j, i < j → ∀ v, v ∈ wcLaurK A n 1 (fun _ => 0) K 0 {i, j} → Θ2 i j v = 0) → (∀ i j l, i < j → j < l → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i, j, l}, Θ3 i j l v = 0 → v ∈ wcLaurK A n 1 (fun _ => 0) K 0 {i, j, l}) → (∀ σ v, v ∈ wcLaurK A n 1 (fun _ => 0) K 0 σ → v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ) → (∀ i j, i < j → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i}, Θ2 i j v = ρL i j (Θ1 i v)) → (∀ i j, i < j → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {j}, Θ2 i j v = ρR i j (Θ1 j v)) → (∀ i j l, i < j → j < l → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i, j}, Θ3 i j l v = τ12 i j l (Θ2 i j v)) → (∀ i j l, i < j → j < l → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i, l}, Θ3 i j l v = τ13 i j l (Θ2 i l v)) → (∀ i j l, i < j → j < l → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {j, l}, Θ3 i j l v = τ23 i j l (Θ2 j l v)) → (∀ a b, b < a → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {a, b}, τ12 a b a (Θ2' a b v) = τ23 a b a (Θ2 b a v)) → (∀ a b (s : R2 a b), τ12 a b a s = 0 → s = 0) → (∀ a (s : R2 a a), τ23 a a a s = τ12 a a a s ∧ τ13 a a a s = τ12 a a a s) → wcGradedH A n 1 (fun _ => 0) K 1 0 → ∃ (k : ℕ) (c : Fin k → ∀ p : Fin n × Fin n, R2 p.1 p.2), ∀ z : ∀ p : Fin n × Fin n, R2 p.1 p.2, (∀ i j l, τ12 i j l (z (i, j)) + τ23 i j l (z (j, l)) = τ13 i j l (z (i, l))) → ∃ (b : Fin k → A) (w : ∀ i, R1 i), z = fun p => ∑ l, α2 p.1 p.2 (b l) * c l p + (ρR p.1 p.2 (w p.2) - ρL p.1 p.2 (w p.1)) :=
by
  classical
  intro A _ n R1 _ R2 _ R3 _ α1 α2 α3 ρL ρR τ12 τ23 τ13 t K Θ1 Θ2 Θ2' Θ3 hsys hΘ1add hΘ2add
    hΘ2smul hΘ2'add hΘ2'smul hΘ3add hsurj hkill hker3 hKC hF1 hF2 hF3 hF4 hF5 hF6 hinj hdiag hH1
  obtain ⟨-, -, -, -, -, h6, h7, h8, -, -, -, -, -, -, h15⟩ := id hsys

  let Θ2h : ∀ i j, (Fin 1 → (Fin n → ℤ) →₀ A) →+ R2 i j := fun i j =>
    AddMonoidHom.mk' (Θ2 i j) (hΘ2add i j)
  let Θ2'h : ∀ i j, (Fin 1 → (Fin n → ℤ) →₀ A) →+ R2 i j := fun i j =>
    AddMonoidHom.mk' (Θ2' i j) (hΘ2'add i j)
  let Θ3h : ∀ i j l, (Fin 1 → (Fin n → ℤ) →₀ A) →+ R3 i j l := fun i j l =>
    AddMonoidHom.mk' (Θ3 i j l) (hΘ3add i j l)
  have hΘ2sub : ∀ i j v w, Θ2 i j (v - w) = Θ2 i j v - Θ2 i j w := fun i j v w =>
    map_sub (Θ2h i j) v w
  have hΘ3sub : ∀ i j l v w, Θ3 i j l (v - w) = Θ3 i j l v - Θ3 i j l w := fun i j l v w =>
    map_sub (Θ3h i j l) v w
  have hΘ2sum : ∀ i j (m : ℕ) (f : Fin m → (Fin 1 → (Fin n → ℤ) →₀ A)),
      Θ2 i j (∑ l, f l) = ∑ l, Θ2 i j (f l) := fun i j m f => map_sum (Θ2h i j) f Finset.univ
  have hΘ2'sum : ∀ i j (m : ℕ) (f : Fin m → (Fin 1 → (Fin n → ℤ) →₀ A)),
      Θ2' i j (∑ l, f l) = ∑ l, Θ2' i j (f l) := fun i j m f => map_sum (Θ2'h i j) f Finset.univ

  have hmono : ∀ (σ σ' : Finset (Fin n)), σ ⊆ σ' → ∀ v,
      v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ → v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ' := by
    intro σ σ' hss v hv r
    refine Finsupp.supported_mono ?_ (hv r)
    rintro β ⟨h1, h2⟩
    exact ⟨h1, fun i hi => h2 i (fun h => hi (hss h))⟩
  have hsubC : ∀ σ v w, v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ →
      w ∈ wcLaurC A n 1 (fun _ => 0) 0 σ → v - w ∈ wcLaurC A n 1 (fun _ => 0) 0 σ := by
    intro σ v w hv hw r
    exact Submodule.sub_mem _ (hv r) (hw r)
  have haddC : ∀ σ v w, v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ →
      w ∈ wcLaurC A n 1 (fun _ => 0) 0 σ → v + w ∈ wcLaurC A n 1 (fun _ => 0) 0 σ := by
    intro σ v w hv hw r
    exact Submodule.add_mem _ (hv r) (hw r)

  have hpair : ∀ (W : Finset (Fin n) → Fin 1 → (Fin n → ℤ) →₀ A) (a b : Fin n), a < b →
      wcAltD (A := A) n W {a, b} = W {b} - W {a} := by
    intro W a b hab
    have e1 : ({a, b} : Finset (Fin n)).filter (· < a) = ∅ := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton,
        Finset.notMem_empty, iff_false, not_and]
      rintro (rfl | rfl) h
      · exact lt_irrefl _ h
      · exact lt_asymm hab h
    have e2 : ({a, b} : Finset (Fin n)).filter (· < b) = {a} := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton]
      constructor
      · rintro ⟨rfl | rfl, h⟩
        · rfl
        · exact absurd h (lt_irrefl _)
      · rintro rfl
        exact ⟨Or.inl rfl, hab⟩
    have e3 : ({a, b} : Finset (Fin n)).erase a = {b} :=
      Finset.erase_insert (by simpa using hab.ne)
    have e4 : ({a, b} : Finset (Fin n)).erase b = {a} := by
      rw [Finset.erase_insert_of_ne hab.ne, Finset.erase_singleton, Finset.insert_empty]
    unfold wcAltD
    rw [Finset.sum_pair hab.ne, e1, e2, e3, e4, Finset.card_empty, Finset.card_singleton,
      pow_zero, pow_one, one_smul, neg_one_smul]
    exact (sub_eq_add_neg _ _).symm
  have htriple : ∀ (W : Finset (Fin n) → Fin 1 → (Fin n → ℤ) →₀ A) (i j l : Fin n), i < j → j < l →
      wcAltD (A := A) n W {i, j, l} = W {j, l} - W {i, l} + W {i, j} := by
    intro W i j l hij hjl
    have hil : i < l := hij.trans hjl
    have hi : i ∉ ({j, l} : Finset (Fin n)) := by simp [hij.ne, hil.ne]
    have hj : j ∉ ({l} : Finset (Fin n)) := by simp [hjl.ne]
    have e1 : ({i, j, l} : Finset (Fin n)).filter (· < i) = ∅ := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton,
        Finset.notMem_empty, iff_false, not_and]
      rintro (rfl | rfl | rfl) h
      · exact lt_irrefl _ h
      · exact lt_asymm hij h
      · exact lt_asymm hil h
    have e2 : ({i, j, l} : Finset (Fin n)).filter (· < j) = {i} := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton]
      constructor
      · rintro ⟨rfl | rfl | rfl, h⟩
        · rfl
        · exact absurd h (lt_irrefl _)
        · exact absurd h (lt_asymm hjl)
      · rintro rfl
        exact ⟨Or.inl rfl, hij⟩
    have e3 : ({i, j, l} : Finset (Fin n)).filter (· < l) = {i, j} := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton]
      constructor
      · rintro ⟨rfl | rfl | rfl, h⟩
        · exact Or.inl rfl
        · exact Or.inr rfl
        · exact absurd h (lt_irrefl _)
      · rintro (rfl | rfl)
        · exact ⟨Or.inl rfl, hil⟩
        · exact ⟨Or.inr (Or.inl rfl), hjl⟩
    have e4 : ({i, j, l} : Finset (Fin n)).erase i = {j, l} := Finset.erase_insert hi
    have e5 : ({i, j, l} : Finset (Fin n)).erase j = {i, l} := by
      rw [Finset.erase_insert_of_ne hij.ne, Finset.erase_insert hj]
    have e6 : ({i, j, l} : Finset (Fin n)).erase l = {i, j} := by
      rw [Finset.erase_insert_of_ne hil.ne, Finset.erase_insert_of_ne hjl.ne,
        Finset.erase_singleton, Finset.insert_empty]
    unfold wcAltD
    rw [Finset.sum_insert hi, Finset.sum_pair hjl.ne, e1, e2, e3, e4, e5, e6]
    simp only [Finset.card_empty, Finset.card_singleton, Finset.card_pair hij.ne, pow_zero,
      pow_one, neg_one_sq, one_smul, neg_one_smul]
    abel

  have hsort2 : ∀ σ : Finset (Fin n), σ.card = 2 → ∃ a b : Fin n, a < b ∧ σ = {a, b} := by
    intro σ hσ
    obtain ⟨x, y, hxy, rfl⟩ := Finset.card_eq_two.mp hσ
    rcases lt_or_gt_of_ne hxy with h | h
    · exact ⟨x, y, h, rfl⟩
    · exact ⟨y, x, h, Finset.pair_comm x y⟩
  have hsort3 : ∀ τ : Finset (Fin n), τ.card = 3 →
      ∃ i j l : Fin n, i < j ∧ j < l ∧ τ = {i, j, l} := by
    intro τ hτ
    obtain ⟨x, y, w, hxy, hxw, hyw, rfl⟩ := Finset.card_eq_three.mp hτ
    have hperm : ∀ a b c : Fin n, ∀ s : Finset (Fin n),
        (∀ v, v ∈ s ↔ v = a ∨ v = b ∨ v = c) → s = {a, b, c} := by
      intro a b c s hs
      ext v
      rw [hs v]
      simp only [Finset.mem_insert, Finset.mem_singleton]
    have hmem : ∀ v, v ∈ ({x, y, w} : Finset (Fin n)) ↔ v = x ∨ v = y ∨ v = w := by
      intro v
      simp only [Finset.mem_insert, Finset.mem_singleton]
    rcases lt_or_gt_of_ne hxy with h1 | h1 <;> rcases lt_or_gt_of_ne hxw with h2 | h2 <;>
      rcases lt_or_gt_of_ne hyw with h3 | h3
    all_goals first
      | exact ⟨x, y, w, by assumption, by assumption,
          hperm _ _ _ _ fun v => by rw [hmem]; try tauto⟩
      | exact ⟨x, w, y, by assumption, by assumption,
          hperm _ _ _ _ fun v => by rw [hmem]; try tauto⟩
      | exact ⟨y, x, w, by assumption, by assumption,
          hperm _ _ _ _ fun v => by rw [hmem]; try tauto⟩
      | exact ⟨y, w, x, by assumption, by assumption,
          hperm _ _ _ _ fun v => by rw [hmem]; try tauto⟩
      | exact ⟨w, x, y, by assumption, by assumption,
          hperm _ _ _ _ fun v => by rw [hmem]; try tauto⟩
      | exact ⟨w, y, x, by assumption, by assumption,
          hperm _ _ _ _ fun v => by rw [hmem]; try tauto⟩
      | (exfalso; simp only [Fin.lt_def, gt_iff_lt] at h1 h2 h3; omega)

  have hrig : ∀ a b a' b' : Fin n, a < b → a' < b' →
      ({a, b} : Finset (Fin n)) = {a', b'} → a' = a ∧ b' = b := by
    intro a b a' b' hab hab' h
    have ha' : a' ∈ ({a, b} : Finset (Fin n)) := by
      rw [h]; exact Finset.mem_insert_self a' {b'}
    have hb' : b' ∈ ({a, b} : Finset (Fin n)) := by
      rw [h]; exact Finset.mem_insert_of_mem (Finset.mem_singleton_self b')
    simp only [Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff] at ha' hb'
    rw [Fin.lt_def] at hab hab'
    rw [Fin.ext_iff, Fin.ext_iff]
    omega

  obtain ⟨k, C, hC⟩ := hH1
  refine ⟨k, fun l p => if p.1 < p.2 then Θ2 p.1 p.2 (C l {p.1, p.2})
    else if p.2 < p.1 then -Θ2' p.1 p.2 (C l {p.1, p.2}) else 0, ?_⟩
  intro z hz

  have hdiag0 : ∀ a, z (a, a) = 0 := by
    intro a
    have h := hz a a a
    rw [(hdiag a _).1, (hdiag a _).2] at h
    apply hinj a a
    linear_combination h
  have hanti : ∀ a b, τ12 a b a (z (a, b)) + τ23 a b a (z (b, a)) = 0 := by
    intro a b
    have h := hz a b a
    rw [hdiag0 a, map_zero] at h
    exact h

  have hlift : ∀ a b : Fin n, ∃ v : Fin 1 → (Fin n → ℤ) →₀ A, a < b →
      v ∈ wcLaurC A n 1 (fun _ => 0) 0 {a, b} ∧ Θ2 a b v = z (a, b) := by
    intro a b
    by_cases h : a < b
    · obtain ⟨v, hv, he⟩ := hsurj a b h (z (a, b))
      exact ⟨v, fun _ => ⟨hv, he⟩⟩
    · exact ⟨0, fun h' => absurd h' h⟩
  choose zh hzh using hlift
  let Z : Finset (Fin n) → Fin 1 → (Fin n → ℤ) →₀ A := fun σ =>
    ∑ a : Fin n, ∑ b : Fin n, if a < b ∧ σ = {a, b} then zh a b else 0
  have hZpair : ∀ a b, a < b → Z {a, b} = zh a b := by
    intro a b hab
    have hin : ∀ a' : Fin n, a' ≠ a → (∑ b' : Fin n,
        if a' < b' ∧ ({a, b} : Finset (Fin n)) = {a', b'} then zh a' b' else 0) = 0 := by
      intro a' ha'
      apply Finset.sum_eq_zero
      intro b' _
      rw [if_neg]
      rintro ⟨h1, h2⟩
      exact ha' (hrig a b a' b' hab h1 h2).1
    have hin2 : ∀ b' : Fin n, b' ≠ b →
        (if a < b' ∧ ({a, b} : Finset (Fin n)) = {a, b'} then zh a b' else 0) = 0 := by
      intro b' hb'
      rw [if_neg]
      rintro ⟨h1, h2⟩
      exact hb' (hrig a b a b' hab h1 h2).2
    show (∑ a' : Fin n, ∑ b' : Fin n,
      if a' < b' ∧ ({a, b} : Finset (Fin n)) = {a', b'} then zh a' b' else 0) = zh a b
    rw [Finset.sum_eq_single_of_mem a (Finset.mem_univ a) (fun a' _ h => hin a' h),
      Finset.sum_eq_single_of_mem b (Finset.mem_univ b) (fun b' _ h => hin2 b' h),
      if_pos ⟨hab, rfl⟩]
  have hZ0 : ∀ σ : Finset (Fin n), σ.card ≠ 1 + 1 → Z σ = 0 := by
    intro σ hσ
    show (∑ a : Fin n, ∑ b : Fin n, if a < b ∧ σ = {a, b} then zh a b else 0) = 0
    apply Finset.sum_eq_zero
    intro a _
    apply Finset.sum_eq_zero
    intro b _
    rw [if_neg]
    rintro ⟨hab, rfl⟩
    exact hσ (Finset.card_pair hab.ne)
  have hZadm : ∀ σ : Finset (Fin n), (σ.card = 1 + 1 → Z σ ∈ wcLaurC A n 1 (fun _ => 0) 0 σ) ∧
      (σ.card ≠ 1 + 1 → Z σ = 0) := by
    intro σ
    refine ⟨fun h => ?_, fun h => hZ0 σ h⟩
    obtain ⟨a, b, hab, rfl⟩ := hsort2 σ h
    rw [hZpair a b hab]
    exact (hzh a b hab).1
  have hadm : ∀ τ : Finset (Fin n), τ.card = 1 + 2 →
      wcAltD (A := A) n Z τ ∈ wcLaurK A n 1 (fun _ => 0) K 0 τ := by
    intro τ hτ
    obtain ⟨i, j, l, hij, hjl, rfl⟩ := hsort3 τ hτ
    have hil := hij.trans hjl
    rw [htriple Z i j l hij hjl, hZpair j l hjl, hZpair i l hil, hZpair i j hij]
    obtain ⟨hCjl, hΘjl⟩ := hzh j l hjl
    obtain ⟨hCil, hΘil⟩ := hzh i l hil
    obtain ⟨hCij, hΘij⟩ := hzh i j hij
    have s1 : ({j, l} : Finset (Fin n)) ⊆ {i, j, l} := Finset.subset_insert _ _
    have s2 : ({i, l} : Finset (Fin n)) ⊆ {i, j, l} := by
      intro x
      simp only [Finset.mem_insert, Finset.mem_singleton]
      tauto
    have s3 : ({i, j} : Finset (Fin n)) ⊆ {i, j, l} := by
      intro x
      simp only [Finset.mem_insert, Finset.mem_singleton]
      tauto
    apply hker3 i j l hij hjl
    · exact haddC _ _ _ (hsubC _ _ _ (hmono _ _ s1 _ hCjl) (hmono _ _ s2 _ hCil))
        (hmono _ _ s3 _ hCij)
    · rw [hΘ3add, hΘ3sub, hF5 i j l hij hjl _ hCjl, hF4 i j l hij hjl _ hCil,
        hF3 i j l hij hjl _ hCij, hΘjl, hΘil, hΘij]
      linear_combination hz i j l
  obtain ⟨cf, y, hy, -, hrel⟩ := hC Z hZadm hadm
  have hyC : ∀ i, y {i} ∈ wcLaurC A n 1 (fun _ => 0) 0 {i} := fun i =>
    (hy {i}).1 (Finset.card_singleton i)

  have hkey : ∀ p q : Fin n, p < q → z (p, q) = ∑ l, α2 p q (cf l) * Θ2 p q (C l {p, q}) +
      (ρR p q (Θ1 q (y {q})) - ρL p q (Θ1 p (y {p}))) := by
    intro p q hpq
    have hm := hrel {p, q} (Finset.card_pair hpq.ne)
    rw [hpair y p q hpq, hZpair p q hpq] at hm
    have h0 := hkill p q hpq _ hm
    rw [hΘ2sub, hΘ2sub, hΘ2sub, hΘ2sum, (hzh p q hpq).2, hF2 p q hpq _ (hyC q),
      hF1 p q hpq _ (hyC p)] at h0
    simp only [hΘ2smul] at h0
    linear_combination h0

  have hswap : ∀ a b : Fin n, b < a → z (a, b) = ∑ l, α2 a b (cf l) * -Θ2' a b (C l {a, b}) +
      (ρR a b (Θ1 b (y {b})) - ρL a b (Θ1 a (y {a}))) := by
    intro a b hba
    obtain ⟨S, hS⟩ : ∃ S : Fin 1 → (Fin n → ℤ) →₀ A, S = ∑ l, cf l • C l {b, a} := ⟨_, rfl⟩
    have hm := hrel {b, a} (Finset.card_pair hba.ne)
    rw [hpair y b a hba, hZpair b a hba, ← hS] at hm
    have hSC : S ∈ wcLaurC A n 1 (fun _ => 0) 0 {a, b} := by
      have e : S = zh b a - (y {a} - y {b}) - (zh b a - S - (y {a} - y {b})) := by abel
      rw [Finset.pair_comm, e]
      exact hsubC _ _ _ (hsubC _ _ _ (hzh b a hba).1 (hsubC _ _ _
        (hmono {a} {b, a} (by simp) _ (hyC a)) (hmono {b} {b, a} (by simp) _ (hyC b))))
        (hKC _ _ hm)
    have hQ : Θ2 b a S = z (b, a) - (ρR b a (Θ1 a (y {a})) - ρL b a (Θ1 b (y {b}))) := by
      have h0 := hkill b a hba _ hm
      rw [hΘ2sub, hΘ2sub, hΘ2sub, (hzh b a hba).2, hF2 b a hba _ (hyC a),
        hF1 b a hba _ (hyC b)] at h0
      linear_combination -h0
    have hP : Θ2' a b S = ∑ l, α2 a b (cf l) * Θ2' a b (C l {b, a}) := by
      rw [hS, hΘ2'sum]
      simp only [hΘ2'smul]
    have hF6' := hF6 a b hba S hSC
    rw [hQ] at hF6'
    have he : τ12 a b a (z (a, b) + Θ2' a b S - ρR a b (Θ1 b (y {b})) +
        ρL a b (Θ1 a (y {a}))) = 0 := by
      rw [map_add, map_sub, map_add, h7 a b a, h6 a b a, hF6', map_sub, map_sub, h8 a b a, h15]
      linear_combination hanti a b
    have he0 := hinj a b _ he
    rw [Finset.pair_comm a b]
    simp only [mul_neg, Finset.sum_neg_distrib]
    rw [← hP]
    linear_combination he0

  refine ⟨cf, fun i => Θ1 i (y {i}), ?_⟩
  funext p
  obtain ⟨p1, p2⟩ := p
  dsimp only
  rcases lt_trichotomy p1 p2 with h | rfl | h
  · simp only [if_pos h]
    exact hkey p1 p2 h
  · simp only [lt_irrefl, ↓reduceIte, mul_zero, Finset.sum_const_zero, h15, sub_self, add_zero,
      hdiag0]
  · simp only [if_neg (lt_asymm h), if_pos h]
    exact hswap p1 p2 h

theorem wc_chart_cech_of_graded : ∀ (A : Type u) [CommRing A] (n : ℕ) (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)] (R2 : Fin n → Fin n → Type u) [∀ i j, CommRing (R2 i j)] (R3 : Fin n → Fin n → Fin n → Type u) [∀ i j l, CommRing (R3 i j l)] (α1 : ∀ i, A →+* R1 i) (α2 : ∀ i j, A →+* R2 i j) (α3 : ∀ i j l, A →+* R3 i j l) (ρL : ∀ i j, R1 i →+* R2 i j) (ρR : ∀ i j, R1 j →+* R2 i j) (τ12 : ∀ i j l, R2 i j →+* R3 i j l) (τ23 : ∀ i j l, R2 j l →+* R3 i j l) (τ13 : ∀ i j l, R2 i l →+* R3 i j l) (t : ∀ i : Fin n, Fin n → R1 i), wcChartSys A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t → wcGradedH A n 1 (fun _ => 0) (wcChartJ A n R1 α1 t) 0 0 → wcGradedH A n 1 (fun _ => 0) (wcChartJ A n R1 α1 t) 1 0 → wcChartH01FG A n R1 R2 R3 α1 α2 ρL ρR τ12 τ23 τ13 :=
by
  intro A _ n R1 _ R2 _ R3 _ α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys hH0 hH1
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15⟩ := id hsys

  have hEadd : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin n → T)
      (v w : (Fin n → ℤ) →₀ A),
      wcLaurEval n α u (v + w) = wcLaurEval n α u v + wcLaurEval n α u w := by
    intro T _ α u v w
    unfold wcLaurEval
    exact Finsupp.sum_add_index' (fun _ => by simp) (fun _ _ _ => by rw [map_add, add_mul])
  have hEsmul : ∀ {T : Type u} [CommRing T] (α : A →+* T) (u : Fin n → T) (a : A)
      (v : (Fin n → ℤ) →₀ A), wcLaurEval n α u (a • v) = α a * wcLaurEval n α u v := by
    intro T _ α u a v
    unfold wcLaurEval
    rw [Finsupp.sum_smul_index' (fun _ => by simp), Finsupp.mul_sum]
    refine Finsupp.sum_congr (fun β _ => ?_)
    simp only [smul_eq_mul, map_mul, mul_assoc]

  have hinj : ∀ a b (s : R2 a b), τ12 a b a s = 0 → s = 0 := by
    intro a b s hs
    obtain ⟨hU, hloc, -⟩ := h12 a b
    obtain ⟨N, x, hx⟩ := hloc s
    have hx0 : τ12 a b a (ρL a b x) = 0 := by rw [← hx, map_mul, hs, mul_zero]
    obtain ⟨M, hM⟩ := (h14 a b a).2.2 x hx0
    rw [h10 a, mul_one] at hM
    have hρ : ρL a b x = 0 := by
      have e := congrArg (ρL a b) hM
      rw [map_mul, map_pow, map_zero] at e
      exact (hU.pow M).mul_right_eq_zero.mp e
    rw [hρ] at hx
    exact (hU.pow N).mul_right_eq_zero.mp hx
  have hdiag : ∀ a (s : R2 a a), τ23 a a a s = τ12 a a a s ∧ τ13 a a a s = τ12 a a a s := by
    intro a s
    obtain ⟨N, x, hx⟩ := (h12 a a).2.1 s
    rw [h10 a, map_one, one_pow, one_mul] at hx
    rw [hx]
    exact ⟨by rw [← h7 a a a x, h15], (h6 a a a x).symm⟩

  have hKC : ∀ (σ : Finset (Fin n)) (v : Fin 1 → (Fin n → ℤ) →₀ A),
      v ∈ wcLaurK A n 1 (fun _ => 0) (wcChartJ A n R1 α1 t) 0 σ →
      v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ := by
    intro σ v hv
    unfold wcLaurK at hv
    induction hv using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨k, f, -, hdeg, rfl⟩ := hx
      simp only [wcLaurC, Set.mem_setOf_eq]
      intro r
      refine Submodule.sum_mem _ (fun m hm => Finsupp.single_mem_supported A _ ?_)
      refine ⟨?_, fun i hi => by simp [hi]⟩
      have e := hdeg r m hm
      simp only [Finset.sum_sub_distrib, Finset.sum_ite_mem, Finset.univ_inter,
        Finset.sum_const, nsmul_eq_mul]
      push_cast at e ⊢
      linarith
    | zero =>
      simp only [wcLaurC, Set.mem_setOf_eq]
      intro r
      exact Submodule.zero_mem _
    | add x y _ _ hx hy =>
      simp only [wcLaurC, Set.mem_setOf_eq] at hx hy ⊢
      intro r
      exact Submodule.add_mem _ (hx r) (hy r)
    | smul a x _ hx =>
      simp only [wcLaurC, Set.mem_setOf_eq] at hx ⊢
      intro r
      exact Submodule.smul_mem _ a (hx r)

  have hsupp : ∀ (σ : Finset (Fin n)) (v : Fin 1 → (Fin n → ℤ) →₀ A),
      v ∈ wcLaurC A n 1 (fun _ => 0) 0 σ →
      ∀ β ∈ (v 0).support, ∑ k, β k = 0 ∧ ∀ k, k ∉ σ → 0 ≤ β k := by
    intro σ v hv β hβ
    simp only [wcLaurC, Set.mem_setOf_eq] at hv
    have h := (Finsupp.mem_supported A (v 0)).mp (hv 0) hβ
    simp only [Set.mem_setOf_eq] at h
    exact ⟨by simpa using h.1, h.2⟩

  have hprod1 : ∀ i : Fin n, ∏ k ∈ ({i} : Finset (Fin n)), t i k = 1 := fun i => by
    rw [Finset.prod_singleton, h10 i]
  have hprod2 : ∀ i j : Fin n, i < j → ∏ k ∈ ({i, j} : Finset (Fin n)), t i k = t i j :=
    fun i j hij => by rw [Finset.prod_pair hij.ne, h10 i, one_mul]
  have hprod3 : ∀ i j l : Fin n, i < j → j < l →
      ∏ k ∈ ({i, j, l} : Finset (Fin n)), t i k = t i j * t i l := by
    intro i j l hij hjl
    rw [Finset.prod_insert (by simp [hij.ne, (hij.trans hjl).ne]), Finset.prod_pair hjl.ne,
      h10 i, one_mul]
  have hc1 : ∀ i j, (ρL i j).comp (α1 i) = α2 i j := fun i j => RingHom.ext (fun a => h1 i j a)
  have hc3 : ∀ i j l, ((τ12 i j l).comp (ρL i j)).comp (α1 i) = α3 i j l := fun i j l =>
    RingHom.ext (fun a => by simp only [RingHom.comp_apply, h1, h3])

  have hsurj1 : ∀ i (s : R1 i), ∃ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i},
      wcLaurEval n (α1 i) (t i) (v 0) = s := by
    intro i s
    obtain ⟨v, hv, he⟩ := wc_chart_theta_surj A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
      i {i} (R1 i) (RingHom.id _) (Finset.mem_singleton_self i)
      (by rw [hprod1 i]; exact isUnit_one)
      (fun s => ⟨0, s, by simp⟩) s
    exact ⟨v, hv, by simpa using he⟩
  have hkill1 : ∀ i v, v ∈ wcLaurK A n 1 (fun _ => 0) (wcChartJ A n R1 α1 t) 0 {i} →
      wcLaurEval n (α1 i) (t i) (v 0) = 0 := by
    intro i v hv
    have e := (wc_chart_theta_ker A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
      i {i} (R1 i) (RingHom.id _) (Finset.mem_singleton_self i)
      (by rw [hprod1 i]; exact isUnit_one)
      (fun x hx => ⟨0, by simpa using hx⟩) v (hKC _ _ hv)).mpr hv
    simpa using e

  have hsurj2 : ∀ i j, i < j → ∀ s : R2 i j, ∃ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i, j},
      wcLaurEval n (α2 i j) (fun k => ρL i j (t i k)) (v 0) = s := by
    intro i j hij s
    obtain ⟨v, hv, he⟩ := wc_chart_theta_surj A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
      i {i, j} (R2 i j) (ρL i j) (Finset.mem_insert_self _ _)
      (by rw [hprod2 i j hij]; exact (h12 i j).1)
      (by rw [hprod2 i j hij]; exact (h12 i j).2.1) s
    rw [hc1] at he
    exact ⟨v, hv, he⟩
  have hkill2 : ∀ i j, i < j → ∀ v,
      v ∈ wcLaurK A n 1 (fun _ => 0) (wcChartJ A n R1 α1 t) 0 {i, j} →
      wcLaurEval n (α2 i j) (fun k => ρL i j (t i k)) (v 0) = 0 := by
    intro i j hij v hv
    have e := (wc_chart_theta_ker A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
      i {i, j} (R2 i j) (ρL i j) (Finset.mem_insert_self _ _)
      (by rw [hprod2 i j hij]; exact (h12 i j).1)
      (by rw [hprod2 i j hij]; exact (h12 i j).2.2) v (hKC _ _ hv)).mpr hv
    rw [hc1] at e
    exact e
  have hker2 : ∀ i j, i < j → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i, j},
      wcLaurEval n (α2 i j) (fun k => ρL i j (t i k)) (v 0) = 0 →
      v ∈ wcLaurK A n 1 (fun _ => 0) (wcChartJ A n R1 α1 t) 0 {i, j} := by
    intro i j hij v hv h0
    refine (wc_chart_theta_ker A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
      i {i, j} (R2 i j) (ρL i j) (Finset.mem_insert_self _ _)
      (by rw [hprod2 i j hij]; exact (h12 i j).1)
      (by rw [hprod2 i j hij]; exact (h12 i j).2.2) v hv).mp ?_
    rw [hc1]
    exact h0

  have hker3 : ∀ i j l, i < j → j < l → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i, j, l},
      wcLaurEval n (α3 i j l) (fun k => τ12 i j l (ρL i j (t i k))) (v 0) = 0 →
      v ∈ wcLaurK A n 1 (fun _ => 0) (wcChartJ A n R1 α1 t) 0 {i, j, l} := by
    intro i j l hij hjl v hv h0
    refine (wc_chart_theta_ker A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
      i {i, j, l} (R3 i j l) ((τ12 i j l).comp (ρL i j)) (Finset.mem_insert_self _ _)
      (by rw [hprod3 i j l hij hjl]; exact (h14 i j l).1)
      (by rw [hprod3 i j l hij hjl]; exact (h14 i j l).2.2) v hv).mp ?_
    rw [hc3]
    exact h0

  have hF := wc_chart_faces_one_two A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
  have hG := wc_chart_faces_two_three A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
  have hF1 : ∀ i j, i < j → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i},
      wcLaurEval n (α2 i j) (fun k => ρL i j (t i k)) (v 0) =
        ρL i j (wcLaurEval n (α1 i) (t i) (v 0)) := by
    intro i j _ v hv
    exact (hF.1 i j (v 0) (fun β hβ => ⟨(hsupp _ v hv β hβ).1,
      fun k hk => (hsupp _ v hv β hβ).2 k (by simpa using hk)⟩)).symm
  have hF2 : ∀ i j, i < j → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {j},
      wcLaurEval n (α2 i j) (fun k => ρL i j (t i k)) (v 0) =
        ρR i j (wcLaurEval n (α1 j) (t j) (v 0)) := by
    intro i j _ v hv
    exact (hF.2 i j (v 0) (fun β hβ => ⟨(hsupp _ v hv β hβ).1,
      fun k hk => (hsupp _ v hv β hβ).2 k (by simpa using hk)⟩)).symm
  have hF3 : ∀ i j l, i < j → j < l → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i, j},
      wcLaurEval n (α3 i j l) (fun k => τ12 i j l (ρL i j (t i k))) (v 0) =
        τ12 i j l (wcLaurEval n (α2 i j) (fun k => ρL i j (t i k)) (v 0)) := by
    intro i j l _ _ v hv
    exact (hG.1 i j l (v 0) (fun β hβ => ⟨(hsupp _ v hv β hβ).1,
      fun k hk1 hk2 => (hsupp _ v hv β hβ).2 k (by simp [hk1, hk2])⟩)).symm
  have hF4 : ∀ i j l, i < j → j < l → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {i, l},
      wcLaurEval n (α3 i j l) (fun k => τ12 i j l (ρL i j (t i k))) (v 0) =
        τ13 i j l (wcLaurEval n (α2 i l) (fun k => ρL i l (t i k)) (v 0)) := by
    intro i j l _ _ v hv
    exact (hG.2.1 i j l (v 0) (fun β hβ => ⟨(hsupp _ v hv β hβ).1,
      fun k hk1 hk2 => (hsupp _ v hv β hβ).2 k (by simp [hk1, hk2])⟩)).symm
  have hF5 : ∀ i j l, i < j → j < l → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {j, l},
      wcLaurEval n (α3 i j l) (fun k => τ12 i j l (ρL i j (t i k))) (v 0) =
        τ23 i j l (wcLaurEval n (α2 j l) (fun k => ρL j l (t j k)) (v 0)) := by
    intro i j l _ _ v hv
    exact (hG.2.2.1 i j l (v 0) (fun β hβ => ⟨(hsupp _ v hv β hβ).1,
      fun k hk1 hk2 => (hsupp _ v hv β hβ).2 k (by simp [hk1, hk2])⟩)).symm
  have hF6 : ∀ a b, b < a → ∀ v ∈ wcLaurC A n 1 (fun _ => 0) 0 {a, b},
      τ12 a b a (wcLaurEval n (α2 a b) (fun k => ρR a b (t b k)) (v 0)) =
        τ23 a b a (wcLaurEval n (α2 b a) (fun k => ρL b a (t b k)) (v 0)) := by
    intro a b _ v hv
    exact hG.2.2.2 a b (v 0) (fun β hβ => ⟨(hsupp _ v hv β hβ).1,
      fun k hk1 hk2 => (hsupp _ v hv β hβ).2 k (by simp [hk1, hk2])⟩)

  refine ⟨?_, ?_⟩
  · exact wc_chart_h0_chase A n R1 R2 α1 ρL ρR (wcChartJ A n R1 α1 t)
      (fun i v => wcLaurEval n (α1 i) (t i) (v 0))
      (fun i j v => wcLaurEval n (α2 i j) (fun k => ρL i j (t i k)) (v 0))
      (fun i v w => hEadd _ _ _ _) (fun i a v => hEsmul _ _ _ _) (fun i j v w => hEadd _ _ _ _)
      hsurj1 hkill1 hker2 hF1 hF2 hH0
  · exact wc_chart_h1_chase A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t (wcChartJ A n R1 α1 t)
      (fun i v => wcLaurEval n (α1 i) (t i) (v 0))
      (fun i j v => wcLaurEval n (α2 i j) (fun k => ρL i j (t i k)) (v 0))
      (fun i j v => wcLaurEval n (α2 i j) (fun k => ρR i j (t j k)) (v 0))
      (fun i j l v => wcLaurEval n (α3 i j l) (fun k => τ12 i j l (ρL i j (t i k))) (v 0))
      hsys
      (fun i v w => hEadd _ _ _ _) (fun i j v w => hEadd _ _ _ _) (fun i j a v => hEsmul _ _ _ _)
      (fun i j v w => hEadd _ _ _ _) (fun i j a v => hEsmul _ _ _ _)
      (fun i j l v w => hEadd _ _ _ _)
      hsurj2 hkill2 hker3 hKC hF1 hF2 hF3 hF4 hF5 hF6 hinj hdiag hH1

theorem wc_chart_cech_fg : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (n : ℕ) (R1 : Fin n → Type u) [∀ i, CommRing (R1 i)] (R2 : Fin n → Fin n → Type u) [∀ i j, CommRing (R2 i j)] (R3 : Fin n → Fin n → Fin n → Type u) [∀ i j l, CommRing (R3 i j l)] (α1 : ∀ i, A →+* R1 i) (α2 : ∀ i j, A →+* R2 i j) (α3 : ∀ i j l, A →+* R3 i j l) (ρL : ∀ i j, R1 i →+* R2 i j) (ρR : ∀ i j, R1 j →+* R2 i j) (τ12 : ∀ i j l, R2 i j →+* R3 i j l) (τ23 : ∀ i j l, R2 j l →+* R3 i j l) (τ13 : ∀ i j l, R2 i l →+* R3 i j l) (t : ∀ i : Fin n, Fin n → R1 i), wcChartSys A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t → wcChartH01FG A n R1 R2 R3 α1 α2 ρL ρR τ12 τ23 τ13 :=
by
  classical
  intro A _ _ n R1 _ R2 _ R3 _ α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys

  have hmulhc : ∀ (φ ψ : MvPolynomial (Fin n) A) (i m : ℕ), φ.IsHomogeneous i →
      MvPolynomial.homogeneousComponent m (φ * ψ) =
        if i ≤ m then φ * MvPolynomial.homogeneousComponent (m - i) ψ else 0 := by
    intro φ ψ i m hφ
    let _ := @MvPolynomial.gradedAlgebra (Fin n) A _
    have hdec : ∀ (p : MvPolynomial (Fin n) A) (k : ℕ),
        ((DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin n) A) p) k :
          MvPolynomial (Fin n) A) = MvPolynomial.homogeneousComponent k p :=
      fun p k => MvPolynomial.decomposition.decompose'_apply p k
    have := DirectSum.coe_decompose_mul_of_left_mem (MvPolynomial.homogeneousSubmodule (Fin n) A)
      (b := ψ) m ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr hφ)
    rw [hdec, hdec] at this
    exact this

  have hJ0 : ∀ f ∈ wcChartJ A n R1 α1 t, ∀ t' : ℕ,
      (fun r => MvPolynomial.homogeneousComponent t' (f r)) ∈ wcChartJ A n R1 α1 t := by
    intro f hf
    unfold wcChartJ at hf ⊢
    induction hf using Submodule.span_induction with
    | mem x hx =>
      intro t'
      obtain ⟨e, he, hk⟩ := hx
      have hfun : (fun r => MvPolynomial.homogeneousComponent t' (x r)) =
          if t' = e then x else 0 := by
        funext r
        have hr : r = 0 := Subsingleton.elim r 0
        subst hr
        rw [MvPolynomial.homogeneousComponent_of_mem
          ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr he)]
        by_cases h : t' = e <;> simp [h]
      rw [hfun]
      split_ifs
      · exact Submodule.subset_span ⟨e, he, hk⟩
      · exact Submodule.zero_mem _
    | zero =>
      intro t'
      have h0 : (fun r => MvPolynomial.homogeneousComponent t'
          ((0 : Fin 1 → MvPolynomial (Fin n) A) r)) = 0 := by
        funext r; simp
      rw [h0]
      exact Submodule.zero_mem _
    | add x y _ _ hx hy =>
      intro t'
      have h0 : (fun r => MvPolynomial.homogeneousComponent t' ((x + y) r)) =
          (fun r => MvPolynomial.homogeneousComponent t' (x r)) +
            (fun r => MvPolynomial.homogeneousComponent t' (y r)) := by
        funext r; simp [map_add]
      rw [h0]
      exact Submodule.add_mem _ (hx t') (hy t')
    | smul a x _ hx =>
      intro t'
      have hv : (fun r => MvPolynomial.homogeneousComponent t' ((a • x) r)) =
          ∑ b ∈ Finset.range (a.totalDegree + 1), (if b ≤ t' then
            MvPolynomial.homogeneousComponent b a •
              (fun r => MvPolynomial.homogeneousComponent (t' - b) (x r)) else 0) := by
        funext r
        rw [Finset.sum_apply]
        simp only [Pi.smul_apply, smul_eq_mul]
        conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent a, Finset.sum_mul, map_sum]
        refine Finset.sum_congr rfl (fun b _ => ?_)
        rw [hmulhc _ _ b t' (MvPolynomial.homogeneousComponent_isHomogeneous b a)]
        split_ifs <;> simp
      rw [hv]
      refine Submodule.sum_mem _ (fun b _ => ?_)
      split_ifs
      · exact Submodule.smul_mem _ _ (hx _)
      · exact Submodule.zero_mem _
  have hJ : ∀ f ∈ wcChartJ A n R1 α1 t, ∀ t' : ℕ,
      (fun r => if (fun _ : Fin 1 => (0 : ℕ)) r ≤ t' then
        MvPolynomial.homogeneousComponent (t' - (fun _ : Fin 1 => (0 : ℕ)) r) (f r) else 0) ∈
        wcChartJ A n R1 α1 t := by
    intro f hf t'
    simpa using hJ0 f hf t'

  exact wc_chart_cech_of_graded A n R1 R2 R3 α1 α2 α3 ρL ρR τ12 τ23 τ13 t hsys
    (wc_graded_cech_fg A n 1 (fun _ => 0) _ hJ 0 0)
    (wc_graded_cech_fg A n 1 (fun _ => 0) _ hJ 1 0)

theorem wc_serre_pm_cech_fg : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of A)) (m : ℕ) (g : Y ⟶ wcPm.{u} m), IsClosedImmersion (Limits.prod.lift hY g) → wcCechH01FG A Y hY (wcStructMod Y) (m + 1) (fun k => g ⁻¹ᵁ wcPmChart m k) :=
by
  intro A _ _ Y hY m g hι
  have hU := (wc_pm_chart_cover A Y hY m g hι).1
  obtain ⟨e, h1, h2, h3, h4⟩ := wc_pm_chart_coords.{u} m
  have hgen := fun k => wc_pm_chart_pullback_generation A Y hY m g hι k (e k) (h4 k)
  have hsys := wc_pm_chart_sys A Y hY m g hU e h1 h2 h3 hgen
  obtain ⟨⟨k0, c0, H0⟩, ⟨k1, c1, H1⟩⟩ := wc_chart_cech_fg A (m + 1) _ _ _ _ _ _ _ _ _ _ _ _ hsys
  exact ⟨⟨k0, c0, fun z hz => H0 z hz⟩, ⟨k1, c1, fun z hz => H1 z hz⟩⟩

theorem wc_cech_fg_change_cover : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of B)) (M : Y.Modules), wcQcoh M → ∀ (n : ℕ) (D : Fin n → Y.Opens), (∀ k, IsAffineOpen (D k)) → (∀ y : Y, ∃ k, y ∈ D k) → ∀ (r : ℕ) (E : Fin r → Y.Opens), (∀ y : Y, ∃ i, y ∈ E i) → wcCechH01FG B Y hY M n D → wcCechH01FG B Y hY M r E :=
by



  have wc_qcoh_affine_cech_h1_vanish : ∀ (Y : Scheme.{u}) (M : Y.Modules), wcQcoh M → ∀ (U : Y.Opens), IsAffineOpen U → ∀ (r : ℕ) (F : Fin r → Y.Opens), (∀ i, F i ≤ U) → (∀ y : Y, y ∈ U → ∃ i, y ∈ F i) → ∀ z : (∀ p : Fin r × Fin r, Γ(M, F p.1 ⊓ F p.2)), (∀ i j l : Fin r, M.presheaf.map (homOfLE (inf_le_left : F i ⊓ F j ⊓ F l ≤ F i ⊓ F j)).op (z (i, j)) + M.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : F i ⊓ F j ⊓ F l ≤ F j ⊓ F l)).op (z (j, l)) = M.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : F i ⊓ F j ⊓ F l ≤ F i ⊓ F l)).op (z (i, l))) → ∃ w : (∀ i : Fin r, Γ(M, F i)), ∀ i j : Fin r, z (i, j) = M.presheaf.map (homOfLE (inf_le_right : F i ⊓ F j ≤ F j)).op (w j) - M.presheaf.map (homOfLE (inf_le_left : F i ⊓ F j ≤ F i)).op (w i) := by
    intro Y M hM U hU r F hFU hFcov z hz
    classical
    have hcomp : ∀ {W W' W'' : Y.Opens} (h1 : W' ≤ W) (h2 : W'' ≤ W') (x : Γ(M, W)),
        M.presheaf.map (homOfLE h2).op (M.presheaf.map (homOfLE h1).op x) =
          M.presheaf.map (homOfLE (h2.trans h1)).op x := by
      intro W W' W'' h1 h2 x
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]; rfl
    have s3a : ∀ (V : Y.Opens) (hVU : V ≤ U), IsAffineOpen V → ∀ k : Γ(Y, U),
        (∀ e : Γ(M, V ⊓ Y.basicOpen k), ∃ (n : ℕ) (w : Γ(M, V)),
          (Y.presheaf.map (homOfLE (le_trans inf_le_left hVU : V ⊓ Y.basicOpen k ≤ U)).op k) ^ n • e
            = M.presheaf.map (homOfLE (inf_le_left : V ⊓ Y.basicOpen k ≤ V)).op w) ∧
        (∀ z : Γ(M, V), M.presheaf.map (homOfLE (inf_le_left : V ⊓ Y.basicOpen k ≤ V)).op z = 0 →
          ∃ n : ℕ, (Y.presheaf.map (homOfLE hVU).op k) ^ n • z = 0) := by
      intro V hVU hV k
      obtain ⟨hq1, hq2⟩ := hM V hV (Y.presheaf.map (homOfLE hVU).op k)
      have hres : Y.presheaf.map (homOfLE (Y.basicOpen_le (Y.presheaf.map (homOfLE hVU).op k))).op
          (Y.presheaf.map (homOfLE hVU).op k) =
          Y.presheaf.map (homOfLE (le_trans (Y.basicOpen_le _) hVU)).op k := by
        rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
        rfl
      have aux : ∀ (W : Y.Opens) (hWV : W ≤ V) (hWU : W ≤ U),
          W = Y.basicOpen (Y.presheaf.map (homOfLE hVU).op k) →
          (∀ e : Γ(M, W), ∃ (n : ℕ) (w : Γ(M, V)),
            (Y.presheaf.map (homOfLE hWU).op k) ^ n • e = M.presheaf.map (homOfLE hWV).op w) ∧
          (∀ z : Γ(M, V), M.presheaf.map (homOfLE hWV).op z = 0 →
            ∃ n : ℕ, (Y.presheaf.map (homOfLE hVU).op k) ^ n • z = 0) := by
        rintro W hWV hWU rfl
        refine ⟨fun e => ?_, fun z hz => hq2 z hz⟩
        obtain ⟨n, w, hw⟩ := hq1 e
        refine ⟨n, w, ?_⟩
        rw [← hres]
        exact hw
      exact aux (V ⊓ Y.basicOpen k) inf_le_left (le_trans inf_le_left hVU)
        (Scheme.basicOpen_res Y k (homOfLE hVU).op).symm
