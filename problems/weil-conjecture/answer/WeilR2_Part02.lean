    exact ⟨S, h, hB'⟩
  exact key (B i.unop) (hS₀B i.unop) hsepi hS

theorem wc_ap_universally_closed_descends_to_finset : ∀ (A : Type u) [CommRing A] (S₀ : Finset A) [IsNoetherianRing ↥(Subring.closure (S₀ : Set A))] (Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))) [QuasiCompact h₀] [IsSeparated h₀] [LocallyOfFinitePresentation h₀], UniversallyClosed (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype))) → ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)), UniversallyClosed (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))) :=
by
  intro A _ S₀ _ Y₀ h₀ _ _ _ huc
  classical


  obtain ⟨X', P, π, p, j, hπP, hπS, hpP, hj, hc⟩ :=
    wc_ap_chow_lemma_affine (↥(Subring.closure (S₀ : Set A))) Y₀ h₀
  haveI := hπP
  haveI := hπS
  haveI := hpP
  haveI := hj


  have crit : ∀ {T : Scheme.{u}} (g : T ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))),
      (IsProper (Limits.pullback.snd (j ≫ p) g) ↔
        IsClosed ((Limits.pullback.snd g p) ⁻¹' Set.range j)) := by
    intro T g
    have hrange : Set.range (Limits.pullback.snd j (Limits.pullback.fst p g)) =
        (Limits.pullback.fst p g) ⁻¹' Set.range j := Scheme.Pullback.range_snd _ _
    have e : ∀ x, (Limits.pullback.fst p g) ((Limits.pullbackSymmetry g p).hom x) =
        (Limits.pullback.snd g p) x := fun x => by
      rw [← Scheme.Hom.comp_apply, Limits.pullbackSymmetry_hom_comp_fst]
    have hpre : (Limits.pullback.snd g p) ⁻¹' Set.range j =
        (Scheme.homeoOfIso (Limits.pullbackSymmetry g p)) ⁻¹'
          Set.range (Limits.pullback.snd j (Limits.pullback.fst p g)) := by
      rw [hrange]
      ext x
      simp only [Set.mem_preimage, Scheme.homeoOfIso_apply, e]
    rw [hpre, Homeomorph.isClosed_preimage]
    constructor
    · intro hP
      haveI := hP
      haveI : IsProper (Limits.pullback.snd j (Limits.pullback.fst p g) ≫ Limits.pullback.snd p g) := by
        rw [← Limits.pullbackRightPullbackFstIso_hom_snd p g j]
        infer_instance
      haveI := IsProper.of_comp (Limits.pullback.snd j (Limits.pullback.fst p g)) (Limits.pullback.snd p g)
      exact (Limits.pullback.snd j (Limits.pullback.fst p g)).isClosedMap.isClosed_range
    · intro hcl
      haveI : IsClosedImmersion (Limits.pullback.snd j (Limits.pullback.fst p g)) :=
        IsClosedImmersion.of_isPreimmersion _ hcl
      rw [← Limits.pullbackRightPullbackFstIso_inv_snd_snd p g j]
      infer_instance


  have s5 : ∀ {T : Scheme.{u}} (g : T ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))),
      IsProper (Limits.pullback.snd h₀ g) → IsProper (Limits.pullback.snd (π ≫ h₀) g) := by
    intro T g hP
    haveI := hP
    rw [← Limits.pullbackRightPullbackFstIso_inv_snd_snd h₀ g π]
    infer_instance

  have s4 : ∀ {T : Scheme.{u}} (g : T ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))),
      UniversallyClosed (Limits.pullback.snd (π ≫ h₀) g) → UniversallyClosed (Limits.pullback.snd h₀ g) := by
    intro T g hU
    haveI := hU
    haveI : UniversallyClosed (Limits.pullback.snd π (Limits.pullback.fst h₀ g) ≫ Limits.pullback.snd h₀ g) := by
      rw [← Limits.pullbackRightPullbackFstIso_hom_snd h₀ g π]
      infer_instance
    exact UniversallyClosed.of_comp_surjective (Limits.pullback.snd π (Limits.pullback.fst h₀ g))
      (Limits.pullback.snd h₀ g)


  have s2 : ∀ (I : Type u) [Category.{u} I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, CompactSpace (D.obj i)) → (∀ i, QuasiSeparatedSpace (D.obj i)) → ∀ (W : Scheme.{u}) (s : ∀ i, D.obj i ⟶ W) (sc : c.pt ⟶ W), (∀ i, QuasiCompact (s i)) → (∀ {i j : I} (f : i ⟶ j), D.map f ≫ s j = s i) → (∀ i, c.π.app i ≫ s i = sc) → ∀ (R : Set W), IsLocallyClosed R → IsCompact R → IsClosed (sc ⁻¹' R) → ∃ i, IsClosed (s i ⁻¹' R) := by
    intro I _ _ D c hc hA hC hQ W s sc hs hcomp hcone R hRlc hRc hZ
    have hK : ∀ (X : Scheme.{u}) (K O : Set X), IsCompact K → IsOpen O → K ⊆ O →
        ∃ V : X.Opens, IsCompact (V : Set X) ∧ K ⊆ (V : Set X) ∧ (V : Set X) ⊆ O := by
      intro X K O hKc hO hKO
      have hex : ∀ x ∈ K, ∃ U' ∈ X.affineOpens, x ∈ U' ∧ U' ≤ (⟨O, hO⟩ : X.Opens) :=
        fun x hx => TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
          (U := ⟨O, hO⟩) (x := x) (hKO hx)
      choose! Uf hUa hxU hUO using hex
      obtain ⟨t, htK, hcov⟩ := hKc.elim_nhds_subcover (fun x => (Uf x : Set X))
        (fun x hx => (Uf x).isOpen.mem_nhds (hxU x hx))
      refine ⟨⟨⋃ x ∈ t, (Uf x : Set X), isOpen_biUnion (fun x _ => (Uf x).isOpen)⟩, ?_, hcov, ?_⟩
      · exact t.isCompact_biUnion (fun x hx => (hUa x (htK x hx)).isCompact)
      · intro y hy
        simp only [TopologicalSpace.Opens.coe_mk, Set.mem_iUnion] at hy
        obtain ⟨x, hx, hyx⟩ := hy
        exact hUO x (htK x hx) hyx
    haveI : ∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f) := hA
    haveI := hC
    haveI := hQ
    have hO : IsOpen (coborder R) := isLocallyClosed_iff_isOpen_coborder.mp hRlc
    obtain ⟨U, hUc, hRU, hUO⟩ := hK W R (coborder R) hRc hO subset_coborder
    have hNo : IsOpen (closure R)ᶜ := isClosed_closure.isOpen_compl
    have hUN : ∀ x, x ∈ (U : Set W) → x ∉ R → x ∈ (closure R)ᶜ := by
      intro x hxU hxR hxc
      apply hxR
      rw [← closure_inter_coborder (s := R)]
      exact ⟨hxc, hUO hxU⟩
    have hRN : ∀ x ∈ R, x ∉ (closure R)ᶜ := fun x hx hn => hn (subset_closure hx)
    haveI : CompactSpace c.pt := Scheme.compactSpace_of_isLimit D c hc
    obtain ⟨Vinf, hVinfc, hKV, hVZ⟩ := hK c.pt (sc ⁻¹' (U : Set W))ᶜ (sc ⁻¹' R)ᶜ
      ((U.isOpen.preimage sc.continuous).isClosed_compl.isCompact) hZ.isOpen_compl
      (Set.compl_subset_compl.mpr (Set.preimage_mono hRU))
    obtain ⟨i₁, V, hVc, hVeq⟩ := exists_preimage_eq D c hc Vinf hVinfc
    have hπ : ∀ x : c.pt, s i₁ (c.π.app i₁ x) = sc x := by
      intro x; rw [← hcone i₁, Scheme.Hom.comp_apply]
    have hVinf : ∀ x : c.pt, c.π.app i₁ x ∈ V ↔ x ∈ Vinf := by
      intro x
      rw [← hVeq]; rfl
    let N' : W.Opens := ⟨(closure R)ᶜ, hNo⟩
    have hU₁c : IsCompact ((s i₁ ⁻¹ᵁ U : (D.obj i₁).Opens) : Set (D.obj i₁)) :=
      QuasiCompact.isCompact_preimage (f := s i₁) _ U.isOpen hUc
    have h4a : c.π.app i₁ ⁻¹ᵁ (V ⊔ s i₁ ⁻¹ᵁ U) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      show c.π.app i₁ x ∈ V ∨ s i₁ (c.π.app i₁ x) ∈ U
      rw [hVinf, hπ]
      by_cases hx : sc x ∈ U
      · exact Or.inr hx
      · exact Or.inl (hKV hx)
    obtain ⟨j₁, f₁, hf₁⟩ := exists_map_eq_top D c hc (V ⊔ s i₁ ⁻¹ᵁ U) h4a
    have hVU₁c : IsCompact ((V ⊓ s i₁ ⁻¹ᵁ U : (D.obj i₁).Opens) : Set (D.obj i₁)) :=
      hVc.inter_of_isOpen hU₁c V.isOpen (s i₁ ⁻¹ᵁ U).isOpen
    have h4b : c.π.app i₁ ⁻¹ᵁ (V ⊓ s i₁ ⁻¹ᵁ U) ≤ c.π.app i₁ ⁻¹ᵁ (s i₁ ⁻¹ᵁ N') := by
      intro x hx
      have hx1 : c.π.app i₁ x ∈ V := hx.1
      have hx2 : s i₁ (c.π.app i₁ x) ∈ U := hx.2
      show s i₁ (c.π.app i₁ x) ∈ (closure R)ᶜ
      rw [hπ] at hx2 ⊢
      rw [hVinf] at hx1
      exact hUN _ hx2 (hVZ hx1)
    obtain ⟨j₂, f₂, hf₂⟩ := exists_map_preimage_le_map_preimage D c hc hVU₁c h4b
    obtain ⟨k, g₁, g₂, hg⟩ := IsCofiltered.cospan f₁ f₂
    refine ⟨k, ?_⟩
    have hk : ∀ x, s i₁ (D.map (g₁ ≫ f₁) x) = s k x := by
      intro x; rw [← hcomp (g₁ ≫ f₁), Scheme.Hom.comp_apply]
    have hcov : ∀ x : D.obj k, D.map (g₁ ≫ f₁) x ∈ V ∨ s k x ∈ U := by
      intro x
      have hx : D.map g₁ x ∈ D.map f₁ ⁻¹ᵁ (V ⊔ s i₁ ⁻¹ᵁ U) := by rw [hf₁]; trivial
      have hx' : D.map f₁ (D.map g₁ x) ∈ V ∨ s i₁ (D.map f₁ (D.map g₁ x)) ∈ U := hx
      rw [← hk, D.map_comp, Scheme.Hom.comp_apply]
      exact hx'
    have hint : ∀ x : D.obj k, D.map (g₁ ≫ f₁) x ∈ V → s k x ∈ U → s k x ∈ (closure R)ᶜ := by
      intro x h1 h2
      rw [hg] at h1 hk
      rw [← hk] at h2 ⊢
      rw [D.map_comp, Scheme.Hom.comp_apply] at h1 h2 ⊢
      have hx : D.map g₂ x ∈ D.map f₂ ⁻¹ᵁ (V ⊓ s i₁ ⁻¹ᵁ U) := ⟨h1, h2⟩
      exact hf₂ hx
    have heq : (s k ⁻¹' R)ᶜ = ((D.map (g₁ ≫ f₁) ⁻¹ᵁ V : (D.obj k).Opens) : Set (D.obj k)) ∪
        s k ⁻¹' ((U : Set W) ∩ (closure R)ᶜ) := by
      ext x
      simp only [Set.mem_compl_iff, Set.mem_preimage, Set.mem_union, Set.mem_inter_iff]
      constructor
      · intro hxR
        by_cases hxU : s k x ∈ U
        · exact Or.inr ⟨hxU, hUN _ hxU hxR⟩
        · exact Or.inl ((hcov x).resolve_right hxU)
      · rintro (h | ⟨_, h⟩) hxR
        · exact hRN _ hxR (hint x h (hRU hxR))
        · exact hRN _ hxR h
    rw [← isOpen_compl_iff, heq]
    exact (D.map (g₁ ≫ f₁) ⁻¹ᵁ V).isOpen.union ((U.isOpen.inter hNo).preimage (s k).continuous)


  obtain ⟨B, hBmono, hS₀B, hBcov, hBeq⟩ : ∃ B : Finset A → Subring A, Monotone B ∧
      (∀ T, Subring.closure (S₀ : Set A) ≤ B T) ∧ (∀ a : A, ∃ T, a ∈ B T) ∧
      ∀ T, ∃ S : Finset A, B T = Subring.closure (S : Set A) := by
    refine ⟨fun T => Subring.closure ((S₀ ∪ T : Finset A) : Set A), ?_, ?_, ?_, ?_⟩
    · intro T T' h
      exact Subring.closure_mono (Finset.coe_subset.mpr (Finset.union_subset_union (subset_refl _) h))
    · intro T
      exact Subring.closure_mono (by rw [Finset.coe_union]; exact Set.subset_union_left)
    · intro a
      exact ⟨{a}, Subring.subset_closure (by simp)⟩
    · intro T
      exact ⟨S₀ ∪ T, rfl⟩
  let G : Finset A ⥤ CommRingCat.{u} :=
    { obj := fun T => CommRingCat.of (B T)
      map := fun {T T'} f => CommRingCat.ofHom (Subring.inclusion (hBmono (leOfHom f)))
      map_id := fun T => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        apply Subtype.ext
        rfl
      map_comp := fun f g => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        apply Subtype.ext
        rfl }
  let κ : Limits.Cocone G :=
    { pt := CommRingCat.of A
      ι := { app := fun T => CommRingCat.ofHom (B T).subtype
             naturality := fun T T' f => by
               apply CommRingCat.hom_ext
               apply RingHom.ext
               intro x
               rfl } }
  have hκ : Limits.IsColimit κ := by
    haveI : Limits.ReflectsColimitsOfShape (Finset A) (forget CommRingCat.{u}) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    refine Limits.isColimitOfReflects (forget CommRingCat.{u}) ?_
    refine Limits.Types.FilteredColimit.isColimitOf _ _ ?_ ?_
    · intro x
      obtain ⟨T, hT⟩ := hBcov x
      exact ⟨T, ⟨x, hT⟩, rfl⟩
    · intro i j xi xj h
      refine ⟨i ⊔ j, homOfLE le_sup_left, homOfLE le_sup_right, ?_⟩
      apply Subtype.ext
      exact h
  let Dsp : (Finset A)ᵒᵖ ⥤ Scheme.{u} := G.op ⋙ Scheme.Spec
  let q : ∀ T : Finset A, Spec (G.obj T) ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A))) :=
    fun T => Spec.map (CommRingCat.ofHom (Subring.inclusion (hS₀B T)))
  have hqnat : ∀ {T T' : Finset A} (f : T ⟶ T'), Spec.map (G.map f) ≫ q T = q T' := by
    intro T T' f
    rw [← Spec.map_comp]
    rfl
  let sN : Dsp ⟶ (Functor.const (Finset A)ᵒᵖ).obj (Spec (.of ↥(Subring.closure (S₀ : Set A)))) :=
    { app := fun T => q T.unop
      naturality := fun T T' f => by
        simp only [Functor.const_obj_map]
        exact (hqnat f.unop).trans (Category.comp_id _).symm }
  have hlimSp : Limits.IsLimit (Scheme.Spec.mapCone κ.op) := Limits.isLimitOfPreserves Scheme.Spec hκ.op
  let q₀ : Spec (.of A) ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A))) :=
    Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype)
  have hp : ∀ j, (Scheme.Spec.mapCone κ.op).π.app j ≫ sN.app j = q₀ := by
    intro j
    show Spec.map (κ.ι.app j.unop) ≫ q j.unop = q₀
    rw [← Spec.map_comp]
    rfl
  haveI : Nonempty (Finset A)ᵒᵖ := ⟨Opposite.op ∅⟩
  have hlimO := Over.isLimitLiftCone Dsp sN (Scheme.Spec.mapCone κ.op) q₀ hp hlimSp
  haveI hpWqc : QuasiCompact p := inferInstance
  haveI hpWqs : QuasiSeparated p := inferInstance
  let Φ : Over (Spec (.of ↥(Subring.closure (S₀ : Set A)))) ⥤ Scheme.{u} :=
    Over.pullback p ⋙ Over.forget P
  have hlimE := Limits.isLimitOfPreserves Φ hlimO
  let E : (Finset A)ᵒᵖ ⥤ Scheme.{u} := Over.lift Dsp sN ⋙ Φ
  let c : Limits.Cone E := Φ.mapCone (Over.liftCone Dsp sN (Scheme.Spec.mapCone κ.op) q₀ hp)
  let s : ∀ i, E.obj i ⟶ P := fun i => Limits.pullback.snd (q i.unop) p
  let sc : c.pt ⟶ P := Limits.pullback.snd q₀ p
  have hhelp : ∀ {Z₁ Z₂ Z X' : Scheme.{u}} (a : Z₁ ⟶ Z₂) (b : Z₂ ⟶ Z) (c' : Z₁ ⟶ Z) (g : X' ⟶ Z)
      (hc : a ≫ b = c') (w : (Limits.pullback.fst c' g ≫ a) ≫ b = Limits.pullback.snd c' g ≫ g),
      IsAffineHom a → IsAffineHom (Limits.pullback.lift (Limits.pullback.fst c' g ≫ a) (Limits.pullback.snd c' g) w) := by
    intro Z₁ Z₂ Z X' a b c' g hc w ha
    subst hc
    have h1 : IsPullback (Limits.pullback.lift (Limits.pullback.fst (a ≫ b) g ≫ a) (Limits.pullback.snd (a ≫ b) g) w)
        (Limits.pullback.fst (a ≫ b) g) (Limits.pullback.fst b g) a := by
      refine IsPullback.of_right ?_ (Limits.pullback.lift_fst _ _ _) (IsPullback.of_hasPullback b g).flip
      rw [Limits.pullback.lift_snd]
      exact (IsPullback.of_hasPullback (a ≫ b) g).flip
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) h1.flip ha
  have hA : ∀ {i j : (Finset A)ᵒᵖ} (f : i ⟶ j), IsAffineHom (E.map f) := by
    intro i j f
    change IsAffineHom (Limits.pullback.lift (Limits.pullback.fst (q i.unop) p ≫ Dsp.map f)
      (Limits.pullback.snd (q i.unop) p) _)
    exact hhelp (Dsp.map f) (q j.unop) (q i.unop) p (hqnat f.unop) _
      (by change IsAffineHom (Spec.map _); infer_instance)
  have hfstQC : ∀ i : (Finset A)ᵒᵖ, QuasiCompact (Limits.pullback.fst (q i.unop) p) := fun i =>
    MorphismProperty.of_isPullback (P := @QuasiCompact) (IsPullback.of_hasPullback (q i.unop) p).flip hpWqc
  have hfstQS : ∀ i : (Finset A)ᵒᵖ, QuasiSeparated (Limits.pullback.fst (q i.unop) p) := fun i =>
    MorphismProperty.of_isPullback (P := @QuasiSeparated) (IsPullback.of_hasPullback (q i.unop) p).flip hpWqs
  have hC : ∀ i, CompactSpace (E.obj i) := fun i =>
    @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.fst (q i.unop) p) (hfstQC i) _
  have hQ : ∀ i, QuasiSeparatedSpace (E.obj i) := fun i =>
    @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.fst (q i.unop) p) _ (hfstQS i)
  have hs : ∀ i, QuasiCompact (s i) := fun i => by
    show QuasiCompact (Limits.pullback.snd (q i.unop) p)
    infer_instance
  have hcomp : ∀ {i j : (Finset A)ᵒᵖ} (f : i ⟶ j), E.map f ≫ s j = s i := by
    intro i j f
    change Limits.pullback.lift (Limits.pullback.fst (q i.unop) p ≫ Dsp.map f)
      (Limits.pullback.snd (q i.unop) p) _ ≫ Limits.pullback.snd (q j.unop) p = _
    exact Limits.pullback.lift_snd _ _ _
  have hcone : ∀ i, c.π.app i ≫ s i = sc := by
    intro i
    change Limits.pullback.lift (Limits.pullback.fst q₀ p ≫ (Scheme.Spec.mapCone κ.op).π.app i)
      (Limits.pullback.snd q₀ p) _ ≫ Limits.pullback.snd (q i.unop) p = _
    exact Limits.pullback.lift_snd _ _ _


  have hRlc : IsLocallyClosed (Set.range j) := Scheme.Hom.isLocallyClosed_range j
  haveI : QuasiCompact (π ≫ h₀) := inferInstance
  haveI : CompactSpace X' := QuasiCompact.compactSpace_of_compactSpace (π ≫ h₀)
  have hRc : IsCompact (Set.range j) := isCompact_range j.continuous
  haveI := huc
  haveI hPA : IsProper (Limits.pullback.snd h₀ q₀) := ⟨⟩
  have hPA' : IsProper (Limits.pullback.snd (j ≫ p) q₀) := by
    rw [hc]; exact s5 q₀ hPA
  have hZ : IsClosed (sc ⁻¹' Set.range j) := (crit q₀).mp hPA'
  obtain ⟨i, hi⟩ := s2 (Finset A)ᵒᵖ E c hlimE hA hC hQ P s sc hs hcomp hcone
    _ hRlc hRc hZ
  have hPi : IsProper (Limits.pullback.snd (π ≫ h₀) (q i.unop)) := by
    rw [← hc]; exact (crit (q i.unop)).mpr hi
  have huci : UniversallyClosed (Limits.pullback.snd h₀ (q i.unop)) := s4 (q i.unop) inferInstance
  obtain ⟨S, hS⟩ := hBeq i.unop
  have key : ∀ (B' : Subring A) (h : Subring.closure (S₀ : Set A) ≤ B'),
      UniversallyClosed (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion h)))) →
      B' = Subring.closure (S : Set A) →
      ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)),
        UniversallyClosed (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))) := by
    intro B' h hB' hEq
    subst hEq
    exact ⟨S, h, hB'⟩
  exact key (B i.unop) (hS₀B i.unop) huci hS

theorem wc_ap_fp_proper_noetherian_descent : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) [IsProper h] [LocallyOfFinitePresentation h], ∃ (B : Type u) (_ : CommRing B) (_ : IsNoetherianRing B) (ψ : B →+* A) (Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ Spec (.of B)) (_ : IsProper h₀) (e : Y ⟶ Limits.pullback h₀ (Spec.map (CommRingCat.ofHom ψ))), IsIso e ∧ e ≫ Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom ψ)) = h :=
by
  intro A _ Y h _ _

  have s1 : ∀ (S : Finset A), IsNoetherianRing ↥(Subring.closure (S : Set A)) := by
    intro S
    let φ : MvPolynomial ↥(S : Set A) ℤ →+* ↥(Subring.closure (S : Set A)) :=
      MvPolynomial.eval₂Hom (Int.castRingHom _) (fun s => ⟨s.1, Subring.subset_closure s.2⟩)
    have hsurj : Function.Surjective φ := by
      intro x
      have hle : Subring.closure (S : Set A) ≤
          φ.range.map (Subring.closure (S : Set A)).subtype := by
        rw [Subring.closure_le]
        intro s hs
        refine Subring.mem_map.mpr ⟨φ (MvPolynomial.X ⟨s, hs⟩), ⟨_, rfl⟩, ?_⟩
        simp [φ]
      obtain ⟨y, hy, hyx⟩ := Subring.mem_map.mp (hle x.2)
      obtain ⟨p, rfl⟩ := RingHom.mem_range.mp hy
      exact ⟨p, Subtype.ext hyx⟩
    exact isNoetherianRing_of_surjective _ _ φ hsurj

  have s5 : ∀ (B B' : Subring A) (hBB' : B ≤ B') (X₀ : Scheme.{u}) (g : X₀ ⟶ Spec (.of ↥B)),
      ∃ Φ : Limits.pullback (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (Subring.inclusion hBB'))))
          (Spec.map (CommRingCat.ofHom B'.subtype)) ≅ Limits.pullback g (Spec.map (CommRingCat.ofHom B.subtype)),
        Φ.hom ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom B.subtype)) =
          Limits.pullback.snd (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (Subring.inclusion hBB'))))
            (Spec.map (CommRingCat.ofHom B'.subtype)) := by
    intro B B' hBB' X₀ g
    have hg : Spec.map (CommRingCat.ofHom B'.subtype) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion hBB')) =
        Spec.map (CommRingCat.ofHom B.subtype) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    refine ⟨Limits.pullbackLeftPullbackSndIso _ _ _ ≪≫ Limits.pullback.congrHom rfl hg, ?_⟩
    simp only [Iso.trans_hom, Category.assoc, Limits.pullback.congrHom_hom]
    erw [Limits.pullback.lift_snd, Category.comp_id]
    exact Limits.pullbackLeftPullbackSndIso_hom_snd _ _ _

  obtain ⟨S₀, Y₀, h₀, hqc₀, hqs₀, hlfp₀, e₀, he₀, he₀h⟩ := wc_ap_fp_scheme_descends_to_finset A Y h
  haveI := hqc₀
  haveI := hqs₀
  haveI := hlfp₀
  haveI := he₀
  have hsnd₀ : Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype)) =
      inv e₀ ≫ h := by
    rw [← he₀h, IsIso.inv_hom_id_assoc]

  have hsepA : IsSeparated (Limits.pullback.snd h₀
      (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype))) := by
    rw [hsnd₀]; infer_instance
  obtain ⟨S₁, hS₁, hsep₁⟩ := wc_ap_separated_descends_to_finset A S₀ Y₀ h₀ hsepA
  haveI := hsep₁
  obtain ⟨Φ₁, hΦ₁⟩ := s5 _ _ hS₁ Y₀ h₀

  have hucA : UniversallyClosed (Limits.pullback.snd
      (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))))
      (Spec.map (CommRingCat.ofHom (Subring.closure (S₁ : Set A)).subtype))) := by
    rw [← hΦ₁, hsnd₀]; infer_instance
  haveI := s1 S₁
  obtain ⟨S₂, hS₂, huc₂⟩ := wc_ap_universally_closed_descends_to_finset A S₁ _
    (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁)))) hucA
  haveI := huc₂
  obtain ⟨Φ₂, hΦ₂⟩ := s5 _ _ hS₂ _
    (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))))
  haveI hprop : IsProper (Limits.pullback.snd
      (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))))
      (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₂)))) := ⟨⟩
  refine ⟨↥(Subring.closure (S₂ : Set A)), inferInstance, s1 S₂, (Subring.closure (S₂ : Set A)).subtype,
    _, _, hprop, e₀ ≫ Φ₁.inv ≫ Φ₂.inv, inferInstance, ?_⟩
  rw [Category.assoc, Category.assoc, ← hΦ₂, Iso.inv_hom_id_assoc, ← hΦ₁, Iso.inv_hom_id_assoc, he₀h]

theorem wc_ap_local_noetherian_subrings : ∀ (B A : Type u) [CommRing B] [IsNoetherianRing B] [CommRing A] [IsLocalRing A] (ψ : B →+* A), ∃ Λ : Finset A → Subring A, Monotone Λ ∧ (∀ S b, ψ b ∈ Λ S) ∧ (∀ S, ∀ a ∈ S, a ∈ Λ S) ∧ (∀ S, IsNoetherianRing ↥(Λ S)) ∧ (∀ S, IsLocalRing ↥(Λ S)) ∧ (∀ S, IsLocalHom (Λ S).subtype) :=
by
  intro B A _ _ _ _ ψ

  have key : ∀ C : Subring A, IsNoetherianRing ↥C → ∃ Λ : Subring A,
      (∀ x : A, x ∈ Λ ↔ ∃ d ∈ C, ∃ c ∈ C, IsUnit c ∧ x * c = d) ∧ IsNoetherianRing ↥Λ ∧
      IsLocalRing ↥Λ ∧ IsLocalHom Λ.subtype := by
    intro C hC
    let Λ : Subring A :=
      { carrier := {x | ∃ d ∈ C, ∃ c ∈ C, IsUnit c ∧ x * c = d}
        zero_mem' := ⟨0, C.zero_mem, 1, C.one_mem, isUnit_one, by simp⟩
        one_mem' := ⟨1, C.one_mem, 1, C.one_mem, isUnit_one, by simp⟩
        add_mem' := by
          rintro x y ⟨d, hd, c, hc, hu, hx⟩ ⟨d', hd', c', hc', hu', hy⟩
          exact ⟨d * c' + d' * c, C.add_mem (C.mul_mem hd hc') (C.mul_mem hd' hc), c * c',
            C.mul_mem hc hc', hu.mul hu', by rw [← hx, ← hy]; ring⟩
        mul_mem' := by
          rintro x y ⟨d, hd, c, hc, hu, hx⟩ ⟨d', hd', c', hc', hu', hy⟩
          exact ⟨d * d', C.mul_mem hd hd', c * c', C.mul_mem hc hc', hu.mul hu',
            by rw [← hx, ← hy]; ring⟩
        neg_mem' := by
          rintro x ⟨d, hd, c, hc, hu, hx⟩
          exact ⟨-d, C.neg_mem hd, c, hc, hu, by rw [← hx]; ring⟩ }
    have hmem : ∀ x : A, x ∈ Λ ↔ ∃ d ∈ C, ∃ c ∈ C, IsUnit c ∧ x * c = d := fun x => Iff.rfl
    have hCΛ : C ≤ Λ := fun d hd => (hmem d).2 ⟨d, hd, 1, C.one_mem, isUnit_one, mul_one d⟩

    have hinv : ∀ a : Λ, IsUnit (a : A) → IsUnit a := by
      intro a ha
      obtain ⟨d, hd, c, hc, hu, hx⟩ := (hmem a).1 a.2
      have hdu : IsUnit d := hx ▸ ha.mul hu
      set y : A := ↑(ha.unit⁻¹) with hydef
      have hy1 : (a : A) * y = 1 := ha.mul_val_inv
      have hyΛ : y ∈ Λ := (hmem y).2 ⟨c, hc, d, hd, hdu, by
        rw [← hx, ← mul_assoc, mul_comm y, hy1, one_mul]⟩
      exact isUnit_iff_exists_inv.mpr ⟨⟨y, hyΛ⟩, Subtype.ext hy1⟩
    have : Nontrivial Λ := ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
    have hloc : IsLocalRing Λ := IsLocalRing.of_isUnit_or_isUnit_one_sub_self (fun a => by
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (a : A) with h | h
      · exact Or.inl (hinv a h)
      · right
        apply hinv
        simpa using h)
    have hlh : IsLocalHom Λ.subtype := ⟨fun a ha => hinv a ha⟩
    let M : Submonoid C :=
      { carrier := {c | IsUnit (c : A)}
        one_mem' := isUnit_one
        mul_mem' := fun ha hb => ha.mul hb }
    letI : Algebra C Λ := (Subring.inclusion hCΛ).toAlgebra
    have hL : IsLocalization M Λ := by
      rw [isLocalization_iff]
      refine ⟨?_, ?_, ?_⟩
      · intro y
        exact hinv _ y.2
      · rintro ⟨x, hxΛ⟩
        obtain ⟨d, hd, c, hc, hu, hx⟩ := (hmem x).1 hxΛ
        exact ⟨(⟨d, hd⟩, ⟨⟨c, hc⟩, hu⟩), Subtype.ext hx⟩
      · intro x y hxy
        refine ⟨1, ?_⟩
        have h1 : ((algebraMap C Λ x : Λ) : A) = ((algebraMap C Λ y : Λ) : A) :=
          congrArg Subtype.val hxy
        have h2 : x = y := Subtype.ext h1
        rw [h2]
    exact ⟨Λ, hmem, IsLocalization.isNoetherianRing M Λ hC, hloc, hlh⟩

  have hCN : ∀ S : Finset A, IsNoetherianRing ↥(Subring.closure (Set.range ψ ∪ (↑S : Set A))) := by
    intro S
    letI := ψ.toAlgebra
    have h1 : (Algebra.adjoin B (↑S : Set A)).toSubring =
        Subring.closure (Set.range ψ ∪ (↑S : Set A)) := by
      rw [Algebra.adjoin_eq_ring_closure]
      rfl
    haveI : Algebra.FiniteType B (Algebra.adjoin B (↑S : Set A)) :=
      (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset S)
    haveI hN : IsNoetherianRing (Algebra.adjoin B (↑S : Set A)) :=
      Algebra.FiniteType.isNoetherianRing B _
    rw [← h1]
    exact hN
  choose Λ hmem hN hL hLH using fun S : Finset A => key _ (hCN S)
  have hCΛ : ∀ S : Finset A, ∀ x ∈ Subring.closure (Set.range ψ ∪ (↑S : Set A)), x ∈ Λ S :=
    fun S x hx => (hmem S x).2 ⟨x, hx, 1, Subring.one_mem _, isUnit_one, mul_one x⟩
  refine ⟨Λ, ?_, ?_, ?_, hN, hL, hLH⟩
  · intro S T hST x hx
    obtain ⟨d, hd, c, hc, hu, hx⟩ := (hmem S x).1 hx
    have hsub : Subring.closure (Set.range ψ ∪ (↑S : Set A)) ≤
        Subring.closure (Set.range ψ ∪ (↑T : Set A)) :=
      Subring.closure_mono (Set.union_subset_union_right _ (Finset.coe_subset.mpr hST))
    exact (hmem T x).2 ⟨d, hsub hd, c, hsub hc, hu, hx⟩
  · intro S b
    exact hCΛ S _ (Subring.subset_closure (Or.inl ⟨b, rfl⟩))
  · intro S a ha
    exact hCΛ S _ (Subring.subset_closure (Or.inr ha))

theorem wc_ap_closed_fibre_limit_system : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (B : Type u) [CommRing B] (ψ : B →+* A) (Λ : Finset A → Subring A), Monotone Λ → (∀ S b, ψ b ∈ Λ S) → (∀ S, ∀ a ∈ S, a ∈ Λ S) → ∀ (hloc : ∀ S, IsLocalRing ↥(Λ S)), (∀ S, IsLocalHom (Λ S).subtype) → ∀ (Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ Spec (.of B)) [IsProper h₀], ∃ (E : (Finset A)ᵒᵖ ⥤ Scheme.{u}) (c : Limits.Cone E) (_ : Limits.IsLimit c) (ι : c.pt ⟶ Limits.pullback h₀ (Spec.map (CommRingCat.ofHom ψ))), (∀ {i j : (Finset A)ᵒᵖ} (f : i ⟶ j), IsAffineHom (E.map f)) ∧ (∀ i, CompactSpace (E.obj i)) ∧ (∀ i, QuasiSeparatedSpace (E.obj i)) ∧ Set.range ι = (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom ψ))) ⁻¹' {IsLocalRing.closedPoint A} ∧ ∀ S : Finset A, ∃ (R' : Scheme.{u}) (g' : R' ⟶ Spec (.of ↥(Λ S))) (_ : IsProper g') (p : Limits.pullback h₀ (Spec.map (CommRingCat.ofHom ψ)) ⟶ R') (j : E.obj (Opposite.op S) ⟶ R'), IsClosedImmersion j ∧ Set.range j = g' ⁻¹' {@IsLocalRing.closedPoint ↥(Λ S) _ (hloc S)} ∧ c.π.app (Opposite.op S) ≫ j = ι ≫ p :=
by
  intro A _ _ B _ ψ Λ hmono hψΛ hSΛ hloc hlocHom Y₀ h₀ _

  have s1 : ∀ (Y₀ T P' S Z : Scheme.{u}) (h₀ : Y₀ ⟶ Z) (φ : S ⟶ Z) (a : T ⟶ S) [IsClosedImmersion a] (fst' : P' ⟶ T) (snd' : P' ⟶ Y₀), IsPullback fst' snd' (a ≫ φ) h₀ → ∃ j : P' ⟶ Limits.pullback h₀ φ, IsClosedImmersion j ∧ Set.range j = (Limits.pullback.snd h₀ φ) ⁻¹' Set.range a ∧ j ≫ Limits.pullback.fst h₀ φ = snd' ∧ j ≫ Limits.pullback.snd h₀ φ = fst' ≫ a := by
    intro Y₀ T P' S Z h₀ φ a _ fst' snd' hp
    let j : P' ⟶ Limits.pullback h₀ φ :=
      Limits.pullback.lift snd' (fst' ≫ a) (by rw [Category.assoc]; exact hp.w.symm)
    have h1 : j ≫ Limits.pullback.fst h₀ φ = snd' := Limits.pullback.lift_fst _ _ _
    have h2 : j ≫ Limits.pullback.snd h₀ φ = fst' ≫ a := Limits.pullback.lift_snd _ _ _
    have hL : IsPullback j fst' (Limits.pullback.snd h₀ φ) a := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.fst h₀ φ) (v₁₃ := h₀) (h₂₂ := φ) ?_ h2
        (IsPullback.of_hasPullback h₀ φ)
      rw [h1]; exact hp.flip
    have hci : IsClosedImmersion j :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hL.flip inferInstance
    refine ⟨j, hci, ?_, h1, h2⟩
    have he := hL.isoPullback_hom_fst
    rw [← Scheme.Pullback.range_fst, ← he]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨hL.isoPullback.hom y, by rw [Scheme.Hom.comp_apply]⟩
    · rintro ⟨y, rfl⟩
      refine ⟨hL.isoPullback.inv y, ?_⟩
      rw [Scheme.Hom.comp_apply, Scheme.inv_hom_apply]

  have s2 : ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (G : J ⥤ CommRingCat.{u}) (κ : Limits.Cocone G), (∀ j, Function.Injective (κ.ι.app j)) → (∀ x : κ.pt, ∃ (j : J) (y : G.obj j), κ.ι.app j y = x) → Nonempty (Limits.IsColimit κ) := by
    intro J _ _ G κ hinj hsurj
    have ht : Limits.IsColimit ((forget CommRingCat).mapCocone κ) := by
      apply Limits.Types.FilteredColimit.isColimitOf
      · intro x
        obtain ⟨j, y, hy⟩ := hsurj x
        exact ⟨j, y, hy.symm⟩
      · intro i j xi xj h
        refine ⟨IsFiltered.max i j, IsFiltered.leftToMax i j, IsFiltered.rightToMax i j, ?_⟩
        apply hinj (IsFiltered.max i j)
        have e1 := congrArg (fun f => (ConcreteCategory.hom f) xi) (κ.w (IsFiltered.leftToMax i j))
        have e2 := congrArg (fun f => (ConcreteCategory.hom f) xj) (κ.w (IsFiltered.rightToMax i j))
        simp only [CommRingCat.comp_apply] at e1 e2
        change (κ.ι.app (IsFiltered.max i j)) ((G.map (IsFiltered.leftToMax i j)) xi) =
          (κ.ι.app (IsFiltered.max i j)) ((G.map (IsFiltered.rightToMax i j)) xj)
        rw [e1, e2]
        exact h
    have : Limits.ReflectsColimitsOfShape J (forget CommRingCat) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    exact ⟨Limits.isColimitOfReflects (forget CommRingCat) ht⟩

  have s3 : ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (G : J ⥤ CommRingCat.{u}) (κ : Limits.Cocone G), Limits.IsColimit κ → ∀ (X Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ X) (q : ∀ j, Spec (G.obj j) ⟶ X), (∀ {i j : J} (f : i ⟶ j), Spec.map (G.map f) ≫ q i = q j) → ∀ (q₀ : Spec κ.pt ⟶ X), (∀ j, Spec.map (κ.ι.app j) ≫ q j = q₀) → ∃ (E : Jᵒᵖ ⥤ Scheme.{u}) (c : Limits.Cone E) (_ : Limits.IsLimit c) (fE : ∀ j, E.obj (Opposite.op j) ⟶ Spec (G.obj j)) (sE : ∀ j, E.obj (Opposite.op j) ⟶ Y₀) (fc : c.pt ⟶ Spec κ.pt) (sc : c.pt ⟶ Y₀), (∀ j, IsPullback (fE j) (sE j) (q j) h₀) ∧ IsPullback fc sc q₀ h₀ ∧ (∀ j, c.π.app (Opposite.op j) ≫ fE j = fc ≫ Spec.map (κ.ι.app j)) ∧ (∀ j, c.π.app (Opposite.op j) ≫ sE j = sc) ∧ (∀ {i j : Jᵒᵖ} (f : i ⟶ j), IsAffineHom (E.map f)) := by
    intro J _ _ G κ hκ X Y₀ h₀ q hq q₀ hq₀
    have hSpec : Limits.IsLimit (Scheme.Spec.mapCone κ.op) :=
      Limits.isLimitOfPreserves Scheme.Spec hκ.op
    let D₀ : Jᵒᵖ ⥤ Over X := (G.op ⋙ Scheme.Spec).toOver X (fun j => q j.unop)
      (fun g => hq g.unop)
    let c₀ : Limits.Cone D₀ :=
      { pt := Over.mk q₀
        π :=
          { app := fun j => Over.homMk (Spec.map (κ.ι.app j.unop)) (hq₀ j.unop)
            naturality := by
              intro j j' g
              apply Over.OverMorphism.ext
              change Spec.map (κ.ι.app j'.unop) =
                Spec.map (κ.ι.app j.unop) ≫ Spec.map (G.map g.unop)
              rw [← Spec.map_comp, κ.w] } }
    let α : G.op ⋙ Scheme.Spec ≅ D₀ ⋙ Over.forget X :=
      NatIso.ofComponents (fun _ => Iso.refl _) (by intros; rfl)
    have h1 : Limits.IsLimit ((Over.forget X).mapCone c₀) :=
      (Limits.IsLimit.equivOfNatIsoOfIso α _ _
        (Limits.Cone.ext (Iso.refl _) (fun j => by
          change Spec.map (κ.ι.app j.unop) ≫ 𝟙 _ = 𝟙 _ ≫ Spec.map (κ.ι.app j.unop)
          simp))) hSpec
    have := IsCofiltered.isConnected Jᵒᵖ
    have hc₀ : Limits.IsLimit c₀ := Limits.isLimitOfReflects (Over.forget X) h1
    let Φ : Over X ⥤ Scheme.{u} := Over.pullback h₀ ⋙ Over.forget Y₀
    have hc : Limits.IsLimit (Φ.mapCone c₀) := Limits.isLimitOfPreserves Φ hc₀
    refine ⟨D₀ ⋙ Φ, Φ.mapCone c₀, hc, fun j => Limits.pullback.fst (q j) h₀,
      fun j => Limits.pullback.snd (q j) h₀, Limits.pullback.fst q₀ h₀, Limits.pullback.snd q₀ h₀,
      fun j => IsPullback.of_hasPullback (q j) h₀, IsPullback.of_hasPullback q₀ h₀,
      fun j => Limits.pullback.lift_fst _ _ _, fun j => Limits.pullback.lift_snd _ _ _, ?_⟩
    intro i j g
    let m : Limits.pullback (q i.unop) h₀ ⟶ Limits.pullback (q j.unop) h₀ := (D₀ ⋙ Φ).map g
    have e1 : m ≫ Limits.pullback.snd (q j.unop) h₀ =
        Limits.pullback.snd (q i.unop) h₀ := Limits.pullback.lift_snd _ _ _
    have e2 : m ≫ Limits.pullback.fst (q j.unop) h₀ =
        Limits.pullback.fst (q i.unop) h₀ ≫ Spec.map (G.map g.unop) :=
      Limits.pullback.lift_fst _ _ _
    have hL : IsPullback m (Limits.pullback.fst (q i.unop) h₀)
        (Limits.pullback.fst (q j.unop) h₀) (Spec.map (G.map g.unop)) := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.snd (q j.unop) h₀) (v₁₃ := h₀)
        (h₂₂ := q j.unop) ?_ e2 (IsPullback.of_hasPullback (q j.unop) h₀).flip
      rw [e1, hq g.unop]
      exact (IsPullback.of_hasPullback (q i.unop) h₀).flip
    have : IsAffineHom (Spec.map (G.map g.unop)) := isAffineHom_of_isAffine _
    have : IsAffineHom m :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) hL.flip inferInstance
    exact this

  have s4 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Λ : Finset A → Subring A) (hmono : Monotone Λ), (∀ S, ∀ a ∈ S, a ∈ Λ S) → ∀ (hloc : ∀ S, IsLocalRing ↥(Λ S)), (∀ S, IsLocalHom (Λ S).subtype) → ∃ (G : Finset A ⥤ CommRingCat.{u}) (κ : Limits.Cocone G) (r : ∀ S, CommRingCat.of ↥(Λ S) ⟶ G.obj S) (r₀ : CommRingCat.of A ⟶ κ.pt), (∀ S, Function.Injective (κ.ι.app S)) ∧ (∀ x : κ.pt, ∃ (S : Finset A) (y : G.obj S), κ.ι.app S y = x) ∧ IsClosedImmersion (Spec.map r₀) ∧ Set.range (Spec.map r₀) = {IsLocalRing.closedPoint A} ∧ (∀ S, IsClosedImmersion (Spec.map (r S))) ∧ (∀ S, Set.range (Spec.map (r S)) = {@IsLocalRing.closedPoint ↥(Λ S) _ (hloc S)}) ∧ (∀ S, r S ≫ κ.ι.app S = CommRingCat.ofHom (Λ S).subtype ≫ r₀) ∧ (∀ {S S' : Finset A} (f : S ⟶ S'), r S ≫ G.map f = CommRingCat.ofHom (Subring.inclusion (hmono (leOfHom f))) ≫ r S') := by
    intro A _ _ Λ hmono hSΛ hloc hlocHom
    have hinc : ∀ (S S' : Finset A) (h : Λ S ≤ Λ S'), IsLocalHom (Subring.inclusion h) := by
      intro S S' h
      refine ⟨fun a ha => ?_⟩
      have h2 : IsUnit ((Λ S').subtype (Subring.inclusion h a)) := ha.map _
      exact (hlocHom S).map_nonunit a h2
    let G : Finset A ⥤ CommRingCat.{u} :=
      { obj := fun S => CommRingCat.of (IsLocalRing.ResidueField (Λ S))
        map := fun {S S'} f => CommRingCat.ofHom
          (IsLocalRing.ResidueField.map (Subring.inclusion (hmono (leOfHom f))))
        map_id := fun S => by
          ext x
          obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
          change IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y) = IsLocalRing.residue _ y
          rw [IsLocalRing.ResidueField.map_residue]
          rfl
        map_comp := fun {S S' S''} f g => by
          ext x
          obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
          change IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y) =
            IsLocalRing.ResidueField.map _ (IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y))
          rw [IsLocalRing.ResidueField.map_residue, IsLocalRing.ResidueField.map_residue,
            IsLocalRing.ResidueField.map_residue]
          rfl }
    let κ : Limits.Cocone G :=
      { pt := CommRingCat.of (IsLocalRing.ResidueField A)
        ι :=
          { app := fun S => CommRingCat.ofHom (IsLocalRing.ResidueField.map (Λ S).subtype)
            naturality := fun {S S'} f => by
              ext x
              obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
              change IsLocalRing.ResidueField.map _ (IsLocalRing.ResidueField.map _
                (IsLocalRing.residue _ y)) = IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y)
              rw [IsLocalRing.ResidueField.map_residue, IsLocalRing.ResidueField.map_residue,
                IsLocalRing.ResidueField.map_residue]
              rfl } }
    have hrange : ∀ (T : Type u) [CommRing T] [IsLocalRing T],
        Set.range (Spec.map (CommRingCat.ofHom (IsLocalRing.residue T))) =
          {IsLocalRing.closedPoint T} := by
      intro T _ _
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        exact IsLocalRing.PrimeSpectrum.comap_residue T y
      · rintro rfl
        obtain ⟨y⟩ : Nonempty (PrimeSpectrum (IsLocalRing.ResidueField T)) := inferInstance
        exact ⟨y, IsLocalRing.PrimeSpectrum.comap_residue T y⟩
    refine ⟨G, κ, fun S => CommRingCat.ofHom (IsLocalRing.residue (Λ S)),
      CommRingCat.ofHom (IsLocalRing.residue A),
      fun S => RingHom.injective (IsLocalRing.ResidueField.map (Λ S).subtype), ?_,
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective, hrange A,
      fun S => IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective,
      fun S => hrange (Λ S), ?_, ?_⟩
    · intro x
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective x
      have ha : a ∈ Λ {a} := hSΛ {a} a (Finset.mem_singleton_self a)
      refine ⟨{a}, IsLocalRing.residue _ ⟨a, ha⟩, ?_⟩
      change IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ _) = _
      rw [IsLocalRing.ResidueField.map_residue]
      rfl
    · intro S
      ext y
      change IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y) = IsLocalRing.residue A y
      rw [IsLocalRing.ResidueField.map_residue]
      rfl
    · intro S S' f
      ext y
      change IsLocalRing.ResidueField.map _ (IsLocalRing.residue _ y) = IsLocalRing.residue _ _
      rw [IsLocalRing.ResidueField.map_residue]
      rfl

  obtain ⟨G, κ, r, r₀, hinj, hsurj, hci₀, hr₀, hciS, hrS, hκr, hGr⟩ :=
    s4 A Λ hmono hSΛ hloc hlocHom
  obtain ⟨hκ⟩ := s2 (Finset A) G κ hinj hsurj
  let ψS : ∀ S, B →+* Λ S := fun S => ψ.codRestrict (Λ S) (hψΛ S)
  let q : ∀ S, Spec (G.obj S) ⟶ Spec (.of B) :=
    fun S => Spec.map (r S) ≫ Spec.map (CommRingCat.ofHom (ψS S))
  let q₀ : Spec κ.pt ⟶ Spec (.of B) := Spec.map r₀ ≫ Spec.map (CommRingCat.ofHom ψ)
  have I1 : ∀ {S S' : Finset A} (f : S ⟶ S'), CommRingCat.ofHom (ψS S) ≫
      CommRingCat.ofHom (Subring.inclusion (hmono (leOfHom f))) = CommRingCat.ofHom (ψS S') := by
    intro S S' f
    ext b
    rfl
  have I2 : ∀ S, CommRingCat.ofHom (ψS S) ≫ CommRingCat.ofHom (Λ S).subtype =
      CommRingCat.ofHom ψ := by
    intro S
    ext b
    rfl
  have hq : ∀ {S S' : Finset A} (f : S ⟶ S'), Spec.map (G.map f) ≫ q S = q S' := by
    intro S S' f
    have e : (CommRingCat.ofHom (ψS S) ≫ r S) ≫ G.map f = CommRingCat.ofHom (ψS S') ≫ r S' := by
      rw [Category.assoc, hGr f, ← Category.assoc, I1 f]
    calc Spec.map (G.map f) ≫ q S = Spec.map ((CommRingCat.ofHom (ψS S) ≫ r S) ≫ G.map f) := by
          simp only [q, Spec.map_comp, Category.assoc]
      _ = q S' := by rw [e]; simp only [q, Spec.map_comp]
  have hq₀ : ∀ S, Spec.map (κ.ι.app S) ≫ q S = q₀ := by
    intro S
    have e : (CommRingCat.ofHom (ψS S) ≫ r S) ≫ κ.ι.app S = CommRingCat.ofHom ψ ≫ r₀ := by
      rw [Category.assoc, hκr S, ← Category.assoc, I2]
    calc Spec.map (κ.ι.app S) ≫ q S = Spec.map ((CommRingCat.ofHom (ψS S) ≫ r S) ≫ κ.ι.app S) := by
          simp only [q, Spec.map_comp, Category.assoc]
      _ = q₀ := by rw [e]; simp only [q₀, Spec.map_comp]
  obtain ⟨E, c, hc, fE, sE, fc, sc, hpb, hpb₀, hcf, hcs, haff⟩ :=
    s3 (Finset A) G κ hκ (Spec (.of B)) Y₀ h₀ q hq q₀ hq₀
  have hprop : ∀ S, IsProper (fE S) := fun S =>
    MorphismProperty.of_isPullback (P := @IsProper) (hpb S).flip inferInstance
  have : IsClosedImmersion (Spec.map r₀) := hci₀
  obtain ⟨ι, -, hιr, hιf, hιs⟩ := s1 Y₀ (Spec κ.pt) c.pt (Spec (.of A)) (Spec (.of B)) h₀
    (Spec.map (CommRingCat.ofHom ψ)) (Spec.map r₀) fc sc hpb₀
  refine ⟨E, c, hc, ι, haff, ?_, ?_, ?_, ?_⟩
  · intro i
    obtain ⟨S⟩ := i
    have := hprop S
    exact QuasiCompact.compactSpace_of_compactSpace (fE S)
  · intro i
    obtain ⟨S⟩ := i
    have := hprop S
    exact quasiSeparatedSpace_of_quasiSeparated (fE S)
  · rw [hιr, hr₀]
  · intro S
    have : IsClosedImmersion (Spec.map (r S)) := hciS S
    obtain ⟨j, hjci, hjr, hjf, hjs⟩ := s1 Y₀ (Spec (G.obj S)) (E.obj (Opposite.op S))
      (Spec (.of ↥(Λ S))) (Spec (.of B)) h₀ (Spec.map (CommRingCat.ofHom (ψS S))) (Spec.map (r S))
      (fE S) (sE S) (hpb S)
    let p : Limits.pullback h₀ (Spec.map (CommRingCat.ofHom ψ)) ⟶
        Limits.pullback h₀ (Spec.map (CommRingCat.ofHom (ψS S))) :=
      Limits.pullback.map h₀ (Spec.map (CommRingCat.ofHom ψ)) h₀
        (Spec.map (CommRingCat.ofHom (ψS S))) (𝟙 Y₀) (Spec.map (CommRingCat.ofHom (Λ S).subtype))
        (𝟙 _) (by simp) (by rw [Category.comp_id, ← Spec.map_comp, I2 S])
    refine ⟨Limits.pullback h₀ (Spec.map (CommRingCat.ofHom (ψS S))), Limits.pullback.snd _ _,
      inferInstance, p, j, hjci, ?_, ?_⟩
    · rw [hjr, hrS S]
    · have key : Spec.map (κ.ι.app S) ≫ Spec.map (r S) =
          Spec.map r₀ ≫ Spec.map (CommRingCat.ofHom (Λ S).subtype) := by
        rw [← Spec.map_comp, ← Spec.map_comp, hκr S]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hjf, hcs, Category.assoc]
        simp only [p, Limits.pullback.lift_fst, Category.comp_id]
        rw [hιf]
      · rw [Category.assoc, hjs, ← Category.assoc, hcf, Category.assoc, key, Category.assoc]
        simp only [p, Limits.pullback.lift_snd]
        rw [reassoc_of% hιs]

theorem wc_proper_local_noetherian_approx_clopen : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) [IsProper g] (T₁ T₂ : Set R), IsClosed T₁ → IsClosed T₂ → Disjoint T₁ T₂ → T₁ ∪ T₂ = g ⁻¹' {IsLocalRing.closedPoint A} → ∃ (A' : Type u) (_ : CommRing A') (_ : IsLocalRing A') (_ : IsNoetherianRing A') (R' : Scheme.{u}) (g' : R' ⟶ Spec (.of A')) (_ : IsProper g') (p : R ⟶ R') (T₁' T₂' : Set R'), IsClosed T₁' ∧ IsClosed T₂' ∧ Disjoint T₁' T₂' ∧ T₁' ∪ T₂' = g' ⁻¹' {IsLocalRing.closedPoint A'} ∧ p '' T₁ ⊆ T₁' ∧ p '' T₂ ⊆ T₂' :=
by

  have s6 : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u})
      (c : Limits.Cone D), Limits.IsLimit c → (∀ {i j : I} (f : i ⟶ j), IsAffineHom (D.map f)) →
      (∀ i, CompactSpace (D.obj i)) → (∀ i, QuasiSeparatedSpace (D.obj i)) →
      ∀ e : Γ(c.pt, ⊤), e * (1 - e) = 0 →
      ∃ (i : I) (t : Γ(D.obj i, ⊤)), t * (1 - t) = 0 ∧ (c.π.app i).appTop t = e := by
    intro I _ _ D c hc hA hC hQ e he
    obtain ⟨i, t₀, ht₀⟩ := exists_appTop_π_eq_of_isLimit D c hc e
    have hdef : (c.π.app i).appTop (t₀ * (1 - t₀)) = 0 := by
      rw [map_mul, map_sub, map_one, ← ht₀, he]
    obtain ⟨j, f, hf⟩ := exists_appTop_map_eq_zero_of_isLimit D c hc _ hdef
    refine ⟨j, (D.map f).appTop t₀, ?_, ?_⟩
    · rw [← map_one (D.map f).appTop.hom, ← map_sub, ← map_mul]
      exact hf
    · have hw : (c.π.app j ≫ D.map f).appTop = (c.π.app i).appTop := by rw [c.w f]
      rw [Scheme.Hom.comp_appTop] at hw
      rw [ht₀, ← hw]
      rfl

  have s7 : ∀ (Z : Scheme.{u}) (S₁ S₂ : Set Z), IsClosed S₁ → IsClosed S₂ → Disjoint S₁ S₂ →
      S₁ ∪ S₂ = Set.univ → ∃ e : Γ(Z, ⊤), e * (1 - e) = 0 ∧
        (∀ z ∈ S₁, z ∉ Z.basicOpen (1 - e)) ∧ (∀ z ∈ S₂, z ∉ Z.basicOpen e) := by
    intro Z S₁ S₂ hS₁ hS₂ hd hu
    let U : Bool → Z.Opens := fun i => match i with
      | true => ⟨S₂ᶜ, hS₂.isOpen_compl⟩
      | false => ⟨S₁ᶜ, hS₁.isOpen_compl⟩
    have hbot : U true ⊓ U false = ⊥ := by
      apply eq_bot_iff.mpr
      intro x hx
      have hx1 : x ∉ S₂ := hx.1
      have hx2 : x ∉ S₁ := hx.2
      have hxu : x ∈ S₁ ∪ S₂ := hu ▸ Set.mem_univ x
      exfalso
      rcases hxu with h | h
      · exact hx2 h
      · exact hx1 h
    have hbot' : U false ⊓ U true = ⊥ := by rw [inf_comm]; exact hbot
    let sf : ∀ i : Bool, ToType (Z.sheaf.obj.obj (Opposite.op (U i))) := fun i => match i with
      | true => (1 : Γ(Z, U true))
      | false => (0 : Γ(Z, U false))
    have hcompat : TopCat.Presheaf.IsCompatible Z.sheaf.obj U sf := by
      intro i j
      cases i <;> cases j
      · rfl
      · exact @Subsingleton.elim _
          (CommRingCat.subsingleton_of_isTerminal (TopCat.Sheaf.isTerminalOfEqEmpty Z.sheaf hbot')) _ _
      · exact @Subsingleton.elim _
          (CommRingCat.subsingleton_of_isTerminal (TopCat.Sheaf.isTerminalOfEqEmpty Z.sheaf hbot)) _ _
      · rfl
    have hcov : (⊤ : Z.Opens) ≤ iSup U := by
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      by_cases hx : x ∈ S₂
      · exact ⟨false, (Set.disjoint_right.mp hd hx : x ∉ S₁)⟩
      · exact ⟨true, (hx : x ∉ S₂)⟩
    obtain ⟨e₀, he, -⟩ := TopCat.Sheaf.existsUnique_gluing' Z.sheaf U ⊤
      (fun i => homOfLE le_top) hcov sf hcompat
    let e : Γ(Z, ⊤) := e₀
    have he1 : (Z.presheaf.map (homOfLE (le_top : U true ≤ ⊤)).op) e = 1 := he true
    have he0 : (Z.presheaf.map (homOfLE (le_top : U false ≤ ⊤)).op) e = 0 := he false
    refine ⟨e, ?_, ?_, ?_⟩
    · apply TopCat.Sheaf.eq_of_locally_eq' Z.sheaf U ⊤ (fun i => homOfLE le_top) hcov
      intro i
      cases i
      · change (Z.presheaf.map (homOfLE (le_top : U false ≤ ⊤)).op) (e * (1 - e)) =
          (Z.presheaf.map (homOfLE (le_top : U false ≤ ⊤)).op) 0
        rw [map_mul, he0, zero_mul, map_zero]
      · change (Z.presheaf.map (homOfLE (le_top : U true ≤ ⊤)).op) (e * (1 - e)) =
          (Z.presheaf.map (homOfLE (le_top : U true ≤ ⊤)).op) 0
        rw [map_mul, map_sub, map_one, he1, sub_self, mul_zero, map_zero]
    · intro z hz hzD
      have h1 := Z.basicOpen_res (1 - e) (homOfLE (le_top : U true ≤ ⊤)).op
      have h2 : (Z.presheaf.map (homOfLE (le_top : U true ≤ ⊤)).op) (1 - e) = 0 := by
        rw [map_sub, map_one, he1, sub_self]
      rw [h2, Scheme.basicOpen_zero] at h1
      have hzU : z ∈ U true ⊓ Z.basicOpen (1 - e) :=
        ⟨(Set.disjoint_left.mp hd hz : z ∉ S₂), hzD⟩
      rw [← h1] at hzU
      simp at hzU
    · intro z hz hzD
      have h1 := Z.basicOpen_res e (homOfLE (le_top : U false ≤ ⊤)).op
      rw [he0, Scheme.basicOpen_zero] at h1
      have hzU : z ∈ U false ⊓ Z.basicOpen e :=
        ⟨(Set.disjoint_right.mp hd hz : z ∉ S₁), hzD⟩
      rw [← h1] at hzU
      simp at hzU

  have s8 : ∀ (Y : Scheme.{u}) (t : Γ(Y, ⊤)), t * (1 - t) = 0 →
      IsClosed {y : Y | y ∉ Y.basicOpen (1 - t)} ∧ IsClosed {y : Y | y ∉ Y.basicOpen t} ∧
      Disjoint {y : Y | y ∉ Y.basicOpen (1 - t)} {y : Y | y ∉ Y.basicOpen t} ∧
      {y : Y | y ∉ Y.basicOpen (1 - t)} ∪ {y : Y | y ∉ Y.basicOpen t} = Set.univ := by
    intro Y t ht
    refine ⟨?_, ?_, ?_, ?_⟩
    · exact (Y.basicOpen (1 - t)).isOpen.isClosed_compl
    · exact (Y.basicOpen t).isOpen.isClosed_compl
    · rw [Set.disjoint_left]
      intro y h1 h2
      have hy : y ∈ Y.basicOpen ((1 - t) + t) := by
        rw [sub_add_cancel, Scheme.basicOpen_one]; trivial
      have h3 := Scheme.basicOpen_add_le Y (1 - t) t hy
      rcases (TopologicalSpace.Opens.mem_sup.mp h3) with h | h
      · exact h1 h
      · exact h2 h
    · ext y
      simp only [Set.mem_union, Set.mem_setOf_eq, Set.mem_univ, iff_true]
      by_contra hcon
      push_neg at hcon
      have h4 : y ∈ Y.basicOpen (t * (1 - t)) := by
        rw [Scheme.basicOpen_mul]; exact ⟨hcon.2, hcon.1⟩
      rw [ht, Scheme.basicOpen_zero] at h4
      simp at h4

  intro A _ _ R g _ T₁ T₂ h₁ h₂ hd hu
  obtain ⟨Y, h, hYp, hYl, ι, hι, hιh⟩ := wc_ap_closed_immersion_into_fp_proper A R g
  haveI := hYp
  haveI := hYl
  haveI := hι
  obtain ⟨Z, hZ, hZp, hZl, κ, hκ, hκZ, hZsub⟩ := wc_ap_fp_proper_shrink_closed_fibre A R Y h ι
  haveI := hZp
  haveI := hZl
  haveI := hκ
  obtain ⟨B, instB, instBN, ψ, Y₀, h₀, hp₀, e, he, heZ⟩ :=
    wc_ap_fp_proper_noetherian_descent A Z hZ
  haveI := hp₀
  haveI := he
  let θ : R ⟶ Limits.pullback h₀ (Spec.map (CommRingCat.ofHom ψ)) := κ ≫ e
  haveI : IsClosedImmersion θ := inferInstance
  have hθ : θ ≫ Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom ψ)) = g := by
    simp only [θ, Category.assoc, heZ, hκZ, hιh]
  have hθemb := θ.isClosedEmbedding
  have hU₁ : IsClosed (θ '' T₁) := hθemb.isClosedMap _ h₁
  have hU₂ : IsClosed (θ '' T₂) := hθemb.isClosedMap _ h₂
  have hUd : Disjoint (θ '' T₁) (θ '' T₂) := Set.disjoint_image_of_injective hθemb.injective hd
  have hUu : θ '' T₁ ∪ θ '' T₂ =
      (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom ψ))) ⁻¹' {IsLocalRing.closedPoint A} := by
    rw [← Set.image_union, hu]
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      show (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom ψ))) (θ x) ∈
        ({IsLocalRing.closedPoint A} : Set (Spec (.of A)))
      rw [← Scheme.Hom.comp_apply θ (Limits.pullback.snd _ _) x, hθ]
      exact hx
    · intro hy
      let z := (asIso e).inv y
      have hz : e z = y := Scheme.inv_hom_apply (asIso e) y
      have hzZ : hZ z = IsLocalRing.closedPoint A := by
        rw [← heZ, Scheme.Hom.comp_apply, hz]
        exact hy
      obtain ⟨x, hx⟩ := hZsub hzZ
      refine ⟨x, ?_, ?_⟩
      · show g x ∈ ({IsLocalRing.closedPoint A} : Set (Spec (.of A)))
        rw [← hιh, ← hκZ, Scheme.Hom.comp_apply, hx]
        exact hzZ
      · show (κ ≫ e) x = y
        rw [Scheme.Hom.comp_apply, hx, hz]

  obtain ⟨Λ, hmono, hψΛ, hSΛ, hnoeth, hloc, hlocHom⟩ := wc_ap_local_noetherian_subrings B A ψ
  obtain ⟨E, c, hc, ιF, hEaff, hEc, hEq, hrange, hfin⟩ :=
    wc_ap_closed_fibre_limit_system A B ψ Λ hmono hψΛ hSΛ hloc hlocHom Y₀ h₀
  have hS₁ : IsClosed (ιF ⁻¹' (θ '' T₁)) := hU₁.preimage ιF.continuous
  have hS₂ : IsClosed (ιF ⁻¹' (θ '' T₂)) := hU₂.preimage ιF.continuous
  have hSu : ιF ⁻¹' (θ '' T₁) ∪ ιF ⁻¹' (θ '' T₂) = Set.univ := by
    rw [← Set.preimage_union, hUu, ← hrange, Set.preimage_range]
  obtain ⟨eF, heF, heF₁, heF₂⟩ := s7 c.pt _ _ hS₁ hS₂ (hUd.preimage _) hSu
  obtain ⟨i, t, ht, hti⟩ := s6 (Finset A)ᵒᵖ E c hc hEaff hEc hEq eF heF
  obtain ⟨S⟩ := i
  obtain ⟨V1c, V2c, Vd, Vu⟩ := s8 (E.obj (Opposite.op S)) t ht
  obtain ⟨R', g', hg', p₀, j, hj, hjr, hjc⟩ := hfin S
  haveI := hj
  have hjemb := j.isClosedEmbedding
  refine ⟨↥(Λ S), inferInstance, hloc S, hnoeth S, R', g', hg', θ ≫ p₀,
    j '' {y | y ∉ (E.obj (Opposite.op S)).basicOpen (1 - t)},
    j '' {y | y ∉ (E.obj (Opposite.op S)).basicOpen t}, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact hjemb.isClosedMap _ V1c
  · exact hjemb.isClosedMap _ V2c
  · exact Set.disjoint_image_of_injective hjemb.injective Vd
  · rw [← Set.image_union, Vu, Set.image_univ, hjr]
  · rintro _ ⟨x, hx, rfl⟩
    have hxU : θ x ∈ θ '' T₁ := ⟨x, hx, rfl⟩
    have hxr : θ x ∈ Set.range ιF := by rw [hrange, ← hUu]; exact Or.inl hxU
    obtain ⟨z, hz⟩ := hxr
    have hzS : z ∈ ιF ⁻¹' (θ '' T₁) := by rw [Set.mem_preimage, hz]; exact hxU
    refine ⟨c.π.app (Opposite.op S) z, ?_, ?_⟩
    · intro hmem
      have hz' : z ∈ c.pt.basicOpen ((c.π.app (Opposite.op S)).appTop (1 - t)) := by
        rw [← Scheme.preimage_basicOpen_top]; exact hmem
      rw [map_sub, map_one, hti] at hz'
      exact heF₁ z hzS hz'
    · rw [Scheme.Hom.comp_apply θ p₀ x, ← hz, ← Scheme.Hom.comp_apply ιF p₀ z, ← hjc,
        Scheme.Hom.comp_apply]
  · rintro _ ⟨x, hx, rfl⟩
    have hxU : θ x ∈ θ '' T₂ := ⟨x, hx, rfl⟩
    have hxr : θ x ∈ Set.range ιF := by rw [hrange, ← hUu]; exact Or.inr hxU
    obtain ⟨z, hz⟩ := hxr
    have hzS : z ∈ ιF ⁻¹' (θ '' T₂) := by rw [Set.mem_preimage, hz]; exact hxU
    refine ⟨c.π.app (Opposite.op S) z, ?_, ?_⟩
    · intro hmem
      have hz' : z ∈ c.pt.basicOpen ((c.π.app (Opposite.op S)).appTop t) := by
        rw [← Scheme.preimage_basicOpen_top]; exact hmem
      rw [hti] at hz'
      exact heF₂ z hzS hz'
    · rw [Scheme.Hom.comp_apply θ p₀ x, ← hz, ← Scheme.Hom.comp_apply ιF p₀ z, ← hjc,
        Scheme.Hom.comp_apply]

theorem wc_proper_local_closed_fibre_clopen_lift : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) [IsProper g] (T₁ T₂ : Set R), IsClosed T₁ → IsClosed T₂ → Disjoint T₁ T₂ → T₁ ∪ T₂ = g ⁻¹' {IsLocalRing.closedPoint A} → ∃ b : Γ(R, ⊤), (∀ x ∈ T₁, x ∉ R.basicOpen (1 - b)) ∧ (∀ x ∈ T₂, x ∉ R.basicOpen b) :=
by

  have s1 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (n : ℕ), 0 < n →
      Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n)))) =
        {IsLocalRing.closedPoint B} := by
    intro B _ _ n hn
    have hker : RingHom.ker (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n)) ≤
        IsLocalRing.maximalIdeal B := by
      rw [Ideal.mk_ker]; exact Ideal.pow_le_self hn.ne'
    have hbase : ∀ Q, (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk
        (IsLocalRing.maximalIdeal B ^ n)))) Q =
        PrimeSpectrum.comap (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n)) Q := fun Q => rfl
    ext P
    simp only [Set.mem_range, Set.mem_singleton_iff, hbase]
    constructor
    · rintro ⟨Q, rfl⟩
      apply PrimeSpectrum.ext
      show Ideal.comap (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n)) Q.asIdeal =
        IsLocalRing.maximalIdeal B
      haveI hQp : Q.asIdeal.IsPrime := Q.isPrime
      haveI hcp : (Ideal.comap (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n))
          Q.asIdeal).IsPrime := Ideal.comap_isPrime _ _
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
      · have hle : IsLocalRing.maximalIdeal B ^ n ≤
            Ideal.comap (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n)) Q.asIdeal := by
          intro x hx
          rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
          exact Q.asIdeal.zero_mem
        exact (Ideal.IsPrime.pow_le_iff hn.ne').mp hle
    · rintro rfl
      haveI hQ : (Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n))
          (IsLocalRing.maximalIdeal B)).IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
      refine ⟨⟨_, hQ⟩, ?_⟩
      apply PrimeSpectrum.ext
      show Ideal.comap (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n))
        (Ideal.map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal B ^ n))
          (IsLocalRing.maximalIdeal B)) = IsLocalRing.maximalIdeal B
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, sup_eq_left.mpr hker]

  have s2 : ∀ (Z : Scheme.{u}) (S₁ S₂ : Set Z), IsClosed S₁ → IsClosed S₂ → Disjoint S₁ S₂ →
      S₁ ∪ S₂ = Set.univ → ∃ e : Γ(Z, ⊤), (∀ z ∈ S₁, z ∉ Z.basicOpen (1 - e)) ∧
        (∀ z ∈ S₂, z ∉ Z.basicOpen e) := by
    intro Z S₁ S₂ hS₁ hS₂ hd hu
    let U : Bool → Z.Opens := fun i => match i with
      | true => ⟨S₂ᶜ, hS₂.isOpen_compl⟩
      | false => ⟨S₁ᶜ, hS₁.isOpen_compl⟩
    have hbot : U true ⊓ U false = ⊥ := by
      apply eq_bot_iff.mpr
      intro x hx
      have hx1 : x ∉ S₂ := hx.1
      have hx2 : x ∉ S₁ := hx.2
      have hxu : x ∈ S₁ ∪ S₂ := hu ▸ Set.mem_univ x
      exfalso
      rcases hxu with h | h
      · exact hx2 h
      · exact hx1 h
    have hbot' : U false ⊓ U true = ⊥ := by rw [inf_comm]; exact hbot
    let sf : ∀ i : Bool, ToType (Z.sheaf.obj.obj (Opposite.op (U i))) := fun i => match i with
      | true => (1 : Γ(Z, U true))
      | false => (0 : Γ(Z, U false))
    have hcompat : TopCat.Presheaf.IsCompatible Z.sheaf.obj U sf := by
      intro i j
      cases i <;> cases j
      · rfl
      · exact @Subsingleton.elim _
          (CommRingCat.subsingleton_of_isTerminal (TopCat.Sheaf.isTerminalOfEqEmpty Z.sheaf hbot')) _ _
      · exact @Subsingleton.elim _
          (CommRingCat.subsingleton_of_isTerminal (TopCat.Sheaf.isTerminalOfEqEmpty Z.sheaf hbot)) _ _
      · rfl
    have hcov : (⊤ : Z.Opens) ≤ iSup U := by
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      by_cases hx : x ∈ S₂
      · exact ⟨false, (Set.disjoint_right.mp hd hx : x ∉ S₁)⟩
      · exact ⟨true, (hx : x ∉ S₂)⟩
    obtain ⟨e₀, he, -⟩ := TopCat.Sheaf.existsUnique_gluing' Z.sheaf U ⊤
      (fun i => homOfLE le_top) hcov sf hcompat
    let e : Γ(Z, ⊤) := e₀
    have he1 : (Z.presheaf.map (homOfLE (le_top : U true ≤ ⊤)).op) e = 1 := he true
    have he0 : (Z.presheaf.map (homOfLE (le_top : U false ≤ ⊤)).op) e = 0 := he false
    refine ⟨e, ?_, ?_⟩
    · intro z hz hzD
      have h1 := Z.basicOpen_res (1 - e) (homOfLE (le_top : U true ≤ ⊤)).op
      have h2 : (Z.presheaf.map (homOfLE (le_top : U true ≤ ⊤)).op) (1 - e) = 0 := by
        rw [map_sub, map_one, he1, sub_self]
      rw [h2, Scheme.basicOpen_zero] at h1
      have hzU : z ∈ U true ⊓ Z.basicOpen (1 - e) :=
        ⟨(Set.disjoint_left.mp hd hz : z ∉ S₂), hzD⟩
      rw [← h1] at hzU
      simp at hzU
    · intro z hz hzD
      have h1 := Z.basicOpen_res e (homOfLE (le_top : U false ≤ ⊤)).op
      rw [he0, Scheme.basicOpen_zero] at h1
      have hzU : z ∈ U false ⊓ Z.basicOpen e :=
        ⟨(Set.disjoint_right.mp hd hz : z ∉ S₁), hzD⟩
      rw [← h1] at hzU
      simp at hzU

  intro A _ _ R g _ T₁ T₂ h₁ h₂ hd hu
  obtain ⟨A', _, _, _, R', g', _, p, T₁', T₂', h₁', h₂', hd', hu', hp₁, hp₂⟩ :=
    wc_proper_local_noetherian_approx_clopen A R g T₁ T₂ h₁ h₂ hd hu
  obtain ⟨N, hN⟩ := wc_proper_noetherian_local_ml_lift A' R' g'
  have hr := s1 A' (N + 1) (Nat.succ_pos N)
  generalize Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A' ^ (N + 1))))
    = q at hN hr
  have hrange : Set.range (Limits.pullback.fst g' q) = g' ⁻¹' {IsLocalRing.closedPoint A'} := by
    rw [Scheme.Pullback.range_fst, hr]
  have hcover : (Limits.pullback.fst g' q) ⁻¹' T₁' ∪ (Limits.pullback.fst g' q) ⁻¹' T₂' =
      Set.univ := by
    rw [← Set.preimage_union, hu', ← hrange, Set.preimage_range]
  obtain ⟨e, he₁, he₂⟩ := s2 (Limits.pullback g' q) _ _
    (h₁'.preimage (Limits.pullback.fst g' q).continuous)
    (h₂'.preimage (Limits.pullback.fst g' q).continuous)
    (hd'.preimage _) hcover
  obtain ⟨b', hb'⟩ := hN e
  refine ⟨p.appTop b', ?_, ?_⟩
  · intro x hx hxD
    have hpx : p x ∈ R'.basicOpen (1 - b') := by
      have hx' : x ∈ p ⁻¹ᵁ R'.basicOpen (1 - b') := by
        rw [Scheme.preimage_basicOpen_top, map_sub, map_one]; exact hxD
      exact hx'
    have hT : p x ∈ T₁' := hp₁ (Set.mem_image_of_mem p hx)
    have hmem : p x ∈ Set.range (Limits.pullback.fst g' q) := by
      rw [hrange, ← hu']; exact Or.inl hT
    obtain ⟨z, hz⟩ := hmem
    have hzD : z ∈ (Limits.pullback g' q).basicOpen
        ((Limits.pullback.fst g' q).appTop (1 - b')) := by
      rw [← Scheme.preimage_basicOpen_top]
      show (Limits.pullback.fst g' q) z ∈ R'.basicOpen (1 - b')
      rw [hz]; exact hpx
    rw [map_sub, map_one] at hzD
    have e1 := (Scheme.evaluation_eq_zero_iff_notMem_basicOpen (U := ⊤) _ z trivial (1 - e)).mpr
      (he₁ z (show (Limits.pullback.fst g' q) z ∈ T₁' by rw [hz]; exact hT))
    have e2 := (Scheme.evaluation_eq_zero_iff_notMem_basicOpen (U := ⊤) _ z trivial _).mpr (hb' z)
    apply (Scheme.evaluation_eq_zero_iff_notMem_basicOpen (U := ⊤) _ z trivial
      (1 - (Limits.pullback.fst g' q).appTop b')).mp _ hzD
    have hid : (1 : Γ(Limits.pullback g' q, ⊤)) - (Limits.pullback.fst g' q).appTop b' =
        (1 - e) - ((Limits.pullback.fst g' q).appTop b' - e) := by ring
    rw [hid, map_sub, e1, e2, sub_zero]
  · intro x hx hxD
    have hpx : p x ∈ R'.basicOpen b' := by
      have hx' : x ∈ p ⁻¹ᵁ R'.basicOpen b' := by
        rw [Scheme.preimage_basicOpen_top]; exact hxD
      exact hx'
    have hT : p x ∈ T₂' := hp₂ (Set.mem_image_of_mem p hx)
    have hmem : p x ∈ Set.range (Limits.pullback.fst g' q) := by
      rw [hrange, ← hu']; exact Or.inr hT
    obtain ⟨z, hz⟩ := hmem
    have hzD : z ∈ (Limits.pullback g' q).basicOpen
        ((Limits.pullback.fst g' q).appTop b') := by
      rw [← Scheme.preimage_basicOpen_top]
      show (Limits.pullback.fst g' q) z ∈ R'.basicOpen b'
      rw [hz]; exact hpx
    have e1 := (Scheme.evaluation_eq_zero_iff_notMem_basicOpen (U := ⊤) _ z trivial e).mpr
      (he₂ z (show (Limits.pullback.fst g' q) z ∈ T₂' by rw [hz]; exact hT))
    have e2 := (Scheme.evaluation_eq_zero_iff_notMem_basicOpen (U := ⊤) _ z trivial _).mpr (hb' z)
    apply (Scheme.evaluation_eq_zero_iff_notMem_basicOpen (U := ⊤) _ z trivial
      ((Limits.pullback.fst g' q).appTop b')).mp _ hzD
    have hid : (Limits.pullback.fst g' q).appTop b' =
        e + ((Limits.pullback.fst g' q).appTop b' - e) := by ring
    rw [hid, map_add, e1, e2, add_zero]

theorem wc_proper_henselian_fibre_trace_connected : ∀ (A : Type u) [CommRing A]
    [HenselianLocalRing A] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) [IsProper h],
    ∀ y : Y, IsConnected (closure {y} ∩ h ⁻¹' {IsLocalRing.closedPoint A}) :=
by
  intro A _ _ Y h _ y
  classical

  have hz : ∃ z ∈ closure ({y} : Set Y), h z = IsLocalRing.closedPoint A := by
    have hC : IsClosed (h '' closure {y}) := Scheme.Hom.isClosedMap h _ isClosed_closure
    have hy : h y ∈ h '' closure {y} := ⟨y, subset_closure rfl, rfl⟩
    have hmem : IsLocalRing.closedPoint A ∈ closure ({h y} : Set (Spec (.of A))) := by
      exact (PrimeSpectrum.le_iff_mem_closure (R := A) (h y) (IsLocalRing.closedPoint A)).mp
        (IsLocalRing.le_maximalIdeal (h y).isPrime.ne_top)
    obtain ⟨z, hz, hz'⟩ := closure_minimal (Set.singleton_subset_iff.mpr hy) hC hmem
    exact ⟨z, hz, hz'⟩

  let Z : TopologicalSpace.Closeds Y := ⟨closure {y}, isClosed_closure⟩
  let I := Scheme.IdealSheafData.vanishingIdeal Z
  obtain ⟨R, r, hr, hrsurj, hred⟩ := wc_reduced_subscheme_exists I.subscheme
  haveI := hr
  haveI := hred
  let f : R ⟶ Y := r ≫ I.subschemeι
  have hrange : Set.range f = closure {y} := by
    have h1 : Set.range I.subschemeι = closure {y} := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    rw [← h1]
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨r w, by simp [f, Scheme.Hom.comp_apply]⟩
    · rintro ⟨v, rfl⟩
      have hv : v ∈ Set.range r := hrsurj ▸ Set.mem_univ v
      obtain ⟨w, rfl⟩ := hv
      exact ⟨w, by simp [f, Scheme.Hom.comp_apply]⟩
  haveI : IrreducibleSpace R := by
    have hemb := (Scheme.Hom.isClosedEmbedding f).isEmbedding
    have hirr : IsIrreducible (Set.range f) := hrange ▸ isIrreducible_singleton.closure
    haveI : IrreducibleSpace (Set.range f) := Subtype.irreducibleSpace hirr
    let e := hemb.toHomeomorph
    exact Function.Surjective.irreducibleSpace e.symm.continuous e.symm.surjective
  haveI : IsIntegral R := isIntegral_of_irreducibleSpace_of_isReduced R
  let g : R ⟶ Spec (.of A) := f ≫ h

  let φ : A →+* Γ(R, ⊤) := g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom
  have hφ : φ.IsIntegral := by
    have h1 : g.appTop.hom.IsIntegral := isIntegral_appTop_of_universallyClosed g
    have h2 : (Scheme.ΓSpecIso (.of A)).inv.hom.IsIntegral := by
      apply RingHom.isIntegral_of_surjective
      intro x
      exact ⟨(Scheme.ΓSpecIso (.of A)).hom.hom x, by simp⟩
    exact RingHom.IsIntegral.trans _ _ h2 h1
  obtain ⟨z, hzc, hzh⟩ := hz
  have hzR : z ∈ Set.range f := hrange ▸ hzc
  obtain ⟨w, rfl⟩ := hzR
  haveI : Nonempty (⊤ : R.Opens) := ⟨⟨w, trivial⟩⟩
  haveI : IsDomain Γ(R, ⊤) := IsIntegral.component_integral (⊤ : R.Opens)
  letI : Algebra A Γ(R, ⊤) := φ.toAlgebra
  have hint : Algebra.IsIntegral A Γ(R, ⊤) := ⟨fun x => hφ x⟩
  haveI hloc : IsLocalRing Γ(R, ⊤) :=
    (wc_henselian_integral_domain_local A Γ(R, ⊤) inferInstance hint).1

  let F := g ⁻¹' {IsLocalRing.closedPoint A}
  have hFc : IsClosed F :=
    (IsLocalRing.isClosed_singleton_closedPoint A).preimage g.continuous
  have hwF : w ∈ F := by
    show g w ∈ ({IsLocalRing.closedPoint A} : Set (Spec (.of A)))
    simp only [g, Scheme.Hom.comp_apply, Set.mem_singleton_iff]
    exact hzh
  have hFconn : _root_.IsConnected F := by
    refine ⟨⟨w, hwF⟩, ?_⟩
    rw [isPreconnected_closed_iff]
    intro t t' ht ht' hcov ⟨x₁, hx₁F, hx₁t⟩ ⟨x₂, hx₂F, hx₂t'⟩
    by_contra hne
    rw [Set.not_nonempty_iff_eq_empty] at hne
    have hdisj : Disjoint (F ∩ t) (F ∩ t') := by
      rw [Set.disjoint_iff]
      rintro x ⟨⟨hF, hxt⟩, ⟨_, hxt'⟩⟩
      have hx : x ∈ F ∩ (t ∩ t') := ⟨hF, hxt, hxt'⟩
      rw [hne] at hx
      exact hx
    have hunion : F ∩ t ∪ F ∩ t' = g ⁻¹' {IsLocalRing.closedPoint A} := by
      ext x
      constructor
      · rintro (⟨h1, _⟩ | ⟨h1, _⟩) <;> exact h1
      · intro hx
        rcases hcov hx with h1 | h1
        · exact Or.inl ⟨hx, h1⟩
        · exact Or.inr ⟨hx, h1⟩
    obtain ⟨b, hb1, hb2⟩ := wc_proper_local_closed_fibre_clopen_lift A R g (F ∩ t) (F ∩ t')
      (hFc.inter ht) (hFc.inter ht') hdisj hunion
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self b with hu | hu
    · exact hb2 x₂ ⟨hx₂F, hx₂t'⟩ (by rw [R.basicOpen_of_isUnit hu]; simp)
    · exact hb1 x₁ ⟨hx₁F, hx₁t⟩ (by rw [R.basicOpen_of_isUnit hu]; simp)
  have himg : f '' F = closure {y} ∩ h ⁻¹' {IsLocalRing.closedPoint A} := by
    have hF : F = f ⁻¹' (h ⁻¹' {IsLocalRing.closedPoint A}) := by
      ext x
      simp [F, g, Scheme.Hom.comp_apply]
    rw [hF, Set.image_preimage_eq_inter_range, hrange, Set.inter_comm]
  rw [← himg]
  exact hFconn.image f f.continuous.continuousOn

theorem wc_et_proper_henselian_gamma_quotient_surj : ∀ (A : Type u) [CommRing A]
    [HenselianLocalRing A] (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of A)) [IsProper f']
    (J J' : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) (ι : J' ⟶ J), Mono ι →
    wcSuppIn X' {x | f' x ≠ IsLocalRing.closedPoint A} J' →
    (∀ (G : Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) (φ : G ⟶ J),
        wcSuppIn X' {x | f' x ≠ IsLocalRing.closedPoint A} G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ) →
    ∀ t : (Limits.cokernel ι).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 X'))),
      ∃ s : J.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 X'))),
        ((Limits.cokernel.π ι).hom.app (Opposite.op (Scheme.Etale.mk (𝟙 X')))).hom s = t :=
by
  intro A _ _ X' f' _ J J' ι hmono hsupp huniv t
  classical
  have hkey := wc_et_quot_kernel_iff_supp X' {x | f' x ≠ IsLocalRing.closedPoint A} J J' ι
    hmono hsupp huniv

  have hWo : IsOpen {x : X' | f' x ≠ IsLocalRing.closedPoint A} := by
    have e : {x : X' | f' x ≠ IsLocalRing.closedPoint A} =
        (f' ⁻¹' {IsLocalRing.closedPoint A})ᶜ := by
      ext x; exact Iff.rfl
    rw [e]
    exact ((IsLocalRing.isClosed_singleton_closedPoint A).preimage f'.continuous).isOpen_compl

  have hEG : wcEtGlueMod X' {x | f' x ≠ IsLocalRing.closedPoint A} J := by
    refine wc_et_gluing_of_zariski_finite A X' f' _ hWo ?_ ?_ J
    · intro Y p _ G
      have e : p ⁻¹' {x : X' | f' x ≠ IsLocalRing.closedPoint A} =
          ((p ≫ f') ⁻¹' {IsLocalRing.closedPoint A})ᶜ := by
        ext y; exact Iff.rfl
      rw [e]
      exact wc_zariski_spectral_trace_gluing A Y (p ≫ f') _
        ((IsLocalRing.isClosed_singleton_closedPoint A).preimage (p ≫ f').continuous)
        (wc_proper_henselian_fibre_trace_connected A Y (p ≫ f')) G
    · intro Y p _ G b hb
      have e : p ⁻¹' {x : X' | f' x ≠ IsLocalRing.closedPoint A} =
          {y | (p ≫ f') y ≠ IsLocalRing.closedPoint A} := by
        ext y; simp
      rw [e] at hb
      exact wc_et_supp_section_vanishing A Y (p ≫ f') (Scheme.Hom.isClosedMap _) G b hb

  have hR := wc_sheaf_epi_locallySurjective (Scheme.smallEtaleTopology X') (Limits.cokernel.π ι)
    (Scheme.Etale.mk (𝟙 X')) t
  let sl : ∀ (V : X'.Etale) (g : V ⟶ Scheme.Etale.mk (𝟙 X')),
      (Presheaf.imageSieve (Limits.cokernel.π ι).hom t).arrows g → J.obj.obj (Opposite.op V) :=
    fun V g h => h.choose
  have hsl : ∀ (V : X'.Etale) (g : V ⟶ Scheme.Etale.mk (𝟙 X'))
      (h : (Presheaf.imageSieve (Limits.cokernel.π ι).hom t).arrows g),
      ((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom (sl V g h) =
        ((Limits.cokernel ι).obj.map g.op).hom t := fun V g h => h.choose_spec
  have hnat : ∀ (V V' : X'.Etale) (a : V' ⟶ V) (x : J.obj.obj (Opposite.op V)),
      ((Limits.cokernel.π ι).hom.app (Opposite.op V')).hom (J.obj.map a.op x) =
        ((Limits.cokernel ι).obj.map a.op).hom
          (((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom x) := by
    intro V V' a x
    exact NatTrans.naturality_apply (Limits.cokernel.π ι).hom a.op x
  have hlift : ∀ (V V' : X'.Etale) (g : V ⟶ Scheme.Etale.mk (𝟙 X'))
      (h : (Presheaf.imageSieve (Limits.cokernel.π ι).hom t).arrows g) (a : V' ⟶ V),
      ((Limits.cokernel.π ι).hom.app (Opposite.op V')).hom (J.obj.map a.op (sl V g h)) =
        ((Limits.cokernel ι).obj.map (a ≫ g).op).hom t := by
    intro V V' g h a
    rw [hnat, hsl, op_comp, Functor.map_comp]
    rfl

  have hcompat : ∀ (V₁ V₂ V' : X'.Etale) (g₁ : V₁ ⟶ Scheme.Etale.mk (𝟙 X'))
      (g₂ : V₂ ⟶ Scheme.Etale.mk (𝟙 X'))
      (h₁ : (Presheaf.imageSieve (Limits.cokernel.π ι).hom t).arrows g₁)
      (h₂ : (Presheaf.imageSieve (Limits.cokernel.π ι).hom t).arrows g₂)
      (a : V' ⟶ V₁) (c : V' ⟶ V₂), a ≫ g₁ = c ≫ g₂ →
      wcSuppSec X' {x | f' x ≠ IsLocalRing.closedPoint A} J V'
        (J.obj.map a.op (sl V₁ g₁ h₁) - J.obj.map c.op (sl V₂ g₂ h₂)) := by
    intro V₁ V₂ V' g₁ g₂ h₁ h₂ a c hac
    rw [← hkey, map_sub, hlift, hlift, hac, sub_self]

  obtain ⟨s₀, hs₀⟩ := hEG _ hR sl hcompat

  refine ⟨s₀, (Limits.cokernel ι).isSeparated _ _ hR _ _ (fun V g hg => ?_)⟩
  have h0 := (hkey V _).mpr (hs₀ V g hg)
  rw [map_sub, sub_eq_zero] at h0
  have h1 := hnat _ V g s₀
  have h2 := hsl V g hg
  exact h1.symm.trans (h0.trans h2)

theorem wc_et_ext0_surj_of_sections : ∀ (Y : Scheme.{u})
    {B Q : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (g : B ⟶ Q),
    (∀ t : Q.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))),
      ∃ s : B.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y))),
        (g.hom.app (Opposite.op (Scheme.Etale.mk (𝟙 Y)))).hom s = t) →
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∀ x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) Q 0,
      ∃ y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) B 0, y.comp (Abelian.Ext.mk₀ g) (add_zero 0) = x :=
by
  intro Y B Q g hsurj
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro x
  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨s, hs⟩ := hsurj ((Sheaf.H.equiv₀ Q hT) x)
  refine ⟨(Sheaf.H.equiv₀ B hT).symm s, (Sheaf.H.equiv₀ Q hT).injective ?_⟩
  have h := Sheaf.H.equiv₀_naturality hT g ((Sheaf.H.equiv₀ B hT).symm s)
  rw [AddEquiv.apply_symm_apply, Sheaf.H.map_apply] at h
  rw [← h, hs]

theorem wc_et_maxsupp_sections_surj : ∀ (Y : Scheme.{u}) (W : Set Y)
    (K J' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ι : J' ⟶ K),
    (∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : G ⟶ K),
        wcSuppIn Y W G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ) →
    ∀ V : Y.Etale, (∀ x, V.hom x ∈ W) → Function.Surjective (ι.hom.app (Opposite.op V)).hom :=
by
  intro Y W J J' ι huniv
  classical
  let Psub : ∀ V : Y.Etale, AddSubgroup (J.obj.obj (Opposite.op V)) :=
    fun V => ⨆ (_ : ∀ x, V.hom x ∈ W), ⊤
  have hres : ∀ {V V' : Y.Etale} (g : V' ⟶ V),
      Psub V ≤ (Psub V').comap (J.obj.map g.op).hom := by
    intro V V' g
    apply iSup_le
    intro hp
    have hp' : ∀ x, V'.hom x ∈ W := fun x => by
      rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact hp _
    intro y _
    show (J.obj.map g.op).hom y ∈ (⨆ (_ : ∀ x, V'.hom x ∈ W),
      (⊤ : AddSubgroup (J.obj.obj (Opposite.op V'))))
    rw [iSup_pos hp']
    exact AddSubgroup.mem_top _
  let P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    { obj := fun V => AddCommGrpCat.of (Psub V.unop)
      map := fun {V V'} g => AddCommGrpCat.ofHom
        (((J.obj.map g).hom.comp (Psub V.unop).subtype).codRestrict (Psub V'.unop)
          (fun x => hres g.unop x.2))
      map_id := fun V => by
        ext x
        simp
      map_comp := fun f g => by
        ext x
        simp
        rfl }
  let α : P ⟶ J.obj :=
    { app := fun V => AddCommGrpCat.ofHom (Psub V.unop).subtype
      naturality := fun _ _ _ => rfl }
  let η := toSheafify (Scheme.smallEtaleTopology Y) P
  have hG : wcSuppIn Y W
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P) := by
    intro V s
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) η :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) η s
    refine GrothendieckTopology.superset_covering _ ?_ hI
    intro V' g hg
    obtain ⟨t, ht⟩ := hg
    apply Sieve.le_generate
    by_cases hp : ∀ x, V'.hom x ∈ W
    · exact Or.inr hp
    · left
      have ht0 : t = 0 := by
        obtain ⟨y, hy⟩ := t
        have hy' : y ∈ (⨆ (_ : ∀ x, V'.hom x ∈ W),
            (⊤ : AddSubgroup (J.obj.obj (Opposite.op V')))) := hy
        rw [iSup_neg hp] at hy'
        exact Subtype.ext (AddSubgroup.mem_bot.mp hy')
      have h2 : (sheafify (Scheme.smallEtaleTopology Y) P).map g.op s = 0 := by
        rw [← ht, ht0, map_zero]
      exact h2
  let φ : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P ⟶ J :=
    ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology Y) α J.property)
  obtain ⟨φ', hφ'⟩ := huniv _ φ hG
  intro V hV c
  have hc : c ∈ Psub V := by
    show c ∈ (⨆ (_ : ∀ x, V.hom x ∈ W), (⊤ : AddSubgroup (J.obj.obj (Opposite.op V))))
    rw [iSup_pos hV]
    exact AddSubgroup.mem_top c
  refine ⟨(φ'.hom.app (Opposite.op V)).hom ((η.app (Opposite.op V)).hom ⟨c, hc⟩), ?_⟩
  have e : η ≫ φ'.hom ≫ ι.hom = α := by
    have e1 : φ'.hom ≫ ι.hom = φ.hom := congrArg (fun f => f.hom) hφ'
    rw [e1]
    exact toSheafify_sheafifyLift _ _ _
  have := congrArg (fun f : P ⟶ J.obj => (f.app (Opposite.op V)).hom ⟨c, hc⟩) e
  exact this

theorem wc_P1_base_change_affine_cover : ∀ (R : Type u) [CommRing R] (A : Type u) [CommRing A]
    (a : Spec (.of A) ⟶ Spec (.of ((MvPolynomial.homogeneousSubmodule (Fin 2) R) 0)))
    (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of A))
    (a' : X' ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) R) MvPolynomial.gradedAlgebra),
    IsPullback a' f' (wcP1 R) a →
    ∃ U₀ U₁ : X'.Opens, U₀ ⊔ U₁ = ⊤ ∧ IsAffineOpen U₀ ∧ IsAffineOpen U₁ ∧ IsAffineOpen (U₀ ⊓ U₁) :=
by
  intro R _ A _ a X' f' a' hsq
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin 2) R) := MvPolynomial.gradedAlgebra

  have s1 : ∀ p : MvPolynomial (Fin 2) R, MvPolynomial.homogeneousComponent 0 p = 0 →
      p ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) R)) := by
    intro p hp
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at hp
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) hp
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨i, Set.mem_univ i, hi⟩

  haveI : IsAffineHom a' :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hsq.flip (isAffineHom_of_isAffine a)

  have hD₀ := Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) R)
    (MvPolynomial.X 0) (m := 1)
    ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R 0)) Nat.one_pos
  have hD₁ := Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) R)
    (MvPolynomial.X 1) (m := 1)
    ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R 1)) Nat.one_pos
  have hD₀₁ := Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) R)
    (MvPolynomial.X 0 * MvPolynomial.X 1) (m := 1 + 1)
    ((MvPolynomial.mem_homogeneousSubmodule (1 + 1) _).mpr
      ((MvPolynomial.isHomogeneous_X R 0).mul (MvPolynomial.isHomogeneous_X R 1))) (by norm_num)
  rw [Proj.basicOpen_mul] at hD₀₁

  have hsup := Proj.iSup_basicOpen_eq_top (MvPolynomial.homogeneousSubmodule (Fin 2) R)
    (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) R)
    (fun p hp => s1 p (((MvPolynomial.decomposition.decompose'_apply p 0).symm.trans
      ((HomogeneousIdeal.mem_irrelevant_iff _ p).mp hp))))
  have hcov : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) R) (MvPolynomial.X 0) ⊔
      Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) R) (MvPolynomial.X 1) = ⊤ := by
    rw [eq_top_iff, ← hsup]
    exact iSup_le (Fin.forall_fin_two.mpr ⟨le_sup_left, le_sup_right⟩)

  refine ⟨a' ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) R) (MvPolynomial.X 0),
    a' ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin 2) R) (MvPolynomial.X 1),
    ?_, hD₀.preimage a', hD₁.preimage a', ?_⟩
  · rw [← Scheme.Hom.preimage_sup, hcov, Scheme.Hom.preimage_top]
  · rw [← Scheme.Hom.preimage_inf]
    exact hD₀₁.preimage a'

theorem wc_et_free_mayer_vietoris_ses : ∀ (Y : Scheme.{u}) (U₀ U₁ : Y.Opens), U₀ ⊔ U₁ = ⊤ →
    ∃ (f : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj ((wcZarToEt Y).obj (U₀ ⊓ U₁)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj ((wcZarToEt Y).obj U₀) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⊞
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj ((wcZarToEt Y).obj U₁) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj ((wcZarToEt Y).obj U₀) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⊞
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj ((wcZarToEt Y).obj U₁) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
        (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      (h : f ≫ g = 0), (ShortComplex.mk f g h).ShortExact :=
by
  intro Y U₀ U₁ htop

  have S4 : ∀ {A B₀ B₁ P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (a₀ : A ⟶ B₀) (a₁ : A ⟶ B₁)
      (b₀ : B₀ ⟶ P) (b₁ : B₁ ⟶ P) (h : Limits.biprod.lift a₀ a₁ ≫ Limits.biprod.desc b₀ b₁ = 0),
      (∀ (X : (Y.Etale)ᵒᵖ) (x₀ : B₀.obj X) (x₁ : B₁.obj X),
        (b₀.app X).hom x₀ + (b₁.app X).hom x₁ = 0 →
        ∃ y : A.obj X, (a₀.app X).hom y = x₀ ∧ (a₁.app X).hom y = x₁) →
      (ShortComplex.mk (Limits.biprod.lift a₀ a₁) (Limits.biprod.desc b₀ b₁) h).Exact := by
    intro A B₀ B₁ P a₀ a₁ b₀ b₁ h H
    rw [ShortComplex.exact_iff_isZero_homology]
    apply Functor.isZero
    intro X
    have hX : ((ShortComplex.mk (Limits.biprod.lift a₀ a₁) (Limits.biprod.desc b₀ b₁) h).map
        ((evaluation _ _).obj X)).Exact := by
      rw [ShortComplex.ab_exact_iff]
      intro x hx
      have htot : ∀ z : (B₀ ⊞ B₁).obj X,
          z = (NatTrans.app (Limits.biprod.inl : B₀ ⟶ B₀ ⊞ B₁) X).hom
              ((NatTrans.app (Limits.biprod.fst : B₀ ⊞ B₁ ⟶ B₀) X).hom z) +
            (NatTrans.app (Limits.biprod.inr : B₁ ⟶ B₀ ⊞ B₁) X).hom
              ((NatTrans.app (Limits.biprod.snd : B₀ ⊞ B₁ ⟶ B₁) X).hom z) := by
        intro z
        have := congrArg (fun φ : B₀ ⊞ B₁ ⟶ B₀ ⊞ B₁ => (φ.app X).hom z)
          (Limits.biprod.total (X := B₀) (Y := B₁))
        simp only [NatTrans.app_add, NatTrans.comp_app, NatTrans.id_app, AddCommGrpCat.hom_add,
          AddCommGrpCat.hom_comp, AddCommGrpCat.hom_id, AddMonoidHom.add_apply,
          AddMonoidHom.comp_apply, AddMonoidHom.id_apply] at this
        exact this.symm
      have e1 : ((Limits.biprod.desc b₀ b₁).app X).hom x =
          (b₀.app X).hom ((NatTrans.app (Limits.biprod.fst : B₀ ⊞ B₁ ⟶ B₀) X).hom x) +
          (b₁.app X).hom ((NatTrans.app (Limits.biprod.snd : B₀ ⊞ B₁ ⟶ B₁) X).hom x) := by
        conv_lhs => rw [htot x]
        rw [map_add]
        congr 1
        · change ((Limits.biprod.inl ≫ Limits.biprod.desc b₀ b₁).app X).hom _ = _
          rw [Limits.biprod.inl_desc]
        · change ((Limits.biprod.inr ≫ Limits.biprod.desc b₀ b₁).app X).hom _ = _
          rw [Limits.biprod.inr_desc]
      obtain ⟨y, hy0, hy1⟩ := H X _ _ (e1.symm.trans hx)
      refine ⟨y, ?_⟩
      change ((Limits.biprod.lift a₀ a₁).app X).hom y = x
      have f1 : (NatTrans.app (Limits.biprod.fst : B₀ ⊞ B₁ ⟶ B₀) X).hom
            (((Limits.biprod.lift a₀ a₁).app X).hom y) =
          (NatTrans.app (Limits.biprod.fst : B₀ ⊞ B₁ ⟶ B₀) X).hom x := by
        change ((Limits.biprod.lift a₀ a₁ ≫ Limits.biprod.fst).app X).hom y = _
        rw [Limits.biprod.lift_fst]; exact hy0
      have f2 : (NatTrans.app (Limits.biprod.snd : B₀ ⊞ B₁ ⟶ B₁) X).hom
            (((Limits.biprod.lift a₀ a₁).app X).hom y) =
          (NatTrans.app (Limits.biprod.snd : B₀ ⊞ B₁ ⟶ B₁) X).hom x := by
        change ((Limits.biprod.lift a₀ a₁ ≫ Limits.biprod.snd).app X).hom y = _
        rw [Limits.biprod.lift_snd]; exact hy1
      rw [htot (((Limits.biprod.lift a₀ a₁).app X).hom y), f1, f2, ← htot x]
    exact ((ShortComplex.exact_iff_isZero_homology _).mp hX).of_iso
      (ShortComplex.mapHomologyIso _ ((evaluation _ _).obj X)).symm

  have S5 : ∀ {A B₀ B₁ P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (f₀ : A ⟶ B₀ ⊞ B₁)
      (g₀ : B₀ ⊞ B₁ ⟶ P) (h₀ : f₀ ≫ g₀ = 0), Mono f₀ → (ShortComplex.mk f₀ g₀ h₀).Exact →
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) g₀ →
      ∃ (f : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj A ⟶
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj B₀ ⊞
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj B₁)
        (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj B₀ ⊞
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj B₁ ⟶
            (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P)
        (h : f ≫ g = 0), (ShortComplex.mk f g h).ShortExact := by
    intro A B₀ B₁ P f₀ g₀ h₀ hmono hex hls
    haveI := Limits.preservesBinaryBiproduct_of_preservesBinaryProduct
      (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (X := B₀) (Y := B₁)
    have hS : ((ShortComplex.mk f₀ g₀ h₀).map
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})).ShortExact := by
      haveI : Sheaf.IsLocallySurjective
          ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g₀) :=
        (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ g₀).mpr hls
      haveI := hmono
      exact ShortComplex.ShortExact.mk' (hex.map _)
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_mono f₀)
        (Sheaf.epi_of_isLocallySurjective
          ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g₀))
    refine ⟨(presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map f₀ ≫
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapBiprod B₀ B₁).hom,
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapBiprod B₀ B₁).inv ≫
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map g₀, ?_, ?_⟩
    · rw [Category.assoc, Iso.hom_inv_id_assoc, ← Functor.map_comp, h₀, Functor.map_zero]
    · exact ShortComplex.shortExact_of_iso (S₁ := (ShortComplex.mk f₀ g₀ h₀).map
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}))
        (ShortComplex.isoMk (Iso.refl _)
          ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).mapBiprod B₀ B₁)
          (Iso.refl _) (by simp)
          (by dsimp only; rw [Iso.refl_hom, Category.comp_id, Iso.hom_inv_id_assoc]; rfl)) hS

  have hT1 : ∀ (U : Y.Opens) (V : Y.Etale), Subsingleton (V ⟶ (wcZarToEt Y).obj U) ∧
      (Nonempty (V ⟶ (wcZarToEt Y).obj U) ↔ Set.range V.hom ⊆ (U : Set Y)) := by
    intro U V
    have hw : ∀ φ : V ⟶ (wcZarToEt Y).obj U, φ.left ≫ U.ι = V.hom :=
      fun φ => MorphismProperty.Over.w φ
    refine ⟨⟨fun φ ψ => ?_⟩, ⟨fun ⟨φ⟩ => ?_, fun h => ?_⟩⟩
    · apply MorphismProperty.Over.Hom.ext
      exact (cancel_mono U.ι).mp ((hw φ).trans (hw ψ).symm)
    · have h1 : Set.range V.hom ⊆ Set.range U.ι := by
        rintro _ ⟨x, rfl⟩
        exact ⟨φ.left x, by rw [← hw φ]; rfl⟩
      rwa [Scheme.Opens.range_ι] at h1
    · have hr : Set.range V.hom ⊆ Set.range U.ι := by
        rw [Scheme.Opens.range_ι]; exact h
      let ℓ : V.left ⟶ (U : Scheme.{u}) := IsOpenImmersion.lift U.ι V.hom hr
      have hℓ : ℓ ≫ U.ι = V.hom := IsOpenImmersion.lift_fac _ _ _
      exact ⟨MorphismProperty.Over.homMk ℓ hℓ trivial⟩

  have hK : ∀ {α : Type (u+1)}, (∀ a b : α, a = b) → ∀ (a : α) (z : FreeAbelianGroup α),
      z = (FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) z).down •
        FreeAbelianGroup.of a := by
    intro α hα a z
    induction z using FreeAbelianGroup.induction_on with
    | zero => simp
    | of x => rw [hα x a]; simp
    | neg x ih => rw [hα x a]; simp
    | add x y hx hy =>
      rw [map_add, ULift.add_down, add_zsmul, ← hx, ← hy]
  have hE : ∀ {α : Type (u+1)}, ¬ Nonempty α → ∀ z : FreeAbelianGroup α, z = 0 := by
    intro α hα z
    induction z using FreeAbelianGroup.induction_on with
    | zero => rfl
    | of x => exact absurd ⟨x⟩ hα
    | neg x ih => exact absurd ⟨x⟩ hα
    | add x y hx hy => rw [hx, hy, add_zero]
  have hZ : ∀ {α : Type (u+1)}, (∀ a b : α, a = b) → ∀ z : FreeAbelianGroup α,
      FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) z = 0 → z = 0 := by
    intro α hα z hz
    by_cases hn : Nonempty α
    · obtain ⟨a⟩ := hn
      rw [hK hα a z, hz]; simp
    · exact hE hn z
  have hM : ∀ {α β : Type (u+1)} (i : α → β) (z : FreeAbelianGroup α),
      FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) (FreeAbelianGroup.map i z) =
        FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) z := by
    intro α β i z
    induction z using FreeAbelianGroup.induction_on with
    | zero => simp
    | of x => simp
    | neg x ih => simp
    | add x y hx hy => simp only [map_add, hx, hy]

  have hC : ∀ T : Y.Etale, ∃ c : (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
      (Functor.const (Y.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)),
      ∀ (V : (Y.Etale)ᵒᵖ) (z : FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ T))),
        (c.app V).hom z = FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) z := by
    intro T
    refine ⟨{ app := fun V => AddCommGrpCat.ofHom
                (FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)))
              naturality := ?_ }, fun V z => rfl⟩
    intro V V' g
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro z
    exact hM (fun e : ULift.{u+1} (V.unop ⟶ T) => ULift.up (g.unop ≫ e.down)) z

  have hI : ∀ (U U' : Y.Opens) (hle : U ≤ U'),
      ∃ (ι : (yoneda.obj ((wcZarToEt Y).obj U) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
          (yoneda.obj ((wcZarToEt Y).obj U') ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
        (i : ∀ V : (Y.Etale)ᵒᵖ, ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj U) →
          ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj U')),
        ∀ (V : (Y.Etale)ᵒᵖ) (z : FreeAbelianGroup (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj U))),
          (ι.app V).hom z = FreeAbelianGroup.map (i V) z :=
    fun U U' hle => ⟨Functor.whiskerRight (yoneda.map ((wcZarToEt Y).map (homOfLE hle)))
      (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free),
      fun V e => ULift.up (e.down ≫ (wcZarToEt Y).map (homOfLE hle)), fun V z => rfl⟩
  obtain ⟨ι₀, i₀, hι₀⟩ := hI _ _ (inf_le_left : U₀ ⊓ U₁ ≤ U₀)
  obtain ⟨ι₁, i₁, hι₁⟩ := hI _ _ (inf_le_right : U₀ ⊓ U₁ ≤ U₁)
  obtain ⟨c₀, hc₀⟩ := hC ((wcZarToEt Y).obj U₀)
  obtain ⟨c₁, hc₁⟩ := hC ((wcZarToEt Y).obj U₁)
  obtain ⟨c₀₁, hc₀₁⟩ := hC ((wcZarToEt Y).obj (U₀ ⊓ U₁))
  have hsub : ∀ (U : Y.Opens) (V : (Y.Etale)ᵒᵖ) (a b : ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj U)),
      a = b := fun U V a b => ULift.ext _ _ ((hT1 U V.unop).1.elim _ _)
  have hne : ∀ V : (Y.Etale)ᵒᵖ, Nonempty (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj U₀)) →
      Nonempty (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj U₁)) →
      Nonempty (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj (U₀ ⊓ U₁))) := by
    rintro V ⟨e₀⟩ ⟨e₁⟩
    have h0 := (hT1 U₀ V.unop).2.mp ⟨e₀.down⟩
    have h1 := (hT1 U₁ V.unop).2.mp ⟨e₁.down⟩
    have h01 : Set.range V.unop.hom ⊆ ((U₀ ⊓ U₁ : Y.Opens) : Set Y) := by
      rw [TopologicalSpace.Opens.coe_inf]; exact Set.subset_inter h0 h1
    obtain ⟨e⟩ := (hT1 (U₀ ⊓ U₁) V.unop).2.mpr h01
    exact ⟨ULift.up e⟩
  have hinj : ∀ V : (Y.Etale)ᵒᵖ, Function.Injective (FreeAbelianGroup.map (i₀ V)) := by
    intro V z z' hzz
    by_cases h : Nonempty (ULift.{u+1} (V.unop ⟶ (wcZarToEt Y).obj (U₀ ⊓ U₁)))
    · obtain ⟨a⟩ := h
      rw [hK (hsub _ V) a z, hK (hsub _ V) a z', ← hM (i₀ V) z, ← hM (i₀ V) z', hzz]
    · rw [hE h z, hE h z']

  have e0 : ι₀ ≫ c₀ = c₀₁ := by
    apply NatTrans.ext; funext V; apply AddCommGrpCat.hom_ext; apply AddMonoidHom.ext; intro z
    exact (congrArg (c₀.app V).hom (hι₀ V z)).trans
      ((hc₀ V _).trans ((hM (i₀ V) z).trans (hc₀₁ V z).symm))
  have e1 : ι₁ ≫ c₁ = c₀₁ := by
    apply NatTrans.ext; funext V; apply AddCommGrpCat.hom_ext; apply AddMonoidHom.ext; intro z
    exact (congrArg (c₁.app V).hom (hι₁ V z)).trans
      ((hc₁ V _).trans ((hM (i₁ V) z).trans (hc₀₁ V z).symm))
  have h₀ : Limits.biprod.lift ι₀ (-ι₁) ≫ Limits.biprod.desc c₀ c₁ = 0 := by
    rw [Limits.biprod.lift_desc, Preadditive.neg_comp, e0, e1, add_neg_cancel]
  have hmono0 : Mono ι₀ := by
    have : ∀ V, Mono (ι₀.app V) := fun V => (AddCommGrpCat.mono_iff_injective _).mpr (by
      intro z z' h
      exact hinj V ((hι₀ V z).symm.trans (h.trans (hι₀ V z'))))
    exact NatTrans.mono_of_mono_app ι₀
  have hmono : Mono (Limits.biprod.lift ι₀ (-ι₁)) :=
    mono_of_mono_fac (Limits.biprod.lift_fst ι₀ (-ι₁))

  have key : ∀ (X : (Y.Etale)ᵒᵖ) (x₀ : FreeAbelianGroup (ULift.{u+1} (X.unop ⟶ (wcZarToEt Y).obj U₀)))
      (x₁ : FreeAbelianGroup (ULift.{u+1} (X.unop ⟶ (wcZarToEt Y).obj U₁))),
      FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₀ +
        FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₁ = 0 →
      ∃ y : FreeAbelianGroup (ULift.{u+1} (X.unop ⟶ (wcZarToEt Y).obj (U₀ ⊓ U₁))),
        FreeAbelianGroup.map (i₀ X) y = x₀ ∧ -(FreeAbelianGroup.map (i₁ X) y) = x₁ := by
    intro X x₀ x₁ hx'
    by_cases h0 : Nonempty (ULift.{u+1} (X.unop ⟶ (wcZarToEt Y).obj U₀))
    · by_cases h1 : Nonempty (ULift.{u+1} (X.unop ⟶ (wcZarToEt Y).obj U₁))
      · obtain ⟨a⟩ := hne X h0 h1
        have hd : (FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₁).down =
            -(FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₀).down := by
          have := congrArg ULift.down hx'
          simp only [ULift.add_down, ULift.zero_down] at this
          omega
        refine ⟨(FreeAbelianGroup.lift (fun _ => (ULift.up 1 : ULift.{u+1} ℤ)) x₀).down •
          FreeAbelianGroup.of a, ?_, ?_⟩
        · rw [map_zsmul, FreeAbelianGroup.map_of_apply]
          exact (hK (hsub U₀ X) (i₀ X a) x₀).symm
        · rw [map_zsmul, FreeAbelianGroup.map_of_apply, ← neg_zsmul, ← hd]
          exact (hK (hsub U₁ X) (i₁ X a) x₁).symm
      · have hx1 : x₁ = 0 := hE h1 x₁
        have hx0 : x₀ = 0 := by
          apply hZ (hsub U₀ X)
          rw [hx1, map_zero, add_zero] at hx'
          exact hx'
        refine ⟨0, ?_, ?_⟩
        · rw [map_zero]; exact hx0.symm
        · rw [map_zero, neg_zero]; exact hx1.symm
    · have hx0 : x₀ = 0 := hE h0 x₀
      have hx1 : x₁ = 0 := by
        apply hZ (hsub U₁ X)
        rw [hx0, map_zero, zero_add] at hx'
        exact hx'
      refine ⟨0, ?_, ?_⟩
      · rw [map_zero]; exact hx0.symm
      · rw [map_zero, neg_zero]; exact hx1.symm
  have hex : (ShortComplex.mk (Limits.biprod.lift ι₀ (-ι₁)) (Limits.biprod.desc c₀ c₁) h₀).Exact := by
    apply S4
    intro X x₀ x₁ hx
    have hneg : ∀ y, ((-ι₁).app X).hom y = -((ι₁.app X).hom y) := by
      intro y; rw [NatTrans.app_neg, AddCommGrpCat.hom_neg]; rfl
    obtain ⟨y, hy0, hy1⟩ := key X x₀ x₁ ((congrArg₂ (· + ·) (hc₀ X x₀) (hc₁ X x₁)).symm.trans hx)
    exact ⟨y, (hι₀ X y).trans hy0, (hneg y).trans ((congrArg Neg.neg (hι₁ X y)).trans hy1)⟩

  have hls : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
      (Limits.biprod.desc c₀ c₁) := by
    constructor
    intro V s
    change _ ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    have hxtop : V.hom x ∈ U₀ ⊔ U₁ := by rw [htop]; trivial
    have harr : ∀ (U : Y.Opens) (hU : V.hom x ∈ U),
        (∀ (V₁ : Y.Etale) (φ : V₁ ⟶ (wcZarToEt Y).obj U) (c : V₁ ⟶ V),
          (Presheaf.imageSieve (Limits.biprod.desc c₀ c₁) s).arrows c) →
        ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (y : V₁.left),
          (Presheaf.imageSieve (Limits.biprod.desc c₀ c₁) s).arrows c ∧ Etale c.left ∧ c.left y = x := by
      intro U hU H
      let O : V.left.Opens := V.hom ⁻¹ᵁ U
      let V₁ : Y.Etale := Scheme.Etale.mk (O.ι ≫ V.hom)
      let c : V₁ ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
      have hr : Set.range V₁.hom ⊆ (U : Set Y) := by
        rintro _ ⟨y, rfl⟩
        show V.hom (O.ι y) ∈ U
        have hy : O.ι y ∈ (O : Set V.left) := by
          have : O.ι y ∈ Set.range O.ι := ⟨y, rfl⟩
          rwa [Scheme.Opens.range_ι] at this
        exact hy
      obtain ⟨φ⟩ := (hT1 U V₁).2.mpr hr
      refine ⟨V₁, c, ⟨x, hU⟩, H V₁ φ c, ?_, ?_⟩
      · change Etale O.ι
        infer_instance
      · change O.ι ⟨x, hU⟩ = x
        rw [Scheme.Opens.ι_apply]
    rcases TopologicalSpace.Opens.mem_sup.mp hxtop with hx0 | hx1
    · refine harr U₀ hx0 (fun V₁ φ c => ?_)
      let w : FreeAbelianGroup (ULift.{u+1} (V₁ ⟶ (wcZarToEt Y).obj U₀)) :=
        s.down • FreeAbelianGroup.of (ULift.up φ)
      refine ⟨(NatTrans.app (Limits.biprod.inl :
        (yoneda.obj ((wcZarToEt Y).obj U₀) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ _)
          (Opposite.op V₁)).hom w, ?_⟩
      change ((Limits.biprod.inl ≫ Limits.biprod.desc c₀ c₁).app (Opposite.op V₁)).hom w = s
      rw [Limits.biprod.inl_desc, hc₀ (Opposite.op V₁) w]
      apply ULift.ext
      simp [w]
    · refine harr U₁ hx1 (fun V₁ φ c => ?_)
      let w : FreeAbelianGroup (ULift.{u+1} (V₁ ⟶ (wcZarToEt Y).obj U₁)) :=
        s.down • FreeAbelianGroup.of (ULift.up φ)
      refine ⟨(NatTrans.app (Limits.biprod.inr :
        (yoneda.obj ((wcZarToEt Y).obj U₁) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ _)
          (Opposite.op V₁)).hom w, ?_⟩
      change ((Limits.biprod.inr ≫ Limits.biprod.desc c₀ c₁).app (Opposite.op V₁)).hom w = s
      rw [Limits.biprod.inr_desc, hc₁ (Opposite.op V₁) w]
      apply ULift.ext
      simp [w]
  obtain ⟨f, g, h, hS⟩ := S5 _ _ h₀ hmono hex hls
  exact ⟨f, g, h, hS⟩

theorem wc_et_ext_free_slice : ∀ (Y : Scheme.{u}) (T : Y.Etale)
    [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)]
    (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (p : ℕ),
    Nonempty (
      (letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
       Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) F p) ≃
      wcEtExt T.left
        (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).obj F) p) :=
by
  intro Y T _ F p

  have rep : (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
      (evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T) ⋙
      forget AddCommGrpCat.{u+1}).CorepresentableBy
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) :=
    { homEquiv := fun {G} =>
        ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).homEquiv
          _ G).trans
          (((Adjunction.whiskerRight (Y.Etale)ᵒᵖ AddCommGrpCat.adj).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
      homEquiv_comp := fun {G G'} f g => by
        simp only [Equiv.trans_apply, Adjunction.homEquiv_naturality_right]
        rfl }

  obtain ⟨-, hcocont⟩ := wc_et_slice_continuous T
  haveI := hcocont
  haveI := wc_et_slice_lan_finite_limits T
  let Lf := (wcEtSlice T).sheafPullback AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left)
    (Scheme.smallEtaleTopology Y)
  let Rf := (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)
  let adj : Lf ⊣ Rf := (wcEtSlice T).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)
  let Z := (constantSheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))

  have hterm : Limits.IsTerminal (wcEtTop T.left) :=
    @MorphismProperty.Over.mkIdTerminal _ _ @Etale T.left
      MorphismProperty.IsMultiplicative.toContainsIdentities
  obtain ⟨ε, hεnat, -⟩ := wc_et_const_hom_sections_equiv T.left (wcEtTop T.left) hterm
  let r2 : (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
      (evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op T) ⋙
      forget AddCommGrpCat.{u+1}).CorepresentableBy (Lf.obj Z) :=
    { homEquiv := fun {M} => (adj.homEquiv Z M).trans (ε (Rf.obj M))
      homEquiv_comp := fun {M M'} f g => by
        show ε (Rf.obj M') (adj.homEquiv Z M' (g ≫ f)) = _
        rw [Adjunction.homEquiv_naturality_right, hεnat]
        rfl }
  let e : Lf.obj Z ≅ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := r2.uniqueUpToIso rep

  let adj2 := (wcEtSlice T).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Lf := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits Lf :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Lf
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Rf := adj2.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits Rf :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Rf
  haveI : Rf.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint Rf
  haveI : Rf.Additive := Functor.additive_of_preserves_binary_products Rf
  haveI : Lf.Additive := adj.left_adjoint_additive
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  let E₁ : Abelian.Ext (Lf.obj Z) F p ≃ Abelian.Ext Z (Rf.obj F) p :=
    (adj.extEquiv (X := Z) (Y := F) (n := p)).toEquiv

  let E₀ : Abelian.Ext ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) F p ≃
      Abelian.Ext (Lf.obj Z) F p :=
    { toFun := fun x => (Abelian.Ext.mk₀ e.hom).comp x (zero_add p)
      invFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add p)
      left_inv := fun x => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add p) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      right_inv := fun y => by
        simp only
        rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add p) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp] }
  exact ⟨E₀.trans E₁⟩

theorem wc_et_slice_restrict_torsion_data : ∀ (Y : Scheme.{u}) (T : Y.Etale)
    [(wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)]
    (W : Set Y) (m : ℕ)
    (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I]
    (J' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    (ι : J' ⟶ Limits.kernel (m • 𝟙 I)), Mono ι → wcSuppIn Y W J' →
    (∀ V : Y.Etale, (∀ x, V.hom x ∈ W) → Function.Surjective (ι.hom.app (Opposite.op V)).hom) →
    ∃ (IU JU : Sheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1})
      (ιU : JU ⟶ Limits.kernel (m • 𝟙 IU)),
      Injective IU ∧ Mono ιU ∧ wcSuppIn T.left (T.hom ⁻¹' W) JU ∧
      (∀ V : T.left.Etale, (∀ x, V.hom x ∈ T.hom ⁻¹' W) →
        Function.Surjective (ιU.hom.app (Opposite.op V)).hom) ∧
      Nonempty (((wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)).obj
            (Limits.cokernel ι) ≅ Limits.cokernel ιU) :=
by
  intro Y T _ W m I _ J' ι hι hsupp hsurj
  obtain ⟨-, hcocont⟩ := wc_et_slice_continuous T
  haveI := hcocont
  haveI := wc_et_slice_lan_finite_limits T
  let Lf := (wcEtSlice T).sheafPullback AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology T.left)
    (Scheme.smallEtaleTopology Y)
  let Rf := (wcEtSlice T).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)
  let adj : Lf ⊣ Rf := (wcEtSlice T).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)
  let adj2 := (wcEtSlice T).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology Y)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Rf := adj2.leftAdjoint_preservesColimits
  haveI : Rf.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint Rf
  haveI : Rf.Additive := Functor.additive_of_preserves_binary_products Rf
  haveI : Rf.IsRightAdjoint := adj.isRightAdjoint
  haveI : Limits.PreservesLimitsOfSize.{0, 0} Rf := adj.rightAdjoint_preservesLimits
  have hR : Rf.map (m • 𝟙 I) = m • 𝟙 (Rf.obj I) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
  let e : Rf.obj (Limits.kernel (m • 𝟙 I)) ≅ Limits.kernel (m • 𝟙 (Rf.obj I)) :=
    Limits.PreservesKernel.iso Rf (m • 𝟙 I) ≪≫ Limits.kernelIsoOfEq hR
  have hinj : Injective (Rf.obj I) := Injective.injective_of_adjoint adj I
  haveI := hι
  have hmono : Mono (Rf.map ι ≫ e.hom) := mono_comp _ _
  refine ⟨Rf.obj I, Rf.obj J', Rf.map ι ≫ e.hom, hinj, hmono, ?_, ?_, ?_⟩
  ·
    intro V s
    have hS := hsupp ((wcEtSlice T).obj V) s
    have hS' := (wcEtSlice T).cover_lift (Scheme.smallEtaleTopology T.left)
      (Scheme.smallEtaleTopology Y) hS
    refine GrothendieckTopology.superset_covering _ ?_ hS'
    intro V'' f hf
    obtain ⟨V', k, g, hg, hkg⟩ := hf
    apply Sieve.le_generate
    rcases hg with h0 | hW
    · left
      change J'.obj.map ((wcEtSlice T).map f).op s = 0
      rw [← hkg, op_comp, Functor.map_comp]
      change (ConcreteCategory.hom (J'.obj.map k.op)) ((ConcreteCategory.hom (J'.obj.map g.op)) s) = 0
      rw [h0, map_zero]
    · right
      intro x
      have h := hW (k.left x)
      have h1 : (k.left ≫ V'.hom) x = V'.hom (k.left x) := Scheme.Hom.comp_apply k.left V'.hom x
      have h2 : (V''.hom ≫ T.hom) x = T.hom (V''.hom x) := Scheme.Hom.comp_apply V''.hom T.hom x
      have e2 : k.left ≫ V'.hom = V''.hom ≫ T.hom := MorphismProperty.Over.w k
      show T.hom (V''.hom x) ∈ W
      have key : (k.left ≫ V'.hom) x = (V''.hom ≫ T.hom) x :=
        congrArg (fun φ => φ x) e2
      have key2 : T.hom (V''.hom x) = V'.hom (k.left x) := (h2.symm.trans key.symm).trans h1
      exact key2 ▸ h
  ·
    intro V hV
    have h1 : Function.Surjective (ι.hom.app (Opposite.op ((wcEtSlice T).obj V))).hom :=
      hsurj _ (fun x => hV x)
    let E := ((sheafToPresheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}).mapIso
      e).app (Opposite.op V)
    have h2 : Function.Surjective (e.hom.hom.app (Opposite.op V)).hom := by
      intro y
      exact ⟨E.inv y, E.inv_hom_id_apply y⟩
    change Function.Surjective ((e.hom.hom.app (Opposite.op V)).hom ∘
      (ι.hom.app (Opposite.op ((wcEtSlice T).obj V))).hom)
    exact h2.comp h1
  · exact ⟨Limits.PreservesCokernel.iso Rf ι ≪≫
      (Limits.cokernelCompIsIso (Rf.map ι) e.hom).symm⟩

theorem wc_et_free_sheaf_yoneda : ∀ (Y : Scheme.{u}), ∃ η : ∀ T : Y.Etale, ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.obj (Opposite.op T), (∀ (T : Y.Etale) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (s : G.obj.obj (Opposite.op T)), ∃! g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) ∧ ∀ (T T' : Y.Etale) (c : T' ⟶ T), (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).hom.app (Opposite.op T')).hom (η T') = (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map c.op).hom (η T) :=
by
  intro Y
  let J := Scheme.smallEtaleTopology Y
  let η : ∀ T : Y.Etale, ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
      (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.obj (Opposite.op T) :=
    fun T => ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
      (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
  let e : ∀ (T : Y.Etale) (G : Sheaf J AddCommGrpCat.{u+1}),
      ((presheafToSheaf J AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G) ≃
        G.obj.obj (Opposite.op T) := fun T G =>
    ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
      (((Adjunction.whiskerRight (Y.Etale)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
        (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
  have he : ∀ (T : Y.Etale) (G : Sheaf J AddCommGrpCat.{u+1})
      (g : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G),
      e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
  refine ⟨η, fun T G s => ⟨(e T G).symm s, ?_, fun g hg => (e T G).injective ?_⟩, fun T T' c => ?_⟩
  · exact (he T G _).symm.trans (Equiv.apply_symm_apply _ _)
  · exact (he T G g).trans (hg.trans (Equiv.apply_symm_apply _ _).symm)
  · let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
    let w : P' ⟶ P := Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
    let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
    have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
        (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
          ((w.app (Opposite.op T')).hom x') :=
      (ConcreteCategory.congr_hom
        (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
    have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
      change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
        FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
      refine (FreeAbelianGroup.map_of_apply _).trans
        (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
      congr 1
    have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
        ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
      NatTrans.naturality_apply (toSheafify J P) c.op x
    change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
        (Opposite.op T')).hom x') =
      ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
    rw [h1, h2, hn]

theorem wc_et_free_sheaf_affine_coprod : ∀ (Y : Scheme.{u}) (η : ∀ T : Y.Etale, ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.obj (Opposite.op T)), (∀ (T : Y.Etale) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (s : G.obj.obj (Opposite.op T)), ∃! g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) → (∀ (T T' : Y.Etale) (c : T' ⟶ T), (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))).hom.app (Opposite.op T')).hom (η T') = (((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).obj.map c.op).hom (η T)) → ∀ (ι : Type (u+1)) [Finite ι] (T : ι → Y.Etale), (∀ k, IsAffine (T k).left) → ∃ (S : Y.Etale) (σ : ∀ k, (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj (T k) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj S ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), IsAffine S.left ∧ Nonempty (Limits.IsColimit (Limits.Cofan.mk ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj S ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) σ)) :=
by
  classical
  intro Y η hη hnat ι _ T hT
  let g : ι → Scheme.{u} := fun k => (T k).left
  haveI hEt : Etale (Limits.Sigma.desc (fun k => (T k).hom) : ∐ g ⟶ Y) :=
    @IsZariskiLocalAtSource.sigmaDesc @Etale
      (HasRingHomProperty.instIsZariskiLocalAtSource (P := @Etale)) Y ι _
      (fun k => (T k).left) (fun k => (T k).hom) (fun k => (T k).prop)
  let S : Y.Etale := Scheme.Etale.mk (Limits.Sigma.desc (fun k => (T k).hom) : ∐ g ⟶ Y)
  let c : ∀ k, T k ⟶ S := fun k =>
    MorphismProperty.Over.homMk (Limits.Sigma.ι g k) (Limits.Sigma.ι_comp_desc _ k) trivial
  have hS : IsAffine S.left := by
    haveI := hT
    exact (inferInstance : IsAffine (∐ g))

  have hopen : ∀ k, IsOpenImmersion (c k).left := fun k =>
    show IsOpenImmersion (Limits.Sigma.ι g k) from inferInstance
  have hdisj : ∀ k k', k ≠ k' → Disjoint (Set.range (c k).left) (Set.range (c k').left) := by
    intro k k' hkk'
    have h := disjoint_opensRange_sigmaι g k k' hkk'
    rw [Set.disjoint_left]
    intro x hx hx'
    have hmem : x ∈ (Limits.Sigma.ι g k).opensRange ⊓ (Limits.Sigma.ι g k').opensRange :=
      ⟨hx, hx'⟩
    rw [disjoint_iff.mp h] at hmem
    exact hmem
  have hcov : ∀ x : S.left, ∃ k, x ∈ Set.range (c k).left := by
    intro x
    have hx := (sigmaOpenCover g).covers x
    exact ⟨_, hx⟩
  have wc_dc : ∀ (T0 : Y.Etale) (n : ℕ) (Ti : Fin n → Y.Etale) (t : ∀ i, Ti i ⟶ T0),
      (∀ i, IsOpenImmersion (t i).left) →
      (∀ i j, i ≠ j → Disjoint (Set.range (t i).left) (Set.range (t j).left)) →
      (∀ x : T0.left, ∃ i, x ∈ Set.range (t i).left) →
      ∀ (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      Function.Bijective (fun (s : F.obj.obj (Opposite.op T0)) (i : Fin n) =>
        (F.obj.map (t i).op).hom s) := by
    intro T0 n Ti t hopen hdisj hcov F
    have s1 : ∀ W : Y.Etale, IsEmpty W.left → Subsingleton (F.obj.obj (Opposite.op W)) := by
      intro W hW
      have hbot : (⊥ : Sieve W) ∈ Scheme.smallEtaleTopology Y W := by
        change (⊥ : Sieve W) ∈ Scheme.smallGrothendieckTopology @Etale Y W
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro x
        exact isEmptyElim x
      exact AddCommGrpCat.isZero_iff_subsingleton.mp (Sheaf.isTerminalOfBotCover F W hbot).isZero
    have s2 : Sieve.generate (Presieve.ofArrows Ti t) ∈ Scheme.smallEtaleTopology Y T0 := by
      change Sieve.generate (Presieve.ofArrows Ti t) ∈ Scheme.smallGrothendieckTopology @Etale Y T0
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨i, y, hy⟩ := hcov x
      haveI := hopen i
      have hmem : (Sieve.generate (Presieve.ofArrows Ti t)).arrows (t i) :=
        Sieve.le_generate (Presieve.ofArrows Ti t) (Ti i) (t i) (Presieve.ofArrows.mk i)
      exact ⟨Ti i, t i, y, hmem, inferInstance, hy⟩
    let P := F.obj ⋙ forget AddCommGrpCat
    have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology Y) P :=
      (isSheaf_iff_isSheaf_of_type _ _).1
        ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology Y) F.obj
          (forget AddCommGrpCat)).1 F.cond)
    have s3 := (Presieve.isSheafFor_arrows_iff P t).1 (hP.isSheafFor _ s2)
    have s4 : ∀ x : ∀ i, P.obj (Opposite.op (Ti i)), Presieve.Arrows.Compatible P t x := by
      intro x i j Z gi gj h
      have hl : gi.left ≫ (t i).left = gj.left ≫ (t j).left := by
        have h1 : (Scheme.Etale.forget Y ⋙ Over.forget Y).map gi ≫
            (Scheme.Etale.forget Y ⋙ Over.forget Y).map (t i) =
            (Scheme.Etale.forget Y ⋙ Over.forget Y).map gj ≫
            (Scheme.Etale.forget Y ⋙ Over.forget Y).map (t j) := by
          rw [← Functor.map_comp, ← Functor.map_comp, h]
        exact h1
      by_cases hij : i = j
      · subst hij
        haveI := hopen i
        have hg : gi = gj := by
          apply MorphismProperty.Over.Hom.ext
          exact (cancel_mono (t i).left).1 hl
        rw [hg]
      · haveI : IsEmpty Z.left := ⟨fun z => by
          have hz : (t i).left (gi.left z) = (t j).left (gj.left z) := by
            rw [← Scheme.Hom.comp_apply, hl, Scheme.Hom.comp_apply]
          exact Set.disjoint_left.1 (hdisj i j hij) ⟨_, rfl⟩ ⟨_, hz.symm⟩⟩
        exact @Subsingleton.elim _ (s1 Z inferInstance) _ _
    refine ⟨fun s s' hss => ?_, fun x => ?_⟩
    · obtain ⟨s0, _, huniq⟩ := s3 (fun i => (F.obj.map (t i).op).hom s) (s4 _)
      exact (huniq s (fun i => rfl)).trans (huniq s' (fun i => (congrFun hss i).symm)).symm
    · obtain ⟨s, hs, _⟩ := s3 x (s4 x)
      exact ⟨s, funext hs⟩
  have hbij : ∀ G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      Function.Bijective (fun (s : G.obj.obj (Opposite.op S)) (k : ι) =>
        (G.obj.map (c k).op).hom s) := by
    intro G
    obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
    have hb0 := wc_dc S n (fun i => T (e.symm i)) (fun i => c (e.symm i))
      (fun i => hopen (e.symm i))
      (fun i j hij => hdisj (e.symm i) (e.symm j) (e.symm.injective.ne hij))
      (fun x => by
        obtain ⟨k, hk⟩ := hcov x
        exact ⟨e k, by rw [e.symm_apply_apply]; exact hk⟩) G
    refine ⟨fun s₁ s₂ h => hb0.1 (funext fun i => congrFun h (e.symm i)), fun f => ?_⟩
    obtain ⟨s, hs⟩ := hb0.2 (fun i => f (e.symm i))
    refine ⟨s, funext fun k => ?_⟩
    have h : (G.obj.map (c (e.symm (e k))).op).hom s = f (e.symm (e k)) := congrFun hs (e k)
    have key : ∀ k' (_ : k' = k), (G.obj.map (c k').op).hom s = f k' →
        (G.obj.map (c k).op).hom s = f k := by
      rintro _ rfl h'
      exact h'
    exact key _ (e.symm_apply_apply k) h

  let P : Y.Etale → Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} := fun T =>
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
  let σ : ∀ k, P (T k) ⟶ P S := fun k =>
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map
      (Functor.whiskerRight (yoneda.map (c k)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
  have KC : ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (m : P S ⟶ G) (k : ι),
      ((σ k ≫ m).hom.app (Opposite.op (T k))).hom (η (T k)) =
        (G.obj.map (c k).op).hom ((m.hom.app (Opposite.op S)).hom (η S)) := by
    intro G m k
    change (m.hom.app (Opposite.op (T k))).hom
      (((σ k).hom.app (Opposite.op (T k))).hom (η (T k))) = _
    rw [hnat S (T k) (c k)]
    exact congrArg (fun φ => AddCommGrpCat.Hom.hom φ (η S)) (m.hom.naturality (c k).op)
  let τ : ∀ s : Limits.Cofan (fun k => P (T k)), s.pt.obj.obj (Opposite.op S) := fun s =>
    Classical.choose ((hbij s.pt).2
      (fun k => ((s.inj k).hom.app (Opposite.op (T k))).hom (η (T k))))
  have hτ : ∀ (s : Limits.Cofan (fun k => P (T k))) (k : ι),
      (s.pt.obj.map (c k).op).hom (τ s) = ((s.inj k).hom.app (Opposite.op (T k))).hom (η (T k)) :=
    fun s k => congrFun (Classical.choose_spec ((hbij s.pt).2
      (fun k => ((s.inj k).hom.app (Opposite.op (T k))).hom (η (T k))))) k
  let lift : ∀ s : Limits.Cofan (fun k => P (T k)), P S ⟶ s.pt := fun s =>
    Classical.choose (hη S s.pt (τ s)).exists
  have hlift : ∀ s : Limits.Cofan (fun k => P (T k)),
      ((lift s).hom.app (Opposite.op S)).hom (η S) = τ s := fun s =>
    Classical.choose_spec (hη S s.pt (τ s)).exists
  refine ⟨S, σ, hS, ⟨Limits.Cofan.IsColimit.mk _ lift (fun s k => ?_) (fun s m hm => ?_)⟩⟩
  · change σ k ≫ lift s = s.inj k
    exact (hη (T k) s.pt (((s.inj k).hom.app (Opposite.op (T k))).hom (η (T k)))).unique
      (by rw [KC, hlift, hτ]) rfl
  · have hm' : (fun k => (s.pt.obj.map (c k).op).hom ((m.hom.app (Opposite.op S)).hom (η S))) =
        (fun k => (s.pt.obj.map (c k).op).hom (τ s)) := by
      funext k
      rw [← KC s.pt m k, hτ]
      exact congrArg (fun φ => (φ.hom.app (Opposite.op (T k))).hom (η (T k))) (hm k)
    exact (hη S s.pt (τ s)).unique ((hbij s.pt).1 hm') (hlift s)

theorem wc_et_sieve_of_affine_arrows : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R S : Sieve V), R ∈ Scheme.smallEtaleTopology Y V → (∀ (V' : Y.Etale) (h : V' ⟶ V), IsAffine V'.left → R.arrows h → S.arrows h) → S ∈ Scheme.smallEtaleTopology Y V :=
by
  intro Y V R S hR hS
  change R ∈ Scheme.smallGrothendieckTopology @Etale Y V at hR
  rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
  change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
  rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
  apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V S).mpr
  intro v
  obtain ⟨Y₁, f, y, hf, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR v
  obtain ⟨a, ha⟩ := Y₁.left.affineCover.covers y
  haveI : Etale Y₁.hom := Y₁.prop
  let V' : Y.Etale := MorphismProperty.Over.mk ⊤
    (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y) ≫ Y₁.hom)
    (inferInstance : Etale (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y) ≫ Y₁.hom))
  let h : V' ⟶ Y₁ := MorphismProperty.Over.homMk
    (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y)) rfl trivial
  have hA : IsAffine V'.left := by
    show IsAffine (Y₁.left.affineCover.X (Y₁.left.affineCover.idx y))
    infer_instance
  obtain ⟨c, hc⟩ : ∃ c : V' ⟶ V, c = h ≫ f := ⟨_, rfl⟩
  have hRc : R.arrows c := hc ▸ R.downward_closed hf h
  have hSc : S.arrows c := hS V' c hA hRc
  have hEt : Etale c.left := by
    haveI : Etale V.hom := V.prop
    have hw : c.left ≫ V.hom = V'.hom := MorphismProperty.Over.w c
    haveI : Etale (c.left ≫ V.hom) := by
      rw [hw]
      exact V'.prop
    exact Etale.of_comp c.left V.hom
  refine ⟨V', c, a, hSc, hEt, ?_⟩
  subst hc
  change f.left (Y₁.left.affineCover.f (Y₁.left.affineCover.idx y) a) = v
  rw [ha, hy]

theorem wc_abelian_fp_approx_system : ∀ {C : Type*} [Category.{u+1} C] [Abelian C] (𝒯 : Type (u+1)) (P : 𝒯 → C) (K : C) (m : ℕ), m • 𝟙 K = 0 → (∀ (ι : Type (u+1)) [Finite ι] (T : ι → 𝒯), ∃ (S : 𝒯) (σ : ∀ k, P (T k) ⟶ P S), Nonempty (Limits.IsColimit (Limits.Cofan.mk (P S) σ))) → ∃ (Λ : Type (u+1)) (_ : SemilatticeSup Λ) (_ : Nonempty Λ) (U V : Λ → 𝒯) (g : ∀ i, P (V i) ⟶ P (U i)) (p : ∀ i j, i ≤ j → (P (U i) ⟶ P (U j))) (h : ∀ i, P (U i) ⟶ K), (∀ i (hii : i ≤ i), p i i hii = 𝟙 _) ∧ (∀ i j k (hij : i ≤ j) (hjk : j ≤ k) (hik : i ≤ k), p i j hij ≫ p j k hjk = p i k hik) ∧ (∀ i j (hij : i ≤ j), p i j hij ≫ h j = h i) ∧ (∀ i, g i ≫ h i = 0) ∧ (∀ i j (hij : i ≤ j), g i ≫ p i j hij ≫ Limits.cokernel.π (g j) = 0) ∧ (∀ i, m • 𝟙 (Limits.cokernel (g i)) = 0) ∧ (∀ (T : 𝒯) (s : P T ⟶ K), ∃ (i : Λ) (x : P T ⟶ P (U i)), x ≫ h i = s) ∧ (∀ (i : Λ) (T : 𝒯) (x : P T ⟶ P (U i)), x ≫ h i = 0 → ∃ (j : Λ) (hij : i ≤ j), x ≫ p i j hij ≫ Limits.cokernel.π (g j) = 0) :=
