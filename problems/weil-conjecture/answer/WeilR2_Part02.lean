theorem wc_et_closed_complement_coh : ∀ (Y Z : Scheme.{u}) (i : Z ⟶ Y) [IsClosedImmersion i]
    (m q : ℕ),
    Nonempty (wcEtExt Y (Limits.cokernel (wcEtExtZeroι Y (Set.range i)ᶜ m)) q ≃ wcEtCoh Z m q) :=
by
  intro Y Z i _ m q

  haveI hlim : Limits.PreservesFiniteLimits (wcEtBaseChange i) :=
    @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtBaseChange i)
      (Scheme.Etale.forget Z)
      (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y ⋙ Over.pullback i)))
      inferInstance
  have hcov : CoverPreserving (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)
      (wcEtBaseChange i) := by
    refine ⟨fun {V} {R} hR => ?_⟩
    have key : ∀ {ι : Type u} (X' : ι → Y.Etale) (f' : ∀ j, X' j ⟶ V),
        Presieve.ofArrows X' f' ≤ R.arrows → (∀ x : V.left, ∃ j y, (f' j).left y = x) →
        R.functorPushforward (wcEtBaseChange i) ∈
          Scheme.smallEtaleTopology Z ((wcEtBaseChange i).obj V) := by
      intro ι X' f' hle hsurj
      have hmem : Sieve.ofArrows (fun j => (wcEtBaseChange i).obj (X' j))
          (fun j => (wcEtBaseChange i).map (f' j)) ∈
          Scheme.smallEtaleTopology Z ((wcEtBaseChange i).obj V) := by
        rw [Scheme.ofArrows_mem_smallEtaleTopology_iff]
        apply Set.eq_univ_of_forall
        intro z
        obtain ⟨j, y, hy⟩ := hsurj (Limits.pullback.fst V.hom i z)
        refine Set.mem_iUnion.mpr ⟨j, ?_⟩
        have hr := @Scheme.Pullback.range_map _ _ _ (X' j).hom i _ _ _ V.hom i (f' j).left
          (𝟙 Z) (𝟙 Y)
          ((Category.comp_id _).trans (MorphismProperty.Over.w (f' j)).symm)
          ((Category.comp_id i).trans (Category.id_comp i).symm) (inferInstance : Mono (𝟙 Y))
        show z ∈ Set.range (Limits.pullback.map (X' j).hom i V.hom i (f' j).left (𝟙 Z) (𝟙 Y)
          ((Category.comp_id _).trans (MorphismProperty.Over.w (f' j)).symm)
          ((Category.comp_id i).trans (Category.id_comp i).symm))
        rw [hr]
        exact ⟨⟨y, hy⟩, ⟨Limits.pullback.snd V.hom i z, rfl⟩⟩
      refine GrothendieckTopology.superset_covering _ ?_ hmem
      rw [Sieve.ofArrows, Sieve.generate_le_iff]
      intro W f hf
      cases hf with
      | mk j => exact Sieve.image_mem_functorPushforward _ _ (hle _ _ (Presieve.ofArrows.mk j))
    obtain ⟨𝒰, h₁, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology V R).1 hR
    haveI : Scheme.JointlySurjective.{u} (Scheme.precoverage (@Etale : MorphismProperty Scheme.{u})) :=
      Scheme.instJointlySurjectivePrecoverage
    unfold Scheme.Cover.toPresieveOverProp at hle
    exact key _ _ hle (fun x => 𝒰.exists_eq x)
  haveI := flat_of_preservesFiniteLimits (wcEtBaseChange i)
  haveI hcont : (wcEtBaseChange i).IsContinuous (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Z) :=
    Functor.isContinuous_of_coverPreserving
      (compatiblePreservingOfFlat (Scheme.smallEtaleTopology Z) (wcEtBaseChange i)) hcov

  have H := wc_etBaseChange_locSurj i (wc_etale_lift_closed_immersion wc_etale_lift_quotient_alg)
  let F := (wcEtBaseChange i).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)
  let L := (wcEtBaseChange i).sheafPullback AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)
  let adj : L ⊣ F := (wcEtBaseChange i).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)

  haveI hFl : Limits.PreservesFiniteLimits F := by
    haveI := adj.rightAdjoint_preservesLimits.{0, 0}
    exact Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} F
  haveI : F.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint F
  haveI : F.Additive := Functor.additive_of_preserves_binary_products F
  haveI : F.PreservesEpimorphisms := ⟨fun {G₁ G₂} φ hφ => by
    have h1 : Sheaf.IsLocallySurjective φ :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).2 hφ
    have h2 : Sheaf.IsLocallySurjective (F.map φ) := H G₁.obj G₂ φ.hom h1
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} (F.map φ)).1 h2⟩
  haveI : F.PreservesHomology := Functor.preservesHomology_of_preservesEpis_and_kernels F
  haveI hFc : Limits.PreservesFiniteColimits F :=
    Functor.preservesFiniteColimits_of_preservesHomology F

  haveI hlan := wc_lan_preservesFiniteLimits (wcEtBaseChange i)
  haveI hLl : Limits.PreservesFiniteLimits L :=
    Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtBaseChange i) AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)
  haveI : L.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape L

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EssentiallySmall.{u+1} Z.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives
  let ZY := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let ZZ := (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let ΛZ := (constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))

  let Θ := Equiv.ofBijective _ (wc_ext_adjoint_transfer L F adj ZY ΛZ q)

  have hTY : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hTZ : Limits.IsTerminal ((wcEtBaseChange i).obj (Scheme.Etale.mk (𝟙 Y))) :=
    hTY.isTerminalObj (wcEtBaseChange i) _
  let adj1 := constantSheafAdj (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} hTY
  let ρ : F ⋙ (sheafSections (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (Opposite.op (Scheme.Etale.mk (𝟙 Y))) ≅
      (sheafSections (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (Opposite.op ((wcEtBaseChange i).obj (Scheme.Etale.mk (𝟙 Y)))) := Iso.refl _
  let adj3 := (adj1.comp adj).ofNatIsoRight ρ
  let adj4 := constantSheafAdj (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1} hTZ
  let e₁ : L.obj ZY ≅ ZZ := (adj3.leftAdjointUniq adj4).app (AddCommGrpCat.of (ULift.{u+1} ℤ))
  obtain ⟨e₂⟩ := wc_closed_coker_pushforward i m H
  have preZ : ∀ {A A' B : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}} (e : A ≅ A'),
      Nonempty (Abelian.Ext A B q ≃ Abelian.Ext A' B q) := by
    intro A A' B e
    refine ⟨{ toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add q)
              invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add q)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add q) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  have postY : ∀ {A B B' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (e : B ≅ B'),
      Nonempty (Abelian.Ext A B q ≃ Abelian.Ext A B' q) := by
    intro A B B' e
    refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero q)
              invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero q)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E1⟩ := postY (A := ZY) e₂
  obtain ⟨E2⟩ := preZ (B := ΛZ) e₁
  change Nonempty (Abelian.Ext ZY (Limits.cokernel (wcEtExtZeroι Y (Set.range i)ᶜ m)) q ≃
    Abelian.Ext ZZ ΛZ q)
  exact ⟨E1.trans (Θ.symm.trans E2)⟩

theorem wc_idempotent_lift_of_factor_lift : ∀ (A : Type u) [CommRing A] [IsLocalRing A], (∀ (f : Polynomial A) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField A)), f.Monic → g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue A) = g₀ * h₀ → ∃ g h : Polynomial A, g.Monic ∧ h.Monic ∧ f = g * h ∧ g.map (IsLocalRing.residue A) = g₀ ∧ h.map (IsLocalRing.residue A) = h₀) → ∀ (C : Type u) [CommRing C] [Algebra A C], Module.Finite A C → ∀ c : C, c * c - c ∈ ((IsLocalRing.maximalIdeal A).map (algebraMap A C)).radical → ∃ e : C, IsIdempotentElem e ∧ e - c ∈ ((IsLocalRing.maximalIdeal A).map (algebraMap A C)).radical :=
by
  intro A _ _ hlift C _ _ hC c hc
  classical

  have s4 : ∀ (P : Ideal C), (IsLocalRing.maximalIdeal A).map (algebraMap A C) ≤ P →
      ∃ φ : IsLocalRing.ResidueField A →+* C ⧸ P, ∀ (p : Polynomial A) (x : C),
        Ideal.Quotient.mk P (Polynomial.aeval x p) =
          (p.map (IsLocalRing.residue A)).eval₂ φ (Ideal.Quotient.mk P x) := by
    intro P hIP
    have H : ∀ a ∈ IsLocalRing.maximalIdeal A,
        (Ideal.Quotient.mk P).comp (algebraMap A C) a = 0 := by
      intro a ha
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      exact hIP (Ideal.mem_map_of_mem _ ha)
    let φ : IsLocalRing.ResidueField A →+* C ⧸ P := Ideal.Quotient.lift
      (IsLocalRing.maximalIdeal A) ((Ideal.Quotient.mk P).comp (algebraMap A C)) H
    have hcomp : φ.comp (IsLocalRing.residue A) = (Ideal.Quotient.mk P).comp (algebraMap A C) := by
      ext a
      rfl
    refine ⟨φ, fun p x => ?_⟩
    rw [Polynomial.eval₂_map, hcomp, Polynomial.aeval_def, Polynomial.hom_eval₂]

  haveI := hC
  haveI hint : Algebra.IsIntegral A C := Algebra.IsIntegral.of_finite A C

  have s2 : ∀ δ ∈ (IsLocalRing.maximalIdeal A).map (algebraMap A C), IsUnit (1 + δ) := by
    intro δ hδ
    by_contra hnu
    obtain ⟨M, hM, hmem⟩ := exists_max_ideal_of_mem_nonunits hnu
    haveI := hM
    have hcomap : (M.comap (algebraMap A C)).IsMaximal := inferInstance
    have heq := IsLocalRing.eq_maximalIdeal hcomap
    have hIM : (IsLocalRing.maximalIdeal A).map (algebraMap A C) ≤ M :=
      Ideal.map_le_iff_le_comap.mpr heq.symm.le
    have h1 : (1 : C) ∈ M := by
      have := M.sub_mem hmem (hIM hδ)
      simpa using this
    exact hM.ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  obtain ⟨F, hF, hFc⟩ := hint.isIntegral c
  have hFc' : Polynomial.aeval c F = 0 := by rw [Polynomial.aeval_def]; exact hFc

  obtain ⟨a, r, hr, hsplit, hr0, hcop⟩ : ∃ (a : ℕ) (r : Polynomial (IsLocalRing.ResidueField A)),
      r.Monic ∧ F.map (IsLocalRing.residue A) = Polynomial.X ^ a * r ∧ r.coeff 0 ≠ 0 ∧
      IsCoprime ((Polynomial.X : Polynomial (IsLocalRing.ResidueField A)) ^ a) r := by
    have hq := hF.map (IsLocalRing.residue A)
    obtain ⟨r, hr, hnd⟩ :=
      Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd _ hq.ne_zero 0
    rw [map_zero, sub_zero] at hr hnd
    refine ⟨_, r, (Polynomial.monic_X_pow _).of_mul_monic_left (by rw [← hr]; exact hq), hr,
      ?_, ?_⟩
    · intro h0
      exact hnd (Polynomial.X_dvd_iff.mpr h0)
    · exact IsCoprime.pow_left
        ((Irreducible.coprime_iff_not_dvd Polynomial.irreducible_X).mpr hnd)

  obtain ⟨g, h, -, -, hFgh, hg, hh⟩ :=
    hlift F (Polynomial.X ^ a) r hF (Polynomial.monic_X_pow a) hr hcop hsplit
  obtain ⟨u₀, v₀, huv⟩ := hcop
  obtain ⟨u, rfl⟩ :=
    Polynomial.map_surjective (IsLocalRing.residue A) IsLocalRing.residue_surjective u₀
  obtain ⟨v, rfl⟩ :=
    Polynomial.map_surjective (IsLocalRing.residue A) IsLocalRing.residue_surjective v₀
  obtain ⟨φI, hφI⟩ := s4 _ le_rfl
  have hδ : Polynomial.aeval c u * Polynomial.aeval c g + Polynomial.aeval c v *
      Polynomial.aeval c h - 1 ∈ (IsLocalRing.maximalIdeal A).map (algebraMap A C) := by
    have h1 := hφI (u * g + v * h - 1) c
    rw [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul,
      Polynomial.map_one, hg, hh, huv, sub_self, Polynomial.eval₂_zero, map_sub, map_add,
      map_mul, map_mul, map_one] at h1
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1
  have hs : IsUnit (Polynomial.aeval c u * Polynomial.aeval c g + Polynomial.aeval c v *
      Polynomial.aeval c h) := by
    simpa using s2 _ hδ
  obtain ⟨t, ht⟩ : ∃ t, (Polynomial.aeval c u * Polynomial.aeval c g + Polynomial.aeval c v *
      Polynomial.aeval c h) * t = 1 := ⟨_, hs.mul_val_inv⟩
  have hGH : Polynomial.aeval c g * Polynomial.aeval c h = 0 := by
    rw [← map_mul, ← hFgh, hFc']
  refine ⟨Polynomial.aeval c u * t * Polynomial.aeval c g, ?_, ?_⟩
  · unfold IsIdempotentElem
    linear_combination (Polynomial.aeval c u * t * Polynomial.aeval c g) * ht -
      Polynomial.aeval c u * t * t * Polynomial.aeval c v * hGH
  · rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
    rintro P ⟨hIP, hP⟩
    obtain ⟨φ, hφ⟩ := s4 P hIP
    have hcP : c * c - c ∈ P := (Ideal.IsPrime.radical_le_iff hP).mpr hIP hc
    haveI := hP
    have hy : Ideal.Quotient.mk P c * Ideal.Quotient.mk P c = Ideal.Quotient.mk P c := by
      rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      exact hcP
    have hy01 := (IsIdempotentElem.iff_eq_zero_or_one).mp hy
    have hev : (Polynomial.X ^ a).eval₂ φ (Ideal.Quotient.mk P c) *
        r.eval₂ φ (Ideal.Quotient.mk P c) = 0 := by
      rw [← Polynomial.eval₂_mul, ← hsplit, ← hφ F c, hFc', map_zero]
    have hGP : Ideal.Quotient.mk P (Polynomial.aeval c g) =
        (Polynomial.X ^ a).eval₂ φ (Ideal.Quotient.mk P c) := by
      rw [hφ, hg]
    have hHP : Ideal.Quotient.mk P (Polynomial.aeval c h) =
        r.eval₂ φ (Ideal.Quotient.mk P c) := by
      rw [hφ, hh]
    rcases hy01 with h0 | h1
    · have hr' : r.eval₂ φ (Ideal.Quotient.mk P c) ≠ 0 := by
        rw [h0, Polynomial.eval₂_at_zero]
        exact (map_ne_zero φ).mpr hr0
      have hX : (Polynomial.X ^ a).eval₂ φ (Ideal.Quotient.mk P c) = 0 :=
        (mul_eq_zero.mp hev).resolve_right hr'
      have hGmem : Polynomial.aeval c g ∈ P := Ideal.Quotient.eq_zero_iff_mem.mp (hGP.trans hX)
      have hcmem : c ∈ P := Ideal.Quotient.eq_zero_iff_mem.mp h0
      exact P.sub_mem (P.mul_mem_left _ hGmem) hcmem
    · have hX : (Polynomial.X ^ a).eval₂ φ (Ideal.Quotient.mk P c) = 1 := by
        rw [h1, Polynomial.eval₂_X_pow, one_pow]
      rw [hX, one_mul] at hev
      have hHmem : Polynomial.aeval c h ∈ P := Ideal.Quotient.eq_zero_iff_mem.mp (hHP.trans hev)
      have h1c : 1 - c ∈ P := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, h1, sub_self]
      have key : Polynomial.aeval c u * t * Polynomial.aeval c g - c =
          (1 - c) - (Polynomial.aeval c v * t) * Polynomial.aeval c h := by
        linear_combination ht
      rw [key]
      exact P.sub_mem h1c (P.mul_mem_left _ hHmem)

theorem wc_finite_local_henselian : ∀ (A : Type u) [CommRing A] [IsLocalRing A], (∀ (C : Type u) [CommRing C] [Algebra A C], Module.Finite A C → ∀ c : C, c * c - c ∈ ((IsLocalRing.maximalIdeal A).map (algebraMap A C)).radical → ∃ e : C, IsIdempotentElem e ∧ e - c ∈ ((IsLocalRing.maximalIdeal A).map (algebraMap A C)).radical) → ∀ (B : Type u) [CommRing B] [IsLocalRing B] [Algebra A B], Module.Finite A B → IsLocalHom (algebraMap A B) → HenselianLocalRing B :=
by
  intro A _ _ L B _ _ _ hB hloc
  classical

  have s1 : IsLocalRing.maximalIdeal B ≤
      ((IsLocalRing.maximalIdeal A).map (algebraMap A B)).radical := by
    haveI : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
    rw [Ideal.radical_eq_sInf]
    refine le_sInf ?_
    rintro P ⟨hle, hP⟩
    have hle' : IsLocalRing.maximalIdeal A ≤ Ideal.comap (algebraMap A B) P :=
      Ideal.map_le_iff_le_comap.mp hle
    have hne : Ideal.comap (algebraMap A B) P ≠ ⊤ := (Ideal.IsPrime.comap (algebraMap A B)).ne_top
    have heq : IsLocalRing.maximalIdeal A = Ideal.comap (algebraMap A B) P :=
      (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le hne hle'
    have hcm : (Ideal.comap (algebraMap A B) P).IsMaximal := by
      rw [← heq]; exact IsLocalRing.maximalIdeal.isMaximal A
    have hint : (algebraMap A B).IsIntegral := fun b => Algebra.IsIntegral.isIntegral (R := A) b
    have hPm : P.IsMaximal := Ideal.isMaximal_of_isIntegral_of_isMaximal_comap _ hint P hcm
    rw [IsLocalRing.eq_maximalIdeal hPm]

  have hAB : (IsLocalRing.maximalIdeal A).map (algebraMap A B) ≤ IsLocalRing.maximalIdeal B := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap]
    intro hu
    exact (IsLocalRing.notMem_maximalIdeal.mpr
      (IsUnit.of_map (algebraMap A B) a hu)) ha
  apply HenselianLocalRing.mk
  intro f hf a₀ hfa₀ hu
  have hι : algebraMap B (AdjoinRoot f) = AdjoinRoot.of f := AdjoinRoot.algebraMap_eq f
  set N : Ideal (AdjoinRoot f) := (IsLocalRing.maximalIdeal B).map (AdjoinRoot.of f) with hNdef

  have fac : ∀ (p : Polynomial B) (s : B), ∃ r : AdjoinRoot f,
      AdjoinRoot.mk f p - AdjoinRoot.of f (p.eval s) = (AdjoinRoot.root f - AdjoinRoot.of f s) * r := by
    intro p s
    obtain ⟨q, hq⟩ := (Polynomial.X_sub_C_dvd_sub_C_eval (a := s) (p := p))
    refine ⟨AdjoinRoot.mk f q, ?_⟩
    have := congrArg (AdjoinRoot.mk f) hq
    rw [map_sub, map_mul, map_sub, AdjoinRoot.mk_C, AdjoinRoot.mk_X, AdjoinRoot.mk_C] at this
    exact this
  have memN : ∀ b ∈ IsLocalRing.maximalIdeal B, AdjoinRoot.of f b ∈ N :=
    fun b hb => Ideal.mem_map_of_mem _ hb
  have hmk : AdjoinRoot.mk f f = 0 := AdjoinRoot.mk_self

  let pb := AdjoinRoot.powerBasis' hf
  haveI hBC : Module.Finite B (AdjoinRoot f) := pb.finite
  haveI hAC : Module.Finite A (AdjoinRoot f) := Module.Finite.trans B (AdjoinRoot f)

  have hJeq : (IsLocalRing.maximalIdeal A).map (algebraMap A (AdjoinRoot f)) =
      ((IsLocalRing.maximalIdeal A).map (algebraMap A B)).map (AdjoinRoot.of f) := by
    rw [IsScalarTower.algebraMap_eq A B (AdjoinRoot f), ← Ideal.map_map, hι]
  have hNJ : N ≤ ((IsLocalRing.maximalIdeal A).map (algebraMap A (AdjoinRoot f))).radical := by
    rw [hJeq]
    exact (Ideal.map_mono s1).trans (Ideal.map_radical_le _)
  have hJNr : ((IsLocalRing.maximalIdeal A).map (algebraMap A (AdjoinRoot f))).radical ≤ N.radical := by
    apply Ideal.radical_mono
    rw [hJeq]
    exact Ideal.map_mono hAB

  obtain ⟨q, hq⟩ := (Polynomial.X_sub_C_dvd_sub_C_eval (a := a₀) (p := f))
  have hder : Polynomial.eval a₀ (Polynomial.derivative f) = Polynomial.eval a₀ q := by
    have := congrArg (fun p => Polynomial.eval a₀ (Polynomial.derivative p)) hq
    simpa using this
  obtain ⟨w, hw⟩ : ∃ w : B, w * Polynomial.eval a₀ q = 1 :=
    ⟨↑hu.unit⁻¹, by rw [← hder]; exact hu.val_inv_mul⟩
  have E1 : (AdjoinRoot.root f - AdjoinRoot.of f a₀) * AdjoinRoot.mk f q =
      - AdjoinRoot.of f (f.eval a₀) := by
    have := congrArg (AdjoinRoot.mk f) hq
    rw [map_sub, map_mul, map_sub, AdjoinRoot.mk_C, AdjoinRoot.mk_X, AdjoinRoot.mk_C, hmk] at this
    linear_combination -this
  obtain ⟨r, E2⟩ := fac q a₀
  have E3 : AdjoinRoot.of f w * AdjoinRoot.of f (Polynomial.eval a₀ q) = 1 := by
    rw [← map_mul, hw, map_one]
  set c : AdjoinRoot f := AdjoinRoot.of f w * AdjoinRoot.mk f q with hcdef
  have hfN : AdjoinRoot.of f (f.eval a₀) ∈ N := memN _ hfa₀
  have hcc : c * c - c ∈ N := by
    have : c * c - c = (AdjoinRoot.of f w * AdjoinRoot.of f w * r) *
        (- AdjoinRoot.of f (f.eval a₀)) := by
      rw [hcdef]
      linear_combination (AdjoinRoot.of f w * AdjoinRoot.mk f q * AdjoinRoot.of f w) * E2 +
        (AdjoinRoot.of f w * AdjoinRoot.mk f q) * E3 + (AdjoinRoot.of f w * AdjoinRoot.of f w * r) * E1
    rw [this]
    exact Ideal.mul_mem_left _ _ (neg_mem hfN)
  have hxc : (AdjoinRoot.root f - AdjoinRoot.of f a₀) * c ∈ N := by
    have : (AdjoinRoot.root f - AdjoinRoot.of f a₀) * c =
        AdjoinRoot.of f w * (- AdjoinRoot.of f (f.eval a₀)) := by
      rw [hcdef]
      linear_combination (AdjoinRoot.of f w) * E1
    rw [this]
    exact Ideal.mul_mem_left _ _ (neg_mem hfN)
  have hcN : c ∉ N := by
    have hψ : Polynomial.eval₂ (IsLocalRing.residue B) (IsLocalRing.residue B a₀) f = 0 := by
      rw [Polynomial.eval₂_at_apply]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr hfa₀
    let ψ := AdjoinRoot.lift (IsLocalRing.residue B) (IsLocalRing.residue B a₀) hψ
    have hker : N ≤ RingHom.ker ψ := by
      rw [hNdef, Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, RingHom.mem_ker, AdjoinRoot.lift_of]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr hb
    intro hc
    have h0 : ψ c = 0 := RingHom.mem_ker.mp (hker hc)
    rw [hcdef, map_mul, AdjoinRoot.lift_of, AdjoinRoot.lift_mk, Polynomial.eval₂_at_apply,
      ← map_mul, hw, map_one] at h0
    exact one_ne_zero h0

  obtain ⟨e, he, hec⟩ := L (AdjoinRoot f) hAC c (hNJ hcc)
  have he' : e * e = e := he.eq
  have hecN : e - c ∈ N := by
    obtain ⟨n, hn⟩ := hJNr hec
    have h3 : (e - c) ^ 3 - (e - c) ∈ N := by
      have : (e - c) ^ 3 - (e - c) = (3 * e - c - 1) * (c * c - c) := by
        linear_combination (e - 3 * c + 1) * he'
      rw [this]; exact Ideal.mul_mem_left _ _ hcc
    have hodd : ∀ k : ℕ, (e - c) ^ (2 * k + 1) - (e - c) ∈ N := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        have : (e - c) ^ (2 * (k + 1) + 1) - (e - c) =
            (e - c) ^ (2 * k) * ((e - c) ^ 3 - (e - c)) + ((e - c) ^ (2 * k + 1) - (e - c)) := by
          ring
        rw [this]
        exact add_mem (Ideal.mul_mem_left _ _ h3) ih
    have hpow : (e - c) ^ (2 * n + 1) ∈ N := by
      have : (e - c) ^ (2 * n + 1) = (e - c) ^ n * (e - c) ^ (n + 1) := by ring
      rw [this]; exact Ideal.mul_mem_right _ _ hn
    have := sub_mem hpow (hodd n)
    simpa using this
  have heN : e ∉ N := by
    intro h
    apply hcN
    have := sub_mem h hecN
    simpa using this
  have hxe : (AdjoinRoot.root f - AdjoinRoot.of f a₀) * e ∈ N := by
    have : (AdjoinRoot.root f - AdjoinRoot.of f a₀) * e =
        (AdjoinRoot.root f - AdjoinRoot.of f a₀) * c +
          (AdjoinRoot.root f - AdjoinRoot.of f a₀) * (e - c) := by ring
    rw [this]
    exact add_mem hxc (Ideal.mul_mem_left _ _ hecN)

  have Hres : ∀ z : AdjoinRoot f, ∃ b : B, z * e - AdjoinRoot.of f b * e ∈ N := by
    intro z
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective z
    obtain ⟨r', hr'⟩ := fac p a₀
    refine ⟨p.eval a₀, ?_⟩
    have : AdjoinRoot.mk f p * e - AdjoinRoot.of f (p.eval a₀) * e =
        r' * ((AdjoinRoot.root f - AdjoinRoot.of f a₀) * e) := by
      linear_combination e * hr'
    rw [this]
    exact Ideal.mul_mem_left _ _ hxe

  let μ : AdjoinRoot f →ₗ[B] AdjoinRoot f := LinearMap.mulRight B e
  have hFG : (Submodule.map μ ⊤).FG := Module.Finite.fg_top.map μ
  have hincl : Submodule.map μ ⊤ ≤ Submodule.span B {e} ⊔
      (IsLocalRing.maximalIdeal B) • Submodule.map μ ⊤ := by
    rintro m ⟨y, -, rfl⟩
    obtain ⟨b, hb⟩ := Hres y
    have ht : y * e - AdjoinRoot.of f b * e ∈
        (IsLocalRing.maximalIdeal B) • (⊤ : Submodule B (AdjoinRoot f)) := by
      rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, hι]; exact hb
    have ht2 : μ (y * e - AdjoinRoot.of f b * e) ∈
        (IsLocalRing.maximalIdeal B) • Submodule.map μ ⊤ := by
      rw [← Submodule.map_smul'']; exact Submodule.mem_map_of_mem ht
    have hμ : μ (y * e - AdjoinRoot.of f b * e) = y * e - AdjoinRoot.of f b * e := by
      show (y * e - AdjoinRoot.of f b * e) * e = y * e - AdjoinRoot.of f b * e
      linear_combination (y - AdjoinRoot.of f b) * he'
    have hP : AdjoinRoot.of f b * e ∈ Submodule.span B {e} := by
      rw [← hι, ← Algebra.smul_def]
      exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self e)
    have hsplit : μ y = AdjoinRoot.of f b * e + (y * e - AdjoinRoot.of f b * e) := by
      show y * e = _
      ring
    rw [hsplit]
    exact Submodule.add_mem_sup hP (hμ ▸ ht2)
  have hle := Submodule.le_of_le_smul_of_le_jacobson_bot hFG
    (IsLocalRing.maximalIdeal_le_jacobson ⊥) hincl
  have hx : μ (AdjoinRoot.root f) ∈ Submodule.span B {e} :=
    hle (Submodule.mem_map_of_mem Submodule.mem_top)
  obtain ⟨a, ha0⟩ := Submodule.mem_span_singleton.mp hx
  have ha : AdjoinRoot.of f a * e = AdjoinRoot.root f * e := by
    rw [← hι, ← Algebra.smul_def]; exact ha0

  have hunit : ∃ j, IsUnit (pb.basis.repr e j) := by
    by_contra hcon
    push_neg at hcon
    apply heN
    rw [← pb.basis.sum_repr e]
    refine Ideal.sum_mem _ (fun i _ => ?_)
    rw [Algebra.smul_def, hι]
    refine Ideal.mul_mem_right _ _ (memN _ ?_)
    by_contra hb
    exact hcon i (IsLocalRing.notMem_maximalIdeal.mp hb)
  obtain ⟨j, hj⟩ := hunit
  have faith : ∀ b : B, AdjoinRoot.of f b * e = 0 → b = 0 := by
    intro b hb
    have h1 : b • e = 0 := by rw [Algebra.smul_def, hι]; exact hb
    have h2 := congrArg (fun v => pb.basis.repr v j) h1
    simp only [map_smul, Finsupp.smul_apply, smul_eq_mul, map_zero, Finsupp.coe_zero,
      Pi.zero_apply] at h2
    exact hj.mul_left_eq_zero.mp h2

  refine ⟨a, ?_, ?_⟩
  · obtain ⟨r'', hr''⟩ := fac f a
    apply faith
    linear_combination (-e) * hr'' + e * hmk + r'' * ha
  · by_contra hcon
    have hv : IsUnit (a - a₀) := IsLocalRing.notMem_maximalIdeal.mp hcon
    have h1 : AdjoinRoot.of f (a - a₀) * e ∈ N := by
      have : AdjoinRoot.of f (a - a₀) * e = (AdjoinRoot.root f - AdjoinRoot.of f a₀) * e := by
        rw [map_sub]; linear_combination ha
      rw [this]; exact hxe
    apply heN
    have : e = AdjoinRoot.of f (↑hv.unit⁻¹) * (AdjoinRoot.of f (a - a₀) * e) := by
      rw [← mul_assoc, ← map_mul, hv.val_inv_mul, map_one, one_mul]
    rw [this]
    exact Ideal.mul_mem_left _ _ h1

theorem wc_finite_alg_local_idempotents : ∀ (A : Type u) [CommRing A] [IsLocalRing A], (∀ (C : Type u) [CommRing C] [Algebra A C], Module.Finite A C → ∀ c : C, c * c - c ∈ ((IsLocalRing.maximalIdeal A).map (algebraMap A C)).radical → ∃ e : C, IsIdempotentElem e ∧ e - c ∈ ((IsLocalRing.maximalIdeal A).map (algebraMap A C)).radical) → ∀ (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∃ (n : ℕ) (e : Fin n → B), (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, IsLocalRing (Localization.Away (e i)) :=
by
  intro A _ _ L B _ _ hB
  classical
  set I : Ideal B := (IsLocalRing.maximalIdeal A).map (algebraMap A B) with hI
  have hint : (algebraMap A B).IsIntegral :=
    algebraMap_isIntegral_iff.mpr (Algebra.IsIntegral.of_finite A B)

  have hIM : ∀ M : Ideal B, M.IsMaximal → I ≤ M := by
    intro M hM
    have h1 : (M.comap (algebraMap A B)).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A B) hint M
    rw [hI, Ideal.map_le_iff_le_comap, IsLocalRing.eq_maximalIdeal h1]

  have s1 : ∀ x : B, x ∈ I.radical ↔ ∀ M : Ideal B, M.IsMaximal → x ∈ M := by
    intro x
    constructor
    · intro hx M hM
      obtain ⟨k, hk⟩ := hx
      exact hM.isPrime.mem_of_pow_mem k (hIM M hM hk)
    · intro hx
      rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
      rintro P ⟨hIP, hP⟩
      haveI := hP
      apply hx
      have h1 : IsLocalRing.maximalIdeal A ≤ P.comap (algebraMap A B) :=
        Ideal.map_le_iff_le_comap.mp hIP
      have h2 : P.comap (algebraMap A B) ≠ ⊤ := Ideal.comap_ne_top _ hP.ne_top
      have h3 : (P.comap (algebraMap A B)).IsMaximal := by
        rw [← (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le h2 h1]
        exact IsLocalRing.maximalIdeal.isMaximal A
      exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap A B) hint P h3

  have s2 : {M : Ideal B | M.IsMaximal}.Finite := by
    let π : B →+* B ⧸ I := Ideal.Quotient.mk I
    have hπ : Function.Surjective π := Ideal.Quotient.mk_surjective
    letI : Field (A ⧸ IsLocalRing.maximalIdeal A) := Ideal.Quotient.field _
    letI : Algebra (A ⧸ IsLocalRing.maximalIdeal A) (B ⧸ I) :=
      Ideal.Quotient.algebraQuotientMapQuotient
    haveI : Module.Finite (A ⧸ IsLocalRing.maximalIdeal A) (B ⧸ I) :=
      Module.Finite.of_restrictScalars_finite A (A ⧸ IsLocalRing.maximalIdeal A) (B ⧸ I)
    haveI : IsArtinianRing (B ⧸ I) :=
      IsArtinianRing.of_finite (A ⧸ IsLocalRing.maximalIdeal A) (B ⧸ I)
    haveI : Finite (MaximalSpectrum (B ⧸ I)) := inferInstance
    apply (Set.finite_range (fun P : MaximalSpectrum (B ⧸ I) => P.asIdeal.comap π)).subset
    intro M hM
    have hM' : M.IsMaximal := hM
    have hker : RingHom.ker π ≤ M := by
      rw [Ideal.mk_ker]; exact hIM M hM'
    have hcm : (M.map π).comap π = M :=
      (Ideal.comap_map_of_surjective' π hπ M).trans (sup_eq_left.mpr hker)
    have hmax : (M.map π).IsMaximal := by
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective π hπ hM' with h | h
      · exfalso; apply hM'.ne_top; rw [← hcm, h, Ideal.comap_top]
      · exact h
    exact ⟨⟨M.map π, hmax⟩, hcm⟩

  have s3 : ∀ z : B, IsIdempotentElem z → (∀ M : Ideal B, M.IsMaximal → z ∈ M) → z = 0 := by
    intro z hz hzM
    have hu : IsUnit (1 - z) := by
      by_contra h
      obtain ⟨M, hM, hzM'⟩ := exists_max_ideal_of_mem_nonunits h
      apply hM.ne_top
      apply Ideal.eq_top_of_isUnit_mem M _ isUnit_one
      have := M.add_mem hzM' (hzM M hM)
      rwa [sub_add_cancel] at this
    have h1 : (1 - z) * z = (1 - z) * 0 := by
      rw [mul_zero, sub_mul, one_mul, hz.eq, sub_self]
    exact hu.mul_left_cancel h1

  have s4 : ∀ e : B, IsIdempotentElem e → (∃! M : Ideal B, M.IsMaximal ∧ e ∉ M) →
      IsLocalRing (Localization.Away e) := by
    intro e he hex
    obtain ⟨M₀, ⟨hM₀, heM₀⟩, huniq⟩ := hex
    let φ : B →+* Localization.Away e := algebraMap B (Localization.Away e)
    have hφ : Function.Surjective φ :=
      IsLocalization.Away.algebraMap_surjective_of_isIdempotentElem e he
    have hu : IsUnit (φ e) := IsLocalization.Away.algebraMap_isUnit e
    have hker : RingHom.ker φ ≤ M₀ := by
      intro x hx
      have hx0 : φ x = φ 0 := by rw [map_zero]; exact hx
      obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers e) hx0
      obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp c.2
      rw [mul_zero] at hc
      have hek : e ^ k * x = 0 := by rw [hk]; exact hc
      have hex' : e * x = 0 := by
        cases k with
        | zero => rw [pow_zero, one_mul] at hek; rw [hek, mul_zero]
        | succ k => rw [he.pow_succ_eq k] at hek; exact hek
      have : e * x ∈ M₀ := by rw [hex']; exact M₀.zero_mem
      exact (hM₀.isPrime.mem_or_mem this).resolve_left heM₀
    have hcm : (M₀.map φ).comap φ = M₀ :=
      (Ideal.comap_map_of_surjective' φ hφ M₀).trans (sup_eq_left.mpr hker)
    have hmax : (M₀.map φ).IsMaximal := by
      rcases Ideal.map_eq_top_or_isMaximal_of_surjective φ hφ hM₀ with h | h
      · exfalso; apply hM₀.ne_top; rw [← hcm, h, Ideal.comap_top]
      · exact h
    refine IsLocalRing.of_unique_max_ideal ⟨M₀.map φ, hmax, fun N hN => ?_⟩
    haveI := hN
    have h1 : (N.comap φ).IsMaximal := Ideal.comap_isMaximal_of_surjective φ hφ
    have h2 : e ∉ N.comap φ := fun h => hN.ne_top (Ideal.eq_top_of_isUnit_mem N h hu)
    have h3 : N.comap φ = M₀ := huniq _ ⟨h1, h2⟩
    apply Ideal.comap_injective_of_surjective φ hφ
    rw [h3, hcm]

  obtain ⟨n, M, hMinj, hMrange⟩ := s2.fin_param
  have E1 : ∀ j, (M j).IsMaximal := fun j => by
    have : M j ∈ Set.range M := ⟨j, rfl⟩
    rw [hMrange] at this; exact this
  have E2 : ∀ N : Ideal B, N.IsMaximal → ∃ j, M j = N := fun N hN => by
    have : N ∈ Set.range M := by rw [hMrange]; exact hN
    exact this
  have hcop : Pairwise (fun i j => IsCoprime (M i) (M j)) := by
    intro i j hij
    exact Ideal.isCoprime_iff_sup_eq.mpr ((E1 i).coprime_of_ne (E1 j) (fun h => hij (hMinj h)))
  have hcrt : ∀ i, ∃ c : B, ∀ j, c - (if j = i then 1 else 0) ∈ M j := by
    intro i
    exact Ideal.exists_forall_sub_mem_ideal hcop (fun j => if j = i then 1 else 0)
  choose c hc using hcrt
  have hcc : ∀ i, c i * c i - c i ∈ I.radical := by
    intro i
    rw [s1]
    intro N hN
    obtain ⟨j, rfl⟩ := E2 N hN
    have := hc i j
    by_cases hji : j = i
    · rw [if_pos hji] at this
      have h := (M j).mul_mem_left (c i) this
      rwa [mul_sub, mul_one] at h
    · rw [if_neg hji, sub_zero] at this
      have h := (M j).mul_mem_left (c i - 1) this
      rwa [sub_mul, one_mul] at h

  have hL : ∀ i, ∃ e : B, IsIdempotentElem e ∧ e - c i ∈ I.radical :=
    fun i => L B hB (c i) (hcc i)
  choose e he hec using hL
  have D : ∀ i j, e i - (if j = i then 1 else 0) ∈ M j := by
    intro i j
    have h1 := (s1 _).mp (hec i) (M j) (E1 j)
    have h2 := hc i j
    have := (M j).add_mem h1 h2
    rwa [sub_add_sub_cancel] at this
  have D1 : ∀ i, e i - 1 ∈ M i := fun i => by simpa using D i i
  have D0 : ∀ i j, j ≠ i → e i ∈ M j := fun i j h => by simpa [h] using D i j
  have horth : ∀ i j, i ≠ j → e i * e j = 0 := by
    intro i j hij
    apply s3 _ ((he i).mul (he j))
    intro N hN
    obtain ⟨k, rfl⟩ := E2 N hN
    by_cases hki : k = i
    · have hkj : k ≠ j := by rw [hki]; exact hij
      exact (M k).mul_mem_left _ (D0 j k hkj)
    · exact (M k).mul_mem_right _ (D0 i k hki)
  have hsum : ∑ i, e i = 1 := by
    have hOI : OrthogonalIdempotents e := ⟨he, fun i j hij => horth i j hij⟩
    have hs : IsIdempotentElem (∑ i, e i) := hOI.isIdempotentElem_sum
    have h1 := s3 _ hs.one_sub (by
      intro N hN
      obtain ⟨k, rfl⟩ := E2 N hN
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ k)]
      have htail : ∑ i ∈ Finset.univ.erase k, e i ∈ M k :=
        Ideal.sum_mem _ (fun i hi => D0 i k (Finset.ne_of_mem_erase hi).symm)
      have : 1 - (e k + ∑ i ∈ Finset.univ.erase k, e i) =
          -(e k - 1) - ∑ i ∈ Finset.univ.erase k, e i := by ring
      rw [this]
      exact (M k).sub_mem ((M k).neg_mem (D1 k)) htail)
    exact (sub_eq_zero.mp h1).symm
  have hloc : ∀ i, IsLocalRing (Localization.Away (e i)) := by
    intro i
    apply s4 _ (he i)
    refine ⟨M i, ⟨E1 i, fun h => (E1 i).ne_top ?_⟩, ?_⟩
    · apply (Ideal.eq_top_iff_one _).mpr
      have := (M i).sub_mem h (D1 i)
      rwa [sub_sub_cancel] at this
    · rintro N ⟨hN, heN⟩
      obtain ⟨k, rfl⟩ := E2 N hN
      by_contra hki
      exact heN (D0 i k (fun h => hki (by rw [h])))
  exact ⟨n, e, he, horth, hsum, hloc⟩

theorem wc_local_factor_strictly_henselian : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)], (∀ (B : Type u) [CommRing B] [IsLocalRing B] [Algebra A B], Module.Finite A B → IsLocalHom (algebraMap A B) → HenselianLocalRing B) → (∀ (k K : Type u) [Field k] [Field K] [Algebra k K], IsSepClosed k → Algebra.IsAlgebraic k K → IsSepClosed K) → ∀ (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∀ e : B, IsIdempotentElem e → IsLocalRing (Localization.Away e) → ∃ (_ : HenselianLocalRing (Localization.Away e)), IsSepClosed (IsLocalRing.ResidueField (Localization.Away e)) ∧ IsLocalHom ((algebraMap B (Localization.Away e)).comp (algebraMap A B)) :=
by
  intro A _ _ hsepA hH hS B _ _ hB e he hloc
  classical

  have hsurj : Function.Surjective (algebraMap B (Localization.Away e)) := by
    have hu : IsUnit (algebraMap B (Localization.Away e) e) :=
      IsLocalization.Away.algebraMap_isUnit e
    have hi : IsIdempotentElem (algebraMap B (Localization.Away e) e) := he.map _
    have h1 : algebraMap B (Localization.Away e) e = 1 :=
      (IsIdempotentElem.iff_eq_one_of_isUnit hu).mp hi
    intro y
    obtain ⟨⟨b, s⟩, rfl⟩ := IsLocalization.mk'_surjective (Submonoid.powers e) y
    refine ⟨b, ?_⟩
    obtain ⟨k, hk⟩ := s.2
    have hs : algebraMap B (Localization.Away e) (s : B) = 1 := by
      rw [← hk, map_pow, h1, one_pow]
    have := IsLocalization.mk'_spec (Localization.Away e) b s
    rw [hs, mul_one] at this
    exact this.symm
  haveI := hB
  have hH1 : algebraMap A (Localization.Away e) =
      (algebraMap B (Localization.Away e)).comp (algebraMap A B) :=
    IsScalarTower.algebraMap_eq A B _

  have hAB : (algebraMap A B).IsIntegral :=
    algebraMap_isIntegral_iff.mpr (Algebra.IsIntegral.of_finite A B)
  have hBBe : (algebraMap B (Localization.Away e)).IsIntegral :=
    RingHom.isIntegral_of_surjective _ hsurj
  have hfint : (algebraMap A (Localization.Away e)).IsIntegral := by
    rw [hH1]; exact RingHom.IsIntegral.trans _ _ hAB hBBe
  haveI hInt : Algebra.IsIntegral A (Localization.Away e) := algebraMap_isIntegral_iff.mp hfint

  have hlh : IsLocalHom (algebraMap A (Localization.Away e)) := by
    have hmax : (Ideal.comap (algebraMap A (Localization.Away e))
        (IsLocalRing.maximalIdeal (Localization.Away e))).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hfint _
    have heq := IsLocalRing.eq_maximalIdeal hmax
    constructor
    intro a ha
    by_contra hna
    have ha' : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hna
    rw [← heq, Ideal.mem_comap] at ha'
    exact (IsLocalRing.mem_maximalIdeal _).mp ha' ha

  haveI hfinBBe : Module.Finite B (Localization.Away e) :=
    Module.Finite.of_surjective (Algebra.linearMap B (Localization.Away e)) hsurj
  haveI hfinA : Module.Finite A (Localization.Away e) := Module.Finite.trans B _

  have hHen : HenselianLocalRing (Localization.Away e) := hH _ hfinA hlh

  haveI := hlh
  have hcomp : (algebraMap (IsLocalRing.ResidueField A)
      (IsLocalRing.ResidueField (Localization.Away e))).comp (IsLocalRing.residue A) =
      (IsLocalRing.residue (Localization.Away e)).comp (algebraMap A (Localization.Away e)) := by
    ext x
    exact IsLocalRing.ResidueField.algebraMap_residue x
  have hresInt : Algebra.IsIntegral (IsLocalRing.ResidueField A)
      (IsLocalRing.ResidueField (Localization.Away e)) := by
    rw [Algebra.isIntegral_def]
    intro z
    obtain ⟨s, rfl⟩ := IsLocalRing.residue_surjective z
    exact IsIntegral.map_of_comp_eq (IsLocalRing.residue A)
      (IsLocalRing.residue (Localization.Away e)) hcomp (Algebra.IsIntegral.isIntegral s)
  have halg : Algebra.IsAlgebraic (IsLocalRing.ResidueField A)
      (IsLocalRing.ResidueField (Localization.Away e)) := Algebra.IsIntegral.isAlgebraic
  have hSep : IsSepClosed (IsLocalRing.ResidueField (Localization.Away e)) :=
    hS _ _ hsepA halg
  refine ⟨hHen, hSep, ?_⟩
  rw [← hH1]
  exact hlh

theorem wc_finite_over_local_strict_cover : ∀ (A : Type u) [CommRing A] [IsLocalRing A], (∀ (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B → ∃ (n : ℕ) (e : Fin n → B), (∀ i, IsIdempotentElem (e i)) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, ∃ (_ : HenselianLocalRing (Localization.Away (e i))), IsSepClosed (IsLocalRing.ResidueField (Localization.Away (e i))) ∧ IsLocalHom ((algebraMap B (Localization.Away (e i))).comp (algebraMap A B))) → ∀ (X' : Scheme.{u}) (f' : X' ⟶ Spec (.of A)), IsFinite f' → ∃ (n : ℕ) (Ti : Fin n → X'.Etale) (t : ∀ i, Ti i ⟶ Scheme.Etale.mk (𝟙 X')) (R : Fin n → Type u) (_ : ∀ i, CommRing (R i)) (_ : ∀ i, HenselianLocalRing (R i)) (e : ∀ i, (Ti i).left ≅ Spec (.of (R i))), (∀ i, IsSepClosed (IsLocalRing.ResidueField (R i))) ∧ (∀ i, IsOpenImmersion (t i).left) ∧ (∀ i j, i ≠ j → Disjoint (Set.range (t i).left) (Set.range (t j).left)) ∧ (∀ x : X', ∃ i, x ∈ Set.range (t i).left) ∧ (∀ i, f' ((Ti i).hom ((e i).inv (IsLocalRing.closedPoint (R i)))) = IsLocalRing.closedPoint A) :=
by

  have s1 : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)), IsFinite f →
      IsAffine X ∧ (CommRingCat.Hom.hom ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop)).Finite := by
    intro A _ X f hf
    haveI := hf
    refine ⟨isAffine_of_isAffineHom f, ?_⟩
    have h1 : (f.app ⊤).hom.Finite := Scheme.Hom.finite_app f ⊤ (isAffineOpen_top _)
    have h2 : (Scheme.ΓSpecIso (.of A)).inv.hom.Finite := by
      apply RingHom.Finite.of_surjective
      intro y
      refine ⟨(Scheme.ΓSpecIso (.of A)).hom y, ?_⟩
      rw [← CommRingCat.comp_apply, Iso.hom_inv_id]
      rfl
    rw [CommRingCat.hom_comp]
    exact h1.comp h2

  have s2 : ∀ (X : Scheme.{u}) (n : ℕ) (e : Fin n → Γ(X, ⊤)), (∀ i, IsIdempotentElem (e i)) →
      (∀ i j, i ≠ j → e i * e j = 0) → ∑ i, e i = 1 →
      (∀ i j, i ≠ j → Disjoint (X.basicOpen (e i) : Set X) (X.basicOpen (e j) : Set X)) ∧
      (∀ x : X, ∃ i, x ∈ X.basicOpen (e i)) ∧ (∀ i, IsClosed (X.basicOpen (e i) : Set X)) := by
    intro X n e hid horth hsum
    have hone : X.basicOpen (1 : Γ(X, ⊤)) = ⊤ := Scheme.basicOpen_of_isUnit X isUnit_one
    refine ⟨?_, ?_, ?_⟩
    · intro i j hij
      rw [Set.disjoint_left]
      intro x hi hj
      have h : x ∈ X.basicOpen (e i * e j) := by
        rw [Scheme.basicOpen_mul]; exact ⟨hi, hj⟩
      rw [horth i j hij, Scheme.basicOpen_zero] at h
      exact h
    · intro x
      have key : ∀ y ∈ X.basicOpen (∑ i, e i), ∃ i, y ∈ X.basicOpen (e i) := by
        apply Finset.sum_induction _ (fun b => ∀ y ∈ X.basicOpen b, ∃ i, y ∈ X.basicOpen (e i))
        · intro a b ha hb y hy
          rcases (TopologicalSpace.Opens.mem_sup.mp (Scheme.basicOpen_add_le X a b hy)) with h | h
          · exact ha y h
          · exact hb y h
        · intro y hy
          rw [Scheme.basicOpen_zero] at hy
          exact hy.elim
        · intro i _ y hy
          exact ⟨i, hy⟩
      apply key x
      rw [hsum, hone]
      trivial
    · intro i
      have hc : (X.basicOpen (e i) : Set X)ᶜ = (X.basicOpen (1 - e i) : Set X) := by
        ext x
        constructor
        · intro hx
          have h1 : x ∈ X.basicOpen (e i + (1 - e i)) := by
            rw [add_sub_cancel, hone]; trivial
          rcases (TopologicalSpace.Opens.mem_sup.mp (Scheme.basicOpen_add_le X _ _ h1)) with h | h
          · exact absurd h hx
          · exact h
        · intro hx hx'
          have h1 : x ∈ X.basicOpen (e i * (1 - e i)) := by
            rw [Scheme.basicOpen_mul]; exact ⟨hx', hx⟩
          rw [mul_sub, mul_one, (hid i).eq, sub_self, Scheme.basicOpen_zero] at h1
          exact h1
      rw [← isOpen_compl_iff, hc]
      exact (X.basicOpen (1 - e i)).isOpen

  have s3 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)),
      IsFinite f → ∀ (U : X.Opens), IsClosed (U : Set X) → ∀ (R : Type u) [CommRing R]
      [IsLocalRing R] (e : (U : Scheme.{u}) ≅ Spec (.of R)),
      f (U.ι (e.inv (IsLocalRing.closedPoint R))) = IsLocalRing.closedPoint A := by
    intro A _ _ X f hf U hU R _ _ e
    haveI := hf
    have h1 : IsClosed ({e.inv (IsLocalRing.closedPoint R)} : Set U) := by
      have hc : IsClosed ({IsLocalRing.closedPoint R} : Set (Spec (.of R))) :=
        IsLocalRing.isClosed_singleton_closedPoint R
      have := (Scheme.homeoOfIso e.symm).isClosedMap _ hc
      have heq : ⇑(Scheme.homeoOfIso e.symm) '' {IsLocalRing.closedPoint R} =
          ({e.inv (IsLocalRing.closedPoint R)} : Set U) := by
        ext y
        simp only [Set.mem_image, Set.mem_singleton_iff]
        constructor
        · rintro ⟨x, rfl, rfl⟩; rfl
        · rintro rfl; exact ⟨_, rfl, rfl⟩
      rw [heq] at this
      exact this
    have h2 : IsClosed ({U.ι (e.inv (IsLocalRing.closedPoint R))} : Set X) := by
      obtain ⟨t, ht, htx⟩ := (U.ι.isOpenEmbedding.isInducing.isClosed_iff).mp h1
      have : ({U.ι (e.inv (IsLocalRing.closedPoint R))} : Set X) = t ∩ Set.range U.ι := by
        rw [← Set.image_preimage_eq_inter_range, htx, Set.image_singleton]
      rw [this, Scheme.Opens.range_ι]
      exact ht.inter hU
    have h3 : IsClosed ({f (U.ι (e.inv (IsLocalRing.closedPoint R)))} : Set (Spec (.of A))) := by
      have := f.isClosedMap _ h2
      rwa [Set.image_singleton] at this
    have key : ∀ z : PrimeSpectrum A, IsClosed ({z} : Set (PrimeSpectrum A)) →
        z = IsLocalRing.closedPoint A := by
      intro z hz
      have hle : z ≤ IsLocalRing.closedPoint A := by
        rw [← PrimeSpectrum.asIdeal_le_asIdeal]
        exact IsLocalRing.le_maximalIdeal z.isPrime.ne_top
      have hmem := (PrimeSpectrum.le_iff_mem_closure z (IsLocalRing.closedPoint A)).mp hle
      rw [hz.closure_eq] at hmem
      exact (Set.mem_singleton_iff.mp hmem).symm
    exact key _ h3

  intro A _ _ hdec X' f' hf'
  obtain ⟨hAff, hfin⟩ := s1 A X' f' hf'
  haveI := hAff
  letI : Algebra A Γ(X', ⊤) :=
    (CommRingCat.Hom.hom ((Scheme.ΓSpecIso (.of A)).inv ≫ f'.appTop)).toAlgebra
  have hfin' : Module.Finite A Γ(X', ⊤) := hfin
  obtain ⟨n, e, hidem, horth, hsum, hloc⟩ := hdec Γ(X', ⊤) hfin'
  choose hH hsep _ using hloc
  obtain ⟨hdisj, hcov, hclosed⟩ := s2 X' n e hidem horth hsum
  refine ⟨n, fun i => Scheme.Etale.mk (X'.basicOpen (e i)).ι,
    fun i => MorphismProperty.Over.homMk (X'.basicOpen (e i)).ι,
    fun i => Localization.Away (e i), fun i => inferInstance, hH,
    fun i => ((isAffineOpen_top X').basicOpen (e i)).isoSpec ≪≫
      Scheme.Spec.mapIso (RingEquiv.toCommRingCatIso (IsLocalization.algEquiv
        (Submonoid.powers (e i)) (Localization.Away (e i))
        Γ(X', X'.basicOpen (e i))).toRingEquiv).op,
    hsep, ?_, ?_, ?_, ?_⟩
  · intro i
    show IsOpenImmersion (X'.basicOpen (e i)).ι
    infer_instance
  · intro i j hij
    show Disjoint (Set.range (X'.basicOpen (e i)).ι) (Set.range (X'.basicOpen (e j)).ι)
    rw [Scheme.Opens.range_ι, Scheme.Opens.range_ι]
    exact hdisj i j hij
  · intro x
    obtain ⟨i, hi⟩ := hcov x
    refine ⟨i, ?_⟩
    show x ∈ Set.range (X'.basicOpen (e i)).ι
    rw [Scheme.Opens.range_ι]
    exact hi
  · intro i
    haveI := hH i
    exact s3 A X' f' hf' (X'.basicOpen (e i)) (hclosed i) _ _

theorem wc_etale_section_strict_local : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)], (∀ (E : Type u) [CommRing E] [Algebra R E], Algebra.Etale R E → ∀ φ : E →ₐ[R] IsLocalRing.ResidueField R, ∃ τ : E →ₐ[R] R, (Algebra.ofId R (IsLocalRing.ResidueField R)).comp τ = φ) → ∀ {U V : Scheme.{u}} (e : U ≅ Spec (.of R)) (g : V ⟶ U) [Etale g] (v : V), e.hom (g v) = IsLocalRing.closedPoint R → ∃ σ : U ⟶ V, σ ≫ g = 𝟙 U :=
by
  intro R _ _ _ H U V e g _ v hv

  have hres : ∀ (S : Type u) [CommRing S] [Algebra R S], Algebra.Etale R S →
      ∀ (q : Ideal S) [q.IsPrime], q.comap (algebraMap R S) = IsLocalRing.maximalIdeal R →
      Nonempty (S →ₐ[R] IsLocalRing.ResidueField R) := by
    intro S _ _ hE q _ hq
    have hker : RingHom.ker (algebraMap R q.ResidueField) = IsLocalRing.maximalIdeal R := by
      rw [IsScalarTower.algebraMap_eq R S q.ResidueField, ← RingHom.comap_ker,
        Ideal.ker_algebraMap_residueField, hq]
    have : IsLocalHom (algebraMap R q.ResidueField) := by
      constructor
      intro a ha
      by_contra hna
      have hm : a ∈ IsLocalRing.maximalIdeal R := hna
      rw [← hker, RingHom.mem_ker] at hm
      exact ha.ne_zero hm
    let j : IsLocalRing.ResidueField R →+* q.ResidueField :=
      IsLocalRing.ResidueField.lift (algebraMap R q.ResidueField)
    letI : Algebra (IsLocalRing.ResidueField R) q.ResidueField := j.toAlgebra
    have : IsScalarTower R (IsLocalRing.ResidueField R) q.ResidueField :=
      IsScalarTower.of_algebraMap_eq (fun r => by
        rw [RingHom.algebraMap_toAlgebra, IsLocalRing.ResidueField.algebraMap_eq,
          IsLocalRing.ResidueField.lift_residue_apply])
    have : Algebra.FormallyUnramified S (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.of_isLocalization q.primeCompl
    have : Algebra.FormallyUnramified S q.ResidueField :=
      Algebra.FormallyUnramified.comp S (Localization.AtPrime q) q.ResidueField
    have : Algebra.FormallyUnramified R q.ResidueField :=
      Algebra.FormallyUnramified.comp R S q.ResidueField
    have : Algebra.EssFiniteType R q.ResidueField := Algebra.EssFiniteType.comp R S q.ResidueField
    have : Algebra.FormallyUnramified (IsLocalRing.ResidueField R) q.ResidueField :=
      Algebra.FormallyUnramified.of_restrictScalars R _ q.ResidueField
    have : Algebra.EssFiniteType (IsLocalRing.ResidueField R) q.ResidueField :=
      Algebra.EssFiniteType.of_comp R _ q.ResidueField
    have : Algebra.IsSeparable (IsLocalRing.ResidueField R) q.ResidueField :=
      Algebra.FormallyUnramified.isSeparable _ q.ResidueField
    have hsurj := IsSepClosed.algebraMap_surjective (IsLocalRing.ResidueField R) q.ResidueField
    let eq : IsLocalRing.ResidueField R ≃ₐ[R] q.ResidueField :=
      AlgEquiv.ofBijective (IsScalarTower.toAlgHom R (IsLocalRing.ResidueField R) q.ResidueField)
        ⟨(algebraMap (IsLocalRing.ResidueField R) q.ResidueField).injective, hsurj⟩
    exact ⟨eq.symm.toAlgHom.comp (IsScalarTower.toAlgHom R S q.ResidueField)⟩

  obtain ⟨E, ι, hι, hvι, -⟩ :=
    Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
  obtain ⟨w, hw⟩ := hvι
  have := hι
  let h : Spec E ⟶ Spec (.of R) := ι ≫ g ≫ e.hom
  have : Etale h := inferInstance
  let φ : CommRingCat.of R ⟶ E := Spec.preimage h
  have hφ : Spec.map φ = h := Spec.map_preimage h
  have hEt : (CommRingCat.Hom.hom φ).Etale := by
    have : Etale (Spec.map φ) := by rw [hφ]; infer_instance
    exact (HasRingHomProperty.Spec_iff (P := @Etale)).mp this
  letI : Algebra R E := (CommRingCat.Hom.hom φ).toAlgebra
  have hAE : Algebra.Etale R E := RingHom.Etale.toAlgebra hEt
  let p : PrimeSpectrum E := w
  have hq : (p.asIdeal).comap (algebraMap R E) = IsLocalRing.maximalIdeal R := by
    have h1 : (Spec.map φ) w = IsLocalRing.closedPoint R := by
      rw [hφ]
      show e.hom (g (ι w)) = _
      rw [hw, hv]
    have h2 := congrArg PrimeSpectrum.asIdeal h1
    exact h2

  obtain ⟨φ₀⟩ := hres E hAE p.asIdeal hq
  obtain ⟨τ, -⟩ := H E hAE φ₀
  let τ' : E ⟶ CommRingCat.of R := CommRingCat.ofHom (τ : E →+* R)
  have hret : φ ≫ τ' = 𝟙 _ := by
    ext r
    exact τ.commutes r
  refine ⟨e.hom ≫ Spec.map τ' ≫ ι, ?_⟩
  rw [← cancel_mono e.hom]
  simp only [Category.assoc, Category.id_comp]
  have h3 : ι ≫ g ≫ e.hom = Spec.map φ := hφ.symm
  rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]

theorem wc_pbc_finite : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsFinite f → wcPBCV f :=
by
  intro X Y f hf A _ _ hscA a X' f' a' hpb m hm F hsupp htor q
  classical

  have s1 : ∀ (A0 : Type u) [CommRing A0] [HenselianLocalRing A0] (E : Type u) [CommRing E]
      [Algebra A0 E], Algebra.Etale A0 E → ∀ φ : E →ₐ[A0] IsLocalRing.ResidueField A0,
      ∃ τ : E →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ := by
    intro A0 _ hHen
    have sstd : ∀ (S : Type u) [CommRing S] [Algebra A0 S], Algebra.IsStandardEtale A0 S →
        ∀ φ : S →ₐ[A0] IsLocalRing.ResidueField A0,
          ∃ τ : S →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ := by
      intro S _ _ hS φ
      obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
      have hm := P.hasMap
      have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
        rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
      have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
        rw [Polynomial.aeval_algHom_apply]
        exact (hm.2.map φ).ne_zero
      have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
        obtain ⟨p₁, p₂, N, hc⟩ := P.cond
        have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
        rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
        intro h
        rw [h, zero_mul] at h1
        exact pow_ne_zero N hg0 h1.symm
      have key := (HenselianLocalRing.TFAE A0).out 1 2
      obtain ⟨a, ha, hres⟩ := key.mp hHen P.f P.monic_f (φ P.x) hf0 hd0
      have hA : P.HasMap a := by
        refine ⟨?_, ?_⟩
        · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
          exact ha
        · have key2 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)) (Polynomial.aeval a P.g) =
              Polynomial.aeval (φ P.x) P.g := by
            rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
              IsLocalRing.ResidueField.algebraMap_eq, hres]
          rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
          exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
      refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
      have h1 : (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp (P.lift a hA) =
          φ.comp P.equivRing.symm.toAlgHom := by
        apply StandardEtalePair.hom_ext
        rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
          IsLocalRing.ResidueField.algebraMap_eq, hres]
        have hx : P.equivRing.symm P.X = P.x := (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
        show φ P.x = φ (P.equivRing.symm P.X)
        rw [hx]
      ext s
      have h2 := congrArg (fun F => F (P.equivRing s)) h1
      simpa using h2
    intro E _ _ hE φ
    have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := A0)
      (RingHom.ker (φ : E →+* IsLocalRing.ResidueField A0))
    have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
    have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
    let φ' : Localization.Away s →ₐ[A0] IsLocalRing.ResidueField A0 :=
      IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
    obtain ⟨τ', hτ'⟩ := sstd _ hst φ'
    refine ⟨τ'.comp (IsScalarTower.toAlgHom A0 E (Localization.Away s)), ?_⟩
    ext e
    have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
    simp only [AlgHom.comp_apply] at h1 ⊢
    rw [IsScalarTower.toAlgHom_apply, h1]
    simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]

  have s2 : ∀ (A0 : Type u) [CommRing A0] [IsLocalRing A0],
      (∀ (E : Type u) [CommRing E] [Algebra A0 E], Algebra.Etale A0 E →
        ∀ φ : E →ₐ[A0] IsLocalRing.ResidueField A0,
          ∃ τ : E →ₐ[A0] A0, (Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ = φ) →
      ∀ (f : Polynomial A0) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField A0)), f.Monic →
        g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue A0) = g₀ * h₀ →
        ∃ g h : Polynomial A0, g.Monic ∧ h.Monic ∧ f = g * h ∧
          g.map (IsLocalRing.residue A0) = g₀ ∧ h.map (IsLocalRing.residue A0) = h₀ := by
    intro A0 _ _ s3 f g₀ h₀ hf hg hh hc hfac
    have hofId : ((Algebra.ofId A0 (IsLocalRing.ResidueField A0) :
        A0 →ₐ[A0] IsLocalRing.ResidueField A0) :
        A0 →+* IsLocalRing.ResidueField A0) = IsLocalRing.residue A0 := by
      ext x
      show Algebra.ofId A0 (IsLocalRing.ResidueField A0) x = IsLocalRing.residue A0 x
      rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]
    have hn : f.natDegree = g₀.natDegree + h₀.natDegree := by
      rw [← hg.natDegree_mul hh, ← hfac, hf.natDegree_map]
    let p : Polynomial.MonicDegreeEq A0 f.natDegree := Polynomial.MonicDegreeEq.mk f hf rfl
    let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A0) g₀.natDegree :=
      Polynomial.MonicDegreeEq.mk g₀ hg rfl
    let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField A0) h₀.natDegree :=
      Polynomial.MonicDegreeEq.mk h₀ hh rfl
    have hq : (G₀ : Polynomial (IsLocalRing.ResidueField A0)) * (H₀ : Polynomial _) =
        Polynomial.map (algebraMap A0 (IsLocalRing.ResidueField A0)) (p : Polynomial A0) ∧
        IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField A0)) (H₀ : Polynomial _) := by
      refine ⟨?_, hc⟩
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact hfac.symm
    obtain ⟨τ, hτ⟩ := s3 _ inferInstance
      ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
        _ _ hn p).symm ⟨(G₀, H₀), hq⟩)
    have nat : ∀ (ψ : A0 →ₐ[A0] IsLocalRing.ResidueField A0),
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
          _ _ hn p (ψ.comp τ)).1.1 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.1 :
          Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
            (ψ : A0 →+* IsLocalRing.ResidueField A0) ∧
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
          _ _ hn p (ψ.comp τ)).1.2 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.2 :
          Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
            (ψ : A0 →+* IsLocalRing.ResidueField A0) := by
      intro ψ
      constructor
      · show (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A0)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A0)) :
              Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
                (ψ : A0 →+* IsLocalRing.ResidueField A0)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
      · show (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField A0)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom A0
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* A0)) :
              Polynomial.MonicDegreeEq A0 _) : Polynomial A0).map
                (ψ : A0 →+* IsLocalRing.ResidueField A0)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
    obtain ⟨nat1, nat2⟩ := nat (Algebra.ofId A0 (IsLocalRing.ResidueField A0))
    have hφ : Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField A0)
        _ _ hn p ((Algebra.ofId A0 (IsLocalRing.ResidueField A0)).comp τ) = ⟨(G₀, H₀), hq⟩ := by
      rw [hτ]
      exact Equiv.apply_symm_apply _ _
    rw [hφ, hofId] at nat1 nat2
    refine ⟨_, _, (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.1.monic,
      (Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).1.2.monic, ?_,
      nat1.symm, nat2.symm⟩
    rw [(Polynomial.UniversalCoprimeFactorizationRing.homEquiv A0 _ _ hn p τ).2.1,
      Algebra.algebraMap_self, Polynomial.map_id]
    rfl

  have s5 : ∀ (k K : Type u) [Field k] [Field K] [Algebra k K], IsSepClosed k →
      Algebra.IsAlgebraic k K → IsSepClosed K := by
    intro k K _ _ _ hk hal
    haveI : IsAlgClosure k (AlgebraicClosure K) := IsAlgClosure.ofAlgebraic k K (AlgebraicClosure K)
    haveI : IsPurelyInseparable k (AlgebraicClosure K) :=
      (isSepClosed_iff_isPurelyInseparable_algebraicClosure k (AlgebraicClosure K)).mp hk
    haveI : IsPurelyInseparable K (AlgebraicClosure K) :=
      IsPurelyInseparable.tower_top k K (AlgebraicClosure K)
    exact (isSepClosed_iff_isPurelyInseparable_algebraicClosure K (AlgebraicClosure K)).mpr
      inferInstance

  have L := wc_idempotent_lift_of_factor_lift A (s2 A (s1 A))
  have hdec : ∀ (B : Type u) [CommRing B] [Algebra A B], Module.Finite A B →
      ∃ (n : ℕ) (e : Fin n → B), (∀ i, IsIdempotentElem (e i)) ∧
        (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧
        ∀ i, ∃ (_ : HenselianLocalRing (Localization.Away (e i))),
          IsSepClosed (IsLocalRing.ResidueField (Localization.Away (e i))) ∧
          IsLocalHom ((algebraMap B (Localization.Away (e i))).comp (algebraMap A B)) := by
    intro B _ _ hB
    obtain ⟨n, e, h1, h2, h3, h4⟩ := wc_finite_alg_local_idempotents A L B hB
    refine ⟨n, e, h1, h2, h3, fun i => ?_⟩
    exact @wc_local_factor_strictly_henselian A _ _ hscA (wc_finite_local_henselian A L) s5 B _ _
      hB (e i) (h1 i) (h4 i)

  have hf' : IsFinite f' := MorphismProperty.of_isPullback hpb hf
  obtain ⟨n, Ti, t, R, _, _, e, hsep, hopen, hdisj, hcov, hcp⟩ :=
    wc_finite_over_local_strict_cover A hdec X' f' hf'

  have hbij := fun G => wc_et_disjoint_cover_bijective (Scheme.Etale.mk (𝟙 X')) n Ti t hopen hdisj
    hcov G

  have hHcov : ∀ i (Rs : Sieve (Ti i)), Rs ∈ Scheme.smallEtaleTopology X' (Ti i) →
      Rs.arrows (𝟙 (Ti i)) := by
    intro i Rs hR
    haveI := hsep i
    change Rs ∈ Scheme.smallGrothendieckTopology @Etale X' (Ti i) at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    have hR' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale _
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR
    obtain ⟨Yg, g, y, hg, hgE, hy⟩ := hR' ((e i).inv (IsLocalRing.closedPoint (R i)))
    haveI : Etale g.left := hgE
    obtain ⟨σ, hσ⟩ := wc_etale_section_strict_local (R i) (s1 (R i)) (e i) g.left y
      (by
        rw [hy]
        first
          | (rw [← Scheme.Hom.comp_apply (e i).inv (e i).hom, Iso.inv_hom_id]; rfl)
          | (have h := Scheme.Hom.comp_apply (e i).inv (e i).hom (IsLocalRing.closedPoint (R i))
             rw [Iso.inv_hom_id] at h
             exact h.symm)
          | exact Scheme.inv_hom_apply (e i) _
          | (simp; done))
    let σ' : Ti i ⟶ Yg := MorphismProperty.Over.homMk σ
      (by rw [← MorphismProperty.Over.w g, ← Category.assoc, hσ, Category.id_comp])
    have h := Rs.downward_closed hg σ'
    have hσ' : σ' ≫ g = 𝟙 (Ti i) := MorphismProperty.Over.Hom.ext hσ
    rwa [hσ'] at h

  let T : X'.Etale := Scheme.Etale.mk (𝟙 X')
  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))

  haveI : ((sheafSections (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}).obj
      (Opposite.op T)).PreservesEpimorphisms := by
    constructor
    intro G H φ hφ
    have h1 : Sheaf.IsLocallySurjective φ :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ
    haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X') φ.hom := h1
    apply (AddCommGrpCat.epi_iff_surjective _).mpr
    intro s
    have hr : ∀ i, ∃ r : G.obj.obj (Opposite.op (Ti i)),
        (φ.hom.app (Opposite.op (Ti i))).hom r = (H.obj.map (t i).op).hom s := by
      intro i
      have h2 := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology X') φ.hom
        (U := Opposite.op (Ti i)) ((H.obj.map (t i).op).hom s)
      have h3 := hHcov i _ h2
      rw [Presheaf.imageSieve_apply] at h3
      obtain ⟨r, hr⟩ := h3
      exact ⟨r, by simpa using hr⟩
    choose r hr using hr
    obtain ⟨g, hg⟩ := (hbij G).2 r
    refine ⟨g, ?_⟩
    apply (hbij H).1
    funext i
    have hgi : (G.obj.map (t i).op).hom g = r i := congrFun hg i
    have hnat := congrArg (fun F => F.hom g) (φ.hom.naturality (t i).op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at hnat
    change (H.obj.map (t i).op).hom ((φ.hom.app (Opposite.op T)).hom g) =
      (H.obj.map (t i).op).hom s
    rw [← hnat, hgi, hr i]

  have hP : Projective (AddCommGrpCat.of (ULift.{u+1} ℤ)) := by
    refine ⟨fun {E X} f e he => ?_⟩
    have hs := (AddCommGrpCat.epi_iff_surjective e).mp he
    obtain ⟨y, hy⟩ := hs (f ⟨1⟩)
    refine ⟨AddCommGrpCat.ofHom ((zmultiplesHom E y).comp AddEquiv.ulift.toAddMonoidHom), ?_⟩
    ext ⟨n⟩
    have h1 : (⟨n⟩ : ULift.{u+1} ℤ) = n • (⟨1⟩ : ULift.{u+1} ℤ) := by
      ext; simp
    change e (n • y) = f ⟨n⟩
    rw [h1, map_zsmul, map_zsmul, hy]
  have adj := constantSheafAdj (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1} hT
  haveI hproj := adj.map_projective _ hP
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X') AddCommGrpCat.{u+1}) := HasExt.standard _
  unfold wcEtExt
  cases q with
  | zero =>

    have e0 := Sheaf.H.equiv₀ F hT
    have h0 : ∀ s : F.obj.obj (Opposite.op T), s = 0 := by
      intro s
      apply (hbij F).1
      funext i
      change (F.obj.map (t i).op).hom s = (F.obj.map (t i).op).hom 0
      rw [map_zero]
      have hS := hsupp (Ti i) ((F.obj.map (t i).op).hom s)
      obtain ⟨V', h, g, hgen, hcomp⟩ := hHcov i _ hS
      rcases hgen with hz | hW
      · calc (F.obj.map (t i).op).hom s
            = (F.obj.map (h ≫ g).op).hom ((F.obj.map (t i).op).hom s) := by
              rw [hcomp]; simp
          _ = (F.obj.map h.op).hom ((F.obj.map g.op).hom ((F.obj.map (t i).op).hom s)) := by
              rw [op_comp, Functor.map_comp]; rfl
          _ = 0 := by rw [hz, map_zero]
      · exfalso
        apply hW (h.left ((e i).inv (IsLocalRing.closedPoint (R i))))
        have hx : V'.hom (h.left ((e i).inv (IsLocalRing.closedPoint (R i)))) =
            (Ti i).hom ((e i).inv (IsLocalRing.closedPoint (R i))) := by
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w h]
        show f' (V'.hom (h.left ((e i).inv (IsLocalRing.closedPoint (R i))))) =
          IsLocalRing.closedPoint A
        rw [hx]
        exact hcp i
    haveI : Subsingleton (F.obj.obj (Opposite.op T)) := ⟨fun a b => by rw [h0 a, h0 b]⟩
    exact e0.toEquiv.subsingleton
  | succ k =>
    exact Abelian.Ext.subsingleton_of_projective _ _ k

theorem wc_supp_torsion_cokernel : ∀ (Y : Scheme.{u}) (W : Set Y) (m : ℕ)
    {F F' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (ι : F ⟶ F'),
    wcSuppIn Y W F' → m • 𝟙 F' = 0 →
    wcSuppIn Y W (Limits.cokernel ι) ∧ m • 𝟙 (Limits.cokernel ι) = 0 :=
by
  intro Y W m F F' ι hsupp htor
  have hepi : Epi (Limits.cokernel.π ι) := inferInstance
  refine ⟨?_, ?_⟩
  · intro V s
    have hls : Sheaf.IsLocallySurjective (Limits.cokernel.π ι) :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} (Limits.cokernel.π ι)).mpr hepi
    haveI : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
        (Limits.cokernel.π ι).hom := hls
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) (Limits.cokernel.π ι).hom s
    refine GrothendieckTopology.transitive _ hI _ ?_
    intro V' g hg
    obtain ⟨t, ht⟩ := hg
    refine GrothendieckTopology.superset_covering _ ?_ (hsupp V' t)
    intro Z k hk
    obtain ⟨V'', a, h, hh, rfl⟩ := hk
    change (Sieve.generate _).arrows ((a ≫ h) ≫ g)
    rw [Category.assoc]
    apply Sieve.downward_closed
    apply Sieve.le_generate
    rcases hh with h0 | hW
    · left
      have key := NatTrans.naturality_apply (Limits.cokernel.π ι).hom h.op t
      rw [h0, map_zero, ht] at key
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
      exact key.symm
    · right
      exact hW
  · rw [← cancel_epi (Limits.cokernel.π ι)]
    have e : Limits.cokernel.π ι ≫ (m • 𝟙 (Limits.cokernel ι)) =
        (m • 𝟙 F') ≫ Limits.cokernel.π ι := by
      simp only [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id,
        Category.id_comp]
    rw [e, htor, Limits.zero_comp, Limits.comp_zero]

theorem wc_et_supp_gamma_vanishing : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (X : Scheme.{u})
    (f : X ⟶ Spec (.of A)), IsClosedMap f →
    ∀ F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1},
    wcSuppIn X {x | f x ≠ IsLocalRing.closedPoint A} F → Subsingleton (wcEtExt X F 0) :=
by
  intro A _ _ X f hf F hF
  classical
  have hEtHom : ∀ {P Q : X.Etale} (c : P ⟶ Q), Etale c.left := by
    intro P Q c
    have hw : c.left ≫ Q.hom = P.hom := MorphismProperty.Over.w c
    have h1 : Etale Q.hom := Q.prop
    have h2 : Etale (c.left ≫ Q.hom) := by rw [hw]; exact P.prop
    exact Etale.of_comp c.left Q.hom
  let T : X.Etale := Scheme.Etale.mk (𝟙 X)
  have hT : Limits.IsTerminal T := Limits.IsTerminal.ofUniqueHom
    (fun V => MorphismProperty.Over.homMk V.hom)
    (fun V m => MorphismProperty.Over.Hom.ext
      ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hsec : ∀ s : F.obj.obj (Opposite.op T), s = 0 := by
    intro s
    let E : Set T.left := {v | ∃ (V₁ : X.Etale) (c : V₁ ⟶ T), v ∈ Set.range c.left ∧
      F.obj.map c.op s = 0}
    have hEopen : IsOpen E := by
      rw [isOpen_iff_forall_mem_open]
      rintro v ⟨V₁, c, hv, hc⟩
      haveI := hEtHom c
      exact ⟨Set.range c.left, fun w hw => ⟨V₁, c, hw, hc⟩, c.left.isOpenMap.isOpen_range, hv⟩
    have hvan : ∀ (V₁ : X.Etale) (c : V₁ ⟶ T), Set.range c.left ⊆ E →
        F.obj.map c.op s = 0 := by
      intro V₁ c hsub
      let S : Sieve V₁ :=
        { arrows := fun D d => F.obj.map d.op (F.obj.map c.op s) = 0
          downward_closed := by
            intro D D' d hd e
            change F.obj.map (e ≫ d).op (F.obj.map c.op s) = 0
            rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
            rw [hd, map_zero] }
      have hS : S ∈ Scheme.smallEtaleTopology X V₁ := by
        change S ∈ Scheme.smallGrothendieckTopology @Etale X V₁
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro p
        obtain ⟨V₂, c₂, ⟨q₀, hq₀⟩, hc₂⟩ := hsub ⟨p, rfl⟩
        haveI : Etale c₂.left := hEtHom c₂
        haveI : Etale V₁.hom := V₁.prop
        let fst := Limits.pullback.fst c.left c₂.left
        let snd := Limits.pullback.snd c.left c₂.left
        haveI hfst : Etale fst := inferInstance
        let D : X.Etale := Scheme.Etale.mk (fst ≫ V₁.hom)
        have hw2 : snd ≫ V₂.hom = fst ≫ V₁.hom := by
          rw [← MorphismProperty.Over.w c₂, ← MorphismProperty.Over.w c, ← Category.assoc,
            ← Category.assoc, Limits.pullback.condition]
        let π₁ : D ⟶ V₁ := MorphismProperty.Over.homMk fst rfl trivial
        let π₂ : D ⟶ V₂ := MorphismProperty.Over.homMk snd hw2 trivial
        have hcomm : π₁ ≫ c = π₂ ≫ c₂ := by
          apply MorphismProperty.Over.Hom.ext
          exact Limits.pullback.condition
        obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback p q₀ hq₀.symm
        have hπ₁ : S.arrows π₁ := by
          change F.obj.map π₁.op (F.obj.map c.op s) = 0
          rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hcomm, op_comp,
            Functor.map_comp, ConcreteCategory.comp_apply, hc₂, map_zero]
        exact ⟨D, π₁, z, hπ₁, hfst, hz1⟩
      have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.smallEtaleTopology X) (forget AddCommGrpCat.{u+1})).obj F).2
      exact (hsh S hS).isSeparatedFor.ext (fun D d hd => by
        change F.obj.map d.op (F.obj.map c.op s) = F.obj.map d.op 0
        rw [map_zero]
        exact hd)
    have hfib : ∀ z : X, f z = IsLocalRing.closedPoint A → z ∈ E := by
      intro z hz
      have hR := hF T s
      change _ ∈ Scheme.smallGrothendieckTopology @Etale X T at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      obtain ⟨Y, g, y, hg, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR z
      obtain ⟨Y', h, g', hg', hcomp⟩ := hg
      have hy' : g'.left (h.left y) = z := by
        rw [← hy, ← hcomp]
        rfl
      rcases hg' with h0 | hW
      · exact ⟨Y', g', ⟨h.left y, hy'⟩, h0⟩
      · exfalso
        have h1 := hW (h.left y)
        have h2 : Y'.hom (h.left y) = z := by
          rw [← MorphismProperty.Over.w g', Scheme.Hom.comp_apply, hy']
          rfl
        rw [h2] at h1
        exact h1 hz
    have hEuniv : ∀ v, v ∈ E := by
      intro x
      by_contra hx
      have hZ : IsClosed Eᶜ := hEopen.isClosed_compl
      have hfZ := hf _ hZ
      have hmem : IsLocalRing.closedPoint A ∈ f '' Eᶜ :=
        (IsLocalRing.specializes_closedPoint (f x)).mem_closed hfZ ⟨x, hx, rfl⟩
      obtain ⟨z, hzE, hz⟩ := hmem
      exact hzE (hfib z hz)
    have h0 := hvan T (𝟙 T) (fun v _ => hEuniv v)
    rw [op_id, F.obj.map_id] at h0
    exact h0
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : Subsingleton (F.obj.obj (Opposite.op T)) := ⟨fun a b => (hsec a).trans (hsec b).symm⟩
  unfold wcEtExt
  exact (Sheaf.H.equiv₀ F hT).toEquiv.subsingleton

theorem wc_et_injective_torsion_kernel_acyclic : ∀ (Y : Scheme.{u})
    (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I] (m : ℕ), m ≠ 0 →
    ∀ n : ℕ, Subsingleton (wcEtExt Y (Limits.kernel (m • 𝟙 I)) (n + 1)) :=
by
  intro Y I _ m hm n
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  have s2 : ∀ (F : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (V : (Scheme.Etale Y)ᵒᵖ) (x : F.obj V), m • x = 0 → x = 0) →
      Mono (m • 𝟙 ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj F)) := by
    intro F hF
    have hmF : Mono (m • 𝟙 F) := by
      haveI : ∀ V, Mono ((m • 𝟙 F).app V) := by
        intro V
        rw [AddCommGrpCat.mono_iff_injective, injective_iff_map_eq_zero]
        intro x hx
        apply hF V x
        simpa using hx
      exact NatTrans.mono_of_mono_app _
    have e : m • 𝟙 ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj F) =
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map (m • 𝟙 F) := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rw [e]
    exact Functor.map_mono _ _

  have s3 : ∀ (U : Y.Etale), ∃ e : ∀ F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F) ≃ F.obj.obj (Opposite.op U),
      (∀ (F F' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
        (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F),
        e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g)) ∧
      (∀ F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}, e F 0 = 0) := by
    intro U
    let e2 : ∀ G : Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op U) :=
      fun G => ((Adjunction.whiskerRight Y.Etaleᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := U) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    have hnat2 : ∀ (G G' : Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
        (h : yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 G' (h ≫ ψ) = ψ.app (Opposite.op U) (e2 G h) := by
      intro G G' ψ h
      have hW := (Adjunction.whiskerRight Y.Etaleᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv_naturality_right
        (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u}) h ψ
      have hY := uliftYonedaEquiv_comp.{u+1}
        ((Adjunction.whiskerRight Y.Etaleᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G h)
        (((Functor.whiskeringRight Y.Etaleᵒᵖ AddCommGrpCat.{u+1} (Type (u+1))).obj
            (forget AddCommGrpCat.{u+1})).map ψ)
      exact (congrArg (uliftYonedaEquiv.{u+1} (X := U) (F := G' ⋙ forget AddCommGrpCat.{u+1})) hW).trans hY
    let e : ∀ F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F) ≃
          F.obj.obj (Opposite.op U) := fun F =>
      ((sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans (e2 F.obj)
    have hnat : ∀ (F F' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
        (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ F),
        e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g) := by
      intro F F' φ g
      have hA := (sheafificationAdjunction (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).homEquiv_naturality_right
        (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) g φ
      exact (congrArg (e2 F'.obj) hA).trans (hnat2 F.obj F'.obj φ.hom _)
    refine ⟨e, hnat, fun F => ?_⟩
    have h1 := hnat F F 0 0
    rw [Limits.zero_comp] at h1
    rw [h1]
    have h0 : (0 : F ⟶ F).hom = 0 :=
      (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_zero F F
    rw [h0, NatTrans.app_zero]
    rfl

  have hEpi : Epi (m • 𝟙 I) := by
    apply Preadditive.epi_of_cancel_zero
    intro R g hg
    have hmg : m • g = 0 := by
      rw [← hg, Preadditive.nsmul_comp, Category.id_comp]
    apply Sheaf.hom_ext
    ext V s
    obtain ⟨W⟩ := V
    obtain ⟨e, hnat, hzero⟩ := s3 W
    have htf : ∀ (Z : (Scheme.Etale Y)ᵒᵖ)
        (x : (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj Z),
        m • x = 0 → x = 0 := by
      intro Z
      change ∀ x : FreeAbelianGroup (ULift.{u+1} (Z.unop ⟶ W)), m • x = 0 → x = 0
      intro x hx
      have h1 : m • FreeAbelianGroup.toFinsupp x = 0 := by
        rw [← map_nsmul, hx, map_zero]
      have h2 : FreeAbelianGroup.toFinsupp x = 0 :=
        nsmul_right_injective hm (h1.trans (smul_zero m).symm)
      rw [← Finsupp.toFreeAbelianGroup_toFinsupp x, h2, map_zero]
    haveI hmono : Mono (m • 𝟙 ((presheafToSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))) :=
      s2 _ htf
    let σ := (e I).symm s
    let τ := Injective.factorThru σ (m • 𝟙 _)
    have hτ : (m • 𝟙 _) ≫ τ = σ := Injective.comp_factorThru σ (m • 𝟙 _)
    have hσg : σ ≫ g = 0 := by
      rw [← hτ, Preadditive.nsmul_comp, Category.id_comp, Preadditive.nsmul_comp,
        ← Preadditive.comp_nsmul, hmg, Limits.comp_zero]
    have h1 := hnat I R g σ
    rw [hσg, hzero] at h1
    have hs : e I σ = s := Equiv.apply_symm_apply (e I) s
    rw [hs] at h1
    rw [← h1]
    have h0 : (0 : I ⟶ R).hom = 0 :=
      (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map_zero I R
    rw [h0, NatTrans.app_zero]
    rfl

  let P := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  have hP : Mono (m • 𝟙 P) := by
    refine s2 ((Functor.const _).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ?_
    intro V
    change ∀ x : ULift.{u+1} ℤ, m • x = 0 → x = 0
    intro x hx
    apply ULift.ext
    have h : m • x.down = 0 := congrArg ULift.down hx
    exact nsmul_right_injective hm (h.trans (smul_zero m).symm)

  let f := m • 𝟙 I
  let S := ShortComplex.mk (Limits.kernel.ι f) f (Limits.kernel.condition f)
  have hS : S.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel f) inferInstance hEpi
  have hv : ∀ e : Abelian.Ext P (Limits.kernel f) (n + 1), e = 0 := by
    intro e
    have h0 : e.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 := Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS e h0 rfl
    rw [← hx₃]
    rcases n with _ | k
    · haveI : Mono (m • 𝟙 P) := hP
      let h := Abelian.Ext.homEquiv₀ x₃
      let h' := Injective.factorThru h (m • 𝟙 P)
      have hh' : (m • 𝟙 P) ≫ h' = h := Injective.comp_factorThru h (m • 𝟙 P)
      have hhg : h = h' ≫ S.g := by
        rw [← hh']
        change (m • 𝟙 P) ≫ h' = h' ≫ (m • 𝟙 I)
        rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
      have hx : x₃ = (Abelian.Ext.mk₀ h').comp (Abelian.Ext.mk₀ S.g) (add_zero 0) := by
        rw [Abelian.Ext.mk₀_comp_mk₀, ← hhg]
        exact (Abelian.Ext.mk₀_homEquiv₀_apply x₃).symm
      rw [hx, Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
        hS.comp_extClass, Abelian.Ext.comp_zero]
    · rw [Abelian.Ext.eq_zero_of_injective x₃, Abelian.Ext.zero_comp]
  change Subsingleton (Abelian.Ext P (Limits.kernel (m • 𝟙 I)) (n + 1))
  exact ⟨fun x y => (hv x).trans (hv y).symm⟩

theorem wc_et_max_supported_subsheaf : ∀ (Y : Scheme.{u}) (W : Set Y)
    (J : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
    ∃ (J' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ι : J' ⟶ J),
      Mono ι ∧ wcSuppIn Y W J' ∧
      ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : G ⟶ J),
        wcSuppIn Y W G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ :=
by
  intro Y W J

  have L1 : ∀ (F : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (V : Y.Etale) (s : F.obj (Opposite.op V))
      (V'' : Y.Etale) (f : V'' ⟶ V),
      (Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        F.map g.op s = 0 ∨ ∀ x, V'.hom x ∈ W)).arrows f →
      F.map f.op s = 0 ∨ ∀ x, V''.hom x ∈ W := by
    intro F V s V'' f hf
    obtain ⟨V', a, g, hg, rfl⟩ := hf
    rcases hg with h | h
    · left
      rw [op_comp, F.map_comp, ConcreteCategory.comp_apply, h, map_zero]
    · right
      intro x
      rw [← MorphismProperty.Over.w a, Scheme.Hom.comp_apply]
      exact h _

  have hzero : ∀ V : Y.Etale, Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
      J.obj.map g.op (0 : J.obj.obj (Opposite.op V)) = 0 ∨ ∀ x, V'.hom x ∈ W) ∈
        Scheme.smallEtaleTopology Y V := by
    intro V
    refine GrothendieckTopology.superset_covering _ ?_ (GrothendieckTopology.top_mem _ V)
    intro V' g _
    exact Sieve.le_generate _ _ _ (Or.inl (map_zero _))
  have hadd : ∀ (V : Y.Etale) (s t : J.obj.obj (Opposite.op V)),
      Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        J.obj.map g.op s = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y V →
      Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        J.obj.map g.op t = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y V →
      Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        J.obj.map g.op (s + t) = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y V := by
    intro V s t hs ht
    refine GrothendieckTopology.superset_covering _ ?_
      (GrothendieckTopology.intersection_covering _ hs ht)
    intro V'' f hf
    rcases L1 J.obj V s V'' f hf.1 with h1 | h1
    · rcases L1 J.obj V t V'' f hf.2 with h2 | h2
      · exact Sieve.le_generate _ _ _ (Or.inl (by rw [map_add, h1, h2, add_zero]))
      · exact Sieve.le_generate _ _ _ (Or.inr h2)
    · exact Sieve.le_generate _ _ _ (Or.inr h1)
  have hneg : ∀ (V : Y.Etale) (s : J.obj.obj (Opposite.op V)),
      Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        J.obj.map g.op s = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y V →
      Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        J.obj.map g.op (-s) = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y V := by
    intro V s hs
    refine GrothendieckTopology.superset_covering _ ?_ hs
    intro V'' f hf
    rcases L1 J.obj V s V'' f hf with h1 | h1
    · exact Sieve.le_generate _ _ _ (Or.inl (by rw [map_neg, h1, neg_zero]))
    · exact Sieve.le_generate _ _ _ (Or.inr h1)
  have hres : ∀ {V V₁ : Y.Etale} (h : V₁ ⟶ V) (s : J.obj.obj (Opposite.op V)),
      Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
        J.obj.map g.op s = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y V →
      Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V₁) =>
        J.obj.map g.op (J.obj.map h.op s) = 0 ∨ ∀ x, V'.hom x ∈ W) ∈
          Scheme.smallEtaleTopology Y V₁ := by
    intro V V₁ h s hs
    refine GrothendieckTopology.superset_covering _ ?_
      (GrothendieckTopology.pullback_stable _ h hs)
    intro V'' f hf
    rcases L1 J.obj V s V'' (f ≫ h) hf with h1 | h1
    · refine Sieve.le_generate _ _ _ (Or.inl ?_)
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp]
      exact h1
    · exact Sieve.le_generate _ _ _ (Or.inr h1)

  let S : ∀ U : (Y.Etale)ᵒᵖ, AddSubgroup (J.obj.obj U) := fun U =>
    { carrier := {s | Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ U.unop) =>
          J.obj.map g.op s = 0 ∨ ∀ x, V'.hom x ∈ W) ∈ Scheme.smallEtaleTopology Y U.unop}
      zero_mem' := hzero U.unop
      add_mem' := fun {a b} ha hb => hadd U.unop a b ha hb
      neg_mem' := fun {a} ha => hneg U.unop a ha }
  let P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    { obj := fun U => AddCommGrpCat.of (S U)
      map := fun {U U'} g => AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
        ((J.obj.map g).hom.comp (S U).subtype) (S U') (fun x => hres g.unop x.1 x.2))
      map_id := fun U => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply Subtype.ext
        change J.obj.map (𝟙 U) x.1 = x.1
        rw [J.obj.map_id]
        rfl
      map_comp := fun {U U' U''} f g => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply Subtype.ext
        change J.obj.map (f ≫ g) x.1 = J.obj.map g (J.obj.map f x.1)
        rw [J.obj.map_comp]
        rfl }
  let α : P ⟶ J.obj :=
    { app := fun U => AddCommGrpCat.ofHom (S U).subtype
      naturality := fun _ _ _ => rfl }
  haveI : ∀ U, Mono (α.app U) := fun U =>
    (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
  haveI : Mono α := NatTrans.mono_of_mono_app α
  refine ⟨(presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P,
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map α ≫
      (sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).counit.app J,
    inferInstance, ?_, ?_⟩
  ·
    intro V s
    let η := toSheafify (Scheme.smallEtaleTopology Y) P
    have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) η :=
      Presheaf.isLocallySurjective_toSheafify' _ _
    have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) η s
    refine GrothendieckTopology.transitive _ hI _ ?_
    intro V₁ g hg
    obtain ⟨t, ht⟩ := hg
    have htQ := t.2
    refine GrothendieckTopology.superset_covering _ ?_ htQ
    intro V₂ k hk
    rcases L1 J.obj V₁ t.1 V₂ k hk with h1 | h1
    · refine Sieve.le_generate _ _ _ (Or.inl ?_)
      have e1 : P.map k.op t = 0 := Subtype.ext h1
      change (sheafify (Scheme.smallEtaleTopology Y) P).map (k ≫ g).op s = 0
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, ← ht,
        ← NatTrans.naturality_apply η k.op t, e1, map_zero]
    · exact Sieve.le_generate _ _ _ (Or.inr h1)
  ·
    intro G φ hG
    have hφQ : ∀ (U : (Y.Etale)ᵒᵖ) (s : G.obj.obj U), φ.hom.app U s ∈ S U := by
      intro U s
      refine GrothendieckTopology.superset_covering _ ?_ (hG U.unop s)
      intro V'' f hf
      obtain ⟨V', a, g, hg, rfl⟩ := hf
      refine ⟨V', a, g, ?_, rfl⟩
      rcases hg with h | h
      · left
        rw [← NatTrans.naturality_apply φ.hom, h, map_zero]
      · right; exact h
    let ψ : G.obj ⟶ P :=
      { app := fun U => AddCommGrpCat.ofHom
          (AddMonoidHom.codRestrict (φ.hom.app U).hom (S U) (fun s => hφQ U s))
        naturality := fun U U' g => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro x
          apply Subtype.ext
          exact NatTrans.naturality_apply φ.hom g x }
    have hψ : ψ ≫ α = φ.hom := by
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      rfl
    have hnat : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map φ.hom ≫
        (sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).counit.app J =
        (sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).counit.app G ≫
          φ :=
      (sheafificationAdjunction (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).counit_naturality φ
    refine ⟨inv ((sheafificationAdjunction (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).counit.app G) ≫
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map ψ, ?_⟩
    rw [Category.assoc, ← Functor.map_comp_assoc, hψ, hnat, IsIso.inv_hom_id_assoc]

theorem wc_et_quot_kernel_iff_supp : ∀ (Y : Scheme.{u}) (W : Set Y)
    (J J' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ι : J' ⟶ J), Mono ι →
    wcSuppIn Y W J' →
    (∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : G ⟶ J),
        wcSuppIn Y W G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ) →
    ∀ (V : Y.Etale) (b : J.obj.obj (Opposite.op V)),
      ((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom b = 0 ↔ wcSuppSec Y W J V b :=
by
  intro Y W J J' ι hmono hsupp huniv
  classical

  have s3 : ∀ (V : Y.Etale), (∀ x, V.hom x ∈ W) → ∀ c : J.obj.obj (Opposite.op V),
      ∃ a : J'.obj.obj (Opposite.op V), (ι.hom.app (Opposite.op V)).hom a = c := by
    let Psub : ∀ V : Y.Etale, AddSubgroup (J.obj.obj (Opposite.op V)) :=
      fun V => ⨆ (_ : ∀ x, V.hom x ∈ W), ⊤
    have hres : ∀ {V V' : Y.Etale} (g : V' ⟶ V),
        Psub V ≤ (Psub V').comap (J.obj.map g.op).hom := by
      intro V V' g
      apply iSup_le
      intro hp
      have hp' : ∀ x, V'.hom x ∈ W := fun x => by
        rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact hp _
      intro y _
      show (J.obj.map g.op).hom y ∈ (⨆ (_ : ∀ x, V'.hom x ∈ W),
        (⊤ : AddSubgroup (J.obj.obj (Opposite.op V'))))
      rw [iSup_pos hp']
      exact AddSubgroup.mem_top _
    let P : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      { obj := fun V => AddCommGrpCat.of (Psub V.unop)
        map := fun {V V'} g => AddCommGrpCat.ofHom
          (((J.obj.map g).hom.comp (Psub V.unop).subtype).codRestrict (Psub V'.unop)
            (fun x => hres g.unop x.2))
        map_id := fun V => by
          ext x
          simp
        map_comp := fun f g => by
          ext x
          simp
          rfl }
    let α : P ⟶ J.obj :=
      { app := fun V => AddCommGrpCat.ofHom (Psub V.unop).subtype
        naturality := fun _ _ _ => rfl }
    let η := toSheafify (Scheme.smallEtaleTopology Y) P
    have hG : wcSuppIn Y W
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P) := by
      intro V s
      have : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) η :=
        Presheaf.isLocallySurjective_toSheafify' _ _
      have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) η s
      refine GrothendieckTopology.superset_covering _ ?_ hI
      intro V' g hg
      obtain ⟨t, ht⟩ := hg
      apply Sieve.le_generate
      by_cases hp : ∀ x, V'.hom x ∈ W
      · exact Or.inr hp
      · left
        have ht0 : t = 0 := by
          obtain ⟨y, hy⟩ := t
          have hy' : y ∈ (⨆ (_ : ∀ x, V'.hom x ∈ W),
              (⊤ : AddSubgroup (J.obj.obj (Opposite.op V')))) := hy
          rw [iSup_neg hp] at hy'
          exact Subtype.ext (AddSubgroup.mem_bot.mp hy')
        have h2 : (sheafify (Scheme.smallEtaleTopology Y) P).map g.op s = 0 := by
          rw [← ht, ht0, map_zero]
        exact h2
    let φ : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P ⟶ J :=
      ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology Y) α J.property)
    obtain ⟨φ', hφ'⟩ := huniv _ φ hG
    intro V hV c
    have hc : c ∈ Psub V := by
      show c ∈ (⨆ (_ : ∀ x, V.hom x ∈ W), (⊤ : AddSubgroup (J.obj.obj (Opposite.op V))))
      rw [iSup_pos hV]
      exact AddSubgroup.mem_top c
    refine ⟨(φ'.hom.app (Opposite.op V)).hom ((η.app (Opposite.op V)).hom ⟨c, hc⟩), ?_⟩
    have e : η ≫ φ'.hom ≫ ι.hom = α := by
      have e1 : φ'.hom ≫ ι.hom = φ.hom := congrArg (fun f => f.hom) hφ'
      rw [e1]
      exact toSheafify_sheafifyLift _ _ _
    have := congrArg (fun f : P ⟶ J.obj => (f.app (Opposite.op V)).hom ⟨c, hc⟩) e
    exact this

  have hS : (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hmono inferInstance
  have hsec : ∀ (U : Y.Etale) (b : J.obj.obj (Opposite.op U)),
      (Limits.cokernel.π ι).hom.app (Opposite.op U) b = 0 →
      ∃ a, ι.hom.app (Opposite.op U) a = b := by
    intro U b hb
    have hE := hS.exact.map_of_mono_of_preservesKernel
      (sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op U))
      hS.mono_f inferInstance
    obtain ⟨a, ha⟩ := (ShortComplex.ab_exact_iff _).mp hE b hb
    exact ⟨a, ha⟩
  intro V b
  constructor
  · intro hb
    obtain ⟨a, ha⟩ := hsec V b hb
    refine GrothendieckTopology.superset_covering _ ?_ (hsupp V a)
    rw [Sieve.generate_le_iff]
    intro V' g hg
    apply Sieve.le_generate
    rcases hg with h | h
    · left
      have key : (ι.hom.app (Opposite.op V')).hom ((J'.obj.map g.op).hom a) =
          (J.obj.map g.op).hom ((ι.hom.app (Opposite.op V)).hom a) :=
        NatTrans.naturality_apply ι.hom g.op a
      have h' : (J'.obj.map g.op).hom a = 0 := h
      have ha' : (ι.hom.app (Opposite.op V)).hom a = b := ha
      have : (J.obj.map g.op).hom b = 0 := by
        rw [← ha', ← key, h', map_zero]
      exact this
    · exact Or.inr h
  · intro hR
    have hnat : ∀ (V₁ V₂ : Y.Etale) (a : V₂ ⟶ V₁) (x : J.obj.obj (Opposite.op V₁)),
        ((Limits.cokernel.π ι).hom.app (Opposite.op V₂)).hom ((J.obj.map a.op).hom x) =
          ((Limits.cokernel ι).obj.map a.op).hom
            (((Limits.cokernel.π ι).hom.app (Opposite.op V₁)).hom x) :=
      fun _ _ a x => NatTrans.naturality_apply (Limits.cokernel.π ι).hom a.op x
    have hzero : ∀ (V' : Y.Etale) (g : V' ⟶ V),
        (Sieve.generate (fun (V' : Y.Etale) (g : V' ⟶ V) =>
          J.obj.map g.op b = 0 ∨ ∀ x, V'.hom x ∈ W)).arrows g →
        ((Limits.cokernel ι).obj.map g.op).hom
          (((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom b) = 0 := by
      intro V' g hg
      obtain ⟨V'', h, g', hg', rfl⟩ := hg
      have h1 : ((Limits.cokernel ι).obj.map g'.op).hom
          (((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom b) = 0 := by
        rw [← hnat]
        rcases hg' with h0 | hW
        · have h0' : (J.obj.map g'.op).hom b = 0 := h0
          rw [h0', map_zero]
        · obtain ⟨a, ha⟩ := s3 V'' hW ((J.obj.map g'.op).hom b)
          rw [← ha]
          change ((ι ≫ Limits.cokernel.π ι).hom.app (Opposite.op V'')).hom a = 0
          rw [Limits.cokernel.condition]
          rfl
      rw [op_comp, Functor.map_comp]
      change ((Limits.cokernel ι).obj.map h.op).hom (((Limits.cokernel ι).obj.map g'.op).hom
        (((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom b)) = 0
      rw [h1, map_zero]
    refine (Limits.cokernel ι).isSeparated _ _ hR _ _ (fun V' g hg => ?_)
    have := hzero V' g hg
    rw [map_zero]
    exact this

theorem wc_et_supp_section_vanishing : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u})
    (h : Y ⟶ Spec (.of A)), IsClosedMap h →
    ∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (b : G.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))),
      wcSuppSec Y {y | h y ≠ IsLocalRing.closedPoint A} G (Scheme.Etale.mk (𝟙 Y)) b → b = 0 :=
by
  intro A _ _ Y h hh G b hb
  classical
  have hEtHom : ∀ {P Q : Y.Etale} (c : P ⟶ Q), Etale c.left := by
    intro P Q c
    have hw : c.left ≫ Q.hom = P.hom := MorphismProperty.Over.w c
    have h1 : Etale Q.hom := Q.prop
    have h2 : Etale (c.left ≫ Q.hom) := by rw [hw]; exact P.prop
    exact Etale.of_comp c.left Q.hom
  let T : Y.Etale := Scheme.Etale.mk (𝟙 Y)
  let E : Set T.left := {v | ∃ (V₁ : Y.Etale) (c : V₁ ⟶ T), v ∈ Set.range c.left ∧
    G.obj.map c.op b = 0}
  have hEopen : IsOpen E := by
    rw [isOpen_iff_forall_mem_open]
    rintro v ⟨V₁, c, hv, hc⟩
    haveI := hEtHom c
    exact ⟨Set.range c.left, fun w hw => ⟨V₁, c, hw, hc⟩, c.left.isOpenMap.isOpen_range, hv⟩
  have hvan : ∀ (V₁ : Y.Etale) (c : V₁ ⟶ T), Set.range c.left ⊆ E →
      G.obj.map c.op b = 0 := by
    intro V₁ c hsub
    let S : Sieve V₁ :=
      { arrows := fun D d => G.obj.map d.op (G.obj.map c.op b) = 0
        downward_closed := by
          intro D D' d hd e
          change G.obj.map (e ≫ d).op (G.obj.map c.op b) = 0
          rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
          rw [hd, map_zero] }
    have hS : S ∈ Scheme.smallEtaleTopology Y V₁ := by
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V₁
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro p
      obtain ⟨V₂, c₂, ⟨q₀, hq₀⟩, hc₂⟩ := hsub ⟨p, rfl⟩
      haveI : Etale c₂.left := hEtHom c₂
      haveI : Etale V₁.hom := V₁.prop
      let fst := Limits.pullback.fst c.left c₂.left
      let snd := Limits.pullback.snd c.left c₂.left
      haveI hfst : Etale fst := inferInstance
      let D : Y.Etale := Scheme.Etale.mk (fst ≫ V₁.hom)
      have hw2 : snd ≫ V₂.hom = fst ≫ V₁.hom := by
        rw [← MorphismProperty.Over.w c₂, ← MorphismProperty.Over.w c, ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let π₁ : D ⟶ V₁ := MorphismProperty.Over.homMk fst rfl trivial
      let π₂ : D ⟶ V₂ := MorphismProperty.Over.homMk snd hw2 trivial
      have hcomm : π₁ ≫ c = π₂ ≫ c₂ := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.condition
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback p q₀ hq₀.symm
      have hπ₁ : S.arrows π₁ := by
        change G.obj.map π₁.op (G.obj.map c.op b) = 0
        rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hcomm, op_comp,
          Functor.map_comp, ConcreteCategory.comp_apply, hc₂, map_zero]
      exact ⟨D, π₁, z, hπ₁, hfst, hz1⟩
    have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
      ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj G).2
    exact (hsh S hS).isSeparatedFor.ext (fun D d hd => by
      change G.obj.map d.op (G.obj.map c.op b) = G.obj.map d.op 0
      rw [map_zero]
      exact hd)
  have hfib : ∀ z : Y, h z = IsLocalRing.closedPoint A → z ∈ E := by
    intro z hz
    have hR := hb
    unfold wcSuppSec at hR
    change _ ∈ Scheme.smallGrothendieckTopology @Etale Y T at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨Y₀, g, y, hg, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR z
    obtain ⟨Y', k, g', hg', hcomp⟩ := hg
    have hy' : g'.left (k.left y) = z := by
      rw [← hy, ← hcomp]
      rfl
    rcases hg' with h0 | hW
    · exact ⟨Y', g', ⟨k.left y, hy'⟩, h0⟩
    · exfalso
      have h1 := hW (k.left y)
      have h2 : Y'.hom (k.left y) = z := by
        rw [← MorphismProperty.Over.w g', Scheme.Hom.comp_apply, hy']
        rfl
      rw [h2] at h1
      exact h1 hz
  have hEuniv : ∀ v, v ∈ E := by
    intro x
    by_contra hx
    have hZ : IsClosed Eᶜ := hEopen.isClosed_compl
    have hfZ := hh _ hZ
    have hmem : IsLocalRing.closedPoint A ∈ h '' Eᶜ :=
      (IsLocalRing.specializes_closedPoint (h x)).mem_closed hfZ ⟨x, hx, rfl⟩
    obtain ⟨z, hzE, hz⟩ := hmem
    exact hzE (hfib z hz)
  have h0 := hvan T (𝟙 T) (fun v _ => hEuniv v)
  rw [op_id, G.obj.map_id] at h0
  exact h0

theorem wc_etale_cover_finite_zariski_refinement_affine : ∀ (X : Scheme.{u}), IsAffine X →
    ∀ (n : ℕ) (V : Fin n → X.Etale), (∀ i, CompactSpace (V i).left) →
    (∀ x : X, ∃ i, x ∈ Set.range (V i).hom) →
    ∃ (Y : Scheme.{u}) (p : Y ⟶ X), IsFinite p ∧ Surjective p ∧
      ∃ (k : ℕ) (O : Fin k → Y.Opens) (j : Fin k → Fin n)
        (g : ∀ α, (O α : Scheme.{u}) ⟶ (V (j α)).left),
        (∀ y : Y, ∃ α, y ∈ O α) ∧ ∀ α, g α ≫ (V (j α)).hom = (O α).ι ≫ p :=
by

  have split_one : ∀ (m : ℕ) (A : Type u) [CommRing A] (f : Polynomial A), f.Monic →
      f.natDegree = m →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C), Module.Finite A C ∧
        Function.Injective (algebraMap A C) ∧
        ∃ a : Fin m → C, f.map (algebraMap A C) = ∏ i, (Polynomial.X - Polynomial.C (a i)) := by
    intro m
    induction m with
    | zero =>
      intro A _ f hf hd
      refine ⟨A, inferInstance, Algebra.id A, Module.Finite.self A, fun x y h => h, Fin.elim0, ?_⟩
      rw [Polynomial.eq_one_of_monic_natDegree_zero hf hd]
      simp
    | succ m ih =>
      intro A _ f hf hd
      haveI : Nontrivial A := by
        by_contra hnt
        rw [not_nontrivial_iff_subsingleton] at hnt
        have : f.natDegree = 0 := by
          rw [Subsingleton.elim f 0, Polynomial.natDegree_zero]
        omega
      haveI : Module.Finite A (AdjoinRoot f) := hf.finite_adjoinRoot
      have hinj1 : Function.Injective (algebraMap A (AdjoinRoot f)) := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        by_contra hx0
        have h1 : AdjoinRoot.mk f (Polynomial.C x) = 0 := hx
        rw [AdjoinRoot.mk_eq_zero] at h1
        exact hf.not_dvd_of_natDegree_lt (Polynomial.C_ne_zero.mpr hx0)
          (by rw [Polynomial.natDegree_C]; omega) h1
      haveI : Nontrivial (AdjoinRoot f) := hinj1.nontrivial
      set fb := f.map (AdjoinRoot.of f) with hfb
      have hfbm : fb.Monic := hf.map _
      have hfbd : fb.natDegree = m + 1 := by rw [hfb, hf.natDegree_map, hd]
      have hroot : fb.IsRoot (AdjoinRoot.root f) := AdjoinRoot.isRoot_root f
      set h := fb /ₘ (Polynomial.X - Polynomial.C (AdjoinRoot.root f)) with hh
      have hmul : (Polynomial.X - Polynomial.C (AdjoinRoot.root f)) * h = fb :=
        Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hroot
      have hhm : h.Monic := by
        apply Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C (AdjoinRoot.root f))
        rw [hmul]; exact hfbm
      have hhd : h.natDegree = m := by
        rw [hh, Polynomial.natDegree_divByMonic _ (Polynomial.monic_X_sub_C _), hfbd,
          Polynomial.natDegree_X_sub_C]
        omega
      obtain ⟨C, _, _, hfinC, hinjC, b, hb⟩ := ih (AdjoinRoot f) h hhm hhd
      letI : Algebra A C :=
        ((algebraMap (AdjoinRoot f) C).comp (algebraMap A (AdjoinRoot f))).toAlgebra
      haveI : IsScalarTower A (AdjoinRoot f) C := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      refine ⟨C, inferInstance, inferInstance, Module.Finite.trans (AdjoinRoot f) C,
        hinjC.comp hinj1, Fin.cons (algebraMap (AdjoinRoot f) C (AdjoinRoot.root f)) b, ?_⟩
      have e1 : f.map (algebraMap A C) = fb.map (algebraMap (AdjoinRoot f) C) := by
        rw [hfb, Polynomial.map_map]
        rfl
      rw [e1, ← hmul, Polynomial.map_mul, hb, Fin.prod_univ_succ]
      simp

  have wc_monic_family_splitting_algebra : ∀ (A : Type u) [CommRing A] (N : ℕ)
      (f : Fin N → Polynomial A), (∀ r, (f r).Monic) →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C), Module.Finite A C ∧
        Function.Injective (algebraMap A C) ∧
        ∀ r, ∃ (d : ℕ) (a : Fin d → C),
          (f r).map (algebraMap A C) = ∏ i, (Polynomial.X - Polynomial.C (a i)) := by
    intro A _ N
    induction N with
    | zero =>
      intro f _
      exact ⟨A, inferInstance, Algebra.id A, Module.Finite.self A, fun x y h => h,
        fun r => Fin.elim0 r⟩
    | succ N ih =>
      intro f hf
      obtain ⟨C₁, _, _, hfin1, hinj1, hs1⟩ := ih (fun r => f (Fin.castSucc r)) (fun r => hf _)
      obtain ⟨C₂, _, _, hfin2, hinj2, b, hb⟩ := split_one _ C₁ ((f (Fin.last N)).map
        (algebraMap A C₁)) ((hf _).map _) rfl
      letI : Algebra A C₂ := ((algebraMap C₁ C₂).comp (algebraMap A C₁)).toAlgebra
      haveI : IsScalarTower A C₁ C₂ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      refine ⟨C₂, inferInstance, inferInstance, Module.Finite.trans C₁ C₂, hinj2.comp hinj1, ?_⟩
      intro r
      refine Fin.lastCases ?_ (fun r' => ?_) r
      · refine ⟨_, b, ?_⟩
        rw [← hb, Polynomial.map_map]
        rfl
      · obtain ⟨d, a, ha⟩ := hs1 r'
        refine ⟨d, fun i => algebraMap C₁ C₂ (a i), ?_⟩
        have e : (f (Fin.castSucc r')).map (algebraMap A C₂) =
            ((f (Fin.castSucc r')).map (algebraMap A C₁)).map (algebraMap C₁ C₂) := by
          rw [Polynomial.map_map]; rfl
        rw [e, ha, Polynomial.map_prod]
        simp

  have wc_root_cover_of_split : ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C]
      (P : StandardEtalePair A) (d : ℕ) (a : Fin d → C),
      P.f.map (algebraMap A C) = ∏ i, (Polynomial.X - Polynomial.C (a i)) →
      ∀ (q : Ideal C) [q.IsPrime] (Q : Ideal P.Ring) [Q.IsPrime],
        Q.comap (algebraMap A P.Ring) = q.comap (algebraMap A C) →
        ∃ i, Polynomial.aeval (a i) P.g ∉ q := by
    intro A C _ _ _ P d a ha q _ Q _ hQ
    classical
    by_contra hcon
    push_neg at hcon
    let ψ : A →+* C ⧸ q := (Ideal.Quotient.mk q).comp (algebraMap A C)
    have hfψ : P.f.map ψ = ∏ i, (Polynomial.X - Polynomial.C (Ideal.Quotient.mk q (a i))) := by
      rw [← Polynomial.map_map, ha, Polynomial.map_prod]
      simp
    have hdiv : P.f.map ψ ∣ (P.g ^ d).map ψ := by
      rw [hfψ, Polynomial.map_pow]
      have : (P.g.map ψ) ^ d = ∏ _i : Fin d, P.g.map ψ := by simp
      rw [this]
      apply Finset.prod_dvd_prod_of_dvd
      intro i _
      rw [Polynomial.dvd_iff_isRoot, Polynomial.IsRoot, ← Polynomial.map_map, Polynomial.eval_map,
        Polynomial.eval₂_at_apply, Polynomial.eval_map, ← Polynomial.aeval_def,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hcon i
    set r := (P.g ^ d) %ₘ P.f with hr
    have hrψ : r.map ψ = 0 := by
      rw [hr, Polynomial.map_modByMonic ψ P.monic_f]
      exact (Polynomial.modByMonic_eq_zero_iff_dvd (P.monic_f.map ψ)).mpr hdiv
    let χ : A →+* P.Ring ⧸ Q := (Ideal.Quotient.mk Q).comp (algebraMap A P.Ring)
    have hrχ : r.map χ = 0 := by
      ext n
      rw [Polynomial.coeff_map, Polynomial.coeff_zero]
      have h1 : ψ (r.coeff n) = 0 := by
        rw [← Polynomial.coeff_map, hrψ, Polynomial.coeff_zero]
      have h2 : r.coeff n ∈ q.comap (algebraMap A C) :=
        Ideal.mem_comap.mpr (Ideal.Quotient.eq_zero_iff_mem.mp h1)
      rw [← hQ] at h2
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_comap.mp h2)
    have hmk : ∀ p : Polynomial A, Ideal.Quotient.mk Q (Polynomial.aeval P.X p) =
        (p.map χ).eval (Ideal.Quotient.mk Q P.X) := by
      intro p
      rw [Polynomial.aeval_def, Polynomial.hom_eval₂, Polynomial.eval_map]
    have hX := StandardEtalePair.hasMap_X (P := P)
    have hgd : Polynomial.aeval P.X (P.g ^ d) = Polynomial.aeval P.X r := by
      conv_lhs => rw [← Polynomial.modByMonic_add_div (P.g ^ d) P.f]
      rw [map_add, map_mul, hX.1, zero_mul, add_zero]
    have hmem : Polynomial.aeval P.X (P.g ^ d) ∈ Q := by
      rw [hgd, ← Ideal.Quotient.eq_zero_iff_mem, hmk, hrχ, Polynomial.eval_zero]
    have hunit : IsUnit (Polynomial.aeval P.X (P.g ^ d)) := by
      rw [map_pow]
      exact hX.2.pow d
    exact (Ideal.IsPrime.ne_top ‹Q.IsPrime›) (Ideal.eq_top_of_isUnit_mem _ hmem hunit)

  have wc_affine_etale_standard_pieces : ∀ (X : Scheme.{u}) [IsAffine X] (n : ℕ)
      (V : Fin n → X.Etale), (∀ i, CompactSpace (V i).left) →
      (∀ x : X, ∃ i, x ∈ Set.range (V i).hom) →
      ∃ (N : ℕ) (c : Fin N → Fin n) (P : Fin N → StandardEtalePair Γ(X, ⊤))
        (e : ∀ r, Spec (.of (P r).Ring) ⟶ (V (c r)).left),
        (∀ r, e r ≫ (V (c r)).hom =
          Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (P r).Ring)) ≫ X.isoSpec.inv) ∧
        ∀ x : X, ∃ (r : Fin N) (z : Spec (.of (P r).Ring)),
          (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (P r).Ring)) ≫ X.isoSpec.inv) z
            = x := by
    intro X _ n V hVc hVcov
    classical
    have hpt : ∀ (i : Fin n) (v : (V i).left), ∃ (P : StandardEtalePair Γ(X, ⊤))
        (e : Spec (.of P.Ring) ⟶ (V i).left) (U : (V i).left.Opens), v ∈ U ∧
        (U : Set (V i).left) ⊆ Set.range e ∧
        e ≫ (V i).hom =
          Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) P.Ring)) ≫ X.isoSpec.inv := by
      intro i v
      haveI : Etale (V i).hom := (V i).prop
      obtain ⟨W, hW, hvW, -⟩ := exists_isAffineOpen_mem_and_subset (x := v) (U := ⊤) trivial
      have hle : W ≤ (V i).hom ⁻¹ᵁ ⊤ := le_top
      have het : ((V i).hom.appLE ⊤ W hle).hom.Etale :=
        HasRingHomProperty.appLE @Etale (V i).hom inferInstance ⟨⊤, isAffineOpen_top X⟩
          ⟨W, hW⟩ hle
      letI : Algebra Γ(X, ⊤) Γ((V i).left, W) := ((V i).hom.appLE ⊤ W hle).hom.toAlgebra
      haveI : Algebra.Etale Γ(X, ⊤) Γ((V i).left, W) := het
      let Q := (hW.primeIdealOf ⟨v, hvW⟩).asIdeal
      obtain ⟨b, hbQ, hstd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := Γ(X, ⊤)) Q
      obtain ⟨Pr⟩ := hstd.nonempty_standardEtalePresentation
      let eq1 := Pr.equivRing
      let e : Spec (.of Pr.P.Ring) ⟶ (V i).left :=
        Spec.map (CommRingCat.ofHom (eq1 : Localization.Away b →+* Pr.P.Ring)) ≫
          Spec.map (CommRingCat.ofHom (algebraMap Γ((V i).left, W) (Localization.Away b))) ≫
            hW.fromSpec
      refine ⟨Pr.P, e, (V i).left.basicOpen b, ?_, ?_, ?_⟩
      · rw [← hW.fromSpec_image_basicOpen]
        exact ⟨hW.primeIdealOf ⟨v, hvW⟩, hbQ, hW.fromSpec_primeIdealOf _⟩
      · rw [← hW.fromSpec_image_basicOpen]
        rintro w ⟨y, hy, rfl⟩
        have hy' : y ∈ Set.range (PrimeSpectrum.comap
            (algebraMap Γ((V i).left, W) (Localization.Away b))) := by
          rw [PrimeSpectrum.localization_away_comap_range (Localization.Away b) b]
          exact hy
        obtain ⟨y', rfl⟩ := hy'
        refine ⟨Spec.map (CommRingCat.ofHom (eq1.symm : Pr.P.Ring →+* Localization.Away b)) y',
          ?_⟩
        have hid : Spec.map (CommRingCat.ofHom (eq1.symm : Pr.P.Ring →+* Localization.Away b)) ≫
            Spec.map (CommRingCat.ofHom (eq1 : Localization.Away b →+* Pr.P.Ring)) = 𝟙 _ := by
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
          have : (eq1.symm : Pr.P.Ring →+* Localization.Away b).comp
              (eq1 : Localization.Away b →+* Pr.P.Ring) = RingHom.id _ := by
            ext x; simp
          rw [this]
          exact Spec.map_id _
        show (Spec.map (CommRingCat.ofHom (eq1.symm : Pr.P.Ring →+* Localization.Away b)) ≫ e)
          y' = _
        rw [← Category.assoc, hid, Category.id_comp]
        rfl
      · have h1 : Spec.map ((V i).hom.appLE ⊤ W hle) ≫ X.isoSpec.inv =
            hW.fromSpec ≫ ((V i).hom : (V i).left ⟶ X) := by
          rw [← IsAffineOpen.fromSpec_top]
          exact IsAffineOpen.SpecMap_appLE_fromSpec ((V i).hom : (V i).left ⟶ X)
            (isAffineOpen_top X) hW hle
        show (Spec.map _ ≫ Spec.map _ ≫ hW.fromSpec) ≫ ((V i).hom : (V i).left ⟶ X) = _
        rw [Category.assoc, Category.assoc, ← h1, ← Category.assoc, ← Category.assoc,
          ← Spec.map_comp, ← Spec.map_comp]
        congr 2
        ext a
        change eq1 (algebraMap Γ((V i).left, W) (Localization.Away b)
          (algebraMap Γ(X, ⊤) Γ((V i).left, W) a)) = _
        rw [← IsScalarTower.algebraMap_apply, AlgEquiv.commutes]
        rfl
    choose P e U hvU hUr heq using hpt
    have hfin : ∀ i, ∃ t : Finset (V i).left, ⋃ v ∈ t, (U i v : Set (V i).left) = Set.univ :=
      fun i => CompactSpace.elim_nhds_subcover (fun v => (U i v : Set (V i).left))
        (fun v => (U i v).isOpen.mem_nhds (hvU i v))
    choose t ht using hfin
    let S := (i : Fin n) × {v // v ∈ t i}
    let eqv := Fintype.equivFin S
    refine ⟨Fintype.card S, fun r => (eqv.symm r).1, fun r => P (eqv.symm r).1 (eqv.symm r).2.1,
      fun r => e (eqv.symm r).1 (eqv.symm r).2.1, fun r => heq _ _, ?_⟩
    intro x
    obtain ⟨i, v0, hv0⟩ := hVcov x
    have hv0' : v0 ∈ ⋃ v ∈ t i, (U i v : Set (V i).left) := by rw [ht i]; trivial
    simp only [Set.mem_iUnion] at hv0'
    obtain ⟨v, hvt, hv0U⟩ := hv0'
    have key : ∀ s : S, s = ⟨i, ⟨v, hvt⟩⟩ → ∃ z : Spec (.of (P s.1 s.2.1).Ring),
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (P s.1 s.2.1).Ring)) ≫ X.isoSpec.inv) z
          = x := by
      intro s hs
      subst hs
      obtain ⟨z, hz⟩ := hUr i v hv0U
      refine ⟨z, ?_⟩
      rw [← heq, Scheme.Hom.comp_apply, hz, hv0]
    obtain ⟨r, hr⟩ := eqv.symm.surjective ⟨i, ⟨v, hvt⟩⟩
    exact ⟨r, key (eqv.symm r) hr⟩

  have wc_standard_etale_root_lift : ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C]
      (P : StandardEtalePair A) (x : C), Polynomial.aeval x P.f = 0 →
      ∃ (O : (Spec (.of C)).Opens) (h : (O : Scheme.{u}) ⟶ Spec (.of P.Ring)),
        (∀ q : PrimeSpectrum C, q ∈ O ↔ Polynomial.aeval x P.g ∉ q.asIdeal) ∧
        h ≫ Spec.map (CommRingCat.ofHom (algebraMap A P.Ring)) =
          O.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap A C)) := by
    intro A C _ _ _ P x hx
    have hmap : P.HasMap (algebraMap C (Localization.Away (Polynomial.aeval x P.g)) x) := by
      constructor
      · rw [Polynomial.aeval_algebraMap_apply, hx, map_zero]
      · rw [Polynomial.aeval_algebraMap_apply]
        exact IsLocalization.Away.algebraMap_isUnit _
    have hcomp : (P.lift _ hmap).toRingHom.comp (algebraMap A P.Ring) =
        (algebraMap C (Localization.Away (Polynomial.aeval x P.g))).comp (algebraMap A C) := by
      rw [← IsScalarTower.algebraMap_eq A C]
      exact AlgHom.comp_algebraMap (P.lift _ hmap)
    refine ⟨PrimeSpectrum.basicOpen (Polynomial.aeval x P.g),
      (basicOpenIsoSpecAway (R := CommRingCat.of C) (Polynomial.aeval x P.g)).hom ≫
        Spec.map (CommRingCat.ofHom (P.lift _ hmap).toRingHom),
      fun q => PrimeSpectrum.mem_basicOpen _ _, ?_⟩
    rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp, CommRingCat.ofHom_comp,
      Spec.map_comp, ← Category.assoc, basicOpenIsoSpecAway_hom_SpecMap]

  intro X hX n V hVc hVcov
  classical
  haveI := hX
  obtain ⟨N, c, P, e, he, hcov⟩ := wc_affine_etale_standard_pieces X n V hVc hVcov
  obtain ⟨C, _, _, hfin, hinj, hsplit⟩ := wc_monic_family_splitting_algebra Γ(X, ⊤) N
    (fun r => (P r).f) (fun r => (P r).monic_f)
  choose d a ha using hsplit
  have hroot : ∀ r i, Polynomial.aeval (a r i) (P r).f = 0 := by
    intro r i
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ha r, Polynomial.eval_prod]
    exact Finset.prod_eq_zero (Finset.mem_univ i) (by simp)
  choose O h hO hh using fun r i =>
    wc_standard_etale_root_lift Γ(X, ⊤) C (P r) (a r i) (hroot r i)
  let E := finSigmaFinEquiv (n := d)
  haveI hpf : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) C))) := by
    rw [IsFinite.SpecMap_iff]
    exact RingHom.finite_algebraMap.mpr hfin
  haveI hps : Surjective (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) C))) := by
    apply (surjective_iff _).mpr
    haveI : FaithfulSMul Γ(X, ⊤) C := (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
    haveI : Algebra.IsIntegral Γ(X, ⊤) C := Algebra.IsIntegral.of_finite _ _
    exact Algebra.IsIntegral.comap_surjective Γ(X, ⊤) C
  refine ⟨Spec (.of C), Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) C)) ≫ X.isoSpec.inv,
    inferInstance, inferInstance, ∑ r, d r, fun α => O (E.symm α).1 (E.symm α).2,
    fun α => c (E.symm α).1, fun α => h (E.symm α).1 (E.symm α).2 ≫ e (E.symm α).1, ?_, ?_⟩
  · intro y
    obtain ⟨r, z, hz⟩ := hcov ((Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) C)) ≫
      X.isoSpec.inv) y)
    have hz' : (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (P r).Ring))) z =
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) C))) y := by
      have h1 := congrArg X.isoSpec.hom hz
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Category.assoc, Category.assoc,
        Iso.inv_hom_id, Category.comp_id, Category.comp_id] at h1
      exact h1
    have hQ : z.asIdeal.comap (algebraMap Γ(X, ⊤) (P r).Ring) =
        y.asIdeal.comap (algebraMap Γ(X, ⊤) C) := congrArg PrimeSpectrum.asIdeal hz'
    haveI : y.asIdeal.IsPrime := PrimeSpectrum.isPrime y
    haveI : z.asIdeal.IsPrime := PrimeSpectrum.isPrime z
    obtain ⟨i, hi⟩ := wc_root_cover_of_split Γ(X, ⊤) C (P r) (d r) (a r)
      (ha r) y.asIdeal z.asIdeal hQ
    refine ⟨E ⟨r, i⟩, ?_⟩
    have hs : E.symm (E ⟨r, i⟩) = ⟨r, i⟩ := E.symm_apply_apply _
    show y ∈ O (E.symm (E ⟨r, i⟩)).1 (E.symm (E ⟨r, i⟩)).2
    rw [hs]
    exact (hO r i y).mpr hi
  · intro α
    rw [Category.assoc, he, reassoc_of% (hh (E.symm α).1 (E.symm α).2)]

theorem wc_finite_surjective_extend_from_qc_open : ∀ (X : Scheme.{u}), CompactSpace X →
    QuasiSeparatedSpace X → ∀ (U : X.Opens), IsCompact (U : Set X) →
    ∀ (V : Scheme.{u}) (q : V ⟶ (U : Scheme.{u})), IsFinite q → Surjective q →
    ∃ (Y : Scheme.{u}) (p : Y ⟶ X) (ι : V ⟶ Y), IsFinite p ∧ Surjective p ∧
      IsOpenImmersion ι ∧ ι ≫ p = q ≫ U.ι ∧ Set.range ι = p ⁻¹' (U : Set X) :=
by
  open Limits in
  · have s_alg : ∀ {R B R' B' : Type u} [CommRing R] [CommRing B] [CommRing R'] [CommRing B'] [Algebra R B] [Algebra R R'] [Algebra B B'] (h : R) [IsLocalization.Away h R'] [IsLocalization.Away (algebraMap R B h) B'] (g : R' →+* B'), g.comp (algebraMap R R') = (algebraMap B B').comp (algebraMap R B) → g.Finite → ∃ G : Finset B, (∀ x ∈ G, IsIntegral R x) ∧ ∀ b : B, ∃ n : ℕ, algebraMap R B h ^ n * b ∈ Algebra.adjoin R (G : Set B) := by
      intro R B R' B' _ _ _ _ _ _ _ h _ _ g hg hgfin
      classical
      have hgx : ∀ x, g (algebraMap R R' x) = algebraMap B B' (algebraMap R B x) :=
        fun x => RingHom.congr_fun hg x
      letI : Algebra R' B' := g.toAlgebra
      letI : Algebra R B' := ((algebraMap B B').comp (algebraMap R B)).toAlgebra
      haveI : IsScalarTower R R' B' := IsScalarTower.of_algebraMap_eq (fun x => (hgx x).symm)
      haveI : IsScalarTower R B B' := IsScalarTower.of_algebraMap_eq (fun x => rfl)
      haveI hfin : Module.Finite R' B' := hgfin
      have lift : ∀ y : B, IsIntegral R (algebraMap B B' y) →
          ∃ M : ℕ, IsIntegral R (algebraMap R B h ^ M * y) := by
        intro y hy
        obtain ⟨p, hpm, hp⟩ := hy
        have h1 : algebraMap B B' (Polynomial.aeval y p) = 0 := by
          rw [← Polynomial.aeval_algebraMap_apply, Polynomial.aeval_def]; exact hp
        obtain ⟨⟨m, hm⟩, hm0⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers (algebraMap R B h)) B' _).mp h1
        obtain ⟨M, rfl⟩ := hm
        rcases subsingleton_or_nontrivial R with hR | hR
        · haveI : Subsingleton B := subsingleton_of_zero_eq_one (by
            rw [← map_zero (algebraMap R B), ← map_one (algebraMap R B), Subsingleton.elim (0 : R) 1])
          refine ⟨M, ?_⟩
          rw [Subsingleton.elim (algebraMap R B h ^ M * y) (algebraMap R B 0)]
          exact isIntegral_algebraMap
        refine ⟨M, (p * Polynomial.X).scaleRoots (h ^ M),
          (Polynomial.monic_scaleRoots_iff _).mpr (hpm.mul Polynomial.monic_X), ?_⟩
        have e1 : algebraMap R B h ^ M * y = algebraMap R B (h ^ M) * y := by rw [map_pow]
        rw [e1, Polynomial.scaleRoots_eval₂_mul, Polynomial.natDegree_mul_X hpm.ne_zero,
          Polynomial.eval₂_mul_X, ← Polynomial.aeval_def, map_pow]
        have hm0' : algebraMap R B h ^ M * Polynomial.aeval y p = 0 := hm0
        calc (algebraMap R B h ^ M) ^ (p.natDegree + 1) * (Polynomial.aeval y p * y)
            = (algebraMap R B h ^ M) ^ p.natDegree * y * (algebraMap R B h ^ M * Polynomial.aeval y p) := by
              ring
          _ = 0 := by rw [hm0', mul_zero]
      obtain ⟨r, s, hs⟩ := Module.Finite.exists_fin (R := R') (M := B')
      have hk : ∀ k, ∃ (x : B) (e : ℕ), IsIntegral R x ∧
          algebraMap B B' x = algebraMap B B' (algebraMap R B h) ^ e * s k := by
        intro k
        obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj (algebraMap R B h) (s k)
        have hint : IsIntegral R' (algebraMap B B' a) := IsIntegral.of_finite R' _
        obtain ⟨⟨m, hm⟩, hmint⟩ :=
          IsIntegral.exists_multiple_integral_of_isLocalization (Submonoid.powers h) _ hint
        obtain ⟨j, rfl⟩ := hm
        have e2 : ((⟨h ^ j, ⟨j, rfl⟩⟩ : Submonoid.powers h) • algebraMap B B' a) =
            algebraMap B B' (algebraMap R B h ^ j * a) := by
          rw [Submonoid.smul_def, Algebra.smul_def]
          simp only [RingHom.algebraMap_toAlgebra, RingHom.comp_apply, map_mul, map_pow]
        rw [e2] at hmint
        obtain ⟨M, hM⟩ := lift _ hmint
        refine ⟨algebraMap R B h ^ M * (algebraMap R B h ^ j * a), M + j + n, hM, ?_⟩
        simp only [map_mul, map_pow]
        rw [← ha]
        ring
      choose x e hxint hxe using hk
      refine ⟨Finset.univ.image x, ?_, ?_⟩
      · intro y hy
        obtain ⟨k, -, rfl⟩ := Finset.mem_image.mp hy
        exact hxint k
      let A := Algebra.adjoin R ((Finset.univ.image x : Finset B) : Set B)
      have hhA : algebraMap R B h ∈ A := A.algebraMap_mem h
      have hP : ∀ y : B', ∃ n : ℕ, ∃ z ∈ A,
          algebraMap B B' (algebraMap R B h) ^ n * y = algebraMap B B' z := by
        intro y
        have hy : y ∈ Submodule.span R' (Set.range s) := by rw [hs]; trivial
        induction hy using Submodule.span_induction with
        | mem y hy =>
          obtain ⟨k, rfl⟩ := hy
          refine ⟨e k, x k, Algebra.subset_adjoin ?_, (hxe k).symm⟩
          exact Finset.mem_coe.mpr (Finset.mem_image_of_mem x (Finset.mem_univ k))
        | zero => exact ⟨0, 0, A.zero_mem, by simp⟩
        | add y₁ y₂ _ _ h₁ h₂ =>
          obtain ⟨n₁, z₁, hz₁, e₁⟩ := h₁
          obtain ⟨n₂, z₂, hz₂, e₂⟩ := h₂
          refine ⟨n₁ + n₂, algebraMap R B h ^ n₂ * z₁ + algebraMap R B h ^ n₁ * z₂,
            A.add_mem (A.mul_mem (A.pow_mem hhA _) hz₁) (A.mul_mem (A.pow_mem hhA _) hz₂), ?_⟩
          simp only [map_add, map_mul, map_pow]
          rw [← e₁, ← e₂]
          ring
        | smul r' y _ h₁ =>
          obtain ⟨n, z, hz, e₁⟩ := h₁
          obtain ⟨k, a, ha⟩ := IsLocalization.Away.surj h r'
          refine ⟨n + k, algebraMap R B a * z, A.mul_mem (A.algebraMap_mem a) hz, ?_⟩
          rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra, map_mul, ← e₁, ← hgx a, ← ha, map_mul,
            map_pow, hgx h]
          ring
      intro b
      obtain ⟨n, z, hz, hnz⟩ := hP (algebraMap B B' b)
      have h2 : algebraMap B B' (algebraMap R B h ^ n * b) = algebraMap B B' z := by
        rw [map_mul, map_pow]; exact hnz
      obtain ⟨m, hm⟩ := IsLocalization.Away.exists_of_eq (algebraMap R B h) h2
      refine ⟨m + n, ?_⟩
      rw [pow_add, mul_assoc, hm]
      exact A.mul_mem (A.pow_mem hhA _) hz
    have s_basic_iso : ∀ (T : Scheme.{u}), CompactSpace T → QuasiSeparatedSpace T → ∀ (A : CommRingCat.{u}) (ψ : A ⟶ Γ(T, ⊤)), Function.Injective ψ → ∀ (c : A), IsAffineOpen (T.basicOpen (ψ c)) → (∀ b : Γ(T, ⊤), ∃ (k : ℕ) (a : A), ψ c ^ k * b = ψ a) → (T.toSpecΓ ≫ Spec.map ψ) ⁻¹ᵁ PrimeSpectrum.basicOpen c = T.basicOpen (ψ c) ∧ IsIso ((T.toSpecΓ ≫ Spec.map ψ) ∣_ PrimeSpectrum.basicOpen c) := by
      intro T hTc hTq A ψ hψ c hTcaff hpow
      have key : ∀ Dc : (Spec A).Opens, Dc = PrimeSpectrum.basicOpen c →
          (T.toSpecΓ ≫ Spec.map ψ) ⁻¹ᵁ Dc = T.basicOpen (ψ c) ∧
            IsIso ((T.toSpecΓ ≫ Spec.map ψ) ∣_ Dc) := by
        intro Dc hDc
        have hmem : ∀ z : Spec A, z ∈ Dc ↔ c ∉ z.asIdeal := by
          intro z; subst hDc; exact Iff.rfl
        have hpre : (T.toSpecΓ ≫ Spec.map ψ) ⁻¹ᵁ Dc = T.basicOpen (ψ c) := by
          have e2 := Scheme.toSpecΓ_preimage_basicOpen T (ψ c)
          rw [← e2]
          ext t
          show (T.toSpecΓ ≫ Spec.map ψ) t ∈ Dc ↔ T.toSpecΓ t ∈ PrimeSpectrum.basicOpen (ψ c)
          rw [hmem, Scheme.Hom.comp_apply]
          exact Iff.rfl
        refine ⟨hpre, ?_⟩
        haveI hBloc : IsLocalization.Away (ψ c) Γ(T, T.basicOpen (ψ c)) :=
          isLocalization_basicOpen_of_qcqs (U := ⊤) isCompact_univ isQuasiSeparated_univ (ψ c)
        letI : Algebra A Γ(T, T.basicOpen (ψ c)) :=
          (ψ ≫ T.presheaf.map (homOfLE (le_top : T.basicOpen (ψ c) ≤ ⊤)).op).hom.toAlgebra
        have halg : ∀ a, algebraMap A Γ(T, T.basicOpen (ψ c)) a =
            algebraMap Γ(T, ⊤) Γ(T, T.basicOpen (ψ c)) (ψ a) := fun a => rfl
        haveI hAloc : IsLocalization.Away c Γ(T, T.basicOpen (ψ c)) := by
          refine IsLocalization.Away.mk c ?_ ?_ ?_
          · rw [halg]; exact IsLocalization.Away.algebraMap_isUnit (ψ c)
          · intro s
            obtain ⟨n, b, hb⟩ := IsLocalization.Away.surj (ψ c) s
            obtain ⟨k, a, ha⟩ := hpow b
            refine ⟨n + k, a, ?_⟩
            rw [halg, halg, ← ha, map_mul, map_pow, pow_add, ← mul_assoc, hb, mul_comm]
          · intro a a' h
            rw [halg, halg] at h
            obtain ⟨n, hn⟩ := IsLocalization.Away.exists_of_eq (ψ c) h
            refine ⟨n, hψ ?_⟩
            rw [map_mul, map_mul, map_pow]
            exact hn
        let θ : A ⟶ Γ(T, T.basicOpen (ψ c)) :=
          CommRingCat.ofHom (algebraMap A Γ(T, T.basicOpen (ψ c)))
        haveI hθ : IsOpenImmersion (Spec.map θ) := IsOpenImmersion.of_isLocalization c
        have hθr : ∀ z : Spec A, z ∈ Dc → z ∈ Set.range (Spec.map θ) := by
          intro z hz
          rw [hmem] at hz
          have := PrimeSpectrum.localization_away_comap_range Γ(T, T.basicOpen (ψ c)) c
          have hz' : z ∈ Set.range (PrimeSpectrum.comap (algebraMap A Γ(T, T.basicOpen (ψ c)))) := by
            rw [this]; exact hz
          exact hz'
        haveI hiso : IsIso (T.basicOpen (ψ c)).toSpecΓ := by
          rw [← hTcaff.isoSpec_hom]; infer_instance
        have hcomp : (T.basicOpen (ψ c)).ι ≫ (T.toSpecΓ ≫ Spec.map ψ) =
            (T.basicOpen (ψ c)).toSpecΓ ≫ Spec.map θ := by
          rw [← Category.assoc, ← Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_top, Category.assoc,
            ← Spec.map_comp]
          rfl
        have hmain : ((T.toSpecΓ ≫ Spec.map ψ) ∣_ Dc) ≫ Dc.ι =
            (T.isoOfEq hpre).hom ≫ (T.basicOpen (ψ c)).toSpecΓ ≫ Spec.map θ := by
          rw [morphismRestrict_ι, ← Scheme.isoOfEq_hom_ι T hpre, Category.assoc, hcomp]
        haveI : IsOpenImmersion (((T.toSpecΓ ≫ Spec.map ψ) ∣_ Dc) ≫ Dc.ι) := by
          rw [hmain]; infer_instance
        haveI : IsOpenImmersion ((T.toSpecΓ ≫ Spec.map ψ) ∣_ Dc) :=
          IsOpenImmersion.of_comp _ Dc.ι
        rw [isIso_iff_isOpenImmersion_and_surjective]
        refine ⟨inferInstance, ⟨fun w => ?_⟩⟩
        obtain ⟨z, hz⟩ := hθr w.1 w.2
        obtain ⟨y, hy⟩ := (inferInstance : Surjective (T.basicOpen (ψ c)).toSpecΓ).surj z
        have hyT : (T.basicOpen (ψ c)).ι y ∈ (T.toSpecΓ ≫ Spec.map ψ) ⁻¹ᵁ Dc := by
          rw [hpre]
          have h0 : (T.basicOpen (ψ c)).ι y ∈ Set.range (T.basicOpen (ψ c)).ι := ⟨y, rfl⟩
          rw [Scheme.Opens.range_ι] at h0
          exact h0
        refine ⟨⟨(T.basicOpen (ψ c)).ι y, hyT⟩, Subtype.ext ?_⟩
        refine (morphismRestrict_base_coe _ _ _).trans ?_
        have e := congrArg (fun f => f y) hcomp
        simp only [Scheme.Hom.comp_apply] at e
        show (T.toSpecΓ ≫ Spec.map ψ) ((T.basicOpen (ψ c)).ι y) = _
        rw [Scheme.Hom.comp_apply, e, hy, hz]
      exact key _ rfl
    have s_local_iso : ∀ {T S : Scheme.{u}} (φ : T ⟶ S) (ι : Type u) (D : ι → S.Opens), ⨆ i, φ ⁻¹ᵁ D i = ⊤ → (∀ i, IsIso (φ ∣_ D i)) → IsOpenImmersion φ ∧ Set.range φ = ⋃ i, (D i : Set S) := by
      intro T S φ m D hcov hiso
      have hpt : ∀ t : T, ∃ i, φ t ∈ D i := by
        intro t
        have ht : t ∈ (⨆ i, φ ⁻¹ᵁ D i) := by rw [hcov]; trivial
        obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp ht
        exact ⟨i, hi⟩
      have hrange : Set.range φ = ⋃ i, (D i : Set S) := by
        ext x
        simp only [Set.mem_range, Set.mem_iUnion, SetLike.mem_coe]
        constructor
        · rintro ⟨t, rfl⟩
          exact hpt t
        · rintro ⟨i, hx⟩
          obtain ⟨t', ht'⟩ := (inferInstance : Surjective (φ ∣_ D i)).surj ⟨x, hx⟩
          refine ⟨t'.1, ?_⟩
          rw [← morphismRestrict_base_coe, ht']
      refine ⟨?_, hrange⟩
      let Dsup : S.Opens := ⨆ i, D i
      have hsub : Set.range φ ⊆ Set.range Dsup.ι := by
        rw [hrange, Scheme.Opens.range_ι]
        intro x hx
        simp only [Set.mem_iUnion, SetLike.mem_coe] at hx
        obtain ⟨i, hi⟩ := hx
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩
      let φ' := IsOpenImmersion.lift Dsup.ι φ hsub
      have hfac : φ' ≫ Dsup.ι = φ := IsOpenImmersion.lift_fac _ _ _
      have hiso' : IsIso φ' := by
        refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme)
          (fun i => Dsup.ι ⁻¹ᵁ D i) ?_ ?_
        · rw [← Scheme.Hom.preimage_iSup, Scheme.Opens.ι_preimage_self]
        · intro i
          have hle : D i ≤ Dsup := le_iSup D i
          have e : φ' ⁻¹ᵁ (Dsup.ι ⁻¹ᵁ D i) = φ ⁻¹ᵁ D i := by
            rw [← Scheme.Hom.comp_preimage, hfac]
          have key : (φ' ∣_ (Dsup.ι ⁻¹ᵁ D i)) ≫ (Scheme.Opens.isoOfLE hle).hom =
              (T.isoOfEq e).hom ≫ (φ ∣_ D i) := by
            rw [← cancel_mono (D i).ι, Category.assoc, Category.assoc, Scheme.Opens.isoOfLE_hom_ι,
              morphismRestrict_ι, reassoc_of% (morphismRestrict_ι φ' (Dsup.ι ⁻¹ᵁ D i)), hfac,
              reassoc_of% (Scheme.isoOfEq_hom_ι T e)]
          have h2 : φ' ∣_ (Dsup.ι ⁻¹ᵁ D i) =
              ((T.isoOfEq e).hom ≫ (φ ∣_ D i)) ≫ (Scheme.Opens.isoOfLE hle).inv := by
            rw [← key, Category.assoc, Iso.hom_inv_id, Category.comp_id]
          show IsIso _
          rw [h2]
          infer_instance
