  ·
    intro T s
    let a : Gen := ⟨T, s⟩
    refine ⟨⟨({a}, ∅), fun ρ hρ => by simp at hρ⟩, σ {a} ⟨a, Finset.mem_singleton_self a⟩, ?_⟩
