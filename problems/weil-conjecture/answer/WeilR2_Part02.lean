    wc_abelian_fp_approx_system 𝒯 P K m hK hcop
  letI : SemilatticeSup Λ := hsl
  haveI : Nonempty Λ := hne

  let F : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
    { obj := fun i => Limits.cokernel (g i)
      map := fun {i j} f => Limits.cokernel.desc (g i)
        (p i j (leOfHom f) ≫ Limits.cokernel.π (g j)) (hgp i j (leOfHom f))
      map_id := fun i => by
        rw [← cancel_epi (Limits.cokernel.π (g i))]
        simp only [Limits.cokernel.π_desc, hp1, Category.id_comp, Category.comp_id]
      map_comp := fun {i j k} f f' => by
        rw [← cancel_epi (Limits.cokernel.π (g i))]
        simp only [Limits.cokernel.π_desc, Limits.cokernel.π_desc_assoc, Category.assoc]
        rw [← Category.assoc, hp2] }
  let ψ : ∀ i, F.obj i ⟶ K := fun i => Limits.cokernel.desc (g i) (h i) (hgh i)
  have hcomp : ∀ (i j : Λ) (f : i ⟶ j), F.map f ≫ ψ j = ψ i := by
    intro i j f
    rw [← cancel_epi (Limits.cokernel.π (g i))]
    simp only [F, ψ, Limits.cokernel.π_desc, Limits.cokernel.π_desc_assoc, Category.assoc, hph]
  have hψ : ∀ i, Limits.cokernel.π (g i) ≫ (Iso.refl (F.obj i)).inv ≫ ψ i = h i := by
    intro i
    simp only [F, ψ, Iso.refl_inv, Category.id_comp, Limits.cokernel.π_desc]
  have hmap : ∀ (i j : Λ) (f : i ⟶ j), Limits.cokernel.π (g i) ≫ (Iso.refl (F.obj i)).inv ≫
      F.map f = p i j (leOfHom f) ≫ Limits.cokernel.π (g j) ≫ (Iso.refl (F.obj j)).inv := by
    intro i j f
    simp only [F, Iso.refl_inv, Category.id_comp, Category.comp_id, Limits.cokernel.π_desc]
  obtain ⟨hLa, hLb⟩ := wc_et_fp_system_local_cocone Y K η hη (wc_et_sieve_of_affine_arrows Y) Λ
    (fun i => (U i).1) (fun i => (V i).1) g p h F ψ (fun i => Iso.refl (F.obj i)) hψ hmap
    (fun T hT s => hsurj ⟨T, hT⟩ s) (fun i T hT x hx => hinj i ⟨T, hT⟩ x hx)
  refine ⟨Λ, inferInstance, isFiltered_of_semilatticeSup_nonempty Λ, F, ψ, hcomp, hLa, hLb,
    fun i => ⟨(U i).1, (V i).1, g i, ?_, ?_, ?_, ?_, htor i, ⟨Iso.refl _⟩⟩⟩
  · haveI := (U i).2; infer_instance
  · haveI := (U i).2; infer_instance
  · haveI := (V i).2; infer_instance
  · haveI := (V i).2; infer_instance

theorem wc_et_quot_filtered_system : ∀ (Y : Scheme.{u}) (W : Set Y) (Λ : Type (u+1)) [SmallCategory Λ] (F : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (K : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ψ : ∀ i, F.obj i ⟶ K), (∀ (i j : Λ) (f : i ⟶ j), F.map f ≫ ψ j = ψ i) → (∀ (V : Y.Etale) (s : K.obj.obj (Opposite.op V)), Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op V')), ((ψ i).hom.app (Opposite.op V')).hom t = (K.obj.map h.op).hom s) ∈ Scheme.smallEtaleTopology Y V) → (∀ (i : Λ) (V : Y.Etale) (t : (F.obj i).obj.obj (Opposite.op V)), ((ψ i).hom.app (Opposite.op V)).hom t = 0 → Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op V')).hom (((F.obj i).obj.map h.op).hom t) = 0) ∈ Scheme.smallEtaleTopology Y V) → ∀ (J' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ι : J' ⟶ K), Mono ι → wcSuppIn Y W J' → (∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : G ⟶ K), wcSuppIn Y W G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ) → ∃ (Q : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (cq : ∀ i, Q.obj i ⟶ Limits.cokernel ι), (∀ (i j : Λ) (f : i ⟶ j), Q.map f ≫ cq j = cq i) ∧ (∀ (V : Y.Etale) (s : (Limits.cokernel ι).obj.obj (Opposite.op V)), Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (i : Λ) (t : (Q.obj i).obj.obj (Opposite.op V')), ((cq i).hom.app (Opposite.op V')).hom t = ((Limits.cokernel ι).obj.map h.op).hom s) ∈ Scheme.smallEtaleTopology Y V) ∧ (∀ (i : Λ) (V : Y.Etale) (t : (Q.obj i).obj.obj (Opposite.op V)), ((cq i).hom.app (Opposite.op V)).hom t = 0 → Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (j : Λ) (f : i ⟶ j), ((Q.map f).hom.app (Opposite.op V')).hom (((Q.obj i).obj.map h.op).hom t) = 0) ∈ Scheme.smallEtaleTopology Y V) ∧ ∀ i : Λ, ∃ (F' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιF : F' ⟶ F.obj i) (θ : Q.obj i ≅ Limits.cokernel ιF), Mono ιF ∧ wcSuppIn Y W F' ∧ Limits.cokernel.π ιF ≫ θ.inv ≫ cq i = ψ i ≫ Limits.cokernel.π ι :=
by
  intro Y W Λ _ F K ψ hcomp hLa hLb J' ι hι hsupp huniv

  have CA : ∀ {A B C : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (a : A ⟶ B)
      (b : B ⟶ C) (V : Y.Etale) (x : A.obj.obj (Opposite.op V)),
      ((a ≫ b).hom.app (Opposite.op V)).hom x =
        (b.hom.app (Opposite.op V)).hom ((a.hom.app (Opposite.op V)).hom x) :=
    fun _ _ _ _ => rfl
  have NAT : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (φ : A ⟶ B)
      {V V' : Y.Etale} (h : V' ⟶ V) (x : A.obj.obj (Opposite.op V)),
      (φ.hom.app (Opposite.op V')).hom ((A.obj.map h.op).hom x) =
        (B.obj.map h.op).hom ((φ.hom.app (Opposite.op V)).hom x) :=
    by
      intro A B φ V V' h x
      exact NatTrans.naturality_apply φ.hom (Quiver.Hom.op h) x
  have MC : ∀ (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) {V V' V'' : Y.Etale}
      (h : V' ⟶ V) (g : V'' ⟶ V') (x : A.obj.obj (Opposite.op V)),
      (A.obj.map (g ≫ h).op).hom x = (A.obj.map g.op).hom ((A.obj.map h.op).hom x) := by
    intro A V V' V'' h g x
    rw [op_comp, Functor.map_comp]
    rfl

  have GEN : ∀ {V : Y.Etale} (P : Presieve V) (R : Sieve V),
      Sieve.generate P ∈ Scheme.smallEtaleTopology Y V →
      (∀ ⦃V' : Y.Etale⦄ (g : V' ⟶ V), P g →
        Sieve.pullback g R ∈ Scheme.smallEtaleTopology Y V') →
      R ∈ Scheme.smallEtaleTopology Y V := by
    intro V P R hP hR
    refine GrothendieckTopology.transitive _ hP R ?_
    rintro V' f ⟨Z, e, g, hg, rfl⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ e (hR g hg)
  have LS : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (φ : A ⟶ B), Epi φ →
      ∀ (V : Y.Etale) (s : B.obj.obj (Opposite.op V)),
      Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ t : A.obj.obj (Opposite.op V'),
        (φ.hom.app (Opposite.op V')).hom t = (B.obj.map h.op).hom s) ∈
        Scheme.smallEtaleTopology Y V := by
    intro A B φ hφ V s
    have : Sheaf.IsLocallySurjective φ :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} φ).mpr hφ
    have h := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y) φ.hom s
    refine GrothendieckTopology.superset_covering _ ?_ h
    intro V' g hg
    exact Sieve.le_generate _ _ _ hg

  choose F' ιF hmono hFs huF using fun i => wc_et_max_supported_subsheaf Y W (F.obj i)
  have wF : ∀ (i j : Λ) (f : i ⟶ j), ιF i ≫ F.map f ≫ Limits.cokernel.π (ιF j) = 0 := by
    intro i j f
    obtain ⟨g, hg⟩ := huF j (F' i) (ιF i ≫ F.map f) (hFs i)
    rw [← Category.assoc, ← hg, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]

  obtain ⟨Q, p, hpnat, hθ'⟩ : ∃ (Q : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (p : ∀ i, F.obj i ⟶ Q.obj i), (∀ (i j : Λ) (f : i ⟶ j), p i ≫ Q.map f = F.map f ≫ p j) ∧
      ∀ i : Λ, ∃ θ : Q.obj i ≅ Limits.cokernel (ιF i), Limits.cokernel.π (ιF i) ≫ θ.inv = p i := by
    refine ⟨{ obj := fun i => Limits.cokernel (ιF i)
              map := fun {i j} f => Limits.cokernel.desc (ιF i)
                (F.map f ≫ Limits.cokernel.π (ιF j)) (wF i j f)
              map_id := ?_
              map_comp := ?_ }, fun i => Limits.cokernel.π (ιF i), ?_, ?_⟩
    · intro i
      apply (cancel_epi (Limits.cokernel.π (ιF i))).mp
      simp
    · intro i j k f g
      apply (cancel_epi (Limits.cokernel.π (ιF i))).mp
      simp
    · intro i j f
      exact Limits.cokernel.π_desc _ _ _
    · intro i
      exact ⟨Iso.refl _, Category.comp_id _⟩
  choose θ hθ using hθ'
  have hpepi : ∀ i, Epi (p i) := by
    intro i
    rw [← hθ i]
    infer_instance

  have wψ : ∀ i, ιF i ≫ ψ i ≫ Limits.cokernel.π ι = 0 := by
    intro i
    obtain ⟨φ', hφ'⟩ := huniv (F' i) (ιF i ≫ ψ i) (hFs i)
    rw [← Category.assoc, ← hφ', Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  obtain ⟨cq, hpc⟩ : ∃ cq : ∀ i, Q.obj i ⟶ Limits.cokernel ι,
      ∀ i, p i ≫ cq i = ψ i ≫ Limits.cokernel.π ι := by
    refine ⟨fun i => (θ i).hom ≫ Limits.cokernel.desc (ιF i) (ψ i ≫ Limits.cokernel.π ι) (wψ i),
      fun i => ?_⟩
    dsimp only
    rw [← hθ i, Category.assoc, Iso.inv_hom_id_assoc, Limits.cokernel.π_desc]

  have hqc : ∀ (i j : Λ) (f : i ⟶ j), Q.map f ≫ cq j = cq i := by
    intro i j f
    apply (cancel_epi (p i)).mp
    rw [← Category.assoc, hpnat, Category.assoc, hpc, hpc, ← Category.assoc, hcomp]

  have hW : ∀ (i : Λ) (V : Y.Etale), (∀ y, V.hom y ∈ W) →
      ∀ x : (F.obj i).obj.obj (Opposite.op V), ((p i).hom.app (Opposite.op V)).hom x = 0 := by
    intro i V hV x
    have hs : wcSuppSec Y W (F.obj i) V x := by
      unfold wcSuppSec
      exact GrothendieckTopology.superset_covering _
        (top_le_iff.mpr (Sieve.id_mem_iff_eq_top.mp (Sieve.le_generate _ _ _ (Or.inr hV))))
        (GrothendieckTopology.top_mem _ V)
    have h0 := (wc_et_quot_kernel_iff_supp Y W (F.obj i) (F' i) (ιF i) (hmono i) (hFs i) (huF i)
      V x).mpr hs
    rw [← hθ i, CA, h0, map_zero]

  have hQa : ∀ (V : Y.Etale) (s : (Limits.cokernel ι).obj.obj (Opposite.op V)),
      Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (i : Λ)
        (t : (Q.obj i).obj.obj (Opposite.op V')),
        ((cq i).hom.app (Opposite.op V')).hom t = ((Limits.cokernel ι).obj.map h.op).hom s) ∈
        Scheme.smallEtaleTopology Y V := by
    intro V s
    apply GEN _ _ (LS (Limits.cokernel.π ι) inferInstance V s)
    rintro V' h ⟨k, hk⟩
    refine GrothendieckTopology.superset_covering _ ?_ (hLa V' k)
    rw [Sieve.generate_le_iff]
    rintro V'' g ⟨i, t, ht⟩
    show (Sieve.generate _).arrows (g ≫ h)
    apply Sieve.le_generate
    refine ⟨i, ((p i).hom.app (Opposite.op V'')).hom t, ?_⟩
    rw [← CA, hpc i, CA, ht, NAT, hk, MC]

  have hQb : ∀ (i : Λ) (V : Y.Etale) (t : (Q.obj i).obj.obj (Opposite.op V)),
      ((cq i).hom.app (Opposite.op V)).hom t = 0 →
      Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (j : Λ) (f : i ⟶ j),
        ((Q.map f).hom.app (Opposite.op V')).hom (((Q.obj i).obj.map h.op).hom t) = 0) ∈
        Scheme.smallEtaleTopology Y V := by
    intro i V t ht
    apply GEN _ _ (LS (p i) (hpepi i) V t)
    rintro V' h ⟨x, hx⟩
    have h0 : ((Limits.cokernel.π ι).hom.app (Opposite.op V')).hom
        (((ψ i).hom.app (Opposite.op V')).hom x) = 0 := by
      rw [← CA, ← hpc i, CA, hx, NAT, ht, map_zero]
    have hS := (wc_et_quot_kernel_iff_supp Y W K J' ι hι hsupp huniv V' _).mp h0
    unfold wcSuppSec at hS
    apply GEN _ _ hS
    rintro V'' g (hg | hg)
    · have hψ0 : ((ψ i).hom.app (Opposite.op V'')).hom
          (((F.obj i).obj.map g.op).hom x) = 0 := by
        rw [NAT]
        exact hg
      rw [← Sieve.pullback_comp]
      refine GrothendieckTopology.superset_covering _ ?_ (hLb i V'' _ hψ0)
      rw [Sieve.generate_le_iff]
      rintro V''' e ⟨j, f, hf⟩
      show (Sieve.generate _).arrows (e ≫ g ≫ h)
      apply Sieve.le_generate
      refine ⟨j, f, ?_⟩
      rw [MC, MC, ← hx, ← NAT, ← NAT, ← CA, hpnat, CA, hf, map_zero]
    · have hx0 : ((p i).hom.app (Opposite.op V'')).hom (((F.obj i).obj.map g.op).hom x) = 0 :=
        hW i V'' hg _
      rw [← Sieve.pullback_comp]
      refine GrothendieckTopology.superset_covering _ ?_ (GrothendieckTopology.top_mem _ V'')
      intro Z e _
      show (Sieve.generate _).arrows (e ≫ g ≫ h)
      apply Sieve.le_generate
      refine ⟨i, 𝟙 i, ?_⟩
      rw [MC, MC, ← hx, ← NAT, hx0]
      simp only [map_zero]
  exact ⟨Q, cq, hqc, hQa, hQb, fun i => ⟨F' i, ιF i, θ i, hmono i, hFs i, by
    rw [← Category.assoc, hθ i, hpc i]⟩⟩

theorem wc_et_sheaf_colimit_cocone_local : ∀ (Y : Scheme.{u}) (Λ : Type (u+1)) [SmallCategory Λ] [IsFiltered Λ] (F : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), (∀ (V : Y.Etale) (s : (Limits.colimit F).obj.obj (Opposite.op V)), Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op V')), ((Limits.colimit.ι F i).hom.app (Opposite.op V')).hom t = ((Limits.colimit F).obj.map h.op).hom s) ∈ Scheme.smallEtaleTopology Y V) ∧ (∀ (i : Λ) (V : Y.Etale) (t : (F.obj i).obj.obj (Opposite.op V)), ((Limits.colimit.ι F i).hom.app (Opposite.op V)).hom t = 0 → Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op V')).hom (((F.obj i).obj.map h.op).hom t) = 0) ∈ Scheme.smallEtaleTopology Y V) :=
by
  intro Y Λ _ _ F
  let P := F ⋙ sheafToPresheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}
  let E := Limits.colimit.cocone P
  have hE : Limits.IsColimit E := Limits.colimit.isColimit P
  let e := (Sheaf.isColimitSheafifyCocone E hE).coconePointUniqueUpToIso (Limits.colimit.isColimit F)
  let θ : Limits.colimit P ⟶ (Limits.colimit F).obj :=
    toSheafify (Scheme.smallEtaleTopology Y) (Limits.colimit P) ≫ e.hom.hom
  have hcomp : ∀ i, Limits.colimit.ι P i ≫ θ = (Limits.colimit.ι F i).hom := by
    intro i
    have h1 := (Sheaf.isColimitSheafifyCocone E hE).comp_coconePointUniqueUpToIso_hom
      (Limits.colimit.isColimit F) i
    have h2 := congrArg (fun φ => φ.hom) h1
    have h3 := Sheaf.sheafifyCocone_ι_app_val E i
    change _ = ((Limits.colimit.cocone F).ι.app i).hom
    rw [← h2]
    change _ = ((Sheaf.sheafifyCocone E).ι.app i).hom ≫ e.hom.hom
    rw [h3]
    rfl
  have h1s : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) (Limits.colimit P)) :=
    Presheaf.isLocallySurjective_toSheafify' _ _
  have h1i : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y)
      (toSheafify (Scheme.smallEtaleTopology Y) (Limits.colimit P)) :=
    Presheaf.isLocallyInjective_toSheafify' _ _
  haveI hiso : IsIso e.hom.hom := inferInstance
  have hes : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) e.hom.hom := inferInstance
  have hei : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) e.hom.hom := inferInstance
  haveI hs : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology Y) θ := by
    refine @Presheaf.isLocallySurjective_comp _ _ _ _ _ _ _ _ _ _ _ _ _ _ ?_ ?_
    · exact h1s
    · exact hes
  haveI hi : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology Y) θ := by
    refine @Presheaf.isLocallyInjective_comp _ _ _ _ _ _ _ _ _ _ _ _ _ _ ?_ ?_
    · exact h1i
    · exact hei
  have hK : ∀ (i : Λ) (V : Y.Etale) (t : (F.obj i).obj.obj (Opposite.op V)),
      (θ.app (Opposite.op V)).hom (((Limits.colimit.ι P i).app (Opposite.op V)).hom t) =
        ((Limits.colimit.ι F i).hom.app (Opposite.op V)).hom t := by
    intro i V t
    rw [← hcomp i]
    rfl
  have hrep : ∀ V : Y.Etale,
      (∀ x : (Limits.colimit P).obj (Opposite.op V), ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op V)),
        ((Limits.colimit.ι P i).app (Opposite.op V)).hom t = x) ∧
      (∀ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op V)),
        ((Limits.colimit.ι P i).app (Opposite.op V)).hom t = 0 →
        ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op V)).hom t = 0) := by
    intro V
    let G := P ⋙ (evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)
    have hc := Limits.isColimitOfPreserves
      ((evaluation (Y.Etale)ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)) (Limits.colimit.isColimit P)
    constructor
    · intro x
      obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep G hc x
      exact ⟨j, y, hy⟩
    · intro i t ht
      have h0 : ((Limits.colimit.ι P i).app (Opposite.op V)).hom t =
          ((Limits.colimit.ι P i).app (Opposite.op V)).hom 0 := by
        rw [ht, map_zero]
      obtain ⟨k, f, g, hfg⟩ := (Limits.Concrete.isColimit_rep_eq_iff_exists G hc t 0).mp h0
      refine ⟨k, f, ?_⟩
      have hfg' : ((F.map f).hom.app (Opposite.op V)).hom t =
          ((F.map g).hom.app (Opposite.op V)).hom 0 := hfg
      rw [hfg', map_zero]
  constructor
  · intro V s
    apply GrothendieckTopology.superset_covering _ _ (Presheaf.imageSieve_mem _ θ s)
    intro V' h hh
    obtain ⟨x, hx⟩ := hh
    obtain ⟨i, t, ht⟩ := (hrep V').1 x
    apply Sieve.le_generate
    refine ⟨i, t, ?_⟩
    rw [← hK, ht]
    exact hx
  · intro i V t ht
    have h0 : (θ.app (Opposite.op V)).hom (((Limits.colimit.ι P i).app (Opposite.op V)).hom t) =
        (θ.app (Opposite.op V)).hom 0 := by
      rw [hK, ht, map_zero]
    apply GrothendieckTopology.superset_covering _ _ (Presheaf.equalizerSieve_mem _ θ _ _ h0)
    intro V' h hh
    have hh' : ((Limits.colimit P).map h.op).hom
        (((Limits.colimit.ι P i).app (Opposite.op V)).hom t) =
        ((Limits.colimit P).map h.op).hom 0 := hh
    rw [map_zero] at hh'
    have hnat : ((Limits.colimit.ι P i).app (Opposite.op V')).hom (((F.obj i).obj.map h.op).hom t) =
        ((Limits.colimit P).map h.op).hom (((Limits.colimit.ι P i).app (Opposite.op V)).hom t) := by
      rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply]
      exact congrArg (fun φ => (ConcreteCategory.hom φ) t) ((Limits.colimit.ι P i).naturality h.op)
    obtain ⟨j, f, hf⟩ := (hrep V').2 i _ (hnat.trans hh')
    apply Sieve.le_generate
    exact ⟨j, f, hf⟩

theorem wc_et_local_cocone_colimit_iso : ∀ (Y : Scheme.{u}) (Λ : Type (u+1)) [SmallCategory Λ] (F : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ψ : ∀ i, F.obj i ⟶ G), (∀ (i j : Λ) (f : i ⟶ j), F.map f ≫ ψ j = ψ i) → (∀ (V : Y.Etale) (s : G.obj.obj (Opposite.op V)), Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op V')), ((ψ i).hom.app (Opposite.op V')).hom t = (G.obj.map h.op).hom s) ∈ Scheme.smallEtaleTopology Y V) → (∀ (i : Λ) (V : Y.Etale) (t : (F.obj i).obj.obj (Opposite.op V)), ((ψ i).hom.app (Opposite.op V)).hom t = 0 → Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op V')).hom (((F.obj i).obj.map h.op).hom t) = 0) ∈ Scheme.smallEtaleTopology Y V) → (∀ (V : Y.Etale) (s : (Limits.colimit F).obj.obj (Opposite.op V)), Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op V')), ((Limits.colimit.ι F i).hom.app (Opposite.op V')).hom t = ((Limits.colimit F).obj.map h.op).hom s) ∈ Scheme.smallEtaleTopology Y V) → ∃ e : Limits.colimit F ≅ G, ∀ i, Limits.colimit.ι F i ≫ e.hom = ψ i :=
by
  intro Y Λ _ F G ψ hc hLCa hLCb hLCcol
  let c : Limits.Cocone F :=
    { pt := G
      ι := { app := ψ
             naturality := fun i j f => (hc i j f).trans (Category.comp_id _).symm } }
  obtain ⟨φ, hφ⟩ : ∃ φ : Limits.colimit F ⟶ G, ∀ i, Limits.colimit.ι F i ≫ φ = ψ i :=
    ⟨Limits.colimit.desc F c, fun i => Limits.colimit.ι_desc c i⟩
  have happ : ∀ (i : Λ) (V : Y.Etale) (t : (F.obj i).obj.obj (Opposite.op V)),
      (φ.hom.app (Opposite.op V)).hom (((Limits.colimit.ι F i).hom.app (Opposite.op V)).hom t) =
        ((ψ i).hom.app (Opposite.op V)).hom t := by
    intro i V t
    rw [← hφ i]
    rfl
  have hker : ∀ (V : Y.Etale) (x : (Limits.colimit F).obj.obj (Opposite.op V)),
      (φ.hom.app (Opposite.op V)).hom x = 0 →
      Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) =>
        ((Limits.colimit F).obj.map h.op).hom x = 0) ∈ Scheme.smallEtaleTopology Y V := by
    intro V x hx
    refine (Scheme.smallEtaleTopology Y).transitive (hLCcol V x) _ ?_
    intro W f hf
    obtain ⟨V', g, h, ⟨i, t, ht⟩, rfl⟩ := hf
    rw [Sieve.pullback_comp]
    refine (Scheme.smallEtaleTopology Y).pullback_stable g ?_
    have hnat : (φ.hom.app (Opposite.op V')).hom (((Limits.colimit F).obj.map h.op).hom x) =
        (G.obj.map h.op).hom ((φ.hom.app (Opposite.op V)).hom x) :=
      NatTrans.naturality_apply φ.hom h.op x
    have hψt : ((ψ i).hom.app (Opposite.op V')).hom t = 0 := by
      rw [← happ, ht, hnat, hx, map_zero]
    refine (Scheme.smallEtaleTopology Y).superset_covering ?_ (hLCb i V' t hψt)
    rw [Sieve.generate_le_iff]
    rintro U k ⟨j, f', hk⟩
    rw [Sieve.pullback_apply]
    apply Sieve.le_generate
    have e1 : ((Limits.colimit F).obj.map (k ≫ h).op).hom x =
        ((Limits.colimit F).obj.map k.op).hom (((Limits.colimit F).obj.map h.op).hom x) := by
      rw [op_comp, Functor.map_comp]
      rfl
    have e2 : ((Limits.colimit.ι F i).hom.app (Opposite.op U)).hom (((F.obj i).obj.map k.op).hom t) =
        ((Limits.colimit F).obj.map k.op).hom (((Limits.colimit.ι F i).hom.app (Opposite.op V')).hom t) :=
      NatTrans.naturality_apply (Limits.colimit.ι F i).hom k.op t
    have e3 : ((Limits.colimit.ι F i).hom.app (Opposite.op U)).hom (((F.obj i).obj.map k.op).hom t) =
        ((Limits.colimit.ι F j).hom.app (Opposite.op U)).hom
          (((F.map f').hom.app (Opposite.op U)).hom (((F.obj i).obj.map k.op).hom t)) := by
      rw [← Limits.colimit.w F f']
      rfl
    show ((Limits.colimit F).obj.map (k ≫ h).op).hom x = 0
    rw [e1, ← ht, ← e2, e3, hk, map_zero]
  have hsurj : Sheaf.IsLocallySurjective φ := by
    refine ⟨fun {V} s => ?_⟩
    refine (Scheme.smallEtaleTopology Y).superset_covering ?_ (hLCa V s)
    rw [Sieve.generate_le_iff]
    rintro V' h ⟨i, t, ht⟩
    rw [Presheaf.imageSieve_apply]
    exact ⟨((Limits.colimit.ι F i).hom.app (Opposite.op V')).hom t, (happ i V' t).trans ht⟩
  have hinj : Sheaf.IsLocallyInjective φ := by
    refine ⟨fun {X} x y hxy => ?_⟩
    induction X with
    | op V =>
      have h0 : (φ.hom.app (Opposite.op V)).hom (x - y) = 0 := by
        rw [map_sub]
        exact sub_eq_zero.mpr hxy
      refine (Scheme.smallEtaleTopology Y).superset_covering ?_ (hker V (x - y) h0)
      rw [Sieve.generate_le_iff]
      intro V' h hh
      rw [Presheaf.equalizerSieve_apply]
      rw [map_sub] at hh
      exact sub_eq_zero.mp hh
  have : IsIso φ := (Sheaf.isLocallyBijective_iff_isIso φ).mp ⟨hinj, hsurj⟩
  exact ⟨asIso φ, fun i => hφ i⟩

theorem wc_et_affine_sections_local_cocone : ∀ (Y : Scheme.{u}) (Λ : Type (u+1)) [SmallCategory Λ] [IsFiltered Λ] (F : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ψ : ∀ i, F.obj i ⟶ G), (∀ (i j : Λ) (f : i ⟶ j), F.map f ≫ ψ j = ψ i) → (∀ (V : Y.Etale) (s : G.obj.obj (Opposite.op V)), Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op V')), ((ψ i).hom.app (Opposite.op V')).hom t = (G.obj.map h.op).hom s) ∈ Scheme.smallEtaleTopology Y V) → (∀ (i : Λ) (V : Y.Etale) (t : (F.obj i).obj.obj (Opposite.op V)), ((ψ i).hom.app (Opposite.op V)).hom t = 0 → Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op V')).hom (((F.obj i).obj.map h.op).hom t) = 0) ∈ Scheme.smallEtaleTopology Y V) → ∀ (U : Y.Etale), IsAffine U.left → (∀ s : G.obj.obj (Opposite.op U), ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op U)), ((ψ i).hom.app (Opposite.op U)).hom t = s) ∧ (∀ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op U)), ((ψ i).hom.app (Opposite.op U)).hom t = 0 → ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op U)).hom t = 0) :=
by
  intro Y Λ _ _ F G ψ hcomp hLa hLb U hU
  classical

  have hnat : ∀ {A B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}} (φ : A ⟶ B)
      {V₁ V₂ : Y.Etale} (h : V₂ ⟶ V₁) (x : A.obj.obj (Opposite.op V₁)),
      (φ.hom.app (Opposite.op V₂)).hom ((A.obj.map h.op).hom x) =
        (B.obj.map h.op).hom ((φ.hom.app (Opposite.op V₁)).hom x) := by
    intro A B φ V₁ V₂ h x
    exact NatTrans.naturality_apply φ.hom h.op x
  have hres : ∀ {A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
      {V₁ V₂ V₃ : Y.Etale} (g : V₃ ⟶ V₂) (h : V₂ ⟶ V₁) (x : A.obj.obj (Opposite.op V₁)),
      (A.obj.map (g ≫ h).op).hom x = (A.obj.map g.op).hom ((A.obj.map h.op).hom x) := by
    intro A V₁ V₂ V₃ g h x
    rw [op_comp, Functor.map_comp]
    rfl
  have hFcomp : ∀ {i j l : Λ} (f : i ⟶ j) (g : j ⟶ l) (V : Y.Etale)
      (x : (F.obj i).obj.obj (Opposite.op V)),
      ((F.map (f ≫ g)).hom.app (Opposite.op V)).hom x =
        ((F.map g).hom.app (Opposite.op V)).hom (((F.map f).hom.app (Opposite.op V)).hom x) := by
    intro i j l f g V x
    rw [Functor.map_comp]
    rfl
  have hψc : ∀ {i j : Λ} (f : i ⟶ j) (V : Y.Etale) (x : (F.obj i).obj.obj (Opposite.op V)),
      ((ψ j).hom.app (Opposite.op V)).hom (((F.map f).hom.app (Opposite.op V)).hom x) =
        ((ψ i).hom.app (Opposite.op V)).hom x := by
    intro i j f V x
    rw [← hcomp i j f]
    rfl

  have hc1 : ∀ (ι : Type) [Finite ι] (j : ι → Λ), ∃ j' : Λ, ∀ a, Nonempty (j a ⟶ j') := by
    intro ι _ j
    let _ := Fintype.ofFinite ι
    obtain ⟨S, hS⟩ := IsFiltered.sup_objs_exists (Finset.univ.image j)
    exact ⟨S, fun a => hS (Finset.mem_image_of_mem _ (Finset.mem_univ a))⟩
  have hc2 : ∀ (ι : Type) [Finite ι] (i : Λ) (j : ι → Λ) (φ : ∀ a, i ⟶ j a),
      ∃ (j' : Λ) (g : i ⟶ j') (h : ∀ a, j a ⟶ j'), ∀ a, φ a ≫ h a = g := by
    intro ι _ i j φ
    let _ := Fintype.ofFinite ι
    let O : Finset Λ := insert i (Finset.univ.image j)
    have hi : i ∈ O := Finset.mem_insert_self _ _
    have hj : ∀ a, j a ∈ O := fun a =>
      Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ a))
    let Hs : Finset ((X : Λ) ×' (Y : Λ) ×' (_ : X ∈ O) ×' (_ : Y ∈ O) ×' (X ⟶ Y)) :=
      Finset.univ.image (fun a => ⟨i, j a, hi, hj a, φ a⟩)
    obtain ⟨S, T, hT⟩ := IsFiltered.sup_exists O Hs
    exact ⟨S, T hi, fun a => T (hj a), fun a =>
      hT hi (hj a) (Finset.mem_image_of_mem _ (Finset.mem_univ a))⟩

  have hcovS : ∀ (V : Y.Etale) (k : ℕ) (W : Fin k → Y.Etale) (f : ∀ a, W a ⟶ V),
      (∀ x : V.left, ∃ a, x ∈ Set.range (f a).left) →
      Sieve.generate (Presieve.ofArrows W f) ∈ Scheme.smallEtaleTopology Y V := by
    intro V k W f hcov
    apply wc_etale_jointly_surjective_covers
    intro v
    obtain ⟨a, ha⟩ := hcov v
    exact ⟨W a, f a, ⟨_, 𝟙 _, f a, Presieve.ofArrows.mk a, Category.id_comp _⟩, ha⟩
  have hsep : ∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale)
      (k : ℕ) (W : Fin k → Y.Etale) (f : ∀ a, W a ⟶ V),
      (∀ x : V.left, ∃ a, x ∈ Set.range (f a).left) →
      ∀ (x y : H.obj.obj (Opposite.op V)),
        (∀ a, (H.obj.map (f a).op).hom x = (H.obj.map (f a).op).hom y) → x = y := by
    intro H V k W f hcov x y hxy
    apply H.isSeparated _ _ (hcovS V k W f hcov) x y
    intro Z e he
    obtain ⟨Z', h, g, hg, rfl⟩ := he
    cases hg with
    | mk a =>
      have e1 := hres (A := H) h (f a) x
      have e2 := hres (A := H) h (f a) y
      change (H.obj.map (h ≫ f a).op).hom x = (H.obj.map (h ≫ f a).op).hom y
      rw [e1, e2, hxy a]
  have hglue : ∀ (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale)
      (k : ℕ) (W : Fin k → Y.Etale) (f : ∀ a, W a ⟶ V),
      (∀ x : V.left, ∃ a, x ∈ Set.range (f a).left) →
      ∀ (w : ∀ a, H.obj.obj (Opposite.op (W a))),
        (∀ σ : Fin 2 → Fin k,
          (H.obj.map (Limits.WidePullback.π (fun l => f (σ l)) 0).op).hom (w (σ 0)) =
            (H.obj.map (Limits.WidePullback.π (fun l => f (σ l)) 1).op).hom (w (σ 1))) →
        ∃ t : H.obj.obj (Opposite.op V), ∀ a, (H.obj.map (f a).op).hom t = w a := by
    intro H V k W f hcov w hw
    have hP : Presieve.IsSheaf (Scheme.smallEtaleTopology Y) (H.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj H).property
    have hSF := (Presieve.isSheafFor_arrows_iff _ f).mp (hP.isSheafFor _ (hcovS V k W f hcov))
    obtain ⟨t, ht, -⟩ := hSF w (by
      intro a b Z ga gb hab
      let σ : Fin 2 → Fin k := ![a, b]
      let fs : ∀ l : Fin 2, Z ⟶ W (σ l) := fun l =>
        Fin.cases (motive := fun l => Z ⟶ W (σ l)) ga
          (fun i => Fin.cases (motive := fun i => Z ⟶ W (σ i.succ)) gb (fun j => j.elim0) i) l
      have hfs : ∀ l, fs l ≫ f (σ l) = ga ≫ f a := by
        intro l
        fin_cases l
        · rfl
        · exact hab.symm
      have h0 : Limits.WidePullback.lift (ga ≫ f a) fs hfs ≫
          Limits.WidePullback.π (fun l => f (σ l)) 0 = ga :=
        Limits.WidePullback.lift_π (fun l => f (σ l)) (ga ≫ f a) fs hfs 0
      have h1 : Limits.WidePullback.lift (ga ≫ f a) fs hfs ≫
          Limits.WidePullback.π (fun l => f (σ l)) 1 = gb :=
        Limits.WidePullback.lift_π (fun l => f (σ l)) (ga ≫ f a) fs hfs 1
      change (H.obj.map ga.op).hom (w a) = (H.obj.map gb.op).hom (w b)
      have e0 := hres (A := H) (Limits.WidePullback.lift (ga ≫ f a) fs hfs)
        (Limits.WidePullback.π (fun l => f (σ l)) 0) (w (σ 0))
      have e1 := hres (A := H) (Limits.WidePullback.lift (ga ≫ f a) fs hfs)
        (Limits.WidePullback.π (fun l => f (σ l)) 1) (w (σ 1))
      rw [h0] at e0
      rw [h1] at e1
      refine e0.trans (Eq.trans ?_ e1.symm)
      rw [hw σ])
    exact ⟨t, ht⟩

  have hinj : ∀ (V : Y.Etale), CompactSpace V.left → ∀ (i : Λ)
      (t : (F.obj i).obj.obj (Opposite.op V)), ((ψ i).hom.app (Opposite.op V)).hom t = 0 →
      ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op V)).hom t = 0 := by
    intro V hV i t ht
    obtain ⟨k, W, f, hR, -, hcov⟩ := wc_et_finite_affine_refinement Y V hV _ (hLb i V t ht)
    have hloc : ∀ a, ∃ (j : Λ) (φ : i ⟶ j), ((F.map φ).hom.app (Opposite.op (W a))).hom
        (((F.obj i).obj.map (f a).op).hom t) = 0 := by
      intro a
      obtain ⟨Z, h, g, ⟨j₀, φ₀, hφ₀⟩, hfa⟩ := hR a
      refine ⟨j₀, φ₀, ?_⟩
      rw [← hfa, hres, hnat, hφ₀, map_zero]
    choose jj φ hφ using hloc
    obtain ⟨j', g, hh, hgh⟩ := hc2 (Fin k) i jj φ
    refine ⟨j', g, ?_⟩
    apply hsep (F.obj j') V k W f hcov
    intro a
    rw [← hnat (F.map g) (f a) t, ← hgh a, hFcomp, hφ a]
    simp only [map_zero]
  have hinjA : ∀ (V : Y.Etale), IsAffine V.left → ∀ (i : Λ)
      (t : (F.obj i).obj.obj (Opposite.op V)), ((ψ i).hom.app (Opposite.op V)).hom t = 0 →
      ∃ (j : Λ) (f : i ⟶ j), ((F.map f).hom.app (Opposite.op V)).hom t = 0 := by
    intro V hV i t ht
    have := hV
    exact hinj V inferInstance i t ht
  refine ⟨fun s => ?_, fun i t ht => hinjA U hU i t ht⟩

  have := hU
  obtain ⟨k, W, f, hR, hWaff, hcov⟩ :=
    wc_et_finite_affine_refinement Y U inferInstance _ (hLa U s)
  have hloc : ∀ a, ∃ (i : Λ) (t : (F.obj i).obj.obj (Opposite.op (W a))),
      ((ψ i).hom.app (Opposite.op (W a))).hom t = (G.obj.map (f a).op).hom s := by
    intro a
    obtain ⟨Z, h, g, ⟨i₀, t₀, ht₀⟩, hfa⟩ := hR a
    refine ⟨i₀, ((F.obj i₀).obj.map h.op).hom t₀, ?_⟩
    rw [hnat, ht₀, ← hres, hfa]
  choose ii tt htt using hloc
  obtain ⟨j, hj⟩ := hc1 (Fin k) ii
  have e : ∀ a, ii a ⟶ j := fun a => (hj a).some
  obtain ⟨uu, huu⟩ : ∃ uu : ∀ a, (F.obj j).obj.obj (Opposite.op (W a)),
      ∀ a, ((ψ j).hom.app (Opposite.op (W a))).hom (uu a) = (G.obj.map (f a).op).hom s :=
    ⟨fun a => ((F.map (e a)).hom.app _).hom (tt a), fun a => (hψc (e a) _ _).trans (htt a)⟩
  have hd : ∀ σ : Fin 2 → Fin k, ∃ (jσ : Λ) (φ : j ⟶ jσ),
      ((F.map φ).hom.app (Opposite.op (Limits.widePullback U (fun l => W (σ l))
        (fun l => f (σ l))))).hom
        (((F.obj j).obj.map (Limits.WidePullback.π (fun l => f (σ l)) 0).op).hom (uu (σ 0)) -
          ((F.obj j).obj.map (Limits.WidePullback.π (fun l => f (σ l)) 1).op).hom (uu (σ 1))) = 0 := by
    intro σ
    apply hinjA _ (wc_et_widePullback_affine Y U W f hU hWaff 1 σ) j
    rw [map_sub, hnat, hnat, huu, huu, ← hres, ← hres,
      Limits.WidePullback.π_arrow (fun l => f (σ l)) 0,
      Limits.WidePullback.π_arrow (fun l => f (σ l)) 1, sub_self]
  choose jσ φσ hφσ using hd
  obtain ⟨j', g, hh, hgh⟩ := hc2 (Fin 2 → Fin k) j jσ φσ
  obtain ⟨t, ht⟩ := hglue (F.obj j') U k W f hcov
    (fun a => ((F.map g).hom.app _).hom (uu a)) (by
      intro σ
      rw [← sub_eq_zero, ← hnat, ← hnat, ← map_sub, ← hgh σ, hFcomp, hφσ σ, map_zero])
  have ht' : ∀ a, ((F.obj j').obj.map (f a).op).hom t =
      ((F.map g).hom.app (Opposite.op (W a))).hom (uu a) := ht
  refine ⟨j', t, ?_⟩
  apply hsep G U k W f hcov
  intro a
  rw [← hnat, ht' a, hψc, huu]

theorem wc_et_functorial_injective_embedding : ∀ (Y : Scheme.{u}) (Λ : Type (u+1)) [SmallCategory Λ] (F : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), ∃ (I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (α : F ⟶ I), Mono α ∧ ∀ i, Injective (I.obj i) :=
by
  intro Y Λ _ F
  haveI : EssentiallySmall.{u+1} Y.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    inferInstance
  let D : ∀ j : Λ, (Σ i : Λ, (j ⟶ i)) → Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
    fun _ p => Injective.under (F.obj p.1)
  have hπ : ∀ (j i : Λ) (a b : j ⟶ i), a = b →
      (Limits.Pi.π (D j) ⟨i, a⟩ : ∏ᶜ (D j) ⟶ Injective.under (F.obj i)) =
        Limits.Pi.π (D j) ⟨i, b⟩ := by
    rintro j i a b rfl
    rfl
  let I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} :=
    { obj := fun j => ∏ᶜ (D j)
      map := fun {j j'} g =>
        Limits.Pi.lift (f := D j') (fun q => Limits.Pi.π (D j) ⟨q.1, g ≫ q.2⟩)
      map_id := by
        intro j
        apply Limits.Pi.hom_ext
        rintro ⟨i, f⟩
        simp only [Limits.Pi.lift_comp_π, Category.id_comp]
        exact hπ _ _ _ _ (Category.id_comp f)
      map_comp := by
        intro j j' j'' g h
        apply Limits.Pi.hom_ext
        rintro ⟨i, f⟩
        simp only [Limits.Pi.lift_comp_π, Category.assoc]
        exact hπ _ _ _ _ (Category.assoc g h f) }
  let α : F ⟶ I :=
    { app := fun j => Limits.Pi.lift (f := D j)
        (fun p => F.map p.2 ≫ Injective.ι (F.obj p.1))
      naturality := by
        intro j j' g
        apply Limits.Pi.hom_ext
        rintro ⟨i, f⟩
        change (F.map g ≫ Limits.Pi.lift (f := D j') (fun p =>
            F.map p.2 ≫ Injective.ι (F.obj p.1))) ≫ Limits.Pi.π (D j') ⟨i, f⟩ =
          (Limits.Pi.lift (f := D j) (fun p => F.map p.2 ≫ Injective.ι (F.obj p.1)) ≫
            Limits.Pi.lift (f := D j') (fun q => Limits.Pi.π (D j) ⟨q.1, g ≫ q.2⟩)) ≫
            Limits.Pi.π (D j') ⟨i, f⟩
        simp only [Category.assoc, Limits.Pi.lift_comp_π, CategoryTheory.Functor.map_comp] }
  have hmono : ∀ j, Mono (α.app j) := by
    intro j
    have h : α.app j ≫ Limits.Pi.π (D j) ⟨j, 𝟙 j⟩ = Injective.ι (F.obj j) := by
      change Limits.Pi.lift (f := D j) (fun p => F.map p.2 ≫ Injective.ι (F.obj p.1)) ≫
        Limits.Pi.π (D j) ⟨j, 𝟙 j⟩ = Injective.ι (F.obj j)
      simp only [Limits.Pi.lift_comp_π, CategoryTheory.Functor.map_id, Category.id_comp]
    exact mono_of_mono_fac h
  haveI := hmono
  refine ⟨I, α, NatTrans.mono_of_mono_app α, fun j => ?_⟩
  haveI : ∀ b, Injective (D j b) := fun b => Injective.injective_under _
  change Injective (∏ᶜ (D j))
  infer_instance

theorem wc_et_affine_colim_injective_acyclic : ∀ (Y : Scheme.{u}) [IsAffine Y] (Λ : Type (u+1)) [SmallCategory Λ] [IsFiltered Λ] (I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), (∀ i, Injective (I.obj i)) → (∀ (U : Y.Etale), IsAffine U.left → (∀ s : (Limits.colimit I).obj.obj (Opposite.op U), ∃ (i : Λ) (t : (I.obj i).obj.obj (Opposite.op U)), ((Limits.colimit.ι I i).hom.app (Opposite.op U)).hom t = s) ∧ (∀ (i : Λ) (t : (I.obj i).obj.obj (Opposite.op U)), ((Limits.colimit.ι I i).hom.app (Opposite.op U)).hom t = 0 → ∃ (j : Λ) (f : i ⟶ j), ((I.map f).hom.app (Opposite.op U)).hom t = 0)) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ (q : ℕ) (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit I) (q + 1)), e = 0 :=
by
  intro Y _ Λ _ _ I hinj Haff
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro q e
  haveI := wc_et_enough_injectives Y

  have hW : ∀ {i j : Λ} (g : i ⟶ j) (Z : Y.Etale) (x : (I.obj i).obj.obj (Opposite.op Z)),
      ((Limits.colimit.ι I j).hom.app (Opposite.op Z)).hom (((I.map g).hom.app (Opposite.op Z)).hom x) =
        ((Limits.colimit.ι I i).hom.app (Opposite.op Z)).hom x := by
    intro i j g Z x
    exact congrArg (fun m => (m.hom.app (Opposite.op Z)).hom x) (Limits.colimit.w I g)

  have hcomp : ∀ {i j l : Λ} (g : i ⟶ j) (g' : j ⟶ l) (Z : Y.Etale) (x : (I.obj i).obj.obj (Opposite.op Z)),
      ((I.map (g ≫ g')).hom.app (Opposite.op Z)).hom x =
        ((I.map g').hom.app (Opposite.op Z)).hom (((I.map g).hom.app (Opposite.op Z)).hom x) := by
    intro i j l g g' Z x
    exact congrArg (fun m => (m.hom.app (Opposite.op Z)).hom x) (I.map_comp g g')

  have s1 : ∀ (R : Type) [Finite R] (Z : R → Y.Etale),
      (∀ (r : R) (s : (Limits.colimit I).obj.obj (Opposite.op (Z r))), ∃ (i : Λ)
        (t : (I.obj i).obj.obj (Opposite.op (Z r))),
        ((Limits.colimit.ι I i).hom.app (Opposite.op (Z r))).hom t = s) →
      ∀ (s : ∀ r, (Limits.colimit I).obj.obj (Opposite.op (Z r))), ∃ (i : Λ)
        (t : ∀ r, (I.obj i).obj.obj (Opposite.op (Z r))),
        ∀ r, ((Limits.colimit.ι I i).hom.app (Opposite.op (Z r))).hom (t r) = s r := by
    intro R _ Z h s
    choose i₀ t₀ ht₀ using fun r => h r (s r)
    haveI := Fintype.ofFinite R
    classical
    obtain ⟨S, hS⟩ := IsFiltered.sup_objs_exists (Finset.univ.image i₀)
    have g : ∀ r, i₀ r ⟶ S := fun r => (hS (Finset.mem_image_of_mem i₀ (Finset.mem_univ r))).some
    exact ⟨S, fun r => ((I.map (g r)).hom.app _).hom (t₀ r), fun r =>
      (hW (g r) (Z r) (t₀ r)).trans (ht₀ r)⟩

  have s2 : ∀ (R : Type) [Finite R] (Z : R → Y.Etale),
      (∀ (r : R) (i : Λ) (t : (I.obj i).obj.obj (Opposite.op (Z r))),
        ((Limits.colimit.ι I i).hom.app (Opposite.op (Z r))).hom t = 0 →
        ∃ (j : Λ) (f : i ⟶ j), ((I.map f).hom.app (Opposite.op (Z r))).hom t = 0) →
      ∀ (i : Λ) (x : ∀ r, (I.obj i).obj.obj (Opposite.op (Z r))),
        (∀ r, ((Limits.colimit.ι I i).hom.app (Opposite.op (Z r))).hom (x r) = 0) →
        ∃ (j : Λ) (φ : i ⟶ j), ∀ r, ((I.map φ).hom.app (Opposite.op (Z r))).hom (x r) = 0 := by
    intro R _ Z h
    haveI := Fintype.ofFinite R
    classical
    have key : ∀ S : Finset R, ∀ (i : Λ) (x : ∀ r, (I.obj i).obj.obj (Opposite.op (Z r))),
        (∀ r, ((Limits.colimit.ι I i).hom.app (Opposite.op (Z r))).hom (x r) = 0) →
        ∃ (j : Λ) (φ : i ⟶ j), ∀ r ∈ S, ((I.map φ).hom.app (Opposite.op (Z r))).hom (x r) = 0 := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        intro i x _
        exact ⟨i, 𝟙 i, fun r hr => by simp at hr⟩
      | insert a S' haS ih =>
        intro i x hx
        obtain ⟨j₁, f₁, hf₁⟩ := h a i (x a) (hx a)
        obtain ⟨j, φ', hφ'⟩ := ih j₁ (fun r => ((I.map f₁).hom.app _).hom (x r))
          (fun r => (hW f₁ (Z r) (x r)).trans (hx r))
        refine ⟨j, f₁ ≫ φ', fun r hr => ?_⟩
        rw [hcomp]
        rcases Finset.mem_insert.mp hr with hra | hr'
        · subst hra
          rw [hf₁, map_zero]
        · exact hφ' r hr'
    intro i x hx
    obtain ⟨j, φ, hφ⟩ := key Finset.univ i x hx
    exact ⟨j, φ, fun r => hφ r (Finset.mem_univ r)⟩

  have hcech : ∀ (U : Y.Etale) (k : ℕ) (V : Fin k → Y.Etale) (f : ∀ i, V i ⟶ U),
      IsAffine U.left → (∀ i, IsAffine (V i).left) → wcCechAcyclic (Limits.colimit I).obj V f := by
    intro U k V f hU hV p c hc

    obtain ⟨i, t, ht⟩ := s1 (Fin (p + 2) → Fin k)
      (fun τ => Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l)))
      (fun τ s => (Haff _ (wc_et_widePullback_affine Y U V f hU hV (p + 1) τ)).1 s) c

    have hx0 : ∀ ρ : Fin (p + 3) → Fin k,
        ((Limits.colimit.ι I i).hom.app
          (Opposite.op (Limits.widePullback U (fun l => V (ρ l)) (fun l => f (ρ l))))).hom
          (∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
            (I.obj i).obj.map (wcCechFace V f ρ j).op (t (fun l => ρ (j.succAbove l)))) = 0 := by
      intro ρ
      refine Eq.trans ?_ (hc ρ)
      rw [map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_zsmul]
      congr 1
      rw [← ht (fun l => ρ (j.succAbove l))]
      exact NatTrans.naturality_apply (Limits.colimit.ι I i).hom (wcCechFace V f ρ j).op _

    obtain ⟨j, φ, hφ⟩ := s2 (Fin (p + 3) → Fin k)
      (fun ρ => Limits.widePullback U (fun l => V (ρ l)) (fun l => f (ρ l)))
      (fun ρ i t ht => (Haff _ (wc_et_widePullback_affine Y U V f hU hV (p + 2) ρ)).2 i t ht)
      i (fun ρ => ∑ j : Fin (p + 3), ((-1 : ℤ) ^ (j : ℕ)) •
            (I.obj i).obj.map (wcCechFace V f ρ j).op (t (fun l => ρ (j.succAbove l)))) hx0

    haveI := hinj j
    obtain ⟨b', hb'⟩ := (wc_injective_cech_acyclic (Scheme.smallEtaleTopology Y) (I.obj j) V f).2 p
      (fun τ => ((I.map φ).hom.app _).hom (t τ)) (by
        intro ρ
        have hφρ := hφ ρ
        beta_reduce at hφρ ⊢
        refine Eq.trans ?_ hφρ
        rw [map_sum]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        rw [map_zsmul]
        congr 1
        exact (NatTrans.naturality_apply (I.map φ).hom (wcCechFace V f ρ l).op _).symm)

    refine ⟨fun σ => ((Limits.colimit.ι I j).hom.app _).hom (b' σ), fun τ => ?_⟩
    have e1 := hb' τ
    beta_reduce at e1 ⊢
    refine Eq.trans ?_ ((congrArg (fun z => ((Limits.colimit.ι I j).hom.app
      (Opposite.op (Limits.widePullback U (fun l => V (τ l)) (fun l => f (τ l))))).hom z) e1).trans
      ((hW φ _ (t τ)).trans (ht τ)))
    beta_reduce
    rw [map_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_zsmul]
    congr 1
    exact (NatTrans.naturality_apply (Limits.colimit.ι I j).hom (wcCechFace V f τ l).op _).symm

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hBT : IsAffine (Scheme.Etale.mk (𝟙 Y)).left := by
    change IsAffine Y
    infer_instance
  have hs := wc_et_cartan_criterion_const Y (fun U => IsAffine U.left)
    (fun U k V f => IsAffine U.left ∧ (∀ i, IsAffine (V i).left) ∧
      ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left)
    (fun U k V f hc => wc_etale_jointly_surjective_covers Y U _ (fun v => by
      obtain ⟨i, hi⟩ := hc.2.2 v
      exact ⟨V i, f i, ⟨_, 𝟙 _, f i, Presieve.ofArrows.mk i, Category.id_comp _⟩, hi⟩))
    (fun U k V f hc p σ => wc_et_widePullback_affine Y U V f hc.1 hc.2.1 p σ)
    (fun U hU R hR => by
      haveI : IsAffine U.left := hU
      obtain ⟨k, V, f, hRf, hV, hsurj⟩ := wc_et_finite_affine_refinement Y U inferInstance R hR
      exact ⟨k, V, f, ⟨hU, hV, hsurj⟩, hRf⟩)
    _ hT hBT (Limits.colimit I) (fun U k V f hc => hcech U k V f hc.1 hc.2.1) q
  exact @Subsingleton.elim _ hs e 0

theorem wc_ext_filtered_colim_lift : ∀ {C : Type (u+2)} [Category.{u+1} C] [Abelian C] [HasExt C] (P : C) (Λ : Type (u+1)) [SmallCategory Λ] [IsFiltered Λ] [Limits.HasColimitsOfShape Λ C] [HasExactColimitsOfShape Λ C], (∀ (F : Λ ⥤ C) (x : Abelian.Ext P (Limits.colimit F) 0), ∃ (i : Λ) (y : Abelian.Ext P (F.obj i) 0), y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι F i)) (add_zero 0) = x) → (∀ F : Λ ⥤ C, ∃ (I : Λ ⥤ C) (α : F ⟶ I), Mono α ∧ ∀ (q : ℕ) (e : Abelian.Ext P (Limits.colimit I) (q + 1)), e = 0) → ∀ (F : Λ ⥤ C) (n : ℕ) (x : Abelian.Ext P (Limits.colimit F) n), ∃ (i : Λ) (y : Abelian.Ext P (F.obj i) n), y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι F i)) (add_zero n) = x :=
by
  intro C _ _ _ P Λ _ _ _ _ H0 Hemb F n
  induction n generalizing F with
  | zero => exact H0 F
  | succ n ih =>
    intro x
    obtain ⟨I, α, hα, hvan⟩ := Hemb F
    let S : ShortComplex (Λ ⥤ C) :=
      ShortComplex.mk α (Limits.cokernel.π α) (Limits.cokernel.condition α)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel α) hα inferInstance
    have hSc : (S.map (Limits.colim : (Λ ⥤ C) ⥤ C)).ShortExact := hS.map_of_exact _
    have h0 : x.comp (Abelian.Ext.mk₀ (S.map (Limits.colim : (Λ ⥤ C) ⥤ C)).f)
        (add_zero (n + 1)) = 0 := hvan n _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hSc x h0 rfl
    obtain ⟨i, η, hη⟩ := ih (Limits.cokernel α) x₃
    have hSi : (S.map ((evaluation Λ C).obj i)).ShortExact := hS.map_of_exact _
    let φ : S.map ((evaluation Λ C).obj i) ⟶ S.map (Limits.colim : (Λ ⥤ C) ⥤ C) :=
      { τ₁ := Limits.colimit.ι F i
        τ₂ := Limits.colimit.ι I i
        τ₃ := Limits.colimit.ι (Limits.cokernel α) i
        comm₁₂ := Limits.colimit.ι_map α i
        comm₂₃ := Limits.colimit.ι_map (Limits.cokernel.π α) i }
    have hnat := hSi.extClass_naturality hSc φ
    refine ⟨i, η.comp hSi.extClass rfl, ?_⟩
    calc (η.comp hSi.extClass rfl).comp (Abelian.Ext.mk₀ (Limits.colimit.ι F i)) (add_zero (n + 1))
        = η.comp (hSi.extClass.comp (Abelian.Ext.mk₀ φ.τ₁) (add_zero 1)) rfl :=
          Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega)
      _ = η.comp ((Abelian.Ext.mk₀ φ.τ₃).comp hSc.extClass (zero_add 1)) rfl := by rw [hnat]
      _ = (η.comp (Abelian.Ext.mk₀ φ.τ₃) (add_zero n)).comp hSc.extClass rfl :=
          (Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega)).symm
      _ = x := by rw [← hx₃]; exact congrArg (fun z => z.comp hSc.extClass rfl) hη

theorem wc_et_quot_ext_fp_approx : ∀ (Y : Scheme.{u}) [IsAffine Y] (W : Set Y), IsOpen W → ∀ (m : ℕ), m ≠ 0 → ∀ (K : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), m • 𝟙 K = 0 → ∀ (J' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ι : J' ⟶ K), Mono ι → wcSuppIn Y W J' → (∀ (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ : G ⟶ K), wcSuppIn Y W G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ) → letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; ∀ (n : ℕ) (ξ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ι) n), ∃ (U V : Y.Etale) (g : (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)), CompactSpace U.left ∧ QuasiSeparatedSpace U.left ∧ CompactSpace V.left ∧ QuasiSeparatedSpace V.left ∧ m • 𝟙 (Limits.cokernel g) = 0 ∧ ∃ (ψ : Limits.cokernel g ⟶ K) (F' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (ιF : F' ⟶ Limits.cokernel g), Mono ιF ∧ wcSuppIn Y W F' ∧ ∃ (cF : Limits.cokernel ιF ⟶ Limits.cokernel ι), Limits.cokernel.π ιF ≫ cF = ψ ≫ Limits.cokernel.π ι ∧ ∃ ζ : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.cokernel ιF) n, ζ.comp (Abelian.Ext.mk₀ cF) (add_zero n) = ξ :=
by
  intro Y _ W hW m hm K hK J' ι hι hsupp huniv
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  intro n ξ

  haveI : EssentiallySmall.{u+1} Y.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}

  obtain ⟨Λ, hcat, hfilt, F, ψ, hcomp, hLa, hLb, hfp⟩ := wc_et_torsion_fp_filtered_system Y m K hK

  obtain ⟨Q, cq, hqc, hQa, hQb, hQdata⟩ :=
    wc_et_quot_filtered_system Y W Λ F K ψ hcomp hLa hLb J' ι hι hsupp huniv

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 Y)) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have hYaff : IsAffine (Scheme.Etale.mk (𝟙 Y)).left := by
    change IsAffine Y
    infer_instance
  have H0 : ∀ (G : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (x : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit G) 0),
      ∃ (i : Λ) (y : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (G.obj i) 0),
        y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G i)) (add_zero 0) = x := by
    intro G x
    obtain ⟨hA, hB⟩ := wc_et_sheaf_colimit_cocone_local Y Λ G
    obtain ⟨hsurj, -⟩ := wc_et_affine_sections_local_cocone Y Λ G (Limits.colimit G)
      (Limits.colimit.ι G) (fun i j f => Limits.colimit.w G f) hA hB (Scheme.Etale.mk (𝟙 Y)) hYaff
    obtain ⟨i, t, ht⟩ := hsurj ((Sheaf.H.equiv₀ (Limits.colimit G) hT) x)
    refine ⟨i, (Sheaf.H.equiv₀ (G.obj i) hT).symm t, (Sheaf.H.equiv₀ (Limits.colimit G) hT).injective ?_⟩
    have h := Sheaf.H.equiv₀_naturality hT (Limits.colimit.ι G i)
      ((Sheaf.H.equiv₀ (G.obj i) hT).symm t)
    rw [AddEquiv.apply_symm_apply, Sheaf.H.map_apply] at h
    rw [← h, ht]

  have Hemb : ∀ G : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      ∃ (I : Λ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (α : G ⟶ I), Mono α ∧
        ∀ (q : ℕ) (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) (Limits.colimit I) (q + 1)),
          e = 0 := by
    intro G
    obtain ⟨I, α, hα, hinj⟩ := wc_et_functorial_injective_embedding Y Λ G
    obtain ⟨hA, hB⟩ := wc_et_sheaf_colimit_cocone_local Y Λ I
    exact ⟨I, α, hα, wc_et_affine_colim_injective_acyclic Y Λ I hinj (fun U hU =>
      wc_et_affine_sections_local_cocone Y Λ I (Limits.colimit I) (Limits.colimit.ι I)
        (fun i j f => Limits.colimit.w I f) hA hB U hU)⟩

  obtain ⟨e, he⟩ := wc_et_local_cocone_colimit_iso Y Λ Q (Limits.cokernel ι) cq hqc hQa hQb
    (wc_et_sheaf_colimit_cocone_local Y Λ Q).1

  obtain ⟨i, ζQ, hζQ⟩ := wc_ext_filtered_colim_lift
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) Λ H0 Hemb Q n
    (ξ.comp (Abelian.Ext.mk₀ e.inv) (add_zero n))
  have hζcq : ζQ.comp (Abelian.Ext.mk₀ (cq i)) (add_zero n) = ξ := by
    have h1 : (ζQ.comp (Abelian.Ext.mk₀ (Limits.colimit.ι Q i)) (add_zero n)).comp
        (Abelian.Ext.mk₀ e.hom) (add_zero n) = ξ := by
      rw [hζQ, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, he i] at h1
    exact h1

  obtain ⟨U, V, g, hU1, hU2, hV1, hV2, hgtor, ⟨θ₁⟩⟩ := hfp i
  obtain ⟨F', ιFi, θ, hmono, hFs, hθ⟩ := hQdata i
  haveI := hmono

  obtain ⟨ψ', hψ'⟩ : ∃ ψ' : Limits.cokernel g ⟶ K, ψ' = θ₁.inv ≫ ψ i := ⟨_, rfl⟩
  obtain ⟨ιF, hιF⟩ : ∃ ιF : F' ⟶ Limits.cokernel g, ιF = ιFi ≫ θ₁.hom := ⟨_, rfl⟩
  have hιFmono : Mono ιF := by
    rw [hιF]
    infer_instance
  have hw : ιF ≫ ψ' ≫ Limits.cokernel.π ι = 0 := by
    rw [hιF, hψ']
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    rw [← hθ, ← Category.assoc, Limits.cokernel.condition, Limits.zero_comp]
  obtain ⟨cF, hcF⟩ : ∃ cF : Limits.cokernel ιF ⟶ Limits.cokernel ι,
      Limits.cokernel.π ιF ≫ cF = ψ' ≫ Limits.cokernel.π ι :=
    ⟨Limits.cokernel.desc ιF _ hw, Limits.cokernel.π_desc _ _ _⟩
  have hw' : ιFi ≫ θ₁.hom ≫ Limits.cokernel.π ιF = 0 := by
    rw [← Category.assoc, ← hιF]
    exact Limits.cokernel.condition ιF
  obtain ⟨κ, hκ⟩ : ∃ κ : Limits.cokernel ιFi ⟶ Limits.cokernel ιF,
      Limits.cokernel.π ιFi ≫ κ = θ₁.hom ≫ Limits.cokernel.π ιF :=
    ⟨Limits.cokernel.desc ιFi _ hw', Limits.cokernel.π_desc _ _ _⟩

  have hκcF : κ ≫ cF = θ.inv ≫ cq i := by
    rw [← cancel_epi (Limits.cokernel.π ιFi)]
    calc Limits.cokernel.π ιFi ≫ κ ≫ cF = θ₁.hom ≫ Limits.cokernel.π ιF ≫ cF := by
          simp only [← Category.assoc, hκ]
      _ = Limits.cokernel.π ιFi ≫ θ.inv ≫ cq i := by
          rw [hcF, hθ]
          simp only [hψ', Category.assoc, Iso.hom_inv_id_assoc]

  refine ⟨U, V, g, hU1, hU2, hV1, hV2, hgtor, ψ', F', ιF, hιFmono, hFs, cF, hcF,
    ζQ.comp (Abelian.Ext.mk₀ (θ.hom ≫ κ)) (add_zero n), ?_⟩
  rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀,
    Category.assoc, hκcF, Iso.hom_inv_id_assoc, hζcq]

theorem wc_et_finite_push_const_pair : ∀ (Y Z₁ Z₂ : Scheme.{u}) (p₁ : Z₁ ⟶ Y) (p₂ : Z₂ ⟶ Y) [IsFinite p₁] [IsFinite p₂] (m : ℕ), ∃ (Z : Scheme.{u}) (p : Z ⟶ Y) (_ : IsFinite p) (q₁ : (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ⟶ (wcEtPush p₁).obj ((constantSheaf (Scheme.smallEtaleTopology Z₁) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (q₂ : (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) ⟶ (wcEtPush p₂).obj ((constantSheaf (Scheme.smallEtaleTopology Z₂) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), ∀ (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (φ₁ : F ⟶ (wcEtPush p₁).obj ((constantSheaf (Scheme.smallEtaleTopology Z₁) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (φ₂ : F ⟶ (wcEtPush p₂).obj ((constantSheaf (Scheme.smallEtaleTopology Z₂) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))), ∃ e : F ⟶ (wcEtPush p).obj ((constantSheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))), e ≫ q₁ = φ₁ ∧ e ≫ q₂ = φ₂ :=
by
  intro Y Z₁ Z₂ p₁ p₂ _ _ m
  generalize AddCommGrpCat.of (ULift.{u+1} (ZMod m)) = A

  have hSurj : ∀ (X : Scheme.{u}) (V : X.Etale) (R : Sieve V), R ∈ Scheme.smallEtaleTopology X V →
      ∀ y : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V) (w : V₁.left), R.arrows c ∧ c.left w = y := by
    intro X V R hR y
    change R ∈ Scheme.smallGrothendieckTopology @Etale X V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    obtain ⟨V₁, c, w, hc, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ V R).mp hR y
    exact ⟨V₁, c, w, hc, hw⟩
  have hCov : ∀ (X : Scheme.{u}) (V : X.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale)
      (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology X V := by
    intro X V R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hR x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩

  have hcont : ∀ {S : Scheme.{u}} (T : S.Etale),
      (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S) ∧
      (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology S) := by
    intro S T
    haveI hT : Etale T.hom := T.prop
    have hcov : CoverPreserving (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S)
        (wcEtSlice T) := by
      refine CoverPreserving.mk (fun {V} {R} hR => ?_)
      apply hCov
      intro v
      obtain ⟨V₁, c, w, hc, hw⟩ := hSurj T.left V R hR v
      exact ⟨(wcEtSlice T).obj V₁, (wcEtSlice T).map c,
        ⟨V₁, c, 𝟙 _, hc, (Category.id_comp _).symm⟩, ⟨w, hw⟩⟩
    have hcomp : CompatiblePreserving.{u+1} (Scheme.smallEtaleTopology S) (wcEtSlice T) := by
      apply CompatiblePreserving.mk
      intro ℱ Z T' x hx Y₁ Y₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      have hw : (f₁.left ≫ Y₁.hom) ≫ T.hom = X.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w f₁)
      haveI : Etale ((f₁.left ≫ Y₁.hom) ≫ T.hom) := hw ▸ X.prop
      haveI : Etale (f₁.left ≫ Y₁.hom) := Etale.of_comp _ T.hom
      let X' : T.left.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) ‹_›
      have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun k => k.left) hfg
      have h2 : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
        have e1 : Y₁.hom = g₁.left ≫ Z.hom := (MorphismProperty.Over.w g₁).symm
        have e2 : Y₂.hom = g₂.left ≫ Z.hom := (MorphismProperty.Over.w g₂).symm
        calc f₂.left ≫ Y₂.hom = (f₂.left ≫ g₂.left) ≫ Z.hom :=
              (congrArg (f₂.left ≫ ·) e2).trans (Category.assoc _ _ _).symm
          _ = (f₁.left ≫ g₁.left) ≫ Z.hom := congrArg (· ≫ Z.hom) hleft.symm
          _ = f₁.left ≫ Y₁.hom :=
              (Category.assoc _ _ _).trans (congrArg (f₁.left ≫ ·) e1.symm)
      let f₁' : X' ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
      let f₂' : X' ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left h2 trivial
      let e : X ⟶ (wcEtSlice T).obj X' :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw) trivial
      have hf₁ : f₁ = e ≫ (wcEtSlice T).map f₁' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hf₂ : f₂ = e ≫ (wcEtSlice T).map f₂' := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      have hsq : f₁' ≫ g₁ = f₂' ≫ g₂ := by
        apply MorphismProperty.Over.Hom.ext
        exact hleft
      have hc := hx f₁' f₂' hg₁ hg₂ hsq
      rw [hf₁, hf₂]
      simp only [Functor.map_comp, op_comp]
      rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
      exact congrArg _ hc
    have hcont : (wcEtSlice T).IsContinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology S) :=
      Functor.isContinuous_of_coverPreserving hcomp hcov
    have hcocont : (wcEtSlice T).IsCocontinuous (Scheme.smallEtaleTopology T.left)
        (Scheme.smallEtaleTopology S) := by
      refine Functor.IsCocontinuous.mk (fun {V} {S'} hS' => ?_)
      apply hCov
      intro v
      obtain ⟨V₁, c, w, hc, hcw⟩ := hSurj S ((wcEtSlice T).obj V) S' hS' v
      have hw : (c.left ≫ V.hom) ≫ T.hom = V₁.hom :=
        (Category.assoc _ _ _).trans (MorphismProperty.Over.w c)
      haveI : Etale ((c.left ≫ V.hom) ≫ T.hom) := hw ▸ V₁.prop
      haveI : Etale (c.left ≫ V.hom) := Etale.of_comp _ T.hom
      let X' : T.left.Etale := MorphismProperty.Over.mk ⊤ (c.left ≫ V.hom) ‹_›
      let c' : X' ⟶ V := MorphismProperty.Over.homMk c.left rfl trivial
      let e' : (wcEtSlice T).obj X' ⟶ V₁ :=
        MorphismProperty.Over.homMk (𝟙 _) ((Category.id_comp _).trans hw.symm) trivial
      have he' : (wcEtSlice T).map c' = e' ≫ c := by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp _).symm
      refine ⟨X', c', ?_, ⟨w, hcw⟩⟩
      show S'.arrows ((wcEtSlice T).map c')
      rw [he']
      exact S'.downward_closed hc e'
    exact ⟨hcont, hcocont⟩

  have hslice : ∀ {S : Scheme.{u}} (T : S.Etale),
      Nonempty ((wcEtSlice T).op ⋙ ((constantSheaf (Scheme.smallEtaleTopology S)
        AddCommGrpCat.{u+1}).obj A).obj ≅ ((constantSheaf (Scheme.smallEtaleTopology T.left)
          AddCommGrpCat.{u+1}).obj A).obj) := by
    intro S T
    haveI := (hcont T).1
    haveI := (hcont T).2
    exact ⟨((sheafToPresheaf (Scheme.smallEtaleTopology T.left) AddCommGrpCat.{u+1}).mapIso
      (((wcEtSlice T).pushforwardContinuousSheafificationCompatibility AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology T.left) (Scheme.smallEtaleTopology S)).app
          ((Functor.const _).obj A))).symm⟩

  have two_piece : ∀ (W : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology W) AddCommGrpCat.{u+1})
      (V V₁ V₂ : W.Etale) (a₁ : V₁ ⟶ V) (a₂ : V₂ ⟶ V), IsOpenImmersion a₁.left →
      IsOpenImmersion a₂.left → Disjoint (Set.range a₁.left) (Set.range a₂.left) →
      (∀ x : V.left, x ∈ Set.range a₁.left ∨ x ∈ Set.range a₂.left) →
      Function.Bijective (fun s : G.obj.obj (Opposite.op V) =>
        ((G.obj.map a₁.op).hom s, (G.obj.map a₂.op).hom s)) := by
    intro W G V V₁ V₂ a₁ a₂ h₁ h₂ hdisj hcovr
    let X : Bool → W.Etale := fun b => cond b V₁ V₂
    let π : (b : Bool) → X b ⟶ V := fun b => Bool.rec (motive := fun b => X b ⟶ V) a₂ a₁ b
    have hR : Sieve.generate (Presieve.ofArrows X π) ∈ Scheme.smallEtaleTopology W V := by
      apply hCov
      intro v
      rcases hcovr v with hv | hv
      · exact ⟨V₁, a₁, ⟨V₁, 𝟙 _, π true, Presieve.ofArrows.mk true, Category.id_comp _⟩, hv⟩
      · exact ⟨V₂, a₂, ⟨V₂, 𝟙 _, π false, Presieve.ofArrows.mk false, Category.id_comp _⟩, hv⟩
    have hSh := ((isSheaf_iff_isSheaf_of_type _ _).1
      ((Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget AddCommGrpCat.{u+1})).1 G.cond)) _ hR
    have hamal := (Presieve.isSheafFor_arrows_iff _ π).1
      ((Presieve.isSheafFor_iff_generate _).2 hSh)
    have hempty : ∀ Z' : W.Etale, IsEmpty Z'.left → Subsingleton (G.obj.obj (Opposite.op Z')) := by
      intro Z' hZ
      have hbot : (⊥ : Sieve Z') ∈ Scheme.smallEtaleTopology W Z' :=
        hCov W Z' ⊥ (fun v => (hZ.false v).elim)
      exact AddCommGrpCat.subsingleton_of_isZero (Sheaf.isTerminalOfBotCover G Z' hbot).isZero
    have hcompat : ∀ x : (b : Bool) → (G.obj ⋙ forget AddCommGrpCat.{u+1}).obj (Opposite.op (X b)),
        Presieve.Arrows.Compatible (G.obj ⋙ forget AddCommGrpCat.{u+1}) π x := by
      intro x i j Z gi gj hij
      have hleft : gi.left ≫ (π i).left = gj.left ≫ (π j).left := congrArg (fun k => k.left) hij
      by_cases hij' : i = j
      · subst hij'
        have hoi : IsOpenImmersion (π i).left := by
          cases i
          · exact h₂
          · exact h₁
        haveI := hoi
        have hl : gi.left = gj.left := (cancel_mono (π i).left).1 hleft
        have hg : gi = gj := MorphismProperty.Over.Hom.ext hl
        subst hg
        rfl
      · have hd : Disjoint (Set.range (π i).left) (Set.range (π j).left) := by
          cases i <;> cases j
          · exact absurd rfl hij'
          · exact hdisj.symm
          · exact hdisj
          · exact absurd rfl hij'
        exact @Subsingleton.elim _ (hempty Z (Scheme.isEmpty_of_commSq ⟨hleft⟩ hd)) _ _
    constructor
    · intro s s' hss
      have hss1 := congrArg Prod.fst hss
      have hss2 := congrArg Prod.snd hss
      let x : (b : Bool) → (G.obj ⋙ forget AddCommGrpCat.{u+1}).obj (Opposite.op (X b)) :=
        fun b => (G.obj ⋙ forget AddCommGrpCat.{u+1}).map (π b).op s
      obtain ⟨t, -, huniq⟩ := hamal x (hcompat x)
      have e1 := huniq s (fun b => rfl)
      have e2 := huniq s' (fun b => by
        cases b
        · exact hss2.symm
        · exact hss1.symm)
      exact e1.trans e2.symm
    · rintro ⟨y₁, y₂⟩
      let x : (b : Bool) → (G.obj ⋙ forget AddCommGrpCat.{u+1}).obj (Opposite.op (X b)) :=
        fun b => Bool.rec (motive := fun b =>
          (G.obj ⋙ forget AddCommGrpCat.{u+1}).obj (Opposite.op (X b))) y₂ y₁ b
      obtain ⟨t, ht, -⟩ := hamal x (hcompat x)
      exact ⟨t, Prod.ext (ht true) (ht false)⟩

  have split : ∀ (P P₁ P₂ : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (R₁ : P ⟶ P₁) (R₂ : P ⟶ P₂),
      (∀ T : (Y.Etale)ᵒᵖ, Function.Bijective (fun s : P.obj T =>
        ((R₁.app T).hom s, (R₂.app T).hom s))) →
      ∃ (S₁ : P₁ ⟶ P) (S₂ : P₂ ⟶ P), S₁ ≫ R₁ = 𝟙 P₁ ∧ S₂ ≫ R₂ = 𝟙 P₂ ∧
        S₁ ≫ R₂ = 0 ∧ S₂ ≫ R₁ = 0 := by
    intro P P₁ P₂ R₁ R₂ hb
    let ε : ∀ T, P.obj T ≃+ (P₁.obj T × P₂.obj T) := fun T =>
      AddEquiv.ofBijective ((R₁.app T).hom.prod (R₂.app T).hom) (hb T)
    have hR1 : ∀ T z, (R₁.app T).hom ((ε T).symm z) = z.1 := fun T z =>
      congrArg Prod.fst ((ε T).apply_symm_apply z)
    have hR2 : ∀ T z, (R₂.app T).hom ((ε T).symm z) = z.2 := fun T z =>
      congrArg Prod.snd ((ε T).apply_symm_apply z)
    have hinj : ∀ T (a b : P.obj T), (R₁.app T).hom a = (R₁.app T).hom b →
        (R₂.app T).hom a = (R₂.app T).hom b → a = b := fun T a b h1 h2 =>
      (hb T).1 (Prod.ext h1 h2)
    have nat1 : ∀ {T T' : (Y.Etale)ᵒᵖ} (f : T ⟶ T') (y : P.obj T),
        (R₁.app T').hom ((P.map f).hom y) = (P₁.map f).hom ((R₁.app T).hom y) := fun f y =>
      congrArg (fun φ => φ.hom y) (R₁.naturality f)
    have nat2 : ∀ {T T' : (Y.Etale)ᵒᵖ} (f : T ⟶ T') (y : P.obj T),
        (R₂.app T').hom ((P.map f).hom y) = (P₂.map f).hom ((R₂.app T).hom y) := fun f y =>
      congrArg (fun φ => φ.hom y) (R₂.naturality f)
    let S₁ : P₁ ⟶ P :=
      { app := fun T => AddCommGrpCat.ofHom ((ε T).symm.toAddMonoidHom.comp (AddMonoidHom.inl _ _))
        naturality := by
          intro T T' f
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro x
          show (ε T').symm ((P₁.map f).hom x, 0) = (P.map f).hom ((ε T).symm (x, 0))
          apply hinj T'
          · simp only [hR1, nat1]
          · simp only [hR2, nat2, map_zero] }
    let S₂ : P₂ ⟶ P :=
      { app := fun T => AddCommGrpCat.ofHom ((ε T).symm.toAddMonoidHom.comp (AddMonoidHom.inr _ _))
        naturality := by
          intro T T' f
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro x
          show (ε T').symm (0, (P₂.map f).hom x) = (P.map f).hom ((ε T).symm (0, x))
          apply hinj T'
          · simp only [hR1, nat1, map_zero]
          · simp only [hR2, nat2] }
    refine ⟨S₁, S₂, ?_, ?_, ?_, ?_⟩
    · apply NatTrans.ext
      funext T
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      exact hR1 T (x, 0)
    · apply NatTrans.ext
      funext T
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      exact hR2 T (0, x)
    · apply NatTrans.ext
      funext T
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      rw [NatTrans.app_zero, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply]
      exact hR2 T (x, 0)
    · apply NatTrans.ext
      funext T
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      rw [NatTrans.app_zero, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply]
      exact hR1 T (0, x)

  have final : ∀ {P P₁ P₂ : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (R₁ : P ⟶ P₁) (R₂ : P ⟶ P₂)
      (S₁ : P₁ ⟶ P) (S₂ : P₂ ⟶ P), S₁ ≫ R₁ = 𝟙 _ → S₂ ≫ R₂ = 𝟙 _ → S₁ ≫ R₂ = 0 → S₂ ≫ R₁ = 0 →
      ∀ {F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}}
        (φ₁ : F ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P₁)
        (φ₂ : F ⟶ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P₂),
        (φ₁ ≫ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map S₁ +
          φ₂ ≫ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map S₂) ≫
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map R₁ = φ₁ ∧
        (φ₁ ≫ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map S₁ +
          φ₂ ≫ (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map S₂) ≫
          (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map R₂ = φ₂ := by
    intro P P₁ P₂ R₁ R₂ S₁ S₂ h11 h22 h12 h21 F φ₁ φ₂
    constructor
    · rw [Preadditive.add_comp, Category.assoc, Category.assoc, ← Functor.map_comp,
        ← Functor.map_comp, h11, h21, CategoryTheory.Functor.map_id, Functor.map_zero,
        Category.comp_id, Limits.comp_zero, add_zero]
    · rw [Preadditive.add_comp, Category.assoc, Category.assoc, ← Functor.map_comp,
        ← Functor.map_comp, h12, h22, CategoryTheory.Functor.map_id, Functor.map_zero,
        Category.comp_id, Limits.comp_zero, zero_add]

  have hfin : IsFinite (Limits.coprod.desc p₁ p₂) := by
    have e : Limits.coprod.desc p₁ p₂ =
        Limits.coprod.map p₁ p₂ ≫ Limits.coprod.desc (𝟙 Y) (𝟙 Y) := by
      ext <;> simp
    rw [e]
    have h1 : IsFinite (Limits.coprod.map p₁ p₂) :=
      @IsZariskiLocalAtTarget.coprodMap @IsFinite
        (@HasAffineProperty.instIsZariskiLocalAtTarget _ _
          IsFinite.instHasAffinePropertyAndIsAffineFiniteCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensTopHomAppTop)
        _ _ _ _ p₁ p₂ ‹_› ‹_›
    have h2 : IsFinite (Limits.coprod.desc (𝟙 Y) (𝟙 Y)) := inferInstance
    exact MorphismProperty.comp_mem @IsFinite _ _ h1 h2

  have piece : ∀ (W : Scheme.{u}) (i : W ⟶ Z₁ ⨿ Z₂) [IsOpenImmersion i] (q : W ⟶ Y)
      (hq : q ≫ 𝟙 Y = i ≫ Limits.coprod.desc p₁ p₂) (T : Y.Etale),
      IsOpenImmersion (Limits.pullback.map T.hom q T.hom (Limits.coprod.desc p₁ p₂) (𝟙 _) i
        (𝟙 Y) (by simp) hq) ∧
      ∀ x, x ∈ Set.range (Limits.pullback.map T.hom q T.hom (Limits.coprod.desc p₁ p₂) (𝟙 _) i
        (𝟙 Y) (by simp) hq) ↔
        Limits.pullback.snd T.hom (Limits.coprod.desc p₁ p₂) x ∈ Set.range i := by
    intro W i _ q hq T
    have hfst : Limits.pullback.map T.hom q T.hom (Limits.coprod.desc p₁ p₂) (𝟙 _) i (𝟙 Y)
        (by simp) hq ≫ Limits.pullback.fst T.hom (Limits.coprod.desc p₁ p₂) =
        Limits.pullback.fst T.hom q := by
      exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
    have hsnd : Limits.pullback.map T.hom q T.hom (Limits.coprod.desc p₁ p₂) (𝟙 _) i (𝟙 Y)
        (by simp) hq ≫ Limits.pullback.snd T.hom (Limits.coprod.desc p₁ p₂) =
        Limits.pullback.snd T.hom q ≫ i := by
      exact Limits.pullback.lift_snd _ _ _
    have hqi : i ≫ Limits.coprod.desc p₁ p₂ = q := by simpa using hq.symm
    have hout : IsPullback (Limits.pullback.map T.hom q T.hom (Limits.coprod.desc p₁ p₂) (𝟙 _) i
        (𝟙 Y) (by simp) hq ≫ Limits.pullback.fst T.hom (Limits.coprod.desc p₁ p₂))
        (Limits.pullback.snd T.hom q) T.hom (i ≫ Limits.coprod.desc p₁ p₂) := by
      rw [hfst, hqi]
      exact IsPullback.of_hasPullback T.hom q
    have hb : IsPullback (Limits.pullback.map T.hom q T.hom (Limits.coprod.desc p₁ p₂) (𝟙 _) i
        (𝟙 Y) (by simp) hq) (Limits.pullback.snd T.hom q)
        (Limits.pullback.snd T.hom (Limits.coprod.desc p₁ p₂)) i :=
      IsPullback.of_right hout hsnd (IsPullback.of_hasPullback T.hom (Limits.coprod.desc p₁ p₂))
    refine ⟨MorphismProperty.of_isPullback (P := @IsOpenImmersion) hb.flip inferInstance,
      fun x => ⟨?_, ?_⟩⟩
    · rintro ⟨y, rfl⟩
      refine ⟨Limits.pullback.snd T.hom q y, ?_⟩
      have e := congrArg (fun f : Limits.pullback T.hom q ⟶ Z₁ ⨿ Z₂ => f y) hsnd
      simp only [Scheme.Hom.comp_apply] at e
      exact e.symm
    · intro hx
      have hx' : x ∈ Set.range (Limits.pullback.fst
          (Limits.pullback.snd T.hom (Limits.coprod.desc p₁ p₂)) i) := by
        rw [Scheme.Pullback.range_fst]
        exact hx
      obtain ⟨w, rfl⟩ := hx'
      refine ⟨hb.isoPullback.inv w, ?_⟩
      have hinv : hb.isoPullback.inv ≫ Limits.pullback.map T.hom q T.hom
          (Limits.coprod.desc p₁ p₂) (𝟙 _) i (𝟙 Y) (by simp) hq =
          Limits.pullback.fst (Limits.pullback.snd T.hom (Limits.coprod.desc p₁ p₂)) i :=
        (Iso.inv_comp_eq _).2 hb.isoPullback_hom_fst.symm
      have e := congrArg (fun f : Limits.pullback
        (Limits.pullback.snd T.hom (Limits.coprod.desc p₁ p₂)) i ⟶
        Limits.pullback T.hom (Limits.coprod.desc p₁ p₂) => f w) hinv
      simp only [Scheme.Hom.comp_apply] at e
      exact e
  have hq₁ : p₁ ≫ 𝟙 Y = Limits.coprod.inl ≫ Limits.coprod.desc p₁ p₂ := by simp
  have hq₂ : p₂ ≫ 𝟙 Y = Limits.coprod.inr ≫ Limits.coprod.desc p₁ p₂ := by simp
  letI hcompE : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hbcA : ∀ {X₀ Y₀ : Scheme.{u}} (f : X₀ ⟶ Y₀),
      MorphismProperty.IsStableUnderBaseChangeAlong (@Etale : MorphismProperty Scheme.{u}) f :=
    fun f => (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
      (inferInstance : P.IsStableUnderBaseChangeAlong f)) (@Etale : MorphismProperty Scheme.{u})
  haveI := hbcA (Limits.coprod.inl : Z₁ ⟶ Z₁ ⨿ Z₂)
  haveI := hbcA (Limits.coprod.inr : Z₂ ⟶ Z₁ ⨿ Z₂)
  haveI := hbcA (Limits.coprod.desc p₁ p₂)
  let t₁ : wcEtBaseChange p₁ ⋙ wcEtSlice (Scheme.Etale.mk (Limits.coprod.inl : Z₁ ⟶ Z₁ ⨿ Z₂)) ⟶
      wcEtBaseChange (Limits.coprod.desc p₁ p₂) :=
    MorphismProperty.Over.pullbackMapHomPullback (P := @Etale) (Q := ⊤)
      (Limits.coprod.inl : Z₁ ⟶ Z₁ ⨿ Z₂) (Scheme.Etale.mk (Limits.coprod.inl : Z₁ ⟶ Z₁ ⨿ Z₂)).prop
      trivial (Limits.coprod.desc p₁ p₂) p₁ (Limits.coprod.inl_desc p₁ p₂)
  let t₂ : wcEtBaseChange p₂ ⋙ wcEtSlice (Scheme.Etale.mk (Limits.coprod.inr : Z₂ ⟶ Z₁ ⨿ Z₂)) ⟶
      wcEtBaseChange (Limits.coprod.desc p₁ p₂) :=
    MorphismProperty.Over.pullbackMapHomPullback (P := @Etale) (Q := ⊤)
      (Limits.coprod.inr : Z₂ ⟶ Z₁ ⨿ Z₂) (Scheme.Etale.mk (Limits.coprod.inr : Z₂ ⟶ Z₁ ⨿ Z₂)).prop
      trivial (Limits.coprod.desc p₁ p₂) p₂ (Limits.coprod.inr_desc p₁ p₂)
  have ht₁ : ∀ T : Y.Etale, (t₁.app T).left = Limits.pullback.map T.hom p₁ T.hom
      (Limits.coprod.desc p₁ p₂) (𝟙 _) Limits.coprod.inl (𝟙 Y) (by simp) hq₁ := fun T => rfl
  have ht₂ : ∀ T : Y.Etale, (t₂.app T).left = Limits.pullback.map T.hom p₂ T.hom
      (Limits.coprod.desc p₁ p₂) (𝟙 _) Limits.coprod.inr (𝟙 Y) (by simp) hq₂ := fun T => rfl
  have hpieces : ∀ T : Y.Etale, IsOpenImmersion (t₁.app T).left ∧
      IsOpenImmersion (t₂.app T).left ∧
      Disjoint (Set.range (t₁.app T).left) (Set.range (t₂.app T).left) ∧
      ∀ x : ((wcEtBaseChange (Limits.coprod.desc p₁ p₂)).obj T).left,
        x ∈ Set.range (t₁.app T).left ∨ x ∈ Set.range (t₂.app T).left := by
    intro T
    obtain ⟨o₁, r₁⟩ := piece Z₁ Limits.coprod.inl p₁ hq₁ T
    obtain ⟨o₂, r₂⟩ := piece Z₂ Limits.coprod.inr p₂ hq₂ T
    rw [ht₁, ht₂]
    refine ⟨o₁, o₂, ?_, ?_⟩
    · rw [Set.disjoint_left]
      intro x hx1 hx2
      exact Set.disjoint_left.mp (isCompl_range_inl_inr Z₁ Z₂).disjoint ((r₁ x).1 hx1)
        ((r₂ x).1 hx2)
    · intro x
      have hz : Limits.pullback.snd T.hom (Limits.coprod.desc p₁ p₂) x ∈
          Set.range (Limits.coprod.inl : Z₁ ⟶ Z₁ ⨿ Z₂) ⊔
            Set.range (Limits.coprod.inr : Z₂ ⟶ Z₁ ⨿ Z₂) := by
        rw [(isCompl_range_inl_inr Z₁ Z₂).sup_eq_top]
        exact Set.mem_univ _
      rcases hz with h | h
      · exact Or.inl ((r₁ x).2 h)
      · exact Or.inr ((r₂ x).2 h)

  obtain ⟨ι₁⟩ : Nonempty ((wcEtSlice (Scheme.Etale.mk (Limits.coprod.inl : Z₁ ⟶ Z₁ ⨿ Z₂))).op ⋙
      ((constantSheaf (Scheme.smallEtaleTopology (Z₁ ⨿ Z₂)) AddCommGrpCat.{u+1}).obj A).obj ≅
      ((constantSheaf (Scheme.smallEtaleTopology Z₁) AddCommGrpCat.{u+1}).obj A).obj) :=
    hslice _
  obtain ⟨ι₂⟩ : Nonempty ((wcEtSlice (Scheme.Etale.mk (Limits.coprod.inr : Z₂ ⟶ Z₁ ⨿ Z₂))).op ⋙
      ((constantSheaf (Scheme.smallEtaleTopology (Z₁ ⨿ Z₂)) AddCommGrpCat.{u+1}).obj A).obj ≅
      ((constantSheaf (Scheme.smallEtaleTopology Z₂) AddCommGrpCat.{u+1}).obj A).obj) :=
    hslice _
  let R₁ : (wcEtBaseChange (Limits.coprod.desc p₁ p₂)).op ⋙
      ((constantSheaf (Scheme.smallEtaleTopology (Z₁ ⨿ Z₂)) AddCommGrpCat.{u+1}).obj A).obj ⟶
      (wcEtBaseChange p₁).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Z₁) AddCommGrpCat.{u+1}).obj A).obj :=
    Functor.whiskerRight (NatTrans.op t₁)
      ((constantSheaf (Scheme.smallEtaleTopology (Z₁ ⨿ Z₂)) AddCommGrpCat.{u+1}).obj A).obj ≫
    Functor.whiskerLeft (wcEtBaseChange p₁).op ι₁.hom
  let R₂ : (wcEtBaseChange (Limits.coprod.desc p₁ p₂)).op ⋙
      ((constantSheaf (Scheme.smallEtaleTopology (Z₁ ⨿ Z₂)) AddCommGrpCat.{u+1}).obj A).obj ⟶
      (wcEtBaseChange p₂).op ⋙
        ((constantSheaf (Scheme.smallEtaleTopology Z₂) AddCommGrpCat.{u+1}).obj A).obj :=
    Functor.whiskerRight (NatTrans.op t₂)
      ((constantSheaf (Scheme.smallEtaleTopology (Z₁ ⨿ Z₂)) AddCommGrpCat.{u+1}).obj A).obj ≫
    Functor.whiskerLeft (wcEtBaseChange p₂).op ι₂.hom
  have hbij : ∀ T : (Y.Etale)ᵒᵖ, Function.Bijective (fun s =>
      ((R₁.app T).hom s, (R₂.app T).hom s)) := by
    intro T
    obtain ⟨o₁, o₂, hd, hc⟩ := hpieces T.unop
    have hρ := two_piece (Z₁ ⨿ Z₂)
      ((constantSheaf (Scheme.smallEtaleTopology (Z₁ ⨿ Z₂)) AddCommGrpCat.{u+1}).obj A)
      ((wcEtBaseChange (Limits.coprod.desc p₁ p₂)).obj T.unop) _ _ (t₁.app T.unop)
      (t₂.app T.unop) o₁ o₂ hd hc
    have hι : Function.Bijective (Prod.map
        (ι₁.hom.app ((wcEtBaseChange p₁).op.obj T)).hom
        (ι₂.hom.app ((wcEtBaseChange p₂).op.obj T)).hom) :=
      Function.Bijective.prodMap
        (ConcreteCategory.bijective_of_isIso (ι₁.app ((wcEtBaseChange p₁).op.obj T)).hom)
        (ConcreteCategory.bijective_of_isIso (ι₂.app ((wcEtBaseChange p₂).op.obj T)).hom)
    exact hι.comp hρ

  refine ⟨Z₁ ⨿ Z₂, Limits.coprod.desc p₁ p₂, hfin,
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map R₁,
    (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).map R₂, ?_⟩
  intro F φ₁ φ₂
  obtain ⟨S₁, S₂, h11, h22, h12, h21⟩ := split _ _ _ R₁ R₂ hbij
  exact ⟨_, final R₁ R₂ S₁ S₂ h11 h22 h12 h21 φ₁ φ₂⟩

theorem wc_etale_fiber_split_field : ∀ (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] (y : Y) (U V : Y.Etale), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → ∃ (K : Type u) (_ : Field K) (_ : Algebra (Y.residueField y) K) (_ : FiniteDimensional (Y.residueField y) K) (_ : Algebra.IsSeparable (Y.residueField y) K) (k : ℕ) (uK : Fin k → (Spec (.of K) ⟶ U.left)) (huK : ∀ a, uK a ≫ U.hom = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y), (∀ (a a' : Fin k) (e e' : Spec (.of K)), Limits.pullback.lift (uK a) (𝟙 _) (huK a) e = Limits.pullback.lift (uK a') (𝟙 _) (huK a') e' → a = a') ∧ (∀ x : ↥(Limits.pullback U.hom (Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y)), ∃ (a : Fin k) (e : Spec (.of K)), Limits.pullback.lift (uK a) (𝟙 _) (huK a) e = x) ∧ ∃ (k' : ℕ) (vK : Fin k' → (Spec (.of K) ⟶ V.left)) (hvK : ∀ b, vK b ≫ V.hom = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y), (∀ (b b' : Fin k') (e e' : Spec (.of K)), Limits.pullback.lift (vK b) (𝟙 _) (hvK b) e = Limits.pullback.lift (vK b') (𝟙 _) (hvK b') e' → b = b') ∧ (∀ x : ↥(Limits.pullback V.hom (Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y)), ∃ (b : Fin k') (e : Spec (.of K)), Limits.pullback.lift (vK b) (𝟙 _) (hvK b) e = x) :=
by
  intro Y _ _ y U V hU1 hU2 hV1 hV2
  classical

  have s1 : ∀ (Y' X : Scheme.{u}) (f : X ⟶ Y') [Etale f] (x : X) (y' : Y') (h : f x = y'),
      letI := ((Y'.residueFieldCongr h).inv ≫ f.residueFieldMap x).hom.toAlgebra
      Module.Finite (Y'.residueField y') (X.residueField x) ∧
        Algebra.IsSeparable (Y'.residueField y') (X.residueField x) := by
    intro Y' X f _ x y' h
    subst h
    have e : ((Y'.residueFieldCongr (rfl : f x = f x)).inv ≫ f.residueFieldMap x) =
        f.residueFieldMap x := by
      simp [Scheme.residueFieldCongr_refl]
    rw [e]
    letI := (f.residueFieldMap x).hom.toAlgebra
    refine ⟨?_, inferInstance⟩
    letI : Algebra (Y'.presheaf.stalk (f x)) (X.presheaf.stalk x) := (f.stalkMap x).hom.toAlgebra
    have : IsLocalHom (algebraMap (Y'.presheaf.stalk (f x)) (X.presheaf.stalk x)) :=
      inferInstanceAs <| IsLocalHom (f.stalkMap x).hom
    have : Algebra.EssFiniteType (Y'.presheaf.stalk (f x)) (X.presheaf.stalk x) := by
      rw [← RingHom.essFiniteType_algebraMap, RingHom.algebraMap_toAlgebra]
      exact LocallyOfFiniteType.stalkMap f x
    have : Algebra.FormallyUnramified (Y'.presheaf.stalk (f x)) (X.presheaf.stalk x) := by
      rw [← RingHom.formallyUnramified_algebraMap, RingHom.algebraMap_toAlgebra]
      exact FormallyUnramified.stalkMap f x
    have hfin : Module.Finite (IsLocalRing.ResidueField (Y'.presheaf.stalk (f x)))
        (IsLocalRing.ResidueField (X.presheaf.stalk x)) := inferInstance
    refine Module.Finite.of_equiv_equiv
      (RingEquiv.refl (IsLocalRing.ResidueField (Y'.presheaf.stalk (f x))))
      (RingEquiv.refl (IsLocalRing.ResidueField (X.presheaf.stalk x))) ?_
    refine RingHom.ext fun a => ?_
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective a
    rfl

  have s2 : ∀ (X Y' : Scheme.{u}) (f : X ⟶ Y') [Etale f] [QuasiCompact f] (y' : Y'),
      (f ⁻¹' {y'}).Finite := by
    intro X Y' f _ _ y'
    haveI : LocallyQuasiFinite f := by
      refine ⟨fun {U'} hU' {V'} hV' e => ?_⟩
      have h := f.etale_appLE hU' hV' e
      letI := (f.appLE U' V' e).hom.toAlgebra
      haveI : Algebra.Etale Γ(Y', U') Γ(X, V') := h
      exact (inferInstance : Algebra.QuasiFinite Γ(Y', U') Γ(X, V'))
    exact f.finite_preimage_singleton y'

  have s3 : ∀ (κ : Type u) [Field κ] (I J : Type u) [Finite I] [Finite J] (F : I → Type u)
      (G : J → Type u) [∀ i, Field (F i)] [∀ j, Field (G j)] (φ : ∀ i, κ →+* F i)
      (ψ : ∀ j, κ →+* G j),
      (∀ i, letI := (φ i).toAlgebra; Module.Finite κ (F i) ∧ Algebra.IsSeparable κ (F i)) →
      (∀ j, letI := (ψ j).toAlgebra; Module.Finite κ (G j) ∧ Algebra.IsSeparable κ (G j)) →
      ∃ (K : Type u) (_ : Field K) (_ : Algebra κ K), FiniteDimensional κ K ∧
        Algebra.IsSeparable κ K ∧
        (∀ (i : I) (t : F i), ∃ p : Polynomial κ, p ≠ 0 ∧ Polynomial.eval₂ (φ i) t p = 0 ∧
          (p.map (algebraMap κ K)).Splits) ∧
        (∀ (j : J) (t : G j), ∃ p : Polynomial κ, p ≠ 0 ∧ Polynomial.eval₂ (ψ j) t p = 0 ∧
          (p.map (algebraMap κ K)).Splits) := by
    intro κ _ I J _ _ F G _ _ φ ψ hF hG
    haveI := Fintype.ofFinite I
    haveI := Fintype.ofFinite J
    have gen : ∀ (E : Type u) [Field E] (χ : κ →+* E),
        (letI := χ.toAlgebra; Module.Finite κ E ∧ Algebra.IsSeparable κ E) →
        ∃ q : Polynomial κ, q.Monic ∧ q.Separable ∧ 0 < q.degree ∧
          ∀ (K : Type u) [Field K] [Algebra κ K] [Normal κ K], (∃ r : K, Polynomial.aeval r q = 0) →
            ∀ t : E, ∃ p : Polynomial κ, p ≠ 0 ∧ Polynomial.eval₂ χ t p = 0 ∧
              (p.map (algebraMap κ K)).Splits := by
      intro E _ χ hE
      letI := χ.toAlgebra
      obtain ⟨h1, h2⟩ := hE
      let pb := Field.powerBasisOfFiniteOfSeparable κ E
      refine ⟨minpoly κ pb.gen, minpoly.monic (Algebra.IsIntegral.isIntegral _),
        Algebra.IsSeparable.isSeparable κ pb.gen,
        minpoly.degree_pos (Algebra.IsIntegral.isIntegral _), ?_⟩
      intro K _ _ hN hr t
      obtain ⟨r, hr⟩ := hr
      let σ := pb.lift r hr
      refine ⟨minpoly κ t, minpoly.ne_zero (Algebra.IsIntegral.isIntegral t), ?_, ?_⟩
      · have := minpoly.aeval κ t
        rwa [Polynomial.aeval_def, RingHom.algebraMap_toAlgebra] at this
      · rw [← minpoly.algHom_eq σ σ.toRingHom.injective t]
        exact Normal.splits hN (σ t)
    choose qF hqFm hqFs hqFd hqF using fun i => gen (F i) (φ i) (hF i)
    choose qG hqGm hqGs hqGd hqG using fun j => gen (G j) (ψ j) (hG j)
    let P : Polynomial κ := (∏ i, qF i) * ∏ j, qG j
    have hPm : P.Monic := (Polynomial.monic_prod_of_monic _ _ (fun i _ => hqFm i)).mul
      (Polynomial.monic_prod_of_monic _ _ (fun j _ => hqGm j))
    have hP0 : P ≠ 0 := hPm.ne_zero
    let K := P.SplittingField
    have hsplit : (P.map (algebraMap κ K)).Splits := Polynomial.SplittingField.splits P
    have hroot : ∀ q : Polynomial κ, 0 < q.degree → q ∣ P → ∃ r : K, Polynomial.aeval r q = 0 := by
      intro q hq hdvd
      have hs : (q.map (algebraMap κ K)).Splits :=
        Polynomial.Splits.of_dvd hsplit (Polynomial.map_ne_zero hP0) (Polynomial.map_dvd _ hdvd)
      obtain ⟨r, hr⟩ := hs.exists_eval_eq_zero (by rw [Polynomial.degree_map]; exact hq.ne')
      exact ⟨r, by rwa [Polynomial.eval_map_algebraMap] at hr⟩
    have hsepK : Algebra.IsSeparable κ K := by
      rw [← separableClosure.eq_top_iff, eq_top_iff]
      intro z _
      have hz : z ∈ Algebra.adjoin κ (P.rootSet K) := by
        rw [Polynomial.SplittingField.adjoin_rootSet]; trivial
      have hle : Algebra.adjoin κ (P.rootSet K) ≤ (separableClosure κ K).toSubalgebra := by
        rw [Algebra.adjoin_le_iff]
        intro r hr
        have h0 := Polynomial.aeval_eq_zero_of_mem_rootSet hr
        show r ∈ separableClosure κ K
        rw [mem_separableClosure_iff]
        simp only [P, map_mul, map_prod] at h0
        rcases mul_eq_zero.mp h0 with h | h
        · obtain ⟨i, _, hi⟩ := Finset.prod_eq_zero_iff.mp h
          exact Polynomial.Separable.of_dvd (hqFs i) (minpoly.dvd κ r hi)
        · obtain ⟨j, _, hj⟩ := Finset.prod_eq_zero_iff.mp h
          exact Polynomial.Separable.of_dvd (hqGs j) (minpoly.dvd κ r hj)
      exact hle hz
    refine ⟨K, inferInstance, inferInstance, inferInstance, hsepK, fun i t => ?_, fun j t => ?_⟩
    · exact hqF i K (hroot _ (hqFd i)
        (dvd_mul_of_dvd_left (Finset.dvd_prod_of_mem _ (Finset.mem_univ i)) _)) t
    · exact hqG j K (hroot _ (hqGd j)
        (dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem _ (Finset.mem_univ j)) _)) t

  have s5 : ∀ (κ F L K : Type u) [Field κ] [Field F] [Field L] [Field K] (ρ : κ →+* F)
      (φ : F →+* L) (ι : K →+* L) (α : κ →+* K), φ.comp ρ = ι.comp α →
      (∀ t : F, ∃ p : Polynomial κ, p ≠ 0 ∧ Polynomial.eval₂ ρ t p = 0 ∧ (p.map α).Splits) →
      ∃ σ : F →+* K, ι.comp σ = φ := by
    intro κ F L K _ _ _ _ ρ φ ι α hc hs
    have hrange : ∀ t, φ t ∈ ι.range := by
      intro t
      obtain ⟨p, hp0, hpt, hsp⟩ := hs t
      have hq := hsp.eq_prod_roots
      have h1 : Polynomial.eval (φ t) ((p.map α).map ι) = 0 := by
        rw [Polynomial.map_map, Polynomial.eval_map, ← hc, ← Polynomial.hom_eval₂, hpt, map_zero]
      rw [hq] at h1
      simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_multiset_prod,
        Multiset.map_map, Function.comp_def, Polynomial.map_sub, Polynomial.map_X,
        Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_multiset_prod,
        Polynomial.eval_sub, Polynomial.eval_X] at h1
      rcases mul_eq_zero.mp h1 with h | h
      · exfalso
        rw [map_eq_zero, Polynomial.leadingCoeff_eq_zero, Polynomial.map_eq_zero] at h
        exact hp0 h
      · rw [Multiset.prod_eq_zero_iff] at h
        obtain ⟨r, _, e⟩ := Multiset.mem_map.mp h
        exact ⟨r, (sub_eq_zero.mp e).symm⟩
    let e := RingEquiv.ofBijective ι.rangeRestrict
      ⟨fun a b h => ι.injective (congrArg Subtype.val h), ι.rangeRestrict_surjective⟩
    refine ⟨e.symm.toRingHom.comp (φ.codRestrict ι.range hrange), ?_⟩
    ext t
    exact congrArg Subtype.val (e.apply_symm_apply (φ.codRestrict ι.range hrange t))

  have s4 : ∀ (Y' : Scheme.{u}) (y' : Y') (K : Type u) [Field K] (α : Y'.residueField y' →+* K)
      (g : Spec (.of K) ⟶ Y') (_ : g = Spec.map (CommRingCat.ofHom α) ≫ Y'.fromSpecResidueField y')
      (X : Scheme.{u}) (f : X ⟶ Y'),
      (∀ (x : X) (h : f x = y') (L : Type u) [Field L] (φ : X.residueField x →+* L) (ι : K →+* L),
        φ.comp ((Y'.residueFieldCongr h).inv ≫ f.residueFieldMap x).hom = ι.comp α →
        ∃ σ : X.residueField x →+* K, ι.comp σ = φ) →
      ∀ (x' : ↥(Limits.pullback f g)),
      ∃ (u : Spec (.of K) ⟶ X) (hu : u ≫ f = 𝟙 _ ≫ g), ∀ e : Spec (.of K),
        Limits.pullback.lift u (𝟙 _) hu e = x' := by
    intro Y y K _ α g hg X f H x'
    subst hg
    have hfx : f (Limits.pullback.fst f _ x') = y := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply,
        Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    set x := Limits.pullback.fst f _ x' with hx
    let ρ' : Y.residueField y ⟶ X.residueField x :=
      (Y.residueFieldCongr hfx).inv ≫ f.residueFieldMap x
    have hkey : ∀ (R : CommRingCat.{u}) (a : X.residueField x ⟶ R),
        Spec.map a ≫ X.fromSpecResidueField x ≫ f =
          Spec.map (ρ' ≫ a) ≫ Y.fromSpecResidueField y := by
      intro R a
      rw [← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, Spec.map_comp, Spec.map_comp,
        Category.assoc, Category.assoc, Scheme.residueFieldCongr_inv,
        Scheme.residueFieldCongr_fromSpecResidueField]
    let τ := (Limits.pullback f (Spec.map (CommRingCat.ofHom α) ≫
      Y.fromSpecResidueField y)).fromSpecResidueField x'
    let ι' : CommRingCat.of K ⟶ (Limits.pullback f (Spec.map (CommRingCat.ofHom α) ≫
        Y.fromSpecResidueField y)).residueField x' :=
      Spec.preimage (τ ≫ Limits.pullback.snd f _)
    have hι' : Spec.map ι' = τ ≫ Limits.pullback.snd f _ := Spec.map_preimage _
    let φ' : X.residueField x ⟶ (Limits.pullback f (Spec.map (CommRingCat.ofHom α) ≫
        Y.fromSpecResidueField y)).residueField x' :=
      (Limits.pullback.fst f _).residueFieldMap x'
    have hF1 : Spec.map φ' ≫ X.fromSpecResidueField x = τ ≫ Limits.pullback.fst f _ :=
      Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField _ _
    have hc : ρ' ≫ φ' = CommRingCat.ofHom α ≫ ι' := by
      apply Spec.map_injective
      rw [← cancel_mono (Y.fromSpecResidueField y), ← hkey, ← Category.assoc, hF1, Spec.map_comp,
        Category.assoc, Category.assoc, hι', Category.assoc, Limits.pullback.condition]
    obtain ⟨σ, hσ⟩ := H x hfx _ φ'.hom ι'.hom (congrArg CommRingCat.Hom.hom hc)
    let σ' : X.residueField x ⟶ CommRingCat.of K := CommRingCat.ofHom σ
    have hσ' : σ' ≫ ι' = φ' := CommRingCat.hom_ext hσ
    have hmono : Mono ι' := by
      first
        | exact (CommRingCat.mono_iff_injective ι').mpr ι'.hom.injective
        | exact ConcreteCategory.mono_of_injective _ ι'.hom.injective
    have hσρ : ρ' ≫ σ' = CommRingCat.ofHom α := by
      rw [← cancel_mono ι', Category.assoc, hσ', hc]
    let u : Spec (.of K) ⟶ X := Spec.map σ' ≫ X.fromSpecResidueField x
    have hu : u ≫ f = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom α) ≫ Y.fromSpecResidueField y := by
      simp only [u]
      rw [Category.assoc, hkey, hσρ, Category.id_comp]
    have hgraph : Spec.map ι' ≫ Limits.pullback.lift u (𝟙 _) hu = τ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst]
        simp only [u]
        rw [← Category.assoc, ← Spec.map_comp, hσ', hF1]
      · rw [Category.assoc, Limits.pullback.lift_snd, Category.comp_id, hι']
    refine ⟨u, hu, fun e => ?_⟩
    obtain ⟨p₀⟩ : Nonempty (Spec ((Limits.pullback f (Spec.map (CommRingCat.ofHom α) ≫
      Y.fromSpecResidueField y)).residueField x')) := inferInstance
    have hp : (Spec.map ι') p₀ = e := Subsingleton.elim _ _
    rw [← hp, ← Scheme.Hom.comp_apply, hgraph]
    exact Scheme.fromSpecResidueField_apply _ _

  haveI : Etale U.hom := U.prop
  haveI : Etale V.hom := V.prop
  haveI : QuasiCompact U.hom :=
    @quasiCompact_of_compactSpace _ _ U.hom hU1 (inferInstanceAs (QuasiSeparatedSpace Y))
  haveI : QuasiCompact V.hom :=
    @quasiCompact_of_compactSpace _ _ V.hom hV1 (inferInstanceAs (QuasiSeparatedSpace Y))
  haveI : Finite ↥(U.hom ⁻¹' {y}) := (s2 _ _ U.hom y).to_subtype
  haveI : Finite ↥(V.hom ⁻¹' {y}) := (s2 _ _ V.hom y).to_subtype
  obtain ⟨K, _, _, hKfin, hKsep, hsplitU, hsplitV⟩ := s3 (Y.residueField y)
    (↥(U.hom ⁻¹' {y})) (↥(V.hom ⁻¹' {y}))
    (fun x => (U.left.residueField x.1 : Type u)) (fun x => (V.left.residueField x.1 : Type u))
    (fun x => ((Y.residueFieldCongr x.2).inv ≫ U.hom.residueFieldMap x.1).hom)
    (fun x => ((Y.residueFieldCongr x.2).inv ≫ V.hom.residueFieldMap x.1).hom)
    (fun x => s1 _ _ U.hom x.1 y x.2) (fun x => s1 _ _ V.hom x.1 y x.2)
  have hgraph : ∀ (W : Y.Etale), (∀ (x : W.left) (h : W.hom x = y) (t : W.left.residueField x),
      ∃ p : Polynomial (Y.residueField y), p ≠ 0 ∧
        Polynomial.eval₂ ((Y.residueFieldCongr h).inv ≫ W.hom.residueFieldMap x).hom t p = 0 ∧
        (p.map (algebraMap (Y.residueField y) K)).Splits) →
      ∀ x' : ↥(Limits.pullback W.hom (Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K))
        ≫ Y.fromSpecResidueField y)),
      ∃ (u : Spec (.of K) ⟶ W.left) (hu : u ≫ W.hom = 𝟙 _ ≫
          Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫
            Y.fromSpecResidueField y),
        ∀ e : Spec (.of K), Limits.pullback.lift u (𝟙 _) hu e = x' := by
    intro W hs
    exact s4 Y y K (algebraMap (Y.residueField y) K) _ rfl W.left W.hom
      (fun x h L _ φ ι hc => s5 _ _ _ _ _ φ ι _ hc (hs x h))
  have hfinish : ∀ (W : Y.Etale), CompactSpace W.left →
      (∀ x' : ↥(Limits.pullback W.hom (Spec.map (CommRingCat.ofHom
        (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y)),
        ∃ (u : Spec (.of K) ⟶ W.left) (hu : u ≫ W.hom = 𝟙 _ ≫
          Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫
            Y.fromSpecResidueField y),
          ∀ e : Spec (.of K), Limits.pullback.lift u (𝟙 _) hu e = x') →
      ∃ (k : ℕ) (uK : Fin k → (Spec (.of K) ⟶ W.left)) (huK : ∀ a, uK a ≫ W.hom = 𝟙 _ ≫
          Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫
            Y.fromSpecResidueField y),
        (∀ (a a' : Fin k) (e e' : Spec (.of K)), Limits.pullback.lift (uK a) (𝟙 _) (huK a) e =
          Limits.pullback.lift (uK a') (𝟙 _) (huK a') e' → a = a') ∧
        (∀ x : ↥(Limits.pullback W.hom (Spec.map (CommRingCat.ofHom
          (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y)),
          ∃ (a : Fin k) (e : Spec (.of K)), Limits.pullback.lift (uK a) (𝟙 _) (huK a) e = x) := by
    intro W hW H
    haveI : Etale W.hom := W.prop
    haveI : QuasiCompact W.hom :=
      @quasiCompact_of_compactSpace _ _ W.hom hW (inferInstanceAs (QuasiSeparatedSpace Y))
    obtain ⟨e₀⟩ : Nonempty (Spec (.of K)) := inferInstance
    have hfin : Finite ↥(Limits.pullback W.hom (Spec.map (CommRingCat.ofHom
        (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y)) := by
      have h1 := s2 _ _ (Limits.pullback.snd W.hom (Spec.map (CommRingCat.ofHom
        (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y)) e₀
      have h2 : (Limits.pullback.snd W.hom (Spec.map (CommRingCat.ofHom
          (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y)) ⁻¹' {e₀} =
          Set.univ := by
        ext z
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_univ, iff_true]
        exact Subsingleton.elim _ _
      rw [h2] at h1
      exact Set.finite_univ_iff.mp h1
    choose uu huu hlift using H
    let eqv := Finite.equivFin ↥(Limits.pullback W.hom (Spec.map (CommRingCat.ofHom
      (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y))
    refine ⟨_, fun a => uu (eqv.symm a), fun a => huu (eqv.symm a), ?_, ?_⟩
    · intro a a' e e' h
      exact eqv.symm.injective ((hlift _ e).symm.trans (h.trans (hlift _ e')))
    · intro x
      refine ⟨eqv x, e₀, ?_⟩
      exact (hlift _ e₀).trans (eqv.symm_apply_apply x)
  obtain ⟨k, uK, huK, hd, hc⟩ := hfinish U hU1 (hgraph U (fun x h t => hsplitU ⟨x, h⟩ t))
  obtain ⟨k', vK, hvK, hd', hc'⟩ := hfinish V hV1 (hgraph V (fun x h t => hsplitV ⟨x, h⟩ t))
  exact ⟨K, inferInstance, inferInstance, hKfin, hKsep, k, uK, huK, hd, hc, k', vK, hvK, hd', hc'⟩

theorem wc_stage_spread : ∀ (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] (y : Y) (K : Type u) [Field K] [Algebra (Y.residueField y) K] [FiniteDimensional (Y.residueField y) K] [Algebra.IsSeparable (Y.residueField y) K] (ι : Type) [Finite ι] (X : ι → Scheme.{u}) (q : ∀ i, X i ⟶ Y), (∀ i, LocallyOfFinitePresentation (q i)) → ∀ (w : ∀ i, Spec (.of K) ⟶ X i), (∀ i, w i ≫ q i = Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y) → ∃ (E0 : Scheme.{u}) (ε : E0 ⟶ Y) (u : ∀ i, E0 ⟶ X i) (j : Spec (.of K) ⟶ E0), IsAffine E0 ∧ LocallyOfFinitePresentation ε ∧ (∀ i, u i ≫ q i = ε) ∧ (∀ i, j ≫ u i = w i) ∧ j ≫ ε = Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫ Y.fromSpecResidueField y ∧ (∀ e : E0, ε e = y → e ∈ Set.range j) ∧ ∀ C : Set Y, Topology.IsConstructible C → y ∉ C → ∃ (OY : Y.Opens) (_ : IsAffineOpen OY) (E' : Scheme.{u}) (εO : E' ⟶ (OY : Scheme.{u})) (m : E' ⟶ E0) (j' : Spec (.of K) ⟶ E'), IsAffine E' ∧ IsFinite εO ∧ LocallyOfFinitePresentation εO ∧ m ≫ ε = εO ≫ OY.ι ∧ j' ≫ m = j ∧ ∀ e : E', (εO ≫ OY.ι) e ∉ C :=
by
  classical

  have hLK : ∀ {R : Type u} [CommRing R] (C : Set (PrimeSpectrum R)), Topology.IsConstructible C →
      ∀ (𝔭 : PrimeSpectrum R), 𝔭 ∉ C → ∃ (f : R) (J : Ideal R), f ∉ 𝔭.asIdeal ∧ J.FG ∧
        J ≤ 𝔭.asIdeal ∧ ∀ P : PrimeSpectrum R, f ∉ P.asIdeal → J ≤ P.asIdeal → P ∉ C := by
    intro R _ C hC 𝔭 h𝔭
    obtain ⟨S, hS⟩ := PrimeSpectrum.exists_constructibleSetData_iff.mpr hC.compl
    have hmem : 𝔭 ∈ S.toSet := by rw [hS]; exact h𝔭
    simp only [PrimeSpectrum.ConstructibleSetData.toSet, Set.mem_iUnion] at hmem
    obtain ⟨c, hc, h⟩ := hmem
    simp only [PrimeSpectrum.BasicConstructibleSetData.toSet, Set.mem_diff,
      PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff, SetLike.mem_coe] at h
    obtain ⟨h1, h2⟩ := h
    refine ⟨c.f, Ideal.span (Set.range c.g), h2, ⟨(Set.finite_range c.g).toFinset, by simp⟩,
      Ideal.span_le.mpr h1, ?_⟩
    intro P hf hJ hPC
    have hP : P ∈ S.toSet := by
      simp only [PrimeSpectrum.ConstructibleSetData.toSet, Set.mem_iUnion]
      refine ⟨c, hc, ?_⟩
      simp only [PrimeSpectrum.BasicConstructibleSetData.toSet, Set.mem_diff,
        PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff, SetLike.mem_coe]
      exact ⟨Ideal.span_le.mp hJ, hf⟩
    rw [hS] at hP
    exact hP hPC

  have hLF : ∀ (Y : Scheme.{u}) (W : Y.Opens) (hW : IsAffineOpen W) (g : Γ(Y, W)) (B : Type u)
      [CommRing B] [Algebra Γ(Y, Y.basicOpen g) B] [Algebra Γ(Y, W) B]
      [IsScalarTower Γ(Y, W) Γ(Y, Y.basicOpen g) B], Module.Finite Γ(Y, Y.basicOpen g) B →
      Algebra.FinitePresentation Γ(Y, Y.basicOpen g) B →
      ∃ εO : Spec (.of B) ⟶ (Y.basicOpen g : Scheme.{u}), IsFinite εO ∧
        LocallyOfFinitePresentation εO ∧
        εO ≫ (Y.basicOpen g).ι = Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, W) B)) ≫
          hW.fromSpec := by
    intro Y W hW g B _ _ _ _ h1 h2
    have hD := hW.basicOpen g
    haveI : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, Y.basicOpen g) B))) := by
      rw [IsFinite.SpecMap_iff]; exact RingHom.finite_algebraMap.mpr h1
    haveI : LocallyOfFinitePresentation
        (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, Y.basicOpen g) B))) := by
      rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)]
      exact RingHom.finitePresentation_algebraMap.mpr h2
    refine ⟨Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, Y.basicOpen g) B)) ≫ hD.isoSpec.inv,
      inferInstance, inferInstance, ?_⟩
    rw [Category.assoc, hD.isoSpec_inv_ι, ← hW.map_fromSpec hD (homOfLE (Y.basicOpen_le g)).op,
      ← Category.assoc, ← Spec.map_comp,
      IsScalarTower.algebraMap_eq Γ(Y, W) Γ(Y, Y.basicOpen g) B, CommRingCat.ofHom_comp]
    rfl

  have hLP : ∀ (Y X : Scheme.{u}) (q : X ⟶ Y), LocallyOfFinitePresentation q →
      ∀ (W : Y.Opens) (hW : IsAffineOpen W) (K : Type u) [Field K] (τ : Γ(Y, W) →+* K)
      (w : Spec (.of K) ⟶ X), w ≫ q = Spec.map (CommRingCat.ofHom τ) ≫ hW.fromSpec →
      ∃ (S : X.Opens) (hS : IsAffineOpen S) (hSW : S ≤ q ⁻¹ᵁ W) (φ : Γ(X, S) →+* K),
        (q.appLE W S hSW).hom.FinitePresentation ∧ φ.comp (q.appLE W S hSW).hom = τ ∧
        Spec.map (CommRingCat.ofHom φ) ≫ hS.fromSpec = w := by
    intro Y X q hq W hW K _ τ w hw
    obtain ⟨pt⟩ : Nonempty ↥(Spec (.of K)) := inferInstance
    have hx : w pt ∈ q ⁻¹ᵁ W := by
      show q (w pt) ∈ W
      have : q (w pt) = hW.fromSpec ((Spec.map (CommRingCat.ofHom τ)) pt) := by
        rw [← Scheme.Hom.comp_apply, hw, Scheme.Hom.comp_apply]
      rw [this]
      show _ ∈ (W : Set Y)
      rw [← hW.range_fromSpec]
      exact ⟨_, rfl⟩
    obtain ⟨S, hS, hxS, hSW⟩ := exists_isAffineOpen_mem_and_subset hx
    have hSW' : S ≤ q ⁻¹ᵁ W := hSW
    have hrange : Set.range w ⊆ Set.range hS.fromSpec := by
      rw [hS.range_fromSpec]
      rintro _ ⟨z, rfl⟩
      have hz : z = pt := Subsingleton.elim (α := PrimeSpectrum K) z pt
      rw [hz]; exact hxS
    let w' := IsOpenImmersion.lift hS.fromSpec w hrange
    have hw' : w' ≫ hS.fromSpec = w := IsOpenImmersion.lift_fac _ _ _
    refine ⟨S, hS, hSW', (Spec.preimage w').hom,
      HasRingHomProperty.appLE @LocallyOfFinitePresentation q hq ⟨W, hW⟩ ⟨S, hS⟩ hSW', ?_, ?_⟩
    · have h1 : Spec.map (q.appLE W S hSW' ≫ Spec.preimage w') ≫ hW.fromSpec =
          Spec.map (CommRingCat.ofHom τ) ≫ hW.fromSpec := by
        rw [Spec.map_comp, Category.assoc, IsAffineOpen.SpecMap_appLE_fromSpec q hW hS hSW',
          Spec.map_preimage, ← Category.assoc, hw', hw]
      have h2 := Spec.map_injective ((cancel_mono hW.fromSpec).mp h1)
      have h3 := congrArg CommRingCat.Hom.hom h2
      rwa [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h3
    · rw [CommRingCat.ofHom_hom, Spec.map_preimage, hw']

  have hLY : ∀ (Y : Scheme.{u}) (y : Y) (W : Y.Opens) (hW : IsAffineOpen W) (hy : y ∈ W),
      Spec.map (Y.evaluation W y hy) ≫ hW.fromSpec = Y.fromSpecResidueField y ∧
      (∀ c : Y.residueField y, ∃ a s : Γ(Y, W), (Y.evaluation W y hy).hom s ≠ 0 ∧
        c * (Y.evaluation W y hy).hom s = (Y.evaluation W y hy).hom a) ∧
      ∀ P : PrimeSpectrum Γ(Y, W), hW.fromSpec P = y ↔
        P.asIdeal = RingHom.ker (Y.evaluation W y hy).hom := by
    intro Y y W hW hy
    have ha : Spec.map (Y.evaluation W y hy) ≫ hW.fromSpec = Y.fromSpecResidueField y := by
      rw [← Scheme.germ_residue, Spec.map_comp, Category.assoc,
        show Spec.map (Y.presheaf.germ W y hy) ≫ hW.fromSpec = hW.fromSpecStalk hy from rfl,
        hW.fromSpecStalk_eq_fromSpecStalk]
      rfl
    refine ⟨ha, ?_, ?_⟩
    · intro c
      let y' : W := ⟨y, hy⟩
      letI : Algebra Γ(Y, W) (Y.presheaf.stalk y) := (Y.presheaf.germ W y hy).hom.toAlgebra
      haveI := hW.isLocalization_stalk y'
      obtain ⟨z, hz⟩ : ∃ z, (Y.residue y).hom z = c := Y.residue_surjective y c
      obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj (hW.primeIdealOf y').asIdeal.primeCompl z
      simp only at hs
      have hgerm : ∀ b, (Y.evaluation W y hy).hom b =
          (Y.residue y).hom (algebraMap Γ(Y, W) (Y.presheaf.stalk y) b) := by
        intro b; rw [← Scheme.germ_residue]; rfl
      refine ⟨a, s, ?_, ?_⟩
      · rw [hgerm]
        have hu : IsUnit (algebraMap Γ(Y, W) (Y.presheaf.stalk y) s) :=
          IsLocalization.map_units _ s
        exact (hu.map (Y.residue y).hom).ne_zero
      · rw [hgerm, hgerm, ← hz, ← map_mul, hs]
    · have hpt : ∀ pt : PrimeSpectrum (Y.residueField y),
          hW.fromSpec (PrimeSpectrum.comap (Y.evaluation W y hy).hom pt) = y := by
        intro pt
        have h1 : (Y.fromSpecResidueField y) pt ∈ Set.range (Y.fromSpecResidueField y) :=
          ⟨_, rfl⟩
        rw [Scheme.range_fromSpecResidueField] at h1
        rw [← ha] at h1
        exact h1
      obtain ⟨pt⟩ : Nonempty (PrimeSpectrum (Y.residueField y)) := inferInstance
      have hk : (PrimeSpectrum.comap (Y.evaluation W y hy).hom pt).asIdeal =
          RingHom.ker (Y.evaluation W y hy).hom := by
        rw [PrimeSpectrum.comap_asIdeal, Ideal.eq_bot_of_prime pt.asIdeal]
        exact (RingHom.ker_eq_comap_bot _).symm
      intro P
      constructor
      · intro hP
        have := hW.fromSpec.isOpenEmbedding.injective (hP.trans (hpt pt).symm)
        rw [this, hk]
      · intro hP
        have : P = PrimeSpectrum.comap (Y.evaluation W y hy).hom pt := by
          apply PrimeSpectrum.ext; rw [hP, hk]
        rw [this, hpt]

  have hLU : ∀ {R R' T : Type u} [CommRing R] [CommRing R'] [CommRing T] [Algebra R R'] (g : R)
      [IsLocalization.Away g R'] (F : Polynomial R) (J : Ideal R) (σ : R →+* T) (x : T),
      IsUnit (σ g) → (∀ a ∈ J, σ a = 0) → Polynomial.eval₂ σ x F = 0 →
      (∃ χ : AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R')))) →+* T,
        χ.comp (algebraMap R _) = σ ∧ χ (AdjoinRoot.root _) = x) ∧
      ∀ χ₁ χ₂ : AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R')))) →+* T,
        χ₁.comp (algebraMap R _) = χ₂.comp (algebraMap R _) →
        χ₁ (AdjoinRoot.root _) = χ₂ (AdjoinRoot.root _) → χ₁ = χ₂ := by
    intro R R' T _ _ _ _ g _ F J σ x hσ hJ hF
    have hS : algebraMap R (R' ⧸ J.map (algebraMap R R')) =
        (Ideal.Quotient.mk (J.map (algebraMap R R'))).comp (algebraMap R R') := rfl
    have hB : algebraMap R (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))) =
        (AdjoinRoot.of _).comp (algebraMap R (R' ⧸ J.map (algebraMap R R'))) :=
      AdjoinRoot.algebraMap_eq' _ _
    refine ⟨?_, ?_⟩
    · let σ' : R' →+* T := IsLocalization.Away.lift g hσ
      have hσ' : ∀ a, σ' (algebraMap R R' a) = σ a := IsLocalization.Away.lift_eq g hσ
      have hle : J.map (algebraMap R R') ≤ RingHom.ker σ' := by
        rw [Ideal.map_le_iff_le_comap]
        intro b hb
        rw [Ideal.mem_comap, RingHom.mem_ker, hσ']
        exact hJ b hb
      let σ'' : R' ⧸ J.map (algebraMap R R') →+* T :=
        Ideal.Quotient.lift (J.map (algebraMap R R')) σ' (fun a ha => hle ha)
      have hσ'' : σ''.comp (algebraMap R (R' ⧸ J.map (algebraMap R R'))) = σ := by
        ext a
        rw [hS, RingHom.comp_apply]
        exact (Ideal.Quotient.lift_mk _ _ _).trans (hσ' a)
      have hev : Polynomial.eval₂ σ'' x
          (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R')))) = 0 := by
        rw [Polynomial.eval₂_map, hσ'']; exact hF
      refine ⟨AdjoinRoot.lift σ'' x hev, ?_, AdjoinRoot.lift_root hev⟩
      rw [hB]
      ext a
      simp only [RingHom.comp_apply, AdjoinRoot.lift_of]
      rw [← RingHom.comp_apply σ'', hσ'']
    · intro χ₁ χ₂ h1 h2
      apply AdjoinRoot.ringHom_ext _ h2
      apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext (Submonoid.powers g)
      ext a
      have h1' := RingHom.congr_fun h1 a
      simp only [RingHom.comp_apply] at h1' ⊢
      exact h1'

  have hLS : ∀ {R R' : Type u} [CommRing R] [CommRing R'] [Algebra R R'] (g : R)
      [IsLocalization.Away g R'] (F : Polynomial R), F.Monic → ∀ (J : Ideal R), J.FG →
      Module.Finite R' (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))) ∧
      Algebra.FinitePresentation R'
        (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))) ∧
      (algebraMap R
        (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R')))))).FinitePresentation ∧
      (∀ a ∈ J, algebraMap R
        (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))) a = 0) ∧
      IsUnit (algebraMap R
        (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))) g) ∧
      Polynomial.eval₂ (algebraMap R
        (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))))
        (AdjoinRoot.root _) F = 0 := by
    intro R R' _ _ _ g _ F hF J hJ
    have hfm : (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R')))).Monic := hF.map _
    have hB : algebraMap R (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))) =
        (AdjoinRoot.of _).comp (algebraMap R (R' ⧸ J.map (algebraMap R R'))) :=
      AdjoinRoot.algebraMap_eq' _ _
    have hS : algebraMap R (R' ⧸ J.map (algebraMap R R')) =
        (Ideal.Quotient.mk (J.map (algebraMap R R'))).comp (algebraMap R R') := rfl
    haveI h1 : Module.Finite (R' ⧸ J.map (algebraMap R R'))
        (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))) :=
      hfm.finite_adjoinRoot
    haveI h2 : Module.Finite R' (R' ⧸ J.map (algebraMap R R')) :=
      Module.Finite.of_surjective (Algebra.linearMap R' (R' ⧸ J.map (algebraMap R R')))
        Ideal.Quotient.mk_surjective
    haveI h3 : Module.Finite R'
        (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))) :=
      Module.Finite.trans (R' ⧸ J.map (algebraMap R R')) _
    haveI h4 : Algebra.FinitePresentation R' (R' ⧸ J.map (algebraMap R R')) :=
      Algebra.FinitePresentation.quotient (hJ.map _)
    haveI h5 : Algebra.FinitePresentation R'
        (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))) :=
      AdjoinRoot.finitePresentation _
    have h6 : Algebra.FinitePresentation R R' := IsLocalization.Away.finitePresentation g
    refine ⟨h3, h5, ?_, ?_, ?_, ?_⟩
    · rw [IsScalarTower.algebraMap_eq R R' (AdjoinRoot _)]
      exact RingHom.FinitePresentation.comp (RingHom.finitePresentation_algebraMap.mpr h5)
        (RingHom.finitePresentation_algebraMap.mpr h6)
    · intro a ha
      rw [hB, hS, RingHom.comp_apply, RingHom.comp_apply,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha), map_zero]
    · rw [IsScalarTower.algebraMap_eq R R' (AdjoinRoot _)]
      exact (IsLocalization.Away.algebraMap_isUnit (S := R') g).map
        (algebraMap R' (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))))
    · rw [hB, ← Polynomial.eval₂_map, AdjoinRoot.eval₂_root]

  have hLCabs : ∀ {R κ K R' B : Type u} [CommRing R] [Field κ] [Field K] [Algebra κ K]
      [CommRing R'] [Algebra R R'] [CommRing B] [Algebra R' B] [Algebra R B]
      [IsScalarTower R R' B] (ρ : R →+* κ) (g : R) [IsLocalization.Away g R'] (F : Polynomial R)
      (β : K) (r : B),
      (∀ P : Polynomial R, Polynomial.eval₂ ((algebraMap κ K).comp ρ) β P = 0 →
        ∃ Q : Polynomial R, (P - F * Q).map ρ = 0) →
      Algebra.IsIntegral R' B →
      (∀ b : B, ∃ p : Polynomial R', Polynomial.eval₂ (algebraMap R' B) r p = b) →
      Polynomial.eval₂ (algebraMap R B) r F = 0 →
      ∀ (χ : B →+* K), χ.comp (algebraMap R B) = (algebraMap κ K).comp ρ → χ r = β →
      ∀ (Q : Ideal B), Q.IsPrime → Q.comap (algebraMap R B) = RingHom.ker ρ →
      Q = RingHom.ker χ := by
    intro R κ K R' B _ _ _ _ _ _ _ _ _ _ ρ g _ F β r hmin hint hsurj hFr χ hχ hχβ Q hQ hQc
    have hgu : IsUnit (algebraMap R B g) := by
      rw [IsScalarTower.algebraMap_eq R R' B]
      exact (IsLocalization.Away.algebraMap_isUnit (S := R') g).map (algebraMap R' B)
    have hfrac : ∀ b : B, ∃ (k : ℕ) (P : Polynomial R),
        algebraMap R B g ^ k * b = Polynomial.eval₂ (algebraMap R B) r P := by
      intro b
      obtain ⟨p, rfl⟩ := hsurj b
      obtain ⟨_, ⟨k, rfl⟩, hk⟩ :=
        IsLocalization.integerNormalization_spec (Submonoid.powers g) p
      refine ⟨k, IsLocalization.integerNormalization (Submonoid.powers g) p, ?_⟩
      have h := congrArg (Polynomial.eval₂ (algebraMap R' B) r) hk
      rw [Polynomial.eval₂_map, ← IsScalarTower.algebraMap_eq] at h
      rw [h, Algebra.smul_def, Polynomial.eval₂_mul, Polynomial.algebraMap_apply,
        Polynomial.eval₂_C, ← IsScalarTower.algebraMap_apply, map_pow]
    have hA : RingHom.ker χ ≤ Q := by
      intro b hb
      obtain ⟨k, P, hP⟩ := hfrac b
      have h1 : Polynomial.eval₂ ((algebraMap κ K).comp ρ) β P = 0 := by
        have h := congrArg χ hP
        rw [map_mul, RingHom.mem_ker.mp hb, mul_zero, Polynomial.hom_eval₂, hχ, hχβ] at h
        exact h.symm
      obtain ⟨G, hG⟩ := hmin P h1
      have h2 : Polynomial.eval₂ (algebraMap R B) r P =
          Polynomial.eval₂ (algebraMap R B) r (P - F * G) := by
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_mul, hFr, zero_mul, sub_zero]
      have h3 : Polynomial.eval₂ (algebraMap R B) r (P - F * G) ∈ Q := by
        rw [Polynomial.eval₂_eq_sum_range]
        apply Ideal.sum_mem
        intro i _
        apply Ideal.mul_mem_right
        have h5 : (P - F * G).coeff i ∈ RingHom.ker ρ := by
          rw [RingHom.mem_ker, ← Polynomial.coeff_map, hG, Polynomial.coeff_zero]
        rw [← hQc] at h5
        exact h5
      have h4 : algebraMap R B g ^ k * b ∈ Q := by rw [hP, h2]; exact h3
      rcases hQ.mem_or_mem h4 with h | h
      · exact absurd (hQ.mem_of_pow_mem k h)
          (fun hm => hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ hm hgu))
      · exact h
    haveI hker : (RingHom.ker χ).IsPrime := RingHom.ker_isPrime χ
    have hc1 : (RingHom.ker χ).comap (algebraMap R B) = RingHom.ker ρ := by
      ext a
      rw [Ideal.mem_comap, RingHom.mem_ker, RingHom.mem_ker, ← RingHom.comp_apply, hχ,
        RingHom.comp_apply, map_eq_zero_iff _ (algebraMap κ K).injective]
    have hc2 : (RingHom.ker χ).under R' = Q.under R' := by
      rw [← IsLocalization.map_under (Submonoid.powers g) R' ((RingHom.ker χ).under R'),
        ← IsLocalization.map_under (Submonoid.powers g) R' (Q.under R'), Ideal.under_under,
        Ideal.under_under]
      show Ideal.map _ (Ideal.comap (algebraMap R B) (RingHom.ker χ)) =
        Ideal.map _ (Ideal.comap (algebraMap R B) Q)
      rw [hc1, hQc]
    refine le_antisymm ?_ hA
    intro x hx
    by_contra hxn
    have h := Ideal.under_lt_under_of_integral_mem_sdiff (R := R') hA ⟨hx, hxn⟩
      (hint.isIntegral x)
    rw [hc2] at h
    exact lt_irrefl _ h

  have hLC : ∀ {R κ K R' : Type u} [CommRing R] [Field κ] [Field K] [Algebra κ K] [CommRing R']
      [Algebra R R'] (ρ : R →+* κ) (g : R) [IsLocalization.Away g R'] (F : Polynomial R) (β : K)
      (J : Ideal R),
      (∀ P : Polynomial R, Polynomial.eval₂ ((algebraMap κ K).comp ρ) β P = 0 →
        ∃ Q : Polynomial R, (P - F * Q).map ρ = 0) →
      Module.Finite R' (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R'))))) →
      ∀ (χ : AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R')))) →+* K),
      χ.comp (algebraMap R _) = (algebraMap κ K).comp ρ → χ (AdjoinRoot.root _) = β →
      ∀ (Q : Ideal (AdjoinRoot (F.map (algebraMap R (R' ⧸ J.map (algebraMap R R')))))),
      Q.IsPrime → Q.comap (algebraMap R _) = RingHom.ker ρ → Q = RingHom.ker χ := by
    intro R κ K R' _ _ _ _ _ _ ρ g _ F β J hmin hfin χ hχ hχβ Q hQ hQc
    refine hLCabs ρ g F β (AdjoinRoot.root _) hmin (Algebra.IsIntegral.of_finite R' _) ?_ ?_
      χ hχ hχβ Q hQ hQc
    · intro b
      obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective b
      obtain ⟨p', rfl⟩ := Polynomial.map_surjective
        (algebraMap R' (R' ⧸ J.map (algebraMap R R'))) Ideal.Quotient.mk_surjective p
      refine ⟨p', ?_⟩
      rw [AdjoinRoot.algebraMap_eq', ← Polynomial.eval₂_map, ← AdjoinRoot.algebraMap_eq,
        ← Polynomial.aeval_def, AdjoinRoot.aeval_eq]
    · rw [AdjoinRoot.algebraMap_eq', ← Polynomial.eval₂_map, AdjoinRoot.eval₂_root]

  have hLA : ∀ {R κ K : Type u} [CommRing R] [Field κ] [Field K] [Algebra κ K]
      [FiniteDimensional κ K] [Algebra.IsSeparable κ K] (ρ : R →+* κ),
      (∀ c : κ, ∃ a s : R, ρ s ≠ 0 ∧ c * ρ s = ρ a) →
      ∃ (F : Polynomial R) (β : K), F.Monic ∧ Polynomial.eval₂ ((algebraMap κ K).comp ρ) β F = 0 ∧
        (∀ c : K, ∃ (P : Polynomial R) (h : R), ρ h ≠ 0 ∧
          c * algebraMap κ K (ρ h) = Polynomial.eval₂ ((algebraMap κ K).comp ρ) β P) ∧
        (∀ P : Polynomial R, Polynomial.eval₂ ((algebraMap κ K).comp ρ) β P = 0 →
          ∃ Q : Polynomial R, (P - F * Q).map ρ = 0) := by
    intro R κ K _ _ _ _ _ _ ρ hfrac
    have hD : ∀ p : Polynomial κ, ∃ (s : R) (P : Polynomial R), ρ s ≠ 0 ∧
        P.map ρ = Polynomial.C (ρ s) * p := by
      intro p
      induction p using Polynomial.induction_on' with
      | add p q hp hq =>
        obtain ⟨s1, P1, hs1, hP1⟩ := hp
        obtain ⟨s2, P2, hs2, hP2⟩ := hq
        refine ⟨s1 * s2, Polynomial.C s2 * P1 + Polynomial.C s1 * P2, ?_, ?_⟩
        · rw [map_mul]; exact mul_ne_zero hs1 hs2
        · rw [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C,
            Polynomial.map_C, hP1, hP2, map_mul, Polynomial.C_mul]
          ring
      | monomial n c =>
        obtain ⟨a, s, hs, h⟩ := hfrac c
        refine ⟨s, Polynomial.monomial n a, hs, ?_⟩
        rw [Polynomial.map_monomial, Polynomial.C_mul_monomial, ← h, mul_comm]
    have hev : ∀ (P : Polynomial R) (y : K),
        Polynomial.eval₂ ((algebraMap κ K).comp ρ) y P = Polynomial.aeval y (P.map ρ) := by
      intro P y
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
    obtain ⟨α, hα⟩ := Field.exists_primitive_element κ K
    have hαint : IsIntegral κ α := Algebra.IsIntegral.isIntegral α
    have hμm : (minpoly κ α).Monic := minpoly.monic hαint
    obtain ⟨s, P0, hs, hP0⟩ := hD (minpoly κ α)
    have hlift : (minpoly κ α).scaleRoots (ρ s) ∈ Polynomial.lifts ρ := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro i
      rw [Polynomial.coeff_scaleRoots]
      rcases lt_or_ge i (minpoly κ α).natDegree with hi | hi
      · have hc : ρ (P0.coeff i) = ρ s * (minpoly κ α).coeff i := by
          rw [← Polynomial.coeff_map, hP0, Polynomial.coeff_C_mul]
        obtain ⟨k, hk⟩ : ∃ k, (minpoly κ α).natDegree - i = k + 1 :=
          ⟨(minpoly κ α).natDegree - i - 1, by omega⟩
        refine ⟨P0.coeff i * s ^ k, ?_⟩
        rw [map_mul, map_pow, hc, hk, pow_succ]; ring
      · rw [Nat.sub_eq_zero_of_le hi, pow_zero, mul_one]
        rcases eq_or_lt_of_le hi with h | h
        · refine ⟨1, ?_⟩; rw [map_one, ← h]; exact hμm.coeff_natDegree.symm
        · refine ⟨0, ?_⟩; rw [map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt h]
    obtain ⟨F, hFmap, hFdeg, hFm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift
      ((Polynomial.monic_scaleRoots_iff _).mpr hμm)
    have hsne : algebraMap κ K (ρ s) ≠ 0 := (map_ne_zero _).mpr hs
    have hFβ : Polynomial.aeval (algebraMap κ K (ρ s) * α) (F.map ρ) = 0 := by
      rw [hFmap]; exact Polynomial.scaleRoots_aeval_eq_zero (minpoly.aeval κ α)
    have hβtop : IntermediateField.adjoin κ {algebraMap κ K (ρ s) * α} = ⊤ := by
      rw [eq_top_iff, ← hα, IntermediateField.adjoin_simple_le_iff]
      have hβmem := IntermediateField.mem_adjoin_simple_self κ (algebraMap κ K (ρ s) * α)
      have h2 := mul_mem (IntermediateField.algebraMap_mem
        (IntermediateField.adjoin κ {algebraMap κ K (ρ s) * α}) (ρ s)⁻¹) hβmem
      rwa [map_inv₀, ← mul_assoc, inv_mul_cancel₀ hsne, one_mul] at h2
    have hβint : IsIntegral κ (algebraMap κ K (ρ s) * α) := Algebra.IsIntegral.isIntegral _
    have hdeg : (minpoly κ (algebraMap κ K (ρ s) * α)).natDegree = (minpoly κ α).natDegree := by
      rw [← IntermediateField.adjoin.finrank hβint, ← IntermediateField.adjoin.finrank hαint,
        hβtop, hα]
    have hFbar : (F.map ρ).Monic := hFm.map ρ
    have hFbdeg : (F.map ρ).natDegree = (minpoly κ α).natDegree := by
      rw [hFm.natDegree_map, hFdeg, Polynomial.natDegree_scaleRoots]
    refine ⟨F, algebraMap κ K (ρ s) * α, hFm, by rw [hev]; exact hFβ, ?_, ?_⟩
    · intro c
      have hc : c ∈ (IntermediateField.adjoin κ {algebraMap κ K (ρ s) * α}).toSubalgebra := by
        rw [hβtop, IntermediateField.top_toSubalgebra]; exact Algebra.mem_top
      rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hβint.isAlgebraic,
        Algebra.adjoin_singleton_eq_range_aeval] at hc
      obtain ⟨p, hp⟩ : ∃ p : Polynomial κ, Polynomial.aeval (algebraMap κ K (ρ s) * α) p = c := by
        simpa using hc
      obtain ⟨s', P, hs', hP⟩ := hD p
      refine ⟨P, s', hs', ?_⟩
      rw [hev, hP, map_mul, Polynomial.aeval_C, hp, mul_comm]
    · intro P hP
      refine ⟨P /ₘ F, ?_⟩
      rw [(eq_sub_of_add_eq (Polynomial.modByMonic_add_div P F)).symm,
        Polynomial.map_modByMonic ρ hFm]
      by_contra hne
      have hr0 : Polynomial.aeval (algebraMap κ K (ρ s) * α) (P.map ρ %ₘ F.map ρ) = 0 := by
        have e := Polynomial.modByMonic_add_div (P.map ρ) (F.map ρ)
        have e2 : Polynomial.aeval (algebraMap κ K (ρ s) * α) (P.map ρ) = 0 := by
          rw [← hev]; exact hP
        rw [← e, map_add, map_mul, hFβ, zero_mul, add_zero] at e2
        exact e2
      have hle := minpoly.degree_le_of_ne_zero κ _ hne hr0
      have hlt := Polynomial.degree_modByMonic_lt (P.map ρ) hFbar
      have := lt_of_le_of_lt hle hlt
      rw [Polynomial.degree_eq_natDegree (minpoly.ne_zero hβint),
        Polynomial.degree_eq_natDegree hFbar.ne_zero, hdeg, hFbdeg] at this
      exact lt_irrefl _ this

  have hLB1 : ∀ {R κ K : Type u} [CommRing R] [Field κ] [Field K] [Algebra κ K] (ρ : R →+* κ)
      (F : Polynomial R) (β : K),
      (∀ c : K, ∃ (P : Polynomial R) (h : R), ρ h ≠ 0 ∧
        c * algebraMap κ K (ρ h) = Polynomial.eval₂ ((algebraMap κ K).comp ρ) β P) →
      (∀ P : Polynomial R, Polynomial.eval₂ ((algebraMap κ K).comp ρ) β P = 0 →
        ∃ Q : Polynomial R, (P - F * Q).map ρ = 0) →
      ∀ (A : Type u) [CommRing A] (θ : R →+* A), θ.FinitePresentation → ∀ (φ : A →+* K),
      φ.comp θ = (algebraMap κ K).comp ρ →
      ∃ (g : R) (J : Ideal R), ρ g ≠ 0 ∧ J.FG ∧ J ≤ RingHom.ker ρ ∧
        ∀ (T : Type u) [CommRing T] (σ : R →+* T) (x : T), IsUnit (σ g) →
          (∀ a ∈ J, σ a = 0) → Polynomial.eval₂ σ x F = 0 →
          ∃ ψ : A →+* T, ψ.comp θ = σ ∧ ∀ χ : T →+* K, χ.comp σ = (algebraMap κ K).comp ρ →
            χ x = β → χ.comp ψ = φ := by
    intro R κ K _ _ _ _ ρ F β hgen hmin A _ θ hθ φ hφ
    letI : Algebra R A := θ.toAlgebra
    haveI : Algebra.FinitePresentation R A := hθ
    obtain ⟨n, f, hfs, hfker⟩ := Algebra.FinitePresentation.out (R := R) (A := A)
    obtain ⟨S, hS⟩ := hfker
    have hfC : ∀ r : R, f (MvPolynomial.C r) = θ r := fun r => f.commutes r
    choose P h hh hP using fun l : Fin n => hgen (φ (f (MvPolynomial.X l)))
    have star : ∀ q : MvPolynomial (Fin n) R, ∃ (N : ℕ) (Q : Polynomial R),
        ∀ (T : Type u) [CommRing T] (σ : R →+* T) (x : T) (v : Fin n → T),
        (∀ l, σ (h l) * v l = Polynomial.eval₂ σ x (P l)) →
        σ (∏ l, h l) ^ N * MvPolynomial.eval₂ σ v q = Polynomial.eval₂ σ x Q := by
      intro q
      induction q using MvPolynomial.induction_on
      next a =>
        exact ⟨0, Polynomial.C a, fun T _ σ x v _ => by
          rw [pow_zero, one_mul, MvPolynomial.eval₂_C, Polynomial.eval₂_C]⟩
      next p q hp hq =>
        obtain ⟨N1, Q1, h1⟩ := hp
        obtain ⟨N2, Q2, h2⟩ := hq
        refine ⟨N1 + N2,
          Polynomial.C ((∏ l, h l) ^ N2) * Q1 + Polynomial.C ((∏ l, h l) ^ N1) * Q2,
          fun T _ σ x v hv => ?_⟩
        rw [MvPolynomial.eval₂_add, Polynomial.eval₂_add, Polynomial.eval₂_mul,
          Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_C, ← h1 T σ x v hv,
          ← h2 T σ x v hv, map_pow, map_pow]
        ring
      next p l hp =>
        obtain ⟨N1, Q1, h1⟩ := hp
        refine ⟨N1 + 1, Q1 * Polynomial.C (∏ l' ∈ Finset.univ.erase l, h l') * P l,
          fun T _ σ x v hv => ?_⟩
        rw [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, Polynomial.eval₂_mul,
          Polynomial.eval₂_mul, Polynomial.eval₂_C, ← h1 T σ x v hv, ← hv l]
        have hgl : σ (∏ l, h l) = σ (∏ l' ∈ Finset.univ.erase l, h l') * σ (h l) := by
          rw [← map_mul, Finset.prod_erase_mul _ _ (Finset.mem_univ l)]
        rw [pow_succ, hgl]
        ring
    choose N Q hQ using star
    have hv0 : ∀ l, (algebraMap κ K).comp ρ (h l) * φ (f (MvPolynomial.X l)) =
        Polynomial.eval₂ ((algebraMap κ K).comp ρ) β (P l) := by
      intro l; rw [← hP l, mul_comm]; rfl
    have hτne : ∀ l, (algebraMap κ K).comp ρ (h l) ≠ 0 := fun l =>
      (map_ne_zero (algebraMap κ K)).mpr (hh l)
    have hfφ : ∀ q, MvPolynomial.eval₂ ((algebraMap κ K).comp ρ)
        (fun l => φ (f (MvPolynomial.X l))) q = φ (f q) := by
      intro q
      have : MvPolynomial.eval₂Hom ((algebraMap κ K).comp ρ)
          (fun l => φ (f (MvPolynomial.X l))) = φ.comp f.toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro r
          change MvPolynomial.eval₂ _ _ (MvPolynomial.C r) = φ (f (MvPolynomial.C r))
          rw [MvPolynomial.eval₂_C, hfC, ← RingHom.comp_apply φ θ, hφ]
        · intro l
          change MvPolynomial.eval₂ _ _ (MvPolynomial.X l) = φ (f (MvPolynomial.X l))
          rw [MvPolynomial.eval₂_X]
      exact RingHom.congr_fun this q
    have herr : ∀ q ∈ S, Polynomial.eval₂ ((algebraMap κ K).comp ρ) β (Q q) = 0 := by
      intro q hq
      have hqk : f q = 0 := by
        have : q ∈ RingHom.ker f.toRingHom := by rw [← hS]; exact Ideal.subset_span hq
        exact RingHom.mem_ker.mp this
      rw [← hQ q K ((algebraMap κ K).comp ρ) β _ hv0, hfφ, hqk, map_zero, mul_zero]
    choose G hG using fun q : S => hmin (Q q) (herr q q.2)
    let E : S → Polynomial R := fun q => Q q - F * G q
    let J : Ideal R := ⨆ q : S, Ideal.span (↑(E q).coeffs : Set R)
    have hJfg : J.FG := Submodule.fg_iSup _ (fun q => Submodule.fg_span (Finset.finite_toSet _))
    have hJle : J ≤ RingHom.ker ρ := by
      apply iSup_le; intro q
      rw [Ideal.span_le]
      intro c hc
      obtain ⟨i, -, rfl⟩ := Polynomial.mem_coeffs_iff.mp hc
      rw [SetLike.mem_coe, RingHom.mem_ker, ← Polynomial.coeff_map, hG q, Polynomial.coeff_zero]
    have hgne : ρ (∏ l, h l) ≠ 0 := by
      rw [map_prod]; exact Finset.prod_ne_zero_iff.mpr (fun l _ => hh l)
    refine ⟨∏ l, h l, J, hgne, hJfg, hJle, ?_⟩
    intro T _ σ x hσg hσJ hFx
    have hσh : ∀ l, IsUnit (σ (h l)) := fun l =>
      isUnit_of_dvd_unit (map_dvd σ (Finset.dvd_prod_of_mem h (Finset.mem_univ l))) hσg
    let v : Fin n → T := fun l => Ring.inverse (σ (h l)) * Polynomial.eval₂ σ x (P l)
    have hv : ∀ l, σ (h l) * v l = Polynomial.eval₂ σ x (P l) := fun l =>
      Ring.mul_inverse_cancel_left _ _ (hσh l)
    have hkill : ∀ q ∈ S, MvPolynomial.eval₂Hom σ v q = 0 := by
      intro q hq
      have h1 := hQ q T σ x v hv
      have hE : Polynomial.eval₂ σ x (E ⟨q, hq⟩) = 0 := by
        rw [← Polynomial.eval_map]
        have : (E ⟨q, hq⟩).map σ = 0 := by
          ext i
          rw [Polynomial.coeff_map, Polynomial.coeff_zero]
          by_cases hi : (E ⟨q, hq⟩).coeff i = 0
          · rw [hi, map_zero]
          · exact hσJ _ (Submodule.mem_iSup_of_mem ⟨q, hq⟩
              (Ideal.subset_span (Polynomial.coeff_mem_coeffs hi)))
        rw [this, Polynomial.eval_zero]
      have h2 : Polynomial.eval₂ σ x (Q q) = 0 := by
        have : Q q = E ⟨q, hq⟩ + F * G ⟨q, hq⟩ := by simp only [E, sub_add_cancel]
        rw [this, Polynomial.eval₂_add, Polynomial.eval₂_mul, hE, hFx, zero_mul, add_zero]
      rw [h2] at h1
      exact (IsUnit.mul_right_eq_zero (hσg.pow _)).mp h1
    have hle : RingHom.ker f.toRingHom ≤ RingHom.ker (MvPolynomial.eval₂Hom σ v) := by
      rw [← hS, Ideal.span_le]
      intro q hq
      exact RingHom.mem_ker.mpr (hkill q hq)
    let ψ := (f.toRingHom.liftOfSurjective hfs) ⟨MvPolynomial.eval₂Hom σ v, hle⟩
    have hψf : ∀ q, ψ (f q) = MvPolynomial.eval₂ σ v q := fun q =>
      RingHom.liftOfSurjective_comp_apply _ hfs _ q
    refine ⟨ψ, ?_, ?_⟩
    · ext r
      rw [RingHom.comp_apply, ← hfC, hψf, MvPolynomial.eval₂_C]
    · intro χ hχ hχx
      have key : χ.comp (MvPolynomial.eval₂Hom σ v) = MvPolynomial.eval₂Hom
          ((algebraMap κ K).comp ρ) (fun l => φ (f (MvPolynomial.X l))) := by
        apply MvPolynomial.ringHom_ext
        · intro r
          change χ (MvPolynomial.eval₂ σ v (MvPolynomial.C r)) =
            MvPolynomial.eval₂ _ _ (MvPolynomial.C r)
          rw [MvPolynomial.eval₂_C, MvPolynomial.eval₂_C, ← RingHom.comp_apply χ σ, hχ]
        · intro l
          change χ (MvPolynomial.eval₂ σ v (MvPolynomial.X l)) =
            MvPolynomial.eval₂ _ _ (MvPolynomial.X l)
          rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
          have e := congrArg χ (hv l)
          rw [map_mul, Polynomial.hom_eval₂, hχ, hχx, ← RingHom.comp_apply χ σ, hχ,
            ← hv0 l] at e
          exact mul_left_cancel₀ (hτne l) e
      apply RingHom.ext
      intro a
      obtain ⟨q, rfl⟩ := hfs a
      rw [RingHom.comp_apply, hψf, ← hfφ]
      exact RingHom.congr_fun key q

  have hLB : ∀ {R κ K : Type u} [CommRing R] [Field κ] [Field K] [Algebra κ K] (ρ : R →+* κ)
      (F : Polynomial R) (β : K),
      (∀ c : K, ∃ (P : Polynomial R) (h : R), ρ h ≠ 0 ∧
        c * algebraMap κ K (ρ h) = Polynomial.eval₂ ((algebraMap κ K).comp ρ) β P) →
      (∀ P : Polynomial R, Polynomial.eval₂ ((algebraMap κ K).comp ρ) β P = 0 →
        ∃ Q : Polynomial R, (P - F * Q).map ρ = 0) →
      ∀ (ι : Type) [Finite ι] (A : ι → Type u) [∀ i, CommRing (A i)] (θ : ∀ i, R →+* A i),
      (∀ i, (θ i).FinitePresentation) → ∀ (φ : ∀ i, A i →+* K),
      (∀ i, (φ i).comp (θ i) = (algebraMap κ K).comp ρ) →
      ∃ (g : R) (J : Ideal R), ρ g ≠ 0 ∧ J.FG ∧ J ≤ RingHom.ker ρ ∧
        ∀ (T : Type u) [CommRing T] (σ : R →+* T) (x : T), IsUnit (σ g) →
          (∀ a ∈ J, σ a = 0) → Polynomial.eval₂ σ x F = 0 → ∀ i,
          ∃ ψ : A i →+* T, ψ.comp (θ i) = σ ∧ ∀ χ : T →+* K,
            χ.comp σ = (algebraMap κ K).comp ρ → χ x = β → χ.comp ψ = φ i := by
    intro R κ K _ _ _ _ ρ F β hgen hmin ι _ A _ θ hfp φ hcmp
    haveI := Fintype.ofFinite ι
    choose g J hg hJ hJle huniv using fun i =>
      hLB1 ρ F β hgen hmin (A i) (θ i) (hfp i) (φ i) (hcmp i)
    refine ⟨∏ i, g i, ⨆ i, J i, ?_, Submodule.fg_iSup _ hJ, iSup_le hJle, ?_⟩
    · rw [map_prod]; exact Finset.prod_ne_zero_iff.mpr (fun i _ => hg i)
    · intro T _ σ x hσ hσJ hF i
      exact huniv i T σ x
        (isUnit_of_dvd_unit (map_dvd σ (Finset.dvd_prod_of_mem g (Finset.mem_univ i))) hσ)
        (fun a ha => hσJ a (Submodule.mem_iSup_of_mem i ha)) hF

  intro Y _ _ y K _ _ _ _ ι _ X q hq w hw
  have specComp : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B)
      (g : B →+* C), Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) =
        Spec.map (CommRingCat.ofHom (g.comp f)) := by
    intro A B C _ _ _ f g
    rw [← Spec.map_comp, CommRingCat.ofHom_comp]
  obtain ⟨W, hW, hyW, -⟩ := exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) trivial
  obtain ⟨hYa, hfrac, hfib⟩ := hLY Y y W hW hyW
  set ρ : Γ(Y, W) →+* Y.residueField y := (Y.evaluation W y hyW).hom with hρ
  have htK : Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫
      Y.fromSpecResidueField y =
      Spec.map (CommRingCat.ofHom ((algebraMap (Y.residueField y) K).comp ρ)) ≫ hW.fromSpec := by
    rw [← hYa, ← specComp, Category.assoc, hρ, CommRingCat.ofHom_hom]
  obtain ⟨F, β, hFm, hFβ, hgen, hmin⟩ := hLA (K := K) ρ hfrac
  have hP := fun i => hLP Y (X i) (q i) (hq i) W hW K
    ((algebraMap (Y.residueField y) K).comp ρ) (w i) ((hw i).trans htK)
  choose S hS hSW φ hfp hcmp hwsp using hP
  obtain ⟨g, J, hg, hJfg, hJle, huniv⟩ := hLB ρ F β hgen hmin ι
    (fun i => Γ(X i, S i)) (fun i => ((q i).appLE W (S i) (hSW i)).hom) hfp φ hcmp
  have stage : ∀ (g : Γ(Y, W)) (J : Ideal Γ(Y, W)), J.FG → ∃ (B : Type u) (_ : CommRing B)
      (_ : Algebra Γ(Y, Y.basicOpen g) B) (_ : Algebra Γ(Y, W) B)
      (_ : IsScalarTower Γ(Y, W) Γ(Y, Y.basicOpen g) B) (r : B),
      Module.Finite Γ(Y, Y.basicOpen g) B ∧ Algebra.FinitePresentation Γ(Y, Y.basicOpen g) B ∧
      (algebraMap Γ(Y, W) B).FinitePresentation ∧ (∀ a ∈ J, algebraMap Γ(Y, W) B a = 0) ∧
      IsUnit (algebraMap Γ(Y, W) B g) ∧ Polynomial.eval₂ (algebraMap Γ(Y, W) B) r F = 0 ∧
      (∀ (T : Type u) [CommRing T] (σ : Γ(Y, W) →+* T) (x : T), IsUnit (σ g) →
        (∀ a ∈ J, σ a = 0) → Polynomial.eval₂ σ x F = 0 →
        ∃ χ : B →+* T, χ.comp (algebraMap Γ(Y, W) B) = σ ∧ χ r = x) ∧
      (∀ (T : Type u) [CommRing T] (χ₁ χ₂ : B →+* T),
        χ₁.comp (algebraMap Γ(Y, W) B) = χ₂.comp (algebraMap Γ(Y, W) B) → χ₁ r = χ₂ r →
        χ₁ = χ₂) ∧
      (∀ χ : B →+* K, χ.comp (algebraMap Γ(Y, W) B) = (algebraMap (Y.residueField y) K).comp ρ →
        χ r = β → ∀ Q : Ideal B, Q.IsPrime → Q.comap (algebraMap Γ(Y, W) B) = RingHom.ker ρ →
        Q = RingHom.ker χ) := by
    intro g J hJ
    haveI := hW.isLocalization_basicOpen g
    obtain ⟨h1, h2, h3, h4, h5, h6⟩ := hLS (R' := Γ(Y, Y.basicOpen g)) g F hFm J hJ
    refine ⟨_, inferInstance, inferInstance, inferInstance, inferInstance, AdjoinRoot.root _,
      h1, h2, h3, h4, h5, h6, ?_, ?_, ?_⟩
    · intro T _ σ x hσ hJσ hF
      exact (hLU (R' := Γ(Y, Y.basicOpen g)) g F J σ x hσ hJσ hF).1
    · intro T _ χ₁ χ₂ e1 e2
      refine (hLU (R' := Γ(Y, Y.basicOpen g)) g F J
        (χ₁.comp (algebraMap Γ(Y, W) _)) (χ₁ (AdjoinRoot.root _)) (h5.map χ₁) ?_ ?_).2
        χ₁ χ₂ e1 e2
      · intro a ha
        rw [RingHom.comp_apply, h4 a ha, map_zero]
      · rw [← Polynomial.hom_eval₂, h6, map_zero]
    · intro χ hχ hχβ Q hQ hQc
      exact hLC ρ g F β J hmin h1 χ hχ hχβ Q hQ hQc
  obtain ⟨B, _, _, _, _, r, hBfin, hBfp, hBfpR, hBJ, hBg, hBF, hBlift, hBext, hBprime⟩ :=
    stage g J hJfg
  have hτunit : ∀ a : Γ(Y, W), ρ a ≠ 0 →
      IsUnit ((algebraMap (Y.residueField y) K).comp ρ a) := by
    intro a ha
    rw [isUnit_iff_ne_zero, RingHom.comp_apply]
    intro h
    exact ha ((map_eq_zero_iff _ (algebraMap (Y.residueField y) K).injective).mp h)
  have hτker : ∀ a ∈ RingHom.ker ρ, (algebraMap (Y.residueField y) K).comp ρ a = 0 := by
    intro a ha
    rw [RingHom.comp_apply, RingHom.mem_ker.mp ha, map_zero]
  obtain ⟨χ, hχ, hχr⟩ := hBlift K ((algebraMap (Y.residueField y) K).comp ρ) β (hτunit g hg)
    (fun a ha => hτker a (hJle ha)) hFβ
  have hψ := fun i => huniv B (algebraMap Γ(Y, W) B) r hBg hBJ hBF i
  choose ψ hψθ hψχ using hψ
  haveI hεlfp0 : LocallyOfFinitePresentation
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, W) B))) := by
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)]
    exact hBfpR
  refine ⟨Spec (.of B), Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, W) B)) ≫ hW.fromSpec,
    fun i => Spec.map (CommRingCat.ofHom (ψ i)) ≫ (hS i).fromSpec, Spec.map (CommRingCat.ofHom χ),
    inferInstance, inferInstance, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro i
    rw [Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec (q i) hW (hS i) (hSW i),
      ← Category.assoc,
      show (q i).appLE W (S i) (hSW i) =
        CommRingCat.ofHom ((q i).appLE W (S i) (hSW i)).hom from rfl,
      specComp, hψθ i]
  ·
    intro i
    rw [← Category.assoc, specComp, hψχ i χ hχ hχr, hwsp i]
  ·
    rw [← Category.assoc, specComp, hχ, htK]
  ·
    intro e he
    rw [Scheme.Hom.comp_apply] at he
    have h1 : (PrimeSpectrum.comap (algebraMap Γ(Y, W) B) e).asIdeal = RingHom.ker ρ :=
      (hfib _).mp he
    have h2 := hBprime χ hχ hχr e.asIdeal e.isPrime h1
    obtain ⟨pt⟩ : Nonempty (PrimeSpectrum K) := inferInstance
    refine ⟨pt, ?_⟩
    apply PrimeSpectrum.ext
    change (PrimeSpectrum.comap χ pt).asIdeal = e.asIdeal
    rw [PrimeSpectrum.comap_asIdeal, h2, Ideal.eq_bot_of_prime pt.asIdeal]
    exact (RingHom.ker_eq_comap_bot χ).symm
  ·
    intro C hC hyC
    have hC' : Topology.IsConstructible (hW.fromSpec ⁻¹' C) :=
      hC.preimage_of_isOpenEmbedding hW.fromSpec.isOpenEmbedding
    have h𝔭 : (⟨RingHom.ker ρ, RingHom.ker_isPrime ρ⟩ : PrimeSpectrum Γ(Y, W)) ∉
        hW.fromSpec ⁻¹' C := by
      intro h
      apply hyC
      have := (hfib ⟨RingHom.ker ρ, RingHom.ker_isPrime ρ⟩).mpr rfl
      rw [← this]
      exact h
    obtain ⟨f, J₁, hf, hJ₁fg, hJ₁le, havoid⟩ := hLK _ hC' _ h𝔭
    have hf' : ρ f ≠ 0 := fun h => hf (RingHom.mem_ker.mpr h)
    have hJ₁le' : J₁ ≤ RingHom.ker ρ := hJ₁le
    have hgf : ρ (g * f) ≠ 0 := by rw [map_mul]; exact mul_ne_zero hg hf'
    obtain ⟨B', _, _, _, _, r', hB'fin, hB'fp, hB'fpR, hB'J, hB'g, hB'F, hB'lift, hB'ext,
      hB'prime⟩ := stage (g * f) (J ⊔ J₁) (Submodule.FG.sup hJfg hJ₁fg)
    obtain ⟨εO, hεOfin, hεOlfp, hεO⟩ := hLF Y W hW (g * f) B' hB'fin hB'fp
    have hgu : IsUnit (algebraMap Γ(Y, W) B' g) :=
      isUnit_of_mul_isUnit_left (by rw [← map_mul]; exact hB'g)
    have hfu : IsUnit (algebraMap Γ(Y, W) B' f) :=
      isUnit_of_mul_isUnit_right (by rw [← map_mul]; exact hB'g)
    obtain ⟨μ, hμ, hμr⟩ := hBlift B' (algebraMap Γ(Y, W) B') r' hgu
      (fun a ha => hB'J a (Ideal.mem_sup_left ha)) hB'F
    obtain ⟨χ', hχ', hχ'r⟩ := hB'lift K ((algebraMap (Y.residueField y) K).comp ρ) β
      (hτunit _ hgf) (fun a ha => hτker a (sup_le hJle hJ₁le' ha)) hFβ
    have hχμ : χ'.comp μ = χ := hBext K (χ'.comp μ) χ
      (by rw [RingHom.comp_assoc, hμ, hχ', hχ]) (by rw [RingHom.comp_apply, hμr, hχ'r, hχr])
    refine ⟨Y.basicOpen (g * f), hW.basicOpen (g * f), Spec (.of B'), εO,
      Spec.map (CommRingCat.ofHom μ), Spec.map (CommRingCat.ofHom χ'), inferInstance, hεOfin,
      hεOlfp, ?_, ?_, ?_⟩
    · rw [hεO, ← Category.assoc, specComp, hμ]
    · rw [specComp, hχμ]
    · intro e he
      rw [hεO, Scheme.Hom.comp_apply] at he
      refine havoid (PrimeSpectrum.comap (algebraMap Γ(Y, W) B') e) ?_ ?_ he
      · intro hfe
        exact e.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hfe hfu)
      · intro a ha
        change algebraMap Γ(Y, W) B' a ∈ e.asIdeal
        rw [hB'J a (Ideal.mem_sup_right ha)]
        exact zero_mem _

theorem wc_split_stratum_cover : ∀ (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] (U V : Y.Etale), CompactSpace U.left → QuasiSeparatedSpace U.left → CompactSpace V.left → QuasiSeparatedSpace V.left → ∀ y : Y, ∃ (OY : Y.Opens) (_ : IsAffineOpen OY) (E' : Scheme.{u}) (εO : E' ⟶ (OY : Scheme.{u})) (_ : IsFinite εO), y ∈ Set.range (εO ≫ OY.ι) ∧ Topology.IsConstructible (Set.range (εO ≫ OY.ι)) ∧ ∃ (k : ℕ) (ua : Fin k → (E' ⟶ U.left)) (hu : ∀ a, ua a ≫ U.hom = 𝟙 E' ≫ εO ≫ OY.ι), (∀ a, IsOpenImmersion (Limits.pullback.lift (ua a) (𝟙 E') (hu a))) ∧ (∀ (a a' : Fin k) (e e' : E'), Limits.pullback.lift (ua a) (𝟙 E') (hu a) e = Limits.pullback.lift (ua a') (𝟙 E') (hu a') e' → a = a') ∧ (∀ x : ↥(Limits.pullback U.hom (εO ≫ OY.ι)), ∃ (a : Fin k) (e : E'), Limits.pullback.lift (ua a) (𝟙 E') (hu a) e = x) ∧ ∃ (k' : ℕ) (vb : Fin k' → (E' ⟶ V.left)) (hv : ∀ b, vb b ≫ V.hom = 𝟙 E' ≫ εO ≫ OY.ι), (∀ b, IsOpenImmersion (Limits.pullback.lift (vb b) (𝟙 E') (hv b))) ∧ (∀ (b b' : Fin k') (e e' : E'), Limits.pullback.lift (vb b) (𝟙 E') (hv b) e = Limits.pullback.lift (vb b') (𝟙 E') (hv b') e' → b = b') ∧ (∀ x : ↥(Limits.pullback V.hom (εO ≫ OY.ι)), ∃ (b : Fin k') (e : E'), Limits.pullback.lift (vb b) (𝟙 E') (hv b) e = x) :=
by
  intro Y _ _ U V hU1 hU2 hV1 hV2 y
  classical
  haveI hUet : Etale U.hom := U.prop
  haveI hVet : Etale V.hom := V.prop

  have snd_lift : ∀ {T X : Scheme.{u}} {f : X ⟶ Y} {e : T ⟶ Y} (s : T ⟶ X)
      (h : s ≫ f = 𝟙 T ≫ e) (t : T),
      Limits.pullback.snd f e (Limits.pullback.lift s (𝟙 T) h t) = t := by
    intro T X f e s h t
    rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_snd]
    rfl

  have L3 : ∀ {X T : Scheme.{u}} (f : X ⟶ Y) [Etale f] (e : T ⟶ Y) (s : T ⟶ X)
      (h : s ≫ f = 𝟙 T ≫ e), IsOpenImmersion (Limits.pullback.lift s (𝟙 T) h) := by
    intro X T f _ e s h
    have he : e = s ≫ f := by rw [h, Category.id_comp]
    subst he
    have H := Limits.pullback_lift_diagonal_isPullback s f
    haveI : IsOpenImmersion (Limits.pullback.diagonal f) :=
      FormallyUnramified.isOpenImmersion_diagonal f
    haveI hL := MorphismProperty.of_isPullback (P := @IsOpenImmersion) H inferInstance
    have heq : Limits.pullback.lift s (𝟙 T) h =
        Limits.pullback.lift (𝟙 T) s (by simp) ≫ (Limits.pullbackSymmetry (s ≫ f) f).hom := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullbackSymmetry_hom_comp_fst]
        exact (Limits.pullback.lift_fst _ _ _).trans (Limits.pullback.lift_snd _ _ _).symm
      · rw [Category.assoc, Limits.pullbackSymmetry_hom_comp_snd]
        exact (Limits.pullback.lift_snd _ _ _).trans (Limits.pullback.lift_fst _ _ _).symm
    rw [heq]
    infer_instance

  have L5 : ∀ {X E0 T : Scheme.{u}} (f : X ⟶ Y) (ε : E0 ⟶ Y) (εT : T ⟶ Y) (j : T ⟶ E0)
      (hj : j ≫ ε = εT) (k : ℕ) (ua : Fin k → (E0 ⟶ X)) (hu : ∀ a, ua a ≫ f = 𝟙 E0 ≫ ε)
      (uT : Fin k → (T ⟶ X)) (hjT : ∀ a, j ≫ ua a = uT a) (hT : ∀ a, uT a ≫ f = 𝟙 T ≫ εT)
      (t : T),
      ((∀ x : ↥(Limits.pullback f ε), Limits.pullback.snd f ε x = j t →
          ∃ a, Limits.pullback.lift (ua a) (𝟙 E0) (hu a) (j t) = x) ∧
        ∀ a a', Limits.pullback.lift (ua a) (𝟙 E0) (hu a) (j t) =
          Limits.pullback.lift (ua a') (𝟙 E0) (hu a') (j t) → a = a') ↔
      ((∀ x : ↥(Limits.pullback f εT), Limits.pullback.snd f εT x = t →
          ∃ a, Limits.pullback.lift (uT a) (𝟙 T) (hT a) t = x) ∧
        ∀ a a', Limits.pullback.lift (uT a) (𝟙 T) (hT a) t =
          Limits.pullback.lift (uT a') (𝟙 T) (hT a') t → a = a') := by
    intro X E0 T f ε εT j hj k ua hu uT hjT hT t
    let M : Limits.pullback f εT ⟶ Limits.pullback f ε :=
      Limits.pullback.map f εT f ε (𝟙 X) j (𝟙 Y) (by simp) (by simp [hj])
    have hMfst : M ≫ Limits.pullback.fst f ε = Limits.pullback.fst f εT :=
      (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
    have hMsnd : M ≫ Limits.pullback.snd f ε = Limits.pullback.snd f εT ≫ j :=
      Limits.pullback.lift_snd _ _ _
    have K1 : ∀ a, Limits.pullback.lift (uT a) (𝟙 T) (hT a) ≫ M =
        j ≫ Limits.pullback.lift (ua a) (𝟙 E0) (hu a) := by
      intro a
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hMfst, Limits.pullback.lift_fst, Category.assoc,
          Limits.pullback.lift_fst, hjT]
      · rw [Category.assoc, hMsnd, Limits.pullback.lift_snd_assoc, Category.id_comp,
          Category.assoc, Limits.pullback.lift_snd, Category.comp_id]
    have K1p : ∀ a s, M (Limits.pullback.lift (uT a) (𝟙 T) (hT a) s) =
        Limits.pullback.lift (ua a) (𝟙 E0) (hu a) (j s) := by
      intro a s
      rw [← Scheme.Hom.comp_apply, K1 a, Scheme.Hom.comp_apply]
    have K2 : ∀ a (x' : ↥(Limits.pullback f εT)) (e : E0),
        M x' = Limits.pullback.lift (ua a) (𝟙 E0) (hu a) e →
        Limits.pullback.lift (uT a) (𝟙 T) (hT a) (Limits.pullback.snd f εT x') = x' := by
      intro a x' e hx
      obtain ⟨z, -, hz2⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.lift (ua a) (𝟙 E0) (hu a)) (g := M) e x' hx.symm
      subst hz2
      have hc := Limits.pullback.condition (f := Limits.pullback.lift (ua a) (𝟙 E0) (hu a)) (g := M)
      have e1 : Limits.pullback.snd (Limits.pullback.lift (ua a) (𝟙 E0) (hu a)) M ≫
          Limits.pullback.fst f εT =
          Limits.pullback.fst (Limits.pullback.lift (ua a) (𝟙 E0) (hu a)) M ≫ ua a := by
        rw [← hMfst, ← Category.assoc, ← hc, Category.assoc, Limits.pullback.lift_fst]
      have e2 : Limits.pullback.snd (Limits.pullback.lift (ua a) (𝟙 E0) (hu a)) M ≫
          Limits.pullback.snd f εT ≫ j =
          Limits.pullback.fst (Limits.pullback.lift (ua a) (𝟙 E0) (hu a)) M := by
        rw [← hMsnd, ← Category.assoc, ← hc, Category.assoc, Limits.pullback.lift_snd,
          Category.comp_id]
      have key : Limits.pullback.snd (Limits.pullback.lift (ua a) (𝟙 E0) (hu a)) M ≫
          Limits.pullback.snd f εT ≫ Limits.pullback.lift (uT a) (𝟙 T) (hT a) =
          Limits.pullback.snd (Limits.pullback.lift (ua a) (𝟙 E0) (hu a)) M := by
        apply Limits.pullback.hom_ext
        · rw [e1, Category.assoc, Category.assoc, Limits.pullback.lift_fst, ← hjT a, ← e2]
          simp only [Category.assoc]
        · rw [Category.assoc, Category.assoc, Limits.pullback.lift_snd, Category.comp_id]
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, key]
    have K3 : ∀ x : ↥(Limits.pullback f ε), Limits.pullback.snd f ε x = j t →
        ∃ x' : ↥(Limits.pullback f εT), Limits.pullback.snd f εT x' = t ∧ M x' = x := by
      intro x hx
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.snd f ε) (g := j) x t hx
      let N : Limits.pullback (Limits.pullback.snd f ε) j ⟶ Limits.pullback f εT :=
        Limits.pullback.lift (Limits.pullback.fst _ _ ≫ Limits.pullback.fst f ε)
          (Limits.pullback.snd _ _) (by
            rw [Category.assoc, Limits.pullback.condition, ← Category.assoc,
              Limits.pullback.condition, Category.assoc, hj])
      have hNM : N ≫ M = Limits.pullback.fst (Limits.pullback.snd f ε) j := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hMfst, Limits.pullback.lift_fst]
        · rw [Category.assoc, hMsnd, Limits.pullback.lift_snd_assoc, Limits.pullback.condition]
      refine ⟨N z, ?_, ?_⟩
      · rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_snd, hz2]
      · rw [← Scheme.Hom.comp_apply, hNM, hz1]
    constructor
    · rintro ⟨hcov, hdisj⟩
      refine ⟨fun x' hx' => ?_, fun a a' haa => ?_⟩
      · have hMx : Limits.pullback.snd f ε (M x') = j t := by
          rw [← Scheme.Hom.comp_apply, hMsnd, Scheme.Hom.comp_apply, hx']
        obtain ⟨a, ha⟩ := hcov (M x') hMx
        refine ⟨a, ?_⟩
        have := K2 a x' (j t) ha.symm
        rw [hx'] at this
        exact this
      · apply hdisj a a'
        rw [← K1p, ← K1p, haa]
    · rintro ⟨hcov, hdisj⟩
      refine ⟨fun x hx => ?_, fun a a' haa => ?_⟩
      · obtain ⟨x', hx't, hMx'⟩ := K3 x hx
        obtain ⟨a, ha⟩ := hcov x' hx't
        exact ⟨a, by rw [← hMx', ← ha, K1p]⟩
      · apply hdisj a a'
        have h1 := K2 a' (Limits.pullback.lift (uT a) (𝟙 T) (hT a) t) (j t) (by rw [K1p, haa])
        rw [snd_lift] at h1
        exact h1.symm

  have L4 : ∀ {E0 : Scheme.{u}} [CompactSpace E0] [QuasiSeparatedSpace E0] (ε : E0 ⟶ Y)
      (W : Y.Etale), CompactSpace W.left → QuasiSeparatedSpace W.left →
      ∀ (k : ℕ) (ua : Fin k → (E0 ⟶ W.left)) (hu : ∀ a, ua a ≫ W.hom = 𝟙 E0 ≫ ε),
      Topology.IsConstructible {e : E0 | ¬ ((∀ x : ↥(Limits.pullback W.hom ε),
        Limits.pullback.snd W.hom ε x = e →
          ∃ a, Limits.pullback.lift (ua a) (𝟙 E0) (hu a) e = x) ∧
        ∀ a a', Limits.pullback.lift (ua a) (𝟙 E0) (hu a) e =
          Limits.pullback.lift (ua a') (𝟙 E0) (hu a') e → a = a')} := by
    intro E0 _ _ ε W hW1 hW2 k ua hu
    haveI : Etale W.hom := W.prop
    haveI : QuasiCompact W.hom :=
      @quasiCompact_of_compactSpace _ _ W.hom hW1 (inferInstanceAs (QuasiSeparatedSpace Y))
    haveI : QuasiSeparated W.hom := @QuasiSeparated.of_quasiSeparatedSpace _ _ W.hom hW2
    haveI : QuasiCompact (Limits.pullback.snd W.hom ε) := inferInstance
    haveI : CompactSpace ↥(Limits.pullback W.hom ε) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd W.hom ε)
    haveI : QuasiSeparatedSpace ↥(Limits.pullback W.hom ε) :=
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd W.hom ε)
    have hGc : ∀ a, Topology.IsConstructible
        (Set.range (Limits.pullback.lift (ua a) (𝟙 E0) (hu a))) := by
      intro a
      haveI := L3 W.hom ε (ua a) (hu a)
      have ho : IsOpen (Set.range (Limits.pullback.lift (ua a) (𝟙 E0) (hu a))) :=
        IsOpenImmersion.isOpen_range _
      exact IsRetrocompact.isConstructible ho
        ((isCompact_range (Scheme.Hom.continuous _)).isRetrocompact ho)
    have hQc : Topology.IsConstructible
        ((⋃ a, Set.range (Limits.pullback.lift (ua a) (𝟙 E0) (hu a)))ᶜ ∪
          ⋃ p : {p : Fin k × Fin k // p.1 ≠ p.2},
            (Set.range (Limits.pullback.lift (ua p.1.1) (𝟙 E0) (hu p.1.1)) ∩
              Set.range (Limits.pullback.lift (ua p.1.2) (𝟙 E0) (hu p.1.2)))) :=
      (Topology.IsConstructible.iUnion hGc).compl.union
        (Topology.IsConstructible.iUnion (fun p => (hGc _).inter (hGc _)))
    convert Scheme.Hom.isConstructible_image (Limits.pullback.snd W.hom ε) hQc using 1
    ext e
    simp only [Set.mem_setOf_eq, Set.mem_image]
    constructor
    · intro he
      by_contra hne
      apply he
      constructor
      · intro x hx
        by_contra hno
        apply hne
        refine ⟨x, Or.inl ?_, hx⟩
        intro hmem
        obtain ⟨a, e', he'⟩ := Set.mem_iUnion.mp hmem
        apply hno
        refine ⟨a, ?_⟩
        have : e' = e := by rw [← hx, ← he', snd_lift]
        rw [← this]
        exact he'
      · intro a a' h
        by_contra hne'
        apply hne
        refine ⟨Limits.pullback.lift (ua a) (𝟙 E0) (hu a) e, Or.inr ?_, snd_lift _ _ _⟩
        exact Set.mem_iUnion.mpr ⟨⟨(a, a'), hne'⟩, ⟨e, rfl⟩, ⟨e, h.symm⟩⟩
    · rintro ⟨x, hxQ, rfl⟩ ⟨hcov, hdisj⟩
      rcases hxQ with hx | hx
      · obtain ⟨a, ha⟩ := hcov x rfl
        exact hx (Set.mem_iUnion.mpr ⟨a, _, ha⟩)
      · obtain ⟨⟨⟨a, a'⟩, hne⟩, ⟨e1, he1⟩, ⟨e2, he2⟩⟩ := Set.mem_iUnion.mp hx
        apply hne
        apply hdisj a a'
        have h1 : e1 = Limits.pullback.snd W.hom ε x := by rw [← he1, snd_lift]
        have h2 : e2 = Limits.pullback.snd W.hom ε x := by rw [← he2, snd_lift]
        have h3 := he1.trans he2.symm
        rw [h1, h2] at h3
        exact h3

  obtain ⟨K, _, _, _, _, k, uK, huK, hKd, hKc, k', vK, hvK, hKdV, hKcV⟩ :=
    wc_etale_fiber_split_field Y y U V hU1 hU2 hV1 hV2
  let W : Fin k ⊕ Fin k' → Y.Etale := Sum.elim (fun _ => U) (fun _ => V)
  have hWlfp : ∀ i, LocallyOfFinitePresentation (W i).hom := by
    intro i
    haveI : Etale (W i).hom := (W i).prop
    infer_instance
  let w : ∀ i, Spec (.of K) ⟶ (W i).left := fun i => match i with
    | Sum.inl a => uK a
    | Sum.inr b => vK b
  have hw : ∀ i, w i ≫ (W i).hom =
      Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K)) ≫
        Y.fromSpecResidueField y := by
    rintro (a | b)
    · exact (huK a).trans (Category.id_comp _)
    · exact (hvK b).trans (Category.id_comp _)
  obtain ⟨E0, ε, u, j, hE0, hεlfp, hu, hju, hjε, hfib, hrefine⟩ :=
    wc_stage_spread Y y K (Fin k ⊕ Fin k') (fun i => (W i).left) (fun i => (W i).hom) hWlfp w hw
  haveI := hE0
  haveI := hεlfp
  let ua : Fin k → (E0 ⟶ U.left) := fun a => u (Sum.inl a)
  let vb : Fin k' → (E0 ⟶ V.left) := fun b => u (Sum.inr b)
  have hua : ∀ a, ua a ≫ U.hom = 𝟙 E0 ≫ ε := fun a =>
    (hu (Sum.inl a)).trans (Category.id_comp _).symm
  have hvb : ∀ b, vb b ≫ V.hom = 𝟙 E0 ≫ ε := fun b =>
    (hu (Sum.inr b)).trans (Category.id_comp _).symm

  have hjgoodU : ∀ t, ((∀ x : ↥(Limits.pullback U.hom ε), Limits.pullback.snd U.hom ε x = j t →
      ∃ a, Limits.pullback.lift (ua a) (𝟙 E0) (hua a) (j t) = x) ∧
      ∀ a a', Limits.pullback.lift (ua a) (𝟙 E0) (hua a) (j t) =
        Limits.pullback.lift (ua a') (𝟙 E0) (hua a') (j t) → a = a') := by
    intro t
    refine (L5 U.hom ε _ j hjε k ua hua uK (fun a => hju (Sum.inl a)) huK t).mpr
      ⟨fun x hx => ?_, fun a a' h => hKd a a' t t h⟩
    obtain ⟨a, e, he⟩ := hKc x
    refine ⟨a, ?_⟩
    have : e = t := by rw [← hx, ← he, snd_lift]
    rw [← this]
    exact he
  have hjgoodV : ∀ t, ((∀ x : ↥(Limits.pullback V.hom ε), Limits.pullback.snd V.hom ε x = j t →
      ∃ b, Limits.pullback.lift (vb b) (𝟙 E0) (hvb b) (j t) = x) ∧
      ∀ b b', Limits.pullback.lift (vb b) (𝟙 E0) (hvb b) (j t) =
        Limits.pullback.lift (vb b') (𝟙 E0) (hvb b') (j t) → b = b') := by
    intro t
    refine (L5 V.hom ε _ j hjε k' vb hvb vK (fun b => hju (Sum.inr b)) hvK t).mpr
      ⟨fun x hx => ?_, fun b b' h => hKdV b b' t t h⟩
    obtain ⟨b, e, he⟩ := hKcV x
    refine ⟨b, ?_⟩
    have : e = t := by rw [← hx, ← he, snd_lift]
    rw [← this]
    exact he

  have hBU := L4 ε U hU1 hU2 k ua hua
  have hBV := L4 ε V hV1 hV2 k' vb hvb
  haveI : QuasiCompact ε := quasiCompact_of_compactSpace ε
  have hC := Scheme.Hom.isConstructible_image ε (hBU.union hBV)
  obtain ⟨OY, hOY, E', εO, m, j', hE', hεOfin, hεOlfp, hmε, hj'm, havoid⟩ := hrefine _ hC (by
    rintro ⟨e, he, hey⟩
    obtain ⟨t, rfl⟩ := hfib e hey
    rcases he with h | h
    · exact h (hjgoodU t)
    · exact h (hjgoodV t))
  haveI := hE'
  haveI := hεOfin
  haveI := hεOlfp
  have hu' : ∀ a, (m ≫ ua a) ≫ U.hom = 𝟙 E' ≫ εO ≫ OY.ι := fun a => by
    rw [Category.assoc, hua a, Category.id_comp ε, hmε, Category.id_comp]
  have hv' : ∀ b, (m ≫ vb b) ≫ V.hom = 𝟙 E' ≫ εO ≫ OY.ι := fun b => by
    rw [Category.assoc, hvb b, Category.id_comp ε, hmε, Category.id_comp]
  have hgoodU : ∀ e : E', (∀ x : ↥(Limits.pullback U.hom (εO ≫ OY.ι)),
      Limits.pullback.snd U.hom (εO ≫ OY.ι) x = e →
        ∃ a, Limits.pullback.lift (m ≫ ua a) (𝟙 E') (hu' a) e = x) ∧
      ∀ a a', Limits.pullback.lift (m ≫ ua a) (𝟙 E') (hu' a) e =
        Limits.pullback.lift (m ≫ ua a') (𝟙 E') (hu' a') e → a = a' := by
    intro e
    refine (L5 U.hom ε (εO ≫ OY.ι) m hmε k ua hua (fun a => m ≫ ua a) (fun a => rfl) hu' e).mp ?_
    by_contra hng
    apply havoid e
    rw [← hmε, Scheme.Hom.comp_apply]
    exact ⟨m e, Or.inl hng, rfl⟩
  have hgoodV : ∀ e : E', (∀ x : ↥(Limits.pullback V.hom (εO ≫ OY.ι)),
      Limits.pullback.snd V.hom (εO ≫ OY.ι) x = e →
        ∃ b, Limits.pullback.lift (m ≫ vb b) (𝟙 E') (hv' b) e = x) ∧
      ∀ b b', Limits.pullback.lift (m ≫ vb b) (𝟙 E') (hv' b) e =
        Limits.pullback.lift (m ≫ vb b') (𝟙 E') (hv' b') e → b = b' := by
    intro e
    refine (L5 V.hom ε (εO ≫ OY.ι) m hmε k' vb hvb (fun b => m ≫ vb b) (fun b => rfl) hv' e).mp ?_
    by_contra hng
    apply havoid e
    rw [← hmε, Scheme.Hom.comp_apply]
    exact ⟨m e, Or.inr hng, rfl⟩
  obtain ⟨t0⟩ : Nonempty (Spec (.of K)) := inferInstance
  refine ⟨OY, hOY, E', εO, hεOfin, ?_, ?_, k, fun a => m ≫ ua a, hu',
    fun a => L3 U.hom _ _ (hu' a), ?_, ?_, k', fun b => m ≫ vb b, hv',
    fun b => L3 V.hom _ _ (hv' b), ?_, ?_⟩
  · refine ⟨j' t0, ?_⟩
    rw [← hmε, ← Scheme.Hom.comp_apply, ← Category.assoc, hj'm, hjε, Scheme.Hom.comp_apply]
    have h : (Y.fromSpecResidueField y)
        ((Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField y) K))) t0) ∈
        Set.range (Y.fromSpecResidueField y) := ⟨_, rfl⟩
    rw [Scheme.range_fromSpecResidueField] at h
    exact h
  · haveI : QuasiCompact (εO ≫ OY.ι) := quasiCompact_of_compactSpace _
    rw [← Set.image_univ]
    exact Scheme.Hom.isConstructible_image _ Topology.IsConstructible.univ
  · intro a a' e e' h
    have h' : Limits.pullback.lift (m ≫ ua a) (𝟙 E') (hu' a) e =
        Limits.pullback.lift (m ≫ ua a') (𝟙 E') (hu' a') e' := h
    have hee : e = e' := by rw [← snd_lift (m ≫ ua a) (hu' a) e, h', snd_lift]
    subst hee
    exact (hgoodU e).2 a a' h'
  · intro x
    obtain ⟨a, ha⟩ := (hgoodU _).1 x rfl
    exact ⟨a, _, ha⟩
  · intro b b' e e' h
    have h' : Limits.pullback.lift (m ≫ vb b) (𝟙 E') (hv' b) e =
        Limits.pullback.lift (m ≫ vb b') (𝟙 E') (hv' b') e' := h
    have hee : e = e' := by rw [← snd_lift (m ≫ vb b) (hv' b) e, h', snd_lift]
    subst hee
    exact (hgoodV e).2 b b' h'
  · intro x
    obtain ⟨b, hb⟩ := (hgoodV _).1 x rfl
    exact ⟨b, _, hb⟩

theorem wc_normalization_iso_over_finite_locus : ∀ (X Y : Scheme.{u}) (ε : X ⟶ Y) [QuasiCompact ε] [QuasiSeparated ε] (OY : Y.Opens), IsAffineOpen OY → ∀ (εO : X ⟶ (OY : Scheme.{u})), IsFinite εO → εO ≫ OY.ι = ε → IsOpenImmersion ε.toNormalization ∧ Set.range ε.toNormalization = ε.fromNormalization ⁻¹' (OY : Set Y) ∧ Dense (Set.range ε.toNormalization) ∧ ∃ (n : ℕ) (t : Fin n → Γ(ε.normalization, ε.fromNormalization ⁻¹ᵁ OY)), ∀ x : Γ(ε.normalization, ε.fromNormalization ⁻¹ᵁ OY), ∃ c : Fin n → Γ(Y, OY), x = ∑ l, (ε.fromNormalization.appLE OY (ε.fromNormalization ⁻¹ᵁ OY) le_rfl).hom (c l) * t l :=
by
  intro X Y ε _ _ OY hOY εO hεO hε
  haveI := hεO
  haveI : IsAffine (OY : Scheme.{u}) := hOY
  haveI : IsAffine X := isAffine_of_isAffineHom εO

  have hsurj : ∀ {A B : Scheme.{u}} (g : A ⟶ B), IsIso g → Function.Surjective g := by
    intro A B g hg b
    exact ⟨(asIso g).inv b, Scheme.inv_hom_apply (asIso g) b⟩
  have hrange : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C), Function.Surjective f →
      Set.range (f ≫ g) = Set.range g := by
    intro A B C f g hf
    ext x
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨f a, (Scheme.Hom.comp_apply f g a).symm⟩
    · rintro ⟨b, rfl⟩
      obtain ⟨a, rfl⟩ := hf b
      exact ⟨a, Scheme.Hom.comp_apply f g a⟩

  have htop : ε ⁻¹ᵁ OY = ⊤ := by
    subst hε
    rw [Scheme.Hom.comp_preimage, Scheme.Opens.ι_preimage_self, Scheme.Hom.preimage_top]
  have hAff : IsAffineOpen (ε ⁻¹ᵁ OY) := by
    rw [htop]; exact isAffineOpen_top X
  have hfin : (ε.app OY).hom.Finite := by
    subst hε
    have h : IsAffineOpen (OY.ι ⁻¹ᵁ OY) := by
      rw [Scheme.Opens.ι_preimage_self]; exact isAffineOpen_top _
    have h1 : (εO.app (OY.ι ⁻¹ᵁ OY)).hom.Finite := IsFinite.finite_app εO _ h
    haveI := Scheme.Hom.isIso_app OY.ι OY (Scheme.Opens.opensRange_ι OY).ge
    have h2 : (OY.ι.app OY).hom.Finite :=
      RingHom.Finite.of_surjective _ (ConcreteCategory.bijective_of_isIso (OY.ι.app OY)).2
    have h3 := RingHom.Finite.comp h1 h2
    rw [Scheme.Hom.comp_app]
    exact h3

  letI : Algebra Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) := (ε.app OY).hom.toAlgebra
  haveI hModA : Module.Finite Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) := hfin
  have hint : Algebra.IsIntegral Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) :=
    algebraMap_isIntegral_iff.mp hfin.to_isIntegral
  have htopI : integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY) = ⊤ :=
    integralClosure_eq_top_iff.mpr hint
  have hbij : Function.Bijective (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val := by
    refine ⟨Subtype.val_injective, fun a => ⟨⟨a, ?_⟩, rfl⟩⟩
    rw [htopI]; trivial
  haveI hσ : IsIso (CommRingCat.ofHom
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr hbij

  have key : (ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization = (ε ⁻¹ᵁ OY).toSpecΓ ≫
      Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
      ε.normalizationOpenCover.f ⟨OY, hOY⟩ :=
    Scheme.Hom.ι_toNormalization ε ⟨OY, hOY⟩
  haveI hj : IsIso (ε ⁻¹ᵁ OY).ι := by
    rw [← Scheme.isoOfEq_hom_ι X htop, ← Scheme.topIso_hom]
    infer_instance
  haveI hT : IsIso (ε ⁻¹ᵁ OY).toSpecΓ := by
    rw [← hAff.isoSpec_hom]; infer_instance
  have hc : IsOpenImmersion (ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
    ε.normalizationOpenCover.map_prop _
  have hS : IsIso (Spec.map (CommRingCat.ofHom
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom)) := by
    first
    | infer_instance
    | exact Functor.map_isIso Scheme.Spec _
  have hS' : IsOpenImmersion (Spec.map (CommRingCat.ofHom
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom)) := IsOpenImmersion.of_isIso _
  have hT' : IsOpenImmersion (ε ⁻¹ᵁ OY).toSpecΓ := IsOpenImmersion.of_isIso _
  have h2 : IsOpenImmersion (Spec.map (CommRingCat.ofHom
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
      ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
    MorphismProperty.comp_mem @IsOpenImmersion _ _ hS' hc
  have h3 : IsOpenImmersion ((ε ⁻¹ᵁ OY).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
      ε.normalizationOpenCover.f ⟨OY, hOY⟩) :=
    MorphismProperty.comp_mem @IsOpenImmersion _ _ hT' h2
  have hOI : IsOpenImmersion ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) := by
    rw [key]; exact h3
  have hι : IsOpenImmersion ε.toNormalization := by
    have e : ε.toNormalization =
        inv (ε ⁻¹ᵁ OY).ι ≫ ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) := by
      rw [IsIso.inv_hom_id_assoc]
    rw [e]
    exact MorphismProperty.comp_mem @IsOpenImmersion _ _ (IsOpenImmersion.of_isIso _) hOI
  have hrng : Set.range ε.toNormalization = ε.fromNormalization ⁻¹' (OY : Set Y) := by
    have e1 := hrange (ε ⁻¹ᵁ OY).ι ε.toNormalization (hsurj _ hj)
    have e2 := hrange (ε ⁻¹ᵁ OY).toSpecΓ (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
      ε.normalizationOpenCover.f ⟨OY, hOY⟩) (hsurj _ hT)
    have e3 := hrange (Spec.map (CommRingCat.ofHom
        (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom))
      (ε.normalizationOpenCover.f ⟨OY, hOY⟩) (hsurj _ hS)
    have e4 : Set.range (ε.normalizationOpenCover.f ⟨OY, hOY⟩) =
        ε.fromNormalization ⁻¹' (OY : Set Y) := by
      have h := congrArg (fun U : ε.normalization.Opens => (U : Set ε.normalization))
        (Scheme.Hom.fromNormalization_preimage ε ⟨OY, hOY⟩)
      exact h.symm
    have e5 : Set.range ((ε ⁻¹ᵁ OY).ι ≫ ε.toNormalization) =
        Set.range ((ε ⁻¹ᵁ OY).toSpecΓ ≫ Spec.map (CommRingCat.ofHom
          (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toRingHom) ≫
          ε.normalizationOpenCover.f ⟨OY, hOY⟩) := by
      rw [key]
    exact e1.symm.trans (e5.trans (e2.trans (e3.trans e4)))

  have hModI : Module.Finite Γ(Y, OY) (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)) :=
    Module.Finite.equiv (LinearEquiv.ofBijective
      (integralClosure Γ(Y, OY) Γ(X, ε ⁻¹ᵁ OY)).val.toLinearMap hbij).symm
  have hφ : (ε.fromNormalization.appLE OY (ε.fromNormalization ⁻¹ᵁ OY) le_rfl).hom.Finite := by
    rw [← Scheme.Hom.app_eq_appLE, Scheme.Hom.fromNormalization_app ε hOY, CommRingCat.hom_comp,
      CommRingCat.hom_ofHom]
    refine RingHom.Finite.comp ?_ ?_
    · exact RingHom.Finite.of_surjective _
        (ConcreteCategory.bijective_of_isIso (ε.normalizationObjIso hOY).inv).2
    · exact RingHom.finite_algebraMap.mpr hModI
  refine ⟨hι, hrng, Scheme.Hom.denseRange ε.toNormalization, ?_⟩
  letI : Algebra Γ(Y, OY) Γ(ε.normalization, ε.fromNormalization ⁻¹ᵁ OY) :=
    (ε.fromNormalization.appLE OY (ε.fromNormalization ⁻¹ᵁ OY) le_rfl).hom.toAlgebra
  haveI : Module.Finite Γ(Y, OY) Γ(ε.normalization, ε.fromNormalization ⁻¹ᵁ OY) := hφ
  obtain ⟨n, t, ht⟩ := Module.Finite.exists_fin (R := Γ(Y, OY))
    (M := Γ(ε.normalization, ε.fromNormalization ⁻¹ᵁ OY))
  refine ⟨n, t, fun x => ?_⟩
  have hx : x ∈ Submodule.span Γ(Y, OY) (Set.range t) := by rw [ht]; trivial
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hx
  refine ⟨c, ?_⟩
  rw [← hc]
  exact Finset.sum_congr rfl fun l _ => rfl

theorem wc_normalization_clopen_extension : ∀ (X Y : Scheme.{u}) (ε : X ⟶ Y) [QuasiCompact ε] [QuasiSeparated ε], IsOpenImmersion ε.toNormalization → Dense (Set.range ε.toNormalization) → ∀ (U : Y.Etale) (k : ℕ) (Ω' : Fin k → Set ↥(Limits.pullback U.hom ε)), (∀ a, IsClopen (Ω' a)) → (∀ x, ∃! a, x ∈ Ω' a) → ∃ Ω : Fin k → Set ↥(Limits.pullback U.hom ε.fromNormalization), (∀ a, IsClopen (Ω a)) ∧ (∀ x, ∃! a, x ∈ Ω a) ∧ ∀ a, (Limits.pullback.map U.hom ε U.hom ε.fromNormalization (𝟙 _) ε.toNormalization (𝟙 _) (by simp) (by rw [Category.comp_id, Scheme.Hom.toNormalization_fromNormalization])) ⁻¹' Ω a = Ω' a :=
by
  intro X Y ε _ _ _ _ U k Ω' hΩc hΩp
  classical

  have hK : ∀ (X' S : Scheme.{u}) (g : X' ⟶ S) [QuasiCompact g] [QuasiSeparated g] (Q : Set X'),
      IsClopen Q → ∃ QN : Set g.normalization, IsClopen QN ∧ g.toNormalization ⁻¹' QN = Q := by
    intro X' S g _ _ Q hQ
    let O1 : X'.Opens := ⟨Q, hQ.isOpen⟩
    let O2 : X'.Opens := ⟨Qᶜ, hQ.isClosed.isOpen_compl⟩
    have hc1 : IsClosed (Set.range O1.ι) := by rw [Scheme.Opens.range_ι]; exact hQ.isClosed
    have hc2 : IsClosed (Set.range O2.ι) := by
      rw [Scheme.Opens.range_ι]; exact hQ.isOpen.isClosed_compl
    haveI : IsClosedImmersion O1.ι := IsClosedImmersion.of_isPreimmersion _ hc1
    haveI : IsClosedImmersion O2.ι := IsClosedImmersion.of_isPreimmersion _ hc2
    have hcompl : IsCompl O1.ι.opensRange O2.ι.opensRange := by
      rw [Scheme.Opens.opensRange_ι, Scheme.Opens.opensRange_ι]
      constructor
      · rw [disjoint_iff]
        ext x
        simp [O1, O2]
      · rw [codisjoint_iff]
        ext x
        simp [O1, O2]
    obtain ⟨e⟩ := nonempty_isColimit_binaryCofanMk_of_isCompl O1.ι O2.ι hcompl
    have hcl := isCompl_range_inl_inr (O1.ι ≫ g).normalization (O2.ι ≫ g).normalization
    refine ⟨(g.normalizationCoprodIso e).inv ⁻¹' Set.range
      (Limits.coprod.inl : (O1.ι ≫ g).normalization ⟶ _), ?_, ?_⟩
    · apply IsClopen.preimage _ (g.normalizationCoprodIso e).inv.continuous
      have h1 : IsOpen (Set.range (Limits.coprod.inl : (O1.ι ≫ g).normalization ⟶
          (O1.ι ≫ g).normalization ⨿ (O2.ι ≫ g).normalization)) :=
        IsOpenImmersion.isOpen_range _
      have h2 : IsOpen (Set.range (Limits.coprod.inr : (O2.ι ≫ g).normalization ⟶
          (O1.ι ≫ g).normalization ⨿ (O2.ι ≫ g).normalization)) :=
        IsOpenImmersion.isOpen_range _
      refine ⟨?_, h1⟩
      rw [hcl.eq_compl]
      exact h2.isClosed_compl
    · ext x
      simp only [Set.mem_preimage]
      constructor
      · intro hx
        by_contra hxQ
        have hx2 : x ∈ Set.range O2.ι := by rw [Scheme.Opens.range_ι]; exact hxQ
        obtain ⟨y, rfl⟩ := hx2
        have h := congrArg (fun φ => φ y) (g.inr_toNormalization_normalizationCoprodIso_inv e)
        simp only [Scheme.Hom.comp_apply] at h
        rw [h] at hx
        exact Set.disjoint_left.mp hcl.disjoint hx ⟨_, rfl⟩
      · intro hx
        have hx1 : x ∈ Set.range O1.ι := by rw [Scheme.Opens.range_ι]; exact hx
        obtain ⟨y, rfl⟩ := hx1
        have h := congrArg (fun φ => φ y) (g.inl_toNormalization_normalizationCoprodIso_inv e)
        simp only [Scheme.Hom.comp_apply] at h
        rw [h]
        exact ⟨_, rfl⟩

  have hP : ∀ (X' S : Scheme.{u}) (g : X' ⟶ S) [QuasiCompact g] [QuasiSeparated g]
      (Ω₀ : Fin k → Set X'), (∀ a, IsClopen (Ω₀ a)) → (∀ x, ∃! a, x ∈ Ω₀ a) →
      ∃ ΩN : Fin k → Set g.normalization, (∀ a, IsClopen (ΩN a)) ∧ (∀ x, ∃! a, x ∈ ΩN a) ∧
        ∀ a, g.toNormalization ⁻¹' ΩN a = Ω₀ a := by
    intro X' S g _ _ Ω₀ hc hp
    choose ΩN hNc hNpre using fun a => hK X' S g (Ω₀ a) (hc a)
    have hd : Dense (Set.range g.toNormalization) := g.toNormalization.denseRange
    have hempty : ∀ N : Set g.normalization, IsOpen N → g.toNormalization ⁻¹' N = ∅ → N = ∅ := by
      intro N hN hpre
      by_contra hne
      obtain ⟨_, ⟨x, rfl⟩, hx⟩ := hd.exists_mem_open hN (Set.nonempty_iff_ne_empty.mpr hne)
      have hx' : x ∈ g.toNormalization ⁻¹' N := hx
      rw [hpre] at hx'
      exact hx'
    refine ⟨ΩN, hNc, fun z => ?_, hNpre⟩
    have hcov : (⋃ a, ΩN a)ᶜ = ∅ := by
      apply hempty _ (isClosed_iUnion_of_finite (fun a => (hNc a).isClosed)).isOpen_compl
      ext x
      simp only [Set.preimage_compl, Set.preimage_iUnion, hNpre, Set.mem_compl_iff,
        Set.mem_iUnion, Set.mem_empty_iff_false, iff_false, not_not]
      obtain ⟨a, ha, -⟩ := hp x
      exact ⟨a, ha⟩
    have hz : z ∈ ⋃ a, ΩN a := by
      by_contra h
      have h' : z ∈ (⋃ a, ΩN a)ᶜ := h
      rw [hcov] at h'
      exact h'
    obtain ⟨a, ha⟩ := Set.mem_iUnion.mp hz
    refine ⟨a, ha, fun b hb => ?_⟩
    by_contra hba
    have h0 : ΩN b ∩ ΩN a = ∅ := by
      apply hempty _ ((hNc b).isOpen.inter (hNc a).isOpen)
      ext x
      simp only [Set.preimage_inter, hNpre, Set.mem_inter_iff, Set.mem_empty_iff_false,
        iff_false, not_and]
      intro hxb hxa
      exact hba ((hp x).unique hxb hxa)
    have h' : z ∈ ΩN b ∩ ΩN a := ⟨hb, ha⟩
    rw [h0] at h'
    exact h'

  obtain ⟨ΩN, hNc, hNp, hNpre⟩ := hP _ _ (Limits.pullback.snd ε U.hom)
    (fun a => (Limits.pullbackSymmetry U.hom ε).inv ⁻¹' Ω' a)
    (fun a => (hΩc a).preimage (Limits.pullbackSymmetry U.hom ε).inv.continuous)
    (fun x => hΩp ((Limits.pullbackSymmetry U.hom ε).inv x))
  let Φ : (Limits.pullback.snd ε U.hom).normalization ≅
      Limits.pullback U.hom ε.fromNormalization :=
    asIso (ε.normalizationPullback U.hom) ≪≫ Limits.pullbackSymmetry ε.fromNormalization U.hom
  refine ⟨fun a => Φ.inv ⁻¹' ΩN a, fun a => (hNc a).preimage Φ.inv.continuous,
    fun x => hNp (Φ.inv x), fun a => ?_⟩
  have hj : Limits.pullback.map U.hom ε U.hom ε.fromNormalization (𝟙 _) ε.toNormalization (𝟙 _)
      (by simp) (by rw [Category.comp_id, Scheme.Hom.toNormalization_fromNormalization]) =
      (Limits.pullbackSymmetry U.hom ε).hom ≫ (Limits.pullback.snd ε U.hom).toNormalization ≫
        Φ.hom := by
    apply Limits.pullback.hom_ext
    · simp only [Φ, Iso.trans_hom, asIso_hom, Category.assoc,
        Limits.pullbackSymmetry_hom_comp_fst, Scheme.Hom.normalizationPullback_snd]
      rw [Limits.pullback.lift_fst, Category.comp_id]
      simp
    · simp only [Φ, Iso.trans_hom, asIso_hom, Category.assoc,
        Limits.pullbackSymmetry_hom_comp_snd, Scheme.Hom.toNormalization_normalizationPullback_fst]
      rw [Limits.pullback.lift_snd]
      simp
  rw [hj]
  ext x
  simp only [Set.mem_preimage, Scheme.Hom.comp_apply, Scheme.hom_inv_apply]
  have h := congrArg (fun s => (Limits.pullbackSymmetry U.hom ε).hom x ∈ s) (hNpre a)
  simpa [Scheme.hom_inv_apply] using h

theorem wc_clopen_partition_descends_finite_stage : ∀ (Y W : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] (π : W ⟶ Y) [IsAffineHom π] (U : Y.Etale), CompactSpace U.left → ∀ (k : ℕ) (Ω : Fin k → Set ↥(Limits.pullback U.hom π)), (∀ a, IsClopen (Ω a)) → (∀ x, ∃! a, x ∈ Ω a) → ∃ (n : ℕ) (Vs : Fin n → Y.Opens) (_ : ∀ i, IsAffineOpen (Vs i)) (w : ∀ i, Γ(W, π ⁻¹ᵁ Vs i)), ∀ (Z : Scheme.{u}) (p : Z ⟶ Y) (r : W ⟶ Z) [IsAffineHom p] (hr : r ≫ p = π), Function.Surjective r → (∀ V' : Y.Opens, IsAffineOpen V' → Function.Injective (r.appLE (p ⁻¹ᵁ V') (π ⁻¹ᵁ V') (by rw [← hr]; exact le_rfl)).hom) → (∀ i, w i ∈ Set.range (r.appLE (p ⁻¹ᵁ Vs i) (π ⁻¹ᵁ Vs i) (by rw [← hr]; exact le_rfl)).hom) → ∃ Θ : Fin k → Set ↥(Limits.pullback U.hom p), (∀ a, IsClopen (Θ a)) ∧ (∀ x, ∃! a, x ∈ Θ a) ∧ ∀ a, (Limits.pullback.map U.hom π U.hom p (𝟙 _) r (𝟙 _) (by simp) (by rw [Category.comp_id, hr])) ⁻¹' Θ a = Ω a :=
by
  intro Y W _ _ π _ U hUc k Ω hΩc hΩp
  classical

  have s1 : ∀ {P Q : Type u} [TopologicalSpace Q] (M : P → Q), Function.Surjective M →
      ∀ (k N : ℕ) (Ω : Fin k → Set P), (∀ x, ∃! a, x ∈ Ω a) → ∀ (C : Fin N → Set Q),
      (∀ y, ∃ l, y ∈ C l) → ∀ (G : Fin k → Fin N → Set Q), (∀ a l, IsOpen (G a l)) →
      (∀ a l, M ⁻¹' (G a l) = Ω a ∩ M ⁻¹' (C l)) →
      ∃ Θ : Fin k → Set Q, (∀ a, IsClopen (Θ a)) ∧ (∀ y, ∃! a, y ∈ Θ a) ∧
        ∀ a, M ⁻¹' (Θ a) = Ω a := by
    intro P Q _ M hM k N Ω hΩ C hC G hG hGp
    have hpre : ∀ a, M ⁻¹' (⋃ l, G a l) = Ω a := by
      intro a
      ext x
      simp only [Set.mem_preimage, Set.mem_iUnion]
      constructor
      · rintro ⟨l, hl⟩
        have h : x ∈ M ⁻¹' (G a l) := hl
        rw [hGp] at h
        exact h.1
      · intro hx
        obtain ⟨l, hl⟩ := hC (M x)
        refine ⟨l, ?_⟩
        have h : x ∈ M ⁻¹' (G a l) := by rw [hGp]; exact ⟨hx, hl⟩
        exact h
    have hex : ∀ y, ∃! a, y ∈ ⋃ l, G a l := by
      intro y
      obtain ⟨x, rfl⟩ := hM y
      obtain ⟨a, ha, hu⟩ := hΩ x
      refine ⟨a, ?_, ?_⟩
      · have h : x ∈ M ⁻¹' (⋃ l, G a l) := by rw [hpre]; exact ha
        exact h
      · intro b hb
        have h : x ∈ M ⁻¹' (⋃ l, G b l) := hb
        rw [hpre] at h
        exact hu b h
    have hopen : ∀ a, IsOpen (⋃ l, G a l) := fun a => isOpen_iUnion (hG a)
    refine ⟨fun a => ⋃ l, G a l, fun a => ⟨?_, hopen a⟩, hex, hpre⟩
    rw [← isOpen_compl_iff]
    have hc : (⋃ l, G a l)ᶜ = ⋃ b ∈ {b | b ≠ a}, ⋃ l, G b l := by
      ext y
      constructor
      · intro hy
        obtain ⟨b, hb, -⟩ := hex y
        have hba : b ≠ a := by
          rintro rfl
          exact hy hb
        exact Set.mem_biUnion hba hb
      · intro hy hya
        obtain ⟨b, hba, hb⟩ := Set.mem_iUnion₂.mp hy
        exact hba ((hex y).unique hb hya)
    rw [hc]
    exact isOpen_biUnion (fun b _ => hopen b)

  have s4 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), CompactSpace X →
      ∃ (N : ℕ) (T : Fin N → X.Opens) (V : Fin N → Y.Opens), (∀ l, IsAffineOpen (T l)) ∧
        (∀ l, IsAffineOpen (V l)) ∧ (∀ l, T l ≤ f ⁻¹ᵁ V l) ∧ ∀ x : X, ∃ l, x ∈ T l := by
    intro X Y f hXc
    have h1 : ∀ x : X, ∃ (V : Y.Opens) (T : X.Opens), IsAffineOpen V ∧ IsAffineOpen T ∧
        T ≤ f ⁻¹ᵁ V ∧ x ∈ T := by
      intro x
      obtain ⟨V, hV, hxV, -⟩ := exists_isAffineOpen_mem_and_subset (x := f x) (U := ⊤) trivial
      obtain ⟨T, hT, hxT, hTV⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := f ⁻¹ᵁ V)
        ((Scheme.Hom.mem_preimage f).mpr hxV)
      exact ⟨V, T, hV, hT, fun y hy => hTV hy, hxT⟩
    choose V T hV hT hTV hxT using h1
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (T x : Set X))
      (fun x => (T x).isOpen) (fun x _ => Set.mem_iUnion.mpr ⟨x, hxT x⟩)
    refine ⟨t.card, fun l => T (t.equivFin.symm l), fun l => V (t.equivFin.symm l),
      fun l => hT _, fun l => hV _, fun l => hTV _, fun x => ?_⟩
    obtain ⟨x', hx't, hx⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
    refine ⟨t.equivFin ⟨x', hx't⟩, ?_⟩
    show x ∈ T (t.equivFin.symm (t.equivFin ⟨x', hx't⟩))
    rw [Equiv.symm_apply_apply]
    exact hx

  have s3 : ∀ {X : Scheme.{u}} {O : X.Opens} (hO : IsAffineOpen O) (S : Set X), IsClopen S →
      ∃ e : Γ(X, O), (X.basicOpen e : Set X) = S ∩ O := by
    intro X O hO S hS
    haveI := hO.isOpenImmersion_fromSpec
    have hcl : IsClopen (hO.fromSpec ⁻¹' S) := hS.preimage hO.fromSpec.continuous
    obtain ⟨e, -, he⟩ := PrimeSpectrum.exists_idempotent_basicOpen_eq_of_isClopen hcl
    refine ⟨e, ?_⟩
    have h1 : hO.fromSpec ⁻¹' (X.basicOpen e : Set X) = hO.fromSpec ⁻¹' S := by
      rw [he, ← Scheme.Hom.coe_preimage, hO.fromSpec_preimage_basicOpen]
      rfl
    have h2 : (X.basicOpen e : Set X) ⊆ Set.range hO.fromSpec := by
      rw [hO.range_fromSpec]
      exact fun x hx => X.basicOpen_le e hx
    rw [← Set.image_preimage_eq_of_subset h2, h1, Set.image_preimage_eq_inter_range,
      hO.range_fromSpec]

  have hOlem : ∀ {X Y W : Scheme.{u}} (f : X ⟶ Y) (g : W ⟶ Y) (V : Y.Opens) (T : X.Opens),
      T ≤ f ⁻¹ᵁ V →
      Limits.pullback.fst f g ⁻¹ᵁ T ≤ Limits.pullback.snd f g ⁻¹ᵁ (g ⁻¹ᵁ V) := by
    intro X Y W f g V T hTV x hx
    rw [Scheme.Hom.mem_preimage] at hx
    have h := hTV hx
    rw [Scheme.Hom.mem_preimage] at h
    rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply,
      ← Limits.pullback.condition, Scheme.Hom.comp_apply]
    exact h

  have key : ∀ {A B : Scheme.{u}} (h : A ⟶ B) (U : B.Opens) (V : A.Opens) (e : V ≤ h ⁻¹ᵁ U),
      (h.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ h.appLE U V e := by
    intro A B h U V e
    rw [Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom, Scheme.Hom.appTop,
      Scheme.Hom.app_eq_appLE, Scheme.Hom.resLE_appLE]
    refine (Scheme.Hom.appLE_map _ _ _).trans ?_
    refine Eq.trans ?_ (Scheme.Hom.map_appLE _ _ _).symm
    rfl

  have s2 : ∀ {X Y W : Scheme.{u}} (f : X ⟶ Y) (g : W ⟶ Y) (V : Y.Opens) (T : X.Opens),
      IsAffineOpen V → IsAffineOpen T → IsAffineOpen (g ⁻¹ᵁ V) → T ≤ f ⁻¹ᵁ V →
      ∀ (hO : Limits.pullback.fst f g ⁻¹ᵁ T ≤ Limits.pullback.snd f g ⁻¹ᵁ (g ⁻¹ᵁ V)),
      IsAffineOpen (Limits.pullback.fst f g ⁻¹ᵁ T) ∧
      ∀ s : Γ(Limits.pullback f g, Limits.pullback.fst f g ⁻¹ᵁ T), ∃ (N : ℕ)
        (a : Fin N → Γ(X, T)) (b : Fin N → Γ(W, g ⁻¹ᵁ V)),
        s = ∑ m, ((Limits.pullback.fst f g).appLE T _ le_rfl).hom (a m) *
          ((Limits.pullback.snd f g).appLE (g ⁻¹ᵁ V) _ hO).hom (b m) := by
    intro X Y W f g V T hV hT hgV hTV hO
    haveI : IsAffine (T : Scheme.{u}) := hT
    haveI : IsAffine (V : Scheme.{u}) := hV
    haveI : IsAffine ((g ⁻¹ᵁ V : W.Opens) : Scheme.{u}) := hgV
    have hsq := Scheme.Hom.isPullback_resLE (IsPullback.of_hasPullback f g)
      (US := V) (UT := g ⁻¹ᵁ V) (UX := T) le_rfl hTV (UY := Limits.pullback.fst f g ⁻¹ᵁ T)
      (inf_eq_left.mpr hO).symm
    have hOaff : IsAffineOpen (Limits.pullback.fst f g ⁻¹ᵁ T) := by
      haveI := IsAffine.of_isIso hsq.isoPullback.hom
      exact this
    refine ⟨hOaff, ?_⟩
    haveI : IsAffine ((Limits.pullback.fst f g ⁻¹ᵁ T : (Limits.pullback f g).Opens) :
      Scheme.{u}) := hOaff
    have hpo := isPushout_appTop_of_isPullback hsq
    have hpo2 : IsPushout (f.appLE V T hTV) (g.appLE V (g ⁻¹ᵁ V) le_rfl)
        ((Limits.pullback.fst f g).appLE T _ le_rfl)
        ((Limits.pullback.snd f g).appLE (g ⁻¹ᵁ V) _ hO) :=
      IsPushout.of_iso hpo V.topIso T.topIso (g ⁻¹ᵁ V).topIso
        (Limits.pullback.fst f g ⁻¹ᵁ T).topIso (key _ _ _ _) (key _ _ _ _) (key _ _ _ _)
        (key _ _ _ _)
    letI : Algebra Γ(Y, V) Γ(X, T) := (f.appLE V T hTV).hom.toAlgebra
    letI : Algebra Γ(Y, V) Γ(W, g ⁻¹ᵁ V) := (g.appLE V (g ⁻¹ᵁ V) le_rfl).hom.toAlgebra
    have htp := CommRingCat.isPushout_tensorProduct Γ(Y, V) Γ(X, T) Γ(W, g ⁻¹ᵁ V)
    have hpo3 : IsPushout (CommRingCat.ofHom (algebraMap Γ(Y, V) Γ(X, T)))
        (CommRingCat.ofHom (algebraMap Γ(Y, V) Γ(W, g ⁻¹ᵁ V)))
        ((Limits.pullback.fst f g).appLE T _ le_rfl)
        ((Limits.pullback.snd f g).appLE (g ⁻¹ᵁ V) _ hO) := hpo2
    let φ := IsPushout.isoIsPushout _ _ htp hpo3
    have hinl := IsPushout.inl_isoIsPushout_hom _ _ htp hpo3
    have hinr := IsPushout.inr_isoIsPushout_hom _ _ htp hpo3
    intro s
    obtain ⟨N, a, b, ht⟩ := TensorProduct.exists_sum_tmul_eq
      (R := Γ(Y, V)) (M := Γ(X, T)) (N := Γ(W, g ⁻¹ᵁ V)) (φ.inv.hom s)
    refine ⟨N, a, b, ?_⟩
    have hs : φ.hom.hom (φ.inv.hom s) = s := by simp
    rw [← hs, ht, map_sum]
    refine Finset.sum_congr rfl (fun m _ => ?_)
    have hl : φ.hom.hom (a m ⊗ₜ[Γ(Y, V)] (1 : Γ(W, g ⁻¹ᵁ V))) =
        ((Limits.pullback.fst f g).appLE T _ le_rfl).hom (a m) := by
      have := congrArg (fun q => q.hom (a m)) hinl
      exact this
    have hr : φ.hom.hom ((1 : Γ(X, T)) ⊗ₜ[Γ(Y, V)] b m) =
        ((Limits.pullback.snd f g).appLE (g ⁻¹ᵁ V) _ hO).hom (b m) := by
      have := congrArg (fun q => q.hom (b m)) hinr
      exact this
    have hab : a m ⊗ₜ[Γ(Y, V)] b m = (a m ⊗ₜ[Γ(Y, V)] (1 : Γ(W, g ⁻¹ᵁ V))) *
        ((1 : Γ(X, T)) ⊗ₜ[Γ(Y, V)] b m) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [hab, map_mul, hl, hr]

  have s5 : ∀ {X Y W Z : Scheme.{u}} (f : X ⟶ Y) (π : W ⟶ Y) (p : Z ⟶ Y) (r : W ⟶ Z)
      (hr : r ≫ p = π) (V : Y.Opens) (T : X.Opens)
      (hO : Limits.pullback.fst f π ⁻¹ᵁ T ≤ Limits.pullback.snd f π ⁻¹ᵁ (π ⁻¹ᵁ V))
      (hOZ : Limits.pullback.fst f p ⁻¹ᵁ T ≤ Limits.pullback.snd f p ⁻¹ᵁ (p ⁻¹ᵁ V))
      (N : ℕ) (a : Fin N → Γ(X, T)) (z : Fin N → Γ(Z, p ⁻¹ᵁ V)),
      (Limits.pullback.map f π f p (𝟙 _) r (𝟙 _) (by simp) (by rw [Category.comp_id, hr])) ⁻¹'
        ((Limits.pullback f p).basicOpen
          (∑ m, ((Limits.pullback.fst f p).appLE T _ le_rfl).hom (a m) *
          ((Limits.pullback.snd f p).appLE (p ⁻¹ᵁ V) _ hOZ).hom (z m)) : Set _) =
        ((Limits.pullback f π).basicOpen
          (∑ m, ((Limits.pullback.fst f π).appLE T _ le_rfl).hom (a m) *
          ((Limits.pullback.snd f π).appLE (π ⁻¹ᵁ V) _ hO).hom
            ((r.appLE (p ⁻¹ᵁ V) (π ⁻¹ᵁ V) (by rw [← hr]; exact le_rfl)).hom (z m))) : Set _) ∧
      (Limits.pullback.map f π f p (𝟙 _) r (𝟙 _) (by simp) (by rw [Category.comp_id, hr])) ⁻¹'
        (Limits.pullback.fst f p ⁻¹ᵁ T : Set _) = (Limits.pullback.fst f π ⁻¹ᵁ T : Set _) := by
    intro X Y W Z f π p r hr V T hO hOZ N a z
    set M := Limits.pullback.map f π f p (𝟙 _) r (𝟙 _) (by simp) (by rw [Category.comp_id, hr])
      with hMdef
    have hMfst : M ≫ Limits.pullback.fst f p = Limits.pullback.fst f π := by
      rw [hMdef, Limits.pullback.lift_fst, Category.comp_id]
    have hMsnd : M ≫ Limits.pullback.snd f p = Limits.pullback.snd f π ≫ r := by
      rw [hMdef, Limits.pullback.lift_snd]
    have hpre : M ⁻¹ᵁ (Limits.pullback.fst f p ⁻¹ᵁ T) = Limits.pullback.fst f π ⁻¹ᵁ T := by
      rw [← Scheme.Hom.comp_preimage, hMfst]
    have hcomp : ∀ {A B C : Scheme.{u}} (g : A ⟶ B) (h : B ⟶ C) (U₁ : C.Opens) (U₂ : B.Opens)
        (U₃ : A.Opens) (e₁ : U₂ ≤ h ⁻¹ᵁ U₁) (e₂ : U₃ ≤ g ⁻¹ᵁ U₂) (x : Γ(C, U₁)),
        (g.appLE U₂ U₃ e₂).hom ((h.appLE U₁ U₂ e₁).hom x) =
          ((g ≫ h).appLE U₁ U₃ (le_trans e₂ (g.preimage_mono e₁))).hom x := by
      intro A B C g h U₁ U₂ U₃ e₁ e₂ x
      rw [← Scheme.Hom.appLE_comp_appLE]
      rfl
    have hcongr : ∀ {A B : Scheme.{u}} (g h : A ⟶ B) (hgh : g = h) (U₁ : B.Opens)
        (U₃ : A.Opens) (e : U₃ ≤ g ⁻¹ᵁ U₁) (e' : U₃ ≤ h ⁻¹ᵁ U₁) (x : Γ(B, U₁)),
        (g.appLE U₁ U₃ e).hom x = (h.appLE U₁ U₃ e').hom x := by
      intro A B g h hgh U₁ U₃ e e' x
      subst hgh
      rfl
    have hM : Limits.pullback.fst f π ⁻¹ᵁ T ≤ M ⁻¹ᵁ (Limits.pullback.fst f p ⁻¹ᵁ T) := hpre.ge
    have happ : (M.appLE _ _ hM).hom
        (∑ m, ((Limits.pullback.fst f p).appLE T _ le_rfl).hom (a m) *
          ((Limits.pullback.snd f p).appLE (p ⁻¹ᵁ V) _ hOZ).hom (z m)) =
        ∑ m, ((Limits.pullback.fst f π).appLE T _ le_rfl).hom (a m) *
          ((Limits.pullback.snd f π).appLE (π ⁻¹ᵁ V) _ hO).hom
            ((r.appLE (p ⁻¹ᵁ V) (π ⁻¹ᵁ V) (by rw [← hr]; exact le_rfl)).hom (z m)) := by
      rw [map_sum]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [map_mul, hcomp, hcomp, hcomp]
      congr 1
      · exact hcongr _ _ hMfst _ _ _ _ _
      · exact hcongr _ _ hMsnd _ _ _ _ _
    constructor
    · rw [← happ, Scheme.basicOpen_appLE]
      have hle : M ⁻¹ᵁ (Limits.pullback f p).basicOpen
          (∑ m, ((Limits.pullback.fst f p).appLE T _ le_rfl).hom (a m) *
            ((Limits.pullback.snd f p).appLE (p ⁻¹ᵁ V) _ hOZ).hom (z m)) ≤
          Limits.pullback.fst f π ⁻¹ᵁ T := by
        rw [← hpre]
        exact M.preimage_mono (Scheme.basicOpen_le _ _)
      rw [inf_eq_right.mpr hle, Scheme.Hom.coe_preimage]
    · rw [← Scheme.Hom.coe_preimage, hpre]

  have s6 : ∀ {Y W Z X : Scheme.{u}} (f : X ⟶ Y) (π : W ⟶ Y) (p : Z ⟶ Y) (r : W ⟶ Z)
      (hr : r ≫ p = π), Function.Surjective r →
      Function.Surjective (Limits.pullback.map f π f p (𝟙 _) r (𝟙 _) (by simp)
        (by rw [Category.comp_id, hr])) := by
    intro Y W Z X f π p r hr hsurj
    have hsq : IsPullback (Limits.pullback.map f π f p (𝟙 _) r (𝟙 _) (by simp)
        (by rw [Category.comp_id, hr])) (Limits.pullback.snd f π)
        (Limits.pullback.snd f p) r := by
      refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback f p)
      rw [Limits.pullback.lift_fst, Category.comp_id, hr]
      exact IsPullback.of_hasPullback f π
    have h1 : Surjective r := (surjective_iff r).mpr hsurj
    have h2 := MorphismProperty.of_isPullback (P := @Surjective) hsq.flip h1
    exact h2.surj

  obtain ⟨N, T, V, hT, hV, hTV, hcov⟩ := s4 U.hom hUc
  have hπV : ∀ l, IsAffineOpen (π ⁻¹ᵁ V l) := fun l => (hV l).preimage π
  have hO : ∀ l, Limits.pullback.fst U.hom π ⁻¹ᵁ T l ≤
      Limits.pullback.snd U.hom π ⁻¹ᵁ (π ⁻¹ᵁ V l) := fun l => hOlem U.hom π (V l) (T l) (hTV l)
  have hS2 := fun l => s2 U.hom π (V l) (T l) (hV l) (hT l) (hπV l) (hTV l) (hO l)
  have hex : ∀ (a : Fin k) (l : Fin N),
      ∃ e : Γ(Limits.pullback U.hom π, Limits.pullback.fst U.hom π ⁻¹ᵁ T l),
        ((Limits.pullback U.hom π).basicOpen e : Set _) =
          Ω a ∩ (Limits.pullback.fst U.hom π ⁻¹ᵁ T l : Set _) :=
    fun a l => s3 (hS2 l).1 (Ω a) (hΩc a)
  choose e he using hex
  have hdec := fun a l => (hS2 l).2 (e a l)
  choose Nm s b hb using hdec
  let ι := Σ al : Fin k × Fin N, Fin (Nm al.1 al.2)
  let eqv := Fintype.equivFin ι
  refine ⟨Fintype.card ι, fun i => V (eqv.symm i).1.2, fun i => hV _,
    fun i => b (eqv.symm i).1.1 (eqv.symm i).1.2 (eqv.symm i).2, ?_⟩

  intro Z p r _ hr hsurj _ hw
  have hlift : ∀ j : ι, ∃ z : Γ(Z, p ⁻¹ᵁ V j.1.2),
      (r.appLE (p ⁻¹ᵁ V j.1.2) (π ⁻¹ᵁ V j.1.2) (by rw [← hr]; exact le_rfl)).hom z =
        b j.1.1 j.1.2 j.2 := by
    intro j
    obtain ⟨i, rfl⟩ := eqv.symm.surjective j
    exact hw i
  choose z hz using hlift
  have hOZ : ∀ l, Limits.pullback.fst U.hom p ⁻¹ᵁ T l ≤
      Limits.pullback.snd U.hom p ⁻¹ᵁ (p ⁻¹ᵁ V l) := fun l => hOlem U.hom p (V l) (T l) (hTV l)
  have hGp : ∀ (a : Fin k) (l : Fin N),
      (Limits.pullback.map U.hom π U.hom p (𝟙 _) r (𝟙 _) (by simp)
        (by rw [Category.comp_id, hr])) ⁻¹'
        ((Limits.pullback U.hom p).basicOpen
          (∑ m, ((Limits.pullback.fst U.hom p).appLE (T l) _ le_rfl).hom (s a l m) *
          ((Limits.pullback.snd U.hom p).appLE (p ⁻¹ᵁ V l) _ (hOZ l)).hom
            (z ⟨(a, l), m⟩)) : Set _) =
      Ω a ∩ (Limits.pullback.map U.hom π U.hom p (𝟙 _) r (𝟙 _) (by simp)
        (by rw [Category.comp_id, hr])) ⁻¹' (Limits.pullback.fst U.hom p ⁻¹ᵁ T l : Set _) := by
    intro a l
    obtain ⟨h5a, h5b⟩ := s5 U.hom π p r hr (V l) (T l) (hO l) (hOZ l) (Nm a l) (s a l)
      (fun m => z ⟨(a, l), m⟩)
    have hsum : (∑ m, ((Limits.pullback.fst U.hom π).appLE (T l) _ le_rfl).hom (s a l m) *
          ((Limits.pullback.snd U.hom π).appLE (π ⁻¹ᵁ V l) _ (hO l)).hom
            ((r.appLE (p ⁻¹ᵁ V l) (π ⁻¹ᵁ V l) (by rw [← hr]; exact le_rfl)).hom
              (z ⟨(a, l), m⟩))) = e a l := by
      rw [hb a l]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      have h := hz ⟨(a, l), m⟩
      exact congrArg (fun t => ((Limits.pullback.fst U.hom π).appLE (T l) _ le_rfl).hom
        (s a l m) * ((Limits.pullback.snd U.hom π).appLE (π ⁻¹ᵁ V l) _ (hO l)).hom t) h
    rw [h5b]
    refine h5a.trans ?_
    rw [hsum, he a l]
  obtain ⟨Θ, h1, h2, h3⟩ := s1 _ (s6 U.hom π p r hr hsurj) k N Ω hΩp
    (fun l => (Limits.pullback.fst U.hom p ⁻¹ᵁ T l : Set _))
    (fun y => by
      obtain ⟨l, hl⟩ := hcov (Limits.pullback.fst U.hom p y)
      exact ⟨l, hl⟩)
    _ (fun a l => TopologicalSpace.Opens.isOpen _) hGp
  exact ⟨Θ, h1, h2, h3⟩

theorem wc_fsys_single_generator : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) [IsIntegralHom π] (V : Y.Opens), IsAffineOpen V → ∀ x : Γ(W, π ⁻¹ᵁ V), ∃ 𝒢 : ∀ V' : Y.Opens, Set Γ(W, π ⁻¹ᵁ V'), wcFSys π V 𝒢 ∧ x ∈ 𝒢 V :=
by
  intro Y W π _ V hV x
  classical

  have hA : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S) (y : S) (P : Polynomial R),
      P.Monic → P.eval₂ φ y = 0 → ∃ T : Finset S, (∀ t ∈ T, ∃ i : ℕ, t = y ^ i) ∧
        ∀ q : Polynomial R, ∃ c : S → R, q.eval₂ φ y = ∑ t ∈ T, φ (c t) * t := by
    intro R S _ _ φ y P hP hy
    refine ⟨(Finset.range (P.natDegree + 1)).image (fun i => y ^ i), ?_, ?_⟩
    · intro t ht
      obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp ht
      exact ⟨i, rfl⟩
    · intro q
      have h1 : q.eval₂ φ y = (q %ₘ P).eval₂ φ y :=
        (Polynomial.eval₂_modByMonic_eq_self_of_root hy).symm
      have h2 : (q %ₘ P).natDegree < P.natDegree + 1 :=
        Nat.lt_succ_of_le (Polynomial.natDegree_modByMonic_le q hP)
      rw [h1, Polynomial.eval₂_eq_sum_range' φ h2]
      refine ⟨fun t => ∑ i ∈ Finset.range (P.natDegree + 1),
        if y ^ i = t then (q %ₘ P).coeff i else 0, ?_⟩
      simp only [map_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      rw [Finset.sum_eq_single (y ^ i)]
      · simp
      · intro t _ hne
        rw [if_neg (Ne.symm hne)]
        simp
      · intro hn
        exact absurd (Finset.mem_image_of_mem _ hi) hn

  have hB : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (f : R)
      [IsLocalization.Away f S] (q : Polynomial S),
      ∃ (n : ℕ) (q' : Polynomial R), q'.map (algebraMap R S) = (algebraMap R S f) ^ n • q := by
    intro R S _ _ _ f _ q
    obtain ⟨b, hb, hq⟩ := IsLocalization.integerNormalization_spec (Submonoid.powers f) q
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hb
    refine ⟨n, IsLocalization.integerNormalization (Submonoid.powers f) q, ?_⟩
    rw [hq, ← map_pow, algebraMap_smul]

  have hC : ∀ (U U' : Y.Opens) (hU : U ≤ V) (hU' : U' ≤ U) (q : Polynomial Γ(Y, U)),
      (W.presheaf.map (homOfLE (π.preimage_mono hU')).op).hom
          (q.eval₂ (π.app U).hom ((W.presheaf.map (homOfLE (π.preimage_mono hU)).op).hom x)) =
        (q.map (Y.presheaf.map (homOfLE hU').op).hom).eval₂ (π.app U').hom
          ((W.presheaf.map (homOfLE (π.preimage_mono (hU'.trans hU))).op).hom x) := by
    intro U U' hU hU' q
    rw [Polynomial.hom_eval₂, Polynomial.eval₂_map]
    congr 1
    · ext c
      have h := congrArg (fun g => g.hom c) (π.naturality (homOfLE hU').op)
      simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at h
      simp only [RingHom.coe_comp, Function.comp_apply]
      exact h.symm
    · change (W.presheaf.map _ ≫ W.presheaf.map _).hom x = _
      rw [← Functor.map_comp]
      rfl
  refine ⟨fun U' => {a | ∃ (h : U' ≤ V) (q : Polynomial Γ(Y, U')),
      a = q.eval₂ (π.app U').hom ((W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom x)},
    ⟨fun V' hV' hV'V => ⟨?_, ?_, ?_⟩, fun U hU hUV f => ⟨?_, ?_⟩⟩, ?_⟩
  ·
    intro c
    exact ⟨hV'V, Polynomial.C c, by rw [Polynomial.eval₂_C]⟩
  ·
    rintro a ⟨h1, q1, rfl⟩ b ⟨h2, q2, rfl⟩
    exact ⟨⟨hV'V, q1 + q2, by rw [Polynomial.eval₂_add]⟩,
      ⟨hV'V, q1 * q2, by rw [Polynomial.eval₂_mul]⟩⟩
  ·
    obtain ⟨P, hPm, hP⟩ := IsIntegralHom.isIntegral_app π V' hV'
      ((W.presheaf.map (homOfLE (π.preimage_mono hV'V)).op).hom x)
    obtain ⟨T, hT, hspan⟩ := hA _ _ (π.app V').hom _ P hPm hP
    refine ⟨T, fun t ht => ?_, fun a ha => ?_⟩
    · obtain ⟨i, rfl⟩ := hT t ht
      exact ⟨hV'V, Polynomial.X ^ i, by rw [Polynomial.eval₂_X_pow]⟩
    · obtain ⟨h, q, rfl⟩ := ha
      exact hspan q
  ·
    rintro a ⟨h, q, rfl⟩
    exact ⟨(Y.basicOpen_le f).trans h,
      q.map (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom,
      hC U (Y.basicOpen f) h (Y.basicOpen_le f) q⟩
  ·
    rintro b ⟨h, q, rfl⟩
    haveI := hU.isLocalization_basicOpen f
    obtain ⟨n, q', hq'⟩ := hB Γ(Y, U) Γ(Y, Y.basicOpen f) f q
    refine ⟨n, q'.eval₂ (π.app U).hom
      ((W.presheaf.map (homOfLE (π.preimage_mono hUV)).op).hom x), ⟨hUV, q', rfl⟩, ?_⟩
    rw [hC U (Y.basicOpen f) hUV (Y.basicOpen_le f) q']
    change _ = Polynomial.eval₂ _ _ (q'.map (algebraMap Γ(Y, U) Γ(Y, Y.basicOpen f)))
    rw [hq', Polynomial.eval₂_smul, map_pow]
    rfl
  ·
    refine ⟨le_rfl, Polynomial.X, ?_⟩
    rw [Polynomial.eval₂_X]
    show x = (W.presheaf.map (𝟙 (Opposite.op (π ⁻¹ᵁ V)))).hom x
    rw [CategoryTheory.Functor.map_id]
    rfl

theorem wc_fsys_local_mem : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) [IsAffineHom π] (O : Y.Opens) (𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), wcFSys π O 𝒜 → ∀ (U : Y.Opens), IsAffineOpen U → U ≤ O → ∀ (a : Γ(W, π ⁻¹ᵁ U)) (s : Set Γ(Y, U)), Ideal.span s = ⊤ → (∀ f ∈ s, (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom a ∈ 𝒜 (Y.basicOpen f)) → a ∈ 𝒜 U :=
by
  intro Y W π _ O 𝒜 h𝒜 U hU hUO a s hs hloc
  classical
  obtain ⟨hA1, hA2, -⟩ := h𝒜.1 U hU hUO
  have hL : ∀ (f : Γ(Y, U)) (x x' : Γ(W, π ⁻¹ᵁ U)),
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom x =
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom x' →
      ∃ m : ℕ, (π.app U).hom f ^ m * x = (π.app U).hom f ^ m * x' := by
    intro f x x' hxx
    letI : Algebra Γ(W, π ⁻¹ᵁ U) Γ(W, π ⁻¹ᵁ Y.basicOpen f) :=
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom.toAlgebra
    haveI : IsLocalization.Away ((π.app U).hom f) Γ(W, π ⁻¹ᵁ Y.basicOpen f) :=
      (hU.preimage π).isLocalization_of_eq_basicOpen ((π.app U).hom f)
        (homOfLE (π.preimage_mono (Y.basicOpen_le f))) (Scheme.preimage_basicOpen π f)
    obtain ⟨⟨c, hc⟩, hc'⟩ := IsLocalization.exists_of_eq
      (M := Submonoid.powers ((π.app U).hom f)) (S := Γ(W, π ⁻¹ᵁ Y.basicOpen f)) hxx
    obtain ⟨m, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hc
    exact ⟨m, hc'⟩
  have hN : ∀ f : Γ(Y, U),
      (π.app (Y.basicOpen f)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) =
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom
        ((π.app U).hom f) := by
    intro f
    have e := congrArg (fun g => g.hom f) (π.naturality (homOfLE (Y.basicOpen_le f)).op)
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at e
    exact e
  have hE : ∀ f ∈ s, ∃ N : ℕ, (π.app U).hom f ^ N * a ∈ 𝒜 U := by
    intro f hf
    obtain ⟨n, a', ha', hna⟩ := (h𝒜.2 U hU hUO f).2 _ (hloc f hf)
    rw [hN f, ← map_pow, ← map_mul] at hna
    obtain ⟨m, hm⟩ := hL f _ _ hna
    refine ⟨m + n, ?_⟩
    rw [pow_add, mul_assoc, hm, ← map_pow]
    exact (hA2 _ (hA1 _) _ ha').2
  letI : Module Γ(Y, U) Γ(W, π ⁻¹ᵁ U) := (π.app U).hom.toModule
  let M : Submodule Γ(Y, U) Γ(W, π ⁻¹ᵁ U) :=
    { carrier := 𝒜 U
      add_mem' := fun {x y} hx hy => (hA2 x hx y hy).1
      zero_mem' := by
        have h := hA1 0
        rwa [map_zero] at h
      smul_mem' := fun c x hx => (hA2 _ (hA1 c) x hx).2 }
  have hM : a ∈ M := by
    refine Submodule.mem_of_span_eq_top_of_smul_pow_mem M s hs a ?_
    rintro ⟨f, hf⟩
    obtain ⟨N, hN'⟩ := hE f hf
    refine ⟨N, ?_⟩
    show (π.app U).hom (f ^ N) * a ∈ 𝒜 U
    rw [map_pow]
    exact hN'
  exact hM

theorem wc_fsys_family_mem : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) [IsAffineHom π] (O : Y.Opens) (𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), wcFSys π O 𝒜 → ∀ (U : Y.Opens), IsAffineOpen U → ∀ (s : Finset Γ(Y, U)), Ideal.span (↑s : Set Γ(Y, U)) = ⊤ → ∀ (O' : Γ(Y, U) → Y.Opens) (𝒢 : Γ(Y, U) → ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), (∀ g ∈ s, wcFSys π (O' g) (𝒢 g)) → (∀ g ∈ s, Y.basicOpen g ≤ O' g) → (∀ g ∈ s, ∀ N : Y.Opens, IsAffineOpen N → N ≤ O → N ≤ O' g → ∀ y, y ∈ 𝒢 g N → y ∈ 𝒜 N) → ∀ a : Γ(W, π ⁻¹ᵁ U), (∀ g ∈ s, (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom a ∈ 𝒢 g (Y.basicOpen g)) → ∀ (V : Y.Opens) (hVU : V ≤ U), IsAffineOpen V → V ≤ O → (W.presheaf.map (homOfLE (π.preimage_mono hVU)).op).hom a ∈ 𝒜 V :=
by
  intro Y W π _ O 𝒜 h𝒜 U hU s hs O' 𝒢 hG FD hC a hloc V hVU hV hVO
  classical
  have R1 : ∀ (U V V' : Y.Opens) (hVU : V ≤ U) (hWV : V' ≤ V) (a : Γ(W, π ⁻¹ᵁ U)),
      (W.presheaf.map (homOfLE (π.preimage_mono hWV)).op).hom
        ((W.presheaf.map (homOfLE (π.preimage_mono hVU)).op).hom a) =
      (W.presheaf.map (homOfLE (π.preimage_mono (hWV.trans hVU))).op).hom a := by
    intro U V V' hVU hWV a
    change (W.presheaf.map (homOfLE (π.preimage_mono hVU)).op ≫
      W.presheaf.map (homOfLE (π.preimage_mono hWV)).op).hom a = _
    rw [← Functor.map_comp]
    rfl
  let S : Set Γ(Y, V) := {h | ∃ g ∈ s, ∃ h' : Γ(Y, Y.basicOpen g), Y.basicOpen h' = Y.basicOpen h}
  have hS : Ideal.span S = ⊤ := by
    rw [← hV.self_le_iSup_basicOpen_iff]
    intro x hxV
    have hxU : x ∈ U := hVU hxV
    have hU' := (hU.iSup_basicOpen_eq_self_iff (s := (↑s : Set Γ(Y, U)))).mpr hs
    rw [← hU'] at hxU
    obtain ⟨⟨g, hg⟩, hxg⟩ := TopologicalSpace.Opens.mem_iSup.mp hxU
    obtain ⟨h', h, heq, hxh'⟩ :=
      exists_basicOpen_le_affine_inter (hU.basicOpen g) hV x ⟨hxg, hxV⟩
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨⟨h, g, Finset.mem_coe.mp hg, h', heq⟩, heq ▸ hxh'⟩
  refine wc_fsys_local_mem Y W π O 𝒜 h𝒜 V hV hVO _ S hS ?_
  rintro h ⟨g, hg, h', heq⟩
  have h1 := ((hG g hg).2 (Y.basicOpen g) (hU.basicOpen g) (FD g hg) h').1 _ (hloc g hg)
  rw [R1 U (Y.basicOpen g) (Y.basicOpen h') (Y.basicOpen_le g) (Y.basicOpen_le h')] at h1
  have K : ∀ (E : Y.Opens), Y.basicOpen h' = E → ∀ (H : E ≤ U),
      (W.presheaf.map (homOfLE (π.preimage_mono H)).op).hom a ∈ 𝒢 g E := by
    rintro E rfl H
    exact h1
  have h2 := K (Y.basicOpen h) heq ((Y.basicOpen_le h).trans hVU)
  have hNO' : Y.basicOpen h ≤ O' g := by
    rw [← heq]
    exact (Y.basicOpen_le h').trans (FD g hg)
  have h3 := hC g hg (Y.basicOpen h) (hV.basicOpen h) ((Y.basicOpen_le h).trans hVO) hNO' _ h2
  rw [R1 U V (Y.basicOpen h) hVU (Y.basicOpen_le h)]
  exact h3

theorem wc_fsys_family_lift : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) [IsAffineHom π] (U : Y.Opens), IsAffineOpen U → ∀ (s : Finset Γ(Y, U)) (O' : Γ(Y, U) → Y.Opens) (𝒢 : Γ(Y, U) → ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), (∀ g ∈ s, wcFSys π (O' g) (𝒢 g)) → (∀ g ∈ s, Y.basicOpen g ≤ O' g) → ∀ (f : Γ(Y, U)) (b : Γ(W, π ⁻¹ᵁ Y.basicOpen f)), (∀ g ∈ s, ∀ (V : Y.Opens) (hV : V ≤ Y.basicOpen f), IsAffineOpen V → V ≤ Y.basicOpen g → (W.presheaf.map (homOfLE (π.preimage_mono hV)).op).hom b ∈ 𝒢 g V) → ∃ (n : ℕ) (x : Γ(W, π ⁻¹ᵁ U)), (π.app (Y.basicOpen f)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) ^ n * b = (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom x ∧ ∀ g ∈ s, (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom x ∈ 𝒢 g (Y.basicOpen g) :=
by
  intro Y W π _ U hU s O' 𝒢 hF hD f b hb
  classical

  have R1 : ∀ (U V V' : Y.Opens) (hVU : V ≤ U) (hWV : V' ≤ V) (a : Γ(W, π ⁻¹ᵁ U)),
      (W.presheaf.map (homOfLE (π.preimage_mono hWV)).op).hom
        ((W.presheaf.map (homOfLE (π.preimage_mono hVU)).op).hom a) =
      (W.presheaf.map (homOfLE (π.preimage_mono (hWV.trans hVU))).op).hom a := by
    intro U V V' hVU hWV a
    change (W.presheaf.map (homOfLE (π.preimage_mono hVU)).op ≫
      W.presheaf.map (homOfLE (π.preimage_mono hWV)).op).hom a = _
    rw [← Functor.map_comp]
    rfl

  have N : ∀ (U V : Y.Opens) (h : V ≤ U) (c : Γ(Y, U)),
      (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom ((π.app U).hom c) =
      (π.app V).hom ((Y.presheaf.map (homOfLE h).op).hom c) := by
    intro U V h c
    have := congrArg (fun φ => φ.hom c) (π.naturality (homOfLE h).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this.symm

  have L : ∀ (V : Y.Opens), IsAffineOpen V → ∀ (c : Γ(Y, V)),
      (∀ z : Γ(W, π ⁻¹ᵁ Y.basicOpen c), ∃ (n : ℕ) (x : Γ(W, π ⁻¹ᵁ V)),
        z * (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le c))).op).hom
          ((π.app V).hom c ^ n) =
        (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le c))).op).hom x) ∧
      (∀ x x' : Γ(W, π ⁻¹ᵁ V),
        (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le c))).op).hom x =
          (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le c))).op).hom x' →
        ∃ m : ℕ, (π.app V).hom c ^ m * x = (π.app V).hom c ^ m * x') := by
    intro V hV c
    letI := (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le c))).op).hom.toAlgebra
    haveI hloc : IsLocalization.Away ((π.app V).hom c) Γ(W, π ⁻¹ᵁ Y.basicOpen c) :=
      (hV.preimage π).isLocalization_of_eq_basicOpen _
        (homOfLE (π.preimage_mono (Y.basicOpen_le c))) (Scheme.preimage_basicOpen π c)
    refine ⟨fun z => ?_, fun x x' hxx => ?_⟩
    · obtain ⟨⟨x, ⟨d, hd⟩⟩, h⟩ := IsLocalization.surj (Submonoid.powers ((π.app V).hom c)) z
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hd
      exact ⟨n, x, h⟩
    · obtain ⟨⟨d, hd⟩, hcx⟩ :=
        IsLocalization.exists_of_eq (M := Submonoid.powers ((π.app V).hom c)) hxx
      obtain ⟨m, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hd
      exact ⟨m, hcx⟩

  obtain ⟨n₀, x₀, hx₀⟩ := (L U hU f).1 b

  have hm : ∀ g ∈ s, ∃ m : ℕ,
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom
        ((π.app U).hom f ^ m * x₀) ∈ 𝒢 g (Y.basicOpen g) := by
    intro g hg
    have hFg := hF g hg
    have hV : IsAffineOpen (Y.basicOpen g) := hU.basicOpen g
    have hVO : Y.basicOpen g ≤ O' g := hD g hg
    have hVU : Y.basicOpen g ≤ U := Y.basicOpen_le g
    obtain ⟨gg, hgg⟩ : ∃ gg : Γ(Y, Y.basicOpen g),
        gg = (Y.presheaf.map (homOfLE hVU).op).hom f := ⟨_, rfl⟩
    have hEg : Y.basicOpen gg ≤ Y.basicOpen g := Y.basicOpen_le gg
    have hEf : Y.basicOpen gg ≤ Y.basicOpen f := by
      rw [hgg, Scheme.basicOpen_res]; exact inf_le_right
    have hEaff : IsAffineOpen (Y.basicOpen gg) := hV.basicOpen gg
    have hEO : Y.basicOpen gg ≤ O' g := hEg.trans hVO
    have hy0 : (W.presheaf.map (homOfLE (π.preimage_mono (hEg.trans hVU))).op).hom x₀ ∈
        𝒢 g (Y.basicOpen gg) := by
      rw [← R1 U (Y.basicOpen f) (Y.basicOpen gg) (Y.basicOpen_le f) hEf x₀, ← hx₀, map_mul,
        R1 U (Y.basicOpen f) (Y.basicOpen gg) (Y.basicOpen_le f) hEf, map_pow,
        N U (Y.basicOpen gg) (hEf.trans (Y.basicOpen_le f)) f]
      exact ((hFg.1 _ hEaff hEO).2.1 _ (hb g hg _ hEf hEaff hEg) _
        (by rw [← map_pow]; exact (hFg.1 _ hEaff hEO).1 _)).2
    obtain ⟨n, a, ha, hna⟩ := (hFg.2 (Y.basicOpen g) hV hVO gg).2 _ hy0
    have h2 : (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le gg))).op).hom
        ((π.app (Y.basicOpen g)).hom gg ^ n *
          (W.presheaf.map (homOfLE (π.preimage_mono hVU)).op).hom x₀) =
        (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le gg))).op).hom a := by
      rw [map_mul, map_pow, N (Y.basicOpen g) (Y.basicOpen gg) (Y.basicOpen_le gg) gg,
        R1 U (Y.basicOpen g) (Y.basicOpen gg) hVU (Y.basicOpen_le gg) x₀]
      exact hna
    obtain ⟨k, hk⟩ := (L _ hV gg).2 _ _ h2
    refine ⟨k + n, ?_⟩
    rw [map_mul, map_pow, N U _ hVU f, ← hgg, pow_add, mul_assoc, hk]
    exact ((hFg.1 _ hV hVO).2.1 _
      (by rw [← map_pow]; exact (hFg.1 _ hV hVO).1 _) _ ha).2
  choose! m hm using hm

  refine ⟨(∑ g ∈ s, m g) + n₀, (π.app U).hom f ^ (∑ g ∈ s, m g) * x₀, ?_, ?_⟩
  · rw [map_mul, map_pow, N U _ (Y.basicOpen_le f) f, ← hx₀, map_pow,
      N U _ (Y.basicOpen_le f) f]
    ring
  · intro g hg
    have hle : m g ≤ ∑ g ∈ s, m g := Finset.single_le_sum (fun _ _ => Nat.zero_le _) hg
    obtain ⟨d, hd⟩ : ∃ d, ∑ g ∈ s, m g = d + m g := ⟨_, (Nat.sub_add_cancel hle).symm⟩
    have hFg := hF g hg
    have hV : IsAffineOpen (Y.basicOpen g) := hU.basicOpen g
    rw [hd, pow_add, mul_assoc, map_mul, map_pow, N U _ (Y.basicOpen_le g) f]
    exact ((hFg.1 _ hV (hD g hg)).2.1 _
      (by rw [← map_pow]; exact (hFg.1 _ hV (hD g hg)).1 _) _ (hm g hg)).2

theorem wc_fsys_span_of_local : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) [IsAffineHom π] (U : Y.Opens), IsAffineOpen U → ∀ (s : Finset Γ(Y, U)), Ideal.span (↑s : Set Γ(Y, U)) = ⊤ → ∀ (C : Set Γ(W, π ⁻¹ᵁ U)) (T : ∀ g : Γ(Y, U), Finset Γ(W, π ⁻¹ᵁ Y.basicOpen g)), (∀ g ∈ s, ∀ a ∈ C, ∃ c : Γ(W, π ⁻¹ᵁ Y.basicOpen g) → Γ(Y, Y.basicOpen g), (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom a = ∑ t ∈ T g, (π.app (Y.basicOpen g)).hom (c t) * t) → (∀ g ∈ s, ∀ t ∈ T g, ∃ (n : ℕ) (x : Γ(W, π ⁻¹ᵁ U)), x ∈ C ∧ (π.app (Y.basicOpen g)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g) ^ n * t = (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom x) → ∃ T' : Finset Γ(W, π ⁻¹ᵁ U), (↑T' : Set Γ(W, π ⁻¹ᵁ U)) ⊆ C ∧ ∀ a ∈ C, ∃ c : Γ(W, π ⁻¹ᵁ U) → Γ(Y, U), a = ∑ t ∈ T', (π.app U).hom (c t) * t :=
by
  classical
  intro Y W π _ U hU s hs C T H1 H2

  have hK : ∀ (g : Γ(Y, U)) (x x' : Γ(W, π ⁻¹ᵁ U)),
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom x =
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom x' →
      ∃ m : ℕ, (π.app U).hom g ^ m * x = (π.app U).hom g ^ m * x' := by
    intro g x x' hxx
    letI : Algebra Γ(W, π ⁻¹ᵁ U) Γ(W, π ⁻¹ᵁ Y.basicOpen g) :=
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom.toAlgebra
    haveI : IsLocalization.Away ((π.app U).hom g) Γ(W, π ⁻¹ᵁ Y.basicOpen g) :=
      (hU.preimage π).isLocalization_of_eq_basicOpen ((π.app U).hom g)
        (homOfLE (π.preimage_mono (Y.basicOpen_le g))) (Scheme.preimage_basicOpen π g)
    obtain ⟨⟨c, hc⟩, hc'⟩ := IsLocalization.exists_of_eq
      (M := Submonoid.powers ((π.app U).hom g)) (S := Γ(W, π ⁻¹ᵁ Y.basicOpen g)) hxx
    obtain ⟨m, rfl⟩ := (Submonoid.mem_powers_iff _ _).1 hc
    exact ⟨m, hc'⟩

  have hS : ∀ (g : Γ(Y, U)) (z : Γ(Y, Y.basicOpen g)), ∃ (p : ℕ) (e : Γ(Y, U)),
      z * (Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g ^ p =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom e := by
    intro g z
    haveI := hU.isLocalization_basicOpen g
    exact IsLocalization.Away.surj g z

  have hN : ∀ (g r : Γ(Y, U)),
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom ((π.app U).hom r) =
      (π.app (Y.basicOpen g)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom r) := by
    intro g r
    have := congrArg (fun φ => φ.hom r) (π.naturality (homOfLE (Y.basicOpen_le g)).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this.symm

  have hL : ∀ (g : Γ(Y, U)) (t : Γ(W, π ⁻¹ᵁ Y.basicOpen g)), ∃ (n : ℕ) (x : Γ(W, π ⁻¹ᵁ U)),
      g ∈ s → t ∈ T g → x ∈ C ∧ (π.app (Y.basicOpen g)).hom
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g) ^ n * t =
        (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom x := by
    intro g t
    by_cases h : g ∈ s ∧ t ∈ T g
    · obtain ⟨n, x, hx, he⟩ := H2 g h.1 t h.2
      exact ⟨n, x, fun _ _ => ⟨hx, he⟩⟩
    · exact ⟨0, 0, fun hg ht => absurd ⟨hg, ht⟩ h⟩
  choose NL X hX using hL

  let T' : Finset Γ(W, π ⁻¹ᵁ U) := (s.sigma T).image (fun p => X p.1 p.2)
  have hT'C : (↑T' : Set Γ(W, π ⁻¹ᵁ U)) ⊆ C := by
    intro y hy
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hy)
    obtain ⟨h1, h2⟩ := Finset.mem_sigma.1 hp
    exact (hX p.1 p.2 h1 h2).1
  have hmemT' : ∀ g ∈ s, ∀ t ∈ T g, X g t ∈ T' := fun g hg t ht =>
    Finset.mem_image.2 ⟨⟨g, t⟩, Finset.mem_sigma.2 ⟨hg, ht⟩, rfl⟩
  refine ⟨T', hT'C, fun a ha => ?_⟩
  letI : Algebra Γ(Y, U) Γ(W, π ⁻¹ᵁ U) := (π.app U).hom.toAlgebra
  have hsmul : ∀ (r : Γ(Y, U)) (b : Γ(W, π ⁻¹ᵁ U)), r • b = (π.app U).hom r * b := by
    intro r b
    rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra]

  have hloc : ∀ r : (↑s : Set Γ(Y, U)), ∃ n : ℕ,
      (r : Γ(Y, U)) ^ n • a ∈ Submodule.span Γ(Y, U) (↑T' : Set Γ(W, π ⁻¹ᵁ U)) := by
    rintro ⟨g, hg⟩
    have hg' : g ∈ s := Finset.mem_coe.1 hg
    obtain ⟨c, hc⟩ := H1 g hg' a ha
    choose p e he using hS g
    obtain ⟨N, hNle⟩ : ∃ N : ℕ, ∀ t ∈ T g, p (c t) + NL g t ≤ N :=
      ⟨∑ t ∈ T g, (p (c t) + NL g t), fun t ht =>
        Finset.single_le_sum (f := fun t => p (c t) + NL g t) (fun _ _ => Nat.zero_le _) ht⟩
    have hNg := hN g
    have hXg : ∀ t ∈ T g, (π.app (Y.basicOpen g)).hom
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g) ^ NL g t * t =
        (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom (X g t) :=
      fun t ht => (hX g t hg' ht).2
    have key : (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom
          ((π.app U).hom g ^ N * a) =
        (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom
          (∑ t ∈ T g, (π.app U).hom (g ^ (N - p (c t) - NL g t) * e (c t)) * X g t) := by
      rw [map_mul, map_pow, hNg, hc, Finset.mul_sum, map_sum]
      refine Finset.sum_congr rfl (fun t ht => ?_)
      rw [map_mul, hNg, ← hXg t ht]
      simp only [map_mul, map_pow]
      rw [← he (c t)]
      simp only [map_mul, map_pow]
      have hpow : (π.app (Y.basicOpen g)).hom
            ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g) ^ N =
          (π.app (Y.basicOpen g)).hom
            ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g) ^ (N - p (c t) - NL g t) *
          (π.app (Y.basicOpen g)).hom
            ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g) ^ p (c t) *
          (π.app (Y.basicOpen g)).hom
            ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g) ^ NL g t := by
        rw [← pow_add, ← pow_add]
        congr 1
        have := hNle t ht
        omega
      rw [hpow]
      ring
    obtain ⟨m, hm⟩ := hK g _ _ key
    refine ⟨m + N, ?_⟩
    have hrw : g ^ (m + N) • a = ∑ t ∈ T g,
        (g ^ m * (g ^ (N - p (c t) - NL g t) * e (c t))) • X g t := by
      rw [hsmul, map_pow, pow_add, mul_assoc, hm, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun t _ => ?_)
      rw [hsmul]
      simp only [map_mul, map_pow]
      ring
    show g ^ (m + N) • a ∈ Submodule.span Γ(Y, U) (↑T' : Set Γ(W, π ⁻¹ᵁ U))
    rw [hrw]
    exact Submodule.sum_mem _ (fun t ht =>
      Submodule.smul_mem _ _ (Submodule.subset_span (Finset.mem_coe.2 (hmemT' g hg' t ht))))

  have hmem := Submodule.mem_of_span_eq_top_of_smul_pow_mem _ (↑s : Set Γ(Y, U)) hs a hloc
  obtain ⟨f, -, hf⟩ := Submodule.mem_span_finset.1 hmem
  refine ⟨f, ?_⟩
  rw [← hf]
  exact Finset.sum_congr rfl (fun t _ => hsmul (f t) t)

theorem wc_fsys_glue_two : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) [IsAffineHom π] (O₁ O₂ : Y.Opens) (𝒜₁ 𝒜₂ : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), wcFSys π O₁ 𝒜₁ → wcFSys π O₂ 𝒜₂ → (∀ V : Y.Opens, IsAffineOpen V → V ≤ O₁ ⊓ O₂ → ∀ a, a ∈ 𝒜₁ V ↔ a ∈ 𝒜₂ V) → ∃ 𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V), wcFSys π (O₁ ⊔ O₂) 𝒜 ∧ (∀ V : Y.Opens, IsAffineOpen V → V ≤ O₁ → ∀ a, a ∈ 𝒜 V ↔ a ∈ 𝒜₁ V) ∧ (∀ V : Y.Opens, IsAffineOpen V → V ≤ O₂ → ∀ a, a ∈ 𝒜 V ↔ a ∈ 𝒜₂ V) :=
by
  intro Y W π _ O₁ O₂ 𝒜₁ 𝒜₂ h₁ h₂ hov
  classical

  have R1 : ∀ (U V V' : Y.Opens) (hVU : V ≤ U) (hWV : V' ≤ V) (a : Γ(W, π ⁻¹ᵁ U)),
      (W.presheaf.map (homOfLE (π.preimage_mono hWV)).op).hom
        ((W.presheaf.map (homOfLE (π.preimage_mono hVU)).op).hom a) =
      (W.presheaf.map (homOfLE (π.preimage_mono (hWV.trans hVU))).op).hom a := by
    intro U V V' hVU hWV a
    change (W.presheaf.map (homOfLE (π.preimage_mono hVU)).op ≫
      W.presheaf.map (homOfLE (π.preimage_mono hWV)).op).hom a = _
    rw [← Functor.map_comp]
    rfl

  have R2 : ∀ (U : Y.Opens) (a : Γ(W, π ⁻¹ᵁ U)),
      (W.presheaf.map (homOfLE (π.preimage_mono (le_refl U))).op).hom a = a := by
    intro U a
    change (W.presheaf.map (𝟙 (Opposite.op (π ⁻¹ᵁ U)))).hom a = a
    rw [W.presheaf.map_id]
    rfl

  have N : ∀ (U V : Y.Opens) (h : V ≤ U) (c : Γ(Y, U)),
      (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom ((π.app U).hom c) =
      (π.app V).hom ((Y.presheaf.map (homOfLE h).op).hom c) := by
    intro U V h c
    have := congrArg (fun φ => φ.hom c) (π.naturality (homOfLE h).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this.symm

  have hR : ∀ (O : Y.Opens) (𝒢 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), wcFSys π O 𝒢 →
      ∀ (U : Y.Opens), IsAffineOpen U → U ≤ O → ∀ a ∈ 𝒢 U, ∀ (V : Y.Opens) (hVU : V ≤ U),
      IsAffineOpen V → (W.presheaf.map (homOfLE (π.preimage_mono hVU)).op).hom a ∈ 𝒢 V := by
    intro O 𝒢 h𝒢 U hU hUO a ha V hVU hV
    refine wc_fsys_family_mem Y W π O 𝒢 h𝒢 U hU {1} (by simp) (fun _ => O) (fun _ => 𝒢)
      (fun _ _ => h𝒢) (fun _ _ => (Y.basicOpen_le _).trans hUO)
      (fun _ _ _ _ _ _ _ hy => hy) a ?_ V hVU hV (hVU.trans hUO)
    intro g hg
    rw [Finset.mem_singleton] at hg
    subst hg
    exact (h𝒢.2 U hU hUO 1).1 a ha

  have hcover : ∀ U : Y.Opens, IsAffineOpen U → U ≤ O₁ ⊔ O₂ → ∃ s : Finset Γ(Y, U),
      Ideal.span (↑s : Set Γ(Y, U)) = ⊤ ∧ ∀ g ∈ s, Y.basicOpen g ≤ O₁ ∨ Y.basicOpen g ≤ O₂ := by
    intro U hU hUO
    let S : Set Γ(Y, U) := {g | Y.basicOpen g ≤ O₁ ∨ Y.basicOpen g ≤ O₂}
    have hS : Ideal.span S = ⊤ := by
      rw [← hU.self_le_iSup_basicOpen_iff]
      intro x hx
      have hx' : x ∈ O₁ ⊔ O₂ := hUO hx
      rw [TopologicalSpace.Opens.mem_iSup]
      rcases hx' with h | h
      · obtain ⟨f, hf, hxf⟩ := hU.exists_basicOpen_le (V := U ⊓ O₁) ⟨x, ⟨hx, h⟩⟩ hx
        exact ⟨⟨f, Or.inl (hf.trans inf_le_right)⟩, hxf⟩
      · obtain ⟨f, hf, hxf⟩ := hU.exists_basicOpen_le (V := U ⊓ O₂) ⟨x, ⟨hx, h⟩⟩ hx
        exact ⟨⟨f, Or.inr (hf.trans inf_le_right)⟩, hxf⟩
    obtain ⟨s', hs'S, hs'⟩ := (Ideal.span_eq_top_iff_finite S).1 hS
    exact ⟨s', hs', fun g hg => hs'S hg⟩

  obtain ⟨𝒜, hmem⟩ : ∃ 𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V), ∀ (U : Y.Opens) (a : Γ(W, π ⁻¹ᵁ U)),
      a ∈ 𝒜 U ↔ ((∀ (V : Y.Opens) (h : V ≤ U), IsAffineOpen V → V ≤ O₁ →
          (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom a ∈ 𝒜₁ V) ∧
        (∀ (V : Y.Opens) (h : V ≤ U), IsAffineOpen V → V ≤ O₂ →
          (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom a ∈ 𝒜₂ V)) :=
    ⟨fun U => {a | (∀ (V : Y.Opens) (h : V ≤ U), IsAffineOpen V → V ≤ O₁ →
          (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom a ∈ 𝒜₁ V) ∧
        (∀ (V : Y.Opens) (h : V ≤ U), IsAffineOpen V → V ≤ O₂ →
          (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom a ∈ 𝒜₂ V)},
      fun _ _ => Iff.rfl⟩

  have AG₁ : ∀ V : Y.Opens, IsAffineOpen V → V ≤ O₁ → ∀ a, a ∈ 𝒜 V ↔ a ∈ 𝒜₁ V := by
    intro V hV hVO a
    constructor
    · intro ha
      have h0 := ((hmem V a).1 ha).1 V (le_refl V) hV hVO
      rwa [R2] at h0
    · intro ha
      refine (hmem V a).2 ⟨fun V' h hV' _ => hR O₁ 𝒜₁ h₁ V hV hVO a ha V' h hV',
        fun V' h hV' hV'O => ?_⟩
      exact (hov V' hV' (le_inf (h.trans hVO) hV'O) _).1 (hR O₁ 𝒜₁ h₁ V hV hVO a ha V' h hV')
  have AG₂ : ∀ V : Y.Opens, IsAffineOpen V → V ≤ O₂ → ∀ a, a ∈ 𝒜 V ↔ a ∈ 𝒜₂ V := by
    intro V hV hVO a
    constructor
    · intro ha
      have h0 := ((hmem V a).1 ha).2 V (le_refl V) hV hVO
      rwa [R2] at h0
    · intro ha
      refine (hmem V a).2 ⟨fun V' h hV' hV'O => ?_,
        fun V' h hV' _ => hR O₂ 𝒜₂ h₂ V hV hVO a ha V' h hV'⟩
      exact (hov V' hV' (le_inf hV'O (h.trans hVO)) _).2 (hR O₂ 𝒜₂ h₂ V hV hVO a ha V' h hV')

  have hres : ∀ (U V : Y.Opens) (h : V ≤ U) (a : Γ(W, π ⁻¹ᵁ U)), a ∈ 𝒜 U →
      (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom a ∈ 𝒜 V := by
    intro U V h a ha
    obtain ⟨ha1, ha2⟩ := (hmem U a).1 ha
    refine (hmem V _).2 ⟨fun V' h' hV' hO => ?_, fun V' h' hV' hO => ?_⟩
    · rw [R1 U V V' h h']; exact ha1 V' (h'.trans h) hV' hO
    · rw [R1 U V V' h h']; exact ha2 V' (h'.trans h) hV' hO

  have hmain : ∀ U : Y.Opens, IsAffineOpen U → U ≤ O₁ ⊔ O₂ →
      (∀ (f : Γ(Y, U)) (b : Γ(W, π ⁻¹ᵁ Y.basicOpen f)), b ∈ 𝒜 (Y.basicOpen f) →
        ∃ (n : ℕ) (a : Γ(W, π ⁻¹ᵁ U)), a ∈ 𝒜 U ∧
          (π.app (Y.basicOpen f)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) ^ n
            * b = (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom a) ∧
      (∃ T : Finset Γ(W, π ⁻¹ᵁ U), (↑T : Set Γ(W, π ⁻¹ᵁ U)) ⊆ 𝒜 U ∧
        ∀ a ∈ 𝒜 U, ∃ c : Γ(W, π ⁻¹ᵁ U) → Γ(Y, U), a = ∑ t ∈ T, (π.app U).hom (c t) * t) := by
    intro U hU hUO
    obtain ⟨s, hs, hcov⟩ := hcover U hU hUO
    obtain ⟨O', 𝒢, hsel⟩ : ∃ (O' : Γ(Y, U) → Y.Opens)
        (𝒢 : Γ(Y, U) → ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), ∀ g ∈ s,
        (O' g = O₁ ∧ 𝒢 g = 𝒜₁ ∧ Y.basicOpen g ≤ O₁) ∨
        (O' g = O₂ ∧ 𝒢 g = 𝒜₂ ∧ Y.basicOpen g ≤ O₂) := by
      refine ⟨fun g => if Y.basicOpen g ≤ O₁ then O₁ else O₂,
        fun g => if Y.basicOpen g ≤ O₁ then 𝒜₁ else 𝒜₂, fun g hg => ?_⟩
      by_cases h : Y.basicOpen g ≤ O₁
      · exact Or.inl ⟨if_pos h, if_pos h, h⟩
      · exact Or.inr ⟨if_neg h, if_neg h, (hcov g hg).resolve_left h⟩
    have F1 : ∀ g ∈ s, wcFSys π (O' g) (𝒢 g) := by
      intro g hg
      rcases hsel g hg with ⟨e1, e2, _⟩ | ⟨e1, e2, _⟩
      · rw [e1, e2]; exact h₁
      · rw [e1, e2]; exact h₂
    have FD : ∀ g ∈ s, Y.basicOpen g ≤ O' g := by
      intro g hg
      rcases hsel g hg with ⟨e1, _, hD⟩ | ⟨e1, _, hD⟩
      · rw [e1]; exact hD
      · rw [e1]; exact hD
    have F2 : ∀ g ∈ s, ∀ N : Y.Opens, IsAffineOpen N → N ≤ O₁ → N ≤ O' g →
        ∀ y, y ∈ 𝒢 g N → y ∈ 𝒜₁ N := by
      intro g hg N hN hN1 hN' y hy
      rcases hsel g hg with ⟨e1, e2, _⟩ | ⟨e1, e2, _⟩
      · rw [e2] at hy; exact hy
      · rw [e1] at hN'; rw [e2] at hy; exact (hov N hN (le_inf hN1 hN') y).2 hy
    have F2' : ∀ g ∈ s, ∀ N : Y.Opens, IsAffineOpen N → N ≤ O₂ → N ≤ O' g →
        ∀ y, y ∈ 𝒢 g N → y ∈ 𝒜₂ N := by
      intro g hg N hN hN2 hN' y hy
      rcases hsel g hg with ⟨e1, e2, _⟩ | ⟨e1, e2, _⟩
      · rw [e1] at hN'; rw [e2] at hy; exact (hov N hN (le_inf hN' hN2) y).1 hy
      · rw [e2] at hy; exact hy
    have F3 : ∀ g ∈ s, ∀ t ∈ 𝒢 g (Y.basicOpen g), t ∈ 𝒜 (Y.basicOpen g) := by
      intro g hg t ht
      rcases hsel g hg with ⟨_, e2, hD⟩ | ⟨_, e2, hD⟩
      · rw [e2] at ht; exact (AG₁ _ (hU.basicOpen g) hD t).2 ht
      · rw [e2] at ht; exact (AG₂ _ (hU.basicOpen g) hD t).2 ht
    have KC : ∀ a ∈ 𝒜 U, ∀ g ∈ s,
        (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom a ∈
          𝒢 g (Y.basicOpen g) := by
      intro a ha g hg
      obtain ⟨ha1, ha2⟩ := (hmem U a).1 ha
      rcases hsel g hg with ⟨_, e2, hD⟩ | ⟨_, e2, hD⟩
      · rw [e2]; exact ha1 _ (Y.basicOpen_le g) (hU.basicOpen g) hD
      · rw [e2]; exact ha2 _ (Y.basicOpen_le g) (hU.basicOpen g) hD
    have KCinv : ∀ a : Γ(W, π ⁻¹ᵁ U), (∀ g ∈ s,
        (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom a ∈
          𝒢 g (Y.basicOpen g)) → a ∈ 𝒜 U := by
      intro a hloc
      exact (hmem U a).2
        ⟨fun V h hV hVO => wc_fsys_family_mem Y W π O₁ 𝒜₁ h₁ U hU s hs O' 𝒢 F1 FD F2 a hloc
          V h hV hVO,
         fun V h hV hVO => wc_fsys_family_mem Y W π O₂ 𝒜₂ h₂ U hU s hs O' 𝒢 F1 FD F2' a hloc
          V h hV hVO⟩
    have hb2 : ∀ (f : Γ(Y, U)) (b : Γ(W, π ⁻¹ᵁ Y.basicOpen f)), b ∈ 𝒜 (Y.basicOpen f) →
        ∃ (n : ℕ) (a : Γ(W, π ⁻¹ᵁ U)), a ∈ 𝒜 U ∧
          (π.app (Y.basicOpen f)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) ^ n
            * b = (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom a := by
      intro f b hb
      obtain ⟨hb1, hb2'⟩ := (hmem _ b).1 hb
      obtain ⟨n, x, hx, hxs⟩ := wc_fsys_family_lift Y W π U hU s O' 𝒢 F1 FD f b
        (fun g hg V hV hVa hVg => by
          rcases hsel g hg with ⟨_, e2, hD⟩ | ⟨_, e2, hD⟩
          · rw [e2]; exact hb1 V hV hVa (hVg.trans hD)
          · rw [e2]; exact hb2' V hV hVa (hVg.trans hD))
      exact ⟨n, x, KCinv x hxs, hx⟩
    refine ⟨hb2, ?_⟩
    have hT : ∀ g : Γ(Y, U), ∃ T : Finset Γ(W, π ⁻¹ᵁ Y.basicOpen g), g ∈ s →
        ((↑T : Set Γ(W, π ⁻¹ᵁ Y.basicOpen g)) ⊆ 𝒢 g (Y.basicOpen g) ∧
          ∀ a ∈ 𝒢 g (Y.basicOpen g), ∃ c : Γ(W, π ⁻¹ᵁ Y.basicOpen g) → Γ(Y, Y.basicOpen g),
            a = ∑ t ∈ T, (π.app (Y.basicOpen g)).hom (c t) * t) := by
      intro g
      by_cases hg : g ∈ s
      · obtain ⟨T, hT1, hT2⟩ := ((F1 g hg).1 _ (hU.basicOpen g) (FD g hg)).2.2
        exact ⟨T, fun _ => ⟨hT1, hT2⟩⟩
      · exact ⟨∅, fun h => absurd h hg⟩
    choose T hT using hT
    exact wc_fsys_span_of_local Y W π U hU s hs (𝒜 U) T
      (fun g hg a ha => (hT g hg).2 _ (KC a ha g hg))
      (fun g hg t ht => hb2 g t (F3 g hg t ((hT g hg).1 (Finset.mem_coe.2 ht))))

  refine ⟨𝒜, ⟨fun V hV hVO => ⟨?_, ?_, (hmain V hV hVO).2⟩,
    fun U hU hUO f => ⟨fun a ha => hres U _ (Y.basicOpen_le f) a ha, (hmain U hU hUO).1 f⟩⟩,
    AG₁, AG₂⟩
  · intro c
    refine (hmem V _).2 ⟨fun V' h hV' hO => ?_, fun V' h hV' hO => ?_⟩
    · rw [N V V' h]; exact (h₁.1 V' hV' hO).1 _
    · rw [N V V' h]; exact (h₂.1 V' hV' hO).1 _
  · intro a ha b hb
    obtain ⟨ha1, ha2⟩ := (hmem V a).1 ha
    obtain ⟨hb1, hb2⟩ := (hmem V b).1 hb
    refine ⟨(hmem V _).2 ⟨fun V' h hV' hO => ?_, fun V' h hV' hO => ?_⟩,
      (hmem V _).2 ⟨fun V' h hV' hO => ?_, fun V' h hV' hO => ?_⟩⟩
    · rw [map_add]
      exact ((h₁.1 V' hV' hO).2.1 _ (ha1 V' h hV' hO) _ (hb1 V' h hV' hO)).1
    · rw [map_add]
      exact ((h₂.1 V' hV' hO).2.1 _ (ha2 V' h hV' hO) _ (hb2 V' h hV' hO)).1
    · rw [map_mul]
      exact ((h₁.1 V' hV' hO).2.1 _ (ha1 V' h hV' hO) _ (hb1 V' h hV' hO)).2
    · rw [map_mul]
      exact ((h₂.1 V' hV' hO).2.1 _ (ha2 V' h hV' hO) _ (hb2 V' h hV' hO)).2

theorem wc_fsys_restrict : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) [IsAffineHom π] (O : Y.Opens) (𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), wcFSys π O 𝒜 → ∀ (U V : Y.Opens) (hVU : V ≤ U), IsAffineOpen U → U ≤ O → IsAffineOpen V → ∀ a ∈ 𝒜 U, (W.presheaf.map (homOfLE (π.preimage_mono hVU)).op).hom a ∈ 𝒜 V :=
by
  intro Y W π _ O 𝒜 h𝒜 U V hVU hU hUO hV a ha
  classical

  have hF : ∀ (U₁ U₂ U₃ : Y.Opens) (h₁ : U₂ ≤ U₁) (h₂ : U₃ ≤ U₂) (b : Γ(W, π ⁻¹ᵁ U₁)),
      (W.presheaf.map (homOfLE (π.preimage_mono h₂)).op).hom
        ((W.presheaf.map (homOfLE (π.preimage_mono h₁)).op).hom b) =
      (W.presheaf.map (homOfLE (π.preimage_mono (h₂.trans h₁))).op).hom b := by
    intro U₁ U₂ U₃ h₁ h₂ b
    change (W.presheaf.map (homOfLE (π.preimage_mono h₁)).op ≫
      W.presheaf.map (homOfLE (π.preimage_mono h₂)).op).hom b = _
    rw [← Functor.map_comp]
    rfl

  have hTr : ∀ (E E' : Y.Opens) (hle : E' ≤ E), E = E' → ∀ b ∈ 𝒜 E,
      (W.presheaf.map (homOfLE (π.preimage_mono hle)).op).hom b ∈ 𝒜 E' := by
    intro E E' hle he b hb
    subst he
    rw [show (homOfLE (π.preimage_mono hle)).op = 𝟙 (Opposite.op (π ⁻¹ᵁ E)) from rfl,
      W.presheaf.map_id]
    exact hb

  let s : Set Γ(Y, V) := {g | ∃ f : Γ(Y, U), Y.basicOpen f = Y.basicOpen g}
  have hspan : Ideal.span s = ⊤ := by
    rw [← hV.self_le_iSup_basicOpen_iff]
    intro x hxV
    obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter hU hV x
      (TopologicalSpace.Opens.mem_inf.mpr ⟨hVU hxV, hxV⟩)
    have hxg : x ∈ Y.basicOpen g := hfg ▸ hxf
    exact TopologicalSpace.Opens.mem_iSup.mpr
      ⟨⟨g, show ∃ f : Γ(Y, U), Y.basicOpen f = Y.basicOpen g from ⟨f, hfg⟩⟩, hxg⟩
  refine wc_fsys_local_mem Y W π O 𝒜 h𝒜 V hV (hVU.trans hUO) _ s hspan ?_
  intro g hg
  obtain ⟨f, hfg⟩ := hg
  have key := hTr (Y.basicOpen f) (Y.basicOpen g) (le_of_eq hfg.symm) hfg _
    ((h𝒜.2 U hU hUO f).1 a ha)
  rw [hF U (Y.basicOpen f) (Y.basicOpen g) (Y.basicOpen_le f) (le_of_eq hfg.symm) a] at key
  rw [hF U V (Y.basicOpen g) hVU (Y.basicOpen_le g) a]
  exact key

theorem wc_fsys_affine_generators : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) [IsAffineHom π] (O : Y.Opens) (𝒢 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), wcFSys π O 𝒢 → ∀ (V : Y.Opens), IsAffineOpen V → ∀ (s₀ : Finset Γ(Y, V)), (∀ g ∈ s₀, Y.basicOpen g ≤ O) → ∃ X : Finset Γ(W, π ⁻¹ᵁ V), (∀ x ∈ X, ∀ g ∈ s₀, (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom x ∈ 𝒢 (Y.basicOpen g)) ∧ ∀ g ∈ s₀, ∀ b ∈ 𝒢 (Y.basicOpen g), ∃ c : Γ(W, π ⁻¹ᵁ V) → Γ(Y, Y.basicOpen g), b = ∑ x ∈ X, (π.app (Y.basicOpen g)).hom (c x) * (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom x :=
by
  intro Y W π _ O 𝒢 h𝒢 V hV s₀ hs₀
  classical

  have hT : ∀ g : Γ(Y, V), ∃ T : Finset Γ(W, π ⁻¹ᵁ Y.basicOpen g), g ∈ s₀ →
      ((↑T : Set Γ(W, π ⁻¹ᵁ Y.basicOpen g)) ⊆ 𝒢 (Y.basicOpen g) ∧
        ∀ b ∈ 𝒢 (Y.basicOpen g), ∃ e : Γ(W, π ⁻¹ᵁ Y.basicOpen g) → Γ(Y, Y.basicOpen g),
          b = ∑ t ∈ T, (π.app (Y.basicOpen g)).hom (e t) * t) := by
    intro g
    by_cases hg : g ∈ s₀
    · obtain ⟨T, h1, h2⟩ := (h𝒢.1 (Y.basicOpen g) (hV.basicOpen g) (hs₀ g hg)).2.2
      exact ⟨T, fun _ => ⟨h1, h2⟩⟩
    · exact ⟨∅, fun h => absurd h hg⟩
  choose T hT using hT

  have hx : ∀ (g : Γ(Y, V)) (t : Γ(W, π ⁻¹ᵁ Y.basicOpen g)), ∃ (n : ℕ) (x : Γ(W, π ⁻¹ᵁ V)),
      g ∈ s₀ → t ∈ T g →
      ((π.app (Y.basicOpen g)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g) ^ n * t =
          (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom x ∧
        ∀ g' ∈ s₀, (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g'))).op).hom x ∈
          𝒢 (Y.basicOpen g')) := by
    intro g t
    by_cases hg : g ∈ s₀
    · by_cases ht : t ∈ T g
      · obtain ⟨n, x, h1, h2⟩ := wc_fsys_family_lift Y W π V hV s₀ (fun _ => O) (fun _ => 𝒢)
          (fun _ _ => h𝒢) hs₀ g t (fun g' _ V' hV' hV'a _ =>
            wc_fsys_restrict Y W π O 𝒢 h𝒢 (Y.basicOpen g) V' hV' (hV.basicOpen g) (hs₀ g hg)
              hV'a t ((hT g hg).1 ht))
        exact ⟨n, x, fun _ _ => ⟨h1, h2⟩⟩
      · exact ⟨0, 0, fun _ h => absurd h ht⟩
    · exact ⟨0, 0, fun h => absurd h hg⟩
  choose N x hx using hx

  have hmaps : ∀ g ∈ s₀, ∀ t ∈ T g, x g t ∈ s₀.biUnion (fun g => (T g).image (x g)) :=
    fun g hg t ht => Finset.mem_biUnion.mpr ⟨g, hg, Finset.mem_image_of_mem _ ht⟩
  refine ⟨s₀.biUnion (fun g => (T g).image (x g)), ?_, ?_⟩
  · intro y hy g' hg'
    obtain ⟨g, hg, hy'⟩ := Finset.mem_biUnion.mp hy
    obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hy'
    exact (hx g t hg ht).2 g' hg'

  · intro g hg b hb
    obtain ⟨e, he⟩ := (hT g hg).2 b hb
    haveI := hV.isLocalization_basicOpen g
    have hu : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g) :=
      IsLocalization.Away.algebraMap_isUnit g
    obtain ⟨v, hv⟩ := hu.exists_left_inv
    have h6c : ∀ t ∈ T g, (π.app (Y.basicOpen g)).hom (e t) * t =
        (π.app (Y.basicOpen g)).hom (e t * v ^ N g t) *
          (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom (x g t) := by
      intro t ht
      have hone : (π.app (Y.basicOpen g)).hom v ^ N g t *
          (π.app (Y.basicOpen g)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le g)).op).hom g) ^
            N g t = 1 := by
        rw [← mul_pow, ← map_mul, hv, map_one, one_pow]
      rw [← (hx g t hg ht).1, map_mul, map_pow]
      linear_combination (-((π.app (Y.basicOpen g)).hom (e t) * t)) * hone
    refine ⟨fun y => ∑ t ∈ (T g).filter (fun t => x g t = y), e t * v ^ N g t, ?_⟩
    rw [he, ← Finset.sum_fiberwise_of_maps_to (hmaps g hg)]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    rw [map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun t ht => ?_)
    obtain ⟨ht1, ht2⟩ := Finset.mem_filter.mp ht
    rw [h6c t ht1, ht2]

theorem wc_integral_adjoin_finite_span : ∀ (R S : Type u) [CommRing R] [CommRing S] (φ : R →+* S) (X : Finset S), (∀ x ∈ X, φ.IsIntegralElem x) → ∃ C : Set S, (∀ c : R, φ c ∈ C) ∧ (∀ a ∈ C, ∀ b ∈ C, a + b ∈ C ∧ a * b ∈ C) ∧ (↑X : Set S) ⊆ C ∧ (∀ G : Set S, (∀ c : R, φ c ∈ G) → (∀ a ∈ G, ∀ b ∈ G, a + b ∈ G ∧ a * b ∈ G) → (↑X : Set S) ⊆ G → C ⊆ G) ∧ ∃ T : Finset S, (↑T : Set S) ⊆ C ∧ ∀ a ∈ C, ∃ c : S → R, a = ∑ t ∈ T, φ (c t) * t :=
by
  intro R S _ _ φ X hX
  letI : Algebra R S := φ.toAlgebra
  have hX' : ∀ x ∈ (↑X : Set S), IsIntegral R x := fun x hx => hX x hx
  obtain ⟨T, hT⟩ := fg_adjoin_of_finite X.finite_toSet hX'
  refine ⟨(Algebra.adjoin R (↑X : Set S) : Set S), fun c => ?_, fun a ha b hb => ?_,
    Algebra.subset_adjoin, fun G hG1 hG2 hG3 => ?_, T, ?_, ?_⟩
  · exact Subalgebra.algebraMap_mem _ c
  · exact ⟨Subalgebra.add_mem _ ha hb, Subalgebra.mul_mem _ ha hb⟩
  · intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem x hx => exact hG3 hx
    | algebraMap r => exact hG1 r
    | add x y _ _ hx hy => exact (hG2 x hx y hy).1
    | mul x y _ _ hx hy => exact (hG2 x hx y hy).2
  · intro t ht
    have h1 : t ∈ Submodule.span R (↑T : Set S) := Submodule.subset_span ht
    rw [hT] at h1
    exact h1
  · intro a ha
    have h1 : a ∈ Subalgebra.toSubmodule (Algebra.adjoin R (↑X : Set S)) := ha
    rw [← hT, Submodule.mem_span_finset] at h1
    obtain ⟨f, -, hf⟩ := h1
    refine ⟨f, ?_⟩
    rw [← hf]
    refine Finset.sum_congr rfl (fun t _ => ?_)
    rw [Algebra.smul_def]
    rfl

theorem wc_fsys_of_finite_subalgebra : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) (V : Y.Opens), IsAffineOpen V → ∀ (C : Set Γ(W, π ⁻¹ᵁ V)), (∀ c : Γ(Y, V), (π.app V).hom c ∈ C) → (∀ a ∈ C, ∀ b ∈ C, a + b ∈ C ∧ a * b ∈ C) → ∀ (T : Finset Γ(W, π ⁻¹ᵁ V)), (↑T : Set Γ(W, π ⁻¹ᵁ V)) ⊆ C → (∀ a ∈ C, ∃ c : Γ(W, π ⁻¹ᵁ V) → Γ(Y, V), a = ∑ t ∈ T, (π.app V).hom (c t) * t) → ∃ 𝒜 : ∀ V' : Y.Opens, Set Γ(W, π ⁻¹ᵁ V'), wcFSys π V 𝒜 ∧ (∀ a, a ∈ 𝒜 V ↔ a ∈ C) ∧ (∀ (U : Y.Opens) (hUV : U ≤ V), IsAffineOpen U → ∀ a ∈ 𝒜 U, ∃ c : Γ(W, π ⁻¹ᵁ V) → Γ(Y, U), a = ∑ t ∈ T, (π.app U).hom (c t) * (W.presheaf.map (homOfLE (π.preimage_mono hUV)).op).hom t) ∧ (∀ (U : Y.Opens) (hUV : U ≤ V), IsAffineOpen U → ∀ x ∈ C, (W.presheaf.map (homOfLE (π.preimage_mono hUV)).op).hom x ∈ 𝒜 U) :=
by
  intro Y W π V hV C hC1 hC2 T hTC hTspan
  classical

  have hS2 : ∀ (R S ι : Type u) [CommRing R] [CommRing S] (ψ : R →+* S) (T : Finset ι)
      (e : ι → S), (∃ c₁ : ι → R, (1 : S) = ∑ t ∈ T, ψ (c₁ t) * e t) →
      (∀ t ∈ T, ∀ t' ∈ T, ∃ d : ι → R, e t * e t' = ∑ s ∈ T, ψ (d s) * e s) →
      (∀ r : R, ∃ c : ι → R, ψ r = ∑ t ∈ T, ψ (c t) * e t) ∧
      (∀ c c' : ι → R, ∃ d : ι → R, (∑ t ∈ T, ψ (c t) * e t) + (∑ t ∈ T, ψ (c' t) * e t) =
        ∑ t ∈ T, ψ (d t) * e t) ∧
      (∀ c c' : ι → R, ∃ d : ι → R, (∑ t ∈ T, ψ (c t) * e t) * (∑ t ∈ T, ψ (c' t) * e t) =
        ∑ t ∈ T, ψ (d t) * e t) := by
    intro R S ι _ _ ψ T e hunit hprod
    obtain ⟨c₁, hc₁⟩ := hunit
    have hD : ∀ t t' : ι, ∃ d : ι → R, t ∈ T → t' ∈ T → e t * e t' = ∑ s ∈ T, ψ (d s) * e s := by
      intro t t'
      by_cases h : t ∈ T ∧ t' ∈ T
      · obtain ⟨d, hd⟩ := hprod t h.1 t' h.2
        exact ⟨d, fun _ _ => hd⟩
      · exact ⟨0, fun h1 h2 => absurd ⟨h1, h2⟩ h⟩
    choose D hD using hD
    refine ⟨fun r => ⟨fun t => r * c₁ t, ?_⟩, fun c c' => ⟨fun t => c t + c' t, ?_⟩,
      fun c c' => ⟨fun s => ∑ t ∈ T, ∑ t' ∈ T, c t * c' t' * D t t' s, ?_⟩⟩
    · calc ψ r = ψ r * 1 := (mul_one _).symm
        _ = ψ r * ∑ t ∈ T, ψ (c₁ t) * e t := by rw [← hc₁]
        _ = ∑ t ∈ T, ψ (r * c₁ t) * e t := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun t _ => ?_)
          rw [map_mul, mul_assoc]
    · rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun t _ => ?_)
      rw [map_add, add_mul]
    · rw [Finset.sum_mul_sum]
      have step : ∀ t ∈ T, ∀ t' ∈ T, ψ (c t) * e t * (ψ (c' t') * e t') =
          ∑ s ∈ T, ψ (c t * c' t' * D t t' s) * e s := by
        intro t ht t' ht'
        have e1 : ψ (c t) * e t * (ψ (c' t') * e t') = ψ (c t * c' t') * (e t * e t') := by
          rw [map_mul]; ring
        rw [e1, hD t t' ht ht', Finset.mul_sum]
        refine Finset.sum_congr rfl (fun s _ => ?_)
        rw [map_mul ψ (c t * c' t') (D t t' s), mul_assoc]
      refine (Finset.sum_congr rfl (fun t ht => Finset.sum_congr rfl
        (fun t' ht' => step t ht t' ht'))).trans ?_
      simp only [map_sum, Finset.sum_mul]
      refine (Finset.sum_congr rfl (fun t _ => Finset.sum_comm)).trans ?_
      exact Finset.sum_comm

  have hS3 : ∀ (R S ι : Type u) [CommRing R] [CommRing S] (ψ : R →+* S) (T : Finset ι)
      (e : ι → S), ∃ T' : Finset S, (∀ s ∈ T', ∃ t ∈ T, e t = s) ∧
        ∀ c : ι → R, ∃ c' : S → R, ∑ t ∈ T, ψ (c t) * e t = ∑ s ∈ T', ψ (c' s) * s := by
    intro R S ι _ _ ψ T e
    refine ⟨T.image e, fun s hs => ?_, fun c => ⟨fun s => ∑ t ∈ T with e t = s, c t, ?_⟩⟩
    · obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hs
      exact ⟨t, ht, rfl⟩
    · rw [← Finset.sum_fiberwise_of_maps_to (fun t ht => Finset.mem_image_of_mem e ht)
        (fun t => ψ (c t) * e t)]
      simp only [map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun s _ => Finset.sum_congr rfl (fun t ht => ?_))
      rw [(Finset.mem_filter.mp ht).2]

  have hS4 : ∀ (R S ι : Type u) [CommRing R] [CommRing S] [Algebra R S] (f : R)
      [IsLocalization.Away f S] (T : Finset ι) (c : ι → S), ∃ (n : ℕ) (c' : ι → R),
        ∀ t ∈ T, algebraMap R S f ^ n * c t = algebraMap R S (c' t) := by
    intro R S ι _ _ _ f _ T c
    obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples (Submonoid.powers f) T c
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp b.2
    have H : ∀ t, ∃ r : R, t ∈ T → algebraMap R S r = (b : R) • c t := by
      intro t
      by_cases ht : t ∈ T
      · obtain ⟨r, hr⟩ := RingHom.mem_rangeS.mp (hb t ht)
        exact ⟨r, fun _ => hr⟩
      · exact ⟨0, fun h => absurd h ht⟩
    choose c' hc' using H
    refine ⟨n, c', fun t ht => ?_⟩
    rw [hc' t ht, Algebra.smul_def, ← hn, map_pow]

  have hF : ∀ (U₁ U₂ U₃ : Y.Opens) (h₁ : U₂ ≤ U₁) (h₂ : U₃ ≤ U₂) (a : Γ(W, π ⁻¹ᵁ U₁)),
      (W.presheaf.map (homOfLE (π.preimage_mono h₂)).op).hom
        ((W.presheaf.map (homOfLE (π.preimage_mono h₁)).op).hom a) =
      (W.presheaf.map (homOfLE (π.preimage_mono (h₂.trans h₁))).op).hom a := by
    intro U₁ U₂ U₃ h₁ h₂ a
    change (W.presheaf.map (homOfLE (π.preimage_mono h₁)).op ≫
      W.presheaf.map (homOfLE (π.preimage_mono h₂)).op).hom a = _
    rw [← Functor.map_comp]
    rfl
  have hN : ∀ (U₁ U₂ : Y.Opens) (h : U₂ ≤ U₁) (c : Γ(Y, U₁)),
      (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom ((π.app U₁).hom c) =
        (π.app U₂).hom ((Y.presheaf.map (homOfLE h).op).hom c) := by
    intro U₁ U₂ h c
    have e := congrArg (fun g => g.hom c) (π.naturality (homOfLE h).op)
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at e
    exact e.symm
  have hId : ∀ (h : V ≤ V) (x : Γ(W, π ⁻¹ᵁ V)),
      (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom x = x := by
    intro h x
    show (W.presheaf.map (𝟙 (Opposite.op (π ⁻¹ᵁ V)))).hom x = x
    rw [CategoryTheory.Functor.map_id]
    rfl

  have hR : ∀ (U' U'' : Y.Opens) (hU' : U' ≤ V) (h'' : U'' ≤ U') (c : Γ(W, π ⁻¹ᵁ V) → Γ(Y, U')),
      (W.presheaf.map (homOfLE (π.preimage_mono h'')).op).hom
        (∑ t ∈ T, (π.app U').hom (c t) * (W.presheaf.map (homOfLE (π.preimage_mono hU')).op).hom t) =
      ∑ t ∈ T, (π.app U'').hom ((Y.presheaf.map (homOfLE h'').op).hom (c t)) *
        (W.presheaf.map (homOfLE (π.preimage_mono (h''.trans hU'))).op).hom t := by
    intro U' U'' hU' h'' c
    rw [map_sum]
    refine Finset.sum_congr rfl (fun t _ => ?_)
    rw [map_mul, hN U' U'' h'' (c t), hF V U' U'' hU' h'' t]

  have hDm : ∀ (U : Y.Opens) (hUV : U ≤ V) (x : Γ(W, π ⁻¹ᵁ V)), x ∈ C →
      ∃ c : Γ(W, π ⁻¹ᵁ V) → Γ(Y, U), (W.presheaf.map (homOfLE (π.preimage_mono hUV)).op).hom x =
        ∑ t ∈ T, (π.app U).hom (c t) * (W.presheaf.map (homOfLE (π.preimage_mono hUV)).op).hom t := by
    intro U hUV x hx
    obtain ⟨c, rfl⟩ := hTspan x hx
    refine ⟨fun t => (Y.presheaf.map (homOfLE hUV).op).hom (c t), ?_⟩
    rw [map_sum]
    refine Finset.sum_congr rfl (fun t _ => ?_)
    rw [map_mul, hN V U hUV (c t)]
  refine ⟨fun U' => {a | ∃ (h : U' ≤ V) (c : Γ(W, π ⁻¹ᵁ V) → Γ(Y, U')),
      a = ∑ t ∈ T, (π.app U').hom (c t) * (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom t},
    ⟨fun V' hV' hV'V => ?_, fun U hU hUV f => ⟨?_, ?_⟩⟩, fun a => ⟨?_, ?_⟩, ?_, ?_⟩
  ·
    have h1 : ∃ c₁ : Γ(W, π ⁻¹ᵁ V) → Γ(Y, V'), (1 : Γ(W, π ⁻¹ᵁ V')) =
        ∑ t ∈ T, (π.app V').hom (c₁ t) *
          (W.presheaf.map (homOfLE (π.preimage_mono hV'V)).op).hom t := by
      obtain ⟨c, hc⟩ := hDm V' hV'V _ (hC1 1)
      refine ⟨c, ?_⟩
      rw [← hc, map_one, map_one]
    have h2 : ∀ t ∈ T, ∀ t' ∈ T, ∃ d : Γ(W, π ⁻¹ᵁ V) → Γ(Y, V'),
        (W.presheaf.map (homOfLE (π.preimage_mono hV'V)).op).hom t *
          (W.presheaf.map (homOfLE (π.preimage_mono hV'V)).op).hom t' =
        ∑ s ∈ T, (π.app V').hom (d s) *
          (W.presheaf.map (homOfLE (π.preimage_mono hV'V)).op).hom s := by
      intro t ht t' ht'
      obtain ⟨d, hd⟩ := hDm V' hV'V _ (hC2 t (hTC ht) t' (hTC ht')).2
      exact ⟨d, by rw [← map_mul, hd]⟩
    obtain ⟨hsc, had, hmu⟩ := hS2 _ _ _ (π.app V').hom T
      (fun t => (W.presheaf.map (homOfLE (π.preimage_mono hV'V)).op).hom t) h1 h2
    obtain ⟨T', hT'1, hT'2⟩ := hS3 _ _ _ (π.app V').hom T
      (fun t => (W.presheaf.map (homOfLE (π.preimage_mono hV'V)).op).hom t)
    refine ⟨fun c => ?_, ?_, T', fun s hs => ?_, ?_⟩
    · obtain ⟨c', hc'⟩ := hsc c
      exact ⟨hV'V, c', hc'⟩
    · rintro a ⟨ha, c, rfl⟩ b ⟨hb, c', rfl⟩
      obtain ⟨d, hd⟩ := had c c'
      obtain ⟨d', hd'⟩ := hmu c c'
      exact ⟨⟨hV'V, d, hd⟩, ⟨hV'V, d', hd'⟩⟩
    · obtain ⟨t, ht, rfl⟩ := hT'1 s hs
      obtain ⟨c, hc⟩ := hDm V' hV'V t (hTC ht)
      exact ⟨hV'V, c, hc⟩
    · rintro a ⟨ha, c, rfl⟩
      obtain ⟨c', hc'⟩ := hT'2 c
      exact ⟨c', hc'⟩
  ·
    rintro a ⟨h, c, rfl⟩
    exact ⟨(Y.basicOpen_le f).trans h,
      fun t => (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom (c t),
      hR U (Y.basicOpen f) h (Y.basicOpen_le f) c⟩
  ·
    rintro b ⟨h, c, rfl⟩
    haveI := hU.isLocalization_basicOpen f
    obtain ⟨n, c', hc'⟩ := hS4 Γ(Y, U) Γ(Y, Y.basicOpen f) Γ(W, π ⁻¹ᵁ V) f T c
    refine ⟨n, ∑ t ∈ T, (π.app U).hom (c' t) *
      (W.presheaf.map (homOfLE (π.preimage_mono hUV)).op).hom t, ⟨hUV, c', rfl⟩, ?_⟩
    rw [hR U (Y.basicOpen f) hUV (Y.basicOpen_le f) c', Finset.mul_sum]
    refine Finset.sum_congr rfl (fun t ht => ?_)
    have e := hc' t ht
    change (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f ^ n * c t =
      (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom (c' t) at e
    rw [← e, map_mul, map_pow, mul_assoc]
  ·
    rintro ⟨h, c, rfl⟩
    refine Finset.sum_induction _ (· ∈ C) (fun a b ha hb => (hC2 a ha b hb).1) ?_ ?_
    · have h0 := hC1 0
      rwa [map_zero] at h0
    · intro t ht
      show (π.app V).hom (c t) * (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom t ∈ C
      rw [hId h t]
      exact (hC2 _ (hC1 _) _ (hTC ht)).2
  ·
    intro ha
    obtain ⟨c, hc⟩ := hTspan a ha
    refine ⟨le_rfl, c, ?_⟩
    rw [hc]
    refine Finset.sum_congr rfl (fun t _ => ?_)
    rw [hId le_rfl]
  ·
    rintro U hUV hU a ⟨h, c, rfl⟩
    exact ⟨c, rfl⟩
  ·
    intro U hUV hU x hx
    obtain ⟨c, hc⟩ := hDm U hUV x hx
    exact ⟨hUV, c, hc⟩

theorem wc_fsys_affine_extend : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) [IsIntegralHom π] (V D : Y.Opens), IsAffineOpen V → D ≤ V → IsCompact (D : Set Y) → ∀ 𝒢 : ∀ V' : Y.Opens, Set Γ(W, π ⁻¹ᵁ V'), wcFSys π D 𝒢 → ∃ 𝒜 : ∀ V' : Y.Opens, Set Γ(W, π ⁻¹ᵁ V'), wcFSys π V 𝒜 ∧ ∀ U : Y.Opens, IsAffineOpen U → U ≤ D → ∀ a, a ∈ 𝒜 U ↔ a ∈ 𝒢 U :=
by
  intro Y W π _ V D hV hDV hD 𝒢 h𝒢
  classical
  haveI : IsAffineHom π := inferInstance

  have hF : ∀ (U₁ U₂ U₃ : Y.Opens) (h₁ : U₂ ≤ U₁) (h₂ : U₃ ≤ U₂) (a : Γ(W, π ⁻¹ᵁ U₁)),
      (W.presheaf.map (homOfLE (π.preimage_mono h₂)).op).hom
        ((W.presheaf.map (homOfLE (π.preimage_mono h₁)).op).hom a) =
      (W.presheaf.map (homOfLE (π.preimage_mono (h₂.trans h₁))).op).hom a := by
    intro U₁ U₂ U₃ h₁ h₂ a
    change (W.presheaf.map (homOfLE (π.preimage_mono h₁)).op ≫
      W.presheaf.map (homOfLE (π.preimage_mono h₂)).op).hom a = _
    rw [← Functor.map_comp]
    rfl

  have hN : ∀ (U₁ U₂ : Y.Opens) (h : U₂ ≤ U₁) (c : Γ(Y, U₁)),
      (W.presheaf.map (homOfLE (π.preimage_mono h)).op).hom ((π.app U₁).hom c) =
        (π.app U₂).hom ((Y.presheaf.map (homOfLE h).op).hom c) := by
    intro U₁ U₂ h c
    have e := congrArg (fun g => g.hom c) (π.naturality (homOfLE h).op)
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at e
    exact e.symm

  have hs1 : ∃ s₀ : Finset Γ(Y, V), (∀ g ∈ s₀, Y.basicOpen g ≤ D) ∧
      ∀ x : Y, x ∈ D → ∃ g ∈ s₀, x ∈ Y.basicOpen g := by
    have hex : ∀ p : ↥D, ∃ f : Γ(Y, V), Y.basicOpen f ≤ D ∧ (p : Y) ∈ Y.basicOpen f :=
      fun p => hV.exists_basicOpen_le p (hDV p.2)
    choose gp hgp using hex
    obtain ⟨t, ht⟩ := hD.elim_finite_subcover
      (fun p : ↥D => ((Y.basicOpen (gp p) : Y.Opens) : Set Y))
      (fun p => (Y.basicOpen (gp p)).isOpen)
      (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, (hgp ⟨x, hx⟩).2⟩)
    refine ⟨t.image gp, ?_, ?_⟩
    · intro g hg
      obtain ⟨p, -, rfl⟩ := Finset.mem_image.mp hg
      exact (hgp p).1
    · intro x hx
      obtain ⟨p, hp, hxp⟩ := Set.mem_iUnion₂.mp (ht hx)
      exact ⟨gp p, Finset.mem_image_of_mem _ hp, hxp⟩
  obtain ⟨s₀, hs₀D, hs₀cov⟩ := hs1

  obtain ⟨X, hX1, hX2⟩ := wc_fsys_affine_generators Y W π D 𝒢 h𝒢 V hV s₀ hs₀D
  have hint : ∀ x ∈ X, (π.app V).hom.IsIntegralElem x :=
    fun x _ => IsIntegralHom.isIntegral_app π V hV x
  obtain ⟨C, hC1, hC2, hC3, hC4, T, hTC, hTspan⟩ :=
    wc_integral_adjoin_finite_span Γ(Y, V) Γ(W, π ⁻¹ᵁ V) (π.app V).hom X hint
  obtain ⟨𝒜, h𝒜, -, hA2, hA3⟩ := wc_fsys_of_finite_subalgebra Y W π V hV C hC1 hC2 T hTC hTspan

  have hCG : ∀ y ∈ C, ∀ g ∈ s₀,
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom y ∈
        𝒢 (Y.basicOpen g) := by
    have key := hC4 {y | ∀ g ∈ s₀,
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le g))).op).hom y ∈
        𝒢 (Y.basicOpen g)} ?_ ?_ ?_
    · exact fun y hy => key hy
    · intro c
      simp only [Set.mem_setOf_eq]
      intro g hg
      rw [hN V (Y.basicOpen g) (Y.basicOpen_le g) c]
      exact (h𝒢.1 _ (hV.basicOpen g) (hs₀D g hg)).1 _
    · intro a ha b hb
      simp only [Set.mem_setOf_eq] at ha hb ⊢
      refine ⟨fun g hg => ?_, fun g hg => ?_⟩
      · rw [map_add]
        exact ((h𝒢.1 _ (hV.basicOpen g) (hs₀D g hg)).2.1 _ (ha g hg) _ (hb g hg)).1
      · rw [map_mul]
        exact ((h𝒢.1 _ (hV.basicOpen g) (hs₀D g hg)).2.1 _ (ha g hg) _ (hb g hg)).2
    · intro x hx
      simp only [Set.mem_setOf_eq]
      exact fun g hg => hX1 x hx g hg

  have hS : ∀ U : Y.Opens, IsAffineOpen U → U ≤ D →
      Ideal.span {h : Γ(Y, U) | ∃ g ∈ s₀, ∃ h' : Γ(Y, Y.basicOpen g),
        Y.basicOpen h = Y.basicOpen h'} = ⊤ := by
    intro U hU hUD
    rw [← hU.self_le_iSup_basicOpen_iff]
    intro x hxU
    obtain ⟨g, hg, hxg⟩ := hs₀cov x (hUD hxU)
    obtain ⟨f, h', hfh', hxf⟩ := exists_basicOpen_le_affine_inter hU (hV.basicOpen g) x
      (TopologicalSpace.Opens.mem_inf.mpr ⟨hxU, hxg⟩)
    exact TopologicalSpace.Opens.mem_iSup.mpr
      ⟨⟨f, show ∃ g ∈ s₀, ∃ h' : Γ(Y, Y.basicOpen g), Y.basicOpen f = Y.basicOpen h' from
        ⟨g, hg, h', hfh'⟩⟩, hxf⟩

  have hP : ∀ U : Y.Opens, IsAffineOpen U → ∀ (hUD : U ≤ D) (y : Γ(W, π ⁻¹ᵁ V)), y ∈ C →
      (W.presheaf.map (homOfLE (π.preimage_mono (hUD.trans hDV))).op).hom y ∈ 𝒢 U := by
    intro U hU hUD y hy
    refine wc_fsys_local_mem Y W π D 𝒢 h𝒢 U hU hUD _ _ (hS U hU hUD) ?_
    rintro h ⟨g, hg, h', hhh'⟩
    have hle : Y.basicOpen h ≤ Y.basicOpen g := (le_of_eq hhh').trans (Y.basicOpen_le h')
    have key := wc_fsys_restrict Y W π D 𝒢 h𝒢 (Y.basicOpen g) (Y.basicOpen h)
      hle (hV.basicOpen g) (hs₀D g hg)
      (hU.basicOpen h) _ (hCG y hy g hg)
    have e1 := hF V (Y.basicOpen g) (Y.basicOpen h) (Y.basicOpen_le g) hle y
    have e2 := hF V U (Y.basicOpen h) (hUD.trans hDV) (Y.basicOpen_le h) y
    rw [e1] at key
    rw [e2]
    exact key
  have hfwd : ∀ U : Y.Opens, IsAffineOpen U → U ≤ D → ∀ a ∈ 𝒜 U, a ∈ 𝒢 U := by
    intro U hU hUD a ha
    obtain ⟨c, rfl⟩ := hA2 U (hUD.trans hDV) hU a ha
    have hU' := h𝒢.1 U hU hUD
    refine Finset.sum_induction _ (· ∈ 𝒢 U) (fun a b ha hb => (hU'.2.1 a ha b hb).1) ?_ ?_
    · have h0 := hU'.1 0
      rwa [map_zero] at h0
    · intro t ht
      exact (hU'.2.1 _ (hU'.1 _) _ (hP U hU hUD t (hTC (Finset.mem_coe.mpr ht)))).2

  have hQ : ∀ g ∈ s₀, ∀ (h' : Γ(Y, Y.basicOpen g)) (z : Γ(W, π ⁻¹ᵁ Y.basicOpen h')),
      z ∈ 𝒢 (Y.basicOpen h') → z ∈ 𝒜 (Y.basicOpen h') := by
    intro g hg h' z hz
    have hgD := hs₀D g hg
    have hgA := hV.basicOpen g
    have hEA := hgA.basicOpen h'
    have hEV : Y.basicOpen h' ≤ V := (Y.basicOpen_le h').trans (Y.basicOpen_le g)
    obtain ⟨n, a, haG, hna⟩ := (h𝒢.2 _ hgA hgD h').2 z hz
    obtain ⟨c, hc⟩ := hX2 g hg a haG
    have hA' := h𝒜.1 _ hEA hEV
    have hρa : (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le h'))).op).hom a ∈
        𝒜 (Y.basicOpen h') := by
      rw [hc, map_sum]
      refine Finset.sum_induction _ (· ∈ 𝒜 (Y.basicOpen h'))
        (fun a b ha hb => (hA'.2.1 a ha b hb).1) ?_ ?_
      · have h0 := hA'.1 0
        rwa [map_zero] at h0
      · intro x hx
        rw [map_mul, hN (Y.basicOpen g) (Y.basicOpen h') (Y.basicOpen_le h') (c x),
          hF V (Y.basicOpen g) (Y.basicOpen h') (Y.basicOpen_le g) (Y.basicOpen_le h') x]
        exact (hA'.2.1 _ (hA'.1 _) _ (hA3 _ hEV hEA x (hC3 (Finset.mem_coe.mpr hx)))).2
    haveI := hgA.isLocalization_basicOpen h'
    have hu : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le h')).op).hom h' ^ n) :=
      (IsLocalization.Away.algebraMap_isUnit h').pow n
    obtain ⟨w, hw⟩ := hu.exists_left_inv
    have hz' : z = (π.app (Y.basicOpen h')).hom w *
        ((π.app (Y.basicOpen h')).hom
          ((Y.presheaf.map (homOfLE (Y.basicOpen_le h')).op).hom h') ^ n * z) := by
      rw [← mul_assoc, ← map_pow, ← map_mul, hw, map_one, one_mul]
    rw [hz', hna]
    exact (hA'.2.1 _ (hA'.1 _) _ hρa).2
  have hbwd : ∀ U : Y.Opens, IsAffineOpen U → U ≤ D → ∀ b ∈ 𝒢 U, b ∈ 𝒜 U := by
    intro U hU hUD b hb
    refine wc_fsys_local_mem Y W π V 𝒜 h𝒜 U hU (hUD.trans hDV) b _ (hS U hU hUD) ?_
    rintro h ⟨g, hg, h', hhh'⟩
    have hEA := hU.basicOpen h
    have hE'A := (hV.basicOpen g).basicOpen h'
    have hED : Y.basicOpen h ≤ D := (Y.basicOpen_le h).trans hUD
    have hE'V : Y.basicOpen h' ≤ V := (Y.basicOpen_le h').trans (Y.basicOpen_le g)
    have h1 := (h𝒢.2 U hU hUD h).1 b hb
    have h2 := wc_fsys_restrict Y W π D 𝒢 h𝒢 (Y.basicOpen h) (Y.basicOpen h')
      (le_of_eq hhh'.symm) hEA hED hE'A _ h1
    have h3 := hQ g hg h' _ h2
    have h4 := wc_fsys_restrict Y W π V 𝒜 h𝒜 (Y.basicOpen h') (Y.basicOpen h)
      (le_of_eq hhh') hE'A hE'V hEA _ h3
    rw [hF U (Y.basicOpen h) (Y.basicOpen h') (Y.basicOpen_le h) (le_of_eq hhh'.symm) b,
      hF U (Y.basicOpen h') (Y.basicOpen h) ((le_of_eq hhh'.symm).trans (Y.basicOpen_le h))
        (le_of_eq hhh') b] at h4
    exact h4
  exact ⟨𝒜, h𝒜, fun U hU hUD a => ⟨hfwd U hU hUD a, hbwd U hU hUD a⟩⟩

theorem wc_fsys_extend : ∀ (Y W : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] (π : W ⟶ Y) [IsIntegralHom π] (D : Y.Opens), IsCompact (D : Set Y) → ∀ 𝒢 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V), wcFSys π D 𝒢 → ∃ 𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V), wcFSys π ⊤ 𝒜 ∧ ∀ V : Y.Opens, IsAffineOpen V → V ≤ D → ∀ a, a ∈ 𝒜 V ↔ a ∈ 𝒢 V :=
by
  intro Y W _ _ π _ D hD 𝒢 h𝒢
  classical

  have hM : ∀ (O O' : Y.Opens) (𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)),
      wcFSys π O 𝒜 → O' ≤ O → wcFSys π O' 𝒜 := by
    intro O O' 𝒜 h hle
    exact ⟨fun V hV hVO => h.1 V hV (hVO.trans hle), fun U hU hUO => h.2 U hU (hUO.trans hle)⟩

  have Q : ∀ S : Finset Y.affineOpens, ∀ D : Y.Opens, IsCompact (D : Set Y) →
      ∀ 𝒢 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V), wcFSys π D 𝒢 →
      ∃ 𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V), wcFSys π (D ⊔ ⨆ i ∈ S, (i : Y.Opens)) 𝒜 ∧
        ∀ V : Y.Opens, IsAffineOpen V → V ≤ D → ∀ a, a ∈ 𝒜 V ↔ a ∈ 𝒢 V := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro D hD 𝒢 h𝒢
      refine ⟨𝒢, hM D _ 𝒢 h𝒢 ?_, fun V _ _ a => Iff.rfl⟩
      simp
    | insert U S hU ih =>
      intro D hD 𝒢 h𝒢
      have hUc : IsCompact ((U : Y.Opens) : Set Y) := U.2.isCompact
      have hDU : IsCompact (((D ⊓ (U : Y.Opens)) : Y.Opens) : Set Y) := by
        rw [TopologicalSpace.Opens.coe_inf]
        exact QuasiSeparatedSpace.inter_isCompact _ _ D.isOpen hD (U : Y.Opens).isOpen hUc
      obtain ⟨𝒜U, h𝒜U, h5⟩ := wc_fsys_affine_extend Y W π (U : Y.Opens) (D ⊓ (U : Y.Opens))
        U.2 inf_le_right hDU 𝒢 (hM D _ 𝒢 h𝒢 inf_le_left)
      obtain ⟨ℋ, hℋ, hℋ1, -⟩ := wc_fsys_glue_two Y W π D (U : Y.Opens) 𝒢 𝒜U h𝒢 h𝒜U
        (fun V hV hle a => (h5 V hV hle a).symm)
      have hDU' : IsCompact (((D ⊔ (U : Y.Opens)) : Y.Opens) : Set Y) := by
        rw [TopologicalSpace.Opens.coe_sup]
        exact hD.union hUc
      obtain ⟨𝒜, h𝒜, h6⟩ := ih (D ⊔ (U : Y.Opens)) hDU' ℋ hℋ
      refine ⟨𝒜, hM _ _ 𝒜 h𝒜 (le_of_eq (by rw [Finset.iSup_insert, sup_assoc])),
        fun V hV hVD a => (h6 V hV (hVD.trans le_sup_left) a).trans (hℋ1 V hV hVD a)⟩

  obtain ⟨s, hs, hseq⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp
    (show IsCompact ((⊤ : Y.Opens) : Set Y) by
      rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ)
  obtain ⟨𝒜, h𝒜, hag⟩ := Q hs.toFinset D hD 𝒢 h𝒢
  refine ⟨𝒜, hM _ _ 𝒜 h𝒜 (le_sup_of_le_right (le_of_eq ?_)), hag⟩
  simp only [Set.Finite.mem_toFinset]
  exact hseq

theorem wc_fsys_join : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) (O : Y.Opens) (𝒜₁ 𝒜₂ : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), wcFSys π O 𝒜₁ → wcFSys π O 𝒜₂ → ∃ 𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V), wcFSys π O 𝒜 ∧ ∀ V : Y.Opens, IsAffineOpen V → V ≤ O → 𝒜₁ V ⊆ 𝒜 V ∧ 𝒜₂ V ⊆ 𝒜 V :=
by
  classical

  have s1 : ∀ (R A : Type u) [CommRing R] [CommRing A] (φ : R →+* A) (S₁ S₂ : Set A)
      (T₁ T₂ : Finset A), (∀ c, φ c ∈ S₁) → (∀ c, φ c ∈ S₂) →
      (∀ a ∈ S₁, ∀ b ∈ S₁, a + b ∈ S₁ ∧ a * b ∈ S₁) →
      (∀ a ∈ S₂, ∀ b ∈ S₂, a + b ∈ S₂ ∧ a * b ∈ S₂) →
      (↑T₁ : Set A) ⊆ S₁ → (↑T₂ : Set A) ⊆ S₂ →
      (∀ a ∈ S₁, ∃ c : A → R, a = ∑ t ∈ T₁, φ (c t) * t) →
      (∀ a ∈ S₂, ∃ c : A → R, a = ∑ t ∈ T₂, φ (c t) * t) →
      S₁ ⊆ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A) ∧
      S₂ ⊆ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A) ∧
      (∀ c, φ c ∈ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A)) ∧
      (∀ a ∈ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A),
        ∀ b ∈ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A),
        a + b ∈ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A) ∧
        a * b ∈ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A)) ∧
      (∃ T : Finset A, (↑T : Set A) ⊆ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A) ∧
        ∀ a ∈ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A),
          ∃ c : A → R, a = ∑ t ∈ T, φ (c t) * t) := by
    intro R A _ _ φ S₁ S₂ T₁ T₂ hφ₁ hφ₂ hc₁ hc₂ hT₁ hT₂ hs₁ hs₂
    have gen : ∀ a ∈ S₁, ∀ b ∈ S₂, a * b ∈ AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) :=
      fun a ha b hb => AddSubmonoid.subset_closure (Set.mem_image2_of_mem ha hb)
    have h1 : S₁ ⊆ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A) := fun a ha => by
      have := gen a ha (φ 1) (hφ₂ 1)
      rwa [map_one, mul_one] at this
    have h2 : S₂ ⊆ (AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) : Set A) := fun b hb => by
      have := gen (φ 1) (hφ₁ 1) b hb
      rwa [map_one, one_mul] at this
    have hmul : ∀ x ∈ AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂),
        ∀ y ∈ AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂),
        x * y ∈ AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) := by
      intro x hx y hy
      induction hx using AddSubmonoid.closure_induction with
      | mem x hx =>
        obtain ⟨a₁, ha₁, b₁, hb₁, rfl⟩ := hx
        induction hy using AddSubmonoid.closure_induction with
        | mem y hy =>
          obtain ⟨a₂, ha₂, b₂, hb₂, rfl⟩ := hy
          show a₁ * b₁ * (a₂ * b₂) ∈ _
          rw [mul_mul_mul_comm]
          exact gen _ (hc₁ _ ha₁ _ ha₂).2 _ (hc₂ _ hb₁ _ hb₂).2
        | zero => rw [mul_zero]; exact AddSubmonoid.zero_mem _
        | add y z _ _ hy hz => rw [mul_add]; exact AddSubmonoid.add_mem _ hy hz
      | zero => rw [zero_mul]; exact AddSubmonoid.zero_mem _
      | add x z _ _ hx hz => rw [add_mul]; exact AddSubmonoid.add_mem _ hx hz
    refine ⟨h1, h2, fun c => h1 (hφ₁ c),
      fun a ha b hb => ⟨AddSubmonoid.add_mem _ ha hb, hmul a ha b hb⟩, ?_⟩
    refine ⟨(T₁ ×ˢ T₂).image (fun p => p.1 * p.2), ?_, ?_⟩
    · intro t ht
      simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe, Finset.mem_product] at ht
      obtain ⟨p, ⟨hp1, hp2⟩, rfl⟩ := ht
      exact gen _ (hT₁ hp1) _ (hT₂ hp2)
    · intro a ha
      induction ha using AddSubmonoid.closure_induction with
      | mem x hx =>
        obtain ⟨a, ha, b, hb, rfl⟩ := hx
        obtain ⟨c₁, rfl⟩ := hs₁ a ha
        obtain ⟨c₂, rfl⟩ := hs₂ b hb
        refine ⟨fun t => ∑ p ∈ (T₁ ×ˢ T₂).filter (fun p => p.1 * p.2 = t), c₁ p.1 * c₂ p.2, ?_⟩
        show (∑ t ∈ T₁, φ (c₁ t) * t) * (∑ t ∈ T₂, φ (c₂ t) * t) = _
        rw [Finset.sum_mul_sum, ← Finset.sum_product',
          ← Finset.sum_fiberwise_of_maps_to (g := fun p : A × A => p.1 * p.2)
            (t := (T₁ ×ˢ T₂).image (fun p => p.1 * p.2))
            (fun p hp => Finset.mem_image_of_mem _ hp)]
        refine Finset.sum_congr rfl (fun t _ => ?_)
        rw [map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun p hp => ?_)
        rw [← (Finset.mem_filter.mp hp).2, map_mul]
        ring
      | zero => exact ⟨0, by simp⟩
      | add x y _ _ hx hy =>
        obtain ⟨c, hc⟩ := hx
        obtain ⟨c', hc'⟩ := hy
        refine ⟨c + c', ?_⟩
        rw [hc, hc', ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun t _ => ?_)
        rw [Pi.add_apply, map_add, add_mul]

  have s2 : ∀ (A B : Type u) [CommRing A] [CommRing B] (ρ : A →+* B) (g : A) (S₁ S₂ : Set A)
      (S₁' S₂' : Set B), (∀ a ∈ S₁, ρ a ∈ S₁') → (∀ a ∈ S₂, ρ a ∈ S₂') →
      (∀ (k : ℕ), ∀ a ∈ AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂),
        g ^ k * a ∈ AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂)) →
      (∀ b ∈ S₁', ∃ (n : ℕ) (a : A), a ∈ S₁ ∧ ρ g ^ n * b = ρ a) →
      (∀ b ∈ S₂', ∃ (n : ℕ) (a : A), a ∈ S₂ ∧ ρ g ^ n * b = ρ a) →
      (∀ a ∈ AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂),
        ρ a ∈ AddSubmonoid.closure (Set.image2 (· * ·) S₁' S₂')) ∧
      (∀ b ∈ AddSubmonoid.closure (Set.image2 (· * ·) S₁' S₂'), ∃ (n : ℕ) (a : A),
        a ∈ AddSubmonoid.closure (Set.image2 (· * ·) S₁ S₂) ∧ ρ g ^ n * b = ρ a) := by
    intro A B _ _ ρ g S₁ S₂ S₁' S₂' hρ₁ hρ₂ hk hd₁ hd₂
    refine ⟨fun a ha => ?_, fun b hb => ?_⟩
    · induction ha using AddSubmonoid.closure_induction with
      | mem x hx =>
        obtain ⟨a₁, ha₁, a₂, ha₂, rfl⟩ := hx
        apply AddSubmonoid.subset_closure
        exact ⟨ρ a₁, hρ₁ _ ha₁, ρ a₂, hρ₂ _ ha₂, (map_mul ρ a₁ a₂).symm⟩
      | zero => rw [map_zero]; exact AddSubmonoid.zero_mem _
      | add x y _ _ hx hy => rw [map_add]; exact AddSubmonoid.add_mem _ hx hy
    · induction hb using AddSubmonoid.closure_induction with
      | mem x hx =>
        obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := hx
        obtain ⟨n₁, a₁, ha₁, e₁⟩ := hd₁ b₁ hb₁
        obtain ⟨n₂, a₂, ha₂, e₂⟩ := hd₂ b₂ hb₂
        refine ⟨n₁ + n₂, a₁ * a₂, AddSubmonoid.subset_closure ⟨a₁, ha₁, a₂, ha₂, rfl⟩, ?_⟩
        show ρ g ^ (n₁ + n₂) * (b₁ * b₂) = ρ (a₁ * a₂)
        rw [map_mul, ← e₁, ← e₂, pow_add]
        ring
      | zero => exact ⟨0, 0, AddSubmonoid.zero_mem _, by rw [mul_zero, map_zero]⟩
      | add x y _ _ hx hy =>
        obtain ⟨n, a, ha, e⟩ := hx
        obtain ⟨n', a', ha', e'⟩ := hy
        refine ⟨n + n', g ^ n' * a + g ^ n * a',
          AddSubmonoid.add_mem _ (hk n' a ha) (hk n a' ha'), ?_⟩
        rw [map_add, map_mul, map_mul, map_pow, map_pow, ← e, ← e', pow_add]
        ring
  intro Y W π O 𝒜₁ 𝒜₂ h₁ h₂

  have s3 : ∀ (U : Y.Opens) (f : Γ(Y, U)),
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom ((π.app U).hom f) =
        (π.app (Y.basicOpen f)).hom ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) := by
    intro U f
    have h := π.naturality (homOfLE (Y.basicOpen_le f)).op
    have h2 := congrArg (fun φ => φ.hom f) h
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    exact h2.symm

  have hS := fun (V : Y.Opens) (hV : IsAffineOpen V) (hVO : V ≤ O) =>
    s1 _ _ (π.app V).hom (𝒜₁ V) (𝒜₂ V) (h₁.1 V hV hVO).2.2.choose
      (h₂.1 V hV hVO).2.2.choose (h₁.1 V hV hVO).1 (h₂.1 V hV hVO).1 (h₁.1 V hV hVO).2.1
      (h₂.1 V hV hVO).2.1 (h₁.1 V hV hVO).2.2.choose_spec.1 (h₂.1 V hV hVO).2.2.choose_spec.1
      (h₁.1 V hV hVO).2.2.choose_spec.2 (h₂.1 V hV hVO).2.2.choose_spec.2
  refine ⟨fun V => (AddSubmonoid.closure (Set.image2 (· * ·) (𝒜₁ V) (𝒜₂ V)) :
    Set Γ(W, π ⁻¹ᵁ V)), ⟨fun V hV hVO => ?_, fun U hU hUO f => ?_⟩,
    fun V hV hVO => ⟨(hS V hV hVO).1, (hS V hV hVO).2.1⟩⟩
  · obtain ⟨-, -, a1, a2, a3⟩ := hS V hV hVO
    exact ⟨a1, a2, a3⟩
  · obtain ⟨-, -, hφU, hmU, -⟩ := hS U hU hUO
    obtain ⟨r₁, d₁⟩ := h₁.2 U hU hUO f
    obtain ⟨r₂, d₂⟩ := h₂.2 U hU hUO f
    simp only [← s3 U f] at d₁ d₂
    simp only [← s3 U f]
    exact s2 _ _ (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom
      ((π.app U).hom f) (𝒜₁ U) (𝒜₂ U) (𝒜₁ (Y.basicOpen f)) (𝒜₂ (Y.basicOpen f)) r₁ r₂
      (fun k a ha => by rw [← map_pow]; exact (hmU _ (hφU _) a ha).2) d₁ d₂

theorem wc_fsys_to_scheme : ∀ (Y W : Scheme.{u}) (π : W ⟶ Y) [IsIntegralHom π] (𝒜 : ∀ V : Y.Opens, Set Γ(W, π ⁻¹ᵁ V)), wcFSys π ⊤ 𝒜 → ∃ (Z : Scheme.{u}) (p : Z ⟶ Y) (r : W ⟶ Z) (hr : r ≫ p = π), IsAffineHom p ∧ ∀ V : Y.Opens, IsAffineOpen V → Function.Injective (r.appLE (p ⁻¹ᵁ V) (π ⁻¹ᵁ V) (by rw [← hr]; exact le_rfl)).hom ∧ ∀ a, a ∈ Set.range (r.appLE (p ⁻¹ᵁ V) (π ⁻¹ᵁ V) (by rw [← hr]; exact le_rfl)).hom ↔ a ∈ 𝒜 V :=
by
  intro Y W π _ 𝒜 h𝒜
  classical
  haveI : IsAffineHom π := inferInstance
  let F := wcFSysDiagram π 𝒜 h𝒜
  let α := wcFSysDiagramMap π 𝒜 h𝒜

  have hker : ∀ (U : Y.Opens), IsAffineOpen U → ∀ (f : Γ(Y, U)) (x x' : Γ(W, π ⁻¹ᵁ U)),
      (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom x =
        (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom x' →
      ∃ m : ℕ, (π.app U).hom f ^ m * x = (π.app U).hom f ^ m * x' := by
    intro U hU f x x' hxx
    letI := (W.presheaf.map (homOfLE (π.preimage_mono (Y.basicOpen_le f))).op).hom.toAlgebra
    haveI hloc : IsLocalization.Away ((π.app U).hom f) Γ(W, π ⁻¹ᵁ Y.basicOpen f) :=
      (hU.preimage π).isLocalization_of_eq_basicOpen _
        (homOfLE (π.preimage_mono (Y.basicOpen_le f))) (Scheme.preimage_basicOpen π f)
    obtain ⟨⟨c, hc⟩, hcx⟩ :=
      IsLocalization.exists_of_eq (M := Submonoid.powers ((π.app U).hom f)) hxx
    obtain ⟨m, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hc
    exact ⟨m, hcx⟩

  have hcoeq : α.Coequifibered := by
    rw [Scheme.AffineZariskiSite.coequifibered_iff_forall_isLocalizationAway]
    intro U f
    letI := (F.map (homOfLE (U.basicOpen_le f)).op).hom.toAlgebra
    have hres : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom f) :=
      RingedSpace.isUnit_res_basicOpen Y.toRingedSpace f
    have hnatα : ∀ c : Γ(Y, U.1), algebraMap (F.obj (Opposite.op U))
        (F.obj (Opposite.op (U.basicOpen f))) ((α.app (Opposite.op U)).hom c) =
        (α.app (Opposite.op (U.basicOpen f))).hom
          ((Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom c) := by
      intro c
      exact congr($((α.naturality (homOfLE (U.basicOpen_le f)).op).symm) c)
    refine IsLocalization.Away.mk _ ?_ ?_ ?_
    · rw [hnatα]
      exact hres.map _
    · intro s
      obtain ⟨n, a, ha, heq⟩ := (h𝒜.2 U.1 U.2 le_top f).2 s.1 s.2
      refine ⟨n, ⟨a, ha⟩, ?_⟩
      rw [hnatα]
      apply Subtype.ext
      show s.1 * _ = _
      rw [mul_comm]
      exact heq
    · intro a b hab
      obtain ⟨m, hm⟩ := hker U.1 U.2 f a.1 b.1 (congrArg Subtype.val hab)
      refine ⟨m, ?_⟩
      apply Subtype.ext
      exact hm

  let d := Scheme.AffineZariskiSite.relativeGluingData hcoeq
  haveI : (d.functor ⋙ Scheme.forget).IsLocallyDirected :=
    Scheme.Cover.RelativeGluingData.instIsLocallyDirectedI₀CompFunctorForgetOfIsThin ..
  let j : ∀ U : Y.AffineZariskiSite, Spec (F.obj (Opposite.op U)) ⟶ d.glued :=
    fun U => Limits.colimit.ι d.functor U
  have hjo : ∀ U, IsOpenImmersion (j U) := fun U =>
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) (d.isPullback_natTrans_ι_toBase U)
      (inferInstanceAs (IsOpenImmersion U.1.ι))
  have hjp : ∀ U : Y.AffineZariskiSite,
      j U ≫ d.toBase = Spec.map (α.app (Opposite.op U)) ≫ U.2.fromSpec := by
    intro U
    have h1 : j U ≫ d.toBase = d.natTrans.app U ≫ U.1.ι := d.ι_toBase U
    refine h1.trans ?_
    exact (Category.assoc (Spec.map (α.app (Opposite.op U))) U.2.isoSpec.inv U.1.ι).trans
      (congrArg (Spec.map (α.app (Opposite.op U)) ≫ ·) (IsAffineOpen.isoSpec_inv_ι U.2))
  have hpre : ∀ U : Y.AffineZariskiSite, d.toBase ⁻¹ᵁ U.1 = (j U).opensRange := by
    intro U
    have h := d.toBase_preimage_eq_opensRange_ι U
    have e : ((Scheme.AffineZariskiSite.directedCover Y).f U).opensRange = U.1 :=
      Scheme.Opens.opensRange_ι U.1
    rw [e] at h
    exact h
  have hjc : ∀ (U U' : Y.AffineZariskiSite) (i : U' ⟶ U), Spec.map (F.map i.op) ≫ j U = j U' :=
    fun U U' i => Limits.colimit.w d.functor i
  have hpaff : IsAffineHom d.toBase := by
    refine ⟨fun V hV => ?_⟩
    rw [hpre ⟨V, hV⟩]
    haveI := hjo ⟨V, hV⟩
    exact isAffineOpen_opensRange (j ⟨V, hV⟩)

  let 𝒱 := (Scheme.AffineZariskiSite.directedCover Y).pullback₁ π
  let ιU : ∀ U : Y.AffineZariskiSite, F.obj (Opposite.op U) ⟶ Γ(W, π ⁻¹ᵁ U.1) :=
    fun U => CommRingCat.ofHom (wcFSysSubring π 𝒜 h𝒜 U).subtype
  have hαι : ∀ U : Y.AffineZariskiSite, α.app (Opposite.op U) ≫ ιU U = π.app U.1 := fun U => rfl
  let g : ∀ U : Y.AffineZariskiSite, 𝒱.X U ⟶ d.glued := fun U =>
    (pullbackRestrictIsoRestrict π U.1).hom ≫ (π ⁻¹ᵁ U.1).toSpecΓ ≫ Spec.map (ιU U) ≫ j U
  have hg : ∀ {U V : Y.AffineZariskiSite} (i : U ⟶ V), Scheme.Cover.trans 𝒱 i ≫ g V = g U := by
    set_option backward.isDefEq.respectTransparency false in
    set_option backward.defeqAttrib.useBackward true in
    intro U V i
    have : (pullbackRestrictIsoRestrict π U.1).inv ≫ Scheme.Cover.trans 𝒱 i ≫
        (pullbackRestrictIsoRestrict π V.1).hom = W.homOfLE
          (π.preimage_mono (Scheme.AffineZariskiSite.toOpens_mono i.le)) := by
      rw [← cancel_mono (Scheme.Opens.ι _)]
      simp +instances [𝒱, Scheme.Cover.trans, Scheme.Cover.locallyDirectedPullbackCover,
        pullbackRestrictIsoRestrict_inv_fst]
    simp only [g]
    rw [← Iso.inv_comp_eq, reassoc_of% this, ← Scheme.Opens.toSpecΓ_SpecMap_presheaf_map_assoc,
      ← Spec.map_comp_assoc, ← hjc V U i, ← Spec.map_comp_assoc]
    rfl
  obtain ⟨r, hr⟩ : ∃ r : W ⟶ d.glued, ∀ U : Y.AffineZariskiSite, 𝒱.f U ≫ r = g U :=
    ⟨_, Scheme.OpenCover.map_glueMorphismsOfLocallyDirected 𝒱 g hg⟩
  have hchart : ∀ U : Y.AffineZariskiSite,
      (π ⁻¹ᵁ U.1).ι ≫ r = (π ⁻¹ᵁ U.1).toSpecΓ ≫ Spec.map (ιU U) ≫ j U := by
    intro U
    rw [← cancel_epi (pullbackRestrictIsoRestrict π U.1).hom, ← Category.assoc,
      pullbackRestrictIsoRestrict_hom_ι]
    exact hr U
  have hrpU : ∀ U : Y.AffineZariskiSite, (π ⁻¹ᵁ U.1).ι ≫ r ≫ d.toBase = (π ⁻¹ᵁ U.1).ι ≫ π := by
    intro U
    have hV := U.2.preimage π
    calc (π ⁻¹ᵁ U.1).ι ≫ r ≫ d.toBase = ((π ⁻¹ᵁ U.1).ι ≫ r) ≫ d.toBase :=
          (Category.assoc _ _ _).symm
      _ = ((π ⁻¹ᵁ U.1).toSpecΓ ≫ Spec.map (ιU U) ≫ j U) ≫ d.toBase := by rw [hchart U]
      _ = (π ⁻¹ᵁ U.1).toSpecΓ ≫ Spec.map (ιU U) ≫ (j U ≫ d.toBase) := by
          simp only [Category.assoc]
      _ = (π ⁻¹ᵁ U.1).toSpecΓ ≫ Spec.map (ιU U) ≫
          (Spec.map (α.app (Opposite.op U)) ≫ U.2.fromSpec) := by rw [hjp U]
      _ = (π ⁻¹ᵁ U.1).toSpecΓ ≫ Spec.map (π.app U.1) ≫ U.2.fromSpec := by
          have h2 : Spec.map (ιU U) ≫ Spec.map (α.app (Opposite.op U)) = Spec.map (π.app U.1) :=
            (Spec.map_comp _ _).symm.trans (congrArg Spec.map (hαι U))
          exact congrArg ((π ⁻¹ᵁ U.1).toSpecΓ ≫ ·)
            ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ U.2.fromSpec) h2))
      _ = (π ⁻¹ᵁ U.1).toSpecΓ ≫ hV.fromSpec ≫ π := by
          rw [Scheme.Hom.app_eq_appLE, IsAffineOpen.SpecMap_appLE_fromSpec π U.2 hV]
      _ = (π ⁻¹ᵁ U.1).ι ≫ π := by
          rw [← IsAffineOpen.isoSpec_inv_ι hV, ← IsAffineOpen.isoSpec_hom hV, Category.assoc,
            Iso.hom_inv_id_assoc]
  have hrp : r ≫ d.toBase = π :=
    Scheme.Cover.hom_ext ((W.openCoverOfIsOpenCover (fun U : Y.AffineZariskiSite =>
      π ⁻¹ᵁ U.1)) (.comap (iSup_affineOpens_eq_top Y) π.base.1)) _ _ fun U => hrpU U

  have s5 : ∀ (W' Z' : Scheme.{u}) (r' : W' ⟶ Z') (O' : W'.Opens) (R : CommRingCat.{u})
      (j' : Spec R ⟶ Z') [IsOpenImmersion j'] (φ : R ⟶ Γ(W', O'))
      (hO : O' ≤ r' ⁻¹ᵁ j'.opensRange),
      O'.ι ≫ r' = O'.toSpecΓ ≫ Spec.map φ ≫ j' →
      ∃ e : Γ(Z', j'.opensRange) ⟶ R, IsIso e ∧ r'.appLE j'.opensRange O' hO = e ≫ φ := by
    intro W' Z' r' O' R j' _ φ hO hch
    have htop : (⊤ : (Spec R).Opens) ≤ j' ⁻¹ᵁ j'.opensRange := by
      rw [Scheme.Hom.preimage_opensRange]
    have hcongr : ∀ (f₁ f₂ : (O' : Scheme.{u}) ⟶ Z') (h : f₁ = f₂)
        (h1 : (⊤ : (O' : Scheme.{u}).Opens) ≤ f₁ ⁻¹ᵁ j'.opensRange),
        f₁.appLE j'.opensRange ⊤ h1 = f₂.appLE j'.opensRange ⊤ (h ▸ h1) := by
      rintro f₁ f₂ rfl h1; rfl
    have hT : ∀ {X₁ X₂ : Scheme.{u}} (f : X₁ ⟶ X₂) (e : (⊤ : X₁.Opens) ≤ f ⁻¹ᵁ ⊤),
        f.appLE ⊤ ⊤ e = f.appTop := fun f e => (Scheme.Hom.app_eq_appLE f).symm
    have e2 : (⊤ : (O' : Scheme.{u}).Opens) ≤ O'.ι ⁻¹ᵁ O' := by simp
    have hτ : O'.ι.appLE O' ⊤ e2 = O'.topIso.inv := by
      rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv]
      congr 1
    have A := Scheme.Hom.appLE_comp_appLE O'.ι r' j'.opensRange O' ⊤ hO e2
    have B := Scheme.Hom.appLE_comp_appLE (O'.toSpecΓ ≫ Spec.map φ) j' j'.opensRange ⊤ ⊤ htop
      (le_of_eq rfl)
    have C := Scheme.Hom.appLE_comp_appLE O'.toSpecΓ (Spec.map φ) ⊤ ⊤ ⊤ (le_of_eq rfl)
      (le_of_eq rfl)
    have D := hcongr _ _ (hch.trans (Category.assoc _ _ _).symm)
      (le_trans e2 (Scheme.Hom.preimage_mono _ hO))
    have key : r'.appLE j'.opensRange O' hO ≫ O'.topIso.inv =
        (j'.appLE j'.opensRange ⊤ htop ≫ (Scheme.ΓSpecIso R).hom ≫ φ) ≫ O'.topIso.inv := by
      rw [← hτ, A, D, ← B, ← C, hT, hT, Scheme.Opens.toSpecΓ_appTop, hτ,
        Scheme.ΓSpecIso_naturality_assoc]
      simp only [Category.assoc]
    have hiso : IsIso (j'.appLE j'.opensRange ⊤ htop) := by
      haveI := Scheme.Hom.isIso_app j' j'.opensRange le_rfl
      have : homOfLE htop = eqToHom (Scheme.Hom.preimage_opensRange j').symm :=
        Subsingleton.elim _ _
      simp only [Scheme.Hom.appLE, this]
      infer_instance
    refine ⟨j'.appLE j'.opensRange ⊤ htop ≫ (Scheme.ΓSpecIso R).hom, inferInstance, ?_⟩
    rw [(cancel_mono O'.topIso.inv).mp key, Category.assoc]

  refine ⟨d.glued, d.toBase, r, hrp, hpaff, fun V hV => ?_⟩
  haveI := hjo ⟨V, hV⟩
  have hle : π ⁻¹ᵁ V ≤ r ⁻¹ᵁ (j ⟨V, hV⟩).opensRange := by
    rw [← hpre ⟨V, hV⟩, ← Scheme.Hom.comp_preimage, hrp]
  obtain ⟨e, he_iso, he⟩ := s5 W d.glued r (π ⁻¹ᵁ V) _ (j ⟨V, hV⟩) (ιU ⟨V, hV⟩) hle
    (hchart ⟨V, hV⟩)
  have hgen : ∀ (O : d.glued.Opens) (_ : O = (j ⟨V, hV⟩).opensRange)
      (h : π ⁻¹ᵁ V ≤ r ⁻¹ᵁ O),
      Function.Injective (r.appLE O (π ⁻¹ᵁ V) h).hom ∧
        ∀ a, a ∈ Set.range (r.appLE O (π ⁻¹ᵁ V) h).hom ↔ a ∈ 𝒜 V := by
    rintro O rfl h
    have he' : r.appLE (j ⟨V, hV⟩).opensRange (π ⁻¹ᵁ V) h = e ≫ ιU ⟨V, hV⟩ := he
    rw [he', CommRingCat.hom_comp, RingHom.coe_comp]
