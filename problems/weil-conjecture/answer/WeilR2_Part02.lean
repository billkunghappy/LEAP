  have hψ₁ : ((U₁ ⊓ U₂).ι ≫ f₀) ≫ φ₁.left = ((U₁ ⊓ U₂).ι ≫ g₀ ≫ b₂ ≫ a₁) ≫ h₁ := by
    rw [← Scheme.homOfLE_ι R₀ (inf_le_left : U₁ ⊓ U₂ ≤ U₁)]
